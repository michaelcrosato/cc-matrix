{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"sed -n '30,270p' engine/sim/weapons.ts && cat .cache/engine-src/labs/playground/weapons/guns.ts\"","aggregated_output":" * Invariants: everything is in the component (times are the sim's, `w.time`); the spread draws only from\n * `w.rng.entity(id, 'weapon')`; a weapon is asked of its entry. Problems raise `CORE_BAD_SPEC`.\n *\n * @example\n * // defineWeapon('weapon:pistol', { rate: 6, damage: 18, magazine: 12 });\n * // spawnActor(w, { at, character, components: { weapons: weaponsFor(['weapon:pistol']) } }); addWeapons(w);\n * // session.step({ b: ['weapon1'] }); … session.step({ look: [0, 0], b: ['fire'] }); // a `gunshot` event\n * @see engine/sim/weapons.test.ts\n */\nimport type { EventMap } from '../core/events';\nimport { codeError } from '../core/log';\nimport { defineSchema } from '../core/schema';\nimport { held, pressed, type Intents } from '../input/intents';\nimport { physicsOf } from '../physics/binding';\nimport type { GroupName } from '../physics/groups';\nimport { getWeapon, recoilStep, spreadOf, type WeaponKind } from '../world/weapons';\nimport type { ActorComponents } from './actors';\nimport { damage, type Health } from './damage';\nimport { EYE, strikeEntity } from './interact';\nimport { MELEE, type MeleeState } from './melee';\nimport { entityOfBody } from './props';\nimport { defineComponent } from './state';\nimport type { World } from './world';\n\nconst DEG = Math.PI / 180;\n\n/** The component `weapons`' fields (see the file comment). */\nexport const WEAPONS_FIELDS = defineSchema({\n  slots: { type: 'array', items: { type: 'string' }, default: [], description: 'The weapons carried, by id, in slot order.' }, // prettier-ignore\n  slot: { type: 'integer', default: -1, minimum: -1, description: 'The slot out (−1: holstered).' },\n  last: { type: 'integer', default: 0, minimum: 0, description: 'The slot drawn last: what `holster` draws again.' },\n  mags: { type: 'array', items: { type: 'number' }, default: [], description: 'Rounds in each slot’s magazine.' },\n  ready: { type: 'number', default: 0, unit: 's', description: 'When the weapon out is ready to fire: its draw done (a swing holds the trigger apart: MELEE.back).' }, // prettier-ignore\n  next: { type: 'number', default: 0, unit: 's', description: 'When its rate lets it fire again.' },\n  reload: { type: 'number', default: -1, unit: 's', description: 'When the reload under way ends (−1: none).' },\n  burst: { type: 'integer', default: 0, minimum: 0, description: 'Shots in the burst under way.' },\n  kick: { type: 'array', items: { type: 'number' }, default: [0, 0], unit: 'deg', description: 'The burst’s kick so far, [up, right].' }, // prettier-ignore\n  shot: { type: 'number', default: -1, unit: 's', description: 'When it last fired (−1: never).' },\n  shots: { type: 'integer', default: 0, minimum: 0, description: 'Shots fired, all told.' },\n  hits: { type: 'integer', default: 0, minimum: 0, description: 'Shots that struck a target: a thing standing, a person alive.' }, // prettier-ignore\n  aim: { type: 'number', default: 0, minimum: 0, maximum: 1, description: 'How far the sights are up, 0 to 1.' },\n});\n\n/** A player's weapons (`WEAPONS_FIELDS` says what each field means). */\nexport interface WeaponsState {\n  slots: string[];\n  slot: number;\n  last: number;\n  mags: number[];\n  ready: number;\n  next: number;\n  reload: number;\n  burst: number;\n  kick: [number, number];\n  shot: number;\n  shots: number;\n  hits: number;\n  aim: number;\n}\n\ndefineComponent('weapons', { description: 'The weapons a player carries and how they stand (WP 13.20).', fields: WEAPONS_FIELDS }); // prettier-ignore\n\n/** A player's weapons component carrying `slots` (weapon ids), each magazine full, holstered unless `drawn`. */\nexport function weaponsFor(slots: readonly string[], drawn = -1): WeaponsState {\n  if (!slots.length || drawn < -1 || drawn >= slots.length) throw codeError('CORE_BAD_SPEC', { where: 'weaponsFor(slots, drawn)', problems: `${JSON.stringify(slots)}, ${drawn}: give a weapon or more and a slot of them (−1: holstered)` }); // prettier-ignore\n  const mags = slots.map((id) => getWeapon(id).magazine);\n  return { slots: [...slots], slot: drawn, last: Math.max(0, drawn), mags, ready: 0, next: 0, reload: -1, burst: 0, kick: [0, 0], shot: -1, shots: 0, hits: 0, aim: 0 }; // prettier-ignore\n}\n\n/** Adds the system `weapons` to `w` (once): see the file comment. */\nexport function addWeapons<C extends object, E extends EventMap>(world: World<C, E>): void {\n  const w = world as unknown as World;\n  if (!w.systems.has('weapons')) w.systems.add('weapons', stepWeapons, { phase: 'intents' });\n}\n\n/** A player as this module reads him. */\ntype Player = ActorComponents & {\n  id: number;\n  weapons: WeaponsState;\n  melee?: MeleeState;\n  motion?: { mode?: string; stance?: string; holstered?: boolean };\n  animator?: { weapon: string };\n};\n\n/** The groups a shot meets: the level, props, people and crowds. */\nconst SHOT_GROUPS: readonly GroupName[] = ['world', 'prop', 'actor', 'crowd', 'flyer'];\n/**\n * How high a shot leaves the chest without a look (m over the feet; crouched): isometric's, top-down's, the\n * platformer's. The view meets the pointer's ray at this height (engine/app/view.ts), so the pointer over a body aims\n * at it.\n */\nexport const CHEST = { stand: 1.3, crouch: 0.75 } as const;\n/** The moves he may fire in: on foot and in the air (his hands are on a ledge, a wall, a rung or the cable otherwise). */\nconst FIRING = new Set(['ground', 'air']);\n\n/** Draws slot `slot` (see the file comment). */\nfunction draw(w: World, e: Player, slot: number): void {\n  const W = e.weapons;\n  const kind = getWeapon(W.slots[slot]);\n  [W.slot, W.last, W.ready, W.reload, W.burst, W.kick] = [slot, slot, w.time + kind.draw, -1, 0, [0, 0]];\n  w.emit('draw', { id: e.id, weapon: kind.id });\n}\n\n/** Puts the weapon out away (see the file comment). */\nfunction holster(w: World, e: Player): void {\n  const W = e.weapons;\n  const kind = getWeapon(W.slots[W.slot]);\n  [W.slot, W.ready, W.reload, W.burst, W.kick, W.aim] = [-1, w.time + kind.draw, -1, 0, [0, 0], 0];\n  w.emit('holster', { id: e.id, weapon: kind.id });\n}\n\n/** Where a shot of `e` leaves and the way it goes before its kick and spread (see the file comment). */\nfunction aimOf(e: Player, intents: Intents): { from: [number, number, number]; yaw: number; pitch: number } {\n  const { x, y, z, yaw } = e.actor;\n  const crouched = e.motion?.stance === 'crouch';\n  const [ax, ay, az] = intents.aim ?? [];\n  if (intents.look) {\n    const from: [number, number, number] = [x, y + (crouched ? EYE.crouch : EYE.stand), z];\n    const [dx, dy, dz] = ax === undefined ? [0, 0, 0] : [ax - from[0], ay! - from[1], az! - from[2]];\n    const flat = Math.hypot(dx, dz);\n    if (Math.hypot(flat, dy) > 0.5) return { from, yaw: Math.atan2(dx, dz), pitch: Math.atan2(dy, flat) };\n    return { from, yaw: intents.look[0], pitch: intents.look[1] };\n  }\n  const from: [number, number, number] = [x, y + (crouched ? CHEST.crouch : CHEST.stand), z];\n  const toward = ax !== undefined && Math.hypot(ax - x, az! - z) > 0.05;\n  return { from, yaw: toward ? Math.atan2(ax - x, az! - z) : yaw, pitch: 0 };\n}\n\n/**\n * The way `up` rad above and `right` rad to the right of the aim (`yaw`, `pitch`) goes, turned in the aim's own frame\n * (its forward, his right, and the up across them), so a cone of offsets stays round at any pitch.\n */\nfunction turned(yaw: number, pitch: number, up: number, right: number): [number, number, number] {\n  const [sy, cy, sp, cp] = [Math.sin(yaw), Math.cos(yaw), Math.sin(pitch), Math.cos(pitch)];\n  const [f, r, u] = [[sy * cp, sp, cy * cp], [-cy, 0, sy], [-sy * sp, cp, -cy * sp]]; // prettier-ignore\n  const t = Math.hypot(up, right);\n  const [c, k] = t < 1e-12 ? [1, 0] : [Math.cos(t), Math.sin(t) / t];\n  return [0, 1, 2].map((i) => f[i] * c + (u[i] * up + r[i] * right) * k) as [number, number, number];\n}\n\n/** Fires one shot of `kind` from `e` (see the file comment). */\nfunction shoot(w: World, e: Player, kind: WeaponKind, intents: Intents): void {\n  const W = e.weapons;\n  const { from, yaw, pitch } = aimOf(e, intents);\n  const spread = spreadOf(kind, W.aim, Math.hypot(e.actor.vx, e.actor.vz) > 0.5);\n  const rng = w.rng.entity(e.id, 'weapon');\n  const [turn, out] = [rng.next() * 2 * Math.PI, spread * Math.sqrt(rng.next())];\n  const dir = turned(yaw, pitch, (W.kick[0] + out * Math.sin(turn)) * DEG, (W.kick[1] + out * Math.cos(turn)) * DEG);\n  const step = recoilStep(kind, W.burst);\n  [W.kick, W.burst, W.shot, W.shots] = [[W.kick[0] + step[0], W.kick[1] + step[1]], W.burst + 1, w.time, W.shots + 1];\n  W.mags[W.slot] -= 1;\n  const hit = physicsOf(w).raycast(from, dir, { maxDistance: kind.range, groups: SHOT_GROUPS, exclude: e.actor.body });\n  const to: [number, number, number] = hit ? [hit.point.x, hit.point.y, hit.point.z] : [from[0] + dir[0] * kind.range, from[1] + dir[1] * kind.range, from[2] + dir[2] * kind.range]; // prettier-ignore\n  const target = hit ? entityOfBody(w, hit.body) : -1;\n  const struck = target >= 0 ? (w.get(target) as unknown as { thing?: { state: string }; health?: Health; sceneProp?: object }) : undefined; // prettier-ignore\n  const counted = !!struck && (struck.thing?.state === 'up' || (!!struck.health && struck.health.hp > 0));\n  if (struck?.sceneProp) strikeEntity(w, target, from, true, 'shot');\n  else if (struck?.health) damage(w, { id: target, health: struck.health }, { amount: kind.damage, from, direction: dir, at: to, source: e.id }); // prettier-ignore\n  if (counted) W.hits += 1;\n  const normal = hit ? [hit.normal.x, hit.normal.y, hit.normal.z] : null;\n  w.emit('gunshot', { id: e.id, weapon: kind.id, from, to, normal, body: hit?.body ?? -1, target, hit: counted });\n}\n\n/** Begins a reload of the weapon out (see the file comment). */\nfunction reload(w: World, e: Player, kind: WeaponKind): void {\n  const W = e.weapons;\n  W.reload = w.time + (W.mags[W.slot] > 0 ? kind.reload.tactical : kind.reload.empty);\n  w.emit('reload', { id: e.id, weapon: kind.id });\n}\n\n/** One step of `e`'s weapons (see the file comment). */\nfunction stepOne(w: World, e: Player, intents: Intents): void {\n  const W = e.weapons;\n  const other = W.slot >= 0 ? (W.slot + 1) % W.slots.length : W.last;\n  const want = pressed(intents, 'weapon1') ? 0 : pressed(intents, 'weapon2') ? 1 : pressed(intents, 'swap') ? other : -1; // prettier-ignore\n  if (want >= 0 && want < W.slots.length && want !== W.slot) draw(w, e, want);\n  else if (pressed(intents, 'holster')) {\n    if (W.slot >= 0) holster(w, e);\n    else draw(w, e, W.last);\n  } else if (W.slot < 0 && pressed(intents, 'fire')) draw(w, e, W.last);\n  if (W.slot < 0) return;\n  const kind = getWeapon(W.slots[W.slot]);\n  if (W.reload >= 0 && w.time >= W.reload - 1e-9) [W.mags[W.slot], W.reload] = [kind.magazine, -1];\n  const up = held(intents, 'aim') && FIRING.has(e.motion?.mode ?? 'ground');\n  W.aim = Math.max(0, Math.min(1, W.aim + (up ? 1 : -1) * (kind.sights > 0 ? w.dt / kind.sights : 1)));\n  if (W.shot >= 0 && w.time - W.shot > kind.settle + 1e-9) {\n    const fall = kind.recover > 0 ? Math.exp(-w.dt / kind.recover) : 0; // the burst over: its kick falls away\n    const kick: [number, number] = [W.kick[0] * fall, W.kick[1] * fall];\n    [W.burst, W.kick] = [0, Math.hypot(kick[0], kick[1]) < 1e-4 ? [0, 0] : kick];\n  }\n  if (pressed(intents, 'reload') && W.reload < 0 && W.mags[W.slot] < kind.magazine) reload(w, e, kind);\n  const trigger = kind.auto ? held(intents, 'fire') : pressed(intents, 'fire');\n  if (!trigger || W.reload >= 0 || w.time < W.ready - 1e-9 || !FIRING.has(e.motion?.mode ?? 'ground')) return;\n  if (e.melee && (e.melee.move !== '' || (e.melee.began >= 0 && (w.tick - e.melee.began) * w.dt < MELEE.back - 1e-9))) return; // prettier-ignore\n  if (W.mags[W.slot] <= 0) {\n    if (pressed(intents, 'fire')) w.emit('dry', { id: e.id, weapon: kind.id });\n    return reload(w, e, kind);\n  }\n  if (w.time < W.next - 1e-9) return;\n  W.next = (kind.auto && w.time - W.next < w.dt ? W.next : w.time) + 1 / kind.rate; // a held trigger keeps the rate\n  shoot(w, e, kind, intents);\n  if (W.mags[W.slot] === 0) reload(w, e, kind); // the last round brings the reload on\n}\n\n/** The system `weapons`: each player's weapons, in id order (see the file comment). */\nfunction stepWeapons(w: World, intents: Intents): void {\n  for (const e of w.query('actor', 'weapons') as unknown as Player[]) {\n    if (!e.actor.player) continue;\n    stepOne(w, e, intents);\n    if (e.motion) e.motion.holstered = e.weapons.slot < 0;\n    if (e.animator) e.animator.weapon = e.weapons.slot >= 0 ? 'gun' : 'none';\n  }\n}\n/**\n * @file The playground's firearms (docs/PLAYGROUND.md §7.2, PLAN.md WP 13.20): a pistol and a rifle, each a prop built\n * from parts (`prop:playground-pistol`, `prop:playground-rifle`: boxes and a barrel, in the weapon's frame, the grip\n * at the origin and +Z along the barrel, no body) and a weapon of the kind `weapon` (engine/world/weapons.ts) with\n * Apex Legends' season 3 numbers for its rate, damage, magazine and reloads; its cones, recoil, sights and draw are\n * ours, shaped like the game's (a pistol's single kick, a rifle's climb that drifts right, then left):\n * - **The pistol** (`weapon:playground-pistol`, the P2020's): semi-automatic at 7 shots a second, 18 points a shot,\n *   10 rounds, a 1.25 s reload either way, a tight cone from the hip, a little kick a shot, quick to draw;\n * - **The rifle** (`weapon:playground-rifle`, the R-301's): automatic at 13.5 shots a second, 14 points a shot, 18\n *   rounds, 2.4 s to reload, 3.2 s from empty, a wider cone from the hip, a burst climbing up and to the right, then\n *   left, its sights 55° at Apex's 70° lens (WP 13.8's rifles').\n * Each names its shot's sound (`sfx:pistolShot`, `sfx:rifleShot`: engine/audio/data/foley.ts), which the playground's\n * sound map plays for its `gunshot` (labs/playground/sounds/events.ts, WP 13.22). The player carries both, holstered (`PLAYGROUND_WEAPONS`, labs/playground/cast/player.ts): 1 and 2 draw them, 3 or\n * Y held holsters (labs/playground/controls.ts).\n *\n * Game code, sim-side: it imports only engine/sim-api.ts.\n *\n * @example\n * // node x gallery prop: both guns on the sheet\n * PISTOL.magazine; // 10\n * RIFLE.auto; // true\n * @see labs/playground/weapons/range.test.ts\n */\nimport { defineProp, defineWeapon, type PropDefinition } from '../../../engine/sim-api';\n\nconst [IRON, PAINT] = ['material:iron', 'material:paint'];\n\n/** A box part `name`, `size` (m) in `material`, its base's middle at `at` (m), in `tint`, turned `rotation` (rad). */\nconst box = (name: string, [width, height, depth]: readonly number[], material: string, at: readonly number[], tint?: string, rotation?: readonly number[]) => ({ name, geometry: 'geometry:box', params: { width, height, depth }, material, position: [...at], ...(tint ? { tint } : {}), ...(rotation ? { rotation: [...rotation] } : {}) }); // prettier-ignore\n\n/** A barrel `length` long and `radius` round from `at` along +Z (an upright frustum turned onto +Z). */\nconst barrel = (name: string, radius: number, length: number, at: readonly number[]) => ({ name, geometry: 'geometry:frustum', params: { radiusBottom: radius, radiusTop: radius, height: length, radialSegments: 10, smooth: true }, material: IRON, position: [...at], rotation: [Math.PI / 2, 0, 0] }); // prettier-ignore\n\n/** The guns' props (see the file comment): no body, drawn in a hand. */\nexport const GUN_PROPS: Readonly<Record<string, PropDefinition>> = {\n  'prop:playground-pistol': {\n    description: 'A pistol, 21 cm long: its grip under the origin, its slide along +Z above the hand. No body.',\n    parts: [\n      box('grip', [0.032, 0.105, 0.045], PAINT, [0, -0.083, -0.012], '#262626', [0.2, 0, 0]), // raked back below the hand\n      box('frame', [0.03, 0.025, 0.17], PAINT, [0, 0.015, 0.06], '#262626'),\n      box('slide', [0.028, 0.032, 0.19], IRON, [0, 0.04, 0.062]),\n      box('sights', [0.022, 0.007, 0.012], IRON, [0, 0.072, -0.018]),\n      box('guard', [0.008, 0.008, 0.05], PAINT, [0, -0.012, 0.04], '#262626'),\n      box('guardFront', [0.008, 0.019, 0.008], PAINT, [0, -0.004, 0.061], '#262626'), // on the bar's end, up to the frame\n      box('trigger', [0.006, 0.013, 0.005], PAINT, [0, 0.002, 0.046], '#262626'), // clear of the grip\n    ],\n    body: { type: 'none' },\n  },\n  'prop:playground-rifle': {\n    description: 'A rifle, 98 cm long: its grip under the origin, its stock behind, its handguard and barrel ahead. No body.', // prettier-ignore\n    parts: [\n      box('grip', [0.03, 0.1, 0.04], PAINT, [0, -0.09, -0.015], '#262626', [0.25, 0, 0]),\n      box('receiver', [0.046, 0.07, 0.34], PAINT, [0, -0.005, 0.07], '#3b3d40'),\n      box('stock', [0.036, 0.085, 0.25], PAINT, [0, -0.04, -0.225], '#262626'),\n      box('handguard', [0.05, 0.055, 0.26], PAINT, [0, 0.003, 0.37], '#2e2f31'),\n      barrel('barrel', 0.011, 0.14, [0, 0.03, 0.5]),\n      box('magazine', [0.03, 0.13, 0.065], IRON, [0, -0.122, 0.12], undefined, [-0.22, 0, 0]), // its foot forward\n      box('sight', [0.03, 0.028, 0.12], IRON, [0, 0.065, 0.03]),\n    ],\n    body: { type: 'none' },\n  },\n};\n\nfor (const [id, spec] of Object.entries(GUN_PROPS)) defineProp(id, spec);\n\n/** The pistol (see the file comment). */\nexport const PISTOL = defineWeapon('weapon:playground-pistol', {\n  rate: 7,\n  damage: 18,\n  range: 80,\n  spread: { hip: 1.2, move: 0.8, ads: 0.1 },\n  recoil: [[0.9, 0.1]],\n  settle: 0.3,\n  magazine: 10,\n  reload: { tactical: 1.25, empty: 1.25 },\n  zoom: 62,\n  sights: 0.16,\n  draw: 0.25,\n  muzzle: [0, 0.056, 0.157],\n  prop: 'prop:playground-pistol',\n  sound: 'sfx:pistolShot',\n});\n\n/** The rifle (see the file comment). */\nexport const RIFLE = defineWeapon('weapon:playground-rifle', {\n  rate: 13.5,\n  auto: true,\n  damage: 14,\n  range: 120,\n  spread: { hip: 2.4, move: 1.4, ads: 0.15 },\n  recoil: [[0.5, 0], [0.45, 0.05], [0.4, 0.1], [0.35, 0.15], [0.3, 0.1], [0.3, 0], [0.25, -0.1], [0.25, -0.15], [0.2, -0.05]], // prettier-ignore\n  settle: 0.3,\n  magazine: 18,\n  reload: { tactical: 2.4, empty: 3.2 },\n  zoom: 55,\n  sights: 0.25,\n  draw: 0.4,\n  muzzle: [0, 0.03, 0.64],\n  prop: 'prop:playground-rifle',\n  sound: 'sfx:rifleShot',\n});\n\n/** What the player carries, by slot: the pistol, then the rifle. */\nexport const PLAYGROUND_WEAPONS: readonly string[] = [PISTOL.id, RIFLE.id];\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"sed -n '15,150p' engine/core/schema.ts && sed -n '20,155p' engine/world/terrain.ts && sed -n '30,130p' engine/world/sites.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"sed -n '15,150p' engine/core/schema.ts && sed -n '20,155p' engine/world/terrain.ts && sed -n '30,130p' engine/world/sites.ts\"","aggregated_output":" * Invariants: unknown keys are errors, in schemas and in specs, each naming the closest valid key. A field has a\n * description; a hook has a default unless it is required; a default passes its own field's checks. `parse` returns a\n * new object holding every given key plus the defaults of absent ones (arrays and plain objects copied, whatever the\n * field's type, so the result shares nothing with its input or the schema; `freezeValue` makes it stored data), never\n * changing its input. Numbers are finite; `integer` is a whole number. Problems are plain sentences naming the key.\n *\n * @example\n * const fields = defineSchema({\n *   roughness: { type: 'number', default: 1, minimum: 0, maximum: 1, description: 'Microfacet roughness.' },\n *   side: { type: 'string', enum: ['front', 'back', 'double'], default: 'front', description: 'Faces drawn.' },\n *   onHit: { type: 'function', default: () => 0, description: 'Called when hit; returns extra damage.' },\n * });\n * parse(fields, { roughness: 0.4 }, 'material \"material:stone\"'); // { roughness: 0.4, side: 'front', onHit: … }\n * validate(fields, { rougness: 2 }).problems[0].message; // 'unknown key \"rougness\" (did you mean \"roughness\"?)'\n * @see engine/core/schema.test.ts\n */\nimport { codeError, defineCodes, didYouMean } from './log';\n\n/** The codes this module raises, with their fixes. */\nexport const SCHEMA_CODES = defineCodes('core', {\n  CORE_BAD_SCHEMA: {\n    template: '{where}: {problems}',\n    fix: 'write each field as { type, description, default?, required?, minimum?, maximum?, enum?, unit?, items?, properties?, when?, view? } (engine/core/schema.ts), with a default that passes its own checks, and a default for every hook that is not required',\n    doc: 'Raised by `defineSchema` and `defineKind` (engine/core/schema.ts, engine/core/registry.ts) when a field is malformed: an unknown keyword (named with the closest one), an unknown type, a missing description, a default outside its own range or values, a minimum above the maximum, an empty enum, or a hook with neither a default nor `required: true`. `defineSettings` reports the same problems in a setting as `CORE_BAD_SPEC`.',\n  },\n  CORE_BAD_SPEC: {\n    template: '{where}: {problems}',\n    fix: 'give each field a value of its type inside its range and values, every required field, and no key the schema lacks (node x describe <kind> lists the fields)',\n    doc: 'Raised by `parse` and `def` (engine/core/schema.ts, engine/core/registry.ts) when a spec does not match its schema. Every problem is listed at once, each naming its key, and an unknown key names the closest valid one: nothing is dropped or clamped silently.',\n  },\n});\n\n/** The value types: JSON's, plus `integer`, `function` (a hook) and `any`. */\nexport type FieldType = 'number' | 'integer' | 'boolean' | 'string' | 'array' | 'object' | 'function' | 'any';\n\n/** Every `FieldType`, in documentation order. */\nexport const FIELD_TYPES: readonly FieldType[] = [\n  'number',\n  'integer',\n  'boolean',\n  'string',\n  'array',\n  'object',\n  'function',\n  'any',\n];\n\n/** When a change takes effect: at once, for what spawns next, or when the scene next starts. */\nexport type When = 'now' | 'spawn' | 'scene';\n\n/** One field: what its values are, documented. Keys follow JSON Schema where it has one (see the file comment). */\nexport interface Field {\n  type: FieldType;\n  /** What the field means, one or more plain sentences. Required except inside `items`. */\n  description?: string;\n  /** The value an absent field takes; a hook's default is a function. */\n  default?: unknown;\n  /** True when a spec must give the field. */\n  required?: boolean;\n  /** The smallest number allowed. */\n  minimum?: number;\n  /** The largest number allowed. */\n  maximum?: number;\n  /** The only values allowed. */\n  enum?: readonly (string | number | boolean)[];\n  /** The unit, in SI: `m`, `s`, `m/s`, `rad`, `kg`… */\n  unit?: string;\n  /** For an array: the field every item matches. */\n  items?: Field;\n  /** For an object: its own fields (unknown keys are errors). Without it, any plain object. */\n  properties?: Schema;\n  /** When a change takes effect (settings); `now` when absent. */\n  when?: When;\n  /** True for a setting that changes only how the game looks or performs (kept out of the hash and replays). */\n  view?: boolean;\n}\n\n/** A schema: field name → field. */\nexport type Schema = Readonly<Record<string, Field>>;\n\n/** One thing wrong with a spec or a schema: where (`roughness`, `layers[2].color`) and a plain sentence. */\nexport interface Problem {\n  path: string;\n  message: string;\n}\n\n/** The TypeScript type of a field's values. */\nexport type ValueOf<F> = F extends { enum: readonly (infer E)[] }\n  ? E\n  : F extends { type: 'number' | 'integer' }\n    ? number\n    : F extends { type: 'boolean' }\n      ? boolean\n      : F extends { type: 'string' }\n        ? string\n        : F extends { type: 'array'; items: infer I }\n          ? ValueOf<I>[]\n          : F extends { type: 'array' }\n            ? unknown[]\n            : F extends { type: 'object'; properties: infer P extends Schema }\n              ? EntryOf<P>\n              : F extends { type: 'object' }\n                ? Record<string, unknown>\n                : F extends { type: 'function'; default: infer D }\n                  ? D\n                  : F extends { type: 'function' }\n                    ? (...args: never[]) => unknown\n                    : unknown;\n\n/** Whether field `F` is always present after `parse`: required, or with a default. */\ntype Present<F> = F extends { required: true } ? true : F extends { default: unknown } ? true : false;\n\n/** What `parse` and `def` accept for schema `S`: the required fields, and any of the others. */\nexport type SpecOf<S extends Schema> = {\n  [K in keyof S as S[K] extends { required: true } ? K : never]: ValueOf<S[K]>;\n} & { [K in keyof S as S[K] extends { required: true } ? never : K]?: ValueOf<S[K]> };\n\n/** What `parse` returns for schema `S`: required fields and fields with a default are always present. */\nexport type EntryOf<S extends Schema> = {\n  readonly [K in keyof S as Present<S[K]> extends true ? K : never]: ValueOf<S[K]>;\n} & { readonly [K in keyof S as Present<S[K]> extends true ? never : K]?: ValueOf<S[K]> };\n\n/** The keywords a field may use. */\nconst KEYWORDS = Object.keys({\n  type: 1,\n  description: 1,\n  default: 1,\n  required: 1,\n  minimum: 1,\n  maximum: 1,\n  enum: 1,\n  unit: 1,\n  items: 1,\n  properties: 1,\n  when: 1,\n  view: 1,\n *\n * Invariants: pure: equal specs give equal terrains in Node and Chromium (int32 hashing, polynomial blends, no trig);\n * heights are float32, as the collider keeps them; outside the grid nothing stands (`terrainHeight` is null).\n *\n * Carried from shardfall@fa2dab6 `crates/pav_core/src/terrain.rs:93-153` (`raw_height`: fbm of 5 octaves at\n * lacunarity 2.03, the ridge term, the flattened footprints' smoothstep, `cell`'s terraces; `decor`'s hashed cells),\n * as a concept: on a heightfield's corners rather than in terraced tiles.\n *\n * @example\n * import { createRegistry } from '../core/registry';\n * const reg = createRegistry();\n * defineTerrain('terrain:knoll', { size: [16, 16], hills: [{ at: [8, 8], radius: 8, height: 2 }] }, reg);\n * const knoll = getTerrain('terrain:knoll', reg);\n * [knoll.cols, terrainHeight(knoll, 8, 8), terrainHeight(knoll, 0, 0), terrainHeight(knoll, -1, 0)]; // [16, 2, 0, null]\n * @see engine/world/terrain.test.ts\n */\nimport { mix32 } from '../core/hash';\nimport { codeError } from '../core/log';\nimport { registry as sharedRegistry, type Entry, type Registry } from '../core/registry';\nimport { createNoise2D } from '../core/noise';\nimport { Vector3 } from '../core/math';\nimport type { Schema, SpecOf } from '../core/schema';\n\n/** A two-number field (m). */\nconst pair = (description: string, required = false) =>\n  ({ type: 'array', items: { type: 'number' }, ...(required ? { required } : { default: [0, 0] }), unit: 'm', description }) as const; // prettier-ignore\n\n/** The fields of a `terrain` entry (see the file comment). */\nexport const TERRAIN_FIELDS = {\n  size: pair('Its extent along x and along z, each a whole number of cells: [24, 96].', true),\n  cell: { type: 'number', default: 1, minimum: 0.25, maximum: 8, unit: 'm', description: 'The grid’s spacing: a height stands at every cell’s corners.' }, // prettier-ignore\n  origin: { type: 'array', items: { type: 'number' }, default: [0, 0, 0], unit: 'm', description: 'Its north-west corner, at the height everything else is added to: [x, y, z].' }, // prettier-ignore\n  seed: { type: 'integer', default: 0, description: 'The noise’s seed.' },\n  height: { type: 'number', default: 0, minimum: 0, unit: 'm', description: 'The noise’s range: rolling ground about this high (0: none).' }, // prettier-ignore\n  scale: { type: 'number', default: 40, minimum: 1, unit: 'm', description: 'The size of the noise’s features.' },\n  octaves: { type: 'integer', default: 5, minimum: 1, maximum: 8, description: 'The noise’s octaves.' },\n  ridges: { type: 'number', default: 0.5, minimum: 0, maximum: 1, description: 'How much ridged noise is added: shardfall’s half.' }, // prettier-ignore\n  hills: { type: 'array', items: { type: 'object' }, default: [], description: 'Smooth domes added: { at: [x, z], radius, height } (m; a negative height digs a hollow).' }, // prettier-ignore\n  terrace: { type: 'number', default: 0, minimum: 0, unit: 'm', description: 'Rounds heights to steps this high (0: smooth).' }, // prettier-ignore\n  flats: { type: 'array', items: { type: 'object' }, default: [], description: 'Footprints flattened: { rect: [x0, z0, x1, z1], height, margin } (m), the ground blending back over margin round each.' }, // prettier-ignore\n  surface: { type: 'string', default: 'grass', description: 'The surface tag underfoot (footsteps, particles).' },\n  steep: { type: 'number', default: 0.7, minimum: 0, unit: 'm/m', description: 'Ground rising this much a metre or more is steep (0.7: 35°).' }, // prettier-ignore\n  steepSurface: { type: 'string', default: 'rock', description: 'The surface tag on steep ground.' },\n  high: { type: 'number', default: 0, minimum: 0, unit: 'm', description: 'The high layer shows from this height over the origin up (0: none).' }, // prettier-ignore\n  materials: { type: 'array', items: { type: 'string' }, default: ['material:default'], description: 'Drawing only: the layers’ materials, the ground, then the steep and the high (a game names its own).' }, // prettier-ignore\n} as const satisfies Schema;\n\n/** A `terrain` entry: its spec. */\nexport type TerrainEntry = Entry<typeof TERRAIN_FIELDS>;\n/** What `defineTerrain` and `makeTerrain` take: each field of `TERRAIN_FIELDS` (`size` required). */\nexport type TerrainSpec = SpecOf<typeof TERRAIN_FIELDS>;\n\n/** A dome added to a terrain. */\nexport interface TerrainHill {\n  readonly at: readonly [number, number];\n  readonly radius: number;\n  readonly height: number;\n}\n\n/** A footprint a terrain flattens. */\nexport interface TerrainFlat {\n  readonly rect: readonly [x0: number, z0: number, x1: number, z1: number];\n  readonly height: number;\n  readonly margin: number;\n}\n\n/** A made terrain: its grid, its heights and what the queries and the drawing read (see the file comment). */\nexport interface Terrain {\n  /** Its id without `terrain:`. */\n  readonly name: string;\n  /** Cells along x and along z, and a cell's side (m). */\n  readonly cols: number;\n  readonly rows: number;\n  readonly cell: number;\n  /** Its north-west corner (m). */\n  readonly origin: readonly [number, number, number];\n  /** The height (m) at every corner, row by row from the north: corner (col, row) at `row * (cols + 1) + col`. */\n  readonly heights: Float32Array;\n  /** Its box (m). */\n  readonly bounds: { readonly min: readonly [number, number, number]; readonly max: readonly [number, number, number] }; // prettier-ignore\n  readonly surface: string;\n  readonly steep: number;\n  readonly steepSurface: string;\n  readonly high: number;\n  readonly materials: readonly string[];\n  /** Its seed and its flattened footprints, as the spec gave them. */\n  readonly seed: number;\n  readonly flats: readonly TerrainFlat[];\n}\n\n/** A place `scatterTerrain` picks: on the ground, a turn about +Y (rad) and a size factor. */\nexport interface TerrainPlace {\n  readonly position: readonly [number, number, number];\n  readonly yaw: number;\n  readonly scale: number;\n}\n\n/** How `scatterTerrain` places (see its comment). */\nexport interface ScatterRule {\n  /** The chance a cell holds one, 0 to 1. */\n  density: number;\n  /** Tells two scatters on one terrain apart (trees, rocks): 0 by default. */\n  salt?: number;\n  /** The steepest ground it places on (m a metre): the terrain's `steep` by default. */\n  grade?: number;\n  /** How far from every flat's footprint it keeps (m): 0 by default. */\n  clear?: number;\n  /** The size factor's range: [1, 1] by default. */\n  scale?: readonly [number, number];\n}\n\n/** `t` eased in and out (smoothstep), for `t` in [0, 1]. */\nconst smooth = (t: number) => t * t * (3 - 2 * t);\n/** `v` held to [lo, hi]. */\nconst clamp = (v: number, lo: number, hi: number) => (v < lo ? lo : v > hi ? hi : v);\n\n/** The problems with a terrain spec's shape (beyond its fields' types); none when it makes a terrain. */\nexport function terrainProblems(spec: TerrainSpec): string[] {\n  const problems: string[] = [];\n  const pairOk = (value: unknown, n: number) => Array.isArray(value) && value.length === n && value.every(Number.isFinite); // prettier-ignore\n  const { size = [0, 0], cell, origin, hills, flats, materials } = { ...defaults(), ...spec } as Required<TerrainSpec>;\n  if (!pairOk(size, 2) || !(size[0] > 0 && size[1] > 0))\n    problems.push('size must be [x, z], two positive numbers of metres'); // prettier-ignore\n  else {\n    for (const [axis, extent] of [\n      ['x', size[0]],\n      ['z', size[1]],\n    ] as const) {\n      const cells = extent / cell;\n      if (Math.abs(cells - Math.round(cells)) > 1e-9) problems.push(`size along ${axis}, ${extent} m, is no whole number of ${cell} m cells`); // prettier-ignore\n    }\n  }\n  if (!pairOk(origin, 3)) problems.push('origin must be [x, y, z] (m)');\n  (hills as unknown[]).forEach((hill, i) => {\n    const h = hill as Partial<TerrainHill>;\n    if (!pairOk(h?.at, 2) || !(Number(h?.radius) > 0) || !Number.isFinite(h?.height)) problems.push(`hills[${i}] must be { at: [x, z], radius (above 0), height } (m)`); // prettier-ignore\nsed: can't read engine/world/sites.ts: No such file or directory\n","exit_code":2,"status":"failed"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"cat .cache/engine-src/labs/playground/bodies/player.ts .cache/engine-src/labs/playground/controls.ts && sed -n '1,135p' .cache/hub/README.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"cat .cache/engine-src/labs/playground/bodies/player.ts .cache/engine-src/labs/playground/controls.ts && sed -n '1,135p' .cache/hub/README.md\"","aggregated_output":"/**\n * @file The player's body, `body:player` (docs/PLAYGROUND.md §3.1, PLAN.md WP 13.2), in the body grammar\n * (engine/gfx/puppets/grammar.ts), worn on `build:adult` (engine/anim/builds.ts): a jacket with darker upper sleeves\n * and collar, cargo trousers with knee pads and a belt, boots with dark soles, gloves, short hair and a face, and a\n * small pack on the back. Every garment has two tones, so the cel look's bands and the pixel look's palette both read\n * it, and one accent (`accent`: the yoke and its shoulder caps and the pack's top flap; the cuffs, `cuff`, in its\n * colour) marks the player from every camera: the caps and the flap face up, so the isometric and top-down cameras,\n * which draw the player 11 to 15 px tall, still show it (tests/e2e/playground.spec.ts counts it in every camera of both\n * looks).\n *\n * Sizes are an adult's at 1.80 m: limbs in multiples of the body's `limbRadius`, the torso of its `torsoRadius`, the\n * head of the skeleton's head radius. Its slots are what the neighbours vary by seed (docs/PLAYGROUND.md §7.4): the\n * skin, the hair, the jacket's two tones, the trousers', the boots', the accent and the cuffs.\n *\n * Invariants: data only; every slot it names is in `slots` and every slot in `slots` is worn; parts written for the\n * left side are in `mirror`. The page registers it (labs/playground/main.ts); the sim names it by id only.\n *\n * Game code, a page's: it imports only the engine's public API (engine/index.ts).\n *\n * @example\n * PLAYER_BODY.slots?.accent; // '#ff7f2a'\n * @see labs/playground/bodies/player.test.ts\n */\nimport { defineBody, type BodySpec } from '../../../engine';\n\n/** The player's body (see the file comment). */\nexport const PLAYER_BODY: BodySpec = {\n  description:\n    'The playground player: a teal jacket with an orange yoke, charcoal cargo trousers with knee pads and a belt, boots, gloves, short hair and a pack.',\n  limbRadius: 0.055,\n  torsoRadius: 0.205,\n  build: 'build:adult',\n  slots: {\n    skin: '#e3b48f',\n    hair: '#2b1d16',\n    jacket: '#2f6672',\n    jacketDark: '#1d3f48',\n    accent: '#ff7f2a',\n    cuff: '#ff7f2a',\n    pants: '#41444d',\n    pantsDark: '#2a2c32',\n    boot: '#4d3424',\n    sole: '#1c1a19',\n    glove: '#26282c',\n    pack: '#5d6442',\n    eye: '#141018',\n  },\n  parts: [\n    // the hips\n    ['ball', 'pelvis', [[0.85, 'torso'], [0.6, 'torso'], [0.61, 'torso']], 'pants'], // prettier-ignore\n    // the jacket: the waist, the chest, the shoulders' yoke and the collar\n    ['limb', ['off', 'spine0', 0, 0, 0.06], 'chest', [0.66, 'torso'], [0.72, 'torso'], 'jacket', { on: 'spine1' }],\n    ['limb', 'chest', ['off', 'neck', 0, 0, -0.03], [0.74, 'torso'], [0.7, 'torso'], 'jacket'],\n    ['limb', 'upperArmL', 'upperArmR', [1.5, 'limb'], [1.5, 'limb'], 'accent', { on: 'chest' }],\n    ['limb', ['off', 'neck', 0, 0, -0.02], ['off', 'neck', 0, 0, 0.05], [0.36, 'torso'], [0.32, 'torso'], 'jacketDark'],\n    // the pack on the back, its top flap a few millimetres proud of it all round\n    ['box', ['off', 'back', -0.06, 0, -0.16], ['off', 'back', -0.06, 0, 0.12], 0.28, 0.12, 'pack', { on: 'chest' }],\n    ['box', ['off', 'back', -0.065, 0, 0.075], ['off', 'back', -0.065, 0, 0.125], 0.29, 0.125, 'accent', { on: 'chest' }], // prettier-ignore\n    // the neck, the head, short hair and a face\n    ['limb', 'neck', ['off', 'head', 0, 0, [0.4, 'head']], 0.052, 0.05, 'skin'],\n    ['ball', ['off', 'head', [0.06, 'head'], 0, [0.92, 'head']], [0.88, 'head'], 'skin'],\n    ['ball', ['off', 'head', [-0.18, 'head'], 0, [1.12, 'head']], [0.9, 'head'], 'hair'],\n    ['ball', ['off', 'head', [0.18, 'head'], 0, [1.42, 'head']], [0.62, 'head'], 'hair'],\n    ['ball', ['off', 'head', [0.86, 'head'], 0, [0.62, 'head']], [0.13, 'head'], 'skin'], // the nose\n  ],\n  mirror: [\n    // the belt round the waist, a quarter each, its centre a little inside the hips and the jacket so it stands proud\n    ['curve', ['off', 'pelvis', 0.119, 0, 0.015], ['off', 'pelvis', 0, -0.166, 0.015], 0.37, [0.4, 'limb'], [0.4, 'limb'], 'pantsDark'], // prettier-ignore\n    ['curve', ['off', 'pelvis', 0, -0.166, 0.015], ['off', 'pelvis', -0.119, 0, 0.015], 0.37, [0.4, 'limb'], [0.4, 'limb'], 'pantsDark'], // prettier-ignore\n    // the legs: thigh, knee pad, shin, then the boot and its sole\n    ['limb', 'thighL', 'shinL', [1.5, 'limb'], [1.22, 'limb'], 'pants'],\n    ['ball', ['off', 'shinL', [0.8, 'limb'], 0, 0], [0.95, 'limb'], 'pantsDark'],\n    ['limb', 'shinL', ['lerp', 'shinL', 'footL', 0.66], [1.18, 'limb'], [1.02, 'limb'], 'pants'],\n    ['limb', ['lerp', 'shinL', 'footL', 0.66], 'footL', [1.12, 'limb'], [1.04, 'limb'], 'boot'],\n    ['limb', 'footL', 'toeL', [1.02, 'limb'], [0.86, 'limb'], 'boot'],\n    ['box', ['off', 'footL', [-0.6, 'limb'], 0, -0.06], ['off', 'toeL', [0.9, 'limb'], 0, -0.045], [2.0, 'limb'], 0.02, 'sole', { on: 'footL' }], // prettier-ignore\n    // the arms: the yoke's shoulder caps, the sleeves, dark above the elbow, the cuffs in the accent, gloves\n    ['ball', 'upperArmL', [[1.9, 'limb'], [1.15, 'limb'], [1.8, 'limb']], 'accent', { on: 'chest' }], // prettier-ignore\n    ['limb', 'upperArmL', 'forearmL', [1.24, 'limb'], [1.06, 'limb'], 'jacketDark'],\n    ['limb', 'forearmL', ['lerp', 'forearmL', 'handL', 0.82], [1.06, 'limb'], [0.98, 'limb'], 'jacket'],\n    ['limb', ['lerp', 'forearmL', 'handL', 0.82], ['lerp', 'forearmL', 'handL', 0.95], [1.04, 'limb'], [1.04, 'limb'], 'cuff'], // prettier-ignore\n    ['limb', ['lerp', 'forearmL', 'handL', 0.95], 'handL', [0.9, 'limb'], [0.86, 'limb'], 'glove'],\n    ['ball', 'weaponL', [0.9, 'limb'], 'glove'],\n    ['eye', 'eyeL', [0.11, 'head'], 'eye'],\n  ],\n};\n\n/** `body:player`, registered with the shared registry once this module loads. */\nexport const PLAYER = defineBody('body:player', PLAYER_BODY);\n/**\n * @file The playground's controls (docs/PLAYGROUND.md §3.3, PLAN.md WP 13.3, WP 13.9): an action map per camera mode,\n * Apex Legends' default bindings where the browser allows them. W A S D or the arrows move, Space jumps, Left Shift\n * sprints (a press keeps the sprint while the player moves on; the setting `input.sprint` makes it hold only), Left Alt\n * walks (ours: Apex walks only aiming down sights), C crouches (held; `input.crouch` toggles it), not Apex's Left\n * Ctrl, since Ctrl with W closes the browser's tab and no page can stop it; E uses (a door, a switch, a chair to carry\n * and throw, a zipline, a ladder), V strikes (Apex's melee, WP 13.19: a punch with a lunge, the door kick at a door),\n * the left and right buttons fire and raise the sights, 1 and 2 draw the pistol and the rifle, R reloads and 3\n * holsters (WP 13.20); T switches the camera mode, X swaps the shooter's shoulder, and in isometric Q and E turn the\n * view, so there G uses. A pad's left stick moves, its right stick looks, A jumps, B crouches, X uses and held\n * reloads, Y swaps the weapons and held holsters (Apex's, on held bindings: engine/input/codes.ts `holdCode`), a\n * click of the left stick sprints and of the right one kicks, the triggers fire and aim, View switches the camera,\n * the d-pad's left swaps the shoulder and its right turns isometric.\n *\n * Each mode's map (`PLAYGROUND_MAPS`, picked by the camera in use: `playgroundMap(code)`): first person and the shooter\n * send the view (`look`, so the sprint keeps within 45° of it) and aim with the screen's centre, the mouse looking\n * under pointer lock; the platformer moves relative to the camera, the mouse turning it, and faces its move;\n * isometric and top-down move relative to the screen and aim with the free pointer onto the player's floor (the right\n * stick on a pad). The camera keys are view actions (`view`): rebound like the others, never in the intents, and the\n * page hears them (`onView`, labs/playground/main.ts). The page keeps P, F, M, H and I for itself (`reserved`).\n *\n * Invariants: data only; the buttons the intents carry are the actions the shooter model reads (`jump`, `sprint`,\n * `walk`, `crouch`, `interact`, engine/sim/actors.ts; `melee`, the strike, engine/sim/melee.ts), and the firearms'\n * (`fire`, `aim`, which raises the sights and the camera's zoom, `reload`, `holster`, `weapon1`, `weapon2` and\n * `swap`, engine/sim/weapons.ts).\n *\n * Game code, a page's: it imports only the engine's public API (engine/index.ts) and the playground's files.\n *\n * @example\n * import { getActionMap } from '../../engine';\n * playgroundMap('cam=iso,90,1'); // 'actionMap:playground-isometric'\n * getActionMap(PLAYGROUND_MAPS.isometric).actions.interact; // ['KeyG', 'PadWest']: Q and E turn the view there\n * @see labs/playground/controls.test.ts\n */\nimport { defineActionMap, type ActionMapSpec } from '../../engine';\nimport { FEEL_KEY } from './feel';\nimport { CARD_KEY, GOTO_KEY, HELP_KEY } from './ui/help';\nimport { cameraMode, LOOK_KEY } from './views';\n\n/** The action maps, by camera mode (labs/playground/views.ts `PLAYGROUND_CAMERAS`' names). */\nexport const PLAYGROUND_MAPS = {\n  shooter: 'actionMap:playground-shooter',\n  first: 'actionMap:playground-first',\n  platformer: 'actionMap:playground-platformer',\n  isometric: 'actionMap:playground-isometric',\n  'top-down': 'actionMap:playground-top-down',\n} as const;\n\n/** The actions the player answers, with what each does, in the settings' order (ui/settings.ts; the controls sheet groups its own, ui/help.ts); the rest are bound for later WPs. */\nexport const PLAYGROUND_ACTIONS: Readonly<Record<string, string>> = {\n  jump: 'Jump',\n  sprint: 'Sprint: hold, or press once to keep it',\n  walk: 'Walk',\n  crouch: 'Crouch: hold',\n  interact: 'Use: a door, a switch, a chair to carry and throw, a zipline, a ladder',\n  melee: 'Strike: a punch with a lunge, a kick in the air, an uppercut from a slide; a door takes a kick, then breaks',\n  fire: 'Fire (draws the weapon if holstered)',\n  aim: 'Aim down sights',\n  reload: 'Reload',\n  weapon1: 'Draw the pistol',\n  weapon2: 'Draw the rifle',\n  swap: 'Swap weapons',\n  holster: 'Holster, or draw again',\n};\n\n/** The keys the page keeps for itself: the look (P), the feel panel (F), Go to (M), the controls sheet (H) and the area's card (I). */ // prettier-ignore\nconst PAGE_KEYS = [LOOK_KEY, FEEL_KEY, GOTO_KEY, HELP_KEY, CARD_KEY];\n\n/** Every mode's bindings (see the file comment). */\nconst ACTIONS: Readonly<Record<string, readonly string[]>> = {\n  forward: ['KeyW', 'ArrowUp', 'PadLeftStickUp'],\n  back: ['KeyS', 'ArrowDown', 'PadLeftStickDown'],\n  left: ['KeyA', 'ArrowLeft', 'PadLeftStickLeft'],\n  right: ['KeyD', 'ArrowRight', 'PadLeftStickRight'],\n  jump: ['Space', 'PadSouth'],\n  sprint: ['ShiftLeft', 'PadLeftStick'],\n  walk: ['AltLeft'],\n  crouch: ['KeyC', 'PadEast'],\n  interact: ['KeyE', 'PadWest'],\n  melee: ['KeyV', 'PadRightStick'],\n  fire: ['MouseLeft', 'PadRightTrigger'],\n  aim: ['MouseRight', 'PadLeftTrigger'],\n  reload: ['KeyR', 'Hold:PadWest'],\n  weapon1: ['Digit1'],\n  weapon2: ['Digit2'],\n  swap: ['PadNorth'],\n  holster: ['Digit3', 'Hold:PadNorth'],\n  camera: ['KeyT', 'PadSelect'],\n};\n\n/** Each mode's map, written once here and registered below. */\nconst SPECS: Readonly<Record<keyof typeof PLAYGROUND_MAPS, ActionMapSpec>> = {\n  shooter: {\n    description: 'The playground’s shooter camera: the view sent, aimed at the screen’s centre, X swaps the shoulder.',\n    actions: { ...ACTIONS, shoulder: ['KeyX', 'PadLeft'] },\n    view: ['camera', 'shoulder'],\n    look: true,\n    aimWith: 'centre',\n    lock: true,\n  },\n  first: {\n    description: 'The playground’s first person: the view sent, aimed at the screen’s centre.',\n    actions: ACTIONS,\n    view: ['camera'],\n    look: true,\n    aimWith: 'centre',\n    lock: true,\n  },\n  platformer: {\n    description: 'The playground’s platformer camera: moving relative to it, the mouse turning it, facing the move.',\n    actions: ACTIONS,\n    view: ['camera'],\n    lock: true,\n  },\n  isometric: {\n    description: 'The playground’s isometric view: aimed with the pointer, Q and E turning the view, so G uses.',\n    actions: { ...ACTIONS, interact: ['KeyG', 'PadWest'], turnLeft: ['KeyQ'], turnRight: ['KeyE', 'PadRight'] },\n    view: ['camera', 'turnLeft', 'turnRight'],\n    aimWith: 'pointer',\n  },\n  'top-down': {\n    description: 'The playground’s top-down view: aimed with the pointer.',\n    actions: ACTIONS,\n    view: ['camera'],\n    aimWith: 'pointer',\n  },\n};\n\nfor (const [mode, spec] of Object.entries(SPECS)) {\n  defineActionMap(PLAYGROUND_MAPS[mode as keyof typeof PLAYGROUND_MAPS], { ...spec, reserved: PAGE_KEYS });\n}\n\n/** The action map for the camera `code` (`cam3=first,…`): its mode's, the shooter's for a camera no mode opens. */\nexport function playgroundMap(code: string): string {\n  const mode = cameraMode(code)?.name as keyof typeof PLAYGROUND_MAPS | undefined;\n  return PLAYGROUND_MAPS[mode ?? 'shooter'];\n}\n# AI Hub Session Protocol v1\n\nAn **AI Hub session** is up to four players, each on their own device,\nplaying rounds of games one after another. The hub runs everything around a\nround: the invite, the lobby, the seats and names, the network, the clock, the\nscoreboard and the results. This page defines how a game takes part in a\nround, and how the copies of a game send data to each other.\n\n**https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md**\n\nThe hub tests every game when it joins the library, with the same test\ndescribed in *Test it*, and keeps a game that fails it out of sessions.\n\n- Client: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js\n- Harness: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\n\nTo ask an agent for it, add this to the game's prompt:\n\n> This game must support AI Hub sessions. Follow\n> https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md\n> (AI Hub Session Protocol v1) and pass the harness's automatic check.\n\n---\n\n## Modes\n\nA game declares one mode.\n\n| Mode | What each copy runs | What the copies send each other |\n|---|---|---|\n| `parallel` | its own copy of the round | nothing |\n| `ghost` | its own copy of the round | each copy's own player: where it is and what it is doing |\n| `shared-world` | one world for all players, run by the host's copy | what each player does, to the host; the world, from the host |\n\n- **Parallel**: every player plays their own copy of the round, from the same\n  start. Each copy reports its score to the hub.\n- **Ghost**: as parallel, and each copy also shows the other players'\n  characters where they are, when they are in the same area of the game.\n  Those characters do not affect anything in the copy that shows them.\n- **Shared world**: all players play in one world. The host's copy runs that\n  world; the other copies send it what their own player does, and show the\n  world the host sends them.\n\nGames tagged with the older modes keep working: `race` is played as ghost,\n`co-op` and `versus` as shared world.\n\n---\n\n## A round\n\n1. The hub loads the game on every player's device, and the players get 10\n   to 30 seconds with the game's card: what the game is, how to win, the\n   controls. The card is the hub's, from the game's tags, or the game's own\n   (*The card*).\n2. The game connects and calls `ready()`.\n3. The round starts on the hub's clock, on every device at once.\n4. The game reports how it goes.\n5. The round ends when every player has a result, when the host of a shared\n   world finishes it, or when the hub calls time. The hub shows the results\n   over the game, then removes it.\n\n### Tags\n\nIn the game's `<head>`:\n\n```html\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"MIN-MAX\">\n<meta name=\"hub:session-mode\" content=\"MODE\">\n<meta name=\"hub:session-goal\" content=\"GOAL\">\n<meta name=\"hub:session-howto\" content=\"CONTROLS\">\n```\n\n- `hub:session-players`: the smallest and largest number of players the game\n  takes in a session. The hub deals the game only when the number of players\n  is in that range.\n- `hub:session-mode`: `parallel`, `ghost` or `shared-world`.\n- `hub:session-goal` and `hub:session-howto`: how to win and the game's\n  controls, shown on the hub's card.\n\nOptional:\n\n- `hub:session-minutes`: how many minutes a round of the game takes. The hub\n  shows it and uses it to decide when to call time.\n- `hub:webgpu` with `required`: the game cannot run without WebGPU. The hub\n  then deals it only when every player's browser has WebGPU.\n\n### The client\n\n[session.js](https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js)\nis pasted into the game unmodified, as the first script in `<head>`, right\nafter `<meta charset>`. In a session it:\n\n- seeds `Math.random`, in parallel and ghost, before any of the game's own\n  scripts run, so it gives the same numbers on every copy;\n- gives the game an empty `localStorage` and `sessionStorage` of its own, so\n  nothing stored on the device carries into the round, and nothing the round\n  stores reaches the device's own storage;\n- hands `requestFullscreen()` and `exitFullscreen()` to the hub, which takes\n  its whole page fullscreen; `document.fullscreenElement` and\n  `fullscreenchange` follow the hub's page.\n\nThe hub replaces an unmodified copy of the client with each new version. An\nedited copy is not replaced.\n\n### Joining\n\n- `AIHub.active` is `true` from the first line when the hub opened the page.\n- In a session, the game opens straight into the round: no title screen,\n  menus or prompts before it, other than its own card (*The card*).\n- `AIHub.connect({ mode, seats: [min, max] })` returns a promise of the\n  round's `info`, or of `null` when there is no hub after all; with `null`\n  the game runs as it does on its own.\n- `AIHub.ready()` is called once, when the game has loaded and the round can\n  start, with no key press: the players answer the card.\n- The round starts when the card's countdown ends or every player pressed\n  Ready, and every game has called `ready()`. A game still loading then gets\n  20 more seconds; after that its player sits the round out.\n\n`info` (also on `AIHub` after `connect()`):\n\n| Field | |\n|---|---|\n| `me` | this copy's player id |\n| `players` | `[{ id, name, color }]`, ids `0..N-1` in seat order |\n| `host`, `isHost` | the id of the copy that runs a shared world, and whether it is this one |\n| `server` | `true` only on a copy that hosts a shared world with no player of its own |\n| `mode`, `round`, `limitMs` | the mode, the round number, and the round's hard limit after the start |\n| `seed` | a number, the same on every copy, behind `AIHub.rng(label)` |\n\nNames come from the hub and are never inserted into the page as HTML. Colours\nfollow the seat: `#e8443a`, `#3b82f6`, `#22c55e`, `#f5b700`.\n\n### The card\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc 'npm test'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,135p' engine/sim/actors.ts && sed -n '1,155p' engine/world/site.ts && cat .cache/engine-src/labs/playground/looks/*.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,135p' engine/sim/actors.ts && sed -n '1,155p' engine/world/site.ts && cat .cache/engine-src/labs/playground/looks/*.ts\"","aggregated_output":"/**\n * @file Actors (PLAN.md WP 3.2; WP 3.7 adds the animator): entities that walk, jump and dash through the character\n * controller (engine/physics/character.ts). `spawnActor(w, { at, character, player })` adds a capsule body to the\n * scene's physics world and spawns an entity with the component `actor` (its body, settings, intents, feet and the\n * controller's state), so the sim hashes, captures and restores all of it.\n *\n * The step (shardfall's order): movers set their velocities (`intents`, `ai`), the system `actors` moves every actor in\n * id order (`anim`), the world steps (`physics`), and `actors.readback` copies the feet into `x`, `y`, `z`\n * (`readback`). A player actor reads the step's intents: `move`, `jump` (held, pressed) and `dash` (pressed); any other\n * the intents its AI writes into `actor.intents`, its presses from the edges of `b`. Events: `jump` `{ id, at }`,\n * `land` `{ id, speed, at }`, `dash` `{ id, at }`, `at` its feet as the step began (where it happened, however late a\n * sound map reads it). Gravity: `physics.characterGravity` unless the settings name one; the weight on dynamic floors\n * uses `physics.gravity`. The component `oneWay` makes its body a one-way platform. WP 3.7: `anim` adds the component\n * `animator`, stepped by `actors.anim` after `actors` (its `reactions` first, WP 7.8) and, with `preciseHits`, posed by\n * `actors.pose` after `actors.readback` (engine/sim/actorAnim.ts) (`footstep` `{ id, side, speed, at, gait? }`, the gait its movement model's).\n * WP 8.9: `body` adds the component `puppet` (the body drawn), `clips` the clip layer (engine/sim/actorClips.ts).\n * WP 13.3 and 13.7: an actor on a movement model also holds `motion`, the model's state, and reads its buttons, view\n * and rides (`spawnActor` says which), and tells the move it enters (`move` `{ id, what, at }`, WP 13.22); launchers\n * set off any actor (`launch` `{ id, at }`). WP 13.9: a player's sprint and crouch work as `input.sprint` and\n * `input.crouch` say (held, or toggled by a press); WP 13.10: an animated actor's duck is its animator's pose `crouch`.\n *\n * Invariants: systems are added once per world, on the first (animated) spawn; all an actor remembers is in its\n * components (the sim's animators are loaded from them). Despawning leaves the body; `removeActor` removes both.\n * Carried from shardfall@fa2dab6 (`pavilion-lite/src/character.rs:179-399`: the order of a step, the events).\n * @example\n * import { createCharacter } from '../physics/character';\n * import { physicsOf } from '../physics/binding';\n * import { startScene, defineScene } from './scene';\n * defineScene('walk', {\n *   physics: true,\n *   setup(w) {\n *     physicsOf(w).addBody({ type: 'fixed', colliders: [{ shape: { type: 'box', size: [40, 1, 40] }, position: [0, -0.5, 0] }] });\n *     spawnActor(w, { at: [0, 0, 0], character: createCharacter({ speed: 5 }) });\n *   },\n * });\n * const { world } = startScene('walk');\n * for (let i = 0; i < 60; i++) world.step({ move: [1, 0] });\n * world.query('actor')[0].actor.x; // 4.69: a second's walk east at 5 m/s, from standing\n * @see engine/sim/actors.test.ts\n */\nimport { ANIMATOR_FIELDS, type AnimatorData, type AnimatorOptions } from '../anim/character';\nimport type { AnimatorInput } from '../anim/states';\nimport { codeError } from '../core/log';\nimport { registry as sharedRegistry, type Registry } from '../core/registry';\nimport { defineSettings } from '../core/settings';\nimport { held, pressed, type Intents } from '../input/intents';\nimport {\n  addCharacter,\n  bodyAt,\n  CHARACTER_SETTINGS,\n  CHARACTER_STATE_FIELDS,\n  createCharacter,\n  createCharacterState,\n  feetOf,\n  stepCharacter,\n  type Character,\n  type CharacterInput,\n  type CharacterState,\n} from '../physics/character';\nimport { matchHull } from '../physics/hull';\nimport { hullFor } from '../physics/movement/crouch';\nimport { createMotionState, MOTION_FIELDS, type MotionState } from '../physics/movement/model';\nimport { MOVEMENT_SETTINGS, movementOverrides, tuneCharacter } from '../physics/movement/settings';\nimport { physicsOf } from '../physics/binding';\nimport { vec, type Vec3Like } from '../physics/queries';\nimport { clipsFor, defineClipKinds, type ClipsSpec } from './actorClips';\nimport { poseAnimators, stepAnimators } from './actorAnim';\nimport { intentsOf, motionInput } from './actorInput';\nimport { defineActionKinds } from './actorActions';\nimport { defineReactionKinds } from './reactions';\nimport { defineRideKinds, ridesOf } from './rides';\nimport { defineComponent } from './state';\nimport type { World } from './world';\n\n/** The component `actor`'s own fields, before the controller's state. */\nconst ACTOR_FIELDS = {\n  body: { type: 'integer', default: -1, minimum: -1, description: 'Its body in the physics world.' },\n  player: { type: 'boolean', default: true, description: 'Whether it reads the step’s intents (else actor.intents).' },\n  character: { type: 'any', default: createCharacter(), description: 'Its settings: what createCharacter returned.' },\n  intents: { type: 'any', default: {}, description: 'What its AI wants this step (move, b, p), when not a player.' },\n  held: { type: 'array', default: [], description: 'The buttons its AI held last step, for presses.' },\n  x: { type: 'number', default: 0, unit: 'm', description: 'Where its feet are, east.' },\n  y: { type: 'number', default: 0, unit: 'm', description: 'Where its feet are, up.' },\n  z: { type: 'number', default: 0, unit: 'm', description: 'Where its feet are, south.' },\n} as const;\n\n/** The component `actor`: an entity the character controller moves. */\nexport interface ActorComponent extends CharacterState {\n  body: number;\n  player: boolean;\n  character: Character;\n  intents: Partial<Intents>;\n  held: string[];\n  x: number;\n  y: number;\n  z: number;\n}\n\n/** The component `animator`: an actor's character animator as plain data, and what its game code tells its body. */\nexport interface AnimatorComponent extends AnimatorData {\n  /** The body states its game code holds on (a pose, a stance, a flinch…); the controller's join them each step. */\n  states: Partial<AnimatorInput>;\n}\n\n/** The component `puppet`: the body an actor is drawn as (engine/gfx/puppets/actors.ts), when not the humanoid. */\nexport interface PuppetComponent {\n  body: string;\n}\n\n/** The components this module reads: `actor`, `animator`, `puppet`, `motion` (the shooter model's) and `oneWay`. */\nexport type ActorComponents = {\n  actor: ActorComponent;\n  animator: AnimatorComponent;\n  puppet: PuppetComponent;\n  motion: MotionState;\n  oneWay: { body: number };\n};\n\n/**\n * How a player's sprint and crouch buttons work, as a shooter's options set them (WP 13.9, docs/PLAYGROUND.md §3.3):\n * recorded settings, since they change how the same presses move him, read by the system `actors` for player actors.\n */\nexport const CONTROL_SETTING_FIELDS = {\n  'input.sprint': {\n    type: 'string',\n    enum: ['toggle', 'hold'],\n    default: 'toggle',\n    description: \"The sprint button on the shooter model: toggle, Apex's sticky sprint (a press keeps it on while the player moves on); hold, only while held. Recorded: it changes how a player moves.\", // prettier-ignore\n  },\n  'input.crouch': {\n    type: 'string',\n    enum: ['hold', 'toggle'],\n    default: 'hold',\n    description: 'The crouch button on the shooter model: hold, crouched while held; toggle, a press crouches until pressed again (a jump or a sprint stands it up). Recorded: it changes how a player moves.', // prettier-ignore\n  },\n/**\n * @file Sites (PLAN.md WP 13.15; docs/PLAYGROUND.md §6.3): a scene's levels standing on its terrain. `defineSite(id, {\n * terrain, structures })` registers one (the registry kind `site`) and `getSite(id)` makes it (`makeSite`): each\n * structure a level placed with its map's north-west corner at `at` (its storey on 0 standing at `at`'s height) and\n * turned `turn` quarter turns about +Y (counter-clockwise from above: east to north). The terrain is flattened round\n * each footprint to that height (`flatten` metres of margin), and cut where a structure has a floor of its own on or\n * under it (the floored tiles of its ground floor and of a storey below it, a basement; a one-storey level's whole map)\n * and the rectangles it names in `cuts` (window wells), so the cutaway can show what is below, nobody walks on ground\n * over a basement, and no ground shows through a floor at its height (WP 13.18). A cell is cut when such floors cover it\n * whole, so stand a structure's floors on whole cells of the terrain: the cut is exact there.\n *\n * Queries over all of it, in world metres (engine/world/siteQueries.ts): the highest surface under a point, its tag,\n * the structure, storey and room a point is in, whether a point is in a solid, and a clear sight line. `toLocal` and\n * `toWorld` carry points between a structure's frame and the world exactly (a quarter turn swaps and negates, so no\n * trigonometry), and `quarterTurn` is the rotation bodies and meshes take.\n *\n * Invariants: pure: equal specs give equal sites in Node and Chromium; a structure keeps its level's own data, in its\n * own frame; the terrain's cut is a flag per cell (`cut`), 1 where nothing of the terrain stands.\n *\n * @example\n * import { createRegistry } from '../core/registry';\n * import { defineLevel } from './level/level';\n * const reg = createRegistry();\n * defineLevel('level:hut', { text: '#####\\n#...#\\n#####\\n', file: 'hut.txt' }, reg);\n * defineSite('site:yard', { structures: [{ level: 'level:hut', at: [10, 0, 4], turn: 1 }] }, reg);\n * const [hut] = getSite('site:yard', reg).structures;\n * [hut.footprint, toWorld(hut, 1, 0), toLocal(hut, 10, 3)]; // [[10, -1, 13, 4], [10, 3], [1, 0]]: turned, east is north\n * @see engine/world/site.test.ts\n */\nimport { codeError } from '../core/log';\nimport { registry as sharedRegistry, type Entry, type Registry } from '../core/registry';\nimport type { Schema } from '../core/schema';\nimport { getLevel } from './level/level';\nimport type { CompiledLevel } from './level/types';\nimport { makeTerrain, type Terrain, type TerrainFlat, type TerrainSpec } from './terrain';\n\n/** The fields of a `site` entry (see the file comment). */\nexport const SITE_FIELDS = {\n  terrain: { type: 'string', default: '', description: 'Its terrain (`terrain:<name>`); none when empty.' },\n  structures: { type: 'array', items: { type: 'object' }, default: [], description: 'The levels standing on it: { level, at: [x, y, z], turn (quarter turns, 0 to 3), flatten (m, 4: the ground flattened round it), cuts ([[x0, z0, x1, z1]], its own metres: holes in the ground) }.' }, // prettier-ignore\n} as const satisfies Schema;\n\n/** A `site` entry. */\nexport type SiteEntry = Entry<typeof SITE_FIELDS>;\n\n/** A structure as a site's spec places it. */\nexport interface StructureSpec {\n  readonly level: string;\n  readonly at: readonly [number, number, number];\n  readonly turn?: number;\n  readonly flatten?: number;\n  readonly cuts?: readonly (readonly [number, number, number, number])[];\n}\n\n/** What `defineSite` takes. */\nexport interface SiteSpec {\n  readonly terrain?: string;\n  readonly structures?: readonly StructureSpec[];\n}\n\n/** A quarter turn's count, 0 to 3. */\nexport type QuarterTurns = 0 | 1 | 2 | 3;\n\n/** A structure placed: its level, in its own frame, and where it stands (see the file comment). */\nexport interface SiteStructure {\n  /** Its level's name, and its index in the site. */\n  readonly name: string;\n  readonly index: number;\n  readonly level: CompiledLevel;\n  readonly at: readonly [number, number, number];\n  readonly turn: QuarterTurns;\n  /** Its map's rectangle in the world, [x0, z0, x1, z1] (m). */\n  readonly footprint: readonly [number, number, number, number];\n  /** Its box in the world (m). */\n  readonly bounds: { readonly min: readonly [number, number, number]; readonly max: readonly [number, number, number] }; // prettier-ignore\n  /** The rectangles it cuts out of the ground, in its own metres. */\n  readonly cuts: readonly (readonly [number, number, number, number])[];\n}\n\n/** A made site (see the file comment). */\nexport interface Site {\n  /** Its id without `site:`. */\n  readonly name: string;\n  readonly terrain: Terrain | null;\n  readonly structures: readonly SiteStructure[];\n  /** Per terrain cell, row by row: 1 where the terrain is cut (null without a terrain or a cut). */\n  readonly cut: Uint8Array | null;\n}\n\n/** World (x, z) from a structure's own (lx, lz): turned `turn` quarter turns, then moved to `at`. */\nexport function toWorld(s: Pick<SiteStructure, 'at' | 'turn'>, lx: number, lz: number): [number, number] {\n  const [x, z] = turnVector(s.turn, lx, lz);\n  return [s.at[0] + x, s.at[2] + z];\n}\n\n/** A direction (x, z) turned `turn` quarter turns about +Y, as `toWorld` turns a structure's; never −0 (state holds it). */\nexport function turnVector(turn: QuarterTurns, x: number, z: number): [number, number] {\n  const [px, pz, nx, nz] = [x || 0, z || 0, -x || 0, -z || 0]; // never −0, whatever comes in\n  return ([[px, pz], [pz, nx], [nx, nz], [nz, px]] as [number, number][])[turn]; // prettier-ignore\n}\n\n/** A structure's own (x, z) from world (wx, wz): `toWorld` undone. */\nexport function toLocal(s: Pick<SiteStructure, 'at' | 'turn'>, wx: number, wz: number): [number, number] {\n  const [dx, dz] = [wx - s.at[0], wz - s.at[2]];\n  return [\n    [dx, dz],\n    [-dz, dx],\n    [-dx, -dz],\n    [dz, -dx],\n  ][s.turn] as [number, number];\n}\n\n/** The rotation of `turn` quarter turns about +Y, as [x, y, z, w]. */\nexport function quarterTurn(turn: QuarterTurns): readonly [number, number, number, number] {\n  return ([[0, 0, 0, 1], [0, Math.SQRT1_2, 0, Math.SQRT1_2], [0, 1, 0, 0], [0, Math.SQRT1_2, 0, -Math.SQRT1_2]] as const)[turn]; // prettier-ignore\n}\n\n/** A local rectangle [x0, z0, x1, z1] (m) of structure `s` as a world rectangle. */\nexport function worldRect(\n  s: Pick<SiteStructure, 'at' | 'turn'>,\n  [x0, z0, x1, z1]: readonly number[],\n): [number, number, number, number] {\n  // prettier-ignore\n  const [a, b] = [toWorld(s, x0, z0), toWorld(s, x1, z1)];\n  return [Math.min(a[0], b[0]), Math.min(a[1], b[1]), Math.max(a[0], b[0]), Math.max(a[1], b[1])];\n}\n\n/** The problems with a site spec's shape; none when it makes a site. */\nexport function siteProblems(spec: SiteSpec): string[] {\n  const problems: string[] = [];\n  (spec.structures ?? []).forEach((s, i) => {\n    const at = s?.at as unknown;\n    if (typeof s?.level !== 'string') problems.push(`structures[${i}].level must be a level id`);\n    if (!Array.isArray(at) || at.length !== 3 || !at.every(Number.isFinite)) problems.push(`structures[${i}].at must be [x, y, z] (m)`); // prettier-ignore\n    if (s?.turn !== undefined && ![0, 1, 2, 3].includes(s.turn)) problems.push(`structures[${i}].turn must be 0, 1, 2 or 3 quarter turns`); // prettier-ignore\n    if (s?.flatten !== undefined && !(s.flatten >= 0))\n      problems.push(`structures[${i}].flatten must be 0 or more metres`);\n    for (const cut of s?.cuts ?? []) {\n      if (!Array.isArray(cut) || cut.length !== 4 || !(cut[2] > cut[0] && cut[3] > cut[1])) problems.push(`structures[${i}].cuts must be [x0, z0, x1, z1] rectangles (x1 > x0, z1 > z0)`); // prettier-ignore\n    }\n  });\n  return problems;\n}\n\n/** A structure placed from its spec (see `SiteStructure`). */\nfunction place(spec: StructureSpec, index: number, registry: Registry): SiteStructure {\n  const level = getLevel(spec.level, registry);\n  const turn = (spec.turn ?? 0) as QuarterTurns;\n  const at = [spec.at[0], spec.at[1], spec.at[2]] as const;\n  const footprint = worldRect({ at, turn }, [0, 0, level.cols * level.tile, level.rows * level.tile]);\n  const [lo, hi] = [level.bounds.min, level.bounds.max];\n  const box = worldRect({ at, turn }, [lo[0], lo[2], hi[0], hi[2]]);\n  const bounds = { min: [box[0], at[1] + lo[1], box[1]] as const, max: [box[2], at[1] + hi[1], box[3]] as const };\n  return { name: level.name, index, level, at, turn, footprint, bounds, cuts: spec.cuts ?? [] };\n}\n/**\n * @file The look `look:playground-cel`, the playground cel-shaded (docs/PLAYGROUND.md §5.2, PLAN.md WP 13.24): the\n * toon style's ramp per material (three bands of light and a rim, each material's shadows its own colour shifted in\n * hue, cooler and more saturated, rather than darkened: `shade`), ink from depth and normals at sharp creases, the\n * outline shells round the props and the bodies (skinned ones too, engine/gfx/stageShells.ts), both 1 px at 270\n * lines and scaled to the picture's lines in whole pixels, and the sky's dome as a clean gradient (`skyGradient`).\n * By day and by night the light is the hour's (engine/gfx/daylight.ts); the look keeps its numbers. It is drawn at\n * the screen's full resolution (`resolution: 'full'`, while `gfx.resolution` is `auto`) with every texture blended\n * (`textures: 'smooth'`), the owner's directions of 2026-11-03 (WP 13.30, ADR-0025 amendments 47 and 49): the\n * engine's `pixels` resolution and crisp texels are the pixel look's.\n *\n * The ink is a dark tint of the surface under it (0.35 of it), at sharp creases only (0.2): measured in WP 13.2's\n * review, a 2 px black line at every crease covered the player's whole accent where the isometric and top-down\n * cameras draw the player 11 to 15 px tall, which tests/e2e/playground.spec.ts counts in every camera.\n *\n * Invariants: data only, the kind's fields (`node x describe look`); the sky `sky:daylight` (engine/gfx/sky.ts); every\n * filter it leaves out off. P steps to it from the clean look, the page's default (labs/playground/main.ts), and on\n * to the pixel look.\n *\n * @example\n * look.id; // 'look:playground-cel'\n * look.toon.bands; // 3\n * [look.resolution, look.textures]; // ['full', 'smooth']\n * @see labs/playground/looks/looks.test.ts\n * @see tests/e2e/playground-looks.spec.ts\n */\nimport { defineLook } from '../../../engine';\n\n/** The look `look:playground-cel`: three bands and a rim per material, hue-shifted shadows, ink, shells, a gradient sky. */\nexport const look = defineLook('look:playground-cel', {\n  description:\n    'The playground cel-shaded at full resolution: three bands and a rim per material, shadows shifted in hue, smooth textures, inked and outlined, a gradient sky.',\n  sky: 'sky:daylight',\n  style: 'toon',\n  resolution: 'full',\n  textures: 'smooth',\n  toon: { bands: 3, rim: 0.35, shade: 0.7 },\n  shells: { width: 1, color: '#1a1420' },\n  skyGradient: 1,\n  filters: {\n    outline: { scope: 'all', width: 1, lines: 270, darken: 0.35, crease: 0.2 },\n    grade: { scope: 'all', saturation: 1.15, contrast: 1.12 },\n  },\n});\n/**\n * @file The look `look:playground-clean`, the playground's default (docs/PLAYGROUND.md §5.2; the owner's direction of\n * 2026-11-03, ADR-0025 amendment 46): the picture as the scene draws it, unstyled: every material in the set's own\n * lit style (`style` left `''`), lit by the hour's sky (`sky:daylight`, engine/gfx/daylight.ts: the sun, the moon,\n * the ambient and the streetlights at dusk, as the other two looks have them), its dome as the day draws it (no\n * gradient), and edges smoothed (the `aa` filter: the engine's edge smoothing, FXAA unless the view setting `post.aa`\n * names another, engine/gfx/post/aa.ts), with no bands, ink, outline shells, pixels or grade. The engine's own\n * `look:clean` would keep the stage's own lights (a hemisphere and one sun under a plain background,\n * engine/gfx/stageSky.ts), which the hour and the lamps never reach, and smooth nothing.\n *\n * Drawn at the screen's full resolution (`resolution: 'full'`, while `gfx.resolution` is `auto`) with every texture\n * blended (`textures: 'smooth'`: linear filtering, so a floor up close is not a grid of 6 cm squares), the owner's\n * direction of 2026-11-03 (WP 13.30, ADR-0025 amendment 47): the engine's own `pixels` resolution and crisp texels\n * are the pixel look's.\n *\n * Invariants: data only, the kind's fields (`node x describe look`); the sky `sky:daylight`; the scene's own style;\n * every filter it leaves out off. The page draws it by default (labs/playground/main.ts); P steps on to the cel look,\n * then the pixel look.\n *\n * @example\n * look.id; // 'look:playground-clean'\n * look.filters.aa.scope; // 'all': its edges smoothed\n * [look.resolution, look.textures]; // ['full', 'smooth']\n * @see labs/playground/looks/looks.test.ts\n * @see tests/e2e/playground-looks.spec.ts\n */\nimport { defineLook } from '../../../engine';\n\n/** The look `look:playground-clean`: the scene's own lit materials under the hour's sky at full resolution, smoothed. */\nexport const look = defineLook('look:playground-clean', {\n  description:\n    \"The playground clean, its default: the scene's own lit materials under the hour's sky at full resolution, textures and edges smoothed; no bands, ink, outlines or pixels.\",\n  sky: 'sky:daylight',\n  resolution: 'full',\n  textures: 'smooth',\n  filters: { aa: { scope: 'all' } },\n});\n/**\n * @file Unit tests for the playground's looks (labs/playground/looks/clean.ts, cel.ts, pixel.ts and\n * pixelPerspective.ts): the clean look, the default (ADR-0025 amendment 46), parses, switches with `node x set\n * post.look`, lights the playground with daylight in the scene's own style under the hour's dome, and smooths its edges\n * and textures with nothing else on, at full resolution; the cel look at full resolution with smooth textures too, the\n * pixel look at the engine's pixels, crisp (WP 13.30); the toon looks each parse with every filter scoped, posterize\n * with 0 or 8 and more levels (the pixel looks with 24, as pixel art wants), light the playground with daylight in the\n * toon style, and `node x set post.look <id>` switches to each; the cel look's ramp, ink, shells and sky gradient (WP\n * 13.24); the pixel look's art block from the lines, its snap and glide, its dithered ramps, and its variant for the\n * perspective cameras, unsnapped, sharing its style and sky.\n * @see labs/playground/looks/clean.ts\n * @see labs/playground/looks/cel.ts\n * @see labs/playground/looks/pixel.ts\n * @see labs/playground/looks/pixelPerspective.ts\n */\nimport { describe, expect, it } from 'vitest';\nimport { registry } from '../../../engine/core/registry';\nimport '../../../engine/gfx/sky';\nimport { checkSetting } from '../../../tools/cmd/set';\nimport { look as cel } from './cel';\nimport { look as clean } from './clean';\nimport { look as pixel } from './pixel';\nimport { look as variant } from './pixelPerspective';\n\ndescribe.each([clean, cel, pixel, variant])('$id', (look) => {\n  it('parses: its description, and every filter with a scope', () => {\n    expect(look.description).not.toBe('');\n    for (const [name, filter] of Object.entries(look.filters)) expect(typeof filter.scope, name).toBe('string');\n  });\n\n  it('posterizes with 0 or 8 and more levels, so dull colours keep their hue', () => {\n    for (const [name, filter] of Object.entries(look.filters)) {\n      if ('levels' in filter) expect(filter.levels === 0 || filter.levels >= 8, `filters.${name}.levels`).toBe(true);\n    }\n  });\n\n  it('lights the playground with daylight, a registered sky', () => {\n    expect(look.sky).toBe('sky:daylight');\n    expect(registry.has('sky', look.sky)).toBe(true);\n  });\n\n  it('switches with node x set post.look: the chain draws this look, not the fallback', () => {\n    const change = checkSetting('post.look', look.id);\n    expect(change.value).toBe(look.id);\n    expect(registry.get('look', String(change.value))).toBe(look);\n  });\n});\n\ndescribe.each([cel, pixel, variant])('$id', (look) => {\n  it('draws in the toon style', () => {\n    expect(look.style).toBe('toon');\n  });\n});\n\ndescribe('look:playground-clean', () => {\n  it(\"draws in the scene's own style, its dome as the hour draws it, with no variant\", () => {\n    expect([clean.style, clean.skyGradient, clean.perspective]).toEqual(['', 0, '']);\n  });\n\n  it('smooths its edges over the whole picture and draws nothing else: no bands, ink, shells, pixels or grade', () => {\n    const on = Object.entries(clean.filters).filter(([, filter]) => filter.scope !== 'off');\n    expect(on.map(([name, filter]) => [name, filter.scope])).toEqual([['aa', 'all']]);\n    expect(clean.shells.width).toBe(0);\n  });\n\n  it('draws at full resolution with every texture blended', () => {\n    expect([clean.resolution, clean.textures]).toEqual(['full', 'smooth']);\n  });\n});\n\ndescribe('the resolution and textures of the toon looks', () => {\n  it(\"draws the cel look at full resolution with smooth textures, the pixel look at the engine's pixels, crisp\", () => {\n    expect([cel.resolution, pixel.resolution]).toEqual(['full', 'pixels']);\n    expect([cel.textures, pixel.textures], \"the pixel look keeps each texture's own: crisp\").toEqual(['smooth', '']);\n  });\n});\n\ndescribe('look:playground-cel', () => {\n  it('ramps every material in three bands and a rim with hue-shifted shadows, smoothed edges', () => {\n    expect(cel.toon).toEqual({ bands: 3, rim: 0.35, shade: 0.7, dither: 0 });\n  });\n\n  it('inks 1 px at 270 lines, scaled with the picture, outlines the props and bodies, and draws a gradient sky', () => {\n    expect(cel.filters.outline).toMatchObject({ scope: 'all', width: 1, lines: 270 });\n    expect(cel.shells).toEqual({ width: 1, color: '#1a1420' });\n    expect([cel.skyGradient, cel.perspective]).toEqual([1, '']);\n  });\n});\n\ndescribe('look:playground-pixel', () => {\n  it('draws the art block the lines give, snapped and gliding, with 1-pixel ink and 24 shades', () => {\n    expect(pixel.filters.pixel).toMatchObject({ scope: 'all', size: 0, snap: true, smooth: true, outline: false });\n    expect(pixel.filters.outline).toMatchObject({ scope: 'all', width: 1, lines: 270 });\n    expect(pixel.filters.palette).toMatchObject({ scope: 'all', palette: 'none', levels: 24 });\n  });\n\n  it('ramps every material in four shades, the steps dithered, the shadows shifted in hue', () => {\n    expect(pixel.toon.bands).toBe(4);\n    expect([pixel.toon.dither > 0, pixel.toon.shade > 0]).toEqual([true, true]);\n    expect(pixel.shells.width).toBe(0); // its ink is the outline filter's, a pixel wide\n  });\n\n  it('draws its variant for the perspective cameras: unsnapped, no glide, a lighter dither, its style and sky', () => {\n    expect(pixel.perspective).toBe(variant.id);\n    expect(variant.filters.pixel).toMatchObject({ size: 0, snap: false, smooth: false });\n    expect(variant.toon.dither).toBeLessThan(pixel.toon.dither);\n    expect([variant.style, variant.sky]).toEqual([pixel.style, pixel.sky]);\n    const { pixel: own, ...rest } = pixel.filters;\n    const { pixel: theirs, ...others } = variant.filters;\n    expect([own.size, own.levels]).toEqual([theirs.size, theirs.levels]);\n    expect(rest).toEqual(others);\n  });\n});\n/**\n * @file The look `look:playground-pixel`, the playground as pixel art (docs/PLAYGROUND.md §5.2, PLAN.md WP 13.24): a\n * low-resolution picture at a whole-number scale (the pixel filter's `size` 0: the largest whole block giving 240 to\n * 360 lines, one drawn pixel in the engine's `pixels` resolution, engine/gfx/post/grid.ts), 1-pixel ink from depth and\n * normals, each material a ramp of four shades its shadows shifted in hue, its steps mixed by an ordered dither\n * fixed to the world (the toon style's `dither`, its cells counted from the snap), 24 shades a channel. The\n * orthographic cameras (isometric, top-down, at whole-number zooms: `cam.wholeZoom`) are snapped to the pixel grid in\n * translation, the remainder carried as a smooth offset of the upscaled picture (`smooth`; the page's canvas has a\n * margin of two drawn pixels for it), so a pan never shimmers; the sky a clean gradient. The perspective cameras, where\n * snapping cannot hold, draw its variant (labs/playground/looks/pixelPerspective.ts). It names the engine's `pixels`\n * resolution (`resolution`, drawn while `gfx.resolution` is `auto`; the clean and cel looks draw at full, WP 13.30),\n * the snap's and the glide's drawn pixel.\n *\n * Invariants: data only, the kind's fields (`node x describe look`); the sky `sky:daylight`; levels 0 or at least 24,\n * so pixel art keeps its hues (engine/gfx/post/filters.ts); every filter it leaves out off.\n *\n * @example\n * look.id; // 'look:playground-pixel'\n * look.filters.pixel.size; // 0: the art block from the lines\n * @see labs/playground/looks/looks.test.ts\n * @see tests/e2e/playground-looks.spec.ts\n */\nimport { defineLook } from '../../../engine';\nimport { PIXEL_FILTERS, PIXEL_TOON } from './pixelPerspective';\n\n/** The look `look:playground-pixel`: a low-resolution picture, ramps dithered on the world, snapped and gliding. */\nexport const look = defineLook('look:playground-pixel', {\n  description:\n    'The playground as pixel art: 240 to 360 lines, 1-pixel ink, a ramp of four shades per material dithered on the world, the camera snapped to the pixels and gliding.',\n  sky: 'sky:daylight',\n  style: 'toon',\n  resolution: 'pixels',\n  toon: PIXEL_TOON,\n  perspective: 'look:playground-pixel-perspective',\n  skyGradient: 1,\n  filters: { ...PIXEL_FILTERS, pixel: { ...PIXEL_FILTERS.pixel, snap: true, smooth: true } },\n});\n/**\n * @file The look `look:playground-pixel-perspective`, the pixel look's variant for the perspective cameras (first\n * person, the shooter and the platformer; docs/PLAYGROUND.md §5.2, PLAN.md WP 13.24): the chain draws its filters and\n * toon numbers in place of `look:playground-pixel`'s while the camera is a perspective one (the look's `perspective`,\n * engine/gfx/post/chain.ts), its style and sky staying the pixel look's. A perspective picture moves in depth, where\n * no snap to the pixel grid can hold it still, so it draws unsnapped, with no glide, and its dither, fixed to the\n * screen there, is lighter, so the pattern crawls less over moving surfaces. `PIXEL_FILTERS` and `PIXEL_TOON` are\n * what both share.\n *\n * Invariants: data only; the pixel look's style and sky.\n *\n * @example\n * look.filters.pixel.snap; // false\n * @see labs/playground/looks/looks.test.ts\n */\nimport { defineLook } from '../../../engine';\n\n/** The pixel looks' toon numbers: four bands and a rim, shadows shifted in hue, the steps dithered. */\nexport const PIXEL_TOON = { bands: 4, rim: 0.3, shade: 0.6, dither: 0.5 } as const;\n\n/** The pixel looks' filters: the art block from the lines, 1-pixel ink, 24 shades a channel. */\nexport const PIXEL_FILTERS = {\n  pixel: { scope: 'all', size: 0, levels: 0, outline: false, snap: false, smooth: false },\n  outline: { scope: 'all', width: 1, lines: 270, darken: 0.3, crease: 0.4 },\n  palette: { scope: 'all', palette: 'none', levels: 24, dither: 0 },\n} as const;\n\n/** The look `look:playground-pixel-perspective` (see the file comment). */\nexport const look = defineLook('look:playground-pixel-perspective', {\n  description:\n    \"The pixel look's variant for the perspective cameras: unsnapped, no glide, a lighter dither on the screen.\",\n  sky: 'sky:daylight',\n  style: 'toon',\n  toon: { ...PIXEL_TOON, dither: 0.3 },\n  filters: PIXEL_FILTERS,\n});\n","exit_code":0,"status":"completed"}}
