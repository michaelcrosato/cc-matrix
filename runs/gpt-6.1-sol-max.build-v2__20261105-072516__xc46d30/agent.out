{"type":"item.completed","item":{"id":"item_208","type":"command_execution","command":"/bin/bash -lc \"sed -n '22,53p' engine/physics/movement/settings.ts\nsed -n '75,108p' labs/game/boot.ts\nsed -n '67,80p' tests/game/page.mjs\nhead -12 labs/game/main.ts\"","aggregated_output":"import { defineSettings } from '../../core/settings';\nimport type { Character } from '../character';\nimport { MODEL_FIELDS, type MovementModel } from './model';\n\n/** One setting off its default: the model's group (none for `turnRate`), the number's or switch's key, and its value. */ // prettier-ignore\nexport type MovementOverride = readonly [group: string | undefined, key: string, value: number | boolean];\n\n/** One number or switch of the model: its setting's path, its group (none for `turnRate`), its key and its field. */\ntype ModelValue = readonly [path: string, group: string | undefined, key: string, field: Field];\n\n/** The model's numbers and switches (`crouch.jump`, `mantle.boost`), each with its group's description before its own. */ // prettier-ignore\nconst VALUES: readonly ModelValue[] = Object.entries(MODEL_FIELDS).flatMap(([group, field]): ModelValue[] => {\n  const own = field as Field & { properties?: Record<string, Field> };\n  if (!own.properties) return [[`movement.${group}`, undefined, group, own]];\n  return Object.entries(own.properties).flatMap(([key, each]): ModelValue[] => {\n    const description = `${own.description} ${each.description}`;\n    return each.type === 'number' || each.type === 'integer' || each.type === 'boolean' ? [[`movement.${group}.${key}`, group, key, { ...each, description }]] : []; // prettier-ignore\n  });\n});\n\n/** The settings, path → field: each the model's number or switch with its group's description first, live. */\nexport const MOVEMENT_SETTINGS: Readonly<Record<string, Field>> = Object.fromEntries(\n  VALUES.map(([path, , , field]) => [path, { ...field, when: 'now' }]),\n);\ndefineSettings(MOVEMENT_SETTINGS);\n\n/** The settings `get` reads off their defaults, as overrides (none when every one is at its default). */\nexport function movementOverrides(get: (path: string) => unknown): MovementOverride[] {\n  const out: MovementOverride[] = [];\n  for (const [path, group, key, field] of VALUES) {\n    const value = get(path);\n    if ((typeof value === 'number' || typeof value === 'boolean') && !Object.is(value, field.default)) out.push([group, key, value]); // prettier-ignore\n          'gfx.featuresOff',\n          JSON.stringify([\n            'feature:gpuCrowds',\n            'feature:cascadedShadows',\n            'feature:gi',\n            'feature:ssr',\n            'feature:ao',\n            'feature:air',\n            'feature:tiledLighting',\n            'feature:timestamps',\n            'feature:traa',\n          ]),\n        );\n    }\n    for (const key of [\n      'input.sensitivity',\n      'input.stickSensitivity',\n      'input.invert',\n      'input.stickInvert',\n      'input.crouch',\n    ]) {\n      const v = store.get(key, null);\n      if (v !== null) search.set(key, String(v));\n    }\n    let sentReady = false;\n    const early = setInterval(() => {\n      const e = ctx.inspector();\n      if (!e || !info || !hub || sentReady) return;\n      sentReady = true;\n      e.pause();\n      netStop = startLockstep(hub, e, {\n        sample: options.sample,\n        onEnd: () => {\n          audio.mute(true);\n  });\n  check(\n    'live wear slider',\n    await page.evaluate(() => window.__engine.state('campaign').settings['game.wear.perShot'] === 0.02),\n  );\n  await page.getByRole('button', { name: 'Reset to defaults', exact: true }).click();\n  check(\n    'balance reset',\n    await page.evaluate(\n      () => Math.abs(window.__engine.state('campaign').settings['game.wear.perShot'] - 0.0012) < 1e-10,\n    ),\n  );\n  await page.screenshot({ path: 'out/page/dev.png' });\n});\n/** @file Bar Cry's page: boot, presentation, saved accounts, real-time menus and the network pump. */\nimport { info } from './net/session';\nimport { boot } from './boot';\nimport { createStore, type EngineFrame, type CameraInput } from '../../engine';\nimport { campaign, players, type GW } from './scenes/state';\nimport { makeSave } from './scenes/save';\nimport {contractPreset} from './scenes/preset';\nimport { TITLE } from './title';\nimport { audio, soundFrame } from './sounds/page';\nimport { renderScreen } from './ui/screens';\nimport { navigation, refreshGlyphs } from './ui/controls';\nimport { inspector, type Context } from './ui/context';\n","exit_code":0,"status":"completed"}}
