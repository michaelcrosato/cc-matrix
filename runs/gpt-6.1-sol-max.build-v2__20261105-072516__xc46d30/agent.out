/presets.ts's when absent). */\n79-  readonly zooms?: readonly number[];\n80-  /** The point views and orbits follow (the hero's feet, or a point just ahead of his aim), m. */\n81-  readonly follow?: Vec3;\n82-}\n83-\n84-/** A camera: its state, stepped once per rendered frame, and its pose. Made by the factories, or `createCamera`. */\n85-export interface Camera {\n86-  readonly type: CameraType;\n87-  /** Steps the camera by one rendered frame (`dt` real seconds) and returns its new pose. */\n88-  update(input?: CameraInput, dt?: number): CameraPose;\n89-  /** The pose after the last update. */\n90-  pose(): CameraPose;\n91-  /** The heading, rad: what `intents.fromCamera` and the intents' `cam` take (engine/input/intents.ts). */\n92-  yaw(): number;\n93-  /** The camera as a code's data (engine/gfx/cameras/codes.ts). */\n94-  spec(): CameraSpec;\n95-  /** The camera as a code: `cam=…` or `cam3=…`. */\n96-  code(): string;\n97-  /** The camera in words. */\n98-  describe(): string;\n99-}\n100-\n--\n140:export function makePose(fields: Partial<CameraPose> & { position: Vec3 }): CameraPose {\n141-  const p = { ...POSE_DEFAULTS, ...fields };\n142-  const problems = [\n143-    ...pointProblems('position', p.position),\n144-    ...rangeProblems({\n145-      yaw: [p.yaw, -1e9, 1e9],\n146-      pitch: [p.pitch, -Math.PI / 2, Math.PI / 2],\n147-      roll: [p.roll, -Math.PI / 2, Math.PI / 2],\n148-      fov: [p.fov, 1, 179],\n149-      frustumSize: [p.frustumSize, 1e-6, 1e9],\n150-      zoom: [p.zoom, 1e-3, 1e3],\n151-      near: [p.near, 1e-6, 1e9],\n152-      far: [p.far, p.near, 1e9],\n153-      boost: [p.boost, 0.01, 100],\n154-      distance: [p.distance, 0, 1e9],\n155-    }),\n156-  ];\n157-  if (p.projection !== 'perspective' && p.projection !== 'orthographic') {\n158-    problems.push(`projection is ${JSON.stringify(p.projection)}; it must be 'perspective' or 'orthographic'`);\n159-  }\n160-  refuse('makePose', problems);\n161-  return Object.freeze({ ...p, position: Object.freeze([...p.position]) as unknown as Vec3 });\n162-}\n163-\n164-/** The unit view direction (three.js's `camera.getWorldDirection()`). */\n165-export function poseForward(pose: Pick<CameraPose, 'yaw' | 'pitch'>): Vec3 {\n166-  const c = Math.cos(pose.pitch);\n167-  return [Math.sin(pose.yaw) * c, Math.sin(pose.pitch), Math.cos(pose.yaw) * c];\n168-}\n169-\n170-/** The unit right direction on screen: forward × up, level whatever the pitch, tipped down by a `roll` (if any). */\n171-export function poseRight(pose: Pick<CameraPose, 'yaw'> & { readonly pitch?: number; readonly roll?: number }): Vec3 {\n172-  const level: Vec3 = [-Math.cos(pose.yaw), 0, Math.sin(pose.yaw)];\n173-  const roll = pose.roll ?? 0;\n174-  if (roll === 0) return level;\n175-  const up = poseUp({ yaw: pose.yaw, pitch: pose.pitch ?? 0 });\n// T0 project: the code that runs on the engine, without its tests: the labs, the fixtures, the tools, the test pages,\n// specs and helpers, the Claude Code hooks and the root configs (tsconfig.check.json).\n{\n  \"extends\": \"./tsconfig.base.json\",\n  \"compilerOptions\": {\n    \"composite\": true,\n    \"emitDeclarationOnly\": true,\n    \"rootDir\": \".\",\n    \"outDir\": \"node_modules/.cache/tsc\"\n  },\n  \"include\": [\"labs\", \"fixtures\", \"tools\", \"tests\", \".claude/hooks\", \"*.config.ts\", \"package-lock.json\"],\n  \"exclude\": [\"**/*.test.ts\"],\n  \"references\": [{ \"path\": \"./tsconfig.engine.json\" }]\n}\n","exit_code":0,"status":"completed"}}
