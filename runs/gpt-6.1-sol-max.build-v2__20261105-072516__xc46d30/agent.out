{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"sed -n '150,218p' engine/world/props/prop.ts\nrg -n 'export interface PropPlacement|scale:' engine/world/props/prop.ts engine/world/props/place.ts | head -20\nsed -n '45,115p' engine/anim/actions-data.ts\nrg -n 'export function handOff|export function addRagdolls' engine/sim/ragdoll.ts\nrg -n 'export interface ActorSpec' -A65 engine/sim/actors.ts\"","aggregated_output":"  into: { type: 'string', default: '', description: \"The prop its pieces are ('prop:<id>', dynamic); '' none.\" },\n  pieces: { type: 'integer', default: 0, minimum: 0, maximum: 16, description: 'How many pieces it leaves.' },\n  shards: {\n    type: 'string',\n    default: '',\n    description: \"The event it breaks with, its look ('glass', 'splinters'); '' shatter.\",\n  },\n} as const satisfies Schema;\n\n/** The fields of where a level places a prop. */\nconst PLACE_FIELDS = {\n  spawn: {\n    type: 'string',\n    default: '',\n    description: \"The spawn name whose points place it, on their floor (a glyph with spawn: 'crate'); '' none.\",\n  },\n  light: {\n    type: 'string',\n    default: '',\n    description: \"The light-spot tag whose spots place it, on the top of the spot's tile ('torch'); '' none.\",\n  },\n} as const satisfies Schema;\n\n/** The fields of a `prop` entry. */\nexport const PROP_FIELDS = {\n  description: { type: 'string', default: '', description: 'What it is, in plain sentences.' },\n  parts: {\n    type: 'array',\n    items: { type: 'object', properties: PROP_PART_FIELDS },\n    default: [],\n    description: 'Its meshes: { name, geometry, params, material, top, tint, position, rotation, shadow, flame }.',\n  },\n  body: {\n    type: 'object',\n    default: defaultsOf(BODY_FIELDS),\n    description: 'Its body in the physics world, standing on its base: { type, shape, size, radius, height, … }.',\n    properties: BODY_FIELDS,\n  },\n  light: {\n    type: 'object',\n    default: defaultsOf(LIGHT_FIELDS),\n    description: \"Its light spot, for the light pool (WP 7.1): { tag, color, intensity, … }; tag '' for none.\",\n    properties: LIGHT_FIELDS,\n  },\n  place: {\n    type: 'object',\n    default: defaultsOf(PLACE_FIELDS),\n    description: 'Where a level places it (levelProps): on spawn points by name, or under light spots by tag.',\n    properties: PLACE_FIELDS,\n  },\n  health: {\n    type: 'number',\n    default: 0,\n    minimum: 0,\n    description: 'Its hit points (WP 13.16): damage takes them, and at 0 it breaks; 0: it never breaks.',\n  },\n  breaks: {\n    type: 'object',\n    default: defaultsOf(BREAK_FIELDS),\n    description: \"What breaking leaves: { into (the pieces' prop), pieces, shards (the event it breaks with) }.\",\n    properties: BREAK_FIELDS,\n  },\n  prompt: {\n    type: 'string',\n    default: '',\n    description: \"What the HUD says using it does ('Read'), when its own `use` answers; '' for none.\",\n  },\n  hit: {\n    type: 'function',\nengine/world/props/place.ts:34:export interface PropPlacement {\nconst zero = (description: string, unit: string) => ({ type: 'number', default: 0, unit, description }) as const;\nconst seconds = (description: string) => ({ type: 'number', minimum: 0, unit: 's', description }) as const;\n\n/** The fields of a beat. */\n// prettier-ignore\nexport const BEAT_FIELDS = {\n  name: { type: 'string', required: true, description: 'Its name, fired as an event as it begins; `go` takes it.' },\n  seconds: { ...seconds('How long it lasts; held until next, how long its channels take to reach their targets.'), required: true },\n  until: { type: 'string', enum: ['time', 'next'], default: 'time', description: 'Ends after its seconds, or holds until next() or go().' },\n  then: { type: 'string', default: '', description: 'The beat that follows (\"\": the next in order; a loop names one).' },\n  body: { type: 'object', description: 'Body states told to the humanoid while it plays: pose, stance, air, down… (states.ts BODY_STATES).' },\n  motion: { type: 'object', description: 'A body motion it eases to (locomotion.ts BodyMotion); none: 0 each.', properties: {\n    lean: zero('Forward lean.', 'rad'), lunge: zero('Step forward of the pelvis and the lead foot.', 'm'),\n    hop: zero('Lift of the whole body.', 'm'), crouch: share('Crouch share.'),\n    twist: zero('Turn of the shoulders toward the right hand.', 'rad'),\n  } },\n  move: { type: 'object', description: 'A move at one phase over the beat (its arm path and body motion), not a motion.', properties: {\n    id: { type: 'string', required: true, description: 'The move: move:overhead, or overhead.' },\n    phase: { type: 'string', enum: ['wind', 'active', 'recover'], required: true, description: 'The phase.' },\n    u: { type: 'array', items: { type: 'number' }, default: [0, 1], description: 'Its share at the start and end.' },\n  } },\n  effectors: { type: 'object', description: 'IK targets [forward, right, up], metres (see the file comment).', properties: {\n    handL: fru(\"The left hand's grip, from the shoulder centre.\"), handR: fru(\"The right hand's grip, likewise.\"),\n    footL: fru('The left sole, from the ground under the body.'), footR: fru('The right sole, likewise.'),\n    look: fru('Where the eyes look, from the shoulder centre.'),\n  } },\n  flip: { type: 'object', description: 'The whole body turned over the beat, eased: whole turns end upright.', properties: {\n    turns: { type: 'number', default: 1, description: 'Turns over the beat.' }, ground: flag('A roll: its lowest point stays on the ground.'),\n    axis: { type: 'string', enum: Object.keys(FLIP_AXES), default: 'forward', description: 'Which way (FLIP_AXES).' },\n  } },\n  scale: { type: 'array', items: { type: 'number', minimum: 0.01 }, description: 'The body squashed: [x, y, z].' },\n  clip: { type: 'object', description: 'A library clip played as it begins (ClipPlay); the same clip keeps its time.', properties: {\n    name: { type: 'string', required: true, description: 'SET/Clip, or a bare name.' },\n    speed: { type: 'number', minimum: 0, description: 'Playback rate (0 holds the frame).' },\n    fade: seconds('Seconds it fades in.'), out: seconds('Seconds it fades out.'), at: seconds('Clip seconds it starts from.'),\n    mask: { type: 'string', enum: MASKS, description: 'The joints it plays (skeleton.ts MASKS).' },\n    loop: flag('Loops, or not.'), additive: flag('Added to the pose under it.'), mirror: flag('Left and right swapped.'),\n    walk: flag('Moving or a flinch does not cancel it.'), hold: flag('A one-shot keeps its last pose.'),\n    landed: seconds('Clip seconds by which a fall is down.'),\n  } },\n  events: { type: 'array', default: [], description: 'Events at shares of its seconds.', items: { type: 'object', properties: {\n    type: { type: 'string', required: true, description: 'The event.' }, at: share('Share of the beat where it fires.'),\n  } } },\n  cancel: { type: 'object', description: 'What may cut it (move, action, walk, jump, hurt, any), from a share on.', properties: {\n    by: { type: 'array', items: { type: 'string' }, required: true, description: 'What may cut it.' },\n    after: share('Share of the beat from which it may.'),\n  } },\n  flags: { type: 'array', items: { type: 'string' }, default: [], description: 'Flags it raises (invulnerable).' },\n} as const;\n\n/** The fields of an `action` entry. */\n// prettier-ignore\nexport const ACTION_FIELDS = {\n  desc: { type: 'string', required: true, description: 'What it is and where its timing comes from.' },\n  beats: { type: 'array', required: true, items: { type: 'object', properties: BEAT_FIELDS }, description: 'Its beats.' },\n  exit: { type: 'string', default: '', description: 'The beat finish() goes to (\"\": it stops).' },\n  pair: { type: 'string', default: '', description: \"The partner's action, played in lockstep (a grab's victim).\" },\n  check: { type: 'object', default: { seconds: 0, signals: [], lift: [] }, description: 'How the anim QA plays it (actionCheck).', properties: {\n    seconds: { ...seconds('How long (0: the last signal, then its length, plus ACTION.out).'), default: 0 },\n    signals: { type: 'array', default: [], description: 'What the game does, when: next, finish, stop or a beat (go).', items: {\n      type: 'object', properties: {\n        at: { ...seconds('Seconds after it starts.'), required: true },\n        do: { type: 'string', required: true, description: 'next, finish, stop or a beat.' },\n      } } },\n    lift: { type: 'array', default: [], items: { type: 'array', items: { type: 'number' } },\n      description: \"[seconds, metres] points: the body's height, linear between them (the jump the game makes).\" },\n  } },\n} as const;\n\n/** An `action` entry. */\nexport type Action = Entry<typeof ACTION_FIELDS>;\nrg: engine/sim/ragdoll.ts: IO error for operation on engine/sim/ragdoll.ts: No such file or directory (os error 2)\n195:export interface ActorSpec {\n196-  /** Where its feet go: on the ground below them (it starts just above, outside the skin). */\n197-  at: Vec3Like;\n198-  /** Its settings (createCharacter). */\n199-  character: Character;\n200-  /** Whether it reads the step's intents (true); false: its AI writes `actor.intents`. */\n201-  player?: boolean;\n202-  /** Where it faces (rad; forward = (sin yaw, 0, cos yaw)). */\n203-  yaw?: number;\n204-  /** Its character animator's make (engine/anim/character.ts); none when absent. */\n205-  anim?: Pick<AnimatorOptions, 'build' | 'weapon' | 'preciseHits'>;\n206-  /** The body it is drawn as (`body:mannequin`), with `anim`; the neutral humanoid when absent. */\n207-  body?: string;\n208-  /** With `anim`, the clip layer in its animator, playing from these sets (engine/sim/actorClips.ts); none when absent. */\n209-  clips?: ClipsSpec;\n210-  /** With a movement model, whether it starts with no weapon out (true: the model's holstered speeds). */\n211-  holstered?: boolean;\n212-  /**\n213-   * Further components it spawns with, by name (its `reactions`, its `secondary`: engine/sim/reactions.ts), so they\n214-   * are there from its first step, and a page's first warm-up builds what they draw.\n215-   */\n216-  components?: Readonly<Record<string, object>>;\n217-}\n218-\n219-/**\n220- * Spawns an actor in a scene with a physics world: its body, and an entity with the component `actor`. Returns the id.\n221- * An actor on a movement model (engine/physics/movement/, WP 13.3) also holds `motion`, the model's state (holstered\n222- * unless spawned `holstered: false`), and reads `sprint` (held, pressed), `walk` and `crouch` (held), `crouchToggle`\n223- * (pressed), the view from `look`, the keys' frame from `cam` (else `look`) and what it faces from `aim` (else\n224- * `look`), under the live `movement.*` settings (WP 13.4); WP 13.7: the look's pitch and `interact` (pressed) too,\n225- * riding the scene's ziplines and ladders (engine/sim/rides.ts); WP 13.9: a player's sprint held only while held with\n226- * `input.sprint` at `hold`, and his crouch toggled by its press with `input.crouch` at `toggle`.\n227- */\n228-export function spawnActor<C extends object>(world: World<C>, spec: ActorSpec): number {\n229-  const w = world as unknown as World;\n230-  const physics = physicsOf(w);\n231-  const body = addCharacter(physics, spec.character, spec.at);\n232-  const { x, y, z } = feetOf(physics, body, spec.character);\n233-  const state = { ...createCharacterState(), yaw: spec.yaw ?? 0 };\n234-  if (!w.systems.has('actors')) {\n235-    w.systems.add('actors', moveActors, { phase: 'anim' });\n236-    w.systems.add('actors.readback', readActors, { phase: 'readback' });\n237-  }\n238-  const actor = { body, player: spec.player ?? true, character: spec.character, x, y, z, ...state };\n239-  const motion = spec.character.movement ? { motion: { ...createMotionState(), holstered: spec.holstered ?? true } } : {}; // prettier-ignore\n240-  if (!spec.anim) return w.spawn({ ...spec.components, ...motion, actor });\n241-  if (!w.systems.has('actors.anim')) {\n242-    w.systems.add('actors.anim', stepAnimators, { phase: 'anim' });\n243-    w.systems.add('actors.pose', poseAnimators, { phase: 'readback' });\n244-  }\n245-  const { build = 'build:chibi', weapon = 'none', preciseHits = false } = spec.anim;\n246-  const animator = { build: typeof build === 'string' ? build : build.id, weapon, preciseHits };\n247-  const puppet = spec.body !== undefined ? { body: spec.body } : undefined;\n248-  const clips = spec.clips && (clipsFor(w, spec.clips, animator.build) as unknown as Record<string, unknown>);\n249-  return w.spawn({ ...spec.components, ...motion, actor, animator, puppet, clips });\n250-}\n251-\n252-/**\n253- * Puts actor `id` at `at`, its feet on the ground below (just above, outside the skin, as a spawn stands it), facing\n254- * `yaw` (its own when absent), at rest: no velocity, no jump, dash or landing pending, standing (its hull too); on the\n255- * shooter model its motion state starts again, holstered as it was, or ducked with `crouch`, its hull crouched from its\n256- * next step on and kept so until it has headroom, for a place no standing hull fits (a crawlspace). A place where the\n257- * level (the queries' as of the last step, one-way platforms aside) stands over its feet lower than its hull's top, up\n258- * its axis, throws `SIM_BAD_ARGUMENT` before it moves anything: the body would sink through the floor. For a scene's dev actions: a feel\n259- * course places its player where it measures (engine/dev/feel/course.ts).\n260- */\n","exit_code":0,"status":"completed"}}
