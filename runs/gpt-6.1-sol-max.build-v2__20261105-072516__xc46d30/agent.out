{"type":"item.completed","item":{"id":"item_255","type":"command_execution","command":"/bin/bash -lc \"sed -n '102,150p' engine/audio/runtime/spatial.ts\nsed -n '234,274p' engine/gfx/cameras/collide.ts\nrg -n 'wallsBetween|muffling' engine/audio/runtime/*.ts\"","aggregated_output":"export function placePanner(panner: PannerNode, position: Vec3, time: number): void {\n  setParams([panner.positionX, panner.positionY, panner.positionZ], position, time);\n}\n\n/** The lowpass cutoff (Hz) and the gain a sound behind `walls` walls goes through: open at 0 (see the file comment). */\nexport function muffling(walls: number, open: number = OCCLUSION.open): { cutoff: number; gain: number } {\n  const n = Math.min(Math.max(Math.round(walls), 0), OCCLUSION.walls);\n  return n === 0 ? { cutoff: open, gain: 1 } : { cutoff: OCCLUSION.cutoff / 2 ** (n - 1), gain: OCCLUSION.gain ** n };\n}\n\n/**\n * How many walls of the level stand between `from` (the listener) and `to` (the sound), up to `most`: a ray to each\n * wall, another from inside it to its far side (`solid: false`), on from just past it; stopping `OCCLUSION.margin`\n * short of the sound, as `occluded` does.\n */\nexport function wallsBetween(queries: QueryView, from: Vec3, to: Vec3, most: number = OCCLUSION.walls): number {\n  const d: Vec3 = [to[0] - from[0], to[1] - from[1], to[2] - from[2]];\n  const length = Math.hypot(...d);\n  if (length <= OCCLUSION.margin) return 0;\n  const dir: Vec3 = [d[0] / length, d[1] / length, d[2] / length];\n  const end = length - OCCLUSION.margin;\n  const at = (t: number): Vec3 => [from[0] + dir[0] * t, from[1] + dir[1] * t, from[2] + dir[2] * t];\n  let [t, walls] = [0, 0];\n  while (walls < most) {\n    const hit = queries.raycast(at(t), dir, { maxDistance: end - t, groups: OCCLUSION.groups });\n    if (!hit) break;\n    walls++;\n    const inside = t + hit.distance + 1e-3; // a ray from on its face would meet that face again\n    const out = queries.raycast(at(inside), dir, { maxDistance: end - inside, groups: OCCLUSION.groups, solid: false }); // prettier-ignore\n    if (!out) break; // the wall runs on past the sound\n    t = inside + out.distance + 1e-3;\n    if (t >= end) break;\n  }\n  return walls;\n}\n\n/** Whether a wall of the level stands between `from` (the listener) and `to` (the sound). */\nexport function occluded(queries: QueryView, from: Vec3, to: Vec3): boolean {\n  const d: Vec3 = [to[0] - from[0], to[1] - from[1], to[2] - from[2]];\n  const length = Math.hypot(...d);\n  if (length <= OCCLUSION.margin) return false;\n  const dir: Vec3 = [d[0] / length, d[1] / length, d[2] / length];\n  return queries.raycast(from, dir, { maxDistance: length - OCCLUSION.margin, groups: OCCLUSION.groups }) !== null;\n}\n  const fit = { type: 'ball', radius: COLLIDE_RADIUS - COLLIDE_SKIN } as const;\n  /** Whether a ball swept from the base gets to `at` past `these` walls (within the 2 skins a sweep stops short). */\n  const reaches = (these: Walls, at: Vec3) => far(sweep(these, base, at), at) < 3 * COLLIDE_SKIN;\n  if (\n    queries.overlap(fit, ball.at, { groups, exclude, fixed, also }).length > 0 ||\n    far(carried, ball.at) > COLLIDE_TELEPORT ||\n    (also !== undefined && also.length > 0 && !reaches(walls, ball.at) && reaches({ ...walls, also: [] }, ball.at)) // a door shut between them\n  ) {\n    return { at: clear, stuck: 0, trail: [base] };\n  }\n  const trail = remember(ball.trail ?? [], base);\n  /** Whether a ball swept from the base gets to `at` (within the 2 skins a sweep stops short of a face `at` touches). */\n  const sees = (at: Vec3) => reaches(walls, at);\n  /** Where a frame's leg from `from` toward `to` aims: in at up to `COLLIDE_PULL` m/s, out eased. */\n  const aim = (from: Vec3, to: Vec3) => {\n    const gap = far(to, from);\n    const eased = far(to, base) > far(from, base) ? gap * (1 - Math.exp(-dt / COLLIDE_RETURN)) : gap; // out: eased, as paced\n    return lerp(from, to, gap < 1e-9 ? 0 : Math.min(eased, COLLIDE_PULL * dt) / gap);\n  };\n  /**\n   * Whether a ball `SIGHT_ROOM` wider than the camera's gets from the base to within that room of `at`, or meets only a\n   * floor or a ceiling on the way while the camera's own ball still `sees` it (the look tipped up over open floor).\n   */\n  const wide = (at: Vec3) => {\n    const d: Vec3 = [at[0] - base[0], at[1] - base[1], at[2] - base[2]];\n    const gap = Math.hypot(...d);\n    if (gap <= room) return true;\n    const ball = { type: 'ball', radius: COLLIDE_RADIUS + room } as const;\n    const dir: Vec3 = [d[0] / gap, d[1] / gap, d[2] / gap];\n    const hit = queries.shapeCast(ball, base, dir, {\n      maxDistance: gap,\n      margin: COLLIDE_SKIN,\n      groups,\n      exclude,\n      fixed,\n      also,\n    });\n    if (!hit || hit.distance >= gap - room - 2 * COLLIDE_SKIN) return true;\n    return Math.abs(hit.normal.y) > LEVEL_NORMAL && sees(at);\n  };\n  /**\nengine/audio/runtime/spatial.ts:13: * with a time constant of `ease` seconds; behind more walls (WP 13.22: `wallsBetween` counts them, up to `walls`), the\nengine/audio/runtime/spatial.ts:70:  /** How many walls `wallsBetween` counts: past them, as muffled as it gets. */\nengine/audio/runtime/spatial.ts:107:export function muffling(walls: number, open: number = OCCLUSION.open): { cutoff: number; gain: number } {\nengine/audio/runtime/spatial.ts:117:export function wallsBetween(queries: QueryView, from: Vec3, to: Vec3, most: number = OCCLUSION.walls): number {\nengine/audio/runtime/sound.ts:6: * Invariants: a voice's gain is its `vol` (`volume` changes it), times the gain of the walls muffling it\nengine/audio/runtime/sound.ts:7: * (engine/audio/runtime/spatial.ts `muffling`); `stop` fades it to 0 over\nengine/audio/runtime/sound.ts:26:import { muffling, OCCLUSION, PANNER, placePanner, type Vec3 } from './spatial';\nengine/audio/runtime/sound.ts:174:      const { cutoff, gain: through } = muffling(walls, open);\nengine/audio/runtime/sound.ts:187:      gain.gain.setTargetAtTime(vol * muffling(voice.walls, open).gain, c.currentTime, Math.max(ease, 1e-3));\nengine/audio/runtime/audio.ts:51:import { placeListener, wallsBetween, type ListenerPose, type Vec3 } from './spatial';\nengine/audio/runtime/audio.ts:230:    if (voice.position && pose && queries) voice.occlude(wallsBetween(queries, pose.position, voice.position), false);\nengine/audio/runtime/audio.ts:283:        const now = wallsBetween(queries, pose.position, voice.position);\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_256","type":"agent_message","text":"The viewport screenshots exposed a handled physics error after an attract-mode transition that the page-error check missed. I’m tracing it and adding an engine-error check so the tests catch it directly.\n"}}
