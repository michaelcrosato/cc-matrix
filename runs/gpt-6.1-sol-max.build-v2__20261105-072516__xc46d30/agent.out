{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"rg -n 'export interface ActionSpec|defineAction|targets|effector' engine/anim/actions.ts | head -20\nsed -n '60,165p' engine/anim/actions.ts\nsed -n '100,160p' engine/physics/world.ts\ncat engine/gfx/textures/types.ts | head -125\nsed -n '25,100p' .cache/engine-src/labs/playground/views.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"rg -n 'export interface ActionSpec|defineAction|targets|effector' engine/anim/actions.ts | head -20\nsed -n '60,165p' engine/anim/actions.ts\nsed -n '100,160p' engine/physics/world.ts\ncat engine/gfx/textures/types.ts | head -125\nsed -n '25,100p' .cache/engine-src/labs/playground/views.ts\"","aggregated_output":"4: * fields, `defineAction`, `loadActions`) one at a time. A beat `until: 'next'` holds its contact frame (a charge, a\n10: * `post`) solves the effectors; `flipLayer` (slot `physics`, every detail level) turns and squashes the body.\n14: * - Nothing pops: as a beat begins, its channels (`CHANNELS`: motion, effectors, flip, scale) are taken from where\n17: * - Effector targets are `[forward, right, up]` metres times the build's size (actions-data.ts says from where).\n26: * import { defineAction } from './actions-data';\n29: * defineAction('action:bow', { desc: 'A bow.', beats: [bend, { name: 'rise', seconds: 0.3, cancel: { by: ['walk'] } }] });\n67:/** The channels' layout: motion (5), each effector's target and weight (4 × 5), the flip's angle and axis, scale (3). */\n68:export const CHANNELS = { motion: 0, effectors: 5, flip: 25, scale: 27, count: 30 } as const;\n109:  /** 0–1: how much of the effectors shows. */\n247:      const [i, target] = [CHANNELS.effectors + 4 * k, beat?.effectors?.[key]];\n271:  /** The view (slot `post`): the effectors pulled to their targets, each faded by its weight. */\n278:      const i = CHANNELS.effectors + 4 * k;\n  ANIM_ACTION_NO_CLIPS: {\n    template: 'action {action} plays clips ({clips}), but its Actions has no clip layer',\n    fix: \"make it with one: new Actions({ clips }), the ClipLayer in the animator's clips slot, with the sets those clips come from\",\n    doc: 'Thrown by `Actions.play` (engine/anim/actions.ts) for an action with a `clip` beat when the player was made without `clips`: the beat would play nothing, silently.',\n  },\n});\n\n/** The channels' layout: motion (5), each effector's target and weight (4 × 5), the flip's angle and axis, scale (3). */\nexport const CHANNELS = { motion: 0, effectors: 5, flip: 25, scale: 27, count: 30 } as const;\nconst MOTION = ['lean', 'lunge', 'hop', 'crouch', 'twist'] as const;\nconst AXES = Object.keys(FLIP_AXES) as (keyof typeof FLIP_AXES)[];\nconst smooth = (x: number) => MathUtils.smoothstep(x, 0, 1);\nconst TURN = 2 * Math.PI;\n/** An angle wrapped into (−π, π]. */\nconst wrap = (a: number) => a - TURN * Math.ceil((a - Math.PI) / TURN);\n\n/** An `Actions`' state, plain data. */\nexport interface ActionsState {\n  /** The action playing, by id; '' when none. */ playing: string;\n  /** Its beat's index; −1 at rest. */ beat: number;\n  /** Seconds into the beat (at rest: since the last action let go). */ t: number;\n  /** The channels as the beat began (`CHANNELS`). */ from: number[];\n  /** The clip its beats started (`SET/Clip`), '' when none. */ clip: string;\n}\n\n/** What `new Actions` takes. */\nexport interface ActionsOptions {\n  /** Its layer's name (`actions`); `flipLayer`'s is this plus `:flip`. */ name?: string;\n  /** The fixed step, seconds (`SIM_DT`). */ dt?: number;\n  /** The clip layer its clip beats play on (the animator's `clips` slot). */ clips?: ClipLayer;\n  /** Where its actions are defined (the shared registry). */ registry?: Registry;\n}\n\n/** Scratch. */\nconst [va, vb, vc, vs] = [new Vector3(), new Vector3(), new Vector3(), new Vector3()];\nconst [qa, before] = [new Quaternion(), new Pose()];\nconst MASK = { handL: boneMask('armL'), handR: boneMask('armR'), footL: boneMask('legL'), footR: boneMask('legR'), look: boneMask(['chest', 'neck', 'head']) }; // prettier-ignore\n\n/** The lowest point of a posed body, world metres: its joints, the tips of its leaves and its sockets. */\nfunction lowest(skeleton: Skeleton, world: WorldPose): number {\n  let y = Infinity;\n  for (let j = 0; j < JOINT_COUNT; j++) y = Math.min(y, world.positions[j * 3 + 1], tipPosition(skeleton, world, j, va).y); // prettier-ignore\n  for (const s of SOCKETS) y = Math.min(y, socketPosition(skeleton, world, s, va).y);\n  return y;\n}\n\n/** A body's actions, one playing at a time. See the file comment. */\nexport class Actions implements AnimLayer {\n  readonly name: string;\n  /** 0–1: how much of the effectors shows. */\n  weight = 1;\n  readonly dt: number;\n  readonly clips: ClipLayer | undefined;\n  readonly state: ActionsState = { playing: '', beat: -1, t: ACTION.out, from: [], clip: '' };\n  /** The events since the last step began: the calls before it (play, go…) and its own. */\n  readonly events: TimelineEvent[] = [];\n  /** Its partner layer, for the slot `physics`: the flip and the squash. */\n  readonly flipLayer: AnimLayer;\n  readonly #registry: Registry;\n  #action: Action | undefined;\n  /** Whether a call (play, go…) fired events since the last step: the next step keeps them. */\n  #called = false;\n\n  /** Actions at rest: nothing playing. */\n  constructor(options: ActionsOptions = {}) {\n    this.state.from = Array.from({ length: CHANNELS.count }, (_, i) => (i >= CHANNELS.scale ? 1 : 0)); // at rest\n    this.name = options.name ?? 'actions';\n    [this.dt, this.clips, this.#registry] = [options.dt ?? SIM_DT, options.clips, options.registry ?? sharedRegistry];\n    this.flipLayer = { name: `${this.name}:flip`, weight: 1, apply: (animator) => this.#turn(animator) };\n  }\n\n  /** Adds it to `animator`: itself in the slot `post`, `flipLayer` in the slot `physics`. */\n  attach(animator: Animator): this {\n    animator.use('post', this).use('physics', this.flipLayer);\n    return this;\n  }\n\n  /** The beat playing, if any. */\n  get beat(): string | undefined {\n    return this.#beat()?.name;\n  }\n\n  /** Progress through the beat's seconds, 0–1 (1 past them, or at rest). */\n  get u(): number {\n    const beat = this.#beat();\n    return beat && beat.seconds > 0 ? Math.min(1, this.state.t / beat.seconds) : 1;\n  }\n\n  /** What the beat tells the humanoid: lay it over the animator's input. Nothing at rest. */\n  get body(): AnimatorInput {\n    const [beat, ch] = [this.#beat(), this.channels()];\n    if (!beat) return {};\n    const out: AnimatorInput = { ...((beat.body ?? {}) as AnimatorInput) };\n    const [u0, u1] = beat.move?.u ?? [0, 1];\n    if (beat.move) out.body = { move: beat.move.id, phase: beat.move.phase, u: MathUtils.lerp(u0, u1, this.u) };\n    else if (MOTION.some((_, i) => Math.abs(ch[i]) > 1e-9)) out.body = Object.fromEntries(MOTION.map((k, i) => [k, ch[i]])); // prettier-ignore\n    return out;\n  }\n\n  /**\n   * Plays the action `id` (`action:jump`, or `jump`) from its first beat, over whatever played; and its `pair` on\n   * `partner` (a grab's victim), which then steps in lockstep with it (tell both `next()` and `go()`).\n   */\n  play(id: string | Action, partner?: Actions): this {\n    const action = typeof id === 'string' ? getAction(id, this.#registry) : id;\n    if (partner && action.pair) partner.play(getAction(action.pair, this.#registry));\n  /** kg/m³ (1,000). */\n  density?: number;\n  /** Coulomb friction (0.5). */\n  friction?: number;\n  /** Bounciness, 0 to 1 (0). */\n  restitution?: number;\n  /** Its collision group (the body's by default). */\n  group?: GroupName;\n  /** A sensor detects overlaps and blocks nothing. */\n  sensor?: boolean;\n}\n\n/** A body as `addBody` takes it. */\nexport interface BodySpec {\n  /** `'dynamic'` (the default), `'fixed'` or `'kinematic'` (moved by the velocity code gives it). */\n  type?: BodyType;\n  position?: Vec3Like;\n  rotation?: QuatLike;\n  /** Linear velocity (m/s). */\n  velocity?: Vec3Like;\n  /** Angular velocity (rad/s). */\n  angularVelocity?: Vec3Like;\n  /** Its colliders, at least one for a body that should touch anything. */\n  colliders?: readonly ColliderSpec[];\n  /** Its colliders' group: `prop` for a dynamic body, `world` for the others, by default. */\n  group?: GroupName;\n  linearDamping?: number;\n  angularDamping?: number;\n  /** Continuous collision detection, for fast small bodies. */\n  ccd?: boolean;\n  /** Whether it may fall asleep when it rests (true). */\n  canSleep?: boolean;\n  /** How much of the world's gravity it feels (1). */\n  gravityScale?: number;\n  /** Solver passes beyond the pinned ones for its island (0): a ragdoll's joints hold better (engine/physics/ragdoll.ts). */\n  solverIterations?: number;\n}\n\n/** A body's state, copied: changing it changes nothing. */\nexport interface BodyState {\n  id: number;\n  type: BodyType;\n  position: Vector3;\n  rotation: Quaternion;\n  velocity: Vector3;\n  angularVelocity: Vector3;\n  sleeping: boolean;\n  /** kg. */\n  mass: number;\n}\n\n/** The changes `setBody` makes; each wakes the body. */\nexport interface BodyChange {\n  position?: Vec3Like;\n  rotation?: QuatLike;\n  velocity?: Vec3Like;\n  angularVelocity?: Vec3Like;\n}\n\n/** What `step` reads from the sim: the step length and the settings (`physics.gravity`). */\nexport interface PhysicsStepper {\n/**\n * @file What a texture generator is (PLAN.md WP 2.3, §6.7, I-20): a seeded, periodic function that writes four\n * values per texel, its colour (albedo), its height (relief, from which the bake derives the normal map), its\n * roughness and its emissive colour, so one generator gives every map a material needs. `textureSpec` types a\n * generator from its parameter schema, so `create` reads its parameters typed and filled with their defaults.\n *\n * A generator is `create(context) => (x, y, texel) => void`: `create` runs once per bake with the parameters, the\n * seed and the size (precompute palettes and noises there), and the function it returns writes texel (x, y) of the\n * texture. Texel coordinates: x right (u), y up (v), (0, 0) at the bottom left. The bake resets the texel before\n * each call to height 1, roughness 1 and no emission, so a generator writes only what it makes; it always writes the\n * colour.\n *\n * Invariants: the function is pure (engine/gfx/textures/tile.ts has the seeded hashes and noises), and periodic: it\n * gives the same texel at (x + width, y) and (x, y + height) for any integers, so the texture tiles. Colours are\n * sRGB bytes 0–255 (fractions allowed; the bake rounds), height and roughness are 0–1.\n *\n * @example\n * const flat = textureSpec({\n *   description: 'One colour.',\n *   params: { color: { type: 'string', default: '#808080', description: 'The colour.' } },\n *   create: () => (x, y, texel) => void texel.color.fill(128),\n * });\n * flat.description; // 'One colour.'\n * @see engine/gfx/textures/texture.ts\n */\nimport type { Rgb } from '../../core/color';\nimport type { EntryOf, Schema } from '../../core/schema';\n\n/** One texel as a generator writes it. */\nexport interface Texel {\n  /** The albedo, as sRGB bytes 0–255. */\n  color: Rgb;\n  /** The relief, 0 (deepest: mortar, gaps) to 1 (highest); 1 unless written. */\n  height: number;\n  /** The microfacet roughness, 0 (mirror) to 1 (matte); 1 unless written. */\n  roughness: number;\n  /** The emitted colour, as sRGB bytes; black unless written. */\n  emissive: Rgb;\n}\n\n/** What `create` is given: the parameters (defaults filled), the seed, and the size the texture bakes at. */\nexport interface TextureContext<P = Record<string, unknown>> {\n  params: P;\n  seed: number;\n  width: number;\n  height: number;\n}\n\n/** Writes texel (x, y). */\nexport type TexelFn = (x: number, y: number, texel: Texel) => void;\n\n/** How a texture is magnified, crispest first: `pixel` keeps texels crisp (nearest), `smooth` blends them (linear). */\nexport const TEXTURE_LOOKS = ['pixel', 'smooth'] as const;\n\n/** How a texture is magnified: `pixel` keeps texels crisp (nearest), `smooth` blends them (linear). */\nexport type TextureLook = (typeof TEXTURE_LOOKS)[number];\n\n/** A generator: its parameters, the size and look it bakes at, and the function that writes its texels. */\nexport interface TextureSpec<S extends Schema = Schema> {\n  /** What it draws, in plain sentences. */\n  description: string;\n  /** Its parameters, as schema fields (engine/core/schema.ts), each with its default. */\n  params?: S;\n  /** The size it bakes at by default, [width, height] in texels: one period of the pattern. */\n  size?: [number, number];\n  /** The smallest size the pattern repeats at, given the parameters; a bake size must be a multiple of it. */\n  tile?: (params: EntryOf<S>) => [number, number];\n  /** Texels per metre, on geometry whose UVs are in metres (WP 2.4's builders); 16 by default. */\n  density?: number;\n  /** How it is magnified; `pixel` by default. */\n  look?: TextureLook;\n  /** The generator: called once per bake, it returns the function that writes each texel. */\n  create: (context: TextureContext<EntryOf<S>>) => TexelFn;\n}\n\n/** Returns `spec` unchanged, typed: `create` sees the parameters as the schema `params` declares them. */\nexport function textureSpec<const S extends Schema>(spec: TextureSpec<S>): TextureSpec<S> {\n  return spec;\n}\n\n/** A camera mode: its name, the camera code that opens it, and what it is for. */\nexport interface CameraMode {\n  readonly name: string;\n  readonly code: string;\n  readonly label: string;\n}\n\n/** The five camera modes, in the order T steps through them; the shooter is the page's default. */\nexport const PLAYGROUND_CAMERAS: readonly CameraMode[] = [\n  { name: 'shooter', code: 'cam3=shoulder', label: 'Third-person shooter: over the shoulder (X swaps it)' },\n  { name: 'first', code: 'cam3=first', label: 'First person: through the eyes' },\n  { name: 'platformer', code: 'cam3=follow', label: 'Third-person platformer: orbit and follow' },\n  { name: 'isometric', code: 'cam=iso', label: 'Isometric: orthographic, 45° round and 30° down' },\n  { name: 'top-down', code: 'cam=overhead', label: 'Top-down \"2D\": straight down, north up, whole-number zooms' },\n];\n\n/**\n * The three looks, in the order P steps through them; the clean look is the page's default (the owner's direction of\n * 2026-11-03, ADR-0025 amendment 46), the cel and pixel looks the styled ones (WP 13.24).\n */\nexport const PLAYGROUND_LOOKS: readonly string[] = [\n  'look:playground-clean',\n  'look:playground-cel',\n  'look:playground-pixel',\n];\n\n/** The key that switches the looks: P, which no action map binds. */\nexport const LOOK_KEY = 'KeyP';\n\n/** The camera mode a code opens, by its type and view (`cam3=chase` of `cam3=chase,0,-20.63,5.5`); else undefined. */\nexport function cameraMode(code: string): CameraMode | undefined {\n  const head = code.split(',')[0];\n  return PLAYGROUND_CAMERAS.find((mode) => mode.code === head);\n}\n\n/** The code of the camera mode after the one `code` opens (the first after an unknown code). */\nexport function nextCamera(code: string): string {\n  const at = PLAYGROUND_CAMERAS.findIndex((mode) => mode === cameraMode(code));\n  return PLAYGROUND_CAMERAS[(at + 1) % PLAYGROUND_CAMERAS.length].code;\n}\n\n/** The shooter camera's code `code` over the other shoulder (`cam3=shoulder,<yaw>,<pitch>,<distance>[,-1]`); another code as it is. */\nexport function swapShoulder(code: string): string {\n  const parts = code.split(',');\n  if (parts[0] !== 'cam3=shoulder' || parts.length < 4) return code;\n  return parts.length === 5 ? parts.slice(0, 4).join(',') : `${code},-1`;\n}\n\n/** A classic view's code `code` turned round its target by `steps` × 90° (`cam=iso,<turn>,<zoom>`); another code as it is. */ // prettier-ignore\nexport function turnView(code: string, steps: number): string {\n  const [head, turn = '0', zoom = '1', ...target] = code.split(',');\n  if (!head.startsWith('cam=') || !/^cam=[a-z]+$/.test(head)) return code;\n  const turned = (((Number(turn) + steps * 90) % 360) + 360) % 360;\n  return [head, String(turned), zoom, ...target].join(',');\n}\n\n/** The look after `id` (the first after an unknown id). */\nexport function nextLook(id: string): string {\n  return PLAYGROUND_LOOKS[(PLAYGROUND_LOOKS.indexOf(id) + 1) % PLAYGROUND_LOOKS.length];\n}\n","exit_code":0,"status":"completed"}}
