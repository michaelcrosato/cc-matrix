{"type":"item.completed","item":{"id":"item_223","type":"command_execution","command":"/bin/bash -lc \"rg -n 'export function entityOfBody' -A26 engine/sim/props.ts\nsed -n '33,53p' engine/physics/groups.ts\nsed -n '227,254p' labs/game/scenes/story.ts\nhead -18 out/check.log\"","aggregated_output":"180:export function entityOfBody<C extends object, E extends EventMap>(world: World<C, E>, body: number): number {\n181-  const prop = propOfBody(world, body);\n182-  if (prop >= 0 || body < 0) return prop;\n183-  const actors = (world as unknown as World).query('actor') as unknown as { id: number; actor: { body: number } }[];\n184-  return actors.find((e) => e.actor.body === body)?.id ?? -1;\n185-}\n186-\n187-/** Removes a prop: its entity and its body, its component's `body` −1 at once (inside a step the entity stays to its end). Throws `SIM_BAD_ARGUMENT` for an id that is no prop. */ // prettier-ignore\n188-export function removeProp<C extends object, E extends EventMap>(world: World<C, E>, id: number): void {\n189-  const w = world as unknown as World;\n190-  const data = propOf(w, id, 'removeProp(w, id)');\n191-  if (data.body >= 0) physicsOf(w).removeBody(data.body);\n192-  data.body = -1; // inside a step its entity stays to the step's end: nothing reads the body it no longer has\n193-  w.despawn(id);\n194-}\n195-\n196-/**\n197- * Hits the prop `id` from `from` (m): calls its `hit` hook, whose `knock(more)` knocks its body away from `from` with\n198- * `strength` under `more` (engine/physics/bodies.ts's `knock`: 4.6875 m/s across, 2.5 m/s up, no twist by default).\n199- * Draw `spin` from a sim stream (`w.rng('knock').range(-0.5, 0.5)`). Throws `SIM_BAD_ARGUMENT` for an id that is no prop.\n200- */\n201-export function hitProp<C extends object, E extends EventMap>(\n202-  world: World<C, E>,\n203-  id: number,\n204-  from: readonly [number, number, number],\n205-  strength: PropKnock = {},\n206-): void {\nexport const GROUP_CODES = defineCodes('physics', {\n  PHYSICS_UNKNOWN_GROUP: {\n    template: 'there is no collision group {group}{suggestion}',\n    fix: 'name one of the groups in engine/physics/groups.ts: world, prop, actor, crowd, flyer, corpse',\n  },\n});\n\n/** The collision groups: each one's membership bit and the groups it touches. */\nexport const COLLISION_GROUPS = Object.freeze({\n  world: { bit: 1, touches: ['world', 'prop', 'actor', 'crowd', 'flyer', 'corpse'] },\n  prop: { bit: 2, touches: ['world', 'prop', 'actor', 'crowd', 'corpse'] },\n  actor: { bit: 4, touches: ['world', 'prop', 'crowd'] },\n  crowd: { bit: 8, touches: ['world', 'prop', 'actor', 'crowd'] },\n  flyer: { bit: 16, touches: ['world', 'flyer'] },\n  corpse: { bit: 32, touches: ['world', 'prop'] },\n} as const);\n\n/** A collision group's name. */\nexport type GroupName = keyof typeof COLLISION_GROUPS;\n\n/** The group names, in table order. */\n      c.flags[`altDone-${c.contract}`] = 1;\n    if (alt.kind === 'delivery' && (c.flags.deliveries ?? 0) >= (alt.count ?? 4)) c.flags[`altDone-${c.contract}`] = 1;\n    if (alt.kind === 'use' && c.flags[`use:${alt.key}`]) c.flags[`altDone-${c.contract}`] = 1;\n  }\n\n  if (c.contract === 0 && c.step === 1 && !c.flags.firstWound) {\n    for (const p of players(w)) p.health.hp = 45;\n    c.flags.firstWound = 1;\n    say(w, 'Field note', 'Sand in the chamber. Hold reload. The wound can wait a moment.');\n  }\n  if (c.contract === 0 && c.step === 3 && !c.flags.firstFever) {\n    c.flags.firstFever = w.tick;\n    for (const p of players(w)) {\n      p.seat!.data.fever = w.tick;\n      p.seat!.data.feverNext = w.tick;\n    }\n    mark(w, 'fever attack');\n    say(w, 'Field note', 'The river goes cold. The air has not changed.');\n  }\n  if (c.contract === 0 && c.step === 3 && w.tick - c.flags.firstFever > 300 && !c.flags.prologueRescue)\n    for (const p of players(w)) if (!p.seat!.data.down) p.health.hp = 0;\n  if (c.contract === 0 && c.step === 5)\n    for (const p of players(w)) if (!p.seat!.data.fever && !c.coverage.pill) p.seat!.data.fever = w.tick || 1;\n  if (c.contract === 2 && c.step === 1 && !c.flags.bitterFire) {\n    c.flags.bitterFire = 1;\n    w.emit('mission-fire', { x: 540, z: 1080 });\n  }\n  if (c.contract === 4 && c.step === 2 && !c.flags.estateWind) {\n\n> bar-cry@0.0.0 check\n> node tools/checkAll.ts\n\nok   tsc (5.7 s)\nnpm warn install-scripts .npmrc allow-scripts setting is being ignored because --allow-scripts was passed on the command line\nok   eslint (3.6 s)\nnpm warn install-scripts .npmrc allow-scripts setting is being ignored because --allow-scripts was passed on the command line\n\n/home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261105-072516__xc46d30/work/Bar-Cry-Far-Cry-2-gpt-6.1-sol-max-20261105-072516/labs/game/main.ts\n  401:1  warning  File has too many lines (413). Maximum allowed is 400  max-lines\n\n✖ 1 problem (0 errors, 1 warning)\nok   prettier (3.8 s)\nnpm warn install-scripts .npmrc allow-scripts setting is being ignored because --allow-scripts was passed on the command line\nChecking formatting...\nAll matched files use Prettier code style!\nok   x check (1.7 s)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_224","type":"agent_message","text":"The packaged browser suite now passes **80 checks**, including WebKit notice/settings, controller navigation, audio, the live map, surgery, and idle mode. I’m finishing save consistency and transport edge cases before running the multiplayer harness.\n"}}
{"type":"item.started","item":{"id":"item_225","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/scenes/cargo.ts <<'EOF'\n/** @file Quinine crates attach to a pickup or boat, can be retrieved, and unload at the clinic when stopped. */\nimport {Vector3,Quaternion,removeProp} from '../../../engine/sim-api';\nimport {campaign,mark,say,type GW} from './state';\nimport {ground} from './map';\nexport function cargoStep(w:GW):void{\n  const c=campaign(w),groups=new Map<number,number>();\n  for(const e of w.query('usable','sceneProp')){\n    const u=e.usable.data;if(u.kind\"'!=='\"'crate'||u.done||\"'!u.extra.startsWith('\"'vehicle:'))continue;\n    const id=Number(u.extra.slice(8)),r=w.get(id);\n    if(\"'!r?.ride||!r.sceneProp||r.ride.data.hp<=0){u.extra='\"'';u.y=ground(u.x,u.z)+0.6;e.sceneProp.y=u.y-0.6;continue;}\n    const n=groups.get(id)??0;groups.set(id,n+1);const p=r.sceneProp,q=new Quaternion(...p.q),at=new Vector3(n%2?0.38:-0.38,1.15,-0.9-Math.floor(n/2)*0.65).applyQuaternion(q).add(new Vector3(p.x,p.y,p.z));\n    Object.assign(e.sceneProp,{x:at.x,y:at.y,z:at.z,q:[...p.q]});Object.assign(u,{x:at.x,y:at.y+0.6,z:at.z});\n    if(Math.hypot(p.x-330,p.z-1147)<18&&r.ride.data.speed<2){u.done=true;u.extra='';c.flags.deliveries=(c.flags.deliveries??0)+1;removeProp(w,e.id);c.save++;mark(w,'cargo delivery');say(w,'Perpetua',\"'`${c.flags.deliveries} crates in the shade. Keep the engine clear of the door.`);}\n  }\n}\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('labs/game/scenes/use.ts');s=p.read_text().replace(\\\"    if (\"'!s.carrying) {'\"\\\\n      s.carrying = u.key;\\\", \\\"    if (\"'!s.carrying) {'\"\\\\n      u.extra='';s.carrying = u.key;\\\")\ns=s.replace(\\\"if (d < 3 && d < best + 0.5 && e.ride.data.hp > 0)\\\", \\\"if (d < 3 && (target<0||d < best-0.7) && e.ride.data.hp > 0)\\\")\ns=s.replace(\\\"      if (press) {\\\\n        if (crate) {\\\", \\\"      if(press&&target>=0&&w.get(target)?.ride&&crate){crate.usable.data.extra=\"'`vehicle:${target}`;s.carrying='\"'';enterVehicle(w,p,target);mark(w,'cargo loaded');continue;}\\\\n      if (press) {\\\\n        if (crate) {\\\")\np.write_text(s)\np=Path('labs/game/scenes/world.ts');s=p.read_text().replace(\\\"import { useStep }\\\", \\\"import {cargoStep} from './cargo';\\\\nimport { useStep }\\\")\ns=s.replace(\\\"  w.systems.add('game.wind'\\\", \\\"  w.systems.add('game.cargo',cargoStep,{phase:'rules'});\\\\n  w.systems.add('game.wind'\\\")\np.write_text(s)\np=Path('labs/game/scenes/settings.ts');s=p.read_text().replace(\\\"['fire.regrow', 'Regrow game minutes', 18, 1, 60, 'Fire']\\\", \\\"['fire.regrow', 'Regrow game minutes', 180, 1, 720, 'Fire']\\\")\np.write_text(s)\np=Path('labs/game/scenes/world.test.ts');s=p.read_text().replace(\\\"const e = await make(9);\\\", \\\"const e = await make(9,{'game.fire.regrow':18});\\\")\np.write_text(s)\np=Path('labs/game/scenes/ai.ts');s=p.read_text().replace(\\\"      target.weapons.slot < 0 &&\\\", \\\"      target.weapons.slot < 0 &&s.vehicle<0 &&\\\")\np.write_text(s)\np=Path('labs/game/scenes/arms.ts');s=p.read_text().replace(\\\"      if (k === W.slot && W.reload >= 0)\\\", \\\"      if(k===W.slot&&gs.jam&&gs.clear>0)pose=Math.min(3,1+Math.floor(gs.clear/18));\\\\n      if (k === W.slot && W.reload >= 0)\\\")\ns=s.replace(\\\"groups: ['world', 'prop', 'actor', 'crowd', 'flyer']\\\", \\\"groups: ['world', 'prop', 'actor', 'crowd', 'flyer','corpse']\\\")\ns=s.replace(\\\"  const target = hit ? entityOfBody(w, hit.body) : -1;\\\", \\\"  let target = hit ? entityOfBody(w, hit.body) : -1;\\\\n  if(hit&&target<0){const rag=[...w.query('ragdoll' as never)].find(e=>(e as unknown as {ragdoll:{bodies:number[]}}).ragdoll.bodies.includes(hit.body));if(rag)target=rag.id;}\\\")\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_225","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/scenes/cargo.ts <<'EOF'\n/** @file Quinine crates attach to a pickup or boat, can be retrieved, and unload at the clinic when stopped. */\nimport {Vector3,Quaternion,removeProp} from '../../../engine/sim-api';\nimport {campaign,mark,say,type GW} from './state';\nimport {ground} from './map';\nexport function cargoStep(w:GW):void{\n  const c=campaign(w),groups=new Map<number,number>();\n  for(const e of w.query('usable','sceneProp')){\n    const u=e.usable.data;if(u.kind\"'!=='\"'crate'||u.done||\"'!u.extra.startsWith('\"'vehicle:'))continue;\n    const id=Number(u.extra.slice(8)),r=w.get(id);\n    if(\"'!r?.ride||!r.sceneProp||r.ride.data.hp<=0){u.extra='\"'';u.y=ground(u.x,u.z)+0.6;e.sceneProp.y=u.y-0.6;continue;}\n    const n=groups.get(id)??0;groups.set(id,n+1);const p=r.sceneProp,q=new Quaternion(...p.q),at=new Vector3(n%2?0.38:-0.38,1.15,-0.9-Math.floor(n/2)*0.65).applyQuaternion(q).add(new Vector3(p.x,p.y,p.z));\n    Object.assign(e.sceneProp,{x:at.x,y:at.y,z:at.z,q:[...p.q]});Object.assign(u,{x:at.x,y:at.y+0.6,z:at.z});\n    if(Math.hypot(p.x-330,p.z-1147)<18&&r.ride.data.speed<2){u.done=true;u.extra='';c.flags.deliveries=(c.flags.deliveries??0)+1;removeProp(w,e.id);c.save++;mark(w,'cargo delivery');say(w,'Perpetua',\"'`${c.flags.deliveries} crates in the shade. Keep the engine clear of the door.`);}\n  }\n}\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('labs/game/scenes/use.ts');s=p.read_text().replace(\\\"    if (\"'!s.carrying) {'\"\\\\n      s.carrying = u.key;\\\", \\\"    if (\"'!s.carrying) {'\"\\\\n      u.extra='';s.carrying = u.key;\\\")\ns=s.replace(\\\"if (d < 3 && d < best + 0.5 && e.ride.data.hp > 0)\\\", \\\"if (d < 3 && (target<0||d < best-0.7) && e.ride.data.hp > 0)\\\")\ns=s.replace(\\\"      if (press) {\\\\n        if (crate) {\\\", \\\"      if(press&&target>=0&&w.get(target)?.ride&&crate){crate.usable.data.extra=\"'`vehicle:${target}`;s.carrying='\"'';enterVehicle(w,p,target);mark(w,'cargo loaded');continue;}\\\\n      if (press) {\\\\n        if (crate) {\\\")\np.write_text(s)\np=Path('labs/game/scenes/world.ts');s=p.read_text().replace(\\\"import { useStep }\\\", \\\"import {cargoStep} from './cargo';\\\\nimport { useStep }\\\")\ns=s.replace(\\\"  w.systems.add('game.wind'\\\", \\\"  w.systems.add('game.cargo',cargoStep,{phase:'rules'});\\\\n  w.systems.add('game.wind'\\\")\np.write_text(s)\np=Path('labs/game/scenes/settings.ts');s=p.read_text().replace(\\\"['fire.regrow', 'Regrow game minutes', 18, 1, 60, 'Fire']\\\", \\\"['fire.regrow', 'Regrow game minutes', 180, 1, 720, 'Fire']\\\")\np.write_text(s)\np=Path('labs/game/scenes/world.test.ts');s=p.read_text().replace(\\\"const e = await make(9);\\\", \\\"const e = await make(9,{'game.fire.regrow':18});\\\")\np.write_text(s)\np=Path('labs/game/scenes/ai.ts');s=p.read_text().replace(\\\"      target.weapons.slot < 0 &&\\\", \\\"      target.weapons.slot < 0 &&s.vehicle<0 &&\\\")\np.write_text(s)\np=Path('labs/game/scenes/arms.ts');s=p.read_text().replace(\\\"      if (k === W.slot && W.reload >= 0)\\\", \\\"      if(k===W.slot&&gs.jam&&gs.clear>0)pose=Math.min(3,1+Math.floor(gs.clear/18));\\\\n      if (k === W.slot && W.reload >= 0)\\\")\ns=s.replace(\\\"groups: ['world', 'prop', 'actor', 'crowd', 'flyer']\\\", \\\"groups: ['world', 'prop', 'actor', 'crowd', 'flyer','corpse']\\\")\ns=s.replace(\\\"  const target = hit ? entityOfBody(w, hit.body) : -1;\\\", \\\"  let target = hit ? entityOfBody(w, hit.body) : -1;\\\\n  if(hit&&target<0){const rag=[...w.query('ragdoll' as never)].find(e=>(e as unknown as {ragdoll:{bodies:number[]}}).ragdoll.bodies.includes(hit.body));if(rag)target=rag.id;}\\\")\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_226","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/scenes/save.ts <<'EOF'\n/** @file Compact, versioned game saves. Engine captures are reserved for replay verification. */\nimport {placeActor,setDaytime,spawnProp,removeProp,physicsOf,handOff} from '../../../engine/sim-api';\nimport {campaign,players,mark,type GW,type Campaign,type Seat,type Gun} from './state';\nimport {ground} from './map';\nimport {ignite} from './fire';\ninterface SavedRide {at:[number,number,number];q:[number,number,number,number];hp:number;fuse:number;}\ninterface SavedSupply {key:string;x:number;y:number;z:number;done:boolean;vehicle:number;}\nexport interface Save {\n  version:number;seed:number;tick:number;campaign:Partial<Campaign>;\n  seat:{data:Seat;guns:Gun[];x:number;z:number;hp:number;mags:number[];ride:number;slot:number;last:number}[];\n  rides:SavedRide[];supplies:SavedSupply[];friends:{key:string;x:number;z:number;hp:number}[];burns:string;\n}\nexport function makeSave(w:GW):Save {\n  const c=campaign(w),rides=[...w.query('ride','sceneProp')];\n  const {fire:_fire,fuel:_fuel,timers:_timers,regrow:_regrow,grass:_grass,flames:_flames,...rest}=c;\n  let last=-1,count=0;const rle:string[]=[];\n  for(const v of c.fire){if(v===last)count++;else{if(count)rle.push(\"'`${last}:${count}`);last=v;count=1;}}rle.push(`${last}:${count}`);\n  const data:Save={version:1,seed:w.seed,tick:w.tick,campaign:rest,\n    seat:players(w).map(p=>({data:{...p.seat!.data,wants:{},previous:[],released:[],vehicle:-1,target:-1,carrying:'\"'',action:'',actionProp:-1,down:0,rescue:-1,mirage:0,fever:p.health.hp<=0?0:p.seat\"'!.data.fever},\n      guns:p.gunState.data.guns,x:p.actor.x,z:p.actor.z,hp:Math.max(40,p.health.hp),mags:p.weapons.mags,ride:rides.findIndex(r=>r.id===p.seat!.data.vehicle),slot:p.weapons.slot,last:p.weapons.last})),\n    rides:rides.map(e=>{const r=e.ride.data,p=physicsOf(w).readBody(r.body);return {at:[p.position.x,p.position.y,p.position.z],q:[p.rotation.x,p.rotation.y,p.rotation.z,p.rotation.w],hp:r.hp,fuse:r.burning>0?Math.max(1,r.burning-w.tick):0};}),\n    supplies:[...w.query('\"'usable','sceneProp')].filter(e=>e.usable.data.kind==='crate').map(e=>({key:e.usable.data.key,x:e.sceneProp.x,y:e.sceneProp.y,z:e.sceneProp.z,done:e.usable.data.done,vehicle:e.usable.data.extra.startsWith('vehicle:')?rides.findIndex(r=>r.id===Number(e.usable.data.extra.slice(8))):-1})),\n    friends:c.buddies.map(b=>{const e=w.get(b.entity);return {key:b.key,x:e?.actor?.x??760,z:e?.actor?.z??826,hp:e?.health?.hp??0};}),burns:rle.join(',')};\n  return JSON.parse(JSON.stringify(data)) as Save;\n}\nexport function loadSave(w:GW,raw:unknown):void {\n  const data=raw as Save;if(data.version\"'!==1||!data.seat?.length||!data.campaign)return;\n  const c=campaign(w),buddies=c.buddies,oldTick=data.tick??0,rides=[...w.query('\"'ride','sceneProp')];\n  Object.assign(c,data.campaign);c.mode='story';delete c.flags.gameover;c.flags.auctionAftermath=0;\n  c.windNext=w.tick+Math.max(1,c.windNext-oldTick);if(c.flags.noise)c.flags.noise=w.tick-(oldTick-c.flags.noise);\n  if(c.flags.firstFever)c.flags.firstFever=w.tick-(oldTick-c.flags.firstFever)||1;\n  for(const key of Object.keys(c.cleared))c.cleared[key]=w.tick-(oldTick-c.cleared[key]);\n  for(const b of c.buddies){\n    b.entity=buddies.find(x=>x.key===b.key)?.entity??-1;const saved=data.friends?.find(x=>x.key===b.key),e=w.get(b.entity);\n    if(saved&&e?.actor)placeActor(w,b.entity,[saved.x,ground(saved.x,saved.z),saved.z]);\n    if(e?.health)e.health.hp=b.alive?(saved?.hp??100):0;\n    if(b.fallen>0)b.fallen=w.tick+Math.max(1,b.fallen-oldTick);\n    if((\"'!b.alive||b.fallen>0)&&e?.animator)handOff(w,b.entity,{dead:true});\n    if(!b.alive&&e?.usable)e.usable.data.done=true;\n  }\n  for(let n=0;n<(data.rides?.length??0);n++){\n    const e=rides[n],saved=data.rides[n];if(!e)continue;\n    physicsOf(w).setBody(e.ride.data.body,{position:saved.at,rotation:saved.q,velocity:[0,0,0],angularVelocity:[0,0,0]});\n    if(e.ride.data.blocker>=0)physicsOf(w).setBody(e.ride.data.blocker,{position:saved.at,rotation:saved.q});\n    e.ride.data.hp=saved.hp;e.ride.data.driver=-1;e.ride.data.burning=saved.hp<=0?-1:saved.fuse>0?w.tick+saved.fuse:0;\n    Object.assign(e.sceneProp,{x:saved.at[0],y:saved.at[1]-(e.ride.data.kind==='\"'boat'?0.3:0.8),z:saved.at[2],q:[...saved.q]});\n  }\n  for(const saved of data.supplies??[]){\n    const e=[...w.query('usable','sceneProp')].find(e=>e.usable.data.key===saved.key);if(\"'!e)continue;\n    if(saved.done){e.usable.data.done=true;removeProp(w,e.id);continue;}\n    Object.assign(e.usable.data,{x:saved.x,y:saved.y+0.6,z:saved.z,extra:saved.vehicle>=0&&rides[saved.vehicle]?`vehicle:${rides[saved.vehicle].id}`:'\"''});\n    Object.assign(e.sceneProp,{x:saved.x,y:saved.y,z:saved.z});\n  }\n  let i=0;for(const token of data.burns.split(',')){\n    const [v,n]=token.split(':').map(Number);for(let k=0;k<n&&i<c.fire.length;k++,i++){\n      if(v===2){const x=(i%192+0.5)*8,z=(Math.floor(i/192)+0.5)*8;ignite(w,x,z);}\n      else {c.fire[i]=v;if(v===3){const x=(i%192+0.5)*8,z=(Math.floor(i/192)+0.5)*8;spawnProp(w,{prop:'prop:field-scorch',at:[x,ground(x,z)+0.025,z],yaw:0});c.regrow[i]=w.tick+10800;if(c.grass[i]>=0){removeProp(w,c.grass[i]);c.grass[i]=-1;}}}\n    }\n  }\n  for(const saved of data.seat){\n    const p=players(w).find(x=>x.seat\"'!.data.n===saved.data.n);if(!p)continue;\n    p.seat!.data={...saved.data,wants:{},previous:[],released:[],actionProp:-1,feverNext:w.tick+Math.max(1,saved.data.feverNext-oldTick)};\n    if(p.seat.data.fever)p.seat.data.fever=w.tick-(oldTick-p.seat.data.fever)||1;\n    p.gunState.data.guns=saved.guns;p.health.hp=saved.hp;p.weapons.mags=saved.mags;p.weapons.slot=saved.slot??1;p.weapons.last=saved.last??1;\n    const r=(saved.ride??-1)>=0?data.rides[saved.ride]:null;let x=saved.x,z=saved.z;\n    if(r){const yaw=Math.atan2(2*(r.q[3]*r.q[1]+r.q[0]*r.q[2]),1-2*(r.q[1]*r.q[1]+r.q[2]*r.q[2]));x=r.at[0]+Math.cos(yaw)*2.4;z=r.at[2]-Math.sin(yaw)*2.4;}\n    placeActor(w,p.id,[x,Math.max(ground(x,z),0.12),z]);\n  }\n  setDaytime(w,{hour:c.hour,rate:24/(w.settings.get<number>('\"'game.day.minutes')*60)});mark(w,'load');\n}\nexport function digest(w:GW):string {\n  const c=campaign(w),round=(v:number)=>Math.round(v*1000);\n  return JSON.stringify({tick:w.tick,contract:c.contract,step:c.step,flags:c.flags,wind:round(c.wind),\n    seats:players(w).map(p=>[p.seat\"'!.data.n,round(p.actor.x),round(p.actor.z),round(p.health.hp),p.weapons.shots,p.gunState.data.guns.map(g=>[round(g.condition),g.jam])]),\n    cars:[...w.query('\"'ride','sceneProp')].map(e=>[round(e.sceneProp.x),round(e.sceneProp.z),round(e.ride.data.hp)]),\n    burns:c.fire.reduce((a,v,i)=>(a[v]=(a[v]??0)+i+1,a),[] as number[])});\n}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/main.ts');s=p.read_text().replace(\\\"    if (reuse) e.actions.run('mode', { mode });\\\\n    else e.seed(ctx.seed);\\\", \\\"    const saved=load?store.get<import('./scenes/save').Save|null>('save',null):null;\\\\n    if (reuse) e.actions.run('mode', { mode });\\\\n    else e.seed(saved?.seed??ctx.seed);\\\")\np.write_text(s)\np=Path('labs/game/scenes/state.ts');s=p.read_text().replace(\\\"['campaign', 'seat', 'soldier', 'ride', 'usable', 'gunState']\\\", \\\"['campaign', 'seat', 'soldier', 'ride', 'usable', 'gunState','gameSave']\\\")\ns=s.replace(\\\"  campaign: { data: Campaign };\\\", \\\"  campaign: { data: Campaign };\\\\n  gameSave:{data:Record<string,unknown>};\\\")\np.write_text(s)\np=Path('labs/game/scenes/world.ts');s=p.read_text().replace(\\\"import { loadSave }\\\", \\\"import { loadSave,makeSave }\\\")\ns=s.replace(\\\"  actions: {\\\\n\\\", \\\"  actions: {\\\\n    snapshot(w:GW){const data=makeSave(w),e=w.query('gameSave')[0];if(e)e.gameSave.data=data as unknown as Record<string,unknown>;else w.spawn({gameSave:{data:data as unknown as Record<string,unknown>}});},\\\\n\\\")\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_226","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/scenes/save.ts <<'EOF'\n/** @file Compact, versioned game saves. Engine captures are reserved for replay verification. */\nimport {placeActor,setDaytime,spawnProp,removeProp,physicsOf,handOff} from '../../../engine/sim-api';\nimport {campaign,players,mark,type GW,type Campaign,type Seat,type Gun} from './state';\nimport {ground} from './map';\nimport {ignite} from './fire';\ninterface SavedRide {at:[number,number,number];q:[number,number,number,number];hp:number;fuse:number;}\ninterface SavedSupply {key:string;x:number;y:number;z:number;done:boolean;vehicle:number;}\nexport interface Save {\n  version:number;seed:number;tick:number;campaign:Partial<Campaign>;\n  seat:{data:Seat;guns:Gun[];x:number;z:number;hp:number;mags:number[];ride:number;slot:number;last:number}[];\n  rides:SavedRide[];supplies:SavedSupply[];friends:{key:string;x:number;z:number;hp:number}[];burns:string;\n}\nexport function makeSave(w:GW):Save {\n  const c=campaign(w),rides=[...w.query('ride','sceneProp')];\n  const {fire:_fire,fuel:_fuel,timers:_timers,regrow:_regrow,grass:_grass,flames:_flames,...rest}=c;\n  let last=-1,count=0;const rle:string[]=[];\n  for(const v of c.fire){if(v===last)count++;else{if(count)rle.push(\"'`${last}:${count}`);last=v;count=1;}}rle.push(`${last}:${count}`);\n  const data:Save={version:1,seed:w.seed,tick:w.tick,campaign:rest,\n    seat:players(w).map(p=>({data:{...p.seat!.data,wants:{},previous:[],released:[],vehicle:-1,target:-1,carrying:'\"'',action:'',actionProp:-1,down:0,rescue:-1,mirage:0,fever:p.health.hp<=0?0:p.seat\"'!.data.fever},\n      guns:p.gunState.data.guns,x:p.actor.x,z:p.actor.z,hp:Math.max(40,p.health.hp),mags:p.weapons.mags,ride:rides.findIndex(r=>r.id===p.seat!.data.vehicle),slot:p.weapons.slot,last:p.weapons.last})),\n    rides:rides.map(e=>{const r=e.ride.data,p=physicsOf(w).readBody(r.body);return {at:[p.position.x,p.position.y,p.position.z],q:[p.rotation.x,p.rotation.y,p.rotation.z,p.rotation.w],hp:r.hp,fuse:r.burning>0?Math.max(1,r.burning-w.tick):0};}),\n    supplies:[...w.query('\"'usable','sceneProp')].filter(e=>e.usable.data.kind==='crate').map(e=>({key:e.usable.data.key,x:e.sceneProp.x,y:e.sceneProp.y,z:e.sceneProp.z,done:e.usable.data.done,vehicle:e.usable.data.extra.startsWith('vehicle:')?rides.findIndex(r=>r.id===Number(e.usable.data.extra.slice(8))):-1})),\n    friends:c.buddies.map(b=>{const e=w.get(b.entity);return {key:b.key,x:e?.actor?.x??760,z:e?.actor?.z??826,hp:e?.health?.hp??0};}),burns:rle.join(',')};\n  return JSON.parse(JSON.stringify(data)) as Save;\n}\nexport function loadSave(w:GW,raw:unknown):void {\n  const data=raw as Save;if(data.version\"'!==1||!data.seat?.length||!data.campaign)return;\n  const c=campaign(w),buddies=c.buddies,oldTick=data.tick??0,rides=[...w.query('\"'ride','sceneProp')];\n  Object.assign(c,data.campaign);c.mode='story';delete c.flags.gameover;c.flags.auctionAftermath=0;\n  c.windNext=w.tick+Math.max(1,c.windNext-oldTick);if(c.flags.noise)c.flags.noise=w.tick-(oldTick-c.flags.noise);\n  if(c.flags.firstFever)c.flags.firstFever=w.tick-(oldTick-c.flags.firstFever)||1;\n  for(const key of Object.keys(c.cleared))c.cleared[key]=w.tick-(oldTick-c.cleared[key]);\n  for(const b of c.buddies){\n    b.entity=buddies.find(x=>x.key===b.key)?.entity??-1;const saved=data.friends?.find(x=>x.key===b.key),e=w.get(b.entity);\n    if(saved&&e?.actor)placeActor(w,b.entity,[saved.x,ground(saved.x,saved.z),saved.z]);\n    if(e?.health)e.health.hp=b.alive?(saved?.hp??100):0;\n    if(b.fallen>0)b.fallen=w.tick+Math.max(1,b.fallen-oldTick);\n    if((\"'!b.alive||b.fallen>0)&&e?.animator)handOff(w,b.entity,{dead:true});\n    if(!b.alive&&e?.usable)e.usable.data.done=true;\n  }\n  for(let n=0;n<(data.rides?.length??0);n++){\n    const e=rides[n],saved=data.rides[n];if(!e)continue;\n    physicsOf(w).setBody(e.ride.data.body,{position:saved.at,rotation:saved.q,velocity:[0,0,0],angularVelocity:[0,0,0]});\n    if(e.ride.data.blocker>=0)physicsOf(w).setBody(e.ride.data.blocker,{position:saved.at,rotation:saved.q});\n    e.ride.data.hp=saved.hp;e.ride.data.driver=-1;e.ride.data.burning=saved.hp<=0?-1:saved.fuse>0?w.tick+saved.fuse:0;\n    Object.assign(e.sceneProp,{x:saved.at[0],y:saved.at[1]-(e.ride.data.kind==='\"'boat'?0.3:0.8),z:saved.at[2],q:[...saved.q]});\n  }\n  for(const saved of data.supplies??[]){\n    const e=[...w.query('usable','sceneProp')].find(e=>e.usable.data.key===saved.key);if(\"'!e)continue;\n    if(saved.done){e.usable.data.done=true;removeProp(w,e.id);continue;}\n    Object.assign(e.usable.data,{x:saved.x,y:saved.y+0.6,z:saved.z,extra:saved.vehicle>=0&&rides[saved.vehicle]?`vehicle:${rides[saved.vehicle].id}`:'\"''});\n    Object.assign(e.sceneProp,{x:saved.x,y:saved.y,z:saved.z});\n  }\n  let i=0;for(const token of data.burns.split(',')){\n    const [v,n]=token.split(':').map(Number);for(let k=0;k<n&&i<c.fire.length;k++,i++){\n      if(v===2){const x=(i%192+0.5)*8,z=(Math.floor(i/192)+0.5)*8;ignite(w,x,z);}\n      else {c.fire[i]=v;if(v===3){const x=(i%192+0.5)*8,z=(Math.floor(i/192)+0.5)*8;spawnProp(w,{prop:'prop:field-scorch',at:[x,ground(x,z)+0.025,z],yaw:0});c.regrow[i]=w.tick+10800;if(c.grass[i]>=0){removeProp(w,c.grass[i]);c.grass[i]=-1;}}}\n    }\n  }\n  for(const saved of data.seat){\n    const p=players(w).find(x=>x.seat\"'!.data.n===saved.data.n);if(!p)continue;\n    p.seat!.data={...saved.data,wants:{},previous:[],released:[],actionProp:-1,feverNext:w.tick+Math.max(1,saved.data.feverNext-oldTick)};\n    if(p.seat.data.fever)p.seat.data.fever=w.tick-(oldTick-p.seat.data.fever)||1;\n    p.gunState.data.guns=saved.guns;p.health.hp=saved.hp;p.weapons.mags=saved.mags;p.weapons.slot=saved.slot??1;p.weapons.last=saved.last??1;\n    const r=(saved.ride??-1)>=0?data.rides[saved.ride]:null;let x=saved.x,z=saved.z;\n    if(r){const yaw=Math.atan2(2*(r.q[3]*r.q[1]+r.q[0]*r.q[2]),1-2*(r.q[1]*r.q[1]+r.q[2]*r.q[2]));x=r.at[0]+Math.cos(yaw)*2.4;z=r.at[2]-Math.sin(yaw)*2.4;}\n    placeActor(w,p.id,[x,Math.max(ground(x,z),0.12),z]);\n  }\n  setDaytime(w,{hour:c.hour,rate:24/(w.settings.get<number>('\"'game.day.minutes')*60)});mark(w,'load');\n}\nexport function digest(w:GW):string {\n  const c=campaign(w),round=(v:number)=>Math.round(v*1000);\n  return JSON.stringify({tick:w.tick,contract:c.contract,step:c.step,flags:c.flags,wind:round(c.wind),\n    seats:players(w).map(p=>[p.seat\"'!.data.n,round(p.actor.x),round(p.actor.z),round(p.health.hp),p.weapons.shots,p.gunState.data.guns.map(g=>[round(g.condition),g.jam])]),\n    cars:[...w.query('\"'ride','sceneProp')].map(e=>[round(e.sceneProp.x),round(e.sceneProp.z),round(e.ride.data.hp)]),\n    burns:c.fire.reduce((a,v,i)=>(a[v]=(a[v]??0)+i+1,a),[] as number[])});\n}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/main.ts');s=p.read_text().replace(\\\"    if (reuse) e.actions.run('mode', { mode });\\\\n    else e.seed(ctx.seed);\\\", \\\"    const saved=load?store.get<import('./scenes/save').Save|null>('save',null):null;\\\\n    if (reuse) e.actions.run('mode', { mode });\\\\n    else e.seed(saved?.seed??ctx.seed);\\\")\np.write_text(s)\np=Path('labs/game/scenes/state.ts');s=p.read_text().replace(\\\"['campaign', 'seat', 'soldier', 'ride', 'usable', 'gunState']\\\", \\\"['campaign', 'seat', 'soldier', 'ride', 'usable', 'gunState','gameSave']\\\")\ns=s.replace(\\\"  campaign: { data: Campaign };\\\", \\\"  campaign: { data: Campaign };\\\\n  gameSave:{data:Record<string,unknown>};\\\")\np.write_text(s)\np=Path('labs/game/scenes/world.ts');s=p.read_text().replace(\\\"import { loadSave }\\\", \\\"import { loadSave,makeSave }\\\")\ns=s.replace(\\\"  actions: {\\\\n\\\", \\\"  actions: {\\\\n    snapshot(w:GW){const data=makeSave(w),e=w.query('gameSave')[0];if(e)e.gameSave.data=data as unknown as Record<string,unknown>;else w.spawn({gameSave:{data:data as unknown as Record<string,unknown>}});},\\\\n\\\")\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_227","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/scenes/save.ts');s=p.read_text().replace('const data=raw as Save;', 'const data=JSON.parse(JSON.stringify(raw)) as Save;');p.write_text(s)\np=Path('labs/game/scenes/health.ts');s=p.read_text().replace(\\\"    if (cheat(w, 'noFever') || c.flags.cured)\\\", \\\"    if (w.settings.get<boolean>('game.noFever')&&c.mode\"'!=='\"'attract' || c.flags.cured)\\\")\ns=s.replace(\\\"  for (const p of players(w)) {\\\\n    const s = p.seat\"'!.data;'\"\\\\n    if (w.settings\\\", \\\"  const interval=value(w,'fever.intervalMin');if(c.flags.feverInterval\"'!==interval){c.flags.feverInterval=interval;for(const p of players(w))if(!p.seat!.data.fever)p.seat!.data.feverNext=w.tick+Math.round(interval*3600);}'\"\\\\n  for (const p of players(w)) {\\\\n    const s = p.seat\"'!.data;'\"\\\\n    if (w.settings\\\")\np.write_text(s)\np=Path('labs/game/scenes/fire.ts');s=p.read_text().replace(\\\"  c.windSpeed =\\\", \\\"  if(c.flags.windInterval\"'!==interval){c.flags.windInterval=interval;c.windNext=w.tick+interval;}'\"\\\\n  c.windSpeed =\\\")\np.write_text(s)\np=Path('labs/game/scenes/world.ts');s=p.read_text().replace(\\\"  c.hour = daytimeOf(w) ?? c.hour;\\\", \\\"  c.hour = daytimeOf(w) ?? c.hour;\\\\n  if(c.flags.dayMinutes\"'!==value(w,'\"'day.minutes')){c.flags.dayMinutes=value(w,'day.minutes');setDaytime(w,{hour:c.hour,rate:24/(value(w,'day.minutes')*60)});}\\\")\ns=s.replace(\\\"    fever(w: GW) {\\\", \\\"    fever(w: GW,raw:unknown) {\\\\n      const late=(raw as {late?:boolean}|null)?.late??false;\\\").replace(\\\"p.seat\"'!.data.fever = w.tick || 1;\", \"p.seat!.data.fever = (w.tick || 1)-(late?1900:0);\")\np.write_text(s)\np=Path('\"'labs/game/scenes/arms.ts');s=p.read_text().replace(\\\"if (cheat(w, 'noWear')) gs.jam = false;\\\", \\\"if (w.settings.get<boolean>('game.noWear')&&campaign(w).mode\"'!=='\"'attract') gs.jam = false;\\\")\np.write_text(s)\np=Path('labs/game/attract.ts');s=p.read_text().replace(\\\"e.actions.run('fever', {});\\\", \\\"e.actions.run('fever', {late:true});\\\")\ns=s.replace(\\\"      if (kind === 3) e.actions.run\\\", \\\"      if(kind===2)e.step(1,{p:['weapon2']});\\\\n      if (kind === 3) e.actions.run\\\")\ns=s.replace(\\\"? ['fire', 'quickfire']\\\", \\\"? [...(Math.floor((now-this.startAt)/400)%2===0?['fire']:[]),'quickfire']\\\")\np.write_text(s)\np=Path('labs/game/scenes/story.ts');s=p.read_text().replace(\\\"    if (b) {\\\\n      b.fallen\\\", \\\"    if(\"'!b){c.flags.invoiceResolved=1;c.flags.buddyFallen=1;say(w,'\"'Field telephone','No answer. There is nobody left to send the bill to.');}\\\\n    if (b) {\\\\n      b.fallen\\\")\np.write_text(s)\nPY\nnpm run format > out/format.log 2>&1\nNODE_OPTIONS=--max-old-space-size=1800 npm run check > out/check.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
