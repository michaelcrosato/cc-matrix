{"type":"item.completed","item":{"id":"item_241","type":"command_execution","command":"/bin/bash -lc \"rg -n 'cardStatus|broadcastCard|left|type: .card.|kind: .card.|k: .card.' .cache/hub/round.js | tail -18\nsed -n '40,57p' labs/game/net/session.ts\nsed -n '281,307p' labs/game/scenes/world.ts\nsed -n '315,344p' labs/game/scenes/world.ts\nsed -n '80,102p' labs/game/ui/controls.ts\"","aggregated_output":"135: * exactly once. Players already gone may be placed or left out; whoever is\n136: * left out lands in a last group of their own.\n313:    const left = present();\n314:    if (!left.length) return finishVoid('no-players');\n316:      return finishVoid(host.out === 'not-ready' ? 'host-not-ready' : 'host-left', phase === 'loading' ? 'void' : 'host-left');\n322:    if (selfReported() && left.every((s) => s.result)) finishResults();\n356:    // Whoever reported and then left keeps their place: only those who left with nothing count as beaten.\n466:  function leave(key, reason = 'left') {\n  if (!hub || !info) return null;\n  const root = document.createElement('div');\n  root.className = 'session-card';\n  root.dataset.screen = 'card';\n  root.innerHTML =\n    '<p class=\"eyebrow\">COOPERATIVE CONTRACT / 01</p><h1>Bar Cry</h1><h2>Burn the depot.<br>Get out alive together.</h2><div class=\"crew\"></div><p>WASD / left stick moves · Click / R2 fires<br>E / □ uses · F / D-pad right draws a flare</p><button class=\"primary\">Enter / ✕ · Ready</button><button>△ · More time</button><p class=\"card-count\">Waiting for the crew</p>';\n  for (const p of info.players) {\n    const line = document.createElement('p');\n    line.textContent = p.name;\n    line.style.color = p.color;\n    root.querySelector('.crew')!.append(line);\n  }\n  const answer = () => hub.answer('ready');\n  root.querySelectorAll('button')[0].onclick = answer;\n  root.querySelectorAll('button')[1].onclick = () => hub.answer('more');\n  const key = (e: KeyboardEvent) => {\n    if (e.code === 'Enter') answer();\n    if (e.code === 'KeyY') hub.answer('more');\n      const a = raw as { x: number; z: number; radius?: number };\n      ignite(w, a.x, a.z, a.radius ?? 1);\n    },\n    hurt(w: GW, raw: unknown) {\n      const a = raw as { hp: number; seat?: number };\n      const p = players(w).find((x) => x.seat!.data.n === (a.seat ?? 0));\n      if (p) {\n        p.health.hp = a.hp;\n        p.health.hitAt = w.tick;\n      }\n    },\n    fever(w: GW, raw: unknown) {\n      const late = (raw as { late?: boolean } | null)?.late ?? false;\n      for (const p of players(w)) {\n        p.seat!.data.fever = (w.tick || 1) - (late ? 1900 : 0);\n        p.seat!.data.feverNext = w.tick;\n        mark(w, 'fever attack');\n      }\n    },\n    give(w: GW, raw: unknown) {\n      const a = raw as { stones?: number; pills?: number; syr?: number; condition?: number; jam?: boolean };\n      for (const p of players(w)) {\n        const s = p.seat!.data;\n        if (a.stones !== undefined) s.stones = a.stones;\n        if (a.pills !== undefined) s.pills = a.pills;\n        if (a.syr !== undefined) s.syr = a.syr;\n        if (a.condition !== undefined) for (const g of p.gunState.data.guns) g.condition = a.condition;\n      c.step = a.step ?? 0;\n      c.ending = '';\n      c.goal = CONTRACTS[c.contract].steps[c.step].goal;\n      c.flags.gameover = 0;\n    },\n    debt(w: GW, raw: unknown) {\n      const a = raw as { key: string; debt: number; alive?: boolean };\n      const b = campaign(w).buddies.find((x) => x.key === a.key);\n      if (b) {\n        b.debt = Math.max(-3, Math.min(3, a.debt));\n        if (a.alive !== undefined) {\n          b.alive = a.alive;\n          b.fallen = 0;\n          const friend = w.get(b.entity);\n          if (friend?.health) friend.health.hp = a.alive ? 100 : 0;\n          if (a.alive) standUp(w, b.entity);\n          else handOff(w, b.entity, { dead: true });\n        }\n      }\n    },\n    standing(w: GW, raw: unknown) {\n      const a = raw as { front: number; authority: number };\n      campaign(w).front = a.front;\n      campaign(w).authority = a.authority;\n    },\n    spawn(w: GW, raw: unknown) {\n      const a = raw as { kind: string; key?: string; condition?: number };\n      const p = players(w)[0];\n      if (!p) return;\n      if (a.kind === 'vehicle') spawnVehicle(w, a.key ?? 'pickup', p.actor.x + 5, p.actor.z);\n      previous: [],\n    },\n    view: ['ledger', 'viewCamera', 'mapMark', 'mapZoom'],\n    look: true,\n    aimWith: 'centre',\n    lock: false,\n  });\nexport const PROMPTS: Record<string, [string, string, string]> = {\n  interact: ['E', '□', 'X'],\n  reload: ['Hold R', 'Hold □', 'Hold X'],\n  heal: ['H', 'L1', 'LB'],\n  pill: ['P', '◀', '◀'],\n  map: ['M', '▲', '▲'],\n  locator: ['B', '▼', '▼'],\n  fire: ['LMB', 'R2', 'RT'],\n  back: ['Esc', '○', 'B'],\n  select: ['Enter', '✕', 'A'],\n};\nexport function glyph(ctx: Context, key: string): string {\n  const row = PROMPTS[key] ?? [key, key, key];\n  if (ctx.device !== 'gamepad' && (key === 'back' || key === 'select')) return row[0];\n  if (ctx.device !== 'gamepad' && ctx.engine?.input) {\n    const bindings = ctx.engine.input.bindings,\n","exit_code":0,"status":"completed"}}
