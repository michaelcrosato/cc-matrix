{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"cat > test.py <<'EOF'\n\\\"\\\"\\\"Quiet, complete validation. Run ../<game folder>/test.sh from any directory.\\\"\\\"\\\"\nfrom pathlib import Path\nfrom http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler\nfrom functools import partial\nimport threading, subprocess, json, sys, time, traceback\nfrom urllib.parse import urlparse, unquote\nfrom playwright.sync_api import sync_playwright\n\nHERE=Path(__file__).resolve().parent\nROOT=HERE.parent\nGAME=HERE.name+'.html'\nfailures=[]\ncount=0\nreports={}\nclass Quiet(SimpleHTTPRequestHandler):\n    def log_message(self,*args): pass\n\ndef check(name, fn):\n    global count\n    count+=1\n    try:\n        value=fn()\n        if value is False: raise AssertionError('condition was false')\n    except Exception as error:\n        failures.append(f'{name}: {error}')\n\ndef state(page): return page.evaluate('__creaks.state()')\ndef ready(page): page.wait_for_function('window.__creaks?.ready && __creaks.state().gpuFrames>0',timeout=60000)\ndef wait(page, expression): page.wait_for_function(expression, timeout=15000)\ndef click(page, action): page.locator(f'[data-action=\\\"{action}\\\"]:visible').first.click()\ndef dependency(route):\n    path=unquote(urlparse(route.request.url).path)\n    if '/three@0.180.0/build/' in path:\n        file=HERE/'node_modules/three/build'/path.split('/')[-1]\n    elif '/@dimforge/rapier3d-compat@0.19.3/' in path:\n        file=HERE/'node_modules/@dimforge/rapier3d-compat'/path.split('/')[-1]\n    else: route.continue_();return\n    if file.is_file(): route.fulfill(path=str(file),content_type='text/javascript',headers={'Access-Control-Allow-Origin':'*'})\n    else: route.continue_()\n\nbuild=subprocess.run(['python3','build.py'],cwd=HERE,capture_output=True,text=True)\ncheck('Single-file build',lambda: build.returncode==0)\ncore=subprocess.run(['node','tests/core.test.mjs'],cwd=HERE,capture_output=True,text=True)\ntry:\n    data=json.loads(core.stdout);count+=data['count'];failures.extend(data['failures'])\nexcept Exception: failures.append('Simulation tests: '+core.stdout+core.stderr)\nhtml=(ROOT/GAME).read_text()\nscript=html.split('<script type=\\\"module\\\">',1)[1].split('</script>',1)[0]\nsyntaxfile=HERE/'tests/bundle-check.mjs';syntaxfile.write_text(script)\nsyntax=subprocess.run(['node','--check',str(syntaxfile)],cwd=HERE,capture_output=True,text=True)\ncheck('Bundled JavaScript syntax',lambda: syntax.returncode==0)\ncheck('Exit interview JSON schema',lambda: set(json.loads((ROOT/'exit-interview.json').read_text()))=={'sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub'})\ncheck('Unmodified AI Hub client is embedded',lambda: (HERE/'vendor/session.js').read_text() in html)\nserver=ThreadingHTTPServer(('127.0.0.1',0),partial(Quiet,directory=str(ROOT)))\nthreading.Thread(target=server.serve_forever,daemon=True).start()\nbase=f'http://127.0.0.1:{server.server_port}'\nurl=base+'/'+GAME\nflags=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-angle=vulkan','--disable-vulkan-surface','--autoplay-policy=no-user-gesture-required']\ntry:\n with sync_playwright() as p:\n  browser=p.chromium.launch(headless=True,args=flags)\n  context=browser.new_context(viewport={'width':1600,'height':1000},device_scale_factor=1)\n  context.route('https://cdn.jsdelivr.net/npm/**',dependency)\n  page=context.new_page()\n  errors=[]\n  page.on('pageerror',lambda e:errors.append(str(e)))\n  page.goto(url)\n  ready(page)\n  check('Correct game and actual WebGPU backend',lambda: page.title()=='The House of Creaks' and state(page)['backend']=='WebGPU')\n  check('Music defaults to ten percent',lambda: state(page)['music']==.1)\n  click(page,'start')\n  check('Title starts a playable night',lambda: state(page)['screen']=='game' and len(state(page)['players'])==1)\n  start=state(page)['players'][0]\n  page.keyboard.down('KeyD')\n  wait(page,f'Math.abs(__creaks.player().x - {start[\\\"x\\\"]}) > .35')\n  page.keyboard.up('KeyD')\n  check('Keyboard moves through the physical world',lambda: abs(state(page)['players'][0]['x']-start['x'])>.35)\n  page.keyboard.press('Space')\n  wait(page,'__creaks.player().matches===15')\n  check('Match key ignites a real flame',lambda: state(page)['players'][0]['match']>0)\n  page.keyboard.press('Tab')\n  check('Paper map and floor navigation',lambda: state(page)['screen']=='map' and page.locator('.map-room').count()==6)\n  click(page,'map-3')\n  check('All four floors are on the map',lambda: 'The Attic' in page.locator('#panel h2').inner_text())\n  page.keyboard.press('Escape')\n  page.keyboard.press('Escape')\n  click(page,'dev')\n  check('Pause exposes complete developer controls',lambda: page.locator('[data-tuning]').count()==6 and page.locator('[data-action=grant-shard]').is_visible())\n  page.locator('#dev-speed').fill('6.5')\n  check('Live slider changes movement tuning',lambda: page.locator('#devout-speed').inner_text()=='6.5')\n  click(page,'god')\n  click(page,'floor-up')\n  check('Developer teleport changes actual floor',lambda: state(page)['players'][0]['f']==1)\n  click(page,'reset-tuning')\n  click(page,'pause')\n  click(page,'settings')\n  page.locator('#set-glyphs').select_option('xbox')\n  check('Xbox glyph preference is stored',lambda: state(page)['glyphs']=='xbox')\n  click(page,'back')\n  page.evaluate('__creaks.audioTest()')\n  wait(page,'__creaks.state().audio.notes>0 && __creaks.state().audio.level>0.0001')\n  check('Synthesized music, effects and gibberish produce audio',lambda: state(page)['audio']['effects']>=2 and state(page)['audio']['voices']>=1)\n  # Standard Gamepad API emulation, including a real Options -> resume flow.\n  page.evaluate('''window.__pad={id:'Virtual standard DualSense',index:0,connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0}))};navigator.getGamepads=()=>[__pad]''')\n  old=state(page)['players'][0]['x']\n  page.evaluate('__pad.axes[0]=.8')\n  wait(page,f'__creaks.state().lastInput===\\\"gamepad\\\" && Math.abs(__creaks.player().x-{old})>.2')\n  page.evaluate('__pad.axes[0]=0;__pad.buttons[9].pressed=true')\n  wait(page,'__creaks.state().screen===\\\"pause\\\"')\n  page.evaluate('__pad.buttons[9].pressed=false')\n  page.wait_for_timeout(200)\n  page.evaluate('__pad.buttons[0].pressed=true')\n  wait(page,'__creaks.state().screen===\\\"game\\\"')\n  page.evaluate('__pad.buttons[0].pressed=false')\n  check('Standard gamepad moves, pauses, resumes and changes prompts',lambda: state(page)['lastInput']=='gamepad' and 'RT' in page.locator('#controlHints').inner_text())\n  # Scripted full physical playthrough, using the public developer test controls.\n  page.evaluate('''()=>{__creaks.action('quit');__creaks.start();__creaks.god(true);__creaks.tune({enemySpeed:0});window.walk=(x,z)=>{for(const q of __creaks.path(x,z)){let n=0;while(Math.hypot(__creaks.player().x-q.x,__creaks.player().z-q.z)>.13&&n++<100){const p=__creaks.player(),dx=q.x-p.x,dz=q.z-p.z,d=Math.hypot(dx,dz);__creaks.step(1/60,{x:dx/d,z:dz/d});}if(n>=100)throw new Error('navigation stuck');}};window.use=()=>{__creaks.step(1.05,{});__creaks.interact()};}''')\n  page.evaluate('''()=>{walk(10,-6.6);use();walk(12,7);use();walk(-12,-7);use();walk(-10,5.8);use();walk(-12,-7);use();walk(12,7);use();walk(0,6.2);use();walk(12,7);use();walk(0,-5.8);use();walk(12,7);use();walk(0,6.2);use();walk(12,7);use();walk(-12,-7);use();walk(12,7);use();walk(10,-6.2);use();walk(12,7);use();walk(-12,-7);use();walk(12,7);use();walk(0,6.2);use();walk(0,9);use();}''')\n  wait(page,'__creaks.state().screen===\\\"ending\\\"')\n  check('Browser full playthrough reaches victory with all mechanics',lambda: state(page)['status']=='won' and state(page)['recovered']==3 and state(page)['stairsUsed']>=12)\n  click(page,'quit')\n  click(page,'about')\n  check('In-game credits include all required source fields',lambda: 'added on import' in page.locator('.credits-text').inner_text() and '0.19.3' in page.locator('.credits-text').inner_text())\n  click(page,'about-1');check('Testing feedback is accessible in game',lambda: page.locator('.credits-text p').count()==4)\n  click(page,'back')\n  page.evaluate('__creaks.setIdle()')\n  wait(page,'__creaks.state().attract===true')\n  check('Idle title enters an AI-played attract mode',lambda: state(page)['screen']=='attract')\n  page.wait_for_timeout(1300)\n  check('Attract replay actually moves its player',lambda: abs(state(page)['players'][0]['x']+2)>.1)\n  page.keyboard.press('Enter')\n  check('Any input exits attract mode to title',lambda: state(page)['screen']=='title' and not state(page)['attract'])\n  # Same-origin two-page co-op.\n  click(page,'coop');click(page,'local-host');room=page.locator('.code-display').inner_text()\n  guest=context.new_page();guest.goto(url);ready(guest)\n  click(guest,'coop');click(guest,'local-join');guest.locator('#roomCode').fill(room);click(guest,'join-room')\n  wait(guest,'__creaks.state().net.me===1')\n  check('Standalone room assigns a second player',lambda: len(state(page)['players'])==2 and state(guest)['net']['me']==1)\n  click(page,'start');wait(guest,'__creaks.state().screen===\\\"game\\\"')\n  old=state(guest)['players'][1]['x'];guest.keyboard.down('KeyD')\n  wait(page,f'Math.abs(__creaks.state().players[1].x-{old})>.3')\n  guest.keyboard.up('KeyD')\n  check('Guest inputs update the host-owned shared world',lambda: abs(state(page)['players'][1]['x']-old)>.3)\n  page.evaluate(\\\"__creaks.teleport(0,5,1);__creaks.action('grant-shard');__creaks.teleport(0,6.4,0);__creaks.interact()\\\")\n  wait(guest,'__creaks.state().banked.length===1')\n  check('Recovered fragments replicate to the guest',lambda: state(guest)['banked']==state(page)['banked'])\n  guest.evaluate(\\\"__creaks.action('quit')\\\");wait(page,'__creaks.state().players.length===1');guest.close()\n  page.evaluate(\\\"__creaks.action('quit')\\\")\n  # Cross-device transport with manual offer/answer, no public broker.\n  page.evaluate('__creaks.createOffer()')\n  wait(page,'\"'!!__creaks.offer()'\"')\n  offer=page.evaluate('__creaks.offer()')\n  guest=context.new_page();guest.goto(url);ready(guest)\n  guest.evaluate('(code)=>__creaks.acceptOffer(code)',offer)\n  wait(guest,'\"'!!__creaks.answer()'\"');answer=guest.evaluate('__creaks.answer()')\n  page.evaluate('(code)=>__creaks.acceptAnswer(code)',answer)\n  wait(guest,'__creaks.state().net.me===1')\n  check('Direct WebRTC invitation and reply connect two pages',lambda: len(state(page)['players'])==2)\n  page.evaluate('__creaks.start()');wait(guest,'__creaks.state().screen===\\\"game\\\"')\n  old=state(guest)['players'][1]['z'];guest.keyboard.down('KeyS')\n  wait(page,f'Math.abs(__creaks.state().players[1].z-{old})>.2');guest.keyboard.up('KeyS')\n  check('WebRTC carries live cooperative inputs and snapshots',lambda: state(guest)['net']['stats']['received']>2 and state(page)['net']['stats']['received']>0)\n  guest.evaluate(\\\"__creaks.action('quit')\\\");guest.close();page.evaluate(\\\"__creaks.action('quit')\\\")\n  check('No browser game errors',lambda: not errors and not page.evaluate('__creaksErrors.length'))\n  context.close()\n  # Real touch profile. A single browser remains open.\n  touch=browser.new_context(**p.devices['iPhone 13'],is_mobile=True,has_touch=True)\n  touch.route('https://cdn.jsdelivr.net/npm/**',dependency)\n  mobile=touch.new_page();mobile.goto(url);ready(mobile)\n  mobile.touchscreen.tap(120,580) if False else None\n  mobile.locator('[data-action=start]').tap()\n  old=state(mobile)['players'][0]['x']\n  mobile.dispatch_event('#world','pointerdown',{'pointerId':7,'pointerType':'touch','clientX':70,'clientY':600,'bubbles':True})\n  mobile.dispatch_event('#world','pointermove',{'pointerId':7,'pointerType':'touch','clientX':120,'clientY':560,'bubbles':True})\n  wait(mobile,f'Math.abs(__creaks.player().x-{old})>.15')\n  mobile.dispatch_event('#world','pointerup',{'pointerId':7,'pointerType':'touch','clientX':120,'clientY':560,'bubbles':True})\n  check('Touch drag moves with a minimal HUD',lambda: state(mobile)['lastInput']=='touch' and mobile.locator('#controlHints').is_hidden())\n  check('Touch menu remains usable',lambda: mobile.locator('[data-action=pause]').bounding_box()['width']>=30)\n  touch.close()\n  # File deployment, with exactly the same external module loading.\n  filectx=browser.new_context();filectx.route('https://cdn.jsdelivr.net/npm/**',dependency)\n  filepage=filectx.new_page();filepage.goto((ROOT/GAME).as_uri());ready(filepage)\n  check('Single HTML boots directly from file://',lambda: state(filepage)['screen']=='title' and state(filepage)['backend']=='WebGPU')\n  filectx.close()\n  # Official conformance harness. Sequential scenarios limit resource use.\n  harnessctx=browser.new_context(viewport={'width':1280,'height':800});harnessctx.route('https://cdn.jsdelivr.net/npm/**',dependency)\n  scenarios=[('two-player','players=2'),('four-player-impaired','players=4&latency=150&jitter=50&loss=5'),('host-leave','players=4&latency=150&jitter=50&loss=5&scenario=host-leave'),('server-only-host','players=2&scenario=server')]\n  for label,args in scenarios:\n   h=harnessctx.new_page();h.goto(base+'/'+HERE.name+'/vendor/harness.html?game=../../'+GAME+'&auto=1&play=3&'+args)\n   try:\n    h.wait_for_function('document.body.dataset.complete===\\\"true\\\"',timeout=60000)\n    report=h.evaluate('window.__hubCheck');reports[label]=report\n    for item in report['checks']:\n     count+=1\n     if not item['pass']:failures.append('AI Hub '+label+' / '+item['name']+': '+item.get('detail',''))\n    if not report['pass'] and not any(not c['pass'] for c in report['checks']):failures.append('AI Hub '+label+' did not pass')\n   except Exception as e:failures.append('AI Hub '+label+': '+str(e))\n   h.close()\n  harnessctx.close();browser.close()\nexcept Exception as e:\n failures.append('Browser validation interrupted: '+str(e))\nfinally:\n server.shutdown();server.server_close()\n(HERE/'tests/results.json').write_text(json.dumps({'count':count,'failures':failures,'hub':reports},indent=2))\nfor f in failures:print('FAIL '+f)\nprint(f'{count-len(failures)}/{count} checks passed; {len(failures)} failures.')\nsys.exit(bool(failures))\nEOF\ncat > test.sh <<'EOF'\n#\"'!/usr/bin/env bash\nset -euo pipefail\nTASK_TEST_DIR=\"$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")\" && pwd)\"\nexec /home/micha/.local/share/pipx/venvs/playwright/bin/python \"$TASK_TEST_DIR/test.py\"\nEOF\nchmod +x test.sh\nshfmt -w test.sh\nshellcheck test.sh\n./test.sh'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
