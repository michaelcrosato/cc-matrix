{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"cat >> main.mjs <<'EOF'\n\nconst CREDITS = /* CREDITS */ null;\nconst net={kind:'solo',isHost:true,me:0,roster:[{id:0,name:'You',color:'#efc477'}],inputs:{},inputAt:{},bc:null,room:'',uid:crypto.randomUUID(),peers:new Map(),channels:new Map(),pending:null,pc:null,started:false,seq:0,seenSeq:0,eventQueue:[],stats:{sent:0,received:0},status:''};\nconst SEAT_COLORS=['#efc477','#80d1be','#bba4db','#e99782'];\nfunction localPlayer(){if(hubInfo?.server)return null;return game.players.find(p=>p.id===net.me)||(\"'!hubInfo&&net.kind==='\"'solo'?game.players[0]:null)}\nfunction isAuthority(){return net.isHost}\nfunction escapeHTML(text){return String(text).replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]))}\nfunction glyph(action){const ps={interact:'×',drop:'○',pulse:'□',map:'△',match:'R2',hush:'L1',pause:'☰',move:'L',aim:'R'},xb={interact:'A',drop:'B',pulse:'X',map:'Y',match:'RT',hush:'LB',pause:'☰',move:'L',aim:'R'},kb={interact:'E',drop:'Q',pulse:'F',map:'Tab',match:'Space',hush:'Shift',pause:'Esc',move:'WASD',aim:'Mouse'};if(lastInput==='gamepad'){const t=(settings.glyphs==='xbox'?xb:ps)[action];return \"'`<span class=\"${t.length===1?'\"'glyph':'key glyph'}\\\">\"'${t}</span>`}return `<kbd>${kb[action]}</kbd>`}\nfunction markInput(type){const now=performance.now();lastActivity=now;if(lastInput!==type){lastInput=type;document.body.classList.toggle('\"'touch',type==='touch');updatePrompts();if(screen==='help')showHelp();}if(attract){endAttract();return true}return false}\nfunction updatePrompts(){if(\"'!game)return;$('\"'#titleInputHint').textContent=lastInput==='gamepad'?'Left stick to wander · R2 to light the way':'WASD to wander · Space to light the way';\"'$('\"'#controlHints').innerHTML=\"'`${glyph('\"'match')}Strike a match<br>\"'${glyph('\"'hush')}Hush &nbsp; \"'${glyph('\"'map')}House map\"'`;}\nfunction titleButtons(){const save=safeRead(SAVE_KEY,null);$('\"'#titleButtons').innerHTML=\"'`<button class=\"primary\" data-action=\"start\">Enter the house <span>→</span></button>${save?.status==='\"'playing'?'<button class=\\\"secondary\\\" data-action=\\\"continue\\\">Continue the night <span style=\\\"float:right;color:var(--gold)\\\">'+save.banked.length+'/3</span></button>':''}<div class=\\\"button-row\\\"><button class=\\\"secondary\\\" data-action=\\\"coop\\\">Play together</button><button class=\\\"secondary\\\" data-action=\\\"help\\\">How to play</button></div>\"'`;}\nfunction setTitle(){screen='\"'title';paused=false;attract=false;game.attract=false;net.started=false;\"'$('\"'#titleScreen').classList.remove('hidden');\"'$('\"'#hud').classList.add('hidden');\"'$('\"'#attractBanner').classList.add('hidden');\"'$('\"'#overlay').classList.add('hidden');\"'$('\"'#touchAction').classList.add('hidden');titleButtons();lastActivity=performance.now();menuIndex=0;resize();}\nfunction newNight(continuing=false){if(hubInfo)return;const save=continuing?safeRead(SAVE_KEY,null):null;const seats=net.kind==='solo'?[{id:0,name:'You',color:SEAT_COLORS[0]}]:net.roster;game.reset(seats);game.tuning.enemySpeed=settings.difficulty==='quiet'?.65:settings.difficulty==='dire'?1.3:1;if(save&&net.kind==='solo')game.apply(save);screen='game';paused=false;net.started=true;netEnded=false;\"'$('\"'#titleScreen').classList.add('hidden');\"'$('\"'#hud').classList.remove('hidden');\"'$('\"'#overlay').classList.add('hidden');\"'$('\"'#attractBanner').classList.add('hidden');lastRevision=-1;lastRoom='';resize();updatePrompts();toast('Three pieces of an urn. One way out.',5);audio.unlock();}\nfunction toast(text,duration=3){if(\"'!text)return;$('\"'#toast').textContent=text;\"'$('\"'#toast').classList.add('show');toastUntil=performance.now()+duration*1000;}\nfunction openPanel(name,html,wide=false){if(\"'!['\"'title','loading'].includes(screen)&&screen\"'!=='\"'attract')previousScreen='game';else if(screen==='title')previousScreen='title';screen=name;paused=true;\"'$('\"'#overlay').classList.remove('hidden');\"'$('\"'#panel').classList.toggle('wide',wide);\"'$('\"'#panel').innerHTML=html;menuIndex=0;updateFocus(false);\"'$('\"'#touchAction').classList.add('hidden');}\nfunction header(eye,title){return \"'`<div class=\"panel-header\"><div><p class=\"eyebrow\">${eye}</p><h2>${title}</h2></div><button class=\"close-button\" data-action=\"back\" aria-label=\"Back\">×</button></div>`}\nfunction closePanel(){if(hubEnded)return;if(previousScreen==='\"'title'){setTitle();return}screen='game';paused=false;\"'$('\"'#overlay').classList.add('hidden');resize();}\nfunction showPause(){if(hubEnded||screen==='title')return;previousScreen='game';openPanel('pause',header('CATCH YOUR BREATH','The house can wait.')+\"'`<p>${FLOOR_NAMES[localPlayer()?.f||0]} · ${game.banked.length} of 3 pieces returned${net.kind!=='\"'solo'?'<br><small>The shared house keeps moving while your menu is open.</small>':''}</p><div class=\\\"menu-stack\\\"><button class=\\\"primary\\\" data-action=\\\"resume\\\">Back to the house <span>→</span></button><button class=\\\"menu-button\\\" data-action=\\\"map\\\">The house map <em>\"'${lastInput==='\"'gamepad'?'△':'Tab'}</em></button><button class=\\\"menu-button\\\" data-action=\\\"settings\\\">Settings</button><button class=\\\"menu-button\\\" data-action=\\\"help\\\">How to play</button><button class=\\\"menu-button\\\" data-action=\\\"dev\\\">Developer tools</button>\"'${hubInfo?'\"'':'<button class=\\\"menu-button\\\" data-action=\\\"quit\\\">Save & return to title</button>'}</div>\"'`)}\nfunction showHelp(){const p=screen==='\"'title'?'title':previousScreen;openPanel('help',header('A QUICK WORD OF WARNING','Mind your match.')+\"'`<div class=\"instruction\"><span class=\"num\">01</span><div><strong>Put the past back together.</strong><p>Find three urn fragments upstairs. Carry each to the plinth in the foyer. Then escape through the front door.</p></div></div><div class=\"instruction\"><span class=\"num\">02</span><div><strong>One hand. Difficult choices.</strong><p>Carry a key, a fragment, or the scepter. Taking another swaps them. The brass key opens the upper library stair permanently.</p></div></div><div class=\"instruction\"><span class=\"num\">03</span><div><strong>The dark is listening.</strong><p>Matches reveal your way and frighten spiders. Ghosts follow flame; bats put it out. Hush shelters a match from wind. Central candles refill matches and restore a nerve once per floor.</p></div></div><div class=\"controls-grid\"><div>${glyph('\"'move')}Move</div><div>\"'${glyph('\"'match')}Strike match</div><div>\"'${glyph('\"'interact')}Take / use / stairs</div><div>\"'${glyph('\"'drop')}Drop object</div><div>\"'${glyph('\"'hush')}Hold to hush</div><div>\"'${glyph('\"'pulse')}Scepter pulse</div><div>\"'${glyph('\"'map')}Map</div><div>\"'${glyph('\"'pause')}Pause</div></div><p class=\\\"small-print\\\">Mouse: aim with the pointer, click nearby objects to use them, right-click to hush. Touch: drag the left half to walk; tap the right half to use or light. Flame and scepter protection assist automatically.</p><div class=\\\"panel-footer\\\"><button class=\\\"primary\\\" data-action=\\\"back\\\">Understood <span>→</span></button></div>\"'`);previousScreen=p;}\nfunction settingRange(key,label,min,max,step,value,caption='\"''){return \"'`<div class=\"setting-row\"><label for=\"set-${key}\">${label}${caption?`<small>${caption}</small>`:'\"''}</label><div><output id=\\\"out-\"'${key}\">${Math.round(value*100)}%</output><input id=\"set-${key}\" data-setting=\"${key}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${value}\" aria-label=\"${label}\"></div></div>`}\nfunction showSettings(){const p=screen==='\"'title'?'title':previousScreen;openPanel('settings',header('MAKE YOURSELF AT HOME','Settings')+settingRange('music','Music',0,1,.01,settings.music,'An original midnight waltz.')+settingRange('sfx','Effects & voices',0,1,.01,settings.sfx)+\"'`<div class=\"setting-row\"><label for=\"set-glyphs\">Controller symbols</label><select id=\"set-glyphs\" data-setting=\"glyphs\"><option value=\"ps\" ${settings.glyphs==='\"'ps'?'selected':''}>PlayStation · × ○ □ △</option><option value=\\\"xbox\\\" \"'${settings.glyphs==='\"'xbox'?'selected':''}>Xbox · A B X Y</option></select></div><div class=\\\"setting-row\\\"><label for=\\\"set-difficulty\\\">The house’s temper<small>Applies immediately in your own house.</small></label><select id=\\\"set-difficulty\\\" data-setting=\\\"difficulty\\\"><option value=\\\"quiet\\\" \"'${settings.difficulty==='\"'quiet'?'selected':''}>A quiet visit</option><option value=\\\"restless\\\" \"'${settings.difficulty==='\"'restless'?'selected':''}>Restless house</option><option value=\\\"dire\\\" \"'${settings.difficulty==='\"'dire'?'selected':''}>Very bad address</option></select></div><div class=\\\"setting-row\\\"><label>Camera motion</label><button class=\\\"toggle\\\" data-action=\\\"motion\\\">\"'${settings.motion?'\"'Gentle drift':'Reduced motion'}</button></div><div class=\\\"setting-row\\\"><label>Brighter darkness</label><button class=\\\"toggle\\\" data-action=\\\"contrast\\\">\"'${settings.contrast?'\"'On':'Off'}</button></div><div class=\\\"panel-footer\\\"><button class=\\\"secondary\\\" data-action=\\\"fullscreen\\\">Fullscreen</button><button class=\\\"primary\\\" data-action=\\\"back\\\">Done <span>→</span></button></div>\"'`);previousScreen=p;}\nlet aboutTab=0;\nfunction showAbout(tab=aboutTab){aboutTab=tab;const p=screen==='\"'title'?'title':previousScreen;const names=['Source information','Testing feedback','Engine feedback','Prompt feedback'],data=tab===0?CREDITS.sourceInformation:tab===1?CREDITS.testingFeedback:tab===2?CREDITS.engineFeedback:CREDITS.promptFeedback;let content;if(tab===0)content=Object.entries(data).map(([k,v])=>\"'`<p><b>${escapeHTML(k.charAt(0).toUpperCase()+k.slice(1))}</b><br>${escapeHTML(v)}</p>`).join('\"'');else content=data.map((v,i)=>\"'`<p><b>${i+1}.</b> ${escapeHTML(v)}</p>`).join('\"'');openPanel('about',header('THE PEOPLE IN THE WALLS','About & credits')+\"'`<div class=\"tabs\">${names.map((n,i)=>`<button data-action=\"about-${i}\" class=\"${i===tab?'\"'active':''}\\\">\"'${n}</button>`).join('\"'')}</div><div class=\\\"credits-text\\\">\"'${tab===0?'\"'<p><b>The House of Creaks</b><br>An original game created in code. Inspired by Haunted House (Atari, 1982).<br>Designed, modeled, animated, composed and programmed by OpenAI gpt-6.1-sol.</p>':''}\"'${content}${tab===0?'\"'<p><b>Libraries</b><br>Three.js (MIT), Rapier (Apache-2.0), AI Hub client 1.4.0. All visuals and sound are procedural. No source assets or audio files are used.</p>':''}</div><div class=\\\"panel-footer\\\"><button class=\\\"primary\\\" data-action=\\\"back\\\">Back <span>→</span></button></div>\"'`,true);previousScreen=p;}\nfunction showMap(f=localPlayer()?.f||0){mapFloor=clamp(f,0,3);if(screen==='\"'title')return;previousScreen='game';const p=localPlayer(),known=game.notes.includes(0)||game.reveal;openPanel('map',header('A VERY UNRELIABLE FLOOR PLAN',FLOOR_NAMES[mapFloor])+\"'`<div class=\"tabs\">${FLOOR_NAMES.map((n,i)=>`<button data-action=\"map-${i}\" class=\"${mapFloor===i?'\"'active':''}\\\">\"'${i+1} · ${n.replace('\"'The ','')}</button>\"'`).join('\"'')}</div><div class=\\\"map-grid\\\">\"'${ROOM_NAMES[mapFloor].map((n,r)=>{const seen=game.visited[mapFloor].includes(r)||game.reveal;const current=p?.f===mapFloor&&roomAt(p.x,p.z)===r;const item=game.items.find(i=>i.f===mapFloor&&roomAt(i.x,i.z)===r&&!i.banked&&i.holder===null);const stairs=STAIRS.filter(s=>s.f===mapFloor&&s.r===r).map(s=>s.to>s.f?'\"'↑ Stairs up':'↓ Stairs down').join(' · ');return \"'`<div class=\"map-room ${seen?'\"'seen':''} \"'${current?'\"'current':''}\\\">\"'${seen||known?n:'\"'Unexplored'}\"'${current?'\"'<i>●</i>':''}<span>\"'${item&&(known||game.reveal||seen)?escapeHTML(ITEM_NAMES[item.id]):stairs|| (r===4?'\"'✧ Safe candle':'')}</span></div>\"'`}).join('\"'')}</div><p class=\\\"map-caption\\\">● You &nbsp; · &nbsp; A candle waits in each central landing. \"'${known?'\"'The study’s note marks the fragments.':'Rooms appear as you explore.'}</p><div class=\\\"panel-footer\\\"><button class=\\\"secondary\\\" data-action=\\\"map-prev\\\">← Floor</button><button class=\\\"secondary\\\" data-action=\\\"map-next\\\">Floor →</button><button class=\\\"primary\\\" data-action=\\\"resume\\\">Back <span>→</span></button></div>\"'`,true)}\nfunction devRange(k,label,min,max,step){return `<div class=\"setting-row\"><label for=\"dev-${k}\">${label}</label><div><output id=\"devout-${k}\">${game.tuning[k]}</output><input id=\"dev-${k}\" data-tuning=\"${k}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${game.tuning[k]}\" aria-label=\"${label}\"></div></div>`}\nfunction showDev(){previousScreen='\"'game';devUsed=true;openPanel('dev',header('THE KEYS TO THE HOUSE','Developer tools')+\"'`<p class=\"small-print\">Live balance. Changes take effect immediately.${!isAuthority()?'\"' The host controls this shared house.':''}</p><div class=\\\"dev-grid\\\">\"'${devRange('\"'speed','Walking speed',1,10,.1)}\"'${devRange('\"'enemySpeed','Creature pace',0,3,.05)}\"'${devRange('\"'matchDuration','Match life · seconds',3,60,1)}\"'${devRange('\"'windInterval','Wind interval · seconds',10,120,1)}\"'${devRange('\"'damage','Nerve loss per hit',0,5,.5)}\"'${devRange('\"'timeScale','Time scale',.25,3,.05)}</div><div class=\\\"dev-actions\\\"><button data-action=\\\"god\\\">Invulnerable: \"'${game.god?'\"'ON':'OFF'}</button><button data-action=\\\"reveal\\\">Reveal map: \"'${game.reveal?'\"'ON':'OFF'}</button><button data-action=\\\"collisions\\\">Collision overlay: \"'${debugCollisions?'\"'ON':'OFF'}</button><button data-action=\\\"refill\\\">Refill nerves & matches</button><button data-action=\\\"floor-down\\\">Teleport floor ↓</button><button data-action=\\\"floor-up\\\">Teleport floor ↑</button><button data-action=\\\"grant-key\\\">Bring brass key</button><button data-action=\\\"grant-ward\\\">Bring scepter</button><button data-action=\\\"grant-shard\\\">Bring next fragment</button></div><p class=\\\"small-print\\\">\"'${renderer.backend?.isWebGPUBackend?'\"'WebGPU':'WebGL2 compatibility'} · Three.js r180 · Rapier 0.19.3 · \"'${game.enemies.length} creatures · ${Math.floor(game.time)}s simulated · ${net.kind} · ${net.stats.sent} sent / ${net.stats.received} received</p><div class=\"panel-footer\"><button class=\"secondary\" data-action=\"reset-tuning\">Reset defaults</button><button class=\"primary\" data-action=\"pause\">Done <span>→</span></button></div>`,true);if(!isAuthority())$$('\"'#panel button,#panel input').forEach(el=>{if(el.dataset.action\"'!=='\"'pause'&&el.dataset.action\"'!=='\"'back')el.disabled=true})}\nfunction grant(id){const p=localPlayer();if(\"'!p||!isAuthority())return;const i=game.items.find(i=>i.id===id&&!i.banked);if(!i)return;if(p.carry)game.drop(p);if(i.holder!==null){const holder=game.players.find(p=>p.id===i.holder);if(holder)holder.carry=null}i.holder=p.id;i.f=p.f;p.carry=i.id;game.revision++;}\nfunction showEnd(won){if(hubInfo)return;const minutes=Math.floor(game.time/60),seconds=Math.floor(game.time%60).toString().padStart(2,'\"'0');const score=game.banked.length*1000+Math.max(0,Math.floor(1200-game.time*1.2))-game.hits*80;const best=safeRead('creaks-best',0);if(won&&score>best)safeWrite('creaks-best',score);if(won){try{localStorage.removeItem(SAVE_KEY)}catch{}}previousScreen='game';openPanel('ending',header(won?'THE LAST CREAK':'THE CANDLE GOES OUT',won?'You made it out.':'The house keeps you.')+\"'`<p>${won?'\"'The urn is whole. Behind you, a window goes dark.<br>Somewhere upstairs, a floorboard creaks.':'You were so close to remembering the way.<br>There is always another match. Another night.'}</p><div class=\\\"stats-grid\\\"><div><strong>\"'${minutes}:${seconds}</strong><span>Time in the house</span></div><div><strong>${game.banked.length} / 3</strong><span>Memories recovered</span></div><div><strong>${game.matchesUsed}</strong><span>Matches struck</span></div><div><strong>${game.hits}</strong><span>Nerves lost</span></div></div><p class=\"small-print\">${devUsed?'\"'Developer tools were used.':won?'Night score '+score+' · Best '+Math.max(best,score):'Tip: the scepter repels ghosts. A sheltered match keeps spiders away.'}</p><div class=\\\"panel-footer\\\"><button class=\\\"secondary\\\" data-action=\\\"quit\\\">Title screen</button><button class=\\\"primary\\\" data-action=\\\"restart\\\">\"'${won?'\"'Another night':'Try again'} <span>→</span></button></div>\"'`)}\nfunction updateHUD(){const p=localPlayer()||game.players[0];if(!p)return;const r=roomAt(p.x,p.z);$('\"'#floorLabel').textContent=\"'`FLOOR ${p.f+1} / 4 · ${FLOOR_NAMES[p.f].toUpperCase()}`;$('\"'#roomLabel').textContent=ROOM_NAMES[p.f][r];\"'$('\"'#objective').textContent=game.banked.length===3?'The front door is open. Leave the house.':\"'!game.unlocked?'\"'Find the urn’s lip. Seek the brass key.':\"'`Return the three fragments to the foyer · ${game.banked.length}/3`;\n $('\"'#urnPips').innerHTML=[0,1,2].map(i=>\"'`<i class=\"urn-pip ${game.banked.includes('\"'shard'+i)?'filled':''}\\\"></i>\"'`).join('\"'');\"'$('\"'#nerves').innerHTML=[0,1,2,3,4].map(i=>\"'`<span class=\"${p.health>i?'\"'':'empty'}\\\">◆</span>\"'`).join('\"'');\"'$('\"'#nerves').setAttribute('aria-label',p.health+' nerves remaining');\"'$('\"'#matches').textContent=p.matches;\"'$('\"'#flameBar').style.width=(p.match/game.tuning.matchDuration*100)+'%';\"'$('\"'#carryName').textContent=p.carry?ITEM_NAMES[p.carry]:'Nothing. Yet.';\"'$('\"'#carryIcon').textContent=p.carry==='key'?'⚿':p.carry==='ward'?'✧':p.carry?'◈':'◇';\n const near=game.nearest(p);\"'$('\"'#contextPrompt').innerHTML=near?glyph('interact')+escapeHTML(near.label):p.match===0?glyph('match')+'Strike a match':'';\"'$('\"'#windWarning').classList.toggle('hidden',game.time%game.tuning.windInterval<game.tuning.windInterval-7);\"'$('\"'#teamList').innerHTML=game.players.filter(o=>o.id\"'!==p.id).map(o=>`<div class=\"teammate\"><span style=\"color:${o.color}\">●</span><span>${escapeHTML(o.name)} · ${o.f===p.f?'\"'here':'floor '+(o.f+1)}\"'${o.carry?'\"' · '+escapeHTML(ITEM_NAMES[o.carry].replace('The ','')):''}</span></div>\"'`).join('\"'');\n if(lastInput==='touch'&&screen==='game'&&near){\"'$('\"'#touchAction').textContent=near.label;\"'$('\"'#touchAction').classList.remove('hidden')}else \"'$('\"'#touchAction').classList.add('hidden');if(performance.now()>toastUntil)\"'$('\"'#toast').classList.remove('show');}\nfunction processEvents(){const events=game.events.splice(0);for(const e of events){if(net.isHost&&net.kind\"'!=='\"'solo')net.eventQueue.push({...e,seq:++net.seq});handleEvent(e)}if(net.eventQueue.length>30)net.eventQueue.splice(0,net.eventQueue.length-30)}\nfunction handleEvent(e){if(e.id\"'!==undefined&&e.id!==net.me&&['\"'note','hint'].includes(e.type))return;if(['match','pickup','bank','pulse','hit','snuff','stair','wind','rest','note','unlock','lose','win'].includes(e.type))audio.play(e.type);if(['pickup','bank','unlock','hint','wind','hit','snuff','rest','finale'].includes(e.type)&&e.text&&\"'!attract)toast(e.text,e.type==='\"'finale'?6:3.5);if(e.type==='note'&&\"'!attract){previousScreen='\"'game';openPanel('note',header('SOMEONE WAS HERE BEFORE YOU','A forgotten note')+\"'`<p class=\"paper-note\">${escapeHTML(e.text)}</p><div class=\"panel-footer\"><button class=\"primary\" data-action=\"resume\">Fold it away <span>→</span></button></div>`)}if(e.type==='\"'hit'){view.shake=.4;const pad=navigator.getGamepads?.()[0];pad?.vibrationActuator?.playEffect?.('dual-rumble',{duration:180,strongMagnitude:.5,weakMagnitude:.3}).catch?.(()=>{})}if(e.type==='pulse'||e.type==='bank')effect(e.type,game.players.find(p=>p.id===e.id));if(e.type==='bank'&&net.kind==='solo'&&\"'!attract)safeWrite(SAVE_KEY,game.snapshot());}\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"cat >> main.mjs <<'EOF'\n\nconst CREDITS = /* CREDITS */ null;\nconst net={kind:'solo',isHost:true,me:0,roster:[{id:0,name:'You',color:'#efc477'}],inputs:{},inputAt:{},bc:null,room:'',uid:crypto.randomUUID(),peers:new Map(),channels:new Map(),pending:null,pc:null,started:false,seq:0,seenSeq:0,eventQueue:[],stats:{sent:0,received:0},status:''};\nconst SEAT_COLORS=['#efc477','#80d1be','#bba4db','#e99782'];\nfunction localPlayer(){if(hubInfo?.server)return null;return game.players.find(p=>p.id===net.me)||(\"'!hubInfo&&net.kind==='\"'solo'?game.players[0]:null)}\nfunction isAuthority(){return net.isHost}\nfunction escapeHTML(text){return String(text).replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]))}\nfunction glyph(action){const ps={interact:'×',drop:'○',pulse:'□',map:'△',match:'R2',hush:'L1',pause:'☰',move:'L',aim:'R'},xb={interact:'A',drop:'B',pulse:'X',map:'Y',match:'RT',hush:'LB',pause:'☰',move:'L',aim:'R'},kb={interact:'E',drop:'Q',pulse:'F',map:'Tab',match:'Space',hush:'Shift',pause:'Esc',move:'WASD',aim:'Mouse'};if(lastInput==='gamepad'){const t=(settings.glyphs==='xbox'?xb:ps)[action];return \"'`<span class=\"${t.length===1?'\"'glyph':'key glyph'}\\\">\"'${t}</span>`}return `<kbd>${kb[action]}</kbd>`}\nfunction markInput(type){const now=performance.now();lastActivity=now;if(lastInput!==type){lastInput=type;document.body.classList.toggle('\"'touch',type==='touch');updatePrompts();if(screen==='help')showHelp();}if(attract){endAttract();return true}return false}\nfunction updatePrompts(){if(\"'!game)return;$('\"'#titleInputHint').textContent=lastInput==='gamepad'?'Left stick to wander · R2 to light the way':'WASD to wander · Space to light the way';\"'$('\"'#controlHints').innerHTML=\"'`${glyph('\"'match')}Strike a match<br>\"'${glyph('\"'hush')}Hush &nbsp; \"'${glyph('\"'map')}House map\"'`;}\nfunction titleButtons(){const save=safeRead(SAVE_KEY,null);$('\"'#titleButtons').innerHTML=\"'`<button class=\"primary\" data-action=\"start\">Enter the house <span>→</span></button>${save?.status==='\"'playing'?'<button class=\\\"secondary\\\" data-action=\\\"continue\\\">Continue the night <span style=\\\"float:right;color:var(--gold)\\\">'+save.banked.length+'/3</span></button>':''}<div class=\\\"button-row\\\"><button class=\\\"secondary\\\" data-action=\\\"coop\\\">Play together</button><button class=\\\"secondary\\\" data-action=\\\"help\\\">How to play</button></div>\"'`;}\nfunction setTitle(){screen='\"'title';paused=false;attract=false;game.attract=false;net.started=false;\"'$('\"'#titleScreen').classList.remove('hidden');\"'$('\"'#hud').classList.add('hidden');\"'$('\"'#attractBanner').classList.add('hidden');\"'$('\"'#overlay').classList.add('hidden');\"'$('\"'#touchAction').classList.add('hidden');titleButtons();lastActivity=performance.now();menuIndex=0;resize();}\nfunction newNight(continuing=false){if(hubInfo)return;const save=continuing?safeRead(SAVE_KEY,null):null;const seats=net.kind==='solo'?[{id:0,name:'You',color:SEAT_COLORS[0]}]:net.roster;game.reset(seats);game.tuning.enemySpeed=settings.difficulty==='quiet'?.65:settings.difficulty==='dire'?1.3:1;if(save&&net.kind==='solo')game.apply(save);screen='game';paused=false;net.started=true;netEnded=false;\"'$('\"'#titleScreen').classList.add('hidden');\"'$('\"'#hud').classList.remove('hidden');\"'$('\"'#overlay').classList.add('hidden');\"'$('\"'#attractBanner').classList.add('hidden');lastRevision=-1;lastRoom='';resize();updatePrompts();toast('Three pieces of an urn. One way out.',5);audio.unlock();}\nfunction toast(text,duration=3){if(\"'!text)return;$('\"'#toast').textContent=text;\"'$('\"'#toast').classList.add('show');toastUntil=performance.now()+duration*1000;}\nfunction openPanel(name,html,wide=false){if(\"'!['\"'title','loading'].includes(screen)&&screen\"'!=='\"'attract')previousScreen='game';else if(screen==='title')previousScreen='title';screen=name;paused=true;\"'$('\"'#overlay').classList.remove('hidden');\"'$('\"'#panel').classList.toggle('wide',wide);\"'$('\"'#panel').innerHTML=html;menuIndex=0;updateFocus(false);\"'$('\"'#touchAction').classList.add('hidden');}\nfunction header(eye,title){return \"'`<div class=\"panel-header\"><div><p class=\"eyebrow\">${eye}</p><h2>${title}</h2></div><button class=\"close-button\" data-action=\"back\" aria-label=\"Back\">×</button></div>`}\nfunction closePanel(){if(hubEnded)return;if(previousScreen==='\"'title'){setTitle();return}screen='game';paused=false;\"'$('\"'#overlay').classList.add('hidden');resize();}\nfunction showPause(){if(hubEnded||screen==='title')return;previousScreen='game';openPanel('pause',header('CATCH YOUR BREATH','The house can wait.')+\"'`<p>${FLOOR_NAMES[localPlayer()?.f||0]} · ${game.banked.length} of 3 pieces returned${net.kind!=='\"'solo'?'<br><small>The shared house keeps moving while your menu is open.</small>':''}</p><div class=\\\"menu-stack\\\"><button class=\\\"primary\\\" data-action=\\\"resume\\\">Back to the house <span>→</span></button><button class=\\\"menu-button\\\" data-action=\\\"map\\\">The house map <em>\"'${lastInput==='\"'gamepad'?'△':'Tab'}</em></button><button class=\\\"menu-button\\\" data-action=\\\"settings\\\">Settings</button><button class=\\\"menu-button\\\" data-action=\\\"help\\\">How to play</button><button class=\\\"menu-button\\\" data-action=\\\"dev\\\">Developer tools</button>\"'${hubInfo?'\"'':'<button class=\\\"menu-button\\\" data-action=\\\"quit\\\">Save & return to title</button>'}</div>\"'`)}\nfunction showHelp(){const p=screen==='\"'title'?'title':previousScreen;openPanel('help',header('A QUICK WORD OF WARNING','Mind your match.')+\"'`<div class=\"instruction\"><span class=\"num\">01</span><div><strong>Put the past back together.</strong><p>Find three urn fragments upstairs. Carry each to the plinth in the foyer. Then escape through the front door.</p></div></div><div class=\"instruction\"><span class=\"num\">02</span><div><strong>One hand. Difficult choices.</strong><p>Carry a key, a fragment, or the scepter. Taking another swaps them. The brass key opens the upper library stair permanently.</p></div></div><div class=\"instruction\"><span class=\"num\">03</span><div><strong>The dark is listening.</strong><p>Matches reveal your way and frighten spiders. Ghosts follow flame; bats put it out. Hush shelters a match from wind. Central candles refill matches and restore a nerve once per floor.</p></div></div><div class=\"controls-grid\"><div>${glyph('\"'move')}Move</div><div>\"'${glyph('\"'match')}Strike match</div><div>\"'${glyph('\"'interact')}Take / use / stairs</div><div>\"'${glyph('\"'drop')}Drop object</div><div>\"'${glyph('\"'hush')}Hold to hush</div><div>\"'${glyph('\"'pulse')}Scepter pulse</div><div>\"'${glyph('\"'map')}Map</div><div>\"'${glyph('\"'pause')}Pause</div></div><p class=\\\"small-print\\\">Mouse: aim with the pointer, click nearby objects to use them, right-click to hush. Touch: drag the left half to walk; tap the right half to use or light. Flame and scepter protection assist automatically.</p><div class=\\\"panel-footer\\\"><button class=\\\"primary\\\" data-action=\\\"back\\\">Understood <span>→</span></button></div>\"'`);previousScreen=p;}\nfunction settingRange(key,label,min,max,step,value,caption='\"''){return \"'`<div class=\"setting-row\"><label for=\"set-${key}\">${label}${caption?`<small>${caption}</small>`:'\"''}</label><div><output id=\\\"out-\"'${key}\">${Math.round(value*100)}%</output><input id=\"set-${key}\" data-setting=\"${key}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${value}\" aria-label=\"${label}\"></div></div>`}\nfunction showSettings(){const p=screen==='\"'title'?'title':previousScreen;openPanel('settings',header('MAKE YOURSELF AT HOME','Settings')+settingRange('music','Music',0,1,.01,settings.music,'An original midnight waltz.')+settingRange('sfx','Effects & voices',0,1,.01,settings.sfx)+\"'`<div class=\"setting-row\"><label for=\"set-glyphs\">Controller symbols</label><select id=\"set-glyphs\" data-setting=\"glyphs\"><option value=\"ps\" ${settings.glyphs==='\"'ps'?'selected':''}>PlayStation · × ○ □ △</option><option value=\\\"xbox\\\" \"'${settings.glyphs==='\"'xbox'?'selected':''}>Xbox · A B X Y</option></select></div><div class=\\\"setting-row\\\"><label for=\\\"set-difficulty\\\">The house’s temper<small>Applies immediately in your own house.</small></label><select id=\\\"set-difficulty\\\" data-setting=\\\"difficulty\\\"><option value=\\\"quiet\\\" \"'${settings.difficulty==='\"'quiet'?'selected':''}>A quiet visit</option><option value=\\\"restless\\\" \"'${settings.difficulty==='\"'restless'?'selected':''}>Restless house</option><option value=\\\"dire\\\" \"'${settings.difficulty==='\"'dire'?'selected':''}>Very bad address</option></select></div><div class=\\\"setting-row\\\"><label>Camera motion</label><button class=\\\"toggle\\\" data-action=\\\"motion\\\">\"'${settings.motion?'\"'Gentle drift':'Reduced motion'}</button></div><div class=\\\"setting-row\\\"><label>Brighter darkness</label><button class=\\\"toggle\\\" data-action=\\\"contrast\\\">\"'${settings.contrast?'\"'On':'Off'}</button></div><div class=\\\"panel-footer\\\"><button class=\\\"secondary\\\" data-action=\\\"fullscreen\\\">Fullscreen</button><button class=\\\"primary\\\" data-action=\\\"back\\\">Done <span>→</span></button></div>\"'`);previousScreen=p;}\nlet aboutTab=0;\nfunction showAbout(tab=aboutTab){aboutTab=tab;const p=screen==='\"'title'?'title':previousScreen;const names=['Source information','Testing feedback','Engine feedback','Prompt feedback'],data=tab===0?CREDITS.sourceInformation:tab===1?CREDITS.testingFeedback:tab===2?CREDITS.engineFeedback:CREDITS.promptFeedback;let content;if(tab===0)content=Object.entries(data).map(([k,v])=>\"'`<p><b>${escapeHTML(k.charAt(0).toUpperCase()+k.slice(1))}</b><br>${escapeHTML(v)}</p>`).join('\"'');else content=data.map((v,i)=>\"'`<p><b>${i+1}.</b> ${escapeHTML(v)}</p>`).join('\"'');openPanel('about',header('THE PEOPLE IN THE WALLS','About & credits')+\"'`<div class=\"tabs\">${names.map((n,i)=>`<button data-action=\"about-${i}\" class=\"${i===tab?'\"'active':''}\\\">\"'${n}</button>`).join('\"'')}</div><div class=\\\"credits-text\\\">\"'${tab===0?'\"'<p><b>The House of Creaks</b><br>An original game created in code. Inspired by Haunted House (Atari, 1982).<br>Designed, modeled, animated, composed and programmed by OpenAI gpt-6.1-sol.</p>':''}\"'${content}${tab===0?'\"'<p><b>Libraries</b><br>Three.js (MIT), Rapier (Apache-2.0), AI Hub client 1.4.0. All visuals and sound are procedural. No source assets or audio files are used.</p>':''}</div><div class=\\\"panel-footer\\\"><button class=\\\"primary\\\" data-action=\\\"back\\\">Back <span>→</span></button></div>\"'`,true);previousScreen=p;}\nfunction showMap(f=localPlayer()?.f||0){mapFloor=clamp(f,0,3);if(screen==='\"'title')return;previousScreen='game';const p=localPlayer(),known=game.notes.includes(0)||game.reveal;openPanel('map',header('A VERY UNRELIABLE FLOOR PLAN',FLOOR_NAMES[mapFloor])+\"'`<div class=\"tabs\">${FLOOR_NAMES.map((n,i)=>`<button data-action=\"map-${i}\" class=\"${mapFloor===i?'\"'active':''}\\\">\"'${i+1} · ${n.replace('\"'The ','')}</button>\"'`).join('\"'')}</div><div class=\\\"map-grid\\\">\"'${ROOM_NAMES[mapFloor].map((n,r)=>{const seen=game.visited[mapFloor].includes(r)||game.reveal;const current=p?.f===mapFloor&&roomAt(p.x,p.z)===r;const item=game.items.find(i=>i.f===mapFloor&&roomAt(i.x,i.z)===r&&!i.banked&&i.holder===null);const stairs=STAIRS.filter(s=>s.f===mapFloor&&s.r===r).map(s=>s.to>s.f?'\"'↑ Stairs up':'↓ Stairs down').join(' · ');return \"'`<div class=\"map-room ${seen?'\"'seen':''} \"'${current?'\"'current':''}\\\">\"'${seen||known?n:'\"'Unexplored'}\"'${current?'\"'<i>●</i>':''}<span>\"'${item&&(known||game.reveal||seen)?escapeHTML(ITEM_NAMES[item.id]):stairs|| (r===4?'\"'✧ Safe candle':'')}</span></div>\"'`}).join('\"'')}</div><p class=\\\"map-caption\\\">● You &nbsp; · &nbsp; A candle waits in each central landing. \"'${known?'\"'The study’s note marks the fragments.':'Rooms appear as you explore.'}</p><div class=\\\"panel-footer\\\"><button class=\\\"secondary\\\" data-action=\\\"map-prev\\\">← Floor</button><button class=\\\"secondary\\\" data-action=\\\"map-next\\\">Floor →</button><button class=\\\"primary\\\" data-action=\\\"resume\\\">Back <span>→</span></button></div>\"'`,true)}\nfunction devRange(k,label,min,max,step){return `<div class=\"setting-row\"><label for=\"dev-${k}\">${label}</label><div><output id=\"devout-${k}\">${game.tuning[k]}</output><input id=\"dev-${k}\" data-tuning=\"${k}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${game.tuning[k]}\" aria-label=\"${label}\"></div></div>`}\nfunction showDev(){previousScreen='\"'game';devUsed=true;openPanel('dev',header('THE KEYS TO THE HOUSE','Developer tools')+\"'`<p class=\"small-print\">Live balance. Changes take effect immediately.${!isAuthority()?'\"' The host controls this shared house.':''}</p><div class=\\\"dev-grid\\\">\"'${devRange('\"'speed','Walking speed',1,10,.1)}\"'${devRange('\"'enemySpeed','Creature pace',0,3,.05)}\"'${devRange('\"'matchDuration','Match life · seconds',3,60,1)}\"'${devRange('\"'windInterval','Wind interval · seconds',10,120,1)}\"'${devRange('\"'damage','Nerve loss per hit',0,5,.5)}\"'${devRange('\"'timeScale','Time scale',.25,3,.05)}</div><div class=\\\"dev-actions\\\"><button data-action=\\\"god\\\">Invulnerable: \"'${game.god?'\"'ON':'OFF'}</button><button data-action=\\\"reveal\\\">Reveal map: \"'${game.reveal?'\"'ON':'OFF'}</button><button data-action=\\\"collisions\\\">Collision overlay: \"'${debugCollisions?'\"'ON':'OFF'}</button><button data-action=\\\"refill\\\">Refill nerves & matches</button><button data-action=\\\"floor-down\\\">Teleport floor ↓</button><button data-action=\\\"floor-up\\\">Teleport floor ↑</button><button data-action=\\\"grant-key\\\">Bring brass key</button><button data-action=\\\"grant-ward\\\">Bring scepter</button><button data-action=\\\"grant-shard\\\">Bring next fragment</button></div><p class=\\\"small-print\\\">\"'${renderer.backend?.isWebGPUBackend?'\"'WebGPU':'WebGL2 compatibility'} · Three.js r180 · Rapier 0.19.3 · \"'${game.enemies.length} creatures · ${Math.floor(game.time)}s simulated · ${net.kind} · ${net.stats.sent} sent / ${net.stats.received} received</p><div class=\"panel-footer\"><button class=\"secondary\" data-action=\"reset-tuning\">Reset defaults</button><button class=\"primary\" data-action=\"pause\">Done <span>→</span></button></div>`,true);if(!isAuthority())$$('\"'#panel button,#panel input').forEach(el=>{if(el.dataset.action\"'!=='\"'pause'&&el.dataset.action\"'!=='\"'back')el.disabled=true})}\nfunction grant(id){const p=localPlayer();if(\"'!p||!isAuthority())return;const i=game.items.find(i=>i.id===id&&!i.banked);if(!i)return;if(p.carry)game.drop(p);if(i.holder!==null){const holder=game.players.find(p=>p.id===i.holder);if(holder)holder.carry=null}i.holder=p.id;i.f=p.f;p.carry=i.id;game.revision++;}\nfunction showEnd(won){if(hubInfo)return;const minutes=Math.floor(game.time/60),seconds=Math.floor(game.time%60).toString().padStart(2,'\"'0');const score=game.banked.length*1000+Math.max(0,Math.floor(1200-game.time*1.2))-game.hits*80;const best=safeRead('creaks-best',0);if(won&&score>best)safeWrite('creaks-best',score);if(won){try{localStorage.removeItem(SAVE_KEY)}catch{}}previousScreen='game';openPanel('ending',header(won?'THE LAST CREAK':'THE CANDLE GOES OUT',won?'You made it out.':'The house keeps you.')+\"'`<p>${won?'\"'The urn is whole. Behind you, a window goes dark.<br>Somewhere upstairs, a floorboard creaks.':'You were so close to remembering the way.<br>There is always another match. Another night.'}</p><div class=\\\"stats-grid\\\"><div><strong>\"'${minutes}:${seconds}</strong><span>Time in the house</span></div><div><strong>${game.banked.length} / 3</strong><span>Memories recovered</span></div><div><strong>${game.matchesUsed}</strong><span>Matches struck</span></div><div><strong>${game.hits}</strong><span>Nerves lost</span></div></div><p class=\"small-print\">${devUsed?'\"'Developer tools were used.':won?'Night score '+score+' · Best '+Math.max(best,score):'Tip: the scepter repels ghosts. A sheltered match keeps spiders away.'}</p><div class=\\\"panel-footer\\\"><button class=\\\"secondary\\\" data-action=\\\"quit\\\">Title screen</button><button class=\\\"primary\\\" data-action=\\\"restart\\\">\"'${won?'\"'Another night':'Try again'} <span>→</span></button></div>\"'`)}\nfunction updateHUD(){const p=localPlayer()||game.players[0];if(!p)return;const r=roomAt(p.x,p.z);$('\"'#floorLabel').textContent=\"'`FLOOR ${p.f+1} / 4 · ${FLOOR_NAMES[p.f].toUpperCase()}`;$('\"'#roomLabel').textContent=ROOM_NAMES[p.f][r];\"'$('\"'#objective').textContent=game.banked.length===3?'The front door is open. Leave the house.':\"'!game.unlocked?'\"'Find the urn’s lip. Seek the brass key.':\"'`Return the three fragments to the foyer · ${game.banked.length}/3`;\n $('\"'#urnPips').innerHTML=[0,1,2].map(i=>\"'`<i class=\"urn-pip ${game.banked.includes('\"'shard'+i)?'filled':''}\\\"></i>\"'`).join('\"'');\"'$('\"'#nerves').innerHTML=[0,1,2,3,4].map(i=>\"'`<span class=\"${p.health>i?'\"'':'empty'}\\\">◆</span>\"'`).join('\"'');\"'$('\"'#nerves').setAttribute('aria-label',p.health+' nerves remaining');\"'$('\"'#matches').textContent=p.matches;\"'$('\"'#flameBar').style.width=(p.match/game.tuning.matchDuration*100)+'%';\"'$('\"'#carryName').textContent=p.carry?ITEM_NAMES[p.carry]:'Nothing. Yet.';\"'$('\"'#carryIcon').textContent=p.carry==='key'?'⚿':p.carry==='ward'?'✧':p.carry?'◈':'◇';\n const near=game.nearest(p);\"'$('\"'#contextPrompt').innerHTML=near?glyph('interact')+escapeHTML(near.label):p.match===0?glyph('match')+'Strike a match':'';\"'$('\"'#windWarning').classList.toggle('hidden',game.time%game.tuning.windInterval<game.tuning.windInterval-7);\"'$('\"'#teamList').innerHTML=game.players.filter(o=>o.id\"'!==p.id).map(o=>`<div class=\"teammate\"><span style=\"color:${o.color}\">●</span><span>${escapeHTML(o.name)} · ${o.f===p.f?'\"'here':'floor '+(o.f+1)}\"'${o.carry?'\"' · '+escapeHTML(ITEM_NAMES[o.carry].replace('The ','')):''}</span></div>\"'`).join('\"'');\n if(lastInput==='touch'&&screen==='game'&&near){\"'$('\"'#touchAction').textContent=near.label;\"'$('\"'#touchAction').classList.remove('hidden')}else \"'$('\"'#touchAction').classList.add('hidden');if(performance.now()>toastUntil)\"'$('\"'#toast').classList.remove('show');}\nfunction processEvents(){const events=game.events.splice(0);for(const e of events){if(net.isHost&&net.kind\"'!=='\"'solo')net.eventQueue.push({...e,seq:++net.seq});handleEvent(e)}if(net.eventQueue.length>30)net.eventQueue.splice(0,net.eventQueue.length-30)}\nfunction handleEvent(e){if(e.id\"'!==undefined&&e.id!==net.me&&['\"'note','hint'].includes(e.type))return;if(['match','pickup','bank','pulse','hit','snuff','stair','wind','rest','note','unlock','lose','win'].includes(e.type))audio.play(e.type);if(['pickup','bank','unlock','hint','wind','hit','snuff','rest','finale'].includes(e.type)&&e.text&&\"'!attract)toast(e.text,e.type==='\"'finale'?6:3.5);if(e.type==='note'&&\"'!attract){previousScreen='\"'game';openPanel('note',header('SOMEONE WAS HERE BEFORE YOU','A forgotten note')+\"'`<p class=\"paper-note\">${escapeHTML(e.text)}</p><div class=\"panel-footer\"><button class=\"primary\" data-action=\"resume\">Fold it away <span>→</span></button></div>`)}if(e.type==='\"'hit'){view.shake=.4;const pad=navigator.getGamepads?.()[0];pad?.vibrationActuator?.playEffect?.('dual-rumble',{duration:180,strongMagnitude:.5,weakMagnitude:.3}).catch?.(()=>{})}if(e.type==='pulse'||e.type==='bank')effect(e.type,game.players.find(p=>p.id===e.id));if(e.type==='bank'&&net.kind==='solo'&&\"'!attract)safeWrite(SAVE_KEY,game.snapshot());}\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_25","type":"agent_message","text":"The mansion and creatures are taking shape. Explorers, ghosts, bats, spiders, and haunted props use Three.js animation clips; lighting and ink outlines come from code. The menus now include a room map, save/continue, accessibility settings, credits, and live developer sliders.\n"}}
{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"cat >> main.mjs <<'EOF'\n\nfunction resetNetwork(){net.bc?.close();for(const c of net.channels.values())try{c.close()}catch{}net.pc?.close();net.pending?.pc?.close();net.kind='solo';net.isHost=true;net.me=0;net.roster=[{id:0,name:'You',color:SEAT_COLORS[0]}];net.inputs={};net.inputAt={};net.peers.clear();net.channels.clear();net.pending=null;net.bc=null;net.room='';net.started=false;net.status='';netEnded=false;}\nfunction sendPacket(data,to=null){if(hubEnded||netEnded)return;net.stats.sent++;if(hubInfo){AIHub.send(data,to===null?{reliable:data.type\"'!=='\"'input'}:{to,reliable:data.type\"'!=='\"'input'});return}if(net.kind==='solo')return;if(net.bc)net.bc.postMessage({uid:net.uid,from:net.me,to,data});if(net.isHost){for(const [id,c] of net.channels)if((to===null||to===id)&&c.readyState==='open')c.send(JSON.stringify(data))}else{const c=net.channels.get(0);if(c?.readyState==='open')c.send(JSON.stringify(data))}}\nfunction addGuest(uid,channel=null){if(\"'!net.isHost)return;let id=net.peers.get(uid);if(id===undefined){id=[1,2,3].find(i=>!net.roster.some(p=>p.id===i));if(id===undefined){net.status='\"'The house already has four guests.';return}net.peers.set(uid,id);const seat={id,name:'Guest '+(id+1),color:SEAT_COLORS[id]};net.roster.push(seat);game.addPlayer(seat)}if(channel)net.channels.set(id,channel);const welcome={type:'welcome',id,roster:net.roster,started:net.started};sendPacket(welcome,id);sendPacket({type:'state',snapshot:game.snapshot(),started:net.started,events:[]},id);net.status=net.roster.length+' guests in the house.';if(['coop','lobby'].includes(screen))showCoop('lobby');return id}\nfunction handlePacket(data,from){if(\"'!data||typeof data!=='\"'object'||hubEnded||netEnded)return;net.stats.received++;if(data.type==='hello'&&net.isHost&&\"'!hubInfo){addGuest(data.uid);return}if(data.type==='\"'welcome'&&\"'!hubInfo&&!net.isHost){net.me=data.id;net.roster=data.roster;net.status='\"'Connected. Waiting for the host to enter the house.';if(screen==='coop'||screen==='lobby')showCoop('lobby');return}\n if(data.type==='input'&&net.isHost){if(\"'!game.players.some(p=>p.id===from))return;const v=data.input||{};net.inputs[from]={x:clamp(Number(v.x)||0,-1,1),z:clamp(Number(v.z)||0,-1,1),angle:Number.isFinite(v.angle)?v.angle:undefined,hush:!!v.hush,interact:!!v.interact,match:!!v.match,drop:!!v.drop,pulse:!!v.pulse};net.inputAt[from]=performance.now();return}\n if(data.type==='\"'state'&&\"'!net.isHost){if(hubInfo&&from!==hubInfo.host)return;game.apply(data.snapshot);game.events=[];for(const e of data.events||[])if(e.seq>net.seenSeq){net.seenSeq=e.seq;handleEvent(e)}if(data.started&&!net.started){net.started=true;screen='\"'game';paused=false;\"'$('\"'#titleScreen').classList.add('hidden');\"'$('\"'#hud').classList.remove('hidden');\"'$('\"'#overlay').classList.add('hidden');resize()}return}\n if(data.type==='bye'){if(net.isHost){game.removePlayer(from);net.roster=net.roster.filter(p=>p.id\"'!==from)}else{net.status='\"'The host has left the house.';toast(net.status,8);netEnded=true;if(\"'!hubInfo)showDisconnected()}return}}\nfunction openBroadcast(room,host){resetNetwork();net.kind='\"'standalone';net.isHost=host;net.me=host?0:-1;net.room=room.toUpperCase().replace(/[\"'^A-Z0-9]/g,'\"'').slice(0,6);net.bc=new BroadcastChannel('creaks-room-'+net.room);net.bc.onmessage=e=>{const packet=e.data;if(packet.uid===net.uid)return;if(packet.to\"'!==null&&packet.to!==undefined&&packet.to!==net.me)return;if(packet.data?.type==='\"'hello'&&host){addGuest(packet.uid);return}handlePacket(packet.data,host?net.peers.get(packet.uid):0)};if(host){game.reset(net.roster);net.status='Room open. Friends can join in another tab at this address.'}else{net.roster=[];net.status='Knocking on room '+net.room+'…';net.bc.postMessage({uid:net.uid,from:-1,to:null,data:{type:'hello',uid:net.uid}})}showCoop('lobby')}\nfunction encodeSignal(description){return btoa(JSON.stringify(description))}\nfunction decodeSignal(code){return JSON.parse(atob(code.trim()))}\nasync function gatherICE(pc){if(pc.iceGatheringState==='complete')return;await new Promise(resolve=>{const timer=setTimeout(resolve,5500);pc.addEventListener('icegatheringstatechange',()=>{if(pc.iceGatheringState==='complete'){clearTimeout(timer);resolve()}},{once:false})})}\nfunction wireChannel(channel,pc,host){let id=null;channel.addEventListener('open',()=>{if(host){id=addGuest('rtc-'+crypto.randomUUID(),channel);net.status='Friend connected. You can invite another, or enter the house.'}else{net.channels.set(0,channel);channel.send(JSON.stringify({type:'hello',uid:net.uid}));net.status='Connected. Waiting for the host.'}if(['coop','lobby'].includes(screen))showCoop('lobby')});channel.addEventListener('message',e=>{try{handlePacket(JSON.parse(e.data),host?id:0)}catch{}});channel.addEventListener('close',()=>{if(host&&id\"'!==null){game.removePlayer(id);net.roster=net.roster.filter(p=>p.id!==id);net.channels.delete(id)}else if(!host&&net.kind!=='\"'solo'){netEnded=true;showDisconnected()}});pc.addEventListener('connectionstatechange',()=>{if(pc.connectionState==='failed'){net.status='Connection failed. Create a fresh invitation and try again.';if(screen==='coop'||screen==='lobby')showCoop('remote')}})}\nasync function createOffer(){if(net.kind==='solo'||\"'!net.isHost){resetNetwork();net.kind='\"'standalone';net.isHost=true;game.reset(net.roster)}if(net.roster.length>=4){net.status='The house is full.';showCoop('lobby');return}const pc=new RTCPeerConnection({iceServers:[{urls:'stun:stun.l.google.com:19302'}]});const channel=pc.createDataChannel('creaks',{ordered:true});net.pending={pc,channel};wireChannel(channel,pc,true);net.status='Preparing an invitation…';showCoop('remote');try{await pc.setLocalDescription(await pc.createOffer());await gatherICE(pc);net.pending.offer=encodeSignal(pc.localDescription);net.status='Invitation ready. Send it to one friend.';showCoop('remote')}catch(e){net.status='Could not make an invitation: '+e.message;showCoop('remote')}}\nasync function acceptOffer(code){try{const desc=decodeSignal(code);if(desc.type\"'!=='\"'offer')throw new Error('This is not an invitation.');resetNetwork();net.kind='standalone';net.isHost=false;net.me=-1;net.roster=[];const pc=new RTCPeerConnection({iceServers:[{urls:'stun:stun.l.google.com:19302'}]});net.pc=pc;pc.ondatachannel=e=>wireChannel(e.channel,pc,false);await pc.setRemoteDescription(desc);await pc.setLocalDescription(await pc.createAnswer());await gatherICE(pc);net.answer=encodeSignal(pc.localDescription);net.status='Reply ready. Send it back to the host.';showCoop('answer')}catch(e){net.status='Could not read the invitation: '+e.message;showCoop('remote')}}\nasync function acceptAnswer(code){try{const desc=decodeSignal(code);if(desc.type\"'!=='\"'answer')throw new Error('This is not a reply.');await net.pending.pc.setRemoteDescription(desc);net.status='Connecting to your friend…';showCoop('remote')}catch(e){net.status='Could not read the reply: '+e.message;showCoop('remote')}}\nfunction showDisconnected(){previousScreen='title';openPanel('disconnected',header('A DOOR CLOSES','The host has left.')+'<p>This shared night is over. Your own house is still waiting.</p><div class=\\\"panel-footer\\\"><button class=\\\"primary\\\" data-action=\\\"disconnect\\\">Back to title <span>→</span></button></div>')}\nlet coopPage='choose';\nfunction showCoop(page='choose'){coopPage=page;previousScreen='title';let body='';if(page==='choose'){body=\"'`<p>Explore one house together. Share the urn, watch each other’s backs, and try to leave with everyone accounted for.</p><div class=\"menu-stack\"><button class=\"primary\" data-action=\"local-host\">Open a same-browser room <span>→</span></button><button class=\"menu-button\" data-action=\"local-join\">Join a same-browser room</button><button class=\"menu-button\" data-action=\"remote\">Across devices · direct connection</button></div><p class=\"small-print\">1–4 guests. Same-browser rooms work between tabs at this exact address. Across devices uses WebRTC with invitation and reply codes. AI Hub sessions connect automatically.</p>`}\n if(page==='\"'join')body=\"'`<p>Ask the host for their six-letter room code. Open this game at the same address in another tab.</p><input id=\"roomCode\" type=\"text\" maxlength=\"6\" placeholder=\"ROOM CODE\" aria-label=\"Room code\"><div class=\"panel-footer\"><button class=\"secondary\" data-action=\"coop\">Back</button><button class=\"primary\" data-action=\"join-room\">Knock <span>→</span></button></div>`;\n if(page==='\"'lobby')body=\"'`${net.room?`<p>Same-browser room</p><div class=\"code-display\">${escapeHTML(net.room)}</div>`:'\"'<p>Your shared house is ready.</p>'}<div class=\\\"network-step\\\">\"'${net.roster.map(p=>`<p style=\"color:${p.color}\">● ${escapeHTML(p.name)} ${p.id===net.me?'\"'· you':''}</p>\"'`).join('\"'')||'<p>Waiting for a welcome…</p>'}</div><p class=\\\"network-status\\\">\"'${escapeHTML(net.status)}</p><div class=\"panel-footer\"><button class=\"secondary\" data-action=\"disconnect\">Disconnect</button>${net.isHost?'\"'<button class=\\\"primary\\\" data-action=\\\"start\\\">Enter together <span>→</span></button>':''}</div>\"'${!net.room&&net.isHost&&net.roster.length<4?'\"'<div class=\\\"panel-footer\\\"><button class=\\\"secondary\\\" data-action=\\\"create-offer\\\">Invite another friend</button></div>':''}\"'`;\n if(page==='\"'remote')body=\"'`<p>Send a private invitation, then paste your friend’s reply. Keep this page open. Each invitation connects one friend.</p><p class=\"network-status\">${escapeHTML(net.status)}</p><div class=\"network-step\"><b>HOST · Invite a friend</b><p>Create a code and send it to your friend by your usual messaging app.</p><button class=\"secondary\" data-action=\"create-offer\">${net.pending?.offer?'\"'New invitation':'Create invitation'}</button>\"'${net.pending?.offer?`<p>Your invitation</p><textarea id=\"offerCode\" readonly aria-label=\"Your invitation code\">${net.pending.offer}</textarea><button class=\"secondary\" data-action=\"copy-offer\">Copy invitation</button><p>Paste their reply here</p><textarea id=\"replyCode\" aria-label=\"Friend reply code\" placeholder=\"Reply code\"></textarea><button class=\"primary\" data-action=\"accept-answer\">Connect friend <span>→</span></button>`:'\"''}</div><div class=\\\"network-step\\\"><b>GUEST · Accept an invitation</b><p>Paste the host’s invitation below. You’ll get a reply to send back.</p><textarea id=\\\"incomingOffer\\\" aria-label=\\\"Host invitation code\\\" placeholder=\\\"Invitation code\\\"></textarea><button class=\\\"secondary\\\" data-action=\\\"accept-offer\\\">Make my reply</button></div><p class=\\\"small-print\\\">Direct connections depend on your networks allowing WebRTC. Some restrictive routers require a relay, which this self-contained game does not provide.</p><div class=\\\"panel-footer\\\"><button class=\\\"secondary\\\" data-action=\\\"coop\\\">Back</button>\"'${net.isHost&&net.kind!=='\"'solo'?'<button class=\\\"primary\\\" data-action=\\\"lobby\\\">Your guests →</button>':''}</div>\"'`;\n if(page==='\"'answer')body=\"'`<p>Send this reply to the host. Leave the game open while they connect you.</p><textarea id=\"answerCode\" readonly aria-label=\"Your reply code\">${net.answer||'\"''}</textarea><div class=\\\"panel-footer\\\"><button class=\\\"secondary\\\" data-action=\\\"copy-answer\\\">Copy reply</button></div><p class=\\\"network-status\\\">\"'${escapeHTML(net.status)}</p><div class=\"panel-footer\"><button class=\"secondary\" data-action=\"disconnect\">Cancel connection</button></div>`;\n openPanel('\"'coop',header('MISERY LOVES COMPANY','Bring a friend.')+body,true);previousScreen='title';}\nfunction disconnect(){if(net.kind\"'!=='\"'solo')sendPacket({type:'bye'});resetNetwork();setTitle()}\nconst hubConnection=AIHub.connect({mode:'shared-world',seats:[1,4]});\nasync function setupHub(){hubInfo=await hubConnection;if(\"'!hubInfo)return false;net.kind='\"'hub';net.isHost=hubInfo.isHost;net.me=hubInfo.me;net.roster=hubInfo.players;game.reset(hubInfo.players);screen='hub';paused=false;\"'$('\"'#titleScreen').classList.add('hidden');\"'$('\"'#hud').classList.remove('hidden');AIHub.on('start',()=>{hubStarted=true;net.started=true;screen='game';paused=false;\"'$('\"'#overlay').classList.add('hidden');resize()});AIHub.on('message',handlePacket);AIHub.on('leave',({id})=>{net.roster=net.roster.filter(p=>p.id\"'!==id);if(net.isHost)game.removePlayer(id)});AIHub.on('\"'time-up',()=>finishHub(false));AIHub.on('end',()=>{hubEnded=true;netEnded=true;paused=true;keys.clear();audio.stop();\"'$('\"'#overlay').classList.add('hidden');\"'$('\"'#touchAction').classList.add('hidden')});AIHub.probe(()=>({scene:screen,menu:paused,world:{floor:localPlayer()?.f,players:game.players.length,pieces:game.banked.length,status:game.status,time:game.time},input:lastInput}));AIHub.ready();return true;}\nfunction finishHub(won){if(\"'!hubInfo||!net.isHost||hubFinished||hubEnded)return;hubFinished=true;const ids=AIHub.players.map(p=>p.id),scores=Object.fromEntries(ids.map(id=>[id,game.banked.length*1000+(game.players.find(p=>p.id===id)?.score||0)]));AIHub.finish({standings:[ids],scores,won,stats:Object.fromEntries(ids.map(id=>[id,{'\"'Urn fragments':game.banked.length,'Matches struck':game.matchesUsed,'Nerves lost':game.hits}]))})}\n\nfunction focusables(){return (screen==='title'?\"'$$('\"'#titleScreen button'):\"'$$('\"'#panel button,#panel input,#panel select,#panel textarea')).filter(el=>\"'!el.disabled&&el.getClientRects().length)}\nfunction updateFocus(apply=true){const els=focusables();menuIndex=clamp(menuIndex,0,Math.max(0,els.length-1));$$('\"'.focused').forEach(e=>e.classList.remove('focused'));if(apply&&lastInput==='gamepad'){const el=els[menuIndex];el?.classList.add('focused');el?.focus({preventScroll:true});el?.scrollIntoView({block:'nearest'})}}\nfunction navigateMenu(direction){const els=focusables();if(\"'!els.length)return;menuIndex=(menuIndex+direction+els.length)%els.length;updateFocus(true);audio.play('\"'click')}\nfunction adjustFocused(direction){const el=focusables()[menuIndex];if(el?.type==='range'){el.value=clamp(Number(el.value)+Number(el.step||1)*direction,Number(el.min),Number(el.max));el.dispatchEvent(new Event('input',{bubbles:true}))}else if(el?.tagName==='SELECT'){el.selectedIndex=clamp(el.selectedIndex+direction,0,el.options.length-1);el.dispatchEvent(new Event('change',{bubbles:true}))}else if(screen==='map'){showMap(mapFloor+direction)}}\nfunction activateFocused(){focusables()[menuIndex]?.click()}\nfunction action(name){audio.unlock();audio.play('click');if(name==='start'){newNight();return}if(name==='continue'){resetNetwork();newNight(true);return}if(name==='resume'){closePanel();return}if(name==='back'){if(screen==='dev')showPause();else closePanel();return}if(name==='pause'){showPause();return}if(name==='help'){showHelp();return}if(name==='settings'){showSettings();return}if(name==='about'||name.startsWith('about-')){showAbout(name==='about'?0:Number(name.split('-')[1]));return}if(name==='dev'){showDev();return}if(name==='map'||name.startsWith('map-')){showMap(name==='map'?localPlayer()?.f||0:name==='map-prev'?mapFloor-1:name==='map-next'?mapFloor+1:Number(name.split('-')[1]));return}if(name==='quit'){if(hubInfo)return;if(net.kind==='solo'&&game.status==='playing')safeWrite(SAVE_KEY,game.snapshot());disconnect();return}if(name==='restart'){if(net.isHost)newNight();return}if(name==='motion'||name==='contrast'){settings[name]=\"'!settings[name];safeWrite(PREF_KEY,settings);showSettings();return}if(name==='\"'fullscreen'){if(document.fullscreenElement)document.exitFullscreen?.();else document.documentElement.requestFullscreen?.().catch(()=>{});return}if(name==='coop'){showCoop();return}if(name==='local-host'){const alphabet='ABCDEFGHJKLMNPQRSTUVWXYZ';const bytes=crypto.getRandomValues(new Uint8A