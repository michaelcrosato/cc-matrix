{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"rg 'new URL|fetch\\\\(|harness|__hubCheck|auto' vendor/harness.html\"","aggregated_output":"  body { display: grid; grid-template-rows: auto 1fr; }\n  .cell { position: relative; display: grid; grid-template-rows: auto 1fr; min-height: 0; border: 2px solid var(--line); border-radius: 8px; overflow: hidden; background: #000; }\n  .cell__state { margin-left: auto; color: var(--dim); }\n  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\n  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\n  <h1>AI Hub session harness</h1>\n    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\nconst params = new URLSearchParams(location.search);\nconst auto = params.get('auto') === '1';\n    const html = await (await fetch(url)).text();\n    url = new URL(game, location.href);\n    log(`Not loading ${game}: the harness only plays pages from this site.`);\n    frame.allow = 'fullscreen; autoplay; gamepad; pointer-lock';\n    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\n  if (!auto && players.every((c) => ready.has(c.key))) return releaseRound(state);\n * ?auto=1 — the conformance run. It presses keys inside each frame with\n * page's origin). Results land in window.__hubCheck, and body[data-complete]\n  window.__hubCheck = report;\n      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\n    check('harness ran', false, String(error?.stack || error));\nif (auto) conformance();\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_20","type":"agent_message","text":"The core simulation now has physical wall collisions, persistent floors, item swapping, wind, enemy behaviours, and the full escape objective. I’m working on the mansion, creature animation, and controls next, then I’ll test a complete run through every floor.\n"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"cat > main.mjs <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { color, uniform, normalWorld, positionWorld, vec3, float } from 'three/tsl';\nimport { HouseGame,DEFAULTS,FLOOR_NAMES,ROOM_NAMES,ROOM_CENTERS,ITEM_NAMES,STAIRS,SAFE,NOTES,PROP_BOXES,roomAt,dist,route } from './core.mjs';\n\nconst \"'$=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)], clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nconst TITLE='\"'The House of Creaks', SAVE_KEY='creaks-night-v1', PREF_KEY='creaks-settings-v1';\nconst safeRead=(k,d)=>{try{return JSON.parse(localStorage.getItem(k))||d}catch{return d}}, safeWrite=(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v))}catch{}};\nconst settings={music:.1,sfx:.7,glyphs:'ps',motion:true,contrast:false,difficulty:'restless',...safeRead(PREF_KEY,{})};\nlet game,renderer,scene,camera,interior,exterior,weather,moon,renderFloor=-1,screen='loading',previousScreen='title',paused=false,mapFloor=0,lastInput='keyboard',menuIndex=0,lastActivity=performance.now(),toastUntil=0,lastRoom='',lastRevision=-1,lastSave=0,lastNetSend=0,lastFrame=performance.now(),accumulator=0,frameCount=0,gpuFrames=0;\nlet titleTime=0,attract=false,attractTime=0,attractPhase=0,attractPath=[],attractTarget=null,debugCollisions=false,devUsed=false,hubInfo=null,hubStarted=false,hubEnded=false,hubFinished=false,netEnded=false,audioReady=false;\nconst keys=new Set(),pulses={},mixers=[],avatars=new Map(),enemyModels=new Map(),itemModels=new Map(),effects=[],touches=new Map();\nconst view={yaw:.64,height:29,target:new THREE.Vector3(),pos:new THREE.Vector3(),shake:0};\nconst shaderLight=uniform(new THREE.Vector3(0,1,5)),shaderFlame=uniform(0),shaderAmbient=uniform(.92);\nconst materials=new Map(),ink=new THREE.MeshBasicMaterial({color:0x07171f,side:THREE.BackSide});\nconst PALETTE={wall:'#376363',wallDark:'#244850',wood:'#4b5555',trim:'#b6b790',brass:'#d6ae66',roof:'#285458',roofDark:'#1b3b47',purple:'#766079',mint:'#79b9ac',cream:'#e4d5b1',rug:'#5d415c'};\nconst geometry={box:new THREE.BoxGeometry(1,1,1),sphere:new THREE.SphereGeometry(1,10,7),cylinder:new THREE.CylinderGeometry(1,1,1,10),cone:new THREE.ConeGeometry(1,1,8)};\nfunction mat(hex,glow=false){const key=hex+'-'+glow;if(materials.has(key))return materials.get(key);const m=new THREE.MeshBasicNodeMaterial({side:THREE.FrontSide});const band=normalWorld.dot(vec3(.35,.82,.4)).max(0).mul(3).floor().div(3).mul(.48).add(.52);const local=float(1).sub(positionWorld.distance(shaderLight).div(8)).clamp(0,1).mul(shaderFlame);m.colorNode=glow?color(hex):color(hex).mul(band.mul(shaderAmbient.add(local.mul(.6)))).add(color('#e5b165').mul(local.mul(.1)));materials.set(key,m);return m}\nfunction mesh(parent,type,pos,scale,hex,outline=true){const o=new THREE.Mesh(geometry[type]||geometry.box,mat(hex));o.position.set(...pos);o.scale.set(...scale);parent.add(o);if(outline){const edge=new THREE.Mesh(o.geometry,ink);edge.scale.set(1.025,1.025,1.025);o.add(edge)}return o}\nfunction orb(parent,x,y,z,r,hex,outline=true){return mesh(parent,'sphere',[x,y,z],[r,r,r],hex,outline)}\nfunction beam(parent,a,b,r,hex){const d=new THREE.Vector3().subVectors(new THREE.Vector3(...b),new THREE.Vector3(...a)),m=mesh(parent,'cylinder',[(a[0]+b[0])/2,(a[1]+b[1])/2,(a[2]+b[2])/2],[r,d.length(),r],hex);m.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0),d.normalize());return m}\nfunction flat(parent,x,z,w,d,hex,y=.03){return mesh(parent,'box',[x,y,z],[w,.06,d],hex,false)}\nfunction ring(parent,x,y,z,r,hex){const g=new THREE.TorusGeometry(r,.035,5,40),m=new THREE.Mesh(g,mat(hex,true));m.rotation.x=-Math.PI/2;m.position.set(x,y,z);parent.add(m);return m}\nfunction shadow(parent,x,z,r=.7,opacity=.26){const m=new THREE.Mesh(new THREE.CircleGeometry(r,24),new THREE.MeshBasicMaterial({color:0x06151d,transparent:true,opacity,depthWrite:false}));m.rotation.x=-Math.PI/2;m.position.set(x,.09,z);parent.add(m);return m}\nfunction nativeAnimation(root,clip){const mixer=new THREE.AnimationMixer(root);mixer.clipAction(clip).play();mixers.push(mixer);return mixer}\nfunction makeEyes(parent,y=1.3,z=.37,scale=1,white=true){const group=new THREE.Group();group.name='eyes';group.position.set(0,y,z);for(const side of [-1,1]){const eye=orb(group,side*.16*scale,0,0,.13*scale,white?'#fff0c6':'#15262d',false);eye.scale.y=1.45;if(white)orb(group,side*.16*scale+.025*scale,-.015*scale,.115*scale,.045*scale,'#17252a',false)}parent.add(group);return group}\nfunction createAvatar(p){const root=new THREE.Group(),body=new THREE.Group();body.name='body';root.add(body);const s=shadow(root,0,0,.48,.4);mesh(body,'cone',[0,.62,0],[.5,1.15,.45],p.color);orb(body,0,1.2,0,.38,'#142c35');mesh(body,'cone',[0,1.48,-.04],[.44,.55,.4],'#263e46');const eyes=makeEyes(body,1.26,.31,1.05);const left=orb(root,-.19,.16,0,.14,'#162831');left.name='leftFoot';const right=orb(root,.19,.16,0,.14,'#162831');right.name='rightFoot';const hand=orb(body,.48,.88,.1,.13,p.color);hand.name='hand';const flame=new THREE.Group();flame.position.set(.5,1.17,.1);const stick=mesh(flame,'cylinder',[0,-.15,0],[.022,.35,.022],'#e3cf9d');const fire=mesh(flame,'sphere',[0,.05,0],[.1,.19,.1],'#ffce72',false);fire.material=mat('#ffda83',true);orb(flame,0,.03,.02,.05,'#fff4cd',false).material=mat('#fff5bd',true);body.add(flame);flame.visible=false;\n const hold=new THREE.Group();hold.position.set(-.48,.85,.05);body.add(hold);const idle=new THREE.AnimationClip('breath',2.4,[new THREE.NumberKeyframeTrack('body.position[y]',[0,1.2,2.4],[0,.075,0]),new THREE.NumberKeyframeTrack('eyes.scale[y]',[0,2,2.08,2.18,2.4],[1,1,.06,1,1])]);const mixer=new THREE.AnimationMixer(root);mixer.clipAction(idle).play();const walk=mixer.clipAction(new THREE.AnimationClip('walk',.6,[new THREE.NumberKeyframeTrack('leftFoot.position[z]',[0,.15,.3,.45,.6],[0,.18,0,-.18,0]),new THREE.NumberKeyframeTrack('rightFoot.position[z]',[0,.15,.3,.45,.6],[0,-.18,0,.18,0]),new THREE.NumberKeyframeTrack('body.rotation[z]',[0,.15,.3,.45,.6],[0,.055,0,-.055,0])]));walk.play();mixers.push(mixer);root.userData={body,eyes,flame,fire,hand,hold,walk,mixer,shadow:s,carry:null};scene.add(root);avatars.set(p.id,root);return root}\nfunction makeCreature(e,add=true){const root=new THREE.Group(),body=new THREE.Group();body.name='body';root.add(body);shadow(root,0,0,e.type==='ghost'?.7:.5,.22);\n if(e.type==='ghost'){orb(body,0,1.25,0,.58,'#b5bac3');mesh(body,'cone',[0,.85,0],[.68,1.45,.61],'#b5bac3');for(let i=0;i<7;i++)orb(body,Math.sin(i/7*Math.PI*2)*.5,.28,Math.cos(i/7*Math.PI*2)*.42,.2,'#b5bac3');makeEyes(body,1.35,.52,.95,false);orb(body,0,1.05,.59,.09,'#293c48',false);beam(body,[-.4,1.1,0],[-.8,.8,.15],.14,'#b5bac3');beam(body,[.4,1.1,0],[.8,.8,.15],.14,'#b5bac3');nativeAnimation(root,new THREE.AnimationClip('haunting',3,[new THREE.NumberKeyframeTrack('body.position[y]',[0,1.5,3],[.1,.4,.1]),new THREE.NumberKeyframeTrack('body.rotation[z]',[0,1.5,3],[-.08,.08,-.08])]));}\n if(e.type==='bat'){orb(body,0,1.6,0,.24,'#574e68');mesh(body,'cone',[-.14,1.87,0],[.13,.28,.12],'#574e68');mesh(body,'cone',[.14,1.87,0],[.13,.28,.12],'#574e68');makeEyes(body,1.67,.2,.55);for(const side of [-1,1]){const wing=new THREE.Group();wing.name=side<0?'wingL':'wingR';wing.position.set(side*.18,1.6,0);const sh=new THREE.Shape();sh.moveTo(0,0);sh.lineTo(.95*side,.45);sh.lineTo(.8*side,-.15);sh.quadraticCurveTo(.53*side,.1,.43*side,-.3);sh.quadraticCurveTo(.2*side,-.1,0,-.25);sh.closePath();const w=new THREE.Mesh(new THREE.ShapeGeometry(sh),new THREE.MeshBasicMaterial({color:0x71607e,side:THREE.DoubleSide}));wing.add(w);for(const n of [0,.43,.95])beam(wing,[0,0,.01],[n*side,n===.95?.45:-.25,.01],.017,'#15252e');body.add(wing)}nativeAnimation(root,new THREE.AnimationClip('flutter',.34,[new THREE.NumberKeyframeTrack('wingL.rotation[y]',[0,.17,.34],[-.65,.7,-.65]),new THREE.NumberKeyframeTrack('wingR.rotation[y]',[0,.17,.34],[.65,-.7,.65]),new THREE.NumberKeyframeTrack('body.position[y]',[0,.17,.34],[0,.1,0])]));}\n if(e.type==='spider'){orb(body,0,.5,0,.41,'#746283');orb(body,0,.43,.34,.26,'#9e87a1');makeEyes(body,.47,.54,.6);const tracks=[];for(let i=0;i<4;i++)for(const side of [-1,1]){const leg=new THREE.Group();leg.name='leg'+i+'_'+side;leg.position.set(side*.25,.45,(i-1.5)*.18);beam(leg,[0,0,0],[side*.48,.13,(i-1.5)*.19],.037,'#574b68');beam(leg,[side*.48,.13,(i-1.5)*.19],[side*.68,-.36,(i-1.5)*.28],.03,'#574b68');body.add(leg);const a=i%2?.1:-.1;tracks.push(new THREE.NumberKeyframeTrack(leg.name+'.rotation[y]',[0,.3,.6],[a,-a,a]))}nativeAnimation(root,new THREE.AnimationClip('skitter',.6,tracks));}\n if(add)scene.add(root);return root}\nfunction makeItem(id){const root=new THREE.Group();if(id==='key'){ring(root,0,.25,0,.2,'#f2c56c').rotation.x=0;beam(root,[0,.08,0],[0,-.47,0],.055,'#efc477');mesh(root,'box',[.1,-.35,0],[.2,.08,.08],'#efc477');mesh(root,'box',[.1,-.48,0],[.2,.08,.08],'#efc477')}\n else if(id==='ward'){beam(root,[0,-.5,0],[0,.45,0],.055,'#d3af74');const jewel=mesh(root,'sphere',[0,.55,0],[.19,.27,.19],'#9ee7c7');jewel.material=mat('#a2ead0',true);ring(root,0,.55,0,.3,'#d6b679').rotation.x=.2;}\n else{const i=Number(id.at(-1));const g=new THREE.CylinderGeometry(i===0?.32:.26,i===2?.15:.36,.5,7,1,true,0,Math.PI*1.55);const piece=new THREE.Mesh(g,mat('#e1b46f'));piece.rotation.z=.25;root.add(piece);ring(root,0,.2,0,.3,'#f2d494');mesh(root,'box',[-.13,.05,.28],[.08,.3,.06],'#4c8a82',false)}return root}\nfunction candle(parent,x,z,safe=false){const base=mesh(parent,'cylinder',[x,.13,z],[safe?.38:.15,.2,safe?.38:.15],'#b39765');mesh(parent,'cylinder',[x,safe?.65:.4,z],[.09,safe?.9:.5,.09],'#edddb3');const f=orb(parent,x,safe?1.17:.73,z,.1,'#f1c16f',false);f.scale.y=1.8;f.material=mat('#ffda91',true);if(safe){ring(parent,x,.08,z,1.75,'#bba56e');for(let i=0;i<8;i++)flat(parent,x+Math.sin(i*Math.PI/4)*1.55,z+Math.cos(i*Math.PI/4)*1.55,.12,.12,'#d1b985',.1)}}\nfunction windowModel(parent,x,y,z,rot=0,lit=true){const g=new THREE.Group();g.position.set(x,y,z);g.rotation.y=rot;mesh(g,'box',[0,0,0],[1.35,2,.16],'#102d37');const pane=mesh(g,'box',[0,0,.11],[1.05,1.65,.06],lit?'#e3b36a':'#688e88',false);if(lit)pane.material=mat('#f0c379',true);mesh(g,'box',[0,0,.18],[.08,1.7,.08],'#273f48');mesh(g,'box',[0,0,.19],[1.1,.09,.08],'#273f48');mesh(g,'box',[0,-1,.12],[1.6,.15,.4],'#a6a88a');parent.add(g);return g}\nfunction roof(parent,x,y,z,w,h,d,hex){const v=[-w/2,0,-d/2,w/2,0,-d/2,0,h,-d/2,-w/2,0,d/2,w/2,0,d/2,0,h,d/2];const geo=new THREE.BufferGeometry();geo.setAttribute('position',new THREE.Float32BufferAttribute(v,3));geo.setIndex([0,2,1,3,4,5,0,3,5,0,5,2,2,5,4,2,4,1,0,1,4,0,4,3]);geo.computeVertexNormals();const m=new THREE.Mesh(geo,mat(hex));m.position.set(x,y,z);parent.add(m);const edge=new THREE.LineSegments(new THREE.EdgesGeometry(geo),new THREE.LineBasicMaterial({color:0x071820}));m.add(edge);return m}\nfunction tree(parent,x,z,h=8){const g=new THREE.Group();g.position.set(x,0,z);beam(g,[0,0,0],[.2,h*.65,0],.24,'#244148');beam(g,[.2,h*.65,0],[-.5,h,0],.1,'#244148');for(const [s,k] of [[-1,.4],[1,.55],[-1,.73]]){const by=h*k;beam(g,[.1,by,0],[s*2.2,by+1.4,.1],.1,'#244148');beam(g,[s*1.4,by+.9,0],[s*1.6,by+2.1,.4],.055,'#244148');beam(g,[s*2.1,by+1.3,.1],[s*2.8,by+1.7,-.5],.04,'#244148')}parent.add(g);return g}\nfunction furniture(g,p,f){const {x,z,k}=p;if(k==='bookcase'){mesh(g,'box',[x,1.1,z],[p.w,2.2,p.d],'#31464c');for(let r=0;r<3;r++){mesh(g,'box',[x,.4+r*.7,z],[p.w+.1,.08,p.d+.08],'#88886c');for(let i=0;i<5;i++){const m=mesh(g,'box',[x+((i%2)*.12),.67+r*.7,z-p.d/2+.23+i*.48],[p.w*.8,.47,.22],['#94736f','#b39b74','#486d69','#6c6e86'][((r+i+f)%4)]);m.rotation.x=(i%3-1)*.07}}}\n if(k==='desk'){mesh(g,'box',[x,.9,z],[p.w,.17,p.d],'#8a8071');for(const s of [-1,1])mesh(g,'box',[x+s*p.w*.4,.45,z],[.15,.9,p.d*.7],'#3b5256');flat(g,x-.35,z,.75,.6,'#e0d4b0',1.01);candle(g,x+.8,z)}\n if(k==='piano'){mesh(g,'box',[x,1.05,z],[p.w,1.7,p.d],'#293945');mesh(g,'box',[x,1.02,z+.8],[p.w*.94,.09,.45],'#b7b89e');for(let i=0;i<12;i++)flat(g,x-p.w*.44+i*.23,z+.8,.025,.45,'#27383f',1.1);mesh(g,'box',[x,.45,z+1.15],[1.3,.24,.55],'#574c63');}\n if(k==='table'){mesh(g,'box',[x,1,z],[p.w,.2,p.d],'#827862');for(const sx of [-1,1])for(const sz of [-1,1])mesh(g,'box',[x+sx*p.w*.39,.5,z+sz*p.d*.35],[.15,1,.15],'#3d5053');flat(g,x,z,1.7,1.4,f===0?'#68576d':'#75887c',1.12);for(const sx of [-1,1]){const plate=mesh(g,'cylinder',[x+sx*.95,1.14,z],[.27,.025,.27],'#c1c2a4',false);mesh(g,'box',[x+sx*2,.6,z],[.65,.2,.7],'#516466');mesh(g,'box',[x+sx*2,1,z-.28],[.65,.8,.12],'#516466')};candle(g,x,z)}\n if(k==='sofa'){mesh(g,'box',[x,.52,z],[p.w,.7,p.d],'#765971');mesh(g,'box',[x-p.w*.35,1,z],[.25,.9,p.d],'#56425c');for(const s of [-1,1])mesh(g,'box',[x,.8,z+s*p.d*.43],[p.w,1,.25],'#765971');for(let i=0;i<3;i++)mesh(g,'box',[x+.13,.92,z+(i-1)*.73],[p.w*.65,.18,.65],'#99758c')}\n if(k==='plant'){mesh(g,'cone',[x,.5,z],[.55,.8,.55],'#927868').rotation.z=Math.PI;for(let i=0;i<6;i++){const a=i*Math.PI/3;const leaf=mesh(g,'sphere',[x+Math.sin(a)*.36,1.35+i*.05,z+Math.cos(a)*.36],[.2,.7,.12],i%2?'#548a7a':'#7aa087');leaf.rotation.z=Math.sin(a)*.5;leaf.rotation.y=a}}\n if(k==='altar'){mesh(g,'box',[x,.6,z],[p.w,1.1,p.d],'#55666a');mesh(g,'box',[x,1.2,z],[p.w+.25,.18,p.d+.2],'#a9a78c');mesh(g,'cylinder',[x,1.4,z],[.43,.25,.43],'#a58763');for(const s of [-1,1])candle(g,x+s*.8,z)}\n if(k==='clock'){mesh(g,'box',[x,1.1,z],[.7,2.2,.6],'#525362');const face=mesh(g,'cylinder',[x,1.7,z+.35],[.36,.06,.36],'#d5c9a4');face.rotation.x=Math.PI/2;beam(g,[x,1.7,z+.4],[x+.13,1.83,z+.4],.023,'#293b42');beam(g,[x,1.7,z+.4],[x,1.45,z+.4],.018,'#293b42');const pend=orb(g,x,.7,z+.35,.12,'#baa168');pend.name='pendulum'+f;nativeAnimation(g,new THREE.AnimationClip('tick'+f,2,[new THREE.NumberKeyframeTrack(pend.name+'.position[x]',[0,1,2],[x-.14,x+.14,x-.14])]))}\n}\nfunction buildInterior(f){if(interior){scene.remove(interior);for(const m of [...mixers])if(m.getRoot()===interior){mixers.splice(mixers.indexOf(m),1)}}interior=new THREE.Group();interior.name='floor'+f;scene.add(interior);const palette=[['#6e7b71','#3a6263','#5e475d'],['#6c6370','#4e626f','#7c5669'],['#657570','#456369','#41645e'],['#73746b','#475b65','#645567']][f];mesh(interior,'box',[0,-.4,0],[30.8,.8,20.8],'#344d53');for(let r=0;r<6;r++){const [x,z]=ROOM_CENTERS[r];flat(interior,x,z,9.8,9.8,palette[0],.02);for(let i=0;i<10;i++)flat(interior,x-4.5+i,z,.025,9.7,'#3d5655',.07);flat(interior,x,z,5.2,4.9,palette[2],.1);flat(interior,x,z,4.85,4.55,r===4?'#8b7568':palette[2],.13);for(const s of [-1,1]){flat(interior,x+s*2.22,z,.055,4.2,'#a69379',.17);flat(interior,x,z+s*2.05,4.45,.055,'#a69379',.17)}}\n for(const b of game.boxes.slice(0,24)){const exteriorWall=Math.abs(b.x)>14||Math.abs(b.z)>9;const front=b.z>9||b.x>14;const height=front?.65:exteriorWall?3.3:1.45;mesh(interior,'box',[b.x,height/2+.12,b.z],[b.w,height,b.d],palette[1]);mesh(interior,'box',[b.x,height+.15,b.z],[b.w+.09,.12,b.d+.09],'#87958a')}\n for(const x of [-15,-5,5,15])for(const z of [-10,0,10]){mesh(interior,'box',[x,1.05,z],[.5,2.05,.5],'#45646a');mesh(interior,'box',[x,2.1,z],[.65,.16,.65],'#a6aa8b')}\n for(const x of [-10,0,10]){windowModel(interior,x,1.75,-9.78,0,false);for(const sx of [-1,1])mesh(interior,'box',[x+sx*.98,1.7,-9.7],[.47,2.4,.15],palette[2])}\n for(const p of PROP_BOXES)furniture(interior,p,f);\n candle(interior,0,5,true);\n for(const s of STAIRS.filter(s=>s.f===f)){const g=new THREE.Group();for(let i=0;i<5;i++)mesh(g,'box',[s.x-1+i*.4,.08+i*.13,s.z],[.39,.16+i*.26,1.4],s.to>f?'#8e9282':'#435f66');ring(g,s.x,.1,s.z,1.4,'#c4ad73');if(s.locked&&\"'!game.unlocked){mesh(g,'\"'box',[s.x,1,s.z-.85],[2.3,1.9,.15],'#715e55');orb(g,s.x,.9,s.z-.7,.15,'#dfb777')};interior.add(g)}\n if(f===0){flat(interior,0,9,2.4,1.4,'#c2aa7c',.15);mesh(interior,'box',[-1.65,1.5,10],[.4,3,.4],'#3c5f62');mesh(interior,'box',[1.65,1.5,10],[.4,3,.4],'#3c5f62');mesh(interior,'box',[0,3,10],[3.7,.3,.4],'#859486');if(game.banked.length<3){const door=mesh(interior,'box',[0,1.45,10],[2.8,2.8,.17],'#243f49');mesh(door,'box',[.3,0,-.9],[.08,.09,.07],'#d3b06f')}}\n NOTES.forEach(n=>{if(n.f===f){const note=flat(interior,n.x,n.z,.65,.5,'#e1d4ab',.16);note.rotation.y=-.25;for(let i=0;i<3;i++)flat(interior,n.x,n.z-.13+i*.12,.38,.017,'#817c64',.2)}});\n if(f===3){beam(interior,[-14,2.7,-9],[14,2.7,-9],.12,'#38505b');for(const x of [-10,0,10]){beam(interior,[x-4,2.8,-9],[x,5,-9],.1,'#52636a');beam(interior,[x,5,-9],[x+4,2.8,-9],.1,'#52636a')}}\n renderFloor=f;lastRevision=game.revision;\n}\nfunction buildExterior(){exterior=new THREE.Group();scene.add(exterior);mesh(exterior,'cylinder',[0,-1.3,0],[23,1.7,17],'#1b3a44');mesh(exterior,'cylinder',[0,-.43,0],[22.8,.2,16.8],'#365957');mesh(exterior,'box',[0,5,0],[26,10,16],'#416266');for(const y of [.2,3.2,6.4,9.7])mesh(exterior,'box',[0,y,0],[26.5,.26,16.5],'#8b9d8e');for(let i=0;i<11;i++){mesh(exterior,'box',[-12.5+i*2.5,4.9,8.1],[.12,9.7,.12],'#2b4853',false)}roof(exterior,0,10,0,28,5.5,18,'#244c57');for(const z of [-8.8,8.8])beam(exterior,[-14,10,z],[0,15.5,z],.1,'#8da092');for(const z of [-8.8,8.8])beam(exterior,[0,15.5,z],[14,10,z],.1,'#8da092');for(let i=0;i<7;i++){const t=(i+1)/8;for(const side of [-1,1])beam(exterior,[side*14*(1-t),10+5.5*t,-8.8],[side*14*(1-t),10+5.5*t,8.8],.034,'#466e70')}\n for(const y of [1.7,4.9,8])for(const x of [-9,-4.5,4.5,9])windowModel(exterior,x,y,8.16,0,(x+y)%3>-.5);for(const y of [1.7,4.9,8])for(const z of [-5,0,5])windowModel(exterior,13.1,y,z,Math.PI/2,true);\n for(const [x,z,h] of [[-11,-5,14.6],[11,-5,13.5]]){mesh(exterior,'cylinder',[x,h/2,z],[2.3,h,2.3],'#45646b');for(let i=0;i<3;i++){const yy=2+i*4;windowModel(exterior,x,yy,z+2.28,0,true)}mesh(exterior,'cone',[x,h+2.5,z],[3.25,5.5,3.25],'#28515c');orb(exterior,x,h+5.3,z,.18,'#c6b67f');beam(exterior,[x,h+5,z],[x,h+6,z],.04,'#c6b67f')}\n mesh(exterior,'box',[0,1.6,8.22],[2.8,3.2,.24],'#152f3b');roof(exterior,0,3.5,9,5,1.5,3,'#37545d');for(const x of [-2,2])mesh(exterior,'cylinder',[x,1.6,9.8],[.15,3.2,.15],'#b4b597');mesh(exterior,'box',[0,.15,9.4],[5,.3,3],'#7a8b83');for(let i=0;i<4;i++)mesh(exterior,'box',[0,-.05-i*.06,11+i*.6],[5+i*.2,.2,.65],'#6b7e76');\n for(let i=0;i<8;i++)flat(exterior,Math.sin(i*.8)*.3,13+i*.8,2.4,.55,'#728777',-.25);\n for(const x of [-20,19]){tree(exterior,x,3,x<0?9:8);tree(exterior,x*1.04,-12,7)}for(let i=0;i<10;i++){const x=-17+i*3.7;beam(exterior,[x,-.25,13],[x,1.4,13],.06,'#17343d');mesh(exterior,'cone',[x,1.55,13],[.16,.4,.16],'#688b83');if(i<9)for(const y of [.4,1])beam(exterior,[x,y,13],[x+3.7,y,13],.045,'#17343d')}\n for(const x of [-17,17]){const grave=mesh(exterior,'box',[x,.4,7],[1.1,1.1,.25],'#799184');grave.rotation.z=x>0?.1:-.15;beam(exterior,[x,.2,7.15],[x,.8,7.15],.035,'#39585c');beam(exterior,[x-.2,.6,7.15],[x+.2,.6,7.15],.03,'#39585c')}\n for(let i=0;i<3;i++){const bat=makeCreature({type:'bat'},false);bat.position.set(12+i*2,12+i,5);bat.userData.orbit=i;exterior.add(bat)}\n moon=orb(scene,1,19,-25,4.8,'#d0c894',false);moon.material=mat('#d8cf9d',true);for(let i=0;i<7;i++)orb(moon,Math.sin(i*8.2)*.5,Math.cos(i*7.9)*.4,.88,.07+i*.005,'#aaa984',false);const halo=new THREE.Mesh(new THREE.RingGeometry(5.6,5.63,80),new THREE.MeshBasicMaterial({color:0x789583,transparent:true,opacity:.3,side:THREE.DoubleSide}));halo.position.copy(moon.position);halo.lookAt(30,30,40);scene.add(halo);\n weather=new THREE.Group();scene.add(weather);for(let i=0;i<38;i++){const a=i*2.399;const cloud=orb(weather,Math.sin(a)*31,-2.7+Math.sin(i)*.4,Math.cos(a)*24,.8+(i%4)*.7,i%2?'#23474c':'#1c3c47',false);cloud.scale.set(5,1,2.5)}\n}\nfunction buildWorld(){scene=new THREE.Scene();scene.background=new THREE.Color('#0c2933');scene.fog=new THREE.FogExp2('#0c2933',.006);camera=new THREE.OrthographicCamera(-25,25,15,-15,.1,180);buildExterior();buildInterior(0);interior.visible=false;for(const e of game.enemies){const m=makeCreature(e);enemyModels.set(e.id,m);m.visible=false}for(const i of game.items){const m=makeItem(i.id);scene.add(m);itemModels.set(i.id,m);m.visible=false}const g=new THREE.BufferGeometry(),positions=[];for(let i=0;i<100;i++)positions.push(Math.sin(i*7.3)*23,1+((i*17)%100)*.12,Math.cos(i*3.8)*19);g.setAttribute('position',new THREE.Float32BufferAttribute(positions,3));const dust=new THREE.Points(g,new THREE.PointsMaterial({color:0xced6ac,size:.05,transparent:true,opacity:.6}));scene.add(dust);view.pos.set(31,25,37);view.target.set(-6,4,0);camera.position.copy(view.pos);camera.lookAt(view.target);resize();}\nfunction resize(){if(\"'!renderer||!camera)return;const w=innerWidth,h=innerHeight,a=w/h;renderer.setSize(w,h);const vh=screen==='\"'title'?a<1?44:30:a<1?47:29;camera.left=-vh*a/2;camera.right=vh*a/2;camera.top=vh/2;camera.bottom=-vh/2;camera.updateProjectionMatrix()}\nfunction effect(type,p){if(\"'!p)return;if(type==='\"'pulse'){const m=ring(scene,p.x,.17,p.z,.5,'#a9efd1');effects.push({m,life:1.2,max:1.2,kind:'pulse',f:p.f})}if(type==='bank'){for(let i=0;i<18;i++){const m=orb(scene,0,1.5,7.2,.07,'#efd38a',false);m.material=mat('#f3d993',true);effects.push({m,life:1.8,max:1.8,kind:'spark',vx:Math.sin(i)*2,vy:1+i%3,vz:Math.cos(i)*2,f:0})}}}\nfunction updateVisuals(dt){const title=screen==='title'&&\"'!attract;exterior.visible=title;interior.visible=!title;moon.visible=true;shaderAmbient.value=title?.94:settings.contrast?.88:.72;const p=localPlayer();if(!title&&p&&(p.f!==renderFloor||game.revision!==lastRevision))buildInterior(p.f);if(!title&&!p&&game.players[0]){if(game.players[0].f!==renderFloor)buildInterior(game.players[0].f)}\n const desiredTarget=title?new THREE.Vector3(-7,5,0):new THREE.Vector3(0,.3,0),desiredPos=title?new THREE.Vector3(29,27,39):new THREE.Vector3(28,39,37);const lerp=settings.motion?1-Math.exp(-dt*2.6):1;view.target.lerp(desiredTarget,lerp);view.pos.lerp(desiredPos,lerp);camera.position.copy(view.pos);camera.lookAt(view.target);if(view.shake>0&&settings.motion){camera.position.x+=Math.sin(performance.now()*.06)*view.shake;camera.position.y+=Math.cos(performance.now()*.08)*view.shake;view.shake=Math.max(0,view.shake-dt*.7)}\n if(p){shaderLight.value.set(p.x,1,p.z);shaderFlame.value=p.match>0?1:.03}\n for(const player of game.players){const root=avatars.get(player.id)||createAvatar(player);root.visible=!title&&player.f===renderFloor;root.position.set(player.x,0,player.z);root.userData.body.rotation.y=Math.sin(player.angle)*.13;root.userData.eyes.rotation.y=.64;root.userData.flame.visible=player.match>0;root.userData.fire.scale.y=.18+Math.sin(performance.now()*.029)*.035;root.userData.walk.setEffectiveWeight(player.moving?1:0);if(player.invuln>0&&Math.floor(performance.now()/110)%2===0){root.userData.body.visible=false}else root.userData.body.visible=true;if(root.userData.carry!==player.carry){root.userData.hold.clear();if(player.carry){const m=makeItem(player.carry);m.scale.setScalar(.65);root.userData.hold.add(m)}root.userData.carry=player.carry}}\n for(const [id,root] of avatars)if(!game.players.some(p=>p.id===id)){scene.remove(root);avatars.delete(id)}\n for(const e of game.enemies){const m=enemyModels.get(e.id);if(!m)continue;m.visible=!title&&e.f===renderFloor;m.position.set(e.x,0,e.z);m.rotation.y=e.type==='\"'ghost'?.55:Math.sin(game.time*.8+e.id)*.3+.6;m.rotation.z=e.stun>0?Math.sin(game.time*8)*.15:0;const near=p?dist(p,e):99;const illumination=p?.match>0||settings.contrast||game.reveal||e.mode==='chase'||near<2.5;m.children[0].visible=illumination;m.scale.setScalar(e.stun>0?.86:1)}\n for(const i of game.items){const m=itemModels.get(i.id);m.visible=\"'!title&&i.f===renderFloor&&i.holder===null&&!i.banked;m.position.set(i.x,1.1+Math.sin(game.time*2+i.id.length)*.12,i.z);m.rotation.y=game.time*.7;if(i.id==='\"'key'&&i.f===0)m.position.y+=.45}\n for(const m of mixers)m.update(dt*(settings.motion?1:.25));for(const child of exterior.children)if(child.userData.orbit\"'!==undefined){const i=child.userData.orbit;child.position.x=5+Math.sin(titleTime*.35+i*2)*13;child.position.z=3+Math.cos(titleTime*.35+i*2)*8;child.position.y=12+Math.sin(titleTime+i)*1.3}\n if(weather)weather.rotation.y=Math.sin(titleTime*.025)*.03;\n for(let i=effects.length-1;i>=0;i--){const e=effects[i];e.life-=dt;e.m.visible=e.f===renderFloor;if(e.kind==='\"'pulse'){e.m.scale.setScalar(1+(1-e.life/e.max)*12);e.m.position.y=.1+(1-e.life/e.max)*.2}else{e.m.position.x+=e.vx*dt;e.m.position.y+=e.vy*dt;e.m.position.z+=e.vz*dt;e.vy-=dt*2}if(e.life<=0){scene.remove(e.m);e.m.geometry.dispose();effects.splice(i,1)}}\n}\n\nclass HouseAudio{\n constructor(){this.ctx=null;this.master=null;this.musicGain=null;this.sfxGain=null;this.analyser=null;this.notesPlayed=0;this.effectsPlayed=0;this.voicesPlayed=0;this.step=0;this.nextNote=0;this.muted=false;this.active=[];}\n async unlock(){if(\"'!this.ctx){const Audio=window.AudioContext||window.webkitAudioContext;if(!Audio)return;this.ctx=new Audio();this.master=this.ctx.createGain();this.master.gain.value=.65;this.musicGain=this.ctx.createGain();this.sfxGain=this.ctx.createGain();this.musicGain.connect(this.master);this.sfxGain.connect(this.master);this.analyser=this.ctx.createAnalyser();this.analyser.fftSize=256;this.master.connect(this.analyser);this.analyser.connect(this.ctx.destination);this.updateVolumes();this.nextNote=this.ctx.currentTime+.15}if(this.ctx.state==='\"'suspended')await this.ctx.resume();audioReady=true;}\n updateVolumes(){if(this.ctx){this.musicGain.gain.setTargetAtTime(settings.music,this.ctx.currentTime,.06);this.sfxGain.gain.setTargetAtTime(settings.sfx,this.ctx.currentTime,.06)}}\n tone(freq,duration=.2,type='sine',volume=.2,when=0,target='sfx',endFreq=null){if(\"'!this.ctx||this.muted)return;const t=when||this.ctx.currentTime,osc=this.ctx.createOscillator(),g=this.ctx.createGain();osc.type=type;osc.frequency.setValueAtTime(freq,t);if(endFreq)osc.frequency.exponentialRampToValueAtTime(Math.max(1,endFreq),t+duration);g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(Math.max(.0002,volume),t+.015);g.gain.exponentialRampToValueAtTime(.0001,t+duration);osc.connect(g);g.connect(target==='\"'music'?this.musicGain:this.sfxGain);osc.start(t);osc.stop(t+duration+.03);osc.onended=()=>{osc.disconnect();g.disconnect()};}\n noise(duration=.3,volume=.15,cutoff=1500){if(\"'!this.ctx||this.muted)return;const count=Math.ceil(this.ctx.sampleRate*duration),buffer=this.ctx.createBuffer(1,count,this.ctx.sampleRate),d=buffer.getChannelData(0);let s=.31;for(let i=0;i<count;i++){s=(s*16807)%2147483647;d[i]=(s/1073741823.5-1)*(1-i/count)}const src=this.ctx.createBufferSource(),g=this.ctx.createGain(),filter=this.ctx.createBiquadFilter();src.buffer=buffer;filter.type='\"'lowpass';filter.frequency.value=cutoff;g.gain.value=volume;src.connect(filter);filter.connect(g);g.connect(this.sfxGain);src.start();src.onended=()=>{src.disconnect();filter.disconnect();g.disconnect()}}\n voice(seed=0){if(\"'!this.ctx||this.muted)return;this.voicesPlayed++;const t=this.ctx.currentTime;for(let i=0;i<5;i++){const base=155+(seed*37+i*53)%130;this.tone(base,.075+(i%2)*.03,'\"'sawtooth',.025,t+i*.105,'sfx',base*1.2);this.tone(base*3,.06,'sine',.055,t+i*.105+.01)}}\n play(type){if(\"'!this.ctx||this.muted)return;this.effectsPlayed++;const t=this.ctx.currentTime;if(type==='\"'match'){this.noise(.18,.4,4000);this.tone(760,.12,'triangle',.08,t+.03, 'sfx',170)}else if(type==='pickup'||type==='unlock'){for(let i=0;i<3;i++)this.tone([440,660,880][i],.22,'triangle',.16,t+i*.08)}else if(type==='bank'||type==='win'){for(let i=0;i<6;i++)this.tone([261.63,329.63,392,523.25,659.25,783.99][i],.8,'sine',.18,t+i*.1);this.voice(7)}else if(type==='pulse'){this.tone(110,.8,'sine',.4,t,'sfx',880);this.noise(.6,.08,2500)}else if(type==='hit'||type==='lose'){this.tone(100,.65,'sawtooth',.16,t,'sfx',35);this.noise(.35,.3,500);this.voice(2)}else if(type==='wind'||type==='snuff'){this.noise(type==='wind'?2:.4,.2,800)}else if(type==='stair'){this.tone(140,.3,'triangle',.2,t,'sfx',90);this.noise(.15,.09,400)}else if(type==='rest'){this.tone(330,.6,'sine',.13);this.tone(495,.7,'sine',.1,t+.1)}else if(type==='note'){this.noise(.17,.09,3500);this.voice(3)}else if(type==='click'){this.tone(360,.06,'triangle',.08)}}\n update(){if(\"'!this.ctx||this.muted||this.ctx.state!=='\"'running')return;const t=this.ctx.currentTime;if(this.nextNote<t-.5)this.nextNote=t+.05;const melody=[0,7,10,14,12,7,3,7,0,7,10,15,14,10,7,3],base=146.832;let safety=0;while(this.nextNote<t+.2&&safety++<5){const i=this.step%melody.length;this.tone(base*Math.pow(2,melody[i]/12),1.5,'triangle',.15,this.nextNote,'music');if(i%4===0){this.tone(base/2*Math.pow(2,([0,0,-2,-5][Math.floor(i/4)])/12),2.4,'sine',.2,this.nextNote,'music')}this.step++;this.notesPlayed++;this.nextNote+=.46}}\n stop(){this.muted=true;if(this.ctx)this.master.gain.setTargetAtTime(0,this.ctx.currentTime,.03)}\n levels(){if(\"'!this.analyser)return 0;const d=new Uint8Array(this.analyser.fftSize);this.analyser.getByteTimeDomainData(d);return Math.sqrt(d.reduce((s,v)=>s+(v-128)**2,0)/d.length)/128}\n}\nconst audio=new HouseAudio();\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"cat > main.mjs <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { color, uniform, normalWorld, positionWorld, vec3, float } from 'three/tsl';\nimport { HouseGame,DEFAULTS,FLOOR_NAMES,ROOM_NAMES,ROOM_CENTERS,ITEM_NAMES,STAIRS,SAFE,NOTES,PROP_BOXES,roomAt,dist,route } from './core.mjs';\n\nconst \"'$=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)], clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nconst TITLE='\"'The House of Creaks', SAVE_KEY='creaks-night-v1', PREF_KEY='creaks-settings-v1';\nconst safeRead=(k,d)=>{try{return JSON.parse(localStorage.getItem(k))||d}catch{return d}}, safeWrite=(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v))}catch{}};\nconst settings={music:.1,sfx:.7,glyphs:'ps',motion:true,contrast:false,difficulty:'restless',...safeRead(PREF_KEY,{})};\nlet game,renderer,scene,camera,interior,exterior,weather,moon,renderFloor=-1,screen='loading',previousScreen='title',paused=false,mapFloor=0,lastInput='keyboard',menuIndex=0,lastActivity=performance.now(),toastUntil=0,lastRoom='',lastRevision=-1,lastSave=0,lastNetSend=0,lastFrame=performance.now(),accumulator=0,frameCount=0,gpuFrames=0;\nlet titleTime=0,attract=false,attractTime=0,attractPhase=0,attractPath=[],attractTarget=null,debugCollisions=false,devUsed=false,hubInfo=null,hubStarted=false,hubEnded=false,hubFinished=false,netEnded=false,audioReady=false;\nconst keys=new Set(),pulses={},mixers=[],avatars=new Map(),enemyModels=new Map(),itemModels=new Map(),effects=[],touches=new Map();\nconst view={yaw:.64,height:29,target:new THREE.Vector3(),pos:new THREE.Vector3(),shake:0};\nconst shaderLight=uniform(new THREE.Vector3(0,1,5)),shaderFlame=uniform(0),shaderAmbient=uniform(.92);\nconst materials=new Map(),ink=new THREE.MeshBasicMaterial({color:0x07171f,side:THREE.BackSide});\nconst PALETTE={wall:'#376363',wallDark:'#244850',wood:'#4b5555',trim:'#b6b790',brass:'#d6ae66',roof:'#285458',roofDark:'#1b3b47',purple:'#766079',mint:'#79b9ac',cream:'#e4d5b1',rug:'#5d415c'};\nconst geometry={box:new THREE.BoxGeometry(1,1,1),sphere:new THREE.SphereGeometry(1,10,7),cylinder:new THREE.CylinderGeometry(1,1,1,10),cone:new THREE.ConeGeometry(1,1,8)};\nfunction mat(hex,glow=false){const key=hex+'-'+glow;if(materials.has(key))return materials.get(key);const m=new THREE.MeshBasicNodeMaterial({side:THREE.FrontSide});const band=normalWorld.dot(vec3(.35,.82,.4)).max(0).mul(3).floor().div(3).mul(.48).add(.52);const local=float(1).sub(positionWorld.distance(shaderLight).div(8)).clamp(0,1).mul(shaderFlame);m.colorNode=glow?color(hex):color(hex).mul(band.mul(shaderAmbient.add(local.mul(.6)))).add(color('#e5b165').mul(local.mul(.1)));materials.set(key,m);return m}\nfunction mesh(parent,type,pos,scale,hex,outline=true){const o=new THREE.Mesh(geometry[type]||geometry.box,mat(hex));o.position.set(...pos);o.scale.set(...scale);parent.add(o);if(outline){const edge=new THREE.Mesh(o.geometry,ink);edge.scale.set(1.025,1.025,1.025);o.add(edge)}return o}\nfunction orb(parent,x,y,z,r,hex,outline=true){return mesh(parent,'sphere',[x,y,z],[r,r,r],hex,outline)}\nfunction beam(parent,a,b,r,hex){const d=new THREE.Vector3().subVectors(new THREE.Vector3(...b),new THREE.Vector3(...a)),m=mesh(parent,'cylinder',[(a[0]+b[0])/2,(a[1]+b[1])/2,(a[2]+b[2])/2],[r,d.length(),r],hex);m.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0),d.normalize());return m}\nfunction flat(parent,x,z,w,d,hex,y=.03){return mesh(parent,'box',[x,y,z],[w,.06,d],hex,false)}\nfunction ring(parent,x,y,z,r,hex){const g=new THREE.TorusGeometry(r,.035,5,40),m=new THREE.Mesh(g,mat(hex,true));m.rotation.x=-Math.PI/2;m.position.set(x,y,z);parent.add(m);return m}\nfunction shadow(parent,x,z,r=.7,opacity=.26){const m=new THREE.Mesh(new THREE.CircleGeometry(r,24),new THREE.MeshBasicMaterial({color:0x06151d,transparent:true,opacity,depthWrite:false}));m.rotation.x=-Math.PI/2;m.position.set(x,.09,z);parent.add(m);return m}\nfunction nativeAnimation(root,clip){const mixer=new THREE.AnimationMixer(root);mixer.clipAction(clip).play();mixers.push(mixer);return mixer}\nfunction makeEyes(parent,y=1.3,z=.37,scale=1,white=true){const group=new THREE.Group();group.name='eyes';group.position.set(0,y,z);for(const side of [-1,1]){const eye=orb(group,side*.16*scale,0,0,.13*scale,white?'#fff0c6':'#15262d',false);eye.scale.y=1.45;if(white)orb(group,side*.16*scale+.025*scale,-.015*scale,.115*scale,.045*scale,'#17252a',false)}parent.add(group);return group}\nfunction createAvatar(p){const root=new THREE.Group(),body=new THREE.Group();body.name='body';root.add(body);const s=shadow(root,0,0,.48,.4);mesh(body,'cone',[0,.62,0],[.5,1.15,.45],p.color);orb(body,0,1.2,0,.38,'#142c35');mesh(body,'cone',[0,1.48,-.04],[.44,.55,.4],'#263e46');const eyes=makeEyes(body,1.26,.31,1.05);const left=orb(root,-.19,.16,0,.14,'#162831');left.name='leftFoot';const right=orb(root,.19,.16,0,.14,'#162831');right.name='rightFoot';const hand=orb(body,.48,.88,.1,.13,p.color);hand.name='hand';const flame=new THREE.Group();flame.position.set(.5,1.17,.1);const stick=mesh(flame,'cylinder',[0,-.15,0],[.022,.35,.022],'#e3cf9d');const fire=mesh(flame,'sphere',[0,.05,0],[.1,.19,.1],'#ffce72',false);fire.material=mat('#ffda83',true);orb(flame,0,.03,.02,.05,'#fff4cd',false).material=mat('#fff5bd',true);body.add(flame);flame.visible=false;\n const hold=new THREE.Group();hold.position.set(-.48,.85,.05);body.add(hold);const idle=new THREE.AnimationClip('breath',2.4,[new THREE.NumberKeyframeTrack('body.position[y]',[0,1.2,2.4],[0,.075,0]),new THREE.NumberKeyframeTrack('eyes.scale[y]',[0,2,2.08,2.18,2.4],[1,1,.06,1,1])]);const mixer=new THREE.AnimationMixer(root);mixer.clipAction(idle).play();const walk=mixer.clipAction(new THREE.AnimationClip('walk',.6,[new THREE.NumberKeyframeTrack('leftFoot.position[z]',[0,.15,.3,.45,.6],[0,.18,0,-.18,0]),new THREE.NumberKeyframeTrack('rightFoot.position[z]',[0,.15,.3,.45,.6],[0,-.18,0,.18,0]),new THREE.NumberKeyframeTrack('body.rotation[z]',[0,.15,.3,.45,.6],[0,.055,0,-.055,0])]));walk.play();mixers.push(mixer);root.userData={body,eyes,flame,fire,hand,hold,walk,mixer,shadow:s,carry:null};scene.add(root);avatars.set(p.id,root);return root}\nfunction makeCreature(e,add=true){const root=new THREE.Group(),body=new THREE.Group();body.name='body';root.add(body);shadow(root,0,0,e.type==='ghost'?.7:.5,.22);\n if(e.type==='ghost'){orb(body,0,1.25,0,.58,'#b5bac3');mesh(body,'cone',[0,.85,0],[.68,1.45,.61],'#b5bac3');for(let i=0;i<7;i++)orb(body,Math.sin(i/7*Math.PI*2)*.5,.28,Math.cos(i/7*Math.PI*2)*.42,.2,'#b5bac3');makeEyes(body,1.35,.52,.95,false);orb(body,0,1.05,.59,.09,'#293c48',false);beam(body,[-.4,1.1,0],[-.8,.8,.15],.14,'#b5bac3');beam(body,[.4,1.1,0],[.8,.8,.15],.14,'#b5bac3');nativeAnimation(root,new THREE.AnimationClip('haunting',3,[new THREE.NumberKeyframeTrack('body.position[y]',[0,1.5,3],[.1,.4,.1]),new THREE.NumberKeyframeTrack('body.rotation[z]',[0,1.5,3],[-.08,.08,-.08])]));}\n if(e.type==='bat'){orb(body,0,1.6,0,.24,'#574e68');mesh(body,'cone',[-.14,1.87,0],[.13,.28,.12],'#574e68');mesh(body,'cone',[.14,1.87,0],[.13,.28,.12],'#574e68');makeEyes(body,1.67,.2,.55);for(const side of [-1,1]){const wing=new THREE.Group();wing.name=side<0?'wingL':'wingR';wing.position.set(side*.18,1.6,0);const sh=new THREE.Shape();sh.moveTo(0,0);sh.lineTo(.95*side,.45);sh.lineTo(.8*side,-.15);sh.quadraticCurveTo(.53*side,.1,.43*side,-.3);sh.quadraticCurveTo(.2*side,-.1,0,-.25);sh.closePath();const w=new THREE.Mesh(new THREE.ShapeGeometry(sh),new THREE.MeshBasicMaterial({color:0x71607e,side:THREE.DoubleSide}));wing.add(w);for(const n of [0,.43,.95])beam(wing,[0,0,.01],[n*side,n===.95?.45:-.25,.01],.017,'#15252e');body.add(wing)}nativeAnimation(root,new THREE.AnimationClip('flutter',.34,[new THREE.NumberKeyframeTrack('wingL.rotation[y]',[0,.17,.34],[-.65,.7,-.65]),new THREE.NumberKeyframeTrack('wingR.rotation[y]',[0,.17,.34],[.65,-.7,.65]),new THREE.NumberKeyframeTrack('body.position[y]',[0,.17,.34],[0,.1,0])]));}\n if(e.type==='spider'){orb(body,0,.5,0,.41,'#746283');orb(body,0,.43,.34,.26,'#9e87a1');makeEyes(body,.47,.54,.6);const tracks=[];for(let i=0;i<4;i++)for(const side of [-1,1]){const leg=new THREE.Group();leg.name='leg'+i+'_'+side;leg.position.set(side*.25,.45,(i-1.5)*.18);beam(leg,[0,0,0],[side*.48,.13,(i-1.5)*.19],.037,'#574b68');beam(leg,[side*.48,.13,(i-1.5)*.19],[side*.68,-.36,(i-1.5)*.28],.03,'#574b68');body.add(leg);const a=i%2?.1:-.1;tracks.push(new THREE.NumberKeyframeTrack(leg.name+'.rotation[y]',[0,.3,.6],[a,-a,a]))}nativeAnimation(root,new THREE.AnimationClip('skitter',.6,tracks));}\n if(add)scene.add(root);return root}\nfunction makeItem(id){const root=new THREE.Group();if(id==='key'){ring(root,0,.25,0,.2,'#f2c56c').rotation.x=0;beam(root,[0,.08,0],[0,-.47,0],.055,'#efc477');mesh(root,'box',[.1,-.35,0],[.2,.08,.08],'#efc477');mesh(root,'box',[.1,-.48,0],[.2,.08,.08],'#efc477')}\n else if(id==='ward'){beam(root,[0,-.5,0],[0,.45,0],.055,'#d3af74');const jewel=mesh(root,'sphere',[0,.55,0],[.19,.27,.19],'#9ee7c7');jewel.material=mat('#a2ead0',true);ring(root,0,.55,0,.3,'#d6b679').rotation.x=.2;}\n else{const i=Number(id.at(-1));const g=new THREE.CylinderGeometry(i===0?.32:.26,i===2?.15:.36,.5,7,1,true,0,Math.PI*1.55);const piece=new THREE.Mesh(g,mat('#e1b46f'));piece.rotation.z=.25;root.add(piece);ring(root,0,.2,0,.3,'#f2d494');mesh(root,'box',[-.13,.05,.28],[.08,.3,.06],'#4c8a82',false)}return root}\nfunction candle(parent,x,z,safe=false){const base=mesh(parent,'cylinder',[x,.13,z],[safe?.38:.15,.2,safe?.38:.15],'#b39765');mesh(parent,'cylinder',[x,safe?.65:.4,z],[.09,safe?.9:.5,.09],'#edddb3');const f=orb(parent,x,safe?1.17:.73,z,.1,'#f1c16f',false);f.scale.y=1.8;f.material=mat('#ffda91',true);if(safe){ring(parent,x,.08,z,1.75,'#bba56e');for(let i=0;i<8;i++)flat(parent,x+Math.sin(i*Math.PI/4)*1.55,z+Math.cos(i*Math.PI/4)*1.55,.12,.12,'#d1b985',.1)}}\nfunction windowModel(parent,x,y,z,rot=0,lit=true){const g=new THREE.Group();g.position.set(x,y,z);g.rotation.y=rot;mesh(g,'box',[0,0,0],[1.35,2,.16],'#102d37');const pane=mesh(g,'box',[0,0,.11],[1.05,1.65,.06],lit?'#e3b36a':'#688e88',false);if(lit)pane.material=mat('#f0c379',true);mesh(g,'box',[0,0,.18],[.08,1.7,.08],'#273f48');mesh(g,'box',[0,0,.19],[1.1,.09,.08],'#273f48');mesh(g,'box',[0,-1,.12],[1.6,.15,.4],'#a6a88a');parent.add(g);return g}\nfunction roof(parent,x,y,z,w,h,d,hex){const v=[-w/2,0,-d/2,w/2,0,-d/2,0,h,-d/2,-w/2,0,d/2,w/2,0,d/2,0,h,d/2];const geo=new THREE.BufferGeometry();geo.setAttribute('position',new THREE.Float32BufferAttribute(v,3));geo.setIndex([0,2,1,3,4,5,0,3,5,0,5,2,2,5,4,2,4,1,0,1,4,0,4,3]);geo.computeVertexNormals();const m=new THREE.Mesh(geo,mat(hex));m.position.set(x,y,z);parent.add(m);const edge=new THREE.LineSegments(new THREE.EdgesGeometry(geo),new THREE.LineBasicMaterial({color:0x071820}));m.add(edge);return m}\nfunction tree(parent,x,z,h=8){const g=new THREE.Group();g.position.set(x,0,z);beam(g,[0,0,0],[.2,h*.65,0],.24,'#244148');beam(g,[.2,h*.65,0],[-.5,h,0],.1,'#244148');for(const [s,k] of [[-1,.4],[1,.55],[-1,.73]]){const by=h*k;beam(g,[.1,by,0],[s*2.2,by+1.4,.1],.1,'#244148');beam(g,[s*1.4,by+.9,0],[s*1.6,by+2.1,.4],.055,'#244148');beam(g,[s*2.1,by+1.3,.1],[s*2.8,by+1.7,-.5],.04,'#244148')}parent.add(g);return g}\nfunction furniture(g,p,f){const {x,z,k}=p;if(k==='bookcase'){mesh(g,'box',[x,1.1,z],[p.w,2.2,p.d],'#31464c');for(let r=0;r<3;r++){mesh(g,'box',[x,.4+r*.7,z],[p.w+.1,.08,p.d+.08],'#88886c');for(let i=0;i<5;i++){const m=mesh(g,'box',[x+((i%2)*.12),.67+r*.7,z-p.d/2+.23+i*.48],[p.w*.8,.47,.22],['#94736f','#b39b74','#486d69','#6c6e86'][((r+i+f)%4)]);m.rotation.x=(i%3-1)*.07}}}\n if(k==='desk'){mesh(g,'box',[x,.9,z],[p.w,.17,p.d],'#8a8071');for(const s of [-1,1])mesh(g,'box',[x+s*p.w*.4,.45,z],[.15,.9,p.d*.7],'#3b5256');flat(g,x-.35,z,.75,.6,'#e0d4b0',1.01);candle(g,x+.8,z)}\n if(k==='piano'){mesh(g,'box',[x,1.05,z],[p.w,1.7,p.d],'#293945');mesh(g,'box',[x,1.02,z+.8],[p.w*.94,.09,.45],'#b7b89e');for(let i=0;i<12;i++)flat(g,x-p.w*.44+i*.23,z+.8,.025,.45,'#27383f',1.1);mesh(g,'box',[x,.45,z+1.15],[1.3,.24,.55],'#574c63');}\n if(k==='table'){mesh(g,'box',[x,1,z],[p.w,.2,p.d],'#827862');for(const sx of [-1,1])for(const sz of [-1,1])mesh(g,'box',[x+sx*p.w*.39,.5,z+sz*p.d*.35],[.15,1,.15],'#3d5053');flat(g,x,z,1.7,1.4,f===0?'#68576d':'#75887c',1.12);for(const sx of [-1,1]){const plate=mesh(g,'cylinder',[x+sx*.95,1.14,z],[.27,.025,.27],'#c1c2a4',false);mesh(g,'box',[x+sx*2,.6,z],[.65,.2,.7],'#516466');mesh(g,'box',[x+sx*2,1,z-.28],[.65,.8,.12],'#516466')};candle(g,x,z)}\n if(k==='sofa'){mesh(g,'box',[x,.52,z],[p.w,.7,p.d],'#765971');mesh(g,'box',[x-p.w*.35,1,z],[.25,.9,p.d],'#56425c');for(const s of [-1,1])mesh(g,'box',[x,.8,z+s*p.d*.43],[p.w,1,.25],'#765971');for(let i=0;i<3;i++)mesh(g,'box',[x+.13,.92,z+(i-1)*.73],[p.w*.65,.18,.65],'#99758c')}\n if(k==='plant'){mesh(g,'cone',[x,.5,z],[.55,.8,.55],'#927868').rotation.z=Math.PI;for(let i=0;i<6;i++){const a=i*Math.PI/3;const leaf=mesh(g,'sphere',[x+Math.sin(a)*.36,1.35+i*.05,z+Math.cos(a)*.36],[.2,.7,.12],i%2?'#548a7a':'#7aa087');leaf.rotation.z=Math.sin(a)*.5;leaf.rotation.y=a}}\n if(k==='altar'){mesh(g,'box',[x,.6,z],[p.w,1.1,p.d],'#55666a');mesh(g,'box',[x,1.2,z],[p.w+.25,.18,p.d+.2],'#a9a78c');mesh(g,'cylinder',[x,1.4,z],[.43,.25,.43],'#a58763');for(const s of [-1,1])candle(g,x+s*.8,z)}\n if(k==='clock'){mesh(g,'box',[x,1.1,z],[.7,2.2,.6],'#525362');const face=mesh(g,'cylinder',[x,1.7,z+.35],[.36,.06,.36],'#d5c9a4');face.rotation.x=Math.PI/2;beam(g,[x,1.7,z+.4],[x+.13,1.83,z+.4],.023,'#293b42');beam(g,[x,1.7,z+.4],[x,1.45,z+.4],.018,'#293b42');const pend=orb(g,x,.7,z+.35,.12,'#baa168');pend.name='pendulum'+f;nativeAnimation(g,new THREE.AnimationClip('tick'+f,2,[new THREE.NumberKeyframeTrack(pend.name+'.position[x]',[0,1,2],[x-.14,x+.14,x-.14])]))}\n}\nfunction buildInterior(f){if(interior){scene.remove(interior);for(const m of [...mixers])if(m.getRoot()===interior){mixers.splice(mixers.indexOf(m),1)}}interior=new THREE.Group();interior.name='floor'+f;scene.add(interior);const palette=[['#6e7b71','#3a6263','#5e475d'],['#6c6370','#4e626f','#7c5669'],['#657570','#456369','#41645e'],['#73746b','#475b65','#645567']][f];mesh(interior,'box',[0,-.4,0],[30.8,.8,20.8],'#344d53');for(let r=0;r<6;r++){const [x,z]=ROOM_CENTERS[r];flat(interior,x,z,9.8,9.8,palette[0],.02);for(let i=0;i<10;i++)flat(interior,x-4.5+i,z,.025,9.7,'#3d5655',.07);flat(interior,x,z,5.2,4.9,palette[2],.1);flat(interior,x,z,4.85,4.55,r===4?'#8b7568':palette[2],.13);for(const s of [-1,1]){flat(interior,x+s*2.22,z,.055,4.2,'#a69379',.17);flat(interior,x,z+s*2.05,4.45,.055,'#a69379',.17)}}\n for(const b of game.boxes.slice(0,24)){const exteriorWall=Math.abs(b.x)>14||Math.abs(b.z)>9;const front=b.z>9||b.x>14;const height=front?.65:exteriorWall?3.3:1.45;mesh(interior,'box',[b.x,height/2+.12,b.z],[b.w,height,b.d],palette[1]);mesh(interior,'box',[b.x,height+.15,b.z],[b.w+.09,.12,b.d+.09],'#87958a')}\n for(const x of [-15,-5,5,15])for(const z of [-10,0,10]){mesh(interior,'box',[x,1.05,z],[.5,2.05,.5],'#45646a');mesh(interior,'box',[x,2.1,z],[.65,.16,.65],'#a6aa8b')}\n for(const x of [-10,0,10]){windowModel(interior,x,1.75,-9.78,0,false);for(const sx of [-1,1])mesh(interior,'box',[x+sx*.98,1.7,-9.7],[.47,2.4,.15],palette[2])}\n for(const p of PROP_BOXES)furniture(interior,p,f);\n candle(interior,0,5,true);\n for(const s of STAIRS.filter(s=>s.f===f)){const g=new THREE.Group();for(let i=0;i<5;i++)mesh(g,'box',[s.x-1+i*.4,.08+i*.13,s.z],[.39,.16+i*.26,1.4],s.to>f?'#8e9282':'#435f66');ring(g,s.x,.1,s.z,1.4,'#c4ad73');if(s.locked&&\"'!game.unlocked){mesh(g,'\"'box',[s.x,1,s.z-.85],[2.3,1.9,.15],'#715e55');orb(g,s.x,.9,s.z-.7,.15,'#dfb777')};interior.add(g)}\n if(f===0){flat(interior,0,9,2.4,1.4,'#c2aa7c',.15);mesh(interior,'box',[-1.65,1.5,10],[.4,3,.4],'#3c5f62');mesh(interior,'box',[1.65,1.5,10],[.4,3,.4],'#3c5f62');mesh(interior,'box',[0,3,10],[3.7,.3,.4],'#859486');if(game.banked.length<3){const door=mesh(interior,'box',[0,1.45,10],[2.8,2.8,.17],'#243f49');mesh(door,'box',[.3,0,-.9],[.08,.09,.07],'#d3b06f')}}\n NOTES.forEach(n=>{if(n.f===f){const note=flat(interior,n.x,n.z,.65,.5,'#e1d4ab',.16);note.rotation.y=-.25;for(let i=0;i<3;i++)flat(interior,n.x,n.z-.13+i*.12,.38,.017,'#817c64',.2)}});\n if(f===3){beam(interior,[-14,2.7,-9],[14,2.7,-9],.12,'#38505b');for(const x of [-10,0,10]){beam(interior,[x-4,2.8,-9],[x,5,-9],.1,'#52636a');beam(interior,[x,5,-9],[x+4,2.8,-9],.1,'#52636a')}}\n renderFloor=f;lastRevision=game.revision;\n}\nfunction buildExterior(){exterior=new THREE.Group();scene.add(exterior);mesh(exterior,'cylinder',[0,-1.3,0],[23,1.7,17],'#1b3a44');mesh(exterior,'cylinder',[0,-.43,0],[22.8,.2,16.8],'#365957');mesh(exterior,'box',[0,5,0],[26,10,16],'#416266');for(const y of [.2,3.2,6.4,9.7])mesh(exterior,'box',[0,y,0],[26.5,.26,16.5],'#8b9d8e');for(let i=0;i<11;i++){mesh(exterior,'box',[-12.5+i*2.5,4.9,8.1],[.12,9.7,.12],'#2b4853',false)}roof(exterior,0,10,0,28,5.5,18,'#244c57');for(const z of [-8.8,8.8])beam(exterior,[-14,10,z],[0,15.5,z],.1,'#8da092');for(const z of [-8.8,8.8])beam(exterior,[0,15.5,z],[14,10,z],.1,'#8da092');for(let i=0;i<7;i++){const t=(i+1)/8;for(const side of [-1,1])beam(exterior,[side*14*(1-t),10+5.5*t,-8.8],[side*14*(1-t),10+5.5*t,8.8],.034,'#466e70')}\n for(const y of [1.7,4.9,8])for(const x of [-9,-4.5,4.5,9])windowModel(exterior,x,y,8.16,0,(x+y)%3>-.5);for(const y of [1.7,4.9,8])for(const z of [-5,0,5])windowModel(exterior,13.1,y,z,Math.PI/2,true);\n for(const [x,z,h] of [[-11,-5,14.6],[11,-5,13.5]]){mesh(exterior,'cylinder',[x,h/2,z],[2.3,h,2.3],'#45646b');for(let i=0;i<3;i++){const yy=2+i*4;windowModel(exterior,x,yy,z+2.28,0,true)}mesh(exterior,'cone',[x,h+2.5,z],[3.25,5.5,3.25],'#28515c');orb(exterior,x,h+5.3,z,.18,'#c6b67f');beam(exterior,[x,h+5,z],[x,h+6,z],.04,'#c6b67f')}\n mesh(exterior,'box',[0,1.6,8.22],[2.8,3.2,.24],'#152f3b');roof(exterior,0,3.5,9,5,1.5,3,'#37545d');for(const x of [-2,2])mesh(exterior,'cylinder',[x,1.6,9.8],[.15,3.2,.15],'#b4b597');mesh(exterior,'box',[0,.15,9.4],[5,.3,3],'#7a8b83');for(let i=0;i<4;i++)mesh(exterior,'box',[0,-.05-i*.06,11+i*.6],[5+i*.2,.2,.65],'#6b7e76');\n for(let i=0;i<8;i++)flat(exterior,Math.sin(i*.8)*.3,13+i*.8,2.4,.55,'#728777',-.25);\n for(const x of [-20,19]){tree(exterior,x,3,x<0?9:8);tree(exterior,x*1.04,-12,7)}for(let i=0;i<10;i++){const x=-17+i*3.7;beam(exterior,[x,-.25,13],[x,1.4,13],.06,'#17343d');mesh(exterior,'cone',[x,1.55,13],[.16,.4,.16],'#688b83');if(i<9)for(const y of [.4,1])beam(exterior,[x,y,13],[x+3.7,y,13],.045,'#17343d')}\n for(const x of [-17,17]){const grave=mesh(exterior,'box',[x,.4,7],[1.1,1.1,.25],'#799184');grave.rotation.z=x>0?.1:-.15;beam(exterior,[x,.2,7.15],[x,.8,7.15],.035,'#39585c');beam(exterior,[x-.2,.6,7.15],[x+.2,.6,7.15],.03,'#39585c')}\n for(let i=0;i<3;i++){const bat=makeCreature({type:'bat'},false);bat.position.set(12+i*2,12+i,5);bat.userData.orbit=i;exterior.add(bat)}\n moon=orb(scene,1,19,-25,4.8,'#d0c894',false);moon.material=mat('#d8cf9d',true);for(let i=0;i<7;i++)orb(moon,Math.sin(i*8.2)*.5,Math.cos(i*7.9)*.4,.88,.07+i*.005,'#aaa984',false);const halo=new THREE.Mesh(new THREE.RingGeometry(5.6,5.63,80),new THREE.MeshBasicMaterial({color:0x789583,transparent:true,opacity:.3,side:THREE.DoubleSide}));halo.position.copy(moon.position);halo.lookAt(30,30,40);scene.add(halo);\n weather=new THREE.Group();scene.add(weather);for(let i=0;i<38;i++){const a=i*2.399;const cloud=orb(weather,Math.sin(a)*31,-2.7+Math.sin(i)*.4,Math.cos(a)*24,.8+(i%4)*.7,i%2?'#23474c':'#1c3c47',false);cloud.scale.set(5,1,2.5)}\n}\nfunction buildWorld(){scene=new THREE.Scene();scene.background=new THREE.Color('#0c2933');scene.fog=new THREE.FogExp2('#0c2933',.006);camera=new THREE.OrthographicCamera(-25,25,15,-15,.1,180);buildExterior();buildInterior(0);interior.visible=false;for(const e of game.enemies){const m=makeCreature(e);enemyModels.set(e.id,m);m.visible=false}for(const i of game.items){const m=makeItem(i.id);scene.add(m);itemModels.set(i.id,m);m.visible=false}const g=new THREE.BufferGeometry(),positions=[];for(let i=0;i<100;i++)positions.push(Math.sin(i*7.3)*23,1+((i*17)%100)*.12,Math.cos(i*3.8)*19);g.setAttribute('position',new THREE.Float32BufferAttribute(positions,3));const dust=new THREE.Points(g,new THREE.PointsMaterial({color:0xced6ac,size:.05,transparent:true,opacity:.6}));scene.add(dust);view.pos.set(31,25,37);view.target.set(-6,4,0);camera.position.copy(view.pos);camera.lookAt(view.target);resize();}\nfunction resize(){if(\"'!renderer||!camera)return;const w=innerWidth,h=innerHeight,a=w/h;renderer.setSize(w,h);const vh=screen==='\"'title'?a<1?44:30:a<1?47:29;camera.left=-vh*a/2;camera.right=vh*a/2;camera.top=vh/2;camera.bottom=-vh/2;camera.updateProjectionMatrix()}\nfunction effect(type,p){if(\"'!p)return;if(type==='\"'pulse'){const m=ring(scene,p.x,.17,p.z,.5,'#a9efd1');effects.push({m,life:1.2,max:1.2,kind:'pulse',f:p.f})}if(type==='bank'){for(let i=0;i<18;i++){const m=orb(scene,0,1.5,7.2,.07,'#efd38a',false);m.material=mat('#f3d993',true);effects.push({m,life:1.8,max:1.8,kind:'spark',vx:Math.sin(i)*2,vy:1+i%3,vz:Math.cos(i)*2,f:0})}}}\nfunction updateVisuals(dt){const title=screen==='title'&&\"'!attract;exterior.visible=title;interior.visible=!title;moon.visible=true;shaderAmbient.value=title?.94:settings.contrast?.88:.72;const p=localPlayer();if(!title&&p&&(p.f!==renderFloor||game.revision!==lastRevision))buildInterior(p.f);if(!title&&!p&&game.players[0]){if(game.players[0].f!==renderFloor)buildInterior(game.players[0].f)}\n const desiredTarget=title?new THREE.Vector3(-7,5,0):new THREE.Vector3(0,.3,0),desiredPos=title?new THREE.Vector3(29,27,39):new THREE.Vector3(28,39,37);const lerp=settings.motion?1-Math.exp(-dt*2.6):1;view.target.lerp(desiredTarget,lerp);view.pos.lerp(desiredPos,lerp);camera.position.copy(view.pos);camera.lookAt(view.target);if(view.shake>0&&settings.motion){camera.position.x+=Math.sin(performance.now()*.06)*view.shake;camera.position.y+=Math.cos(performance.now()*.08)*view.shake;view.shake=Math.max(0,view.shake-dt*.7)}\n if(p){shaderLight.value.set(p.x,1,p.z);shaderFlame.value=p.match>0?1:.03}\n for(const player of game.players){const root=avatars.get(player.id)||createAvatar(player);root.visible=!title&&player.f===renderFloor;root.position.set(player.x,0,player.z);root.userData.body.rotation.y=Math.sin(player.angle)*.13;root.userData.eyes.rotation.y=.64;root.userData.flame.visible=player.match>0;root.userData.fire.scale.y=.18+Math.sin(performance.now()*.029)*.035;root.userData.walk.setEffectiveWeight(player.moving?1:0);if(player.invuln>0&&Math.floor(performance.now()/110)%2===0){root.userData.body.visible=false}else root.userData.body.visible=true;if(root.userData.carry!==player.carry){root.userData.hold.clear();if(player.carry){const m=makeItem(player.carry);m.scale.setScalar(.65);root.userData.hold.add(m)}root.userData.carry=player.carry}}\n for(const [id,root] of avatars)if(!game.players.some(p=>p.id===id)){scene.remove(root);avatars.delete(id)}\n for(const e of game.enemies){const m=enemyModels.get(e.id);if(!m)continue;m.visible=!title&&e.f===renderFloor;m.position.set(e.x,0,e.z);m.rotation.y=e.type==='\"'ghost'?.55:Math.sin(game.time*.8+e.id)*.3+.6;m.rotation.z=e.stun>0?Math.sin(game.time*8)*.15:0;const near=p?dist(p,e):99;const illumination=p?.match>0||settings.contrast||game.reveal||e.mode==='chase'||near<2.5;m.children[0].visible=illumination;m.scale.setScalar(e.stun>0?.86:1)}\n for(const i of game.items){const m=itemModels.get(i.id);m.visible=\"'!title&&i.f===renderFloor&&i.holder===null&&!i.banked;m.position.set(i.x,1.1+Math.sin(game.time*2+i.id.length)*.12,i.z);m.rotation.y=game.time*.7;if(i.id==='\"'key'&&i.f===0)m.position.y+=.45}\n for(const m of mixers)m.update(dt*(settings.motion?1:.25));for(const child of exterior.children)if(child.userData.orbit\"'!==undefined){const i=child.userData.orbit;child.position.x=5+Math.sin(titleTime*.35+i*2)*13;child.position.z=3+Math.cos(titleTime*.35+i*2)*8;child.position.y=12+Math.sin(titleTime+i)*1.3}\n if(weather)weather.rotation.y=Math.sin(titleTime*.025)*.03;\n for(let i=effects.length-1;i>=0;i--){const e=effects[i];e.life-=dt;e.m.visible=e.f===renderFloor;if(e.kind==='\"'pulse'){e.m.scale.setScalar(1+(1-e.life/e.max)*12);e.m.position.y=.1+(1-e.life/e.max)*.2}else{e.m.position.x+=e.vx*dt;e.m.position.y+=e.vy*dt;e.m.position.z+=e.vz*dt;e.vy-=dt*2}if(e.life<=0){scene.remove(e.m);e.m.geometry.dispose();effects.splice(i,1)}}\n}\n\nclass HouseAudio{\n constructor(){this.ctx=null;this.master=null;this.musicGain=null;this.sfxGain=null;this.analyser=null;this.notesPlayed=0;this.effectsPlayed=0;this.voicesPlayed=0;this.step=0;this.nextNote=0;this.muted=false;this.active=[];}\n async unlock(){if(\"'!this.ctx){const Audio=window.AudioContext||window.webkitAudioContext;if(!Audio)return;this.ctx=new Audio();this.master=this.ctx.createGain();this.master.gain.value=.65;this.musicGain=this.ctx.createGain();this.sfxGain=this.ctx.createGain();this.musicGain.connect(this.master);this.sfxGain.connect(this.master);this.analyser=this.ctx.createAnalyser();this.analyser.fftSize=256;this.master.connect(this.analyser);this.analyser.connect(this.ctx.destination);this.updateVolumes();this.nextNote=this.ctx.currentTime+.15}if(this.ctx.state==='\"'suspended')await this.ctx.resume();audioReady=true;}\n updateVolumes(){if(this.ctx){this.musicGain.gain.setTargetAtTime(settings.music,this.ctx.currentTime,.06);this.sfxGain.gain.setTargetAtTime(settings.sfx,this.ctx.currentTime,.06)}}\n tone(freq,duration=.2,type='sine',volume=.2,when=0,target='sfx',endFreq=null){if(\"'!this.ctx||this.muted)return;const t=when||this.ctx.currentTime,osc=this.ctx.createOscillator(),g=this.ctx.createGain();osc.type=type;osc.frequency.setValueAtTime(freq,t);if(endFreq)osc.frequency.exponentialRampToValueAtTime(Math.max(1,endFreq),t+duration);g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(Math.max(.0002,volume),t+.015);g.gain.exponentialRampToValueAtTime(.0001,t+duration);osc.connect(g);g.connect(target==='\"'music'?this.musicGain:this.sfxGain);osc.start(t);osc.stop(t+duration+.03);osc.onended=()=>{osc.disconnect();g.disconnect()};}\n noise(duration=.3,volume=.15,cutoff=1500){if(\"'!this.ctx||this.muted)return;const count=Math.ceil(this.ctx.sampleRate*duration),buffer=this.ctx.createBuffer(1,count,this.ctx.sampleRate),d=buffer.getChannelData(0);let s=.31;for(let i=0;i<count;i++){s=(s*16807)%2147483647;d[i]=(s/1073741823.5-1)*(1-i/count)}const src=this.ctx.createBufferSource(),g=this.ctx.createGain(),filter=this.ctx.createBiquadFilter();src.buffer=buffer;filter.type='\"'lowpass';filter.frequency.value=cutoff;g.gain.value=volume;src.connect(filter);filter.connect(g);g.connect(this.sfxGain);src.start();src.onended=()=>{src.disconnect();filter.disconnect();g.disconnect()}}\n voice(seed=0){if(\"'!this.ctx||this.muted)return;this.voicesPlayed++;const t=this.ctx.currentTime;for(let i=0;i<5;i++){const base=155+(seed*37+i*53)%130;this.tone(base,.075+(i%2)*.03,'\"'sawtooth',.025,t+i*.105,'sfx',base*1.2);this.tone(base*3,.06,'sine',.055,t+i*.105+.01)}}\n play(type){if(\"'!this.ctx||this.muted)return;this.effectsPlayed++;const t=this.ctx.currentTime;if(type==='\"'match'){this.noise(.18,.4,4000);this.tone(760,.12,'triangle',.08,t+.03, 'sfx',170)}else if(type==='pickup'||type==='unlock'){for(let i=0;i<3;i++)this.tone([440,660,880][i],.22,'triangle',.16,t+i*.08)}else if(type==='bank'||type==='win'){for(let i=0;i<6;i++)this.tone([261.63,329.63,392,523.25,659.25,783.99][i],.8,'sine',.18,t+i*.1);this.voice(7)}else if(type==='pulse'){this.tone(110,.8,'sine',.4,t,'sfx',880);this.noise(.6,.08,2500)}else if(type==='hit'||type==='lose'){this.tone(100,.65,'sawtooth',.16,t,'sfx',35);this.noise(.35,.3,500);this.voice(2)}else if(type==='wind'||type==='snuff'){this.noise(type==='wind'?2:.4,.2,800)}else if(type==='stair'){this.tone(140,.3,'triangle',.2,t,'sfx',90);this.noise(.15,.09,400)}else if(type==='rest'){this.tone(330,.6,'sine',.13);this.tone(495,.7,'sine',.1,t+.1)}else if(type==='note'){this.noise(.17,.09,3500);this.voice(3)}else if(type==='click'){this.tone(360,.06,'triangle',.08)}}\n update(){if(\"'!this.ctx||this.muted||this.ctx.state!=='\"'running')return;const t=this.ctx.currentTime;if(this.nextNote<t-.5)this.nextNote=t+.05;const melody=[0,7,10,14,12,7,3,7,0,7,10,15,14,10,7,3],base=146.832;let safety=0;while(this.nextNote<t+.2&&safety++<5){const i=this.step%melody.length;this.tone(base*Math.pow(2,melody[i]/12),1.5,'triangle',.15,this.nextNote,'music');if(i%4===0){this.tone(base/2*Math.pow(2,([0,0,-2,-5][Math.floor(i/4)])/12),2.4,'sine',.2,this.nextNote,'music')}this.step++;this.notesPlayed++;this.nextNote+=.46}}\n stop(){this.muted=true;if(this.ctx)this.master.gain.setTargetAtTime(0,this.ctx.currentTime,.03)}\n levels(){if(\"'!this.analyser)return 0;const d=new Uint8Array(this.analyser.fftSize);this.analyser.getByteTimeDomainData(d);return Math.sqrt(d.reduce((s,v)=>s+(v-128)**2,0)/d.length)/128}\n}\nconst audio=new HouseAudio();\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
