{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"sed -n '110,175p' vendor/harness.html\"","aggregated_output":"}\n\n/**\n * For a game tagged parallel or ghost, the seed rides in the address: the client seeds Math.random with it before the game's scripts run.\n * Only a page of this site is loaded: ?game= comes from the address bar, and a javascript: or another site's\n * address in an unsandboxed frame would run as this origin, where a signed-in player's session is kept.\n */\nconst gameUrl = (game, { tag, seed } = {}) => {\n  let url;\n  try {\n    url = new URL(game, location.href);\n  } catch {\n    return null;\n  }\n  if (url.origin !== location.origin || !/^https?:$/.test(url.protocol)) return null;\n  url.searchParams.set('aihub', '1');\n  if (seedsRandom(tag)) url.searchParams.set('aihub-seed', String(seed >>> 0));\n  return url.href;\n};\n\nfunction applyNet() {\n  Object.assign(net.settings, {\n    latency: Math.max(0, Number($('latency').value) || 0),\n    jitter: Math.max(0, Number($('jitter').value) || 0),\n    loss: Math.min(0.5, Math.max(0, (Number($('loss').value) || 0) / 100)),\n  });\n}\n\n/** Wrap what a game must not call in hub mode, where the page can reach it. */\nfunction instrument(cell) {\n  try {\n    const win = cell.frame.contentWindow;\n    for (const name of ['alert', 'confirm', 'prompt', 'open']) {\n      const original = win[name];\n      win[name] = (...args) => {\n        cell.violations.push(`${name}() called`);\n        log(`${cell.name}: ${name}() called — not allowed in a session`);\n        return name === 'confirm' ? false : name === 'prompt' ? null : undefined;\n      };\n      void original;\n    }\n    win.addEventListener('error', (e) => cell.violations.push(`error: ${e.message}`));\n    win.addEventListener('unhandledrejection', (e) => cell.violations.push(`unhandled rejection: ${e.reason?.message || e.reason}`));\n  } catch {\n    cell.instrumented = false;\n  }\n}\n\nasync function newRound() {\n  endCurrent();\n  applyNet();\n  const game = $('game').value.trim();\n  if (!game) return null;\n  if (!gameUrl(game)) {\n    log(`Not loading ${game}: the harness only plays pages from this site.`);\n    return null;\n  }\n  const n = Math.max(1, Math.min(4, Number($('players').value) || 2));\n  const metas = await metasOf(game);\n  const mode = modeOf(metas?.mode);\n  const limitMs = params.has('limit') ? Number(params.get('limit')) * 1000 : limitFor(metas?.minutes);\n  const seed = params.has('seed') ? Number(params.get('seed')) >>> 0 : crypto.getRandomValues(new Uint32Array(1))[0];\n  const round = ++roundNo;\n  const players = Array.from({ length: n }, (_, slot) => ({ key: `p${slot}`, slot, name: NAMES[slot] }));\n  const hubEnd = net.endpoint('hub');\n  const grid = $('grid');\n","exit_code":0,"status":"completed"}}
