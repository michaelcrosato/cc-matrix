{"type":"item.started","item":{"id":"item_89","type":"command_execution","command":"/bin/bash -lc \"cat > tests/protocol-probe.py <<'EOF'\nfrom pathlib import Path\nfrom http.server import ThreadingHTTPServer,SimpleHTTPRequestHandler\nfrom functools import partial\nfrom urllib.parse import urlparse,unquote\nimport threading,json\nfrom playwright.sync_api import sync_playwright\nD=Path(__file__).resolve().parents[1];R=D.parent\nclass Quiet(SimpleHTTPRequestHandler):\n def log_message(self,*args):pass\ns=ThreadingHTTPServer(('127.0.0.1',0),partial(Quiet,directory=str(R)));threading.Thread(target=s.serve_forever,daemon=True).start()\ndef dep(route):\n path=unquote(urlparse(route.request.url).path)\n if '/three@0.180.0/build/' in path:f=D/'node_modules/three/build'/path.split('/')[-1]\n elif '/@dimforge/rapier3d-compat@0.19.3/' in path:f=D/'node_modules/@dimforge/rapier3d-compat'/path.split('/')[-1]\n else:route.continue_();return\n route.fulfill(path=str(f),content_type='text/javascript',headers={'Access-Control-Allow-Origin':'*'})\nwith sync_playwright() as p:\n try:\n  b=p.webkit.launch(headless=True);c=b.new_context(viewport={'width':960,'height':640});c.route('https://cdn.jsdelivr.net/npm/**',dep)\n  page=c.new_page();errs=[];page.on('pageerror',lambda e:errs.append(str(e)))\n  page.goto(f'http://127.0.0.1:{s.server_port}/{D.name}/vendor/harness.html?game=../../{D.name}.html%3Frenderer%3Dwebgl&players=2&auto=1&play=3000')\n  try:page.wait_for_function('document.body.dataset.complete===\\\"true\\\"',timeout=60000)\n  except:pass\n  print(json.dumps({'report':page.evaluate('window.__hubCheck'),'errors':errs},indent=2),flush=True)\n  b.close()\n except Exception as e:print(str(e))\ns.shutdown()\nEOF\n/home/micha/.local/share/pipx/venvs/playwright/bin/python tests/protocol-probe.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
