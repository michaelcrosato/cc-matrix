{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CghP2BA2AkZXCd85gdZ4F","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XjHxNrfLdeoafCvvXGWCVz","name":"Bash","input":{"command":"cat > tests/suites/01-voxel.test.mjs <<'EOF'\nimport { load } from '../lib/load.mjs';\nexport default async ({ check }) => {\n  const { E, DQ } = load({ quiet: true });\n  const T = 16, w = new DQ.VoxelWorld(32, 32, 16);\n  const id = DQ.blockId;\n  for (let y = 0; y < 32; y++) for (let x = 0; x < 32; x++) for (let z = 0; z < 4; z++) w.set(x, y, z, z ? id('earth') : 1, { silent: true });\n  w.recomputeTops();\n  check('get/set and bounds', w.get(5, 5, 3) === id('earth') && w.get(-1, 0, 0) === 0 && w.get(40, 0, 0) === 0 && !w.set(99, 0, 0, 2));\n  check('topZ kept on edit', w.topZ(5, 5) === 4 && (w.set(5, 5, 6, id('stone')), w.topZ(5, 5) === 7) && (w.set(5, 5, 6, 0), w.topZ(5, 5) === 4));\n  check('standable needs ground and two free levels', w.standable(5, 5, 4) && !w.standable(5, 5, 3) && (w.set(6, 6, 5, id('stone')), !w.standable(6, 6, 4)));\n  w.set(6, 6, 5, 0);\n  check('groundAt: the top under a point', w.groundAt(5.5 * T, 5.5 * T, 5, 4 * T, 2) === 4 * T);\n  w.set(8, 8, 4, id('stone'));\n  check('groundAt ignores a ledge above the step', w.groundAt(8.5 * T, 8.5 * T, 5, 4 * T, 2) === 4 * T || w.groundAt(8.5 * T, 8.5 * T, 5, 4 * T, 2) === -Infinity ? true : w.groundAt(8.5 * T, 8.5 * T, 5, 4 * T, 2) === 4 * T);\n  check('groundAt over a 1-block step from above', w.groundAt(8.5 * T, 8.5 * T, 5, 5 * T + 1, 2) === 5 * T);\n  w.set(10, 10, 7, id('stone'));\n  check('ceilingAt finds the block bottom', w.ceilingAt(10.5 * T, 10.5 * T, 5, 4 * T) === 7 * T);\n  // collision: a body walking into a 2-high wall stops; a 1-high gap blocks; a 2-high gap passes\n  for (let y = 12; y < 20; y++) { w.set(15, y, 4, id('stone')); w.set(15, y, 5, id('stone')); }\n  const b = new DQ.VoxelBody({ x: 13.5 * T, y: 15.5 * T, z: 4 * T });\n  for (let i = 0; i < 240; i++) { b.vx = 80; b.vy = 0; b.update(1 / 120, w); }\n  check('collide: a wall stops a body', b.x < 15 * T && b.x > 14 * T, b.x / T);\n  w.set(15, 15, 4, 0); w.set(15, 15, 5, 0); b.y = 15.5 * T;\n  for (let i = 0; i < 240; i++) { b.vx = 80; b.vy = 0; b.update(1 / 120, w); }\n  check('collide: a 2-high gap passes', b.x > 15.5 * T, b.x / T);\n  // a 1-high gap (a block at head height) blocks\n  const w2 = new DQ.VoxelWorld(16, 16, 12); for (let y = 0; y < 16; y++) for (let x = 0; x < 16; x++) for (let z = 0; z < 2; z++) w2.set(x, y, z, z ? 2 : 1, { silent: true });\n  w2.set(8, 5, 3, id('stone')); w2.recomputeTops(); const b2 = new DQ.VoxelBody({ x: 6.5 * T, y: 5.5 * T, z: 2 * T });\n  for (let i = 0; i < 240; i++) { b2.vx = 80; b2.vy = 0; b2.update(1 / 120, w2); }\n  check('collide: a 1-high gap blocks a 28-tall body', b2.x < 8 * T, b2.x / T);\n  // stairs: a ramp, walking up needs no jump\n  w2.set(10, 9, 2, id('stairsPlank'), { rot: 0 }); w2.set(11, 9, 2, id('stone')); w2.recomputeTops();\n  const b3 = new DQ.VoxelBody({ x: 9.5 * T, y: 9.5 * T, z: 2 * T });\n  for (let i = 0; i < 360; i++) { b3.vx = 50; b3.vy = 0; b3.update(1 / 120, w2); }\n  check('stairs: walking up a ramp onto the next block', b3.z >= 3 * T - .1, b3.z / T);\n  // water two deep blocks walkers\n  const w3 = new DQ.VoxelWorld(16, 16, 12); for (let y = 0; y < 16; y++) for (let x = 0; x < 16; x++) for (let z = 0; z < 3; z++) w3.set(x, y, z, z ? 2 : 1, { silent: true });\n  for (let y = 0; y < 16; y++) { w3.set(9, y, 2, id('water')); w3.set(9, y, 1, id('water')); } w3.recomputeTops();\n  const b4 = new DQ.VoxelBody({ x: 7.5 * T, y: 5.5 * T, z: 3 * T });\n  for (let i = 0; i < 240; i++) { b4.vx = 70; b4.vy = 0; b4.update(1 / 120, w3); }\n  check('deep water blocks the builder', b4.x < 9 * T + 1, b4.x / T);\n  // raycast and pick in every rotation and both views\n  const w5 = new DQ.VoxelWorld(32, 32, 16); for (let y = 0; y < 32; y++) for (let x = 0; x < 32; x++) for (let z = 0; z < 3; z++) w5.set(x, y, z, z ? 2 : 1, { silent: true });\n  w5.set(16, 16, 3, id('cobble')); w5.recomputeTops();\n  const hit = w5.raycast([16.5 * T, 16.5 * T, 10 * T], [0, 0, -1], 400);\n  check('raycast down hits the top block with an up normal', hit && hit.z === 3 && hit.nz === 1, JSON.stringify(hit));\n  let pickOk = 0, pickN = 0;\n  for (const base of [DQ.VIEW_ISO, DQ.VIEW_TQ]) for (const yaw of [0, 90, 180, 270]) {\n    const v = new E.View('t', 't', base.yawDeg + yaw, base.pitchDeg, base.scale, base.zBoost), p = v.p(16.5 * T, 16.5 * T, 4 * T);\n    const h = w5.pickScreen(p[0], p[1], v, 0, 0); pickN++; if (h && h.x === 16 && h.y === 16 && h.z === 3) pickOk++;\n  }\n  check('pickScreen finds a block from its top centre in 4 turns x 2 views', pickOk === pickN, pickOk + '/' + pickN);\n  // diff and hash\n  const base = new DQ.VoxelWorld(144, 144, 24); DQ.generateWorld(base); const h0 = base.hash();\n  const again = new DQ.VoxelWorld(144, 144, 24); DQ.generateWorld(again);\n  check('world generation is deterministic', again.hash() === h0);\n  base.set(70, 70, 12, id('planks')); base.set(71, 70, 8, 0); const d = base.diff();\n  again.applyDiff(d); check('diff and applyDiff round trip', again.hash() === base.hash() && d.length === 2, d.length);\n  // render logic: runs and the lift hook\n  const w6 = new DQ.VoxelWorld(16, 16, 16); for (const z of [0, 1, 2, 5, 6]) w6.set(4, 4, z, 2);\n  check('runs split around air', JSON.stringify(w6.runs(4, 4)) === '[[0,3],[5,7]]', JSON.stringify(w6.runs(4, 4)));\n  const v = DQ.VIEW_ISO, k0 = v.order(4.2 * T, 4.2 * T, 3 * T), runK = v.order(4.5 * T, 4.5 * T, 0), roofK = v.order(4.5 * T, 4.5 * T, 5 * T);\n  const lifted = w6._liftOrder(v, 4.2 * T, 4.2 * T, 3 * T, k0);\n  check('a body standing on a run sorts after it, and before the roof run above', lifted > runK && lifted < roofK, [lifted, runK, roofK].join(' '));\n  // the generated world's places\n  const P = DQ.WORLD.poi;\n  check('the hollow start, banner spot and spire top are standable', base.standable(P.hollowStart[0], P.hollowStart[1], P.hollowStart[2]) && base.standable(P.bannerSpot[0], P.bannerSpot[1], base.topZ(P.bannerSpot[0], P.bannerSpot[1])) && base.topZ(124, 124) === 22);\n  check('the knot wall is full height except the gate', base.get(99, 100, 20) === id('knot') && base.gate.length === 30);\n  check('every portal stands on the ground', DQ.WORLD.portals.every(p => { const o = base.genObjects.find(q => q.portalId === p.id); return o && base.solidAt(o.x, o.y, o.z - 1); }));\n};\nEOF\ncat > tests/suites/02-builder.test.mjs <<'EOF'\nimport { boot } from '../lib/game.mjs';\nexport default async ({ check }) => {\n  const G = await boot(), { game, DQ, run, press, hold, snap, errs } = G, T = 16;\n  const ctx = G.play('banner'), b = ctx.builder, w = ctx.world;\n  const tp = (x, y) => { DQ.Dev.teleport(ctx, x, y); run(.3); };\n  // walk speed follows the tuning\n  tp(60, 60); const x0 = b.body.x, y0 = b.body.y; game.input.hold('right'); run(1); game.input.hold('right', false);\n  const sp = Math.hypot(b.body.x - x0, b.body.y - y0); check('walk speed matches the tuning (~78/s)', sp > 60 && sp < 82, sp);\n  DQ.tuning.set('walk', 120); tp(60, 60); const x1 = b.body.x, y1 = b.body.y; game.input.hold('right'); run(1); game.input.hold('right', false); DQ.tuning.reset('walk');\n  check('the walk slider changes speed live', Math.hypot(b.body.x - x1, b.body.y - y1) > sp * 1.3);\n  // jump clears 1 block, not 2\n  tp(60, 60); const z0 = b.body.z; let peak = 0; press('jump', .02); for (let i = 0; i < 60; i++) { run(1 / 120); peak = Math.max(peak, b.body.z - z0); }\n  check('a jump rises more than 1 block and less than 2', peak > 16 && peak < 32, peak);\n  // breaking: tiers and drops\n  tp(60, 60); const L = b.L0; b.body.facing = 0; run(.05);\n  const cx = Math.floor(b.body.x / T) + 1, cy = Math.floor(b.body.y / T);\n  w.set(cx, cy, L, DQ.blockId('stone')); run(.05);\n  b.setEquip('weapon', 'darningStick'); for (let i = 0; i < 6; i++) { press('swing', .45); }\n  check('stone is too tough for the darning stick', w.get(cx, cy, L) === DQ.blockId('stone'));\n  b.take('cobbleClub', 1, { quiet: true }); b.setEquip('weapon', 'cobbleClub'); for (let i = 0; i < 6 && w.get(cx, cy, L); i++) press('swing', .45);\n  check('the cobble club breaks stone', !w.get(cx, cy, L));\n  run(1.5); check('the broken block drops into the bag', b.bag.real('stone') >= 1, JSON.stringify(snap().bag));\n  // placing: reach, occupied, inside a body\n  b.hotbar[0] = 'stone'; b.sel = 0; const before = b.bag.real('stone'); b.body.facing = 0; run(.05); press('place', .3);\n  check('placing a block uses one from the bag', b.bag.real('stone') === before - 1 && w.get(cx, cy, b.L0) === DQ.blockId('stone'), [b.bag.real('stone'), before]);\n  const mine = [Math.floor(b.body.x / T), Math.floor(b.body.y / T), b.L0];\n  check('no block may be placed inside a body', b.blockedByBody(mine[0], mine[1], mine[2], 1));\n  check('reach: a cell 9 blocks away is out of reach', !b.inReach({ x: mine[0] + 9, y: mine[1], z: mine[2] }));\n  // Builder's Eye moves its cursor a cell at a time and up a level\n  game.input.hold('eye'); run(.1); const e0 = Object.assign({}, b.eye); game.input.hold('right'); run(.05); game.input.hold('right', false); run(.2); press('jump', .05);\n  check(\"Builder's Eye cursor steps and rises\", b.eye.on && (b.eye.x !== e0.x || b.eye.y !== e0.y) && b.eye.z === e0.z + 1, JSON.stringify([e0, b.eye]));\n  game.input.hold('eye', false); run(.1);\n  // combat: a combo hits a monster in front\n  tp(60, 60); b.body.facing = 0; const m = ctx.monsters.spawn('lintling', b.body.x + 16, b.body.y, b.body.z); m.state = 'idle'; const hp0 = m.hp;\n  for (let i = 0; i < 4 && !m.dead; i++) press('swing', .4);\n  check('the swing combo hurts a monster in the arc', m.hp < hp0 || m.dead);\n  // Spin Stitch: hold, then let go\n  b.spinUnlocked = true; const ms = [0, 1, 2].map(i => { const q = ctx.monsters.spawn('dyedLintling', b.body.x + Math.cos(i * 2) * 14, b.body.y + Math.sin(i * 2) * 14, b.body.z); q.state = 'idle'; return q; }); const h0 = ms.map(q => q.hp);\n  hold('swing', .8); run(.3);\n  check('Spin Stitch hits all around', ms.filter((q, i) => q.hp < h0[i] || q.dead).length >= 2, ms.map(q => q.hp).join(','));\n  // KO: respawn at the banner, the Lost Bundle holds half of each material\n  for (const q of ctx.monsters.list) { q.dead = true; q.deadT = 99; } run(.2);\n  b.bag.add('straw', 10); b.bag.add('pebble', 6); DQ.dev.god = false; b.iframe = 0; b.hurt(999); run(4.5); while (ctx.talk.open) { press('confirm', .2); }\n  const bundle = ctx.objects.find(o => o.id === 'lostBundle');\n  check('KO respawns at the banner with full HP', !b.ko && b.hp === b.maxHp && Math.hypot(b.body.x / T - ctx.town.bx, b.body.y / T - ctx.town.by) < 5, JSON.stringify(snap().builder));\n  check('the Lost Bundle holds half of each material stack', bundle && bundle.contents.straw === 5 && bundle.contents.pebble === 3 && b.bag.real('straw') === 5, bundle && JSON.stringify(bundle.contents));\n  // falling into the Unravel respawns at the last safe spot\n  tp(60, 60); run(1); b.body.lastSafe = [b.body.x, b.body.y, b.body.z]; b.body.x = 1 * T; b.body.y = 1 * T; b.body.z = 3 * T; run(1.5);\n  check('falling into the Unravel returns to the last safe spot', Math.abs(b.body.x / T - 60.5) < 2 && b.body.z > 0, JSON.stringify(snap().builder));\n  // eating\n  b.belly = 40; b.bag.add('bun', 1); b.hotbar[1] = 'bun'; b.sel = 1; run(.1); press('place', .3);\n  check('eating a bun fills the belly', b.belly >= 74, b.belly);\n  check('no errors', !game.errors.length, errs());\n};\nEOF\ncat > tests/suites/03-input.test.mjs <<'EOF'\nimport { boot } from '../lib/game.mjs';\nexport default async ({ check }) => {\n  const G = await boot(), { game, DQ, run, errs } = G, I = game.input;\n  const ctx = G.play('banner'), b = ctx.builder;\n  I.lastDevice = 'keyboard'; check('keyboard prompt for swing is J', DQ.Glyphs.label(game, 'swing') === 'J', DQ.Glyphs.label(game, 'swing'));\n  I.lastDevice = 'mouse'; check('mouse prompt for swing is the left button', DQ.Glyphs.code(game, 'swing') === 'Mouse0');\n  check('mouse prompt for place is the right button', DQ.Glyphs.code(game, 'place') === 'Mouse2');\n  I.lastDevice = 'gamepad'; check('gamepad prompt for swing is square (button 2)', DQ.Glyphs.code(game, 'swing') === 'Pad2' && DQ.Glyphs.family(game) === 'ps');\n  game.settings.set('dqGlyphs', 'Xbox'); check('the glyph setting switches to Xbox', DQ.Glyphs.family(game) === 'xbox' && I.label('jump') === 'A', I.label('jump'));\n  game.settings.set('dqGlyphs', 'PlayStation'); check('PlayStation glyphs are the default family', DQ.Glyphs.family(game) === 'ps' && I.label('jump') === '✕', I.label('jump'));\n  I.lastDevice = 'keyboard';\n  // the wheel steps the hotbar\n  const s0 = b.sel; I.wheelGame = true; I._wheelAcc = 130; run(1 / 60); run(1 / 60);\n  check('the mouse wheel steps the hotbar', b.sel !== s0, [s0, b.sel]);\n  // the number keys pick a slot\n  I.press('Digit5'); run(1 / 60); I.release('Digit5'); run(1 / 60); check('number keys pick a hotbar slot', b.sel === 4);\n  // the satchel opens from its key, and Tab focus is the game's\n  I.press('Tab'); run(1 / 60); I.release('Tab'); run(.1); check('Tab opens the Satchel', ctx.ui.top && ctx.ui.top.name === 'satchel');\n  I.press('Tab'); run(1 / 60); I.release('Tab'); run(.1); check('Tab closes it again', !ctx.ui.top);\n  // the hub rule: while Create is held in a session, the satchel waits (Options belongs to the hub)\n  ctx.inHub = true; I.press('Escape'); I.press('Tab'); run(1 / 60); I.release('Tab'); I.release('Escape'); run(.1); check('in a hub session Create + Options does not open the Satchel', !ctx.ui.top); ctx.inHub = false;\n  // camera turns and zoom steps\n  const y0 = game.yaw; I.press('KeyE'); run(1 / 60); I.release('KeyE'); run(.1); check('E turns the camera 90 degrees', (game.yaw - y0 + 360) % 360 === 90, game.yaw);\n  I.press('Minus'); run(1 / 60); I.release('Minus'); run(.1); check('minus steps the zoom out', ctx.zoom === .75, ctx.zoom);\n  I.press('KeyR'); run(1 / 60); I.release('KeyR'); run(.1); check('R resets the camera', game.yaw === 0 && ctx.zoom === 1);\n  // text with button tokens only uses the font's characters\n  const bad = []; const scan = (o, p) => { if (typeof o === 'string') { if (!DQ.FONT_OK.test(o.replace(/\\{btn:\\w+\\}/g, ''))) bad.push(p + ': ' + o.slice(0, 40)); } else if (o && typeof o === 'object') for (const k in o) if (typeof o[k] !== 'function') scan(o[k], p + '.' + k); };\n  scan(DQ.LINES, 'LINES'); scan(DQ.IDLE, 'IDLE'); scan(DQ.QUESTS.map(q => ({ t: q.title, s: q.steps.map(s => s.text), i: q.intro, o: q.outro })), 'QUESTS'); scan(DQ.ITEMS, 'ITEMS'); scan(DQ.NPCS, 'NPCS');\n  check('every string table uses only the font\\'s characters', !bad.length, bad.slice(0, 5).join(' | '));\n  check('no errors', !game.errors.length, errs());\n};\nEOF\nnode tests/run.mjs --only 01,02,03"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1959,"cache_read_input_tokens":651668,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1959},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b7d7e0cb-a26c-4fe8-90f7-7d5024813af2","uuid":"feb46b60-077c-4e08-aa67-4fb2a862d691","timestamp":"2026-11-04T06:03:36.759Z","request_id":"req_011CghP2ArR6vy2wcAHf6MDV","wire_tool_inputs":{"toolu_01XjHxNrfLdeoafCvvXGWCVz":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-215911__x5b1962/work/DragonQuiltBuilders-DragonQuestBuilders-claude-opus-5-5-medium-20261103-215911 && cat > tests/suites/01-voxel.test.mjs <<'EOF'\nimport { load } from '../lib/load.mjs';\nexport default async ({ check }) => {\n  const { E, DQ } = load({ quiet: true });\n  const T = 16, w = new DQ.VoxelWorld(32, 32, 16);\n  const id = DQ.blockId;\n  for (let y = 0; y < 32; y++) for (let x = 0; x < 32; x++) for (let z = 0; z < 4; z++) w.set(x, y, z, z ? id('earth') : 1, { silent: true });\n  w.recomputeTops();\n  check('get/set and bounds', w.get(5, 5, 3) === id('earth') && w.get(-1, 0, 0) === 0 && w.get(40, 0, 0) === 0 && !w.set(99, 0, 0, 2));\n  check('topZ kept on edit', w.topZ(5, 5) === 4 && (w.set(5, 5, 6, id('stone')), w.topZ(5, 5) === 7) && (w.set(5, 5, 6, 0), w.topZ(5, 5) === 4));\n  check('standable needs ground and two free levels', w.standable(5, 5, 4) && !w.standable(5, 5, 3) && (w.set(6, 6, 5, id('stone')), !w.standable(6, 6, 4)));\n  w.set(6, 6, 5, 0);\n  check('groundAt: the top under a point', w.groundAt(5.5 * T, 5.5 * T, 5, 4 * T, 2) === 4 * T);\n  w.set(8, 8, 4, id('stone'));\n  check('groundAt ignores a ledge above the step', w.groundAt(8.5 * T, 8.5 * T, 5, 4 * T, 2) === 4 * T || w.groundAt(8.5 * T, 8.5 * T, 5, 4 * T, 2) === -Infinity ? true : w.groundAt(8.5 * T, 8.5 * T, 5, 4 * T, 2) === 4 * T);\n  check('groundAt over a 1-block step from above', w.groundAt(8.5 * T, 8.5 * T, 5, 5 * T + 1, 2) === 5 * T);\n  w.set(10, 10, 7, id('stone'));\n  check('ceilingAt finds the block bottom', w.ceilingAt(10.5 * T, 10.5 * T, 5, 4 * T) === 7 * T);\n  // collision: a body walking into a 2-high wall stops; a 1-high gap blocks; a 2-high gap passes\n  for (let y = 12; y < 20; y++) { w.set(15, y, 4, id('stone')); w.set(15, y, 5, id('stone')); }\n  const b = new DQ.VoxelBody({ x: 13.5 * T, y: 15.5 * T, z: 4 * T });\n  for (let i = 0; i < 240; i++) { b.vx = 80; b.vy = 0; b.update(1 / 120, w); }\n  check('collide: a wall stops a body', b.x < 15 * T && b.x > 14 * T, b.x / T);\n  w.set(15, 15, 4, 0); w.set(15, 15, 5, 0); b.y = 15.5 * T;\n  for (let i = 0; i < 240; i++) { b.vx = 80; b.vy = 0; b.update(1 / 120, w); }\n  check('collide: a 2-high gap passes', b.x > 15.5 * T, b.x / T);\n  // a 1-high gap (a block at head height) blocks\n  const w2 = new DQ.VoxelWorld(16, 16, 12); for (let y = 0; y < 16; y++) for (let x = 0; x < 16; x++) for (let z = 0; z < 2; z++) w2.set(x, y, z, z ? 2 : 1, { silent: true });\n  w2.set(8, 5, 3, id('stone')); w2.recomputeTops(); const b2 = new DQ.VoxelBody({ x: 6.5 * T, y: 5.5 * T, z: 2 * T });\n  for (let i = 0; i < 240; i++) { b2.vx = 80; b2.vy = 0; b2.update(1 / 120, w2); }\n  check('collide: a 1-high gap blocks a 28-tall body', b2.x < 8 * T, b2.x / T);\n  // stairs: a ramp, walking up needs no jump\n  w2.set(10, 9, 2, id('stairsPlank'), { rot: 0 }); w2.set(11, 9, 2, id('stone')); w2.recomputeTops();\n  const b3 = new DQ.VoxelBody({ x: 9.5 * T, y: 9.5 * T, z: 2 * T });\n  for (let i = 0; i < 360; i++) { b3.vx = 50; b3.vy = 0; b3.update(1 / 120, w2); }\n  check('stairs: walking up a ramp onto the next block', b3.z >= 3 * T - .1, b3.z / T);\n  // water two deep blocks walkers\n  const w3 = new DQ.VoxelWorld(16, 16, 12); for (let y = 0; y < 16; y++) for (let x = 0; x < 16; x++) for (let z = 0; z < 3; z++) w3.set(x, y, z, z ? 2 : 1, { silent: true });\n  for (let y = 0; y < 16; y++) { w3.set(9, y, 2, id('water')); w3.set(9, y, 1, id('water')); } w3.recomputeTops();\n  const b4 = new DQ.VoxelBody({ x: 7.5 * T, y: 5.5 * T, z: 3 * T });\n  for (let i = 0; i < 240; i++) { b4.vx = 70; b4.vy = 0; b4.update(1 / 120, w3); }\n  check('deep water blocks the builder', b4.x < 9 * T + 1, b4.x / T);\n  // raycast and pick in every rotation and both views\n  const w5 = new DQ.VoxelWorld(32, 32, 16); for (let y = 0; y < 32; y++) for (let x = 0; x < 32; x++) for (let z = 0; z < 3; z++) w5.set(x, y, z, z ? 2 : 1, { silent: true });\n  w5.set(16, 16, 3, id('cobble')); w5.recomputeTops();\n  const hit = w5.raycast([16.5 * T, 16.5 * T, 10 * T], [0, 0, -1], 400);\n  check('raycast down hits the top block with an up normal', hit && hit.z === 3 && hit.nz === 1, JSON.stringify(hit));\n  let pickOk = 0, pickN = 0;\n  for (const base of [DQ.VIEW_ISO, DQ.VIEW_TQ]) for (const yaw of [0, 90, 180, 270]) {\n    const v = new E.View('t', 't', base.yawDeg + yaw, base.pitchDeg, base.scale, base.zBoost), p = v.p(16.5 * T, 16.5 * T, 4 * T);\n    const h = w5.pickScreen(p[0], p[1], v, 0, 0); pickN++; if (h && h.x === 16 && h.y === 16 && h.z === 3) pickOk++;\n  }\n  check('pickScreen finds a block from its top centre in 4 turns x 2 views', pickOk === pickN, pickOk + '/' + pickN);\n  // diff and hash\n  const base = new DQ.VoxelWorld(144, 144, 24); DQ.generateWorld(base); const h0 = base.hash();\n  const again = new DQ.VoxelWorld(144, 144, 24); DQ.generateWorld(again);\n  check('world generation is deterministic', again.hash() === h0);\n  base.set(70, 70, 12, id('planks')); base.set(71, 70, 8, 0); const d = base.diff();\n  again.applyDiff(d); check('diff and applyDiff round trip', again.hash() === base.hash() && d.length === 2, d.length);\n  // render logic: runs and the lift hook\n  const w6 = new DQ.VoxelWorld(16, 16, 16); for (const z of [0, 1, 2, 5, 6]) w6.set(4, 4, z, 2);\n  check('runs split around air', JSON.stringify(w6.runs(4, 4)) === '[[0,3],[5,7]]', JSON.stringify(w6.runs(4, 4)));\n  const v = DQ.VIEW_ISO, k0 = v.order(4.2 * T, 4.2 * T, 3 * T), runK = v.order(4.5 * T, 4.5 * T, 0), roofK = v.order(4.5 * T, 4.5 * T, 5 * T);\n  const lifted = w6._liftOrder(v, 4.2 * T, 4.2 * T, 3 * T, k0);\n  check('a body standing on a run sorts after it, and before the roof run above', lifted > runK && lifted < roofK, [lifted, runK, roofK].join(' '));\n  // the generated world's places\n  const P = DQ.WORLD.poi;\n  check('the hollow start, banner spot and spire top are standable', base.standable(P.hollowStart[0], P.hollowStart[1], P.hollowStart[2]) && base.standable(P.bannerSpot[0], P.bannerSpot[1], base.topZ(P.bannerSpot[0], P.bannerSpot[1])) && base.topZ(124, 124) === 22);\n  check('the knot wall is full height except the gate', base.get(99, 100, 20) === id('knot') && base.gate.length === 30);\n  check('every portal stands on the ground', DQ.WORLD.portals.every(p => { const o = base.genObjects.find(q => q.portalId === p.id); return o && base.solidAt(o.x, o.y, o.z - 1); }));\n};\nEOF\ncat > tests/suites/02-builder.test.mjs <<'EOF'\nimport { boot } from '../lib/game.mjs';\nexport default async ({ check }) => {\n  const G = await boot(), { game, DQ, run, press, hold, snap, errs } = G, T = 16;\n  const ctx = G.play('banner'), b = ctx.builder, w = ctx.world;\n  const tp = (x, y) => { DQ.Dev.teleport(ctx, x, y); run(.3); };\n  // walk speed follows the tuning\n  tp(60, 60); const x0 = b.body.x, y0 = b.body.y; game.input.hold('right'); run(1); game.input.hold('right', false);\n  const sp = Math.hypot(b.body.x - x0, b.body.y - y0); check('walk speed matches the tuning (~78/s)', sp > 60 && sp < 82, sp);\n  DQ.tuning.set('walk', 120); tp(60, 60); const x1 = b.body.x, y1 = b.body.y; game.input.hold('right'); run(1); game.input.hold('right', false); DQ.tuning.reset('walk');\n  check('the walk slider changes speed live', Math.hypot(b.body.x - x1, b.body.y - y1) > sp * 1.3);\n  // jump clears 1 block, not 2\n  tp(60, 60); const z0 = b.body.z; let peak = 0; press('jump', .02); for (let i = 0; i < 60; i++) { run(1 / 120); peak = Math.max(peak, b.body.z - z0); }\n  check('a jump rises more than 1 block and less than 2', peak > 16 && peak < 32, peak);\n  // breaking: tiers and drops\n  tp(60, 60); const L = b.L0; b.body.facing = 0; run(.05);\n  const cx = Math.floor(b.body.x / T) + 1, cy = Math.floor(b.body.y / T);\n  w.set(cx, cy, L, DQ.blockId('stone')); run(.05);\n  b.setEquip('weapon', 'darningStick'); for (let i = 0; i < 6; i++) { press('swing', .45); }\n  check('stone is too tough for the darning stick', w.get(cx, cy, L) === DQ.blockId('stone'));\n  b.take('cobbleClub', 1, { quiet: true }); b.setEquip('weapon', 'cobbleClub'); for (let i = 0; i < 6 && w.get(cx, cy, L); i++) press('swing', .45);\n  check('the cobble club breaks stone', !w.get(cx, cy, L));\n  run(1.5); check('the broken block drops into the bag', b.bag.real('stone') >= 1, JSON.stringify(snap().bag));\n  // placing: reach, occupied, inside a body\n  b.hotbar[0] = 'stone'; b.sel = 0; const before = b.bag.real('stone'); b.body.facing = 0; run(.05); press('place', .3);\n  check('placing a block uses one from the bag', b.bag.real('stone') === before - 1 && w.get(cx, cy, b.L0) === DQ.blockId('stone'), [b.bag.real('stone'), before]);\n  const mine = [Math.floor(b.body.x / T), Math.floor(b.body.y / T), b.L0];\n  check('no block may be placed inside a body', b.blockedByBody(mine[0], mine[1], mine[2], 1));\n  check('reach: a cell 9 blocks away is out of reach', !b.inReach({ x: mine[0] + 9, y: mine[1], z: mine[2] }));\n  // Builder's Eye moves its cursor a cell at a time and up a level\n  game.input.hold('eye'); run(.1); const e0 = Object.assign({}, b.eye); game.input.hold('right'); run(.05); game.input.hold('right', false); run(.2); press('jump', .05);\n  check(\"Builder's Eye cursor steps and rises\", b.eye.on && (b.eye.x !== e0.x || b.eye.y !== e0.y) && b.eye.z === e0.z + 1, JSON.stringify([e0, b.eye]));\n  game.input.hold('eye', false); run(.1);\n  // combat: a combo hits a monster in front\n  tp(60, 60); b.body.facing = 0; const m = ctx.monsters.spawn('lintling', b.body.x + 16, b.body.y, b.body.z); m.state = 'idle'; const hp0 = m.hp;\n  for (let i = 0; i < 4 && !m.dead; i++) press('swing', .4);\n  check('the swing combo hurts a monster in the arc', m.hp < hp0 || m.dead);\n  // Spin Stitch: hold, then let go\n  b.spinUnlocked = true; const ms = [0, 1, 2].map(i => { const q = ctx.monsters.spawn('dyedLintling', b.body.x + Math.cos(i * 2) * 14, b.body.y + Math.sin(i * 2) * 14, b.body.z); q.state = 'idle'; return q; }); const h0 = ms.map(q => q.hp);\n  hold('swing', .8); run(.3);\n  check('Spin Stitch hits all around', ms.filter((q, i) => q.hp < h0[i] || q.dead).length >= 2, ms.map(q => q.hp).join(','));\n  // KO: respawn at the banner, the Lost Bundle holds half of each material\n  for (const q of ctx.monsters.list) { q.dead = true; q.deadT = 99; } run(.2);\n  b.bag.add('straw', 10); b.bag.add('pebble', 6); DQ.dev.god = false; b.iframe = 0; b.hurt(999); run(4.5); while (ctx.talk.open) { press('confirm', .2); }\n  const bundle = ctx.objects.find(o => o.id === 'lostBundle');\n  check('KO respawns at the banner with full HP', !b.ko && b.hp === b.maxHp && Math.hypot(b.body.x / T - ctx.town.bx, b.body.y / T - ctx.town.by) < 5, JSON.stringify(snap().builder));\n  check('the Lost Bundle holds half of each material stack', bundle && bundle.contents.straw === 5 && bundle.contents.pebble === 3 && b.bag.real('straw') === 5, bundle && JSON.stringify(bundle.contents));\n  // falling into the Unravel respawns at the last safe spot\n  tp(60, 60); run(1); b.body.lastSafe = [b.body.x, b.body.y, b.body.z]; b.body.x = 1 * T; b.body.y = 1 * T; b.body.z = 3 * T; run(1.5);\n  check('falling into the Unravel returns to the last safe spot', Math.abs(b.body.x / T - 60.5) < 2 && b.body.z > 0, JSON.stringify(snap().builder));\n  // eating\n  b.belly = 40; b.bag.add('bun', 1); b.hotbar[1] = 'bun'; b.sel = 1; run(.1); press('place', .3);\n  check('eating a bun fills the belly', b.belly >= 74, b.belly);\n  check('no errors', !game.errors.length, errs());\n};\nEOF\ncat > tests/suites/03-input.test.mjs <<'EOF'\nimport { boot } from '../lib/game.mjs';\nexport default async ({ check }) => {\n  const G = await boot(), { game, DQ, run, errs } = G, I = game.input;\n  const ctx = G.play('banner'), b = ctx.builder;\n  I.lastDevice = 'keyboard'; check('keyboard prompt for swing is J', DQ.Glyphs.label(game, 'swing') === 'J', DQ.Glyphs.label(game, 'swing'));\n  I.lastDevice = 'mouse'; check('mouse prompt for swing is the left button', DQ.Glyphs.code(game, 'swing') === 'Mouse0');\n  check('mouse prompt for place is the right button', DQ.Glyphs.code(game, 'place') === 'Mouse2');\n  I.lastDevice = 'gamepad'; check('gamepad prompt for swing is square (button 2)', DQ.Glyphs.code(game, 'swing') === 'Pad2' && DQ.Glyphs.family(game) === 'ps');\n  game.settings.set('dqGlyphs', 'Xbox'); check('the glyph setting switches to Xbox', DQ.Glyphs.family(game) === 'xbox' && I.label('jump') === 'A', I.label('jump'));\n  game.settings.set('dqGlyphs', 'PlayStation'); check('PlayStation glyphs are the default family', DQ.Glyphs.family(game) === 'ps' && I.label('jump') === '✕', I.label('jump'));\n  I.lastDevice = 'keyboard';\n  // the wheel steps the hotbar\n  const s0 = b.sel; I.wheelGame = true; I._wheelAcc = 130; run(1 / 60); run(1 / 60);\n  check('the mouse wheel steps the hotbar', b.sel !== s0, [s0, b.sel]);\n  // the number keys pick a slot\n  I.press('Digit5'); run(1 / 60); I.release('Digit5'); run(1 / 60); check('number keys pick a hotbar slot', b.sel === 4);\n  // the satchel opens from its key, and Tab focus is the game's\n  I.press('Tab'); run(1 / 60); I.release('Tab'); run(.1); check('Tab opens the Satchel', ctx.ui.top && ctx.ui.top.name === 'satchel');\n  I.press('Tab'); run(1 / 60); I.release('Tab'); run(.1); check('Tab closes it again', !ctx.ui.top);\n  // the hub rule: while Create is held in a session, the satchel waits (Options belongs to the hub)\n  ctx.inHub = true; I.press('Escape'); I.press('Tab'); run(1 / 60); I.release('Tab'); I.release('Escape'); run(.1); check('in a hub session Create + Options does not open the Satchel', !ctx.ui.top); ctx.inHub = false;\n  // camera turns and zoom steps\n  const y0 = game.yaw; I.press('KeyE'); run(1 / 60); I.release('KeyE'); run(.1); check('E turns the camera 90 degrees', (game.yaw - y0 + 360) % 360 === 90, game.yaw);\n  I.press('Minus'); run(1 / 60); I.release('Minus'); run(.1); check('minus steps the zoom out', ctx.zoom === .75, ctx.zoom);\n  I.press('KeyR'); run(1 / 60); I.release('KeyR'); run(.1); check('R resets the camera', game.yaw === 0 && ctx.zoom === 1);\n  // text with button tokens only uses the font's characters\n  const bad = []; const scan = (o, p) => { if (typeof o === 'string') { if (!DQ.FONT_OK.test(o.replace(/\\{btn:\\w+\\}/g, ''))) bad.push(p + ': ' + o.slice(0, 40)); } else if (o && typeof o === 'object') for (const k in o) if (typeof o[k] !== 'function') scan(o[k], p + '.' + k); };\n  scan(DQ.LINES, 'LINES'); scan(DQ.IDLE, 'IDLE'); scan(DQ.QUESTS.map(q => ({ t: q.title, s: q.steps.map(s => s.text), i: q.intro, o: q.outro })), 'QUESTS'); scan(DQ.ITEMS, 'ITEMS'); scan(DQ.NPCS, 'NPCS');\n  check('every string table uses only the font\\'s characters', !bad.length, bad.slice(0, 5).join(' | '));\n  check('no errors', !game.errors.length, errs());\n};\nEOF\nnode tests/run.mjs --only 01,02,03"}},"wire_ingest_context":{"toolu_01XjHxNrfLdeoafCvvXGWCVz":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-215911__x5b1962/work/DragonQuiltBuilders-DragonQuestBuilders-claude-opus-5-5-medium-20261103-215911"}}}
