{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NgVGQuBYhwyxsueXPQh1Vf","type":"tool_result","content":"function noise2(x, y) {\n  const xi = Math.floor(x), yi = Math.floor(y), xf = x - xi, yf = y - yi, u = xf * xf * (3 - 2 * xf), v = yf * yf * (3 - 2 * yf);\n  return lerp(lerp(hash2(xi, yi), hash2(xi + 1, yi), u), lerp(hash2(xi, yi + 1), hash2(xi + 1, yi + 1), u), v);\n}\nconst BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map(v => (v + .5) / 16);","is_error":false}]},"parent_tool_use_id":null,"session_id":"b7d7e0cb-a26c-4fe8-90f7-7d5024813af2","uuid":"7548b8d8-4db7-4ad8-95f1-0c50c7f318d0","timestamp":"2026-11-04T05:12:58.959Z","tool_use_result":{"stdout":"function noise2(x, y) {\n  const xi = Math.floor(x), yi = Math.floor(y), xf = x - xi, yf = y - yi, u = xf * xf * (3 - 2 * xf), v = yf * yf * (3 - 2 * yf);\n  return lerp(lerp(hash2(xi, yi), hash2(xi + 1, yi), u), lerp(hash2(xi, yi + 1), hash2(xi + 1, yi + 1), u), v);\n}\nconst BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map(v => (v + .5) / 16);","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01NgVGQuBYhwyxsueXPQh1Vf","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
