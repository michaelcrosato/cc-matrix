ript(function* () { yield* c.run(ctx, arg); }.call(this));\",\"this.cur.script = ctx.game.script(function* () { yield* c.run(ctx, arg); });\")\ns=s.replace(\"if (I.down('cancel') || I.down('interact') || I.down('Mouse2' in I.map ? 'Mouse2' : 'cancel')) this.skipT += dt; else this.skipT = 0;\",\"if (I.down('cancel') || I.down('interact') || I.held.has('Mouse2')) this.skipT += dt; else this.skipT = 0;\")\nopen(p,'w').write(s)\nEOF\ngrep -c \"held.has('Mouse2')\" src/22-story.js; ls .."}}}
