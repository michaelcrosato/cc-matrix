e.input.tap('jump')` presses an action for one step, `hold('right')` holds one down, `hold('right', false)` lets go.\n- `game.debug = { snapshot() { return {...} }, teleport(x, y, z) {...} }` is your game's handle: tests read it, and\n  `tools/check.mjs` and `tools/replay.mjs` print it.\n- `game.stop()`, `game.start()` and `game.dispose()` stop, resume and end a game.\n\nThe same inputs give the same game on every machine and at every refresh rate: the clock is an exact fixed step.\ndocs:\nASSETS.md\n\ngame:\ngame.js\nindex.html\ntest.mjs\n\nkits:\nREADME.md\nadventure.html\nadventure.js\nanimlab.html\nanimlab.js\narcade.html\narcade.js\nartillery.html\nartillery.js\nbrawler.html\nbrawler.js\nfighting.html\nfighting.js\nkart.html\nkart.js\nmetroidvania.html\nmetroidvania.js\npinball.html\npinball.js\nplatformer.html\nplatformer.js\npointclick.html\npointclick.js\npuzzle.html\npuzzle.js\nrhythm.html\nrhythm.js\nroad.html\nroad.js\nroguelike.html\nroguelike.js\nrpg.html\nrpg.js\nrts.html\nrts.js\nshooter.html\nshooter.js\nsim.html\nsim.js\nsports.html\nsports.js\nstealth.html\nstealth.js\ntactics.html\ntactics.js\ntest.mjs\n\nmodules:\narcade.js\nclick.js\ndrive.js\nfight.js\ngen.js\ngrid.js\nmode7.js\nphysics.js\nrhythm.js\nroad.js\nrooms.js\nrpg.js\nsongs.js\nstory.js\nstrategy.js\nterrain.js\n\nsrc:\nassets\n\ntools:\nasset-find.mjs\nasset-lib.mjs\nasset-set.mjs\nasset-sheet.mjs\ncheck.mjs\nfilmstrip.mjs\nreplay.mjs\n{\n  \"name\": \"my-3d2dge-handoff\",\n  \"version\": \"0.85.2\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"description\": \"my-3D2dge for coding agents: the engine, its card, index and guide, the tools and a template game\",\n  \"scripts\": {\n    \"test\": \"node game/test.mjs\",\n    \"check\": \"node tools/check.mjs game/index.html\"\n  },\n  \"devDependencies\": {\n    \"playwright\": \"1.63.0\"\n  }\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_014DqjTWZWBfB6RgM7QPoWi2","p