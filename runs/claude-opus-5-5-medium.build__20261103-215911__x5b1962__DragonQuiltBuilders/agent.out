eft) * cv.width / b.width - t.ox) / t.k, y = ((e.clientY - b.top) * cv.height / b.height - t.oy) / t.k; s.onPick(x, y); this._map(cv, s, true); };\n548:class View {\n631:class Screen {\n744:class Input {\n1457:class Lighting {\n1567:class Particles {\n1680:class Renderer {\n2270:class Game {\n3020:class Settings {\n3081:class FullScreen {\n3310:class Tween {\n3358:class Script {\n3400:class Path {\n3808:class Saves {\n3939:class Humanoid {\n4720:class Attack {\n4776:class Combo {\n4863:class Blob {\n5041:class TileMap {\n5909:class FlowField {\n6100:class PlatformMap {\n6515:class Platformer {\n6852:class Body {\n7019:class Action {\n7106:class Mover extends Body {\n7331:class Suspicion {\n7369:class Bullets {\n7447:class SpatialHash {\n7530:class ChipAudio {\n7861:class Backdrop {\n8873:class Dialog {\n9029:class Menu {\n9163:class Shell {\n9757:class GPULighting {\n10389:class Arcade {\n10626:class Walkbox {\n10690:class Click {\n10966:class Car extends E.Body {\n11038:class Race {\n11215:class FightStage {\n11232:class Fighter {\n11501:class FightAI {\n11545:class Match {\n11646:class FightSelect {\n11942:class Heap {\n11949:class Grid {\n12155:class Fog {\n12201:class GridMover {\n12234:class Turns {\n12335:class Mode7 {\n12562:class PBody {\n12661:class Physics {\n12948:class Rhythm {\n13110:class Road {\n13278:class World {\n13472:class Member {\n13539:class Inventory {\n13587:class Party {\n13624:class Shop {\n13639:class Encounters {\n13663:class RPG {\n13949:class Story {\n14164:class Strategy {\n14487:class Clock {\n14588:class Terrain {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01XbAhCvjTRwgyWGU9gAmD9r","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
