y / S.H);\n    if (z) { this._zoneDown('fed' + (o.id || 0), z); return; }   // (a finger in a zone: its act, no gesture)\n    if (o.touch && type === 'up' && this._zoneOf.has('fed' + (o.id || 0))) { this._zoneUp('fed' + (o.id || 0)); return; }\n    if (type === 'down') { this._fed = [x, y]; if (!o.touch) this.press('Mouse' + (o.button || 0)); this._gesture('down', x, y, { touch: !!o.touch, button: o.button || 0, id: 'fed' }); }\n    else if (type === 'move') this._gesture('move', x, y);\n    else if (type === 'up') {\n      if (this._fed && Math.hypot(x - this._fed[0], y - this._fed[1]) < 4 && !(o.button > 0)) this._click = [x, y];\n      if (!o.touch) this.release('Mouse' + (o.button || 0)); this._fed = null; this._gesture('up', x, y);\n    }\n  }\n  // a press followed from down to up: past 4 pixels it is a box (a left button, or a finger after a long press) or a pan\n  // (a finger, a middle or right button); lifted unmoved it is a tap, and a second within .35 s a double tap\n  _gesture(type, x, y, o = {}) {\n    const g = this._g;\n    if (type === 'down') { this._g = { id: o.id, x0: x, y0: y, x, y, t: this.clock, touch: !!o.touch, button: o.button || 0, mode: null, long: false, moved: false }; return; }\n    if (!g) return;\n    if (type === 'move') {\n      const px = g.x, py = g.y; g.x = x; g.y = y;\n      if (!g.moved && Math.hypot(x - g.x0, y - g.y0) > 4) { g.moved = true; g.mode = (!g.touch && g.button === 0) || (g.touch && g.long) ? 'box' : g.touch || g.button > 0 ? 'pan' : null; }\n      if (g.mode === 'box') this._gBox = { x0: Math.min(g.x0, x), y0: Math.min(g.y0, y), x1: Math.max(g.x0, x), y1: Math.max(g.y0, y), from: [g.x0, g.y0], to: [x, y], done: false };\n      else if (g.mode === 'pan') { const p = this._gPan || (this._gPan = [0, 0]); p[0] += x - (g.moved && g.panned ? px : g.x0); p[1] += y - (g.moved && g.panned ? py : g.y0); g.panned = true; }\n      return;\n    }\n    this._g = null;   // up\n    if (g.mode === 'box' && this._gBox) this._gBox.