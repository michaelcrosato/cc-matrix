S);\n    if (C && C.bus && this.ctx && C.anchor) { const g = C.bus.gain, a = Math.max(this.ctx.currentTime, C.anchor.ctx + (t - C.anchor.clk)), b = a + S.len * S.spb; g.setValueAtTime(g.value, a); g.linearRampToValueAtTime(o.duck === undefined ?\n  }\n  /** the audio offset's calibration: a click on each beat (100 bpm, the first of a bar higher) as the music; tap(time)\n   *  on each one heard (an event's timeStamp, or nothing: this update step). After 8 taps, result is the offset to set\n   *  (ms: settings.audioOffset) and done is true; taps go on refining it. stop() puts the music back */\n  calibrate() {\n    const prev = this.song && this.song.src, A = this, devs = [];\n    this.music({ bpm: 100, steps: 1, tracks: [{ wave: 'square', vol: .24, notes: 'C6 G5 G5 G5' }] }, { restart: true });\n    const C = this.song, K = { taps: 0, result: null, done: false, devs,\n  title: { bpm: 112, steps: 4, tracks: [\n    { wave: 'square', vol: .16, notes: 'C5 - - - G4 - C5 - E5 - - - D5 - C5 - | D5 - - - G4 - B4 - D5 - - - F5 - E5 - | E5 - - - C5 - E5 - G5 - - - A5 - G5 - | F5 - E5 - D5 - B4 - C5 - - - - - . .' },\n    { wave: 'triangle', vol: .3, notes: 'C3 - . C3 G2 - . G2 C3 - . C3 G2 - . G2 | G2 - . G2 D3 - . D3 G2 - . G2 D3 - . D3 | A2 - . A2 E3 - . E3 A2 - . A2 E3 - . E3 | F2 - . F2 G2 - . G2 C3 - . C3 G2 \n    { wave: 'drums', vol: .14, notes: 'k . h . s . h . k . h k s . h .' } ] },\n  adventure: { bpm: 138, steps: 4, tracks: [\n    { wave: 'pulse', vol: .15, notes: 'E5 - G5 - A5 - - C6 B5 - A5 - G5 - E5 - | D5 - E5 - G5 - - A5 G5 - E5 - D5 - . . | E5 - G5 - A5 - - C6 D6 - C6 - A5 - G5 - | A5 - G5 - E5 - D5 - C5 - - - - - . .\n    { wave: 'square', vol: .07, notes: 'C5 . E5 . G5 . E5 . C5 . E5 . G5 . E5 . | B4 . D5 . G5 . D5 . B4 . D5 . G5 . D5 . | A4 . C5 . E5 . C5 . A4 . C5 . E5 . C5 . | F4 . A4 . C5 . A4 . G4 . B4 . D5 .\n    { wave: 'triangle', vol: .32, notes: 'C3 . C4 . C3 . C4 . C3 . C4 . C3 . C4 . | G2 . G3 . G2 . G3 . G2 . G3 . G2 . G3 . | A2 . A3 . A2 . A3 