s.rows = this.browse ? 4 : 5;\",\n \"    this.mode = data.mode || 'arcade'; this.browse = !!data.browse; this.missionId = data.mission || null; this.focus = 0; this.rows = this.browse ? 4 : 5;\"),\n(\"    const p = this.p, car = OB.CARS[p.car];\\n    G().go('race', { mode: this.mode, car: car.id, paint: p.paint, passenger: OB.CAST_ORDER[p.passenger], station: p.station, difficulty: G().settings.difficulty || 'Normal', route: null, cheats: {} }, { fade: 'wipe' });\",\n \"    const p = this.p, car = OB.CARS[p.car];\\n    const m = this.missionId ? OB.MISSIONS.find(x => x.id === this.missionId) : null;\\n    G().go('race', { mode: m ? (m.rule === 'love' ? 'love' : 'arcade') : this.mode, car: car.id, paint: p.paint, passenger: OB.CAST_ORDER[p.passenger], station: p.station, difficulty: G().settings.difficulty || 'Normal', route: m ? m.route : null, mission: this.missionId, cheats: {} }, { fade: 'wipe' });\"),\n])\npatch('src/51-race-scene.js', [\n(\"    const cs = Math.max(.6, r.H / 200), p = road.project(car.z + ahead, car.x, 0);\",\n \"    for (const pc of race.pacers) { if (pc.out) continue; const z = pc.onStage(race); if (z !== null) cars.push({ z, x: pc.lane, w: 380, draw: (g, sx, sy, sc) => OB.Art.vehicle(g, { def: { body: 'car' }, w: .22, col: pc.color, kmh: pc.kmh, blink: 0 }, sx, sy, sc) }); }\\n    for (const o of race.objects) if (o.state === 'live' && o.z > car.z - 300 && o.z < car.z + 9000) cars.push({ z: o.z, x: o.x, w: 60, draw: OB.Art.requestObj(o) });\\n    road.draw(r, { z: car.z, x: car.x, h: camHeight(), turn: this.turn, cars });\\n    const cs = Math.max(.6, r.H / 200), p = road.project(car.z + ahead, car.x, 0);\"),\n(\"    road.draw(r, { z: car.z, x: car.x, h: camHeight(), turn: this.turn, cars });\\n    road.draw\", \"    road.draw\"),\n(\"    if (race.status === 'over' || race.status === 'goal') {\\n      this.endT += dt;\\n      if (this.endT > 1.8) {\\n        if (this.demo) { OB.attract.next(); return; }\",\n \"    if (race.status === 'over' || race.status === 'goal' || race.status === 'finish') {\\n      this.endT += dt;\\n      if (this.endT > 1.8) {\\n        if (this.demo) { OB.attract.next(); return; }\\n        if (race.mission) { G().go('debrief', { id: race.mission.m.id, result: race.result() }, { fade: 'wipe' }); return; }\"),\n])\nprint('ok')\nEOF\nfor f in src/50-front.js src/51-race-scene.js; do node --check $f && echo ok; done; grep -n \"road.draw(r, { z: car.z\" src/51-race-scene.js","description":"Wire the menu, garage missions, and race drawing and debrief"}},"wire_ingest_context":{"toolu_0162aR6MyAHhHRFKtzokgu3k":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-043153__xe1b7e1/work/OutBloom2006Coast2Coast-OutRun2006Coast2Coast-claude-haiku-5-5-medium-20261104-043153"}}}
