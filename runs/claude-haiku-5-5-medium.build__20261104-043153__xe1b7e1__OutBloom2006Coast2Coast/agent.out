e: null, seed: 4, cheats: {} }, {fade: 0})\")\n    pg.wait_for_timeout(6000)\n    print('engine loops', pg.evaluate(\"() => OB.race ? OB.race.status : null\"), 'audio failed:', pg.evaluate(\"() => OB.game.audio.failed\"))\n    print('errors', errs[:4]); b.close()\nEOF\ntimeout 300 python3 tests/browser-audio.py","description":"Play each radio song and a race in Chromium and check for errors"}},"wire_ingest_context":{"toolu_01ABi8XKFMobcJvjedBq19nZ":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-043153__xe1b7e1/work/OutBloom2006Coast2Coast-OutRun2006Coast2Coast-claude-haiku-5-5-medium-20261104-043153"}}}
