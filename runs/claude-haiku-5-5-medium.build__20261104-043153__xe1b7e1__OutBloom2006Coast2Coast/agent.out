und(st.junction / road.o.segment) - 1;","+  const L = road.o.segment;","+  const inView = !!st.forkZ && !r.viewport && Math.floor(v.z / L) + road.o.draw > Math.round(st.junction / L) - 1;","   if (!inView) return road.draw(r, v);","-  const o = road.o, W = r.W, H = r.H, t = race.stage && (OB.game.time || 0);","-  const { shared, strips, tracks, base, L } = buildStrips(race, st, v, road);","+  const o = road.o, W = r.W, H = r.H, t = OB.game.time || 0, fog = o.fog && E.hex(o.fog.color);","+  const rows = rowsOf(race, st, v);","   const C = { x: (v.x || 0) * o.width, y: (v.h === undefined ? o.height : v.h) + road.yAt(v.z), z: v.z, cx: W / 2, cy: H / 2, hw: W / 2, hh: H / 2, pct: (v.z % L) / L, bend: [] };","   road._cam = C;","-  const fog = o.fog && E.hex(o.fog.color);","   r.overlay(g => {","-    // the sky, as the road draws it, then the bands far to near","     if (o.sky && o.sky.draw) o.sky.draw(Object.create(r, { ctx: { value: g }, bw: { value: W }, bh: { value: H }, W: { value: W }, H: { value: H }, ix: { value: v.turn || 0 }, iy: { value: 0 } }));","-    else E.px.rect(g, 0, 0, W, H, o.sky || '#6aa8e8');","-    // each depth: the shared road, and the strips of the branches, drawn far to near","-    const depths = new Map();","-    for (const row of shared) depths.set(row.k, [row]);","-    for (const row of strips) { if (!depths.has(row.k)) depths.set(row.k, []); depths.get(row.k).push(row); }","-    const ks = [...depths.keys()].sort((a, b) => b - a);","+    else px.rect(g, 0, 0, W, H, o.sky || '#6aa8e8');","+    // the rows by depth, far to near: the grass across each depth, then each piece's rumble, road and lanes","+    const byK = new Map();","+    for (const row of rows) { if (!byK.has(row.k)) byK.set(row.k, []); byK.get(row.k).push(row); }","     const cars = v.cars || [];","-    for (const k of ks) {","-      const rows = depths.get(k);","-      const prj = rows.map(row => {","-        const s = row.s, sd = row.road.o.colors;","-        const p1 = road._p(row.x * o.width + row.off * o.width, s.y0 + row.yoff, row.wz, C);","-        const p2 = road._p((row.x + s.curve * 0 + 0) * o.width + row.off * o.width, s.y1 + row.yoff, row.wz + L, C);","-        return { row, p1, p2, s, sd };","+    for (const k of [...byK.keys()].sort((a, b) => b - a)) {","+      const pieces = byK.get(k).map(row => {","+        const p1 = road._p(row.x0 * o.width + row.off * o.width, row.s.y0 + row.yoff, row.wz, C);","+        const p2 = road._p(row.x1 * o.width + row.off * o.width, row.s.y1 + row.yoff, row.wz + L, C);","+        return { row, p1, p2 };","       }).filter(q => q.p1 && q.p2 && q.p1.d > road.depth);","-      if (!prj.length) continue;","-      const q0 = prj[0];","-      const alt = Math.floor(q0.s.i / o.rumble) % 2;","-      const colors = q0.sd;","-      // the grass across the band, then the road surfaces of each branch","-      const fogF = fog ? 1 - Math.exp(-((k / o.draw) ** 2) * o.fog.density) : 0;","-      E.px.rect(g, 0, Math.min(q0.p1.y, q0.p2.y), W, Math.abs(q0.p1.y - q0.p2.y) + 1, colors.grass[alt]);","-      for (const q of prj) {","-        const cols = Object.assign({}, o.colors, q.s.colors ? q.s.colors : {}, q.sd);","-        roadBand(g, null, road, q.p1, q.p2, cols, Math.floor(q.s.i / o.rumble) % 2, q.row.road.o.lanes || o.lanes);","+      if (!pieces.length) continue;","+      const first = pieces[0], colors0 = first.row.road.o.colors, alt0 = Math.floor(first.row.s.i / o.rumble) % 2;","+      const top = Math.min(first.p1.y, first.p2.y), hgt = Math.abs(first.p1.y - first.p2.y) + 1;","+      px.rect(g, 0, top, W, hgt, colors0.grass[alt0]);","+      for (const q of pieces) {","+        const rc = q.row.road.o.colors, cols = q.row.s.colors ? Object.assign({}, rc, q.row.s.colors) : rc;","+        const alt = Math.floor(q.row.s.i / o.rumble) % 2, lanes = q.row.road.o.lanes || o.lanes;","+        const quad = (x1, w1, x2, w2, c) => px.poly(g, [[x1 - w1, q.p1.y], [x1 + w1, q.p1.y], [x2 + w2, q.p2.y], [x2 - w2, q.p2.y]], c);","+        const kk = Math.max(6, 2 * lanes);","+        quad(q.p1.x, q.p1.w * (1 + 1 / kk), q.p2.x, q.p2.w * (1 + 1 / kk), cols.rumble[alt]);","+        quad(q.p1.x, q.p1.w, q.p2.x, q.p2.w, cols.road[alt]);","+        if (!alt) for (let l = 1; l < lanes; l++) { const u = -1 + 2 * l / lanes; quad(q.p1.x + u * q.p1.w, q.p1.w / (16 * lanes), q.p2.x + u * q.p2.w, q.p2.w / (16 * lanes), cols.lane); }","       }","-      if (fogF > .01 && fog) { g.fillStyle = `rgba(${fog[0]},${fog[1]},${fog[2]},${fogF.toFixed(3)})`; g.fillRect(0, Math.min(q0.p1.y, q0.p2.y), W, Math.abs(q0.p1.y - q0.p2.y) + 1); E.px.reset(g); }","-      // the scenery of this depth, at its track's centre","-      for (const q of prj) {","-        const things = q.s.things || [];","-        g.globalAlpha = 1;","-        for (const th of things) road._thing(g, th.what, q.p1.x + q.p1.scale * th.offset * o.width, q.p1.y, q.p1.scale, th.scale, t);","-      }","-      for (const c of cars) {","-        if (c.z < v.z - L || c.z > v.z + L) continue;","-        const seg = road.seg(c.z), q = prj.find(qq => qq.s === seg) || prj[0];","-        if (!q) continue;","-        const u = (((c.z - q.wz) % road.length + road.length) % road.length) / L;","-        road._thing(g, c, q.p1.x + (q.p2.x - q.p1.x) * u + q.p1.scale * c.x * o.width, q.p1.y + (q.p2.y - q.p1.y) * u, q.p1.scale, 8, t);","-      }","+      if (fog) { const f = 1 - Math.exp(-((k / o.draw) ** 2) * o.fog.density); if (f > .01) { g.fillStyle = `rgba(${fog[0]},${fog[1]},${fog[2]},${f.toFixed(3)})`; g.fillRect(0, top, W, hgt); px.reset(g); } }","+      for (const q of pieces) for (const th of (q.row.s.things || [])) { g.globalAlpha = 1; road._thing(g, th.what, q.p1.x + q.p1.scale * th.offset * o.width, q.p1.y, q.p1.scale, th.scale, t); }","     }","-    E.px.reset(g);","+    // the cars: on the current stage's own road, at the centre of their segment","+    for (const c of cars) {","+      if (c.z < v.z - L || c.z > v.z + 9 * L) continue;","+      const row = rows.find(rw => rw.road === road && rw.s === road.seg(c.z) && rw.off === 0);","+      if (!row) continue;","+      const p1 = road._p(row.x0 * o.width, row.s.y0, row.wz, C), p2 = road._p(row.x1 * o.width, row.s.y1, row.wz + L, C);","+      if (!p1 || !p2) continue;","+      const u = (((c.z - row.wz) % road.length + road.length) % road.length) / L;","+      road._thing(g, c, p1.x + (p2.x - p1.x) * u + p1.scale * c.x * o.width, p1.y + (p2.y - p1.y) * u, p1.scale, 8, t);","+    }","+    px.reset(g);","   });","   return road;"," };"]}],"originalFile":"// The fork's renderer (plan E1, in game code): when a junction is in view the road splits. Two branch surfaces run out of\n// the junction, each centred on its own offset (the spread eases from 0 to 2.4 half-roads over the junction), with the\n// gore between them. Beyond the junction each branch carries on as its stage. Before the decision both are drawn; after\n// it, only the chosen one, and the car rides with it (its x is kept relative to the branch), so the switch to the next\n// stage at the junction's end does not move the picture. Painted far to near like the engine's road.\n(() => {\n'use strict';\nconst E = My3D2dge, OB = window.OB || (window.OB = {});\nconst { px, clamp } = E;\nconst SPREAD = 2.4;\n\n/** the spread of the junction at a segment index of a stage: 0 before it, SPREAD after it, eased across it */\nfunction spreadAt(st, k) {\n  const j0 = Math.round(st.junction / OB.SEG), j1 = Math.round(st.len / OB.SEG);\n  if (k <= j0) return 0;\n  if (k >= j1) return SPREAD;\n  const u = (k - j0) / (j1 - j0);\n  return SPREAD * (-Math.cos(u * Math.PI) / 2 + .5);\n}\nOB.spreadAt = spreadAt;\n\n/** the branch tracks at this moment: both before the decision, the chosen one after it */\nfunction tracksOf(race, st) {\n  if (!st.forkZ || !race.fork) return null;\n  const f = race.fork;\n  const [l, r] = OB.nextStages(st.def).map(d => OB.World.stage(d.id));\n  if (f.decided) return [{ side: f.side === 'L' ? -1 : 1, st: f.side === 'L' ? l : r }];\n  return [{ side: -1, st: l }, { side: 1, st: r }];\n}\n\n/** the depth bands of the view: each with its strips (the shared road, or one per branch) */\nfunction buildStrips(race, st, v, road) {\n  const segs = road.segs, N = segs.length, L = road.o.segment, drawN = road.o.draw;\n  const base = road.seg(v.z), baseIdx = base.i, pct = (v.z % L) / L;\n  const jIdx = Math.round(st.junction / L);\n  const tracks = tracksOf(race, st);\n  const out = [];\n  let x = -(base.curve * pct);                      // the shared bend, from the car's own segment\n  const shared = [];\n  for (let k = 0; k < drawN; k++) {\n    const idx = baseIdx + k;\n    if (idx < jIdx || !tracks) {\n      const s = segs[idx % N];\n      const wz = s.z + (s.i < baseIdx ? road.length : 0);\n      shared.push({ k, x, s, wz, off: 0, road, yoff: 0, mine: true });\n      x += 0; x += s.curve;\n      continue;\n    }\n    // a junction segment or beyond: each track carries its own bend from here on\n    const rows = [];\n    for (const t of tracks) {\n      const tr = t.tx === undefined ? { tx: x } : t;\n      if (idx < N) {\n        const s = segs[idx];\n        rows.push({ k, s, wz: s.z + (s.i < baseIdx ? road.length : 0), off: t.side * spreadAt(st, idx), x: tr.tx, road, yoff: 0 });\n      } else {\n        const ns = t.st.road.segs, nidx = idx - N;\n        if (nidx >= ns.length) continue;\n        const s = ns[nidx];\n        rows.push({ k, s, wz: s.z + (nidx * L), off: t.side * SPREAD, x: tr.tx, road: t.st.road, yoff: road.segs[N - 1].y1 });\n      }\n    }\n    for (const t of tracks) { const seg = idx < N ? segs[idx] : t.st.road.segs[idx - N]; if (seg) { t.tx = (t.tx === undefined ? x : t.tx) + seg.curve; } }\n    out.push(...rows);\n  }\n  return { shared, strips: out, tracks, baseIdx, pct, base, L };\n}\n\n/** a band of the road for one strip: its rumble, road and lanes (the grass is painted once per band before these) */\nfunction roadBand(g, vp, road, p1, p2, colors, alt, lanes) {\n  const quad = (x1, w1, x2, w2, c) => px.poly(g, [[x1 - w1, p1.y], [x1 + w1, p1.y], [x2 + w2, p2.y], [x2 - w2, p2.y]], c);\n  const k = Math.max(6, 2 * lanes);\n  quad(p1.x, p1.w * (1 + 1 / k), p2.x, p2.w * (1 + 1 / k), colors.rumble[alt]);\n  quad(p1.x, p1.w, p2.x, p2.w, colors.road[alt]);\n  if (!alt) for (let l = 1; l < lanes; l++) { const u = -1 + 2 * l / lanes; quad(p1.x + u * p1.w, p1.w / (16 * lanes), p2.x + u * p2.w, p2.w / (16 * lanes), colors.lane); }\n}\n\n/** draw the stage's view: the normal road when no junction is in view, else the split road */\nOB.drawStage = (r, race, v) => {\n  const st = race.stage, road = st.road;\n  const inView = !!st.forkZ && !!race.fork && !r.viewport && Math.floor(v.z / road.o.segment) + road.o.draw > Math.round(st.junction / road.o.segment) - 1;\n  if (!inView) return road.draw(r, v);\n  const o = road.o, W = r.W, H = r.H, t = race.stage && (OB.game.time || 0);\n  const { shared, strips, tracks, base, L } = buildStrips(race, st, v, road);\n  const C = { x: (v.x || 0) * o.width, y: (v.h === undefined ? o.height : v.h) + road.yAt(v.z), z: v.z, cx: W / 2, cy: H / 2, hw: W / 2, hh: H / 2, pct: (v.z % L) / L, bend: [] };\n  road._cam = C;\n  const fog = o.fog && E.hex(o.fog.color);\n  r.overlay(g => {\n    // the sky, as the road draws it, then the bands far to near\n    if (o.sky && o.sky.draw) o.sky.draw(Object.create(r, { ctx: { value: g }, bw: { value: W }, bh: { value: H }, W: { value: W }, H: { value: H }, ix: { value: v.turn || 0 }, iy: { value: 0 } }));\n    else E.px.rect(g, 0, 0, W, H, o.sky || '#6aa8e8');\n    // each depth: the shared road, and the strips of the branches, drawn far to near\n    const depths = new Map();\n    for (const row of shared) depths.set(row.k, [row]);\n    for (const row of strips) { if (!depths.has(row.k)) depths.set(row.k, []); depths.get(row.k).push(row); }\n    const ks = [...depths.keys()].sort((a, b) => b - a);\n    const cars = v.cars || [];\n    for (const k of ks) {\n      const rows = depths.get(k);\n      const prj = rows.map(row => {\n        const s = row.s, sd = row.road.o.colors;\n        const p1 = road._p(row.x * o.width + row.off * o.width, s.y0 + row.yoff, row.wz, C);\n        const p2 = road._p((row.x + s.curve * 0 + 0) * o.width + row.off * o.width, s.y1 + row.yoff, row.wz + L, C);\n        return { row, p1, p2, s, sd };\n      }).filter(q => q.p1 && q.p2 && q.p1.d > road.depth);\n      if (!prj.length) continue;\n      const q0 = prj[0];\n      const alt = Math.floor(q0.s.i / o.rumble) % 2;\n      const colors = q0.sd;\n      // the grass across the band, then the road surfaces of each branch\n      const fogF = fog ? 1 - Math.exp(-((k / o.draw) ** 2) * o.fog.density) : 0;\n      E.px.rect(g, 0, Math.min(q0.p1.y, q0.p2.y), W, Math.abs(q0.p1.y - q0.p2.y) + 1, colors.grass[alt]);\n      for (const q of prj) {\n        const cols = Object.assign({}, o.colors, q.s.colors ? q.s.colors : {}, q.sd);\n        roadBand(g, null, road, q.p1, q.p2, cols, Math.floor(q.s.i / o.rumble) % 2, q.row.road.o.lanes || o.lanes);\n      }\n      if (fogF > .01 && fog) { g.fillStyle = `rgba(${fog[0]},${fog[1]},${fog[2]},${fogF.toFixed(3)})`; g.fillRect(0, Math.min(q0.p1.y, q0.p2.y), W, Math.abs(q0.p1.y - q0.p2.y) + 1); E.px.reset(g); }\n      // the scenery of this depth, at its track's centre\n      for (const q of prj) {\n        const things = q.s.things || [];\n        g.globalAlpha = 1;\n        for (const th of things) road._thing(g, th.what, q.p1.x + q.p1.scale * th.offset * o.width, q.p1.y, q.p1.scale, th.scale, t);\n      }\n      for (const c of cars) {\n        if (c.z < v.z - L || c.z > v.z + L) continue;\n        const seg = road.seg(c.z), q = prj.find(qq => qq.s === seg) || prj[0];\n        if (!q) continue;\n        const u = (((c.z - q.wz) % road.length + road.length) % road.length) / L;\n        road._thing(g, c, q.p1.x + (q.p2.x - q.p1.x) * u + q.p1.scale * c.x * o.width, q.p1.y + (q.p2.y - q.p1.y) * u, q.p1.scale, 8, t);\n      }\n    }\n    E.px.reset(g);\n  });\n  return road;\n};\n})();\n","userModified":false},"tool_result_meta":[{"id":"toolu_01KoDZEQTrMAeodtgFr4nukP","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
