r(demoCfg(seg, this.seed));","+    else if (seg.k === 'ending') OB.scenes.ending.enter({ result: { goal: 'A', mood: 'Bloom', passenger: 'marisol', score: 0, route: '', routeIds: [], time: 0, status: 'goal', attract: true } });","+    else OB.Music.play('results');","   },","-  exit() { OB.scenes.race.exit(); },","+  exit() { const seg = this.seg; if (seg && seg.k === 'race') { if (seg.versus) OB.scenes.versusrace.exit(); else OB.scenes.race.exit(); } },","   update(dt) {","     const I = G().input;","     if (I.anyPressed() || (I.clicked && I.clicked()) || I.move()[0] || I.move()[1]) { OB.attract.exit(); return; }","-    OB.scenes.race.update.call(OB.scenes.race, dt);","+    this.t += dt;","+    const seg = this.seg;","+    if (seg.k === 'race') { if (seg.versus) OB.scenes.versusrace.update.call(OB.scenes.versusrace, dt); else OB.scenes.race.update.call(OB.scenes.race, dt); }","+    else if (seg.k === 'ending') OB.scenes.ending.update.call(OB.scenes.ending, dt);","+    if (this.t > seg.s && !this.done) { this.done = true; OB.attract.next(); }","   },","   draw(r) {","-    OB.scenes.race.draw.call(OB.scenes.race, r);","-    const W = r.W, H = r.H, t = G().time || 0;","+    const seg = this.seg, W = r.W, H = r.H, t = G().time || 0;","+    if (seg.k === 'race') {","+      if (seg.versus) OB.scenes.versusrace.draw.call(OB.scenes.versusrace, r);","+      else OB.scenes.race.draw.call(OB.scenes.race, r);","+    } else if (seg.k === 'ending') OB.scenes.ending.draw.call(OB.scenes.ending, r);","+    else { r.sky(['#1a1040', '#3a1a5a', '#6a2a5a']); r.overlay(g => drawTable(g, W, H)); }","     r.overlay(g => {","-      E.font.text(g, 'DEMO PLAY · ' + (this.segment || ''), 6, H - 16, '#ffe04a', { shadow: '#000', outline: false, font: 'tiny' });","+      E.font.text(g, 'DEMO PLAY · ' + seg.name, 6, H - 16, '#ffe04a', { shadow: '#000', outline: false, font: 'tiny' });","       if (Math.floor(t * 2) % 2 === 0) {","         const label = G().input.lastDevice === 'gamepad' ? 'PRESS ' : 'PRESS ANY KEY';","         E.font.text(g, label, W / 2, H - 16, '#ffffff', { align: 'center', shadow: '#000', outline: false, font: 'tiny' });"]},{"oldStart":65,"oldLines":6,"newStart":97,"newLines":14,"lines":["     });","   },"," };","+","+/** the high-score table: the best score of each mode from the profile, as the arcade shows it */","+function drawTable(g, W, H) {","+  E.font.title(g, 'HIGH SCORES', W / 2, 12, { scale: 2, align: 'center' });","+  const rows = Object.entries(OB.profile.best || {}).sort((a, b) => b[1] - a[1]).slice(0, 6);","+  if (!rows.length) E.font.text(g, 'NO RUNS YET ON THIS DEVICE', W / 2, H / 2, '#ffe6c0', { align: 'center', outline: false, shadow: '#000', font: 'tiny' });","+  rows.forEach(([k, v], i) => E.font.text(g, (i + 1) + '  ' + k.toUpperCase().slice(0, 22) + '  ' + String(v), W / 2 - 110, 50 + i * 22, '#fff4e0', { outline: false, shadow: '#000', scale: 1 }));","+}"," OB.scenes = OB.scenes || {};"," OB.scenes.attract = attract;"," })();"]}],"originalFile":"// Attract mode (plan §7.22): after ten seconds with no input on the title, menu or garage, the game plays itself: the\n// bot drives a race with the cheats on (no collisions, no clock), with the passenger's requests and barks, and \"DEMO\n// PLAY\" over it. Any input ends it and returns to the title. It never writes the profile.\n(() => {\n'use strict';\nconst E = My3D2dge, OB = window.OB || (window.OB = {});\nconst G = () => OB.game;\nconst IDLE_SCENES = ['title', 'menu', 'garage'];\nconst IDLE_AFTER = 10;\n\n/** the idle clock: any input resets it; ten seconds on an idle screen starts the attract mode */\nOB.idle = {\n  t: 0, last: null,\n  reset() { this.t = 0; },\n  tick(dt, name) {\n    const I = G().input;\n    const p = I.pointer && I.pointer();\n    const moved = p && this.last && (Math.abs(p[0] - this.last[0]) + Math.abs(p[1] - this.last[1]) > 4);\n    this.last = p ? p.slice() : null;\n    const active = I.anyPressed() || I.move()[0] || I.move()[1] || moved || (I.clicked && I.clicked());\n    if (active) { this.t = 0; return; }\n    if (!IDLE_SCENES.includes(name)) { this.t = 0; return; }\n    this.t += dt;\n    if (this.t > IDLE_AFTER) { this.t = 0; OB.attract.start(); }\n  },\n};\n\n/** the attract director: the demo race, its seed, and the way back to the title */\nOB.attract = {\n  active: false, seed: 1, phase: 'idle',\n  start() { if (OB.env.hub) return; this.active = true; this.seed = 1; G().go('attract', { seed: this.seed }, { fade: 'wipe' }); },\n  next() { this.seed++; G().go('attract', { seed: this.seed }, { fade: 'wipe' }); },\n  exit() { this.active = false; OB.Hud.banners = []; G().go('title', null, { fade: 'wipe' }); },\n};\n\nconst car = ['orchidea', 'gardenia', 'magnolia', 'primavera', 'girasole'];\nconst attract = {\n  enter(data = {}) {\n    this.seed = data.seed || 1;\n    const c = OB.CARS.find(x => x.id === car[this.seed % car.length]) || OB.CARS[1];\n    // the playlist: an arcade run through the forks, a Love in Bloom run with its requests, and the Drift Duel\n    const seg = this.seed % 3;\n    const cfg = { mode: 'demo', demo: true, car: c.id, paint: 0, passenger: 'marisol', difficulty: 'Normal', seed: 1000 + this.seed * 37, route: null, cheats: { noCollide: true, infiniteTime: true } };\n    if (seg === 1) Object.assign(cfg, { mode: 'love' });\n    if (seg === 2) Object.assign(cfg, { mode: 'arcade', route: OB.MISSIONS.find(m => m.id === 'B2').route, mission: 'B2' });\n    this.segment = ['ARCADE', 'LOVE IN BLOOM', 'DRIFT DUEL'][seg];\n    OB.scenes.race.enter(cfg);\n    OB.attractEnded = false;\n  },\n  exit() { OB.scenes.race.exit(); },\n  update(dt) {\n    const I = G().input;\n    if (I.anyPressed() || (I.clicked && I.clicked()) || I.move()[0] || I.move()[1]) { OB.attract.exit(); return; }\n    OB.scenes.race.update.call(OB.scenes.race, dt);\n  },\n  draw(r) {\n    OB.scenes.race.draw.call(OB.scenes.race, r);\n    const W = r.W, H = r.H, t = G().time || 0;\n    r.overlay(g => {\n      E.font.text(g, 'DEMO PLAY · ' + (this.segment || ''), 6, H - 16, '#ffe04a', { shadow: '#000', outline: false, font: 'tiny' });\n      if (Math.floor(t * 2) % 2 === 0) {\n        const label = G().input.lastDevice === 'gamepad' ? 'PRESS ' : 'PRESS ANY KEY';\n        E.font.text(g, label, W / 2, H - 16, '#ffffff', { align: 'center', shadow: '#000', outline: false, font: 'tiny' });\n      }\n    });\n  },\n};\nOB.scenes = OB.scenes || {};\nOB.scenes.attract = attract;\n})();\n","userModified":false},"tool_result_meta":[{"id":"toolu_016v2F6ufCYqwrCREgBS1FGP","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
