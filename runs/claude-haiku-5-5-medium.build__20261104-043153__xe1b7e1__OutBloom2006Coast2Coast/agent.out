et best = { x: car.x, room: 0, score: -1e9 };\n    for (let i = 0; i < lanes; i++) {\n      const x = -1 + (2 * i + 1) / lanes;\n      let clear = true, room = 4000;\n      for (const v of traffic.list) {\n        if (Math.abs(v.x - x) >= .3) continue;\n        const dz = v.z - car.z;\n        if (dz > -300 && dz < 1800) clear = false;\n        else if (dz >= 1800 && dz < room) room = dz;\n      }\n      const score = (clear ? 10000 : 0) + room - Math.abs(x - car.x) * 300 + (Math.abs(x - car.x) < .1 ? 200 : 0);\n      if (score > best.score) best = { x, room, score };\n    }\n    this.laneX = best.x; this.laneRoom = best.room; this.laneScore = best.score;\n    return best;\n  }\n  /** the intent for this step. car: the CarSim; st: { def, road, len }; traffic: the Traffic; info: { forkWanted, forkSide } */\n  intent(car, st, traffic, info = {}) {\n    const cap = 2.0 * this.skill, vt = car.vtop();\n    // the road ahead: the sharpest bend within 2,500 units sets the speed; the racing line goes into it\n    let curve = 0;\n    for (let k = 1; k <= 13; k++) { const c = st.road.curveAt(car.z + k * 200); if (Math.abs(c) > Math.abs(curve)) curve = c; }\n    let target = clamp(Math.abs(curve) < .5 ? vt : vt * Math.sqrt(cap / (Math.abs(curve) * OB.tune('curvePush'))), 60, vt);\n    // the traffic: the lane it chooses; slow to the car in front only when no lane is clear\n    const pick = this.chooseLane(car, st, traffic);\n    if (pick.score < 10000) {\n      let ahead = 1e9;\n      for (const v of traffic.list) if (Math.abs(v.x - pick.x) < .3 && v.z > car.z + 60 && v.z - car.z < 1800) ahead = Math.min(ahead, v.kmh);\n      if (ahead < 1e8) target = Math.min(target, ahead * 1.05 + 10);\n    }\n    // the fork: the side the route plan wants, at the decision point\n    let lane = pick.x;\n    if (info.forkWanted && info.forkSide) lane = info.forkSide === 'L' ? -.6 : .6;\n    const steer = clamp((lane - car.x) * 2.2 - car.vx * .25, -1, 1);\n    // drifting: a sharp bend at speed, with the drift button held into it\n    const sharp = Math.abs(curve) >= 4.5 && car.v > 170 && this.driftOk;\n    const gas = car.v < target ? 1 : 0, brake = car.v > target + 12 ? clamp((car.v - target) / 40, .2, 1) : 0;\n    return { steer, gas, brake: sharp && car.v > target ? 0 : brake, drift: sharp && Math.abs(steer) > .3, shiftDown: false, shiftUp: false };\n  }\n}\nOB.Brain = Brain;\n})();\n","structuredPatch":[{"oldStart":6,"oldLines":29,"newStart":6,"newLines":21,"lines":[" const { clamp } = E;"," "," class Brain {","-  /** new OB.Brain({ forks: ['L', 'R', ...] (the side it takes at each fork, then the default), skill, drift }) */","+  /** new OB.Brain({ forks: ['L', 'R', ...] (the side it takes at each fork, in order), skill, drift }) */","   constructor(o = {}) {","-    this.forks = o.forks || []; this.fork = 0; this.skill = o.skill || 1; this.driftOk = o.drift !== false;","-    this.lane = null; this.dtAcc = 0; this.driftOn = false;","+    this.forks = o.forks || []; this.skill = o.skill || 1; this.driftOk = o.drift !== false;","+    this.laneT = 0; this.laneX = null; this.laneRoom = 0; this.laneScore = 0;","   }","-  /** the intent for this step: car (CarSim), st (the stage), traffic, the car's stage info, and the decision flag */","-  intent(car, st, traffic, info) {","-    const cap = 2.0 * this.skill, vt = car.vtop(), L = OB.SEG;","-    // look ahead: the sharpest bend within 2,500 units decides the speed; the racing line goes into it","-    let curve = 0, lineAhead = 0;","-    for (let k = 1; k <= 13; k++) { const c = st.road.curveAt(car.z + k * 200); if (Math.abs(c) > Math.abs(curve)) curve = c; }","-    lineAhead = curve;","-    const wantSpeed = (Math.abs(curve) < .5 ? vt : vt * Math.sqrt(cap / (Math.abs(curve) * OB.tune('curvePush'))));","-    let target = clamp(wantSpeed, 60, vt);","-    // traffic: a lane is clear when nothing is alongside or within a second's run ahead; the bot takes the clear lane","-    // with the most room (a lane change costs a little), and slows to the car in front only when no lane is clear","-    const lanes = st.def.lanes, xs = []; for (let i = 0; i < lanes; i++) xs.push(-1 + (2 * i + 1) / lanes);","-    // decide the lane every 0.4 s (hysteresis: a lane change is committed to, not re-thought each step)","-    this.laneT = (this.laneT || 0) - (1 / 120);","-    if (this.laneT > 0 && this.laneX !== undefined && (this.laneX !== null)) { bestX = this.laneX; bestRoom = this.laneRoom || 0; bestScore = this.laneScore || 0; }","-    else { this.laneT = .4;","-    let bestX = car.x, bestScore = -1e9, bestRoom = 0;","-    for (const x of xs) {","+  /** the lane the car should be in: a clear one (nothing alongside, nothing within a second's run ahead) with the most","+   *  room; the lane it is in is kept unless another is clearly better. Decided every 0.4 s, so it is committed to. */","+  chooseLane(car, st, traffic) {","+    const lanes = st.def.lanes;","+    this.laneT -= 1 / 120;","+    if (this.laneT > 0 && this.laneX !== null) return { x: this.laneX, room: this.laneRoom, score: this.laneScore };","+    this.laneT = .4;","+    let best = { x: car.x, room: 0, score: -1e9 };","+    for (let i = 0; i < lanes; i++) {","+      const x = -1 + (2 * i + 1) / lanes;","       let clear = true, room = 4000;","       for (const v of traffic.list) {","         if (Math.abs(v.x - x) >= .3) continue;"]},{"oldStart":36,"oldLines":20,"newStart":28,"newLines":30,"lines":["         if (dz > -300 && dz < 1800) clear = false;","         else if (dz >= 1800 && dz < room) room = dz;","       }","-      const score = (clear ? 10000 : 0) + room - Math.abs(x - car.x) * 300;","-      const score2 = score + (Math.abs(x - car.x) < .1 ? 200 : 0);   // (the lane we are in is kept unless another is clearly better)","-      if (score2 > bestScore) { bestScore = score2; bestX = x; bestRoom = room; }","+      const score = (clear ? 10000 : 0) + room - Math.abs(x - car.x) * 300 + (Math.abs(x - car.x) < .1 ? 200 : 0);","+      if (score > best.score) best = { x, room, score };","     }","-    this.laneX = bestX; this.laneRoom = bestRoom; this.laneScore = bestScore; }","-    if (bestScore < 10000) {","+    this.laneX = best.x; this.laneRoom = best.room; this.laneScore = best.score;","+    return best;","+  }","+  /** the intent for this step. car: the CarSim; st: { def, road, len }; traffic: the Traffic; info: { forkWanted, forkSide } */","+  intent(car, st, traffic, info = {}) {","+    const cap = 2.0 * this.skill, vt = car.vtop();","+    // the road ahead: the sharpest bend within 2,500 units sets the speed; the racing line goes into it","+    let curve = 0;","+    for (let k = 1; k <= 13; k++) { const c = st.road.curveAt(car.z + k * 200); if (Math.abs(c) > Math.abs(curve)) curve = c; }","+    let target = clamp(Math.abs(curve) < .5 ? vt : vt * Math.sqrt(cap / (Math.abs(curve) * OB.tune('curvePush'))), 60, vt);","+    // the traffic: the lane it chooses; slow to the car in front only when no lane is clear","+    const pick = this.chooseLane(car, st, traffic);","+    if (pick.score < 10000) {","       let ahead = 1e9;","-      for (const v of traffic.list) if (Math.abs(v.x - bestX) < .3 && v.z > car.z + 60 && v.z - car.z < 1800) ahead = Math.min(ahead, v.kmh);","+      for (const v of traffic.list) if (Math.abs(v.x - pick.x) < .3 && v.z > car.z + 60 && v.z - car.z < 1800) ahead = Math.min(ahead, v.kmh);","       if (ahead < 1e8) target = Math.min(target, ahead * 1.05 + 10);","     }","-    // the fork: the side the route plan wants (the bot goes to it at the decision point)","-    let lane = bestX;","+    // the fork: the side the route plan wants, at the decision point","+    let lane = pick.x;","     if (info.forkWanted && info.forkSide) lane = info.forkSide === 'L' ? -.6 : .6;","-    const steer = clamp((lane - car.x) * 2.2 - car.vx * .25 - lineAhead * .03, -1, 1);","+    const steer = clamp((lane - car.x) * 2.2 - car.vx * .25, -1, 1);","     // drifting: a sharp bend at speed, with the drift button held into it","     const sharp = Math.abs(curve) >= 4.5 && car.v > 170 && this.driftOk;","     const gas = car.v < target ? 1 : 0, brake = car.v > target + 12 ? clamp((car.v - target) / 40, .2, 1) : 0;"]}],"originalFile":"// The driver brain (plan §7.5): the same intent a player gives (steer, gas, brake, drift), from the road ahead and the\n// traffic. The bot, the attract demo, the tests and the rivals all drive through CarSim with no special physics.\n(() => {\n'use strict';\nconst E = My3D2dge, OB = window.OB || (window.OB = {});\nconst { clamp } = E;\n\nclass Brain {\n  /** new OB.Brain({ forks: ['L', 'R', ...] (the side it takes at each fork, then the default), skill, drift }) */\n  constructor(o = {}) {\n    this.forks = o.forks || []; this.fork = 0; this.skill = o.skill || 1; this.driftOk = o.drift !== false;\n    this.lane = null; this.dtAcc = 0; this.driftOn = false;\n  }\n  /** the intent for this step: car (CarSim), st (the stage), traffic, the car's stage info, and the decision flag */\n  intent(car, st, traffic, info) {\n    const cap = 2.0 * this.skill, vt = car.vtop(), L = OB.SEG;\n    // look ahead: the sharpest bend within 2,500 units decides the speed; the racing line goes into it\n    let curve = 0, lineAhead = 0;\n    for (let k = 1; k <= 13; k++) { const c = st.road.curveAt(car.z + k * 200); if (Math.abs(c) > Math.abs(curve)) curve = c; }\n    lineAhead = curve;\n    const wantSpeed = (Math.abs(curve) < .5 ? vt : vt * Math.sqrt(cap / (Math.abs(curve) * OB.tune('curvePush'))));\n    let target = clamp(wantSpeed, 60, vt);\n    // traffic: a lane is clear when nothing is alongside or within a second's run ahead; the bot takes the clear lane\n    // with the most room (a lane change costs a little), and slows to the car in front only when no lane is clear\n    const lanes = st.def.lanes, xs = []; for (let i = 0; i < lanes; i++) xs.push(-1 + (2 * i + 1) / lanes);\n    // decide the lane every 0.4 s (hysteresis: a lane change is committed to, not re-thought each step)\n    this.laneT = (this.laneT || 0) - (1 / 120);\n    if (this.laneT > 0 && this.laneX !== undefined && (this.laneX !== null)) { bestX = this.laneX; bestRoom = this.laneRoom || 0; bestScore = this.laneScore || 0; }\n    else { this.laneT = .4;\n    let bestX = car.x, bestScore = -1e9, bestRoom = 0;\n    for (const x of xs) {\n      let clear = true, room = 4000;\n      for (const v of traffic.list) {\n        if (Math.abs(v.x - x) >= .3) continue;\n        const dz = v.z - car.z;\n        if (dz > -300 && dz < 1800) clear = false;\n        else if (dz >= 1800 && dz < room) room = dz;\n      }\n      const score = (clear ? 10000 : 0) + room - Math.abs(x - car.x) * 300;\n      const score2 = score + (Math.abs(x - car.x) < .1 ? 200 : 0);   // (the lane we are in is kept unless another is clearly better)\n      if (score2 > bestScore) { bestScore = score2; bestX = x; bestRoom = room; }\n    }\n    this.laneX = bestX; this.laneRoom = bestRoom; this.laneScore = bestScore; }\n    if (bestScore < 10000) {\n      let ahead = 1e9;\n      for (const v of traffic.list) if (Math.abs(v.x - bestX) < .3 && v.z > car.z + 60 && v.z - car.z < 1800) ahead = Math.min(ahead, v.kmh);\n      if (ahead < 1e8) target = Math.min(target, ahead * 1.05 + 10);\n    }\n    // the fork: the side the route plan wants (the bot goes to it at the decision point)\n    let lane = bestX;\n    if (info.forkWanted && info.forkSide) lane = info.forkSide === 'L' ? -.6 : .6;\n    const steer = clamp((lane - car.x) * 2.2 - car.vx * .25 - lineAhead * .03, -1, 1);\n    // drifting: a sharp bend at speed, with the drift button held into it\n    const sharp = Math.abs(curve) >= 4.5 && car.v > 170 && this.driftOk;\n    const gas = car.v < target ? 1 : 0, brake = car.v > target + 12 ? clamp((car.v - target) / 40, .2, 1) : 0;\n    return { steer, gas, brake: sharp && car.v > target ? 0 : brake, drift: sharp && Math.abs(steer) > .3, shiftDown: false, shiftUp: false };\n  }\n}\nOB.Brain = Brain;\n})();\n","userModified":false},"tool_result_meta":[{"id":"toolu_016AryFwyBGjWkckgbzD8jaN","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
