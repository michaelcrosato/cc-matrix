le, c = KIND[e.kind] || '#8a8a94';\n        const xa = p1.x + sgn * p1.w, xb = p2.x + sgn * p2.w;\n        px.poly(g, [[xa, p1.y], [xb, p2.y], [xb, p2.y - h2], [xa, p1.y - h1]], c);\n        if (e.kind === 'rail') px.line(g, xa, p1.y - h1 * .5, xb, p2.y - h2 * .5, '#ffffff', 1);\n      }\n    }\n    const sp = s.span;\n    if (sp) {   // the span: a band across the road, high above it\n      const hh1 = (sp.h || 1100) * p1.scale, hh2 = (sp.h || 1100) * p2.scale, t1 = 60 * p1.scale, t2 = 60 * p2.scale, c = KIND[sp.kind] || '#f0e0c0';\n      const xa = p1.x - p1.w * 1.15, xb = p2.x - p2.w * 1.15, xc = p1.x + p1.w * 1.15, xd = p2.x + p2.w * 1.15;\n      px.poly(g, [[xa, p1.y - hh1 - t1], [xc, p1.y - hh1 - t1], [xd, p2.y - hh2 - t2], [xb, p2.y - hh2 - t2]], c);\n      if (sp.kind === 'bunting') for (let k = 0; k < 9; k++) { const u = (k + .5) / 9; px.disc(g, p1.x + (p2.x - p1.x) * u, p1.y - hh1 + (p2.y - p1.y) * u, 2, ['#ff5a8a', '#3ac8e0', '#ffe04a'][k % 3]); }\n    }\n  }\n  _band(g, vp, s, p1, p2, fog, f) {\n\"\"\")\nrep(\"    px.rect(g, X, y2, W, y1 - y2, C.grass[alt]);\\n    const k = Math.max(6, 2 * o.lanes);\",\n    \"    px.rect(g, X, y2, W, y1 - y2, C.grass[alt]);\\n    this.dressBand(g, vp, s, p1, p2, alt);\\n    const k = Math.max(6, 2 * o.lanes);\")\nopen(p,'w').write(s); print('E2 ok')\nEOF\nnode --check engine/my-3d2dge.js && echo ok","description":"Add road dressing (grounds, edge walls, spans) to the engine road"}}}
