 true, role: 'bowl' });\n  for (const f of match.fielders) {\n    if (f.keeper) out.push({ key: 'keeper', side: match.bowlingSide, idx: 3, x: f.x, y: f.y, facing: PI / 2, role: 'keeper' });\n    else out.push({ key: 'f' + f.id, side: match.bowlingSide, idx: (f.id * 2 + 1) % 11, x: f.x, y: f.y, facing: Math.atan2(G.W.CY - f.y, G.W.PX - f.x), role: 'field' });\n  }\n  return out;\n};\n// the rigs take their poses from the simulation each step: the run, the stance, the swing of the batter\nG.tickRigs = (dt, match) => {\n  if (!match || dt <= 0) return;\n  G._prev = G._prev || {};\n  for (const p of G.playersNow(match)) {\n    const rig = G.rigOf(p.key, p.side, p.idx);\n    const prev = G._prev[p.key] || { x: p.x, y: p.y };\n    const vx = (p.x - prev.x) / dt, vy = (p.y - prev.y) / dt;\n    G._prev[p.key] = { x: p.x, y: p.y };\n    let attack = null;\n    if (p.role === 'bat' && p.bat && G.swingState) attack = E.move('slash', G.swingState.u, 'active');\n    rig.update(dt, { x: p.x, y: p.y, z: 0, vx, vy, facing: p.facing, attack, stance: p.role === 'bat' ? 'ready' : undefined, crouch: p.role === 'keeper' || p.role === 'field' && Math.hypot(vx, vy) < 1 ? undefined : undefined });\n  }\n};\n\n'''+s[b:]\ns=s.replace(\"    if (p.bat) G.drawBat(r, rig, p.batAngle, p.batLift);\",\"    if (p.bat) G.drawBat(r, rig, G.batAngleNow(), G.batLiftNow());\")\ns=s.replace(\"G.umpireRig = () =>\",\"G.batAngleNow = () => G.swingPose ? G.swingPose.angle : PI / 2 - 0.35;\\nG.batLiftNow = () => G.swingPose ? G.swingPose.lift : 0;\\nG.umpireRig = () =>\")\nopen('src/30-present.js','w').write(s)\nprint('present ok')\n\ns=open('src/40-match.js').read()\nold=\"\"\"    G.match.swingPose = { angle: G.swingPose.dir * PI / 180 + (1 - k) * 0.9 - 0.45, lift: 6 * (1 - k) };\n  } else if (m) m.swingPose = null;\"\"\"\nassert s.count(old)==1\ns=s.replace(old,\"\"\"    G.swingPose.angle = G.swingPose.dir * PI / 180 + (1 - k) * 0.9 - 0.45;\n    G.swingPose.lift = 6 * (1 - k);\n    G.swingState = { u: clamp(k, 0, 1) };\n  } else { G.swingState = null; }\"\"\")\ns=s.replace(\"\"\"  if (G.swingPose) { G.swingPose.t -= dt; if (G.swingPose.t <= 0) G.swingPose = null; }\"\"\",\"\"\"  if (G.swingPose) { G.swingPose.t -= dt; if (G.swingPose.t <= 0) G.swingPose = null; }\"\"\")\nold2=\"\"\"    G.humanInput(I, step);\"\"\"\nassert s.count(old2)==1\ns=s.replace(old2,\"\"\"    G.humanInput(I, step);\n    G.tickRigs(dt, m);\"\"\")\ns=s.replace(\"\"\"  G.swingPose = null;\n  G.lastMarkerTouch\"\"\",\"\"\"  G.swingPose = null;\n  G.swingState = null;\n  G.lastMarkerTouch\"\"\")\nopen('src/40-match.js','w').write(s)\nprint('match ok')\nEOF\ngrep -n \"G.swingPose = { t\" src/40-match.js | head -2; grep -n \"swingPose\" src/*.js | head","description":"Wire rig updates, swing, bat drawing and pitch tags"}},"wire_ingest_context":{"toolu_01PEbM19HUFkjnNfmjH5rGem":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-064807__xe36ddc/work/CricketKerfuffle-Cricket-claude-haiku-5-5-medium-20261104-064807"}}}
