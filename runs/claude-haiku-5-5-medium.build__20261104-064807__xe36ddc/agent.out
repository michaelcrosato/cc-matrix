 bowl: 'sawn' },\\n  'Mystique': {}, 'The Great Spinaldo': { bowl: 'vanish' }, 'Madame Zsa-Zsa Flick': { bowl: 'sawn' }, 'Houdini Jnr': { field: 'lightning' },\\n  'Lord Rufus Thrumpton-Vane': { bowl: 'grudge', bat: 'grudgeDrive' }, 'The Thrumptonator 3000': { bowl: 'triple' }, 'Dr Ebenezer Grimble': { bat: 'ectoplasmic' },\")\ns=rep(s,\"  chirp: { kind: 'field', name: 'THE CHIRP',\",\"  lightning: { kind: 'field', name: 'LIGHTNING STUMPING', text: 'The stumping window triples for one over.' },\\n  grudgeDrive: { kind: 'bat', name: 'THE GRUDGE DRIVE', text: 'A power drive straight back at the bowler.', shot: 'drive', mult: 1.3 },\\n  triple: { kind: 'bowl', name: 'TRIPLE THREAT', text: 'Three balls: two holograms on other lines, and one real ball. Only the real one matters.', delivery: 'triple' },\\n  chirp: { kind: 'field', name: 'THE CHIRP',\")\ns=rep(s,\"  vanish: { kind: 'bowl', name: 'THE VANISHING BALL'\",\"  vanish: { kind: 'bowl', name: 'THE VANISHING BALL'\")\n# the fifth ground: Dustbowl Downs, rough patches and dust devils\ns=rep(s,\"G.GROUND_ORDER = ['green', 'hall', 'bay', 'dome'];\",\"\"\"G.GROUNDS.downs = {\n  id: 'downs', name: 'Dustbowl Downs', short: 'THE DOWNS', sky: ['#ffcf8a', '#c89a6a'], light: 'day', ambient: .9,\n  overcast: false, swing: 1, bounce: 1.05, spin: 1.6, grass: '#a8a85a', grassDark: '#97974e', pitch: '#d4b37a', ring: '#f4f4f0',\n  outfieldK: 0.85, boundary: 1.0, tip: 'Rough outside off turns the spinners. The top hat is worth eight. The balloon is worth fifteen.',\n  targets: [\n    { id: 'tophat', name: 'The giant top hat', x: 300, y: 330, z: 40, r: 22, bonus: 8, colour: '#1a1a22' },\n    { id: 'balloon', name: 'The hot-air balloon', x: 840, y: 240, z: 120, r: 26, bonus: 15, colour: '#e04a3a' }\n  ],\n  chaos: ['rain', 'dust'], chaosTag: 'the dust devils', camp: 'Top Hat End'\n};\nG.GROUND_ORDER = ['green', 'hall', 'bay', 'downs', 'dome'];\"\"\")\ns=rep(s,\"  fireworks: { name: 'FIREWORKS',\",\"  dust: { name: 'DUST DEVILS', text