ers'))), wkts: Math.max(0, ['2', '3', '5', '10'].indexOf(String(G.setting('wickets') === '5' ? 5 : G.setting('wickets')))), bat: 0, p2: false };\"),\n])\nedit('src/60-dev.js', [\n (\"      { kind: 'act', label: 'NEXT BALL IS A DOT (BEATEN)', fn: () => G.devForce('beaten') },\\n\", \"\"),\n (\"G.devForce = kind => {\\n  // the next ball is a dot: the bat is beaten by the next delivery (the balls on the test path)\\n  G.match.forced = kind;\\n};\\n\", \"\"),\n])\nedit('src/30-present.js', [\n (\"G.ballFx = (r, match) => {\\n  const b = match.ball;\\n  if (!b || match.phase === 'end') return;\",\n  \"// the bowler's marker on the pitch, while the human bowls; and the dev toggle's predicted path\\nG.drawMarker = (r, match) => {\\n  if (!match || match.phase !== 'setup' || !match.humanBowls() || G.setting('marker') !== 'On') return;\\n  const mk = G.marker;\\n  r.queue(mk.x, mk.y, 0, g => {\\n    const p = r.w(mk.x, mk.y, 0);\\n    for (let i = 0; i < 12; i++) { const a = i / 12 * TAU; px.disc(g, p[0] + Math.cos(a) * 4, p[1] + Math.sin(a) * 2, 0.6, '#ffe08a'); }\\n  }, { bias: -2 });\\n};\\nG.drawTrajectory = (r, match) => {\\n  const b = match.ball;\\n  if (!G.devFlags.trajectory || !b || match.phase !== 'flight') return;\\n  const c = G.clone(b);\\n  for (let k = 0; k < 480; k++) {\\n    G.stepBall(c, match.env, null);\\n    if (k % 8) continue;\\n    const p = r.w(c.x, c.y, c.z);\\n    r.overlay(g => px.rect(g, p[0], p[1], 1, 1, '#7ad0ff'));\\n    if (c.z <= 0 && c.pitched === false && k > 0) continue;\\n  }\\n};\\nG.ballFx = (r, match) => {\\n  const b = match.ball;\\n  if (!b || match.phase === 'end') return;\"),\n])\nedit('src/40-match.js', [\n (\"    G.drawBallPlaceholder\", \"    G.drawBallPlaceholder\"),\n]) if False else None\ns=open('src/40-match.js').read()\ns=s.replace(\"    G.drawPlayers(r, m);\\n    G.ballFx(r, m);\",\"    G.drawPlayers(r, m);\\n    G.drawMarker(r, m);\\n    G.ballFx(r, m);\\n    G.drawTrajectory(r, m);\")\nopen('src/40-match.js','w').writ