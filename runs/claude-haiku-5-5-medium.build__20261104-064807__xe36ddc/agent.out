 return; }\n    this.cpuIntent = { button, aim: null, special: null };\n    this.cpuPressAt = this.arriveAbs - G.SHOTS.drive.contactAt + err;\n  }''')\ns=replace_method(s,'cpuFire','''  cpuFire() {\n    if (!this.cpuIntent) { this.cpuPressAt = null; return; }\n    const it = this.cpuIntent;\n    this.cpuPressAt = null;\n    this.batPress(it.button, it.aim, it.special || null);\n  }''')\ns=rep(s,\"  // a delivery passes the batter: a wide, a no-ball, bowled, LBW, or a beaten bat\",\n\"  // a delivery passes the batter: a wide, a no-ball, bowled, LBW, or a beaten bat\")\nopen(p,'w').write(s); print('methods ok')\nEOF\nnode -e \"new Function(require('fs').readFileSync('src/21-match.js','utf8'))\" && echo parses","description":"Rewrite the match's special, batting and contact methods"}},"wire_ingest_context":{"toolu_014v6jmTjZ1Q4TpA7sE5JB4q":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-064807__xe36ddc/work/CricketKerfuffle-Cricket-claude-haiku-5-5-medium-20261104-064807"}}}
