kets')))), bat: 0, p2: false, layout: 0 };\n    const S = G.setupState;\"\"\", \"\"\"    // a Quick Match opponent must be unlocked; a Versus has every side\n    const open = mode === 'quick' ? G.unlockedTeams() : G.TEAMS.map((_, i) => i);\n    const teamVals = G.TEAMS.map(t => t.name);\n    G.setupState = { mode, home: 0, away: open.find(i => i !== 0) !== undefined ? open.find(i => i !== 0) : 0, ground: 0, overs: Math.max(0, ['1', '2', '3', '5'].indexOf(G.setting('overs'))), wkts: Math.max(0, ['2', '3', '5', '10'].indexOf(String(G.setting('wickets')))), bat: 0, p2: false, layout: 0 };\n    const S = G.setupState;\"\"\")\nedit('src/41-front.js', \"\"\"      { label: 'AWAY', values: teamVals, idx: S.away, onChange: (v, k) => { S.away = k; if (S.home === k) S.home = (k + 1) % G.TEAMS.length; } },\"\"\",\n\"\"\"      { label: 'AWAY', values: open.map(i => teamVals[i]), idx: Math.max(0, open.indexOf(S.away)), onChange: (v, k) => { S.away = open[k]; if (S.home === S.away) S.home = (S.away + 1) % G.TEAMS.length; } },\"\"\")\n# fastest ball in the match\nedit('src/21-match.js', \"\"\"    this.lastDel = { key: D.key, label: del.label || D.key, fam: del.fam || D.fam || 'pace', kmh: Math.round(kmh), target, quality, special: special || null };\"\"\",\n\"\"\"    this.lastDel = { key: D.key, label: del.label || D.key, fam: del.fam || D.fam || 'pace', kmh: Math.round(kmh), target, quality, special: special || null };\n    this.fastestKmh = Math.max(this.fastestKmh || 0, this.lastDel.kmh);\"\"\")\n# dev jump: unlock all teams\nedit('src/60-dev.js', \"\"\"      { kind: 'act', label: 'WIN THE CHAPTER (STORY)',\"\"\", \"\"\"      { kind: 'act', label: 'UNLOCK ALL TEAMS', fn: () => { const P = G.profile(); P.unlocks = G.TEAMS.map((_, i) => i); G.saveProfile(P); } },\n      { kind: 'act', label: 'WIN THE CHAPTER (STORY)',\"\"\")\nprint('ok')\nEOF\nnode tools/build.mjs | tail -1 && timeout 580 node test/run.mjs 2>&1 | tail -12","description":"Add profile unlocks, stats, quick-match gat