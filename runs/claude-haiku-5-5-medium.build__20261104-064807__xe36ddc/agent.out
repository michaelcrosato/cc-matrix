apter;\n  const won = !!(match.result && match.result.winner === 0);\n  const view = { won, stats: match.stats, targetsHit: match.targetsHit, innings: match.innings };\n  const goals = c.goals.map(([, test]) => !!test(view));\n  const stars = goals.filter(Boolean).length;\n  const P = G.profile();\n  P.stars[c.id - 1] = Math.max(P.stars[c.id - 1] || 0, stars);\n  if (won && P.chapter === c.id) P.chapter = c.id + 1;\n  G.saveProfile(P);\n  G.lastGoals = goals;\n  return { won, stars, goals };\n};\n\n'''+s[b:]\ns=rep(s,\"    const cfg = { teams: [0, c.opp], ground: c.ground, overs: c.overs, wickets: c.wickets, kerf: c.id >= 2, seed: 77 + c.id * 13, batFirst: c.batFirst ? 0 : 1, humanSides: [0], mode: 'story', chapter: c.id };\",\n\"    const cfg = { teams: [0, c.opp], ground: c.ground, overs: c.overs, wickets: c.wickets, kerf: !!c.kerf || c.id >= 2, seed: 77 + c.id * 13, batFirst: c.batFirst ? 0 : 1, humanSides: [0], mode: 'story', chapter: c.id, forceRain: !!c.forceRain };\")\nopen(p,'w').write(s)\nprint('ok')\nEOF\nnode -e \"new Function(require('fs').readFileSync('src/41-front.js','utf8'))\" && node -e \"new Function(require('fs').readFileSync('src/42-modes.js','utf8'))\" && node -e \"new Function(require('fs').readFileSync('src/00-head.js','utf8'))\" && echo parses","description":"Route match ends to the new screens and reconcile the chapters"}},"wire_ingest_context":{"toolu_01Gqb4owgxa2H1iuLHxx4ZFj":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-064807__xe36ddc/work/CricketKerfuffle-Cricket-claude-haiku-5-5-medium-20261104-064807"}}}
