m.fielders.filter(f => f.human).map(f => [Math.round(f.x), Math.round(f.y)]) : [],\\n      ballXY: m && m.ball ? [Math.round(m.ball.x), Math.round(m.ball.y), Math.round(m.ball.z * 10) / 10] : null,\\n      inputs: game.players ? game.players.length : 1,\")\nopen(p,'w').write(s)\nprint('ok')\nEOF\nnode -e \"new Function(require('fs').readFileSync('src/70-debug.js','utf8'))\" && node -e \"new Function(require('fs').readFileSync('src/43-extras.js','utf8'))\" && node tools/build.mjs | tail -1 && timeout 400 node test/run.mjs features flow 2>&1 | tail -3","description":"Add frame recording, debug timing fields and rebuild"}},"wire_ingest_context":{"toolu_0194frnP3moJVMUAz55YWsSw":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-064807__xe36ddc/work/CricketKerfuffle-Cricket-claude-haiku-5-5-medium-20261104-064807"}}}
