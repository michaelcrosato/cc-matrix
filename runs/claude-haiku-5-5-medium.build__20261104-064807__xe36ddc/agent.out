 pickOpener(side) {","-    const team = this.team(side);","-    return team.bowlers[0];","+  superBattingFirst() { return 1 - this.cfg.batFirst; }   // the side batting second in the match bats first in the Super Over","+  startOver() {","+    const I = this.I;","+    I.ballInOver = 0; I.overRuns = 0;","+    I.bowler = this.pickBowler();","+    this.overSetupChance();","+    this.setPhase('setup', 0.7);","   }","-  get I() { return this.innings[this.inn]; }","-  get striker() { const I = this.I; return I.bat.find(b => b.end === 'A' && !b.out) || I.bat[0]; }","-  get nonStriker() { const I = this.I; return I.bat.find(b => b !== this.striker && !b.out) || I.bat[1]; }","-  batterName(b) { return this.team(this.battingSide).squad[b.p]; }","-  bowlerName() { return this.team(this.bowlSide).squad[this.I.bowler]; }","-  batterOf(b) { return this.team(this.battingSide).squad[b.p]; }","-  // the innings' last over was bowled: the bowling side chooses, and each new over starts with the striker on strike","-  beginOver() {","+  // the chaos and items of an over start: items float for the batting side, chaos happens between overs","+  overSetupChance() {","+    if (!this.cfg.kerf) return;","     const I = this.I;","-    I.ballInOver = 0; I.over_runs = 0;","-    this.fieldPreset = this.fieldPreset || 'balanced';","-    this.placeFielders();","-    this.setTimer('setup', 0.6);","-    this.phase = 'setup';","-    // the Kerfuffle chaos roll happens once per over, between overs","-    if (this.kerf && I.over > 0 && this.rnd() < 0.3 * G.T('chaosRate') && this.ground.chaos.length) {","-      const pool = this.ground.chaos.filter(c => c !== 'rain' || (I.k === 1 && !this.rainUsed));","+    if (I.over > 0 && this.rng() < 0.3 * G.T('chaosRate') && this.ground.chaos.length && !this.chaosNow) {","+      let pool = this.ground.chaos.filter(c => c !== 'rain' || (I.k === 1 && !this.rainUsed && !I.isSuper));","       if (pool.length) {","-        const id = pool[Math.floor(this.rnd() * pool.le