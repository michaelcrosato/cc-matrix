onst bowlers = list.length ? list : team.bowlers;","-    I.bowlerLast = I.bowler;","-    I.bowler = bowlers[(I.over) % bowlers.length];","-  }","-  // a stop for the inputs: the current human roles","-  cpuBatting() { return !this.cfg.humans || this.cfg.humans.batSide !== this.battingSide || this.cfg.autoBat; }","+  // ---- CPU batting ----","   cpuPlanBat() {","-    const diff = G.T('aiBatSkill');","-    const err = (this.rnd() - .5) * 2 * diff / 1000 * (this.delivery && this.lastDel && this.lastDel.fam === 'spin' ? 1.2 : 1);","-    const perfect = this.cfg.cheatPerfect;","-    this.cpuPressAt = this.t + (this.predArrive || 0.4) - G.SHOTS.drive.contactAt + (perfect ? 0 : err);","-    this.cpuIntent = this.cpuChooseShot();","+    const err = (this.rng() - 0.5) * 2 * G.T('aiBatSkill') / 1000;","+    const pitch = this.predictPitch();","+    const len = G.lengthOf(pitch.y);","+    const loft = this.rng() < G.T('aiAggression') * 0.6 && len !== 'yorker';","+    const button = len === 'yorker' ? 'block' : loft ? 'loft' : 'shot';","+    this.cpuIntent = { button, aim: null };","+    this.cpuPressAt = this.arriveAbs - G.SHOTS.drive.contactAt + err;","   }","-  cpuChooseShot() {","-    const pr = this.cpuIntent;","-    const len = G.lengthOf(this.ball.pitchY || (this.ball.pitchY = this.predictPitchY()));","-    const agg = G.T('aiAggression');","-    const boost = this.cfg.cheatPerfect ? 0.9 : 0;","-    const loft = this.rnd() < agg * 0.6 + boost * 0.3 && (len !== 'yorker');","-    const button = len === 'yorker' ? 'block' : len === 'short' ? (loft ? 'loft' : 'shot') : loft ? 'loft' : 'shot';","-    return { button, aim: null, cpu: true };","-  }","-  cpuPress() {","-    if (this.pressed || !this.cpuIntent) return;","+  cpuFire() {","+    if (!this.cpuIntent) { this.cpuPressAt = null; return; }","     const it = this.cpuIntent;","     this.cpuPressAt = null;","     this.batPress(it.button, it.aim);","   }","-  // the bowling side's fielders: a human takes the active fielder (the one nearest the ball)","-  setActiveHuman(f) { for (const x of this.fielders) x.human = false; if (f) f.human = true; }","+  // ---- human inputs: the stick aims the batter, the field moves the active fielder ----","   fieldMove(dx, dy, dt) {","-    const f = this.fielders.find(x => x.human); if (!f) return;","-    const sp = f.speed * 1.2;","-    f.x = clamp(f.x + dx * sp * dt, 60, 1090); f.y = clamp(f.y + dy * sp * dt, 60, 1090);","+    const f = this.humanField();","+    if (!f || f.hold) return;","+    const sp = f.speed * 1.15;","+    f.x = clamp(f.x + dx * sp * dt, 40, 1112); f.y = clamp(f.y + dy * sp * dt, 40, 1112);","   }","+  // a human fielder's button: the throw to an end ('A' the striker's, 'B' the bowler's), or a catch press","+  fieldAct(end) {","+    if (this.catchRing) return this.catchPress();","+    if (this.humanFieldHold) { const f = this.humanFieldHold.f; this.throwTo(f, end); return true; }","+    return false;","+  }"," };"]}],"originalFile":"/* ---- THE MATCH: a pure simulation. Innings, overs, the delivery director, batting, bowling, fielding, running, the\n * umpire, Hype and the arcade layer. It runs in fixed steps (G.DT) with a seeded RNG (the play stream), emits events\n * for the presentation, and takes human input through its methods. Every state has a timeout, so play cannot stall. ---- */\nconst CONTACT_Y = 452;                 // the front-foot contact plane, 16 units in front of the batter's crease\nconst PRESET_ORIGIN = { x: 576, y: 576 };\nG.PRESETS = {\n  balanced: [[165, 190, 'slip'], [95, 240, 'point'], [55, 270, 'cover'], [12, 320, 'mid-off'], [-12, 320, 'mid-on'], [-60, 270, 'mid-wkt'], [-95, 250, 'sq-leg'], [-160, 300, 'fine-leg'], [155, 300, 'third-man']],\n  attacking: [[165, 190, 'slip'], [158, 190, 'slip2'], [132, 200, 'gully'], [95, 230, 'point'], [58, 260, 'cover'], [14, 300, 'mid-off'], [-14, 300, 'mid-on'], [-160, 300, 'fine-leg'], [151, 320, 'third-man']],\n  defensive: [[95, 260, 'point'], [55, 360, 'deep-cover'], [12, 360, 'long-off'], [-12, 360, 'long-on'], [-60, 360, 'deep-mid-wkt'], [-95, 360, 'deep-sq'], [-160, 340, 'fine-leg'], [155, 340, 'third-man'], [40, 260, 'cover']],\n  spin: [[160, 110, 'slip'], [-100, 100, 'short-leg'], [100, 100, 'silly-point'], [55, 240, 'cover'], [12, 280, 'mid-off'], [-12, 280, 'mid-on'], [-60, 240, 'mid-wkt'], [-95, 360, 'deep-sq'], [-15, 360, 'long-on']]\n};\nG.PRESET_ORDER = ['attacking', 'balanced', 'defensive', 'spin'];\n// a fielder's place for a preset: the batter's frame (degrees from straight, + off side), distance from the pitch's middle\nG.presetSpot = (theta, dist, hand = 1) => {\n  const r = theta * PI / 180;\n  const dx = -hand * Math.sin(r), dy = Math.cos(r);\n  return { x: PRESET_ORIGIN.x + dx * Math.min(dist, 520), y: PRESET_ORIGIN.y + dy * Math.min(dist, 500) };\n};\n\nG.Match = class Match {\n  constructor(cfg) {\n    this.cfg = cfg;\n    this.ground = G.GROUNDS[cfg.ground] || G.GROUNDS.green;\n    this.env = G.envOf(this.ground);\n    this.rng = E.rng(cfg.seed || 1);\n    this.t = 0;                         // match time, seconds (steps of G.DT)\n    this.teams = cfg.teams || [0, 1];   // indices into G.TEAMS: [side 0, side 1]\n    this.overs = cfg.overs || 2;\n    this.wkts = cfg.wickets || 5;\n    this.kerf = cfg.kerf !== false;\n    this.events = [];                   // presentation events, drained by the scene\n    this.log = [];                      // every ball, for the scorecard and the report\n    this.hype = [0, 0]; this.streak = [0, 0]; this.fire = [false, false];\n    this.items = [[], []]; this.targetsHit = {}; this.targetBonus = [0, 0];\n    this.inn = -1; this.innings = []; this.battingSide = 0; this.phase = 'idle'; this.timer = 0;\n    this.result = null; this.review = [1, 1]; this.freeHit = false; this.reviewWindow = 0;\n    this.chaos = null; this.rainDelay = 0; this.kmDelay = null; this.specialArm = [null, null];\n    this.delivery = null; this.ball = null; this.catchRing = null; this.throwing = null;\n    this.cpuPressAt = null; this.pressed = null; this.runs = null;\n    this.fielders = [];                 // the bowling side's eleven, by the batter's frame\n    this.ballNo = 0;                    // balls bowled in this match\n    this.aiBowlSide = null;             // which side's bowling is the CPU's (set by the scene)\n    this.bowlerKit = null;\n    this.stats = { fours: 0, sixes: 0, wickets: 0, specials: 0, catches: 0, runouts: 0, items: 0, targets: 0 };\n    this.coverage = {};                 // which features happened, for the tests and the attract coverage\n    this.nextInnings(0);\n  }\n  emit(type, data) { this.events.push({ type, data: data || {}, t: this.t }); if (this.events.length > 400) this.events.shift(); this.cover(type, data); }\n  cover(type, data) { this.coverage[type] = (this.coverage[type] || 0) + 1; if (type === 'delivery' && data && data.fam) this.coverage['fam:' + data.fam] = 1; }\n  drain() { const e = this.events; this.events = []; return e; }\n  get inningsNow() { return this.innings[this.inn]; }\n  get batSide() { return this.battingSide; }\n  get bowlSide() { return 1 - this.battingSide; }\n  team(side) { return G.TEAMS[this.teams[side]]; }\n  rnd() { return this.rng(); }\n\n  /* ---- innings ---- */\n  nextInnings(k) {\n    this.inn = k;\n    const superOver = k >= 2;\n    const batFirst = superOver ? this.cfg.superBatFirst : (this.cfg.batFirst || 0);\n    this.battingSide = k === 0 ? batFirst : (k === 1 ? 1 - batFirst : (this.cfg.superBatFirst || 0));\n    if (superOver) this.battingSide = k === 2 ? batFirst : 1 - batFirst;\n    const side = this.battingSide;\n    const overs = superOver ? 1 : this.overs;\n    const wk = superOver ? 2 : this.wkts;\n    const squad = this.team(side).squad.length;\n    const inn = {\n      k, side, runs: 0, wkts: 0, legal: 0, extras: { w: 0, nb: 0, b: 0, lb: 0 }, overs, wk, target: null, over: 0, ballInOver: 0,\n      bat: [{ p: 0, end: 'A', runs: 0, balls: 0, fours: 0, sixes: 0, out: false, how: '' }, { p: 1, end: 'B', runs: 0, balls: 0, fours: 0, sixes: 0, out: false, how: '' }],\n      nextP: 2, squad, bowler: this.pickOpener(1 - side), bowlerLast: -1, bowlerOvers: {}, maiden: true, over_runs: 0,\n      overRecs: [], fow: [], runsRate: 0, superOver\n    };\n    if (k === 1) inn.target = this.innings[0].runs + 1;\n    if (k === 1 && this.rainRevised) inn.target = this.rainRevised;\n    if (k === 2) inn.target = this.innings[0].runs + 1;   // (the super over's target is the first super over score)\n    this.innings.push(inn);\n    this.phase = 'innings'; this.timer = 0;\n    this.emit('innings', { k, side, superOver, target: inn.target });\n    this.beginOver();\n  }\n  pickOpener(side) {\n    const team = this.team(side);\n    return team.bowlers[0];\n  }\n  get I() { return this.innings[this.inn]; }\n  get striker() { const I = this.I; return I.bat.find(b => b.end === 'A' && !b.out) || I.bat[0]; }\n  get nonStriker() { const I = this.I; return I.bat.find(b => b !== this.striker && !b.out) || I.bat[1]; }\n  batterName(b) { return this.team(this.battingSide).squad[b.p]; }\n  bowlerName() { return this.team(this.bowlSide).squad[this.I.bowler]; }\n  batterOf(b) { return this.team(this.battingSide).squad[b.p]; }\n  // the innings' last over was bowled: the bowling side chooses, and each new over starts with the striker on strike\n  beginOver() {\n    const I = this.I;\n    I.ballInOver = 0; I.over_runs = 0;\n    this.fieldPreset = this.fieldPreset || 'balanced';\n    this.placeFielders();\n    this.setTimer('setup', 0.6);\n    this.phase = 'setup';\n    // the Kerfuffle chaos roll happens once per over, between overs\n    if (this.kerf && I.over > 0 && this.rnd() < 0.3 * G.T('chaosRate') && this.ground.chaos.length) {\n      const pool = this.ground.chaos.filter(c => c !== 'rain' || (I.k === 1 && !this.rainUsed));\n      if (pool.length) {\n        const id = pool[Math.floor(this.rnd() * pool.length)];\n        if (id === 'rain') { this.rainUsed = true; this.startRain(); }\n        else this.startChaos(id);\n      }\n    }\n    if (this.kerf && I.ballInOver === 0 && this.rnd() < 0.35 * G.T('chaosRate') && !this.items[this.battingSide].length) this.spawnItem();\n  }\n  setTimer(phase, t) { this.phase = phase; this.timer = t; }\n\n  /* ---- fielders: the bowling side's eleven, placed by the preset in the batter's frame ---- */\n  placeFielders() {\n    const side = this.bowlSide, team = this.team(side), spots = G.PRESETS[this.fieldPreset];\n    this.fielders = [];\n    const n = spots.length;\n    for (let i = 0; i < n; i++) {\n      const [th, d, role] = spots[i];\n      const sp = G.presetSpot(th, d, 1);\n      this.fielders.push({ id: i, side, role, x: sp.x, y: sp.y, hx: sp.x, hy: sp.y, hold: false, speed: G.T('fieldSpeed') * (0.9 + 0.2 * (i % 3) / 2), pick: 0, human: false, ready: 0, slowT: 0, state: 'spot' });\n    }\n    // the keeper, who stands up to spin, and the bowler's own position is kept apart\n    const keeperY = this.fieldPreset === 'spin' ? G.W.SY - 24 : G.W.SY - 12;\n    this.fielders.push({ id: n, side, role: 'keeper', x: G.W.PX, y: keeperY, hx: G.W.PX, hy: keeperY, hold: false, speed: G.T('fieldSpeed'), pick: 0, human: false, ready: 0, slowT: 0, state: 'spot', keeper: true });\n    // bowler (for the throw-to-bowler rule: he stands at his crease)\n    this.bowlerPos = { x: G.W.PX - 4, y: G.W.RELEASE_Y };\n  }\n  stepFielders(dt) {\n    for (const f of this.fielders) {\n      if (f.hold) continue;\n      if (f.role === 'keeper') { f.hx = G.W.PX; continue; }\n      if (this.ballChase && this.ballChase.id === f.id) continue;\n      const dx = f.hx - f.x, dy = f.hy - f.y, d = Math.hypot(dx, dy);\n      if (d > 1) { const s = Math.min(d, f.speed * 0.7 * dt); f.x += dx / d * s; f.y += dy / d * s; }\n    }\n  }\n  /* ---- the delivery director: setup, runup, the bowl and flight, contact, play, dead, between, rain, and innings\n   * breaks. update(dt) is called each step by the scene; the human and AI inputs reach it through the methods below. ---- */\n  update(dt) {\n    this.t += dt;\n    if (this.phase === 'end' || this.phase === 'idle') return;\n    this.timer -= dt;\n    this.stepFielders(dt);\n    if (this.catchRing) this.catchRing.t -= dt;\n    if (this.reviewWindow > 0) this.reviewWindow -= dt;\n    if (this.phase === 'innings') { if (this.timer <= 0) this.beginSetup(); return; }\n    if (this.phase === 'rain') { if (this.timer <= 0) this.endRain(); return; }\n    if (this.phase === 'chaos') { this.stepChaos(dt); if (this.timer <= 0) this.endChaos(); return; }\n    if (this.phase === 'setup') { this.stepSetup(dt); return; }\n    if (this.phase === 'runup') { this.stepRunup(dt); return; }\n    if (this.phase === 'flight') { this.stepFlight(dt); return; }\n    if (this.phase === 'play') { this.stepPlay(dt); return; }\n    if (this.phase === 'dead') { if (this.timer <= 0) this.endDead(); return; }\n    if (this.phase === 'between') { if (this.timer <= 0) this.endBetween(); return; }\n    if (this.phase === 'break') { if (this.timer <= 0) this.endBreak(); return; }\n  }\n  beginSetup() { this.setTimer('setup', 0.1); this.phase = 'setup'; this.placeFielders(); }\n  stepSetup(dt) {\n    if (this.bowlHuman()) return this.humanWaitingBowl = true;\n    if (this.timer <= 0) this.bowlCpu();\n  }\n  // the bowler who bowls the next ball is human (the scene sets aiBowlSide and the humans)\n  bowlHuman() { return !!(this.humans && this.humans.bowl && this.humans.bowl.length && this.isHumanBowling()); }\n  isHumanBowling() { return this.cfg.humans && this.cfg.humans.bowlSide === this.bowlSide && !this.cfg.autoBowl; }\n  // a machine or a CPU bowler picks a delivery from the bowler's family, and a target\n  bowlCpu() {\n    const I = this.I, team = this.team(this.bowlSide);\n    const fam = this.bowlerFamily(I.bowler);\n    const kit = G.BOWL_KIT[fam];\n    const del = this.cfg.machine ? this.cfg.machine[this.ballNo % this.cfg.machine.length] : kit[Math.floor(this.rnd() * kit.length)];\n    const len = this.rnd() < 0.2 ? 'yorker' : this.rnd() < 0.5 ? 'full' : this.rnd() < 0.8 ? 'good' : 'short';\n    const ty = len === 'yorker' ? G.W.BAT_CREASE + 12 : len === 'full' ? G.W.BAT_CREASE + 40 : len === 'good' ? G.W.BAT_CREASE + 90 : G.W.BAT_CREASE + 150;\n    const scatter = G.T('aiBowlAccuracy');\n    const target = { x: G.W.PX + (this.rnd() - .5) * 2 * scatter * 0.5, y: ty + (this.rnd() - .5) * scatter };\n    this.startRunup({ key: del, kind: 'delivery', target, quality: 'cpu', cpu: true });\n  }\n  bowlerFamily(idx) { const team = this.team(this.bowlSide); const fams = ['pace', 'swing', 'medium', 'spin']; return fams[(team.bowlers.indexOf(idx) + team.squad.length) % fams.length] || 'pace'; }\n  startRunup(bowl) {\n    const I = this.I;\n    const dur = { pace: 2.0, swing: 1.8, medium: 1.5, spin: 0.9 }[bowl.fam || this.famOfKey(bowl.key)] || 1.6;\n    this.delivery = Object.assign({ dur, t: 0, quality: null, u: 0 }, bowl);\n    this.delivery.dur = dur;\n    this.phase = 'runup'; this.timer = dur;\n    this.delivery.start = this.t;\n    this.humanWaitingBowl = false;\n    this.emit('runup', { key: bowl.key });\n  }\n  famOfKey(key) { if (key === 'special') return 'pace'; const d = G.DELIVERIES[key]; return d ? (d.fam === 'pace' ? 'pace' : d.fam === 'swing' ? 'swing' : d.fam === 'spin' ? 'spin' : 'medium') : 'pace'; }\n  stepRunup(dt) {\n    const D = this.delivery;\n    D.t += dt;\n    // the meter sweeps in the last 0.7 s; a CPU bowler releases near its set point\n    if (D.cpu && D.t >= D.dur - 0.25 && !D.released) { this.release('green', true); return; }\n    if (!D.cpu && D.t >= D.dur && !D.released) { this.release(D.quality || 'amber'); return; }\n    if (D.cpu && D.released) return;\n    if (!D.cpu && D.t > D.dur - 0.7 && !D.released) D.u = 0.5 + 0.5 * Math.sin(D.t * TAU * G.T('meterSpeed'));\n  }\n  // the human bowler's meter release (the scene calls this from a press during the sweep)\n  bowlRelease() {\n    const D = this.delivery;\n    if (!D || this.phase !== 'runup' || D.released || D.t < D.dur - 0.7) return false;\n    const u = 0.5 + 0.5 * Math.sin(D.t * TAU * G.T('meterSpeed'));\n    const d = Math.abs(u - 0.5) * 2;   // 0 at the middle\n    const sweet = G.T('meterSweet');\n    const q = u > 0.94 ? 'noball' : d <= sweet ? 'green' : d <= sweet * 2.2 ? 'amber' : 'red';\n    this.release(q === 'noball' ? 'noball' : q);\n    return true;\n  }\n  release(quality, cpuGreen) {\n    const D = this.delivery; if (!D || D.released) return;\n    D.released = true;\n    const del = G.DELIVERIES[D.key] || this.specialDelivery(D.key);\n    const scat = { green: 2, amber: 10, red: 18, noball: 18, cpu: 1 }[quality] || 4;\n    const fac = { green: 1, amber: 0.9, red: 0.8, noball: 0.8, cpu: 1 }[quality] || 1;\n    const tgt = D.target || { x: this.delivery.target ? this.delivery.target.x : G.W.PX, y: G.W.BAT_CREASE + 60 };\n    const target = { x: clamp(tgt.x + (this.rnd() - .5) * 2 * scat * 0.7, G.W.PX - 34, G.W.PX + 34), y: clamp(tgt.y + (this.rnd() - .5) * 2 * scat * 0.4, G.W.BAT_CREASE + 10, G.W.BOWL_CREASE - 12) };\n    const kmh = (del.kmh[0] + this.rnd() * (del.kmh[1] - del.kmh[0])) * fac * (D.fire ? 1.1 : 1) * (D.pace || 1);\n    const ball = G.newBall(0, 0, 0);\n    const rel = { x: G.W.PX - 4 + (D.round ? 14 : 0), y: G.W.RELEASE_Y, z: G.W.RELEASE_Z };\n    const v = G.solveDelivery(rel, target, kmh);\n    Object.assign(ball, rel, v);\n    ball.phase = 'delivery';\n    ball.swingA = del.swing * (D.doubleSwing ? 2 : 1);\n    ball.turn = del.turn;\n    ball.spinGrip = del.fam === 'spin' ? 0.05 : 0;\n    ball.bounceMul = del.bounce * (del.bounceBoost || 1);\n    ball.seamDev = (this.rnd() + this.rnd() + this.rnd() - 1.5) * 2 * G.T('seam') * (del.seam || 1);\n    if (del.fam === 'spin') ball.spinDrift = 0;\n    ball.delivery = D.key; ball.kmh = Math.round(kmh);\n    this.ball = ball; this.ballNo++;\n    this.lastDel = { key: D.key, label: del.label || D.key, fam: del.fam || this.famOfKey(D.key), kmh: Math.round(kmh), target, quality };\n    this.noBallRisk = quality === 'noball';\n    this.pressed = null;\n    this.setTimer('flight', 6);\n    this.phase = 'flight';\n    // the batter's timing: when the ball reaches the contact plane, from now\n    this.predArrive = G.timeToPlane(ball, this.env, CONTACT_Y + this.chargeOffset(), 3);\n    this.emit('release', { key: D.key, quality, kmh: Math.round(kmh), fam: this.lastDel.fam, label: this.lastDel.label, cpu: !!D.cpu });\n    this.emit('delivery', { key: D.key, fam: this.lastDel.fam, kmh: Math.round(kmh), label: this.lastDel.label });\n    if (quality === 'noball') { this.noBall = true; this.emit('noball', {}); }\n    if (this.cpuBatting()) this.cpuPlanBat();\n    this.cpuPressAt = null;\n  }\n  specialDelivery(key) {\n    if (key === 'vicar') return { label: \"VICAR'S REVENGE\", kmh: [150, 158], swing: -1.2, turn: 0, bounce: 0.9, fam: 'pace', seam: 0.5 };\n    if (key === 'sunburn') return { label: 'SUNBURN BOUNCER', kmh: [150, 156], swing: 0, turn: 0, bounce: 1.3, fam: 'pace', seam: 1 };\n    return G.DELIVERIES.express;\n  }\n  chargeOffset() { return this.striker && this.striker.charging ? 24 : 0; }\n  // the batter's press: a shot (button), the aim as a batter-frame angle (or null for neutral), at the time now\n  batPress(button, aim) {\n    if (this.phase !== 'flight' || this.pressed || !this.ball) return false;\n    const b = this.ball;\n    if (b.phase !== 'delivery') return false;\n    const tA = this.predArrive;\n    if (tA === null) return false;\n    const contactAt = button === 'block' ? G.SHOTS.defFwd.contactAt : 0;\n    this.pressed = { button, aim, t: this.t, tArrive: tA, lateBy: 0, shot: null, special: false };\n    this.pressed.shot = null;\n    return true;\n  }\n  // the timing grade for this press: the signed error between the press + contact time and the ball's arrival\n  gradeOf(pr, contactAt) {\n    const err = (pr.t + contactAt) - (this.t + pr.tArrive);   // (both from the press moment)\n    const ms = err * 1000;\n    const K = G.T('perfectMs') * (this.fireBat() ? 1.5 : 1), Gd = G.T('goodMs') * (this.fireBat() ? 1.5 : 1), Ok = G.T('okMs');\n    const a = Math.abs(ms);\n    const grade = a <= K ? 'PERFECT' : a <= Gd ? 'GOOD' : a <= Ok ? (ms < 0 ? 'EARLY' : 'LATE') : 'MISS';\n    return { ms, grade };\n  }\n  fireBat() { return this.fire[this.battingSide]; }\n  stepFlight(dt) {\n    const b = this.ball;\n    this.stepBallAndFlag(dt);\n    // a CPU's press at its planned time\n    if (this.cpuBatting() && !this.pressed && this.cpuPressAt !== null && this.t >= this.cpuPressAt) this.cpuPress();\n    if (this.pressed && this.pressed.contactDue === undefined) {\n      const sh = this.shotFor(this.pressed);\n      const pr = this.pressed;\n      pr.shot = sh.key; pr.contactDue = pr.t + sh.contactAt;\n      pr.grade = this.gradeOf(pr, sh.contactAt).grade;\n      pr.ms = this.gradeOf(pr, sh.contactAt).ms;\n      if (pr.grade === 'MISS' && !sh.defend) pr.noContact = true;\n      if (sh.defend) pr.grade = pr.grade === 'MISS' ? 'MISS' : pr.grade;\n      pr.dueAt = pr.contactDue;\n      this.emit('press', { button: pr.button, grade: pr.grade, shot: sh.key, ms: pr.ms });\n    }\n    if (this.pressed && this.pressed.dueAt !== undefined && this.t >= this.pressed.dueAt && !this.pressed.done) {\n      this.pressed.done = true;\n      this.contact(this.pressed);\n      return;\n    }\n    // the ball passes the batter: a miss, a bowled, an LBW, or a wide\n    if (b.phase === 'delivery' && !this.pressed?.done && b.y <= CONTACT_Y + 4 && this.crossCrease === undefined) { this.crossCrease = true; }\n    this.checkDeliveryPass();\n  }\n  stepBallAndFlag(dt) {\n    const b = this.ball;\n    G.stepBall(b, this.env, (type, d) => { if (type === 'pitch') this.emit('pitch', d); });\n    if (b.phase === 'delivery' && b.pitched && !this.pitchedFlag) { this.pitchedFlag = true; this.emit('pitched', { x: b.x, y: b.y, bounce: b.bounces }); }\n    if (b.trail) { b.trail.push({ x: b.x, y: b.y, z: b.z }); if (b.trail.length > 12) b.trail.shift(); }\n  }\n  shotFor(pr) {\n    const len = G.lengthOf(this.ball.pitchY || (this.ball.pitchY = this.predictPitchY()));\n    const sector = pr.aim !== null && pr.aim !== undefined ? pr.aim : this.sectorOfBall();\n    let key = G.resolveShot(pr.button === 'shot' ? 'shot' : pr.button === 'loft' ? 'loft' : 'block', len, sector);\n    if (pr.special) key = pr.special;\n    return Object.assign({ key }, G.SHOTS[key]);\n  }\n  predictPitchY() {\n    const r = G.predictUntil(this.ball, this.env, c => c.pitched, 2);\n    return r ? r.b.y : G.W.BAT_CREASE + 80;\n  }\n  sectorOfBall() {\n    // with a neutral stick the shot follows the line the ball is on, read from the predicted contact plane\n    const b = this.ball, r = G.predictUntil(b, this.env, c => c.y <= CONTACT_Y, 2);\n    const x = r ? r.b.x : b.x;\n    return clamp(-(x - G.W.PX) * 3, -120, 120);\n  }\n  // the bat's contact: the outgoing ball, or an edge, or a miss (the ball goes on)\n  contact(pr) {\n    const b = this.ball, sh = G.SHOTS[pr.shot];\n    if (!sh || !sh.speed && !sh.defend) return;\n    const batter = this.striker;\n    if (pr.grade === 'MISS' || pr.noContact) { this.emit('beaten', { shot: pr.shot }); this.pressed = null; return; }\n    if (sh.defend) { b.vy = -Math.abs(b.vy) * 0.2; b.vx *= 0.2; b.vz = 6; b.phase = 'hit'; b.carried = false; this.emit('defend', { grade: pr.grade }); this.afterContact(pr, sh, true); return; }\n    // an edge: the outside edge of an early or late ground shot (a fine chance for the keeper)\n    const edgeChance = (pr.grade === 'EARLY' || pr.grade === 'LATE') ? 0.22 * G.T('edge') : 0;\n    if (edgeChance > 0 && this.rnd() < edgeChance) {\n      const ang = (this.rnd() < 0.5 ? -1 : 1) * (150 + this.rnd() * 25) * PI / 180;\n      b.vx = Math.sin(ang) * 120; b.vy = -Math.cos(ang) * 120; b.vz = 40; b.phase = 'hit'; b.carried = true;\n      this.emit('edge', {}); this.afterContact(pr, sh, false, 'edge'); return;\n    }\n    const grade = pr.grade;\n    const power = { PERFECT: 1.0, GOOD: 0.85, EARLY: 0.6, LATE: 0.6 }[grade] || 0.6;\n    const fire = this.fireBat() ? 1.2 : 1;\n    const special = pr.special === 'teakettle' || pr.special === 'kfShot';\n    const perf = special ? 'PERFECT' : grade;\n    const powerU = special ? 1.25 : power;\n    const sectorAim = pr.aim !== null && pr.aim !== undefined ? pr.aim : sh.nat;\n    const errDeg = { PERFECT: 2, GOOD: 6, EARLY: 15, LATE: 15 }[perf] || 15;\n    let theta = sectorAim + (this.rnd() - .5) * 2 * errDeg + (grade === 'EARLY' ? -20 : grade === 'LATE' ? 20 : 0) * (pr.aim !== null ? 0 : 1);\n    if (grade === 'EARLY' || grade === 'LATE') theta = theta + (grade === 'LATE' ? 10 : -10);\n    const r = theta * PI / 180;\n    const speed = sh.speed * (sh.lofted ? G.T('loftPower') : G.T('batPower')) * powerU * fire * (1 + 0.25 * (b.speed || 300) / 386) * (this.striker && this.striker.tailor ? 1 : 1);\n    const launch = (sh.launch + (grade === 'EARLY' && sh.lofted ? 8 : 0)) * PI / 180;\n    const dirx = -Math.sin(r), diry = Math.cos(r);\n    b.vx = dirx * speed * Math.cos(launch); b.vy = diry * speed * Math.cos(launch); b.vz = speed * Math.sin(launch);\n    b.phase = 'hit'; b.carried = true; b.hitBy = this.battingSide; b.touchedGround = false; b.bounces = 0;\n    b.x = b.x; b.z = Math.max(b.z, sh.lofted ? 12 : 2);\n    b.trail = [];\n    this.emit('contact', { grade, shot: pr.shot, lofted: !!sh.lofted, theta: Math.round(theta), speed: Math.round(speed), ms: Math.round(pr.ms || 0), special: special });\n    this.afterContact(pr, sh, false);\n  }\n  afterContact(pr, sh, defended, how) {\n    this.setTimer('play', 15);\n    this.phase = 'play';\n    this.bat = { shot: sh.key || pr.shot, grade: pr.grade, lofted: !!sh.lofted, defended: !!defended, how: how || '' };\n    this.pressed = null;\n    this.runs = { calls: 0, active: false, run: 0, end: null, t: 0 };\n    this.runCallTimer = 2.6;\n    this.runDone = false;\n    this.ballHitGround = false;\n    this.cpuDecideRun();\n    this.catchPlan = this.planCatch();\n    this.boundaryState = { crossed: false };\n    this.stampContact = this.t;\n    if (this.cfg.onContact) this.cfg.onContact(this);\n  }\n  planCatch() {\n    const b = this.ball;\n    if (!b.carried && b.z <= 0.01) return null;\n    const L = G.landingOf(Object.assign({}, b, { phase: 'hit' }), this.env, 4);\n    return L ? { x: L.x, y: L.y, t: L.t } : null;\n  }\n  // a delivery passes the batter without contact: the umpire looks at the line and the stumps\n  checkDeliveryPass() {\n    const b = this.ball;\n    if (this.phase !== 'flight') return;\n    if (this.crossed !== true && b.y <= G.W.BAT_CREASE + 10) {\n      this.crossed = true;\n      const off = b.x - G.W.PX;\n      // a wide: outside the line, not played at, never the bat's\n      if (!this.pressed && (off < -26 || off > 18)) return this.dead('wide', { wide: true });\n      if (!this.pressed && b.z > 40) return this.dead('wide', { wide: true });\n      if (!this.pressed && this.noBall) return this.dead('noball', { noball: true });\n      // the batter's pad, the stumps: bowled if it goes straight through, LBW if it would have hit the stumps off the pad\n      const r = G.predictUntil(b, this.env, c => c.y <= G.W.SY, 2);\n      const hits = r && Math.abs(r.b.x - G.W.PX) <= 3.5 && r.b.z <= 12;\n      if (!this.pressed && !this.striker.charging && hits) {\n        const pitchX = this.ball.pitchX !== undefined ? this.ball.pitchX : (this.ball.pitchX = this.predictPitchX());\n        if (Math.abs(pitchX - G.W.PX) <= 7) return this.dismiss('bowled', { cause: 'stumps' });\n        // the umpire's view: pitched in line, hitting the stumps: LBW\n        const inLine = Math.abs(pitchX - G.W.PX) <= 14;\n        const truth = inLine;\n        const acc = this.umpireAccuracy();\n        const decideOut = this.rnd() < acc ? truth : !truth;\n        this.lbwPending = { truth, decideOut };\n        this.emit('appeal', { how: 'lbw' });\n        if (decideOut) return this.dismiss('lbw', { review: truth !== decideOut });\n        return this.dead('notout', { appeal: true, notOut: true, how: 'lbw' });\n      }\n      if (!this.pressed && !hits && b.y <= G.W.BAT_CREASE + 10) return this.dead('beaten', { beaten: true });\n    }\n    if (this.phase === 'flight' && b.y < G.W.SY - 26) {\n      if (!this.pressed) return this.dead('beaten', { beaten: true });\n      return this.dead('beaten', { beaten: true });\n    }\n  }\n  predictPitchX() { const r = G.predictUntil(this.ball, this.env, c => c.pitched, 2); return r ? r.b.x : this.ball.x; }\n  umpireAccuracy() { return this.cfg.umpireAccuracy || 0.9; }\n  // (the play phase) the ball after a contact: boundary, catch, the fielders, the throw, the runs, the settle\n  stepPlay(dt) {\n    const b = this.ball;\n    if (this.throwing) { this.stepThrow(dt); return; }\n    G.stepBall(b, this.env, (type, d) => { if (type === 'bounce') { this.emit('bounce', d); } if (type === 'roll') this.emit('roll', {}); });\n    if (b.trail) { b.trail.push({ x: b.x, y: b.y, z: b.z }); if (b.trail.length > 12) b.trail.shift(); }\n    if (b.z <= 0.01 && b.touchedGround === false) {}\n    if (b.touchedGround) this.ballHitGround = true;\n    // the boundary\n    const bs = this.ground.boundary * G.T('boundaryScale');\n    const ex = (b.x - G.W.PX) / (G.W.RX * bs), ey = (b.y - G.W.CY) / (G.W.RY * bs);\n    if (!this.boundaryState.crossed && ex * ex + ey * ey > 1) {\n      this.boundaryState.crossed = true;\n      if (this.ballHitGround && !b.carriedOver) return this.boundary(4);\n      return this.boundary(6);\n    }\n    // a stadium target: the ball passes through its sphere\n    this.checkTargets();\n    // the catch: airborne, low, and a fielder within reach of the ball\n    if (b.z < 12 && b.carried && !this.catchResolved) {\n      const f = this.nearestFielder(b.x, b.y);\n      if (f && Math.hypot(f.x - b.x, f.y - b.y) <= 10) return this.catchAttempt(f);\n    }\n    // a fielder gathers the ball on the ground\n    if (!b.carried || b.z <= 0.01) {\n      if (b.speed < 260 && (b.phase === 'rolling' || Math.abs(b.vz) < 1)) {\n        const f = this.nearestFielder(b.x, b.y);\n        if (f && Math.hypot(f.x - b.x, f.y - b.y) <= 7 && !f.hold) return this.gather(f);\n      }\n    }\n    if (this.runs && this.runs.active) this.stepRuns(dt);\n    if (this.runCallTimer > 0 && !this.runs.active) { this.runCallTimer -= dt; if (this.runCallTimer <= 0 && this.runs.calls === 0) {} }\n    if (this.humanRunCall) { this.humanRunCall = false; this.startRun(); }\n    // the ball has come to rest: the batters are not running, so the over moves on\n    if (b.speed < 2 && b.z <= 0.01 && !this.anyRunning() && this.phase === 'play') return this.dead('settled', {});\n    if (this.phase === 'play' && this.t - this.stampContact > 15) return this.dead('settled', {});\n  }\n  anyRunning() { return !!(this.runs && this.runs.active); }\n  nearestFielder(x, y, exclude) {\n    let best = null, bd = 1e9;\n    for (const f of this.fielders) { if (f.hold || f === exclude) continue; const d = Math.hypot(f.x - x, f.y - y); if (d < bd) { bd = d; best = f; } }\n    return best;\n  }\n  catchAttempt(f) {\n    this.catchResolved = true;\n    const b = this.ball;\n    const lofted = this.bat && this.bat.lofted;\n    const speed = Math.hypot(b.vx, b.vy, b.vz);\n    const catchCap = f.keeper ? 0.9 : 0.8;\n    const base = f.keeper ? 0.85 : (f.role.indexOf('slip') >= 0 ? 0.85 : 0.82);\n    const p = clamp(base - 0.25 * (speed / 400) - (f.dive ? 0.3 : 0), 0.05, catchCap);\n    this.emit('caught-chance', { x: b.x, y: b.y, p, role: f.role });\n    const human = this.humanFielder(f);\n    if (human && game.settings.fielding !== 'Auto' && !(game.settings.fielding === 'Assisted' && p > 0.85)) {\n      // the human's catch ring: the ring is set, the press decides; no press drops it\n      this.catchRing = { t: G.T('catchRing'), total: G.T('catchRing'), f, p, pressAt: null };\n      this.catchPending = { f, p, b };\n      this.setTimer('play', 6);\n      this.catchRingWait = true;\n      return;\n    }\n    const caught = this.rnd() < p || (game.settings.fielding !== 'Manual' && p > 0.85);\n    this.resolveCatch(f, caught);\n  }\n  humanFielder(f) { return !!(f && f.human); }\n  resolveCatch(f, caught) {\n    const b = this.ball;\n    if (caught) {\n      f.hold = true; f.pick = this.t; this.ball.x = f.x; this.ball.y = f.y; this.ball.z = 2; this.ball.vx = this.ball.vy = this.ball.vz = 0; this.ball.phase = 'held';\n      this.catchRing = null; this.catchRingWait = false;\n      this.stats.catches++;\n      const screamer = this.catchRing && this.catchRing.screamer;\n      this.emit('catch', { role: f.role, screamer: !!screamer });\n      return this.dismiss('caught', { catcher: f.role });\n    }\n    this.catchRing = null; this.catchRingWait = false;\n    this.emit('catch:dropped', { role: f.role });\n    this.ball.carried = false; this.catchResolved = true;\n    // the dropped ball: it carries on, slowed, the batters may run\n    this.ball.vx *= 0.3; this.ball.vy *= 0.3; this.ball.vz = Math.abs(this.ball.vz) * 0.3;\n    this.afterDrop = true;\n  }\n  // (the scene calls this for a human's catch press during the ring)\n  catchPress() {\n    if (!this.catchPending) return false;\n    const { f, p } = this.catchPending;\n    const r = this.catchRing;\n    if (!r) return false;\n    const offset = Math.abs(r.t) * 1000;\n    const ok = offset <= G.T('catchWindow');\n    const caught = ok && this.rnd() < 0.5 + 0.5 * p;\n    this.catchPending = null;\n    this.resolveCatch(f, caught);\n    return true;\n  }\n  gather(f) {\n    const b = this.ball;\n    f.hold = true; f.pick = this.t;\n    this.ball.vx = this.ball.vy = this.ball.vz = 0; this.ball.phase = 'held'; this.ball.z = 1;\n    this.emit('gather', { role: f.role });\n    // a human fielder is asked what to do; the CPU throws to the end where a run is the closest to going wrong\n    if (this.humanFielder(f)) { this.humanFieldHold = f; return; }\n    this.cpuThrow(f);\n  }\n  // the throw: an end and a time; the runner at that end may be run out\n  cpuThrow(f) {\n    if (!this.runs || !this.runs.active) { this.settleGather(f); return; }\n    const run = this.runs;\n    const end = this.fielderEndChoice(f);\n    this.throwTo(f, end);\n  }\n  fielderEndChoice(f) {\n    const I = this.I; const strikerNearEnd = this.striker;\n    if (this.runs && this.runs.active) return this.runs.end || 'A';\n    return 'A';\n  }\n  throwTo(f, end) {\n    const stumps = end === 'A' ? { x: G.W.PX, y: G.W.SY } : { x: G.W.PX, y: G.W.BY };\n    const d = Math.hypot(f.x - stumps.x, f.y - stumps.y);\n    const err = (this.rnd() - .5) * 2 * G.T('throwError') * d / 480;\n    const tt = d / G.T('throwSpeed') + Math.abs(err) * 0.02;\n    this.throwing = { f, end, t: tt, total: tt, stumpsX: stumps.x + err, err, from: { x: f.x, y: f.y }, to: stumps };\n    this.emit('throw', { end, t: tt });\n    this.ball.phase = 'thrown';\n  }\n  stepThrow(dt) {\n    const th = this.throwing;\n    th.t -= dt;\n    const k = 1 - Math.max(0, th.t) / th.total;\n    this.ball.x = lerp(th.from.x, th.to.x, k); this.ball.y = lerp(th.from.y, th.to.y, k); this.ball.z = 6;\n    if (th.t > 0) return;\n    this.throwing = null;\n    const hit = Math.abs(th.stumpsX - G.W.PX) <= 6 && (Math.abs(th.err) < 12);\n    // is a runner at this end still out of his ground?\n    const r = this.runs;\n    if (r && r.active) {\n      const runner = this.runnerAt(th.end);\n      if (runner && hit && runner.t > this.t) {\n        return this.runOut(runner, th.end);\n      }\n      if (runner && !hit) { this.emit('miss-throw', {}); }\n    }\n    this.settleGather(th.f);\n  }\n  runnerAt(end) { const I = this.I; return I.bat.find(b => !b.out && b.end === end) || null; }\n  settleGather(f) {\n    const b = this.ball;\n    b.x = f.x; b.y = f.y; b.z = 0;\n    this.ball.phase = 'held';\n    this.setTimer('play', 6);\n    this.emit('settled', {});\n    this.ballSettled = true;\n    if (!this.anyRunning()) this.dead('settled', {});\n  }\n  // a run: each batter walks to the far crease; both must make it for one run\n  stepRuns(dt) {\n    const I = this.I, R = this.runs;\n    const sp = G.T('runSpeed') * (this.ground.outfieldK > 0.8 ? 0.85 : 1);\n    let done = true;\n    for (const bt of I.bat) {\n      if (bt.out) continue;\n      const goal = bt.end === 'A' ? G.W.BOWL_CREASE : G.W.BAT_CREASE;\n      const d = Math.abs(goal - bt.y);\n      if (d > 0.5) { bt.y += Math.sign(goal - bt.y) * Math.min(d, sp * dt); done = false; }\n    }\n    if (done) {\n      // the run is made: both batters have grounded their bats at the other end\n      R.run++;\n      I.bat.forEach(bt => { if (!bt.out) bt.end = bt.end === 'A' ? 'B' : 'A'; });\n      R.active = false;\n      this.addRuns(1, 'run');\n      this.emit('run', { n: R.run });\n      if (this.humanWantsRun) { this.humanWantsRun = false; this.startRun(); }\n      else if (this.cpuWantsMore()) this.startRun();\n    }\n  }\n  startRun() {\n    const R = this.runs; if (!R || R.active) return;\n    R.active = true; R.end = 'A';\n    const I = this.I;\n    for (const bt of I.bat) if (!bt.out) bt.runStart = bt.y;\n  }\n  cpuWantsMore() { return false; }\n  // the run calls: human R1 starts a run; the CPU decides from its own margin\n  callRun() {\n    if (this.phase !== 'play' || !this.runs || this.runDone) return false;\n    if (this.runs.active) { this.humanWantsRun = true; return true; }\n    this.startRun();\n    return true;\n  }\n  cpuDecideRun() {\n    if (!this.cpuBatting() || this.runs.active) return;\n    if (this.bat.lofted && !this.ballHitGround) return;\n    const margin = 0.2 + this.rnd() * 0.6;\n    if (this.rnd() < 0.5 + 0.2 * G.T('aiAggression') && margin > 0.35) this.startRun();\n  }\n  addRuns(n, how) {\n    const I = this.I; if (!I) return;\n    if (this.fire[this.battingSide] && this.bat && (how === 'boundary')) { }\n    I.runs += n;\n    I.over_runs += n;\n    this.lastRunGain = n;\n    if (this.teapot && n > 0 && how !== 'bonus') { I.runs += n; this.teapot = false; this.emit('item-used', { id: 'teapot', n }); }\n  }\n  // a boundary: four (the ball touched the ground) or six\n  boundary(n) {\n    if (this.bat) this.bat.boundary = n;\n    this.emit('boundary', { n, x: this.ball.x, y: this.ball.y });\n    if (n === 4) this.stats.fours++; else this.stats.sixes++;\n    this.addRuns(n, 'boundary');\n    this.hypeGain(this.battingSide, n === 6 ? 25 : 15, n === 6 ? 'six' : 'four');\n    this.streakBoundary(this.battingSide);\n    this.ball.phase = 'dead';\n    this.dead('boundary', { n });\n  }\n  streakBoundary(side) {\n    this.streak[side]++;\n    if (this.streak[side] >= G.T('fireStreak') && !this.fire[side]) { this.fire[side] = true; this.emit('fire:on', { side }); }\n  }\n  dead(reason, d) {\n    if (this.phase === 'dead' || this.phase === 'between' || this.phase === 'break') return;\n    this.deadReason = reason; this.deadData = d || {};\n    this.setTimer('dead', 1.6);\n    this.phase = 'dead';\n    this.pressed = null; this.catchRing = null; this.throwing = null;\n    this.ball.phase = 'dead';\n    this.humanFieldHold = null;\n    if (this.runs && this.runs.active) {\n      // a run in progress is decided by where the batters stand: unfinished runs don't count\n      this.runs.active = false;\n    }\n    this.emit('dead', { reason, n: d && d.n });\n  }\n  endDead() {\n    // the umpire's decision, a review window for a human side when it is an out or an LBW\n    const r = this.deadReason;\n    const D = this.deadData;\n    this.pending = { reason: r, data: D };\n    if (r === 'wide') this.wideRuns();\n    if (r === 'noball') this.noBallRuns();\n    if (r === 'beaten') this.beatenRuns();\n    if (r === 'settled' || r === 'boundary') { this.overCount(); }\n    this.setTimer('between', 2.0);\n    this.phase = 'between';\n    this.commitBall();\n  }\n  wideRuns() { this.addExtras('w', 1); }\n  noBallRuns() { this.addExtras('nb', 1); this.freeHit = true; }\n  beatenRuns() { }\n  addExtras(k, n) {\n    const I = this.I; I.runs += n; I.extras[k] += n; I.over_runs += n;\n  }\n  overCount() { }\n  // a dismissal: the batter is out, the wicket counts, the next batter comes in\n  dismiss(how, d) {\n    const I = this.I;\n    const bt = this.striker;\n    if (this.freeHit && how !== 'runout') { return this.dead('notout', { freeHit: true }); }\n    if (this.lbwPending && this.lbwPending.decideOut !== undefined) { /* the decision stands on the field */ }\n    if (this.cfg.review && this.review[this.battingSide] > 0 && d && d.review) { /* the review flag: the scene offers it */ }\n    bt.out = true; bt.how = how;\n    I.wkts++;\n    if (this.teapot) { /* the teapot doesn't survive a wicket */ }\n    if (this.horseshoe && how !== 'bowled') { /* overturned by the horseshoe: no dismissal */ }\n    this.stats.wickets += (this.battingSide === this.battingSide) ? 0 : 1;\n    this.hypeGain(this.bowlSide, 30, 'wicket');\n    this.streak[this.battingSide] = 0; this.fire[this.battingSide] = false;\n    this.emit('wicket', { how, name: this.batterOf(bt) });\n    this.pendingWicket = { how };\n    this.dead('wicket', { how });\n    return;\n  }\n  runOut(runner, end) {\n    runner.out = true; runner.how = 'run out';\n    this.I.wkts++;\n    this.stats.runouts++;\n    this.emit('runout', { end });\n    this.runs.active = false;\n    this.dead('runout', { how: 'run out', end });\n  }\n  // a commit: the ball goes into the record (over, runs, the batters, the bowler)\n  commitBall() {\n    const I = this.I, b = this.ball;\n    const isLegal = !(this.pending && (this.pending.reason === 'wide' || this.pending.reason === 'noball'));\n    if (isLegal) { I.legal++; I.ballInOver++; I.bowlerOvers[I.bowler] = (I.bowlerOvers[I.bowler] || 0) + 1; }\n    const rec = { n: this.ballNo, inn: this.inn, over: I.over, ball: I.ballInOver, bowler: this.bowlerName(), batter: this.batterName(this.striker),\n      runs: I.runs, wkts: I.wkts, reason: this.pending ? this.pending.reason : '', shot: this.bat ? this.bat.shot : '', grade: this.bat ? this.bat.grade : '',\n      delivery: this.lastDel ? this.lastDel.key : '', legal: isLegal, kmh: this.lastDel ? this.lastDel.kmh : 0 };\n    this.log.push(rec);\n    this.lastRec = rec;\n    this.emit('ball', rec);\n    // the striker's card\n    const s = this.striker;\n    if (this.bat && this.bat.runsScored !== undefined) { }\n    if (this.pending && this.pending.reason === 'boundary') { s.runs += this.pending.data.n; s.fours += this.pending.data.n === 4 ? 1 : 0; s.sixes += this.pending.data.n === 6 ? 1 : 0; s.balls++; }\n    else if (isLegal) { s.balls++; }\n    if (this.lastRunGain && this.lastRunGain > 0) { s.runs += this.lastRunGain; }\n    this.lastRunGain = 0;\n    if (I.ballInOver === 0 && isLegal) { /* the over is complete */ }\n    if (this.bat && this.bat.grade === 'PERFECT') this.hypeGain(this.battingSide, 8, 'perfect');\n    if (this.pending && this.pending.reason === 'beaten' && isLegal) { this.dotBall(); }\n    if (this.pending && this.pending.reason === 'settled' && this.bat && (this.runsThisBall() === 0)) this.dotBall();\n    // the over is complete: a change of ends, a new bowler (the captain's choice)\n    if (isLegal && I.ballInOver >= 6) return this.endOver();\n    if (this.pending && this.pending.reason === 'wicket') this.nextBatter();\n    if (I.wkts >= I.wk) return this.endInnings('allout');\n    if (this.target() !== null && I.runs >= this.target()) return this.endInnings('target');\n    this.delivery = null;\n    this.bat = null;\n    this.pending = null;\n    this.runDone = false;\n    this.freeHit = false;\n    this.noBall = false;\n    this.crossed = false; this.pitchedFlag = false; this.catchResolved = false; this.catchPending = null;\n    this.humanWaitingBowl = false;\n    this.lbwPending = null;\n    this.ballSettled = false;\n    this.crossCrease = undefined;\n  }\n  runsThisBall() { return this.lastRunGain || 0; }\n  dotBall() { this.hypeGain(this.bowlSide, 6, 'dot'); this.streak[this.battingSide] = 0; this.fire[this.battingSide] = false; this.bowlDots = (this.bowlDots || 0) + 1; if (this.bowlDots >= G.T('fireStreak')) { this.emit('bowl:fire', {}); } }\n  nextBatter() {\n    const I = this.I;\n    const out = I.bat.find(b => b.out && b.end === 'A');\n    if (I.nextP < I.squad) {\n      const idx = I.bat.indexOf(out) >= 0 ? I.bat.indexOf(out) : 0;\n      I.bat[idx] = { p: I.nextP++, end: 'A', runs: 0, balls: 0, fours: 0, sixes: 0, out: false, how: '' };\n    }\n  }\n  endOver() {\n    const I = this.I;\n    I.over++; I.ballInOver = 0;\n    if (I.over_runs === 0) { this.hypeGain(this.bowlSide, 20, 'maiden'); }\n    // the ends swap at the over's end\n    I.bat.forEach(b => { if (!b.out) b.end = b.end === 'A' ? 'B' : 'A'; });\n    this.bowlerDone(I);\n    this.setTimer('between', 1.2);\n    this.phase = 'between';\n    this.overJustEnded = true;\n    this.overEndCheck();\n  }\n  bowlerDone(I) { }\n  overEndCheck() {\n    const I = this.I;\n    if (I.over >= I.overs) { this.endInnings('overs'); }\n  }\n  endInnings(reason) {\n    const I = this.I;\n    I.endReason = reason;\n    this.emit('innings:end', { k: this.inn, runs: I.runs, wkts: I.wkts, reason });\n    if (this.inn === 0 || this.inn === 1 && this.innings.length === 2) {\n      if (this.inn === 1 && reason !== 'target' && this.target() !== null && I.runs < this.target() - 1 + 1) { /* chase lost */ }\n    }\n    this.checkResult(reason);\n  }\n  target() { return this.I.target; }\n  checkResult(reason) {\n    const k = this.inn;\n    if (k === 0) { this.setTimer('break', 2.5); this.phase = 'break'; this.inningsBreak = true; return; }\n    if (k === 1) {\n      const a = this.innings[0], b = this.innings[1];\n      if (b.runs >= a.runs + 1) return this.finish('chase', b.side);\n      if (a.runs === b.runs) {\n        // a tie: the Super Over\n        this.setTimer('break', 2.5); this.phase = 'break'; this.superNext = true; return;\n      }\n      return this.finish('defend', a.side);\n    }\n    if (k === 2) {\n      const a = this.innings[0], s = this.innings[2];\n      const other = this.innings[1];\n      // the super over's sides: the chase of the super over\n      return this.finish('super', s.side);\n    }\n  }\n  endBreak() {\n    if (this.superNext) { this.superNext = false; this.nextInnings(2); this.cfg.superBatFirst = this.cfg.superBatFirst || 0; return; }\n    if (this.inn === 0) { this.nextInnings(1); return; }\n    this.finish('?', 0);\n  }\n  finish(kind, winnerSide) {\n    this.phase = 'end';\n    const A = this.innings[0], B = this.innings[1] || null;\n    const winner = winnerSide;\n    let margin = '';\n    if (kind === 'defend' || kind === 'super') margin = (this.innings[0].runs - (this.innings[1] ? this.innings[1].runs : 0)) + ' runs';\n    if (kind === 'chase') margin = (this.I.wk - this.I.wkts) + ' wickets';\n    this.result = { kind, winner, loser: 1 - winner, margin, A: A.runs, Bruns: B ? B.runs : 0, log: this.log, stats: this.stats };\n    this.emit('match:end', { kind, winner, margin });\n  }\n  // the powers: Hype, ON FIRE, items and targets\n  hypeGain(side, n, why) {\n    const g = G.T('hypeGain');\n    this.hype[side] = clamp(this.hype[side] + n * g, 0, 100);\n    if (this.hype[side] >= 100 && !this.hypeFull) { this.emit('hype:full', { side }); }\n    this.hypeFull = this.hype[side] >= 100;\n  }\n  spawnItem() {\n    const side = this.battingSide;\n    const pick = Object.keys(G.ITEMS)[Math.floor(this.rnd() * Object.keys(G.ITEMS).length)];\n    const x = G.W.PX + (this.rnd() - .5) * 360, y = G.W.CY + (this.rnd() - .5) * 240;\n    this.items[side] = [{ id: pick, x, y, r: 14 }];\n    this.emit('item:spawn', { id: pick, x, y, side });\n  }\n  checkTargets() {\n    const b = this.ball;\n    for (const tg of this.ground.targets) {\n      if (this.targetsHit[tg.id]) continue;\n      if (Math.hypot(b.x - tg.x, b.y - tg.y) <= tg.r && b.z <= tg.z + 14 && b.carried) {\n        this.targetsHit[tg.id] = true;\n        this.stats.targets++;\n        this.addRuns(tg.bonus, 'bonus');\n        this.targetBonus[this.battingSide] += tg.bonus;\n        this.hypeGain(this.battingSide, 30, 'target');\n        this.emit('target:hit', { id: tg.id, name: tg.name, bonus: tg.bonus });\n      }\n    }\n    const it = this.items[this.battingSide];\n    if (it.length) {\n      const i = it[0];\n      if (Math.hypot(b.x - i.x, b.y - i.y) <= i.r && b.z < 30 && b.carried) {\n        this.items[this.battingSide] = [];\n        this.stats.items++;\n        if (i.id === 'cake') this.hypeGain(this.battingSide, 40, 'cake');\n        else if (i.id === 'teapot') this.teapot = true;\n        else if (i.id === 'horseshoe') this.horseshoe = true;\n        this.emit('item:got', { id: i.id, side: this.battingSide });\n      }\n    }\n  }\n  startRain() {\n    this.setTimer('rain', 6);\n    this.phase = 'rain';\n    this.emit('rain:start', {});\n    this.rainDelay = 6;\n    this.kmDelay = null;\n    if (this.I.k !== 1 && this.inn !== 1) { }\n  }\n  endRain() {\n    // Kerfuffle Method: the second innings is revised by resources, when the overs are cut\n    const I = this.innings[1] || null;\n    if (I && I.k === 1 && this.innings[0]) {\n      const O = I.overs, o = I.overs - 1, w = I.wkts;\n      const Rb = (O / O) * (1 - 0.07 * w), Ra = (o / O) * (1 - 0.07 * w);\n      const rev = Math.max(I.runs + 1, Math.floor(this.innings[0].runs * Ra / Rb) + 1);\n      I.overs = o; I.target = rev; this.rainRevised = rev;\n      this.kmDelay = { before: this.innings[0].runs + 1, after: rev, O, o, w, firstRuns: this.innings[0].runs };\n      this.emit('kerf-method', this.kmDelay);\n    }\n    this.emit('rain:end', {});\n    this.setTimer('between', 0.5);\n    this.phase = 'between';\n  }\n  startChaos(id) {\n    this.chaos = { id, t: 0 };\n    this.emit('chaos', { id });\n    this.setTimer('chaos', 2.5);\n    this.phase = 'chaos';\n    this.chaosDone = false;\n  }\n  stepChaos() { }\n  endChaos() { this.chaos = null; this.setTimer('between', 0.4); this.phase = 'between'; }\n  endBetween() {\n    if (this.overJustEnded) { this.overJustEnded = false; this.phase = 'setup'; this.setTimer('setup', 0.6); this.placeFielders(); this.chooseNextBowler(); if (this.phase === 'end') return; this.beginOver(); return; }\n    this.phase = 'setup'; this.timer = 0.6; this.placeFielders();\n  }\n  chooseNextBowler() {\n    const I = this.I, team = this.team(this.bowlSide);\n    const list = team.bowlers.filter(i => i !== I.bowlerLast);\n    const bowlers = list.length ? list : team.bowlers;\n    I.bowlerLast = I.bowler;\n    I.bowler = bowlers[(I.over) % bowlers.length];\n  }\n  // a stop for the inputs: the current human roles\n  cpuBatting() { return !this.cfg.humans || this.cfg.humans.batSide !== this.battingSide || this.cfg.autoBat; }\n  cpuPlanBat() {\n    const diff = G.T('aiBatSkill');\n    const err = (this.rnd() - .5) * 2 * diff / 1000 * (this.delivery && this.lastDel && this.lastDel.fam === 'spin' ? 1.2 : 1);\n    const perfect = this.cfg.cheatPerfect;\n    this.cpuPressAt = this.t + (this.predArrive || 0.4) - G.SHOTS.drive.contactAt + (perfect ? 0 : err);\n    this.cpuIntent = this.cpuChooseShot();\n  }\n  cpuChooseShot() {\n    const pr = this.cpuIntent;\n    const len = G.lengthOf(this.ball.pitchY || (this.ball.pitchY = this.predictPitchY()));\n    const agg = G.T('aiAggression');\n    const boost = this.cfg.cheatPerfect ? 0.9 : 0;\n    const loft = this.rnd() < agg * 0.6 + boost * 0.3 && (len !== 'yorker');\n    const button = len === 'yorker' ? 'block' : len === 'short' ? (loft ? 'loft' : 'shot') : loft ? 'loft' : 'shot';\n    return { button, aim: null, cpu: true };\n  }\n  cpuPress() {\n    if (this.pressed || !this.cpuIntent) return;\n    const it = this.cpuIntent;\n    this.cpuPressAt = null;\n    this.batPress(it.button, it.aim);\n  }\n  // the bowling side's fielders: a human takes the active fielder (the one nearest the ball)\n  setActiveHuman(f) { for (const x of this.fielders) x.human = false; if (f) f.human = true; }\n  fieldMove(dx, dy, dt) {\n    const f = this.fielders.find(x => x.human); if (!f) return;\n    const sp = f.speed * 1.2;\n    f.x = clamp(f.x + dx * sp * dt, 60, 1090); f.y = clamp(f.y + dy * sp * dt, 60, 1090);\n  }\n};\n","userModified":false},"tool_result_meta":[{"id":"toolu_01Hgv2cHpPGzGCtnMDWvkrJF","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
