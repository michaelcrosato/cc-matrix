{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"rg -n 'class Attack|class Game|class Input|class Menu|class Settings|registerPose|poses|menu:|autoPause|allowJoin|shell' Quest-for-the-Fourfold-Rings-Quest-for-the-Rings-gpt-6.1-sol-ultra-20261106-031849/vendor/engine/my-3d2dge.js | head -65\"","aggregated_output":"47: *    new E.Game({ menu: { items, settings, controls, quit, saves } }), or leave them out (menu: false, fullscreen: false,\n48: *    corner: false, autoPause: false).\n68: *    are large): 325 curated motion clips and 2,548 motion-capture takes as readable key poses that play on any\n324:   viewports drawn (section 10j); pose(dt, s): the traversal moves' poses, on the rig (this; section 16c); pause(shell, acts):\n754:class Input {\n892:   *  gets back to the menu), and those the game hides with new E.Game({ menu: { controls: { a: false } } }) */\n2308:class Game {\n2311:   * fullscreen: 'tap', corner: true, backGesture: true, autoPause: true, live: false, id, pace, camera }). The standard features\n2312:   * (section 10b) every game gets: menu, fullscreen, corner, backGesture, autoPause.\n2322:   * - menu: the pause, settings and controls screens ({ items, settings, controls, quit } adjusts them, false leaves them out)\n2327:   * - autoPause: a pausable scene pauses when the page is hidden or loses focus\n2401:    this.shell = null;\n2493:  /** the players: [game.input (player 1), ...the ones who joined (game.allowJoin, game.addPlayer: section 10j)]; each an\n2537:   *  (new E.Game({ autoPause: false }) turns that off); coming back never resumes by itself */\n2538:  _autoPause(reason) { this.input.stopRumble(); return this.o.autoPause !== false && !!this.scene && !!this.scene.pausable && this.pause(reason); }\n2542:   * menu('controls') opens that screen. Without a menu (menu: false, or the agent edition) it pauses a scene in play.\n2547:    const sh = this.shell, s = this.scene, play = !!s && (!!s.pausable || this.sceneName === 'main');\n2559:    on(window, 'blur', () => this._autoPause('focus'));\n2560:    on(document, 'visibilitychange', () => { if (document.hidden) this._autoPause('focus'); this.audio._background(document.hidden && !this.settings.background); });   // a hidden page sleeps its soun [... omitted end of long line]\n2561:    on(window, 'pagehide', () => this._autoPause('focus'));\n2563:    const fsChange = () => { this.input._refit(); if (this.shell && this.shell.screen) this.shell._render(); };   // (the player's choice is what they asked for: fullscreen.toggle() keeps it)\n2592:  _canBack() { const s = this.scene; return !!(this.shell && this.shell.screen) || !!s && (!!s.pausable || this.sceneName === 'main' || !!s.back); }\n2599:    const sh = this.shell, s = this.scene; if (sh && sh.screen) { sh.back(); return true; }\n2619:    const sh = this.shell, s = this.scene, I = this.input, fs = this.fullscreen, open = !!(sh && sh.screen);\n2622:    const showM = !open && (this.o.menu !== false ? (!!(sh && sh._menu()) || main) && (!play || near || touch) : !!I._touchEl);   // (menu: false: the touch START alone)\n2829:    if (this.shell) this.shell.dispose();\n2938:    if (this.input.padLost) { this._autoPause('controller'); if (this.shell) this.shell.toast('Controller disconnected', 'Press a button on a controller to use it, or play on.'); else this.note('CONTR [... omitted end of long line]\n2939:    if (this.shell) this.shell._step();   // its screens move the focus with this step's input, and hold it back from the game\n2947:    const I = this.input, zr = !this.paused && !(this.shell && this.shell.screen) && !!this.zoomRange();\n2981:    if (F.keys !== false && !(this.shell && this.shell.screen) && !I.stickOn) { const m = I.move(), sp = (F.speed || 300) * dt; dx += m[0] * sp; dy += m[1] * sp; }   // (a finger pans by its drag, not [... omitted end of long line]\n3003:    if (this.paused && this.pauseOverlay && !(this.shell && this.shell._sys && this.shell.screen)) this.r.overlay(g => {\n3023: *      new E.Game({ menu: { settings: [{ key: 'hints', label: 'Hints', value: true }] } }) and reads game.settings.hints;\n3087:class Settings {\n3182:const CORNER_ICONS = { menu: 'M4 7h16M4 12h16M4 17h16', full: 'M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5', exit: 'M9 4v5H4M20 9h-5V4M15 20v-5h5M4 15h5v5' };\n3193:  btn('Menu', () => { if (game.o.menu !== false) game.menu(); else game.input._tapCode('Act:menu'); }).innerHTML = cornerIcon(CORNER_ICONS.menu);   // (menu: false: the touch START)\n3724: *    numpad on the right), touch for player 1. game.allowJoin({ max, onJoin }) lets them in: Start on a free pad, or 2 (the\n3755: *  (input, number) as each does. allowJoin(false) closes it (the names split and join are String's and Array's) */\n3756:Game.prototype.allowJoin = function (o = {}) {\n3776:  if (this._join && this._join.onJoin) try { this._join.onJoin(q, n); } catch (e) { this.fail('allowJoin onJoin', e); }\n3826:    if (q.padLost) { game._autoPause('controller'); game.note(q.name + ': CONTROLLER DISCONNECTED', 2.5); }\n3872: *    new E.Game({ menu: { saves: true } }) puts Save (while saves.canSave: a JRPG sets it at a save point) and Load in\n3875: *    menu: { saves: { slots: 3, version: 2, migrate(data, from) { ...; return data; } } } sets them.\n3948:   *  a save. False without a menu (a headless game, menu: false) */\n3950:    const sh = this.game.shell; if (!sh || !sh._menu()) return false;\n3981:HOOKS.pause = (sh, acts) => {   // the pause menu's Save and Load, with menu: { saves }\n4028:  this._needEl.style.display = this.shell && this.shell.screen ? 'none' : 'flex';   // (Settings open over it: hidden while it is)\n4032: *    Local frame: f = forward, r = right, z = up. The rig poses itself every step\n4173:    // held poses: 'cheer' (item get, victory), 'cast' (both hands forward), 'guard' (fists up), 'kneel', 'crouch', 'wave', 'hips'\n4244:    const OW = this._ownW || (this._ownW = {});   // a game's own held poses (E.Humanoid.pose), eased in and out as state.pose names them, over the solve\n4790:/* the Humanoid's registries (a game's own weapons, hats and held poses beside the built-ins, which are on them too) */\n4795:/** held poses of a game's own (state.pose: an id), by id: E.Humanoid.pose(id, (J, w, rig) => ...) adds one */\n4873:/** the held poses of a game's own, by id (the built-in poses are the rig's own solve: state.pose names either) */\n4874:Humanoid.poses = HUMANOID_POSES;\n4895:class Attack {\n6764:  rigState(extra) { return Object.assign({ x: this.x, y: this.y, z: this.z, vx: this.vx, vy: 0, vz: this.vz, facing: this.facing > 0 ? 0 : Math.PI, air: this.air && !this.climbing, climb: !!this.climb [... omitted end of long line]\n6825: * 16c. TRAVERSAL  the Platformer's further moves, each opt-in (today's defaults are unchanged), and the rig's poses for\n7003:// the rig's poses for the moves (Humanoid.update calls it after the pose is solved): crawl (prone, elbows and knees\n9269:class Menu {\n9355: *    THE STANDARD MENU: every game gets one (new E.Game makes this shell for itself, and a game's own E.Shell takes over\n9360: *    defaults). new E.Game({ menu: { items: [['Restart', fn]], settings: [...], controls: { attack: 'Sword', skill:\n9361: *    false }, quit: 'title' } }) adjusts it; menu: false, or new E.Shell(game, { standard: false }), leaves it out.\n9417:   * new E.Shell(game, { theme, screens: { name: spec }, settings: { items, onChange(settings, key) }, store: 'shell-settings',\n9430:    if (game.shell && game.shell._sys && !o.system) game.shell.dispose();   // the game's own shell takes over from the engine's\n9434:    const old = store.get(o.store || 'shell-settings', null) || {}, S = game.settings;   // (settings saved by an older version are kept)\n9438:    game.shell = this;\n","exit_code":0,"status":"completed"}}
