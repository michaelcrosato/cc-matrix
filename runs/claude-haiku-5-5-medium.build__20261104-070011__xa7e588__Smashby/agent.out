ers;\n522:        E.font.text(g, 'VERSUS: PRESS 2 ON THE KEYBOARD, OR START ON A PAD, TO JOIN', r.W / 2, 96, '#ffe7a8', { align: 'center', font: 'tiny', outline: false });\n523:        ['P1 GULLS', 'P2 RUST', 'P3 GULLS', 'P4 RUST'].forEach((s, i) => E.font.text(g, s + (P[i] ? '  READY' : '  ...'), r.W / 2 - 40, 112 + i * 12, P[i] ? E.PLAYER_COLORS[i] : '#6a7090', { outline: false }));\n524:        E.font.text(g, prompt('confirm', 'PLAY') + '   ' + prompt('cancel', 'BACK'), r.W / 2, 172, '#c8d0e8', { align: 'center', font: 'tiny', outline: false });\n525:      }\n526:    });\n527:    if (mode === 'menu') menu.draw(r);\n528:  }\n529:\n530:  /* ---- THE CONTROLS: the default preset's stick with three buttons of its own ---- */\n531:  const KEYS = Object.assign({}, E.Input.DEFAULT, { pass: ['KeyJ', 'KeyX', 'Pad0'], shoot: ['KeyK', 'KeyZ', 'Pad2'], lob: ['KeyL', 'KeyC', 'Pad3'] });\n532:  for (const k of ['attack', 'dash', 'skill', 'jump']) delete KEYS[k];\n533:\n534:  /** the proof: a match from the kickoff, player 1 running at goal, passing, lobbing, shooting; a hash of the match */\n535:  const run = (n = 600) => proof('sports', n, (i, k) => {\n536:    if (i === 1) start(false);\n537:    if (i === 140) k.hold('right'); if (i === 200) k.tap('pass'); if (i === 300) k.tap('lob');\n538:    if (i === 380) k.hold('shoot'); if (i === 440) k.up('shoot'); if (i === 520) k.up('right');\n539:  }, () => [Math.round(ball.x), Math.round(ball.y), Math.round(ball.z), score, all.map(p => [Math.round(p.body.x), Math.round(p.body.y)]), stats.passes, stats.shots, owner ? owner.name : null]);\n540:  /** the bot: player 1 plays a match by the game's own rules (the stick and the buttons, as a player gives them, from the\n541:   *  CPU's own judgment for its player) to the final whistle; then four players, each holding one footballer, for a\n542:   *  stretch. Returns { full, score, goals, passes, done, lobs, shots, curled, tackles, four, seconds, errors } */\n543:  function bot(s = 1) {\n544:    const was = Math.random; Math.random = E.rng(s); const I = game.input, held = new Set(), hold = (a, on) => { if (on && !held.has(a)) { held.add(a); I.hold(a); } else if (!on && held.has(a)) { held.delete(a); I.hold(a, false); } };\n545:    scripted = true;\n546:    try {\n547:      game.go('sports', null, { fade: 0 }); game.advance(1 / 120); start(false);\n548:      let n = 0;\n549:      for (; n < 120 * 400 && mode !== 'full'; n++) {\n550:        const me = team[0].find(p => p.input);\n551:        if (me && mode === 'play') {\n552:          const c = brain(me, 1 / 120), mv = curlT > 0 && last === me && !owner ? [0, 0] : c.move;   // what the CPU would do in its place, given as the stick and buttons (still while its shot flies: no curl)\n553:          hold('right', mv[0] > .35); hold('left', mv[0] < -.35); hold('down', mv[1] > .35); hold('up', mv[1] < -.35);\n554:          if (c.pass) I.tap('pass'); if (c.lob) I.tap('lob'); hold('shoot', c.shootHeld);\n555:        } else for (const a of ['right', 'left', 'up', 'down', 'shoot']) hold(a, false);\n556:        game.advance(1 / 120);\n557:      }\n558:      for (const a of [...held]) hold(a, false);\n559:      const r = { full: mode === 'full', score: score.slice(), goals: stats.goals.length, passes: stats.passes, done: stats.done, lobs: stats.lobs, shots: stats.shots, curled: stats.curled, tackles: stats.tackles, walls: stats.walls, seconds: Math.round(n / 120) };\n560:      // four players: three more join, each footballer held by an input; a stretch of play, each pushing its stick\n561:      while (game.players.length < 4) game.addPlayer(game.players.length === 1 ? { keys: 'right' } : { pad: game.players.length - 1 });\n562:      start(true); const moved = all.map(p => [p.body.x, p.body.y]);\n563:      for (let k = 0; k < 240; k++) { for (const p of all) if (p.input && p.input !== I) p.input.hold(p.side ? 'left' : 'right', k > 140); game.advance(1 / 120); }\n564:      r.four = { held: all.filter(p => p.input).length, moved: all.filter((p, i) => Math.hypot(p.body.x - moved[i][0], p.body.y - moved[i][1]) > 4).length };\n565:      for (const p of all) if (p.input && p.input !== I) p.input.hold(p.side ? 'left' : 'right', false);\n566:      while (game.players.length > 1) game.removePlayer(game.players[game.players.length - 1]);\n567:      r.errors = game.errors.length; toMenu(); return r;\n568:    } finally { for (const a of [...held]) hold(a, false); Math.random = was; scripted = false; }\n569:  }\n570:\n571:  return { view: 'threequarter', views: ['threequarter', 'topdown'], input: KEYS, res: 'ps1', pausable: true, touch: ['lob', 'shoot', 'pass'], camera: { zoom: [.7, 1.6] },\n572:    enter(d) { game.cam.bounds = null; t = 0; if (d && d.part === 'match') start(false); else if (d && d.part === 'vs') versus(); else toMenu(); },\n573:    back() { if (mode === 'menu') { game.go('title'); return true; } if (mode === 'join' || mode === 'full') { toMenu(); return true; } return false; },\n574:    update, draw, bot, run,\n575:    state: () => { const you = all.find(p => p.input === game.input);   // (for tests)\n576:      return { mode, clock: +clock.toFixed(2), score: score.slice(), half, golden, owner: owner && owner.name, ball: ball && [Math.round(ball.x), Math.round(ball.y), Math.round(ball.z)],\n577:        you: you && { name: you.name, x: Math.round(you.body.x), y: Math.round(you.body.y) }, passes: stats ? stats.passes : 0, shots: stats ? stats.shots : 0 }; } };\n578:})();\n579:scenes.sports = SPORTS;\n580:\n581:/* ---- START: the title menu, or a slice named in the address (#platformer) ---- */\n582:// a genre kit file holds one slice: the menu lists only the slices in this file\n583:for (let i = SLICES.length - 1; i >= 0; i--) if (!scenes[SLICES[i].id]) SLICES.splice(i, 1);\n584:titleMenu = menuOf(SLICES, { y: 76, onPick: i => game.go(SLICES[i].id) });\n585:// #<slice>/<part> jumps in (#arcade/maze, #shooter/horizontal): the slice's enter(data) gets { part }; a part that is 