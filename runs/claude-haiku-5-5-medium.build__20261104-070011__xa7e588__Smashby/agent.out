{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgi1hqHk887B6YVegrqtt","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":21060,"cache_read_input_tokens":165186,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":21060},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5f6aeda2-f9ed-42d4-a150-3a2efde4ea9e","uuid":"3d0b62c7-3a80-4523-8e48-9786ddcff498","timestamp":"2026-11-04T14:04:14.200Z","request_id":"req_011Cgi1hpwQkKYfyewRgiox8","thinking_duration_ms":44856,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgi1hqHk887B6YVegrqtt","type":"message","role":"assistant","content":[{"type":"text","text":"The core is in. Next is the match simulation, the largest piece: players, ball physics, passing, tackles, rucks, scrums, lineouts, kicks, tries, penalties, the referee's sight, halves and the AI. It runs headless with no rendering, so tests can drive it directly."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":21060,"cache_read_input_tokens":165186,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":21060},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5f6aeda2-f9ed-42d4-a150-3a2efde4ea9e","uuid":"ccbd734d-6006-4af4-a1a4-c28f715d563c","timestamp":"2026-11-04T14:04:14.734Z","request_id":"req_011Cgi1hpwQkKYfyewRgiox8"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgi1hqHk887B6YVegrqtt","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017JRhpaYK7KfMhc21Q5q72M","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-070011__xa7e588/work/Smashby-Rugby-claude-haiku-5-5-medium-20261104-070011/src/10-sim.js","content":"// THE MATCH SIMULATION: rules, physics, contact, set pieces and the AI. It reads intents and writes match state; it\n// never draws. Seeded (SM.seed), fixed-step (the engine's update), and every number is read from SM.TUNE.v.\n// A human seat gives an intent per step: { mx, my (stick), turbo, pass ('up'|'down'|null), tackle (press), tackleHeld,\n// sidestep, fend, dive, kick (held), kickUp (released), superPress, mashPress, jackalPress, choose }.\nSM.M = null;   // the live match\nconst G = 600;            // the ball's gravity (units per second squared)\nconst DIR = s => s === 0 ? 1 : -1;   // side 0 attacks toward +x (the right of the screen), side 1 toward -x\nconst dist = (ax, ay, bx, by) => Math.hypot(ax - bx, ay - by);\nconst ANG = (a, b) => { let d = b - a; while (d > Math.PI) d -= 2 * Math.PI; while (d < -Math.PI) d += 2 * Math.PI; return d; };\nconst SIDE_OF = (teamIdx) => teamIdx;   // (a side is a team; the home team is side 0)\n\n// A player: the body, the stats, the state machine and the input (or none for an AI player)\nfunction makePlayer(side, pos, def, teamDef, idx) {\n  const [name, nick, role, build, size, hair, hairC, skin, hat, stats] = def;\n  return {\n    i: idx, side, pos, role, name, nick, build, size, hair, hairC, skin, hat,\n    stats: { SPD: stats[0], POW: stats[1], HND: stats[2], KCK: stats[3], TKL: stats[4] },\n    x: 0, y: 0, z: 0, vx: 0, vy: 0, facing: side ? Math.PI : 0,\n    st: 'run', stT: 0, cool: 0, turbo: 3, turboOn: false, evade: 0, spinT: 0, fendT: 0, diveT: 0, bigT: 0, bigHeld: false,\n    tackleT: 0, stunT: 0, bin: 0, onFire: false, cheer: 0, mudT: 0, jackalT: 0, lastSide: side,\n    input: null, aiT: 0, aiFor: 0, power: 0, kickHeld: 0, kickCharge: false,\n    team: teamDef, hitBy: null, ballCarried: 0, pieFx: 0, inPlay: true\n  };\n}\n\n// The venue's floor features and sky events (the mud, the wind, the lightning and the flame grates)\nfunction venueState(venue) {\n  const M = SM.M;\n  M.mud = []; M.grates = []; M.lightning = null; M.windT = 0; M.windDir = 0; M.wind = 0; M.clucky = 0;\n  if (venue.mud) for (let k = 0; k < 6; k++) M.mud.push({ x: SM.lerp(SM.X0 + 100, SM.X1 - 100, SM.fx()), y: SM.lerp(SM.Y0 + 60, SM.Y1 - 60, SM.fx()), r: 30 + SM.fx() * 30 });\n  if (venue.id === 'furnace') for (let k = 0; k < 8; k++) M.grates.push({ x: SM.lerp(SM.X0 + 100, SM.X1 - 100, k / 7), y: SM.Y0 + 20, phase: 0, t: 0 }, { x: SM.lerp(SM.X0 + 100, SM.X1 - 100, k / 7), y: SM.Y1 - 20, phase: 0, t: 0 });\n}\n\n// Build a match. o: { home, away (team indices), venue (venue index), halves (seconds per half), humans:[{ input, side, pos }], attract, cup, seed }\nSM.newMatch = function (o) {\n  SM.seed(o.seed || 1);\n  const venue = SM.VENUES[o.venue || 0];\n  const teams = [SM.TEAMS[o.home || 0], SM.TEAMS[o.away || 1]];\n  const M = {\n    teams, venue, half: 1, run: 0, halfLen: o.halves || SM.TUNE.v.halfLength, phase: 'kickoff', pt: 0, score: [0, 0], hype: [0, 0],\n    players: [], ball: null, hooter: false, golden: false, over: false, attract: !!o.attract, cup: !!o.cup, stats: [{ tries: 0, tackles: 0, missed: 0, bigHits: 0, monster: 0, metres: 0, breaks: 0, turnovers: 0, cards: 0, poss: 0, terr: 0, passes: 0, kicks: 0 }, { tries: 0, tackles: 0, missed: 0, bigHits: 0, monster: 0, metres: 0, breaks: 0, turnovers: 0, cards: 0, poss: 0, terr: 0, passes: 0, kicks: 0 }],\n    events: [], ruck: null, scrum: null, lineout: null, pen: null, conv: null, tryStreak: [null, null], lastTry: [0, 0], lastTouch: 0,\n    kickSide: 0, kickT: 0, dropAt: null, powerups: [], powerupT: 25, pickup: null, humanSeats: [], refX: 0, refY: 0, ruckWon: 0,\n    clock: 0, lastScorer: null, goalKick: null, flight: null, t: 0, banner: null, bannerT: 0, passCount: 0, rulesLog: [],\n    sinBinned: [0, 0], pos: null, fail: null\n  };\n  SM.M = M;\n  venueState(venue);\n  // the players: seven a side, in their formation order\n  for (let s = 0; s < 2; s++) {\n    teams[s].players.forEach((def, k) => {\n      const p = makePlayer(s, k, def, teams[s], s * 7 + k);\n      p.body = new My3D2dge.Body({ x: 0, y: 0, r: 5, friction: 0, gravity: 0 });\n      p.rig = new My3D2dge.Humanoid({ size: p.size, build: p.build, hair: p.hair === 'bald' ? 'bald' : p.hair, weapon: null, hat: p.hat === 'none' ? undefined : p.hat,\n        colors: Object.assign({ cloth: teams[s].colors.cloth, trim: teams[s].colors.trim, pants: teams[s].colors.pants, boot: teams[s].colors.boot, belt: teams[s].colors.belt, hair: p.hairC, skin: p.skin }, s === 1 && teams[s].away ? teams[s].away : {}) });\n      M.players.push(p);\n    });\n  }\n  // the referee walks the pitch behind play; the commentators are the presentation's business\n  M.ball = { x: SM.CX, y: SM.CY, z: 0, vx: 0, vy: 0, vz: 0, state: 'placed', owner: null, lastTouch: 0, kickBy: null, spin: 0, roll: 0, bounce: 0, flightTo: null, ready: 0 };\n  // seats: humans get their player (the first forward of side 0 unless given)\n  if (o.humans) for (const h of o.humans) {\n    const p = M.players.find(q => q.side === h.side && q.pos === h.pos);\n    if (p) { p.input = h.input; M.humanSeats.push(p); }\n  }\n  // the cheats of the dev panel: every cheat is read in the sim, never stored in the tuning\n  SM.kickoff(0);\n  return M;\n};\n\n// the formation spots: a kickoff (the kicking side kicks from the centre) and the in-play shape\nSM.kickoff = function (kickSide) {\n  const M = SM.M;\n  M.phase = 'kickoff'; M.pt = 0; M.kickSide = kickSide; M.kickT = 1.4;\n  M.ball.owner = null; M.ball.state = 'placed'; M.ball.x = SM.CX; M.ball.y = SM.CY; M.ball.z = 0; M.ball.vx = M.ball.vy = M.ball.vz = 0;\n  for (const p of M.players) {\n    if (p.bin > 0) continue;\n    const d = DIR(p.side), k = p.pos;\n    if (p.side === kickSide) {\n      const fh = k === 4;\n      p.x = fh ? SM.CX - d * 6 : SM.CX - d * (50 + k * 10); p.y = fh ? SM.CY : SM.CY + (k % 2 ? 30 : -30) + (k - 3) * 6;\n    } else {\n      p.x = SM.CX + d * (140 + (k % 3) * 25); p.y = SM.CY + (k - 3) * 52;\n    }\n    p.y = SM.clamp(p.y, SM.Y0 + 14, SM.Y1 - 14); p.vx = p.vy = 0; p.facing = p.side ? Math.PI : 0; p.st = 'run'; p.stT = 0; p.evade = p.fendT = p.diveT = 0;\n  }\n  M.events.push({ t: 'kickoff', side: kickSide });\n};\n\n// the spot a player wants this step. With the ball (side in possession): the attack shape behind the carrier; without\n// it: the nearest two chase the ball, the rest hold the defensive line in front of their attackers.\nSM.shapeFor = function (p) {\n  const M = SM.M, b = M.ball, d = DIR(p.side), inPos = M.ball.owner && M.ball.owner.side === p.side;\n  const attacking = inPos || (M.ball.state === 'loose' && M.ball.lastTouch === p.side);\n  const bx = b.x, by = b.y;\n  if (attacking) {\n    const slots = [[-14, -26], [-8, 0], [-14, 26], [-22, 0], [-42, 0], [-60, -24], [-84, -54]];\n    const s = slots[p.pos];\n    let tx = bx + d * s[0], ty = by + s[1];\n    // the backs spread, and never stand in front of the carrier\n    if (M.ball.owner && M.ball.owner === p) { tx = bx; ty = by; }\n    if (p.pos >= 5 && M.ball.owner && M.ball.owner.side === p.side) tx = Math.min(tx, bx - d * 6) * (d > 0 ? 1 : 1);\n    return [SM.clamp(tx, SM.X0 - 40, SM.X1 + 40), SM.clamp(ty, SM.Y0 + 14, SM.Y1 - 14)];\n  }\n  // defending: the defensive line, each man paired with an attacker by y\n  const atk = M.players.filter(q => q.side !== p.side && q.bin <= 0).sort((a, b2) => a.y - b2.y);\n  const mine = M.players.filter(q => q.side === p.side && q.bin <= 0).sort((a, b2) => a.y - b2.y);\n  const rank = mine.indexOf(p);\n  const target = atk[Math.min(atk.length - 1, Math.max(0, rank))];\n  if (!target) return [bx, by];\n  const dd = DIR(target.side);\n  // the defender in front of his man, toward the goal he is defending\n  return [SM.clamp(target.x + dd * 28, SM.X0 - 30, SM.X1 + 30), SM.clamp(target.y, SM.Y0 + 14, SM.Y1 - 14)];\n};\n\n// kicks: a ball flight with the apex height given; the horizontal speed lands it at tx, ty\nSM.kickFlight = function (fromX, fromY, tx, ty, apex, kind) {\n  const b = SM.M.ball, dx = tx - fromX, dy = ty - fromY, d = Math.hypot(dx, dy) || 1;\n  const vz = Math.sqrt(2 * G * apex), T = 2 * vz / G, sp = d / T;\n  b.x = fromX; b.y = fromY; b.z = 8; b.vx = dx / d * sp; b.vy = dy / d * sp; b.vz = vz;\n  b.state = 'air'; b.owner = null; b.kind = kind; b.spin = 0; b.flightTo = [tx, ty];\n};\n\n// pass: the ball to the receiver's predicted spot, with a low arc (catch by reach)\nSM.passTo = function (p, recv) {\n  const b = SM.M.ball, T = TUNE('passSpeed');\n  const d = dist(p.x, p.y, recv.x, recv.y), t = d / T;\n  const tx = recv.x + recv.vx * t * .8, ty = recv.y + recv.vy * t * .8;\n  const dx = tx - p.x, dy = ty - p.y, L = Math.hypot(dx, dy) || 1;\n  b.x = p.x + dx / L * 8; b.y = p.y + dy / L * 8; b.z = 10;\n  b.vx = dx / L * T; b.vy = dy / L * T; b.vz = 0; b.state = 'pass'; b.owner = null; b.kind = 'pass'; b.passer = p; b.receiver = recv;\n  b.lastTouch = p.side; M.stats = M.stats; SM.M.stats[p.side].passes++; SM.M.passCount++;\n  p.cool = .12; p.kickCharge = false;\n};\n\nconst TUNE = k => SM.TUNE.v[k];\n\n// the referee: a sight cone, behind the ball on the attack side\nSM.refSees = function (p) {\n  const M = SM.M;\n  if (SM.CHEATS.refBlind) return false;\n  if (SM.CHEATS.refStrict) return true;\n  const rx = M.refX, ry = M.refY, dx = p.x - rx, dy = p.y - ry, d = Math.hypot(dx, dy);\n  if (d > TUNE('refRange') || d < 1) return d < 1;\n  const facing = Math.atan2(M.ball.y - ry, M.ball.x - rx);\n  return Math.abs(ANG(facing, Math.atan2(dy, dx))) < 1.4 / 2 + .4;\n};\n\n// the whistle: a foul by side `offender` (its player), a penalty to the other side at the spot\nSM.foul = function (kind, offender, x, y, seenOnly) {\n  const M = SM.M;\n  const seen = seenOnly ? SM.refSees(offender) : true;\n  M.stats[offender.side].cards += 0;\n  if (!seen) { M.events.push({ t: 'unseen', kind }); M.hype[1 - offender.side] += 0; return; }\n  M.events.push({ t: 'foul', kind, side: offender.side });\n  const pen = M.pen = { side: 1 - offender.side, x: SM.clamp(x, SM.X0 + 10, SM.X1 - 10), y: SM.clamp(y, SM.Y0 + 10, SM.Y1 - 10), kind, player: offender };\n  SM.setPhase('penalty');\n  pen.card = kind === 'cheap' || kind === 'high';\n  if (pen.card) SM.sendOff(offender);\n};\n\n// a yellow card: the sin bin for sinBin seconds of play\nSM.sendOff = function (p) {\n  const M = SM.M;\n  p.bin = TUNE('sinBin'); p.st = 'bin'; p.input = null;\n  M.stats[p.side].cards++;\n  M.events.push({ t: 'yellow', side: p.side, name: p.nick });\n  M.sinBinned[p.side] = (M.sinBinned[p.side] || 0) + 1;\n  if (M.ball.owner === p) SM.dropBall(p);\n};\n\nSM.setPhase = function (name) {\n  const M = SM.M;\n  if (M.phase === name) return;\n  if (name !== 'play' && M.hooter && M.phase === 'play') { M.phase = name; SM.halfOver(); return; }\n  M.phase = name; M.pt = 0; M.events.push({ t: 'phase', name });\n};\n\nSM.dropBall = function (p) {\n  const M = SM.M, b = M.ball;\n  if (b.owner !== p) return;\n  b.owner = null; b.state = 'loose'; b.x = p.x + Math.cos(p.facing) * 8; b.y = p.y + Math.sin(p.facing) * 8; b.z = 6;\n  b.vx = Math.cos(p.facing) * 60; b.vy = Math.sin(p.facing) * 60; b.vz = 40; b.lastTouch = p.side; b.bounce = 0;\n  b.droppedBy = p;\n};\n\n// the try: the carrier in the in-goal; the points, the hype and the conversion\nSM.tryScored = function (p) {\n  const M = SM.M, s = p.side, d = DIR(s);\n  const tx = p.x, ty = p.y;\n  M.score[s] += 5; M.stats[s].tries++; M.hype[s] = Math.min(100, M.hype[s] + 15 * TUNE('hypeMult'));\n  M.lastScorer = p; M.events.push({ t: 'try', side: s, name: p.nick, x: tx, y: ty });\n  // on fire: two tries in a row by one player\n  if (M.lastTry[s] === p.i) { p.onFire = true; M.events.push({ t: 'onFire', name: p.nick }); }\n  M.lastTry[s] = p.i; M.lastTry[1 - s] = -1; if (M.lastTry[1 - s] !== -1) { /* (the other side's last try is kept) */ }\n  for (const q of M.players) if (q.side !== s) q.onFire = false;\n  M.ball.owner = null; M.ball.state = 'placed'; M.ball.x = tx; M.ball.y = ty; M.ball.z = 0;\n  SM.setPhase('try'); M.tryT = 3; M.conv = { side: s, x: tx, y: ty, kicker: M.players.find(q => q.side === s && q.pos === 4), t: 0 };\n};\n\n// the conversion: a kick at the posts from the try spot; a real power meter for the human, a roll for the CPU\nSM.startConversion = function () {\n  const M = SM.M, c = M.conv, s = c.side, d = DIR(s), postX = s === 0 ? SM.POST1 : SM.POST0;\n  c.postX = postX; c.dist = Math.abs(postX - c.x); c.kicker = M.players.find(q => q.side === s && q.pos === 4) || M.players.find(q => q.side === s);\n  c.kicker.x = c.x - d * (c.dist < 140 ? 8 : 24); c.kicker.y = c.y; c.kicker.facing = s === 0 ? 0 : Math.PI;\n  c.meter = 0; c.up = true; c.aim = 0; c.decided = false; c.human = c.kicker.input || null;\n  SM.setPhase('conv');\n};\n\n// the scores: the kick's outcome is decided by the meter (human) or by the kicker's stats (CPU)\nSM.decideKick = function (power, aim, kind) {\n  const M = SM.M, c = M.conv, need = SM.clamp(c.dist / TUNE('kickMax') / 1.5, .2, .95);\n  const k = c.kicker;\n  let acc;\n  if (power === null) {                          // the CPU: its own kicking stat and a roll\n    const err = (10 - k.stats.KCK) * .02 + SM.R() * .05;\n    acc = Math.abs(err) < .1 ? 1 : 0;\n  } else acc = (Math.abs(power - need) < .07 && Math.abs(aim) < .35) ? 1 : 0;\n  const s = c.side;\n  if (acc) {\n    M.score[s] += kind === 'drop' ? 3 : kind === 'pen' ? 3 : 2;\n    M.events.push({ t: 'goal', side: s, kind, name: k.nick });\n    M.hype[s] = Math.min(100, M.hype[s] + 5 * TUNE('hypeMult'));\n    if (M.golden) return SM.fullTime();\n    SM.kickoff(s);\n  } else {\n    M.events.push({ t: 'miss', side: s, kind });\n    SM.dropOut(1 - s);\n  }\n};\n\n// a 22 drop-out: from the dead-ball line in the defenders' 22\nSM.dropOut = function (side) {\n  const M = SM.M, d = DIR(side), x = side === 0 ? SM.X0 + 225 : SM.X1 - 225;\n  M.ball.owner = null; M.ball.state = 'placed'; M.ball.x = x; M.ball.y = SM.CY; M.ball.z = 0; M.ball.vx = M.ball.vy = M.ball.vz = 0;\n  const pl = M.players.filter(q => q.side === side && q.bin <= 0).sort((a, b) => dist(a.x, a.y, x, SM.CY) - dist(b.x, b.y, x, SM.CY))[0];\n  if (pl) { pl.x = x - d * 8; pl.y = SM.CY; pl.facing = side === 0 ? 0 : Math.PI; M.ball.owner = pl; M.ball.state = 'held'; }\n  SM.setPhase('play'); M.events.push({ t: 'dropOut', side });\n};\n\n// a scrum at (x, y): the forwards bind, the feeding side (the team not at fault) wins the ball by a timed push\nSM.startScrum = function (x, y, feedSide) {\n  const M = SM.M;\n  M.scrum = { x: SM.clamp(x, SM.X0 + 60, SM.X1 - 60), y: SM.clamp(y, SM.Y0 + 60, SM.Y1 - 60), feed: feedSide, t: 0, set: 0, pressed: null, push: [0, 0] };\n  M.ball.owner = null; M.ball.state = 'placed';\n  M.ball.x = M.scrum.x; M.ball.y = M.scrum.y; M.ball.z = 0;\n  for (const q of M.players) {\n    if (q.bin > 0) continue;\n    if (q.pos <= 2) {\n      const s = q.side, d = DIR(s);\n      q.x = M.scrum.x - d * (4 + q.pos * 2 * (q.pos === 1 ? 0 : 1)); q.y = M.scrum.y + (q.pos - 1) * 14;\n      q.facing = s === 0 ? 0 : Math.PI;\n    }\n  }\n  SM.setPhase('scrum');\n  M.events.push({ t: 'scrum', x: M.scrum.x, y: M.scrum.y });\n};\n// the lineout: the throwing side, the pods (0 front, 1 middle, 2 back), contest by timing and HND\nSM.startLineout = function (x, y, thrower) {\n  const M = SM.M;\n  M.lineout = { x: SM.clamp(x, SM.X0 + 40, SM.X1 - 40), y: SM.clamp(y, SM.Y0 + 60, SM.Y1 - 60), thrower, t: 0, call: [null, null], pod: [1, 1], stolen: false, throwN: 0 };\n  M.ball.owner = null; M.ball.state = 'placed'; M.ball.x = M.lineout.x; M.ball.y = M.lineout.y; M.ball.z = 0;\n  SM.setPhase('lineout');\n  M.events.push({ t: 'lineout', x: M.lineout.x, y: M.lineout.y, thrower });\n};\n\n// the ruck: the ball on the ground, the tug of war, the result and the set-up for the next phase\nSM.startRuck = function (x, y, carrierSide, tackler) {\n  const M = SM.M;\n  M.ruck = { x: SM.clamp(x, SM.X0 - 10, SM.X1 + 10), y: SM.clamp(y, SM.Y0 + 10, SM.Y1 - 10), attack: carrierSide, bar: .2, t: 0, jackal: null, jackalAt: null };\n  M.ball.owner = null; M.ball.state = 'placed'; M.ball.x = M.ruck.x; M.ball.y = M.ruck.y; M.ball.z = 0; M.ball.vx = M.ball.vy = 0;\n  M.ball.lastTouch = carrierSide;\n  SM.setPhase('ruck');\n  M.events.push({ t: 'ruck', x: M.ruck.x, y: M.ruck.y });\n};\n\n// the referee's whistle at the end of the half: the stoppage that follows ends it\nSM.halfOver = function () {\n  const M = SM.M;\n  M.events.push({ t: 'halftime', half: M.half });\n  M.hooter = false;\n  if (M.half === 1) { M.half = 2; M.run = 0; M.phase = 'half'; M.pt = 0; M.tHalf = 2.5; }\n  else SM.fullTime();\n};\nSM.fullTime = function () {\n  const M = SM.M;\n  if (M.score[0] === M.score[1] && !M.golden && !M.attract) { M.golden = true; M.phase = 'play'; M.run = 0; M.events.push({ t: 'golden' }); SM.kickoff(0); return; }\n  M.over = true; M.phase = 'full'; M.pt = 0; M.events.push({ t: 'fulltime', score: M.score.slice() });\n};\n\n// the player's per-step, applied to the body; the rest is in the step functions below\nSM.stepPlayer = function (p, dt, input) {\n  const M = SM.M;\n  const d = DIR(p.side);\n  p.cool = Math.max(0, p.cool - dt); p.stunT = Math.max(0, (p.stunT || 0) - dt); p.evade = Math.max(0, p.evade - dt);\n  p.fendT = Math.max(0, p.fendT - dt); p.diveT = Math.max(0, p.diveT - dt); p.cheer = Math.max(0, p.cheer - dt);\n  p.tackleT = Math.max(0, p.tackleT - dt); p.mudT = Math.max(0, p.mudT - dt);\n  if (p.bin > 0) { p.bin = Math.max(0, p.bin - (M.phase === 'play' ? dt : 0)); if (p.bin === 0) p.st = 'run'; p.x = SM.lerp(p.x, SM.X0 - 60 + p.side * 0, .05); return; }\n  if (p.st === 'tackled' || p.st === 'ground' || p.st === 'stun' || p.st === 'down') {\n    p.stT = (p.stT || 0) - dt; p.vx *= .9; p.vy *= .9;\n    if (p.stT <= 0) { p.st = 'getUp'; p.stT = .5; }\n    return;\n  }\n  if (p.st === 'getUp') { p.stT -= dt; if (p.stT <= 0) p.st = 'run'; return; }\n  if (M.phase === 'scrum' || M.phase === 'lineout' || M.phase === 'ruck' || M.phase === 'kickoff' || M.phase === 'try' || M.phase === 'conv' || M.phase === 'penalty' || M.phase === 'half' || M.phase === 'full') {\n    // stoppages: formation spots, no movement of the kick-off's line until released\n    if (M.phase === 'kickoff' || M.phase === 'half' || M.phase === 'scrum' || M.phase === 'lineout' || M.phase === 'ruck') {\n      const spot = SM.stoppageSpot(p);\n      if (spot) { p.x = SM.lerp(p.x, spot[0], .25); p.y = SM.lerp(p.y, spot[1], .25); }\n    }\n    p.vx = p.vy = 0;\n    return;\n  }\n  // the human's intent or the CPU's brain; then the body\n  let it = input;\n  if (!it) { it = SM.brain(p, dt); }\n  const turboReq = !!(it.turbo) && p.turbo > 0 && !(M.cheatsInfiniteTurbo);\n  let speed = TUNE('runSpeed') * (.8 + .04 * p.stats.SPD) * (p.side === M.humanSide ? 1 : 1);\n  if (p.onFire) speed *= 1.1;\n  if (M.mud && M.venue.mud) for (const m of M.mud) if (dist(p.x, p.y, m.x, m.y) < m.r) { speed *= .8; p.mudT = .3; }\n  if (p.ballCarried > 0 || (M.ball.owner === p)) speed *= .96;\n  if (M.superT && M.superT[p.side] && M.ball.owner === p) speed *= 1.35;\n  if (p.evade > 0) speed *= 1.1;\n  if (turboReq || (M.cheatInfiniteTurbo)) {\n    speed *= TUNE('turboMult'); p.turbo = Math.max(0, p.turbo - dt);\n  } else if (!it.turbo) p.turbo = Math.min(TUNE('turboTank'), p.turbo + TUNE('turboRegen') * dt * 3);\n  if (p.onFire) p.turbo = TUNE('turboTank');\n  if (p.side === 0 && SM.CHEATS.infiniteTurbo || SM.CHEATS.infiniteTurbo) p.turbo = TUNE('turboTank');\n  if (p.side === 1 && p.bin > 0) return;\n  let mx = it.mx || 0, my = it.my || 0;\n  const L = Math.hypot(mx, my);\n  if (L > 1) { mx /= L; my /= L; }\n  const tvx = mx * speed, tvy = my * speed;\n  const acc = TUNE('runSpeed') * 8.5 * dt;   // acceleration in units/s\n  p.vx = SM.approach(p.vx, tvx, acc); p.vy = SM.approach(p.vy, tvy, acc);\n  if (p.evade > 0 && it.evadeDir) { p.vx += it.evadeDir[0] * 3; p.vy += it.evadeDir[1] * 3; }\n  p.x += p.vx * dt; p.y += p.vy * dt;\n  // the touch and the dead-ball line: players stay in the field of play and the in-goal\n  p.x = SM.clamp(p.x, SM.DL0 + 4, SM.DL1 - 4); p.y = SM.clamp(p.y, SM.Y0 - 14, SM.Y1 + 14);\n  const sp = Math.hypot(p.vx, p.vy);\n  if (sp > 4) p.facing = Math.atan2(p.vy, p.vx);\n  if (it.faceTo !== undefined) p.facing = it.faceTo;\n  if (p.fendT > 0 && it.fend) p.facing = p.facing;\n  p.turnTo = p.facing;\n  p.st = (p.st === 'run' && sp > 10) ? 'run' : 'run';\n};\nSM.approach = (v, target, step) => v < target ? Math.min(target, v + step) : Math.max(target, v - step);\nSM.stoppageSpot = function (p) {\n  const M = SM.M, shape = SM.shapeFor(p);\n  return shape;\n};\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":21060,"cache_read_input_tokens":165186,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":21060},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5f6aeda2-f9ed-42d4-a150-3a2efde4ea9e","uuid":"02232e1c-22e0-49f8-8e7e-1a7158a9cb85","timestamp":"2026-11-04T14:04:54.148Z","request_id":"req_011Cgi1hpwQkKYfyewRgiox8","wire_tool_inputs":{"toolu_017JRhpaYK7KfMhc21Q5q72M":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-070011__xa7e588/work/Smashby-Rugby-claude-haiku-5-5-medium-20261104-070011/src/10-sim.js","content":"// THE MATCH SIMULATION: rules, physics, contact, set pieces and the AI. It reads intents and writes match state; it\n// never draws. Seeded (SM.seed), fixed-step (the engine's update), and every number is read from SM.TUNE.v.\n// A human seat gives an intent per step: { mx, my (stick), turbo, pass ('up'|'down'|null), tackle (press), tackleHeld,\n// sidestep, fend, dive, kick (held), kickUp (released), superPress, mashPress, jackalPress, choose }.\nSM.M = null;   // the live match\nconst G = 600;            // the ball's gravity (units per second squared)\nconst DIR = s => s === 0 ? 1 : -1;   // side 0 attacks toward +x (the right of the screen), side 1 toward -x\nconst dist = (ax, ay, bx, by) => Math.hypot(ax - bx, ay - by);\nconst ANG = (a, b) => { let d = b - a; while (d > Math.PI) d -= 2 * Math.PI; while (d < -Math.PI) d += 2 * Math.PI; return d; };\nconst SIDE_OF = (teamIdx) => teamIdx;   // (a side is a team; the home team is side 0)\n\n// A player: the body, the stats, the state machine and the input (or none for an AI player)\nfunction makePlayer(side, pos, def, teamDef, idx) {\n  const [name, nick, role, build, size, hair, hairC, skin, hat, stats] = def;\n  return {\n    i: idx, side, pos, role, name, nick, build, size, hair, hairC, skin, hat,\n    stats: { SPD: stats[0], POW: stats[1], HND: stats[2], KCK: stats[3], TKL: stats[4] },\n    x: 0, y: 0, z: 0, vx: 0, vy: 0, facing: side ? Math.PI : 0,\n    st: 'run', stT: 0, cool: 0, turbo: 3, turboOn: false, evade: 0, spinT: 0, fendT: 0, diveT: 0, bigT: 0, bigHeld: false,\n    tackleT: 0, stunT: 0, bin: 0, onFire: false, cheer: 0, mudT: 0, jackalT: 0, lastSide: side,\n    input: null, aiT: 0, aiFor: 0, power: 0, kickHeld: 0, kickCharge: false,\n    team: teamDef, hitBy: null, ballCarried: 0, pieFx: 0, inPlay: true\n  };\n}\n\n// The venue's floor features and sky events (the mud, the wind, the lightning and the flame grates)\nfunction venueState(venue) {\n  const M = SM.M;\n  M.mud = []; M.grates = []; M.lightning = null; M.windT = 0; M.windDir = 0; M.wind = 0; M.clucky = 0;\n  if (venue.mud) for (let k = 0; k < 6; k++) M.mud.push({ x: SM.lerp(SM.X0 + 100, SM.X1 - 100, SM.fx()), y: SM.lerp(SM.Y0 + 60, SM.Y1 - 60, SM.fx()), r: 30 + SM.fx() * 30 });\n  if (venue.id === 'furnace') for (let k = 0; k < 8; k++) M.grates.push({ x: SM.lerp(SM.X0 + 100, SM.X1 - 100, k / 7), y: SM.Y0 + 20, phase: 0, t: 0 }, { x: SM.lerp(SM.X0 + 100, SM.X1 - 100, k / 7), y: SM.Y1 - 20, phase: 0, t: 0 });\n}\n\n// Build a match. o: { home, away (team indices), venue (venue index), halves (seconds per half), humans:[{ input, side, pos }], attract, cup, seed }\nSM.newMatch = function (o) {\n  SM.seed(o.seed || 1);\n  const venue = SM.VENUES[o.venue || 0];\n  const teams = [SM.TEAMS[o.home || 0], SM.TEAMS[o.away || 1]];\n  const M = {\n    teams, venue, half: 1, run: 0, halfLen: o.halves || SM.TUNE.v.halfLength, phase: 'kickoff', pt: 0, score: [0, 0], hype: [0, 0],\n    players: [], ball: null, hooter: false, golden: false, over: false, attract: !!o.attract, cup: !!o.cup, stats: [{ tries: 0, tackles: 0, missed: 0, bigHits: 0, monster: 0, metres: 0, breaks: 0, turnovers: 0, cards: 0, poss: 0, terr: 0, passes: 0, kicks: 0 }, { tries: 0, tackles: 0, missed: 0, bigHits: 0, monster: 0, metres: 0, breaks: 0, turnovers: 0, cards: 0, poss: 0, terr: 0, passes: 0, kicks: 0 }],\n    events: [], ruck: null, scrum: null, lineout: null, pen: null, conv: null, tryStreak: [null, null], lastTry: [0, 0], lastTouch: 0,\n    kickSide: 0, kickT: 0, dropAt: null, powerups: [], powerupT: 25, pickup: null, humanSeats: [], refX: 0, refY: 0, ruckWon: 0,\n    clock: 0, lastScorer: null, goalKick: null, flight: null, t: 0, banner: null, bannerT: 0, passCount: 0, rulesLog: [],\n    sinBinned: [0, 0], pos: null, fail: null\n  };\n  SM.M = M;\n  venueState(venue);\n  // the players: seven a side, in their formation order\n  for (let s = 0; s < 2; s++) {\n    teams[s].players.forEach((def, k) => {\n      const p = makePlayer(s, k, def, teams[s], s * 7 + k);\n      p.body = new My3D2dge.Body({ x: 0, y: 0, r: 5, friction: 0, gravity: 0 });\n      p.rig = new My3D2dge.Humanoid({ size: p.size, build: p.build, hair: p.hair === 'bald' ? 'bald' : p.hair, weapon: null, hat: p.hat === 'none' ? undefined : p.hat,\n        colors: Object.assign({ cloth: teams[s].colors.cloth, trim: teams[s].colors.trim, pants: teams[s].colors.pants, boot: teams[s].colors.boot, belt: teams[s].colors.belt, hair: p.hairC, skin: p.skin }, s === 1 && teams[s].away ? teams[s].away : {}) });\n      M.players.push(p);\n    });\n  }\n  // the referee walks the pitch behind play; the commentators are the presentation's business\n  M.ball = { x: SM.CX, y: SM.CY, z: 0, vx: 0, vy: 0, vz: 0, state: 'placed', owner: null, lastTouch: 0, kickBy: null, spin: 0, roll: 0, bounce: 0, flightTo: null, ready: 0 };\n  // seats: humans get their player (the first forward of side 0 unless given)\n  if (o.humans) for (const h of o.humans) {\n    const p = M.players.find(q => q.side === h.side && q.pos === h.pos);\n    if (p) { p.input = h.input; M.humanSeats.push(p); }\n  }\n  // the cheats of the dev panel: every cheat is read in the sim, never stored in the tuning\n  SM.kickoff(0);\n  return M;\n};\n\n// the formation spots: a kickoff (the kicking side kicks from the centre) and the in-play shape\nSM.kickoff = function (kickSide) {\n  const M = SM.M;\n  M.phase = 'kickoff'; M.pt = 0; M.kickSide = kickSide; M.kickT = 1.4;\n  M.ball.owner = null; M.ball.state = 'placed'; M.ball.x = SM.CX; M.ball.y = SM.CY; M.ball.z = 0; M.ball.vx = M.ball.vy = M.ball.vz = 0;\n  for (const p of M.players) {\n    if (p.bin > 0) continue;\n    const d = DIR(p.side), k = p.pos;\n    if (p.side === kickSide) {\n      const fh = k === 4;\n      p.x = fh ? SM.CX - d * 6 : SM.CX - d * (50 + k * 10); p.y = fh ? SM.CY : SM.CY + (k % 2 ? 30 : -30) + (k - 3) * 6;\n    } else {\n      p.x = SM.CX + d * (140 + (k % 3) * 25); p.y = SM.CY + (k - 3) * 52;\n    }\n    p.y = SM.clamp(p.y, SM.Y0 + 14, SM.Y1 - 14); p.vx = p.vy = 0; p.facing = p.side ? Math.PI : 0; p.st = 'run'; p.stT = 0; p.evade = p.fendT = p.diveT = 0;\n  }\n  M.events.push({ t: 'kickoff', side: kickSide });\n};\n\n// the spot a player wants this step. With the ball (side in possession): the attack shape behind the carrier; without\n// it: the nearest two chase the ball, the rest hold the defensive line in front of their attackers.\nSM.shapeFor = function (p) {\n  const M = SM.M, b = M.ball, d = DIR(p.side), inPos = M.ball.owner && M.ball.owner.side === p.side;\n  const attacking = inPos || (M.ball.state === 'loose' && M.ball.lastTouch === p.side);\n  const bx = b.x, by = b.y;\n  if (attacking) {\n    const slots = [[-14, -26], [-8, 0], [-14, 26], [-22, 0], [-42, 0], [-60, -24], [-84, -54]];\n    const s = slots[p.pos];\n    let tx = bx + d * s[0], ty = by + s[1];\n    // the backs spread, and never stand in front of the carrier\n    if (M.ball.owner && M.ball.owner === p) { tx = bx; ty = by; }\n    if (p.pos >= 5 && M.ball.owner && M.ball.owner.side === p.side) tx = Math.min(tx, bx - d * 6) * (d > 0 ? 1 : 1);\n    return [SM.clamp(tx, SM.X0 - 40, SM.X1 + 40), SM.clamp(ty, SM.Y0 + 14, SM.Y1 - 14)];\n  }\n  // defending: the defensive line, each man paired with an attacker by y\n  const atk = M.players.filter(q => q.side !== p.side && q.bin <= 0).sort((a, b2) => a.y - b2.y);\n  const mine = M.players.filter(q => q.side === p.side && q.bin <= 0).sort((a, b2) => a.y - b2.y);\n  const rank = mine.indexOf(p);\n  const target = atk[Math.min(atk.length - 1, Math.max(0, rank))];\n  if (!target) return [bx, by];\n  const dd = DIR(target.side);\n  // the defender in front of his man, toward the goal he is defending\n  return [SM.clamp(target.x + dd * 28, SM.X0 - 30, SM.X1 + 30), SM.clamp(target.y, SM.Y0 + 14, SM.Y1 - 14)];\n};\n\n// kicks: a ball flight with the apex height given; the horizontal speed lands it at tx, ty\nSM.kickFlight = function (fromX, fromY, tx, ty, apex, kind) {\n  const b = SM.M.ball, dx = tx - fromX, dy = ty - fromY, d = Math.hypot(dx, dy) || 1;\n  const vz = Math.sqrt(2 * G * apex), T = 2 * vz / G, sp = d / T;\n  b.x = fromX; b.y = fromY; b.z = 8; b.vx = dx / d * sp; b.vy = dy / d * sp; b.vz = vz;\n  b.state = 'air'; b.owner = null; b.kind = kind; b.spin = 0; b.flightTo = [tx, ty];\n};\n\n// pass: the ball to the receiver's predicted spot, with a low arc (catch by reach)\nSM.passTo = function (p, recv) {\n  const b = SM.M.ball, T = TUNE('passSpeed');\n  const d = dist(p.x, p.y, recv.x, recv.y), t = d / T;\n  const tx = recv.x + recv.vx * t * .8, ty = recv.y + recv.vy * t * .8;\n  const dx = tx - p.x, dy = ty - p.y, L = Math.hypot(dx, dy) || 1;\n  b.x = p.x + dx / L * 8; b.y = p.y + dy / L * 8; b.z = 10;\n  b.vx = dx / L * T; b.vy = dy / L * T; b.vz = 0; b.state = 'pass'; b.owner = null; b.kind = 'pass'; b.passer = p; b.receiver = recv;\n  b.lastTouch = p.side; M.stats = M.stats; SM.M.stats[p.side].passes++; SM.M.passCount++;\n  p.cool = .12; p.kickCharge = false;\n};\n\nconst TUNE = k => SM.TUNE.v[k];\n\n// the referee: a sight cone, behind the ball on the attack side\nSM.refSees = function (p) {\n  const M = SM.M;\n  if (SM.CHEATS.refBlind) return false;\n  if (SM.CHEATS.refStrict) return true;\n  const rx = M.refX, ry = M.refY, dx = p.x - rx, dy = p.y - ry, d = Math.hypot(dx, dy);\n  if (d > TUNE('refRange') || d < 1) return d < 1;\n  const facing = Math.atan2(M.ball.y - ry, M.ball.x - rx);\n  return Math.abs(ANG(facing, Math.atan2(dy, dx))) < 1.4 / 2 + .4;\n};\n\n// the whistle: a foul by side `offender` (its player), a penalty to the other side at the spot\nSM.foul = function (kind, offender, x, y, seenOnly) {\n  const M = SM.M;\n  const seen = seenOnly ? SM.refSees(offender) : true;\n  M.stats[offender.side].cards += 0;\n  if (!seen) { M.events.push({ t: 'unseen', kind }); M.hype[1 - offender.side] += 0; return; }\n  M.events.push({ t: 'foul', kind, side: offender.side });\n  const pen = M.pen = { side: 1 - offender.side, x: SM.clamp(x, SM.X0 + 10, SM.X1 - 10), y: SM.clamp(y, SM.Y0 + 10, SM.Y1 - 10), kind, player: offender };\n  SM.setPhase('penalty');\n  pen.card = kind === 'cheap' || kind === 'high';\n  if (pen.card) SM.sendOff(offender);\n};\n\n// a yellow card: the sin bin for sinBin seconds of play\nSM.sendOff = function (p) {\n  const M = SM.M;\n  p.bin = TUNE('sinBin'); p.st = 'bin'; p.input = null;\n  M.stats[p.side].cards++;\n  M.events.push({ t: 'yellow', side: p.side, name: p.nick });\n  M.sinBinned[p.side] = (M.sinBinned[p.side] || 0) + 1;\n  if (M.ball.owner === p) SM.dropBall(p);\n};\n\nSM.setPhase = function (name) {\n  const M = SM.M;\n  if (M.phase === name) return;\n  if (name !== 'play' && M.hooter && M.phase === 'play') { M.phase = name; SM.halfOver(); return; }\n  M.phase = name; M.pt = 0; M.events.push({ t: 'phase', name });\n};\n\nSM.dropBall = function (p) {\n  const M = SM.M, b = M.ball;\n  if (b.owner !== p) return;\n  b.owner = null; b.state = 'loose'; b.x = p.x + Math.cos(p.facing) * 8; b.y = p.y + Math.sin(p.facing) * 8; b.z = 6;\n  b.vx = Math.cos(p.facing) * 60; b.vy = Math.sin(p.facing) * 60; b.vz = 40; b.lastTouch = p.side; b.bounce = 0;\n  b.droppedBy = p;\n};\n\n// the try: the carrier in the in-goal; the points, the hype and the conversion\nSM.tryScored = function (p) {\n  const M = SM.M, s = p.side, d = DIR(s);\n  const tx = p.x, ty = p.y;\n  M.score[s] += 5; M.stats[s].tries++; M.hype[s] = Math.min(100, M.hype[s] + 15 * TUNE('hypeMult'));\n  M.lastScorer = p; M.events.push({ t: 'try', side: s, name: p.nick, x: tx, y: ty });\n  // on fire: two tries in a row by one player\n  if (M.lastTry[s] === p.i) { p.onFire = true; M.events.push({ t: 'onFire', name: p.nick }); }\n  M.lastTry[s] = p.i; M.lastTry[1 - s] = -1; if (M.lastTry[1 - s] !== -1) { /* (the other side's last try is kept) */ }\n  for (const q of M.players) if (q.side !== s) q.onFire = false;\n  M.ball.owner = null; M.ball.state = 'placed'; M.ball.x = tx; M.ball.y = ty; M.ball.z = 0;\n  SM.setPhase('try'); M.tryT = 3; M.conv = { side: s, x: tx, y: ty, kicker: M.players.find(q => q.side === s && q.pos === 4), t: 0 };\n};\n\n// the conversion: a kick at the posts from the try spot; a real power meter for the human, a roll for the CPU\nSM.startConversion = function () {\n  const M = SM.M, c = M.conv, s = c.side, d = DIR(s), postX = s === 0 ? SM.POST1 : SM.POST0;\n  c.postX = postX; c.dist = Math.abs(postX - c.x); c.kicker = M.players.find(q => q.side === s && q.pos === 4) || M.players.find(q => q.side === s);\n  c.kicker.x = c.x - d * (c.dist < 140 ? 8 : 24); c.kicker.y = c.y; c.kicker.facing = s === 0 ? 0 : Math.PI;\n  c.meter = 0; c.up = true; c.aim = 0; c.decided = false; c.human = c.kicker.input || null;\n  SM.setPhase('conv');\n};\n\n// the scores: the kick's outcome is decided by the meter (human) or by the kicker's stats (CPU)\nSM.decideKick = function (power, aim, kind) {\n  const M = SM.M, c = M.conv, need = SM.clamp(c.dist / TUNE('kickMax') / 1.5, .2, .95);\n  const k = c.kicker;\n  let acc;\n  if (power === null) {                          // the CPU: its own kicking stat and a roll\n    const err = (10 - k.stats.KCK) * .02 + SM.R() * .05;\n    acc = Math.abs(err) < .1 ? 1 : 0;\n  } else acc = (Math.abs(power - need) < .07 && Math.abs(aim) < .35) ? 1 : 0;\n  const s = c.side;\n  if (acc) {\n    M.score[s] += kind === 'drop' ? 3 : kind === 'pen' ? 3 : 2;\n    M.events.push({ t: 'goal', side: s, kind, name: k.nick });\n    M.hype[s] = Math.min(100, M.hype[s] + 5 * TUNE('hypeMult'));\n    if (M.golden) return SM.fullTime();\n    SM.kickoff(s);\n  } else {\n    M.events.push({ t: 'miss', side: s, kind });\n    SM.dropOut(1 - s);\n  }\n};\n\n// a 22 drop-out: from the dead-ball line in the defenders' 22\nSM.dropOut = function (side) {\n  const M = SM.M, d = DIR(side), x = side === 0 ? SM.X0 + 225 : SM.X1 - 225;\n  M.ball.owner = null; M.ball.state = 'placed'; M.ball.x = x; M.ball.y = SM.CY; M.ball.z = 0; M.ball.vx = M.ball.vy = M.ball.vz = 0;\n  const pl = M.players.filter(q => q.side === side && q.bin <= 0).sort((a, b) => dist(a.x, a.y, x, SM.CY) - dist(b.x, b.y, x, SM.CY))[0];\n  if (pl) { pl.x = x - d * 8; pl.y = SM.CY; pl.facing = side === 0 ? 0 : Math.PI; M.ball.owner = pl; M.ball.state = 'held'; }\n  SM.setPhase('play'); M.events.push({ t: 'dropOut', side });\n};\n\n// a scrum at (x, y): the forwards bind, the feeding side (the team not at fault) wins the ball by a timed push\nSM.startScrum = function (x, y, feedSide) {\n  const M = SM.M;\n  M.scrum = { x: SM.clamp(x, SM.X0 + 60, SM.X1 - 60), y: SM.clamp(y, SM.Y0 + 60, SM.Y1 - 60), feed: feedSide, t: 0, set: 0, pressed: null, push: [0, 0] };\n  M.ball.owner = null; M.ball.state = 'placed';\n  M.ball.x = M.scrum.x; M.ball.y = M.scrum.y; M.ball.z = 0;\n  for (const q of M.players) {\n    if (q.bin > 0) continue;\n    if (q.pos <= 2) {\n      const s = q.side, d = DIR(s);\n      q.x = M.scrum.x - d * (4 + q.pos * 2 * (q.pos === 1 ? 0 : 1)); q.y = M.scrum.y + (q.pos - 1) * 14;\n      q.facing = s === 0 ? 0 : Math.PI;\n    }\n  }\n  SM.setPhase('scrum');\n  M.events.push({ t: 'scrum', x: M.scrum.x, y: M.scrum.y });\n};\n// the lineout: the throwing side, the pods (0 front, 1 middle, 2 back), contest by timing and HND\nSM.startLineout = function (x, y, thrower) {\n  const M = SM.M;\n  M.lineout = { x: SM.clamp(x, SM.X0 + 40, SM.X1 - 40), y: SM.clamp(y, SM.Y0 + 60, SM.Y1 - 60), thrower, t: 0, call: [null, null], pod: [1, 1], stolen: false, throwN: 0 };\n  M.ball.owner = null; M.ball.state = 'placed'; M.ball.x = M.lineout.x; M.ball.y = M.lineout.y; M.ball.z = 0;\n  SM.setPhase('lineout');\n  M.events.push({ t: 'lineout', x: M.lineout.x, y: M.lineout.y, thrower });\n};\n\n// the ruck: the ball on the ground, the tug of war, the result and the set-up for the next phase\nSM.startRuck = function (x, y, carrierSide, tackler) {\n  const M = SM.M;\n  M.ruck = { x: SM.clamp(x, SM.X0 - 10, SM.X1 + 10), y: SM.clamp(y, SM.Y0 + 10, SM.Y1 - 10), attack: carrierSide, bar: .2, t: 0, jackal: null, jackalAt: null };\n  M.ball.owner = null; M.ball.state = 'placed'; M.ball.x = M.ruck.x; M.ball.y = M.ruck.y; M.ball.z = 0; M.ball.vx = M.ball.vy = 0;\n  M.ball.lastTouch = carrierSide;\n  SM.setPhase('ruck');\n  M.events.push({ t: 'ruck', x: M.ruck.x, y: M.ruck.y });\n};\n\n// the referee's whistle at the end of the half: the stoppage that follows ends it\nSM.halfOver = function () {\n  const M = SM.M;\n  M.events.push({ t: 'halftime', half: M.half });\n  M.hooter = false;\n  if (M.half === 1) { M.half = 2; M.run = 0; M.phase = 'half'; M.pt = 0; M.tHalf = 2.5; }\n  else SM.fullTime();\n};\nSM.fullTime = function () {\n  const M = SM.M;\n  if (M.score[0] === M.score[1] && !M.golden && !M.attract) { M.golden = true; M.phase = 'play'; M.run = 0; M.events.push({ t: 'golden' }); SM.kickoff(0); return; }\n  M.over = true; M.phase = 'full'; M.pt = 0; M.events.push({ t: 'fulltime', score: M.score.slice() });\n};\n\n// the player's per-step, applied to the body; the rest is in the step functions below\nSM.stepPlayer = function (p, dt, input) {\n  const M = SM.M;\n  const d = DIR(p.side);\n  p.cool = Math.max(0, p.cool - dt); p.stunT = Math.max(0, (p.stunT || 0) - dt); p.evade = Math.max(0, p.evade - dt);\n  p.fendT = Math.max(0, p.fendT - dt); p.diveT = Math.max(0, p.diveT - dt); p.cheer = Math.max(0, p.cheer - dt);\n  p.tackleT = Math.max(0, p.tackleT - dt); p.mudT = Math.max(0, p.mudT - dt);\n  if (p.bin > 0) { p.bin = Math.max(0, p.bin - (M.phase === 'play' ? dt : 0)); if (p.bin === 0) p.st = 'run'; p.x = SM.lerp(p.x, SM.X0 - 60 + p.side * 0, .05); return; }\n  if (p.st === 'tackled' || p.st === 'ground' || p.st === 'stun' || p.st === 'down') {\n    p.stT = (p.stT || 0) - dt; p.vx *= .9; p.vy *= .9;\n    if (p.stT <= 0) { p.st = 'getUp'; p.stT = .5; }\n    return;\n  }\n  if (p.st === 'getUp') { p.stT -= dt; if (p.stT <= 0) p.st = 'run'; return; }\n  if (M.phase === 'scrum' || M.phase === 'lineout' || M.phase === 'ruck' || M.phase === 'kickoff' || M.phase === 'try' || M.phase === 'conv' || M.phase === 'penalty' || M.phase === 'half' || M.phase === 'full') {\n    // stoppages: formation spots, no movement of the kick-off's line until released\n    if (M.phase === 'kickoff' || M.phase === 'half' || M.phase === 'scrum' || M.phase === 'lineout' || M.phase === 'ruck') {\n      const spot = SM.stoppageSpot(p);\n      if (spot) { p.x = SM.lerp(p.x, spot[0], .25); p.y = SM.lerp(p.y, spot[1], .25); }\n    }\n    p.vx = p.vy = 0;\n    return;\n  }\n  // the human's intent or the CPU's brain; then the body\n  let it = input;\n  if (!it) { it = SM.brain(p, dt); }\n  const turboReq = !!(it.turbo) && p.turbo > 0 && !(M.cheatsInfiniteTurbo);\n  let speed = TUNE('runSpeed') * (.8 + .04 * p.stats.SPD) * (p.side === M.humanSide ? 1 : 1);\n  if (p.onFire) speed *= 1.1;\n  if (M.mud && M.venue.mud) for (const m of M.mud) if (dist(p.x, p.y, m.x, m.y) < m.r) { speed *= .8; p.mudT = .3; }\n  if (p.ballCarried > 0 || (M.ball.owner === p)) speed *= .96;\n  if (M.superT && M.superT[p.side] && M.ball.owner === p) speed *= 1.35;\n  if (p.evade > 0) speed *= 1.1;\n  if (turboReq || (M.cheatInfiniteTurbo)) {\n    speed *= TUNE('turboMult'); p.turbo = Math.max(0, p.turbo - dt);\n  } else if (!it.turbo) p.turbo = Math.min(TUNE('turboTank'), p.turbo + TUNE('turboRegen') * dt * 3);\n  if (p.onFire) p.turbo = TUNE('turboTank');\n  if (p.side === 0 && SM.CHEATS.infiniteTurbo || SM.CHEATS.infiniteTurbo) p.turbo = TUNE('turboTank');\n  if (p.side === 1 && p.bin > 0) return;\n  let mx = it.mx || 0, my = it.my || 0;\n  const L = Math.hypot(mx, my);\n  if (L > 1) { mx /= L; my /= L; }\n  const tvx = mx * speed, tvy = my * speed;\n  const acc = TUNE('runSpeed') * 8.5 * dt;   // acceleration in units/s\n  p.vx = SM.approach(p.vx, tvx, acc); p.vy = SM.approach(p.vy, tvy, acc);\n  if (p.evade > 0 && it.evadeDir) { p.vx += it.evadeDir[0] * 3; p.vy += it.evadeDir[1] * 3; }\n  p.x += p.vx * dt; p.y += p.vy * dt;\n  // the touch and the dead-ball line: players stay in the field of play and the in-goal\n  p.x = SM.clamp(p.x, SM.DL0 + 4, SM.DL1 - 4); p.y = SM.clamp(p.y, SM.Y0 - 14, SM.Y1 + 14);\n  const sp = Math.hypot(p.vx, p.vy);\n  if (sp > 4) p.facing = Math.atan2(p.vy, p.vx);\n  if (it.faceTo !== undefined) p.facing = it.faceTo;\n  if (p.fendT > 0 && it.fend) p.facing = p.facing;\n  p.turnTo = p.facing;\n  p.st = (p.st === 'run' && sp > 10) ? 'run' : 'run';\n};\nSM.approach = (v, target, step) => v < target ? Math.min(target, v + step) : Math.max(target, v - step);\nSM.stoppageSpot = function (p) {\n  const M = SM.M, shape = SM.shapeFor(p);\n  return shape;\n};\n"}}}
{"type":"rate_limit_event","rate_limit_info":{"status":"allowed_warning","resetsAt":1794398400,"rateLimitType":"seven_day","utilization":0.35,"overageStatus":"rejected","overageDisabledReason":"org_level_disabled","isUsingOverage":false,"unifiedWindows":{"seven_day":{"utilization":0.35,"resetsAt":1794398400,"status":"allowed"}},"overageEnabled":false},"uuid":"bbcd06ec-5b68-4958-afec-4ec56796af38","session_id":"5f6aeda2-f9ed-42d4-a150-3a2efde4ea9e"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017JRhpaYK7KfMhc21Q5q72M","type":"tool_result","content":"File created successfully at: /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-070011__xa7e588/work/Smashby-Rugby-claude-haiku-5-5-medium-20261104-070011/src/10-sim.js (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"5f6aeda2-f9ed-42d4-a150-3a2efde4ea9e","uuid":"225c5e45-0109-434c-b93f-688580de588b","timestamp":"2026-11-04T14:04:54.185Z","tool_use_result":{"type":"create","filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-070011__xa7e588/work/Smashby-Rugby-claude-haiku-5-5-medium-20261104-070011/src/10-sim.js","content":"// THE MATCH SIMULATION: rules, physics, contact, set pieces and the AI. It reads intents and writes match state; it\n// never draws. Seeded (SM.seed), fixed-step (the engine's update), and every number is read from SM.TUNE.v.\n// A human seat gives an intent per step: { mx, my (stick), turbo, pass ('up'|'down'|null), tackle (press), tackleHeld,\n// sidestep, fend, dive, kick (held), kickUp (released), superPress, mashPress, jackalPress, choose }.\nSM.M = null;   // the live match\nconst G = 600;            // the ball's gravity (units per second squared)\nconst DIR = s => s === 0 ? 1 : -1;   // side 0 attacks toward +x (the right of the screen), side 1 toward -x\nconst dist = (ax, ay, bx, by) => Math.hypot(ax - bx, ay - by);\nconst ANG = (a, b) => { let d = b - a; while (d > Math.PI) d -= 2 * Math.PI; while (d < -Math.PI) d += 2 * Math.PI; return d; };\nconst SIDE_OF = (teamIdx) => teamIdx;   // (a side is a team; the home team is side 0)\n\n// A player: the body, the stats, the state machine and the input (or none for an AI player)\nfunction makePlayer(side, pos, def, teamDef, idx) {\n  const [name, nick, role, build, size, hair, hairC, skin, hat, stats] = def;\n  return {\n    i: idx, side, pos, role, name, nick, build, size, hair, hairC, skin, hat,\n    stats: { SPD: stats[0], POW: stats[1], HND: stats[2], KCK: stats[3], TKL: stats[4] },\n    x: 0, y: 0, z: 0, vx: 0, vy: 0, facing: side ? Math.PI : 0,\n    st: 'run', stT: 0, cool: 0, turbo: 3, turboOn: false, evade: 0, spinT: 0, fendT: 0, diveT: 0, bigT: 0, bigHeld: false,\n    tackleT: 0, stunT: 0, bin: 0, onFire: false, cheer: 0, mudT: 0, jackalT: 0, lastSide: side,\n    input: null, aiT: 0, aiFor: 0, power: 0, kickHeld: 0, kickCharge: false,\n    team: teamDef, hitBy: null, ballCarried: 0, pieFx: 0, inPlay: true\n  };\n}\n\n// The venue's floor features and sky events (the mud, the wind, the lightning and the flame grates)\nfunction venueState(venue) {\n  const M = SM.M;\n  M.mud = []; M.grates = []; M.lightning = null; M.windT = 0; M.windDir = 0; M.wind = 0; M.clucky = 0;\n  if (venue.mud) for (let k = 0; k < 6; k++) M.mud.push({ x: SM.lerp(SM.X0 + 100, SM.X1 - 100, SM.fx()), y: SM.lerp(SM.Y0 + 60, SM.Y1 - 60, SM.fx()), r: 30 + SM.fx() * 30 });\n  if (venue.id === 'furnace') for (let k = 0; k < 8; k++) M.grates.push({ x: SM.lerp(SM.X0 + 100, SM.X1 - 100, k / 7), y: SM.Y0 + 20, phase: 0, t: 0 }, { x: SM.lerp(SM.X0 + 100, SM.X1 - 100, k / 7), y: SM.Y1 - 20, phase: 0, t: 0 });\n}\n\n// Build a match. o: { home, away (team indices), venue (venue index), halves (seconds per half), humans:[{ input, side, pos }], attract, cup, seed }\nSM.newMatch = function (o) {\n  SM.seed(o.seed || 1);\n  const venue = SM.VENUES[o.venue || 0];\n  const teams = [SM.TEAMS[o.home || 0], SM.TEAMS[o.away || 1]];\n  const M = {\n    teams, venue, half: 1, run: 0, halfLen: o.halves || SM.TUNE.v.halfLength, phase: 'kickoff', pt: 0, score: [0, 0], hype: [0, 0],\n    players: [], ball: null, hooter: false, golden: false, over: false, attract: !!o.attract, cup: !!o.cup, stats: [{ tries: 0, tackles: 0, missed: 0, bigHits: 0, monster: 0, metres: 0, breaks: 0, turnovers: 0, cards: 0, poss: 0, terr: 0, passes: 0, kicks: 0 }, { tries: 0, tackles: 0, missed: 0, bigHits: 0, monster: 0, metres: 0, breaks: 0, turnovers: 0, cards: 0, poss: 0, terr: 0, passes: 0, kicks: 0 }],\n    events: [], ruck: null, scrum: null, lineout: null, pen: null, conv: null, tryStreak: [null, null], lastTry: [0, 0], lastTouch: 0,\n    kickSide: 0, kickT: 0, dropAt: null, powerups: [], powerupT: 25, pickup: null, humanSeats: [], refX: 0, refY: 0, ruckWon: 0,\n    clock: 0, lastScorer: null, goalKick: null, flight: null, t: 0, banner: null, bannerT: 0, passCount: 0, rulesLog: [],\n    sinBinned: [0, 0], pos: null, fail: null\n  };\n  SM.M = M;\n  venueState(venue);\n  // the players: seven a side, in their formation order\n  for (let s = 0; s < 2; s++) {\n    teams[s].players.forEach((def, k) => {\n      const p = makePlayer(s, k, def, teams[s], s * 7 + k);\n      p.body = new My3D2dge.Body({ x: 0, y: 0, r: 5, friction: 0, gravity: 0 });\n      p.rig = new My3D2dge.Humanoid({ size: p.size, build: p.build, hair: p.hair === 'bald' ? 'bald' : p.hair, weapon: null, hat: p.hat === 'none' ? undefined : p.hat,\n        colors: Object.assign({ cloth: teams[s].colors.cloth, trim: teams[s].colors.trim, pants: teams[s].colors.pants, boot: teams[s].colors.boot, belt: teams[s].colors.belt, hair: p.hairC, skin: p.skin }, s === 1 && teams[s].away ? teams[s].away : {}) });\n      M.players.push(p);\n    });\n  }\n  // the referee walks the pitch behind play; the commentators are the presentation's business\n  M.ball = { x: SM.CX, y: SM.CY, z: 0, vx: 0, vy: 0, vz: 0, state: 'placed', owner: null, lastTouch: 0, kickBy: null, spin: 0, roll: 0, bounce: 0, flightTo: null, ready: 0 };\n  // seats: humans get their player (the first forward of side 0 unless given)\n  if (o.humans) for (const h of o.humans) {\n    const p = M.players.find(q => q.side === h.side && q.pos === h.pos);\n    if (p) { p.input = h.input; M.humanSeats.push(p); }\n  }\n  // the cheats of the dev panel: every cheat is read in the sim, never stored in the tuning\n  SM.kickoff(0);\n  return M;\n};\n\n// the formation spots: a kickoff (the kicking side kicks from the centre) and the in-play shape\nSM.kickoff = function (kickSide) {\n  const M = SM.M;\n  M.phase = 'kickoff'; M.pt = 0; M.kickSide = kickSide; M.kickT = 1.4;\n  M.ball.owner = null; M.ball.state = 'placed'; M.ball.x = SM.CX; M.ball.y = SM.CY; M.ball.z = 0; M.ball.vx = M.ball.vy = M.ball.vz = 0;\n  for (const p of M.players) {\n    if (p.bin > 0) continue;\n    const d = DIR(p.side), k = p.pos;\n    if (p.side === kickSide) {\n      const fh = k === 4;\n      p.x = fh ? SM.CX - d * 6 : SM.CX - d * (50 + k * 10); p.y = fh ? SM.CY : SM.CY + (k % 2 ? 30 : -30) + (k - 3) * 6;\n    } else {\n      p.x = SM.CX + d * (140 + (k % 3) * 25); p.y = SM.CY + (k - 3) * 52;\n    }\n    p.y = SM.clamp(p.y, SM.Y0 + 14, SM.Y1 - 14); p.vx = p.vy = 0; p.facing = p.side ? Math.PI : 0; p.st = 'run'; p.stT = 0; p.evade = p.fendT = p.diveT = 0;\n  }\n  M.events.push({ t: 'kickoff', side: kickSide });\n};\n\n// the spot a player wants this step. With the ball (side in possession): the attack shape behind the carrier; without\n// it: the nearest two chase the ball, the rest hold the defensive line in front of their attackers.\nSM.shapeFor = function (p) {\n  const M = SM.M, b = M.ball, d = DIR(p.side), inPos = M.ball.owner && M.ball.owner.side === p.side;\n  const attacking = inPos || (M.ball.state === 'loose' && M.ball.lastTouch === p.side);\n  const bx = b.x, by = b.y;\n  if (attacking) {\n    const slots = [[-14, -26], [-8, 0], [-14, 26], [-22, 0], [-42, 0], [-60, -24], [-84, -54]];\n    const s = slots[p.pos];\n    let tx = bx + d * s[0], ty = by + s[1];\n    // the backs spread, and never stand in front of the carrier\n    if (M.ball.owner && M.ball.owner === p) { tx = bx; ty = by; }\n    if (p.pos >= 5 && M.ball.owner && M.ball.owner.side === p.side) tx = Math.min(tx, bx - d * 6) * (d > 0 ? 1 : 1);\n    return [SM.clamp(tx, SM.X0 - 40, SM.X1 + 40), SM.clamp(ty, SM.Y0 + 14, SM.Y1 - 14)];\n  }\n  // defending: the defensive line, each man paired with an attacker by y\n  const atk = M.players.filter(q => q.side !== p.side && q.bin <= 0).sort((a, b2) => a.y - b2.y);\n  const mine = M.players.filter(q => q.side === p.side && q.bin <= 0).sort((a, b2) => a.y - b2.y);\n  const rank = mine.indexOf(p);\n  const target = atk[Math.min(atk.length - 1, Math.max(0, rank))];\n  if (!target) return [bx, by];\n  const dd = DIR(target.side);\n  // the defender in front of his man, toward the goal he is defending\n  return [SM.clamp(target.x + dd * 28, SM.X0 - 30, SM.X1 + 30), SM.clamp(target.y, SM.Y0 + 14, SM.Y1 - 14)];\n};\n\n// kicks: a ball flight with the apex height given; the horizontal speed lands it at tx, ty\nSM.kickFlight = function (fromX, fromY, tx, ty, apex, kind) {\n  const b = SM.M.ball, dx = tx - fromX, dy = ty - fromY, d = Math.hypot(dx, dy) || 1;\n  const vz = Math.sqrt(2 * G * apex), T = 2 * vz / G, sp = d / T;\n  b.x = fromX; b.y = fromY; b.z = 8; b.vx = dx / d * sp; b.vy = dy / d * sp; b.vz = vz;\n  b.state = 'air'; b.owner = null; b.kind = kind; b.spin = 0; b.flightTo = [tx, ty];\n};\n\n// pass: the ball to the receiver's predicted spot, with a low arc (catch by reach)\nSM.passTo = function (p, recv) {\n  const b = SM.M.ball, T = TUNE('passSpeed');\n  const d = dist(p.x, p.y, recv.x, recv.y), t = d / T;\n  const tx = recv.x + recv.vx * t * .8, ty = recv.y + recv.vy * t * .8;\n  const dx = tx - p.x, dy = ty - p.y, L = Math.hypot(dx, dy) || 1;\n  b.x = p.x + dx / L * 8; b.y = p.y + dy / L * 8; b.z = 10;\n  b.vx = dx / L * T; b.vy = dy / L * T; b.vz = 0; b.state = 'pass'; b.owner = null; b.kind = 'pass'; b.passer = p; b.receiver = recv;\n  b.lastTouch = p.side; M.stats = M.stats; SM.M.stats[p.side].passes++; SM.M.passCount++;\n  p.cool = .12; p.kickCharge = false;\n};\n\nconst TUNE = k => SM.TUNE.v[k];\n\n// the referee: a sight cone, behind the ball on the attack side\nSM.refSees = function (p) {\n  const M = SM.M;\n  if (SM.CHEATS.refBlind) return false;\n  if (SM.CHEATS.refStrict) return true;\n  const rx = M.refX, ry = M.refY, dx = p.x - rx, dy = p.y - ry, d = Math.hypot(dx, dy);\n  if (d > TUNE('refRange') || d < 1) return d < 1;\n  const facing = Math.atan2(M.ball.y - ry, M.ball.x - rx);\n  return Math.abs(ANG(facing, Math.atan2(dy, dx))) < 1.4 / 2 + .4;\n};\n\n// the whistle: a foul by side `offender` (its player), a penalty to the other side at the spot\nSM.foul = function (kind, offender, x, y, seenOnly) {\n  const M = SM.M;\n  const seen = seenOnly ? SM.refSees(offender) : true;\n  M.stats[offender.side].cards += 0;\n  if (!seen) { M.events.push({ t: 'unseen', kind }); M.hype[1 - offender.side] += 0; return; }\n  M.events.push({ t: 'foul', kind, side: offender.side });\n  const pen = M.pen = { side: 1 - offender.side, x: SM.clamp(x, SM.X0 + 10, SM.X1 - 10), y: SM.clamp(y, SM.Y0 + 10, SM.Y1 - 10), kind, player: offender };\n  SM.setPhase('penalty');\n  pen.card = kind === 'cheap' || kind === 'high';\n  if (pen.card) SM.sendOff(offender);\n};\n\n// a yellow card: the sin bin for sinBin seconds of play\nSM.sendOff = function (p) {\n  const M = SM.M;\n  p.bin = TUNE('sinBin'); p.st = 'bin'; p.input = null;\n  M.stats[p.side].cards++;\n  M.events.push({ t: 'yellow', side: p.side, name: p.nick });\n  M.sinBinned[p.side] = (M.sinBinned[p.side] || 0) + 1;\n  if (M.ball.owner === p) SM.dropBall(p);\n};\n\nSM.setPhase = function (name) {\n  const M = SM.M;\n  if (M.phase === name) return;\n  if (name !== 'play' && M.hooter && M.phase === 'play') { M.phase = name; SM.halfOver(); return; }\n  M.phase = name; M.pt = 0; M.events.push({ t: 'phase', name });\n};\n\nSM.dropBall = function (p) {\n  const M = SM.M, b = M.ball;\n  if (b.owner !== p) return;\n  b.owner = null; b.state = 'loose'; b.x = p.x + Math.cos(p.facing) * 8; b.y = p.y + Math.sin(p.facing) * 8; b.z = 6;\n  b.vx = Math.cos(p.facing) * 60; b.vy = Math.sin(p.facing) * 60; b.vz = 40; b.lastTouch = p.side; b.bounce = 0;\n  b.droppedBy = p;\n};\n\n// the try: the carrier in the in-goal; the points, the hype and the conversion\nSM.tryScored = function (p) {\n  const M = SM.M, s = p.side, d = DIR(s);\n  const tx = p.x, ty = p.y;\n  M.score[s] += 5; M.stats[s].tries++; M.hype[s] = Math.min(100, M.hype[s] + 15 * TUNE('hypeMult'));\n  M.lastScorer = p; M.events.push({ t: 'try', side: s, name: p.nick, x: tx, y: ty });\n  // on fire: two tries in a row by one player\n  if (M.lastTry[s] === p.i) { p.onFire = true; M.events.push({ t: 'onFire', name: p.nick }); }\n  M.lastTry[s] = p.i; M.lastTry[1 - s] = -1; if (M.lastTry[1 - s] !== -1) { /* (the other side's last try is kept) */ }\n  for (const q of M.players) if (q.side !== s) q.onFire = false;\n  M.ball.owner = null; M.ball.state = 'placed'; M.ball.x = tx; M.ball.y = ty; M.ball.z = 0;\n  SM.setPhase('try'); M.tryT = 3; M.conv = { side: s, x: tx, y: ty, kicker: M.players.find(q => q.side === s && q.pos === 4), t: 0 };\n};\n\n// the conversion: a kick at the posts from the try spot; a real power meter for the human, a roll for the CPU\nSM.startConversion = function () {\n  const M = SM.M, c = M.conv, s = c.side, d = DIR(s), postX = s === 0 ? SM.POST1 : SM.POST0;\n  c.postX = postX; c.dist = Math.abs(postX - c.x); c.kicker = M.players.find(q => q.side === s && q.pos === 4) || M.players.find(q => q.side === s);\n  c.kicker.x = c.x - d * (c.dist < 140 ? 8 : 24); c.kicker.y = c.y; c.kicker.facing = s === 0 ? 0 : Math.PI;\n  c.meter = 0; c.up = true; c.aim = 0; c.decided = false; c.human = c.kicker.input || null;\n  SM.setPhase('conv');\n};\n\n// the scores: the kick's outcome is decided by the meter (human) or by the kicker's stats (CPU)\nSM.decideKick = function (power, aim, kind) {\n  const M = SM.M, c = M.conv, need = SM.clamp(c.dist / TUNE('kickMax') / 1.5, .2, .95);\n  const k = c.kicker;\n  let acc;\n  if (power === null) {                          // the CPU: its own kicking stat and a roll\n    const err = (10 - k.stats.KCK) * .02 + SM.R() * .05;\n    acc = Math.abs(err) < .1 ? 1 : 0;\n  } else acc = (Math.abs(power - need) < .07 && Math.abs(aim) < .35) ? 1 : 0;\n  const s = c.side;\n  if (acc) {\n    M.score[s] += kind === 'drop' ? 3 : kind === 'pen' ? 3 : 2;\n    M.events.push({ t: 'goal', side: s, kind, name: k.nick });\n    M.hype[s] = Math.min(100, M.hype[s] + 5 * TUNE('hypeMult'));\n    if (M.golden) return SM.fullTime();\n    SM.kickoff(s);\n  } else {\n    M.events.push({ t: 'miss', side: s, kind });\n    SM.dropOut(1 - s);\n  }\n};\n\n// a 22 drop-out: from the dead-ball line in the defenders' 22\nSM.dropOut = function (side) {\n  const M = SM.M, d = DIR(side), x = side === 0 ? SM.X0 + 225 : SM.X1 - 225;\n  M.ball.owner = null; M.ball.state = 'placed'; M.ball.x = x; M.ball.y = SM.CY; M.ball.z = 0; M.ball.vx = M.ball.vy = M.ball.vz = 0;\n  const pl = M.players.filter(q => q.side === side && q.bin <= 0).sort((a, b) => dist(a.x, a.y, x, SM.CY) - dist(b.x, b.y, x, SM.CY))[0];\n  if (pl) { pl.x = x - d * 8; pl.y = SM.CY; pl.facing = side === 0 ? 0 : Math.PI; M.ball.owner = pl; M.ball.state = 'held'; }\n  SM.setPhase('play'); M.events.push({ t: 'dropOut', side });\n};\n\n// a scrum at (x, y): the forwards bind, the feeding side (the team not at fault) wins the ball by a timed push\nSM.startScrum = function (x, y, feedSide) {\n  const M = SM.M;\n  M.scrum = { x: SM.clamp(x, SM.X0 + 60, SM.X1 - 60), y: SM.clamp(y, SM.Y0 + 60, SM.Y1 - 60), feed: feedSide, t: 0, set: 0, pressed: null, push: [0, 0] };\n  M.ball.owner = null; M.ball.state = 'placed';\n  M.ball.x = M.scrum.x; M.ball.y = M.scrum.y; M.ball.z = 0;\n  for (const q of M.players) {\n    if (q.bin > 0) continue;\n    if (q.pos <= 2) {\n      const s = q.side, d = DIR(s);\n      q.x = M.scrum.x - d * (4 + q.pos * 2 * (q.pos === 1 ? 0 : 1)); q.y = M.scrum.y + (q.pos - 1) * 14;\n      q.facing = s === 0 ? 0 : Math.PI;\n    }\n  }\n  SM.setPhase('scrum');\n  M.events.push({ t: 'scrum', x: M.scrum.x, y: M.scrum.y });\n};\n// the lineout: the throwing side, the pods (0 front, 1 middle, 2 back), contest by timing and HND\nSM.startLineout = function (x, y, thrower) {\n  const M = SM.M;\n  M.lineout = { x: SM.clamp(x, SM.X0 + 40, SM.X1 - 40), y: SM.clamp(y, SM.Y0 + 60, SM.Y1 - 60), thrower, t: 0, call: [null, null], pod: [1, 1], stolen: false, throwN: 0 };\n  M.ball.owner = null; M.ball.state = 'placed'; M.ball.x = M.lineout.x; M.ball.y = M.lineout.y; M.ball.z = 0;\n  SM.setPhase('lineout');\n  M.events.push({ t: 'lineout', x: M.lineout.x, y: M.lineout.y, thrower });\n};\n\n// the ruck: the ball on the ground, the tug of war, the result and the set-up for the next phase\nSM.startRuck = function (x, y, carrierSide, tackler) {\n  const M = SM.M;\n  M.ruck = { x: SM.clamp(x, SM.X0 - 10, SM.X1 + 10), y: SM.clamp(y, SM.Y0 + 10, SM.Y1 - 10), attack: carrierSide, bar: .2, t: 0, jackal: null, jackalAt: null };\n  M.ball.owner = null; M.ball.state = 'placed'; M.ball.x = M.ruck.x; M.ball.y = M.ruck.y; M.ball.z = 0; M.ball.vx = M.ball.vy = 0;\n  M.ball.lastTouch = carrierSide;\n  SM.setPhase('ruck');\n  M.events.push({ t: 'ruck', x: M.ruck.x, y: M.ruck.y });\n};\n\n// the referee's whistle at the end of the half: the stoppage that follows ends it\nSM.halfOver = function () {\n  const M = SM.M;\n  M.events.push({ t: 'halftime', half: M.half });\n  M.hooter = false;\n  if (M.half === 1) { M.half = 2; M.run = 0; M.phase = 'half'; M.pt = 0; M.tHalf = 2.5; }\n  else SM.fullTime();\n};\nSM.fullTime = function () {\n  const M = SM.M;\n  if (M.score[0] === M.score[1] && !M.golden && !M.attract) { M.golden = true; M.phase = 'play'; M.run = 0; M.events.push({ t: 'golden' }); SM.kickoff(0); return; }\n  M.over = true; M.phase = 'full'; M.pt = 0; M.events.push({ t: 'fulltime', score: M.score.slice() });\n};\n\n// the player's per-step, applied to the body; the rest is in the step functions below\nSM.stepPlayer = function (p, dt, input) {\n  const M = SM.M;\n  const d = DIR(p.side);\n  p.cool = Math.max(0, p.cool - dt); p.stunT = Math.max(0, (p.stunT || 0) - dt); p.evade = Math.max(0, p.evade - dt);\n  p.fendT = Math.max(0, p.fendT - dt); p.diveT = Math.max(0, p.diveT - dt); p.cheer = Math.max(0, p.cheer - dt);\n  p.tackleT = Math.max(0, p.tackleT - dt); p.mudT = Math.max(0, p.mudT - dt);\n  if (p.bin > 0) { p.bin = Math.max(0, p.bin - (M.phase === 'play' ? dt : 0)); if (p.bin === 0) p.st = 'run'; p.x = SM.lerp(p.x, SM.X0 - 60 + p.side * 0, .05); return; }\n  if (p.st === 'tackled' || p.st === 'ground' || p.st === 'stun' || p.st === 'down') {\n    p.stT = (p.stT || 0) - dt; p.vx *= .9; p.vy *= .9;\n    if (p.stT <= 0) { p.st = 'getUp'; p.stT = .5; }\n    return;\n  }\n  if (p.st === 'getUp') { p.stT -= dt; if (p.stT <= 0) p.st = 'run'; return; }\n  if (M.phase === 'scrum' || M.phase === 'lineout' || M.phase === 'ruck' || M.phase === 'kickoff' || M.phase === 'try' || M.phase === 'conv' || M.phase === 'penalty' || M.phase === 'half' || M.phase === 'full') {\n    // stoppages: formation spots, no movement of the kick-off's line until released\n    if (M.phase === 'kickoff' || M.phase === 'half' || M.phase === 'scrum' || M.phase === 'lineout' || M.phase === 'ruck') {\n      const spot = SM.stoppageSpot(p);\n      if (spot) { p.x = SM.lerp(p.x, spot[0], .25); p.y = SM.lerp(p.y, spot[1], .25); }\n    }\n    p.vx = p.vy = 0;\n    return;\n  }\n  // the human's intent or the CPU's brain; then the body\n  let it = input;\n  if (!it) { it = SM.brain(p, dt); }\n  const turboReq = !!(it.turbo) && p.turbo > 0 && !(M.cheatsInfiniteTurbo);\n  let speed = TUNE('runSpeed') * (.8 + .04 * p.stats.SPD) * (p.side === M.humanSide ? 1 : 1);\n  if (p.onFire) speed *= 1.1;\n  if (M.mud && M.venue.mud) for (const m of M.mud) if (dist(p.x, p.y, m.x, m.y) < m.r) { speed *= .8; p.mudT = .3; }\n  if (p.ballCarried > 0 || (M.ball.owner === p)) speed *= .96;\n  if (M.superT && M.superT[p.side] && M.ball.owner === p) speed *= 1.35;\n  if (p.evade > 0) speed *= 1.1;\n  if (turboReq || (M.cheatInfiniteTurbo)) {\n    speed *= TUNE('turboMult'); p.turbo = Math.max(0, p.turbo - dt);\n  } else if (!it.turbo) p.turbo = Math.min(TUNE('turboTank'), p.turbo + TUNE('turboRegen') * dt * 3);\n  if (p.onFire) p.turbo = TUNE('turboTank');\n  if (p.side === 0 && SM.CHEATS.infiniteTurbo || SM.CHEATS.infiniteTurbo) p.turbo = TUNE('turboTank');\n  if (p.side === 1 && p.bin > 0) return;\n  let mx = it.mx || 0, my = it.my || 0;\n  const L = Math.hypot(mx, my);\n  if (L > 1) { mx /= L; my /= L; }\n  const tvx = mx * speed, tvy = my * speed;\n  const acc = TUNE('runSpeed') * 8.5 * dt;   // acceleration in units/s\n  p.vx = SM.approach(p.vx, tvx, acc); p.vy = SM.approach(p.vy, tvy, acc);\n  if (p.evade > 0 && it.evadeDir) { p.vx += it.evadeDir[0] * 3; p.vy += it.evadeDir[1] * 3; }\n  p.x += p.vx * dt; p.y += p.vy * dt;\n  // the touch and the dead-ball line: players stay in the field of play and the in-goal\n  p.x = SM.clamp(p.x, SM.DL0 + 4, SM.DL1 - 4); p.y = SM.clamp(p.y, SM.Y0 - 14, SM.Y1 + 14);\n  const sp = Math.hypot(p.vx, p.vy);\n  if (sp > 4) p.facing = Math.atan2(p.vy, p.vx);\n  if (it.faceTo !== undefined) p.facing = it.faceTo;\n  if (p.fendT > 0 && it.fend) p.facing = p.facing;\n  p.turnTo = p.facing;\n  p.st = (p.st === 'run' && sp > 10) ? 'run' : 'run';\n};\nSM.approach = (v, target, step) => v < target ? Math.min(target, v + step) : Math.max(target, v - step);\nSM.stoppageSpot = function (p) {\n  const M = SM.M, shape = SM.shapeFor(p);\n  return shape;\n};\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_017JRhpaYK7KfMhc21Q5q72M","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
