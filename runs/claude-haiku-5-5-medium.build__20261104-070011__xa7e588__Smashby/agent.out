{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgi1pA5G5qK79jfHDBYiV","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":19375,"cache_read_input_tokens":186246,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":19375},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5f6aeda2-f9ed-42d4-a150-3a2efde4ea9e","uuid":"a03a9dbb-bbbd-4b8e-9bf9-2db42599e8c8","timestamp":"2026-11-04T14:05:43.181Z","request_id":"req_011Cgi1p9jR9gVfztYEvw5Xm","thinking_duration_ms":47994,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgi1pA5G5qK79jfHDBYiV","type":"message","role":"assistant","content":[{"type":"text","text":"The first draft of the sim has sloppy bits: no-op lines, undefined fields like `M.humanSide`, and contradictory timer names. I'll rewrite the file cleanly now rather than patch it, since later modules depend on its shape."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":19375,"cache_read_input_tokens":186246,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":19375},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5f6aeda2-f9ed-42d4-a150-3a2efde4ea9e","uuid":"0a3e7577-528d-4968-a405-925b260c7ba7","timestamp":"2026-11-04T14:05:43.633Z","request_id":"req_011Cgi1p9jR9gVfztYEvw5Xm"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgi1pA5G5qK79jfHDBYiV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01AaJMp6HMnwo58Z5iMXijA4","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-070011__xa7e588/work/Smashby-Rugby-claude-haiku-5-5-medium-20261104-070011/src/10-sim.js","content":"// THE MATCH SIMULATION: rules, physics, contact, set pieces, the AI. It reads intents and writes match state; it never\n// draws. Seeded (SM.seed), fixed-step (the engine's update), every number from SM.TUNE.v. A human seat's intent is read\n// from its engine input by SM.readSeat(); the CPU's comes from SM.brain(). Both give the same shape:\n//   { mx, my (the stick), turbo (held), press: { tackle, sidestep, fend, dive, passUp, passDown, kick, superPress, mash,\n//     jackal, switchUp, switchDown, chooseUp, chooseDown, scrumPress }, kickHeld (bool), kickReleased (bool) }\nSM.M = null;\nconst G = 600;                                       // ball gravity (units per second squared)\nconst DIRS = s => (s === 0 ? 1 : -1);               // side 0 attacks toward +x, side 1 toward -x\nconst dist = (ax, ay, bx, by) => Math.hypot(ax - bx, ay - by);\nconst ANG = (a, b) => { let d = b - a; while (d > Math.PI) d -= 2 * Math.PI; while (d < -Math.PI) d += 2 * Math.PI; return d; };\nconst TUNE = k => SM.TUNE.v[k];\nconst approach = (v, target, step) => (v < target ? Math.min(target, v + step) : Math.max(target, v - step));\nconst emptyIntent = () => ({ mx: 0, my: 0, turbo: false, press: {}, kickHeld: false, kickReleased: false });\nSM.approach = approach; SM.emptyIntent = emptyIntent; SM.ANG = ANG; SM.DIRS = DIRS;\n\nconst statsBlock = () => ({ tries: 0, conversions: 0, tackles: 0, missed: 0, bigHits: 0, monster: 0, metres: 0, breaks: 0, turnovers: 0, cards: 0, poss: 0, terr: 0, passes: 0, kicks: 0, carries: 0 });\n\n// a player: the stats are the team sheet's five numbers (speed, power, hands, kicking, tackling)\nfunction makePlayer(side, pos, def, idx) {\n  const [name, nick, role, build, size, hair, hairC, skin, hat, stats] = def;\n  return {\n    i: idx, side, pos, role, name, nick, build, size, hair, hairC, skin, hat,\n    stats: { SPD: stats[0], POW: stats[1], HND: stats[2], KCK: stats[3], TKL: stats[4] },\n    x: 0, y: 0, z: 0, vx: 0, vy: 0, vz: 0, facing: side ? Math.PI : 0,\n    st: 'run', stT: 0, cool: 0, turbo: TUNE('turboTank'), evade: 0, evadeT: 0, fendT: 0, fendCD: 0, diveT: 0, bigCharge: 0, bigHeld: false,\n    stunT: 0, bin: 0, onFire: false, cheer: 0, mudT: 0, aiT: 0, plan: null, planT: 0, seat: null, homeT: 0, toasted: 0,\n    lastPass: 0, holdKick: 0, kickHeld: false, switchCD: 0, superT: 0\n  };\n}\n\n// the match: teams are indexes into SM.TEAMS; venue into SM.VENUES\nSM.newMatch = function (o) {\n  SM.seed(o.seed || 1);\n  const venue = SM.VENUES[o.venue || 0];\n  const teams = [SM.TEAMS[o.home || 0], SM.TEAMS[o.away == null ? 1 : o.away]];\n  const M = {\n    teams, venue, half: 1, run: 0, halfLen: o.halves || TUNE('halfLength'), phase: 'kickoff', pt: 0, score: [0, 0], hype: [0, 0],\n    players: [], ball: null, hooter: false, hooterWait: false, golden: false, over: false, attract: !!o.attract, cup: !!o.cup,\n    stats: [statsBlock(), statsBlock()], events: [], seats: [], ruck: null, scrum: null, lineout: null, pen: null, conv: null, tryT: 0,\n    lastTry: [-1, -1], lastTouch: 0, kickSide: 0, kickT: 0, halfT: 0, powerups: [], powerupT: 25, mud: [], grates: [], lightning: null,\n    lightningT: 20, grateT: 9, wind: 0, windT: 18, windDir: 0, wind2: 0, refX: SM.CX, refY: SM.Y1 + 30, superT: [0, 0], fail: null,\n    banner: null, bannerT: 0, t: 0, passes: 0, carrier: null, flightKind: null, scorer: null, ruckWon: [0, 0], clucky: null, scrumOver: false\n  };\n  SM.M = M;\n  if (venue.mud) for (let k = 0; k < 6; k++) M.mud.push({ x: SM.lerp(SM.X0 + 120, SM.X1 - 120, SM.fx()), y: SM.lerp(SM.Y0 + 60, SM.Y1 - 60, SM.fx()), r: 28 + SM.fx() * 26 });\n  if (venue.id === 'furnace') for (let k = 0; k < 8; k++) M.grates.push({ x: SM.lerp(SM.X0 + 100, SM.X1 - 100, k / 7), y: SM.Y0 + 22, state: 'cold', t: 0 }, { x: SM.lerp(SM.X0 + 100, SM.X1 - 100, k / 7), y: SM.Y1 - 22, state: 'cold', t: 0 });\n  for (let s = 0; s < 2; s++) teams[s].players.forEach((def, k) => M.players.push(makePlayer(s, k, def, s * 7 + k)));\n  M.ball = { x: SM.CX, y: SM.CY, z: 0, vx: 0, vy: 0, vz: 0, state: 'placed', owner: null, lastTouch: 0, kind: null, passer: null, receiver: null, spin: 0, roll: 0, flightTo: null, bounces: 0, droppedBy: null };\n  for (const h of o.humans || []) SM.seatPlayer({ input: h.input, name: h.name || 'P' + (M.seats.length + 1), color: h.color }, M.players.find(q => q.side === h.side && q.pos === h.pos));\n  SM.kickoff(o.kickSide || 0);\n  return M;\n};\n\n// seats: a human's input and the player it drives\nSM.seatPlayer = function (seatDef, p) {\n  const M = SM.M;\n  const seat = Object.assign({}, seatDef, { p: null });\n  M.seats.push(seat);\n  if (p) SM.takeControl(seat, p);\n  return seat;\n};\nSM.takeControl = function (seat, p) {\n  const M = SM.M;\n  if (seat.p) seat.p.seat = null;\n  const prev = p.seat; if (prev && prev !== seat) prev.p = null;\n  seat.p = p; p.seat = seat;\n};\n\n// kick-offs, the formation: the kicking side in its own half, the receivers spread across the other half\nSM.kickoff = function (kickSide) {\n  const M = SM.M;\n  if (M.hooter && M.half === 2) return SM.fullTime();\n  if (M.hooter) return SM.halfOver();\n  M.phase = 'kickoff'; M.pt = 0; M.kickSide = kickSide; M.kickT = 1.2;\n  const b = M.ball; b.owner = null; b.state = 'placed'; b.x = SM.CX; b.y = SM.CY; b.z = 0; b.vx = b.vy = b.vz = 0;\n  for (const p of M.players) {\n    if (p.bin > 0) continue;\n    const d = DIRS(p.side), k = p.pos;\n    if (p.side === kickSide) {\n      const fh = k === 4;\n      p.x = fh ? SM.CX - d * 4 : SM.CX - d * (48 + k * 6); p.y = fh ? SM.CY : SM.CY + (k - 3) * 34;\n    } else {\n      p.x = SM.CX + d * (150 + (k % 3) * 24); p.y = SM.CY + (k - 3) * 52;\n    }\n    p.y = SM.clamp(p.y, SM.Y0 + 14, SM.Y1 - 14);\n    p.vx = p.vy = 0; p.facing = p.side ? Math.PI : 0; p.st = 'run'; p.stT = 0; p.fendT = p.evade = p.diveT = 0; p.z = 0; p.vz = 0;\n  }\n  SM.event('kickoff', { side: kickSide });\n};\nSM.event = (t, data) => { const e = Object.assign({ t }, data || {}); SM.M.events.push(e); return e; };\n\n// the spot a player wants: the attacking shape behind the ball, or the defensive line in front of each attacker\nSM.shapeFor = function (p) {\n  const M = SM.M, b = M.ball, d = DIRS(p.side);\n  const haveBall = b.owner && b.owner.side === p.side;\n  const attacking = haveBall || (b.state !== 'held' && b.lastTouch === p.side && b.state !== 'placed');\n  if (attacking) {\n    if (b.owner === p) return [b.x, b.y];\n    const slots = [[-14, -26], [-8, 0], [-14, 26], [-22, 0], [-42, 0], [-60, -24], [-84, -54]];\n    const s = slots[p.pos];\n    const tx = b.x + d * s[0], ty = b.y + s[1];\n    return [SM.clamp(tx, SM.X0 - 40, SM.X1 + 40), SM.clamp(ty, SM.Y0 + 14, SM.Y1 - 14)];\n  }\n  // defending: the attackers by y; each defender sits in front of the attacker of the same rank\n  const atk = M.players.filter(q => q.side !== p.side && q.bin <= 0).sort((a, c) => a.y - c.y);\n  const mine = M.players.filter(q => q.side === p.side && q.bin <= 0).sort((a, c) => a.y - c.y);\n  const rank = Math.max(0, mine.indexOf(p)), target = atk[Math.min(atk.length - 1, rank)];\n  if (!target) return [b.x, b.y];\n  const dd = DIRS(target.side);\n  return [SM.clamp(target.x + dd * 26, SM.X0 - 30, SM.X1 + 30), SM.clamp(target.y, SM.Y0 + 14, SM.Y1 - 14)];\n};\n\n// a kick: the apex sets the flight; the landing spot sets the speed (2 * vz / G seconds in the air)\nSM.kickFlight = function (fromX, fromY, tx, ty, apex, kind, kicker) {\n  const b = SM.M.ball, dx = tx - fromX, dy = ty - fromY, d = Math.hypot(dx, dy) || 1;\n  const vz = Math.sqrt(2 * G * apex), T = 2 * vz / G, sp = d / T;\n  b.x = fromX; b.y = fromY; b.z = 8; b.vx = dx / d * sp; b.vy = dy / d * sp; b.vz = vz;\n  b.state = 'air'; b.owner = null; b.kind = kind; b.passer = kicker || null; b.receiver = null; b.spin = 0; b.flightTo = [tx, ty];\n  b.lastTouch = kicker ? kicker.side : b.lastTouch;\n  if (kicker) SM.M.stats[kicker.side].kicks++;\n};\n\n// pass: a low, quick ball to the receiver's lead point; it is caught inside his reach (SM.ballStep decides)\nSM.passTo = function (p, recv) {\n  const M = SM.M, b = M.ball, T = TUNE('passSpeed');\n  const d = dist(p.x, p.y, recv.x, recv.y), t = d / T;\n  const tx = recv.x + recv.vx * t * .8, ty = recv.y + recv.vy * t * .8;\n  const dx = tx - p.x, dy = ty - p.y, L = Math.hypot(dx, dy) || 1;\n  b.x = p.x + dx / L * 8; b.y = p.y + dy / L * 8; b.z = 10; b.vx = dx / L * T; b.vy = dy / L * T; b.vz = 0;\n  b.state = 'pass'; b.owner = null; b.kind = 'pass'; b.passer = p; b.receiver = recv; b.lastTouch = p.side; b.bounces = 0;\n  M.stats[p.side].passes++; M.passes++;\n  p.cool = .15;\n};\n\n// the legal receivers from p: teammates behind or level with him (never in front: no forward passes), on the side asked\nSM.legalReceivers = function (p, up) {\n  const M = SM.M, d = DIRS(p.side);\n  return M.players.filter(q => q.side === p.side && q !== p && q.bin <= 0 && q.st !== 'tackled' && q.st !== 'ground' && q.stunT <= 0 &&\n    (q.x - p.x) * d <= 4 && dist(p.x, p.y, q.x, q.y) < 230 && (up ? q.y < p.y - 2 : q.y > p.y + 2)).sort((a, c) => Math.abs(a.y - p.y) - Math.abs(c.y - p.y));\n};\n\n// the referee: standing behind play on the attack side, seeing a cone toward the ball\nSM.refUpdate = function (dt) {\n  const M = SM.M, b = M.ball, atk = b.lastTouch;\n  const d = DIRS(atk);\n  const tx = b.x - d * 56, ty = SM.Y1 + 32;\n  M.refX = SM.lerp(M.refX, SM.clamp(tx, SM.X0 - 60, SM.X1 + 60), .08); M.refY = SM.lerp(M.refY, ty, .08);\n  M.refFace = Math.atan2(b.y - M.refY, b.x - M.refX);\n};\nSM.refSees = function (p) {\n  if (SM.CHEATS.refBlind) return false;\n  if (SM.CHEATS.refStrict) return true;\n  const M = SM.M, dx = p.x - M.refX, dy = p.y - M.refY, d = Math.hypot(dx, dy);\n  if (d > TUNE('refRange') || d < 1) return d < 1;\n  return Math.abs(ANG(M.refFace, Math.atan2(dy, dx))) < TUNE('refFov') / 2 + .2;\n};\n\n// a foul: the penalty goes to the other side at the mark. The offender may be carded (cheap and high tackles).\nSM.foul = function (kind, offender, x, y, seenOnly) {\n  const M = SM.M;\n  const seen = seenOnly ? SM.refSees(offender) : true;\n  if (!seen) { SM.event('unseen', { kind, side: offender.side }); return false; }\n  const pen = M.pen = { side: 1 - offender.side, x: SM.clamp(x, SM.X0 + 10, SM.X1 - 10), y: SM.clamp(y, SM.Y0 + 10, SM.Y1 - 10), kind, offender, choice: null, t: 0, wait: 0.4 };\n  SM.event('foul', { kind, side: offender.side, name: offender.nick });\n  if (kind === 'cheap' || kind === 'high') SM.sendOff(offender);\n  M.ball.owner = null; M.ball.state = 'placed'; M.ball.x = pen.x; M.ball.y = pen.y; M.ball.z = 0;\n  SM.setPhase('penalty');\n  return true;\n};\n\n// the sin bin: a yellow card, the team plays with six for sinBin seconds of play\nSM.sendOff = function (p) {\n  const M = SM.M;\n  p.bin = TUNE('sinBin'); p.st = 'bin'; p.seat = null;\n  M.stats[p.side].cards++;\n  if (M.ball.owner === p) SM.dropBall(p, 0);\n  for (const s of M.seats) if (s.p === p) { s.p = null; }\n  SM.event('yellow', { side: p.side, name: p.nick });\n  SM.replaceControl(p.side);\n};\n\n// the seats of a side that lost their player move to the nearest teammate with the ball or near it\nSM.replaceControl = function (side) {\n  const M = SM.M;\n  for (const s of M.seats) {\n    if (s.p) continue;\n    const cand = M.players.filter(q => q.side === side && q.bin <= 0 && !q.seat).sort((a, c) => dist(a.x, a.y, M.ball.x, M.ball.y) - dist(c.x, c.y, M.ball.x, M.ball.y))[0];\n    if (cand && s.side === undefined) SM.takeControl(s, cand);\n  }\n};\n\nSM.setPhase = function (name) {\n  const M = SM.M;\n  if (M.phase === name) return;\n  M.phase = name; M.pt = 0;\n  SM.event('phase', { name });\n};\n\n// when play would resume after a stoppage: the half ends if the hooter has gone\nSM.resumePlay = function () {\n  const M = SM.M;\n  if (M.hooter) { M.hooter = false; return SM.halfOver(); }\n  SM.setPhase('play');\n};\n\nSM.halfOver = function () {\n  const M = SM.M;\n  if (M.half === 1) {\n    M.half = 2; M.run = 0; M.hooter = false;\n    M.phase = 'half'; M.pt = 0; M.halfT = 3.0;\n    SM.event('halftime', { score: M.score.slice() });\n  } else SM.fullTime();\n};\nSM.fullTime = function () {\n  const M = SM.M;\n  if (M.score[0] === M.score[1] && !M.golden && !M.attract) {\n    M.golden = true; M.hooter = false; M.run = 0; SM.event('golden');\n    SM.kickoff(0); return;\n  }\n  M.over = true; M.phase = 'full'; M.pt = 0; M.hooter = false;\n  SM.event('fulltime', { score: M.score.slice() });\n};\n\n// a carrier over the try line: the try, the points, the celebrations and then the conversion\nSM.tryScored = function (p) {\n  const M = SM.M, s = p.side;\n  M.score[s] += 5; M.stats[s].tries++; M.hype[s] = Math.min(100, M.hype[s] + 15 * TUNE('hypeMult'));\n  M.scorer = p;\n  if (M.lastTry[s] === p.i) { p.onFire = true; SM.event('onFire', { name: p.nick, side: s }); }\n  M.lastTry[s] = p.i; M.lastTry[1 - s] = -1;\n  for (const q of M.players) if (q.side !== s) q.onFire = false;\n  SM.event('try', { side: s, name: p.nick, x: p.x, y: p.y });\n  const b = M.ball; b.owner = null; b.state = 'placed'; b.x = p.x; b.y = p.y; b.z = 0; b.vx = b.vy = b.vz = 0;\n  for (const q of M.players) if (q.side === s && q !== p) q.cheer = 3;\n  p.cheer = 3;\n  SM.setPhase('try'); M.tryT = 3;\n  M.conv = { side: s, x: SM.clamp(p.x, SM.X0 + 4, SM.X1 - 4), y: p.y, kind: 'conv' };\n};\n\n// the conversion (or a penalty goal): the kicker places the ball, and the power meter decides it (human) or the roll\nSM.startConversion = function (kind) {\n  const M = SM.M, c = M.conv, s = c.side, d = DIRS(s);\n  c.kind = kind || c.kind; c.postX = s === 0 ? SM.POST1 : SM.POST0;\n  c.dist = Math.abs(c.postX - c.x);\n  c.kicker = M.players.find(q => q.side === s && q.pos === 4 && q.bin <= 0) || M.players.find(q => q.side === s && q.bin <= 0);\n  c.meter = 0; c.up = true; c.t = 0; c.aim = 0; c.done = false;\n  if (c.kicker) { c.kicker.x = c.x - d * 14; c.kicker.y = c.y; c.kicker.facing = s === 0 ? 0 : Math.PI; c.kicker.vx = c.kicker.vy = 0; }\n  SM.setPhase('conv');\n};\n// the outcome: power (0..1) and aim (-1..1) from the meter, or null for the CPU\nSM.decideKick = function (power, aim) {\n  const M = SM.M, c = M.conv, s = c.side;\n  const need = SM.clamp(c.dist / (TUNE('kickMax') * .9), .2, .95);\n  const k = c.kicker;\n  let good;\n  if (power === null) {\n    const kck = k ? k.stats.KCK : 6;\n    good = SM.R() < SM.clamp(.92 - c.dist / 1600 + (kck - 6) * .03, .3, .97);\n  } else good = Math.abs(power - need) < .07 && Math.abs(aim) < .35;\n  if (good) {\n    const pts = c.kind === 'pen' ? 3 : c.kind === 'drop' ? 3 : 2;\n    M.score[s] += pts; M.hype[s] = Math.min(100, M.hype[s] + 5 * TUNE('hypeMult'));\n    if (c.kind === 'conv') M.stats[s].conversions++;\n    SM.event('goal', { side: s, kind: c.kind, pts, name: k ? k.nick : '' });\n    M.conv = null;\n    if (M.golden) return SM.fullTime();\n    return SM.kickoff(s);\n  }\n  SM.event('miss', { side: s, kind: c.kind });\n  M.conv = null;\n  return SM.dropOut(1 - s);\n};\n\n// a 22 drop-out: the defenders restart from their own 22\nSM.dropOut = function (side) {\n  const M = SM.M, x = side === 0 ? SM.X0 + 225 : SM.X1 - 225;\n  const b = M.ball; b.owner = null; b.state = 'placed'; b.x = x; b.y = SM.CY; b.z = 0; b.vx = b.vy = b.vz = 0;\n  const pl = M.players.filter(q => q.side === side && q.bin <= 0).sort((a, c) => dist(a.x, a.y, x, SM.CY) - dist(c.x, c.y, x, SM.CY))[0];\n  if (pl) { pl.x = x - DIRS(side) * 10; pl.y = SM.CY; pl.facing = side === 0 ? 0 : Math.PI; b.x = pl.x + DIRS(side) * 6; b.y = pl.y; b.owner = pl; b.state = 'held'; }\n  SM.event('dropOut', { side });\n  SM.resumePlay();\n};\n\n// a scrum: the forwards bind at the mark; the timed push (CROUCH, BIND, SET) decides who wins the ball\nSM.startScrum = function (x, y, feedSide, forPen) {\n  const M = SM.M;\n  M.scrum = { x: SM.clamp(x, SM.X0 + 60, SM.X1 - 60), y: SM.clamp(y, SM.Y0 + 60, SM.Y1 - 60), feed: feedSide, t: 0, setAt: 1.9, early: false, pressedAt: null, push: [0, 0], resolveAt: 3.4 };\n  const b = M.ball; b.owner = null; b.state = 'placed'; b.x = M.scrum.x; b.y = M.scrum.y; b.z = 0; b.vx = b.vy = b.vz = 0;\n  for (const q of M.players) {\n    if (q.bin > 0 || q.pos > 2) continue;\n    const d = DIRS(q.side);\n    q.x = M.scrum.x - d * 6 + (q.side ? 0 : 0); q.y = M.scrum.y + (q.pos - 1) * 14; q.facing = q.side ? Math.PI : 0;\n  }\n  SM.setPhase('scrum');\n  SM.event('scrum', { x: M.scrum.x, y: M.scrum.y });\n};\n\n// the lineout: pods (front, middle, back) and a timed throw; a contest when both sides pick the same pod\nSM.startLineout = function (x, y, thrower) {\n  const M = SM.M;\n  M.lineout = { x: SM.clamp(x, SM.X0 + 40, SM.X1 - 40), y: SM.clamp(y, SM.Y0 + 60, SM.Y1 - 60), thrower, t: 0, pick: [null, null], resolveAt: 2.4 };\n  const b = M.ball; b.owner = null; b.state = 'placed'; b.x = M.lineout.x; b.y = M.lineout.y; b.z = 0; b.vx = b.vy = b.vz = 0;\n  SM.setPhase('lineout');\n  SM.event('lineout', { x: M.lineout.x, y: M.lineout.y, thrower });\n};\n\n// the ruck: the carrier goes down, the ball sits on the ground, both sides tug; the bar's end decides possession\nSM.startRuck = function (x, y, attackSide) {\n  const M = SM.M;\n  M.ruck = { x: SM.clamp(x, SM.X0 - 10, SM.X1 + 10), y: SM.clamp(y, SM.Y0 + 10, SM.Y1 - 10), attack: attackSide, bar: .2, t: 0, jackal: false, jackalAt: null };\n  const b = M.ball; b.owner = null; b.state = 'placed'; b.x = M.ruck.x; b.y = M.ruck.y; b.z = 0; b.vx = b.vy = b.vz = 0; b.lastTouch = attackSide;\n  SM.setPhase('ruck');\n  SM.event('ruck', { x: M.ruck.x, y: M.ruck.y });\n};\n\nSM.dropBall = function (p, spill) {\n  const M = SM.M, b = M.ball;\n  if (b.owner !== p) return;\n  b.owner = null; b.state = 'loose'; b.x = p.x + Math.cos(p.facing) * 8; b.y = p.y + Math.sin(p.facing) * 8; b.z = 6;\n  const sp = spill || 0;\n  b.vx = Math.cos(p.facing) * (30 + sp * 80); b.vy = Math.sin(p.facing) * (30 + sp * 80); b.vz = 30 + sp * 40; b.lastTouch = p.side; b.bounces = 0; b.droppedBy = p; b.kind = 'loose';\n};\n\n// the sides' possession and territory: time by the side holding the ball and the ball's half\nSM.tally = function (dt) {\n  const M = SM.M, b = M.ball;\n  if (b.owner) M.stats[b.owner.side].poss += dt;\n  if (b.state !== 'placed' || M.phase !== 'scrum') {\n    const inOpp = (side) => (side === 0 ? b.x > SM.CX : b.x < SM.CX);\n    M.stats[0].terr += inOpp(0) ? dt : 0; M.stats[1].terr += inOpp(1) ? dt : 0;\n  }\n};\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":19375,"cache_read_input_tokens":186246,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":19375},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5f6aeda2-f9ed-42d4-a150-3a2efde4ea9e","uuid":"2aab467a-f036-4960-ad96-13f32e85448f","timestamp":"2026-11-04T14:06:15.399Z","request_id":"req_011Cgi1p9jR9gVfztYEvw5Xm","wire_tool_inputs":{"toolu_01AaJMp6HMnwo58Z5iMXijA4":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-070011__xa7e588/work/Smashby-Rugby-claude-haiku-5-5-medium-20261104-070011/src/10-sim.js","content":"// THE MATCH SIMULATION: rules, physics, contact, set pieces, the AI. It reads intents and writes match state; it never\n// draws. Seeded (SM.seed), fixed-step (the engine's update), every number from SM.TUNE.v. A human seat's intent is read\n// from its engine input by SM.readSeat(); the CPU's comes from SM.brain(). Both give the same shape:\n//   { mx, my (the stick), turbo (held), press: { tackle, sidestep, fend, dive, passUp, passDown, kick, superPress, mash,\n//     jackal, switchUp, switchDown, chooseUp, chooseDown, scrumPress }, kickHeld (bool), kickReleased (bool) }\nSM.M = null;\nconst G = 600;                                       // ball gravity (units per second squared)\nconst DIRS = s => (s === 0 ? 1 : -1);               // side 0 attacks toward +x, side 1 toward -x\nconst dist = (ax, ay, bx, by) => Math.hypot(ax - bx, ay - by);\nconst ANG = (a, b) => { let d = b - a; while (d > Math.PI) d -= 2 * Math.PI; while (d < -Math.PI) d += 2 * Math.PI; return d; };\nconst TUNE = k => SM.TUNE.v[k];\nconst approach = (v, target, step) => (v < target ? Math.min(target, v + step) : Math.max(target, v - step));\nconst emptyIntent = () => ({ mx: 0, my: 0, turbo: false, press: {}, kickHeld: false, kickReleased: false });\nSM.approach = approach; SM.emptyIntent = emptyIntent; SM.ANG = ANG; SM.DIRS = DIRS;\n\nconst statsBlock = () => ({ tries: 0, conversions: 0, tackles: 0, missed: 0, bigHits: 0, monster: 0, metres: 0, breaks: 0, turnovers: 0, cards: 0, poss: 0, terr: 0, passes: 0, kicks: 0, carries: 0 });\n\n// a player: the stats are the team sheet's five numbers (speed, power, hands, kicking, tackling)\nfunction makePlayer(side, pos, def, idx) {\n  const [name, nick, role, build, size, hair, hairC, skin, hat, stats] = def;\n  return {\n    i: idx, side, pos, role, name, nick, build, size, hair, hairC, skin, hat,\n    stats: { SPD: stats[0], POW: stats[1], HND: stats[2], KCK: stats[3], TKL: stats[4] },\n    x: 0, y: 0, z: 0, vx: 0, vy: 0, vz: 0, facing: side ? Math.PI : 0,\n    st: 'run', stT: 0, cool: 0, turbo: TUNE('turboTank'), evade: 0, evadeT: 0, fendT: 0, fendCD: 0, diveT: 0, bigCharge: 0, bigHeld: false,\n    stunT: 0, bin: 0, onFire: false, cheer: 0, mudT: 0, aiT: 0, plan: null, planT: 0, seat: null, homeT: 0, toasted: 0,\n    lastPass: 0, holdKick: 0, kickHeld: false, switchCD: 0, superT: 0\n  };\n}\n\n// the match: teams are indexes into SM.TEAMS; venue into SM.VENUES\nSM.newMatch = function (o) {\n  SM.seed(o.seed || 1);\n  const venue = SM.VENUES[o.venue || 0];\n  const teams = [SM.TEAMS[o.home || 0], SM.TEAMS[o.away == null ? 1 : o.away]];\n  const M = {\n    teams, venue, half: 1, run: 0, halfLen: o.halves || TUNE('halfLength'), phase: 'kickoff', pt: 0, score: [0, 0], hype: [0, 0],\n    players: [], ball: null, hooter: false, hooterWait: false, golden: false, over: false, attract: !!o.attract, cup: !!o.cup,\n    stats: [statsBlock(), statsBlock()], events: [], seats: [], ruck: null, scrum: null, lineout: null, pen: null, conv: null, tryT: 0,\n    lastTry: [-1, -1], lastTouch: 0, kickSide: 0, kickT: 0, halfT: 0, powerups: [], powerupT: 25, mud: [], grates: [], lightning: null,\n    lightningT: 20, grateT: 9, wind: 0, windT: 18, windDir: 0, wind2: 0, refX: SM.CX, refY: SM.Y1 + 30, superT: [0, 0], fail: null,\n    banner: null, bannerT: 0, t: 0, passes: 0, carrier: null, flightKind: null, scorer: null, ruckWon: [0, 0], clucky: null, scrumOver: false\n  };\n  SM.M = M;\n  if (venue.mud) for (let k = 0; k < 6; k++) M.mud.push({ x: SM.lerp(SM.X0 + 120, SM.X1 - 120, SM.fx()), y: SM.lerp(SM.Y0 + 60, SM.Y1 - 60, SM.fx()), r: 28 + SM.fx() * 26 });\n  if (venue.id === 'furnace') for (let k = 0; k < 8; k++) M.grates.push({ x: SM.lerp(SM.X0 + 100, SM.X1 - 100, k / 7), y: SM.Y0 + 22, state: 'cold', t: 0 }, { x: SM.lerp(SM.X0 + 100, SM.X1 - 100, k / 7), y: SM.Y1 - 22, state: 'cold', t: 0 });\n  for (let s = 0; s < 2; s++) teams[s].players.forEach((def, k) => M.players.push(makePlayer(s, k, def, s * 7 + k)));\n  M.ball = { x: SM.CX, y: SM.CY, z: 0, vx: 0, vy: 0, vz: 0, state: 'placed', owner: null, lastTouch: 0, kind: null, passer: null, receiver: null, spin: 0, roll: 0, flightTo: null, bounces: 0, droppedBy: null };\n  for (const h of o.humans || []) SM.seatPlayer({ input: h.input, name: h.name || 'P' + (M.seats.length + 1), color: h.color }, M.players.find(q => q.side === h.side && q.pos === h.pos));\n  SM.kickoff(o.kickSide || 0);\n  return M;\n};\n\n// seats: a human's input and the player it drives\nSM.seatPlayer = function (seatDef, p) {\n  const M = SM.M;\n  const seat = Object.assign({}, seatDef, { p: null });\n  M.seats.push(seat);\n  if (p) SM.takeControl(seat, p);\n  return seat;\n};\nSM.takeControl = function (seat, p) {\n  const M = SM.M;\n  if (seat.p) seat.p.seat = null;\n  const prev = p.seat; if (prev && prev !== seat) prev.p = null;\n  seat.p = p; p.seat = seat;\n};\n\n// kick-offs, the formation: the kicking side in its own half, the receivers spread across the other half\nSM.kickoff = function (kickSide) {\n  const M = SM.M;\n  if (M.hooter && M.half === 2) return SM.fullTime();\n  if (M.hooter) return SM.halfOver();\n  M.phase = 'kickoff'; M.pt = 0; M.kickSide = kickSide; M.kickT = 1.2;\n  const b = M.ball; b.owner = null; b.state = 'placed'; b.x = SM.CX; b.y = SM.CY; b.z = 0; b.vx = b.vy = b.vz = 0;\n  for (const p of M.players) {\n    if (p.bin > 0) continue;\n    const d = DIRS(p.side), k = p.pos;\n    if (p.side === kickSide) {\n      const fh = k === 4;\n      p.x = fh ? SM.CX - d * 4 : SM.CX - d * (48 + k * 6); p.y = fh ? SM.CY : SM.CY + (k - 3) * 34;\n    } else {\n      p.x = SM.CX + d * (150 + (k % 3) * 24); p.y = SM.CY + (k - 3) * 52;\n    }\n    p.y = SM.clamp(p.y, SM.Y0 + 14, SM.Y1 - 14);\n    p.vx = p.vy = 0; p.facing = p.side ? Math.PI : 0; p.st = 'run'; p.stT = 0; p.fendT = p.evade = p.diveT = 0; p.z = 0; p.vz = 0;\n  }\n  SM.event('kickoff', { side: kickSide });\n};\nSM.event = (t, data) => { const e = Object.assign({ t }, data || {}); SM.M.events.push(e); return e; };\n\n// the spot a player wants: the attacking shape behind the ball, or the defensive line in front of each attacker\nSM.shapeFor = function (p) {\n  const M = SM.M, b = M.ball, d = DIRS(p.side);\n  const haveBall = b.owner && b.owner.side === p.side;\n  const attacking = haveBall || (b.state !== 'held' && b.lastTouch === p.side && b.state !== 'placed');\n  if (attacking) {\n    if (b.owner === p) return [b.x, b.y];\n    const slots = [[-14, -26], [-8, 0], [-14, 26], [-22, 0], [-42, 0], [-60, -24], [-84, -54]];\n    const s = slots[p.pos];\n    const tx = b.x + d * s[0], ty = b.y + s[1];\n    return [SM.clamp(tx, SM.X0 - 40, SM.X1 + 40), SM.clamp(ty, SM.Y0 + 14, SM.Y1 - 14)];\n  }\n  // defending: the attackers by y; each defender sits in front of the attacker of the same rank\n  const atk = M.players.filter(q => q.side !== p.side && q.bin <= 0).sort((a, c) => a.y - c.y);\n  const mine = M.players.filter(q => q.side === p.side && q.bin <= 0).sort((a, c) => a.y - c.y);\n  const rank = Math.max(0, mine.indexOf(p)), target = atk[Math.min(atk.length - 1, rank)];\n  if (!target) return [b.x, b.y];\n  const dd = DIRS(target.side);\n  return [SM.clamp(target.x + dd * 26, SM.X0 - 30, SM.X1 + 30), SM.clamp(target.y, SM.Y0 + 14, SM.Y1 - 14)];\n};\n\n// a kick: the apex sets the flight; the landing spot sets the speed (2 * vz / G seconds in the air)\nSM.kickFlight = function (fromX, fromY, tx, ty, apex, kind, kicker) {\n  const b = SM.M.ball, dx = tx - fromX, dy = ty - fromY, d = Math.hypot(dx, dy) || 1;\n  const vz = Math.sqrt(2 * G * apex), T = 2 * vz / G, sp = d / T;\n  b.x = fromX; b.y = fromY; b.z = 8; b.vx = dx / d * sp; b.vy = dy / d * sp; b.vz = vz;\n  b.state = 'air'; b.owner = null; b.kind = kind; b.passer = kicker || null; b.receiver = null; b.spin = 0; b.flightTo = [tx, ty];\n  b.lastTouch = kicker ? kicker.side : b.lastTouch;\n  if (kicker) SM.M.stats[kicker.side].kicks++;\n};\n\n// pass: a low, quick ball to the receiver's lead point; it is caught inside his reach (SM.ballStep decides)\nSM.passTo = function (p, recv) {\n  const M = SM.M, b = M.ball, T = TUNE('passSpeed');\n  const d = dist(p.x, p.y, recv.x, recv.y), t = d / T;\n  const tx = recv.x + recv.vx * t * .8, ty = recv.y + recv.vy * t * .8;\n  const dx = tx - p.x, dy = ty - p.y, L = Math.hypot(dx, dy) || 1;\n  b.x = p.x + dx / L * 8; b.y = p.y + dy / L * 8; b.z = 10; b.vx = dx / L * T; b.vy = dy / L * T; b.vz = 0;\n  b.state = 'pass'; b.owner = null; b.kind = 'pass'; b.passer = p; b.receiver = recv; b.lastTouch = p.side; b.bounces = 0;\n  M.stats[p.side].passes++; M.passes++;\n  p.cool = .15;\n};\n\n// the legal receivers from p: teammates behind or level with him (never in front: no forward passes), on the side asked\nSM.legalReceivers = function (p, up) {\n  const M = SM.M, d = DIRS(p.side);\n  return M.players.filter(q => q.side === p.side && q !== p && q.bin <= 0 && q.st !== 'tackled' && q.st !== 'ground' && q.stunT <= 0 &&\n    (q.x - p.x) * d <= 4 && dist(p.x, p.y, q.x, q.y) < 230 && (up ? q.y < p.y - 2 : q.y > p.y + 2)).sort((a, c) => Math.abs(a.y - p.y) - Math.abs(c.y - p.y));\n};\n\n// the referee: standing behind play on the attack side, seeing a cone toward the ball\nSM.refUpdate = function (dt) {\n  const M = SM.M, b = M.ball, atk = b.lastTouch;\n  const d = DIRS(atk);\n  const tx = b.x - d * 56, ty = SM.Y1 + 32;\n  M.refX = SM.lerp(M.refX, SM.clamp(tx, SM.X0 - 60, SM.X1 + 60), .08); M.refY = SM.lerp(M.refY, ty, .08);\n  M.refFace = Math.atan2(b.y - M.refY, b.x - M.refX);\n};\nSM.refSees = function (p) {\n  if (SM.CHEATS.refBlind) return false;\n  if (SM.CHEATS.refStrict) return true;\n  const M = SM.M, dx = p.x - M.refX, dy = p.y - M.refY, d = Math.hypot(dx, dy);\n  if (d > TUNE('refRange') || d < 1) return d < 1;\n  return Math.abs(ANG(M.refFace, Math.atan2(dy, dx))) < TUNE('refFov') / 2 + .2;\n};\n\n// a foul: the penalty goes to the other side at the mark. The offender may be carded (cheap and high tackles).\nSM.foul = function (kind, offender, x, y, seenOnly) {\n  const M = SM.M;\n  const seen = seenOnly ? SM.refSees(offender) : true;\n  if (!seen) { SM.event('unseen', { kind, side: offender.side }); return false; }\n  const pen = M.pen = { side: 1 - offender.side, x: SM.clamp(x, SM.X0 + 10, SM.X1 - 10), y: SM.clamp(y, SM.Y0 + 10, SM.Y1 - 10), kind, offender, choice: null, t: 0, wait: 0.4 };\n  SM.event('foul', { kind, side: offender.side, name: offender.nick });\n  if (kind === 'cheap' || kind === 'high') SM.sendOff(offender);\n  M.ball.owner = null; M.ball.state = 'placed'; M.ball.x = pen.x; M.ball.y = pen.y; M.ball.z = 0;\n  SM.setPhase('penalty');\n  return true;\n};\n\n// the sin bin: a yellow card, the team plays with six for sinBin seconds of play\nSM.sendOff = function (p) {\n  const M = SM.M;\n  p.bin = TUNE('sinBin'); p.st = 'bin'; p.seat = null;\n  M.stats[p.side].cards++;\n  if (M.ball.owner === p) SM.dropBall(p, 0);\n  for (const s of M.seats) if (s.p === p) { s.p = null; }\n  SM.event('yellow', { side: p.side, name: p.nick });\n  SM.replaceControl(p.side);\n};\n\n// the seats of a side that lost their player move to the nearest teammate with the ball or near it\nSM.replaceControl = function (side) {\n  const M = SM.M;\n  for (const s of M.seats) {\n    if (s.p) continue;\n    const cand = M.players.filter(q => q.side === side && q.bin <= 0 && !q.seat).sort((a, c) => dist(a.x, a.y, M.ball.x, M.ball.y) - dist(c.x, c.y, M.ball.x, M.ball.y))[0];\n    if (cand && s.side === undefined) SM.takeControl(s, cand);\n  }\n};\n\nSM.setPhase = function (name) {\n  const M = SM.M;\n  if (M.phase === name) return;\n  M.phase = name; M.pt = 0;\n  SM.event('phase', { name });\n};\n\n// when play would resume after a stoppage: the half ends if the hooter has gone\nSM.resumePlay = function () {\n  const M = SM.M;\n  if (M.hooter) { M.hooter = false; return SM.halfOver(); }\n  SM.setPhase('play');\n};\n\nSM.halfOver = function () {\n  const M = SM.M;\n  if (M.half === 1) {\n    M.half = 2; M.run = 0; M.hooter = false;\n    M.phase = 'half'; M.pt = 0; M.halfT = 3.0;\n    SM.event('halftime', { score: M.score.slice() });\n  } else SM.fullTime();\n};\nSM.fullTime = function () {\n  const M = SM.M;\n  if (M.score[0] === M.score[1] && !M.golden && !M.attract) {\n    M.golden = true; M.hooter = false; M.run = 0; SM.event('golden');\n    SM.kickoff(0); return;\n  }\n  M.over = true; M.phase = 'full'; M.pt = 0; M.hooter = false;\n  SM.event('fulltime', { score: M.score.slice() });\n};\n\n// a carrier over the try line: the try, the points, the celebrations and then the conversion\nSM.tryScored = function (p) {\n  const M = SM.M, s = p.side;\n  M.score[s] += 5; M.stats[s].tries++; M.hype[s] = Math.min(100, M.hype[s] + 15 * TUNE('hypeMult'));\n  M.scorer = p;\n  if (M.lastTry[s] === p.i) { p.onFire = true; SM.event('onFire', { name: p.nick, side: s }); }\n  M.lastTry[s] = p.i; M.lastTry[1 - s] = -1;\n  for (const q of M.players) if (q.side !== s) q.onFire = false;\n  SM.event('try', { side: s, name: p.nick, x: p.x, y: p.y });\n  const b = M.ball; b.owner = null; b.state = 'placed'; b.x = p.x; b.y = p.y; b.z = 0; b.vx = b.vy = b.vz = 0;\n  for (const q of M.players) if (q.side === s && q !== p) q.cheer = 3;\n  p.cheer = 3;\n  SM.setPhase('try'); M.tryT = 3;\n  M.conv = { side: s, x: SM.clamp(p.x, SM.X0 + 4, SM.X1 - 4), y: p.y, kind: 'conv' };\n};\n\n// the conversion (or a penalty goal): the kicker places the ball, and the power meter decides it (human) or the roll\nSM.startConversion = function (kind) {\n  const M = SM.M, c = M.conv, s = c.side, d = DIRS(s);\n  c.kind = kind || c.kind; c.postX = s === 0 ? SM.POST1 : SM.POST0;\n  c.dist = Math.abs(c.postX - c.x);\n  c.kicker = M.players.find(q => q.side === s && q.pos === 4 && q.bin <= 0) || M.players.find(q => q.side === s && q.bin <= 0);\n  c.meter = 0; c.up = true; c.t = 0; c.aim = 0; c.done = false;\n  if (c.kicker) { c.kicker.x = c.x - d * 14; c.kicker.y = c.y; c.kicker.facing = s === 0 ? 0 : Math.PI; c.kicker.vx = c.kicker.vy = 0; }\n  SM.setPhase('conv');\n};\n// the outcome: power (0..1) and aim (-1..1) from the meter, or null for the CPU\nSM.decideKick = function (power, aim) {\n  const M = SM.M, c = M.conv, s = c.side;\n  const need = SM.clamp(c.dist / (TUNE('kickMax') * .9), .2, .95);\n  const k = c.kicker;\n  let good;\n  if (power === null) {\n    const kck = k ? k.stats.KCK : 6;\n    good = SM.R() < SM.clamp(.92 - c.dist / 1600 + (kck - 6) * .03, .3, .97);\n  } else good = Math.abs(power - need) < .07 && Math.abs(aim) < .35;\n  if (good) {\n    const pts = c.kind === 'pen' ? 3 : c.kind === 'drop' ? 3 : 2;\n    M.score[s] += pts; M.hype[s] = Math.min(100, M.hype[s] + 5 * TUNE('hypeMult'));\n    if (c.kind === 'conv') M.stats[s].conversions++;\n    SM.event('goal', { side: s, kind: c.kind, pts, name: k ? k.nick : '' });\n    M.conv = null;\n    if (M.golden) return SM.fullTime();\n    return SM.kickoff(s);\n  }\n  SM.event('miss', { side: s, kind: c.kind });\n  M.conv = null;\n  return SM.dropOut(1 - s);\n};\n\n// a 22 drop-out: the defenders restart from their own 22\nSM.dropOut = function (side) {\n  const M = SM.M, x = side === 0 ? SM.X0 + 225 : SM.X1 - 225;\n  const b = M.ball; b.owner = null; b.state = 'placed'; b.x = x; b.y = SM.CY; b.z = 0; b.vx = b.vy = b.vz = 0;\n  const pl = M.players.filter(q => q.side === side && q.bin <= 0).sort((a, c) => dist(a.x, a.y, x, SM.CY) - dist(c.x, c.y, x, SM.CY))[0];\n  if (pl) { pl.x = x - DIRS(side) * 10; pl.y = SM.CY; pl.facing = side === 0 ? 0 : Math.PI; b.x = pl.x + DIRS(side) * 6; b.y = pl.y; b.owner = pl; b.state = 'held'; }\n  SM.event('dropOut', { side });\n  SM.resumePlay();\n};\n\n// a scrum: the forwards bind at the mark; the timed push (CROUCH, BIND, SET) decides who wins the ball\nSM.startScrum = function (x, y, feedSide, forPen) {\n  const M = SM.M;\n  M.scrum = { x: SM.clamp(x, SM.X0 + 60, SM.X1 - 60), y: SM.clamp(y, SM.Y0 + 60, SM.Y1 - 60), feed: feedSide, t: 0, setAt: 1.9, early: false, pressedAt: null, push: [0, 0], resolveAt: 3.4 };\n  const b = M.ball; b.owner = null; b.state = 'placed'; b.x = M.scrum.x; b.y = M.scrum.y; b.z = 0; b.vx = b.vy = b.vz = 0;\n  for (const q of M.players) {\n    if (q.bin > 0 || q.pos > 2) continue;\n    const d = DIRS(q.side);\n    q.x = M.scrum.x - d * 6 + (q.side ? 0 : 0); q.y = M.scrum.y + (q.pos - 1) * 14; q.facing = q.side ? Math.PI : 0;\n  }\n  SM.setPhase('scrum');\n  SM.event('scrum', { x: M.scrum.x, y: M.scrum.y });\n};\n\n// the lineout: pods (front, middle, back) and a timed throw; a contest when both sides pick the same pod\nSM.startLineout = function (x, y, thrower) {\n  const M = SM.M;\n  M.lineout = { x: SM.clamp(x, SM.X0 + 40, SM.X1 - 40), y: SM.clamp(y, SM.Y0 + 60, SM.Y1 - 60), thrower, t: 0, pick: [null, null], resolveAt: 2.4 };\n  const b = M.ball; b.owner = null; b.state = 'placed'; b.x = M.lineout.x; b.y = M.lineout.y; b.z = 0; b.vx = b.vy = b.vz = 0;\n  SM.setPhase('lineout');\n  SM.event('lineout', { x: M.lineout.x, y: M.lineout.y, thrower });\n};\n\n// the ruck: the carrier goes down, the ball sits on the ground, both sides tug; the bar's end decides possession\nSM.startRuck = function (x, y, attackSide) {\n  const M = SM.M;\n  M.ruck = { x: SM.clamp(x, SM.X0 - 10, SM.X1 + 10), y: SM.clamp(y, SM.Y0 + 10, SM.Y1 - 10), attack: attackSide, bar: .2, t: 0, jackal: false, jackalAt: null };\n  const b = M.ball; b.owner = null; b.state = 'placed'; b.x = M.ruck.x; b.y = M.ruck.y; b.z = 0; b.vx = b.vy = b.vz = 0; b.lastTouch = attackSide;\n  SM.setPhase('ruck');\n  SM.event('ruck', { x: M.ruck.x, y: M.ruck.y });\n};\n\nSM.dropBall = function (p, spill) {\n  const M = SM.M, b = M.ball;\n  if (b.owner !== p) return;\n  b.owner = null; b.state = 'loose'; b.x = p.x + Math.cos(p.facing) * 8; b.y = p.y + Math.sin(p.facing) * 8; b.z = 6;\n  const sp = spill || 0;\n  b.vx = Math.cos(p.facing) * (30 + sp * 80); b.vy = Math.sin(p.facing) * (30 + sp * 80); b.vz = 30 + sp * 40; b.lastTouch = p.side; b.bounces = 0; b.droppedBy = p; b.kind = 'loose';\n};\n\n// the sides' possession and territory: time by the side holding the ball and the ball's half\nSM.tally = function (dt) {\n  const M = SM.M, b = M.ball;\n  if (b.owner) M.stats[b.owner.side].poss += dt;\n  if (b.state !== 'placed' || M.phase !== 'scrum') {\n    const inOpp = (side) => (side === 0 ? b.x > SM.CX : b.x < SM.CX);\n    M.stats[0].terr += inOpp(0) ? dt : 0; M.stats[1].terr += inOpp(1) ? dt : 0;\n  }\n};\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AaJMp6HMnwo58Z5iMXijA4","type":"tool_result","content":"The file /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-070011__xa7e588/work/Smashby-Rugby-claude-haiku-5-5-medium-20261104-070011/src/10-sim.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"5f6aeda2-f9ed-42d4-a150-3a2efde4ea9e","uuid":"72ab9310-f7a3-4107-881f-d3a60f1b662c","timestamp":"2026-11-04T14:06:15.458Z","tool_use_result":{"type":"update","filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-070011__xa7e588/work/Smashby-Rugby-claude-haiku-5-5-medium-20261104-070011/src/10-sim.js","content":"// THE MATCH SIMULATION: rules, physics, contact, set pieces, the AI. It reads intents and writes match state; it never\n// draws. Seeded (SM.seed), fixed-step (the engine's update), every number from SM.TUNE.v. A human seat's intent is read\n// from its engine input by SM.readSeat(); the CPU's comes from SM.brain(). Both give the same shape:\n//   { mx, my (the stick), turbo (held), press: { tackle, sidestep, fend, dive, passUp, passDown, kick, superPress, mash,\n//     jackal, switchUp, switchDown, chooseUp, chooseDown, scrumPress }, kickHeld (bool), kickReleased (bool) }\nSM.M = null;\nconst G = 600;                                       // ball gravity (units per second squared)\nconst DIRS = s => (s === 0 ? 1 : -1);               // side 0 attacks toward +x, side 1 toward -x\nconst dist = (ax, ay, bx, by) => Math.hypot(ax - bx, ay - by);\nconst ANG = (a, b) => { let d = b - a; while (d > Math.PI) d -= 2 * Math.PI; while (d < -Math.PI) d += 2 * Math.PI; return d; };\nconst TUNE = k => SM.TUNE.v[k];\nconst approach = (v, target, step) => (v < target ? Math.min(target, v + step) : Math.max(target, v - step));\nconst emptyIntent = () => ({ mx: 0, my: 0, turbo: false, press: {}, kickHeld: false, kickReleased: false });\nSM.approach = approach; SM.emptyIntent = emptyIntent; SM.ANG = ANG; SM.DIRS = DIRS;\n\nconst statsBlock = () => ({ tries: 0, conversions: 0, tackles: 0, missed: 0, bigHits: 0, monster: 0, metres: 0, breaks: 0, turnovers: 0, cards: 0, poss: 0, terr: 0, passes: 0, kicks: 0, carries: 0 });\n\n// a player: the stats are the team sheet's five numbers (speed, power, hands, kicking, tackling)\nfunction makePlayer(side, pos, def, idx) {\n  const [name, nick, role, build, size, hair, hairC, skin, hat, stats] = def;\n  return {\n    i: idx, side, pos, role, name, nick, build, size, hair, hairC, skin, hat,\n    stats: { SPD: stats[0], POW: stats[1], HND: stats[2], KCK: stats[3], TKL: stats[4] },\n    x: 0, y: 0, z: 0, vx: 0, vy: 0, vz: 0, facing: side ? Math.PI : 0,\n    st: 'run', stT: 0, cool: 0, turbo: TUNE('turboTank'), evade: 0, evadeT: 0, fendT: 0, fendCD: 0, diveT: 0, bigCharge: 0, bigHeld: false,\n    stunT: 0, bin: 0, onFire: false, cheer: 0, mudT: 0, aiT: 0, plan: null, planT: 0, seat: null, homeT: 0, toasted: 0,\n    lastPass: 0, holdKick: 0, kickHeld: false, switchCD: 0, superT: 0\n  };\n}\n\n// the match: teams are indexes into SM.TEAMS; venue into SM.VENUES\nSM.newMatch = function (o) {\n  SM.seed(o.seed || 1);\n  const venue = SM.VENUES[o.venue || 0];\n  const teams = [SM.TEAMS[o.home || 0], SM.TEAMS[o.away == null ? 1 : o.away]];\n  const M = {\n    teams, venue, half: 1, run: 0, halfLen: o.halves || TUNE('halfLength'), phase: 'kickoff', pt: 0, score: [0, 0], hype: [0, 0],\n    players: [], ball: null, hooter: false, hooterWait: false, golden: false, over: false, attract: !!o.attract, cup: !!o.cup,\n    stats: [statsBlock(), statsBlock()], events: [], seats: [], ruck: null, scrum: null, lineout: null, pen: null, conv: null, tryT: 0,\n    lastTry: [-1, -1], lastTouch: 0, kickSide: 0, kickT: 0, halfT: 0, powerups: [], powerupT: 25, mud: [], grates: [], lightning: null,\n    lightningT: 20, grateT: 9, wind: 0, windT: 18, windDir: 0, wind2: 0, refX: SM.CX, refY: SM.Y1 + 30, superT: [0, 0], fail: null,\n    banner: null, bannerT: 0, t: 0, passes: 0, carrier: null, flightKind: null, scorer: null, ruckWon: [0, 0], clucky: null, scrumOver: false\n  };\n  SM.M = M;\n  if (venue.mud) for (let k = 0; k < 6; k++) M.mud.push({ x: SM.lerp(SM.X0 + 120, SM.X1 - 120, SM.fx()), y: SM.lerp(SM.Y0 + 60, SM.Y1 - 60, SM.fx()), r: 28 + SM.fx() * 26 });\n  if (venue.id === 'furnace') for (let k = 0; k < 8; k++) M.grates.push({ x: SM.lerp(SM.X0 + 100, SM.X1 - 100, k / 7), y: SM.Y0 + 22, state: 'cold', t: 0 }, { x: SM.lerp(SM.X0 + 100, SM.X1 - 100, k / 7), y: SM.Y1 - 22, state: 'cold', t: 0 });\n  for (let s = 0; s < 2; s++) teams[s].players.forEach((def, k) => M.players.push(makePlayer(s, k, def, s * 7 + k)));\n  M.ball = { x: SM.CX, y: SM.CY, z: 0, vx: 0, vy: 0, vz: 0, state: 'placed', owner: null, lastTouch: 0, kind: null, passer: null, receiver: null, spin: 0, roll: 0, flightTo: null, bounces: 0, droppedBy: null };\n  for (const h of o.humans || []) SM.seatPlayer({ input: h.input, name: h.name || 'P' + (M.seats.length + 1), color: h.color }, M.players.find(q => q.side === h.side && q.pos === h.pos));\n  SM.kickoff(o.kickSide || 0);\n  return M;\n};\n\n// seats: a human's input and the player it drives\nSM.seatPlayer = function (seatDef, p) {\n  const M = SM.M;\n  const seat = Object.assign({}, seatDef, { p: null });\n  M.seats.push(seat);\n  if (p) SM.takeControl(seat, p);\n  return seat;\n};\nSM.takeControl = function (seat, p) {\n  const M = SM.M;\n  if (seat.p) seat.p.seat = null;\n  const prev = p.seat; if (prev && prev !== seat) prev.p = null;\n  seat.p = p; p.seat = seat;\n};\n\n// kick-offs, the formation: the kicking side in its own half, the receivers spread across the other half\nSM.kickoff = function (kickSide) {\n  const M = SM.M;\n  if (M.hooter && M.half === 2) return SM.fullTime();\n  if (M.hooter) return SM.halfOver();\n  M.phase = 'kickoff'; M.pt = 0; M.kickSide = kickSide; M.kickT = 1.2;\n  const b = M.ball; b.owner = null; b.state = 'placed'; b.x = SM.CX; b.y = SM.CY; b.z = 0; b.vx = b.vy = b.vz = 0;\n  for (const p of M.players) {\n    if (p.bin > 0) continue;\n    const d = DIRS(p.side), k = p.pos;\n    if (p.side === kickSide) {\n      const fh = k === 4;\n      p.x = fh ? SM.CX - d * 4 : SM.CX - d * (48 + k * 6); p.y = fh ? SM.CY : SM.CY + (k - 3) * 34;\n    } else {\n      p.x = SM.CX + d * (150 + (k % 3) * 24); p.y = SM.CY + (k - 3) * 52;\n    }\n    p.y = SM.clamp(p.y, SM.Y0 + 14, SM.Y1 - 14);\n    p.vx = p.vy = 0; p.facing = p.side ? Math.PI : 0; p.st = 'run'; p.stT = 0; p.fendT = p.evade = p.diveT = 0; p.z = 0; p.vz = 0;\n  }\n  SM.event('kickoff', { side: kickSide });\n};\nSM.event = (t, data) => { const e = Object.assign({ t }, data || {}); SM.M.events.push(e); return e; };\n\n// the spot a player wants: the attacking shape behind the ball, or the defensive line in front of each attacker\nSM.shapeFor = function (p) {\n  const M = SM.M, b = M.ball, d = DIRS(p.side);\n  const haveBall = b.owner && b.owner.side === p.side;\n  const attacking = haveBall || (b.state !== 'held' && b.lastTouch === p.side && b.state !== 'placed');\n  if (attacking) {\n    if (b.owner === p) return [b.x, b.y];\n    const slots = [[-14, -26], [-8, 0], [-14, 26], [-22, 0], [-42, 0], [-60, -24], [-84, -54]];\n    const s = slots[p.pos];\n    const tx = b.x + d * s[0], ty = b.y + s[1];\n    return [SM.clamp(tx, SM.X0 - 40, SM.X1 + 40), SM.clamp(ty, SM.Y0 + 14, SM.Y1 - 14)];\n  }\n  // defending: the attackers by y; each defender sits in front of the attacker of the same rank\n  const atk = M.players.filter(q => q.side !== p.side && q.bin <= 0).sort((a, c) => a.y - c.y);\n  const mine = M.players.filter(q => q.side === p.side && q.bin <= 0).sort((a, c) => a.y - c.y);\n  const rank = Math.max(0, mine.indexOf(p)), target = atk[Math.min(atk.length - 1, rank)];\n  if (!target) return [b.x, b.y];\n  const dd = DIRS(target.side);\n  return [SM.clamp(target.x + dd * 26, SM.X0 - 30, SM.X1 + 30), SM.clamp(target.y, SM.Y0 + 14, SM.Y1 - 14)];\n};\n\n// a kick: the apex sets the flight; the landing spot sets the speed (2 * vz / G seconds in the air)\nSM.kickFlight = function (fromX, fromY, tx, ty, apex, kind, kicker) {\n  const b = SM.M.ball, dx = tx - fromX, dy = ty - fromY, d = Math.hypot(dx, dy) || 1;\n  const vz = Math.sqrt(2 * G * apex), T = 2 * vz / G, sp = d / T;\n  b.x = fromX; b.y = fromY; b.z = 8; b.vx = dx / d * sp; b.vy = dy / d * sp; b.vz = vz;\n  b.state = 'air'; b.owner = null; b.kind = kind; b.passer = kicker || null; b.receiver = null; b.spin = 0; b.flightTo = [tx, ty];\n  b.lastTouch = kicker ? kicker.side : b.lastTouch;\n  if (kicker) SM.M.stats[kicker.side].kicks++;\n};\n\n// pass: a low, quick ball to the receiver's lead point; it is caught inside his reach (SM.ballStep decides)\nSM.passTo = function (p, recv) {\n  const M = SM.M, b = M.ball, T = TUNE('passSpeed');\n  const d = dist(p.x, p.y, recv.x, recv.y), t = d / T;\n  const tx = recv.x + recv.vx * t * .8, ty = recv.y + recv.vy * t * .8;\n  const dx = tx - p.x, dy = ty - p.y, L = Math.hypot(dx, dy) || 1;\n  b.x = p.x + dx / L * 8; b.y = p.y + dy / L * 8; b.z = 10; b.vx = dx / L * T; b.vy = dy / L * T; b.vz = 0;\n  b.state = 'pass'; b.owner = null; b.kind = 'pass'; b.passer = p; b.receiver = recv; b.lastTouch = p.side; b.bounces = 0;\n  M.stats[p.side].passes++; M.passes++;\n  p.cool = .15;\n};\n\n// the legal receivers from p: teammates behind or level with him (never in front: no forward passes), on the side asked\nSM.legalReceivers = function (p, up) {\n  const M = SM.M, d = DIRS(p.side);\n  return M.players.filter(q => q.side === p.side && q !== p && q.bin <= 0 && q.st !== 'tackled' && q.st !== 'ground' && q.stunT <= 0 &&\n    (q.x - p.x) * d <= 4 && dist(p.x, p.y, q.x, q.y) < 230 && (up ? q.y < p.y - 2 : q.y > p.y + 2)).sort((a, c) => Math.abs(a.y - p.y) - Math.abs(c.y - p.y));\n};\n\n// the referee: standing behind play on the attack side, seeing a cone toward the ball\nSM.refUpdate = function (dt) {\n  const M = SM.M, b = M.ball, atk = b.lastTouch;\n  const d = DIRS(atk);\n  const tx = b.x - d * 56, ty = SM.Y1 + 32;\n  M.refX = SM.lerp(M.refX, SM.clamp(tx, SM.X0 - 60, SM.X1 + 60), .08); M.refY = SM.lerp(M.refY, ty, .08);\n  M.refFace = Math.atan2(b.y - M.refY, b.x - M.refX);\n};\nSM.refSees = function (p) {\n  if (SM.CHEATS.refBlind) return false;\n  if (SM.CHEATS.refStrict) return true;\n  const M = SM.M, dx = p.x - M.refX, dy = p.y - M.refY, d = Math.hypot(dx, dy);\n  if (d > TUNE('refRange') || d < 1) return d < 1;\n  return Math.abs(ANG(M.refFace, Math.atan2(dy, dx))) < TUNE('refFov') / 2 + .2;\n};\n\n// a foul: the penalty goes to the other side at the mark. The offender may be carded (cheap and high tackles).\nSM.foul = function (kind, offender, x, y, seenOnly) {\n  const M = SM.M;\n  const seen = seenOnly ? SM.refSees(offender) : true;\n  if (!seen) { SM.event('unseen', { kind, side: offender.side }); return false; }\n  const pen = M.pen = { side: 1 - offender.side, x: SM.clamp(x, SM.X0 + 10, SM.X1 - 10), y: SM.clamp(y, SM.Y0 + 10, SM.Y1 - 10), kind, offender, choice: null, t: 0, wait: 0.4 };\n  SM.event('foul', { kind, side: offender.side, name: offender.nick });\n  if (kind === 'cheap' || kind === 'high') SM.sendOff(offender);\n  M.ball.owner = null; M.ball.state = 'placed'; M.ball.x = pen.x; M.ball.y = pen.y; M.ball.z = 0;\n  SM.setPhase('penalty');\n  return true;\n};\n\n// the sin bin: a yellow card, the team plays with six for sinBin seconds of play\nSM.sendOff = function (p) {\n  const M = SM.M;\n  p.bin = TUNE('sinBin'); p.st = 'bin'; p.seat = null;\n  M.stats[p.side].cards++;\n  if (M.ball.owner === p) SM.dropBall(p, 0);\n  for (const s of M.seats) if (s.p === p) { s.p = null; }\n  SM.event('yellow', { side: p.side, name: p.nick });\n  SM.replaceControl(p.side);\n};\n\n// the seats of a side that lost their player move to the nearest teammate with the ball or near it\nSM.replaceControl = function (side) {\n  const M = SM.M;\n  for (const s of M.seats) {\n    if (s.p) continue;\n    const cand = M.players.filter(q => q.side === side && q.bin <= 0 && !q.seat).sort((a, c) => dist(a.x, a.y, M.ball.x, M.ball.y) - dist(c.x, c.y, M.ball.x, M.ball.y))[0];\n    if (cand && s.side === undefined) SM.takeControl(s, cand);\n  }\n};\n\nSM.setPhase = function (name) {\n  const M = SM.M;\n  if (M.phase === name) return;\n  M.phase = name; M.pt = 0;\n  SM.event('phase', { name });\n};\n\n// when play would resume after a stoppage: the half ends if the hooter has gone\nSM.resumePlay = function () {\n  const M = SM.M;\n  if (M.hooter) { M.hooter = false; return SM.halfOver(); }\n  SM.setPhase('play');\n};\n\nSM.halfOver = function () {\n  const M = SM.M;\n  if (M.half === 1) {\n    M.half = 2; M.run = 0; M.hooter = false;\n    M.phase = 'half'; M.pt = 0; M.halfT = 3.0;\n    SM.event('halftime', { score: M.score.slice() });\n  } else SM.fullTime();\n};\nSM.fullTime = function () {\n  const M = SM.M;\n  if (M.score[0] === M.score[1] && !M.golden && !M.attract) {\n    M.golden = true; M.hooter = false; M.run = 0; SM.event('golden');\n    SM.kickoff(0); return;\n  }\n  M.over = true; M.phase = 'full'; M.pt = 0; M.hooter = false;\n  SM.event('fulltime', { score: M.score.slice() });\n};\n\n// a carrier over the try line: the try, the points, the celebrations and then the conversion\nSM.tryScored = function (p) {\n  const M = SM.M, s = p.side;\n  M.score[s] += 5; M.stats[s].tries++; M.hype[s] = Math.min(100, M.hype[s] + 15 * TUNE('hypeMult'));\n  M.scorer = p;\n  if (M.lastTry[s] === p.i) { p.onFire = true; SM.event('onFire', { name: p.nick, side: s }); }\n  M.lastTry[s] = p.i; M.lastTry[1 - s] = -1;\n  for (const q of M.players) if (q.side !== s) q.onFire = false;\n  SM.event('try', { side: s, name: p.nick, x: p.x, y: p.y });\n  const b = M.ball; b.owner = null; b.state = 'placed'; b.x = p.x; b.y = p.y; b.z = 0; b.vx = b.vy = b.vz = 0;\n  for (const q of M.players) if (q.side === s && q !== p) q.cheer = 3;\n  p.cheer = 3;\n  SM.setPhase('try'); M.tryT = 3;\n  M.conv = { side: s, x: SM.clamp(p.x, SM.X0 + 4, SM.X1 - 4), y: p.y, kind: 'conv' };\n};\n\n// the conversion (or a penalty goal): the kicker places the ball, and the power meter decides it (human) or the roll\nSM.startConversion = function (kind) {\n  const M = SM.M, c = M.conv, s = c.side, d = DIRS(s);\n  c.kind = kind || c.kind; c.postX = s === 0 ? SM.POST1 : SM.POST0;\n  c.dist = Math.abs(c.postX - c.x);\n  c.kicker = M.players.find(q => q.side === s && q.pos === 4 && q.bin <= 0) || M.players.find(q => q.side === s && q.bin <= 0);\n  c.meter = 0; c.up = true; c.t = 0; c.aim = 0; c.done = false;\n  if (c.kicker) { c.kicker.x = c.x - d * 14; c.kicker.y = c.y; c.kicker.facing = s === 0 ? 0 : Math.PI; c.kicker.vx = c.kicker.vy = 0; }\n  SM.setPhase('conv');\n};\n// the outcome: power (0..1) and aim (-1..1) from the meter, or null for the CPU\nSM.decideKick = function (power, aim) {\n  const M = SM.M, c = M.conv, s = c.side;\n  const need = SM.clamp(c.dist / (TUNE('kickMax') * .9), .2, .95);\n  const k = c.kicker;\n  let good;\n  if (power === null) {\n    const kck = k ? k.stats.KCK : 6;\n    good = SM.R() < SM.clamp(.92 - c.dist / 1600 + (kck - 6) * .03, .3, .97);\n  } else good = Math.abs(power - need) < .07 && Math.abs(aim) < .35;\n  if (good) {\n    const pts = c.kind === 'pen' ? 3 : c.kind === 'drop' ? 3 : 2;\n    M.score[s] += pts; M.hype[s] = Math.min(100, M.hype[s] + 5 * TUNE('hypeMult'));\n    if (c.kind === 'conv') M.stats[s].conversions++;\n    SM.event('goal', { side: s, kind: c.kind, pts, name: k ? k.nick : '' });\n    M.conv = null;\n    if (M.golden) return SM.fullTime();\n    return SM.kickoff(s);\n  }\n  SM.event('miss', { side: s, kind: c.kind });\n  M.conv = null;\n  return SM.dropOut(1 - s);\n};\n\n// a 22 drop-out: the defenders restart from their own 22\nSM.dropOut = function (side) {\n  const M = SM.M, x = side === 0 ? SM.X0 + 225 : SM.X1 - 225;\n  const b = M.ball; b.owner = null; b.state = 'placed'; b.x = x; b.y = SM.CY; b.z = 0; b.vx = b.vy = b.vz = 0;\n  const pl = M.players.filter(q => q.side === side && q.bin <= 0).sort((a, c) => dist(a.x, a.y, x, SM.CY) - dist(c.x, c.y, x, SM.CY))[0];\n  if (pl) { pl.x = x - DIRS(side) * 10; pl.y = SM.CY; pl.facing = side === 0 ? 0 : Math.PI; b.x = pl.x + DIRS(side) * 6; b.y = pl.y; b.owner = pl; b.state = 'held'; }\n  SM.event('dropOut', { side });\n  SM.resumePlay();\n};\n\n// a scrum: the forwards bind at the mark; the timed push (CROUCH, BIND, SET) decides who wins the ball\nSM.startScrum = function (x, y, feedSide, forPen) {\n  const M = SM.M;\n  M.scrum = { x: SM.clamp(x, SM.X0 + 60, SM.X1 - 60), y: SM.clamp(y, SM.Y0 + 60, SM.Y1 - 60), feed: feedSide, t: 0, setAt: 1.9, early: false, pressedAt: null, push: [0, 0], resolveAt: 3.4 };\n  const b = M.ball; b.owner = null; b.state = 'placed'; b.x = M.scrum.x; b.y = M.scrum.y; b.z = 0; b.vx = b.vy = b.vz = 0;\n  for (const q of M.players) {\n    if (q.bin > 0 || q.pos > 2) continue;\n    const d = DIRS(q.side);\n    q.x = M.scrum.x - d * 6 + (q.side ? 0 : 0); q.y = M.scrum.y + (q.pos - 1) * 14; q.facing = q.side ? Math.PI : 0;\n  }\n  SM.setPhase('scrum');\n  SM.event('scrum', { x: M.scrum.x, y: M.scrum.y });\n};\n\n// the lineout: pods (front, middle, back) and a timed throw; a contest when both sides pick the same pod\nSM.startLineout = function (x, y, thrower) {\n  const M = SM.M;\n  M.lineout = { x: SM.clamp(x, SM.X0 + 40, SM.X1 - 40), y: SM.clamp(y, SM.Y0 + 60, SM.Y1 - 60), thrower, t: 0, pick: [null, null], resolveAt: 2.4 };\n  const b = M.ball; b.owner = null; b.state = 'placed'; b.x = M.lineout.x; b.y = M.lineout.y; b.z = 0; b.vx = b.vy = b.vz = 0;\n  SM.setPhase('lineout');\n  SM.event('lineout', { x: M.lineout.x, y: M.lineout.y, thrower });\n};\n\n// the ruck: the carrier goes down, the ball sits on the ground, both sides tug; the bar's end decides possession\nSM.startRuck = function (x, y, attackSide) {\n  const M = SM.M;\n  M.ruck = { x: SM.clamp(x, SM.X0 - 10, SM.X1 + 10), y: SM.clamp(y, SM.Y0 + 10, SM.Y1 - 10), attack: attackSide, bar: .2, t: 0, jackal: false, jackalAt: null };\n  const b = M.ball; b.owner = null; b.state = 'placed'; b.x = M.ruck.x; b.y = M.ruck.y; b.z = 0; b.vx = b.vy = b.vz = 0; b.lastTouch = attackSide;\n  SM.setPhase('ruck');\n  SM.event('ruck', { x: M.ruck.x, y: M.ruck.y });\n};\n\nSM.dropBall = function (p, spill) {\n  const M = SM.M, b = M.ball;\n  if (b.owner !== p) return;\n  b.owner = null; b.state = 'loose'; b.x = p.x + Math.cos(p.facing) * 8; b.y = p.y + Math.sin(p.facing) * 8; b.z = 6;\n  const sp = spill || 0;\n  b.vx = Math.cos(p.facing) * (30 + sp * 80); b.vy = Math.sin(p.facing) * (30 + sp * 80); b.vz = 30 + sp * 40; b.lastTouch = p.side; b.bounces = 0; b.droppedBy = p; b.kind = 'loose';\n};\n\n// the sides' possession and territory: time by the side holding the ball and the ball's half\nSM.tally = function (dt) {\n  const M = SM.M, b = M.ball;\n  if (b.owner) M.stats[b.owner.side].poss += dt;\n  if (b.state !== 'placed' || M.phase !== 'scrum') {\n    const inOpp = (side) => (side === 0 ? b.x > SM.CX : b.x < SM.CX);\n    M.stats[0].terr += inOpp(0) ? dt : 0; M.stats[1].terr += inOpp(1) ? dt : 0;\n  }\n};\n","structuredPatch":[{"oldStart":1,"oldLines":351,"newStart":1,"newLines":332,"lines":["-// THE MATCH SIMULATION: rules, physics, contact, set pieces and the AI. It reads intents and writes match state; it","-// never draws. Seeded (SM.seed), fixed-step (the engine's update), and every number is read from SM.TUNE.v.","-// A human seat gives an intent per step: { mx, my (stick), turbo, pass ('up'|'down'|null), tackle (press), tackleHeld,","-// sidestep, fend, dive, kick (held), kickUp (released), superPress, mashPress, jackalPress, choose }.","-SM.M = null;   // the live match","-const G = 600;            // the ball's gravity (units per second squared)","-const DIR = s => s === 0 ? 1 : -1;   // side 0 attacks toward +x (the right of the screen), side 1 toward -x","+// THE MATCH SIMULATION: rules, physics, contact, set pieces, the AI. It reads intents and writes match state; it never","+// draws. Seeded (SM.seed), fixed-step (the engine's update), every number from SM.TUNE.v. A human seat's intent is read","+// from its engine input by SM.readSeat(); the CPU's comes from SM.brain(). Both give the same shape:","+//   { mx, my (the stick), turbo (held), press: { tackle, sidestep, fend, dive, passUp, passDown, kick, superPress, mash,","+//     jackal, switchUp, switchDown, chooseUp, chooseDown, scrumPress }, kickHeld (bool), kickReleased (bool) }","+SM.M = null;","+const G = 600;                                       // ball gravity (units per second squared)","+const DIRS = s => (s === 0 ? 1 : -1);               // side 0 attacks toward +x, side 1 toward -x"," const dist = (ax, ay, bx, by) => Math.hypot(ax - bx, ay - by);"," const ANG = (a, b) => { let d = b - a; while (d > Math.PI) d -= 2 * Math.PI; while (d < -Math.PI) d += 2 * Math.PI; return d; };","-const SIDE_OF = (teamIdx) => teamIdx;   // (a side is a team; the home team is side 0)","+const TUNE = k => SM.TUNE.v[k];","+const approach = (v, target, step) => (v < target ? Math.min(target, v + step) : Math.max(target, v - step));","+const emptyIntent = () => ({ mx: 0, my: 0, turbo: false, press: {}, kickHeld: false, kickReleased: false });","+SM.approach = approach; SM.emptyIntent = emptyIntent; SM.ANG = ANG; SM.DIRS = DIRS;"," ","-// A player: the body, the stats, the state machine and the input (or none for an AI player)","-function makePlayer(side, pos, def, teamDef, idx) {","+const statsBlock = () => ({ tries: 0, conversions: 0, tackles: 0, missed: 0, bigHits: 0, monster: 0, metres: 0, breaks: 0, turnovers: 0, cards: 0, poss: 0, terr: 0, passes: 0, kicks: 0, carries: 0 });","+","+// a player: the stats are the team sheet's five numbers (speed, power, hands, kicking, tackling)","+function makePlayer(side, pos, def, idx) {","   const [name, nick, role, build, size, hair, hairC, skin, hat, stats] = def;","   return {","     i: idx, side, pos, role, name, nick, build, size, hair, hairC, skin, hat,","     stats: { SPD: stats[0], POW: stats[1], HND: stats[2], KCK: stats[3], TKL: stats[4] },","-    x: 0, y: 0, z: 0, vx: 0, vy: 0, facing: side ? Math.PI : 0,","-    st: 'run', stT: 0, cool: 0, turbo: 3, turboOn: false, evade: 0, spinT: 0, fendT: 0, diveT: 0, bigT: 0, bigHeld: false,","-    tackleT: 0, stunT: 0, bin: 0, onFire: false, cheer: 0, mudT: 0, jackalT: 0, lastSide: side,","-    input: null, aiT: 0, aiFor: 0, power: 0, kickHeld: 0, kickCharge: false,","-    team: teamDef, hitBy: null, ballCarried: 0, pieFx: 0, inPlay: true","+    x: 0, y: 0, z: 0, vx: 0, vy: 0, vz: 0, facing: side ? Math.PI : 0,","+    st: 'run', stT: 0, cool: 0, turbo: TUNE('turboTank'), evade: 0, evadeT: 0, fendT: 0, fendCD: 0, diveT: 0, bigCharge: 0, bigHeld: false,","+    stunT: 0, bin: 0, onFire: false, cheer: 0, mudT: 0, aiT: 0, plan: null, planT: 0, seat: null, homeT: 0, toasted: 0,","+    lastPass: 0, holdKick: 0, kickHeld: false, switchCD: 0, superT: 0","   };"," }"," ","-// The venue's floor features and sky events (the mud, the wind, the lightning and the flame grates)","-function venueState(venue) {","-  const M = SM.M;","-  M.mud = []; M.grates = []; M.lightning = null; M.windT = 0; M.windDir = 0; M.wind = 0; M.clucky = 0;","-  if (venue.mud) for (let k = 0; k < 6; k++) M.mud.push({ x: SM.lerp(SM.X0 + 100, SM.X1 - 100, SM.fx()), y: SM.lerp(SM.Y0 + 60, SM.Y1 - 60, SM.fx()), r: 30 + SM.fx() * 30 });","-  if (venue.id === 'furnace') for (let k = 0; k < 8; k++) M.grates.push({ x: SM.lerp(SM.X0 + 100, SM.X1 - 100, k / 7), y: SM.Y0 + 20, phase: 0, t: 0 }, { x: SM.lerp(SM.X0 + 100, SM.X1 - 100, k / 7), y: SM.Y1 - 20, phase: 0, t: 0 });","-}","-","-// Build a match. o: { home, away (team indices), venue (venue index), halves (seconds per half), humans:[{ input, side, pos }], attract, cup, seed }","+// the match: teams are indexes into SM.TEAMS; venue into SM.VENUES"," SM.newMatch = function (o) {","   SM.seed(o.seed || 1);","   const venue = SM.VENUES[o.venue || 0];","-  const teams = [SM.TEAMS[o.home || 0], SM.TEAMS[o.away || 1]];","+  const teams = [SM.TEAMS[o.home || 0], SM.TEAMS[o.away == null ? 1 : o.away]];","   const M = {","-    teams, venue, half: 1, run: 0, halfLen: o.halves || SM.TUNE.v.halfLength, phase: 'kickoff', pt: 0, score: [0, 0], hype: [0, 0],","-    players: [], ball: null, hooter: false, golden: false, over: false, attract: !!o.attract, cup: !!o.cup, stats: [{ tries: 0, tackles: 0, missed: 0, bigHits: 0, monster: 0, metres: 0, breaks: 0, turnovers: 0, cards: 0, poss: 0, terr: 0, passes: 0, kicks: 0 }, { tries: 0, tackles: 0, missed: 0, bigHits: 0, monster: 0, metres: 0, breaks: 0, turnovers: 0, cards: 0, poss: 0, terr: 0, passes: 0, kicks: 0 }],","-    events: [], ruck: null, scrum: null, lineout: null, pen: null, conv: null, tryStreak: [null, null], lastTry: [0, 0], lastTouch: 0,","-    kickSide: 0, kickT: 0, dropAt: null, powerups: [], powerupT: 25, pickup: null, humanSeats: [], refX: 0, refY: 0, ruckWon: 0,","-    clock: 0, lastScorer: null, goalKick: null, flight: null, t: 0, banner: null, bannerT: 0, passCount: 0, rulesLog: [],","-    sinBinned: [0, 0], pos: null, fail: null","+    teams, venue, half: 1, run: 0, halfLen: o.halves || TUNE('halfLength'), phase: 'kickoff', pt: 0, score: [0, 0], hype: [0, 0],","+    players: [], ball: null, hooter: false, hooterWait: false, golden: false, over: false, attract: !!o.attract, cup: !!o.cup,","+    stats: [statsBlock(), statsBlock()], events: [], seats: [], ruck: null, scrum: null, lineout: null, pen: null, conv: null, tryT: 0,","+    lastTry: [-1, -1], lastTouch: 0, kickSide: 0, kickT: 0, halfT: 0, powerups: [], powerupT: 25, mud: [], grates: [], lightning: null,","+    lightningT: 20, grateT: 9, wind: 0, windT: 18, windDir: 0, wind2: 0, refX: SM.CX, refY: SM.Y1 + 30, superT: [0, 0], fail: null,","+    banner: null, bannerT: 0, t: 0, passes: 0, carrier: null, flightKind: null, scorer: null, ruckWon: [0, 0], clucky: null, scrumOver: false","   };","   SM.M = M;","-  venueState(venue);","-  // the players: seven a side, in their formation order","-  for (let s = 0; s < 2; s++) {","-    teams[s].players.forEach((def, k) => {","-      const p = makePlayer(s, k, def, teams[s], s * 7 + k);","-      p.body = new My3D2dge.Body({ x: 0, y: 0, r: 5, friction: 0, gravity: 0 });","-      p.rig = new My3D2dge.Humanoid({ size: p.size, build: p.build, hair: p.hair === 'bald' ? 'bald' : p.hair, weapon: null, hat: p.hat === 'none' ? undefined : p.hat,","-        colors: Object.assign({ cloth: teams[s].colors.cloth, trim: teams[s].colors.trim, pants: teams[s].colors.pants, boot: teams[s].colors.boot, belt: teams[s].colors.belt, hair: p.hairC, skin: p.skin }, s === 1 && teams[s].away ? teams[s].away : {}) });","-      M.players.push(p);","-    });","-  }","-  // the referee walks the pitch behind play; the commentators are the presentation's business","-  M.ball = { x: SM.CX, y: SM.CY, z: 0, vx: 0, vy: 0, vz: 0, state: 'placed', owner: null, lastTouch: 0, kickBy: null, spin: 0, roll: 0, bounce: 0, flightTo: null, ready: 0 };","-  // seats: humans get their player (the first forward of side 0 unless given)","-  if (o.humans) for (const h of o.humans) {","-    const p = M.players.find(q => q.side === h.side && q.pos === h.pos);","-    if (p) { p.input = h.input; M.humanSeats.push(p); }","-  }","-  // the cheats of the dev panel: every cheat is read in the sim, never stored in the tuning","-  SM.kickoff(0);","+  if (venue.mud) for (let k = 0; k < 6; k++) M.mud.push({ x: SM.lerp(SM.X0 + 120, SM.X1 - 120, SM.fx()), y: SM.lerp(SM.Y0 + 60, SM.Y1 - 60, SM.fx()), r: 28 + SM.fx() * 26 });","+  if (venue.id === 'furnace') for (let k = 0; k < 8; k++) M.grates.push({ x: SM.lerp(SM.X0 + 100, SM.X1 - 100, k / 7), y: SM.Y0 + 22, state: 'cold', t: 0 }, { x: SM.lerp(SM.X0 + 100, SM.X1 - 100, k / 7), y: SM.Y1 - 22, state: 'cold', t: 0 });","+  for (let s = 0; s < 2; s++) teams[s].players.forEach((def, k) => M.players.push(makePlayer(s, k, def, s * 7 + k)));","+  M.ball = { x: SM.CX, y: SM.CY, z: 0, vx: 0, vy: 0, vz: 0, state: 'placed', owner: null, lastTouch: 0, kind: null, passer: null, receiver: null, spin: 0, roll: 0, flightTo: null, bounces: 0, droppedBy: null };","+  for (const h of o.humans || []) SM.seatPlayer({ input: h.input, name: h.name || 'P' + (M.seats.length + 1), color: h.color }, M.players.find(q => q.side === h.side && q.pos === h.pos));","+  SM.kickoff(o.kickSide || 0);","   return M;"," };"," ","-// the formation spots: a kickoff (the kicking side kicks from the centre) and the in-play shape","+// seats: a human's input and the player it drives","+SM.seatPlayer = function (seatDef, p) {","+  const M = SM.M;","+  const seat = Object.assign({}, seatDef, { p: null });","+  M.seats.push(seat);","+  if (p) SM.takeControl(seat, p);","+  return seat;","+};","+SM.takeControl = function (seat, p) {","+  const M = SM.M;","+  if (seat.p) seat.p.seat = null;","+  const prev = p.seat; if (prev && prev !== seat) prev.p = null;","+  seat.p = p; p.seat = seat;","+};","+","+// kick-offs, the formation: the kicking side in its own half, the receivers spread across the other half"," SM.kickoff = function (kickSide) {","   const M = SM.M;","-  M.phase = 'kickoff'; M.pt = 0; M.kickSide = kickSide; M.kickT = 1.4;","-  M.ball.owner = null; M.ball.state = 'placed'; M.ball.x = SM.CX; M.ball.y = SM.CY; M.ball.z = 0; M.ball.vx = M.ball.vy = M.ball.vz = 0;","+  if (M.hooter && M.half === 2) return SM.fullTime();","+  if (M.hooter) return SM.halfOver();","+  M.phase = 'kickoff'; M.pt = 0; M.kickSide = kickSide; M.kickT = 1.2;","+  const b = M.ball; b.owner = null; b.state = 'placed'; b.x = SM.CX; b.y = SM.CY; b.z = 0; b.vx = b.vy = b.vz = 0;","   for (const p of M.players) {","     if (p.bin > 0) continue;","-    const d = DIR(p.side), k = p.pos;","+    const d = DIRS(p.side), k = p.pos;","     if (p.side === kickSide) {","       const fh = k === 4;","-      p.x = fh ? SM.CX - d * 6 : SM.CX - d * (50 + k * 10); p.y = fh ? SM.CY : SM.CY + (k % 2 ? 30 : -30) + (k - 3) * 6;","+      p.x = fh ? SM.CX - d * 4 : SM.CX - d * (48 + k * 6); p.y = fh ? SM.CY : SM.CY + (k - 3) * 34;","     } else {","-      p.x = SM.CX + d * (140 + (k % 3) * 25); p.y = SM.CY + (k - 3) * 52;","+      p.x = SM.CX + d * (150 + (k % 3) * 24); p.y = SM.CY + (k - 3) * 52;","     }","-    p.y = SM.clamp(p.y, SM.Y0 + 14, SM.Y1 - 14); p.vx = p.vy = 0; p.facing = p.side ? Math.PI : 0; p.st = 'run'; p.stT = 0; p.evade = p.fendT = p.diveT = 0;","+    p.y = SM.clamp(p.y, SM.Y0 + 14, SM.Y1 - 14);","+    p.vx = p.vy = 0; p.facing = p.side ? Math.PI : 0; p.st = 'run'; p.stT = 0; p.fendT = p.evade = p.diveT = 0; p.z = 0; p.vz = 0;","   }","-  M.events.push({ t: 'kickoff', side: kickSide });","+  SM.event('kickoff', { side: kickSide });"," };","+SM.event = (t, data) => { const e = Object.assign({ t }, data || {}); SM.M.events.push(e); return e; };"," ","-// the spot a player wants this step. With the ball (side in possession): the attack shape behind the carrier; without","-// it: the nearest two chase the ball, the rest hold the defensive line in front of their attackers.","+// the spot a player wants: the attacking shape behind the ball, or the defensive line in front of each attacker"," SM.shapeFor = function (p) {","-  const M = SM.M, b = M.ball, d = DIR(p.side), inPos = M.ball.owner && M.ball.owner.side === p.side;","-  const attacking = inPos || (M.ball.state === 'loose' && M.ball.lastTouch === p.side);","-  const bx = b.x, by = b.y;","+  const M = SM.M, b = M.ball, d = DIRS(p.side);","+  const haveBall = b.owner && b.owner.side === p.side;","+  const attacking = haveBall || (b.state !== 'held' && b.lastTouch === p.side && b.state !== 'placed');","   if (attacking) {","+    if (b.owner === p) return [b.x, b.y];","     const slots = [[-14, -26], [-8, 0], [-14, 26], [-22, 0], [-42, 0], [-60, -24], [-84, -54]];","     const s = slots[p.pos];","-    let tx = bx + d * s[0], ty = by + s[1];","-    // the backs spread, and never stand in front of the carrier","-    if (M.ball.owner && M.ball.owner === p) { tx = bx; ty = by; }","-    if (p.pos >= 5 && M.ball.owner && M.ball.owner.side === p.side) tx = Math.min(tx, bx - d * 6) * (d > 0 ? 1 : 1);","+    const tx = b.x + d * s[0], ty = b.y + s[1];","     return [SM.clamp(tx, SM.X0 - 40, SM.X1 + 40), SM.clamp(ty, SM.Y0 + 14, SM.Y1 - 14)];","   }","-  // defending: the defensive line, each man paired with an attacker by y","-  const atk = M.players.filter(q => q.side !== p.side && q.bin <= 0).sort((a, b2) => a.y - b2.y);","-  const mine = M.players.filter(q => q.side === p.side && q.bin <= 0).sort((a, b2) => a.y - b2.y);","-  const rank = mine.indexOf(p);","-  const target = atk[Math.min(atk.length - 1, Math.max(0, rank))];","-  if (!target) return [bx, by];","-  const dd = DIR(target.side);","-  // the defender in front of his man, toward the goal he is defending","-  return [SM.clamp(target.x + dd * 28, SM.X0 - 30, SM.X1 + 30), SM.clamp(target.y, SM.Y0 + 14, SM.Y1 - 14)];","+  // defending: the attackers by y; each defender sits in front of the attacker of the same rank","+  const atk = M.players.filter(q => q.side !== p.side && q.bin <= 0).sort((a, c) => a.y - c.y);","+  const mine = M.players.filter(q => q.side === p.side && q.bin <= 0).sort((a, c) => a.y - c.y);","+  const rank = Math.max(0, mine.indexOf(p)), target = atk[Math.min(atk.length - 1, rank)];","+  if (!target) return [b.x, b.y];","+  const dd = DIRS(target.side);","+  return [SM.clamp(target.x + dd * 26, SM.X0 - 30, SM.X1 + 30), SM.clamp(target.y, SM.Y0 + 14, SM.Y1 - 14)];"," };"," ","-// kicks: a ball flight with the apex height given; the horizontal speed lands it at tx, ty","-SM.kickFlight = function (fromX, fromY, tx, ty, apex, kind) {","+// a kick: the apex sets the flight; the landing spot sets the speed (2 * vz / G seconds in the air)","+SM.kickFlight = function (fromX, fromY, tx, t