dex, I.aimSource]; game._p1 = [I.lastDevice, I.padIndex, I.aimSource];\n3832:  if (game._lobby) { game._lobby.tick(dt); if (game._lobby.pressed('join') && !P.some(q => q.half === 'right') && I.lastDevice !== 'gamepad') game.addPlayer({ keys: 'right' }); }\n3838:    if (I.padIndex === p.index) { I.consumeAll(); [I.lastDevice, , I.aimSource] = was; game._p1 = was; }   // (that Start was the joiner's: player 1 neither pauses nor turns to the pad)\n7742:     *  is none); volume: master volume 0..1; sfxVolume, musicVolume, voiceVolume: 0..1 for effects, music and the voice\n7744:    this._game = game; this._signal = signal; this.ctx = null; this.volume = .7; this.sfxVolume = 1; this.musicVolume = .5; this.voiceVolume = 1; this.muted = false;\n7777:  /** apply volume, musicVolume, sfxVolume and mute after setting them directly (setVolume and mute call it) */\n7778:  applyVolume() { if (!this.ctx) return; this._master.gain.value = this.muted ? 0 : this.volume; this._sfxBus.gain.value = this.sfxVolume; this._musBus.gain.value = this.musicVolume * (this._ducked || [... omitted end of long line]\n7781:   *  voiceVolume) or 'master'. Returns a GainNode, or null where there is no sound (headless, no Web Audio) */\n9211:      const p = inp.lastDevice === 'mouse' && inp.pointer(), hv = p && (!this._hp || p[0] !== this._hp[0] || p[1] !== this._hp[1]) ? row(p) : -1; this._hp = p ? p.slice() : null;\n9417:   * new E.Shell(game, { theme, screens: { name: spec }, settings: { items, onChange(settings, key) }, store: 'shell-settings',\n9437:    if (o.settings && o.settings.onChange) S.onChange = k => o.settings.onChange(S, k);\n9654:    const S = this._game.settings, coarse = window.matchMedia && matchMedia('(any-pointer: coarse)').matches, touch = I._touchArgs && (coarse || I._touched || S.touch === 'on');\n9655:    const touchRows = () => { add(this._el('div', 'esh-k esh-sec', 'Touch')); for (const k of S.keys('Touch')) add(this._row(k)); }, first = touch && I.lastDevice === 'touch';\n11072:  _panelH() { return this.game.input.lastDevice === 'touch' ? this._thumb() + 14 : this.ui === 'verbs' ? 56 : 30; }\n11082:    const L = this._layout(), touch = I.lastDevice === 'touch', p = I.pointer(), c = I.clicked(), right = !!(I.map.look && I.pressed('look')), drop = I.pressed('cancel'), lp = I.longPress(), d2 = I.do [... omitted end of long line]\n11110:    const R = this.rooms[this.room], L = this._layout(), G = this.game, touch = G.input.lastDevice === 'touch', z = L.z, pad = [].concat(R.pad || 0), px0 = pad[0], py0 = pad[1] || 0;\n11884:    const font = E.font, bw = Math.floor(W / 2) - 34, ca = this.game.input.lastDevice === 'touch' && this.game.cornerArea ? this.game.cornerArea() : null, y = ca && ca.y0 < 40 ? Math.ceil(ca.y1) + 6 : [... omitted end of long line]\n14687:      else if (this.selected.length && I.lastDevice === 'touch') { const p = at(...c); if (p) { this.smart(this.selected, p[0], p[1], u, { queue: sh }); if (this.on.ordered) this.on.ordered(p, u); } } [... omitted end of long line]\n// The ARCADE kit's game (a cabinet of three: maze, formation, rocks), readable: the starter's shell (src/starter/00-shell.js), then\n// the slice from line 159 (src/starter/32-arcade.js: its header says what it plays and how), then the start (90-start.js), as the\n// single-file kit holds them between GAME START and GAME END. arcade.html plays it; node kits/test.mjs arcade runs it headless.\n/* ============================== GAME START ==============================\n * MY-3D2DGE STARTER: a title menu and vertical slices, one per genre (a genre kit file holds one; the file with every\n * slice adds an animation lab). Each slice is a complete small game, written to be copied and changed: its own header\n * (below this shell) says what it plays, its keys and touch controls, its deep links and how it works.\n * FULL SCREEN, ANY SHAPE: res: 'ps1', expand: true. 320 x 240 is the least the screen shows; a wider or taller window\n * shows more world (r.W x r.H grows), so every HUD anchors to r.W and r.H, never to 320 and 240, and every level fills\n * what a wide screen or an upright phone shows. Prompts name the player's own keys: prompt('attack', 'Sword').\n * To make your own game: change the slice closest to your genre into yours, with its own title, play and game-over\n * scenes, and delete this menu and the slices you do not use; this shell (the game, its scenes, prompt, best and the\n * proof) stays unless you replace it. Deep links: #<slice> starts a slice, #<slice>/<part> jumps into a part.\n * ======================================================================== */\n(() => {\n'use strict';\nconst E = My3D2dge, { px, clamp, lerp, approach, TAU } = E;\n\n/* ---- SHELL: one game, several scenes. Each slice switches view, keys and resolution on entry ----\n * expand: the picture fills the window, any shape, with no bars: at least 320 x 240 (a slice's res), more on the long side */\nconst game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'side', bg: '#07060d' });\nconst P = game.particles, L = game.lights, A = game.audio;\nconst scenes = {};\nlet gpu = null;                               // WebGPU lighting, used by the adventure slice only\nconst best = (k, v) => { const old = E.store.get('best:' + k, 0); if (v > old) E.store.set('best:' + k, v); return Math.max(old, v); };\n// a prompt in the player's own controls, after rebinding: 'J Sword' on a keyboard, 'X Sword' on a pad, 'ATTACK Sword' (the\n// button's name) on a touch screen, where the buttons sit over the bottom corner: touch() says so, to move a prompt off it\nconst prompt = (a, word) => game.input.label(a) + ' ' + word, touch = () => game.input.lastDevice === 'touch';\n// each slice: its scene's id, its title entry, a line about it, and its family (the title groups them under it)\nconst SLICES = [\n  { id: 'adventure', label: 'ADVENTURE', about: 'TOP-DOWN ACTION ADVENTURE', family: 'ACTION ADVENTURE' },\n  { id: 'pointclick', label: 'POINT-AND-CLICK', about: 'RELIGHT THE LIGHTHOUSE ON GULL ROCK', family: 'ADVENTURE' },\n  { id: 'platformer', label: 'PLATFORMER', about: 'SIDE-SCROLLING PLATFORMER', family: 'PLATFORM' },\n  { id: 'metroidvania', label: 'METROIDVANIA', about: 'A WORLD OF ROOMS, ITS MAP, ITS GATES', family: 'PLATFORM' },\n  { id: 'brawler', label: 'BRAWLER', about: 'SIDE-SCROLLING BEAT-EM-UP', family: 'FIGHTING' },\n  { id: 'fighting', label: 'FIGHTING', about: 'ONE ON ONE, BEST OF THREE', family: 'FIGHTING' },\n  { id: 'shooter', label: 'SHOOTER', about: 'VERTICAL SHOOT-EM-UP', family: 'ARCADE' },\n  { id: 'arcade', label: 'ARCADE', about: 'A CABINET OF THREE CLASSICS', family: 'ARCADE' },\n  { id: 'pinball', label: 'PINBALL', about: 'ONE TABLE: RAMP, MULTIBALL, JACKPOT', family: 'ARCADE' },\n  { id: 'kart', label: 'KART', about: 'MODE 7 KARTS, THREE LAPS', family: 'RACING' },\n","exit_code":0,"status":"completed"}}
