{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc 'cat src/network.js'","aggregated_output":"/* The Inconspicuous Wizard — authoritative AI Hub shared-world adapter.\n * Wire v1: 12 reliable input heartbeats/s, 9 reliable full snapshots/s.\n * No socket, broker, matchmaking service, or Hub lifecycle emulation.\n */\n(function (root) {\n  'use strict';\n  const VERSION = 1;\n  const NEUTRAL = Object.freeze({ move: -1, aim: -1, fire: false });\n  const FIXED_DT = 1 / 120;\n  const clampDir = value => Number.isInteger(value) && value >= -1 && value <= 3 ? value : -1;\n  const sanitizeCommand = command => ({ move: clampDir(command?.move), aim: clampDir(command?.aim), fire: command?.fire === true });\n  const bytes = value => typeof TextEncoder !== 'undefined' ? new TextEncoder().encode(JSON.stringify(value)).length : JSON.stringify(value).length;\n\n  class WizardNetwork {\n    constructor(hooks = {}, hub = root.AIHub) {\n      this.hooks = hooks;\n      this.hub = hub;\n      this.active = false;\n      this.running = false;\n      this.ended = false;\n      this.finished = false;\n      this.server = false;\n      this.isHost = false;\n      this.localSeat = -1;\n      this.sim = null;\n      this.info = null;\n      this.players = [];\n      this.seatByPeer = new Map();\n      this.commands = [];\n      this.lastInput = [];\n      this.acks = [];\n      this.lastSnapshot = -1;\n      this.inputSequence = 0;\n      this.snapshotSequence = 0;\n      this.clock = 0;\n      this.lastInputSend = -Infinity;\n      this.lastStateSend = -Infinity;\n      this.unsubscribers = [];\n      this.metrics = { sent: 0, received: 0, rejected: 0, dropped: 0, maxBytes: 0, finishes: 0, snapshots: 0, inputs: 0, maxPerSecond: 0 };\n      this.sentAt = [];\n      this.pendingStart = false;\n      this.pump = null;\n    }\n\n    async connect() {\n      if (!this.hub) return null;\n      const on = (event, callback) => this.unsubscribers.push(this.hub.on(event, callback));\n      on('start', () => {\n        this.pendingStart = true;\n        if (this.sim && !this.ended) this.start();\n      });\n      on('message', (data, from) => this.receive(data, from));\n      on('leave', info => this.leave(info));\n      on('time-up', () => this.finish(false, 'time-up'));\n      on('end', info => this.end(info));\n      const info = await this.hub.connect({ mode: 'shared-world', seats: [1, 2] });\n      if (!info) {\n        this.unsubscribers.splice(0).forEach(fn => fn?.());\n        return null;\n      }\n      this.active = true;\n      this.info = info;\n      this.server = info.server === true;\n      this.isHost = info.isHost === true;\n      this.players = info.players.map(player => ({ id: player.id, name: String(player.name || ''), color: player.color }));\n      this.players.forEach((player, index) => this.seatByPeer.set(player.id, index));\n      this.localSeat = this.seatByPeer.has(info.me) ? this.seatByPeer.get(info.me) : -1;\n      this.commands = this.players.map(() => ({ ...NEUTRAL }));\n      this.lastInput = this.players.map(() => -Infinity);\n      this.acks = this.players.map(() => -1);\n      // Retain the named Hub gameplay stream; world creation consumes one seed.\n      // The simulation serializes its own stateful continuation for checkpoint fidelity.\n      this.rng = this.hub.rng('simulation');\n      const seed = Math.floor(this.rng() * 4294967296) >>> 0;\n      const create = this.hooks.createSim || (options => new root.WizardSim.Sim(options));\n      this.sim = create({ difficulty: 'normal', seats: this.players.length, seed, online: true });\n      await this.hooks.onSession?.(this.sim, info);\n      if (this.pendingStart) this.start();\n      // Readiness is independent of audio gesture and controller availability.\n      if (!this.ended) this.hub.ready();\n      return info;\n    }\n\n    start() {\n      if (this.running || this.ended) return;\n      this.running = true;\n      this.hooks.onStart?.();\n    }\n\n    /** Optional wall-clock driver. It advances a no-player/hidden host without a camera or RAF.\n     * Do not also call tick() from the engine when this pump is enabled. */\n    startPump(commandProvider = () => NEUTRAL) {\n      if (!this.active || this.pump || this.ended) return;\n      let previous = root.performance?.now?.() ?? Date.now();\n      let accumulator = 0;\n      this.pump = root.setInterval(() => {\n        if (this.ended) return;\n        const now = root.performance?.now?.() ?? Date.now();\n        accumulator += Math.min(0.25, Math.max(0, (now - previous) / 1000));\n        previous = now;\n        while (accumulator >= FIXED_DT && !this.ended) {\n          this.tick(FIXED_DT, commandProvider());\n          accumulator -= FIXED_DT;\n        }\n      }, 8);\n    }\n\n    tick(dt, command = NEUTRAL) {\n      if (!this.active || this.ended || this.finished || !this.sim) return;\n      if (!Number.isFinite(dt) || dt <= 0) return;\n      this.clock += Math.min(0.25, dt);\n      if (!this.running || this.hub.time() < 0) return;\n      if (this.localSeat >= 0 && this.seatByPeer.has(this.info.me)) {\n        this.commands[this.localSeat] = sanitizeCommand(command);\n        this.lastInput[this.localSeat] = this.clock;\n      }\n      if (this.isHost) {\n        this.commands.forEach((cmd, seat) => {\n          if (this.clock - this.lastInput[seat] > 0.65) this.commands[seat] = { ...NEUTRAL };\n        });\n        this.sim.step(Math.min(dt, 0.05), this.commands);\n        if (this.clock - this.lastStateSend >= 1 / 9) {\n          this.lastStateSend = this.clock;\n          this.broadcast();\n        }\n        const state = this.sim.s;\n        if (state.phase === 'victory' || state.phase === 'defeat') this.finish(state.phase === 'victory', state.phase);\n      } else if (this.clock - this.lastInputSend >= 1 / 12) {\n        this.lastInputSend = this.clock;\n        this.send({ v: VERSION, t: 'input', n: ++this.inputSequence, seat: this.localSeat, c: this.localSeat >= 0 ? this.commands[this.localSeat] : NEUTRAL }, { to: this.info.host, reliable: true });\n      }\n    }\n\n    send(packet, options) {\n      if (!this.active || this.ended) return false;\n      const size = bytes(packet);\n      this.metrics.maxBytes = Math.max(this.metrics.maxBytes, size);\n      if (size > 16000) {\n        this.metrics.rejected++;\n        this.hooks.onError?.('World snapshot exceeds the Hub message limit.');\n        return false;\n      }\n      const sent = this.hub.send(packet, options);\n      if (sent === false) this.metrics.dropped++;\n      else {\n        this.metrics.sent++;\n        this.sentAt.push(this.clock);\n        this.sentAt = this.sentAt.filter(at => this.clock - at < 1);\n        this.metrics.maxPerSecond = Math.max(this.metrics.maxPerSecond, this.sentAt.length);\n      }\n      return sent;\n    }\n\n    broadcast() {\n      if (!this.isHost || !this.sim || this.ended) return false;\n      const snapshot = this.sim.snapshot({ network: true });\n      const packet = { v: VERSION, t: 'state', n: ++this.snapshotSequence, ack: this.acks.slice(), s: snapshot };\n      const sent = this.send(packet, { reliable: true });\n      if (sent !== false) this.metrics.snapshots++;\n      return sent;\n    }\n\n    receive(data, from) {\n      if (!this.active || this.ended || !data || typeof data !== 'object' || Array.isArray(data) || data.v !== VERSION) return this.reject();\n      if (bytes(data) > 16384 || !Number.isSafeInteger(data.n) || data.n < 0) return this.reject();\n      if (this.isHost) {\n        const seat = this.seatByPeer.get(from);\n        if (data.t !== 'input' || seat === undefined || from === this.info.me || data.seat !== seat || data.n <= this.acks[seat]) return this.reject();\n        const c = data.c;\n        if (!c || !Number.isInteger(c.move) || c.move < -1 || c.move > 3 || !Number.isInteger(c.aim) || c.aim < -1 || c.aim > 3 || typeof c.fire !== 'boolean') return this.reject();\n        this.acks[seat] = data.n;\n        this.commands[seat] = sanitizeCommand(c);\n        this.lastInput[seat] = this.clock;\n        this.metrics.inputs++;\n      } else {\n        if (from !== this.info.host || data.t !== 'state' || data.n <= this.lastSnapshot || !data.s || !Array.isArray(data.s.players) || data.s.players.length > 2 || !Number.isInteger(data.s.roomIndex) || data.s.roomIndex < 0 || data.s.roomIndex > 5) return this.reject();\n        this.lastSnapshot = data.n;\n        this.sim.load(data.s);\n        this.hooks.onSnapshot?.(this.sim);\n        this.metrics.snapshots++;\n      }\n      this.metrics.received++;\n    }\n\n    reject() {\n      this.metrics.rejected++;\n      return false;\n    }\n\n    leave({ id, reason } = {}) {\n      if (!this.active || this.ended || !this.seatByPeer.has(id)) return;\n      const seat = this.seatByPeer.get(id);\n      this.seatByPeer.delete(id);\n      this.players = this.players.filter(player => player.id !== id);\n      this.commands[seat] = { ...NEUTRAL };\n      this.lastInput[seat] = -Infinity;\n      if (this.isHost) {\n        if (typeof this.sim.removeSeat === 'function') this.sim.removeSeat(seat);\n        this.broadcast();\n      }\n      this.hooks.onLeave?.({ id, seat, reason });\n    }\n\n    finish(won, reason = 'finished') {\n      if (!this.active || this.ended || this.finished || !this.isHost || !this.sim) return;\n      this.finished = true;\n      this.broadcast();\n      const state = this.sim.s;\n      const score = Number.isFinite(state.score) ? state.score : 0;\n      const ids = this.players.map(player => player.id);\n      const stats = {};\n      for (const id of ids) {\n        const seat = this.seatByPeer.get(id);\n        const player = state.players.find(p => p.seat === seat);\n        stats[id] = { 'Chambers reached': Number(state.roomIndex || 0) + 1, 'Team score': score, 'Hunter catches': player?.kills || player?.stats?.kills || 0, 'Outcome': reason };\n      }\n      this.metrics.finishes++;\n      this.hub.finish({ standings: [ids], scores: Object.fromEntries(ids.map(id => [id, score])), won: won === true, stats });\n      this.hooks.onFinish?.({ won: won === true, reason });\n    }\n\n    end(info = {}) {\n      if (this.ended) return;\n      this.ended = true;\n      this.running = false;\n      this.commands = this.commands.map(() => ({ ...NEUTRAL }));\n      if (this.pump) root.clearInterval(this.pump);\n      this.pump = null;\n      this.hooks.onEnd?.(info);\n    }\n\n    dispose() {\n      this.end({ reason: 'disposed' });\n      this.unsubscribers.splice(0).forEach(fn => fn?.());\n    }\n  }\n  WizardNetwork.NEUTRAL = NEUTRAL;\n  WizardNetwork.sanitizeCommand = sanitizeCommand;\n  WizardNetwork.VERSION = VERSION;\n  root.WizardNetwork = WizardNetwork;\n})(globalThis);\n","exit_code":0,"status":"completed"}}
