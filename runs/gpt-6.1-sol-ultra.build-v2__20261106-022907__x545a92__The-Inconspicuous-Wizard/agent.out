{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"rg -n 'mouseScreen\\\\(' vendor/my-3d2dge.js | head -10; ls tests; cat > evidence/issues.json <<'EOF'\n[\n {\\\"id\\\":\\\"render-string-id\\\",\\\"critical\\\":false,\\\"summary\\\":\\\"String entity IDs produced NaN procedural phases; used entity animation phase instead.\\\"},\n {\\\"id\\\":\\\"seat-identity\\\",\\\"critical\\\":false,\\\"summary\\\":\\\"Partner rendering assumed one-based seats; fixed zero-based identity/accessory distinction.\\\"},\n {\\\"id\\\":\\\"audio-event-map\\\",\\\"critical\\\":false,\\\"summary\\\":\\\"Actual hyphenated simulation events did not trigger most custom SFX/voices; mapped real events.\\\"},\n {\\\"id\\\":\\\"bounty-help\\\",\\\"critical\\\":false,\\\"summary\\\":\\\"Help stated2500 while game announced1000 exit bounty; made1000 consistent.\\\"},\n {\\\"id\\\":\\\"checkpoint-continue\\\",\\\"critical\\\":true,\\\"summary\\\":\\\"Continue restored state without room-entry checkpoint; load full save envelope for correct retry.\\\"},\n {\\\"id\\\":\\\"keyboard-coop-aim\\\",\\\"critical\\\":false,\\\"summary\\\":\\\"Keyboard partner aim keys missing from input map; explicit per-seat bindings now installed.\\\"},\n {\\\"id\\\":\\\"corrupt-save\\\",\\\"critical\\\":true,\\\"summary\\\":\\\"Corrupt persisted simulation could reach renderer; validate version/room/entity arrays/tuning at storage boundary.\\\"}\n]\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
