{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"head -100 content/rooms.js; head -125 src/sim.js; sed -n '1,135p' src/render.js; cat tests/render-smoke.mjs; ls -l src\"","aggregated_output":"/* Original authored chambers. Coordinates are grid-cell centers. */\n(function(G){\n'use strict';\nconst W=19,H=13;\nfunction chamber(o){\n const r=Array.from({length:H},(_,y)=>Array.from({length:W},(_,x)=>x===0||x===W-1||y===0||y===H-1?'#':'.'));\n for(const [x,y,w,h] of o.walls) for(let j=y;j<y+h;j++)for(let i=x;i<x+w;i++)r[j][i]='#';\n for(const [x,y] of o.open||[])r[y][x]='.';\n r[6][0]=r[6][18]='P';for(const[x,y]of o.posts)r[y][x]='B';\n o.rows=r.map(a=>a.join(''));o.width=W;o.height=H;\n o.entrances=[[1,11],[17,11]];o.portals=[[0,6],[18,6]];\n const starts=[[2,1],[9,1],[16,1],[1,4],[17,4],[2,9],[16,9],[9,10]];\n o.spawns=[];\n for(let i=0;i<o.count;i++){\n   let type=i<o.initialVisible?'hopper':o.roster[(i-o.initialVisible)%o.roster.length];\n   let p=starts[(i*3+o.index)%starts.length];\n   if(r[p[1]][p[0]]==='#')p=[9,11];\n   o.spawns.push({type,x:p[0],y:p[1],after:i<4?0:i-3,delay:i<4?i*2.2:0.7+(i%3)*0.6});\n }\n delete o.walls;delete o.open;return o;\n}\nconst ROOMS=[\n chamber({index:0,name:'The Brass Threshold',subtitle:'A lantern. A lane. A very bad invitation.',intro:'WARDEN! Every shot must return. Make the long ones count.',hint:'Move, face a lane, and fire. Your muzzle glows when the bolt returns.',palette:['#211b31','#64516c','#e8ad57'],walls:[[3,2,4,2],[11,2,5,2],[3,6,4,3],[10,6,4,3],[15,5,1,5],[8,3,1,3]],posts:[],count:12,initialVisible:12,roster:['hopper'],wizard:0,familiarStart:[9,1],familiarSide:0}),\n chamber({index:1,name:'The Unseen Choir',subtitle:'The empty corridor is occupied.',intro:'Hear that? The radar sees what your lantern cannot.',hint:'Hidden hunters appear in a shared straight corridor. Walls block the view; facing does not.',palette:['#1c2333','#4d6375','#7ad5cd'],walls:[[3,2,3,3],[8,1,3,3],[13,2,3,3],[2,8,3,2],[7,6,4,3],[13,8,4,2]],posts:[],count:16,initialVisible:4,roster:['stalker','hopper','stalker'],wizard:1,familiarStart:[9,5],familiarSide:1}),\n chamber({index:2,name:'The Bellkeeper’s Vault',subtitle:'Spend a shot. Borrow a secret.',intro:'Shoot a brass bell. It reveals nearby hunters and draws them along the lanes.',hint:'A bell spends your one bolt: reveal, lure, then reposition. Blue gates cross the dungeon.',palette:['#262039','#6c587a','#d9b65f'],walls:[[3,2,3,3],[8,2,3,2],[13,2,3,3],[4,7,3,3],[12,7,3,3],[9,6,1,3]],posts:[[1,8],[6,4],[12,4],[9,10]],count:18,initialVisible:4,roster:['stalker','skitter','hopper'],wizard:0,familiarStart:[9,5],familiarSide:0}),\n chamber({index:3,name:'The Crossed Court',subtitle:'Cover your partner. Count your echoes.',intro:'The court is open. Let the lanes do the fighting.',hint:'Four lives at most. A fallen partner returns when the room clears.',palette:['#292030','#75566b','#f6a46b'],walls:[[4,3,2,2],[13,3,2,2],[8,6,3,2],[4,9,2,1],[13,9,2,1]],posts:[[9,3],[2,8],[16,8]],count:22,initialVisible:4,roster:['hopper','stalker','skitter','stalker'],wizard:0,familiarStart:[9,1],familiarSide:1}),\n chamber({index:4,name:'The Crooked Observatory',subtitle:'His eyes. Your blind corners.',intro:'“MY STARS! Must you keep surviving?”',hint:'Long lanes delay your next shot. Refuges buy a shorter return.',palette:['#1c243c','#536384','#acb9fc'],walls:[[4,2,1,7],[8,4,1,7],[12,2,1,7],[15,4,1,7]],open:[[4,5],[8,7],[12,5],[15,7]],posts:[[2,3],[10,8],[17,9]],count:23,initialVisible:3,roster:['stalker','skitter','hopper','skitter'],wizard:1,familiarStart:[9,1],familiarSide:0}),\n chamber({index:5,name:'The Last Word',subtitle:'He has three. You need only one each.',intro:'The exit bounty is 1,000. Catch his familiar. Banish all three boasts. Make it FOURFOLD.',hint:'Three manifestations. One hit each. Read the rune, take a lane, and commit.',palette:['#271a31','#68405e','#ef82b4'],walls:[[4,4,2,2],[13,4,2,2],[8,8,3,2],[8,2,3,1]],posts:[[2,8],[16,8]],count:19,initialVisible:3,roster:['skitter','stalker','hopper'],wizard:3,familiarStart:[9,5],familiarSide:1})\n];\nG.WizardRooms={ROOMS,W,H};\n})(globalThis);\n/* Authoritative, deterministic simulation. No renderer, input device or wall clock required. */\n(function(G){\n'use strict';\nconst {ROOMS,W,H}=G.WizardRooms;\nconst DIRS=[[1,0],[0,1],[-1,0],[0,-1]], EPS=1e-7;\nconst DEFAULTS={playerSpeed:4,boltSpeed:12,fireInterval:.17,hopperSpeed:1.05,stalkerSpeed:1.45,skitterSpeed:2.05,pressureGrowth:.002,pressureCap:1.28,spawnSpacing:1.1,familiarSpeed:2.45,wizardTeleport:5.1,wizardAttack:1.65,wizardWarning:1.35,respawnProtection:1.25,revealRadius:3,revealDuration:1.25,lureRadius:5,lureDuration:1.5,postCooldown:5};\nconst DIFFICULTIES={gentle:{lives:5,speed:.76,warnings:1.4},normal:{lives:3,speed:1,warnings:1},fierce:{lives:3,speed:1.2,warnings:.82}};\nconst clone=x=>JSON.parse(JSON.stringify(x));\nconst dist=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y);\nconst validDir=d=>Number.isInteger(d)&&d>=0&&d<4;\nconst cellKey=(x,y)=>`${x},${y}`;\nfunction cardinal(a,b){const dx=b.x-a.x,dy=b.y-a.y;return Math.abs(dx)>Math.abs(dy)?dx>=0?0:2:dy>=0?1:3;}\nfunction cellToWorld(n){return n*16;}\nfunction worldToCell(n){return n/16;}\nfunction walkable(room,x,y){return x>=0&&x<W&&y>=0&&y<H&&room.rows[y][x]!=='#'&&room.rows[y][x]!=='B';}\nfunction tileOpen(room,x,y){return x>=0&&x<W&&y>=0&&y<H&&room.rows[y][x]!=='#';}\nfunction path(room,from,to,max=999){\n const sx=Math.round(from.x),sy=Math.round(from.y),tx=Math.round(to.x),ty=Math.round(to.y);\n if(sx===tx&&sy===ty)return [];\n const q=[[sx,sy]],seen=new Map([[cellKey(sx,sy),null]]);let qi=0,found=false;\n while(qi<q.length&&qi<max*W*H){const[x,y]=q[qi++];for(let d=0;d<4;d++){const[nx,ny]=[x+DIRS[d][0],y+DIRS[d][1]],k=cellKey(nx,ny);if(seen.has(k)||!walkable(room,nx,ny))continue;seen.set(k,[x,y,d]);q.push([nx,ny]);if(nx===tx&&ny===ty){found=true;break;}}if(found)break;}\n if(!found)return null;\n const out=[];let x=tx,y=ty;\n while(x!==sx||y!==sy){const p=seen.get(cellKey(x,y));out.push(p[2]);x=p[0];y=p[1];}return out.reverse();\n}\nfunction lineClear(room,a,b,tolerance=.22){\n if(Math.abs(a.x-b.x)>tolerance&&Math.abs(a.y-b.y)>tolerance)return false;\n const dx=b.x-a.x,dy=b.y-a.y,n=Math.max(1,Math.ceil(Math.hypot(dx,dy)*5));\n for(let i=0;i<=n;i++){const x=Math.round(a.x+dx*i/n),y=Math.round(a.y+dy*i/n);if(!tileOpen(room,x,y))return false;}return true;\n}\nfunction rayDistance(a,b,dir,radius=.35){\n const [dx,dy]=DIRS[dir];const along=(b.x-a.x)*dx+(b.y-a.y)*dy;const cross=Math.abs((b.x-a.x)*dy-(b.y-a.y)*dx);\n if(cross>radius||along < -radius)return Infinity;return Math.max(0,along-Math.sqrt(Math.max(0,radius*radius-cross*cross)));\n}\nclass Sim{\n constructor({difficulty='normal',seats=1,seed=0x51e110,attract=false,assistance=false}={}){\n  this.s={version:1,seed:seed>>>0,rng:(seed>>>0)||1,difficulty:DIFFICULTIES[difficulty]?difficulty:'normal',seats:Math.min(2,Math.max(1,seats)),activeSeats:Array.from({length:Math.min(2,Math.max(1,seats))},(_,i)=>i),tick:0,time:0,roomTime:0,phaseTime:0,roomIndex:0,phase:'entry',score:0,currentMultiplier:1,earnedNextMultiplier:1,practice:false,attract,assistance,players:[],enemies:[],bolts:[],posts:[],wizard:null,familiar:null,pending:[],events:[],eventSeq:0,nextId:1,tuning:{...DEFAULTS},pressure:1,invulnerable:false,timeScale:1,stats:{kills:0,shots:0,bells:0,portals:0,cloaked:0,familiars:0,escaped:0,wizardHits:0,rooms:0,damage:0,activeSeconds:0},roomKills:0,wizardStage:0,message:'',hint:'',noise:[]};\n  for(let seat=0;seat<this.s.seats;seat++)this.s.players.push({id:`p${seat}`,seat,x:seat?17:1,y:11,face:3,lives:this.difficulty.lives,alive:true,protect:1.25,respawnAt:0,boltId:null,lastFire:-1e3,wanted:-1,bufferUntil:0,moving:false,tx:0,ty:0,moveDir:3,recoil:0,hurt:0,stats:{kills:0,shots:0,bells:0}});\n  this.enterRoom(0);\n }\n get room(){return ROOMS[this.s.roomIndex];}\n get difficulty(){return DIFFICULTIES[this.s.difficulty];}\n rand(){let x=this.s.rng;x^=x<<13;x^=x>>>17;x^=x<<5;this.s.rng=x>>>0;return(this.s.rng>>>0)/4294967296;}\n id(prefix){return `${prefix}${this.s.nextId++}`;}\n event(type,x=0,y=0,extra={}){const e={id:++this.s.eventSeq,type,x,y,t:this.s.time,...extra};this.s.events.push(e);if(this.s.events.length>24)this.s.events.shift();return e;}\n setPhase(phase,message){this.s.phase=phase;this.s.phaseTime=0;if(message)this.s.message=message;this.event('phase',0,0,{phase,message:this.s.message});}\n enterRoom(index){\n  const s=this.s;s.roomIndex=Math.max(0,Math.min(5,index));s.roomTime=0;s.phaseTime=0;s.phase='entry';s.roomKills=0;s.wizardStage=0;s.enemies=[];s.bolts=[];s.familiar=null;s.wizard=null;s.noise=[];s.pending=this.room.spawns.map((x,i)=>({...clone(x),id:`q${i}`,at:x.after===0?x.delay:null,status:'waiting'}));s.posts=this.room.posts.map(([x,y],i)=>({id:`post${i}`,x,y,cooldown:0,ring:0}));s.pressure=1;s.message=this.room.intro;s.hint=this.room.hint;s.earnedNextMultiplier=1;\n  for(const p of s.players){p.x=p.seat?17:1;p.y=11;p.face=3;p.moving=false;p.wanted=-1;p.bufferUntil=0;p.boltId=null;p.protect=s.tuning.respawnProtection;p.respawnAt=0;p.alive=p.lives>0;p.portalLock=null;p.recoil=0;p.hurt=0;}\n  this.event('room',9,6,{roomIndex:s.roomIndex});this.checkpoint=clone(s);\n }\n snapshot({network=false}={}){const state=clone(this.s);if(network){state.events=state.events.slice(-12);state.noise=[];}return state;}\n save(){return {version:1,state:this.snapshot(),checkpoint:clone(this.checkpoint)};}\n load(data){if(data?.version!==1)throw Error('Unsupported simulation snapshot');const wrapped=data.state?data:null;this.s=clone(wrapped?wrapped.state:data);if(wrapped?.checkpoint)this.checkpoint=clone(wrapped.checkpoint);return this;}\n retry(){const cp=clone(this.checkpoint);if(!cp)return;this.s=cp;this.s.practice=true;this.s.phase='entry';this.s.phaseTime=0;this.s.timeScale=1;this.s.invulnerable=false;this.s.bolts=[];this.s.message='A borrowed lantern. A practice descent.';for(const p of this.s.players){p.lives=Math.max(3,p.lives);p.alive=true;p.boltId=null;p.protect=this.s.tuning.respawnProtection;}this.event('retry');}\n nextRoom(){const s=this.s;if(s.phase!=='clear')return false;s.currentMultiplier=s.earnedNextMultiplier;if(s.roomIndex>=5){this.victory();return true;}if(s.roomIndex===2||s.roomIndex===4){for(const p of s.players){p.lives=Math.min(4,Math.max(1,p.lives)+1);p.alive=true;}this.event('recovery');}for(const p of s.players)if(p.lives<=0){p.lives=1;p.alive=true;}s.stats.rooms++;this.enterRoom(s.roomIndex+1);return true;}\n removeSeat(seat){const s=this.s;const p=s.players.find(p=>p.seat===seat);if(p)this.clearBolt(p);s.players=s.players.filter(p=>p.seat!==seat);s.activeSeats=s.activeSeats.filter(i=>i!==seat);if(s.players.length&&s.players.every(p=>p.lives<=0))this.setPhase('defeat','The lanterns have gone out.');this.event('leave',0,0,{seat});}\n clearBolt(p){if(p.boltId)this.s.bolts=this.s.bolts.filter(b=>b.id!==p.boltId);p.boltId=null;}\n clear(){this.s.bolts=[];for(const p of this.s.players)p.boltId=null;this.setPhase('clear',`CHAMBER SEALED · Next chamber ${this.s.earnedNextMultiplier}×`);this.event('clear',9,6,{multiplier:this.s.earnedNextMultiplier});}\n victory(){const s=this.s;if(s.phase==='victory')return;s.score+=1000*s.earnedNextMultiplier;s.stats.rooms=6;s.bounty=1000*s.earnedNextMultiplier;s.bolts=[];s.enemies=[];s.wizard=null;for(const p of s.players){p.boltId=null;p.alive=p.lives>0;}this.setPhase('victory',`THE DUNGEON EXHALES. Exit bounty: ${s.bounty.toLocaleString()}.`);this.event('victory',9,6,{bounty:s.bounty});}\n startFamiliar(){const s=this.s;s.enemies=[];s.pending=[];const[x,y]=this.room.familiarStart;s.familiar={id:this.id('f'),x,y,face:2,warning:1.1*this.difficulty.warnings,moving:false,goal:this.room.familiarSide?18:0,portalLock:null,visible:true,state:'warning'};this.setPhase('familiar',s.roomIndex===5?'THE LAST FAMILIAR · Exit bounty 1,000 × your earned bonus!':'FAMILIAR LOOSE! Cover the glowing escape gate for a next-room bonus.');this.event('familiar',x,y,{side:this.room.familiarSide});}\n finishFamiliar(caught,owner){const s=this.s,f=s.familiar;if(!f)return;if(caught){this.award(200,owner);s.earnedNextMultiplier=Math.min(4,s.earnedNextMultiplier*2);s.stats.familiars++;this.event('familiar-hit',f.x,f.y,{owner,multiplier:s.earnedNextMultiplier});}else{s.stats.escaped++;this.event('familiar-escape',f.x,f.y);}s.familiar=null;if(this.room.wizard)this.startWizard();else this.clear();}\n startWizard(){this.s.familiar=null;this.s.wizardStage=0;this.s.wizardRelocations=0;this.setPhase('intrusion','“WHO SAID YOU COULD TOUCH MY BELLS?” Read the rune. One shot silences a boast.');this.placeWizard();}\n placeWizard(){\n  const s=this.s,players=s.players.filter(p=>p.alive);const p=players[Math.floor(this.rand()*Math.max(1,players.length))]||{x:1,y:11};const candidates=[];\n  for(let y=1;y<H-1;y++)for(let x=1;x<W-1;x++){const a={x,y};if(!walkable(this.room,x,y)||players.some(p=>dist(p,a)<3))continue;const los=lineClear(this.room,a,{x:Math.round(p.x),y:Math.round(p.y)},.2);candidates.push({x,y,weight:(los?0:8)+Math.abs(dist(p,a)-6)});}\n  candidates.sort((a,b)=>a.weight-b.weight);const c=candidates[Math.min(candidates.length-1,Math.floor(this.rand()*Math.min(5,candidates.length)))]||{x:9,y:1};\n  const relocations=s.wizardRelocations||0;s.wizardRelocations=relocations+1;s.wizard={id:this.id('w'),x:c.x,y:c.y,face:cardinal(c,p),state:'warning',vulnerable:relocations>0,relocations,warning:s.tuning.wizardWarning*this.difficulty.warnings+(s.roomIndex===1?.35:0),stage:s.wizardStage,cast:relocations?Math.min(.8,s.tuning.wizardAttack):.55,teleportIn:relocations?s.tuning.wizardTeleport:1.05,volleys:0};this.event('wizard-rune',c.x,c.y,{stage:s.wizardStage});\n }\n hitWizard(owner){const s=this.s,w=s.wizard;if(!w||w.state!=='active'||!w.vulnerable)return;s.stats.wizardHits++;this.award(500,owner);this.event('wizard-hit',w.x,w.y,{stage:s.wizardStage});s.wizardStage++;s.wizardRelocations=0;s.wizard=null;s.bolts=s.bolts.filter(b=>!b.hostile);if(s.wizardStage>=this.room.wizard){s.earnedNextMultiplier=Math.min(4,s.earnedNextMultiplier*2);this.event('wizard-banish',w.x,w.y,{multiplier:s.earnedNextMultiplier});if(s.roomIndex===5)this.victory();else this.clear();}else{s.message=['','','“THAT WAS MERELY MY SECOND OPINION!”'][s.wizardStage]||'“A LUCKY SHOT. ALLOW ME A DIFFERENT ARGUMENT.”';s.wizardBreak=1.5;}}\n award(base,owner){this.s.score+=base*this.s.currentMultiplier;const p=this.s.players.find(p=>p.id===owner);if(p)p.stats.kills++;}\n spawn(type,x,y,warning=.8){if(!['hopper','stalker','skitter'].includes(type))return;const e={id:this.id('e'),type,x,y,face:1,moveDir:1,moving:false,visible:type==='hopper',state:'warning',warning:warning*this.difficulty.warnings,spawnAt:this.s.time,activeAt:this.s.time+warning*this.difficulty.warnings,lureUntil:0,revealUntil:0,lureX:x,lureY:y,memory:null,patrol:null,thinkAt:0,phase:this.rand()*6.28};this.s.enemies.push(e);this.event('spawn',x,y,{type});return e;}\n killEnemy(e,owner){if(e.dead)return;e.dead=true;this.s.roomKills++;this.s.stats.kills++;this.award(e.type==='hopper'?50:e.type==='stalker'?100:150,owner);this.event('enemy-hit',e.x,e.y,{type:e.type,owner});}\n ring(post,owner){const s=this.s;if(post.cooldown>0)return;post.cooldown=s.tuning.postCooldown;post.ring=s.tuning.revealDuration;s.stats.bells++;const p=s.players.find(p=>p.id===owner);if(p)p.stats.bells++;this.event('bell',post.x,post.y,{radius:s.tuning.revealRadius});for(const e of s.enemies){if(e.dead||e.state==='warning')continue;const near=dist(e,post)<=s.tuning.revealRadius;if(near)e.revealUntil=Math.max(e.revealUntil,s.time+s.tuning.revealDuration);const goal=this.adjacentFloor(post,e);const route=path(this.room,e,goal);if(route&&route.length<=s.tuning.lureRadius){e.lureUntil=s.time+s.tuning.lureDuration;e.lureX=goal.x;e.lureY=goal.y;e.state='lured';}}}\n adjacentFloor(post,actor){let best=null,score=1e9;for(const[dx,dy]of DIRS){const p={x:post.x+dx,y:post.y+dy};if(!walkable(this.room,p.x,p.y))continue;const r=path(this.room,actor,p);if(r&&r.length<score){score=r.length;best=p;}}return best||{x:post.x,y:post.y};}\n damage(p,cause){const s=this.s;if(!p.alive||p.protect>0||s.invulnerable||s.attract)return;p.lives=Math.max(0,p.lives-1);p.alive=false;p.hurt=.5;p.respawnAt=s.time+.8;p.moving=false;p.wanted=-1;this.clearBolt(p);s.stats.damage++;this.event('life-lost',p.x,p.y,{seat:p.seat,lives:p.lives,cause});if(s.players.every(q=>q.lives<=0))this.setPhase('defeat','THE LANTERNS GO QUIET. He is trying not to look pleased.');}\n respawn(p){const s=this.s;p.x=p.seat?17:1;p.y=11;p.alive=true;p.moving=false;p.protect=s.tuning.respawnProtection;p.boltId=null;p.wanted=-1;p.portalLock=null;for(const e of s.enemies)if(dist(e,p)<3){const spot=this.farFloor(p);e.x=spot.x;e.y=spot.y;e.moving=false;e.warning=Math.max(.6,e.warning);e.state='warning';}s.bolts=s.bolts.filter(b=>!b.hostile||dist(b,p)>3);this.event('respawn',p.x,p.y,{seat:p.seat});}\n farFloor(p){let best={x:9,y:1},bestD=-1;for(let y=1;y<H-1;y++)for(let x=1;x<W-1;x++){const d=Math.hypot(x-p.x,y-p.y);if(walkable(this.room,x,y)&&d>bestD){bestD=d;best={x,y};}}return best;}\n move(a,speed,dt,want,fallback=true){let left=speed*dt,guard=0;while(left>EPS&&guard++<20){if(!a.moving){const d=validDir(want)&&walkable(this.room,Math.round(a.x)+DIRS[want][0],Math.round(a.y)+DIRS[want][1])?want:fallback&&validDir(a.moveDir)&&validDir(want)&&walkable(this.room,Math.round(a.x)+DIRS[a.moveDir][0],Math.round(a.y)+DIRS[a.moveDir][1])?a.moveDir:-1;if(d<0)break;a.x=Math.round(a.x);a.y=Math.round(a.y);a.moveDir=d;a.tx=a.x+DIRS[d][0];a.ty=a.y+DIRS[d][1];a.moving=true;}\n const d=Math.hypot(a.tx-a.x,a.ty-a.y),n=Math.min(left,d);if(d>EPS){a.x+=(a.tx-a.x)/d*n;a.y+=(a.ty-a.y)/d*n;}left-=n;if(d<=n+EPS){a.x=a.tx;a.y=a.ty;a.moving=false;}else break;}}\n portal(a,kind){if(a.portalLock){if(Math.abs(a.x-a.portalLock.x)>1.3||Math.abs(a.y-6)>1.3)a.portalLock=null;else return;}if(Math.abs(a.y-6)>.25||a.x>.1&&a.x<17.9)return;const s=this.s;if(kind==='familiar'){this.finishFamiliar(false);return;}const destination=a.x<1?17:1;a.x=destination;a.y=6;a.moving=false;a.portalLock={x:destination,until:s.time+.5};if(kind==='player'){a.protect=Math.max(a.protect,.4);s.stats.portals++;}this.event('portal',destination,6,{actor:a.id});}\n fire(p){const s=this.s;if(!p.alive||s.time-p.lastFire<s.tuning.fireInterval)return;if(p.boltId){if(!p.blockedAt||s.time-p.blockedAt>.4){this.event('blocked',p.x,p.y,{seat:p.seat});p.blockedAt=s.time;}return;}p.lastFire=s.time;p.recoil=.18;p.stats.shots++;s.stats.shots++;const id=this.id('b'),[dx,dy]=DIRS[p.face];s.bolts.push({id,owner:p.id,x:p.x+dx*.34,y:p.y+dy*.34,dir:p.face,hostile:false});p.boltId=id;this.event('fire',p.x,p.y,{seat:p.seat,dir:p.face});s.noise.push({x:p.x,y:p.y,t:s.time});if(s.noise.length>6)s.noise.shift();}\n updatePlayers(dt,commands){const s=this.s;for(const p of s.players){p.recoil=Math.max(0,p.recoil-dt);p.hurt=Math.max(0,p.hurt-dt);p.protect=Math.max(0,p.protect-dt);if(!p.alive){if(p.lives>0&&s.time>=p.respawnAt)this.respawn(p);continue;}const c=commands[p.seat]||{};if(validDir(c.move)){p.wanted=c.move;p.bufferUntil=s.time+.13;}else if(s.time>p.bufferUntil)p.wanted=-1;const desired=s.time<=p.bufferUntil?p.wanted:-1;this.move(p,s.tuning.playerSpeed,dt,desired,true);if(validDir(c.aim))p.face=c.aim;else if(p.moving)p.face=p.moveDir;if(c.fire)this.fire(p);this.portal(p,'player');}}\n updateEnemies(dt){const s=this.s;const players=s.players.filter(p=>p.alive);for(const e of s.enemies){if(e.dead)continue;e.warning=Math.max(0,e.warning-dt);if(e.warning>0){e.state='warning';e.visible=true;continue;}if(e.state==='warning'){e.state='hunt';e.activeAt=s.time+.08;}e.phase+=dt;let target=null;\n if(s.time<e.lureUntil){target={x:e.lureX,y:e.lureY};e.state='lured';}else{e.state='hunt';const visiblePlayers=players.filter(p=>lineClear(this.room,e,p));if(visiblePlayers.length){visiblePlayers.sort((a,b)=>dist(a,e)-dist(b,e));e.memory={x:Math.round(visiblePlayers[0].x),y:Math.round(visiblePlayers[0].y),until:s.time+2.3};}if(e.memory&&e.memory.until>s.time)target=e.memory;else{const noise=s.noise.findLast(n=>s.time-n.t<1.2&&dist(e,n)<6);if(noise)target={x:Math.round(noise.x),y:Math.round(noise.y)};}}\n let want=-1;if(!e.moving){if(target){const route=path(this.room,e,target);if(route?.length)want=route[0];}if(want<0){if(!e.patrol||s.time>e.thinkAt||Math.round(e.x)===e.patrol.x&&Math.round(e.y)===e.patrol.y){const floor=[];for(let y=1;y<H-1;y++)for(let x=1;x<W-1;x++)if(walkable(this.room,x,y))floor.push({x,y});e.patrol=floor[Math.floor(this.rand()*floor.length)];e.thinkAt=s.time+5+this.rand()*3;}const route=path(this.room,e,e.patrol);if(route?.length)want=route[0];}}else want=e.moveDir;\n const rhythm=e.type==='hopper'?.7+.5*Math.max(0,Math.sin(e.phase*5)):e.type==='skitter'?(Math.sin(e.phase*6)>-.2?1.35:.4):1;\n this.move(e,s.tuning[`${e.type}Speed`]*this.difficulty.speed*s.pressure*rhythm,dt,want,false);if(e.moving)e.face=e.moveDir;this.portal(e,'enemy');e.visible=e.type==='hopper'||e.revealUntil>s.time||players.some(p=>lineClear(this.room,e,p));if(e.type!=='hopper'&&!e.visible)s.stats.cloaked++;}}\n updatePending(){const s=this.s;for(const q of s.pending){if(q.status!=='waiting')continue;if(q.at===null&&s.roomKills>=q.after)q.at=s.roomTime+q.delay*s.tuning.spawnSpacing;if(q.at!==null&&s.roomTime>=q.at){this.spawn(q.type,q.x,q.y);q.status='spawned';}}}\n updateFamiliar(dt){const f=this.s.familiar;if(!f)return;f.warning=Math.max(0,f.warning-dt);if(f.warning>0)return;f.state='flight';let want=f.face;if(!f.moving){const r=path(this.room,f,{x:f.goal,y:6});if(!r?.length){this.finishFamiliar(false);return;}want=r[0];}this.move(f,this.s.tuning.familiarSpeed*(this.s.roomIndex===0?.72:1)*this.difficulty.speed,dt,want,false);if(f.moving)f.face=f.moveDir;this.portal(f,'familiar');}\n updateWizard(dt){const s=this.s;let w=s.wizard;if(!w){if(s.wizardBreak>0){s.wizardBreak-=dt;if(s.wizardBreak<=0)this.placeWizard();}return;}if(w.warning>0){w.warning=Math.max(0,w.warning-dt);if(w.warning<=0){w.state='active';this.event('wizard-appear',w.x,w.y,{stage:w.stage});}return;}\n w.teleportIn-=dt;w.cast-=dt;if(w.teleportIn<=0){this.event('wizard-teleport',w.x,w.y);this.placeWizard();return;}if(w.cast<=0){w.cast=s.tuning.wizardAttack*(w.stage===2?.72:1);const p=s.players.filter(p=>p.alive).sort((a,b)=>dist(a,w)-dist(b,w))[0];w.face=p?cardinal(w,p):w.face;let dirs=w.stage===0?[w.face]:w.stage===1?[w.volleys%2?0:1,w.volleys%2?2:3]:[w.face,(w.face+2)%4];w.volleys++;for(const d of dirs){const[dx,dy]=DIRS[d];s.bolts.push({id:this.id('z'),owner:w.id,x:w.x+dx*.4,y:w.y+dy*.4,dir:d,hostile:true});}this.event('lightning',w.x,w.y,{stage:w.stage,dirs});}\n if(s.roomIndex!==5&&s.phaseTime>32){s.wizard=null;s.bolts=s.bolts.filter(b=>!b.hostile);this.event('wizard-escape',w.x,w.y);this.clear();}}\n updateBolts(dt){const s=this.s;const removed=new Set();for(const b of [...s.bolts]){if(removed.has(b.id))continue;const speed=s.tuning.boltSpeed*(b.hostile?.62:1),travel=speed*dt;let hit=null;const choose=(d,priority,kind,target)=>{if(d<-.001||d>travel+EPS)return;if(!hit||d<hit.d-EPS||Math.abs(d-hit.d)<EPS&&priority<hit.priority)hit={d,priority,kind,target};};\n const[dx,dy]=DIRS[b.dir];for(let y=0;y<H;y++)for(let x=0;x<W;x++){if(this.room.rows[y][x]!=='#')continue;const perp=dx?Math.abs(b.y-y):Math.abs(b.x-x);if(perp>.5)continue;const along=(x-b.x)*dx+(y-b.y)*dy;if(along+.5<0)continue;choose(Math.max(0,along-.5),0,'wall',null);}if(dx&&((b.x<.1&&dx<0)||(b.x>17.9&&dx>0)))choose(0,0,'wall',null);\n if(b.hostile){for(const p of s.players)if(p.alive&&p.protect<=0)choose(rayDistance(b,p,b.dir,.34),3,'player',p);}else{\n for(const post of s.posts)choose(rayDistance(b,post,b.dir,.4),1,'post',post);\n for(const e of s.enemies)if(!e.dead&&e.warning<=0&&s.time>=e.activeAt)choose(rayDistance(b,e,b.dir,.37),3,'enemy',e);\n if(s.familiar&&s.familiar.warning<=0)choose(rayDistance(b,s.familiar,b.dir,.4),3,'familiar',s.familiar);\n if(s.wizard?.state==='active'&&s.wizard.vulnerable)choose(rayDistance(b,s.wizard,b.dir,.42),3,'wizard',s.wizard);\n for(const other of s.bolts)if(other.hostile&&!removed.has(other.id))choose(rayDistance(b,other,b.dir,.24),2,'bolt',other);\n }\n if(hit){b.x+=dx*hit.d;b.y+=dy*hit.d;removed.add(b.id);if(hit.kind==='enemy')this.killEnemy(hit.target,b.owner);else if(hit.kind==='post')this.ring(hit.target,b.owner);else if(hit.kind==='familiar')this.finishFamiliar(true,b.owner);else if(hit.kind==='wizard')this.hitWizard(b.owner);else if(hit.kind==='player')this.damage(hit.target,'lightning');else if(hit.kind==='bolt'){removed.add(hit.target.id);this.event('parry',b.x,b.y);}else this.event('wall-hit',b.x,b.y);}\n else{b.x+=dx*travel;b.y+=dy*travel;if(b.x<-.5||b.x>W-.5||b.y<-.5||b.y>H-.5)removed.add(b.id);}}\n s.bolts=s.bolts.filter(b=>!removed.has(b.id));for(const p of s.players)if(p.boltId&&!s.bolts.some(b=>b.id===p.boltId)){p.boltId=null;this.event('ready',p.x,p.y,{seat:p.seat});}s.enemies=s.enemies.filter(e=>!e.dead);}\n step(dt,commands=[]){if(!Number.isFinite(dt)||dt<=0)return;dt=Math.min(dt,.25);const n=Math.max(1,Math.ceil(dt/(1/120)));for(let i=0;i<n;i++)this.fixedStep(dt/n,commands);}\n fixedStep(dt,commands){const s=this.s;if(['victory','defeat'].includes(s.phase))return;dt*=s.timeScale||1;s.time+=dt;s.tick++;s.phaseTime+=dt;s.roomTime+=dt;s.stats.activeSeconds+=dt;s.pressure=Math.min(s.tuning.pressureCap,1+s.roomTime*s.tuning.pressureGrowth);for(const post of s.posts){post.cooldown=Math.max(0,post.cooldown-dt);post.ring=Math.max(0,post.ring-dt);}if(s.phase==='clear'){if(s.phaseTime>3.5)this.nextRoom();return;}\n this.updatePlayers(dt,commands);if(s.phase==='entry'&&(s.phaseTime>1||commands.some(c=>c&&(validDir(c.move)||c.fire))))this.setPhase('hunt',this.room.intro);\n if(s.phase==='hunt'){this.updatePending();this.updateEnemies(dt);}else if(s.phase==='familiar')this.updateFamiliar(dt);else if(s.phase==='intrusion')this.updateWizard(dt);\n this.updateBolts(dt);if(s.phase==='defeat'||s.phase==='victory')return;\n for(const e of s.enemies){if(e.warning>0||s.time<e.activeAt)continue;for(const p of s.players)if(p.alive&&dist(e,p)<.53)this.damage(p,e.type);}\n if(s.phase==='hunt'&&!s.enemies.length&&s.pending.every(q=>q.status==='spawned'))this.startFamiliar();s.noise=s.noise.filter(n=>s.time-n.t<1.5);\n }\n radar(){return {players:this.s.players.filter(p=>p.alive).map(p=>({id:p.id,seat:p.seat,x:p.x,y:p.y})),enemies:this.s.enemies.map(e=>({id:e.id,type:e.type,x:e.x,y:e.y,warning:e.warning>0}))};}\n dev(action,value){const s=this.s;s.practice=true;switch(action){case'room':this.enterRoom(Number(value)||0);break;case'phase':if(value==='familiar')this.startFamiliar();else if(value==='intrusion'){this.startWizard();}else if(value==='hunt'){this.enterRoom(s.roomIndex);this.setPhase('hunt');}break;case'restart':this.enterRoom(s.roomIndex);break;case'invulnerable':s.invulnerable=!!value;break;case'lives':for(const p of s.players){p.lives=Math.max(1,Math.min(9,Number(value)||3));if(!p.alive)this.respawn(p);}break;case'spawn':{const p=s.players.find(p=>p.alive)||{x:1,y:11},spot=this.farFloor(p);this.spawn(value,spot.x,spot.y);break;}case'clearEnemies':s.enemies=[];for(const q of s.pending)q.status='spawned';break;case'reset':s.tuning={...DEFAULTS};s.timeScale=1;s.invulnerable=false;break;}s.practice=true;}\n bot(seat=0){return bot(this,seat);}\n}\nfunction bot(sim,seat=0){\n const s=sim.s,p=s.players.find(p=>p.seat===seat),none={move:-1,aim:-1,fire:false};if(!p?.alive||['clear','victory','defeat'].includes(s.phase))return none;const room=sim.room;\n if(s.roomIndex===2&&s.stats.bells===0&&s.roomTime<3)return {move:-1,aim:3,fire:true};\n if(s.roomIndex===2&&s.stats.portals===0){if(p.moving)return {move:p.moveDir,aim:p.face,fire:false};const r=path(room,p,{x:0,y:6});if(r?.length)return {move:r[0],aim:r[0],fire:false};}\n const targets=s.phase==='familiar'&&s.familiar?[s.familiar]:s.phase==='intrusion'&&s.wizard?[s.wizard]:s.enemies.filter(e=>e.warning<=0);\n let target=null,best=1e9;for(const e of targets){const d=dist(p,e);if(d<best){best=d;target=e;}}\n if(!target){const q=s.pending.find(q=>q.status==='waiting');target=q?{x:q.x,y:q.y}:s.posts[0]||{x:9,y:5};}\n const aim=cardinal(p,target);const aligned=lineClear(room,p,target,.2);const canShoot=aligned&&dist(p,target)>.45&&(target.state!=='warning'||target.type)&&(!s.wizard||s.wizard!==target||target.state==='active'&&target.vulnerable);\n/* Original menagerie puppets and dungeon craft, rendered with my-3D2dge's native\n * shaded shapes, Humanoid/Blob rigs and depth-sorted render queue. Tile = 16 units. */\n(() => {\n'use strict';\nconst E = My3D2dge, {px} = E, TAU=Math.PI*2;\nconst C={ink:'#0b1019',gold:'#d9b775',cream:'#f5e8c5',cyan:'#8ce4db',violet:'#bb95e7',red:'#ef867a'};\nconst DIR=[[1,0],[0,1],[-1,0],[0,-1]], W=x=>(x+.5)*16;\nconst mat=(color,pattern='none',extra={})=>({color,pattern,...extra});\nObject.assign(E.MATERIALS,{\n iwGold:mat('#b79555','metal'),iwGoldHi:mat('#ecd19b','metal'),iwIron:mat('#36404b','metal'),iwOnyx:mat('#192033','stones',{size:4}),\n iwLantern:mat('#c5ffdd','glaze',{glow:1}),iwEmber:mat('#ffd17b','glaze',{glow:1}),iwViolet:mat('#8b68b8','cloth'),iwBellOff:mat('#68666b','metal'),\n iwBone:mat('#ece0b6','glaze'),iwCloak:mat('#244e58','cloth'),iwChitin:mat('#b95065','glaze'),iwGlass:mat('#5cadb0','glaze',{glow:.5})\n});\nconst shapes={\n 'iw-post':{about:'Original bronze singing-bell resonator, twin tusk brackets and crystal clapper',tags:'wizard bell resonator',mats:{g:'iwGold',h:'iwGoldHi',i:'iwIron',c:'iwLantern'},parts:[['cyl','i',[0,0,0],5.8,2,{seg:8}],['cyl','g',[0,0,2],4.6,1,{seg:8}],['mirror','x',['box','g',[4,0,3],[1.5,2,12]]],['box','h',[0,0,15],[10,2,1.6]],['cyl','g',[0,0,5],4.2,4,{r2:2.6,seg:8}],['cyl','h',[0,0,4.5],4.7,1],['cyl','g',[0,0,9],2.6,3,{r2:1.6}],['ball','c',[0,0,5],1.7],['box','i',[0,0,12],[.8,.8,3]]]},\n 'iw-post-off':{about:'Resonator recharging, dark crystal clapper',tags:'wizard bell cooldown',mats:{g:'iwBellOff',h:'iwGold',i:'iwIron',c:'iwBellOff'},parts:[]},\n 'iw-pillar':{about:'Original low brass-capped dungeon pier, cut away to preserve sight lines',tags:'wizard architecture',mats:{s:'iwOnyx',b:'iwGold',h:'iwGoldHi'},parts:[['box','s',[0,0,0],[14,14,3]],['box','b',[0,0,3],[12,12,1]],['box','s',[0,0,4],[10,10,8]],['box','b',[0,0,12],[13,13,1.2]],['box','s',[0,0,13.2],[12,12,2]],['box','h',[0,0,15.2],[7,7,.8]]]},\n 'iw-gate':{about:'Original paired lane-portal pylons and runic metal bridge',tags:'wizard portal gate',mats:{s:'iwOnyx',b:'iwGold',g:'iwGlass'},parts:[['mirror','x',['box','s',[7,0,0],[3,7,15]]],['mirror','x',['box','b',[7,0,3],[3.4,7.4,1]]],['mirror','x',['ball','g',[7,0,15],1.7]],['box','s',[0,0,16],[17,7,2]],['box','b',[0,0,18],[19,7.5,1.5]]]},\n 'iw-jaw':{about:'Original broad hinged bronze-toothed hunter jaw',tags:'wizard stalker anatomy',mats:{c:'iwCloak',b:'iwBone',i:'iwIron'},parts:[['prism','c',[0,0,3],[[-5,-2],[-4,3],[0,5],[4,3],[5,-2]],2],['row',5,[1.7,0,0],['cyl','b',[0,3.1,5],.6,2,{r2:0,seg:4}]],['mirror','x',['ball','i',[4,0,5],1.4]]]},\n 'iw-skitter':{about:'Original blade-backed six-legged skitterer body',tags:'wizard skitter anatomy',mats:{c:'iwChitin',b:'iwBone',g:'iwGold',e:'iwEmber'},parts:[['lathe','c',[0,0,1],[[0,0],[3.3,1],[4,3],[2.8,6],[0,7]],{seg:6}],['prism','b',[0,-1,6],[[-.6,0],[.6,0],[0,5]],7,{axis:'y'}],['mirror','x',['prism','c',[2.8,0,4],[[0,0],[3,-1],[1,4]],5,{axis:'y'}]],['mirror','x',['ball','e',[1.6,3,5],.8]],['box','g',[0,3.3,2],[3,1.5,1]]]},\n 'iw-familiar-mask':{about:'Original moth-owl familiar mask, split beak and moon-shaped brows',tags:'wizard familiar anatomy',mats:{g:'iwGoldHi',e:'iwLantern',b:'iwBone'},parts:[['mirror','x',['ball','g',[1.7,2,4],1.9]],['mirror','x',['ball','e',[1.7,3.2,4],.9]],['prism','b',[0,3.2,2],[[-1,1],[1,1],[0,-2]],1,{axis:'y'}]]}\n};\nshapes['iw-post-off'].parts=shapes['iw-post'].parts;\nObject.assign(E.SHAPES,shapes);\n// Lantern-rifle extends the native Humanoid weapon system. Ready is a physical\n// crystal aperture; a committed bolt leaves a dark socket until it resolves.\nE.Humanoid.weapon('iw-lantern-rifle',{length:9,rest:[.9,0,-.3],blade:false,draw(w){\n const {g,rig,hand,at,u}=w, a=at(1), b=at(8), mid=at(5), light=rig._ready===false?'#655d68':'#d7ffe3';\n w.push(Math.max(hand[2],b[2]),()=>{\n  px.line(g,hand[0],hand[1],b[0],b[1],'#1b2029',Math.max(2,u*3.4));\n  px.line(g,a[0],a[1]-.4,b[0],b[1]-.4,'#c9a363',Math.max(1,u*1.8));\n  px.disc(g,mid[0],mid[1],Math.max(1.5,u*2),'#45404c');\n  px.disc(g,mid[0],mid[1],Math.max(.7,u*1.1),light);\n  px.disc(g,b[0],b[1],Math.max(1,u*1.5),'#e2c58d');\n  px.dot(g,b[0],b[1],light);\n  if(rig._recoil>0){px.disc(g,b[0],b[1],Math.max(1,u*3*rig._recoil),'#e9ffe0');}\n });\n}});\nclass WizardRenderer{\n constructor(game){\n  this.game=game;this.rigs=new Map();this.last=new Map();this.mapIndex=-1;this.title=false;this.eventId=0;this.fx=[];this.layout={};\n  this.wizardRig=new E.Humanoid({size:.96,seed:89,build:'heroic',hat:{style:'pointed',color:'#604779'},hair:'long',beard:'long',outfit:'robe',sleeves:'long',weapon:'staff',cape:{len:5,width:7,seg:2.4},eyeGlow:'#d2ffd1',colors:{skin:'#c6c4b4',hair:'#e0d6b9',cloth:'#58456d',pants:'#29243f',boot:'#202132',trim:'#e4c479',cape:'#352d55',capeIn:'#8a526b',orb:'#a8f0ce',staff:'#b39768',eye:'#d9ffce'}});\n  this.titleWizard=new E.Humanoid({size:3.2,seed:181,build:'heroic',hat:{style:'pointed',color:'#51416a'},hair:'long',beard:'long',outfit:'robe',sleeves:'long',weapon:'staff',cape:{len:6,width:7,seg:2.6},eyeGlow:'#d6ffe1',colors:{skin:'#b5bcac',hair:'#e5dabd',cloth:'#51416b',trim:'#c7ad75',pants:'#24203b',boot:'#191c2c',cape:'#292b49',capeIn:'#67526e',orb:'#b8efd6',staff:'#b99d65'}});\n  this.familiarRig=new E.Blob({R:4.4,wings:true,ears:'cat',tail:true,feet:false,mouth:'fangs',face:'front',colors:{dk:'#77563f',base:'#d3a763',lt:'#f8dca0',spec:'#fff8da',wing:'#afa5bb',inner:'#584761',eye:'#e2ffcf',pupil:'#263a3b'}});\n  game.lights.enabled=true;game.lights.ambient=.72;game.lights.darkness=.3;\n }\n world(x){return W(x)}\n cell(x){return x/16-.5}\n room(s){return globalThis.WizardSim.ROOMS[s.roomIndex||0]}\n prepare(s){\n  const idx=s.roomIndex||0;if(this.mapIndex===idx)return;\n  this.mapIndex=idx;this.rigs.clear();this.last.clear();this.fx=[];\n  const room=this.room(s),pal=room.palette||['#192430','#4b4357','#d4b273'];\n  const floor=pal[0],wall=pal[1];\n  E.MATERIALS['iw-floor-'+idx]={color:floor,pattern:'tiles',size:16};\n  E.MATERIALS['iw-wall-'+idx]={color:wall,pattern:'bricks',bw:8,bh:3};\n  this.map=new E.TileMap({rows:room.rows,legend:{'#':1,'B':'bell','P':'portal','.':0},types:{1:{h:6.5,top:wall,side:'#292a39',line:'#111924',face:'iw-wall-'+idx,roof:'slab',cut:true,cutH:6.5}},floorMat:'iw-floor-'+idx,ao:2.5,outside:false});\n  this.palette=pal;this.decor=[];\n  // Dressing sits on collision walls, never inside a lethal lane.\n  for(let y=0;y<room.rows.length;y++)for(let x=0;x<room.rows[y].length;x++)if(room.rows[y][x]==='#'){\n   if((x===1||x===17)&&(y===0||y===12))this.decor.push({x,y,kind:'pier'});\n   else if((y===0||y===12)&&x%4===1)this.decor.push({x,y,kind:'lamp'});\n   else if((x===0||x===18)&&y%4===2&&y!==6)this.decor.push({x,y,kind:'lamp'});\n  }\n }\n frame(s,opts={}){\n  this.title=!!opts.title;this.prepare(s);\n  const game=this.game,Wd=game.W||640,H=game.H||360,portrait=H>Wd*1.05;\n  const arena=this.title?{x:Wd*.48,y:H*.15,w:Wd*.49,h:H*.77}:portrait?{x:18,y:62,w:Wd-36,h:Math.min((Wd-36)*.72,H-222)}:{x:25,y:49,w:Wd-177,h:H-91};\n  const radar=this.title?{x:0,y:0,w:0,h:0}:portrait?{x:Math.round((Wd-170)/2),y:arena.y+arena.h+20,w:170,h:115}:{x:Wd-141,y:74,w:116,h:87};\n  this.layout={arena,radar,portrait,header:{x:25,y:16,w:Wd-50,h:24},footer:{x:25,y:H-28,w:Wd-50,h:20}};\n  const z=Math.min(arena.w/(19*16*1.5+18),arena.h/(13*16*1.5*.9848+24));\n  if(Math.abs((this.fitZoom||0)-z)>.001){game.setZoom(Math.max(.5,z));this.fitZoom=z;}\n  game.cam.smooth=0;game.cam.bounds=null;game.cam.room=null;\n  game.cam.offset=[arena.x+arena.w/2-Wd/2,arena.y+arena.h/2-H/2+3];\n  game.focus(19*8,13*8,0);\n  game.cam.x=game.cam.tx;game.cam.y=game.cam.ty;game.cam.z=0;\n }\n actorRig(p){\n  if(this.rigs.has(p.id))return this.rigs.get(p.id);\n  let rig;\n  if(p.seat!==undefined){const two=p.seat===2;rig=new E.Humanoid({size:.64,seed:101+(p.seat||1),build:two?'bulky':'heroic',weapon:'iw-lantern-rifle',hat:two?{style:'cap',color:'#697a92'}:{style:'helmet',color:'#a48c61'},hair:two?'ponytail':'short',outfit:'coat',armor:true,sleeves:'long',cape:{len:3,width:5,seg:1.6},colors:{skin:'#e2c39b',hair:two?'#c1b5a0':'#413f44',cloth:two?'#637a99':'#609b8e',coat:two?'#637a99':'#609b8e',pants:'#333742',boot:'#292d34',metal:two?'#a3b7c9':'#d2b684',metalDk:'#566165',trim:'#e4cb99',belt:'#a48658',cape:two?'#42536e':'#3b706c',capeIn:'#273341',hilt:'#e8d3a0'}});}\n  else if(p.type==='hopper')rig=new E.Blob({R:5.6,horns:true,feet:true,tail:true,mouth:true,face:'front',colors:{dk:'#69564a',base:'#bd9b69',lt:'#e8c38c',spec:'#fff1c3',horn:'#d8d4b0',ext:'#70594c',eye:'#ffedba',pupil:'#3a3032'}});\n  else if(p.type==='stalker')rig=new E.Blob({R:5.2,ears:'cat',feet:true,mouth:'fangs',face:'front',colors:{dk:'#263c49',base:'#538c8f',lt:'#8fbdb3',spec:'#cef0da',inner:'#a7bf9d',ext:'#253c44',eye:'#e6f9bd',pupil:'#102b33'}});\n  else rig=new E.Blob({R:3.5,feet:false,mouth:true,face:'front',colors:{dk:'#593546',base:'#b45469',lt:'#e798a0',spec:'#fbe4c6',eye:'#fff4ba',pupil:'#472b3a'}});\n  this.rigs.set(p.id,rig);return rig;\n }\n update(s,dt){\n  this.prepare(s);const t=s.time||0;\n  for(const p of [...(s.players||[]),...(s.enemies||[])]){\n   const rig=this.actorRig(p),old=this.last.get(p.id)||p,vel=dt>0?[Math.max(-80,Math.min(80,(p.x-old.x)*16/dt)),Math.max(-80,Math.min(80,(p.y-old.y)*16/dt))]:[0,0];\n   const d=DIR[p.face||0];\n   if(p.seat!==undefined){rig._ready=!p.boltId;rig._recoil=(p.recoil||0)*5;rig.update(dt,{x:W(p.x),y:W(p.y),z:0,vx:vel[0],vy:vel[1],facing:(p.face||0)*Math.PI/2,point:true,hurt:(p.hurt||0)>0,down:!p.alive,pose:s.phase==='victory'?'cheer':undefined,recoil:p.recoil||0});}\n   else rig.update(dt,{look:d,walk:Math.min(1,Math.hypot(...vel)/20),squash:p.type==='hopper'?Math.sin(t*8+p.id)*.13:Math.sin(t*11+p.id)*.04,squint:p.state==='warning',flap:0});\n   this.last.set(p.id,{x:p.x,y:p.y});\n  }\n  const wz=s.wizard;if(wz)this.wizardRig.update(dt,{x:W(wz.x),y:W(wz.y),z:1.3+Math.sin(t*3)*.6,vx:0,vy:0,facing:(wz.face||1)*Math.PI/2,point:true,pose:wz.state==='active'?'cast':'hips'});\n  this.titleWizard.update(dt,{x:W(13.1),y:W(6),z:0,vx:0,vy:0,facing:Math.PI*.55,pose:Math.sin(t*.7)>.4?'cast':'hips',point:true});\n  this.familiarRig.update(dt,{look:DIR[s.familiar?.face||0],walk:0,flap:1,squash:Math.sin(t*12)*.08});\n  for(const ev of s.events||[]){if(ev.id<=this.eventId)continue;this.eventId=ev.id;this.onEvent(ev,s);}\n  for(const f of this.fx)f.age+=dt;this.fx=this.fx.filter(f=>f.age<f.life);\n }\n onEvent(ev,s){\n  if(!Number.isFinite(ev.x)||!Number.isFinite(ev.y))return;\n  const name=ev.type||'';\n  if(/kill|banish|catch|death|hit|bolt-impact|impact|portal|respawn|bell|fire/.test(name))this.fx.push({x:W(ev.x),y:W(ev.y),age:0,life:/banish/.test(name)?1:.4,n:/banish/.test(name)?20:8,color:/bell|catch/.test(name)?C.gold:/death|hurt/.test(name)?C.red:/banish/.test(name)?C.violet:C.cyan,seed:ev.id});\n }\n draw(s,r,opts={}){\n  this.prepare(s);const t=s.time||0,victory=s.phase==='victory',pal=this.palette;\n  r.sky(['#0c121b','#121c28','#151a27']);\n  // A quiet etched surround leaves the collision board unmistakable.\n  r.overlay(g=>{\n   const a=this.layout.arena;if(!a)return;\n   const border=opts.title?'#34424b':'#425059';\n   for(const [x,y,dx,dy]of[[a.x-8,a.y-8,1,1],[a.x+a.w+8,a.y-8,-1,1],[a.x-8,a.y+a.h+8,1,-1],[a.x+a.w+8,a.y+a.h+8,-1,-1]]){px.line(g,x,y,x+dx*12,y,border);px.line(g,x,y,x,y+dy*12,border);px.dot(g,x+dx*3,y+dy*3,C.gold);}\n  });\n  this.map.drawFloor(r);\n  // Floor inlays: all are nonblocking, stable, and no brighter than the actors.\n  r.decal(g=>{\n   for(let y=1;y<12;y++)for(let x=1;x<18;x++)if(this.room(s).rows[y][x]!== '#'&&((x*17+y*11)%19===0)){\n    const [sx,sy]=r.w(W(x),W(y),.1),q=Math.max(1,r.view.scale*1.5);px.line(g,sx-q,sy,sx+q,sy,'#34414a');px.line(g,sx,sy-q,sx,sy+q,'#34414a');px.dot(g,sx,sy,'#58615d');\n   }\n   const pts=r.groundPts(W(9),W(6),23,16,.05);for(let i=0;i<16;i++)if(i%2===0)px.line(g,...pts[i],...pts[(i+1)%16],victory?'#758976':'#3a3c4a');\n  });\n  this.map.queueWalls(r);\n  // Brass seam work crowns collision walls; the low cutaway is always readable.\n  for(let y=0;y<13;y++)for(let x=0;x<19;x++)if(this.room(s).rows[y][x]==='#'){\n   const wx=W(x),wy=W(y);r.queue(wx,wy,6.6,g=>{\n    const a=r.w(wx-6,wy-6,6.6),b=r.w(wx+6,wy-6,6.6);px.line(g,...a,...b,'#88785e');\n    if((x+y)%3===0){const c=r.w(wx-5,wy-4,6.7);px.dot(g,...c,'#b09b74');}\n   },{bias:.02});\n  }\n  for(const q of this.decor){\n   if(q.kind==='pier')r.shape('iw-pillar',W(q.x),W(q.y),6.5,{scale:.7,shadow:false});\n   else {r.prop('lantern',W(q.x),W(q.y),8,{size:.48,light:false});this.game.lights.add(W(q.x),W(q.y),12,42,.4,{color:victory?'#add8ad':pal[2]||'#e6bc7e'});}\nimport fs from 'node:fs';import vm from 'node:vm';\nvm.runInThisContext(fs.readFileSync(new URL('../vendor/my-3d2dge.js',import.meta.url),'utf8'));\nconst rows=['###################','#.................#','#...###...........#','#.........###.....#','#.................#','#....B............#','P.................P','#.................#','#....###..........#','#.................#','#...........###...#','#.................#','###################'];\nglobalThis.WizardSim={ROOMS:[{rows,palette:['#26333d','#5b4b61','#d6b77c']}]};\nvm.runInThisContext(fs.readFileSync(new URL('../src/render.js',import.meta.url),'utf8'));\nconst E=globalThis.My3D2dge,g=new E.Game({headless:true,draw:true,res:[640,360],view:'topdown',views:['topdown']}),renderer=new WizardRenderer(g);\nconst s={roomIndex:0,time:4,phase:'hunt',players:[{id:1,seat:1,x:2,y:5,face:0,alive:true,lives:3,protect:0},{id:2,seat:2,x:4,y:5,face:3,alive:true,lives:3,protect:1}],enemies:[{id:3,type:'hopper',x:5,y:3,face:1,visible:true},{id:4,type:'stalker',x:8,y:6,face:2,visible:true},{id:5,type:'skitter',x:13,y:8,face:3,visible:true}],bolts:[{id:6,x:6,y:6,dir:0,hostile:false}],posts:[{id:7,x:5,y:5,cooldown:0,ring:1}],familiar:{id:8,x:7,y:9,face:2},wizard:{id:9,x:10,y:9,state:'active',face:1},events:[]};\ng.start({view:'topdown',camera:{zoom:false},update(dt){renderer.update(s,dt);renderer.frame(s)},draw(r){renderer.draw(s,r)}});g.advance(.2,{draw:true});if(g.errors.length)throw Error(JSON.stringify(g.errors));g.dispose();console.log('Native renderer smoke passed');\ntotal 100\n-rw-r--r-- 1 micha micha  6757 Nov  6 02:33 audio.js\n-rw-r--r-- 1 micha micha 29769 Nov  6 02:37 main.js\n-rw-r--r-- 1 micha micha 10531 Nov  6 02:36 network.js\n-rw-r--r-- 1 micha micha 19825 Nov  6 02:36 render.js\n-rw-r--r-- 1 micha micha 25903 Nov  6 02:37 sim.js\n","exit_code":0,"status":"completed"}}
