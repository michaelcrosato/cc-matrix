s.shell._step();   // its screens move the focus with this step's input, and hold it back from the game\n    if (this._flash) this._flash.t += dt / Math.max(.05, this.timeScale);   // real time: slow motion does not stretch a flash\n    if (this._fade) { const out = this._fade.out; this._fadeStep(dt); if (out) return; }   // the old scene freezes while it fades out\n    const s = this.scene;\n    if (s && s.pausable && this.input.pressed('pause')) { this.paused = !this.paused; this.pauseReason = this.paused ? 'player' : null; this.audio.sfx('pause'); }\n    if (!this.paused) { this.pauseReason = null; this._goOn = false; }\n    this.audio._duck(this.paused);\n    // the player's zoom: the wheel, - and = and a pinch ask for it while a scene that allows it plays (input.zoom())\n    const I = this.input, zr = !this.paused && !(this.shell && this.shell.screen) && !!this.zoomRange();\n    I._zoomOn = zr; I._wheelOn = zr && (this._camera() || {}).wheel !== false;\n    if (this._zoomTo && !I._pinching && this._wall - this._zoomAt > .25) this._zoomApply();   // they stopped: the new zoom, drawn crisp\n    if (this.paused && !this.live && !this._goOn) return;   // (live: the world steps on under the menu)\n    if (!this.paused) { this._zoomFit(); const zk = I.zoom(); if (zk !== 1) this.zoomBy(zk); }\n    if (this.hitstop > 0) { this.hitstop -= dt; return; }\n    this.time += dt;\n    this.audio._tick(true);   // (a synced song: on game.time, it waits with the game)\n    const T = this._timers;\n    if (T.length) {\n      for (let i = 0; i < T.length; i++) { const t = T[i]; if (t.dead || this.time < t.at) continue; if (t.every) t.at += t.every; else t.dead = true; t.fn(); }\n      prune(T, t => t.dead);\n    }\n    for (const f of HOOKS.step) f(this, dt);\n *    section of its own: a kit whose game calls none of them leaves it out\n * ============================================================================= */\n/** how far action a is pressed, 0 to 1: a gamepad button by its travel (the triggers, even short of a press), a stick's\n *  direction (PadAxisUp ..., or up / down / left / right on the touch stick) by its push, any other code held 1 */\nInput.prototype.value = function (a) {\n  const m = this.map[a]; if (!m) { this._check(a); return 0; } if (this._suppressed.has(a)) return 0;\n  const PV = this.padValues || [], mv = this.padMove || [0, 0], st = this.stickOn ? this.stick : [0, 0], push = { up: [1, -1], down: [1, 1], left: [0, -1], right: [0, 1] };\n  let v = 0;\n  for (const c of m) {\n    const k = /^Pad(\\d+)$/.exec(c), ax = /^Pad(R?)Axis(Up|Down|Left|Right)$/.exec(c), pv = k ? PV[+k[1]] || 0 : 0;\n    if (k) v = Math.max(v, pv);\n    if (ax) { const [i, s] = push[ax[2].toLowerCase()], q = ax[1] ? this.padAim || [0, 0] : mv; v = Math.max(v, clamp(q[i] * s, 0, 1)); }\n    else if (this.held.has(c)) v = Math.max(v, k && pv > 0 ? pv : 1);\n  }\n  if (push[a]) { const [i, s] = push[a]; v = Math.max(v, clamp(st[i] * s, 0, 1)); }\n  return v;\n};\n/** a function of the game's own on the engine's clock: kind 'input' fn(dt) every step, paused or not, after the input\n *  is read (a host's guard, an idle timer); 'step' fn(dt) every update step in play, before the scene's update (an\n *  attract mode's watcher); 'enter' fn(name, data) as a scene starts. Returns a function that removes it */\nGame.prototype.hook = function (kind, fn) {\n  const L = (this._own || (this._own = { input: [], step: [], enter: [] }))[kind];\n  if (!L) throw new Error('game.hook(\"' + kind + '\"): the hooks are input, step and enter');\n  L.push(fn); return () => { const i = L.indexOf(fn); if (i >= 0) L.splice(i, 1); };\n};\n/** touch: 'never' on a device with touch alone: \"Controller or keyboard required\", with Settings, until a controller\n *  is connected or a key pressed */\nGame.prototype._needSync = function () {\n  const fine = window.matchMedia && matchMedia('(any-pointer: fine)').matches, coarse = window.matchMedia && matchMedia('(pointer: coarse