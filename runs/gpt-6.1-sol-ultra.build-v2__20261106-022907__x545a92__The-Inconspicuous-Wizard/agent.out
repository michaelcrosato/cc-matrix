{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"sed -n '250,297p' tests/ui_browser.py; sed -n '640,708p' vendor/my-3d2dge.js; sed -n '127,138p' src/render.js\"","aggregated_output":"                        if phase in ['victory','defeat']:break\n                    final=page.evaluate('({phase:__wizard.sim.s.phase,practice:__wizard.sim.s.practice,stats:__wizard.sim.s.stats,room:__wizard.sim.s.roomIndex,time:__wizard.sim.s.time,score:__wizard.sim.s.score})')\n                    require(final['phase']=='victory',f'Ordinary-command campaign did not win: {final}')\n                    require(not final['practice'] and final['room']==5,'Campaign required cheats or skipped the last chamber')\n                    advance(page,.03)\n                    require(page.evaluate('__wizard.ui.screen===\"results\"'),'Victory did not produce complete results')\n                    capture(page,'final-results.png')\n                    pad(page,13);pad(page,0)\n                    require(page.evaluate('__wizard.ui.screen===\"credits\"'),'Controller could not reach Credits from results')\n                    capture(page,'final-credits.png')\n                    # Return through actual native menu buttons, then start another descent.\n                    page.get_by_text('Return',exact=True).click()\n                    page.get_by_text('New run',exact=True).click()\n                    page.get_by_text(re.compile('^Gentle ·')).click();advance(page,.4)\n                    require(page.evaluate('__wizard.sim.s.roomIndex===0 && __wizard.sim.s.score===0 && __wizard.sim.s.phase===\"entry\"'),'Replay did not start a clean new run')\n                    errors(page)\n                    return final\n                finally:context.close()\n            check('full normal campaign through commands, results, credits and replay',campaign)\n\n            def touch():\n                context,page=fresh(phone=True)\n                try:\n                    start(page,'Gentle')\n                    session=context.new_cdp_session(page)\n                    touches=lambda ax,ay,bx,by:[{'x':ax,'y':ay,'id':1},{'x':bx,'y':by,'id':2}]\n                    session.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':touches(80,620,310,620)})\n                    session.send('Input.dispatchTouchEvent',{'type':'touchMove','touchPoints':touches(128,620,310,572)})\n                    before=page.evaluate('({...__wizard.sim.s.players[0]})');advance(page,.35)\n                    after=page.evaluate('({...__wizard.sim.s.players[0]})')\n                    require(after['x']>before['x']+.6 and after['face']==3,'Invisible multitouch sticks did not independently move and aim')\n                    require(page.evaluate('__wizard.sim.s.bolts.filter(b=>b.owner===\"p0\").length<=1'),'Touch firing bypassed one-bolt invariant')\n                    session.send('Input.dispatchTouchEvent',{'type':'touchCancel','touchPoints':[]});advance(page,.25)\n                    command=page.evaluate('__wizard.test.command(0)')\n                    require(command['move']==-1 and command['aim']==-1 and not command['fire'],'Touch cancellation left movement, aim, or fire stuck')\n                    require(page.evaluate('__wizard.game.input.touchEnabled===false'),'Native visible touch sticks remain enabled')\n                    capture(page,'final-phone.png');errors(page)\n                    page.evaluate('__wizard.title();__wizard.game.go(\"title\");');advance(page,.3)\n                    advance(page,10.1)\n                    page.touchscreen.tap(200,400);advance(page,.06)\n                    require(page.evaluate('document.body.dataset.mode===\"title\" && __wizard.ui.screen===\"title\"'),'Touch waking attract also activated Play')\n                    return {'device':'Chromium iPhone13 profile','multitouch':True,'cancel':True,'assistance':True,'wake':'touch'}\n                finally:context.close()\n            check('touch multitouch, cancellation, assistance and wake',touch)\n        finally:\n            for context in contexts:\n                try:context.close()\n                except Exception:pass\nE.RES = { nes: [256, 240], snes: [256, 224], gb: [160, 144], gbc: [160, 144], gba: [240, 160], genesis: [320, 224], md: [320, 224], pce: [256, 224], n64: [320, 240], ps1: [320, 240], wide: [400, 225] };\nclass Screen {\n  /** the game's low-resolution screen (game.screen: the game makes it): its buffer, scale and letterbox. canvas null: a\n   *  headless game's, sized as a 1280 x 720 window would size it, with nothing to draw on */\n  constructor(canvas, o, signal) {\n    /** canvas: the page's canvas (null in a headless game); o: the sizing options (the game's o) */\n    this.canvas = canvas; this._sctx = canvas ? canvas.getContext('2d') : null; this._o = o;\n    /** buf: the low-resolution buffer the game draws into (W + 2 by H + 2 pixels; null when headless, a stand-in when a\n     *  headless game draws: o.draw); ctx: its 2D context (r.ctx is the same) */\n    this.buf = canvas || (o && o.draw) ? mkCanvas(8, 8) : null; this.ctx = this.buf ? ctx2d(this.buf) : null;\n    /** W, H: the buffer's size in game pixels; S: the whole-number scale up to the canvas; OX, OY: the letterbox\n     *  margins on the canvas, in canvas pixels; dpr: the device pixel ratio used (at most 3) */\n    this.W = 320; this.H = 200; this.S = 3; this.OX = 0; this.OY = 0; this.dpr = 1;\n    /** ix, iy: the camera's whole-pixel offset this frame; fx, fy: its sub-pixel part (0..1, applied when\n     *  presenting); listeners: functions called after every resize */\n    this.ix = 0; this.iy = 0; this.fx = 0; this.fy = 0; this.listeners = [];\n    /** scale: how a fixed resolution fills the screen: 'sharp' (whole-number scale, every pixel the same size, black\n     *  bars unless o.expand grows the picture into them), 'fill' (the largest fit, pixels a device pixel apart in size)\n     *  or 'auto' (fill on high-density screens, phones and tablets, where that difference can't be seen; sharp\n     *  elsewhere). game.settings.scale sets it; filter: 'clean' | 'scanlines' | 'crt', drawn over the picture as it is\n     *  presented, never on the buffer, and not under a test harness (navigator.webdriver). game.settings.filter sets it */\n    this.scale = 'auto'; this.filter = 'clean';\n    this.resize();\n    if (canvas) addEventListener('resize', () => this.resize(), { signal });\n  }\n  /**\n   * the sizing options in force: the game's, with o.portrait's over them while the screen is taller than wide (a phone\n   * held upright). new Game({ maxH: 330, portrait: { maxH: 1000 } }) lets the picture grow to fill a 9:16 screen\n   */\n  _options(pw, ph) { const o = this._o; return o.portrait && ph > pw ? Object.assign({}, o, o.portrait) : o; }\n  /** fixed internal size from o.res ('snes', [256, 224], ...) or null for the adaptive size */\n  _fixedRes(o = this._o) {\n    const r = o.res; if (!r) return null;\n    const v = Array.isArray(r) ? r : E.RES[String(r).toLowerCase()];\n    if (!v) { warn('res:' + r, 'unknown res \"' + r + '\". Use one of ' + Object.keys(E.RES).join(', ') + ' or [width, height]'); return null; }\n    return [Math.max(16, v[0] | 0), Math.max(16, v[1] | 0)];\n  }\n  /** fit the buffer to the canvas again (on window resize; after changing sizing options, setOptions does it) */\n  resize() {\n    const c = this.canvas, dpr = c ? Math.min(window.devicePixelRatio || 1, 3) : 1, rc = c ? c.getBoundingClientRect() : { width: 1280, height: 720 };\n    const pw = Math.max(1, Math.round(rc.width * dpr)), ph = Math.max(1, Math.round(rc.height * dpr)), o = this._options(pw, ph);\n    /** portrait: true while the screen is taller than wide (a phone held upright) */\n    if (c) { c.width = pw; c.height = ph; } this.dpr = dpr; this.portrait = ph > pw;\n    const fix = this._fixedRes(o);\n    if (fix) {\n      // fixed resolution: whole-number scale, letterboxed (or the largest fit: scale). HUD pixel positions stay the same on every screen.\n      // o.expand: the resolution is the least the screen shows, and the picture grows on both sides to fill the window\n      // (no bars at any shape, up to expand.maxW x maxH): a HUD anchors to W and H\n      const fit = Math.min(pw / fix[0], ph / fix[1]), fill = this.scale === 'fill' || (this.scale === 'auto' && dpr >= 2 && fit >= 2), x = o.expand;\n      this.S = fill ? Math.max(1, fit) : Math.max(1, Math.min(Math.floor(pw / fix[0]), Math.floor(ph / fix[1])));\n      this.W = x ? clamp(Math.ceil(pw / this.S - 1e-6), fix[0], Math.max(fix[0], x.maxW || 1e4)) : fix[0]; this.H = x ? clamp(Math.ceil(ph / this.S - 1e-6), fix[1], Math.max(fix[1], x.maxH || 1e4)) : fix[1];   // (a cap never cuts below res)\n    } else {\n      const S = Math.max(1, Math.min(Math.floor(ph / o.minH), Math.floor(pw / o.minW)));\n      this.S = S; this.W = Math.min(o.maxW, Math.ceil(pw / S)); this.H = Math.min(o.maxH, Math.ceil(ph / S));\n    }\n    this.OX = Math.floor((pw - this.W * this.S) / 2); this.OY = Math.floor((ph - this.H * this.S) / 2);\n    if (this.buf) { this.buf.width = this.W + 2; this.buf.height = this.H + 2; this.ctx = ctx2d(this.buf); this.ctx._c = null; }\n    for (const f of this.listeners) f();\n  }\n  /** change sizing at runtime, e.g. { minH: 400, maxW: 1080, maxH: 660 } to pull the camera back */\n  setOptions(o) { Object.assign(this._o, o); this.resize(); }\n  /** how a fixed resolution fills the screen: 'sharp' | 'fill' | 'auto' (see scale) */\n  setScale(v) { this.scale = v === 'sharp' || v === 'fill' ? v : 'auto'; this.resize(); }\n  /** clear: true when the game's bg is null (or 'transparent'): the buffer and the canvas are cleared instead of filled,\n   *  so a picture under the canvas shows through the game's (a 3D world drawn by engine/my-3d2dge-3d.js) */\n  get clear() { return this._o.bg == null || this._o.bg === 'transparent'; }\n  /** start a frame: clear the buffer to bg with the camera at (cx, cy) projected pixels (the renderer calls it) */\n  _begin(cx, cy, bg, vp) {\n    this.ix = Math.floor(cx); this.iy = Math.floor(cy); this.fx = vp ? 0 : cx - this.ix; this.fy = vp ? 0 : cy - this.iy;   // (a split screen's viewports: whole pixels)\n   }\n   const pts=r.groundPts(W(9),W(6),23,16,.05);for(let i=0;i<16;i++)if(i%2===0)px.line(g,...pts[i],...pts[(i+1)%16],victory?'#758976':'#3a3c4a');\n  });\n  this.map.queueWalls(r);\n  // Brass seam work crowns collision walls; the low cutaway is always readable.\n  for(let y=0;y<13;y++)for(let x=0;x<19;x++)if(this.room(s).rows[y][x]==='#'){\n   const wx=W(x),wy=W(y);r.queue(wx,wy,6.6,g=>{\n    const a=r.w(wx-6,wy-6,6.6),b=r.w(wx+6,wy-6,6.6);px.line(g,...a,...b,'#88785e');\n    if((x+y)%3===0){const c=r.w(wx-5,wy-4,6.7);px.dot(g,...c,'#b09b74');}\n   },{bias:.02});\n  }\n  for(const q of this.decor){\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/main.js';s=open(p).read().replace(\\\"res:[640,360],expand:true\\\", \\\"res:[640,360],portrait:{res:[360,640]},expand:true\\\");s=s.replace(\\\"wakeUntil=0,selectedSeats\\\", \\\"wakeUntil=0,wakeClickUntil=0,selectedSeats\\\");s=s.replace(\\\"if(demo){wakeUntil=game.real+.2;demo=null;\\\", \\\"if(demo){wakeUntil=game.real+.2;wakeClickUntil=performance.now()+600;demo=null;\\\");s=s.replace(\\\"for(const type of ['keydown','pointerdown','pointermove','touchstart'])addEventListener\\\", \\\"addEventListener('click',e=>{if(performance.now()<wakeClickUntil){e.preventDefault();e.stopImmediatePropagation();}},{capture:true});\\\\n  for(const type of ['keydown','pointerdown','pointermove','touchstart'])addEventListener\\\");\ns=s.replace(\\\"function drawHUD(s,r){const\\\", \\\"function drawHUD(s,r){if(renderer.layout?.portrait){drawPortraitHUD(s,r);return;}const\\\");\nopen(p,'w').write(s)\np='src/render.js';s=open(p).read().replace(\\\"portrait?{x:18,y:62\\\", \\\"portrait?{x:18,y:94\\\");open(p,'w').write(s)\np='src/audio.js';s=open(p).read().replace(\\\"radar: { wave:\\\", \\\"cloak: { wave: 'pulse12', freq: 95, to: 65, dur: .085, vol: .022 },\\\\n    radar: { wave:\\\");s=s.replace(\\\"this.radarAt = 0;\\\", \\\"this.radarAt = 0; this.footAt=0;\\\");s=s.replace(\\\"if ((s.enemies||[]).some(e=>\"'!e.visible)\", \"const hidden=(s.enemies||[]).find(e=>!e.visible);if(hidden&&s.time>this.footAt){this.footAt=s.time+(hidden.type==='\"'skitter'?.4:.75);this.sfx('cloak',hidden.x);}\\\\n      if ((s.enemies||[]).some(e=>\"'!e.visible)\");open(p,'\"'w').write(s)\np='tests/hub_browser.py';s=open(p).read().replace('__wizard.test.command(0).aim===2','__wizard.onlineCommand.aim===2');open(p,'w').write(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
