ypes: { 1: { h: 80 }, 2: { h: 40 } } });\nconst guard = { x: 56, y: 40, z: 40, facing: Math.PI }, hero = { x: 36, y: 40, z: 0, r: 5 };\n....\n55:- 219 Views (projections); E.View: view\n221:- `E.VIEWS: iso, threequarter, topdown, brawler, side, overhead`: the ready-made views: iso (yaw 45, pitch 30), threequarter (pitch 55), topdown (80), brawler (25), side (0) and overhead (90, scale 1: world x/y = screen pixels); new E.Game({ view: 'iso' }) and game.setView('side') take their names\n223:- `new E.View(id, label, yaw, pitch, scale = 1, zBoost = 1) → view`: new E.View(id, label, yaw, pitch, scale, zBoost): an orthographic camera (degrees; scale = screen pixels per world unit; zBoost stretches heights)\n244:- `E.charView(view)`: the view a rig in `view` is drawn from (the sprite-like angle above; the view itself outside pitch 40-89)\n430:- `r.shape(id, x, y, z = 0, o = {})` †: Queue a shape standing at (x, y, z), feet on the point, depth sorted like an actor: r.shape(id | entry, x, y, z, o). o: { facing (radians, where its front points; default PI/2, south, as written), scale, mats: { slot: material }, flip (mirror it x to -x before facing), params (a generator's: { h: 30 }), bias, hides (x-ray silhouettes show through it: by default when it stands at least E.HEIGHTS.chest, 22, high), footprint, light (add its lights to game.lights), shadow (default true), charView (default true: steep views draw it from the characters' lower angle), flash, alpha, xray, pick (r.pick finds it) }\n497:- `game.setView(v)`: switch the view: an id from E.VIEWS ('iso', 'side', ...) or a View; keeps zoom and turn\n1102:- `E.shapeSprite(id, o = {})`: a shape as a sprite (E.sprite's kind: r.sprite, px.sprite, inventories, HUDs, portraits): E.shapeSprite(id, { view: 'iso', facing, size (its scale, 1), mats, params, outline: true | a color | false }). The view is a name or a View, as given (r.shape draws steep views from the characters' angle: E.charView(view) gives that); a bag icon is the item's shape seen at an angle. r.sprite stands it on its feet (foot: [x, y] in the sprite) unless an anchor is given","stderr":"\nShell cwd was reset to /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan__20261103-174822__x21985c/work","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Dc4vGvcwFJtEACix5nvQWX","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
