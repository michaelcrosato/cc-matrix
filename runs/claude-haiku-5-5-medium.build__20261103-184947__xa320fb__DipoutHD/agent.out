\nconst info = await page.evaluate(() => ({ scene: window.__scene || null, hasGame: typeof My3D2dge !== 'undefined', backend: (My3D2dge.World3D && My3D2dge.World3D.backend) || null, cur: My3D2dge.current ? My3D2dge.current.scene && My3D2dge.current.scene.name : null }));\nconsole.log(JSON.stringify(info));\nconsole.log(errors.slice(0, 12).join('\\n') || 'no errors');\nawait browser.close();\nEOF\nexport TMPDIR=$PWD/.tmp && timeout 100 node tests/browser/smoke.mjs 2>&1 | head -40","description":"Run browser smoke test of the bundle"}},"wire_ingest_context":{"toolu_015fPkfe8UHvpiVAc35ZbJAS":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-184947__xa320fb/work/DipoutHD-WipeoutHD-claude-haiku-5-5-medium-20261103-184947"}}}
