 = G[k]; while (r.length < 9) r.push('.'.repeat(r[0].length)); }\nconst cache = new Map();\n/** Compose a string into sprite rows (height 9). Returns { rows, w }. */\nexport function textRows(str) {\n  let hit = cache.get(str); if (hit) return hit;\n  const rows = ['', '', '', '', '', '', '', '', ''];\n  let w = 0;\n  for (const ch of str) {\n    const g = G[ch] ?? G['?'];\n    for (let i = 0; i < 9; i++) rows[i] += g[i] + '.';\n    w += g[0].length + 1;\n  }\n  hit = { rows, w: Math.max(0, w - 1) };\n  if (cache.size > 4000) cache.clear();\n  cache.set(str, hit);\n  return hit;\n}\nexport const textWidth = (s) => textRows(s).w;\nexport const LINE = 12;\n/** Greedy wrap into lines that fit maxW art pixels. */\nexport function wrapText(str, maxW) {\n  const out = [];\n  for (const para of String(str).split('\\n')) {\n    let line = '';\n    for (const word of para.split(' ')) {\n      const t = line ? line + ' ' + word : word;\n      if (textWidth(t) > maxW && line) { out.push(line); line = word; } else line = t;\n    }\n    out.push(line);\n  }\n  return out;\n}\nE\nnode -e '\nimport(\"./ui/font.js\").then(m=>{const r=m.textRows(\"Hello, World! 0123 Ég\");console.log(r.w);console.log(r.rows.join(\"\\n\").replace(/\\./g,\" \"))})'"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10289,"cache_read_input_tokens":157442,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10289},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f7fc0c99-6050-4a36-bbad-13de512b63e9","uuid":"ae05c329-fe61-4b93-aa04-fcc0f015ca1f","timestamp":"2026-11-06T00:23:57.770Z","request_id":"req_011CgkikaS9V16W9QY4tBpZT","wire_tool_inputs":{"toolu_01DfAbTVLQx1RtnevcWqEmCE":{"command":"cd /home/micha/dev/cc-matrix/r