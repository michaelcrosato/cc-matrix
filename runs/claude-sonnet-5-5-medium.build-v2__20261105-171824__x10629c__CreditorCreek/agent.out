if (rock.payout) { g.dropItem('beanbag', rock.x + 0.5, rock.z + 1.4); } if (rock.hp <= 0) { rock.gone = true; g.syncAll(); const bug = g.rng() < 0.5; if (bug) { await g.sys.reveal.catchThing(g, BUGS.find(b => b.id === 'pillbug')); } } return; }\n    const hole = w.town.holes.find(h => h.x === tx && h.z === tz);\n    if (hole) { if (hole.buried) { g.ui.toast('Something is buried here. It is growing quietly.'); return; } w.town.holes.splice(w.town.holes.indexOf(hole), 1); g.syncAll(); g.sfx('dig'); return; }\n    const crack = w.town.cracks.find(c => c.x === tx && c.z === tz && !c.dug); const tile = g.tiles[tz * TW + tx];\n    if (tile !== T.GRASS && tile !== T.PATH && tile !== T.SAND || g.grid.solid(tx + 0.5, tz + 0.5)) { g.ui.toast(\"Can't dig here. It's a bad hole location.\"); return; }\n    if (crack) { crack.dug = true; w.town.holes.push({ x: tx, z: tz }); g.syncAll(); if (crack.fossil) { const r = seeded('fossil', w.seed, w.day, tx, tz); const owned = Object.keys(w.coll.fossil); const id = FOSSILS[r.int(0, FOSSILS.length - 1)].id; g.dropItem(id, tx + 0.5, tz + 1.3, true); await g.say(null, 'Something hard! |A fossil, or a very confident rock.'); g.errandProgress?.('dig'); } else { g.dropItem('beanbag', tx + 0.5, tz + 1.3); g.ui.toast('A bag of beans! Somebody buried their weekend.'); } }\n    else { w.town.holes.push({ x: tx, z: tz }); g.syncAll(); if (g.rng() < 0.15) g.dropItem('shell', tx + 0.5, tz + 1.2); g.errandProgress?.('dig'); }\n  },\n  /** Bury a bag of beans: grows in 2 days, tripled. */\n  bury(g, hole) { hole.buried = { day: g.world.day, year: g.world.year, n: 1000 }; },\n};\nexport const flowers = {\n  async water(g) {\n    const w = g.world, p = g.player; const f = verbsFront(g); const tx = Math.floor(f.x), tz = Math.floor(f.z);\n    await p.act('Water', 1.0); g.sfx('water'); let n = 0;\n    for (const fl of w.town.flowers) if (Math.abs(fl.x - tx) <= 1 && Math.abs(fl.z - tz) <= 1) { fl.wet = 1; fl.wilt = false; fl.dry = 0; n++; g.sparkle(fl.x + 0