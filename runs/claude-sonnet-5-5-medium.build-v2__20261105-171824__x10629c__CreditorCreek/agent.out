await import('../ui/screens.js'); await new Promise(res => { const sc = new ListScreen({ title: 'Lost & Found', items: () => w.lost.map((l, i) => ({ label: item(l.id).name, sub: l.town ? 'Found by the bee.' : 'Left by you, for someone luckier (or you).', item: item(l.id), i })), pickLabel: 'Take', onPick: (row) => { if (g.give(row.item.id)) { w.lost.splice(row.i, 1); g.sfx('pickup'); } else g.ui.toast('Pockets full.'); return w.lost.length ? undefined : 'close'; } }); g.ui.push(sc); sc.promise.then(res); }); }\n    else if (c === 1) { const { PocketsScreen } = await import('../ui/screens.js'); const s = await new Promise(res => g.ui.push(new PocketsScreen({ title: 'Leave which?', pick: res }))); if (!s) return; if (g.take(s.id)) { w.lost.push({ id: s.id }); g.sfx('pick'); await g.say(clem, 'Left. Logged. Lost, technically, by you, deliberately.'); } }\n  },\n};\n\"\"\"\ns=s.replace(\"return { homeRoom, chimeEdit, bed, favours, placement, catalogue,\",\"return { homeRoom, chimeEdit, bed, favours, placement, catalogue, lostFound,\")\nopen(p,'w').write(s)\np='src/systems/time.js'; s=open(p).read()\ns=s.replace(\"g.sys.plant?.grow?.(g);\",\"g.sys.plant?.grow?.(g); g.sys.lostFound?.daily?.(g);\")\nopen(p,'w').write(s)\n# umbrella with pattern + 64-deep village\np='src/actors/player.js'; s=open(p).read()\ns=s.replace(\"  applyPattern() {\",\"\"\"  applyUmbrella() {\n    const L = this.g.world.look; if (!L.umbrella) return; const it = { umb_red: 'red', umb_blue: 'blue', umb_pattern: 'white' }[L.umbrella] ?? 'red'; const pat = L.umbrella === 'umb_pattern' ? this.g.world.patterns.find(Boolean) : null;\n    const cone = new THREE.Mesh(new THREE.ConeGeometry(0.8, 0.45, 10), toonMaterial(PALETTE[it])); cone.position.set(0.55, 1.75, 0); const pole = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.03, 1.2, 5), toonMaterial(PALETTE.ink)); pole.position.set(0.55, 1.2, 0);\n    if (pat) { const data = new Uint8Array(1024); pat.px.forEach((c, i) => { const hex = PALETTE[PALETTE_NAM