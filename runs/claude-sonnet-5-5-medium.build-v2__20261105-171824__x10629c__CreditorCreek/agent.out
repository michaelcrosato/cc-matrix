=== 'moatosaur' ? 'The Moatosaur: skull, torso and tail, each shown when donated' : 'The Regretodon: skull, neck and torso, each shown when donated', tags: ['fossil', 'item'], palette: { bone: 'white', rib: 'mist' }, params: { skull: [0, 0, 1], torso: [0, 0, 1], tail: [0, 0, 1] },\n  parts: (p) => { const out = []; if (kind === 'moatosaur') { if (p.torso > 0.5) { for (let i = 0; i < 5; i++) out.push({ box: [0.08, 0.5, 0.6], at: [i * 0.25 - 0.5, 0.7, 0], rot: [0, 0, (i - 2) * 6], c: 'bone' }); out.push({ box: [1.4, 0.08, 0.1], at: [0, 0.45, 0], c: 'rib' }); } if (p.skull > 0.5) { out.push({ ball: [0.5, 0.4, 0.35], at: [-1.0, 0.95, 0], c: 'bone' }, { box: [0.4, 0.15, 0.25], at: [-1.3, 0.85, 0], c: 'rib' }); } if (p.tail > 0.5) for (let i = 0; i < 6; i++) out.push({ ball: [0.22 - i * 0.025, 0.2 - i * 0.02, 0.2 - i * 0.02], at: [0.8 + i * 0.25, 0.5 - i * 0.05, 0], c: 'bone' }); } else { if (p.torso > 0.5) { out.push({ ball: [1.0, 0.6, 0.7], at: [0, 0.6, 0], c: 'bone' }); for (let i = 0; i < 4; i++) out.push({ box: [0.06, 0.5, 0.5], at: [i * 0.25 - 0.4, 0.6, 0], c: 'rib' }); } if (p.tail > 0.5) for (let i = 0; i < 6; i++) out.push({ ball: [0.2, 0.2, 0.2], at: [-0.6 - i * 0.12, 0.9 + i * 0.22, 0], c: 'bone' }); if (p.skull > 0.5) out.push({ ball: [0.35, 0.28, 0.25], at: [-1.35, 2.3, 0], c: 'bone' }); } if (!out.length) out.push({ ball: [0.02, 0.02, 0.02], at: [0, 0.02, 0], c: 'bone' }); return out; },\n});\nexport const SKELETON_DEFS = { moatosaur: skeletonDef('moatosaur'), regretodon: skeletonDef('regretodon') };\nE\npython3 - <<'E'\np='src/art/items3d.js'; s=open(p).read()\ns=s.replace(\"import { THREE, textureDef, TEXTURE_LIBRARY, textureMap, toonMaterial, PALETTE } from '../engine.js';\",\"import { THREE, textureDef, TEXTURE_LIBRARY, textureMap, toonMaterial, PALETTE, buildModel } from '../engine.js';\\nimport { fishDef, bootDef, BUG_DEFS, TOOL_DEFS, SKELETON_DEFS } from './models.js';\")\n# replace buildFish\ni=s.index(\"export function buildFish(def) {\"); j=s.index(\"export function buildBugModel(b) {\")\ns=s[:i]+\"\"\"const mk = (d, o = {}) => { const obj = buildModel(d, o).object; obj.traverse(m => { if (m.isMesh) { m.castShadow = true; m.receiveShadow = true; } }); return obj; };\nexport function buildFish(def) {\n  if (def.junk) return mk(bootDef); const sz = [0.5, 0.75, 1.0, 1.3][def.size ?? 0]; const c = FISHCOL[(def.price / 100 | 0) % 8]; const body = def.id === 'goldencarp' || def.id === 'pufferfish' ? 'sand' : c;\n  const g = mk(fishDef, { params: { sz, flat: def.id === 'flounder' ? 0.5 : def.id === 'pufferfish' ? 1.2 : 1 }, palette: { body, belly: def.id === 'goldencarp' ? 'sand' : 'white' } }); if (def.id === 'eel') g.scale.set(1.6, 0.5, 0.8); if (def.id === 'flounder') g.scale.set(1.1, 0.4, 1.4); if (def.id === 'pufferfish') g.scale.setScalar(1.15); return g;\n}\n\"\"\"+s[j:]\ni=s.index(\"export function buildBugModel(b) {\"); j=s.index(\"export function buildCatchModel\")\ns=s[:i]+\"\"\"const BUG_KIND = { cabbagebutterfly: 'butterfly', swallowtail: 'butterfly', moth: 'butterfly', dragonfly: 'dragonfly', bumblebee: 'bee', stagbeetle: 'beetle', rhinobeetle: 'beetle', snail: 'snail', ladybird: 'ladybird', woollybear: 'caterpillar', cricket: 'hopper', grasshopper: 'hopper', mantis: 'hopper', firefly: 'firefly' };\nconst BUGCOL = { cabbagebutterfly: 'white', pillbug: 'slate', ladybird: 'red', pondskater: 'ink', cricket: 'plum', moth: 'mist', grasshopper: 'lime', dragonfly: 'cyan', bumblebee: 'sand', snail: 'sand', cicada: 'green', swallowtail: 'orange', firefly: 'sand', woollybear: 'orange', mantis: 'green', snowflea: 'ink', stagbeetle: 'plum', rhinobeetle: 'ink' };\nexport function buildBugModel(b) { const kind = BUG_KIND[b.id] ?? 'plain'; const col = BUGCOL[b.id] ?? 'lime'; const pal = kind === 'butterfly' ? { wing: col === 'orange' ? 'orange' : col, body: b.id === 'swallowtail' ? 'ink' : 'white' } : kind === 'firefly' || kind === 'snail' || kind === 'ladybird' ? {} : { body: col }; return mk(BUG_DEFS[kind], { palette: pal }); }\n\"\"\"+s[j:]\ni=s.index(\"export function buildToolModel(id) {\"); j=s.index(\"/** Composite fossil skeletons\")\ns=s[:i]+\"export function buildToolModel(id) { return mk(TOOL_DEFS[id] ?? TOOL_DEFS.net); }\\n\"+s[j:]\ni=s.index(\"export function buildSkeleton(kind, have) {\"); j=s.index(\"const P = (id, name, rows, legend)\")\ns=s[:i]+\"export function buildSkeleton(kind, have) { const parts = kind === 'moatosaur' ? { skull: have.moa_skull, torso: have.moa_torso, tail: have.moa_tail } : { skull: have.reg_skull, torso: have.reg_torso, tail: have.reg_neck }; return mk(SKELETON_DEFS[kind], { params: { skull: parts.skull ? 1 : 0, torso: parts.torso ? 1 : 0, tail: parts.tail ? 1 : 0 } }); }\\n\"+s[j:]\nopen(p,'w').write(s)\np='src/main.js'; s=open(p).read()\ns=s.replace(\"container: document.getElementById('app'), aspect: 'fixed', quality: 'high',\",\"container: document.getElementById('app'), aspect: 'fixed', quality: info ? 'medium' : 'high',\")\nopen(p,'w').write(s)\nE\nnode kit/check.mjs --sheets src/art/models.js 2>&1 | grep -E \"^(OK|FAIL)|problem\\(s\\), [1-9]|^    !\" | head -20","is_backgrounded":false,"task_type":"local_bash","uuid":"16a51916-5468-47fc-b173-bb15e633cc13","session_id":"f7fc0c99-6050-4a36-bbad-13de512b63e9"}
{"type":"system","subtype":"task_notification","task_id":"bomt87obn","run_id":"0mw4dpr2b-102707ec","tool_use_id":"toolu_019VMZTUzenVSsockgEhVswK","status":"completed","output_file":"","summary":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-171824__x10629c/work/CreditorCreek*/; cat >> src/art/models.js <<'E'\n// ---- Items as parametric ModelDefs: fish, bugs, tools, fossil skeletons\nexport const fishDef = model({\n  id: 'cc-fish', about: 'A fish: body, belly, tail, dorsal fin and an eye; size is a parameter', tags: ['fish', 'item'], palette: { body: 'sky', belly: 'white', eye: 'ink' }, params: { sz: [1, 0.5, 1.3], flat: [1, 0.4, 1.2] },\n  parts: (p) => [{ ball: [0.7 * p.sz, 0.32 * p.sz * p.flat, 0.25 * p.sz], at: [0, 0.2, 0], c: 'body' }, { ball: [0.6 * p.sz, 0.12 * p.sz, 0.2 * p.sz], at: [0, 0.2 - 0.07 * p.sz, 0.02], c: 'belly' }, { box: [0.12 * p.sz, 0.3 * p.sz, 0.04], at: [-0.4 * p.sz, 0.2, 0], rot: [0, 0, 20], c: 'body' }, { box: [0.2 * p.sz, 0.12 * p.sz, 0.04], at: [0, 0.2 + 0.18 * p.sz, 0], rot: [0, 0, 10], c: 'body' }, { box: [0.05, 0.05, 0.28 * p.sz], at: [0.22 * p.sz, 0.2 + 0.04 * p.sz, 0], c: 'eye' }],\n});\nexport const bootDef = model({ id: 'cc-boot', about: 'An old boot', tags: ['junk', 'item'], palette: { leather: 'orange', sole: 'plum' }, parts: [{ box: [0.35, 0.5, 0.25], at: [0, 0.3, 0], c: 'leather' }, { box: [0.6, 0.18, 0.25], at: [0.2, 0.1, 0], c: 'sole' }] });\nconst bug = (id, about, parts, palette = { body: 'lime', wing: 'white', mark: 'ink' }) => model({ id: 'cc-bug-' + id, about, tags: ['bug', 'item'], palette, parts });\nexport const BUG_DEFS = {\n  butterfly: bug('butterfly', 'A butterfly with two pairs of wings', [{ box: [0.06, 0.06, 0.3], at: [0, 0.1, 0], c: 'mark' }, ...[-1, 1].flatMap(s => [{ box: [0.3, 0.03, 0.22], at: [s * 0.18, 0.15, 0.04], rot: [0, 0, s * -12], c: 'wing' }, { box: [0.22, 0.03, 0.16], at: [s * 0.14, 0.14, -0.12], rot: [0, 0, s * -8], c: 'body' }])], { body: 'orange', wing: 'white', mark: 'ink' }),\n  dragonfly: bug('dragonfly', 'A dragonfly: long body, four wings', [{ box: [0.06, 0.06, 0.6], at: [0, 0.1, 0], c: 'body' }, { ball: [0.1, 0.1, 0.1], at: [0, 0.1, 0.32], c: 'mark' }, ...[-1, 1].flatMap(s => [0.1, -0.05].map(z => ({ box: [0.4, 0.02, 0.1], at: [s * 0.22, 0.14, z], c: 'wing' })))], { body: 'cyan', wing: 'white', mark: 'red' }),\n  bee: bug('bee', 'A bumblebee', [{ ball: [0.28, 0.24, 0.34], at: [0, 0.15, 0], c: 'body' }, { box: [0.3, 0.1, 0.06], at: [0, 0.17, 0.04], c: 'mark' }, { box: [0.3, 0.1, 0.06], at: [0, 0.17, -0.08], c: 'mark' }, ...[-1, 1].map(s => ({ box: [0.2, 0.02, 0.12], at: [s * 0.14, 0.29, 0], c: 'wing' }))], { body: 'sand', wing: 'white', mark: 'ink' }),\n  beetle: bug('beetle', 'A beetle with a horn', [{ ball: [0.3, 0.2, 0.42], at: [0, 0.12, 0], c: 'body' }, { cone: [0.06, 0.2, 0.06], at: [0, 0.22, 0.28], rot: [70, 0, 0], c: 'mark' }, { box: [0.04, 0.04, 0.18], at: [-0.07, 0.13, 0.3], c: 'mark' }, { box: [0.04, 0.04, 0.18], at: [0.07, 0.13, 0.3], c: 'mark' }], { body: 'plum', wing: 'white', mark: 'ink' }),\n  snail: bug('snail', 'A snail with a shell', [{ box: [0.2, 0.08, 0.34], at: [0, 0.04, 0], c: 'body' }, { ball: [0.26, 0.26, 0.26], at: [0, 0.2, -0.04], c: 'wing' }], { body: 'sand', wing: 'orange', mark: 'ink' }),\n  ladybird: bug('ladybird', 'A ladybird', [{ ball: [0.22, 0.14, 0.26], at: [0, 0.08, 0], c: 'body' }, { ball: [0.08, 0.06, 0.08], at: [0, 0.08, 0.14], c: 'mark' }, { box: [0.02, 0.15, 0.24], at: [0, 0.09, 0], c: 'mark' }], { body: 'red', wing: 'white', mark: 'ink' }),\n  caterpillar: bug('caterpillar', 'A woolly caterpillar', [0, 1, 2, 3].map(i => ({ ball: [0.2, 0.18, 0.18], at: [0, 0.12, i * 0.14 - 0.2], c: i % 2 ? 'mark' : 'body' })), { body: 'orange', wing: 'white', mark: 'ink' }),\n  hopper: bug('hopper', 'A grasshopper or cricket', [{ box: [0.1, 0.1, 0.4], at: [0, 0.16, 0], c: 'body' }, { box: [0.04, 0.2, 0.04], at: [0.08, 0.1, -0.12], rot: [0, 0, 30], c: 'body' }, { box: [0.04, 0.2, 0.04], at: [-0.08, 0.1, -0.12], rot: [0, 0, -30], c: 'body' }, { box: [0.03, 0.03, 0.2], at: [0, 0.22, 0.3], rot: [-30, 0, 0], c: 'mark' }], { body: 'lime', wing: 'white', mark: 'ink' }),\n  firefly: bug('firefly', 'A firefly with a glowing tail', [{ ball: [0.1, 0.1, 0.22], at: [0, 0.1, 0], c: 'mark' }, { ball: [0.16, 0.16, 0.16], at: [0, 0.08, -0.16], c: 'body', glow: true }], { body: 'sand', wing: 'white', mark: 'ink' }),\n  plain: bug('plain', 'A small bug', [{ ball: [0.22, 0.16, 0.3], at: [0, 0.12, 0], c: 'body' }, { box: [0.2, 0.02, 0.2], at: [0, 0.2, 0], c: 'wing' }]),\n};\nconst tool = (id, about, parts, palette) => model({ id: 'cc-tool-' + id, about, tags: ['tool', 'item'], palette, parts });\nexport const TOOL_DEFS = {\n  net: tool('net', 'A bug net', [{ cyl: [0.05, 1.2, 0.05], at: [0, 0.6, 0], c: 'wood' }, { cyl: [0.5, 0.05, 0.5], at: [0, 1.25, 0], c: 'rim' }, { cone: [0.45, 0.4, 0.45], at: [0, 1.05, 0], rot: [180, 0, 0], c: 'mesh' }], { wood: 'orange', rim: 'white', mesh: 'sky' }),\n  rod: tool('rod', 'A fishing rod', [{ cyl: [0.04, 1.5, 0.04], at: [0, 0.75, 0], rot: [0, 0, 10], c: 'wood' }, { box: [0.02, 0.5, 0.02], at: [0.28, 1.5, 0], c: 'line' }], { wood: 'orange', line: 'white' }),\n  shovel: tool('shovel', 'A shovel', [{ cyl: [0.05, 0.9, 0.05], at: [0, 0.55, 0], c: 'wood' }, { box: [0.28, 0.35, 0.05], at: [0, 0.1, 0], c: 'blade' }], { wood: 'orange', blade: 'mist' }),\n  axe: tool('axe', 'An axe', [{ cyl: [0.06, 0.9, 0.06], at: [0, 0.45, 0], c: 'wood' }, { box: [0.36, 0.25, 0.06], at: [0.16, 0.85, 0], c: 'blade' }], { wood: 'orange', blade: 'slate' }),\n  can: tool('can', 'A watering can', [{ cyl: [0.32, 0.3, 0.32], at: [0, 0.15, 0], c: 'body' }, { cyl: [0.06, 0.4, 0.06], at: [0.22, 0.36, 0], rot: [0, 0, -50], c: 'body' }], { body: 'sky' }),\n  sling: tool('sling', 'A slingshot', [{ box: [0.06, 0.35, 0.06], at: [0, 0.2, 0], c: 'wood' }, { box: [0.28, 0.05, 0.05], at: [0, 0.4, 0], c: 'wood' }], { wood: 'orange' }),\n};\nexport const skeletonDef = (kind) => model({\n  id: 'cc-skeleton-' + kind, about: kind === 'moatosaur' ? 'The Moatosaur: skull, torso and tail, each shown when donated' : 'The Regretodon: skull, neck and torso, each shown when donated', tags: ['fossil', 'item'], palette: { bone: 'white', rib: 'mist' }, params: { skull: [0, 0, 1], torso: [0, 0, 1], tail: [0, 0, 1] },\n  parts: (p) => { const out = []; if (kind === 'moatosaur') { if (p.torso > 0.5) { for (let i = 0; i < 5; i++) out.push({ box: [0.08, 0.5, 0.6], at: [i * 0.25 - 0.5, 0.7, 0], rot: [0, 0, (i - 2) * 6], c: 'bone' }); out.push({ box: [1.4, 0.08, 0.1], at: [0, 0.45, 0], c: 'rib' }); } if (p.skull > 0.5) { out.push({ ball: [0.5, 0.4, 0.35], at: [-1.0, 0.95, 0], c: 'bone' }, { box: [0.4, 0.15, 0.25], at: [-1.3, 0.85, 0], c: 'rib' }); } if (p.tail > 0.5) for (let i = 0; i < 6; i++) out.push({ ball: [0.22 - i * 0.025, 0.2 - i * 0.02, 0.2 - i * 0.02], at: [0.8 + i * 0.25, 0.5 - i * 0.05, 0], c: 'bone' }); } else { if (p.torso > 0.5) { out.push({ ball: [1.0, 0.6, 0.7], at: [0, 0.6, 0], c: 'bone' }); for (let i = 0; i < 4; i++) out.push({ box: [0.06, 0.5, 0.5], at: [i * 0.25 - 0.4, 0.6, 0], c: 'rib' }); } if (p.tail > 0.5) for (let i = 0; i < 6; i++) out.push({ ball: [0.2, 0.2, 0.2], at: [-0.6 - i * 0.12, 0.9 + i * 0.22, 0], c: 'bone' }); if (p.skull > 0.5) out.push({ ball: [0.35, 0.28, 0.25], at: [-1.35, 2.3, 0], c: 'bone' }); } if (!out.length) out.push({ ball: [0.02, 0.02, 0.02], at: [0, 0.02, 0], c: 'bone' }); return out; },\n});\nexport const SKELETON_DEFS = { moatosaur: skeletonDef('moatosaur'), regretodon: skeletonDef('regretodon') };\nE\npython3 - <<'E'\np='src/art/items3d.js'; s=open(p).read()\ns=s.replace(\"import { THREE, textureDef, TEXTURE_LIBRARY, textureMap, toonMaterial, PALETTE } from '../engine.js';\",\"import { THREE, textureDef, TEXTURE_LIBRARY, textureMap, toonMaterial, PALETTE, buildModel } from '../engine.js';\\nimport { fishDef, bootDef, BUG_DEFS, TOOL_DEFS, SKELETON_DEFS } from './models.js';\")\n# replace buildFish\ni=s.index(\"export function buildFish(def) {\"); j=s.index(\"export function buildBugModel(b) {\")\ns=s[:i]+\"\"\"const mk = (d, o = {}) => { const obj = buildModel(d, o).object; obj.traverse(m => { if (m.isMesh) { m.castShadow = true; m.receiveShadow = true; } }); return obj; };\nexport function buildFish(def) {\n  if (def.junk) return mk(bootDef); const sz = [0.5, 0.75, 1.0, 1.3][def.size ?? 0]; const c = FISHCOL[(def.price / 100 | 0) % 8]; const body = def.id === 'goldencarp' || def.id === 'pufferfish' ? 'sand' : c;\n  const g = mk(fishDef, { params: { sz, flat: def.id === 'flounder' ? 0.5 : def.id === 'pufferfish' ? 1.2 : 1 }, palette: { body, belly: def.id === 'goldencarp' ? 'sand' : 'white' } }); if (def.id === 'eel') g.scale.set(1.6, 0.5, 0.8); if (def.id === 'flounder') g.scale.set(1.1, 0.4, 1.4); if (def.id === 'pufferfish') g.scale.setScalar(1.15); return g;\n}\n\"\"\"+s[j:]\ni=s.index(\"export function buildBugModel(b) {\"); j=s.index(\"export function buildCatchModel\")\ns=s[:i]+\"\"\"const BUG_KIND = { cabbagebutterfly: 'butterfly', swallowtail: 'butterfly', moth: 'butterfly', dragonfly: 'dragonfly', bumblebee: 'bee', stagbeetle: 'beetle', rhinobeetle: 'beetle', snail: 'snail', ladybird: 'ladybird', woollybear: 'caterpillar', cricket: 'hopper', grasshopper: 'hopper', mantis: 'hopper', firefly: 'firefly' };\nconst BUGCOL = { cabbagebutterfly: 'white', pillbug: 'slate', ladybird: 'red', pondskater: 'ink', cricket: 'plum', moth: 'mist', grasshopper: 'lime', dragonfly: 'cyan', bumblebee: 'sand', snail: 'sand', cicada: 'green', swallowtail: 'orange', firefly: 'sand', woollybear: 'orange', mantis: 'green', snowflea: 'ink', stagbeetle: 'plum', rhinobeetle: 'ink' };\nexport function buildBugModel(b) { const kind = BUG_KIND[b.id] ?? 'plain'; const col = BUGCOL[b.id] ?? 'lime'; const pal = kind === 'butterfly' ? { wing: col === 'orange' ? 'orange' : col, body: b.id === 'swallowtail' ? 'ink' : 'white' } : kind === 'firefly' || kind === 'snail' || kind === 'ladybird' ? {} : { body: col }; return mk(BUG_DEFS[kind], { palette: pal }); }\n\"\"\"+s[j:]\ni=s.index(\"export function buildToolModel(id) {\"); j=s.index(\"/** Composite fossil skeletons\")\ns=s[:i]+\"export function buildToolModel(id) { return mk(TOOL_DEFS[id] ?? TOOL_DEFS.net); }\\n\"+s[j:]\ni=s.index(\"export function buildSkeleton(kind, have) {\"); j=s.index(\"const P = (id, name, rows, legend)\")\ns=s[:i]+\"export function buildSkeleton(kind, have) { const parts = kind === 'moatosaur' ? { skull: have.moa_skull, torso: have.moa_torso, tail: have.moa_tail } : { skull: have.reg_skull, torso: have.reg_torso, tail: have.reg_neck }; return mk(SKELETON_DEFS[kind], { params: { skull: parts.skull ? 1 : 0, torso: parts.torso ? 1 : 0, tail: parts.tail ? 1 : 0 } }); }\\n\"+s[j:]\nopen(p,'w').write(s)\np='src/main.js'; s=open(p).read()\ns=s.replace(\"container: document.getElementById('app'), aspect: 'fixed', quality: 'high',\",\"container: document.getElementById('app'), aspect: 'fixed', quality: info ? 'medium' : 'high',\")\nopen(p,'w').write(s)\nE\nnode kit/check.mjs --sheets src/art/models.js 2>&1 | grep -E \"^(OK|FAIL)|problem\\(s\\), [1-9]|^    !\" | head -20","uuid":"e78a532c-d7ec-4d4c-859b-bb79987a9654","session_id":"f7fc0c99-6050-4a36-bbad-13de512b63e9"}
