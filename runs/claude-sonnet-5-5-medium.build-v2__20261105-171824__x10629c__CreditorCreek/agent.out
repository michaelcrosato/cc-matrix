 }); } }\n  },\n  async use(g, f, fd, mesh) {\"\"\",1)\nopen(p,'w').write(s)\nE\nnode tools/build.mjs | tail -1; H=../CreditorCreek-*.html\nnode tests/shot.mjs $H shots/tv.png \"const G=__GAME__.game; await __GAME__.sys.dev.reset(G); const w=G.world; w.min=600; G.sys.time.visual(G,0,true); w.home.furn.push({id:'seatv',x:5,z:1,rot:0},{id:'loftmirror',x:2,z:1,rot:0},{id:'mosscouch',x:3,z:4,rot:0}); await G.sys.places.go(G,'home','door','home'); G.zoomOverride=2.0; G.target.set(1000+0+4,0.8,3);\" 150 | tail -2; grep -n \"defRoom({ id: 'home'\" src/systems/venues.js | head -1","uuid":"9c3f45f8-386f-49b8-b522-420152fad206","session_id":"f7fc0c99-6050-4a36-bbad-13de512b63e9"}
