rue; this._seq = 0;\n    input.gamepadButtons = { ...PAD_MAP };\n    for (const k of ['Tab', 'Space', 'Escape', 'Backspace', 'F1', 'F2', 'F3', 'F4']) input.preventKeys.add(k);\n    if (typeof window !== 'undefined') {\n      const bump = (dev) => () => { this.anyInput++; if (dev) this.device = dev; };\n      window.addEventListener('keydown', (e) => { if (e.isTrusted === false && !this.trustSynthetic) { /* synthetic keys still count */ } this.anyInput++; this.device = 'kb'; this.lastKey = e.key; });\n      window.addEventListener('mousedown', bump('kb')); window.addEventListener('touchstart', () => { this.anyInput++; this.touched = true; });\n      window.addEventListener('pointermove', (e) => { if (e.pointerType === 'touch') return; const d = Math.abs(e.movementX || 0) + Math.abs(e.movementY || 0); if (d > 0 || e.movementX === undefined) { this.anyInput++; this.device = 'kb'; } });\n    }\n  }\n  /** Call once per frame at the start of update. */\n  poll(dt) {\n    const i = this.input;\n    for (const c of PADCODES) if (i.isDown(c)) { this.device = 'pad'; this.anyInput++; break; }\n    const a = i.padAxis; if (Math.hypot(a.x, a.y) > 0.4) { this.device = 'pad'; this.anyInput++; }\n    const p = i.pointer; const nx = (p.x + 1) / 2 * W, ny = (1 - p.y) / 2 * H;\n    this.ptr.moved = Math.abs(nx - this._lastPtr[0]) + Math.abs(ny - this._lastPtr[1]) > 0.5 && p.over;\n    this._lastPtr[0] = nx; this._lastPtr[1] = ny; this.ptr.x = nx; this.ptr.y = ny; this.ptr.over = p.over;\n    this.ptr.left = i.wasPressed('MouseLeft'); this.ptr.right = i.wasPressed('MouseRight'); this.ptr.leftDown = i.isDown('MouseLeft');\n    if (this.ptr.left || this.ptr.right) this.device = 'kb';\n    // menu navigation with repeat: stick, d-pad, arrows, wasd\n    const ax = i.moveAxis(); const nav = this._nav; let x = 0, y = 0;\n    if (ax.x > 0.6) x = 1; else if (ax.x < -0.6) x = -1; if (ax.y > 0.6) y = -1; else if (ax.y < -0.6) y = 1;\n    if (i.isDown('ArrowRight', 'PadRight')) x = 1; if (i.isDown('ArrowLeft', 'PadLeft')) x = -1; if (i.isDown('ArrowDown', 'PadDown')) y = 1; if (i.isDown('ArrowUp', 'PadUp')) y = -1;\n    this.nav = { x: 0, y: 0 };\n    if (x || y) { nav.t -= dt; if (!nav.held || nav.t <= 0) { this.nav = { x, y }; nav.t = nav.held ? 0.12 : 0.35; nav.held = true; } } else { nav.held = false; nav.t = 0; }\n    this.dt = dt;\n  }\n  pressed(a) { const c = ACTIONS[a]; for (const k of c) if (this.input.wasPressed(k)) return true; return false; }\n  down(a) { const c = ACTIONS[a]; for (const k of c) if (this.input.isDown(k)) return true; return false; }\n  /** A press that is not also a movement key (so E is confirm but WASD is not). */\n  confirmPressed() { return this.pressed('confirm') || this.ptr.left; }\n  backPressed() { return this.pressed('back') || this.ptr.right; }\n  sample() { return { device: this.device, any: this.anyInput }; }\n}\nE\ncat > ui/draw.js <<'E'\n// Drawing helpers on the engine HUD (480x270 art pixels): text, panels, glyph prompts.\nimport { textRows, textWidth, wrapText, LINE } from './font.js';\nexport { textWidth, wrapText, LINE };\nconst DISC = ['..#####..', '.#######.', '#########', '#########', '#########', '#########', '#########', '.#######.', '..#####..'];\nconst SYM = {\n  cross: ['#...#', '.#.#.', '..#..', '.#.#.', '#...#'], circle: ['.###.', '#...#', '#...#', '#...#', '.###.'],\n  square: ['#####', '#...#', '#...#', '#...#', '#####'], triangle: ['..#..', '.#.#.', '.#.#.', '#...#', '#####'],\n};\nexport const PS_COL = { cross: 'sky', circle: 'red', square: 'plum', triangle: 'lime' };\nexport const XB_COL = { A: 'lime', B: 'red', X: 'sky', Y: 'sand' };\nexport class Draw {\n  constructor(hud) { this.hud = hud; this.W = 480; this.H = 270; }\n  begin() { this.hud.clear(); }\n  rect(x, y, w, h, c) { this.hud.rect(Math.round(x), Math.round(y), Math.round(w), Math.round(h), c); }\n  text(x, y, s, color = 'ink', o = {}) {\n    s = String(s); const t = textRows(s); let px = x;\n    if (o.align === 'center') px = x - Math.floor(t.w / 2); else if (o.align === 'right') px = x - t.w;\n    px = Math.round(px); y = Math.round(y);\n    if (o.shadow) this.hud.sprite(px + 1, y + 1, t.rows, { '#': o.shadow }, { shadow: false });\n    this.hud.sprite(px, y, t.rows, { '#': color }, { shadow: false });\n    return t.w;\n  }\n  /** Wrapped paragraph; returns height. Optional maxLines. */\n  para(x, y, s, w, color = 'ink', o = {}) {\n    const lines = wrapText(s, w); const n = o.maxLines ? Math.min(lines.length, o.maxLines) : lines.length;\n    for (let i = 0; i < n; i++) this.text(x, y + i * LINE, lines[i], color, o);\n    return n * LINE;\n  }\n  panel(x, y, w, h, o = {}) {\n    const fill = o.fill ?? 'white', trim = o.trim ?? 'sand';\n    this.rect(x + 2, y + 2, w, h, o.shadow ?? 'night');\n    this.rect(x, y, w, h, 'ink'); this.rect(x + 1, y + 1, w - 2, h - 2, trim); this.rect(x + 3, y + 3, w - 6, h - 6, fill);\n  }\n  disc(x, y, col, sym, symCol = 'white') {\n    this.hud.sprite(x, y, DISC, { '#': col }, { shadow: false });\n    if (SYM[sym]) this.hud.sprite(x + 2, y + 2, SYM[sym], { '#': symCol }, { shadow: false });\n    return 9;\n  }\n  /** A prompt glyph for an action label. dev: 'pad' | 'kb'; glyphs: 'ps' | 'xbox'. Returns width. */\n  glyph(x, y, spec, dev, glyphs) {\n    // spec: { ps: 'cross'|'L1'..., xb: 'A', kb: 'E' }\n    if (dev === 'pad') {\n      if (glyphs === 'xbox') {\n        const a = spec.xb ?? spec.ps; const col = XB_COL[a];\n        if (col) { this.hud.sprite(x, y, DISC, { '#': col }, { shadow: false }); this.text(x + 2, y + 1, a, 'ink'); return 9; }\n        return this.cap(x, y, a);\n      }\n      const p = spec.ps; if (SYM[p]) return this.disc(x, y, PS_COL[p], p);\n      return this.cap(x, y, p, 'night', 'white');\n    }\n    return this.cap(x, y, spec.kb ?? '?');\n  }\n  cap(x, y, label, fill = 'white', ink = 'ink') {\n    const w = textWidth(label) + 5; this.rect(x, y + 1, w, 10, 'ink'); this.rect(x + 1, y + 2, w - 2, 8, fill); this.rect(x + 1, y + 10, w - 2, 1, 'mist');\n    this.text(x + 3, y + 2, label, ink); return w;\n  }\n}\nE\necho ok"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9376,"cache_read_input_tokens":167731,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9376},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f7fc0c99-6050-4a36-bbad-13de512b63e9","uuid":"95057ff9-f61d-4742-9f0f-ebc1e569d14f","timestamp":"2026-11-06T00:24:34.392Z","request_id":"req_011Cgkiq5mN7tMzn4kfTdXfb","wire_tool_inputs":{"toolu_01Q5SRqWUYrcxxevNjJ7HSQM":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-171824__x10629c/work/CreditorCreek-AnimalCrossingCityFolk-claude-sonnet-5-5-medium-20261105-171824/src; \ncat > ui/controls.js <<'E'\n// Input layer: virtual actions over keyboard / mouse / pad, last-device tracking, menu navigation, pointer in HUD pixels.\nexport const W = 480, H = 270;\nexport const PAD_MAP = { 0: 'PadCross', 1: 'PadCircle', 2: 'PadSquare', 3: 'PadTriangle', 4: 'PadL1', 5: 'PadR1', 6: 'PadL2', 7: 'PadR2', 8: 'PadCreate', 9: 'PadOptions', 10: 'PadL3', 11: 'PadR3', 12: 'PadUp', 13: 'PadDown', 14: 'PadLeft', 15: 'PadRight', 16: 'PadPS', 17: 'PadTouch' };\nconst PADCODES = Object.values(PAD_MAP);\nexport const ACTIONS = {\n  confirm: ['PadCross', 'KeyE', 'Enter'], back: ['PadCircle', 'Escape', 'Backspace'], tool: ['PadSquare', 'Space', 'KeyF'],\n  pockets: ['PadTriangle', 'Tab', 'KeyI'], prevTool: ['PadL1'], nextTool: ['PadR1'], camL: ['PadL2', 'KeyQ'], camR: ['PadR2', 'KeyR'],\n  map: ['PadTouch', 'PadUp', 'KeyM'], almanac: ['PadDown', 'KeyJ'], emote: ['PadLeft', 'KeyG'], pause: ['PadOptions', 'Escape'],\n  zoomIn: ['Equal', 'NumpadAdd'], zoomOut: ['Minus', 'NumpadSubtract'],\n  navUp: [