k++) { d.rect(Math.round(x0 + (x1 - x0) * k / n), Math.round(y0 + (y1 - y0) * k / n), 1, 1, col); } } }\n    if (!ui.busy && g.sys.interact.target?.at && g.place === 'town') {\"\"\",1)\ns=s.replace(\"import { drawIcon } from '../ui/icons.js';\",\"import { drawIcon } from '../ui/icons.js';\\nimport { groundHeight } from '../world/townMap.js';\")\nopen(p,'w').write(s)\np='src/systems/verbs.js'; s=open(p).read()\ns=s.replace(\"    this.fishing = { tgt, kind,\",\"    this.ring(g, tgt.x, tgt.z); this.fishing = { tgt, kind,\")\ns=s.replace(\"  makeBobber() {\",\"\"\"  /** Expanding rings on the water where the bobber lands or a fish bites. */\n  ring(g, x, z) { this.rings ??= []; const m = new THREE.Mesh(new THREE.TorusGeometry(0.3, 0.03, 4, 18), new THREE.MeshBasicNodeMaterial({ color: PALETTE.white })); m.rotation.x = Math.PI / 2; m.position.set(x, -0.2, z); g.sys.nature.group.add(m); this.rings.push({ m, t: 0 }); },\n  updateRings(g, dt) { if (!this.rings?.length) return; for (const r of this.rings) { r.t += dt; const s = 1 + r.t * 3; r.m.scale.set(s, s, s); r.m.material.opacity = Math.max(0, 1 - r.t / 0.9); r.m.material.transparent = true; } this.rings = this.rings.filter(r => { if (r.t > 0.9) { r.m.parent?.remove(r.m); return false; } return true; }); },\n  makeBobber() {\"\"\",1)\ns=s.replace(\"g.splash(F.tgt.x, F.tgt.z); }\\n      else if (F.t > 12)\",\"g.splash(F.tgt.x, F.tgt.z); this.ring(g, F.tgt.x, F.tgt.z); }\\n      else if (F.t > 12)\")\ns=s.replace(\"    const w = g.world, p = g.player, c = g.ui.c; if (!w || g.place === 'round') return;\",\"    const w = g.world, p = g.player, c = g.ui.c; if (!w || g.place === 'round') return; this.updateRings(g, dt);\")\nopen(p,'w').write(s)\n# Mayor arrives on spring Festival Day\np='src/systems/year.js'; s=open(p).read()\ns=s.replace(\"gather(g, [[19, 21], [23, 21], [21, 25], [18, 24], [24, 24]]); await g.say(trundle, 'Welcome... to the Seed Toss.\",\"gather(g, [[19, 21], [23, 21], [21, 25], [18, 24], [24, 24]]); { const