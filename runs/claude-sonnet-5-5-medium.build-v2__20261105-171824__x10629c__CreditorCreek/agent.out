il the top UI screen id (or none) matches, pressing confirm if dialogue. */\nexport function advance(e, g, max = 600) { let n = 0; while (g.ui.stack.length && n++ < max) { const t = g.ui.top; if (t.id === 'dialogue' || t.id === 'list' || t.id === 'pockets') { press(e, 'Enter', 2); } else { press(e, 'Escape', 2); } } return n; }\nexport async function walkTo(e, g, x, z, max = 1500) { let n = 0; g.player.moveTarget = { x, z }; while (n++ < max) { e.step(2); const d = Math.hypot(g.player.pos.x - x, g.player.pos.z - z); if (d < 0.4) break; if (!g.player.moveTarget) g.player.moveTarget = { x, z }; } g.player.moveTarget = null; return Math.hypot(g.player.pos.x - x, g.player.pos.z - z); }\nlet fails = 0, count = 0; export const T = { ok(c, m) { count++; if (!c) { fails++; console.log('FAIL', m); } }, eq(a, b, m) { count++; if (a !== b) { fails++; console.log('FAIL', m, 'got', a, 'want', b); } }, get fails() { return fails; }, get count() { return count; } };\nE\ncat > tests/play/smoke.mjs <<'E'\nimport { boot, newGame, hold, press, T, walkTo } from './lib.mjs';\nconst { e, g } = await boot(); e.step(10);\nT.eq(g.mode, 'title', 'starts on title');\nconst w = await newGame(g, e); w.min = 480; g.sys.time.visual(g, 0, true); e.step(30);\nT.eq(g.mode, 'play', 'play mode');\nconst x0 = g.player.pos.x; g.player.reset([12, 24]); hold(e, ['KeyD'], 60); T.ok(Math.hypot(g.player.pos.x - 12, g.player.pos.z - 24) > 1, 'player moves with keyboard');\nconst d = await walkTo(e, g, 21, 23); T.ok(d < 1, 'walks across the plaza by mouse-target ' + d.toFixed(2));\nconsole.log(g.status(), e.errors.length ? e.errors : ''); console.log('count', T.count, 'fails', T.fails);\nE\nnode tools/build.mjs 2>&1 | grep -E \"ERROR|built\"; timeout 120 node tests/play/smoke.mjs 2>&1 | tail -12"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1189,"cache_read_input_tokens":400134,"cache_creation"