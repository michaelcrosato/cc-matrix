6, 0.6, 0.06], [0, 0.1, -0.5], 'a', 'Pelvis', [70, 0, 0]]] },\n  badger: { head: [0.85, 0.7, 0.85], body: [0.85, 0.6, 0.62], parts: [['box', [0.2, 0.7, 0.05], [0, 0.4, 0.4], 'white', 'Head'], ['ball', [0.15, 0.15, 0.1], [-0.33, 0.7, 0], 'c'], ['ball', [0.15, 0.15, 0.1], [0.33, 0.7, 0], 'c'], ['ball', [0.12, 0.1, 0.1], [0, 0.3, 0.43], 'k'], ['box', [0.5, 0.3, 0.1], [0, 0.0, 0.31], 'white', 'Torso']] },\n  sloth: { head: [0.85, 0.72, 0.8], body: [0.75, 0.65, 0.6], longArms: true, parts: [['box', [0.9, 0.2, 0.05], [0, 0.4, 0.38], 'a'], ['ball', [0.12, 0.1, 0.1], [0, 0.28, 0.4], 'k'], ['box', [0.4, 0.05, 0.05], [0, 0.15, 0.4], 'k']] },\n  goat: { head: [0.75, 0.75, 0.75], body: [0.7, 0.62, 0.55], parts: [['box', [0.12, 0.4, 0.12], [-0.22, 0.85, 0], 'sand', 'Head', [-20, 0, -15]], ['box', [0.12, 0.4, 0.12], [0.22, 0.85, 0], 'sand', 'Head', [-20, 0, 15]], ['box', [0.18, 0.3, 0.1], [0, 0.02, 0.38], 'white'], ['box', [0.4, 0.3, 0.3], [0, 0.18, 0.42], 'c'], ['box', [0.3, 0.3, 0.05], [0, 0.0, 0.35], 'plum', 'Torso']] },\n  hermit: { head: [0.7, 0.6, 0.7], body: [0.6, 0.5, 0.5], parts: [['box', [0.7, 0.9, 0.7], [0, 0.4, -0.45], 'slate', 'Torso'], ['box', [0.55, 0.2, 0.05], [0, 0.55, -0.1], 'mist', 'Torso'], ['box', [0.55, 0.2, 0.05], [0, 0.3, -0.1], 'mist', 'Torso'], ['cyl', [0.06, 0.35, 0.06], [-0.2, 0.7, 0.2], 'c'], ['cyl', [0.06, 0.35, 0.06], [0.2, 0.7, 0.2], 'c'], ['ball', [0.25, 0.22, 0.12], [-0.5, 0.2, 0.15], 'a', 'Torso']] },\n  person: { head: [0.85, 0.82, 0.82], body: [0.7, 0.6, 0.55], parts: [] },\n};\nconst FACE_SKIP = new Set(['person']);\nfunction addPart(joints, cols, spec) {\n  let [shape, size, pos, col, joint = 'Head', rot] = spec;\n  if (shape === 'torusish') shape = 'ball';\n  const g = new Mesh(GEO[shape], mat(cols[col] ?? col));\n  g.scale.set(...size); g.position.set(...pos); if (rot) g.rotation.set(rot[0] * Math.PI / 180, rot[1] * Math.PI / 180, rot[2] * Math.PI / 180);\n  (joints[joint] ?? joints.Head).add(g); return g;\n}\n/** Build a critter. spec: { species, c, a, outfit, hair, hat, scale }. Returns { object, joints, parts, height }. */\nexport function buildCritter(spec) {\n  const sp = SPECIES[spec.species] ?? SPECIES.person; const root = new Group(); root.name = 'Critter';\n  const c = spec.c ?? 'sand', a = spec.a ?? 'orange';\n  const cols = { c, a, b: c === 'white' ? 'mist' : 'white', k: 'ink', w: 'white' };\n  const legLen = (sp.legLen ?? 1) * 0.5; const bodyW = sp.body?.[0] ?? 0.7, bodyH = sp.body?.[1] ?? 0.6, bodyD = sp.body?.[2] ?? 0.55;\n  const mk = (name, x, y, z, parent) => { const g = new Group(); g.name = name; g.position.set(x, y, z); parent.add(g); return g; };\n  const joints = {};\n  joints.Pelvis = mk('Pelvis', 0, legLen, 0, root);\n  joints.LegR = mk('LegR', -0.17, 0, 0, joints.Pelvis); joints.LegL = mk('LegL', 0.17, 0, 0, joints.Pelvis);\n  joints.Torso = mk('Torso', 0, 0, 0, joints.Pelvis);\n  joints.Head = mk('Head', 0, bodyH * 0.9, 0, joints.Torso);\n  const armY = bodyH * 0.8; const armX = bodyW * 0.5 + 0.06;\n  joints.ArmR = mk('ArmR', -armX, armY, 0, joints.Torso); joints.ArmL = mk('ArmL', armX, armY, 0, joints.Torso);\n  const outfitCol = spec.outfit ?? (spec.species === 'person' ? 'red' : c);\n  // body\n  const torso = new Mesh(GEO.ball, mat(outfitCol)); torso.scale.set(bodyW, bodyH * 1.15, bodyD); torso.position.set(0, bodyH * 0.5, 0); joints.Torso.add(torso);\n  // head\n  const head = new Mesh(GEO.ball, mat(spec.skin ?? c)); head.scale.set(...sp.head); head.position.set(0, sp.head[1] * 0.46, 0); joints.Head.add(head);\n  // legs and arms (hang down along -y; X rotation swings)\n  const limb = (j, w, len, col, footCol) => { const m = new Mesh(GEO.cyl, mat(col)); m.scale.set(w, len, w); m.position.y = -len / 2; j.add(m); if (footCol) { const f = new Mesh(GEO.box, mat(footCol)); f.scale.set(w * 1.15, 0.1, w * 1.7); f.position.set(0, -len + 0.04, w * 0.35); j.add(f); } };\n  if (!sp.noLegs) { limb(joints.LegR, 0.2, legLen, spec.pants ?? c, spec.shoes ?? a); limb(joints.LegL, 0.2, legLen, spec.pants ?? c, spec.shoes ?? a); }\n  const armLen = sp.longArms ? 0.62 : 0.4;\n  limb(joints.ArmR, 0.17, armLen, outfitCol); limb(joints.ArmL, 0.17, armLen, outfitCol);\n  const hand = (j) => { const h = new Mesh(GEO.ball, mat(spec.skin ?? c)); h.scale.set(0.2, 0.2, 0.2); h.position.y = -armLen; j.add(h); }; hand(joints.ArmR); hand(joints.ArmL);\n  // face\n  const parts = {};\n  if (!FACE_SKIP.has(spec.species) || true) {\n    const ey = sp.head[1] * 0.58, ez = sp.head[2] * 0.46;\n    for (const [side, x] of [['eyeL', 0.17], ['eyeR', -0.17]]) { const e = new Mesh(GEO.box, mat('ink')); e.scale.set(0.1, 0.15, 0.05); e.position.set(x * sp.head[0] / 0.85, ey, ez); joints.Head.add(e); parts[side] = e; }\n    const mouth = new Mesh(GEO.box, mat('ink')); mouth.scale.set(0.14, 0.04, 0.05); mouth.position.set(0, sp.head[1] * 0.28, ez + 0.02); joints.Head.add(mouth); parts.mouth = mouth;\n  }\n  for (const s of sp.parts) { const m = addPart(joints, cols, s); if (s[0] === 'ball' && s[3] === 'k' && s[2][1] < 0.4 && s[4] == null) parts.nose = m; }\n  if (sp.tail) parts.tail = true;\n  // person: hair, hat\n  if (spec.species === 'person') {\n    const hc = spec.hair ?? 'plum', style = spec.hairStyle ?? 0;\n    const hh = new Mesh(GEO.ball, mat(hc)); hh.scale.set(0.95, 0.55 + (style % 3) * 0.1, 0.9); hh.position.set(0, 0.66, -0.04); joints.Head.add(hh);\n    if (style % 2) { const tail = new Mesh(GEO.ball, mat(hc)); tail.scale.set(0.3, 0.5, 0.3); tail.position.set(0, 0.35, -0.45); joints.Head.add(tail); }\n    if (style >= 4) { const bun = new Mesh(GEO.ball, mat(hc)); bun.scale.set(0.3, 0.3, 0.3); bun.position.set(0, 0.98, -0.1); joints.Head.add(bun); }\n  }\n  if (spec.hat) { const hm = new Mesh(GEO.cyl, mat(spec.hat)); hm.scale.set(0.7, 0.22, 0.7); hm.position.set(0, sp.head[1] * 0.95, 0); joints.Head.add(hm); const top = new Mesh(GEO.cyl, mat(spec.hat)); top.scale.set(0.42, 0.3, 0.42); top.position.set(0, sp.head[1] * 0.95 + 0.2, 0); joints.Head.add(top); parts.hat = [hm, top]; }\n  if (spec.glasses) { const gm = new Mesh(GEO.box, mat(spec.glasses)); gm.scale.set(0.55, 0.08, 0.04); gm.position.set(0, sp.head[1] * 0.58, sp.head[2] * 0.5); joints.Head.add(gm); }\n  const s = (spec.scale ?? 1) * (sp.scale ?? 1) * 0.85; root.scale.setScalar(s);\n  root.traverse(o => { if (o.isMesh) { o.castShadow = true; o.receiveShadow = false; } });\n  setLookLayer(root, 'actors');\n  return { object: root, joints, parts, height: (legLen + bodyH * 0.9 + sp.head[1] * 0.95) * s, species: spec.species };\n}\nexport const SPECIES_LIST = Object.keys(SPECIES);\nE\ncat > art/clips.js <<'E'\n// Animation clips as data (ClipDef, 30 fps) compiled with the engine's compileClips, played with THREE.AnimationMixer.\nimport { compileClips, validateClip } from '../engine.js';\nimport { RIG } from './critter.js';\nconst R = (x = 0, y = 0, z = 0) => [x, y, z];\n// pose helper: only listed joints move\nconst arms = (r, l) => ({ ArmR: r, ArmL: l });\nconst loopClip = (name, frames, keys, extra = {}) => ({ name, frames, loop: true, keys, ...extra });\nconst once = (name, frames, keys, extra = {}) => ({ name, frames, loop: false, keys, ...extra });\nconst bob = (y) => ({ r: R(), p: [0, y, 0] });\nconst IDLE = { Pelvis: bob(0) };\nexport const CLIP_DEFS = [\n  loopClip('Idle', 60, [[0, { Pelvis: bob(0), Torso: R(0), ...arms(R(4, 0, 4), R(4, 0, -4)) }], [30, { Pelvis: bob(0.02), Torso: R(2), Head: R(-2), ...arms(R(2, 0, 6), R(2, 0, -6)) }], [60, { Pelvis: bob(0), Torso: R(0), ...arms(R(4, 0, 4), R(4, 0, -4)) }]]),\n  loopClip('IdleBored', 90, [[0, { Head: R(0, 0, 0), ...arms(R(5, 0, 5), R(5, 0, -5)) }], [30, { Head: R(10, 25, 0), Torso: R(0, -6, 0), ...arms(R(-20, 0, 8), R(5, 0, -5)) }], [60, { Head: R(5, -25, 0), Torso: R(0, 6, 0), ...arms(R(5, 0, 5), R(-20, 0, -8)) }], [90, { Head: R(0), ...arms(R(5, 0, 5), R(5, 0, -5)) }]]),\n  loopClip('Walk', 24, [[0, { Pelvis: bob(0), LegR: R(-32), LegL: R(28), ...arms(R(28), R(-32)), Torso: R(2, 5, 0) }], [6, { Pelvis: bob(0.05)