= 0.03; this.clouds.add(m); m.userData.dissolve = true; } }\n    const wet = isWet(g.weather), town = g.place === 'town' && g.mode !== 'title'; const p = g.player.pos;\n    this.puddles.visible = wet && town; if (this.puddles.visible) this.puddles.children.forEach((m, i) => { m.visible = true; m.position.set(Math.round(p.x / 6) * 6 + ((i * 53) % 17) - 8, 0.03, Math.round(p.z / 6) * 6 + ((i * 29) % 13) - 6); });\n    this.clouds.visible = town && g.weather === 'sun' && g.hour > 7 && g.hour < 18; if (this.clouds.visible) this.clouds.children.forEach((m, i) => { m.position.x = (g.t * 0.6 + i * 22) % 100 - 10; m.position.z = 8 + i * 8; m.material.opacity = 0.2; });\n  },\n  update(g, dt) {\n    if (g.world && g.mode !== 'title' && g.mode !== 'round') this.weatherProps(g, dt);\"\"\",1)\nopen(p,'w').write(s)\n# Quill appraisal: dug fossils are lumps\np='src/systems/gather.js'; s=open(p).read()\ns=s.replace(\"g.dropItem(id, tx + 0.5, tz + 1.3, true); await g.say(null, 'Something hard! |A fossil, or a very confident rock.');\",\"g.dropItem('lump', tx + 0.5, tz + 1.3, true, id); await g.say(null, 'Something hard! |A fossil, or a very confident rock. Dr. Quill appraises these.');\")\ns=s.replace(\"async pickup(g, it) { const w = g.world; const def = item(it.id); if (g.give(it.id)) {\",\"async pickup(g, it) { const w = g.world; const def = item(it.id); if (g.give(it.id, 1, it.real ? { real: it.real } : null)) {\")\nopen(p,'w').write(s)\np='src/game-utils.js'; s=open(p).read()\ns=s.replace(\"P.give = function (id, n = 1) {\",\"P.give = function (id, n = 1, extra = null) {\")\ns=s.replace(\"for (let i = 0; i < n; i++) w.pockets.push({ id, n: 1 }); w.owned[id] = true; return true; };\",\"for (let i = 0; i < n; i++) w.pockets.push({ id, n: 1, ...(extra ?? {}) }); w.owned[id] = true; return true; };\")\ns=s.replace(\"P.dropItem = function (id, x, z, quiet) { const f = this.grid.free(x, z); this.world.town.items.push({ uid: this.uid(), id, x: f[0], z: f[1] });\",\"P.dropItem = funct