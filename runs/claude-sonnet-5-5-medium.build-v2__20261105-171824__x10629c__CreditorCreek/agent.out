{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgkobmPnerrMwuJYV8Mqk","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0145h7RtnJFcngNxKYTQUqL7","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-171824__x10629c/work/CreditorCreek*/; cat > src/art/items3d.js <<'E'\n// Parametric item models: fish and bugs per species, tools in hand, fossil skeletons, paintings (pixel TextureDefs with forgery variants).\nimport { THREE, textureDef, TEXTURE_LIBRARY, textureMap, toonMaterial, PALETTE } from '../engine.js';\nimport { part } from '../world/scenery.js';\nconst { Group } = THREE;\nconst FISHCOL = ['sky', 'orange', 'sand', 'cyan', 'mist', 'lime', 'red', 'plum'];\nexport function buildFish(def) {\n  const g = new Group(); const sz = [0.5, 0.75, 1.0, 1.3][def.size ?? 0]; const c = FISHCOL[(def.price / 100 | 0) % 8]; const belly = def.id === 'goldencarp' ? 'sand' : 'white';\n  if (def.junk) { part(g, 'box', [0.35, 0.5, 0.25], [0, 0.3, 0], 'orange'); part(g, 'box', [0.6, 0.18, 0.25], [0.2, 0.1, 0], 'plum'); return g; }\n  const col = def.id === 'goldencarp' ? 'sand' : def.id === 'pufferfish' ? 'sand' : c; part(g, 'ball', [0.7 * sz, 0.32 * sz, 0.25 * sz], [0, 0, 0], col); part(g, 'ball', [0.6 * sz, 0.12 * sz, 0.2 * sz], [0, -0.07 * sz, 0.02], belly);\n  part(g, 'box', [0.12 * sz, 0.3 * sz, 0.04], [-0.4 * sz, 0, 0], col, [0, 0, 20]); part(g, 'box', [0.2 * sz, 0.12 * sz, 0.04], [0, 0.18 * sz, 0], col, [0, 0, 10]); part(g, 'box', [0.05, 0.05, 0.28 * sz], [0.22 * sz, 0.04 * sz, 0], 'ink');\n  if (def.id === 'pufferfish') { g.scale.setScalar(1.15); part(g, 'ball', [0.5 * sz, 0.5 * sz, 0.5 * sz], [0.02, 0, 0], 'sand'); }\n  if (def.id === 'eel') g.scale.set(1.6, 0.5, 0.8); if (def.id === 'flounder') g.scale.set(1.1, 0.4, 1.4); return g;\n}\nexport function buildBugModel(b) {\n  const g = new Group(); const C = { cabbagebutterfly: 'white', pillbug: 'slate', ladybird: 'red', pondskater: 'ink', cricket: 'plum', moth: 'mist', grasshopper: 'lime', dragonfly: 'cyan', bumblebee: 'sand', snail: 'sand', cicada: 'green', swallowtail: 'orange', firefly: 'lime', woollybear: 'orange', mantis: 'green', snowflea: 'ink', stagbeetle: 'plum', rhinobeetle: 'ink' }[b.id] ?? 'lime';\n  const id = b.id;\n  if (['cabbagebutterfly', 'swallowtail', 'moth'].includes(id)) { part(g, 'box', [0.06, 0.06, 0.3], [0, 0, 0], 'ink'); for (const s of [-1, 1]) { part(g, 'box', [0.3, 0.03, 0.22], [s * 0.18, 0.05, 0.04], C, [0, 0, s * -12]); part(g, 'box', [0.22, 0.03, 0.16], [s * 0.14, 0.04, -0.12], id === 'swallowtail' ? 'ink' : C, [0, 0, s * -8]); } }\n  else if (id === 'dragonfly') { part(g, 'box', [0.06, 0.06, 0.6], [0, 0, 0], C); for (const s of [-1, 1]) for (const z of [0.1, -0.05]) part(g, 'box', [0.4, 0.02, 0.1], [s * 0.22, 0.04, z], 'white'); part(g, 'ball', [0.1, 0.1, 0.1], [0, 0, 0.32], 'red'); }\n  else if (id === 'bumblebee') { part(g, 'ball', [0.28, 0.24, 0.34], [0, 0, 0], 'sand'); part(g, 'box', [0.3, 0.1, 0.06], [0, 0.02, 0.04], 'ink'); part(g, 'box', [0.3, 0.1, 0.06], [0, 0.02, -0.08], 'ink'); for (const s of [-1, 1]) part(g, 'box', [0.2, 0.02, 0.12], [s * 0.14, 0.14, 0], 'white'); }\n  else if (['stagbeetle', 'rhinobeetle'].includes(id)) { part(g, 'ball', [0.3, 0.2, 0.42], [0, 0.06, 0], C); part(g, 'cone', [0.06, 0.2, 0.06], [0, 0.15, 0.28], 'ink', [70, 0, 0]); if (id === 'stagbeetle') { part(g, 'box', [0.04, 0.04, 0.18], [-0.07, 0.07, 0.3], 'ink'); part(g, 'box', [0.04, 0.04, 0.18], [0.07, 0.07, 0.3], 'ink'); } }\n  else if (['snail'].includes(id)) { part(g, 'box', [0.2, 0.08, 0.34], [0, 0.04, 0], 'sand'); part(g, 'ball', [0.26, 0.26, 0.26], [0, 0.18, -0.04], 'orange'); }\n  else if (id === 'ladybird') { part(g, 'ball', [0.22, 0.14, 0.26], [0, 0.04, 0], 'red'); part(g, 'ball', [0.08, 0.06, 0.08], [0, 0.04, 0.14], 'ink'); part(g, 'box', [0.02, 0.15, 0.24], [0, 0.04, 0], 'ink'); }\n  else if (id === 'woollybear') { for (let i = 0; i < 4; i++) part(g, 'ball', [0.2, 0.18, 0.18], [0, 0.06, i * 0.14 - 0.2], i % 2 ? 'ink' : 'orange'); }\n  else if (['cricket', 'grasshopper', 'mantis'].includes(id)) { part(g, 'box', [0.1, 0.1, 0.4], [0, 0.1, 0], C); part(g, 'box', [0.04, 0.2, 0.04], [0.08, 0.06, -0.12], C, [0, 0, 30]); part(g, 'box', [0.04, 0.2, 0.04], [-0.08, 0.06, -0.12], C, [0, 0, -30]); part(g, 'box', [0.03, 0.03, 0.2], [0, 0.16, 0.3], 'ink', [-30, 0, 0]); }\n  else if (id === 'firefly') { part(g, 'ball', [0.1, 0.1, 0.22], [0, 0, 0], 'ink'); const m = new THREE.Mesh(new THREE.SphereGeometry(0.08, 6, 5), new THREE.MeshBasicNodeMaterial({ color: PALETTE.sand })); m.position.set(0, -0.02, -0.14); g.add(m); }\n  else { part(g, 'ball', [0.22, 0.16, 0.3], [0, 0.06, 0], C); part(g, 'box', [0.2, 0.02, 0.2], [0, 0.14, 0], 'white'); }\n  return g;\n}\nexport function buildCatchModel(def) { if (def.kind === 'fish') return buildFish(def); if (def.kind === 'bug') { const g = buildBugModel(def); g.scale.setScalar(1.8); return g; } if (def.kind === 'fossil') { const g = new Group(); part(g, 'box', [0.5, 0.2, 0.3], [0, 0.1, 0], 'sand'); part(g, 'ball', [0.3, 0.2, 0.22], [0, 0.26, 0], 'white'); return g; } const g = new Group(); part(g, 'box', [0.4, 0.4, 0.4], [0, 0.2, 0], 'sand'); return g; }\nexport function buildToolModel(id) {\n  const g = new Group();\n  if (id === 'net') { part(g, 'cyl', [0.05, 1.2, 0.05], [0, 0.6, 0], 'orange'); part(g, 'cyl', [0.5, 0.05, 0.5], [0, 1.25, 0], 'white'); part(g, 'cone', [0.45, 0.4, 0.45], [0, 1.05, 0], 'sky', [180, 0, 0]); }\n  else if (id === 'rod') { part(g, 'cyl', [0.04, 1.5, 0.04], [0, 0.75, 0], 'orange', [0, 0, 10]); part(g, 'box', [0.02, 0.5, 0.02], [0.28, 1.5, 0], 'white'); }\n  else if (id === 'shovel') { part(g, 'cyl', [0.05, 0.9, 0.05], [0, 0.45, 0], 'orange'); part(g, 'box', [0.28, 0.35, 0.05], [0, -0.1, 0], 'mist'); }\n  else if (id === 'axe') { part(g, 'cyl', [0.06, 0.9, 0.06], [0, 0.45, 0], 'orange'); part(g, 'box', [0.36, 0.25, 0.06], [0.16, 0.85, 0], 'slate'); }\n  else if (id === 'can') { part(g, 'cyl', [0.32, 0.3, 0.32], [0, 0.15, 0], 'sky'); part(g, 'cyl', [0.06, 0.4, 0.06], [0.22, 0.32, 0], 'sky', [0, 0, -50]); }\n  else if (id === 'sling') { part(g, 'box', [0.06, 0.35, 0.06], [0, 0.2, 0], 'orange'); part(g, 'box', [0.28, 0.05, 0.05], [0, 0.4, 0], 'orange'); }\n  return g;\n}\n/** Composite fossil skeletons for the museum: assembled from donated parts. */\nexport function buildSkeleton(kind, have) {\n  const g = new Group(); const bone = 'white';\n  if (kind === 'moatosaur') { if (have.moa_torso) { for (let i = 0; i < 5; i++) part(g, 'box', [0.08, 0.5, 0.6], [i * 0.25 - 0.5, 0.7, 0], bone, [0, 0, (i - 2) * 6]); part(g, 'box', [1.4, 0.08, 0.1], [0, 0.45, 0], bone); } if (have.moa_skull) { part(g, 'ball', [0.5, 0.4, 0.35], [-1.0, 0.95, 0], bone); part(g, 'box', [0.4, 0.15, 0.25], [-1.3, 0.85, 0], bone); } if (have.moa_tail) for (let i = 0; i < 6; i++) part(g, 'ball', [0.22 - i * 0.025, 0.2 - i * 0.02, 0.2 - i * 0.02], [0.8 + i * 0.25, 0.5 - i * 0.05, 0], bone); }\n  else { if (have.reg_torso) { part(g, 'ball', [1.0, 0.6, 0.7], [0, 0.6, 0], bone); for (let i = 0; i < 4; i++) part(g, 'box', [0.06, 0.5, 0.5], [i * 0.25 - 0.4, 0.6, 0], 'mist'); } if (have.reg_neck) for (let i = 0; i < 6; i++) part(g, 'ball', [0.2, 0.2, 0.2], [-0.6 - i * 0.12, 0.9 + i * 0.22, 0], bone); if (have.reg_skull) part(g, 'ball', [0.35, 0.28, 0.25], [-1.35, 2.3, 0], bone); }\n  return g;\n}\nconst P = (id, name, rows, legend) => textureDef({ id, about: name + ' (parody painting)', tags: ['art'], size: [16, 16], palette: legend.pal, layers: [{ pixels: rows, legend: legend.map }] });\nconst R = (a) => a;\nexport const PAINT_DEFS = {\n  monallama: P('p-monallama', 'Mona Llama', R(['bbbbbbbbbbbbbbbb', 'bbbbbbbbbbbbbbbb', 'bbbbwwbbbbwwbbbb', 'bbbbwwbbbbwwbbbb', 'bbbbwwwwwwwwbbbb', 'bbbbwkwwwwkwbbbb', 'bbbbwwwwwwwwbbbb', 'bbbbwwwrrwwwbbbb', 'bbbbwwwwwwwwbbbb', 'bbbbbwwwwwwbbbbb', 'bbbbpppppppbbbbb', 'bbbppppppppppbbb', 'bbppppppppppppbb', 'bbppppppppppppbb', 'bbbbbbbbbbbbbbbb', 'bbbbbbbbbbbbbbbb']), { pal: { b: 'sand', w: 'white', k: 'ink', r: 'red', p: 'plum' }, map: { b: 'b', w: 'w', k: 'k', r: 'r', p: 'p' } }),\n  goosepearl: P('p-goose', 'Goose with a Pearl Earring', R(['kkkkkkkkkkkkkkkk', 'kkkkkkwwwwkkkkkk', 'kkkkkwwwwwwkkkkk', 'kkkkkwkwwkwkkkkk', 'kkkkkwwwwwwoookk', 'kkkkkkwwwwwwookk', 'kkkkkkwwwwkkkkkk', 'kkkkkkwwwwkkkkkk', 'kkkkkkwwwwkkpkkk', 'kkkkkwwwwwwkkkkk', 'kkkkwwwwwwwwkkkk', 'kkkkbbbbbbbbkkkk', 'kkkbbbbbbbbbbkkk', 'kkkbbbbbbbbbbkkk', 'kkkkkkkkkkkkkkkk', 'kkkkkkkkkkkkkkkk']), { pal: { k: 'night', w: 'white', o: 'orange', p: 'mist', b: 'blue' }, map: { k: 'k', w: 'w', o: 'o', p: 'p', b: 'b' } }),\n  greatwave: P('p-wave', 'The Great Wave Off Beans', R(['ssssssssssssssss', 'ssssssssbbbbssss', 'sssssssbwwwbbsss', 'ssssssbwwwwwwbss', 'sssssbwwwsbwwbss', 'ssssbwwwbbbbwwbs', 'sssbwwwbbbbbbbbs', 'ssbwwbbbbbbbbbbs', 'sbwbbbbbbbbbbbbb', 'bbbbbbbbbbbbbbbb', 'bbnbbnbbbbnbbbbb', 'bbbbbbbbnbbbbbbb', 'bnbbbbbbbbbnbbbb', 'bbbbbbbbbbbbbbnb', 'bbbbnbbbbnbbbbbb', 'bbbbbbbbbbbbbbbb']), { pal: { s: 'sand', b: 'navy', w: 'white', n: 'tan' in {} ? 'sand' : 'sand' }, map: { s: 's', b: 'b', w: 'w', n: 'n' } }),\n  starrybus: P('p-bus', 'The Starry Bus Stop', R(['nnnnynnnnnnynnnn', 'nynnnnnnynnnnnyn', 'nnnnnnynnnnnnnnn', 'nnyyynnnnnyyynnn', 'nnnnnnnnnnnnnnnn', 'nnnnnnnnnnnnnnnn', 'nnbbbbbbbbbbbbnn', 'nnbyybyybyybbbnn', 'nnbbbbbbbbbbbbnn', 'nnbbbbbbbbbbbbnn', 'nnkkkkkkkkkkkknn', 'nnnkknnnnnknnnnn', 'gggggggggggggggg', 'gggggggggggggggg', 'gggggggggggggggg', 'gggggggggggggggg']), { pal: { n: 'navy', y: 'sand', b: 'red', k: 'ink', g: 'green' }, map: { n: 'n', y: 'y', b: 'b', k: 'k', g: 'g' } }),\n  venusflytrap: P('p-venus', 'The Birth of Venus Flytrap', R(['cccccccccccccccc', 'cccccccccccccccc', 'ccccccpppccccccc', 'cccccppggppccccc', 'cccccpgwwgpccccc', 'ccccccpggpcccccc', 'cccccccppccccccc', 'ccccccccgcccccccc'.slice(0, 16), 'ccccccccgcccccccc'.slice(0, 16), 'cccccccgggccccccc'.slice(0, 16), 'wwwwwwwwwwwwwwww', 'cwwcwwcwwcwwcwwc', 'wwwwwwwwwwwwwwww', 'cwwcwwcwwcwwcwwc', 'wwwwwwwwwwwwwwww', 'wwwwwwwwwwwwwwww']), { pal: { c: 'sky', p: 'plum', g: 'green', w: 'white' }, map: { c: 'c', p: 'p', g: 'g', w: 'w' } }),\n  thehonk: P('p-honk', 'The Honk', R(['oooooooooooooooo', 'ooooyyyyooooyyyo', 'ooooooooooooooyy', 'oooooowwwwoooooo', 'ooooowwwwwwooooo', 'oooowkwwwwkwoooo', 'ooooowwwwwwooooo', 'oooooooyyyooooooo'.slice(0, 16), 'oooooooyyyoooooo', 'oooooowwwwoooooo', 'rrrrrwwwwwwrrrrr', 'rrrrwwwwwwwwrrrr', 'rrrwwwwwwwwwwrrr', 'rrrrrrrrrrrrrrrr', 'bbbbbbbbbbbbbbbb', 'bbbbbbbbbbbbbbbb']), { pal: { o: 'orange', y: 'sand', w: 'white', k: 'ink', r: 'red', b: 'navy' }, map: { o: 'o', y: 'y', w: 'w', k: 'k', r: 'r', b: 'b' } }),\n  whistlersmoose: P('p-moose', \"Whistler's Moose\", R(['gggggggggggggggg', 'gggkgggggggkgggg', 'ggkkgggggggkkggg', 'gggkgggggggkgggg', 'gggkkkkkkkkkgggg', 'ggggkkskkskkgggg', 'ggggkkkkkkkkgggg', 'gggggkkkkkkggggg', 'ggggggkkkkgggggg', 'ggkkkkkkkkkkkkgg', 'ggkggkkkkkkggkgg', 'ggkggkkkkkkggkgg', 'ggkggkkkkkkggkgg', 'ggkkkkkkkkkkkkgg', 'wwwwwwwwwwwwwwww', 'wwwwwwwwwwwwwwww']), { pal: { g: 'mist', k: 'slate', s: 'white', w: 'sand' }, map: { g: 'g', k: 'k', s: 's', w: 'w' } }),\n  cheeseearthly: P('p-cheese', 'The Cheese of Earthly Delights', R(['llllllllllllllll', 'lyyylllllllyyyll', 'lyoyllllllyyoyll', 'lyyyllyyyllyyyll', 'llllllyoyllllrrl', 'lllllllyyllllrrl', 'llggllllllggllll', 'llgyllllllgyllll', 'llllllyyyyllllll', 'lllllyoooyllllll', 'lllllyyyyyllllll', 'llrrllllllllgglll'.slice(0, 16), 'llrrllllllllgglll'.slice(0, 16), 'llllllllllllllll', 'llllllllllllllll', 'llllllllllllllll']), { pal: { l: 'lime', y: 'sand', o: 'orange', g: 'green', r: 'red' }, map: { l: 'l', y: 'y', o: 'o', g: 'g', r: 'r' } }),\n};\nlet reg = false;\nexport function registerPaintings() { if (reg) return; reg = true; for (const d of Object.values(PAINT_DEFS)) TEXTURE_LIBRARY.add(d); }\nexport function buildPainting(id, forged = false) {\n  registerPaintings(); const g = new Group(); part(g, 'box', [0.8, 0.8, 0.07], [0, 0, 0], 'sand'); const m = new THREE.Mesh(new THREE.BoxGeometry(0.66, 0.66, 0.04), toonMaterial(PALETTE.white, { map: textureMap('p-' + ({ monallama: 'monallama', goosepearl: 'goose', greatwave: 'wave', starrybus: 'bus', venusflytrap: 'venus', thehonk: 'honk', whistlersmoose: 'moose', cheeseearthly: 'cheese' })[id]) })); m.position.z = 0.04; g.add(m);\n  if (forged) part(g, 'box', [0.08, 0.08, 0.05], [0.25, -0.25, 0.07], 'red'); return g;\n}\nE\npython3 - <<'E'\ns=open('src/art/items3d.js').read()\ns=s.replace(\"n: 'tan' in {} ? 'sand' : 'sand'\",\"n: 'orange'\")\nopen('src/art/items3d.js','w').write(s)\nE\nnode -e 'import(\"./src/art/items3d.js\").then(async m=>{const e=await import(\"./src/pixel-engine.js\"); for(const [k,d] of Object.entries(m.PAINT_DEFS)){const r=e.validateTexture(d); if(r.problems.length) console.log(k,r.problems)} console.log(\"ok\")})' 2>&1 | tail -8"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":795,"cache_read_input_tokens":615953,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":795},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f7fc0c99-6050-4a36-bbad-13de512b63e9","uuid":"013598aa-628d-4522-991e-ef8b1af546ac","timestamp":"2026-11-06T01:27:24.619Z","request_id":"req_011Cgkobm6RThDZ5Yr1JBafp","wire_tool_inputs":{"toolu_0145h7RtnJFcngNxKYTQUqL7":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-171824__x10629c/work/CreditorCreek*/; cat > src/art/items3d.js <<'E'\n// Parametric item models: fish and bugs per species, tools in hand, fossil skeletons, paintings (pixel TextureDefs with forgery variants).\nimport { THREE, textureDef, TEXTURE_LIBRARY, textureMap, toonMaterial, PALETTE } from '../engine.js';\nimport { part } from '../world/scenery.js';\nconst { Group } = THREE;\nconst FISHCOL = ['sky', 'orange', 'sand', 'cyan', 'mist', 'lime', 'red', 'plum'];\nexport function buildFish(def) {\n  const g = new Group(); const sz = [0.5, 0.75, 1.0, 1.3][def.size ?? 0]; const c = FISHCOL[(def.price / 100 | 0) % 8]; const belly = def.id === 'goldencarp' ? 'sand' : 'white';\n  if (def.junk) { part(g, 'box', [0.35, 0.5, 0.25], [0, 0.3, 0], 'orange'); part(g, 'box', [0.6, 0.18, 0.25], [0.2, 0.1, 0], 'plum'); return g; }\n  const col = def.id === 'goldencarp' ? 'sand' : def.id === 'pufferfish' ? 'sand' : c; part(g, 'ball', [0.7 * sz, 0.32 * sz, 0.25 * sz], [0, 0, 0], col); part(g, 'ball', [0.6 * sz, 0.12 * sz, 0.2 * sz], [0, -0.07 * sz, 0.02], belly);\n  part(g, 'box', [0.12 * sz, 0.3 * sz, 0.04], [-0.4 * sz, 0, 0], col, [0, 0, 20]); part(g, 'box', [0.2 * sz, 0.12 * sz, 0.04], [0, 0.18 * sz, 0], col, [0, 0, 10]); part(g, 'box', [0.05, 0.05, 0.28 * sz], [0.22 * sz, 0.04 * sz, 0], 'ink');\n  if (def.id === 'pufferfish') { g.scale.setScalar(1.15); part(g, 'ball', [0.5 * sz, 0.5 * sz, 0.5 * sz], [0.02, 0, 0], 'sand'); }\n  if (def.id === 'eel') g.scale.set(1.6, 0.5, 0.8); if (def.id === 'flounder') g.scale.set(1.1, 0.4, 1.4); return g;\n}\nexport function buildBugModel(b) {\n  const g = new Group(); const C = { cabbagebutterfly: 'white', pillbug: 'slate', ladybird: 'red', pondskater: 'ink', cricket: 'plum', moth: 'mist', grasshopper: 'lime', dragonfly: 'cyan', bumblebee: 'sand', snail: 'sand', cicada: 'green', swallowtail: 'orange', firefly: 'lime', woollybear: 'orange', mantis: 'green', snowflea: 'ink', stagbeetle: 'plum', rhinobeetle: 'ink' }[b.id] ?? 'lime';\n  const id = b.id;\n  if (['cabbagebutterfly', 'swallowtail', 'moth'].includes(id)) { part(g, 'box', [0.06, 0.06, 0.3], [0, 0, 0], 'ink'); for (const s of [-1, 1]) { part(g, 'box', [0.3, 0.03, 0.22], [s * 0.18, 0.05, 0.04], C, [0, 0, s * -12]); part(g, 'box', [0.22, 0.03, 0.16], [s * 0.14, 0.04, -0.12], id === 'swallowtail' ? 'ink' : C, [0, 0, s * -8]); } }\n  else if (id === 'dragonfly') { part(g, 'box', [0.06, 0.06, 0.6], [0, 0, 0], C); for (const s of [-1, 1]) for (const z of [0.1, -0.05]) part(g, 'box', [0.4, 0.02, 0.1], [s * 0.22, 0.04, z], 'white'); part(g, 'ball', [0.1, 0.1, 0.1], [0, 0, 0.32], 'red'); }\n  else if (id === 'bumblebee') { part(g, 'ball', [0.28, 0.24, 0.34], [0, 0, 0], 'sand'); part(g, 'box', [0.3, 0.1, 0.06], [0, 0.02, 0.04], 'ink'); part(g, 'box', [0.3, 0.1, 0.06], [0, 0.02, -0.08], 'ink'); for (const s of [-1, 1]) part(g, 'box', [0.2, 0.02, 0.12], [s * 0.14, 0.14, 0], 'white'); }\n  else if (['stagbeetle', 'rhinobeetle'].includes(id)) { part(g, 'ball', [0.3, 0.2, 0.42], [0, 0.06, 0], C); part(g, 'cone', [0.06, 0.2, 0.06], [0, 0.15, 0.28], 'ink', [70, 0, 0]); if (id === 'stagbeetle') { part(g, 'box', [0.04, 0.04, 0.18], [-0.07, 0.07, 0.3], 'ink'); part(g, 'box', [0.04, 0.04, 0.18], [0.07, 0.07, 0.3], 'ink'); } }\n  else if (['snail'].includes(id)) { part(g, 'box', [0.2, 0.08, 0.34], [0, 0.04, 0], 'sand'); part(g, 'ball', [0.26, 0.26, 0.26], [0, 0.18, -0.04], 'orange'); }\n  else if (id === 'ladybird') { part(g, 'ball', [0.22, 0.14, 0.26], [0, 0.04, 0], 'red'); part(g, 'ball', [0.08, 0.06, 0.08], [0, 0.04, 0.14], 'ink'); part(g, 'box', [0.02, 0.15, 0.24], [0, 0.04, 0], 'ink'); }\n  else if (id === 'woollybear') { for (let i = 0; i < 4; i++) part(g, 'ball', [0.2, 0.18, 0.18], [0, 0.06, i * 0.14 - 0.2], i % 2 ? 'ink' : 'orange'); }\n  else if (['cricket', 'grasshopper', 'mantis'].includes(id)) { part(g, 'box', [0.1, 0.1, 0.4], [0, 0.1, 0], C); part(g, 'box', [0.04, 0.2, 0.04], [0.08, 0.06, -0.12], C, [0, 0, 30]); part(g, 'box', [0.04, 0.2, 0.04], [-0.08, 0.06, -0.12], C, [0, 0, -30]); part(g, 'box', [0.03, 0.03, 0.2], [0, 0.16, 0.3], 'ink', [-30, 0, 0]); }\n  else if (id === 'firefly') { part(g, 'ball', [0.1, 0.1, 0.22], [0, 0, 0], 'ink'); const m = new THREE.Mesh(new THREE.SphereGeometry(0.08, 6, 5), new THREE.MeshBasicNodeMaterial({ color: PALETTE.sand })); m.position.set(0, -0.02, -0.14); g.add(m); }\n  else { part(g, 'ball', [0.22, 0.16, 0.3], [0, 0.06, 0], C); part(g, 'box', [0.2, 0.02, 0.2], [0, 0.14, 0], 'white'); }\n  return g;\n}\nexport function buildCatchModel(def) { if (def.kind === 'fish') return buildFish(def); if (def.kind === 'bug') { const g = buildBugModel(def); g.scale.setScalar(1.8); return g; } if (def.kind === 'fossil') { const g = new Group(); part(g, 'box', [0.5, 0.2, 0.3], [0, 0.1, 0], 'sand'); part(g, 'ball', [0.3, 0.2, 0.22], [0, 0.26, 0], 'white'); return g; } const g = new Group(); part(g, 'box', [0.4, 0.4, 0.4], [0, 0.2, 0], 'sand'); return g; }\nexport function buildToolModel(id) {\n  const g = new Group();\n  if (id === 'net') { part(g, 'cyl', [0.05, 1.2, 0.05], [0, 0.6, 0], 'orange'); part(g, 'cyl', [0.5, 0.05, 0.5], [0, 1.25, 0], 'white'); part(g, 'cone', [0.45, 0.4, 0.45], [0, 1.05, 0], 'sky', [180, 0, 0]); }\n  else if (id === 'rod') { part(g, 'cyl', [0.04, 1.5, 0.04], [0, 0.75, 0], 'orange', [0, 0, 10]); part(g, 'box', [0.02, 0.5, 0.02], [0.28, 1.5, 0], 'white'); }\n  else if (id === 'shovel') { part(g, 'cyl', [0.05, 0.9, 0.05], [0, 0.45, 0], 'orange'); part(g, 'box', [0.28, 0.35, 0.05], [0, -0.1, 0], 'mist'); }\n  else if (id === 'axe') { part(g, 'cyl', [0.06, 0.9, 0.06], [0, 0.45, 0], 'orange'); part(g, 'box', [0.36, 0.25, 0.06], [0.16, 0.85, 0], 'slate'); }\n  else if (id === 'can') { part(g, 'cyl', [0.32, 0.3, 0.32], [0, 0.15, 0], 'sky'); part(g, 'cyl', [0.06, 0.4, 0.06], [0.22, 0.32, 0], 'sky', [0, 0, -50]); }\n  else if (id === 'sling') { part(g, 'box', [0.06, 0.35, 0.06], [0, 0.2, 0], 'orange'); part(g, 'box', [0.28, 0.05, 0.05], [0, 0.4, 0], 'orange'); }\n  return g;\n}\n/** Composite fossil skeletons for the museum: assembled from donated parts. */\nexport function buildSkeleton(kind, have) {\n  const g = new Group(); const bone = 'white';\n  if (kind === 'moatosaur') { if (have.moa_torso) { for (let i = 0; i < 5; i++) part(g, 'box', [0.08, 0.5, 0.6], [i * 0.25 - 0.5, 0.7, 0], bone, [0, 0, (i - 2) * 6]); part(g, 'box', [1.4, 0.08, 0.1], [0, 0.45, 0], bone); } if (have.moa_skull) { part(g, 'ball', [0.5, 0.4, 0.35], [-1.0, 0.95, 0], bone); part(g, 'box', [0.4, 0.15, 0.25], [-1.3, 0.85, 0], bone); } if (have.moa_tail) for (let i = 0; i < 6; i++) part(g, 'ball', [0.22 - i * 0.025, 0.2 - i * 0.02, 0.2 - i * 0.02], [0.8 + i * 0.25, 0.5 - i * 0.05, 0], bone); }\n  else { if (have.reg_torso) { part(g, 'ball', [1.0, 0.6, 0.7], [0, 0.6, 0], bone); for (let i = 0; i < 4; i++) part(g, 'box', [0.06, 0.5, 0.5], [i * 0.25 - 0.4, 0.6, 0], 'mist'); } if (have.reg_neck) for (let i = 0; i < 6; i++) part(g, 'ball', [0.2, 0.2, 0.2], [-0.6 - i * 0.12, 0.9 + i * 0.22, 0], bone); if (have.reg_skull) part(g, 'ball', [0.35, 0.28, 0.25], [-1.35, 2.3, 0], bone); }\n  return g;\n}\nconst P = (id, name, rows, legend) => textureDef({ id, about: name + ' (parody painting)', tags: ['art'], size: [16, 16], palette: legend.pal, layers: [{ pixels: rows, legend: legend.map }] });\nconst R = (a) => a;\nexport const PAINT_DEFS = {\n  monallama: P('p-monallama', 'Mona Llama', R(['bbbbbbbbbbbbbbbb', 'bbbbbbbbbbbbbbbb', 'bbbbwwbbbbwwbbbb', 'bbbbwwbbbbwwbbbb', 'bbbbwwwwwwwwbbbb', 'bbbbwkwwwwkwbbbb', 'bbbbwwwwwwwwbbbb', 'bbbbwwwrrwwwbbbb', 'bbbbwwwwwwwwbbbb', 'bbbbbwwwwwwbbbbb', 'bbbbpppppppbbbbb', 'bbbppppppppppbbb', 'bbppppppppppppbb', 'bbppppppppppppbb', 'bbbbbbbbbbbbbbbb', 'bbbbbbbbbbbbbbbb']), { pal: { b: 'sand', w: 'white', k: 'ink', r: 'red', p: 'plum' }, map: { b: 'b', w: 'w', k: 'k', r: 'r', p: 'p' } }),\n  goosepearl: P('p-goose', 'Goose with a Pearl Earring', R(['kkkkkkkkkkkkkkkk', 'kkkkkkwwwwkkkkkk', 'kkkkkwwwwwwkkkkk', 'kkkkkwkwwkwkkkkk', 'kkkkkwwwwwwoookk', 'kkkkkkwwwwwwookk', 'kkkkkkwwwwkkkkkk', 'kkkkkkwwwwkkkkkk', 'kkkkkkwwwwkkpkkk', 'kkkkkwwwwwwkkkkk', 'kkkkwwwwwwwwkkkk', 'kkkkbbbbbbbbkkkk', 'kkkbbbbbbbbbbkkk', 'kkkbbbbbbbbbbkkk', 'kkkkkkkkkkkkkkkk', 'kkkkkkkkkkkkkkkk']), { pal: { k: 'night', w: 'white', o: 'orange', p: 'mist', b: 'blue' }, map: { k: 'k', w: 'w', o: 'o', p: 'p', b: 'b' } }),\n  greatwave: P('p-wave', 'The Great Wave Off Beans', R(['ssssssssssssssss', 'ssssssssbbbbssss', 'sssssssbwwwbbsss', 'ssssssbwwwwwwbss', 'sssssbwwwsbwwbss', 'ssssbwwwbbbbwwbs', 'sssbwwwbbbbbbbbs', 'ssbwwbbbbbbbbbbs', 'sbwbbbbbbbbbbbbb', 'bbbbbbbbbbbbbbbb', 'bbnbbnbbbbnbbbbb', 'bbbbbbbbnbbbbbbb', 'bnbbbbbbbbbnbbbb', 'bbbbbbbbbbbbbbnb', 'bbbbnbbbbnbbbbbb', 'bbbbbbbbbbbbbbbb']), { pal: { s: 'sand', b: 'navy', w: 'white', n: 'tan' in {} ? 'sand' : 'sand' }, map: { s: 's', b: 'b', w: 'w', n: 'n' } }),\n  starrybus: P('p-bus', 'The Starry Bus Stop', R(['nnnnynnnnnnynnnn', 'nynnnnnnynnnnnyn', 'nnnnnnynnnnnnnnn', 'nnyyynnnnnyyynnn', 'nnnnnnnnnnnnnnnn', 'nnnnnnnnnnnnnnnn', 'nnbbbbbbbbbbbbnn', 'nnbyybyybyybbbnn', 'nnbbbbbbbbbbbbnn', 'nnbbbbbbbbbbbbnn', 'nnkkkkkkkkkkkknn', 'nnnkknnnnnknnnnn', 'gggggggggggggggg', 'gggggggggggggggg', 'gggggggggggggggg', 'gggggggggggggggg']), { pal: { n: 'navy', y: 'sand', b: 'red', k: 'ink', g: 'green' }, map: { n: 'n', y: 'y', b: 'b', k: 'k', g: 'g' } }),\n  venusflytrap: P('p-venus', 'The Birth of Venus Flytrap', R(['cccccccccccccccc', 'cccccccccccccccc', 'ccccccpppccccccc', 'cccccppggppccccc', 'cccccpgwwgpccccc', 'ccccccpggpcccccc', 'cccccccppccccccc', 'ccccccccgcccccccc'.slice(0, 16), 'ccccccccgcccccccc'.slice(0, 16), 'cccccccgggccccccc'.slice(0, 16), 'wwwwwwwwwwwwwwww', 'cwwcwwcwwcwwcwwc', 'wwwwwwwwwwwwwwww', 'cwwcwwcwwcwwcwwc', 'wwwwwwwwwwwwwwww', 'wwwwwwwwwwwwwwww']), { pal: { c: 'sky', p: 'plum', g: 'green', w: 'white' }, map: { c: 'c', p: 'p', g: 'g', w: 'w' } }),\n  thehonk: P('p-honk', 'The Honk', R(['oooooooooooooooo', 'ooooyyyyooooyyyo', 'ooooooooooooooyy', 'oooooowwwwoooooo', 'ooooowwwwwwooooo', 'oooowkwwwwkwoooo', 'ooooowwwwwwooooo', 'oooooooyyyooooooo'.slice(0, 16), 'oooooooyyyoooooo', 'oooooowwwwoooooo', 'rrrrrwwwwwwrrrrr', 'rrrrwwwwwwwwrrrr', 'rrrwwwwwwwwwwrrr', 'rrrrrrrrrrrrrrrr', 'bbbbbbbbbbbbbbbb', 'bbbbbbbbbbbbbbbb']), { pal: { o: 'orange', y: 'sand', w: 'white', k: 'ink', r: 'red', b: 'navy' }, map: { o: 'o', y: 'y', w: 'w', k: 'k', r: 'r', b: 'b' } }),\n  whistlersmoose: P('p-moose', \"Whistler's Moose\", R(['gggggggggggggggg', 'gggkgggggggkgggg', 'ggkkgggggggkkggg', 'gggkgggggggkgggg', 'gggkkkkkkkkkgggg', 'ggggkkskkskkgggg', 'ggggkkkkkkkkgggg', 'gggggkkkkkkggggg', 'ggggggkkkkgggggg', 'ggkkkkkkkkkkkkgg', 'ggkggkkkkkkggkgg', 'ggkggkkkkkkggkgg', 'ggkggkkkkkkggkgg', 'ggkkkkkkkkkkkkgg', 'wwwwwwwwwwwwwwww', 'wwwwwwwwwwwwwwww']), { pal: { g: 'mist', k: 'slate', s: 'white', w: 'sand' }, map: { g: 'g', k: 'k', s: 's', w: 'w' } }),\n  cheeseearthly: P('p-cheese', 'The Cheese of Earthly Delights', R(['llllllllllllllll', 'lyyylllllllyyyll', 'lyoyllllllyyoyll', 'lyyyllyyyllyyyll', 'llllllyoyllllrrl', 'lllllllyyllllrrl', 'llggllllllggllll', 'llgyllllllgyllll', 'llllllyyyyllllll', 'lllllyoooyllllll', 'lllllyyyyyllllll', 'llrrllllllllgglll'.slice(0, 16), 'llrrllllllllgglll'.slice(0, 16), 'llllllllllllllll', 'llllllllllllllll', 'llllllllllllllll']), { pal: { l: 'lime', y: 'sand', o: 'orange', g: 'green', r: 'red' }, map: { l: 'l', y: 'y', o: 'o', g: 'g', r: 'r' } }),\n};\nlet reg = false;\nexport function registerPaintings() { if (reg) return; reg = true; for (const d of Object.values(PAINT_DEFS)) TEXTURE_LIBRARY.add(d); }\nexport function buildPainting(id, forged = false) {\n  registerPaintings(); const g = new Group(); part(g, 'box', [0.8, 0.8, 0.07], [0, 0, 0], 'sand'); const m = new THREE.Mesh(new THREE.BoxGeometry(0.66, 0.66, 0.04), toonMaterial(PALETTE.white, { map: textureMap('p-' + ({ monallama: 'monallama', goosepearl: 'goose', greatwave: 'wave', starrybus: 'bus', venusflytrap: 'venus', thehonk: 'honk', whistlersmoose: 'moose', cheeseearthly: 'cheese' })[id]) })); m.position.z = 0.04; g.add(m);\n  if (forged) part(g, 'box', [0.08, 0.08, 0.05], [0.25, -0.25, 0.07], 'red'); return g;\n}\nE\npython3 - <<'E'\ns=open('src/art/items3d.js').read()\ns=s.replace(\"n: 'tan' in {} ? 'sand' : 'sand'\",\"n: 'orange'\")\nopen('src/art/items3d.js','w').write(s)\nE\nnode -e 'import(\"./src/art/items3d.js\").then(async m=>{const e=await import(\"./src/pixel-engine.js\"); for(const [k,d] of Object.entries(m.PAINT_DEFS)){const r=e.validateTexture(d); if(r.problems.length) console.log(k,r.problems)} console.log(\"ok\")})' 2>&1 | tail -8"}}}
