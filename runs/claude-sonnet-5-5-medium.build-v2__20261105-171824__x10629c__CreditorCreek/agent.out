 { Head: R(-6, 4, 0), ...arms(R(-45, 0, 15), R(-10, 0, -8)) }], [18, { Head: R(4, -4, 0), ...arms(R(-25, 0, 10), R(-35, 0, -12)) }], [30, { Head: R(0), ...arms(R(-30, 0, 10), R(5, 0, -5)) }]]),\n  loopClip('Listen', 60, [[0, { Head: R(0, 0, 6), ...arms(R(5, 0, 5), R(5, 0, -5)) }], [30, { Head: R(3, 0, 8), Torso: R(2), ...arms(R(5, 0, 5), R(5, 0, -5)) }], [60, { Head: R(0, 0, 6), ...arms(R(5, 0, 5), R(5, 0, -5)) }]]),\n  once('Nod', 14, [[0, { Head: R(0) }], [5, { Head: R(18) }], [10, { Head: R(-4) }], [14, { Head: R(0) }]]),\n  once('ShakeHead', 18, [[0, { Head: R(0) }], [4, { Head: R(0, 25, 0) }], [9, { Head: R(0, -25, 0) }], [14, { Head: R(0, 15, 0) }], [18, { Head: R(0) }]]),\n  loopClip('Laugh', 12, [[0, { Pelvis: bob(0), Head: R(-14), Torso: R(-8), ...arms(R(-20, 0, 25), R(-20, 0, -25)) }], [6, { Pelvis: bob(0.05), Head: R(-8), Torso: R(-3), ...arms(R(-30, 0, 30), R(-30, 0, -30)) }], [12, { Pelvis: bob(0), Head: R(-14), Torso: R(-8), ...arms(R(-20, 0, 25), R(-20, 0, -25)) }]]),\n  loopClip('Cry', 20, [[0, { Head: R(18), Torso: R(8), ...arms(R(-130, 0, 20), R(-130, 0, -20)) }], [10, { Head: R(24, 0, 4), Torso: R(10), ...arms(R(-135, 0, 20), R(-135, 0, -20)) }], [20, { Head: R(18), Torso: R(8), ...arms(R(-130, 0, 20), R(-130, 0, -20)) }]]),\n  once('Shock', 20, [[0, IDLE], [3, { Pelvis: bob(0.12), Head: R(-12), Torso: R(-10), ...arms(R(-60, 0, 50), R(-60, 0, -50)) }], [20, { Pelvis: bob(0.02), Head: R(-6), ...arms(R(-50, 0, 40), R(-50, 0, -40)) }]]),\n  loopClip('Anger', 10, [[0, { Head: R(10), Torso: R(8), ...arms(R(-50, 0, 10), R(-50, 0, -10)) }], [5, { Head: R(10, 0, 0), Torso: R(8, 0, 0), Pelvis: bob(0.03), ...arms(R(-60, 0, 5), R(-60, 0, -5)) }], [10, { Head: R(10), Torso: R(8), ...arms(R(-50, 0, 10), R(-50, 0, -10)) }]]),\n  loopClip('Love', 40, [[0, { Head: R(0, 0, 10), ...arms(R(-100, 0, 40), R(-100, 0, -40)) }], [20, { Pelvis: bob(0.04), Head: R(0, 0, -10), ...arms(R(-100, 0, 40), R(-100, 0, -40)) }], [40, { Head: R(0, 0, 10), ...arms(R(-100, 0, 40), R(-