{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgkibbbbCBn94Lw1UB7Zq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NetBnVX8aw2h8R1AbWFhzY","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-171824__x10629c/work/CreditorCreek-AnimalCrossingCityFolk-claude-sonnet-5-5-medium-20261105-171824/src; \ncat > data/collect.js <<'E'\n// Fish, bugs, fossils, art: plain data. Seasons: 0 Spring 1 Summer 2 Autumn 3 Winter. Times: any day night dusk dawn late.\nconst ALL = [0, 1, 2, 3];\nconst S = (s) => s === 'all' ? ALL : s.split('').map(Number);\nconst F = (id, name, price, where, seasons, time, line, extra = {}) => ({ id, name, price, where, seasons: S(seasons), time, line, kind: 'fish', ...extra });\nexport const FISH = [\n  F('minnow', 'Minnow', 60, 'river', '012', 'any', \"That's... that's all of it.\", { size: 0 }),\n  F('perch', 'Perch', 150, 'river', 'all', 'day', 'It was just sitting there. On purpose.', { size: 1 }),\n  F('crawfish', 'Crawfish', 200, 'pond', '01', 'any', 'It has opinions about your thumbs.', { size: 0 }),\n  F('carp', 'Carp', 300, 'pond', 'all', 'any', 'Carp diem! ...Sorry. It made me say that.', { size: 1 }),\n  F('trout', 'Trout', 400, 'river', '02', 'any', \"It isn't pouting. That's just its face.\", { size: 1 }),\n  F('catfish', 'Catfish', 800, 'pond', '12', 'night', 'It claims to be a different catfish online.', { size: 2 }),\n  F('pike', 'Pike', 900, 'river', '23', 'any', 'Someone should tell it about the other end of the hook.', { size: 2 }),\n  F('eel', 'Eel', 1200, 'river', '12', 'dusk', 'Slippery. Also, it knows what you did.', { size: 2 }),\n  F('salmon', 'Salmon', 1500, 'mouth', '2', 'any', 'It came all this way and now look.', { size: 2 }),\n  F('goldencarp', 'Golden Carp', 5000, 'pond', '0', 'dawn', 'It looks expensive and it knows.', { size: 2, rare: true }),\n  F('sturgeon', 'Sturgeon', 6000, 'mouth', '3', 'any', 'Older than the Mayor. Slightly faster.', { size: 3, rare: true }),\n  F('sardine', 'Sardine', 100, 'sea', 'all', 'any', 'Comes with its own sense of confinement.', { size: 0 }),\n  F('mackerel', 'Mackerel', 250, 'sea', '12', 'any', 'Holy it.', { size: 1 }),\n  F('seabream', 'Sea Bream', 500, 'sea', '01', 'any', 'Very calm. Suspiciously calm.', { size: 1 }),\n  F('flounder', 'Flounder', 700, 'sea', 'all', 'any', 'Both eyes on you. Literally.', { size: 2 }),\n  F('pufferfish', 'Pufferfish', 1800, 'sea', '1', 'dusk', \"It's taking this very personally.\", { size: 1 }),\n  F('moonfish', 'Moonfish', 4000, 'sea', '12', 'late', \"It's bigger than your whole debt. Almost.\", { size: 3, rare: true }),\n  F('boot', 'Old Boot', 10, 'any', 'all', 'any', 'Somewhere, a fish is walking funny.', { size: 1, junk: true }),\n];\nconst B = (id, name, price, where, seasons, time, line, extra = {}) => ({ id, name, price, where, seasons: S(seasons), time, line, kind: 'bug', ...extra });\nexport const BUGS = [\n  B('cabbagebutterfly', 'Cabbage Butterfly', 90, 'flower', '01', 'day', \"It's very sorry about the cabbage.\", { fly: true }),\n  B('pillbug', 'Pill Bug', 100, 'rock', 'all', 'any', 'It has rolled up and refused to comment.'),\n  B('ladybird', 'Ladybird', 120, 'flower', '0', 'day', 'It came for the aphids and stayed for the drama.'),\n  B('pondskater', 'Pond Skater', 130, 'water', '1', 'day', 'Technically walking on water. Not technically impressed.'),\n  B('cricket', 'Cricket', 130, 'grass', '2', 'night', 'It was just getting to the good part.'),\n  B('moth', 'Moth', 150, 'lamp', 'all', 'night', 'It has found the lamp. It has found its purpose.', { fly: true }),\n  B('grasshopper', 'Grasshopper', 160, 'grass', '12', 'day', \"It didn't save anything for winter either.\"),\n  B('dragonfly', 'Dragonfly', 180, 'water', '12', 'day', 'Four wings and still somehow caught.', { fly: true }),\n  B('bumblebee', 'Bumblebee', 200, 'flower', '01', 'day', \"It's too busy for this, and it says so.\", { fly: true }),\n  B('snail', 'Snail', 200, 'rock', '01', 'rain', 'Not the Mayor. Probably.'),\n  B('cicada', 'Cicada', 250, 'tree', '1', 'day', 'Seventeen years underground for this.'),\n  B('swallowtail', 'Swallowtail', 300, 'flower', '1', 'day', 'Fancy. It wants you to know that.', { fly: true }),\n  B('firefly', 'Firefly', 300, 'water', '1', 'night', \"Dimmer up close. Aren't we all.\", { fly: true }),\n  B('woollybear', 'Woolly Bear', 350, 'tree', '2', 'day', 'Yolanda wants to know where it got that sweater.'),\n  B('mantis', 'Praying Mantis', 400, 'flower', '12', 'day', \"It isn't praying. It's negotiating.\"),\n  B('snowflea', 'Snow Flea', 600, 'snow', '3', 'day', 'Technically a bug. Emotionally, a snowflake.'),\n  B('stagbeetle', 'Stag Beetle', 2000, 'tree', '1', 'night', 'It has been waiting for someone to try that.', { rare: true }),\n  B('rhinobeetle', 'Rhino Beetle', 2500, 'tree', '1', 'late', \"You're not sure who caught whom.\", { rare: true }),\n];\nexport const FOSSILS = [\n  { id: 'trilobite', name: 'Trilobite', price: 1100, kind: 'fossil', line: 'A tiny armoured commuter.' },\n  { id: 'ammonite', name: 'Ammonite', price: 1200, kind: 'fossil', line: 'A shell that spiralled out of control.' },\n  { id: 'amberfly', name: 'Amber Fly', price: 1500, kind: 'fossil', line: 'Stuck forever in a very bad Tuesday.' },\n  { id: 'mysterytooth', name: 'Mystery Tooth', price: 900, kind: 'fossil', line: 'Whose is it? Nobody is volunteering.' },\n  { id: 'moa_skull', name: 'Moatosaur Skull', price: 2000, kind: 'fossil', set: 'moatosaur', line: 'It is mostly cheekbone.' },\n  { id: 'moa_torso', name: 'Moatosaur Torso', price: 2200, kind: 'fossil', set: 'moatosaur', line: 'A lot of ribs, none of them lending.' },\n  { id: 'moa_tail', name: 'Moatosaur Tail', price: 2000, kind: 'fossil', set: 'moatosaur', line: 'It had a lot to say, and said it behind.' },\n  { id: 'reg_skull', name: 'Regretodon Skull', price: 2400, kind: 'fossil', set: 'regretodon', line: 'It regrets everything, including this.' },\n  { id: 'reg_neck', name: 'Regretodon Neck', price: 2600, kind: 'fossil', set: 'regretodon', line: 'Long. Very long. Still no excuse.' },\n  { id: 'reg_torso', name: 'Regretodon Torso', price: 2300, kind: 'fossil', set: 'regretodon', line: 'Hollow in all the wrong places.' },\n];\nexport const ART = [\n  { id: 'monallama', name: 'Mona Llama', price: 4000, kind: 'art', line: 'She smiles. She knows about the spit.' },\n  { id: 'goosepearl', name: 'Goose with a Pearl Earring', price: 5000, kind: 'art', line: 'The pearl is the only thing not judging you.' },\n  { id: 'greatwave', name: 'The Great Wave Off Beans', price: 4500, kind: 'art', line: 'A tidal wave of legumes. Terrifying.' },\n  { id: 'starrybus', name: 'The Starry Bus Stop', price: 4800, kind: 'art', line: 'Swirling sky, delayed bus.' },\n  { id: 'venusflytrap', name: 'The Birth of Venus Flytrap', price: 4200, kind: 'art', line: 'A shell, a plant, a regrettable lunch.' },\n  { id: 'thehonk', name: 'The Honk', price: 3800, kind: 'art', line: 'A scream, but it is a goose, so: normal.' },\n  { id: 'whistlersmoose', name: \"Whistler's Moose\", price: 3600, kind: 'art', line: 'A moose in a chair. He would prefer not.' },\n  { id: 'cheeseearthly', name: 'The Cheese of Earthly Delights', price: 6000, kind: 'art', line: 'Nobody can look at it for long. Nobody wants to.' },\n];\nexport const PUNS = {\n  fish: FISH, bug: BUGS,\n};\nexport const ALL_COLLECT = [...FISH.filter(f => !f.junk), ...BUGS, ...FOSSILS, ...ART];\nexport const byId = {};\nfor (const x of [...FISH, ...BUGS, ...FOSSILS, ...ART]) byId[x.id] = x;\nexport function timeOk(time, hour, wet) {\n  switch (time) {\n    case 'any': return true;\n    case 'day': return hour >= 6 && hour < 18;\n    case 'night': return hour >= 19 || hour < 4;\n    case 'dusk': return hour >= 17 || hour < 4;\n    case 'dawn': return hour >= 4 && hour < 8;\n    case 'late': return hour >= 22 || hour < 4;\n    case 'rain': return !!wet;\n  }\n  return true;\n}\nE\ncat > data/items.js <<'E'\n// Shop and home items. Furniture maps onto kenney-furniture models where possible.\nimport { FISH, BUGS, FOSSILS, ART, byId } from './collect.js';\nexport const TOOLS = [\n  { id: 'net', name: 'Net', icon: 'net' }, { id: 'rod', name: 'Rod', icon: 'rod' }, { id: 'shovel', name: 'Shovel', icon: 'shovel' },\n  { id: 'axe', name: 'Axe', icon: 'axe' }, { id: 'can', name: 'Watering Can', icon: 'can' }, { id: 'sling', name: 'Slingshot', icon: 'sling' },\n];\nconst FU = (id, name, price, set, model, w = 1, d = 1, extra = {}) => ({ id, name, price, kind: 'furniture', set, model, w, d, ...extra });\nexport const FURNITURE = [\n  FU('cot', 'Cottage Cot', 900, 'Cottage', 'bedSingle', 1, 2, { fn: 'bed' }),\n  FU('cotchair', 'Cottage Chair', 400, 'Cottage', 'chair', 1, 1, { fn: 'seat' }),\n  FU('cottable', 'Cottage Table', 700, 'Cottage', 'table', 2, 1, {}),\n  FU('cotlamp', 'Cottage Lamp', 350, 'Cottage', 'lampRoundFloor', 1, 1, { fn: 'lamp' }),\n  FU('cotbook', 'Cottage Bookcase', 800, 'Cottage', 'bookcaseClosed', 2, 1, {}),\n  FU('mosscouch', 'Mossy Couch', 1500, 'Mossy', 'loungeSofa', 2, 1, { fn: 'seat' }),\n  FU('mossplant', 'Mossy Fern', 300, 'Mossy', 'pottedPlant', 1, 1, { grows: true }),\n  FU('mossrug', 'Mossy Rug', 500, 'Mossy', 'rugRound', 2, 2, { rug: true }),\n  FU('mosslamp', 'Mossy Lamp', 450, 'Mossy', 'lampSquareFloor', 1, 1, { fn: 'lamp' }),\n  FU('mosstable', 'Mossy Table', 900, 'Mossy', 'tableRound', 2, 2, {}),\n  FU('seabed', 'Seaside Bed', 1800, 'Seaside', 'bedDouble', 2, 2, { fn: 'bed' }),\n  FU('seachair', 'Seaside Chair', 650, 'Seaside', 'chairCushion', 1, 1, { fn: 'seat' }),\n  FU('seastereo', 'Seaside Stereo', 1200, 'Seaside', 'speaker', 1, 1, { fn: 'stereo' }),\n  FU('seatv', 'Seaside TV', 2200, 'Seaside', 'televisionModern', 1, 1, { fn: 'tv' }),\n  FU('seadesk', 'Seaside Desk', 1100, 'Seaside', 'desk', 2, 1, {}),\n  FU('loftsofa', 'Loft Sofa', 2600, 'City Loft', 'loungeDesignSofa', 2, 1, { fn: 'seat' }),\n  FU('loftlamp', 'Loft Lamp', 800, 'City Loft', 'lampSquareTable', 1, 1, { fn: 'lamp' }),\n  FU('loftmirror', 'Loft Mirror', 1500, 'City Loft', 'bathroomMirror', 1, 1, { fn: 'mirror' }),\n  FU('loftcoffee', 'Loft Coffee Table', 1200, 'City Loft', 'tableCoffeeGlass', 2, 1, {}),\n  FU('loftshelf', 'Loft Shelf', 1600, 'City Loft', 'bookcaseOpen', 2, 1, {}),\n  FU('burdesk', 'Bureau Desk', 1900, 'Bureau', 'desk', 2, 1, {}),\n  FU('burchair', 'Bureau Chair', 900, 'Bureau', 'chairDesk', 1, 1, { fn: 'seat' }),\n  FU('burcabinet', 'Bureau Cabinet', 1400, 'Bureau', 'cabinetTelevision', 2, 1, {}),\n  FU('burclock', 'Bureau Clock', 700, 'Bureau', 'books', 1, 1, { fn: 'clock' }),\n  FU('cheesechair', 'Cheese Chair', 3000, 'Cheese', 'chairCushion', 1, 1, { fn: 'seat', tint: 'sand' }),\n  FU('cheesetable', 'Cheese Table', 3500, 'Cheese', 'tableRound', 2, 2, { tint: 'sand' }),\n  FU('cheesebed', 'Cheese Bed', 5000, 'Cheese', 'bedDouble', 2, 2, { fn: 'bed', tint: 'sand' }),\n  FU('cheeselamp', 'Cheese Lamp', 1500, 'Cheese', 'lampRoundFloor', 1, 1, { fn: 'lamp', tint: 'sand' }),\n  FU('toilet', 'Toilet', 600, 'Single', 'toilet', 1, 1, { fn: 'toilet' }),\n  FU('fishtank', 'Fish Tank', 1300, 'Single', 'cabinetBedDrawer', 1, 1, { fn: 'tank' }),\n  FU('bugcage', 'Bug Cage', 900, 'Single', 'cabinetBed', 1, 1, { fn: 'cage' }),\n  FU('rugsq', 'Plain Rug', 300, 'Single', 'rugRectangle', 2, 2, { rug: true }),\n  FU('bench', 'Hall Bench', 500, 'Single', 'benchCushion', 2, 1, { fn: 'seat' }),\n  FU('radio', 'Radio', 500, 'Single', 'radio', 1, 1, { fn: 'stereo' }),\n  FU('plantbig', 'Big Plant', 450, 'Single', 'pottedPlant', 1, 1, { grows: true }),\n  FU('trophy_derby', 'Derby Trophy', 0, 'Trophy', 'books', 1, 1, { trophy: true }),\n  FU('trophy_bug', 'Bug-Off Trophy', 0, 'Trophy', 'books', 1, 1, { trophy: true }),\n  FU('trophy_snow', 'Snowman Trophy', 0, 'Trophy', 'books', 1, 1, { trophy: true }),\n];\nconst CL = (id, name, price, slot, color, extra = {}) => ({ id, name, price, kind: 'clothes', slot, color, ...extra });\nexport const CLOTHES = [\n  CL('tee_red', 'Red Tee', 300, 'outfit', 'red', { tags: ['plain', 'warm'] }), CL('tee_blue', 'Blue Tee', 300, 'outfit', 'blue', { tags: ['plain', 'cool'] }),\n  CL('tee_lime', 'Lime Tee', 300, 'outfit', 'lime', { tags: ['plain', 'bright'] }), CL('dress_plum', 'Plum Frock', 700, 'outfit', 'plum', { tags: ['fancy', 'dark'] }),\n  CL('coat_navy', 'Navy Coat', 900, 'outfit', 'navy', { tags: ['warm', 'fancy'] }), CL('rain_cyan', 'Damp Slicker', 600, 'outfit', 'cyan', { tags: ['damp', 'cool'] }),\n  CL('sweater_orange', 'Orange Sweater', 650, 'outfit', 'orange', { tags: ['warm', 'cozy'] }), CL('suit_slate', 'Slate Suit', 1500, 'outfit', 'slate', { tags: ['fancy', 'dark'] }),\n  CL('gown_white', 'Pale Gown', 2400, 'outfit', 'white', { tags: ['fancy', 'bright'], couture: true }), CL('cape_red', 'Couture Cape', 3200, 'outfit', 'red', { tags: ['fancy', 'bright'], couture: true }),\n  CL('hat_cap', 'Cap', 250, 'hat', 'blue', { tags: ['plain'] }), CL('hat_top', 'Top Hat', 900, 'hat', 'ink', { tags: ['fancy'] }),\n  CL('hat_straw', 'Straw Hat', 400, 'hat', 'sand', { tags: ['bright'] }), CL('hat_wool', 'Wool Hat', 450, 'hat', 'orange', { tags: ['warm', 'cozy'] }),\n  CL('hat_umbrella', 'Umbrella Hat', 800, 'hat', 'cyan', { tags: ['damp'] }), CL('hat_pot', 'Cooking Pot', 500, 'hat', 'slate', { tags: ['odd'] }),\n  CL('glasses_round', 'Round Specs', 350, 'glasses', 'ink', {}), CL('glasses_sun', 'Sun Shades', 450, 'glasses', 'night', {}), CL('glasses_gold', 'Gold Pince-nez', 1100, 'glasses', 'sand', {}),\n  CL('umb_red', 'Red Umbrella', 300, 'umbrella', 'red', {}), CL('umb_blue', 'Blue Umbrella', 300, 'umbrella', 'blue', {}), CL('umb_pattern', 'Pattern Umbrella', 600, 'umbrella', 'white', { pattern: true }),\n];\nexport const WALLPAPER = [\n  { id: 'wall_cream', name: 'Cream Wallpaper', price: 400, kind: 'wall', color: 'sand' }, { id: 'wall_mint', name: 'Mint Wallpaper', price: 450, kind: 'wall', color: 'lime' },\n  { id: 'wall_sky', name: 'Sky Wallpaper', price: 450, kind: 'wall', color: 'sky' }, { id: 'wall_plum', name: 'Plum Wallpaper', price: 600, kind: 'wall', color: 'plum' },\n];\nexport const FLOORS = [\n  { id: 'floor_wood', name: 'Wood Flooring', price: 400, kind: 'floor', color: 'orange' }, { id: 'floor_tile', name: 'Checker Tile', price: 500, kind: 'floor', color: 'mist' },\n  { id: 'floor_moss', name: 'Mossy Carpet', price: 500, kind: 'floor', color: 'green' }, { id: 'floor_slate', name: 'Slate Floor', price: 650, kind: 'floor', color: 'slate' },\n];\nexport const MISC = [\n  { id: 'pear', name: 'Pear', price: 100, kind: 'fruit', line: 'A pear. Round, sweet, grudge-free.' },\n  { id: 'fruit_cherry', name: 'Foreign Cherry', price: 500, kind: 'fruit', line: 'It claims to be from somewhere nicer.' },\n  { id: 'weed', name: 'Weed', price: 20, kind: 'weed', line: 'Technically a plant. Technically.' },\n  { id: 'beanbag', name: 'Bag of Beans', price: 1000, kind: 'beans', line: 'Heavy with legume.' },\n  { id: 'mushroom', name: 'Mushroom', price: 250, kind: 'mushroom', line: 'It knows something about the soil.' },\n  { id: 'shell', name: 'Shell', price: 150, kind: 'shell', line: 'A small ocean apartment, vacated.' },\n  { id: 'cheese', name: 'Cheese Wheel', price: 100, kind: 'cheese', line: 'A whole wheel. Brave.' },\n  { id: 'rotcheese', name: 'Rotten Cheese', price: 1, kind: 'cheese', line: 'It has a smell. A visible one.' },\n  { id: 'seedpack', name: 'Seed Packet', price: 80, kind: 'seed', line: 'Flowers, folded small.' },\n  { id: 'sapling', name: 'Sapling', price: 200, kind: 'sapling', line: 'A tree, optimistically.' },\n  { id: 'medicine', name: 'Wasp Ointment', price: 150, kind: 'medicine', line: 'Smells of mint and regret.' },\n  { id: 'paper', name: 'Stationery', price: 50, kind: 'paper', line: 'Paper. The future is blank.' },\n  { id: 'record', name: 'Vesper Record', price: 0, kind: 'record', line: 'A record, warm from an accordion.' },\n  { id: 'cheesewrap', name: 'Cheesewrap', price: 0, kind: 'junk', line: 'Wrapped. Unwrapped. Rewrapped.' },\n  { id: 'snowball', name: 'Snowball', price: 0, kind: 'junk', line: 'Cold, round, and optimistic.' },\n];\nexport const ITEMS = {};\nfor (const x of [...FISH, ...BUGS, ...FOSSILS, ...ART, ...FURNITURE, ...CLOTHES, ...WALLPAPER, ...FLOORS, ...MISC]) ITEMS[x.id] = x;\nfor (const t of TOOLS) ITEMS[t.id] = { ...t, kind: 'tool', price: 0 };\nexport const item = (id) => ITEMS[id] ?? { id, name: id, price: 0, kind: 'junk' };\nexport const STORE_STOCK_FURN = FURNITURE.filter(f => !f.trophy && f.set !== 'Cheese');\nE\necho done"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6138,"cache_read_input_tokens":140554,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6138},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f7fc0c99-6050-4a36-bbad-13de512b63e9","uuid":"92bc41bd-fdc1-4709-9323-b4f77b6e78c6","timestamp":"2026-11-06T00:21:42.041Z","request_id":"req_011CgkibbKiYBtp89GUqdmNB","wire_tool_inputs":{"toolu_01NetBnVX8aw2h8R1AbWFhzY":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-171824__x10629c/work/CreditorCreek-AnimalCrossingCityFolk-claude-sonnet-5-5-medium-20261105-171824/src; \ncat > data/collect.js <<'E'\n// Fish, bugs, fossils, art: plain data. Seasons: 0 Spring 1 Summer 2 Autumn 3 Winter. Times: any day night dusk dawn late.\nconst ALL = [0, 1, 2, 3];\nconst S = (s) => s === 'all' ? ALL : s.split('').map(Number);\nconst F = (id, name, price, where, seasons, time, line, extra = {}) => ({ id, name, price, where, seasons: S(seasons), time, line, kind: 'fish', ...extra });\nexport const FISH = [\n  F('minnow', 'Minnow', 60, 'river', '012', 'any', \"That's... that's all of it.\", { size: 0 }),\n  F('perch', 'Perch', 150, 'river', 'all', 'day', 'It was just sitting there. On purpose.', { size: 1 }),\n  F('crawfish', 'Crawfish', 200, 'pond', '01', 'any', 'It has opinions about your thumbs.', { size: 0 }),\n  F('carp', 'Carp', 300, 'pond', 'all', 'any', 'Carp diem! ...Sorry. It made me say that.', { size: 1 }),\n  F('trout', 'Trout', 400, 'river', '02', 'any', \"It isn't pouting. That's just its face.\", { size: 1 }),\n  F('catfish', 'Catfish', 800, 'pond', '12', 'night', 'It claims to be a different catfish online.', { size: 2 }),\n  F('pike', 'Pike', 900, 'river', '23', 'any', 'Someone should tell it about the other end of the hook.', { size: 2 }),\n  F('eel', 'Eel', 1200, 'river', '12', 'dusk', 'Slippery. Also, it knows what you did.', { size: 2 }),\n  F('salmon', 'Salmon', 1500, 'mouth', '2', 'any', 'It came all this way and now look.', { size: 2 }),\n  F('goldencarp', 'Golden Carp', 5000, 'pond', '0', 'dawn', 'It looks expensive and it knows.', { size: 2, rare: true }),\n  F('sturgeon', 'Sturgeon', 6000, 'mouth', '3', 'any', 'Older than the Mayor. Slightly faster.', { size: 3, rare: true }),\n  F('sardine', 'Sardine', 100, 'sea', 'all', 'any', 'Comes with its own sense of confinement.', { size: 0 }),\n  F('mackerel', 'Mackerel', 250, 'sea', '12', 'any', 'Holy it.', { size: 1 }),\n  F('seabream', 'Sea Bream', 500, 'sea', '01', 'any', 'Very calm. Suspiciously calm.', { size: 1 }),\n  F('flounder', 'Flounder', 700, 'sea', 'all', 'any', 'Both eyes on you. Literally.', { size: 2 }),\n  F('pufferfish', 'Pufferfish', 1800, 'sea', '1', 'dusk', \"It's taking this very personally.\", { size: 1 }),\n  F('moonfish', 'Moonfish', 4000, 'sea', '12', 'late', \"It's bigger than your whole debt. Almost.\", { size: 3, rare: true }),\n  F('boot', 'Old Boot', 10, 'any', 'all', 'any', 'Somewhere, a fish is walking funny.', { size: 1, junk: true }),\n];\nconst B = (id, name, price, where, seasons, time, line, extra = {}) => ({ id, name, price, where, seasons: S(seasons), time, line, kind: 'bug', ...extra });\nexport const BUGS = [\n  B('cabbagebutterfly', 'Cabbage Butterfly', 90, 'flower', '01', 'day', \"It's very sorry about the cabbage.\", { fly: true }),\n  B('pillbug', 'Pill Bug', 100, 'rock', 'all', 'any', 'It has rolled up and refused to comment.'),\n  B('ladybird', 'Ladybird', 120, 'flower', '0', 'day', 'It came for the aphids and stayed for the drama.'),\n  B('pondskater', 'Pond Skater', 130, 'water', '1', 'day', 'Technically walking on water. Not technically impressed.'),\n  B('cricket', 'Cricket', 130, 'grass', '2', 'night', 'It was just getting to the good part.'),\n  B('moth', 'Moth', 150, 'lamp', 'all', 'night', 'It has found the lamp. It has found its purpose.', { fly: true }),\n  B('grasshopper', 'Grasshopper', 160, 'grass', '12', 'day', \"It didn't save anything for winter either.\"),\n  B('dragonfly', 'Dragonfly', 180, 'water', '12', 'day', 'Four wings and still somehow caught.', { fly: true }),\n  B('bumblebee', 'Bumblebee', 200, 'flower', '01', 'day', \"It's too busy for this, and it says so.\", { fly: true }),\n  B('snail', 'Snail', 200, 'rock', '01', 'rain', 'Not the Mayor. Probably.'),\n  B('cicada', 'Cicada', 250, 'tree', '1', 'day', 'Seventeen years underground for this.'),\n  B('swallowtail', 'Swallowtail', 300, 'flower', '1', 'day', 'Fancy. It wants you to know that.', { fly: true }),\n  B('firefly', 'Firefly', 300, 'water', '1', 'night', \"Dimmer up close. Aren't we all.\", { fly: true }),\n  B('woollybear', 'Woolly Bear', 350, 'tree', '2', 'day', 'Yolanda wants to know where it got that sweater.'),\n  B('mantis', 'Praying Mantis', 400, 'flower', '12', 'day', \"It isn't praying. It's negotiating.\"),\n  B('snowflea', 'Snow Flea', 600, 'snow', '3', 'day', 'Technically a bug. Emotionally, a snowflake.'),\n  B('stagbeetle', 'Stag Beetle', 2000, 'tree', '1', 'night', 'It has been waiting for someone to try that.', { rare: true }),\n  B('rhinobeetle', 'Rhino Beetle', 2500, 'tree', '1', 'late', \"You're not sure who caught whom.\", { rare: true }),\n];\nexport const FOSSILS = [\n  { id: 'trilobite', name: 'Trilobite', price: 1100, kind: 'fossil', line: 'A tiny armoured commuter.' },\n  { id: 'ammonite', name: 'Ammonite', price: 1200, kind: 'fossil', line: 'A shell that spiralled out of control.' },\n  { id: 'amberfly', name: 'Amber Fly', price: 1500, kind: 'fossil', line: 'Stuck forever in a very bad Tuesday.' },\n  { id: 'mysterytooth', name: 'Mystery Tooth', price: 900, kind: 'fossil', line: 'Whose is it? Nobody is volunteering.' },\n  { id: 'moa_skull', name: 'Moatosaur Skull', price: 2000, kind: 'fossil', set: 'moatosaur', line: 'It is mostly cheekbone.' },\n  { id: 'moa_torso', name: 'Moatosaur Torso', price: 2200, kind: 'fossil', set: 'moatosaur', line: 'A lot of ribs, none of them lending.' },\n  { id: 'moa_tail', name: 'Moatosaur Tail', price: 2000, kind: 'fossil', set: 'moatosaur', line: 'It had a lot to say, and said it behind.' },\n  { id: 'reg_skull', name: 'Regretodon Skull', price: 2400, kind: 'fossil', set: 'regretodon', line: 'It regrets everything, including this.' },\n  { id: 'reg_neck', name: 'Regretodon Neck', price: 2600, kind: 'fossil', set: 'regretodon', line: 'Long. Very long. Still no excuse.' },\n  { id: 'reg_torso', name: 'Regretodon Torso', price: 2300, kind: 'fossil', set: 'regretodon', line: 'Hollow in all the wrong places.' },\n];\nexport const ART = [\n  { id: 'monallama', name: 'Mona Llama', price: 4000, kind: 'art', line: 'She smiles. She knows about the spit.' },\n  { id: 'goosepearl', name: 'Goose with a Pearl Earring', price: 5000, kind: 'art', line: 'The pearl is the only thing not judging you.' },\n  { id: 'greatwave', name: 'The Great Wave Off Beans', price: 4500, kind: 'art', line: 'A tidal wave of legumes. Terrifying.' },\n  { id: 'starrybus', name: 'The Starry Bus Stop', price: 4800, kind: 'art', line: 'Swirling sky, delayed bus.' },\n  { id: 'venusflytrap', name: 'The Birth of Venus Flytrap', price: 4200, kind: 'art', line: 'A shell, a plant, a regrettable lunch.' },\n  { id: 'thehonk', name: 'The Honk', price: 3800, kind: 'art', line: 'A scream, but it is a goose, so: normal.' },\n  { id: 'whistlersmoose', name: \"Whistler's Moose\", price: 3600, kind: 'art', line: 'A moose in a chair. He would prefer not.' },\n  { id: 'cheeseearthly', name: 'The Cheese of Earthly Delights', price: 6000, kind: 'art', line: 'Nobody can look at it for long. Nobody wants to.' },\n];\nexport const PUNS = {\n  fish: FISH, bug: BUGS,\n};\nexport const ALL_COLLECT = [...FISH.filter(f => !f.junk), ...BUGS, ...FOSSILS, ...ART];\nexport const byId = {};\nfor (const x of [...FISH, ...BUGS, ...FOSSILS, ...ART]) byId[x.id] = x;\nexport function timeOk(time, hour, wet) {\n  switch (time) {\n    case 'any': return true;\n    case 'day': return hour >= 6 && hour < 18;\n    case 'night': return hour >= 19 || hour < 4;\n    case 'dusk': return hour >= 17 || hour < 4;\n    case 'dawn': return hour >= 4 && hour < 8;\n    case 'late': return hour >= 22 || hour < 4;\n    case 'rain': return !!wet;\n  }\n  return true;\n}\nE\ncat > data/items.js <<'E'\n// Shop and home items. Furniture maps onto kenney-furniture models where possible.\nimport { FISH, BUGS, FOSSILS, ART, byId } from './collect.js';\nexport const TOOLS = [\n  { id: 'net', name: 'Net', icon: 'net' }, { id: 'rod', name: 'Rod', icon: 'rod' }, { id: 'shovel', name: 'Shovel', icon: 'shovel' },\n  { id: 'axe', name: 'Axe', icon: 'axe' }, { id: 'can', name: 'Watering Can', icon: 'can' }, { id: 'sling', name: 'Slingshot', icon: 'sling' },\n];\nconst FU = (id, name, price, set, model, w = 1, d = 1, extra = {}) => ({ id, name, price, kind: 'furniture', set, model, w, d, ...extra });\nexport const FURNITURE = [\n  FU('cot', 'Cottage Cot', 900, 'Cottage', 'bedSingle', 1, 2, { fn: 'bed' }),\n  FU('cotchair', 'Cottage Chair', 400, 'Cottage', 'chair', 1, 1, { fn: 'seat' }),\n  FU('cottable', 'Cottage Table', 700, 'Cottage', 'table', 2, 1, {}),\n  FU('cotlamp', 'Cottage Lamp', 350, 'Cottage', 'lampRoundFloor', 1, 1, { fn: 'lamp' }),\n  FU('cotbook', 'Cottage Bookcase', 800, 'Cottage', 'bookcaseClosed', 2, 1, {}),\n  FU('mosscouch', 'Mossy Couch', 1500, 'Mossy', 'loungeSofa', 2, 1, { fn: 'seat' }),\n  FU('mossplant', 'Mossy Fern', 300, 'Mossy', 'pottedPlant', 1, 1, { grows: true }),\n  FU('mossrug', 'Mossy Rug', 500, 'Mossy', 'rugRound', 2, 2, { rug: true }),\n  FU('mosslamp', 'Mossy Lamp', 450, 'Mossy', 'lampSquareFloor', 1, 1, { fn: 'lamp' }),\n  FU('mosstable', 'Mossy Table', 900, 'Mossy', 'tableRound', 2, 2, {}),\n  FU('seabed', 'Seaside Bed', 1800, 'Seaside', 'bedDouble', 2, 2, { fn: 'bed' }),\n  FU('seachair', 'Seaside Chair', 650, 'Seaside', 'chairCushion', 1, 1, { fn: 'seat' }),\n  FU('seastereo', 'Seaside Stereo', 1200, 'Seaside', 'speaker', 1, 1, { fn: 'stereo' }),\n  FU('seatv', 'Seaside TV', 2200, 'Seaside', 'televisionModern', 1, 1, { fn: 'tv' }),\n  FU('seadesk', 'Seaside Desk', 1100, 'Seaside', 'desk', 2, 1, {}),\n  FU('loftsofa', 'Loft Sofa', 2600, 'City Loft', 'loungeDesignSofa', 2, 1, { fn: 'seat' }),\n  FU('loftlamp', 'Loft Lamp', 800, 'City Loft', 'lampSquareTable', 1, 1, { fn: 'lamp' }),\n  FU('loftmirror', 'Loft Mirror', 1500, 'City Loft', 'bathroomMirror', 1, 1, { fn: 'mirror' }),\n  FU('loftcoffee', 'Loft Coffee Table', 1200, 'City Loft', 'tableCoffeeGlass', 2, 1, {}),\n  FU('loftshelf', 'Loft Shelf', 1600, 'City Loft', 'bookcaseOpen', 2, 1, {}),\n  FU('burdesk', 'Bureau Desk', 1900, 'Bureau', 'desk', 2, 1, {}),\n  FU('burchair', 'Bureau Chair', 900, 'Bureau', 'chairDesk', 1, 1, { fn: 'seat' }),\n  FU('burcabinet', 'Bureau Cabinet', 1400, 'Bureau', 'cabinetTelevision', 2, 1, {}),\n  FU('burclock', 'Bureau Clock', 700, 'Bureau', 'books', 1, 1, { fn: 'clock' }),\n  FU('cheesechair', 'Cheese Chair', 3000, 'Cheese', 'chairCushion', 1, 1, { fn: 'seat', tint: 'sand' }),\n  FU('cheesetable', 'Cheese Table', 3500, 'Cheese', 'tableRound', 2, 2, { tint: 'sand' }),\n  FU('cheesebed', 'Cheese Bed', 5000, 'Cheese', 'bedDouble', 2, 2, { fn: 'bed', tint: 'sand' }),\n  FU('cheeselamp', 'Cheese Lamp', 1500, 'Cheese', 'lampRoundFloor', 1, 1, { fn: 'lamp', tint: 'sand' }),\n  FU('toilet', 'Toilet', 600, 'Single', 'toilet', 1, 1, { fn: 'toilet' }),\n  FU('fishtank', 'Fish Tank', 1300, 'Single', 'cabinetBedDrawer', 1, 1, { fn: 'tank' }),\n  FU('bugcage', 'Bug Cage', 900, 'Single', 'cabinetBed', 1, 1, { fn: 'cage' }),\n  FU('rugsq', 'Plain Rug', 300, 'Single', 'rugRectangle', 2, 2, { rug: true }),\n  FU('bench', 'Hall Bench', 500, 'Single', 'benchCushion', 2, 1, { fn: 'seat' }),\n  FU('radio', 'Radio', 500, 'Single', 'radio', 1, 1, { fn: 'stereo' }),\n  FU('plantbig', 'Big Plant', 450, 'Single', 'pottedPlant', 1, 1, { grows: true }),\n  FU('trophy_derby', 'Derby Trophy', 0, 'Trophy', 'books', 1, 1, { trophy: true }),\n  FU('trophy_bug', 'Bug-Off Trophy', 0, 'Trophy', 'books', 1, 1, { trophy: true }),\n  FU('trophy_snow', 'Snowman Trophy', 0, 'Trophy', 'books', 1, 1, { trophy: true }),\n];\nconst CL = (id, name, price, slot, color, extra = {}) => ({ id, name, price, kind: 'clothes', slot, color, ...extra });\nexport const CLOTHES = [\n  CL('tee_red', 'Red Tee', 300, 'outfit', 'red', { tags: ['plain', 'warm'] }), CL('tee_blue', 'Blue Tee', 300, 'outfit', 'blue', { tags: ['plain', 'cool'] }),\n  CL('tee_lime', 'Lime Tee', 300, 'outfit', 'lime', { tags: ['plain', 'bright'] }), CL('dress_plum', 'Plum Frock', 700, 'outfit', 'plum', { tags: ['fancy', 'dark'] }),\n  CL('coat_navy', 'Navy Coat', 900, 'outfit', 'navy', { tags: ['warm', 'fancy'] }), CL('rain_cyan', 'Damp Slicker', 600, 'outfit', 'cyan', { tags: ['damp', 'cool'] }),\n  CL('sweater_orange', 'Orange Sweater', 650, 'outfit', 'orange', { tags: ['warm', 'cozy'] }), CL('suit_slate', 'Slate Suit', 1500, 'outfit', 'slate', { tags: ['fancy', 'dark'] }),\n  CL('gown_white', 'Pale Gown', 2400, 'outfit', 'white', { tags: ['fancy', 'bright'], couture: true }), CL('cape_red', 'Couture Cape', 3200, 'outfit', 'red', { tags: ['fancy', 'bright'], couture: true }),\n  CL('hat_cap', 'Cap', 250, 'hat', 'blue', { tags: ['plain'] }), CL('hat_top', 'Top Hat', 900, 'hat', 'ink', { tags: ['fancy'] }),\n  CL('hat_straw', 'Straw Hat', 400, 'hat', 'sand', { tags: ['bright'] }), CL('hat_wool', 'Wool Hat', 450, 'hat', 'orange', { tags: ['warm', 'cozy'] }),\n  CL('hat_umbrella', 'Umbrella Hat', 800, 'hat', 'cyan', { tags: ['damp'] }), CL('hat_pot', 'Cooking Pot', 500, 'hat', 'slate', { tags: ['odd'] }),\n  CL('glasses_round', 'Round Specs', 350, 'glasses', 'ink', {}), CL('glasses_sun', 'Sun Shades', 450, 'glasses', 'night', {}), CL('glasses_gold', 'Gold Pince-nez', 1100, 'glasses', 'sand', {}),\n  CL('umb_red', 'Red Umbrella', 300, 'umbrella', 'red', {}), CL('umb_blue', 'Blue Umbrella', 300, 'umbrella', 'blue', {}), CL('umb_pattern', 'Pattern Umbrella', 600, 'umbrella', 'white', { pattern: true }),\n];\nexport const WALLPAPER = [\n  { id: 'wall_cream', name: 'Cream Wallpaper', price: 400, kind: 'wall', color: 'sand' }, { id: 'wall_mint', name: 'Mint Wallpaper', price: 450, kind: 'wall', color: 'lime' },\n  { id: 'wall_sky', name: 'Sky Wallpaper', price: 450, kind: 'wall', color: 'sky' }, { id: 'wall_plum', name: 'Plum Wallpaper', price: 600, kind: 'wall', color: 'plum' },\n];\nexport const FLOORS = [\n  { id: 'floor_wood', name: 'Wood Flooring', price: 400, kind: 'floor', color: 'orange' }, { id: 'floor_tile', name: 'Checker Tile', price: 500, kind: 'floor', color: 'mist' },\n  { id: 'floor_moss', name: 'Mossy Carpet', price: 500, kind: 'floor', color: 'green' }, { id: 'floor_slate', name: 'Slate Floor', price: 650, kind: 'floor', color: 'slate' },\n];\nexport const MISC = [\n  { id: 'pear', name: 'Pear', price: 100, kind: 'fruit', line: 'A pear. Round, sweet, grudge-free.' },\n  { id: 'fruit_cherry', name: 'Foreign Cherry', price: 500, kind: 'fruit', line: 'It claims to be from somewhere nicer.' },\n  { id: 'weed', name: 'Weed', price: 20, kind: 'weed', line: 'Technically a plant. Technically.' },\n  { id: 'beanbag', name: 'Bag of Beans', price: 1000, kind: 'beans', line: 'Heavy with legume.' },\n  { id: 'mushroom', name: 'Mushroom', price: 250, kind: 'mushroom', line: 'It knows something about the soil.' },\n  { id: 'shell', name: 'Shell', price: 150, kind: 'shell', line: 'A small ocean apartment, vacated.' },\n  { id: 'cheese', name: 'Cheese Wheel', price: 100, kind: 'cheese', line: 'A whole wheel. Brave.' },\n  { id: 'rotcheese', name: 'Rotten Cheese', price: 1, kind: 'cheese', line: 'It has a smell. A visible one.' },\n  { id: 'seedpack', name: 'Seed Packet', price: 80, kind: 'seed', line: 'Flowers, folded small.' },\n  { id: 'sapling', name: 'Sapling', price: 200, kind: 'sapling', line: 'A tree, optimistically.' },\n  { id: 'medicine', name: 'Wasp Ointment', price: 150, kind: 'medicine', line: 'Smells of mint and regret.' },\n  { id: 'paper', name: 'Stationery', price: 50, kind: 'paper', line: 'Paper. The future is blank.' },\n  { id: 'record', name: 'Vesper Record', price: 0, kind: 'record', line: 'A record, warm from an accordion.' },\n  { id: 'cheesewrap', name: 'Cheesewrap', price: 0, kind: 'junk', line: 'Wrapped. Unwrapped. Rewrapped.' },\n  { id: 'snowball', name: 'Snowball', price: 0, kind: 'junk', line: 'Cold, round, and optimistic.' },\n];\nexport const ITEMS = {};\nfor (const x of [...FISH, ...BUGS, ...FOSSILS, ...ART, ...FURNITURE, ...CLOTHES, ...WALLPAPER, ...FLOORS, ...MISC]) ITEMS[x.id] = x;\nfor (const t of TOOLS) ITEMS[t.id] = { ...t, kind: 'tool', price: 0 };\nexport const item = (id) => ITEMS[id] ?? { id, name: id, price: 0, kind: 'junk' };\nexport const STORE_STOCK_FURN = FURNITURE.filter(f => !f.trophy && f.set !== 'Cheese');\nE\necho done"}}}
