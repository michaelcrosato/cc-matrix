2], at: [wx, p.h * 0.62 - 0.4, p.d / 2 + 0.1], c: 'sill', collide: false }); }\n    if (p.chim > 0.5) out.push({ box: [0.5, 1.3, 0.5], at: [p.w * 0.25, p.h + 1.4, 0], c: 'stone' });\n    return out;\n  },\n});\nE\npython3 - <<'E'\np='src/world/scenery.js'; s=open(p).read()\ns=s.replace(\"import { cheeseWheel, noticeBoard, parkBench, marketStall } from '../art/models.js';\",\"import { cheeseWheel, noticeBoard, parkBench, marketStall, house } from '../art/models.js';\")\ni=s.index(\"export function buildBuilding(b, o = {}) {\"); j=s.index(\"export function buildLighthouse\")\nnew=\"\"\"export function buildBuilding(b, o = {}) {\n  const g = new Group(); g.name = 'building:' + b.id; const w = b.w, d = b.d, h = o.h ?? 2.4; const windows = [];\n  const body = buildModel(house, { params: { w, d, h, pitch: o.pitch ?? 1.3, dx: b.noDoor ? -1 : b.door[0] - b.x + 0.5, chim: o.chimney === false ? 0 : 1 }, palette: { wall: o.wall ?? 'sand', roof: o.roof ?? 'red', door: o.door ?? 'plum', trim: o.ridge ?? 'ink' } }).object;\n  body.position.set(w / 2, 0, d / 2); body.traverse(m => { if (m.isMesh) { m.castShadow = true; m.receiveShadow = true; } }); g.add(body); g.userData.roof = [body];\n  const winC = new THREE.MeshBasicNodeMaterial({ color: PALETTE.sand }); const wn = Math.max(1, Math.floor(w / 2.5));\n  for (let i = 0; i < wn; i++) { const wx = (i + 0.5) * w / wn; if (!b.noDoor && Math.abs(wx - (b.door[0] - b.x + 0.5)) < 0.9) continue; part(g, 'box', [0.7, 0.7, 0.1], [wx, h * 0.62, d + 0.04], 'sky'); const glow = new Mesh(G.box, winC); glow.scale.set(0.5, 0.5, 0.1); glow.position.set(wx, h * 0.62, d + 0.07); glow.visible = false; g.add(glow); windows.push(glow); }\n  if (o.chimney !== false) g.userData.smoke = [w * 0.75, h + 2.2, d * 0.5];\n  g.userData.windows = windows; setLookLayer(g, 'environment'); return g;\n}\n\"\"\"\ns=s[:i]+new+s[j:]\nopen(p,'w').write(s)\n# Magda displays paintings + forgery\np='src/systems/venues2.js'; s=open(p).read()\ns=s.replace(\"      await g.say(m, `${p.name}. ${p.cost} beans.\",\"      { const { buildPainting } = await import('../art/items3d.js'); const room = (await import('../world/rooms.js')).ROOMS.magda; room.group.userData.shown?.forEach(o => room.group.remove(o)); const pm = buildPainting(p.id, p.forged); pm.position.set(5, 1.6, 0.4); pm.scale.setScalar(1.6); room.group.add(pm); room.group.userData.shown = [pm]; if (p.forged) { pm.children[1].rotation.z = 0.04; } }\\n      await g.say(m, `${p.name}. ${p.cost} beans.\")\nopen(p,'w').write(s)\nE\nnode kit/check.mjs --sheets src/art/models.js 2>&1 | grep -E \"OK|FAIL|problem\\(s\\), [1-9]|!\" | head; node tools/build.mjs | tail -1; node tests/run.mjs --only play","uuid":"b5d12c2d-9af3-449d-a787-e9e72aef89a2","session_id":"f7fc0c99-6050-4a36-bbad-13de512b63e9"}
