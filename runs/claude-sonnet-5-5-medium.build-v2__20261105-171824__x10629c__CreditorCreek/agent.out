'; s=open(p).read()\ns=s.replace(\"// settings, 10% music default\",\"\"\"// the whole village joins a festival\n{ const { festivalCrowd } = await import('../../src/systems/year.js'); g.npcs.reset(); g.npcs.schedule(true); w.min = 480; for (const n of g.npcs.list) n.sleeping = false; const end = festivalCrowd(g, 'seed'); T.ok(g.npcs.list.every(n => n.doing), 'every neighbour acts out the festival'); end(); T.ok(g.npcs.list.every(n => !n.doing), 'and goes back to routine afterwards'); }\n// settings, 10% music default\"\"\")\nopen(p,'w').write(s)\np='AUDIT.md'; s=open(p).read()\ns=s.replace(\"They remain compact set pieces (a few minutes each) rather than whole-village simulations.\",\"Every awake neighbour joins in (dancing, waving, eating, swaying with sparkles) for the length of each festival and returns to routine after.\")\ns=s.replace(\"Whole-village festival simulation (neighbours acting out each festival)\",\"Nothing further from the festival list\")\nopen(p,'w').write(s)\nE\nnode tools/build.mjs | tail -1; node tests/run.mjs --only play | tail -3","uuid":"8beaaca2-d503-4126-846b-f46a2cb02bca","session_id":"f7fc0c99-6050-4a36-bbad-13de512b63e9"}
