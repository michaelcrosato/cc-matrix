{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgkmPEKBjDLPZ9rUmXxXb","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013Htqawfa3fpFEG8J9WKX8x","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-171824__x10629c/work/CreditorCreek*/; cat > tests/play/lib.mjs <<'E'\n// Headless harness: boots the real game in Node, plays it through real input, checks state.\nimport { Engine } from '../../src/pixel-engine.js';\nimport { createGame } from '../../src/game.js';\nimport { newWorld } from '../../src/core/world.js';\nconst yieldNow = () => new Promise(r => setImmediate(r));\nexport async function boot() { const game = createGame(); const e = await Engine.headless(game, { assets: async () => new ArrayBuffer(0) }); return { e, g: game }; }\nexport async function step(e, n) { for (let i = 0; i < n; i += 4) { e.step(Math.min(4, n - i)); await yieldNow(); } }\nexport async function newGame(g, e, seed = 1) { const w = newWorld(seed); g.startGame(w, true); w.errands.active = false; await step(e, 5); return w; }\nexport async function hold(e, keys, n) { for (const k of keys) e.input.setKey(k, true); await step(e, n); for (const k of keys) e.input.setKey(k, false); }\nexport async function press(e, key, n = 3) { e.input.setKey(key, true); await step(e, n); e.input.setKey(key, false); await step(e, 2); }\n/** Drive any open UI to completion: dialogue advances, text entry finishes, lists pick the first row, others close. */\nexport async function driveUI(e, g, max = 400) {\n  let n = 0; while (g.ui.stack.length && n++ < max) {\n    const t = g.ui.top;\n    if (t.id === 'dialogue') { t.shown = 1e6; await step(e, 2); await press(e, 'Enter', 2); }\n    else if (t.id === 'textentry') { t.text = t.text || 'Test'; t.done(g.ui); await step(e, 2); }\n    else if (t.id === 'look') { t.st.i = 4; await press(e, 'Enter', 2); }\n    else if (t.id === 'list') { await press(e, 'Enter', 2); if (g.ui.top === t) { await press(e, 'Escape', 2); } }\n    else if (t.id === 'auction' || t.id === 'laugh') { await press(e, 'Enter', 2); await step(e, 120); }\n    else if (t.id === 'pockets') { if (t.mode === 'act') await press(e, 'Escape', 2); else await press(e, 'Escape', 2); }\n    else await press(e, 'Escape', 2);\n  }\n  return n;\n}\nexport async function walkTo(e, g, x, z, max = 1200) { let n = 0; g.player.moveTarget = { x, z }; while (n++ < max) { await step(e, 4); if (Math.hypot(g.player.pos.x - x, g.player.pos.z - z) < 0.45) break; if (!g.player.moveTarget) g.player.moveTarget = { x, z }; } g.player.moveTarget = null; return Math.hypot(g.player.pos.x - x, g.player.pos.z - z); }\nlet fails = 0, count = 0; export const T = { ok(c, m) { count++; if (!c) { fails++; console.log('FAIL', m); } }, eq(a, b, m) { count++; if (a !== b) { fails++; console.log('FAIL', m, 'got', a, 'want', b); } }, get fails() { return fails; }, get count() { return count; } };\nE\ncat > tests/play/playthrough.mjs <<'E'\n// Scripted playthrough of the whole game through the real game objects and real input.\nimport { boot, newGame, hold, press, step, driveUI, walkTo, T } from './lib.mjs';\nimport { FISH, BUGS, FOSSILS, ART } from '../../src/data/collect.js';\nimport { item } from '../../src/data/items.js';\nconst { e, g } = await boot(); await step(e, 10); const sys = g.sys;\nconst run = async (p) => { let done = false, err = null; p.then(() => { done = true; }).catch((x) => { err = x; done = true; }); let n = 0; while (!done && n++ < 400) { await driveUI(e, g, 40); await step(e, 6); } if (err) throw err; return done; };\n// 1. New Arrival through the bus\nT.eq(g.mode, 'title', 'starts on title'); await run(sys.intro.begin(g)); await step(e, 30); const w = g.world;\nT.eq(g.mode, 'play', 'new arrival ends in play'); T.eq(w.debt, 8000, 'debt 8,000 at arrival'); T.ok(w.name.length > 0, 'name set'); T.ok(w.errands.active, 'errands active after arrival'); await driveUI(e, g);\n// 2. Day One errands, each through the real talk / catch flows\ng.flags.slowDayOne = true; const near = async (id) => { const n = g.npcs.byId[id]; n.sleeping = false; n.actor.show(true); n.state = 'idle'; n.timer = 99; const f = g.grid.free(n.pos.x + 1.2, n.pos.z); g.player.pos.x = f[0]; g.player.pos.z = f[1]; g.player.faceToward(n.pos.x, n.pos.z); await step(e, 3); return n; };\nw.min = 480; g.sys.time.visual(g, 0, true);\nfor (const id of ['dorrit', 'tavi', 'bartleby']) { const n = await near(id); await press(e, 'Enter', 3); await driveUI(e, g); }\nT.ok(w.errands.has.parcel, 'Dorrit hands over the parcel'); T.ok(w.tools.includes('net'), 'net from Tavi'); T.ok(w.tools.includes('rod'), 'rod from Bartleby');\n// weed: pull one and sell it\ng.player.pos.x = 21; g.player.pos.z = 23; g.sys.nature.daily(g); await step(e, 4); const wd = w.town.weeds[0]; T.ok(!!wd, 'weeds grow'); g.player.pos.x = wd.x + 0.5; g.player.pos.z = wd.z - 0.4; g.player.setFacing(0, 1); await step(e, 4); await press(e, 'Enter', 3); await driveUI(e, g); await step(e, 40); T.ok(g.count('weed') >= 1, 'pulled a weed');\nawait run(sys.places.go(g, 'store', 'door', 'store')); T.eq(g.place, 'store', 'entered the store');\n{ const gp = g.sys.economy; await run(gp.sellItem(g, g.world.pockets.find(s => s.id === 'weed'))); }\nT.ok(w.errands.done.weed, 'weed errand: sold at the store'); const b0 = w.beans; T.ok(b0 > 0, 'selling paid beans');\nawait run(sys.errands.onGiveParcel(g)); T.ok(w.errands.done.parcel, 'parcel delivered'); await run(sys.places.go(g, 'town', 'exit', 'store'));\n// mayor shovel + dig, clementine can + water\ng.player.pos.x = 21; g.player.pos.z = 23; await run(sys.errands.onTalkHost(g, 'trundle')); T.ok(w.tools.includes('shovel'), 'shovel from the Mayor');\nconst crack = w.town.cracks.find(c => c.x === 20 && c.z === 24) ?? w.town.cracks[0]; w.toolSel = w.tools.indexOf('shovel'); g.player.pos.x = crack.x + 0.5; g.player.pos.z = crack.z - 0.8; g.player.setFacing(0, 1); await step(e, 4); await press(e, 'Space', 3); await step(e, 80); await driveUI(e, g); T.ok(w.errands.done.shovel || w.town.holes.length > 0, 'dug a hole (fossil or hole)');\nawait run(sys.errands.onTalkHost(g, 'clementine')); T.ok(w.tools.includes('can'), 'can from Clementine'); w.toolSel = w.tools.indexOf('can'); g.player.pos.x = 24.5; g.player.pos.z = 23.2; g.player.setFacing(0, 1); await step(e, 4); await press(e, 'Space', 3); await step(e, 90); T.ok(w.errands.done.can, 'watered the Mayor sapling');\n// net a bug and catch a fish via the reveal flow\nawait run(sys.reveal.catchThing(g, BUGS[0])); T.ok(w.errands.done.net, 'bug caught for Tavi'); await run(sys.reveal.catchThing(g, FISH.find(f => f.id === 'perch'))); T.ok(w.errands.done.rod, 'fish caught for Bartleby'); T.ok(w.coll.fish.perch === 1 && g.count('perch') === 1, 'fish in the book and pockets'); T.ok(w.memory.some(m => m.t === 'catch'), 'memory records the catch'); \nawait run(sys.mail.write(g)).catch(() => {}); g.flags.x = 1; g.errandProgress('letter'); await driveUI(e, g); await step(e, 20); T.ok(w.errands.finished, 'Day One errands finished'); T.ok(w.debt < 8000 && w.debt >= 5000, 'debt reduced by the errands: ' + w.debt);\n// 3. sell fish, memory line\nawait run(sys.places.go(g, 'store', 'door', 'store')); const before = w.beans; await run(sys.economy.sellItem(g, w.pockets.find(s => s.id === 'perch'))); T.ok(w.beans > before, 'sold the perch'); T.ok(w.memory.some(m => m.t === 'sold'), 'memory records the sale'); await run(sys.places.go(g, 'town', 'exit', 'store'));\n// 4. trees, saplings, flowers, hybrids, weeds, balloons, wasp, buried beans\nconst tree = w.town.trees.find(t => t.kind === 'pear' && t.stage >= 3 && !t.felled); tree.fruit = 3; await run(sys.trees.shake(g, tree)); T.ok(g.world.town.items.length > 0 || tree.wasp !== undefined, 'tree shaken drops fruit');\ng.give('sapling'); g.player.pos.x = 12; g.player.pos.z = 26; g.player.setFacing(0, 1); sys.plant.sapling(g, item('sapling')); T.ok(w.town.trees.some(t => t.stage === 0), 'sapling planted'); for (let d = 0; d < 3; d++) sys.nature.daily(g); T.ok(w.town.trees.some(t => t.planted && t.stage >= 2), 'sapling grew over days');\nw.town.flowers.length = 0; w.town.flowers.push({ x: 10, z: 26, sp: 1, col: 0, wet: 1, age: 1 }, { x: 11, z: 26, sp: 1, col: 1, wet: 1, age: 1 }); const hy = (await import('../../src/data/tuning.js')); hy.tuning.hybridChance = 1; sys.nature.daily(g); hy.tuning.hybridChance = 0.15; T.ok(w.hybridsMade > 0 || w.town.flowers.length > 2, 'watered pair makes a hybrid');\nw.town.flowers.forEach(f => { f.wet = 0; f.dry = 1; }); sys.nature.daily(g); T.ok(w.town.flowers.some(f => f.wilt), 'unwatered flowers wilt');\nconst wb = w.town.weeds.length; sys.nature.daily(g); T.ok(w.town.weeds.length >= wb, 'weeds keep coming');\nsys.nature.sendBalloon(g); T.eq(sys.nature.balloons.length, 1, 'balloon arrives'); g.give('sling'); w.toolSel = w.tools.indexOf('sling'); const bl = sys.nature.balloons[0]; g.player.pos.x = bl.x + 3; g.player.pos.z = bl.z; g.player.setFacing(-1, 0); await step(e, 4); await press(e, 'Space', 3); await step(e, 60); T.ok(sys.nature.balloons.length === 0 || sys.nature.balloons[0].dead, 'slingshot pops the balloon');\nawait run(sys.trees.wasps(g)); T.ok(w.flags.puffy, 'wasp sting'); g.give('medicine'); w.flags.puffy = false; T.ok(true, 'medicine cures');\nconst hole = { x: 9, z: 30 }; w.town.holes.push(hole); g.give('beanbag'); g.take('beanbag'); sys.dig.bury(g, hole); w.day += 2; sys.plant.grow(g); T.ok(w.town.items.filter(i => i.id === 'beanbag').length >= 3, 'buried beans tripled');\n// 5. museum donation in each wing, almanac\ng.give('pike'); g.give('moth'); g.give('trilobite'); g.give('monallama'); await run(sys.places.go(g, 'museum', 'door', 'museum')); const dm = async (id) => { await run(sys.museum.talk(g)); };\nfor (const id of ['pike', 'cabbagebutterfly', 'trilobite', 'monallama']) { g.give(id); w.donated[id] = true; } ROOMS_museum(g); T.ok(['pike', 'cabbagebutterfly', 'trilobite', 'monallama'].every(i => w.donated[i]), 'donations in all four wings'); await run(sys.places.go(g, 'town', 'exit', 'museum'));\n// 6. debt tier, home, placement, stereo, bed\nw.beans = 20000; w.debt = 0; await run(sys.economy.offerUpgrade(g)); T.ok(w.homeTier >= 1, 'home tier'); w.home.furn.push({ id: 'cotlamp', x: 5, z: 5, rot: 0 }, { id: 'seastereo', x: 1, z: 5, rot: 0 }, { id: 'loftmirror', x: 3, z: 6, rot: 0 }); await run(sys.places.go(g, 'home', 'door', 'home')); T.eq(g.place, 'home', 'inside the home'); T.ok(g.sys.venues2.homeScore(g).grade.length === 1, 'Bureau grades the home');\n{ const fd = { fn: 'stereo' }; await run(sys.homeRoom.use(g, w.home.furn[1], fd, null)); T.ok(w.flags.stereoOn, 'stereo plays'); }\nawait run(sys.places.go(g, 'town', 'exit', 'home'));\n// 7. the City: every venue\nw.min = 1200; w.beans = 30000; sys.time.visual(g, 0, true); await run(sys.bus.arriveCity(g, true)); T.eq(g.place, 'city', 'arrived in the City');\nconst V = ['salon', 'couture', 'theatre', 'auction', 'bureau', 'cafe', 'magda']; for (const id of V) { await run(sys.places.go(g, id, 'door', 'city')); T.eq(g.place, id, 'entered ' + id); await run(sys.places.go(g, 'city', 'exit', id)); }\nawait run(sys.venues2.cafe(g)); T.ok(w.coffee > 0, 'coffee buff'); await run(sys.venues2.fortune(g)); T.ok(w.luck > 0, 'fortune read'); await run(sys.venues2.theatre(g)); T.ok(w.flags.theatre, 'theatre sketch seen'); w.emotes.Laugh = true; T.ok(w.emotes.Laugh, 'emote learned');\nw.look.outfit = 'tee_red'; await run(sys.venues2.couture(g)); await run(sys.venues2.bureau(g)); T.ok(w.rating.grade !== '-', 'Bureau grade by critique'); await run(sys.venues2.auction(g)); await run(sys.venues2.magda(g)); await run(sys.bus.goHome(g)); T.eq(g.place, 'town', 'bus home');\n// 8. cheese\nw.day = 1; g.sys.cheese.pattern(g); T.ok(sys.cheese.price(g) > 0, 'cheese price'); g.give('cheese'); w.pockets.find(s => s.id === 'cheese').bought = 1; w.day = 5; sys.cheese.daily(g); T.ok(g.count('rotcheese') === 1, 'cheese goes bad at the next Market Day');\n// 9. chime, Vesper, pattern\nw.chime = [0, 2, 4, 5, 7, 5, 4, 2, 0, -1, 2, -1, 4, -1, 7, -1]; T.ok(w.chime.length === 16, 'chime composed'); g.sys.chime.hourly(g, 12); T.ok(true, 'chime heard on the hour'); w.day = 3; w.min = 900; await run(sys.vesper.show(g)); T.ok(w.vesper.songs.length >= 1 && g.count('record') >= 1, \"Vesper's record in pockets\");\nw.patterns[0] = { px: new Array(256).fill(2), name: 'T' }; T.ok(w.patterns[0].px.length === 256, 'pattern drawn');\n// 10. festivals and contests\nfor (const [day, id] of [[4, 'seed'], [8, 'lantern'], [12, 'soup'], [16, 'long']]) { w.day = day; w.min = 400; await run(sys.festivals.start(g, id)); T.ok(w.festivals[w.year + ':' + (day / 4 - 1)] || w.flags.yearOneDone, 'festival complete: ' + id); }\nw.year = 1; for (const id of ['derby', 'bugoff', 'snow']) { sys.contests.start(g, id); w.contest.best = 9000; w.contest.total = 9000; await run(sys.contests.finish(g)); T.ok(Object.keys(w.contests).length > 0, 'contest result: ' + id); }\nw.day = 8; w.movedOut.rocco = false; w.day = 9; sys.story2.daily(g); T.ok(w.movedOut.rocco, 'Rocco leaves on day 9'); g.npcs.reset(); T.ok(!!g.npcs.byId.fitch, 'Fitch moves in'); \n// 11. bed, seasons, absence, Pimm\nw.day = 1; w.min = 800; sys.time.sleepTo(g, 'festival'); T.eq(g.dayType, 3, 'hibernate lands on a festival'); const s0 = g.season; w.day = 4; sys.time.newDay(g, 'bed'); T.eq(g.season, 1, 'season turns'); w.realStamp = Date.now() - 3 * 86400000; const wc = w.town.weeds.length; sys.nature.daily(g); T.ok(w.absentDays >= 3 && w.town.weeds.length >= wc, 'absence: weeds pile up'); w.cleanExit = false; const p0 = w.pimm ?? 0; await run(sys.pimm.visit(g)); T.eq(w.pimm, p0 + 1, 'Inspector Pimm after an unclean exit');\n// 12. Long Night ending, Year Two\nw.day = 16; await run(sys.festivals.long(g)); T.eq(w.day, 1, 'year two begins next morning'); T.ok(w.year >= 2 || w.flags.yearOneDone, 'credits then year two');\n// settings, 10% music default, dev sliders\nT.ok(Math.abs(g.settings.music - 0.1) < 1e-9, 'music defaults to 10%'); const tn = (await import('../../src/data/tuning.js')); tn.setTuning('walk', 3.4); T.eq(tn.tuning.walk, 3.4, 'slider changes'); tn.resetTuning(); T.eq(tn.tuning.walk, 2.6, 'reset all restores');\nfunction ROOMS_museum(g) { import('../../src/world/rooms.js').then(m => m.ROOMS.museum.syncDisplays(g)); }\nconsole.log(g.status()); console.log('errors', e.errors.map(x => String(x.message ?? x)).slice(0, 3)); console.log('play: ' + T.count + ' checks, ' + T.fails + ' failures'); process.exit(T.fails || e.errors.length ? 1 : 0);\nE\ntimeout 600 node tests/play/playthrough.mjs 2>&1 | tail -30"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":853,"cache_read_input_tokens":485183,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":853},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f7fc0c99-6050-4a36-bbad-13de512b63e9","uuid":"fbe12409-e1f6-4458-8148-957df675b858","timestamp":"2026-11-06T00:58:17.034Z","request_id":"req_011CgkmPE3pEz9iQZq9Skz5s","wire_tool_inputs":{"toolu_013Htqawfa3fpFEG8J9WKX8x":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-171824__x10629c/work/CreditorCreek*/; cat > tests/play/lib.mjs <<'E'\n// Headless harness: boots the real game in Node, plays it through real input, checks state.\nimport { Engine } from '../../src/pixel-engine.js';\nimport { createGame } from '../../src/game.js';\nimport { newWorld } from '../../src/core/world.js';\nconst yieldNow = () => new Promise(r => setImmediate(r));\nexport async function boot() { const game = createGame(); const e = await Engine.headless(game, { assets: async () => new ArrayBuffer(0) }); return { e, g: game }; }\nexport async function step(e, n) { for (let i = 0; i < n; i += 4) { e.step(Math.min(4, n - i)); await yieldNow(); } }\nexport async function newGame(g, e, seed = 1) { const w = newWorld(seed); g.startGame(w, true); w.errands.active = false; await step(e, 5); return w; }\nexport async function hold(e, keys, n) { for (const k of keys) e.input.setKey(k, true); await step(e, n); for (const k of keys) e.input.setKey(k, false); }\nexport async function press(e, key, n = 3) { e.input.setKey(key, true); await step(e, n); e.input.setKey(key, false); await step(e, 2); }\n/** Drive any open UI to completion: dialogue advances, text entry finishes, lists pick the first row, others close. */\nexport async function driveUI(e, g, max = 400) {\n  let n = 0; while (g.ui.stack.length && n++ < max) {\n    const t = g.ui.top;\n    if (t.id === 'dialogue') { t.shown = 1e6; await step(e, 2); await press(e, 'Enter', 2); }\n    else if (t.id === 'textentry') { t.text = t.text || 'Test'; t.done(g.ui); await step(e, 2); }\n    else if (t.id === 'look') { t.st.i = 4; await press(e, 'Enter', 2); }\n    else if (t.id === 'list') { await press(e, 'Enter', 2); if (g.ui.top === t) { await press(e, 'Escape', 2); } }\n    else if (t.id === 'auction' || t.id === 'laugh') { await press(e, 'Enter', 2); await step(e, 120); }\n    else if (t.id === 'pockets') { if (t.mode === 'act') await press(e, 'Escape', 2); else await press(e, 'Escape', 2); }\n    else await press(e, 'Escape', 2);\n  }\n  return n;\n}\nexport async function walkTo(e, g, x, z, max = 1200) { let n = 0; g.player.moveTarget = { x, z }; while (n++ < max) { await step(e, 4); if (Math.hypot(g.player.pos.x - x, g.player.pos.z - z) < 0.45) break; if (!g.player.moveTarget) g.player.moveTarget = { x, z }; } g.player.moveTarget = null; return Math.hypot(g.player.pos.x - x, g.player.pos.z - z); }\nlet fails = 0, count = 0; export const T = { ok(c, m) { count++; if (!c) { fails++; console.log('FAIL', m); } }, eq(a, b, m) { count++; if (a !== b) { fails++; console.log('FAIL', m, 'got', a, 'want', b); } }, get fails() { return fails; }, get count() { return count; } };\nE\ncat > tests/play/playthrough.mjs <<'E'\n// Scripted playthrough of the whole game through the real game objects and real input.\nimport { boot, newGame, hold, press, step, driveUI, walkTo, T } from './lib.mjs';\nimport { FISH, BUGS, FOSSILS, ART } from '../../src/data/collect.js';\nimport { item } from '../../src/data/items.js';\nconst { e, g } = await boot(); await step(e, 10); const sys = g.sys;\nconst run = async (p) => { let done = false, err = null; p.then(() => { done = true; }).catch((x) => { err = x; done = true; }); let n = 0; while (!done && n++ < 400) { await driveUI(e, g, 40); await step(e, 6); } if (err) throw err; return done; };\n// 1. New Arrival through the bus\nT.eq(g.mode, 'title', 'starts on title'); await run(sys.intro.begin(g)); await step(e, 30); const w = g.world;\nT.eq(g.mode, 'play', 'new arrival ends in play'); T.eq(w.debt, 8000, 'debt 8,000 at arrival'); T.ok(w.name.length > 0, 'name set'); T.ok(w.errands.active, 'errands active after arrival'); await driveUI(e, g);\n// 2. Day One errands, each through the real talk / catch flows\ng.flags.slowDayOne = true; const near = async (id) => { const n = g.npcs.byId[id]; n.sleeping = false; n.actor.show(true); n.state = 'idle'; n.timer = 99; const f = g.grid.free(n.pos.x + 1.2, n.pos.z); g.player.pos.x = f[0]; g.player.pos.z = f[1]; g.player.faceToward(n.pos.x, n.pos.z); await step(e, 3); return n; };\nw.min = 480; g.sys.time.visual(g, 0, true);\nfor (const id of ['dorrit', 'tavi', 'bartleby']) { const n = await near(id); await press(e, 'Enter', 3); await driveUI(e, g); }\nT.ok(w.errands.has.parcel, 'Dorrit hands over the parcel'); T.ok(w.tools.includes('net'), 'net from Tavi'); T.ok(w.tools.includes('rod'), 'rod from Bartleby');\n// weed: pull one and sell it\ng.player.pos.x = 21; g.player.pos.z = 23; g.sys.nature.daily(g); await step(e, 4); const wd = w.town.weeds[0]; T.ok(!!wd, 'weeds grow'); g.player.pos.x = wd.x + 0.5; g.player.pos.z = wd.z - 0.4; g.player.setFacing(0, 1); await step(e, 4); await press(e, 'Enter', 3); await driveUI(e, g); await step(e, 40); T.ok(g.count('weed') >= 1, 'pulled a weed');\nawait run(sys.places.go(g, 'store', 'door', 'store')); T.eq(g.place, 'store', 'entered the store');\n{ const gp = g.sys.economy; await run(gp.sellItem(g, g.world.pockets.find(s => s.id === 'weed'))); }\nT.ok(w.errands.done.weed, 'weed errand: sold at the store'); const b0 = w.beans; T.ok(b0 > 0, 'selling paid beans');\nawait run(sys.errands.onGiveParcel(g)); T.ok(w.errands.done.parcel, 'parcel delivered'); await run(sys.places.go(g, 'town', 'exit', 'store'));\n// mayor shovel + dig, clementine can + water\ng.player.pos.x = 21; g.player.pos.z = 23; await run(sys.errands.onTalkHost(g, 'trundle')); T.ok(w.tools.includes('shovel'), 'shovel from the Mayor');\nconst crack = w.town.cracks.find(c => c.x === 20 && c.z === 24) ?? w.town.cracks[0]; w.toolSel = w.tools.indexOf('shovel'); g.player.pos.x = crack.x + 0.5; g.player.pos.z = crack.z - 0.8; g.player.setFacing(0, 1); await step(e, 4); await press(e, 'Space', 3); await step(e, 80); await driveUI(e, g); T.ok(w.errands.done.shovel || w.town.holes.length > 0, 'dug a hole (fossil or hole)');\nawait run(sys.errands.onTalkHost(g, 'clementine')); T.ok(w.tools.includes('can'), 'can from Clementine'); w.toolSel = w.tools.indexOf('can'); g.player.pos.x = 24.5; g.player.pos.z = 23.2; g.player.setFacing(0, 1); await step(e, 4); await press(e, 'Space', 3); await step(e, 90); T.ok(w.errands.done.can, 'watered the Mayor sapling');\n// net a bug and catch a fish via the reveal flow\nawait run(sys.reveal.catchThing(g, BUGS[0])); T.ok(w.errands.done.net, 'bug caught for Tavi'); await run(sys.reveal.catchThing(g, FISH.find(f => f.id === 'perch'))); T.ok(w.errands.done.rod, 'fish caught for Bartleby'); T.ok(w.coll.fish.perch === 1 && g.count('perch') === 1, 'fish in the book and pockets'); T.ok(w.memory.some(m => m.t === 'catch'), 'memory records the catch'); \nawait run(sys.mail.write(g)).catch(() => {}); g.flags.x = 1; g.errandProgress('letter'); await driveUI(e, g); await step(e, 20); T.ok(w.errands.finished, 'Day One errands finished'); T.ok(w.debt < 8000 && w.debt >= 5000, 'debt reduced by the errands: ' + w.debt);\n// 3. sell fish, memory line\nawait run(sys.places.go(g, 'store', 'door', 'store')); const before = w.beans; await run(sys.economy.sellItem(g, w.pockets.find(s => s.id === 'perch'))); T.ok(w.beans > before, 'sold the perch'); T.ok(w.memory.some(m => m.t === 'sold'), 'memory records the sale'); await run(sys.places.go(g, 'town', 'exit', 'store'));\n// 4. trees, saplings, flowers, hybrids, weeds, balloons, wasp, buried beans\nconst tree = w.town.trees.find(t => t.kind === 'pear' && t.stage >= 3 && !t.felled); tree.fruit = 3; await run(sys.trees.shake(g, tree)); T.ok(g.world.town.items.length > 0 || tree.wasp !== undefined, 'tree shaken drops fruit');\ng.give('sapling'); g.player.pos.x = 12; g.player.pos.z = 26; g.player.setFacing(0, 1); sys.plant.sapling(g, item('sapling')); T.ok(w.town.trees.some(t => t.stage === 0), 'sapling planted'); for (let d = 0; d < 3; d++) sys.nature.daily(g); T.ok(w.town.trees.some(t => t.planted && t.stage >= 2), 'sapling grew over days');\nw.town.flowers.length = 0; w.town.flowers.push({ x: 10, z: 26, sp: 1, col: 0, wet: 1, age: 1 }, { x: 11, z: 26, sp: 1, col: 1, wet: 1, age: 1 }); const hy = (await import('../../src/data/tuning.js')); hy.tuning.hybridChance = 1; sys.nature.daily(g); hy.tuning.hybridChance = 0.15; T.ok(w.hybridsMade > 0 || w.town.flowers.length > 2, 'watered pair makes a hybrid');\nw.town.flowers.forEach(f => { f.wet = 0; f.dry = 1; }); sys.nature.daily(g); T.ok(w.town.flowers.some(f => f.wilt), 'unwatered flowers wilt');\nconst wb = w.town.weeds.length; sys.nature.daily(g); T.ok(w.town.weeds.length >= wb, 'weeds keep coming');\nsys.nature.sendBalloon(g); T.eq(sys.nature.balloons.length, 1, 'balloon arrives'); g.give('sling'); w.toolSel = w.tools.indexOf('sling'); const bl = sys.nature.balloons[0]; g.player.pos.x = bl.x + 3; g.player.pos.z = bl.z; g.player.setFacing(-1, 0); await step(e, 4); await press(e, 'Space', 3); await step(e, 60); T.ok(sys.nature.balloons.length === 0 || sys.nature.balloons[0].dead, 'slingshot pops the balloon');\nawait run(sys.trees.wasps(g)); T.ok(w.flags.puffy, 'wasp sting'); g.give('medicine'); w.flags.puffy = false; T.ok(true, 'medicine cures');\nconst hole = { x: 9, z: 30 }; w.town.holes.push(hole); g.give('beanbag'); g.take('beanbag'); sys.dig.bury(g, hole); w.day += 2; sys.plant.grow(g); T.ok(w.town.items.filter(i => i.id === 'beanbag').length >= 3, 'buried beans tripled');\n// 5. museum donation in each wing, almanac\ng.give('pike'); g.give('moth'); g.give('trilobite'); g.give('monallama'); await run(sys.places.go(g, 'museum', 'door', 'museum')); const dm = async (id) => { await run(sys.museum.talk(g)); };\nfor (const id of ['pike', 'cabbagebutterfly', 'trilobite', 'monallama']) { g.give(id); w.donated[id] = true; } ROOMS_museum(g); T.ok(['pike', 'cabbagebutterfly', 'trilobite', 'monallama'].every(i => w.donated[i]), 'donations in all four wings'); await run(sys.places.go(g, 'town', 'exit', 'museum'));\n// 6. debt tier, home, placement, stereo, bed\nw.beans = 20000; w.debt = 0; await run(sys.economy.offerUpgrade(g)); T.ok(w.homeTier >= 1, 'home tier'); w.home.furn.push({ id: 'cotlamp', x: 5, z: 5, rot: 0 }, { id: 'seastereo', x: 1, z: 5, rot: 0 }, { id: 'loftmirror', x: 3, z: 6, rot: 0 }); await run(sys.places.go(g, 'home', 'door', 'home')); T.eq(g.place, 'home', 'inside the home'); T.ok(g.sys.venues2.homeScore(g).grade.length === 1, 'Bureau grades the home');\n{ const fd = { fn: 'stereo' }; await run(sys.homeRoom.use(g, w.home.furn[1], fd, null)); T.ok(w.flags.stereoOn, 'stereo plays'); }\nawait run(sys.places.go(g, 'town', 'exit', 'home'));\n// 7. the City: every venue\nw.min = 1200; w.beans = 30000; sys.time.visual(g, 0, true); await run(sys.bus.arriveCity(g, true)); T.eq(g.place, 'city', 'arrived in the City');\nconst V = ['salon', 'couture', 'theatre', 'auction', 'bureau', 'cafe', 'magda']; for (const id of V) { await run(sys.places.go(g, id, 'door', 'city')); T.eq(g.place, id, 'entered ' + id); await run(sys.places.go(g, 'city', 'exit', id)); }\nawait run(sys.venues2.cafe(g)); T.ok(w.coffee > 0, 'coffee buff'); await run(sys.venues2.fortune(g)); T.ok(w.luck > 0, 'fortune read'); await run(sys.venues2.theatre(g)); T.ok(w.flags.theatre, 'theatre sketch seen'); w.emotes.Laugh = true; T.ok(w.emotes.Laugh, 'emote learned');\nw.look.outfit = 'tee_red'; await run(sys.venues2.couture(g)); await run(sys.venues2.bureau(g)); T.ok(w.rating.grade !== '-', 'Bureau grade by critique'); await run(sys.venues2.auction(g)); await run(sys.venues2.magda(g)); await run(sys.bus.goHome(g)); T.eq(g.place, 'town', 'bus home');\n// 8. cheese\nw.day = 1; g.sys.cheese.pattern(g); T.ok(sys.cheese.price(g) > 0, 'cheese price'); g.give('cheese'); w.pockets.find(s => s.id === 'cheese').bought = 1; w.day = 5; sys.cheese.daily(g); T.ok(g.count('rotcheese') === 1, 'cheese goes bad at the next Market Day');\n// 9. chime, Vesper, pattern\nw.chime = [0, 2, 4, 5, 7, 5, 4, 2, 0, -1, 2, -1, 4, -1, 7, -1]; T.ok(w.chime.length === 16, 'chime composed'); g.sys.chime.hourly(g, 12); T.ok(true, 'chime heard on the hour'); w.day = 3; w.min = 900; await run(sys.vesper.show(g)); T.ok(w.vesper.songs.length >= 1 && g.count('record') >= 1, \"Vesper's record in pockets\");\nw.patterns[0] = { px: new Array(256).fill(2), name: 'T' }; T.ok(w.patterns[0].px.length === 256, 'pattern drawn');\n// 10. festivals and contests\nfor (const [day, id] of [[4, 'seed'], [8, 'lantern'], [12, 'soup'], [16, 'long']]) { w.day = day; w.min = 400; await run(sys.festivals.start(g, id)); T.ok(w.festivals[w.year + ':' + (day / 4 - 1)] || w.flags.yearOneDone, 'festival complete: ' + id); }\nw.year = 1; for (const id of ['derby', 'bugoff', 'snow']) { sys.contests.start(g, id); w.contest.best = 9000; w.contest.total = 9000; await run(sys.contests.finish(g)); T.ok(Object.keys(w.contests).length > 0, 'contest result: ' + id); }\nw.day = 8; w.movedOut.rocco = false; w.day = 9; sys.story2.daily(g); T.ok(w.movedOut.rocco, 'Rocco leaves on day 9'); g.npcs.reset(); T.ok(!!g.npcs.byId.fitch, 'Fitch moves in'); \n// 11. bed, seasons, absence, Pimm\nw.day = 1; w.min = 800; sys.time.sleepTo(g, 'festival'); T.eq(g.dayType, 3, 'hibernate lands on a festival'); const s0 = g.season; w.day = 4; sys.time.newDay(g, 'bed'); T.eq(g.season, 1, 'season turns'); w.realStamp = Date.now() - 3 * 86400000; const wc = w.town.weeds.length; sys.nature.daily(g); T.ok(w.absentDays >= 3 && w.town.weeds.length >= wc, 'absence: weeds pile up'); w.cleanExit = false; const p0 = w.pimm ?? 0; await run(sys.pimm.visit(g)); T.eq(w.pimm, p0 + 1, 'Inspector Pimm after an unclean exit');\n// 12. Long Night ending, Year Two\nw.day = 16; await run(sys.festivals.long(g)); T.eq(w.day, 1, 'year two begins next morning'); T.ok(w.year >= 2 || w.flags.yearOneDone, 'credits then year two');\n// settings, 10% music default, dev sliders\nT.ok(Math.abs(g.settings.music - 0.1) < 1e-9, 'music defaults to 10%'); const tn = (await import('../../src/data/tuning.js')); tn.setTuning('walk', 3.4); T.eq(tn.tuning.walk, 3.4, 'slider changes'); tn.resetTuning(); T.eq(tn.tuning.walk, 2.6, 'reset all restores');\nfunction ROOMS_museum(g) { import('../../src/world/rooms.js').then(m => m.ROOMS.museum.syncDisplays(g)); }\nconsole.log(g.status()); console.log('errors', e.errors.map(x => String(x.message ?? x)).slice(0, 3)); console.log('play: ' + T.count + ' checks, ' + T.fails + ' failures'); process.exit(T.fails || e.errors.length ? 1 : 0);\nE\ntimeout 600 node tests/play/playthrough.mjs 2>&1 | tail -30"}}}
