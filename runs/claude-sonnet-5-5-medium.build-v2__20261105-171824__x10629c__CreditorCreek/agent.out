2].map(i => ({ cone: [(1.7 - i * 0.4) * s, 1.1 * s, (1.7 - i * 0.4) * s], at: [0, (1.1 + i * 0.7) * s, 0], c: i % 2 ? 'can2' : 'can1' }))]; });\nexport const palmTree = treeBase('cc-palm', 'palm', (p) => { if (p.stage < 1) return sapling(); const s = growth(Math.round(p.stage)); return [{ cyl: [0.25, 2.4 * s, 0.25], at: [0, 1.2 * s, 0], rot: [0, 0, 6], c: 'trunk' }, ...[0, 1, 2, 3, 4].map(i => { const a = i / 5 * Math.PI * 2; return { box: [1.3, 0.1, 0.3], at: [Math.cos(a) * 0.55, 2.4 * s, Math.sin(a) * 0.55], rot: [0, -a * 180 / Math.PI, -15], c: 'can1' }; })]; });\nexport const TREE_DEFS = { oak: oakTree, pear: pearTree, pine: pineTree, palm: palmTree };\nE\npython3 - <<'E'\np='src/world/scenery.js'; s=open(p).read()\ns=s.replace(\"import { cheeseWheel, noticeBoard, parkBench, marketStall, house } from '../art/models.js';\",\"import { cheeseWheel, noticeBoard, parkBench, marketStall, house, TREE_DEFS } from '../art/models.js';\")\ni=s.index(\"export function buildTree(t, season) {\"); j=s.index(\"export function buildRock\")\nnew=\"\"\"export function buildTree(t, season) {\n  const kind = TREE_DEFS[t.kind] ? t.kind : 'oak'; const stage = t.stage ?? 3; const c = (n) => canopyColor(season, kind, n);\n  const palette = kind === 'pine' ? { can1: c(0), can2: season === 3 ? 'white' : 'green', trunk: 'plum' } : kind === 'palm' ? { can1: 'green', trunk: 'sand' } : { can1: c(0), can2: c(1), trunk: 'plum', fruit: 'lime' };\n  const obj = buildModel(TREE_DEFS[kind], { params: { stage, fruit: kind === 'pear' ? (t.fruit ?? 0) : 0 }, palette }).object; obj.name = 'tree'; obj.traverse(o => { if (o.isMesh) { o.castShadow = true; o.receiveShadow = true; } });\n  return { obj, canopies: [] };\n}\n\"\"\"\ns=s[:i]+new+s[j:]\nopen(p,'w').write(s)\np='src/world/terrain.js'; s=open(p).read()\n# ring: rebuild per season\ns=s.replace(\"    g.add(ring); this.ring = ring;\",\"    g.add(ring); this.ring = ring; this.ringSpec = ring.children.map(tr => ({ x: tr.position.x, z: tr.position.z, s: tr.scale.x, k: tr.userData.kind }));\")\ns=s.replace(\"const tr = S.buildTree({ kind: i++ % 3 ? 'pine' : 'oak', stage: 3 }, 0).obj; tr.position.set(x + 0.5, 0, z + 0.5); tr.scale.setScalar(1.2 + ((i * 37) % 10) / 20); tr.userData.ring = true; ring.add(tr);\",\"const kind = i++ % 3 ? 'pine' : 'oak'; const tr = S.buildTree({ kind, stage: 3 }, 0).obj; tr.position.set(x + 0.5, 0, z + 0.5); tr.scale.setScalar(1.2 + ((i * 37) % 10) / 20); tr.userData.kind = kind; ring.add(tr);\")\ni=s.index(\"  ringSeason(s) {\"); j=s.index(\"\\n\",i)\ns=s[:i]+\"  ringSeason(s) { if (this.ringBuilt === s) return; this.ringBuilt = s; for (const tr of this.ring.children.slice()) { this.ring.remove(tr); } for (const sp of this.ringSpec) { const tr = S.buildTree({ kind: sp.k, stage: 3 }, s).obj; tr.position.set(sp.x, 0, sp.z); tr.scale.setScalar(sp.s); this.ring.add(tr); } }\"+s[j:]\ns=s.replace(\"    for (const [id, tm] of this.treeMeshes) this.recolorTree(tm, s);\",\"    for (const [id, tm] of this.treeMeshes) this.group.remove(tm.obj); this.treeMeshes.clear();\")\ns=s.replace(\"if (tm && (tm.stage !== t.stage || t.felled !== tm.felled)) {\",\"if (tm && (tm.stage !== t.stage || t.felled !== tm.felled || tm.fruit !== (t.fruit ?? 0))) {\")\ns=s.replace(\"if (tm) { tm.stage = t.stage; tm.felled = t.felled; const f = tm.obj.userData.fruit; if (f) f.forEach((m, i) => { m.visible = i < (t.fruit ?? 0); }); }\",\"if (tm) { tm.stage = t.stage; tm.felled = t.felled; tm.fruit = t.fruit ?? 0; }\")\ns=s.replace(\"addTree(t, season) { const { obj, canopies } = S.buildTree(t, season); obj.position.set(t.x + 0.5, 0, t.z + 0.5); this.group.add(obj); this.treeMeshes.set(t.id, { obj, canopies, kind: t.kind, stage: t.stage, data: t }); return obj; }\",\"addTree(t, season) { const { obj, canopies } = S.buildTree(t, season); obj.position.set(t.x + 0.5, 0, t.z + 0.5); this.group.add(obj); this.treeMeshes.set(t.id, { obj, canopies, kind: t.kind, stage: t.stage, fruit: t.fruit ?? 0, data: t }); return obj; }\")\nopen(p,'w').write(s)\np='src/net/arena.js'; s=open(p).read()\ns=s.replace(\"    for (const t of this.res.trees) { const f = t.mesh.userData.fruit; if (f) f.forEach((m, i) => m.visible = i < t.fruit); }\",\"    for (const t of this.res.trees) { if (t.shown !== t.fruit) { t.shown = t.fruit; const pos = t.mesh.position.clone(); this.group.remove(t.mesh); t.mesh = buildTree({ kind: 'pear', stage: 3, fruit: t.fruit }, 0).obj; t.mesh.position.copy(pos); this.group.add(t.mesh); } }\")\nopen(p,'w').write(s)\nE\ngrep -n \"ringSeason(s)\" src/world/terrain.js | head -3; node kit/check.mjs --sheets src/art/models.js 2>&1 | grep -E \"^(OK|FAIL)|problem\\(s\\), [1-9]|^    !\" | head -8","uuid":"6f95b763-d180-42da-a672-1dbdec46c056","session_id":"f7fc0c99-6050-4a36-bbad-13de512b63e9"}
