.3, 0.5, 0.3], [0, 0.35, -0.45], hc)); if (style >= 4) J.Head.push(P('ball', [0.3, 0.3, 0.3], [0, 0.98, -0.1], hc));\n  }\n  if (spec.hat) { J.Head.push(P('cyl', [0.7, 0.22, 0.7], [0, sp.head[1] * 0.95, 0], spec.hat), P('cyl', [0.42, 0.3, 0.42], [0, sp.head[1] * 0.95 + 0.2, 0], spec.hat)); }\n  if (spec.glasses) J.Head.push(P('box', [0.55, 0.08, 0.04], [0, sp.head[1] * 0.58, sp.head[2] * 0.5], spec.glasses));\n  const piv = (name, at, parts) => ({ group: parts, at, pivot: true, name });\n  const eye = (name, x) => piv(name, [x * sp.head[0] / 0.85, ey, ez], [P('box', [0.1, 0.15, 0.05], [0, 0, 0], 'k')]);\n  const headG = piv('Head', [0, bodyH * 0.9, 0], [...J.Head, eye('EyeL', 0.17), eye('EyeR', -0.17), piv('Mouth', [0, sp.head[1] * 0.28, ez + 0.02], [P('box', [0.14, 0.04, 0.05], [0, 0, 0], 'k')])]);\n  const armX = bodyW * 0.5 + 0.06, armY = bodyH * 0.8;\n  const torsoG = piv('Torso', [0, 0, 0], [piv('ShirtBody', [0, bodyH * 0.5, 0], [P('ball', [bodyW, bodyH * 1.15, bodyD], [0, 0, 0], outfitCol)]), ...J.Torso, headG, piv('ArmR', [-armX, armY, 0], J.ArmR), piv('ArmL', [armX, armY, 0], J.ArmL)]);\n  const pelvis = piv('Pelvis', [0, legLen, 0], [piv('LegR', [-0.17, 0, 0], J.LegR), piv('LegL', [0.17, 0, 0], J.LegL), torsoG, ...J.Pelvis]);\n  used.add(outfitCol); used.add(skin); used.add('ink'); const palette = {}; for (const u of used) palette[u] = u;\n  return { def: { id: 'critter-' + (defCount++), about: 'Generated critter ' + spec.species, tags: ['critter', spec.species], palette, parts: [pelvis] }, legLen, bodyH, sp };\n}\nexport function buildCritter(spec) {\n  const { def, legLen, bodyH, sp } = critterDef(spec); const built = buildModel(def); const root = built.object; root.name = 'Critter';\n  const joints = {}; for (const n of ['Pelvis', 'Torso', 'Head', 'ArmR', 'ArmL', 'LegR', 'LegL']) joints[n] = root.getObjectByName(n);\n  const parts = { eyeL: root.getObjectByName('EyeL'), eyeR: root.getObjectByName('EyeR'), mouth: root.getObjectByName('Mouth'), shirt: root.getObjectByName('ShirtBody') };\n  const s = (spec.scale ?? 1) * (sp.scale ?? 1) * 0.85; root.scale.setScalar(s);\n  root.traverse(o => { if (o.isMesh) { o.castShadow = true; o.receiveShadow = false; } });\n  setLookLayer(root, 'actors');\n  return { object: root, joints, parts, height: (legLen + bodyH * 0.9 + sp.head[1] * 0.95) * s, species: spec.species };\n}\n'''\ns=s[:i]+new+s[j:]\ns=s.replace(\"import { THREE, toonMaterial, PALETTE, setLookLayer } from '../engine.js';\",\"import { THREE, toonMaterial, PALETTE, setLookLayer, buildModel } from '../engine.js';\")\nopen(p,'w').write(s)\np='src/actors/actor.js'; s=open(p).read()\ns=s.replace(\"this.parts.eyeL.scale.y = 0.15 * ey; this.parts.eyeR.scale.y = 0.15 * ey; if (this.sad) { this.parts.eyeL.scale.y *= 0.6; this.parts.eyeR.scale.y *= 0.6; }\",\"this.parts.eyeL.scale.y = ey; this.parts.eyeR.scale.y = ey; if (this.sad) { this.parts.eyeL.scale.y *= 0.6; this.parts.eyeR.scale.y *= 0.6; }\")\ns=s.replace(\"this.parts.mouth.scale.y = open;\",\"this.parts.mouth.scale.y = open / 0.04;\")\nopen(p,'w').write(s)\np='src/actors/player.js'; s=open(p).read()\ns=s.replace(\"const torso = this.actor.joints.Torso.children.find(c => c.isMesh);\",\"const torso = this.actor.parts.shirt?.children.find(c => c.isMesh);\")\nopen(p,'w').write(s)\np='tests/play/playthrough.mjs'; s=open(p).read()\ns=s.replace(\"g.player.actor.joints.Torso.children.find(c => c.isMesh).material.map != null\",\"g.player.actor.parts.shirt.children.find(c => c.isMesh).material.map != null\")\nopen(p,'w').write(s)\nE\nnode -e '\nimport(\"./src/art/critter.js\").then(async m=>{ const clips=await import(\"./src/art/clips.js\"); let n=0; for (const sp of m.SPECIES_LIST){ const b=m.buildCritter({species:sp,c:\"sand\",a:\"orange\",hat:\"red\"}); const c=clips.compileFor(b.object); if(!b.joints.Head||!b.joints.LegL) console.log(\"missing joint\",sp); n++; } const a=m.buildCritter({species:\"wombat\",c:\"sand\"}), b=m.buildCritter({species:\"wombat\",c:\"sand\"}); 