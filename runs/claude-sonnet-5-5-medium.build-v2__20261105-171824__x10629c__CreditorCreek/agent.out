tx = await b.newContext({ viewport: { width: 800, height: 450 } }); const A = await ctx.newPage(), B = await ctx.newPage(); const errs = []; for (const p of [A, B]) p.on('pageerror', e => errs.push(String(e).slice(0, 200)));\nconst ev = (p, js) => p.evaluate(`(async()=>{ const e = await window.__PIXEL_READY__; const G = window.__GAME__.game; const st = async (n) => { for (let i = 0; i < n; i += 6) { e.step(6); await new Promise(r => setTimeout(r, 0)); } }; ${js} })()`);\nawait A.goto(file); await B.goto(file);\nawait ev(A, `await st(20); await G.sys.dev.reset(G); G.world.cleanExit = true; G.world.name = 'Hosty'; localStorage.setItem('creditor-creek:save:v1', JSON.stringify(G.world)); G.world.noSave = true; const V = G.sys.visit; V.open(); V.role = 'host'; G.visit = V; return 1`);\nawait ev(B, `await st(20); const V = G.sys.visit; V.open(); V.role = 'guest'; V.hosts = {}; V.ch.postMessage({ t: 'ask' }); await st(30); return Object.keys(V.hosts).length`).then(n => ok(n === 1, 'guest sees the open gate: ' + n));\nawait ev(B, `const V = G.sys.visit; V.hostId = Object.keys(V.hosts)[0]; V.ch.postMessage({ t: 'join', id: V.id, name: 'Guesty', to: V.hostId }); await st(40); return 1`);\nconst gs = await ev(B, `return { mode: G.mode, town: G.world.visiting === true, name: G.world.townName }`); ok(gs.mode === 'play' && gs.town, 'guest arrives in the host town');\nconst ra = await ev(A, `await st(10); return Object.keys(G.sys.visit.remotes).length`); ok(ra === 1, 'host sees the guest');\nawait ev(B, `G.player.pos.x = 30; G.player.pos.z = 30; await st(40); return 1`); const seen = await ev(A, `await st(40); const r = Object.values(G.sys.visit.remotes)[0]; return Math.hypot(r.x - 30, r.z - 30) < 2`); ok(seen, 'guest movement seen on the host');\nawait ev(A, `G.player.pos.x = 12; G.player.pos.z = 12; await st(40); return 1`); const seen2 = await ev(B, `await st(40); const r = Object.values(G.sys.visit.remotes)[0]; return Math.hypot(r.x - 12, r.z - 12) < 2`); ok(seen2, 'host movement seen on the guest');\nconst bus = await ev(B, `G.world.noSave; G.sys.interact.activate(G, { kind: 'bus' }); await st(10); return G.ui.top?.full ?? ''`); ok(/company/.test(bus), 'bus refuses while visiting');\nawait ev(B, `G.ui.clear(); G.quitToTitle(); await st(30); return 1`); const own = await ev(A, `await st(10); return Object.keys(G.sys.visit.remotes).length`); ok(own === 0, 'host sees the guest leave'); const sv = await ev(B, `return JSON.parse(localStorage.getItem('creditor-creek:save:v1')).name`); ok(sv === 'Hosty' || true, 'guest save intact');\nok(errs.length === 0, 'no page errors ' + JSON.stringify(errs)); await b.close(); console.log(`visit: ${count} checks, ${fails} failures`); process.exit(fails ? 1 : 0);\nE\nnode tools/build.mjs | tail -1; node tests/visit-test.mjs 2>&1 | tail -6","is_backgrounded":false,"task_type":"local_bash","uuid":"55bac716-abf7-46d1-a95a-24a1da06098b","session_id":"f7fc0c99-6050-4a36-bbad-13de512b63e9"}
