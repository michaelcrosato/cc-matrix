h: [5.2, 3, 8], d: [3, 2, 6] }, parts: (p) => [{ box: [p.w, p.h, p.d], at: [0, p.h / 2, 0], c: 'wall' }, { box: [p.w + 0.4, 0.4, p.d + 0.4], at: [0, p.h + 0.2, 0], c: 'cornice' }, { box: [1.4, 2.4, 0.2], at: [0.5, 1.2, p.d / 2 + 0.1], c: 'door' }],\n});\nE\npython3 - <<'E'\np='src/world/rooms.js'; s=open(p).read()\ns=s.replace(\"import { THREE, toonMaterial, PALETTE, setLookLayer, buildModel, loadPack, TEXTURE_LIBRARY, MODEL_LIBRARY, ModelCatalog } from '../engine.js';\",\"import { THREE, toonMaterial, PALETTE, setLookLayer, buildModel, loadPack, TEXTURE_LIBRARY, MODEL_LIBRARY, ModelCatalog } from '../engine.js';\\nimport { roomDef } from '../art/models.js';\")\ni=s.index(\"export function buildRoom(def, g) {\"); j=s.index(\"export function roomPos\")\nnew=\"\"\"/** (Re)build the room shell from the room ModelDef. over: palette overrides (floor, wall). */\nexport function rebuildShell(def, over = {}) {\n  const grp = def.group; if (grp.userData.shell) grp.remove(grp.userData.shell); const w = def.w, d = def.d;\n  const shell = buildModel(roomDef, { params: { w, d, h: def.h ?? 3.2, doorX: def.doorX ?? w / 2 }, palette: { floor: over.floor ?? def.floor ?? 'orange', wall: over.wall ?? def.wall ?? 'sand', wall2: over.wall ?? def.wall2 ?? def.wall ?? 'sand' } }).object;\n  shell.position.set(w / 2, 0, d / 2); shell.traverse(o => { if (o.isMesh) { o.castShadow = false; o.receiveShadow = true; } }); grp.add(shell); grp.userData.shell = shell; setLookLayer(shell, 'environment');\n}\nexport function buildRoom(def, g) {\n  const grp = new Group(); grp.name = 'room:' + def.id; grp.position.set(def.ox, 0, def.oz); const w = def.w, d = def.d;\n  def.props ??= []; def.group = grp; def.windowsGlow = []; rebuildShell(def);\n  if (def.rug) part(grp, 'box', [w * 0.45, 0.03, d * 0.4], [w / 2, 0.02, d / 2], def.rug);\n  grp.traverse(o => { if (o.isMesh) o.castShadow = false; }); setLookLayer(grp, 'environment'); grp.visible = false; return grp;\n}\n\"\"\"\ns=s[:i]+new+s[j:]\nopen(p,'w').write(s)\np='src/systems/extras.js'; s=open(p).read()\ns=s.replace(\"recolor(g, def) { const w = g.world; const wl = WALLPAPER.find(x => x.id === w.home.wall), fl = FLOORS.find(x => x.id === w.home.floor); const u = def.group.userData; if (fl && u.floorMesh) u.floorMesh.material = toonMaterial(PALETTE[fl.color]); if (wl) for (const m of u.wallMeshes ?? []) m.material = toonMaterial(PALETTE[wl.color]); }\",\"recolor(g, def) { const w = g.world; if (def.id !== 'home') return; const wl = WALLPAPER.find(x => x.id === w.home.wall), fl = FLOORS.find(x => x.id === w.home.floor); rebuildShell(def, { floor: fl?.color, wall: wl?.color }); }\")\ns=s.replace(\"import { ROOMS, furnMesh } from '../world/rooms.js';\",\"import { ROOMS, furnMesh, rebuildShell } from '../world/rooms.js';\")\ns=s.replace(\"    def.props = []; this.recolorNow?.(g, def); g.sys.placement.recolor(g, def);\",\"    def.props = []; g.sys.placement.recolor(g, def); if (def.id !== 'home') rebuildShell(def);\")\nopen(p,'w').write(s)\np='src/systems/city.js'; s=open(p).read()\ns=s.replace(\"const w = 5, h = 5.2, d = 3; const x0 = v.x - 2; part(grp, 'box', [w, h, d], [x0 + w / 2, h / 2, 4.2], v.color); part(grp, 'box', [w + 0.4, 0.4, d + 0.4], [x0 + w / 2, h + 0.2, 4.2], 'ink');\",\"const w = 5, h = 5.2, d = 3; const x0 = v.x - 2; const sf = buildModel(shopfrontDef, { params: { w, h, d }, palette: { wall: v.color } }).object; sf.position.set(x0 + w / 2, 0, 4.2); grp.add(sf);\")\ns=s.replace(\"import { THREE, PALETTE, mergeStaticMeshes, toonMaterial, LOOK_PRESETS } from '../engine.js';\",\"import { THREE, PALETTE, mergeStaticMeshes, toonMaterial, LOOK_PRESETS, buildModel } from '../engine.js';\\nimport { shopfrontDef } from '../art/models.js';\")\nopen(p,'w').write(s)\nE\ngrep -n \"part(grp, 'box', \\[1.4, 2.4, 0.2\\]\" src/systems/city.js | head -2; node kit/check.mjs --sheets src/art/models.js 2>&1 | grep -E \"^(OK|FAIL)|[1-9][0-9]* problem\\(s\\)\" -A3 | head -8; node tools/build.mjs | tail -1; node tests/run.mjs --only play | tail -3"}}}
