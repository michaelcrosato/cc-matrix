{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011Cgkjgr6V6pwFKswYhS2MD","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QE3EGBFG3K3iYASpomMgK2","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-171824__x10629c/work/CreditorCreek*/src; \ncat > actors/player.js <<'E'\n// The player's avatar: camera-relative movement, tile collision, tool poses.\nimport { THREE } from '../engine.js';\nimport { Actor } from './actor.js';\nimport { tuning } from '../data/tuning.js';\nimport { SPAWNS } from '../world/townMap.js';\nconst { Vector3 } = THREE;\nexport const avatarSpec = (look) => ({ species: 'person', c: look.skin ?? 'sand', a: 'orange', hair: look.hair, hairStyle: look.hairStyle, outfit: outfitColor(look.outfit), hat: hatColor(look.hat), glasses: look.glasses ? 'ink' : null, pants: 'navy', shoes: 'ink', skin: look.skin ?? 'sand' });\nlet CL = null;\nconst lazy = async () => (CL ??= (await import('../data/items.js')).CLOTHES);\nconst OUT = { tee_red: 'red', tee_blue: 'blue', tee_lime: 'lime', dress_plum: 'plum', coat_navy: 'navy', rain_cyan: 'cyan', sweater_orange: 'orange', suit_slate: 'slate', gown_white: 'white', cape_red: 'red' };\nconst HAT = { hat_cap: 'blue', hat_top: 'ink', hat_straw: 'sand', hat_wool: 'orange', hat_umbrella: 'cyan', hat_pot: 'slate' };\nexport const outfitColor = (id) => OUT[id] ?? 'red'; export const hatColor = (id) => (id ? HAT[id] ?? null : null);\nexport class Player {\n  constructor(g) {\n    this.g = g; this.pos = { x: 4, z: 23 }; this.yaw = 0; this.speed = 0; this.mode = 'idle'; this.moveTarget = null; this.vx = 0; this.vz = 0; this.actor = new Actor(avatarSpec({ hair: 'plum', hairStyle: 0, skin: 'sand', outfit: 'tee_red' }));\n    this.actor.name = 'You'; this.input = { x: 0, y: 0 }; this.run = false; this.lockedUntil = 0; this.anim = null; this.animT = 0; this.dust = 0; this.stepT = 0; this.basis = { right: new Vector3(1, 0, 0), forward: new Vector3(0, 0, -1) };\n  }\n  reset(spawn = SPAWNS.bus) { this.pos.x = spawn[0]; this.pos.z = spawn[1]; this.rebuild(); this.vx = this.vz = 0; this.moveTarget = null; }\n  rebuild() { const g = this.g; const was = this.actor.root.parent; const vis = this.actor.root.visible; if (was) was.remove(this.actor.root); this.actor = new Actor(avatarSpec(g.world.look)); this.actor.name = g.world.name; this.actor.root.visible = vis; (was ?? g.ctx.scene).add(this.actor.root); this.actor.setPos(this.pos.x, this.pos.z); }\n  /** Compute camera-relative movement basis from the camera yaw (degrees). */\n  updateBasis() { const a = (this.g.camYaw * Math.PI) / 180; this.basis.forward.set(-Math.sin(a), 0, -Math.cos(a)); this.basis.right.set(Math.cos(a), 0, -Math.sin(a)); }\n  read(dt) {\n    const g = this.g, i = g.ctx.input, c = g.ui.c; this.updateBasis();\n    const ax = i.moveAxis(); let mx = ax.x, my = ax.y; let mag = Math.hypot(mx, my);\n    // mouse: click-to-walk on the ground\n    if (c.device === 'kb' && i.isDown('MouseLeft') && c.ptr.over && !g.ui.busy) {\n      const p = g.groundPoint(i.pointer.x, i.pointer.y); if (p) { const dx = p.x - this.pos.x, dz = p.z - this.pos.z; if (Math.hypot(dx, dz) > 0.35) this.moveTarget = { x: p.x, z: p.z }; }\n    }\n    if (mag > 0.15) this.moveTarget = null;\n    if (this.moveTarget) { const dx = this.moveTarget.x - this.pos.x, dz = this.moveTarget.z - this.pos.z; const d = Math.hypot(dx, dz); if (d < 0.25) this.moveTarget = null; else { const f = this.basis.forward, r = this.basis.right; my = (dx * f.x + dz * f.z) / d; mx = (dx * r.x + dz * r.z) / d; mag = 1; } }\n    this.input.x = mx; this.input.y = my; this.mag = Math.min(1, mag);\n    this.run = i.isDown('ShiftLeft', 'ShiftRight', 'PadCircle');\n    this.sneak = i.isDown('ControlLeft', 'ControlRight');\n  }\n  fixed(dt) {\n    const g = this.g; if (g.mode === 'attract' && g.sys.attract.drive) { g.sys.attract.drive(g, dt); }\n    const locked = this.lock > 0 || g.frozen; if (this.lock > 0) this.lock -= dt;\n    let sp = 0, mode = 'idle';\n    if (!locked && this.mag > 0.12) {\n      const m = this.mag; if (this.sneak || m < 0.35) { sp = 1.2; mode = 'tiptoe'; } else if (m < 0.7) { sp = tuning.walk; mode = 'walk'; } else { sp = tuning.jog; mode = 'jog'; }\n      if (this.run && !this.sneak && m > 0.35) { sp = tuning.run; mode = 'run'; }\n      if (this.slow) sp *= this.slow; if (g.world?.coffee > g.world?.day) sp *= 1.15;\n      const f = this.basis.forward, r = this.basis.right; let dx = this.input.x * r.x + this.input.y * f.x, dz = this.input.x * r.z + this.input.y * f.z; const l = Math.hypot(dx, dz) || 1; dx /= l; dz /= l;\n      const tx = dx * sp * dt, tz = dz * sp * dt; const px = this.pos.x, pz = this.pos.z;\n      g.placeMove(this.pos, tx, tz, 0.28);\n      const moved = Math.hypot(this.pos.x - px, this.pos.z - pz); this.speed = moved / dt;\n      if (moved > 0.001) { const ty = Math.atan2(dx, dz); let d = ty - this.yaw; d = Math.atan2(Math.sin(d), Math.cos(d)); this.yaw += d * Math.min(1, dt * 16); this.facing = { x: Math.sin(this.yaw), z: Math.cos(this.yaw) }; }\n      g.world && (g.world.stats.steps += moved);\n      this.stepT -= dt * (sp / 2.4); if (this.stepT <= 0 && moved > 0.001) { this.stepT = 0.36; g.footstep?.(this.pos, mode); }\n    } else { this.speed = 0; }\n    this.mode = mode;\n    this.facing ??= { x: 0, z: 1 };\n  }\n  setFacing(dx, dz) { this.yaw = Math.atan2(dx, dz); this.facing = { x: Math.sin(this.yaw), z: Math.cos(this.yaw) }; }\n  faceToward(x, z) { const dx = x - this.pos.x, dz = z - this.pos.z; if (Math.hypot(dx, dz) > 0.01) this.setFacing(dx, dz); }\n  /** Play an action animation, locking movement for its duration. Returns a promise. */\n  async act(name, dur, o = {}) {\n    this.lock = dur; this.anim = name; const a = this.actor; a.play(name, { once: !o.loop, restart: true, fade: 0.08 }); this.animT = dur;\n    await new Promise(r => { this.g.after(dur, r); }); if (this.anim === name) this.anim = null;\n  }\n  syncActor() {\n    const a = this.actor; a.setPos(this.pos.x, this.pos.z, this.g.floorY ?? 0); a.yaw = this.yaw;\n    if (this.anim) return; if (this.hold) { a.play(this.hold); return; }\n    a.locomote(this.speed, this.mode);\n  }\n}\nE\ncat > actors/npc.js <<'E'\n// Neighbours and hosts: routines (bedtime, wake, hangouts), NavGrid paths, bubbles, memory-aware talk.\nimport { THREE, NavGrid } from '../engine.js';\nimport { Actor } from './actor.js';\nimport { NEIGHBOURS, HOSTS } from '../data/neighbours.js';\nimport { TW, TD, BUILDINGS } from '../world/townMap.js';\nimport { tuning } from '../data/tuning.js';\nimport { hourOf, isWet } from '../core/calendar.js';\nconst byId = Object.fromEntries(BUILDINGS.map(b => [b.id, b]));\nexport class Npc {\n  constructor(def, g, kind = 'neighbour') {\n    this.def = def; this.id = def.id; this.kind = kind; this.g = g; this.name = def.name; this.type = def.type; this.pitch = def.pitch; this.slow = def.slow; this.voice = def.voice;\n    this.actor = new Actor({ species: def.species, c: def.color, a: def.accent, name: def.name }); this.actor.name = def.name; this.state = 'idle'; this.path = null; this.pi = 0; this.timer = 2 + Math.random() * 4; this.pos = { x: 0, z: 0 }; this.yaw = 0; this.indoors = false; this.busy = false; this.nameColor = def.color;\n    this.umbrella = false; this.sleeping = false; this.talkingTo = null; this.bubble = null; this.home = def.home;\n  }\n  get doorTile() { const b = byId[this.def.house ?? this.def.id]; return b ? [b.door[0] + 0.5, b.door[1] + 1.5] : [this.pos.x, this.pos.z]; }\n}\nexport class NpcManager {\n  constructor(g) { this.g = g; this.list = []; this.byId = {}; this.nav = null; this.group = new THREE.Group(); g.ctx.scene.add(this.group); }\n  rebuildNav() { const g = this.g; const rows = []; for (let z = 0; z < TD; z++) { let r = ''; for (let x = 0; x < TW; x++) r += g.grid.bl[z * TW + x] ? '#' : '.'; rows.push(r); } this.nav = NavGrid.fromRows(rows, { blocked: '#', cell: 1, origin: [0, 0, 0] }); }\n  reset() {\n    for (const n of this.list) this.group.remove(n.actor.root); this.list = []; this.byId = {}; const g = this.g, w = g.world;\n    const defs = NEIGHBOURS.filter(n => !(n.id === 'fitch' && (w.day < 9 && w.year === 1 && !w.movedOut.fitch)) && !(n.id === 'rocco' && w.movedOut.rocco));\n    for (const d of defs) { const n = new Npc(d, g); const dt = n.doorTile; n.pos.x = dt[0]; n.pos.z = dt[1] + 0.2; this.byId[d.id] = n; this.list.push(n); this.group.add(n.actor.root); n.actor.setPos(n.pos.x, n.pos.z); }\n    this.rebuildNav(); this.schedule(true);\n  }\n  setVisible(v) { this.group.visible = v; }\n  /** Place everybody sensibly for the current hour (used at load, wake, teleports). */\n  schedule(snap) {\n    const g = this.g, h = g.hour;\n    for (const n of this.list) {\n      const d = n.def; const asleep = this.isAsleep(n, h);\n      if (asleep) { n.sleeping = true; n.indoors = true; n.actor.show(false); n.state = 'asleep'; n.path = null; const dt = n.doorTile; n.pos.x = dt[0]; n.pos.z = dt[1]; }\n      else if (n.sleeping || snap) { n.sleeping = false; n.indoors = false; n.actor.show(true); const spots = d.hang; const sp = spots[(Math.floor(this.g.rng() * spots.length))]; if (snap) { n.pos.x = sp[0] + 0.5; n.pos.z = sp[1] + 0.5; const f = g.grid.free(n.pos.x, n.pos.z); n.pos.x = f[0]; n.pos.z = f[1]; } n.state = 'idle'; n.timer = 1 + g.rng() * 3; }\n    }\n  }\n  isAsleep(n, h) { const d = n.def; const hh = h < 5 ? h + 24 : h; const bed = d.bed < 5 ? d.bed + 24 : d.bed; return hh >= bed || hh < (d.wake < 5 ? d.wake + 24 : d.wake) && hh < d.wake + (d.wake < 5 ? 24 : 0) && h < d.wake && h >= 0 ? (h < d.wake) : hh >= bed; }\n  fixed(dt) {\n    const g = this.g; if (g.mode === 'title') return; const h = g.hour; this.sched = (this.sched ?? 0) + dt;\n    if (this.sched > 2) { this.sched = 0; this.checkSleep(h); }\n    for (const n of this.list) {\n      if (n.sleeping || n.busy) continue;\n      const sp = tuning.npcSpeed * (n.def.type === 'gogetter' ? 1.3 : n.def.type === 'grouch' ? 0.8 : 1);\n      if (n.state === 'walk' && n.path) {\n        const t = n.path[n.pi]; if (!t) { this.arrive(n); continue; }\n        let dx = t[0] - n.pos.x, dz = t[2] - n.pos.z; const d = Math.hypot(dx, dz);\n        if (d < 0.2) { n.pi++; if (n.pi >= n.path.length) this.arrive(n); continue; }\n        dx /= d; dz /= d; const px = n.pos.x, pz = n.pos.z; n.pos.x += dx * sp * dt; n.pos.z += dz * sp * dt; n.yaw = Math.atan2(dx, dz); n.speed = sp;\n      } else {\n        n.speed = 0; n.timer -= dt * (tuning.chatRate > 0 ? 1 : 1);\n        if (n.timer <= 0) this.decide(n, h);\n      }\n    }\n  }\n  checkSleep(h) {\n    const g = this.g; for (const n of this.list) {\n      const asleep = this.isAsleep(n, h);\n      if (asleep && !n.sleeping && !n.busy) { // walk home then vanish\n        if (n.state !== 'gohome') { const dt = n.doorTile; this.goto(n, dt[0], dt[1], 'gohome'); }\n      } else if (!asleep && n.sleeping) { n.sleeping = false; n.indoors = false; n.actor.show(true); const dt = n.doorTile; n.pos.x = dt[0]; n.pos.z = dt[1]; n.state = 'idle'; n.timer = 1; }\n    }\n  }\n  goto(n, x, z, why = 'walk') {\n    const p = this.nav.path([n.pos.x, 0, n.pos.z], [x, 0, z]); if (!p) { n.state = 'idle'; n.timer = 3; return false; }\n    n.path = p; n.pi = 1; n.state = 'walk'; n.why = why; return true;\n  }\n  arrive(n) {\n    n.path = null; n.speed = 0;\n    if (n.why === 'gohome') { n.sleeping = true; n.indoors = true; n.actor.show(false); n.state = 'asleep'; return; }\n    n.state = 'idle'; n.timer = 4 + this.g.rng() * 9; n.doing = null;\n    const r = this.g.rng(); n.doing = r < 0.25 ? 'Hum' : r < 0.4 ? 'Sway' : r < 0.5 ? 'IdleBored' : null;\n  }\n  decide(n, h) {\n    const g = this.g, d = n.def; const wet = isWet(g.weather);\n    if (wet && n.def.type !== 'grouch' && g.rng() < 0.3) { n.umbrella = true; }\n    const r = g.rng();\n    if (r < 0.12 && n.doing == null) { n.timer = 3; n.doing = 'Hum'; return; }\n    let tx, tz; if (r < 0.55) { const s = d.hang[Math.floor(g.rng() * d.hang.length)]; tx = s[0] + 0.5 + (g.rng() - 0.5) * 2; tz = s[1] + 0.5 + (g.rng() - 0.5) * 2; } else if (r < 0.8) { tx = n.pos.x + (g.rng() - 0.5) * 8; tz = n.pos.z + (g.rng() - 0.5) * 8; } else { const o = this.list[Math.floor(g.rng() * this.list.length)]; if (o && !o.sleeping) { tx = o.pos.x + 1.2; tz = o.pos.z + 0.5; } else { tx = 21; tz = 23; } }\n    const f = g.grid.free(Math.max(2, Math.min(TW - 3, tx)), Math.max(3, Math.min(TD - 8, tz)));\n    if (!this.goto(n, f[0], f[1])) n.timer = 2;\n  }\n  updateVisual(dt, t) {\n    const g = this.g;\n    for (const n of this.list) {\n      const a = n.actor; a.setPos(n.pos.x, n.pos.z, g.place === 'town' ? 0 : -999); a.yaw = n.yaw; if (n.sleeping || g.place !== 'town') { a.root.visible = false; continue; } a.root.visible = !n.hidden;\n      if (!n.busy || n.walkAnim) { if (n.state === 'walk') a.locomote(n.speed, 'walk'); else if (n.talkingTo) a.play('Talk'); else a.play(n.doing ?? 'Idle'); }\n      a.update(dt, t);\n    }\n  }\n  near(x, z, r) { let best = null, bd = r; for (const n of this.list) { if (n.sleeping || !n.actor.root.visible) continue; const d = Math.hypot(n.pos.x - x, n.pos.z - z); if (d < bd) { bd = d; best = n; } } return best; }\n}\nE\necho ok"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1398,"cache_read_input_tokens":282627,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1398},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f7fc0c99-6050-4a36-bbad-13de512b63e9","uuid":"1acc8baf-3069-41cd-8016-5961d0b26ef0","timestamp":"2026-11-06T00:35:53.436Z","request_id":"req_011Cgkjgqr6Ref89opTZeeWV","wire_tool_inputs":{"toolu_01QE3EGBFG3K3iYASpomMgK2":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-171824__x10629c/work/CreditorCreek*/src; \ncat > actors/player.js <<'E'\n// The player's avatar: camera-relative movement, tile collision, tool poses.\nimport { THREE } from '../engine.js';\nimport { Actor } from './actor.js';\nimport { tuning } from '../data/tuning.js';\nimport { SPAWNS } from '../world/townMap.js';\nconst { Vector3 } = THREE;\nexport const avatarSpec = (look) => ({ species: 'person', c: look.skin ?? 'sand', a: 'orange', hair: look.hair, hairStyle: look.hairStyle, outfit: outfitColor(look.outfit), hat: hatColor(look.hat), glasses: look.glasses ? 'ink' : null, pants: 'navy', shoes: 'ink', skin: look.skin ?? 'sand' });\nlet CL = null;\nconst lazy = async () => (CL ??= (await import('../data/items.js')).CLOTHES);\nconst OUT = { tee_red: 'red', tee_blue: 'blue', tee_lime: 'lime', dress_plum: 'plum', coat_navy: 'navy', rain_cyan: 'cyan', sweater_orange: 'orange', suit_slate: 'slate', gown_white: 'white', cape_red: 'red' };\nconst HAT = { hat_cap: 'blue', hat_top: 'ink', hat_straw: 'sand', hat_wool: 'orange', hat_umbrella: 'cyan', hat_pot: 'slate' };\nexport const outfitColor = (id) => OUT[id] ?? 'red'; export const hatColor = (id) => (id ? HAT[id] ?? null : null);\nexport class Player {\n  constructor(g) {\n    this.g = g; this.pos = { x: 4, z: 23 }; this.yaw = 0; this.speed = 0; this.mode = 'idle'; this.moveTarget = null; this.vx = 0; this.vz = 0; this.actor = new Actor(avatarSpec({ hair: 'plum', hairStyle: 0, skin: 'sand', outfit: 'tee_red' }));\n    this.actor.name = 'You'; this.input = { x: 0, y: 0 }; this.run = false; this.lockedUntil = 0; this.anim = null; this.animT = 0; this.dust = 0; this.stepT = 0; this.basis = { right: new Vector3(1, 0, 0), forward: new Vector3(0, 0, -1) };\n  }\n  reset(spawn = SPAWNS.bus) { this.pos.x = spawn[0]; this.pos.z = spawn[1]; this.rebuild(); this.vx = this.vz = 0; this.moveTarget = null; }\n  rebuild() { const g = this.g; const was = this.actor.root.parent; const vis = this.actor.root.visible; if (was) was.remove(this.actor.root); this.actor = new Actor(avatarSpec(g.world.look)); this.actor.name = g.world.name; this.actor.root.visible = vis; (was ?? g.ctx.scene).add(this.actor.root); this.actor.setPos(this.pos.x, this.pos.z); }\n  /** Compute camera-relative movement basis from the camera yaw (degrees). */\n  updateBasis() { const a = (this.g.camYaw * Math.PI) / 180; this.basis.forward.set(-Math.sin(a), 0, -Math.cos(a)); this.basis.right.set(Math.cos(a), 0, -Math.sin(a)); }\n  read(dt) {\n    const g = this.g, i = g.ctx.input, c = g.ui.c; this.updateBasis();\n    const ax = i.moveAxis(); let mx = ax.x, my = ax.y; let mag = Math.hypot(mx, my);\n    // mouse: click-to-walk on the ground\n    if (c.device === 'kb' && i.isDown('MouseLeft') && c.ptr.over && !g.ui.busy) {\n      const p = g.groundPoint(i.pointer.x, i.pointer.y); if (p) { const dx = p.x - this.pos.x, dz = p.z - this.pos.z; if (Math.hypot(dx, dz) > 0.35) this.moveTarget = { x: p.x, z: p.z }; }\n    }\n    if (mag > 0.15) this.moveTarget = null;\n    if (this.moveTarget) { const dx = this.moveTarget.x - this.pos.x, dz = this.moveTarget.z - this.pos.z; const d = Math.hypot(dx, dz); if (d < 0.25) this.moveTarget = null; else { const f = this.basis.forward, r = this.basis.right; my = (dx * f.x + dz * f.z) / d; mx = (dx * r.x + dz * r.z) / d; mag = 1; } }\n    this.input.x = mx; this.input.y = my; this.mag = Math.min(1, mag);\n    this.run = i.isDown('ShiftLeft', 'ShiftRight', 'PadCircle');\n    this.sneak = i.isDown('ControlLeft', 'ControlRight');\n  }\n  fixed(dt) {\n    const g = this.g; if (g.mode === 'attract' && g.sys.attract.drive) { g.sys.attract.drive(g, dt); }\n    const locked = this.lock > 0 || g.frozen; if (this.lock > 0) this.lock -= dt;\n    let sp = 0, mode = 'idle';\n    if (!locked && this.mag > 0.12) {\n      const m = this.mag; if (this.sneak || m < 0.35) { sp = 1.2; mode = 'tiptoe'; } else if (m < 0.7) { sp = tuning.walk; mode = 'walk'; } else { sp = tuning.jog; mode = 'jog'; }\n      if (this.run && !this.sneak && m > 0.35) { sp = tuning.run; mode = 'run'; }\n      if (this.slow) sp *= this.slow; if (g.world?.coffee > g.world?.day) sp *= 1.15;\n      const f = this.basis.forward, r = this.basis.right; let dx = this.input.x * r.x + this.input.y * f.x, dz = this.input.x * r.z + this.input.y * f.z; const l = Math.hypot(dx, dz) || 1; dx /= l; dz /= l;\n      const tx = dx * sp * dt, tz = dz * sp * dt; const px = this.pos.x, pz = this.pos.z;\n      g.placeMove(this.pos, tx, tz, 0.28);\n      const moved = Math.hypot(this.pos.x - px, this.pos.z - pz); this.speed = moved / dt;\n      if (moved > 0.001) { const ty = Math.atan2(dx, dz); let d = ty - this.yaw; d = Math.atan2(Math.sin(d), Math.cos(d)); this.yaw += d * Math.min(1, dt * 16); this.facing = { x: Math.sin(this.yaw), z: Math.cos(this.yaw) }; }\n      g.world && (g.world.stats.steps += moved);\n      this.stepT -= dt * (sp / 2.4); if (this.stepT <= 0 && moved > 0.001) { this.stepT = 0.36; g.footstep?.(this.pos, mode); }\n    } else { this.speed = 0; }\n    this.mode = mode;\n    this.facing ??= { x: 0, z: 1 };\n  }\n  setFacing(dx, dz) { this.yaw = Math.atan2(dx, dz); this.facing = { x: Math.sin(this.yaw), z: Math.cos(this.yaw) }; }\n  faceToward(x, z) { const dx = x - this.pos.x, dz = z - this.pos.z; if (Math.hypot(dx, dz) > 0.01) this.setFacing(dx, dz); }\n  /** Play an action animation, locking movement for its duration. Returns a promise. */\n  async act(name, dur, o = {}) {\n    this.lock = dur; this.anim = name; const a = this.actor; a.play(name, { once: !o.loop, restart: true, fade: 0.08 }); this.animT = dur;\n    await new Promise(r => { this.g.after(dur, r); }); if (this.anim === name) this.anim = null;\n  }\n  syncActor() {\n    const a = this.actor; a.setPos(this.pos.x, this.pos.z, this.g.floorY ?? 0); a.yaw = this.yaw;\n    if (this.anim) return; if (this.hold) { a.play(this.hold); return; }\n    a.locomote(this.speed, this.mode);\n  }\n}\nE\ncat > actors/npc.js <<'E'\n// Neighbours and hosts: routines (bedtime, wake, hangouts), NavGrid paths, bubbles, memory-aware talk.\nimport { THREE, NavGrid } from '../engine.js';\nimport { Actor } from './actor.js';\nimport { NEIGHBOURS, HOSTS } from '../data/neighbours.js';\nimport { TW, TD, BUILDINGS } from '../world/townMap.js';\nimport { tuning } from '../data/tuning.js';\nimport { hourOf, isWet } from '../core/calendar.js';\nconst byId = Object.fromEntries(BUILDINGS.map(b => [b.id, b]));\nexport class Npc {\n  constructor(def, g, kind = 'neighbour') {\n    this.def = def; this.id = def.id; this.kind = kind; this.g = g; this.name = def.name; this.type = def.type; this.pitch = def.pitch; this.slow = def.slow; this.voice = def.voice;\n    this.actor = new Actor({ species: def.species, c: def.color, a: def.accent, name: def.name }); this.actor.name = def.name; this.state = 'idle'; this.path = null; this.pi = 0; this.timer = 2 + Math.random() * 4; this.pos = { x: 0, z: 0 }; this.yaw = 0; this.indoors = false; this.busy = false; this.nameColor = def.color;\n    this.umbrella = false; this.sleeping = false; this.talkingTo = null; this.bubble = null; this.home = def.home;\n  }\n  get doorTile() { const b = byId[this.def.house ?? this.def.id]; return b ? [b.door[0] + 0.5, b.door[1] + 1.5] : [this.pos.x, this.pos.z]; }\n}\nexport class NpcManager {\n  constructor(g) { this.g = g; this.list = []; this.byId = {}; this.nav = null; this.group = new THREE.Group(); g.ctx.scene.add(this.group); }\n  rebuildNav() { const g = this.g; const rows = []; for (let z = 0; z < TD; z++) { let r = ''; for (let x = 0; x < TW; x++) r += g.grid.bl[z * TW + x] ? '#' : '.'; rows.push(r); } this.nav = NavGrid.fromRows(rows, { blocked: '#', cell: 1, origin: [0, 0, 0] }); }\n  reset() {\n    for (const n of this.list) this.group.remove(n.actor.root); this.list = []; this.byId = {}; const g = this.g, w = g.world;\n    const defs = NEIGHBOURS.filter(n => !(n.id === 'fitch' && (w.day < 9 && w.year === 1 && !w.movedOut.fitch)) && !(n.id === 'rocco' && w.movedOut.rocco));\n    for (const d of defs) { const n = new Npc(d, g); const dt = n.doorTile; n.pos.x = dt[0]; n.pos.z = dt[1] + 0.2; this.byId[d.id] = n; this.list.push(n); this.group.add(n.actor.root); n.actor.setPos(n.pos.x, n.pos.z); }\n    this.rebuildNav(); this.schedule(true);\n  }\n  setVisible(v) { this.group.visible = v; }\n  /** Place everybody sensibly for the current hour (used at load, wake, teleports). */\n  schedule(snap) {\n    const g = this.g, h = g.hour;\n    for (const n of this.list) {\n      const d = n.def; const asleep = this.isAsleep(n, h);\n      if (asleep) { n.sleeping = true; n.indoors = true; n.actor.show(false); n.state = 'asleep'; n.path = null; const dt = n.doorTile; n.pos.x = dt[0]; n.pos.z = dt[1]; }\n      else if (n.sleeping || snap) { n.sleeping = false; n.indoors = false; n.actor.show(true); const spots = d.hang; const sp = spots[(Math.floor(this.g.rng() * spots.length))]; if (snap) { n.pos.x = sp[0] + 0.5; n.pos.z = sp[1] + 0.5; const f = g.grid.free(n.pos.x, n.pos.z); n.pos.x = f[0]; n.pos.z = f[1]; } n.state = 'idle'; n.timer = 1 + g.rng() * 3; }\n    }\n  }\n  isAsleep(n, h) { const d = n.def; const hh = h < 5 ? h + 24 : h; const bed = d.bed < 5 ? d.bed + 24 : d.bed; return hh >= bed || hh < (d.wake < 5 ? d.wake + 24 : d.wake) && hh < d.wake + (d.wake < 5 ? 24 : 0) && h < d.wake && h >= 0 ? (h < d.wake) : hh >= bed; }\n  fixed(dt) {\n    const g = this.g; if (g.mode === 'title') return; const h = g.hour; this.sched = (this.sched ?? 0) + dt;\n    if (this.sched > 2) { this.sched = 0; this.checkSleep(h); }\n    for (const n of this.list) {\n      if (n.sleeping || n.busy) continue;\n      const sp = tuning.npcSpeed * (n.def.type === 'gogetter' ? 1.3 : n.def.type === 'grouch' ? 0.8 : 1);\n      if (n.state === 'walk' && n.path) {\n        const t = n.path[n.pi]; if (!t) { this.arrive(n); continue; }\n        let dx = t[0] - n.pos.x, dz = t[2] - n.pos.z; const d = Math.hypot(dx, dz);\n        if (d < 0.2) { n.pi++; if (n.pi >= n.path.length) this.arrive(n); continue; }\n        dx /= d; dz /= d; const px = n.pos.x, pz = n.pos.z; n.pos.x += dx * sp * dt; n.pos.z += dz * sp * dt; n.yaw = Math.atan2(dx, dz); n.speed = sp;\n      } else {\n        n.speed = 0; n.timer -= dt * (tuning.chatRate > 0 ? 1 : 1);\n        if (n.timer <= 0) this.decide(n, h);\n      }\n    }\n  }\n  checkSleep(h) {\n    const g = this.g; for (const n of this.list) {\n      const asleep = this.isAsleep(n, h);\n      if (asleep && !n.sleeping && !n.busy) { // walk home then vanish\n        if (n.state !== 'gohome') { const dt = n.doorTile; this.goto(n, dt[0], dt[1], 'gohome'); }\n      } else if (!asleep && n.sleeping) { n.sleeping = false; n.indoors = false; n.actor.show(true); const dt = n.doorTile; n.pos.x = dt[0]; n.pos.z = dt[1]; n.state = 'idle'; n.timer = 1; }\n    }\n  }\n  goto(n, x, z, why = 'walk') {\n    const p = this.nav.path([n.pos.x, 0, n.pos.z], [x, 0, z]); if (!p) { n.state = 'idle'; n.timer = 3; return false; }\n    n.path = p; n.pi = 1; n.state = 'walk'; n.why = why; return true;\n  }\n  arrive(n) {\n    n.path = null; n.speed = 0;\n    if (n.why === 'gohome') { n.sleeping = true; n.indoors = true; n.actor.show(false); n.state = 'asleep'; return; }\n    n.state = 'idle'; n.timer = 4 + this.g.rng() * 9; n.doing = null;\n    const r = this.g.rng(); n.doing = r < 0.25 ? 'Hum' : r < 0.4 ? 'Sway' : r < 0.5 ? 'IdleBored' : null;\n  }\n  decide(n, h) {\n    const g = this.g, d = n.def; const wet = isWet(g.weather);\n    if (wet && n.def.type !== 'grouch' && g.rng() < 0.3) { n.umbrella = true; }\n    const r = g.rng();\n    if (r < 0.12 && n.doing == null) { n.timer = 3; n.doing = 'Hum'; return; }\n    let tx, tz; if (r < 0.55) { const s = d.hang[Math.floor(g.rng() * d.hang.length)]; tx = s[0] + 0.5 + (g.rng() - 0.5) * 2; tz = s[1] + 0.5 + (g.rng() - 0.5) * 2; } else if (r < 0.8) { tx = n.pos.x + (g.rng() - 0.5) * 8; tz = n.pos.z + (g.rng() - 0.5) * 8; } else { const o = this.list[Math.floor(g.rng() * this.list.length)]; if (o && !o.sleeping) { tx = o.pos.x + 1.2; tz = o.pos.z + 0.5; } else { tx = 21; tz = 23; } }\n    const f = g.grid.free(Math.max(2, Math.min(TW - 3, tx)), Math.max(3, Math.min(TD - 8, tz)));\n    if (!this.goto(n, f[0], f[1])) n.timer = 2;\n  }\n  updateVisual(dt, t) {\n    const g = this.g;\n    for (const n of this.list) {\n      const a = n.actor; a.setPos(n.pos.x, n.pos.z, g.place === 'town' ? 0 : -999); a.yaw = n.yaw; if (n.sleeping || g.place !== 'town') { a.root.visible = false; continue; } a.root.visible = !n.hidden;\n      if (!n.busy || n.walkAnim) { if (n.state === 'walk') a.locomote(n.speed, 'walk'); else if (n.talkingTo) a.play('Talk'); else a.play(n.doing ?? 'Idle'); }\n      a.update(dt, t);\n    }\n  }\n  near(x, z, r) { let best = null, bd = r; for (const n of this.list) { if (n.sleeping || !n.actor.root.visible) continue; const d = Math.hypot(n.pos.x - x, n.pos.z - z); if (d < bd) { bd = d; best = n; } } return best; }\n}\nE\necho ok"}}}
