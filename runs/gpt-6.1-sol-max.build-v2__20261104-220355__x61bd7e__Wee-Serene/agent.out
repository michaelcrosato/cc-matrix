{"type":"item.started","item":{"id":"item_76","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module - <<'JS'\nimport {load} from './tests/load.mjs';const {G}=load();for(const f of [1.4,1.8,2]){let out=[];for(const [name,param,push,every]of [['body',[14,7,4,3,1.1,.2],0,7],['flow',[12,6,6,3.2,1.3,.28],.5,9],['stork1',[12,5,13,3,1.5,.24],.6,7],['stork2',[11,4.5,15,3.6,1.7,.22],.7,6],['candle',[10,5,11,1.4,.8,.2],.55,5],['laundry',[10,3.5,16,3.5,1.2,.4],.9,5]]){let total=0;for(let seed=1;seed<=12;seed++){const rng=G.E.rng(seed),b=new G.Balance(Object.fromEntries(['k','c','s','A','nf','R'].map((k,i)=>[k,param[i]])),rng),r2=G.E.rng(seed),c={bal:b,intent:G.emptyIntent(),seed,botNX:G.noise(r2,f),botNY:G.noise(r2,f)};let last=0;for(let i=0;i<5400;i++){G.balanceBot(c,'poor',1/120);if(Math.floor(b.t/every)>last){last++;const a=rng()*6.28;b.vx+=Math.cos(a)*push;b.vy+=Math.sin(a)*push;}b.step(1/120,c.intent);}total+=b.steadiness;}out.push(name+':'+(total/12).toFixed(3));}console.log(f,out.join(' '));}\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
