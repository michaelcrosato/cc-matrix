{"type":"item.started","item":{"id":"item_93","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('tests/browser.mjs');s=p.read_text();needle=\\\"// Procedural audio: measure actual buses and an offline voice render after a real gesture.\\\"\nextra=\\\"\\\"\\\"// Open the actual standard pause menu, then enter the live developer dock.\n await page.keyboard.press('p');await page.evaluate(()=>G.game.advance(.12));T.check(await page.evaluate(()=>G.game.paused),'P opens the standard pause menu');\n const devButton=page.getByRole('button',{name:'Dev Mode',exact:true});await devButton.click();await page.evaluate(()=>G.game.advance(.03,{draw:true}));T.check(await page.evaluate(()=>G.dev.open&&\"'!G.game.paused),'\"'Dev Mode is reachable from pause and leaves the game running');\n await page.evaluate(()=>{G.dev.group='Lean';G.dev.row=0;G.dev.page=0;});await page.keyboard.press('ArrowRight');await page.evaluate(()=>G.game.advance(.03,{draw:true}));T.check(await page.evaluate(()=>G.DEV.k>12),'developer arrow input changes responsiveness');await page.screenshot({path:'tests/screens/developer.png'});\n await page.evaluate(()=>{G.resetDev();G.dev.open=false;});\n \\\"\\\"\\\"\ns=s.replace(needle,extra+needle)\nneedle=\\\"await page.evaluate(()=>{G.dev.open=false;G.game.shell.show('settings');});\\\"\nextra=\\\"\\\"\\\"await page.evaluate(()=>{G.dev.open=false;G.go('classLobby',null,true);G.game.advance(.2);});await page.keyboard.press('2');await page.evaluate(()=>G.game.advance(.16));T.equal(await page.evaluate(()=>G.game.players.length),2,'2 joins a second keyboard player through the real listener');\n await page.evaluate(()=>{for(let i=0;i<3;i++){G.game.input.tap('down');G.game.advance(.16);}G.game.input.tap('confirm');G.game.advance(.2);G.go('session',G.pending,true);G.game.advance(.2);G.beginPlay();});T.equal(await page.evaluate(()=>G.context.contestants.length),4,'local Class fills four mats with two people and two practice partners');\n await page.keyboard.down('a');await page.keyboard.down('ArrowRight');await page.evaluate(()=>G.game.advance(.2,{draw:true}));const halves=await page.evaluate(()=>G.context.contestants.slice(0,2).map(c=>c.intent.x));T.check(halves[0]<-.1&&halves[1]>.1,'split keyboard players lean independently');await page.keyboard.up('a');await page.keyboard.up('ArrowRight');await page.screenshot({path:'tests/screens/class.png'});\n await page.evaluate(()=>{while(G.game.players.length>1)G.game.removePlayer(G.game.players.at(-1));G.go('about',null,true);G.game.advance(.2,{draw:true});});T.equal(await page.evaluate(()=>G.ABOUT),JSON.parse(fs.readFileSync('../exit-interview.json','utf8')),'About embeds the exact exit-interview record');await page.screenshot({path:'tests/screens/about.png'});\n \\\"\\\"\\\"\ns=s.replace(needle,extra+needle);p.write_text(s)\np=Path('build.mjs');s=p.read_text().replace(\\\"scripts.map(f=>\"'`<script src='\"\\\\\\\"../\"'${f}'\"\\\\\\\"></script>\"'`)\",\"scripts.map(f=>(f==='\"'game/main.js'?\"'`<script>G.ABOUT=${escape(JSON.stringify(interview))};</script>`:'\"'')+\"'`<script src='\"\\\\\\\"../\"'${f}'\"\\\\\\\"></script>\"'`)\");p.write_text(s)\nPY\nnode tests/run.mjs browser'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
