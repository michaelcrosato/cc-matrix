;b=s.index('class Menu',a);s=s[:a]+s[a:b].replace(\\\"shadow: '#05040a'\\\",\\\"shadow: this.shadow === undefined ? '#05040a' : this.shadow\\\")+s[b:];p.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"cat > game/core.js <<'EOF'\n/* Wee Serene — Institute for Gentle Improvement. */\n(() => {\n'use strict';\nconst E = My3D2dge;\nconst G = window.G = { E, title: 'Wee Serene', scenes: {}, activities: {}, families: {}, mode: 'story', sceneName: 'title', source: 'keyboard', lastKey: -99, idle: 0, attracting: false, time: 0, slot: 0, context: null, visited: new Set(), issues: [], version: 1 };\nconst D = E.Input.DEFAULT;\nG.INPUT = { up:D.up, down:D.down, left:D.left, right:D.right, start:D.start, pause:D.pause, confirm:D.confirm, cancel:D.cancel,\n breath:['Space','Mouse0','Pad6','Pad7'], catchL:['KeyQ','Mouse0','Pad4'], catchR:['KeyE','Mouse2','Pad5'], jump:['Space','Pad0'], interact:['KeyE','Enter','Pad0'], more:['Tab','KeyM','Pad3'], retry:['KeyR','Pad2'], paceL:['KeyJ','Mouse0','Pad6'], paceR:['KeyK','Mouse2','Pad7'], stepL:['KeyA','ArrowLeft','Mouse0','Pad14','PadAxisLeft'], stepR:['KeyD','ArrowRight','Mouse2','Pad15','PadAxisRight'], stepU:['KeyW','ArrowUp','WheelUp','Pad12','PadAxisUp'], stepD:['KeyS','ArrowDown','WheelDown','Pad13','PadAxisDown'] };\nG.CLASS_INPUT = {up:D.up,down:D.down,left:D.left,right:D.right,start:D.start,pause:D.pause,confirm:D.confirm,cancel:D.cancel,breath:['Space','Pad6','Pad7'],catchL:['KeyQ','Pad4'],catchR:['KeyE','Pad5']};\nG.palette = {paper:'#f6fafa',ink:'#20404c',muted:'#607d84',cyan:'#14aec3',mint:'#bfeee0',coral:'#ff7a59',oak:'#d9b68a',maple:'#ecd3ac',sea:'#49b6c9',gold:'#eab858',line:'#c9dfe0'};\nG.DEFS = [\n ['k','Responsiveness',1,25,.5,1,'Lean'],['c','Damping',1,14,.25,1,'Lean'],['s','Instability',0,2,.05,1,'Lean'],['A','Tremble',0,2,.05,1,'Lean'],['nf','Tremble speed',.2,3,.1,1,'Lean'],['ring','Ring size',.5,2,.05,1,'Lean'],['push','Push strength',0,2,.1,1,'Lean'],['threshold','Stumble edge',.6,1.6,.05,1,'Lean'],['reach','Mouse reach',.15,.6,.01,.33,'Lean'],['nudge','Key nudge',1,4,.1,2.2,'Lean'],\n ['star1','One star',.1,.6,.01,.35,'Scoring'],['star2','Two stars',.5,.9,.01,.65,'Scoring'],['star3','Three stars',.75,1,.01,.90,'Scoring'],['repTolerance','Rep tolerance',.03,.2,.01,.08,'Scoring'],['rhythmWindow','Beat window',.5,2,.1,1,'Scoring'],['fatigue','Fatigue',0,2,.1,1,'Scoring'],\n ['hoopLow','Hoop low',3,10,.25,7,'Cardio'],['hoopHigh','Hoop high',10,18,.25,11,'Cardio'],['jogLow','Cadence low',1,3,.1,2.6,'Cardio'],['jogHigh','Cadence high',3,5,.1,3.4,'Cardio'],['jogSpeed','Jog speed',.5,2,.1,1,'Cardio'],\n ['slalomSpeed','Ski speed',100,400,10,220,'Games'],['slalomTurn','Ski turn',50,300,10,165,'Games'],['gravity','Tray gravity',100,800,20,420,'Games'],['friction','Tray friction',.1,3,.1,1.5,'Games'],['rope','Rope instability',8,22,.5,16,'Games'],['gust','Gust strength',0,15,.5,9,'Games'],['timeScale','Time scale',0,3,.25,1,'World'],['minutes','Minutes earned',.5,5,.25,1,'World']\n];\nG.DEV = Object.fromEntries(G.DEFS.map(d=>[d[0],d[5]]));\nG.dev = {open:false,group:'Tools',row:0,page:0,bot:null,noFalls:false,trace:false,frame:false,pose:'111_39_part1',poseTime:4,day:1,tier:1,stars:3};\nG.resetDev = () => {for(const d of G.DEFS)G.DEV[d[0]]=d[5];G.dev.bot=null;G.dev.noFalls=false;G.dev.trace=false;G.dev.frame=false;};\nG.clone = o => JSON.parse(JSON.stringify(o));\nG.memberDefault = () => ({version:1,name:'Gentle Doug',avatar:{hair:'short',skin:0,top:0,bottom:0,hat:0},instructor:'Birch',day:1,sessions:0,minutes:0,best:{},spineAge:71,history:[71],ended:false,checked:false,arrived:false,duelWin:false,tareDay:false,lastVisit:Date.now(),dailyScores:[]});\nG.member=G.memberDefault();\nG.rng=E.rng(1287);\nG.activity = spec => { G.activities[spec.id]=spec; };\nG.stars = (pct, a) => {const t=a && a.stars || [G.DEV.star1,G.DEV.star2,G.DEV.star3];return t.reduce((n,x)=>n+(pct+1e-6>=x),0);};\nG.best = (id,tier=1) => G.member.best[id+'-'+tier] || {stars:0,pct:0};\nG.suggestion = () => {const choices=Object.values(G.activities).filter(a=>a.day<=G.member.day);return choices[(G.member.day*7-7)%choices.length]?.id || 'stork';};\nG.calculateAge = (m=G.member) => {let sum=0;for(const discipline of ['Stillness','Strength','Cardio','Balance']){const aa=Object.values(G.activities).filter(a=>a.discipline===discipline);sum+=aa.reduce((n,a)=>n+(m.best[a.id+'-1']?.stars||0)*100/3,0)/aa.length;}return Math.min(71,Math.round(78-.58*sum/4))-(m.duelWin?1:0);};\nG.unlocked = (a,tier=1) => G.member.ended || (a.day<=G.member.day && (tier===1 || (G.member.day>=4 && G.best(a.id).stars>=2)));\nG.persist = () => {if(\"'!G.inSession&&!G.attracting){G.member.lastVisit=Date.now();G.game.saves.save(G.slot);}};\nG.loadMember = slot => {const saved=G.game.saves.load(slot);if(saved){G.slot=slot;return true;}return false;};\nG.refreshAge = () => {if(G.member.day!==3)G.member.spineAge=G.calculateAge();};\nG.record = (ctx) => {\n const c=ctx.contestants[0], a=ctx.a, pct=E.clamp(a.result(ctx,c).pct,0,1), stars=G.stars(pct,a);const out={pct,stars,detail:a.result(ctx,c).detail,minutes:ctx.duration/60*(1+.25*stars)*(a.id===G.suggestion()?1.5:1)*G.DEV.minutes};\n if(!G.attracting && !G.inSession && G.mode!=='\"'class') {const key=a.id+'-'+ctx.tier, old=G.best(a.id,ctx.tier);if(pct>=old.pct)G.member.best[key]={pct,stars};G.member.minutes+=out.minutes;G.refreshAge();G.persist();}\n return out;\n};\nG.go = (name,data,instant=false) => {G.sceneName=name;G.visited.add(name);G.dev.open=false;G.game.go(name,data,{fade:instant?0:'iris',seconds:.28});};\nG.settings = () => {G.game.shell.show('settings');};\nG.inSession=\"'!!(window.AIHub&&window.AIHub.active);\nconst game = G.game = new E.Game({canvas:'\"'screen',id:'wee-serene-20261104',res:'ps1',expand:true,view:'brawler',views:['brawler','threequarter','side'],input:G.INPUT,touch:'never',autoPause:\"'!G.inSession,live:G.inSession,fullscreen:G.inSession?false:'\"'button',draw:true,\n menu:{quit:G.inSession?false:'title',items:G.inSession?[]:[['Restart session',()=>{game.shell.hide();if(G.context)G.startSession(G.context.a.id,G.context.tier,G.mode);}],['Dev Mode',()=>{game.shell.hide();game.paused=false;G.dev.open=true;}]],\n settings:[{key:'music',value:.1},{key:'glyphs',value:'playstation'},{key:'voice',label:'Voice',type:'slider',min:0,max:1,step:.05,value:.65,group:'Sound'},{key:'gentle',label:'Gentle Mode',value:false,group:'Game'},{key:'breathToggle',label:'Breath toggle',value:false,group:'Game'},{key:'tips',label:\\\"Tare's tips\\\",value:true,group:'Game'}],\n controls:{breath:'Breathe / effort',catchL:'Catch left',catchR:'Catch right',interact:'Talk / choose mat',more:'Activity directory',paceL:'Jog left step',paceR:'Jog right step',stepL:'Step left',stepR:'Step right',stepU:'Step forward',stepD:'Step back',retry:false,jump:'Jump'}}});\nwindow.__game=game;\nnew E.Shell(game,{theme:{ink:G.palette.ink,paper:G.palette.paper,accent:G.palette.cyan,muted:G.palette.muted,danger:'#d65c45',line:G.palette.line,font:'system-ui, sans-serif',titleFont:'system-ui, sans-serif'}});\ngame.saves.slots=3;game.saves.canSave=false;\ngame.saves.write=()=>({data:G.clone(G.member),place:'Day '+G.member.day+' · Lumbar Island',level:G.member.day});\ngame.saves.read=s=>{const m=s.data;if(\"'!m||m.version!==1||!m.best||!Number.isFinite(m.day))return;G.member=Object.assign(G.memberDefault(),G.clone(m));G.member.avatar=Object.assign(G.memberDefault().avatar,m.avatar||{});G.slot=s.slot;};\nG.canvas = typeof document!=='\"'undefined' ? document.getElementById('screen') : null;\nif(typeof document\"'!=='\"'undefined'){\n document.addEventListener('keydown',()=>{G.lastKey=game.input.clock;G.source='keyboard';});\n document.addEventListener('pointerover',e=>{const b=e.target.closest&&e.target.closest('.esh-sh button:not(:disabled), .esh-sh input:not(:disabled)');if(b&&e.pointerType==='mouse')b.focus({preventScroll:true});});\n}\ngame.debug={snapshot(){const ctx=G.context,c=ctx?.contestants[0];return {scene:G.sceneName,activity:ctx?.a.id||null,tier:ctx?.tier||1,phase:G.sessionPhase||null,day:G.member.day,session:G.member.sessions,pct:c?ctx.a.result(ctx,c).pct:0,stars:G.result?.stars||0,minutes:G.member.minutes,spineAge:G.member.spineAge,lean:c?[c.bal.x,c.bal.y]:[0,0],source:G.source,attract:G.attracting,attractItem:G.attractItem,dev:G.dev.open,ended:G.member.ended,errors:game.errors.length};}};\n})();\nEOF\ncat > game/data/activities.js <<'EOF'\n(() => {\nconst G=window.G;\nconst defs=[\n ['stork','Stork Stand','Stillness','hold',1,45,[12,5,13,3,1.5,.24],[11,4.5,15,3.6,1.7,.22],'Keep your dot inside the ring. The gull has other plans.','Lean in small nudges. Return before you wobble.','stork','deck',true],\n ['flow','Sun Flow','Stillness','hold',2,80,[12,6,6,3.2,1.3,.28],[12,5.8,9,3.6,1.5,.25],'Balance through five poses. Breathe with the growing ring.','Hold to breathe in. Release to breathe out.','lunge','deck',false],\n ['candle','Quiet Candle','Stillness','candle',3,60,[10,5,11,1.4,.8,.20],[10,5,12,1.8,1,.20],'Protect the flame. Slow corrections beat sudden movements.','Keep still, but stay present. Thoughts can move you.','meditate','raft',true],\n ['squat','Squat Rail','Strength','rep',1,32,[16,8,0,.7,1,.25],[16,8,0,1,1.3,.23],'Follow the bead down and up. Your lean is your squat.','Lean back to lower. Release slowly to stand.','squat','iron',true],\n ['pushup','Push-Up','Strength','rep',2,24,[16,8,0,.7,1,.25],[16,8,0,1,1.3,.23],'Lower with the bead. Keep your shoulders square.','Lean back to lower. Hold halfway to stay halfway.','pushup','iron',false],\n ['lunge','Side Lunge','Strength','rep',3,32,[16,8,0,.7,1,.25],[16,8,0,1.1,1.2,.23],'Move side to side with the bead. Feet stay planted.','Lean left and right. Stay level on the other axis.','lunge','iron',false],\n ['step','Step Class','Cardio','step',1,60,[12,6,3,1,1,.28],[12,6,3,1,1,.26],'Press each direction as its arrow reaches the white line.','Left, right. The bench is not going anywhere.','step','pier',true],\n ['hoop','Hoop Hips','Cardio','hoop',2,60,[12,6,2,.4,1,.3],[12,6,3,.6,1,.27],'Circle your lean. Catch extra hoops when they arrive.','Keep a steady circle. Change direction halfway.','hoop','pier',true],\n ['jog','Coastal Jog','Cardio','jog',3,70,[12,6,2,.4,1,.3],[12,6,3,.6,1,.27],'Alternate steps. Stay beside Marisol and collect water.','J then K. Lean to steer. Rushing gives you a stitch.','run','coast',false],\n ['slalom','Mount Posture Slalom','Balance','slalom',3,60,[12,6,2,.5,1,.3],[12,6,3,.7,1,.27],'Weave through all eighteen gates. Tuck to gain speed.','Lean left or right. Forward tucks. Back brakes.','ski','mountain',false],\n ['tray','Tray Service','Balance','tray',1,60,[14,7,0,.1,1,.3],[14,7,0,.25,1,.3],'Tilt olives into the glasses. Three trays await.','Tip gently toward a glass. Bumpers do not forgive.','idle','bar',false],\n ['laundry','Laundry Line','Balance','laundry',2,70,[10,3.5,16,3.5,1.2,.4],[10,3.5,17,3.8,1.3,.36],'Cross three spans. Balance against gusts and jump the pegs.','Lean to balance. Hold effort to walk. Tap to jump.','rope','laundry',false]\n];\nfor(const [id,name,discipline,family,day,duration,b1,b2,rule,hint,pose,room,cl] of defs){\n const param=b=>Object.fromEntries(['k','c','s','A','nf','R'].map((k,i)=>[k,b[i]]));\n G.activity({id,name,discipline,family,day,duration,rule,hint,pose,room,class:cl,hub:true,view:family==='laundry'?'side':'brawler',camera:{zoom:false},tiers:[param(b1),param(b2)],stars: ['flow','step'].includes(id)?[.5,.75,.92]:null});\n}\nG.disciplines=[{id:'Stillness',color:'#56bda8',blurb:'The art of almost nothing.'},{id:'Strength',color:'#ef8a6b',blurb:'Small movements. Large feelings.'},{id:'Cardio',color:'#d9ad50',blurb:'A little more alive than before.'},{id:'Balance',color:'#719bc5',blurb:'The floor believes in you.'}];\n})();\nEOF\ncat > game/data/poses.js <<'EOF'\nwindow.G.POSES={\n stork:{clip:'111_39_part1',a:3.6,b:7,tgt:1.57},knee:{clip:'111_39_part2',a:.5,b:2.4,tgt:1.57},triangle:{clip:'111_39_part3',a:2.2,b:5.2,tgt:1.2},warrior:{clip:'111_39_part3',a:6.6,b:7.6,tgt:1.57},lunge:{clip:'111_38_part1',a:2.9,b:5,tgt:.25},dog:{clip:'111_38_part2',a:2.8,b:5.2,tgt:.25},fold:{clip:'111_38_part2',a:8,b:8.8,tgt:.25},plank:{clip:'111_41_part3',a:3.4,b:6.4,tgt:.25},meditate:{clip:'Meditate',a:.5,b:1,tgt:1.57},squat:{clip:'22_14',a:1.1,b:1.72,tgt:1.2},pushup:{clip:'Pushup',a:0,b:.9,tgt:.1},idle:{clip:'Idle_Subtle',a:0,b:2,tgt:1.57},run:{clip:'Run_Loop',a:0,b:.8,tgt:-1.57},step:{clip:'Idle_Subtle',a:0,b:1,tgt:1.57},hoop:{clip:'Idle_Subtle',a:0,b:1,tgt:1.57},ski:{clip:'Idle_Subtle',a:0,b:1,tgt:-1.57},rope:{clip:'Walk_Loop',a:0,b:1,tgt:.1}\n};\nEOF\ncat > game/data/days.js <<'EOF'\nwindow.G.DAYS=[\n {name:'Orientation',morning:'Oh\"'! Feet. Good morning, feet.'\"',evening:'You have completed your first day. I have saved all of it.'},\n {name:'Improvement',morning:\\\"You came back. I wasn't worried. I was just standing here, on the floor, where I live.\\\",evening:'Gertrude nodded at you today. We do not give that out lightly.'},\n {name:'The Plateau',morning:'We call this the plateau. It is on the map. You cannot go around it.',evening:'A number stayed still. You did not. I noticed.'},\n {name:\\\"Tare's Day\\\",morning:'I have been recalibrating. Today your Spine Age can catch up.',evening:'Thank you for weighing me. It is nice to be counted.'},\n {name:'The Gentle Games',morning:'The bunting is up. Even the goose looks prepared.',evening:'You are more than your number. Please do not tell the number.'}\n];\nwindow.G.UNLOCKS=[[5,'Towel'],[10,'Headband'],[15,'Sunhat'],[20,\\\"Tare's bow tie\\\"],[25,\\\"Gertrude's spare hat\\\"],[30,\\\"Gerald's friend\\\"]];\nwindow.G.NAMES=['Gentle Doug','Sir Slouch','Ms. Almost','The Other Pat','Small Triumph','Captain Nearly','Steady Eddie','Dear Robin','Good Enough','Patient Sam','Little Sway','Soft Landing','Dr. Perhaps','Early Lou','Quiet Feet','Kindly Kit'];\nEOF\ncat > game/data/charts.js <<'EOF'\nwindow.G.CHARTS=[\n {parts:{A:['....x.......x...','.','.','........x.......'],B:['....x...x...x...','.','.','......x...x...x.']},order:'A A B A A A B A A A B A A A B A A A B A A A B A A'},\n {parts:{A:['....x.......x...','......x.........','..........x.....','........x.......'],B:['....x...x.......','......x.......x.','..........x.....','............x...']},order:'A A B A A B A B A A B A A B A B A A B A A B A B A A B A A B'}\n];\nEOF\ncat > game/data/courses.js <<'EOF'\nwindow.G.COURSES={gates:[0,-130,120,220,-120,-220,100,-150,160,0,220,-180,-60,180,-220,120,-100,0],spacing:670,par:55,worst:112,cups:[-.6,.4,-.3,.6,0,-.5,.4,.1],pegs:[.19,.47,.78]};\nEOF\ncat > game/data/trays.js <<'EOF'\nwindow.G.TRAYS=[\n ['#################','#...............#','#.o.....o.....o.#','#...............#','#...............#','#...............#','#...............#','#.g.....g.....g.#','#################'],\n ['#################','#.o..o..o..o..o.#','#...............#','#....B.....B....#','#...............#','#...B.....B.....#','#...............#','#.g..g..g..g..g.#','#################'],\n ['#################','#.o.o..o.o..o.o.#','#.......o.......#','#..B.........B..#','#.......L.......#','#....B.....B....#','#...............#','#.g.g.g.g.g.g.g.#','#################']\n];\nEOF\ncat > game/data/README.md <<'EOF'\n# Designer data\n\nActivities are registry rows in activities.js. Set the family, discipline, unlock day, duration, two Lean parameter sets, instruction and room. Every family supplies setup, update, drawing, scoring and bot intent. Add poses in poses.js using a bundled mocap clip and a safe time window. Add dialogue in lines.js; arrays are line banks, selected with seeded randomness. Days and unlocks live in days.js. Charts use four lanes (left, down, up, right), one character per sixteenth note. Courses define gate offsets, water positions and peg progress. Trays are ASCII: # wall, o olive, g glass, B bumper, L gecko. The build embeds these files without a network dependency. Run \"'`node tests/run.mjs rules` after edits.\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('engine/my-3d2dge.js');s=p.read_text();a=s.index('class Dialog');b=s.index('class Menu',a);s=s[:a]+s[a:b].replace(\\\"shadow: '#05040a'\\\",\\\"shadow: this.shadow === undefined ? '#05040a' : this.shadow\\\")+s[b:];p.write_text(s)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"cat > game/balance.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,{clamp,approach}=E;\nG.noise=(rng,f)=>{const p=[rng()*6.283,rng()*6.283,rng()*6.283];return t=>(Math.sin(t*f+p[0])+.6*Math.sin(t*f*1.73+p[1])+.35*Math.sin(t*f*2.61+p[2]))/1.3;};\nG.Balance=class {\n constructor(params,rng=E.rng(1)){this.params={...params};this.x=0;this.y=0;this.vx=0;this.vy=0;this.t=0;this.falls=0;this.stumble=0;this.inside=0;this.total=0;this.streak=0;this.target=[0,0];this.trail=[];this.hist=[];this.nx=G.noise(rng,params.nf);this.ny=G.noise(rng,params.nf*1.13);}\n step(dt,intent,opts={}){\n  this.t+=dt;let p=this.params;const gentle=G.game.settings.gentle;\n  const k=p.k*(G.DEV.k/12),c=p.c*(G.DEV.c/5),s=(opts.s===undefined?p.s:opts.s)*G.DEV.s*(gentle?.7:1),A=p.A*G.DEV.A*(gentle?.7:1),r=p.R*G.DEV.ring*(gentle?1.25:1);\n  if(this.stumble>0){this.stumble-=dt;this.x*=Math.exp(-dt*8);this.y*=Math.exp(-dt*8);this.vx=this.vy=0;}\n  else {\n   const fx=(opts.fx||0)*G.DEV.push,fy=(opts.fy||0)*G.DEV.push;\n   this.vx+=(k*(intent.x-this.x)-c*this.vx+(opts.mainX?0:s)*this.x+A*this.nx(this.t*G.DEV.nf)+fx)*dt;\n   this.vy+=(k*(intent.y-this.y)-c*this.vy+(opts.mainY?0:s)*this.y+A*this.ny(this.t*G.DEV.nf)+fy)*dt;\n   this.x+=this.vx*dt;this.y+=this.vy*dt;\n   if(\"'!opts.noFalls&&!G.dev.noFalls&&Math.hypot(this.x,this.y)>=G.DEV.threshold){this.falls++;this.stumble=1;this.streak=0;opts.fall?.();}\n   if(opts.noFalls){this.x=clamp(this.x,-1,1);this.y=clamp(this.y,-1,1);}\n  }\n  const inside=Math.hypot(this.x-this.target[0],this.y-this.target[1])<=r&&this.stumble<=0;\n  if(inside){this.inside+=dt;this.streak+=dt;}else this.streak=0;\n  this.total+=dt;this.inRing=inside;this.radius=r;\n  if(!this.trail.length||this.t-this.trail[this.trail.length-1].t>.04)this.trail.push({x:this.x,y:this.y,t:this.t});while(this.trail[0]&&this.t-this.trail[0].t>1)this.trail.shift();\n  this.hist.push({x:this.x,y:this.y,vx:this.vx,vy:this.vy,t:this.t});while(this.hist[0]&&this.t-this.hist[0].t>.6)this.hist.shift();\n }\n get steadiness(){return this.total?this.inside/this.total:0;}\n};\nG.DEV.k=12;G.DEFS.find(d=>d[0]==='\"'k')[5]=12;G.DEV.c=5;G.DEFS.find(d=>d[0]==='c')[5]=5;\nG.BOTS={poor:{tau:.34,gain:1.1,damp:.22,noise:.16},average:{tau:.25,gain:1.4,damp:.30,noise:.08},good:{tau:.18,gain:1.8,damp:.36,noise:.04},expert:{tau:.14,gain:2.2,damp:.42,noise:.02}};\nG.balanceBot=(c,skill,dt)=>{\n const b=c.bal,q=G.BOTS[skill]||G.BOTS.expert;let seen=b.hist.find(h=>h.t>=b.t-q.tau)||b;\n const tx=-q.gain*(seen.x-b.target[0])-q.damp*seen.vx+b.target[0]*(1-b.params.s/b.params.k)+q.noise*Math.sin(b.t*2.1+c.seed),ty=-q.gain*(seen.y-b.target[1])-q.damp*seen.vy+b.target[1]*(1-b.params.s/b.params.k)+q.noise*Math.sin(b.t*1.7+c.seed+1);\n c.intent.x+=(tx-c.intent.x)*Math.min(1,dt*16);c.intent.y+=(ty-c.intent.y)*Math.min(1,dt*16);const n=Math.hypot(c.intent.x,c.intent.y);if(n>1){c.intent.x/=n;c.intent.y/=n;}return c.intent;\n};\nG.emptyIntent=()=>({x:0,y:0,effort:0,breath:0,catchL:false,catchR:false,jump:false,paceL:false,paceR:false,steps:[false,false,false,false],source:'keyboard',touched:false});\nG.readIntent=(c,dt,ctx)=>{\n const I=c.input||G.game.input,v=c.intent,m=I.move();\n const recentMouse=I.mouse?.active&&I.mouse.t>G.lastKey;\n let source=I.lastDevice==='gamepad'?'gamepad':recentMouse?'mouse':'keyboard';\n if(source==='gamepad'){v.x=m[0];v.y=-m[1];}\n else if(source==='mouse'){\n  const p=I.pointer();if(p && \"'!(G.dev.open&&p[0]<G.game.W*.39)){v.x=clamp((p[0]-G.game.W/2)/(G.game.H*G.DEV.reach),-1,1);v.y=clamp((G.game.H/2-p[1])/(G.game.H*G.DEV.reach),-1,1);}\n }else{\n  const devArrow=G.dev.open;\n  const dx=devArrow?((I.keys?.has?.('\"'KeyD')?1:0)-(I.keys?.has?.('KeyA')?1:0)):m[0];\n  const dy=devArrow?((I.keys?.has?.('KeyS')?1:0)-(I.keys?.has?.('KeyW')?1:0)):m[1];\n  v.x=dx?clamp(v.x+dx*G.DEV.nudge*dt,-1,1):approach(v.x,0,.5*dt);v.y=dy?clamp(v.y-dy*G.DEV.nudge*dt,-1,1):approach(v.y,0,.5*dt);\n }\n const n=Math.hypot(v.x,v.y);if(n>1){v.x/=n;v.y/=n;}\n const held=I.down('breath');if(G.game.settings.breathToggle&&I.pressed('breath'))c.breathHeld=\"'!c.breathHeld;\n const bh=G.game.settings.breathToggle?c.breathHeld:held;\n v.breath=source==='\"'gamepad'?I.value('breath'):approach(v.breath,bh?1:0,dt/4);\n v.effort=source==='gamepad'?I.value('breath'):(held?.6:0);\n v.catchL=I.pressed('catchL');v.catchR=I.pressed('catchR');v.jump=I.pressed('jump')||I.pressed('confirm');v.paceL=I.pressed('paceL');v.paceR=I.pressed('paceR');\n const lanes=G.mode==='class'?['left','down','up','right']:['stepL','stepD','stepU','stepR'];v.steps=lanes.map(a=>I.pressed(a));\n if(I.anyPressed||Math.hypot(m[0],m[1])>.05||recentMouse)v.touched=true;\n v.source=source;if(c===ctx?.contestants[0])G.source=source;return v;\n};\nG.drawPlate=(g,x,y,b,radius=26,hidden=false)=>{\n const {px}=E,P=G.palette;px.ell(g,x+1,y+3,radius+2,radius+1,'#bed6d6');px.disc(g,x,y,radius+1,'#e2eff0');px.disc(g,x,y,radius,'#ffffff');\n if(hidden){E.font.text(g,'?',x,y-3,P.muted,{align:'center',outline:false});return;}\n const scale=radius*.80,tx=b.target[0]*scale,ty=-b.target[1]*scale,rr=(b.radius||b.params.R)*scale;\n px.line(g,x-scale,y,x+scale,y,'#edf3f4');px.line(g,x,y-scale,x,y+scale,'#edf3f4');\n px.disc(g,x+tx,y+ty,rr+2,b.inRing?'#a3ddcd':'#cadde2');px.disc(g,x+tx,y+ty,Math.max(1,rr),b.inRing?'#d9f5ea':'#f1f8f8');\n for(const t of b.trail){const age=(b.t-t.t);px.disc(g,x+t.x*scale,y-t.y*scale,age<.3?1.5:1,age<.4?'#9fd7d8':'#dbe8e8');}\n px.disc(g,x+b.x*scale,y-b.y*scale,3,b.stumble>0?P.coral:P.ink);px.dot(g,x+b.x*scale-1,y-b.y*scale-1,'#ffffff');\n if(b.streak>2){for(let i=0;i<4;i++){const a=i*Math.PI/2+b.t*.5;px.dot(g,x+Math.cos(a)*(radius-3),y+Math.sin(a)*(radius-3),P.cyan);}}\n};\n})();\nEOF\ncat > game/rigs.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,{px,V3}=E;\nG.lib=Mocap.load(window.MOCAP.FITCLIPS);\nG.SKINS=['#efbd91','#d3976c','#9f6748','#754a36','#f6d7b6','#bb835c'];G.TOPS=['#ff7a59','#5aafaa','#b398c7','#e8bd64','#699cc0','#dc839f','#6a7b88','#e6e9d9'];G.BOTTOMS=['#455e68','#7a7970','#5f6b9a','#9c7774'];G.HAIRS=['short','spiky','long','ponytail','bald'];\nG.makeRig=(opts={})=>{const rig=new E.Humanoid(Object.assign({weapon:null,build:'chibi',outfit:'shirt',sleeves:'short',size:1.9,colors:{skin:G.SKINS[0],cloth:G.TOPS[0],pants:G.BOTTOMS[0],hair:'#655147',boot:'#f8faf2',trim:'#fbe4bd',belt:'#455e68',glove:G.SKINS[0]}},opts));Mocap.drive(rig,G.lib);const base=rig.solvePose;rig.wob=[0,0];rig.body=null;\n rig.solvePose=function(){base.call(this);if(this.body)G.setBody(this,this.body(this));const [ax,ay]=this.wob;if(\"'!ax&&!ay)return;const a=ax*.45,b=ay*.3,ca=Math.cos(a),sa=Math.sin(a),cb=Math.cos(b),sb=Math.sin(b);for(const key in this.J){if(key==='\"'bladeDir'||\"'!this.J[key])continue;const p=this.J[key],r=p[1]*ca+p[2]*sa,z=-p[1]*sa+p[2]*ca;const f=p[0]*cb+z*sb;p[2]=Math.max(-p[0]*sb+z*cb,0);p[0]=f;p[1]=r;}};return rig;};\nG.playerRig=(size=1.9)=>{const a=G.member.avatar;return G.makeRig({size,hair:G.HAIRS[G.HAIRS.indexOf(a.hair)]||'\"'short',hat:a.hat===1?{style:'band',color:'#f2e7a2'}:a.hat>=2?{style:'cap',color:a.hat===3?'#b398c7':'#e8c987'}:null,colors:{skin:G.SKINS[a.skin],hair:'#625047',cloth:G.TOPS[a.top],pants:G.BOTTOMS[a.bottom],boot:'#f6fafa',trim:'#ffffff',belt:'#536d73',glove:G.SKINS[a.skin]}});};\nG.instructorRig=(name=G.member.instructor,size=1.9)=>{const wood=name==='Alder'?'#ecd3ac':'#c69d70';return G.makeRig({size,build:'heroic',limbW:1.5,torsoW:2.5,hair:name==='Alder'?'ponytail':'bald',wood:true,colors:Object.fromEntries(['skin','hair','cloth','coat','pants','boot','belt','trim','glove','eye','iris'].map(k=>[k,k==='eye'||k==='iris'?'#7f633f':wood]))});};\nG.regulars=[['Gertrude','#b398c7','long',4],['Dennis','#e8bd64','bald',1],['Marisol','#5aafaa','ponytail',3],['Young Kevin','#699cc0','spiky',0],['Mr. Okafor','#dc839f','short',2],['Lou','#99a3a3','bald',1],['Twin One','#aab9a1','short',0],['Twin Two','#9ab8cd','short',0]];\nG.regularRig=(i,size=1.4)=>{const r=G.regulars[i%G.regulars.length];return G.makeRig({size,hair:r[2],hat:i===0?{style:'cap',color:'#ecd99e'}:i===2?'band':null,colors:{skin:G.SKINS[r[3]],cloth:r[1],hair:'#d4d4c4',pants:'#6a747e',boot:'#f6fafa',belt:'#64777a',trim:'#f5ead2',glove:G.SKINS[r[3]]}});};\nG.setBody=(rig,b)=>{const o=rig.o,J=rig.J,hip=b.hip;J.hipC=hip;J.hipL=V3.add(hip,[0,-o.hipHalf,0]);J.hipR=V3.add(hip,[0,o.hipHalf,0]);for(const s of [-1,1]){const h=s>0?J.hipR:J.hipL,f=s>0?b.footR:b.footL,[k,ff]=E.ik3(h,f,o.legUpper,o.legLower,b.knee?b.knee(s):[1,s*.3,.1]);J[s>0?'kneeR':'kneeL']=k;J[s>0?'footR':'footL']=ff;}const dir=V3.norm(b.chest||[0,0,1]),sh=V3.add(hip,V3.mul(dir,o.torso));J.shC=sh;J.shL=V3.add(sh,[0,-o.shoulderHalf,0]);J.shR=V3.add(sh,[0,o.shoulderHalf,0]);J.head=V3.add(sh,V3.mul(V3.norm([dir[0],dir[1],dir[2]+.4]),o.neck+o.headR));for(const s of [-1,1]){const h=s>0?J.shR:J.shL,target=(s>0?b.handR:b.handL)(sh,h),[el,hh]=E.ik3(h,target,o.armUpper,o.armLower,[-1,s*.7,-.2]);J[s>0?'elbowR':'elbowL']=el;J[s>0?'handR':'handL']=hh;}};\nG.sideLunge=u=>r=>({hip:[0,u*3.8,r.o.hipZ-Math.abs(u)*r.o.hipZ*.4],footL:[.5,-r.o.footSpread-5.4,0],footR:[.5,r.o.footSpread+5.4,0],knee:s=>[1,s*.7,.1],chest:[.28*Math.abs(u),-u*.1,1],handL:c=>V3.add(c,[4,-.6,-2.6]),handR:c=>V3.add(c,[4,.6,-2.6])});\nG.hula=ph=>r=>{const hx=Math.cos(ph)*2.1,hy=Math.sin(ph)*2.1;return {hip:[hx,hy,r.o.hipZ-.5],footL:[.3,-r.o.footSpread-1,0],footR:[.3,r.o.footSpread+1,0],chest:[-hx*.22,-hy*.22,1],handL:(c,s)=>V3.add(s,[.4,-6,1.6+Math.sin(ph)*.6]),handR:(c,s)=>V3.add(s,[.4,6,1.6-Math.sin(ph)*.6])};};\nG.stepUp=(k,zb=5)=>r=>({hip:[.2+k*1.2,k*1.6,r.o.hipZ+k*zb*.7],footL:[k>.5?3:-1,-r.o.footSpread,k>.85?zb:0],footR:[3,r.o.footSpread,zb*Math.min(1,k*2)],chest:[.1,0,1],handL:(c,s)=>V3.add(s,[1+k*3,-1.2,-3+k*2]),handR:(c,s)=>V3.add(s,[3-k*3,1.2,-1-k*2])});\nG.poseRig=(rig,pose,time,opts={})=>{const p=G.POSES[pose]||G.POSES.idle;let ct=opts.scrub===undefined?p.a+(p.b-p.a)*.3*(.5+.5*Math.sin(time*.7)):p.a+(p.b-p.a)*opts.scrub;\n if(['run','rope','idle'].includes(pose))ct=time;\n if(opts.clip)rig.mocap=G.lib.sample(opts.clip,time);else rig.mocap=G.lib.sample(p.clip,ct);\n rig.wob=opts.wob||[0,0];rig.body=opts.body||null;\n rig.update(opts.dt||1/120,{x:opts.x||0,y:opts.y||0,z:opts.z||0,vx:0,vy:0,facing:(opts.facing===undefined?p.tgt:opts.facing)-(rig.spin||0),pose:pose==='ski'?'crouch':undefined,expr:opts.fall?'wince':'smile'});\n};\nG.drawRig=(r,rig,x,y,z=0,opts={})=>{r.shadow(x,y,rig.o.size*5,.12);r.actor(x,y,z,(g,ox,oy)=>{rig.draw(g,ox,oy,r.view);if(rig.o.wood){for(const k of ['kneeL','kneeR','elbowL','elbowR','shL','shR']){const w=rig.worldOffset(rig.J[k]),p=(rig.lastView||r.view).p(w[0],w[1],w[2]);px.disc(g,ox+p[0],oy+p[1],2.6,'#ad8459');px.disc(g,ox+p[0]-.5,oy+p[1]-.5,1.5,'#ebd3ae');}}},opts);};\nG.drawTare=(g,x,y,scale=1,face='happy',time=G.time)=>{const s=scale,b=Math.sin(time*4),h=Math.max(0,b)*2*s;px.ell(g,x,y+2,13*s,3*s,'#b3cccf');y-=h;\n const rect=(a,b,w,h,c)=>px.rect(g,x+a*s,y+b*s,w*s,h*s,c);rect(-11,0,4,3,'#577c88');rect(7,0,4,3,'#577c88');rect(-14,-12,28,13,'#c0d8dc');rect(-14,-14,28,12,'#fcffff');rect(-12,-13,24,9,'#eaf4f5');px.ell(g,x-6*s,y-9*s,3*s,1.4*s,'#cadfe2');px.ell(g,x+6*s,y-9*s,3*s,1.4*s,'#cadfe2');rect(-4,-13,8,4,'#b1d7dc');rect(-3,-12,6,2,'#efffff');rect(-10,-4,20,4,'#365963');\n const eyes=face==='asleep'?1:face==='shocked'?3:2;rect(-6,-3,3,eyes,'#77e3e6');rect(3,-3,3,eyes,'#77e3e6');if(face==='worried'||face==='judging'){px.line(g,x-7*s,y-5*s,x-3*s,y-4*s,'#2e7180');px.line(g,x+3*s,y-4*s,x+7*s,y-5*s,'#2e7180');}\n if(G.member.minutes>=20){px.poly(g,[[x-3*s,y+1*s],[x,y+3*s],[x,y],[x+3*s,y+1*s],[x+3*s,y+4*s],[x,y+2*s],[x-3*s,y+4*s]],'#f29b8b');}\n};\nG.tare=(r,x,y,scale=1.2,face='happy')=>r.actor(x,y,0,(g,ox,oy)=>G.drawTare(g,ox,oy,scale,face),{outline:false});\nG.drawGerald=(g,x,y,s=1)=>{px.ell(g,x,y+3*s,14*s,3*s,'#cbd4db');px.ell(g,x,y-6*s,13*s,11*s,'#a3a7c2');px.ell(g,x-2*s,y-9*s,10*s,7*s,'#c6c7db');px.disc(g,x-9*s,y-17*s,3*s,'#b7bad1');px.disc(g,x+7*s,y-17*s,3*s,'#b7bad1');px.ell(g,x+1*s,y-4*s,12*s,5*s,'#b9bed4');px.disc(g,x-6*s,y-9*s,1*s,'#455465');px.disc(g,x+5*s,y-9*s,1*s,'#455465');px.line(g,x-4*s,y-16*s,x+3*s,y-16*s,'#5d657e',1);px.dot(g,x-8*s,y-12*s,'#f7f8fc');};\nG.bird=()=>new E.Blob({R:3,wings:true,feet:true,mouth:true,colors:{dk:'#9aadb8',base:'#ecf4f5',lt:'#ffffff',spec:'#ffffff',eye:'#274853',pupil:'#274853'}});\n})();\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"cat > game/balance.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,{clamp,approach}=E;\nG.noise=(rng,f)=>{const p=[rng()*6.283,rng()*6.283,rng()*6.283];return t=>(Math.sin(t*f+p[0])+.6*Math.sin(t*f*1.73+p[1])+.35*Math.sin(t*f*2.61+p[2]))/1.3;};\nG.Balance=class {\n constructor(params,rng=E.rng(1)){this.params={...params};this.x=0;this.y=0;this.vx=0;this.vy=0;this.t=0;this.falls=0;this.stumble=0;this.inside=0;this.total=0;this.streak=0;this.target=[0,0];this.trail=[];this.hist=[];this.nx=G.noise(rng,params.nf);this.ny=G.noise(rng,params.nf*1.13);}\n step(dt,intent,opts={}){\n  this.t+=dt;let p=this.params;const gentle=G.game.settings.gentle;\n  const k=p.k*(G.DEV.k/12),c=p.c*(G.DEV.c/5),s=(opts.s===undefined?p.s:opts.s)*G.DEV.s*(gentle?.7:1),A=p.A*G.DEV.A*(gentle?.7:1),r=p.R*G.DEV.ring*(gentle?1.25:1);\n  if(this.stumble>0){this.stumble-=dt;this.x*=Math.exp(-dt*8);this.y*=Math.exp(-dt*8);this.vx=this.vy=0;}\n  else {\n   const fx=(opts.fx||0)*G.DEV.push,fy=(opts.fy||0)*G.DEV.push;\n   this.vx+=(k*(intent.x-this.x)-c*this.vx+(opts.mainX?0:s)*this.x+A*this.nx(this.t*G.DEV.nf)+fx)*dt;\n   this.vy+=(k*(intent.y-this.y)-c*this.vy+(opts.mainY?0:s)*this.y+A*this.ny(this.t*G.DEV.nf)+fy)*dt;\n   this.x+=this.vx*dt;this.y+=this.vy*dt;\n   if(\"'!opts.noFalls&&!G.dev.noFalls&&Math.hypot(this.x,this.y)>=G.DEV.threshold){this.falls++;this.stumble=1;this.streak=0;opts.fall?.();}\n   if(opts.noFalls){this.x=clamp(this.x,-1,1);this.y=clamp(this.y,-1,1);}\n  }\n  const inside=Math.hypot(this.x-this.target[0],this.y-this.target[1])<=r&&this.stumble<=0;\n  if(inside){this.inside+=dt;this.streak+=dt;}else this.streak=0;\n  this.total+=dt;this.inRing=inside;this.radius=r;\n  if(!this.trail.length||this.t-this.trail[this.trail.length-1].t>.04)this.trail.push({x:this.x,y:this.y,t:this.t});while(this.trail[0]&&this.t-this.trail[0].t>1)this.trail.shift();\n  this.hist.push({x:this.x,y:this.y,vx:this.vx,vy:this.vy,t:this.t});while(this.hist[0]&&this.t-this.hist[0].t>.6)this.hist.shift();\n }\n get steadiness(){return this.total?this.inside/this.total:0;}\n};\nG.DEV.k=12;G.DEFS.find(d=>d[0]==='\"'k')[5]=12;G.DEV.c=5;G.DEFS.find(d=>d[0]==='c')[5]=5;\nG.BOTS={poor:{tau:.34,gain:1.1,damp:.22,noise:.16},average:{tau:.25,gain:1.4,damp:.30,noise:.08},good:{tau:.18,gain:1.8,damp:.36,noise:.04},expert:{tau:.14,gain:2.2,damp:.42,noise:.02}};\nG.balanceBot=(c,skill,dt)=>{\n const b=c.bal,q=G.BOTS[skill]||G.BOTS.expert;let seen=b.hist.find(h=>h.t>=b.t-q.tau)||b;\n const tx=-q.gain*(seen.x-b.target[0])-q.damp*seen.vx+b.target[0]*(1-b.params.s/b.params.k)+q.noise*Math.sin(b.t*2.1+c.seed),ty=-q.gain*(seen.y-b.target[1])-q.damp*seen.vy+b.target[1]*(1-b.params.s/b.params.k)+q.noise*Math.sin(b.t*1.7+c.seed+1);\n c.intent.x+=(tx-c.intent.x)*Math.min(1,dt*16);c.intent.y+=(ty-c.intent.y)*Math.min(1,dt*16);const n=Math.hypot(c.intent.x,c.intent.y);if(n>1){c.intent.x/=n;c.intent.y/=n;}return c.intent;\n};\nG.emptyIntent=()=>({x:0,y:0,effort:0,breath:0,catchL:false,catchR:false,jump:false,paceL:false,paceR:false,steps:[false,false,false,false],source:'keyboard',touched:false});\nG.readIntent=(c,dt,ctx)=>{\n const I=c.input||G.game.input,v=c.intent,m=I.move();\n const recentMouse=I.mouse?.active&&I.mouse.t>G.lastKey;\n let source=I.lastDevice==='gamepad'?'gamepad':recentMouse?'mouse':'keyboard';\n if(source==='gamepad'){v.x=m[0];v.y=-m[1];}\n else if(source==='mouse'){\n  const p=I.pointer();if(p && \"'!(G.dev.open&&p[0]<G.game.W*.39)){v.x=clamp((p[0]-G.game.W/2)/(G.game.H*G.DEV.reach),-1,1);v.y=clamp((G.game.H/2-p[1])/(G.game.H*G.DEV.reach),-1,1);}\n }else{\n  const devArrow=G.dev.open;\n  const dx=devArrow?((I.keys?.has?.('\"'KeyD')?1:0)-(I.keys?.has?.('KeyA')?1:0)):m[0];\n  const dy=devArrow?((I.keys?.has?.('KeyS')?1:0)-(I.keys?.has?.('KeyW')?1:0)):m[1];\n  v.x=dx?clamp(v.x+dx*G.DEV.nudge*dt,-1,1):approach(v.x,0,.5*dt);v.y=dy?clamp(v.y-dy*G.DEV.nudge*dt,-1,1):approach(v.y,0,.5*dt);\n }\n const n=Math.hypot(v.x,v.y);if(n>1){v.x/=n;v.y/=n;}\n const held=I.down('breath');if(G.game.settings.breathToggle&&I.pressed('breath'))c.breathHeld=\"'!c.breathHeld;\n const bh=G.game.settings.breathToggle?c.breathHeld:held;\n v.breath=source==='\"'gamepad'?I.value('breath'):approach(v.breath,bh?1:0,dt/4);\n v.effort=source==='gamepad'?I.value('breath'):(held?.6:0);\n v.catchL=I.pressed('catchL');v.catchR=I.pressed('catchR');v.jump=I.pressed('jump')||I.pressed('confirm');v.paceL=I.pressed('paceL');v.paceR=I.pressed('paceR');\n const lanes=G.mode==='class'?['left','down','up','right']:['stepL','stepD','stepU','stepR'];v.steps=lanes.map(a=>I.pressed(a));\n if(I.anyPressed||Math.hypot(m[0],m[1])>.05||recentMouse)v.touched=true;\n v.source=source;if(c===ctx?.contestants[0])G.source=source;return v;\n};\nG.drawPlate=(g,x,y,b,radius=26,hidden=false)=>{\n const {px}=E,P=G.palette;px.ell(g,x+1,y+3,radius+2,radius+1,'#bed6d6');px.disc(g,x,y,radius+1,'#e2eff0');px.disc(g,x,y,radius,'#ffffff');\n if(hidden){E.font.text(g,'?',x,y-3,P.muted,{align:'center',outline:false});return;}\n const scale=radius*.80,tx=b.target[0]*scale,ty=-b.target[1]*scale,rr=(b.radius||b.params.R)*scale;\n px.line(g,x-scale,y,x+scale,y,'#edf3f4');px.line(g,x,y-scale,x,y+scale,'#edf3f4');\n px.disc(g,x+tx,y+ty,rr+2,b.inRing?'#a3ddcd':'#cadde2');px.disc(g,x+tx,y+ty,Math.max(1,rr),b.inRing?'#d9f5ea':'#f1f8f8');\n for(const t of b.trail){const age=(b.t-t.t);px.disc(g,x+t.x*scale,y-t.y*scale,age<.3?1.5:1,age<.4?'#9fd7d8':'#dbe8e8');}\n px.disc(g,x+b.x*scale,y-b.y*scale,3,b.stumble>0?P.coral:P.ink);px.dot(g,x+b.x*scale-1,y-b.y*scale-1,'#ffffff');\n if(b.streak>2){for(let i=0;i<4;i++){const a=i*Math.PI/2+b.t*.5;px.dot(g,x+Math.cos(a)*(radius-3),y+Math.sin(a)*(radius-3),P.cyan);}}\n};\n})();\nEOF\ncat > game/rigs.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,{px,V3}=E;\nG.lib=Mocap.load(window.MOCAP.FITCLIPS);\nG.SKINS=['#efbd91','#d3976c','#9f6748','#754a36','#f6d7b6','#bb835c'];G.TOPS=['#ff7a59','#5aafaa','#b398c7','#e8bd64','#699cc0','#dc839f','#6a7b88','#e6e9d9'];G.BOTTOMS=['#455e68','#7a7970','#5f6b9a','#9c7774'];G.HAIRS=['short','spiky','long','ponytail','bald'];\nG.makeRig=(opts={})=>{const rig=new E.Humanoid(Object.assign({weapon:null,build:'chibi',outfit:'shirt',sleeves:'short',size:1.9,colors:{skin:G.SKINS[0],cloth:G.TOPS[0],pants:G.BOTTOMS[0],hair:'#655147',boot:'#f8faf2',trim:'#fbe4bd',belt:'#455e68',glove:G.SKINS[0]}},opts));Mocap.drive(rig,G.lib);const base=rig.solvePose;rig.wob=[0,0];rig.body=null;\n rig.solvePose=function(){base.call(this);if(this.body)G.setBody(this,this.body(this));const [ax,ay]=this.wob;if(\"'!ax&&!ay)return;const a=ax*.45,b=ay*.3,ca=Math.cos(a),sa=Math.sin(a),cb=Math.cos(b),sb=Math.sin(b);for(const key in this.J){if(key==='\"'bladeDir'||\"'!this.J[key])continue;const p=this.J[key],r=p[1]*ca+p[2]*sa,z=-p[1]*sa+p[2]*ca;const f=p[0]*cb+z*sb;p[2]=Math.max(-p[0]*sb+z*cb,0);p[0]=f;p[1]=r;}};return rig;};\nG.playerRig=(size=1.9)=>{const a=G.member.avatar;return G.makeRig({size,hair:G.HAIRS[G.HAIRS.indexOf(a.hair)]||'\"'short',hat:a.hat===1?{style:'band',color:'#f2e7a2'}:a.hat>=2?{style:'cap',color:a.hat===3?'#b398c7':'#e8c987'}:null,colors:{skin:G.SKINS[a.skin],hair:'#625047',cloth:G.TOPS[a.top],pants:G.BOTTOMS[a.bottom],boot:'#f6fafa',trim:'#ffffff',belt:'#536d73',glove:G.SKINS[a.skin]}});};\nG.instructorRig=(name=G.member.instructor,size=1.9)=>{const wood=name==='Alder'?'#ecd3ac':'#c69d70';return G.makeRig({size,build:'heroic',limbW:1.5,torsoW:2.5,hair:name==='Alder'?'ponytail':'bald',wood:true,colors:Object.fromEntries(['skin','hair','cloth','coat','pants','boot','belt','trim','glove','eye','iris'].map(k=>[k,k==='eye'||k==='iris'?'#7f633f':wood]))});};\nG.regulars=[['Gertrude','#b398c7','long',4],['Dennis','#e8bd64','bald',1],['Marisol','#5aafaa','ponytail',3],['Young Kevin','#699cc0','spiky',0],['Mr. Okafor','#dc839f','short',2],['Lou','#99a3a3','bald',1],['Twin One','#aab9a1','short',0],['Twin Two','#9ab8cd','short',0]];\nG.regularRig=(i,size=1.4)=>{const r=G.regulars[i%G.regulars.length];return G.makeRig({size,hair:r[2],hat:i===0?{style:'cap',color:'#ecd99e'}:i===2?'band':null,colors:{skin:G.SKINS[r[3]],cloth:r[1],hair:'#d4d4c4',pants:'#6a747e',boot:'#f6fafa',belt:'#64777a',trim:'#f5ead2',glove:G.SKINS[r[3]]}});};\nG.setBody=(rig,b)=>{const o=rig.o,J=rig.J,hip=b.hip;J.hipC=hip;J.hipL=V3.add(hip,[0,-o.hipHalf,0]);J.hipR=V3.add(hip,[0,o.hipHalf,0]);for(const s of [-1,1]){const h=s>0?J.hipR:J.hipL,f=s>0?b.footR:b.footL,[k,ff]=E.ik3(h,f,o.legUpper,o.legLower,b.knee?b.knee(s):[1,s*.3,.1]);J[s>0?'kneeR':'kneeL']=k;J[s>0?'footR':'footL']=ff;}const dir=V3.norm(b.chest||[0,0,1]),sh=V3.add(hip,V3.mul(dir,o.torso));J.shC=sh;J.shL=V3.add(sh,[0,-o.shoulderHalf,0]);J.shR=V3.add(sh,[0,o.shoulderHalf,0]);J.head=V3.add(sh,V3.mul(V3.norm([dir[0],dir[1],dir[2]+.4]),o.neck+o.headR));for(const s of [-1,1]){const h=s>0?J.shR:J.shL,target=(s>0?b.handR:b.handL)(sh,h),[el,hh]=E.ik3(h,target,o.armUpper,o.armLower,[-1,s*.7,-.2]);J[s>0?'elbowR':'elbowL']=el;J[s>0?'handR':'handL']=hh;}};\nG.sideLunge=u=>r=>({hip:[0,u*3.8,r.o.hipZ-Math.abs(u)*r.o.hipZ*.4],footL:[.5,-r.o.footSpread-5.4,0],footR:[.5,r.o.footSpread+5.4,0],knee:s=>[1,s*.7,.1],chest:[.28*Math.abs(u),-u*.1,1],handL:c=>V3.add(c,[4,-.6,-2.6]),handR:c=>V3.add(c,[4,.6,-2.6])});\nG.hula=ph=>r=>{const hx=Math.cos(ph)*2.1,hy=Math.sin(ph)*2.1;return {hip:[hx,hy,r.o.hipZ-.5],footL:[.3,-r.o.footSpread-1,0],footR:[.3,r.o.footSpread+1,0],chest:[-hx*.22,-hy*.22,1],handL:(c,s)=>V3.add(s,[.4,-6,1.6+Math.sin(ph)*.6]),handR:(c,s)=>V3.add(s,[.4,6,1.6-Math.sin(ph)*.6])};};\nG.stepUp=(k,zb=5)=>r=>({hip:[.2+k*1.2,k*1.6,r.o.hipZ+k*zb*.7],footL:[k>.5?3:-1,-r.o.footSpread,k>.85?zb:0],footR:[3,r.o.footSpread,zb*Math.min(1,k*2)],chest:[.1,0,1],handL:(c,s)=>V3.add(s,[1+k*3,-1.2,-3+k*2]),handR:(c,s)=>V3.add(s,[3-k*3,1.2,-1-k*2])});\nG.poseRig=(rig,pose,time,opts={})=>{const p=G.POSES[pose]||G.POSES.idle;let ct=opts.scrub===undefined?p.a+(p.b-p.a)*.3*(.5+.5*Math.sin(time*.7)):p.a+(p.b-p.a)*opts.scrub;\n if(['run','rope','idle'].includes(pose))ct=time;\n if(opts.clip)rig.mocap=G.lib.sample(opts.clip,time);else rig.mocap=G.lib.sample(p.clip,ct);\n rig.wob=opts.wob||[0,0];rig.body=opts.body||null;\n rig.update(opts.dt||1/120,{x:opts.x||0,y:opts.y||0,z:opts.z||0,vx:0,vy:0,facing:(opts.facing===undefined?p.tgt:opts.facing)-(rig.spin||0),pose:pose==='ski'?'crouch':undefined,expr:opts.fall?'wince':'smile'});\n};\nG.drawRig=(r,rig,x,y,z=0,opts={})=>{r.shadow(x,y,rig.o.size*5,.12);r.actor(x,y,z,(g,ox,oy)=>{rig.draw(g,ox,oy,r.view);if(rig.o.wood){for(const k of ['kneeL','kneeR','elbowL','elbowR','shL','shR']){const w=rig.worldOffset(rig.J[k]),p=(rig.lastView||r.view).p(w[0],w[1],w[2]);px.disc(g,ox+p[0],oy+p[1],2.6,'#ad8459');px.disc(g,ox+p[0]-.5,oy+p[1]-.5,1.5,'#ebd3ae');}}},opts);};\nG.drawTare=(g,x,y,scale=1,face='happy',time=G.time)=>{const s=scale,b=Math.sin(time*4),h=Math.max(0,b)*2*s;px.ell(g,x,y+2,13*s,3*s,'#b3cccf');y-=h;\n const rect=(a,b,w,h,c)=>px.rect(g,x+a*s,y+b*s,w*s,h*s,c);rect(-11,0,4,3,'#577c88');rect(7,0,4,3,'#577c88');rect(-14,-12,28,13,'#c0d8dc');rect(-14,-14,28,12,'#fcffff');rect(-12,-13,24,9,'#eaf4f5');px.ell(g,x-6*s,y-9*s,3*s,1.4*s,'#cadfe2');px.ell(g,x+6*s,y-9*s,3*s,1.4*s,'#cadfe2');rect(-4,-13,8,4,'#b1d7dc');rect(-3,-12,6,2,'#efffff');rect(-10,-4,20,4,'#365963');\n const eyes=face==='asleep'?1:face==='shocked'?3:2;rect(-6,-3,3,eyes,'#77e3e6');rect(3,-3,3,eyes,'#77e3e6');if(face==='worried'||face==='judging'){px.line(g,x-7*s,y-5*s,x-3*s,y-4*s,'#2e7180');px.line(g,x+3*s,y-4*s,x+7*s,y-5*s,'#2e7180');}\n if(G.member.minutes>=20){px.poly(g,[[x-3*s,y+1*s],[x,y+3*s],[x,y],[x+3*s,y+1*s],[x+3*s,y+4*s],[x,y+2*s],[x-3*s,y+4*s]],'#f29b8b');}\n};\nG.tare=(r,x,y,scale=1.2,face='happy')=>r.actor(x,y,0,(g,ox,oy)=>G.drawTare(g,ox,oy,scale,face),{outline:false});\nG.drawGerald=(g,x,y,s=1)=>{px.ell(g,x,y+3*s,14*s,3*s,'#cbd4db');px.ell(g,x,y-6*s,13*s,11*s,'#a3a7c2');px.ell(g,x-2*s,y-9*s,10*s,7*s,'#c6c7db');px.disc(g,x-9*s,y-17*s,3*s,'#b7bad1');px.disc(g,x+7*s,y-17*s,3*s,'#b7bad1');px.ell(g,x+1*s,y-4*s,12*s,5*s,'#b9bed4');px.disc(g,x-6*s,y-9*s,1*s,'#455465');px.disc(g,x+5*s,y-9*s,1*s,'#455465');px.line(g,x-4*s,y-16*s,x+3*s,y-16*s,'#5d657e',1);px.dot(g,x-8*s,y-12*s,'#f7f8fc');};\nG.bird=()=>new E.Blob({R:3,wings:true,feet:true,mouth:true,colors:{dk:'#9aadb8',base:'#ecf4f5',lt:'#ffffff',spec:'#ffffff',eye:'#274853',pupil:'#274853'}});\n})();\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_31","type":"agent_message","text":"The Lean model, shared input intents, activity data, and rig animation layer are in place. I’m building the studio and session screens next so I can tune Stork Stand on screen, including mouse, keyboard, and controller behavior.\n"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"cat > game/audio.js <<'EOF'\n(() => {\nconst G=window.G,A=G.game.audio;\nconst melodies=[\n 'C5 . E5 - G5 . E5 . D5 - . . G4 . B4 .',\n 'F4 - A4 . C5 . A4 . G4 . E4 - C5 . D5 .',\n 'A4 . C5 - E5 . D5 . C5 - A4 . G4 . E4 .',\n 'D5 - . A4 . F5 - E5 D5 . C5 . A4 . G4 .',\n 'G4 . D5 . B4 . G4 . A4 - C5 . D5 . B4 .',\n 'E5 . G5 . A5 - G5 . E5 . D5 . C5 - . .',\n 'C5 . G4 . E5 . D5 . F5 . E5 . D5 . B4 .',\n 'A4 . E5 . G5 . E5 . D5 . C5 . B4 . G4 .',\n 'F5 . E5 . C5 - A4 . G4 . A4 . D5 . C5 .',\n 'D5 . A4 . F5 . E5 . A5 - G5 . E5 . C5 .',\n 'B4 . D5 . G5 . D5 . A4 . C5 . E5 . C5 .',\n 'E5 - D5 . C5 . G4 . A4 - C5 . D5 - . .',\n 'C5 . E5 . G5 - A5 . G5 . E5 . D5 . C5 .',\n 'F4 - . . A4 - C5 . E5 - D5 . C5 - . .'\n];\nG.SONGS={};['studio','island','dusk','yoga','iron','step','step2','jog','ski','tray','laundry','festival','ending','raft'].forEach((id,i)=>{\n G.SONGS[id]={bpm:[88,104,76,72,96,100,120,112,116,92,108,112,68,70][i],steps:4,tracks:[{name:'keys',wave:'sine',vol:.22,gate:.65,notes:melodies[i]+' | '+melodies[(i+3)%14]},{name:'bass',wave:'triangle',vol:.16,gate:.8,notes:['C3 - . . G2 - . . A2 - . . F3 - . .','F2 - . . C3 - . . D3 - . . G2 - . .'][i%2]},{name:'air',wave:'triangle',vol:.045,gate:1,notes:'C6 - - - . . . . E6 - - - . . . .',on:true},{name:'brush',wave:'drums',vol:.07,notes:i===3||i===13?'h . . . . . . .':'k . h . . . h . k . h . c . h .'}]};\n});\nconst sfx={boop:{wave:'sine',freq:523,to:784,dur:.17,vol:.32,arp:[0,7],step:.08},chime:{wave:'sine',freq:880,to:1320,dur:.17,vol:.15},creak:{wave:'triangle',freq:75,to:52,dur:.18,vol:.12},stumble:{wave:'noise',freq:500,to:100,dur:.2,vol:.14},clink:{wave:'sine',freq:1500,to:2000,dur:.15,vol:.17},gull:{wave:'triangle',freq:1100,to:650,dur:.24,vol:.12,vib:[12,.06]},flame:{wave:'noise',freq:900,to:1800,dur:.1,vol:.05},whirr:{wave:'sine',freq:220,to:440,dur:.12,vol:.05},carve:{wave:'noise',freq:1300,to:400,dur:.16,vol:.09},plop:{wave:'sine',freq:600,to:160,dur:.13,vol:.2},stamp:{wave:'triangle',freq:250,to:650,dur:.13,vol:.2},tick:{wave:'sine',freq:740,to:900,dur:.045,vol:.12},pick:{wave:'sine',freq:660,to:990,dur:.12,vol:.18},beat:{wave:'sine',freq:1350,to:800,dur:.035,vol:.18}};\nfor(const [k,v]of Object.entries(sfx))A.define(k,v);\nG.music=id=>{if(G.lastSong===id&&A.song)return;G.lastSong=id;A.music(G.SONGS[id]||G.SONGS.studio,{sync:true,fade:.45});};\nG.jingle=n=>A.sting({bpm:150,steps:4,loop:false,len:12,tracks:[{wave:'sine',vol:.25,notes:n>=3?'C5 E5 G5 C6 - - E6 - - - . .':n===2?'C5 . E5 . G5 - - - . . . .':'C5 . E5 - - - . . . . . .'},{wave:'triangle',vol:.1,notes:'C3 - - - G3 - - - C4 - - -'}]});\nG.VOICES={Tare:[640,'sine'],Birch:[125,'triangle'],Alder:[310,'triangle'],Gertrude:[430,'sine'],Dennis:[180,'triangle'],Marisol:[360,'sine'],'Young Kevin':[220,'triangle'],'Mr. Okafor':[165,'sine'],Lou:[110,'sine']};\nG.babble=(name,ch,providedCtx,providedBus)=>{\n if(\"'!/[a-z0-9]/i.test(ch))return null;\n const ctx=providedCtx||A.ctx;if(!ctx)return null;\n const bus=providedBus||A.bus('\"'voice');if(\"'!bus)return null;\n const v=G.VOICES[name]||[290,'\"'triangle'],code=ch.toLowerCase().charCodeAt(0),vowel=/[aeiou]/i.test(ch),dur=vowel?.09:.06,t=ctx.currentTime,osc=ctx.createOscillator(),gain=ctx.createGain(),f=ctx.createBiquadFilter();\n osc.type=v[1];osc.frequency.setValueAtTime(v[0]*(.83+(code%13)*.041),t);osc.frequency.exponentialRampToValueAtTime(v[0]*(.92+(code%7)*.038),t+dur);\n f.type='bandpass';f.frequency.value=vowel?1100+(code%5)*240:700+(code%9)*130;f.Q.value=.7;gain.gain.setValueAtTime(0,t);gain.gain.linearRampToValueAtTime(.15,t+.008);gain.gain.exponentialRampToValueAtTime(.001,t+dur);\n osc.connect(f);f.connect(gain);gain.connect(bus);osc.start(t);osc.stop(t+dur+.01);return osc;\n};\nA.onBeat(()=>{const ctx=G.context;if(ctx?.a.family==='step'&&G.sessionPhase==='play'){A.sfx('beat');if((A.pos.beat|0)%4===0)G.babble(G.member.instructor,'ta');}});\nG.talk=new G.E.Dialog(G.game,{speed:32,lines:2,color:G.palette.ink,nameColor:G.palette.cyan,bg:['#ffffff','#edf7f7'],border:'#bedfe0',voice:(ch,i,talk)=>G.babble(talk.name,ch)});G.talk.shadow=null;\n})();\nEOF\ncat > game/ui.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,{px}=E,P=G.palette;\nG.round=(g,x,y,w,h,c,r=5)=>{r=Math.min(r,h/2,w/2);px.rect(g,x+r,y,w-2*r,h,c);px.rect(g,x,y+r,w,h-2*r,c);for(const xx of [x+r,x+w-r-1])for(const yy of [y+r,y+h-r-1])px.disc(g,xx,yy,r,c);};\nG.text=(g,s,x,y,o={})=>E.font.text(g,String(s),x,y,o.color||P.ink,{outline:false,shadow:null,...o});\nG.wrap=(s,w,scale=1)=>E.font.wrap(String(s),w,{scale,outline:false});\nG.paragraph=(g,s,x,y,w,o={})=>{const ls=G.wrap(s,w,o.scale||1);ls.forEach((l,i)=>G.text(g,l,x,y+i*(o.lineHeight||11)*(o.scale||1),o));return ls.length*(o.lineHeight||11)*(o.scale||1);};\nG.tag=(g,s,x,y,color=P.cyan)=>{const w=E.font.width(s)+12;G.round(g,x,y,w,13,'#ffffff',3);G.text(g,s,x+6,y+3,{color});};\nG.header=(r,small,title)=>r.overlay(g=>{G.text(g,small.toUpperCase(),14,12,{color:P.cyan});G.text(g,title,14,28,{scale:2});});\nG.promptText=(action,verb)=>{\n const I=G.game.input;let label;if(action==='lean')label=G.source==='gamepad'?'Left stick':G.source==='mouse'?'Move mouse':'WASD / arrows';else label=G.source==='gamepad'?I.label(action,'gamepad'):G.source==='mouse'?I.label(action,'mouse'):I.label(action,'keyboard');return label+'  '+verb;\n};\nG.prompt=(r,action,verb,x,y)=>r.overlay(g=>{const s=G.promptText(action,verb),w=E.font.width(s)+14;const xx=x===undefined?r.W-w-12:x,yy=y===undefined?r.H-21:y;G.round(g,xx,yy,w,14,'#ffffff');G.text(g,s,xx+7,yy+4,{color:P.muted});});\nG.Pills=class{\n constructor(items,opts={}){this.items=items.map(a=>typeof a==='string'?{label:a}:Array.isArray(a)?{label:a[0],fn:a[1]}:a);this.i=opts.focus||0;this.opts=opts;this.rows=[];this.mouseT=-99;this.age=0;this.layout();}\n layout(){const o=this.opts,w=typeof o.w==='function'?o.w():o.w||172,x=typeof o.x==='function'?o.x():o.x===undefined?(G.game.W-w)/2:o.x,y=typeof o.y==='function'?o.y():o.y===undefined?68:o.y,h=o.h||25,gap=o.gap===undefined?5:o.gap;this.rows=this.items.map((a,i)=>({x,y:y+i*(h+gap),w,h}));}\n update(dt){this.age+=dt;this.layout();if(G.dev.open)return false;const I=G.game.input;let move=0;if(I.repeat('down')||this.opts.horizontal&&I.repeat('right'))move=1;if(I.repeat('up')||this.opts.horizontal&&I.repeat('left'))move=-1;if(move){this.i=(this.i+move+this.items.length)%this.items.length;G.game.audio.sfx('tick');}\n const p=I.pointer(),mt=I.mouse?.t||0;if(p&&mt>this.mouseT&&G.source==='mouse'){const n=this.rows.findIndex(b=>p[0]>=b.x&&p[0]<=b.x+b.w&&p[1]>=b.y&&p[1]<=b.y+b.h);if(n>=0&&n\"'!==this.i){this.i=n;G.game.audio.sfx('\"'tick');}this.mouseT=mt;}\n const click=I.clicked(),ci=click?this.rows.findIndex(b=>click[0]>=b.x&&click[0]<=b.x+b.w&&click[1]>=b.y&&click[1]<=b.y+b.h):-1;\n if(ci>=0)this.i=ci;\n if(this.age>.10&&(ci>=0||((I.pressed('confirm')||I.pressed('start'))&&I.lastDevice\"'!=='\"'mouse'))){const a=this.items[this.i];I.consumeAll();if(\"'!a.disabled){G.game.audio.sfx('\"'pick');a.fn?.(this.i,a);return true;}G.game.audio.sfx('creak');}\n if(I.pressed('cancel')&&this.opts.back){I.consumeAll();this.opts.back();return true;}return false;\n }\n draw(r){r.overlay(g=>{this.rows.forEach((b,i)=>{const a=this.items[i],focus=i===this.i;const grow=focus?1:0;G.round(g,b.x-grow,b.y-grow+2,b.w+grow*2,b.h+grow*2,focus?'#9dcbd2':'#d0e1df',6);G.round(g,b.x-grow,b.y-grow,b.w+grow*2,b.h+grow*2,focus?P.cyan:'#ffffff',6);if(focus)G.text(g,'▸',b.x+8,b.y+(b.h-7)/2,{color:'#ffffff'});const label=typeof a.label==='function'?a.label():a.label;G.text(g,label,b.x+(focus?19:12),b.y+(b.h-7)/2,{color:a.disabled?'#94a8ad':focus?'#ffffff':P.ink});if(a.value){const s=typeof a.value==='function'?a.value():a.value;G.text(g,s,b.x+b.w-10,b.y+(b.h-7)/2,{align:'right',color:focus?'#ffffff':P.cyan});}});});}\n};\nG.speech=(lines,opts={})=>{G.talk.say(lines,{name:opts.name||'Tare',portrait:opts.name&&opts.name\"'!=='\"'Tare'?G.instructorRig(opts.name,1):((g,x,y,size)=>G.drawTare(g,x+size/2,y+size*.78,size/28,'happy')),onDone:opts.done,auto:opts.auto,...opts});};\nG.ribbon=(r,s,sub)=>r.overlay(g=>{const w=Math.min(280,r.W-28),x=(r.W-w)/2;G.round(g,x,56,w,39,'#ffffff',6);G.text(g,s,r.W/2,64,{scale:2,align:'center'});if(sub)G.text(g,sub,r.W/2,83,{align:'center',color:P.muted});});\nG.dots=(g,n,total,x,y,color=P.cyan)=>{for(let i=0;i<total;i++){px.disc(g,x+i*9,y,2.5,i<n?color:'#d5e3e4');}};\nG.flower=(g,x,y,m=G.member)=>{G.disciplines.forEach((d,i)=>{const aa=Object.values(G.activities).filter(a=>a.discipline===d.id),v=aa.reduce((s,a)=>s+(m.best[a.id+'-1']?.stars||0),0)/9;const a=i*Math.PI/2-Math.PI/4;px.ell(g,x+Math.cos(a)*9,y+Math.sin(a)*9,6+v*3,6+v*3,E.mix('#e3ecec',d.color,Math.max(.18,v)));});px.disc(g,x,y,4,'#fff6d5');};\nG.dayHUD=r=>r.overlay(g=>{G.round(g,10,9,100,28,'#ffffff');G.text(g,'Day '+Math.min(G.member.day,5),17,15,{color:P.cyan});G.text(g,G.DAYS[Math.min(4,G.member.day-1)].name,17,26);G.dots(g,G.member.sessions,3,91,20);const xx=r.W-132;G.round(g,xx,9,83,28,'#ffffff');G.text(g,'Spine '+G.member.spineAge,xx+8,15);G.text(g,G.member.minutes.toFixed(1)+' min',xx+8,26,{color:P.muted});});\nG.paper=r=>{r.sky(['#eaf5f5','#f6fafa']);r.overlay(g=>{for(let x=8;x<r.W;x+=24)for(let y=8;y<r.H;y+=24)px.dot(g,x,y,'#dcebec');});};\n})();\nEOF\ncat > game/world.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,{px}=E,P=G.palette;\nE.MATERIALS.retreatWood={color:'#e1c8a1',pattern:'planks',bw:3,len:20};E.MATERIALS.retreatWhite={color:'#f2f7f5',pattern:'none'};E.MATERIALS.retreatCyan={color:'#5dafb8',pattern:'glaze'};\nE.SHAPES.mat={about:'soft rounded exercise mat with stitched edging',mats:{a:'retreatCyan',b:'retreatWhite'},parts:[['box','a',[0,0,0],[38,26,1]],['row',2,[0,22,0],['box','b',[0,0,1],[30,.6,.15]]]]};\nE.SHAPES.stepbench={about:'low studio step with pale top',mats:{w:'retreatWood',a:'retreatCyan',b:'retreatWhite'},parts:[['box','a',[0,0,0],[24,13,4]],['box','b',[0,0,4],[25,14,1]],['row',2,[17,0,0],['box','w',[0,0,0],[3,10,2]]]]};\nE.SHAPES.dumbbell={about:'tiny optimistic dumbbell',mats:{w:'retreatCyan',b:'retreatWhite'},parts:[['box','b',[0,0,2],[10,2,2]],['row',2,[8,0,0],['ball','w',[0,0,3],3]]]};\nG.sea=(g,W,H,horizon,t=G.time,dusk=false)=>{for(let y=0;y<H;y+=3)px.rect(g,0,y,W,3,E.mix(dusk?'#d5b8b5':'#c5edf4',dusk?'#9ebec1':'#90d7e4',y/H));px.disc(g,W*.73,horizon-26,12,dusk?'#ffe3bd':'#fff7ce');px.rect(g,0,horizon,W,H-horizon,dusk?'#6ca4af':'#57b9ca');for(let i=0;i<29;i++){const yy=horizon+5+(i*13)%(Math.max(6,H-horizon-8)),xx=((i*59+t*(2+i%3))%(W+40))-20;px.rect(g,xx,yy,8+(i%5)*4,1,i%3===0?'#c5e7e4':dusk?'#9ac8c9':'#8bd4dc');}for(let i=0;i<4;i++){const x=(W*.21+i*71+t*1.4)%(W+25);px.ell(g,x,14+i%2*13,11+i*2,3,'#e6f6f6');}}\nG.studio=(r,room='deck',opts={})=>{\n const g=r.ctx,W=r.W,H=r.H,t=G.time,base=Math.round(H*.49),dusk=room==='raft'||opts.dusk;\n G.sea(g,W,H,Math.round(H*.23),t,dusk);\n const outdoor=['deck','pier','raft','coast','laundry'].includes(room);\n if(\"'!outdoor){px.rect(g,0,0,W,base,'\"'#e4edeb');px.rect(g,9,19,W-18,base-27,'#f5faf8');px.rect(g,W*.37,21,W*.51,base-38,'#bbd7da');G.seaWindow(g,W*.37+3,24,W*.51-6,base-44,t);px.rect(g,W*.62,24,3,base-44,'#f7fbf9');px.rect(g,W*.37,base-17,W*.51,4,'#ffffff');}\n for(let y=base;y<H;y+=4)px.rect(g,0,y,W,4,E.mix(dusk?'#b5aaa3':'#f2e4ce',dusk?'#d6beaa':'#dfbf98',(y-base)/(H-base)));\n for(let i=0;i<20;i++){const yy=base+Math.pow(i/19,1.4)*(H-base);px.line(g,0,yy,W,yy,dusk?'#ad9990':'#d5b890');if(i%2===0){const start=(i%4)*29;for(let x=start;x<W;x+=94)px.line(g,x,yy,x,yy+7,'#d8be9c');}}\n if(outdoor){px.rect(g,0,base-3,W,4,'#f5f3e7');px.rect(g,0,base-17,W,2,'#f2f2e4');for(let x=12;x<W;x+=54){px.rect(g,x,base-18,3,24,'#a8bfc0');px.rect(g,x,base-19,3,20,'#f1f1de');}}\n if(room==='pier'||G.festival){for(let x=0;x<W;x+=16){const yy=25+Math.sin(x/W*Math.PI)*10;px.line(g,x,yy,x+16,25+Math.sin((x+16)/W*Math.PI)*10,'#7caaac');px.poly(g,[[x+2,yy+1],[x+12,yy+2],[x+7,yy+11]],['#f4ad92','#f6dc9c','#a3dcd0','#c7bbdd'][(x/16)%4]);}}\n if(room==='iron'){r.shape('dumbbell',-90,-5,0);r.shape('dumbbell',-78,7,0);r.shape('bench',85,-25,0,{scale:1.1,mats:{w:'retreatWood'}});r.shape('pot',88,-36,0,{scale:1.4});r.overlay(g=>{G.text(g,'GENTLY, OR NOT AT ALL',19,base-35,{color:'#789b9d'});});}\n else if(room==='bar'){r.shape('table',80,-25,0,{scale:1.4});r.shape('stool',70,-8,0);r.shape('jar',86,-26,15);r.shape('pot',-90,-30,0,{scale:1.5});}\n else if(room==='bungalow'){r.shape('bed',-68,-20,0,{scale:1.8,mats:{w:'retreatWood'}});r.shape('bench',80,-28,0);r.shape('pot',90,-30,0);}\n else{G.plant(r,-105,-34,1.6);G.plant(r,103,-30,1.5);if(room==='raft'){r.prop('lantern',-80,-8,0,{light:true,size:1.2});r.prop('lantern',80,-8,0,{light:true,size:1.2});}else{r.shape('bench',87,-37,0);r.shape('jar',-86,-32,0,{scale:1.1});}}\n};\nG.seaWindow=(g,x,y,w,h,t)=>{px.rect(g,x,y,w,h,'#b9e8ee');px.rect(g,x,y+h*.42,w,h*.58,'#62bfcc');for(let i=0;i<10;i++)px.rect(g,x+((i*31+t*2)%w),y+h*.46+(i*7)%(h*.5),8,1,'#a5e0e2');px.disc(g,x+w*.78,y+h*.19,6,'#fff8d5');};\nG.plant=(r,x,y,s=1)=>{r.shape('pot',x,y,0,{scale:s,mats:{c:'retreatWhite'}});r.queue(x,y,0,g=>{const p=r.w(x,y,9*s);for(let i=0;i<7;i++){const a=i*.63-3.3,dx=Math.cos(a)*10*s,dy=-Math.abs(Math.sin(a))*14*s;px.line(g,p[0],p[1],p[0]+dx,p[1]+dy,'#699a83',2);px.ell(g,p[0]+dx,p[1]+dy,4*s,2*s,i%2?'#8abd96':'#659c85');}});};\nG.light=(dusk=false)=>{const game=G.game;game.lights.enabled=true;game.lights.ambient=dusk?.72:.98;game.cam.bounds=null;game.follow(null);game.cam.offset=[0,0];game.focus(0,0,20);};\nG.mat=(r,x,y,color)=>{r.shape('mat',x,y,0,{mats:{a:{color:color||'#8bc8c8',pattern:'cloth'}}});};\n})();\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"cat > game/audio.js <<'EOF'\n(() => {\nconst G=window.G,A=G.game.audio;\nconst melodies=[\n 'C5 . E5 - G5 . E5 . D5 - . . G4 . B4 .',\n 'F4 - A4 . C5 . A4 . G4 . E4 - C5 . D5 .',\n 'A4 . C5 - E5 . D5 . C5 - A4 . G4 . E4 .',\n 'D5 - . A4 . F5 - E5 D5 . C5 . A4 . G4 .',\n 'G4 . D5 . B4 . G4 . A4 - C5 . D5 . B4 .',\n 'E5 . G5 . A5 - G5 . E5 . D5 . C5 - . .',\n 'C5 . G4 . E5 . D5 . F5 . E5 . D5 . B4 .',\n 'A4 . E5 . G5 . E5 . D5 . C5 . B4 . G4 .',\n 'F5 . E5 . C5 - A4 . G4 . A4 . D5 . C5 .',\n 'D5 . A4 . F5 . E5 . A5 - G5 . E5 . C5 .',\n 'B4 . D5 . G5 . D5 . A4 . C5 . E5 . C5 .',\n 'E5 - D5 . C5 . G4 . A4 - C5 . D5 - . .',\n 'C5 . E5 . G5 - A5 . G5 . E5 . D5 . C5 .',\n 'F4 - . . A4 - C5 . E5 - D5 . C5 - . .'\n];\nG.SONGS={};['studio','island','dusk','yoga','iron','step','step2','jog','ski','tray','laundry','festival','ending','raft'].forEach((id,i)=>{\n G.SONGS[id]={bpm:[88,104,76,72,96,100,120,112,116,92,108,112,68,70][i],steps:4,tracks:[{name:'keys',wave:'sine',vol:.22,gate:.65,notes:melodies[i]+' | '+melodies[(i+3)%14]},{name:'bass',wave:'triangle',vol:.16,gate:.8,notes:['C3 - . . G2 - . . A2 - . . F3 - . .','F2 - . . C3 - . . D3 - . . G2 - . .'][i%2]},{name:'air',wave:'triangle',vol:.045,gate:1,notes:'C6 - - - . . . . E6 - - - . . . .',on:true},{name:'brush',wave:'drums',vol:.07,notes:i===3||i===13?'h . . . . . . .':'k . h . . . h . k . h . c . h .'}]};\n});\nconst sfx={boop:{wave:'sine',freq:523,to:784,dur:.17,vol:.32,arp:[0,7],step:.08},chime:{wave:'sine',freq:880,to:1320,dur:.17,vol:.15},creak:{wave:'triangle',freq:75,to:52,dur:.18,vol:.12},stumble:{wave:'noise',freq:500,to:100,dur:.2,vol:.14},clink:{wave:'sine',freq:1500,to:2000,dur:.15,vol:.17},gull:{wave:'triangle',freq:1100,to:650,dur:.24,vol:.12,vib:[12,.06]},flame:{wave:'noise',freq:900,to:1800,dur:.1,vol:.05},whirr:{wave:'sine',freq:220,to:440,dur:.12,vol:.05},carve:{wave:'noise',freq:1300,to:400,dur:.16,vol:.09},plop:{wave:'sine',freq:600,to:160,dur:.13,vol:.2},stamp:{wave:'triangle',freq:250,to:650,dur:.13,vol:.2},tick:{wave:'sine',freq:740,to:900,dur:.045,vol:.12},pick:{wave:'sine',freq:660,to:990,dur:.12,vol:.18},beat:{wave:'sine',freq:1350,to:800,dur:.035,vol:.18}};\nfor(const [k,v]of Object.entries(sfx))A.define(k,v);\nG.music=id=>{if(G.lastSong===id&&A.song)return;G.lastSong=id;A.music(G.SONGS[id]||G.SONGS.studio,{sync:true,fade:.45});};\nG.jingle=n=>A.sting({bpm:150,steps:4,loop:false,len:12,tracks:[{wave:'sine',vol:.25,notes:n>=3?'C5 E5 G5 C6 - - E6 - - - . .':n===2?'C5 . E5 . G5 - - - . . . .':'C5 . E5 - - - . . . . . .'},{wave:'triangle',vol:.1,notes:'C3 - - - G3 - - - C4 - - -'}]});\nG.VOICES={Tare:[640,'sine'],Birch:[125,'triangle'],Alder:[310,'triangle'],Gertrude:[430,'sine'],Dennis:[180,'triangle'],Marisol:[360,'sine'],'Young Kevin':[220,'triangle'],'Mr. Okafor':[165,'sine'],Lou:[110,'sine']};\nG.babble=(name,ch,providedCtx,providedBus)=>{\n if(\"'!/[a-z0-9]/i.test(ch))return null;\n const ctx=providedCtx||A.ctx;if(!ctx)return null;\n const bus=providedBus||A.bus('\"'voice');if(\"'!bus)return null;\n const v=G.VOICES[name]||[290,'\"'triangle'],code=ch.toLowerCase().charCodeAt(0),vowel=/[aeiou]/i.test(ch),dur=vowel?.09:.06,t=ctx.currentTime,osc=ctx.createOscillator(),gain=ctx.createGain(),f=ctx.createBiquadFilter();\n osc.type=v[1];osc.frequency.setValueAtTime(v[0]*(.83+(code%13)*.041),t);osc.frequency.exponentialRampToValueAtTime(v[0]*(.92+(code%7)*.038),t+dur);\n f.type='bandpass';f.frequency.value=vowel?1100+(code%5)*240:700+(code%9)*130;f.Q.value=.7;gain.gain.setValueAtTime(0,t);gain.gain.linearRampToValueAtTime(.15,t+.008);gain.gain.exponentialRampToValueAtTime(.001,t+dur);\n osc.connect(f);f.connect(gain);gain.connect(bus);osc.start(t);osc.stop(t+dur+.01);return osc;\n};\nA.onBeat(()=>{const ctx=G.context;if(ctx?.a.family==='step'&&G.sessionPhase==='play'){A.sfx('beat');if((A.pos.beat|0)%4===0)G.babble(G.member.instructor,'ta');}});\nG.talk=new G.E.Dialog(G.game,{speed:32,lines:2,color:G.palette.ink,nameColor:G.palette.cyan,bg:['#ffffff','#edf7f7'],border:'#bedfe0',voice:(ch,i,talk)=>G.babble(talk.name,ch)});G.talk.shadow=null;\n})();\nEOF\ncat > game/ui.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,{px}=E,P=G.palette;\nG.round=(g,x,y,w,h,c,r=5)=>{r=Math.min(r,h/2,w/2);px.rect(g,x+r,y,w-2*r,h,c);px.rect(g,x,y+r,w,h-2*r,c);for(const xx of [x+r,x+w-r-1])for(const yy of [y+r,y+h-r-1])px.disc(g,xx,yy,r,c);};\nG.text=(g,s,x,y,o={})=>E.font.text(g,String(s),x,y,o.color||P.ink,{outline:false,shadow:null,...o});\nG.wrap=(s,w,scale=1)=>E.font.wrap(String(s),w,{scale,outline:false});\nG.paragraph=(g,s,x,y,w,o={})=>{const ls=G.wrap(s,w,o.scale||1);ls.forEach((l,i)=>G.text(g,l,x,y+i*(o.lineHeight||11)*(o.scale||1),o));return ls.length*(o.lineHeight||11)*(o.scale||1);};\nG.tag=(g,s,x,y,color=P.cyan)=>{const w=E.font.width(s)+12;G.round(g,x,y,w,13,'#ffffff',3);G.text(g,s,x+6,y+3,{color});};\nG.header=(r,small,title)=>r.overlay(g=>{G.text(g,small.toUpperCase(),14,12,{color:P.cyan});G.text(g,title,14,28,{scale:2});});\nG.promptText=(action,verb)=>{\n const I=G.game.input;let label;if(action==='lean')label=G.source==='gamepad'?'Left stick':G.source==='mouse'?'Move mouse':'WASD / arrows';else label=G.source==='gamepad'?I.label(action,'gamepad'):G.source==='mouse'?I.label(action,'mouse'):I.label(action,'keyboard');return label+'  '+verb;\n};\nG.prompt=(r,action,verb,x,y)=>r.overlay(g=>{const s=G.promptText(action,verb),w=E.font.width(s)+14;const xx=x===undefined?r.W-w-12:x,yy=y===undefined?r.H-21:y;G.round(g,xx,yy,w,14,'#ffffff');G.text(g,s,xx+7,yy+4,{color:P.muted});});\nG.Pills=class{\n constructor(items,opts={}){this.items=items.map(a=>typeof a==='string'?{label:a}:Array.isArray(a)?{label:a[0],fn:a[1]}:a);this.i=opts.focus||0;this.opts=opts;this.rows=[];this.mouseT=-99;this.age=0;this.layout();}\n layout(){const o=this.opts,w=typeof o.w==='function'?o.w():o.w||172,x=typeof o.x==='function'?o.x():o.x===undefined?(G.game.W-w)/2:o.x,y=typeof o.y==='function'?o.y():o.y===undefined?68:o.y,h=o.h||25,gap=o.gap===undefined?5:o.gap;this.rows=this.items.map((a,i)=>({x,y:y+i*(h+gap),w,h}));}\n update(dt){this.age+=dt;this.layout();if(G.dev.open)return false;const I=G.game.input;let move=0;if(I.repeat('down')||this.opts.horizontal&&I.repeat('right'))move=1;if(I.repeat('up')||this.opts.horizontal&&I.repeat('left'))move=-1;if(move){this.i=(this.i+move+this.items.length)%this.items.length;G.game.audio.sfx('tick');}\n const p=I.pointer(),mt=I.mouse?.t||0;if(p&&mt>this.mouseT&&G.source==='mouse'){const n=this.rows.findIndex(b=>p[0]>=b.x&&p[0]<=b.x+b.w&&p[1]>=b.y&&p[1]<=b.y+b.h);if(n>=0&&n\"'!==this.i){this.i=n;G.game.audio.sfx('\"'tick');}this.mouseT=mt;}\n const click=I.clicked(),ci=click?this.rows.findIndex(b=>click[0]>=b.x&&click[0]<=b.x+b.w&&click[1]>=b.y&&click[1]<=b.y+b.h):-1;\n if(ci>=0)this.i=ci;\n if(this.age>.10&&(ci>=0||((I.pressed('confirm')||I.pressed('start'))&&I.lastDevice\"'!=='\"'mouse'))){const a=this.items[this.i];I.consumeAll();if(\"'!a.disabled){G.game.audio.sfx('\"'pick');a.fn?.(this.i,a);return true;}G.game.audio.sfx('creak');}\n if(I.pressed('cancel')&&this.opts.back){I.consumeAll();this.opts.back();return true;}return false;\n }\n draw(r){r.overlay(g=>{this.rows.forEach((b,i)=>{const a=this.items[i],focus=i===this.i;const grow=focus?1:0;G.round(g,b.x-grow,b.y-grow+2,b.w+grow*2,b.h+grow*2,focus?'#9dcbd2':'#d0e1df',6);G.round(g,b.x-grow,b.y-grow,b.w+grow*2,b.h+grow*2,focus?P.cyan:'#ffffff',6);if(focus)G.text(g,'▸',b.x+8,b.y+(b.h-7)/2,{color:'#ffffff'});const label=typeof a.label==='function'?a.label():a.label;G.text(g,label,b.x+(focus?19:12),b.y+(b.h-7)/2,{color:a.disabled?'#94a8ad':focus?'#ffffff':P.ink});if(a.value){const s=typeof a.value==='function'?a.value():a.value;G.text(g,s,b.x+b.w-10,b.y+(b.h-7)/2,{align:'right',color:focus?'#ffffff':P.cyan});}});});}\n};\nG.speech=(lines,opts={})=>{G.talk.say(lines,{name:opts.name||'Tare',portrait:opts.name&&opts.name\"'!=='\"'Tare'?G.instructorRig(opts.name,1):((g,x,y,size)=>G.drawTare(g,x+size/2,y+size*.78,size/28,'happy')),onDone:opts.done,auto:opts.auto,...opts});};\nG.ribbon=(r,s,sub)=>r.overlay(g=>{const w=Math.min(280,r.W-28),x=(r.W-w)/2;G.round(g,x,56,w,39,'#ffffff',6);G.text(g,s,r.W/2,64,{scale:2,align:'center'});if(sub)G.text(g,sub,r.W/2,83,{align:'center',color:P.muted});});\nG.dots=(g,n,total,x,y,color=P.cyan)=>{for(let i=0;i<total;i++){px.disc(g,x+i*9,y,2.5,i<n?color:'#d5e3e4');}};\nG.flower=(g,x,y,m=G.member)=>{G.disciplines.forEach((d,i)=>{const aa=Object.values(G.activities).filter(a=>a.discipline===d.id),v=aa.reduce((s,a)=>s+(m.best[a.id+'-1']?.stars||0),0)/9;const a=i*Math.PI/2-Math.PI/4;px.ell(g,x+Math.cos(a)*9,y+Math.sin(a)*9,6+v*3,6+v*3,E.mix('#e3ecec',d.color,Math.max(.18,v)));});px.disc(g,x,y,4,'#fff6d5');};\nG.dayHUD=r=>r.overlay(g=>{G.round(g,10,9,100,28,'#ffffff');G.text(g,'Day '+Math.min(G.member.day,5),17,15,{color:P.cyan});G.text(g,G.DAYS[Math.min(4,G.member.day-1)].name,17,26);G.dots(g,G.member.sessions,3,91,20);const xx=r.W-132;G.round(g,xx,9,83,28,'#ffffff');G.text(g,'Spine '+G.member.spineAge,xx+8,15);G.text(g,G.member.minutes.toFixed(1)+' min',xx+8,26,{color:P.muted});});\nG.paper=r=>{r.sky(['#eaf5f5','#f6fafa']);r.overlay(g=>{for(let x=8;x<r.W;x+=24)for(let y=8;y<r.H;y+=24)px.dot(g,x,y,'#dcebec');});};\n})();\nEOF\ncat > game/world.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,{px}=E,P=G.palette;\nE.MATERIALS.retreatWood={color:'#e1c8a1',pattern:'planks',bw:3,len:20};E.MATERIALS.retreatWhite={color:'#f2f7f5',pattern:'none'};E.MATERIALS.retreatCyan={color:'#5dafb8',pattern:'glaze'};\nE.SHAPES.mat={about:'soft rounded exercise mat with stitched edging',mats:{a:'retreatCyan',b:'retreatWhite'},parts:[['box','a',[0,0,0],[38,26,1]],['row',2,[0,22,0],['box','b',[0,0,1],[30,.6,.15]]]]};\nE.SHAPES.stepbench={about:'low studio step with pale top',mats:{w:'retreatWood',a:'retreatCyan',b:'retreatWhite'},parts:[['box','a',[0,0,0],[24,13,4]],['box','b',[0,0,4],[25,14,1]],['row',2,[17,0,0],['box','w',[0,0,0],[3,10,2]]]]};\nE.SHAPES.dumbbell={about:'tiny optimistic dumbbell',mats:{w:'retreatCyan',b:'retreatWhite'},parts:[['box','b',[0,0,2],[10,2,2]],['row',2,[8,0,0],['ball','w',[0,0,3],3]]]};\nG.sea=(g,W,H,horizon,t=G.time,dusk=false)=>{for(let y=0;y<H;y+=3)px.rect(g,0,y,W,3,E.mix(dusk?'#d5b8b5':'#c5edf4',dusk?'#9ebec1':'#90d7e4',y/H));px.disc(g,W*.73,horizon-26,12,dusk?'#ffe3bd':'#fff7ce');px.rect(g,0,horizon,W,H-horizon,dusk?'#6ca4af':'#57b9ca');for(let i=0;i<29;i++){const yy=horizon+5+(i*13)%(Math.max(6,H-horizon-8)),xx=((i*59+t*(2+i%3))%(W+40))-20;px.rect(g,xx,yy,8+(i%5)*4,1,i%3===0?'#c5e7e4':dusk?'#9ac8c9':'#8bd4dc');}for(let i=0;i<4;i++){const x=(W*.21+i*71+t*1.4)%(W+25);px.ell(g,x,14+i%2*13,11+i*2,3,'#e6f6f6');}}\nG.studio=(r,room='deck',opts={})=>{\n const g=r.ctx,W=r.W,H=r.H,t=G.time,base=Math.round(H*.49),dusk=room==='raft'||opts.dusk;\n G.sea(g,W,H,Math.round(H*.23),t,dusk);\n const outdoor=['deck','pier','raft','coast','laundry'].includes(room);\n if(\"'!outdoor){px.rect(g,0,0,W,base,'\"'#e4edeb');px.rect(g,9,19,W-18,base-27,'#f5faf8');px.rect(g,W*.37,21,W*.51,base-38,'#bbd7da');G.seaWindow(g,W*.37+3,24,W*.51-6,base-44,t);px.rect(g,W*.62,24,3,base-44,'#f7fbf9');px.rect(g,W*.37,base-17,W*.51,4,'#ffffff');}\n for(let y=base;y<H;y+=4)px.rect(g,0,y,W,4,E.mix(dusk?'#b5aaa3':'#f2e4ce',dusk?'#d6beaa':'#dfbf98',(y-base)/(H-base)));\n for(let i=0;i<20;i++){const yy=base+Math.pow(i/19,1.4)*(H-base);px.line(g,0,yy,W,yy,dusk?'#ad9990':'#d5b890');if(i%2===0){const start=(i%4)*29;for(let x=start;x<W;x+=94)px.line(g,x,yy,x,yy+7,'#d8be9c');}}\n if(outdoor){px.rect(g,0,base-3,W,4,'#f5f3e7');px.rect(g,0,base-17,W,2,'#f2f2e4');for(let x=12;x<W;x+=54){px.rect(g,x,base-18,3,24,'#a8bfc0');px.rect(g,x,base-19,3,20,'#f1f1de');}}\n if(room==='pier'||G.festival){for(let x=0;x<W;x+=16){const yy=25+Math.sin(x/W*Math.PI)*10;px.line(g,x,yy,x+16,25+Math.sin((x+16)/W*Math.PI)*10,'#7caaac');px.poly(g,[[x+2,yy+1],[x+12,yy+2],[x+7,yy+11]],['#f4ad92','#f6dc9c','#a3dcd0','#c7bbdd'][(x/16)%4]);}}\n if(room==='iron'){r.shape('dumbbell',-90,-5,0);r.shape('dumbbell',-78,7,0);r.shape('bench',85,-25,0,{scale:1.1,mats:{w:'retreatWood'}});r.shape('pot',88,-36,0,{scale:1.4});r.overlay(g=>{G.text(g,'GENTLY, OR NOT AT ALL',19,base-35,{color:'#789b9d'});});}\n else if(room==='bar'){r.shape('table',80,-25,0,{scale:1.4});r.shape('stool',70,-8,0);r.shape('jar',86,-26,15);r.shape('pot',-90,-30,0,{scale:1.5});}\n else if(room==='bungalow'){r.shape('bed',-68,-20,0,{scale:1.8,mats:{w:'retreatWood'}});r.shape('bench',80,-28,0);r.shape('pot',90,-30,0);}\n else{G.plant(r,-105,-34,1.6);G.plant(r,103,-30,1.5);if(room==='raft'){r.prop('lantern',-80,-8,0,{light:true,size:1.2});r.prop('lantern',80,-8,0,{light:true,size:1.2});}else{r.shape('bench',87,-37,0);r.shape('jar',-86,-32,0,{scale:1.1});}}\n};\nG.seaWindow=(g,x,y,w,h,t)=>{px.rect(g,x,y,w,h,'#b9e8ee');px.rect(g,x,y+h*.42,w,h*.58,'#62bfcc');for(let i=0;i<10;i++)px.rect(g,x+((i*31+t*2)%w),y+h*.46+(i*7)%(h*.5),8,1,'#a5e0e2');px.disc(g,x+w*.78,y+h*.19,6,'#fff8d5');};\nG.plant=(r,x,y,s=1)=>{r.shape('pot',x,y,0,{scale:s,mats:{c:'retreatWhite'}});r.queue(x,y,0,g=>{const p=r.w(x,y,9*s);for(let i=0;i<7;i++){const a=i*.63-3.3,dx=Math.cos(a)*10*s,dy=-Math.abs(Math.sin(a))*14*s;px.line(g,p[0],p[1],p[0]+dx,p[1]+dy,'#699a83',2);px.ell(g,p[0]+dx,p[1]+dy,4*s,2*s,i%2?'#8abd96':'#659c85');}});};\nG.light=(dusk=false)=>{const game=G.game;game.lights.enabled=true;game.lights.ambient=dusk?.72:.98;game.cam.bounds=null;game.follow(null);game.cam.offset=[0,0];game.focus(0,0,20);};\nG.mat=(r,x,y,color)=>{r.shape('mat',x,y,0,{mats:{a:{color:color||'#8bc8c8',pattern:'cloth'}}});};\n})();\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"cat > game/activities/common.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,{clamp}=E;\nG.makeContext=(id,tier=1,opts={})=>{\n const a=G.activities[id];if(\"'!a)throw new Error('\"'Unknown activity '+id);\n const ctx={a,tier,time:0,duration:opts.duration||a.duration*(tier===2&&a.family==='rep'?1.5:1),rng:opts.rng||E.rng(opts.seed||18371),seed:opts.seed||18371,done:false,cheat:opts.cheat||false,contestants:[],duel:opts.duel||false,tierData:{...a.tiers[tier-1]},...opts};\n const people=opts.contestants||[{name:G.member.name,color:G.palette.coral,input:G.game.input,local:true}];\n people.forEach((p,i)=>{const seed=Math.floor(ctx.rng()*1e8),c={...p,seed,intent:G.emptyIntent(),bal:new G.Balance(ctx.tierData,E.rng(seed)),rig:p.rig||G.playerRig(people.length>1?1.45:1.9),score:0,data:{},phase:0};ctx.contestants.push(c);G.families[a.family].setup?.(ctx,c);});return ctx;\n};\nG.stepContext=(ctx,dt,skill)=>{\n if(ctx.done)return;ctx.time+=dt;\n for(const c of ctx.contestants){const bot=c.bot||skill; if(bot==='passive')c.intent=G.emptyIntent();else if(bot)G.families[ctx.a.family].bot(ctx,c,dt,bot);else G.readIntent(c,dt,ctx);\n  G.families[ctx.a.family].update(ctx,c,dt);const r=ctx.a.result(ctx,c);c.score=clamp(Math.round(r.pct*1000),0,1000);\n }\n ctx.done=ctx.time>=ctx.duration||ctx.contestants.every(c=>c.finished);\n};\nG.animateContestant=(ctx,c,dt)=>{\n const a=ctx.a,d=c.data,b=c.bal;let pose=a.pose,body=null,scrub,clip;\n if(a.id==='flow'){const names=['lunge','dog','triangle','warrior','stork'];pose=names[Math.min(4,Math.floor(ctx.time/16))];}\n if(a.family==='rep'){scrub=d.depth;if(a.id==='lunge')body=G.sideLunge(b.x);}\n if(a.family==='hoop')body=G.hula(d.angle||0);\n if(a.family==='step')body=G.stepUp(d.stepAnim>0?Math.sin(Math.min(1,d.stepAnim/.4)*Math.PI):0);\n if(b.stumble>0)clip='Hop_One_Foot_Loop';\n const multi=ctx.contestants.length>1,x=multi?(ctx.contestants.indexOf(c)-(ctx.contestants.length-1)/2)*55:ctx.duel?-42:-12,y=4;\n c.worldX=x;c.worldY=y;\n G.poseRig(c.rig,pose,ctx.time,{dt,x,y,wob:a.family==='rep'?[b.x*.3,0]:[b.x,b.y],body,scrub,clip,fall:b.stumble>0,facing:a.family==='jog'||a.family==='slalom'?-1.57:undefined});\n};\nG.finishRegistry=()=>{for(const a of Object.values(G.activities)){const f=G.families[a.family];for(const k of ['setup','update','draw','hud','bot','result'])a[k]=f[k]||(()=>{});a.ghost=(ctx,c=ctx.contestants[0])=>({l:[c.bal.x,c.bal.y],p:c.phase,w:[c.worldX||0,c.worldY||0],s:c.score});}};\n})();\nEOF\ncat > game/activities/hold.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,{px,clamp}=E;\nG.families.hold={\n setup(ctx,c){c.data.breathTime=0;c.data.pushSign=ctx.rng()<.5?-1:1;c.data.lastPush=0;c.data.lastGull=-1;},\n bot(ctx,c,dt,skill){G.balanceBot(c,skill,dt);if(ctx.a.id==='flow'){const guide=.5-.5*Math.cos(ctx.time*Math.PI/4);c.intent.breath=clamp(guide+(skill==='poor'?.27:skill==='average'?.15:.02)*Math.sin(ctx.time*1.2),0,1);}},\n update(ctx,c,dt){const b=c.bal,d=c.data,t=ctx.time,flow=ctx.a.id==='flow';\n  const phase=Math.floor(t/12);b.target=flow?[0,0]:[[0,0],[.07,.03],[-.06,.05],[.04,-.04]][phase%4];\n  const every=ctx.tier===2?6:7,push=Math.floor(t/every);if(push>d.lastPush){d.lastPush=push;const angle=ctx.rng()*6.28;b.vx+=Math.cos(angle)*.6*G.DEV.push;b.vy+=Math.sin(angle)*.6*G.DEV.push;}\n  const gull=\"'!flow&&t%18>8&&t%18<12;d.gull=gull;if(gull&&d.lastGull!==Math.floor(t/18)){d.lastGull=Math.floor(t/18);if(G.context===ctx)G.game.audio.sfx('\"'gull');}\n  b.step(dt,c.intent,{fx:gull?d.pushSign*2.5:0,noFalls:ctx.cheat,fall:()=>{if(G.context===ctx){G.game.audio.sfx('stumble');c.input?.rumble(.35,.18);}}});\n  if(flow){d.guide=.5-.5*Math.cos(t*Math.PI/4);if(Math.abs(c.intent.breath-d.guide)<.25)d.breathTime+=dt;}\n  G.animateContestant(ctx,c,dt);\n },\n result(ctx,c){const b=c.bal,d=c.data;const pct=ctx.a.id==='flow'?.6*b.steadiness+.4*d.breathTime/Math.max(.01,ctx.time):b.steadiness-.05*b.falls;return {pct:clamp(pct,0,1),detail:Math.round(b.steadiness*100)+'% steady · '+b.falls+' stumbles'};},\n draw(r,ctx){for(const c of ctx.contestants){if(c.data.gull){const p=r.w(c.worldX+20*c.data.pushSign,4,44);r.queue(c.worldX,4,44,g=>{px.ell(g,p[0],p[1],4,3,'#f9fcfc');px.line(g,p[0]-7,p[1]-1,p[0]+6,p[1]+2,'#9caebb',2);px.poly(g,[[p[0]+3,p[1]],[p[0]+7,p[1]+1],[p[0]+3,p[1]+2]],'#e7b25d');});}}},\n hud(r,ctx){if(ctx.a.id==='flow'){const d=ctx.contestants[0].data; r.overlay(g=>{const x=r.W-59,y=104;px.disc(g,x,y,12+d.guide*12,'#dfefeb');px.disc(g,x,y,9+d.guide*11,'#bfe6d7');px.disc(g,x,y,5+ctx.contestants[0].intent.breath*15,'#74bfb5');G.text(g,Math.sin(ctx.time*Math.PI/4)>0?'Breathe in':'Breathe out',x,136,{align:'center'});});}}\n};\n})();\nEOF\ncat > game/activities/candle.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,{px,clamp}=E;\nG.families.candle={\n setup(ctx,c){c.data={flame:1,mean:0,relights:0,pushIndex:-1,thought:0,fx:0,fy:0};},\n bot(ctx,c,dt,skill){G.balanceBot(c,skill,dt);},\n update(ctx,c,dt){const b=c.bal,d=c.data,t=ctx.time,part=Math.floor(t/7);\n  if(part\"'!==d.pushIndex){d.pushIndex=part;d.thought=Math.floor(ctx.rng()*G.lines.thoughts.length);const a=ctx.rng()*6.28;d.fx=Math.cos(a)*(3+ctx.rng()*2);d.fy=Math.sin(a)*(3+ctx.rng()*2);}\n  const thought=t%7>2&&t%7<4.5;d.thinking=thought;b.step(dt,c.intent,{fx:thought?d.fx:0,fy:thought?d.fy:0,noFalls:ctx.cheat});\n  const speed=Math.hypot(b.vx,b.vy);d.flame=clamp(d.flame+(speed>.55?-.4:b.inRing?.12:-.05)*dt,0,1);d.mean+=d.flame*dt;\n  if(d.flame<=0){if(d.relights===0){d.relights++;d.flame=.85;b.x=b.y=b.vx=b.vy=0;}else{c.finished=true;d.flame=0;}}\n  if(ctx.cheat)d.flame=Math.max(.55,d.flame);\n  if(ctx.duel)d.opponent=t<75?1:Math.max(0,1-(t-75)*.09*(d.flame>.5?1:0));\n  G.animateContestant(ctx,c,dt);\n },\n result(ctx,c){const b=c.bal,d=c.data;return {pct:clamp(.6*b.steadiness+.4*d.mean/Math.max(.01,ctx.time)-.15*d.relights,0,1),detail:Math.round(d.flame*100)+'\"'% flame · '+Math.round(b.steadiness*100)+'% steady'};},\n draw(r,ctx){for(const c of ctx.contestants){G.candle(r,c.worldX+18,18,c.data.flame,ctx.time);}if(ctx.duel)G.candle(r,64,18,ctx.contestants[0].data.opponent??1,ctx.time);},\n hud(r,ctx){const d=ctx.contestants[0].data;if(d.thinking)r.overlay(g=>{const s=G.lines.thoughts[d.thought],w=Math.min(r.W-40,E.font.width(s)+18),x=(r.W-w)/2;G.round(g,x,61,w,20,'#ffffff');G.text(g,s,r.W/2,68,{align:'center',color:G.palette.muted});});}\n};\nG.candle=(r,x,y,flame,t)=>r.queue(x,y,0,g=>{const p=r.w(x,y,0),fx=p[0],fy=p[1];px.ell(g,fx,fy,7,2,'#9db0ae');px.rect(g,fx-3,fy-10,6,10,'#f0db9b');px.rect(g,fx-2,fy-10,2,9,'#fff0c1');px.line(g,fx,fy-11,fx,fy-13,'#776956');if(flame>0){const h=4+flame*8,w=2+Math.sin(t*9)*.4;px.ell(g,fx,fy-13-h*.4,w+1,h*.6,'#f2b667');px.ell(g,fx-.5,fy-13-h*.3,w*.6,h*.37,'#fff3be');G.game.lights.add(x,y,9,25,.3,{color:'#ffdc9a'});}});\n})();\nEOF\ncat > game/activities/rep.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,{px,clamp}=E;\nG.repBead=(ctx,t)=>{if(ctx.a.id==='lunge')return Math.sin(t*Math.PI/2)*.76;const period=ctx.tier===2?5:4,u=(t%period)/period;return ctx.tier===2?(u<.6?u/.6*.88:u<.8?.88:(1-u)/.2*.88):(.5-.5*Math.cos(t*Math.PI/2))*.88;};\nG.families.rep={\n setup(ctx,c){c.data={depth:0,bead:0,error:0,repError:0,repTime:0,form:0,reps:0,repScore:0,bonus:false,judgment:'Follow the bead',fatigue:0};},\n bot(ctx,c,dt,skill){const target=G.repBead(ctx,ctx.time+(skill==='expert'?.22:skill==='good'?.15:skill==='average'?-.01:-.18)),prev=G.repBead(ctx,ctx.time-dt),vel=(G.repBead(ctx,ctx.time+dt)-prev)/(2*dt),b=c.bal,side=ctx.a.id==='lunge';let u=target+.38*vel;const noise=skill==='poor'?.19:skill==='average'?.10:skill==='good'?.035:.01;u+=noise*Math.sin(ctx.time*2.7+c.seed);if(side){c.intent.x=clamp(u,-1,1);c.intent.y=0;}else{c.intent.y=-clamp(u,0,.99);c.intent.x=noise*.3*Math.sin(ctx.time);}},\n update(ctx,c,dt){const d=c.data,b=c.bal,side=ctx.a.id==='lunge';d.bead=G.repBead(ctx,ctx.time);d.fatigue=clamp((ctx.time/ctx.duration-.6)/.4,0,1)*G.DEV.fatigue;\n  const oldA=b.params.A,oldK=b.params.k;b.params.A*=1+d.fatigue;b.params.k*=1-.13*d.fatigue;\n  b.step(dt,c.intent,{mainY:\"'!side,mainX:side,s:8,noFalls:true});b.params.A=oldA;b.params.k=oldK;\n  d.depth=side?b.x:clamp(-b.y,0,1);const err=Math.abs(d.depth-d.bead);d.error+=err*dt;d.repError+=err*dt;d.repTime+=dt;d.form+=Math.abs(side?b.y:b.x)*dt;\n  const n=Math.floor(ctx.time/(ctx.tier===2?5:4));if(n>d.reps){const mean=d.repError/Math.max(.01,d.repTime),v=clamp(1-(mean-G.DEV.repTolerance)/.27,0,1);d.repScore+=v;d.reps=n;d.judgment=v>.9?'\"'Perfect':v>.5?'Good':'Late';d.repError=d.repTime=0;if(G.context===ctx)G.babble(G.member.instructor,'ho');}\n  if(\"'!d.bonus&&ctx.time>=ctx.duration-.1&&d.repScore/Math.max(1,d.reps)>.8&&!ctx.fixedDuration){d.bonus=true;ctx.duration+=(ctx.tier===2?5:4)*2;d.judgment='\"'Two more. Very good.';}\n  G.animateContestant(ctx,c,dt);\n },\n result(ctx,c){const d=c.data,mean=d.error/Math.max(.01,ctx.time),quality=clamp(1-(mean-G.DEV.repTolerance)/.27,0,1);return {pct:quality*(1-Math.min(.3,d.form/Math.max(.01,ctx.time)*.5)),detail:d.reps+' reps · '+Math.round(quality*100)+'% on the rail'};},\n draw(){},\n hud(r,ctx){const c=ctx.contestants[0],d=c.data;r.overlay(g=>{const x=r.W-66,y=72,h=83,side=ctx.a.id==='lunge';G.round(g,x-21,y-8,44,h+37,'#f7fbfa');\n  if(side){const xx=x-24,yy=y+40;px.line(g,xx,yy,xx+48,yy,'#c2d4d7',3);px.disc(g,xx+24+d.bead*24,yy,5,'#d3ad54');px.disc(g,xx+24+d.depth*24,yy,3,'#227d8d');}\n  else {px.line(g,x,y,x,y+h,'#c2d4d7',3);px.disc(g,x,y+d.bead*h,5,'#e4bc65');px.disc(g,x,y+d.depth*h,3,'#227d8d');}\n  G.text(g,String(d.reps),x,y+h+6,{scale:2,align:'center'});G.text(g,'reps',x,y+h+23,{align:'center',color:G.palette.muted});G.text(g,d.judgment,r.W/2,55,{align:'center',color:G.palette.cyan});if(d.fatigue>.15)G.text(g,'Working muscles',18,r.H-54,{color:G.palette.muted});});}\n};\n})();\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"cat > game/activities/common.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,{clamp}=E;\nG.makeContext=(id,tier=1,opts={})=>{\n const a=G.activities[id];if(\"'!a)throw new Error('\"'Unknown activity '+id);\n const ctx={a,tier,time:0,duration:opts.duration||a.duration*(tier===2&&a.family==='rep'?1.5:1),rng:opts.rng||E.rng(opts.seed||18371),seed:opts.seed||18371,done:false,cheat:opts.cheat||false,contestants:[],duel:opts.duel||false,tierData:{...a.tiers[tier-1]},...opts};\n const people=opts.contestants||[{name:G.member.name,color:G.palette.coral,input:G.game.input,local:true}];\n people.forEach((p,i)=>{const seed=Math.floor(ctx.rng()*1e8),c={...p,seed,intent:G.emptyIntent(),bal:new G.Balance(ctx.tierData,E.rng(seed)),rig:p.rig||G.playerRig(people.length>1?1.45:1.9),score:0,data:{},phase:0};ctx.contestants.push(c);G.families[a.family].setup?.(ctx,c);});return ctx;\n};\nG.stepContext=(ctx,dt,skill)=>{\n if(ctx.done)return;ctx.time+=dt;\n for(const c of ctx.contestants){const bot=c.bot||skill; if(bot==='passive')c.intent=G.emptyIntent();else if(bot)G.families[ctx.a.family].bot(ctx,c,dt,bot);else G.readIntent(c,dt,ctx);\n  G.families[ctx.a.family].update(ctx,c,dt);const r=ctx.a.result(ctx,c);c.score=clamp(Math.round(r.pct*1000),0,1000);\n }\n ctx.done=ctx.time>=ctx.duration||ctx.contestants.every(c=>c.finished);\n};\nG.animateContestant=(ctx,c,dt)=>{\n const a=ctx.a,d=c.data,b=c.bal;let pose=a.pose,body=null,scrub,clip;\n if(a.id==='flow'){const names=['lunge','dog','triangle','warrior','stork'];pose=names[Math.min(4,Math.floor(ctx.time/16))];}\n if(a.family==='rep'){scrub=d.depth;if(a.id==='lunge')body=G.sideLunge(b.x);}\n if(a.family==='hoop')body=G.hula(d.angle||0);\n if(a.family==='step')body=G.stepUp(d.stepAnim>0?Math.sin(Math.min(1,d.stepAnim/.4)*Math.PI):0);\n if(b.stumble>0)clip='Hop_One_Foot_Loop';\n const multi=ctx.contestants.length>1,x=multi?(ctx.contestants.indexOf(c)-(ctx.contestants.length-1)/2)*55:ctx.duel?-42:-12,y=4;\n c.worldX=x;c.worldY=y;\n G.poseRig(c.rig,pose,ctx.time,{dt,x,y,wob:a.family==='rep'?[b.x*.3,0]:[b.x,b.y],body,scrub,clip,fall:b.stumble>0,facing:a.family==='jog'||a.family==='slalom'?-1.57:undefined});\n};\nG.finishRegistry=()=>{for(const a of Object.values(G.activities)){const f=G.families[a.family];for(const k of ['setup','update','draw','hud','bot','result'])a[k]=f[k]||(()=>{});a.ghost=(ctx,c=ctx.contestants[0])=>({l:[c.bal.x,c.bal.y],p:c.phase,w:[c.worldX||0,c.worldY||0],s:c.score});}};\n})();\nEOF\ncat > game/activities/hold.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,{px,clamp}=E;\nG.families.hold={\n setup(ctx,c){c.data.breathTime=0;c.data.pushSign=ctx.rng()<.5?-1:1;c.data.lastPush=0;c.data.lastGull=-1;},\n bot(ctx,c,dt,skill){G.balanceBot(c,skill,dt);if(ctx.a.id==='flow'){const guide=.5-.5*Math.cos(ctx.time*Math.PI/4);c.intent.breath=clamp(guide+(skill==='poor'?.27:skill==='average'?.15:.02)*Math.sin(ctx.time*1.2),0,1);}},\n update(ctx,c,dt){const b=c.bal,d=c.data,t=ctx.time,flow=ctx.a.id==='flow';\n  const phase=Math.floor(t/12);b.target=flow?[0,0]:[[0,0],[.07,.03],[-.06,.05],[.04,-.04]][phase%4];\n  const every=ctx.tier===2?6:7,push=Math.floor(t/every);if(push>d.lastPush){d.lastPush=push;const angle=ctx.rng()*6.28;b.vx+=Math.cos(angle)*.6*G.DEV.push;b.vy+=Math.sin(angle)*.6*G.DEV.push;}\n  const gull=\"'!flow&&t%18>8&&t%18<12;d.gull=gull;if(gull&&d.lastGull!==Math.floor(t/18)){d.lastGull=Math.floor(t/18);if(G.context===ctx)G.game.audio.sfx('\"'gull');}\n  b.step(dt,c.intent,{fx:gull?d.pushSign*2.5:0,noFalls:ctx.cheat,fall:()=>{if(G.context===ctx){G.game.audio.sfx('stumble');c.input?.rumble(.35,.18);}}});\n  if(flow){d.guide=.5-.5*Math.cos(t*Math.PI/4);if(Math.abs(c.intent.breath-d.guide)<.25)d.breathTime+=dt;}\n  G.animateContestant(ctx,c,dt);\n },\n result(ctx,c){const b=c.bal,d=c.data;const pct=ctx.a.id==='flow'?.6*b.steadiness+.4*d.breathTime/Math.max(.01,ctx.time):b.steadiness-.05*b.falls;return {pct:clamp(pct,0,1),detail:Math.round(b.steadiness*100)+'% steady · '+b.falls+' stumbles'};},\n draw(r,ctx){for(const c of ctx.contestants){if(c.data.gull){const p=r.w(c.worldX+20*c.data.pushSign,4,44);r.queue(c.worldX,4,44,g=>{px.ell(g,p[0],p[1],4,3,'#f9fcfc');px.line(g,p[0]-7,p[1]-1,p[0]+6,p[1]+2,'#9caebb',2);px.poly(g,[[p[0]+3,p[1]],[p[0]+7,p[1]+1],[p[0]+3,p[1]+2]],'#e7b25d');});}}},\n hud(r,ctx){if(ctx.a.id==='flow'){const d=ctx.contestants[0].data; r.overlay(g=>{const x=r.W-59,y=104;px.disc(g,x,y,12+d.guide*12,'#dfefeb');px.disc(g,x,y,9+d.guide*11,'#bfe6d7');px.disc(g,x,y,5+ctx.contestants[0].intent.breath*15,'#74bfb5');G.text(g,Math.sin(ctx.time*Math.PI/4)>0?'Breathe in':'Breathe out',x,136,{align:'center'});});}}\n};\n})();\nEOF\ncat > game/activities/candle.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,{px,clamp}=E;\nG.families.candle={\n setup(ctx,c){c.data={flame:1,mean:0,relights:0,pushIndex:-1,thought:0,fx:0,fy:0};},\n bot(ctx,c,dt,skill){G.balanceBot(c,skill,dt);},\n update(ctx,c,dt){const b=c.bal,d=c.data,t=ctx.time,part=Math.floor(t/7);\n  if(part\"'!==d.pushIndex){d.pushIndex=part;d.thought=Math.floor(ctx.rng()*G.lines.thoughts.length);const a=ctx.rng()*6.28;d.fx=Math.cos(a)*(3+ctx.rng()*2);d.fy=Math.sin(a)*(3+ctx.rng()*2);}\n  const thought=t%7>2&&t%7<4.5;d.thinking=thought;b.step(dt,c.intent,{fx:thought?d.fx:0,fy:thought?d.fy:0,noFalls:ctx.cheat});\n  const speed=Math.hypot(b.vx,b.vy);d.flame=clamp(d.flame+(speed>.55?-.4:b.inRing?.12:-.05)*dt,0,1);d.mean+=d.flame*dt;\n  if(d.flame<=0){if(d.relights===0){d.relights++;d.flame=.85;b.x=b.y=b.vx=b.vy=0;}else{c.finished=true;d.flame=0;}}\n  if(ctx.cheat)d.flame=Math.max(.55,d.flame);\n  if(ctx.duel)d.opponent=t<75?1:Math.max(0,1-(t-75)*.09*(d.flame>.5?1:0));\n  G.animateContestant(ctx,c,dt);\n },\n result(ctx,c){const b=c.bal,d=c.data;return {pct:clamp(.6*b.steadiness+.4*d.mean/Math.max(.01,ctx.time)-.15*d.relights,0,1),detail:Math.round(d.flame*100)+'\"'% flame · '+Math.round(b.steadiness*100)+'% steady'};},\n draw(r,ctx){for(const c of ctx.contestants){G.candle(r,c.worldX+18,18,c.data.flame,ctx.time);}if(ctx.duel)G.candle(r,64,18,ctx.contestants[0].data.opponent??1,ctx.time);},\n hud(r,ctx){const d=ctx.contestants[0].data;if(d.thinking)r.overlay(g=>{const s=G.lines.thoughts[d.thought],w=Math.min(r.W-40,E.font.width(s)+18),x=(r.W-w)/2;G.round(g,x,61,w,20,'#ffffff');G.text(g,s,r.W/2,68,{align:'center',color:G.palette.muted});});}\n};\nG.candle=(r,x,y,flame,t)=>r.queue(x,y,0,g=>{const p=r.w(x,y,0),fx=p[0],fy=p[1];px.ell(g,fx,fy,7,2,'#9db0ae');px.rect(g,fx-3,fy-10,6,10,'#f0db9b');px.rect(g,fx-2,fy-10,2,9,'#fff0c1');px.line(g,fx,fy-11,fx,fy-13,'#776956');if(flame>0){const h=4+flame*8,w=2+Math.sin(t*9)*.4;px.ell(g,fx,fy-13-h*.4,w+1,h*.6,'#f2b667');px.ell(g,fx-.5,fy-13-h*.3,w*.6,h*.37,'#fff3be');G.game.lights.add(x,y,9,25,.3,{color:'#ffdc9a'});}});\n})();\nEOF\ncat > game/activities/rep.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,{px,clamp}=E;\nG.repBead=(ctx,t)=>{if(ctx.a.id==='lunge')return Math.sin(t*Math.PI/2)*.76;const period=ctx.tier===2?5:4,u=(t%period)/period;return ctx.tier===2?(u<.6?u/.6*.88:u<.8?.88:(1-u)/.2*.88):(.5-.5*Math.cos(t*Math.PI/2))*.88;};\nG.families.rep={\n setup(ctx,c){c.data={depth:0,bead:0,error:0,repError:0,repTime:0,form:0,reps:0,repScore:0,bonus:false,judgment:'Follow the bead',fatigue:0};},\n bot(ctx,c,dt,skill){const target=G.repBead(ctx,ctx.time+(skill==='expert'?.22:skill==='good'?.15:skill==='average'?-.01:-.18)),prev=G.repBead(ctx,ctx.time-dt),vel=(G.repBead(ctx,ctx.time+dt)-prev)/(2*dt),b=c.bal,side=ctx.a.id==='lunge';let u=target+.38*vel;const noise=skill==='poor'?.19:skill==='average'?.10:skill==='good'?.035:.01;u+=noise*Math.sin(ctx.time*2.7+c.seed);if(side){c.intent.x=clamp(u,-1,1);c.intent.y=0;}else{c.intent.y=-clamp(u,0,.99);c.intent.x=noise*.3*Math.sin(ctx.time);}},\n update(ctx,c,dt){const d=c.data,b=c.bal,side=ctx.a.id==='lunge';d.bead=G.repBead(ctx,ctx.time);d.fatigue=clamp((ctx.time/ctx.duration-.6)/.4,0,1)*G.DEV.fatigue;\n  const oldA=b.params.A,oldK=b.params.k;b.params.A*=1+d.fatigue;b.params.k*=1-.13*d.fatigue;\n  b.step(dt,c.intent,{mainY:\"'!side,mainX:side,s:8,noFalls:true});b.params.A=oldA;b.params.k=oldK;\n  d.depth=side?b.x:clamp(-b.y,0,1);const err=Math.abs(d.depth-d.bead);d.error+=err*dt;d.repError+=err*dt;d.repTime+=dt;d.form+=Math.abs(side?b.y:b.x)*dt;\n  const n=Math.floor(ctx.time/(ctx.tier===2?5:4));if(n>d.reps){const mean=d.repError/Math.max(.01,d.repTime),v=clamp(1-(mean-G.DEV.repTolerance)/.27,0,1);d.repScore+=v;d.reps=n;d.judgment=v>.9?'\"'Perfect':v>.5?'Good':'Late';d.repError=d.repTime=0;if(G.context===ctx)G.babble(G.member.instructor,'ho');}\n  if(\"'!d.bonus&&ctx.time>=ctx.duration-.1&&d.repScore/Math.max(1,d.reps)>.8&&!ctx.fixedDuration){d.bonus=true;ctx.duration+=(ctx.tier===2?5:4)*2;d.judgment='\"'Two more. Very good.';}\n  G.animateContestant(ctx,c,dt);\n },\n result(ctx,c){const d=c.data,mean=d.error/Math.max(.01,ctx.time),quality=clamp(1-(mean-G.DEV.repTolerance)/.27,0,1);return {pct:quality*(1-Math.min(.3,d.form/Math.max(.01,ctx.time)*.5)),detail:d.reps+' reps · '+Math.round(quality*100)+'% on the rail'};},\n draw(){},\n hud(r,ctx){const c=ctx.contestants[0],d=c.data;r.overlay(g=>{const x=r.W-66,y=72,h=83,side=ctx.a.id==='lunge';G.round(g,x-21,y-8,44,h+37,'#f7fbfa');\n  if(side){const xx=x-24,yy=y+40;px.line(g,xx,yy,xx+48,yy,'#c2d4d7',3);px.disc(g,xx+24+d.bead*24,yy,5,'#d3ad54');px.disc(g,xx+24+d.depth*24,yy,3,'#227d8d');}\n  else {px.line(g,x,y,x,y+h,'#c2d4d7',3);px.disc(g,x,y+d.bead*h,5,'#e4bc65');px.disc(g,x,y+d.depth*h,3,'#227d8d');}\n  G.text(g,String(d.reps),x,y+h+6,{scale:2,align:'center'});G.text(g,'reps',x,y+h+23,{align:'center',color:G.palette.muted});G.text(g,d.judgment,r.W/2,55,{align:'center',color:G.palette.cyan});if(d.fatigue>.15)G.text(g,'Working muscles',18,r.H-54,{color:G.palette.muted});});}\n};\n})();\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"cat > game/data/lines.js <<'EOF'\n(() => {\nconst G=window.G;\nG.lines={\n arrival:[\\\"You have been gifted a five-day stay at the Institute for Gentle Improvement.\\\",\\\"The card isn't signed. It only says: 'You know why.'\\\",\\\"I am Tare. Please make yourself comfortable. On me, preferably.\\\",\\\"Gently, or not at all. We have had the signs made.\\\"],\n ending:[\\\"I should tell you something. The card. The one that wasn't signed.\\\",\\\"That was me. I don't have hands. It took three years.\\\",\\\"I sent one to everybody. You're the one who came.\\\",\\\"Now step off. Go on. I'll be here.\\\",\\\"I'm a scale. That's the whole job.\\\"],\n tare:[\n \\\"Oh\"'! Feet. Good morning, feet.\",\"You came back. I wasn'\"'t worried. I was just standing here, on the floor, where I live.\\\",\\\"It has been one day since you last stepped on me. I counted it twice to be sure.\\\",\\\"Please stand still. Stiller. That was the wrong way.\\\",\\\"You lean beautifully. Like a tower people visit.\\\",\\\"You put more weight on your left foot. Your right foot has noticed.\\\",\\\"I am not allowed to say whether this is good. It is a number.\\\",\\\"You are my favorite. You are also my only.\\\",\\\"Are you still there? I can feel you not standing on me.\\\",\\\"Let's call it 71. It doesn't go higher. It's not allowed.\\\",\\\"Gerald has swallowed your minutes. He looks pleased. He always looks like that. He's ceramic.\\\",\\\"Sleep well. I'll be out here. In the dark. Being accurate.\\\",\\\"Gentle Mode is on. I won't tell anyone. I don't know anyone.\\\",\\\"Your feet have arrived together. That is already teamwork.\\\",\\\"I have prepared a space. It is the same space. It was already prepared.\\\",\\\"The floor is level. We check it on Tuesdays.\\\",\\\"That was a very considered wobble.\\\",\\\"Your right ankle has submitted a small complaint.\\\",\\\"I do not take sides. Except when you lean.\\\",\\\"You have been standing for several seconds. I am keeping a record.\\\",\\\"Nobody asked me how I am. I am calibrated.\\\",\\\"Please remove your doubts. Shoes are fine.\\\",\\\"The sea is moving. This is not part of your score.\\\",\\\"A gull has joined your session. It has not paid.\\\",\\\"I have no pockets. Please do not give me your keys.\\\",\\\"Your centre is somewhere in the middle. We can narrow it down.\\\",\\\"The bench has been still all morning. Do not feel pressured.\\\",\\\"I counted your breaths. You may keep them.\\\",\\\"Gertrude is nineteen in the spine. Everywhere else is private.\\\",\\\"I am proud. It is not in my specifications.\\\",\\\"You look rested. I have not moved since yesterday.\\\",\\\"We have a plateau. It is a feature of the island.\\\",\\\"I saved your progress. I would have remembered anyway.\\\",\\\"There is water at the water cooler. It is very consistent.\\\",\\\"You may take your time. I have all of it.\\\",\\\"One foot. Then the other, if necessary.\\\",\\\"The mat is clean. It has been waiting very politely.\\\",\\\"Your Spine Age is a number. It is not a birthday invitation.\\\",\\\"I have been thinking about ducks again.\\\",\\\"A small improvement is still the full size of itself.\\\",\\\"You can begin again. I find this reassuring.\\\",\\\"You have an excellent relationship with gravity. Complicated, but excellent.\\\",\\\"The instructor has no knees to speak of. Please do not compare.\\\",\\\"I put a star on a mat. It is for you. Or anyone. You.\\\",\\\"A day has passed. You have collected most of it.\\\",\\\"Please keep your expectations at shoulder height.\\\",\\\"I did not weigh your lunch. It was not standing on me.\\\",\\\"The breeze is complimentary. So am I, sometimes.\\\",\\\"Your shoulders have returned from somewhere.\\\",\\\"I can tell you are trying. The numbers keep twitching.\\\"\n ],\n results:[\n [\\\"You finished. Some people don't. Those people are probably at lunch.\\\",\\\"That was not your best. I'm saying that with love, and also as data.\\\",\\\"The floor was there for you. It has a good attendance record.\\\"],\n [\\\"Good effort\"'! I could tell it was effort.\",\"One star. A small sky has begun.\",\"That counts. I checked twice.\"],\n [\"Well done. I felt that. In a good way. Mostly.\",\"Two stars. The second one arrived very confidently.\",\"Gertrude has noticed. She has not said anything.\"],\n [\"You barely moved. For a moment I thought you had left me. Please don'\"'t do that.\\\",\\\"Three stars. I am trying to remain professional.\\\",\\\"That was lovely. I will be measuring it again in my thoughts.\\\"]\n ],\n fall:[\\\"You fell. That's okay. The floor was expecting you.\\\",\\\"A brief visit to the floor. Welcome back.\\\",\\\"We will call that a deep bow.\\\"],\n tips:[\\\"Tip: Drink water. Your body is mostly water. The rest is opinions.\\\",\\\"Tip: If you can't touch your toes, bring your toes closer.\\\",\\\"Tip: Stretch before bed. Or after bed. Or in bed. I am not in your bed.\\\",\\\"Tip: Sitting is just standing with fewer steps.\\\",\\\"Tip: Small nudges are easier to take back.\\\",\\\"Tip: The ring is a suggestion. A very measurable suggestion.\\\",\\\"Tip: Let your shoulders leave your ears.\\\",\\\"Tip: Breathe out. There will be more air.\\\",\\\"Tip: Hold the squat halfway. Your body will wait for you.\\\",\\\"Tip: A quiet flame likes a quiet correction.\\\",\\\"Tip: Listen for the click. Music is shy here.\\\",\\\"Tip: The mouse is your thumb, spread over a table.\\\",\\\"Tip: A stitch means you have arrived too quickly.\\\",\\\"Tip: Watch the sock before you feel the gust.\\\",\\\"Tip: Extra hoops require extra circles.\\\",\\\"Tip: You cannot spend your minutes. Gerald has them now.\\\"],\n Birch:[\\\"Welcome. I am Birch. I'm made of wood, so I will be very patient and slightly warped.\\\",\\\"Breathe in. I don't breathe. But I've read about it, and it sounds very good.\\\",\\\"Keep your back straight. Mine was sanded.\\\",\\\"Nice. Now hold that until it stops being nice.\\\",\\\"You're shaking. This means it's working. Or you're cold.\\\",\\\"Two more. I said that two reps ago. It is still true.\\\",\\\"Let your knees remember where your feet are.\\\",\\\"We will lower slowly. There is plenty of down.\\\",\\\"There. That is an acceptable amount of tree.\\\",\\\"The movement ends when you do. I am very patient.\\\",\\\"Your balance is coming along. Mine was attached.\\\",\\\"I have added two repetitions. They seemed lonely.\\\",\\\"A small circle. Now make another, without stopping.\\\",\\\"Be kind to your ankles. They live a long way from your face.\\\",\\\"The next pose is a triangle. We have counted its sides.\\\",\\\"Please stand tall. Within your own dimensions.\\\",\\\"The wood remembers the forest. I mostly remember the workshop.\\\",\\\"Rest. The effort will still be here after.\\\"],\n Alder:[\\\"Hello\"'! I'\"'m Alder. I was a tree, and then I was a lot of very small decisions.\\\",\\\"Wonderful\"'! You'\"'re doing so well. Please stop shaking.\\\",\\\"Everybody's body is different. Yours is the one wobbling.\\\",\\\"Let's hold this for a moment. A moment is eleven seconds.\\\",\\\"Smile. It relaxes the jaw. Not like that.\\\",\\\"This next pose is the Stork. I knew a stork. We didn't speak.\\\",\\\"Let the breath grow. Now let it leave.\\\",\\\"Your feet are doing a very thoughtful job.\\\",\\\"That was nearly graceful. Nearly is a place.\\\",\\\"I have no lungs. I am still encouraging yours.\\\",\\\"The mat will support you. It was purchased for that.\\\",\\\"We will go the other way now. Both ways are available.\\\",\\\"You have a strong middle. It is holding everything else apart.\\\",\\\"Lovely. Your shoulders have agreed to come down.\\\",\\\"I was polished this morning. You are catching up.\\\",\\\"A little lower. The floor has been informed.\\\",\\\"There is no rush. Except the schedule, which we ignore kindly.\\\",\\\"Thank you for moving with me. I cannot do this on my own.\\\"],\n regulars:[\n [\\\"You're doing fine, dear. I've been standing here since Thursday.\\\",\\\"I'm eighty-seven. My spine is nineteen. We don't really talk.\\\",\\\"I walked the slalom. It was pleasant.\\\",\\\"I have a spare hat. I am waiting for the right spine.\\\",\\\"Well done, dear. I've been waiting since Thursday.\\\"],\n [\\\"I'm only here for the blender. Don't tell the scale.\\\",\\\"Olive?\\\",\\\"The olives belong in the glasses. I cannot say why.\\\",\\\"The gecko is on a break. It works elsewhere.\\\",\\\"I made juice. It has ingredients.\\\"],\n [\\\"Morning\"'! I'\"'ve already done today. I'm on to tomorrow.\\\",\\\"Keep beside me. The pigeons know the route.\\\",\\\"You can run slowly. It is still running.\\\",\\\"Water? I brought enough for the idea of thirst.\\\"],\n [\\\"Everybody calls me Young Kevin. There was an older Kevin. We don't talk about how he got so flexible.\\\",\\\"I have been young here for twelve years.\\\",\\\"The bench and I are getting acquainted.\\\"],\n [\\\"A hoop is just a circle that believes in you.\\\",\\\"Here comes another one. It believes in you too.\\\",\\\"Other way\"'! Both directions deserve a turn.\"],\n [\"I'\"'m on a five-minute break. It's been a good one. Three years in March.\\\",\\\"Wake me for the rest period.\\\",\\\"I am saving my energy. It is accumulating.\\\"],\n [\\\"We're not related.\\\",\\\"We've checked.\\\",\\\"We have the same towel. That happens.\\\"]\n ],\n thoughts:[\\\"Did you lock the door?\\\",\\\"What is a lumbar?\\\",\\\"Is that my knee?\\\",\\\"Dennis.\\\",\\\"You left the stove on in 2014.\\\",\\\"Who sent that card?\\\",\\\"Am I breathing right now?\\\",\\\"Now I'm breathing on purpose.\\\",\\\"Olive?\\\"],\n questions:[['Have you recently sat?','Yes','Define recently'],['Do stairs ever surprise you?','Often','Only the last one'],['Do you make a small noise when you stand up?','Yes','No (this is a lie)'],['On a scale of one to me, how do you feel?','One','Me'],['When did you last look at your feet?','Just now',\\\"I'd rather not\\\"]],\n replies:['Thank you. I have recorded this as sitting.','The last stair has been notified.','I heard that from Reception.','I will put down a number that means that.','Your feet say hello.'],\n attract:[\\\"Nobody's here. I'll just show the room what we do.\\\",\\\"Oh\"'! You'\"'re back. I wasn't doing anything.\\\",\\\"The empty room is doing rather well today.\\\"],\n early:[\\\"Leaving early? That's fine. I will just file this under 'Thursday.'\\\",\\\"Rest is an activity. Gerald does not accept it.\\\"],\n recalibration:['It is my turn on the scale. Please be gentle.','Three grams. It\\\\'s the feelings. They\\\\'re dense.','Thank you. Nobody has ever asked me to stand still before.'],\n finishAge:['Your spine has stopped asking questions.','Come back. Please. I mean that in a wellness way.','Gertrude has given you her spare hat. It fits the occasion.']\n};\nG.line=(bank,seed)=>{const a=G.lines[bank]||G.lines.tare;return a[Math.floor((seed===undefined?G.rng():seed)*a.length)%a.length];};\n})();\nEOF\ncat > game/scenes/session.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,P=G.palette,{px}=E,game=G.game;\nG.startSession=(id,tier=1,mode=G.mode,opts={})=>{G.mode=mode;G.pending={id,tier,mode,...opts};G.go('card',G.pending);};\nlet menu,preview,instructor;\nG.scenes.card={view:'brawler',camera:{zoom:false},pausable:true,\n enter(data){G.pending=data||G.pending;const a=G.activities[G.pending.id];G.sessionPhase='card';G.context=null;G.light();G.music(a.room==='iron'?'iron':a.id==='flow'?'yoga':'studio');preview=G.playerRig(1.8);instructor=G.instructorRig(undefined,1.5);\n  menu=new G.Pills([['Begin',()=>G.go('session',G.pending)],['Back',()=>G.go(G.mode==='story'?'island':G.mode==='class'?'classLobby':'catalog',{discipline:a.discipline})]],{x:14,y:()=>game.H-69,w:150,h:23,gap:7,back:()=>G.go(G.mode==='story'?'island':'catalog')});\n },\n update(dt){game.focus(0,0,20);const a=G