{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module - <<'JS'\nimport {chromium} from 'playwright';const b=await chromium.launch({headless:true});const p=await b.newPage({viewport:{width:1920,height:1080}});const errs=[];p.on('pageerror',e=>errs.push(e.message));await p.goto('file://'+process.cwd()+'/../'+process.cwd().split('/').at(-1)+'.html');await p.waitForTimeout(500);await p.evaluate(()=>{G.game.stop();G.game.fadeTime=0;});for(const id of ['stork','flow','candle','squat','pushup','lunge','step','hoop','jog','slalom','tray','laundry']){const r=await p.evaluate(id=>{G.startSession(id,1,'free');G.game.advance(.2);G.go('session',G.pending,true);G.game.advance(.1);G.beginPlay();G.dev.bot='expert';G.game.advance(12,{draw:false});G.game.advance(.01,{draw:true});return {snapshot:G.game.debug.snapshot(),errors:G.game.errors.map(e=>({where:e.where,message:e.message}))};},id);console.log(id,JSON.stringify(r));await p.screenshot({path:'tests/activity-'+id+'.png'});}console.log('pageerrors',errs);await b.close();\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module - <<'JS'\nimport {chromium} from 'playwright';const b=await chromium.launch({headless:true});const p=await b.newPage({viewport:{width:1920,height:1080}});const errs=[];p.on('pageerror',e=>errs.push(e.message));await p.goto('file://'+process.cwd()+'/../'+process.cwd().split('/').at(-1)+'.html');await p.waitForTimeout(500);await p.evaluate(()=>{G.game.stop();G.game.fadeTime=0;});for(const id of ['stork','flow','candle','squat','pushup','lunge','step','hoop','jog','slalom','tray','laundry']){const r=await p.evaluate(id=>{G.startSession(id,1,'free');G.game.advance(.2);G.go('session',G.pending,true);G.game.advance(.1);G.beginPlay();G.dev.bot='expert';G.game.advance(12,{draw:false});G.game.advance(.01,{draw:true});return {snapshot:G.game.debug.snapshot(),errors:G.game.errors.map(e=>({where:e.where,message:e.message}))};},id);console.log(id,JSON.stringify(r));await p.screenshot({path:'tests/activity-'+id+'.png'});}console.log('pageerrors',errs);await b.close();\nJS\"","aggregated_output":"stork {\"snapshot\":{\"scene\":\"session\",\"activity\":\"stork\",\"tier\":1,\"phase\":\"play\",\"day\":1,\"session\":0,\"pct\":0.9646079111727985,\"stars\":0,\"minutes\":0,\"spineAge\":71,\"lean\":[-0.05768406178081866,0.017016502355608195],\"source\":\"keyboard\",\"attract\":false,\"dev\":false,\"ended\":false,\"errors\":0},\"errors\":[]}\nflow {\"snapshot\":{\"scene\":\"session\",\"activity\":\"flow\",\"tier\":1,\"phase\":\"play\",\"day\":1,\"session\":0,\"pct\":1,\"stars\":0,\"minutes\":0,\"spineAge\":71,\"lean\":[-0.12598387298067884,0.00849585439432922],\"source\":\"keyboard\",\"attract\":false,\"dev\":false,\"ended\":false,\"errors\":0},\"errors\":[]}\ncandle {\"snapshot\":{\"scene\":\"session\",\"activity\":\"candle\",\"tier\":1,\"phase\":\"play\",\"day\":1,\"session\":0,\"pct\":0.748805270457712,\"stars\":0,\"minutes\":0,\"spineAge\":71,\"lean\":[-0.01084