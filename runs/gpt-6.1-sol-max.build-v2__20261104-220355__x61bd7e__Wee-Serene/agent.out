,null,2));\n // Required engine checker, captured so this command only prints failures and its final count.\n try{const output=execFileSync('node',['engine/tools/check.mjs',path.resolve('..',path.basename(process.cwd())+'.html'),'--seconds','2','--out','tests/engine-check'],{encoding:'utf8',timeout:90000});fs.writeFileSync('tests/engine-check-output.txt',output);T.check(true,'engine checker passes at 1280x720');}catch(e){T.check(false,'engine checker: '+String(e.stdout||e.message).slice(-1600));}\n}\nEOF\nnode tests/run.mjs hub\"","aggregated_output":"15 passed, 0 failed\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_71","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module - <<'JS'\nimport {load} from './tests/load.mjs';const {G}=load();for(const push of [0,.25,.4,.55]){let scores=[];for(let seed=1;seed<=12;seed++){const rng=G.E.rng(seed),b=new G.Balance({k:10,c:5,s:11,A:1.4,nf:.8,R:.2},rng),c={bal:b,intent:G.emptyIntent(),seed};let last=0;for(let i=0;i<5400;i++){G.balanceBot(c,'poor',1/120);if(Math.floor(b.t/5)>last){last++;const a=rng()*6.28;b.vx+=Math.cos(a)*push;b.vy+=Math.sin(a)*push;}b.step(1/120,c.intent);}scores.push(b.steadiness);}console.log(push,(scores.reduce((a,b)=>a+b)/12).toFixed(3));}\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
