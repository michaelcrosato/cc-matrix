{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module - <<'JS'\nimport {load} from './tests/load.mjs';const {G}=load();const old=G.balanceBot;for(const frequency of [.6,1,1.4]){G.balanceBot=(c,skill,dt)=>{const b=c.bal,q=G.BOTS[skill],seen=b.hist.find(h=>h.t>=b.t-q.tau)||b;if(\"'!c.nx){const rng=G.E.rng(c.seed);c.nx=G.noise(rng,frequency);c.ny=G.noise(rng,frequency);}const tx=-q.gain*seen.x-q.damp*seen.vx+q.noise*c.nx(b.t),ty=-q.gain*seen.y-q.damp*seen.vy+q.noise*c.ny(b.t);c.intent.x+=(tx-c.intent.x)*Math.min(1,dt*16);c.intent.y+=(ty-c.intent.y)*Math.min(1,dt*16);const n=Math.hypot(c.intent.x,c.intent.y);if(n>1){c.intent.x/=n;c.intent.y/=n;}};\n let tot=0;for(let seed=1;seed<=12;seed++){const b=new G.Balance({k:10,c:5,s:11,A:1.4,nf:.8,R:.2},G.E.rng(seed)),c={bal:b,intent:G.emptyIntent(),seed};for(let i=0;i<5400;i++){G.balanceBot(c,'\"'poor',1/120);b.step(1/120,c.intent);}tot+=b.steadiness;}console.log(frequency,tot/12);}\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
