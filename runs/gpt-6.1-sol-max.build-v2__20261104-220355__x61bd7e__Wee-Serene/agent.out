{"type":"item.completed","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"rg -n 'anyPressed' game && sed -n '3884,3918p' engine/my-3d2dge.js && sed -n '1,70p' engine/tools/check.mjs\"","aggregated_output":"game/main.js:8: const activity=I.anyPressed||Math.hypot(...I.move())>.1||moved;\ngame/balance.js:54: if(I.anyPressed||Math.hypot(m[0],m[1])>.05||recentMouse)v.touched=true;\n     *  is); write(): what a save holds ({ data, place, level }); read(save): what a load does with { data, place,\n     *  level, time, slot } */\n    this.game = game; this.slots = o.slots || 3; this.version = o.version || 1; this.migrate = o.migrate || null; this.write = o.write || null; this.read = o.read || null;\n    /** canSave: the pause menu offers Save (a JRPG turns it off away from save points); played: seconds played in the\n     *  game's scenes (paused time and titles left out), saved with each save and set by a load; blocked: storage\n     *  refused a save (they last for the visit) */\n    this.canSave = true; this.played = 0; this.blocked = false;\n    this._mem = {};   // each slot's record as text, this visit's (what storage refused stays here)\n  }\n  _key(slot) { return 'save:' + (this.game.o.id || (typeof location !== 'undefined' && location.pathname) || 'game') + ':' + slot; }\n  _ok(slot) { return slot === 'auto' || (Number.isInteger(slot) && slot >= 0 && slot < this.slots); }\n  _raw(slot) {\n    if (slot in this._mem) return this._mem[slot];\n    if (this.game.headless) return null;\n    try { return localStorage.getItem('my3d2dge:' + this._key(slot)); } catch (e) { return null; }\n  }\n  _put(slot, text) {\n    this._mem[slot] = text; if (this.game.headless) return true;\n    try { if (text === null) localStorage.removeItem('my3d2dge:' + this._key(slot)); else localStorage.setItem('my3d2dge:' + this._key(slot), text); return true; }\n    catch (e) { if (!this.blocked) warn('saves:blocked', 'game.saves: storage is blocked or full: the saves last for this visit'); this.blocked = true; return false; }\n  }\n  /** a slot's save as it is stored, checked: null when empty; { slot, damaged: true } when it can't be read; { newer:\n   *  true } from a newer version of the game; else { slot, data, place, level, time, at (the date saved), version } */\n  get(slot) {\n    if (!this._ok(slot)) return null;\n    const t = this._raw(slot); if (t === null || t === undefined) return null;\n    let s; try { s = JSON.parse(t); } catch (e) { s = null; }\n    if (!s || typeof s !== 'object' || s.v !== SAVE_FORMAT || !('data' in s)) return { slot, damaged: true };\n    const out = { slot, data: s.data, place: typeof s.place === 'string' ? s.place : '', level: s.level === undefined ? null : s.level, time: +s.time || 0, at: +s.at || 0, version: +s.version || 1 };\n    if (out.version > this.version) out.newer = true;\n    return out;\n  }\n  /** every slot, the autosave first: [{ slot, empty, place, level, time, at, damaged, newer }] (a menu's rows) */\n  list() { return ['auto'].concat(Array.from({ length: this.slots }, (_, i) => i)).map(slot => Object.assign({ slot, empty: false }, this.get(slot) || { empty: true })); }\n  /** save to a slot (0.., or 'auto'): o ({ data, place, level }) or what write() gives. Returns true when it is kept\n// my-3D2dge game checker: loads a game in a headless browser, presses start, plays it for a\n// moment, switches through the game's camera views, and reports errors, warnings, frame rate,\n// how much of the window the picture covers (covers: 1 = no black bars), how much is actually on screen, and screenshots.\n//\n// Setup (once):   npm install          (installs Playwright)\n//                 npx playwright install chromium\n// Usage:          node tools/check.mjs path/to/game.html[#scene] [--seconds 4] [--out check-output] [--size 390x844@3]\n//                 (--size: the window in CSS pixels and its pixel density; @2 and up is a phone or tablet, with touch)\n// Exit code is 1 if the page threw any error or never drew anything, so agents and CI can rely on it.\n// A game that sets game.debug = { snapshot() { return {...} } } gets its snapshot printed after play (its own state:\n// the hero, the objective, what an agent needs to see the game is where it should be).\nimport { chromium } from 'playwright';\nimport { mkdirSync, writeFileSync } from 'node:fs';\nimport { resolve, join } from 'node:path';\nimport { pathToFileURL } from 'node:url';\n\nconst args = process.argv.slice(2);\nconst file = args.find(a => !a.startsWith('--') && !/^\\d+(\\.\\d+)?$/.test(a));\nconst opt = (name, def) => { const i = args.indexOf('--' + name); return i >= 0 ? args[i + 1] : def; };\nif (!file) { console.error('Usage: node tools/check.mjs path/to/game.html [--seconds 4] [--out check-output]'); process.exit(2); }\nconst seconds = +opt('seconds', 4), out = resolve(opt('out', 'check-output'));\nconst [, sw, sh, sd] = (opt('size', '1280x720') || '').match(/^(\\d+)x(\\d+)(?:@(\\d+(?:\\.\\d+)?))?$/) || [0, 1280, 720];\nconst dpr = +(sd || 1), size = { viewport: { width: +sw, height: +sh }, deviceScaleFactor: dpr, ...(dpr >= 2 && { isMobile: true, hasTouch: true }) };\nmkdirSync(out, { recursive: true });\n\nconst browser = await chromium.launch({ executablePath: process.env.CHROMIUM_PATH || undefined, args: ['--autoplay-policy=no-user-gesture-required'] });\nconst page = await browser.newPage(size);\nconst errors = [], warnings = [], engineWarnings = [], external = new Set();\npage.on('pageerror', e => errors.push(String(e && e.stack || e)));\npage.on('console', m => {\n  const t = m.text();\n  if (m.type() === 'error') errors.push(t);\n  else if (m.type() === 'warning') (t.startsWith('my-3D2dge:') ? engineWarnings : warnings).push(t);\n});\npage.on('request', r => { const u = r.url(); if (/^https?:/i.test(u)) external.add(u.split('?')[0]); });\n\n// a #hash after the file name is kept, so deep links like game.html#platformer work\nconst [filePath, hash] = file.split('#');\nawait page.goto(pathToFileURL(resolve(filePath)).href + (hash ? '#' + hash : ''));\nawait page.waitForTimeout(1200);\nconst hasEngine = await page.evaluate(() => !!(window.My3D2dge && My3D2dge.current));\nconst report = { file, engine: hasEngine ? await page.evaluate(() => My3D2dge.version) : null, build: hasEngine ? await page.evaluate(() => My3D2dge.build || null) : null, scenes: [], views: [], errors, warnings, engineWarnings, external: [] };\n\n// how much of the frame is not background: share of pixels that differ from the most common color\n// how much of the frame is not background, plus a quick look lint: palette depth, flat areas, dither checkerboards, contrast\nconst coverage = () => page.evaluate(() => {\n  const g = My3D2dge.current, c = g.screen.buf, ctx = c.getContext('2d'), W = g.screen.W, H = g.screen.H, N = W * H;\n  const d = ctx.getImageData(0, 0, W, H).data, counts = new Map(), luma = new Uint8Array(N), key = new Int32Array(N);\n  for (let i = 0, p = 0; i < d.length; i += 4, p++) { const k = (d[i] >> 3) << 10 | (d[i + 1] >> 3) << 5 | (d[i + 2] >> 3); key[p] = k; counts.set(k, (counts.get(k) || 0) + 1); luma[p] = (d[i] * 3 + d[i + 1] * 6 + d[i + 2]) / 10; }\n  let top = 0, colors = 0; for (const v of counts.values()) { top = Math.max(top, v); if (v >= N * .001) colors++; }\n  let checker = 0, wins = 0;\n  for (let y = 0; y < H - 1; y += 2) for (let x = 0; x < W - 1; x += 2) { const a = key[y * W + x], b = key[y * W + x + 1], c2 = key[(y + 1) * W + x], e = key[(y + 1) * W + x + 1]; wins++; if (a !== b && a === e && b === c2) checker++; }\n  const sorted = Array.from(luma).sort((p, q) => p - q), spread = sorted[Math.floor(N * .95)] - sorted[Math.floor(N * .05)];\n  return { filled: +(1 - top / N).toFixed(3), colors, flat: +(top / N).toFixed(3), checker: +(checker / Math.max(1, wins)).toFixed(3), spread };\n});\nconst snap = async (tag) => {\n  const s = await page.evaluate(() => { const g = My3D2dge.current; return { scene: g.sceneName, fps: g.fps, updateMs: +g.stats.updateMs.toFixed(2), renderMs: +g.stats.renderMs.toFixed(2), items: g.stats.items, actors: g.stats.actors, resolution: g.screen.W + 'x' + g.screen.H, covers: +(Math.min(1, g.screen.W * g.screen.S / g.screen.canvas.width) * Math.min(1, g.screen.H * g.screen.S / g.screen.canvas.height)).toFixed(3), errorBox: !!document.querySelector('#my3d2dge-error, #e3-boot[data-failed]') }; });\n  const cov = await coverage(), shot = join(out, tag + '.png');\n  await page.screenshot({ path: shot });\n  return { ...s, ...cov, screenshot: shot };\n};\n\nif (hasEngine) {\n  report.scenes.push({ at: 'load', ...(await snap('0-load')) });\n  // press start / confirm twice to get past title screens and menus\n  for (let i = 0; i < 2; i++) { await page.keyboard.press('Enter'); await page.waitForTimeout(450); }\n  report.scenes.push({ at: 'after start', ...(await snap('1-started')) });\n  // play: move in every direction, jump, attack, dash, fire, using both key layouts\n  await page.mouse.move(820, 330);\n  const hold = async (keys, ms) => { for (const k of keys) await page.keyboard.down(k); await page.waitForTimeout(ms); for (const k of keys) await page.keyboard.up(k); };\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nfor f in ['game/main.js','game/balance.js']:\n p=Path(f);s=p.read_text().replace('I.anyPressed||','I.anyPressed()||');p.write_text(s)\np=Path('game/core.js');s=p.read_text().replace('G.dev.frame=false;};','G.dev.frame=false;if(G.game)G.game.timeScale=1;};');p.write_text(s)\np=Path('tests/issues.md');p.write_text(p.read_text()+\\\"8. Critical: Idle detection treated anyPressed as a property instead of calling it, preventing attract mode from starting. Corrected both input checks.\\\\n\\\")\nPY\nnode build.mjs\nnode --input-type=module - <<'JS'\nimport {load} from './tests/load.mjs';const {G}=load();for(const [name,param,push,secs]of [['body',[14,7,4,3,1.1,.2],0,7],['flow',[12,6,6,3.2,1.3,.28],.5,9],['stork1',[12,5,13,3,1.5,.24],.6,7],['stork2',[11,4.5,15,3.6,1.7,.22],.7,6],['candle',[10,5,11,1.4,.8,.2],.55,5],['laundry',[10,3.5,16,3.5,1.2,.4],.9,5]]){let out=[];for(const skill of ['passive','poor','average','good']){let total=0;for(let seed=1;seed<=12;seed++){const rng=G.E.rng(seed),b=new G.Balance(Object.fromEntries(['k','c','s','A','nf','R'].map((k,i)=>[k,param[i]])),rng),c={bal:b,intent:G.emptyIntent(),seed};let pp=0;for(let i=0;i<5400;i++){if(skill\"'!=='\"'passive')G.balanceBot(c,skill,1/120);if(Math.floor(b.t/secs)>pp){pp++;const angle=rng()*6.28;b.vx+=Math.cos(angle)*push;b.vy+=Math.sin(angle)*push;}b.step(1/120,c.intent);}total+=b.steadiness;}out.push(skill+':'+(total/12).toFixed(2));}console.log(name,out.join(' '));}\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nfor f in ['game/main.js','game/balance.js']:\n p=Path(f);s=p.read_text().replace('I.anyPressed||','I.anyPressed()||');p.write_text(s)\np=Path('game/core.js');s=p.read_text().replace('G.dev.frame=false;};','G.dev.frame=false;if(G.game)G.game.timeScale=1;};');p.write_text(s)\np=Path('tests/issues.md');p.write_text(p.read_text()+\\\"8. Critical: Idle detection treated anyPressed as a property instead of calling it, preventing attract mode from starting. Corrected both input checks.\\\\n\\\")\nPY\nnode build.mjs\nnode --input-type=module - <<'JS'\nimport {load} from './tests/load.mjs';const {G}=load();for(const [name,param,push,secs]of [['body',[14,7,4,3,1.1,.2],0,7],['flow',[12,6,6,3.2,1.3,.28],.5,9],['stork1',[12,5,13,3,1.5,.24],.6,7],['stork2',[11,4.5,15,3.6,1.7,.22],.7,6],['candle',[10,5,11,1.4,.8,.2],.55,5],['laundry',[10,3.5,16,3.5,1.2,.4],.9,5]]){let out=[];for(const skill of ['passive','poor','average','good']){let total=0;for(let seed=1;seed<=12;seed++){const rng=G.E.rng(seed),b=new G.Balance(Object.fromEntries(['k','c','s','A','nf','R'].map((k,i)=>[k,param[i]])),rng),c={bal:b,intent:G.emptyIntent(),seed};let pp=0;for(let i=0;i<5400;i++){if(skill\"'!=='\"'passive')G.balanceBot(c,skill,1/120);if(Math.floor(b.t/secs)>pp){pp++;const angle=rng()*6.28;b.vx+=Math.cos(angle)*push;b.vy+=Math.sin(angle)*push;}b.step(1/120,c.intent);}total+=b.steadiness;}out.push(skill+':'+(total/12).toFixed(2));}console.log(name,out.join(' '));}\nJS\"","aggregated_output":"Wee-Serene-Wii-Fit-gpt-6.1-sol-max-20261104-220355.html · 1613 KB\nbody passive:0.50 poor:0.80 average:0.99 good:1.00\nflow passive:0.53 poor:0.80 average:0.99 good:1.00\nstork1 passive:0.15 poor:0.33 average:0.69 good:0.95\nstork2 passive:0.22 poor:0.14 average:0.29 good:0.54\ncandle passive:0.16 poor:0.44 average:0.93 good:1.00\nlaundry passive:0.33 poor:0.30 average:0.39 good:0.80\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -lc \"cat > tests/run.mjs <<'EOF'\nimport {execFileSync} from 'node:child_process';\nimport path from 'node:path';\nprocess.chdir(path.resolve(new URL('..',import.meta.url).pathname));\nconst groups=process.argv[2]||'all';let passed=0,failed=0;\nexport const T={check(value,label){if(value)passed++;else{failed++;console.log('FAIL '+label);}},equal(a,b,label){this.check(JSON.stringify(a)===JSON.stringify(b),label+' (expected '+JSON.stringify(b)+', got '+JSON.stringify(a)+')');},async group(label,fn){try{await fn();}catch(e){failed++;console.log('FAIL '+label+': '+(e.stack||e).split('\\\\n').slice(0,4).join(' / '));}}};\ntry{execFileSync('node',['build.mjs'],{stdio:'pipe'});}catch(e){console.log('FAIL build: '+e.message);process.exit(1);}\nfor(const name of ['rules','browser','hub'])if(groups==='all'||groups===name)await T.group(name,async()=>{const mod=await import('./'+name+'.mjs');await mod.run(T);});\nconsole.log(\"'`${passed} passed, ${failed} failed`);process.exitCode=failed?1:0;\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('tests/load.mjs');s=p.read_text().replace('main=false,draw=false','main=false,draw=false,hub=null,hash=\\\\'\\\\'').replace(\\\"location:{hash:''}\\\",\\\"location:{hash}\\\").replace('c.window=c;','if(hub)c.AIHub=hub;c.window=c;');p.write_text(s)\nPY\ncat > tests/rules.mjs <<'EOF'\nimport fs from 'node:fs';\nimport {load} from './load.mjs';\nconst DT=1/120;\nconst sim=(G,id,tier,skill,seed=3)=>{const ctx=G.makeContext(id,tier,{seed});for(let i=0;i<160*120&&\"'!ctx.done;i++)G.stepContext(ctx,DT,skill);return ctx;};\nexport async function run(T){\n const {G,game,logs}=load();G.animateContestant=()=>{};\n T.equal(Object.keys(G.activities).length,12,'\"'twelve complete activities');T.equal(G.lib.names.length,23,'23 animation clips');T.equal(game.settings.music,.1,'music starts at ten percent');T.equal(game.settings.glyphs,'playstation','PlayStation glyph default');\n const lines=Object.values(G.lines).flat(4).filter(x=>typeof x==='string');T.check(lines.length>=150,'at least 150 dialogue lines');\n for(const [id,a]of Object.entries(G.activities)){for(const name of ['setup','update','draw','hud','bot','result','ghost'])T.check(typeof a[name]==='function',id+' implements '+name);T.check(G.POSES[a.pose]&&G.lib.clip(G.POSES[a.pose].clip),id+' pose clip exists');T.equal(a.tiers.length,2,id+' has two tiers');}\n for(const [id,p]of Object.entries(G.POSES))T.check(\"'!!G.lib.clip(p.clip),id+'\"' clip resolves');\n for(const file of fs.readdirSync('game',{recursive:true}).filter(f=>f.endsWith('.js')))T.check(\"'!/'\"\\\\bTODO\\\\b|\\\\bplaceholder\\\\b|\\\\bstubbed\\\\b/i.test(fs.readFileSync('game/'+file,'utf8')),file+' has no unfinished content');\n // The published Lean benchmark, 12 seeds each, independent of activities and rendering.\n const benchmarks=[['Body Check',[14,7,4,3,1.1,.2],0,7,[.50,.76,.99,1]],['Sun Flow',[12,6,6,3.2,1.3,.28],.5,9,[.53,.78,.99,1]],['Stork 1',[12,5,13,3,1.5,.24],.6,7,[.20,.30,.68,.95]],['Stork 2',[11,4.5,15,3.6,1.7,.22],.7,6,[.22,.15,.29,.54]],['Candle',[10,5,11,1.4,.8,.2],.55,5,[.14,.59,.95,1]],['Laundry',[10,3.5,16,3.5,1.2,.4],.9,5,[.35,.31,.39,.79]]];\n for(const [name,param,push,every,expected]of benchmarks)for(const [j,skill]of ['passive','poor','average','good'].entries()){\n  let total=0;for(let seed=1;seed<=12;seed++){const rng=G.E.rng(seed),b=new G.Balance(Object.fromEntries(['k','c','s','A','nf','R'].map((k,i)=>[k,param[i]])),rng),c={bal:b,intent:G.emptyIntent(),seed};let last=0;for(let i=0;i<5400;i++){if(skill\"'!=='\"'passive')G.balanceBot(c,skill,DT);if(Math.floor(b.t/every)>last){last++;const a=rng()*6.28;b.vx+=Math.cos(a)*push;b.vy+=Math.sin(a)*push;}b.step(DT,c.intent);}total+=b.steadiness;}\n  T.check(Math.abs(total/12-expected[j])<=.101,name+' '+skill+' benchmark '+(total/12).toFixed(2));\n }\n for(const [id,a]of Object.entries(G.activities))for(const tier of [1,2])for(const skill of ['passive','average','good','expert']){\n  const ctx=sim(G,id,tier,skill),result=a.result(ctx,ctx.contestants[0]),stars=G.stars(result.pct,a);T.check(ctx.done,id+' tier '+tier+' '+skill+' finishes');T.check(Number.isFinite(result.pct)&&result.pct>=0&&result.pct<=1,id+' finite score');\n  const need=skill==='passive'?stars===0:tier===1?(skill==='average'?stars>=1:stars>=2):(skill==='good'?stars>=1:skill==='expert'?stars>=2:true);T.check(need,id+' tier '+tier+' '+skill+' star band ('+result.pct.toFixed(2)+')');\n }\n // Several seeds stress random disturbances rather than one fortunate run.\n for(const id of ['stork','candle','laundry'])for(const tier of [1,2])for(const skill of tier===1?['average','good']:['good','expert']){\n  const scores=[1,2,4,7,11,19].map(seed=>{const c=sim(G,id,tier,skill,seed);return c.a.result(c,c.contestants[0]).pct;});const mean=scores.reduce((a,b)=>a+b)/scores.length,need=tier===1?(skill==='average'?1:2):(skill==='good'?1:2);T.check(G.stars(mean,G.activities[id])>=need,id+' tier '+tier+' '+skill+' multi-seed mean');\n }\n const hash=seed=>{const c=sim(G,'tray',1,'good',seed);return JSON.stringify({time:c.time,score:c.a.result(c,c.contestants[0]),hash:c.contestants[0].data.world.hash()});};T.equal(hash(71),hash(71),'same tray seed and inputs are deterministic');\n const b1=new G.Balance(G.activities.stork.tiers[0],G.E.rng(2));for(let i=0;i<600;i++)b1.step(DT,{x:0,y:0});game.settings.set('gentle',true);const b2=new G.Balance(G.activities.stork.tiers[0],G.E.rng(2));for(let i=0;i<600;i++)b2.step(DT,{x:0,y:0});T.check(b2.radius>b1.radius,'Gentle Mode grows target ring');game.settings.set('gentle',false);\n T.equal(game.errors,[],'simulation has no engine errors');game.dispose();\n await T.group('full skilled playthrough',()=>story(T,'expert'));\n await T.group('full passive playthrough',()=>story(T,'passive'));\n await T.group('save slots',()=>saveTests(T));\n await T.group('attract and developer tools',()=>attractDev(T));\n await T.group('local Class',()=>classTests(T));\n await T.group('fake hub lifecycle',()=>hubTests(T));\n}\nfunction driver(G,game){game.fadeTime=0;const advance=t=>game.advance(t,{draw:false}),tap=a=>{game.input.tap(a);advance(.16);},scene=()=>game.sceneName,go=(n,d)=>{G.go(n,d,true);advance(.2);};return {advance,tap,scene,go,until(target,max=180){for(let i=0;i<max&&scene()\"'!==target;i++)tap('\"'confirm');if(scene()\"'!==target)throw new Error('\"'Expected '+target+', got '+scene());}};}\nfunction story(T,skill){\n const {G,game,logs}=load({main:true});const D=driver(G,game);G.animateContestant=()=>{};D.advance(.2);D.tap('confirm');D.tap('confirm');for(let i=0;i<3;i++)D.tap('down');D.tap('confirm');T.equal(D.scene(),'arrival','new member reaches arrival');D.until('instructor');D.tap('confirm');D.until('bungalow');G.dev.bot=skill;\n const all=[];let plateauStart,plateauEnd;\n function bodycheck(){D.tap('confirm');for(let i=0;i<900&&D.scene()==='bodycheck';i++)D.tap('confirm');if(D.scene()==='tareDay'){D.tap('confirm');D.until('island');}}\n function play(id){if(D.scene()\"'!=='\"'card'){G.startSession(id,1,G.member.day===5?'festival':'story');D.advance(.2);}D.tap('confirm');let seconds=0;while(D.scene()\"'!=='\"'results'&&seconds<180){D.advance(.25);seconds+=.25;}T.equal(D.scene(),'results',skill+' '+id+' reaches results');all.push(G.context.a.id);D.advance(.25);D.tap('confirm');D.advance(.2);}\n bodycheck();T.equal(D.scene(),'card','Day 1 guided Stork card');play('stork');play('squat');play('tray');T.equal(G.member.sessions,3,'three sessions end Day 1');\n for(const [day,acts]of [[2,['flow','pushup','hoop']],[3,['candle','lunge','jog']],[4,['step','slalom','laundry']]]){\n  D.tap('confirm');T.equal(G.member.day,day,'dawn Day '+day);if(day===3)plateauStart=G.member.spineAge;bodycheck();for(const id of acts)play(id);T.equal(D.scene(),'evening','Day '+day+' evening');if(day===3)plateauEnd=G.member.spineAge;\n }\n T.equal(plateauEnd,plateauStart,'Day 3 plateau holds');T.equal(new Set(all).size,12,'all twelve activities played in story');T.check(skill==='passive'?G.member.spineAge===71:G.member.spineAge<71,'Spine Age reflects '+skill+' play');T.check(G.member.minutes>15,'Gerald banks minutes and unlocks accessories');T.check(G.member.tareDay,'Tare recalibration scene completed');\n D.tap('confirm');bodycheck();T.equal(D.scene(),'games','Day 5 reaches Gentle Games');D.tap('confirm');for(const id of ['stork','step','slalom','candle'])play(id);T.equal(D.scene(),'ending','festival reaches ending');D.until('credits');T.check(G.member.ended,'Free Play unlocked at ending');T.equal(game.errors,[],skill+' story has no engine errors');T.check(G.visited.has('bodycheck')&&G.visited.has('arrival')&&G.visited.has('results')&&G.visited.has('tareDay'),'story visited mandatory scenes');\n G.animateContestant=(ctx,c,dt)=>G.poseRig(c.rig,ctx.a.pose,ctx.time,{dt});for(const id of Object.keys(G.activities)){G.startSession(id,1,'free');D.advance(.2);G.go('session',G.pending,true);D.advance(.2);G.beginPlay();G.stepContext(G.context,DT,'expert');game.advance(DT,{draw:true});}T.equal(game.errors,[],'all activities draw headlessly');game.dispose();\n}\nfunction saveTests(T){const {G,game}=load();for(let i=0;i<3;i++){G.slot=i;G.member=G.memberDefault();G.member.name='Member '+i;G.member.day=i+1;G.member.minutes=i*4.25;G.persist();}for(let i=0;i<3;i++){G.loadMember(i);T.equal([G.member.name,G.member.day,G.member.minutes],['Member '+i,i+1,i*4.25],'member slot '+i+' stays separate');}\n const snapshot=G.clone(G.member);G.member.day=99;G.loadMember(2);T.equal(G.member,snapshot,'reload restores exact saved progress');game.saves._mem[1]='{damaged';T.equal(game.saves.load(1),null,'damaged save is safely rejected');G.member=G.memberDefault();for(const a of Object.values(G.activities))G.member.best[a.id+'-1']={stars:3,pct:1};T.equal(G.calculateAge(),20,'all three stars give Spine Age 20');G.member.duelWin=true;T.equal(G.calculateAge(),19,'duel win reaches Gertrude age');game.dispose();}\nfunction attractDev(T){const {G,game}=load({main:true});const D=driver(G,game);G.animateContestant=()=>{};D.advance(9.9);T.check(\"'!G.attracting,'\"'attract does not start at 9.9s');const saved=JSON.stringify(G.member);D.advance(.13);T.check(G.attracting,'attract starts after ten seconds');D.advance(.2);const items=new Set();for(let i=0;i<G.ATTRACT.length;i++){items.add(G.attractItem);D.advance(15.1);}T.equal(items.size,G.ATTRACT.length,'attract shows every playlist feature');T.equal(JSON.stringify(G.member),saved,'attract never changes member progress');D.tap('confirm');D.advance(.2);T.equal(D.scene(),'title','any input exits attract');T.check(\"'!G.attracting,'\"'attract input swallowed');\n for(const def of G.DEFS){const key=def[0],old=G.DEV[key];G.DEV[key]=old+def[4];T.check(G.DEV[key]\"'!==old,'\"'developer '+key+' changes live value');}G.resetDev();T.check(G.DEFS.every(x=>G.DEV[x[0]]===x[5]),'developer reset restores every default');\n D.go('session',{id:'stork',tier:1});G.beginPlay();G.dev.open=true;G.dev.group='Lean';D.tap('right');T.check(G.DEV.k>12,'developer d-pad adjusts live slider');G.resetDev();G.dev.group='Tools';G.dev.page=1;G.dev.row=3;D.tap('right');T.equal(G.dev.bot,'poor','developer bot selector changes');G.dev.open=false;\n for(const name of ['members','bungalow','island','bodycheck','evening','games','ending','classLobby','pose']){D.go(name);game.advance(.02,{draw:true});T.equal(D.scene(),name,'developer jump '+name+' loads');}T.equal(game.errors,[],'attract/dev scene draws have no errors');game.dispose();}\nfunction classTests(T){const {G,game}=load({main:true});const D=driver(G,game);D.go('classLobby');game.addPlayer({keys:'right'});game.addPlayer({pad:0});game.addPlayer({pad:1});T.equal(game.players.length,4,'four Class inputs join');const contestants=game.players.map((input,i)=>({input,local:true,name:'P'+i,color:G.E.PLAYER_COLORS[i],bot:['average','good','expert','poor'][i],rig:G.regularRig(i,1.45)}));G.mode='class';G.animateContestant=()=>{};for(const id of ['stork','candle','squat','step','hoop']){const ctx=G.makeContext(id,1,{duration:35,contestants,fixedDuration:true});for(let i=0;i<35*120+2&&\"'!ctx.done;i++)G.stepContext(ctx,DT);T.check(ctx.contestants.every(c=>Number.isFinite(c.score)&&c.score>=0&&c.score<=1000),'\"'four Class '+id+' scores');T.check(new Set(ctx.contestants.map(c=>c.intent)).size===4,'Class intents independent '+id);}\n G.classRoster=contestants;G.classScores=Object.fromEntries(contestants.map((c,i)=>[c.name,i*100]));D.go('podium');game.advance(.01,{draw:true});T.equal(game.errors,[],'Class podium draws without errors');game.dispose();}\nasync function hubTests(T){let now=-Infinity,ready=0,results=[],progress=[],sent=[];const events={},info={me:0,players:[{id:0,name:'One',color:'#e8443a'},{id:1,name:'Two',color:'#3b82f6'}],limitMs:15000,seed:7};const hub={active:true,connect:async()=>info,on:(e,fn)=>{events[e]=fn;},ready(){ready++;},rng(label){let seed=[...label].reduce((s,c)=>s+c.charCodeAt(0),7);return ()=>{seed=Math.imul(seed,1664525)+1013904223;return (seed>>>0)/4294967296;};},time:()=>now,answer(){},send:d=>sent.push(d),progress:d=>progress.push(d),result:d=>results.push(d)};\n const {G,game}=load({main:true,hub});await Promise.resolve();await Promise.resolve();const D=driver(G,game);D.advance(.2);await Promise.resolve();T.equal(ready,1,'hub ready without input');T.equal(D.scene(),'round','hub opens straight to round');const deal=JSON.stringify(G.hub.deal);now=-2000;D.advance(.1);T.equal(G.hub.phase,'countdown','hub negative clock counts down');now=2000;D.advance(.15);T.check(G.context&&G.hub.event===0,'hub event from shared clock');T.check(sent.length>0&&progress.length>0,'hub sends ghosts and progress');events.message({t:'g',a:0,l:[.1,.2],p:0,w:[1,2],s:88},1);T.check(G.hub.ghosts[1].s===88,'hub accepts remote ghost');events.leave({id:1});T.check(\"'!G.hub.ghosts[1],'\"'hub removes departed ghost');events['time-up']({});events['time-up']({});T.equal(results.length,1,'hub reports exactly once on repeated time-up');T.check(Number.isFinite(results[0].score),'hub score is numeric');events.end({reason:'finished'});const time=G.context.time;game.input.hold('right');now=8000;D.advance(.2);T.equal(G.context.time,time,'hub end freezes gameplay');T.check(G.hub.over,'hub end stops input and audio');T.check(game.audio.song===null,'hub end stops music');T.check(\"'!G.attracting&&!G.dev.open,'\"'hub disables attract and developer dock');game.dispose();}\nEOF\nnode tests/run.mjs rules\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -lc \"cat > tests/hub.mjs <<'EOF'\nimport {chromium} from 'playwright';import {spawn} from 'node:child_process';import fs from 'node:fs';\nexport async function run(T){\n const server=spawn('python3',['-u','-m','http.server','0','--bind','127.0.0.1'],{cwd:'tests/hub',stdio:['ignore','pipe','pipe']});let browser;\n try{\n const port=await new Promise((resolve,reject)=>{let out='';const timer=setTimeout(()=>reject(new Error('Server startup timeout')),10000);server.stdout.on('data',d=>{out+=d;const m=out.match(/port (\\\\d+)/);if(m){clearTimeout(timer);resolve(Number(m[1]));}});server.on('exit',n=>reject(new Error('Server exited '+n)));});\n const url='http://127.0.0.1:'+port;const html=await(await fetch(url+'/game.html')).text();T.check(html.includes('<title>Wee Serene'),'ephemeral server serves our game');\n browser=await chromium.launch({headless:true});const scenarios=['players=1&auto=1','players=2&auto=1','players=3&latency=150&jitter=50&loss=5&auto=1','players=4&latency=150&jitter=50&loss=5&auto=1','players=4&latency=150&jitter=50&loss=5&auto=1&scenario=host-leave'];\n const reports=[];\n for(const scenario of scenarios){const page=await browser.newPage({viewport:{width:1280,height:800}}),errors=[];page.on('pageerror',e=>errors.push(e.message));await page.goto(url+'/harness.html?game=game.html&'+scenario);try{await page.waitForFunction(()=>document.body.dataset.complete==='true',{},{timeout:120000});}catch(e){T.check(false,'hub completes '+scenario+' '+(await page.locator('#log').innerText()).slice(-1500));}\n const report=await page.evaluate(()=>window.__hubCheck||{});reports.push({scenario,report,errors});T.check(report.pass===true,'hub harness '+scenario+' '+JSON.stringify(report.checks?.filter(c=>\"'!c.pass)||report));T.equal(errors,[],'\"'hub has no page errors '+scenario);\n if(scenario.startsWith('players=2')){const frames=page.frames().filter(f=>f.url().includes('game.html'));const states=await Promise.all(frames.map(f=>f.evaluate(()=>({players:G.hub.info?.players.length,received:Object.keys(G.hub.ghosts).length,deal:G.hub.deal,over:G.hub.over,reported:G.hub.reported}))));T.check(states.length>=2,'hub two-page session loaded');T.check(states.some(s=>s.received>0),'two-page hub session receives ghost state');T.check(states.every(s=>JSON.stringify(s.deal)===JSON.stringify(states[0].deal)),'hub copies deal same seeded events');}\n await page.close();\n }\n const standalone=await browser.newPage();await standalone.goto(url+'/game.html');await standalone.waitForFunction(()=>window.__game?.sceneName==='title');T.check(await standalone.evaluate(()=>\"'!G.inSession&&G.sceneName==='\"'title'),'standalone still reaches title');await standalone.close();fs.writeFileSync('tests/hub-report.json',JSON.stringify(reports,null,2));\n }finally{await browser?.close();server.kill('SIGTERM');}\n}\nEOF\nnode tests/run.mjs hub\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -lc \"cat > tests/hub.mjs <<'EOF'\nimport {chromium} from 'playwright';import {spawn} from 'node:child_process';import fs from 'node:fs';\nexport async function run(T){\n const server=spawn('python3',['-u','-m','http.server','0','--bind','127.0.0.1'],{cwd:'tests/hub',stdio:['ignore','pipe','pipe']});let browser;\n try{\n const port=await new Promise((resolve,reject)=>{let out='';const timer=setTimeout(()=>reject(new Error('Server startup timeout')),10000);server.stdout.on('data',d=>{out+=d;const m=out.match(/port (\\\\d+)/);if(m){clearTimeout(timer);resolve(Number(m[1]));}});server.on('exit',n=>reject(new Error('Server exited '+n)));});\n const url='http://127.0.0.1:'+port;const html=await(await fetch(url+'/game.html')).text();T.check(html.includes('<title>Wee Serene'),'ephemeral server serves our game');\n browser=await chromium.launch({headless:true});const scenarios=['players=1&auto=1','players=2&auto=1','players=3&latency=150&jitter=50&loss=5&auto=1','players=4&latency=150&jitter=50&loss=5&auto=1','players=4&latency=150&jitter=50&loss=5&auto=1&scenario=host-leave'];\n const reports=[];\n for(const scenario of scenarios){const page=await browser.newPage({viewport:{width:1280,height:800}}),errors=[];page.on('pageerror',e=>errors.push(e.message));await page.goto(url+'/harness.html?game=game.html&'+scenario);try{await page.waitForFunction(()=>document.body.dataset.complete==='true',{},{timeout:120000});}catch(e){T.check(false,'hub completes '+scenario+' '+(await page.locator('#log').innerText()).slice(-1500));}\n const report=await page.evaluate(()=>window.__hubCheck||{});reports.push({scenario,report,errors});T.check(report.pass===true,'hub harness '+scenario+' '+JSON.stringify(report.checks?.filter(c=>\"'!c.pass)||report));T.equal(errors,[],'\"'hub has no page errors '+scenario);\n if(scenario.startsWith('players=2')){const frames=page.frames().filter(f=>f.url().includes('game.html'));const states=await Promise.all(frames.map(f=>f.evaluate(()=>({players:G.hub.info?.players.length,received:Object.keys(G.hub.ghosts).length,deal:G.hub.deal,over:G.hub.over,reported:G.hub.reported}))));T.check(states.length>=2,'hub two-page session loaded');T.check(states.some(s=>s.received>0),'two-page hub session receives ghost state');T.check(states.every(s=>JSON.stringify(s.deal)===JSON.stringify(states[0].deal)),'hub copies deal same seeded events');}\n await page.close();\n }\n const standalone=await browser.newPage();await standalone.goto(url+'/game.html');await standalone.waitForFunction(()=>window.__game?.sceneName==='title');T.check(await standalone.evaluate(()=>\"'!G.inSession&&G.sceneName==='\"'title'),'standalone still reaches title');await standalone.close();fs.writeFileSync('tests/hub-report.json',JSON.stringify(reports,null,2));\n }finally{await browser?.close();server.kill('SIGTERM');}\n}\nEOF\nnode tests/run.mjs hub\"","aggregated_output":"FAIL hub: frame.evaluate: ReferenceError: G is not defined /     at eval (eval at evaluate (:311:30), <anonymous>:1:15) /     at UtilityScript.evaluate (<anonymous>:313:16) /     at UtilityScript.<anonymous> (<anonymous>:1:44)\n5 passed, 1 failed\n","exit_code":1,"status":"failed"}}
{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module - <<'JS'\nimport {load} from './tests/load.mjs';const {G}=load();for(const freq of [1,1.05,1.13]){let out=[];for(const skill of ['passive','poor','average','good']){let total=0;for(let seed=1;seed<=12;seed++){const rng=G.E.rng(seed),b=new G.Balance({k:10,c:5,s:11,A:1.4,nf:.8,R:.2},rng),c={bal:b,intent:G.emptyIntent(),seed};const r2=G.E.rng(seed);G.noise(r2,.8);b.ny=G.noise(r2,.8*freq);let pp=0;for(let i=0;i<5400;i++){if(skill\"'!=='\"'passive')G.balanceBot(c,skill,1/120);if(Math.floor(b.t/5)>pp){pp++;const a=rng()*6.28;b.vx+=Math.cos(a)*.55;b.vy+=Math.sin(a)*.55;}b.step(1/120,c.intent);}total+=b.steadiness;}out.push(skill+':'+(total/12).toFixed(2));}console.log(freq,out.join(' '));}\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module - <<'JS'\nimport {load} from './tests/load.mjs';const {G}=load();for(const freq of [1,1.05,1.13]){let out=[];for(const skill of ['passive','poor','average','good']){let total=0;for(let seed=1;seed<=12;seed++){const rng=G.E.rng(seed),b=new G.Balance({k:10,c:5,s:11,A:1.4,nf:.8,R:.2},rng),c={bal:b,intent:G.emptyIntent(),seed};const r2=G.E.rng(seed);G.noise(r2,.8);b.ny=G.noise(r2,.8*freq);let pp=0;for(let i=0;i<5400;i++){if(skill\"'!=='\"'passive')G.balanceBot(c,skill,1/120);if(Math.floor(b.t/5)>pp){pp++;const a=rng()*6.28;b.vx+=Math.cos(a)*.55;b.vy+=Math.sin(a)*.55;}b.step(1/120,c.intent);}total+=b.steadiness;}out.push(skill+':'+(total/12).toFixed(2));}console.log(freq,out.join(' '));}\nJS\"","aggregated_output":"1 passive:0.16 poor:0.44 average:0.94 good:1.00\n1.05 passive:0.16 poor:0.45 average:0.93 good:1.00\n1.13 passive:0.16 poor:0.44 average:0.93 good:1.00\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_68","type":"agent_message","text":"The scripted playthrough has reached the ending after all twelve activities with no engine errors. The hub harness has also passed one- and two-player checks. I’m extending validation to network loss, shared-keyboard Class play, controller input, audio output, and smaller screens.\n"}}
{"type":"item.started","item":{"id":"item_69","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('tests/hub.mjs');s=p.read_text().replace(\\\"page.frames().filter(f=>f.url().includes('game.html'))\\\",\\\"page.frames().filter(f=>f\"'!==page.mainFrame()&&new URL(f.url()).pathname.endsWith('\"'/game.html'))\\\");p.write_text(s)\nPY\ncat > tests/browser.mjs <<'EOF'\nimport {chromium,webkit,firefox} from 'playwright';import fs from 'node:fs';import path from 'node:path';import {pathToFileURL} from 'node:url';import {execFileSync} from 'node:child_process';\nconst bundle=()=>pathToFileURL(path.resolve('..',path.basename(process.cwd())+'.html')).href;\nexport async function run(T){\n fs.mkdirSync('tests/screens',{recursive:true});let browser=await chromium.launch({headless:true});\n try{\n const page=await browser.newPage({viewport:{width:1920,height:1080}}),errors=[],requests=[];page.on('pageerror',e=>errors.push(e.message));page.on('request',r=>{if(/\"'^https?:/.test(r.url()))requests.push(r.url());});\n await page.goto(bundle());await page.waitForFunction(()=>window.__game?.sceneName==='\"'title');await page.screenshot({path:'tests/screens/title.png'});\n T.equal(await page.evaluate(()=>G.game.settings.music),.1,'browser fresh music .1');T.equal(await page.evaluate(()=>G.game.settings.glyphs),'playstation','browser fresh PlayStation glyphs');\n await page.keyboard.press('Enter');await page.waitForFunction(()=>G.game.sceneName==='members');await page.waitForTimeout(180);await page.keyboard.press('Enter');await page.waitForFunction(()=>G.game.sceneName==='customize');T.check(true,'keyboard enters new member creation');\n await page.mouse.move(120,800);await page.evaluate(()=>{G.game.stop();G.game.fadeTime=0;G.startSession('stork',1,'free');G.game.advance(.25,{draw:true});});await page.screenshot({path:'tests/screens/card.png'});\n // Real mouse hover, then click the Begin pill in canvas coordinates.\n const box=await page.evaluate(()=>{const c=G.canvas.getBoundingClientRect(),k=c.width/G.game.W;return {x:65*k+c.left,y:(G.game.H-57)*k+c.top};});await page.mouse.move(box.x,box.y);await page.mouse.click(box.x,box.y);await page.evaluate(()=>G.game.advance(.25));T.equal(await page.evaluate(()=>G.game.sceneName),'session','mouse click begins activity');\n await page.evaluate(()=>{G.beginPlay();G.dev.bot=null;});await page.keyboard.down('d');await page.evaluate(()=>G.game.advance(.2,{draw:false}));await page.keyboard.up('d');const key=await page.evaluate(()=>({u:G.context.contestants[0].intent.x,source:G.source}));T.check(key.u>.25&&key.source==='keyboard','WASD nudges lean target');\n await page.mouse.move(1500,400);await page.evaluate(()=>G.game.advance(.03,{draw:true}));T.check(await page.evaluate(()=>G.source==='mouse'&&G.context.contestants[0].intent.x>.5),'mouse position leans directly');\n // Procedural audio: measure actual buses and an offline voice render after a real gesture.\n await page.keyboard.press('Enter');const audio=await page.evaluate(async()=>{const a=G.game.audio;await a.ctx?.resume();if(\"'!a.ctx)return {music:0,voice:0,offline:0};const music=a.ctx.createAnalyser(),voice=a.ctx.createAnalyser();music.fftSize=2048;voice.fftSize=2048;a.bus('\"'music').connect(music);a.bus('voice').connect(voice);await new Promise(r=>setTimeout(r,400));const m=new Float32Array(music.fftSize);music.getFloatTimeDomainData(m);G.babble('Tare','a');await new Promise(r=>setTimeout(r,25));const v=new Float32Array(voice.fftSize);voice.getFloatTimeDomainData(v);const C=window.OfflineAudioContext||window.webkitOfflineAudioContext,off=new C(1,22050,44100);G.babble('Birch','a',off,off.destination);G.babble('Tare','e',off,off.destination);const buffer=await off.startRendering();return {music:Math.max(...m.map(Math.abs)),voice:Math.max(...v.map(Math.abs)),offline:Math.max(...buffer.getChannelData(0).map(Math.abs))};});T.check(audio.music>1e-5,'music bus produces non-silent samples');T.check(audio.voice>1e-5,'gibberish voice bus produces sound');T.check(audio.offline>1e-5,'OfflineAudioContext renders procedural voices');fs.writeFileSync('tests/audio-report.json',JSON.stringify(audio,null,2));\n const ids=await page.evaluate(()=>Object.keys(G.activities));\n for(const id of ids){const s=await page.evaluate(id=>{G.startSession(id,1,'free');G.game.advance(.2);G.go('session',G.pending,true);G.game.advance(.1);G.beginPlay();G.dev.bot='expert';G.game.advance(12,{draw:false});G.game.advance(.01,{draw:true});return G.game.debug.snapshot();},id);T.equal(s.errors,0,id+' browser activity runs and draws');await page.screenshot({path:'tests/screens/'+id+'.png'});}\n await page.evaluate(()=>{G.endSession();G.game.advance(.3,{draw:true});});await page.screenshot({path:'tests/screens/results.png'});\n await page.evaluate(()=>{G.go('island',null,true);G.game.advance(.3,{draw:true});});await page.screenshot({path:'tests/screens/island.png'});\n // Every screen and exposed setting stays functional.\n for(const name of ['members','memberOptions','customize','bungalow','wardrobe','bodycheck','evening','games','ending','credits','about','classLobby','pose']){\n const n=await page.evaluate(n=>{G.go(n,null,true);G.game.advance(.2,{draw:true});return G.game.errors.length;},name);T.equal(n,0,name+' browser screen draws');}\n await page.evaluate(()=>{G.dev.open=false;G.game.shell.show('settings');});await page.waitForTimeout(100);const hover=await page.locator('.esh-sh button').all();if(hover.length>1){await hover[1].hover();T.check(await hover[1].evaluate(el=>el===document.activeElement),'HTML menu hover moves focus');}else T.check(false,'HTML settings buttons exist');await page.evaluate(()=>G.game.shell.hide());\n T.equal(errors,[],'no JavaScript page errors');T.equal(requests,[],'standalone makes no network or audio-file requests');\n await page.close();\n // A standard-mapping controller stand-in, with real analog values.\n const padPage=await browser.newPage({viewport:{width:1280,height:720}});await padPage.addInitScript(()=>{window.pad={id:'DualSense Wireless Controller (STANDARD GAMEPAD)',index:0,mapping:'standard',connected:true,timestamp:0,axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0})),vibrationActuator:{playEffect:async()=>{}}};navigator.getGamepads=()=>[window.pad];});await padPage.goto(bundle());await padPage.waitForFunction(()=>window.__game?.sceneName==='title');await padPage.evaluate(()=>{G.game.stop();G.game.fadeTime=0;pad.buttons[0]={pressed:true,touched:true,value:1};G.game.advance(.2);pad.buttons[0]={pressed:false,touched:false,value:0};G.game.advance(.2);});T.equal(await padPage.evaluate(()=>G.game.sceneName),'members','DualSense Cross confirms menu');\n const padResult=await padPage.evaluate(()=>{G.startSession('stork',1,'free');G.game.advance(.2);G.go('session',G.pending,true);G.game.advance(.1);G.beginPlay();pad.axes=[.7,-.3,0,0];pad.buttons[7]={pressed:true,touched:true,value:.73};G.game.advance(.12);return {u:G.context.contestants[0].intent.x,effort:G.context.contestants[0].intent.effort,source:G.source,glyph:G.game.input.label('confirm','gamepad')};});T.check(padResult.u>.4&&padResult.source==='gamepad','analog stick controls Lean');T.check(Math.abs(padResult.effort-.73)<.02,'analog R2 travel survives input adapter');T.equal(padResult.glyph,'✕','controller prompts use PlayStation Cross');T.equal(await padPage.evaluate(()=>{G.game.settings.set('glyphs','xbox');return G.game.input.label('confirm','gamepad');}),'A','Xbox button option updates prompt');await padPage.close();\n }finally{await browser.close();}\n // One browser engine at a time, with screenshots across fourteen viewport sizes.\n const matrix=[\n ['Small phone',320,568,'chromium',true],['iPhone SE',375,667,'webkit',true],['iPhone portrait',402,874,'webkit',true],['Pixel phone',412,915,'chromium',true],['Fold cover',344,882,'chromium',true],['Fold open',884,1104,'chromium',true],['iPad mini',768,1024,'webkit',true],['iPad Pro',1024,1366,'webkit',true],['Android tablet',800,1280,'chromium',true],['Phone landscape',874,402,'webkit',true],['Laptop',1440,900,'chromium',false],['Desktop',1280,720,'chromium',false],['Full HD',1920,1080,'chromium',false],['Ultrawide',2560,1080,'chromium',false],['Desktop WebKit',1280,720,'webkit',false],['Full HD Firefox',1920,1080,'firefox',false]\n ];const report=[];\n for(const engine of ['chromium','webkit','firefox']){const b=await ({chromium,webkit,firefox})[engine].launch({headless:true});try{for(const [name,width,height,which,touch]of matrix.filter(m=>m[3]===engine)){\n const context=await b.newContext({viewport:{width,height},hasTouch:touch,deviceScaleFactor:1,...(engine\"'!=='\"'firefox'?{isMobile:touch}:{})}),p=await context.newPage(),errs=[];p.on('pageerror',e=>errs.push(e.message));await p.goto(bundle());await p.waitForFunction(()=>window.__game?.sceneName==='title');\n const state=await p.evaluate(()=>({overflow:document.documentElement.scrollWidth>innerWidth,canvas:\"'!!G.game.screen.buf,errors:G.game.errors.length}));T.check(!state.overflow&&state.canvas&&state.errors===0,name+'\"' fits viewport and draws');\n if(touch){const notice=p.locator('[data-sys=need]');T.check(await notice.isVisible(),name+' touch-only notice visible');T.check((await notice.innerText()).includes('Controller or keyboard required'),name+' names controller requirement');await p.evaluate(()=>{G.game.stop();G.game.advance(10.5,{draw:true});G.game.advance(.4,{draw:true});});T.check(await p.evaluate(()=>G.attracting),name+' attract runs behind touch notice');T.check(await p.evaluate(()=>\"'!G.game.input.touchEnabled),name+'\"' has no touch controls');}\n await p.screenshot({path:'tests/screens/matrix-'+name.toLowerCase().replaceAll(' ','-')+'.png'});T.equal(errs,[],name+' no browser errors');report.push({name,width,height,engine,touch,...state});await context.close();\n }}finally{await b.close();}}\n fs.writeFileSync('tests/viewport-report.json',JSON.stringify(report,null,2));\n // Required engine checker, captured so this command only prints failures and its final count.\n try{const output=execFileSync('node',['engine/tools/check.mjs',path.resolve('..',path.basename(process.cwd())+'.html'),'--seconds','2','--out','tests/engine-check'],{encoding:'utf8',timeout:90000});fs.writeFileSync('tests/engine-check-output.txt',output);T.check(true,'engine checker passes at 1280x720');}catch(e){T.check(false,'engine checker: '+String(e.stdout||e.message).slice(-1600));}\n}\nEOF\nnode tests/run.mjs hub\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
