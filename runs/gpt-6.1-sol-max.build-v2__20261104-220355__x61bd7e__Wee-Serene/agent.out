{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"cat > game/scenes/member.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,game=G.game,P=G.palette;\nlet menu,portrait,sub='main';\nconst slotInfo=slot=>{const s=game.saves.get(slot);return s&&\"'!s.damaged&&s.data?.version===1?s.data:null;};\nG.scenes.members={view:'\"'brawler',camera:{zoom:false},\n enter(){const items=[0,1,2].map(slot=>{const m=slotInfo(slot);return {label:m?m.name:'New member '+(slot+1),value:m?'Day '+m.day+' / '+m.spineAge:'An empty mat',fn:()=>{G.slot=slot;if(m){G.loadMember(slot);G.go('memberOptions');}else{G.member=G.memberDefault();G.go('customize');}}};});items.push(['Back',()=>G.go('title')]);menu=new G.Pills(items,{y:78,h:29,w:260,gap:8,back:()=>G.go('title')});},\n update(dt){menu.update(dt);},draw(r){G.paper(r);G.header(r,'Reception','Member cards');r.overlay(g=>{G.text(g,'Your spot is saved. So is your wobble.',r.W/2,57,{align:'center',color:P.muted});});menu.draw(r);}\n};\nG.scenes.memberOptions={view:'brawler',camera:{zoom:false},enter(){portrait=G.playerRig();menu=new G.Pills([['Continue retreat',()=>G.go('bungalow')],['Change appearance',()=>G.go('customize',{existing:true})],['Begin a fresh stay',()=>G.go('freshStay')],['Back',()=>G.go('members')]],{y:89,w:210,h:25,back:()=>G.go('members')});},update(dt){menu.update(dt);},draw(r){G.paper(r);G.header(r,'Member '+(G.slot+1),G.member.name);r.overlay(g=>{G.text(g,'Day '+G.member.day+' · Spine Age '+G.member.spineAge+' · '+G.member.minutes.toFixed(1)+' minutes',14,58,{color:P.muted});});menu.draw(r);}};\nG.scenes.freshStay={view:'brawler',camera:{zoom:false},enter(){menu=new G.Pills([['Keep this member',()=>G.go('memberOptions')],['Replace with a new member',()=>{G.member=G.memberDefault();G.persist();G.go('customize');}]],{y:115,w:250,back:()=>G.go('memberOptions')});},update(dt){menu.update(dt);},draw(r){G.paper(r);G.header(r,'A fresh start','Begin again?');r.overlay(g=>G.paragraph(g,'This replaces the progress on this member card. The other cards keep their places.',14,65,r.W-28,{color:P.muted}));menu.draw(r);}};\nfunction customMenu(){const a=G.member.avatar;let items;\n if(sub==='looks')items=[{label:'Hair',value:()=>a.hair,fn:()=>{a.hair=G.HAIRS[(G.HAIRS.indexOf(a.hair)+1)%5];portrait=G.playerRig();}},{label:'Skin',value:()=>String(a.skin+1)+' / 6',fn:()=>{a.skin=(a.skin+1)%6;portrait=G.playerRig();}},{label:'Top',value:()=>String(a.top+1)+' / 8',fn:()=>{a.top=(a.top+1)%8;portrait=G.playerRig();}},{label:'Bottoms',value:()=>String(a.bottom+1)+' / 4',fn:()=>{a.bottom=(a.bottom+1)%4;portrait=G.playerRig();}},['Done',()=>{sub='main';customMenu();}]];\n else items=[{label:'Reroll nickname',value:()=>G.member.name,fn:()=>{G.member.name=G.NAMES[Math.floor(G.rng()*G.NAMES.length)];}},{label:'Appearance',fn:()=>{sub='looks';customMenu();}},{label:'Instructor',value:()=>G.member.instructor,fn:()=>{G.member.instructor=G.member.instructor==='Birch'?'Alder':'Birch';} },['Take my place',()=>{G.persist();G.go(G.member.arrived?'bungalow':'arrival');}],['Back',()=>G.go('members')]];\n menu=new G.Pills(items,{x:14,y:83,w:()=>Math.min(245,game.W*.58),h:24,gap:6,back:()=>{if(sub==='looks'){sub='main';customMenu();}else G.go('members');}});\n}\nG.scenes.customize={view:'brawler',camera:{zoom:false},enter(){sub='main';G.light();portrait=G.playerRig(2.1);customMenu();},update(dt){G.poseRig(portrait,'idle',G.time,{dt,x:70,y:6});menu.update(dt);},draw(r){G.studio(r,'reception');G.drawRig(r,portrait,70,6);G.header(r,'Member card','A little introduction');r.overlay(g=>{G.text(g,sub==='looks'?'Pick a row to change it.':'No wrong answers. Some unusual names.',14,59,{color:P.muted});});menu.draw(r);}};\nG.scenes.arrival={view:'brawler',camera:{zoom:false},pausable:true,enter(){G.light();portrait=G.playerRig(1.8);G.speech(G.lines.arrival,{done:()=>{G.member.arrived=true;G.persist();G.go('instructor');}});},update(dt){G.poseRig(portrait,'idle',G.time,{dt,x:20,y:0});G.talk.update(dt);},draw(r){G.studio(r,'reception');G.drawRig(r,portrait,20,0);G.tare(r,-33,5,1.6);G.header(r,'Day 1','Welcome to Lumbar Island');G.talk.draw(r);}};\nlet birch,alder;\nG.scenes.instructor={view:'brawler',camera:{zoom:false},pausable:true,enter(){G.light();birch=G.instructorRig('Birch',1.7);alder=G.instructorRig('Alder',1.7);menu=new G.Pills([['Birch',()=>pick('Birch')],['Alder',()=>pick('Alder')]],{y:()=>game.H-64,w:200,h:22,gap:8});},update(dt){G.poseRig(birch,'idle',G.time,{dt,x:-40,y:0});G.poseRig(alder,'idle',G.time,{dt,x:40,y:0});menu.update(dt);},draw(r){G.studio(r,'iron');G.drawRig(r,birch,-40,0);G.drawRig(r,alder,40,0);G.header(r,'Your instructor','Both are very patient');menu.draw(r);}};\nfunction pick(name){G.member.instructor=name;G.speech(G.lines[name][0],{name,done:()=>{G.persist();G.go('bungalow');}});G.go('welcomeInstructor',{name});}\nG.scenes.welcomeInstructor={view:'brawler',camera:{zoom:false},pausable:true,enter({name}){G.speech(G.lines[name][0],{name,done:()=>{G.persist();G.go('bungalow');}});},update(dt){G.talk.update(dt);},draw(r){G.studio(r,'iron');G.drawRig(r,G.member.instructor==='Birch'?birch:alder,0,0);G.talk.draw(r);}};\n})();\nEOF\ncat > game/scenes/day.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,game=G.game,P=G.palette,{px}=E;\nlet menu,rig,check,stage,clock,dir,held,question;\nG.scenes.bungalow={view:'brawler',camera:{zoom:false},pausable:true,\n enter(){G.context=null;G.light(G.member.sessions>1);G.music(G.member.sessions>1?'dusk':'island');rig=G.playerRig(1.8);const checked=G.member.checked;\n menu=new G.Pills([[checked?'Return to the island':'Morning Body Check',()=>G.go(checked?'island':'bodycheck')],['Wardrobe',()=>G.go('wardrobe')],['Member card',()=>G.go('memberOptions')],['Go to bed',()=>G.member.sessions<3?G.go('earlyBed'):G.go('evening')]],{x:14,y:87,w:210,h:25,gap:8});G.persist();\n },update(dt){G.poseRig(rig,'idle',G.time,{dt,x:45,y:5});menu.update(dt);},draw(r){G.studio(r,'bungalow');G.drawRig(r,rig,45,5);G.header(r,'Day '+G.member.day+' · '+G.DAYS[Math.min(4,G.member.day-1)].name,'Your bungalow');r.overlay(g=>{G.text(g,'Spine Age',r.W-35,60,{align:'center',color:P.muted});G.text(g,String(G.member.spineAge),r.W-42,78,{align:'center',scale:3,color:P.cyan});G.drawGerald(g,r.W-51,r.H-26,1);G.text(g,G.member.minutes.toFixed(1)+' min',r.W-52,r.H-14,{align:'center',color:P.muted});});menu.draw(r);}\n};\nG.scenes.wardrobe={view:'brawler',camera:{zoom:false},pausable:true,enter(){G.light();rig=G.playerRig(2);const items=G.UNLOCKS.filter(x=>x[0]<=G.member.minutes&&['Towel','Headband','Sunhat',\\\"Gertrude's spare hat\\\"].includes(x[1])).map(([n,name])=>({label:name,fn:()=>{G.member.avatar.hat=name==='Headband'?1:name==='Sunhat'?2:name.includes('spare')?3:0;rig=G.playerRig(2);G.persist();}}));if(\"'!items.length)items.push({label:'\"'Your everyday self',fn:()=>{}});else items.push(['No accessories',()=>{G.member.avatar.hat=0;rig=G.playerRig(2);G.persist();}]);items.push(['Back',()=>G.go('bungalow')]);menu=new G.Pills(items,{x:14,y:90,w:200,h:25,gap:6,back:()=>G.go('bungalow')});},update(dt){G.poseRig(rig,'idle',G.time,{dt,x:65,y:5});menu.update(dt);},draw(r){G.studio(r,'bungalow');G.header(r,'For your minutes','The wardrobe rail');G.drawRig(r,rig,65,5);r.overlay(g=>{const next=G.UNLOCKS.find(x=>x[0]>G.member.minutes);G.text(g,next?'Next: '+next[1]+' at '+next[0]+' minutes':'Gerald has a friend now.',14,61,{color:P.muted});});menu.draw(r);}};\nG.scenes.bodycheck={view:'brawler',camera:{zoom:false},pausable:true,\n enter(){G.light();G.music('studio');rig=G.playerRig(1.9);stage='greet';clock=0;dir=0;held=0;question=G.lines.questions[(G.member.day-1)%5];check=new G.Balance({k:14,c:7,s:4,A:3,nf:1.1,R:.2},E.rng(G.member.day*11));G.checkIntent=G.emptyIntent();G.speech(G.DAYS[Math.min(4,G.member.day-1)].morning,{done:()=>{stage='still';clock=0;}});},\n update(dt){clock+=dt;G.poseRig(rig,'idle',G.time,{dt,x:0,y:2,wob:[check.x,check.y]});if(stage==='greet'){G.talk.update(dt);return;}\n  const c={bal:check,intent:G.checkIntent,input:game.input,seed:17};if(G.dev.bot)G.balanceBot(c,G.dev.bot,dt);else G.readIntent(c,dt,{contestants:[c]});\n  if(stage==='still'){check.step(dt,c.intent);if(clock>5){stage='lean';clock=0;}}\n  else if(stage==='lean'){const target=[[.5,0],[-.5,0],[0,.5],[0,-.5]][dir];check.target=target;check.step(dt,c.intent,{noFalls:true});if(G.dev.bot){c.intent.x=target[0];c.intent.y=target[1];}if(Math.hypot(check.x-target[0],check.y-target[1])<.3)held+=dt;else held=Math.max(0,held-dt);if(held>=1||clock>6){dir++;held=0;clock=0;if(dir>=4){stage='question';menu=new G.Pills([[question[1],readout],[question[2],readout]],{y:()=>game.H-68,w:240,h:23,gap:7});}}}\n  else if(stage==='question')menu.update(dt);\n  else if(stage==='reading'){G.talk.update(dt);}\n },\n draw(r){G.studio(r,'reception');G.mat(r,0,3);G.tare(r,0,1,2.2,'judging');G.drawRig(r,rig,0,2);G.header(r,'Morning ritual','Body Check');r.overlay(g=>{if(stage==='still'){G.text(g,'Stillness test · 5 seconds',r.W/2,59,{align:'center',color:P.cyan});G.drawPlate(g,r.W/2,r.H-35,check);}\n else if(stage==='lean'){const names=['Right','Left','Forward','Back'];G.text(g,'Lean '+names[dir].toLowerCase(),r.W/2,59,{align:'center',color:P.cyan});G.drawPlate(g,r.W/2,r.H-35,check);}\n else if(stage==='question')G.text(g,question[0],r.W/2,60,{align:'center',color:P.ink});});if(stage==='question')menu.draw(r);if(stage==='greet'||stage==='reading')G.talk.draw(r);if(['still','lean'].includes(stage))G.prompt(r,'lean','Small nudges');}\n};\nfunction readout(){stage='reading';G.member.checked=true;G.refreshAge();if(G.member.day===3)G.member.spineAge=G.member.history[G.member.history.length-1];const ducks=(10.8+G.member.day*.6).toFixed(1);G.speech([G.lines.replies[(G.member.day-1)%5],\\\"Today you weigh \\\"+ducks+\\\" ducks. That is a normal number of ducks.\\\",\\\"Your Spine Age is \\\"+G.member.spineAge+\\\". Gertrude's is 19.\\\",\\\"Today's suggestion: \\\"+G.activities[G.suggestion()].name+'. Gerald accepts extra minutes.'],{done:()=>{G.persist();if(G.member.day===1&&G.member.sessions===0)G.startSession('stork',1,'story');else if(G.member.day===4&&\"'!G.member.tareDay)G.go('\"'tareDay');else if(G.member.day===5&&\"'!G.member.ended)G.go('\"'games');else G.go('island');}});}\nG.scenes.earlyBed={view:'brawler',camera:{zoom:false},pausable:true,enter(){menu=new G.Pills([['One more session',()=>G.go('island')],['Rest for today',()=>G.go('evening')]],{y:120,w:225,h:26,gap:8,back:()=>G.go('bungalow')});},update(dt){menu.update(dt);},draw(r){G.studio(r,'bungalow');G.header(r,'An early night','Rest is permitted');r.overlay(g=>G.paragraph(g,G.lines.early[0],14,64,r.W-28));menu.draw(r);}};\nlet eveningT=0;\nG.scenes.evening={view:'brawler',camera:{zoom:false},pausable:true,enter(){G.light(true);G.music('dusk');eveningT=0;G.refreshAge();G.persist();menu=new G.Pills([['Sleep well',()=>G.newDay()],['A look around',()=>G.go('island')]],{x:()=>game.W-171,y:()=>game.H-71,w:157,h:23,gap:8});},update(dt){eveningT+=dt;menu.update(dt);},draw(r){G.studio(r,'bungalow',{dusk:true});G.header(r,'Day '+G.member.day+' complete','A small improvement');r.overlay(g=>{G.text(g,'Spine Age',22,61,{color:P.muted});G.text(g,String(G.member.spineAge),22,79,{scale:4,color:P.cyan});G.flower(g,117,100);G.text(g,G.member.minutes.toFixed(1),r.W-67,64,{scale:3,align:'center'});G.text(g,'minutes with Gerald',r.W-80,91,{align:'center',color:P.muted});G.drawGerald(g,r.W-80,126,1.3);const hh=G.member.history.slice(-7).concat([G.member.spineAge]);let prev=null;hh.forEach((v,i)=>{const p=[24+i*18,151-(71-v)*.45];if(prev)px.line(g,...prev,...p,'#94b9b8',1);px.disc(g,...p,2,P.cyan);prev=p;});G.paragraph(g,G.DAYS[Math.min(4,G.member.day-1)].evening,16,r.H-60,Math.min(220,r.W*.55));});menu.draw(r);}};\nG.newDay=()=>{G.member.history.push(G.member.spineAge);G.member.history=G.member.history.slice(-8);G.member.day++;G.member.sessions=0;G.member.checked=false;G.member.dailyScores=[];if(G.member.day>5&&\"'!G.member.ended){G.go('\"'ending');return;}G.persist();G.go('bungalow');};\nG.scenes.tareDay={view:'brawler',camera:{zoom:false},pausable:true,enter(){G.light();stage='waiting';clock=0;menu=new G.Pills([['Read the old scale',()=>{stage='reading';G.speech(G.lines.recalibration.slice(1),{done:()=>{G.member.tareDay=true;G.persist();G.go('island');}});}]],{y:()=>game.H-42,w:225,h:24});},update(dt){clock+=dt;if(stage==='waiting')menu.update(dt);else G.talk.update(dt);},draw(r){G.studio(r,'reception');G.header(r,\\\"Tare's Day\\\",'A recalibration');r.overlay(g=>{const x=r.W/2,y=r.H*.58;G.round(g,x-43,y-4,86,24,'#b2c4c4');G.round(g,x-39,y-8,78,20,'#e1e8e4');G.drawTare(g,x,y-10,2,'worried');G.text(g,'It is my turn on the scale. Please be gentle.',r.W/2,60,{align:'center',color:P.muted});});if(stage==='waiting')menu.draw(r);else G.talk.draw(r);}};\n})();\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"cat > game/scenes/member.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,game=G.game,P=G.palette;\nlet menu,portrait,sub='main';\nconst slotInfo=slot=>{const s=game.saves.get(slot);return s&&\"'!s.damaged&&s.data?.version===1?s.data:null;};\nG.scenes.members={view:'\"'brawler',camera:{zoom:false},\n enter(){const items=[0,1,2].map(slot=>{const m=slotInfo(slot);return {label:m?m.name:'New member '+(slot+1),value:m?'Day '+m.day+' / '+m.spineAge:'An empty mat',fn:()=>{G.slot=slot;if(m){G.loadMember(slot);G.go('memberOptions');}else{G.member=G.memberDefault();G.go('customize');}}};});items.push(['Back',()=>G.go('title')]);menu=new G.Pills(items,{y:78,h:29,w:260,gap:8,back:()=>G.go('title')});},\n update(dt){menu.update(dt);},draw(r){G.paper(r);G.header(r,'Reception','Member cards');r.overlay(g=>{G.text(g,'Your spot is saved. So is your wobble.',r.W/2,57,{align:'center',color:P.muted});});menu.draw(r);}\n};\nG.scenes.memberOptions={view:'brawler',camera:{zoom:false},enter(){portrait=G.playerRig();menu=new G.Pills([['Continue retreat',()=>G.go('bungalow')],['Change appearance',()=>G.go('customize',{existing:true})],['Begin a fresh stay',()=>G.go('freshStay')],['Back',()=>G.go('members')]],{y:89,w:210,h:25,back:()=>G.go('members')});},update(dt){menu.update(dt);},draw(r){G.paper(r);G.header(r,'Member '+(G.slot+1),G.member.name);r.overlay(g=>{G.text(g,'Day '+G.member.day+' · Spine Age '+G.member.spineAge+' · '+G.member.minutes.toFixed(1)+' minutes',14,58,{color:P.muted});});menu.draw(r);}};\nG.scenes.freshStay={view:'brawler',camera:{zoom:false},enter(){menu=new G.Pills([['Keep this member',()=>G.go('memberOptions')],['Replace with a new member',()=>{G.member=G.memberDefault();G.persist();G.go('customize');}]],{y:115,w:250,back:()=>G.go('memberOptions')});},update(dt){menu.update(dt);},draw(r){G.paper(r);G.header(r,'A fresh start','Begin again?');r.overlay(g=>G.paragraph(g,'This replaces the progress on this member card. The other cards keep their places.',14,65,r.W-28,{color:P.muted}));menu.draw(r);}};\nfunction customMenu(){const a=G.member.avatar;let items;\n if(sub==='looks')items=[{label:'Hair',value:()=>a.hair,fn:()=>{a.hair=G.HAIRS[(G.HAIRS.indexOf(a.hair)+1)%5];portrait=G.playerRig();}},{label:'Skin',value:()=>String(a.skin+1)+' / 6',fn:()=>{a.skin=(a.skin+1)%6;portrait=G.playerRig();}},{label:'Top',value:()=>String(a.top+1)+' / 8',fn:()=>{a.top=(a.top+1)%8;portrait=G.playerRig();}},{label:'Bottoms',value:()=>String(a.bottom+1)+' / 4',fn:()=>{a.bottom=(a.bottom+1)%4;portrait=G.playerRig();}},['Done',()=>{sub='main';customMenu();}]];\n else items=[{label:'Reroll nickname',value:()=>G.member.name,fn:()=>{G.member.name=G.NAMES[Math.floor(G.rng()*G.NAMES.length)];}},{label:'Appearance',fn:()=>{sub='looks';customMenu();}},{label:'Instructor',value:()=>G.member.instructor,fn:()=>{G.member.instructor=G.member.instructor==='Birch'?'Alder':'Birch';} },['Take my place',()=>{G.persist();G.go(G.member.arrived?'bungalow':'arrival');}],['Back',()=>G.go('members')]];\n menu=new G.Pills(items,{x:14,y:83,w:()=>Math.min(245,game.W*.58),h:24,gap:6,back:()=>{if(sub==='looks'){sub='main';customMenu();}else G.go('members');}});\n}\nG.scenes.customize={view:'brawler',camera:{zoom:false},enter(){sub='main';G.light();portrait=G.playerRig(2.1);customMenu();},update(dt){G.poseRig(portrait,'idle',G.time,{dt,x:70,y:6});menu.update(dt);},draw(r){G.studio(r,'reception');G.drawRig(r,portrait,70,6);G.header(r,'Member card','A little introduction');r.overlay(g=>{G.text(g,sub==='looks'?'Pick a row to change it.':'No wrong answers. Some unusual names.',14,59,{color:P.muted});});menu.draw(r);}};\nG.scenes.arrival={view:'brawler',camera:{zoom:false},pausable:true,enter(){G.light();portrait=G.playerRig(1.8);G.speech(G.lines.arrival,{done:()=>{G.member.arrived=true;G.persist();G.go('instructor');}});},update(dt){G.poseRig(portrait,'idle',G.time,{dt,x:20,y:0});G.talk.update(dt);},draw(r){G.studio(r,'reception');G.drawRig(r,portrait,20,0);G.tare(r,-33,5,1.6);G.header(r,'Day 1','Welcome to Lumbar Island');G.talk.draw(r);}};\nlet birch,alder;\nG.scenes.instructor={view:'brawler',camera:{zoom:false},pausable:true,enter(){G.light();birch=G.instructorRig('Birch',1.7);alder=G.instructorRig('Alder',1.7);menu=new G.Pills([['Birch',()=>pick('Birch')],['Alder',()=>pick('Alder')]],{y:()=>game.H-64,w:200,h:22,gap:8});},update(dt){G.poseRig(birch,'idle',G.time,{dt,x:-40,y:0});G.poseRig(alder,'idle',G.time,{dt,x:40,y:0});menu.update(dt);},draw(r){G.studio(r,'iron');G.drawRig(r,birch,-40,0);G.drawRig(r,alder,40,0);G.header(r,'Your instructor','Both are very patient');menu.draw(r);}};\nfunction pick(name){G.member.instructor=name;G.speech(G.lines[name][0],{name,done:()=>{G.persist();G.go('bungalow');}});G.go('welcomeInstructor',{name});}\nG.scenes.welcomeInstructor={view:'brawler',camera:{zoom:false},pausable:true,enter({name}){G.speech(G.lines[name][0],{name,done:()=>{G.persist();G.go('bungalow');}});},update(dt){G.talk.update(dt);},draw(r){G.studio(r,'iron');G.drawRig(r,G.member.instructor==='Birch'?birch:alder,0,0);G.talk.draw(r);}};\n})();\nEOF\ncat > game/scenes/day.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,game=G.game,P=G.palette,{px}=E;\nlet menu,rig,check,stage,clock,dir,held,question;\nG.scenes.bungalow={view:'brawler',camera:{zoom:false},pausable:true,\n enter(){G.context=null;G.light(G.member.sessions>1);G.music(G.member.sessions>1?'dusk':'island');rig=G.playerRig(1.8);const checked=G.member.checked;\n menu=new G.Pills([[checked?'Return to the island':'Morning Body Check',()=>G.go(checked?'island':'bodycheck')],['Wardrobe',()=>G.go('wardrobe')],['Member card',()=>G.go('memberOptions')],['Go to bed',()=>G.member.sessions<3?G.go('earlyBed'):G.go('evening')]],{x:14,y:87,w:210,h:25,gap:8});G.persist();\n },update(dt){G.poseRig(rig,'idle',G.time,{dt,x:45,y:5});menu.update(dt);},draw(r){G.studio(r,'bungalow');G.drawRig(r,rig,45,5);G.header(r,'Day '+G.member.day+' · '+G.DAYS[Math.min(4,G.member.day-1)].name,'Your bungalow');r.overlay(g=>{G.text(g,'Spine Age',r.W-35,60,{align:'center',color:P.muted});G.text(g,String(G.member.spineAge),r.W-42,78,{align:'center',scale:3,color:P.cyan});G.drawGerald(g,r.W-51,r.H-26,1);G.text(g,G.member.minutes.toFixed(1)+' min',r.W-52,r.H-14,{align:'center',color:P.muted});});menu.draw(r);}\n};\nG.scenes.wardrobe={view:'brawler',camera:{zoom:false},pausable:true,enter(){G.light();rig=G.playerRig(2);const items=G.UNLOCKS.filter(x=>x[0]<=G.member.minutes&&['Towel','Headband','Sunhat',\\\"Gertrude's spare hat\\\"].includes(x[1])).map(([n,name])=>({label:name,fn:()=>{G.member.avatar.hat=name==='Headband'?1:name==='Sunhat'?2:name.includes('spare')?3:0;rig=G.playerRig(2);G.persist();}}));if(\"'!items.length)items.push({label:'\"'Your everyday self',fn:()=>{}});else items.push(['No accessories',()=>{G.member.avatar.hat=0;rig=G.playerRig(2);G.persist();}]);items.push(['Back',()=>G.go('bungalow')]);menu=new G.Pills(items,{x:14,y:90,w:200,h:25,gap:6,back:()=>G.go('bungalow')});},update(dt){G.poseRig(rig,'idle',G.time,{dt,x:65,y:5});menu.update(dt);},draw(r){G.studio(r,'bungalow');G.header(r,'For your minutes','The wardrobe rail');G.drawRig(r,rig,65,5);r.overlay(g=>{const next=G.UNLOCKS.find(x=>x[0]>G.member.minutes);G.text(g,next?'Next: '+next[1]+' at '+next[0]+' minutes':'Gerald has a friend now.',14,61,{color:P.muted});});menu.draw(r);}};\nG.scenes.bodycheck={view:'brawler',camera:{zoom:false},pausable:true,\n enter(){G.light();G.music('studio');rig=G.playerRig(1.9);stage='greet';clock=0;dir=0;held=0;question=G.lines.questions[(G.member.day-1)%5];check=new G.Balance({k:14,c:7,s:4,A:3,nf:1.1,R:.2},E.rng(G.member.day*11));G.checkIntent=G.emptyIntent();G.speech(G.DAYS[Math.min(4,G.member.day-1)].morning,{done:()=>{stage='still';clock=0;}});},\n update(dt){clock+=dt;G.poseRig(rig,'idle',G.time,{dt,x:0,y:2,wob:[check.x,check.y]});if(stage==='greet'){G.talk.update(dt);return;}\n  const c={bal:check,intent:G.checkIntent,input:game.input,seed:17};if(G.dev.bot)G.balanceBot(c,G.dev.bot,dt);else G.readIntent(c,dt,{contestants:[c]});\n  if(stage==='still'){check.step(dt,c.intent);if(clock>5){stage='lean';clock=0;}}\n  else if(stage==='lean'){const target=[[.5,0],[-.5,0],[0,.5],[0,-.5]][dir];check.target=target;check.step(dt,c.intent,{noFalls:true});if(G.dev.bot){c.intent.x=target[0];c.intent.y=target[1];}if(Math.hypot(check.x-target[0],check.y-target[1])<.3)held+=dt;else held=Math.max(0,held-dt);if(held>=1||clock>6){dir++;held=0;clock=0;if(dir>=4){stage='question';menu=new G.Pills([[question[1],readout],[question[2],readout]],{y:()=>game.H-68,w:240,h:23,gap:7});}}}\n  else if(stage==='question')menu.update(dt);\n  else if(stage==='reading'){G.talk.update(dt);}\n },\n draw(r){G.studio(r,'reception');G.mat(r,0,3);G.tare(r,0,1,2.2,'judging');G.drawRig(r,rig,0,2);G.header(r,'Morning ritual','Body Check');r.overlay(g=>{if(stage==='still'){G.text(g,'Stillness test · 5 seconds',r.W/2,59,{align:'center',color:P.cyan});G.drawPlate(g,r.W/2,r.H-35,check);}\n else if(stage==='lean'){const names=['Right','Left','Forward','Back'];G.text(g,'Lean '+names[dir].toLowerCase(),r.W/2,59,{align:'center',color:P.cyan});G.drawPlate(g,r.W/2,r.H-35,check);}\n else if(stage==='question')G.text(g,question[0],r.W/2,60,{align:'center',color:P.ink});});if(stage==='question')menu.draw(r);if(stage==='greet'||stage==='reading')G.talk.draw(r);if(['still','lean'].includes(stage))G.prompt(r,'lean','Small nudges');}\n};\nfunction readout(){stage='reading';G.member.checked=true;G.refreshAge();if(G.member.day===3)G.member.spineAge=G.member.history[G.member.history.length-1];const ducks=(10.8+G.member.day*.6).toFixed(1);G.speech([G.lines.replies[(G.member.day-1)%5],\\\"Today you weigh \\\"+ducks+\\\" ducks. That is a normal number of ducks.\\\",\\\"Your Spine Age is \\\"+G.member.spineAge+\\\". Gertrude's is 19.\\\",\\\"Today's suggestion: \\\"+G.activities[G.suggestion()].name+'. Gerald accepts extra minutes.'],{done:()=>{G.persist();if(G.member.day===1&&G.member.sessions===0)G.startSession('stork',1,'story');else if(G.member.day===4&&\"'!G.member.tareDay)G.go('\"'tareDay');else if(G.member.day===5&&\"'!G.member.ended)G.go('\"'games');else G.go('island');}});}\nG.scenes.earlyBed={view:'brawler',camera:{zoom:false},pausable:true,enter(){menu=new G.Pills([['One more session',()=>G.go('island')],['Rest for today',()=>G.go('evening')]],{y:120,w:225,h:26,gap:8,back:()=>G.go('bungalow')});},update(dt){menu.update(dt);},draw(r){G.studio(r,'bungalow');G.header(r,'An early night','Rest is permitted');r.overlay(g=>G.paragraph(g,G.lines.early[0],14,64,r.W-28));menu.draw(r);}};\nlet eveningT=0;\nG.scenes.evening={view:'brawler',camera:{zoom:false},pausable:true,enter(){G.light(true);G.music('dusk');eveningT=0;G.refreshAge();G.persist();menu=new G.Pills([['Sleep well',()=>G.newDay()],['A look around',()=>G.go('island')]],{x:()=>game.W-171,y:()=>game.H-71,w:157,h:23,gap:8});},update(dt){eveningT+=dt;menu.update(dt);},draw(r){G.studio(r,'bungalow',{dusk:true});G.header(r,'Day '+G.member.day+' complete','A small improvement');r.overlay(g=>{G.text(g,'Spine Age',22,61,{color:P.muted});G.text(g,String(G.member.spineAge),22,79,{scale:4,color:P.cyan});G.flower(g,117,100);G.text(g,G.member.minutes.toFixed(1),r.W-67,64,{scale:3,align:'center'});G.text(g,'minutes with Gerald',r.W-80,91,{align:'center',color:P.muted});G.drawGerald(g,r.W-80,126,1.3);const hh=G.member.history.slice(-7).concat([G.member.spineAge]);let prev=null;hh.forEach((v,i)=>{const p=[24+i*18,151-(71-v)*.45];if(prev)px.line(g,...prev,...p,'#94b9b8',1);px.disc(g,...p,2,P.cyan);prev=p;});G.paragraph(g,G.DAYS[Math.min(4,G.member.day-1)].evening,16,r.H-60,Math.min(220,r.W*.55));});menu.draw(r);}};\nG.newDay=()=>{G.member.history.push(G.member.spineAge);G.member.history=G.member.history.slice(-8);G.member.day++;G.member.sessions=0;G.member.checked=false;G.member.dailyScores=[];if(G.member.day>5&&\"'!G.member.ended){G.go('\"'ending');return;}G.persist();G.go('bungalow');};\nG.scenes.tareDay={view:'brawler',camera:{zoom:false},pausable:true,enter(){G.light();stage='waiting';clock=0;menu=new G.Pills([['Read the old scale',()=>{stage='reading';G.speech(G.lines.recalibration.slice(1),{done:()=>{G.member.tareDay=true;G.persist();G.go('island');}});}]],{y:()=>game.H-42,w:225,h:24});},update(dt){clock+=dt;if(stage==='waiting')menu.update(dt);else G.talk.update(dt);},draw(r){G.studio(r,'reception');G.header(r,\\\"Tare's Day\\\",'A recalibration');r.overlay(g=>{const x=r.W/2,y=r.H*.58;G.round(g,x-43,y-4,86,24,'#b2c4c4');G.round(g,x-39,y-8,78,20,'#e1e8e4');G.drawTare(g,x,y-10,2,'worried');G.text(g,'It is my turn on the scale. Please be gentle.',r.W/2,60,{align:'center',color:P.muted});});if(stage==='waiting')menu.draw(r);else G.talk.draw(r);}};\n})();\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"cat > game/scenes/island.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,game=G.game,{px,clamp}=E,P=G.palette;\nE.SHAPES.retreatHouse={about:'little white retreat bungalow with a sea-green roof',mats:{w:'retreatWhite',r:'retreatCyan',p:'retreatWood'},parts:[['box','w',[0,0,0],[56,35,26]],['prism','r',[0,0,26],[[-24,0],[0,14],[24,0]],65,{axis:'x'}],['box','p',[0,18,0],[11,1,18]],['row',2,[34,0,0],['box','r',[0,18,12],[10,1,8]]]]};\nconst spots=[\n ['stork',420,85],['flow',465,85],['candle',510,85],['squat',558,163],['pushup',602,163],['lunge',646,163],['step',425,351],['hoop',470,351],['jog',515,351],['tray',237,294],['slalom',123,96],['laundry',558,272]\n];\nG.makeIsland=()=>{const rows=[];for(let y=0;y<26;y++){let row='';for(let x=0;x<44;x++){const d=Math.pow((x-22)/21,2)+Math.pow((y-13)/12,2);row+=d>1?'~':y>20?'.':x<11&&y<8?'\"'^'\"':',';}rows.push(row);}\n const map=new E.TileMap({rows,legend:{'~':{floor:'sea',block:true},',':{floor:'grass'},'.':{floor:'sand'},'\"'^'\"':{floor:'mountain'}},types:{},block:['sea'],outside:'#54b8c8',ao:0,floorTex:(x,y,tag)=>{const speck=((Math.floor(x)*7+Math.floor(y)*13)%19)/19;return tag==='sea'?[77+speck*10,177+speck*10,192+speck*10]:tag==='mountain'?[211+speck*15,225+speck*13,224+speck*16]:tag==='sand'?[231+speck*10,214+speck*10,175+speck*10]:[166+speck*12,199+speck*12,153+speck*10];}});\n const things=spots.map(([id,x,y])=>({kind:'mat',id,x,y,name:G.activities[id].name}));things.push({kind:'bed',x:113,y:220,name:'Your bungalow'},{kind:'tare',x:300,y:157,name:'Reception'},{kind:'bar',x:337,y:236,name:'Dennis'},{kind:'festival',x:376,y:185,name:'The Gentle Games'});\n const people=G.regulars.slice(0,7).map((a,i)=>({kind:'person',id:i,name:a[0],x:[405,337,548,213,447,199,350][i],y:[115,218,327,255,314,192,275][i],rig:G.regularRig(i,1.1)}));things.push(...people);\n const hero=new E.Body({x:300,y:207,r:5,gravity:700});return {map,flow:new E.FlowField(map),hero,rig:G.playerRig(1.2),things,people,target:null,hover:null,nearest:null,t:0};};\nG.island=null;\nG.islandUpdate=(s,dt,auto=false)=>{\n s.t+=dt;const I=game.input,m=I.move();let vx=m[0],vy=m[1];\n if(auto){vx=Math.sin(s.t*.6);vy=Math.cos(s.t*.53)*.6;s.hero.x=300+Math.sin(s.t*.3)*100;s.hero.y=210+Math.cos(s.t*.4)*60;}\n else{\n  const point=I.pointer();s.hover=null;if(point){const hits=game.r.pick(...point);s.hover=hits.find(h=>h?.kind)||null;}\n  const click=I.clicked();if(click){const hit=game.r.pick(...click).find(h=>h?.kind);if(hit){s.target={x:hit.x,y:hit.y,thing:hit};s.flow.update(hit.x,hit.y);}else{const p=s.map.pick(...click);if(p&&s.map.walkable(p.cx,p.cy)){s.target={x:p.x,y:p.y};s.flow.update(p.x,p.y);}}}\n  if(Math.hypot(vx,vy)>.05)s.target=null;\n  if(s.target){const dd=Math.hypot(s.target.x-s.hero.x,s.target.y-s.hero.y);if(dd<14){if(s.target.thing)G.interact(s.target.thing);s.target=null;vx=vy=0;}else{const d=s.flow.dir(s.hero.x,s.hero.y,s.target.x,s.target.y);vx=d[0];vy=d[1];}}\n  s.hero.vx=vx*145;s.hero.vy=vy*145;s.hero.update(dt,s.map);\n }\n const speed=Math.hypot(vx,vy);if(speed>.05)s.facing=Math.atan2(vy,vx);G.poseRig(s.rig,'idle',s.t,{dt,x:s.hero.x,y:s.hero.y,facing:s.facing||1.57,clip:speed>.05?'Walk_Loop':'Idle_Subtle'});\n for(const p of s.people)G.poseRig(p.rig,'idle',s.t+p.id,{dt,x:p.x,y:p.y,clip:p.id===5?'Sleeping':'Idle_Subtle'});\n s.nearest=s.things.filter(a=>a.kind\"'!=='\"'festival'||G.member.day===5).sort((a,b)=>Math.hypot(a.x-s.hero.x,a.y-s.hero.y)-Math.hypot(b.x-s.hero.x,b.y-s.hero.y))[0];if(s.nearest&&Math.hypot(s.nearest.x-s.hero.x,s.nearest.y-s.hero.y)>37)s.nearest=null;\n game.focus(s.hero.x,s.hero.y,10);\n if(\"'!auto){if(I.pressed('\"'interact')&&s.nearest)G.interact(s.nearest);if(I.pressed('more'))G.go('catalog');}\n};\nG.drawIsland=(r,s,auto=false)=>{\n s.map.drawFloor(r);s.map.queueWalls(r);for(const [x,y,label]of [[104,200,'Bungalow'],[300,129,'Reception'],[590,124,'Iron room'],[465,46,'Stillness deck'],[337,211,'Juice bar']]){r.shape('retreatHouse',x,y,0,{scale:label==='Reception'?.8:.7,pick:{kind:label==='Bungalow'?'bed':label==='Reception'?'tare':'bar',x,y,name:label}});r.textAt(x,y,48,label,P.ink,{align:'center'});}\n for(let i=0;i<22;i++){const a=i*2.4,x=352+Math.cos(a)*[300,250,290][i%3],y=204+Math.sin(a)*[144,150,133][i%3];if(x<100&&y<120)r.shape('pine',x,y,0,{scale:.8,mats:{w:'retreatWood'}});else if(i%3)G.plant(r,x,y,.8);else r.shape('rock',x,y,0,{scale:.7});}\n for(const m of s.things.filter(t=>t.kind==='mat')){const a=G.activities[m.id],unlocked=G.unlocked(a),color=G.disciplines.find(d=>d.id===a.discipline).color;const hi=(s.hover===m||s.nearest===m);r.shape('mat',m.x,m.y,0,{scale:.75,mats:{a:{color:unlocked?hi?'#e7d6a1':color:'#a4b1ad',pattern:'cloth'}},pick:m});\n  if(m.id===G.suggestion()&&unlocked)r.textAt(m.x,m.y,17+Math.sin(s.t*2)*2,'★','#fff5c3');if(\"'!unlocked)r.textAt(m.x,m.y,11,'\"'Day '+a.day,'#667d7a');else if(hi)r.textAt(m.x,m.y,15,a.name,P.ink);\n }\n for(const p of s.people)G.drawRig(r,p.rig,p.x,p.y,0,{pick:p,outline:s.hover===p});\n r.shape('bench',198,192,0,{scale:.8});r.shape('table',337,228,0,{scale:.8});G.tare(r,s.hero.x-16,s.hero.y+8,.7);G.drawRig(r,s.rig,s.hero.x,s.hero.y,0,{xray:true});\n if(\"'!auto){G.dayHUD(r);const n=s.hover||s.nearest;if(n){G.prompt(r,'\"'interact',n.name);r.overlay(g=>{G.tag(g,n.kind==='mat'?G.activities[n.id].discipline:'Lumbar Island',12,r.H-42);});}G.prompt(r,'more','Activities',12,r.H-21);}\n};\nG.interact=thing=>{if(thing.kind==='mat'){const a=G.activities[thing.id];if(\"'!G.unlocked(a)){G.speech('\"'This mat opens on Day '+a.day+'. It is practicing patience.',{auto:3,modal:false});return;}G.startSession(a.id,1,G.member.ended?'free':'story');}\n else if(thing.kind==='bed')G.go('bungalow');else if(thing.kind==='person'){const bank=G.lines.regulars[Math.min(6,thing.id)],s=bank[(G.member.day-1)%bank.length];G.speech(s,{name:thing.name,portrait:thing.rig,auto:4,modal:false});}\n else if(thing.kind==='bar')G.speech(G.lines.regulars[1][(G.member.day-1)%5],{name:'Dennis',portrait:G.regularRig(1),auto:4,modal:false});\n else if(thing.kind==='festival')G.go('games');else G.speech(G.line('tips'),{auto:4,modal:false});};\nG.scenes.island={view:'threequarter',camera:{zoom:false},pausable:true,enter(){G.context=null;G.sessionPhase=null;game.lights.enabled=true;game.lights.ambient=G.member.sessions>=2?.83:.99;G.music(G.member.sessions>=2?'dusk':'island');if(\"'!G.island)G.island=G.makeIsland();game.follow(null);game.cam.bounds=v=>G.island.map.bounds(v);game.cam.smooth=.08;},update(dt){G.islandUpdate(G.island,dt);G.talk.update(dt);},draw(r){G.drawIsland(r,G.island);G.talk.draw(r);}};\nlet menu,discipline,tier;\nfunction catalogMenu(){\n if(!discipline){menu=new G.Pills([...G.disciplines.map(d=>({label:d.id,value:()=>{const count=Object.values(G.activities).filter(a=>a.discipline===d.id&&G.unlocked(a)).length;return count+'\"' / 3';},fn:()=>{discipline=d.id;catalogMenu();}})),['Back',()=>G.go(G.mode==='story'?'island':'title')]],{x:14,y:71,w:246,h:25,gap:7,back:()=>G.go(G.mode==='story'?'island':'title')});}\n else{const aa=Object.values(G.activities).filter(a=>a.discipline===discipline);menu=new G.Pills([...aa.map(a=>({label:()=>a.name,value:()=>G.unlocked(a,tier)?G.best(a.id,tier).stars?'★'.repeat(G.best(a.id,tier).stars):'New':tier===2?'2★ + Day 4':'Day '+a.day,disabled:\"'!G.unlocked(a,tier),fn:()=>G.startSession(a.id,tier,G.mode)})),{label:()=>tier===1?'\"'Tier 1 · Change to Tier 2':'Tier 2 · Change to Tier 1',fn:()=>{tier=tier===1?2:1;catalogMenu();}},['Back',()=>{discipline=null;catalogMenu();}]],{x:14,y:71,w:()=>Math.min(310,game.W-28),h:25,gap:7,back:()=>{discipline=null;catalogMenu();}});}\n}\nG.scenes.catalog={view:'brawler',camera:{zoom:false},pausable:true,enter(data){G.context=null;G.sessionPhase=null;discipline=data?.discipline||null;tier=1;catalogMenu();},update(dt){menu.update(dt);if(\"'!discipline&&G.mode!=='\"'story'){G.idle+=dt;if(G.idle>=10)G.startAttract();}},draw(r){G.paper(r);G.header(r,G.mode==='story'?'Find your next mat':'Free Play',discipline||'A little of everything');if(\"'!discipline){r.overlay(g=>{G.flower(g,r.W-58,110);G.text(g,'\"'Gently,',r.W-61,145,{align:'center',color:P.muted});G.text(g,'or not at all.',r.W-61,158,{align:'center',color:P.muted});});}menu.draw(r);}};\n})();\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"cat > game/scenes/island.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,game=G.game,{px,clamp}=E,P=G.palette;\nE.SHAPES.retreatHouse={about:'little white retreat bungalow with a sea-green roof',mats:{w:'retreatWhite',r:'retreatCyan',p:'retreatWood'},parts:[['box','w',[0,0,0],[56,35,26]],['prism','r',[0,0,26],[[-24,0],[0,14],[24,0]],65,{axis:'x'}],['box','p',[0,18,0],[11,1,18]],['row',2,[34,0,0],['box','r',[0,18,12],[10,1,8]]]]};\nconst spots=[\n ['stork',420,85],['flow',465,85],['candle',510,85],['squat',558,163],['pushup',602,163],['lunge',646,163],['step',425,351],['hoop',470,351],['jog',515,351],['tray',237,294],['slalom',123,96],['laundry',558,272]\n];\nG.makeIsland=()=>{const rows=[];for(let y=0;y<26;y++){let row='';for(let x=0;x<44;x++){const d=Math.pow((x-22)/21,2)+Math.pow((y-13)/12,2);row+=d>1?'~':y>20?'.':x<11&&y<8?'\"'^'\"':',';}rows.push(row);}\n const map=new E.TileMap({rows,legend:{'~':{floor:'sea',block:true},',':{floor:'grass'},'.':{floor:'sand'},'\"'^'\"':{floor:'mountain'}},types:{},block:['sea'],outside:'#54b8c8',ao:0,floorTex:(x,y,tag)=>{const speck=((Math.floor(x)*7+Math.floor(y)*13)%19)/19;return tag==='sea'?[77+speck*10,177+speck*10,192+speck*10]:tag==='mountain'?[211+speck*15,225+speck*13,224+speck*16]:tag==='sand'?[231+speck*10,214+speck*10,175+speck*10]:[166+speck*12,199+speck*12,153+speck*10];}});\n const things=spots.map(([id,x,y])=>({kind:'mat',id,x,y,name:G.activities[id].name}));things.push({kind:'bed',x:113,y:220,name:'Your bungalow'},{kind:'tare',x:300,y:157,name:'Reception'},{kind:'bar',x:337,y:236,name:'Dennis'},{kind:'festival',x:376,y:185,name:'The Gentle Games'});\n const people=G.regulars.slice(0,7).map((a,i)=>({kind:'person',id:i,name:a[0],x:[405,337,548,213,447,199,350][i],y:[115,218,327,255,314,192,275][i],rig:G.regularRig(i,1.1)}));things.push(...people);\n const hero=new E.Body({x:300,y:207,r:5,gravity:700});return {map,flow:new E.FlowField(map),hero,rig:G.playerRig(1.2),things,people,target:null,hover:null,nearest:null,t:0};};\nG.island=null;\nG.islandUpdate=(s,dt,auto=false)=>{\n s.t+=dt;const I=game.input,m=I.move();let vx=m[0],vy=m[1];\n if(auto){vx=Math.sin(s.t*.6);vy=Math.cos(s.t*.53)*.6;s.hero.x=300+Math.sin(s.t*.3)*100;s.hero.y=210+Math.cos(s.t*.4)*60;}\n else{\n  const point=I.pointer();s.hover=null;if(point){const hits=game.r.pick(...point);s.hover=hits.find(h=>h?.kind)||null;}\n  const click=I.clicked();if(click){const hit=game.r.pick(...click).find(h=>h?.kind);if(hit){s.target={x:hit.x,y:hit.y,thing:hit};s.flow.update(hit.x,hit.y);}else{const p=s.map.pick(...click);if(p&&s.map.walkable(p.cx,p.cy)){s.target={x:p.x,y:p.y};s.flow.update(p.x,p.y);}}}\n  if(Math.hypot(vx,vy)>.05)s.target=null;\n  if(s.target){const dd=Math.hypot(s.target.x-s.hero.x,s.target.y-s.hero.y);if(dd<14){if(s.target.thing)G.interact(s.target.thing);s.target=null;vx=vy=0;}else{const d=s.flow.dir(s.hero.x,s.hero.y,s.target.x,s.target.y);vx=d[0];vy=d[1];}}\n  s.hero.vx=vx*145;s.hero.vy=vy*145;s.hero.update(dt,s.map);\n }\n const speed=Math.hypot(vx,vy);if(speed>.05)s.facing=Math.atan2(vy,vx);G.poseRig(s.rig,'idle',s.t,{dt,x:s.hero.x,y:s.hero.y,facing:s.facing||1.57,clip:speed>.05?'Walk_Loop':'Idle_Subtle'});\n for(const p of s.people)G.poseRig(p.rig,'idle',s.t+p.id,{dt,x:p.x,y:p.y,clip:p.id===5?'Sleeping':'Idle_Subtle'});\n s.nearest=s.things.filter(a=>a.kind\"'!=='\"'festival'||G.member.day===5).sort((a,b)=>Math.hypot(a.x-s.hero.x,a.y-s.hero.y)-Math.hypot(b.x-s.hero.x,b.y-s.hero.y))[0];if(s.nearest&&Math.hypot(s.nearest.x-s.hero.x,s.nearest.y-s.hero.y)>37)s.nearest=null;\n game.focus(s.hero.x,s.hero.y,10);\n if(\"'!auto){if(I.pressed('\"'interact')&&s.nearest)G.interact(s.nearest);if(I.pressed('more'))G.go('catalog');}\n};\nG.drawIsland=(r,s,auto=false)=>{\n s.map.drawFloor(r);s.map.queueWalls(r);for(const [x,y,label]of [[104,200,'Bungalow'],[300,129,'Reception'],[590,124,'Iron room'],[465,46,'Stillness deck'],[337,211,'Juice bar']]){r.shape('retreatHouse',x,y,0,{scale:label==='Reception'?.8:.7,pick:{kind:label==='Bungalow'?'bed':label==='Reception'?'tare':'bar',x,y,name:label}});r.textAt(x,y,48,label,P.ink,{align:'center'});}\n for(let i=0;i<22;i++){const a=i*2.4,x=352+Math.cos(a)*[300,250,290][i%3],y=204+Math.sin(a)*[144,150,133][i%3];if(x<100&&y<120)r.shape('pine',x,y,0,{scale:.8,mats:{w:'retreatWood'}});else if(i%3)G.plant(r,x,y,.8);else r.shape('rock',x,y,0,{scale:.7});}\n for(const m of s.things.filter(t=>t.kind==='mat')){const a=G.activities[m.id],unlocked=G.unlocked(a),color=G.disciplines.find(d=>d.id===a.discipline).color;const hi=(s.hover===m||s.nearest===m);r.shape('mat',m.x,m.y,0,{scale:.75,mats:{a:{color:unlocked?hi?'#e7d6a1':color:'#a4b1ad',pattern:'cloth'}},pick:m});\n  if(m.id===G.suggestion()&&unlocked)r.textAt(m.x,m.y,17+Math.sin(s.t*2)*2,'★','#fff5c3');if(\"'!unlocked)r.textAt(m.x,m.y,11,'\"'Day '+a.day,'#667d7a');else if(hi)r.textAt(m.x,m.y,15,a.name,P.ink);\n }\n for(const p of s.people)G.drawRig(r,p.rig,p.x,p.y,0,{pick:p,outline:s.hover===p});\n r.shape('bench',198,192,0,{scale:.8});r.shape('table',337,228,0,{scale:.8});G.tare(r,s.hero.x-16,s.hero.y+8,.7);G.drawRig(r,s.rig,s.hero.x,s.hero.y,0,{xray:true});\n if(\"'!auto){G.dayHUD(r);const n=s.hover||s.nearest;if(n){G.prompt(r,'\"'interact',n.name);r.overlay(g=>{G.tag(g,n.kind==='mat'?G.activities[n.id].discipline:'Lumbar Island',12,r.H-42);});}G.prompt(r,'more','Activities',12,r.H-21);}\n};\nG.interact=thing=>{if(thing.kind==='mat'){const a=G.activities[thing.id];if(\"'!G.unlocked(a)){G.speech('\"'This mat opens on Day '+a.day+'. It is practicing patience.',{auto:3,modal:false});return;}G.startSession(a.id,1,G.member.ended?'free':'story');}\n else if(thing.kind==='bed')G.go('bungalow');else if(thing.kind==='person'){const bank=G.lines.regulars[Math.min(6,thing.id)],s=bank[(G.member.day-1)%bank.length];G.speech(s,{name:thing.name,portrait:thing.rig,auto:4,modal:false});}\n else if(thing.kind==='bar')G.speech(G.lines.regulars[1][(G.member.day-1)%5],{name:'Dennis',portrait:G.regularRig(1),auto:4,modal:false});\n else if(thing.kind==='festival')G.go('games');else G.speech(G.line('tips'),{auto:4,modal:false});};\nG.scenes.island={view:'threequarter',camera:{zoom:false},pausable:true,enter(){G.context=null;G.sessionPhase=null;game.lights.enabled=true;game.lights.ambient=G.member.sessions>=2?.83:.99;G.music(G.member.sessions>=2?'dusk':'island');if(\"'!G.island)G.island=G.makeIsland();game.follow(null);game.cam.bounds=v=>G.island.map.bounds(v);game.cam.smooth=.08;},update(dt){G.islandUpdate(G.island,dt);G.talk.update(dt);},draw(r){G.drawIsland(r,G.island);G.talk.draw(r);}};\nlet menu,discipline,tier;\nfunction catalogMenu(){\n if(!discipline){menu=new G.Pills([...G.disciplines.map(d=>({label:d.id,value:()=>{const count=Object.values(G.activities).filter(a=>a.discipline===d.id&&G.unlocked(a)).length;return count+'\"' / 3';},fn:()=>{discipline=d.id;catalogMenu();}})),['Back',()=>G.go(G.mode==='story'?'island':'title')]],{x:14,y:71,w:246,h:25,gap:7,back:()=>G.go(G.mode==='story'?'island':'title')});}\n else{const aa=Object.values(G.activities).filter(a=>a.discipline===discipline);menu=new G.Pills([...aa.map(a=>({label:()=>a.name,value:()=>G.unlocked(a,tier)?G.best(a.id,tier).stars?'★'.repeat(G.best(a.id,tier).stars):'New':tier===2?'2★ + Day 4':'Day '+a.day,disabled:\"'!G.unlocked(a,tier),fn:()=>G.startSession(a.id,tier,G.mode)})),{label:()=>tier===1?'\"'Tier 1 · Change to Tier 2':'Tier 2 · Change to Tier 1',fn:()=>{tier=tier===1?2:1;catalogMenu();}},['Back',()=>{discipline=null;catalogMenu();}]],{x:14,y:71,w:()=>Math.min(310,game.W-28),h:25,gap:7,back:()=>{discipline=null;catalogMenu();}});}\n}\nG.scenes.catalog={view:'brawler',camera:{zoom:false},pausable:true,enter(data){G.context=null;G.sessionPhase=null;discipline=data?.discipline||null;tier=1;catalogMenu();},update(dt){menu.update(dt);if(\"'!discipline&&G.mode!=='\"'story'){G.idle+=dt;if(G.idle>=10)G.startAttract();}},draw(r){G.paper(r);G.header(r,G.mode==='story'?'Find your next mat':'Free Play',discipline||'A little of everything');if(\"'!discipline){r.overlay(g=>{G.flower(g,r.W-58,110);G.text(g,'\"'Gently,',r.W-61,145,{align:'center',color:P.muted});G.text(g,'or not at all.',r.W-61,158,{align:'center',color:P.muted});});}menu.draw(r);}};\n})();\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"cat > game/scenes/finale.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,game=G.game,P=G.palette;\nlet menu,rig,clock,phase;\nG.festivalIndex=0;\nG.scenes.games={view:'brawler',camera:{zoom:false},pausable:true,enter(){G.festival=true;G.light();G.music('festival');G.festivalIndex=0;rig=G.regularRig(0,2);menu=new G.Pills([['The Gentle Games',()=>G.startSession('stork',1,'festival',{duration:30,fixedDuration:true})],['A little more practice',()=>G.go('island')]],{y:()=>game.H-70,w:238,h:25,gap:7});},update(dt){menu.update(dt);G.poseRig(rig,'stork',G.time,{dt,x:37,y:0});},draw(r){G.studio(r,'pier');G.drawRig(r,rig,37,0);G.header(r,'Day 5 · Bunting provided','The Gentle Games');r.overlay(g=>{G.paragraph(g,'Stork. Step. Slalom. Then, one quiet candle with Gertrude.',14,62,195);G.text(g,'A festival of small achievements.',14,100,{color:P.muted});});menu.draw(r);}};\nG.festivalDone=ctx=>{const order=['stork','step','slalom','candle'];if(ctx.duel){G.member.duelWin=(ctx.contestants[0].data.flame>.5&&(ctx.contestants[0].data.opponent||0)<.5);G.member.spineAge=G.calculateAge();G.persist();G.go('ending');return;}G.festivalIndex++;const id=order[G.festivalIndex];G.startSession(id,1,'festival',{duration:id==='candle'?90:30,duel:id==='candle',fixedDuration:true});};\nG.scenes.ending={view:'brawler',camera:{zoom:false},pausable:true,enter(){G.festival=false;G.mode='story';G.light(true);G.music('ending');G.member.ended=true;G.refreshAge();if(G.member.spineAge<=24)G.member.avatar.hat=3;G.persist();rig=G.playerRig(1.8);const extra=G.member.spineAge<=24?G.lines.finishAge[2]:G.member.spineAge<=45?G.lines.finishAge[0]:G.lines.finishAge[1];G.speech([...G.lines.ending,extra],{done:()=>G.go('credits')});},update(dt){G.poseRig(rig,'idle',G.time,{dt,x:20,y:0});G.talk.update(dt);},draw(r){G.studio(r,'deck',{dusk:true});G.drawRig(r,rig,20,0);G.tare(r,-21,6,1.5,'happy');G.header(r,'Five days later','Thank you for coming');G.talk.draw(r);}};\nG.scenes.credits={view:'brawler',camera:{zoom:false},enter(){G.context=null;G.music('ending');clock=0;phase=0;menu=new G.Pills([['Continue on Lumbar Island',()=>{G.member.day=6;G.member.sessions=0;G.member.checked=true;G.mode='free';G.persist();G.go('island');}],['Free Play',()=>{G.mode='free';G.go('catalog');}],['About / Credits',()=>G.go('about')]],{y:()=>game.H-92,w:250,h:23,gap:7});},update(dt){clock+=dt;menu.update(dt);},draw(r){G.paper(r);G.header(r,'A stay at the Institute','You were here');r.overlay(g=>{G.drawGerald(g,r.W/2-55,102,1.25);G.drawTare(g,r.W/2+40,106,1.7,'happy');G.text(g,'Your Spine Age is '+G.member.spineAge+'.',r.W/2,59,{align:'center',color:P.cyan});G.text(g,'The island will keep your place.',r.W/2,125,{align:'center',color:P.muted});});menu.draw(r);}};\n})();\nEOF\ncat > game/scenes/class.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,game=G.game,P=G.palette;\nlet menu,selected='stork',rounds=1,roster=[],podium,round=0;\nG.classLobbyState={selected:'stork',rounds:1};\nconst capable=['stork','candle','squat','step','hoop'];\nfunction makeMenu(){menu=new G.Pills([{label:'Activity',value:()=>selected==='surprise'?'Surprise me':G.activities[selected].name,fn:()=>{const ids=[...capable,'surprise'];selected=ids[(ids.indexOf(selected)+1)%ids.length];G.classLobbyState.selected=selected;makeMenu();}},{label:'Add keyboard player',disabled:game.players.length>=2,fn:()=>{game.addPlayer({keys:'right'});makeMenu();}},{label:'Add a practice partner',disabled:roster.length>=4,fn:()=>{roster.push({bot:'average',name:G.regulars[roster.length%7][0]});makeMenu();}},['Begin class',()=>beginClass()],['Back',()=>{game.allowJoin(false);while(game.players.length>1)game.removePlayer(game.players.at(-1));G.go('title');}]],{x:14,y:81,w:253,h:25,gap:7,back:()=>G.go('title')});}\nG.scenes.classLobby={view:'brawler',camera:{zoom:false},input:G.CLASS_INPUT,pausable:true,enter(){G.context=null;G.light();G.music('studio');roster=[];selected=G.classLobbyState.selected;game.allowJoin({max:4,onJoin(){makeMenu();}});makeMenu();},exit(){game.allowJoin(false);},update(dt){menu.update(dt);G.idle+=dt;if(G.idle>=10)G.startAttract();},draw(r){G.studio(r,'pier');G.header(r,'2 to 4 · One screen','A class together');r.overlay(g=>{G.text(g,'Press Start on a pad, or 2 on the keyboard.',14,59,{color:P.muted});G.text(g,game.players.length+' joined · '+roster.length+' practice partners',14,r.H-12,{color:P.muted});});menu.draw(r);}};\nfunction beginClass(){G.classScores={};G.classRoster=game.players.map((input,i)=>({input,local:true,name:'Member '+(i+1),color:E.PLAYER_COLORS[i],rig:G.regularRig(i+2,1.45)}));for(const r of roster)if(G.classRoster.length<4)G.classRoster.push({...r,color:E.PLAYER_COLORS[G.classRoster.length],local:false,rig:G.regularRig(G.classRoster.length,1.45)});\n if(G.classRoster.length<2)G.classRoster.push({name:'Gertrude',bot:'good',color:E.PLAYER_COLORS[1],local:false,rig:G.regularRig(0,1.45)});\n G.classOrder=selected==='surprise'?['stork','step','hoop']:[selected];round=0;G.classRound();}\nG.classRound=()=>{const id=G.classOrder[round];G.startSession(id,1,'class',{duration:35,contestants:G.classRoster,fixedDuration:true});};\nG.classDone=ctx=>{for(const c of ctx.contestants)G.classScores[c.name]=(G.classScores[c.name]||0)+c.score;round++;if(round<G.classOrder.length){G.classRound();return;}G.go('podium');};\nG.scenes.podium={view:'brawler',camera:{zoom:false},input:G.CLASS_INPUT,pausable:true,enter(){G.light();G.jingle(3);podium=G.classRoster.map(c=>({...c,total:G.classScores[c.name]})).sort((a,b)=>b.total-a.total);menu=new G.Pills([['Another class',()=>G.go('classLobby')],['Done',()=>{while(game.players.length>1)game.removePlayer(game.players.at(-1));G.go('title');}]],{y:()=>game.H-63,w:200,h:23,gap:7});},update(dt){menu.update(dt);podium.forEach((c,i)=>G.poseRig(c.rig,'idle',G.time,{dt,clip:i===0?'Cheering_Two_Hands':'Victory',x:(i-(podium.length-1)/2)*53,y:0}));},draw(r){G.studio(r,'pier');G.header(r,'Class complete','Everyone stood for something');podium.forEach((c,i)=>{const x=(i-(podium.length-1)/2)*53;G.drawRig(r,c.rig,x,0);const p=r.w(x,0,45);r.overlay(g=>{G.tag(g,String(i+1),p[0]-10,52,c.color);G.text(g,c.name,p[0],143,{align:'center',color:c.color});G.text(g,c.total+' pts',p[0],155,{align:'center'});G.text(g,i===0?'Most Still':i===1?'Best Wobble':'Participated',p[0],165,{align:'center',color:P.muted});});});menu.draw(r);}};\n})();\nEOF\ncat > game/scenes/attract.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,game=G.game,P=G.palette;\nG.ATTRACT=['island','bodycheck','stork','flow','candle','squat','pushup','lunge','step','hoop','jog','slalom','tray','laundry','class','results','duel'];\nlet index=0,clock=0,attractIsland,gertrude;\nG.startAttract=()=>{if(G.inSession)return;G.attracting=true;G.go('attract');};\nG.attractLoad=i=>{index=i%G.ATTRACT.length;clock=0;G.attractItem=G.ATTRACT[index];const key=G.attractItem;G.context=null;G.sessionPhase='play';G.light();\n if(key==='island'){if(\"'!attractIsland)attractIsland=G.makeIsland();game.setView('\"'threequarter');game.cam.bounds=v=>attractIsland.map.bounds(v);G.music('island');return;}\n game.setView('brawler');game.cam.bounds=null;game.cam.smooth=0;game.focus(0,0,20);\n const id=key==='bodycheck'?'stork':key==='duel'?'candle':key==='results'?'squat':key==='class'?'stork':key;\n G.context=G.makeContext(id,1,{cheat:true,duel:key==='duel',duration:key==='duel'?90:G.activities[id].duration,fixedDuration:true,contestants:key==='class'?Array.from({length:4},(_,i)=>({name:G.regulars[i][0],bot:'expert',rig:G.regularRig(i,1.45),color:E.PLAYER_COLORS[i]})):[{name:'Gertrude',bot:'expert',rig:G.regularRig(0,1.9),color:P.coral}]});\n if(key==='duel'){G.context.duel=true;G.duelRig=G.regularRig(0,1.8);}\n G.music(({flow:'yoga',candle:'raft',step:'step',hoop:'step',jog:'jog',slalom:'ski',tray:'tray',laundry:'laundry'})[id]||'studio');\n};\nG.scenes.attract={view:'brawler',camera:{zoom:false},enter(){G.attracting=true;G.mode='attract';G.attractLoad(0);},update(dt){clock+=dt;if(clock>=15){G.attractLoad(index+1);return;}\n if(G.attractItem==='island'){G.islandUpdate(attractIsland,dt,true);return;}const ctx=G.context;if(ctx&&\"'!ctx.done){for(let i=0;i<4;i++)G.stepContext(ctx,dt,'\"'expert');if(ctx.duel)G.poseRig(G.duelRig,'meditate',ctx.time,{dt,x:47,y:4});}game.focus(0,0,20);},\n draw(r){if(G.attractItem==='island')G.drawIsland(r,attractIsland,true);else if(G.attractItem==='results'){G.studio(r,'deck');r.overlay(g=>{G.text(g,'★ ★ ★',r.W/2,80,{align:'center',scale:4,color:'#dfb456'});G.drawGerald(g,r.W/2,154,2);G.text(g,'Gerald has swallowed your minutes.',r.W/2,186,{align:'center'});});}\n else {const ctx=G.context,a=ctx.a,f=G.families[a.family];if(f.fullDraw)f.fullDraw(r,ctx);else{G.studio(r,ctx.duel?'raft':a.room);for(const c of ctx.contestants){G.mat(r,c.worldX||0,c.worldY||0,c.color);G.drawRig(r,c.rig,c.worldX||0,c.worldY||0);}a.draw(r,ctx);if(ctx.duel)G.drawRig(r,G.duelRig,47,4);G.tare(r,-82,14,1.2);r.overlay(g=>{ctx.contestants.forEach((c,i)=>G.drawPlate(g,r.W/2+(i-(ctx.contestants.length-1)/2)*70,r.H-33,c.bal,ctx.contestants.length>1?18:26));});}a.hud(r,ctx);}\n r.overlay(g=>{G.round(g,10,9,Math.min(265,r.W-65),30,'#ffffff');G.text(g,'Wee Serene  /  DEMO',18,15,{color:P.cyan});G.text(g,G.attractItem==='island'?'A little walk on Lumbar Island':G.attractItem==='duel'?'The Grand Stillness':G.attractItem==='bodycheck'?'The morning Body Check':G.attractItem==='class'?'A class together':G.attractItem==='results'?'A place for your minutes':G.context.a.name,18,27);const s='Press any button';G.round(g,r.W-114,r.H-24,104,15,'#ffffff');G.text(g,s,r.W-107,r.H-20,{color:P.cyan});if(clock<5&&index===0)G.paragraph(g,G.lines.attract[0],14,r.H-57,260,{color:P.ink});});}\n};\n})();\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
