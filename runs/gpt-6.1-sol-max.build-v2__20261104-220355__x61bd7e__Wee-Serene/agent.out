day))return;\", \"if(!G.validMember(m))return;\")\np.write_text(s)\np=Path('\"'game/activities/candle.js');s=p.read_text().replace(\\\"c.data={flame:1\\\", \\\"if(ctx.duel&&\"'!ctx.crowd)ctx.crowd=Array.from({length:4},(_,i)=>G.regularRig(i+1,1));c.data={flame:1\")\ns=s.replace(\"if(ctx.duel)d.opponent=t<75\", \"if(ctx.duel){if(ctx.crowd)ctx.crowd.forEach((rig,i)=>G.poseRig(rig,'\"'idle',t,{dt,x:-70+i*25+Math.sin(t*.3)*15,y:-25,clip:'Walk_Loop'}));if(t>60&&G.context===ctx&&Math.floor(t*3)>Math.floor((t-dt)*3))G.babble('Tare','laloubou'[Math.floor(t*3)%8]);if(t>45&&t<60&&G.context===ctx&&Math.floor(t/3)>Math.floor((t-dt)/3)&&\"'!G.game.settings.reduceMotion)G.game.particles.glints((Math.floor(t/3)%2?1:-1)*65,-20,65,12,'\"'#f4d395');}\\\\n  if(ctx.duel)d.opponent=t<75\\\")\ns=s.replace(\\\"draw(r,ctx){for(const c\\\", \\\"draw(r,ctx){if(ctx.duel&&ctx.time>30&&ctx.time<45)ctx.crowd?.forEach((rig,i)=>G.drawRig(r,rig,-70+i*25+Math.sin(ctx.time*.3)*15,-25));for(const c\\\")\ns=s.replace(\\\"if(ctx.duel)G.candle(r,64\\\", \\\"if(ctx.tier===2||ctx.duel){const t=ctx.time;r.queue(75,-8,0,g=>{const p=r.w(75,-8,0);if(ctx.duel&&t>15&&t<30||ctx.tier===2&&Math.floor(t/7)%2===0){px.rect(g,p[0]-7,p[1]-10,14,10,'#b2c6bf');px.poly(g,[[p[0]-6,p[1]-27],[p[0]+6,p[1]-27],[p[0]+4,p[1]-10],[p[0]-4,p[1]-10]],'#dff0e9');px.line(g,p[0]-2,p[1]-12,p[0]+3*Math.sin(t*40),p[1]-22,'#9db288',2);}else if(t>70||ctx.tier===2){px.ell(g,p[0],p[1]-6,8,5,'#f6faf4');px.line(g,p[0]+5,p[1]-6,p[0]+9,p[1]-17,'#f6faf4',3);px.disc(g,p[0]+10,p[1]-18,4,'#f6faf4');px.line(g,p[0]+13,p[1]-18,p[0]+18,p[1]-16,'#ddaa65',2);}});}\\\\n if(ctx.duel)G.candle(r,64\\\")\np.write_text(s)\nPY\ncat >> tests/issues.md <<'EOF'\n10. Presentation: Early WebKit matrix screenshots still showed the warming-up splash after the game had entered its first scene. The screenshot test now waits for the splash to clear before stopping the loop.\nEOF\nnode tests/run.mjs all\"","aggregated_output":"FAIL browser: page.waitForFunction: Timeout 3000