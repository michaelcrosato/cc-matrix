{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc \"rg -n 'textAt\\\\(|this\\\\.keys|keys =|this\\\\._keys' engine/my-3d2dge.js | head -25 && sed -n '740,805p' engine/my-3d2dge.js && sed -n '4010,4032p' engine/my-3d2dge.js && sed -n '2713,2738p' engine/my-3d2dge.js\"","aggregated_output":"784:    this.pad = 'any'; this.keysTo = null; this._claimed = null;\n822:      const share = this.keysTo && this.keysTo.filter(q => q._codes[e.code]);   // (players sharing the keyboard: each answers to its half)\n835:    const all = f => { f(this); if (this.keysTo) for (const q of this.keysTo) f(q); };\n936:    const real = m.filter(c => !c.startsWith('Act:') && !c.startsWith('PadAxis')), pads = real.filter(padCode), keys = real.filter(c => !padCode(c));\n1947:  /** text floating at a world point (names, prompts): r.textAt(x, y, z, 'OPEN', '#ffe08a') */\n1948:  textAt(x, y, z, str, color = '#ffffff', o = {}) { this.overlay(g => { const [sx, sy] = this.w(x, y, z); E.font.text(g, str, sx, sy, color, Object.assign({ align: 'center' }, o)); }); }\n3130:    const s = this._specs[key]; if (!s) { warn('setting:' + key, 'unknown setting \"' + key + '\". Settings: ' + this.keys().join(', ')); return undefined; }\n3138:    for (const k of this.keys(group)) { if (k === 'fullscreen') continue; delete this._saved[k]; this[k] = this.default(k); this._apply(k); if (this.onChange) this.onChange(k, this[k]); }\n9637:      const keys = S.keys(g).filter(k => (k !== 'scale' || this._game.screen._fixedRes()) && (k !== 'fullscreen' || this._game.o.fullscreen !== false) && (k !== 'zoom' || !this._game._zoomStd() || this._game._zooms()) && S.spec(k).type !== 'value');\n  /** browser client coords -> projected screen pixels (same space as view.p) */\n  clientToScreen(cx, cy) {\n    if (!this.canvas) return null;\n    const rc = this.canvas.getBoundingClientRect(), dx = (cx - rc.left) * this.dpr, dy = (cy - rc.top) * this.dpr;\n    return [(dx - this.OX + Math.round(this.fx * this.S)) / this.S + this.ix, (dy - this.OY + Math.round(this.fy * this.S)) / this.S + this.iy];\n  }\n}\n\n/* =============================================================================\n * 5. INPUT  keyboard, mouse, gamepad, touch stick, on-screen buttons\n *    Actions are names you choose. Codes: KeyboardEvent.code, 'Mouse0'/'Mouse2',\n *    'Pad0'..'Pad15' (standard gamepad buttons). Every action also accepts\n *    'Act:<name>' so DOM buttons with data-act=\"<name>\" work automatically.\n * ============================================================================= */\nclass Input {\n  /** signal: an AbortSignal that removes every listener this adds (game.dispose()). A screen without a canvas (headless)\n   *  gets no DOM listeners: input comes from press(code), release(code), tap(action) and hold(action, on) */\n  constructor(screen, map, signal) {\n    this.screen = screen; this._signal = signal;   // screen: the game's screen (mouse positions are read through it)\n    this.use(map);\n    /** held: the key and button codes down right now ('KeyD', 'Mouse0', 'Pad0', 'Act:jump'); clock: seconds of input\n     *  time (the steps' dt added up) */\n    this.held = new Set(); this.clock = 0; this._pt = {}; this._used = {};\n    this._fresh = new Set(); this._now = new Set(); this._freshUp = new Set(); this._nowUp = new Set(); this._rk = {}; this._freshCodes = new Set();\n    this._suppressed = new Set();\n    /** mouse: { cx, cy } its page position, active once it has moved over the canvas, t the input clock when it last\n     *  moved */\n    this.mouse = { cx: 0, cy: 0, active: false, t: -99 };\n    /** clickAt: where a click or tap on the canvas landed, in screen pixels [x, y], for the one step after it (clicked()) */\n    this._clickAt = null; this._click = null; this._down = null;\n    /** stick: the touch stick's direction [x, y], length <= 1; stickOn: a finger is on it; padMove: the gamepad's\n     *  left stick after the dead zone; padAim: its right stick, or null when centered; padPrev: which gamepad buttons\n     *  were down at the last step; aimSource: what aims right now: 'move' | 'mouse' | 'pad' */\n    this.stick = [0, 0]; this.stickOn = false; this.padMove = [0, 0]; this.padAim = null; this.padPrev = []; this.aimSource = 'move';\n    /** padValues: each gamepad button's travel, 0 to 1 (the triggers; input.value reads them); invertMoveX, invertMoveY:\n     *  the move stick turned round (the Controller settings) */\n    this.padValues = []; this.invertMoveX = this.invertMoveY = false;\n    /** deadzone: how far a gamepad stick moves before it counts (0..0.8); padIndex, padId: the gamepad in use (null\n     *  and '' without one); lastDevice: 'keyboard' | 'mouse' | 'gamepad' | 'touch', the last one used (show the\n     *  right button prompts) */\n    this.deadzone = .18; this.padIndex = null; this.padId = ''; this.lastDevice = 'keyboard';\n    /** pad: the gamepad this input reads: 'any' (the first connected one another player hasn't: player 1's), an index (a\n     *  joined player's own), or null (none); keysTo: the other players' inputs the keyboard's codes go to as well (players\n     *  sharing it, each with half its keys: game.players) */\n    this.pad = 'any'; this.keysTo = null; this._claimed = null;\n    /** touchEnabled: false turns the touch stick off; stickSide: 'left' or 'right', the half of the screen the stick\n     *  lives on; stickRadius: how far (CSS pixels) a finger drags for full tilt; stickDeadzone: the part of that radius a\n     *  thumb moves before the stick counts (0..0.5); steer: 'stick' (a stick drawn under the thumb) or 'drag' (a finger\n     *  anywhere on the screen but the buttons steers by drag(), with no stick drawn: a shooter's ship that follows the\n     *  thumb); padAxes: the gamepad's raw axes */\n    this.touchEnabled = true; this.stickSide = 'left'; this.steer = 'stick'; this.stickRadius = 44; this.stickDeadzone = .12; this.padAxes = []; this._taps = new Set(); this._tapsDue = new Set(); this._holds = new Set();\n    /** zones: areas of the screen a finger holds an action down in, [{ x0, y0, x1, y1, act }] (fractions of the canvas,\n     *  0..1; the first that holds the finger wins), or null: a pinball's two halves, a rhythm game's lanes. A finger\n     *  landing in one presses act until it lifts (several fingers, several zones), and starts no stick */\n    this.zones = null; this._zoneOf = new Map();\n    /** pinching: two fingers on the canvas are pinching the camera's zoom (they moved apart or together: not the stick,\n     *  not a tap). The game lets the player zoom only where its scene does (camera.zoom): then the wheel, - and = (keys no\n     *  action uses) and a pinch ask for it, read by zoom() */\n    this._pinching = false; this._zoomAcc = 1; this._zoomNow = 1; this._zoomOn = false; this._wheelOn = false; this._fingers = new Map();\n    // the pointer's gestures (box, longPress, doubleTap, pan): the press followed (_g), what this step reads, what the next will\n    this._g = null; this._gBox = null; this._gLong = null; this._gTap2 = null; this._gPan = null; this._lastTap = null; this._zoomPt = null; this._fedAt = null;\n    this._boxAt = null; this._longAt = null; this._tap2At = null; this._panAt = null;\n    /** glyphs: the gamepad's button symbols for label(): 'auto' (from the controller's name) | 'xbox' | 'playstation' |\n     *  'nintendo' | 'generic' (positions); rumbleScale: vibration strength 0..1 (0 = off; game.settings.rumble sets it);\n     *  padLost: true for the step after the gamepad in use was unplugged (a pausable scene pauses) */\n    this.glyphs = 'auto'; this.rumbleScale = .6; this.padLost = false;\nGame.prototype.hook = function (kind, fn) {\n  const L = (this._own || (this._own = { input: [], step: [], enter: [] }))[kind];\n  if (!L) throw new Error('game.hook(\"' + kind + '\"): the hooks are input, step and enter');\n  L.push(fn); return () => { const i = L.indexOf(fn); if (i >= 0) L.splice(i, 1); };\n};\n/** touch: 'never' on a device with touch alone: \"Controller or keyboard required\", with Settings, until a controller\n *  is connected or a key pressed */\nGame.prototype._needSync = function () {\n  const fine = window.matchMedia && matchMedia('(any-pointer: fine)').matches, coarse = window.matchMedia && matchMedia('(pointer: coarse)').matches;\n  const need = coarse && !fine && !this._keyed && this.input.padIndex === null, el = this._needEl;\n  if (!need) { if (el) el.style.display = 'none'; return; }\n  if (!el) {\n    const d = this._needEl = document.createElement('div'); d.setAttribute('data-sys', 'need'); d.setAttribute('role', 'alert');\n    d.style.cssText = 'position:absolute;inset:0;z-index:20;display:flex;align-items:center;justify-content:center;padding:24px;text-align:center;background:rgba(5,3,12,.88);color:#f4f0ff;font:600 17px/1.45 system-ui,sans-serif';\n    d.innerHTML = '<div><div style=\"font-size:21px;margin-bottom:8px\">Controller or keyboard required</div><div style=\"opacity:.8;margin-bottom:18px\">This game plays with a controller or a keyboard. Connect one, then press any button.</div><button type=\"button\" style=\"font:inherit;padding:10px 22px;border-radius:10px;border:2px solid #b8a8ff;background:#2a2050;color:#fff;min-width:44px;min-height:44px\">Settings</button></div>';\n    d.querySelector('button').onclick = () => this.menu('settings');\n    (this.screen.canvas.parentElement || document.body).appendChild(d);\n  }\n  this._needEl.style.display = this.shell && this.shell.screen ? 'none' : 'flex';   // (Settings open over it: hidden while it is)\n};\n/* =============================================================================\n * 11. HUMANOID RIG\n *    Local frame: f = forward, r = right, z = up. The rig poses itself every step\n   * by advance().\n   * - view, views, input, res, expand, touch: a scene's, applied when it starts: input ('PLATFORMER'), res ('snes'),\n   *   expand (true), touch (['jump', 'attack']); res and expand stay until another scene sets them\n   * - back: a scene's back() takes a phone's back gesture (game.back()) first: return true when it went back somewhere (a\n   *   sub-menu closed)\n   * - camera: a scene's { zoom: [.75, 2], start: 1, tall: 1.5, wheel: true }: the player zooms the camera within zoom (the\n   *   wheel, - and =, a pinch, Settings, Camera zoom: theirs, kept, on top of the game's; false or none: they can't; a\n   *   function of the game: a range per screen shape, g => [g.upright ? 1 : .85, 2]), from start, the zoom it starts at\n   *   (tall: on a screen held upright, game.upright; 1 without); wheel: false leaves the mouse wheel to the game\n   * - boot: { title, version, steps: [[label, fn]], messages, min, checks, accent } runs the boot first (section 10c): the\n   *   steps one a frame behind the boot screen (all at once when headless or loop: false); boot: false hides a splash\n   */\n  start(hooks) {\n    if (hooks && hooks.boot !== undefined && !this._booting) return this._boot(hooks);\n    if (hooks !== undefined || !this._hooks) {\n      if (!hooks || typeof hooks !== 'object') throw new Error('game.start needs { update(dt), draw(r) } or { scenes: { name: { update, draw } }, scene: \"name\" }');\n      this._hooks = hooks;\n      if (hooks.scenes) {\n        this.scenes = hooks.scenes;\n        const first = hooks.scene || Object.keys(hooks.scenes)[0];\n        this._enter(first, hooks.data);\n      } else {\n        if (typeof hooks.update !== 'function' || typeof hooks.draw !== 'function') throw new Error('game.start({ update(dt), draw(r) }) needs both functions (or use { scenes, scene })');\n        this.scene = hooks; this.sceneName = 'main';\n      }\n    }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('game/core.js');s=p.read_text().replace(\\\"G.sceneName=name;G.visited.add(name);G.dev.open=false;\\\",\\\"G.sceneName=name;G.visited.add(name);G.dev.open=false;G.talk?.close();\\\");p.write_text(s)\np=Path('game/balance.js');s=p.read_text().replace(\\\"I.keys?.has?.('KeyD')\\\",\\\"I.held.has('KeyD')\\\").replace(\\\"I.keys?.has?.('KeyA')\\\",\\\"I.held.has('KeyA')\\\").replace(\\\"I.keys?.has?.('KeyS')\\\",\\\"I.held.has('KeyS')\\\").replace(\\\"I.keys?.has?.('KeyW')\\\",\\\"I.held.has('KeyW')\\\");p.write_text(s)\np=Path('game/scenes/island.js');s=p.read_text().replace(\\\"row+=d>1?'~':y>20?'.':x<11&&y<8?'\"'^'\"':',';\\\",\\\"row+=d>1?'~':y>20?'.':x<11&&y<8?'\"'^'\"':((Math.abs(y-13)<1.5&&x>7&&x<39)||(Math.abs(x-21)<1.5&&y>7))?'.':',';\\\")\ns=s.replace(\\\"P.ink,{align:'center'}\\\",\\\"P.ink,{align:'center',outline:false,shadow:null}\\\").replace(\\\"'★','#fff5c3');\\\",\\\"'★','#fff5c3',{outline:false,shadow:null});\\\").replace(\\\"'Day '+a.day,'#667d7a');\\\",\\\"'Day '+a.day,'#667d7a',{outline:false,shadow:null});\\\").replace(\\\"a.name,P.ink);\\\",\\\"a.name,P.ink,{outline:false,shadow:null});\\\")\np.write_text(s)\nPY\ncat > tests/story-diagnostic.mjs <<'EOF'\nimport {load} from './load.mjs';\nconst {G,game,logs}=load({main:true});const original=G.animateContestant;G.animateContestant=()=>{};game.o.draw=false;\nconst step=t=>game.advance(t,{draw:false});const tap=a=>{game.input.tap(a);step(.15);};const scene=()=>game.sceneName;const log=msg=>console.log(msg,scene(),G.sessionPhase,G.member.day,G.member.sessions);\nfunction dialogues(target,max=80){for(let i=0;i<max&&scene()\"'!==target;i++){tap('\"'confirm');}if(scene()\"'!==target)throw new Error('\"'dialogues wanted '+target+' got '+scene());}\nstep(.2);tap('confirm');tap('confirm');for(let i=0;i<3;i++)tap('down');tap('confirm');log('arrive');dialogues('instructor');tap('confirm');dialogues('bungalow');log('home');G.dev.bot='expert';tap('confirm');log('bodycheck');dialogues('bodycheck',1);for(let i=0;i<800&&scene()==='bodycheck';i++){tap('confirm');}log('guided card');\nfunction play(id){if(scene()\"'!=='\"'card'){G.startSession(id,1,G.member.day===5?'festival':'story');step(.1);}tap('confirm');for(let i=0;i<1000&&scene()\"'!=='\"'results';i++)step(.15);if(scene()\"'!=='\"'results')throw new Error('no result '+id+' '+scene()+' '+JSON.stringify(game.errors));tap('confirm');step(.1);}\nplay('stork');log('stork done');play('squat');play('tray');log('day1done');\nfor(const [day,acts]of [[2,['flow','pushup','hoop']],[3,['candle','lunge','jog']],[4,['step','slalom','laundry']]]){tap('confirm');log('newday');tap('confirm');for(let i=0;i<500&&scene()==='bodycheck';i++)tap('confirm');if(scene()==='tareDay'){tap('confirm');dialogues('island');}for(const id of acts)play(id);log('daydone '+day);}\ntap('confirm');tap('confirm');for(let i=0;i<500&&scene()==='bodycheck';i++)tap('confirm');log('games');tap('confirm');for(let i=0;i<4;i++){play(['stork','step','slalom','candle'][i]);log('festival');}dialogues('credits');console.log('end',G.member.spineAge,G.member.ended,Object.keys(G.member.best),game.errors,logs.slice(-10));game.dispose();\nEOF\nnode build.mjs\nnode tests/story-diagnostic.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
