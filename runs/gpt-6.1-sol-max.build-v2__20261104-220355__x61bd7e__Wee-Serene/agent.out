selected=G.classLobbyState.selected;game.allowJoin({max:4,onJoin(){makeMenu();}});makeMenu();},exit(){game.allowJoin(false);},update(dt){menu.update(dt);G.idle+=dt;if(G.idle>=10)G.startAttract();},draw(r){G.studio(r,'pier');G.header(r,'2 to 4 · One screen','A class together');r.overlay(g=>{G.text(g,'Press Start on a pad, or 2 on the keyboard.',14,59,{color:P.muted});G.text(g,game.players.length+' joined · '+roster.length+' practice partners',14,r.H-12,{color:P.muted});});menu.draw(r);}};\nfunction beginClass(){G.classScores={};G.classRoster=game.players.map((input,i)=>({input,local:true,name:'Member '+(i+1),color:E.PLAYER_COLORS[i],rig:G.regularRig(i+2,1.45)}));for(const r of roster)if(G.classRoster.length<4)G.classRoster.push({...r,color:E.PLAYER_COLORS[G.classRoster.length],local:false,rig:G.regularRig(G.classRoster.length,1.45)});\n if(G.classRoster.length<2)G.classRoster.push({name:'Gertrude',bot:'good',color:E.PLAYER_COLORS[1],local:false,rig:G.regularRig(0,1.45)});\n G.classOrder=selected==='surprise'?['stork','step','hoop']:[selected];round=0;G.classRound();}\nG.classRound=()=>{const id=G.classOrder[round];G.startSession(id,1,'class',{duration:35,contestants:G.classRoster,fixedDuration:true});};\nG.classDone=ctx=>{for(const c of ctx.contestants)G.classScores[c.name]=(G.classScores[c.name]||0)+c.score;round++;if(round<G.classOrder.length){G.classRound();return;}G.go('podium');};\nG.scenes.podium={view:'brawler',camera:{zoom:false},input:G.CLASS_INPUT,pausable:true,enter(){G.light();G.jingle(3);podium=G.classRoster.map(c=>({...c,total:G.classScores[c.name]})).sort((a,b)=>b.total-a.total);menu=new G.Pills([['Another class',()=>G.go('classLobby')],['Done',()=>{while(game.players.length>1)game.removePlayer(game.players.at(-1));G.go('title');}]],{y:()=>game.H-63,w:200,h:23,gap:7});},update(dt){menu.update(dt);podium.forEach((c,i)=>G.poseRig(c.rig,'idle',G.time,{dt,clip:i===0?'Cheering_Two_Hands':'Victory',x:(i-(podium.length-1)/2)*53,y:0}));},draw(r){G.studio(r,'pier');G.header(r,'Class complete','Everyone stood for something');podium.forEach((c,i)=>{const x=(i-(podium.length-1)/2)*53;G.drawRig(r,c.rig,x,0);const p=r.w(x,0,45);r.overlay(g=>{G.tag(g,String(i+1),p[0]-10,52,c.color);G.text(g,c.name,p[0],143,{align:'center',color:c.color});G.text(g,c.total+' pts',p[0],155,{align:'center'});G.text(g,i===0?'Most Still':i===1?'Best Wobble':'Participated',p[0],165,{align:'center',color:P.muted});});});menu.draw(r);}};\n})();\nEOF\ncat > game/scenes/attract.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,game=G.game,P=G.palette;\nG.ATTRACT=['island','bodycheck','stork','flow','candle','squat','pushup','lunge','step','hoop','jog','slalom','tray','laundry','class','results','duel'];\nlet index=0,clock=0,attractIsland,gertrude;\nG.startAttract=()=>{if(G.inSession)return;G.attracting=true;G.go('attract');};\nG.attractLoad=i=>{index=i%G.ATTRACT.length;clock=0;G.attractItem=G.ATTRACT[index];const key=G.attractItem;G.context=null;G.sessionPhase='play';G.light();\n if(key==='island'){if(\"'!attractIsland)attractIsland=G.makeIsland();game.setView('\"'threequarter');game.cam.bounds=v=>attractIsland.map.bounds(v);G.music('island');return;}\n game.setView('brawler');game.cam.bounds=null;game.cam.smooth=0;game.focus(0,0,20);\n const id=key==='bodycheck'?'stork':key==='duel'?'candle':key==='results'?'squat':key==='class'?'stork':key;\n G.context=G.makeContext(id,1,{cheat:true,duel:key==='duel',duration:key==='duel'?90:G.activities[id].duration,fixedDuration:true,contestants:key==='class'?Array.from({length:4},(_,i)=>({name:G.regulars[i][0],bot:'expert',rig:G.regularRig(i,1.45),color:E.PLAYER_COLORS[i]})):[{name:'Gertrude',bot:'expert',rig:G.regularRig(0,1.9),color:P.coral}]});\n if(key==='duel'){G.context.duel=true;G.duelRig=G.regularRig(0,1.8);}\n G.music(({flow:'yoga',candle:'raft',step:'step',hoop:'step',jog:'jog',slalom:'ski',tray:'tray',laundry:'laundry'})[id]||'studio');\n};\nG.scenes.attract={view:'brawler',camera:{zoom:false},enter(){G.attracting=true;G.mode='attract';G.attractLoad(0);},update(dt){clock+=dt;if(clock>=15){G.attractLoad(index+1);return;}\n if(G.attractItem==='island'){G.islandUpdate(attractIsland,dt,true);return;}const ctx=G.context;if(ctx&&\"'!ctx.done){for(let i=0;i<4;i++)G.stepContext(ctx,dt,'\"'expert');if(ctx.duel)G.poseRig(G.duelRig,'meditate',ctx.time,{dt,x:47,y:4});}game.focus(0,0,20);},\n draw(r){if(G.attractItem==='island')G.drawIsland(r,attractIsland,true);else if(G.attractItem==='results'){G.studio(r,'deck');r.overlay(g=>{G.text(g,'★ ★ ★',r.W/2,80,{align:'center',scale:4,color:'#dfb456'});G.drawGerald(g,r.W/2,154,2);G.text(g,'Gerald has swallowed your minutes.',r.W/2,186,{align:'center'});});}\n else {const ctx=G.context,a=ctx.a,f=G.families[a.family];if(f.fullDraw)f.fullDraw(r,ctx);else{G.studio(r,ctx.duel?'raft':a.room);for(const c of ctx.contestants){G.mat(r,c.worldX||0,c.worldY||0,c.color);G.drawRig(r,c.rig,c.worldX||0,c.worldY||0);}a.draw(r,ctx);if(ctx.duel)G.drawRig(r,G.duelRig,47,4);G.tare(r,-82,14,1.2);r.overlay(g=>{ctx.contestants.forEach((c,i)=>G.drawPlate(g,r.W/2+(i-(ctx.contestants.length-1)/2)*70,r.H-33,c.bal,ctx.contestants.length>1?18:26));});}a.hud(r,ctx);}\n r.overlay(g=>{G.round(g,10,9,Math.min(265,r.W-65),30,'#ffffff');G.text(g,'Wee Serene  /  DEMO',18,15,{color:P.cyan});G.text(g,G.attractItem==='island'?'A little walk on Lumbar Island':G.attractItem==='duel'?'The Grand Stillness':G.attractItem==='bodycheck'?'The morning Body Check':G.attractItem==='class'?'A class together':G.attractItem==='results'?'A place for your minutes':G.context.a.name,18,27);const s='Press any button';G.round(g,r.W-114,r.H-24,104,15,'#ffffff');G.text(g,s,r.W-107,r.H-20,{color:P.cyan});if(clock<5&&index===0)G.paragraph(g,G.lines.attract[0],14,r.H-57,260,{color:P.ink});});}\n};\n})();\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"rg -n '\"'^.*(setInput|input'\"\\\\.set|preset\\\\(|addPlayer|halfKeys|stopMusic|hook\\\\(|_emit\\\\(|_hooks)' engine/API-INDEX.md engine/my-3d2dge.js | head -65 && sed -n '2870,2925p' engine/my-3d2dge.js && sed -n '55,140p' tests/hub/harness.html\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"rg -n '\"'^.*(setInput|input'\"\\\\.set|preset\\\\(|addPlayer|halfKeys|stopMusic|hook\\\\(|_emit\\\\(|_hooks)' engine/API-INDEX.md engine/my-3d2dge.js | head -65 && sed -n '2870,2925p' engine/my-3d2dge.js && sed -n '55,140p' tests/hub/harness.html\"","aggregated_output":"engine/API-INDEX.md:276:- `E.Input.halfKeys(preset, side)` †: a preset for half a keyboard ('left' or 'right'): its moves and menu keys, the preset's other actions on its buttons in order, and the preset's gamepad codes (Input.halfKeys(Input.SHMUP, 'right') -> fire on . and Numpad 1, bomb on /). A preset's own halves come first: preset.halves = { left: { pass: ['KeyR'] }, right: { pass: ['KeyL'] } } (an action a menu reads beside confirm would take confirm's F otherwise)\nengine/API-INDEX.md:476:- `game.addPlayer(o = {})` †: a player in now: { pad: index } (a gamepad) or { keys: 'right' } (the keyboard's right half; player 1 takes the left). Returns its input (null when four play already)\nengine/API-INDEX.md:492:- `game.hook(kind, fn)` †: a function of the game's own on the engine's clock: kind 'input' fn(dt) every step, paused or not, after the input is read (a host's guard, an idle timer); 'step' fn(dt) every update step in play, before the scene's update (an attract mode's watcher); 'enter' fn(name, data) as a scene starts. Returns a function that removes it\nengine/API-INDEX.md:499:- `game.players` †: the players: [game.input (player 1), ...the ones who joined (game.allowJoin, game.addPlayer: section 10j)]; each an input with player (1..4), name ('P1'), color (E.PLAYER_COLORS) and device. A game of one: [game.input]\nengine/API-INDEX.md:1084:- `game.audio.stopMusic(fade)`: stop the music (it fades out over fade seconds, .06 by default)\nengine/my-3d2dge.js:874:      if (!Array.isArray(map[a])) continue;   // (a preset's halves: Input.halfKeys)\nengine/my-3d2dge.js:2406:    this.scenes = null; this.scene = null; this.sceneName = null; this._next = null; this._hooks = null;\nengine/my-3d2dge.js:2493:  /** the players: [game.input (player 1), ...the ones who joined (game.allowJoin, game.addPlayer: section 10j)]; each an\nengine/my-3d2dge.js:2727:    if (hooks !== undefined || !this._hooks) {\nengine/my-3d2dge.js:2729:      this._hooks = hooks;\nengine/my-3d2dge.js:2830:    const A = this.audio; try { A.stopMusic(); if (A.ctx && A.ctx.close) A.ctx.close(); } catch (e) { /* already closed */ } A.ctx = null; A.failed = 'the game was disposed';\nengine/my-3d2dge.js:3723: *    half a keyboard each for two (Input.halfKeys: WASD with F G H R T Y on the left, the arrows with . / , L ; ' and the\nengine/my-3d2dge.js:3737: *  in order, and the preset's gamepad codes (Input.halfKeys(Input.SHMUP, 'right') -> fire on . and Numpad 1, bomb on /).\nengine/my-3d2dge.js:3740:Input.halfKeys = (preset, side) => {\nengine/my-3d2dge.js:3747:const _pPreset = (game, q) => q.half ? Input.halfKeys(game.input._full || game.input.preset, q.half) : (game.input._full || game.input.preset);\nengine/my-3d2dge.js:3764:Game.prototype.addPlayer = function (o = {}) {\nengine/my-3d2dge.js:3770:  const I = P[0]; if (q.half && !I.half) { I._full = I.preset; I.half = 'left'; I.use(Input.halfKeys(I._full, 'left')); }   // player 1 moves to the left half\nengine/my-3d2dge.js:3832:  if (game._lobby) { game._lobby.tick(dt); if (game._lobby.pressed('join') && !P.some(q => q.half === 'right') && I.lastDevice !== 'gamepad') game.addPlayer({ keys: 'right' }); }\nengine/my-3d2dge.js:3839:    game.addPlayer({ pad: p.index });\nengine/my-3d2dge.js:3844:  const I = P[0]; if (I.half && game.scene && game.scene.input) { I._full = I.preset; I.use(Input.halfKeys(I._full, 'left')); }\nengine/my-3d2dge.js:4012:  if (!L) throw new Error('game.hook(\"' + kind + '\"): the hooks are input, step and enter');\nengine/my-3d2dge.js:7878:    if (!song) { this.stopMusic(o.fade); return; }\nengine/my-3d2dge.js:7886:  stopMusic(fade) { const S = this.song; this.song = null; this._ats = []; this._stopSound(S, fade); }\nengine/my-3d2dge.js:7976:    if (!this._timer) this._timer = setInterval(() => { try { this._schedule(); } catch (e) { warn('music-fail', 'music stopped: ' + e.message); this.stopMusic(); } }, 25);\n    if (n) this._stepped = true;\n    if (this._acc < 0) this._acc = 0;\n    this.alpha = this._acc / step;\n    return n;\n  }\n  /**\n   * switch scene: game.go('play', { level: 2 }). It fades through black (dithered) unless opts.fade is 0 (a cut) or another\n   * number of seconds; opts.fade can name a transition instead: 'black', 'white', 'wipe', 'iris', 'mosaic', 'swirl' or\n   * 'dissolve', each way taking opts.seconds (.4), round opts.at (iris and swirl: a world point { x, y, z }, which each\n   * scene's camera places, or [x, y] on the screen; its centre by default). With reduce motion each is a plain fade\n   */\n  go(name, data, o = {}) {\n    if (this._booting) { this._bootGo = { name, data }; return; }   // (a boot step's go: that scene, when the boot ends)\n    if (!this.scenes) { warn('go:noscenes', 'game.go() needs game.start({ scenes: {...}, scene }) first'); return; }\n    if (!this.scenes[name]) { warn('go:' + name, 'game.go(\"' + name + '\"): no such scene. Scenes: ' + Object.keys(this.scenes).join(', ')); return; }\n    let fade = o.fade === undefined ? this.fadeTime : o.fade, kind = null;\n    if (typeof fade === 'string') {\n      kind = fade; fade = o.seconds === undefined ? .4 : +o.seconds || 0;\n      if (kind !== 'black' && kind !== 'white' && !FADES[kind]) warn('fade:' + kind, 'game.go: no transition \"' + kind + '\" here (black, white, wipe, iris, mosaic, swirl, dissolve; a kit may leave them out: the full engine has them): a fade through black');\n    }\n    if (fade > 0 && this.scene) this._fade = { t: 0, dur: fade, name, data, out: true, kind, at: o.at };\n    else { this._fade = null; this._next = { name, data }; }\n  }\n  _fadeStep(dt) {\n    const f = this._fade; f.t += dt;\n    if (f.out && f.t >= f.dur) { f.out = false; f.t = 0; this._enter(f.name, f.data); }\n    else if (!f.out && f.t >= f.dur) this._fade = null;\n  }\n  _fadeLevel() { const f = this._fade; return f ? clamp(f.out ? f.t / f.dur : 1 - f.t / f.dur, 0, 1) : 0; }\n  _enter(name, data) {\n    const s = this.scenes[name];\n    if (!s) throw new Error('scene \"' + name + '\" does not exist. Scenes: ' + Object.keys(this.scenes).join(', '));\n    const old = this.scene;\n    if (old && old.exit) old.exit();\n    if (old && old._propWas !== undefined) { E.style.propSize = old._propWas; old._propWas = undefined; }\n    this.scene = s; this.sceneName = name; this.paused = false; if (old) prune(this._timers, t => !t.keep); this.hitstop = 0;   // (timers made before the first scene live into it)\n    this.particles.list.length = 0; this.cam.snap = true; this.audio._duck(false); this._follow = this._framed = null;\n    const ok = sceneField(name, s);\n    if (ok('view')) this.setView(s.view);\n    if (ok('views')) this.views = s.views;\n    if (ok('input')) this.input.use(s.input);\n    if (ok('res') || ok('expand')) this.screen.setOptions(Object.assign(ok('res') ? { res: s.res } : {}, ok('expand') ? { expand: s.expand } : {}));\n    if (ok('touch')) this.input.touchButtons(s.touch);\n    ok('camera');\n    if (s.propSize !== undefined) { s._propWas = E.style.propSize; E.style.propSize = s.propSize; }   // scene option: prop scale while this scene runs\n    this._zoomFit(true);   // its camera: its zoom to start at, and whether the player's applies\n    if (s.pausable || name === 'main') this._fsAuto = this._autoFull();   // a game starting from a tap goes full screen again\n    for (const f of HOOKS.enter) f(this, old);\n    this._ownRun('enter', name, data);\n    if (s.enter) s.enter(data);\n  }\n  /** report an error in game code without stopping the game: logged once per place and message, kept in game.errors\n   *  and shown on the error panel (the engine reports its own callbacks' errors this way): game.fail('power ' + id, err) */\n  fail(where, e) {\n    const msg = (e && e.message) || String(e), key = where + ':' + msg;\n    if (!this._errKeys.has(key)) {\n  <button id=\"hide\" type=\"button\" aria-pressed=\"false\">Hide host tab</button>\n</header>\n<main>\n  <div id=\"grid\"><p class=\"hint\" style=\"padding:16px\">Name a game above (a path or URL served alongside this page), then press New round. Click a player's frame to control that player.</p></div>\n  <aside>\n    <section><h2>Round</h2><div id=\"round\" class=\"hint\">No round yet.</div></section>\n    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n    <pre id=\"log\" aria-live=\"off\"></pre>\n  </aside>\n</main>\n<script type=\"module\">\nimport { createBridge, attachFrame, postTo, createLocalNetwork } from './bridge.js';\nimport { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\n\nconst NAMES = ['Red Fox', 'Blue Otter', 'Green Heron', 'Gold Lynx'];\nconst params = new URLSearchParams(location.search);\nconst $ = (id) => document.getElementById(id);\nconst auto = params.get('auto') === '1';\nconst scenario = params.get('scenario') || 'standard';\n/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\nconst serverMode = scenario === 'server';\nconst playMs = Number(params.get('play')) || 6000;\nconst SPLASH_MS = 10_000;\n\nfor (const [id, key] of [['game', 'game'], ['players', 'players'], ['latency', 'latency'], ['jitter', 'jitter'], ['loss', 'loss']]) {\n  if (params.has(key)) $(id).value = params.get(key);\n}\n\nconst net = createLocalNetwork({});\nlet current = null;\nlet roundNo = 0;\nconst logLines = [];\nfunction log(text) {\n  const t = (performance.now() / 1000).toFixed(2).padStart(7);\n  logLines.push(`${t}  ${text}`);\n  if (logLines.length > 400) logLines.splice(0, logLines.length - 400);\n  $('log').textContent = logLines.join('\\n');\n  $('log').scrollTop = $('log').scrollHeight;\n}\n\n/** The game's head metas, when the page can be fetched from here. */\nasync function metasOf(url) {\n  try {\n    const html = await (await fetch(url)).text();\n    const doc = new DOMParser().parseFromString(html, 'text/html');\n    const meta = (name) => doc.querySelector(`meta[name=\"${name}\"]`)?.getAttribute('content')?.trim() ?? null;\n    return {\n      session: meta('hub:session'),\n      players: meta('hub:session-players'),\n      mode: meta('hub:session-mode'),\n      minutes: meta('hub:session-minutes'),\n    };\n  } catch {\n    return null;\n  }\n}\n\n/**\n * For a game tagged parallel or ghost, the seed rides in the address: the client seeds Math.random with it before the game's scripts run.\n * Only a page of this site is loaded: ?game= comes from the address bar, and a javascript: or another site's\n * address in an unsandboxed frame would run as this origin, where a signed-in player's session is kept.\n */\nconst gameUrl = (game, { tag, seed } = {}) => {\n  let url;\n  try {\n    url = new URL(game, location.href);\n  } catch {\n    return null;\n  }\n  if (url.origin !== location.origin || !/^https?:$/.test(url.protocol)) return null;\n  url.searchParams.set('aihub', '1');\n  if (seedsRandom(tag)) url.searchParams.set('aihub-seed', String(seed >>> 0));\n  return url.href;\n};\n\nfunction applyNet() {\n  Object.assign(net.settings, {\n    latency: Math.max(0, Number($('latency').value) || 0),\n    jitter: Math.max(0, Number($('jitter').value) || 0),\n    loss: Math.min(0.5, Math.max(0, (Number($('loss').value) || 0) / 100)),\n  });\n}\n\n/** Wrap what a game must not call in hub mode, where the page can reach it. */\nfunction instrument(cell) {\n  try {\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_46","type":"agent_message","text":"The five-day loop is wired through member cards, Body Checks, the island, sessions, recaps, and the ending. Initial simulations found that Laundry Line was too punishing for skilled bots. I’m tuning that while finishing Class, hub ghosts, attract mode, and the developer panel.\n"}}
{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"cat > game/scenes/round.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,game=G.game,P=G.palette,{px}=E;\nG.hub={info:null,card:{left:null,ready:[],asked:false,paused:false},event:-1,over:false,reported:false,total:0,scored:[],ghosts:{},sent:-1,progress:-1,deal:[],rigs:{},phase:'card',duration:150};\nG.hubReport=()=>{const h=G.hub;if(h.reported||h.over)return;h.reported=true;const score=h.total+(G.context?.contestants[0]?.score||0);AIHub.result({score,stats:{Steadiness:Math.round((G.context?.contestants[0]?.bal.steadiness||0)*100)+'%'},awards:[{title:'Present and accounted for',detail:'A morning class on Lumbar Island.'}]});};\nG.connectHub=async()=>{\n const h=G.hub;const info=await AIHub.connect({mode:'ghost',seats:[1,4],card:true});if(\"'!info){G.inSession=false;G.go('\"'title');return;}h.info=info;\n const deal=AIHub.rng('deal'),pick=a=>a[Math.floor(deal()*a.length)];h.deal=[pick(['stork','candle','squat','pushup']),pick(['step','hoop']),pick(['slalom','jog'])];h.duration=Math.min(150,(info.limitMs||150000)/1000);\n for(const p of info.players)h.rigs[p.id]=G.regularRig(p.id+2,1.5);\n AIHub.on('card',c=>{h.card=c;});AIHub.on('start',()=>{h.phase='countdown';});\n AIHub.on('message',(d,from)=>{if(\"'!h.over&&d?.t==='\"'g'&&Number.isFinite(d.a)&&Array.isArray(d.l)&&d.l.every(Number.isFinite)&&Array.isArray(d.w)){h.ghosts[from]=d;}});\n AIHub.on('leave',({id})=>{delete h.ghosts[id];h.info.players=h.info.players.filter(p=>p.id\"'!==id);});\n AIHub.on('\"'time-up',()=>G.hubReport());\n AIHub.on('end',()=>{h.over=true;h.phase='ended';game.audio.stopMusic();game.audio.mute(true);game.input.clear();});\n await game.booted;AIHub.ready();\n};\nlet menu;\nG.scenes.round={view:'brawler',camera:{zoom:false},input:G.INPUT,pausable:true,\n enter(){G.light();G.music('studio');G.context=null;menu=new G.Pills([['Ready',()=>{if(G.hub.info)AIHub.answer('ready');}],['More time · Tab / △',()=>{if(G.hub.info)AIHub.answer('more');}]],{x:14,y:()=>game.H-68,w:215,h:23,gap:8});},\n update(dt){const h=G.hub;if(h.over)return;const info=h.info;if(\"'!info)return;const now=AIHub.time()/1000;\n  if(now===-Infinity){h.phase='\"'card';if(game.input.pressed('more')){AIHub.answer('more');game.input.consumeAll();}menu.update(dt);return;}\n  if(now<0){h.phase='countdown';return;}if(h.reported)return;\n  const segment=h.duration/3,index=Math.min(2,Math.floor(now/segment)),local=now-index*segment,intro=Math.min(5,segment*.1),play=segment-intro*2;\n  if(index\"'!==h.event){if(G.context&&!h.scored[h.event]){h.total+=G.context.contestants[0].score;h.scored[h.event]=true;}h.event=index;const id=h.deal[index];G.context=G.makeContext(id,1,{rng:AIHub.rng('\"'e'+index),duration:play,fixedDuration:true,contestants:[{local:true,name:info.players.find(p=>p.id===info.me)?.name||'Member',color:info.players.find(p=>p.id===info.me)?.color||P.coral,input:game.input,rig:G.playerRig(1.8)}]});G.music(({step:'step',hoop:'step',slalom:'ski',jog:'jog',candle:'raft'})[id]||'studio');}\n  const ctx=G.context;h.phase=local<intro?'intro':local<intro+play?'play':'scores';G.sessionPhase=h.phase==='play'?'play':'countdown';\n  const target=Math.min(play,Math.max(0,local-intro));let steps=0;while(ctx.time+1/120<=target&&\"'!ctx.done&&steps++<2400)G.stepContext(ctx,1/120);\n  if(h.phase==='\"'intro')G.animateContestant(ctx,ctx.contestants[0],dt);\n  if(now-h.sent>=.1){h.sent=now;const c=ctx.contestants[0];AIHub.send({t:'g',a:index,l:[c.bal.x,c.bal.y],p:c.phase,w:[c.worldX||0,c.worldY||0],s:c.score},{reliable:false});}\n  if(now-h.progress>=1){h.progress=now;const score=h.total+ctx.contestants[0].score;AIHub.progress({score,label:score+' pts'});}\n  if(now>=h.duration-.03)G.hubReport();\n  const currentPlayers=info.players.filter(p=>p.id\"'!==info.me);currentPlayers.forEach((p,i)=>{const d=h.ghosts[p.id];if(d?.a===index)G.poseRig(h.rigs[p.id],ctx.a.pose,ctx.time,{dt,x:52+i*35,y:-3,wob:d.l,facing:ctx.a.family==='\"'jog'||ctx.a.family==='slalom'?-1.57:undefined});});game.focus(0,0,20);\n },\n draw(r){const h=G.hub,ctx=G.context,info=h.info;if(\"'!ctx){G.studio(r,'\"'deck');if(info)info.players.forEach((p,i)=>{const x=22+i*33;G.mat(r,x,8,p.color);G.poseRig(h.rigs[p.id],'idle',G.time,{x,y:8});G.drawRig(r,h.rigs[p.id],x,8);});G.header(r,'Morning Class','Wee Serene');r.overlay(g=>{G.paragraph(g,'Three gentle exercises. Stay steadiest. Most points wins.',14,61,225);G.paragraph(g,G.promptText('lean','Lean')+'\\\\n'+G.promptText('breath','Breathe / effort'),14,94,225,{color:P.muted});G.text(g,h.card.paused?'More time. Breathe.':h.card.starting?'Getting ready.':h.card.left===null?'Waiting for the class':Math.ceil(h.card.left/1000)+' seconds to settle',14,126,{color:P.cyan});if(info)info.players.forEach((p,i)=>G.text(g,p.name+(h.card.ready.includes(p.id)?' ✓':''),r.W-20,57+i*13,{align:'right',color:p.color}));});if(h.phase==='card')menu.draw(r);}\n else{const a=ctx.a,f=G.families[a.family];if(f.fullDraw)f.fullDraw(r,ctx);else{G.studio(r,a.room);const c=ctx.contestants[0];G.mat(r,-12,4,c.color);G.drawRig(r,c.rig,c.worldX||-12,c.worldY||4);a.draw(r,ctx);r.overlay(g=>G.drawPlate(g,r.W/2,r.H-33,c.bal));}\n  if(info)info.players.filter(p=>p.id\"'!==info.me).forEach((p,i)=>{const d=h.ghosts[p.id];if(d?.a===h.event){const x=52+i*35;G.drawRig(r,h.rigs[p.id],x,-3,0,{alpha:.45});const q=r.w(x,-3,47);r.overlay(g=>G.text(g,p.name,q[0],q[1],{align:'\"'center',color:p.color}));}});\n  a.hud(r,ctx);G.header(r,'Morning class · '+(h.event+1)+' / 3',a.name);if(h.phase==='intro')G.ribbon(r,'Settle in',a.hint);if(h.phase==='scores')G.ribbon(r,ctx.contestants[0].score+' points','A little breath before the next one.');\n }\n if(h.phase==='countdown'&&\"'!ctx)G.ribbon(r,'\"'Breathe in',String(Math.ceil(-AIHub.time()/1000)));if(h.over)G.ribbon(r,'Class complete','Your place is with the hub.');\n }\n};\n})();\nEOF\ncat > game/scenes/about.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,game=G.game,P=G.palette;\nconst tq=['Issues caught','Critical issues','Most helpful test','Least helpful test'],eq=['What worked best','Where I guessed wrong','Most important addition','Hardest engine task','Engine changes','One engine suggestion'],pq=['What helped','What was confusing','Hardest prompt task','One prompt suggestion'];\nlet pages,page=0,menu;\nG.aboutPages=()=>{const a=G.ABOUT;if(\"'!a)return [{section:'\"'Source Information',title:'Wee Serene',text:'The full source record is in exit-interview.json beside this game.'},{section:'Credits',title:'Made of code',text:'my-3D2dge v0.89.0 (MIT). Mesh2Motion and Quaternius (CC0). CMU Graphics Lab Motion Capture Database (free for all uses).'}];\n const out=[];for(const [key,val]of Object.entries(a.sourceInformation))out.push({section:'Source Information',title:key.replace(/([A-Z])/g,' \"'$1'\"').replace(/\"'^./,s=>s.toUpperCase()),text:val});for(const [key,label,questions]of [['\"'testingFeedback','Testing Feedback',tq],['engineFeedback','Engine Feedback',eq],['promptFeedback','Prompt Feedback',pq]])a[key].forEach((text,i)=>out.push({section:label,title:questions[i],text}));out.push({section:'Credits',title:'A kind little machine',text:'Engine: my-3D2dge v0.89.0, MIT. Motion: Mesh2Motion and Quaternius, CC0. Yoga and exercise: CMU Graphics Lab Motion Capture Database, free for all uses. Retreat art, writing, motion layers, songs and voices: original code. Generic props: engine core library.'});return out;};\nG.scenes.about={view:'brawler',camera:{zoom:false},enter(){G.context=null;pages=G.aboutPages();page=0;make();},update(dt){menu.update(dt);G.idle+=dt;if(G.idle>=10&&\"'!game.shell.screen)G.startAttract();},draw(r){G.paper(r);const p=pages[page];G.header(r,p.section,p.title);r.overlay(g=>{G.paragraph(g,p.text,14,66,r.W-28,{lineHeight:12});G.text(g,(page+1)+'\"' / '+pages.length,r.W-16,r.H-18,{align:'right',color:P.muted});});menu.draw(r);}};\nfunction make(){menu=new G.Pills([['Next page',()=>{page=(page+1)%pages.length;make();}],['Previous page',()=>{page=(page+pages.length-1)%pages.length;make();}],['Back',()=>G.go('title')]],{x:14,y:()=>game.H-69,w:160,h:17,gap:5,back:()=>G.go('title')});}\n})();\nEOF\ncat > game/dev.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,game=G.game,P=G.palette,{px,clamp}=E;\nconst groups=['Tools','Lean','Scoring','Cardio','Games','World','Pose','Jump'];let rows=[],boxes=[],drag=-1,lastClick=0;\nG.devRows=()=>{\n const d=G.dev;\n if(d.group==='Tools')return [\n  {label:'Activity jump',act:()=>{d.group='Jump';d.page=0;d.row=0;}},\n  {label:'Day',key:'day',value:()=>d.day,change:s=>d.day=clamp(d.day+s,1,6),act:()=>{G.member.day=d.day;G.member.checked=false;G.go('bungalow');}},\n  {label:'Finish with stars',value:()=>d.stars,change:s=>d.stars=clamp(d.stars+s,0,3),act:()=>{if(G.context){const ctx=G.context;G.sessionPhase='results';const st=d.stars,pct=st===3?1:st===2?.8:st===1?.5:.1;G.result={pct,stars:st,minutes:1,detail:'Developer finish'};if(\"'!G.attracting){G.member.best[ctx.a.id+'\"'-'+ctx.tier]={pct,stars:st};G.member.minutes++;G.refreshAge();G.persist();}G.go('results',{ctx,result:G.result});}}},\n  {label:'Unlock all',act:()=>{G.member.ended=true;G.member.day=6;for(const a of Object.values(G.activities))G.member.best[a.id+'-1']={stars:3,pct:1};G.member.spineAge=G.calculateAge();G.persist();}},\n  {label:'+10 minutes',act:()=>{G.member.minutes+=10;G.persist();}},\n  {label:'Spine Age',value:()=>G.member.spineAge,change:s=>{G.member.spineAge=clamp(G.member.spineAge+s,19,71);}},\n  {label:'Reset this member',act:()=>{G.member=G.memberDefault();G.persist();G.go('bungalow');}},\n  {label:'No stumbles',value:()=>d.noFalls?'On':'Off',change:()=>d.noFalls=\"'!d.noFalls,act:()=>d.noFalls=!d.noFalls},\n  {label:'\"'Bot plays',value:()=>d.bot||'Off',change:s=>{const a=[null,'poor','average','good','expert'];d.bot=a[(a.indexOf(d.bot)+s+5)%5];},act:()=>{const a=[null,'poor','average','good','expert'];d.bot=a[(a.indexOf(d.bot)+1)%5];}},\n  {label:'Plate numbers',value:()=>d.trace?'On':'Off',act:()=>d.trace=\"'!d.trace,change:()=>d.trace=!d.trace},\n  {label:'\"'Freeze / frame step',value:()=>d.frame?'Frozen':'Running',act:()=>{d.frame=\"'!d.frame;G.stepFrame=true;},change:()=>{d.frame=true;G.stepFrame=true;}},\n  {label:'\"'Force attract',act:()=>{G.startAttract();}},\n  {label:'Pose viewer',act:()=>{G.go('pose');}},\n  {label:'Log snapshot',act:()=>{console.log(JSON.stringify(game.debug.snapshot(),null,2));game.note('Snapshot in console');}},\n  {label:'Reset all defaults',act:()=>G.resetDev()}\n ];\n if(d.group==='Jump')return Object.values(G.activities).map(a=>({label:a.name,value:()=>d.tier,change:s=>d.tier=clamp(d.tier+s,1,2),act:()=>G.startSession(a.id,d.tier,'free')})).concat([{label:'Title',act:()=>G.go('title')},{label:'Island',act:()=>G.go('island')},{label:'Body Check',act:()=>G.go('bodycheck')},{label:'Evening',act:()=>G.go('evening')},{label:'Gentle Games',act:()=>G.go('games')},{label:'Ending',act:()=>G.go('ending')},{label:'Free Play',act:()=>{G.member.ended=true;G.mode='free';G.go('catalog');}},{label:'Class',act:()=>G.go('classLobby')}]);\n if(d.group==='Pose')return [{label:'Clip',value:()=>d.pose,change:s=>{const names=G.lib.names;d.pose=names[(names.indexOf(d.pose)+s+names.length)%names.length];}},{label:'Time',value:()=>d.poseTime.toFixed(2),change:s=>d.poseTime=clamp(d.poseTime+s*.1,0,G.lib.clip(d.pose).dur)},{label:'Open viewer',act:()=>G.go('pose')},{label:'Print pose row',act:()=>{console.log(JSON.stringify({clip:d.pose,a:+d.poseTime.toFixed(2),b:+(d.poseTime+.5).toFixed(2),tgt:1.57}));game.note('Pose row in console');}}];\n return G.DEFS.filter(x=>x[6]===d.group).map(a=>({label:a[1],key:a[0],min:a[2],max:a[3],step:a[4],default:a[5],value:()=>G.DEV[a[0]].toFixed(a[4]<1?2:0),change:s=>{G.DEV[a[0]]=clamp(G.DEV[a[0]]+s*a[4],a[2],a[3]);if(a[0]==='timeScale')game.timeScale=G.DEV.timeScale;}})).concat([{label:'Reset all defaults',act:()=>{G.resetDev();game.timeScale=1;}}]);\n};\nG.devUpdate=dt=>{\n if(G.inSession||\"'!G.dev.open)return;const d=G.dev,I=game.input;rows=G.devRows();const count=Math.ceil(rows.length/5),pageRows=rows.slice(d.page*5,d.page*5+5);d.row=clamp(d.row,0,pageRows.length-1);\n if(I.pressed('\"'cancel')){d.open=false;I.consumeAll();return;}\n if(I.pressed('more')){d.group=groups[(groups.indexOf(d.group)+1)%groups.length];d.page=0;d.row=0;I.consumeAll();return;}\n if(I.repeat('down'))d.row=(d.row+1)%pageRows.length;if(I.repeat('up'))d.row=(d.row+pageRows.length-1)%pageRows.length;\n const current=pageRows[d.row];let change=I.repeat('right')?1:I.repeat('left')?-1:0;if(I.down('catchL')||I.down('catchR'))change*=5;if(change)current?.change?.(change);\n if(I.pressed('confirm')){current?.act?.();I.consumeAll();}\n if(I.pressed('retry')){d.page=(d.page+1)%count;d.row=0;}\n const click=I.clicked();if(click){if(click[0]<game.W*.39&&click[1]<37){d.group=groups[(groups.indexOf(d.group)+1)%groups.length];d.page=0;d.row=0;}\n else if(click[0]<game.W*.39&&click[1]>game.H-32){d.page=(d.page+1)%count;d.row=0;}\n else{const n=boxes.findIndex(b=>click[0]>=b.x&&click[0]<=b.x+b.w&&click[1]>=b.y&&click[1]<=b.y+b.h);if(n>=0){d.row=n;const row=pageRows[n];if(row?.change)row.change(click[0]>game.W*.23?1:-1);else row?.act?.();}}I.consumeAll();}\n const p=I.pointer();if(I.down('breath')&&G.source==='mouse'&&p){const n=boxes.findIndex(b=>p[0]>=b.x&&p[0]<=b.x+b.w&&p[1]>=b.y+12&&p[1]<=b.y+b.h);const row=pageRows[n];if(row?.key&&row.min\"'!==undefined){const b=boxes[n],v=clamp((p[0]-b.x-5)/(b.w-10),0,1);G.DEV[row.key]=Math.round((row.min+v*(row.max-row.min))/row.step)*row.step;if(row.key==='\"'timeScale')game.timeScale=G.DEV.timeScale;}}\n};\nG.devDraw=r=>{const d=G.dev;rows=G.devRows();const pageRows=rows.slice(d.page*5,d.page*5+5),w=Math.max(143,Math.floor(r.W*.39));r.overlay(g=>{G.round(g,4,4,w-4,r.H-8,'#f9fdfb');G.text(g,'DEV / '+d.group,12,13,{color:P.cyan});G.text(g,'Tab: category   ○: close',12,27,{color:P.muted});boxes=[];pageRows.forEach((row,i)=>{const x=9,y=44+i*30,ww=w-13,focus=i===d.row;boxes.push({x,y,w:ww,h:27});if(focus)G.round(g,x,y,ww,27,'#d5eee9');G.text(g,row.label,x+4,y+3);if(row.value)G.text(g,String(row.value()),x+ww-4,y+15,{align:'right',color:P.cyan});if(row.key&&row.min\"'!==undefined){const v=(G.DEV[row.key]-row.min)/(row.max-row.min);px.rect(g,x+5,y+19,ww-51,2,'\"'#bed5d4');px.rect(g,x+5,y+19,(ww-51)*v,2,P.cyan);px.disc(g,x+5+(ww-51)*v,y+19,2,P.cyan);G.text(g,'D '+row.default,x+5,y+12,{color:P.muted});}});G.text(g,'R: page '+(d.page+1)+' / '+Math.ceil(rows.length/5),12,r.H-21,{color:P.cyan});});};\nlet rig,menu;\nG.scenes.pose={view:'brawler',camera:{zoom:false},pausable:true,enter(){G.light();rig=G.playerRig(2);G.dev.open=true;G.dev.group='Pose';},update(dt){G.poseRig(rig,'idle',G.dev.poseTime,{dt,clip:G.dev.pose,x:40,y:0});if(game.input.pressed('cancel')&&\"'!G.dev.open)G.go('\"'title');},draw(r){G.studio(r,'iron');G.drawRig(r,rig,40,0);r.overlay(g=>{G.text(g,G.dev.pose,r.W-15,55,{align:'right',color:P.cyan});G.text(g,G.dev.poseTime.toFixed(2)+' seconds',r.W-15,70,{align:'right'});});}};\n})();\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('game/main.js');s=p.read_text().replace('G.finishRegistry();',\\\"G.finishRegistry();\\\\nfor(const [name,scene]of Object.entries(G.scenes)){const draw=scene.draw;scene.draw=r=>{draw?.(r);if(G.dev.trace&&G.context)r.overlay(g=>{const b=G.context.contestants[0].bal;G.text(g,'p '+b.x.toFixed(2)+' '+b.y.toFixed(2)+' / v '+b.vx.toFixed(2)+' '+b.vy.toFixed(2),12,r.H-88,{color:G.palette.ink});});if(G.dev.open&&\"'!G.inSession)G.devDraw(r);};}'\"\\\\ngame.hook('enter',name=>{G.sceneName=name;G.visited.add(name);});\\\")\np.write_text(s)\np=Path('game/core.js');s=p.read_text().replace(\\\"fade:instant?0:'iris'\\\",\\\"fade:instant||G.game.fadeTime===0?0:'iris'\\\");p.write_text(s)\np=Path('game/scenes/title.js');s=p.read_text().replace(\\\"G.scenes.title={view:'brawler'\\\",\\\"G.scenes.title={input:G.INPUT,view:'brawler'\\\");p.write_text(s)\np=Path('game/scenes/session