{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module - <<'JS'\nimport {load} from './tests/load.mjs';const {G}=load();G.animateContestant=()=>{};for(const [rope,gust]of [[12,4.5],[14,4.5],[16,4.5],[10,5],[10,6],[8,7]]){G.DEV.rope=rope;G.DEV.gust=gust;let out=[];for(const skill of ['average','good','expert']){const ctx=G.makeContext('laundry',1,{seed:3});for(let i=0;i<8400&&\"'!ctx.done;i++)G.stepContext(ctx,1/120,skill);const c=ctx.contestants[0];out.push(skill+'\"':'+ctx.a.result(ctx,c).pct.toFixed(2)+'('+c.bal.falls+')');}console.log(rope,gust,out.join(' '));}\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
