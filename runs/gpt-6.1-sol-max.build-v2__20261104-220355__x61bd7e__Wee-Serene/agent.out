inSession||\"'!G.dev.open)return;const d=G.dev,I=game.input;rows=G.devRows();const count=Math.ceil(rows.length/5),pageRows=rows.slice(d.page*5,d.page*5+5);d.row=clamp(d.row,0,pageRows.length-1);\n if(I.pressed('\"'cancel')){d.open=false;I.consumeAll();return;}\n if(I.pressed('more')){d.group=groups[(groups.indexOf(d.group)+1)%groups.length];d.page=0;d.row=0;I.consumeAll();return;}\n if(I.repeat('down'))d.row=(d.row+1)%pageRows.length;if(I.repeat('up'))d.row=(d.row+pageRows.length-1)%pageRows.length;\n const current=pageRows[d.row];let change=I.repeat('right')?1:I.repeat('left')?-1:0;if(I.down('catchL')||I.down('catchR'))change*=5;if(change)current?.change?.(change);\n if(I.pressed('confirm')){current?.act?.();I.consumeAll();}\n if(I.pressed('retry')){d.page=(d.page+1)%count;d.row=0;}\n const click=I.clicked();if(click){if(click[0]<game.W*.39&&click[1]<37){d.group=groups[(groups.indexOf(d.group)+1)%groups.length];d.page=0;d.row=0;}\n else if(click[0]<game.W*.39&&click[1]>game.H-32){d.page=(d.page+1)%count;d.row=0;}\n else{const n=boxes.findIndex(b=>click[0]>=b.x&&click[0]<=b.x+b.w&&click[1]>=b.y&&click[1]<=b.y+b.h);if(n>=0){d.row=n;const row=pageRows[n];if(row?.change)row.change(click[0]>game.W*.23?1:-1);else row?.act?.();}}I.consumeAll();}\n const p=I.pointer();if(I.down('breath')&&G.source==='mouse'&&p){const n=boxes.findIndex(b=>p[0]>=b.x&&p[0]<=b.x+b.w&&p[1]>=b.y+12&&p[1]<=b.y+b.h);const row=pageRows[n];if(row?.key&&row.min\"'!==undefined){const b=boxes[n],v=clamp((p[0]-b.x-5)/(b.w-10),0,1);G.DEV[row.key]=Math.round((row.min+v*(row.max-row.min))/row.step)*row.step;if(row.key==='\"'timeScale')game.timeScale=G.DEV.timeScale;}}\n};\nG.devDraw=r=>{const d=G.dev;rows=G.devRows();const pageRows=rows.slice(d.page*5,d.page*5+5),w=Math.max(143,Math.floor(r.W*.39));r.overlay(g=>{G.round(g,4,4,w-4,r.H-8,'#f9fdfb');G.text(g,'DEV / '+d.group,12,13,{color:P.cyan});G.text(g,'Tab: category   ○: close',12,27,{color:P.muted});boxes=[];pageRows.forEach((row,i)=>{const x=9,y=44+i*30