{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('game/activities/common.js');s=p.read_text();s=s.replace(\\\"const ctx={a,tier,time:0,duration:opts.duration||a.duration*(tier===2&&a.family==='rep'?1.5:1)\\\",\\\"const safe=Object.fromEntries(Object.entries(opts).filter(([k,v])=>v\"'!==undefined&&k!=='\"'contestants'));\\\\n const ctx={a,tier,time:0,duration:opts.duration||a.tiers[tier-1].duration||a.duration\\\").replace('tierData:{...a.tiers[tier-1]},...opts','tierData:{...a.tiers[tier-1]},...safe');p.write_text(s)\np=Path('game/core.js');s=p.read_text().replace(\\\"['rope','Rope instability',8,22,.5,16\\\",\\\"['rope','Rope instability',4,22,.5,12\\\").replace(\\\"['gust','Gust strength',0,15,.5,9\\\",\\\"['gust','Gust strength',0,15,.5,4.5\\\");p.write_text(s)\np=Path('game/activities/laundry.js');s=p.read_text().replace('s:G.DEV.rope+v.effort*4','s:G.DEV.rope+(ctx.tier===2?2:0)+v.effort*4');p.write_text(s)\np=Path('game/data/activities.js');s=p.read_text().replace('G.disciplines=[',\\\"for(const [id,reps]of [['squat',12],['pushup',10],['lunge',12]])G.activities[id].tiers[1].duration=reps*5;\\\\nG.disciplines=[\\\");p.write_text(s)\np=Path('game/scenes/session.js');s=p.read_text().replace(\\\"Math.round((G.pending.duration||a.duration))\\\",\\\"Math.round((G.pending.duration||a.tiers[G.pending.tier-1].duration||a.duration))\\\");p.write_text(s)\nPY\ncat > tests/issues.md <<'EOF'\n# Issues caught and fixed during testing\n\n1. Critical: Mocap sampling requires a clip object, not a clip name. Fixed the rig adapter.\n2. Critical: Session options containing undefined fields replaced the contestants array and default duration. Filtered optional fields before constructing the context.\n3. Gameplay: Laundry Line's compounded instability and gusts prevented skilled bots from finishing. Tuned default rope instability to 12 and gust strength to 4.5, with a harder second tier.\n4. Gameplay: Tier 2 rail durations did not allow the planned rep counts. Added designer-owned durations for 12/10/12 reps.\nEOF\nnode build.mjs\nnode --input-type=module - <<'JS'\nimport {load} from './tests/load.mjs';const {G}=load();G.animateContestant=()=>{};for(const tier of [1,2]){for(const skill of ['passive','average','good','expert']){let scores=[];for(let seed=1;seed<=12;seed++){const ctx=G.makeContext('laundry',tier,{seed});for(let i=0;i<100*120&&\"'!ctx.done;i++)G.stepContext(ctx,1/120,skill);scores.push(ctx.a.result(ctx,ctx.contestants[0]).pct);}console.log('\"'laundry',tier,skill,'min',Math.min(...scores).toFixed(2),'mean',(scores.reduce((a,b)=>a+b)/12).toFixed(2));}}\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
