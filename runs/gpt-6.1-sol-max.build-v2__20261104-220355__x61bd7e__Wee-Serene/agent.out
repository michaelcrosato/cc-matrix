{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"cat > game/activities/step.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E;\nG.families.step={\n setup(ctx,c){const bpm=ctx.tier===2?120:100,clock={step:0,t:0,bpm,playing:true},dummy={time:0,audio:{pos:clock,sfx(){},music(){}},input:{pressed(){return false;},released(){return false;},down(){return false;}}};\n c.data={clock,dummy,stepAnim:0,judgment:'On the click'};\n const song={...G.SONGS[ctx.tier===2?'step2':'step'],loop:false,len:Math.ceil(ctx.duration*bpm/60*4)};\n c.data.rh=new E.Rhythm(dummy,{song,chart:G.CHARTS[ctx.tier-1],lanes:['stepL','stepD','stepU','stepR'],windows:{perfect:45*G.DEV.rhythmWindow,great:90*G.DEV.rhythmWindow,good:135*G.DEV.rhythmWindow},life:1,lead:2,on:{judge(j){c.data.stepAnim=.4;c.data.judgment=j==='miss'?'Next one':j==='perfect'?'Perfect':j==='great'?'Lovely':'Good';if(j\"'!=='\"'miss'&&G.context===ctx)G.game.audio.sfx('tick');},fail(rh){rh.life=.5;rh.done=false;rh.failed=false;}}});\n c.data.rh.notes=c.data.rh.notes.filter(n=>n.step<song.len);c.data.rh.started=true;\n },\n bot(ctx,c,dt,skill){const d=c.data,bpm=ctx.tier===2?120:100,step=ctx.time*bpm/60*4;c.intent.steps=[false,false,false,false];for(const n of d.rh.notes){if(n.j)continue;const offset=skill==='poor'?.10:skill==='average'?.065:skill==='good'?.022:.004;const skip=skill==='poor'?4:skill==='average'?11:9999;if(Math.floor(n.step)%skip===0&&skill\"'!=='\"'expert'&&skill\"'!=='\"'good')continue;if(step>=n.step+offset*bpm/60*4&&step<n.step+.14*bpm/60*4)c.intent.steps[n.lane]=true;}},\n update(ctx,c,dt){const d=c.data,bpm=ctx.tier===2?120:100;d.clock.t=ctx.time;d.clock.step=ctx.time*bpm/60*4;d.dummy.time=ctx.time;d.stepAnim=Math.max(0,d.stepAnim-dt);c.intent.steps.forEach((hit,i)=>{if(hit)d.rh.hit(i);else d.rh.release(i);});d.rh.update();c.bal.step(dt,c.intent,{noFalls:true});G.animateContestant(ctx,c,dt);},\n result(ctx,c){const rh=c.data.rh;return {pct:rh.counts.perfect+rh.counts.great+rh.counts.good+rh.counts.miss?rh.accuracy:0,detail:rh.maxCombo+' best streak · '+rh.counts.perfect+' perfect steps'};},\n draw(){},\n hud(r,ctx){if(ctx.contestants.length===1){const d=ctx.contestants[0].data;d.rh.draw(r,{x:r.W/2,y:r.H-22,dir:'down',len:53,gap:30,size:7,colors:['#3e98ae','#b293bc','#62af91','#e1ae5e'],arrows:true});r.overlay(g=>G.text(g,d.judgment,16,r.H-42,{color:G.palette.cyan}));}else ctx.contestants.forEach((c,i)=>c.data.rh.draw(r,{x:r.W/2+(i-(ctx.contestants.length-1)/2)*82,y:r.H-12,dir:'down',len:40,gap:13,size:4,arrows:true}));}\n};\n})();\nEOF\ncat > game/activities/hoop.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,{px,clamp}=E;\nG.families.hoop={\n setup(ctx,c){c.data={angle:0,lastAngle:null,speed:0,hoops:1,points:0,bad:0,caught:0,lastCatch:-1,toss:0,side:0};},\n bot(ctx,c,dt,skill){const dir=ctx.time<ctx.duration/2?1:-1,ang=ctx.time<ctx.duration/2?ctx.time*9:(ctx.duration-ctx.time)*9;const speed=skill==='poor'?.6:skill==='average'?.91:1;c.intent.x=Math.cos(ang*speed)*.8;c.intent.y=Math.sin(ang*speed)*.8;const hit=ctx.time%8<.05;c.intent.catchL=hit&&Math.floor(ctx.time/8)%2===1;c.intent.catchR=hit&&Math.floor(ctx.time/8)%2===0;c.intent.source='gamepad';},\n update(ctx,c,dt){const d=c.data,v=c.intent,angle=Math.atan2(v.y,v.x),diff=d.lastAngle===null?0:E.angDiff(d.lastAngle,angle);d.lastAngle=angle;d.angle+=diff;\n const raw=Math.abs(diff/dt);d.speed+=(raw-d.speed)*Math.min(1,dt*8);const keyboard=v.source==='keyboard',low=G.DEV.hoopLow*(keyboard?.6:1),high=(G.DEV.hoopHigh+(d.hoops-1)*.15)*(keyboard?.6:1),dir=ctx.time<ctx.duration/2?1:-1;\n const correct=diff*dir>=0&&Math.hypot(v.x,v.y)>.55&&d.speed>=low&&d.speed<=high;d.good=correct;\n if(correct){d.points+=(1+d.hoops*.2)*dt;d.bad=0;}else d.bad+=dt;\n if(d.bad>1.5&&d.hoops>1){d.hoops--;d.bad=0;}\n const toss=Math.round(ctx.time/8),window=Math.abs(ctx.time-toss*8);d.toss=window<1.3&&toss>0?1-window/1.3:0;d.side=toss%2?0:1;\n if(toss>0&&window<.25&&d.lastCatch\"'!==toss&&((d.side===0&&v.catchL)||(d.side===1&&v.catchR))){d.hoops=Math.min(6,d.hoops+1);d.caught++;d.lastCatch=toss;if(G.context===ctx)G.game.audio.sfx('\"'clink');}\n c.bal.step(dt,v,{noFalls:true});G.animateContestant(ctx,c,dt);\n },\n result(ctx,c){return {pct:clamp(c.data.points/(ctx.duration*1.65),0,1),detail:c.data.caught+' catches · '+c.data.hoops+' hoops at the finish'};},\n draw(r,ctx){for(const c of ctx.contestants){const p=r.w(c.worldX,c.worldY,22);for(let h=0;h<c.data.hoops;h++){const col=['#efb967','#e98b75','#8bc9b1','#8cbcd4','#ba9ecb','#d6c56d'][h];for(const front of [false,true])r.queue(c.worldX,c.worldY,22,g=>{const cy=p[1]+h*2-3;let prev=null;for(let i=0;i<=16;i++){const a=(front?0:Math.PI)+i/16*Math.PI,point=[p[0]+Math.cos(a)*19,p[1]+h*2+Math.sin(a)*5];if(prev)px.line(g,...prev,...point,col,2);prev=point;}},{bias:front?6:-6});}}},\n hud(r,ctx){const d=ctx.contestants[0].data;r.overlay(g=>{G.round(g,r.W/2-68,49,136,29,'#ffffff');G.text(g,ctx.time>ctx.duration/2?'Other way\"'!'\"':'Keep it circling',r.W/2,55,{align:'center',color:G.palette.cyan});G.text(g,d.good?'Just right':d.speed<6?'Too slow':'Too eager',r.W/2,67,{align:'center'});if(d.toss>.1)G.tag(g,(d.side===0?G.promptText('catchL','Catch left'):G.promptText('catchR','Catch right')),d.side===0?14:r.W-140,105);});}\n};\n})();\nEOF\ncat > game/activities/slalom.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,{px,clamp}=E;\nG.families.slalom={\n setup(ctx,c){c.data={x:0,z:0,gates:0,missed:0,penalty:0,next:0,tumble:0,finish:0};if(\"'!ctx.m7){ctx.m7=new E.Mode7({floor:(x,y)=>{const n=((Math.floor(x/60)+Math.floor(y/60))%2)?[234,244,245]:[219,234,237];return n;},size:[2000,16000],outside:'\"'#dfedf0',sky:['#90bfd5','#dcecf3'],far:1900,fog:ctx.tier===2?{color:'#c5d9e2',near:500,far:1800}:null});}},\n bot(ctx,c,dt,skill){const d=c.data,next=G.COURSES.gates[Math.min(17,d.next)],diff=next-d.x,quality=skill==='poor'?.55:skill==='average'?.85:1;c.intent.x=clamp(diff*.013*quality,-1,1);c.intent.y=skill==='poor'?0:skill==='average'?.25:.7;},\n update(ctx,c,dt){const d=c.data,v=c.intent;d.tumble=Math.max(0,d.tumble-dt);const speed=G.DEV.slalomSpeed*(v.y>0?1+v.y*.35:1+v.y*.4)*(d.tumble>0?.3:1);d.z+=speed*dt;d.x=clamp(d.x+v.x*G.DEV.slalomTurn*dt,-550,550);\n while(d.next<18&&d.z>340+d.next*G.COURSES.spacing){const target=G.COURSES.gates[d.next],width=ctx.tier===2?58:88;if(Math.abs(d.x-target)<width)d.gates++;else{d.missed++;d.penalty+=3;if(G.context===ctx)G.game.audio.sfx('creak');}d.next++;}\n if(Math.abs(d.x)>480&&d.tumble<=0){d.tumble=1.2;d.penalty+=1.2;d.x*=.88;}\n if(d.next>=18){d.finish=ctx.time;c.finished=true;}\n c.bal.x=v.x*.45;c.bal.y=v.y*.35;G.animateContestant(ctx,c,dt);\n ctx.m7.cam={x:d.x+1000,y:d.z-85,h:42,angle:Math.PI/2,pitch:13,fov:72};\n },\n result(ctx,c){const d=c.data,completion=d.gates/18,timeScore=clamp((G.COURSES.worst-(d.finish||ctx.time)-d.penalty)/(G.COURSES.worst-G.COURSES.par),0,1);return {pct:clamp(completion*(.7+.3*timeScore),0,1),detail:d.gates+'/18 gates · '+d.missed+' missed · +'+d.penalty.toFixed(0)+'s'};},\n fullDraw(r,ctx){const d=ctx.contestants[0].data,m=ctx.m7;for(let i=Math.max(0,d.next-1);i<18;i++){const y=340+i*G.COURSES.spacing,target=1000+G.COURSES.gates[i],w=ctx.tier===2?58:88;for(const s of [-1,1])m.add(target+s*w,y,0,(g,x,yy,k)=>{const h=32*k;px.line(g,x,yy,x,yy-h,'#4c8c9f',Math.max(1,k*2));px.poly(g,[[x,yy-h],[x+s*16*k,yy-h+4*k],[x,yy-h+11*k]],i%2?'#ed947d':'#62b9c2');});}\n for(let i=0;i<45;i++){const yy=i*300+130,xx=1000+(i%2?-560:560)+(i%3)*50;m.add(xx,yy,0,(g,x,y,k)=>{if(i%6===0){px.disc(g,x,y-8*k,8*k,'#ffffff');px.disc(g,x,y-20*k,5*k,'#ffffff');px.rect(g,x-6*k,y-27*k,12*k,3*k,'#7c9fae');}else{px.poly(g,[[x-15*k,y],[x,y-45*k],[x+15*k,y]],'#85afb1');px.poly(g,[[x-12*k,y-12*k],[x,y-45*k],[x+12*k,y-12*k]],'#eff8f7');}});}\n m.draw(r);r.overlay(g=>{const x=r.W/2,y=r.H-42;px.ell(g,x,y+2,24,5,'#adcbd4');px.line(g,x-12,y-2,x-20,y+8,'#d88872',3);px.line(g,x+12,y-2,x+20,y+8,'#d88872',3);});G.drawRig(r,ctx.contestants[0].rig,0,23);r.overlay(g=>{G.round(g,13,r.H-53,91,29,'#ffffff');G.text(g,d.gates+' / 18 gates',20,r.H-46,{color:G.palette.cyan});G.text(g,'+'+d.penalty.toFixed(0)+' seconds',20,r.H-35,{color:G.palette.muted});});},\n draw(){},hud(){}\n};\n})();\nEOF\ncat > game/activities/jog.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,{px,clamp}=E;\nG.families.jog={\n setup(ctx,c){c.data={x:0,z:0,cadence:0,steps:[],lastFoot:null,zone:0,cups:0,cupIndex:0,stitch:0,sprint:0,lastBeat:-1,pigeons:0};if(\"'!ctx.road){ctx.road=new E.Road({segment:150,width:1100,lanes:2,draw:110,height:650,fov:92,fog:{color:'\"'#cbeced',density:3},sky:new E.Backdrop({sky:['#9cdaed','#d5f1f0'],sun:{x:.8,y:.2,r:12,color:'#fff8cf'},layers:[{kind:'sea',color:'#65bec7',y:.43,height:.5}]}),colors:{road:['#e1d3b5','#e7d9bc'],grass:['#9bd1a6','#a8d4aa'],rumble:['#f1eee0','#e9e3c9'],lane:'#f5e9d0'}});ctx.road.add(70);ctx.road.add(70,{curve:1.4,hill:500});ctx.road.add(70,{curve:-1.2,hill:-500});ctx.road.add(70);for(let i=0;i<70;i++)ctx.road.place(i*550,i%2?1.5:-1.5,{w:140,draw(g,x,y,k){px.rect(g,x-6*k,y-40*k,12*k,40*k,'#ab9e7e');px.ell(g,x,y-53*k,30*k,16*k,'#87b99a');px.ell(g,x-12*k,y-61*k,17*k,13*k,'#abd1aa');}},1);}},\n bot(ctx,c,dt,skill){const d=c.data,beat=Math.floor(ctx.time*(skill==='poor'?2.1:skill==='average'?2.7:3)),hit=beat\"'!==d.lastBeat;d.lastBeat=beat;c.intent.paceL=hit&&beat%2===0;c.intent.paceR=hit&&beat%2===1;const target=G.COURSES.cups[Math.min(7,d.cupIndex)];c.intent.x=clamp((target-d.x)*2,-1,1);},\n update(ctx,c,dt){const d=c.data,v=c.intent;for(const [foot,hit]of [[0,v.paceL],[1,v.paceR]])if(hit&&d.lastFoot!==foot){d.lastFoot=foot;d.steps.push(ctx.time);}while(d.steps[0]<ctx.time-2)d.steps.shift();d.cadence=d.steps.length/2;\n const inZone=d.cadence>=G.DEV.jogLow&&d.cadence<=G.DEV.jogHigh;if(inZone)d.zone+=dt;if(d.cadence>4.2)d.sprint+=dt;else d.sprint=0;if(d.sprint>2){d.stitch=3;d.sprint=0;}d.stitch=Math.max(0,d.stitch-dt);\n d.x=clamp(d.x+v.x*dt*.8,-1,1);d.z+=Math.max(.15,d.cadence/3)*(d.stitch>0?.45:1)*600*dt*G.DEV.jogSpeed;\n const ci=Math.floor(ctx.time/(ctx.duration/8));if(ci>d.cupIndex&&d.cupIndex<8){if(Math.abs(d.x-G.COURSES.cups[d.cupIndex])<.30&&d.cadence>1)d.cups++;d.cupIndex=ci;}\n c.bal.x=d.x;c.bal.y=0;G.animateContestant(ctx,c,dt);\n },\n result(ctx,c){const d=c.data;return {pct:clamp(.7*d.zone/Math.max(.01,ctx.time)+.3*d.cups/8,0,1),detail:Math.round(d.zone/Math.max(.01,ctx.time)*100)+'\"'% in pace · '+d.cups+'/8 water cups'};},\n fullDraw(r,ctx){const c=ctx.contestants[0],d=c.data,road=ctx.road;const cupZ=d.z+600+(ctx.duration/8-ctx.time%(ctx.duration/8))*600;\n road.draw(r,{z:d.z,x:d.x,h:650,cars:[{z:d.z+1100,x:-.23,w:100,draw(g,x,y,k){px.disc(g,x,y-140*k,25*k,'#ae7d5e');px.rect(g,x-22*k,y-120*k,44*k,73*k,'#5aafaa');px.line(g,x-12*k,y-50*k,x-20*k,y,'#506f77',10*k);px.line(g,x+12*k,y-50*k,x+20*k,y,'#506f77',10*k);}},{z:cupZ,x:G.COURSES.cups[Math.min(7,d.cupIndex)],w:70,draw(g,x,y,k){px.poly(g,[[x-24*k,y-42*k],[x+24*k,y-42*k],[x+17*k,y],[x-17*k,y]],'#fbfdf6');px.rect(g,x-18*k,y-34*k,36*k,8*k,'#8ed5e0');}},{z:d.z+1500,x:.7*Math.sin(ctx.time*.4),w:90,draw(g,x,y,k){px.ell(g,x,y-18*k,26*k,16*k,'#b5bfc1');px.disc(g,x+18*k,y-28*k,10*k,'#c8d1d0');}}]});\n G.drawRig(r,c.rig,0,25);r.overlay(g=>{G.round(g,13,r.H-58,118,33,'#ffffff');G.text(g,d.stitch>0?'A stitch. Slow down.':d.cadence<G.DEV.jogLow?'Catch Marisol':d.cadence>G.DEV.jogHigh?'A little gentler':'Beside Marisol',20,r.H-51,{color:G.palette.cyan});G.text(g,d.cadence.toFixed(1)+' steps / second',20,r.H-38);G.text(g,'J / K   alternate steps',r.W/2,r.H-13,{align:'center',color:G.palette.ink});});},draw(){},hud(){}\n};\n})();\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"cat > game/activities/step.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E;\nG.families.step={\n setup(ctx,c){const bpm=ctx.tier===2?120:100,clock={step:0,t:0,bpm,playing:true},dummy={time:0,audio:{pos:clock,sfx(){},music(){}},input:{pressed(){return false;},released(){return false;},down(){return false;}}};\n c.data={clock,dummy,stepAnim:0,judgment:'On the click'};\n const song={...G.SONGS[ctx.tier===2?'step2':'step'],loop:false,len:Math.ceil(ctx.duration*bpm/60*4)};\n c.data.rh=new E.Rhythm(dummy,{song,chart:G.CHARTS[ctx.tier-1],lanes:['stepL','stepD','stepU','stepR'],windows:{perfect:45*G.DEV.rhythmWindow,great:90*G.DEV.rhythmWindow,good:135*G.DEV.rhythmWindow},life:1,lead:2,on:{judge(j){c.data.stepAnim=.4;c.data.judgment=j==='miss'?'Next one':j==='perfect'?'Perfect':j==='great'?'Lovely':'Good';if(j\"'!=='\"'miss'&&G.context===ctx)G.game.audio.sfx('tick');},fail(rh){rh.life=.5;rh.done=false;rh.failed=false;}}});\n c.data.rh.notes=c.data.rh.notes.filter(n=>n.step<song.len);c.data.rh.started=true;\n },\n bot(ctx,c,dt,skill){const d=c.data,bpm=ctx.tier===2?120:100,step=ctx.time*bpm/60*4;c.intent.steps=[false,false,false,false];for(const n of d.rh.notes){if(n.j)continue;const offset=skill==='poor'?.10:skill==='average'?.065:skill==='good'?.022:.004;const skip=skill==='poor'?4:skill==='average'?11:9999;if(Math.floor(n.step)%skip===0&&skill\"'!=='\"'expert'&&skill\"'!=='\"'good')continue;if(step>=n.step+offset*bpm/60*4&&step<n.step+.14*bpm/60*4)c.intent.steps[n.lane]=true;}},\n update(ctx,c,dt){const d=c.data,bpm=ctx.tier===2?120:100;d.clock.t=ctx.time;d.clock.step=ctx.time*bpm/60*4;d.dummy.time=ctx.time;d.stepAnim=Math.max(0,d.stepAnim-dt);c.intent.steps.forEach((hit,i)=>{if(hit)d.rh.hit(i);else d.rh.release(i);});d.rh.update();c.bal.step(dt,c.intent,{noFalls:true});G.animateContestant(ctx,c,dt);},\n result(ctx,c){const rh=c.data.rh;return {pct:rh.counts.perfect+rh.counts.great+rh.counts.good+rh.counts.miss?rh.accuracy:0,detail:rh.maxCombo+' best streak · '+rh.counts.perfect+' perfect steps'};},\n draw(){},\n hud(r,ctx){if(ctx.contestants.length===1){const d=ctx.contestants[0].data;d.rh.draw(r,{x:r.W/2,y:r.H-22,dir:'down',len:53,gap:30,size:7,colors:['#3e98ae','#b293bc','#62af91','#e1ae5e'],arrows:true});r.overlay(g=>G.text(g,d.judgment,16,r.H-42,{color:G.palette.cyan}));}else ctx.contestants.forEach((c,i)=>c.data.rh.draw(r,{x:r.W/2+(i-(ctx.contestants.length-1)/2)*82,y:r.H-12,dir:'down',len:40,gap:13,size:4,arrows:true}));}\n};\n})();\nEOF\ncat > game/activities/hoop.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,{px,clamp}=E;\nG.families.hoop={\n setup(ctx,c){c.data={angle:0,lastAngle:null,speed:0,hoops:1,points:0,bad:0,caught:0,lastCatch:-1,toss:0,side:0};},\n bot(ctx,c,dt,skill){const dir=ctx.time<ctx.duration/2?1:-1,ang=ctx.time<ctx.duration/2?ctx.time*9:(ctx.duration-ctx.time)*9;const speed=skill==='poor'?.6:skill==='average'?.91:1;c.intent.x=Math.cos(ang*speed)*.8;c.intent.y=Math.sin(ang*speed)*.8;const hit=ctx.time%8<.05;c.intent.catchL=hit&&Math.floor(ctx.time/8)%2===1;c.intent.catchR=hit&&Math.floor(ctx.time/8)%2===0;c.intent.source='gamepad';},\n update(ctx,c,dt){const d=c.data,v=c.intent,angle=Math.atan2(v.y,v.x),diff=d.lastAngle===null?0:E.angDiff(d.lastAngle,angle);d.lastAngle=angle;d.angle+=diff;\n const raw=Math.abs(diff/dt);d.speed+=(raw-d.speed)*Math.min(1,dt*8);const keyboard=v.source==='keyboard',low=G.DEV.hoopLow*(keyboard?.6:1),high=(G.DEV.hoopHigh+(d.hoops-1)*.15)*(keyboard?.6:1),dir=ctx.time<ctx.duration/2?1:-1;\n const correct=diff*dir>=0&&Math.hypot(v.x,v.y)>.55&&d.speed>=low&&d.speed<=high;d.good=correct;\n if(correct){d.points+=(1+d.hoops*.2)*dt;d.bad=0;}else d.bad+=dt;\n if(d.bad>1.5&&d.hoops>1){d.hoops--;d.bad=0;}\n const toss=Math.round(ctx.time/8),window=Math.abs(ctx.time-toss*8);d.toss=window<1.3&&toss>0?1-window/1.3:0;d.side=toss%2?0:1;\n if(toss>0&&window<.25&&d.lastCatch\"'!==toss&&((d.side===0&&v.catchL)||(d.side===1&&v.catchR))){d.hoops=Math.min(6,d.hoops+1);d.caught++;d.lastCatch=toss;if(G.context===ctx)G.game.audio.sfx('\"'clink');}\n c.bal.step(dt,v,{noFalls:true});G.animateContestant(ctx,c,dt);\n },\n result(ctx,c){return {pct:clamp(c.data.points/(ctx.duration*1.65),0,1),detail:c.data.caught+' catches · '+c.data.hoops+' hoops at the finish'};},\n draw(r,ctx){for(const c of ctx.contestants){const p=r.w(c.worldX,c.worldY,22);for(let h=0;h<c.data.hoops;h++){const col=['#efb967','#e98b75','#8bc9b1','#8cbcd4','#ba9ecb','#d6c56d'][h];for(const front of [false,true])r.queue(c.worldX,c.worldY,22,g=>{const cy=p[1]+h*2-3;let prev=null;for(let i=0;i<=16;i++){const a=(front?0:Math.PI)+i/16*Math.PI,point=[p[0]+Math.cos(a)*19,p[1]+h*2+Math.sin(a)*5];if(prev)px.line(g,...prev,...point,col,2);prev=point;}},{bias:front?6:-6});}}},\n hud(r,ctx){const d=ctx.contestants[0].data;r.overlay(g=>{G.round(g,r.W/2-68,49,136,29,'#ffffff');G.text(g,ctx.time>ctx.duration/2?'Other way\"'!'\"':'Keep it circling',r.W/2,55,{align:'center',color:G.palette.cyan});G.text(g,d.good?'Just right':d.speed<6?'Too slow':'Too eager',r.W/2,67,{align:'center'});if(d.toss>.1)G.tag(g,(d.side===0?G.promptText('catchL','Catch left'):G.promptText('catchR','Catch right')),d.side===0?14:r.W-140,105);});}\n};\n})();\nEOF\ncat > game/activities/slalom.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,{px,clamp}=E;\nG.families.slalom={\n setup(ctx,c){c.data={x:0,z:0,gates:0,missed:0,penalty:0,next:0,tumble:0,finish:0};if(\"'!ctx.m7){ctx.m7=new E.Mode7({floor:(x,y)=>{const n=((Math.floor(x/60)+Math.floor(y/60))%2)?[234,244,245]:[219,234,237];return n;},size:[2000,16000],outside:'\"'#dfedf0',sky:['#90bfd5','#dcecf3'],far:1900,fog:ctx.tier===2?{color:'#c5d9e2',near:500,far:1800}:null});}},\n bot(ctx,c,dt,skill){const d=c.data,next=G.COURSES.gates[Math.min(17,d.next)],diff=next-d.x,quality=skill==='poor'?.55:skill==='average'?.85:1;c.intent.x=clamp(diff*.013*quality,-1,1);c.intent.y=skill==='poor'?0:skill==='average'?.25:.7;},\n update(ctx,c,dt){const d=c.data,v=c.intent;d.tumble=Math.max(0,d.tumble-dt);const speed=G.DEV.slalomSpeed*(v.y>0?1+v.y*.35:1+v.y*.4)*(d.tumble>0?.3:1);d.z+=speed*dt;d.x=clamp(d.x+v.x*G.DEV.slalomTurn*dt,-550,550);\n while(d.next<18&&d.z>340+d.next*G.COURSES.spacing){const target=G.COURSES.gates[d.next],width=ctx.tier===2?58:88;if(Math.abs(d.x-target)<width)d.gates++;else{d.missed++;d.penalty+=3;if(G.context===ctx)G.game.audio.sfx('creak');}d.next++;}\n if(Math.abs(d.x)>480&&d.tumble<=0){d.tumble=1.2;d.penalty+=1.2;d.x*=.88;}\n if(d.next>=18){d.finish=ctx.time;c.finished=true;}\n c.bal.x=v.x*.45;c.bal.y=v.y*.35;G.animateContestant(ctx,c,dt);\n ctx.m7.cam={x:d.x+1000,y:d.z-85,h:42,angle:Math.PI/2,pitch:13,fov:72};\n },\n result(ctx,c){const d=c.data,completion=d.gates/18,timeScore=clamp((G.COURSES.worst-(d.finish||ctx.time)-d.penalty)/(G.COURSES.worst-G.COURSES.par),0,1);return {pct:clamp(completion*(.7+.3*timeScore),0,1),detail:d.gates+'/18 gates · '+d.missed+' missed · +'+d.penalty.toFixed(0)+'s'};},\n fullDraw(r,ctx){const d=ctx.contestants[0].data,m=ctx.m7;for(let i=Math.max(0,d.next-1);i<18;i++){const y=340+i*G.COURSES.spacing,target=1000+G.COURSES.gates[i],w=ctx.tier===2?58:88;for(const s of [-1,1])m.add(target+s*w,y,0,(g,x,yy,k)=>{const h=32*k;px.line(g,x,yy,x,yy-h,'#4c8c9f',Math.max(1,k*2));px.poly(g,[[x,yy-h],[x+s*16*k,yy-h+4*k],[x,yy-h+11*k]],i%2?'#ed947d':'#62b9c2');});}\n for(let i=0;i<45;i++){const yy=i*300+130,xx=1000+(i%2?-560:560)+(i%3)*50;m.add(xx,yy,0,(g,x,y,k)=>{if(i%6===0){px.disc(g,x,y-8*k,8*k,'#ffffff');px.disc(g,x,y-20*k,5*k,'#ffffff');px.rect(g,x-6*k,y-27*k,12*k,3*k,'#7c9fae');}else{px.poly(g,[[x-15*k,y],[x,y-45*k],[x+15*k,y]],'#85afb1');px.poly(g,[[x-12*k,y-12*k],[x,y-45*k],[x+12*k,y-12*k]],'#eff8f7');}});}\n m.draw(r);r.overlay(g=>{const x=r.W/2,y=r.H-42;px.ell(g,x,y+2,24,5,'#adcbd4');px.line(g,x-12,y-2,x-20,y+8,'#d88872',3);px.line(g,x+12,y-2,x+20,y+8,'#d88872',3);});G.drawRig(r,ctx.contestants[0].rig,0,23);r.overlay(g=>{G.round(g,13,r.H-53,91,29,'#ffffff');G.text(g,d.gates+' / 18 gates',20,r.H-46,{color:G.palette.cyan});G.text(g,'+'+d.penalty.toFixed(0)+' seconds',20,r.H-35,{color:G.palette.muted});});},\n draw(){},hud(){}\n};\n})();\nEOF\ncat > game/activities/jog.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,{px,clamp}=E;\nG.families.jog={\n setup(ctx,c){c.data={x:0,z:0,cadence:0,steps:[],lastFoot:null,zone:0,cups:0,cupIndex:0,stitch:0,sprint:0,lastBeat:-1,pigeons:0};if(\"'!ctx.road){ctx.road=new E.Road({segment:150,width:1100,lanes:2,draw:110,height:650,fov:92,fog:{color:'\"'#cbeced',density:3},sky:new E.Backdrop({sky:['#9cdaed','#d5f1f0'],sun:{x:.8,y:.2,r:12,color:'#fff8cf'},layers:[{kind:'sea',color:'#65bec7',y:.43,height:.5}]}),colors:{road:['#e1d3b5','#e7d9bc'],grass:['#9bd1a6','#a8d4aa'],rumble:['#f1eee0','#e9e3c9'],lane:'#f5e9d0'}});ctx.road.add(70);ctx.road.add(70,{curve:1.4,hill:500});ctx.road.add(70,{curve:-1.2,hill:-500});ctx.road.add(70);for(let i=0;i<70;i++)ctx.road.place(i*550,i%2?1.5:-1.5,{w:140,draw(g,x,y,k){px.rect(g,x-6*k,y-40*k,12*k,40*k,'#ab9e7e');px.ell(g,x,y-53*k,30*k,16*k,'#87b99a');px.ell(g,x-12*k,y-61*k,17*k,13*k,'#abd1aa');}},1);}},\n bot(ctx,c,dt,skill){const d=c.data,beat=Math.floor(ctx.time*(skill==='poor'?2.1:skill==='average'?2.7:3)),hit=beat\"'!==d.lastBeat;d.lastBeat=beat;c.intent.paceL=hit&&beat%2===0;c.intent.paceR=hit&&beat%2===1;const target=G.COURSES.cups[Math.min(7,d.cupIndex)];c.intent.x=clamp((target-d.x)*2,-1,1);},\n update(ctx,c,dt){const d=c.data,v=c.intent;for(const [foot,hit]of [[0,v.paceL],[1,v.paceR]])if(hit&&d.lastFoot!==foot){d.lastFoot=foot;d.steps.push(ctx.time);}while(d.steps[0]<ctx.time-2)d.steps.shift();d.cadence=d.steps.length/2;\n const inZone=d.cadence>=G.DEV.jogLow&&d.cadence<=G.DEV.jogHigh;if(inZone)d.zone+=dt;if(d.cadence>4.2)d.sprint+=dt;else d.sprint=0;if(d.sprint>2){d.stitch=3;d.sprint=0;}d.stitch=Math.max(0,d.stitch-dt);\n d.x=clamp(d.x+v.x*dt*.8,-1,1);d.z+=Math.max(.15,d.cadence/3)*(d.stitch>0?.45:1)*600*dt*G.DEV.jogSpeed;\n const ci=Math.floor(ctx.time/(ctx.duration/8));if(ci>d.cupIndex&&d.cupIndex<8){if(Math.abs(d.x-G.COURSES.cups[d.cupIndex])<.30&&d.cadence>1)d.cups++;d.cupIndex=ci;}\n c.bal.x=d.x;c.bal.y=0;G.animateContestant(ctx,c,dt);\n },\n result(ctx,c){const d=c.data;return {pct:clamp(.7*d.zone/Math.max(.01,ctx.time)+.3*d.cups/8,0,1),detail:Math.round(d.zone/Math.max(.01,ctx.time)*100)+'\"'% in pace · '+d.cups+'/8 water cups'};},\n fullDraw(r,ctx){const c=ctx.contestants[0],d=c.data,road=ctx.road;const cupZ=d.z+600+(ctx.duration/8-ctx.time%(ctx.duration/8))*600;\n road.draw(r,{z:d.z,x:d.x,h:650,cars:[{z:d.z+1100,x:-.23,w:100,draw(g,x,y,k){px.disc(g,x,y-140*k,25*k,'#ae7d5e');px.rect(g,x-22*k,y-120*k,44*k,73*k,'#5aafaa');px.line(g,x-12*k,y-50*k,x-20*k,y,'#506f77',10*k);px.line(g,x+12*k,y-50*k,x+20*k,y,'#506f77',10*k);}},{z:cupZ,x:G.COURSES.cups[Math.min(7,d.cupIndex)],w:70,draw(g,x,y,k){px.poly(g,[[x-24*k,y-42*k],[x+24*k,y-42*k],[x+17*k,y],[x-17*k,y]],'#fbfdf6');px.rect(g,x-18*k,y-34*k,36*k,8*k,'#8ed5e0');}},{z:d.z+1500,x:.7*Math.sin(ctx.time*.4),w:90,draw(g,x,y,k){px.ell(g,x,y-18*k,26*k,16*k,'#b5bfc1');px.disc(g,x+18*k,y-28*k,10*k,'#c8d1d0');}}]});\n G.drawRig(r,c.rig,0,25);r.overlay(g=>{G.round(g,13,r.H-58,118,33,'#ffffff');G.text(g,d.stitch>0?'A stitch. Slow down.':d.cadence<G.DEV.jogLow?'Catch Marisol':d.cadence>G.DEV.jogHigh?'A little gentler':'Beside Marisol',20,r.H-51,{color:G.palette.cyan});G.text(g,d.cadence.toFixed(1)+' steps / second',20,r.H-38);G.text(g,'J / K   alternate steps',r.W/2,r.H-13,{align:'center',color:G.palette.ink});});},draw(){},hud(){}\n};\n})();\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_36","type":"agent_message","text":"The activity systems now cover balance holds, breathing, slow strength reps, stepping, hoop circles, jogging cadence, and slalom steering. I’m finishing the tray and clothesline activities, then I’ll test scoring bands and the full retreat flow.\n"}}
{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"cat > game/activities/tray.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,{px,clamp}=E;\nG.trayLayout=(ctx,c,index)=>{\n const d=c.data,rows=G.TRAYS[index],cell=12;d.tray=index;d.olives=[];d.glasses=[];d.bumpers=[];d.pending=[];d.lost=0;d.width=rows[0].length*cell;d.height=rows.length*cell;\n d.world=new E.Physics({gravity:[0,0],substeps:3,iterations:6,sleep:false,on:{enter(sensor,body){if(sensor.data?.kind==='glass'&&body.data?.kind==='olive'&&\"'!body.off&&!sensor.off){body.off=true;sensor.off=true;d.collected++;d.pending.push(body);if(G.context===ctx)G.game.audio.sfx('\"'plop');}}}});\n const W=d.width,H=d.height;d.world.chain([[6,6],[W-6,6],[W-6,H-6],[6,H-6],[6,6]],{r:2,bounce:.25,friction:.2});\n rows.forEach((row,y)=>[...row].forEach((ch,x)=>{const xx=x*cell+6,yy=y*cell+6;if(ch==='o')d.olives.push(d.world.circle(xx,yy,3,{bounce:.25,damping:G.DEV.friction,friction:.2,maxSpeed:120,bullet:true,data:{kind:'olive'}}));if(ch==='g')d.glasses.push(d.world.circle(xx,yy,7,{sensor:true,type:'static',data:{kind:'glass'}}));if(ch==='B'){const b=d.world.circle(xx,yy,7,{type:'static',bounce:.6});d.bumpers.push(b);}if(ch==='L')d.gecko=d.world.box(xx,yy,15,5,{type:'kinematic',bounce:.4,data:{kind:'gecko'}});}));\n};\nG.families.tray={\n setup(ctx,c){c.data={collected:0,total:15,tray:0};G.trayLayout(ctx,c,0);ctx.trayView=new E.View('tray','Tray',0,55,1,1);},\n bot(ctx,c,dt,skill){const d=c.data,o=d.olives.find(o=>\"'!o.off),gl=d.glasses.filter(g=>!g.off);if(!o||!gl.length){c.intent.x=c.intent.y=0;return;}const target=gl.reduce((a,b)=>Math.hypot(b.x-o.x,b.y-o.y)<Math.hypot(a.x-o.x,a.y-o.y)?b:a,gl[0]);const q=skill==='\"'poor'?.5:skill==='average'?.8:1;let tx=target.x,ty=target.y;\n  const block=d.bumpers.find(b=>Math.hypot(b.x-o.x,b.y-o.y)<23&&Math.abs(b.x-o.x)<10&&b.y>o.y);if(block){tx=block.x+(o.x<d.width/2?-19:19);ty=block.y-4;}\n  c.intent.x=clamp(((tx-o.x)*.035-o.vx*.065)*q,-.75,.75);c.intent.y=-clamp(((ty-o.y)*.035-o.vy*.065)*q,-.75,.75);\n },\n update(ctx,c,dt){const d=c.data,b=c.bal;b.step(dt,c.intent,{noFalls:true});d.world.gravity=[b.x*G.DEV.gravity,-b.y*G.DEV.gravity];for(const o of d.olives)o.damping=G.DEV.friction;d.world.wake();if(d.gecko){d.gecko.vx=Math.cos(ctx.time*.7)*9;d.gecko.x=d.width*.5+Math.sin(ctx.time*.7)*18;}\n  d.world.step(dt);for(const o of d.pending)d.world.remove(o);d.pending=[];\n  if(d.olives.every(o=>o.off)){if(d.tray<2){G.trayLayout(ctx,c,d.tray+1);b.x=b.y=b.vx=b.vy=0;}else c.finished=true;}\n  G.animateContestant(ctx,c,dt);\n },\n result(ctx,c){const d=c.data;return {pct:d.collected/15*(.8+.2*Math.max(0,1-ctx.time/ctx.duration)),detail:d.collected+'/15 olives · tray '+(d.tray+1)+' of 3'};},\n fullDraw(r,ctx){const c=ctx.contestants[0],d=c.data,b=c.bal;G.studio(r,'bar');const W=Math.min(r.W-66,280),H=Math.min(126,r.H-90),cx=r.W/2,cy=r.H*.54;\n  const to=(x,y,z=0)=>{const xx=(x/d.width-.5)*W,yy=(y/d.height-.5)*H;return [cx+xx,cy+yy+xx*b.x*.09+yy*b.y*.18-z];};\n  r.overlay(g=>{const corners=[[0,0],[d.width,0],[d.width,d.height],[0,d.height]].map(p=>to(...p));px.poly(g,corners.map(p=>[p[0]+3,p[1]+5]),'#7ba1a5');px.poly(g,corners,'#cdb38a');const inner=[[4,4],[d.width-4,4],[d.width-4,d.height-4],[4,d.height-4]].map(p=>to(...p));px.poly(g,inner,'#f0dcc0');for(let i=0;i<4;i++){const a=corners[i],bb=corners[(i+1)%4];px.line(g,...a,...bb,'#b69668',3);}\n   for(const o of d.bumpers){const p=to(o.x,o.y);px.ell(g,...p,8,6,'#b3a799');px.ell(g,p[0]-1,p[1]-2,6,4,'#e8e4d7');}\n   for(const gl of d.glasses){const p=to(gl.x,gl.y);px.line(g,p[0],p[1],p[0],p[1]+8,'#9eaba3',1);px.ell(g,p[0],p[1]+8,6,2,'#b5b4a1');px.poly(g,[[p[0]-8,p[1]-6],[p[0]+8,p[1]-6],[p[0],p[1]+2]],gl.off?'#b2c79b':'#e8f3eb');px.line(g,p[0]-8,p[1]-6,p[0]+8,p[1]-6,'#7bb5b9');if(gl.off)px.disc(g,p[0],p[1]-4,3,'#8c9b50');}\n   for(const o of d.olives){if(o.off)continue;const p=to(o.x,o.y,3);px.ell(g,p[0]+1,p[1]+4,4,2,'#c4b78e');px.disc(g,p[0],p[1],4,'#75854a');px.disc(g,p[0]-1,p[1]-1,2,'#a7b774');px.dot(g,p[0]+1,p[1]+1,'#c77d58');}\n   if(d.gecko){const p=to(d.gecko.x,d.gecko.y,2);px.ell(g,p[0],p[1],9,3,'#87a38c');px.disc(g,p[0]+9,p[1]-1,3,'#aac19a');for(const s of [-1,1])for(const x of [-5,4])px.line(g,p[0]+x,p[1],p[0]+x+2,p[1]+s*6,'#748e7d');px.line(g,p[0]-8,p[1],p[0]-18,p[1]+3,'#87a38c',2);}\n   G.round(g,14,r.H-40,99,22,'#ffffff');G.text(g,d.collected+' / 15 olives',21,r.H-33,{color:G.palette.cyan});G.text(g,'Tray '+(d.tray+1)+' / 3',r.W-18,54,{align:'right',color:G.palette.muted});G.drawPlate(g,r.W/2,r.H-24,b,17);\n  });\n },draw(){},hud(){}\n};\n})();\nEOF\ncat > game/activities/laundry.js <<'EOF'\n(() => {\nconst G=window.G,E=G.E,{px,clamp}=E;\nG.families.laundry={\n setup(ctx,c){c.data={progress:0,post:0,air:0,peg:0,gustSign:ctx.rng()<.5?-1:1,gust:false,warning:false,penalty:0,fallTimer:0};c.bal.params.s=G.DEV.rope;},\n bot(ctx,c,dt,skill){G.balanceBot(c,skill,dt);c.intent.y=0;c.intent.effort=skill==='poor'?.35:skill==='average'?.5:.65;const next=G.COURSES.pegs[c.data.peg];c.intent.jump=next\"'!==undefined&&c.data.progress>next-.018&&c.data.progress<next+.01;},\n update(ctx,c,dt){const d=c.data,b=c.bal,v=c.intent,t=ctx.time,period=t%7;d.warning=period>4.2&&period<5;d.gust=period>=5&&period<5.6;\n if(v.jump&&d.air<=0){d.air=.7;if(G.context===ctx)G.game.audio.sfx('\"'boop');}d.air=Math.max(0,d.air-dt);\n if(d.fallTimer>0)d.fallTimer-=dt;else if(d.air<=0){b.y=b.vy=0;b.step(dt,{...v,y:0},{s:G.DEV.rope+v.effort*4,fx:d.gust?d.gustSign*G.DEV.gust:0,noFalls:ctx.cheat,fall:()=>{d.fallTimer=1;d.progress=Math.floor(d.progress*3)/3;d.penalty+=3;}});}\n if(d.fallTimer<=0)d.progress+=v.effort*dt/(ctx.duration*.52);\n if(d.progress>=(d.peg<3?G.COURSES.pegs[d.peg]:2)){if(d.air<=0){d.progress=Math.max(0,d.progress-.025);d.penalty+=1;}d.peg++;}\n d.post=Math.floor(d.progress*3);if(d.progress>=1)c.finished=true;G.animateContestant(ctx,c,dt);c.rig.mocap=G.lib.sample('Walk_Loop',t*(v.effort+.2));\n },\n result(ctx,c){return {pct:clamp(c.data.progress-.06*c.bal.falls-c.data.penalty*.005,0,1),detail:Math.min(3,c.data.post)+'/3 spans · '+c.bal.falls+' hamper visits'};},\n fullDraw(r,ctx){const c=ctx.contestants[0],d=c.data;G.studio(r,'laundry');const y=r.H*.59,x0=25,x1=r.W-25;r.overlay(g=>{px.rect(g,0,y+45,r.W,r.H-y-45,'#b9cfa7');for(let i=0;i<4;i++){const x=x0+(x1-x0)*i/3;px.rect(g,x-3,y-3,6,65,'#bea17d');px.rect(g,x-3,y-3,2,65,'#e5cba2');}\n for(let i=0;i<80;i++){const u=i/79,x=x0+(x1-x0)*u,yy=y+Math.abs(Math.sin(u*3*Math.PI))*4;px.dot(g,x,yy,'#728d8e');px.dot(g,x,yy+1,'#a9c0bb');}\n for(let i=0;i<7;i++){const x=x0+(i+.6)/7*(x1-x0),yy=y+10;if(i%2){px.poly(g,[[x-5,yy],[x+5,yy],[x+7,yy+18],[x-7,yy+18]],['#f3d8bd','#e6b9a9','#c5dfd9'][i%3]);}else{px.rect(g,x-5,yy,10,20,'#f8eee0');px.rect(g,x,yy+14,10,6,'#f8eee0');}}\n for(const p of G.COURSES.pegs){px.rect(g,x0+p*(x1-x0)-1,y-4,3,8,'#d3a765');}if(d.warning||d.gust){for(let i=0;i<6;i++)px.line(g,20+i*43,y-50+(i%3)*9,45+i*43,y-50+(i%3)*9,'#8ebdc5');G.text(g,d.warning?'A sock. A warning.':'Gust\"'!'\"',r.W/2,57,{align:'center',color:G.palette.cyan});}G.drawGerald(g,35,y+57,.8);});\n const xx=x0+clamp(d.progress,0,1)*(x1-x0),zz=d.air>0?Math.sin(d.air/.7*Math.PI)*28:0,wx=(xx-r.W/2)/r.ppu;G.drawRig(r,c.rig,wx,0,zz);r.overlay(g=>{G.text(g,'Please do not walk on the laundry line.',14,r.H-49,{color:G.palette.muted});G.text(g,'Walking on the laundry line: 10:30 daily.',14,r.H-38,{color:G.palette.muted});G.drawPlate(g,r.W/2,r.H-22,c.bal,17);});\n },draw(){},hud(){}\n};\n})();\nEOF\nnode build.mjs\nnode - <<'JS'\nconst fs=require('fs'),vm=require('vm');const ctx={console,performance,Date,Math,setTimeout,clearTimeout,location:{hash:''},addEventListener(){},requestAnimationFrame(){return 0},cancelAnimationFrame(){}};ctx.window=ctx;ctx.globalThis=ctx;vm.createContext(ctx);const ss=JSON.parse(fs.readFileSync('scripts.json'));for(const f of ss.filter(f=>f\"'!=='\"'game/main.js'))try{vm.runInContext(fs.readFileSync(f,'utf8'),ctx,{filename:f});}catch(e){console.log(f,e.stack);process.exit(1);}const G=ctx.G;G.finishRegistry();for(const skill of ['passive','average','good','expert']){const c=G.makeContext('stork',1,{seed:3});for(let i=0;i<45*120;i++)G.stepContext(c,1/120,skill);console.log(skill,c.a.result(c,c.contestants[0]));}console.log('errors',G.game.errors);\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
