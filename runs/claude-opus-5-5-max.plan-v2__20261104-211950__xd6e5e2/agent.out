layers.forEach((p) => (S.score[p.id] = 0));   if (info) {     H.on('\"'\"'message'\"'\"', (d, from) => { S.got++; if (isHost && d.t === '\"'\"'me'\"'\"') { if (pos[from]) { pos[from].x = d.x; pos[from].z = d.z; S.score[from] += 1; } } });     H.on('\"'\"'leave'\"'\"', ({ id }) => { delete pos[id]; });     H.on('\"'\"'time-up'\"'\"', () => { if (isHost) finish(); });     H.on('\"'\"'end'\"'\"', () => { S.ended = true; mark('\"'\"'end'\"'\"'); });     H.on('\"'\"'start'\"'\"', () => mark('\"'\"'start'\"'\"'));     H.ready(); mark('\"'\"'ready'\"'\"');   }   let finished = false;   function finish() { if (finished) return; finished = true; const ids = Object.keys(pos).map(Number); H.finish({ standings: [ids], won: true, scores: S.score }); mark('\"'\"'finish'\"'\"'); }   // sim + net on a timer, never on rAF   let last = 0;   setInterval(() => {     S.ticks++;     world.step();     if (!info || H.time() < 0) return;     const now = performance.now();     if (now - last < 100) return;     last = now;     if (isHost) { if (H.send({ t: '\"'\"'s'\"'\"', at: Math.round(H.time()), p: pos }, { reliable: false })) S.sent++; }     else if (!server && H.send({ t: '\"'\"'me'\"'\"', x: Math.random() * 10 | 0, z: 0 }, { to: info.host, reliable: false })) S.sent++;   }, 16);   if (server) { mark('\"'\"'server-no-render'\"'\"'); return; }   // render, never awaited by the protocol path above   const renderer = new THREE.WebGPURenderer({ antialias: false, forceWebGL: q.get('\"'\"'backend'\"'\"') === '\"'\"'webgl2'\"'\"' });   renderer.setPixelRatio(1); renderer.setSize(innerWidth, innerHeight); renderer.shadowMap.enabled = true;   document.body.append(renderer.domElement);   await renderer.init(); mark('\"'\"'renderer'\"'\"');   S.backend = renderer.backend.isWebGPUBackend ? '\"'\"'webgpu'\"'\"' : '\"'\"'webgl2'\"'\"';   const scene = new THREE.Scene(); scene.background = new THREE.Color(0x05040a);   const cam = new THREE.PerspectiveCamera(30, innerWidth / innerHeight, 1, 300); cam.position.set(0, 26, 22); cam.lookAt(0, 1, 0);   const moon = new THREE.DirectionalLight(0x8fa3d8, 1.1); moon.position.set(-14, 30, 10); moon.castShadow = true; moon.shadow.mapSize.set(1024, 1024);   Object.assign(moon.shadow.camera, { left: -30, right: 30, top: 30, bottom: -30, near: 1, far: 80 });   scene.add(moon, new THREE.HemisphereLight(0x39415e, 0x140c08, 0.8));   for (let i = 0; i < 16; i++) { const l = new THREE.PointLight(0xffa64a, 60, 14, 2); l.position.set(Math.cos(i * 2.4) * (6 + i), 2.6, Math.sin(i * 2.4) * (6 + i)); scene.add(l); }   const bands = new THREE.DataTexture(new Uint8Array([40, 110, 200, 255]), 4, 1, THREE.RedFormat); bands.minFilter = bands.magFilter = THREE.NearestFilter; bands.needsUpdate = true;   const toon = (c) => new THREE.MeshToonNodeMaterial({ color: c, gradientMap: bands });   const floor = new THREE.Mesh(new THREE.PlaneGeometry(120, 120), toon(0x4a4640)); floor.rotation.x = -Math.PI / 2; floor.receiveShadow = true; scene.add(floor);   const pillars = new THREE.InstancedMesh(new THREE.CylinderGeometry(0.55, 0.7, 7, 10), toon(0x6c6458), 80); const m = new THREE.Matrix4();   for (let k = 0; k < 80; k++) { m.makeTranslation(((k * 37) % 56) - 28, 3.5, ((k * 53) % 56) - 28); pillars.setMatrixAt(k, m); } pillars.castShadow = true; scene.add(pillars);   const crowd = []; for (let e = 0; e < 40; e++) { const c = new THREE.Mesh(new THREE.BoxGeometry(0.7, 2, 0.5), toon(0x7c2a22 + e * 8)); c.position.set(Math.cos(e) * (3 + e * 0.3), 1, Math.sin(e) * (3 + e * 0.3)); c.castShadow = true; scene.add(c); crowd.push(c); }   const post = new THREE.PostProcessing(renderer);   const sp = pass(scene, cam); sp.setMRT(mrt({ output, normal: normalView }));   const col = sp.getTextureNode('\"'\"'output'\"'\"'), nor = sp.getTextureNode('\"'\"'normal'\"'\"');   const ink = Fn(() => { const p = uv(), w = vec2(1.25).div(screenSize); const c = col.sample(p); const e = smoothstep(0.35, 0.7, length(nor.sample(p.add(w)).xyz.sub(nor.sample(p.sub(w)).xyz))); return vec4(mix(c.rgb, vec3(0.03), e), 1); });   post.outputNode = ink().add(bloom(col, 0.5, 0.4, 0.8));   let lastF = performance.now();   function frame() {     const now = performance.now();     const dt = now - lastF; lastF = now;     S.maxFrameGap = Math.max(S.maxFrameGap || 0, dt);     for (const c of crowd) c.rotation.y += 0.02;     post.render();     S.frames++;     if (S.frames === 1) mark('\"'\"'firstFrame'\"'\"');     if (!S.ended) requestAnimationFrame(frame);   }   requestAnimationFrame(frame); } boot().catch((e) => { console.error(e); H.fail(String(e)); }); EOF HEAD='\"'\"'<meta name=\"hub:session\" content=\"1\"> <meta name=\"hub:session-players\" content=\"1-4\"> <meta name=\"hub:session-mode\" content=\"shared-world\"> <meta name=\"hub:session-minutes\" content=\"10\"> <meta name=\"hub:session-goal\" content=\"Silence the Bell together before time runs out\"> <meta name=\"hub:session-howto\" content=\"Move: stick, arrows or click. Skills: face buttons or 1-4. Potion: L1 or Q\">'\"'\"' node build.mjs harness_game.js hgame.html \"$HEAD\" 2>&1 | tail -1 cat > hubrun.py <<'\"'\"'EOF'\"'\"' import sys, os, json, time, subprocess, signal from playwright.sync_api import sync_playwright # hub-check'\"'\"'s flags: its default launch, optionally plus WebGPU base=['\"'\"'--no-sandbox'\"'\"','\"'\"'--autoplay-policy=no-user-gesture-required'\"'\"'] webgpu=['\"'\"'--enable-unsafe-webgpu'\"'\"','\"'\"'--enable-features=Vulkan'\"'\"','\"'\"'--use-vulkan=swiftshader'\"'\"','\"'\"'--use-webgpu-adapter=swiftshader'\"'\"','\"'\"'--use-angle=swiftshader'\"'\"'] srv=subprocess.Popen(['\"'\"'python3'\"'\"','\"'\"'-m'\"'\"','\"'\"'http.server'\"'\"','\"'\"'0'\"'\"','\"'\"'--bind'\"'\"','\"'\"'127.0.0.1'\"'\"'],stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,bufsize=1) line=srv.stdout.readline(); port=int(line.split('\"'\"'port '\"'\"')[1].split('\"'\"' '\"'\"')[0]) game=sys.argv[1] modes=sys.argv[2].split('\"'\"','\"'\"') if len(sys.argv)>2 else ['\"'\"'gl'\"'\"','\"'\"