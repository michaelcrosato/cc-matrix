 or no last line');\n  return { version: found.version, hash: found.hash, text: lf(source.slice(found.start, found.end)) };\n}\n\n/**\n * Replace every pristine client older than `current` with it, keeping the\n * file's own line endings. Returns the new text and what happened to each copy.\n */\nexport function upgradeText(text, current) {\n  const copies = findClients(text);\n  const crlf = text.includes('\\r\\n');\n  const replacement = crlf ? current.text.replace(/\\n/g, '\\r\\n') : current.text;\n  let out = '';\n  let at = 0;\n  const report = [];\n  for (const copy of copies) {\n    let action = 'kept';\n    if (!copy.complete || !copy.pristine) action = 'edited';\n    else if (compareVersions(copy.version, current.version) < 0) action = 'upgraded';\n    else if (compareVersions(copy.version, current.version) > 0) action = 'newer';\n    report.push({ version: copy.version, action });\n    if (action !== 'upgraded') continue;\n    out += text.slice(at, copy.start) + replacement;\n    at = copy.end;\n  }\n  out += text.slice(at);\n  return { text: out, copies: report, changed: report.some((r) => r.action === 'upgraded') };\n}\n\n=====LIB\nfile\t3247\tlib/README.md\ndir\t0\tlib/hub\ndir\t0\tlib/kit\ndir\t0\tlib/rapier\nfile\t491\tlib/three-addons.exclude\ndir\t0\tlib/three\ndir\t0\tlib/vendor\n=====KIT\nfile\t34975\tlib/kit/README.md\nfile\t15976\tlib/kit/boot.js\nfile\t7332\tlib/kit/example.html\nfile\t21377\tlib/kit/input.js\nfile\t5392\tlib/kit/instancing.js\nfile\t2409\tlib/kit/loop.js\nfile\t2655\tlib/kit/physics.js\nfile\t2425\tlib/kit/points.js\nfile\t2638\tlib/kit/post.js\nfile\t5045\tlib/kit/renderer.js\nfile\t1959\tlib/kit/retro.js\nfile\t8225\tlib/kit/settings.js\nfile\t11862\tlib/kit/touch.js\nfile\t21549\tlib/kit/ui.js\n=====COUCH\nfile\t2486\tcouch/index.html\n=====DOCS\nfile\t27147\tdocs/curation-2026-09-24.md\nfile\t8315\tdocs/curation-2026-09-28-new-ai-stuff.md\nfile\t35062\tdocs/curation-2026-09-28.md\nfile\t9480\tdocs/curation-2026-10-28.md\nfile\t5119\tdocs/import-registry.md\ndir\t0\tdocs/imports\nfile\t36346\tdocs/multiplayer-plan.md\nfile\t14037\tdocs/session-hub.md\ndir\t0\tdocs/superpowers\n=====CLAUDE\n# Working in this repo\n\n## Finish every change on main\n\n- When a `/goal` is complete, or a prompt has changed the repo, commit and\n  push to `origin/main` right away.\n- Pushing does not deploy. Vercel usage costs too much to build every\n  change, so Git deploys are off (`\"git\": { \"deploymentEnabled\": false }`\n  in `vercel.json`) and the site runs locally: `pnpm dev`, then\n  http://127.0.0.1:7417. Deploy to Vercel only when Michael explicitly asks,\n  for a major update: push with `deploymentEnabled` set to `true` (that push\n  deploys; check it reaches READY), then set it back to `false` in the next\n  commit, which does not deploy.\n- Work on `main`. If a branch is ever needed, merge it into main and delete\n  it (locally and on GitHub) in the same session. Never leave a local\n  branch, an unpushed commit, a stash, or an open PR behind.\n- Before starting work, run `git fetch --prune` and look at\n  `gh pr list`. Anything open gets resolved first.\n\n## Pull requests from others\n\nDecide each one; do not let it sit. Accept it (merge to main, delete the\nbranch), reject it (close it with a one-line reason), or replace it (close\nit, and land a better version on main that says which PR it replaces).\n\n## Keep it simple and clean\n\n- No dependencies, no build step, no generated files committed\n  (`data/games.json` is gitignored and rebuilt by `scripts/scan.mjs`).\n- Run `pnpm test` (or `node --test \"scripts/**/*.test.mjs\"`) before\n  committing code.\n- Delete what is no longer used instead of leaving it around.\n\n## When something goes wrong\n\nRoll back rather than leave half-finished work. Revert the commit\n(`git revert`) or restore the last good state and push that, so main is\nalways a working wall. Say what was rolled back and why.","stderr":"","interrupted":false,"isImage"