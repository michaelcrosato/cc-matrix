await measure('turn it off again', async () => { lights[2].castShadow = false; });\n  await measure('add plain mesh with same material', async () => { const b = new THREE.Mesh(new THREE.BoxGeometry(1, 1, 1), sharedBox); b.position.set(2, 1, 2); scene.add(b); });\n  await measure('add 2nd mesh, same material', async () => { const b = new THREE.Mesh(new THREE.BoxGeometry(1, 2, 1), sharedBox); b.position.set(4, 1, 2); scene.add(b); });\n  await measure('add mesh, new material, same structure', async () => { const b = new THREE.Mesh(new THREE.BoxGeometry(1, 1, 1), toon(0x22aa66)); b.position.set(6, 1, 2); scene.add(b); });\n  await measure('add first InstancedMesh', async () => { const im = new THREE.InstancedMesh(new THREE.BoxGeometry(0.5, 0.5, 0.5), sharedBox, 50); const m = new THREE.Matrix4(); for (let i = 0; i < 50; i++) { m.makeTranslation((i % 10) - 5, 0.3, 5 + ((i / 10) | 0)); im.setMatrixAt(i, m); } scene.add(im); R.im1 = im; });\n  await measure('add 2nd InstancedMesh, same material', async () => { const im = new THREE.InstancedMesh(new THREE.BoxGeometry(0.4, 0.8, 0.4), sharedBox, 50); const m = new THREE.Matrix4(); for (let i = 0; i < 50; i++) { m.makeTranslation((i % 10) - 5, 0.3, -5 - ((i / 10) | 0)); im.setMatrixAt(i, m); } scene.add(im); });\n  await measure('clone a skinned mesh, shared material', async () => { const c = skeletonClone(a); c.position.set(3, 0, 0); scene.add(c); });\n  await measure('clone skinned, own material, same structure', async () => { const c = skeletonClone(a); c.material = toon(0x3355aa); c.position.set(5, 0, 0); scene.add(c); R.c2 = c; });\n  await measure('20 more skinned, own materials', async () => { for (let i = 0; i < 20; i++) { const c = skeletonClone(a); c.material = toon(0x115500 + i * 40); c.position.set(-8 + i, 0, -3); scene.add(c); } });\n  await measure('toggle material.transparent on one', async () => { R.c2.material.transparent = true; R.c2.material.opacity = 0.5; R.c2.material.needsUpdate = true; });\n  // hit flash + rim + dissolve via uniforms: one structure, per-object values\n  const flash = uniform(0); const heroUV = uniform(new THREE.Vector2(0.5, 0.5));\n  const fancy = toon(0xaa8844);\n  const rim = float(1).sub(dot(normalView, positionViewDirection).max(0)).pow(3);\n  fancy.emissiveNode = tslColor(0xff3322).mul(flash).add(tslColor(0xffd9a0).mul(rim).mul(0.35));\n  await measure('add mesh with rim + flash emissiveNode', async () => { const b = new THREE.Mesh(new THREE.SphereGeometry(1, 16, 12), fancy); b.position.set(-6, 1, 3); scene.add(b); });\n  await measure('change flash uniform', async () => { flash.value = 1; });\n  // wall cut-out: discard a dithered circle around the hero on screen\n  const wall = toon(0x777777);\n  wall.maskNode = Fn(() => { const d = length(screenUV.sub(heroUV).mul(vec2(16 / 9, 1))); const noise = interleavedGradientNoise(screenCoordinate); return d.sub(0.08).div(0.08).greaterThan(noise); })();\n  await measure('add wall with dithered maskNode', async () => { const b = new THREE.Mesh(new THREE.BoxGeometry(14, 6, 0.6), wall); b.position.set(0, 3, 6); scene.add(b); });\n  // boil an instanced dissolve on a node\n  R.pipelines = made;\n  R.renderInfo = { calls: renderer.info.render.calls, tris: renderer.info.render.triangles };\n  R.shot = () => { renderer.render(scene, cam); return renderer.domElement.toDataURL('image/png'); };\n  R.done = true;\n})().catch((e) => { R.errors.push('main: ' + (e.stack || e)); R.done = true; });\nEOF\nnode build.mjs main2.js spike2.html 2>&1 | tail -2; grep -n \"interleavedGradientNoise\" node_modules/three/build/three.tsl.js | head -2; cut -c1-300 hub.log | tail -30","description":"Prepare pipeline-cost spike and check harness log so far","timeout":120000}}}
