      for n,sc in cases:         ctx=b.new_context(viewport={'\"'\"'width'\"'\"':1280,'\"'\"'height'\"'\"':860})         pg=ctx.new_page()         warns=[];errs=[]         pg.on('\"'\"'console'\"'\"',lambda m:(m.text.startswith('\"'\"'[AIHub]'\"'\"') and warns.append(m.text[:160])))         pg.on('\"'\"'pageerror'\"'\"',lambda e:errs.append(str(e)[:200]))         t=time.time()         pg.goto(f'\"'\"'http://127.0.0.1:{port}/harness.html?game={game}&players={n}&latency=150&jitter=50&loss=5&auto=1&scenario={sc}&play=8000'\"'\"')         done=True         try: pg.wait_for_selector('\"'\"'body[data-complete=\"true\"]'\"'\"',timeout=300000)         except Exception as e: done=False         rep=pg.evaluate(\"()=>window.__hubCheck&&({pass:window.__hubCheck.pass,fails:window.__hubCheck.checks.filter(c=>!c.pass).map(c=>c.name+'\"'\"' -- '\"'\"'+c.detail),n:window.__hubCheck.checks.length})\")         stats=pg.evaluate(\"\"\"()=>[...document.querySelectorAll('\"'\"'iframe'\"'\"')].map(f=>{try{const g=f.contentWindow.__g;return g?{b:g.backend,m:g.marks,fr:g.frames,tk:g.ticks,sent:g.sent,got:g.got,gap:Math.round(g.maxFrameGap||0)}:null}catch(e){return '\"'\"'x'\"'\"'}})\"\"\")         print(f\"[{mode}] {n}p {sc}: pass={rep and rep['\"'\"'pass'\"'\"']} done={done} {round(time.time()-t)}s warns={warns[:2]} errs={errs[:2]}\")         if rep and rep['\"'\"'fails'\"'\"']: print('\"'\"'   FAILS'\"'\"',rep['\"'\"'fails'\"'\"'])         for s in stats: print('\"'\"'   '\"'\"',json.dumps(s))         ctx.close()       b.close() finally:   srv.send_signal(signal.SIGTERM); srv.wait(timeout=5) EOF python3 hubrun.py hgame.html gl,gpu 2>&1 | tail -60' && pwd -P >| /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211950__xd6e5e2/tmp/claude-36a8-cwd\n3680799 python3 hubrun.py hgame.html gl,gpu\n3750805 /bin/bash -c source /home/micha/.claude/shell-snapshots/snapshot-bash-1793852394135-z5mk43.sh 2>/dev/null || true && shopt -u extglob 2>/dev/null || true && { \\builtin unalia