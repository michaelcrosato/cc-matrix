.set(-0.2, -0.05, 0); root.add(legL);\n  const bones = [root, spine, head, armR, armL, legR, legL];\n  root.updateMatrixWorld(true);\n  const part = (geo, x, y, z, boneIdx) => {\n    geo.translate(x, y, z);\n    const n = geo.attributes.position.count;\n    const si = new Uint16Array(n * 4), sw = new Float32Array(n * 4);\n    for (let i = 0; i < n; i++) { si[i * 4] = boneIdx; sw[i * 4] = 1; }\n    geo.setAttribute('skinIndex', new THREE.Uint16BufferAttribute(si, 4));\n    geo.setAttribute('skinWeight', new THREE.Float32BufferAttribute(sw, 4));\n    return geo.index ? geo.toNonIndexed() : geo;\n  };\n  const geo = mergeGeometries([\n    part(new RoundedBoxGeometry(0.5, 0.4, 0.3, 2, 0.06), 0, 1.0, 0, 0),\n    part(new RoundedBoxGeometry(0.7, 0.6, 0.4, 2, 0.06), 0, 1.55, 0, 1),\n    part(new RoundedBoxGeometry(0.34, 0.36, 0.34, 2, 0.08), 0, 2.08, 0, 2),\n    part(new RoundedBoxGeometry(0.18, 0.75, 0.18, 2, 0.05), 0.5, 1.25, 0, 3),\n    part(new RoundedBoxGeometry(0.18, 0.75, 0.18, 2, 0.05), -0.5, 1.25, 0, 4),\n    part(new RoundedBoxGeometry(0.22, 0.9, 0.22, 2, 0.05), 0.2, 0.45, 0, 5),\n    part(new RoundedBoxGeometry(0.22, 0.9, 0.22, 2, 0.05), -0.2, 0.45, 0, 6),\n  ]);\n  const mesh = new THREE.SkinnedMesh(geo, toon(color));\n  mesh.castShadow = true; mesh.receiveShadow = true;\n  mesh.add(root);\n  mesh.bind(new THREE.Skeleton(bones));\n  return mesh;\n}\nconst qx = (a) => new THREE.Quaternion().setFromEuler(new THREE.Euler(a, 0, 0)).toArray();\nconst walk = new THREE.AnimationClip('walk', 0.8, [\n  new THREE.QuaternionKeyframeTrack('legR.quaternion', [0, 0.4, 0.8], [...qx(0.7), ...qx(-0.7), ...qx(0.7)]),\n  new THREE.QuaternionKeyframeTrack('legL.quaternion', [0, 0.4, 0.8], [...qx(-0.7), ...qx(0.7), ...qx(-0.7)]),\n  new THREE.QuaternionKeyframeTrack('armR.quaternion', [0, 0.4, 0.8], [...qx(-0.6), ...qx(0.6), ...qx(-0.6)]),\n  new THREE.QuaternionKeyframeTrack('armL.quaternion', [0, 0.4, 0.8], [...qx(0.6), ...qx(-0.6), ...qx(0.6)]),\n]);\n\nasync function main() {\n  // ---------- rapier\n  const t0 = performance.now();\n  await RAPIER.init();\n  out.rapierMs = performance.now() - t0;\n  const world = new RAPIER.World({ x: 0, y: -18, z: 0 });\n  world.timestep = 1 / 60;\n  world.createCollider(RAPIER.ColliderDesc.cuboid(60, 0.5, 60).setTranslation(0, -0.5, 0));\n  const bodies = [];\n  const N_BOX = Number(q.get('boxes') || 120);\n  for (let i = 0; i < N_BOX; i++) {\n    const b = world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation((i % 12) - 6, 3 + (i % 9) * 0.9, ((i / 12) | 0) - 5));\n    world.createCollider(RAPIER.ColliderDesc.cuboid(0.2, 0.2, 0.2).setRestitution(0.2), b);\n    bodies.push(b);\n  }\n  const kcc = world.createCharacterController(0.02);\n  kcc.enableAutostep(0.4, 0.2, true);\n  const hero = world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(0, 1, 0));\n  const heroCol = world.createCollider(RAPIER.ColliderDesc.capsule(0.6, 0.4), hero);\n  world.step();\n  kcc.computeColliderMovement(heroCol, { x: 0.1, y: -0.1, z: 0 });\n  out.kcc = kcc.computedMovement();\n  const hit = world.castRay(new RAPIER.Ray({ x: 0, y: 5, z: 0 }, { x: 0, y: -1, z: 0 }), 20, true);\n  out.ray = hit ? hit.timeOfImpact : null;\n  out.sensorApi = typeof world.intersectionsWithShape;\n\n  // ---------- renderer\n  const forceWebGL = q.get('backend') === 'webgl2';\n  const renderer = new THREE.WebGPURenderer({ antialias: false, forceWebGL, alpha: false });\n  renderer.setPixelRatio(1);\n  renderer.setSize(innerWidth, innerHeight);\n  renderer.shadowMap.enabled = true;\n  renderer.toneMapping = THREE.NoToneMapping;\n  document.body.append(renderer.domElement);\n  const t1 = performance.now();\n  await renderer.init();\n  out.initMs = performance.now() - t1;\n  out.backend = renderer.backend.isWebGPUBackend ? 'webgpu' : 'webgl2';\n\n  const scene = new THREE.Scene();\n  scene.background = new THREE.Color(0x05040a);\n  const cam = new THREE.PerspectiveCamera(30, innerWidth / innerHeight, 1, 300);\n  cam.position.set(0, 26, 22); cam.lookAt(0, 1, 0);\n\n  const moon = new THREE.DirectionalLight(0x8fa3d8, 1.1);\n  moon.position.set(-14, 30, 10); moon.castShadow = true;\n  moon.shadow.mapSize.set(2048, 2048);\n  Object.assign(moon.shadow.camera, { left: -30, right: 30, top: 30, bottom: -30, near: 1, far: 80 });\n  scene.add(moon, new THREE.HemisphereLight(0x39415e, 0x140c08, 0.8));\n\n  const N_LIGHTS = Number(q.get('lights') || 16);\n  for (let i = 0; i < N_LIGHTS; i++) {\n    const l = new THREE.PointLight(0xffa64a, 60, 14, 2);\n    l.position.set(Math.cos(i * 2.4) * (6 + i * 1.1), 2.6, Math.sin(i * 2.4) * (6 + i * 1.1));\n    scene.add(l);\n  }\n  const shadowPoint = new THREE.PointLight(0xffc27a, 90, 16, 2);\n  shadowPoint.position.set(0, 3.4, 2); shadowPoint.castShadow = q.get('pointshadow') === '1';\n  scene.add(shadowPoint);\n\n  // floor tiles + pillars, instanced\n  const tiles = new THREE.InstancedMesh(new RoundedBoxGeometry(1.96, 0.3, 1.96, 1, 0.04), toon(0x4a4640), 3600);\n  const m = new THREE.Matrix4();\n  let i = 0;\n  for (let x = -30; x < 30; x++) for (let z = -30; z < 30; z++) { m.makeTranslation(x * 2, -0.15 - ((x * 7 + z * 13) % 5) * 0.012, z * 2); tiles.setMatrixAt(i++, m); }\n  tiles.receiveShadow = true;\n  scene.add(tiles);\n  const pillars = new THREE.InstancedMesh(new THREE.CylinderGeometry(0.55, 0.7, 7, 10), toon(0x6c6458), 140);\n  for (let k = 0; k < 140; k++) { m.makeTranslation(((k * 37) % 56) - 28, 3.5, ((k * 53) % 56) - 28); pillars.setMatrixAt(k, m); }\n  pillars.castShadow = pillars.receiveShadow = true;\n  scene.add(pillars);\n  const boxes = new THREE.InstancedMesh(new THREE.BoxGeometry(0.4, 0.4, 0.4), toon(0x8b5a2b), N_BOX);\n  boxes.castShadow = true; boxes.frustumCulled = false;\n  scene.add(boxes);\n\n  // skinned crowd with mixers\n  const N_ENEMY = Number(q.get('enemies') || 60);\n  const base = makeBiped(0xc7c0b0);\n  const mixers = [];\n  scene.add(base);\n  mixers.push(new THREE.AnimationMixer(base));\n  mixers[0].clipAction(walk).play();\n  for (let e = 0; e < N_ENEMY; e++) {\n    const c = skeletonClone(base);\n    c.material = toon(e % 3 === 0 ? 0x7c2a22 : e % 3 === 1 ? 0x3f5f4a : 0x5b4a6f);\n    c.position.set(Math.cos(e) * (3 + e * 0.2), 0, Math.sin(e) * (3 + e * 0.2));\n    c.rotation.y = e;\n    scene.add(c);\n    const mix = new THREE.AnimationMixer(c);\n    mix.clipAction(walk).play();\n    mix.update((e * 0.13) % 0.8);\n    mixers.push(mix);\n  }\n  // emissive candle flames for bloom\n  const flame = new THREE.MeshBasicNodeMaterial({ color: new THREE.Color(6, 3, 0.8) });\n  const flames = new THREE.InstancedMesh(new THREE.SphereGeometry(0.16, 8, 6), flame, N_LIGHTS);\n  for (let k = 0; k < N_LIGHTS; k++) { m.makeTranslation(Math.cos(k * 2.4) * (6 + k * 1.1), 2.6, Math.sin(k * 2.4) * (6 + k * 1.1)); flames.setMatrixAt(k, m); }\n  scene.add(flames);\n\n  // ---------- ink post chain\n  const inkStrength = uniform(1.0);\n  const post = new THREE.PostProcessing(renderer);\n  const scenePass = pass(scene, cam);\n  scenePass.setMRT(mrt({ output, normal: normalView }));\n  const colorTex = scenePass.getTextureNode('output');\n  const normalTex = scenePass.getTextureNode('normal');\n  const depthTex = scenePass.getTextureNode('depth');\n  const rawDepth = (p) => depthTex.sample(p).r;\n  const viewZ = (p) => perspectiveDepthToViewZ(rawDepth(p), cameraNear, cameraFar);\n  const inked = Fn(() => {\n    const p = uv();\n    const px = vec2(1).div(screenSize);\n    // edge wobble: lines boil a little, like a hand-drawn line\n    const boil = floor(time.mul(8));\n    const wob = vec2(mx_noise_float(p.mul(90).add(boil)), mx_noise_float(p.mul(90).add(boil).add(7.3))).mul(px).mul(1.1);\n    const q0 = p.add(wob);\n    const w = px.mul(1.25);\n    const c = colorTex.sample(q0);\n    const z0 = viewZ(q0);\n    const zA = viewZ(q0.add(vec2(w.x, w.y)));\n    const zB = viewZ(q0.add(vec2(w.x.negate(), w.y.negate())));\n    const zC = viewZ(q0.add(vec2(w.x, w.y.negate())));\n    const zD = viewZ(q0.add(vec2(w.x.negate(), w.y)));\n    const depthEdge = smoothstep(0.012, 0.03, abs(zA.sub(zB)).add(abs(zC.sub(zD))).div(abs(z0)));\n    const nA = normalTex.sample(q0.add(vec2(w.x, w.y))).xyz;\n    const nB = normalTex.sample(q0.add(vec2(w.x.negate(), w.y.negate()))).xyz;\n    const nC = normalTex.sample(q0.add(vec2(w.x, w.y.negate()))).xyz;\n    const nD = normalTex.sample(q0.add(vec2(w.x.negate(), w.y))).xyz;\n    const normalEdge = smoothstep(0.35, 0.7, length(nA.sub(nB)).add(length(nC.sub(nD))));\n    const edge = clamp(max(depthEdge, normalEdge), 0, 1).mul(inkStrength);\n    // world position from depth: hatching stays glued to the world when the camera scrolls\n    const vp = getViewPosition(p, rawDepth(p), cameraProjectionMatrixInverse);\n    const wp = cameraWorldMatrix.mul(vec4(vp, 1)).xyz;\n    const lum = luminance(c.rgb);\n    const h1 = step(0.55, fract(wp.x.add(wp.z).add(wp.y).mul(3.5)));\n    const h2 = step(0.55, fract(wp.x.sub(wp.z).sub(wp.y).mul(3.5)));\n    const dark1 = smoothstep(0.16, 0.07, lum);\n    const dark2 = smoothstep(0.07, 0.025, lum);\n    const hatch = max(h1.mul(dark1), h2.mul(dark2)).mul(0.55).mul(inkStrength);\n    const paper = mx_noise_float(p.mul(vec2(900, 500))).mul(0.035).add(1);\n    const vig = smoothstep(0.95, 0.35, length(p.sub(0.5)));\n    const ink = vec3(0.035, 0.028, 0.03);\n    return vec4(mix(mix(c.rgb, ink, hatch), ink, edge).mul(paper).mul(mix(0.55, 1, vig)), 1);\n  });\n  const glow = bloom(colorTex, 0.6, 0.5, 0.75);\n  post.outputNode = inked().add(glow);\n  post.outputColorTransform = true;\n\n  const t2 = performance.now();\n  out.firstFrameStart = t2 - out.boot;\n  let last = performance.now();\n  const clock = { t: 0 };\n  function frame() {\n    const now = performance.now();\n    const dt = Math.min((now - last) / 1000, 0.1);\n    last = now;\n    world.step(); out.steps++;\n    bodies.forEach((b, k) => {\n      const p = b.translation(), r = b.rotation();\n      m.compose(new THREE.Vector3(p.x, p.y, p.z), new THREE.Quaternion(r.x, r.y, r.z, r.w), new THREE.Vector3(1, 1, 1));\n      boxes.setMatrixAt(k, m);\n    });\n    boxes.instanceMatrix.needsUpdate = true;\n    mixers.forEach((mx) => mx.update(dt));\n    clock.t += dt;\n    if (q.get('capture') === '1') window.__capture = () => { post.render(); return renderer.domElement.toDataURL('image/png'); };\n    const f0 = performance.now();\n    post.render();\n    const fm = performance.now() - f0;\n    out.frames++;\n    if (out.frames === 1) out.firstFrameMs = performance.now() - t2;\n    if (out.frameMs.length < 240) out.frameMs.push(Math.round(now - (out._prev || now)));\n    out._prev = now;\n    out.submitMs = fm;\n    requestAnimationFrame(frame);\n  }\n  requestAnimationFrame(frame);\n  out.renderer = renderer; out.post = post; out.scene = scene; out.cam = cam; out.THREE = THREE;\n}\nmain().catch((e) => { out.errors.push('main: ' + (e.stack || e)); });\nEOF\ncat > build.mjs <<'EOF'\nimport { execSync } from 'node:child_process';\nimport { readFileSync, writeFileSync, statSync } from 'node:fs';\nconst entry = process.argv[2] || 'main.js', outHtml = process.argv[3] || 'spike.html';\nexecSync(`esbuild ${entry} --bundle --format=iife --target=es2022 --minify --charset=utf8 --legal-comments=none --log-level=warning --outfile=${outHtml}.bundle.js`, { stdio: 'inherit' });\nlet bundle = readFileSync(`${outHtml}.bundle.js`, 'utf8');\nconst hasClose = bundle.includes('</script');\nbundle = bundle.replace(/<\\/script/gi, '<\\\\/script');\nconst client = readFileSync('session.js', 'utf8').trimEnd();\nconst head = process.argv[4] || '';\nconst html = `<!doctype html>\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\">\n<script>\n${client}\n</script>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>spike</title>\n${head}\n<style>html,body{margin:0;height:100%;background:#000;overflow:hidden}canvas{display:block}</style>\n</head><body>\n<script>\n${bundle}\n</script>\n</body></html>\n`;\nwriteFileSync(outHtml, html);\nconsole.log(outHtml, (statSync(outHtml).size / 1048576).toFixed(2) + ' MB', 'had </script:', hasClose);\nEOF\nnode build.mjs main.js spike.html 2>&1 | tail -20","description":"Write spike scene and single-file build script, then build","timeout":120000}}}
