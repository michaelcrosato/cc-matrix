s.push({x:p[0]<0?pad:W-pad,y:clamp(p[1],topSafe,bottomSafe),side:p[0]<0?-1:1,label,c,priority});};\n      const miner=sim.miners.find(m=>m.id===this.localId)||sim.miners[0];\n      for(const m of sim.miners)if(m.downed&&m!==miner)add(m.hero.x,m.hero.z+18,'RESCUE',A.CORAL,0);\n      for(const p of sim.pickups){if(p.kind==='key')add(p.x,p.z,'KEY RISING',A.GOLD,1);else if(p.kind==='pick'&&(!miner?.tool||miner.tool<2))add(p.x,p.z,'PICK FALLING',A.TEAL,2);}\n      for(const d of sim.room.doors){if(d.warning>0)add(d.x,d.z+18,`${d.name} INCOMING`,A.CORAL,3);else if(sim.keyOwner!==null)add(d.x,d.z+18,`${d.name} GATE`,d.color,4);}\n      for(const rock of sim.rocks){const p=r.w(rock.x,0,rock.z);if((p[0]<0&&rock.vx>0)||(p[0]>W&&rock.vx<0))add(rock.x,rock.z,rock.kind==='heavy'?'HEAVY ORE':rock.kind==='bounce'?'BOUNCING ORE':'ORE INCOMING',A.CORAL,5);}\n      items.sort((a,b)=>a.priority-b.priority);const chosen=[];\n      for(const p of items){if(chosen.some(q=>q.side===p.side&&Math.abs(q.y-p.y)<68))continue;chosen.push(p);if(chosen.length>=6)break;}\n      r.overlay(g=>{for(const p of chosen){const width=Math.min(W*.42,p.label.length*5*scale+23),x=p.side<0?p.x-5:p.x-width+5;px.rect(g,x,p.y-13,width,30,'#0b252b');px.line(g,x,p.y-13,x+width,p.y-13,p.c,2);const arrow=p.side<0?p.x+3:p.x-3;px.poly(g,[[arrow,p.y-6],[arrow+p.side*9,p.y+2],[arrow,p.y+10]],p.c);E.font.text(g,p.label,p.side<0?p.x+20:p.x-20,p.y-7,p.c,{align:p.side<0?'left':'right',scale,outline:false,shadow:'#071b20'});}});\n    }\n    drawDebug(r,sim) {\n      r.overlay(g=>{\n        const ppu=r.ppu;\n        for(const m of sim.miners||[]){const h=m.hero,p=r.w(h.x-h.w/2,0,h.z+h.h),q=r.w(h.x+h.w/2,0,h.z);px.line(g,p[0],p[1],q[0],p[1],A.TEAL);px.line(g,q[0],p[1],q[0],q[1],A.TEAL);px.line(g,q[0],q[1],p[0],q[1],A.TEAL);px.line(g,p[0],q[1],p[0],p[1],A.TEAL);}\n        for(const b of sim.rocks||[]){const p=r.w(b.x,0,b.z),rr=(b.r||9)*ppu;px.line(g,p[0]-rr,p[1],p[0]+rr,p[1],A.CORAL);px.line(g,p[0],p[1]-rr,p[0],p[1]+rr,A.CORAL)