{"type":"item.completed","item":{"id":"item_87","type":"command_execution","command":"/bin/bash -lc \"rg -n 'pointerenter|addEventListener\\\\(\\\"pointer|visibilitychange|function beginAttract' src/main.js && sed -n '180,260p' tests/browser.py && sed -n '1,12p' src/view/preview.html && tail -25 tests/sim.test.mjs\"","aggregated_output":"539:\t\t\tel.addEventListener(\"pointerenter\", () => {\n882:\tfunction beginAttract() {\n1005:\tdocument.addEventListener(\"visibilitychange\", () => {\n        check(evaluate(page, \"__pp.mode==='play' && __pp.screen===null && !__pp.sim.completed && __pp.sim.miners[0].health===3\"), \"failure retry restores native checkpoint\")\n        check(evaluate(page, \"(Number(localStorage.getItem('pickaxe-puddles:best'))||0)===0\"), \"Developer and failure runs do not write best score\")\n    finally:\n        evaluate(page, \"__pp.dispose()\")\n        context.close()\n\n\ndef attract_checks(browser):\n    context, page = boot(browser, pads=True)\n    try:\n        evaluate(page, \"localStorage.setItem('pickaxe-puddles:best','777')\")\n        idle = evaluate(page, \"__pp.diagnostics().idle\")\n        step(page, max(0, 9.95-idle))\n        check(evaluate(page, \"__pp.mode==='title'\"), \"attract does not start before ten idle seconds\")\n        step(page, .06)\n        check(evaluate(page, \"__pp.mode==='attract'\"), \"attract starts at ten-second boundary\")\n        check(not page.locator(\"#attract-label\").is_hidden(), \"attract is visibly labelled\")\n        key(page, \"Enter\")\n        check(evaluate(page, \"__pp.mode==='title' && __pp.screen==='title'\"), \"keyboard wakes attract to title\")\n        check(evaluate(page, \"__pp.sim.score===0 && __pp.sim.chamber===0 && !__pp.sim.developer\"), \"attract wake restores clean simulation\")\n        check(evaluate(page, \"localStorage.getItem('pickaxe-puddles:best')==='777'\"), \"attract never changes completed score record\")\n        step(page, .2)\n        key(page, \"Enter\")\n        check(evaluate(page, \"__pp.mode==='play'\"), \"second deliberate key starts new run\")\n        evaluate(page, \"__pp.action('title')\")\n        step(page, 10.1)\n        evaluate(page, \"__testPads=[__makePad(0)]\")\n        pad(page, 0)\n        check(evaluate(page, \"__pp.mode==='title'\"), \"gamepad wake is consumed without starting run\")\n        evaluate(page, \"__testPads=[]\")\n        step(page, 10.1)\n        page.mouse.click(10, 10)\n        step(page)\n        check(evaluate(page, \"__pp.mode==='title'\"), \"pointer wakes attract without clicking through\")\n        check(evaluate(page, \"__pp.game.errors.length===0\"), \"attract wake cycles leave native engine clean\")\n    finally:\n        evaluate(page, \"__pp.dispose()\")\n        context.close()\n\n\ndef pad_checks(browser):\n    context, page = boot(browser, pads=True)\n    try:\n        evaluate(page, \"__testPads=[__makePad(0)]\")\n        step(page)\n        pad(page, 13)\n        pad(page, 0)\n        check(evaluate(page, \"__pp.screen==='coop'\"), \"pad reaches local co-op menu\")\n        pad(page, 1)\n        check(evaluate(page, \"__pp.screen==='title'\"), \"pad Circle returns title\")\n        pad(page, 13)\n        pad(page, 13)\n        pad(page, 0)\n        check(evaluate(page, \"__pp.screen==='practice'\"), \"pad reaches chamber practice\")\n        pad(page, 13)\n        pad(page, 0)\n        check(evaluate(page, \"__pp.mode==='play' && __pp.sim.chamber===1\"), \"pad starts selected chamber practice\")\n        step(page,1.8)\n        evaluate(page,\"__testPads[0].buttons[1]={pressed:true,value:1}\")\n        step(page)\n        check(evaluate(page,\"__pp.input.intent(1).my===1 && __pp.sim.miners[0].hero.crouching && __pp.screen===null\"),\"Circle ducks through native platformer without opening menu\")\n        evaluate(page,\"__testPads[0].buttons[1]={pressed:false,value:0}\")\n        step(page)\n        pad(page, 9)\n        check(evaluate(page, \"__pp.screen==='pause'\"), \"pad Options pauses\")\n        pad(page, 13)\n        pad(page, 0)\n        check(evaluate(page, \"__pp.screen==='settings'\"), \"pad opens Settings\")\n        before = evaluate(page, \"__pp.settings.music\")\n        pad(page, 15)\n        check(evaluate(page, f\"__pp.settings.music>{before}\"), \"pad adjusts sound slider\")\n        pad(page, 1)\n        pad(page, 13)\n        pad(page, 13)\n        pad(page, 0)\n        check(evaluate(page, \"__pp.screen==='controls'\"), \"pad opens Controls\")\n        pad(page, 0)\n        check(\"Gamepad\" in nav_label(page), \"pad selects gamepad rebinding device\")\n        pad(page, 1)\n        for _ in range(3):\n            pad(page, 13)\n<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Pickaxe Puddles · native asset and room preview</title><style>html,body{margin:0;background:#071b20;width:100%;height:100%;overflow:hidden}canvas{width:100%;height:100%;display:block;image-rendering:pixelated}</style><canvas id=\"screen\"></canvas><script src=\"../../vendor/engine/my-3d2dge.js\"></script><script src=\"assets.js\"></script><script src=\"view.js\"></script><script>\nconst E=My3D2dge,game=new E.Game({canvas:'screen',res:[960,720],expand:true,view:'side',menu:false,fullscreen:false,corner:false,autoPause:false,loop:false});\nconst sim={epoch:1,room:{index:2,tiers:7,floors:Array.from({length:7},(_,i)=>({z:16+i*64,gaps:i?[[256,288]]:[]})),ladders:Array.from({length:6},(_,i)=>({id:i,x:i%2?456:104,z0:16+i*64,z1:80+i*64,state:'usable',temporary:false})),doors:[{id:0,x:32,z:144,color:'#efbb57',name:'PAYDIRT',symbol:'▲'},{id:1,x:544,z:272,color:'#59d4c5',name:'CROSSCURRENT',symbol:'◆',warning:1},{id:2,x:544,z:16,color:'#e77d67',name:'EXTRACTION',symbol:'square'}]},miners:[{id:1,hero:new E.Platformer({x:180,z:144,w:9,h:26}),health:3,tool:6,downed:false,facing:1,action:'chop',actionT:.12,invuln:0},{id:2,hero:new E.Platformer({x:421,z:272,w:9,h:26}),health:3,tool:0,downed:false,facing:-1,action:null,actionT:0,invuln:0}],rocks:[{id:2,x:218,z:154,r:10,kind:'normal'},{id:3,x:415,z:295,r:9,kind:'bounce'},{id:4,x:340,z:30,r:13,kind:'heavy',hp:3}],pickups:[{id:3,kind:'key',x:275,z:331,ttl:10},{id:4,kind:'pick',x:124,z:211,ttl:10}],keyOwner:null,time:0,chamberTime:0,transition:0,events:[]};\nconst view=new PP.View(game);game.start({update(dt){sim.time+=dt;view.update(dt,sim,{});},draw(r){view.draw(r,sim,{})}});game.advance(1,{draw:true});window.preview={game,sim,view};\n</script></html>\n\t\t\t\t\tObject.fromEntries(\n\t\t\t\t\t\ts.miners.map((m) => [m.id, PP.pilot(s, m.id, route)]),\n\t\t\t\t\t),\n\t\t\t\t120 * 400,\n\t\t\t);\n\t\t\tassert.equal(s.completed.won, true);\n\t\t\tassert.ok(s.miners.every((m) => m.health > 0));\n\t\t\tassert.equal(s.eventLog.filter((e) => e.type === \"unlock\").length, 3);\n\t\t\tassert.ok(s.miners.reduce((n, m) => n + m.stats.ore, 0) > 6);\n\t\t});\n\tif (failures.length)\n\t\tthrow new Error(\n\t\t\t`Simulation failures (${failures.length}):\\n${failures.join(\"\\n\")}`,\n\t\t);\n\treturn { count, times };\n}\nif (process.argv[1] === new URL(import.meta.url).pathname) {\n\ttry {\n\t\tconst { count } = await runSimTests();\n\t\tconsole.log(`${count} simulation checks passed`);\n\t} catch (error) {\n\t\tconsole.error(error.message);\n\t\tprocess.exitCode = 1;\n\t}\n}\n","exit_code":0,"status":"completed"}}
