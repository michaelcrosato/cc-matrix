d > 0 && !this.types[id]) { warn('ptype:' + id, 'PlatformMap: tile type ' + id + ' is used but missing from types (using a plain solid block)'); this.types[id] = Object.assign({}, PT_DEFAULT); }\n    /** spawn points: { tag, ch, cx, cz, x, y: 0, z } with x = cell center and z = bottom of the cell (feet) */\n    this.spawns = L.spawns.map(sp => { const cz = this.h - 1 - sp.cy; return Object.assign(sp, { cz, x: (sp.cx + .5) * this.T, y: 0, z: cz * this.T }); });\n    /** version: counts every change to the cells (set); edges: 'solid' (the default) makes the level's left and\n     *  right edges walls, 'open' lets bodies walk off them */\n    this.version = 0; this._bake = null; this.edges = o.edges || 'solid';\n  }\n  /** the first spawn with this tag ({ x, y: 0, z, cx, cz }), or null */\n  find(tag) { return this.spawns.find(s => s.tag === tag) || null; }\n  /** every spawn with this tag */\n  findAll(tag) { return this.spawns.filter(s => s.tag === tag); }\n  /** tile id at column cx, row cz (cz = 0 is the bottom). Left and right of the level are solid walls unless edges: 'open' */\n  cell(cx, cz) { if (cx < 0 || cx >= this.w) return this.edges === 'open' ? 0 : -1; if (cz < 0 || cz >= this.h) return 0; return this.cells[cz * this.w + cx]; }\n  /** a cell's kind: 'solid', 'oneway', 'ladder', 'slope', 'hazard', 'deco' or 'back', null when empty ('solid'\n   *  outside) */\n  kind(cx, cz) { const c = this.cell(cx, cz); return c < 0 ? 'solid' : c === 0 ? null : this.types[c].kind; }\n  /** put tile type id at a cell (0 clears it; cz counts from the bottom row); bumps version */\n  set(cx, cz, id) {\n    if (cx < 0 || cz < 0 || cx >= this.w || cz >= this.h) return;\n    if (id > 0 && !this.types[id]) this.types[id] = Object.assign({}, PT_DEFAULT);\n    this.cells[cz * this.w + cx] = id; this.version++;\n  }\n  /** a world point -> [cx, cz] */\n  toCell(x, z) { return [Math.floor(x / this.T), Math.floor(z / this.T)]; }\n  /** a cell's center -> [x, z] */\n  center(cx, cz) { return [(cx + .5) * this.T, (cz + .5) * this.T]; }\n  /** kind() at a world point */\n  kindAt(x, z) { return this.kind(Math.floor(x / this.T), Math.floor(z / this.T)); }\n  /** true where a world point is inside a solid tile */\n  solidAt(x, z) { return this.kindAt(x, z) === 'solid'; }\n  /** width and height of the level in world units */\n  get width() { return this.w * this.T; }\n  /** the level's height in world units (width is its width) */\n  get height() { return this.h * this.T; }\n  /** top of the highest solid or one-way tile at or below height z in this column, or null over a pit */\n  groundBelow(x, z) {\n    const T = this.T, cx = Math.floor(x / T);\n    for (let cz = Math.min(this.h - 1, Math.floor((z + .5) / T)); cz >= 0; cz--) {\n      const k = this.kind(cx, cz);\n      if (k === 'slope') { const sz = this.slopeZ(cx, cz, x); if (sz <= z + .5) return sz; }\n      else if ((k === 'solid' || k === 'oneway') && (cz + 1) * T <= z + .5) return (cz + 1) * T;\n    }\n    return null;\n  }\n  /** surface height of a slope tile at world x */\n  slopeZ(cx, cz, x) {\n    const t = this.types[this.cell(cx, cz)] || {}, T = this.T, u = clamp((x - cx * T) / T, 0, 1);\n    const a = t.from !== undefined ? t.from : (t.dir < 0 ? 1 : 0), b = t.to !== undefined ? t.to : (t.dir < 0 ? 0 : 1);\n    return cz * T + lerp(a, b, u) * T;\n  }\n  /** highest surface (tile top or slope) under the body within maxDrop below its feet, or null */\n  _surfaceBelow(b, maxDrop) {\n    const T = this.T, hw = b.w / 2 - .01, sc = Math.floor(b.x / T); let best = null;\n    for (let cz = Math.floor((b.z + .01) / T); cz >= Math.floor((b.z - maxDrop) / T) - 1; cz--) {\n      for (let cx = Math.floor((b.x - hw) / T); cx <= Math.floor((b.x + hw) / T); cx++) {\n        const k = this.kind(cx, cz), top = (cz + 1) * T;\n        let sz = null;\n        if (k === 'slope') { if (cx === sc) sz = this.slopeZ(cx, cz, b.x); }\n        else if (k === 'solid' || ((k === 'oneway') && !(b.drop > 0))) sz = top;\n        if (sz !== null && sz <= b.z + .01 && sz >= b.z - maxDrop && (best === null || sz > best)) best = sz;\n      }\n    }\n    return best;\n  }\n  /** tiles overlapped by a body box { x, z, w, h }: [{ cx, cz, id, kind }] (optionally only one kind or id) */\n  cellsTouching(b, what) {\n    const T = this.T, out = [], x0 = Math.floor((b.x - b.w / 2 + .01) / T), x1 = Math.floor((b.x + b.w / 2 - .01) / T), z0 = Math.floor((b.z + .01) / T), z1 = Math.floor((b.z + b.h - .01) / T);\n    for (let cz = z0; cz <= z1; cz++) for (let cx = x0; cx <= x1; cx++) {\n      const id = this.cell(cx, cz); if (id <= 0) continue; const k = this.types[id].kind;\n      if (what === undefined || what === k || what === id) out.push({ cx, cz, id, kind: k });\n    }\n    return out;\n  }\n  /** does the body box overlap a tile of this kind ('hazard', 'ladder', ...) or id? */\n  touching(b, what) { return this.cellsTouching(b, what).length > 0; }\n  /**\n   * Move a body { x, z, vx, vz, w, h } (x = center, z = feet, vz > 0 = up) by its velocity, colliding with the level.\n   * Sets b.onGround, b.onOneWay, b.hitWall (-1 left, 1 right, 0), b.hitCeiling, b.bumped ({ cx, cz, id } of a ceiling\n   * tile hit from below, for ? blocks and bricks) and b.ground (the moving solid it stands on).\n   * One-way tiles hold the body from above unless b.drop > 0. solids: optional array of extra boxes\n   * { x, z, w, h, vx, vz, oneway } (moving platforms, elevators, crates) that also carry what stands on them.\n   */\n  move(b, dt, solids) {\n    const gr = b.ground, wasGround = !!b.onGround;\n *   draw a Humanoid with rig.update(dt, hero.rigState())\n * Units: world units per second. One tile = 16. A 285 jump with gravity 800 clears about 3 tiles.\n */\nclass Platformer {\n  constructor(o = {}) {\n    /** x, z: its feet's position (side view: x right, z up); y: its depth (0); vx, vz: its speed; w, h: its box (x is\n     *  its center, z its feet); run: top running speed; accel, decel, airAccel: how fast it speeds up and slows down\n     *  on the ground and in the air; jump: the jump's starting speed; gravity: while rising; fallGravity: while\n     *  falling (snappier landings); maxFall: the fastest fall; cut: the share of upward speed kept when jump is let\n     *  go early (short hops); coyote: seconds a jump still works after walking off a ledge; buffer: seconds a jump\n     *  pressed before landing is kept; climb: ladder speed; airJumps: extra jumps in the air (1 = double jump);\n     *  wallJump: jumps off walls; wallSlide: the slowest fall against a wall; dash: dash speed (0 = no dash);\n     *  dashTime: seconds a dash lasts; facing: 1 right, -1 left; onGround: standing on something; climbing: on a\n     *  ladder; jumped, landed: it jumped or landed this step; air: in the air, not climbing; stun: seconds of\n     *  knockback left (no control); drop: seconds left of dropping through a one-way platform; dashing: seconds of\n     *  dash left */\n    Object.assign(this, {\n      x: 0, y: 0, z: 0, vx: 0, vz: 0, w: 8, h: 22,\n      run: 95, accel: 900, decel: 1100, airAccel: 650, jump: 285, gravity: 800, fallGravity: 1150, maxFall: 330,\n      cut: .45, coyote: .09, buffer: .13, climb: 70, airJumps: 0, wallJump: false, wallSlide: 70, dash: 0, dashTime: .22,\n      facing: 1, onGround: false, climbing: false, jumped: false, landed: false, air: false, stun: 0, drop: 0, dashing: 0\n    }, o);\n    this._coy = 0; this._airJ = 0; this._cut = true; this._dashCD = 0;\n  }\n  /** push the body (getting hit): dir = -1 / 1 */\n  knock(dir, speed = 130, up = 170, stun = .3) { this.vx = dir * speed; this.vz = up; this.stun = stun; this.climbing = false; this.dashing = 0; }\n  /** hang from a point (a grapple's hook, a whip's ring): a pendulum from (x, z) to its hands, len long (the distance\n   *  now by default); left and right pump it, jump lets go with its speed (release() does too) */\n  swingFrom(x, z, len) {\n    const hx = this.x, hz = this.z + this.h, L = len || Math.max(8, Math.hypot(hx - x, hz - z)), a = Math.atan2(hx - x, z - hz);\n    /** swinging: the point it swings from ({ x, z, L: the length, a: the angle, w: the angular speed }), or null */\n    this.swinging = { x, z, L, a, w: (this.vx * Math.cos(a) + this.vz * Math.sin(a)) / L };\n    /** hanging: the ledge it hangs from ({ dir, top, cx }), or null; onBars: the bars it hangs from ({ z }), or null;\n     *  onRope: true while on a rope (section 16c sets them) */\n    this.hanging = this.onBars = this.onRope = null; this.climbing = false; this.dashing = 0;\n    return this;\n  }\n  /** let go of a swing, keeping its speed (up: an extra upward speed) */\n  release(up = 0) {\n    const S = this.swinging; if (!S) return this;\n    this.vx = S.L * S.w * Math.cos(S.a); this.vz = S.L * S.w * Math.sin(S.a) + up; this.swinging = null; this._fling = true;   // (its speed kept until it lands)\n    if (Math.abs(this.vx) > 1) this.facing = this.vx > 0 ? 1 : -1;\n    return this;\n  }\n  /** state for Humanoid.update: rig.update(dt, hero.rigState({ attack })) */\n  rigState(extra) { return Object.assign({ x: this.x, y: this.y, z: this.z, vx: this.vx, vy: 0, vz: this.vz, facing: this.facing > 0 ? 0 : Math.PI, air: this.air && !this.climbing, climb: !!this.climbing, hurt: this.stun > 0, dash: this.dashing > 0 }, this._travRig && this._travRig(), extra); }   // (the further moves' poses: section 16c)\n  /** move it one step: ctl is game.input or an intent { x: -1..1, jump, jumpPressed, up, down, dash } (enemies,\n   *  bots); solids: moving platforms [{ x, z, w, h, vx, vz }] to stand on */\n  update(dt, level, ctl = {}, solids) {\n    let ix, jumpHeld, jumpPressed, up, down, dashPressed, consume = () => {};\n    if (ctl && typeof ctl.move === 'function') {   // an E.Input\n      ix = ctl.move()[0]; jumpHeld = ctl.down('jump'); jumpPressed = ctl.buffered('jump', this.buffer); up = ctl.down('up'); down = ctl.down('down');\n      dashPressed = this.dash > 0 && !!ctl.map.dash && ctl.buffered('dash', .1); consume = a => ctl.consume(a);\n    } else { ix = ctl.x || 0; jumpHeld = !!ctl.jump; jumpPressed = !!ctl.jumpPressed; up = !!ctl.up; down = !!ctl.down; dashPressed = !!ctl.dash; }\n    if (Math.abs(ix) < .25) ix = 0;\n    const wasGround = this.onGround; this.jumped = false; this.landed = false;\n    this.stun -= dt; this.drop -= dt; this._dashCD -= dt;\n    const ok = this.stun <= 0;\n    // the further moves (section 16c: crouch, ledges, clinging, water, ropes, bars, swinging, momentum) may take the step\n    if (this._trav && this._trav(dt, level, { ix, jumpHeld, jumpPressed, up, down, dashPressed, consume }, solids, ok)) { if (this.onGround && !wasGround) this.landed = true; this.air = !this.onGround && !this.climbing; return this; }\n    // ladders: grab with up (or down at the top of one), leave with jump or by climbing off the end\n    const feet = { x: this.x, z: this.z - 3, w: 2, h: 3 }, body = { x: this.x, z: this.z, w: 2, h: this.h * .8 };\n    const ladHere = level.touching(body, 'ladder'), ladBelow = level.touching(feet, 'ladder');\n    if (!this.climbing && ok && ((up && ladHere) || (down && ladBelow && this.onGround))) {\n      const lc = level.cellsTouching(up ? body : feet, 'ladder')[0]; this.climbing = true; this.x = (lc.cx + .5) * level.T; this.vx = 0; this.dashing = 0;\n      if (down) this.z -= 2;\n    }\n    if (this.climbing) {\n      this.vz = (up ? 1 : down ? -1 : 0) * this.climb; this.vx = 0;\n      if (jumpPressed) { consume('jump'); this.climbing = false; if (ix) { this.vz = this.jump * .6; this.vx = ix * this.run; } }\n      level.move(this, dt, solids);\n      if (!level.touching({ x: this.x, z: this.z, w: 2, h: this.h }, 'ladder') || (this.onGround && down)) this.climbing = false;\n    } else {\n      // dash (Mega Man X style)\n      if (dashPressed && ok && this._dashCD <= 0) { consume('dash'); this.dashing = this.dashTime; this._dashCD = this.dashTime + .15; this.vz = Math.max(0, this.vz); }\n      if (this.dashing > 0) { this.dashing -= dt; this.vx = this.facing * this.dash; if (!this.onGround) this.vz = Math.max(this.vz, 0); }\n      else if (!this._hx) {   // (_hx: momentum moved it, _spd: a crouch's crawl, _fr: the ground's grip: section 16c)\n        const target = ok ? ix * this.run * (this._spd || 1) : this.vx, turning = ix && this.vx && Math.sign(ix) !== Math.sign(this.vx);\n        const a = (this.onGround ? (ix ? (turning ? this.decel * 1.3 : this.accel) : this.decel) : this.airAccel) * (this._fr || 1);\n        this.vx = ok ? approach(this.vx, target, a * dt) : approach(this.vx, 0, 300 * dt);\n      }\n      if (ix && ok && this.dashing <= 0) this.facing = ix > 0 ? 1 : -1;\n      if (!(this.dashing > 0 && !this.onGround)) this.vz = Math.max(-this.maxFall, this.vz - (this.vz > 0 ? this.gravity : this.fallGravity) * dt);\n      if (!jumpHeld && this.vz > 0 && !this._cut) { this.vz *= this.cut; this._cut = true; }   // let go early = lower jump\n      if (this.onGround) { this._coy = this.coyote; this._airJ = this.airJumps; } else this._coy -= dt;\n      const wall = this.wallJump && !this.onGround && this.hitWall;\n      if (wall && this.vz < -this.wallSlide) this.vz = -this.wallSlide;\n      if (jumpPressed && ok) {\n        if (down && this.onGround && this.onOneWay) { consume('jump'); this.drop = .25; this.onGround = false; this._coy = 0; this._airJ = 0; }\n        else if (this.onGround || this._coy > 0) { consume('jump'); this.vz = this.jump; this._coy = 0; this.jumped = true; this._cut = false; }\n        else if (wall) { consume('jump'); this.vz = this.jump * .95; this.vx = -this.hitWall * this.run * 1.1; this.facing = -this.hitWall; this.stun = .12; this.jumped = true; this._cut = false; }\n        else if (this._airJ > 0) { consume('jump'); this._airJ--; this.vz = this.jump * .9; this.jumped = true; this._cut = false; }\n      }\n      const pushing = this.hitWall, cv = this._carry || 0; if (cv) this.vx += cv;   // (a conveyor's carry: section 16c)\n      level.move(this, dt, solids); if (cv && this.vx) this.vx -= cv;\n      if (!this.hitWall && pushing && ix === pushing && !this.onGround) this.hitWall = pushing;   // keep wall contact while holding toward it\n    }\n    if (this._travAfter) this._travAfter(dt, level);   // (springs and crumbling blocks underfoot: section 16c)\n    if (this.onGround && !wasGround) this.landed = true;\n    this.air = !this.onGround && !this.climbing;\n    return this;\n  }\n}\nE.Platformer = Platformer;\n\n/* =============================================================================\n * 16c. TRAVERSAL  the Platformer's further moves, each opt-in (today's defaults are unchanged), and the rig's poses for\n *    them. Options: crouch (down crouches into a box half as tall: crawl under a gap), ledge (catch a ledge falling past\n *    it: hang, climb up with up or jump, drop with down), wallCling (hold onto a wall pressed in the air; jump leaps off),\n *    momentum (slopes speed it up downhill and slow it uphill, past its run speed up to top; down while running rolls;\n *    down while still and jump charges a dash, let go of down to go). Tiles: 'water' (it swims: less gravity, drag, a\n *    stroke on each jump, a leap out at the surface), 'rope' (up grabs it: climb hand over hand, jump off sideways),\n *    'bars' (rising into them it hangs and travels under them; down or jump lets go), and on any tile type friction (ice:\n *    .15), carry (a conveyor's speed), bounce (a spring's jump speed), crumble (seconds it holds once stood on, then falls\n *    away until respawn seconds pass: level.update(dt) each step). swingFrom(x, z) hangs it from a point (a grapple, a\n *    whip): a pendulum it pumps with left and right, let go of with jump at its speed. State for the rig and the game:\n *    crouching, hanging, climbUp, clinging, swimming, onRope, onBars, swinging, rolling, charge, sprung, splash.\n * ============================================================================= */\n// the tile underfoot ({ cx, cz, t }: its type), or null\nfunction _underfoot(b, level) {\n  const T = level.T, cz = Math.floor((b.z - .5) / T);\n  for (const x of [b.x, b.x - b.w / 2 + 1, b.x + b.w / 2 - 1]) { const cx = Math.floor(x / T), id = level.cell(cx, cz); if (id > 0) return { cx, cz, t: level.types[id] }; }\n  return null;\n}\n// is any cell a box overlaps solid (the level's edges count)?\nfunction _solidIn(level, b) {\n  const T = level.T;\n  for (let cz = Math.floor((b.z + .01) / T); cz <= Math.floor((b.z + b.h - .01) / T); cz++) for (let cx = Math.floor((b.x - b.w / 2 + .01) / T); cx <= Math.floor((b.x + b.w / 2 - .01) / T); cx++) if (level.kind(cx, cz) === 'solid') return true;\n  return false;\n}\n// the ground's slope under the body's center: rise over run (+ rises to the right), 0 when flat\nfunction _slopeUnder(level, b) {\n  const T = level.T, sc = Math.floor(b.x / T);\n  for (const cz of [Math.floor((b.z - .5) / T), Math.floor((b.z + .5) / T)]) if (level.kind(sc, cz) === 'slope') {\n    const t = level.types[level.cell(sc, cz)] || {}, a = t.from !== undefined ? t.from : (t.dir < 0 ? 1 : 0), c = t.to !== undefined ? t.to : (t.dir < 0 ? 0 : 1);\n    return c - a;\n  }\n  return 0;\n}\nObject.assign(Platformer.prototype, {\n  // the step's further moves: true when one of them took the whole step (c: the read input)\n  _trav(dt, level, c, solids, ok) {\n    this._spd = 1; this._fr = 1; this._carry = 0; this._hx = false; this.sprung = false; this.splash = 0;\n    if (!level.cell || !level.types) return false;   // (a level that is not a PlatformMap)\n    const T = level.T, h0 = this._h0 === undefined ? (this._h0 = this.h) : this._h0, consume = c.consume;\n    this._ledgeCD = (this._ledgeCD || 0) - dt; this._clingCD = (this._clingCD || 0) - dt; this._holdCD = (this._holdCD || 0) - dt;\n    const step = () => { level.move(this, dt, solids); return true; };\n    // a swing: the pendulum's angle and speed, pumped by left and right\n    if (this.swinging) {\n      const S = this.swinging;\n      S.w += (-this.gravity / S.L * Math.sin(S.a) + c.ix * (this.pump || 4) * Math.cos(S.a) * 32 / S.L) * dt; S.w *= 1 - .2 * dt; S.a = clamp(S.a + S.w * dt, -2.4, 2.4);\n      const tx = S.x + S.L * Math.sin(S.a), tz = S.z - S.L * Math.cos(S.a) - this.h;\n      this.vx = (tx - this.x) / dt; this.vz = (tz - this.z) / dt; step();\n      if (this.hitWall || this.hitCeiling || this.onGround) S.w *= -.3;\n      if (c.ix) this.facing = c.ix > 0 ? 1 : -1;\n      if (c.jumpPressed) { consume('jump'); this.release(140); this.jumped = true; this._cut = false; }\n      else { this.vx = S.L * S.w * Math.cos(S.a); this.vz = S.L * S.w * Math.sin(S.a); }\n      return true;\n    }\n    // climbing up onto a ledge: hands pull the body up, then a step onto the top\n    if (this.climbUp) {\n      const C = this.climbUp, u = clamp((C.t += dt) / C.dur, 0, 1), k = clamp(u / .6, 0, 1);\n      this.z = lerp(C.z0, C.z1, k * k * (3 - 2 * k)); this.x = lerp(C.x0, C.x1, clamp((u - .6) / .4, 0, 1)); this.vx = this.vz = 0;\n      if (u >= 1) { this.climbUp = null; this.onGround = true; this.z = C.z1; }\n      return true;\n    }\n    // hanging from a ledge\n    if (this.hanging) {\n      const H = this.hanging; this.vx = this.vz = 0; this.facing = H.dir;\n      if (c.jumpPressed && c.ix === -H.dir) { consume('jump'); this.hanging = null; this._ledgeCD = .3; this.vz = this.jump * .85; this.vx = -H.dir * this.run; this.facing = -H.dir; this.jumped = true; this._cut = false; return step(); }\n      if (c.up || c.jumpPressed) { if (c.jumpPressed) consume('jump'); this.hanging = null; this.climbUp = { t: 0, dur: .4, x0: this.x, z0: this.z, x1: H.dir > 0 ? H.cx * T + this.w / 2 + 2 : (H.cx + 1) * T - this.w / 2 - 2, z1: H.top }; return true; }\n      if (c.down) { this.hanging = null; this._ledgeCD = .35; this.vz = -40; }\n      return true;\n    }\n    // water: it swims while its middle is in a water tile\n    if (level.kindAt(this.x, this.z + this.h * (this.swimming ? .3 : .5)) === 'water') {\n      if (!this.swimming) { this.splash = Math.min(1, Math.abs(this.vz) / 300 + .3); this.vz *= .3; this.vx *= .6; }\n      this.swimming = true; this.climbing = false; this.dashing = 0; this.crouching = false; this.h = h0; this.onRope = this.onBars = null;\n      const sw = this.swimSpeed || this.run * .7, head = level.kindAt(this.x, this.z + this.h + 1) === 'water';\n      this.vx = approach(this.vx, c.ix * sw, 420 * dt);\n      const surf = level.kindAt(this.x, this.z + this.h * .62) !== 'water';   // (its head and shoulders out: floating)\n      this.vz = approach(this.vz, c.down ? -sw * .8 : surf ? (c.up ? 0 : -6) : c.up ? sw * .8 : -18, 320 * dt);   // it sinks slowly; at the surface it floats\n      if (c.jumpPressed) { consume('jump'); if (surf || !head) { this.vz = this.jump * .9; this.jumped = true; this._cut = false; this.splash = .6; } else { this.vz = Math.max(this.vz, 110); this.stroke = .45; } }\n      this.stroke = Math.max(0, (this.stroke || 0) - dt);\n      if (c.ix) this.facing = c.ix > 0 ? 1 : -1;\n      return step();\n    }\n    if (this.swimming) { this.swimming = false; this.splash = .5; }\n    // a rope: up grabs it; climb hand over hand; jump leaves it sideways\n    const ropeBox = { x: this.x, z: this.z, w: 2, h: this.h }, onRope = level.touching(ropeBox, 'rope');\n    if (!onRope) this.onRope = false;\n    if (!this.onRope && onRope && c.up && ok && this._holdCD <= 0) { const rc = level.cellsTouching(ropeBox, 'rope')[0]; this.onRope = true; this.x = (rc.cx + .5) * T; this.dashing = 0; }\n    if (this.onRope) {\n      const top = level.kindAt(this.x, this.z + this.h * .9 + 1) === 'rope';\n      this.vz = (c.up && top ? 1 : c.down ? -1 : 0) * this.climb * .85; this.vx = 0; this.climbing = true;\n      if (c.ix) this.facing = c.ix > 0 ? 1 : -1;\n      if (c.jumpPressed) { consume('jump'); this.onRope = false; this.climbing = false; this._holdCD = .25; this.vz = this.jump * .7; this.vx = (c.ix || this.facing) * this.run; this.jumped = true; this._cut = false; return step(); }\n      step(); if (this.onGround && c.down) { this.onRope = false; this.climbing = false; }\n      return true;\n    }\n    // monkey bars: rising (or falling) into them, the hands catch them; it travels under them\n    const handZ = this.z + this.h + 2;\n    if (!this.onBars && !this.onGround && this._holdCD <= 0 && ok && level.kindAt(this.x, handZ) === 'bars') this.onBars = { z: Math.floor(handZ / T) * T };\n    if (this.onBars) {\n      const bz = this.onBars.z; this.z = bz - this.h; this.vz = 0; this.vx = c.ix * this.run * .55; this.dashing = 0;\n      if (c.ix) this.facing = c.ix > 0 ? 1 : -1;\n      step(); this.z = bz - this.h; this.vz = 0; this.onGround = false;\n      if (c.down || c.jumpPressed || level.kindAt(this.x, bz + 1) !== 'bars') { if (c.jumpPressed) consume('jump'); this.onBars = null; this._holdCD = .3; this.vz = -20; }\n      return true;\n    }\n    // a wall it is pressed against in the air: it clings (no sliding) until it jumps off, lets go or presses down\n    if (this.wallCling && !this.onGround && this.hitWall && c.ix === this.hitWall && this._clingCD <= 0 && ok && this.vz <= 60) this.clinging = this.hitWall;\n    if (this.clinging) {\n      const d = this.clinging; this.vx = this.vz = 0; this.facing = -d;\n      if (c.jumpPressed) { consume('jump'); this.clinging = 0; this._clingCD = .2; this.vz = this.jump * .95; this.vx = -d * this.run * 1.1; this.jumped = true; this._cut = false; this.stun = .12; return step(); }\n      if (c.down || c.ix === -d || !_solidIn(level, { x: this.x + d * (this.w / 2 + 1.5), z: this.z + 2, w: 1, h: this.h - 4 })) { this.clinging = 0; this._clingCD = .25; return false; }\n      step(); this.hitWall = d; return true;\n    }\n    // a ledge falling past it: the hands catch its top\n    if (this.ledge && !this.onGround && this.vz <= 0 && this._ledgeCD <= 0 && ok && !this.climbing) {\n      const d = c.ix || this.facing, cx = Math.floor((this.x + d * (this.w / 2 + 2)) / T), hz = this.z + this.h, cz = Math.floor((hz - 1) / T), top = (cz + 1) * T;\n      if (level.kind(cx, cz) === 'solid' && level.kind(cx, cz + 1) !== 'solid' && level.kind(cx, cz + 2) !== 'solid' && hz >= top - 7 && hz <= top + 3 && !_solidIn(level, { x: this.x, z: top, w: this.w - 1, h: 4 })) {\n        this.hanging = { dir: d, top, cx }; this.x = d > 0 ? cx * T - this.w / 2 - .01 : (cx + 1) * T + this.w / 2 + .01; this.z = top - this.h; this.vx = this.vz = 0; this.facing = d; this.dashing = 0;\n        return true;\n      }\n    }\n    // crouching (and a charged dash with momentum): down on the ground; standing again needs the room\nclass Attack {\n  /** new E.Attack(spec) or new E.Attack('slash', { reach: 9 }): a name from E.MOVES plus overrides */\n  constructor(spec = {}, over) {\n    if (typeof spec === 'string') { const m = E.MOVES[spec]; if (!m) warn('move:' + spec, 'unknown move \"' + spec + '\". Moves: ' + Object.keys(E.MOVES).join(', ')); spec = Object.assign({ name: spec, hitAt: .35 }, m || E.MOVES.slash, over); }\n    else if (over) spec = Object.assign({}, spec, over);\n    /** spec: the move: seconds of wind, active and recover, and its shape for the rig (a0, a1, z0, z1, reach,\n     *  hitAt); phase: 'wind' | 'active' | 'recover', or null when idle; t: seconds into the phase; hit: the targets\n     *  this swing has hit (each is hit once) */\n    this.spec = Object.assign({ wind: .06, active: .1, recover: .18 }, spec); this.phase = null; this.t = 0; this.hit = new Set();\n  }\n  /** begin a swing if idle (or when canCancel and already recovering). Returns true if it started */\n  start(canCancel = false) {\n    if (this.phase && !(canCancel && this.phase === 'recover')) return false;\n    this.phase = 'wind'; this.t = 0; this.hit.clear(); return true;\n  }\n  /** true from the wind-up to the end of the recovery */\n  get busy() { return !!this.phase; }\n  /** true while the strike can connect */\n  get active() { return this.phase === 'active'; }\n  /** 0..1 progress through the current phase */\n  get u() { return this.phase ? clamp(this.t / this.spec[this.phase], 0, 1) : 0; }\n  /** what Humanoid.update wants as `attack` (null when idle) */\n  get state() { return this.phase ? { spec: this.spec, phase: this.phase, u: this.u } : null; }\n  /** advance the swing by dt seconds; returns the phase that began during it ('active' = play the swing sound), or\n   *  null */\n  update(dt) {\n    if (!this.phase) return null;\n    this.t += dt; let began = null;\n    while (this.phase && this.t >= this.spec[this.phase]) {\n      this.t -= this.spec[this.phase];\n      this.phase = this.phase === 'wind' ? 'active' : this.phase === 'active' ? 'recover' : null;\n      if (this.phase) began = this.phase;\n    }\n    if (!this.phase) this.t = 0;\n    return began;\n  }\n  /** during 'active', call fn(target) once per swing for each target where test(target) is true. Returns how many were hit */\n  hits(targets, test, fn) {\n    if (this.phase !== 'active' || this.u < (this.spec.hitAt || 0)) return 0;   // hitAt: share of the swing before it can connect\n    let n = 0;\n    for (const t of targets) { if (!t || t.dead || this.hit.has(t) || !test(t)) continue; this.hit.add(t); n++; fn(t); }\n    return n;\n  }\n  /** stop the swing at once (hurt, dodged into) */\n  cancel() { this.phase = null; this.t = 0; }\n}\nE.Attack = Attack;\n\n/**\n * Combo: a chain of attacks (a 3-hit punch string, a sword combo). Press again during the recover of one\n * hit (or within `window` seconds after it ends) to flow into the next; otherwise it starts over.\n *   const combo = new E.Combo([jab, jab2, uppercut], { window: .3 });   // each item is an Attack spec\n *   if (input.buffered('attack') && combo.press()) input.consume('attack');\n *   combo.update(dt); combo.hits(enemies, test, e => {...}); rig.update(dt, { ..., attack: combo.state });\n *   combo.step = index of the current hit (0, 1, 2), combo.current = its Attack\n */\n{\n  \"name\": \"my-3d2dge-handoff\",\n  \"version\": \"0.89.1\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"description\": \"my-3D2dge for coding agents: the engine, its card, index and guide, the tools and a template game\",\n  \"scripts\": {\n    \"test\": \"node game/test.mjs\",\n    \"check\": \"node tools/check.mjs game/index.html\"\n  },\n  \"devDependencies\": {\n    \"playwright\": \"1.63.0\"\n  }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_19","type":"agent_message","text":"The selected title is **Pickaxe Puddles**, and both dependencies match the plan’s pinned versions. I’m building a three-chamber mine around breakable picks, rock collisions, rising keys, and deliberate door choices, with the same simulation serving solo, couch co-op, and Hub play.\n"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,100p' 'Pickaxe-Puddles-Pick-Axe-Pete-gpt-6.1-sol-ultra-20261106-031259/vendor/engine/AI_GUIDE.md' && tail -12 'Pickaxe-Puddles-Pick-Axe-Pete-gpt-6.1-sol-ultra-20261106-031259/vendor/engine/my-3d2dge.js' && rg -n 'headless|module.exports|globalThis|document\\\\.' 'Pickaxe-Puddles-Pick-Axe-Pete-gpt-6.1-sol-ultra-20261106-031259/vendor/engine/my-3d2dge.js' | tail -15\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,100p' 'Pickaxe-Puddles-Pick-Axe-Pete-gpt-6.1-sol-ultra-20261106-031259/vendor/engine/AI_GUIDE.md' && tail -12 'Pickaxe-Puddles-Pick-Axe-Pete-gpt-6.1-sol-ultra-20261106-031259/vendor/engine/my-3d2dge.js' && rg -n 'headless|module.exports|globalThis|document\\\\.' 'Pickaxe-Puddles-Pick-Axe-Pete-gpt-6.1-sol-ultra-20261106-031259/vendor/engine/my-3d2dge.js' | tail -15\"","aggregated_output":"# my-3D2dge guide for AI models\n\nThis guide is for an AI (or a person) asked to build, port, remaster or remix a game with my-3D2dge. `API.md` is the compact reference, read whole: every single file carries it (a genre kit, `dist/my-3d2dge.html`, the compact one), and so does the handoff package. This guide explains the ideas, the workflow for remaking a classic, recipes for each genre, and the checks to run before handing a game back: search it for what you need. Its paths are the repository's (github.com/michaelcrosato/my-3d2dge); the handoff package's `README.md` says which of them it holds. Everything here matches `engine/my-3d2dge.js` v0.89.1.\n\nA coding agent that reads files gets the handoff package (`dist/handoff/`: the full engine readable, the cards, the tools, every 2D kit's game and a template game) or the agent edition alone (`dist/my-3d2dge-agent.js`: the essential engine in one readable file, its header, about 8k tokens, a complete manual with three example games). Games written for the agent edition run unchanged on the full engine, which adds the lighting, props, backdrops, touch controls and camera tools this guide also covers.\n\n## North star\n\nmy-3D2dge is a general-purpose retro-modern 2D engine built for AI models. It exists so that any model can:\n\n- port, remaster, reimagine and remix games from the 8-bit to 64-bit eras;\n- make spiritual successors that feel like modern remasters, with better visuals, physics and controls;\n- mash up mechanics across titles and genres.\n\nIt aims for **consistent quality**: the engine carries the hard parts (feel, physics, rendering, sound, UI), so each game only has to describe its rules and content.\n\n## The mental model\n\n1. **The world is 3D, the camera is 2D.** Game logic works in world units: x east, y south, z up, one tile = 16 units. A `View` projects world points to screen pixels. Switch the view and the same game renders as isometric, three-quarter, top-down, brawler, side-on or any custom angle.\n2. **Characters are puppets, not sprite sheets.** A `Humanoid` is a 3D skeleton posed by math every step (IK legs and arms, gait from velocity, jumps, attacks, cape cloth). A `Blob` is a squashy sphere. Both project through the current view. Small objects can be string sprites (`E.sprite`).\n3. **Genre kits.** Each kit handles one hard problem and knows nothing about genres, so they combine freely:\n   - `TileMap` + `Body`: ground-plane levels and physics.\n   - `PlatformMap` + `Platformer`: side-scrolling levels and a platformer controller.\n   - `Bullets` + `E.pattern`: projectiles.\n   - `Dialog` + `Menu`: text boxes and menus.\n   - scenes: title, play, game over.\n   - `game.audio`: chip sound.\n\n## Remake workflow (port, remaster, reimagine, remix)\n\n1. **Name the core loop.** Mega Man: run, jump, shoot, reach the boss. Zelda: explore rooms, fight, find keys, open doors. 1942: dodge, shoot, survive waves, beat the boss. Write it as one sentence at the top of the game.\n2. **Pick the view and the kit.** Use the genre playbook in `API.md`. A side-scroller is `PlatformMap` + `Platformer` in `'side'`; a top-down game is `TileMap` + `Body`. Pick a console resolution (`res: 'ps1'`, 320 x 240, or `'snes'`) so pixels are whole and the HUD's are known, and `expand: true` so the game fills any screen: the resolution is then the least it shows, and the HUD anchors to `r.W` and `r.H`.\n3. **Start from the closest kit.** Each genre has one, a complete small game with gameplay, HUD, win and lose, sound and touch controls: the playbook in `API.md` names it (in a single file its slice sits between `GAME START` and `GAME END`; in the handoff package it is `kits/<id>.js`). Change it into your game, with its own title and game-over scenes, and ship only that. Do not start from an empty file.\n4. **Rebuild the content.** Levels are ASCII rows with a legend, enemies are small factories, items are sprites. Keep the original's layout ideas but make your own maps; for a remix, change the rules on purpose.\n5. **Modernize.** The engine gives you most of it for free:\n   - forgiving controls: coyote time, jump buffering, variable jump height, input buffering;\n   - hit feedback: hit-stop, shake, sparks, damage numbers;\n   - smooth animation, lighting and glow;\n   - a 2.5D view (`views: ['side', 'brawler']`);\n   - pause, save data, touch controls.\n6. **Tune the feel** with the feel numbers in `API.md`, then check the game with the skeleton overlay (`rig.debug(r)`) and in slow motion (`game.timeScale = .25`).\n7. **Verify** with the checker and look at the screenshots (see the checklist at the end).\n\n## Visual craft: aim for PS1 / N64 era 2D, not NES\nPlayers judge a remake in the first screenshot. The engine's defaults reach SNES quality by themselves; games reach the PS1/N64 bar (Symphony of the Night, Metal Slug, Legend of Mana, Klonoa) when they use every layer of the look kit.\n\n**Why games look cheap, and the fix for each:**\n- *Tiny stick characters.* Use the HD Humanoid (the default) at `size: 1.2-1.4` on a 320x240 `res`, pick a `build` (`'heroic'` for tall heroes, `'bulky'` for brawlers and bosses, `'chibi'` for Mana-style RPGs), and dress every character: outfit, hair, hat, armor, sleeves, cape, and a palette of 4-6 colors per character (skin, hair, cloth, pants, boot, trim). Give enemies different silhouettes (hunch, bulky, blobs with `ears`, `horns`, `wings`, `feet`, `tail`, `mouth: 'fangs'`). Use poses (`pose: 'cheer'` on victory, `'cast'` for spells, `'guard'`, `'kneel'`, `'down'` for the defeated) instead of leaving everyone in the idle stance.\n- *Empty backgrounds.* Side views get an `E.Backdrop` (a preset or custom layers of mountains, castle, forest, city, clouds, fog) with parallax. Ground views get textured floors from `E.tex.*` with floor tags (water, lava shimmer), and walls with a material: `face: 'stone' | 'rock' | 'plank' | 'timber' | 'plaster' | 'hedge'` and `roof: 'tiles' | 'slab' | 'leaves' | 'grass'`. Never leave every wall the same brick.\n- *Flat colors.* Shade everything with `E.tones(hex)`: `deep` and `sh` on the shadow side, `base`, `lt` on lit edges, a `hi` sparkle. Shadows lean cool, highlights warm; never shade by only darkening.\n- *Bare rooms.* Put 3-8 props on every screen with `r.prop`: candles, chandeliers and stained-glass windows in castles; crates, barrels, signs and lamps in towns; trees, bushes, flowers, rocks and grass outdoors; crystals, bones, skulls, cobwebs and vines in caves; awnings, lanterns, streetlamps, hydrants, trash cans and fire drums on streets; sandbags, cactus and palms in deserts; mushrooms in forests. Tint props with `color` so they match the palette, and set `E.style.propSize = 1.4` when heroes are size 1.2+ so a door is taller than the hero.\n- *Weak hits.* Every hit gets hit-stop (`game.freeze(.04-.08)`), shake, sparks and a sound. Every death and explosion gets `particles.explosion(x, y, z, size)` and, for big ones, `game.flash`. Pickups get `particles.glints`.\n- *NES typography.* Use the default 5x7 font with a drop shadow for HUD text, `E.ui.box` gradient panels and bars, and `E.font.title` with a 3-4 color gradient and extrusion for logos. A modern adaptation (Assassin's Creed, Breath of the Wild, Arkham) wants an HTML HUD instead: `E.Shell` (below), as the STEALTH slice and the template game do; its dialogue stays `E.Dialog` with portraits.\n- *Faceless dialog.* Every talking character gets a portrait: `talk.say(lines, { name, portrait: rig })`, and `rig.drawPortrait(g, x, y, 40)` on HUDs and RPG party and status screens.\n- *Muddy lighting.* Use lights for mood, not darkness: a few warm lights (`r.prop(..., { light: true })`) over an ambient of .4-.6; GPU lighting in top-down dungeons.\n\n**Art recipes by classic** (combine with the genre recipes below):\n- *Symphony of the Night:* `res: 'ps1'`, the `'castle-night'` backdrop, PlatformMap `stone` tiles with `moss` and `brick` walls, `'back'` tiles for the rear wall, candles and candelabras every few tiles, chandeliers, stained-glass `window` props, banners and statues. The hero is `build: 'heroic'`, `outfit: 'coat'`, `hair: 'long'`, `cape`, pale skin and silver hair, and the sword chops in the screen plane by itself in the side view; enemies are skeletons (`build: 'skeleton'`, add `outfit: 'robe'` and a staff for a lich), bats (`Blob` with `wings: true, mouth: 'fangs'`), cobwebs and vines on the walls.\n- *Metal Slug:* the `'desert'` backdrop, `ground` and `metal` tiles, crates, barrels, sandbags, palms and cactus, `broken` pillars, `particles.explosion` everywhere (with `particles.ground` set so debris bounces on platforms), `bulky` soldiers with `weapon: 'gun'`, `point: true` while firing, and screen shake on every blast.\n- *Legend of Mana / Secret of Mana:* the `threequarter` view, `E.tex.grass` / `dirt` / `water` floors by floor tag (a river with `block: true` and a plank bridge), houses of `timber` or `plaster` walls under `tiles` roofs, `hedge` walls with `leaves` tops and `rock` cliffs with `grass` tops, trees, bushes, flowers, fences and mushrooms as props, `chibi` characters with `face: { eyes: 'big' }` and bright palettes, rabbites (`Blob` with `ears: 'rabbit', feet: true`), and dialog boxes with portraits.\n- *Klonoa and 2.5D platformers:* PlatformMap in the `brawler` view (tiles show their top faces), a bright `'day'` or `'forest'` backdrop, props in front of and behind the play plane (`y` of -12 and +12), and a soft camera `lead`.\n- *Final Fight / Streets of Rage:* the `brawler` view, a long street TileMap with brick and `plaster` building walls, awnings, streetlamps, hydrants, trash cans and burning fire drums along the sidewalk, `bulky` heroes and thugs with varied palettes, and big impacts.\n\n## Animation: fluid, varied, readable\nBroken animation ruins a good-looking game faster than flat art. The Humanoid rig animates procedurally, so use its vocabulary instead of moving joints by hand:\n- **Moves, not raw specs.** `new E.Attack('overhead')`, `new E.Combo(['jab', 'cross', 'hook', 'uppercut'])`. Every move in `E.MOVES` winds up, strikes with a lunge, step, lean and twist, follows through, holds, and eases back to the stance. It never sweeps backwards through its own arc.\n- **A move set per character.** A knight gets `overhead`, `thrust` and `spin`; a mage `cast`; a rogue `jab`, `thrust` and `backslash`; a monk `jab`, `cross`, `roundhouse` and `flyingkick`; a brute `haymaker`, `bash` and `sweep`; a beast `claw`. Two heroes must never share one swing.\n- **Stances and poses between attacks.** Brawlers walk with `stance: 'guard'`, knights with `stance: 'ready'`. Win with `pose: 'cheer'`, cast with `'cast'`, block with `'block'` (weapons) or `'guard'` (fists), duck with `'crouch'`, taunt with `'hips'` or `'wave'`, fall with `down`, die with `'die'` (stagger, knees, topple), and climb ladders with `climb: true`. Faces act too: `expr: 'smile' | 'shout' | 'angry' | 'wince'`, and a Dialog portrait's mouth moves while its line types.\n- **Enemies telegraph.** Give enemy attacks a longer `wind` (.2-.35 s) than the hero's, so players can read and dodge them. Flash and knock back on hit, lie `down` on death.\n- **Check the motion.** `node tools/filmstrip.mjs game.html#scene --steps \"... rec:16:2 press:KeyJ\" --crop x,y,w,h` records the swing frame by frame. Look for the wind-up, the strike and a clean settle. Add `--seed 1` for a repeatable strip, and `--compare before.html` (a copy of the page from before your change) to see exactly which pixels your change moved.\n\n## Hard rules\n\n1. **Game logic in world units, `dt` everywhere.** Never store screen pixels. Convert only when drawing (`r.w(x, y, z)`) or reading the mouse (`game.mouseGround()`). `update(dt)` runs in exact fixed steps: every 1/120 s of real time is one step of `dt = 1/120 * game.timeScale`, so the same inputs play the same at 60, 90, 120 or 144 Hz.\n2. **Draw only with engine primitives** (`E.px.*`, `E.font`, `E.ui`, sprites, props, `r.*` helpers). `ctx.arc`, `ctx.stroke`, `ctx.fillText`, canvas gradients and scaled `drawImage` anti-alias and break the pixel look. Translucency goes through the engine helpers (`px.blend`, `px.polyDither`, `px.ddisc`, `r.glowDisc`, `r.shadow`): stepped alpha with blend modes by default (PS1 / N64 / SNES color math), or ordered dithering with `E.style.trans = 'dither'` for NES, Game Boy and Genesis looks.\n3. **Anything that overlaps goes through the queue**: `r.actor`, `r.sprite` or `r.queue`. Only backgrounds are drawn directly (`r.sky`, `map.drawFloor`, `level.draw`, parallax shapes).\n4. **Animate with continuous values** (phases, velocities, eased timers), never frame lists.\n5. **Read input in `update`**: `pressed` for one-shot actions, `down` for held, `buffered` + `consume` for combat.\n6. **A game is one script on the engine:** in a single file, the code between `GAME START` and `GAME END`; with files, `game.js` beside the `index.html` that loads the engine (inline both into the page to hand a person one file). **The engine is yours to change too.** Your copy (a clone of the repository, the handoff package, a single file) is yours to fix, extend or rewrite in any way you see fit. The readable engine is `engine/my-3d2dge.js` and `engine/modules/` in the repository (`node tools/build.mjs` rebuilds every page from them), `my-3d2dge.js` in the handoff package (every page and test there loads it), and the script marked \"inlined from engine/my-3d2dge.js\" in `dist/my-3d2dge.html`; a genre kit's is minified. If you hand the game back, a line on what you changed and why helps: it shows what the engine lacks.\n7. **Don't rebuild the standard features** (below): the pause menu, settings, key rebinding, full screen and pausing on focus loss come with every game. Adjust them with `new E.Game({ menu: {...} })`.\n\n## Standard features (built in: adjust them, don't rebuild them)\nEvery `new E.Game(...)` comes with what players expect of a modern release, so your code goes to the game itself. They're tested on both editions, they work with keys, mouse, gamepad and touch, and the player's choices are saved per game.\n- **Pause menu** (full engine): a pausable scene pauses on Escape, P, Start, the touch START button or the corner's menu button, and shows Resume, your items, Settings, Controls, Full screen, Help (when your `E.Shell` has one) and Quit to title (it asks first; Keep playing has the focus). Arrows, d-pad and stick move, Enter or A chooses, Escape or B goes back one screen, P or Start closes the menu. The game sees none of those presses.\n- **Settings** (`game.settings`): Display (full screen; pixel scaling for a fixed `res`: Auto, Sharp, Fill; a screen filter: Clean, Scanlines or CRT, drawn as the picture reaches the canvas, never on the game's buffer, and off under a test harness, so screenshots and filmstrips stay clean), Sound (sound, volume, music, effects, the audio offset with its calibration), Comfort (reduce motion, screen shake, screen flashes), and yours. Saved per game with a version (`E.store` key `settings:` + the page's path, or `id`); a bad saved value falls back to its default, and where storage is blocked the game plays on (`game.settings.saved` is false).\n- **Controls**: every action of the current preset, rebound by pressing the new key, mouse button or gamepad button (a conflict is said and nothing changes; Escape, Enter, the F keys, Start, the arrow keys and the d-pad stay with the menus, so a player can't lock themselves out), the controller (dead zone, invert aim, button symbols: Xbox, PlayStation, Nintendo or positions, vibration) and the touch buttons (always, automatic or hidden; right or left side; size; opacity). Restore defaults resets the controls and never touches a save.\n- **Full screen** (`game.fullscreen`): a phone's first tap goes full screen, the top-right button and the menu toggle it, and once the player leaves it the game never forces it back. Where a browser can't (an iPhone), the settings say to use Share, then Add to Home Screen; the page carries the home-screen app tags.\n- **Pausing by itself**: a pausable scene pauses when the page is hidden, the window loses focus or the controller in use is unplugged (`game.pauseReason` says which), and only the player resumes.\n- **The corner**: a menu button and a full-screen button at the top right, inside the safe area. They show on titles, game overs and pauses, for a moment when the mouse nears the top, and the menu stays on a touch screen with no touch buttons; in play they're gone. Keep a title's art clear of the top-right 110 x 60 CSS pixels, or pass `corner: false`.\n- **Phones**: a viewport that reaches the safe areas (pinch zoom left alone), no page scrolling, zooming, selection or callouts on the canvas, touch buttons inside the safe areas, a touch stick with a dead zone that also presses the directions past halfway (menus, dialog choices, ladders), a bottom dialog that keeps clear of the touch buttons, menus picked by a tap or click on an entry and dialogs turned by a tap on the box (a title needs no touch buttons), and a fixed `res` filling a high-density screen (`expand: true` fills every screen).\n- **Boot** (a loading screen and a crash report): heavy setup (a procedural level, a big table, baked caches, data from a promise) goes in boot steps, run one a frame behind a boot screen that shows the system's checks (engine, browser, screen, canvas, GPU, sound, storage, input), each step, a progress bar and lines of the game's own, like the Sims' \"Reticulating splines\"; then the game draws a warm-up frame under it, so play starts without a hitch. `game.start({ scenes, scene: 'title', boot: { title: 'VESPER', version: '1.0', steps: [['Raising the harbour', () => { map = buildHarbour(); }], ['Waking the guards', () => loadGuards()]], messages: ['Counting the bells', 'Oiling the hinges'], min: 0 } })`. A step may return a promise; headless (and with `loop: false`) the steps run at once and `await game.booted` waits for any promise. If a step throws, or anything fails before play, the screen becomes a report a player can screenshot: what failed, the error, a short code, the engine and game versions, browser, screen, canvas, GPU, sound, storage and input, with Try again, Copy report and Continue. `E.diagnose()` gives the same report any time (`.text`, `.short`); after play, errors go to the red box with its short line. `E.bootSplash(title)` is the screen's markup for the very start of `<body>`, so it shows while the page's scripts load (the starter files and the handoff template have it). Keep a boot short: no step should wait on purpose (`min` is for a splash you want seen).\n- **Juice that respects the player**: `game.shake` and `game.flash` follow the comfort settings, `game.hitFx` rumbles a gamepad (the vibration setting; `rumble: false` skips it), and `game.input.rumble(strength, seconds)` does it for your own moments.\n\nAdjust them:\n```js\nconst game = new E.Game({ canvas: 'screen', res: 'ps1', view: 'side', input: 'PLATFORMER',\n  menu: {\n    items: [['Restart level', () => game.go('play', { level })]],                 // pause-menu buttons after Resume\n    settings: [{ key: 'hints', label: 'Hints', value: true },                      // yours, beside the standard ones\n      { key: 'difficulty', options: ['Easy', 'Normal', 'Hard'], value: 'Normal', help: 'How hard enemies hit' }],\n      const id = C[row * W + c]; if (!id) continue;\n      const M = this.materials[id - 1], P = this._rgb[id - 1], air = (cc, rr) => cc >= 0 && rr >= 0 && cc < W && rr < this.h && !C[rr * W + cc];\n      let up = 0; for (let d = 1; d <= M.depth; d++) if (air(c, row - d)) { up = d; break; }\n      const rim = air(c - 1, row) || air(c + 1, row) || air(c, row + 1), n = (hash(c, row) - .5) * 18 + (hash(c >> 2, row >> 2) - .5) * 14;\n      const base = up ? P.t : rim ? P.e : P.c, l = up === 1 ? 24 : 0;\n      D[o] = Math.max(0, Math.min(255, base[0] + n + l)); D[o + 1] = Math.max(0, Math.min(255, base[1] + n + l)); D[o + 2] = Math.max(0, Math.min(255, base[2] + n * .7 + l)); D[o + 3] = 255;\n    }\n    g.putImageData(img, 0, 0); return cv;\n  }\n}\nE.Terrain = Terrain;\n})(typeof My3D2dge !== 'undefined' ? My3D2dge : undefined);\n10520:      if (document.readyState !== 'complete' && PERSON.includes(KIND[e.type])) { e.stopImmediatePropagation(); return; }\n10525:    if (document.body) first(); else addEventListener('DOMContentLoaded', first);\n10533:      const a = document.createElement('a'); a.href = URL.createObjectURL(file); a.download = name; document.body.appendChild(a); a.click(); a.remove();\n10544:  getter(document, 'fullscreenElement', () => fs ? document.documentElement : null); getter(document, 'webkitFullscreenElement', () => fs ? document.documentElement : null);\n10547:  document.exitFullscreen = document.webkitExitFullscreen = () => Promise.resolve();\n10549:  // elements padded by env(safe-area-inset-*) report the device's insets (a headless browser has none)\n10606:})(typeof window !== 'undefined' ? window : globalThis);\n10631:const E = My3D2dge, game = new E.Game({ headless: true }), cab = new E.Arcade(game, { id: 'doc', lives: 2, extra: [500] });\n10863:const E = My3D2dge, game = new E.Game({ headless: true });\n11445:const E = My3D2dge, game = new E.Game({ headless: true });\n13157:const E = My3D2dge, game = new E.Game({ headless: true }); game.start({ update() {}, draw() {} });\n13527:const E = My3D2dge, game = new E.Game({ headless: true });\n14191:const E = My3D2dge, game = new E.Game({ headless: true });\n14411:const E = My3D2dge, game = new E.Game({ headless: true, view: 'topdown' }), map = new E.TileMap({ w: 20, h: 14 });\n14676:    const cam = { view: G.view, ix: Math.floor(G.cam.x), iy: Math.floor(G.cam.y) }, at = o.at || ((sx, sy) => { const h = this.map.pick(sx, sy, cam); return h ? [h.x, h.y] : G.view.toGround(sx + cam.i [... omitted end of long line]\n","exit_code":0,"status":"completed"}}
