{"type":"item.completed","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"sed -n '88,115p' 'Pickaxe-Puddles-Pick-Axe-Pete-gpt-6.1-sol-ultra-20261106-031259/src/sim/sim.js' && sed -n '165,212p' 'Pickaxe-Puddles-Pick-Axe-Pete-gpt-6.1-sol-ultra-20261106-031259/src/view/view.js' && sed -n '1,130p' 'Pickaxe-Puddles-Pick-Axe-Pete-gpt-6.1-sol-ultra-20261106-031259/src/sim/pilot.js'\"","aggregated_output":"        const x = (a.x + b.x) / 2, z = (a.z + b.z) / 2, redirected = a.redirected !== null || b.redirected !== null;\n        this.destroy(a, null, true); this.destroy(b, null, true); this.director.collisions++;\n        const chain = this.lastCollision && this.time - this.lastCollision < 3.5 ? Math.min(4, this.chain + 1) : 1; this.chain = chain; this.lastCollision = this.time; this.bestChain = Math.max(this.bestChain, chain);\n        this.scoreEvent(((redirected ? 9 : 6) + (this.route === 2 ? 3 : 0)) * chain); this.emit('collision', { x, z, chain, text: `${redirected ? 'TRICK SHOT' : 'ROCK COLLISION'} ×${chain}` });\n        const deck = this.room.deck, reward = deck[this.director.deckAt++ % deck.length];\n        if (reward === 'pick' || this.miners.filter(m => !m.downed).every(m => m.tool <= 0)) this.spawnPickup('pick', x, z + 24);\n        else if (reward === 'key' && this.canKey()) this.spawnPickup('key', x, Math.max(28, z - 20));\n        else this.spawnPickup('gold', x, z + 4);\n      }\n      this.contacts = [...active];\n    }\n    canKey() { return this.chamber < 2 ? this.director.kills >= 4 || this.chamberTime > 26 : this.director.wave >= 3 && (this.director.waveProgress >= 4 || this.director.collisions >= 3); }\n    hurt(m, r) {\n      if (m.invuln > 0 || this.invincible || this.attract || m.downed || this.transition > 0) return;\n      m.health--; m.invuln = 2.4; m.hero.knock(r.x < m.hero.x ? 1 : -1, 90, 140, .22); m.attack.cancel();\n      this.emit('hurt', { miner: m.id, x: m.hero.x, z: m.hero.z + 12, text: m.health ? 'HELMET DENT! · keep moving' : 'DOWN! · partner can rescue' });\n      if (m.health <= 0) { m.downed = true; m.hero.vx = m.hero.vz = 0; this.recoverKey(m.id); this.emit('knockout', { miner: m.id, x: m.hero.x, z: m.hero.z }); }\n    }\n    recoverKey(id) { if (this.keyOwner !== id) return; this.keyOwner = null; this.spawnPickup('key', 136, 26); this.emit('keyRecovered', { x: 136, z: 26, text: 'KEY RECOVERED · intake landing' }); }\n    removeMiner(id) { this.recoverKey(id); this.miners = this.miners.filter(m => m.id !== id); this.emit('leave', { miner: id }); if (!this.miners.length) this.finish(false, 'No miners remain'); }\n    addMiner(seat) { if (this.online || this.miners.length >= 2 || this.chamberTime > 8) return false; this.miners.push(this.makeMiner(seat)); this.emit('join', { miner: seat.id, text: 'PARTNER CLOCKED IN!' }); return true; }\n    nearDoor(m) { return this.room.doors.find(d => Math.abs(d.x - m.hero.x) < 38 && Math.abs(d.z - m.hero.z) < 23) || null; }\n    interact(m, held) {\n      const fallen = this.miners.find(n => n.id !== m.id && n.downed && Math.abs(n.hero.x - m.hero.x) < 36 && Math.abs(n.hero.z - m.hero.z) < 28);\n      if (fallen && held) { fallen.rescue += this._dt; if (fallen.rescue >= this.tuning.rescueTime) { fallen.downed = false; fallen.health = 2; fallen.invuln = 3; fallen.rescue = 0; m.stats.rescues++; this.emit('rescue', { x: fallen.hero.x, z: fallen.hero.z, miner: fallen.id, text: 'BACK IN BUSINESS!' }); } return true; }\n      return false;\n    }\n    unlock(m, door) {\n      const fade=form?.4:1;\n      px.blend(g,fade,'normal',()=>{\n        px.line(g,p[0]-5*ppu,p[1],q[0]-5*ppu,q[1],'#233d40',Math.max(3,ppu*3));px.line(g,p[0]+5*ppu,p[1],q[0]+5*ppu,q[1],'#233d40',Math.max(3,ppu*3));\n        px.line(g,p[0]-5*ppu,p[1],q[0]-5*ppu,q[1],c,Math.max(1,ppu*1.4));px.line(g,p[0]+5*ppu,p[1],q[0]+5*ppu,q[1],c,Math.max(1,ppu*1.4));\n        for(let z=l.z0+5;z<l.z1;z+=8){const a=r.w(l.x-5,0,z),b=r.w(l.x+5,0,z),show=!warn||flashes(settings)||Math.floor(t*5)%2===0;px.line(g,a[0],a[1],b[0],b[1],show?lit:c,Math.max(1,ppu*1.5));}\n      });\n      if(l.temporary){const a=r.w(l.x,0,l.z1+7);px.poly(g,[[a[0]-3*ppu,a[1]],[a[0],a[1]-4*ppu],[a[0]+3*ppu,a[1]],[a[0],a[1]+3*ppu]],c);if(warn)r.textAt(l.x,0,l.z1+15,'!',A.CORAL,{align:'center',scale:1,outline:false});}\n    }\n    drawDoor(r,d,sim,t,settings) {\n      const c=d.color||color(Number(d.id)||0),ppu=r.ppu,warning=Number(d.warning)>0||d.state==='warning';\n      r.shape('ppMechanism',d.x,-6,d.z,{scale:.9,mats:{g:c},shadow:false,hides:false,bias:-2});\n      r.queue(d.x,-4,d.z,g=>{\n        const p=r.w(d.x,0,d.z),w=20*ppu,h=35*ppu,tones=E.tones(c),hot=warning&&!flashes(settings)&&Math.floor(t*5)%2===0;\n        r.glowDisc(g,p[0],p[1]-h*.42,38*ppu,c,warning?.08:.025);\n        px.rect(g,p[0]-w*.51,p[1]-h*.93,w*1.02,h*.92,'#071b22');\n        for(let i=0;i<4;i++)px.rect(g,p[0]-w*.45+i*w*.25,p[1]-h*.88,Math.max(1,ppu*1.2),h*.82,warning?tones.base:'#2f494a');\n        // Colored jambs and a carved emblem: shape carries the meaning even in grayscale.\n        px.rect(g,p[0]-w*.68,p[1]-h,w*.17,h,tones.sh);px.rect(g,p[0]+w*.51,p[1]-h,w*.17,h,tones.sh);px.rect(g,p[0]-w*.68,p[1]-h,w*1.36,3.3*ppu,hot?'#fff2bc':tones.lt);\n        const x=p[0],y=p[1]-h-10*ppu,s=6*ppu,symbol=String(d.symbol||d.id);\n        px.disc(g,x,y,9*ppu,'#142e35');\n        if(/triangle|▲|△|1|sun|flare/i.test(symbol)){px.poly(g,[[x,y-s],[x+s,y+s*.65],[x-s,y+s*.65]],tones.lt);px.poly(g,[[x,y-s*.4],[x+s*.4,y+s*.35],[x-s*.4,y+s*.35]],tones.sh);}\n        else if(/moon|crescent/i.test(symbol)){px.disc(g,x,y,s,tones.lt);px.disc(g,x+s*.42,y-s*.3,s*.82,'#142e35');}\n        else if(/star/i.test(symbol)){const points=[];for(let i=0;i<10;i++){const a=-Math.PI/2+i*Math.PI/5,rr=s*(i%2?.43:1);points.push([x+Math.cos(a)*rr,y+Math.sin(a)*rr]);}px.poly(g,points,tones.lt);}\n        else if(/diamond|◆|◇|2|crystal/i.test(symbol)){A.diamond(g,x,y,s,tones.lt);}\n        else {px.rect(g,x-s*.7,y-s*.7,s*1.4,s*1.4,tones.lt);px.rect(g,x-s*.36,y-s*.36,s*.72,s*.72,tones.sh);}\n        // Door bolts and pressure gauge.\n        for(const x of[-1,1])for(const yy of[4,26]){px.disc(g,p[0]+x*16*ppu,p[1]-yy*ppu,1.4*ppu,'#adc5b2');}\n        if(warning){const a=p[1]-13*ppu;px.poly(g,[[p[0]-6*ppu,a],[p[0],a-11*ppu],[p[0]+6*ppu,a]],A.CORAL);px.rect(g,p[0]-ppu,a-8*ppu,2*ppu,4*ppu,'#1b3033');px.dot(g,p[0],a-2*ppu,'#1b3033');}\n        else if(sim.keyOwner!==null&&sim.keyOwner!==undefined){A.key(g,p[0]-ppu,p[1]-h*.48,.65*ppu,c);}\n      },{bias:-1,hides:false,emissive:true});\n      r.textAt(d.x,0,d.z+58,d.name||'SHAFT',c,{align:'center',outline:false,scale:.95,shadow:'#071b20'});\n      if(warning)r.textAt(d.x,0,d.z+71,'INCOMING',A.CORAL,{align:'center',outline:false,scale:1,shadow:'#071b20'});\n    }\n    drawRock(r,b,t,settings) {\n      const ppu=r.ppu,radius=b.r||9,kind=b.kind||'normal',c=kind==='heavy'?'#8c9a9a':kind==='bounce'?'#5faaa6':'#a29478',T=E.tones(c),seed=seedOf(b.id),angle=(b.x||0)/radius;\n      r.actor(b.x,0,b.z,(g,ox,oy)=>{\n        const p=[ox,oy],rad=radius*ppu,verts=[];\n        for(let i=0;i<9;i++){const a=i*Math.PI*2/9+angle,rr=rad*(.88+hash(seed,i)*.17);verts.push([p[0]+Math.cos(a)*rr,p[1]+Math.sin(a)*rr]);}\n        px.poly(g,verts,T.sh);px.poly(g,[verts[0],verts[1],verts[2],[p[0]-rad*.1,p[1]-rad*.18],verts[8]],T.lt);px.poly(g,[verts[2],verts[3],verts[4],[p[0]-rad*.1,p[1]-rad*.18]],T.base);px.poly(g,[verts[5],verts[6],verts[7],[p[0]+rad*.17,p[1]+rad*.13]],T.deep);\n        for(let i=0;i<4;i++){const a=angle+hash(seed+4,i)*6.28,x=p[0]+Math.cos(a)*rad*.6,y=p[1]+Math.sin(a)*rad*.6;px.line(g,x,y,x+rad*.2,y-rad*.08,kind==='bounce'?'#b8eee1':'#e5c16d',Math.max(1,ppu*1.5));}\n        if(kind==='heavy'){\n          px.line(g,p[0]-rad*.76,p[1]-rad*.43,p[0]+rad*.75,p[1]-rad*.08,A.CORAL,Math.max(2,ppu*2.8));px.line(g,p[0]-rad*.72,p[1]+rad*.13,p[0]+rad*.64,p[1]+rad*.49,A.CORAL,Math.max(2,ppu*2.8));\n          for(let i=0;i<Math.max(0,b.hp||0);i++)px.rect(g,p[0]+(i-1)*4*ppu,p[1]-rad-5*ppu,2*ppu,2*ppu,'#ffc0a0');\n        }else if(kind==='bounce')for(let i=0;i<4;i++){const a=i*Math.PI*.5+angle,q=[p[0]+Math.cos(a)*rad,p[1]+Math.sin(a)*rad];px.poly(g,[[q[0]+Math.cos(a+.9)*2.5*ppu,q[1]+Math.sin(a+.9)*2.5*ppu],[p[0]+Math.cos(a)*rad*1.3,p[1]+Math.sin(a)*rad*1.3],[q[0]+Math.cos(a-.9)*2.5*ppu,q[1]+Math.sin(a-.9)*2.5*ppu]],A.TEAL);}\n        if(b.redirected!==null&&b.redirected!==undefined){const cc=this._sim?.miners.find(m=>m.id===b.redirected)?.color||(b.redirected===2?A.TEAL:A.GOLD);px.line(g,p[0]-Math.sign(b.vx||1)*rad*1.2,p[1],p[0]-Math.sign(b.vx||1)*rad*2.3,p[1]+rad*.2,cc,Math.max(1,ppu*2));px.line(g,p[0]-rad*.75,p[1]-rad*.8,p[0]+rad*.55,p[1]-rad*.8,b.grace>0?'#fff4c2':A.CORAL,Math.max(1,ppu));}\n      },{outline:true,rim:true,emissive:true});\n    }\n    drawPickup(r,p,t,settings) {\n(() => {\n  'use strict';\n  const PP = globalThis.PP;\n  // The pilot uses the same canonical actions as every human input adapter.\n  PP.pilot = (sim, id = sim.miners[0]?.id, route = 0) => {\n    const m = sim.miners.find(p => p.id === id), out = { mx: 0, my: 0, jump: false, jumpHeld: false, chop: false, redirect: false, interact: false, interactHeld: false, aim: 0 };\n    if (!m || m.downed || sim.completed || sim.transition > 0) return out;\n    const h = m.hero;\n    // Keep a deliberate jump held while rising; releasing one tick after takeoff\n    // would turn both gap leaps and defensive jumps into ineffective short hops.\n    out.jumpHeld = h.vz > 0 && !h.climbing;\n    const key = sim.pickups.find(p => p.kind === 'key'), pick = sim.pickups.find(p => p.kind === 'pick');\n    const fallen = sim.miners.find(p => p.id !== id && p.downed);\n    const pickup = m.tool <= 0 && pick ? pick : key || (m.tool < 2 ? pick : null);\n    let target = pickup?.kind === 'pick' && m.tool <= 0 ? pickup : sim.keyOwner !== null ? sim.room.doors[route % 3] : pickup || (fallen ? { x: fallen.hero.x, z: fallen.hero.z } : null);\n    if (fallen && Math.abs(fallen.hero.x - h.x) < 55 && Math.abs(fallen.hero.z - h.z) < 28) target = { x: fallen.hero.x, z: fallen.hero.z };\n    if (!target) {\n      const near = sim.rocks.filter(r => Math.abs(r.z - h.z - 14) < 35).sort((a, b) => Math.abs(a.x - h.x) - Math.abs(b.x - h.x))[0];\n      if (m.tool > 0) target = near ? { x: near.x - Math.sign(near.x - h.x || 1) * 32, z: h.z } : { x: 296, z: 16 };\n      else {\n        // The visible supply seam opens below. Wait on a safe upper landing,\n        // then descend for the falling replacement instead of chasing live ore.\n        const ladder = Math.abs(h.x - 104) < Math.abs(h.x - 456) ? 104 : 456;\n        target = { x: ladder, z: h.z < 60 ? 80 : sim.room.floors.reduce((best, f) => f.z <= h.z + 2 ? f.z : best, 16) };\n      }\n    }\n    let targetZ = target.z;\n    if (target === pickup) {\n      if (pickup.kind === 'pick') targetZ = 16;\n      else targetZ = sim.room.floors.reduce((best, f) => Math.abs(f.z + 14 - pickup.z) < Math.abs(best + 14 - pickup.z) ? f.z : best, 16);\n    }\n    const dx = target.x - h.x;\n    if (targetZ > h.z + (h.climbing ? 1 : 25)) {\n      const ladder = [104, 456].sort((a, b) => Math.abs(a - h.x) - Math.abs(b - h.x))[0];\n      if (Math.abs(ladder - h.x) > 6 && !h.climbing) out.mx = Math.sign(ladder - h.x);\n      else out.my = -1;\n    } else if (targetZ < h.z - 26) {\n      out.my = 1;\n      if (!h.climbing && h.onGround) { out.jump = true; out.jumpHeld = true; }\n    } else if (h.climbing) {\n      out.mx = Math.sign(dx || 1); out.jump = true; out.jumpHeld = true;\n    } else {\n      out.mx = Math.abs(dx) > (sim.keyOwner !== null && target !== pickup ? 24 : 11) ? Math.sign(dx) : 0;\n      const f = sim.room.floors.find(f => Math.abs(f.z - h.z) < 2);\n      if (f && h.onGround && out.mx && f.gaps.some(([a, b]) => h.x + out.mx * 20 > a && h.x + out.mx * 20 < b)) { out.jump = true; out.jumpHeld = true; }\n    }\n    const danger = sim.rocks.filter(r => Math.abs(r.x - h.x) < 70 && Math.abs(r.z - h.z - 15) < 36).sort((a, b) => Math.abs(a.x - h.x) - Math.abs(b.x - h.x))[0];\n    if (danger) {\n      const dir = Math.sign(danger.x - h.x || 1),distance=Math.abs(danger.x-h.x);\n      if (h.climbing && distance < 25 && danger.grace <= 0) {\n        out.mx = -dir; out.my = 0; out.jump = true; out.jumpHeld = true;\n      } else if (!h.climbing && m.tool > 0) {\n        if (dir !== m.facing && distance > 14) out.mx = dir;\n        out.chop = true;\n        const collisionTarget = sim.rocks.some(r => r !== danger && (r.x - danger.x) * dir > 0 && Math.abs(r.z - danger.z) < 28 && Math.abs(r.x-danger.x)<150);\n        if (!m.attack.busy && distance < 53 && ((danger.kind === 'heavy' && danger.hp > 1) || collisionTarget)) {\n          out.redirect = true; out.chop = false; out.aim = collisionTarget ? 1 : -1;\n        }\n      } else if (!h.climbing && distance < 53 && h.onGround) {\n        if (danger.kind === 'bounce' && danger.z > h.z + 32) { out.my = 1; out.jump = false; out.jumpHeld = false; }\n        else { out.jump = true; out.jumpHeld = true; }\n      }\n    }\n    if (sim.keyOwner !== null && target !== pickup && sim.nearDoor(m)?.id === sim.room.doors[route % 3].id) out.interact = true;\n    if (fallen && Math.abs(fallen.hero.x - h.x) < 35 && Math.abs(fallen.hero.z - h.z) < 26) out.interactHeld = true;\n    return out;\n  };\n  // Kiosk-only staging may cheat; contacts still use the real action path.\n  PP.attractIntent = (sim, id, route = 1) => {\n    const intent = PP.pilot(sim, id, route), m = sim.miners.find(m => m.id === id);\n    if (!sim.attract || !m) return intent;\n    if (!sim.demoRicochet && sim.chamber === 0 && sim.chamberTime >= 8 && sim.transition <= 0) {\n      sim.demoRicochet = true; sim.demoRicochetTick = sim.tick; m.hero.x = 200; m.hero.z = 16; m.hero.vx = m.hero.vz = 0; m.hero.facing = m.facing = 1; m.tool = 6; m.attack.cancel();\n      sim.rocks = []; sim.spawnRock({ x: 232, z: 30, vx: -20 }); sim.spawnRock({ x: 310, z: 30, vx: -48 });\n      return { ...intent, mx: 0, my: 0, chop: false, jump: false, jumpHeld: false, redirect: true, aim: 1 };\n    }\n    if (sim.demoRicochetTick && sim.tick - sim.demoRicochetTick < 155) return { ...intent, mx: 0, my: 0, jump: false, jumpHeld: false, chop: false, redirect: false };\n    return intent;\n  };\n})();\n","exit_code":0,"status":"completed"}}
