{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,200p' 'Pickaxe-Puddles-Pick-Axe-Pete-gpt-6.1-sol-ultra-20261106-031259/tests/sim.test.mjs' && sed -n '360,450p' 'Pickaxe-Puddles-Pick-Axe-Pete-gpt-6.1-sol-ultra-20261106-031259/src/audio/audio.js' && cat 'Pickaxe-Puddles-Pick-Axe-Pete-gpt-6.1-sol-ultra-20261106-031259/docs/dependencies.md'\"","aggregated_output":"import assert from 'node:assert/strict';\nimport {readFileSync} from 'node:fs';\nimport vm from 'node:vm';\nconst root=new URL('../',import.meta.url), context=vm.createContext({console,performance});\nfor(const file of ['vendor/engine/my-3d2dge.js','src/content/content.js','src/sim/sim.js','src/sim/pilot.js'])vm.runInContext(readFileSync(new URL(file,root),'utf8'),context,{filename:file});\nconst {PP,My3D2dge:E}=context,dt=1/120;\nconst plain=x=>JSON.parse(JSON.stringify(x));\nconst neutral=()=>({mx:0,my:0,jump:false,jumpHeld:false,chop:false,redirect:false,interact:false,interactHeld:false,aim:0});\nfunction fixture(options={}){const s=new PP.Sim(options);s.transition=0;s.director.spawnIn=1e6;s.director.pairIn=1e6;s.director.noKey=-1e6;s.miners.forEach((m,i)=>{m.hero.x=200+i*15;m.hero.z=16;});return s;}\nfunction ticks(s,count,input=neutral(),id=s.miners[0]?.id){for(let i=0;i<count&&!s.completed;i++)s.step(dt,typeof input==='function'?input(s,i):{[id]:input});return s;}\nfunction until(s,predicate,input=neutral(),limit=120*30,id=s.miners[0]?.id){for(let i=0;i<limit&&!s.completed;i++){if(predicate(s))return i;s.step(dt,typeof input==='function'?input(s,i):{[id]:input});}assert.ok(predicate(s),'condition was not reached before tick budget');return limit;}\nfunction core(s){const out=plain(s.snapshot());delete out.events;return out;}\nexport async function runSimTests(){\n let count=0;const failures=[];const times=[];\n const test=(name,fn)=>{try{fn();count++;}catch(error){failures.push(`${name}: ${error.stack||error}`);}};\n test('content IDs, tier adapter, gaps and reachable ladder landings',()=>{\n  assert.equal(new Set(PP.CHAMBERS.map(r=>r.id)).size,3);\n  for(let chamber=0;chamber<3;chamber++)for(let route=0;route<3;route++){\n   const room=PP.makeRoom(chamber,route),level=PP.makeLevel(room);assert.equal(room.tiers,5+chamber);\n   assert.equal(new Set([...room.ladders,...room.doors].map(x=>x.id)).size,room.ladders.length+3);\n   for(const f of room.floors){for(let cx=0;cx<36;cx++){const gap=f.gaps.some(([a,b])=>cx*16+8>=a&&cx*16+8<b);assert.equal(level.cell(cx,f.z/16-1),gap?0:1,`row conversion chamber${chamber} floor${f.z} col${cx}`);}}\n   for(const l of room.ladders)for(const z of[l.z0,l.z1]){const f=room.floors.find(f=>f.z===z);assert.ok(f&&!f.gaps.some(([a,b])=>l.x>=a-5&&l.x<=b+5),`ladder ${chamber}:${l.id} has no safe landing at ${z}`);}\n  }\n });\n test('native coyote jump after leaving a ledge',()=>{\n  const s=fixture(),m=s.miners[0],f=s.room.floors[1],a=f.gaps[0][0];m.hero.x=a-10;m.hero.z=f.z;m.hero.onGround=true;\n  until(s,()=>!m.hero.onGround,{...neutral(),mx:1},60);s.step(dt,{1:{...neutral(),mx:1,jump:true,jumpHeld:true}});assert.equal(m.hero.jumped,true);assert.ok(m.hero.vz>0);\n });\n test('native buffered jump triggers on landing',()=>{\n  const s=fixture(),h=s.miners[0].hero;h.z=23;h.vz=-90;h.onGround=false;\n  s.step(dt,{1:{...neutral(),jump:true,jumpHeld:true}});let jumped=h.jumped;for(let i=0;i<20&&!jumped;i++){s.step(dt,{1:{...neutral(),jumpHeld:true}});jumped=h.jumped;}assert.ok(jumped);\n });\n test('native variable-height jump and crouch silhouette',()=>{\n  const apex=held=>{const s=fixture(),h=s.miners[0].hero;ticks(s,3);let max=h.z;for(let i=0;i<150;i++){s.step(dt,{1:{...neutral(),jump:i===0,jumpHeld:i<held}});max=Math.max(max,h.z);}return max;};\n  assert.ok(apex(70)>apex(2)+18);\n  const s=fixture(),h=s.miners[0].hero;ticks(s,3);const height=h.h;ticks(s,4,{...neutral(),my:1});assert.ok(h.crouching);assert.ok(h.h<height*.7);ticks(s,4);assert.equal(h.h,height);\n });\n test('permanent native ladders reach every tier on every route',()=>{\n  for(let chamber=0;chamber<3;chamber++)for(let route=0;route<3;route++)for(const x of[104,456]){\n   const s=fixture({chamber});s.route=route;s.miners[0].hero.x=x;const z=s.room.floors.at(-1).z;\n   until(s,()=>s.miners[0].hero.z>=z-.1,{...neutral(),my:-1},120*8);assert.ok(s.tutorial.ladder);\n   ticks(s,6,{...neutral(),mx:1,jump:true});assert.equal(s.miners[0].hero.climbing,false);\n  }\n });\n test('temporary ladder expiry grants occupied climber grace',()=>{\n  const s=fixture(),l=s.room.ladders.find(x=>x.temporary),h=s.miners[0].hero;\n  s.chamberTime=s.tuning.ladderPeriod*.9-l.offset;h.x=l.x;h.z=(l.z0+l.z1)/2;h.climbing=true;s.updateLadders(true);\n  assert.equal(l.state,'warning');assert.equal(s.level.kind(Math.floor(l.x/16),Math.floor(h.z/16)),'ladder');\n  until(s,()=>h.z>=l.z1-.1,{...neutral(),my:-1},240);ticks(s,3,{...neutral(),mx:1,jump:true});assert.equal(h.climbing,false);\n  s.updateLadders();assert.notEqual(l.state,'usable');\n });\n test('safe drops preserve health and bottom safety net recovers',()=>{\n  const s=fixture(),h=s.miners[0].hero;h.x=220;h.z=80;h.onGround=false;until(s,()=>h.onGround,neutral(),120);assert.equal(h.z,16);assert.equal(s.miners[0].health,3);\n  h.z=-40;s.step(dt,{1:neutral()});assert.equal(h.z,16);assert.equal(h.x,104);assert.equal(s.miners[0].health,3);\n });\n test('one contact per native swing and misses cost no durability',()=>{\n  const s=fixture(),m=s.miners[0];ticks(s,3);const r=s.spawnRock({x:223,z:29,vx:0,kind:'heavy'});\n  ticks(s,20,{...neutral(),chop:true});assert.equal(r.hp,2);assert.equal(m.tool,5);assert.equal(s.eventLog.filter(e=>e.type==='chopHit').length,1);\n  s.rocks=[];ticks(s,120,{...neutral(),chop:true});assert.equal(m.tool,5);\n });\n test('heavy ore needs three distinct chops and one final break event',()=>{\n  const s=fixture(),m=s.miners[0];m.tool=3;const r=s.spawnRock({x:223,z:29,vx:0,kind:'heavy'});\n  for(let hits=0;hits<3;hits++){\n   r.x=m.hero.x+23;r.z=m.hero.z+14;r.vx=0;r.vz=0;\n   const before=m.tool;until(s,()=>m.tool<before,{...neutral(),chop:true},120);ticks(s,40,neutral());\n  }\n  assert.equal(m.tool,0);assert.ok(r.dead);assert.equal(s.eventLog.filter(e=>e.type==='toolBreak').length,1);assert.equal(m.stats.ore,1);\n });\n test('redirect anticipation, timed contact, high/low arcs, grace and one wear',()=>{\n  for(const aim of[-1,1]){\n   const s=fixture(),m=s.miners[0],r=s.spawnRock({x:223,z:30,vx:0});\n   s.step(dt,{1:{...neutral(),redirect:true,aim}});assert.equal(r.redirected,null);assert.equal(m.tool,6);\n   ticks(s,10,{...neutral(),aim});assert.equal(r.redirected,m.id);assert.equal(m.tool,5);assert.ok(r.grace>0);assert.equal(m.stats.redirects,1);assert.ok(aim<0?r.vz>140:r.vz<0);\n   ticks(s,8);assert.equal(m.tool,5);\n  }\n });\n test('resolution order: final tool wear, pair collision, same-tick fresh pick',()=>{\n  const s=fixture(),m=s.miners[0];m.tool=1;s.spawnRock({x:211,z:30,vx:0,kind:'heavy'});s.spawnRock({x:229,z:30,vx:0});\n  m.action='chop';m.attack.start();m.attack.phase='active';m.attack.t=.02;s.step(dt,{1:neutral()});\n  const types=s.eventLog.map(e=>e.type),a=types.indexOf('toolBreak'),b=types.indexOf('collision'),c=types.indexOf('pickCollect');assert.ok(a>=0&&a<b&&b<c,types.join(','));assert.equal(m.tool,s.tuning.durability);assert.equal(m.stats.tools,1);assert.equal(s.director.collisions,1);\n });\n test('collision pair/reward deduplication and seeded deck reproducibility',()=>{\n  const a=fixture({seed:44}),b=fixture({seed:44});\n  for(const s of[a,b])for(let i=0;i<9;i++){s.spawnRock({x:296,z:100,vx:0});s.spawnRock({x:300,z:100,vx:0});s.rockPairs();s.rockPairs();s.rocks=s.rocks.filter(r=>!r.dead);}\n  assert.equal(a.director.collisions,9);assert.equal(a.director.deckAt,9);assert.equal(a.score,b.score);assert.deepEqual(plain(a.pickups),plain(b.pickups));assert.equal(new Set(a.pickups.map(p=>p.id)).size,a.pickups.length);\n });\n test('bounded tool opportunity and complete unarmed recovery through real input',()=>{\n  const s=fixture({seed:99}),m=s.miners[0];m.tool=0;\n  until(s,()=>s.pickups.some(p=>p.kind==='pick'),neutral(),120*16);assert.ok(s.chamberTime<=s.tuning.recoveryWait+3.8);assert.ok(s.eventLog.some(e=>e.type==='supplyWarning'));\n  until(s,()=>m.tool>0,(s)=>({1:PP.pilot(s,1,0)}),120*40);assert.equal(m.tool,s.tuning.durability);assert.ok(s.eventLog.some(e=>e.type==='pickCollect'));\n });\n test('key expiry produces another unique achievable progression opportunity',()=>{\n  const s=fixture();s.invincible=true;s.director.kills=5;s.director.noKey=0;s.spawnPickup('key',400,60).ttl=.01;\n  ticks(s,4);assert.ok(s.eventLog.some(e=>e.type==='keyExpired'));until(s,()=>s.pickups.some(p=>p.kind==='key'),neutral(),120*14);\n  assert.ok(s.chamberTime<12);assert.equal(s.pickups.filter(p=>p.kind==='key').length,1);assert.equal(s.spawnPickup('key',100,26),null);\n });\n test('key collection races award once; explicit unlock and comic jam',()=>{\n  const s=fixture({seats:[{id:1},{id:2}]}),[a,b]=s.miners;a.hero.x=200;b.hero.x=200;s.spawnPickup('key',200,30);s.step(dt,{1:neutral(),2:neutral()});assert.equal(s.keyOwner,1);assert.equal(s.score,10);assert.equal(a.stats.keys+b.stats.keys,1);assert.equal(s.pickups.length,0);\n  const door=s.room.doors[0];a.hero.x=door.x;a.hero.z=door.z;ticks(s,3);assert.equal(s.nextChamber,undefined);\n  s.step(dt,{1:{...neutral(),interact:true}});assert.equal(s.nextChamber,1);assert.equal(s.score,30);s.step(dt,{1:{...neutral(),interact:true}});assert.equal(s.score,30);\n  const j=fixture(),m=j.miners[0];m.hero.x=j.room.doors[0].x;j.step(dt,{1:{...neutral(),interact:true}});assert.ok(m.jam>0);assert.equal(j.tutorial.jam,true);ticks(j,65,{...neutral(),mx:1});assert.equal(m.jam,0);assert.ok(m.hero.x>j.room.doors[0].x+20);\n });\n test('damage invulnerability, full wipe, standalone checkpoint retry and Hub refusal',()=>{\n  const s=fixture(),m=s.miners[0],r={x:m.hero.x-1};m.invuln=0;s.hurt(m,r);assert.equal(m.health,2);s.hurt(m,r);assert.equal(m.health,2);\n  for(let i=0;i<2;i++){m.invuln=0;s.hurt(m,r);}s.step(dt,{1:neutral()});assert.equal(s.completed.won,false);\n  s.score=999;s.banked=20;s.checkpoint={chamber:1,score:20,route:2};assert.equal(s.retry(),true);assert.equal(s.chamber,1);assert.equal(s.route,2);assert.equal(s.score,20);assert.equal(m.health,3);assert.equal(m.tool,6);assert.equal(s.completed,null);\n  const net=fixture({online:true});net.finish(false);assert.equal(net.retry(),false);\n });\n test('co-op rescue, carrier departure recovery and safe join ownership',()=>{\n  const s=fixture({seats:[{id:1,name:'Puddles'},{id:2,name:'Pebble'}]}),[a,b]=s.miners;b.downed=true;b.health=0;b.hero.x=a.hero.x+12;\n  ticks(s,Math.ceil(s.tuning.rescueTime*120)+2,{...neutral(),interactHeld:true});assert.equal(b.downed,false);assert.equal(b.health,2);assert.equal(a.stats.rescues,1);\n  s.keyOwner=2;s.removeMiner(2);assert.equal(s.keyOwner,null);assert.equal(s.miners.length,1);const key=s.pickups.find(p=>p.kind==='key');assert.equal(key.x,136);assert.equal(key.z,26);\n  const local=fixture();assert.equal(local.addMiner({id:2,name:'Pebble'}),true);assert.equal(local.addMiner({id:3}),false);assert.equal(local.miners[0].id,1);\n  const online=fixture({online:true});assert.equal(online.addMiner({id:2}),false);\n });\n test('snapshot preserves mid-jump, mid-ladder, RNG and subsequent events',()=>{\n  const s=fixture({seed:17,seats:[{id:1},{id:2}]});s.chamberTime=16;\n  s.miners[0].hero.x=200;s.miners[0].hero.z=16;ticks(s,3);s.step(dt,{1:{...neutral(),jump:true,jumpHeld:true},2:neutral()});ticks(s,8,(s)=>({1:{...neutral(),jumpHeld:true},2:neutral()}));\n  const h=s.miners[1].hero;h.x=104;h.z=48;h.climbing=true;h.vz=78;s.updateLadders(true);\n  const snapshot=plain(s.snapshot()),copy=new PP.Sim();copy.restore(snapshot);assert.deepEqual(core(copy),core(s),'snapshot core changed during restore');\n  for(let i=0;i<180;i++){\n   const intents={1:{...neutral(),mx:i%40<20?1:-1,jumpHeld:i<20},2:{...neutral(),my:-1}};s.step(dt,intents);copy.step(dt,intents);\n  }\n  assert.deepEqual(core(copy),core(s),'restored simulation diverged');assert.equal(s.random(),copy.random());assert.deepEqual(plain(copy.events),plain(s.events));\n });\n test('live tuning validates clamps and complete defaults reset',()=>{\n  const s=fixture();for(const [key,spec]of Object.entries(PP.TUNING)){assert.equal(s.setTuning(key,spec.max+99),true);assert.equal(s.tuning[key],spec.max);s.setTuning(key,spec.min-99);assert.equal(s.tuning[key],spec.min);}assert.equal(s.setTuning('bad',2),false);s.tuning=PP.validTuning({});assert.deepEqual(plain(s.tuning),plain(PP.defaults()));\n });\n for(let route=0;route<3;route++)test(`unassisted normal-input expedition route ${route} and ordered feature evidence`,()=>{\n  const s=new PP.Sim({seed:99});assert.equal(s.invincible,false);\n  until(s,()=>!!s.completed,s=>({1:PP.pilot(s,1,route)}),120*400);assert.equal(s.completed.won,true,JSON.stringify(s.completed));\n  const events=s.eventLog,find=(type,start=0)=>events.findIndex((e,i)=>i>=start&&e.type===type);let cursor=0;\n  for(const type of['chamber','chopHit','keyCollect','unlock','chamber','keyCollect','unlock','chamber','wave','wave','keyCollect','unlock','victory']){const i=find(type,cursor);assert.ok(i>=0,`route${route}: missing ordered ${type}`);cursor=i+1;}\n  const breakAt=find('toolBreak');assert.ok(breakAt>=0&&find('pickCollect',breakAt)>breakAt,`route${route}: no armed → unarmed → renewed circuit`);\n  assert.equal(events.filter(e=>e.type==='unlock').length,3);assert.equal(events.filter(e=>e.type==='chamber').length,3);assert.equal(s.chamber,2);assert.ok(s.director.wave>=3);assert.ok(s.bestChain>=1);assert.ok(s.time<900-60);times.push({route,seconds:Number(s.time.toFixed(2)),score:s.score,health:s.miners[0].health});\n });\n test('two simultaneous normal-input miners complete shared objective',()=>{\n  const s=new PP.Sim({seed:99,seats:[{id:1,name:'Puddles'},{id:2,name:'Pebble'}]});until(s,()=>!!s.completed,s=>Object.fromEntries(s.miners.map(m=>[m.id,PP.pilot(s,m.id,1)])),120*400);assert.equal(s.completed.won,true);assert.ok(s.miners.every(m=>m.health>0));assert.equal(s.eventLog.filter(e=>e.type==='unlock').length,3);assert.ok(s.miners.reduce((n,m)=>n+m.stats.ore,0)>6);\n });\n if(failures.length)throw new Error(`Simulation failures (${failures.length}):\\n${failures.join('\\n')}`);\n return {count,times};\n}\nif(process.argv[1]===new URL(import.meta.url).pathname){try{const {count}=await runSimTests();console.log(`${count} simulation checks passed`);}catch(error){console.error(error.message);process.exitCode=1;}}\n\t\t\tconst type = rawType === \"rock\" ? evt.kind : aliases[rawType] || rawType;\n\t\t\tconst id = typeof evt === \"object\" ? evt.id : null;\n\t\t\tif (id != null) {\n\t\t\t\tif (this.seen.has(id)) return;\n\t\t\t\tthis.seen.add(id);\n\t\t\t\tthis.seenQueue.push(id);\n\t\t\t\tif (this.seenQueue.length > 2048)\n\t\t\t\t\tthis.seen.delete(this.seenQueue.shift());\n\t\t\t}\n\t\t\tif (type === \"victory\" || type === \"win\") this._sting(true);\n\t\t\telse if (type === \"defeat\" || type === \"lose\" || type === \"wipe\")\n\t\t\t\tthis._sting(false);\n\t\t\tconst spec = EVENTS[type];\n\t\t\tif (spec && this.ctx) {\n\t\t\t\tconst last = this._eventTimes.get(type) ?? -99;\n\t\t\t\tif (this.ctx.currentTime - last > 0.035) {\n\t\t\t\t\tthis._eventTimes.set(type, this.ctx.currentTime);\n\t\t\t\t\tthis._play(\"sfx\", spec);\n\t\t\t\t\tif (\n\t\t\t\t\t\ttype === \"collision\" ||\n\t\t\t\t\t\ttype === \"shatter\" ||\n\t\t\t\t\t\ttype === \"rockBreak\"\n\t\t\t\t\t)\n\t\t\t\t\t\tthis._play(\"sfx\", [\"sine\", 130, 42, 0.19, 0.15]);\n\t\t\t\t\tif (type === \"heavy\")\n\t\t\t\t\t\tthis._play(\"sfx\", [\"noise\", 220, 80, 0.22, 0.1]);\n\t\t\t\t}\n\t\t\t}\n\t\t\tconst speech = SPEAK[type];\n\t\t\tif (speech) this.say(speech[0], speech[1]);\n\t\t}\n\t\tsay(text, pitches = [270, 360, 300]) {\n\t\t\tthis.caption = { text, until: (this.ctx?.currentTime || 0) + 2.2 };\n\t\t\tif (\n\t\t\t\t!this.ctx ||\n\t\t\t\tthis.disposed ||\n\t\t\t\tthis.paused ||\n\t\t\t\tthis.ctx.state !== \"running\" ||\n\t\t\t\tthis._volume(\"voice\", 0.65) <= 0\n\t\t\t)\n\t\t\t\treturn;\n\t\t\tconst now = this.ctx.currentTime;\n\t\t\tif (now < (this._nextSpeech || 0)) return;\n\t\t\tthis._nextSpeech = now + 0.65;\n\t\t\tfor (const [i, frequency] of pitches.entries()) {\n\t\t\t\tsyllable(\n\t\t\t\t\tthis.ctx,\n\t\t\t\t\tthis.buses.voice,\n\t\t\t\t\tnow + 0.008 + i * 0.085,\n\t\t\t\t\tfrequency,\n\t\t\t\t\t0.065 + (i % 2) * 0.025,\n\t\t\t\t\tthis.noise,\n\t\t\t\t\tthis.nodes,\n\t\t\t\t);\n\t\t\t}\n\t\t\tthis.counts.voice += pitches.length;\n\t\t}\n\t\t_sting(won) {\n\t\t\tif (!this.ctx || this.disposed) return;\n\t\t\tconst notes = won ? [60, 64, 67, 72, 76, 79, 84] : [64, 62, 59, 55, 48];\n\t\t\tconst now = this.ctx.currentTime + 0.01;\n\t\t\tfor (const [i, note] of notes.entries()) {\n\t\t\t\tthis._play(\n\t\t\t\t\t\"sfx\",\n\t\t\t\t\t[\"triangle\", midi(note), midi(note), won ? 0.27 : 0.4, 0.19],\n\t\t\t\t\tnow + i * (won ? 0.09 : 0.14),\n\t\t\t\t);\n\t\t\t}\n\t\t\tthis.nextNote = now + 1.35;\n\t\t}\n\t\tupdate(dt, sim) {\n\t\t\tif (this.disposed) return;\n\t\t\tif (sim?.events) for (const evt of sim.events) this.event(evt);\n\t\t\tif (sim?.room)\n\t\t\t\tthis.chamber = clamp(Number(sim.room.index ?? sim.chamber) || 0, 0, 2);\n\t\t\tif (sim?.completed && !this._finished) {\n\t\t\t\tthis._finished = true;\n\t\t\t\tconst type = sim.completed.won ? \"victory\" : \"defeat\";\n\t\t\t\tif (!sim.events?.some((e) => e.type === type)) this.event(type);\n\t\t\t} else if (!sim?.completed) this._finished = false;\n\t\t\tif (!this.ctx || !this.unlocked || this.ctx.state !== \"running\") return;\n\t\t\tif (this.caption && this.ctx.currentTime > this.caption.until)\n\t\t\t\tthis.caption = null;\n\t\t\tconst miner = sim?.miners?.find((m) => !m.downed),\n\t\t\t\thero = miner?.hero;\n\t\t\tconst tick = Math.floor((sim?.time || 0) * 5);\n\t\t\tif (\n\t\t\t\t!this.paused &&\n\t\t\t\thero &&\n\t\t\t\ttick !== this._lastStep &&\n\t\t\t\thero.onGround &&\n# Dependency provenance\n\nAll dependencies were checked against their actual repository contents on 2026-11-06. Neither upstream baseline had changed from PLAN.md.\n\n| Dependency | Actual version | Commit | Local source |\n| --- | --- | --- | --- |\n| my-3d2dge handoff, full native engine | 0.89.1 | `8ecc2f62353761187bdfe226f327b7ea5d2eb691` | `vendor/engine/`, copied from a sparse clone of [upstream](https://github.com/michaelcrosato/my-3d2dge/tree/8ecc2f62353761187bdfe226f327b7ea5d2eb691/dist/handoff) |\n| AI Hub Session Protocol | 1; client 1.4.0 | `35a1047f2067b2af3de3943f0fe452f39105d869` | `vendor/hub/`, copied from [upstream](https://github.com/michaelcrosato/ai-hub/tree/35a1047f2067b2af3de3943f0fe452f39105d869/lib/hub) |\n| Official Hub checker and support | same commit | `35a1047f2067b2af3de3943f0fe452f39105d869` | `vendor/hub/scripts/hub-check.mjs`, `scripts/lib/hub-client.mjs`, `scripts/lib/serve.mjs` |\n| Playwright Python environment | 1.63.0 | unknown | Installed workstation environment; browsers already present. No browser install is needed. |\n| Node.js | 24.21.0 | unknown | Installed workstation runtime, used for packaging and deterministic tests. |\n\n`vendor/hub/session.js` is pristine. Full-file SHA-256 is `6ab6be43898e2db069bc21a94757d77d9c3f2a0cb76f01186490d3bd88d8717a`; the official checker hashes the banner-to-last-line portion, which matches release 1.4.0 (`529eac78c54cfff0e60d375a9c63f66d1a594327ddcc262a2bdf9b1f2fb6582a`). The final packager must embed it byte-for-byte as the first script immediately after charset; it must not pass through game-code transforms.\n\nThe official harness, bridge and round files are vendored unchanged under `vendor/hub/lib/hub/`; relative module imports resolve there. The quiet verification wrapper serves the game and harness from one owned 127.0.0.1 origin on an OS-selected port and never records catalogue overrides.\n\n## Engine patches\n\nOne game-wide patch was made to `vendor/engine/my-3d2dge.js`, in `Screen.resize` around line 690: when the viewport is smaller than a fixed logical buffer (`fit < 1`), the screen uses the fractional fit scale rather than clamping to scale 1. Larger-screen integer scaling and the existing fill behavior remain unchanged. This prevents the 960×720 game from being cropped on phone viewports and in narrow Hub frames. The untouched sparse-clone copy in `vendor/engine-repo/dist/handoff/my-3d2dge.js` preserves the reviewable upstream baseline. No networking or simulation rules were changed inside the engine; the Hub client and official checker/harness remain unmodified.\n\n## Integration decisions\n\nStandalone co-op is two simultaneous local players. Internet shared-world co-op is available when AI Hub supplies a session; the library supplies no standalone lobby/matchmaking service. The transport uses only `AIHub.send` while active. No media files, external realtime services or CDN runtime dependencies are required by the game adapter.\n","exit_code":0,"status":"completed"}}
