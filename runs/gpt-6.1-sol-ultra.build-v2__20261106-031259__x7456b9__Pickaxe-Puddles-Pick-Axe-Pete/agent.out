dex*83,\n        colors:{skin:second?'#deb58d':'#f1c194',hair:second?'#a9503e':'#743f2b',cloth:second?'#5aa9a0':'#c38a43',pants:second?'#364c67':'#456571',boot:'#3e362d',belt:'#543b2a',glove:'#d6b080',metal:'#bed8d4',hilt:'#b4834b',eye:'#172f36',trim:second?'#c0f5df':'#f4db9a'},\n        draw:{over:(g,Q,rr)=>{\n          if(second||!Q.head)return;\n          const p=Q.head,u=(rr.lastView?.scale||1.5)*rr.o.size,face=rr.facing===Math.PI?-1:1;\n          px.poly(g,[[p[0]+face*1.5*u,p[1]+.8*u],[p[0]+face*4*u,p[1]+2*u],[p[0]+face*.8*u,p[1]+5.1*u],[p[0]-face*2*u,p[1]+2.6*u]],'#7b442c');\n          px.line(g,p[0]+face*.4*u,p[1]+2*u,p[0]+face*2.8*u,p[1]+2.4*u,'#e5b287',Math.max(1,u*.65));\n        }}});\n      const entry={rig,wasGround:true,hurt:0,breakT:0,pickT:0,keyT:0,wear:6};this.rigs.set(m.id,entry);return entry;\n    }\n    update(dt,sim,settings={}) {\n      if(!sim)return;this._sim=sim;this.t+=dt;\n      const epoch=sim.epoch??sim.runEpoch??0;\n      if(this.lastEpoch!==null&&this.lastEpoch!==epoch){this.fx=[];}\n      this.lastEpoch=epoch;\n      const room=sim.room||{},tiers=room.tiers||room.floors?.length||5,top=16+(tiers-1)*64;\n      const W=this.game.W||960,H=this.game.H||720;\n      this.portrait=!!this.game.screen?.portrait;\n      const zoom=this.portrait?clamp(Math.min(1.75,(H-Math.max(260,190/(this.game.screen?.S||1)))/((top+76)*1.5)),.65,1.75):clamp(Math.min((W-104)/(632*1.5),(H-195)/((top+76)*1.5)),.5,1.15);\n      const camera=`${W}:${H}:${tiers}:${this.portrait}`;\n      const miner=(sim.miners||[]).find(m=>m.id===this.localId)||(sim.miners||[]).find(m=>!m.downed)||(sim.miners||[])[0];\n      const half=W/(zoom*1.5)/2,lo=Math.min(288,half),hi=Math.max(288,576-half);\n      const targetX=this.portrait?clamp((miner?.hero?.x??288)+clamp((miner?.hero?.vx||0)*.18,-24,24),lo,hi):288;\n      if(this.lastCamera!==camera){this.game.setZoom(zoom);this.lastCamera=camera;this.cameraX=targetX;}\n      else this.cameraX=reduced(settings)?targetX:this.cameraX+(targ