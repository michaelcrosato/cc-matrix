n(', ') + ' or [width, height]'); return null; }\n    return [Math.max(16, v[0] | 0), Math.max(16, v[1] | 0)];\n  }\n  /** fit the buffer to the canvas again (on window resize; after changing sizing options, setOptions does it) */\n  resize() {\n    const c = this.canvas, dpr = c ? Math.min(window.devicePixelRatio || 1, 3) : 1, rc = c ? c.getBoundingClientRect() : { width: 1280, height: 720 };\n    const pw = Math.max(1, Math.round(rc.width * dpr)), ph = Math.max(1, Math.round(rc.height * dpr)), o = this._options(pw, ph);\n    /** portrait: true while the screen is taller than wide (a phone held upright) */\n    if (c) { c.width = pw; c.height = ph; } this.dpr = dpr; this.portrait = ph > pw;\n    const fix = this._fixedRes(o);\n    if (fix) {\n      // fixed resolution: whole-number scale, letterboxed (or the largest fit: scale). HUD pixel positions stay the same on every screen.\n      // o.expand: the resolution is the least the screen shows, and the picture grows on both sides to fill the window\n      // (no bars at any shape, up to expand.maxW x maxH): a HUD anchors to W and H\n      const fit = Math.min(pw / fix[0], ph / fix[1]), fill = this.scale === 'fill' || (this.scale === 'auto' && dpr >= 2 && fit >= 2), x = o.expand;\n      this.S = fill ? Math.max(1, fit) : Math.max(1, Math.min(Math.floor(pw / fix[0]), Math.floor(ph / fix[1])));\n      this.W = x ? clamp(Math.ceil(pw / this.S - 1e-6), fix[0], Math.max(fix[0], x.maxW || 1e4)) : fix[0]; this.H = x ? clamp(Math.ceil(ph / this.S - 1e-6), fix[1], Math.max(fix[1], x.maxH || 1e4)) : fix[1];   // (a cap never cuts below res)\n    } else {\n      const S = Math.max(1, Math.min(Math.floor(ph / o.minH), Math.floor(pw / o.minW)));\n      this.S = S; this.W = Math.min(o.maxW, Math.ceil(pw / S)); this.H = Math.min(o.maxH, Math.ceil(ph / S));\n    }\n    this.OX = Math.floor((pw - this.W * this.S) / 2); this.OY = Math.floor((ph - this.H * this.S) / 2);\n    if (this.buf) { this.buf.width = this.W + 2; this.buf.height = this.H + 2; this.ctx = ctx2d(this.buf); this.ctx._c = null; }\n    for (const f of this.listeners) f();\n  }\n  /** change sizing at runtime, e.g. { minH: 400, maxW: 1080, maxH: 660 } to pull the camera back */\n  setOptions(o) { Object.assign(this._o, o); this.resize(); }\n  /** how a fixed resolution fills the screen: 'sharp' | 'fill' | 'auto' (see scale) */\n  setScale(v) { this.scale = v === 'sharp' || v === 'fill' ? v : 'auto'; this.resize(); }\n  /** clear: true when the game's bg is null (or 'transparent'): the buffer and the canvas are cleared instead of filled,\n   *  so a picture under the canvas shows through the game's (a 3D world drawn by engine/my-3d2dge-3d.js) */\n  get clear() { return this._o.bg == null || this._o.bg === 'transparent'; }\n  /** start a frame: clear the buffer to bg with the camera at (cx, cy) projected pixels (the renderer calls it) */\n  _begin(cx, cy, bg, vp) {\n    this.ix = Math.floor(cx); this.iy = Math.floor(cy); this.fx = vp ? 0 : cx - this.ix; this.fy = vp ? 0 : cy - this.iy;   // (a split screen's viewports: whole pixels)\n    const g = this.ctx, [x, y, w, h] = vp ? [vp.x, vp.y, vp.w, vp.h] : [0, 0, this.buf.width, this.buf.height]; g.globalAlpha = 1; g.globalCompositeOperation = 'source-over'; g._c = null;\n    if (bg == null || bg === 'transparent') g.clearRect(x, y, w, h);\n221:\t\t\tthis.caption = null;\n392:\t\t\tthis.caption = { text, until: (this.ctx?.currentTime || 0) + 2.2 };\n441:\t\t\tif (this.caption && this.ctx.currentTime > this.caption.until)\n442:\t\t\t\tthis.caption = null;\n546:\t\t\tthis.caption = null;\n593:\t\t\t\tcaption: this.caption?.text || null,\n616:\t\t\tthis.caption = null;\nimport { createServer } from 'node:http';\nimport { execFile, spawn } from 'node:child_process';\nimport { createHash } from 'node:crypto';\nimport { mkdir, readFile, symlink, writeFile } from 'node:fs/promises';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { promisify } from 'node:util';\nimport { staticHandler } from '../vendor/hub/scripts/lib/serve.mjs';\n\nconst exec = promisify(execFile);\nconst DEV = fileURLToPath(new URL('../', import.meta.url));\nconst WORK = path.dirname(DEV);\n\nasync function testModulePath() {\n  try {\n    const { createRequire } = await import('node:module');\n    createRequire(import.meta.url).resolve('playwright');\n    return process.env.NODE_PATH || '';\n  } catch { /* Reuse the installed Python Playwright driver's identical JS package. */ }\n  const python = process.env.PLAYWRIGHT_PYTHON || '/home/micha/.local/share/pipx/venvs/playwright/bin/python';\n  const { stdout } = await exec(python, ['-c', 'import pathlib, playwright; print(pathlib.Path(playwright.__file__).parent / \"driver\" / \"package\")']);\n  const nodePath = path.join(DEV, '.cache', 'test-node');\n  await mkdir(nodePath, { recursive: true });\n  await symlink(stdout.trim(), path.join(nodePath, 'playwright'), 'dir').catch(error => { if (error.code !== 'EEXIST') throw error; });\n  return nodePath;\n}\n\nexport async function runHubChecks() {\n  const config = JSON.parse(await readFile(path.join(WORK, 'build-config.json'), 'utf8'));\n  const htmlName = `${config.stem}.html`;\n  const html = await readFile(path.join(WORK, htmlName), 'utf8');\n  const serve = staticHandler(WORK);\n  const server = createServer((request, response) => {\n    if (request.url.startsWith('/lib/hub/')) request.url = `/${path.basename(DEV)}/vendor/hub${request.url}`;\n    serve(request, response);\n  });\n  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));\n  const base = `http://127.0.0.1:${server.address().port}`;\n  try {\n    const identity = await (await fetch(`${base}/${htmlName}`)).text();\n    if (identity !== html || !identity.includes(`<title>${config.title}`)) throw new Error('Owned Hub origin did not serve the expected game');\n    const nodePath = await testModulePath();\n    const checker = path.join(DEV, 'vendor', 'hub', 'scripts', 'hub-check.mjs');\n    const report = await new Promise((resolve, reject) => {\n      const child = spawn(process.execPath, [checker, `/${htmlName}`, '--base', base, '--players', '1,2', '--json', '--no-solo'], { cwd: DEV, env: { ...process.env, NODE_PATH: nodePath }, stdio: ['ignore', 'pipe', 'pipe'] });\n      let stdout = '', stderr = '';\n      child.stdout.on('data', data => { stdout += data; }); child.stderr.on('data', data => { stderr += data; });\n      child.once('error', reject);\n      child.once('close', code => {\n        let result; try { result = JSON.parse(stdout); } catch { return reject(new Error(`Official Hub checker returned invalid output (${code}): ${stderr || stdout}`)); }\n        result.stderr = stderr;\n        if (!result.pass) return reject(new Error(`Official Hub conformance failed:\\n${JSON.stringify(result, null, 2)}`));\n        resolve(result);\n      });\n    });\n    // The unchanged checker waits for body[data-complete=true] and asserts __hubCheck.pass.\n    const checks = report.runs.reduce((total, run) => total + run.checks.length, 0);\n    await mkdir(path.join(DEV, 'evidence'), { recursive: true });\n    await writeFile(path.join(DEV, 'evidence', 'hub-report.json'), JSON.stringify({ generated: new Date().toISOString(), htmlSha256: createHash('sha256').update(html).digest('hex'), checks, ...report }, null, 2));\n    return checks;\n  } finally { await new Promise(resolve => server.close(resolve)); }\n}\n\nif (process.argv[1] === fileURLToPath(import.meta.url)) {\n  try { console.log(`${await runHubChecks()} official Hub checks passed`); } catch (error) { console.error(error.message); process.exitCode = 1; }\n}\n","exit_code":0,"status":"completed"}}
