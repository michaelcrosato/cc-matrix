]; this.remote = new Map(); this.assemblies = new Map(); this.queue = [];\n      this.localEdges = counters(); this.localAck = counters(); this.lastLocal = neutral(); this.localSeq = 0;\n      this.sendAt = 0; this.lastFull = -Infinity; this.lastPose = -Infinity; this.lastInput = -Infinity;\n      this.sequence = 0; this.lastFullId = -1; this.lastPoseId = -1; this.pose = null; this.lastEpoch = null;\n      this.stats = { sent: 0, received: 0, rejected: 0, dropped: 0, maxBytes: 0, maxRate: 0, snapshots: 0, inputs: 0 };\n      this.sendTimes = []; this.accumulator = 0; this.timer = null;\n      this.gameplayRng = null; this.presentationRng = null;\n    }\n    async connect() {\n      const hub = this.hub = globalThis.AIHub;\n      if (!hub) return false;\n      const info = await hub.connect({ mode: 'shared-world', seats: [1, 2] });\n      if (!info || this.disposed) return false;\n      this.active = true; this.isHost = !!hub.isHost; this.server = !!hub.server; this.localId = this.server ? null : hub.me;\n      this.roster = info.players.map(p => ({ id: p.id, name: String(p.name), color: p.color }));\n      this.gameplayRng = hub.rng('pickaxe-puddles/gameplay'); this.presentationRng = hub.rng('pickaxe-puddles/presentation');\n      const seed = Math.floor(this.gameplayRng() * 4294967296) >>> 0;\n      this.sim = this.createSim({ seed, seats: this.roster, online: true });\n      this.lastEpoch = epochOf(this.sim);\n      for (const p of this.roster) this.remote.set(p.id, { seq: -1, edges: counters(), consumed: counters(), intent: neutral(), at: -Infinity });\n      this.handlers.push(hub.on('start', detail => {\n        this.started = true; this.setStatus('countdown', detail);\n      }));\n      this.handlers.push(hub.on('message', (data, from) => this.receive(data, from)));\n      this.handlers.push(hub.on('leave', ({ id, reason }) => {\n        this.roster = this.roster.filter(p => p.id !== id); this.remote.delete(id);\n        if (this.isHost && !this.ended) {\n   