{"type":"item.started","item":{"id":"item_89","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/view/preview.html');p.write_text(p.read_text().replace('room:{index:2,tiers:7,','room:{index:2,tiers:7,finale:{waves:3},'))\np=Path('docs/authoring.md');s=p.read_text();s=s.replace('Extend the expedition’s final index in \"'`Sim.enter`/door completion if adding a chamber beyond this complete three-room expedition, and author a finale condition for that expedition.'\"','The expedition ends after the last data record. Set the last room’s \"'`finale` object to `{ waves: 3, clearsPerWave: 5, keyClears: 4, collisions: 3, timeout: 32 }` (or authored values); omit or disable it on ordinary rooms. Finale conditions and palette ramps are data, so adding a room does not require core simulation changes. Add a sky ramp to `PP.PALETTES` for another palette name.'\"');p.write_text(s)\nPY\nbiome check --write src/main.js src/content/content.js src/sim src/view tests/sim.test.mjs --diagnostic-level=error --max-diagnostics=10\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
