o.climbing && intent.my > .25) hero.drop = .1;\n      hero.update(dt, this.sim.level, { x: miner.jam > 0 ? intent.mx * .25 : intent.mx, up: intent.my < -.25, down: intent.my > .25, jump: intent.jumpHeld || intent.jump, jumpPressed: !!intent.jump }, this.sim.roomSolids || []);\n      hero.x = Math.max(14, Math.min(562, hero.x));\n      if (hero.z < -28) { hero.x = 104; hero.z = 16; hero.vx = hero.vz = 0; }\n      for (const key of ['x', 'z', 'vx', 'vz', 'facing', 'onGround', 'climbing', 'crouching']) miner.hero[key] = hero[key];\n      miner.facing = hero.facing;\n    }\n    reject() { this.stats.rejected++; }\n    finish(won, reason) {\n      if (!this.isHost || this.finished || this.ended || this.disposed) return;\n      this.finished = true; this.queue = []; this.queueSnapshot(); this.sendAt = 0;\n      const ids = this.roster.map(p => p.id);\n      const score = Number(this.sim.score) || 0;\n      const stats = Object.fromEntries(ids.map(id => [id, { ...(this.sim.miners.find(p => p.id === id)?.stats || {}), Outcome: String(reason) }]));\n      this.pendingOutcome = { standings: ids.length ? [ids] : [], scores: Object.fromEntries(ids.map(id => [id, score])), won: !!won, stats };\n      this.setStatus('finishing', { won: !!won, reason });\n      if (this.timer) { clearInterval(this.timer); this.timer = null; }\n      this.pump();\n      if (!this.queue.length) this.finishReport();\n      else this.finishTimer = setInterval(() => { this.pump(); if (!this.queue.length) this.finishReport(); }, 16);\n    }\n    finishReport() {\n18:      const rig=new E.Humanoid({size:.96,build:second?'heroic':'bulky',weapon:'ppPick',outfit:'tunic',hair:second?'ponytail':'short',hat:{style:second?'ppTwinLamp':'ppLamp',color:second?A.TEAL:A.GOLD} [... omitted end of long line]\n56:          for(let i=0;i<n;i++){const a=hash(seed,i)*Math.PI*2,s=18+hash(seed+4,i)*62;this.fx.push({x,z,vx:Math.cos(a)*s,vz:Math.sin(a)*s+35,life:.5+hash(seed+2,i)*.65,max:1.2,color:i%4===0?'#fff4cf':c [... omi