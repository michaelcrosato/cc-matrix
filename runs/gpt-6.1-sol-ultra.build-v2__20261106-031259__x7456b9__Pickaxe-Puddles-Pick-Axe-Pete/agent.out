{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"head -35 'Pickaxe-Puddles-Pick-Axe-Pete-gpt-6.1-sol-ultra-20261106-031259/src/input/input.js' && sed -n '35,150p' 'Pickaxe-Puddles-Pick-Axe-Pete-gpt-6.1-sol-ultra-20261106-031259/src/input/input.js' && rg -n 'onMenu|onPause|onJoin|intent\\\\(|setContext|onWorld|label\\\\(' 'Pickaxe-Puddles-Pick-Axe-Pete-gpt-6.1-sol-ultra-20261106-031259/src/input/input.js'\"","aggregated_output":"/* Canonical actions use the native input and saved bindings. Touch adds one\n   pointer-owned stick, taps, and a deliberately chosen contextual interaction. */\n(() => {\n  const PP = window.PP = window.PP || {};\n  const E = window.My3D2dge;\n  const clamp = (x, a, b) => Math.max(a, Math.min(b, x));\n  const PRESET = {\n    up: ['KeyW', 'ArrowUp', 'Pad12'],\n    down: ['KeyS', 'ArrowDown', 'Pad13'],\n    left: ['KeyA', 'ArrowLeft', 'Pad14'],\n    right: ['KeyD', 'ArrowRight', 'Pad15'],\n    jump: ['Space', 'Pad0'],\n    chop: ['KeyJ', 'Mouse0', 'Pad2'],\n    redirect: ['KeyQ', 'Mouse2', 'Pad7'],\n    interact: ['KeyE', 'Pad3'],\n    start: ['Enter', 'Pad9'],\n    pause: ['Escape', 'Pad9'],\n    confirm: ['Enter', 'Space', 'Pad0'],\n    cancel: ['Escape', 'Backspace', 'Pad1']\n  };\n  const neutral = () => ({ mx: 0, my: 0, jump: false, jumpHeld: false, chop: false, redirect: false, interact: false, interactHeld: false, aim: 0 });\n  PP.Input = class {\n    constructor(game, callbacks = {}) {\n      this.game = game;\n      this.callbacks = callbacks;\n      this.settings = { glyphs: 'playstation', deadzone: .22 };\n      this.device = 'keyboard';\n      this.menu = true;\n      this.sim = null;\n      this.enabled = true;\n      this._clock = 0;\n      this._intents = new Map();\n      this._native = new Set();\n      this._pads = new Map();\n      this._controllerLost = new Set();\n      this._controllerLost = new Set();\n      this._axisActive = new Set();\n      this._touches = new Map();\n      this._touch = { id: null, x: 0, y: 0, ox: 0, oy: 0, jump: false, jumpHeld: false, action: false, target: null, heldTarget: null };\n      this._mouseAim = 0;\n      this._consumeUntil = 0;\n      this._abort = new AbortController();\n      this._installNative(game.input);\n      const signal = this._abort.signal;\n      const listen = (target, name, fn, opts = {}) => target?.addEventListener(name, fn, { signal, ...opts });\n      listen(window, 'keydown', e => {\n        if (e.ctrlKey || e.metaKey || e.altKey || e.repeat) return;\n        const typing = e.target?.matches?.('input:not([type=range]):not([type=checkbox]), textarea, select, [contenteditable=true]');\n        if (typing) return;\n        if (this._activity('keyboard', 'key', { code: e.code, event: e })) {\n          e.preventDefault(); e.stopImmediatePropagation();\n        }\n      }, { capture: true });\n      listen(window, 'pointerdown', e => {\n        const device = e.pointerType === 'touch' ? 'touch' : 'keyboard';\n        if (this._activity(device, 'pointer', { event: e })) {\n          e.preventDefault(); e.stopImmediatePropagation();\n        }\n      }, { capture: true });\n      listen(window, 'blur', () => this.clear());\n      listen(document, 'visibilitychange', () => { if (document.hidden) this.clear(); });\n      this.canvas = game.screen?.canvas || document.getElementById('screen');\n      if (this.canvas) {\n        this.canvas.style.touchAction = 'none';\n        listen(this.canvas, 'pointerdown', e => this._touchDown(e), { capture: true });\n        listen(this.canvas, 'pointermove', e => this._touchMove(e), { capture: true });\n        listen(this.canvas, 'contextmenu', e => e.preventDefault());\n        listen(this.canvas, 'pointerdown', e => {\n          if (e.pointerType !== 'mouse' || e.button !== 0 || this.menu || !this.sim) return;\n          const target = this._worldTargetAt(e.clientX, e.clientY);\n          if (target) {\n            this._worldInteract(target);\n            this.game.input.suppressCode('Mouse0');\n          }\n        });\n      }\n      listen(window, 'pointerup', e => this._touchUp(e));\n      listen(window, 'pointercancel', e => this._touchUp(e));\n      this.bubble = document.getElementById('context-action');\n      if (!this.bubble) {\n        this.bubble = document.createElement('button');\n        this.bubble.id = 'context-action';\n        this.bubble.type = 'button';\n        this.bubble.hidden = true;\n        this.bubble.setAttribute('aria-label', 'Contextual action');\n        document.body.appendChild(this.bubble);\n        this._madeBubble = true;\n      }\n      Object.assign(this.bubble.style, { touchAction: 'none' });\n      listen(this.bubble, 'pointerdown', e => {\n        if (e.pointerType !== 'touch' && e.pointerType !== 'pen') return;\n        e.preventDefault(); e.stopPropagation();\n        if (this.menu || !this.contextTarget) return;\n        this._touch.action = true;\n        this._touch.heldTarget = { ...this.contextTarget };\n        this._touches.set(e.pointerId, 'action');\n        this.bubble.setPointerCapture?.(e.pointerId);\n      });\n      listen(this.bubble, 'click', e => {\n        e.preventDefault();\n        if (this.contextTarget && !this.menu && this.device !== 'touch') this._worldInteract(this.contextTarget);\n      });\n      this.hint = document.getElementById('touch-hint');\n    }\n    _installNative(input) {\n      if (!input || this._native.has(input)) return;\n      input.use(PRESET);\n      input.names = { jump: 'Jump', chop: 'Chop', redirect: 'Redirect', interact: 'Door / rescue', up: 'Climb up', down: 'Duck / climb down', left: 'Move left', right: 'Move right' };\n      input.touchEnabled = false;\n      input.touchFilter = () => false;\n      input.glyphs = this.settings.glyphs;\n      this._native.add(input);\n    }\n    _activity(device, type, extra = {}) {\n      this.device = device;\n      const input = this.game.input;\n      input.lastDevice = device === 'pad' ? 'gamepad' : device;\n      const consumed = this.callbacks.onActivity?.({ device, type, ...extra }) === true;\n      if (consumed) {\n        this.clear();\n        this._consumeUntil = this._clock + .15;\n      }\n      if (device === 'touch' && this.hint && !this._touchShown) {\n        this._touchShown = true; this._hintUntil = this._clock + 7;\n        this.hint.hidden = false;\n      }\n      return consumed;\n    }\n    _touchDown(e) {\n      if (e.pointerType !== 'touch' && e.pointerType !== 'pen') return;\n      if (this.menu || !this.enabled || this._clock < this._consumeUntil) return;\n      e.preventDefault(); e.stopImmediatePropagation();\n      const rect = this.canvas.getBoundingClientRect();\n      if (e.clientX - rect.left < rect.width * .47 && this._touch.id === null) {\n        Object.assign(this._touch, { id: e.pointerId, ox: e.clientX, oy: e.clientY, x: 0, y: 0 });\n        this._touches.set(e.pointerId, 'stick');\n      } else {\n        this._touch.jump = true; this._touch.jumpHeld = true;\n        this._touches.set(e.pointerId, 'jump');\n      }\n      this.canvas.setPointerCapture?.(e.pointerId);\n    }\n    _touchMove(e) {\n      if (e.pointerId !== this._touch.id) return;\n      e.preventDefault(); e.stopImmediatePropagation();\n      const radius = Math.max(34, Math.min(62, innerWidth * .095));\n      let x = (e.clientX - this._touch.ox) / radius, y = (e.clientY - this._touch.oy) / radius;\n      const len = Math.hypot(x, y); if (len < .14) x = y = 0;\n      else if (len > 1) { x /= len; y /= len; }\n      this._touch.x = x; this._touch.y = y;\n    }\n159:    setContext(sim) { this.sim = sim; }\n187:      if (this.callbacks.onWorldInteract?.(target) === true) return;\n214:          this.callbacks.onPause?.({ reason: 'disconnect', player: i + 1 });\n220:          for (const a of ['up', 'down', 'left', 'right']) if (input.repeat(a, .34, .14)) this.callbacks.onMenu?.({ action: a, player: i + 1 });\n222:            this.callbacks.onMenu?.({ action: 'accept', player: i + 1 });\n225:            this.callbacks.onMenu?.({ action: 'back', player: i + 1 });\n231:          this.callbacks.onPause?.({ reason: 'player', player: i + 1 });\n284:    intent(id = 1) { return { ...(this._intents.get(id) || neutral()) }; }\n285:    label(action) {\n290:      return this.game.input.label(action, this.device === 'pad' ? 'gamepad' : 'keyboard');\n","exit_code":0,"status":"completed"}}
