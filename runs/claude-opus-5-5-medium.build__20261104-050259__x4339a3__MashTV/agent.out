om './units.mjs';\nconst g = room(), W = g.W, c = g.c; c.godMode = true; c.x = 200; c.y = 150;\nconst e = W.spawnAt('disco', 30, 30); e.dx = -.707; e.dy = -.707; g.adv(3); console.log('disco', e.x.toFixed(1), e.y.toFixed(1), e.dx, e.dy, 'entering', !!e.entering);\nEOF\nnode tests/dbg.mjs; python3 - <<'EOF'\np='src/13-enemies.js';s=open(p).read()\na=\"\"\"      if (e.x < AR.x0 + e.r && e.dx < 0 || e.x > AR.x1 - e.r && e.dx > 0) e.dx *= -1;\n      if (e.y < AR.y0 + e.r && e.dy < 0 || e.y > AR.y1 - e.r && e.dy > 0) e.dy *= -1;\"\"\"\nb=\"\"\"      if (e.x <= AR.x0 + e.r + .5 && e.dx < 0 || e.x >= AR.x1 - e.r - .5 && e.dx > 0) e.dx *= -1;   // (the wall clamp leaves it exactly on the edge)\n      if (e.y <= AR.y0 + e.r + .5 && e.dy < 0 || e.y >= AR.y1 - e.r - .5 && e.dy > 0) e.dy *= -1;\"\"\"\nassert a in s; s=s.replace(a,b); open(p,'w').write(s)\nEOF\nnode tools/build.mjs && node tests/dbg.mjs","description":"Reproduce and fix disco corner stick"}}}
