ry: 0, dead: false }; this._timers.push(t); return { cancel() { t.dead = true; } }; }\n2633-  /** run fn every `seconds` of game time. Cleared on scene change. Returns { cancel() } */\n2634-  every(seconds, fn) { const t = { at: this.time + seconds, fn, every: Math.max(1e-3, seconds), dead: false }; this._timers.push(t); return { cancel() { t.dead = true; } }; }\n2635-  _camStep(dt) {\n2636-    const c = this.cam; let fx = c.tx, fy = c.ty, fz = c.tz;\n1054:  anyPressed() { return this._now.size > 0; }\n10466:    if (I.anyPressed() || clicked(I)) { this._idle = 0; this.phase = 'title'; return 'title'; }\n852:  use(map) {\n853-    if (this.held) this.clear();\n854-    if (typeof map === 'string') map = Input[map.toUpperCase()] || Input.DEFAULT;\n855-    const B = this.bindings || {};\n856-    /** map: each action's codes ({ jump: ['Space', 'Pad0', 'Act:jump'] }); every action also answers to 'Act:<name>'\n857-     *  (DOM buttons with data-act, tap, hold) */\n858-    this.map = {};\n859-    for (const a in map) {\n860-      let codes = map[a].slice(); const b = B[a];","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01QMmsv2o1QcNfhoF7SmqcYX","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
