{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SXU5S4msEKnCRFHLetW1WG","type":"tool_result","content":"600\t  rocks: course(Math.random),\n601\t  finishedAt: null,\n602\t  message: 'Comet Dash — press any key or tap to race',\n603\t};\n604\tconst ghosts = new Map();   // id -> {x, d, area, name, color, done}\n605\t/** The whole course is one area, so every ghost on it is in view. */\n606\tconst AREA = 'course';\n607\tlet hub = null;\n608\tlet soloStart = 0;\n609\tlet lastSent = 0;\n610\tlet felt = 0;    // the local steering as last read\n611\tlet boost = false;   // Space or Cross held: a little faster\n612\t\n613\tfunction steer() {\n614\t  if (menu.open) return 0;\n615\t  let x = 0;\n616\t  if (keys.has('arrowleft') || keys.has('a')) x -= 1;\n617\t  if (keys.has('arrowright') || keys.has('d')) x += 1;\n618\t  if (pad && Math.abs(pad.axes[0]) > 0.2) x = pad.axes[0];\n619\t  if (padNow[PAD.left]) x = -1;\n620\t  if (padNow[PAD.right]) x = 1;\n621\t  if (pointerX !== null) {\n622\t    const r = canvas.getBoundingClientRect();\n623\t    const target = ((pointerX - r.left) / r.width) * W;\n624\t    x = Math.max(-1, Math.min(1, (target - run.x) / 40));\n625\t  }\n626\t  return x;\n627\t}\n628\t\n629\tasync function connect() {\n630\t  const info = await AIHub.connect({ mode: 'ghost', seats: [2, 4] });\n631\t  if (!info) return;\n632\t  hub = info;\n633\t  run.rocks = course(AIHub.rng('course'));\n634\t  for (const p of info.players) if (p.id !== info.me) ghosts.set(p.id, { ...p, x: W / 2, d: 0, done: null });\n635\t  // The hub's card collects everyone's ready: ready up as soon as the course is built.\n636\t  run.phase = 'waiting';\n637\t  run.message = 'Get ready…';\n638\t  AIHub.ready();\n639\t  AIHub.on('start', () => { run.phase = 'racing'; unlockAudio(); });\n640\t  AIHub.on('message', (data, from) => {\n641\t    const g = ghosts.get(from);\n642\t    if (!g) return;\n643\t    if (data.t === 'g') { g.tx = data.x; g.td = data.d; g.area = data.area; }\n644\t    if (data.t === 'done') { g.done = data.time; beep(330); }\n645\t  });\n646\t  AIHub.on('leave', ({ id }) => ghosts.delete(id));\n647\t  AIHub.on('time-up', () => {\n648\t    if (run.phase === 'racing') AIHub.result({ score: Math.floor(run.d) });\n649\t  });\n650\t  AIHub.on('end', ({ reason, standings }) => {\n651\t    run.phase = 'over';\n652\t    run.standings = standings;\n653\t    run.message = reason === 'finished' ? 'Race over' : reason === 'sat-out' ? 'You sat this one out' : 'Race cancelled';\n654\t  });\n655\t}\n656\t\n657\tfunction unlockAudio() {\n658\t  if (!audio) {\n659\t    try { audio = new AudioContext(); } catch { audio = null; }\n660\t  }\n661\t  audio?.resume?.().catch(() => {});\n662\t}\n663\t\n664\tfunction gesture() {\n665\t  unlockAudio();\n666\t  if (!hub && (run.phase === 'title' || run.phase === 'over')) {\n667\t    Object.assign(run, { phase: 'racing', x: W / 2, d: 0, stun: 0, rocks: course(Math.random), finishedAt: null });\n668\t    soloStart = performance.now();\n669\t  }\n670\t}\n671\t\n672\t/** Race time: the hub's shared clock in a session, the local one alone. */\n673\tconst raceTime = () => (hub ? AIHub.time() : performance.now() - soloStart);\n674\t\n675\tlet last = performance.now();\n676\tfunction frame(now) {\n677\t  const dt = Math.min((now - last) / 1000, 0.25);\n678\t  last = now;\n679\t  readPad();\n680\t  felt = steer();\n681\t  boost = !menu.open && (keys.has(' ') || !!padNow[PAD.cross] || !!padNow[7]);\n682\t  if (run.phase === 'racing' && raceTime() >= 0) {\n683\t    run.x = Math.max(R + 20, Math.min(W - R - 20, run.x + felt * 320 * dt));\n684\t    if (run.stun > 0) run.stun -= dt;\n685\t    else run.d += SPEED * (boost ? 1.3 : 1) * dt;\n686\t    for (const rock of run.rocks) {\n687\t      if (Math.abs(rock.y - run.d) < 18 && Math.abs(rock.x - run.x) < 40 && run.stun <= 0) {\n688\t        run.stun = 0.7; run.d -= 20; beep(140);\n689\t      }\n690\t    }\n691\t    if (run.d >= LENGTH) {\n692\t      run.d = LENGTH;\n693\t      run.finishedAt = Math.round(raceTime());\n694\t      run.phase = 'done';\n695\t      run.message = `Finished in ${(run.finishedAt / 1000).toFixed(2)} s`;\n696\t      beep(880);\n697\t      if (hub) {\n698\t        AIHub.result({ time: run.finishedAt });\n699\t        AIHub.send({ t: 'done', time: run.finishedAt });\n700\t        run.message += ' — waiting for the others';\n701\t      }\n702\t    }\n703\t  }\n704\t  if (hub && (run.phase === 'racing' || run.phase === 'done') && now - lastSent > 100) {\n705\t    lastSent = now;\n706\t    AIHub.send({ t: 'g', area: AREA, x: Math.round(run.x), d: Math.round(run.d) }, { reliable: false });\n707\t    if (run.phase === 'racing') AIHub.progress({ score: Math.round(run.d), label: `${Math.round((run.d / LENGTH) * 100)}% of the course` });\n708\t  }\n709\t  for (const g of ghosts.values()) if (g.tx !== undefined) {\n710\t    const k = 1 - Math.pow(0.002, dt);\n711\t    g.x += (g.tx - g.x) * k; g.d += (g.td - g.d) * k;\n712\t  }\n713\t  draw();\n714\t  requestAnimationFrame(frame);\n715\t}\n716\t\n717\tfunction draw() {\n718\t  const r = canvas.getBoundingClientRect();\n719\t  const dpr = devicePixelRatio || 1;\n720\t  if (canvas.width !== Math.round(r.width * dpr) || canvas.height !== Math.round(r.height * dpr)) {\n721\t    canvas.width = Math.round(r.width * dpr); canvas.height = Math.round(r.height * dpr);\n722\t  }\n723\t  const s = Math.min(canvas.width / W, canvas.height / H);\n724\t  ctx.setTransform(1, 0, 0, 1, 0, 0);\n725\t  ctx.fillStyle = '#081120'; ctx.fillRect(0, 0, canvas.width, canvas.height);\n726\t  ctx.setTransform(s, 0, 0, s, (canvas.width - W * s) / 2, (canvas.height - H * s) / 2);\n727\t  ctx.fillStyle = '#0f1b2e'; ctx.fillRect(0, 0, W, H);\n728\t\n729\t  const screenY = (d) => H - 160 - (d - run.d);"}]},"parent_tool_use_id":null,"session_id":"f2086767-996d-4677-894d-e4b97c87d2db","uuid":"1b70ecea-8fc5-4775-aaa3-05fbbcf12fbb","timestamp":"2026-11-04T00:50:54.452Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/.cache/plan-x7ac903/hub/ai-hub/lib/hub/examples/ghost.html","content":"  rocks: course(Math.random),\n  finishedAt: null,\n  message: 'Comet Dash — press any key or tap to race',\n};\nconst ghosts = new Map();   // id -> {x, d, area, name, color, done}\n/** The whole course is one area, so every ghost on it is in view. */\nconst AREA = 'course';\nlet hub = null;\nlet soloStart = 0;\nlet lastSent = 0;\nlet felt = 0;    // the local steering as last read\nlet boost = false;   // Space or Cross held: a little faster\n\nfunction steer() {\n  if (menu.open) return 0;\n  let x = 0;\n  if (keys.has('arrowleft') || keys.has('a')) x -= 1;\n  if (keys.has('arrowright') || keys.has('d')) x += 1;\n  if (pad && Math.abs(pad.axes[0]) > 0.2) x = pad.axes[0];\n  if (padNow[PAD.left]) x = -1;\n  if (padNow[PAD.right]) x = 1;\n  if (pointerX !== null) {\n    const r = canvas.getBoundingClientRect();\n    const target = ((pointerX - r.left) / r.width) * W;\n    x = Math.max(-1, Math.min(1, (target - run.x) / 40));\n  }\n  return x;\n}\n\nasync function connect() {\n  const info = await AIHub.connect({ mode: 'ghost', seats: [2, 4] });\n  if (!info) return;\n  hub = info;\n  run.rocks = course(AIHub.rng('course'));\n  for (const p of info.players) if (p.id !== info.me) ghosts.set(p.id, { ...p, x: W / 2, d: 0, done: null });\n  // The hub's card collects everyone's ready: ready up as soon as the course is built.\n  run.phase = 'waiting';\n  run.message = 'Get ready…';\n  AIHub.ready();\n  AIHub.on('start', () => { run.phase = 'racing'; unlockAudio(); });\n  AIHub.on('message', (data, from) => {\n    const g = ghosts.get(from);\n    if (!g) return;\n    if (data.t === 'g') { g.tx = data.x; g.td = data.d; g.area = data.area; }\n    if (data.t === 'done') { g.done = data.time; beep(330); }\n  });\n  AIHub.on('leave', ({ id }) => ghosts.delete(id));\n  AIHub.on('time-up', () => {\n    if (run.phase === 'racing') AIHub.result({ score: Math.floor(run.d) });\n  });\n  AIHub.on('end', ({ reason, standings }) => {\n    run.phase = 'over';\n    run.standings = standings;\n    run.message = reason === 'finished' ? 'Race over' : reason === 'sat-out' ? 'You sat this one out' : 'Race cancelled';\n  });\n}\n\nfunction unlockAudio() {\n  if (!audio) {\n    try { audio = new AudioContext(); } catch { audio = null; }\n  }\n  audio?.resume?.().catch(() => {});\n}\n\nfunction gesture() {\n  unlockAudio();\n  if (!hub && (run.phase === 'title' || run.phase === 'over')) {\n    Object.assign(run, { phase: 'racing', x: W / 2, d: 0, stun: 0, rocks: course(Math.random), finishedAt: null });\n    soloStart = performance.now();\n  }\n}\n\n/** Race time: the hub's shared clock in a session, the local one alone. */\nconst raceTime = () => (hub ? AIHub.time() : performance.now() - soloStart);\n\nlet last = performance.now();\nfunction frame(now) {\n  const dt = Math.min((now - last) / 1000, 0.25);\n  last = now;\n  readPad();\n  felt = steer();\n  boost = !menu.open && (keys.has(' ') || !!padNow[PAD.cross] || !!padNow[7]);\n  if (run.phase === 'racing' && raceTime() >= 0) {\n    run.x = Math.max(R + 20, Math.min(W - R - 20, run.x + felt * 320 * dt));\n    if (run.stun > 0) run.stun -= dt;\n    else run.d += SPEED * (boost ? 1.3 : 1) * dt;\n    for (const rock of run.rocks) {\n      if (Math.abs(rock.y - run.d) < 18 && Math.abs(rock.x - run.x) < 40 && run.stun <= 0) {\n        run.stun = 0.7; run.d -= 20; beep(140);\n      }\n    }\n    if (run.d >= LENGTH) {\n      run.d = LENGTH;\n      run.finishedAt = Math.round(raceTime());\n      run.phase = 'done';\n      run.message = `Finished in ${(run.finishedAt / 1000).toFixed(2)} s`;\n      beep(880);\n      if (hub) {\n        AIHub.result({ time: run.finishedAt });\n        AIHub.send({ t: 'done', time: run.finishedAt });\n        run.message += ' — waiting for the others';\n      }\n    }\n  }\n  if (hub && (run.phase === 'racing' || run.phase === 'done') && now - lastSent > 100) {\n    lastSent = now;\n    AIHub.send({ t: 'g', area: AREA, x: Math.round(run.x), d: Math.round(run.d) }, { reliable: false });\n    if (run.phase === 'racing') AIHub.progress({ score: Math.round(run.d), label: `${Math.round((run.d / LENGTH) * 100)}% of the course` });\n  }\n  for (const g of ghosts.values()) if (g.tx !== undefined) {\n    const k = 1 - Math.pow(0.002, dt);\n    g.x += (g.tx - g.x) * k; g.d += (g.td - g.d) * k;\n  }\n  draw();\n  requestAnimationFrame(frame);\n}\n\nfunction draw() {\n  const r = canvas.getBoundingClientRect();\n  const dpr = devicePixelRatio || 1;\n  if (canvas.width !== Math.round(r.width * dpr) || canvas.height !== Math.round(r.height * dpr)) {\n    canvas.width = Math.round(r.width * dpr); canvas.height = Math.round(r.height * dpr);\n  }\n  const s = Math.min(canvas.width / W, canvas.height / H);\n  ctx.setTransform(1, 0, 0, 1, 0, 0);\n  ctx.fillStyle = '#081120'; ctx.fillRect(0, 0, canvas.width, canvas.height);\n  ctx.setTransform(s, 0, 0, s, (canvas.width - W * s) / 2, (canvas.height - H * s) / 2);\n  ctx.fillStyle = '#0f1b2e'; ctx.fillRect(0, 0, W, H);\n\n  const screenY = (d) => H - 160 - (d - run.d);","numLines":130,"startLine":600,"totalLines":799}},"tool_result_meta":[{"id":"toolu_01SXU5S4msEKnCRFHLetW1WG","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
