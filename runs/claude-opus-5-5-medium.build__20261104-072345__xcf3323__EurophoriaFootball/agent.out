{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VnKY3UmX15nAt7gnynGf6f","type":"tool_result","content":"789:    /** glyphs: the gamepad's button symbols for label(): 'auto' (from the controller's name) | 'xbox' | 'playstation' |\n1354:  normal: { glyphs: parseFont(G57), h: 7, desc: 2, gap: 1, space: 3, upper: false },\n1355:  tiny: { glyphs: parseFont(GLYPHS), h: 5, desc: 0, gap: 2, space: 3, upper: true, mono: 3 }\n1718:  get ctx() { return this.game.screen.ctx; }\n2980:const STANDARD_SETTINGS = {\n2999:  glyphs: { group: 'Controller', label: 'Button symbols', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['xbox', 'Xbox'], ['playstation', 'PlayStation'], ['nintendo', 'Nintendo'], ['generic', 'Positions']], apply: (g, v) => { g.input.glyphs = v; } },\n7555:      this._master = c.createGain(); this._master.connect(c.destination);\n7556:      this._sfxBus = c.createGain(); this._sfxBus.connect(this._master);\n7557:      this._musBus = c.createGain(); this._musBus.connect(this._master);\n7560:      this._noise = nb;\n7589:    const g = c.createGain(); g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(vol, t + att);\n7594:      src = c.createBufferSource(); src.buffer = this._noise; src.loop = true;\n7604:      if (p.vib) { const lfo = c.createOscillator(), lg = c.createGain(); lfo.frequency.value = p.vib[0]; lg.gain.value = f0 * p.vib[1]; lfo.connect(lg); lg.connect(src.frequency); lfo.start(t); lfo.stop(end + .05); }\n7739:    const c = this.ctx, bus = c.createGain(); bus.connect(this._musBus); C.bus = bus;\n7741:    for (const t of C.tracks) { t.gain = c.createGain(); t.gain.gain.value = C.vols[t.i]; t.gain.connect(bus); }\n8931:    this.name = o.name || null; this.onDone = o.onDone || null; this.choices = o.choices || null; this.onChoice = o.onChoice || null; this._blip = 0;\n8956:    if (this.voice && Math.floor(this.shown) > prev && (this._blip++ % 2 === 0)) this.game.audio.sfx(this.voice);","is_error":false}]},"parent_tool_use_id":null,"session_id":"1e21ad4c-7b98-4203-a651-095d6be0bc50","uuid":"b110be22-d4c5-43ea-b41a-eef009f4e850","timestamp":"2026-11-04T14:25:03.163Z","tool_use_result":{"stdout":"789:    /** glyphs: the gamepad's button symbols for label(): 'auto' (from the controller's name) | 'xbox' | 'playstation' |\n1354:  normal: { glyphs: parseFont(G57), h: 7, desc: 2, gap: 1, space: 3, upper: false },\n1355:  tiny: { glyphs: parseFont(GLYPHS), h: 5, desc: 0, gap: 2, space: 3, upper: true, mono: 3 }\n1718:  get ctx() { return this.game.screen.ctx; }\n2980:const STANDARD_SETTINGS = {\n2999:  glyphs: { group: 'Controller', label: 'Button symbols', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['xbox', 'Xbox'], ['playstation', 'PlayStation'], ['nintendo', 'Nintendo'], ['generic', 'Positions']], apply: (g, v) => { g.input.glyphs = v; } },\n7555:      this._master = c.createGain(); this._master.connect(c.destination);\n7556:      this._sfxBus = c.createGain(); this._sfxBus.connect(this._master);\n7557:      this._musBus = c.createGain(); this._musBus.connect(this._master);\n7560:      this._noise = nb;\n7589:    const g = c.createGain(); g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(vol, t + att);\n7594:      src = c.createBufferSource(); src.buffer = this._noise; src.loop = true;\n7604:      if (p.vib) { const lfo = c.createOscillator(), lg = c.createGain(); lfo.frequency.value = p.vib[0]; lg.gain.value = f0 * p.vib[1]; lfo.connect(lg); lg.connect(src.frequency); lfo.start(t); lfo.stop(end + .05); }\n7739:    const c = this.ctx, bus = c.createGain(); bus.connect(this._musBus); C.bus = bus;\n7741:    for (const t of C.tracks) { t.gain = c.createGain(); t.gain.gain.value = C.vols[t.i]; t.gain.connect(bus); }\n8931:    this.name = o.name || null; this.onDone = o.onDone || null; this.choices = o.choices || null; this.onChoice = o.onChoice || null; this._blip = 0;\n8956:    if (this.voice && Math.floor(this.shown) > prev && (this._blip++ % 2 === 0)) this.game.audio.sfx(this.voice);","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01VnKY3UmX15nAt7gnynGf6f","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
