ncel() { t.dead = true; } }; }\n2632-  /** run fn every `seconds` of game time. Cleared on scene change. Returns { cancel() } */\n2633-  every(seconds, fn) { const t = { at: this.time + seconds, fn, every: Math.max(1e-3, seconds), dead: false }; this._timers.push(t); return { cancel() { t.dead = true; } }; }\n2634-  _camStep(dt) {\n2635-    const c = this.cam; let fx = c.tx, fy = c.ty, fz = c.tz;\n586:  screenDirToGround(dx, dy) {\n7151:      const m = ctl.move(), g = v ? v.screenDirToGround(m[0], m[1]) : m, has = a => !!ctl.map[a];\n2327:    this.time = 0; this.real = 0; this.hitstop = 0; this.timeScale = 1; this._shakeAmt = 0; this.reduceMotion = !this.headless && !!(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches);\n2875:    this.real += dt; this._shakeAmt *= Math.exp(-dt * 9); this.input.tick(dt); if (this._players) for (let i = 1; i < this._players.length; i++) this._players[i].tick(dt);   // (the other players: section 10j)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0169eNAGFhxhPv75fgDBtbgk","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
