length && LIVE.hud) for (const [a, b] of EF.pendingToasts.splice(0)) LIVE.hud.toast(a, b);\n    if (EF.Dev.update(dt)) { if (this.isMatch && !(EF.Dev.cheats.freeze && !EF.Dev.stepOnce)) { EF.Dev.syncSlots(true); up.call(this, dt); } else if (!this.isMatch) { /* menus wait */ } EF.mouseEndStep(); return; }\n    up.call(this, dt);\n    EF.mouseEndStep();\n  };\n  sc.draw = function (r) { dr.call(this, r); EF.Dev.draw(r); };\n  if (SESSION) sc.pausable = false;\n}\n/* ---- boot ---- */\nwindow.__EF = EF;\nconst startScene = () => {\n  if (SESSION) return 'hubwait';\n  const s = LINK.scene;\n  if (s === 'dev' && LINK.part === 'anim') return 'animgallery';\n  if (s && EF.scenes[s]) return s;\n  return 'title';\n};\ngame.start({ scenes: EF.scenes, scene: startScene(), boot: { title: 'EUROPHORIA FOOTBALL', steps: [\n  ['Calling the squads', () => { EF.initSpeakers(); EF.initStickers(); }],\n  ['Opening the sticker album', () => { EF.Save.load(); }],\n  ['Checking the rule book', () => { EF.validate(); }]\n] } });\nif (LINK.dev && !SESSION) game.after(.2, () => EF.Dev.open());\n","structuredPatch":[{"oldStart":1,"oldLines":3,"newStart":1,"newLines":78,"lines":["-/* 90-start: the debug handle and the start */","+/* 90-start: the About data, content validation, game.debug (the tests' and tools' handle), test hooks, the dev panel","+ * wrapped round every scene, and the start: a hub session connects; otherwise the title (or the deep link). */","+EF.ABOUT = EF_ABOUT || { sourceInformation: {}, testingFeedback: [], engineFeedback: [], promptFeedback: [] };","+/** every reference between entries, every text the font must draw, the pools' sizes; problems go to game.fail */","+EF.validate = () => {","+  const P_ = [], ok = s => /^[\\x20-\\x7E]*$/.test(s);","+  for (const t of EF.all('team')) {","+    if (!EF.get('stadium', t.stadium)) P_.push('team ' + t.id + ': stadium ' + t.stadium);","+    if (!EF.get('formation', t.formation)) P_.push('team ' + t.id + ': formation');","+    if 