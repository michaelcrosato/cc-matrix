 { width: 1400, height: 900 } });\n    await page.goto(`${base}/${NAME}/tools/harness/harness.html?game=/${NAME}.html&${q}`);\n    try { await page.waitForFunction(() => document.body.dataset.complete === 'true', null, { timeout: 240000 }); } catch (e) { out(false, q + ': timed out'); }\n    const rep = await page.evaluate(() => window.__hubCheck || null);\n    out(rep && rep.pass === true, q + ': pass=' + (rep && rep.pass));\n    if (rep && !rep.pass) console.log(JSON.stringify(rep).slice(0, 1500));\n    if (process.env.SHOT) await page.screenshot({ path: join(DEV, 'shots', 'hub_' + q.replace(/[^a-z0-9]+/gi, '_') + '.png') });\n    await page.close();\n  }\n  // the game alone, outside a session, still reaches its title with no errors\n  const page = await browser.newPage(); const errs = []; page.on('pageerror', e => errs.push(e.message));\n  await page.goto(`${base}/${NAME}.html`); await page.waitForTimeout(2500);\n  const sc = await page.evaluate(() => window.My3D2dge.current.sceneName);\n  out(sc === 'title' && !errs.length, 'outside a session: ' + sc + ' ' + errs.join(' | '));\n  await browser.close();\n} catch (e) { out(false, e.message); }\nfinally { srv.kill(); }\nconsole.log(`hub harness: ${failed ? failed + ' failed' : 'all passed'}`);\nprocess.exit(failed ? 1 : 0);\nEOF\nnode tools/build.mjs -q && TMPDIR=$PWD/.tmp SHOT=1 timeout 600 node tools/hubcheck.mjs 'players=2&auto=1' 2>&1 | tail -20","description":"Run the hub harness with two players"}},"wire_ingest_context":{"toolu_01ReZR1DjEacKegHpAxG52yZ":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261104-072345__xcf3323/work/EurophoriaFootball-EuropeanFootball-claude-opus-5-5-medium-20261104-072345"}}}
