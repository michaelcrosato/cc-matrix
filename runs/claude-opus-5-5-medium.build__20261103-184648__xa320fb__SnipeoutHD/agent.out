same line)', gp && [gp.p, me.p]);\",\"const me = R2.humans[0], gp = SN.scenes.race.ghostPose; check(gp && Math.abs(gp.p - me.p) < 40 * 16, 'the ghost plays back near the bot (same line)', gp && [gp.p, me.p]);\")\nopen(p,'w').write(s)\nEOF\ncat > .tmp/acad.mjs <<'EOF'\nimport { load } from '../tests/lib/vm.mjs';\nimport { runRace, academyBot } from '../tests/lib/t.mjs';\nconst ctx = load(), SN = ctx.SN, g = ctx.My3D2dge.current, I = g.input; g.advance(.5);\ng.go('loading', { setup: SN.Academy.setup() }); g.advance(1.2); const A = SN.Academy, bot = academyBot(ctx), R = SN.scenes.race.race;\nfor (let k = 0; k < 60 && g.sceneName === 'race'; k++) { if (A.phase === 'card') { I.tap('confirm'); g.advance(.05); } for (let q = 0; q < 6; q++) { runRace(ctx, 1/6, bot); const h = R.humans[0]; if (A.d.id === 'steer') console.log(A.d.id, A.phase, 'u', (h.u/16).toFixed(1), 'gates', A.gates.map(x => x.done + ':' + (x.u/16) + '@' + (SN.wrapDiff(h.s, x.s, R.track.L)/16).toFixed(0)).join(' '), 'v', (h.V && SN.Ship.speed(h)/16).toFixed(0)); } if (A.d.id !== 'steer' && A.i > 1) break; }\nconsole.log('at', A.d.id, A.passed, A.retries);\nEOF\nnode .tmp/acad.mjs 2>&1 | head -30","description":"Fix flying start, ghost pose headless; trace the steer drill"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3470,"cache_read_input_tokens":589402,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3470},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f4eed361-ef26-4b83-9819-20dffd5cdae7","uuid":"266380c6-2327-4b5f-afd1-58d8c8a5cbe2","timestamp":"2026-11-04T02:35:48.951Z","request_id":"req_011Cgh7ESrZcmJpQ59zhhNGE","wire_tool_inputs":{"toolu_01KqEL96BB7gvSySX2E8oL7e":{"command":"python3 - <<'EOF'\np='src/25-shi