== 2 || kind[a] === 2 && kind[b] !== 2 || kind[b] === 2 && kind[i] !== 2) { if (kind[i] === 2) fz = 0; }\n      if (kind[i] === 1) fz = 0;\"\"\"\nnew=\"\"\"      let a = (i - 1 + n) % n, b = (i + 1) % n;\n      if (kind[b] !== kind[i]) b = i; if (kind[a] !== kind[i]) a = i;\n      let fx = C[b * 3] - C[a * 3], fy = C[b * 3 + 1] - C[a * 3 + 1], fz = C[b * 3 + 2] - C[a * 3 + 2];\n      if (kind[i]) fz = 0;\"\"\"\nassert old in s; s=s.replace(old,new); open(p,'w').write(s)\nEOF\nnode tools/trackcheck.mjs","description":"Fix tangents at jump boundaries and rerun"}}}
