 = Math.PI / 2; ring.position.set(10, .55, 10); sc.add(ring);\n    const lineMat = w._own(new THREE.MeshBasicNodeMaterial({ color: '#1c2a3e' }));\n    for (let k = 2; k < 27; k += 3) { const a = new THREE.Mesh(w._own(new THREE.BoxGeometry(.05, .02, 16)), lineMat); a.position.set(k, .02, 9); sc.add(a); }\n    for (let k = 2; k < 17; k += 3) { const a = new THREE.Mesh(w._own(new THREE.BoxGeometry(26, .02, .05)), lineMat); a.position.set(14, .02, k); sc.add(a); }\n    for (const z of [1.1, 16.9]) { const st = new THREE.Mesh(w._own(new THREE.BoxGeometry(26, .12, .12)), this.neon); st.position.set(14, .4, z); sc.add(st); const st2 = st.clone(); st2.position.y = 5.5; sc.add(st2); }\n    for (let k = 0; k < 5; k++) { const lamp = new THREE.Mesh(w._own(new THREE.BoxGeometry(2.4, .1, .6)), w._own(new THREE.MeshBasicNodeMaterial({ color: '#d8e8ff' }))); lamp.position.set(4 + k * 5, 7.4, 9); sc.add(lamp); }\n\"\"\"\ns=s[:old_a]+new+s[old_b:]\ns=s.replace(\"    else w.camera.fixed = { x: 160 + Math.sin(this.orbit) * 24, y: 280, z: 70, yaw: -Math.PI / 2 + Math.sin(this.orbit) * .08, pitch: -.24, roll: 0, fov: 46 };\",\"    else w.camera.fixed = { x: 104 + Math.sin(this.orbit) * 10, y: 292, z: 62, yaw: -Math.PI / 2 + Math.sin(this.orbit) * .05, pitch: -.2, roll: 0, fov: 44 };\")\nopen(p,'w').write(s)\np='src/78-season.js'; s=open(p).read()\ns=s.replace(\"if (!open) E.font.text(g, t.rule, x + cw / 2, y0 + 30, '#6a7490', { align: 'center', font: 'tiny', wrap: cw - 8, outline: false }); });\",\"if (!open) E.font.text(g, t.rule, x + cw / 2, y0 + 19, '#ff8a8a', { align: 'center', font: 'tiny', wrap: cw - 4, outline: false }); });\")\ns=s.replace(\"const cl = it.cell, ev = SN.SEASON.events[cl.e], x = x0 + cl.c * (cw + 6) + 3, y = y0 + 24 + cl.r * 34 + (Season.tierOpen(cl.t) ? 0 : 20), w = cw - 6, h = 30, on = k === ui.focus;\",\"const cl = it.cell, ev = SN.SEASON.events[cl.e], x = x0 + cl.c * (cw + 6) + 3, y = y0 + 34 + cl.r * 28, w = cw - 6, h = 25, on = k === ui.focus;\")\ns=s.replac