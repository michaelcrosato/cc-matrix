elf.app_settings.aim_marker = false;\n            self.fit.active = true;\n            self.input.fit = true;\n            self.input.bindings = crate::input::Bindings::fit();\n            self.audio_settings.sfx = 1.0;\n            #[cfg(target_arch = \"wasm32\")]\n            {\n                self.fit.touch_only = crate::fit_link::web::touch_only();\n            }\n        }\n        self.host = Some(SimHost::start(sim));\n        self.gfx = Some(gfx);''')\n# devices block\nsub(A,'''        self.input.poll_gamepad();\n        if self.input.pad.start_pressed {\n            let open = !self.menu_open;\n            self.set_menu(open);\n        }\n        if self.input.pad.map_pressed {\n            self.game_ui.map = !self.game_ui.map;\n        }\n        self.pad_menus(dt);\n''','''        self.input.poll_gamepad();\n        #[cfg(target_arch = \"wasm32\")]\n        if self.input.pad.any_activity {\n            // A pad press counts as the gesture audio is waiting for, where the browser agrees.\n            self.resume_audio();\n        }\n        if !self.fit.active {\n            if self.input.pad.start_pressed {\n                let open = !self.menu_open;\n                self.set_menu(open);\n            }\n            if self.input.pad.map_pressed {\n                self.game_ui.map = !self.game_ui.map;\n            }\n            self.pad_menus(dt);\n        }\n''')\nsub(A,'''                self.input.bindings = b;\n                for e in errs {\n                    log::warn!(\"room keys: {e}\");\n                }\n            }''','''                self.input.bindings = b;\n                for e in errs {\n                    log::warn!(\"room keys: {e}\");\n                }\n                if self.fit.active {\n                    self.input.bindings = crate::input::Bindings::fit();\n                }\n            }''')\nsub(A,'''        let alpha = if self.app_settings.smoothing && !snap_camera {''','''        // A game that drives the camera itself, every tick.\n        if let Some(c) = curr.hud.camera {\n            let p = &mut self.rig.params;\n            p.tilt = c.tilt;\n            p.yaw = c.yaw;\n            p.distance = c.distance;\n            p.fov = c.fov;\n            p.height_offset = c.height;\n            p.ortho = false;\n            p.follow_lag = 0.05;\n            if c.cut != self.fit.cut {\n                self.fit.cut = c.cut;\n                self.rig = CameraRig::new(self.rig.params.clone());\n                self.rig.snap(curr.focus);\n                if c.iris {\n                    self.arrival = Some(Instant::now());\n                }\n            }\n        }\n        let alpha = if self.app_settings.smoothing && !snap_camera {''')\nsub(A,'''        let over_ui = self.egui_ctx.egui_wants_pointer_input();\n        let left_tap = self.input.take_mouse_tap(MouseButton::Left) && !over_ui;\n        if over_ui {\n            self.input.mouse_taps.clear();\n        }\n        let (mut held, mut pressed) = self.input.buttons();''','''        let fit_frame = curr.hud.fit.clone();\n        if let Some(ui) = &fit_frame {\n            #[cfg(target_arch = \"wasm32\")]\n            let go = crate::fit_link::web::hub_go();\n            #[cfg(not(target_arch = \"wasm32\"))]\n            let go = false;\n            let frame_input = self.fit.fill(&mut self.input, &self.rig, ui, size / self.egui_ctx.pixels_per_point().max(0.01) * self.egui_ctx.pixels_per_point(), dt, go);\n            let mut i = host.shared.input.lock().unwrap();\n            let (p, a, u) = (i.pressed, i.any, i.ui);\n            *i = frame_input;\n            i.pressed |= p;\n            i.any |= a;\n            i.ui = i.ui.or(u);\n        }\n        let over_ui = self.egui_ctx.egui_wants_pointer_input();\n        let left_tap = self.input.take_mouse_tap(MouseButton::Left) && !over_ui;\n        if over_ui {\n            self.input.mouse_taps.clear();\n        }\n        let (mut held, mut pressed) = self.input.buttons();'''