{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjGmxvVZFS6EdYdEaGba","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018cYZCJeezGFbGmgF2NLcWT","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953\nF=engine/crates/pav_core/src/games/fit\ncat > $F/mod.rs <<'RS'\n//! We Stand: a balance-and-wellness comedy on Tippy Cay, a resort staffed by talking gym equipment.\n//!\n//! All game state and flow live here, in one `Game`: menus, dialogue, pause, settings and dev\n//! toggles are state driven by `InputFrame`, so `cargo test` plays the whole game with no browser\n//! or GPU. `pav_ui::fit_ui` draws the `UiFrame` this writes and reports what the pointer did.\n//! `README.md` in the dev folder explains adding an event, a set and a song.\n\nuse std::collections::BTreeMap;\nuse std::sync::Arc;\n\nuse anyhow::{Result, anyhow};\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\nuse serde_json::json;\n\nuse super::{Extras, Game, GameBox, Outcome};\nuse crate::entity::EntityId;\nuse crate::frame::{GameCamera, SimEvent};\nuse crate::input::{InputFrame, buttons as btn};\nuse crate::room::RoomDef;\nuse crate::sim::Sim;\nuse crate::world::{RoomSlot, World};\n\npub mod check;\npub mod core;\npub mod dialog;\npub mod events;\npub mod finale;\npub mod ghost;\npub mod island;\npub mod menus;\npub mod meta;\npub mod rules;\npub mod run;\npub mod script;\npub mod ui_model;\n\nuse check::Check;\nuse dialog::{After, Dialog};\nuse events::*;\nuse menus::{Menu, MenuKind};\nuse meta::{Guest, Save};\nuse rules::Rules;\nuse run::{Body, Phase, ResultData, Run, RunCtx, RunGhost};\nuse ui_model::*;\n\n/// The game's title, in one place.\npub const TITLE: &str = \"We Stand\";\npub const TAGLINE: &str = \"A wellness resort you did not enter\";\n\n/// Sounds by number; `pav_audio` holds the bank.\npub mod sfx {\n    pub const MOVE: u8 = 1;\n    pub const CONFIRM: u8 = 2;\n    pub const BACK: u8 = 3;\n    pub const STAMP: u8 = 4;\n    pub const GULP: u8 = 5;\n    pub const TICK: u8 = 6;\n    pub const STEP: u8 = 7;\n    pub const SQUEAK: u8 = 8;\n    pub const CREAK: u8 = 9;\n    pub const SPLASH_S: u8 = 10;\n    pub const SPLASH_B: u8 = 11;\n    pub const GULL: u8 = 12;\n    pub const MURMUR: u8 = 13;\n    pub const CLAP: u8 = 14;\n    pub const GONG: u8 = 15;\n    pub const BELL: u8 = 16;\n    pub const WHOOSH: u8 = 17;\n    pub const ROLL: u8 = 18;\n    pub const PLOP: u8 = 19;\n    pub const GLASS: u8 = 20;\n    pub const POP: u8 = 21;\n    pub const GUST: u8 = 22;\n    pub const WAVE: u8 = 23;\n    pub const SEA: u8 = 24;\n    pub const TONE: u8 = 25;\n    pub const CHIME: u8 = 26;\n    pub const STAR: u8 = 27;\n    pub const GROAN: u8 = 28;\n    pub const CHEER: u8 = 29;\n    pub const BURP: u8 = 30;\n    pub const BOING: u8 = 31;\n    pub const WOOD: u8 = 32;\n    pub const PERFECT: u8 = 33;\n    pub const GOOD: u8 = 34;\n    pub const COUNT: u8 = 35;\n    pub const GO: u8 = 36;\n    pub const FANFARE: u8 = 37;\n    pub const REVEAL: u8 = 38;\n    pub const LAST: u8 = 38;\n}\n\npub const SETS: [(&str, &str); 9] = [\n    (\"fit/sets/hub\", include_str!(\"sets/hub.toml\")),\n    (\"fit/sets/studio\", include_str!(\"sets/studio.toml\")),\n    (\"fit/sets/gazebo\", include_str!(\"sets/gazebo.toml\")),\n    (\"fit/sets/boardwalk\", include_str!(\"sets/boardwalk.toml\")),\n    (\"fit/sets/tide\", include_str!(\"sets/tide.toml\")),\n    (\"fit/sets/channel\", include_str!(\"sets/channel.toml\")),\n    (\"fit/sets/pier\", include_str!(\"sets/pier.toml\")),\n    (\"fit/sets/tower\", include_str!(\"sets/tower.toml\")),\n    (\"fit/sets/bay\", include_str!(\"sets/bay.toml\")),\n];\nconst SET_GAP: f32 = 400.0;\n\npub const GOALS: [u32; 4] = [3, 5, 7, 9];\npub const MEDLEY: [EvKind; 3] = [EvKind::Paddle, EvKind::Tide, EvKind::Cannon];\npub const ATTRACT: [Option<EvKind>; 10] = [\n    Some(EvKind::Cannon),\n    Some(EvKind::Paddle),\n    Some(EvKind::Step),\n    Some(EvKind::Pose),\n    Some(EvKind::Tide),\n    Some(EvKind::Spin),\n    Some(EvKind::Tray),\n    Some(EvKind::Plank),\n    Some(EvKind::Lap),\n    None,\n];\n/// Ticks of no input on the title or a pre-game menu before attract mode.\npub const ATTRACT_AFTER: u32 = 600;\n\n/// Named places per set, read from each set's `[game] spots` table, in world space.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Spots(pub Vec<BTreeMap<String, Vec3>>);\n\nimpl Spots {\n    pub fn get(&self, set: usize, name: &str) -> Vec3 {\n        self.0.get(set).and_then(|m| m.get(name)).copied().unwrap_or_else(|| {\n            log::error!(\"set {set} has no spot {name}\");\n            Vec3::new(set as f32 * SET_GAP, 0.0, 0.0)\n        })\n    }\n}\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum Mode {\n    #[default]\n    Title,\n    Setup,\n    Island,\n    Check,\n    Report,\n    Run,\n    Stamp,\n    Ending,\n    Credits,\n    PassPad,\n    Podium,\n    /// The hub round is finished; waiting for the hub.\n    HubDone,\n}\n\n/// Dev Mode's toggles.\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Dev {\n    pub no_tips: bool,\n    pub autoplay: bool,\n    pub skip_dialog: bool,\n    pub input_view: bool,\n    pub trace: bool,\n    pub stats: bool,\n    pub free_cam: bool,\n    pub ghosts: bool,\n    pub time_scale: f32,\n    pub freeze: bool,\n    pub step: bool,\n    pub group: usize,\n}\n\nimpl Default for Dev {\n    fn default() -> Self {\n        Self { no_tips: false, autoplay: false, skip_dialog: false, input_view: false, trace: false, stats: false, free_cam: false, ghosts: true, time_scale: 1.0, freeze: false, step: false, group: 0 }\n    }\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Attract {\n    pub idx: usize,\n    pub t: f32,\n}\n\n/// One player's Medley.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Racer {\n    pub name: String,\n    pub skin: u8,\n    pub outfit: u8,\n    pub scores: Vec<u32>,\n    pub ghosts: Vec<Vec<ghost::Sample>>,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Medley {\n    pub racers: Vec<Racer>,\n    pub who: usize,\n    pub leg: usize,\n    pub seed: u32,\n    pub rest: f32,\n}\n\n#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize)]\npub struct Cam {\n    pub shot: Shot,\n    pub cut: u32,\n    pub iris: bool,\n    pub rate: f32,\n    pub look_yaw: f32,\n    pub look_tilt: f32,\n    pub look_zoom: f32,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Gull {\n    pub body: EntityId,\n    pub left: EntityId,\n    pub right: EntityId,\n    pub center: Vec3,\n    pub radius: f32,\n    pub speed: f32,\n    pub phase: f32,\n    /// The Commodore stands still and wears a cap.\n    pub cap: Option<EntityId>,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Report {\n    pub age: i32,\n    pub delta: Option<i32>,\n    pub t: f32,\n    pub told: bool,\n    pub last_tick: i32,\n}\n\n#[derive(Clone, Serialize, Deserialize)]\npub struct FitGame {\n    pub rules: Rules,\n    pub base_rules: Rules,\n    pub save: Save,\n    pub slot: usize,\n    pub mode: Mode,\n    pub mode_t: f32,\n    pub menus: Vec<Menu>,\n    pub dialog: Option<Dialog>,\n    pub run: Option<Box<Run>>,\n    pub check: Option<Box<Check>>,\n    pub check_core: core::BalanceCore,\n    pub check_actors: Vec<EntityId>,\n    pub report: Report,\n    pub attract: Option<Attract>,\n    pub idle: u32,\n    pub touch_only: bool,\n    pub medley: Option<Medley>,\n    pub together_n: u32,\n    pub cam: Cam,\n    pub target: Shot,\n    pub spots: Spots,\n    pub flop_ids: [Option<EntityId>; 5],\n    pub gulls: Vec<Gull>,\n    pub tick: u64,\n    pub today: i64,\n    pub about: String,\n    pub outcome: Outcome,\n    pub hub: bool,\n    pub hub_go: bool,\n    pub hub_ended: bool,\n    pub seed: u32,\n    pub dev: Dev,\n    pub save_serial: u64,\n    #[serde(skip)]\n    pub save_blob: Arc<String>,\n    pub pause_t: f32,\n    pub paused: bool,\n    pub move_dir: Vec2,\n    pub walk_path: Vec<Vec3>,\n    pub walk_then: Option<island::Interact>,\n    pub near: Option<(island::Interact, Vec3, String)>,\n    pub msg: Option<(String, f32)>,\n    pub wave_cool: f32,\n    pub fullscreen: u32,\n    pub song: u8,\n    pub direct: bool,\n    pub name_pick: usize,\n    pub look_skin: u8,\n    pub look_outfit: u8,\n    pub ended_well: bool,\n    pub clam_t: f32,\n    pub turntable: bool,\n    pub last_any_device: u8,\n    pub lean_now: Vec2,\n    #[serde(skip)]\n    nav: Option<Arc<crate::nav::NavGrid>>,\n    pub set_now: usize,\n    pub rumble: f32,\n}\n\n/// What the page knows at boot.\n#[derive(Clone, Debug, Default)]\npub struct BootData {\n    pub today: i64,\n    pub about: String,\n    pub save: Option<String>,\n}\n\n/// Hands the page's data to a running game (a no-op for any other).\npub fn boot(sim: &mut Sim, data: BootData) {\n    if let Some(g) = sim.state.play.as_mut().and_then(|p| p.get_mut::<FitGame>()) {\n        g.today = data.today;\n        g.about = data.about;\n        if let Some(s) = data.save {\n            g.save = Save::parse(&s);\n        }\n    }\n}\n\n/// Builds every set on one sim and starts the game. `rest` picks a door for the tools and tests:\n/// `medley`, `event/<name>`, `stand`, `stand/<phase>`, `day/<n>`, `free`, `credits`.\npub fn build(sim: &mut Sim, rest: Option<&str>) -> Result<()> {\n    let rules_text = super::level_text(\"fit/rules\", include_str!(\"rules.toml\"));\n    let rules: Rules = toml::from_str(&rules_text).map_err(|e| anyhow!(\"fit/rules.toml: {e}\"))?;\n    let mut slots = Vec::new();\n    let mut spots = Spots::default();\n    for (i, (key, text)) in SETS.iter().enumerate() {\n        let mut def = RoomDef::parse(&super::level_text(key, text)).map_err(|e| anyhow!(\"{key}: {e}\"))?;\n        let origin = Vec3::new(SET_GAP * i as f32, 0.0, 0.0);\n        def.layout.origin = origin;\n        let mut here = BTreeMap::new();\n        if let Some(toml::Value::Table(t)) = def.game.get(\"spots\") {\n            for (k, v) in t {\n                let p: [f32; 3] = v.clone().try_into().map_err(|e| anyhow!(\"{key} spot {k}: {e}\"))?;\n                here.insert(k.clone(), origin + Vec3::from(p));\n            }\n        }\n        spots.0.push(here);\n        let place = crate::level::Placement::new(def.layout.origin, 0);\n        let (cols, rows) = def.layout.extent();\n        let (min, max) = place.aabb(Vec3::new(0.0, -1.0, 0.0), Vec3::new(cols as f32, def.height.max(2.0), rows as f32));\n        let start = def.local_start();\n        let inward = -def.entrance.facing.dir();\n        slots.push(RoomSlot { id: i as u16, key: (*key).into(), def: Arc::new(def), place, min, max, inside: place.point(start), outside: place.point(start) - inward * 4.0, inward, built: false });\n    }\n    let n = slots.len();\n    sim.state.world = World { enabled: false, rooms: slots, current_room: Some(0), ..Default::default() };\n    for i in 0..n {\n        sim.build_room(i);\n    }\n    let arrive = spots.get(HUB, \"arrive\");\n    sim.state.spawn = arrive;\n    sim.spawn_player();\n    sim.state.focus = arrive;\n    // Rewinding is for the engine's demo; here it would copy the whole save every 20 ticks.\n    sim.history.enabled = false;\n    let seed = sim.state.seed as u32;\n    let mut g = FitGame {\n        base_rules: rules.clone(),\n        rules,\n        save: Save::default(),\n        slot: 0,\n        mode: Mode::Title,\n        mode_t: 0.0,\n        menus: Vec::new(),\n        dialog: None,\n        run: None,\n        check: None,\n        check_core: core::BalanceCore::new(&mut sim.state.rng),\n        check_actors: Vec::new(),\n        report: Report::default(),\n        attract: None,\n        idle: 0,\n        touch_only: false,\n        medley: None,\n        together_n: 2,\n        cam: Cam { rate: 2.5, ..Default::default() },\n        target: Shot::default(),\n        spots,\n        flop_ids: [None; 5],\n        gulls: Vec::new(),\n        tick: 0,\n        today: 0,\n        about: String::new(),\n        outcome: Outcome::Playing,\n        hub: false,\n        hub_go: false,\n        hub_ended: false,\n        seed,\n        dev: Dev::default(),\n        save_serial: 0,\n        save_blob: Arc::new(String::new()),\n        pause_t: 0.0,\n        paused: false,\n        move_dir: Vec2::ZERO,\n        walk_path: Vec::new(),\n        walk_then: None,\n        near: None,\n        msg: None,\n        wave_cool: 0.0,\n        fullscreen: 0,\n        song: 0,\n        direct: false,\n        name_pick: 0,\n        look_skin: 1,\n        look_outfit: 0,\n        ended_well: false,\n        clam_t: 0.0,\n        turntable: false,\n        last_any_device: 0,\n        lean_now: Vec2::ZERO,\n        nav: None,\n        set_now: 0,\n        rumble: 0.0,\n    };\n    g.setup_scenery(sim);\n    let mut ev = Vec::new();\n    g.go_title(sim, &mut ev);\n    match rest {\n        None => {}\n        Some(\"medley\") => {\n            g.hub = true;\n            g.menus.clear();\n            g.begin_medley(sim, vec![Racer { name: \"You\".into(), skin: 1, outfit: 0, ..Default::default() }], seed, &mut ev);\n        }\n        Some(\"stand\") => {\n            g.direct_guest(sim);\n            g.start_finale(sim, 0, &mut ev);\n        }\n        Some(\"free\") => {\n            g.direct_guest(sim);\n            let d = g.guest_mut();\n            d.free_play = true;\n            d.day = 5;\n            d.ages = vec![60, 55, 50, 45, 38];\n            g.enter_island(sim, &mut ev);\n        }\n        Some(\"credits\") => {\n            g.direct_guest(sim);\n            g.set_mode(Mode::Credits);\n            g.menus.clear();\n        }\n        Some(r) => {\n            if let Some(name) = r.strip_prefix(\"event/\") {\n                let kind = EvKind::from_key(name).ok_or_else(|| anyhow!(\"no event '{name}'\"))?;\n                g.direct_guest(sim);\n                g.start_event(sim, kind, RunCtx::Stay, &mut ev);\n                if let Some(run) = &mut g.run {\n                    run.phase = Phase::Play;\n                }\n            } else if let Some(p) = r.strip_prefix(\"stand/\") {\n                let first: u32 = p.parse().map_err(|_| anyhow!(\"stand/<phase>\"))?;\n                g.direct_guest(sim);\n                g.start_finale(sim, first, &mut ev);\n            } else if let Some(d) = r.strip_prefix(\"day/\") {\n                let day: u8 = d.parse().map_err(|_| anyhow!(\"day/<n>\"))?;\n                g.direct_guest(sim);\n                g.guest_mut().day = day;\n                g.guest_mut().ages = vec![55];\n                g.enter_island(sim, &mut ev);\n            } else {\n                return Err(anyhow!(\"fit has no scene '{r}'\"));\n            }\n        }\n    }\n    g.direct = rest.is_some();\n    sim.state.play = Some(GameBox::new(g));\n    Ok(())\n}\n\nimpl FitGame {\n    pub fn guest(&self) -> Option<&Guest> {\n        self.save.guests.get(self.slot).and_then(|g| g.as_ref())\n    }\n\n    /// The current guest. A game in play always has one; the empty one is a safe stand-in.\n    pub fn guest_mut(&mut self) -> &mut Guest {\n        let slot = &mut self.save.guests[self.slot];\n        slot.get_or_insert_with(|| Guest::new(\"Guest\", 1, 0))\n    }\n\n    fn direct_guest(&mut self, sim: &mut Sim) {\n        self.menus.clear();\n        self.slot = 0;\n        self.guest_mut();\n        self.dress(sim);\n    }\n\n    pub fn set_mode(&mut self, m: Mode) {\n        self.mode = m;\n        self.mode_t = 0.0;\n    }\n\n    /// Puts the current guest's look on the player.\n    pub fn dress(&mut self, sim: &mut Sim) {\n        let Some(g) = self.guest() else { return };\n        let def = meta::guest_def(g.skin, g.outfit, &g.wear);\n        self.dress_as(sim, def);\n    }\n\n    pub fn dress_as(&self, sim: &mut Sim, def: crate::puppet::PuppetDef) {\n        if let Some(ch) = sim.state.player.and_then(|p| sim.state.entities.get_mut(p)).and_then(|e| e.character.as_mut()) {\n            ch.puppet = Some(Arc::new(def));\n        }\n    }\n\n    pub fn store(&mut self) {\n        if self.hub {\n            return;\n        }\n        if let Ok(s) = serde_json::to_string(&self.save) {\n            self.save_serial += 1;\n            self.save_blob = Arc::new(s);\n        }\n    }\n\n    pub fn play_song(&mut self, ev: &mut Vec<SimEvent>, song: u8) {\n        if self.song != song {\n            self.song = song;\n            ev.push(SimEvent::Music { song });\n        }\n    }\n\n    pub fn goto_set(&mut self, sim: &mut Sim, set: usize, at: Vec3) {\n        sim.state.world.current_room = Some(set as u16);\n        self.set_now = set;\n        if let Some(pid) = sim.state.player {\n            sim.set_position(pid, at);\n            if let Some(ch) = sim.state.entities.get_mut(pid).and_then(|e| e.character.as_mut()) {\n                ch.anim.tilt_side = 0.0;\n                ch.anim.tilt_fwd = 0.0;\n                ch.anim.tilt_pivot = 0.0;\n                ch.anim.lift = 0.0;\n                ch.anim.stop_clip();\n            }\n        }\n        self.cam.cut += 1;\n        self.cam.iris = true;\n    }\n\n    pub fn go_title(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        self.teardown_run(sim);\n        self.teardown_check(sim);\n        self.dialog = None;\n        self.medley = None;\n        self.attract = None;\n        self.menus.clear();\n        self.menus.push(Menu::new(MenuKind::Title));\n        self.set_mode(Mode::Title);\n        self.idle = 0;\n        let at = self.spots.get(HUB, \"arrive\");\n        self.goto_set(sim, HUB, at);\n        self.dress_as(sim, meta::guest_def(1, 5, &meta::Wear::default()));\n        self.play_song(ev, 1);\n    }\n\n    pub fn teardown_run(&mut self, sim: &mut Sim) {\n        if let Some(run) = self.run.take() {\n            for id in &run.actors {\n                sim.despawn(*id);\n            }\n        }\n        if let Some(a) = sim.state.player.and_then(|p| sim.state.entities.get_mut(p)).and_then(|e| e.character.as_mut()) {\n            a.anim.tilt_side = 0.0;\n            a.anim.tilt_fwd = 0.0;\n            a.anim.tilt_pivot = 0.0;\n            a.anim.stop_clip();\n        }\n    }\n\n    pub fn teardown_check(&mut self, sim: &mut Sim) {\n        self.check = None;\n        for id in self.check_actors.drain(..) {\n            sim.despawn(id);\n        }\n    }\n\n    // ------------------------------------------------------------------ the stay\n\n    /// Morning: on the cabana deck, Pip greets you.\n    pub fn begin_day(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        let wake = self.spots.get(HUB, \"wake\");\n        self.goto_set(sim, HUB, wake);\n        self.dress(sim);\n        self.set_mode(Mode::Island);\n        self.play_song(ev, 1);\n        let pick = sim.state.rng.next_u32();\n        let today = self.today;\n        let g = self.guest_mut();\n        let (day, last) = (g.day, g.last_day);\n        g.last_day = today;\n        g.checked_today = false;\n        let mut d = Dialog::new(After::GotoCheck);\n        if today > 0 && last > 0 && today > last {\n            let away = today - last;\n            d.push(script::PIP, format!(\"You were away for {away} day{}. I did not count them. There were {away}.\", if away == 1 { \"\" } else { \"s\" }));\n            d.push(script::PIP, script::line(\"pip_away\", pick));\n        }\n        d.push(script::PIP, script::line(&format!(\"pip_morning_{day}\"), pick));\n        self.dialog = Some(d);\n        self.store();\n    }\n\n    pub fn start_check(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        let c = self.spots.get(STUDIO, \"center\");\n        self.goto_set(sim, STUDIO, c);\n        self.check_core = core::BalanceCore::new(&mut sim.state.rng);\n        self.check_core.no_tip = true;\n        let pid = sim.state.player.unwrap_or(EntityId(0));\n        let mut shot = self.target;\n        let mut core_ = self.check_core.clone();\n        let mut msg = None;\n        let mut actors = Vec::new();\n        let mut flops = [false; 5];\n        let flop_ids = [None; 5];\n        let rules = self.rules.clone();\n        let spots = self.spots.clone();\n        let mut cx = Cx { sim, ev, r: &rules, dt: 1.0 / 60.0, core: &mut core_, actors: &mut actors, spots: &spots, pid, shot: &mut shot, msg: &mut msg, seed: self.seed, demo: false, slump: 0.0, flops: &mut flops, flop_ids: &flop_ids };\n        let check = Check::new(&mut cx);\n        self.check = Some(Box::new(check));\n        self.check_core = core_;\n        self.target = shot;\n        self.play_song(ev, 2);\n        self.set_mode(Mode::Check);\n    }\n\n    pub fn finish_check(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        let Some(check) = self.check.clone() else { return };\n        let g = self.guest();\n        let (days, stars, prev) = g.map(|g| (g.stamps as u32, g.total_stars(), g.age())).unwrap_or((0, 0, None));\n        let age = meta::balance_age(check.skill(), days, stars);\n        let wobbles = self.check_core.wobbles;\n        {\n            let g = self.guest_mut();\n            g.ages.push(age);\n            g.checked_today = true;\n            g.wobbles += wobbles;\n        }\n        self.report = Report { age, delta: prev.map(|p| age - p), t: 0.0, told: false, last_tick: 0 };\n        self.teardown_check_keep_state();\n        self.set_mode(Mode::Report);\n        ev.push(SimEvent::Sfx { id: sfx::REVEAL, gain: 0.7, pitch: 1.0 });\n        self.store();\n        let _ = sim;\n    }\n\n    fn teardown_check_keep_state(&mut self) {\n        // The check object stays until the verdict has been read: its metrics pick Pip's words.\n    }\n\n    /// Back on the island for the day's free time.\n    pub fn enter_island(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        self.teardown_check(sim);\n        let at = self.spots.get(HUB, \"arrive\");\n        self.goto_set(sim, HUB, at);\n        self.dress(sim);\n        self.set_mode(Mode::Island);\n        self.play_song(ev, 1);\n        self.walk_path.clear();\n        self.walk_then = None;\n        let flops = self.guest().map(|g| g.flops).unwrap_or_default();\n        for (k, id) in self.flop_ids.iter().enumerate() {\n            if flops[k] {\n                if let Some(id) = id {\n                    if let Some(e) = sim.state.entities.get_mut(*id) {\n                        e.pos.y = -9.0;\n                    }\n                }\n            }\n        }\n    }\n\n    /// The day's story beat, once, after the morning check.\n    pub fn day_story(&mut self, pick: u32) {\n        let g = self.guest();\n        let day = g.map(|g| g.day).unwrap_or(1);\n        let mut d = Dialog::new(After::Nothing);\n        for line in script::lines(&format!(\"story_{day}\")) {\n            let (who, text) = script_line(line);\n            d.push(who, text);\n        }\n        if d.lines.is_empty() {\n            d.push(script::PIP, script::line(\"pip_idle\", pick));\n        }\n        self.dialog = Some(d);\n    }\n\n    pub fn day_goal(&self) -> Option<u32> {\n        let g = self.guest()?;\n        if g.free_play || g.day >= 5 {\n            return None;\n        }\n        GOALS.get(g.day as usize - 1).copied()\n    }\n\n    pub fn goal_met(&self) -> bool {\n        match (self.day_goal(), self.guest()) {\n            (Some(goal), Some(g)) => g.minutes >= goal,\n            _ => false,\n        }\n    }\n\n    /// A big stamp lands; tomorrow comes.\n    pub fn end_day(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        let _ = sim;\n        let g = self.guest_mut();\n        g.stamps = (g.stamps + 1).min(5);\n        self.set_mode(Mode::Stamp);\n        ev.push(SimEvent::Sfx { id: sfx::STAMP, gain: 1.0, pitch: 1.0 });\n        self.store();\n    }\n\n    pub fn next_day(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        let g = self.guest_mut();\n        g.day = (g.day + 1).min(5);\n        g.minutes = 0;\n        g.done_today.clear();\n        g.goal_told = false;\n        self.begin_day(sim, ev);\n    }\n\n    pub fn event_open(&self, kind: EvKind) -> bool {\n        self.guest().is_some_and(|g| g.free_play || kind.day() <= g.day)\n    }\n\n    pub fn stand_open(&self) -> bool {\n        self.guest().is_some_and(|g| g.free_play || g.day >= 5)\n    }\n\n    // ------------------------------------------------------------------ events\n\n    pub fn start_event(&mut self, sim: &mut Sim, kind: EvKind, ctx: RunCtx, ev: &mut Vec<SimEvent>) {\n        self.start_body(sim, Some(kind), 0, ctx, ev);\n    }\n\n    pub fn start_finale(&mut self, sim: &mut Sim, first: u32, ev: &mut Vec<SimEvent>) {\n        self.start_body(sim, None, first, RunCtx::Finale, ev);\n    }\n\n    fn start_body(&mut self, sim: &mut Sim, kind: Option<EvKind>, first: u32, ctx: RunCtx, ev: &mut Vec<SimEvent>) {\n        self.teardown_run(sim);\n        self.teardown_check(sim);\n        self.menus.clear();\n        self.dialog = None;\n        let demo = ctx == RunCtx::Attract;\n        let set = kind.map(|k| k.set()).unwrap_or(BAY);\n        let at = self.spots.get(set, match set {\n            HUB => \"arrive\",\n            CHANNEL | PIER => \"start\",\n            TOWER => \"board\",\n            BAY => \"post\",\n            _ => \"center\",\n        });\n        self.goto_set(sim, set, at);\n        let mut core_ = core::BalanceCore::new(&mut sim.state.rng);\n        core_.no_tip = demo || self.dev.no_tips;\n        let pid = sim.state.player.unwrap_or(EntityId(0));\n        let mut shot = Shot::default();\n        let mut msg = None;\n        let mut actors = Vec::new();\n        let seed = self.medley.as_ref().map(|m| m.seed).unwrap_or(self.seed.wrapping_add(self.tick as u32));\n        let slump = self.slump();\n        let rules = self.rules.clone();\n        let spots = self.spots.clone();\n        let mut flops = self.guest().map(|g| g.flops).unwrap_or_default();\n        let flop_ids = self.flop_ids;\n        let mut cx = Cx { sim, ev, r: &rules, dt: 1.0 / 60.0, core: &mut core_, actors: &mut actors, spots: &spots, pid, shot: &mut shot, msg: &mut msg, seed, demo, slump, flops: &mut flops, flop_ids: &flop_ids };\n        let body = match kind {\n            Some(k) => Body::Ev(Ev::start(k, &mut cx, Opt::default())),\n            None => Body::Stand(Box::new(finale::Finale::start(&mut cx, first))),\n        };\n        let song = match kind {\n            Some(EvKind::Breath | EvKind::Pose) => 2,\n            Some(EvKind::Squats | EvKind::Plank) => 3,\n            Some(EvKind::Step | EvKind::Spin) => 4,\n            Some(_) => 5,\n            None => 6,\n        };\n        if kind != Some(EvKind::Step) {\n            self.song = song;\n            ev.push(SimEvent::Music { song });\n        }\n        let ghosts = self.ghosts_for(kind, ctx);\n        // The first frame shows the stage even before the first tick.\n        self.target = shot;\n        self.cam.shot = shot;\n        let phase = if demo || (self.hub && self.hub_go) { Phase::Play } else if ctx == RunCtx::Medley { Phase::Count } else { Phase::Card };\n        self.run = Some(Box::new(Run {\n            kind,\n            phase,\n            t: 0.0,\n            core: core_,\n            body,\n            actors,\n            shot,\n            msg,\n            rec: Vec::new(),\n            rec_in: 0.0,\n            ghosts,\n            ctx,\n            score: 0,\n            result: None,\n            coach_in: 6.0,\n            demo,\n            trace: Vec::new(),\n        }));\n        self.set_mode(Mode::Run);\n    }\n\n    pub fn slump(&self) -> f32 {\n        // Your figure's posture improves as the age falls: visible progress, no numbers needed.\n        let age = self.guest().and_then(|g| g.age()).unwrap_or(40) as f32;\n        ((age - 25.0) / 60.0).clamp(0.0, 1.0) * 0.14\n    }\n\n    fn ghosts_for(&self, kind: Option<EvKind>, ctx: RunCtx) -> Vec<RunGhost> {\n        if !self.dev.ghosts {\n            return Vec::new();\n        }\n        let Some(kind) = kind else { return Vec::new() };\n        match ctx {\n            RunCtx::Stay => {\n                let Some(g) = self.guest() else { return Vec::new() };\n                if g.day < 3 && !g.free_play {\n                    return Vec::new();\n                }\n                match g.ghosts.get(kind.key()) {\n                    Some(s) if !s.is_empty() => vec![RunGhost { samples: s.clone(), skin: g.skin, outfit: g.outfit, seat: 0, name: \"Yesterday You\".into() }],\n                    _ => Vec::new(),\n                }\n            }\n            RunCtx::Medley => {\n                let Some(m) = &self.medley else { return Vec::new() };\n                m.racers\n                    .iter()\n                    .enumerate()\n                    .filter(|(i, _)| *i < m.who)\n                    .filter_map(|(i, r)| {\n                        let s = r.ghosts.get(m.leg)?;\n                        Some(RunGhost { samples: s.clone(), skin: r.skin, outfit: r.outfit, seat: i as u8, name: r.name.clone() })\n                    })\n                    .collect()\n            }\n            _ => Vec::new(),\n        }\n    }\n\n    /// The input a run gets: a player's, the bot's, or nothing.\n    fn run_tick(&mut self, sim: &mut Sim, input: &InputFrame, dt: f32, ev: &mut Vec<SimEvent>) {\n        let Some(mut run) = self.run.take() else { return };\n        let pid = sim.state.player.unwrap_or(EntityId(0));\n        run.t += dt;\n        let rules = self.rules.clone();\n        let spots = self.spots.clone();\n        let mut msg = run.msg.take();\n        if let Some((_, left)) = &mut msg {\n            *left -= dt;\n        }\n        msg = msg.filter(|m| m.1 > 0.0);\n        match run.phase {\n            Phase::Card => {\n                if input.just(btn::CONFIRM) {\n                    run.phase = Phase::Count;\n                    run.t = 0.0;\n                    ev.push(SimEvent::Sfx { id: sfx::CONFIRM, gain: 0.8, pitch: 1.0 });\n                } else if input.just(btn::BACK) {\n                    ev.push(SimEvent::Sfx { id: sfx::BACK, gain: 0.8, pitch: 1.0 });\n                    self.run = Some(run);\n                    self.leave_run(sim, ev);\n                    return;\n                }\n            }\n            Phase::Count => {\n                if !self.hub || self.hub_go {\n                    let before = (run.t - dt).ceil() as i32;\n                    let now = run.t.ceil() as i32;\n                    if before != now && now <= 3 {\n                        ev.push(SimEvent::Sfx { id: sfx::COUNT, gain: 0.8, pitch: 1.0 });\n                    }\n                    if run.t >= 3.0 {\n                        run.phase = Phase::Play;\n                        run.t = 0.0;\n                        ev.push(SimEvent::Sfx { id: sfx::GO, gain: 0.9, pitch: 1.0 });\n                    }\n                } else {\n                    run.t = 0.0;\n                }\n            }\n            Phase::Play => {\n                let mut i = intent_of(input, self.save.settings.lean_sensitivity);\n                if run.demo || self.dev.autoplay {\n                    i = run.bot(&rules);\n                }\n                i.song_pos = input.song_pos;\n                run.core.no_tip = run.demo || self.dev.no_tips;\n                let scale = 1.0 - self.save.settings.wobble_assist * 0.8;\n                let mut r2 = rules.core.clone();\n                r2.wobble *= scale;\n                r2.kick *= scale;\n                let lean = i.lean;\n                let tipped = run.core.tick(lean, &r2, &mut sim.state.rng, dt);\n                let seed = self.medley.as_ref().map(|m| m.seed).unwrap_or(self.seed);\n                let slump = self.slump();\n                let any = input.any;\n                let mut flops = self.guest().map(|g| g.flops).unwrap_or_default();\n                let flop_ids = self.flop_ids;\n                let mut shot = run.shot;\n                let mut core_ = std::mem::take(&mut run.core);\n                let mut actors = std::mem::take(&mut run.actors);\n                let done = {\n                    let mut cx = Cx { sim, ev, r: &rules, dt, core: &mut core_, actors: &mut actors, spots: &spots, pid, shot: &mut shot, msg: &mut msg, seed, demo: run.demo, slump, flops: &mut flops, flop_ids: &flop_ids };\n                    if tipped {\n                        run.on_tip(&mut cx);\n                    }\n                    run.tick_body(&mut cx, &i, any)\n                };\n                run.core = core_;\n                run.actors = actors;\n                run.shot = shot;\n                if self.guest().is_some_and(|g| g.flops != flops) {\n                    self.guest_mut().flops = flops;\n                }\n                self.lean_now = lean;\n                // The coach chimes in now and then.\n                run.coach_in -= dt;\n                if run.coach_in <= 0.0 && msg.is_none() {\n                    run.coach_in = sim.state.rng.range(7.0, 12.0);\n                    if let Some(k) = run.kind {\n                        let key = format!(\"coach_{}\", k.pavilion());\n                        let n = sim.state.rng.next_u32();\n                        msg = Some((script::line(&key, n), 3.5));\n                    }\n                }\n                // Record for ghosts and for the hub.\n                run.rec_in -= dt;\n                if run.rec_in <= 0.0 && !run.demo {\n                    run.rec_in = 1.0 / ghost::RATE;\n                    if let Some(s) = sample_of(sim, run.t, run.live_score(&rules) as f32) {\n                        run.rec.push(s);\n                    }\n                }\n                if self.dev.trace {\n                    run.trace.push(run.core.cob.into());\n                    if run.trace.len() > 90 {\n                        run.trace.remove(0);\n                    }\n                }\n                if done {\n                    run.msg = msg;\n                    self.run = Some(run);\n                    self.finish_run(sim, ev);\n                    return;\n                }\n            }\n            Phase::Result => {}\n        }\n        run.msg = msg;\n        self.target = run.shot;\n        // Dev cheats from the menu.\n        self.run = Some(run);\n    }\n\n    /// Scores it, banks it, shows the result (or moves on, for a medley or the demo).\n    pub fn finish_run(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        let Some(run) = self.run.as_mut() else { return };\n        let score = run.live_score(&self.rules);\n        run.score = score;\n        let kind = run.kind;\n        let ctx = run.ctx;\n        let rec = std::mem::take(&mut run.rec);\n        match ctx {\n            RunCtx::Attract => self.attract_next(sim, ev),\n            RunCtx::Medley => {\n                if let Some(m) = &mut self.medley {\n                    if let Some(r) = m.racers.get_mut(m.who) {\n                        r.scores.push(score);\n                        r.ghosts.push(rec);\n                    }\n                }\n                self.medley_next(sim, ev);\n            }\n            RunCtx::Stay | RunCtx::Finale => {\n                let stars = meta::stars_for(score);\n                let key = kind.map(|k| k.key()).unwrap_or(\"stand\").to_string();\n                let free = self.guest().is_some_and(|g| g.free_play);\n                let g = self.guest_mut();\n                let first = g.done_today.insert(key.clone());\n                let mut minutes = if first { 1 + stars as u32 } else { 1 };\n                if ctx == RunCtx::Finale {\n                    minutes = 0;\n                }\n                g.minutes += minutes;\n                g.total_minutes += minutes;\n                let best = g.bests.entry(key.clone()).or_default();\n                let old_best = best.score;\n                let new_best = score > best.score;\n                let had_best = old_best > 0;\n                if new_best {\n                    best.score = score;\n                    best.stars = stars;\n                    g.ghosts.insert(key, rec);\n                }\n                let best_now = best.score;\n                let yesterday = if had_best && (g.day >= 3 || free) { Some(score as i32 - old_best as i32) } else { None };\n                let pick = sim.state.rng.next_u32();\n                let comment_key = match stars {\n                    3 => \"pip_result_3\",\n                    2 => \"pip_result_2\",\n                    1 => \"pip_result_1\",\n                    _ => \"pip_result_0\",\n                };\n                let result = ResultData { score, stars, title: script::title(score), minutes, best: best_now, new_best, yesterday, comment: script::line(comment_key, pick) };\n                if let Some(run) = self.run.as_mut() {\n                    run.phase = Phase::Result;\n                    run.t = 0.0;\n                    run.result = Some(result);\n                }\n                ev.push(SimEvent::Sfx { id: sfx::FANFARE, gain: 0.8, pitch: if stars >= 2 { 1.0 } else { 0.8 } });\n                for k in 0..stars {\n                    ev.push(SimEvent::Sfx { id: sfx::STAR, gain: 0.7, pitch: penta(k as u32 * 2 + 2) });\n                }\n                if stars == 3 {\n                    let at = sim.feet(sim.state.player.unwrap_or(EntityId(0))).unwrap_or_default();\n                    ev.push(SimEvent::Burst { pos: at + Vec3::Y * 3.0, kind: 0, count: 60 });\n                }\n                self.menus.clear();\n                self.menus.push(Menu::new(MenuKind::Result));\n                self.store();\n                if !self.goal_told() && self.goal_met() {\n                    self.guest_mut().goal_told = true;\n                    let pick = sim.state.rng.next_u32();\n                    let mut d = Dialog::new(After::Nothing);\n                    d.push(script::PIP, script::line(\"pip_goal_met\", pick));\n                    self.msg = None;\n                    self.pending_goal_line(d);\n                }\n            }\n        }\n    }\n\n    fn goal_told(&self) -> bool {\n        self.guest().is_some_and(|g| g.goal_told)\n    }\n\n    fn pending_goal_line(&mut self, d: Dialog) {\n        // Said when the result is dismissed, back on the island.\n        self.pending = Some(d);\n    }\n\n    /// Leaves a finished or abandoned run.\n    pub fn leave_run(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        let ctx = self.run.as_ref().map(|r| r.ctx);\n        let score = self.run.as_ref().map(|r| r.score).unwrap_or(0);\n        let finished = self.run.as_ref().is_some_and(|r| r.phase == Phase::Result);\n        self.menus.clear();\n        self.teardown_run(sim);\n        if self.direct && ctx != Some(RunCtx::Finale) && !self.hub && self.guest().is_some_and(|g| g.ages.is_empty()) {\n            // A door for the tools: there is no stay to go back to.\n            self.go_title(sim, ev);\n            return;\n        }\n        if ctx == Some(RunCtx::Finale) && finished {\n            self.after_finale(sim, score, ev);\n            return;\n        }\n        self.enter_island(sim, ev);\n        if let Some(d) = self.pending.take() {\n            self.dialog = Some(d);\n        }\n    }\n\n    fn after_finale(&mut self, sim: &mut Sim, score: u32, ev: &mut Vec<SimEvent>) {\n        let morning = self.guest().and_then(|g| g.age()).unwrap_or(60);\n        let final_age = (morning - (score as i32) / 100).clamp(18, 99);\n        let free = self.guest().is_some_and(|g| g.free_play);\n        let g = self.guest_mut();\n        g.best_final = g.best_final.max(score);\n        if !free {\n            g.ages.push(final_age);\n            g.stamps = (g.stamps + 1).min(5);\n        }\n        self.store();\n        self.enter_island(sim, ev);\n        if free {\n            let mut d = Dialog::new(After::Nothing);\n            d.push(script::PIP, format!(\"Your Big Stand scored {score}. It would have taken {} years off. Had you still been counting.\", score / 100));\n            self.dialog = Some(d);\n            return;\n        }\n        let pick = sim.state.rng.next_u32();\n        self.ended_well = final_age <= meta::CHECKOUT_AGE;\n        let mut d = Dialog::new(After::Ending);\n        d.push(script::PIP, format!(\"Your final Balance Age is {final_age}. The rule is 40 or better.\"));\n        for line in script::lines(if self.ended_well { \"ending_good\" } else { \"ending_stay\" }) {\n            let (who, text) = script_line(line);\n            d.push(who, text);\n        }\n        d.push(script::PIP, script::line(\"pip_idle\", pick));\n        self.dialog = Some(d);\n    }\n\n    pub fn after_dialog(&mut self, sim: &mut Sim, after: After, ev: &mut Vec<SimEvent>) {\n        match after {\n            After::Nothing => {}\n            After::StartCheck | After::GotoCheck => self.start_check(sim, ev),\n            After::IslandDay => {\n                self.enter_island(sim, ev);\n                let n = sim.state.rng.next_u32();\n                self.day_story(n);\n            }\n            After::EndDay => self.end_day(sim, ev),\n            After::FinaleCheck => self.start_finale(sim, 0, ev),\n            After::Ending => {\n                self.set_mode(Mode::Ending);\n                self.play_song(ev, 1);\n                if self.ended_well {\n                    let at = self.spots.get(HUB, \"mat_bigstand\") + Vec3::new(0.0, 0.0, 14.0);\n                    let boat = events::spawn_prop(sim, \"rowboat\", at - Vec3::Y * 0.1, std::f32::consts::PI, 1.4, \"#46bec8\");\n                    self.check_actors.push(boat);\n                }\n            }\n            After::Credits => self.set_mode(Mode::Credits),\n        }\n    }\n\n    pub fn to_free_play(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        self.teardown_check(sim);\n        let well = self.ended_well;\n        let g = self.guest_mut();\n        g.free_play = true;\n        g.checked_out = well;\n        self.outcome = if well { Outcome::Won } else { Outcome::Lost };\n        self.store();\n        self.enter_island(sim, ev);\n        let mut d = Dialog::new(After::Nothing);\n        for line in script::lines(\"free_play\") {\n            let (who, text) = script_line(line);\n            d.push(who, text);\n        }\n        self.dialog = Some(d);\n    }\n\n    // ------------------------------------------------------------------ medley\n\n    pub fn begin_medley(&mut self, sim: &mut Sim, racers: Vec<Racer>, seed: u32, ev: &mut Vec<SimEvent>) {\n        self.medley = Some(Medley { racers, who: 0, leg: 0, seed, rest: 0.0 });\n        self.medley_leg(sim, ev);\n    }\n\n    fn medley_leg(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        let Some(m) = &self.medley else { return };\n        let (leg, r) = (m.leg, m.racers.get(m.who).cloned().unwrap_or_default());\n        self.dress_as(sim, meta::guest_def(r.skin, r.outfit, &meta::Wear::default()));\n        self.start_event(sim, MEDLEY[leg % 3], RunCtx::Medley, ev);\n    }\n\n    fn medley_next(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        let hub = self.hub;\n        let Some(m) = &mut self.medley else { return };\n        m.leg += 1;\n        if m.leg < MEDLEY.len() {\n            self.medley_leg(sim, ev);\n            return;\n        }\n        m.leg = 0;\n        m.who += 1;\n        if hub {\n            self.teardown_run(sim);\n            self.set_mode(Mode::HubDone);\n            return;\n        }\n        let done = m.who >= m.racers.len();\n        self.teardown_run(sim);\n        if done {\n            self.menus.clear();\n            self.menus.push(Menu::new(MenuKind::Podium));\n            self.set_mode(Mode::Podium);\n            ev.push(SimEvent::Sfx { id: sfx::FANFARE, gain: 0.9, pitch: 1.0 });\n        } else {\n            self.set_mode(Mode::PassPad);\n        }\n    }\n\n    pub fn medley_total(&self) -> u32 {\n        let live = self.run.as_ref().filter(|r| r.ctx == RunCtx::Medley).map(|r| r.live_score(&self.rules)).unwrap_or(0);\n        let done: u32 = self.medley.as_ref().and_then(|m| m.racers.get(m.who.min(m.racers.len().saturating_sub(1)))).map(|r| r.scores.iter().sum()).unwrap_or(0);\n        done + live\n    }\n\n    // ------------------------------------------------------------------ attract\n\n    pub fn attract_start(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        self.menus.clear();\n        self.attract = Some(Attract { idx: 0, t: 0.0 });\n        let _ = (sim, ev);\n    }\n\n    pub fn attract_exit(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        self.attract = None;\n        self.go_title(sim, ev);\n    }\n\n    /// The next segment: sweep, ten events, the title card, and round again.\n    pub fn attract_next(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        self.teardown_run(sim);\n        let Some(a) = &mut self.attract else { return };\n        a.idx += 1;\n        a.t = 0.0;\n        let idx = a.idx;\n        if idx > ATTRACT.len() + 1 {\n            a.idx = 0;\n            let at = self.spots.get(HUB, \"arrive\");\n            self.goto_set(sim, HUB, at);\n            self.set_mode(Mode::Title);\n            return;\n        }\n        if idx == ATTRACT.len() + 1 {\n            let at = self.spots.get(HUB, \"arrive\");\n            self.goto_set(sim, HUB, at);\n            self.set_mode(Mode::Title);\n            return;\n        }\n        match ATTRACT[idx - 1] {\n            Some(k) => {\n                self.dress_as(sim, meta::guest_def(idx as u8, idx as u8, &meta::Wear::default()));\n                self.start_event(sim, k, RunCtx::Attract, ev);\n            }\n            None => self.start_body(sim, None, 3, RunCtx::Attract, ev),\n        }\n    }\n\n    fn attract_tick(&mut self, sim: &mut Sim, dt: f32, ev: &mut Vec<SimEvent>) {\n        let Some(a) = &mut self.attract else { return };\n        a.t += dt;\n        let (idx, t) = (a.idx, a.t);\n        let limit = if idx == 0 {\n            8.0\n        } else if idx == ATTRACT.len() + 1 {\n            5.0\n        } else {\n            15.0\n        };\n        if t >= limit {\n            self.attract_next(sim, ev);\n            return;\n        }\n        if self.run.is_some() {\n            self.run_tick(sim, &InputFrame::default(), dt, ev);\n        }\n    }\n\n    // ------------------------------------------------------------------ camera, scenery\n\n    fn update_cam(&mut self, sim: &Sim, input: &InputFrame, dt: f32) {\n        let hub_c = self.spots.get(HUB, \"arrive\");\n        let pos = sim.state.player.and_then(|p| sim.feet(p)).unwrap_or(hub_c);\n        let t = self.mode_t + self.tick as f32 * 0.0;\n        let shot = match self.mode {\n            _ if self.run.is_some() => self.run.as_ref().map(|r| r.shot).unwrap_or_default(),\n            Mode::Check | Mode::Report => self.target,\n            Mode::Title | Mode::Setup => {\n                if self.menus.last().is_some_and(|m| matches!(m.kind, MenuKind::Look)) {\n                    Shot { tilt: 8.0, yaw: 0.0, distance: 4.5, fov: 34.0, height: 1.0, focus: pos }\n                } else {\n                    Shot { tilt: 22.0 + (t * 0.05).sin() * 8.0, yaw: (self.tick as f32 / 60.0 * 4.0) % 360.0 - 180.0, distance: 46.0, fov: 40.0, height: 2.0, focus: hub_c }\n                }\n            }\n            Mode::Ending | Mode::Credits => {\n                let at = self.spots.get(HUB, \"mat_bigstand\");\n                Shot { tilt: 16.0, yaw: 10.0 + t * 1.5, distance: 26.0, fov: 40.0, height: 1.0, focus: at + Vec3::new(0.0, 0.0, 8.0) }\n            }\n            Mode::Stamp | Mode::PassPad | Mode::Podium | Mode::HubDone => Shot { tilt: 24.0, yaw: (self.tick as f32 / 60.0 * 3.0) % 360.0 - 180.0, distance: 30.0, fov: 40.0, height: 2.0, focus: hub_c },\n            Mode::Island => {\n                let wardrobe = self.menus.last().is_some_and(|m| matches!(m.kind, MenuKind::Wardrobe));\n                if wardrobe {\n                    Shot { tilt: 8.0, yaw: 0.0, distance: 4.5, fov: 34.0, height: 1.0, focus: pos }\n                } else {\n                    Shot { tilt: 38.0, yaw: 0.0, distance: 15.0, fov: 40.0, height: 0.9, focus: pos }\n                }\n            }\n        };\n        self.target = shot;\n        let c = &mut self.cam;\n        let free = self.dev.free_cam;\n        if self.mode == Mode::Island || free {\n            c.look_yaw = (c.look_yaw + input.look.x + 540.0).rem_euclid(360.0) - 180.0;\n            c.look_tilt = (c.look_tilt + input.look.y).clamp(-30.0, 40.0);\n            c.look_zoom = (c.look_zoom + input.look.z).clamp(-0.6, 1.5);\n        }\n        // Chase cameras and focus follow at once; other shots ease over.\n        let k = 1.0 - (-c.rate * dt).exp();\n        let s = &mut c.shot;\n        let snap = self.run.as_ref().is_some_and(|r| matches!(r.kind, Some(EvKind::Lap | EvKind::Paddle | EvKind::Tray | EvKind::Cannon)));\n        let lerp = |a: f32, b: f32| a + (b - a) * k;\n        s.tilt = lerp(s.tilt, shot.tilt);\n        let dy = (shot.yaw - s.yaw + 540.0).rem_euclid(360.0) - 180.0;\n        s.yaw = if snap || matches!(self.mode, Mode::Title | Mode::Stamp | Mode::PassPad | Mode::Podium | Mode::HubDone) { shot.yaw } else { s.yaw + dy * k };\n        s.distance = lerp(s.distance, shot.distance);\n        s.fov = lerp(s.fov, shot.fov);\n        s.height = lerp(s.height, shot.height);\n        s.focus = if snap { shot.focus } else { s.focus.lerp(shot.focus, (k * 3.0).min(1.0)) };\n    }\n\n    fn setup_scenery(&mut self, sim: &mut Sim) {\n        for k in 0..5 {\n            let at = self.spots.get(HUB, &format!(\"flop{k}\"));\n            self.flop_ids[k] = Some(events::spawn_prop(sim, \"fit_flipflop\", at + Vec3::Y * 0.03, k as f32 * 1.1, 1.2, \"#ffd166\"));\n        }\n        // Circling gulls over the sets, and the Commodore at his post.\n        let mut gulls = Vec::new();\n        for set in [HUB, STUDIO, BOARDWALK, TIDE, CHANNEL, PIER, TOWER, BAY] {\n            let n = if set == HUB { 5 } else { 2 };\n            let c = self.spots.0[set].values().next().copied().unwrap_or_default();\n            for k in 0..n {\n                let body = events::spawn_prop(sim, \"fit_gull\", c, 0.0, 1.0, \"#ffffff\");\n                let left = events::spawn_prop(sim, \"fit_wing\", c, 0.0, 1.0, \"#ffffff\");\n                let right = events::spawn_prop(sim, \"fit_wing\", c, 0.0, 1.0, \"#ffffff\");\n                gulls.push(Gull { body, left, right, center: c + Vec3::new(k as f32 * 3.0 - 3.0, 8.0 + k as f32 * 1.4, k as f32 * 2.0 - 6.0), radius: 10.0 + k as f32 * 4.0, speed: 0.35 + k as f32 * 0.06, phase: k as f32 * 2.1, cap: None });\n            }\n        }\n        let at = self.spots.get(HUB, \"gull\");\n        let body = events::spawn_prop(sim, \"fit_gull\", at, 0.0, 1.3, \"#ffffff\");\n        let left = events::spawn_prop(sim, \"fit_wing\", at, 0.0, 1.2, \"#ffffff\");\n        let right = events::spawn_prop(sim, \"fit_wing\", at, 0.0, 1.2, \"#ffffff\");\n        let cap = events::spawn_prop(sim, \"fit_cap\", at, 0.0, 1.3, \"#ffffff\");\n        gulls.push(Gull { body, left, right, center: at + Vec3::Y * 0.42, radius: 0.0, speed: 0.0, phase: 0.0, cap: Some(cap) });\n        self.gulls = gulls;\n    }\n\n    fn fly_gulls(&self, sim: &mut Sim) {\n        use glam::Quat;\n        let t = self.tick as f32 / 60.0;\n        for g in &self.gulls {\n            let a = t * g.speed + g.phase;\n            let (pos, yaw) = if g.radius > 0.0 {\n                (g.center + Vec3::new(a.cos() * g.radius, (a * 2.0).sin() * 0.6, a.sin() * g.radius), -a)\n            } else {\n                (g.center, 0.0)\n            };\n            let flap = if g.radius > 0.0 { (t * 7.0 + g.phase).sin() * 0.5 } else { -1.2 + (t * 3.0).sin().abs() * 0.1 };\n            let rot = Quat::from_rotation_y(yaw);\n            let set = |sim: &mut Sim, id: EntityId, p: Vec3, r: Quat| {\n                if let Some(e) = sim.state.entities.get_mut(id) {\n                    e.pos = p;\n                    e.rot = r;\n                }\n            };\n            set(sim, g.body, pos, rot);\n            set(sim, g.left, pos + rot * Vec3::new(0.1, 0.05, 0.0), rot * Quat::from_rotation_z(flap));\n            set(sim, g.right, pos + rot * Vec3::new(-0.1, 0.05, 0.0), rot * Quat::from_rotation_y(std::f32::consts::PI) * Quat::from_rotation_z(flap));\n            if let Some(c) = g.cap {\n                set(sim, c, pos + Vec3::new(0.0, 0.26, 0.3), rot);\n            }\n        }\n    }\n\n    pub fn status_json(&self, sim: &Sim) -> serde_json::Value {\n        let score = self.medley_total();\n        let leg = self.medley.as_ref().map(|m| m.leg).unwrap_or(0);\n        let label = self.run.as_ref().and_then(|r| r.kind).map(|k| k.name()).unwrap_or(if self.mode == Mode::HubDone { \"Finished\" } else { \"Warming up\" });\n        let done = self.mode == Mode::HubDone;\n        let area = if self.run.is_some() { leg as i32 } else { -1 };\n        let s = sim.state.player.and_then(|p| sim.state.entities.get(p)).and_then(|e| {\n            let c = e.character.as_ref()?;\n            Some(json!({\"p\": sim.feet(e.id).map(|f| [round(f.x), round(f.y), round(f.z)]), \"f\": round(c.anim.facing), \"ts\": round(c.anim.tilt_side), \"tf\": round(c.anim.tilt_fwd), \"c\": c.anim.clip, \"ct\": round(c.anim.clip_t)}))\n        });\n        let mut ghost = s.unwrap_or(json!({}));\n        ghost[\"area\"] = json!(area);\n        ghost[\"s\"] = json!(score);\n        let stats = self.medley.as_ref().and_then(|m| m.racers.first()).map(|r| r.scores.clone()).unwrap_or_default();\n        let screen = menus::screen_name(self);\n        json!({\n            \"screen\": screen,\n            \"mode\": format!(\"{:?}\", self.mode),\n            \"tick\": sim.state.tick,\n            \"attract\": self.attract.as_ref().map(|a| a.idx),\n            \"focus\": self.menus.last().map(|m| m.focus),\n            \"day\": self.guest().map(|g| g.day),\n            \"age\": self.guest().and_then(|g| g.age()),\n            \"minutes\": self.guest().map(|g| g.minutes),\n            \"stamps\": self.guest().map(|g| g.stamps),\n            \"dialog\": self.dialog.is_some(),\n            \"phase\": self.run.as_ref().map(|r| format!(\"{:?}\", r.phase)),\n            \"event\": self.run.as_ref().map(|r| r.name()),\n            \"touch_only\": self.touch_only,\n            \"music\": self.save.settings.music,\n            \"xbox\": self.save.settings.xbox,\n            \"hub\": { \"score\": score, \"label\": label, \"done\": done, \"stats\": { \"paddle\": stats.first(), \"tide\": stats.get(1), \"cannonball\": stats.get(2) }, \"ghost\": ghost },\n        })\n    }\n}\n\nfn round(x: f32) -> f64 {\n    (x as f64 * 100.0).round() / 100.0\n}\n\n/// A script line of the form \"Speaker: text\" (no speaker: Pip).\npub fn script_line(line: &str) -> (u8, String) {\n    if let Some((who, text)) = line.split_once(\": \") {\n        if let Some(i) = script::SPEAKERS.iter().position(|s| *s == who) {\n            return (i as u8, text.to_string());\n        }\n    }\n    (script::PIP, line.to_string())\n}\n\npub fn intent_of(input: &InputFrame, sensitivity: f32) -> Intent {\n    Intent {\n        lean: (input.lean * sensitivity).clamp_length_max(1.0),\n        keys: input.lean_keys,\n        act: input.down(btn::CONFIRM),\n        act_p: input.just(btn::CONFIRM),\n        l: input.down(btn::STEP_L),\n        l_p: input.just(btn::STEP_L),\n        r: input.down(btn::STEP_R),\n        r_p: input.just(btn::STEP_R),\n        song_pos: input.song_pos,\n    }\n}\n\nfn sample_of(sim: &Sim, t: f32, score: f32) -> Option<ghost::Sample> {\n    let pid = sim.state.player?;\n    let e = sim.state.entities.get(pid)?;\n    let c = e.character.as_ref()?;\n    let f = sim.feet(pid)?;\n    Some(ghost::Sample { t, p: f.to_array(), f: c.anim.facing, ts: c.anim.tilt_side, tf: c.anim.tilt_fwd, c: if c.anim.clip_w > 0.5 { c.anim.clip } else { 0 }, ct: c.anim.clip_t, s: score })\n}\n\nimpl Game for FitGame {\n    const KEY: &'static str = \"fit\";\n\n    fn pre(&mut self, sim: &mut Sim, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) -> BTreeMap<EntityId, InputFrame> {\n        self.tick += 1;\n        let dt = if dt <= 0.0 { 1.0 / 60.0 } else { dt };\n        let mut out = BTreeMap::new();\n        self.touch_only = input.down(btn::TOUCH_ONLY);\n        if input.down(btn::HUB_GO) {\n            self.hub_go = true;\n        }\n        self.mode_t += dt;\n        self.move_dir = Vec2::ZERO;\n        if self.attract.is_some() {\n            if input.any && !self.touch_only {\n                self.attract_exit(sim, events);\n                self.idle = 0;\n            } else if self.touch_only && input.ui.is_some() {\n                // A tap on the Settings button.\n                self.attract_exit(sim, events);\n                self.menus.push(Menu::new(MenuKind::Settings));\n            } else {\n                self.attract_tick(sim, dt, events);\n            }\n        } else {\n            // Pre-game: title and setup menus count idle ticks.\n            let pregame = matches!(self.mode, Mode::Title | Mode::Setup);\n            if pregame && !input.any {\n                self.idle += 1;\n                if self.idle >= ATTRACT_AFTER || (self.touch_only && self.menus.iter().all(|m| matches!(m.kind, MenuKind::Title))) {\n                    self.idle = 0;\n                    self.attract_start(sim, events);\n                }\n            } else {\n                self.idle = 0;\n            }\n            let neutral = InputFrame::default();\n            let mut stream = *input;\n            if !self.menus.is_empty() {\n                self.menu_input(sim, input, events);\n                stream = neutral;\n            } else if input.just(btn::PAUSE) && self.can_pause() {\n                self.open_pause(events);\n                stream = neutral;\n            } else if self.dialog.is_some() {\n                let conf = input.just(btn::CONFIRM) || input.just(btn::PRIMARY);\n                let speed = self.save.settings.text_speed;\n                let skip = self.dev.skip_dialog;\n                let finished = match &mut self.dialog {\n                    Some(d) => {\n                        if skip {\n                            d.lines.clear();\n                            true\n                        } else {\n                            d.tick(conf, speed, dt, events)\n                        }\n                    }\n                    None => false,\n                };\n                if finished {\n                    let after = self.dialog.take().map(|d| d.after).unwrap_or_default();\n                    self.after_dialog(sim, after, events);\n                }\n                stream = neutral;\n            }\n            self.paused = self.menus.iter().any(|m| m.kind == MenuKind::Pause) && !self.hub;\n            if self.paused {\n                self.pause_t += dt;\n            } else if !self.dev_frozen() {\n                self.mode_tick(sim, &stream, dt, events);\n            }\n        }\n        if !self.frozen() {\n            self.fly_gulls(sim);\n        }\n        self.dev.step = false;\n        self.update_cam(sim, input, dt);\n        if let Some(pid) = sim.state.player {\n            out.insert(pid, InputFrame { move_dir: self.move_dir, ..Default::default() });\n        }\n        out\n    }\n\n    fn post(&mut self, sim: &mut Sim, _dt: f32, _events: &mut Vec<SimEvent>) {\n        if self.mode == Mode::Island && self.run.is_none() {\n            self.keep_on_land(sim);\n        }\n    }\n\n    fn hud(&self, _sim: &Sim) -> Vec<String> {\n        Vec::new()\n    }\n\n    fn status(&self, sim: &Sim) -> serde_json::Value {\n        self.status_json(sim)\n    }\n\n    fn outcome(&self) -> Outcome {\n        self.outcome\n    }\n\n    fn bot(&self, sim: &Sim) -> InputFrame {\n        self.bot_input(sim)\n    }\n\n    fn frozen(&self) -> bool {\n        self.paused || self.dev_frozen()\n    }\n\n    fn extras(&self, sim: &Sim) -> Extras {\n        let mut objects = Vec::new();\n        if let Some(run) = &self.run {\n            let lane_base = run.kind;\n            for (k, g) in run.ghosts.iter().enumerate() {\n                if let Some(s) = ghost::at(&g.samples, run.t) {\n                    let def = Arc::new(meta::guest_def(g.skin, g.outfit, &meta::Wear::default()));\n                    objects.push(ghost::object(k as u32, &s, run::ghost_lane(lane_base, k), def, ghost::SEATS[g.seat as usize % 4], 0.55));\n                }\n            }\n        }\n        let frame = self.ui_frame(sim);\n        let c = self.cam;\n        let s = c.shot;\n        Extras {\n            status: Some(Arc::new(self.status_json(sim).to_string())),\n            fit: Some(Arc::new(frame)),\n            camera: Some(GameCamera {\n                tilt: (s.tilt + c.look_tilt).clamp(2.0, 89.0),\n                yaw: (s.yaw + c.look_yaw + 540.0).rem_euclid(360.0) - 180.0,\n                distance: s.distance * (1.0 + c.look_zoom),\n                fov: s.fov.max(10.0),\n                height: s.height,\n                cut: c.cut,\n                iris: c.iris,\n            }),\n            focus: Some(s.focus),\n            objects,\n        }\n    }\n}\n\nimpl FitGame {\n    fn dev_frozen(&self) -> bool {\n        self.dev.freeze && !self.dev.step && !self.menus.iter().any(|m| m.kind == MenuKind::Pause)\n    }\n\n    fn can_pause(&self) -> bool {\n        matches!(self.mode, Mode::Island | Mode::Run | Mode::Check | Mode::Report | Mode::Stamp | Mode::Ending | Mode::Credits | Mode::HubDone | Mode::PassPad)\n    }\n\n    pub fn open_pause(&mut self, ev: &mut Vec<SimEvent>) {\n        self.menus.push(Menu::new(MenuKind::Pause));\n        self.pause_t = 0.0;\n        ev.push(SimEvent::Sfx { id: sfx::CONFIRM, gain: 0.5, pitch: 0.9 });\n    }\n\n    fn mode_tick(&mut self, sim: &mut Sim, input: &InputFrame, dt: f32, ev: &mut Vec<SimEvent>) {\n        match self.mode {\n            Mode::Island => self.island_tick(sim, input, dt, ev),\n            Mode::Run => self.run_tick(sim, input, dt, ev),\n            Mode::Check => {\n                let Some(mut check) = self.check.take() else { return };\n                let pid = sim.state.player.unwrap_or(EntityId(0));\n                let i = if self.dev.autoplay { check.bot(&self.check_core, &self.rules) } else { intent_of(input, self.save.settings.lean_sensitivity) };\n                let rules = self.rules.clone();\n                let spots = self.spots.clone();\n                let mut core_ = std::mem::take(&mut self.check_core);\n                let scale = 1.0 - self.save.settings.wobble_assist * 0.8;\n                let mut r2 = rules.core.clone();\n                r2.wobble *= scale;\n                core_.tick(i.lean, &r2, &mut sim.state.rng, dt);\n                let mut shot = self.target;\n                let mut msg = None;\n                let mut actors = std::mem::take(&mut self.check_actors);\n                let mut flops = [false; 5];\n                let flop_ids = [None; 5];\n                let slump = self.slump();\n                let done = {\n                    let mut cx = Cx { sim, ev, r: &rules, dt, core: &mut core_, actors: &mut actors, spots: &spots, pid, shot: &mut shot, msg: &mut msg, seed: self.seed, demo: false, slump, flops: &mut flops, flop_ids: &flop_ids };\n                    check.tick(&mut cx, &i)\n                };\n                self.rumble = check.rumble;\n                self.check_core = core_;\n                self.check_actors = actors;\n                self.target = shot;\n                self.check = Some(check);\n                if done {\n                    self.finish_check(sim, ev);\n                }\n            }\n            Mode::Report => {\n                self.report.t += dt;\n                // The number rolls like a slot machine for three seconds.\n                let tk = (self.report.t * 14.0) as i32;\n                if self.report.t < 3.0 && tk != self.report.last_tick {\n                    self.report.last_tick = tk;\n                    ev.push(SimEvent::Sfx { id: sfx::TICK, gain: 0.5, pitch: 1.0 + (tk % 5) as f32 * 0.05 });\n                }\n                if self.report.t >= 3.0 && !self.report.told {\n                    self.report.told = true;\n                    ev.push(SimEvent::Sfx { id: sfx::STAMP, gain: 0.8, pitch: 1.2 });\n                    let pick = sim.state.rng.next_u32();\n                    let mut d = Dialog::new(After::IslandDay);\n                    if let Some(c) = &self.check {\n                        for (who, text) in c.verdict(self.report.age, self.report.delta, &self.check_core, pick) {\n                            d.push(who, text);\n                        }\n                    }\n                    self.dialog = Some(d);\n                }\n            }\n            Mode::Stamp => {\n                if self.mode_t > 2.5 {\n                    self.next_day(sim, ev);\n                }\n            }\n            Mode::Ending => {\n                // The rowboat leaves, or the sun simply goes on setting.\n                if self.ended_well {\n                    if let Some(id) = self.check_actors.first().copied() {\n                        if let Some(e) = sim.state.entities.get_mut(id) {\n                            e.pos.z += 2.2 * dt;\n                        }\n                    }\n                }\n                if self.mode_t > 6.0 || input.just(btn::CONFIRM) {\n                    self.set_mode(Mode::Credits);\n                }\n            }\n            Mode::Credits => {\n                if self.mode_t > 16.0 || (self.mode_t > 1.0 && input.just(btn::CONFIRM)) {\n                    if self.direct && self.guest().is_some_and(|g| g.ages.is_empty()) {\n                        self.go_title(sim, ev);\n                    } else {\n                        self.to_free_play(sim, ev);\n                    }\n                }\n            }\n            Mode::PassPad => {\n                if input.just(btn::CONFIRM) {\n                    self.medley_leg(sim, ev);\n                }\n            }\n            Mode::Title | Mode::Setup | Mode::Podium | Mode::HubDone => {}\n        }\n    }\n}\nRS\ngrep -n \"pending\" $F/mod.rs | head -3; sed -i 's/^    pub rumble: f32,\\n}/&/' $F/mod.rs\npython3 - <<'PY'\np='engine/crates/pav_core/src/games/fit/mod.rs'\ns=open(p).read()\ns=s.replace('''    pub set_now: usize,\n    pub rumble: f32,\n}''','''    pub set_now: usize,\n    pub rumble: f32,\n    /// Said when the result screen is dismissed.\n    pub pending: Option<Dialog>,\n}''')\ns=s.replace('''        set_now: 0,\n        rumble: 0.0,\n    };''','''        set_now: 0,\n        rumble: 0.0,\n        pending: None,\n    };''')\nopen(p,'w').write(s)\nPY","description":"Write the main game module: flow, camera, attract, medley, Game impl"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15138,"cache_read_input_tokens":368882,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15138},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cb437ba7-0477-4143-bb04-ff33f49efd62","uuid":"3f6dd5a2-7c28-4c86-a8a1-93457fdba7af","timestamp":"2026-11-05T06:05:27.786Z","request_id":"req_011CgjGmxcdZUGRBRXByPHMT","wire_tool_inputs":{"toolu_018cYZCJeezGFbGmgF2NLcWT":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953\nF=engine/crates/pav_core/src/games/fit\ncat > $F/mod.rs <<'RS'\n//! We Stand: a balance-and-wellness comedy on Tippy Cay, a resort staffed by talking gym equipment.\n//!\n//! All game state and flow live here, in one `Game`: menus, dialogue, pause, settings and dev\n//! toggles are state driven by `InputFrame`, so `cargo test` plays the whole game with no browser\n//! or GPU. `pav_ui::fit_ui` draws the `UiFrame` this writes and reports what the pointer did.\n//! `README.md` in the dev folder explains adding an event, a set and a song.\n\nuse std::collections::BTreeMap;\nuse std::sync::Arc;\n\nuse anyhow::{Result, anyhow};\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\nuse serde_json::json;\n\nuse super::{Extras, Game, GameBox, Outcome};\nuse crate::entity::EntityId;\nuse crate::frame::{GameCamera, SimEvent};\nuse crate::input::{InputFrame, buttons as btn};\nuse crate::room::RoomDef;\nuse crate::sim::Sim;\nuse crate::world::{RoomSlot, World};\n\npub mod check;\npub mod core;\npub mod dialog;\npub mod events;\npub mod finale;\npub mod ghost;\npub mod island;\npub mod menus;\npub mod meta;\npub mod rules;\npub mod run;\npub mod script;\npub mod ui_model;\n\nuse check::Check;\nuse dialog::{After, Dialog};\nuse events::*;\nuse menus::{Menu, MenuKind};\nuse meta::{Guest, Save};\nuse rules::Rules;\nuse run::{Body, Phase, ResultData, Run, RunCtx, RunGhost};\nuse ui_model::*;\n\n/// The game's title, in one place.\npub const TITLE: &str = \"We Stand\";\npub const TAGLINE: &str = \"A wellness resort you did not enter\";\n\n/// Sounds by number; `pav_audio` holds the bank.\npub mod sfx {\n    pub const MOVE: u8 = 1;\n    pub const CONFIRM: u8 = 2;\n    pub const BACK: u8 = 3;\n    pub const STAMP: u8 = 4;\n    pub const GULP: u8 = 5;\n    pub const TICK: u8 = 6;\n    pub const STEP: u8 = 7;\n    pub const SQUEAK: u8 = 8;\n    pub const CREAK: u8 = 9;\n    pub const SPLASH_S: u8 = 10;\n    pub const SPLASH_B: u8 = 11;\n    pub const GULL: u8 = 12;\n    pub const MURMUR: u8 = 13;\n    pub const CLAP: u8 = 14;\n    pub const GONG: u8 = 15;\n    pub const BELL: u8 = 16;\n    pub const WHOOSH: u8 = 17;\n    pub const ROLL: u8 = 18;\n    pub const PLOP: u8 = 19;\n    pub const GLASS: u8 = 20;\n    pub const POP: u8 = 21;\n    pub const GUST: u8 = 22;\n    pub const WAVE: u8 = 23;\n    pub const SEA: u8 = 24;\n    pub const TONE: u8 = 25;\n    pub const CHIME: u8 = 26;\n    pub const STAR: u8 = 27;\n    pub const GROAN: u8 = 28;\n    pub const CHEER: u8 = 29;\n    pub const BURP: u8 = 30;\n    pub const BOING: u8 = 31;\n    pub const WOOD: u8 = 32;\n    pub const PERFECT: u8 = 33;\n    pub const GOOD: u8 = 34;\n    pub const COUNT: u8 = 35;\n    pub const GO: u8 = 36;\n    pub const FANFARE: u8 = 37;\n    pub const REVEAL: u8 = 38;\n    pub const LAST: u8 = 38;\n}\n\npub const SETS: [(&str, &str); 9] = [\n    (\"fit/sets/hub\", include_str!(\"sets/hub.toml\")),\n    (\"fit/sets/studio\", include_str!(\"sets/studio.toml\")),\n    (\"fit/sets/gazebo\", include_str!(\"sets/gazebo.toml\")),\n    (\"fit/sets/boardwalk\", include_str!(\"sets/boardwalk.toml\")),\n    (\"fit/sets/tide\", include_str!(\"sets/tide.toml\")),\n    (\"fit/sets/channel\", include_str!(\"sets/channel.toml\")),\n    (\"fit/sets/pier\", include_str!(\"sets/pier.toml\")),\n    (\"fit/sets/tower\", include_str!(\"sets/tower.toml\")),\n    (\"fit/sets/bay\", include_str!(\"sets/bay.toml\")),\n];\nconst SET_GAP: f32 = 400.0;\n\npub const GOALS: [u32; 4] = [3, 5, 7, 9];\npub const MEDLEY: [EvKind; 3] = [EvKind::Paddle, EvKind::Tide, EvKind::Cannon];\npub const ATTRACT: [Option<EvKind>; 10] = [\n    Some(EvKind::Cannon),\n    Some(EvKind::Paddle),\n    Some(EvKind::Step),\n    Some(EvKind::Pose),\n    Some(EvKind::Tide),\n    Some(EvKind::Spin),\n    Some(EvKind::Tray),\n    Some(EvKind::Plank),\n    Some(EvKind::Lap),\n    None,\n];\n/// Ticks of no input on the title or a pre-game menu before attract mode.\npub const ATTRACT_AFTER: u32 = 600;\n\n/// Named places per set, read from each set's `[game] spots` table, in world space.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Spots(pub Vec<BTreeMap<String, Vec3>>);\n\nimpl Spots {\n    pub fn get(&self, set: usize, name: &str) -> Vec3 {\n        self.0.get(set).and_then(|m| m.get(name)).copied().unwrap_or_else(|| {\n            log::error!(\"set {set} has no spot {name}\");\n            Vec3::new(set as f32 * SET_GAP, 0.0, 0.0)\n        })\n    }\n}\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum Mode {\n    #[default]\n    Title,\n    Setup,\n    Island,\n    Check,\n    Report,\n    Run,\n    Stamp,\n    Ending,\n    Credits,\n    PassPad,\n    Podium,\n    /// The hub round is finished; waiting for the hub.\n    HubDone,\n}\n\n/// Dev Mode's toggles.\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Dev {\n    pub no_tips: bool,\n    pub autoplay: bool,\n    pub skip_dialog: bool,\n    pub input_view: bool,\n    pub trace: bool,\n    pub stats: bool,\n    pub free_cam: bool,\n    pub ghosts: bool,\n    pub time_scale: f32,\n    pub freeze: bool,\n    pub step: bool,\n    pub group: usize,\n}\n\nimpl Default for Dev {\n    fn default() -> Self {\n        Self { no_tips: false, autoplay: false, skip_dialog: false, input_view: false, trace: false, stats: false, free_cam: false, ghosts: true, time_scale: 1.0, freeze: false, step: false, group: 0 }\n    }\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Attract {\n    pub idx: usize,\n    pub t: f32,\n}\n\n/// One player's Medley.\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Racer {\n    pub name: String,\n    pub skin: u8,\n    pub outfit: u8,\n    pub scores: Vec<u32>,\n    pub ghosts: Vec<Vec<ghost::Sample>>,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Medley {\n    pub racers: Vec<Racer>,\n    pub who: usize,\n    pub leg: usize,\n    pub seed: u32,\n    pub rest: f32,\n}\n\n#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize)]\npub struct Cam {\n    pub shot: Shot,\n    pub cut: u32,\n    pub iris: bool,\n    pub rate: f32,\n    pub look_yaw: f32,\n    pub look_tilt: f32,\n    pub look_zoom: f32,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Gull {\n    pub body: EntityId,\n    pub left: EntityId,\n    pub right: EntityId,\n    pub center: Vec3,\n    pub radius: f32,\n    pub speed: f32,\n    pub phase: f32,\n    /// The Commodore stands still and wears a cap.\n    pub cap: Option<EntityId>,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Report {\n    pub age: i32,\n    pub delta: Option<i32>,\n    pub t: f32,\n    pub told: bool,\n    pub last_tick: i32,\n}\n\n#[derive(Clone, Serialize, Deserialize)]\npub struct FitGame {\n    pub rules: Rules,\n    pub base_rules: Rules,\n    pub save: Save,\n    pub slot: usize,\n    pub mode: Mode,\n    pub mode_t: f32,\n    pub menus: Vec<Menu>,\n    pub dialog: Option<Dialog>,\n    pub run: Option<Box<Run>>,\n    pub check: Option<Box<Check>>,\n    pub check_core: core::BalanceCore,\n    pub check_actors: Vec<EntityId>,\n    pub report: Report,\n    pub attract: Option<Attract>,\n    pub idle: u32,\n    pub touch_only: bool,\n    pub medley: Option<Medley>,\n    pub together_n: u32,\n    pub cam: Cam,\n    pub target: Shot,\n    pub spots: Spots,\n    pub flop_ids: [Option<EntityId>; 5],\n    pub gulls: Vec<Gull>,\n    pub tick: u64,\n    pub today: i64,\n    pub about: String,\n    pub outcome: Outcome,\n    pub hub: bool,\n    pub hub_go: bool,\n    pub hub_ended: bool,\n    pub seed: u32,\n    pub dev: Dev,\n    pub save_serial: u64,\n    #[serde(skip)]\n    pub save_blob: Arc<String>,\n    pub pause_t: f32,\n    pub paused: bool,\n    pub move_dir: Vec2,\n    pub walk_path: Vec<Vec3>,\n    pub walk_then: Option<island::Interact>,\n    pub near: Option<(island::Interact, Vec3, String)>,\n    pub msg: Option<(String, f32)>,\n    pub wave_cool: f32,\n    pub fullscreen: u32,\n    pub song: u8,\n    pub direct: bool,\n    pub name_pick: usize,\n    pub look_skin: u8,\n    pub look_outfit: u8,\n    pub ended_well: bool,\n    pub clam_t: f32,\n    pub turntable: bool,\n    pub last_any_device: u8,\n    pub lean_now: Vec2,\n    #[serde(skip)]\n    nav: Option<Arc<crate::nav::NavGrid>>,\n    pub set_now: usize,\n    pub rumble: f32,\n}\n\n/// What the page knows at boot.\n#[derive(Clone, Debug, Default)]\npub struct BootData {\n    pub today: i64,\n    pub about: String,\n    pub save: Option<String>,\n}\n\n/// Hands the page's data to a running game (a no-op for any other).\npub fn boot(sim: &mut Sim, data: BootData) {\n    if let Some(g) = sim.state.play.as_mut().and_then(|p| p.get_mut::<FitGame>()) {\n        g.today = data.today;\n        g.about = data.about;\n        if let Some(s) = data.save {\n            g.save = Save::parse(&s);\n        }\n    }\n}\n\n/// Builds every set on one sim and starts the game. `rest` picks a door for the tools and tests:\n/// `medley`, `event/<name>`, `stand`, `stand/<phase>`, `day/<n>`, `free`, `credits`.\npub fn build(sim: &mut Sim, rest: Option<&str>) -> Result<()> {\n    let rules_text = super::level_text(\"fit/rules\", include_str!(\"rules.toml\"));\n    let rules: Rules = toml::from_str(&rules_text).map_err(|e| anyhow!(\"fit/rules.toml: {e}\"))?;\n    let mut slots = Vec::new();\n    let mut spots = Spots::default();\n    for (i, (key, text)) in SETS.iter().enumerate() {\n        let mut def = RoomDef::parse(&super::level_text(key, text)).map_err(|e| anyhow!(\"{key}: {e}\"))?;\n        let origin = Vec3::new(SET_GAP * i as f32, 0.0, 0.0);\n        def.layout.origin = origin;\n        let mut here = BTreeMap::new();\n        if let Some(toml::Value::Table(t)) = def.game.get(\"spots\") {\n            for (k, v) in t {\n                let p: [f32; 3] = v.clone().try_into().map_err(|e| anyhow!(\"{key} spot {k}: {e}\"))?;\n                here.insert(k.clone(), origin + Vec3::from(p));\n            }\n        }\n        spots.0.push(here);\n        let place = crate::level::Placement::new(def.layout.origin, 0);\n        let (cols, rows) = def.layout.extent();\n        let (min, max) = place.aabb(Vec3::new(0.0, -1.0, 0.0), Vec3::new(cols as f32, def.height.max(2.0), rows as f32));\n        let start = def.local_start();\n        let inward = -def.entrance.facing.dir();\n        slots.push(RoomSlot { id: i as u16, key: (*key).into(), def: Arc::new(def), place, min, max, inside: place.point(start), outside: place.point(start) - inward * 4.0, inward, built: false });\n    }\n    let n = slots.len();\n    sim.state.world = World { enabled: false, rooms: slots, current_room: Some(0), ..Default::default() };\n    for i in 0..n {\n        sim.build_room(i);\n    }\n    let arrive = spots.get(HUB, \"arrive\");\n    sim.state.spawn = arrive;\n    sim.spawn_player();\n    sim.state.focus = arrive;\n    // Rewinding is for the engine's demo; here it would copy the whole save every 20 ticks.\n    sim.history.enabled = false;\n    let seed = sim.state.seed as u32;\n    let mut g = FitGame {\n        base_rules: rules.clone(),\n        rules,\n        save: Save::default(),\n        slot: 0,\n        mode: Mode::Title,\n        mode_t: 0.0,\n        menus: Vec::new(),\n        dialog: None,\n        run: None,\n        check: None,\n        check_core: core::BalanceCore::new(&mut sim.state.rng),\n        check_actors: Vec::new(),\n        report: Report::default(),\n        attract: None,\n        idle: 0,\n        touch_only: false,\n        medley: None,\n        together_n: 2,\n        cam: Cam { rate: 2.5, ..Default::default() },\n        target: Shot::default(),\n        spots,\n        flop_ids: [None; 5],\n        gulls: Vec::new(),\n        tick: 0,\n        today: 0,\n        about: String::new(),\n        outcome: Outcome::Playing,\n        hub: false,\n        hub_go: false,\n        hub_ended: false,\n        seed,\n        dev: Dev::default(),\n        save_serial: 0,\n        save_blob: Arc::new(String::new()),\n        pause_t: 0.0,\n        paused: false,\n        move_dir: Vec2::ZERO,\n        walk_path: Vec::new(),\n        walk_then: None,\n        near: None,\n        msg: None,\n        wave_cool: 0.0,\n        fullscreen: 0,\n        song: 0,\n        direct: false,\n        name_pick: 0,\n        look_skin: 1,\n        look_outfit: 0,\n        ended_well: false,\n        clam_t: 0.0,\n        turntable: false,\n        last_any_device: 0,\n        lean_now: Vec2::ZERO,\n        nav: None,\n        set_now: 0,\n        rumble: 0.0,\n    };\n    g.setup_scenery(sim);\n    let mut ev = Vec::new();\n    g.go_title(sim, &mut ev);\n    match rest {\n        None => {}\n        Some(\"medley\") => {\n            g.hub = true;\n            g.menus.clear();\n            g.begin_medley(sim, vec![Racer { name: \"You\".into(), skin: 1, outfit: 0, ..Default::default() }], seed, &mut ev);\n        }\n        Some(\"stand\") => {\n            g.direct_guest(sim);\n            g.start_finale(sim, 0, &mut ev);\n        }\n        Some(\"free\") => {\n            g.direct_guest(sim);\n            let d = g.guest_mut();\n            d.free_play = true;\n            d.day = 5;\n            d.ages = vec![60, 55, 50, 45, 38];\n            g.enter_island(sim, &mut ev);\n        }\n        Some(\"credits\") => {\n            g.direct_guest(sim);\n            g.set_mode(Mode::Credits);\n            g.menus.clear();\n        }\n        Some(r) => {\n            if let Some(name) = r.strip_prefix(\"event/\") {\n                let kind = EvKind::from_key(name).ok_or_else(|| anyhow!(\"no event '{name}'\"))?;\n                g.direct_guest(sim);\n                g.start_event(sim, kind, RunCtx::Stay, &mut ev);\n                if let Some(run) = &mut g.run {\n                    run.phase = Phase::Play;\n                }\n            } else if let Some(p) = r.strip_prefix(\"stand/\") {\n                let first: u32 = p.parse().map_err(|_| anyhow!(\"stand/<phase>\"))?;\n                g.direct_guest(sim);\n                g.start_finale(sim, first, &mut ev);\n            } else if let Some(d) = r.strip_prefix(\"day/\") {\n                let day: u8 = d.parse().map_err(|_| anyhow!(\"day/<n>\"))?;\n                g.direct_guest(sim);\n                g.guest_mut().day = day;\n                g.guest_mut().ages = vec![55];\n                g.enter_island(sim, &mut ev);\n            } else {\n                return Err(anyhow!(\"fit has no scene '{r}'\"));\n            }\n        }\n    }\n    g.direct = rest.is_some();\n    sim.state.play = Some(GameBox::new(g));\n    Ok(())\n}\n\nimpl FitGame {\n    pub fn guest(&self) -> Option<&Guest> {\n        self.save.guests.get(self.slot).and_then(|g| g.as_ref())\n    }\n\n    /// The current guest. A game in play always has one; the empty one is a safe stand-in.\n    pub fn guest_mut(&mut self) -> &mut Guest {\n        let slot = &mut self.save.guests[self.slot];\n        slot.get_or_insert_with(|| Guest::new(\"Guest\", 1, 0))\n    }\n\n    fn direct_guest(&mut self, sim: &mut Sim) {\n        self.menus.clear();\n        self.slot = 0;\n        self.guest_mut();\n        self.dress(sim);\n    }\n\n    pub fn set_mode(&mut self, m: Mode) {\n        self.mode = m;\n        self.mode_t = 0.0;\n    }\n\n    /// Puts the current guest's look on the player.\n    pub fn dress(&mut self, sim: &mut Sim) {\n        let Some(g) = self.guest() else { return };\n        let def = meta::guest_def(g.skin, g.outfit, &g.wear);\n        self.dress_as(sim, def);\n    }\n\n    pub fn dress_as(&self, sim: &mut Sim, def: crate::puppet::PuppetDef) {\n        if let Some(ch) = sim.state.player.and_then(|p| sim.state.entities.get_mut(p)).and_then(|e| e.character.as_mut()) {\n            ch.puppet = Some(Arc::new(def));\n        }\n    }\n\n    pub fn store(&mut self) {\n        if self.hub {\n            return;\n        }\n        if let Ok(s) = serde_json::to_string(&self.save) {\n            self.save_serial += 1;\n            self.save_blob = Arc::new(s);\n        }\n    }\n\n    pub fn play_song(&mut self, ev: &mut Vec<SimEvent>, song: u8) {\n        if self.song != song {\n            self.song = song;\n            ev.push(SimEvent::Music { song });\n        }\n    }\n\n    pub fn goto_set(&mut self, sim: &mut Sim, set: usize, at: Vec3) {\n        sim.state.world.current_room = Some(set as u16);\n        self.set_now = set;\n        if let Some(pid) = sim.state.player {\n            sim.set_position(pid, at);\n            if let Some(ch) = sim.state.entities.get_mut(pid).and_then(|e| e.character.as_mut()) {\n                ch.anim.tilt_side = 0.0;\n                ch.anim.tilt_fwd = 0.0;\n                ch.anim.tilt_pivot = 0.0;\n                ch.anim.lift = 0.0;\n                ch.anim.stop_clip();\n            }\n        }\n        self.cam.cut += 1;\n        self.cam.iris = true;\n    }\n\n    pub fn go_title(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        self.teardown_run(sim);\n        self.teardown_check(sim);\n        self.dialog = None;\n        self.medley = None;\n        self.attract = None;\n        self.menus.clear();\n        self.menus.push(Menu::new(MenuKind::Title));\n        self.set_mode(Mode::Title);\n        self.idle = 0;\n        let at = self.spots.get(HUB, \"arrive\");\n        self.goto_set(sim, HUB, at);\n        self.dress_as(sim, meta::guest_def(1, 5, &meta::Wear::default()));\n        self.play_song(ev, 1);\n    }\n\n    pub fn teardown_run(&mut self, sim: &mut Sim) {\n        if let Some(run) = self.run.take() {\n            for id in &run.actors {\n                sim.despawn(*id);\n            }\n        }\n        if let Some(a) = sim.state.player.and_then(|p| sim.state.entities.get_mut(p)).and_then(|e| e.character.as_mut()) {\n            a.anim.tilt_side = 0.0;\n            a.anim.tilt_fwd = 0.0;\n            a.anim.tilt_pivot = 0.0;\n            a.anim.stop_clip();\n        }\n    }\n\n    pub fn teardown_check(&mut self, sim: &mut Sim) {\n        self.check = None;\n        for id in self.check_actors.drain(..) {\n            sim.despawn(id);\n        }\n    }\n\n    // ------------------------------------------------------------------ the stay\n\n    /// Morning: on the cabana deck, Pip greets you.\n    pub fn begin_day(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        let wake = self.spots.get(HUB, \"wake\");\n        self.goto_set(sim, HUB, wake);\n        self.dress(sim);\n        self.set_mode(Mode::Island);\n        self.play_song(ev, 1);\n        let pick = sim.state.rng.next_u32();\n        let today = self.today;\n        let g = self.guest_mut();\n        let (day, last) = (g.day, g.last_day);\n        g.last_day = today;\n        g.checked_today = false;\n        let mut d = Dialog::new(After::GotoCheck);\n        if today > 0 && last > 0 && today > last {\n            let away = today - last;\n            d.push(script::PIP, format!(\"You were away for {away} day{}. I did not count them. There were {away}.\", if away == 1 { \"\" } else { \"s\" }));\n            d.push(script::PIP, script::line(\"pip_away\", pick));\n        }\n        d.push(script::PIP, script::line(&format!(\"pip_morning_{day}\"), pick));\n        self.dialog = Some(d);\n        self.store();\n    }\n\n    pub fn start_check(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        let c = self.spots.get(STUDIO, \"center\");\n        self.goto_set(sim, STUDIO, c);\n        self.check_core = core::BalanceCore::new(&mut sim.state.rng);\n        self.check_core.no_tip = true;\n        let pid = sim.state.player.unwrap_or(EntityId(0));\n        let mut shot = self.target;\n        let mut core_ = self.check_core.clone();\n        let mut msg = None;\n        let mut actors = Vec::new();\n        let mut flops = [false; 5];\n        let flop_ids = [None; 5];\n        let rules = self.rules.clone();\n        let spots = self.spots.clone();\n        let mut cx = Cx { sim, ev, r: &rules, dt: 1.0 / 60.0, core: &mut core_, actors: &mut actors, spots: &spots, pid, shot: &mut shot, msg: &mut msg, seed: self.seed, demo: false, slump: 0.0, flops: &mut flops, flop_ids: &flop_ids };\n        let check = Check::new(&mut cx);\n        self.check = Some(Box::new(check));\n        self.check_core = core_;\n        self.target = shot;\n        self.play_song(ev, 2);\n        self.set_mode(Mode::Check);\n    }\n\n    pub fn finish_check(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        let Some(check) = self.check.clone() else { return };\n        let g = self.guest();\n        let (days, stars, prev) = g.map(|g| (g.stamps as u32, g.total_stars(), g.age())).unwrap_or((0, 0, None));\n        let age = meta::balance_age(check.skill(), days, stars);\n        let wobbles = self.check_core.wobbles;\n        {\n            let g = self.guest_mut();\n            g.ages.push(age);\n            g.checked_today = true;\n            g.wobbles += wobbles;\n        }\n        self.report = Report { age, delta: prev.map(|p| age - p), t: 0.0, told: false, last_tick: 0 };\n        self.teardown_check_keep_state();\n        self.set_mode(Mode::Report);\n        ev.push(SimEvent::Sfx { id: sfx::REVEAL, gain: 0.7, pitch: 1.0 });\n        self.store();\n        let _ = sim;\n    }\n\n    fn teardown_check_keep_state(&mut self) {\n        // The check object stays until the verdict has been read: its metrics pick Pip's words.\n    }\n\n    /// Back on the island for the day's free time.\n    pub fn enter_island(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        self.teardown_check(sim);\n        let at = self.spots.get(HUB, \"arrive\");\n        self.goto_set(sim, HUB, at);\n        self.dress(sim);\n        self.set_mode(Mode::Island);\n        self.play_song(ev, 1);\n        self.walk_path.clear();\n        self.walk_then = None;\n        let flops = self.guest().map(|g| g.flops).unwrap_or_default();\n        for (k, id) in self.flop_ids.iter().enumerate() {\n            if flops[k] {\n                if let Some(id) = id {\n                    if let Some(e) = sim.state.entities.get_mut(*id) {\n                        e.pos.y = -9.0;\n                    }\n                }\n            }\n        }\n    }\n\n    /// The day's story beat, once, after the morning check.\n    pub fn day_story(&mut self, pick: u32) {\n        let g = self.guest();\n        let day = g.map(|g| g.day).unwrap_or(1);\n        let mut d = Dialog::new(After::Nothing);\n        for line in script::lines(&format!(\"story_{day}\")) {\n            let (who, text) = script_line(line);\n            d.push(who, text);\n        }\n        if d.lines.is_empty() {\n            d.push(script::PIP, script::line(\"pip_idle\", pick));\n        }\n        self.dialog = Some(d);\n    }\n\n    pub fn day_goal(&self) -> Option<u32> {\n        let g = self.guest()?;\n        if g.free_play || g.day >= 5 {\n            return None;\n        }\n        GOALS.get(g.day as usize - 1).copied()\n    }\n\n    pub fn goal_met(&self) -> bool {\n        match (self.day_goal(), self.guest()) {\n            (Some(goal), Some(g)) => g.minutes >= goal,\n            _ => false,\n        }\n    }\n\n    /// A big stamp lands; tomorrow comes.\n    pub fn end_day(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        let _ = sim;\n        let g = self.guest_mut();\n        g.stamps = (g.stamps + 1).min(5);\n        self.set_mode(Mode::Stamp);\n        ev.push(SimEvent::Sfx { id: sfx::STAMP, gain: 1.0, pitch: 1.0 });\n        self.store();\n    }\n\n    pub fn next_day(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        let g = self.guest_mut();\n        g.day = (g.day + 1).min(5);\n        g.minutes = 0;\n        g.done_today.clear();\n        g.goal_told = false;\n        self.begin_day(sim, ev);\n    }\n\n    pub fn event_open(&self, kind: EvKind) -> bool {\n        self.guest().is_some_and(|g| g.free_play || kind.day() <= g.day)\n    }\n\n    pub fn stand_open(&self) -> bool {\n        self.guest().is_some_and(|g| g.free_play || g.day >= 5)\n    }\n\n    // ------------------------------------------------------------------ events\n\n    pub fn start_event(&mut self, sim: &mut Sim, kind: EvKind, ctx: RunCtx, ev: &mut Vec<SimEvent>) {\n        self.start_body(sim, Some(kind), 0, ctx, ev);\n    }\n\n    pub fn start_finale(&mut self, sim: &mut Sim, first: u32, ev: &mut Vec<SimEvent>) {\n        self.start_body(sim, None, first, RunCtx::Finale, ev);\n    }\n\n    fn start_body(&mut self, sim: &mut Sim, kind: Option<EvKind>, first: u32, ctx: RunCtx, ev: &mut Vec<SimEvent>) {\n        self.teardown_run(sim);\n        self.teardown_check(sim);\n        self.menus.clear();\n        self.dialog = None;\n        let demo = ctx == RunCtx::Attract;\n        let set = kind.map(|k| k.set()).unwrap_or(BAY);\n        let at = self.spots.get(set, match set {\n            HUB => \"arrive\",\n            CHANNEL | PIER => \"start\",\n            TOWER => \"board\",\n            BAY => \"post\",\n            _ => \"center\",\n        });\n        self.goto_set(sim, set, at);\n        let mut core_ = core::BalanceCore::new(&mut sim.state.rng);\n        core_.no_tip = demo || self.dev.no_tips;\n        let pid = sim.state.player.unwrap_or(EntityId(0));\n        let mut shot = Shot::default();\n        let mut msg = None;\n        let mut actors = Vec::new();\n        let seed = self.medley.as_ref().map(|m| m.seed).unwrap_or(self.seed.wrapping_add(self.tick as u32));\n        let slump = self.slump();\n        let rules = self.rules.clone();\n        let spots = self.spots.clone();\n        let mut flops = self.guest().map(|g| g.flops).unwrap_or_default();\n        let flop_ids = self.flop_ids;\n        let mut cx = Cx { sim, ev, r: &rules, dt: 1.0 / 60.0, core: &mut core_, actors: &mut actors, spots: &spots, pid, shot: &mut shot, msg: &mut msg, seed, demo, slump, flops: &mut flops, flop_ids: &flop_ids };\n        let body = match kind {\n            Some(k) => Body::Ev(Ev::start(k, &mut cx, Opt::default())),\n            None => Body::Stand(Box::new(finale::Finale::start(&mut cx, first))),\n        };\n        let song = match kind {\n            Some(EvKind::Breath | EvKind::Pose) => 2,\n            Some(EvKind::Squats | EvKind::Plank) => 3,\n            Some(EvKind::Step | EvKind::Spin) => 4,\n            Some(_) => 5,\n            None => 6,\n        };\n        if kind != Some(EvKind::Step) {\n            self.song = song;\n            ev.push(SimEvent::Music { song });\n        }\n        let ghosts = self.ghosts_for(kind, ctx);\n        // The first frame shows the stage even before the first tick.\n        self.target = shot;\n        self.cam.shot = shot;\n        let phase = if demo || (self.hub && self.hub_go) { Phase::Play } else if ctx == RunCtx::Medley { Phase::Count } else { Phase::Card };\n        self.run = Some(Box::new(Run {\n            kind,\n            phase,\n            t: 0.0,\n            core: core_,\n            body,\n            actors,\n            shot,\n            msg,\n            rec: Vec::new(),\n            rec_in: 0.0,\n            ghosts,\n            ctx,\n            score: 0,\n            result: None,\n            coach_in: 6.0,\n            demo,\n            trace: Vec::new(),\n        }));\n        self.set_mode(Mode::Run);\n    }\n\n    pub fn slump(&self) -> f32 {\n        // Your figure's posture improves as the age falls: visible progress, no numbers needed.\n        let age = self.guest().and_then(|g| g.age()).unwrap_or(40) as f32;\n        ((age - 25.0) / 60.0).clamp(0.0, 1.0) * 0.14\n    }\n\n    fn ghosts_for(&self, kind: Option<EvKind>, ctx: RunCtx) -> Vec<RunGhost> {\n        if !self.dev.ghosts {\n            return Vec::new();\n        }\n        let Some(kind) = kind else { return Vec::new() };\n        match ctx {\n            RunCtx::Stay => {\n                let Some(g) = self.guest() else { return Vec::new() };\n                if g.day < 3 && !g.free_play {\n                    return Vec::new();\n                }\n                match g.ghosts.get(kind.key()) {\n                    Some(s) if !s.is_empty() => vec![RunGhost { samples: s.clone(), skin: g.skin, outfit: g.outfit, seat: 0, name: \"Yesterday You\".into() }],\n                    _ => Vec::new(),\n                }\n            }\n            RunCtx::Medley => {\n                let Some(m) = &self.medley else { return Vec::new() };\n                m.racers\n                    .iter()\n                    .enumerate()\n                    .filter(|(i, _)| *i < m.who)\n                    .filter_map(|(i, r)| {\n                        let s = r.ghosts.get(m.leg)?;\n                        Some(RunGhost { samples: s.clone(), skin: r.skin, outfit: r.outfit, seat: i as u8, name: r.name.clone() })\n                    })\n                    .collect()\n            }\n            _ => Vec::new(),\n        }\n    }\n\n    /// The input a run gets: a player's, the bot's, or nothing.\n    fn run_tick(&mut self, sim: &mut Sim, input: &InputFrame, dt: f32, ev: &mut Vec<SimEvent>) {\n        let Some(mut run) = self.run.take() else { return };\n        let pid = sim.state.player.unwrap_or(EntityId(0));\n        run.t += dt;\n        let rules = self.rules.clone();\n        let spots = self.spots.clone();\n        let mut msg = run.msg.take();\n        if let Some((_, left)) = &mut msg {\n            *left -= dt;\n        }\n        msg = msg.filter(|m| m.1 > 0.0);\n        match run.phase {\n            Phase::Card => {\n                if input.just(btn::CONFIRM) {\n                    run.phase = Phase::Count;\n                    run.t = 0.0;\n                    ev.push(SimEvent::Sfx { id: sfx::CONFIRM, gain: 0.8, pitch: 1.0 });\n                } else if input.just(btn::BACK) {\n                    ev.push(SimEvent::Sfx { id: sfx::BACK, gain: 0.8, pitch: 1.0 });\n                    self.run = Some(run);\n                    self.leave_run(sim, ev);\n                    return;\n                }\n            }\n            Phase::Count => {\n                if !self.hub || self.hub_go {\n                    let before = (run.t - dt).ceil() as i32;\n                    let now = run.t.ceil() as i32;\n                    if before != now && now <= 3 {\n                        ev.push(SimEvent::Sfx { id: sfx::COUNT, gain: 0.8, pitch: 1.0 });\n                    }\n                    if run.t >= 3.0 {\n                        run.phase = Phase::Play;\n                        run.t = 0.0;\n                        ev.push(SimEvent::Sfx { id: sfx::GO, gain: 0.9, pitch: 1.0 });\n                    }\n                } else {\n                    run.t = 0.0;\n                }\n            }\n            Phase::Play => {\n                let mut i = intent_of(input, self.save.settings.lean_sensitivity);\n                if run.demo || self.dev.autoplay {\n                    i = run.bot(&rules);\n                }\n                i.song_pos = input.song_pos;\n                run.core.no_tip = run.demo || self.dev.no_tips;\n                let scale = 1.0 - self.save.settings.wobble_assist * 0.8;\n                let mut r2 = rules.core.clone();\n                r2.wobble *= scale;\n                r2.kick *= scale;\n                let lean = i.lean;\n                let tipped = run.core.tick(lean, &r2, &mut sim.state.rng, dt);\n                let seed = self.medley.as_ref().map(|m| m.seed).unwrap_or(self.seed);\n                let slump = self.slump();\n                let any = input.any;\n                let mut flops = self.guest().map(|g| g.flops).unwrap_or_default();\n                let flop_ids = self.flop_ids;\n                let mut shot = run.shot;\n                let mut core_ = std::mem::take(&mut run.core);\n                let mut actors = std::mem::take(&mut run.actors);\n                let done = {\n                    let mut cx = Cx { sim, ev, r: &rules, dt, core: &mut core_, actors: &mut actors, spots: &spots, pid, shot: &mut shot, msg: &mut msg, seed, demo: run.demo, slump, flops: &mut flops, flop_ids: &flop_ids };\n                    if tipped {\n                        run.on_tip(&mut cx);\n                    }\n                    run.tick_body(&mut cx, &i, any)\n                };\n                run.core = core_;\n                run.actors = actors;\n                run.shot = shot;\n                if self.guest().is_some_and(|g| g.flops != flops) {\n                    self.guest_mut().flops = flops;\n                }\n                self.lean_now = lean;\n                // The coach chimes in now and then.\n                run.coach_in -= dt;\n                if run.coach_in <= 0.0 && msg.is_none() {\n                    run.coach_in = sim.state.rng.range(7.0, 12.0);\n                    if let Some(k) = run.kind {\n                        let key = format!(\"coach_{}\", k.pavilion());\n                        let n = sim.state.rng.next_u32();\n                        msg = Some((script::line(&key, n), 3.5));\n                    }\n                }\n                // Record for ghosts and for the hub.\n                run.rec_in -= dt;\n                if run.rec_in <= 0.0 && !run.demo {\n                    run.rec_in = 1.0 / ghost::RATE;\n                    if let Some(s) = sample_of(sim, run.t, run.live_score(&rules) as f32) {\n                        run.rec.push(s);\n                    }\n                }\n                if self.dev.trace {\n                    run.trace.push(run.core.cob.into());\n                    if run.trace.len() > 90 {\n                        run.trace.remove(0);\n                    }\n                }\n                if done {\n                    run.msg = msg;\n                    self.run = Some(run);\n                    self.finish_run(sim, ev);\n                    return;\n                }\n            }\n            Phase::Result => {}\n        }\n        run.msg = msg;\n        self.target = run.shot;\n        // Dev cheats from the menu.\n        self.run = Some(run);\n    }\n\n    /// Scores it, banks it, shows the result (or moves on, for a medley or the demo).\n    pub fn finish_run(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        let Some(run) = self.run.as_mut() else { return };\n        let score = run.live_score(&self.rules);\n        run.score = score;\n        let kind = run.kind;\n        let ctx = run.ctx;\n        let rec = std::mem::take(&mut run.rec);\n        match ctx {\n            RunCtx::Attract => self.attract_next(sim, ev),\n            RunCtx::Medley => {\n                if let Some(m) = &mut self.medley {\n                    if let Some(r) = m.racers.get_mut(m.who) {\n                        r.scores.push(score);\n                        r.ghosts.push(rec);\n                    }\n                }\n                self.medley_next(sim, ev);\n            }\n            RunCtx::Stay | RunCtx::Finale => {\n                let stars = meta::stars_for(score);\n                let key = kind.map(|k| k.key()).unwrap_or(\"stand\").to_string();\n                let free = self.guest().is_some_and(|g| g.free_play);\n                let g = self.guest_mut();\n                let first = g.done_today.insert(key.clone());\n                let mut minutes = if first { 1 + stars as u32 } else { 1 };\n                if ctx == RunCtx::Finale {\n                    minutes = 0;\n                }\n                g.minutes += minutes;\n                g.total_minutes += minutes;\n                let best = g.bests.entry(key.clone()).or_default();\n                let old_best = best.score;\n                let new_best = score > best.score;\n                let had_best = old_best > 0;\n                if new_best {\n                    best.score = score;\n                    best.stars = stars;\n                    g.ghosts.insert(key, rec);\n                }\n                let best_now = best.score;\n                let yesterday = if had_best && (g.day >= 3 || free) { Some(score as i32 - old_best as i32) } else { None };\n                let pick = sim.state.rng.next_u32();\n                let comment_key = match stars {\n                    3 => \"pip_result_3\",\n                    2 => \"pip_result_2\",\n                    1 => \"pip_result_1\",\n                    _ => \"pip_result_0\",\n                };\n                let result = ResultData { score, stars, title: script::title(score), minutes, best: best_now, new_best, yesterday, comment: script::line(comment_key, pick) };\n                if let Some(run) = self.run.as_mut() {\n                    run.phase = Phase::Result;\n                    run.t = 0.0;\n                    run.result = Some(result);\n                }\n                ev.push(SimEvent::Sfx { id: sfx::FANFARE, gain: 0.8, pitch: if stars >= 2 { 1.0 } else { 0.8 } });\n                for k in 0..stars {\n                    ev.push(SimEvent::Sfx { id: sfx::STAR, gain: 0.7, pitch: penta(k as u32 * 2 + 2) });\n                }\n                if stars == 3 {\n                    let at = sim.feet(sim.state.player.unwrap_or(EntityId(0))).unwrap_or_default();\n                    ev.push(SimEvent::Burst { pos: at + Vec3::Y * 3.0, kind: 0, count: 60 });\n                }\n                self.menus.clear();\n                self.menus.push(Menu::new(MenuKind::Result));\n                self.store();\n                if !self.goal_told() && self.goal_met() {\n                    self.guest_mut().goal_told = true;\n                    let pick = sim.state.rng.next_u32();\n                    let mut d = Dialog::new(After::Nothing);\n                    d.push(script::PIP, script::line(\"pip_goal_met\", pick));\n                    self.msg = None;\n                    self.pending_goal_line(d);\n                }\n            }\n        }\n    }\n\n    fn goal_told(&self) -> bool {\n        self.guest().is_some_and(|g| g.goal_told)\n    }\n\n    fn pending_goal_line(&mut self, d: Dialog) {\n        // Said when the result is dismissed, back on the island.\n        self.pending = Some(d);\n    }\n\n    /// Leaves a finished or abandoned run.\n    pub fn leave_run(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        let ctx = self.run.as_ref().map(|r| r.ctx);\n        let score = self.run.as_ref().map(|r| r.score).unwrap_or(0);\n        let finished = self.run.as_ref().is_some_and(|r| r.phase == Phase::Result);\n        self.menus.clear();\n        self.teardown_run(sim);\n        if self.direct && ctx != Some(RunCtx::Finale) && !self.hub && self.guest().is_some_and(|g| g.ages.is_empty()) {\n            // A door for the tools: there is no stay to go back to.\n            self.go_title(sim, ev);\n            return;\n        }\n        if ctx == Some(RunCtx::Finale) && finished {\n            self.after_finale(sim, score, ev);\n            return;\n        }\n        self.enter_island(sim, ev);\n        if let Some(d) = self.pending.take() {\n            self.dialog = Some(d);\n        }\n    }\n\n    fn after_finale(&mut self, sim: &mut Sim, score: u32, ev: &mut Vec<SimEvent>) {\n        let morning = self.guest().and_then(|g| g.age()).unwrap_or(60);\n        let final_age = (morning - (score as i32) / 100).clamp(18, 99);\n        let free = self.guest().is_some_and(|g| g.free_play);\n        let g = self.guest_mut();\n        g.best_final = g.best_final.max(score);\n        if !free {\n            g.ages.push(final_age);\n            g.stamps = (g.stamps + 1).min(5);\n        }\n        self.store();\n        self.enter_island(sim, ev);\n        if free {\n            let mut d = Dialog::new(After::Nothing);\n            d.push(script::PIP, format!(\"Your Big Stand scored {score}. It would have taken {} years off. Had you still been counting.\", score / 100));\n            self.dialog = Some(d);\n            return;\n        }\n        let pick = sim.state.rng.next_u32();\n        self.ended_well = final_age <= meta::CHECKOUT_AGE;\n        let mut d = Dialog::new(After::Ending);\n        d.push(script::PIP, format!(\"Your final Balance Age is {final_age}. The rule is 40 or better.\"));\n        for line in script::lines(if self.ended_well { \"ending_good\" } else { \"ending_stay\" }) {\n            let (who, text) = script_line(line);\n            d.push(who, text);\n        }\n        d.push(script::PIP, script::line(\"pip_idle\", pick));\n        self.dialog = Some(d);\n    }\n\n    pub fn after_dialog(&mut self, sim: &mut Sim, after: After, ev: &mut Vec<SimEvent>) {\n        match after {\n            After::Nothing => {}\n            After::StartCheck | After::GotoCheck => self.start_check(sim, ev),\n            After::IslandDay => {\n                self.enter_island(sim, ev);\n                let n = sim.state.rng.next_u32();\n                self.day_story(n);\n            }\n            After::EndDay => self.end_day(sim, ev),\n            After::FinaleCheck => self.start_finale(sim, 0, ev),\n            After::Ending => {\n                self.set_mode(Mode::Ending);\n                self.play_song(ev, 1);\n                if self.ended_well {\n                    let at = self.spots.get(HUB, \"mat_bigstand\") + Vec3::new(0.0, 0.0, 14.0);\n                    let boat = events::spawn_prop(sim, \"rowboat\", at - Vec3::Y * 0.1, std::f32::consts::PI, 1.4, \"#46bec8\");\n                    self.check_actors.push(boat);\n                }\n            }\n            After::Credits => self.set_mode(Mode::Credits),\n        }\n    }\n\n    pub fn to_free_play(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        self.teardown_check(sim);\n        let well = self.ended_well;\n        let g = self.guest_mut();\n        g.free_play = true;\n        g.checked_out = well;\n        self.outcome = if well { Outcome::Won } else { Outcome::Lost };\n        self.store();\n        self.enter_island(sim, ev);\n        let mut d = Dialog::new(After::Nothing);\n        for line in script::lines(\"free_play\") {\n            let (who, text) = script_line(line);\n            d.push(who, text);\n        }\n        self.dialog = Some(d);\n    }\n\n    // ------------------------------------------------------------------ medley\n\n    pub fn begin_medley(&mut self, sim: &mut Sim, racers: Vec<Racer>, seed: u32, ev: &mut Vec<SimEvent>) {\n        self.medley = Some(Medley { racers, who: 0, leg: 0, seed, rest: 0.0 });\n        self.medley_leg(sim, ev);\n    }\n\n    fn medley_leg(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        let Some(m) = &self.medley else { return };\n        let (leg, r) = (m.leg, m.racers.get(m.who).cloned().unwrap_or_default());\n        self.dress_as(sim, meta::guest_def(r.skin, r.outfit, &meta::Wear::default()));\n        self.start_event(sim, MEDLEY[leg % 3], RunCtx::Medley, ev);\n    }\n\n    fn medley_next(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        let hub = self.hub;\n        let Some(m) = &mut self.medley else { return };\n        m.leg += 1;\n        if m.leg < MEDLEY.len() {\n            self.medley_leg(sim, ev);\n            return;\n        }\n        m.leg = 0;\n        m.who += 1;\n        if hub {\n            self.teardown_run(sim);\n            self.set_mode(Mode::HubDone);\n            return;\n        }\n        let done = m.who >= m.racers.len();\n        self.teardown_run(sim);\n        if done {\n            self.menus.clear();\n            self.menus.push(Menu::new(MenuKind::Podium));\n            self.set_mode(Mode::Podium);\n            ev.push(SimEvent::Sfx { id: sfx::FANFARE, gain: 0.9, pitch: 1.0 });\n        } else {\n            self.set_mode(Mode::PassPad);\n        }\n    }\n\n    pub fn medley_total(&self) -> u32 {\n        let live = self.run.as_ref().filter(|r| r.ctx == RunCtx::Medley).map(|r| r.live_score(&self.rules)).unwrap_or(0);\n        let done: u32 = self.medley.as_ref().and_then(|m| m.racers.get(m.who.min(m.racers.len().saturating_sub(1)))).map(|r| r.scores.iter().sum()).unwrap_or(0);\n        done + live\n    }\n\n    // ------------------------------------------------------------------ attract\n\n    pub fn attract_start(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        self.menus.clear();\n        self.attract = Some(Attract { idx: 0, t: 0.0 });\n        let _ = (sim, ev);\n    }\n\n    pub fn attract_exit(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        self.attract = None;\n        self.go_title(sim, ev);\n    }\n\n    /// The next segment: sweep, ten events, the title card, and round again.\n    pub fn attract_next(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        self.teardown_run(sim);\n        let Some(a) = &mut self.attract else { return };\n        a.idx += 1;\n        a.t = 0.0;\n        let idx = a.idx;\n        if idx > ATTRACT.len() + 1 {\n            a.idx = 0;\n            let at = self.spots.get(HUB, \"arrive\");\n            self.goto_set(sim, HUB, at);\n            self.set_mode(Mode::Title);\n            return;\n        }\n        if idx == ATTRACT.len() + 1 {\n            let at = self.spots.get(HUB, \"arrive\");\n            self.goto_set(sim, HUB, at);\n            self.set_mode(Mode::Title);\n            return;\n        }\n        match ATTRACT[idx - 1] {\n            Some(k) => {\n                self.dress_as(sim, meta::guest_def(idx as u8, idx as u8, &meta::Wear::default()));\n                self.start_event(sim, k, RunCtx::Attract, ev);\n            }\n            None => self.start_body(sim, None, 3, RunCtx::Attract, ev),\n        }\n    }\n\n    fn attract_tick(&mut self, sim: &mut Sim, dt: f32, ev: &mut Vec<SimEvent>) {\n        let Some(a) = &mut self.attract else { return };\n        a.t += dt;\n        let (idx, t) = (a.idx, a.t);\n        let limit = if idx == 0 {\n            8.0\n        } else if idx == ATTRACT.len() + 1 {\n            5.0\n        } else {\n            15.0\n        };\n        if t >= limit {\n            self.attract_next(sim, ev);\n            return;\n        }\n        if self.run.is_some() {\n            self.run_tick(sim, &InputFrame::default(), dt, ev);\n        }\n    }\n\n    // ------------------------------------------------------------------ camera, scenery\n\n    fn update_cam(&mut self, sim: &Sim, input: &InputFrame, dt: f32) {\n        let hub_c = self.spots.get(HUB, \"arrive\");\n        let pos = sim.state.player.and_then(|p| sim.feet(p)).unwrap_or(hub_c);\n        let t = self.mode_t + self.tick as f32 * 0.0;\n        let shot = match self.mode {\n            _ if self.run.is_some() => self.run.as_ref().map(|r| r.shot).unwrap_or_default(),\n            Mode::Check | Mode::Report => self.target,\n            Mode::Title | Mode::Setup => {\n                if self.menus.last().is_some_and(|m| matches!(m.kind, MenuKind::Look)) {\n                    Shot { tilt: 8.0, yaw: 0.0, distance: 4.5, fov: 34.0, height: 1.0, focus: pos }\n                } else {\n                    Shot { tilt: 22.0 + (t * 0.05).sin() * 8.0, yaw: (self.tick as f32 / 60.0 * 4.0) % 360.0 - 180.0, distance: 46.0, fov: 40.0, height: 2.0, focus: hub_c }\n                }\n            }\n            Mode::Ending | Mode::Credits => {\n                let at = self.spots.get(HUB, \"mat_bigstand\");\n                Shot { tilt: 16.0, yaw: 10.0 + t * 1.5, distance: 26.0, fov: 40.0, height: 1.0, focus: at + Vec3::new(0.0, 0.0, 8.0) }\n            }\n            Mode::Stamp | Mode::PassPad | Mode::Podium | Mode::HubDone => Shot { tilt: 24.0, yaw: (self.tick as f32 / 60.0 * 3.0) % 360.0 - 180.0, distance: 30.0, fov: 40.0, height: 2.0, focus: hub_c },\n            Mode::Island => {\n                let wardrobe = self.menus.last().is_some_and(|m| matches!(m.kind, MenuKind::Wardrobe));\n                if wardrobe {\n                    Shot { tilt: 8.0, yaw: 0.0, distance: 4.5, fov: 34.0, height: 1.0, focus: pos }\n                } else {\n                    Shot { tilt: 38.0, yaw: 0.0, distance: 15.0, fov: 40.0, height: 0.9, focus: pos }\n                }\n            }\n        };\n        self.target = shot;\n        let c = &mut self.cam;\n        let free = self.dev.free_cam;\n        if self.mode == Mode::Island || free {\n            c.look_yaw = (c.look_yaw + input.look.x + 540.0).rem_euclid(360.0) - 180.0;\n            c.look_tilt = (c.look_tilt + input.look.y).clamp(-30.0, 40.0);\n            c.look_zoom = (c.look_zoom + input.look.z).clamp(-0.6, 1.5);\n        }\n        // Chase cameras and focus follow at once; other shots ease over.\n        let k = 1.0 - (-c.rate * dt).exp();\n        let s = &mut c.shot;\n        let snap = self.run.as_ref().is_some_and(|r| matches!(r.kind, Some(EvKind::Lap | EvKind::Paddle | EvKind::Tray | EvKind::Cannon)));\n        let lerp = |a: f32, b: f32| a + (b - a) * k;\n        s.tilt = lerp(s.tilt, shot.tilt);\n        let dy = (shot.yaw - s.yaw + 540.0).rem_euclid(360.0) - 180.0;\n        s.yaw = if snap || matches!(self.mode, Mode::Title | Mode::Stamp | Mode::PassPad | Mode::Podium | Mode::HubDone) { shot.yaw } else { s.yaw + dy * k };\n        s.distance = lerp(s.distance, shot.distance);\n        s.fov = lerp(s.fov, shot.fov);\n        s.height = lerp(s.height, shot.height);\n        s.focus = if snap { shot.focus } else { s.focus.lerp(shot.focus, (k * 3.0).min(1.0)) };\n    }\n\n    fn setup_scenery(&mut self, sim: &mut Sim) {\n        for k in 0..5 {\n            let at = self.spots.get(HUB, &format!(\"flop{k}\"));\n            self.flop_ids[k] = Some(events::spawn_prop(sim, \"fit_flipflop\", at + Vec3::Y * 0.03, k as f32 * 1.1, 1.2, \"#ffd166\"));\n        }\n        // Circling gulls over the sets, and the Commodore at his post.\n        let mut gulls = Vec::new();\n        for set in [HUB, STUDIO, BOARDWALK, TIDE, CHANNEL, PIER, TOWER, BAY] {\n            let n = if set == HUB { 5 } else { 2 };\n            let c = self.spots.0[set].values().next().copied().unwrap_or_default();\n            for k in 0..n {\n                let body = events::spawn_prop(sim, \"fit_gull\", c, 0.0, 1.0, \"#ffffff\");\n                let left = events::spawn_prop(sim, \"fit_wing\", c, 0.0, 1.0, \"#ffffff\");\n                let right = events::spawn_prop(sim, \"fit_wing\", c, 0.0, 1.0, \"#ffffff\");\n                gulls.push(Gull { body, left, right, center: c + Vec3::new(k as f32 * 3.0 - 3.0, 8.0 + k as f32 * 1.4, k as f32 * 2.0 - 6.0), radius: 10.0 + k as f32 * 4.0, speed: 0.35 + k as f32 * 0.06, phase: k as f32 * 2.1, cap: None });\n            }\n        }\n        let at = self.spots.get(HUB, \"gull\");\n        let body = events::spawn_prop(sim, \"fit_gull\", at, 0.0, 1.3, \"#ffffff\");\n        let left = events::spawn_prop(sim, \"fit_wing\", at, 0.0, 1.2, \"#ffffff\");\n        let right = events::spawn_prop(sim, \"fit_wing\", at, 0.0, 1.2, \"#ffffff\");\n        let cap = events::spawn_prop(sim, \"fit_cap\", at, 0.0, 1.3, \"#ffffff\");\n        gulls.push(Gull { body, left, right, center: at + Vec3::Y * 0.42, radius: 0.0, speed: 0.0, phase: 0.0, cap: Some(cap) });\n        self.gulls = gulls;\n    }\n\n    fn fly_gulls(&self, sim: &mut Sim) {\n        use glam::Quat;\n        let t = self.tick as f32 / 60.0;\n        for g in &self.gulls {\n            let a = t * g.speed + g.phase;\n            let (pos, yaw) = if g.radius > 0.0 {\n                (g.center + Vec3::new(a.cos() * g.radius, (a * 2.0).sin() * 0.6, a.sin() * g.radius), -a)\n            } else {\n                (g.center, 0.0)\n            };\n            let flap = if g.radius > 0.0 { (t * 7.0 + g.phase).sin() * 0.5 } else { -1.2 + (t * 3.0).sin().abs() * 0.1 };\n            let rot = Quat::from_rotation_y(yaw);\n            let set = |sim: &mut Sim, id: EntityId, p: Vec3, r: Quat| {\n                if let Some(e) = sim.state.entities.get_mut(id) {\n                    e.pos = p;\n                    e.rot = r;\n                }\n            };\n            set(sim, g.body, pos, rot);\n            set(sim, g.left, pos + rot * Vec3::new(0.1, 0.05, 0.0), rot * Quat::from_rotation_z(flap));\n            set(sim, g.right, pos + rot * Vec3::new(-0.1, 0.05, 0.0), rot * Quat::from_rotation_y(std::f32::consts::PI) * Quat::from_rotation_z(flap));\n            if let Some(c) = g.cap {\n                set(sim, c, pos + Vec3::new(0.0, 0.26, 0.3), rot);\n            }\n        }\n    }\n\n    pub fn status_json(&self, sim: &Sim) -> serde_json::Value {\n        let score = self.medley_total();\n        let leg = self.medley.as_ref().map(|m| m.leg).unwrap_or(0);\n        let label = self.run.as_ref().and_then(|r| r.kind).map(|k| k.name()).unwrap_or(if self.mode == Mode::HubDone { \"Finished\" } else { \"Warming up\" });\n        let done = self.mode == Mode::HubDone;\n        let area = if self.run.is_some() { leg as i32 } else { -1 };\n        let s = sim.state.player.and_then(|p| sim.state.entities.get(p)).and_then(|e| {\n            let c = e.character.as_ref()?;\n            Some(json!({\"p\": sim.feet(e.id).map(|f| [round(f.x), round(f.y), round(f.z)]), \"f\": round(c.anim.facing), \"ts\": round(c.anim.tilt_side), \"tf\": round(c.anim.tilt_fwd), \"c\": c.anim.clip, \"ct\": round(c.anim.clip_t)}))\n        });\n        let mut ghost = s.unwrap_or(json!({}));\n        ghost[\"area\"] = json!(area);\n        ghost[\"s\"] = json!(score);\n        let stats = self.medley.as_ref().and_then(|m| m.racers.first()).map(|r| r.scores.clone()).unwrap_or_default();\n        let screen = menus::screen_name(self);\n        json!({\n            \"screen\": screen,\n            \"mode\": format!(\"{:?}\", self.mode),\n            \"tick\": sim.state.tick,\n            \"attract\": self.attract.as_ref().map(|a| a.idx),\n            \"focus\": self.menus.last().map(|m| m.focus),\n            \"day\": self.guest().map(|g| g.day),\n            \"age\": self.guest().and_then(|g| g.age()),\n            \"minutes\": self.guest().map(|g| g.minutes),\n            \"stamps\": self.guest().map(|g| g.stamps),\n            \"dialog\": self.dialog.is_some(),\n            \"phase\": self.run.as_ref().map(|r| format!(\"{:?}\", r.phase)),\n            \"event\": self.run.as_ref().map(|r| r.name()),\n            \"touch_only\": self.touch_only,\n            \"music\": self.save.settings.music,\n            \"xbox\": self.save.settings.xbox,\n            \"hub\": { \"score\": score, \"label\": label, \"done\": done, \"stats\": { \"paddle\": stats.first(), \"tide\": stats.get(1), \"cannonball\": stats.get(2) }, \"ghost\": ghost },\n        })\n    }\n}\n\nfn round(x: f32) -> f64 {\n    (x as f64 * 100.0).round() / 100.0\n}\n\n/// A script line of the form \"Speaker: text\" (no speaker: Pip).\npub fn script_line(line: &str) -> (u8, String) {\n    if let Some((who, text)) = line.split_once(\": \") {\n        if let Some(i) = script::SPEAKERS.iter().position(|s| *s == who) {\n            return (i as u8, text.to_string());\n        }\n    }\n    (script::PIP, line.to_string())\n}\n\npub fn intent_of(input: &InputFrame, sensitivity: f32) -> Intent {\n    Intent {\n        lean: (input.lean * sensitivity).clamp_length_max(1.0),\n        keys: input.lean_keys,\n        act: input.down(btn::CONFIRM),\n        act_p: input.just(btn::CONFIRM),\n        l: input.down(btn::STEP_L),\n        l_p: input.just(btn::STEP_L),\n        r: input.down(btn::STEP_R),\n        r_p: input.just(btn::STEP_R),\n        song_pos: input.song_pos,\n    }\n}\n\nfn sample_of(sim: &Sim, t: f32, score: f32) -> Option<ghost::Sample> {\n    let pid = sim.state.player?;\n    let e = sim.state.entities.get(pid)?;\n    let c = e.character.as_ref()?;\n    let f = sim.feet(pid)?;\n    Some(ghost::Sample { t, p: f.to_array(), f: c.anim.facing, ts: c.anim.tilt_side, tf: c.anim.tilt_fwd, c: if c.anim.clip_w > 0.5 { c.anim.clip } else { 0 }, ct: c.anim.clip_t, s: score })\n}\n\nimpl Game for FitGame {\n    const KEY: &'static str = \"fit\";\n\n    fn pre(&mut self, sim: &mut Sim, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) -> BTreeMap<EntityId, InputFrame> {\n        self.tick += 1;\n        let dt = if dt <= 0.0 { 1.0 / 60.0 } else { dt };\n        let mut out = BTreeMap::new();\n        self.touch_only = input.down(btn::TOUCH_ONLY);\n        if input.down(btn::HUB_GO) {\n            self.hub_go = true;\n        }\n        self.mode_t += dt;\n        self.move_dir = Vec2::ZERO;\n        if self.attract.is_some() {\n            if input.any && !self.touch_only {\n                self.attract_exit(sim, events);\n                self.idle = 0;\n            } else if self.touch_only && input.ui.is_some() {\n                // A tap on the Settings button.\n                self.attract_exit(sim, events);\n                self.menus.push(Menu::new(MenuKind::Settings));\n            } else {\n                self.attract_tick(sim, dt, events);\n            }\n        } else {\n            // Pre-game: title and setup menus count idle ticks.\n            let pregame = matches!(self.mode, Mode::Title | Mode::Setup);\n            if pregame && !input.any {\n                self.idle += 1;\n                if self.idle >= ATTRACT_AFTER || (self.touch_only && self.menus.iter().all(|m| matches!(m.kind, MenuKind::Title))) {\n                    self.idle = 0;\n                    self.attract_start(sim, events);\n                }\n            } else {\n                self.idle = 0;\n            }\n            let neutral = InputFrame::default();\n            let mut stream = *input;\n            if !self.menus.is_empty() {\n                self.menu_input(sim, input, events);\n                stream = neutral;\n            } else if input.just(btn::PAUSE) && self.can_pause() {\n                self.open_pause(events);\n                stream = neutral;\n            } else if self.dialog.is_some() {\n                let conf = input.just(btn::CONFIRM) || input.just(btn::PRIMARY);\n                let speed = self.save.settings.text_speed;\n                let skip = self.dev.skip_dialog;\n                let finished = match &mut self.dialog {\n                    Some(d) => {\n                        if skip {\n                            d.lines.clear();\n                            true\n                        } else {\n                            d.tick(conf, speed, dt, events)\n                        }\n                    }\n                    None => false,\n                };\n                if finished {\n                    let after = self.dialog.take().map(|d| d.after).unwrap_or_default();\n                    self.after_dialog(sim, after, events);\n                }\n                stream = neutral;\n            }\n            self.paused = self.menus.iter().any(|m| m.kind == MenuKind::Pause) && !self.hub;\n            if self.paused {\n                self.pause_t += dt;\n            } else if !self.dev_frozen() {\n                self.mode_tick(sim, &stream, dt, events);\n            }\n        }\n        if !self.frozen() {\n            self.fly_gulls(sim);\n        }\n        self.dev.step = false;\n        self.update_cam(sim, input, dt);\n        if let Some(pid) = sim.state.player {\n            out.insert(pid, InputFrame { move_dir: self.move_dir, ..Default::default() });\n        }\n        out\n    }\n\n    fn post(&mut self, sim: &mut Sim, _dt: f32, _events: &mut Vec<SimEvent>) {\n        if self.mode == Mode::Island && self.run.is_none() {\n            self.keep_on_land(sim);\n        }\n    }\n\n    fn hud(&self, _sim: &Sim) -> Vec<String> {\n        Vec::new()\n    }\n\n    fn status(&self, sim: &Sim) -> serde_json::Value {\n        self.status_json(sim)\n    }\n\n    fn outcome(&self) -> Outcome {\n        self.outcome\n    }\n\n    fn bot(&self, sim: &Sim) -> InputFrame {\n        self.bot_input(sim)\n    }\n\n    fn frozen(&self) -> bool {\n        self.paused || self.dev_frozen()\n    }\n\n    fn extras(&self, sim: &Sim) -> Extras {\n        let mut objects = Vec::new();\n        if let Some(run) = &self.run {\n            let lane_base = run.kind;\n            for (k, g) in run.ghosts.iter().enumerate() {\n                if let Some(s) = ghost::at(&g.samples, run.t) {\n                    let def = Arc::new(meta::guest_def(g.skin, g.outfit, &meta::Wear::default()));\n                    objects.push(ghost::object(k as u32, &s, run::ghost_lane(lane_base, k), def, ghost::SEATS[g.seat as usize % 4], 0.55));\n                }\n            }\n        }\n        let frame = self.ui_frame(sim);\n        let c = self.cam;\n        let s = c.shot;\n        Extras {\n            status: Some(Arc::new(self.status_json(sim).to_string())),\n            fit: Some(Arc::new(frame)),\n            camera: Some(GameCamera {\n                tilt: (s.tilt + c.look_tilt).clamp(2.0, 89.0),\n                yaw: (s.yaw + c.look_yaw + 540.0).rem_euclid(360.0) - 180.0,\n                distance: s.distance * (1.0 + c.look_zoom),\n                fov: s.fov.max(10.0),\n                height: s.height,\n                cut: c.cut,\n                iris: c.iris,\n            }),\n            focus: Some(s.focus),\n            objects,\n        }\n    }\n}\n\nimpl FitGame {\n    fn dev_frozen(&self) -> bool {\n        self.dev.freeze && !self.dev.step && !self.menus.iter().any(|m| m.kind == MenuKind::Pause)\n    }\n\n    fn can_pause(&self) -> bool {\n        matches!(self.mode, Mode::Island | Mode::Run | Mode::Check | Mode::Report | Mode::Stamp | Mode::Ending | Mode::Credits | Mode::HubDone | Mode::PassPad)\n    }\n\n    pub fn open_pause(&mut self, ev: &mut Vec<SimEvent>) {\n        self.menus.push(Menu::new(MenuKind::Pause));\n        self.pause_t = 0.0;\n        ev.push(SimEvent::Sfx { id: sfx::CONFIRM, gain: 0.5, pitch: 0.9 });\n    }\n\n    fn mode_tick(&mut self, sim: &mut Sim, input: &InputFrame, dt: f32, ev: &mut Vec<SimEvent>) {\n        match self.mode {\n            Mode::Island => self.island_tick(sim, input, dt, ev),\n            Mode::Run => self.run_tick(sim, input, dt, ev),\n            Mode::Check => {\n                let Some(mut check) = self.check.take() else { return };\n                let pid = sim.state.player.unwrap_or(EntityId(0));\n                let i = if self.dev.autoplay { check.bot(&self.check_core, &self.rules) } else { intent_of(input, self.save.settings.lean_sensitivity) };\n                let rules = self.rules.clone();\n                let spots = self.spots.clone();\n                let mut core_ = std::mem::take(&mut self.check_core);\n                let scale = 1.0 - self.save.settings.wobble_assist * 0.8;\n                let mut r2 = rules.core.clone();\n                r2.wobble *= scale;\n                core_.tick(i.lean, &r2, &mut sim.state.rng, dt);\n                let mut shot = self.target;\n                let mut msg = None;\n                let mut actors = std::mem::take(&mut self.check_actors);\n                let mut flops = [false; 5];\n                let flop_ids = [None; 5];\n                let slump = self.slump();\n                let done = {\n                    let mut cx = Cx { sim, ev, r: &rules, dt, core: &mut core_, actors: &mut actors, spots: &spots, pid, shot: &mut shot, msg: &mut msg, seed: self.seed, demo: false, slump, flops: &mut flops, flop_ids: &flop_ids };\n                    check.tick(&mut cx, &i)\n                };\n                self.rumble = check.rumble;\n                self.check_core = core_;\n                self.check_actors = actors;\n                self.target = shot;\n                self.check = Some(check);\n                if done {\n                    self.finish_check(sim, ev);\n                }\n            }\n            Mode::Report => {\n                self.report.t += dt;\n                // The number rolls like a slot machine for three seconds.\n                let tk = (self.report.t * 14.0) as i32;\n                if self.report.t < 3.0 && tk != self.report.last_tick {\n                    self.report.last_tick = tk;\n                    ev.push(SimEvent::Sfx { id: sfx::TICK, gain: 0.5, pitch: 1.0 + (tk % 5) as f32 * 0.05 });\n                }\n                if self.report.t >= 3.0 && !self.report.told {\n                    self.report.told = true;\n                    ev.push(SimEvent::Sfx { id: sfx::STAMP, gain: 0.8, pitch: 1.2 });\n                    let pick = sim.state.rng.next_u32();\n                    let mut d = Dialog::new(After::IslandDay);\n                    if let Some(c) = &self.check {\n                        for (who, text) in c.verdict(self.report.age, self.report.delta, &self.check_core, pick) {\n                            d.push(who, text);\n                        }\n                    }\n                    self.dialog = Some(d);\n                }\n            }\n            Mode::Stamp => {\n                if self.mode_t > 2.5 {\n                    self.next_day(sim, ev);\n                }\n            }\n            Mode::Ending => {\n                // The rowboat leaves, or the sun simply goes on setting.\n                if self.ended_well {\n                    if let Some(id) = self.check_actors.first().copied() {\n                        if let Some(e) = sim.state.entities.get_mut(id) {\n                            e.pos.z += 2.2 * dt;\n                        }\n                    }\n                }\n                if self.mode_t > 6.0 || input.just(btn::CONFIRM) {\n                    self.set_mode(Mode::Credits);\n                }\n            }\n            Mode::Credits => {\n                if self.mode_t > 16.0 || (self.mode_t > 1.0 && input.just(btn::CONFIRM)) {\n                    if self.direct && self.guest().is_some_and(|g| g.ages.is_empty()) {\n                        self.go_title(sim, ev);\n                    } else {\n                        self.to_free_play(sim, ev);\n                    }\n                }\n            }\n            Mode::PassPad => {\n                if input.just(btn::CONFIRM) {\n                    self.medley_leg(sim, ev);\n                }\n            }\n            Mode::Title | Mode::Setup | Mode::Podium | Mode::HubDone => {}\n        }\n    }\n}\nRS\ngrep -n \"pending\" $F/mod.rs | head -3; sed -i 's/^    pub rumble: f32,\\n}/&/' $F/mod.rs\npython3 - <<'PY'\np='engine/crates/pav_core/src/games/fit/mod.rs'\ns=open(p).read()\ns=s.replace('''    pub set_now: usize,\n    pub rumble: f32,\n}''','''    pub set_now: usize,\n    pub rumble: f32,\n    /// Said when the result screen is dismissed.\n    pub pending: Option<Dialog>,\n}''')\ns=s.replace('''        set_now: 0,\n        rumble: 0.0,\n    };''','''        set_now: 0,\n        rumble: 0.0,\n        pending: None,\n    };''')\nopen(p,'w').write(s)\nPY","description":"Write the main game module: flow, camera, attract, medley, Game impl"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018cYZCJeezGFbGmgF2NLcWT","type":"tool_result","content":"1032:                    self.pending_goal_line(d);\n1042:    fn pending_goal_line(&mut self, d: Dialog) {\n1044:        self.pending = Some(d);","is_error":false}]},"parent_tool_use_id":null,"session_id":"cb437ba7-0477-4143-bb04-ff33f49efd62","uuid":"f8a31bc8-3f25-4d4b-a0a1-ad85ce636a50","timestamp":"2026-11-05T06:05:27.861Z","tool_use_result":{"stdout":"1032:                    self.pending_goal_line(d);\n1042:    fn pending_goal_line(&mut self, d: Dialog) {\n1044:        self.pending = Some(d);","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":true},"tool_result_meta":[{"id":"toolu_018cYZCJeezGFbGmgF2NLcWT","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjH4ajUDvKmmUz46EQBJ","type":"message","role":"assistant","content":[{"type":"text","text":"The main state machine is written. Next up are the island walkabout, the menus and the bot, then a first compile. After that I'll add the script, clips, audio and UI drawing."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":30745,"cache_read_input_tokens":384020,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":30745},"output_tokens":75,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cb437ba7-0477-4143-bb04-ff33f49efd62","uuid":"79088123-c5cc-43bc-a6e7-67d32dcfbc7a","timestamp":"2026-11-05T06:05:29.731Z","request_id":"req_011CgjH4aP8zFWXTkWs4zRy6"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjH4ajUDvKmmUz46EQBJ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01AbAeYLdWr3yZ7i6UhEDjcF","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953\nF=engine/crates/pav_core/src/games/fit\ncat > $F/island.rs <<'RS'\n//! Free time on Tippy Cay: walking, talking, finding flip-flops, stepping on mats. And the bot that\n//! plays the whole game, menus included.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::dialog::{After, Dialog};\nuse super::events::*;\nuse super::menus::{Act, Menu, MenuKind};\nuse super::run::{Phase, RunCtx};\nuse super::script::{self, *};\nuse super::*;\nuse crate::input::{InputFrame, UiEvent, buttons as btn};\n\n#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]\npub enum Interact {\n    Mat(EvKind),\n    Stand,\n    Pip,\n    Clam,\n    Calendar,\n    Wardrobe,\n    Cabana,\n    Npc(u8),\n}\n\nconst REACH: f32 = 1.9;\n\nimpl FitGame {\n    /// Everything on the island you can use, with where it is and what the prompt says.\n    pub fn island_spots(&self, sim: &Sim) -> Vec<(Interact, Vec3, String)> {\n        let s = &self.spots;\n        let mut v = vec![\n            (Interact::Pip, s.get(HUB, \"pip\"), \"Talk to Pip\".to_string()),\n            (Interact::Clam, s.get(HUB, \"clam\"), \"Minute Clam\".to_string()),\n            (Interact::Calendar, s.get(HUB, \"calendar\"), \"Calendar\".to_string()),\n            (Interact::Cabana, s.get(HUB, \"cabana\"), \"Sleep\".to_string()),\n        ];\n        if self.guest().is_some_and(|g| g.day >= 2 || g.free_play) {\n            v.push((Interact::Wardrobe, s.get(HUB, \"wardrobe\"), \"Wardrobe\".to_string()));\n        }\n        for k in ALL_EVENTS {\n            let label = if self.event_open(k) { k.name().to_string() } else { format!(\"Opens on Day {}\", k.day()) };\n            v.push((Interact::Mat(k), s.get(HUB, &format!(\"mat_{}\", k.key())), label));\n        }\n        v.push((Interact::Stand, s.get(HUB, \"mat_bigstand\"), if self.stand_open() { \"The Big Stand\".to_string() } else { \"Opens on Day 5\".to_string() }));\n        // The cast, wherever they have wandered.\n        let npcs = [(\"posey\", POSEY), (\"kettle\", KETTLE), (\"bounce\", BOUNCE), (\"marjorie\", MARJORIE), (\"tom\", TOM), (\"twin\", TWINS), (\"guest\", GUEST)];\n        let (lo, hi) = (s.get(HUB, \"arrive\").x - 60.0, s.get(HUB, \"arrive\").x + 60.0);\n        for e in sim.state.entities.iter() {\n            if e.pos.x < lo || e.pos.x > hi {\n                continue;\n            }\n            if let Some((_, who)) = npcs.iter().find(|(n, _)| *n == e.name) {\n                if let Some(f) = sim.feet(e.id) {\n                    v.push((Interact::Npc(*who), f, format!(\"Talk to {}\", script::SPEAKERS[*who as usize])));\n                }\n            }\n        }\n        v.push((Interact::Npc(GULL), s.get(HUB, \"gull\"), \"Talk to the Commodore\".to_string()));\n        v\n    }\n\n    pub fn island_tick(&mut self, sim: &mut Sim, input: &InputFrame, dt: f32, ev: &mut Vec<SimEvent>) {\n        let Some(pid) = sim.state.player else { return };\n        let Some(feet) = sim.feet(pid) else { return };\n        // The first entry of a morning: the story beat is told once by `After::IslandDay`.\n        let spots = self.island_spots(sim);\n        let near = spots.iter().filter(|(_, p, _)| flat(*p - feet) < REACH).min_by(|a, b| flat(a.1 - feet).total_cmp(&flat(b.1 - feet))).cloned();\n        self.near = near.clone();\n        // Hand input.\n        let stick = input.move_dir;\n        if stick.length() > 0.05 {\n            self.walk_path.clear();\n            self.walk_then = None;\n            let jog = input.down(btn::SPRINT);\n            self.move_dir = stick.clamp_length_max(1.0) * if jog { 1.0 } else { 0.62 };\n        }\n        // Mouse: click a thing or the ground, and walk there.\n        if input.just(btn::PRIMARY) {\n            if let Some(aim) = input.aim {\n                let hit = spots.iter().filter(|(_, p, _)| flat(*p - aim) < 1.2).min_by(|a, b| flat(a.1 - aim).total_cmp(&flat(b.1 - aim))).cloned();\n                let goal = hit.as_ref().map(|h| h.1).unwrap_or(aim);\n                if self.nav.is_none() {\n                    self.nav = crate::nav::NavGrid::for_room(sim).map(Arc::new);\n                }\n                self.walk_path = self.nav.as_ref().and_then(|n| n.path(feet, goal)).unwrap_or_else(|| vec![goal]);\n                self.walk_then = hit.map(|h| h.0);\n            }\n        } else if input.just(btn::CONFIRM) {\n            if let Some((what, _, _)) = near.clone() {\n                self.interact(sim, what, ev);\n                return;\n            }\n        }\n        if !self.walk_path.is_empty() {\n            let to = self.walk_path[0];\n            if flat(to - feet) < 0.5 {\n                self.walk_path.remove(0);\n            } else {\n                let d = Vec2::new(to.x - feet.x, to.z - feet.z);\n                self.move_dir = d.normalize_or_zero() * 0.8;\n            }\n            if let Some(what) = self.walk_then {\n                let there = spots.iter().find(|s| s.0 == what).map(|s| s.1);\n                if there.is_some_and(|p| flat(p - feet) < REACH * 0.8) {\n                    self.walk_path.clear();\n                    self.walk_then = None;\n                    self.interact(sim, what, ev);\n                    return;\n                }\n            }\n        }\n        self.wave_cool = (self.wave_cool - dt).max(0.0);\n        if input.just(btn::WAVE) && self.wave_cool <= 0.0 {\n            self.wave_cool = 2.0;\n            let id = crate::clips::find_cached(\"CMU/Wave_Hello\");\n            if let Some(ch) = sim.state.entities.get_mut(pid).and_then(|e| e.character.as_mut()) {\n                ch.anim.replay_clip(id, crate::clips::ONCE | crate::clips::UPPER, 1.0);\n            }\n            if let Some((Interact::Npc(who), _, _)) = spots.iter().filter(|(_, p, _)| flat(*p - feet) < 5.0).min_by(|a, b| flat(a.1 - feet).total_cmp(&flat(b.1 - feet))) {\n                let n = sim.state.rng.next_u32();\n                self.msg = Some((format!(\"{}: {}\", script::SPEAKERS[*who as usize], script::line(\"wave_back\", n)), 3.0));\n                ev.push(SimEvent::Syllable { speaker: *who, vowel: 1, pitch: 1.1 });\n            }\n        }\n        if input.just(btn::SCHEDULE) {\n            self.menus.push(Menu::new(MenuKind::Schedule));\n            ev.push(SimEvent::Sfx { id: sfx::CONFIRM, gain: 0.5, pitch: 1.1 });\n            return;\n        }\n        // Lost flip-flops.\n        for k in 0..5 {\n            let done = self.guest().is_some_and(|g| g.flops[k]);\n            if done {\n                continue;\n            }\n            if let Some(id) = self.flop_ids[k] {\n                if sim.state.entities.get(id).is_some_and(|e| flat(e.pos - feet) < 1.2) {\n                    if let Some(e) = sim.state.entities.get_mut(id) {\n                        e.pos.y = -9.0;\n                    }\n                    self.guest_mut().flops[k] = true;\n                    let n = self.guest().map(|g| g.flops.iter().filter(|f| **f).count()).unwrap_or(0);\n                    self.msg = Some((format!(\"A lost flip-flop. That makes {n} of 5.\"), 3.0));\n                    ev.push(SimEvent::Sfx { id: sfx::POP, gain: 0.8, pitch: 1.3 });\n                    self.store();\n                }\n            }\n        }\n        if let Some((_, left)) = &mut self.msg {\n            *left -= dt;\n        }\n        self.msg = self.msg.take().filter(|m| m.1 > 0.0);\n    }\n\n    pub fn keep_on_land(&mut self, sim: &mut Sim) {\n        let Some(pid) = sim.state.player else { return };\n        let Some(f) = sim.feet(pid) else { return };\n        let c = self.spots.get(HUB, \"arrive\") + Vec3::new(0.0, 0.0, 2.0);\n        // Tiles are grass and sand out to about 33 m by 25 m; further, the sea politely declines.\n        let (dx, dz) = ((f.x - c.x).abs(), (f.z - c.z).abs());\n        let (ox, oz) = ((dx - 23.0).max(0.0), (dz - 15.0).max(0.0));\n        let out = Vec2::new(ox, oz).length();\n        let pier = (f.x - c.x).abs() < 2.2 && f.z > c.z;\n        if out > 10.2 && !pier {\n            let back = Vec2::new(c.x - f.x, c.z - f.z).normalize_or_zero();\n            sim.set_position(pid, f + Vec3::new(back.x, 0.0, back.y) * 0.4);\n            if self.msg.is_none() {\n                self.msg = Some((\"Pip: Please do not swim. The sea is not on your schedule.\".into(), 2.5));\n            }\n        }\n    }\n\n    pub fn interact(&mut self, sim: &mut Sim, what: Interact, ev: &mut Vec<SimEvent>) {\n        let n = sim.state.rng.next_u32();\n        let (day, free) = self.guest().map(|g| (g.day, g.free_play)).unwrap_or((1, false));\n        match what {\n            Interact::Mat(k) => {\n                if self.event_open(k) {\n                    self.start_event(sim, k, RunCtx::Stay, ev);\n                } else {\n                    let mut d = Dialog::new(After::Nothing);\n                    d.push(PIP, format!(\"{} opens on Day {}. It is resting. Please do not wake it.\", k.name(), k.day()));\n                    self.dialog = Some(d);\n                }\n            }\n            Interact::Stand => {\n                if self.stand_open() {\n                    self.start_finale(sim, 0, ev);\n                } else {\n                    let mut d = Dialog::new(After::Nothing);\n                    d.push(MARJORIE, script::line(\"marjorie_stand\", n));\n                    self.dialog = Some(d);\n                }\n            }\n            Interact::Pip => {\n                let mut d = Dialog::new(After::Nothing);\n                match self.day_goal() {\n                    Some(goal) if self.goal_met() => {\n                        d.push(PIP, format!(\"You have banked your {goal} minutes. Your cabana is that way. It has been waiting.\"));\n                    }\n                    Some(goal) => {\n                        let have = self.guest().map(|g| g.minutes).unwrap_or(0);\n                        d.push(PIP, format!(\"You have {have} minutes of {goal}. {}\", script::line(\"pip_idle\", n)));\n                    }\n                    None if free => d.push(PIP, script::line(\"pip_free\", n)),\n                    None => d.push(PIP, \"Today is the Big Stand. It is on the sand by the pier. Everyone will be there. They have rafts.\".to_string()),\n                }\n                self.dialog = Some(d);\n            }\n            Interact::Clam => {\n                ev.push(SimEvent::Sfx { id: sfx::GULP, gain: 0.9, pitch: 1.0 });\n                ev.push(SimEvent::Sfx { id: sfx::BURP, gain: 0.8, pitch: 1.0 });\n                let total = self.guest().map(|g| g.total_minutes).unwrap_or(0);\n                let next = meta::HATS.iter().map(|h| h.1).chain(meta::EXTRAS.iter().map(|e| e.1)).filter(|m| *m > total).min();\n                let mut d = Dialog::new(After::Nothing);\n                d.push(PIP, format!(\"The Clam holds {total} of your minutes. Our minutes are longer. It is a wellness thing.\"));\n                match next {\n                    Some(m) => d.push(PIP, format!(\"At {m} it may give something back. It has not decided.\")),\n                    None => d.push(PIP, \"It has given you everything. It looks tired. It is a clam.\".to_string()),\n                }\n                self.dialog = Some(d);\n            }\n            Interact::Calendar => self.menus.push(Menu::new(MenuKind::Calendar)),\n            Interact::Wardrobe => self.menus.push(Menu::new(MenuKind::Wardrobe)),\n            Interact::Cabana => {\n                if self.goal_met() {\n                    let mut d = Dialog::new(After::EndDay);\n                    d.push(PIP, script::line(\"pip_sleep\", n));\n                    self.dialog = Some(d);\n                } else {\n                    let mut d = Dialog::new(After::Nothing);\n                    match self.day_goal() {\n                        Some(goal) => {\n                            let have = self.guest().map(|g| g.minutes).unwrap_or(0);\n                            d.push(PIP, format!(\"You are not tired yet. I checked. You have {have} minutes of {goal}.\"));\n                        }\n                        None => d.push(PIP, \"The bed is made. It will stay made. Enjoy the island.\".to_string()),\n                    }\n                    self.dialog = Some(d);\n                }\n            }\n            Interact::Npc(who) => {\n                let mut d = Dialog::new(After::Nothing);\n                if who == TOM {\n                    self.tom_talk(&mut d, n, ev, sim);\n                } else {\n                    let key = match who {\n                        POSEY => \"coach_0\".to_string(),\n                        KETTLE => \"coach_1\".to_string(),\n                        BOUNCE => \"coach_2\".to_string(),\n                        GULL => \"coach_3\".to_string(),\n                        MARJORIE => format!(\"marjorie_{}\", day.min(5)),\n                        TWINS => \"twins\".to_string(),\n                        _ => \"guests\".to_string(),\n                    };\n                    d.push(who, script::line(&key, n));\n                }\n                self.dialog = Some(d);\n            }\n        }\n    }\n\n    fn tom_talk(&mut self, d: &mut Dialog, n: u32, ev: &mut Vec<SimEvent>, sim: &mut Sim) {\n        let g = self.guest_mut();\n        let found = g.flops.iter().filter(|f| **f).count();\n        if found == 5 && !g.tom_rewarded {\n            g.tom_rewarded = true;\n            g.wear.gold_shoes = true;\n            d.push(TOM, \"All five. I only have two feet. I do not know whose the others are.\");\n            d.push(TOM, \"Take these. They are gold. They were never comfortable.\");\n            ev.push(SimEvent::Sfx { id: sfx::FANFARE, gain: 0.8, pitch: 1.2 });\n            self.dress(sim);\n            self.store();\n        } else if found == 5 {\n            d.push(TOM, \"I have five flip-flops now. I am the richest man on this island.\");\n        } else {\n            d.push(TOM, format!(\"I have lost my flip-flops. All five. You have found {found}.\"));\n            d.push(TOM, script::line(\"tom\", n));\n        }\n    }\n\n    /// What a good player would press now, on every screen: `Game::bot`.\n    pub fn bot_input(&self, sim: &Sim) -> InputFrame {\n        let mut f = InputFrame::default();\n        if self.hub {\n            f.held |= btn::HUB_GO;\n        }\n        let t = self.tick;\n        let tap = |f: &mut InputFrame, b: u32| {\n            f.held |= b;\n            f.pressed |= b;\n        };\n        if self.attract.is_some() {\n            f.any = true;\n            return f;\n        }\n        if let Some(m) = self.menus.last() {\n            if t % 6 != 0 {\n                return f;\n            }\n            let items = self.menu_items(m);\n            let find = |want: &dyn Fn(&Act) -> bool| items.iter().position(|i| want(&i.act));\n            let choice = match m.kind {\n                MenuKind::Title => find(&|a| matches!(a, Act::NewStay)),\n                MenuKind::Slot | MenuKind::Name => Some(0),\n                MenuKind::Look => find(&|a| matches!(a, Act::Begin)),\n                MenuKind::Result => find(&|a| matches!(a, Act::Leave)),\n                MenuKind::Schedule => {\n                    // On the Today tab: end the day or go to the stand. Else the tab holding what's next.\n                    let next = self.bot_next_event();\n                    if self.goal_met() && next.is_none() || self.stand_open() {\n                        if m.tab != 4 {\n                            f.ui = Some(UiEvent::Click(1004));\n                            return f;\n                        }\n                        find(&|a| matches!(a, Act::EndDay | Act::GoStand))\n                    } else if let Some(k) = next {\n                        if m.tab != k.pavilion() {\n                            f.ui = Some(UiEvent::Click(1000 + k.pavilion() as u16));\n                            return f;\n                        }\n                        find(&|a| matches!(a, Act::GoEvent(e) if *e == k))\n                    } else {\n                        None\n                    }\n                }\n                _ => None,\n            };\n            match choice {\n                Some(i) => f.ui = Some(UiEvent::Click(i as u16)),\n                None => tap(&mut f, btn::BACK),\n            }\n            return f;\n        }\n        if self.dialog.is_some() {\n            if t % 3 == 0 {\n                tap(&mut f, btn::CONFIRM);\n            }\n            return f;\n        }\n        match self.mode {\n            Mode::Island => {\n                if t % 20 == 0 {\n                    tap(&mut f, btn::SCHEDULE);\n                }\n            }\n            Mode::Check => {\n                if let Some(c) = &self.check {\n                    apply_intent(&mut f, &c.bot(&self.check_core, &self.rules));\n                }\n            }\n            Mode::Run => {\n                if let Some(r) = &self.run {\n                    match r.phase {\n                        Phase::Card => {\n                            if t % 6 == 0 {\n                                tap(&mut f, btn::CONFIRM);\n                            }\n                        }\n                        Phase::Play => apply_intent(&mut f, &r.bot(&self.rules)),\n                        _ => {}\n                    }\n                }\n            }\n            Mode::Ending | Mode::Credits | Mode::PassPad => {\n                if t % 6 == 0 {\n                    tap(&mut f, btn::CONFIRM);\n                }\n            }\n            _ => {}\n        }\n        let _ = sim;\n        f\n    }\n\n    /// The next event the bot wants: today's own, not yet done.\n    pub fn bot_next_event(&self) -> Option<EvKind> {\n        let g = self.guest()?;\n        ALL_EVENTS.iter().copied().find(|k| k.day() == g.day && !g.done_today.contains(k.key()))\n    }\n}\n\npub fn apply_intent(f: &mut InputFrame, i: &Intent) {\n    f.lean = i.lean;\n    let mut set = |on: bool, just: bool, b: u32| {\n        if on || just {\n            f.held |= b;\n        }\n        if just {\n            f.pressed |= b;\n        }\n    };\n    set(i.act, i.act_p, btn::CONFIRM);\n    set(i.l, i.l_p, btn::STEP_L);\n    set(i.r, i.r_p, btn::STEP_R);\n}\n\nfn flat(v: Vec3) -> f32 {\n    Vec2::new(v.x, v.z).length()\n}\nRS\ncat > $F/menus.rs <<'RS'\n//! Every menu, one way: a menu is a list of items with actions. The same list drives pad, keys and\n//! pointer, and is what gets drawn. Layout is big rows, at most six in view.\n\nuse glam::Vec3;\nuse serde::{Deserialize, Serialize};\n\nuse super::events::*;\nuse super::island::Interact;\nuse super::meta::{self, Guest};\nuse super::run::{self, Phase, RunCtx};\nuse super::script::{self, PIP};\nuse super::*;\nuse crate::input::{InputFrame, UiEvent, buttons as btn};\nuse crate::params::{self, ParamValue};\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub enum MenuKind {\n    Title,\n    Slot,\n    Continue,\n    Overwrite(u8),\n    Name,\n    Look,\n    Pause,\n    Settings,\n    ResetConfirm,\n    Schedule,\n    Calendar,\n    Wardrobe,\n    HowTo,\n    About,\n    Dev,\n    Result,\n    Together,\n    Podium,\n    Hub,\n}\n\n#[derive(Clone, Copy, Debug, Serialize, Deserialize)]\npub struct Menu {\n    pub kind: MenuKind,\n    pub focus: usize,\n    pub tab: usize,\n    pub scroll: usize,\n    /// Which item the pointer last moved focus to, to tell a move from a resting pointer.\n    pub hover: i32,\n}\n\nimpl Menu {\n    pub fn new(kind: MenuKind) -> Self {\n        Self { kind, focus: 0, tab: 0, scroll: 0, hover: -1 }\n    }\n}\n\n#[derive(Clone, Debug, PartialEq)]\npub enum Act {\n    None,\n    Back,\n    NewStay,\n    ContinueMenu,\n    Together,\n    SettingsOpen,\n    AboutOpen,\n    Slot(usize),\n    ConfirmOverwrite(usize),\n    ContinueSlot(usize),\n    Name(usize),\n    Skin,\n    Outfit,\n    Begin,\n    Resume,\n    ScheduleOpen,\n    CalendarOpen,\n    WardrobeOpen,\n    HowToOpen,\n    DevOpen,\n    QuitTitle,\n    Setting(u8),\n    ResetAsk,\n    ResetYes,\n    GoEvent(EvKind),\n    GoStand,\n    EndDay,\n    Hat,\n    Extra,\n    Retry,\n    Leave,\n    TogetherN,\n    TogetherGo,\n    PodiumDone,\n    Fullscreen,\n    JumpDay(u8),\n    JumpEvent(EvKind),\n    JumpPhase(u32),\n    JumpAttract,\n    JumpMedley,\n    Toggle(u8),\n    GiveMinutes,\n    UnlockAll,\n    AllStars,\n    WinNow,\n    LoseNow,\n    TimeScale,\n    Step,\n    Group,\n    Param(String, f32, f32),\n    ResetGroup,\n    ResetAll,\n    ResetGuest,\n}\n\n#[derive(Clone, Debug)]\npub struct Item {\n    pub act: Act,\n    pub label: String,\n    pub sub: String,\n    pub value: String,\n    pub fill: Option<f32>,\n    pub stars: i8,\n}\n\nfn item(act: Act, label: impl Into<String>) -> Item {\n    Item { act, label: label.into(), sub: String::new(), value: String::new(), fill: None, stars: -1 }\n}\n\nconst SETTING_NAMES: [&str; 8] = [\"Music\", \"Sound Effects\", \"Voices\", \"Glyphs\", \"Lean Sensitivity\", \"Wobble Assist\", \"Rhythm Offset\", \"Text Speed\"];\n\npub fn screen_name(g: &FitGame) -> &'static str {\n    if g.attract.is_some() {\n        return \"attract\";\n    }\n    if let Some(m) = g.menus.last() {\n        return match m.kind {\n            MenuKind::Title => \"title\",\n            MenuKind::Slot | MenuKind::Continue | MenuKind::Overwrite(_) => \"slots\",\n            MenuKind::Name => \"name\",\n            MenuKind::Look => \"look\",\n            MenuKind::Pause => \"pause\",\n            MenuKind::Settings | MenuKind::ResetConfirm => \"settings\",\n            MenuKind::Schedule => \"schedule\",\n            MenuKind::Calendar => \"calendar\",\n            MenuKind::Wardrobe => \"wardrobe\",\n            MenuKind::HowTo => \"howto\",\n            MenuKind::About => \"about\",\n            MenuKind::Dev => \"dev\",\n            MenuKind::Result => \"result\",\n            MenuKind::Together => \"together\",\n            MenuKind::Podium => \"podium\",\n            MenuKind::Hub => \"pause\",\n        };\n    }\n    if g.dialog.is_some() {\n        return \"dialog\";\n    }\n    match g.mode {\n        Mode::Title | Mode::Setup => \"title\",\n        Mode::Island => \"island\",\n        Mode::Check => \"check\",\n        Mode::Report => \"report\",\n        Mode::Run => match g.run.as_ref().map(|r| r.phase) {\n            Some(Phase::Card) => \"card\",\n            Some(Phase::Count) => \"count\",\n            _ => \"event\",\n        },\n        Mode::Stamp => \"stamp\",\n        Mode::Ending => \"ending\",\n        Mode::Credits => \"credits\",\n        Mode::PassPad => \"passpad\",\n        Mode::Podium => \"podium\",\n        Mode::HubDone => \"hubdone\",\n    }\n}\n\nimpl FitGame {\n    pub fn menu_items(&self, m: &Menu) -> Vec<Item> {\n        let s = &self.save.settings;\n        let mut v = Vec::new();\n        match m.kind {\n            MenuKind::Title => {\n                v.push(item(Act::NewStay, \"New Stay\"));\n                if self.save.guests.iter().any(|g| g.is_some()) {\n                    v.push(item(Act::ContinueMenu, \"Continue\"));\n                }\n                v.push(item(Act::Together, \"Play Together\"));\n                v.push(item(Act::SettingsOpen, \"Settings\"));\n                v.push(item(Act::AboutOpen, \"About\"));\n            }\n            MenuKind::Slot => {\n                for i in 0..meta::SLOTS {\n                    let mut it = item(Act::Slot(i), format!(\"Guest Book, Line {}\", i + 1));\n                    if let Some(g) = &self.save.guests[i] {\n                        it.sub = guest_line(g);\n                    } else {\n                        it.sub = \"Empty. Nobody has signed here yet.\".into();\n                    }\n                    v.push(it);\n                }\n            }\n            MenuKind::Continue => {\n                for i in 0..meta::SLOTS {\n                    if let Some(g) = &self.save.guests[i] {\n                        let mut it = item(Act::ContinueSlot(i), g.name.clone());\n                        it.sub = guest_line(g);\n                        v.push(it);\n                    }\n                }\n            }\n            MenuKind::Overwrite(i) => {\n                v.push(item(Act::ConfirmOverwrite(i as usize), \"Yes. They have left.\"));\n                v.push(item(Act::Back, \"No. They are still here.\"));\n            }\n            MenuKind::Name => {\n                for (i, n) in script::script().names.iter().enumerate() {\n                    v.push(item(Act::Name(i), n.clone()));\n                }\n            }\n            MenuKind::Look => {\n                let mut sk = item(Act::Skin, \"Skin Tone\");\n                sk.value = format!(\"{} of {}\", self.look_skin + 1, meta::SKINS.len());\n                v.push(sk);\n                let mut ou = item(Act::Outfit, \"Outfit\");\n                ou.value = meta::OUTFITS[self.look_outfit as usize].0.to_string();\n                v.push(ou);\n                v.push(item(Act::Begin, \"Check In\"));\n            }\n            MenuKind::Pause => {\n                v.push(item(Act::Resume, \"Resume\"));\n                if !self.hub {\n                    if self.mode == Mode::Island {\n                        v.push(item(Act::ScheduleOpen, \"Schedule\"));\n                        v.push(item(Act::CalendarOpen, \"Calendar\"));\n                        if self.guest().is_some_and(|g| g.day >= 2 || g.free_play) {\n                            v.push(item(Act::WardrobeOpen, \"Wardrobe\"));\n                        }\n                    }\n                }\n                v.push(item(Act::SettingsOpen, \"Settings\"));\n                if !self.hub {\n                    v.push(item(Act::HowToOpen, \"How to Play\"));\n                    v.push(item(Act::AboutOpen, \"About\"));\n                    v.push(item(Act::DevOpen, \"Dev Mode\"));\n                    v.push(item(Act::QuitTitle, \"Quit to Title\"));\n                }\n            }\n            MenuKind::Hub => v.push(item(Act::Resume, \"Resume\")),\n            MenuKind::Settings => {\n                let vals = [s.music, s.sfx, s.voice, 0.0, s.lean_sensitivity / 2.0, s.wobble_assist, s.rhythm_offset / 0.3, s.text_speed / 3.0];\n                let tx = [\n                    pct(s.music),\n                    pct(s.sfx),\n                    pct(s.voice),\n                    (if s.xbox { \"Xbox\" } else { \"PlayStation\" }).to_string(),\n                    format!(\"{:.1}x\", s.lean_sensitivity),\n                    pct(s.wobble_assist),\n                    format!(\"{:.0} ms\", s.rhythm_offset * 1000.0),\n                    format!(\"{:.1}x\", s.text_speed),\n                ];\n                for i in 0..8 {\n                    let mut it = item(Act::Setting(i as u8), SETTING_NAMES[i]);\n                    it.value.clone_from(&tx[i]);\n                    if i != 3 {\n                        it.fill = Some(vals[i].clamp(0.0, 1.0));\n                    }\n                    v.push(it);\n                }\n                v.push(item(Act::Fullscreen, \"Fullscreen\"));\n                if !self.hub {\n                    v.push(item(Act::ResetAsk, \"Reset Save\"));\n                }\n                v.push(item(Act::Back, \"Back\"));\n            }\n            MenuKind::ResetConfirm => {\n                v.push(item(Act::ResetYes, \"Erase Everything. Pip Will Remember Anyway.\"));\n                v.push(item(Act::Back, \"Keep It\"));\n            }\n            MenuKind::Schedule => {\n                if m.tab < 4 {\n                    for k in ALL_EVENTS.iter().filter(|k| k.pavilion() == m.tab) {\n                        let open = self.event_open(*k);\n                        let mut it = item(if open { Act::GoEvent(*k) } else { Act::None }, k.name());\n                        if open {\n                            let best = self.guest().and_then(|g| g.bests.get(k.key())).copied().unwrap_or_default();\n                            it.stars = best.stars as i8;\n                            it.sub = if best.score > 0 { format!(\"Best {}\", best.score) } else { \"Not yet attempted. It knows.\".into() };\n                        } else {\n                            it.sub = format!(\"Opens on Day {}\", k.day());\n                        }\n                        v.push(it);\n                    }\n                } else {\n                    if self.stand_open() {\n                        v.push(item(Act::GoStand, \"The Big Stand\"));\n                    }\n                    if self.goal_met() {\n                        let mut it = item(Act::EndDay, \"End the Day\");\n                        it.sub = \"Your cabana has been waiting.\".into();\n                        v.push(it);\n                    } else if let Some(goal) = self.day_goal() {\n                        let mut it = item(Act::None, \"End the Day\");\n                        it.sub = format!(\"{} of {goal} minutes banked\", self.guest().map(|g| g.minutes).unwrap_or(0));\n                        v.push(it);\n                    }\n                    v.push(item(Act::CalendarOpen, \"Calendar\"));\n                }\n            }\n            MenuKind::Wardrobe => {\n                let (hat, extra, outfit) = self.guest().map(|g| (g.wear.hat, g.wear.extra, g.outfit)).unwrap_or((0, 0, 0));\n                let mut a = item(Act::Hat, \"Hat\");\n                a.value = meta::HATS[hat as usize].0.to_string();\n                a.sub = self.locked_hint(&meta::HATS);\n                v.push(a);\n                let mut b = item(Act::Extra, \"Extras\");\n                b.value = meta::EXTRAS[extra as usize].0.to_string();\n                b.sub = self.locked_hint(&meta::EXTRAS);\n                v.push(b);\n                let mut c = item(Act::Outfit, \"Outfit\");\n                c.value = meta::OUTFITS[outfit as usize].0.to_string();\n                v.push(c);\n                v.push(item(Act::Back, \"Back\"));\n            }\n            MenuKind::Calendar | MenuKind::HowTo | MenuKind::About => v.push(item(Act::Back, \"Back\")),\n            MenuKind::Result => {\n                if self.run.as_ref().is_some_and(|r| r.ctx != RunCtx::Finale) {\n                    v.push(item(Act::Retry, \"Retry\"));\n                }\n                v.push(item(Act::Leave, \"Back to the Island\"));\n            }\n            MenuKind::Together => {\n                let mut n = item(Act::TogetherN, \"Guests\");\n                n.value = format!(\"{}\", self.together_n);\n                v.push(n);\n                v.push(item(Act::TogetherGo, \"Begin the Inter-Resort Medley\"));\n                v.push(item(Act::Back, \"Back\"));\n            }\n            MenuKind::Podium => v.push(item(Act::PodiumDone, \"Back to the Title\")),\n            MenuKind::Dev => self.dev_items(m, &mut v),\n        }\n        v\n    }\n\n    fn locked_hint(&self, list: &[(&str, u32)]) -> String {\n        let total = self.guest().map(|g| g.total_minutes).unwrap_or(0);\n        match list.iter().filter(|x| x.1 > total).map(|x| x.1).min() {\n            Some(m) => format!(\"More at {m} minutes in the Clam (you have {total})\"),\n            None => \"Everything is unlocked. Nothing fits.\".into(),\n        }\n    }\n\n    fn dev_items(&self, m: &Menu, v: &mut Vec<Item>) {\n        let on = |b: bool| if b { \"On\" } else { \"Off\" }.to_string();\n        let tog = |k: u8, name: &str, b: bool| {\n            let mut it = item(Act::Toggle(k), name);\n            it.value = on(b);\n            it\n        };\n        let d = &self.dev;\n        match m.tab {\n            0 => {\n                for day in 1..=5u8 {\n                    v.push(item(Act::JumpDay(day), format!(\"Day {day}\")));\n                }\n                for k in ALL_EVENTS {\n                    v.push(item(Act::JumpEvent(k), k.name()));\n                }\n                for (i, p) in finale::PHASES.iter().enumerate() {\n                    v.push(item(Act::JumpPhase(i as u32), format!(\"Big Stand: {p}\")));\n                }\n                v.push(item(Act::JumpAttract, \"Attract Mode\"));\n                v.push(item(Act::JumpMedley, \"Medley\"));\n            }\n            1 => {\n                v.push(tog(0, \"No Tips\", d.no_tips));\n                v.push(tog(1, \"Autoplay with the Bot\", d.autoplay));\n                v.push(tog(2, \"Skip Dialogue\", d.skip_dialog));\n                v.push(item(Act::GiveMinutes, \"Give 5 Minutes\"));\n                v.push(item(Act::UnlockAll, \"Unlock All\"));\n                v.push(item(Act::AllStars, \"All Stars\"));\n                v.push(item(Act::WinNow, \"Win This Event Now\"));\n                v.push(item(Act::LoseNow, \"Lose This Event Now\"));\n            }\n            2 => {\n                let mut t = item(Act::TimeScale, \"Time Scale\");\n                t.value = format!(\"{:.2}x\", d.time_scale);\n                t.fill = Some(((d.time_scale - 0.25) / 3.75).clamp(0.0, 1.0));\n                v.push(t);\n                v.push(tog(3, \"Freeze the World\", d.freeze));\n                v.push(item(Act::Step, \"Single Step\"));\n            }\n            3 => {\n                let mut g = item(Act::Group, \"Group\");\n                g.value = rules::GROUPS[d.group].to_string();\n                v.push(g);\n                let mut copy = self.rules.clone();\n                let prefix = format!(\"{}.\", rules::GROUPS[d.group]);\n                for p in params::list(&mut copy).into_iter().filter(|p| p.path.starts_with(&prefix)) {\n                    if let crate::params::ParamKind::Float { min, max } = p.kind {\n                        let val = p.value.as_f64().unwrap_or(0.0) as f32;\n                        let mut it = item(Act::Param(p.path.clone(), min, max), p.help.clone());\n                        it.value = format!(\"{val:.2}\");\n                        it.fill = Some(((val - min) / (max - min)).clamp(0.0, 1.0));\n                        v.push(it);\n                    }\n                }\n                v.push(item(Act::ResetGroup, \"Reset This Group to Defaults\"));\n                v.push(item(Act::ResetAll, \"Reset All to Defaults\"));\n            }\n            4 => {\n                v.push(tog(4, \"Input Viewer\", d.input_view));\n                v.push(tog(5, \"Dot Trace\", d.trace));\n                v.push(tog(6, \"Engine Stats\", d.stats));\n                v.push(tog(7, \"Free Camera\", d.free_cam));\n                v.push(tog(8, \"Ghost Lanes\", d.ghosts));\n            }\n            _ => v.push(item(Act::ResetGuest, \"Reset This Guest\")),\n        }\n        v.push(item(Act::Back, \"Back\"));\n    }\n\n    pub fn tabs_of(&self, m: &Menu) -> Vec<String> {\n        match m.kind {\n            MenuKind::Schedule => {\n                let mut t: Vec<String> = PAVILIONS.iter().map(|s| s.to_string()).collect();\n                t.push(\"Today\".into());\n                t\n            }\n            MenuKind::Dev => [\"Jump\", \"Cheats\", \"Time\", \"Tuning\", \"View\", \"Save\"].iter().map(|s| s.to_string()).collect(),\n            MenuKind::HowTo => HOW_TO.iter().map(|p| p.0.to_string()).collect(),\n            MenuKind::About => self.about_pages().iter().map(|p| p.0.clone()).collect(),\n            _ => Vec::new(),\n        }\n    }\n\n    pub fn menu_input(&mut self, sim: &mut Sim, input: &InputFrame, ev: &mut Vec<SimEvent>) {\n        let Some(mut m) = self.menus.last().copied() else { return };\n        let items = self.menu_items(&m);\n        let tabs = self.tabs_of(&m);\n        let n = items.len();\n        let mut activate = None;\n        let mut moved = false;\n        if !tabs.is_empty() {\n            let d = input.just(btn::TAB_R) as i32 - input.just(btn::TAB_L) as i32;\n            if d != 0 {\n                m.tab = (m.tab as i32 + d).rem_euclid(tabs.len() as i32) as usize;\n                m.focus = 0;\n                m.scroll = 0;\n                ev.push(SimEvent::Sfx { id: sfx::MOVE, gain: 0.6, pitch: 0.9 });\n            }\n        }\n        if n > 0 {\n            let d = input.just(btn::MENU_DOWN) as i32 - input.just(btn::MENU_UP) as i32;\n            if d != 0 {\n                m.focus = (m.focus as i32 + d).rem_euclid(n as i32) as usize;\n                moved = true;\n            }\n            let side = input.just(btn::MENU_RIGHT) as i32 - input.just(btn::MENU_LEFT) as i32;\n            if side != 0 {\n                if let Some(it) = items.get(m.focus) {\n                    self.adjust(sim, &it.act.clone(), side as f32, ev);\n                }\n            }\n            if input.just(btn::CONFIRM) {\n                activate = Some(m.focus);\n            }\n        }\n        match input.ui {\n            Some(UiEvent::Hover(id)) if (id as usize) < n => {\n                if m.focus != id as usize {\n                    m.focus = id as usize;\n                    moved = true;\n                }\n            }\n            Some(UiEvent::Click(id)) if (id as usize) < n => {\n                m.focus = id as usize;\n                activate = Some(id as usize);\n            }\n            Some(UiEvent::Click(id)) if id >= 1000 && ((id - 1000) as usize) < tabs.len() => {\n                m.tab = (id - 1000) as usize;\n                m.focus = 0;\n                m.scroll = 0;\n                ev.push(SimEvent::Sfx { id: sfx::MOVE, gain: 0.6, pitch: 0.9 });\n            }\n            Some(UiEvent::Slider(id, val)) if (id as usize) < n => {\n                m.focus = id as usize;\n                let act = items[id as usize].act.clone();\n                self.set_value(&act, val);\n            }\n            _ => {}\n        }\n        if moved {\n            ev.push(SimEvent::Sfx { id: sfx::MOVE, gain: 0.6, pitch: 1.0 });\n        }\n        m.scroll = m.scroll.min(m.focus);\n        if m.focus >= m.scroll + 6 {\n            m.scroll = m.focus + 1 - 6;\n        }\n        if let Some(top) = self.menus.last_mut() {\n            *top = m;\n        }\n        let back = input.just(btn::BACK) || input.just(btn::PAUSE);\n        if let Some(i) = activate {\n            let act = items.get(i).map(|x| x.act.clone()).unwrap_or(Act::None);\n            if act != Act::None {\n                ev.push(SimEvent::Sfx { id: if act == Act::Back { sfx::BACK } else { sfx::CONFIRM }, gain: 0.7, pitch: 1.0 });\n            }\n            self.do_act(sim, act, ev);\n        } else if back && !matches!(m.kind, MenuKind::Title | MenuKind::Result | MenuKind::Podium) {\n            ev.push(SimEvent::Sfx { id: sfx::BACK, gain: 0.7, pitch: 1.0 });\n            self.pop_menu(sim, ev);\n        }\n    }\n\n    pub fn pop_menu(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        let kind = self.menus.pop().map(|m| m.kind);\n        if kind == Some(MenuKind::Pause) && self.pause_t > 60.0 {\n            let mins = (self.pause_t / 60.0) as u32;\n            let mut d = Dialog::new(After::Nothing);\n            d.push(PIP, format!(\"You have been paused for {mins} minute{}. Pausing is not an exercise. I checked.\", if mins == 1 { \"\" } else { \"s\" }));\n            self.dialog = Some(d);\n        }\n        if kind == Some(MenuKind::Wardrobe) {\n            self.dress(sim);\n        }\n        if self.menus.is_empty() && matches!(self.mode, Mode::Title | Mode::Setup) {\n            self.go_title(sim, ev);\n        }\n    }\n\n    fn adjust(&mut self, sim: &mut Sim, act: &Act, dir: f32, ev: &mut Vec<SimEvent>) {\n        ev.push(SimEvent::Sfx { id: sfx::MOVE, gain: 0.5, pitch: 1.1 });\n        match act {\n            Act::Setting(i) => {\n                let s = &mut self.save.settings;\n                let step = 0.05 * dir;\n                match i {\n                    0 => s.music = (s.music + step).clamp(0.0, 1.0),\n                    1 => s.sfx = (s.sfx + step).clamp(0.0, 1.0),\n                    2 => s.voice = (s.voice + step).clamp(0.0, 1.0),\n                    3 => s.xbox = !s.xbox,\n                    4 => s.lean_sensitivity = (s.lean_sensitivity + 0.1 * dir).clamp(0.3, 2.0),\n                    5 => s.wobble_assist = (s.wobble_assist + 0.1 * dir).clamp(0.0, 1.0),\n                    6 => s.rhythm_offset = (s.rhythm_offset + 0.01 * dir).clamp(0.0, 0.3),\n                    _ => s.text_speed = (s.text_speed + 0.2 * dir).clamp(0.4, 3.0),\n                }\n                self.store();\n            }\n            Act::Skin => {\n                self.look_skin = (self.look_skin as i32 + dir as i32).rem_euclid(meta::SKINS.len() as i32) as u8;\n                self.preview_look(sim);\n            }\n            Act::Outfit => {\n                if self.menus.last().is_some_and(|m| m.kind == MenuKind::Wardrobe) {\n                    let g = self.guest_mut();\n                    g.outfit = (g.outfit as i32 + dir as i32).rem_euclid(meta::OUTFITS.len() as i32) as u8;\n                    self.dress(sim);\n                    self.store();\n                } else {\n                    self.look_outfit = (self.look_outfit as i32 + dir as i32).rem_euclid(meta::OUTFITS.len() as i32) as u8;\n                    self.preview_look(sim);\n                }\n            }\n            Act::Hat => {\n                self.cycle_wear(true, dir as i32);\n                self.dress(sim);\n            }\n            Act::Extra => {\n                self.cycle_wear(false, dir as i32);\n                self.dress(sim);\n            }\n            Act::TogetherN => {\n                self.together_n = (self.together_n as i32 + dir as i32 - 2).rem_euclid(3) as u32 + 2;\n            }\n            Act::TimeScale => self.dev.time_scale = (self.dev.time_scale + 0.25 * dir).clamp(0.25, 4.0),\n            Act::Group => self.dev.group = (self.dev.group as i32 + dir as i32).rem_euclid(rules::GROUPS.len() as i32) as usize,\n            Act::Param(path, min, max) => {\n                let mut copy = self.rules.clone();\n                let now = params::get(&mut copy, path).and_then(|v| v.as_f64()).unwrap_or(0.0) as f32;\n                let f = ((now - min) / (max - min) + 0.025 * dir).clamp(0.0, 1.0);\n                self.set_value(act, f);\n            }\n            _ => {}\n        }\n    }\n\n    /// A slider dragged to `f` (0..1).\n    fn set_value(&mut self, act: &Act, f: f32) {\n        let f = f.clamp(0.0, 1.0);\n        match act {\n            Act::Setting(i) => {\n                let s = &mut self.save.settings;\n                match i {\n                    0 => s.music = f,\n                    1 => s.sfx = f,\n                    2 => s.voice = f,\n                    4 => s.lean_sensitivity = (f * 2.0).max(0.3),\n                    5 => s.wobble_assist = f,\n                    6 => s.rhythm_offset = f * 0.3,\n                    7 => s.text_speed = (f * 3.0).max(0.4),\n                    _ => {}\n                }\n                self.store();\n            }\n            Act::TimeScale => self.dev.time_scale = 0.25 + f * 3.75,\n            Act::Param(path, min, max) => {\n                let _ = params::set(&mut self.rules, path, ParamValue::Float((min + (max - min) * f) as f64));\n            }\n            _ => {}\n        }\n    }\n\n    fn cycle_wear(&mut self, hat: bool, dir: i32) {\n        let g = self.guest_mut();\n        let total = g.total_minutes;\n        let list: &[(&str, u32)] = if hat { &meta::HATS } else { &meta::EXTRAS };\n        let cur = if hat { g.wear.hat } else { g.wear.extra } as i32;\n        let n = list.len() as i32;\n        let mut next = cur;\n        for _ in 0..n {\n            next = (next + dir).rem_euclid(n);\n            if list[next as usize].1 <= total {\n                break;\n            }\n        }\n        if hat {\n            g.wear.hat = next as u8;\n        } else {\n            g.wear.extra = next as u8;\n        }\n        self.store();\n    }\n\n    fn preview_look(&mut self, sim: &mut Sim) {\n        self.dress_as(sim, meta::guest_def(self.look_skin, self.look_outfit, &meta::Wear::default()));\n    }\n\n    pub fn do_act(&mut self, sim: &mut Sim, act: Act, ev: &mut Vec<SimEvent>) {\n        match act {\n            Act::None => {}\n            Act::Back => self.pop_menu(sim, ev),\n            Act::NewStay => {\n                self.set_mode(Mode::Setup);\n                self.menus.push(Menu::new(MenuKind::Slot));\n            }\n            Act::ContinueMenu => {\n                self.set_mode(Mode::Setup);\n                self.menus.push(Menu::new(MenuKind::Continue));\n            }\n            Act::Together => {\n                self.set_mode(Mode::Setup);\n                self.menus.push(Menu::new(MenuKind::Together));\n            }\n            Act::SettingsOpen => self.menus.push(Menu::new(MenuKind::Settings)),\n            Act::AboutOpen => self.menus.push(Menu::new(MenuKind::About)),\n            Act::Slot(i) => {\n                self.slot = i;\n                if self.save.guests[i].is_some() {\n                    self.menus.push(Menu::new(MenuKind::Overwrite(i as u8)));\n                } else {\n                    self.menus.push(Menu::new(MenuKind::Name));\n                }\n            }\n            Act::ConfirmOverwrite(i) => {\n                self.save.guests[i] = None;\n                self.menus.pop();\n                self.menus.push(Menu::new(MenuKind::Name));\n            }\n            Act::ContinueSlot(i) => {\n                self.slot = i;\n                self.menus.clear();\n                self.continue_stay(sim, ev);\n            }\n            Act::Name(i) => {\n                self.name_pick = i;\n                let n = script::script().names.len().max(1);\n                self.look_skin = (i % 6) as u8;\n                self.look_outfit = (i % n % 8) as u8;\n                self.preview_look(sim);\n                self.menus.push(Menu::new(MenuKind::Look));\n            }\n            Act::Skin | Act::Outfit | Act::Hat | Act::Extra | Act::TogetherN | Act::Group | Act::TimeScale => self.adjust(sim, &act, 1.0, ev),\n            Act::Begin => {\n                let name = script::script().names.get(self.name_pick).cloned().unwrap_or_else(|| \"Guest\".into());\n                self.save.guests[self.slot] = Some(Guest::new(&name, self.look_skin, self.look_outfit));\n                self.menus.clear();\n                self.dress(sim);\n                self.intro(sim, ev);\n            }\n            Act::Resume => self.pop_menu(sim, ev),\n            Act::ScheduleOpen => self.menus.push(Menu::new(MenuKind::Schedule)),\n            Act::CalendarOpen => self.menus.push(Menu::new(MenuKind::Calendar)),\n            Act::WardrobeOpen => self.menus.push(Menu::new(MenuKind::Wardrobe)),\n            Act::HowToOpen => self.menus.push(Menu::new(MenuKind::HowTo)),\n            Act::DevOpen => self.menus.push(Menu::new(MenuKind::Dev)),\n            Act::QuitTitle => {\n                self.store();\n                self.paused = false;\n                self.go_title(sim, ev);\n            }\n            Act::Setting(i) => {\n                if i == 3 {\n                    self.adjust(sim, &act, 1.0, ev);\n                }\n            }\n            Act::ResetAsk => self.menus.push(Menu::new(MenuKind::ResetConfirm)),\n            Act::ResetYes => {\n                self.save = Save::default();\n                self.store();\n                self.paused = false;\n                self.go_title(sim, ev);\n            }\n            Act::GoEvent(k) => self.start_event(sim, k, RunCtx::Stay, ev),\n            Act::GoStand => self.start_finale(sim, 0, ev),\n            Act::EndDay => {\n                self.menus.clear();\n                self.interact(sim, Interact::Cabana, ev);\n            }\n            Act::Retry => {\n                let Some(run) = &self.run else { return };\n                let (kind, ctx) = (run.kind, run.ctx);\n                if let Some(k) = kind {\n                    self.start_event(sim, k, ctx, ev);\n                }\n            }\n            Act::Leave => self.leave_run(sim, ev),\n            Act::TogetherGo => {\n                let n = self.together_n as usize;\n                let racers = (0..n)\n                    .map(|i| {\n                        let (name, skin, outfit) = match &self.save.guests[i] {\n                            Some(g) => (g.name.clone(), g.skin, g.outfit),\n                            None => (format!(\"Guest {}\", i + 1), (i * 2) as u8, i as u8),\n                        };\n                        Racer { name, skin, outfit, ..Default::default() }\n                    })\n                    .collect();\n                self.menus.clear();\n                let seed = self.seed.wrapping_add(self.tick as u32);\n                self.begin_medley(sim, racers, seed, ev);\n            }\n            Act::PodiumDone => self.go_title(sim, ev),\n            Act::Fullscreen => self.fullscreen += 1,\n            Act::JumpDay(d) => {\n                self.paused = false;\n                self.teardown_run(sim);\n                if self.save.guests[self.slot].is_none() {\n                    self.guest_mut();\n                }\n                let g = self.guest_mut();\n                g.day = d;\n                g.stamps = d - 1;\n                g.minutes = 0;\n                g.done_today.clear();\n                self.menus.clear();\n                self.dialog = None;\n                self.begin_day(sim, ev);\n            }\n            Act::JumpEvent(k) => {\n                self.paused = false;\n                self.guest_mut();\n                self.dress(sim);\n                self.start_event(sim, k, RunCtx::Stay, ev);\n            }\n            Act::JumpPhase(p) => {\n                self.paused = false;\n                self.guest_mut();\n                self.dress(sim);\n                self.start_finale(sim, p, ev);\n            }\n            Act::JumpAttract => {\n                self.paused = false;\n                self.go_title(sim, ev);\n                self.attract_start(sim, ev);\n            }\n            Act::JumpMedley => {\n                self.paused = false;\n                self.menus.clear();\n                self.begin_medley(sim, vec![Racer { name: \"You\".into(), skin: 1, ..Default::default() }], self.seed, ev);\n            }\n            Act::Toggle(k) => {\n                let d = &mut self.dev;\n                match k {\n                    0 => d.no_tips = !d.no_tips,\n                    1 => d.autoplay = !d.autoplay,\n                    2 => d.skip_dialog = !d.skip_dialog,\n                    3 => d.freeze = !d.freeze,\n                    4 => d.input_view = !d.input_view,\n                    5 => {\n                        d.trace = !d.trace;\n                        if let Some(r) = &mut self.run {\n                            r.trace.clear();\n                        }\n                    }\n                    6 => d.stats = !d.stats,\n                    7 => {\n                        d.free_cam = !d.free_cam;\n                        self.cam.look_yaw = 0.0;\n                        self.cam.look_tilt = 0.0;\n                        self.cam.look_zoom = 0.0;\n                    }\n                    _ => d.ghosts = !d.ghosts,\n                }\n            }\n            Act::GiveMinutes => {\n                let g = self.guest_mut();\n                g.minutes += 5;\n                g.total_minutes += 5;\n                self.store();\n            }\n            Act::UnlockAll => {\n                let g = self.guest_mut();\n                g.day = g.day.max(5);\n                g.total_minutes = g.total_minutes.max(99);\n                self.store();\n            }\n            Act::AllStars => {\n                let g = self.guest_mut();\n                for k in ALL_EVENTS {\n                    g.bests.insert(k.key().to_string(), meta::Best { score: 900, stars: 3 });\n                }\n                self.store();\n            }\n            Act::WinNow | Act::LoseNow => {\n                let win = act == Act::WinNow;\n                if let Some(run) = self.run.as_mut() {\n                    if run.phase != Phase::Result {\n                        run.phase = Phase::Play;\n                        self.menus.clear();\n                        self.paused = false;\n                        self.finish_run_forced(sim, if win { 1000 } else { 0 }, ev);\n                    }\n                }\n            }\n            Act::Step => self.dev.step = true,\n            Act::Param(..) => {}\n            Act::ResetGroup => {\n                let path = rules::GROUPS[self.dev.group];\n                let mut base = self.base_rules.clone();\n                for p in params::list(&mut base).into_iter().filter(|p| p.path.starts_with(&format!(\"{path}.\"))) {\n                    let _ = params::set(&mut self.rules, &p.path, p.value);\n                }\n            }\n            Act::ResetAll => self.rules = self.base_rules.clone(),\n            Act::ResetGuest => {\n                let (name, skin, outfit) = self.guest().map(|g| (g.name.clone(), g.skin, g.outfit)).unwrap_or_default();\n                self.save.guests[self.slot] = Some(Guest::new(&name, skin, outfit));\n                self.store();\n                self.paused = false;\n                self.go_title(sim, ev);\n            }\n        }\n    }\n\n    /// Ends the run now with a chosen score (Dev Mode).\n    fn finish_run_forced(&mut self, sim: &mut Sim, score: u32, ev: &mut Vec<SimEvent>) {\n        self.forced_score = Some(score);\n        self.finish_run(sim, ev);\n        self.forced_score = None;\n    }\n\n    fn intro(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        let at = self.spots.get(HUB, \"pip\") + Vec3::new(0.0, 0.0, 2.2);\n        self.goto_set(sim, HUB, at);\n        self.set_mode(Mode::Island);\n        self.play_song(ev, 1);\n        let mut d = Dialog::new(After::Nothing);\n        for line in script::lines(\"intro\") {\n            let (who, text) = script_line(line);\n            d.push(who, text);\n        }\n        d.after = After::Nothing;\n        self.dialog = Some(d);\n        self.pending_begin = true;\n    }\n\n    fn continue_stay(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        self.dress(sim);\n        let today = self.today;\n        let free = self.guest().is_some_and(|g| g.free_play);\n        if free {\n            let g = self.guest_mut();\n            let away = if g.last_day > 0 && today > g.last_day { (today - g.last_day) as u32 } else { 0 };\n            g.real_stamps += away.min(1);\n            g.last_day = today;\n            self.enter_island(sim, ev);\n            let n = sim.state.rng.next_u32();\n            let mut d = Dialog::new(After::Nothing);\n            if away > 0 {\n                d.push(PIP, format!(\"You were away for {away} day{}. I did not count them. There were {away}.\", if away == 1 { \"\" } else { \"s\" }));\n            }\n            d.push(PIP, script::line(\"pip_free\", n));\n            self.dialog = Some(d);\n            self.store();\n            return;\n        }\n        // Mid-stay: back to this morning, or to the island if the check is done.\n        if self.guest().is_some_and(|g| g.checked_today) {\n            self.enter_island(sim, ev);\n            let last = self.guest().map(|g| g.last_day).unwrap_or(0);\n            if today > 0 && last > 0 && today > last {\n                let away = today - last;\n                let mut d = Dialog::new(After::Nothing);\n                d.push(PIP, format!(\"You were away for {away} day{}. I did not count them. There were {away}.\", if away == 1 { \"\" } else { \"s\" }));\n                self.dialog = Some(d);\n                self.guest_mut().last_day = today;\n            }\n        } else {\n            self.begin_day(sim, ev);\n        }\n    }\n\n    pub fn about_pages(&self) -> Vec<(String, Vec<String>)> {\n        let v: serde_json::Value = serde_json::from_str(&self.about).unwrap_or(serde_json::Value::Null);\n        let mut pages = Vec::new();\n        pages.push((TITLE.to_string(), vec![TAGLINE.to_string(), \"An original game. Inspired by Wii Fit; no relation to it, and it has not asked.\".to_string()]));\n        if let Some(info) = v.get(\"sourceInformation\").and_then(|i| i.as_object()) {\n            let labels = [(\"date\", \"Date\"), (\"source\", \"Source\"), (\"plan\", \"Plan\"), (\"genre\", \"Genre\"), (\"perspective\", \"Perspective\"), (\"tech\", \"Tech\"), (\"artDirection\", \"Art Direction\"), (\"animation\", \"Animation\"), (\"audio\", \"Audio\"), (\"online\", \"Online\"), (\"testing\", \"Testing\"), (\"research\", \"Research\"), (\"environment\", \"Environment\"), (\"model\", \"Model\"), (\"usage\", \"Usage\")];\n            let mut lines: Vec<String> = Vec::new();\n            for (k, l) in labels {\n                if let Some(t) = info.get(k).and_then(|x| x.as_str()) {\n                    lines.push(format!(\"{l}: {t}\"));\n                }\n            }\n            paginate(\"Source Information\", &lines, &mut pages);\n        }\n        for (key, name) in [(\"testingFeedback\", \"Testing Feedback\"), (\"engineFeedback\", \"Engine Feedback\"), (\"promptFeedback\", \"Prompt Feedback\")] {\n            if let Some(a) = v.get(key).and_then(|x| x.as_array()) {\n                let lines: Vec<String> = a.iter().filter_map(|x| x.as_str().map(|s| s.to_string())).collect();\n                paginate(name, &lines, &mut pages);\n            }\n        }\n        paginate(\n            \"Credits\",\n            &[\n                \"Fonts: Fredoka and Nunito (SIL Open Font License).\".to_string(),\n                \"Engine: Pavilion, from Shardfall by Michael Crosato.\".to_string(),\n                \"Motion clips: Quaternius, CMU Graphics Lab, Mesh2Motion and Style100 libraries (CC0 and open licences; see the engine's store/CREDITS.md), and hand-keyed moves made for this game.\".to_string(),\n                \"All music, sound and voices are written in code. There are no audio files.\".to_string(),\n            ],\n            &mut pages,\n        );\n        pages\n    }\n}\n\nfn paginate(title: &str, lines: &[String], pages: &mut Vec<(String, Vec<String>)>) {\n    let mut cur: Vec<String> = Vec::new();\n    let mut len = 0;\n    let mut n = 1;\n    let flush = |cur: &mut Vec<String>, n: &mut u32, pages: &mut Vec<(String, Vec<String>)>| {\n        if !cur.is_empty() {\n            pages.push((format!(\"{title} {n}\"), std::mem::take(cur)));\n            *n += 1;\n        }\n    };\n    for l in lines {\n        // A long answer is split so no page is a wall.\n        for part in split_long(l, 460) {\n            if len + part.len() > 520 {\n                flush(&mut cur, &mut n, pages);\n                len = 0;\n            }\n            len += part.len();\n            cur.push(part);\n        }\n    }\n    flush(&mut cur, &mut n, pages);\n}\n\nfn split_long(s: &str, max: usize) -> Vec<String> {\n    let mut out = Vec::new();\n    let mut cur = String::new();\n    for w in s.split(' ') {\n        if cur.len() + w.len() + 1 > max {\n            out.push(std::mem::take(&mut cur));\n        }\n        if !cur.is_empty() {\n            cur.push(' ');\n        }\n        cur.push_str(w);\n    }\n    if !cur.is_empty() {\n        out.push(cur);\n    }\n    out\n}\n\nfn guest_line(g: &Guest) -> String {\n    let age = g.age().map(|a| format!(\", Balance Age {a}\")).unwrap_or_default();\n    if g.free_play { format!(\"{}, free play{age}\", g.name) } else { format!(\"{}, Day {}{age}\", g.name, g.day) }\n}\n\nfn pct(x: f32) -> String {\n    format!(\"{}%\", (x * 100.0).round() as u32)\n}\n\npub const HOW_TO: [(&str, &[&str]); 5] = [\n    (\"Leaning\", &[\"Everything here is done by leaning. The dot on the Puck is your balance.\", \"Left stick, W A S D, or move the mouse from the middle of the screen.\", \"Small movements. Smaller than that.\"]),\n    (\"Buttons\", &[\"Action: begin, inhale, squat, bounce.\", \"Left and right step: the shoulder buttons, Q and E, or the mouse buttons.\", \"Brace: both steps at once.\"]),\n    (\"The Island\", &[\"Walk with the left stick or W A S D, or click where you want to go.\", \"Step on a mat to begin an event. The Schedule goes anywhere.\", \"Wave at people. They will wave back. They have to.\"]),\n    (\"Each Day\", &[\"Morning: Pip tests your balance and gives you a number.\", \"Bank the day's minutes in events, and the Clam keeps them.\", \"Sleep at your cabana. A big stamp lands. Tomorrow comes.\"]),\n    (\"Leaving\", &[\"Checkout requires a Balance Age of 40 or better.\", \"Day 5 is the Big Stand. The last test is to do nothing.\", \"Nobody has asked to leave yet.\"]),\n];\n\nimpl FitGame {\n    /// The UI, written for this tick.\n    pub fn ui_frame(&self, sim: &Sim) -> UiFrame {\n        let mut b = B::default();\n        self.draw_world_layer(&mut b, sim);\n        if let Some(d) = &self.dialog {\n            d.draw(&mut b);\n        }\n        if let Some(m) = self.menus.last() {\n            self.draw_menu(&mut b, m, sim);\n        }\n        if self.dev.input_view {\n            self.draw_input_view(&mut b);\n        }\n        let s = &self.save.settings;\n        UiFrame {\n            items: b.items,\n            screen: screen_name(self),\n            xbox: s.xbox,\n            music: if self.hub_ended { 0.0 } else { s.music },\n            sfx: if self.hub_ended { 0.0 } else { s.sfx },\n            voice: if self.hub_ended { 0.0 } else { s.voice },\n            rhythm_offset: s.rhythm_offset,\n            time_scale: self.dev.time_scale,\n            stats: self.dev.stats,\n            fullscreen: self.fullscreen,\n            save: (self.save_serial > 0).then(|| (self.save_serial, self.save_blob.clone())),\n            hub: self.hub,\n            silent: self.hub_ended,\n            dev_overlay: self.dev.input_view,\n            rumble: self.rumble,\n        }\n    }\n\n    fn draw_input_view(&self, b: &mut B) {\n        b.flat([40.0, 700.0, 460.0, 1040.0], [255, 255, 255, 200], 24.0);\n        b.text(60.0, 712.0, 36.0, INK, \"Input\");\n        b.circle([250.0, 880.0], 120.0, PALE, INK, 4.0);\n        b.circle([250.0 + self.lean_now.x * 120.0, 880.0 - self.lean_now.y * 120.0], 22.0, CORAL, WHITE, 3.0);\n    }\n\n    fn draw_world_layer(&self, b: &mut B, sim: &Sim) {\n        if let Some(a) = &self.attract {\n            if a.idx == 0 || a.idx == ATTRACT.len() + 1 {\n                self.draw_logo(b);\n            }\n            if let Some(r) = &self.run {\n                r.draw_hud(b, &self.rules);\n                b.title(960.0, 60.0, 72.0, TEAL, r.name());\n            }\n            b.flat([0.0, 0.0, 300.0, 76.0], CORAL, 18.0);\n            b.text(40.0, 14.0, 44.0, WHITE, \"DEMO\");\n            if self.touch_only {\n                self.draw_touch_card(b);\n            } else {\n                b.flat([660.0, 980.0, 1260.0, 1050.0], [255, 255, 255, 220], 34.0);\n                b.center(960.0, 990.0, 42.0, INK, \"Press any button\");\n            }\n            return;\n        }\n        match self.mode {\n            Mode::Title | Mode::Setup => {\n                if self.menus.last().is_none_or(|m| matches!(m.kind, MenuKind::Title)) {\n                    self.draw_logo(b);\n                }\n            }\n            Mode::Island => self.draw_island_hud(b, sim),\n            Mode::Check => {\n                if let Some(c) = &self.check {\n                    if self.menus.is_empty() {\n                        c.hud(b, &self.check_core);\n                    }\n                }\n            }\n            Mode::Report => self.draw_report(b),\n            Mode::Run => self.draw_run(b),\n            Mode::Stamp => self.draw_calendar(b, true),\n            Mode::Ending => {\n                let t = if self.ended_well { \"Checked Out\" } else { \"Extended Stay\" };\n                b.title(960.0, 120.0, 110.0, WHITE, t);\n                let sub = if self.ended_well { \"The rowboat is free. The Clam keeps your minutes.\" } else { \"Your room has been kept. It was never let go.\" };\n                b.center(960.0, 260.0, 48.0, WHITE, sub);\n            }\n            Mode::Credits => self.draw_credits(b),\n            Mode::PassPad => {\n                let m = self.medley.as_ref();\n                let name = m.and_then(|m| m.racers.get(m.who)).map(|r| r.name.clone()).unwrap_or_default();\n                b.tint([214, 238, 246, 120]);\n                b.card([360.0, 300.0, 1560.0, 780.0], DECK);\n                b.title(960.0, 340.0, 96.0, TEAL, \"Pass the Controller\");\n                b.center(960.0, 490.0, 60.0, INK, &format!(\"{name}, it is your turn.\"));\n                b.center(960.0, 570.0, 40.0, MUTED, \"The others will watch. They have nothing else to do.\");\n                b.prompt_center(960.0, 680.0, &[Glyph::Confirm], \"Ready\");\n            }\n            Mode::Podium => self.draw_podium(b),\n            Mode::HubDone => {\n                b.tint([214, 238, 246, 120]);\n                b.card([460.0, 360.0, 1460.0, 720.0], DECK);\n                b.title(960.0, 400.0, 96.0, TEAL, \"Finished\");\n                b.center(960.0, 530.0, 56.0, INK, &format!(\"{} points of balance\", self.medley_total()));\n                b.center(960.0, 610.0, 40.0, MUTED, \"Please stand by. Standing is what we do.\");\n            }\n        }\n    }\n\n    fn draw_touch_card(&self, b: &mut B) {\n        b.tint([214, 238, 246, 60]);\n        b.card([460.0, 330.0, 1460.0, 750.0], DECK);\n        b.title(960.0, 370.0, 64.0, TEAL, \"Controller or keyboard required\");\n        b.center(960.0, 480.0, 40.0, INK, \"Please connect one, and stand by.\");\n        b.items.push(Ui::Button { id: 900, rect: [710.0, 580.0, 1210.0, 700.0], label: \"Settings\".into(), sub: String::new(), focused: true, stars: -1, value: String::new(), fill: None, big: true });\n    }\n\n    fn draw_logo(&self, b: &mut B) {\n        b.title(960.0, 90.0, 170.0, WHITE, TITLE);\n        b.title(956.0, 86.0, 170.0, TEAL, TITLE);\n        b.center(960.0, 280.0, 50.0, INK, TAGLINE);\n        if self.touch_only && self.attract.is_none() {\n            self.draw_touch_card(b);\n        }\n    }\n\n    fn draw_island_hud(&self, b: &mut B, sim: &Sim) {\n        let Some(g) = self.guest() else { return };\n        let (w, h) = (640.0, 140.0);\n        b.flat([30.0, 30.0, 30.0 + w, 30.0 + h], [255, 255, 255, 225], 34.0);\n        if g.free_play {\n            b.title_left(60.0, 44.0, 64.0, TEAL, \"Free Play\");\n            b.text(350.0, 62.0, 40.0, INK, &format!(\"{} stars\", g.total_stars()));\n        } else {\n            b.title_left(60.0, 44.0, 64.0, TEAL, &format!(\"Day {}\", g.day));\n            if let Some(goal) = self.day_goal() {\n                b.text(240.0, 48.0, 40.0, INK, &format!(\"{} of {goal} minutes\", g.minutes));\n                b.bar([240.0, 110.0, 640.0, 140.0], (g.minutes as f32 / goal.max(1) as f32).min(1.0), MINT, None);\n            } else {\n                b.text(240.0, 62.0, 40.0, INK, \"The Big Stand\");\n            }\n        }\n        if let Some(a) = g.age() {\n            b.flat([1550.0, 30.0, 1890.0, 170.0], [255, 255, 255, 225], 34.0);\n            b.right(1860.0, 40.0, 36.0, MUTED, \"Balance Age\");\n            b.items.push(Ui::Text { pos: [1860.0, 76.0], size: 78.0, color: INK, align: 2, title: true, text: a.to_string(), wrap: 0.0 });\n        }\n        if let Some((_, at, label)) = &self.near {\n            b.items.push(Ui::WorldPrompt { at: (*at + Vec3::Y * 2.0).to_array(), glyph: Glyph::Confirm, label: label.clone() });\n        }\n        if let Some((m, _)) = &self.msg {\n            b.flat([360.0, 200.0, 1560.0, 280.0], [255, 255, 255, 225], 34.0);\n            b.center(960.0, 214.0, 40.0, INK, m);\n        }\n        if self.dialog.is_none() {\n            b.prompt(50.0, 1000.0, &[Glyph::Move], \"Walk\");\n            b.prompt(350.0, 1000.0, &[Glyph::Jog], \"Jog\");\n            b.prompt(640.0, 1000.0, &[Glyph::Wave], \"Wave\");\n            b.prompt(950.0, 1000.0, &[Glyph::Schedule], \"Schedule\");\n            b.prompt(1330.0, 1000.0, &[Glyph::Camera], \"Camera\");\n            b.prompt(1650.0, 1000.0, &[Glyph::Pause], \"Pause\");\n        }\n        let _ = sim;\n    }\n\n    fn draw_report(&self, b: &mut B) {\n        b.tint([214, 238, 246, 140]);\n        b.card([460.0, 110.0, 1460.0, 720.0], DECK);\n        b.center(960.0, 140.0, 54.0, INK, \"Your Balance Age\");\n        let t = self.report.t;\n        let shown = if t < 3.0 { 18 + ((t * 31.0) as i32 * 7) % 80 } else { self.report.age };\n        b.items.push(Ui::Text { pos: [960.0, 210.0], size: 260.0, color: if t < 3.0 { MUTED } else { TEAL }, align: 1, title: true, text: shown.to_string(), wrap: 0.0 });\n        if t >= 3.0 {\n            let ages = self.guest().map(|g| g.ages.clone()).unwrap_or_default();\n            for k in 0..5 {\n                let x = 720.0 + k as f32 * 120.0;\n                let got = ages.get(k).copied();\n                let y = got.map(|a| 620.0 - (80 - a.clamp(20, 80)) as f32 * 1.3).unwrap_or(620.0);\n                b.circle([x, y], 26.0, if got.is_some() { CORAL } else { PALE }, WHITE, 5.0);\n            }\n        }\n    }\n\n    fn draw_run(&self, b: &mut B) {\n        let Some(r) = &self.run else { return };\n        match r.phase {\n            Phase::Card => {\n                let coach = r.kind.map(|k| k.coach()).unwrap_or(PIP);\n                let pick = (self.tick / 600) as u32;\n                let line = script::line(r.kind.map(|k| [\"coach_0\", \"coach_1\", \"coach_2\", \"coach_3\"][k.pavilion()]).unwrap_or(\"finale_card\"), pick);\n                let how = run::how_to(r.kind);\n                let who = script::SPEAKERS[coach as usize];\n                r.draw_card(b, r.name(), run::goal(r.kind), &line, who, &how);\n            }\n            Phase::Count => {\n                r.draw_hud(b, &self.rules);\n                if !self.hub || self.hub_go {\n                    let n = (3.0 - r.t).ceil().max(1.0) as u32;\n                    b.circle([960.0, 480.0], 150.0, [255, 255, 255, 230], TEAL, 12.0);\n                    b.title(960.0, 370.0, 170.0, TEAL, &n.to_string());\n                } else {\n                    b.center(960.0, 480.0, 60.0, INK, \"Waiting for the others\");\n                }\n                b.title(960.0, 200.0, 80.0, INK, r.name());\n            }\n            Phase::Play => {\n                r.draw_hud(b, &self.rules);\n                if let Some((m, _)) = &r.msg {\n                    if r.kind != Some(EvKind::Step) {\n                        b.flat([360.0, 820.0, 1560.0, 900.0], [255, 255, 255, 225], 36.0);\n                        b.center(960.0, 836.0, 40.0, INK, m);\n                    } else {\n                        b.center(960.0, 300.0, 40.0, INK, m);\n                    }\n                }\n                if self.hub || r.ctx == RunCtx::Medley {\n                    b.right(1860.0, 30.0, 40.0, INK, &format!(\"Total {}\", self.medley_total()));\n                }\n                if self.dev.freeze {\n                    b.center(960.0, 60.0, 44.0, CORAL, \"Frozen: Dev Mode, Time\");\n                }\n            }\n            Phase::Result => {}\n        }\n    }\n\n    fn draw_calendar(&self, b: &mut B, stamping: bool) {\n        let Some(g) = self.guest() else { return };\n        b.tint([214, 238, 246, 170]);\n        b.card([200.0, 150.0, 1720.0, 800.0], DECK);\n        b.title(960.0, 180.0, 96.0, TEAL, \"Your Stay\");\n        for k in 0..5u8 {\n            let x = 340.0 + k as f32 * 310.0;\n            b.flat([x - 120.0, 320.0, x + 120.0, 640.0], WHITE, 24.0);\n            b.flat([x - 120.0, 320.0, x + 120.0, 380.0], CORAL, 24.0);\n            b.center(x, 328.0, 40.0, WHITE, &format!(\"Day {}\", k + 1));\n            if let Some(a) = g.ages.get(k as usize) {\n                b.center(x, 580.0, 36.0, MUTED, &format!(\"Age {a}\"));\n            }\n            if k < g.stamps {\n                let fresh = stamping && k + 1 == g.stamps;\n                let r = if fresh { 90.0 + 300.0 * (1.0 - (self.mode_t * 5.0).min(1.0)) } else { 90.0 };\n                b.circle([x, 480.0], r, [0, 0, 0, 0], TEAL, 14.0);\n                b.items.push(Ui::Text { pos: [x, 415.0], size: 64.0, color: TEAL, align: 1, title: true, text: \"OK\".into(), wrap: 0.0 });\n            }\n        }\n        if g.real_stamps > 0 {\n            b.center(960.0, 680.0, 40.0, INK, &format!(\"Real days stamped since: {}\", g.real_stamps));\n        }\n    }\n\n    fn draw_credits(&self, b: &mut B) {\n        b.tint([20, 34, 48, 170]);\n        let lines = [\n            (true, TITLE),\n            (false, TAGLINE),\n            (false, \"\"),\n            (false, \"Pip, front desk and records\"),\n            (false, \"Posey, stillness\"),\n            (false, \"Big Kettle, strength\"),\n            (false, \"Bounce, cardio\"),\n            (false, \"Commodore Gull, lagoon and snacks\"),\n            (false, \"Marjorie, Day 5, eleven years\"),\n            (false, \"Two-Towel Tom, flip-flops\"),\n            (false, \"The Twins, the twins\"),\n            (false, \"\"),\n            (false, \"Free Play is now open. It always was.\"),\n        ];\n        let scroll = self.mode_t * 70.0;\n        for (i, (title, text)) in lines.iter().enumerate() {\n            let y = 1000.0 + i as f32 * 90.0 - scroll;\n            if !(-120.0..=1100.0).contains(&y) || text.is_empty() {\n                continue;\n            }\n            if *title {\n                b.title(960.0, y, 110.0, WHITE, text);\n            } else {\n                b.center(960.0, y, 50.0, WHITE, text);\n            }\n        }\n    }\n\n    fn draw_podium(&self, b: &mut B) {\n        let Some(m) = &self.medley else { return };\n        let mut rows: Vec<(String, u32, usize)> = m.racers.iter().enumerate().map(|(i, r)| (r.name.clone(), r.scores.iter().sum(), i)).collect();\n        rows.sort_by(|a, b| b.1.cmp(&a.1));\n        b.tint([214, 238, 246, 120]);\n        b.card([360.0, 60.0, 1560.0, 760.0], DECK);\n        b.title(960.0, 90.0, 96.0, TEAL, \"The Podium\");\n        for (i, (name, score, _)) in rows.iter().enumerate() {\n            let y = 240.0 + i as f32 * 110.0;\n            b.text(460.0, y, 60.0, if i == 0 { CORAL } else { INK }, &format!(\"{}. {name}\", i + 1));\n            b.right(1460.0, y, 60.0, INK, &score.to_string());\n        }\n    }\n\n    fn draw_menu(&self, b: &mut B, m: &Menu, sim: &Sim) {\n        let items = self.menu_items(m);\n        let mut top = 300.0;\n        let title = match m.kind {\n            MenuKind::Title => {\n                top = 380.0;\n                \"\"\n            }\n            MenuKind::Slot => \"Sign the Guest Book\",\n            MenuKind::Continue => \"Who Is Still Here?\",\n            MenuKind::Overwrite(_) => \"Someone Is Staying There\",\n            MenuKind::Name => \"What Do We Call You?\",\n            MenuKind::Look => \"How Do You Look?\",\n            MenuKind::Pause => \"Paused\",\n            MenuKind::Hub => \"Paused\",\n            MenuKind::Settings => \"Settings\",\n            MenuKind::ResetConfirm => \"Reset Everything?\",\n            MenuKind::Schedule => \"Schedule\",\n            MenuKind::Calendar => \"\",\n            MenuKind::Wardrobe => \"Wardrobe\",\n            MenuKind::HowTo => \"How to Play\",\n            MenuKind::About => \"About\",\n            MenuKind::Dev => \"Dev Mode\",\n            MenuKind::Result => \"\",\n            MenuKind::Together => \"Play Together\",\n            MenuKind::Podium => \"\",\n        };\n        // A wash over the world, except where the figure shows.\n        match m.kind {\n            MenuKind::Title | MenuKind::Look | MenuKind::Wardrobe | MenuKind::Result | MenuKind::Podium | MenuKind::Calendar => {}\n            _ => b.tint([214, 238, 246, 150]),\n        }\n        let (mut x0, mut x1) = (460.0, 1460.0);\n        if matches!(m.kind, MenuKind::Look | MenuKind::Wardrobe) {\n            x0 = 1000.0;\n            x1 = 1860.0;\n        }\n        match m.kind {\n            MenuKind::Calendar => {\n                self.draw_calendar(b, false);\n                top = 840.0;\n                x0 = 760.0;\n                x1 = 1160.0;\n            }\n            MenuKind::Result => {\n                self.draw_result(b);\n                top = 760.0;\n                x0 = 560.0;\n                x1 = 1360.0;\n            }\n            MenuKind::Podium => {\n                self.draw_podium(b);\n                top = 800.0;\n            }\n            MenuKind::HowTo | MenuKind::About => {\n                b.card([120.0, 30.0, 1800.0, 1050.0], DECK);\n                let pages: Vec<(String, Vec<String>)> = if m.kind == MenuKind::HowTo {\n                    HOW_TO.iter().map(|p| (p.0.to_string(), p.1.iter().map(|s| s.to_string()).collect())).collect()\n                } else {\n                    self.about_pages()\n                };\n                let page = pages.get(m.tab);\n                if let Some((t, lines)) = page {\n                    b.title(960.0, 60.0, 80.0, TEAL, t);\n                    let mut y = 200.0;\n                    for l in lines {\n                        b.wrap(190.0, y, 1540.0, 38.0, INK, l);\n                        y += 56.0 * (l.len() as f32 / 72.0).ceil().max(1.0) + 14.0;\n                    }\n                }\n                b.prompt(190.0, 985.0, &[Glyph::Tabs], &format!(\"Page {} of {}\", m.tab + 1, pages.len().max(1)));\n                top = 960.0;\n                x0 = 1320.0;\n                x1 = 1730.0;\n            }\n            _ => {}\n        }\n        if !title.is_empty() {\n            b.title((x0 + x1) * 0.5, top - 200.0, 88.0, TEAL, title);\n        }\n        // Tabs.\n        let tabs = self.tabs_of(m);\n        if !tabs.is_empty() && !matches!(m.kind, MenuKind::HowTo | MenuKind::About) {\n            let w = 1760.0 / tabs.len() as f32;\n            for (i, t) in tabs.iter().enumerate() {\n                let x = 80.0 + i as f32 * w;\n                b.items.push(Ui::Button { id: 1000 + i as u16, rect: [x + 6.0, top - 110.0, x + w - 6.0, top - 30.0], label: t.clone(), sub: String::new(), focused: i == m.tab, stars: -1, value: String::new(), fill: None, big: false });\n            }\n            top += 10.0;\n        }\n        // Rows: six in view.\n        let row = if matches!(m.kind, MenuKind::Schedule) { 120.0 } else { 104.0 };\n        for (i, it) in items.iter().enumerate().skip(m.scroll).take(6) {\n            let y = top + (i - m.scroll) as f32 * row;\n            b.items.push(Ui::Button { id: i as u16, rect: [x0, y, x1, y + row - 14.0], label: it.label.clone(), sub: it.sub.clone(), focused: i == m.focus, stars: it.stars, value: it.value.clone(), fill: it.fill, big: false });\n        }\n        if items.len() > 6 {\n            let frac = (m.scroll as f32 / (items.len() - 6) as f32).clamp(0.0, 1.0);\n            b.bar([x1 + 20.0, top, x1 + 40.0, top + row * 6.0 - 14.0], frac, TEAL, Some(frac));\n        }\n        // What the keys do here.\n        if !matches!(m.kind, MenuKind::Title | MenuKind::HowTo | MenuKind::About) {\n            b.prompt(50.0, 1010.0, &[Glyph::Confirm], \"Choose\");\n            b.prompt(350.0, 1010.0, &[Glyph::Back], \"Back\");\n            if !tabs.is_empty() {\n                b.prompt(610.0, 1010.0, &[Glyph::Tabs], \"Tabs\");\n            }\n        }\n        let _ = sim;\n    }\n\n    fn draw_result(&self, b: &mut B) {\n        let Some(r) = self.run.as_ref().and_then(|r| r.result.as_ref()) else { return };\n        let name = self.run.as_ref().map(|r| r.name()).unwrap_or(\"\");\n        b.card([360.0, 40.0, 1560.0, 740.0], DECK);\n        b.center(960.0, 60.0, 44.0, MUTED, name);\n        b.items.push(Ui::Text { pos: [960.0, 100.0], size: 150.0, color: TEAL, align: 1, title: true, text: r.score.to_string(), wrap: 0.0 });\n        b.stars(960.0, 310.0, 62.0, r.stars, 3);\n        b.title(960.0, 370.0, 64.0, CORAL, &r.title);\n        let mut bits = vec![if r.minutes > 0 { format!(\"{} minutes banked\", r.minutes) } else { String::new() }];\n        bits.push(if r.new_best { \"A new best\".to_string() } else { format!(\"Best {}\", r.best) });\n        if let Some(y) = r.yesterday {\n            bits.push(if y >= 0 { format!(\"{y} ahead of Yesterday You\") } else { format!(\"{} behind Yesterday You\", -y) });\n        }\n        let line: Vec<String> = bits.into_iter().filter(|s| !s.is_empty()).collect();\n        b.center(960.0, 470.0, 40.0, INK, &line.join(\". \"));\n        b.wrap_center(960.0, 560.0, 1080.0, 42.0, INK, &format!(\"Pip: \\\"{}\\\"\", r.comment));\n    }\n}\nRS\npython3 - <<'PY'\np='engine/crates/pav_core/src/games/fit/mod.rs'\ns=open(p).read()\ns=s.replace('''    /// Said when the result screen is dismissed.\n    pub pending: Option<Dialog>,\n}''','''    /// Said when the result screen is dismissed.\n    pub pending: Option<Dialog>,\n    /// Dev Mode's Win and Lose Now.\n    pub forced_score: Option<u32>,\n    /// The intro is running: the first morning follows it.\n    pub pending_begin: bool,\n}''')\ns=s.replace('''        pending: None,\n    };''','''        pending: None,\n        forced_score: None,\n        pending_begin: false,\n    };''')\ns=s.replace('''        let score = run.live_score(&self.rules);\n        run.score = score;''','''        let score = self.forced_score.unwrap_or_else(|| run.live_score(&self.rules));\n        run.score = score;''')\ns=s.replace('''            After::Nothing => {}\n            After::StartCheck''','''            After::Nothing => {\n                if std::mem::take(&mut self.pending_begin) {\n                    self.begin_day(sim, ev);\n                }\n            }\n            After::StartCheck''')\nopen(p,'w').write(s)\np='engine/crates/pav_core/src/games/fit/ui_model.rs'\ns=open(p).read()\ns=s.replace('''    /// The input viewer and the dev overlay.\n    pub dev_overlay: bool,\n}''','''    /// The input viewer and the dev overlay.\n    pub dev_overlay: bool,\n    /// How hard the pad should rumble now (0..1): Eyes Closed.\n    pub rumble: f32,\n}''')\nopen(p,'w').write(s)\nPY\ncat > $F/script.toml <<'EOF'\nnames = [\"placeholder-replaced-below\"]\ntitles = [\"x\"]\n[lines]\nEOF\ncd engine && CARGO_BUILD_JOBS=8 cargo check --locked -p pav_core 2>&1 | grep -E \"^(error|warning: unused)|^  -->|^error\" | head -60","description":"Write island, bot and menus, then type-check the game","timeout":300000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":30745,"cache_read_input_tokens":384020,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":30745},"output_tokens":75,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cb437ba7-0477-4143-bb04-ff33f49efd62","uuid":"991d4871-2880-4679-83e8-e08290edb06e","timestamp":"2026-11-05T06:09:22.604Z","request_id":"req_011CgjH4aP8zFWXTkWs4zRy6","wire_tool_inputs":{"toolu_01AbAeYLdWr3yZ7i6UhEDjcF":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953\nF=engine/crates/pav_core/src/games/fit\ncat > $F/island.rs <<'RS'\n//! Free time on Tippy Cay: walking, talking, finding flip-flops, stepping on mats. And the bot that\n//! plays the whole game, menus included.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::dialog::{After, Dialog};\nuse super::events::*;\nuse super::menus::{Act, Menu, MenuKind};\nuse super::run::{Phase, RunCtx};\nuse super::script::{self, *};\nuse super::*;\nuse crate::input::{InputFrame, UiEvent, buttons as btn};\n\n#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]\npub enum Interact {\n    Mat(EvKind),\n    Stand,\n    Pip,\n    Clam,\n    Calendar,\n    Wardrobe,\n    Cabana,\n    Npc(u8),\n}\n\nconst REACH: f32 = 1.9;\n\nimpl FitGame {\n    /// Everything on the island you can use, with where it is and what the prompt says.\n    pub fn island_spots(&self, sim: &Sim) -> Vec<(Interact, Vec3, String)> {\n        let s = &self.spots;\n        let mut v = vec![\n            (Interact::Pip, s.get(HUB, \"pip\"), \"Talk to Pip\".to_string()),\n            (Interact::Clam, s.get(HUB, \"clam\"), \"Minute Clam\".to_string()),\n            (Interact::Calendar, s.get(HUB, \"calendar\"), \"Calendar\".to_string()),\n            (Interact::Cabana, s.get(HUB, \"cabana\"), \"Sleep\".to_string()),\n        ];\n        if self.guest().is_some_and(|g| g.day >= 2 || g.free_play) {\n            v.push((Interact::Wardrobe, s.get(HUB, \"wardrobe\"), \"Wardrobe\".to_string()));\n        }\n        for k in ALL_EVENTS {\n            let label = if self.event_open(k) { k.name().to_string() } else { format!(\"Opens on Day {}\", k.day()) };\n            v.push((Interact::Mat(k), s.get(HUB, &format!(\"mat_{}\", k.key())), label));\n        }\n        v.push((Interact::Stand, s.get(HUB, \"mat_bigstand\"), if self.stand_open() { \"The Big Stand\".to_string() } else { \"Opens on Day 5\".to_string() }));\n        // The cast, wherever they have wandered.\n        let npcs = [(\"posey\", POSEY), (\"kettle\", KETTLE), (\"bounce\", BOUNCE), (\"marjorie\", MARJORIE), (\"tom\", TOM), (\"twin\", TWINS), (\"guest\", GUEST)];\n        let (lo, hi) = (s.get(HUB, \"arrive\").x - 60.0, s.get(HUB, \"arrive\").x + 60.0);\n        for e in sim.state.entities.iter() {\n            if e.pos.x < lo || e.pos.x > hi {\n                continue;\n            }\n            if let Some((_, who)) = npcs.iter().find(|(n, _)| *n == e.name) {\n                if let Some(f) = sim.feet(e.id) {\n                    v.push((Interact::Npc(*who), f, format!(\"Talk to {}\", script::SPEAKERS[*who as usize])));\n                }\n            }\n        }\n        v.push((Interact::Npc(GULL), s.get(HUB, \"gull\"), \"Talk to the Commodore\".to_string()));\n        v\n    }\n\n    pub fn island_tick(&mut self, sim: &mut Sim, input: &InputFrame, dt: f32, ev: &mut Vec<SimEvent>) {\n        let Some(pid) = sim.state.player else { return };\n        let Some(feet) = sim.feet(pid) else { return };\n        // The first entry of a morning: the story beat is told once by `After::IslandDay`.\n        let spots = self.island_spots(sim);\n        let near = spots.iter().filter(|(_, p, _)| flat(*p - feet) < REACH).min_by(|a, b| flat(a.1 - feet).total_cmp(&flat(b.1 - feet))).cloned();\n        self.near = near.clone();\n        // Hand input.\n        let stick = input.move_dir;\n        if stick.length() > 0.05 {\n            self.walk_path.clear();\n            self.walk_then = None;\n            let jog = input.down(btn::SPRINT);\n            self.move_dir = stick.clamp_length_max(1.0) * if jog { 1.0 } else { 0.62 };\n        }\n        // Mouse: click a thing or the ground, and walk there.\n        if input.just(btn::PRIMARY) {\n            if let Some(aim) = input.aim {\n                let hit = spots.iter().filter(|(_, p, _)| flat(*p - aim) < 1.2).min_by(|a, b| flat(a.1 - aim).total_cmp(&flat(b.1 - aim))).cloned();\n                let goal = hit.as_ref().map(|h| h.1).unwrap_or(aim);\n                if self.nav.is_none() {\n                    self.nav = crate::nav::NavGrid::for_room(sim).map(Arc::new);\n                }\n                self.walk_path = self.nav.as_ref().and_then(|n| n.path(feet, goal)).unwrap_or_else(|| vec![goal]);\n                self.walk_then = hit.map(|h| h.0);\n            }\n        } else if input.just(btn::CONFIRM) {\n            if let Some((what, _, _)) = near.clone() {\n                self.interact(sim, what, ev);\n                return;\n            }\n        }\n        if !self.walk_path.is_empty() {\n            let to = self.walk_path[0];\n            if flat(to - feet) < 0.5 {\n                self.walk_path.remove(0);\n            } else {\n                let d = Vec2::new(to.x - feet.x, to.z - feet.z);\n                self.move_dir = d.normalize_or_zero() * 0.8;\n            }\n            if let Some(what) = self.walk_then {\n                let there = spots.iter().find(|s| s.0 == what).map(|s| s.1);\n                if there.is_some_and(|p| flat(p - feet) < REACH * 0.8) {\n                    self.walk_path.clear();\n                    self.walk_then = None;\n                    self.interact(sim, what, ev);\n                    return;\n                }\n            }\n        }\n        self.wave_cool = (self.wave_cool - dt).max(0.0);\n        if input.just(btn::WAVE) && self.wave_cool <= 0.0 {\n            self.wave_cool = 2.0;\n            let id = crate::clips::find_cached(\"CMU/Wave_Hello\");\n            if let Some(ch) = sim.state.entities.get_mut(pid).and_then(|e| e.character.as_mut()) {\n                ch.anim.replay_clip(id, crate::clips::ONCE | crate::clips::UPPER, 1.0);\n            }\n            if let Some((Interact::Npc(who), _, _)) = spots.iter().filter(|(_, p, _)| flat(*p - feet) < 5.0).min_by(|a, b| flat(a.1 - feet).total_cmp(&flat(b.1 - feet))) {\n                let n = sim.state.rng.next_u32();\n                self.msg = Some((format!(\"{}: {}\", script::SPEAKERS[*who as usize], script::line(\"wave_back\", n)), 3.0));\n                ev.push(SimEvent::Syllable { speaker: *who, vowel: 1, pitch: 1.1 });\n            }\n        }\n        if input.just(btn::SCHEDULE) {\n            self.menus.push(Menu::new(MenuKind::Schedule));\n            ev.push(SimEvent::Sfx { id: sfx::CONFIRM, gain: 0.5, pitch: 1.1 });\n            return;\n        }\n        // Lost flip-flops.\n        for k in 0..5 {\n            let done = self.guest().is_some_and(|g| g.flops[k]);\n            if done {\n                continue;\n            }\n            if let Some(id) = self.flop_ids[k] {\n                if sim.state.entities.get(id).is_some_and(|e| flat(e.pos - feet) < 1.2) {\n                    if let Some(e) = sim.state.entities.get_mut(id) {\n                        e.pos.y = -9.0;\n                    }\n                    self.guest_mut().flops[k] = true;\n                    let n = self.guest().map(|g| g.flops.iter().filter(|f| **f).count()).unwrap_or(0);\n                    self.msg = Some((format!(\"A lost flip-flop. That makes {n} of 5.\"), 3.0));\n                    ev.push(SimEvent::Sfx { id: sfx::POP, gain: 0.8, pitch: 1.3 });\n                    self.store();\n                }\n            }\n        }\n        if let Some((_, left)) = &mut self.msg {\n            *left -= dt;\n        }\n        self.msg = self.msg.take().filter(|m| m.1 > 0.0);\n    }\n\n    pub fn keep_on_land(&mut self, sim: &mut Sim) {\n        let Some(pid) = sim.state.player else { return };\n        let Some(f) = sim.feet(pid) else { return };\n        let c = self.spots.get(HUB, \"arrive\") + Vec3::new(0.0, 0.0, 2.0);\n        // Tiles are grass and sand out to about 33 m by 25 m; further, the sea politely declines.\n        let (dx, dz) = ((f.x - c.x).abs(), (f.z - c.z).abs());\n        let (ox, oz) = ((dx - 23.0).max(0.0), (dz - 15.0).max(0.0));\n        let out = Vec2::new(ox, oz).length();\n        let pier = (f.x - c.x).abs() < 2.2 && f.z > c.z;\n        if out > 10.2 && !pier {\n            let back = Vec2::new(c.x - f.x, c.z - f.z).normalize_or_zero();\n            sim.set_position(pid, f + Vec3::new(back.x, 0.0, back.y) * 0.4);\n            if self.msg.is_none() {\n                self.msg = Some((\"Pip: Please do not swim. The sea is not on your schedule.\".into(), 2.5));\n            }\n        }\n    }\n\n    pub fn interact(&mut self, sim: &mut Sim, what: Interact, ev: &mut Vec<SimEvent>) {\n        let n = sim.state.rng.next_u32();\n        let (day, free) = self.guest().map(|g| (g.day, g.free_play)).unwrap_or((1, false));\n        match what {\n            Interact::Mat(k) => {\n                if self.event_open(k) {\n                    self.start_event(sim, k, RunCtx::Stay, ev);\n                } else {\n                    let mut d = Dialog::new(After::Nothing);\n                    d.push(PIP, format!(\"{} opens on Day {}. It is resting. Please do not wake it.\", k.name(), k.day()));\n                    self.dialog = Some(d);\n                }\n            }\n            Interact::Stand => {\n                if self.stand_open() {\n                    self.start_finale(sim, 0, ev);\n                } else {\n                    let mut d = Dialog::new(After::Nothing);\n                    d.push(MARJORIE, script::line(\"marjorie_stand\", n));\n                    self.dialog = Some(d);\n                }\n            }\n            Interact::Pip => {\n                let mut d = Dialog::new(After::Nothing);\n                match self.day_goal() {\n                    Some(goal) if self.goal_met() => {\n                        d.push(PIP, format!(\"You have banked your {goal} minutes. Your cabana is that way. It has been waiting.\"));\n                    }\n                    Some(goal) => {\n                        let have = self.guest().map(|g| g.minutes).unwrap_or(0);\n                        d.push(PIP, format!(\"You have {have} minutes of {goal}. {}\", script::line(\"pip_idle\", n)));\n                    }\n                    None if free => d.push(PIP, script::line(\"pip_free\", n)),\n                    None => d.push(PIP, \"Today is the Big Stand. It is on the sand by the pier. Everyone will be there. They have rafts.\".to_string()),\n                }\n                self.dialog = Some(d);\n            }\n            Interact::Clam => {\n                ev.push(SimEvent::Sfx { id: sfx::GULP, gain: 0.9, pitch: 1.0 });\n                ev.push(SimEvent::Sfx { id: sfx::BURP, gain: 0.8, pitch: 1.0 });\n                let total = self.guest().map(|g| g.total_minutes).unwrap_or(0);\n                let next = meta::HATS.iter().map(|h| h.1).chain(meta::EXTRAS.iter().map(|e| e.1)).filter(|m| *m > total).min();\n                let mut d = Dialog::new(After::Nothing);\n                d.push(PIP, format!(\"The Clam holds {total} of your minutes. Our minutes are longer. It is a wellness thing.\"));\n                match next {\n                    Some(m) => d.push(PIP, format!(\"At {m} it may give something back. It has not decided.\")),\n                    None => d.push(PIP, \"It has given you everything. It looks tired. It is a clam.\".to_string()),\n                }\n                self.dialog = Some(d);\n            }\n            Interact::Calendar => self.menus.push(Menu::new(MenuKind::Calendar)),\n            Interact::Wardrobe => self.menus.push(Menu::new(MenuKind::Wardrobe)),\n            Interact::Cabana => {\n                if self.goal_met() {\n                    let mut d = Dialog::new(After::EndDay);\n                    d.push(PIP, script::line(\"pip_sleep\", n));\n                    self.dialog = Some(d);\n                } else {\n                    let mut d = Dialog::new(After::Nothing);\n                    match self.day_goal() {\n                        Some(goal) => {\n                            let have = self.guest().map(|g| g.minutes).unwrap_or(0);\n                            d.push(PIP, format!(\"You are not tired yet. I checked. You have {have} minutes of {goal}.\"));\n                        }\n                        None => d.push(PIP, \"The bed is made. It will stay made. Enjoy the island.\".to_string()),\n                    }\n                    self.dialog = Some(d);\n                }\n            }\n            Interact::Npc(who) => {\n                let mut d = Dialog::new(After::Nothing);\n                if who == TOM {\n                    self.tom_talk(&mut d, n, ev, sim);\n                } else {\n                    let key = match who {\n                        POSEY => \"coach_0\".to_string(),\n                        KETTLE => \"coach_1\".to_string(),\n                        BOUNCE => \"coach_2\".to_string(),\n                        GULL => \"coach_3\".to_string(),\n                        MARJORIE => format!(\"marjorie_{}\", day.min(5)),\n                        TWINS => \"twins\".to_string(),\n                        _ => \"guests\".to_string(),\n                    };\n                    d.push(who, script::line(&key, n));\n                }\n                self.dialog = Some(d);\n            }\n        }\n    }\n\n    fn tom_talk(&mut self, d: &mut Dialog, n: u32, ev: &mut Vec<SimEvent>, sim: &mut Sim) {\n        let g = self.guest_mut();\n        let found = g.flops.iter().filter(|f| **f).count();\n        if found == 5 && !g.tom_rewarded {\n            g.tom_rewarded = true;\n            g.wear.gold_shoes = true;\n            d.push(TOM, \"All five. I only have two feet. I do not know whose the others are.\");\n            d.push(TOM, \"Take these. They are gold. They were never comfortable.\");\n            ev.push(SimEvent::Sfx { id: sfx::FANFARE, gain: 0.8, pitch: 1.2 });\n            self.dress(sim);\n            self.store();\n        } else if found == 5 {\n            d.push(TOM, \"I have five flip-flops now. I am the richest man on this island.\");\n        } else {\n            d.push(TOM, format!(\"I have lost my flip-flops. All five. You have found {found}.\"));\n            d.push(TOM, script::line(\"tom\", n));\n        }\n    }\n\n    /// What a good player would press now, on every screen: `Game::bot`.\n    pub fn bot_input(&self, sim: &Sim) -> InputFrame {\n        let mut f = InputFrame::default();\n        if self.hub {\n            f.held |= btn::HUB_GO;\n        }\n        let t = self.tick;\n        let tap = |f: &mut InputFrame, b: u32| {\n            f.held |= b;\n            f.pressed |= b;\n        };\n        if self.attract.is_some() {\n            f.any = true;\n            return f;\n        }\n        if let Some(m) = self.menus.last() {\n            if t % 6 != 0 {\n                return f;\n            }\n            let items = self.menu_items(m);\n            let find = |want: &dyn Fn(&Act) -> bool| items.iter().position(|i| want(&i.act));\n            let choice = match m.kind {\n                MenuKind::Title => find(&|a| matches!(a, Act::NewStay)),\n                MenuKind::Slot | MenuKind::Name => Some(0),\n                MenuKind::Look => find(&|a| matches!(a, Act::Begin)),\n                MenuKind::Result => find(&|a| matches!(a, Act::Leave)),\n                MenuKind::Schedule => {\n                    // On the Today tab: end the day or go to the stand. Else the tab holding what's next.\n                    let next = self.bot_next_event();\n                    if self.goal_met() && next.is_none() || self.stand_open() {\n                        if m.tab != 4 {\n                            f.ui = Some(UiEvent::Click(1004));\n                            return f;\n                        }\n                        find(&|a| matches!(a, Act::EndDay | Act::GoStand))\n                    } else if let Some(k) = next {\n                        if m.tab != k.pavilion() {\n                            f.ui = Some(UiEvent::Click(1000 + k.pavilion() as u16));\n                            return f;\n                        }\n                        find(&|a| matches!(a, Act::GoEvent(e) if *e == k))\n                    } else {\n                        None\n                    }\n                }\n                _ => None,\n            };\n            match choice {\n                Some(i) => f.ui = Some(UiEvent::Click(i as u16)),\n                None => tap(&mut f, btn::BACK),\n            }\n            return f;\n        }\n        if self.dialog.is_some() {\n            if t % 3 == 0 {\n                tap(&mut f, btn::CONFIRM);\n            }\n            return f;\n        }\n        match self.mode {\n            Mode::Island => {\n                if t % 20 == 0 {\n                    tap(&mut f, btn::SCHEDULE);\n                }\n            }\n            Mode::Check => {\n                if let Some(c) = &self.check {\n                    apply_intent(&mut f, &c.bot(&self.check_core, &self.rules));\n                }\n            }\n            Mode::Run => {\n                if let Some(r) = &self.run {\n                    match r.phase {\n                        Phase::Card => {\n                            if t % 6 == 0 {\n                                tap(&mut f, btn::CONFIRM);\n                            }\n                        }\n                        Phase::Play => apply_intent(&mut f, &r.bot(&self.rules)),\n                        _ => {}\n                    }\n                }\n            }\n            Mode::Ending | Mode::Credits | Mode::PassPad => {\n                if t % 6 == 0 {\n                    tap(&mut f, btn::CONFIRM);\n                }\n            }\n            _ => {}\n        }\n        let _ = sim;\n        f\n    }\n\n    /// The next event the bot wants: today's own, not yet done.\n    pub fn bot_next_event(&self) -> Option<EvKind> {\n        let g = self.guest()?;\n        ALL_EVENTS.iter().copied().find(|k| k.day() == g.day && !g.done_today.contains(k.key()))\n    }\n}\n\npub fn apply_intent(f: &mut InputFrame, i: &Intent) {\n    f.lean = i.lean;\n    let mut set = |on: bool, just: bool, b: u32| {\n        if on || just {\n            f.held |= b;\n        }\n        if just {\n            f.pressed |= b;\n        }\n    };\n    set(i.act, i.act_p, btn::CONFIRM);\n    set(i.l, i.l_p, btn::STEP_L);\n    set(i.r, i.r_p, btn::STEP_R);\n}\n\nfn flat(v: Vec3) -> f32 {\n    Vec2::new(v.x, v.z).length()\n}\nRS\ncat > $F/menus.rs <<'RS'\n//! Every menu, one way: a menu is a list of items with actions. The same list drives pad, keys and\n//! pointer, and is what gets drawn. Layout is big rows, at most six in view.\n\nuse glam::Vec3;\nuse serde::{Deserialize, Serialize};\n\nuse super::events::*;\nuse super::island::Interact;\nuse super::meta::{self, Guest};\nuse super::run::{self, Phase, RunCtx};\nuse super::script::{self, PIP};\nuse super::*;\nuse crate::input::{InputFrame, UiEvent, buttons as btn};\nuse crate::params::{self, ParamValue};\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub enum MenuKind {\n    Title,\n    Slot,\n    Continue,\n    Overwrite(u8),\n    Name,\n    Look,\n    Pause,\n    Settings,\n    ResetConfirm,\n    Schedule,\n    Calendar,\n    Wardrobe,\n    HowTo,\n    About,\n    Dev,\n    Result,\n    Together,\n    Podium,\n    Hub,\n}\n\n#[derive(Clone, Copy, Debug, Serialize, Deserialize)]\npub struct Menu {\n    pub kind: MenuKind,\n    pub focus: usize,\n    pub tab: usize,\n    pub scroll: usize,\n    /// Which item the pointer last moved focus to, to tell a move from a resting pointer.\n    pub hover: i32,\n}\n\nimpl Menu {\n    pub fn new(kind: MenuKind) -> Self {\n        Self { kind, focus: 0, tab: 0, scroll: 0, hover: -1 }\n    }\n}\n\n#[derive(Clone, Debug, PartialEq)]\npub enum Act {\n    None,\n    Back,\n    NewStay,\n    ContinueMenu,\n    Together,\n    SettingsOpen,\n    AboutOpen,\n    Slot(usize),\n    ConfirmOverwrite(usize),\n    ContinueSlot(usize),\n    Name(usize),\n    Skin,\n    Outfit,\n    Begin,\n    Resume,\n    ScheduleOpen,\n    CalendarOpen,\n    WardrobeOpen,\n    HowToOpen,\n    DevOpen,\n    QuitTitle,\n    Setting(u8),\n    ResetAsk,\n    ResetYes,\n    GoEvent(EvKind),\n    GoStand,\n    EndDay,\n    Hat,\n    Extra,\n    Retry,\n    Leave,\n    TogetherN,\n    TogetherGo,\n    PodiumDone,\n    Fullscreen,\n    JumpDay(u8),\n    JumpEvent(EvKind),\n    JumpPhase(u32),\n    JumpAttract,\n    JumpMedley,\n    Toggle(u8),\n    GiveMinutes,\n    UnlockAll,\n    AllStars,\n    WinNow,\n    LoseNow,\n    TimeScale,\n    Step,\n    Group,\n    Param(String, f32, f32),\n    ResetGroup,\n    ResetAll,\n    ResetGuest,\n}\n\n#[derive(Clone, Debug)]\npub struct Item {\n    pub act: Act,\n    pub label: String,\n    pub sub: String,\n    pub value: String,\n    pub fill: Option<f32>,\n    pub stars: i8,\n}\n\nfn item(act: Act, label: impl Into<String>) -> Item {\n    Item { act, label: label.into(), sub: String::new(), value: String::new(), fill: None, stars: -1 }\n}\n\nconst SETTING_NAMES: [&str; 8] = [\"Music\", \"Sound Effects\", \"Voices\", \"Glyphs\", \"Lean Sensitivity\", \"Wobble Assist\", \"Rhythm Offset\", \"Text Speed\"];\n\npub fn screen_name(g: &FitGame) -> &'static str {\n    if g.attract.is_some() {\n        return \"attract\";\n    }\n    if let Some(m) = g.menus.last() {\n        return match m.kind {\n            MenuKind::Title => \"title\",\n            MenuKind::Slot | MenuKind::Continue | MenuKind::Overwrite(_) => \"slots\",\n            MenuKind::Name => \"name\",\n            MenuKind::Look => \"look\",\n            MenuKind::Pause => \"pause\",\n            MenuKind::Settings | MenuKind::ResetConfirm => \"settings\",\n            MenuKind::Schedule => \"schedule\",\n            MenuKind::Calendar => \"calendar\",\n            MenuKind::Wardrobe => \"wardrobe\",\n            MenuKind::HowTo => \"howto\",\n            MenuKind::About => \"about\",\n            MenuKind::Dev => \"dev\",\n            MenuKind::Result => \"result\",\n            MenuKind::Together => \"together\",\n            MenuKind::Podium => \"podium\",\n            MenuKind::Hub => \"pause\",\n        };\n    }\n    if g.dialog.is_some() {\n        return \"dialog\";\n    }\n    match g.mode {\n        Mode::Title | Mode::Setup => \"title\",\n        Mode::Island => \"island\",\n        Mode::Check => \"check\",\n        Mode::Report => \"report\",\n        Mode::Run => match g.run.as_ref().map(|r| r.phase) {\n            Some(Phase::Card) => \"card\",\n            Some(Phase::Count) => \"count\",\n            _ => \"event\",\n        },\n        Mode::Stamp => \"stamp\",\n        Mode::Ending => \"ending\",\n        Mode::Credits => \"credits\",\n        Mode::PassPad => \"passpad\",\n        Mode::Podium => \"podium\",\n        Mode::HubDone => \"hubdone\",\n    }\n}\n\nimpl FitGame {\n    pub fn menu_items(&self, m: &Menu) -> Vec<Item> {\n        let s = &self.save.settings;\n        let mut v = Vec::new();\n        match m.kind {\n            MenuKind::Title => {\n                v.push(item(Act::NewStay, \"New Stay\"));\n                if self.save.guests.iter().any(|g| g.is_some()) {\n                    v.push(item(Act::ContinueMenu, \"Continue\"));\n                }\n                v.push(item(Act::Together, \"Play Together\"));\n                v.push(item(Act::SettingsOpen, \"Settings\"));\n                v.push(item(Act::AboutOpen, \"About\"));\n            }\n            MenuKind::Slot => {\n                for i in 0..meta::SLOTS {\n                    let mut it = item(Act::Slot(i), format!(\"Guest Book, Line {}\", i + 1));\n                    if let Some(g) = &self.save.guests[i] {\n                        it.sub = guest_line(g);\n                    } else {\n                        it.sub = \"Empty. Nobody has signed here yet.\".into();\n                    }\n                    v.push(it);\n                }\n            }\n            MenuKind::Continue => {\n                for i in 0..meta::SLOTS {\n                    if let Some(g) = &self.save.guests[i] {\n                        let mut it = item(Act::ContinueSlot(i), g.name.clone());\n                        it.sub = guest_line(g);\n                        v.push(it);\n                    }\n                }\n            }\n            MenuKind::Overwrite(i) => {\n                v.push(item(Act::ConfirmOverwrite(i as usize), \"Yes. They have left.\"));\n                v.push(item(Act::Back, \"No. They are still here.\"));\n            }\n            MenuKind::Name => {\n                for (i, n) in script::script().names.iter().enumerate() {\n                    v.push(item(Act::Name(i), n.clone()));\n                }\n            }\n            MenuKind::Look => {\n                let mut sk = item(Act::Skin, \"Skin Tone\");\n                sk.value = format!(\"{} of {}\", self.look_skin + 1, meta::SKINS.len());\n                v.push(sk);\n                let mut ou = item(Act::Outfit, \"Outfit\");\n                ou.value = meta::OUTFITS[self.look_outfit as usize].0.to_string();\n                v.push(ou);\n                v.push(item(Act::Begin, \"Check In\"));\n            }\n            MenuKind::Pause => {\n                v.push(item(Act::Resume, \"Resume\"));\n                if !self.hub {\n                    if self.mode == Mode::Island {\n                        v.push(item(Act::ScheduleOpen, \"Schedule\"));\n                        v.push(item(Act::CalendarOpen, \"Calendar\"));\n                        if self.guest().is_some_and(|g| g.day >= 2 || g.free_play) {\n                            v.push(item(Act::WardrobeOpen, \"Wardrobe\"));\n                        }\n                    }\n                }\n                v.push(item(Act::SettingsOpen, \"Settings\"));\n                if !self.hub {\n                    v.push(item(Act::HowToOpen, \"How to Play\"));\n                    v.push(item(Act::AboutOpen, \"About\"));\n                    v.push(item(Act::DevOpen, \"Dev Mode\"));\n                    v.push(item(Act::QuitTitle, \"Quit to Title\"));\n                }\n            }\n            MenuKind::Hub => v.push(item(Act::Resume, \"Resume\")),\n            MenuKind::Settings => {\n                let vals = [s.music, s.sfx, s.voice, 0.0, s.lean_sensitivity / 2.0, s.wobble_assist, s.rhythm_offset / 0.3, s.text_speed / 3.0];\n                let tx = [\n                    pct(s.music),\n                    pct(s.sfx),\n                    pct(s.voice),\n                    (if s.xbox { \"Xbox\" } else { \"PlayStation\" }).to_string(),\n                    format!(\"{:.1}x\", s.lean_sensitivity),\n                    pct(s.wobble_assist),\n                    format!(\"{:.0} ms\", s.rhythm_offset * 1000.0),\n                    format!(\"{:.1}x\", s.text_speed),\n                ];\n                for i in 0..8 {\n                    let mut it = item(Act::Setting(i as u8), SETTING_NAMES[i]);\n                    it.value.clone_from(&tx[i]);\n                    if i != 3 {\n                        it.fill = Some(vals[i].clamp(0.0, 1.0));\n                    }\n                    v.push(it);\n                }\n                v.push(item(Act::Fullscreen, \"Fullscreen\"));\n                if !self.hub {\n                    v.push(item(Act::ResetAsk, \"Reset Save\"));\n                }\n                v.push(item(Act::Back, \"Back\"));\n            }\n            MenuKind::ResetConfirm => {\n                v.push(item(Act::ResetYes, \"Erase Everything. Pip Will Remember Anyway.\"));\n                v.push(item(Act::Back, \"Keep It\"));\n            }\n            MenuKind::Schedule => {\n                if m.tab < 4 {\n                    for k in ALL_EVENTS.iter().filter(|k| k.pavilion() == m.tab) {\n                        let open = self.event_open(*k);\n                        let mut it = item(if open { Act::GoEvent(*k) } else { Act::None }, k.name());\n                        if open {\n                            let best = self.guest().and_then(|g| g.bests.get(k.key())).copied().unwrap_or_default();\n                            it.stars = best.stars as i8;\n                            it.sub = if best.score > 0 { format!(\"Best {}\", best.score) } else { \"Not yet attempted. It knows.\".into() };\n                        } else {\n                            it.sub = format!(\"Opens on Day {}\", k.day());\n                        }\n                        v.push(it);\n                    }\n                } else {\n                    if self.stand_open() {\n                        v.push(item(Act::GoStand, \"The Big Stand\"));\n                    }\n                    if self.goal_met() {\n                        let mut it = item(Act::EndDay, \"End the Day\");\n                        it.sub = \"Your cabana has been waiting.\".into();\n                        v.push(it);\n                    } else if let Some(goal) = self.day_goal() {\n                        let mut it = item(Act::None, \"End the Day\");\n                        it.sub = format!(\"{} of {goal} minutes banked\", self.guest().map(|g| g.minutes).unwrap_or(0));\n                        v.push(it);\n                    }\n                    v.push(item(Act::CalendarOpen, \"Calendar\"));\n                }\n            }\n            MenuKind::Wardrobe => {\n                let (hat, extra, outfit) = self.guest().map(|g| (g.wear.hat, g.wear.extra, g.outfit)).unwrap_or((0, 0, 0));\n                let mut a = item(Act::Hat, \"Hat\");\n                a.value = meta::HATS[hat as usize].0.to_string();\n                a.sub = self.locked_hint(&meta::HATS);\n                v.push(a);\n                let mut b = item(Act::Extra, \"Extras\");\n                b.value = meta::EXTRAS[extra as usize].0.to_string();\n                b.sub = self.locked_hint(&meta::EXTRAS);\n                v.push(b);\n                let mut c = item(Act::Outfit, \"Outfit\");\n                c.value = meta::OUTFITS[outfit as usize].0.to_string();\n                v.push(c);\n                v.push(item(Act::Back, \"Back\"));\n            }\n            MenuKind::Calendar | MenuKind::HowTo | MenuKind::About => v.push(item(Act::Back, \"Back\")),\n            MenuKind::Result => {\n                if self.run.as_ref().is_some_and(|r| r.ctx != RunCtx::Finale) {\n                    v.push(item(Act::Retry, \"Retry\"));\n                }\n                v.push(item(Act::Leave, \"Back to the Island\"));\n            }\n            MenuKind::Together => {\n                let mut n = item(Act::TogetherN, \"Guests\");\n                n.value = format!(\"{}\", self.together_n);\n                v.push(n);\n                v.push(item(Act::TogetherGo, \"Begin the Inter-Resort Medley\"));\n                v.push(item(Act::Back, \"Back\"));\n            }\n            MenuKind::Podium => v.push(item(Act::PodiumDone, \"Back to the Title\")),\n            MenuKind::Dev => self.dev_items(m, &mut v),\n        }\n        v\n    }\n\n    fn locked_hint(&self, list: &[(&str, u32)]) -> String {\n        let total = self.guest().map(|g| g.total_minutes).unwrap_or(0);\n        match list.iter().filter(|x| x.1 > total).map(|x| x.1).min() {\n            Some(m) => format!(\"More at {m} minutes in the Clam (you have {total})\"),\n            None => \"Everything is unlocked. Nothing fits.\".into(),\n        }\n    }\n\n    fn dev_items(&self, m: &Menu, v: &mut Vec<Item>) {\n        let on = |b: bool| if b { \"On\" } else { \"Off\" }.to_string();\n        let tog = |k: u8, name: &str, b: bool| {\n            let mut it = item(Act::Toggle(k), name);\n            it.value = on(b);\n            it\n        };\n        let d = &self.dev;\n        match m.tab {\n            0 => {\n                for day in 1..=5u8 {\n                    v.push(item(Act::JumpDay(day), format!(\"Day {day}\")));\n                }\n                for k in ALL_EVENTS {\n                    v.push(item(Act::JumpEvent(k), k.name()));\n                }\n                for (i, p) in finale::PHASES.iter().enumerate() {\n                    v.push(item(Act::JumpPhase(i as u32), format!(\"Big Stand: {p}\")));\n                }\n                v.push(item(Act::JumpAttract, \"Attract Mode\"));\n                v.push(item(Act::JumpMedley, \"Medley\"));\n            }\n            1 => {\n                v.push(tog(0, \"No Tips\", d.no_tips));\n                v.push(tog(1, \"Autoplay with the Bot\", d.autoplay));\n                v.push(tog(2, \"Skip Dialogue\", d.skip_dialog));\n                v.push(item(Act::GiveMinutes, \"Give 5 Minutes\"));\n                v.push(item(Act::UnlockAll, \"Unlock All\"));\n                v.push(item(Act::AllStars, \"All Stars\"));\n                v.push(item(Act::WinNow, \"Win This Event Now\"));\n                v.push(item(Act::LoseNow, \"Lose This Event Now\"));\n            }\n            2 => {\n                let mut t = item(Act::TimeScale, \"Time Scale\");\n                t.value = format!(\"{:.2}x\", d.time_scale);\n                t.fill = Some(((d.time_scale - 0.25) / 3.75).clamp(0.0, 1.0));\n                v.push(t);\n                v.push(tog(3, \"Freeze the World\", d.freeze));\n                v.push(item(Act::Step, \"Single Step\"));\n            }\n            3 => {\n                let mut g = item(Act::Group, \"Group\");\n                g.value = rules::GROUPS[d.group].to_string();\n                v.push(g);\n                let mut copy = self.rules.clone();\n                let prefix = format!(\"{}.\", rules::GROUPS[d.group]);\n                for p in params::list(&mut copy).into_iter().filter(|p| p.path.starts_with(&prefix)) {\n                    if let crate::params::ParamKind::Float { min, max } = p.kind {\n                        let val = p.value.as_f64().unwrap_or(0.0) as f32;\n                        let mut it = item(Act::Param(p.path.clone(), min, max), p.help.clone());\n                        it.value = format!(\"{val:.2}\");\n                        it.fill = Some(((val - min) / (max - min)).clamp(0.0, 1.0));\n                        v.push(it);\n                    }\n                }\n                v.push(item(Act::ResetGroup, \"Reset This Group to Defaults\"));\n                v.push(item(Act::ResetAll, \"Reset All to Defaults\"));\n            }\n            4 => {\n                v.push(tog(4, \"Input Viewer\", d.input_view));\n                v.push(tog(5, \"Dot Trace\", d.trace));\n                v.push(tog(6, \"Engine Stats\", d.stats));\n                v.push(tog(7, \"Free Camera\", d.free_cam));\n                v.push(tog(8, \"Ghost Lanes\", d.ghosts));\n            }\n            _ => v.push(item(Act::ResetGuest, \"Reset This Guest\")),\n        }\n        v.push(item(Act::Back, \"Back\"));\n    }\n\n    pub fn tabs_of(&self, m: &Menu) -> Vec<String> {\n        match m.kind {\n            MenuKind::Schedule => {\n                let mut t: Vec<String> = PAVILIONS.iter().map(|s| s.to_string()).collect();\n                t.push(\"Today\".into());\n                t\n            }\n            MenuKind::Dev => [\"Jump\", \"Cheats\", \"Time\", \"Tuning\", \"View\", \"Save\"].iter().map(|s| s.to_string()).collect(),\n            MenuKind::HowTo => HOW_TO.iter().map(|p| p.0.to_string()).collect(),\n            MenuKind::About => self.about_pages().iter().map(|p| p.0.clone()).collect(),\n            _ => Vec::new(),\n        }\n    }\n\n    pub fn menu_input(&mut self, sim: &mut Sim, input: &InputFrame, ev: &mut Vec<SimEvent>) {\n        let Some(mut m) = self.menus.last().copied() else { return };\n        let items = self.menu_items(&m);\n        let tabs = self.tabs_of(&m);\n        let n = items.len();\n        let mut activate = None;\n        let mut moved = false;\n        if !tabs.is_empty() {\n            let d = input.just(btn::TAB_R) as i32 - input.just(btn::TAB_L) as i32;\n            if d != 0 {\n                m.tab = (m.tab as i32 + d).rem_euclid(tabs.len() as i32) as usize;\n                m.focus = 0;\n                m.scroll = 0;\n                ev.push(SimEvent::Sfx { id: sfx::MOVE, gain: 0.6, pitch: 0.9 });\n            }\n        }\n        if n > 0 {\n            let d = input.just(btn::MENU_DOWN) as i32 - input.just(btn::MENU_UP) as i32;\n            if d != 0 {\n                m.focus = (m.focus as i32 + d).rem_euclid(n as i32) as usize;\n                moved = true;\n            }\n            let side = input.just(btn::MENU_RIGHT) as i32 - input.just(btn::MENU_LEFT) as i32;\n            if side != 0 {\n                if let Some(it) = items.get(m.focus) {\n                    self.adjust(sim, &it.act.clone(), side as f32, ev);\n                }\n            }\n            if input.just(btn::CONFIRM) {\n                activate = Some(m.focus);\n            }\n        }\n        match input.ui {\n            Some(UiEvent::Hover(id)) if (id as usize) < n => {\n                if m.focus != id as usize {\n                    m.focus = id as usize;\n                    moved = true;\n                }\n            }\n            Some(UiEvent::Click(id)) if (id as usize) < n => {\n                m.focus = id as usize;\n                activate = Some(id as usize);\n            }\n            Some(UiEvent::Click(id)) if id >= 1000 && ((id - 1000) as usize) < tabs.len() => {\n                m.tab = (id - 1000) as usize;\n                m.focus = 0;\n                m.scroll = 0;\n                ev.push(SimEvent::Sfx { id: sfx::MOVE, gain: 0.6, pitch: 0.9 });\n            }\n            Some(UiEvent::Slider(id, val)) if (id as usize) < n => {\n                m.focus = id as usize;\n                let act = items[id as usize].act.clone();\n                self.set_value(&act, val);\n            }\n            _ => {}\n        }\n        if moved {\n            ev.push(SimEvent::Sfx { id: sfx::MOVE, gain: 0.6, pitch: 1.0 });\n        }\n        m.scroll = m.scroll.min(m.focus);\n        if m.focus >= m.scroll + 6 {\n            m.scroll = m.focus + 1 - 6;\n        }\n        if let Some(top) = self.menus.last_mut() {\n            *top = m;\n        }\n        let back = input.just(btn::BACK) || input.just(btn::PAUSE);\n        if let Some(i) = activate {\n            let act = items.get(i).map(|x| x.act.clone()).unwrap_or(Act::None);\n            if act != Act::None {\n                ev.push(SimEvent::Sfx { id: if act == Act::Back { sfx::BACK } else { sfx::CONFIRM }, gain: 0.7, pitch: 1.0 });\n            }\n            self.do_act(sim, act, ev);\n        } else if back && !matches!(m.kind, MenuKind::Title | MenuKind::Result | MenuKind::Podium) {\n            ev.push(SimEvent::Sfx { id: sfx::BACK, gain: 0.7, pitch: 1.0 });\n            self.pop_menu(sim, ev);\n        }\n    }\n\n    pub fn pop_menu(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        let kind = self.menus.pop().map(|m| m.kind);\n        if kind == Some(MenuKind::Pause) && self.pause_t > 60.0 {\n            let mins = (self.pause_t / 60.0) as u32;\n            let mut d = Dialog::new(After::Nothing);\n            d.push(PIP, format!(\"You have been paused for {mins} minute{}. Pausing is not an exercise. I checked.\", if mins == 1 { \"\" } else { \"s\" }));\n            self.dialog = Some(d);\n        }\n        if kind == Some(MenuKind::Wardrobe) {\n            self.dress(sim);\n        }\n        if self.menus.is_empty() && matches!(self.mode, Mode::Title | Mode::Setup) {\n            self.go_title(sim, ev);\n        }\n    }\n\n    fn adjust(&mut self, sim: &mut Sim, act: &Act, dir: f32, ev: &mut Vec<SimEvent>) {\n        ev.push(SimEvent::Sfx { id: sfx::MOVE, gain: 0.5, pitch: 1.1 });\n        match act {\n            Act::Setting(i) => {\n                let s = &mut self.save.settings;\n                let step = 0.05 * dir;\n                match i {\n                    0 => s.music = (s.music + step).clamp(0.0, 1.0),\n                    1 => s.sfx = (s.sfx + step).clamp(0.0, 1.0),\n                    2 => s.voice = (s.voice + step).clamp(0.0, 1.0),\n                    3 => s.xbox = !s.xbox,\n                    4 => s.lean_sensitivity = (s.lean_sensitivity + 0.1 * dir).clamp(0.3, 2.0),\n                    5 => s.wobble_assist = (s.wobble_assist + 0.1 * dir).clamp(0.0, 1.0),\n                    6 => s.rhythm_offset = (s.rhythm_offset + 0.01 * dir).clamp(0.0, 0.3),\n                    _ => s.text_speed = (s.text_speed + 0.2 * dir).clamp(0.4, 3.0),\n                }\n                self.store();\n            }\n            Act::Skin => {\n                self.look_skin = (self.look_skin as i32 + dir as i32).rem_euclid(meta::SKINS.len() as i32) as u8;\n                self.preview_look(sim);\n            }\n            Act::Outfit => {\n                if self.menus.last().is_some_and(|m| m.kind == MenuKind::Wardrobe) {\n                    let g = self.guest_mut();\n                    g.outfit = (g.outfit as i32 + dir as i32).rem_euclid(meta::OUTFITS.len() as i32) as u8;\n                    self.dress(sim);\n                    self.store();\n                } else {\n                    self.look_outfit = (self.look_outfit as i32 + dir as i32).rem_euclid(meta::OUTFITS.len() as i32) as u8;\n                    self.preview_look(sim);\n                }\n            }\n            Act::Hat => {\n                self.cycle_wear(true, dir as i32);\n                self.dress(sim);\n            }\n            Act::Extra => {\n                self.cycle_wear(false, dir as i32);\n                self.dress(sim);\n            }\n            Act::TogetherN => {\n                self.together_n = (self.together_n as i32 + dir as i32 - 2).rem_euclid(3) as u32 + 2;\n            }\n            Act::TimeScale => self.dev.time_scale = (self.dev.time_scale + 0.25 * dir).clamp(0.25, 4.0),\n            Act::Group => self.dev.group = (self.dev.group as i32 + dir as i32).rem_euclid(rules::GROUPS.len() as i32) as usize,\n            Act::Param(path, min, max) => {\n                let mut copy = self.rules.clone();\n                let now = params::get(&mut copy, path).and_then(|v| v.as_f64()).unwrap_or(0.0) as f32;\n                let f = ((now - min) / (max - min) + 0.025 * dir).clamp(0.0, 1.0);\n                self.set_value(act, f);\n            }\n            _ => {}\n        }\n    }\n\n    /// A slider dragged to `f` (0..1).\n    fn set_value(&mut self, act: &Act, f: f32) {\n        let f = f.clamp(0.0, 1.0);\n        match act {\n            Act::Setting(i) => {\n                let s = &mut self.save.settings;\n                match i {\n                    0 => s.music = f,\n                    1 => s.sfx = f,\n                    2 => s.voice = f,\n                    4 => s.lean_sensitivity = (f * 2.0).max(0.3),\n                    5 => s.wobble_assist = f,\n                    6 => s.rhythm_offset = f * 0.3,\n                    7 => s.text_speed = (f * 3.0).max(0.4),\n                    _ => {}\n                }\n                self.store();\n            }\n            Act::TimeScale => self.dev.time_scale = 0.25 + f * 3.75,\n            Act::Param(path, min, max) => {\n                let _ = params::set(&mut self.rules, path, ParamValue::Float((min + (max - min) * f) as f64));\n            }\n            _ => {}\n        }\n    }\n\n    fn cycle_wear(&mut self, hat: bool, dir: i32) {\n        let g = self.guest_mut();\n        let total = g.total_minutes;\n        let list: &[(&str, u32)] = if hat { &meta::HATS } else { &meta::EXTRAS };\n        let cur = if hat { g.wear.hat } else { g.wear.extra } as i32;\n        let n = list.len() as i32;\n        let mut next = cur;\n        for _ in 0..n {\n            next = (next + dir).rem_euclid(n);\n            if list[next as usize].1 <= total {\n                break;\n            }\n        }\n        if hat {\n            g.wear.hat = next as u8;\n        } else {\n            g.wear.extra = next as u8;\n        }\n        self.store();\n    }\n\n    fn preview_look(&mut self, sim: &mut Sim) {\n        self.dress_as(sim, meta::guest_def(self.look_skin, self.look_outfit, &meta::Wear::default()));\n    }\n\n    pub fn do_act(&mut self, sim: &mut Sim, act: Act, ev: &mut Vec<SimEvent>) {\n        match act {\n            Act::None => {}\n            Act::Back => self.pop_menu(sim, ev),\n            Act::NewStay => {\n                self.set_mode(Mode::Setup);\n                self.menus.push(Menu::new(MenuKind::Slot));\n            }\n            Act::ContinueMenu => {\n                self.set_mode(Mode::Setup);\n                self.menus.push(Menu::new(MenuKind::Continue));\n            }\n            Act::Together => {\n                self.set_mode(Mode::Setup);\n                self.menus.push(Menu::new(MenuKind::Together));\n            }\n            Act::SettingsOpen => self.menus.push(Menu::new(MenuKind::Settings)),\n            Act::AboutOpen => self.menus.push(Menu::new(MenuKind::About)),\n            Act::Slot(i) => {\n                self.slot = i;\n                if self.save.guests[i].is_some() {\n                    self.menus.push(Menu::new(MenuKind::Overwrite(i as u8)));\n                } else {\n                    self.menus.push(Menu::new(MenuKind::Name));\n                }\n            }\n            Act::ConfirmOverwrite(i) => {\n                self.save.guests[i] = None;\n                self.menus.pop();\n                self.menus.push(Menu::new(MenuKind::Name));\n            }\n            Act::ContinueSlot(i) => {\n                self.slot = i;\n                self.menus.clear();\n                self.continue_stay(sim, ev);\n            }\n            Act::Name(i) => {\n                self.name_pick = i;\n                let n = script::script().names.len().max(1);\n                self.look_skin = (i % 6) as u8;\n                self.look_outfit = (i % n % 8) as u8;\n                self.preview_look(sim);\n                self.menus.push(Menu::new(MenuKind::Look));\n            }\n            Act::Skin | Act::Outfit | Act::Hat | Act::Extra | Act::TogetherN | Act::Group | Act::TimeScale => self.adjust(sim, &act, 1.0, ev),\n            Act::Begin => {\n                let name = script::script().names.get(self.name_pick).cloned().unwrap_or_else(|| \"Guest\".into());\n                self.save.guests[self.slot] = Some(Guest::new(&name, self.look_skin, self.look_outfit));\n                self.menus.clear();\n                self.dress(sim);\n                self.intro(sim, ev);\n            }\n            Act::Resume => self.pop_menu(sim, ev),\n            Act::ScheduleOpen => self.menus.push(Menu::new(MenuKind::Schedule)),\n            Act::CalendarOpen => self.menus.push(Menu::new(MenuKind::Calendar)),\n            Act::WardrobeOpen => self.menus.push(Menu::new(MenuKind::Wardrobe)),\n            Act::HowToOpen => self.menus.push(Menu::new(MenuKind::HowTo)),\n            Act::DevOpen => self.menus.push(Menu::new(MenuKind::Dev)),\n            Act::QuitTitle => {\n                self.store();\n                self.paused = false;\n                self.go_title(sim, ev);\n            }\n            Act::Setting(i) => {\n                if i == 3 {\n                    self.adjust(sim, &act, 1.0, ev);\n                }\n            }\n            Act::ResetAsk => self.menus.push(Menu::new(MenuKind::ResetConfirm)),\n            Act::ResetYes => {\n                self.save = Save::default();\n                self.store();\n                self.paused = false;\n                self.go_title(sim, ev);\n            }\n            Act::GoEvent(k) => self.start_event(sim, k, RunCtx::Stay, ev),\n            Act::GoStand => self.start_finale(sim, 0, ev),\n            Act::EndDay => {\n                self.menus.clear();\n                self.interact(sim, Interact::Cabana, ev);\n            }\n            Act::Retry => {\n                let Some(run) = &self.run else { return };\n                let (kind, ctx) = (run.kind, run.ctx);\n                if let Some(k) = kind {\n                    self.start_event(sim, k, ctx, ev);\n                }\n            }\n            Act::Leave => self.leave_run(sim, ev),\n            Act::TogetherGo => {\n                let n = self.together_n as usize;\n                let racers = (0..n)\n                    .map(|i| {\n                        let (name, skin, outfit) = match &self.save.guests[i] {\n                            Some(g) => (g.name.clone(), g.skin, g.outfit),\n                            None => (format!(\"Guest {}\", i + 1), (i * 2) as u8, i as u8),\n                        };\n                        Racer { name, skin, outfit, ..Default::default() }\n                    })\n                    .collect();\n                self.menus.clear();\n                let seed = self.seed.wrapping_add(self.tick as u32);\n                self.begin_medley(sim, racers, seed, ev);\n            }\n            Act::PodiumDone => self.go_title(sim, ev),\n            Act::Fullscreen => self.fullscreen += 1,\n            Act::JumpDay(d) => {\n                self.paused = false;\n                self.teardown_run(sim);\n                if self.save.guests[self.slot].is_none() {\n                    self.guest_mut();\n                }\n                let g = self.guest_mut();\n                g.day = d;\n                g.stamps = d - 1;\n                g.minutes = 0;\n                g.done_today.clear();\n                self.menus.clear();\n                self.dialog = None;\n                self.begin_day(sim, ev);\n            }\n            Act::JumpEvent(k) => {\n                self.paused = false;\n                self.guest_mut();\n                self.dress(sim);\n                self.start_event(sim, k, RunCtx::Stay, ev);\n            }\n            Act::JumpPhase(p) => {\n                self.paused = false;\n                self.guest_mut();\n                self.dress(sim);\n                self.start_finale(sim, p, ev);\n            }\n            Act::JumpAttract => {\n                self.paused = false;\n                self.go_title(sim, ev);\n                self.attract_start(sim, ev);\n            }\n            Act::JumpMedley => {\n                self.paused = false;\n                self.menus.clear();\n                self.begin_medley(sim, vec![Racer { name: \"You\".into(), skin: 1, ..Default::default() }], self.seed, ev);\n            }\n            Act::Toggle(k) => {\n                let d = &mut self.dev;\n                match k {\n                    0 => d.no_tips = !d.no_tips,\n                    1 => d.autoplay = !d.autoplay,\n                    2 => d.skip_dialog = !d.skip_dialog,\n                    3 => d.freeze = !d.freeze,\n                    4 => d.input_view = !d.input_view,\n                    5 => {\n                        d.trace = !d.trace;\n                        if let Some(r) = &mut self.run {\n                            r.trace.clear();\n                        }\n                    }\n                    6 => d.stats = !d.stats,\n                    7 => {\n                        d.free_cam = !d.free_cam;\n                        self.cam.look_yaw = 0.0;\n                        self.cam.look_tilt = 0.0;\n                        self.cam.look_zoom = 0.0;\n                    }\n                    _ => d.ghosts = !d.ghosts,\n                }\n            }\n            Act::GiveMinutes => {\n                let g = self.guest_mut();\n                g.minutes += 5;\n                g.total_minutes += 5;\n                self.store();\n            }\n            Act::UnlockAll => {\n                let g = self.guest_mut();\n                g.day = g.day.max(5);\n                g.total_minutes = g.total_minutes.max(99);\n                self.store();\n            }\n            Act::AllStars => {\n                let g = self.guest_mut();\n                for k in ALL_EVENTS {\n                    g.bests.insert(k.key().to_string(), meta::Best { score: 900, stars: 3 });\n                }\n                self.store();\n            }\n            Act::WinNow | Act::LoseNow => {\n                let win = act == Act::WinNow;\n                if let Some(run) = self.run.as_mut() {\n                    if run.phase != Phase::Result {\n                        run.phase = Phase::Play;\n                        self.menus.clear();\n                        self.paused = false;\n                        self.finish_run_forced(sim, if win { 1000 } else { 0 }, ev);\n                    }\n                }\n            }\n            Act::Step => self.dev.step = true,\n            Act::Param(..) => {}\n            Act::ResetGroup => {\n                let path = rules::GROUPS[self.dev.group];\n                let mut base = self.base_rules.clone();\n                for p in params::list(&mut base).into_iter().filter(|p| p.path.starts_with(&format!(\"{path}.\"))) {\n                    let _ = params::set(&mut self.rules, &p.path, p.value);\n                }\n            }\n            Act::ResetAll => self.rules = self.base_rules.clone(),\n            Act::ResetGuest => {\n                let (name, skin, outfit) = self.guest().map(|g| (g.name.clone(), g.skin, g.outfit)).unwrap_or_default();\n                self.save.guests[self.slot] = Some(Guest::new(&name, skin, outfit));\n                self.store();\n                self.paused = false;\n                self.go_title(sim, ev);\n            }\n        }\n    }\n\n    /// Ends the run now with a chosen score (Dev Mode).\n    fn finish_run_forced(&mut self, sim: &mut Sim, score: u32, ev: &mut Vec<SimEvent>) {\n        self.forced_score = Some(score);\n        self.finish_run(sim, ev);\n        self.forced_score = None;\n    }\n\n    fn intro(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        let at = self.spots.get(HUB, \"pip\") + Vec3::new(0.0, 0.0, 2.2);\n        self.goto_set(sim, HUB, at);\n        self.set_mode(Mode::Island);\n        self.play_song(ev, 1);\n        let mut d = Dialog::new(After::Nothing);\n        for line in script::lines(\"intro\") {\n            let (who, text) = script_line(line);\n            d.push(who, text);\n        }\n        d.after = After::Nothing;\n        self.dialog = Some(d);\n        self.pending_begin = true;\n    }\n\n    fn continue_stay(&mut self, sim: &mut Sim, ev: &mut Vec<SimEvent>) {\n        self.dress(sim);\n        let today = self.today;\n        let free = self.guest().is_some_and(|g| g.free_play);\n        if free {\n            let g = self.guest_mut();\n            let away = if g.last_day > 0 && today > g.last_day { (today - g.last_day) as u32 } else { 0 };\n            g.real_stamps += away.min(1);\n            g.last_day = today;\n            self.enter_island(sim, ev);\n            let n = sim.state.rng.next_u32();\n            let mut d = Dialog::new(After::Nothing);\n            if away > 0 {\n                d.push(PIP, format!(\"You were away for {away} day{}. I did not count them. There were {away}.\", if away == 1 { \"\" } else { \"s\" }));\n            }\n            d.push(PIP, script::line(\"pip_free\", n));\n            self.dialog = Some(d);\n            self.store();\n            return;\n        }\n        // Mid-stay: back to this morning, or to the island if the check is done.\n        if self.guest().is_some_and(|g| g.checked_today) {\n            self.enter_island(sim, ev);\n            let last = self.guest().map(|g| g.last_day).unwrap_or(0);\n            if today > 0 && last > 0 && today > last {\n                let away = today - last;\n                let mut d = Dialog::new(After::Nothing);\n                d.push(PIP, format!(\"You were away for {away} day{}. I did not count them. There were {away}.\", if away == 1 { \"\" } else { \"s\" }));\n                self.dialog = Some(d);\n                self.guest_mut().last_day = today;\n            }\n        } else {\n            self.begin_day(sim, ev);\n        }\n    }\n\n    pub fn about_pages(&self) -> Vec<(String, Vec<String>)> {\n        let v: serde_json::Value = serde_json::from_str(&self.about).unwrap_or(serde_json::Value::Null);\n        let mut pages = Vec::new();\n        pages.push((TITLE.to_string(), vec![TAGLINE.to_string(), \"An original game. Inspired by Wii Fit; no relation to it, and it has not asked.\".to_string()]));\n        if let Some(info) = v.get(\"sourceInformation\").and_then(|i| i.as_object()) {\n            let labels = [(\"date\", \"Date\"), (\"source\", \"Source\"), (\"plan\", \"Plan\"), (\"genre\", \"Genre\"), (\"perspective\", \"Perspective\"), (\"tech\", \"Tech\"), (\"artDirection\", \"Art Direction\"), (\"animation\", \"Animation\"), (\"audio\", \"Audio\"), (\"online\", \"Online\"), (\"testing\", \"Testing\"), (\"research\", \"Research\"), (\"environment\", \"Environment\"), (\"model\", \"Model\"), (\"usage\", \"Usage\")];\n            let mut lines: Vec<String> = Vec::new();\n            for (k, l) in labels {\n                if let Some(t) = info.get(k).and_then(|x| x.as_str()) {\n                    lines.push(format!(\"{l}: {t}\"));\n                }\n            }\n            paginate(\"Source Information\", &lines, &mut pages);\n        }\n        for (key, name) in [(\"testingFeedback\", \"Testing Feedback\"), (\"engineFeedback\", \"Engine Feedback\"), (\"promptFeedback\", \"Prompt Feedback\")] {\n            if let Some(a) = v.get(key).and_then(|x| x.as_array()) {\n                let lines: Vec<String> = a.iter().filter_map(|x| x.as_str().map(|s| s.to_string())).collect();\n                paginate(name, &lines, &mut pages);\n            }\n        }\n        paginate(\n            \"Credits\",\n            &[\n                \"Fonts: Fredoka and Nunito (SIL Open Font License).\".to_string(),\n                \"Engine: Pavilion, from Shardfall by Michael Crosato.\".to_string(),\n                \"Motion clips: Quaternius, CMU Graphics Lab, Mesh2Motion and Style100 libraries (CC0 and open licences; see the engine's store/CREDITS.md), and hand-keyed moves made for this game.\".to_string(),\n                \"All music, sound and voices are written in code. There are no audio files.\".to_string(),\n            ],\n            &mut pages,\n        );\n        pages\n    }\n}\n\nfn paginate(title: &str, lines: &[String], pages: &mut Vec<(String, Vec<String>)>) {\n    let mut cur: Vec<String> = Vec::new();\n    let mut len = 0;\n    let mut n = 1;\n    let flush = |cur: &mut Vec<String>, n: &mut u32, pages: &mut Vec<(String, Vec<String>)>| {\n        if !cur.is_empty() {\n            pages.push((format!(\"{title} {n}\"), std::mem::take(cur)));\n            *n += 1;\n        }\n    };\n    for l in lines {\n        // A long answer is split so no page is a wall.\n        for part in split_long(l, 460) {\n            if len + part.len() > 520 {\n                flush(&mut cur, &mut n, pages);\n                len = 0;\n            }\n            len += part.len();\n            cur.push(part);\n        }\n    }\n    flush(&mut cur, &mut n, pages);\n}\n\nfn split_long(s: &str, max: usize) -> Vec<String> {\n    let mut out = Vec::new();\n    let mut cur = String::new();\n    for w in s.split(' ') {\n        if cur.len() + w.len() + 1 > max {\n            out.push(std::mem::take(&mut cur));\n        }\n        if !cur.is_empty() {\n            cur.push(' ');\n        }\n        cur.push_str(w);\n    }\n    if !cur.is_empty() {\n        out.push(cur);\n    }\n    out\n}\n\nfn guest_line(g: &Guest) -> String {\n    let age = g.age().map(|a| format!(\", Balance Age {a}\")).unwrap_or_default();\n    if g.free_play { format!(\"{}, free play{age}\", g.name) } else { format!(\"{}, Day {}{age}\", g.name, g.day) }\n}\n\nfn pct(x: f32) -> String {\n    format!(\"{}%\", (x * 100.0).round() as u32)\n}\n\npub const HOW_TO: [(&str, &[&str]); 5] = [\n    (\"Leaning\", &[\"Everything here is done by leaning. The dot on the Puck is your balance.\", \"Left stick, W A S D, or move the mouse from the middle of the screen.\", \"Small movements. Smaller than that.\"]),\n    (\"Buttons\", &[\"Action: begin, inhale, squat, bounce.\", \"Left and right step: the shoulder buttons, Q and E, or the mouse buttons.\", \"Brace: both steps at once.\"]),\n    (\"The Island\", &[\"Walk with the left stick or W A S D, or click where you want to go.\", \"Step on a mat to begin an event. The Schedule goes anywhere.\", \"Wave at people. They will wave back. They have to.\"]),\n    (\"Each Day\", &[\"Morning: Pip tests your balance and gives you a number.\", \"Bank the day's minutes in events, and the Clam keeps them.\", \"Sleep at your cabana. A big stamp lands. Tomorrow comes.\"]),\n    (\"Leaving\", &[\"Checkout requires a Balance Age of 40 or better.\", \"Day 5 is the Big Stand. The last test is to do nothing.\", \"Nobody has asked to leave yet.\"]),\n];\n\nimpl FitGame {\n    /// The UI, written for this tick.\n    pub fn ui_frame(&self, sim: &Sim) -> UiFrame {\n        let mut b = B::default();\n        self.draw_world_layer(&mut b, sim);\n        if let Some(d) = &self.dialog {\n            d.draw(&mut b);\n        }\n        if let Some(m) = self.menus.last() {\n            self.draw_menu(&mut b, m, sim);\n        }\n        if self.dev.input_view {\n            self.draw_input_view(&mut b);\n        }\n        let s = &self.save.settings;\n        UiFrame {\n            items: b.items,\n            screen: screen_name(self),\n            xbox: s.xbox,\n            music: if self.hub_ended { 0.0 } else { s.music },\n            sfx: if self.hub_ended { 0.0 } else { s.sfx },\n            voice: if self.hub_ended { 0.0 } else { s.voice },\n            rhythm_offset: s.rhythm_offset,\n            time_scale: self.dev.time_scale,\n            stats: self.dev.stats,\n            fullscreen: self.fullscreen,\n            save: (self.save_serial > 0).then(|| (self.save_serial, self.save_blob.clone())),\n            hub: self.hub,\n            silent: self.hub_ended,\n            dev_overlay: self.dev.input_view,\n            rumble: self.rumble,\n        }\n    }\n\n    fn draw_input_view(&self, b: &mut B) {\n        b.flat([40.0, 700.0, 460.0, 1040.0], [255, 255, 255, 200], 24.0);\n        b.text(60.0, 712.0, 36.0, INK, \"Input\");\n        b.circle([250.0, 880.0], 120.0, PALE, INK, 4.0);\n        b.circle([250.0 + self.lean_now.x * 120.0, 880.0 - self.lean_now.y * 120.0], 22.0, CORAL, WHITE, 3.0);\n    }\n\n    fn draw_world_layer(&self, b: &mut B, sim: &Sim) {\n        if let Some(a) = &self.attract {\n            if a.idx == 0 || a.idx == ATTRACT.len() + 1 {\n                self.draw_logo(b);\n            }\n            if let Some(r) = &self.run {\n                r.draw_hud(b, &self.rules);\n                b.title(960.0, 60.0, 72.0, TEAL, r.name());\n            }\n            b.flat([0.0, 0.0, 300.0, 76.0], CORAL, 18.0);\n            b.text(40.0, 14.0, 44.0, WHITE, \"DEMO\");\n            if self.touch_only {\n                self.draw_touch_card(b);\n            } else {\n                b.flat([660.0, 980.0, 1260.0, 1050.0], [255, 255, 255, 220], 34.0);\n                b.center(960.0, 990.0, 42.0, INK, \"Press any button\");\n            }\n            return;\n        }\n        match self.mode {\n            Mode::Title | Mode::Setup => {\n                if self.menus.last().is_none_or(|m| matches!(m.kind, MenuKind::Title)) {\n                    self.draw_logo(b);\n                }\n            }\n            Mode::Island => self.draw_island_hud(b, sim),\n            Mode::Check => {\n                if let Some(c) = &self.check {\n                    if self.menus.is_empty() {\n                        c.hud(b, &self.check_core);\n                    }\n                }\n            }\n            Mode::Report => self.draw_report(b),\n            Mode::Run => self.draw_run(b),\n            Mode::Stamp => self.draw_calendar(b, true),\n            Mode::Ending => {\n                let t = if self.ended_well { \"Checked Out\" } else { \"Extended Stay\" };\n                b.title(960.0, 120.0, 110.0, WHITE, t);\n                let sub = if self.ended_well { \"The rowboat is free. The Clam keeps your minutes.\" } else { \"Your room has been kept. It was never let go.\" };\n                b.center(960.0, 260.0, 48.0, WHITE, sub);\n            }\n            Mode::Credits => self.draw_credits(b),\n            Mode::PassPad => {\n                let m = self.medley.as_ref();\n                let name = m.and_then(|m| m.racers.get(m.who)).map(|r| r.name.clone()).unwrap_or_default();\n                b.tint([214, 238, 246, 120]);\n                b.card([360.0, 300.0, 1560.0, 780.0], DECK);\n                b.title(960.0, 340.0, 96.0, TEAL, \"Pass the Controller\");\n                b.center(960.0, 490.0, 60.0, INK, &format!(\"{name}, it is your turn.\"));\n                b.center(960.0, 570.0, 40.0, MUTED, \"The others will watch. They have nothing else to do.\");\n                b.prompt_center(960.0, 680.0, &[Glyph::Confirm], \"Ready\");\n            }\n            Mode::Podium => self.draw_podium(b),\n            Mode::HubDone => {\n                b.tint([214, 238, 246, 120]);\n                b.card([460.0, 360.0, 1460.0, 720.0], DECK);\n                b.title(960.0, 400.0, 96.0, TEAL, \"Finished\");\n                b.center(960.0, 530.0, 56.0, INK, &format!(\"{} points of balance\", self.medley_total()));\n                b.center(960.0, 610.0, 40.0, MUTED, \"Please stand by. Standing is what we do.\");\n            }\n        }\n    }\n\n    fn draw_touch_card(&self, b: &mut B) {\n        b.tint([214, 238, 246, 60]);\n        b.card([460.0, 330.0, 1460.0, 750.0], DECK);\n        b.title(960.0, 370.0, 64.0, TEAL, \"Controller or keyboard required\");\n        b.center(960.0, 480.0, 40.0, INK, \"Please connect one, and stand by.\");\n        b.items.push(Ui::Button { id: 900, rect: [710.0, 580.0, 1210.0, 700.0], label: \"Settings\".into(), sub: String::new(), focused: true, stars: -1, value: String::new(), fill: None, big: true });\n    }\n\n    fn draw_logo(&self, b: &mut B) {\n        b.title(960.0, 90.0, 170.0, WHITE, TITLE);\n        b.title(956.0, 86.0, 170.0, TEAL, TITLE);\n        b.center(960.0, 280.0, 50.0, INK, TAGLINE);\n        if self.touch_only && self.attract.is_none() {\n            self.draw_touch_card(b);\n        }\n    }\n\n    fn draw_island_hud(&self, b: &mut B, sim: &Sim) {\n        let Some(g) = self.guest() else { return };\n        let (w, h) = (640.0, 140.0);\n        b.flat([30.0, 30.0, 30.0 + w, 30.0 + h], [255, 255, 255, 225], 34.0);\n        if g.free_play {\n            b.title_left(60.0, 44.0, 64.0, TEAL, \"Free Play\");\n            b.text(350.0, 62.0, 40.0, INK, &format!(\"{} stars\", g.total_stars()));\n        } else {\n            b.title_left(60.0, 44.0, 64.0, TEAL, &format!(\"Day {}\", g.day));\n            if let Some(goal) = self.day_goal() {\n                b.text(240.0, 48.0, 40.0, INK, &format!(\"{} of {goal} minutes\", g.minutes));\n                b.bar([240.0, 110.0, 640.0, 140.0], (g.minutes as f32 / goal.max(1) as f32).min(1.0), MINT, None);\n            } else {\n                b.text(240.0, 62.0, 40.0, INK, \"The Big Stand\");\n            }\n        }\n        if let Some(a) = g.age() {\n            b.flat([1550.0, 30.0, 1890.0, 170.0], [255, 255, 255, 225], 34.0);\n            b.right(1860.0, 40.0, 36.0, MUTED, \"Balance Age\");\n            b.items.push(Ui::Text { pos: [1860.0, 76.0], size: 78.0, color: INK, align: 2, title: true, text: a.to_string(), wrap: 0.0 });\n        }\n        if let Some((_, at, label)) = &self.near {\n            b.items.push(Ui::WorldPrompt { at: (*at + Vec3::Y * 2.0).to_array(), glyph: Glyph::Confirm, label: label.clone() });\n        }\n        if let Some((m, _)) = &self.msg {\n            b.flat([360.0, 200.0, 1560.0, 280.0], [255, 255, 255, 225], 34.0);\n            b.center(960.0, 214.0, 40.0, INK, m);\n        }\n        if self.dialog.is_none() {\n            b.prompt(50.0, 1000.0, &[Glyph::Move], \"Walk\");\n            b.prompt(350.0, 1000.0, &[Glyph::Jog], \"Jog\");\n            b.prompt(640.0, 1000.0, &[Glyph::Wave], \"Wave\");\n            b.prompt(950.0, 1000.0, &[Glyph::Schedule], \"Schedule\");\n            b.prompt(1330.0, 1000.0, &[Glyph::Camera], \"Camera\");\n            b.prompt(1650.0, 1000.0, &[Glyph::Pause], \"Pause\");\n        }\n        let _ = sim;\n    }\n\n    fn draw_report(&self, b: &mut B) {\n        b.tint([214, 238, 246, 140]);\n        b.card([460.0, 110.0, 1460.0, 720.0], DECK);\n        b.center(960.0, 140.0, 54.0, INK, \"Your Balance Age\");\n        let t = self.report.t;\n        let shown = if t < 3.0 { 18 + ((t * 31.0) as i32 * 7) % 80 } else { self.report.age };\n        b.items.push(Ui::Text { pos: [960.0, 210.0], size: 260.0, color: if t < 3.0 { MUTED } else { TEAL }, align: 1, title: true, text: shown.to_string(), wrap: 0.0 });\n        if t >= 3.0 {\n            let ages = self.guest().map(|g| g.ages.clone()).unwrap_or_default();\n            for k in 0..5 {\n                let x = 720.0 + k as f32 * 120.0;\n                let got = ages.get(k).copied();\n                let y = got.map(|a| 620.0 - (80 - a.clamp(20, 80)) as f32 * 1.3).unwrap_or(620.0);\n                b.circle([x, y], 26.0, if got.is_some() { CORAL } else { PALE }, WHITE, 5.0);\n            }\n        }\n    }\n\n    fn draw_run(&self, b: &mut B) {\n        let Some(r) = &self.run else { return };\n        match r.phase {\n            Phase::Card => {\n                let coach = r.kind.map(|k| k.coach()).unwrap_or(PIP);\n                let pick = (self.tick / 600) as u32;\n                let line = script::line(r.kind.map(|k| [\"coach_0\", \"coach_1\", \"coach_2\", \"coach_3\"][k.pavilion()]).unwrap_or(\"finale_card\"), pick);\n                let how = run::how_to(r.kind);\n                let who = script::SPEAKERS[coach as usize];\n                r.draw_card(b, r.name(), run::goal(r.kind), &line, who, &how);\n            }\n            Phase::Count => {\n                r.draw_hud(b, &self.rules);\n                if !self.hub || self.hub_go {\n                    let n = (3.0 - r.t).ceil().max(1.0) as u32;\n                    b.circle([960.0, 480.0], 150.0, [255, 255, 255, 230], TEAL, 12.0);\n                    b.title(960.0, 370.0, 170.0, TEAL, &n.to_string());\n                } else {\n                    b.center(960.0, 480.0, 60.0, INK, \"Waiting for the others\");\n                }\n                b.title(960.0, 200.0, 80.0, INK, r.name());\n            }\n            Phase::Play => {\n                r.draw_hud(b, &self.rules);\n                if let Some((m, _)) = &r.msg {\n                    if r.kind != Some(EvKind::Step) {\n                        b.flat([360.0, 820.0, 1560.0, 900.0], [255, 255, 255, 225], 36.0);\n                        b.center(960.0, 836.0, 40.0, INK, m);\n                    } else {\n                        b.center(960.0, 300.0, 40.0, INK, m);\n                    }\n                }\n                if self.hub || r.ctx == RunCtx::Medley {\n                    b.right(1860.0, 30.0, 40.0, INK, &format!(\"Total {}\", self.medley_total()));\n                }\n                if self.dev.freeze {\n                    b.center(960.0, 60.0, 44.0, CORAL, \"Frozen: Dev Mode, Time\");\n                }\n            }\n            Phase::Result => {}\n        }\n    }\n\n    fn draw_calendar(&self, b: &mut B, stamping: bool) {\n        let Some(g) = self.guest() else { return };\n        b.tint([214, 238, 246, 170]);\n        b.card([200.0, 150.0, 1720.0, 800.0], DECK);\n        b.title(960.0, 180.0, 96.0, TEAL, \"Your Stay\");\n        for k in 0..5u8 {\n            let x = 340.0 + k as f32 * 310.0;\n            b.flat([x - 120.0, 320.0, x + 120.0, 640.0], WHITE, 24.0);\n            b.flat([x - 120.0, 320.0, x + 120.0, 380.0], CORAL, 24.0);\n            b.center(x, 328.0, 40.0, WHITE, &format!(\"Day {}\", k + 1));\n            if let Some(a) = g.ages.get(k as usize) {\n                b.center(x, 580.0, 36.0, MUTED, &format!(\"Age {a}\"));\n            }\n            if k < g.stamps {\n                let fresh = stamping && k + 1 == g.stamps;\n                let r = if fresh { 90.0 + 300.0 * (1.0 - (self.mode_t * 5.0).min(1.0)) } else { 90.0 };\n                b.circle([x, 480.0], r, [0, 0, 0, 0], TEAL, 14.0);\n                b.items.push(Ui::Text { pos: [x, 415.0], size: 64.0, color: TEAL, align: 1, title: true, text: \"OK\".into(), wrap: 0.0 });\n            }\n        }\n        if g.real_stamps > 0 {\n            b.center(960.0, 680.0, 40.0, INK, &format!(\"Real days stamped since: {}\", g.real_stamps));\n        }\n    }\n\n    fn draw_credits(&self, b: &mut B) {\n        b.tint([20, 34, 48, 170]);\n        let lines = [\n            (true, TITLE),\n            (false, TAGLINE),\n            (false, \"\"),\n            (false, \"Pip, front desk and records\"),\n            (false, \"Posey, stillness\"),\n            (false, \"Big Kettle, strength\"),\n            (false, \"Bounce, cardio\"),\n            (false, \"Commodore Gull, lagoon and snacks\"),\n            (false, \"Marjorie, Day 5, eleven years\"),\n            (false, \"Two-Towel Tom, flip-flops\"),\n            (false, \"The Twins, the twins\"),\n            (false, \"\"),\n            (false, \"Free Play is now open. It always was.\"),\n        ];\n        let scroll = self.mode_t * 70.0;\n        for (i, (title, text)) in lines.iter().enumerate() {\n            let y = 1000.0 + i as f32 * 90.0 - scroll;\n            if !(-120.0..=1100.0).contains(&y) || text.is_empty() {\n                continue;\n            }\n            if *title {\n                b.title(960.0, y, 110.0, WHITE, text);\n            } else {\n                b.center(960.0, y, 50.0, WHITE, text);\n            }\n        }\n    }\n\n    fn draw_podium(&self, b: &mut B) {\n        let Some(m) = &self.medley else { return };\n        let mut rows: Vec<(String, u32, usize)> = m.racers.iter().enumerate().map(|(i, r)| (r.name.clone(), r.scores.iter().sum(), i)).collect();\n        rows.sort_by(|a, b| b.1.cmp(&a.1));\n        b.tint([214, 238, 246, 120]);\n        b.card([360.0, 60.0, 1560.0, 760.0], DECK);\n        b.title(960.0, 90.0, 96.0, TEAL, \"The Podium\");\n        for (i, (name, score, _)) in rows.iter().enumerate() {\n            let y = 240.0 + i as f32 * 110.0;\n            b.text(460.0, y, 60.0, if i == 0 { CORAL } else { INK }, &format!(\"{}. {name}\", i + 1));\n            b.right(1460.0, y, 60.0, INK, &score.to_string());\n        }\n    }\n\n    fn draw_menu(&self, b: &mut B, m: &Menu, sim: &Sim) {\n        let items = self.menu_items(m);\n        let mut top = 300.0;\n        let title = match m.kind {\n            MenuKind::Title => {\n                top = 380.0;\n                \"\"\n            }\n            MenuKind::Slot => \"Sign the Guest Book\",\n            MenuKind::Continue => \"Who Is Still Here?\",\n            MenuKind::Overwrite(_) => \"Someone Is Staying There\",\n            MenuKind::Name => \"What Do We Call You?\",\n            MenuKind::Look => \"How Do You Look?\",\n            MenuKind::Pause => \"Paused\",\n            MenuKind::Hub => \"Paused\",\n            MenuKind::Settings => \"Settings\",\n            MenuKind::ResetConfirm => \"Reset Everything?\",\n            MenuKind::Schedule => \"Schedule\",\n            MenuKind::Calendar => \"\",\n            MenuKind::Wardrobe => \"Wardrobe\",\n            MenuKind::HowTo => \"How to Play\",\n            MenuKind::About => \"About\",\n            MenuKind::Dev => \"Dev Mode\",\n            MenuKind::Result => \"\",\n            MenuKind::Together => \"Play Together\",\n            MenuKind::Podium => \"\",\n        };\n        // A wash over the world, except where the figure shows.\n        match m.kind {\n            MenuKind::Title | MenuKind::Look | MenuKind::Wardrobe | MenuKind::Result | MenuKind::Podium | MenuKind::Calendar => {}\n            _ => b.tint([214, 238, 246, 150]),\n        }\n        let (mut x0, mut x1) = (460.0, 1460.0);\n        if matches!(m.kind, MenuKind::Look | MenuKind::Wardrobe) {\n            x0 = 1000.0;\n            x1 = 1860.0;\n        }\n        match m.kind {\n            MenuKind::Calendar => {\n                self.draw_calendar(b, false);\n                top = 840.0;\n                x0 = 760.0;\n                x1 = 1160.0;\n            }\n            MenuKind::Result => {\n                self.draw_result(b);\n                top = 760.0;\n                x0 = 560.0;\n                x1 = 1360.0;\n            }\n            MenuKind::Podium => {\n                self.draw_podium(b);\n                top = 800.0;\n            }\n            MenuKind::HowTo | MenuKind::About => {\n                b.card([120.0, 30.0, 1800.0, 1050.0], DECK);\n                let pages: Vec<(String, Vec<String>)> = if m.kind == MenuKind::HowTo {\n                    HOW_TO.iter().map(|p| (p.0.to_string(), p.1.iter().map(|s| s.to_string()).collect())).collect()\n                } else {\n                    self.about_pages()\n                };\n                let page = pages.get(m.tab);\n                if let Some((t, lines)) = page {\n                    b.title(960.0, 60.0, 80.0, TEAL, t);\n                    let mut y = 200.0;\n                    for l in lines {\n                        b.wrap(190.0, y, 1540.0, 38.0, INK, l);\n                        y += 56.0 * (l.len() as f32 / 72.0).ceil().max(1.0) + 14.0;\n                    }\n                }\n                b.prompt(190.0, 985.0, &[Glyph::Tabs], &format!(\"Page {} of {}\", m.tab + 1, pages.len().max(1)));\n                top = 960.0;\n                x0 = 1320.0;\n                x1 = 1730.0;\n            }\n            _ => {}\n        }\n        if !title.is_empty() {\n            b.title((x0 + x1) * 0.5, top - 200.0, 88.0, TEAL, title);\n        }\n        // Tabs.\n        let tabs = self.tabs_of(m);\n        if !tabs.is_empty() && !matches!(m.kind, MenuKind::HowTo | MenuKind::About) {\n            let w = 1760.0 / tabs.len() as f32;\n            for (i, t) in tabs.iter().enumerate() {\n                let x = 80.0 + i as f32 * w;\n                b.items.push(Ui::Button { id: 1000 + i as u16, rect: [x + 6.0, top - 110.0, x + w - 6.0, top - 30.0], label: t.clone(), sub: String::new(), focused: i == m.tab, stars: -1, value: String::new(), fill: None, big: false });\n            }\n            top += 10.0;\n        }\n        // Rows: six in view.\n        let row = if matches!(m.kind, MenuKind::Schedule) { 120.0 } else { 104.0 };\n        for (i, it) in items.iter().enumerate().skip(m.scroll).take(6) {\n            let y = top + (i - m.scroll) as f32 * row;\n            b.items.push(Ui::Button { id: i as u16, rect: [x0, y, x1, y + row - 14.0], label: it.label.clone(), sub: it.sub.clone(), focused: i == m.focus, stars: it.stars, value: it.value.clone(), fill: it.fill, big: false });\n        }\n        if items.len() > 6 {\n            let frac = (m.scroll as f32 / (items.len() - 6) as f32).clamp(0.0, 1.0);\n            b.bar([x1 + 20.0, top, x1 + 40.0, top + row * 6.0 - 14.0], frac, TEAL, Some(frac));\n        }\n        // What the keys do here.\n        if !matches!(m.kind, MenuKind::Title | MenuKind::HowTo | MenuKind::About) {\n            b.prompt(50.0, 1010.0, &[Glyph::Confirm], \"Choose\");\n            b.prompt(350.0, 1010.0, &[Glyph::Back], \"Back\");\n            if !tabs.is_empty() {\n                b.prompt(610.0, 1010.0, &[Glyph::Tabs], \"Tabs\");\n            }\n        }\n        let _ = sim;\n    }\n\n    fn draw_result(&self, b: &mut B) {\n        let Some(r) = self.run.as_ref().and_then(|r| r.result.as_ref()) else { return };\n        let name = self.run.as_ref().map(|r| r.name()).unwrap_or(\"\");\n        b.card([360.0, 40.0, 1560.0, 740.0], DECK);\n        b.center(960.0, 60.0, 44.0, MUTED, name);\n        b.items.push(Ui::Text { pos: [960.0, 100.0], size: 150.0, color: TEAL, align: 1, title: true, text: r.score.to_string(), wrap: 0.0 });\n        b.stars(960.0, 310.0, 62.0, r.stars, 3);\n        b.title(960.0, 370.0, 64.0, CORAL, &r.title);\n        let mut bits = vec![if r.minutes > 0 { format!(\"{} minutes banked\", r.minutes) } else { String::new() }];\n        bits.push(if r.new_best { \"A new best\".to_string() } else { format!(\"Best {}\", r.best) });\n        if let Some(y) = r.yesterday {\n            bits.push(if y >= 0 { format!(\"{y} ahead of Yesterday You\") } else { format!(\"{} behind Yesterday You\", -y) });\n        }\n        let line: Vec<String> = bits.into_iter().filter(|s| !s.is_empty()).collect();\n        b.center(960.0, 470.0, 40.0, INK, &line.join(\". \"));\n        b.wrap_center(960.0, 560.0, 1080.0, 42.0, INK, &format!(\"Pip: \\\"{}\\\"\", r.comment));\n    }\n}\nRS\npython3 - <<'PY'\np='engine/crates/pav_core/src/games/fit/mod.rs'\ns=open(p).read()\ns=s.replace('''    /// Said when the result screen is dismissed.\n    pub pending: Option<Dialog>,\n}''','''    /// Said when the result screen is dismissed.\n    pub pending: Option<Dialog>,\n    /// Dev Mode's Win and Lose Now.\n    pub forced_score: Option<u32>,\n    /// The intro is running: the first morning follows it.\n    pub pending_begin: bool,\n}''')\ns=s.replace('''        pending: None,\n    };''','''        pending: None,\n        forced_score: None,\n        pending_begin: false,\n    };''')\ns=s.replace('''        let score = run.live_score(&self.rules);\n        run.score = score;''','''        let score = self.forced_score.unwrap_or_else(|| run.live_score(&self.rules));\n        run.score = score;''')\ns=s.replace('''            After::Nothing => {}\n            After::StartCheck''','''            After::Nothing => {\n                if std::mem::take(&mut self.pending_begin) {\n                    self.begin_day(sim, ev);\n                }\n            }\n            After::StartCheck''')\nopen(p,'w').write(s)\np='engine/crates/pav_core/src/games/fit/ui_model.rs'\ns=open(p).read()\ns=s.replace('''    /// The input viewer and the dev overlay.\n    pub dev_overlay: bool,\n}''','''    /// The input viewer and the dev overlay.\n    pub dev_overlay: bool,\n    /// How hard the pad should rumble now (0..1): Eyes Closed.\n    pub rumble: f32,\n}''')\nopen(p,'w').write(s)\nPY\ncat > $F/script.toml <<'EOF'\nnames = [\"placeholder-replaced-below\"]\ntitles = [\"x\"]\n[lines]\nEOF\ncd engine && CARGO_BUILD_JOBS=8 cargo check --locked -p pav_core 2>&1 | grep -E \"^(error|warning: unused)|^  -->|^error\" | head -60","description":"Write island, bot and menus, then type-check the game","timeout":300000}}}
