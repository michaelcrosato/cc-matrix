{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjGPgrjr9y59rssLvWkq","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":24211,"cache_read_input_tokens":321203,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":24211},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cb437ba7-0477-4143-bb04-ff33f49efd62","uuid":"6fbca6cb-ebc3-47b0-af04-2359c03286f7","timestamp":"2026-11-05T05:56:44.392Z","request_id":"req_011CgjGPgad8LXBRj6mxeyCv","thinking_duration_ms":2948,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjGPgrjr9y59rssLvWkq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KxhEMjWb7CzFFBtmuTwjC7","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953\nF=engine/crates/pav_core/src/games/fit\npython3 - <<'PY'\np='engine/crates/pav_core/src/games/fit/events/breath.rs'\ns=open(p).read()\ns=s.replace('''                cx.say(cx.pick_static(\"posey_perfect\"), 3.0);''','''                let line = cx.pick(\"posey_perfect\");\n                cx.say(line, 3.0);''')\ns=s[:s.index('impl Cx<\\'_> {')]\nopen(p,'w').write(s)\np='engine/crates/pav_core/src/games/fit/events/pose.rs'\ns=open(p).read()\ns=s.replace('''        if cx.core.cob.length() < 0.001 && cx.core.tips > 0 {\n            self.broken = 1.5;\n        }\n''','')\ns=s.replace('''        let (drift, gull_w) = (r.drift, r.gull_wobble);\n        let _ = drift;\n''','''        let gull_w = r.gull_wobble;\n''')\nopen(p,'w').write(s)\nPY\ncat > $F/events/lap.rs <<'RS'\n//! Morning Lap: alternate steps to set your pace, one lap of the island's ring path, chasing a\n//! bouncing pacer. Lean moves you aside to dodge crabs and towels and to grab ribbons.\n\nuse super::*;\nuse crate::games::fit::sfx;\n\n#[derive(Clone, Copy, Debug, Serialize, Deserialize)]\npub struct Thing {\n    pub id: EntityId,\n    pub s: f32,\n    pub side: f32,\n    pub kind: u8, // 0 obstacle, 1 ribbon\n    pub gone: bool,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Lap {\n    pub t: f32,\n    pub s: f32,\n    pub side: f32,\n    pub pace: f32,\n    last_step: f32,\n    last_foot: u8,\n    pub stitch: f32,\n    stumble: f32,\n    pub zone: f32,\n    pub ribbons: u32,\n    pub bumps: u32,\n    pub things: Vec<Thing>,\n    pacer: Option<EntityId>,\n    pacer_s: f32,\n    center: Vec3,\n    pub length: f32,\n    told: bool,\n    pub done: bool,\n    step_acc: f32,\n}\n\nconst A: f32 = 25.0;\nconst B_: f32 = 18.0;\n\n/// A point on the ring path (0..1 of the lap): the ellipse, centred on the island.\nfn ring(center: Vec3, u: f32) -> (Vec3, Vec3) {\n    let a = u * TAU + PI * 0.5;\n    let p = center + Vec3::new(a.cos() * A, 0.0, a.sin() * B_);\n    let t = Vec3::new(-a.sin() * A, 0.0, a.cos() * B_).normalize();\n    (p, t)\n}\n\nconst LEN: f32 = 136.0;\n\nimpl Lap {\n    pub fn start(cx: &mut Cx, _o: Opt) -> Self {\n        let center = cx.spot(HUB, \"arrive\") + Vec3::new(0.0, 0.0, 2.0);\n        let (p, t) = ring(center, 0.0);\n        cx.player(p, t.x.atan2(t.z));\n        cx.core.wobble = 0.6;\n        let n_o = cx.r.lap.obstacles as u32;\n        let n_r = cx.r.lap.ribbons as u32;\n        let mut things = Vec::new();\n        for k in 0..n_o + n_r {\n            let obstacle = k < n_o;\n            let total = if obstacle { n_o } else { n_r };\n            let idx = if obstacle { k } else { k - n_o };\n            let s = (idx as f32 + 0.4 + cx.rng().range(-0.2, 0.2)) / total.max(1) as f32 * LEN * 0.94 + 4.0;\n            let side = if cx.rng().f32() < 0.5 { -0.8 } else { 0.8 };\n            let (at, tan) = ring(center, s / LEN);\n            let across = Vec3::new(-tan.z, 0.0, tan.x);\n            let pos = at + across * side;\n            let id = if obstacle {\n                match k % 3 {\n                    0 => cx.prop(\"fit_crab\", pos, 0.0, 1.0),\n                    1 => cx.prop_color(\"fit_towel\", pos + Vec3::Y * 0.01, tan.x.atan2(tan.z), 1.0, \"#ff9ec4\"),\n                    _ => cx.prop_color(\"fit_chair\", pos, tan.x.atan2(tan.z), 0.9, \"#ffd166\"),\n                }\n            } else {\n                cx.prop(\"fit_ribbon\", pos + Vec3::Y * 0.25, tan.x.atan2(tan.z), 1.0)\n            };\n            things.push(Thing { id, s, side, kind: if obstacle { 0 } else { 1 }, gone: false });\n        }\n        let pacer = cx.sim.state.entities.iter().find(|e| e.name == \"bounce\" && (e.pos - center).length() < 40.0).map(|e| e.id);\n        cx.ev.push(SimEvent::Music { song: 5 });\n        Self { t: 0.0, s: 0.0, side: 0.0, pace: 0.0, last_step: -1.0, last_foot: 2, stitch: 0.0, stumble: 0.0, zone: 0.0, ribbons: 0, bumps: 0, things, pacer, pacer_s: 8.0, center, length: LEN, told: false, done: false, step_acc: 0.0 }\n    }\n\n    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        let dt = cx.dt;\n        self.t += dt;\n        let r = cx.r.lap.clone();\n        // Alternating feet set the pace.\n        for (p, foot) in [(i.l_p, 0u8), (i.r_p, 1u8)] {\n            if p && foot != self.last_foot {\n                let gap = self.t - self.last_step;\n                if self.last_step >= 0.0 && gap > 0.05 {\n                    self.pace += (1.0 / gap - self.pace) * 0.5;\n                }\n                self.last_step = self.t;\n                self.last_foot = foot;\n                cx.sfx(sfx::STEP, 0.5, 1.0);\n            }\n        }\n        if self.t - self.last_step > 0.8 {\n            self.pace = (self.pace - 3.0 * dt).max(0.0);\n        }\n        let in_zone = self.pace >= r.pace_low && self.pace <= r.pace_high;\n        if in_zone {\n            self.zone += dt;\n            self.stitch = (self.stitch - 0.2 * dt).max(0.0);\n        } else if self.pace > r.pace_high {\n            self.stitch += r.stitch_rate * dt;\n        }\n        if self.stitch >= 1.0 {\n            self.stitch = 0.3;\n            self.stumble = 1.2;\n            cx.gesture(\"FIT/Stumble\");\n            let line = cx.pick(\"bounce_stitch\");\n            cx.say(line, 3.0);\n        }\n        self.stumble = (self.stumble - dt).max(0.0);\n        let speed = if self.stumble > 0.0 { 0.0 } else { self.pace * r.speed_per_step };\n        self.s += speed * dt;\n        self.side += (cx.core.cob.x * r.side_reach - self.side) * (1.0 - (-8.0 * dt).exp());\n        let (p, t) = ring(self.center, (self.s / LEN).fract());\n        let across = Vec3::new(-t.z, 0.0, t.x);\n        let at = p + across * self.side;\n        let yaw = t.x.atan2(t.z);\n        cx.player(at, yaw);\n        // The chase camera follows every tick.\n        let cam = (-t.x).atan2(t.z).to_degrees() + 180.0;\n        let cam_yaw = (t.x.atan2(-t.z)).to_degrees();\n        let _ = cam;\n        *cx.shot = Shot { tilt: 22.0, yaw: cam_yaw, distance: 9.0, fov: 40.0, height: 0.9, focus: at };\n        cx.clip(\"MESH2MOTION/Jog\", (self.pace / 2.0).clamp(0.05, 1.8));\n        cx.lean_body_by(Vec2::new(cx.core.cob.x, 0.0), cam_yaw, 0.0);\n        // Lean: x is sideways on this camera; across is its right.\n        for th in self.things.iter_mut() {\n            if th.gone || (th.s - self.s).abs() > 0.7 {\n                continue;\n            }\n            if (th.side - self.side).abs() < 0.65 {\n                th.gone = true;\n                if th.kind == 1 {\n                    self.ribbons += 1;\n                    let id = th.id;\n                    cx.sim.despawn(id);\n                    cx.sfx(sfx::CHIME, 0.6, penta(self.ribbons));\n                } else {\n                    self.bumps += 1;\n                    self.stumble = 0.8;\n                    self.pace *= 0.6;\n                    cx.gesture(\"FIT/Stumble\");\n                    cx.sfx(sfx::SQUEAK, 0.7, 0.8);\n                }\n            }\n        }\n        // Flip-flops on the way.\n        for k in 0..5 {\n            if !cx.flops[k] {\n                if let Some(id) = cx.flop_ids[k] {\n                    if cx.sim.state.entities.get(id).is_some_and(|e| (e.pos - at).length() < 1.6) {\n                        cx.flops[k] = true;\n                        cx.sim.despawn(id);\n                        cx.sfx(sfx::POP, 0.7, 1.4);\n                        cx.say(\"A flip-flop. Someone will be glad. Someone is always glad.\", 3.0);\n                    }\n                }\n            }\n        }\n        // Bounce rolls ahead and gets away if you dawdle.\n        let gap = self.pacer_s - self.s;\n        let pacer_speed = if gap > 14.0 { 0.0 } else { 3.3 + if gap < 4.0 { 2.0 } else { 0.0 } };\n        self.pacer_s += pacer_speed * dt;\n        if let Some(id) = self.pacer {\n            let (pp, pt) = ring(self.center, (self.pacer_s / LEN).fract());\n            cx.sim.set_position(id, pp);\n            let f = pt.x.atan2(pt.z);\n            if let Some(ch) = cx.sim.state.entities.get_mut(id).and_then(|e| e.character.as_mut()) {\n                ch.facing = f;\n                ch.anim.facing = f;\n                ch.anim.lift = (self.t * 6.0).sin().abs() * 0.5;\n            }\n        }\n        if gap > 12.0 && !self.told {\n            self.told = true;\n            let line = cx.pick(\"bounce_far\");\n            cx.say(line, 3.0);\n        }\n        if self.s >= LEN {\n            self.done = true;\n            if let Some(id) = self.pacer {\n                let home = cx.spot(HUB, \"bounce\");\n                cx.sim.set_position(id, home);\n            }\n            return true;\n        }\n        if self.t >= r.seconds {\n            if let Some(id) = self.pacer {\n                let home = cx.spot(HUB, \"bounce\");\n                cx.sim.set_position(id, home);\n            }\n            return true;\n        }\n        false\n    }\n\n    pub fn bot(&self, core: &BalanceCore, _r: &Rules) -> Intent {\n        let mut i = Intent::default();\n        // Two steps a second; a press lands on whichever tick crosses the half-second.\n        let step = (self.t * 2.0) as u32;\n        let before = ((self.t - 1.0 / 60.0) * 2.0) as u32;\n        if step != before {\n            if step % 2 == 0 {\n                i.l_p = true;\n                i.l = true;\n            } else {\n                i.r_p = true;\n                i.r = true;\n            }\n        }\n        // Steer for the next ribbon, around the next obstacle.\n        let mut want = 0.0;\n        if let Some(ob) = self.things.iter().filter(|t| !t.gone && t.s > self.s - 0.5 && t.s < self.s + 6.0).min_by(|a, b| a.s.total_cmp(&b.s)) {\n            want = if ob.kind == 1 { ob.side } else { -ob.side };\n        }\n        i.lean = pd(core, Vec2::new(want / 1.2, 0.0));\n        i\n    }\n\n    pub fn hud(&self, b: &mut B, core: &BalanceCore, r: &Rules) {\n        timer(b, r.lap.seconds - self.t);\n        b.puck(PUCK_TOP, PUCK_R, core.cob.into());\n        b.flat([560.0, 960.0, 1360.0, 1020.0], PALE, 28.0);\n        let m = r.lap.pace_high * 1.5;\n        b.flat([560.0 + 800.0 * r.lap.pace_low / m, 960.0, 560.0 + 800.0 * r.lap.pace_high / m, 1020.0], MINT, 28.0);\n        b.circle([560.0 + 800.0 * (self.pace / m).clamp(0.0, 1.0), 990.0], 38.0, TEAL, WHITE, 5.0);\n        b.center(960.0, 900.0, 40.0, INK, \"Pace\");\n        b.prompt(60.0, 940.0, &[Glyph::StepL, Glyph::StepR], \"Alternate\");\n        if self.stitch > 0.05 {\n            b.text(60.0, 860.0, 40.0, CORAL, \"Stitch\");\n            b.bar([190.0, 868.0, 460.0, 900.0], self.stitch.min(1.0), CORAL, None);\n        }\n        b.right(1860.0, 450.0, 44.0, INK, &format!(\"Ribbons {}\", self.ribbons));\n        b.bar([560.0, 40.0, 1360.0, 70.0], (self.s / LEN).min(1.0), TEAL, None);\n    }\n\n    pub fn score(&self, r: &Rules) -> f32 {\n        let zone = self.zone / r.lap.seconds.min(LEN / (2.0 * r.lap.speed_per_step));\n        700.0 * zone.min(1.0) + 300.0 * self.ribbons as f32 / r.lap.ribbons.max(1.0) - 25.0 * self.bumps as f32\n    }\n}\nRS\ncat > $F/events/tide.rs <<'RS'\n//! Tide Table: you stand on a raft and your lean tilts it. Roll hermit crabs into tide pools.\n\nuse super::*;\nuse crate::games::fit::sfx;\n\n#[derive(Clone, Copy, Debug, Serialize, Deserialize)]\npub struct Shell {\n    pub id: EntityId,\n    pub p: Vec2,\n    pub v: Vec2,\n    pub potted: bool,\n}\n\n#[derive(Clone, Copy, Debug, Serialize, Deserialize)]\npub struct Pool {\n    pub id: EntityId,\n    pub p: Vec2,\n    pub moving: bool,\n}\n\n#[derive(Clone, Copy, Debug, Serialize, Deserialize)]\npub struct Bumper {\n    pub id: EntityId,\n    pub p: Vec2,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Tide {\n    pub t: f32,\n    pub board: u32,\n    pub shells: Vec<Shell>,\n    pub pools: Vec<Pool>,\n    pub bumpers: Vec<Bumper>,\n    pub potted: u32,\n    pub time_bonus: f32,\n    raft: Option<EntityId>,\n    center: Vec3,\n    pub half: f32,\n    tide_level: f32,\n    roll_t: f32,\n    seed: u32,\n}\n\nconst BOARD_SHELLS: [u32; 3] = [3, 5, 7];\npub const TOTAL: u32 = 15;\n\nimpl Tide {\n    pub fn start(cx: &mut Cx, _o: Opt) -> Self {\n        let center = cx.spot(TIDE, \"center\");\n        let raft = cx.prop(\"fit_raft\", center, 0.0, 1.0);\n        cx.player(center + Vec3::Y * 0.02, 0.0);\n        cx.core.wobble = 0.5;\n        *cx.shot = Shot { tilt: 62.0, yaw: 0.0, distance: 13.0, fov: 40.0, height: 0.0, focus: center };\n        let mut s = Self { t: 0.0, board: 0, shells: Vec::new(), pools: Vec::new(), bumpers: Vec::new(), potted: 0, time_bonus: 0.0, raft: Some(raft), center, half: cx.r.tide.half, tide_level: 0.0, roll_t: 0.0, seed: cx.seed };\n        s.lay(cx);\n        cx.ev.push(SimEvent::Music { song: 5 });\n        s\n    }\n\n    /// A number the same on every copy with the same seed (the medley's rule).\n    fn sr(&mut self, k: u32) -> f32 {\n        let x = (self.seed.wrapping_mul(2654435761).wrapping_add(k.wrapping_mul(40503))) >> 8;\n        (x % 10000) as f32 / 10000.0\n    }\n\n    fn lay(&mut self, cx: &mut Cx) {\n        for s in self.shells.drain(..) {\n            cx.sim.despawn(s.id);\n        }\n        for p in self.pools.drain(..) {\n            cx.sim.despawn(p.id);\n        }\n        for b in self.bumpers.drain(..) {\n            cx.sim.despawn(b.id);\n        }\n        let h = self.half;\n        let n = BOARD_SHELLS[self.board as usize];\n        let pools = 2 + self.board;\n        for k in 0..pools {\n            let a = self.sr(k * 7 + self.board * 31) * TAU;\n            let r = 0.55 + 0.3 * self.sr(k * 11 + 3);\n            let p = Vec2::new(a.cos(), a.sin()) * h * r;\n            let id = cx.prop(\"fit_pool\", self.world(p, 0.02), 0.0, 1.15);\n            self.pools.push(Pool { id, p, moving: self.board == 1 && k == 0 });\n        }\n        if self.board == 2 {\n            for k in 0..4 {\n                let a = k as f32 * TAU / 4.0 + 0.5;\n                let p = Vec2::new(a.cos(), a.sin()) * h * 0.42;\n                let id = cx.prop(\"fit_bumper\", self.world(p, 0.02), 0.0, 0.8);\n                self.bumpers.push(Bumper { id, p });\n            }\n        }\n        for k in 0..n {\n            let a = self.sr(k * 13 + 100 + self.board * 17) * TAU;\n            let p = Vec2::new(a.cos(), a.sin()) * h * (0.2 + 0.5 * self.sr(k * 3 + 200));\n            let id = cx.prop(\"fit_shell\", self.world(p, 0.0), a, 1.2);\n            self.shells.push(Shell { id, p, v: Vec2::ZERO, potted: false });\n        }\n    }\n\n    /// Raft space (x right, y away from the camera) to the world, on the tilted deck.\n    fn world(&self, p: Vec2, lift: f32) -> Vec3 {\n        self.center + Vec3::new(p.x, lift - self.tide_level, -p.y)\n    }\n\n    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        let dt = cx.dt;\n        self.t += dt;\n        let r = cx.r.tide.clone();\n        let tilt = cx.core.cob;\n        // Static friction: a nearly flat raft holds its shells still.\n        let g = if tilt.length() < 0.1 { Vec2::ZERO } else { tilt * r.gravity };\n        let mut rolling = 0.0f32;\n        // Board 3: the tide comes in and the raft gets smaller.\n        if self.board == 2 {\n            self.half = (self.half - 0.012 * dt).max(r.half * 0.7);\n            self.tide_level = (self.tide_level + 0.003 * dt).min(0.05);\n        }\n        let h = self.half;\n        for k in 0..self.pools.len() {\n            if self.pools[k].moving {\n                let w = self.t * 0.5;\n                self.pools[k].p = Vec2::new(w.cos(), w.sin()) * h * 0.6;\n                let id = self.pools[k].id;\n                let at = self.world(self.pools[k].p, 0.02);\n                cx.place(id, at, Quat::IDENTITY);\n            }\n        }\n        let pools: Vec<Vec2> = self.pools.iter().map(|p| p.p).collect();\n        let bumpers: Vec<Vec2> = self.bumpers.iter().map(|b| b.p).collect();\n        let mut plops = 0;\n        for s in self.shells.iter_mut().filter(|s| !s.potted) {\n            s.v += (g - s.v * r.friction) * dt;\n            s.p += s.v * dt;\n            for (axis, lim) in [(0, h), (1, h)] {\n                let c = if axis == 0 { &mut s.p.x } else { &mut s.p.y };\n                let v = if axis == 0 { &mut s.v.x } else { &mut s.v.y };\n                if c.abs() > lim - 0.2 {\n                    *c = c.signum() * (lim - 0.2);\n                    *v *= -0.5;\n                }\n            }\n            for b in &bumpers {\n                let d = s.p - *b;\n                if d.length() < 0.5 {\n                    let n = d.normalize_or(Vec2::X);\n                    s.p = *b + n * 0.5;\n                    s.v = (s.v - n * 2.0 * s.v.dot(n)) * 0.8 + n * 0.8;\n                    plops += 100;\n                }\n            }\n            rolling = rolling.max(s.v.length());\n            // Fast shells skip over a pool.\n            if s.v.length() < r.skip_speed && pools.iter().any(|p| (*p - s.p).length() < r.pool_radius) {\n                s.potted = true;\n                plops += 1;\n            }\n        }\n        if plops % 100 > 0 {\n            self.potted += plops % 100;\n            cx.sfx(sfx::PLOP, 0.8, penta(self.potted));\n            let at = self.center + Vec3::Y * 0.3;\n            cx.ev.push(SimEvent::Burst { pos: at, kind: 2, count: 12 });\n        }\n        if plops >= 100 {\n            cx.sfx(sfx::BOING, 0.5, 1.0);\n        }\n        self.roll_t -= dt;\n        if rolling > 0.3 && self.roll_t <= 0.0 {\n            self.roll_t = 0.12;\n            cx.sfx(sfx::ROLL, (rolling / 3.0).min(1.0), 0.8 + rolling * 0.2);\n        }\n        // Draw: raft, pools and shells on the tilted plane.\n        let tilt_q = Quat::from_rotation_z(-tilt.x * 0.12) * Quat::from_rotation_x(-tilt.y * 0.12);\n        if let Some(raft) = self.raft {\n            let at = self.center - Vec3::Y * self.tide_level;\n            cx.place(raft, at, tilt_q);\n        }\n        let plane = |p: Vec2, c: Vec3| c + tilt_q * Vec3::new(p.x, 0.0, -p.y);\n        let base = self.center - Vec3::Y * self.tide_level;\n        for s in &self.shells {\n            let pos = if s.potted { base + Vec3::new(s.p.x, -2.0, -s.p.y) } else { plane(s.p, base) };\n            let heading = s.v.y.atan2(s.v.x);\n            cx.place(s.id, pos + Vec3::Y * 0.02, tilt_q * Quat::from_rotation_y(heading));\n        }\n        for k in 0..self.pools.len() {\n            let (id, p) = (self.pools[k].id, self.pools[k].p);\n            cx.place(id, plane(p, base) + Vec3::Y * 0.015, tilt_q);\n        }\n        for k in 0..self.bumpers.len() {\n            let (id, p) = (self.bumpers[k].id, self.bumpers[k].p);\n            cx.place(id, plane(p, base), tilt_q);\n        }\n        cx.player(base + Vec3::Y * 0.02, 0.0);\n        cx.lean_body(0.0);\n        let _ = i;\n        // Next board, or the end.\n        if self.shells.iter().all(|s| s.potted) {\n            self.board += 1;\n            cx.sfx(sfx::STAR, 0.8, 1.5);\n            if self.board >= 3 {\n                self.time_bonus = (r.seconds - self.t).max(0.0) / r.seconds;\n                return true;\n            }\n            self.half = r.half;\n            let msg = if self.board == 1 { \"One pool has wandered off. Do not take it personally.\" } else { \"The tide is coming in. It does this. Nobody has complained.\" };\n            cx.say(msg, 3.0);\n            self.lay(cx);\n        }\n        self.t >= r.seconds\n    }\n\n    pub fn bot(&self, core: &BalanceCore, r: &Rules) -> Intent {\n        let mut i = Intent::default();\n        // Steer the nearest shell toward its nearest pool; the others come along.\n        let mut best: Option<(f32, Shell, Vec2)> = None;\n        for s in self.shells.iter().filter(|s| !s.potted) {\n            for p in &self.pools {\n                let d = (p.p - s.p).length();\n                if best.as_ref().is_none_or(|b| d < b.0) {\n                    best = Some((d, *s, p.p));\n                }\n            }\n        }\n        if let Some((_, s, pool)) = best {\n            // Desired acceleration: to the pool, braking near it. Avoid bumpers by aiming aside.\n            let mut aim = pool;\n            for b in &self.bumpers {\n                let d = s.p - b.p;\n                if d.length() < 1.0 {\n                    aim += d.normalize_or(Vec2::X) * 1.0;\n                }\n            }\n            let to = aim - s.p;\n            let want_v = to.clamp_length_max(1.8);\n            let acc = (want_v - s.v) * 4.0;\n            let lean = (acc + s.v * r.tide.friction) / r.tide.gravity;\n            // Below the raft's static grip nothing moves, so always tilt past it.\n            let lean = if lean.length() < 0.16 && to.length() > 0.2 { lean.normalize_or(Vec2::X) * 0.16 } else { lean };\n            i.lean = pd(core, lean.clamp_length_max(0.8));\n        }\n        i\n    }\n\n    pub fn hud(&self, b: &mut B, core: &BalanceCore, r: &Rules) {\n        timer(b, r.tide.seconds - self.t);\n        b.puck(PUCK_TOP, PUCK_R, core.cob.into());\n        b.right(1860.0, 450.0, 44.0, INK, &format!(\"Board {} of 3\", (self.board + 1).min(3)));\n        let left = self.shells.iter().filter(|s| !s.potted).count();\n        b.right(1860.0, 510.0, 44.0, INK, &format!(\"{left} crabs to go\"));\n    }\n\n    pub fn score(&self, _r: &Rules) -> f32 {\n        800.0 * self.potted as f32 / TOTAL as f32 + 200.0 * self.time_bonus\n    }\n}\nRS\ncat > $F/events/paddle.rs <<'RS'\n//! Paddle Slalom: stand on a board on a long channel and pass buoy gates. Lean x steers, forward\n//! speeds up and risks tipping, back brakes.\n\nuse super::*;\nuse crate::games::fit::sfx;\n\n#[derive(Clone, Copy, Debug, Serialize, Deserialize)]\npub struct Gate {\n    pub z: f32,\n    pub x: f32,\n    pub passed: bool,\n    pub missed: bool,\n    pub id: [EntityId; 2],\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Paddle {\n    pub t: f32,\n    pub pos: Vec3,\n    pub start: Vec3,\n    pub gates: Vec<Gate>,\n    pub missed: u32,\n    pub passed: u32,\n    remount: f32,\n    gust_in: f32,\n    gust_for: f32,\n    pub gust: Vec2,\n    board: Option<EntityId>,\n    wake: u32,\n    pub finish: f32,\n    pub done: bool,\n    pub speed: f32,\n    streaks: Vec<EntityId>,\n    seed: u32,\n}\n\nconst CAM: f32 = 180.0;\n\nimpl Paddle {\n    pub fn start(cx: &mut Cx, _o: Opt) -> Self {\n        let start = cx.spot(CHANNEL, \"start\");\n        let n = cx.r.paddle.gates as u32;\n        let mut gates = Vec::new();\n        let seed = cx.seed;\n        let sr = |k: u32| ((seed.wrapping_mul(2654435761).wrapping_add(k.wrapping_mul(40503))) >> 8) as f32 % 10000.0 / 10000.0;\n        let w = cx.r.paddle.gate_width;\n        for k in 0..n {\n            let z = start.z + 18.0 + k as f32 * 15.0;\n            let x = start.x + (sr(k) - 0.5) * 16.0;\n            let a = cx.prop(\"fit_buoy\", Vec3::new(x - w, -0.05, z), 0.0, 1.0);\n            let b = cx.prop(\"fit_buoy\", Vec3::new(x + w, -0.05, z), 0.0, 1.0);\n            gates.push(Gate { z, x, passed: false, missed: false, id: [a, b] });\n        }\n        let finish = start.z + 18.0 + n as f32 * 15.0;\n        let board = cx.prop(\"fit_paddleboard\", start, 0.0, 1.0);\n        let mut streaks = Vec::new();\n        for _ in 0..4 {\n            streaks.push(cx.ball(0.0, \"#ffffff\", start - Vec3::Y * 9.0));\n        }\n        cx.player(start, 0.0);\n        cx.core.wobble = cx.r.paddle.wobble;\n        cx.clip(\"FIT/Paddle\", 1.0);\n        *cx.shot = Shot { tilt: 22.0, yaw: CAM, distance: 10.0, fov: 40.0, height: 1.0, focus: start };\n        cx.ev.push(SimEvent::Music { song: 5 });\n        Self { t: 0.0, pos: start, start, gates, missed: 0, passed: 0, remount: 0.0, gust_in: 4.0, gust_for: 0.0, gust: Vec2::ZERO, board: Some(board), wake: 0, finish, done: false, speed: 0.0, streaks, seed }\n    }\n\n    pub fn tick(&mut self, cx: &mut Cx, _i: &Intent) -> bool {\n        let dt = cx.dt;\n        self.t += dt;\n        let r = cx.r.paddle.clone();\n        // Gusts, shown as streaks on the water, push the dot.\n        self.gust_in -= dt;\n        if self.gust_in <= 0.0 {\n            self.gust_in = cx.rng().range(4.0, 8.0);\n            self.gust_for = 2.0;\n            let a = cx.rng().range(0.0, TAU);\n            self.gust = Vec2::new(a.cos(), a.sin() * 0.5) * r.gust * 2.0;\n            cx.sfx(sfx::GUST, 0.7, 1.0);\n        }\n        if self.gust_for > 0.0 {\n            self.gust_for -= dt;\n            cx.core.gust = self.gust;\n        } else {\n            cx.core.gust = Vec2::ZERO;\n        }\n        if self.remount > 0.0 {\n            self.remount -= dt;\n            self.speed = 0.0;\n            let u = clamp01(1.0 - self.remount / r.remount);\n            cx.player(self.pos - Vec3::Y * (1.0 - u) * 1.1, 0.0);\n        } else {\n            let cob = cx.core.cob;\n            // Screen right is world -X with the camera looking along +Z.\n            let forward = cob.y.max(0.0);\n            let back = (-cob.y).max(0.0);\n            let target = (r.cruise + (r.sprint - r.cruise) * forward) * (1.0 - back * 0.8);\n            self.speed += (target - self.speed) * (1.0 - (-3.0 * dt).exp());\n            self.pos.z += self.speed * dt;\n            self.pos.x -= cob.x * r.steer * dt;\n            self.pos.x = self.pos.x.clamp(self.start.x - 13.0, self.start.x + 13.0);\n            cx.player(self.pos, 0.0);\n            self.wake += 1;\n            if self.wake % 5 == 0 {\n                cx.ev.push(SimEvent::Wake { pos: self.pos - Vec3::Z * 1.2 });\n            }\n        }\n        if let Some(b) = self.board {\n            let tilt = Quat::from_rotation_z(cx.core.cob.x * 0.1) * Quat::from_rotation_x(-cx.core.cob.y * 0.1);\n            cx.place(b, self.pos + Vec3::Y * 0.0, tilt);\n        }\n        let n = self.streaks.len();\n        for k in 0..n {\n            let id = self.streaks[k];\n            let vis = self.gust_for > 0.0;\n            let a = k as f32 * 1.7;\n            let at = self.pos + Vec3::new((self.gust.x.signum()) * ((self.t * 6.0 + a).fract() * 9.0 - 4.0), 0.1, 6.0 + k as f32 * 2.0);\n            if let Some(e) = cx.sim.state.entities.get_mut(id) {\n                e.pos = if vis { at } else { self.start - Vec3::Y * 9.0 };\n                if let Some(v) = &mut e.visual {\n                    v.shape = crate::shape::Shape::Capsule { half_height: 0.9, radius: 0.04 };\n                    v.color = Color::hex(\"#ffffff\");\n                }\n                e.rot = Quat::from_rotation_z(std::f32::consts::FRAC_PI_2);\n            }\n        }\n        let pz = self.pos.z;\n        let px = self.pos.x;\n        let mut pass = 0;\n        let mut miss = 0;\n        for g in self.gates.iter_mut().filter(|g| !g.passed && !g.missed) {\n            if pz >= g.z {\n                if (px - g.x).abs() <= r.gate_width {\n                    g.passed = true;\n                    pass += 1;\n                } else {\n                    g.missed = true;\n                    miss += 1;\n                }\n            }\n        }\n        if pass > 0 {\n            self.passed += pass;\n            cx.ev.push(SimEvent::Gate { pos: self.pos, ok: true });\n        }\n        if miss > 0 {\n            self.missed += miss;\n            cx.ev.push(SimEvent::Gate { pos: self.pos, ok: false });\n            cx.say(\"A gate was missed. It has been told.\", 2.0);\n        }\n        *cx.shot = Shot { tilt: 22.0, yaw: CAM, distance: 10.0, fov: 40.0, height: 1.0, focus: self.pos };\n        cx.lean_body(CAM);\n        if pz >= self.finish {\n            self.done = true;\n            return true;\n        }\n        self.t >= 90.0\n    }\n\n    /// The core tipped: a big splash and a remount.\n    pub fn on_tip(&mut self, cx: &mut Cx) {\n        self.remount = cx.r.paddle.remount;\n        cx.ev.push(SimEvent::BigSplash { pos: self.pos, size: 0.45 });\n        cx.sfx(sfx::SPLASH_B, 0.7, 1.2);\n        let line = cx.pick(\"gull_tip\");\n        cx.say(line, 2.5);\n    }\n\n    pub fn bot(&self, core: &BalanceCore, _r: &Rules) -> Intent {\n        let mut i = Intent::default();\n        let want = self.gates.iter().find(|g| !g.passed && !g.missed).map(|g| g.x).unwrap_or(self.start.x);\n        // Screen right is world -X.\n        let steer = ((self.pos.x - want) * 0.35).clamp(-0.8, 0.8);\n        i.lean = pd(core, Vec2::new(steer, 0.5));\n        i\n    }\n\n    fn time(&self) -> f32 {\n        self.t + 2.0 * self.missed as f32\n    }\n\n    pub fn hud(&self, b: &mut B, core: &BalanceCore, r: &Rules) {\n        b.title_left(60.0, 30.0, 80.0, INK, &format!(\"{:.1}\", self.time()));\n        b.text(60.0, 130.0, 40.0, INK, &format!(\"Par {:.0}\", r.paddle.par));\n        b.puck(PUCK_TOP, PUCK_R, core.cob.into());\n        b.bar([560.0, 40.0, 1360.0, 70.0], ((self.pos.z - self.start.z) / (self.finish - self.start.z)).clamp(0.0, 1.0), TEAL, None);\n        b.right(1860.0, 450.0, 44.0, INK, &format!(\"Gates {}\", self.passed));\n        if self.gust_for > 0.0 {\n            b.center(960.0, 120.0, 56.0, CORAL, \"Gust!\");\n        }\n    }\n\n    pub fn score(&self, r: &Rules) -> f32 {\n        if !self.done {\n            // While under way, and on timing out: how far you got, at most half.\n            let frac = ((self.pos.z - self.start.z) / (self.finish - self.start.z)).clamp(0.0, 1.0);\n            let _ = self.seed;\n            return if self.t >= 90.0 { 0.0 } else { 300.0 * frac };\n        }\n        ((1.6 * r.paddle.par - self.time()) / (0.8 * r.paddle.par)).clamp(0.0, 1.0) * 1000.0\n    }\n}\nRS\ncat > $F/events/tray.rs <<'RS'\n//! Tray Trek: walk a long pier carrying five smoothies. Waves, gaps and gulls jolt the tray; your\n//! dot tilts it; glasses slide with the tilt and plop into the sea.\n\nuse super::*;\nuse crate::games::fit::sfx;\n\n#[derive(Clone, Copy, Debug, Serialize, Deserialize)]\npub struct Glass {\n    pub id: EntityId,\n    pub p: Vec2,\n    pub v: Vec2,\n    pub fall: f32,\n    pub gone: bool,\n}\n\n#[derive(Clone, Copy, Debug, Serialize, Deserialize)]\npub struct Jolt {\n    pub at: f32,\n    pub dir: Vec2,\n    pub kind: u8,\n    pub done: bool,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Tray {\n    pub t: f32,\n    pub pos: Vec3,\n    pub start: Vec3,\n    pub end: Vec3,\n    pub glasses: Vec<Glass>,\n    pub jolts: Vec<Jolt>,\n    tray: Option<EntityId>,\n    gull: Option<EntityId>,\n    gull_t: f32,\n    pub arrived: bool,\n    pub lost: u32,\n    pub sway: Vec2,\n    tilt: Vec2,\n    over: f32,\n    told: bool,\n}\n\nconst COLORS: [&str; 5] = [\"#ff9ec4\", \"#ffd166\", \"#78dcaa\", \"#ff786e\", \"#c7b1ec\"];\nconst CAM: f32 = 180.0;\n\nimpl Tray {\n    pub fn start(cx: &mut Cx, _o: Opt) -> Self {\n        let start = cx.spot(PIER, \"start\");\n        let end = cx.spot(PIER, \"end\");\n        cx.player(start, 0.0);\n        cx.core.wobble = 0.7;\n        cx.clip(\"STYLE100/Balance_Walk\", 1.0);\n        *cx.shot = Shot { tilt: 24.0, yaw: CAM, distance: 7.0, fov: 40.0, height: 1.1, focus: start };\n        let tray = cx.prop(\"fit_tray\", start + Vec3::Y * 1.25, 0.0, 1.0);\n        let mut glasses = Vec::new();\n        for k in 0..5 {\n            let a = k as f32 * TAU / 5.0;\n            let p = if k == 4 { Vec2::ZERO } else { Vec2::new(a.cos(), a.sin()) * 0.2 };\n            let id = cx.prop_color(\"fit_smoothie\", start + Vec3::Y * 1.3, 0.0, 0.9, COLORS[k]);\n            glasses.push(Glass { id, p, v: Vec2::ZERO, fall: 0.0, gone: false });\n        }\n        // The jolts are known in advance: a plank gap, a wave, a gull. The bot leans ahead of them.\n        let walk = (end.z - start.z) / cx.r.tray.pace;\n        let n = 12;\n        let mut jolts = Vec::new();\n        for k in 0..n {\n            let at = 3.0 + (walk - 6.0) * k as f32 / n as f32 + cx.rng().range(-0.5, 0.5);\n            let a = cx.rng().range(0.0, TAU);\n            jolts.push(Jolt { at, dir: Vec2::new(a.cos(), a.sin()), kind: (k % 3) as u8, done: false });\n        }\n        let gull = cx.prop(\"fit_gull\", start + Vec3::new(0.0, 8.0, 0.0), 0.0, 1.0);\n        Self { t: 0.0, pos: start, start, end, glasses, jolts, tray: Some(tray), gull: Some(gull), gull_t: 0.0, arrived: false, lost: 0, sway: Vec2::ZERO, tilt: Vec2::ZERO, over: 0.0, told: false }\n    }\n\n    fn sway_at(t: f32) -> Vec2 {\n        Vec2::new((t * 0.9).sin() + 0.4 * (t * 2.3).sin(), 0.5 * (t * 1.3 + 1.0).sin())\n    }\n\n    pub fn tick(&mut self, cx: &mut Cx, _i: &Intent) -> bool {\n        let dt = cx.dt;\n        self.t += dt;\n        let r = cx.r.tray.clone();\n        if self.arrived {\n            self.over += dt;\n            cx.player(self.pos, 0.0);\n            return self.over > 1.5;\n        }\n        self.pos.z += r.pace * dt;\n        cx.player(self.pos, 0.0);\n        cx.clip(\"STYLE100/Balance_Walk\", 1.0);\n        // The pier rolls under you: the tray leans with it unless you counter.\n        self.sway = Self::sway_at(self.t) * r.sway;\n        self.tilt = cx.core.cob + self.sway;\n        for j in self.jolts.iter_mut() {\n            if !j.done && self.t >= j.at {\n                j.done = true;\n                cx.core.nudge += j.dir * r.jolt * 5.0;\n                let kick = j.dir * 0.32 * (r.jolt / 26.0);\n                for g in self.glasses.iter_mut().filter(|g| !g.gone) {\n                    g.v += kick;\n                }\n                match j.kind {\n                    0 => {\n                        cx.sfx(sfx::CREAK, 0.8, 1.0);\n                        cx.say(\"A plank gap. Who put that there. Pip knows.\", 1.6);\n                    }\n                    1 => {\n                        cx.sfx(sfx::WAVE, 0.7, 1.2);\n                        cx.ev.push(SimEvent::Splash { pos: self.pos + Vec3::X * 2.2 });\n                    }\n                    _ => {\n                        self.gull_t = 1.6;\n                        cx.sfx(sfx::GULL, 0.9, 1.0);\n                    }\n                }\n            }\n        }\n        if self.gull_t > 0.0 {\n            self.gull_t -= dt;\n            let u = self.gull_t / 1.6;\n            if let Some(g) = self.gull {\n                let at = self.pos + Vec3::new((u - 0.5) * 12.0, 1.8 + 3.0 * (u - 0.5).abs() * 2.0, 0.5);\n                cx.place(g, at, Quat::from_rotation_y(1.57));\n            }\n        }\n        let tray_at = self.pos + Vec3::Y * 1.25 + Vec3::new(0.0, 0.0, 0.34);\n        let q = Quat::from_rotation_z(self.tilt.x * 0.22) * Quat::from_rotation_x(-self.tilt.y * 0.22);\n        if let Some(t) = self.tray {\n            cx.place(t, tray_at, q);\n        }\n        let mut plops = 0;\n        for g in self.glasses.iter_mut() {\n            if g.gone {\n                continue;\n            }\n            if g.fall > 0.0 {\n                g.fall += dt;\n                let at = tray_at + Vec3::new(-g.p.x, 0.0, g.p.y) - Vec3::Y * 4.9 * g.fall * g.fall;\n                if at.y < 0.0 {\n                    g.gone = true;\n                    plops += 1;\n                }\n                if let Some(e) = cx.sim.state.entities.get_mut(g.id) {\n                    e.pos = at;\n                }\n                continue;\n            }\n            g.v += (self.tilt * r.slide - g.v * r.friction) * dt;\n            g.p += g.v * dt;\n            if g.p.length() > r.edge {\n                g.fall = 0.001;\n            }\n            let at = tray_at + q * Vec3::new(-g.p.x, 0.03, g.p.y);\n            if let Some(e) = cx.sim.state.entities.get_mut(g.id) {\n                e.pos = at;\n                e.rot = q;\n            }\n        }\n        if plops > 0 {\n            self.lost += plops;\n            cx.sfx(sfx::GLASS, 0.9, 1.0);\n            cx.ev.push(SimEvent::Splash { pos: self.pos + Vec3::new(2.2, 0.0, 0.0) });\n            if !self.told {\n                self.told = true;\n                let line = cx.pick(\"gull_glass\");\n                cx.say(line, 3.0);\n            }\n        }\n        *cx.shot = Shot { tilt: 24.0, yaw: CAM, distance: 7.0, fov: 40.0, height: 1.1, focus: self.pos };\n        cx.lean_body(CAM);\n        if self.pos.z >= self.end.z {\n            self.arrived = true;\n            let line = match self.delivered() {\n                5 => cx.pick(\"marjorie_all\"),\n                0 => cx.pick(\"marjorie_none\"),\n                _ => cx.pick(\"marjorie_some\"),\n            };\n            cx.say(line, 3.0);\n            cx.gesture(\"FIT/Bow\");\n            cx.sfx(sfx::CHEER, 0.6, 1.0);\n        }\n        false\n    }\n\n    pub fn delivered(&self) -> u32 {\n        self.glasses.iter().filter(|g| !g.gone && g.fall <= 0.0).count() as u32\n    }\n\n    pub fn bot(&self, core: &BalanceCore, r: &Rules) -> Intent {\n        let mut i = Intent::default();\n        // Counter the pier's roll, and lean back against the next known jolt as it lands. The\n        // tray is level again when `cob + sway` is zero, so aim the dot at minus the sway.\n        let sway = Self::sway_at(self.t + 0.1) * r.tray.sway;\n        let mut want = -sway;\n        // Pull the worst glass back toward the middle.\n        if let Some(g) = self.glasses.iter().filter(|g| !g.gone && g.fall <= 0.0).max_by(|a, b| a.p.length().total_cmp(&b.p.length())) {\n            want += -g.p * 1.1 - g.v * 0.5;\n        }\n        i.lean = pd(core, want);\n        i\n    }\n\n    pub fn hud(&self, b: &mut B, core: &BalanceCore, r: &Rules) {\n        // The tray from above: the player's view of what is about to happen.\n        let c = [260.0, 260.0];\n        let s = 180.0 / r.tray.edge;\n        b.puck(PUCK_TOP, PUCK_R, (core.cob + self.sway).clamp_length_max(1.0).into());\n        b.puck_ring((-self.sway).clamp_length_max(1.0).into(), 0.3);\n        b.circle(c, r.tray.edge * s, DECK, TEAL, 10.0);\n        for (k, g) in self.glasses.iter().enumerate() {\n            if !g.gone && g.fall <= 0.0 {\n                let col = [CORAL, SUN, MINT, TEAL, INK][k % 5];\n                b.circle([c[0] + g.p.x * s, c[1] - g.p.y * s], 26.0, col, WHITE, 4.0);\n            }\n        }\n        b.bar([560.0, 40.0, 1360.0, 70.0], ((self.pos.z - self.start.z) / (self.end.z - self.start.z)).clamp(0.0, 1.0), TEAL, None);\n    }\n\n    pub fn score(&self, r: &Rules) -> f32 {\n        let d = self.delivered();\n        (1000.0 - r.tray.no_spill_bonus) / 5.0 * d as f32 + if d == 5 && self.arrived { r.tray.no_spill_bonus } else { 0.0 }\n    }\n}\nRS\ncat > $F/events/cannon.rs <<'RS'\n//! Cannonball Cup: bounce on the board, press at the bottom of three bounces, leap on the fourth;\n//! tuck in the air and rotate with the lean. The judges are not here for form.\n\nuse super::*;\nuse crate::games::fit::sfx;\n\n#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]\npub enum Stage {\n    Bounce,\n    Air,\n    Under,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Cannon {\n    pub t: f32,\n    pub dive: u32,\n    pub stage: Stage,\n    pub power: f32,\n    pub presses: u32,\n    pub stage_t: f32,\n    pub y: f32,\n    pub z: f32,\n    pub vy: f32,\n    pub vz: f32,\n    pub tuck: f32,\n    pub angle: f32,\n    pub scores: Vec<f32>,\n    timing_sum: f32,\n    apex: f32,\n    tuck_time: f32,\n    tuck_at_entry: f32,\n    board: Option<EntityId>,\n    water: Vec3,\n    bounce_t: f32,\n    pub cards: [String; 3],\n    card_ids: Vec<EntityId>,\n    last_bottom: u32,\n    pub waited: f32,\n    judges: Vec<EntityId>,\n    wing_t: f32,\n    tick_id: u32,\n}\n\nconst CAM: f32 = 90.0;\n\nimpl Cannon {\n    pub fn start(cx: &mut Cx, _o: Opt) -> Self {\n        let at = cx.spot(TOWER, \"board\");\n        let board = cx.prop(\"fit_board\", at - Vec3::new(0.0, 0.05, 4.0), 0.0, 1.0);\n        let jud = cx.spot(TOWER, \"judges\");\n        let mut judges = Vec::new();\n        let mut card_ids = Vec::new();\n        for k in 0..3 {\n            let p = jud + Vec3::new(0.0, 0.1, (k as f32 - 1.0) * 1.2);\n            judges.push(cx.prop(\"fit_gull\", p + Vec3::Y * 0.35, -1.57, 1.3));\n            card_ids.push(cx.prop(\"fit_card\", p + Vec3::new(0.0, 0.0, 0.0) - Vec3::Y * 9.0, -1.57, 1.0));\n        }\n        cx.player(at, 0.0);\n        cx.core.wobble = 0.4;\n        cx.ev.push(SimEvent::Music { song: 5 });\n        *cx.shot = Shot { tilt: 6.0, yaw: CAM, distance: 14.0, fov: 40.0, height: 2.0, focus: at + Vec3::new(0.0, 0.0, 3.0) };\n        Self { t: 0.0, dive: 0, stage: Stage::Bounce, power: 0.0, presses: 0, stage_t: 0.0, y: at.y, z: at.z, vy: 0.0, vz: 0.0, tuck: 0.0, angle: 0.0, scores: Vec::new(), timing_sum: 0.0, apex: 0.0, tuck_time: 0.0, tuck_at_entry: 0.0, board: Some(board), water: at, bounce_t: 0.0, cards: Default::default(), card_ids, last_bottom: 0, waited: 0.0, judges, wing_t: 0.0, tick_id: 0 }\n    }\n\n    /// How far into the bounce (0 = the bottom), and the distance from the bottom (s).\n    fn phase(&self, r: &Rules) -> f32 {\n        let p = r.dive.period;\n        let u = self.bounce_t.rem_euclid(p);\n        u.min(p - u)\n    }\n\n    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        let dt = cx.dt;\n        self.t += dt;\n        self.stage_t += dt;\n        self.wing_t += dt;\n        self.tick_id += 1;\n        let r = cx.r.dive.clone();\n        let spot = cx.spot(TOWER, \"board\");\n        match self.stage {\n            Stage::Bounce => {\n                self.bounce_t += dt;\n                self.waited += dt;\n                let p = r.period;\n                // Bigger and bigger bounces as power builds.\n                let amp = 0.25 + self.power * 0.28;\n                let w = (self.bounce_t / p * TAU).cos();\n                let h = (1.0 - w) * 0.5 * amp;\n                let bend = (w + 1.0) * 0.5 * 0.22 * (1.0 + self.power * 0.5);\n                self.y = spot.y + h - bend * 0.5;\n                self.z = spot.z;\n                if let Some(b) = self.board {\n                    cx.place(b, spot - Vec3::new(0.0, 0.05, 4.0), Quat::from_rotation_x(bend * 0.14));\n                }\n                let bottom = (self.bounce_t / p).round() as u32;\n                if bottom != self.last_bottom && self.phase(cx.r) < 0.03 {\n                    self.last_bottom = bottom;\n                    cx.sfx(sfx::BOING, 0.5, 0.8 + 0.12 * self.power);\n                }\n                cx.player(Vec3::new(spot.x, self.y, self.z), 0.0);\n                cx.scrub(\"FIT/Squat\", (bend * 2.0).min(0.6));\n                cx.lean_body(CAM);\n                if i.act_p {\n                    let off = self.phase(cx.r);\n                    let timing = (1.0 - off / (p * 0.5)).clamp(0.0, 1.0);\n                    let good = off <= r.timing;\n                    self.timing_sum += timing;\n                    self.presses += 1;\n                    if good {\n                        self.power += r.bounce_gain * 0.42;\n                        cx.sfx(sfx::GOOD, 0.5, 0.9 + 0.1 * self.power);\n                    } else {\n                        cx.sfx(sfx::SQUEAK, 0.5, 0.8);\n                    }\n                    if self.presses >= 4 {\n                        self.leap(cx, &r);\n                    }\n                }\n                if self.waited > r.wait {\n                    // The board tips you off: a belly flop of no distinction.\n                    self.timing_sum = 0.0;\n                    self.power = 0.0;\n                    self.presses = 4;\n                    self.leap(cx, &r);\n                    cx.say(\"The board has made a decision.\", 2.0);\n                }\n            }\n            Stage::Air => {\n                self.vy -= 9.8 * dt;\n                self.y += self.vy * dt;\n                self.z += self.vz * dt;\n                self.apex = self.apex.max(self.y);\n                self.tuck += (if i.act { 1.0 } else { 0.0 } - self.tuck) * (1.0 - (-12.0 * dt).exp());\n                if i.act {\n                    self.tuck_time += dt;\n                }\n                self.angle += cx.core.cob.x * r.spin * (0.5 + self.tuck) * dt;\n                if self.tuck > 0.5 {\n                    cx.scrub(\"FIT/Tuck\", self.tuck);\n                } else {\n                    cx.scrub(\"FIT/DiveEntry\", 0.5);\n                }\n                cx.player(Vec3::new(spot.x, self.y.max(0.02), self.z), 0.0);\n                if let Some(a) = cx.anim() {\n                    a.tilt_side = 0.0;\n                    a.tilt_fwd = self.angle;\n                    a.tilt_pivot = 0.8;\n                }\n                if self.y <= 0.0 {\n                    self.tuck_at_entry = self.tuck;\n                    let height = ((self.apex - 0.0) / (spot.y + r.height)).clamp(0.0, 1.2);\n                    let timing = self.timing_sum / 4.0;\n                    let tuck = 0.4 + 0.6 * self.tuck_at_entry;\n                    let size = (height * tuck * 2.6).clamp(0.2, 3.0);\n                    let score = (height * tuck * (0.45 + 0.55 * timing)).clamp(0.0, 1.0) * 1000.0;\n                    self.scores.push(score);\n                    let pos = Vec3::new(spot.x, 0.0, self.z);\n                    self.water = pos;\n                    cx.ev.push(SimEvent::BigSplash { pos, size });\n                    cx.sfx(sfx::SPLASH_B, (0.5 + size * 0.3).min(1.2), 1.1 - size * 0.12);\n                    cx.sfx(sfx::CHEER, (size * 0.3).min(0.8), 1.0);\n                    self.give_cards(cx, score);\n                    self.stage = Stage::Under;\n                    self.stage_t = 0.0;\n                }\n            }\n            Stage::Under => {\n                let u = self.stage_t;\n                cx.player(self.water - Vec3::Y * 0.6 * (1.0 - (u * 2.0).min(1.0)) + Vec3::Y * 0.0, 0.0);\n                if let Some(a) = cx.anim() {\n                    a.tilt_fwd = 0.0;\n                    a.tilt_pivot = 0.0;\n                }\n                cx.scrub(\"FIT/Sigh\", 0.5);\n                if u > 3.0 {\n                    self.dive += 1;\n                    for id in &self.card_ids {\n                        if let Some(e) = cx.sim.state.entities.get_mut(*id) {\n                            e.pos.y = -9.0;\n                        }\n                    }\n                    if self.dive >= 3 {\n                        return true;\n                    }\n                    self.stage = Stage::Bounce;\n                    self.stage_t = 0.0;\n                    self.power = 0.0;\n                    self.presses = 0;\n                    self.timing_sum = 0.0;\n                    self.apex = 0.0;\n                    self.tuck = 0.0;\n                    self.tuck_time = 0.0;\n                    self.angle = 0.0;\n                    self.waited = 0.0;\n                    self.bounce_t = 0.0;\n                    self.last_bottom = 0;\n                }\n            }\n        }\n        // The judges bob.\n        let n = self.judges.len();\n        let jud = cx.spot(TOWER, \"judges\");\n        for k in 0..n {\n            let id = self.judges[k];\n            let up = (self.wing_t * 2.0 + k as f32).sin().abs() * 0.04;\n            let p = jud + Vec3::new(0.0, 0.45 + up, (k as f32 - 1.0) * 1.2);\n            cx.place(id, p, Quat::from_rotation_y(-1.57));\n        }\n        let focus = match self.stage {\n            Stage::Bounce => Vec3::new(spot.x, spot.y + 0.8, spot.z + 2.0),\n            Stage::Air => Vec3::new(spot.x, (self.y + 1.0).max(1.5), self.z + 1.0),\n            Stage::Under => self.water + Vec3::new(0.0, 1.2, 2.0),\n        };\n        *cx.shot = Shot { tilt: 6.0, yaw: CAM, distance: 14.0, fov: 40.0, height: 0.5, focus };\n        false\n    }\n\n    fn leap(&mut self, cx: &mut Cx, r: &crate::games::fit::rules::DiveRules) {\n        self.stage = Stage::Air;\n        self.stage_t = 0.0;\n        let height = 1.0 + r.height * (self.power / (r.bounce_gain * 0.42 * 4.0)).clamp(0.0, 1.0);\n        self.vy = (2.0 * 9.8 * height).sqrt();\n        self.vz = 2.4;\n        self.apex = self.y;\n        cx.sfx(sfx::WHOOSH, 0.9, 1.0);\n        cx.sfx(sfx::BOING, 0.9, 1.3);\n    }\n\n    fn give_cards(&mut self, cx: &mut Cx, score: f32) {\n        // Three gulls, three opinions.\n        let base = score / 100.0;\n        for k in 0..3 {\n            let v = (base + cx.rng().range(-1.0, 1.0)).clamp(0.0, 10.0);\n            let v = (v * 2.0).round() / 2.0;\n            self.cards[k] = if k == 2 && cx.rng().f32() < 0.35 { \"See me\".into() } else if v.fract() == 0.0 { format!(\"{}\", v as u32) } else { format!(\"{v:.1}\") };\n        }\n        let jud = cx.spot(TOWER, \"judges\");\n        for k in 0..3 {\n            let id = self.card_ids[k];\n            cx.place(id, jud + Vec3::new(0.0, 0.1, (k as f32 - 1.0) * 1.2), Quat::from_rotation_y(-1.57));\n        }\n        cx.sfx(sfx::GULL, 0.7, 1.0);\n        let line = cx.pick(\"gull_dive\");\n        cx.say(line, 3.0);\n    }\n\n    pub fn bot(&self, core: &BalanceCore, r: &Rules) -> Intent {\n        let mut i = Intent::default();\n        match self.stage {\n            Stage::Bounce => {\n                if self.phase(r) < 0.012 && self.bounce_t > 0.3 {\n                    i.act_p = true;\n                    i.act = true;\n                }\n            }\n            Stage::Air => {\n                // Tuck at the apex, hold it to the water.\n                if self.vy < 1.0 {\n                    i.act = true;\n                }\n                i.lean = pd(core, Vec2::ZERO);\n            }\n            Stage::Under => {}\n        }\n        i\n    }\n\n    pub fn hud(&self, b: &mut B, _core: &BalanceCore, r: &Rules) {\n        b.title_left(60.0, 30.0, 80.0, INK, &format!(\"Dive {}\", (self.dive + 1).min(3)));\n        match self.stage {\n            Stage::Bounce => {\n                // The bounce meter: press when the marker is at the bottom.\n                let u = (self.bounce_t / r.dive.period * TAU).cos();\n                let y = 820.0 + 180.0 * (u + 1.0) * 0.5;\n                b.flat([1700.0, 820.0, 1800.0, 1000.0], PALE, 26.0);\n                b.flat([1700.0, 950.0, 1800.0, 1000.0], MINT, 26.0);\n                b.flat([1690.0, y - 10.0, 1810.0, y + 10.0], CORAL, 8.0);\n                for k in 0..4 {\n                    let on = k < self.presses;\n                    b.circle([820.0 + k as f32 * 90.0, 1000.0], 30.0, if on { TEAL } else { PALE }, WHITE, 4.0);\n                }\n                b.prompt_center(960.0, 900.0, &[Glyph::Confirm], \"At the bottom\");\n            }\n            Stage::Air => {\n                b.prompt_center(960.0, 900.0, &[Glyph::Confirm], \"Hold to tuck\");\n            }\n            Stage::Under => {\n                for k in 0..3 {\n                    let x = 560.0 + k as f32 * 400.0;\n                    b.card([x - 170.0, 120.0, x + 170.0, 280.0], WHITE);\n                    b.title(x, 150.0, 72.0, INK, &self.cards[k]);\n                }\n                if let Some(s) = self.scores.last() {\n                    b.center(960.0, 320.0, 50.0, INK, &format!(\"{:.0} points of splash\", s));\n                }\n            }\n        }\n    }\n\n    pub fn score(&self, _r: &Rules) -> f32 {\n        self.scores.iter().sum::<f32>() / 3.0\n    }\n}\nRS\n","description":"Write the lap, tide, paddle, tray and cannonball events"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":24211,"cache_read_input_tokens":321203,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":24211},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cb437ba7-0477-4143-bb04-ff33f49efd62","uuid":"f88219e5-eafc-49b2-ac9f-85c85c0fd4ea","timestamp":"2026-11-05T05:59:32.525Z","request_id":"req_011CgjGPgad8LXBRj6mxeyCv","wire_tool_inputs":{"toolu_01KxhEMjWb7CzFFBtmuTwjC7":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953\nF=engine/crates/pav_core/src/games/fit\npython3 - <<'PY'\np='engine/crates/pav_core/src/games/fit/events/breath.rs'\ns=open(p).read()\ns=s.replace('''                cx.say(cx.pick_static(\"posey_perfect\"), 3.0);''','''                let line = cx.pick(\"posey_perfect\");\n                cx.say(line, 3.0);''')\ns=s[:s.index('impl Cx<\\'_> {')]\nopen(p,'w').write(s)\np='engine/crates/pav_core/src/games/fit/events/pose.rs'\ns=open(p).read()\ns=s.replace('''        if cx.core.cob.length() < 0.001 && cx.core.tips > 0 {\n            self.broken = 1.5;\n        }\n''','')\ns=s.replace('''        let (drift, gull_w) = (r.drift, r.gull_wobble);\n        let _ = drift;\n''','''        let gull_w = r.gull_wobble;\n''')\nopen(p,'w').write(s)\nPY\ncat > $F/events/lap.rs <<'RS'\n//! Morning Lap: alternate steps to set your pace, one lap of the island's ring path, chasing a\n//! bouncing pacer. Lean moves you aside to dodge crabs and towels and to grab ribbons.\n\nuse super::*;\nuse crate::games::fit::sfx;\n\n#[derive(Clone, Copy, Debug, Serialize, Deserialize)]\npub struct Thing {\n    pub id: EntityId,\n    pub s: f32,\n    pub side: f32,\n    pub kind: u8, // 0 obstacle, 1 ribbon\n    pub gone: bool,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Lap {\n    pub t: f32,\n    pub s: f32,\n    pub side: f32,\n    pub pace: f32,\n    last_step: f32,\n    last_foot: u8,\n    pub stitch: f32,\n    stumble: f32,\n    pub zone: f32,\n    pub ribbons: u32,\n    pub bumps: u32,\n    pub things: Vec<Thing>,\n    pacer: Option<EntityId>,\n    pacer_s: f32,\n    center: Vec3,\n    pub length: f32,\n    told: bool,\n    pub done: bool,\n    step_acc: f32,\n}\n\nconst A: f32 = 25.0;\nconst B_: f32 = 18.0;\n\n/// A point on the ring path (0..1 of the lap): the ellipse, centred on the island.\nfn ring(center: Vec3, u: f32) -> (Vec3, Vec3) {\n    let a = u * TAU + PI * 0.5;\n    let p = center + Vec3::new(a.cos() * A, 0.0, a.sin() * B_);\n    let t = Vec3::new(-a.sin() * A, 0.0, a.cos() * B_).normalize();\n    (p, t)\n}\n\nconst LEN: f32 = 136.0;\n\nimpl Lap {\n    pub fn start(cx: &mut Cx, _o: Opt) -> Self {\n        let center = cx.spot(HUB, \"arrive\") + Vec3::new(0.0, 0.0, 2.0);\n        let (p, t) = ring(center, 0.0);\n        cx.player(p, t.x.atan2(t.z));\n        cx.core.wobble = 0.6;\n        let n_o = cx.r.lap.obstacles as u32;\n        let n_r = cx.r.lap.ribbons as u32;\n        let mut things = Vec::new();\n        for k in 0..n_o + n_r {\n            let obstacle = k < n_o;\n            let total = if obstacle { n_o } else { n_r };\n            let idx = if obstacle { k } else { k - n_o };\n            let s = (idx as f32 + 0.4 + cx.rng().range(-0.2, 0.2)) / total.max(1) as f32 * LEN * 0.94 + 4.0;\n            let side = if cx.rng().f32() < 0.5 { -0.8 } else { 0.8 };\n            let (at, tan) = ring(center, s / LEN);\n            let across = Vec3::new(-tan.z, 0.0, tan.x);\n            let pos = at + across * side;\n            let id = if obstacle {\n                match k % 3 {\n                    0 => cx.prop(\"fit_crab\", pos, 0.0, 1.0),\n                    1 => cx.prop_color(\"fit_towel\", pos + Vec3::Y * 0.01, tan.x.atan2(tan.z), 1.0, \"#ff9ec4\"),\n                    _ => cx.prop_color(\"fit_chair\", pos, tan.x.atan2(tan.z), 0.9, \"#ffd166\"),\n                }\n            } else {\n                cx.prop(\"fit_ribbon\", pos + Vec3::Y * 0.25, tan.x.atan2(tan.z), 1.0)\n            };\n            things.push(Thing { id, s, side, kind: if obstacle { 0 } else { 1 }, gone: false });\n        }\n        let pacer = cx.sim.state.entities.iter().find(|e| e.name == \"bounce\" && (e.pos - center).length() < 40.0).map(|e| e.id);\n        cx.ev.push(SimEvent::Music { song: 5 });\n        Self { t: 0.0, s: 0.0, side: 0.0, pace: 0.0, last_step: -1.0, last_foot: 2, stitch: 0.0, stumble: 0.0, zone: 0.0, ribbons: 0, bumps: 0, things, pacer, pacer_s: 8.0, center, length: LEN, told: false, done: false, step_acc: 0.0 }\n    }\n\n    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        let dt = cx.dt;\n        self.t += dt;\n        let r = cx.r.lap.clone();\n        // Alternating feet set the pace.\n        for (p, foot) in [(i.l_p, 0u8), (i.r_p, 1u8)] {\n            if p && foot != self.last_foot {\n                let gap = self.t - self.last_step;\n                if self.last_step >= 0.0 && gap > 0.05 {\n                    self.pace += (1.0 / gap - self.pace) * 0.5;\n                }\n                self.last_step = self.t;\n                self.last_foot = foot;\n                cx.sfx(sfx::STEP, 0.5, 1.0);\n            }\n        }\n        if self.t - self.last_step > 0.8 {\n            self.pace = (self.pace - 3.0 * dt).max(0.0);\n        }\n        let in_zone = self.pace >= r.pace_low && self.pace <= r.pace_high;\n        if in_zone {\n            self.zone += dt;\n            self.stitch = (self.stitch - 0.2 * dt).max(0.0);\n        } else if self.pace > r.pace_high {\n            self.stitch += r.stitch_rate * dt;\n        }\n        if self.stitch >= 1.0 {\n            self.stitch = 0.3;\n            self.stumble = 1.2;\n            cx.gesture(\"FIT/Stumble\");\n            let line = cx.pick(\"bounce_stitch\");\n            cx.say(line, 3.0);\n        }\n        self.stumble = (self.stumble - dt).max(0.0);\n        let speed = if self.stumble > 0.0 { 0.0 } else { self.pace * r.speed_per_step };\n        self.s += speed * dt;\n        self.side += (cx.core.cob.x * r.side_reach - self.side) * (1.0 - (-8.0 * dt).exp());\n        let (p, t) = ring(self.center, (self.s / LEN).fract());\n        let across = Vec3::new(-t.z, 0.0, t.x);\n        let at = p + across * self.side;\n        let yaw = t.x.atan2(t.z);\n        cx.player(at, yaw);\n        // The chase camera follows every tick.\n        let cam = (-t.x).atan2(t.z).to_degrees() + 180.0;\n        let cam_yaw = (t.x.atan2(-t.z)).to_degrees();\n        let _ = cam;\n        *cx.shot = Shot { tilt: 22.0, yaw: cam_yaw, distance: 9.0, fov: 40.0, height: 0.9, focus: at };\n        cx.clip(\"MESH2MOTION/Jog\", (self.pace / 2.0).clamp(0.05, 1.8));\n        cx.lean_body_by(Vec2::new(cx.core.cob.x, 0.0), cam_yaw, 0.0);\n        // Lean: x is sideways on this camera; across is its right.\n        for th in self.things.iter_mut() {\n            if th.gone || (th.s - self.s).abs() > 0.7 {\n                continue;\n            }\n            if (th.side - self.side).abs() < 0.65 {\n                th.gone = true;\n                if th.kind == 1 {\n                    self.ribbons += 1;\n                    let id = th.id;\n                    cx.sim.despawn(id);\n                    cx.sfx(sfx::CHIME, 0.6, penta(self.ribbons));\n                } else {\n                    self.bumps += 1;\n                    self.stumble = 0.8;\n                    self.pace *= 0.6;\n                    cx.gesture(\"FIT/Stumble\");\n                    cx.sfx(sfx::SQUEAK, 0.7, 0.8);\n                }\n            }\n        }\n        // Flip-flops on the way.\n        for k in 0..5 {\n            if !cx.flops[k] {\n                if let Some(id) = cx.flop_ids[k] {\n                    if cx.sim.state.entities.get(id).is_some_and(|e| (e.pos - at).length() < 1.6) {\n                        cx.flops[k] = true;\n                        cx.sim.despawn(id);\n                        cx.sfx(sfx::POP, 0.7, 1.4);\n                        cx.say(\"A flip-flop. Someone will be glad. Someone is always glad.\", 3.0);\n                    }\n                }\n            }\n        }\n        // Bounce rolls ahead and gets away if you dawdle.\n        let gap = self.pacer_s - self.s;\n        let pacer_speed = if gap > 14.0 { 0.0 } else { 3.3 + if gap < 4.0 { 2.0 } else { 0.0 } };\n        self.pacer_s += pacer_speed * dt;\n        if let Some(id) = self.pacer {\n            let (pp, pt) = ring(self.center, (self.pacer_s / LEN).fract());\n            cx.sim.set_position(id, pp);\n            let f = pt.x.atan2(pt.z);\n            if let Some(ch) = cx.sim.state.entities.get_mut(id).and_then(|e| e.character.as_mut()) {\n                ch.facing = f;\n                ch.anim.facing = f;\n                ch.anim.lift = (self.t * 6.0).sin().abs() * 0.5;\n            }\n        }\n        if gap > 12.0 && !self.told {\n            self.told = true;\n            let line = cx.pick(\"bounce_far\");\n            cx.say(line, 3.0);\n        }\n        if self.s >= LEN {\n            self.done = true;\n            if let Some(id) = self.pacer {\n                let home = cx.spot(HUB, \"bounce\");\n                cx.sim.set_position(id, home);\n            }\n            return true;\n        }\n        if self.t >= r.seconds {\n            if let Some(id) = self.pacer {\n                let home = cx.spot(HUB, \"bounce\");\n                cx.sim.set_position(id, home);\n            }\n            return true;\n        }\n        false\n    }\n\n    pub fn bot(&self, core: &BalanceCore, _r: &Rules) -> Intent {\n        let mut i = Intent::default();\n        // Two steps a second; a press lands on whichever tick crosses the half-second.\n        let step = (self.t * 2.0) as u32;\n        let before = ((self.t - 1.0 / 60.0) * 2.0) as u32;\n        if step != before {\n            if step % 2 == 0 {\n                i.l_p = true;\n                i.l = true;\n            } else {\n                i.r_p = true;\n                i.r = true;\n            }\n        }\n        // Steer for the next ribbon, around the next obstacle.\n        let mut want = 0.0;\n        if let Some(ob) = self.things.iter().filter(|t| !t.gone && t.s > self.s - 0.5 && t.s < self.s + 6.0).min_by(|a, b| a.s.total_cmp(&b.s)) {\n            want = if ob.kind == 1 { ob.side } else { -ob.side };\n        }\n        i.lean = pd(core, Vec2::new(want / 1.2, 0.0));\n        i\n    }\n\n    pub fn hud(&self, b: &mut B, core: &BalanceCore, r: &Rules) {\n        timer(b, r.lap.seconds - self.t);\n        b.puck(PUCK_TOP, PUCK_R, core.cob.into());\n        b.flat([560.0, 960.0, 1360.0, 1020.0], PALE, 28.0);\n        let m = r.lap.pace_high * 1.5;\n        b.flat([560.0 + 800.0 * r.lap.pace_low / m, 960.0, 560.0 + 800.0 * r.lap.pace_high / m, 1020.0], MINT, 28.0);\n        b.circle([560.0 + 800.0 * (self.pace / m).clamp(0.0, 1.0), 990.0], 38.0, TEAL, WHITE, 5.0);\n        b.center(960.0, 900.0, 40.0, INK, \"Pace\");\n        b.prompt(60.0, 940.0, &[Glyph::StepL, Glyph::StepR], \"Alternate\");\n        if self.stitch > 0.05 {\n            b.text(60.0, 860.0, 40.0, CORAL, \"Stitch\");\n            b.bar([190.0, 868.0, 460.0, 900.0], self.stitch.min(1.0), CORAL, None);\n        }\n        b.right(1860.0, 450.0, 44.0, INK, &format!(\"Ribbons {}\", self.ribbons));\n        b.bar([560.0, 40.0, 1360.0, 70.0], (self.s / LEN).min(1.0), TEAL, None);\n    }\n\n    pub fn score(&self, r: &Rules) -> f32 {\n        let zone = self.zone / r.lap.seconds.min(LEN / (2.0 * r.lap.speed_per_step));\n        700.0 * zone.min(1.0) + 300.0 * self.ribbons as f32 / r.lap.ribbons.max(1.0) - 25.0 * self.bumps as f32\n    }\n}\nRS\ncat > $F/events/tide.rs <<'RS'\n//! Tide Table: you stand on a raft and your lean tilts it. Roll hermit crabs into tide pools.\n\nuse super::*;\nuse crate::games::fit::sfx;\n\n#[derive(Clone, Copy, Debug, Serialize, Deserialize)]\npub struct Shell {\n    pub id: EntityId,\n    pub p: Vec2,\n    pub v: Vec2,\n    pub potted: bool,\n}\n\n#[derive(Clone, Copy, Debug, Serialize, Deserialize)]\npub struct Pool {\n    pub id: EntityId,\n    pub p: Vec2,\n    pub moving: bool,\n}\n\n#[derive(Clone, Copy, Debug, Serialize, Deserialize)]\npub struct Bumper {\n    pub id: EntityId,\n    pub p: Vec2,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Tide {\n    pub t: f32,\n    pub board: u32,\n    pub shells: Vec<Shell>,\n    pub pools: Vec<Pool>,\n    pub bumpers: Vec<Bumper>,\n    pub potted: u32,\n    pub time_bonus: f32,\n    raft: Option<EntityId>,\n    center: Vec3,\n    pub half: f32,\n    tide_level: f32,\n    roll_t: f32,\n    seed: u32,\n}\n\nconst BOARD_SHELLS: [u32; 3] = [3, 5, 7];\npub const TOTAL: u32 = 15;\n\nimpl Tide {\n    pub fn start(cx: &mut Cx, _o: Opt) -> Self {\n        let center = cx.spot(TIDE, \"center\");\n        let raft = cx.prop(\"fit_raft\", center, 0.0, 1.0);\n        cx.player(center + Vec3::Y * 0.02, 0.0);\n        cx.core.wobble = 0.5;\n        *cx.shot = Shot { tilt: 62.0, yaw: 0.0, distance: 13.0, fov: 40.0, height: 0.0, focus: center };\n        let mut s = Self { t: 0.0, board: 0, shells: Vec::new(), pools: Vec::new(), bumpers: Vec::new(), potted: 0, time_bonus: 0.0, raft: Some(raft), center, half: cx.r.tide.half, tide_level: 0.0, roll_t: 0.0, seed: cx.seed };\n        s.lay(cx);\n        cx.ev.push(SimEvent::Music { song: 5 });\n        s\n    }\n\n    /// A number the same on every copy with the same seed (the medley's rule).\n    fn sr(&mut self, k: u32) -> f32 {\n        let x = (self.seed.wrapping_mul(2654435761).wrapping_add(k.wrapping_mul(40503))) >> 8;\n        (x % 10000) as f32 / 10000.0\n    }\n\n    fn lay(&mut self, cx: &mut Cx) {\n        for s in self.shells.drain(..) {\n            cx.sim.despawn(s.id);\n        }\n        for p in self.pools.drain(..) {\n            cx.sim.despawn(p.id);\n        }\n        for b in self.bumpers.drain(..) {\n            cx.sim.despawn(b.id);\n        }\n        let h = self.half;\n        let n = BOARD_SHELLS[self.board as usize];\n        let pools = 2 + self.board;\n        for k in 0..pools {\n            let a = self.sr(k * 7 + self.board * 31) * TAU;\n            let r = 0.55 + 0.3 * self.sr(k * 11 + 3);\n            let p = Vec2::new(a.cos(), a.sin()) * h * r;\n            let id = cx.prop(\"fit_pool\", self.world(p, 0.02), 0.0, 1.15);\n            self.pools.push(Pool { id, p, moving: self.board == 1 && k == 0 });\n        }\n        if self.board == 2 {\n            for k in 0..4 {\n                let a = k as f32 * TAU / 4.0 + 0.5;\n                let p = Vec2::new(a.cos(), a.sin()) * h * 0.42;\n                let id = cx.prop(\"fit_bumper\", self.world(p, 0.02), 0.0, 0.8);\n                self.bumpers.push(Bumper { id, p });\n            }\n        }\n        for k in 0..n {\n            let a = self.sr(k * 13 + 100 + self.board * 17) * TAU;\n            let p = Vec2::new(a.cos(), a.sin()) * h * (0.2 + 0.5 * self.sr(k * 3 + 200));\n            let id = cx.prop(\"fit_shell\", self.world(p, 0.0), a, 1.2);\n            self.shells.push(Shell { id, p, v: Vec2::ZERO, potted: false });\n        }\n    }\n\n    /// Raft space (x right, y away from the camera) to the world, on the tilted deck.\n    fn world(&self, p: Vec2, lift: f32) -> Vec3 {\n        self.center + Vec3::new(p.x, lift - self.tide_level, -p.y)\n    }\n\n    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        let dt = cx.dt;\n        self.t += dt;\n        let r = cx.r.tide.clone();\n        let tilt = cx.core.cob;\n        // Static friction: a nearly flat raft holds its shells still.\n        let g = if tilt.length() < 0.1 { Vec2::ZERO } else { tilt * r.gravity };\n        let mut rolling = 0.0f32;\n        // Board 3: the tide comes in and the raft gets smaller.\n        if self.board == 2 {\n            self.half = (self.half - 0.012 * dt).max(r.half * 0.7);\n            self.tide_level = (self.tide_level + 0.003 * dt).min(0.05);\n        }\n        let h = self.half;\n        for k in 0..self.pools.len() {\n            if self.pools[k].moving {\n                let w = self.t * 0.5;\n                self.pools[k].p = Vec2::new(w.cos(), w.sin()) * h * 0.6;\n                let id = self.pools[k].id;\n                let at = self.world(self.pools[k].p, 0.02);\n                cx.place(id, at, Quat::IDENTITY);\n            }\n        }\n        let pools: Vec<Vec2> = self.pools.iter().map(|p| p.p).collect();\n        let bumpers: Vec<Vec2> = self.bumpers.iter().map(|b| b.p).collect();\n        let mut plops = 0;\n        for s in self.shells.iter_mut().filter(|s| !s.potted) {\n            s.v += (g - s.v * r.friction) * dt;\n            s.p += s.v * dt;\n            for (axis, lim) in [(0, h), (1, h)] {\n                let c = if axis == 0 { &mut s.p.x } else { &mut s.p.y };\n                let v = if axis == 0 { &mut s.v.x } else { &mut s.v.y };\n                if c.abs() > lim - 0.2 {\n                    *c = c.signum() * (lim - 0.2);\n                    *v *= -0.5;\n                }\n            }\n            for b in &bumpers {\n                let d = s.p - *b;\n                if d.length() < 0.5 {\n                    let n = d.normalize_or(Vec2::X);\n                    s.p = *b + n * 0.5;\n                    s.v = (s.v - n * 2.0 * s.v.dot(n)) * 0.8 + n * 0.8;\n                    plops += 100;\n                }\n            }\n            rolling = rolling.max(s.v.length());\n            // Fast shells skip over a pool.\n            if s.v.length() < r.skip_speed && pools.iter().any(|p| (*p - s.p).length() < r.pool_radius) {\n                s.potted = true;\n                plops += 1;\n            }\n        }\n        if plops % 100 > 0 {\n            self.potted += plops % 100;\n            cx.sfx(sfx::PLOP, 0.8, penta(self.potted));\n            let at = self.center + Vec3::Y * 0.3;\n            cx.ev.push(SimEvent::Burst { pos: at, kind: 2, count: 12 });\n        }\n        if plops >= 100 {\n            cx.sfx(sfx::BOING, 0.5, 1.0);\n        }\n        self.roll_t -= dt;\n        if rolling > 0.3 && self.roll_t <= 0.0 {\n            self.roll_t = 0.12;\n            cx.sfx(sfx::ROLL, (rolling / 3.0).min(1.0), 0.8 + rolling * 0.2);\n        }\n        // Draw: raft, pools and shells on the tilted plane.\n        let tilt_q = Quat::from_rotation_z(-tilt.x * 0.12) * Quat::from_rotation_x(-tilt.y * 0.12);\n        if let Some(raft) = self.raft {\n            let at = self.center - Vec3::Y * self.tide_level;\n            cx.place(raft, at, tilt_q);\n        }\n        let plane = |p: Vec2, c: Vec3| c + tilt_q * Vec3::new(p.x, 0.0, -p.y);\n        let base = self.center - Vec3::Y * self.tide_level;\n        for s in &self.shells {\n            let pos = if s.potted { base + Vec3::new(s.p.x, -2.0, -s.p.y) } else { plane(s.p, base) };\n            let heading = s.v.y.atan2(s.v.x);\n            cx.place(s.id, pos + Vec3::Y * 0.02, tilt_q * Quat::from_rotation_y(heading));\n        }\n        for k in 0..self.pools.len() {\n            let (id, p) = (self.pools[k].id, self.pools[k].p);\n            cx.place(id, plane(p, base) + Vec3::Y * 0.015, tilt_q);\n        }\n        for k in 0..self.bumpers.len() {\n            let (id, p) = (self.bumpers[k].id, self.bumpers[k].p);\n            cx.place(id, plane(p, base), tilt_q);\n        }\n        cx.player(base + Vec3::Y * 0.02, 0.0);\n        cx.lean_body(0.0);\n        let _ = i;\n        // Next board, or the end.\n        if self.shells.iter().all(|s| s.potted) {\n            self.board += 1;\n            cx.sfx(sfx::STAR, 0.8, 1.5);\n            if self.board >= 3 {\n                self.time_bonus = (r.seconds - self.t).max(0.0) / r.seconds;\n                return true;\n            }\n            self.half = r.half;\n            let msg = if self.board == 1 { \"One pool has wandered off. Do not take it personally.\" } else { \"The tide is coming in. It does this. Nobody has complained.\" };\n            cx.say(msg, 3.0);\n            self.lay(cx);\n        }\n        self.t >= r.seconds\n    }\n\n    pub fn bot(&self, core: &BalanceCore, r: &Rules) -> Intent {\n        let mut i = Intent::default();\n        // Steer the nearest shell toward its nearest pool; the others come along.\n        let mut best: Option<(f32, Shell, Vec2)> = None;\n        for s in self.shells.iter().filter(|s| !s.potted) {\n            for p in &self.pools {\n                let d = (p.p - s.p).length();\n                if best.as_ref().is_none_or(|b| d < b.0) {\n                    best = Some((d, *s, p.p));\n                }\n            }\n        }\n        if let Some((_, s, pool)) = best {\n            // Desired acceleration: to the pool, braking near it. Avoid bumpers by aiming aside.\n            let mut aim = pool;\n            for b in &self.bumpers {\n                let d = s.p - b.p;\n                if d.length() < 1.0 {\n                    aim += d.normalize_or(Vec2::X) * 1.0;\n                }\n            }\n            let to = aim - s.p;\n            let want_v = to.clamp_length_max(1.8);\n            let acc = (want_v - s.v) * 4.0;\n            let lean = (acc + s.v * r.tide.friction) / r.tide.gravity;\n            // Below the raft's static grip nothing moves, so always tilt past it.\n            let lean = if lean.length() < 0.16 && to.length() > 0.2 { lean.normalize_or(Vec2::X) * 0.16 } else { lean };\n            i.lean = pd(core, lean.clamp_length_max(0.8));\n        }\n        i\n    }\n\n    pub fn hud(&self, b: &mut B, core: &BalanceCore, r: &Rules) {\n        timer(b, r.tide.seconds - self.t);\n        b.puck(PUCK_TOP, PUCK_R, core.cob.into());\n        b.right(1860.0, 450.0, 44.0, INK, &format!(\"Board {} of 3\", (self.board + 1).min(3)));\n        let left = self.shells.iter().filter(|s| !s.potted).count();\n        b.right(1860.0, 510.0, 44.0, INK, &format!(\"{left} crabs to go\"));\n    }\n\n    pub fn score(&self, _r: &Rules) -> f32 {\n        800.0 * self.potted as f32 / TOTAL as f32 + 200.0 * self.time_bonus\n    }\n}\nRS\ncat > $F/events/paddle.rs <<'RS'\n//! Paddle Slalom: stand on a board on a long channel and pass buoy gates. Lean x steers, forward\n//! speeds up and risks tipping, back brakes.\n\nuse super::*;\nuse crate::games::fit::sfx;\n\n#[derive(Clone, Copy, Debug, Serialize, Deserialize)]\npub struct Gate {\n    pub z: f32,\n    pub x: f32,\n    pub passed: bool,\n    pub missed: bool,\n    pub id: [EntityId; 2],\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Paddle {\n    pub t: f32,\n    pub pos: Vec3,\n    pub start: Vec3,\n    pub gates: Vec<Gate>,\n    pub missed: u32,\n    pub passed: u32,\n    remount: f32,\n    gust_in: f32,\n    gust_for: f32,\n    pub gust: Vec2,\n    board: Option<EntityId>,\n    wake: u32,\n    pub finish: f32,\n    pub done: bool,\n    pub speed: f32,\n    streaks: Vec<EntityId>,\n    seed: u32,\n}\n\nconst CAM: f32 = 180.0;\n\nimpl Paddle {\n    pub fn start(cx: &mut Cx, _o: Opt) -> Self {\n        let start = cx.spot(CHANNEL, \"start\");\n        let n = cx.r.paddle.gates as u32;\n        let mut gates = Vec::new();\n        let seed = cx.seed;\n        let sr = |k: u32| ((seed.wrapping_mul(2654435761).wrapping_add(k.wrapping_mul(40503))) >> 8) as f32 % 10000.0 / 10000.0;\n        let w = cx.r.paddle.gate_width;\n        for k in 0..n {\n            let z = start.z + 18.0 + k as f32 * 15.0;\n            let x = start.x + (sr(k) - 0.5) * 16.0;\n            let a = cx.prop(\"fit_buoy\", Vec3::new(x - w, -0.05, z), 0.0, 1.0);\n            let b = cx.prop(\"fit_buoy\", Vec3::new(x + w, -0.05, z), 0.0, 1.0);\n            gates.push(Gate { z, x, passed: false, missed: false, id: [a, b] });\n        }\n        let finish = start.z + 18.0 + n as f32 * 15.0;\n        let board = cx.prop(\"fit_paddleboard\", start, 0.0, 1.0);\n        let mut streaks = Vec::new();\n        for _ in 0..4 {\n            streaks.push(cx.ball(0.0, \"#ffffff\", start - Vec3::Y * 9.0));\n        }\n        cx.player(start, 0.0);\n        cx.core.wobble = cx.r.paddle.wobble;\n        cx.clip(\"FIT/Paddle\", 1.0);\n        *cx.shot = Shot { tilt: 22.0, yaw: CAM, distance: 10.0, fov: 40.0, height: 1.0, focus: start };\n        cx.ev.push(SimEvent::Music { song: 5 });\n        Self { t: 0.0, pos: start, start, gates, missed: 0, passed: 0, remount: 0.0, gust_in: 4.0, gust_for: 0.0, gust: Vec2::ZERO, board: Some(board), wake: 0, finish, done: false, speed: 0.0, streaks, seed }\n    }\n\n    pub fn tick(&mut self, cx: &mut Cx, _i: &Intent) -> bool {\n        let dt = cx.dt;\n        self.t += dt;\n        let r = cx.r.paddle.clone();\n        // Gusts, shown as streaks on the water, push the dot.\n        self.gust_in -= dt;\n        if self.gust_in <= 0.0 {\n            self.gust_in = cx.rng().range(4.0, 8.0);\n            self.gust_for = 2.0;\n            let a = cx.rng().range(0.0, TAU);\n            self.gust = Vec2::new(a.cos(), a.sin() * 0.5) * r.gust * 2.0;\n            cx.sfx(sfx::GUST, 0.7, 1.0);\n        }\n        if self.gust_for > 0.0 {\n            self.gust_for -= dt;\n            cx.core.gust = self.gust;\n        } else {\n            cx.core.gust = Vec2::ZERO;\n        }\n        if self.remount > 0.0 {\n            self.remount -= dt;\n            self.speed = 0.0;\n            let u = clamp01(1.0 - self.remount / r.remount);\n            cx.player(self.pos - Vec3::Y * (1.0 - u) * 1.1, 0.0);\n        } else {\n            let cob = cx.core.cob;\n            // Screen right is world -X with the camera looking along +Z.\n            let forward = cob.y.max(0.0);\n            let back = (-cob.y).max(0.0);\n            let target = (r.cruise + (r.sprint - r.cruise) * forward) * (1.0 - back * 0.8);\n            self.speed += (target - self.speed) * (1.0 - (-3.0 * dt).exp());\n            self.pos.z += self.speed * dt;\n            self.pos.x -= cob.x * r.steer * dt;\n            self.pos.x = self.pos.x.clamp(self.start.x - 13.0, self.start.x + 13.0);\n            cx.player(self.pos, 0.0);\n            self.wake += 1;\n            if self.wake % 5 == 0 {\n                cx.ev.push(SimEvent::Wake { pos: self.pos - Vec3::Z * 1.2 });\n            }\n        }\n        if let Some(b) = self.board {\n            let tilt = Quat::from_rotation_z(cx.core.cob.x * 0.1) * Quat::from_rotation_x(-cx.core.cob.y * 0.1);\n            cx.place(b, self.pos + Vec3::Y * 0.0, tilt);\n        }\n        let n = self.streaks.len();\n        for k in 0..n {\n            let id = self.streaks[k];\n            let vis = self.gust_for > 0.0;\n            let a = k as f32 * 1.7;\n            let at = self.pos + Vec3::new((self.gust.x.signum()) * ((self.t * 6.0 + a).fract() * 9.0 - 4.0), 0.1, 6.0 + k as f32 * 2.0);\n            if let Some(e) = cx.sim.state.entities.get_mut(id) {\n                e.pos = if vis { at } else { self.start - Vec3::Y * 9.0 };\n                if let Some(v) = &mut e.visual {\n                    v.shape = crate::shape::Shape::Capsule { half_height: 0.9, radius: 0.04 };\n                    v.color = Color::hex(\"#ffffff\");\n                }\n                e.rot = Quat::from_rotation_z(std::f32::consts::FRAC_PI_2);\n            }\n        }\n        let pz = self.pos.z;\n        let px = self.pos.x;\n        let mut pass = 0;\n        let mut miss = 0;\n        for g in self.gates.iter_mut().filter(|g| !g.passed && !g.missed) {\n            if pz >= g.z {\n                if (px - g.x).abs() <= r.gate_width {\n                    g.passed = true;\n                    pass += 1;\n                } else {\n                    g.missed = true;\n                    miss += 1;\n                }\n            }\n        }\n        if pass > 0 {\n            self.passed += pass;\n            cx.ev.push(SimEvent::Gate { pos: self.pos, ok: true });\n        }\n        if miss > 0 {\n            self.missed += miss;\n            cx.ev.push(SimEvent::Gate { pos: self.pos, ok: false });\n            cx.say(\"A gate was missed. It has been told.\", 2.0);\n        }\n        *cx.shot = Shot { tilt: 22.0, yaw: CAM, distance: 10.0, fov: 40.0, height: 1.0, focus: self.pos };\n        cx.lean_body(CAM);\n        if pz >= self.finish {\n            self.done = true;\n            return true;\n        }\n        self.t >= 90.0\n    }\n\n    /// The core tipped: a big splash and a remount.\n    pub fn on_tip(&mut self, cx: &mut Cx) {\n        self.remount = cx.r.paddle.remount;\n        cx.ev.push(SimEvent::BigSplash { pos: self.pos, size: 0.45 });\n        cx.sfx(sfx::SPLASH_B, 0.7, 1.2);\n        let line = cx.pick(\"gull_tip\");\n        cx.say(line, 2.5);\n    }\n\n    pub fn bot(&self, core: &BalanceCore, _r: &Rules) -> Intent {\n        let mut i = Intent::default();\n        let want = self.gates.iter().find(|g| !g.passed && !g.missed).map(|g| g.x).unwrap_or(self.start.x);\n        // Screen right is world -X.\n        let steer = ((self.pos.x - want) * 0.35).clamp(-0.8, 0.8);\n        i.lean = pd(core, Vec2::new(steer, 0.5));\n        i\n    }\n\n    fn time(&self) -> f32 {\n        self.t + 2.0 * self.missed as f32\n    }\n\n    pub fn hud(&self, b: &mut B, core: &BalanceCore, r: &Rules) {\n        b.title_left(60.0, 30.0, 80.0, INK, &format!(\"{:.1}\", self.time()));\n        b.text(60.0, 130.0, 40.0, INK, &format!(\"Par {:.0}\", r.paddle.par));\n        b.puck(PUCK_TOP, PUCK_R, core.cob.into());\n        b.bar([560.0, 40.0, 1360.0, 70.0], ((self.pos.z - self.start.z) / (self.finish - self.start.z)).clamp(0.0, 1.0), TEAL, None);\n        b.right(1860.0, 450.0, 44.0, INK, &format!(\"Gates {}\", self.passed));\n        if self.gust_for > 0.0 {\n            b.center(960.0, 120.0, 56.0, CORAL, \"Gust!\");\n        }\n    }\n\n    pub fn score(&self, r: &Rules) -> f32 {\n        if !self.done {\n            // While under way, and on timing out: how far you got, at most half.\n            let frac = ((self.pos.z - self.start.z) / (self.finish - self.start.z)).clamp(0.0, 1.0);\n            let _ = self.seed;\n            return if self.t >= 90.0 { 0.0 } else { 300.0 * frac };\n        }\n        ((1.6 * r.paddle.par - self.time()) / (0.8 * r.paddle.par)).clamp(0.0, 1.0) * 1000.0\n    }\n}\nRS\ncat > $F/events/tray.rs <<'RS'\n//! Tray Trek: walk a long pier carrying five smoothies. Waves, gaps and gulls jolt the tray; your\n//! dot tilts it; glasses slide with the tilt and plop into the sea.\n\nuse super::*;\nuse crate::games::fit::sfx;\n\n#[derive(Clone, Copy, Debug, Serialize, Deserialize)]\npub struct Glass {\n    pub id: EntityId,\n    pub p: Vec2,\n    pub v: Vec2,\n    pub fall: f32,\n    pub gone: bool,\n}\n\n#[derive(Clone, Copy, Debug, Serialize, Deserialize)]\npub struct Jolt {\n    pub at: f32,\n    pub dir: Vec2,\n    pub kind: u8,\n    pub done: bool,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Tray {\n    pub t: f32,\n    pub pos: Vec3,\n    pub start: Vec3,\n    pub end: Vec3,\n    pub glasses: Vec<Glass>,\n    pub jolts: Vec<Jolt>,\n    tray: Option<EntityId>,\n    gull: Option<EntityId>,\n    gull_t: f32,\n    pub arrived: bool,\n    pub lost: u32,\n    pub sway: Vec2,\n    tilt: Vec2,\n    over: f32,\n    told: bool,\n}\n\nconst COLORS: [&str; 5] = [\"#ff9ec4\", \"#ffd166\", \"#78dcaa\", \"#ff786e\", \"#c7b1ec\"];\nconst CAM: f32 = 180.0;\n\nimpl Tray {\n    pub fn start(cx: &mut Cx, _o: Opt) -> Self {\n        let start = cx.spot(PIER, \"start\");\n        let end = cx.spot(PIER, \"end\");\n        cx.player(start, 0.0);\n        cx.core.wobble = 0.7;\n        cx.clip(\"STYLE100/Balance_Walk\", 1.0);\n        *cx.shot = Shot { tilt: 24.0, yaw: CAM, distance: 7.0, fov: 40.0, height: 1.1, focus: start };\n        let tray = cx.prop(\"fit_tray\", start + Vec3::Y * 1.25, 0.0, 1.0);\n        let mut glasses = Vec::new();\n        for k in 0..5 {\n            let a = k as f32 * TAU / 5.0;\n            let p = if k == 4 { Vec2::ZERO } else { Vec2::new(a.cos(), a.sin()) * 0.2 };\n            let id = cx.prop_color(\"fit_smoothie\", start + Vec3::Y * 1.3, 0.0, 0.9, COLORS[k]);\n            glasses.push(Glass { id, p, v: Vec2::ZERO, fall: 0.0, gone: false });\n        }\n        // The jolts are known in advance: a plank gap, a wave, a gull. The bot leans ahead of them.\n        let walk = (end.z - start.z) / cx.r.tray.pace;\n        let n = 12;\n        let mut jolts = Vec::new();\n        for k in 0..n {\n            let at = 3.0 + (walk - 6.0) * k as f32 / n as f32 + cx.rng().range(-0.5, 0.5);\n            let a = cx.rng().range(0.0, TAU);\n            jolts.push(Jolt { at, dir: Vec2::new(a.cos(), a.sin()), kind: (k % 3) as u8, done: false });\n        }\n        let gull = cx.prop(\"fit_gull\", start + Vec3::new(0.0, 8.0, 0.0), 0.0, 1.0);\n        Self { t: 0.0, pos: start, start, end, glasses, jolts, tray: Some(tray), gull: Some(gull), gull_t: 0.0, arrived: false, lost: 0, sway: Vec2::ZERO, tilt: Vec2::ZERO, over: 0.0, told: false }\n    }\n\n    fn sway_at(t: f32) -> Vec2 {\n        Vec2::new((t * 0.9).sin() + 0.4 * (t * 2.3).sin(), 0.5 * (t * 1.3 + 1.0).sin())\n    }\n\n    pub fn tick(&mut self, cx: &mut Cx, _i: &Intent) -> bool {\n        let dt = cx.dt;\n        self.t += dt;\n        let r = cx.r.tray.clone();\n        if self.arrived {\n            self.over += dt;\n            cx.player(self.pos, 0.0);\n            return self.over > 1.5;\n        }\n        self.pos.z += r.pace * dt;\n        cx.player(self.pos, 0.0);\n        cx.clip(\"STYLE100/Balance_Walk\", 1.0);\n        // The pier rolls under you: the tray leans with it unless you counter.\n        self.sway = Self::sway_at(self.t) * r.sway;\n        self.tilt = cx.core.cob + self.sway;\n        for j in self.jolts.iter_mut() {\n            if !j.done && self.t >= j.at {\n                j.done = true;\n                cx.core.nudge += j.dir * r.jolt * 5.0;\n                let kick = j.dir * 0.32 * (r.jolt / 26.0);\n                for g in self.glasses.iter_mut().filter(|g| !g.gone) {\n                    g.v += kick;\n                }\n                match j.kind {\n                    0 => {\n                        cx.sfx(sfx::CREAK, 0.8, 1.0);\n                        cx.say(\"A plank gap. Who put that there. Pip knows.\", 1.6);\n                    }\n                    1 => {\n                        cx.sfx(sfx::WAVE, 0.7, 1.2);\n                        cx.ev.push(SimEvent::Splash { pos: self.pos + Vec3::X * 2.2 });\n                    }\n                    _ => {\n                        self.gull_t = 1.6;\n                        cx.sfx(sfx::GULL, 0.9, 1.0);\n                    }\n                }\n            }\n        }\n        if self.gull_t > 0.0 {\n            self.gull_t -= dt;\n            let u = self.gull_t / 1.6;\n            if let Some(g) = self.gull {\n                let at = self.pos + Vec3::new((u - 0.5) * 12.0, 1.8 + 3.0 * (u - 0.5).abs() * 2.0, 0.5);\n                cx.place(g, at, Quat::from_rotation_y(1.57));\n            }\n        }\n        let tray_at = self.pos + Vec3::Y * 1.25 + Vec3::new(0.0, 0.0, 0.34);\n        let q = Quat::from_rotation_z(self.tilt.x * 0.22) * Quat::from_rotation_x(-self.tilt.y * 0.22);\n        if let Some(t) = self.tray {\n            cx.place(t, tray_at, q);\n        }\n        let mut plops = 0;\n        for g in self.glasses.iter_mut() {\n            if g.gone {\n                continue;\n            }\n            if g.fall > 0.0 {\n                g.fall += dt;\n                let at = tray_at + Vec3::new(-g.p.x, 0.0, g.p.y) - Vec3::Y * 4.9 * g.fall * g.fall;\n                if at.y < 0.0 {\n                    g.gone = true;\n                    plops += 1;\n                }\n                if let Some(e) = cx.sim.state.entities.get_mut(g.id) {\n                    e.pos = at;\n                }\n                continue;\n            }\n            g.v += (self.tilt * r.slide - g.v * r.friction) * dt;\n            g.p += g.v * dt;\n            if g.p.length() > r.edge {\n                g.fall = 0.001;\n            }\n            let at = tray_at + q * Vec3::new(-g.p.x, 0.03, g.p.y);\n            if let Some(e) = cx.sim.state.entities.get_mut(g.id) {\n                e.pos = at;\n                e.rot = q;\n            }\n        }\n        if plops > 0 {\n            self.lost += plops;\n            cx.sfx(sfx::GLASS, 0.9, 1.0);\n            cx.ev.push(SimEvent::Splash { pos: self.pos + Vec3::new(2.2, 0.0, 0.0) });\n            if !self.told {\n                self.told = true;\n                let line = cx.pick(\"gull_glass\");\n                cx.say(line, 3.0);\n            }\n        }\n        *cx.shot = Shot { tilt: 24.0, yaw: CAM, distance: 7.0, fov: 40.0, height: 1.1, focus: self.pos };\n        cx.lean_body(CAM);\n        if self.pos.z >= self.end.z {\n            self.arrived = true;\n            let line = match self.delivered() {\n                5 => cx.pick(\"marjorie_all\"),\n                0 => cx.pick(\"marjorie_none\"),\n                _ => cx.pick(\"marjorie_some\"),\n            };\n            cx.say(line, 3.0);\n            cx.gesture(\"FIT/Bow\");\n            cx.sfx(sfx::CHEER, 0.6, 1.0);\n        }\n        false\n    }\n\n    pub fn delivered(&self) -> u32 {\n        self.glasses.iter().filter(|g| !g.gone && g.fall <= 0.0).count() as u32\n    }\n\n    pub fn bot(&self, core: &BalanceCore, r: &Rules) -> Intent {\n        let mut i = Intent::default();\n        // Counter the pier's roll, and lean back against the next known jolt as it lands. The\n        // tray is level again when `cob + sway` is zero, so aim the dot at minus the sway.\n        let sway = Self::sway_at(self.t + 0.1) * r.tray.sway;\n        let mut want = -sway;\n        // Pull the worst glass back toward the middle.\n        if let Some(g) = self.glasses.iter().filter(|g| !g.gone && g.fall <= 0.0).max_by(|a, b| a.p.length().total_cmp(&b.p.length())) {\n            want += -g.p * 1.1 - g.v * 0.5;\n        }\n        i.lean = pd(core, want);\n        i\n    }\n\n    pub fn hud(&self, b: &mut B, core: &BalanceCore, r: &Rules) {\n        // The tray from above: the player's view of what is about to happen.\n        let c = [260.0, 260.0];\n        let s = 180.0 / r.tray.edge;\n        b.puck(PUCK_TOP, PUCK_R, (core.cob + self.sway).clamp_length_max(1.0).into());\n        b.puck_ring((-self.sway).clamp_length_max(1.0).into(), 0.3);\n        b.circle(c, r.tray.edge * s, DECK, TEAL, 10.0);\n        for (k, g) in self.glasses.iter().enumerate() {\n            if !g.gone && g.fall <= 0.0 {\n                let col = [CORAL, SUN, MINT, TEAL, INK][k % 5];\n                b.circle([c[0] + g.p.x * s, c[1] - g.p.y * s], 26.0, col, WHITE, 4.0);\n            }\n        }\n        b.bar([560.0, 40.0, 1360.0, 70.0], ((self.pos.z - self.start.z) / (self.end.z - self.start.z)).clamp(0.0, 1.0), TEAL, None);\n    }\n\n    pub fn score(&self, r: &Rules) -> f32 {\n        let d = self.delivered();\n        (1000.0 - r.tray.no_spill_bonus) / 5.0 * d as f32 + if d == 5 && self.arrived { r.tray.no_spill_bonus } else { 0.0 }\n    }\n}\nRS\ncat > $F/events/cannon.rs <<'RS'\n//! Cannonball Cup: bounce on the board, press at the bottom of three bounces, leap on the fourth;\n//! tuck in the air and rotate with the lean. The judges are not here for form.\n\nuse super::*;\nuse crate::games::fit::sfx;\n\n#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]\npub enum Stage {\n    Bounce,\n    Air,\n    Under,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Cannon {\n    pub t: f32,\n    pub dive: u32,\n    pub stage: Stage,\n    pub power: f32,\n    pub presses: u32,\n    pub stage_t: f32,\n    pub y: f32,\n    pub z: f32,\n    pub vy: f32,\n    pub vz: f32,\n    pub tuck: f32,\n    pub angle: f32,\n    pub scores: Vec<f32>,\n    timing_sum: f32,\n    apex: f32,\n    tuck_time: f32,\n    tuck_at_entry: f32,\n    board: Option<EntityId>,\n    water: Vec3,\n    bounce_t: f32,\n    pub cards: [String; 3],\n    card_ids: Vec<EntityId>,\n    last_bottom: u32,\n    pub waited: f32,\n    judges: Vec<EntityId>,\n    wing_t: f32,\n    tick_id: u32,\n}\n\nconst CAM: f32 = 90.0;\n\nimpl Cannon {\n    pub fn start(cx: &mut Cx, _o: Opt) -> Self {\n        let at = cx.spot(TOWER, \"board\");\n        let board = cx.prop(\"fit_board\", at - Vec3::new(0.0, 0.05, 4.0), 0.0, 1.0);\n        let jud = cx.spot(TOWER, \"judges\");\n        let mut judges = Vec::new();\n        let mut card_ids = Vec::new();\n        for k in 0..3 {\n            let p = jud + Vec3::new(0.0, 0.1, (k as f32 - 1.0) * 1.2);\n            judges.push(cx.prop(\"fit_gull\", p + Vec3::Y * 0.35, -1.57, 1.3));\n            card_ids.push(cx.prop(\"fit_card\", p + Vec3::new(0.0, 0.0, 0.0) - Vec3::Y * 9.0, -1.57, 1.0));\n        }\n        cx.player(at, 0.0);\n        cx.core.wobble = 0.4;\n        cx.ev.push(SimEvent::Music { song: 5 });\n        *cx.shot = Shot { tilt: 6.0, yaw: CAM, distance: 14.0, fov: 40.0, height: 2.0, focus: at + Vec3::new(0.0, 0.0, 3.0) };\n        Self { t: 0.0, dive: 0, stage: Stage::Bounce, power: 0.0, presses: 0, stage_t: 0.0, y: at.y, z: at.z, vy: 0.0, vz: 0.0, tuck: 0.0, angle: 0.0, scores: Vec::new(), timing_sum: 0.0, apex: 0.0, tuck_time: 0.0, tuck_at_entry: 0.0, board: Some(board), water: at, bounce_t: 0.0, cards: Default::default(), card_ids, last_bottom: 0, waited: 0.0, judges, wing_t: 0.0, tick_id: 0 }\n    }\n\n    /// How far into the bounce (0 = the bottom), and the distance from the bottom (s).\n    fn phase(&self, r: &Rules) -> f32 {\n        let p = r.dive.period;\n        let u = self.bounce_t.rem_euclid(p);\n        u.min(p - u)\n    }\n\n    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        let dt = cx.dt;\n        self.t += dt;\n        self.stage_t += dt;\n        self.wing_t += dt;\n        self.tick_id += 1;\n        let r = cx.r.dive.clone();\n        let spot = cx.spot(TOWER, \"board\");\n        match self.stage {\n            Stage::Bounce => {\n                self.bounce_t += dt;\n                self.waited += dt;\n                let p = r.period;\n                // Bigger and bigger bounces as power builds.\n                let amp = 0.25 + self.power * 0.28;\n                let w = (self.bounce_t / p * TAU).cos();\n                let h = (1.0 - w) * 0.5 * amp;\n                let bend = (w + 1.0) * 0.5 * 0.22 * (1.0 + self.power * 0.5);\n                self.y = spot.y + h - bend * 0.5;\n                self.z = spot.z;\n                if let Some(b) = self.board {\n                    cx.place(b, spot - Vec3::new(0.0, 0.05, 4.0), Quat::from_rotation_x(bend * 0.14));\n                }\n                let bottom = (self.bounce_t / p).round() as u32;\n                if bottom != self.last_bottom && self.phase(cx.r) < 0.03 {\n                    self.last_bottom = bottom;\n                    cx.sfx(sfx::BOING, 0.5, 0.8 + 0.12 * self.power);\n                }\n                cx.player(Vec3::new(spot.x, self.y, self.z), 0.0);\n                cx.scrub(\"FIT/Squat\", (bend * 2.0).min(0.6));\n                cx.lean_body(CAM);\n                if i.act_p {\n                    let off = self.phase(cx.r);\n                    let timing = (1.0 - off / (p * 0.5)).clamp(0.0, 1.0);\n                    let good = off <= r.timing;\n                    self.timing_sum += timing;\n                    self.presses += 1;\n                    if good {\n                        self.power += r.bounce_gain * 0.42;\n                        cx.sfx(sfx::GOOD, 0.5, 0.9 + 0.1 * self.power);\n                    } else {\n                        cx.sfx(sfx::SQUEAK, 0.5, 0.8);\n                    }\n                    if self.presses >= 4 {\n                        self.leap(cx, &r);\n                    }\n                }\n                if self.waited > r.wait {\n                    // The board tips you off: a belly flop of no distinction.\n                    self.timing_sum = 0.0;\n                    self.power = 0.0;\n                    self.presses = 4;\n                    self.leap(cx, &r);\n                    cx.say(\"The board has made a decision.\", 2.0);\n                }\n            }\n            Stage::Air => {\n                self.vy -= 9.8 * dt;\n                self.y += self.vy * dt;\n                self.z += self.vz * dt;\n                self.apex = self.apex.max(self.y);\n                self.tuck += (if i.act { 1.0 } else { 0.0 } - self.tuck) * (1.0 - (-12.0 * dt).exp());\n                if i.act {\n                    self.tuck_time += dt;\n                }\n                self.angle += cx.core.cob.x * r.spin * (0.5 + self.tuck) * dt;\n                if self.tuck > 0.5 {\n                    cx.scrub(\"FIT/Tuck\", self.tuck);\n                } else {\n                    cx.scrub(\"FIT/DiveEntry\", 0.5);\n                }\n                cx.player(Vec3::new(spot.x, self.y.max(0.02), self.z), 0.0);\n                if let Some(a) = cx.anim() {\n                    a.tilt_side = 0.0;\n                    a.tilt_fwd = self.angle;\n                    a.tilt_pivot = 0.8;\n                }\n                if self.y <= 0.0 {\n                    self.tuck_at_entry = self.tuck;\n                    let height = ((self.apex - 0.0) / (spot.y + r.height)).clamp(0.0, 1.2);\n                    let timing = self.timing_sum / 4.0;\n                    let tuck = 0.4 + 0.6 * self.tuck_at_entry;\n                    let size = (height * tuck * 2.6).clamp(0.2, 3.0);\n                    let score = (height * tuck * (0.45 + 0.55 * timing)).clamp(0.0, 1.0) * 1000.0;\n                    self.scores.push(score);\n                    let pos = Vec3::new(spot.x, 0.0, self.z);\n                    self.water = pos;\n                    cx.ev.push(SimEvent::BigSplash { pos, size });\n                    cx.sfx(sfx::SPLASH_B, (0.5 + size * 0.3).min(1.2), 1.1 - size * 0.12);\n                    cx.sfx(sfx::CHEER, (size * 0.3).min(0.8), 1.0);\n                    self.give_cards(cx, score);\n                    self.stage = Stage::Under;\n                    self.stage_t = 0.0;\n                }\n            }\n            Stage::Under => {\n                let u = self.stage_t;\n                cx.player(self.water - Vec3::Y * 0.6 * (1.0 - (u * 2.0).min(1.0)) + Vec3::Y * 0.0, 0.0);\n                if let Some(a) = cx.anim() {\n                    a.tilt_fwd = 0.0;\n                    a.tilt_pivot = 0.0;\n                }\n                cx.scrub(\"FIT/Sigh\", 0.5);\n                if u > 3.0 {\n                    self.dive += 1;\n                    for id in &self.card_ids {\n                        if let Some(e) = cx.sim.state.entities.get_mut(*id) {\n                            e.pos.y = -9.0;\n                        }\n                    }\n                    if self.dive >= 3 {\n                        return true;\n                    }\n                    self.stage = Stage::Bounce;\n                    self.stage_t = 0.0;\n                    self.power = 0.0;\n                    self.presses = 0;\n                    self.timing_sum = 0.0;\n                    self.apex = 0.0;\n                    self.tuck = 0.0;\n                    self.tuck_time = 0.0;\n                    self.angle = 0.0;\n                    self.waited = 0.0;\n                    self.bounce_t = 0.0;\n                    self.last_bottom = 0;\n                }\n            }\n        }\n        // The judges bob.\n        let n = self.judges.len();\n        let jud = cx.spot(TOWER, \"judges\");\n        for k in 0..n {\n            let id = self.judges[k];\n            let up = (self.wing_t * 2.0 + k as f32).sin().abs() * 0.04;\n            let p = jud + Vec3::new(0.0, 0.45 + up, (k as f32 - 1.0) * 1.2);\n            cx.place(id, p, Quat::from_rotation_y(-1.57));\n        }\n        let focus = match self.stage {\n            Stage::Bounce => Vec3::new(spot.x, spot.y + 0.8, spot.z + 2.0),\n            Stage::Air => Vec3::new(spot.x, (self.y + 1.0).max(1.5), self.z + 1.0),\n            Stage::Under => self.water + Vec3::new(0.0, 1.2, 2.0),\n        };\n        *cx.shot = Shot { tilt: 6.0, yaw: CAM, distance: 14.0, fov: 40.0, height: 0.5, focus };\n        false\n    }\n\n    fn leap(&mut self, cx: &mut Cx, r: &crate::games::fit::rules::DiveRules) {\n        self.stage = Stage::Air;\n        self.stage_t = 0.0;\n        let height = 1.0 + r.height * (self.power / (r.bounce_gain * 0.42 * 4.0)).clamp(0.0, 1.0);\n        self.vy = (2.0 * 9.8 * height).sqrt();\n        self.vz = 2.4;\n        self.apex = self.y;\n        cx.sfx(sfx::WHOOSH, 0.9, 1.0);\n        cx.sfx(sfx::BOING, 0.9, 1.3);\n    }\n\n    fn give_cards(&mut self, cx: &mut Cx, score: f32) {\n        // Three gulls, three opinions.\n        let base = score / 100.0;\n        for k in 0..3 {\n            let v = (base + cx.rng().range(-1.0, 1.0)).clamp(0.0, 10.0);\n            let v = (v * 2.0).round() / 2.0;\n            self.cards[k] = if k == 2 && cx.rng().f32() < 0.35 { \"See me\".into() } else if v.fract() == 0.0 { format!(\"{}\", v as u32) } else { format!(\"{v:.1}\") };\n        }\n        let jud = cx.spot(TOWER, \"judges\");\n        for k in 0..3 {\n            let id = self.card_ids[k];\n            cx.place(id, jud + Vec3::new(0.0, 0.1, (k as f32 - 1.0) * 1.2), Quat::from_rotation_y(-1.57));\n        }\n        cx.sfx(sfx::GULL, 0.7, 1.0);\n        let line = cx.pick(\"gull_dive\");\n        cx.say(line, 3.0);\n    }\n\n    pub fn bot(&self, core: &BalanceCore, r: &Rules) -> Intent {\n        let mut i = Intent::default();\n        match self.stage {\n            Stage::Bounce => {\n                if self.phase(r) < 0.012 && self.bounce_t > 0.3 {\n                    i.act_p = true;\n                    i.act = true;\n                }\n            }\n            Stage::Air => {\n                // Tuck at the apex, hold it to the water.\n                if self.vy < 1.0 {\n                    i.act = true;\n                }\n                i.lean = pd(core, Vec2::ZERO);\n            }\n            Stage::Under => {}\n        }\n        i\n    }\n\n    pub fn hud(&self, b: &mut B, _core: &BalanceCore, r: &Rules) {\n        b.title_left(60.0, 30.0, 80.0, INK, &format!(\"Dive {}\", (self.dive + 1).min(3)));\n        match self.stage {\n            Stage::Bounce => {\n                // The bounce meter: press when the marker is at the bottom.\n                let u = (self.bounce_t / r.dive.period * TAU).cos();\n                let y = 820.0 + 180.0 * (u + 1.0) * 0.5;\n                b.flat([1700.0, 820.0, 1800.0, 1000.0], PALE, 26.0);\n                b.flat([1700.0, 950.0, 1800.0, 1000.0], MINT, 26.0);\n                b.flat([1690.0, y - 10.0, 1810.0, y + 10.0], CORAL, 8.0);\n                for k in 0..4 {\n                    let on = k < self.presses;\n                    b.circle([820.0 + k as f32 * 90.0, 1000.0], 30.0, if on { TEAL } else { PALE }, WHITE, 4.0);\n                }\n                b.prompt_center(960.0, 900.0, &[Glyph::Confirm], \"At the bottom\");\n            }\n            Stage::Air => {\n                b.prompt_center(960.0, 900.0, &[Glyph::Confirm], \"Hold to tuck\");\n            }\n            Stage::Under => {\n                for k in 0..3 {\n                    let x = 560.0 + k as f32 * 400.0;\n                    b.card([x - 170.0, 120.0, x + 170.0, 280.0], WHITE);\n                    b.title(x, 150.0, 72.0, INK, &self.cards[k]);\n                }\n                if let Some(s) = self.scores.last() {\n                    b.center(960.0, 320.0, 50.0, INK, &format!(\"{:.0} points of splash\", s));\n                }\n            }\n        }\n    }\n\n    pub fn score(&self, _r: &Rules) -> f32 {\n        self.scores.iter().sum::<f32>() / 3.0\n    }\n}\nRS\n","description":"Write the lap, tide, paddle, tray and cannonball events"}}}
