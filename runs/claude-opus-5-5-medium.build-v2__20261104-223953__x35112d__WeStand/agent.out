 self) -> f32 {\n30:    pub fn range(&mut self, lo: f32, hi: f32) -> f32 {\n33:    pub fn below(&mut self, n: u32) -> u32 {\n39:pub fn hash3(seed: u64, x: i32, y: i32, z: i32) -> u64 {\n50:pub fn hash_f32(seed: u64, x: i32, y: i32, z: i32) -> f32 {\n66:    pub fn height(self) -> f32 {\n74:        (self.height() * 0.5 - RADIUS).max(0.01)\n389:    pub fn height(&self) -> f32 {\n390:        self.posture.height()\n461:    let stand = SharedShape::capsule_y(Posture::Stand.half_height(), RADIUS - 0.04);\n73:    pub fn half_height(self) -> f32 {\n461:    let stand = SharedShape::capsule_y(Posture::Stand.half_height(), RADIUS - 0.04);\n554:        let fat = SharedShape::capsule_y(ch.posture.half_height(), RADIUS + 0.08);\n630:            let shape = SharedShape::capsule_y(p.half_height(), RADIUS - 0.02);\n644:                c.set_shape(SharedShape::capsule_y(p.half_height(), RADIUS));\n25:pub mod games;\n35:pub mod nav;\n40:pub mod prop_instance;\n41:pub mod prop_preview;\n42:pub mod props;\n45:pub mod rng;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":true},"tool_result_meta":[{"id":"toolu_012YjyjEwNwazWjiSLAV6LR4","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
