   },\n    /// Starts a song (0 = silence) from its beginning; fades to silence with `song = 255`.\n    Music {\n        song: u8,\n    },\n    /// A huge splash: water dents and particles scaled by `size` (1 = a good dive).\n    BigSplash {\n        pos: Vec3,\n        size: f32,\n    },\n    /// A wake: a small silent dent in the water.\n    Wake {\n        pos: Vec3,\n    },\n    /// Confetti, a bloom of petals or sparkles, silently.\n    Burst {\n        pos: Vec3,\n        kind: u8,\n        count: u32,\n    },\n''')\nsub('crates/pav_core/src/frame.rs','''    /// A `games` game's HUD lines (`Game::hud`).\n    pub lines: Vec<String>,\n}''','''    /// A `games` game's HUD lines (`Game::hud`).\n    pub lines: Vec<String>,\n    /// The game's status JSON, published to the page.\n    pub status: Option<std::sync::Arc<String>>,\n    /// A game that draws its whole UI from a frame of items (`games::fit`).\n    pub fit: Option<std::sync::Arc<crate::games::fit::ui_model::UiFrame>>,\n    /// A camera the game drives itself, every tick.\n    pub camera: Option<GameCamera>,\n}\n\n/// The camera, as a game sets it each tick. Blending is the game's own business, so what the\n/// tools capture and what the window shows are the same.\n#[derive(Clone, Copy, Debug, Default, PartialEq)]\npub struct GameCamera {\n    pub tilt: f32,\n    pub yaw: f32,\n    pub distance: f32,\n    pub fov: f32,\n    pub height: f32,\n    /// Changes when the view cuts: no follow lag, and the arrival transition plays if `iris`.\n    pub cut: u32,\n    pub iris: bool,\n}''')\n\n# ---- games/mod.rs\ns=open('crates/pav_core/src/games/mod.rs').read()\ns=s.replace('''pub mod starter;\n''','''pub mod fit;\npub mod starter;\n''')\ns=s.replace('''pub static GAMES: &[Entry] =\n    &[entry::<starter::Starter>(\"Starter: collect every shard while slimes chase you (the template to copy).\", starter::build)];\n''','''pub static GAMES: &[Entry] = &[\n    entry::<starter::Starter>(\"Starter: collect every shard whi