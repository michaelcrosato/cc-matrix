{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AriiKhJeNJFYydhSX7ZtVw","type":"tool_result","content":"    pub help: String,\n}\n\n/// Visits every tunable field. Implementations decide what to do (draw UI, get, set, ...).\npub trait ParamVisitor {\n    fn float(&mut self, name: &str, v: &mut f32, min: f32, max: f32, help: &str);\n    fn int(&mut self, name: &str, v: &mut i32, min: i32, max: i32, help: &str);\n    fn bool(&mut self, name: &str, v: &mut bool, help: &str);\n    fn choice(&mut self, name: &str, v: &mut usize, options: &[&str], help: &str);\n    /// Called around nested groups. Return false from `enter` to skip the group.\n    fn enter(&mut self, name: &str) -> bool;\n    fn exit(&mut self);\n}\n\npub trait Tunable {\n    fn visit(&mut self, v: &mut dyn ParamVisitor);\n}\n\n/// Visits `t` as a nested group called `name`.\npub fn nested(v: &mut dyn ParamVisitor, name: &str, t: &mut dyn Tunable) {\n    if v.enter(name) {\n        t.visit(v);\n        v.exit();\n    }\n}\n\n/// Enums usable with `ParamVisitor::choice`.\npub trait ChoiceParam: Sized + Copy {\n    const NAMES: &'static [&'static str];\n    fn to_index(self) -> usize;\n    fn from_index(i: usize) -> Self;\n    fn name(self) -> &'static str {\n        Self::NAMES[self.to_index()]\n    }\n    fn visit_choice(&mut self, v: &mut dyn ParamVisitor, name: &str, help: &str) {\n        let mut i = self.to_index();\n        v.choice(name, &mut i, Self::NAMES, help);\n        *self = Self::from_index(i.min(Self::NAMES.len() - 1));\n    }\n}\n\n/// Declares a C-like enum as a `ChoiceParam` with snake_case display names.\n#[macro_export]\nmacro_rules! choice_enum {\n    ($(#[$m:meta])* $vis:vis enum $name:ident { $($(#[$vm:meta])* $var:ident => $label:literal),+ $(,)? }) => {\n        $(#[$m])*\n        #[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, serde::Serialize, serde::Deserialize)]\n        #[serde(rename_all = \"snake_case\")]\n        $vis enum $name { $($(#[$vm])* $var),+ }\n        impl $crate::params::ChoiceParam for $name {\n            const NAMES: &'static [&'static str] = &[$($label),+];\n            fn to_index(self) -> usize { self as usize }\n            fn from_index(i: usize) -> Self {\n                const ALL: &[$name] = &[$($name::$var),+];\n                ALL[i.min(ALL.len() - 1)]\n            }\n        }\n    };\n}\n\nstruct PathTracker {\n    stack: Vec<String>,\n}\n\nimpl PathTracker {\n    fn path(&self, name: &str) -> String {\n        if self.stack.is_empty() { name.to_string() } else { format!(\"{}.{}\", self.stack.join(\".\"), name) }\n    }\n}\n\n/// Lists every parameter with its current value.\n79:pub fn nested(v: &mut dyn ParamVisitor, name: &str, t: &mut dyn Tunable) {\n80-    if v.enter(name) {\n81-        t.visit(v);\n82-        v.exit();\n83-    }\n84-}\n85-\n--\n131:pub fn list(t: &mut dyn Tunable) -> Vec<ParamInfo> {\n132-    struct L {\n133-        p: PathTracker,\n134-        out: Vec<ParamInfo>,\n135-    }\n136-    impl ParamVisitor for L {\n137-        fn float(&mut self, name: &str, v: &mut f32, min: f32, max: f32, help: &str) {\n--\n188:pub fn apply_map(t: &mut dyn Tunable, values: &BTreeMap<String, ParamValue>) -> Vec<String> {\n189-    struct S<'a> {\n190-        p: PathTracker,\n191-        values: &'a BTreeMap<String, ParamValue>,\n192-        used: Vec<String>,\n193-    }\n194-    impl S<'_> {\n--\n250:pub fn set(t: &mut dyn Tunable, path: &str, value: ParamValue) -> Result<(), String> {\n251-    let mut m = BTreeMap::new();\n252-    m.insert(path.to_string(), value);\n253-    let missing = apply_map(t, &m);\n254-    if missing.is_empty() { Ok(()) } else { Err(format!(\"unknown parameter '{path}'\")) }\n255-}\n256-\n257:pub fn get(t: &mut dyn Tunable, path: &str) -> Option<ParamValue> {\n258-    list(t).into_iter().find(|p| p.path == path).map(|p| p.value)\n259-}\n260-\n261-#[cfg(test)]\n262-mod tests {\n263-    use super::*;\n        let left = if rolling { ch.roll } else { ch.dash_time };\n        let dur = crate::clips::with(dodge_clip, |c| c.dur).unwrap_or(1.0);\n        ch.anim.set_action(crate::moves::MoveId::NONE, 0.0, 0.0, 1.0);\n        ch.anim.replay_clip(dodge_clip, crate::clips::ONCE | crate::clips::QUICK, (dur / (left + 0.3)).clamp(1.0, 4.0));\n    }\n    ch.anim.dodged = dodging;\n    ch.anim.update(\n        puppet,\n        &AnimInput {\n            vel: ch.vel,\n            accel,\n            grounded: ch.grounded,\n            crouch: ch.posture == Posture::Crouch,\n            crawl: ch.posture == Posture::Crawl && !rolling && !creature,\n            climbing: climbing || hanging,\n            facing: ch.facing,\n            landed,\n            jumped,\n            swimming: ch.swimming,\n            rolling: dodging && dodge_clip == 0,\n        },\n        dt,\n    );\n    if hanging {\n        ch.anim.climb_phase = 0.25;\n    }\n    // An idle clip plays while the character stands still with nothing to do; a walk clip\n    // while it heads forward on the ground, as fast as it moves; a run clip instead once the\n    // walk would have to hurry (a monster giving chase).\n    if (!puppet.idle_clip.is_empty() || !puppet.walk_clip.is_empty() || !puppet.run_clip.is_empty())\n        && puppet.body == crate::puppet::BodyPlan::Biped\n    {\n        let id_of = |n: &str| if n.is_empty() { 0 } else { crate::clips::find_cached(n) };\n        let (idle, walk, run) = (id_of(&puppet.idle_clip), id_of(&puppet.walk_clip), id_of(&puppet.run_clip));\n        let ground = Vec2::new(ch.vel.x, ch.vel.z).length();\n        let free = ch.grounded\n            && ch.anim.act_kind == 0\n            && !climbing\n            && !hanging\n            && !ch.swimming\n            && ch.posture == Posture::Stand\n            && ch.anim.down <= 0.0;\n        // A styled walk may be slow (an old man's shuffle is under 0.2 m/s): still is slower.\n        let still = if walk != 0 || run != 0 { 0.1 } else { 0.3 };\n        let moving = match (walk, run) {\n            // A run alone runs (a walk is the procedural one).\n            (0, r) => {\n                let p = crate::clips::pace(puppet, r).unwrap_or(4.0 * crate::clips::hip_height(puppet));\n                if ground > 0.6 * p { r } else { 0 }\n            }\n            (w, 0) => w,\n            (w, r) => {\n                if crate::clips::run_over_walk(puppet, w, r, ground, ch.anim.clip == r) {\n                    r\n                } else {\n                    w\n                }\n            }\n        };\n        let want = if free && ground < still {\n            idle\n        } else if free && ch.anim.travel.abs() < 0.6 {\n            moving\n        } else {\n            0\n        };\n        let mine = |c: u32| c != 0 && (c == idle || c == walk || c == run);\n        // Its own clips, and one fading out (an attack, a gesture) a walk can take over from.\n        let ours = ch.anim.clip == 0 || mine(ch.anim.clip) || ch.anim.clip_flags & crate::clips::STOP != 0;\n        if ours {\n            if want != 0 {\n                let rate = if want == walk || want == run { crate::clips::walk_rate(puppet, want, ground) } else { 1.0 };\n                ch.anim.play_clip(want, 0, rate);\n            } else if mine(ch.anim.clip) {\n                ch.anim.stop_clip();\n            }\n        }\n    }\n    // Rig: creature feet step on the ground, tails and antennae swing; bipeds find the ground\n    // under each foot.\n    {\n        let feet_now = new_center - Vec3::Y * height * 0.5;\n        let qp = st.physics.query_filtered(filter);\n        let ground = |p: Vec3| -> Option<f32> {\n            qp.cast_ray(&Ray::new(Vec3::new(p.x, feet_now.y + 0.6, p.z), Vec3::NEG_Y), 1.4, true)\n                .map(|(_, t)| feet_now.y + 0.6 - t as f32)\n        };\n        if crate::rig::needs_rig(puppet) {\n            let rig = ch.rig.get_or_insert_with(|| Box::new(crate::rig::Rig::at_rest(puppet, feet_now, ch.anim.facing)));\n            let before = rig.steps;\n            rig.update(puppet, &ch.anim, feet_now, ch.vel, ch.grounded && !climbing && !hanging, &ground, dt);\ncrates/pav_core/src/puppet.rs:923:    let (q, shift) = body_motion(def, st);\ncrates/pav_core/src/puppet.rs:933:pub fn body_motion(def: &PuppetDef, st: &PuppetState) -> (Quat, Vec3) {\ncrates/pav_view/src/assets.rs:244:    let (q, shift) = pav_core::puppet::body_motion(&def, st);\n```\n\nCentimetres; x right, y up, z forward (+z is the front); the origin is on the floor under the\ncentre. Part names: lowercase letters, digits, _ and -.\n\n- **Place** a part by pos (its centre); by from/to, the visible ends of a box, rounded_box,\n  cylinder, cone, tube or capsule (they set its length: a box takes size [across, thick]); or by\n  attach:\"seat\" (on its top; {\"to\":\"seat\",\"at\":\"front\"}: top, bottom, front, back, left, right)\n  plus offset. yaw, pitch, roll: degrees about y, x, z; +yaw turns +z toward +x, +pitch tips +z\n  down. Round parts stand along y; axis:\"x\" lays one along x.\n- **Shapes** (type; full sizes): box size; rounded_box size, radius (at most half the thinnest\n  side); sphere radius; ellipsoid size; cylinder radius, height; cone radius, radius_end, height;\n  capsule radius, height; tube radius, thickness, height; torus radius, minor_radius; wedge size,\n  peak (-1 back … 1 front, 0 a gable); lathe profile [[r,y],…]; extrude points [[x,y],…],\n  depth. arc (degrees) keeps part of a round shape, its middle toward facing (x, y, z, -x, -y,\n  -z).\n- **Colour.** Each part needs color (#rrggbb or a role: $floor $floor2 $wall $pillar $accent\n  $light) or mat: a key in materials ({color, look, emissive}, or a patterned library material\n  such as \"MAT/oak_planks\"), or a library name itself. Patterns, the library and your own\n  materials: docs/MATERIALS.md. look: cel (default), flat, lit, unlit, cutout. emissive 0-32\n  glows; above 0.5 it lights the room.\n- **Groups.** parts:{…} in a node makes a group: its children sit in its frame and inherit mat,\n  color, look, emissive and solid.\n- **Copies.** mirror:\"x\" (or [\"x\",\"z\"]) adds the reflection; array:{count, step:[x,y,z]} a row;\n  grid:{count:[a,b], step:[sa,sb]} a floor grid (plane:\"xy\": a wall); radial:{count, radius} a\n  ring round the part's position, each copy facing out (axis:\"z\", arc:180, start:-90: an arch).\n  All are centred. cycle goes inside one (array:{count, step, cycle:[\"wood\",\"wood_dark\"]}) and\n  gives copy i entry i mod n. Copies are named leg[0], mirror copies leg~x.\n- **More.** solid:false: not in the collider; hidden:true: collision only. light:{color, radius,\n  intensity} and fx:{preset} (fire, smoke, sparks, embers, steam, magic …) sit at a visible part.\n  chance, jitter and a group's pick:n vary copies by seed. sockets: sit, grip, grip2, tip, top,\n  hang, wall_mount. {\"ref\":\"BUILTIN/crate\",\"pos\":[…],\"scale\":0.5} reuses an asset.\n  {\"mesh\":\"kenney_mini_dungeon/chair\"} is a mesh part `asset_import` wrote: place, scale, mirror,\n  recolor:{\"0\":\"#rrggbb\"} or solid:false it; never edit its file.\n\nLimits: 256 nodes, 1,024 parts after copies, 4 lights, 16 mesh parts. `asset_edit action=schema [topic=node]` is\nthe field guide (also tags, category, spin, sway, segments, half, half_height, remap, source, fit,\nmesh, recolor; material base, roughness, metallic, map, turn, layers).\n\n## Edits\n\n```json\n{\"tool\":\"asset_edit\",\"args\":{\"action\":\"patch\",\"name\":\"x\",\"if_revision\":\"prop2-…\",\"ops\":[{\"op\":\"set\",\"part\":\"seat\",\"fields\":{\"mat\":\"wood_dark\",\"size\":[220,20,76]}},{\"op\":\"add\",\"part\":\"arm\",\"value\":{\"type\":\"box\",\"size\":[6,20,60],\"pos\":[-104,99,0],\"mat\":\"wood\",\"mirror\":\"x\"}},{\"op\":\"remove\",\"part\":\"crossbar\"}]}}\n```\n\n        E::Pickup { pos, .. } => out.push(with(\"sparks\", *pos + Vec3::Y * 0.3, 8, &|b| {\n            b.spread = 1.0;\n            b.vel = Vec3::Y * 1.5;\n            b.color0 = Vec4::new(0.9, 0.95, 1.0, 1.0) * 1.4;\n        })),\n        E::Block { pos } => out.push(with(\"sparks\", *pos + Vec3::Y * 1.0, 18, &|b| {\n            b.spread = 3.0;\n            b.color0 = Vec4::new(0.8, 0.9, 1.0, 1.0) * 1.5;\n        })),\n        E::Hit { pos, .. } => out.push(with(\"sparks\", *pos, 16, &|b| {\n            b.spread = 3.5;\n            b.vel = Vec3::Y;\n            b.life = (0.2, 0.45);\n        })),\n        E::Splash { pos } => out.push(with(\"fountain\", *pos + Vec3::Y * 0.2, 40, &|b| {\n            b.vel = Vec3::Y * 3.0;\n            b.spread = 2.2;\n            b.floor = None;\n            b.life = (0.5, 0.8);\n        })),\n        E::Break { pos } => out.push(with(\"dust\", *pos, 24, &|_| {})),\n17:        \"smoke\" => (\n34:        \"steam\" => (\n51:        \"sparks\" => (\n67:        \"embers\" => (\n83:        \"fountain\" => (\n100:        \"snow\" => (\n116:        \"rain\" => (\n132:        \"fireflies\" => (\n145:        \"magic\" => (\n161:        \"dust\" => (\n177:        \"bubbles\" => (\n194:        \"confetti\" => (\n281:        \"lens\" => DistortKind::Lens,\n282:        \"ripple\" => DistortKind::Ripple,\ncrates/pav_render/src/scene.rs:416:pub struct ParticleBurst {\ncrates/pav_render/src/scene.rs-417-    pub count: u32,\ncrates/pav_render/src/scene.rs-418-    pub pos: Vec3,\ncrates/pav_render/src/scene.rs-419-    /// Spawn inside this box (half extents) around `pos`.\ncrates/pav_render/src/scene.rs-420-    pub area: Vec3,\ncrates/pav_render/src/scene.rs-421-    pub vel: Vec3,\ncrates/pav_render/src/scene.rs-422-    /// Random extra speed in any direction (m/s).\ncrates/pav_render/src/scene.rs-423-    pub spread: f32,\ncrates/pav_render/src/scene.rs-424-    pub gravity: f32,\ncrates/pav_render/src/scene.rs-425-    pub drag: f32,\ncrates/pav_render/src/scene.rs-426-    /// Life range (s).\ncrates/pav_render/src/scene.rs-427-    pub life: (f32, f32),\ncrates/pav_render/src/scene.rs-428-    /// Size at birth and at death (m, radius).\ncrates/pav_render