{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018bGwA6dEdrgvrL5hoRrhWx","type":"tool_result","content":"1\t//! What the simulation publishes for rendering each tick. Cheap to clone (static geometry is\n2\t//! shared through `Arc`s).\n3\t\n4\tuse glam::{Quat, Vec3};\n5\tuse serde::{Deserialize, Serialize};\n6\t\n7\tuse crate::entity::EntityId;\n8\tuse crate::puppet::{PuppetDef, PuppetState};\n9\tuse crate::shape::Visual;\n10\tuse crate::statics::StaticWorld;\n11\t\n12\t/// Animation state of a character, drawn as a puppet.\n13\t#[derive(Clone, Debug)]\n14\tpub struct PuppetFrame {\n15\t    pub state: PuppetState,\n16\t    /// Distance from the entity position (capsule centre) down to the feet.\n17\t    pub feet_offset: f32,\n18\t    /// Own look (NPCs); None = `RenderFrame::puppet_def`.\n19\t    pub def: Option<std::sync::Arc<PuppetDef>>,\n20\t    /// Creature feet and swinging chains.\n21\t    pub rig: Option<crate::rig::RigView>,\n22\t    /// Colour wash (hit flash, frozen, burning...) and its strength.\n23\t    pub tint: Option<([f32; 3], f32)>,\n24\t}\n25\t\n26\t#[derive(Clone, Debug)]\n27\tpub struct RenderObject {\n28\t    pub id: EntityId,\n29\t    pub pos: Vec3,\n30\t    pub rot: Quat,\n31\t    pub visual: Visual,\n32\t    /// Immutable parts belonging to this one object ID.\n33\t    pub prop: Option<crate::prop_instance::PropFrame>,\n34\t    pub puppet: Option<PuppetFrame>,\n35\t    /// Blink/highlight driver: bomb fuse seconds left, or < 0 for none.\n36\t    pub pulse: f32,\n37\t    /// Deformable body: particle positions and how to draw them.\n38\t    pub soft: Option<SoftView>,\n39\t    /// Car / helicopter parts (wheels, rotors).\n40\t    pub vehicle: Option<crate::vehicle::VehicleView>,\n41\t    /// A guard's vision cone.\n42\t    pub cone: Option<crate::stealth::ConeView>,\n43\t    /// Fixed scenery (no character, never moves, not a game actor): view filters treat it\n44\t    /// as part of the environment rather than the characters and objects.\n45\t    pub scenery: bool,\n46\t}\n47\t\n48\t#[derive(Clone, Debug)]\n49\tpub struct SoftView {\n50\t    pub points: Vec<Vec3>,\n51\t    /// Surface triangles (cubes, balls, cloth); empty for ropes.\n52\t    pub surface: std::sync::Arc<Vec<[u32; 3]>>,\n53\t    /// Rope segments.\n54\t    pub segments: std::sync::Arc<Vec<[u32; 2]>>,\n55\t    /// Rope thickness.\n56\t    pub radius: f32,\n57\t    /// Sheets are seen from both sides.\n58\t    pub two_sided: bool,\n59\t}\n60\t\n61\t/// Things that happened during a tick, for sound and effects.\n62\t#[derive(Clone, Debug, Serialize, Deserialize, PartialEq)]\n63\t#[serde(tag = \"type\", rename_all = \"snake_case\")]\n64\tpub enum SimEvent {\n65\t    Spawned {\n66\t        id: EntityId,\n67\t        pos: Vec3,\n68\t    },\n69\t    Impact {\n70\t        pos: Vec3,\n71\t        strength: f32,\n72\t    },\n73\t    Jump {\n74\t        pos: Vec3,\n75\t    },\n76\t    Land {\n77\t        pos: Vec3,\n78\t        speed: f32,\n79\t    },\n80\t    Explosion {\n81\t        pos: Vec3,\n82\t        radius: f32,\n83\t    },\n84\t    Step {\n85\t        pos: Vec3,\n86\t    },\n87\t    Throw {\n88\t        pos: Vec3,\n89\t    },\n90\t    EnterRoom {\n91\t        room: u16,\n92\t    },\n93\t    ExitRoom {\n94\t        room: u16,\n95\t    },\n96\t    Hit {\n97\t        pos: Vec3,\n98\t        strength: f32,\n99\t        /// The character struck, when it is one.\n100\t        #[serde(default)]\n101\t        target: Option<EntityId>,\n102\t    },\n103\t    Respawn {\n104\t        pos: Vec3,\n105\t    },\n106\t    CourseStart {\n107\t        pos: Vec3,\n108\t    },\n109\t    CourseFinish {\n110\t        pos: Vec3,\n111\t        time: f32,\n112\t        new_best: bool,\n113\t    },\n114\t    Gate {\n115\t        pos: Vec3,\n116\t        ok: bool,\n117\t    },\n118\t    Checkpoint {\n119\t        pos: Vec3,\n120\t    },\n121\t    Splash {\n122\t        pos: Vec3,\n123\t    },\n124\t    Pad {\n125\t        pos: Vec3,\n126\t    },\n127\t    /// A blaster shot, an enemy hit, an enemy destroyed.\n128\t    Shot {\n129\t        pos: Vec3,\n130\t    },\n131\t    Damage {\n132\t        pos: Vec3,\n133\t    },\n134\t    Destroyed {\n135\t        pos: Vec3,\n136\t        size: f32,\n137\t    },\n138\t    /// A guard raised the alarm.\n139\t    Spotted {\n140\t        pos: Vec3,\n141\t    },\n142\t    Grab {\n143\t        pos: Vec3,\n144\t    },\n145\t    Roll {\n146\t        pos: Vec3,\n147\t    },\n148\t    /// A tile starts crumbling / breaks.\n149\t    Crack {\n150\t        pos: Vec3,\n151\t    },\n152\t    Break {\n153\t        pos: Vec3,\n154\t    },\n155\t    Bounce {\n156\t        pos: Vec3,\n157\t    },\n158\t    /// Shardfall: a weapon swing, a hit landing (power = damage, element index), a kill, a\n159\t    /// slam, a spell cast, an explosion, gold, a potion, a block, a level-up.\n160\t    Swing {\n161\t        pos: Vec3,\n162\t        heavy: bool,\n163\t    },\n164\t    Strike {\n165\t        pos: Vec3,\n166\t        power: f32,\n167\t        element: u8,\n168\t        crit: bool,\n169\t    },\n170\t    Slain {\n171\t        pos: Vec3,\n172\t        size: f32,\n173\t    },\n174\t    Slam {\n175\t        pos: Vec3,\n176\t        radius: f32,\n177\t    },\n178\t    Spell {\n179\t        pos: Vec3,\n180\t        element: u8,\n181\t    },\n182\t    Blast {\n183\t        pos: Vec3,\n184\t        element: u8,\n185\t    },\n186\t    Coin {\n187\t        pos: Vec3,\n188\t    },\n189\t    Potion {\n190\t        pos: Vec3,\n191\t    },\n192\t    Block {\n193\t        pos: Vec3,\n194\t    },\n195\t    LevelUp {\n196\t        pos: Vec3,\n197\t    },\n198\t    /// An item dropped (rarity 0 normal .. 3 unique) or was picked up.\n199\t    Loot {\n200\t        pos: Vec3,\n201\t        rarity: u8,\n202\t    },\n203\t    Pickup {\n204\t        pos: Vec3,\n205\t        rarity: u8,\n206\t    },\n207\t    /// Arrived somewhere else (Shardfall place code).\n208\t    Travel {\n209\t        place: u32,\n210\t    },\n211\t}\n212\t\n213\t/// The room the player is in, for the HUD (info card, control guide, camera defaults).\n214\t#[derive(Clone, Debug)]\n215\tpub struct RoomInfo {\n216\t    pub id: u16,\n217\t    pub key: String,\n218\t    pub def: std::sync::Arc<crate::room::RoomDef>,\n219\t    /// Quarter turns (clockwise from above) the room was rotated by when placed.\n220\t    pub quarters: u8,\n221\t}\n222\t\n223\t/// A projectile as drawn (velocity lets the view interpolate).\n224\t#[derive(Clone, Copy, Debug)]\n225\tpub struct ProjectileView {\n226\t    pub pos: Vec3,\n227\t    pub vel: Vec3,\n228\t    pub radius: f32,\n229\t    pub color: crate::color::Color,\n230\t}\n231\t\n232\t/// Game state the HUD shows.\n233\t#[derive(Clone, Debug, Default)]\n234\tpub struct HudFrame {\n235\t    pub course: Option<crate::course::CourseHud>,\n236\t    pub last_result: Option<crate::course::CourseResult>,\n237\t    /// Short message and the tick it was posted.\n238\t    pub message: Option<(String, u64)>,\n239\t    pub feel: crate::feel::FeelReport,\n240\t    /// Camera cue from pads / camera zones, and a counter that changes with it.\n241\t    pub cue: Option<std::sync::Arc<crate::zones::CameraCue>>,\n242\t    pub cue_serial: u64,\n243\t    /// Player hit flash (seconds of invulnerability left).\n244\t    pub invuln: f32,\n245\t    pub model: String,\n246\t    pub physics: PhysicsStats,\n247\t    /// View settings from pads (applied on top of the room's), and a counter that changes.\n248\t    pub view: std::collections::BTreeMap<String, crate::params::ParamValue>,\n249\t    pub view_serial: u64,\n250\t    /// Boss health bar: name and remaining fraction.\n251\t    pub boss: Option<(String, f32)>,\n252\t    /// The last pad with a note the player stepped on: label, note, tick.\n253\t    pub pad_note: Option<(String, String, u64)>,\n254\t    /// A `games` game's HUD lines (`Game::hud`).\n255\t    pub lines: Vec<String>,\n256\t}\n257\t\n258\t/// Physics counters for the stats overlay.\n259\t#[derive(Clone, Copy, Debug, Default)]\n260\tpub struct PhysicsStats {\n261\t    pub dynamic: usize,\n262\t    pub sleeping: usize,\n263\t    pub colliders: usize,\n264\t    pub joints: usize,\n265\t    pub soft_bodies: usize,\n266\t    pub particles: usize,\n267\t    pub contacts: usize,\n268\t    pub projectiles: usize,\n269\t}\n270\t\n271\t#[derive(Clone, Debug)]\n272\tpub struct RenderFrame {\n273\t    pub tick: u64,\n274\t    pub time: f64,\n275\t    pub dt: f32,\n276\t    /// Last accepted live edit included in this frame. View interpolation must not mix it\n277\t    /// with an older revision before the application acknowledges drawing the ticket.\n278\t    pub live_edit_ticket: u64,\n279\t    pub objects: Vec<RenderObject>,\n280\t    pub statics: StaticWorld,\n281\t    /// Suggested camera focus (the player, or the scene centre).\n282\t    pub focus: Vec3,\n283\t    /// True when `focus` is a player character (enables cutaway/fade helpers).\n284\t    pub focus_is_player: bool,\n285\t    pub player: Option<EntityId>,\n286\t    pub puppet_def: PuppetDef,\n287\t    pub room: Option<RoomInfo>,\n288\t    /// The simulation's configuration (shared; changes when rooms override parameters).\n289\t    pub config: std::sync::Arc<crate::sim::SimConfig>,\n290\t    pub events: Vec<SimEvent>,\n291\t    pub projectiles: Vec<ProjectileView>,\n292\t    pub hud: HudFrame,\n293\t    /// Shardfall state for the view and HUD (None outside the game).\n294\t    pub game: Option<std::sync::Arc<crate::arpg::GameFrame>>,\n295\t    /// Agent-readable playback controls for the animation stage.\n296\t    pub animation_preview: Option<crate::animation_preview::PreviewInfo>,\n297\t    pub studio_mode: crate::prop_preview::StudioMode,\n298\t    pub prop_preview: Option<crate::prop_preview::PropPreviewInfo>,\n299\t    pub creature_preview: Option<crate::creature_preview::CreaturePreviewInfo>,\n300\t    /// The generated native stage subject, separate from simulation entity geometry.\n301\t    pub creature: Option<crate::creature_preview::CreatureFrame>,\n302\t}\n303\t"}]},"parent_tool_use_id":null,"session_id":"cb437ba7-0477-4143-bb04-ff33f49efd62","uuid":"ba2af547-9443-4ff4-a59c-b2915eceb59f","timestamp":"2026-11-05T05:40:27.260Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953/engine/crates/pav_core/src/frame.rs","content":"//! What the simulation publishes for rendering each tick. Cheap to clone (static geometry is\n//! shared through `Arc`s).\n\nuse glam::{Quat, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse crate::entity::EntityId;\nuse crate::puppet::{PuppetDef, PuppetState};\nuse crate::shape::Visual;\nuse crate::statics::StaticWorld;\n\n/// Animation state of a character, drawn as a puppet.\n#[derive(Clone, Debug)]\npub struct PuppetFrame {\n    pub state: PuppetState,\n    /// Distance from the entity position (capsule centre) down to the feet.\n    pub feet_offset: f32,\n    /// Own look (NPCs); None = `RenderFrame::puppet_def`.\n    pub def: Option<std::sync::Arc<PuppetDef>>,\n    /// Creature feet and swinging chains.\n    pub rig: Option<crate::rig::RigView>,\n    /// Colour wash (hit flash, frozen, burning...) and its strength.\n    pub tint: Option<([f32; 3], f32)>,\n}\n\n#[derive(Clone, Debug)]\npub struct RenderObject {\n    pub id: EntityId,\n    pub pos: Vec3,\n    pub rot: Quat,\n    pub visual: Visual,\n    /// Immutable parts belonging to this one object ID.\n    pub prop: Option<crate::prop_instance::PropFrame>,\n    pub puppet: Option<PuppetFrame>,\n    /// Blink/highlight driver: bomb fuse seconds left, or < 0 for none.\n    pub pulse: f32,\n    /// Deformable body: particle positions and how to draw them.\n    pub soft: Option<SoftView>,\n    /// Car / helicopter parts (wheels, rotors).\n    pub vehicle: Option<crate::vehicle::VehicleView>,\n    /// A guard's vision cone.\n    pub cone: Option<crate::stealth::ConeView>,\n    /// Fixed scenery (no character, never moves, not a game actor): view filters treat it\n    /// as part of the environment rather than the characters and objects.\n    pub scenery: bool,\n}\n\n#[derive(Clone, Debug)]\npub struct SoftView {\n    pub points: Vec<Vec3>,\n    /// Surface triangles (cubes, balls, cloth); empty for ropes.\n    pub surface: std::sync::Arc<Vec<[u32; 3]>>,\n    /// Rope segments.\n    pub segments: std::sync::Arc<Vec<[u32; 2]>>,\n    /// Rope thickness.\n    pub radius: f32,\n    /// Sheets are seen from both sides.\n    pub two_sided: bool,\n}\n\n/// Things that happened during a tick, for sound and effects.\n#[derive(Clone, Debug, Serialize, Deserialize, PartialEq)]\n#[serde(tag = \"type\", rename_all = \"snake_case\")]\npub enum SimEvent {\n    Spawned {\n        id: EntityId,\n        pos: Vec3,\n    },\n    Impact {\n        pos: Vec3,\n        strength: f32,\n    },\n    Jump {\n        pos: Vec3,\n    },\n    Land {\n        pos: Vec3,\n        speed: f32,\n    },\n    Explosion {\n        pos: Vec3,\n        radius: f32,\n    },\n    Step {\n        pos: Vec3,\n    },\n    Throw {\n        pos: Vec3,\n    },\n    EnterRoom {\n        room: u16,\n    },\n    ExitRoom {\n        room: u16,\n    },\n    Hit {\n        pos: Vec3,\n        strength: f32,\n        /// The character struck, when it is one.\n        #[serde(default)]\n        target: Option<EntityId>,\n    },\n    Respawn {\n        pos: Vec3,\n    },\n    CourseStart {\n        pos: Vec3,\n    },\n    CourseFinish {\n        pos: Vec3,\n        time: f32,\n        new_best: bool,\n    },\n    Gate {\n        pos: Vec3,\n        ok: bool,\n    },\n    Checkpoint {\n        pos: Vec3,\n    },\n    Splash {\n        pos: Vec3,\n    },\n    Pad {\n        pos: Vec3,\n    },\n    /// A blaster shot, an enemy hit, an enemy destroyed.\n    Shot {\n        pos: Vec3,\n    },\n    Damage {\n        pos: Vec3,\n    },\n    Destroyed {\n        pos: Vec3,\n        size: f32,\n    },\n    /// A guard raised the alarm.\n    Spotted {\n        pos: Vec3,\n    },\n    Grab {\n        pos: Vec3,\n    },\n    Roll {\n        pos: Vec3,\n    },\n    /// A tile starts crumbling / breaks.\n    Crack {\n        pos: Vec3,\n    },\n    Break {\n        pos: Vec3,\n    },\n    Bounce {\n        pos: Vec3,\n    },\n    /// Shardfall: a weapon swing, a hit landing (power = damage, element index), a kill, a\n    /// slam, a spell cast, an explosion, gold, a potion, a block, a level-up.\n    Swing {\n        pos: Vec3,\n        heavy: bool,\n    },\n    Strike {\n        pos: Vec3,\n        power: f32,\n        element: u8,\n        crit: bool,\n    },\n    Slain {\n        pos: Vec3,\n        size: f32,\n    },\n    Slam {\n        pos: Vec3,\n        radius: f32,\n    },\n    Spell {\n        pos: Vec3,\n        element: u8,\n    },\n    Blast {\n        pos: Vec3,\n        element: u8,\n    },\n    Coin {\n        pos: Vec3,\n    },\n    Potion {\n        pos: Vec3,\n    },\n    Block {\n        pos: Vec3,\n    },\n    LevelUp {\n        pos: Vec3,\n    },\n    /// An item dropped (rarity 0 normal .. 3 unique) or was picked up.\n    Loot {\n        pos: Vec3,\n        rarity: u8,\n    },\n    Pickup {\n        pos: Vec3,\n        rarity: u8,\n    },\n    /// Arrived somewhere else (Shardfall place code).\n    Travel {\n        place: u32,\n    },\n}\n\n/// The room the player is in, for the HUD (info card, control guide, camera defaults).\n#[derive(Clone, Debug)]\npub struct RoomInfo {\n    pub id: u16,\n    pub key: String,\n    pub def: std::sync::Arc<crate::room::RoomDef>,\n    /// Quarter turns (clockwise from above) the room was rotated by when placed.\n    pub quarters: u8,\n}\n\n/// A projectile as drawn (velocity lets the view interpolate).\n#[derive(Clone, Copy, Debug)]\npub struct ProjectileView {\n    pub pos: Vec3,\n    pub vel: Vec3,\n    pub radius: f32,\n    pub color: crate::color::Color,\n}\n\n/// Game state the HUD shows.\n#[derive(Clone, Debug, Default)]\npub struct HudFrame {\n    pub course: Option<crate::course::CourseHud>,\n    pub last_result: Option<crate::course::CourseResult>,\n    /// Short message and the tick it was posted.\n    pub message: Option<(String, u64)>,\n    pub feel: crate::feel::FeelReport,\n    /// Camera cue from pads / camera zones, and a counter that changes with it.\n    pub cue: Option<std::sync::Arc<crate::zones::CameraCue>>,\n    pub cue_serial: u64,\n    /// Player hit flash (seconds of invulnerability left).\n    pub invuln: f32,\n    pub model: String,\n    pub physics: PhysicsStats,\n    /// View settings from pads (applied on top of the room's), and a counter that changes.\n    pub view: std::collections::BTreeMap<String, crate::params::ParamValue>,\n    pub view_serial: u64,\n    /// Boss health bar: name and remaining fraction.\n    pub boss: Option<(String, f32)>,\n    /// The last pad with a note the player stepped on: label, note, tick.\n    pub pad_note: Option<(String, String, u64)>,\n    /// A `games` game's HUD lines (`Game::hud`).\n    pub lines: Vec<String>,\n}\n\n/// Physics counters for the stats overlay.\n#[derive(Clone, Copy, Debug, Default)]\npub struct PhysicsStats {\n    pub dynamic: usize,\n    pub sleeping: usize,\n    pub colliders: usize,\n    pub joints: usize,\n    pub soft_bodies: usize,\n    pub particles: usize,\n    pub contacts: usize,\n    pub projectiles: usize,\n}\n\n#[derive(Clone, Debug)]\npub struct RenderFrame {\n    pub tick: u64,\n    pub time: f64,\n    pub dt: f32,\n    /// Last accepted live edit included in this frame. View interpolation must not mix it\n    /// with an older revision before the application acknowledges drawing the ticket.\n    pub live_edit_ticket: u64,\n    pub objects: Vec<RenderObject>,\n    pub statics: StaticWorld,\n    /// Suggested camera focus (the player, or the scene centre).\n    pub focus: Vec3,\n    /// True when `focus` is a player character (enables cutaway/fade helpers).\n    pub focus_is_player: bool,\n    pub player: Option<EntityId>,\n    pub puppet_def: PuppetDef,\n    pub room: Option<RoomInfo>,\n    /// The simulation's configuration (shared; changes when rooms override parameters).\n    pub config: std::sync::Arc<crate::sim::SimConfig>,\n    pub events: Vec<SimEvent>,\n    pub projectiles: Vec<ProjectileView>,\n    pub hud: HudFrame,\n    /// Shardfall state for the view and HUD (None outside the game).\n    pub game: Option<std::sync::Arc<crate::arpg::GameFrame>>,\n    /// Agent-readable playback controls for the animation stage.\n    pub animation_preview: Option<crate::animation_preview::PreviewInfo>,\n    pub studio_mode: crate::prop_preview::StudioMode,\n    pub prop_preview: Option<crate::prop_preview::PropPreviewInfo>,\n    pub creature_preview: Option<crate::creature_preview::CreaturePreviewInfo>,\n    /// The generated native stage subject, separate from simulation entity geometry.\n    pub creature: Option<crate::creature_preview::CreatureFrame>,\n}\n","numLines":303,"startLine":1,"totalLines":303}},"tool_result_meta":[{"id":"toolu_018bGwA6dEdrgvrL5hoRrhWx","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjF9Z98fXBmRi7Rd5EL3","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017GS84hmD9jqGqPHK13LDzW","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953/engine/crates/pav_ui/src/headless.rs"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10666,"cache_read_input_tokens":54248,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10666},"output_tokens":21,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cb437ba7-0477-4143-bb04-ff33f49efd62","uuid":"21ca2d3f-723a-4fd9-b4a7-fcecb45884c3","timestamp":"2026-11-05T05:40:28.445Z","request_id":"req_011CgjF9Yp2qWnpJ3XWjZZBE","wire_tool_inputs":{"toolu_017GS84hmD9jqGqPHK13LDzW":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953/engine/crates/pav_ui/src/headless.rs"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017GS84hmD9jqGqPHK13LDzW","type":"tool_result","content":"1\t//! The game UI without a window (doctrine 2, 3): the tools draw the HUD, the open windows and\n2\t//! the touch controls with the same code the window runs, on a headless egui context. A frame\n3\t//! gives a reading of what is on screen (every text with where it is, grouped by window, and the\n4\t//! touch controls) and egui's output, which `Overlay` paints over a capture.\n5\t\n6\tuse egui::{Pos2, Rect, Shape};\n7\tuse glam::Mat4;\n8\tuse pav_core::arpg::{GameCmd, GameFrame};\n9\tuse pav_core::frame::HudFrame;\n10\tuse serde::Serialize;\n11\t\n12\tuse crate::Device;\n13\tuse crate::arpg_items::GameUi;\n14\tuse crate::arpg_ui::{Projector, hud};\n15\tuse crate::touch::{Touch, View};\n16\t\n17\t/// Passes per frame: windows size themselves from the pass before.\n18\tconst PASSES: usize = 3;\n19\t\n20\t/// The UI's state between frames: which windows are open, the device, the touch controls.\n21\t#[derive(Default)]\n22\tpub struct Headless {\n23\t    pub game: GameUi,\n24\t    pub touch: Touch,\n25\t    pub device: Device,\n26\t}\n27\t\n28\t/// What a frame drew.\n29\tpub struct Drawn {\n30\t    /// What `Overlay::paint` draws.\n31\t    pub paint: Paint,\n32\t    pub reading: Reading,\n33\t    /// What the player gave by clicking (`Input::click`).\n34\t    pub commands: Vec<GameCmd>,\n35\t}\n36\t\n37\t/// What is on screen, as text.\n38\t#[derive(Clone, Debug, Default, Serialize)]\n39\tpub struct Reading {\n40\t    pub screen: [f32; 2],\n41\t    pub device: &'static str,\n42\t    /// The windows the UI has open (`inventory`, `tree`, ...).\n43\t    pub open: Vec<&'static str>,\n44\t    /// Text outside any window: the HUD, loot labels, banners.\n45\t    pub hud: Vec<Text>,\n46\t    /// Each window or panel on screen: its title (its first line) and its text.\n47\t    pub windows: Vec<Window>,\n48\t    /// Touch: the controls a finger can press.\n49\t    #[serde(skip_serializing_if = \"Vec::is_empty\")]\n50\t    pub controls: Vec<Control>,\n51\t}\n52\t\n53\t#[derive(Clone, Debug, Serialize)]\n54\tpub struct Text {\n55\t    pub text: String,\n56\t    /// Top-left corner, in points (pixels: the tools draw at one point per pixel).\n57\t    pub at: [f32; 2],\n58\t}\n59\t\n60\t#[derive(Clone, Debug, Serialize)]\n61\tpub struct Window {\n62\t    pub title: String,\n63\t    /// `[x0, y0, x1, y1]`.\n64\t    pub rect: [f32; 4],\n65\t    pub text: Vec<Text>,\n66\t}\n67\t\n68\t#[derive(Clone, Debug, Serialize)]\n69\tpub struct Control {\n70\t    pub control: String,\n71\t    pub rect: [f32; 4],\n72\t}\n73\t\n74\t/// A frame's triangles and the textures they need.\n75\tpub struct Paint {\n76\t    pub primitives: Vec<egui::ClippedPrimitive>,\n77\t    pub textures: egui::TexturesDelta,\n78\t    pub pixels_per_point: f32,\n79\t}\n80\t\n81\timpl Drop for Paint {\n82\t    /// A reading that is never painted drops its textures unapplied (egui checks).\n83\t    fn drop(&mut self) {\n84\t        self.textures.clear();\n85\t    }\n86\t}\n87\t\n88\t/// Pointer input for a frame: hover (tooltips) or a click at a point.\n89\t#[derive(Clone, Copy, Debug, Default)]\n90\tpub struct Input {\n91\t    pub hover: Option<Pos2>,\n92\t    pub click: Option<Pos2>,\n93\t}\n94\t\n95\timpl Headless {\n96\t    /// The window names `open` accepts, and `GameUi`'s flag for each.\n97\t    pub const WINDOWS: [&'static str; 5] = [\"inventory\", \"character\", \"skills\", \"tree\", \"map\"];\n98\t\n99\t    fn flag(&mut self, name: &str) -> Option<&mut bool> {\n100\t        Some(match name {\n101\t            \"inventory\" => &mut self.game.inventory,\n102\t            \"character\" => &mut self.game.character,\n103\t            \"skills\" => &mut self.game.skills,\n104\t            \"tree\" => &mut self.game.tree.open,\n105\t            \"map\" => &mut self.game.map,\n106\t            _ => return None,\n107\t        })\n108\t    }\n109\t\n110\t    /// Opens or closes a window by name; false if there is no such window.\n111\t    pub fn set_open(&mut self, name: &str, open: bool) -> bool {\n112\t        self.flag(name).map(|f| *f = open).is_some()\n113\t    }\n114\t\n115\t    /// Draws one frame of the UI over a `width` x `height` view whose camera is `vp`: Shardfall's\n116\t    /// (`game`), or a `pav_core::games` game's HUD lines (`hud`).\n117\t    pub fn frame(\n118\t        &mut self,\n119\t        game: Option<&GameFrame>,\n120\t        hud_lines: &HudFrame,\n121\t        vp: Mat4,\n122\t        width: u32,\n123\t        height: u32,\n124\t        input: Input,\n125\t    ) -> Drawn {\n126\t        let ctx = egui::Context::default();\n127\t        let touch = self.device == Device::Touch;\n128\t        crate::touch_style(&ctx, touch);\n129\t        ctx.all_styles_mut(|s| {\n130\t            s.animation_time = 0.0;\n131\t            s.interaction.tooltip_delay = 0.0;\n132\t        });\n133\t        self.game.touch = touch;\n134\t        self.game.tree.touch = touch;\n135\t        self.game.pad = self.device == Device::Gamepad;\n136\t        self.game.tree.pad = self.game.pad;\n137\t        let screen = Rect::from_min_size(Pos2::ZERO, egui::vec2(width as f32, height as f32));\n138\t        let mut textures = egui::TexturesDelta::default();\n139\t        let mut commands = Vec::new();\n140\t        let mut output = None;\n141\t        let mut layers = Vec::new();\n142\t        for pass in 0..PASSES + input.click.is_some() as usize {\n143\t            let mut events = Vec::new();\n144\t            if let Some(p) = input.click.or(input.hover) {\n145\t                events.push(egui::Event::PointerMoved(p));\n146\t            }\n147\t            // The click lands in the last pass, once the windows are laid out.\n148\t            if let Some(p) = input.click.filter(|_| pass == PASSES) {\n149\t                for pressed in [true, false] {\n150\t                    events.push(egui::Event::PointerButton {\n151\t                        pos: p,\n152\t                        button: egui::PointerButton::Primary,\n153\t                        pressed,\n154\t                        modifiers: Default::default(),\n155\t                    });\n156\t                }\n157\t            }\n158\t            let raw = egui::RawInput {\n159\t                screen_rect: Some(screen),\n160\t                time: Some(pass as f64 / 60.0),\n161\t                predicted_dt: 1.0 / 60.0,\n162\t                events,\n163\t                ..Default::default()\n164\t            };\n165\t            self.touch.swipes.begin_frame();\n166\t            let last = pass + 1 == PASSES + input.click.is_some() as usize;\n167\t            let out = ctx.run_ui(raw, |ui| {\n168\t                let root = ui.layer_id();\n169\t                let ctx = ui.ctx().clone();\n170\t                if let Some(g) = game {\n171\t                    let proj = Projector { vp, size: screen.size() };\n172\t                    hud(&ctx, g, &proj, self.device, self.game.map, &mut self.touch.swipes);\n173\t                    let given = self.game.ui(&ctx, g, &proj);\n174\t                    if pass == PASSES {\n175\t                        commands = given;\n176\t                    }\n177\t                }\n178\t                crate::game_lines(&ctx, hud_lines);\n179\t                if touch && game.is_some() {\n180\t                    let map_hidden = self.touch.swipes.is_gone(egui::Id::new(\"minimap\"), 0);\n181\t                    let points = game.and_then(|g| g.inv.as_ref()).map(|i| i.points).unwrap_or(0);\n182\t                    let covered = self.game.any_open();\n183\t                    self.touch.draw(&ctx, &View { game, auto_attack: true, map_hidden, points, covered });\n184\t                }\n185\t                if last {\n186\t                    layers = window_layers(&ctx, root, screen);\n187\t                }\n188\t            });\n189\t            let mut out = out;\n190\t            textures.append(std::mem::take(&mut out.textures_delta));\n191\t            output = Some(out);\n192\t        }\n193\t        let output = output.unwrap();\n194\t        let reading = self.read(&output, screen, layers);\n195\t        let pixels_per_point = output.pixels_per_point;\n196\t        let primitives = ctx.tessellate(output.shapes, pixels_per_point);\n197\t        Drawn { paint: Paint { primitives, textures, pixels_per_point }, reading, commands }\n198\t    }\n199\t\n200\t    /// What `out` shows: the windows' text (`layers`, from `window_layers`), and the rest as HUD.\n201\t    fn read(&self, out: &egui::FullOutput, screen: Rect, layers: Vec<(Rect, Vec<(Rect, String)>)>) -> Reading {\n202\t        let mut all = Vec::new();\n203\t        for clipped in &out.shapes {\n204\t            collect(&clipped.shape, clipped.clip_rect.intersect(screen), &mut all);\n205\t        }\n206\t        let in_window = |t: &(Rect, String)| layers.iter().any(|(_, texts)| texts.contains(t));\n207\t        let mut hud: Vec<Text> = dedupe(all.into_iter().filter(|t| !in_window(t)).collect());\n208\t        let mut windows: Vec<(Rect, Vec<Text>)> =\n209\t            layers.iter().map(|(r, texts)| (*r, dedupe(texts.clone()))).filter(|(_, t)| !t.is_empty()).collect();\n210\t        // Top to bottom, then left to right (egui keeps no public stacking order).\n211\t        windows.sort_by(|a, b| a.0.min.y.total_cmp(&b.0.min.y).then(a.0.min.x.total_cmp(&b.0.min.x)));\n212\t        let windows = windows\n213\t            .into_iter()\n214\t            .map(|(r, mut text)| {\n215\t                sort(&mut text);\n216\t                let title = text.first().map(|t| t.text.clone()).unwrap_or_default();\n217\t                Window { title, rect: rect4(r), text }\n218\t            })\n219\t            .collect();\n220\t        sort(&mut hud);\n221\t        let controls = if self.device == Device::Touch {\n222\t            self.touch.placed().iter().map(|p| Control { control: format!(\"{:?}\", p.control), rect: rect4(p.rect) }).collect()\n223\t        } else {\n224\t            Vec::new()\n225\t        };\n226\t        Reading {\n227\t            screen: [screen.width(), screen.height()],\n228\t            device: match self.device {\n229\t                Device::KeyboardMouse => \"mouse\",\n230\t                Device::Gamepad => \"pad\",\n231\t                Device::Touch => \"touch\",\n232\t            },\n233\t            open: Self::WINDOWS.into_iter().filter(|w| self.is_open(w)).collect(),\n234\t            hud,\n235\t            windows,\n236\t            controls,\n237\t        }\n238\t    }\n239\t\n240\t    fn is_open(&self, name: &str) -> bool {\n241\t        match name {\n242\t            \"inventory\" => self.game.inventory,\n243\t            \"character\" => self.game.character,\n244\t            \"skills\" => self.game.skills,\n245\t            \"tree\" => self.game.tree.open,\n246\t            \"map\" => self.game.map,\n247\t            _ => false,\n248\t        }\n249\t    }\n250\t}\n251\t\n252\t/// Each window (an egui area other than the screen-wide `root`) on screen this pass: its rect\n253\t/// and the text on its layer. Read before the pass ends, while egui still holds shapes by layer.\n254\tfn window_layers(ctx: &egui::Context, root: egui::LayerId, screen: Rect) -> Vec<(Rect, Vec<(Rect, String)>)> {\n255\t    let areas: Vec<(egui::LayerId, Rect)> = ctx.memory(|m| {\n256\t        let mut ids: Vec<egui::LayerId> = m.areas().visible_layer_ids().into_iter().filter(|l| *l != root).collect();\n257\t        ids.sort_by_key(|l| (l.order, l.id.value()));\n258\t        ids.into_iter().filter_map(|l| m.area_rect(l.id).map(|r| (l, r))).collect()\n259\t    });\n260\t    areas\n261\t        .into_iter()\n262\t        .map(|(layer, rect)| {\n263\t            let mut texts = Vec::new();\n264\t            ctx.graphics(|g| {\n265\t                for clipped in g.get(layer).map(|list| list.all_entries().collect::<Vec<_>>()).unwrap_or_default() {\n266\t                    collect(&clipped.shape, clipped.clip_rect.intersect(screen), &mut texts);\n267\t                }\n268\t            });\n269\t            (rect, texts)\n270\t        })\n271\t        .collect()\n272\t}\n273\t\n274\t/// Texts with where they are; a drop shadow (the same text a point or two off) is kept once.\n275\tfn dedupe(texts: Vec<(Rect, String)>) -> Vec<Text> {\n276\t    let mut kept: Vec<(Rect, String)> = Vec::new();\n277\t    for (rect, text) in texts {\n278\t        if !kept.iter().any(|(r, t)| *t == text && r.min.distance(rect.min) < 3.0) {\n279\t            kept.push((rect, text));\n280\t        }\n281\t    }\n282\t    kept.into_iter().map(|(r, text)| Text { text, at: [r.min.x.round(), r.min.y.round()] }).collect()\n283\t}\n284\t\n285\t/// Every visible text in `shape` with its bounds.\n286\tfn collect(shape: &Shape, clip: Rect, out: &mut Vec<(Rect, String)>) {\n287\t    match shape {\n288\t        Shape::Vec(shapes) => {\n289\t            for s in shapes {\n290\t                collect(s, clip, out);\n291\t            }\n292\t        }\n293\t        Shape::Text(t) => {\n294\t            let rect = t.visual_bounding_rect();\n295\t            let text = t.galley.text().trim();\n296\t            if !text.is_empty() && t.opacity_factor > 0.0 && clip.intersects(rect) {\n297\t                out.push((rect, text.to_string()));\n298\t            }\n299\t        }\n300\t        _ => {}\n301\t    }\n302\t}\n303\t\n304\t/// Reading order: rows top to bottom (within 4 points is one row), then left to right.\n305\tfn sort(texts: &mut [Text]) {\n306\t    texts.sort_by(|a, b| {\n307\t        let row = |t: &Text| (t.at[1] / 4.0).round();\n308\t        row(a).total_cmp(&row(b)).then(a.at[0].total_cmp(&b.at[0]))\n309\t    });\n310\t}\n311\t\n312\tfn rect4(r: Rect) -> [f32; 4] {\n313\t    [r.min.x.round(), r.min.y.round(), r.max.x.round(), r.max.y.round()]\n314\t}\n315\t\n316\t/// Paints egui output over a texture (a capture), on one device.\n317\tpub struct Overlay {\n318\t    renderer: egui_wgpu::Renderer,\n319\t    format: wgpu::TextureFormat,\n320\t}\n321\t\n322\timpl Overlay {\n323\t    pub fn new(device: &wgpu::Device, format: wgpu::TextureFormat) -> Self {\n324\t        Self { renderer: egui_wgpu::Renderer::new(device, format, egui_wgpu::RendererOptions::default()), format }\n325\t    }\n326\t\n327\t    pub fn format(&self) -> wgpu::TextureFormat {\n328\t        self.format\n329\t    }\n330\t\n331\t    /// Records the UI's draw over `view` (loaded, not cleared) into `encoder`. Its textures\n332\t    /// are uploaded now and freed after.\n333\t    pub fn paint(\n334\t        &mut self,\n335\t        device: &wgpu::Device,\n336\t        queue: &wgpu::Queue,\n337\t        encoder: &mut wgpu::CommandEncoder,\n338\t        view: &wgpu::TextureView,\n339\t        size: (u32, u32),\n340\t        paint: &Paint,\n341\t    ) {\n342\t        let prims = &paint.primitives;\n343\t        for (id, delta) in &paint.textures.set {\n344\t            for d in delta {\n345\t                self.renderer.update_texture(device, queue, *id, d);\n346\t            }\n347\t        }\n348\t        let sd = egui_wgpu::ScreenDescriptor { size_in_pixels: [size.0, size.1], pixels_per_point: paint.pixels_per_point };\n349\t        let cmds = self.renderer.update_buffers(device, queue, encoder, prims, &sd);\n350\t        queue.submit(cmds);\n351\t        let pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {\n352\t            label: Some(\"ui overlay\"),\n353\t            color_attachments: &[Some(wgpu::RenderPassColorAttachment {\n354\t                view,\n355\t                depth_slice: None,\n356\t                resolve_target: None,\n357\t                ops: wgpu::Operations { load: wgpu::LoadOp::Load, store: wgpu::StoreOp::Store },\n358\t            })],\n359\t            depth_stencil_attachment: None,\n360\t            timestamp_writes: None,\n361\t            occlusion_query_set: None,\n362\t            multiview_mask: None,\n363\t        });\n364\t        self.renderer.render(&mut pass.forget_lifetime(), prims, &sd);\n365\t        for id in &paint.textures.free {\n366\t            self.renderer.free_texture(id);\n367\t        }\n368\t    }\n369\t}\n370\t"}]},"parent_tool_use_id":null,"session_id":"cb437ba7-0477-4143-bb04-ff33f49efd62","uuid":"9414e34d-78d4-40b7-8780-98e12034cf66","timestamp":"2026-11-05T05:40:28.461Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953/engine/crates/pav_ui/src/headless.rs","content":"//! The game UI without a window (doctrine 2, 3): the tools draw the HUD, the open windows and\n//! the touch controls with the same code the window runs, on a headless egui context. A frame\n//! gives a reading of what is on screen (every text with where it is, grouped by window, and the\n//! touch controls) and egui's output, which `Overlay` paints over a capture.\n\nuse egui::{Pos2, Rect, Shape};\nuse glam::Mat4;\nuse pav_core::arpg::{GameCmd, GameFrame};\nuse pav_core::frame::HudFrame;\nuse serde::Serialize;\n\nuse crate::Device;\nuse crate::arpg_items::GameUi;\nuse crate::arpg_ui::{Projector, hud};\nuse crate::touch::{Touch, View};\n\n/// Passes per frame: windows size themselves from the pass before.\nconst PASSES: usize = 3;\n\n/// The UI's state between frames: which windows are open, the device, the touch controls.\n#[derive(Default)]\npub struct Headless {\n    pub game: GameUi,\n    pub touch: Touch,\n    pub device: Device,\n}\n\n/// What a frame drew.\npub struct Drawn {\n    /// What `Overlay::paint` draws.\n    pub paint: Paint,\n    pub reading: Reading,\n    /// What the player gave by clicking (`Input::click`).\n    pub commands: Vec<GameCmd>,\n}\n\n/// What is on screen, as text.\n#[derive(Clone, Debug, Default, Serialize)]\npub struct Reading {\n    pub screen: [f32; 2],\n    pub device: &'static str,\n    /// The windows the UI has open (`inventory`, `tree`, ...).\n    pub open: Vec<&'static str>,\n    /// Text outside any window: the HUD, loot labels, banners.\n    pub hud: Vec<Text>,\n    /// Each window or panel on screen: its title (its first line) and its text.\n    pub windows: Vec<Window>,\n    /// Touch: the controls a finger can press.\n    #[serde(skip_serializing_if = \"Vec::is_empty\")]\n    pub controls: Vec<Control>,\n}\n\n#[derive(Clone, Debug, Serialize)]\npub struct Text {\n    pub text: String,\n    /// Top-left corner, in points (pixels: the tools draw at one point per pixel).\n    pub at: [f32; 2],\n}\n\n#[derive(Clone, Debug, Serialize)]\npub struct Window {\n    pub title: String,\n    /// `[x0, y0, x1, y1]`.\n    pub rect: [f32; 4],\n    pub text: Vec<Text>,\n}\n\n#[derive(Clone, Debug, Serialize)]\npub struct Control {\n    pub control: String,\n    pub rect: [f32; 4],\n}\n\n/// A frame's triangles and the textures they need.\npub struct Paint {\n    pub primitives: Vec<egui::ClippedPrimitive>,\n    pub textures: egui::TexturesDelta,\n    pub pixels_per_point: f32,\n}\n\nimpl Drop for Paint {\n    /// A reading that is never painted drops its textures unapplied (egui checks).\n    fn drop(&mut self) {\n        self.textures.clear();\n    }\n}\n\n/// Pointer input for a frame: hover (tooltips) or a click at a point.\n#[derive(Clone, Copy, Debug, Default)]\npub struct Input {\n    pub hover: Option<Pos2>,\n    pub click: Option<Pos2>,\n}\n\nimpl Headless {\n    /// The window names `open` accepts, and `GameUi`'s flag for each.\n    pub const WINDOWS: [&'static str; 5] = [\"inventory\", \"character\", \"skills\", \"tree\", \"map\"];\n\n    fn flag(&mut self, name: &str) -> Option<&mut bool> {\n        Some(match name {\n            \"inventory\" => &mut self.game.inventory,\n            \"character\" => &mut self.game.character,\n            \"skills\" => &mut self.game.skills,\n            \"tree\" => &mut self.game.tree.open,\n            \"map\" => &mut self.game.map,\n            _ => return None,\n        })\n    }\n\n    /// Opens or closes a window by name; false if there is no such window.\n    pub fn set_open(&mut self, name: &str, open: bool) -> bool {\n        self.flag(name).map(|f| *f = open).is_some()\n    }\n\n    /// Draws one frame of the UI over a `width` x `height` view whose camera is `vp`: Shardfall's\n    /// (`game`), or a `pav_core::games` game's HUD lines (`hud`).\n    pub fn frame(\n        &mut self,\n        game: Option<&GameFrame>,\n        hud_lines: &HudFrame,\n        vp: Mat4,\n        width: u32,\n        height: u32,\n        input: Input,\n    ) -> Drawn {\n        let ctx = egui::Context::default();\n        let touch = self.device == Device::Touch;\n        crate::touch_style(&ctx, touch);\n        ctx.all_styles_mut(|s| {\n            s.animation_time = 0.0;\n            s.interaction.tooltip_delay = 0.0;\n        });\n        self.game.touch = touch;\n        self.game.tree.touch = touch;\n        self.game.pad = self.device == Device::Gamepad;\n        self.game.tree.pad = self.game.pad;\n        let screen = Rect::from_min_size(Pos2::ZERO, egui::vec2(width as f32, height as f32));\n        let mut textures = egui::TexturesDelta::default();\n        let mut commands = Vec::new();\n        let mut output = None;\n        let mut layers = Vec::new();\n        for pass in 0..PASSES + input.click.is_some() as usize {\n            let mut events = Vec::new();\n            if let Some(p) = input.click.or(input.hover) {\n                events.push(egui::Event::PointerMoved(p));\n            }\n            // The click lands in the last pass, once the windows are laid out.\n            if let Some(p) = input.click.filter(|_| pass == PASSES) {\n                for pressed in [true, false] {\n                    events.push(egui::Event::PointerButton {\n                        pos: p,\n                        button: egui::PointerButton::Primary,\n                        pressed,\n                        modifiers: Default::default(),\n                    });\n                }\n            }\n            let raw = egui::RawInput {\n                screen_rect: Some(screen),\n                time: Some(pass as f64 / 60.0),\n                predicted_dt: 1.0 / 60.0,\n                events,\n                ..Default::default()\n            };\n            self.touch.swipes.begin_frame();\n            let last = pass + 1 == PASSES + input.click.is_some() as usize;\n            let out = ctx.run_ui(raw, |ui| {\n                let root = ui.layer_id();\n                let ctx = ui.ctx().clone();\n                if let Some(g) = game {\n                    let proj = Projector { vp, size: screen.size() };\n                    hud(&ctx, g, &proj, self.device, self.game.map, &mut self.touch.swipes);\n                    let given = self.game.ui(&ctx, g, &proj);\n                    if pass == PASSES {\n                        commands = given;\n                    }\n                }\n                crate::game_lines(&ctx, hud_lines);\n                if touch && game.is_some() {\n                    let map_hidden = self.touch.swipes.is_gone(egui::Id::new(\"minimap\"), 0);\n                    let points = game.and_then(|g| g.inv.as_ref()).map(|i| i.points).unwrap_or(0);\n                    let covered = self.game.any_open();\n                    self.touch.draw(&ctx, &View { game, auto_attack: true, map_hidden, points, covered });\n                }\n                if last {\n                    layers = window_layers(&ctx, root, screen);\n                }\n            });\n            let mut out = out;\n            textures.append(std::mem::take(&mut out.textures_delta));\n            output = Some(out);\n        }\n        let output = output.unwrap();\n        let reading = self.read(&output, screen, layers);\n        let pixels_per_point = output.pixels_per_point;\n        let primitives = ctx.tessellate(output.shapes, pixels_per_point);\n        Drawn { paint: Paint { primitives, textures, pixels_per_point }, reading, commands }\n    }\n\n    /// What `out` shows: the windows' text (`layers`, from `window_layers`), and the rest as HUD.\n    fn read(&self, out: &egui::FullOutput, screen: Rect, layers: Vec<(Rect, Vec<(Rect, String)>)>) -> Reading {\n        let mut all = Vec::new();\n        for clipped in &out.shapes {\n            collect(&clipped.shape, clipped.clip_rect.intersect(screen), &mut all);\n        }\n        let in_window = |t: &(Rect, String)| layers.iter().any(|(_, texts)| texts.contains(t));\n        let mut hud: Vec<Text> = dedupe(all.into_iter().filter(|t| !in_window(t)).collect());\n        let mut windows: Vec<(Rect, Vec<Text>)> =\n            layers.iter().map(|(r, texts)| (*r, dedupe(texts.clone()))).filter(|(_, t)| !t.is_empty()).collect();\n        // Top to bottom, then left to right (egui keeps no public stacking order).\n        windows.sort_by(|a, b| a.0.min.y.total_cmp(&b.0.min.y).then(a.0.min.x.total_cmp(&b.0.min.x)));\n        let windows = windows\n            .into_iter()\n            .map(|(r, mut text)| {\n                sort(&mut text);\n                let title = text.first().map(|t| t.text.clone()).unwrap_or_default();\n                Window { title, rect: rect4(r), text }\n            })\n            .collect();\n        sort(&mut hud);\n        let controls = if self.device == Device::Touch {\n            self.touch.placed().iter().map(|p| Control { control: format!(\"{:?}\", p.control), rect: rect4(p.rect) }).collect()\n        } else {\n            Vec::new()\n        };\n        Reading {\n            screen: [screen.width(), screen.height()],\n            device: match self.device {\n                Device::KeyboardMouse => \"mouse\",\n                Device::Gamepad => \"pad\",\n                Device::Touch => \"touch\",\n            },\n            open: Self::WINDOWS.into_iter().filter(|w| self.is_open(w)).collect(),\n            hud,\n            windows,\n            controls,\n        }\n    }\n\n    fn is_open(&self, name: &str) -> bool {\n        match name {\n            \"inventory\" => self.game.inventory,\n            \"character\" => self.game.character,\n            \"skills\" => self.game.skills,\n            \"tree\" => self.game.tree.open,\n            \"map\" => self.game.map,\n            _ => false,\n        }\n    }\n}\n\n/// Each window (an egui area other than the screen-wide `root`) on screen this pass: its rect\n/// and the text on its layer. Read before the pass ends, while egui still holds shapes by layer.\nfn window_layers(ctx: &egui::Context, root: egui::LayerId, screen: Rect) -> Vec<(Rect, Vec<(Rect, String)>)> {\n    let areas: Vec<(egui::LayerId, Rect)> = ctx.memory(|m| {\n        let mut ids: Vec<egui::LayerId> = m.areas().visible_layer_ids().into_iter().filter(|l| *l != root).collect();\n        ids.sort_by_key(|l| (l.order, l.id.value()));\n        ids.into_iter().filter_map(|l| m.area_rect(l.id).map(|r| (l, r))).collect()\n    });\n    areas\n        .into_iter()\n        .map(|(layer, rect)| {\n            let mut texts = Vec::new();\n            ctx.graphics(|g| {\n                for clipped in g.get(layer).map(|list| list.all_entries().collect::<Vec<_>>()).unwrap_or_default() {\n                    collect(&clipped.shape, clipped.clip_rect.intersect(screen), &mut texts);\n                }\n            });\n            (rect, texts)\n        })\n        .collect()\n}\n\n/// Texts with where they are; a drop shadow (the same text a point or two off) is kept once.\nfn dedupe(texts: Vec<(Rect, String)>) -> Vec<Text> {\n    let mut kept: Vec<(Rect, String)> = Vec::new();\n    for (rect, text) in texts {\n        if !kept.iter().any(|(r, t)| *t == text && r.min.distance(rect.min) < 3.0) {\n            kept.push((rect, text));\n        }\n    }\n    kept.into_iter().map(|(r, text)| Text { text, at: [r.min.x.round(), r.min.y.round()] }).collect()\n}\n\n/// Every visible text in `shape` with its bounds.\nfn collect(shape: &Shape, clip: Rect, out: &mut Vec<(Rect, String)>) {\n    match shape {\n        Shape::Vec(shapes) => {\n            for s in shapes {\n                collect(s, clip, out);\n            }\n        }\n        Shape::Text(t) => {\n            let rect = t.visual_bounding_rect();\n            let text = t.galley.text().trim();\n            if !text.is_empty() && t.opacity_factor > 0.0 && clip.intersects(rect) {\n                out.push((rect, text.to_string()));\n            }\n        }\n        _ => {}\n    }\n}\n\n/// Reading order: rows top to bottom (within 4 points is one row), then left to right.\nfn sort(texts: &mut [Text]) {\n    texts.sort_by(|a, b| {\n        let row = |t: &Text| (t.at[1] / 4.0).round();\n        row(a).total_cmp(&row(b)).then(a.at[0].total_cmp(&b.at[0]))\n    });\n}\n\nfn rect4(r: Rect) -> [f32; 4] {\n    [r.min.x.round(), r.min.y.round(), r.max.x.round(), r.max.y.round()]\n}\n\n/// Paints egui output over a texture (a capture), on one device.\npub struct Overlay {\n    renderer: egui_wgpu::Renderer,\n    format: wgpu::TextureFormat,\n}\n\nimpl Overlay {\n    pub fn new(device: &wgpu::Device, format: wgpu::TextureFormat) -> Self {\n        Self { renderer: egui_wgpu::Renderer::new(device, format, egui_wgpu::RendererOptions::default()), format }\n    }\n\n    pub fn format(&self) -> wgpu::TextureFormat {\n        self.format\n    }\n\n    /// Records the UI's draw over `view` (loaded, not cleared) into `encoder`. Its textures\n    /// are uploaded now and freed after.\n    pub fn paint(\n        &mut self,\n        device: &wgpu::Device,\n        queue: &wgpu::Queue,\n        encoder: &mut wgpu::CommandEncoder,\n        view: &wgpu::TextureView,\n        size: (u32, u32),\n        paint: &Paint,\n    ) {\n        let prims = &paint.primitives;\n        for (id, delta) in &paint.textures.set {\n            for d in delta {\n                self.renderer.update_texture(device, queue, *id, d);\n            }\n        }\n        let sd = egui_wgpu::ScreenDescriptor { size_in_pixels: [size.0, size.1], pixels_per_point: paint.pixels_per_point };\n        let cmds = self.renderer.update_buffers(device, queue, encoder, prims, &sd);\n        queue.submit(cmds);\n        let pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {\n            label: Some(\"ui overlay\"),\n            color_attachments: &[Some(wgpu::RenderPassColorAttachment {\n                view,\n                depth_slice: None,\n                resolve_target: None,\n                ops: wgpu::Operations { load: wgpu::LoadOp::Load, store: wgpu::StoreOp::Store },\n            })],\n            depth_stencil_attachment: None,\n            timestamp_writes: None,\n            occlusion_query_set: None,\n            multiview_mask: None,\n        });\n        self.renderer.render(&mut pass.forget_lifetime(), prims, &sd);\n        for id in &paint.textures.free {\n            self.renderer.free_texture(id);\n        }\n    }\n}\n","numLines":370,"startLine":1,"totalLines":370}},"tool_result_meta":[{"id":"toolu_017GS84hmD9jqGqPHK13LDzW","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjF9Z98fXBmRi7Rd5EL3","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01TwatKMBTGChSv4P3CYW5Nr","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953/engine/crates/pav_ui/src/lib.rs"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10666,"cache_read_input_tokens":54248,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10666},"output_tokens":21,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cb437ba7-0477-4143-bb04-ff33f49efd62","uuid":"1924317a-2cb8-49a8-807f-a62bdab6d572","timestamp":"2026-11-05T05:40:29.690Z","request_id":"req_011CgjF9Yp2qWnpJ3XWjZZBE","wire_tool_inputs":{"toolu_01TwatKMBTGChSv4P3CYW5Nr":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953/engine/crates/pav_ui/src/lib.rs"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TwatKMBTGChSv4P3CYW5Nr","type":"tool_result","content":"1\t//! Shardfall's game UI, drawn with egui: the HUD (`arpg_ui`), the inventory, shop, stash and\n2\t//! character windows (`arpg_items`), the passive tree (`arpg_tree`) and the touch controls\n3\t//! (`touch`). The window (`pav_app`) draws it over the game; the tools draw the same code on a\n4\t//! headless context (`headless`): a text reading of what is on screen, and the UI over captures.\n5\t\n6\tpub mod arpg_items;\n7\tpub mod arpg_tree;\n8\tpub mod arpg_ui;\n9\tpub mod headless;\n10\tpub mod touch;\n11\t\n12\t/// The input device the player is on: hints and the HUD follow it.\n13\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n14\tpub enum Device {\n15\t    #[default]\n16\t    KeyboardMouse,\n17\t    Gamepad,\n18\t    /// A phone or tablet (touch.rs).\n19\t    Touch,\n20\t}\n21\t\n22\t/// Touch screens: bigger targets, a little bigger text, thicker scroll bars, and dragging\n23\t/// scrolls. `on = false` puts the desktop sizes back.\n24\tpub fn touch_style(ctx: &egui::Context, on: bool) {\n25\t    use egui::{FontId, TextStyle};\n26\t    ctx.all_styles_mut(|s| {\n27\t        s.spacing = egui::style::Spacing::default();\n28\t        s.text_styles = egui::style::default_text_styles();\n29\t        if on {\n30\t            let sp = &mut s.spacing;\n31\t            sp.interact_size = egui::vec2(44.0, 34.0);\n32\t            sp.button_padding = egui::vec2(12.0, 7.0);\n33\t            sp.item_spacing = egui::vec2(10.0, 8.0);\n34\t            sp.slider_width = 170.0;\n35\t            sp.icon_width = 20.0;\n36\t            sp.icon_width_inner = 12.0;\n37\t            sp.combo_height = 320.0;\n38\t            sp.scroll = egui::style::ScrollStyle::solid();\n39\t            sp.scroll.bar_width = 8.0;\n40\t            for (style, size) in\n41\t                [(TextStyle::Body, 15.0), (TextStyle::Button, 15.0), (TextStyle::Small, 12.0), (TextStyle::Heading, 20.0)]\n42\t            {\n43\t                s.text_styles.insert(style, FontId::proportional(size));\n44\t            }\n45\t            s.interaction.tooltip_delay = 0.35;\n46\t        }\n47\t    });\n48\t}\n49\t\n50\t/// A `pav_core::games` game's HUD lines (`Game::hud`), top left.\n51\tpub fn game_lines(ctx: &egui::Context, h: &pav_core::frame::HudFrame) {\n52\t    if h.lines.is_empty() {\n53\t        return;\n54\t    }\n55\t    egui::Area::new(egui::Id::new(\"game_lines\")).anchor(egui::Align2::LEFT_TOP, [16.0, 60.0]).show(ctx, |ui| {\n56\t        egui::Frame::popup(ui.style()).show(ui, |ui| {\n57\t            for line in &h.lines {\n58\t                ui.label(egui::RichText::new(line).monospace().size(18.0).strong());\n59\t            }\n60\t        });\n61\t    });\n62\t}\n63\t"}]},"parent_tool_use_id":null,"session_id":"cb437ba7-0477-4143-bb04-ff33f49efd62","uuid":"bc0d9c78-8a63-45c8-8498-47ed8e48cfcd","timestamp":"2026-11-05T05:40:29.707Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953/engine/crates/pav_ui/src/lib.rs","content":"//! Shardfall's game UI, drawn with egui: the HUD (`arpg_ui`), the inventory, shop, stash and\n//! character windows (`arpg_items`), the passive tree (`arpg_tree`) and the touch controls\n//! (`touch`). The window (`pav_app`) draws it over the game; the tools draw the same code on a\n//! headless context (`headless`): a text reading of what is on screen, and the UI over captures.\n\npub mod arpg_items;\npub mod arpg_tree;\npub mod arpg_ui;\npub mod headless;\npub mod touch;\n\n/// The input device the player is on: hints and the HUD follow it.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\npub enum Device {\n    #[default]\n    KeyboardMouse,\n    Gamepad,\n    /// A phone or tablet (touch.rs).\n    Touch,\n}\n\n/// Touch screens: bigger targets, a little bigger text, thicker scroll bars, and dragging\n/// scrolls. `on = false` puts the desktop sizes back.\npub fn touch_style(ctx: &egui::Context, on: bool) {\n    use egui::{FontId, TextStyle};\n    ctx.all_styles_mut(|s| {\n        s.spacing = egui::style::Spacing::default();\n        s.text_styles = egui::style::default_text_styles();\n        if on {\n            let sp = &mut s.spacing;\n            sp.interact_size = egui::vec2(44.0, 34.0);\n            sp.button_padding = egui::vec2(12.0, 7.0);\n            sp.item_spacing = egui::vec2(10.0, 8.0);\n            sp.slider_width = 170.0;\n            sp.icon_width = 20.0;\n            sp.icon_width_inner = 12.0;\n            sp.combo_height = 320.0;\n            sp.scroll = egui::style::ScrollStyle::solid();\n            sp.scroll.bar_width = 8.0;\n            for (style, size) in\n                [(TextStyle::Body, 15.0), (TextStyle::Button, 15.0), (TextStyle::Small, 12.0), (TextStyle::Heading, 20.0)]\n            {\n                s.text_styles.insert(style, FontId::proportional(size));\n            }\n            s.interaction.tooltip_delay = 0.35;\n        }\n    });\n}\n\n/// A `pav_core::games` game's HUD lines (`Game::hud`), top left.\npub fn game_lines(ctx: &egui::Context, h: &pav_core::frame::HudFrame) {\n    if h.lines.is_empty() {\n        return;\n    }\n    egui::Area::new(egui::Id::new(\"game_lines\")).anchor(egui::Align2::LEFT_TOP, [16.0, 60.0]).show(ctx, |ui| {\n        egui::Frame::popup(ui.style()).show(ui, |ui| {\n            for line in &h.lines {\n                ui.label(egui::RichText::new(line).monospace().size(18.0).strong());\n            }\n        });\n    });\n}\n","numLines":63,"startLine":1,"totalLines":63}},"tool_result_meta":[{"id":"toolu_01TwatKMBTGChSv4P3CYW5Nr","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjF9Z98fXBmRi7Rd5EL3","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01CBeSA3QiStZmTYgmFmEpwK","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953/engine/crates/pav_app/src/input.rs"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10666,"cache_read_input_tokens":54248,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10666},"output_tokens":21,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cb437ba7-0477-4143-bb04-ff33f49efd62","uuid":"3933bc82-9075-42af-b662-0ed27d553e15","timestamp":"2026-11-05T05:40:30.988Z","request_id":"req_011CgjF9Yp2qWnpJ3XWjZZBE","wire_tool_inputs":{"toolu_01CBeSA3QiStZmTYgmFmEpwK":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953/engine/crates/pav_app/src/input.rs"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CBeSA3QiStZmTYgmFmEpwK","type":"tool_result","content":"1\t//! Devices -> actions. Keyboard keys are bound by physical position (WASD stays WASD on AZERTY).\n2\t//! The fixed system layer (pause, rewind, menus) is handled in `app.rs` and never rebinds.\n3\t\n4\tuse std::collections::HashSet;\n5\t\n6\tuse glam::Vec2;\n7\tuse pav_core::input::buttons;\n8\tuse winit::event::{ElementState, MouseButton};\n9\tuse winit::keyboard::KeyCode;\n10\t\n11\tpub use pav_ui::Device;\n12\t\n13\t/// Game-action bindings (defaults; rooms may override in the future).\n14\tpub struct KeyBinds {\n15\t    pub up: &'static [KeyCode],\n16\t    pub down: &'static [KeyCode],\n17\t    pub left: &'static [KeyCode],\n18\t    pub right: &'static [KeyCode],\n19\t    pub buttons: &'static [(u32, &'static [KeyCode])],\n20\t}\n21\t\n22\tpub const KEYS: KeyBinds = KeyBinds {\n23\t    up: &[KeyCode::KeyW, KeyCode::ArrowUp],\n24\t    down: &[KeyCode::KeyS, KeyCode::ArrowDown],\n25\t    left: &[KeyCode::KeyA, KeyCode::ArrowLeft],\n26\t    right: &[KeyCode::KeyD, KeyCode::ArrowRight],\n27\t    buttons: &[\n28\t        (buttons::JUMP, &[KeyCode::Space]),\n29\t        (buttons::CROUCH, &[KeyCode::KeyC, KeyCode::ControlLeft]),\n30\t        (buttons::CRAWL, &[KeyCode::KeyZ]),\n31\t        (buttons::USE, &[KeyCode::KeyF]),\n32\t        (buttons::FOCUS, &[KeyCode::ShiftLeft]),\n33\t        (buttons::INTERACT, &[KeyCode::KeyE]),\n34\t    ],\n35\t};\n36\t\n37\t/// Physical key names usable in room files (`[keys]`).\n38\tpub fn key_from_name(n: &str) -> Option<KeyCode> {\n39\t    use KeyCode::*;\n40\t    let letters = [\n41\t        KeyA, KeyB, KeyC, KeyD, KeyE, KeyF, KeyG, KeyH, KeyI, KeyJ, KeyK, KeyL, KeyM, KeyN, KeyO, KeyP, KeyQ, KeyR, KeyS, KeyT,\n42\t        KeyU, KeyV, KeyW, KeyX, KeyY, KeyZ,\n43\t    ];\n44\t    if let Some(c) = n.strip_prefix(\"Key\").and_then(|l| l.chars().next()).filter(|c| c.is_ascii_uppercase() && n.len() == 4) {\n45\t        return Some(letters[(c as u8 - b'A') as usize]);\n46\t    }\n47\t    let digits = [Digit0, Digit1, Digit2, Digit3, Digit4, Digit5, Digit6, Digit7, Digit8, Digit9];\n48\t    if let Some(d) = n.strip_prefix(\"Digit\").and_then(|d| d.parse::<usize>().ok()).filter(|d| *d < 10) {\n49\t        return Some(digits[d]);\n50\t    }\n51\t    Some(match n {\n52\t        \"Space\" => Space,\n53\t        \"Enter\" => Enter,\n54\t        \"Tab\" => Tab,\n55\t        \"ShiftLeft\" => ShiftLeft,\n56\t        \"ShiftRight\" => ShiftRight,\n57\t        \"ControlLeft\" => ControlLeft,\n58\t        \"ControlRight\" => ControlRight,\n59\t        \"AltLeft\" => AltLeft,\n60\t        \"AltRight\" => AltRight,\n61\t        \"ArrowUp\" => ArrowUp,\n62\t        \"ArrowDown\" => ArrowDown,\n63\t        \"ArrowLeft\" => ArrowLeft,\n64\t        \"ArrowRight\" => ArrowRight,\n65\t        \"Comma\" => Comma,\n66\t        \"Period\" => Period,\n67\t        \"Slash\" => Slash,\n68\t        \"Semicolon\" => Semicolon,\n69\t        \"Quote\" => Quote,\n70\t        \"BracketLeft\" => BracketLeft,\n71\t        \"BracketRight\" => BracketRight,\n72\t        \"Minus\" => Minus,\n73\t        \"Equal\" => Equal,\n74\t        \"CapsLock\" => CapsLock,\n75\t        _ => return None,\n76\t    })\n77\t}\n78\t\n79\t/// Current keyboard bindings: defaults, optionally overridden by the room.\n80\t#[derive(Clone)]\n81\tpub struct Bindings {\n82\t    pub up: Vec<KeyCode>,\n83\t    pub down: Vec<KeyCode>,\n84\t    pub left: Vec<KeyCode>,\n85\t    pub right: Vec<KeyCode>,\n86\t    pub buttons: Vec<(u32, Vec<KeyCode>)>,\n87\t}\n88\t\n89\timpl Default for Bindings {\n90\t    fn default() -> Self {\n91\t        Self {\n92\t            up: KEYS.up.to_vec(),\n93\t            down: KEYS.down.to_vec(),\n94\t            left: KEYS.left.to_vec(),\n95\t            right: KEYS.right.to_vec(),\n96\t            buttons: KEYS.buttons.iter().map(|(b, k)| (*b, k.to_vec())).collect(),\n97\t        }\n98\t    }\n99\t}\n100\t\n101\timpl Bindings {\n102\t    /// Shardfall: WASD to move, mouse buttons and Q E R F for the six skill slots, Space to\n103\t    /// dodge, 1 for a potion, Shift to attack in place.\n104\t    pub fn game() -> Self {\n105\t        use KeyCode::*;\n106\t        Self {\n107\t            up: vec![KeyW, ArrowUp],\n108\t            down: vec![KeyS, ArrowDown],\n109\t            left: vec![KeyA, ArrowLeft],\n110\t            right: vec![KeyD, ArrowRight],\n111\t            buttons: vec![\n112\t                (buttons::SKILL3, vec![KeyQ]),\n113\t                (buttons::SKILL4, vec![KeyE]),\n114\t                (buttons::SKILL5, vec![KeyR]),\n115\t                (buttons::SKILL6, vec![KeyF]),\n116\t                (buttons::DODGE, vec![Space]),\n117\t                (buttons::POTION, vec![Digit1]),\n118\t                (buttons::FOCUS, vec![ShiftLeft]),\n119\t                (buttons::INTERACT, vec![KeyG]),\n120\t            ],\n121\t        }\n122\t    }\n123\t\n124\t    /// Defaults with a room's `[keys]` overrides applied. Returns problems found.\n125\t    pub fn with_overrides(map: &std::collections::BTreeMap<String, Vec<String>>) -> (Self, Vec<String>) {\n126\t        let mut b = Self::default();\n127\t        let mut errs = Vec::new();\n128\t        for (action, names) in map {\n129\t            let keys: Vec<KeyCode> = names\n130\t                .iter()\n131\t                .filter_map(|n| {\n132\t                    let k = key_from_name(n);\n133\t                    if k.is_none() {\n134\t                        errs.push(format!(\"unknown key '{n}'\"));\n135\t                    }\n136\t                    k\n137\t                })\n138\t                .collect();\n139\t            match action.as_str() {\n140\t                \"move_up\" => b.up = keys,\n141\t                \"move_down\" => b.down = keys,\n142\t                \"move_left\" => b.left = keys,\n143\t                \"move_right\" => b.right = keys,\n144\t                other => match pav_core::input::buttons::from_name(other) {\n145\t                    Some(bit) => match b.buttons.iter_mut().find(|(x, _)| *x == bit) {\n146\t                        Some(e) => e.1 = keys,\n147\t                        None => b.buttons.push((bit, keys)),\n148\t                    },\n149\t                    None => errs.push(format!(\"unknown action '{other}'\")),\n150\t                },\n151\t            }\n152\t        }\n153\t        (b, errs)\n154\t    }\n155\t}\n156\t\n157\t/// Shardfall's controls.\n158\tpub fn game_guide(device: Device) -> &'static [(&'static str, &'static str)] {\n159\t    match device {\n160\t        Device::KeyboardMouse => &[\n161\t            (\"Move\", \"W A S D\"),\n162\t            (\"Aim\", \"mouse\"),\n163\t            (\"Skills\", \"LMB · RMB · Q · E · R · F (hold to repeat)\"),\n164\t            (\"Dodge roll\", \"Space (cancels any attack)\"),\n165\t            (\"Potion\", \"1\"),\n166\t            (\"Attack in place\", \"hold Shift\"),\n167\t            (\"Use (trade, portal, way down, chests)\", \"G\"),\n168\t            (\"Inventory · passives · character · skills · map\", \"I · P · C · K · M\"),\n169\t            (\"Town portal\", \"T\"),\n170\t            (\"Pick up\", \"walk over it, or click its name\"),\n171\t            (\"Camera\", \"middle-drag rotate · wheel zoom\"),\n172\t            (\"Rewind\", \"hold Backspace\"),\n173\t            (\"Menu / tuning\", \"Esc / F1\"),\n174\t        ],\n175\t        Device::Gamepad => &[\n176\t            (\"Move / aim\", \"left stick / right stick\"),\n177\t            (\"Skills\", \"X · Y · B · RB · LB · RT\"),\n178\t            (\"Dodge roll\", \"A\"),\n179\t            (\"Potion\", \"D-pad up\"),\n180\t            (\"Use (trade, portal, way down, chests)\", \"D-pad right\"),\n181\t            (\"Map\", \"D-pad left\"),\n182\t            (\"Inventory, character, skills, passives\", \"D-pad down, then LB / RB\"),\n183\t            (\"In menus\", \"stick: cursor · A click · X right-click · hold Y: shift · right stick scroll · B close\"),\n184\t            (\"Menu\", \"Start\"),\n185\t        ],\n186\t        Device::Touch => &[\n187\t            (\"Move\", \"put a thumb down anywhere and drag\"),\n188\t            (\"Attack\", \"automatic: the nearest foe in reach\"),\n189\t            (\"Skills\", \"tap: at the nearest foe · drag: aim, let go to cast · hold: keep casting\"),\n190\t            (\"Dodge roll · potion\", \"the big button · the flask\"),\n191\t            (\"Use (trade, portal, way down, chests)\", \"the button that appears\"),\n192\t            (\"Bag, hero, skills, passives\", \"the bag (top right)\"),\n193\t            (\"Messages and the minimap\", \"swipe them away\"),\n194\t            (\"Close a window\", \"tap the game outside it\"),\n195\t        ],\n196\t    }\n197\t}\n198\t\n199\t/// Human-readable control guide per device.\n200\tpub fn guide(device: Device) -> &'static [(&'static str, &'static str)] {\n201\t    match device {\n202\t        Device::KeyboardMouse => &[\n203\t            (\"Move\", \"W A S D\"),\n204\t            (\"Jump\", \"Space (hold = higher)\"),\n205\t            (\"Crouch\", \"C / Ctrl (hold)\"),\n206\t            (\"Crawl\", \"Z (toggle)\"),\n207\t            (\"Throw bomb\", \"F or left click (at the cursor)\"),\n208\t            (\"Walk slowly\", \"Shift (instant model)\"),\n209\t            (\"Climb ladder\", \"walk into it\"),\n210\t            (\"Grab a ledge\", \"jump at it, keep pushing toward it\"),\n211\t            (\"Swim\", \"Space up · C down\"),\n212\t            (\"Dodge roll\", \"C while running (committed model)\"),\n213\t            (\"Camera\", \"right-drag rotate · wheel zoom · 1–8 presets\"),\n214\t            (\"Vehicles\", \"E get in / out\"),\n215\t            (\"Rewind\", \"hold Backspace\"),\n216\t            (\"Rooms\", \"F2 any room · F4 leave · F5 reset\"),\n217\t            (\"Menu / tuning\", \"Esc / F1\"),\n218\t        ],\n219\t        Device::Gamepad => &[\n220\t            (\"Move\", \"left stick\"),\n221\t            (\"Aim\", \"right stick\"),\n222\t            (\"Jump\", \"A (hold = higher)\"),\n223\t            (\"Crouch\", \"B (hold)\"),\n224\t            (\"Crawl\", \"Y (toggle)\"),\n225\t            (\"Throw bomb\", \"X or right trigger\"),\n226\t            (\"Walk slowly\", \"left trigger (instant model)\"),\n227\t            (\"Grab a ledge\", \"jump at it, keep pushing toward it\"),\n228\t            (\"Swim\", \"A up · B down\"),\n229\t            (\"Dodge roll\", \"B while running (committed model)\"),\n230\t            (\"Camera\", \"LB / RB rotate · D-pad zoom\"),\n231\t            (\"Vehicles\", \"D-pad right: get in / out\"),\n232\t            (\"Rewind\", \"hold Back/View\"),\n233\t            (\"Menu\", \"Start\"),\n234\t        ],\n235\t        Device::Touch => &[\n236\t            (\"Move\", \"put a thumb down anywhere and drag\"),\n237\t            (\"Jump · bomb · crouch · use\", \"the buttons in the corner\"),\n238\t            (\"Menu\", \"top right\"),\n239\t        ],\n240\t    }\n241\t}\n242\t\n243\t#[derive(Default)]\n244\tpub struct Pad {\n245\t    pub left: Vec2,\n246\t    pub right: Vec2,\n247\t    pub held: u32,\n248\t    pub rotate: f32,\n249\t    pub zoom: f32,\n250\t    pub start_pressed: bool,\n251\t    /// D-pad left (the game's map).\n252\t    pub map_pressed: bool,\n253\t    /// Buttons pressed since the last poll (menus read these as taps).\n254\t    pub taps: Vec<gilrs::Button>,\n255\t    /// A (south) and X (west) held: the menu cursor's left and right mouse buttons.\n256\t    pub a_held: bool,\n257\t    pub x_held: bool,\n258\t    /// Y (north) held: Shift for the menu cursor (take a whole path in the passive tree).\n259\t    pub y_held: bool,\n260\t    pub back_held: bool,\n261\t    pub any_activity: bool,\n262\t}\n263\t\n264\tpub struct Input {\n265\t    pub keys: HashSet<KeyCode>,\n266\t    pub mouse: HashSet<MouseButton>,\n267\t    pub cursor: Vec2,\n268\t    pub mouse_active: bool,\n269\t    pub gilrs: Option<gilrs::Gilrs>,\n270\t    /// A scripted gamepad (`--pad-script FILE`): tests and agents drive controller flows.\n271\t    pub pad_script: Option<PadScript>,\n272\t    pub pad: Pad,\n273\t    pub last_device: Device,\n274\t    prev_held: u32,\n275\t    /// Keys / mouse buttons pressed since the last `buttons()` call (short taps are never lost).\n276\t    key_taps: HashSet<KeyCode>,\n277\t    pub mouse_taps: HashSet<MouseButton>,\n278\t    pub bindings: Bindings,\n279\t    /// Game mode: the right mouse button is a skill and the gamepad uses the game layout.\n280\t    pub game: bool,\n281\t}\n282\t\n283\t/// A pad's raw state for one frame.\n284\tstruct PadState {\n285\t    left: Vec2,\n286\t    right: Vec2,\n287\t    held: Vec<gilrs::Button>,\n288\t    lt2: bool,\n289\t    rt2: bool,\n290\t}\n291\t\n292\t/// One line of a pad script: hold this for so many frames.\n293\t#[derive(Clone, Debug, Default)]\n294\tpub struct PadStep {\n295\t    pub frames: u32,\n296\t    pub left: Vec2,\n297\t    pub right: Vec2,\n298\t    pub hold: Vec<gilrs::Button>,\n299\t    pub tap: Vec<gilrs::Button>,\n300\t}\n301\t\n302\t/// A scripted gamepad, one step per line:\n303\t/// `<frames> [left=x,y] [right=x,y] [hold=South,North] [tap=DPadDown]` (`#` comments).\n304\t/// Buttons are gilrs names: South (A), East (B), West (X), North (Y), LeftTrigger (LB),\n305\t/// RightTrigger (RB), Start, Select, DPadUp/Down/Left/Right.\n306\t#[derive(Clone, Debug, Default)]\n307\tpub struct PadScript {\n308\t    pub steps: Vec<PadStep>,\n309\t    at: usize,\n310\t    frame: u32,\n311\t}\n312\t\n313\timpl PadScript {\n314\t    #[cfg_attr(target_arch = \"wasm32\", allow(dead_code))]\n315\t    pub fn parse(text: &str) -> Result<PadScript, String> {\n316\t        let button = |n: &str| -> Result<gilrs::Button, String> {\n317\t            use gilrs::Button as B;\n318\t            Ok(match n {\n319\t                \"South\" | \"A\" => B::South,\n320\t                \"East\" | \"B\" => B::East,\n321\t                \"West\" | \"X\" => B::West,\n322\t                \"North\" | \"Y\" => B::North,\n323\t                \"LeftTrigger\" | \"LB\" => B::LeftTrigger,\n324\t                \"RightTrigger\" | \"RB\" => B::RightTrigger,\n325\t                \"Start\" => B::Start,\n326\t                \"Select\" => B::Select,\n327\t                \"DPadUp\" => B::DPadUp,\n328\t                \"DPadDown\" => B::DPadDown,\n329\t                \"DPadLeft\" => B::DPadLeft,\n330\t                \"DPadRight\" => B::DPadRight,\n331\t                o => return Err(format!(\"unknown button '{o}'\")),\n332\t            })\n333\t        };\n334\t        let vec = |v: &str| -> Result<Vec2, String> {\n335\t            let (x, y) = v.split_once(',').ok_or(format!(\"'{v}': want x,y\"))?;\n336\t            Ok(Vec2::new(x.trim().parse().map_err(|_| format!(\"'{v}'\"))?, y.trim().parse().map_err(|_| format!(\"'{v}'\"))?))\n337\t        };\n338\t        let mut steps = Vec::new();\n339\t        for (n, line) in text.lines().enumerate() {\n340\t            let line = line.split('#').next().unwrap_or(\"\").trim();\n341\t            if line.is_empty() {\n342\t                continue;\n343\t            }\n344\t            let mut words = line.split_whitespace();\n345\t            let frames = words.next().and_then(|w| w.parse().ok()).ok_or(format!(\"line {}: starts with a frame count\", n + 1))?;\n346\t            let mut st = PadStep { frames, ..Default::default() };\n347\t            for w in words {\n348\t                let (k, v) = w.split_once('=').ok_or(format!(\"line {}: '{w}'\", n + 1))?;\n349\t                match k {\n350\t                    \"left\" => st.left = vec(v)?,\n351\t                    \"right\" => st.right = vec(v)?,\n352\t                    \"hold\" => st.hold = v.split(',').map(button).collect::<Result<_, _>>()?,\n353\t                    \"tap\" => st.tap = v.split(',').map(button).collect::<Result<_, _>>()?,\n354\t                    o => return Err(format!(\"line {}: unknown '{o}'\", n + 1)),\n355\t                }\n356\t            }\n357\t            steps.push(st);\n358\t        }\n359\t        Ok(PadScript { steps, at: 0, frame: 0 })\n360\t    }\n361\t\n362\t    /// This frame's step (and whether it's the step's first frame); None when done.\n363\t    fn next(&mut self) -> Option<(PadStep, bool)> {\n364\t        let st = self.steps.get(self.at)?.clone();\n365\t        let first = self.frame == 0;\n366\t        self.frame += 1;\n367\t        if self.frame >= st.frames.max(1) {\n368\t            self.at += 1;\n369\t            self.frame = 0;\n370\t        }\n371\t        Some((st, first))\n372\t    }\n373\t}\n374\t\n375\tfn deadzone(v: Vec2, dz: f32) -> Vec2 {\n376\t    let l = v.length();\n377\t    if l < dz { Vec2::ZERO } else { v / l * ((l - dz) / (1.0 - dz)).min(1.0) }\n378\t}\n379\t\n380\timpl Input {\n381\t    pub fn new() -> Self {\n382\t        let gilrs = match gilrs::Gilrs::new() {\n383\t            Ok(g) => {\n384\t                for (_, gp) in g.gamepads() {\n385\t                    log::info!(\"gamepad: {} ({:?})\", gp.name(), gp.power_info());\n386\t                }\n387\t                Some(g)\n388\t            }\n389\t            Err(e) => {\n390\t                log::warn!(\"gamepads unavailable: {e}\");\n391\t                None\n392\t            }\n393\t        };\n394\t        Self {\n395\t            keys: HashSet::new(),\n396\t            mouse: HashSet::new(),\n397\t            cursor: Vec2::ZERO,\n398\t            mouse_active: false,\n399\t            gilrs,\n400\t            pad_script: None,\n401\t            pad: Pad::default(),\n402\t            last_device: Device::KeyboardMouse,\n403\t            prev_held: 0,\n404\t            key_taps: HashSet::new(),\n405\t            mouse_taps: HashSet::new(),\n406\t            bindings: Bindings::default(),\n407\t            game: false,\n408\t        }\n409\t    }\n410\t\n411\t    pub fn key(&mut self, code: KeyCode, state: ElementState) {\n412\t        self.last_device = Device::KeyboardMouse;\n413\t        match state {\n414\t            ElementState::Pressed => {\n415\t                self.keys.insert(code);\n416\t                self.key_taps.insert(code);\n417\t            }\n418\t            ElementState::Released => {\n419\t                self.keys.remove(&code);\n420\t            }\n421\t        }\n422\t    }\n423\t\n424\t    pub fn mouse_button(&mut self, b: MouseButton, state: ElementState) {\n425\t        self.last_device = Device::KeyboardMouse;\n426\t        self.mouse_active = true;\n427\t        match state {\n428\t            ElementState::Pressed => {\n429\t                self.mouse.insert(b);\n430\t                self.mouse_taps.insert(b);\n431\t            }\n432\t            ElementState::Released => {\n433\t                self.mouse.remove(&b);\n434\t            }\n435\t        }\n436\t    }\n437\t\n438\t    pub fn clear(&mut self) {\n439\t        self.keys.clear();\n440\t        self.mouse.clear();\n441\t    }\n442\t\n443\t    /// Reads gamepad events and state (first connected pad).\n444\t    pub fn poll_gamepad(&mut self) {\n445\t        use gilrs::{Axis, Button};\n446\t        let mut activity = false;\n447\t        let mut taps = Vec::new();\n448\t        // One pad state from the first connected pad, or from the pad script while it runs.\n449\t        let mut state: Option<PadState> = None;\n450\t        if let Some(g) = &mut self.gilrs {\n451\t            while let Some(ev) = g.next_event() {\n452\t                match ev.event {\n453\t                    gilrs::EventType::ButtonPressed(b, _) => {\n454\t                        taps.push(b);\n455\t                        activity = true;\n456\t                    }\n457\t                    gilrs::EventType::AxisChanged(_, v, _) if v.abs() > 0.4 => activity = true,\n458\t                    gilrs::EventType::Connected => log::info!(\"gamepad connected\"),\n459\t                    gilrs::EventType::Disconnected => log::info!(\"gamepad disconnected\"),\n460\t                    _ => {}\n461\t                }\n462\t            }\n463\t            if let Some((_, gp)) = g.gamepads().next() {\n464\t                const ALL: [Button; 15] = [\n465\t                    Button::South,\n466\t                    Button::East,\n467\t                    Button::North,\n468\t                    Button::West,\n469\t                    Button::LeftTrigger,\n470\t                    Button::RightTrigger,\n471\t                    Button::Select,\n472\t                    Button::Start,\n473\t                    Button::DPadUp,\n474\t                    Button::DPadDown,\n475\t                    Button::DPadLeft,\n476\t                    Button::DPadRight,\n477\t                    Button::LeftThumb,\n478\t                    Button::RightThumb,\n479\t                    Button::Mode,\n480\t                ];\n481\t                let trig = |b: Button| gp.button_data(b).map(|d| d.value()).unwrap_or(0.0) > 0.35;\n482\t                state = Some(PadState {\n483\t                    left: Vec2::new(gp.value(Axis::LeftStickX), gp.value(Axis::LeftStickY)),\n484\t                    right: Vec2::new(gp.value(Axis::RightStickX), gp.value(Axis::RightStickY)),\n485\t                    held: ALL.into_iter().filter(|b| gp.is_pressed(*b)).collect(),\n486\t                    lt2: trig(Button::LeftTrigger2),\n487\t                    rt2: trig(Button::RightTrigger2),\n488\t                });\n489\t            }\n490\t        }\n491\t        if let Some(script) = &mut self.pad_script {\n492\t            if let Some((st, first)) = script.next() {\n493\t                if first {\n494\t                    taps.extend(st.tap.iter().copied());\n495\t                }\n496\t                activity = true;\n497\t                state = Some(PadState { left: st.left, right: st.right, held: st.hold.clone(), lt2: false, rt2: false });\n498\t            }\n499\t        }\n500\t        let start = taps.contains(&Button::Start);\n501\t        let map = taps.contains(&Button::DPadLeft);\n502\t        let mut pad = Pad { start_pressed: start, map_pressed: map, taps, any_activity: activity, ..Default::default() };\n503\t        if let Some(st) = state {\n504\t            let is = |b: Button| st.held.contains(&b);\n505\t            pad.left = deadzone(st.left, 0.18);\n506\t            pad.right = deadzone(st.right, 0.25);\n507\t            let mut held = 0;\n508\t            let layout: &[(Button, u32)] = if self.game {\n509\t                &[\n510\t                    (Button::West, buttons::PRIMARY),\n511\t                    (Button::North, buttons::SECONDARY),\n512\t                    (Button::East, buttons::SKILL3),\n513\t                    (Button::RightTrigger, buttons::SKILL4),\n514\t                    (Button::LeftTrigger, buttons::SKILL5),\n515\t                    (Button::South, buttons::DODGE),\n516\t                    (Button::DPadUp, buttons::POTION),\n517\t                    (Button::DPadRight, buttons::INTERACT),\n518\t                ]\n519\t            } else {\n520\t                &[\n521\t                    (Button::South, buttons::JUMP),\n522\t                    (Button::East, buttons::CROUCH),\n523\t                    (Button::North, buttons::CRAWL),\n524\t                    (Button::West, buttons::USE),\n525\t                    (Button::DPadRight, buttons::INTERACT),\n526\t                ]\n527\t            };\n528\t            for (btn, action) in layout {\n529\t                if is(*btn) {\n530\t                    held |= action;\n531\t                }\n532\t            }\n533\t            if st.rt2 {\n534\t                held |= if self.game { buttons::SKILL6 } else { buttons::USE };\n535\t            }\n536\t            if st.lt2 {\n537\t                held |= buttons::FOCUS;\n538\t            }\n539\t            pad.held = held;\n540\t            pad.rotate = if self.game { 0.0 } else { (is(Button::RightTrigger) as i32 - is(Button::LeftTrigger) as i32) as f32 };\n541\t            // In the game the D-pad is potion / use / map / panels, not zoom.\n542\t            pad.zoom = if self.game { 0.0 } else { (is(Button::DPadDown) as i32 - is(Button::DPadUp) as i32) as f32 };\n543\t            pad.a_held = is(Button::South);\n544\t            pad.x_held = is(Button::West);\n545\t            pad.y_held = is(Button::North);\n546\t            pad.back_held = is(Button::Select);\n547\t            if pad.left.length() > 0.3 || pad.right.length() > 0.3 || held != 0 {\n548\t                pad.any_activity = true;\n549\t            }\n550\t        }\n551\t        if pad.any_activity {\n552\t            self.last_device = Device::Gamepad;\n553\t        }\n554\t        self.pad = pad;\n555\t    }\n556\t\n557\t    /// Screen-space movement (x right, y up) from keys and stick, length <= 1.\n558\t    pub fn move_axis(&self) -> Vec2 {\n559\t        let k = |codes: &[KeyCode]| codes.iter().any(|c| self.keys.contains(c)) as i32 as f32;\n560\t        let b = &self.bindings;\n561\t        let kb = Vec2::new(k(&b.right) - k(&b.left), k(&b.up) - k(&b.down));\n562\t        let v = if kb != Vec2::ZERO { kb.normalize() } else { self.pad.left };\n563\t        v.clamp_length_max(1.0)\n564\t    }\n565\t\n566\t    /// Held game buttons from all devices.\n567\t    pub fn held(&self) -> u32 {\n568\t        let mut b = self.pad.held;\n569\t        for (bit, codes) in &self.bindings.buttons {\n570\t            if codes.iter().any(|c| self.keys.contains(c)) {\n571\t                b |= bit;\n572\t            }\n573\t        }\n574\t        if self.mouse.contains(&MouseButton::Left) {\n575\t            b |= buttons::PRIMARY;\n576\t        }\n577\t        if self.game && self.mouse.contains(&MouseButton::Right) {\n578\t            b |= buttons::SECONDARY;\n579\t        }\n580\t        b\n581\t    }\n582\t\n583\t    /// Returns (held, newly pressed since the last call).\n584\t    pub fn buttons(&mut self) -> (u32, u32) {\n585\t        let held = self.held();\n586\t        let mut pressed = held & !self.prev_held;\n587\t        for (bit, codes) in &self.bindings.buttons {\n588\t            if codes.iter().any(|c| self.key_taps.contains(c)) {\n589\t                pressed |= bit;\n590\t            }\n591\t        }\n592\t        if self.mouse_taps.contains(&MouseButton::Left) {\n593\t            pressed |= buttons::PRIMARY;\n594\t        }\n595\t        if self.game && self.mouse_taps.contains(&MouseButton::Right) {\n596\t            pressed |= buttons::SECONDARY;\n597\t        }\n598\t        self.key_taps.clear();\n599\t        self.mouse_taps.clear();\n600\t        self.prev_held = held;\n601\t        // A tap shorter than a frame still counts as held for that frame.\n602\t        (held | pressed, pressed)\n603\t    }\n604\t\n605\t    /// True if `b` was pressed since the last call (consumes the tap).\n606\t    pub fn take_mouse_tap(&mut self, b: MouseButton) -> bool {\n607\t        self.mouse_taps.remove(&b)\n608\t    }\n609\t\n610\t    pub fn rewind_held(&self) -> bool {\n611\t        self.keys.contains(&KeyCode::Backspace) || self.pad.back_held\n612\t    }\n613\t}\n614\t\n615\t#[cfg(test)]\n616\tmod pad_script_tests {\n617\t    use super::*;\n618\t\n619\t    #[test]\n620\t    fn pad_scripts_parse_and_play() {\n621\t        let mut p = PadScript::parse(\"# open the bag\\n2\\n1 tap=DPadDown\\n3 left=0.5,-1 hold=A,Y\\n\").unwrap();\n622\t        assert_eq!(p.steps.len(), 3);\n623\t        let frames: Vec<(PadStep, bool)> = std::iter::from_fn(|| p.next()).collect();\n624\t        assert_eq!(frames.len(), 6);\n625\t        assert!(frames[2].1 && frames[2].0.tap == vec![gilrs::Button::DPadDown]);\n626\t        assert_eq!(frames[3].0.hold, vec![gilrs::Button::South, gilrs::Button::North]);\n627\t        assert_eq!(frames[5].0.left, Vec2::new(0.5, -1.0));\n628\t        assert!(PadScript::parse(\"x tap=A\").is_err());\n629\t        assert!(PadScript::parse(\"1 tap=Q\").is_err());\n630\t    }\n631\t}\n632\t"}]},"parent_tool_use_id":null,"session_id":"cb437ba7-0477-4143-bb04-ff33f49efd62","uuid":"326c558a-0af6-4c60-a814-bc405ea9075f","timestamp":"2026-11-05T05:40:30.999Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953/engine/crates/pav_app/src/input.rs","content":"//! Devices -> actions. Keyboard keys are bound by physical position (WASD stays WASD on AZERTY).\n//! The fixed system layer (pause, rewind, menus) is handled in `app.rs` and never rebinds.\n\nuse std::collections::HashSet;\n\nuse glam::Vec2;\nuse pav_core::input::buttons;\nuse winit::event::{ElementState, MouseButton};\nuse winit::keyboard::KeyCode;\n\npub use pav_ui::Device;\n\n/// Game-action bindings (defaults; rooms may override in the future).\npub struct KeyBinds {\n    pub up: &'static [KeyCode],\n    pub down: &'static [KeyCode],\n    pub left: &'static [KeyCode],\n    pub right: &'static [KeyCode],\n    pub buttons: &'static [(u32, &'static [KeyCode])],\n}\n\npub const KEYS: KeyBinds = KeyBinds {\n    up: &[KeyCode::KeyW, KeyCode::ArrowUp],\n    down: &[KeyCode::KeyS, KeyCode::ArrowDown],\n    left: &[KeyCode::KeyA, KeyCode::ArrowLeft],\n    right: &[KeyCode::KeyD, KeyCode::ArrowRight],\n    buttons: &[\n        (buttons::JUMP, &[KeyCode::Space]),\n        (buttons::CROUCH, &[KeyCode::KeyC, KeyCode::ControlLeft]),\n        (buttons::CRAWL, &[KeyCode::KeyZ]),\n        (buttons::USE, &[KeyCode::KeyF]),\n        (buttons::FOCUS, &[KeyCode::ShiftLeft]),\n        (buttons::INTERACT, &[KeyCode::KeyE]),\n    ],\n};\n\n/// Physical key names usable in room files (`[keys]`).\npub fn key_from_name(n: &str) -> Option<KeyCode> {\n    use KeyCode::*;\n    let letters = [\n        KeyA, KeyB, KeyC, KeyD, KeyE, KeyF, KeyG, KeyH, KeyI, KeyJ, KeyK, KeyL, KeyM, KeyN, KeyO, KeyP, KeyQ, KeyR, KeyS, KeyT,\n        KeyU, KeyV, KeyW, KeyX, KeyY, KeyZ,\n    ];\n    if let Some(c) = n.strip_prefix(\"Key\").and_then(|l| l.chars().next()).filter(|c| c.is_ascii_uppercase() && n.len() == 4) {\n        return Some(letters[(c as u8 - b'A') as usize]);\n    }\n    let digits = [Digit0, Digit1, Digit2, Digit3, Digit4, Digit5, Digit6, Digit7, Digit8, Digit9];\n    if let Some(d) = n.strip_prefix(\"Digit\").and_then(|d| d.parse::<usize>().ok()).filter(|d| *d < 10) {\n        return Some(digits[d]);\n    }\n    Some(match n {\n        \"Space\" => Space,\n        \"Enter\" => Enter,\n        \"Tab\" => Tab,\n        \"ShiftLeft\" => ShiftLeft,\n        \"ShiftRight\" => ShiftRight,\n        \"ControlLeft\" => ControlLeft,\n        \"ControlRight\" => ControlRight,\n        \"AltLeft\" => AltLeft,\n        \"AltRight\" => AltRight,\n        \"ArrowUp\" => ArrowUp,\n        \"ArrowDown\" => ArrowDown,\n        \"ArrowLeft\" => ArrowLeft,\n        \"ArrowRight\" => ArrowRight,\n        \"Comma\" => Comma,\n        \"Period\" => Period,\n        \"Slash\" => Slash,\n        \"Semicolon\" => Semicolon,\n        \"Quote\" => Quote,\n        \"BracketLeft\" => BracketLeft,\n        \"BracketRight\" => BracketRight,\n        \"Minus\" => Minus,\n        \"Equal\" => Equal,\n        \"CapsLock\" => CapsLock,\n        _ => return None,\n    })\n}\n\n/// Current keyboard bindings: defaults, optionally overridden by the room.\n#[derive(Clone)]\npub struct Bindings {\n    pub up: Vec<KeyCode>,\n    pub down: Vec<KeyCode>,\n    pub left: Vec<KeyCode>,\n    pub right: Vec<KeyCode>,\n    pub buttons: Vec<(u32, Vec<KeyCode>)>,\n}\n\nimpl Default for Bindings {\n    fn default() -> Self {\n        Self {\n            up: KEYS.up.to_vec(),\n            down: KEYS.down.to_vec(),\n            left: KEYS.left.to_vec(),\n            right: KEYS.right.to_vec(),\n            buttons: KEYS.buttons.iter().map(|(b, k)| (*b, k.to_vec())).collect(),\n        }\n    }\n}\n\nimpl Bindings {\n    /// Shardfall: WASD to move, mouse buttons and Q E R F for the six skill slots, Space to\n    /// dodge, 1 for a potion, Shift to attack in place.\n    pub fn game() -> Self {\n        use KeyCode::*;\n        Self {\n            up: vec![KeyW, ArrowUp],\n            down: vec![KeyS, ArrowDown],\n            left: vec![KeyA, ArrowLeft],\n            right: vec![KeyD, ArrowRight],\n            buttons: vec![\n                (buttons::SKILL3, vec![KeyQ]),\n                (buttons::SKILL4, vec![KeyE]),\n                (buttons::SKILL5, vec![KeyR]),\n                (buttons::SKILL6, vec![KeyF]),\n                (buttons::DODGE, vec![Space]),\n                (buttons::POTION, vec![Digit1]),\n                (buttons::FOCUS, vec![ShiftLeft]),\n                (buttons::INTERACT, vec![KeyG]),\n            ],\n        }\n    }\n\n    /// Defaults with a room's `[keys]` overrides applied. Returns problems found.\n    pub fn with_overrides(map: &std::collections::BTreeMap<String, Vec<String>>) -> (Self, Vec<String>) {\n        let mut b = Self::default();\n        let mut errs = Vec::new();\n        for (action, names) in map {\n            let keys: Vec<KeyCode> = names\n                .iter()\n                .filter_map(|n| {\n                    let k = key_from_name(n);\n                    if k.is_none() {\n                        errs.push(format!(\"unknown key '{n}'\"));\n                    }\n                    k\n                })\n                .collect();\n            match action.as_str() {\n                \"move_up\" => b.up = keys,\n                \"move_down\" => b.down = keys,\n                \"move_left\" => b.left = keys,\n                \"move_right\" => b.right = keys,\n                other => match pav_core::input::buttons::from_name(other) {\n                    Some(bit) => match b.buttons.iter_mut().find(|(x, _)| *x == bit) {\n                        Some(e) => e.1 = keys,\n                        None => b.buttons.push((bit, keys)),\n                    },\n                    None => errs.push(format!(\"unknown action '{other}'\")),\n                },\n            }\n        }\n        (b, errs)\n    }\n}\n\n/// Shardfall's controls.\npub fn game_guide(device: Device) -> &'static [(&'static str, &'static str)] {\n    match device {\n        Device::KeyboardMouse => &[\n            (\"Move\", \"W A S D\"),\n            (\"Aim\", \"mouse\"),\n            (\"Skills\", \"LMB · RMB · Q · E · R · F (hold to repeat)\"),\n            (\"Dodge roll\", \"Space (cancels any attack)\"),\n            (\"Potion\", \"1\"),\n            (\"Attack in place\", \"hold Shift\"),\n            (\"Use (trade, portal, way down, chests)\", \"G\"),\n            (\"Inventory · passives · character · skills · map\", \"I · P · C · K · M\"),\n            (\"Town portal\", \"T\"),\n            (\"Pick up\", \"walk over it, or click its name\"),\n            (\"Camera\", \"middle-drag rotate · wheel zoom\"),\n            (\"Rewind\", \"hold Backspace\"),\n            (\"Menu / tuning\", \"Esc / F1\"),\n        ],\n        Device::Gamepad => &[\n            (\"Move / aim\", \"left stick / right stick\"),\n            (\"Skills\", \"X · Y · B · RB · LB · RT\"),\n            (\"Dodge roll\", \"A\"),\n            (\"Potion\", \"D-pad up\"),\n            (\"Use (trade, portal, way down, chests)\", \"D-pad right\"),\n            (\"Map\", \"D-pad left\"),\n            (\"Inventory, character, skills, passives\", \"D-pad down, then LB / RB\"),\n            (\"In menus\", \"stick: cursor · A click · X right-click · hold Y: shift · right stick scroll · B close\"),\n            (\"Menu\", \"Start\"),\n        ],\n        Device::Touch => &[\n            (\"Move\", \"put a thumb down anywhere and drag\"),\n            (\"Attack\", \"automatic: the nearest foe in reach\"),\n            (\"Skills\", \"tap: at the nearest foe · drag: aim, let go to cast · hold: keep casting\"),\n            (\"Dodge roll · potion\", \"the big button · the flask\"),\n            (\"Use (trade, portal, way down, chests)\", \"the button that appears\"),\n            (\"Bag, hero, skills, passives\", \"the bag (top right)\"),\n            (\"Messages and the minimap\", \"swipe them away\"),\n            (\"Close a window\", \"tap the game outside it\"),\n        ],\n    }\n}\n\n/// Human-readable control guide per device.\npub fn guide(device: Device) -> &'static [(&'static str, &'static str)] {\n    match device {\n        Device::KeyboardMouse => &[\n            (\"Move\", \"W A S D\"),\n            (\"Jump\", \"Space (hold = higher)\"),\n            (\"Crouch\", \"C / Ctrl (hold)\"),\n            (\"Crawl\", \"Z (toggle)\"),\n            (\"Throw bomb\", \"F or left click (at the cursor)\"),\n            (\"Walk slowly\", \"Shift (instant model)\"),\n            (\"Climb ladder\", \"walk into it\"),\n            (\"Grab a ledge\", \"jump at it, keep pushing toward it\"),\n            (\"Swim\", \"Space up · C down\"),\n            (\"Dodge roll\", \"C while running (committed model)\"),\n            (\"Camera\", \"right-drag rotate · wheel zoom · 1–8 presets\"),\n            (\"Vehicles\", \"E get in / out\"),\n            (\"Rewind\", \"hold Backspace\"),\n            (\"Rooms\", \"F2 any room · F4 leave · F5 reset\"),\n            (\"Menu / tuning\", \"Esc / F1\"),\n        ],\n        Device::Gamepad => &[\n            (\"Move\", \"left stick\"),\n            (\"Aim\", \"right stick\"),\n            (\"Jump\", \"A (hold = higher)\"),\n            (\"Crouch\", \"B (hold)\"),\n            (\"Crawl\", \"Y (toggle)\"),\n            (\"Throw bomb\", \"X or right trigger\"),\n            (\"Walk slowly\", \"left trigger (instant model)\"),\n            (\"Grab a ledge\", \"jump at it, keep pushing toward it\"),\n            (\"Swim\", \"A up · B down\"),\n            (\"Dodge roll\", \"B while running (committed model)\"),\n            (\"Camera\", \"LB / RB rotate · D-pad zoom\"),\n            (\"Vehicles\", \"D-pad right: get in / out\"),\n            (\"Rewind\", \"hold Back/View\"),\n            (\"Menu\", \"Start\"),\n        ],\n        Device::Touch => &[\n            (\"Move\", \"put a thumb down anywhere and drag\"),\n            (\"Jump · bomb · crouch · use\", \"the buttons in the corner\"),\n            (\"Menu\", \"top right\"),\n        ],\n    }\n}\n\n#[derive(Default)]\npub struct Pad {\n    pub left: Vec2,\n    pub right: Vec2,\n    pub held: u32,\n    pub rotate: f32,\n    pub zoom: f32,\n    pub start_pressed: bool,\n    /// D-pad left (the game's map).\n    pub map_pressed: bool,\n    /// Buttons pressed since the last poll (menus read these as taps).\n    pub taps: Vec<gilrs::Button>,\n    /// A (south) and X (west) held: the menu cursor's left and right mouse buttons.\n    pub a_held: bool,\n    pub x_held: bool,\n    /// Y (north) held: Shift for the menu cursor (take a whole path in the passive tree).\n    pub y_held: bool,\n    pub back_held: bool,\n    pub any_activity: bool,\n}\n\npub struct Input {\n    pub keys: HashSet<KeyCode>,\n    pub mouse: HashSet<MouseButton>,\n    pub cursor: Vec2,\n    pub mouse_active: bool,\n    pub gilrs: Option<gilrs::Gilrs>,\n    /// A scripted gamepad (`--pad-script FILE`): tests and agents drive controller flows.\n    pub pad_script: Option<PadScript>,\n    pub pad: Pad,\n    pub last_device: Device,\n    prev_held: u32,\n    /// Keys / mouse buttons pressed since the last `buttons()` call (short taps are never lost).\n    key_taps: HashSet<KeyCode>,\n    pub mouse_taps: HashSet<MouseButton>,\n    pub bindings: Bindings,\n    /// Game mode: the right mouse button is a skill and the gamepad uses the game layout.\n    pub game: bool,\n}\n\n/// A pad's raw state for one frame.\nstruct PadState {\n    left: Vec2,\n    right: Vec2,\n    held: Vec<gilrs::Button>,\n    lt2: bool,\n    rt2: bool,\n}\n\n/// One line of a pad script: hold this for so many frames.\n#[derive(Clone, Debug, Default)]\npub struct PadStep {\n    pub frames: u32,\n    pub left: Vec2,\n    pub right: Vec2,\n    pub hold: Vec<gilrs::Button>,\n    pub tap: Vec<gilrs::Button>,\n}\n\n/// A scripted gamepad, one step per line:\n/// `<frames> [left=x,y] [right=x,y] [hold=South,North] [tap=DPadDown]` (`#` comments).\n/// Buttons are gilrs names: South (A), East (B), West (X), North (Y), LeftTrigger (LB),\n/// RightTrigger (RB), Start, Select, DPadUp/Down/Left/Right.\n#[derive(Clone, Debug, Default)]\npub struct PadScript {\n    pub steps: Vec<PadStep>,\n    at: usize,\n    frame: u32,\n}\n\nimpl PadScript {\n    #[cfg_attr(target_arch = \"wasm32\", allow(dead_code))]\n    pub fn parse(text: &str) -> Result<PadScript, String> {\n        let button = |n: &str| -> Result<gilrs::Button, String> {\n            use gilrs::Button as B;\n            Ok(match n {\n                \"South\" | \"A\" => B::South,\n                \"East\" | \"B\" => B::East,\n                \"West\" | \"X\" => B::West,\n                \"North\" | \"Y\" => B::North,\n                \"LeftTrigger\" | \"LB\" => B::LeftTrigger,\n                \"RightTrigger\" | \"RB\" => B::RightTrigger,\n                \"Start\" => B::Start,\n                \"Select\" => B::Select,\n                \"DPadUp\" => B::DPadUp,\n                \"DPadDown\" => B::DPadDown,\n                \"DPadLeft\" => B::DPadLeft,\n                \"DPadRight\" => B::DPadRight,\n                o => return Err(format!(\"unknown button '{o}'\")),\n            })\n        };\n        let vec = |v: &str| -> Result<Vec2, String> {\n            let (x, y) = v.split_once(',').ok_or(format!(\"'{v}': want x,y\"))?;\n            Ok(Vec2::new(x.trim().parse().map_err(|_| format!(\"'{v}'\"))?, y.trim().parse().map_err(|_| format!(\"'{v}'\"))?))\n        };\n        let mut steps = Vec::new();\n        for (n, line) in text.lines().enumerate() {\n            let line = line.split('#').next().unwrap_or(\"\").trim();\n            if line.is_empty() {\n                continue;\n            }\n            let mut words = line.split_whitespace();\n            let frames = words.next().and_then(|w| w.parse().ok()).ok_or(format!(\"line {}: starts with a frame count\", n + 1))?;\n            let mut st = PadStep { frames, ..Default::default() };\n            for w in words {\n                let (k, v) = w.split_once('=').ok_or(format!(\"line {}: '{w}'\", n + 1))?;\n                match k {\n                    \"left\" => st.left = vec(v)?,\n                    \"right\" => st.right = vec(v)?,\n                    \"hold\" => st.hold = v.split(',').map(button).collect::<Result<_, _>>()?,\n                    \"tap\" => st.tap = v.split(',').map(button).collect::<Result<_, _>>()?,\n                    o => return Err(format!(\"line {}: unknown '{o}'\", n + 1)),\n                }\n            }\n            steps.push(st);\n        }\n        Ok(PadScript { steps, at: 0, frame: 0 })\n    }\n\n    /// This frame's step (and whether it's the step's first frame); None when done.\n    fn next(&mut self) -> Option<(PadStep, bool)> {\n        let st = self.steps.get(self.at)?.clone();\n        let first = self.frame == 0;\n        self.frame += 1;\n        if self.frame >= st.frames.max(1) {\n            self.at += 1;\n            self.frame = 0;\n        }\n        Some((st, first))\n    }\n}\n\nfn deadzone(v: Vec2, dz: f32) -> Vec2 {\n    let l = v.length();\n    if l < dz { Vec2::ZERO } else { v / l * ((l - dz) / (1.0 - dz)).min(1.0) }\n}\n\nimpl Input {\n    pub fn new() -> Self {\n        let gilrs = match gilrs::Gilrs::new() {\n            Ok(g) => {\n                for (_, gp) in g.gamepads() {\n                    log::info!(\"gamepad: {} ({:?})\", gp.name(), gp.power_info());\n                }\n                Some(g)\n            }\n            Err(e) => {\n                log::warn!(\"gamepads unavailable: {e}\");\n                None\n            }\n        };\n        Self {\n            keys: HashSet::new(),\n            mouse: HashSet::new(),\n            cursor: Vec2::ZERO,\n            mouse_active: false,\n            gilrs,\n            pad_script: None,\n            pad: Pad::default(),\n            last_device: Device::KeyboardMouse,\n            prev_held: 0,\n            key_taps: HashSet::new(),\n            mouse_taps: HashSet::new(),\n            bindings: Bindings::default(),\n            game: false,\n        }\n    }\n\n    pub fn key(&mut self, code: KeyCode, state: ElementState) {\n        self.last_device = Device::KeyboardMouse;\n        match state {\n            ElementState::Pressed => {\n                self.keys.insert(code);\n                self.key_taps.insert(code);\n            }\n            ElementState::Released => {\n                self.keys.remove(&code);\n            }\n        }\n    }\n\n    pub fn mouse_button(&mut self, b: MouseButton, state: ElementState) {\n        self.last_device = Device::KeyboardMouse;\n        self.mouse_active = true;\n        match state {\n            ElementState::Pressed => {\n                self.mouse.insert(b);\n                self.mouse_taps.insert(b);\n            }\n            ElementState::Released => {\n                self.mouse.remove(&b);\n            }\n        }\n    }\n\n    pub fn clear(&mut self) {\n        self.keys.clear();\n        self.mouse.clear();\n    }\n\n    /// Reads gamepad events and state (first connected pad).\n    pub fn poll_gamepad(&mut self) {\n        use gilrs::{Axis, Button};\n        let mut activity = false;\n        let mut taps = Vec::new();\n        // One pad state from the first connected pad, or from the pad script while it runs.\n        let mut state: Option<PadState> = None;\n        if let Some(g) = &mut self.gilrs {\n            while let Some(ev) = g.next_event() {\n                match ev.event {\n                    gilrs::EventType::ButtonPressed(b, _) => {\n                        taps.push(b);\n                        activity = true;\n                    }\n                    gilrs::EventType::AxisChanged(_, v, _) if v.abs() > 0.4 => activity = true,\n                    gilrs::EventType::Connected => log::info!(\"gamepad connected\"),\n                    gilrs::EventType::Disconnected => log::info!(\"gamepad disconnected\"),\n                    _ => {}\n                }\n            }\n            if let Some((_, gp)) = g.gamepads().next() {\n                const ALL: [Button; 15] = [\n                    Button::South,\n                    Button::East,\n                    Button::North,\n                    Button::West,\n                    Button::LeftTrigger,\n                    Button::RightTrigger,\n                    Button::Select,\n                    Button::Start,\n                    Button::DPadUp,\n                    Button::DPadDown,\n                    Button::DPadLeft,\n                    Button::DPadRight,\n                    Button::LeftThumb,\n                    Button::RightThumb,\n                    Button::Mode,\n                ];\n                let trig = |b: Button| gp.button_data(b).map(|d| d.value()).unwrap_or(0.0) > 0.35;\n                state = Some(PadState {\n                    left: Vec2::new(gp.value(Axis::LeftStickX), gp.value(Axis::LeftStickY)),\n                    right: Vec2::new(gp.value(Axis::RightStickX), gp.value(Axis::RightStickY)),\n                    held: ALL.into_iter().filter(|b| gp.is_pressed(*b)).collect(),\n                    lt2: trig(Button::LeftTrigger2),\n                    rt2: trig(Button::RightTrigger2),\n                });\n            }\n        }\n        if let Some(script) = &mut self.pad_script {\n            if let Some((st, first)) = script.next() {\n                if first {\n                    taps.extend(st.tap.iter().copied());\n                }\n                activity = true;\n                state = Some(PadState { left: st.left, right: st.right, held: st.hold.clone(), lt2: false, rt2: false });\n            }\n        }\n        let start = taps.contains(&Button::Start);\n        let map = taps.contains(&Button::DPadLeft);\n        let mut pad = Pad { start_pressed: start, map_pressed: map, taps, any_activity: activity, ..Default::default() };\n        if let Some(st) = state {\n            let is = |b: Button| st.held.contains(&b);\n            pad.left = deadzone(st.left, 0.18);\n            pad.right = deadzone(st.right, 0.25);\n            let mut held = 0;\n            let layout: &[(Button, u32)] = if self.game {\n                &[\n                    (Button::West, buttons::PRIMARY),\n                    (Button::North, buttons::SECONDARY),\n                    (Button::East, buttons::SKILL3),\n                    (Button::RightTrigger, buttons::SKILL4),\n                    (Button::LeftTrigger, buttons::SKILL5),\n                    (Button::South, buttons::DODGE),\n                    (Button::DPadUp, buttons::POTION),\n                    (Button::DPadRight, buttons::INTERACT),\n                ]\n            } else {\n                &[\n                    (Button::South, buttons::JUMP),\n                    (Button::East, buttons::CROUCH),\n                    (Button::North, buttons::CRAWL),\n                    (Button::West, buttons::USE),\n                    (Button::DPadRight, buttons::INTERACT),\n                ]\n            };\n            for (btn, action) in layout {\n                if is(*btn) {\n                    held |= action;\n                }\n            }\n            if st.rt2 {\n                held |= if self.game { buttons::SKILL6 } else { buttons::USE };\n            }\n            if st.lt2 {\n                held |= buttons::FOCUS;\n            }\n            pad.held = held;\n            pad.rotate = if self.game { 0.0 } else { (is(Button::RightTrigger) as i32 - is(Button::LeftTrigger) as i32) as f32 };\n            // In the game the D-pad is potion / use / map / panels, not zoom.\n            pad.zoom = if self.game { 0.0 } else { (is(Button::DPadDown) as i32 - is(Button::DPadUp) as i32) as f32 };\n            pad.a_held = is(Button::South);\n            pad.x_held = is(Button::West);\n            pad.y_held = is(Button::North);\n            pad.back_held = is(Button::Select);\n            if pad.left.length() > 0.3 || pad.right.length() > 0.3 || held != 0 {\n                pad.any_activity = true;\n            }\n        }\n        if pad.any_activity {\n            self.last_device = Device::Gamepad;\n        }\n        self.pad = pad;\n    }\n\n    /// Screen-space movement (x right, y up) from keys and stick, length <= 1.\n    pub fn move_axis(&self) -> Vec2 {\n        let k = |codes: &[KeyCode]| codes.iter().any(|c| self.keys.contains(c)) as i32 as f32;\n        let b = &self.bindings;\n        let kb = Vec2::new(k(&b.right) - k(&b.left), k(&b.up) - k(&b.down));\n        let v = if kb != Vec2::ZERO { kb.normalize() } else { self.pad.left };\n        v.clamp_length_max(1.0)\n    }\n\n    /// Held game buttons from all devices.\n    pub fn held(&self) -> u32 {\n        let mut b = self.pad.held;\n        for (bit, codes) in &self.bindings.buttons {\n            if codes.iter().any(|c| self.keys.contains(c)) {\n                b |= bit;\n            }\n        }\n        if self.mouse.contains(&MouseButton::Left) {\n            b |= buttons::PRIMARY;\n        }\n        if self.game && self.mouse.contains(&MouseButton::Right) {\n            b |= buttons::SECONDARY;\n        }\n        b\n    }\n\n    /// Returns (held, newly pressed since the last call).\n    pub fn buttons(&mut self) -> (u32, u32) {\n        let held = self.held();\n        let mut pressed = held & !self.prev_held;\n        for (bit, codes) in &self.bindings.buttons {\n            if codes.iter().any(|c| self.key_taps.contains(c)) {\n                pressed |= bit;\n            }\n        }\n        if self.mouse_taps.contains(&MouseButton::Left) {\n            pressed |= buttons::PRIMARY;\n        }\n        if self.game && self.mouse_taps.contains(&MouseButton::Right) {\n            pressed |= buttons::SECONDARY;\n        }\n        self.key_taps.clear();\n        self.mouse_taps.clear();\n        self.prev_held = held;\n        // A tap shorter than a frame still counts as held for that frame.\n        (held | pressed, pressed)\n    }\n\n    /// True if `b` was pressed since the last call (consumes the tap).\n    pub fn take_mouse_tap(&mut self, b: MouseButton) -> bool {\n        self.mouse_taps.remove(&b)\n    }\n\n    pub fn rewind_held(&self) -> bool {\n        self.keys.contains(&KeyCode::Backspace) || self.pad.back_held\n    }\n}\n\n#[cfg(test)]\nmod pad_script_tests {\n    use super::*;\n\n    #[test]\n    fn pad_scripts_parse_and_play() {\n        let mut p = PadScript::parse(\"# open the bag\\n2\\n1 tap=DPadDown\\n3 left=0.5,-1 hold=A,Y\\n\").unwrap();\n        assert_eq!(p.steps.len(), 3);\n        let frames: Vec<(PadStep, bool)> = std::iter::from_fn(|| p.next()).collect();\n        assert_eq!(frames.len(), 6);\n        assert!(frames[2].1 && frames[2].0.tap == vec![gilrs::Button::DPadDown]);\n        assert_eq!(frames[3].0.hold, vec![gilrs::Button::South, gilrs::Button::North]);\n        assert_eq!(frames[5].0.left, Vec2::new(0.5, -1.0));\n        assert!(PadScript::parse(\"x tap=A\").is_err());\n        assert!(PadScript::parse(\"1 tap=Q\").is_err());\n    }\n}\n","numLines":632,"startLine":1,"totalLines":632}},"tool_result_meta":[{"id":"toolu_01CBeSA3QiStZmTYgmFmEpwK","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjF9Z98fXBmRi7Rd5EL3","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01FpTUhLsSVGg1NGQVRJq68P","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953/engine/crates/pav_audio/src/lib.rs"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10666,"cache_read_input_tokens":54248,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10666},"output_tokens":21,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cb437ba7-0477-4143-bb04-ff33f49efd62","uuid":"98622294-98a6-4c77-bdb9-afb72e9455f3","timestamp":"2026-11-05T05:40:32.238Z","request_id":"req_011CgjF9Yp2qWnpJ3XWjZZBE","wire_tool_inputs":{"toolu_01FpTUhLsSVGg1NGQVRJq68P":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953/engine/crates/pav_audio/src/lib.rs"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FpTUhLsSVGg1NGQVRJq68P","type":"tool_result","content":"1\t//! Synthesized sound: every sound is built from oscillators, noise, envelopes, pitch sweeps\n2\t//! and a filter. The mixer runs in the audio callback (cpal) or offline (to .wav). The game\n3\t//! runs fine without a sound device.\n4\t\n5\tuse std::sync::mpsc::{Receiver, Sender, channel};\n6\t\n7\tuse glam::Vec3;\n8\tuse pav_core::SimEvent;\n9\t\n10\t#[derive(Clone, Copy, Debug, PartialEq)]\n11\tpub enum Wave {\n12\t    Sine,\n13\t    Square,\n14\t    Saw,\n15\t    Triangle,\n16\t    Noise,\n17\t}\n18\t\n19\t/// One synthesized sound.\n20\t#[derive(Clone, Copy, Debug)]\n21\tpub struct Patch {\n22\t    pub wave: Wave,\n23\t    /// Start / end frequency (Hz) and the glide time between them (s, exponential).\n24\t    pub freq: f32,\n25\t    pub freq_end: f32,\n26\t    pub glide: f32,\n27\t    pub attack: f32,\n28\t    pub decay: f32,\n29\t    pub sustain: f32,\n30\t    pub hold: f32,\n31\t    pub release: f32,\n32\t    pub volume: f32,\n33\t    /// One-pole low-pass cutoff (Hz) at start and end of the sound.\n34\t    pub cutoff: f32,\n35\t    pub cutoff_end: f32,\n36\t    /// Square-wave duty cycle.\n37\t    pub duty: f32,\n38\t}\n39\t\n40\timpl Patch {\n41\t    pub const fn new(wave: Wave, freq: f32) -> Self {\n42\t        Self {\n43\t            wave,\n44\t            freq,\n45\t            freq_end: freq,\n46\t            glide: 0.1,\n47\t            attack: 0.002,\n48\t            decay: 0.1,\n49\t            sustain: 0.0,\n50\t            hold: 0.0,\n51\t            release: 0.05,\n52\t            volume: 0.3,\n53\t            cutoff: 12000.0,\n54\t            cutoff_end: 12000.0,\n55\t            duty: 0.5,\n56\t        }\n57\t    }\n58\t    pub fn length(&self) -> f32 {\n59\t        self.attack + self.decay + self.hold + self.release\n60\t    }\n61\t}\n62\t\n63\tstruct Voice {\n64\t    p: Patch,\n65\t    t: f32,\n66\t    delay: f32,\n67\t    phase: f32,\n68\t    lp: f32,\n69\t    noise: u32,\n70\t    gain_l: f32,\n71\t    gain_r: f32,\n72\t}\n73\t\n74\timpl Voice {\n75\t    fn env(&self) -> f32 {\n76\t        let p = &self.p;\n77\t        let t = self.t;\n78\t        if t < p.attack {\n79\t            return t / p.attack.max(1e-5);\n80\t        }\n81\t        let t = t - p.attack;\n82\t        if t < p.decay {\n83\t            return 1.0 + (p.sustain - 1.0) * (t / p.decay.max(1e-5));\n84\t        }\n85\t        let t = t - p.decay;\n86\t        if t < p.hold {\n87\t            return p.sustain;\n88\t        }\n89\t        let t = t - p.hold;\n90\t        let start = if p.decay > 0.0 || p.hold > 0.0 { p.sustain } else { 1.0 };\n91\t        (start * (1.0 - t / p.release.max(1e-5))).max(0.0)\n92\t    }\n93\t\n94\t    fn done(&self) -> bool {\n95\t        self.t > self.p.length() + 0.01\n96\t    }\n97\t\n98\t    fn next(&mut self, dt: f32) -> f32 {\n99\t        if self.delay > 0.0 {\n100\t            self.delay -= dt;\n101\t            return 0.0;\n102\t        }\n103\t        let p = self.p;\n104\t        let k = (self.t / p.glide.max(1e-4)).min(1.0);\n105\t        let freq = p.freq * (p.freq_end / p.freq.max(1.0)).powf(k);\n106\t        self.phase = (self.phase + freq * dt).fract();\n107\t        let ph = self.phase;\n108\t        let raw = match p.wave {\n109\t            Wave::Sine => (ph * std::f32::consts::TAU).sin(),\n110\t            Wave::Square => {\n111\t                if ph < p.duty {\n112\t                    1.0\n113\t                } else {\n114\t                    -1.0\n115\t                }\n116\t            }\n117\t            Wave::Saw => ph * 2.0 - 1.0,\n118\t            Wave::Triangle => 1.0 - 4.0 * (ph - 0.5).abs(),\n119\t            Wave::Noise => {\n120\t                self.noise ^= self.noise << 13;\n121\t                self.noise ^= self.noise >> 17;\n122\t                self.noise ^= self.noise << 5;\n123\t                (self.noise as f32 / u32::MAX as f32) * 2.0 - 1.0\n124\t            }\n125\t        };\n126\t        let cutoff = p.cutoff * (p.cutoff_end / p.cutoff.max(1.0)).powf((self.t / p.length().max(1e-3)).min(1.0));\n127\t        let a = 1.0 - (-std::f32::consts::TAU * cutoff * dt).exp();\n128\t        self.lp += (raw - self.lp) * a;\n129\t        let s = self.lp * self.env() * p.volume;\n130\t        self.t += dt;\n131\t        s\n132\t    }\n133\t}\n134\t\n135\t/// Mixes voices into interleaved stereo.\n136\tpub struct Mixer {\n137\t    voices: Vec<Voice>,\n138\t    pub sample_rate: f32,\n139\t    pub master: f32,\n140\t    seed: u32,\n141\t}\n142\t\n143\tconst MAX_VOICES: usize = 64;\n144\t\n145\timpl Mixer {\n146\t    pub fn new(sample_rate: f32) -> Self {\n147\t        Self { voices: Vec::new(), sample_rate, master: 0.8, seed: 0x9e37_79b9 }\n148\t    }\n149\t\n150\t    /// pan -1 (left) .. 1 (right); delay in seconds.\n151\t    pub fn play(&mut self, p: Patch, pan: f32, gain: f32, delay: f32) {\n152\t        if self.voices.len() >= MAX_VOICES {\n153\t            // Drop the oldest.\n154\t            self.voices.remove(0);\n155\t        }\n156\t        self.seed = self.seed.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);\n157\t        let pan = pan.clamp(-1.0, 1.0);\n158\t        let a = (pan + 1.0) * std::f32::consts::FRAC_PI_4;\n159\t        self.voices.push(Voice {\n160\t            p,\n161\t            t: 0.0,\n162\t            delay,\n163\t            phase: 0.0,\n164\t            lp: 0.0,\n165\t            noise: self.seed | 1,\n166\t            gain_l: a.cos() * gain,\n167\t            gain_r: a.sin() * gain,\n168\t        });\n169\t    }\n170\t\n171\t    /// Renders into an interleaved stereo buffer (overwrites).\n172\t    pub fn render(&mut self, out: &mut [f32]) {\n173\t        let dt = 1.0 / self.sample_rate;\n174\t        for frame in out.chunks_mut(2) {\n175\t            let (mut l, mut r) = (0.0, 0.0);\n176\t            for v in &mut self.voices {\n177\t                let s = v.next(dt);\n178\t                l += s * v.gain_l;\n179\t                r += s * v.gain_r;\n180\t            }\n181\t            // Soft clip.\n182\t            let m = self.master;\n183\t            frame[0] = (l * m).tanh();\n184\t            if frame.len() > 1 {\n185\t                frame[1] = (r * m).tanh();\n186\t            }\n187\t        }\n188\t        self.voices.retain(|v| !v.done());\n189\t    }\n190\t\n191\t    pub fn active(&self) -> usize {\n192\t        self.voices.len()\n193\t    }\n194\t}\n195\t\n196\t/// Where the ears are: position and the camera's right vector (for panning).\n197\t#[derive(Clone, Copy, Debug)]\n198\tpub struct Listener {\n199\t    pub pos: Vec3,\n200\t    pub right: Vec3,\n201\t}\n202\t\n203\timpl Default for Listener {\n204\t    fn default() -> Self {\n205\t        Self { pos: Vec3::ZERO, right: Vec3::X }\n206\t    }\n207\t}\n208\t\n209\t/// The sound bank: which patches play for a simulation event.\n210\tpub fn sounds_for(ev: &SimEvent) -> Vec<(Patch, f32)> {\n211\t    use Wave::*;\n212\t    match ev {\n213\t        SimEvent::Jump { .. } => vec![(\n214\t            Patch {\n215\t                freq_end: 640.0,\n216\t                glide: 0.11,\n217\t                decay: 0.12,\n218\t                volume: 0.18,\n219\t                cutoff: 3500.0,\n220\t                cutoff_end: 2500.0,\n221\t                duty: 0.3,\n222\t                ..Patch::new(Square, 280.0)\n223\t            },\n224\t            0.0,\n225\t        )],\n226\t        SimEvent::Land { speed, .. } => {\n227\t            let v = (speed / 14.0).clamp(0.15, 1.0);\n228\t            vec![\n229\t                (Patch { decay: 0.12, volume: 0.35 * v, cutoff: 1100.0, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) }, 0.0),\n230\t                (Patch { freq_end: 45.0, glide: 0.1, decay: 0.14, volume: 0.45 * v, ..Patch::new(Sine, 110.0) }, 0.0),\n231\t            ]\n232\t        }\n233\t        SimEvent::Step { .. } => {\n234\t            vec![(Patch { decay: 0.045, volume: 0.07, cutoff: 1800.0, cutoff_end: 500.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n235\t        }\n236\t        SimEvent::Throw { .. } => vec![(\n237\t            Patch { attack: 0.03, decay: 0.16, volume: 0.1, cutoff: 900.0, cutoff_end: 4500.0, ..Patch::new(Noise, 1.0) },\n238\t            0.0,\n239\t        )],\n240\t        SimEvent::Explosion { radius, .. } => {\n241\t            let v = (radius / 1.35).clamp(0.5, 2.0);\n242\t            vec![\n243\t                (\n244\t                    Patch {\n245\t                        attack: 0.004,\n246\t                        decay: 0.25,\n247\t                        sustain: 0.35,\n248\t                        hold: 0.1,\n249\t                        release: 0.6,\n250\t                        volume: 0.6 * v,\n251\t                        cutoff: 4000.0,\n252\t                        cutoff_end: 120.0,\n253\t                        ..Patch::new(Noise, 1.0)\n254\t                    },\n255\t                    0.0,\n256\t                ),\n257\t                (Patch { freq_end: 28.0, glide: 0.5, decay: 0.7, volume: 0.7 * v, ..Patch::new(Sine, 85.0) }, 0.0),\n258\t            ]\n259\t        }\n260\t        SimEvent::EnterRoom { .. } => vec![\n261\t            (Patch { decay: 0.25, volume: 0.12, ..Patch::new(Triangle, 659.3) }, 0.0),\n262\t            (Patch { decay: 0.35, volume: 0.12, ..Patch::new(Triangle, 987.8) }, 0.09),\n263\t        ],\n264\t        SimEvent::Hit { strength, .. } => {\n265\t            let v = (strength / 8.0).clamp(0.4, 1.2);\n266\t            vec![\n267\t                (Patch { decay: 0.09, volume: 0.3 * v, cutoff: 2500.0, cutoff_end: 300.0, ..Patch::new(Noise, 1.0) }, 0.0),\n268\t                (\n269\t                    Patch { freq_end: 90.0, glide: 0.12, decay: 0.16, volume: 0.3 * v, duty: 0.4, ..Patch::new(Square, 220.0) },\n270\t                    0.0,\n271\t                ),\n272\t            ]\n273\t        }\n274\t        // Shardfall.\n275\t        SimEvent::Swing { heavy, .. } => {\n276\t            let h = if *heavy { 1.4 } else { 1.0 };\n277\t            vec![(\n278\t                Patch {\n279\t                    attack: 0.02,\n280\t                    decay: 0.12 * h,\n281\t                    volume: 0.16 * h,\n282\t                    cutoff: 1800.0,\n283\t                    cutoff_end: 5200.0,\n284\t                    ..Patch::new(Noise, 1.0)\n285\t                },\n286\t                0.0,\n287\t            )]\n288\t        }\n289\t        SimEvent::Strike { power, element, crit, .. } => {\n290\t            let v = (power.sqrt() / 4.0).clamp(0.35, 1.2) * if *crit { 1.3 } else { 1.0 };\n291\t            let tone = [150.0, 120.0, 520.0, 900.0, 260.0][(*element as usize).min(4)];\n292\t            let mut out = vec![\n293\t                (Patch { decay: 0.07, volume: 0.24 * v, cutoff: 3200.0, cutoff_end: 400.0, ..Patch::new(Noise, 1.0) }, 0.0),\n294\t                (\n295\t                    Patch {\n296\t                        freq_end: tone * 0.5,\n297\t                        glide: 0.08,\n298\t                        decay: 0.1,\n299\t                        volume: 0.2 * v,\n300\t                        duty: 0.35,\n301\t                        ..Patch::new(Square, tone)\n302\t                    },\n303\t                    0.0,\n304\t                ),\n305\t            ];\n306\t            if *crit {\n307\t                out.push((Patch { decay: 0.18, volume: 0.12, ..Patch::new(Triangle, 1760.0) }, 0.01));\n308\t            }\n309\t            out\n310\t        }\n311\t        SimEvent::Slain { size, .. } => {\n312\t            let k = size.clamp(0.3, 1.5);\n313\t            vec![\n314\t                (\n315\t                    Patch {\n316\t                        freq_end: 60.0,\n317\t                        glide: 0.3,\n318\t                        decay: 0.3,\n319\t                        volume: 0.22 * k,\n320\t                        duty: 0.5,\n321\t                        ..Patch::new(Square, 180.0 / k)\n322\t                    },\n323\t                    0.0,\n324\t                ),\n325\t                (Patch { decay: 0.25, volume: 0.15, cutoff: 1500.0, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) }, 0.02),\n326\t            ]\n327\t        }\n328\t        SimEvent::Slam { radius, .. } => {\n329\t            let k = (radius / 2.5).clamp(0.6, 1.5);\n330\t            vec![\n331\t                (Patch { freq_end: 40.0, glide: 0.35, decay: 0.4, volume: 0.45 * k, ..Patch::new(Sine, 110.0) }, 0.0),\n332\t                (Patch { decay: 0.3, volume: 0.3 * k, cutoff: 2200.0, cutoff_end: 150.0, ..Patch::new(Noise, 1.0) }, 0.0),\n333\t            ]\n334\t        }\n335\t        SimEvent::Blast { element, .. } => {\n336\t            let cut = [2500.0, 3500.0, 6000.0, 8000.0, 2000.0][(*element as usize).min(4)];\n337\t            vec![\n338\t                (\n339\t                    Patch { attack: 0.003, decay: 0.3, volume: 0.35, cutoff: cut, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) },\n340\t                    0.0,\n341\t                ),\n342\t                (Patch { freq_end: 50.0, glide: 0.25, decay: 0.3, volume: 0.25, ..Patch::new(Sine, 140.0) }, 0.0),\n343\t            ]\n344\t        }\n345\t        SimEvent::Spell { element, .. } => {\n346\t            let f = [300.0, 260.0, 900.0, 1400.0, 420.0][(*element as usize).min(4)];\n347\t            vec![(\n348\t                Patch {\n349\t                    freq_end: f * 1.8,\n350\t                    glide: 0.15,\n351\t                    attack: 0.02,\n352\t                    decay: 0.18,\n353\t                    volume: 0.12,\n354\t                    duty: 0.25,\n355\t                    ..Patch::new(Saw, f)\n356\t                },\n357\t                0.0,\n358\t            )]\n359\t        }\n360\t        SimEvent::Coin { .. } => vec![\n361\t            (Patch { decay: 0.08, volume: 0.1, ..Patch::new(Triangle, 1980.0) }, 0.0),\n362\t            (Patch { decay: 0.12, volume: 0.09, ..Patch::new(Triangle, 2640.0) }, 0.05),\n363\t        ],\n364\t        // Drops chime by rarity: rares ring, uniques ring a chord.\n365\t        SimEvent::Loot { rarity, .. } => match rarity {\n366\t            0 => vec![(Patch { decay: 0.05, volume: 0.05, cutoff: 2500.0, ..Patch::new(Triangle, 880.0) }, 0.0)],\n367\t            1 => vec![(Patch { decay: 0.12, volume: 0.08, ..Patch::new(Triangle, 1320.0) }, 0.0)],\n368\t            2 => vec![\n369\t                (Patch { decay: 0.25, volume: 0.12, ..Patch::new(Triangle, 1568.0) }, 0.0),\n370\t                (Patch { decay: 0.35, volume: 0.1, ..Patch::new(Sine, 2093.0) }, 0.08),\n371\t            ],\n372\t            _ => vec![\n373\t                (Patch { decay: 0.5, volume: 0.14, ..Patch::new(Triangle, 784.0) }, 0.0),\n374\t                (Patch { decay: 0.5, volume: 0.13, ..Patch::new(Triangle, 988.0) }, 0.06),\n375\t                (Patch { decay: 0.6, volume: 0.13, ..Patch::new(Triangle, 1175.0) }, 0.12),\n376\t                (Patch { decay: 0.9, volume: 0.12, ..Patch::new(Sine, 1568.0) }, 0.2),\n377\t            ],\n378\t        },\n379\t        SimEvent::Pickup { .. } => {\n380\t            vec![(Patch { freq_end: 1400.0, glide: 0.06, decay: 0.07, volume: 0.08, ..Patch::new(Triangle, 700.0) }, 0.0)]\n381\t        }\n382\t        SimEvent::Travel { .. } => vec![\n383\t            (Patch { freq_end: 1200.0, glide: 0.5, decay: 0.6, volume: 0.12, ..Patch::new(Sine, 200.0) }, 0.0),\n384\t            (Patch { freq_end: 2400.0, glide: 0.4, decay: 0.5, volume: 0.06, ..Patch::new(Triangle, 600.0) }, 0.1),\n385\t        ],\n386\t        SimEvent::Potion { .. } => {\n387\t            vec![(Patch { freq_end: 700.0, glide: 0.3, decay: 0.3, volume: 0.14, ..Patch::new(Sine, 300.0) }, 0.0)]\n388\t        }\n389\t        SimEvent::Block { .. } => {\n390\t            vec![(Patch { decay: 0.2, volume: 0.2, cutoff: 6000.0, cutoff_end: 3000.0, ..Patch::new(Square, 1200.0) }, 0.0)]\n391\t        }\n392\t        SimEvent::LevelUp { .. } => vec![\n393\t            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 523.0) }, 0.0),\n394\t            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 659.0) }, 0.1),\n395\t            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 784.0) }, 0.2),\n396\t            (Patch { decay: 0.5, volume: 0.18, ..Patch::new(Triangle, 1047.0) }, 0.3),\n397\t        ],\n398\t        SimEvent::Respawn { .. } => vec![\n399\t            (Patch { freq_end: 880.0, glide: 0.18, decay: 0.2, volume: 0.12, ..Patch::new(Sine, 220.0) }, 0.0),\n400\t            (Patch { decay: 0.15, volume: 0.08, ..Patch::new(Triangle, 1320.0) }, 0.16),\n401\t        ],\n402\t        SimEvent::CourseStart { .. } => vec![(Patch { decay: 0.12, volume: 0.14, ..Patch::new(Square, 880.0) }, 0.0)],\n403\t        SimEvent::Gate { ok, .. } => {\n404\t            if *ok {\n405\t                vec![(Patch { decay: 0.1, volume: 0.12, ..Patch::new(Triangle, 1046.5) }, 0.0)]\n406\t            } else {\n407\t                vec![(\n408\t                    Patch { freq_end: 160.0, glide: 0.2, decay: 0.25, volume: 0.14, duty: 0.3, ..Patch::new(Square, 330.0) },\n409\t                    0.0,\n410\t                )]\n411\t            }\n412\t        }\n413\t        SimEvent::CourseFinish { new_best, .. } => {\n414\t            let mut v = vec![\n415\t                (Patch { decay: 0.18, volume: 0.13, ..Patch::new(Triangle, 523.3) }, 0.0),\n416\t                (Patch { decay: 0.18, volume: 0.13, ..Patch::new(Triangle, 659.3) }, 0.1),\n417\t                (Patch { decay: 0.4, volume: 0.14, ..Patch::new(Triangle, 784.0) }, 0.2),\n418\t            ];\n419\t            if *new_best {\n420\t                v.push((Patch { decay: 0.5, volume: 0.13, ..Patch::new(Triangle, 1046.5) }, 0.34));\n421\t            }\n422\t            v\n423\t        }\n424\t        SimEvent::Checkpoint { .. } => vec![\n425\t            (Patch { decay: 0.12, volume: 0.1, ..Patch::new(Sine, 1174.7) }, 0.0),\n426\t            (Patch { decay: 0.2, volume: 0.1, ..Patch::new(Sine, 1568.0) }, 0.07),\n427\t        ],\n428\t        SimEvent::Splash { .. } => vec![(\n429\t            Patch { attack: 0.01, decay: 0.35, volume: 0.25, cutoff: 3000.0, cutoff_end: 400.0, ..Patch::new(Noise, 1.0) },\n430\t            0.0,\n431\t        )],\n432\t        SimEvent::Pad { .. } => {\n433\t            vec![(Patch { freq_end: 1200.0, glide: 0.08, decay: 0.12, volume: 0.1, ..Patch::new(Sine, 600.0) }, 0.0)]\n434\t        }\n435\t        SimEvent::Grab { .. } => {\n436\t            vec![(Patch { decay: 0.05, volume: 0.12, cutoff: 1500.0, cutoff_end: 600.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n437\t        }\n438\t        SimEvent::Break { .. } => vec![\n439\t            (Patch { decay: 0.18, volume: 0.3, cutoff: 6000.0, cutoff_end: 900.0, ..Patch::new(Noise, 1.0) }, 0.0),\n440\t            (Patch { freq_end: 70.0, glide: 0.15, decay: 0.2, volume: 0.25, ..Patch::new(Sine, 160.0) }, 0.0),\n441\t        ],\n442\t        SimEvent::Crack { .. } => {\n443\t            vec![(Patch { decay: 0.04, volume: 0.12, cutoff: 5000.0, cutoff_end: 2000.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n444\t        }\n445\t        SimEvent::Bounce { .. } => {\n446\t            vec![(Patch { freq_end: 900.0, glide: 0.18, decay: 0.22, volume: 0.16, ..Patch::new(Sine, 180.0) }, 0.0)]\n447\t        }\n448\t        SimEvent::Roll { .. } => vec![(\n449\t            Patch { attack: 0.02, decay: 0.2, volume: 0.1, cutoff: 600.0, cutoff_end: 2400.0, ..Patch::new(Noise, 1.0) },\n450\t            0.0,\n451\t        )],\n452\t        SimEvent::Spotted { .. } => vec![\n453\t            (Patch { decay: 0.18, volume: 0.16, ..Patch::new(Square, 990.0) }, 0.0),\n454\t            (Patch { decay: 0.25, volume: 0.16, ..Patch::new(Square, 660.0) }, 0.16),\n455\t        ],\n456\t        SimEvent::Shot { .. } => {\n457\t            vec![(Patch { freq_end: 420.0, glide: 0.06, decay: 0.06, volume: 0.05, ..Patch::new(Square, 1500.0) }, 0.0)]\n458\t        }\n459\t        SimEvent::Damage { .. } => {\n460\t            vec![(Patch { decay: 0.03, volume: 0.08, cutoff: 3500.0, cutoff_end: 1200.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n461\t        }\n462\t        SimEvent::Destroyed { size, .. } => {\n463\t            let v = size.clamp(0.4, 2.0);\n464\t            vec![\n465\t                (\n466\t                    Patch {\n467\t                        attack: 0.003,\n468\t                        decay: 0.3,\n469\t                        volume: 0.35 * v,\n470\t                        cutoff: 5000.0,\n471\t                        cutoff_end: 200.0,\n472\t                        ..Patch::new(Noise, 1.0)\n473\t                    },\n474\t                    0.0,\n475\t                ),\n476\t                (Patch { freq_end: 40.0, glide: 0.35, decay: 0.4, volume: 0.4 * v, ..Patch::new(Sine, 140.0) }, 0.0),\n477\t            ]\n478\t        }\n479\t        _ => Vec::new(),\n480\t    }\n481\t}\n482\t\n483\t/// Position of an event (None = not spatial).\n484\tpub fn event_pos(ev: &SimEvent) -> Option<Vec3> {\n485\t    match ev {\n486\t        SimEvent::Jump { pos }\n487\t        | SimEvent::Land { pos, .. }\n488\t        | SimEvent::Step { pos }\n489\t        | SimEvent::Throw { pos }\n490\t        | SimEvent::Explosion { pos, .. }\n491\t        | SimEvent::Impact { pos, .. }\n492\t        | SimEvent::Hit { pos, .. }\n493\t        | SimEvent::Splash { pos }\n494\t        | SimEvent::Grab { pos }\n495\t        | SimEvent::Roll { pos }\n496\t        | SimEvent::Break { pos }\n497\t        | SimEvent::Crack { pos }\n498\t        | SimEvent::Bounce { pos }\n499\t        | SimEvent::Shot { pos }\n500\t        | SimEvent::Damage { pos }\n501\t        | SimEvent::Destroyed { pos, .. }\n502\t        | SimEvent::Swing { pos, .. }\n503\t        | SimEvent::Strike { pos, .. }\n504\t        | SimEvent::Slain { pos, .. }\n505\t        | SimEvent::Slam { pos, .. }\n506\t        | SimEvent::Blast { pos, .. }\n507\t        | SimEvent::Spell { pos, .. }\n508\t        | SimEvent::Coin { pos }\n509\t        | SimEvent::Loot { pos, .. }\n510\t        | SimEvent::Pickup { pos, .. }\n511\t        | SimEvent::Block { pos } => Some(*pos),\n512\t        _ => None,\n513\t    }\n514\t}\n515\t\n516\t/// Plays an event's sounds with distance attenuation and panning.\n517\tpub fn play_event(mixer: &mut Mixer, ev: &SimEvent, l: &Listener, sfx: f32) {\n518\t    let (pan, gain) = match event_pos(ev) {\n519\t        Some(p) => {\n520\t            let d = p - l.pos;\n521\t            let dist = d.length();\n522\t            ((d.dot(l.right) / 12.0).clamp(-0.85, 0.85), 1.0 / (1.0 + dist / 14.0))\n523\t        }\n524\t        None => (0.0, 1.0),\n525\t    };\n526\t    for (patch, delay) in sounds_for(ev) {\n527\t        mixer.play(patch, pan, gain * sfx, delay);\n528\t    }\n529\t}\n530\t\n531\t/// Renders timed events offline: (time in seconds, event). Returns interleaved stereo.\n532\tpub fn render_events(events: &[(f32, SimEvent)], duration: f32, sample_rate: f32, l: &Listener) -> Vec<f32> {\n533\t    let mut mixer = Mixer::new(sample_rate);\n534\t    let total = (duration * sample_rate) as usize;\n535\t    let mut out = vec![0.0f32; total * 2];\n536\t    let block = 256;\n537\t    let mut i = 0;\n538\t    let mut ev = events.iter().peekable();\n539\t    while i < total {\n540\t        let t = i as f32 / sample_rate;\n541\t        while let Some((et, e)) = ev.peek() {\n542\t            if *et > t {\n543\t                break;\n544\t            }\n545\t            play_event(&mut mixer, e, l, 1.0);\n546\t            ev.next();\n547\t        }\n548\t        let n = block.min(total - i);\n549\t        mixer.render(&mut out[i * 2..(i + n) * 2]);\n550\t        i += n;\n551\t    }\n552\t    out\n553\t}\n554\t\n555\t/// Writes interleaved stereo f32 samples as a 16-bit PCM WAV file.\n556\tpub fn write_wav(path: &std::path::Path, samples: &[f32], sample_rate: u32) -> std::io::Result<()> {\n557\t    let data_len = (samples.len() * 2) as u32;\n558\t    let mut b = Vec::with_capacity(44 + data_len as usize);\n559\t    b.extend_from_slice(b\"RIFF\");\n560\t    b.extend_from_slice(&(36 + data_len).to_le_bytes());\n561\t    b.extend_from_slice(b\"WAVEfmt \");\n562\t    b.extend_from_slice(&16u32.to_le_bytes());\n563\t    b.extend_from_slice(&1u16.to_le_bytes()); // PCM\n564\t    b.extend_from_slice(&2u16.to_le_bytes()); // stereo\n565\t    b.extend_from_slice(&sample_rate.to_le_bytes());\n566\t    b.extend_from_slice(&(sample_rate * 4).to_le_bytes());\n567\t    b.extend_from_slice(&4u16.to_le_bytes());\n568\t    b.extend_from_slice(&16u16.to_le_bytes());\n569\t    b.extend_from_slice(b\"data\");\n570\t    b.extend_from_slice(&data_len.to_le_bytes());\n571\t    for s in samples {\n572\t        b.extend_from_slice(&((s.clamp(-1.0, 1.0) * 32767.0) as i16).to_le_bytes());\n573\t    }\n574\t    if let Some(d) = path.parent().filter(|d| !d.as_os_str().is_empty()) {\n575\t        std::fs::create_dir_all(d)?;\n576\t    }\n577\t    std::fs::write(path, b)\n578\t}\n579\t\n580\tenum Cmd {\n581\t    Play(Patch, f32, f32, f32),\n582\t    Master(f32),\n583\t}\n584\t\n585\t/// Live output through the default sound device.\n586\tpub struct AudioOut {\n587\t    _stream: cpal::Stream,\n588\t    tx: Sender<Cmd>,\n589\t    pub sample_rate: u32,\n590\t    pub device: String,\n591\t}\n592\t\n593\timpl AudioOut {\n594\t    pub fn start() -> anyhow::Result<Self> {\n595\t        use cpal::traits::{DeviceTrait, HostTrait, StreamTrait};\n596\t        let host = cpal::default_host();\n597\t        let device = host.default_output_device().ok_or_else(|| anyhow::anyhow!(\"no sound output device\"))?;\n598\t        let name = device.description().map(|d| d.to_string()).unwrap_or_else(|_| \"default\".into());\n599\t        let supported = device.default_output_config()?;\n600\t        let format = supported.sample_format();\n601\t        let config: cpal::StreamConfig = supported.config();\n602\t        let rate = config.sample_rate as u32;\n603\t        let channels = config.channels as usize;\n604\t        let (tx, rx) = channel::<Cmd>();\n605\t        let stream = match format {\n606\t            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels)?,\n607\t            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels)?,\n608\t            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels)?,\n609\t            other => anyhow::bail!(\"unsupported sample format {other:?}\"),\n610\t        };\n611\t        stream.play()?;\n612\t        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name })\n613\t    }\n614\t\n615\t    pub fn play_event(&self, ev: &SimEvent, l: &Listener, sfx: f32) {\n616\t        let (pan, gain) = match event_pos(ev) {\n617\t            Some(p) => {\n618\t                let d = p - l.pos;\n619\t                ((d.dot(l.right) / 12.0).clamp(-0.85, 0.85), 1.0 / (1.0 + d.length() / 14.0))\n620\t            }\n621\t            None => (0.0, 1.0),\n622\t        };\n623\t        for (patch, delay) in sounds_for(ev) {\n624\t            let _ = self.tx.send(Cmd::Play(patch, pan, gain * sfx, delay));\n625\t        }\n626\t    }\n627\t\n628\t    pub fn set_master(&self, v: f32) {\n629\t        let _ = self.tx.send(Cmd::Master(v));\n630\t    }\n631\t\n632\t    /// Starts output again. Browsers keep sound off until the page gets a click or key press,\n633\t    /// so the browser build calls this on the first input.\n634\t    pub fn resume(&self) {\n635\t        use cpal::traits::StreamTrait;\n636\t        let _ = self._stream.play();\n637\t    }\n638\t}\n639\t\n640\tfn build<T>(device: &cpal::Device, config: cpal::StreamConfig, rx: Receiver<Cmd>, channels: usize) -> anyhow::Result<cpal::Stream>\n641\twhere\n642\t    T: cpal::SizedSample + cpal::FromSample<f32>,\n643\t{\n644\t    use cpal::traits::DeviceTrait;\n645\t    let mut mixer = Mixer::new(config.sample_rate as f32);\n646\t    let mut buf: Vec<f32> = Vec::new();\n647\t    let stream = device.build_output_stream::<T, _, _>(\n648\t        config,\n649\t        move |data: &mut [T], _| {\n650\t            while let Ok(c) = rx.try_recv() {\n651\t                match c {\n652\t                    Cmd::Play(p, pan, gain, delay) => mixer.play(p, pan, gain, delay),\n653\t                    Cmd::Master(v) => mixer.master = v,\n654\t                }\n655\t            }\n656\t            let frames = data.len() / channels.max(1);\n657\t            buf.resize(frames * 2, 0.0);\n658\t            mixer.render(&mut buf);\n659\t            for (i, frame) in data.chunks_mut(channels.max(1)).enumerate() {\n660\t                for (c, s) in frame.iter_mut().enumerate() {\n661\t                    *s = T::from_sample(buf[i * 2 + c.min(1)]);\n662\t                }\n663\t            }\n664\t        },\n665\t        |e| log::warn!(\"audio stream error: {e}\"),\n666\t        None,\n667\t    )?;\n668\t    Ok(stream)\n669\t}\n670\t\n671\t#[cfg(test)]\n672\tmod tests {\n673\t    use super::*;\n674\t\n675\t    #[test]\n676\t    fn explosion_is_loud_then_silent() {\n677\t        let ev = SimEvent::Explosion { pos: Vec3::ZERO, radius: 1.35 };\n678\t        let out = render_events(&[(0.0, ev)], 2.0, 22050.0, &Listener::default());\n679\t        let peak_early = out[..22050].iter().fold(0.0f32, |m, s| m.max(s.abs()));\n680\t        let peak_late = out[out.len() - 2000..].iter().fold(0.0f32, |m, s| m.max(s.abs()));\n681\t        assert!(peak_early > 0.1, \"audible: {peak_early}\");\n682\t        assert!(peak_late < 1e-3, \"decays: {peak_late}\");\n683\t    }\n684\t}\n685\t"}]},"parent_tool_use_id":null,"session_id":"cb437ba7-0477-4143-bb04-ff33f49efd62","uuid":"a26901ba-447c-4f12-9d44-e8c24a3eb387","timestamp":"2026-11-05T05:40:32.458Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953/engine/crates/pav_audio/src/lib.rs","content":"//! Synthesized sound: every sound is built from oscillators, noise, envelopes, pitch sweeps\n//! and a filter. The mixer runs in the audio callback (cpal) or offline (to .wav). The game\n//! runs fine without a sound device.\n\nuse std::sync::mpsc::{Receiver, Sender, channel};\n\nuse glam::Vec3;\nuse pav_core::SimEvent;\n\n#[derive(Clone, Copy, Debug, PartialEq)]\npub enum Wave {\n    Sine,\n    Square,\n    Saw,\n    Triangle,\n    Noise,\n}\n\n/// One synthesized sound.\n#[derive(Clone, Copy, Debug)]\npub struct Patch {\n    pub wave: Wave,\n    /// Start / end frequency (Hz) and the glide time between them (s, exponential).\n    pub freq: f32,\n    pub freq_end: f32,\n    pub glide: f32,\n    pub attack: f32,\n    pub decay: f32,\n    pub sustain: f32,\n    pub hold: f32,\n    pub release: f32,\n    pub volume: f32,\n    /// One-pole low-pass cutoff (Hz) at start and end of the sound.\n    pub cutoff: f32,\n    pub cutoff_end: f32,\n    /// Square-wave duty cycle.\n    pub duty: f32,\n}\n\nimpl Patch {\n    pub const fn new(wave: Wave, freq: f32) -> Self {\n        Self {\n            wave,\n            freq,\n            freq_end: freq,\n            glide: 0.1,\n            attack: 0.002,\n            decay: 0.1,\n            sustain: 0.0,\n            hold: 0.0,\n            release: 0.05,\n            volume: 0.3,\n            cutoff: 12000.0,\n            cutoff_end: 12000.0,\n            duty: 0.5,\n        }\n    }\n    pub fn length(&self) -> f32 {\n        self.attack + self.decay + self.hold + self.release\n    }\n}\n\nstruct Voice {\n    p: Patch,\n    t: f32,\n    delay: f32,\n    phase: f32,\n    lp: f32,\n    noise: u32,\n    gain_l: f32,\n    gain_r: f32,\n}\n\nimpl Voice {\n    fn env(&self) -> f32 {\n        let p = &self.p;\n        let t = self.t;\n        if t < p.attack {\n            return t / p.attack.max(1e-5);\n        }\n        let t = t - p.attack;\n        if t < p.decay {\n            return 1.0 + (p.sustain - 1.0) * (t / p.decay.max(1e-5));\n        }\n        let t = t - p.decay;\n        if t < p.hold {\n            return p.sustain;\n        }\n        let t = t - p.hold;\n        let start = if p.decay > 0.0 || p.hold > 0.0 { p.sustain } else { 1.0 };\n        (start * (1.0 - t / p.release.max(1e-5))).max(0.0)\n    }\n\n    fn done(&self) -> bool {\n        self.t > self.p.length() + 0.01\n    }\n\n    fn next(&mut self, dt: f32) -> f32 {\n        if self.delay > 0.0 {\n            self.delay -= dt;\n            return 0.0;\n        }\n        let p = self.p;\n        let k = (self.t / p.glide.max(1e-4)).min(1.0);\n        let freq = p.freq * (p.freq_end / p.freq.max(1.0)).powf(k);\n        self.phase = (self.phase + freq * dt).fract();\n        let ph = self.phase;\n        let raw = match p.wave {\n            Wave::Sine => (ph * std::f32::consts::TAU).sin(),\n            Wave::Square => {\n                if ph < p.duty {\n                    1.0\n                } else {\n                    -1.0\n                }\n            }\n            Wave::Saw => ph * 2.0 - 1.0,\n            Wave::Triangle => 1.0 - 4.0 * (ph - 0.5).abs(),\n            Wave::Noise => {\n                self.noise ^= self.noise << 13;\n                self.noise ^= self.noise >> 17;\n                self.noise ^= self.noise << 5;\n                (self.noise as f32 / u32::MAX as f32) * 2.0 - 1.0\n            }\n        };\n        let cutoff = p.cutoff * (p.cutoff_end / p.cutoff.max(1.0)).powf((self.t / p.length().max(1e-3)).min(1.0));\n        let a = 1.0 - (-std::f32::consts::TAU * cutoff * dt).exp();\n        self.lp += (raw - self.lp) * a;\n        let s = self.lp * self.env() * p.volume;\n        self.t += dt;\n        s\n    }\n}\n\n/// Mixes voices into interleaved stereo.\npub struct Mixer {\n    voices: Vec<Voice>,\n    pub sample_rate: f32,\n    pub master: f32,\n    seed: u32,\n}\n\nconst MAX_VOICES: usize = 64;\n\nimpl Mixer {\n    pub fn new(sample_rate: f32) -> Self {\n        Self { voices: Vec::new(), sample_rate, master: 0.8, seed: 0x9e37_79b9 }\n    }\n\n    /// pan -1 (left) .. 1 (right); delay in seconds.\n    pub fn play(&mut self, p: Patch, pan: f32, gain: f32, delay: f32) {\n        if self.voices.len() >= MAX_VOICES {\n            // Drop the oldest.\n            self.voices.remove(0);\n        }\n        self.seed = self.seed.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);\n        let pan = pan.clamp(-1.0, 1.0);\n        let a = (pan + 1.0) * std::f32::consts::FRAC_PI_4;\n        self.voices.push(Voice {\n            p,\n            t: 0.0,\n            delay,\n            phase: 0.0,\n            lp: 0.0,\n            noise: self.seed | 1,\n            gain_l: a.cos() * gain,\n            gain_r: a.sin() * gain,\n        });\n    }\n\n    /// Renders into an interleaved stereo buffer (overwrites).\n    pub fn render(&mut self, out: &mut [f32]) {\n        let dt = 1.0 / self.sample_rate;\n        for frame in out.chunks_mut(2) {\n            let (mut l, mut r) = (0.0, 0.0);\n            for v in &mut self.voices {\n                let s = v.next(dt);\n                l += s * v.gain_l;\n                r += s * v.gain_r;\n            }\n            // Soft clip.\n            let m = self.master;\n            frame[0] = (l * m).tanh();\n            if frame.len() > 1 {\n                frame[1] = (r * m).tanh();\n            }\n        }\n        self.voices.retain(|v| !v.done());\n    }\n\n    pub fn active(&self) -> usize {\n        self.voices.len()\n    }\n}\n\n/// Where the ears are: position and the camera's right vector (for panning).\n#[derive(Clone, Copy, Debug)]\npub struct Listener {\n    pub pos: Vec3,\n    pub right: Vec3,\n}\n\nimpl Default for Listener {\n    fn default() -> Self {\n        Self { pos: Vec3::ZERO, right: Vec3::X }\n    }\n}\n\n/// The sound bank: which patches play for a simulation event.\npub fn sounds_for(ev: &SimEvent) -> Vec<(Patch, f32)> {\n    use Wave::*;\n    match ev {\n        SimEvent::Jump { .. } => vec![(\n            Patch {\n                freq_end: 640.0,\n                glide: 0.11,\n                decay: 0.12,\n                volume: 0.18,\n                cutoff: 3500.0,\n                cutoff_end: 2500.0,\n                duty: 0.3,\n                ..Patch::new(Square, 280.0)\n            },\n            0.0,\n        )],\n        SimEvent::Land { speed, .. } => {\n            let v = (speed / 14.0).clamp(0.15, 1.0);\n            vec![\n                (Patch { decay: 0.12, volume: 0.35 * v, cutoff: 1100.0, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) }, 0.0),\n                (Patch { freq_end: 45.0, glide: 0.1, decay: 0.14, volume: 0.45 * v, ..Patch::new(Sine, 110.0) }, 0.0),\n            ]\n        }\n        SimEvent::Step { .. } => {\n            vec![(Patch { decay: 0.045, volume: 0.07, cutoff: 1800.0, cutoff_end: 500.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n        }\n        SimEvent::Throw { .. } => vec![(\n            Patch { attack: 0.03, decay: 0.16, volume: 0.1, cutoff: 900.0, cutoff_end: 4500.0, ..Patch::new(Noise, 1.0) },\n            0.0,\n        )],\n        SimEvent::Explosion { radius, .. } => {\n            let v = (radius / 1.35).clamp(0.5, 2.0);\n            vec![\n                (\n                    Patch {\n                        attack: 0.004,\n                        decay: 0.25,\n                        sustain: 0.35,\n                        hold: 0.1,\n                        release: 0.6,\n                        volume: 0.6 * v,\n                        cutoff: 4000.0,\n                        cutoff_end: 120.0,\n                        ..Patch::new(Noise, 1.0)\n                    },\n                    0.0,\n                ),\n                (Patch { freq_end: 28.0, glide: 0.5, decay: 0.7, volume: 0.7 * v, ..Patch::new(Sine, 85.0) }, 0.0),\n            ]\n        }\n        SimEvent::EnterRoom { .. } => vec![\n            (Patch { decay: 0.25, volume: 0.12, ..Patch::new(Triangle, 659.3) }, 0.0),\n            (Patch { decay: 0.35, volume: 0.12, ..Patch::new(Triangle, 987.8) }, 0.09),\n        ],\n        SimEvent::Hit { strength, .. } => {\n            let v = (strength / 8.0).clamp(0.4, 1.2);\n            vec![\n                (Patch { decay: 0.09, volume: 0.3 * v, cutoff: 2500.0, cutoff_end: 300.0, ..Patch::new(Noise, 1.0) }, 0.0),\n                (\n                    Patch { freq_end: 90.0, glide: 0.12, decay: 0.16, volume: 0.3 * v, duty: 0.4, ..Patch::new(Square, 220.0) },\n                    0.0,\n                ),\n            ]\n        }\n        // Shardfall.\n        SimEvent::Swing { heavy, .. } => {\n            let h = if *heavy { 1.4 } else { 1.0 };\n            vec![(\n                Patch {\n                    attack: 0.02,\n                    decay: 0.12 * h,\n                    volume: 0.16 * h,\n                    cutoff: 1800.0,\n                    cutoff_end: 5200.0,\n                    ..Patch::new(Noise, 1.0)\n                },\n                0.0,\n            )]\n        }\n        SimEvent::Strike { power, element, crit, .. } => {\n            let v = (power.sqrt() / 4.0).clamp(0.35, 1.2) * if *crit { 1.3 } else { 1.0 };\n            let tone = [150.0, 120.0, 520.0, 900.0, 260.0][(*element as usize).min(4)];\n            let mut out = vec![\n                (Patch { decay: 0.07, volume: 0.24 * v, cutoff: 3200.0, cutoff_end: 400.0, ..Patch::new(Noise, 1.0) }, 0.0),\n                (\n                    Patch {\n                        freq_end: tone * 0.5,\n                        glide: 0.08,\n                        decay: 0.1,\n                        volume: 0.2 * v,\n                        duty: 0.35,\n                        ..Patch::new(Square, tone)\n                    },\n                    0.0,\n                ),\n            ];\n            if *crit {\n                out.push((Patch { decay: 0.18, volume: 0.12, ..Patch::new(Triangle, 1760.0) }, 0.01));\n            }\n            out\n        }\n        SimEvent::Slain { size, .. } => {\n            let k = size.clamp(0.3, 1.5);\n            vec![\n                (\n                    Patch {\n                        freq_end: 60.0,\n                        glide: 0.3,\n                        decay: 0.3,\n                        volume: 0.22 * k,\n                        duty: 0.5,\n                        ..Patch::new(Square, 180.0 / k)\n                    },\n                    0.0,\n                ),\n                (Patch { decay: 0.25, volume: 0.15, cutoff: 1500.0, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) }, 0.02),\n            ]\n        }\n        SimEvent::Slam { radius, .. } => {\n            let k = (radius / 2.5).clamp(0.6, 1.5);\n            vec![\n                (Patch { freq_end: 40.0, glide: 0.35, decay: 0.4, volume: 0.45 * k, ..Patch::new(Sine, 110.0) }, 0.0),\n                (Patch { decay: 0.3, volume: 0.3 * k, cutoff: 2200.0, cutoff_end: 150.0, ..Patch::new(Noise, 1.0) }, 0.0),\n            ]\n        }\n        SimEvent::Blast { element, .. } => {\n            let cut = [2500.0, 3500.0, 6000.0, 8000.0, 2000.0][(*element as usize).min(4)];\n            vec![\n                (\n                    Patch { attack: 0.003, decay: 0.3, volume: 0.35, cutoff: cut, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) },\n                    0.0,\n                ),\n                (Patch { freq_end: 50.0, glide: 0.25, decay: 0.3, volume: 0.25, ..Patch::new(Sine, 140.0) }, 0.0),\n            ]\n        }\n        SimEvent::Spell { element, .. } => {\n            let f = [300.0, 260.0, 900.0, 1400.0, 420.0][(*element as usize).min(4)];\n            vec![(\n                Patch {\n                    freq_end: f * 1.8,\n                    glide: 0.15,\n                    attack: 0.02,\n                    decay: 0.18,\n                    volume: 0.12,\n                    duty: 0.25,\n                    ..Patch::new(Saw, f)\n                },\n                0.0,\n            )]\n        }\n        SimEvent::Coin { .. } => vec![\n            (Patch { decay: 0.08, volume: 0.1, ..Patch::new(Triangle, 1980.0) }, 0.0),\n            (Patch { decay: 0.12, volume: 0.09, ..Patch::new(Triangle, 2640.0) }, 0.05),\n        ],\n        // Drops chime by rarity: rares ring, uniques ring a chord.\n        SimEvent::Loot { rarity, .. } => match rarity {\n            0 => vec![(Patch { decay: 0.05, volume: 0.05, cutoff: 2500.0, ..Patch::new(Triangle, 880.0) }, 0.0)],\n            1 => vec![(Patch { decay: 0.12, volume: 0.08, ..Patch::new(Triangle, 1320.0) }, 0.0)],\n            2 => vec![\n                (Patch { decay: 0.25, volume: 0.12, ..Patch::new(Triangle, 1568.0) }, 0.0),\n                (Patch { decay: 0.35, volume: 0.1, ..Patch::new(Sine, 2093.0) }, 0.08),\n            ],\n            _ => vec![\n                (Patch { decay: 0.5, volume: 0.14, ..Patch::new(Triangle, 784.0) }, 0.0),\n                (Patch { decay: 0.5, volume: 0.13, ..Patch::new(Triangle, 988.0) }, 0.06),\n                (Patch { decay: 0.6, volume: 0.13, ..Patch::new(Triangle, 1175.0) }, 0.12),\n                (Patch { decay: 0.9, volume: 0.12, ..Patch::new(Sine, 1568.0) }, 0.2),\n            ],\n        },\n        SimEvent::Pickup { .. } => {\n            vec![(Patch { freq_end: 1400.0, glide: 0.06, decay: 0.07, volume: 0.08, ..Patch::new(Triangle, 700.0) }, 0.0)]\n        }\n        SimEvent::Travel { .. } => vec![\n            (Patch { freq_end: 1200.0, glide: 0.5, decay: 0.6, volume: 0.12, ..Patch::new(Sine, 200.0) }, 0.0),\n            (Patch { freq_end: 2400.0, glide: 0.4, decay: 0.5, volume: 0.06, ..Patch::new(Triangle, 600.0) }, 0.1),\n        ],\n        SimEvent::Potion { .. } => {\n            vec![(Patch { freq_end: 700.0, glide: 0.3, decay: 0.3, volume: 0.14, ..Patch::new(Sine, 300.0) }, 0.0)]\n        }\n        SimEvent::Block { .. } => {\n            vec![(Patch { decay: 0.2, volume: 0.2, cutoff: 6000.0, cutoff_end: 3000.0, ..Patch::new(Square, 1200.0) }, 0.0)]\n        }\n        SimEvent::LevelUp { .. } => vec![\n            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 523.0) }, 0.0),\n            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 659.0) }, 0.1),\n            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 784.0) }, 0.2),\n            (Patch { decay: 0.5, volume: 0.18, ..Patch::new(Triangle, 1047.0) }, 0.3),\n        ],\n        SimEvent::Respawn { .. } => vec![\n            (Patch { freq_end: 880.0, glide: 0.18, decay: 0.2, volume: 0.12, ..Patch::new(Sine, 220.0) }, 0.0),\n            (Patch { decay: 0.15, volume: 0.08, ..Patch::new(Triangle, 1320.0) }, 0.16),\n        ],\n        SimEvent::CourseStart { .. } => vec![(Patch { decay: 0.12, volume: 0.14, ..Patch::new(Square, 880.0) }, 0.0)],\n        SimEvent::Gate { ok, .. } => {\n            if *ok {\n                vec![(Patch { decay: 0.1, volume: 0.12, ..Patch::new(Triangle, 1046.5) }, 0.0)]\n            } else {\n                vec![(\n                    Patch { freq_end: 160.0, glide: 0.2, decay: 0.25, volume: 0.14, duty: 0.3, ..Patch::new(Square, 330.0) },\n                    0.0,\n                )]\n            }\n        }\n        SimEvent::CourseFinish { new_best, .. } => {\n            let mut v = vec![\n                (Patch { decay: 0.18, volume: 0.13, ..Patch::new(Triangle, 523.3) }, 0.0),\n                (Patch { decay: 0.18, volume: 0.13, ..Patch::new(Triangle, 659.3) }, 0.1),\n                (Patch { decay: 0.4, volume: 0.14, ..Patch::new(Triangle, 784.0) }, 0.2),\n            ];\n            if *new_best {\n                v.push((Patch { decay: 0.5, volume: 0.13, ..Patch::new(Triangle, 1046.5) }, 0.34));\n            }\n            v\n        }\n        SimEvent::Checkpoint { .. } => vec![\n            (Patch { decay: 0.12, volume: 0.1, ..Patch::new(Sine, 1174.7) }, 0.0),\n            (Patch { decay: 0.2, volume: 0.1, ..Patch::new(Sine, 1568.0) }, 0.07),\n        ],\n        SimEvent::Splash { .. } => vec![(\n            Patch { attack: 0.01, decay: 0.35, volume: 0.25, cutoff: 3000.0, cutoff_end: 400.0, ..Patch::new(Noise, 1.0) },\n            0.0,\n        )],\n        SimEvent::Pad { .. } => {\n            vec![(Patch { freq_end: 1200.0, glide: 0.08, decay: 0.12, volume: 0.1, ..Patch::new(Sine, 600.0) }, 0.0)]\n        }\n        SimEvent::Grab { .. } => {\n            vec![(Patch { decay: 0.05, volume: 0.12, cutoff: 1500.0, cutoff_end: 600.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n        }\n        SimEvent::Break { .. } => vec![\n            (Patch { decay: 0.18, volume: 0.3, cutoff: 6000.0, cutoff_end: 900.0, ..Patch::new(Noise, 1.0) }, 0.0),\n            (Patch { freq_end: 70.0, glide: 0.15, decay: 0.2, volume: 0.25, ..Patch::new(Sine, 160.0) }, 0.0),\n        ],\n        SimEvent::Crack { .. } => {\n            vec![(Patch { decay: 0.04, volume: 0.12, cutoff: 5000.0, cutoff_end: 2000.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n        }\n        SimEvent::Bounce { .. } => {\n            vec![(Patch { freq_end: 900.0, glide: 0.18, decay: 0.22, volume: 0.16, ..Patch::new(Sine, 180.0) }, 0.0)]\n        }\n        SimEvent::Roll { .. } => vec![(\n            Patch { attack: 0.02, decay: 0.2, volume: 0.1, cutoff: 600.0, cutoff_end: 2400.0, ..Patch::new(Noise, 1.0) },\n            0.0,\n        )],\n        SimEvent::Spotted { .. } => vec![\n            (Patch { decay: 0.18, volume: 0.16, ..Patch::new(Square, 990.0) }, 0.0),\n            (Patch { decay: 0.25, volume: 0.16, ..Patch::new(Square, 660.0) }, 0.16),\n        ],\n        SimEvent::Shot { .. } => {\n            vec![(Patch { freq_end: 420.0, glide: 0.06, decay: 0.06, volume: 0.05, ..Patch::new(Square, 1500.0) }, 0.0)]\n        }\n        SimEvent::Damage { .. } => {\n            vec![(Patch { decay: 0.03, volume: 0.08, cutoff: 3500.0, cutoff_end: 1200.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n        }\n        SimEvent::Destroyed { size, .. } => {\n            let v = size.clamp(0.4, 2.0);\n            vec![\n                (\n                    Patch {\n                        attack: 0.003,\n                        decay: 0.3,\n                        volume: 0.35 * v,\n                        cutoff: 5000.0,\n                        cutoff_end: 200.0,\n                        ..Patch::new(Noise, 1.0)\n                    },\n                    0.0,\n                ),\n                (Patch { freq_end: 40.0, glide: 0.35, decay: 0.4, volume: 0.4 * v, ..Patch::new(Sine, 140.0) }, 0.0),\n            ]\n        }\n        _ => Vec::new(),\n    }\n}\n\n/// Position of an event (None = not spatial).\npub fn event_pos(ev: &SimEvent) -> Option<Vec3> {\n    match ev {\n        SimEvent::Jump { pos }\n        | SimEvent::Land { pos, .. }\n        | SimEvent::Step { pos }\n        | SimEvent::Throw { pos }\n        | SimEvent::Explosion { pos, .. }\n        | SimEvent::Impact { pos, .. }\n        | SimEvent::Hit { pos, .. }\n        | SimEvent::Splash { pos }\n        | SimEvent::Grab { pos }\n        | SimEvent::Roll { pos }\n        | SimEvent::Break { pos }\n        | SimEvent::Crack { pos }\n        | SimEvent::Bounce { pos }\n        | SimEvent::Shot { pos }\n        | SimEvent::Damage { pos }\n        | SimEvent::Destroyed { pos, .. }\n        | SimEvent::Swing { pos, .. }\n        | SimEvent::Strike { pos, .. }\n        | SimEvent::Slain { pos, .. }\n        | SimEvent::Slam { pos, .. }\n        | SimEvent::Blast { pos, .. }\n        | SimEvent::Spell { pos, .. }\n        | SimEvent::Coin { pos }\n        | SimEvent::Loot { pos, .. }\n        | SimEvent::Pickup { pos, .. }\n        | SimEvent::Block { pos } => Some(*pos),\n        _ => None,\n    }\n}\n\n/// Plays an event's sounds with distance attenuation and panning.\npub fn play_event(mixer: &mut Mixer, ev: &SimEvent, l: &Listener, sfx: f32) {\n    let (pan, gain) = match event_pos(ev) {\n        Some(p) => {\n            let d = p - l.pos;\n            let dist = d.length();\n            ((d.dot(l.right) / 12.0).clamp(-0.85, 0.85), 1.0 / (1.0 + dist / 14.0))\n        }\n        None => (0.0, 1.0),\n    };\n    for (patch, delay) in sounds_for(ev) {\n        mixer.play(patch, pan, gain * sfx, delay);\n    }\n}\n\n/// Renders timed events offline: (time in seconds, event). Returns interleaved stereo.\npub fn render_events(events: &[(f32, SimEvent)], duration: f32, sample_rate: f32, l: &Listener) -> Vec<f32> {\n    let mut mixer = Mixer::new(sample_rate);\n    let total = (duration * sample_rate) as usize;\n    let mut out = vec![0.0f32; total * 2];\n    let block = 256;\n    let mut i = 0;\n    let mut ev = events.iter().peekable();\n    while i < total {\n        let t = i as f32 / sample_rate;\n        while let Some((et, e)) = ev.peek() {\n            if *et > t {\n                break;\n            }\n            play_event(&mut mixer, e, l, 1.0);\n            ev.next();\n        }\n        let n = block.min(total - i);\n        mixer.render(&mut out[i * 2..(i + n) * 2]);\n        i += n;\n    }\n    out\n}\n\n/// Writes interleaved stereo f32 samples as a 16-bit PCM WAV file.\npub fn write_wav(path: &std::path::Path, samples: &[f32], sample_rate: u32) -> std::io::Result<()> {\n    let data_len = (samples.len() * 2) as u32;\n    let mut b = Vec::with_capacity(44 + data_len as usize);\n    b.extend_from_slice(b\"RIFF\");\n    b.extend_from_slice(&(36 + data_len).to_le_bytes());\n    b.extend_from_slice(b\"WAVEfmt \");\n    b.extend_from_slice(&16u32.to_le_bytes());\n    b.extend_from_slice(&1u16.to_le_bytes()); // PCM\n    b.extend_from_slice(&2u16.to_le_bytes()); // stereo\n    b.extend_from_slice(&sample_rate.to_le_bytes());\n    b.extend_from_slice(&(sample_rate * 4).to_le_bytes());\n    b.extend_from_slice(&4u16.to_le_bytes());\n    b.extend_from_slice(&16u16.to_le_bytes());\n    b.extend_from_slice(b\"data\");\n    b.extend_from_slice(&data_len.to_le_bytes());\n    for s in samples {\n        b.extend_from_slice(&((s.clamp(-1.0, 1.0) * 32767.0) as i16).to_le_bytes());\n    }\n    if let Some(d) = path.parent().filter(|d| !d.as_os_str().is_empty()) {\n        std::fs::create_dir_all(d)?;\n    }\n    std::fs::write(path, b)\n}\n\nenum Cmd {\n    Play(Patch, f32, f32, f32),\n    Master(f32),\n}\n\n/// Live output through the default sound device.\npub struct AudioOut {\n    _stream: cpal::Stream,\n    tx: Sender<Cmd>,\n    pub sample_rate: u32,\n    pub device: String,\n}\n\nimpl AudioOut {\n    pub fn start() -> anyhow::Result<Self> {\n        use cpal::traits::{DeviceTrait, HostTrait, StreamTrait};\n        let host = cpal::default_host();\n        let device = host.default_output_device().ok_or_else(|| anyhow::anyhow!(\"no sound output device\"))?;\n        let name = device.description().map(|d| d.to_string()).unwrap_or_else(|_| \"default\".into());\n        let supported = device.default_output_config()?;\n        let format = supported.sample_format();\n        let config: cpal::StreamConfig = supported.config();\n        let rate = config.sample_rate as u32;\n        let channels = config.channels as usize;\n        let (tx, rx) = channel::<Cmd>();\n        let stream = match format {\n            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels)?,\n            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels)?,\n            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels)?,\n            other => anyhow::bail!(\"unsupported sample format {other:?}\"),\n        };\n        stream.play()?;\n        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name })\n    }\n\n    pub fn play_event(&self, ev: &SimEvent, l: &Listener, sfx: f32) {\n        let (pan, gain) = match event_pos(ev) {\n            Some(p) => {\n                let d = p - l.pos;\n                ((d.dot(l.right) / 12.0).clamp(-0.85, 0.85), 1.0 / (1.0 + d.length() / 14.0))\n            }\n            None => (0.0, 1.0),\n        };\n        for (patch, delay) in sounds_for(ev) {\n            let _ = self.tx.send(Cmd::Play(patch, pan, gain * sfx, delay));\n        }\n    }\n\n    pub fn set_master(&self, v: f32) {\n        let _ = self.tx.send(Cmd::Master(v));\n    }\n\n    /// Starts output again. Browsers keep sound off until the page gets a click or key press,\n    /// so the browser build calls this on the first input.\n    pub fn resume(&self) {\n        use cpal::traits::StreamTrait;\n        let _ = self._stream.play();\n    }\n}\n\nfn build<T>(device: &cpal::Device, config: cpal::StreamConfig, rx: Receiver<Cmd>, channels: usize) -> anyhow::Result<cpal::Stream>\nwhere\n    T: cpal::SizedSample + cpal::FromSample<f32>,\n{\n    use cpal::traits::DeviceTrait;\n    let mut mixer = Mixer::new(config.sample_rate as f32);\n    let mut buf: Vec<f32> = Vec::new();\n    let stream = device.build_output_stream::<T, _, _>(\n        config,\n        move |data: &mut [T], _| {\n            while let Ok(c) = rx.try_recv() {\n                match c {\n                    Cmd::Play(p, pan, gain, delay) => mixer.play(p, pan, gain, delay),\n                    Cmd::Master(v) => mixer.master = v,\n                }\n            }\n            let frames = data.len() / channels.max(1);\n            buf.resize(frames * 2, 0.0);\n            mixer.render(&mut buf);\n            for (i, frame) in data.chunks_mut(channels.max(1)).enumerate() {\n                for (c, s) in frame.iter_mut().enumerate() {\n                    *s = T::from_sample(buf[i * 2 + c.min(1)]);\n                }\n            }\n        },\n        |e| log::warn!(\"audio stream error: {e}\"),\n        None,\n    )?;\n    Ok(stream)\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn explosion_is_loud_then_silent() {\n        let ev = SimEvent::Explosion { pos: Vec3::ZERO, radius: 1.35 };\n        let out = render_events(&[(0.0, ev)], 2.0, 22050.0, &Listener::default());\n        let peak_early = out[..22050].iter().fold(0.0f32, |m, s| m.max(s.abs()));\n        let peak_late = out[out.len() - 2000..].iter().fold(0.0f32, |m, s| m.max(s.abs()));\n        assert!(peak_early > 0.1, \"audible: {peak_early}\");\n        assert!(peak_late < 1e-3, \"decays: {peak_late}\");\n    }\n}\n","numLines":685,"startLine":1,"totalLines":685}},"tool_result_meta":[{"id":"toolu_01FpTUhLsSVGg1NGQVRJq68P","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
