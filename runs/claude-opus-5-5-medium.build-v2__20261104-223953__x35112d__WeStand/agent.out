{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Vf4niwLhCyDW3dfWyN5Xo9","type":"tool_result","content":"1\t//! The game window: owns graphics, UI, input, the simulation thread and the camera.\n2\t\n3\tuse std::sync::Arc;\n4\t\n5\tuse web_time::Instant;\n6\t\n7\tuse anyhow::{Result, anyhow};\n8\tuse glam::{Mat4, Quat, Vec2, Vec3};\n9\tuse pav_core::params::{ParamVisitor, Tunable, nested};\n10\tuse pav_core::prop_preview::StudioMode;\n11\tuse pav_core::{InputFrame, Sim, SimConfig};\n12\tuse pav_render::gpu::BackendChoice;\n13\tuse pav_render::scene::{MeshInstance, MeshKey, Style, flags as rflags};\n14\tuse pav_view::{CameraParams, CameraRig, ViewBuilder, ViewSettings};\n15\tuse winit::application::ApplicationHandler;\n16\tuse winit::event::{ElementState, MouseButton, MouseScrollDelta, WindowEvent};\n17\tuse winit::event_loop::{ActiveEventLoop, ControlFlow, EventLoop};\n18\tuse winit::keyboard::{KeyCode, PhysicalKey};\n19\tuse winit::window::{Fullscreen, Window, WindowId};\n20\t\n21\tuse crate::boot::{self, stage};\n22\tuse crate::edit::Editor;\n23\tuse crate::gfx::Gfx;\n24\tuse crate::hud::{CameraDirector, FeelOverlay, FeelSettings, HudCtx, Latency, LatencySample, PhysicsOverlay};\n25\tuse crate::input::{Device, Input};\n26\tuse crate::panel::{Panel, PanelAction};\n27\tuse crate::rooms::{RoomEntry, RoomHud, RoomWatcher, TeleportTarget};\n28\tuse crate::settings::Settings;\n29\tuse crate::simhost::SimHost;\n30\tuse crate::ui::{self, MenuAction};\n31\tuse crate::uiinput::UiInput;\n32\t\n33\t#[cfg(not(target_arch = \"wasm32\"))]\n34\tpub fn run(settings: Settings) -> Result<()> {\n35\t    let event_loop = stage(\"event loop\", || Ok((EventLoop::new()?, String::new())))?;\n36\t    event_loop.set_control_flow(ControlFlow::Poll);\n37\t    let mut app = App::new(settings);\n38\t    event_loop.run_app(&mut app)?;\n39\t    match app.fatal.take() {\n40\t        Some(e) => Err(anyhow!(e)),\n41\t        None => Ok(()),\n42\t    }\n43\t}\n44\t\n45\t/// In the browser the event loop runs from the page's animation frames; this returns at once.\n46\t#[cfg(target_arch = \"wasm32\")]\n47\tpub fn run(settings: Settings) -> Result<()> {\n48\t    use winit::platform::web::EventLoopExtWebSys;\n49\t    let event_loop = stage(\"event loop\", || Ok((EventLoop::new()?, String::new())))?;\n50\t    event_loop.set_control_flow(ControlFlow::Poll);\n51\t    event_loop.spawn_app(App::new(settings));\n52\t    Ok(())\n53\t}\n54\t\n55\t/// App-level tunables (the \"app\" group in the panel).\n56\t#[derive(Clone, Debug, PartialEq)]\n57\tpub struct AppSettings {\n58\t    pub vsync: bool,\n59\t    pub smoothing: bool,\n60\t    pub show_stats: bool,\n61\t    pub show_guide: bool,\n62\t    pub aim_marker: bool,\n63\t}\n64\t\n65\timpl Tunable for AppSettings {\n66\t    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n67\t        v.bool(\"vsync\", &mut self.vsync, \"Wait for the display refresh (off = lowest latency, may tear)\");\n68\t        v.bool(\"smoothing\", &mut self.smoothing, \"Interpolate between simulation ticks\");\n69\t        v.bool(\"show_stats\", &mut self.show_stats, \"FPS / tick overlay\");\n70\t        v.bool(\"show_guide\", &mut self.show_guide, \"Control guide overlay\");\n71\t        v.bool(\"aim_marker\", &mut self.aim_marker, \"Show where bombs will land\");\n72\t    }\n73\t}\n74\t\n75\t/// Sound settings (the \"audio\" group).\n76\t#[derive(Clone, Debug, PartialEq)]\n77\tpub struct AudioSettings {\n78\t    pub master: f32,\n79\t    pub sfx: f32,\n80\t    pub footsteps: bool,\n81\t}\n82\t\n83\timpl Tunable for AudioSettings {\n84\t    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n85\t        v.float(\"master\", &mut self.master, 0.0, 2.0, \"Master volume\");\n86\t        v.float(\"sfx\", &mut self.sfx, 0.0, 2.0, \"Sound effects volume\");\n87\t        v.bool(\"footsteps\", &mut self.footsteps, \"Footstep sounds\");\n88\t    }\n89\t}\n90\t\n91\tstruct Root<'a> {\n92\t    sim: &'a mut SimConfig,\n93\t    camera: &'a mut CameraParams,\n94\t    view: &'a mut ViewSettings,\n95\t    app: &'a mut AppSettings,\n96\t    audio: &'a mut AudioSettings,\n97\t}\n98\t\n99\timpl Tunable for Root<'_> {\n100\t    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n101\t        self.sim.visit_groups(v);\n102\t        nested(v, \"camera\", self.camera);\n103\t        nested(v, \"view\", self.view);\n104\t        nested(v, \"audio\", self.audio);\n105\t        nested(v, \"app\", self.app);\n106\t    }\n107\t}\n108\t\n109\t#[derive(Default)]\n110\tstruct Mouse {\n111\t    right_down: bool,\n112\t    pos: Vec2,\n113\t}\n114\t\n115\tstruct Fps {\n116\t    frames: u32,\n117\t    since: Instant,\n118\t    fps: f32,\n119\t    frame_ms: f32,\n120\t}\n121\t\n122\tpub struct App {\n123\t    settings: Settings,\n124\t    gfx: Option<Gfx>,\n125\t    egui_ctx: egui::Context,\n126\t    egui_state: Option<UiInput>,\n127\t    host: Option<SimHost>,\n128\t    rig: CameraRig,\n129\t    view: ViewSettings,\n130\t    /// View settings before the room's `[view]` table and pad overrides were applied, and\n131\t    /// which room / pad state they belong to.\n132\t    view_base: Option<ViewSettings>,\n133\t    view_key: (Option<u16>, u64),\n134\t    sim_config: SimConfig,\n135\t    app_settings: AppSettings,\n136\t    builder: ViewBuilder,\n137\t    input: Input,\n138\t    panel: Panel,\n139\t    menu_open: bool,\n140\t    paused_before_menu: bool,\n141\t    show_boot: bool,\n142\t    boot_done_at: Option<Instant>,\n143\t    started: Instant,\n144\t    last: Instant,\n145\t    fps: Fps,\n146\t    mouse: Mouse,\n147\t    screenshot_requested: bool,\n148\t    scene_name: String,\n149\t    toast: Option<(String, Instant)>,\n150\t    hud: RoomHud,\n151\t    watcher: Option<RoomWatcher>,\n152\t    editor: Editor,\n153\t    audio: Option<pav_audio::AudioOut>,\n154\t    audio_settings: AudioSettings,\n155\t    /// Tick at which the app last pushed its config (the sim's copy is adopted after that).\n156\t    config_push_tick: u64,\n157\t    latency: Latency,\n158\t    director: CameraDirector,\n159\t    feel: FeelOverlay,\n160\t    physics: PhysicsOverlay,\n161\t    quit: bool,\n162\t    /// Camera and look from before the game started (restored when leaving it).\n163\t    game_saved: Option<(CameraParams, ViewSettings)>,\n164\t    /// The Look & Filters window and the look layer over `view`.\n165\t    look_ui: crate::look_ui::LookUi,\n166\t    animation_ui: crate::animation_ui::AnimationUi,\n167\t    studio_mode: StudioMode,\n168\t    studio_navigation: bool,\n169\t    asset_ui: crate::asset_ui::AssetUi,\n170\t    asset_watcher: crate::asset_watch::AssetWatcher,\n171\t    creature_ui: crate::creature_ui::CreatureUi,\n172\t    creature_watcher: crate::creature_watch::CreatureWatcher,\n173\t    animation_watcher: Option<crate::animation_watch::AnimationWatcher>,\n174\t    animation_watch_attempted: bool,\n175\t    /// Station guide (H) and field guide.\n176\t    guide: crate::guide_ui::GuideUi,\n177\t    /// When the player last arrived somewhere new (another place, a teleport): the screen\n178\t    /// transition opens from then.\n179\t    arrival: Option<Instant>,\n180\t    /// Shardfall windows (inventory, vendor...), the latest game frame and the place whose\n181\t    /// look is applied.\n182\t    game_ui: crate::arpg_items::GameUi,\n183\t    /// When the hero was last saved.\n184\t    last_save: Instant,\n185\t    /// The gamepad's menu cursor (egui points) and the pointer events it makes this frame.\n186\t    pad_cursor: Option<Vec2>,\n187\t    pad_events: Vec<egui::Event>,\n188\t    pad_buttons: (bool, bool, bool),\n189\t    game_frame: Option<std::sync::Arc<pav_core::arpg::GameFrame>>,\n190\t    game_place: Option<pav_core::arpg::Place>,\n191\t    /// Phones and tablets: fingers, the on-screen controls and swipes (touch.rs).\n192\t    touch: crate::touch::Touch,\n193\t    /// The browser says this is a touch screen (or a finger has touched it).\n194\t    touch_screen: bool,\n195\t    /// The egui style has the touch sizes.\n196\t    touch_styled: bool,\n197\t    /// Touch screens draw at most 60 frames a second: when the next one is due.\n198\t    next_draw: Instant,\n199\t    /// Auto-attack, graphics quality, tips seen (saved).\n200\t    prefs: crate::save::Prefs,\n201\t    scaler: crate::quality::Scaler,\n202\t    #[cfg(not(target_arch = \"wasm32\"))]\n203\t    bridge: Option<crate::bridge::Bridge>,\n204\t    #[cfg(target_arch = \"wasm32\")]\n205\t    pending_gfx: Option<std::rc::Rc<std::cell::RefCell<Option<Result<Gfx>>>>>,\n206\t    #[cfg(target_arch = \"wasm32\")]\n207\t    audio_resumed: bool,\n208\t    init_started: bool,\n209\t    pub fatal: Option<String>,\n210\t}\n211\t\n212\timpl App {\n213\t    fn new(settings: Settings) -> Self {\n214\t        let scene_name = settings.scene.clone();\n215\t        let touch_screen = crate::platform::touch_screen();\n216\t        let mut app = Self {\n217\t            gfx: None,\n218\t            egui_ctx: egui::Context::default(),\n219\t            egui_state: None,\n220\t            host: None,\n221\t            rig: CameraRig::default(),\n222\t            view: ViewSettings::default(),\n223\t            view_base: None,\n224\t            view_key: (None, 0),\n225\t            sim_config: SimConfig::default(),\n226\t            app_settings: AppSettings {\n227\t                vsync: settings.vsync,\n228\t                smoothing: true,\n229\t                show_stats: true,\n230\t                show_guide: true,\n231\t                aim_marker: true,\n232\t            },\n233\t            builder: ViewBuilder::new(),\n234\t            input: Input::new(),\n235\t            panel: Panel::new(),\n236\t            menu_open: false,\n237\t            paused_before_menu: false,\n238\t            show_boot: true,\n239\t            boot_done_at: None,\n240\t            started: Instant::now(),\n241\t            last: Instant::now(),\n242\t            fps: Fps { frames: 0, since: Instant::now(), fps: 0.0, frame_ms: 0.0 },\n243\t            mouse: Mouse::default(),\n244\t            screenshot_requested: false,\n245\t            scene_name,\n246\t            toast: None,\n247\t            hud: RoomHud::default(),\n248\t            watcher: None,\n249\t            editor: Editor::default(),\n250\t            audio: None,\n251\t            audio_settings: AudioSettings { master: 0.8, sfx: 1.0, footsteps: true },\n252\t            config_push_tick: 0,\n253\t            latency: Latency::default(),\n254\t            director: CameraDirector::default(),\n255\t            feel: FeelOverlay::default(),\n256\t            physics: PhysicsOverlay::default(),\n257\t            quit: false,\n258\t            game_saved: None,\n259\t            look_ui: crate::look_ui::LookUi::load(),\n260\t            animation_ui: crate::animation_ui::AnimationUi::new(settings.animation_studio),\n261\t            studio_mode: StudioMode::World,\n262\t            studio_navigation: settings.animation_studio || settings.asset_studio || settings.creature_studio,\n263\t            asset_ui: crate::asset_ui::AssetUi::new(settings.asset_studio),\n264\t            asset_watcher: crate::asset_watch::AssetWatcher::new(),\n265\t            creature_ui: crate::creature_ui::CreatureUi::new(settings.creature_studio),\n266\t            creature_watcher: crate::creature_watch::CreatureWatcher::new(),\n267\t            animation_watcher: None,\n268\t            animation_watch_attempted: false,\n269\t            guide: Default::default(),\n270\t            arrival: None,\n271\t            game_ui: Default::default(),\n272\t            last_save: Instant::now(),\n273\t            pad_cursor: None,\n274\t            pad_events: Vec::new(),\n275\t            pad_buttons: (false, false, false),\n276\t            game_frame: None,\n277\t            game_place: None,\n278\t            touch: Default::default(),\n279\t            touch_screen,\n280\t            touch_styled: false,\n281\t            next_draw: Instant::now(),\n282\t            prefs: crate::save::load_prefs(),\n283\t            scaler: Default::default(),\n284\t            #[cfg(not(target_arch = \"wasm32\"))]\n285\t            bridge: None,\n286\t            #[cfg(target_arch = \"wasm32\")]\n287\t            pending_gfx: None,\n288\t            #[cfg(target_arch = \"wasm32\")]\n289\t            audio_resumed: false,\n290\t            init_started: false,\n291\t            fatal: None,\n292\t            settings,\n293\t        };\n294\t        if touch_screen {\n295\t            // Phones: touch controls from the start, none of the desktop's diagnostics.\n296\t            app.input.last_device = Device::Touch;\n297\t            app.show_boot = false;\n298\t            app.app_settings.show_stats = false;\n299\t        }\n300\t        app\n301\t    }\n302\t\n303\t    /// A finger on the screen: the touch layer decides whether it is the stick, a control, a\n304\t    /// swipe or egui's (and then egui gets the event).\n305\t    fn on_touch(&mut self, t: &winit::event::Touch, event: &WindowEvent) {\n306\t        #[cfg(target_arch = \"wasm32\")]\n307\t        self.resume_audio();\n308\t        let Some(g) = &self.gfx else { return };\n309\t        let ppp = self.egui_ctx.zoom_factor() * g.window.scale_factor() as f32;\n310\t        let pos = egui::pos2(t.location.x as f32 / ppp, t.location.y as f32 / ppp);\n311\t        self.input.last_device = Device::Touch;\n312\t        self.touch_screen = true;\n313\t        use winit::event::TouchPhase as P;\n314\t        let to_egui = match t.phase {\n315\t            P::Started => {\n316\t                // (The root layer is everywhere; only windows and labels over the game count.)\n317\t                let under = self.egui_ctx.layer_id_at(pos).filter(|l| *l != egui::LayerId::background()).map(|l| l.order);\n318\t                self.touch.down(t.id, pos, under)\n319\t            }\n320\t            P::Moved => self.touch.moved(t.id, pos),\n321\t            P::Ended => self.touch.up(t.id, pos, false),\n322\t            P::Cancelled => self.touch.up(t.id, pos, true),\n323\t        };\n324\t        if to_egui {\n325\t            if let (Some(st), Some(g)) = (&mut self.egui_state, &self.gfx) {\n326\t                st.on_window_event(&g.window, event);\n327\t            }\n328\t        }\n329\t    }\n330\t\n331\t    /// A tap on the open game closes what is open over it, one thing at a time.\n332\t    fn close_on_tap(&mut self) {\n333\t        if self.menu_open {\n334\t            self.set_menu(false);\n335\t        } else if self.game_ui.any_open() {\n336\t            self.game_ui.close_all();\n337\t        } else if self.game_ui.map {\n338\t            self.game_ui.map = false;\n339\t        } else if self.look_ui.open {\n340\t            self.look_ui.open = false;\n341\t            self.look_ui.save_if_dirty(true);\n342\t        } else if self.guide.station || self.guide.field {\n343\t            self.guide.station = false;\n344\t            self.guide.field = false;\n345\t        } else if self.hud.teleport_open {\n346\t            self.hud.teleport_open = false;\n347\t        } else if self.hud.card_visible() {\n348\t            self.hud.hide_card();\n349\t        }\n350\t    }\n351\t\n352\t    fn init(&mut self, el: &ActiveEventLoop) -> Result<()> {\n353\t        let s = self.settings.clone();\n354\t        let window = stage(\"window\", || {\n355\t            let mut attrs = Window::default_attributes().with_title(\"Shardfall\");\n356\t            #[cfg(not(target_arch = \"wasm32\"))]\n357\t            {\n358\t                attrs = attrs.with_inner_size(winit::dpi::LogicalSize::new(s.width, s.height));\n359\t            }\n360\t            // In the browser the window is a canvas filling the page (sized by the page's CSS).\n361\t            #[cfg(target_arch = \"wasm32\")]\n362\t            {\n363\t                use winit::platform::web::WindowAttributesExtWebSys;\n364\t                attrs = attrs.with_append(true);\n365\t            }\n366\t            if s.fullscreen {\n367\t                attrs = attrs.with_fullscreen(Some(Fullscreen::Borderless(None)));\n368\t            }\n369\t            let w = Arc::new(el.create_window(attrs)?);\n370\t            let sz = w.inner_size();\n371\t            let d = format!(\"{}x{} px, scale {:.2}\", sz.width, sz.height, w.scale_factor());\n372\t            Ok((w, d))\n373\t        })?;\n374\t        let backend = BackendChoice::parse(&s.backend)\n375\t            .ok_or_else(|| anyhow!(\"unknown backend '{}' in settings (use vulkan or dx12)\", s.backend))?;\n376\t        #[cfg(not(target_arch = \"wasm32\"))]\n377\t        {\n378\t            let gfx = Gfx::new(window, backend, s.vsync)?;\n379\t            self.finish_init(gfx)\n380\t        }\n381\t        // The browser hands out the GPU asynchronously: `about_to_wait` finishes the start.\n382\t        #[cfg(target_arch = \"wasm32\")]\n383\t        {\n384\t            let slot = std::rc::Rc::new(std::cell::RefCell::new(None));\n385\t            let fill = slot.clone();\n386\t            wasm_bindgen_futures::spawn_local(async move {\n387\t                *fill.borrow_mut() = Some(Gfx::create(window, backend, s.vsync).await);\n388\t            });\n389\t            self.pending_gfx = Some(slot);\n390\t            Ok(())\n391\t        }\n392\t    }\n393\t\n394\t    /// The rest of the start, once graphics exist.\n395\t    fn finish_init(&mut self, gfx: Gfx) -> Result<()> {\n396\t        let s = self.settings.clone();\n397\t        let window = gfx.window.clone();\n398\t        let egui_state = stage(\"ui\", || {\n399\t            let st = UiInput::new(&self.egui_ctx, &window, gfx.device.limits().max_texture_dimension_2d as usize);\n400\t            Ok((st, String::new()))\n401\t        })?;\n402\t        self.audio = stage(\"audio\", || match pav_audio::AudioOut::start() {\n403\t            Ok(a) => {\n404\t                let d = format!(\"{} @ {} Hz\", a.device, a.sample_rate);\n405\t                Ok((Some(a), d))\n406\t            }\n407\t            Err(e) => Ok((None, format!(\"no sound ({e}); continuing silently\"))),\n408\t        })?;\n409\t        // Rooms can name saved objects. Load the library before constructing the scene, and\n410\t        // the workshop materials before the objects that wear them.\n411\t        #[cfg(not(target_arch = \"wasm32\"))]\n412\t        if let Err(error) = pav_tools::material_tools::initialize_authored() {\n413\t            self.asset_ui.report(Err(format!(\"Could not load saved materials: {error:#}\")));\n414\t        }\n415\t        #[cfg(not(target_arch = \"wasm32\"))]\n416\t        if let Err(error) = pav_tools::asset_tools::initialize_authored() {\n417\t            self.asset_ui.report(Err(format!(\"Could not load saved objects: {error:#}\")));\n418\t        }\n419\t        #[cfg(not(target_arch = \"wasm32\"))]\n420\t        if let Err(error) = pav_tools::creature_tools::initialize_authored() {\n421\t            self.creature_ui.report(Err(format!(\"Could not load saved creatures: {error:#}\")));\n422\t        }\n423\t        let mut sim = stage(\"simulation\", || {\n424\t            let mut sim = Sim::new(&s.scene, s.seed)?;\n425\t            let mut d = format!(\n426\t                \"scene '{}', seed {}, {} entities, {} blocks\",\n427\t                s.scene,\n428\t                s.seed,\n429\t                sim.state.entities.len(),\n430\t                sim.state.statics.block_count()\n431\t            );\n432\t            if let Some(level) = crate::save::restore_into(&mut sim) {\n433\t                d += &format!(\", saved hero (level {level})\");\n434\t            }\n435\t            Ok((sim, d))\n436\t        })?;\n437\t        if s.animation_studio {\n438\t            // Read authored sets before selecting a clip. Keep the embedded library if a\n439\t            // file is invalid, so the studio can still open and report the error.\n440\t            #[cfg(not(target_arch = \"wasm32\"))]\n441\t            {\n442\t                let _ = pav_core::clips::library();\n443\t                if pav_core::anim::disk_dir().is_some() {\n444\t                    if let Err(e) = pav_core::anim::reload(true) {\n445\t                        self.animation_ui.report(Err(e));\n446\t                    }\n447\t                }\n448\t                if let Err(e) = pav_tools::animation_tools::reload_authored() {\n449\t                    self.animation_ui.report(Err(format!(\"{e:#}\")));\n450\t                }\n451\t            }\n452\t            let name = if s.animation_clip.is_empty() { \"QUATERNIUS/Idle_Loop\" } else { &s.animation_clip };\n453\t            let mut session = pav_tools::Session::from_live(sim, self.rig.clone(), self.view.clone(), None);\n454\t            let args = serde_json::json!({\"clip\":name}).as_object().unwrap().clone();\n455\t            pav_tools::preview_tools::t_anim_preview(&mut session, &args)?;\n456\t            let (live, rig, view, _) = session.into_live();\n457\t            sim = live;\n458\t            self.rig = rig;\n459\t            self.view = view;\n460\t            self.show_boot = false;\n461\t            self.app_settings.show_stats = false;\n462\t            self.app_settings.show_guide = false;\n463\t        }\n464\t        if s.asset_studio {\n465\t            let name = if s.asset_name.is_empty() { \"BUILTIN/bench\" } else { &s.asset_name };\n466\t            let mut session = pav_tools::Session::from_live(sim, self.rig.clone(), self.view.clone(), None);\n467\t            let args = serde_json::json!({\"name\":name}).as_object().unwrap().clone();\n468\t            pav_tools::asset_preview_tools::t_asset_preview(&mut session, &args)?;\n469\t            let (live, rig, view, _) = session.into_live();\n470\t            sim = live;\n471\t            self.rig = rig;\n472\t            self.view = view;\n473\t            self.show_boot = false;\n474\t            self.app_settings.show_stats = false;\n475\t            self.app_settings.show_guide = false;\n476\t        }\n477\t        if s.creature_studio {\n478\t            let mut session = pav_tools::Session::from_live(sim, self.rig.clone(), self.view.clone(), None);\n479\t            let mut args = serde_json::json!({\"action\":\"open\"}).as_object().unwrap().clone();\n480\t            if !s.creature_name.is_empty() {\n481\t                args.insert(\"name\".into(), serde_json::json!(s.creature_name));\n482\t            }\n483\t            let result = pav_tools::creature_preview_tools::t_creature_preview(&mut session, &args)\n484\t                .map(|output| match output {\n485\t                    pav_tools::Output::Json(v) => v,\n486\t                    pav_tools::Output::Image { meta, .. } => meta,\n487\t                })\n488\t                .map_err(|error| format!(\"{error:#}\"));\n489\t            self.creature_ui.report(result);\n490\t            let (live, rig, view, _) = session.into_live();\n491\t            sim = live;\n492\t            self.rig = rig;\n493\t            self.view = view;\n494\t            self.show_boot = false;\n495\t            self.app_settings.show_stats = false;\n496\t            self.app_settings.show_guide = false;\n497\t        }\n498\t        self.sim_config = sim.config.clone();\n499\t        self.rig.snap(sim.frame().focus);\n500\t        self.hud.entries = room_entries(&sim);\n501\t        self.hud.errors = sim.state.world.errors.clone();\n502\t        self.watcher = RoomWatcher::start();\n503\t        self.animation_watch_attempted = crate::animation_watch::AnimationWatcher::directory_exists();\n504\t        if self.animation_watch_attempted {\n505\t            self.animation_watcher = crate::animation_watch::AnimationWatcher::start();\n506\t        }\n507\t        #[cfg(not(target_arch = \"wasm32\"))]\n508\t        if !s.pad_script.is_empty() {\n509\t            match std::fs::read_to_string(&s.pad_script)\n510\t                .map_err(|e| e.to_string())\n511\t                .and_then(|t| crate::input::PadScript::parse(&t))\n512\t            {\n513\t                Ok(p) => {\n514\t                    log::info!(\"pad script: {} steps from {}\", p.steps.len(), s.pad_script);\n515\t                    self.input.pad_script = Some(p);\n516\t                }\n517\t                Err(e) => log::error!(\"pad script {}: {e}\", s.pad_script),\n518\t            }\n519\t        }\n520\t        #[cfg(not(target_arch = \"wasm32\"))]\n521\t        if !s.bridge.is_empty() {\n522\t            self.bridge = stage(\"agent bridge\", || match crate::bridge::Bridge::start(&s.bridge) {\n523\t                Ok(b) => {\n524\t                    let d = format!(\"listening on {}\", b.addr);\n525\t                    Ok((Some(b), d))\n526\t                }\n527\t                Err(e) => Ok((None, format!(\"could not listen on {} ({e}); continuing without it\", s.bridge))),\n528\t            })?;\n529\t        }\n530\t        self.host = Some(SimHost::start(sim));\n531\t        self.gfx = Some(gfx);\n532\t        self.egui_state = Some(egui_state);\n533\t        Ok(())\n534\t    }\n535\t\n536\t    /// Whether the gamepad drives a menu cursor now (a game window or the pause menu is open).\n537\t    fn pad_ui_active(&self) -> bool {\n538\t        self.input.last_device == Device::Gamepad\n539\t            && (self.menu_open || self.game_ui.any_open() || self.look_ui.open || self.guide.station || self.guide.field)\n540\t    }\n541\t\n542\t    /// Gamepad in menus: D-pad down opens the hero's panels (LB / RB switch them), B closes;\n543\t    /// while a window is open the left stick (or D-pad) moves a cursor, A and X click left and\n544\t    /// right, the right stick scrolls, and the game gets no pad input.\n545\t    fn pad_menus(&mut self, dt: f32) {\n546\t        use gilrs::Button as B;\n547\t        let taps = std::mem::take(&mut self.input.pad.taps);\n548\t        let game = self.game_frame.is_some();\n549\t        if self.input.last_device != Device::Gamepad {\n550\t            self.pad_cursor = None;\n551\t            return;\n552\t        }\n553\t        let ui = &mut self.game_ui;\n554\t        if game && !self.menu_open && taps.contains(&B::DPadDown) && !ui.any_open() {\n555\t            ui.inventory = true;\n556\t            return;\n557\t        }\n558\t        if !self.pad_ui_active() {\n559\t            self.pad_cursor = None;\n560\t            if self.pad_buttons.2 {\n561\t                self.pad_events.push(egui::Event::ModifiersChanged(Default::default()));\n562\t            }\n563\t            self.pad_buttons = (false, false, false);\n564\t            return;\n565\t        }\n566\t        let ui = &mut self.game_ui;\n567\t        // Switch between the hero's panels.\n568\t        let cycle = taps.contains(&B::RightTrigger) as i32 - taps.contains(&B::LeftTrigger) as i32;\n569\t        if cycle != 0 && game && !self.menu_open {\n570\t            let now = [ui.inventory, ui.character, ui.skills, ui.tree.open].iter().position(|x| *x).unwrap_or(0) as i32;\n571\t            let next = (now + cycle).rem_euclid(4);\n572\t            ui.inventory = next == 0;\n573\t            ui.character = next == 1;\n574\t            ui.skills = next == 2;\n575\t            ui.tree.open = next == 3;\n576\t        }\n577\t        if taps.contains(&B::East) {\n578\t            if ui.any_open() {\n579\t                ui.close_all();\n580\t            } else if self.look_ui.open && !self.menu_open {\n581\t                self.look_ui.open = false;\n582\t                self.look_ui.save_if_dirty(true);\n583\t            } else if (self.guide.station || self.guide.field) && !self.menu_open {\n584\t                self.guide.station = false;\n585\t                self.guide.field = false;\n586\t            } else {\n587\t                self.set_menu(false);\n588\t            }\n589\t        }\n590\t        // The cursor.\n591\t        let screen = self.egui_ctx.content_rect();\n592\t        let mut p = self.pad_cursor.unwrap_or(Vec2::new(screen.center().x, screen.center().y));\n593\t        let stick = self.input.pad.left;\n594\t        let speed = 260.0 + 900.0 * stick.length().powi(2);\n595\t        p += Vec2::new(stick.x, -stick.y) * speed * dt;\n596\t        for (b, d) in [(B::DPadLeft, Vec2::NEG_X), (B::DPadRight, Vec2::X), (B::DPadUp, Vec2::NEG_Y), (B::DPadDown, Vec2::Y)] {\n597\t            if taps.contains(&b) {\n598\t                p += d * 40.0;\n599\t            }\n600\t        }\n601\t        p = p.clamp(Vec2::new(screen.min.x, screen.min.y), Vec2::new(screen.max.x - 2.0, screen.max.y - 2.0));\n602\t        let pos = egui::pos2(p.x, p.y);\n603\t        self.pad_events.push(egui::Event::PointerMoved(pos));\n604\t        let (a, x) = (self.input.pad.a_held, self.input.pad.x_held);\n605\t        let modifiers = egui::Modifiers { shift: self.input.pad.y_held, ..Default::default() };\n606\t        if self.input.pad.y_held != self.pad_buttons.2 {\n607\t            self.pad_events.push(egui::Event::ModifiersChanged(modifiers));\n608\t        }\n609\t        for (now, was, button) in\n610\t            [(a, self.pad_buttons.0, egui::PointerButton::Primary), (x, self.pad_buttons.1, egui::PointerButton::Secondary)]\n611\t        {\n612\t            if now != was {\n613\t                self.pad_events.push(egui::Event::PointerButton { pos, button, pressed: now, modifiers });\n614\t            }\n615\t        }\n616\t        self.pad_buttons = (a, x, self.input.pad.y_held);\n617\t        let scroll = self.input.pad.right.y;\n618\t        if scroll.abs() > 0.1 {\n619\t            self.pad_events.push(egui::Event::MouseWheel {\n620\t                unit: egui::MouseWheelUnit::Point,\n621\t                phase: egui::TouchPhase::Move,\n622\t                delta: egui::vec2(0.0, scroll * 900.0 * dt),\n623\t                modifiers: Default::default(),\n624\t            });\n625\t        }\n626\t        self.pad_cursor = Some(p);\n627\t        // Menus have the pad: nothing reaches the game.\n628\t        let pad = &mut self.input.pad;\n629\t        pad.left = Vec2::ZERO;\n630\t        pad.right = Vec2::ZERO;\n631\t        pad.held = 0;\n632\t        pad.zoom = 0.0;\n633\t        pad.rotate = 0.0;\n634\t    }\n635\t\n636\t    fn toast(&mut self, msg: impl Into<String>) {\n637\t        let m = msg.into();\n638\t        log::info!(\"{m}\");\n639\t        self.toast = Some((m, Instant::now()));\n640\t    }\n641\t\n642\t    fn load_scene(&mut self, name: &str) {\n643\t        let Some(host) = &self.host else { return };\n644\t        let (scene, seed) = (name.to_string(), self.settings.seed);\n645\t        let cfg = self.sim_config.clone();\n646\t        host.exec(move |sim| {\n647\t            // Keep the hero: save, build the scene, put them back in.\n648\t            crate::save::save_from(sim);\n649\t            match Sim::new(&scene, seed) {\n650\t                Ok(mut fresh) => {\n651\t                    fresh.config = cfg;\n652\t                    crate::save::restore_into(&mut fresh);\n653\t                    *sim = fresh;\n654\t                }\n655\t                Err(e) => log::error!(\"could not load scene: {e:#}\"),\n656\t            }\n657\t        });\n658\t        self.scene_name = name.to_string();\n659\t        self.rig.params = CameraParams { yaw: self.rig.params.yaw, ..self.rig.params.clone() };\n660\t        self.toast(format!(\"loaded {}\", self.scene_name));\n661\t    }\n662\t\n663\t    /// Resets the whole scene (menu).\n664\t    fn reset(&mut self) {\n665\t        if let Some(host) = &self.host {\n666\t            let cfg = self.sim_config.clone();\n667\t            host.exec(move |sim| {\n668\t                sim.config = cfg;\n669\t                crate::save::save_from(sim);\n670\t                if let Err(e) = sim.reset() {\n671\t                    log::error!(\"reset failed: {e:#}\");\n672\t                }\n673\t                crate::save::restore_into(sim);\n674\t            });\n675\t        }\n676\t        self.toast(\"scene reset\");\n677\t    }\n678\t\n679\t    /// Resets the room the player is in (F5).\n680\t    fn reset_room(&mut self) {\n681\t        let Some(host) = &self.host else { return };\n682\t        match &self.hud.current {\n683\t            Some(r) => {\n684\t                let id = r.id;\n685\t                host.exec(move |sim| sim.reset_room(id));\n686\t                let name = r.def.name.clone();\n687\t                self.toast(format!(\"reset {name}\"));\n688\t            }\n689\t            None => self.toast(\"Not in a room (Esc, Reset scene resets everything)\"),\n690\t        }\n691\t    }\n692\t\n693\t    fn teleport(&mut self, t: TeleportTarget) {\n694\t        let Some(host) = &self.host else { return };\n695\t        self.arrival = Some(Instant::now());\n696\t        let msg = match t {\n697\t            TeleportTarget::Room(key) => {\n698\t                let k = key.clone();\n699\t                let ok = host.query(move |sim| sim.teleport_to_room(&k)).unwrap_or(false);\n700\t                if ok { format!(\"went to {key}\") } else { format!(\"could not go to {key}\") }"}]},"parent_tool_use_id":null,"session_id":"cb437ba7-0477-4143-bb04-ff33f49efd62","uuid":"d0bbc0cc-c77b-47a8-b283-99fc052553b8","timestamp":"2026-11-05T05:40:33.698Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953/engine/crates/pav_app/src/app.rs","content":"//! The game window: owns graphics, UI, input, the simulation thread and the camera.\n\nuse std::sync::Arc;\n\nuse web_time::Instant;\n\nuse anyhow::{Result, anyhow};\nuse glam::{Mat4, Quat, Vec2, Vec3};\nuse pav_core::params::{ParamVisitor, Tunable, nested};\nuse pav_core::prop_preview::StudioMode;\nuse pav_core::{InputFrame, Sim, SimConfig};\nuse pav_render::gpu::BackendChoice;\nuse pav_render::scene::{MeshInstance, MeshKey, Style, flags as rflags};\nuse pav_view::{CameraParams, CameraRig, ViewBuilder, ViewSettings};\nuse winit::application::ApplicationHandler;\nuse winit::event::{ElementState, MouseButton, MouseScrollDelta, WindowEvent};\nuse winit::event_loop::{ActiveEventLoop, ControlFlow, EventLoop};\nuse winit::keyboard::{KeyCode, PhysicalKey};\nuse winit::window::{Fullscreen, Window, WindowId};\n\nuse crate::boot::{self, stage};\nuse crate::edit::Editor;\nuse crate::gfx::Gfx;\nuse crate::hud::{CameraDirector, FeelOverlay, FeelSettings, HudCtx, Latency, LatencySample, PhysicsOverlay};\nuse crate::input::{Device, Input};\nuse crate::panel::{Panel, PanelAction};\nuse crate::rooms::{RoomEntry, RoomHud, RoomWatcher, TeleportTarget};\nuse crate::settings::Settings;\nuse crate::simhost::SimHost;\nuse crate::ui::{self, MenuAction};\nuse crate::uiinput::UiInput;\n\n#[cfg(not(target_arch = \"wasm32\"))]\npub fn run(settings: Settings) -> Result<()> {\n    let event_loop = stage(\"event loop\", || Ok((EventLoop::new()?, String::new())))?;\n    event_loop.set_control_flow(ControlFlow::Poll);\n    let mut app = App::new(settings);\n    event_loop.run_app(&mut app)?;\n    match app.fatal.take() {\n        Some(e) => Err(anyhow!(e)),\n        None => Ok(()),\n    }\n}\n\n/// In the browser the event loop runs from the page's animation frames; this returns at once.\n#[cfg(target_arch = \"wasm32\")]\npub fn run(settings: Settings) -> Result<()> {\n    use winit::platform::web::EventLoopExtWebSys;\n    let event_loop = stage(\"event loop\", || Ok((EventLoop::new()?, String::new())))?;\n    event_loop.set_control_flow(ControlFlow::Poll);\n    event_loop.spawn_app(App::new(settings));\n    Ok(())\n}\n\n/// App-level tunables (the \"app\" group in the panel).\n#[derive(Clone, Debug, PartialEq)]\npub struct AppSettings {\n    pub vsync: bool,\n    pub smoothing: bool,\n    pub show_stats: bool,\n    pub show_guide: bool,\n    pub aim_marker: bool,\n}\n\nimpl Tunable for AppSettings {\n    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n        v.bool(\"vsync\", &mut self.vsync, \"Wait for the display refresh (off = lowest latency, may tear)\");\n        v.bool(\"smoothing\", &mut self.smoothing, \"Interpolate between simulation ticks\");\n        v.bool(\"show_stats\", &mut self.show_stats, \"FPS / tick overlay\");\n        v.bool(\"show_guide\", &mut self.show_guide, \"Control guide overlay\");\n        v.bool(\"aim_marker\", &mut self.aim_marker, \"Show where bombs will land\");\n    }\n}\n\n/// Sound settings (the \"audio\" group).\n#[derive(Clone, Debug, PartialEq)]\npub struct AudioSettings {\n    pub master: f32,\n    pub sfx: f32,\n    pub footsteps: bool,\n}\n\nimpl Tunable for AudioSettings {\n    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n        v.float(\"master\", &mut self.master, 0.0, 2.0, \"Master volume\");\n        v.float(\"sfx\", &mut self.sfx, 0.0, 2.0, \"Sound effects volume\");\n        v.bool(\"footsteps\", &mut self.footsteps, \"Footstep sounds\");\n    }\n}\n\nstruct Root<'a> {\n    sim: &'a mut SimConfig,\n    camera: &'a mut CameraParams,\n    view: &'a mut ViewSettings,\n    app: &'a mut AppSettings,\n    audio: &'a mut AudioSettings,\n}\n\nimpl Tunable for Root<'_> {\n    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n        self.sim.visit_groups(v);\n        nested(v, \"camera\", self.camera);\n        nested(v, \"view\", self.view);\n        nested(v, \"audio\", self.audio);\n        nested(v, \"app\", self.app);\n    }\n}\n\n#[derive(Default)]\nstruct Mouse {\n    right_down: bool,\n    pos: Vec2,\n}\n\nstruct Fps {\n    frames: u32,\n    since: Instant,\n    fps: f32,\n    frame_ms: f32,\n}\n\npub struct App {\n    settings: Settings,\n    gfx: Option<Gfx>,\n    egui_ctx: egui::Context,\n    egui_state: Option<UiInput>,\n    host: Option<SimHost>,\n    rig: CameraRig,\n    view: ViewSettings,\n    /// View settings before the room's `[view]` table and pad overrides were applied, and\n    /// which room / pad state they belong to.\n    view_base: Option<ViewSettings>,\n    view_key: (Option<u16>, u64),\n    sim_config: SimConfig,\n    app_settings: AppSettings,\n    builder: ViewBuilder,\n    input: Input,\n    panel: Panel,\n    menu_open: bool,\n    paused_before_menu: bool,\n    show_boot: bool,\n    boot_done_at: Option<Instant>,\n    started: Instant,\n    last: Instant,\n    fps: Fps,\n    mouse: Mouse,\n    screenshot_requested: bool,\n    scene_name: String,\n    toast: Option<(String, Instant)>,\n    hud: RoomHud,\n    watcher: Option<RoomWatcher>,\n    editor: Editor,\n    audio: Option<pav_audio::AudioOut>,\n    audio_settings: AudioSettings,\n    /// Tick at which the app last pushed its config (the sim's copy is adopted after that).\n    config_push_tick: u64,\n    latency: Latency,\n    director: CameraDirector,\n    feel: FeelOverlay,\n    physics: PhysicsOverlay,\n    quit: bool,\n    /// Camera and look from before the game started (restored when leaving it).\n    game_saved: Option<(CameraParams, ViewSettings)>,\n    /// The Look & Filters window and the look layer over `view`.\n    look_ui: crate::look_ui::LookUi,\n    animation_ui: crate::animation_ui::AnimationUi,\n    studio_mode: StudioMode,\n    studio_navigation: bool,\n    asset_ui: crate::asset_ui::AssetUi,\n    asset_watcher: crate::asset_watch::AssetWatcher,\n    creature_ui: crate::creature_ui::CreatureUi,\n    creature_watcher: crate::creature_watch::CreatureWatcher,\n    animation_watcher: Option<crate::animation_watch::AnimationWatcher>,\n    animation_watch_attempted: bool,\n    /// Station guide (H) and field guide.\n    guide: crate::guide_ui::GuideUi,\n    /// When the player last arrived somewhere new (another place, a teleport): the screen\n    /// transition opens from then.\n    arrival: Option<Instant>,\n    /// Shardfall windows (inventory, vendor...), the latest game frame and the place whose\n    /// look is applied.\n    game_ui: crate::arpg_items::GameUi,\n    /// When the hero was last saved.\n    last_save: Instant,\n    /// The gamepad's menu cursor (egui points) and the pointer events it makes this frame.\n    pad_cursor: Option<Vec2>,\n    pad_events: Vec<egui::Event>,\n    pad_buttons: (bool, bool, bool),\n    game_frame: Option<std::sync::Arc<pav_core::arpg::GameFrame>>,\n    game_place: Option<pav_core::arpg::Place>,\n    /// Phones and tablets: fingers, the on-screen controls and swipes (touch.rs).\n    touch: crate::touch::Touch,\n    /// The browser says this is a touch screen (or a finger has touched it).\n    touch_screen: bool,\n    /// The egui style has the touch sizes.\n    touch_styled: bool,\n    /// Touch screens draw at most 60 frames a second: when the next one is due.\n    next_draw: Instant,\n    /// Auto-attack, graphics quality, tips seen (saved).\n    prefs: crate::save::Prefs,\n    scaler: crate::quality::Scaler,\n    #[cfg(not(target_arch = \"wasm32\"))]\n    bridge: Option<crate::bridge::Bridge>,\n    #[cfg(target_arch = \"wasm32\")]\n    pending_gfx: Option<std::rc::Rc<std::cell::RefCell<Option<Result<Gfx>>>>>,\n    #[cfg(target_arch = \"wasm32\")]\n    audio_resumed: bool,\n    init_started: bool,\n    pub fatal: Option<String>,\n}\n\nimpl App {\n    fn new(settings: Settings) -> Self {\n        let scene_name = settings.scene.clone();\n        let touch_screen = crate::platform::touch_screen();\n        let mut app = Self {\n            gfx: None,\n            egui_ctx: egui::Context::default(),\n            egui_state: None,\n            host: None,\n            rig: CameraRig::default(),\n            view: ViewSettings::default(),\n            view_base: None,\n            view_key: (None, 0),\n            sim_config: SimConfig::default(),\n            app_settings: AppSettings {\n                vsync: settings.vsync,\n                smoothing: true,\n                show_stats: true,\n                show_guide: true,\n                aim_marker: true,\n            },\n            builder: ViewBuilder::new(),\n            input: Input::new(),\n            panel: Panel::new(),\n            menu_open: false,\n            paused_before_menu: false,\n            show_boot: true,\n            boot_done_at: None,\n            started: Instant::now(),\n            last: Instant::now(),\n            fps: Fps { frames: 0, since: Instant::now(), fps: 0.0, frame_ms: 0.0 },\n            mouse: Mouse::default(),\n            screenshot_requested: false,\n            scene_name,\n            toast: None,\n            hud: RoomHud::default(),\n            watcher: None,\n            editor: Editor::default(),\n            audio: None,\n            audio_settings: AudioSettings { master: 0.8, sfx: 1.0, footsteps: true },\n            config_push_tick: 0,\n            latency: Latency::default(),\n            director: CameraDirector::default(),\n            feel: FeelOverlay::default(),\n            physics: PhysicsOverlay::default(),\n            quit: false,\n            game_saved: None,\n            look_ui: crate::look_ui::LookUi::load(),\n            animation_ui: crate::animation_ui::AnimationUi::new(settings.animation_studio),\n            studio_mode: StudioMode::World,\n            studio_navigation: settings.animation_studio || settings.asset_studio || settings.creature_studio,\n            asset_ui: crate::asset_ui::AssetUi::new(settings.asset_studio),\n            asset_watcher: crate::asset_watch::AssetWatcher::new(),\n            creature_ui: crate::creature_ui::CreatureUi::new(settings.creature_studio),\n            creature_watcher: crate::creature_watch::CreatureWatcher::new(),\n            animation_watcher: None,\n            animation_watch_attempted: false,\n            guide: Default::default(),\n            arrival: None,\n            game_ui: Default::default(),\n            last_save: Instant::now(),\n            pad_cursor: None,\n            pad_events: Vec::new(),\n            pad_buttons: (false, false, false),\n            game_frame: None,\n            game_place: None,\n            touch: Default::default(),\n            touch_screen,\n            touch_styled: false,\n            next_draw: Instant::now(),\n            prefs: crate::save::load_prefs(),\n            scaler: Default::default(),\n            #[cfg(not(target_arch = \"wasm32\"))]\n            bridge: None,\n            #[cfg(target_arch = \"wasm32\")]\n            pending_gfx: None,\n            #[cfg(target_arch = \"wasm32\")]\n            audio_resumed: false,\n            init_started: false,\n            fatal: None,\n            settings,\n        };\n        if touch_screen {\n            // Phones: touch controls from the start, none of the desktop's diagnostics.\n            app.input.last_device = Device::Touch;\n            app.show_boot = false;\n            app.app_settings.show_stats = false;\n        }\n        app\n    }\n\n    /// A finger on the screen: the touch layer decides whether it is the stick, a control, a\n    /// swipe or egui's (and then egui gets the event).\n    fn on_touch(&mut self, t: &winit::event::Touch, event: &WindowEvent) {\n        #[cfg(target_arch = \"wasm32\")]\n        self.resume_audio();\n        let Some(g) = &self.gfx else { return };\n        let ppp = self.egui_ctx.zoom_factor() * g.window.scale_factor() as f32;\n        let pos = egui::pos2(t.location.x as f32 / ppp, t.location.y as f32 / ppp);\n        self.input.last_device = Device::Touch;\n        self.touch_screen = true;\n        use winit::event::TouchPhase as P;\n        let to_egui = match t.phase {\n            P::Started => {\n                // (The root layer is everywhere; only windows and labels over the game count.)\n                let under = self.egui_ctx.layer_id_at(pos).filter(|l| *l != egui::LayerId::background()).map(|l| l.order);\n                self.touch.down(t.id, pos, under)\n            }\n            P::Moved => self.touch.moved(t.id, pos),\n            P::Ended => self.touch.up(t.id, pos, false),\n            P::Cancelled => self.touch.up(t.id, pos, true),\n        };\n        if to_egui {\n            if let (Some(st), Some(g)) = (&mut self.egui_state, &self.gfx) {\n                st.on_window_event(&g.window, event);\n            }\n        }\n    }\n\n    /// A tap on the open game closes what is open over it, one thing at a time.\n    fn close_on_tap(&mut self) {\n        if self.menu_open {\n            self.set_menu(false);\n        } else if self.game_ui.any_open() {\n            self.game_ui.close_all();\n        } else if self.game_ui.map {\n            self.game_ui.map = false;\n        } else if self.look_ui.open {\n            self.look_ui.open = false;\n            self.look_ui.save_if_dirty(true);\n        } else if self.guide.station || self.guide.field {\n            self.guide.station = false;\n            self.guide.field = false;\n        } else if self.hud.teleport_open {\n            self.hud.teleport_open = false;\n        } else if self.hud.card_visible() {\n            self.hud.hide_card();\n        }\n    }\n\n    fn init(&mut self, el: &ActiveEventLoop) -> Result<()> {\n        let s = self.settings.clone();\n        let window = stage(\"window\", || {\n            let mut attrs = Window::default_attributes().with_title(\"Shardfall\");\n            #[cfg(not(target_arch = \"wasm32\"))]\n            {\n                attrs = attrs.with_inner_size(winit::dpi::LogicalSize::new(s.width, s.height));\n            }\n            // In the browser the window is a canvas filling the page (sized by the page's CSS).\n            #[cfg(target_arch = \"wasm32\")]\n            {\n                use winit::platform::web::WindowAttributesExtWebSys;\n                attrs = attrs.with_append(true);\n            }\n            if s.fullscreen {\n                attrs = attrs.with_fullscreen(Some(Fullscreen::Borderless(None)));\n            }\n            let w = Arc::new(el.create_window(attrs)?);\n            let sz = w.inner_size();\n            let d = format!(\"{}x{} px, scale {:.2}\", sz.width, sz.height, w.scale_factor());\n            Ok((w, d))\n        })?;\n        let backend = BackendChoice::parse(&s.backend)\n            .ok_or_else(|| anyhow!(\"unknown backend '{}' in settings (use vulkan or dx12)\", s.backend))?;\n        #[cfg(not(target_arch = \"wasm32\"))]\n        {\n            let gfx = Gfx::new(window, backend, s.vsync)?;\n            self.finish_init(gfx)\n        }\n        // The browser hands out the GPU asynchronously: `about_to_wait` finishes the start.\n        #[cfg(target_arch = \"wasm32\")]\n        {\n            let slot = std::rc::Rc::new(std::cell::RefCell::new(None));\n            let fill = slot.clone();\n            wasm_bindgen_futures::spawn_local(async move {\n                *fill.borrow_mut() = Some(Gfx::create(window, backend, s.vsync).await);\n            });\n            self.pending_gfx = Some(slot);\n            Ok(())\n        }\n    }\n\n    /// The rest of the start, once graphics exist.\n    fn finish_init(&mut self, gfx: Gfx) -> Result<()> {\n        let s = self.settings.clone();\n        let window = gfx.window.clone();\n        let egui_state = stage(\"ui\", || {\n            let st = UiInput::new(&self.egui_ctx, &window, gfx.device.limits().max_texture_dimension_2d as usize);\n            Ok((st, String::new()))\n        })?;\n        self.audio = stage(\"audio\", || match pav_audio::AudioOut::start() {\n            Ok(a) => {\n                let d = format!(\"{} @ {} Hz\", a.device, a.sample_rate);\n                Ok((Some(a), d))\n            }\n            Err(e) => Ok((None, format!(\"no sound ({e}); continuing silently\"))),\n        })?;\n        // Rooms can name saved objects. Load the library before constructing the scene, and\n        // the workshop materials before the objects that wear them.\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if let Err(error) = pav_tools::material_tools::initialize_authored() {\n            self.asset_ui.report(Err(format!(\"Could not load saved materials: {error:#}\")));\n        }\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if let Err(error) = pav_tools::asset_tools::initialize_authored() {\n            self.asset_ui.report(Err(format!(\"Could not load saved objects: {error:#}\")));\n        }\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if let Err(error) = pav_tools::creature_tools::initialize_authored() {\n            self.creature_ui.report(Err(format!(\"Could not load saved creatures: {error:#}\")));\n        }\n        let mut sim = stage(\"simulation\", || {\n            let mut sim = Sim::new(&s.scene, s.seed)?;\n            let mut d = format!(\n                \"scene '{}', seed {}, {} entities, {} blocks\",\n                s.scene,\n                s.seed,\n                sim.state.entities.len(),\n                sim.state.statics.block_count()\n            );\n            if let Some(level) = crate::save::restore_into(&mut sim) {\n                d += &format!(\", saved hero (level {level})\");\n            }\n            Ok((sim, d))\n        })?;\n        if s.animation_studio {\n            // Read authored sets before selecting a clip. Keep the embedded library if a\n            // file is invalid, so the studio can still open and report the error.\n            #[cfg(not(target_arch = \"wasm32\"))]\n            {\n                let _ = pav_core::clips::library();\n                if pav_core::anim::disk_dir().is_some() {\n                    if let Err(e) = pav_core::anim::reload(true) {\n                        self.animation_ui.report(Err(e));\n                    }\n                }\n                if let Err(e) = pav_tools::animation_tools::reload_authored() {\n                    self.animation_ui.report(Err(format!(\"{e:#}\")));\n                }\n            }\n            let name = if s.animation_clip.is_empty() { \"QUATERNIUS/Idle_Loop\" } else { &s.animation_clip };\n            let mut session = pav_tools::Session::from_live(sim, self.rig.clone(), self.view.clone(), None);\n            let args = serde_json::json!({\"clip\":name}).as_object().unwrap().clone();\n            pav_tools::preview_tools::t_anim_preview(&mut session, &args)?;\n            let (live, rig, view, _) = session.into_live();\n            sim = live;\n            self.rig = rig;\n            self.view = view;\n            self.show_boot = false;\n            self.app_settings.show_stats = false;\n            self.app_settings.show_guide = false;\n        }\n        if s.asset_studio {\n            let name = if s.asset_name.is_empty() { \"BUILTIN/bench\" } else { &s.asset_name };\n            let mut session = pav_tools::Session::from_live(sim, self.rig.clone(), self.view.clone(), None);\n            let args = serde_json::json!({\"name\":name}).as_object().unwrap().clone();\n            pav_tools::asset_preview_tools::t_asset_preview(&mut session, &args)?;\n            let (live, rig, view, _) = session.into_live();\n            sim = live;\n            self.rig = rig;\n            self.view = view;\n            self.show_boot = false;\n            self.app_settings.show_stats = false;\n            self.app_settings.show_guide = false;\n        }\n        if s.creature_studio {\n            let mut session = pav_tools::Session::from_live(sim, self.rig.clone(), self.view.clone(), None);\n            let mut args = serde_json::json!({\"action\":\"open\"}).as_object().unwrap().clone();\n            if !s.creature_name.is_empty() {\n                args.insert(\"name\".into(), serde_json::json!(s.creature_name));\n            }\n            let result = pav_tools::creature_preview_tools::t_creature_preview(&mut session, &args)\n                .map(|output| match output {\n                    pav_tools::Output::Json(v) => v,\n                    pav_tools::Output::Image { meta, .. } => meta,\n                })\n                .map_err(|error| format!(\"{error:#}\"));\n            self.creature_ui.report(result);\n            let (live, rig, view, _) = session.into_live();\n            sim = live;\n            self.rig = rig;\n            self.view = view;\n            self.show_boot = false;\n            self.app_settings.show_stats = false;\n            self.app_settings.show_guide = false;\n        }\n        self.sim_config = sim.config.clone();\n        self.rig.snap(sim.frame().focus);\n        self.hud.entries = room_entries(&sim);\n        self.hud.errors = sim.state.world.errors.clone();\n        self.watcher = RoomWatcher::start();\n        self.animation_watch_attempted = crate::animation_watch::AnimationWatcher::directory_exists();\n        if self.animation_watch_attempted {\n            self.animation_watcher = crate::animation_watch::AnimationWatcher::start();\n        }\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if !s.pad_script.is_empty() {\n            match std::fs::read_to_string(&s.pad_script)\n                .map_err(|e| e.to_string())\n                .and_then(|t| crate::input::PadScript::parse(&t))\n            {\n                Ok(p) => {\n                    log::info!(\"pad script: {} steps from {}\", p.steps.len(), s.pad_script);\n                    self.input.pad_script = Some(p);\n                }\n                Err(e) => log::error!(\"pad script {}: {e}\", s.pad_script),\n            }\n        }\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if !s.bridge.is_empty() {\n            self.bridge = stage(\"agent bridge\", || match crate::bridge::Bridge::start(&s.bridge) {\n                Ok(b) => {\n                    let d = format!(\"listening on {}\", b.addr);\n                    Ok((Some(b), d))\n                }\n                Err(e) => Ok((None, format!(\"could not listen on {} ({e}); continuing without it\", s.bridge))),\n            })?;\n        }\n        self.host = Some(SimHost::start(sim));\n        self.gfx = Some(gfx);\n        self.egui_state = Some(egui_state);\n        Ok(())\n    }\n\n    /// Whether the gamepad drives a menu cursor now (a game window or the pause menu is open).\n    fn pad_ui_active(&self) -> bool {\n        self.input.last_device == Device::Gamepad\n            && (self.menu_open || self.game_ui.any_open() || self.look_ui.open || self.guide.station || self.guide.field)\n    }\n\n    /// Gamepad in menus: D-pad down opens the hero's panels (LB / RB switch them), B closes;\n    /// while a window is open the left stick (or D-pad) moves a cursor, A and X click left and\n    /// right, the right stick scrolls, and the game gets no pad input.\n    fn pad_menus(&mut self, dt: f32) {\n        use gilrs::Button as B;\n        let taps = std::mem::take(&mut self.input.pad.taps);\n        let game = self.game_frame.is_some();\n        if self.input.last_device != Device::Gamepad {\n            self.pad_cursor = None;\n            return;\n        }\n        let ui = &mut self.game_ui;\n        if game && !self.menu_open && taps.contains(&B::DPadDown) && !ui.any_open() {\n            ui.inventory = true;\n            return;\n        }\n        if !self.pad_ui_active() {\n            self.pad_cursor = None;\n            if self.pad_buttons.2 {\n                self.pad_events.push(egui::Event::ModifiersChanged(Default::default()));\n            }\n            self.pad_buttons = (false, false, false);\n            return;\n        }\n        let ui = &mut self.game_ui;\n        // Switch between the hero's panels.\n        let cycle = taps.contains(&B::RightTrigger) as i32 - taps.contains(&B::LeftTrigger) as i32;\n        if cycle != 0 && game && !self.menu_open {\n            let now = [ui.inventory, ui.character, ui.skills, ui.tree.open].iter().position(|x| *x).unwrap_or(0) as i32;\n            let next = (now + cycle).rem_euclid(4);\n            ui.inventory = next == 0;\n            ui.character = next == 1;\n            ui.skills = next == 2;\n            ui.tree.open = next == 3;\n        }\n        if taps.contains(&B::East) {\n            if ui.any_open() {\n                ui.close_all();\n            } else if self.look_ui.open && !self.menu_open {\n                self.look_ui.open = false;\n                self.look_ui.save_if_dirty(true);\n            } else if (self.guide.station || self.guide.field) && !self.menu_open {\n                self.guide.station = false;\n                self.guide.field = false;\n            } else {\n                self.set_menu(false);\n            }\n        }\n        // The cursor.\n        let screen = self.egui_ctx.content_rect();\n        let mut p = self.pad_cursor.unwrap_or(Vec2::new(screen.center().x, screen.center().y));\n        let stick = self.input.pad.left;\n        let speed = 260.0 + 900.0 * stick.length().powi(2);\n        p += Vec2::new(stick.x, -stick.y) * speed * dt;\n        for (b, d) in [(B::DPadLeft, Vec2::NEG_X), (B::DPadRight, Vec2::X), (B::DPadUp, Vec2::NEG_Y), (B::DPadDown, Vec2::Y)] {\n            if taps.contains(&b) {\n                p += d * 40.0;\n            }\n        }\n        p = p.clamp(Vec2::new(screen.min.x, screen.min.y), Vec2::new(screen.max.x - 2.0, screen.max.y - 2.0));\n        let pos = egui::pos2(p.x, p.y);\n        self.pad_events.push(egui::Event::PointerMoved(pos));\n        let (a, x) = (self.input.pad.a_held, self.input.pad.x_held);\n        let modifiers = egui::Modifiers { shift: self.input.pad.y_held, ..Default::default() };\n        if self.input.pad.y_held != self.pad_buttons.2 {\n            self.pad_events.push(egui::Event::ModifiersChanged(modifiers));\n        }\n        for (now, was, button) in\n            [(a, self.pad_buttons.0, egui::PointerButton::Primary), (x, self.pad_buttons.1, egui::PointerButton::Secondary)]\n        {\n            if now != was {\n                self.pad_events.push(egui::Event::PointerButton { pos, button, pressed: now, modifiers });\n            }\n        }\n        self.pad_buttons = (a, x, self.input.pad.y_held);\n        let scroll = self.input.pad.right.y;\n        if scroll.abs() > 0.1 {\n            self.pad_events.push(egui::Event::MouseWheel {\n                unit: egui::MouseWheelUnit::Point,\n                phase: egui::TouchPhase::Move,\n                delta: egui::vec2(0.0, scroll * 900.0 * dt),\n                modifiers: Default::default(),\n            });\n        }\n        self.pad_cursor = Some(p);\n        // Menus have the pad: nothing reaches the game.\n        let pad = &mut self.input.pad;\n        pad.left = Vec2::ZERO;\n        pad.right = Vec2::ZERO;\n        pad.held = 0;\n        pad.zoom = 0.0;\n        pad.rotate = 0.0;\n    }\n\n    fn toast(&mut self, msg: impl Into<String>) {\n        let m = msg.into();\n        log::info!(\"{m}\");\n        self.toast = Some((m, Instant::now()));\n    }\n\n    fn load_scene(&mut self, name: &str) {\n        let Some(host) = &self.host else { return };\n        let (scene, seed) = (name.to_string(), self.settings.seed);\n        let cfg = self.sim_config.clone();\n        host.exec(move |sim| {\n            // Keep the hero: save, build the scene, put them back in.\n            crate::save::save_from(sim);\n            match Sim::new(&scene, seed) {\n                Ok(mut fresh) => {\n                    fresh.config = cfg;\n                    crate::save::restore_into(&mut fresh);\n                    *sim = fresh;\n                }\n                Err(e) => log::error!(\"could not load scene: {e:#}\"),\n            }\n        });\n        self.scene_name = name.to_string();\n        self.rig.params = CameraParams { yaw: self.rig.params.yaw, ..self.rig.params.clone() };\n        self.toast(format!(\"loaded {}\", self.scene_name));\n    }\n\n    /// Resets the whole scene (menu).\n    fn reset(&mut self) {\n        if let Some(host) = &self.host {\n            let cfg = self.sim_config.clone();\n            host.exec(move |sim| {\n                sim.config = cfg;\n                crate::save::save_from(sim);\n                if let Err(e) = sim.reset() {\n                    log::error!(\"reset failed: {e:#}\");\n                }\n                crate::save::restore_into(sim);\n            });\n        }\n        self.toast(\"scene reset\");\n    }\n\n    /// Resets the room the player is in (F5).\n    fn reset_room(&mut self) {\n        let Some(host) = &self.host else { return };\n        match &self.hud.current {\n            Some(r) => {\n                let id = r.id;\n                host.exec(move |sim| sim.reset_room(id));\n                let name = r.def.name.clone();\n                self.toast(format!(\"reset {name}\"));\n            }\n            None => self.toast(\"Not in a room (Esc, Reset scene resets everything)\"),\n        }\n    }\n\n    fn teleport(&mut self, t: TeleportTarget) {\n        let Some(host) = &self.host else { return };\n        self.arrival = Some(Instant::now());\n        let msg = match t {\n            TeleportTarget::Room(key) => {\n                let k = key.clone();\n                let ok = host.query(move |sim| sim.teleport_to_room(&k)).unwrap_or(false);\n                if ok { format!(\"went to {key}\") } else { format!(\"could not go to {key}\") }","numLines":700,"startLine":1,"totalLines":2267}},"tool_result_meta":[{"id":"toolu_01Vf4niwLhCyDW3dfWyN5Xo9","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
