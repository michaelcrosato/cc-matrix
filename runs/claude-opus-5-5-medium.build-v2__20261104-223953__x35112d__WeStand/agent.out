d\", \"event\", \"result\") else \"\")\n        if key not in seen:\n            seen[key] = t\n            # A moment later the screen has settled.\n            cmd(\"play bot=false ticks=2\")\n            print(key, t, cmd(f\"capture width=1280 height=720 out={out}/{key.replace(' ','_')}.png\")[:60], flush=True)\n        if s.get(\"outcome\") not in (None, \"playing\"):\n            print(\"outcome\", s.get(\"outcome\")); break\nfinally:\n    p.terminate()\nPY\ncd engine; CARGO_BUILD_JOBS=8 cargo build --locked -p pav_tools --bin pav 2>&1 | grep -E \"^error|Finished\"; printf 'load scene=fit\\nplay bot=true ticks=3\\n' | ./target/debug/pav repl 2>&1 | cut -c1-700 | tail -1; cd ..; python3 tests/dev/tour.py fit 12000 3 2>&1 | cut -c1-110 | tail -30","description":"Tour the game by bot and capture each screen once","timeout":500000}}}
