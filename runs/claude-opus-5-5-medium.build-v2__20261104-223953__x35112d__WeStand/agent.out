{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjGcPucszRJ2WJPUzX14","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":23468,"cache_read_input_tokens":345414,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":23468},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cb437ba7-0477-4143-bb04-ff33f49efd62","uuid":"9beb16e5-fd11-4234-bfbc-3258fbecb887","timestamp":"2026-11-05T06:00:24.099Z","request_id":"req_011CgjGcPcWeQFTUDHddDp4y","thinking_duration_ms":50422,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjGcPucszRJ2WJPUzX14","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01X1KqzoSQUskURoce7Aj9K8","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953\nF=engine/crates/pav_core/src/games/fit\npython3 - <<'PY'\np='engine/crates/pav_core/src/games/fit/events/step.rs'\ns=open(p).read()\ns=s.replace('''        cx.ev.push(SimEvent::Music { song: if o.band { 6 } else { 4 } });\n        Self {''','''        Self {''')\ns=s.replace('''    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        let dt = cx.dt;\n        self.t += dt;\n        // The music's clock''','''    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        let dt = cx.dt;\n        if self.t == 0.0 {\n            // The song starts with the first tick of play, so its clock and the chart agree.\n            cx.ev.push(SimEvent::Music { song: if self.band { 6 } else { 4 } });\n        }\n        self.t += dt;\n        // The music's clock''')\nopen(p,'w').write(s)\nPY\ncat > $F/finale.rs <<'RS'\n//! The Big Stand: five phases on a tiny post in the bay, reusing the events with new numbers.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::core::BalanceCore;\nuse super::events::stillness::Stillness;\nuse super::events::*;\nuse super::rules::Rules;\nuse super::sfx;\nuse super::ui_model::*;\nuse crate::frame::SimEvent;\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Finale {\n    pub phase: u32,\n    pub ev: Option<Ev>,\n    pub still: Option<Stillness>,\n    pub phase_scores: Vec<u32>,\n    pub post: Vec3,\n    pub tips: u32,\n    pub peace: bool,\n    pub over: f32,\n}\n\npub const PHASES: [&str; 5] = [\"Breathe\", \"Hold a pose\", \"March\", \"Brace\", \"The Long Stillness\"];\n\nimpl Finale {\n    pub fn start(cx: &mut Cx, first: u32) -> Self {\n        let post = cx.spot(BAY, \"post\");\n        let mut f = Self { phase: first, ev: None, still: None, phase_scores: Vec::new(), post, tips: 0, peace: false, over: 0.0 };\n        cx.player(post, 0.0);\n        cx.ev.push(SimEvent::Music { song: 6 });\n        f.enter(cx);\n        f\n    }\n\n    fn enter(&mut self, cx: &mut Cx) {\n        let at = Some(self.post);\n        cx.core.center();\n        cx.stop_clip();\n        cx.say(PHASES[self.phase.min(4) as usize], 2.5);\n        cx.sfx(sfx::GONG, 0.6, 1.0);\n        self.ev = None;\n        self.still = None;\n        match self.phase {\n            0 => self.ev = Some(Ev::start(EvKind::Breath, cx, Opt { count: Some(4), at, ..Default::default() })),\n            1 => self.ev = Some(Ev::start(EvKind::Pose, cx, Opt { count: Some(1), seconds: Some(20.0), at, band: true })),\n            2 => self.ev = Some(Ev::start(EvKind::Step, cx, Opt { count: Some(16), at, band: true, ..Default::default() })),\n            3 => self.ev = Some(Ev::start(EvKind::Plank, cx, Opt { seconds: Some(20.0), at, band: true, ..Default::default() })),\n            _ => {\n                self.still = Some(Stillness::new(cx.r.finale.stillness));\n                cx.player(self.post, 0.0);\n                cx.mirror_shot(self.post, 7.0);\n            }\n        }\n        if self.phase < 4 {\n            *cx.shot = Shot { tilt: 14.0, yaw: 0.0, distance: 10.0, fov: 36.0, height: 0.9, focus: self.post };\n        }\n    }\n\n    /// `any` is any input at all (the Long Stillness listens for it).\n    pub fn tick(&mut self, cx: &mut Cx, i: &Intent, any: bool) -> bool {\n        if self.over > 0.0 {\n            self.over -= cx.dt;\n            return self.over <= 0.0;\n        }\n        if let Some(s) = &mut self.still {\n            if s.tick(cx, any) {\n                self.peace = !s.broke;\n                let line = if self.peace { \"...Oh. You're still here. Good.\".to_string() } else { \"...You pressed something. I wrote it down.\".to_string() };\n                cx.say(line, 5.0);\n                cx.sfx(sfx::CHEER, 0.8, 1.0);\n                cx.ev.push(SimEvent::Burst { pos: self.post + Vec3::Y * 4.0, kind: 0, count: 90 });\n                self.over = 4.0;\n            }\n            return false;\n        }\n        let done = self.ev.as_mut().is_some_and(|e| e.tick(cx, i));\n        cx.player_keep_post(self.post, self.phase);\n        if done {\n            let sc = self.ev.as_ref().map(|e| e.score(cx.r)).unwrap_or(0);\n            self.phase_scores.push(sc);\n            self.phase += 1;\n            self.enter(cx);\n        }\n        false\n    }\n\n    pub fn on_tip(&mut self, cx: &mut Cx) {\n        self.tips += 1;\n        cx.ev.push(SimEvent::BigSplash { pos: self.post, size: 0.5 });\n        cx.sfx(sfx::SPLASH_B, 0.7, 1.2);\n        cx.sfx(sfx::GROAN, 0.9, 1.0);\n        let line = cx.pick(\"finale_tip\");\n        cx.say(line, 2.5);\n    }\n\n    pub fn bot(&self, core: &BalanceCore, r: &Rules) -> Intent {\n        match &self.ev {\n            Some(e) => e.bot(core, r),\n            None => Intent { lean: Vec2::ZERO, ..Default::default() },\n        }\n    }\n\n    pub fn hud(&self, b: &mut B, core: &BalanceCore, r: &Rules) {\n        if let Some(s) = &self.still {\n            s.hud(b, core);\n            return;\n        }\n        if let Some(e) = &self.ev {\n            e.hud(b, core, r);\n        }\n        b.center(960.0, 1020.0, 36.0, INK, &format!(\"Phase {} of 5\", self.phase.min(4) + 1));\n    }\n\n    pub fn score(&self, r: &Rules) -> u32 {\n        // Four phases share what the Inner Peace bonus leaves; tips cost a little.\n        let sum: u32 = self.phase_scores.iter().sum();\n        let base = (1000.0 - r.finale.bonus) * sum as f32 / 4000.0;\n        let bonus = if self.peace { r.finale.bonus } else { 0.0 };\n        (base + bonus - self.tips as f32 * r.finale.tip_cost).clamp(0.0, 1000.0) as u32\n    }\n}\n\nimpl Cx<'_> {\n    /// On the post the figure stays put, even when an event moved it for its own stage.\n    fn player_keep_post(&mut self, post: Vec3, _phase: u32) {\n        if let Some(f) = self.sim.feet(self.pid) {\n            if (f - post).length() > 0.5 {\n                self.sim.set_position(self.pid, post);\n            }\n        }\n    }\n}\nRS\ncat > $F/check.rs <<'RS'\n//! The Morning Wobble Check: four micro-tests, Pip presiding, then the verdict.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::core::BalanceCore;\nuse super::events::*;\nuse super::rules::Rules;\nuse super::script::{self, PIP};\nuse super::sfx;\nuse super::ui_model::*;\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Check {\n    pub test: u32,\n    pub t: f32,\n    pub intro: f32,\n    pub still: f32,\n    still_n: f32,\n    nudged: bool,\n    pub targets: [f32; 3],\n    target_i: u32,\n    hold: f32,\n    target_t: f32,\n    pub target_at: [f32; 3],\n    pub blind: f32,\n    blind_n: f32,\n    tone_in: f32,\n    pub steps: f32,\n    pub step_n: u32,\n    step_next: u32,\n    pub metric: [f32; 4],\n    pub done: bool,\n    last_tick: u32,\n    pub rumble: f32,\n}\n\npub const TESTS: [(&str, &str); 4] = [\n    (\"Stand Still\", \"This is the whole test.\"),\n    (\"Lean Targets\", \"Lean to the mark and stay there.\"),\n    (\"Eyes Closed\", \"Close your eyes. The tone tells you where you are. The tone is honest.\"),\n    (\"Step Test\", \"Eight steps, left and right, to the tick.\"),\n];\n\nconst INTRO: f32 = 3.0;\nconst STEP_BEAT: f32 = 0.6; // 100 BPM\nconst STEPS: u32 = 8;\n\nimpl Check {\n    pub fn new(cx: &mut Cx) -> Self {\n        let c = cx.spot(STUDIO, \"center\");\n        cx.player(c, 0.0);\n        cx.core.wobble = 0.8;\n        *cx.shot = Shot { tilt: 12.0, yaw: 0.0, distance: 8.5, fov: 36.0, height: 0.9, focus: c };\n        let a = cx.rng().range(0.0, 1.0);\n        let targets = [-0.7, 0.45 + a * 0.2, -0.3 - a * 0.2];\n        Self { intro: INTRO, targets, ..Default::default() }\n    }\n\n    pub fn current_target(&self) -> f32 {\n        self.targets[self.target_i.min(2) as usize]\n    }\n\n    /// Returns true when all four tests are done.\n    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        let dt = cx.dt;\n        if self.intro > 0.0 {\n            self.intro -= dt;\n            cx.lean_body(0.0);\n            cx.stop_clip();\n            return false;\n        }\n        self.t += dt;\n        let d = cx.core.cob.length();\n        self.rumble = 0.0;\n        match self.test {\n            0 => {\n                self.still += d * dt;\n                self.still_n += dt;\n                if self.t > 5.0 && !self.nudged {\n                    self.nudged = true;\n                    cx.core.nudge += Vec2::new(16.0, 4.0);\n                    cx.sfx(sfx::SQUEAK, 0.6, 1.0);\n                }\n                if self.t >= 8.0 {\n                    self.metric[0] = clamp01(1.0 - (self.still / self.still_n.max(0.1)) / 0.28);\n                    self.next(cx);\n                }\n            }\n            1 => {\n                self.target_t += dt;\n                let target = self.current_target();\n                if (cx.core.cob.x - target).abs() <= 0.06 {\n                    self.hold += dt;\n                } else {\n                    self.hold = 0.0;\n                }\n                if self.hold >= 1.5 || self.target_t >= 5.0 {\n                    let hit = self.hold >= 1.5;\n                    self.target_at[self.target_i as usize] = if hit { self.target_t } else { 6.5 };\n                    cx.sfx(if hit { sfx::STAR } else { sfx::SQUEAK }, 0.6, penta(self.target_i + 2));\n                    self.hold = 0.0;\n                    self.target_t = 0.0;\n                    self.target_i += 1;\n                    if self.target_i >= 3 {\n                        let mean = (self.target_at[0] + self.target_at[1] + self.target_at[2]) / 3.0;\n                        // 1.5 s is flawless (the hold itself), 5 s or a miss earns nothing.\n                        self.metric[1] = clamp01(1.0 - (mean - 1.7) / 3.3);\n                        self.next(cx);\n                    }\n                }\n            }\n            2 => {\n                self.blind += d * dt;\n                self.blind_n += dt;\n                self.tone_in -= dt;\n                if self.tone_in <= 0.0 {\n                    self.tone_in = 0.22;\n                    // Off centre, the tone rises; a touch to the right and it is brighter.\n                    let pitch = 1.0 + d * 1.6 + cx.core.cob.x * 0.25;\n                    cx.sfx(sfx::TONE, 0.6, pitch);\n                }\n                self.rumble = (d * 1.2).min(1.0);\n                if self.t >= 6.0 {\n                    self.metric[2] = clamp01(1.0 - (self.blind / self.blind_n.max(0.1)) / 0.3);\n                    self.next(cx);\n                }\n            }\n            _ => {\n                // A tick per step; the press nearest each tick counts, against the expected foot.\n                let beat = (self.t / STEP_BEAT) as u32;\n                if beat != self.last_tick {\n                    self.last_tick = beat;\n                    if beat < STEPS {\n                        cx.sfx(sfx::TICK, 0.7, if beat.is_multiple_of(2) { 1.0 } else { 1.2 });\n                    }\n                }\n                for (p, foot) in [(i.l_p, 0u32), (i.r_p, 1u32)] {\n                    if p && self.step_next < STEPS {\n                        let want = (self.step_next + 1) as f32 * STEP_BEAT;\n                        let err = (self.t - want).abs();\n                        let ok = self.step_next % 2 == foot;\n                        self.steps += if ok { clamp01(1.0 - err / 0.25) } else { 0.0 };\n                        self.step_n += 1;\n                        self.step_next += 1;\n                        cx.sfx(sfx::STEP, 0.7, 1.0);\n                        cx.gesture(if foot == 0 { \"FIT/StepL\" } else { \"FIT/StepR\" });\n                    }\n                }\n                if self.t >= (STEPS + 2) as f32 * STEP_BEAT {\n                    self.metric[3] = clamp01(self.steps / STEPS as f32);\n                    self.done = true;\n                    return true;\n                }\n            }\n        }\n        cx.lean_body(0.0);\n        false\n    }\n\n    fn next(&mut self, cx: &mut Cx) {\n        self.test += 1;\n        self.t = 0.0;\n        self.intro = INTRO;\n        cx.core.center();\n        cx.sfx(sfx::CONFIRM, 0.6, 1.0);\n    }\n\n    pub fn skill(&self) -> f32 {\n        0.30 * self.metric[0] + 0.25 * self.metric[1] + 0.25 * self.metric[2] + 0.20 * self.metric[3]\n    }\n\n    pub fn worst(&self) -> usize {\n        let mut w = 0;\n        for k in 1..4 {\n            if self.metric[k] < self.metric[w] {\n                w = k;\n            }\n        }\n        w\n    }\n\n    pub fn bot(&self, core: &BalanceCore, _r: &Rules) -> Intent {\n        let mut i = Intent::default();\n        match self.test {\n            1 => i.lean = pd(core, Vec2::new(self.current_target() / 0.92, 0.0)),\n            3 => {\n                let want = (self.step_next + 1) as f32 * STEP_BEAT;\n                if self.intro <= 0.0 && self.step_next < STEPS && (self.t - want).abs() < 0.012 {\n                    if self.step_next % 2 == 0 {\n                        i.l = true;\n                        i.l_p = true;\n                    } else {\n                        i.r = true;\n                        i.r_p = true;\n                    }\n                }\n            }\n            _ => i.lean = pd(core, Vec2::ZERO),\n        }\n        i\n    }\n\n    pub fn hud(&self, b: &mut B, core: &BalanceCore) {\n        let (name, how) = TESTS[self.test.min(3) as usize];\n        if self.test == 2 && self.intro <= 0.0 {\n            // Eyes Closed: the screen dims to almost black, and the Puck vanishes.\n            b.tint([6, 10, 18, 240]);\n            b.center(960.0, 980.0, 40.0, [150, 165, 180, 255], \"Listen.\");\n            return;\n        }\n        b.card([360.0, 30.0, 1560.0, 210.0], DECK);\n        b.title(960.0, 40.0, 72.0, TEAL, name);\n        b.center(960.0, 140.0, 40.0, INK, how);\n        b.title_left(60.0, 30.0, 72.0, INK, &format!(\"{}/4\", self.test + 1));\n        match self.test {\n            1 => {\n                // A left/right bar.\n                let (x0, x1, y) = (360.0, 1560.0, 940.0);\n                b.flat([x0, y, x1, y + 60.0], PALE, 30.0);\n                let at = |v: f32| x0 + (x1 - x0) * (v * 0.5 + 0.5);\n                let tg = self.current_target();\n                b.flat([at(tg - 0.06), y - 12.0, at(tg + 0.06), y + 72.0], MINT, 12.0);\n                b.circle([at(core.cob.x.clamp(-1.0, 1.0)), y + 30.0], 34.0, CORAL, WHITE, 5.0);\n                let (side, pct) = if tg < 0.0 { (\"left\", -tg) } else { (\"right\", tg) };\n                b.center(960.0, 860.0, 48.0, INK, &format!(\"Reach {}% {side}\", (pct * 100.0) as u32));\n            }\n            3 => {\n                for k in 0..STEPS {\n                    let x = 960.0 + (k as f32 - 3.5) * 120.0;\n                    let on = k < self.step_next;\n                    b.circle([x, 960.0], 44.0, if on { TEAL } else { PALE }, WHITE, 5.0);\n                }\n                let foot = if self.step_next % 2 == 0 { Glyph::StepL } else { Glyph::StepR };\n                b.prompt_center(960.0, 870.0, &[foot], \"On the tick\");\n            }\n            _ => {\n                b.puck(PUCK_TOP, PUCK_R, core.cob.into());\n                b.puck_ring([0.0, 0.0], 0.15);\n            }\n        }\n    }\n\n    /// Pip's words on it. `delta`: this morning's age against yesterday's (None the first day).\n    pub fn verdict(&self, age: i32, delta: Option<i32>, core: &BalanceCore, pick: u32) -> Vec<(u8, String)> {\n        let mut out = vec![(PIP, format!(\"Your Balance Age today is {age}. That is a number. Numbers cannot hurt you.\"))];\n        match delta {\n            Some(d) if d < 0 => out.push((PIP, script::line(\"pip_better\", pick))),\n            Some(d) if d > 0 => out.push((PIP, script::line(\"pip_worse\", pick))),\n            Some(_) => out.push((PIP, script::line(\"pip_same\", pick))),\n            None => out.push((PIP, script::line(\"pip_first_age\", pick))),\n        }\n        let total = (core.left_time + core.right_time).max(0.1);\n        let left = (core.left_time / total * 100.0) as u32;\n        let worst = self.worst();\n        let by = match worst {\n            0 => \"pip_worst_still\",\n            1 => \"pip_worst_targets\",\n            2 => \"pip_worst_blind\",\n            _ => \"pip_worst_steps\",\n        };\n        if left >= 60 {\n            out.push((PIP, format!(\"You leaned left {left}% of the time. Is everything all right on the right?\")));\n        } else {\n            out.push((PIP, script::line(by, pick)));\n        }\n        out\n    }\n}\n\n/// Keeps the import used on platforms with no other reference.\npub fn _center() -> Vec3 {\n    Vec3::ZERO\n}\nRS\nsed -i '/Keeps the import used/,$d' $F/check.rs\nsed -i 's/^use glam::{Vec2, Vec3};$/use glam::Vec2;/' $F/check.rs\ncat > $F/run.rs <<'RS'\n//! The common frame around an event: card, 3-2-1, play, result. Used for every event, the finale,\n//! the medley's legs and attract mode's segments.\n\nuse glam::Vec3;\nuse serde::{Deserialize, Serialize};\n\nuse super::core::BalanceCore;\nuse super::events::*;\nuse super::finale::Finale;\nuse super::ghost::Sample;\nuse super::rules::Rules;\nuse super::ui_model::*;\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub enum Phase {\n    Card,\n    Count,\n    Play,\n    Result,\n}\n\n/// Who started it, and so what follows it.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub enum RunCtx {\n    Stay,\n    Medley,\n    Attract,\n    Finale,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub enum Body {\n    Ev(Ev),\n    Stand(Box<Finale>),\n}\n\n/// A ghost in the next lane, from the save or from an earlier player.\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct RunGhost {\n    pub samples: Vec<Sample>,\n    pub skin: u8,\n    pub outfit: u8,\n    pub seat: u8,\n    pub name: String,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Run {\n    /// None: the Big Stand.\n    pub kind: Option<EvKind>,\n    pub phase: Phase,\n    pub t: f32,\n    pub core: BalanceCore,\n    pub body: Body,\n    pub actors: Vec<crate::entity::EntityId>,\n    pub shot: Shot,\n    pub msg: Option<(String, f32)>,\n    pub rec: Vec<Sample>,\n    pub rec_in: f32,\n    pub ghosts: Vec<RunGhost>,\n    pub ctx: RunCtx,\n    pub score: u32,\n    pub result: Option<ResultData>,\n    pub coach_in: f32,\n    pub demo: bool,\n    pub trace: Vec<[f32; 2]>,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct ResultData {\n    pub score: u32,\n    pub stars: u8,\n    pub title: String,\n    pub minutes: u32,\n    pub best: u32,\n    pub new_best: bool,\n    pub yesterday: Option<i32>,\n    pub comment: String,\n}\n\nimpl Run {\n    pub fn name(&self) -> &'static str {\n        self.kind.map(|k| k.name()).unwrap_or(\"The Big Stand\")\n    }\n\n    pub fn live_score(&self, r: &Rules) -> u32 {\n        match &self.body {\n            Body::Ev(e) => e.score(r),\n            Body::Stand(f) => f.score(r),\n        }\n    }\n\n    pub fn bot(&self, r: &Rules) -> Intent {\n        match &self.body {\n            Body::Ev(e) => e.bot(&self.core, r),\n            Body::Stand(f) => f.bot(&self.core, r),\n        }\n    }\n\n    pub fn tick_body(&mut self, cx: &mut Cx, i: &Intent, any: bool) -> bool {\n        match &mut self.body {\n            Body::Ev(e) => e.tick(cx, i),\n            Body::Stand(f) => f.tick(cx, i, any),\n        }\n    }\n\n    pub fn on_tip(&mut self, cx: &mut Cx) {\n        match &mut self.body {\n            Body::Ev(Ev::Paddle(p)) => p.on_tip(cx),\n            Body::Ev(Ev::Pose(p)) => {\n                p.on_tip();\n                cx.tip_fx(false);\n            }\n            Body::Stand(f) => f.on_tip(cx),\n            Body::Ev(Ev::Tide(_)) => {}\n            Body::Ev(_) => cx.tip_fx(false),\n        }\n    }\n\n    pub fn draw_card(&self, b: &mut B, name: &str, goal: &str, line: &str, who: &str, how: &[(Glyph, &str)]) {\n        b.tint([214, 238, 246, 90]);\n        b.card([360.0, 160.0, 1560.0, 900.0], DECK);\n        b.title(960.0, 200.0, 96.0, TEAL, name);\n        b.wrap_center(960.0, 330.0, 1060.0, 48.0, INK, goal);\n        let mut y = 480.0;\n        for (g, label) in how {\n            b.prompt(480.0, y, &[*g], label);\n            y += 72.0;\n        }\n        b.wrap_center(960.0, 700.0, 1060.0, 40.0, MUTED, &format!(\"{who}: \\\"{line}\\\"\"));\n        b.prompt_center(960.0, 820.0, &[Glyph::Confirm], \"Begin\");\n    }\n\n    pub fn draw_hud(&self, b: &mut B, r: &Rules) {\n        match &self.body {\n            Body::Ev(e) => e.hud(b, &self.core, r),\n            Body::Stand(f) => f.hud(b, &self.core, r),\n        }\n        if !self.trace.is_empty() {\n            if let Some(Ui::Puck { trace, .. }) = b.items.iter_mut().rev().find(|i| matches!(i, Ui::Puck { .. })) {\n                trace.clone_from(&self.trace);\n            }\n        }\n    }\n}\n\n/// What the events ask of the hands, for their cards.\npub fn how_to(kind: Option<EvKind>) -> Vec<(Glyph, &'static str)> {\n    match kind {\n        Some(EvKind::Breath) => vec![(Glyph::Confirm, \"Hold to breathe in, release to breathe out\"), (Glyph::Lean, \"Keep the dot in the ring\")],\n        Some(EvKind::Pose) => vec![(Glyph::Lean, \"Stay in the drifting ring to climb the multiplier\")],\n        Some(EvKind::Squats) => vec![(Glyph::Confirm, \"Hold to go down, release to rise\"), (Glyph::Lean, \"Keep the dot in the band\")],\n        Some(EvKind::Plank) => vec![(Glyph::Brace, \"Hold both to stay up\"), (Glyph::Lean, \"Keep the dot in the ring\")],\n        Some(EvKind::Step) => vec![(Glyph::StepL, \"Left note\"), (Glyph::StepR, \"Right note\")],\n        Some(EvKind::Spin) => vec![(Glyph::Lean, \"Circle the lean. Keep to the green band\"), (Glyph::StepL, \"Catch a ring from the left\"), (Glyph::StepR, \"Catch a ring from the right\")],\n        Some(EvKind::Lap) => vec![(Glyph::StepL, \"Alternate left\"), (Glyph::StepR, \"and right to set your pace\"), (Glyph::Lean, \"Move aside for crabs, toward ribbons\")],\n        Some(EvKind::Tide) => vec![(Glyph::Lean, \"Tilt the raft. Roll the crabs into the pools, gently\")],\n        Some(EvKind::Paddle) => vec![(Glyph::Lean, \"Sideways to steer, forward for speed, back to brake\")],\n        Some(EvKind::Tray) => vec![(Glyph::Lean, \"Keep the tray level against the pier's roll\")],\n        Some(EvKind::Cannon) => vec![(Glyph::Confirm, \"Press at the bottom of each bounce, then hold to tuck\"), (Glyph::Lean, \"Rotate in the air\")],\n        None => vec![(Glyph::Lean, \"Everything you have learned\"), (Glyph::Confirm, \"Then, at the end, nothing at all\")],\n    }\n}\n\n/// A short goal for the card.\npub fn goal(kind: Option<EvKind>) -> &'static str {\n    match kind {\n        Some(EvKind::Breath) => \"Follow the guide ring. Bloom the pond.\",\n        Some(EvKind::Pose) => \"Hold three poses. There may be a bird.\",\n        Some(EvKind::Squats) => \"Ten squats to the tempo bar. Also eleven.\",\n        Some(EvKind::Plank) => \"Stay up as long as you can. Kettle believes in you, from a distance.\",\n        Some(EvKind::Step) => \"Step on the beat. Clap if you must.\",\n        Some(EvKind::Spin) => \"Spin the rings around your hips and do not drop them.\",\n        Some(EvKind::Lap) => \"One lap of the island. Bounce will wait, a little.\",\n        Some(EvKind::Tide) => \"Roll every crab into a tide pool. They signed something.\",\n        Some(EvKind::Paddle) => \"Pass every gate, quickly, on a board, on the sea.\",\n        Some(EvKind::Tray) => \"Carry five smoothies down the pier to Marjorie.\",\n        Some(EvKind::Cannon) => \"Three dives. We are not here for form. We are here for splash.\",\n        None => \"Five tests on a tiny post, with everyone watching. The last one is nothing.\",\n    }\n}\n\n/// The lanes a list of ghosts takes up, away from the player.\npub fn ghost_lane(kind: Option<EvKind>, n: usize) -> Vec3 {\n    let base = kind.map(|k| k.lane()).unwrap_or(Vec3::new(6.0, 0.0, 0.0));\n    base * (n as f32 + 1.0)\n}\nRS\n","description":"Write finale, morning check and run framing"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":23468,"cache_read_input_tokens":345414,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":23468},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cb437ba7-0477-4143-bb04-ff33f49efd62","uuid":"697faf53-7506-4654-8da0-f7eb57bebcfb","timestamp":"2026-11-05T06:01:42.377Z","request_id":"req_011CgjGcPcWeQFTUDHddDp4y","wire_tool_inputs":{"toolu_01X1KqzoSQUskURoce7Aj9K8":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953\nF=engine/crates/pav_core/src/games/fit\npython3 - <<'PY'\np='engine/crates/pav_core/src/games/fit/events/step.rs'\ns=open(p).read()\ns=s.replace('''        cx.ev.push(SimEvent::Music { song: if o.band { 6 } else { 4 } });\n        Self {''','''        Self {''')\ns=s.replace('''    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        let dt = cx.dt;\n        self.t += dt;\n        // The music's clock''','''    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        let dt = cx.dt;\n        if self.t == 0.0 {\n            // The song starts with the first tick of play, so its clock and the chart agree.\n            cx.ev.push(SimEvent::Music { song: if self.band { 6 } else { 4 } });\n        }\n        self.t += dt;\n        // The music's clock''')\nopen(p,'w').write(s)\nPY\ncat > $F/finale.rs <<'RS'\n//! The Big Stand: five phases on a tiny post in the bay, reusing the events with new numbers.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::core::BalanceCore;\nuse super::events::stillness::Stillness;\nuse super::events::*;\nuse super::rules::Rules;\nuse super::sfx;\nuse super::ui_model::*;\nuse crate::frame::SimEvent;\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Finale {\n    pub phase: u32,\n    pub ev: Option<Ev>,\n    pub still: Option<Stillness>,\n    pub phase_scores: Vec<u32>,\n    pub post: Vec3,\n    pub tips: u32,\n    pub peace: bool,\n    pub over: f32,\n}\n\npub const PHASES: [&str; 5] = [\"Breathe\", \"Hold a pose\", \"March\", \"Brace\", \"The Long Stillness\"];\n\nimpl Finale {\n    pub fn start(cx: &mut Cx, first: u32) -> Self {\n        let post = cx.spot(BAY, \"post\");\n        let mut f = Self { phase: first, ev: None, still: None, phase_scores: Vec::new(), post, tips: 0, peace: false, over: 0.0 };\n        cx.player(post, 0.0);\n        cx.ev.push(SimEvent::Music { song: 6 });\n        f.enter(cx);\n        f\n    }\n\n    fn enter(&mut self, cx: &mut Cx) {\n        let at = Some(self.post);\n        cx.core.center();\n        cx.stop_clip();\n        cx.say(PHASES[self.phase.min(4) as usize], 2.5);\n        cx.sfx(sfx::GONG, 0.6, 1.0);\n        self.ev = None;\n        self.still = None;\n        match self.phase {\n            0 => self.ev = Some(Ev::start(EvKind::Breath, cx, Opt { count: Some(4), at, ..Default::default() })),\n            1 => self.ev = Some(Ev::start(EvKind::Pose, cx, Opt { count: Some(1), seconds: Some(20.0), at, band: true })),\n            2 => self.ev = Some(Ev::start(EvKind::Step, cx, Opt { count: Some(16), at, band: true, ..Default::default() })),\n            3 => self.ev = Some(Ev::start(EvKind::Plank, cx, Opt { seconds: Some(20.0), at, band: true, ..Default::default() })),\n            _ => {\n                self.still = Some(Stillness::new(cx.r.finale.stillness));\n                cx.player(self.post, 0.0);\n                cx.mirror_shot(self.post, 7.0);\n            }\n        }\n        if self.phase < 4 {\n            *cx.shot = Shot { tilt: 14.0, yaw: 0.0, distance: 10.0, fov: 36.0, height: 0.9, focus: self.post };\n        }\n    }\n\n    /// `any` is any input at all (the Long Stillness listens for it).\n    pub fn tick(&mut self, cx: &mut Cx, i: &Intent, any: bool) -> bool {\n        if self.over > 0.0 {\n            self.over -= cx.dt;\n            return self.over <= 0.0;\n        }\n        if let Some(s) = &mut self.still {\n            if s.tick(cx, any) {\n                self.peace = !s.broke;\n                let line = if self.peace { \"...Oh. You're still here. Good.\".to_string() } else { \"...You pressed something. I wrote it down.\".to_string() };\n                cx.say(line, 5.0);\n                cx.sfx(sfx::CHEER, 0.8, 1.0);\n                cx.ev.push(SimEvent::Burst { pos: self.post + Vec3::Y * 4.0, kind: 0, count: 90 });\n                self.over = 4.0;\n            }\n            return false;\n        }\n        let done = self.ev.as_mut().is_some_and(|e| e.tick(cx, i));\n        cx.player_keep_post(self.post, self.phase);\n        if done {\n            let sc = self.ev.as_ref().map(|e| e.score(cx.r)).unwrap_or(0);\n            self.phase_scores.push(sc);\n            self.phase += 1;\n            self.enter(cx);\n        }\n        false\n    }\n\n    pub fn on_tip(&mut self, cx: &mut Cx) {\n        self.tips += 1;\n        cx.ev.push(SimEvent::BigSplash { pos: self.post, size: 0.5 });\n        cx.sfx(sfx::SPLASH_B, 0.7, 1.2);\n        cx.sfx(sfx::GROAN, 0.9, 1.0);\n        let line = cx.pick(\"finale_tip\");\n        cx.say(line, 2.5);\n    }\n\n    pub fn bot(&self, core: &BalanceCore, r: &Rules) -> Intent {\n        match &self.ev {\n            Some(e) => e.bot(core, r),\n            None => Intent { lean: Vec2::ZERO, ..Default::default() },\n        }\n    }\n\n    pub fn hud(&self, b: &mut B, core: &BalanceCore, r: &Rules) {\n        if let Some(s) = &self.still {\n            s.hud(b, core);\n            return;\n        }\n        if let Some(e) = &self.ev {\n            e.hud(b, core, r);\n        }\n        b.center(960.0, 1020.0, 36.0, INK, &format!(\"Phase {} of 5\", self.phase.min(4) + 1));\n    }\n\n    pub fn score(&self, r: &Rules) -> u32 {\n        // Four phases share what the Inner Peace bonus leaves; tips cost a little.\n        let sum: u32 = self.phase_scores.iter().sum();\n        let base = (1000.0 - r.finale.bonus) * sum as f32 / 4000.0;\n        let bonus = if self.peace { r.finale.bonus } else { 0.0 };\n        (base + bonus - self.tips as f32 * r.finale.tip_cost).clamp(0.0, 1000.0) as u32\n    }\n}\n\nimpl Cx<'_> {\n    /// On the post the figure stays put, even when an event moved it for its own stage.\n    fn player_keep_post(&mut self, post: Vec3, _phase: u32) {\n        if let Some(f) = self.sim.feet(self.pid) {\n            if (f - post).length() > 0.5 {\n                self.sim.set_position(self.pid, post);\n            }\n        }\n    }\n}\nRS\ncat > $F/check.rs <<'RS'\n//! The Morning Wobble Check: four micro-tests, Pip presiding, then the verdict.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::core::BalanceCore;\nuse super::events::*;\nuse super::rules::Rules;\nuse super::script::{self, PIP};\nuse super::sfx;\nuse super::ui_model::*;\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Check {\n    pub test: u32,\n    pub t: f32,\n    pub intro: f32,\n    pub still: f32,\n    still_n: f32,\n    nudged: bool,\n    pub targets: [f32; 3],\n    target_i: u32,\n    hold: f32,\n    target_t: f32,\n    pub target_at: [f32; 3],\n    pub blind: f32,\n    blind_n: f32,\n    tone_in: f32,\n    pub steps: f32,\n    pub step_n: u32,\n    step_next: u32,\n    pub metric: [f32; 4],\n    pub done: bool,\n    last_tick: u32,\n    pub rumble: f32,\n}\n\npub const TESTS: [(&str, &str); 4] = [\n    (\"Stand Still\", \"This is the whole test.\"),\n    (\"Lean Targets\", \"Lean to the mark and stay there.\"),\n    (\"Eyes Closed\", \"Close your eyes. The tone tells you where you are. The tone is honest.\"),\n    (\"Step Test\", \"Eight steps, left and right, to the tick.\"),\n];\n\nconst INTRO: f32 = 3.0;\nconst STEP_BEAT: f32 = 0.6; // 100 BPM\nconst STEPS: u32 = 8;\n\nimpl Check {\n    pub fn new(cx: &mut Cx) -> Self {\n        let c = cx.spot(STUDIO, \"center\");\n        cx.player(c, 0.0);\n        cx.core.wobble = 0.8;\n        *cx.shot = Shot { tilt: 12.0, yaw: 0.0, distance: 8.5, fov: 36.0, height: 0.9, focus: c };\n        let a = cx.rng().range(0.0, 1.0);\n        let targets = [-0.7, 0.45 + a * 0.2, -0.3 - a * 0.2];\n        Self { intro: INTRO, targets, ..Default::default() }\n    }\n\n    pub fn current_target(&self) -> f32 {\n        self.targets[self.target_i.min(2) as usize]\n    }\n\n    /// Returns true when all four tests are done.\n    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        let dt = cx.dt;\n        if self.intro > 0.0 {\n            self.intro -= dt;\n            cx.lean_body(0.0);\n            cx.stop_clip();\n            return false;\n        }\n        self.t += dt;\n        let d = cx.core.cob.length();\n        self.rumble = 0.0;\n        match self.test {\n            0 => {\n                self.still += d * dt;\n                self.still_n += dt;\n                if self.t > 5.0 && !self.nudged {\n                    self.nudged = true;\n                    cx.core.nudge += Vec2::new(16.0, 4.0);\n                    cx.sfx(sfx::SQUEAK, 0.6, 1.0);\n                }\n                if self.t >= 8.0 {\n                    self.metric[0] = clamp01(1.0 - (self.still / self.still_n.max(0.1)) / 0.28);\n                    self.next(cx);\n                }\n            }\n            1 => {\n                self.target_t += dt;\n                let target = self.current_target();\n                if (cx.core.cob.x - target).abs() <= 0.06 {\n                    self.hold += dt;\n                } else {\n                    self.hold = 0.0;\n                }\n                if self.hold >= 1.5 || self.target_t >= 5.0 {\n                    let hit = self.hold >= 1.5;\n                    self.target_at[self.target_i as usize] = if hit { self.target_t } else { 6.5 };\n                    cx.sfx(if hit { sfx::STAR } else { sfx::SQUEAK }, 0.6, penta(self.target_i + 2));\n                    self.hold = 0.0;\n                    self.target_t = 0.0;\n                    self.target_i += 1;\n                    if self.target_i >= 3 {\n                        let mean = (self.target_at[0] + self.target_at[1] + self.target_at[2]) / 3.0;\n                        // 1.5 s is flawless (the hold itself), 5 s or a miss earns nothing.\n                        self.metric[1] = clamp01(1.0 - (mean - 1.7) / 3.3);\n                        self.next(cx);\n                    }\n                }\n            }\n            2 => {\n                self.blind += d * dt;\n                self.blind_n += dt;\n                self.tone_in -= dt;\n                if self.tone_in <= 0.0 {\n                    self.tone_in = 0.22;\n                    // Off centre, the tone rises; a touch to the right and it is brighter.\n                    let pitch = 1.0 + d * 1.6 + cx.core.cob.x * 0.25;\n                    cx.sfx(sfx::TONE, 0.6, pitch);\n                }\n                self.rumble = (d * 1.2).min(1.0);\n                if self.t >= 6.0 {\n                    self.metric[2] = clamp01(1.0 - (self.blind / self.blind_n.max(0.1)) / 0.3);\n                    self.next(cx);\n                }\n            }\n            _ => {\n                // A tick per step; the press nearest each tick counts, against the expected foot.\n                let beat = (self.t / STEP_BEAT) as u32;\n                if beat != self.last_tick {\n                    self.last_tick = beat;\n                    if beat < STEPS {\n                        cx.sfx(sfx::TICK, 0.7, if beat.is_multiple_of(2) { 1.0 } else { 1.2 });\n                    }\n                }\n                for (p, foot) in [(i.l_p, 0u32), (i.r_p, 1u32)] {\n                    if p && self.step_next < STEPS {\n                        let want = (self.step_next + 1) as f32 * STEP_BEAT;\n                        let err = (self.t - want).abs();\n                        let ok = self.step_next % 2 == foot;\n                        self.steps += if ok { clamp01(1.0 - err / 0.25) } else { 0.0 };\n                        self.step_n += 1;\n                        self.step_next += 1;\n                        cx.sfx(sfx::STEP, 0.7, 1.0);\n                        cx.gesture(if foot == 0 { \"FIT/StepL\" } else { \"FIT/StepR\" });\n                    }\n                }\n                if self.t >= (STEPS + 2) as f32 * STEP_BEAT {\n                    self.metric[3] = clamp01(self.steps / STEPS as f32);\n                    self.done = true;\n                    return true;\n                }\n            }\n        }\n        cx.lean_body(0.0);\n        false\n    }\n\n    fn next(&mut self, cx: &mut Cx) {\n        self.test += 1;\n        self.t = 0.0;\n        self.intro = INTRO;\n        cx.core.center();\n        cx.sfx(sfx::CONFIRM, 0.6, 1.0);\n    }\n\n    pub fn skill(&self) -> f32 {\n        0.30 * self.metric[0] + 0.25 * self.metric[1] + 0.25 * self.metric[2] + 0.20 * self.metric[3]\n    }\n\n    pub fn worst(&self) -> usize {\n        let mut w = 0;\n        for k in 1..4 {\n            if self.metric[k] < self.metric[w] {\n                w = k;\n            }\n        }\n        w\n    }\n\n    pub fn bot(&self, core: &BalanceCore, _r: &Rules) -> Intent {\n        let mut i = Intent::default();\n        match self.test {\n            1 => i.lean = pd(core, Vec2::new(self.current_target() / 0.92, 0.0)),\n            3 => {\n                let want = (self.step_next + 1) as f32 * STEP_BEAT;\n                if self.intro <= 0.0 && self.step_next < STEPS && (self.t - want).abs() < 0.012 {\n                    if self.step_next % 2 == 0 {\n                        i.l = true;\n                        i.l_p = true;\n                    } else {\n                        i.r = true;\n                        i.r_p = true;\n                    }\n                }\n            }\n            _ => i.lean = pd(core, Vec2::ZERO),\n        }\n        i\n    }\n\n    pub fn hud(&self, b: &mut B, core: &BalanceCore) {\n        let (name, how) = TESTS[self.test.min(3) as usize];\n        if self.test == 2 && self.intro <= 0.0 {\n            // Eyes Closed: the screen dims to almost black, and the Puck vanishes.\n            b.tint([6, 10, 18, 240]);\n            b.center(960.0, 980.0, 40.0, [150, 165, 180, 255], \"Listen.\");\n            return;\n        }\n        b.card([360.0, 30.0, 1560.0, 210.0], DECK);\n        b.title(960.0, 40.0, 72.0, TEAL, name);\n        b.center(960.0, 140.0, 40.0, INK, how);\n        b.title_left(60.0, 30.0, 72.0, INK, &format!(\"{}/4\", self.test + 1));\n        match self.test {\n            1 => {\n                // A left/right bar.\n                let (x0, x1, y) = (360.0, 1560.0, 940.0);\n                b.flat([x0, y, x1, y + 60.0], PALE, 30.0);\n                let at = |v: f32| x0 + (x1 - x0) * (v * 0.5 + 0.5);\n                let tg = self.current_target();\n                b.flat([at(tg - 0.06), y - 12.0, at(tg + 0.06), y + 72.0], MINT, 12.0);\n                b.circle([at(core.cob.x.clamp(-1.0, 1.0)), y + 30.0], 34.0, CORAL, WHITE, 5.0);\n                let (side, pct) = if tg < 0.0 { (\"left\", -tg) } else { (\"right\", tg) };\n                b.center(960.0, 860.0, 48.0, INK, &format!(\"Reach {}% {side}\", (pct * 100.0) as u32));\n            }\n            3 => {\n                for k in 0..STEPS {\n                    let x = 960.0 + (k as f32 - 3.5) * 120.0;\n                    let on = k < self.step_next;\n                    b.circle([x, 960.0], 44.0, if on { TEAL } else { PALE }, WHITE, 5.0);\n                }\n                let foot = if self.step_next % 2 == 0 { Glyph::StepL } else { Glyph::StepR };\n                b.prompt_center(960.0, 870.0, &[foot], \"On the tick\");\n            }\n            _ => {\n                b.puck(PUCK_TOP, PUCK_R, core.cob.into());\n                b.puck_ring([0.0, 0.0], 0.15);\n            }\n        }\n    }\n\n    /// Pip's words on it. `delta`: this morning's age against yesterday's (None the first day).\n    pub fn verdict(&self, age: i32, delta: Option<i32>, core: &BalanceCore, pick: u32) -> Vec<(u8, String)> {\n        let mut out = vec![(PIP, format!(\"Your Balance Age today is {age}. That is a number. Numbers cannot hurt you.\"))];\n        match delta {\n            Some(d) if d < 0 => out.push((PIP, script::line(\"pip_better\", pick))),\n            Some(d) if d > 0 => out.push((PIP, script::line(\"pip_worse\", pick))),\n            Some(_) => out.push((PIP, script::line(\"pip_same\", pick))),\n            None => out.push((PIP, script::line(\"pip_first_age\", pick))),\n        }\n        let total = (core.left_time + core.right_time).max(0.1);\n        let left = (core.left_time / total * 100.0) as u32;\n        let worst = self.worst();\n        let by = match worst {\n            0 => \"pip_worst_still\",\n            1 => \"pip_worst_targets\",\n            2 => \"pip_worst_blind\",\n            _ => \"pip_worst_steps\",\n        };\n        if left >= 60 {\n            out.push((PIP, format!(\"You leaned left {left}% of the time. Is everything all right on the right?\")));\n        } else {\n            out.push((PIP, script::line(by, pick)));\n        }\n        out\n    }\n}\n\n/// Keeps the import used on platforms with no other reference.\npub fn _center() -> Vec3 {\n    Vec3::ZERO\n}\nRS\nsed -i '/Keeps the import used/,$d' $F/check.rs\nsed -i 's/^use glam::{Vec2, Vec3};$/use glam::Vec2;/' $F/check.rs\ncat > $F/run.rs <<'RS'\n//! The common frame around an event: card, 3-2-1, play, result. Used for every event, the finale,\n//! the medley's legs and attract mode's segments.\n\nuse glam::Vec3;\nuse serde::{Deserialize, Serialize};\n\nuse super::core::BalanceCore;\nuse super::events::*;\nuse super::finale::Finale;\nuse super::ghost::Sample;\nuse super::rules::Rules;\nuse super::ui_model::*;\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub enum Phase {\n    Card,\n    Count,\n    Play,\n    Result,\n}\n\n/// Who started it, and so what follows it.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub enum RunCtx {\n    Stay,\n    Medley,\n    Attract,\n    Finale,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub enum Body {\n    Ev(Ev),\n    Stand(Box<Finale>),\n}\n\n/// A ghost in the next lane, from the save or from an earlier player.\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct RunGhost {\n    pub samples: Vec<Sample>,\n    pub skin: u8,\n    pub outfit: u8,\n    pub seat: u8,\n    pub name: String,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Run {\n    /// None: the Big Stand.\n    pub kind: Option<EvKind>,\n    pub phase: Phase,\n    pub t: f32,\n    pub core: BalanceCore,\n    pub body: Body,\n    pub actors: Vec<crate::entity::EntityId>,\n    pub shot: Shot,\n    pub msg: Option<(String, f32)>,\n    pub rec: Vec<Sample>,\n    pub rec_in: f32,\n    pub ghosts: Vec<RunGhost>,\n    pub ctx: RunCtx,\n    pub score: u32,\n    pub result: Option<ResultData>,\n    pub coach_in: f32,\n    pub demo: bool,\n    pub trace: Vec<[f32; 2]>,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct ResultData {\n    pub score: u32,\n    pub stars: u8,\n    pub title: String,\n    pub minutes: u32,\n    pub best: u32,\n    pub new_best: bool,\n    pub yesterday: Option<i32>,\n    pub comment: String,\n}\n\nimpl Run {\n    pub fn name(&self) -> &'static str {\n        self.kind.map(|k| k.name()).unwrap_or(\"The Big Stand\")\n    }\n\n    pub fn live_score(&self, r: &Rules) -> u32 {\n        match &self.body {\n            Body::Ev(e) => e.score(r),\n            Body::Stand(f) => f.score(r),\n        }\n    }\n\n    pub fn bot(&self, r: &Rules) -> Intent {\n        match &self.body {\n            Body::Ev(e) => e.bot(&self.core, r),\n            Body::Stand(f) => f.bot(&self.core, r),\n        }\n    }\n\n    pub fn tick_body(&mut self, cx: &mut Cx, i: &Intent, any: bool) -> bool {\n        match &mut self.body {\n            Body::Ev(e) => e.tick(cx, i),\n            Body::Stand(f) => f.tick(cx, i, any),\n        }\n    }\n\n    pub fn on_tip(&mut self, cx: &mut Cx) {\n        match &mut self.body {\n            Body::Ev(Ev::Paddle(p)) => p.on_tip(cx),\n            Body::Ev(Ev::Pose(p)) => {\n                p.on_tip();\n                cx.tip_fx(false);\n            }\n            Body::Stand(f) => f.on_tip(cx),\n            Body::Ev(Ev::Tide(_)) => {}\n            Body::Ev(_) => cx.tip_fx(false),\n        }\n    }\n\n    pub fn draw_card(&self, b: &mut B, name: &str, goal: &str, line: &str, who: &str, how: &[(Glyph, &str)]) {\n        b.tint([214, 238, 246, 90]);\n        b.card([360.0, 160.0, 1560.0, 900.0], DECK);\n        b.title(960.0, 200.0, 96.0, TEAL, name);\n        b.wrap_center(960.0, 330.0, 1060.0, 48.0, INK, goal);\n        let mut y = 480.0;\n        for (g, label) in how {\n            b.prompt(480.0, y, &[*g], label);\n            y += 72.0;\n        }\n        b.wrap_center(960.0, 700.0, 1060.0, 40.0, MUTED, &format!(\"{who}: \\\"{line}\\\"\"));\n        b.prompt_center(960.0, 820.0, &[Glyph::Confirm], \"Begin\");\n    }\n\n    pub fn draw_hud(&self, b: &mut B, r: &Rules) {\n        match &self.body {\n            Body::Ev(e) => e.hud(b, &self.core, r),\n            Body::Stand(f) => f.hud(b, &self.core, r),\n        }\n        if !self.trace.is_empty() {\n            if let Some(Ui::Puck { trace, .. }) = b.items.iter_mut().rev().find(|i| matches!(i, Ui::Puck { .. })) {\n                trace.clone_from(&self.trace);\n            }\n        }\n    }\n}\n\n/// What the events ask of the hands, for their cards.\npub fn how_to(kind: Option<EvKind>) -> Vec<(Glyph, &'static str)> {\n    match kind {\n        Some(EvKind::Breath) => vec![(Glyph::Confirm, \"Hold to breathe in, release to breathe out\"), (Glyph::Lean, \"Keep the dot in the ring\")],\n        Some(EvKind::Pose) => vec![(Glyph::Lean, \"Stay in the drifting ring to climb the multiplier\")],\n        Some(EvKind::Squats) => vec![(Glyph::Confirm, \"Hold to go down, release to rise\"), (Glyph::Lean, \"Keep the dot in the band\")],\n        Some(EvKind::Plank) => vec![(Glyph::Brace, \"Hold both to stay up\"), (Glyph::Lean, \"Keep the dot in the ring\")],\n        Some(EvKind::Step) => vec![(Glyph::StepL, \"Left note\"), (Glyph::StepR, \"Right note\")],\n        Some(EvKind::Spin) => vec![(Glyph::Lean, \"Circle the lean. Keep to the green band\"), (Glyph::StepL, \"Catch a ring from the left\"), (Glyph::StepR, \"Catch a ring from the right\")],\n        Some(EvKind::Lap) => vec![(Glyph::StepL, \"Alternate left\"), (Glyph::StepR, \"and right to set your pace\"), (Glyph::Lean, \"Move aside for crabs, toward ribbons\")],\n        Some(EvKind::Tide) => vec![(Glyph::Lean, \"Tilt the raft. Roll the crabs into the pools, gently\")],\n        Some(EvKind::Paddle) => vec![(Glyph::Lean, \"Sideways to steer, forward for speed, back to brake\")],\n        Some(EvKind::Tray) => vec![(Glyph::Lean, \"Keep the tray level against the pier's roll\")],\n        Some(EvKind::Cannon) => vec![(Glyph::Confirm, \"Press at the bottom of each bounce, then hold to tuck\"), (Glyph::Lean, \"Rotate in the air\")],\n        None => vec![(Glyph::Lean, \"Everything you have learned\"), (Glyph::Confirm, \"Then, at the end, nothing at all\")],\n    }\n}\n\n/// A short goal for the card.\npub fn goal(kind: Option<EvKind>) -> &'static str {\n    match kind {\n        Some(EvKind::Breath) => \"Follow the guide ring. Bloom the pond.\",\n        Some(EvKind::Pose) => \"Hold three poses. There may be a bird.\",\n        Some(EvKind::Squats) => \"Ten squats to the tempo bar. Also eleven.\",\n        Some(EvKind::Plank) => \"Stay up as long as you can. Kettle believes in you, from a distance.\",\n        Some(EvKind::Step) => \"Step on the beat. Clap if you must.\",\n        Some(EvKind::Spin) => \"Spin the rings around your hips and do not drop them.\",\n        Some(EvKind::Lap) => \"One lap of the island. Bounce will wait, a little.\",\n        Some(EvKind::Tide) => \"Roll every crab into a tide pool. They signed something.\",\n        Some(EvKind::Paddle) => \"Pass every gate, quickly, on a board, on the sea.\",\n        Some(EvKind::Tray) => \"Carry five smoothies down the pier to Marjorie.\",\n        Some(EvKind::Cannon) => \"Three dives. We are not here for form. We are here for splash.\",\n        None => \"Five tests on a tiny post, with everyone watching. The last one is nothing.\",\n    }\n}\n\n/// The lanes a list of ghosts takes up, away from the player.\npub fn ghost_lane(kind: Option<EvKind>, n: usize) -> Vec3 {\n    let base = kind.map(|k| k.lane()).unwrap_or(Vec3::new(6.0, 0.0, 0.0));\n    base * (n as f32 + 1.0)\n}\nRS\n","description":"Write finale, morning check and run framing"}}}
