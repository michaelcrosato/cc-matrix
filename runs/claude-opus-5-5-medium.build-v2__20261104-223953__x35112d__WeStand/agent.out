'\n            if ring<1.4 and d<=8: c='p'\n            if abs(x+.5-40)<2.2 and z+.5>30 and z+.5<55: c='p'   # the walk down to the pier\n            if abs(x+.5-40)<2.2 and z+.5>9 and z+.5<30: c='p'    # up to the cabanas\n            if abs(z+.5-30)<1.6 and abs(x+.5-40)<25: c='p' if ring>=1.4 else c\n            r+=c''','''            # Tiles are the ground to stand on and the grass; smooth objects draw the outlines over them.\n            c='~'\n            if d<=10.0: c='s'\n            if d<=7.4: c='g'\n            r+=c''')\ns=s.replace('''[layout.legend.'p']\nblocks = [{ y0 = -2.5, y1 = 0, color = \"#fbfaf6\", look = \"flat\" }]\n''','')\ns=s.replace('''    t+=view(cx=40,cz=30)\n''','''    t+=view(cx=40,cz=30)\n    # The island's smooth shore and lawn: a stadium of boxes and corner discs over the tiles.\n    def stadium(hx,hz,rad,y,color,name):\n        o=''\n        for (a,b) in ((hx+rad,hz),(hx,hz+rad)):\n            o+=f'\\\\n[[object]]\\\\nname = \"{name}\"\\\\nshape = {{ type = \"box\", half = [{a}, 0.05, {b}] }}\\\\npos = [40.0, {y}, 30.0]\\\\ncolor = \"{color}\"\\\\nlook = \"flat\"\\\\nbody = \"none\"\\\\n'\n        for sx in (-1,1):\n            for sz in (-1,1):\n                o+=f'\\\\n[[object]]\\\\nname = \"{name}\"\\\\nshape = {{ type = \"cylinder\", half_height = 0.05, radius = {rad} }}\\\\npos = [{40+sx*hx}.0, {y}, {30+sz*hz}.0]\\\\ncolor = \"{color}\"\\\\nlook = \"flat\"\\\\nbody = \"none\"\\\\n'\n        return o\n    t+=stadium(23,15,10.5,-0.03,\"#f6e7c8\",\"shore\")+stadium(23,15,8.2,-0.015,\"#bfe6b0\",\"lawn\")\n    # The ring path as a smooth band, and the walks: pale flat strips.\n    n=70\n    for i in range(n):\n        a=i/n*math.tau\n        px,pz=40+25*math.cos(a),30+18*math.sin(a)\n        tx,tz=-25*math.sin(a),18*math.cos(a)\n        yaw=round(math.degrees(math.atan2(tx,tz)),1)\n        ln=math.hypot(tx,tz)*math.tau/n/2+.12\n        t+=f'\\\\n[[object]]\\\\nname = \"path\"\\\\nshape = {{ type = \"box\", half = [1.35, 0.02, {round(ln,2)}] }}\\\\npos = [{round(px,2)}, -0.0, {round(pz,2)}]\\\\nyaw = {yaw}\\\\ncolor = \"#fbfaf6\"\\\\nlook = \"flat\"\\\\nbody = \"none\"\\\\n'\n    for (cx,cz,hx,hz) in ((40,19.5,2.0,9.5),(40,42.5,2.0,12.5),(27.5,30,12.5,1.5),(52.5,30,12.5,1.5),(40,28,5,3.5)):\n        t+=f'\\\\n[[object]]\\\\nname = \"walk\"\\\\nshape = {{ type = \"box\", half = [{hx}, 0.02, {hz}] }}\\\\npos = [{cx}, 0.002, {cz}]\\\\ncolor = \"#fbfaf6\"\\\\nlook = \"flat\"\\\\nbody = \"none\"\\\\n'\n''')\ns=s.replace('''    for a in (40,140,220,320):\n        r=math.radians(a); b+=obj(\"fit_lamp\",round(30+6.4*math.cos(r),1),round(30+6.4*math.sin(r)*.9,1))''','''    for a in (200,250,290,340):\n        r=math.radians(a); b+=obj(\"fit_lamp\",round(30+6.4*math.cos(r),1),round(30+6.4*math.sin(r),1))''')\nopen(p,'w').write(s)\np='engine/crates/pav_core/src/games/fit/events/pose.rs'\ns=open(p).read()\ns=s.replace('''        // Each day brings new poses; the seed turns the parade.\n        let first = (cx.seed % 2) * 3;''','''        // Day 1 uses the first three poses; later days turn the parade on.\n        let first = (cx.day.max(1) as u32 - 1) * 3 % 6;''')\ns=s.replace('''        let (_, name) = POSES[self.pose()];\n        b.center(960.0, 60.0, 50.0, INK, name);''','''        let (_, name) = POSES[self.pose()];\n        let shown = name.strip_prefix(\"the \").map(|n| format!(\"The {n}\")).unwrap_or_else(|| name.to_string());\n        b.center(960.0, 60.0, 50.0, INK, &shown);''')\nopen(p,'w').write(s)\np='engine/crates/pav_core/src/games/fit/events/mod.rs'\ns=open(p).read()\ns=s.replace('''    pub slump: f32,\n    pub flops''','''    pub slump: f32,\n    pub day: u8,\n    pub flops''')\nopen(p,'w').write(s)\np='engine/crates/pav_core/src/games/fit/mod.rs'\ns=open(p).read()\ns=s.replace('slump: 0.0, flops: &mut flops','slump: 0.0, day: 1, flops: &mut flops')\ns=s.replace('seed, demo, slump, flops: &mut flops','seed, demo, slump, day, flops: &mut flops')\ns=s.replace('seed, demo: run.demo, slump, flo