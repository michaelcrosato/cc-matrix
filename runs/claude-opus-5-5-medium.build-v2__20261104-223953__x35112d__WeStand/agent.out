{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjGApmd5GhQkUHsEau1M","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15703,"cache_read_input_tokens":305500,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15703},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cb437ba7-0477-4143-bb04-ff33f49efd62","uuid":"33bd09cc-c7ae-45fb-ac05-3e64b5e88990","timestamp":"2026-11-05T05:53:48.092Z","request_id":"req_011CgjGApMpKDt6b2whR1hSm","thinking_duration_ms":1370,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjGApmd5GhQkUHsEau1M","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012yHkBgGpX2iEToeJsHuocm","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953\nF=engine/crates/pav_core/src/games/fit\nsed -i 's/let feet_offset = 0.9 \\* def.scale;/let feet_offset = crate::character::Posture::Stand.height() * 0.5;/' $F/ghost.rs\ncat > $F/events/mod.rs <<'RS'\n//! The events. Each is a state struct with `start`, `tick`, `bot`, `hud` and `score`, dispatched\n//! through one enum so the game stays `Clone` + serde. To add an event: a file here, a line in\n//! `EvKind` and the `Ev` matches, a section in `rules.rs`, a card in `script.toml`.\n\nuse std::f32::consts::{PI, TAU};\n\nuse glam::{Quat, Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::core::BalanceCore;\nuse super::rules::Rules;\nuse super::ui_model::*;\nuse crate::color::Color;\nuse crate::entity::{EntityId, Spawn};\nuse crate::frame::SimEvent;\nuse crate::shape::{Shape, Visual};\nuse crate::sim::Sim;\n\npub mod breath;\npub mod cannon;\npub mod lap;\npub mod paddle;\npub mod plank;\npub mod pose;\npub mod spin;\npub mod squats;\npub mod step;\npub mod stillness;\npub mod tide;\npub mod tray;\n\n/// Set numbers (`SETS` in the game's order).\npub const HUB: usize = 0;\npub const STUDIO: usize = 1;\npub const GAZEBO: usize = 2;\npub const BOARDWALK: usize = 3;\npub const TIDE: usize = 4;\npub const CHANNEL: usize = 5;\npub const PIER: usize = 6;\npub const TOWER: usize = 7;\npub const BAY: usize = 8;\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]\npub enum EvKind {\n    Breath,\n    Pose,\n    Squats,\n    Plank,\n    Step,\n    Spin,\n    Lap,\n    Tide,\n    Paddle,\n    Tray,\n    Cannon,\n}\n\npub const ALL_EVENTS: [EvKind; 11] = [\n    EvKind::Breath,\n    EvKind::Pose,\n    EvKind::Squats,\n    EvKind::Plank,\n    EvKind::Step,\n    EvKind::Spin,\n    EvKind::Lap,\n    EvKind::Tide,\n    EvKind::Paddle,\n    EvKind::Tray,\n    EvKind::Cannon,\n];\n\nimpl EvKind {\n    pub fn key(self) -> &'static str {\n        match self {\n            EvKind::Breath => \"breath\",\n            EvKind::Pose => \"pose\",\n            EvKind::Squats => \"squats\",\n            EvKind::Plank => \"plank\",\n            EvKind::Step => \"step\",\n            EvKind::Spin => \"spin\",\n            EvKind::Lap => \"lap\",\n            EvKind::Tide => \"tide\",\n            EvKind::Paddle => \"paddle\",\n            EvKind::Tray => \"tray\",\n            EvKind::Cannon => \"cannon\",\n        }\n    }\n    pub fn from_key(k: &str) -> Option<Self> {\n        ALL_EVENTS.iter().copied().find(|e| e.key() == k)\n    }\n    pub fn name(self) -> &'static str {\n        match self {\n            EvKind::Breath => \"Breath Bloom\",\n            EvKind::Pose => \"Pose Parade\",\n            EvKind::Squats => \"Tempo Squats\",\n            EvKind::Plank => \"Plank Standoff\",\n            EvKind::Step => \"Step Party\",\n            EvKind::Spin => \"Floatie Spin\",\n            EvKind::Lap => \"Morning Lap\",\n            EvKind::Tide => \"Tide Table\",\n            EvKind::Paddle => \"Paddle Slalom\",\n            EvKind::Tray => \"Tray Trek\",\n            EvKind::Cannon => \"Cannonball Cup\",\n        }\n    }\n    /// The day it opens.\n    pub fn day(self) -> u8 {\n        match self {\n            EvKind::Breath | EvKind::Pose => 1,\n            EvKind::Squats | EvKind::Plank => 2,\n            EvKind::Step | EvKind::Spin | EvKind::Lap => 3,\n            _ => 4,\n        }\n    }\n    /// 0 Stillness, 1 Strength, 2 Cardio, 3 Lagoon.\n    pub fn pavilion(self) -> usize {\n        self.day() as usize - 1\n    }\n    pub fn set(self) -> usize {\n        match self {\n            EvKind::Breath | EvKind::Pose => STUDIO,\n            EvKind::Squats | EvKind::Plank => GAZEBO,\n            EvKind::Step | EvKind::Spin => BOARDWALK,\n            EvKind::Lap => HUB,\n            EvKind::Tide => TIDE,\n            EvKind::Paddle => CHANNEL,\n            EvKind::Tray => PIER,\n            EvKind::Cannon => TOWER,\n        }\n    }\n    pub fn coach(self) -> u8 {\n        (self.pavilion() as u8) + 1\n    }\n    /// Where a ghost runs, beside the player.\n    pub fn lane(self) -> Vec3 {\n        match self {\n            EvKind::Paddle => Vec3::X * 3.0,\n            EvKind::Lap | EvKind::Tray => Vec3::X * 1.6,\n            EvKind::Cannon => Vec3::NEG_X * 2.0,\n            EvKind::Tide => Vec3::new(2.5, 0.0, -2.5),\n            _ => Vec3::X * 2.4,\n        }\n    }\n}\n\npub const PAVILIONS: [&str; 4] = [\"Stillness Studio\", \"Iron Gazebo\", \"Boardwalk\", \"Lagoon\"];\n\n/// What the player gave, in the game's terms. The bot and attract mode give the same.\n#[derive(Clone, Copy, Debug, Default, PartialEq)]\npub struct Intent {\n    pub lean: Vec2,\n    pub keys: bool,\n    pub act: bool,\n    pub act_p: bool,\n    pub l: bool,\n    pub l_p: bool,\n    pub r: bool,\n    pub r_p: bool,\n    pub song_pos: Option<f32>,\n}\n\nimpl Intent {\n    pub fn brace(&self) -> bool {\n        self.l && self.r\n    }\n}\n\n/// Where the camera should be: tilt, yaw, distance, fov, height, focus.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct Shot {\n    pub tilt: f32,\n    pub yaw: f32,\n    pub distance: f32,\n    pub fov: f32,\n    pub height: f32,\n    pub focus: Vec3,\n}\n\n/// What an event may touch while it runs.\npub struct Cx<'a> {\n    pub sim: &'a mut Sim,\n    pub ev: &'a mut Vec<SimEvent>,\n    pub r: &'a Rules,\n    pub dt: f32,\n    pub core: &'a mut BalanceCore,\n    pub actors: &'a mut Vec<EntityId>,\n    pub spots: &'a super::Spots,\n    pub pid: EntityId,\n    pub shot: &'a mut Shot,\n    pub msg: &'a mut Option<(String, f32)>,\n    pub seed: u32,\n    pub demo: bool,\n    pub slump: f32,\n    pub flops: &'a mut [bool; 5],\n    pub flop_ids: &'a [Option<EntityId>; 5],\n}\n\nimpl Cx<'_> {\n    pub fn spot(&self, set: usize, name: &str) -> Vec3 {\n        self.spots.get(set, name)\n    }\n\n    pub fn prop(&mut self, asset: &str, pos: Vec3, yaw: f32, scale: f32) -> EntityId {\n        self.prop_color(asset, pos, yaw, scale, \"#46bec8\")\n    }\n\n    pub fn prop_color(&mut self, asset: &str, pos: Vec3, yaw: f32, scale: f32, accent: &str) -> EntityId {\n        let id = spawn_prop(self.sim, asset, pos, yaw, scale, accent);\n        self.actors.push(id);\n        id\n    }\n\n    pub fn ball(&mut self, radius: f32, color: &str, pos: Vec3) -> EntityId {\n        let id = self.sim.spawn(Spawn::new(\"~fx\", pos).visual(Visual::new(Shape::Sphere { radius }, Color::hex(color))));\n        self.actors.push(id);\n        id\n    }\n\n    pub fn place(&mut self, id: EntityId, pos: Vec3, rot: Quat) {\n        if let Some(e) = self.sim.state.entities.get_mut(id) {\n            e.pos = pos;\n            e.rot = rot;\n        }\n    }\n\n    /// Puts the player's feet at `pos`, facing `yaw` (radians, 0 = +Z).\n    pub fn player(&mut self, pos: Vec3, yaw: f32) {\n        self.sim.set_position(self.pid, pos);\n        self.face(yaw);\n    }\n\n    pub fn face(&mut self, yaw: f32) {\n        if let Some(ch) = self.sim.state.entities.get_mut(self.pid).and_then(|e| e.character.as_mut()) {\n            ch.facing = yaw;\n            ch.anim.facing = yaw;\n        }\n    }\n\n    pub fn anim(&mut self) -> Option<&mut crate::puppet::PuppetState> {\n        self.sim.state.entities.get_mut(self.pid).and_then(|e| e.character.as_mut()).map(|c| &mut c.anim)\n    }\n\n    /// Plays a looping clip on the whole body.\n    pub fn clip(&mut self, name: &str, speed: f32) {\n        let id = crate::clips::find_cached(name);\n        if let Some(a) = self.anim() {\n            a.play_clip(id, 0, speed);\n        }\n    }\n\n    /// One-shot gesture on top.\n    pub fn gesture(&mut self, name: &str) {\n        let id = crate::clips::find_cached(name);\n        if let Some(a) = self.anim() {\n            a.replay_clip(id, crate::clips::ONCE | crate::clips::QUICK, 1.0);\n        }\n    }\n\n    /// Holds a clip at `frac` of the way through: the game drives it (depth, breath).\n    pub fn scrub(&mut self, name: &str, frac: f32) {\n        let id = crate::clips::find_cached(name);\n        let dur = crate::clips::with(id, |c| c.dur).unwrap_or(1.0);\n        if let Some(a) = self.anim() {\n            a.play_clip(id, 0, 1e-6);\n            a.clip_t = frac.clamp(0.0, 1.0) * dur * 0.999;\n        }\n    }\n\n    pub fn stop_clip(&mut self) {\n        if let Some(a) = self.anim() {\n            a.stop_clip();\n        }\n    }\n\n    /// The figure tilts with the dot, seen from a camera at `cam_yaw` degrees.\n    pub fn lean_body(&mut self, cam_yaw: f32) {\n        let cob = self.core.cob;\n        let slump = self.slump;\n        self.lean_body_by(cob, cam_yaw, slump);\n    }\n\n    pub fn lean_body_by(&mut self, cob: Vec2, cam_yaw: f32, slump: f32) {\n        let y = cam_yaw.to_radians();\n        let right = Vec3::new(y.cos(), 0.0, y.sin());\n        let fwd = Vec3::new(y.sin(), 0.0, -y.cos());\n        let w = (right * cob.x + fwd * cob.y) * 14f32.to_radians();\n        let flail = crate::clips::find_cached(\"FIT/ArmFlail\");\n        if let Some(a) = self.anim() {\n            a.tilt_side = w.x;\n            a.tilt_fwd = w.z + slump;\n            a.tilt_pivot = 0.0;\n            // Beyond 0.75 the arms start to flail, drawn by the upper-body clip in the second slot.\n            let far = cob.length();\n            if far > 0.75 && a.clip == 0 {\n                a.play_clip(flail, crate::clips::UPPER, 1.0);\n            } else if far <= 0.7 && a.clip == flail {\n                a.stop_clip();\n            }\n        }\n    }\n\n    pub fn sfx(&mut self, id: u8, gain: f32, pitch: f32) {\n        self.ev.push(SimEvent::Sfx { id, gain, pitch });\n    }\n\n    pub fn say(&mut self, text: impl Into<String>, seconds: f32) {\n        *self.msg = Some((text.into(), seconds));\n    }\n\n    pub fn pick(&mut self, key: &str) -> String {\n        let n = self.sim.state.rng.next_u32();\n        super::script::line(key, n)\n    }\n\n    pub fn rng(&mut self) -> &mut crate::rng::Rng {\n        &mut self.sim.state.rng\n    }\n\n    /// A tip: stumble and, over water, a splash.\n    pub fn tip_fx(&mut self, water: bool) {\n        self.gesture(\"FIT/Stumble\");\n        let at = self.sim.feet(self.pid).unwrap_or_default();\n        if water {\n            self.ev.push(SimEvent::Splash { pos: at });\n        }\n        self.sfx(super::sfx::GROAN, 0.5, 1.0);\n    }\n\n    /// Standard stage: the player in front of a mirror-style camera, facing it.\n    pub fn mirror_shot(&mut self, focus: Vec3, distance: f32) {\n        *self.shot = Shot { tilt: 12.0, yaw: 0.0, distance, fov: 36.0, height: 0.9, focus };\n    }\n}\n\npub fn spawn_prop(sim: &mut Sim, asset: &str, pos: Vec3, yaw: f32, scale: f32, accent: &str) -> EntityId {\n    let name = format!(\"LIB/core/{asset}\");\n    let made = crate::props::resolve_placed(&name, &crate::props::Params::new()).ok().and_then(|(n, definition, params)| {\n        let mut roles = std::collections::BTreeMap::new();\n        roles.insert(\"$accent\".to_string(), accent.to_string());\n        crate::prop_instance::PropInstance::new(&n, definition, scale, false).ok()?.with_params(&params).ok()?.with_roles(roles).ok()\n    });\n    match made.and_then(|inst| sim.place_prop(inst, pos, Quat::from_rotation_y(yaw), None).ok()) {\n        Some(id) => id,\n        // A missing prop must not stop the game: a marker ball says so in captures.\n        None => {\n            log::error!(\"no prop {name}\");\n            sim.spawn(Spawn::new(\"~missing\", pos).visual(Visual::new(Shape::Sphere { radius: 0.2 }, Color::hex(\"#ff00ff\"))))\n        }\n    }\n}\n\n/// The state of whichever event is running.\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub enum Ev {\n    Breath(breath::Breath),\n    Pose(pose::Pose),\n    Squats(squats::Squats),\n    Plank(plank::Plank),\n    Step(step::Step),\n    Spin(spin::Spin),\n    Lap(lap::Lap),\n    Tide(tide::Tide),\n    Paddle(paddle::Paddle),\n    Tray(tray::Tray),\n    Cannon(cannon::Cannon),\n}\n\n/// Per-event options the finale and the medley use.\n#[derive(Clone, Copy, Debug, Default)]\npub struct Opt {\n    /// Replaces the event's length, when it has one.\n    pub seconds: Option<f32>,\n    /// Number of cycles, bars or rounds, when it has them.\n    pub count: Option<u32>,\n    /// A stage of the game's choosing: the finale's post.\n    pub at: Option<Vec3>,\n    pub band: bool,\n}\n\nmacro_rules! each {\n    ($s:expr, $e:ident => $x:expr) => {\n        match $s {\n            Ev::Breath($e) => $x,\n            Ev::Pose($e) => $x,\n            Ev::Squats($e) => $x,\n            Ev::Plank($e) => $x,\n            Ev::Step($e) => $x,\n            Ev::Spin($e) => $x,\n            Ev::Lap($e) => $x,\n            Ev::Tide($e) => $x,\n            Ev::Paddle($e) => $x,\n            Ev::Tray($e) => $x,\n            Ev::Cannon($e) => $x,\n        }\n    };\n}\n\nimpl Ev {\n    pub fn start(kind: EvKind, cx: &mut Cx, o: Opt) -> Ev {\n        match kind {\n            EvKind::Breath => Ev::Breath(breath::Breath::start(cx, o)),\n            EvKind::Pose => Ev::Pose(pose::Pose::start(cx, o)),\n            EvKind::Squats => Ev::Squats(squats::Squats::start(cx, o)),\n            EvKind::Plank => Ev::Plank(plank::Plank::start(cx, o)),\n            EvKind::Step => Ev::Step(step::Step::start(cx, o)),\n            EvKind::Spin => Ev::Spin(spin::Spin::start(cx, o)),\n            EvKind::Lap => Ev::Lap(lap::Lap::start(cx, o)),\n            EvKind::Tide => Ev::Tide(tide::Tide::start(cx, o)),\n            EvKind::Paddle => Ev::Paddle(paddle::Paddle::start(cx, o)),\n            EvKind::Tray => Ev::Tray(tray::Tray::start(cx, o)),\n            EvKind::Cannon => Ev::Cannon(cannon::Cannon::start(cx, o)),\n        }\n    }\n    /// Returns true when the event is over.\n    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        each!(self, e => e.tick(cx, i))\n    }\n    pub fn bot(&self, core: &BalanceCore, r: &Rules) -> Intent {\n        each!(self, e => e.bot(core, r))\n    }\n    pub fn hud(&self, b: &mut B, core: &BalanceCore, r: &Rules) {\n        each!(self, e => e.hud(b, core, r))\n    }\n    /// 0..=1000.\n    pub fn score(&self, r: &Rules) -> u32 {\n        (each!(self, e => e.score(r))).clamp(0.0, 1000.0).round() as u32\n    }\n    /// The running progress as a live number for the HUD.\n    pub fn live(&self, r: &Rules) -> u32 {\n        self.score(r)\n    }\n}\n\npub fn clamp01(x: f32) -> f32 {\n    x.clamp(0.0, 1.0)\n}\n\n/// Spot a dot-steering PD uses in several bots.\npub fn pd(core: &BalanceCore, target: Vec2) -> Vec2 {\n    // The body follows the lean closely, so aiming a bit past the target corrects its lag.\n    (target + (target - core.cob) * 0.4 - core.vel * 0.05).clamp_length_max(1.0)\n}\n\n/// A pentatonic pitch ratio.\npub fn penta(i: u32) -> f32 {\n    const S: [f32; 5] = [1.0, 1.122, 1.26, 1.498, 1.682];\n    S[i as usize % 5] * 2f32.powi((i / 5) as i32)\n}\n\npub const PUCK_TOP: [f32; 2] = [1700.0, 220.0];\npub const PUCK_R: f32 = 170.0;\n\npub fn timer(b: &mut B, left: f32) {\n    b.title_left(60.0, 30.0, 80.0, INK, &format!(\"{:.0}\", left.max(0.0).ceil()));\n}\n\npub fn wrap_pi(a: f32) -> f32 {\n    (a + PI).rem_euclid(TAU) - PI\n}\nRS\ncat > $F/events/breath.rs <<'RS'\n//! Breath Bloom: hold to inhale, release to exhale, following a guide; lotuses open on the water.\n\nuse super::*;\nuse crate::games::fit::sfx;\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Breath {\n    pub t: f32,\n    pub lungs: f32,\n    pub cycles: u32,\n    pub sum: f32,\n    pub time: f32,\n    cycle_sum: f32,\n    cycle_time: f32,\n    cycle: u32,\n    pub good: u32,\n    lotus: Vec<EntityId>,\n    center: Vec3,\n}\n\nimpl Breath {\n    pub fn start(cx: &mut Cx, o: Opt) -> Self {\n        let center = o.at.unwrap_or(cx.spot(STUDIO, \"center\"));\n        cx.player(center, 0.0);\n        cx.core.wobble = cx.r.breath.wobble;\n        cx.mirror_shot(center, 8.5);\n        let mut lotus = Vec::new();\n        // Buds wait on the water; each good cycle opens one more, a perfect run blooms the pond.\n        let cycles = o.count.unwrap_or(5);\n        for i in 0..cycles * 3 {\n            let a = i as f32 * 2.4;\n            let r = 8.0 + (i % 4) as f32 * 2.0;\n            let id = cx.prop(\"fit_lotus\", center + Vec3::new(a.cos() * r, -8.0, a.sin().abs() * -r - 1.0), a, 1.0);\n            lotus.push(id);\n        }\n        Self { t: 0.0, lungs: 0.0, cycles, sum: 0.0, time: 0.0, cycle_sum: 0.0, cycle_time: 0.0, cycle: 0, good: 0, lotus, center }\n    }\n\n    /// Seconds in a cycle, and the guide (0 empty, 1 full) at time `t`, and which cycle it is.\n    fn guide(&self, r: &Rules, t: f32) -> (f32, u32, bool) {\n        let half = r.breath.seconds_in;\n        let cycle = half * 2.0;\n        let last = self.cycles.saturating_sub(1);\n        let plain = last as f32 * cycle;\n        if t < plain {\n            let n = (t / cycle) as u32;\n            let u = t - n as f32 * cycle;\n            if u < half { (u / half, n, true) } else { (1.0 - (u - half) / half, n, false) }\n        } else {\n            // The last breath is longer: half as long again.\n            let u = t - plain;\n            let h = half * 1.6;\n            if u < h { (clamp01(u / h), last, true) } else { (clamp01(1.0 - (u - h) / h), last, false) }\n        }\n    }\n\n    pub fn length(&self, r: &Rules) -> f32 {\n        let half = r.breath.seconds_in;\n        self.cycles.saturating_sub(1) as f32 * half * 2.0 + half * 3.2\n    }\n\n    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        let dt = cx.dt;\n        self.t += dt;\n        let rate = 1.0 / cx.r.breath.seconds_in;\n        self.lungs = clamp01(self.lungs + if i.act { rate } else { -rate } * dt);\n        let (g, cycle, _) = self.guide(cx.r, self.t);\n        let in_ring = cx.core.cob.length() < cx.r.breath.ring;\n        // Not breathing earns nothing, however still you are (a decision: see notes/decisions.md).\n        let m = 1.0 - clamp01((self.lungs - g).abs() / cx.r.breath.match_width);\n        let v = m * (0.7 + 0.3 * in_ring as u8 as f32);\n        self.sum += v * dt;\n        self.time += dt;\n        self.cycle_sum += v * dt;\n        self.cycle_time += dt;\n        if cycle != self.cycle {\n            self.cycle = cycle;\n            let good = self.cycle_sum / self.cycle_time.max(0.1);\n            self.cycle_sum = 0.0;\n            self.cycle_time = 0.0;\n            if good > 0.6 {\n                self.bloom(cx, 3);\n            }\n        }\n        cx.scrub(\"FIT/Breath\", self.lungs);\n        cx.lean_body(0.0);\n        if self.t >= self.length(cx.r) {\n            if self.cycle_sum / self.cycle_time.max(0.1) > 0.6 {\n                self.bloom(cx, 3);\n            }\n            if self.good >= self.cycles {\n                let n = self.lotus.len() as u32;\n                self.bloom(cx, n);\n                cx.say(cx.pick_static(\"posey_perfect\"), 3.0);\n            }\n            return true;\n        }\n        false\n    }\n\n    fn bloom(&mut self, cx: &mut Cx, n: u32) {\n        for _ in 0..n {\n            if let Some(id) = self.lotus.pop() {\n                if let Some(e) = cx.sim.state.entities.get_mut(id) {\n                    e.pos.y = self.center.y - 0.02;\n                    let p = e.pos;\n                    cx.ev.push(SimEvent::Burst { pos: p + Vec3::Y * 0.2, kind: 1, count: 18 });\n                }\n            }\n        }\n        self.good += 1;\n        cx.sfx(sfx::CHIME, 0.7, penta(self.good * 2));\n    }\n\n    pub fn bot(&self, core: &BalanceCore, r: &Rules) -> Intent {\n        let (_, _, rising) = self.guide(r, self.t + 0.03);\n        Intent { act: rising, lean: pd(core, Vec2::ZERO), ..Default::default() }\n    }\n\n    pub fn hud(&self, b: &mut B, core: &BalanceCore, r: &Rules) {\n        timer(b, self.length(r) - self.t);\n        b.puck(PUCK_TOP, PUCK_R, core.cob.into());\n        b.puck_ring([0.0, 0.0], r.breath.ring);\n        // The guide ring around the figure, and your lungs inside it.\n        let (g, _, rising) = self.guide(r, self.t);\n        let c = [960.0, 540.0];\n        b.circle(c, 150.0 + g * 200.0, [0, 0, 0, 0], TEAL, 10.0);\n        b.circle(c, 150.0 + self.lungs * 200.0, [0x78, 0xdc, 0xaa, 50], MINT, 6.0);\n        b.center(960.0, 90.0, 64.0, INK, if rising { \"Breathe in\" } else { \"Breathe out\" });\n    }\n\n    pub fn score(&self, _r: &Rules) -> f32 {\n        // Averaged over the whole event, however far it has got.\n        1000.0 * self.sum / self.time.max(1.0) * 1.05\n    }\n}\n\nimpl Cx<'_> {\n    /// A script line for messages, from a key.\n    pub fn pick_static(&mut self, key: &str) -> String {\n        self.pick(key)\n    }\n}\nRS\ncat > $F/events/pose.rs <<'RS'\n//! Pose Parade: hold a deadpan pose while a ring drifts; stay in it to climb a multiplier.\n\nuse super::*;\nuse crate::games::fit::sfx;\n\npub const POSES: [(&str, &str); 6] = [\n    (\"FIT/Tree\", \"the Patient Heron\"),\n    (\"FIT/Warrior\", \"the Apologetic Lunge\"),\n    (\"FIT/Lighthouse\", \"the Tired Lighthouse\"),\n    (\"FIT/DeckChair\", \"the Folded Deck Chair\"),\n    (\"FIT/Bridge\", \"the Reluctant Bridge\"),\n    (\"FIT/Seated\", \"Seated Disappointment\"),\n];\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Pose {\n    pub t: f32,\n    pub count: u32,\n    pub first: u32,\n    pub sum: f32,\n    pub mult: u32,\n    streak: f32,\n    broken: f32,\n    gull: Option<EntityId>,\n    gull_t: f32,\n    posey: Option<EntityId>,\n    seconds: f32,\n    announced: u32,\n    pub ring: Vec2,\n    pub radius: f32,\n    center: Vec3,\n    pub gusts: bool,\n    gust_a: f32,\n}\n\nimpl Pose {\n    pub fn start(cx: &mut Cx, o: Opt) -> Self {\n        let center = o.at.unwrap_or(cx.spot(STUDIO, \"center\"));\n        cx.player(center, 0.0);\n        cx.core.wobble = 1.0;\n        cx.mirror_shot(center, 8.5);\n        let posey = cx.sim.state.entities.iter().find(|e| e.name == \"posey\" && (e.pos - center).length() < 12.0).map(|e| e.id);\n        let count = o.count.unwrap_or(3);\n        // Each day brings new poses; the seed turns the parade.\n        let first = (cx.seed % 2) * 3;\n        Self {\n            t: 0.0,\n            count,\n            first,\n            sum: 0.0,\n            mult: 1,\n            streak: 0.0,\n            broken: 0.0,\n            gull: None,\n            gull_t: 0.0,\n            posey,\n            seconds: o.seconds.unwrap_or(cx.r.pose.seconds),\n            announced: 99,\n            ring: Vec2::ZERO,\n            radius: cx.r.pose.ring_start,\n            center,\n            gusts: o.band,\n            gust_a: 0.0,\n        }\n    }\n\n    fn index(&self) -> u32 {\n        ((self.t / self.seconds) as u32).min(self.count - 1)\n    }\n\n    fn pose(&self) -> usize {\n        ((self.first + self.index()) % 6) as usize\n    }\n\n    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        let dt = cx.dt;\n        self.t += dt;\n        let n = self.index();\n        let local = self.t - n as f32 * self.seconds;\n        let u = clamp01(local / self.seconds);\n        let r = &cx.r.pose;\n        self.radius = r.ring_start + (r.ring_end - r.ring_start) * u;\n        let w = TAU * r.drift_hz * self.t;\n        self.ring = Vec2::new(w.sin(), (w * 1.37 + 0.7).sin()) * r.drift;\n        let (drift, gull_w) = (r.drift, r.gull_wobble);\n        let _ = drift;\n        if n != self.announced {\n            self.announced = n;\n            let (clip, name) = POSES[self.pose()];\n            cx.sfx(sfx::WOOD, 0.8, 1.0);\n            cx.say(format!(\"This is {name}.\"), 3.0);\n            cx.clip(clip, 1.0);\n            if let Some(p) = self.posey {\n                let id = crate::clips::find_cached(clip);\n                if let Some(ch) = cx.sim.state.entities.get_mut(p).and_then(|e| e.character.as_mut()) {\n                    ch.anim.play_clip(id, 0, 1.0);\n                }\n            }\n        }\n        // The gull: at 12 s of the second pose, for five seconds.\n        if n == 1.min(self.count - 1) && local >= 12.0 && self.gull_t == 0.0 {\n            self.gull_t = 5.0;\n            let at = self.center + Vec3::Y * 2.05;\n            self.gull = Some(cx.prop(\"fit_gull\", at + Vec3::Y * 2.0, 0.0, 0.7));\n            cx.sfx(sfx::GULL, 0.8, 1.0);\n            cx.say(\"There is a bird on you. Accept the bird.\", 4.0);\n        }\n        if self.gull_t > 0.0 {\n            self.gull_t -= dt;\n            cx.core.wobble = gull_w;\n            if let Some(g) = self.gull {\n                let head = self.center + Vec3::Y * 1.92 + Vec3::new(cx.core.cob.x * 0.4, 0.0, -cx.core.cob.y * 0.4);\n                let drop = (self.gull_t - 4.5).max(0.0) * 4.0;\n                cx.place(g, head + Vec3::Y * drop, Quat::IDENTITY);\n                if self.gull_t <= 0.0 {\n                    cx.place(g, self.center + Vec3::new(-30.0, 8.0, -30.0), Quat::IDENTITY);\n                    self.gull = None;\n                    self.gull_t = -1.0;\n                }\n            }\n        } else {\n            cx.core.wobble = 1.0;\n        }\n        if self.gusts {\n            self.gust_a += dt * 0.7;\n            let w = (self.t * 0.8).sin().max(0.0) * cx.r.finale.gust;\n            cx.core.gust = Vec2::new(self.gust_a.cos(), self.gust_a.sin()) * w;\n        }\n        // In the ring the streak climbs one step per 2 s; leaving resets it. A tip breaks the pose.\n        if self.broken > 0.0 {\n            self.broken -= dt;\n            self.mult = 1;\n            self.streak = 0.0;\n        } else if (cx.core.cob - self.ring).length() < self.radius {\n            self.streak += dt;\n            let m = 1 + (self.streak / 2.0) as u32;\n            if m.min(4) > self.mult {\n                cx.sfx(sfx::STAR, 0.5, penta(m));\n            }\n            self.mult = m.min(4);\n            self.sum += self.mult as f32 * dt;\n        } else {\n            self.streak = 0.0;\n            self.mult = 1;\n        }\n        if cx.core.cob.length() < 0.001 && cx.core.tips > 0 {\n            self.broken = 1.5;\n        }\n        cx.lean_body(0.0);\n        self.t >= self.seconds * self.count as f32\n    }\n\n    /// A tip breaks the pose for a moment.\n    pub fn on_tip(&mut self) {\n        self.broken = 1.5;\n    }\n\n    pub fn bot(&self, core: &BalanceCore, _r: &Rules) -> Intent {\n        Intent { lean: pd(core, self.ring), ..Default::default() }\n    }\n\n    pub fn hud(&self, b: &mut B, core: &BalanceCore, _r: &Rules) {\n        timer(b, self.seconds * self.count as f32 - self.t);\n        b.puck(PUCK_TOP, PUCK_R, core.cob.into());\n        b.puck_ring(self.ring.into(), self.radius);\n        b.puck_stars((self.mult.saturating_sub(1)) as u8);\n        b.title(1700.0, 410.0, 72.0, if self.mult >= 4 { CORAL } else { TEAL }, &format!(\"x{}\", self.mult));\n        let (_, name) = POSES[self.pose()];\n        b.center(960.0, 60.0, 50.0, INK, name);\n    }\n\n    pub fn score(&self, r: &Rules) -> f32 {\n        let total = (self.seconds * self.count as f32).max(1.0);\n        1000.0 * self.sum / (total * r.pose.full_score)\n    }\n}\nRS\ncat > $F/events/squats.rs <<'RS'\n//! Tempo Squats: hold to go down, release to rise, to a guide bar; keep the dot in the band.\n\nuse super::*;\nuse crate::games::fit::sfx;\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Squats {\n    pub t: f32,\n    pub rep: u32,\n    pub depth: f32,\n    rep_sum: f32,\n    rep_band: f32,\n    rep_time: f32,\n    pub total: f32,\n    belled: bool,\n    pub gag: f32,\n}\n\nimpl Squats {\n    pub fn start(cx: &mut Cx, _o: Opt) -> Self {\n        let c = cx.spot(GAZEBO, \"center\");\n        cx.player(c, 0.0);\n        cx.core.wobble = 1.0;\n        *cx.shot = Shot { tilt: 14.0, yaw: -16.0, distance: 8.0, fov: 36.0, height: 0.8, focus: c };\n        Self { t: 0.0, rep: 0, depth: 0.0, rep_sum: 0.0, rep_band: 0.0, rep_time: 0.0, total: 0.0, belled: false, gag: 0.0 }\n    }\n\n    fn cycle(r: &Rules) -> f32 {\n        r.squats.down + r.squats.up + r.squats.rest\n    }\n\n    /// The guide's depth at a time within a rep, and whether it wants you going down.\n    fn guide(r: &Rules, u: f32) -> (f32, bool) {\n        let s = &r.squats;\n        if u < s.down {\n            (u / s.down, true)\n        } else if u < s.down + s.up {\n            (1.0 - (u - s.down) / s.up, false)\n        } else {\n            (0.0, false)\n        }\n    }\n\n    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        let dt = cx.dt;\n        self.t += dt;\n        let s = &cx.r.squats;\n        if self.gag > 0.0 {\n            self.gag -= dt;\n            cx.scrub(\"FIT/Squat\", 0.0);\n            return self.gag <= 0.0;\n        }\n        let reps = s.reps as u32;\n        let c = Self::cycle(cx.r);\n        let u = self.t - self.rep as f32 * c;\n        self.depth = clamp01(self.depth + if i.act { dt / s.down } else { -dt / s.up });\n        let (g, _) = Self::guide(cx.r, u);\n        cx.core.wobble = 1.0 + s.wobble_per_rep * self.rep as f32;\n        if u < s.down + s.up {\n            self.rep_sum += (1.0 - clamp01((self.depth - g).abs() / 0.35)) * dt;\n            self.rep_band += (cx.core.cob.x.abs() < s.band) as u8 as f32 * dt;\n            self.rep_time += dt;\n        }\n        if u >= s.down && !self.belled {\n            self.belled = true;\n            cx.sfx(sfx::BELL, 0.8, 0.5);\n        }\n        if u >= c {\n            let timing = self.rep_sum / self.rep_time.max(0.1);\n            let band = self.rep_band / self.rep_time.max(0.1);\n            // Standing still in the band earns nothing without the squat.\n            self.total += timing * (0.7 + 0.3 * band);\n            self.rep += 1;\n            self.rep_sum = 0.0;\n            self.rep_band = 0.0;\n            self.rep_time = 0.0;\n            self.belled = false;\n            cx.sfx(sfx::STAR, 0.5, penta(self.rep));\n            if self.rep >= reps {\n                self.gag = 2.0;\n                cx.say(\"Ten. Also eleven.\", 2.0);\n                cx.sfx(sfx::GONG, 0.5, 1.0);\n            }\n        }\n        cx.scrub(\"FIT/Squat\", self.depth);\n        cx.lean_body(-16.0);\n        false\n    }\n\n    pub fn bot(&self, core: &BalanceCore, r: &Rules) -> Intent {\n        let c = Self::cycle(r);\n        let u = self.t - self.rep as f32 * c;\n        let (_, down) = Self::guide(r, u + 0.02);\n        Intent { act: down, lean: pd(core, Vec2::ZERO), ..Default::default() }\n    }\n\n    pub fn hud(&self, b: &mut B, core: &BalanceCore, r: &Rules) {\n        let c = Self::cycle(r);\n        let u = self.t - self.rep as f32 * c;\n        let (g, down) = Self::guide(r, u);\n        b.puck(PUCK_TOP, PUCK_R, core.cob.into());\n        b.puck_band(r.squats.band);\n        b.title_left(60.0, 30.0, 80.0, INK, &format!(\"{} of {}\", (self.rep + 1).min(r.squats.reps as u32), r.squats.reps as u32));\n        // The tempo bar: the guide above, your depth below.\n        let x = 70.0;\n        b.flat([x, 240.0, x + 110.0, 760.0], PALE, 30.0);\n        b.flat([x, 240.0 + g * 480.0, x + 110.0, 280.0 + g * 480.0], TEAL, 16.0);\n        b.flat([x + 20.0, 250.0 + self.depth * 480.0, x + 90.0, 270.0 + self.depth * 480.0], CORAL, 10.0);\n        b.center(x + 55.0, 780.0, 40.0, INK, if down { \"Down\" } else { \"Up\" });\n    }\n\n    pub fn score(&self, r: &Rules) -> f32 {\n        1000.0 * self.total / r.squats.reps\n    }\n}\nRS\ncat > $F/events/plank.rs <<'RS'\n//! Plank Standoff: hold Brace and keep the dot in a shrinking ring for as long as you can.\n\nuse super::*;\nuse crate::games::fit::sfx;\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Plank {\n    pub t: f32,\n    pub out: f32,\n    pub radius: f32,\n    pub flop: f32,\n    told: u8,\n    pub seconds: f32,\n    /// Waves shove the figure (the finale).\n    pub waves: bool,\n    wave_in: f32,\n    /// A tip does not end the finale's brace.\n    pub forgiving: bool,\n    pub survived: f32,\n    grace: f32,\n}\n\nimpl Plank {\n    pub fn start(cx: &mut Cx, o: Opt) -> Self {\n        let c = o.at.unwrap_or(cx.spot(GAZEBO, \"center\"));\n        cx.player(c, 0.0);\n        cx.core.wobble = 1.0;\n        *cx.shot = Shot { tilt: 16.0, yaw: -68.0, distance: 8.0, fov: 36.0, height: 0.5, focus: c };\n        if o.at.is_some() {\n            cx.mirror_shot(c, 9.0);\n        }\n        cx.scrub(\"FIT/Plank\", 0.0);\n        Self { t: 0.0, out: 0.0, radius: cx.r.plank.ring_start, flop: 0.0, told: 0, seconds: o.seconds.unwrap_or(cx.r.plank.seconds), waves: o.band, wave_in: 2.0, forgiving: o.band, survived: 0.0, grace: 1.0 }\n    }\n\n    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        let dt = cx.dt;\n        if self.flop > 0.0 {\n            self.flop -= dt;\n            return self.flop <= 0.0;\n        }\n        self.t += dt;\n        self.grace -= dt;\n        let p = &cx.r.plank;\n        let u = clamp01(self.t / self.seconds);\n        self.radius = p.ring_start + (p.ring_end - p.ring_start) * u;\n        cx.core.wobble = 1.0 + p.fatigue * u + if self.t > 30.0 { 0.35 } else { 0.0 };\n        // At 45 s Kettle laughs at his own joke and the nudge shakes the screen.\n        if self.t > 45.0 && self.told < 2 {\n            self.told = 2;\n            cx.core.nudge += Vec2::new(14.0, 0.0);\n            cx.say(\"A plank walks into a bar. I am so sorry. Hold on.\", 4.0);\n            cx.sfx(sfx::GONG, 0.5, 0.7);\n        } else if self.t > 30.0 && self.told < 1 {\n            self.told = 1;\n            cx.say(\"You are trembling. That is the strength leaving. It is fine.\", 4.0);\n        }\n        if self.waves {\n            self.wave_in -= dt;\n            if self.wave_in <= 0.0 {\n                self.wave_in = cx.rng().range(2.0, 3.5);\n                let a = cx.rng().range(0.0, TAU);\n                cx.core.nudge += Vec2::new(a.cos(), a.sin()) * cx.r.finale.waves * 6.0;\n                cx.sfx(sfx::WAVE, 0.9, 1.0);\n            }\n        }\n        let holding = i.brace();\n        let inside = cx.core.cob.length() < self.radius;\n        if inside && holding {\n            self.out = 0.0;\n        } else if self.grace <= 0.0 {\n            self.out += dt;\n        }\n        self.survived = self.t;\n        cx.scrub(\"FIT/Plank\", 0.0);\n        cx.lean_body(-68.0);\n        if self.out > p.grace {\n            if self.forgiving {\n                self.out = 0.0;\n                self.t -= 0.5;\n                cx.core.center();\n                cx.sfx(sfx::GROAN, 0.5, 1.0);\n                return false;\n            }\n            self.flop = 1.4;\n            cx.gesture(\"FIT/Flop\");\n            cx.sfx(sfx::WOOD, 1.0, 0.5);\n            let msg = cx.pick(\"kettle_flop\");\n            cx.say(msg, 3.0);\n            return false;\n        }\n        if self.t >= self.seconds {\n            return true;\n        }\n        false\n    }\n\n    pub fn bot(&self, core: &BalanceCore, _r: &Rules) -> Intent {\n        Intent { l: true, r: true, lean: pd(core, Vec2::ZERO), ..Default::default() }\n    }\n\n    pub fn hud(&self, b: &mut B, core: &BalanceCore, _r: &Rules) {\n        b.title_left(60.0, 30.0, 80.0, INK, &format!(\"{:.0} s\", self.t));\n        b.puck(PUCK_TOP, PUCK_R, core.cob.into());\n        b.puck_ring([0.0, 0.0], self.radius);\n    }\n\n    pub fn score(&self, r: &Rules) -> f32 {\n        // Stars at 25, 40 and 55 s of the minute: a piecewise line through 400, 650 and 850.\n        let s = self.survived * 60.0 / r.plank.seconds.max(1.0);\n        let pts = [(0.0, 0.0), (25.0, 400.0), (40.0, 650.0), (55.0, 850.0), (60.0, 1000.0)];\n        for w in pts.windows(2) {\n            let (a, b) = (w[0], w[1]);\n            if s <= b.0 {\n                return a.1 + (b.1 - a.1) * (s - a.0) / (b.0 - a.0);\n            }\n        }\n        1000.0\n    }\n}\nRS\ncat > $F/events/step.rs <<'RS'\n//! Step Party: notes in two lanes fall to two footprints. Timing is read from the music's clock.\n\nuse super::*;\nuse crate::games::fit::sfx;\n\n#[derive(Clone, Copy, Debug, Serialize, Deserialize)]\npub struct Note {\n    pub at: f32,\n    pub lane: u8, // 0 left, 1 right, 2 both\n    pub hit: u8,  // 0 waiting, 1 good, 2 perfect, 3 miss\n}\n\n#[derive(Debug, Deserialize)]\nstruct Chart {\n    bars: Vec<String>,\n}\n\npub fn chart_bars() -> Vec<String> {\n    let text = crate::games::level_text(\"fit/charts\", include_str!(\"../charts.toml\"));\n    toml::from_str::<Chart>(&text).map(|c| c.bars).unwrap_or_default()\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Step {\n    pub t: f32,\n    pub notes: Vec<Note>,\n    pub points: f32,\n    pub combo: u32,\n    pub perfect: u32,\n    pub good: u32,\n    pub miss: u32,\n    pub end: f32,\n    side: f32,\n    stepping: f32,\n    last: u8,\n    flash: f32,\n    flash_text: u8,\n    band: bool,\n    center: Vec3,\n    claps: u32,\n}\n\nimpl Step {\n    pub fn start(cx: &mut Cx, o: Opt) -> Self {\n        let c = o.at.unwrap_or(cx.spot(BOARDWALK, \"center\") + Vec3::Y * 0.38);\n        cx.player(c, 0.0);\n        cx.core.wobble = if o.band { cx.r.step.wobble + cx.r.finale.wobble } else { cx.r.step.wobble };\n        *cx.shot = Shot { tilt: 20.0, yaw: 0.0, distance: 9.0, fov: 36.0, height: 0.8, focus: c };\n        let bar = 240.0 / cx.r.step.bpm;\n        let eighth = bar / 8.0;\n        let all = chart_bars();\n        let n = o.count.map(|c| c as usize).unwrap_or(all.len()).min(all.len());\n        let mut notes = Vec::new();\n        // The finale plays the chart's last bars, the busiest.\n        for (b, line) in all[all.len() - n..].iter().enumerate() {\n            for (k, ch) in line.chars().enumerate() {\n                let lane = match ch {\n                    'L' => 0,\n                    'R' => 1,\n                    'B' => 2,\n                    _ => continue,\n                };\n                notes.push(Note { at: bar * (b as f32 + 1.0) + eighth * k as f32, lane, hit: 0 });\n            }\n        }\n        let end = bar * (n as f32 + 1.0) + 1.0;\n        cx.ev.push(SimEvent::Music { song: if o.band { 6 } else { 4 } });\n        Self { t: 0.0, notes, points: 0.0, combo: 0, perfect: 0, good: 0, miss: 0, end, side: 1.0, stepping: 0.0, last: 0, flash: 0.0, flash_text: 0, band: o.band, center: c, claps: 0 }\n    }\n\n    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        let dt = cx.dt;\n        self.t += dt;\n        // The music's clock leads when it is running: slew toward it, jump only if far out.\n        if let Some(p) = i.song_pos {\n            let d = p - self.t;\n            if d.abs() < 1.0 {\n                self.t += d * 0.2;\n            }\n        }\n        let s = &cx.r.step;\n        let (perfect, good) = (s.perfect, s.good);\n        let beat = 60.0 / s.bpm;\n        let beats = (self.t / beat) as u32;\n        if beats != self.claps {\n            self.claps = beats;\n            if beats % 4 == 0 && !self.band {\n                cx.sfx(sfx::CLAP, 0.25, 1.0);\n            }\n        }\n        for n in self.notes.iter_mut() {\n            if n.hit == 0 && self.t > n.at + good {\n                n.hit = 3;\n                self.miss += 1;\n                self.combo = 0;\n                self.flash = 0.5;\n                self.flash_text = 3;\n            }\n        }\n        for (pressed, lane) in [(i.l_p, 0u8), (i.r_p, 1u8)] {\n            if !pressed {\n                continue;\n            }\n            self.side = if lane == 0 { -1.0 } else { 1.0 };\n            self.stepping = 1.0;\n            self.last = lane;\n            cx.sfx(sfx::STEP, 0.7, 1.0);\n            // Doubles want both feet: the other one is checked by being held or pressed too.\n            let other = if lane == 0 { i.r } else { i.l };\n            let found = self.notes.iter().position(|n| {\n                n.hit == 0 && (n.at - self.t).abs() <= good && (n.lane == lane || (n.lane == 2 && other))\n            });\n            if let Some(k) = found {\n                let d = (self.notes[k].at - self.t).abs();\n                let p = d <= perfect;\n                self.notes[k].hit = if p { 2 } else { 1 };\n                self.points += if p { 1.0 } else { 0.6 };\n                self.combo += 1;\n                if p {\n                    self.perfect += 1;\n                } else {\n                    self.good += 1;\n                }\n                self.flash = 0.5;\n                self.flash_text = if p { 2 } else { 1 };\n                cx.sfx(if p { sfx::PERFECT } else { sfx::GOOD }, 0.6, 1.0);\n                if self.combo % 16 == 0 {\n                    cx.ev.push(SimEvent::Burst { pos: self.center + Vec3::Y * 2.0, kind: 0, count: 30 });\n                }\n            }\n        }\n        self.flash = (self.flash - dt).max(0.0);\n        self.stepping = (self.stepping - dt * 5.0).max(0.0);\n        // The step: a little hop to the side, a clip per foot.\n        let clip = if self.last == 0 { \"FIT/StepL\" } else { \"FIT/StepR\" };\n        cx.scrub(clip, 1.0 - self.stepping);\n        cx.lean_body(0.0);\n        self.t >= self.end\n    }\n\n    pub fn bot(&self, core: &BalanceCore, _r: &Rules) -> Intent {\n        let mut i = Intent { lean: pd(core, Vec2::ZERO), ..Default::default() };\n        for n in &self.notes {\n            if n.hit == 0 && (n.at - self.t).abs() < 0.012 {\n                match n.lane {\n                    0 => {\n                        i.l = true;\n                        i.l_p = true;\n                    }\n                    1 => {\n                        i.r = true;\n                        i.r_p = true;\n                    }\n                    _ => {\n                        i.l = true;\n                        i.r = true;\n                        i.l_p = true;\n                    }\n                }\n            }\n        }\n        i\n    }\n\n    pub fn hud(&self, b: &mut B, _core: &BalanceCore, r: &Rules) {\n        // Two lanes falling to two footprints, in the middle of the screen's left and right.\n        let hit_y = 900.0;\n        let lanes = [640.0, 1280.0];\n        let speed = 520.0;\n        for x in lanes {\n            b.flat([x - 80.0, 110.0, x + 80.0, 1000.0], [255, 255, 255, 110], 40.0);\n            b.circle([x, hit_y], 74.0, [0, 0, 0, 0], INK, 8.0);\n        }\n        for n in &self.notes {\n            if n.hit == 1 || n.hit == 2 {\n                continue;\n            }\n            let y = hit_y - (n.at - self.t) * speed;\n            if !(60.0..=1040.0).contains(&y) {\n                continue;\n            }\n            let fill = if n.hit == 3 { [200, 208, 215, 170] } else if n.lane == 2 { SUN } else if n.lane == 0 { TEAL } else { CORAL };\n            let mut draw = |x: f32| b.circle([x, y], 62.0, fill, WHITE, 6.0);\n            match n.lane {\n                0 => draw(lanes[0]),\n                1 => draw(lanes[1]),\n                _ => {\n                    draw(lanes[0]);\n                    draw(lanes[1]);\n                }\n            }\n        }\n        b.prompt_center(lanes[0], 980.0, &[Glyph::StepL], \"\");\n        b.prompt_center(lanes[1], 980.0, &[Glyph::StepR], \"\");\n        b.title_left(60.0, 30.0, 80.0, INK, &format!(\"{}\", self.score(r) as u32));\n        if self.combo > 3 {\n            b.title(960.0, 110.0, 72.0, TEAL, &format!(\"{} in a row\", self.combo));\n        }\n        if self.flash > 0.0 {\n            let (t, c) = match self.flash_text {\n                2 => (\"Perfect\", MINT),\n                1 => (\"Good\", TEAL),\n                _ => (\"Hm\", CORAL),\n            };\n            b.title(960.0, 220.0, 72.0, c, t);\n        }\n    }\n\n    pub fn score(&self, _r: &Rules) -> f32 {\n        1000.0 * self.points / (self.notes.len().max(1) as f32)\n    }\n}\nRS\ncat > $F/events/spin.rs <<'RS'\n//! Floatie Spin: circle the lean to keep inflatable rings up; catch new ones as guests toss them.\n\nuse super::*;\nuse crate::games::fit::sfx;\n\n#[derive(Clone, Copy, Debug, Serialize, Deserialize)]\npub struct Ring {\n    pub id: EntityId,\n    pub height: f32,\n    pub angle: f32,\n    /// 0 on the hips; 1 in flight.\n    pub flying: f32,\n    pub side: i8,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Spin {\n    pub t: f32,\n    pub rings: Vec<Ring>,\n    pub speed: f32,\n    pub dir: f32,\n    last_angle: f32,\n    switch_in: f32,\n    toss_in: f32,\n    pub sum: f32,\n    pub caught: u32,\n    center: Vec3,\n    in_band: bool,\n    pub keys: bool,\n    colors: u32,\n    bot_a: f32,\n}\n\nconst COLORS: [&str; 5] = [\"#ff786e\", \"#ffd166\", \"#46bec8\", \"#78dcaa\", \"#ff9ec4\"];\n\nimpl Spin {\n    pub fn start(cx: &mut Cx, _o: Opt) -> Self {\n        let c = cx.spot(BOARDWALK, \"center\") + Vec3::Y * 0.38 + Vec3::new(0.0, 0.0, -1.4);\n        cx.player(c, 0.0);\n        cx.core.wobble = 0.5;\n        *cx.shot = Shot { tilt: 14.0, yaw: 0.0, distance: 8.0, fov: 36.0, height: 0.9, focus: c };\n        cx.ev.push(SimEvent::Music { song: 4 });\n        cx.clip(\"FIT/HipCircle\", 1.0);\n        let mut s = Self { t: 0.0, rings: Vec::new(), speed: 0.0, dir: 1.0, last_angle: 0.0, switch_in: cx.r.spin.switch_every, toss_in: 2.0, sum: 0.0, caught: 0, center: c, in_band: false, keys: false, colors: 0, bot_a: 0.0 };\n        for _ in 0..2 {\n            s.add(cx, 0.0, 0);\n        }\n        s\n    }\n\n    fn add(&mut self, cx: &mut Cx, flying: f32, side: i8) {\n        let color = COLORS[self.colors as usize % COLORS.len()];\n        self.colors += 1;\n        let at = self.center + Vec3::Y * 0.9;\n        let id = cx.prop_color(\"fit_ring\", at, 0.0, 0.9, color);\n        self.rings.push(Ring { id, height: 0.95, angle: self.rings.len() as f32, flying, side });\n    }\n\n    fn band(&self, r: &Rules) -> (f32, f32) {\n        let k = if self.keys { r.spin.band_scale_keys } else { 1.0 };\n        (r.spin.band_low * k, r.spin.band_high * k)\n    }\n\n    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        let dt = cx.dt;\n        self.t += dt;\n        self.keys = i.keys;\n        let s = cx.r.spin.clone();\n        // Spin speed: the smoothed angular velocity of the lean, while it is leaned far enough.\n        let mut w = 0.0;\n        if i.lean.length() > 0.4 {\n            let a = i.lean.y.atan2(i.lean.x);\n            w = wrap_pi(a - self.last_angle) / dt;\n            self.last_angle = a;\n        }\n        self.speed += (w - self.speed) * (1.0 - (-6.0 * dt).exp());\n        self.switch_in -= dt;\n        if self.switch_in <= 0.0 {\n            self.switch_in = s.switch_every;\n            self.dir = -self.dir;\n            cx.say(\"Switch!\", 2.0);\n            cx.sfx(sfx::BELL, 0.7, 1.4);\n        }\n        let (lo, hi) = self.band(cx.r);\n        let v = self.speed * self.dir;\n        self.in_band = v >= lo && v <= hi;\n        // Guests toss rings from a side; press that side's step as it arrives.\n        self.toss_in -= dt;\n        if self.toss_in <= 0.0 && self.rings.len() < 7 {\n            self.toss_in = s.toss_every;\n            let side = if cx.rng().f32() < 0.5 { -1 } else { 1 };\n            self.add(cx, 1.0, side);\n            cx.sfx(sfx::WHOOSH, 0.6, 1.0);\n        }\n        let flight = 1.1;\n        let mut lost = Vec::new();\n        let mut caught_now = 0;\n        for (k, r) in self.rings.iter_mut().enumerate() {\n            if r.flying > 0.0 {\n                let left = r.flying * flight;\n                let pressed = if r.side < 0 { i.l_p } else { i.r_p };\n                if pressed && left <= s.catch_window {\n                    r.flying = 0.0;\n                    r.height = 0.95;\n                    r.side = 0;\n                    caught_now += 1;\n                    continue;\n                }\n                r.flying -= dt / flight;\n                if r.flying <= -s.catch_window / flight {\n                    lost.push(k);\n                }\n                continue;\n            }\n            let rate = if self.in_band { s.rise } else { -s.sink };\n            r.height = (r.height + rate * dt).clamp(0.0, 1.0);\n            if r.height <= 0.0 {\n                lost.push(k);\n            }\n            r.angle += self.speed * dt;\n        }\n        for _ in 0..caught_now {\n            self.caught += 1;\n            cx.sfx(sfx::POP, 0.7, 1.2);\n        }\n        for k in lost.into_iter().rev() {\n            let r = self.rings.remove(k);\n            cx.sim.despawn(r.id);\n            cx.sfx(sfx::SQUEAK, 0.6, 0.7);\n        }\n        if self.in_band {\n            let on = self.rings.iter().filter(|r| r.flying <= 0.0).count() as f32;\n            self.sum += on * dt;\n        }\n        // Draw.\n        let n = self.rings.len().max(1) as f32;\n        let phase = self.t * self.speed.clamp(-12.0, 12.0);\n        for (k, r) in self.rings.iter().enumerate() {\n            let pos = if r.flying > 0.0 {\n                let u = r.flying.clamp(0.0, 1.0);\n                self.center + Vec3::new(r.side as f32 * 9.0 * u, 0.9 + 3.0 * (u * PI).sin(), 0.0)\n            } else {\n                let wob = 0.12 + 0.05 * (k as f32 / n);\n                let a = phase + k as f32 * 1.7;\n                self.center + Vec3::new(a.cos() * wob, 0.05 + r.height * 0.85 + k as f32 * 0.06, a.sin() * wob)\n            };\n            let tilt = Quat::from_rotation_x(0.2 * (phase + k as f32).sin()) * Quat::from_rotation_z(0.2 * (phase + k as f32).cos());\n            cx.place(r.id, pos, tilt);\n        }\n        cx.lean_body(0.0);\n        self.t >= s.seconds\n    }\n\n    pub fn bot(&self, _core: &BalanceCore, r: &Rules) -> Intent {\n        let mut i = Intent::default();\n        // A steady circle at 7.5 rad/s the way the call asks.\n        let a = self.t * 7.5 * self.dir;\n        i.lean = Vec2::new(a.cos(), a.sin()) * 0.8;\n        for ring in &self.rings {\n            if ring.flying > 0.0 && ring.flying * 1.1 <= r.spin.catch_window * 0.6 {\n                if ring.side < 0 {\n                    i.l_p = true;\n                    i.l = true;\n                } else {\n                    i.r_p = true;\n                    i.r = true;\n                }\n            }\n        }\n        i\n    }\n\n    pub fn hud(&self, b: &mut B, core: &BalanceCore, r: &Rules) {\n        timer(b, r.spin.seconds - self.t);\n        b.puck(PUCK_TOP, PUCK_R, core.cob.into());\n        b.puck_stars(self.rings.len().min(7) as u8);\n        let (lo, hi) = self.band(r);\n        // The speed gauge: a bar with the sweet band marked.\n        let v = (self.speed * self.dir) / (hi * 1.4);\n        b.flat([560.0, 980.0, 1360.0, 1030.0], PALE, 24.0);\n        let (bl, bh) = (560.0 + 800.0 * lo / (hi * 1.4), 560.0 + 800.0 * hi / (hi * 1.4));\n        b.flat([bl, 980.0, bh, 1030.0], MINT, 24.0);\n        b.circle([560.0 + 800.0 * v.clamp(0.0, 1.0), 1005.0], 36.0, if self.in_band { CORAL } else { INK }, WHITE, 5.0);\n        let arrow = if self.dir > 0.0 { \"Circle this way: anticlockwise\" } else { \"Circle this way: clockwise\" };\n        b.center(960.0, 900.0, 44.0, INK, arrow);\n        for ring in &self.rings {\n            if ring.flying > 0.0 && ring.flying * 1.1 <= 0.6 {\n                let g = if ring.side < 0 { Glyph::StepL } else { Glyph::StepR };\n                b.prompt_center(if ring.side < 0 { 420.0 } else { 1500.0 }, 500.0, &[g], \"Catch\");\n            }\n        }\n    }\n\n    pub fn score(&self, r: &Rules) -> f32 {\n        1000.0 * self.sum / (r.spin.seconds * 5.2)\n    }\n}\nRS\ncat > $F/events/stillness.rs <<'RS'\n//! The Long Stillness: thirty seconds of nothing, while the game tries to make you press something.\n\nuse super::*;\nuse crate::games::fit::sfx;\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Stillness {\n    pub t: f32,\n    pub broke: bool,\n    pub fake: bool,\n    faded: bool,\n    pub seconds: f32,\n    pub spoken: bool,\n}\n\nimpl Stillness {\n    pub fn new(seconds: f32) -> Self {\n        Self { t: 0.0, broke: false, fake: false, faded: false, seconds, spoken: false }\n    }\n\n    /// Returns true when it is over. `any` is any button at all.\n    pub fn tick(&mut self, cx: &mut Cx, any: bool) -> bool {\n        self.t += cx.dt;\n        if !self.faded {\n            self.faded = true;\n            cx.ev.push(SimEvent::Music { song: 255 });\n        }\n        self.fake = self.t >= self.seconds * 0.5 && self.t < self.seconds * 0.5 + 8.0;\n        if any && !self.broke {\n            self.broke = true;\n            cx.sfx(sfx::SQUEAK, 0.5, 0.6);\n        }\n        cx.core.wobble = 0.6;\n        cx.scrub(\"FIT/Breath\", 0.5 + 0.1 * (self.t * 0.7).sin());\n        cx.lean_body(0.0);\n        self.t >= self.seconds\n    }\n\n    pub fn hud(&self, b: &mut B, core: &BalanceCore) {\n        b.puck([960.0, 200.0], PUCK_R, core.cob.into());\n        if self.fake {\n            b.card([560.0, 780.0, 1360.0, 900.0], DECK);\n            b.prompt_center(960.0, 810.0, &[Glyph::Confirm], \"Press to skip\");\n        }\n    }\n}\nRS\n","description":"Write event framework and the stillness, strength and cardio events"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15703,"cache_read_input_tokens":305500,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15703},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cb437ba7-0477-4143-bb04-ff33f49efd62","uuid":"ed489f55-97b2-43c4-8ff8-80795d29ff63","timestamp":"2026-11-05T05:56:40.163Z","request_id":"req_011CgjGApMpKDt6b2whR1hSm","wire_tool_inputs":{"toolu_012yHkBgGpX2iEToeJsHuocm":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953\nF=engine/crates/pav_core/src/games/fit\nsed -i 's/let feet_offset = 0.9 \\* def.scale;/let feet_offset = crate::character::Posture::Stand.height() * 0.5;/' $F/ghost.rs\ncat > $F/events/mod.rs <<'RS'\n//! The events. Each is a state struct with `start`, `tick`, `bot`, `hud` and `score`, dispatched\n//! through one enum so the game stays `Clone` + serde. To add an event: a file here, a line in\n//! `EvKind` and the `Ev` matches, a section in `rules.rs`, a card in `script.toml`.\n\nuse std::f32::consts::{PI, TAU};\n\nuse glam::{Quat, Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::core::BalanceCore;\nuse super::rules::Rules;\nuse super::ui_model::*;\nuse crate::color::Color;\nuse crate::entity::{EntityId, Spawn};\nuse crate::frame::SimEvent;\nuse crate::shape::{Shape, Visual};\nuse crate::sim::Sim;\n\npub mod breath;\npub mod cannon;\npub mod lap;\npub mod paddle;\npub mod plank;\npub mod pose;\npub mod spin;\npub mod squats;\npub mod step;\npub mod stillness;\npub mod tide;\npub mod tray;\n\n/// Set numbers (`SETS` in the game's order).\npub const HUB: usize = 0;\npub const STUDIO: usize = 1;\npub const GAZEBO: usize = 2;\npub const BOARDWALK: usize = 3;\npub const TIDE: usize = 4;\npub const CHANNEL: usize = 5;\npub const PIER: usize = 6;\npub const TOWER: usize = 7;\npub const BAY: usize = 8;\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]\npub enum EvKind {\n    Breath,\n    Pose,\n    Squats,\n    Plank,\n    Step,\n    Spin,\n    Lap,\n    Tide,\n    Paddle,\n    Tray,\n    Cannon,\n}\n\npub const ALL_EVENTS: [EvKind; 11] = [\n    EvKind::Breath,\n    EvKind::Pose,\n    EvKind::Squats,\n    EvKind::Plank,\n    EvKind::Step,\n    EvKind::Spin,\n    EvKind::Lap,\n    EvKind::Tide,\n    EvKind::Paddle,\n    EvKind::Tray,\n    EvKind::Cannon,\n];\n\nimpl EvKind {\n    pub fn key(self) -> &'static str {\n        match self {\n            EvKind::Breath => \"breath\",\n            EvKind::Pose => \"pose\",\n            EvKind::Squats => \"squats\",\n            EvKind::Plank => \"plank\",\n            EvKind::Step => \"step\",\n            EvKind::Spin => \"spin\",\n            EvKind::Lap => \"lap\",\n            EvKind::Tide => \"tide\",\n            EvKind::Paddle => \"paddle\",\n            EvKind::Tray => \"tray\",\n            EvKind::Cannon => \"cannon\",\n        }\n    }\n    pub fn from_key(k: &str) -> Option<Self> {\n        ALL_EVENTS.iter().copied().find(|e| e.key() == k)\n    }\n    pub fn name(self) -> &'static str {\n        match self {\n            EvKind::Breath => \"Breath Bloom\",\n            EvKind::Pose => \"Pose Parade\",\n            EvKind::Squats => \"Tempo Squats\",\n            EvKind::Plank => \"Plank Standoff\",\n            EvKind::Step => \"Step Party\",\n            EvKind::Spin => \"Floatie Spin\",\n            EvKind::Lap => \"Morning Lap\",\n            EvKind::Tide => \"Tide Table\",\n            EvKind::Paddle => \"Paddle Slalom\",\n            EvKind::Tray => \"Tray Trek\",\n            EvKind::Cannon => \"Cannonball Cup\",\n        }\n    }\n    /// The day it opens.\n    pub fn day(self) -> u8 {\n        match self {\n            EvKind::Breath | EvKind::Pose => 1,\n            EvKind::Squats | EvKind::Plank => 2,\n            EvKind::Step | EvKind::Spin | EvKind::Lap => 3,\n            _ => 4,\n        }\n    }\n    /// 0 Stillness, 1 Strength, 2 Cardio, 3 Lagoon.\n    pub fn pavilion(self) -> usize {\n        self.day() as usize - 1\n    }\n    pub fn set(self) -> usize {\n        match self {\n            EvKind::Breath | EvKind::Pose => STUDIO,\n            EvKind::Squats | EvKind::Plank => GAZEBO,\n            EvKind::Step | EvKind::Spin => BOARDWALK,\n            EvKind::Lap => HUB,\n            EvKind::Tide => TIDE,\n            EvKind::Paddle => CHANNEL,\n            EvKind::Tray => PIER,\n            EvKind::Cannon => TOWER,\n        }\n    }\n    pub fn coach(self) -> u8 {\n        (self.pavilion() as u8) + 1\n    }\n    /// Where a ghost runs, beside the player.\n    pub fn lane(self) -> Vec3 {\n        match self {\n            EvKind::Paddle => Vec3::X * 3.0,\n            EvKind::Lap | EvKind::Tray => Vec3::X * 1.6,\n            EvKind::Cannon => Vec3::NEG_X * 2.0,\n            EvKind::Tide => Vec3::new(2.5, 0.0, -2.5),\n            _ => Vec3::X * 2.4,\n        }\n    }\n}\n\npub const PAVILIONS: [&str; 4] = [\"Stillness Studio\", \"Iron Gazebo\", \"Boardwalk\", \"Lagoon\"];\n\n/// What the player gave, in the game's terms. The bot and attract mode give the same.\n#[derive(Clone, Copy, Debug, Default, PartialEq)]\npub struct Intent {\n    pub lean: Vec2,\n    pub keys: bool,\n    pub act: bool,\n    pub act_p: bool,\n    pub l: bool,\n    pub l_p: bool,\n    pub r: bool,\n    pub r_p: bool,\n    pub song_pos: Option<f32>,\n}\n\nimpl Intent {\n    pub fn brace(&self) -> bool {\n        self.l && self.r\n    }\n}\n\n/// Where the camera should be: tilt, yaw, distance, fov, height, focus.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct Shot {\n    pub tilt: f32,\n    pub yaw: f32,\n    pub distance: f32,\n    pub fov: f32,\n    pub height: f32,\n    pub focus: Vec3,\n}\n\n/// What an event may touch while it runs.\npub struct Cx<'a> {\n    pub sim: &'a mut Sim,\n    pub ev: &'a mut Vec<SimEvent>,\n    pub r: &'a Rules,\n    pub dt: f32,\n    pub core: &'a mut BalanceCore,\n    pub actors: &'a mut Vec<EntityId>,\n    pub spots: &'a super::Spots,\n    pub pid: EntityId,\n    pub shot: &'a mut Shot,\n    pub msg: &'a mut Option<(String, f32)>,\n    pub seed: u32,\n    pub demo: bool,\n    pub slump: f32,\n    pub flops: &'a mut [bool; 5],\n    pub flop_ids: &'a [Option<EntityId>; 5],\n}\n\nimpl Cx<'_> {\n    pub fn spot(&self, set: usize, name: &str) -> Vec3 {\n        self.spots.get(set, name)\n    }\n\n    pub fn prop(&mut self, asset: &str, pos: Vec3, yaw: f32, scale: f32) -> EntityId {\n        self.prop_color(asset, pos, yaw, scale, \"#46bec8\")\n    }\n\n    pub fn prop_color(&mut self, asset: &str, pos: Vec3, yaw: f32, scale: f32, accent: &str) -> EntityId {\n        let id = spawn_prop(self.sim, asset, pos, yaw, scale, accent);\n        self.actors.push(id);\n        id\n    }\n\n    pub fn ball(&mut self, radius: f32, color: &str, pos: Vec3) -> EntityId {\n        let id = self.sim.spawn(Spawn::new(\"~fx\", pos).visual(Visual::new(Shape::Sphere { radius }, Color::hex(color))));\n        self.actors.push(id);\n        id\n    }\n\n    pub fn place(&mut self, id: EntityId, pos: Vec3, rot: Quat) {\n        if let Some(e) = self.sim.state.entities.get_mut(id) {\n            e.pos = pos;\n            e.rot = rot;\n        }\n    }\n\n    /// Puts the player's feet at `pos`, facing `yaw` (radians, 0 = +Z).\n    pub fn player(&mut self, pos: Vec3, yaw: f32) {\n        self.sim.set_position(self.pid, pos);\n        self.face(yaw);\n    }\n\n    pub fn face(&mut self, yaw: f32) {\n        if let Some(ch) = self.sim.state.entities.get_mut(self.pid).and_then(|e| e.character.as_mut()) {\n            ch.facing = yaw;\n            ch.anim.facing = yaw;\n        }\n    }\n\n    pub fn anim(&mut self) -> Option<&mut crate::puppet::PuppetState> {\n        self.sim.state.entities.get_mut(self.pid).and_then(|e| e.character.as_mut()).map(|c| &mut c.anim)\n    }\n\n    /// Plays a looping clip on the whole body.\n    pub fn clip(&mut self, name: &str, speed: f32) {\n        let id = crate::clips::find_cached(name);\n        if let Some(a) = self.anim() {\n            a.play_clip(id, 0, speed);\n        }\n    }\n\n    /// One-shot gesture on top.\n    pub fn gesture(&mut self, name: &str) {\n        let id = crate::clips::find_cached(name);\n        if let Some(a) = self.anim() {\n            a.replay_clip(id, crate::clips::ONCE | crate::clips::QUICK, 1.0);\n        }\n    }\n\n    /// Holds a clip at `frac` of the way through: the game drives it (depth, breath).\n    pub fn scrub(&mut self, name: &str, frac: f32) {\n        let id = crate::clips::find_cached(name);\n        let dur = crate::clips::with(id, |c| c.dur).unwrap_or(1.0);\n        if let Some(a) = self.anim() {\n            a.play_clip(id, 0, 1e-6);\n            a.clip_t = frac.clamp(0.0, 1.0) * dur * 0.999;\n        }\n    }\n\n    pub fn stop_clip(&mut self) {\n        if let Some(a) = self.anim() {\n            a.stop_clip();\n        }\n    }\n\n    /// The figure tilts with the dot, seen from a camera at `cam_yaw` degrees.\n    pub fn lean_body(&mut self, cam_yaw: f32) {\n        let cob = self.core.cob;\n        let slump = self.slump;\n        self.lean_body_by(cob, cam_yaw, slump);\n    }\n\n    pub fn lean_body_by(&mut self, cob: Vec2, cam_yaw: f32, slump: f32) {\n        let y = cam_yaw.to_radians();\n        let right = Vec3::new(y.cos(), 0.0, y.sin());\n        let fwd = Vec3::new(y.sin(), 0.0, -y.cos());\n        let w = (right * cob.x + fwd * cob.y) * 14f32.to_radians();\n        let flail = crate::clips::find_cached(\"FIT/ArmFlail\");\n        if let Some(a) = self.anim() {\n            a.tilt_side = w.x;\n            a.tilt_fwd = w.z + slump;\n            a.tilt_pivot = 0.0;\n            // Beyond 0.75 the arms start to flail, drawn by the upper-body clip in the second slot.\n            let far = cob.length();\n            if far > 0.75 && a.clip == 0 {\n                a.play_clip(flail, crate::clips::UPPER, 1.0);\n            } else if far <= 0.7 && a.clip == flail {\n                a.stop_clip();\n            }\n        }\n    }\n\n    pub fn sfx(&mut self, id: u8, gain: f32, pitch: f32) {\n        self.ev.push(SimEvent::Sfx { id, gain, pitch });\n    }\n\n    pub fn say(&mut self, text: impl Into<String>, seconds: f32) {\n        *self.msg = Some((text.into(), seconds));\n    }\n\n    pub fn pick(&mut self, key: &str) -> String {\n        let n = self.sim.state.rng.next_u32();\n        super::script::line(key, n)\n    }\n\n    pub fn rng(&mut self) -> &mut crate::rng::Rng {\n        &mut self.sim.state.rng\n    }\n\n    /// A tip: stumble and, over water, a splash.\n    pub fn tip_fx(&mut self, water: bool) {\n        self.gesture(\"FIT/Stumble\");\n        let at = self.sim.feet(self.pid).unwrap_or_default();\n        if water {\n            self.ev.push(SimEvent::Splash { pos: at });\n        }\n        self.sfx(super::sfx::GROAN, 0.5, 1.0);\n    }\n\n    /// Standard stage: the player in front of a mirror-style camera, facing it.\n    pub fn mirror_shot(&mut self, focus: Vec3, distance: f32) {\n        *self.shot = Shot { tilt: 12.0, yaw: 0.0, distance, fov: 36.0, height: 0.9, focus };\n    }\n}\n\npub fn spawn_prop(sim: &mut Sim, asset: &str, pos: Vec3, yaw: f32, scale: f32, accent: &str) -> EntityId {\n    let name = format!(\"LIB/core/{asset}\");\n    let made = crate::props::resolve_placed(&name, &crate::props::Params::new()).ok().and_then(|(n, definition, params)| {\n        let mut roles = std::collections::BTreeMap::new();\n        roles.insert(\"$accent\".to_string(), accent.to_string());\n        crate::prop_instance::PropInstance::new(&n, definition, scale, false).ok()?.with_params(&params).ok()?.with_roles(roles).ok()\n    });\n    match made.and_then(|inst| sim.place_prop(inst, pos, Quat::from_rotation_y(yaw), None).ok()) {\n        Some(id) => id,\n        // A missing prop must not stop the game: a marker ball says so in captures.\n        None => {\n            log::error!(\"no prop {name}\");\n            sim.spawn(Spawn::new(\"~missing\", pos).visual(Visual::new(Shape::Sphere { radius: 0.2 }, Color::hex(\"#ff00ff\"))))\n        }\n    }\n}\n\n/// The state of whichever event is running.\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub enum Ev {\n    Breath(breath::Breath),\n    Pose(pose::Pose),\n    Squats(squats::Squats),\n    Plank(plank::Plank),\n    Step(step::Step),\n    Spin(spin::Spin),\n    Lap(lap::Lap),\n    Tide(tide::Tide),\n    Paddle(paddle::Paddle),\n    Tray(tray::Tray),\n    Cannon(cannon::Cannon),\n}\n\n/// Per-event options the finale and the medley use.\n#[derive(Clone, Copy, Debug, Default)]\npub struct Opt {\n    /// Replaces the event's length, when it has one.\n    pub seconds: Option<f32>,\n    /// Number of cycles, bars or rounds, when it has them.\n    pub count: Option<u32>,\n    /// A stage of the game's choosing: the finale's post.\n    pub at: Option<Vec3>,\n    pub band: bool,\n}\n\nmacro_rules! each {\n    ($s:expr, $e:ident => $x:expr) => {\n        match $s {\n            Ev::Breath($e) => $x,\n            Ev::Pose($e) => $x,\n            Ev::Squats($e) => $x,\n            Ev::Plank($e) => $x,\n            Ev::Step($e) => $x,\n            Ev::Spin($e) => $x,\n            Ev::Lap($e) => $x,\n            Ev::Tide($e) => $x,\n            Ev::Paddle($e) => $x,\n            Ev::Tray($e) => $x,\n            Ev::Cannon($e) => $x,\n        }\n    };\n}\n\nimpl Ev {\n    pub fn start(kind: EvKind, cx: &mut Cx, o: Opt) -> Ev {\n        match kind {\n            EvKind::Breath => Ev::Breath(breath::Breath::start(cx, o)),\n            EvKind::Pose => Ev::Pose(pose::Pose::start(cx, o)),\n            EvKind::Squats => Ev::Squats(squats::Squats::start(cx, o)),\n            EvKind::Plank => Ev::Plank(plank::Plank::start(cx, o)),\n            EvKind::Step => Ev::Step(step::Step::start(cx, o)),\n            EvKind::Spin => Ev::Spin(spin::Spin::start(cx, o)),\n            EvKind::Lap => Ev::Lap(lap::Lap::start(cx, o)),\n            EvKind::Tide => Ev::Tide(tide::Tide::start(cx, o)),\n            EvKind::Paddle => Ev::Paddle(paddle::Paddle::start(cx, o)),\n            EvKind::Tray => Ev::Tray(tray::Tray::start(cx, o)),\n            EvKind::Cannon => Ev::Cannon(cannon::Cannon::start(cx, o)),\n        }\n    }\n    /// Returns true when the event is over.\n    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        each!(self, e => e.tick(cx, i))\n    }\n    pub fn bot(&self, core: &BalanceCore, r: &Rules) -> Intent {\n        each!(self, e => e.bot(core, r))\n    }\n    pub fn hud(&self, b: &mut B, core: &BalanceCore, r: &Rules) {\n        each!(self, e => e.hud(b, core, r))\n    }\n    /// 0..=1000.\n    pub fn score(&self, r: &Rules) -> u32 {\n        (each!(self, e => e.score(r))).clamp(0.0, 1000.0).round() as u32\n    }\n    /// The running progress as a live number for the HUD.\n    pub fn live(&self, r: &Rules) -> u32 {\n        self.score(r)\n    }\n}\n\npub fn clamp01(x: f32) -> f32 {\n    x.clamp(0.0, 1.0)\n}\n\n/// Spot a dot-steering PD uses in several bots.\npub fn pd(core: &BalanceCore, target: Vec2) -> Vec2 {\n    // The body follows the lean closely, so aiming a bit past the target corrects its lag.\n    (target + (target - core.cob) * 0.4 - core.vel * 0.05).clamp_length_max(1.0)\n}\n\n/// A pentatonic pitch ratio.\npub fn penta(i: u32) -> f32 {\n    const S: [f32; 5] = [1.0, 1.122, 1.26, 1.498, 1.682];\n    S[i as usize % 5] * 2f32.powi((i / 5) as i32)\n}\n\npub const PUCK_TOP: [f32; 2] = [1700.0, 220.0];\npub const PUCK_R: f32 = 170.0;\n\npub fn timer(b: &mut B, left: f32) {\n    b.title_left(60.0, 30.0, 80.0, INK, &format!(\"{:.0}\", left.max(0.0).ceil()));\n}\n\npub fn wrap_pi(a: f32) -> f32 {\n    (a + PI).rem_euclid(TAU) - PI\n}\nRS\ncat > $F/events/breath.rs <<'RS'\n//! Breath Bloom: hold to inhale, release to exhale, following a guide; lotuses open on the water.\n\nuse super::*;\nuse crate::games::fit::sfx;\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Breath {\n    pub t: f32,\n    pub lungs: f32,\n    pub cycles: u32,\n    pub sum: f32,\n    pub time: f32,\n    cycle_sum: f32,\n    cycle_time: f32,\n    cycle: u32,\n    pub good: u32,\n    lotus: Vec<EntityId>,\n    center: Vec3,\n}\n\nimpl Breath {\n    pub fn start(cx: &mut Cx, o: Opt) -> Self {\n        let center = o.at.unwrap_or(cx.spot(STUDIO, \"center\"));\n        cx.player(center, 0.0);\n        cx.core.wobble = cx.r.breath.wobble;\n        cx.mirror_shot(center, 8.5);\n        let mut lotus = Vec::new();\n        // Buds wait on the water; each good cycle opens one more, a perfect run blooms the pond.\n        let cycles = o.count.unwrap_or(5);\n        for i in 0..cycles * 3 {\n            let a = i as f32 * 2.4;\n            let r = 8.0 + (i % 4) as f32 * 2.0;\n            let id = cx.prop(\"fit_lotus\", center + Vec3::new(a.cos() * r, -8.0, a.sin().abs() * -r - 1.0), a, 1.0);\n            lotus.push(id);\n        }\n        Self { t: 0.0, lungs: 0.0, cycles, sum: 0.0, time: 0.0, cycle_sum: 0.0, cycle_time: 0.0, cycle: 0, good: 0, lotus, center }\n    }\n\n    /// Seconds in a cycle, and the guide (0 empty, 1 full) at time `t`, and which cycle it is.\n    fn guide(&self, r: &Rules, t: f32) -> (f32, u32, bool) {\n        let half = r.breath.seconds_in;\n        let cycle = half * 2.0;\n        let last = self.cycles.saturating_sub(1);\n        let plain = last as f32 * cycle;\n        if t < plain {\n            let n = (t / cycle) as u32;\n            let u = t - n as f32 * cycle;\n            if u < half { (u / half, n, true) } else { (1.0 - (u - half) / half, n, false) }\n        } else {\n            // The last breath is longer: half as long again.\n            let u = t - plain;\n            let h = half * 1.6;\n            if u < h { (clamp01(u / h), last, true) } else { (clamp01(1.0 - (u - h) / h), last, false) }\n        }\n    }\n\n    pub fn length(&self, r: &Rules) -> f32 {\n        let half = r.breath.seconds_in;\n        self.cycles.saturating_sub(1) as f32 * half * 2.0 + half * 3.2\n    }\n\n    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        let dt = cx.dt;\n        self.t += dt;\n        let rate = 1.0 / cx.r.breath.seconds_in;\n        self.lungs = clamp01(self.lungs + if i.act { rate } else { -rate } * dt);\n        let (g, cycle, _) = self.guide(cx.r, self.t);\n        let in_ring = cx.core.cob.length() < cx.r.breath.ring;\n        // Not breathing earns nothing, however still you are (a decision: see notes/decisions.md).\n        let m = 1.0 - clamp01((self.lungs - g).abs() / cx.r.breath.match_width);\n        let v = m * (0.7 + 0.3 * in_ring as u8 as f32);\n        self.sum += v * dt;\n        self.time += dt;\n        self.cycle_sum += v * dt;\n        self.cycle_time += dt;\n        if cycle != self.cycle {\n            self.cycle = cycle;\n            let good = self.cycle_sum / self.cycle_time.max(0.1);\n            self.cycle_sum = 0.0;\n            self.cycle_time = 0.0;\n            if good > 0.6 {\n                self.bloom(cx, 3);\n            }\n        }\n        cx.scrub(\"FIT/Breath\", self.lungs);\n        cx.lean_body(0.0);\n        if self.t >= self.length(cx.r) {\n            if self.cycle_sum / self.cycle_time.max(0.1) > 0.6 {\n                self.bloom(cx, 3);\n            }\n            if self.good >= self.cycles {\n                let n = self.lotus.len() as u32;\n                self.bloom(cx, n);\n                cx.say(cx.pick_static(\"posey_perfect\"), 3.0);\n            }\n            return true;\n        }\n        false\n    }\n\n    fn bloom(&mut self, cx: &mut Cx, n: u32) {\n        for _ in 0..n {\n            if let Some(id) = self.lotus.pop() {\n                if let Some(e) = cx.sim.state.entities.get_mut(id) {\n                    e.pos.y = self.center.y - 0.02;\n                    let p = e.pos;\n                    cx.ev.push(SimEvent::Burst { pos: p + Vec3::Y * 0.2, kind: 1, count: 18 });\n                }\n            }\n        }\n        self.good += 1;\n        cx.sfx(sfx::CHIME, 0.7, penta(self.good * 2));\n    }\n\n    pub fn bot(&self, core: &BalanceCore, r: &Rules) -> Intent {\n        let (_, _, rising) = self.guide(r, self.t + 0.03);\n        Intent { act: rising, lean: pd(core, Vec2::ZERO), ..Default::default() }\n    }\n\n    pub fn hud(&self, b: &mut B, core: &BalanceCore, r: &Rules) {\n        timer(b, self.length(r) - self.t);\n        b.puck(PUCK_TOP, PUCK_R, core.cob.into());\n        b.puck_ring([0.0, 0.0], r.breath.ring);\n        // The guide ring around the figure, and your lungs inside it.\n        let (g, _, rising) = self.guide(r, self.t);\n        let c = [960.0, 540.0];\n        b.circle(c, 150.0 + g * 200.0, [0, 0, 0, 0], TEAL, 10.0);\n        b.circle(c, 150.0 + self.lungs * 200.0, [0x78, 0xdc, 0xaa, 50], MINT, 6.0);\n        b.center(960.0, 90.0, 64.0, INK, if rising { \"Breathe in\" } else { \"Breathe out\" });\n    }\n\n    pub fn score(&self, _r: &Rules) -> f32 {\n        // Averaged over the whole event, however far it has got.\n        1000.0 * self.sum / self.time.max(1.0) * 1.05\n    }\n}\n\nimpl Cx<'_> {\n    /// A script line for messages, from a key.\n    pub fn pick_static(&mut self, key: &str) -> String {\n        self.pick(key)\n    }\n}\nRS\ncat > $F/events/pose.rs <<'RS'\n//! Pose Parade: hold a deadpan pose while a ring drifts; stay in it to climb a multiplier.\n\nuse super::*;\nuse crate::games::fit::sfx;\n\npub const POSES: [(&str, &str); 6] = [\n    (\"FIT/Tree\", \"the Patient Heron\"),\n    (\"FIT/Warrior\", \"the Apologetic Lunge\"),\n    (\"FIT/Lighthouse\", \"the Tired Lighthouse\"),\n    (\"FIT/DeckChair\", \"the Folded Deck Chair\"),\n    (\"FIT/Bridge\", \"the Reluctant Bridge\"),\n    (\"FIT/Seated\", \"Seated Disappointment\"),\n];\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Pose {\n    pub t: f32,\n    pub count: u32,\n    pub first: u32,\n    pub sum: f32,\n    pub mult: u32,\n    streak: f32,\n    broken: f32,\n    gull: Option<EntityId>,\n    gull_t: f32,\n    posey: Option<EntityId>,\n    seconds: f32,\n    announced: u32,\n    pub ring: Vec2,\n    pub radius: f32,\n    center: Vec3,\n    pub gusts: bool,\n    gust_a: f32,\n}\n\nimpl Pose {\n    pub fn start(cx: &mut Cx, o: Opt) -> Self {\n        let center = o.at.unwrap_or(cx.spot(STUDIO, \"center\"));\n        cx.player(center, 0.0);\n        cx.core.wobble = 1.0;\n        cx.mirror_shot(center, 8.5);\n        let posey = cx.sim.state.entities.iter().find(|e| e.name == \"posey\" && (e.pos - center).length() < 12.0).map(|e| e.id);\n        let count = o.count.unwrap_or(3);\n        // Each day brings new poses; the seed turns the parade.\n        let first = (cx.seed % 2) * 3;\n        Self {\n            t: 0.0,\n            count,\n            first,\n            sum: 0.0,\n            mult: 1,\n            streak: 0.0,\n            broken: 0.0,\n            gull: None,\n            gull_t: 0.0,\n            posey,\n            seconds: o.seconds.unwrap_or(cx.r.pose.seconds),\n            announced: 99,\n            ring: Vec2::ZERO,\n            radius: cx.r.pose.ring_start,\n            center,\n            gusts: o.band,\n            gust_a: 0.0,\n        }\n    }\n\n    fn index(&self) -> u32 {\n        ((self.t / self.seconds) as u32).min(self.count - 1)\n    }\n\n    fn pose(&self) -> usize {\n        ((self.first + self.index()) % 6) as usize\n    }\n\n    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        let dt = cx.dt;\n        self.t += dt;\n        let n = self.index();\n        let local = self.t - n as f32 * self.seconds;\n        let u = clamp01(local / self.seconds);\n        let r = &cx.r.pose;\n        self.radius = r.ring_start + (r.ring_end - r.ring_start) * u;\n        let w = TAU * r.drift_hz * self.t;\n        self.ring = Vec2::new(w.sin(), (w * 1.37 + 0.7).sin()) * r.drift;\n        let (drift, gull_w) = (r.drift, r.gull_wobble);\n        let _ = drift;\n        if n != self.announced {\n            self.announced = n;\n            let (clip, name) = POSES[self.pose()];\n            cx.sfx(sfx::WOOD, 0.8, 1.0);\n            cx.say(format!(\"This is {name}.\"), 3.0);\n            cx.clip(clip, 1.0);\n            if let Some(p) = self.posey {\n                let id = crate::clips::find_cached(clip);\n                if let Some(ch) = cx.sim.state.entities.get_mut(p).and_then(|e| e.character.as_mut()) {\n                    ch.anim.play_clip(id, 0, 1.0);\n                }\n            }\n        }\n        // The gull: at 12 s of the second pose, for five seconds.\n        if n == 1.min(self.count - 1) && local >= 12.0 && self.gull_t == 0.0 {\n            self.gull_t = 5.0;\n            let at = self.center + Vec3::Y * 2.05;\n            self.gull = Some(cx.prop(\"fit_gull\", at + Vec3::Y * 2.0, 0.0, 0.7));\n            cx.sfx(sfx::GULL, 0.8, 1.0);\n            cx.say(\"There is a bird on you. Accept the bird.\", 4.0);\n        }\n        if self.gull_t > 0.0 {\n            self.gull_t -= dt;\n            cx.core.wobble = gull_w;\n            if let Some(g) = self.gull {\n                let head = self.center + Vec3::Y * 1.92 + Vec3::new(cx.core.cob.x * 0.4, 0.0, -cx.core.cob.y * 0.4);\n                let drop = (self.gull_t - 4.5).max(0.0) * 4.0;\n                cx.place(g, head + Vec3::Y * drop, Quat::IDENTITY);\n                if self.gull_t <= 0.0 {\n                    cx.place(g, self.center + Vec3::new(-30.0, 8.0, -30.0), Quat::IDENTITY);\n                    self.gull = None;\n                    self.gull_t = -1.0;\n                }\n            }\n        } else {\n            cx.core.wobble = 1.0;\n        }\n        if self.gusts {\n            self.gust_a += dt * 0.7;\n            let w = (self.t * 0.8).sin().max(0.0) * cx.r.finale.gust;\n            cx.core.gust = Vec2::new(self.gust_a.cos(), self.gust_a.sin()) * w;\n        }\n        // In the ring the streak climbs one step per 2 s; leaving resets it. A tip breaks the pose.\n        if self.broken > 0.0 {\n            self.broken -= dt;\n            self.mult = 1;\n            self.streak = 0.0;\n        } else if (cx.core.cob - self.ring).length() < self.radius {\n            self.streak += dt;\n            let m = 1 + (self.streak / 2.0) as u32;\n            if m.min(4) > self.mult {\n                cx.sfx(sfx::STAR, 0.5, penta(m));\n            }\n            self.mult = m.min(4);\n            self.sum += self.mult as f32 * dt;\n        } else {\n            self.streak = 0.0;\n            self.mult = 1;\n        }\n        if cx.core.cob.length() < 0.001 && cx.core.tips > 0 {\n            self.broken = 1.5;\n        }\n        cx.lean_body(0.0);\n        self.t >= self.seconds * self.count as f32\n    }\n\n    /// A tip breaks the pose for a moment.\n    pub fn on_tip(&mut self) {\n        self.broken = 1.5;\n    }\n\n    pub fn bot(&self, core: &BalanceCore, _r: &Rules) -> Intent {\n        Intent { lean: pd(core, self.ring), ..Default::default() }\n    }\n\n    pub fn hud(&self, b: &mut B, core: &BalanceCore, _r: &Rules) {\n        timer(b, self.seconds * self.count as f32 - self.t);\n        b.puck(PUCK_TOP, PUCK_R, core.cob.into());\n        b.puck_ring(self.ring.into(), self.radius);\n        b.puck_stars((self.mult.saturating_sub(1)) as u8);\n        b.title(1700.0, 410.0, 72.0, if self.mult >= 4 { CORAL } else { TEAL }, &format!(\"x{}\", self.mult));\n        let (_, name) = POSES[self.pose()];\n        b.center(960.0, 60.0, 50.0, INK, name);\n    }\n\n    pub fn score(&self, r: &Rules) -> f32 {\n        let total = (self.seconds * self.count as f32).max(1.0);\n        1000.0 * self.sum / (total * r.pose.full_score)\n    }\n}\nRS\ncat > $F/events/squats.rs <<'RS'\n//! Tempo Squats: hold to go down, release to rise, to a guide bar; keep the dot in the band.\n\nuse super::*;\nuse crate::games::fit::sfx;\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Squats {\n    pub t: f32,\n    pub rep: u32,\n    pub depth: f32,\n    rep_sum: f32,\n    rep_band: f32,\n    rep_time: f32,\n    pub total: f32,\n    belled: bool,\n    pub gag: f32,\n}\n\nimpl Squats {\n    pub fn start(cx: &mut Cx, _o: Opt) -> Self {\n        let c = cx.spot(GAZEBO, \"center\");\n        cx.player(c, 0.0);\n        cx.core.wobble = 1.0;\n        *cx.shot = Shot { tilt: 14.0, yaw: -16.0, distance: 8.0, fov: 36.0, height: 0.8, focus: c };\n        Self { t: 0.0, rep: 0, depth: 0.0, rep_sum: 0.0, rep_band: 0.0, rep_time: 0.0, total: 0.0, belled: false, gag: 0.0 }\n    }\n\n    fn cycle(r: &Rules) -> f32 {\n        r.squats.down + r.squats.up + r.squats.rest\n    }\n\n    /// The guide's depth at a time within a rep, and whether it wants you going down.\n    fn guide(r: &Rules, u: f32) -> (f32, bool) {\n        let s = &r.squats;\n        if u < s.down {\n            (u / s.down, true)\n        } else if u < s.down + s.up {\n            (1.0 - (u - s.down) / s.up, false)\n        } else {\n            (0.0, false)\n        }\n    }\n\n    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        let dt = cx.dt;\n        self.t += dt;\n        let s = &cx.r.squats;\n        if self.gag > 0.0 {\n            self.gag -= dt;\n            cx.scrub(\"FIT/Squat\", 0.0);\n            return self.gag <= 0.0;\n        }\n        let reps = s.reps as u32;\n        let c = Self::cycle(cx.r);\n        let u = self.t - self.rep as f32 * c;\n        self.depth = clamp01(self.depth + if i.act { dt / s.down } else { -dt / s.up });\n        let (g, _) = Self::guide(cx.r, u);\n        cx.core.wobble = 1.0 + s.wobble_per_rep * self.rep as f32;\n        if u < s.down + s.up {\n            self.rep_sum += (1.0 - clamp01((self.depth - g).abs() / 0.35)) * dt;\n            self.rep_band += (cx.core.cob.x.abs() < s.band) as u8 as f32 * dt;\n            self.rep_time += dt;\n        }\n        if u >= s.down && !self.belled {\n            self.belled = true;\n            cx.sfx(sfx::BELL, 0.8, 0.5);\n        }\n        if u >= c {\n            let timing = self.rep_sum / self.rep_time.max(0.1);\n            let band = self.rep_band / self.rep_time.max(0.1);\n            // Standing still in the band earns nothing without the squat.\n            self.total += timing * (0.7 + 0.3 * band);\n            self.rep += 1;\n            self.rep_sum = 0.0;\n            self.rep_band = 0.0;\n            self.rep_time = 0.0;\n            self.belled = false;\n            cx.sfx(sfx::STAR, 0.5, penta(self.rep));\n            if self.rep >= reps {\n                self.gag = 2.0;\n                cx.say(\"Ten. Also eleven.\", 2.0);\n                cx.sfx(sfx::GONG, 0.5, 1.0);\n            }\n        }\n        cx.scrub(\"FIT/Squat\", self.depth);\n        cx.lean_body(-16.0);\n        false\n    }\n\n    pub fn bot(&self, core: &BalanceCore, r: &Rules) -> Intent {\n        let c = Self::cycle(r);\n        let u = self.t - self.rep as f32 * c;\n        let (_, down) = Self::guide(r, u + 0.02);\n        Intent { act: down, lean: pd(core, Vec2::ZERO), ..Default::default() }\n    }\n\n    pub fn hud(&self, b: &mut B, core: &BalanceCore, r: &Rules) {\n        let c = Self::cycle(r);\n        let u = self.t - self.rep as f32 * c;\n        let (g, down) = Self::guide(r, u);\n        b.puck(PUCK_TOP, PUCK_R, core.cob.into());\n        b.puck_band(r.squats.band);\n        b.title_left(60.0, 30.0, 80.0, INK, &format!(\"{} of {}\", (self.rep + 1).min(r.squats.reps as u32), r.squats.reps as u32));\n        // The tempo bar: the guide above, your depth below.\n        let x = 70.0;\n        b.flat([x, 240.0, x + 110.0, 760.0], PALE, 30.0);\n        b.flat([x, 240.0 + g * 480.0, x + 110.0, 280.0 + g * 480.0], TEAL, 16.0);\n        b.flat([x + 20.0, 250.0 + self.depth * 480.0, x + 90.0, 270.0 + self.depth * 480.0], CORAL, 10.0);\n        b.center(x + 55.0, 780.0, 40.0, INK, if down { \"Down\" } else { \"Up\" });\n    }\n\n    pub fn score(&self, r: &Rules) -> f32 {\n        1000.0 * self.total / r.squats.reps\n    }\n}\nRS\ncat > $F/events/plank.rs <<'RS'\n//! Plank Standoff: hold Brace and keep the dot in a shrinking ring for as long as you can.\n\nuse super::*;\nuse crate::games::fit::sfx;\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Plank {\n    pub t: f32,\n    pub out: f32,\n    pub radius: f32,\n    pub flop: f32,\n    told: u8,\n    pub seconds: f32,\n    /// Waves shove the figure (the finale).\n    pub waves: bool,\n    wave_in: f32,\n    /// A tip does not end the finale's brace.\n    pub forgiving: bool,\n    pub survived: f32,\n    grace: f32,\n}\n\nimpl Plank {\n    pub fn start(cx: &mut Cx, o: Opt) -> Self {\n        let c = o.at.unwrap_or(cx.spot(GAZEBO, \"center\"));\n        cx.player(c, 0.0);\n        cx.core.wobble = 1.0;\n        *cx.shot = Shot { tilt: 16.0, yaw: -68.0, distance: 8.0, fov: 36.0, height: 0.5, focus: c };\n        if o.at.is_some() {\n            cx.mirror_shot(c, 9.0);\n        }\n        cx.scrub(\"FIT/Plank\", 0.0);\n        Self { t: 0.0, out: 0.0, radius: cx.r.plank.ring_start, flop: 0.0, told: 0, seconds: o.seconds.unwrap_or(cx.r.plank.seconds), waves: o.band, wave_in: 2.0, forgiving: o.band, survived: 0.0, grace: 1.0 }\n    }\n\n    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        let dt = cx.dt;\n        if self.flop > 0.0 {\n            self.flop -= dt;\n            return self.flop <= 0.0;\n        }\n        self.t += dt;\n        self.grace -= dt;\n        let p = &cx.r.plank;\n        let u = clamp01(self.t / self.seconds);\n        self.radius = p.ring_start + (p.ring_end - p.ring_start) * u;\n        cx.core.wobble = 1.0 + p.fatigue * u + if self.t > 30.0 { 0.35 } else { 0.0 };\n        // At 45 s Kettle laughs at his own joke and the nudge shakes the screen.\n        if self.t > 45.0 && self.told < 2 {\n            self.told = 2;\n            cx.core.nudge += Vec2::new(14.0, 0.0);\n            cx.say(\"A plank walks into a bar. I am so sorry. Hold on.\", 4.0);\n            cx.sfx(sfx::GONG, 0.5, 0.7);\n        } else if self.t > 30.0 && self.told < 1 {\n            self.told = 1;\n            cx.say(\"You are trembling. That is the strength leaving. It is fine.\", 4.0);\n        }\n        if self.waves {\n            self.wave_in -= dt;\n            if self.wave_in <= 0.0 {\n                self.wave_in = cx.rng().range(2.0, 3.5);\n                let a = cx.rng().range(0.0, TAU);\n                cx.core.nudge += Vec2::new(a.cos(), a.sin()) * cx.r.finale.waves * 6.0;\n                cx.sfx(sfx::WAVE, 0.9, 1.0);\n            }\n        }\n        let holding = i.brace();\n        let inside = cx.core.cob.length() < self.radius;\n        if inside && holding {\n            self.out = 0.0;\n        } else if self.grace <= 0.0 {\n            self.out += dt;\n        }\n        self.survived = self.t;\n        cx.scrub(\"FIT/Plank\", 0.0);\n        cx.lean_body(-68.0);\n        if self.out > p.grace {\n            if self.forgiving {\n                self.out = 0.0;\n                self.t -= 0.5;\n                cx.core.center();\n                cx.sfx(sfx::GROAN, 0.5, 1.0);\n                return false;\n            }\n            self.flop = 1.4;\n            cx.gesture(\"FIT/Flop\");\n            cx.sfx(sfx::WOOD, 1.0, 0.5);\n            let msg = cx.pick(\"kettle_flop\");\n            cx.say(msg, 3.0);\n            return false;\n        }\n        if self.t >= self.seconds {\n            return true;\n        }\n        false\n    }\n\n    pub fn bot(&self, core: &BalanceCore, _r: &Rules) -> Intent {\n        Intent { l: true, r: true, lean: pd(core, Vec2::ZERO), ..Default::default() }\n    }\n\n    pub fn hud(&self, b: &mut B, core: &BalanceCore, _r: &Rules) {\n        b.title_left(60.0, 30.0, 80.0, INK, &format!(\"{:.0} s\", self.t));\n        b.puck(PUCK_TOP, PUCK_R, core.cob.into());\n        b.puck_ring([0.0, 0.0], self.radius);\n    }\n\n    pub fn score(&self, r: &Rules) -> f32 {\n        // Stars at 25, 40 and 55 s of the minute: a piecewise line through 400, 650 and 850.\n        let s = self.survived * 60.0 / r.plank.seconds.max(1.0);\n        let pts = [(0.0, 0.0), (25.0, 400.0), (40.0, 650.0), (55.0, 850.0), (60.0, 1000.0)];\n        for w in pts.windows(2) {\n            let (a, b) = (w[0], w[1]);\n            if s <= b.0 {\n                return a.1 + (b.1 - a.1) * (s - a.0) / (b.0 - a.0);\n            }\n        }\n        1000.0\n    }\n}\nRS\ncat > $F/events/step.rs <<'RS'\n//! Step Party: notes in two lanes fall to two footprints. Timing is read from the music's clock.\n\nuse super::*;\nuse crate::games::fit::sfx;\n\n#[derive(Clone, Copy, Debug, Serialize, Deserialize)]\npub struct Note {\n    pub at: f32,\n    pub lane: u8, // 0 left, 1 right, 2 both\n    pub hit: u8,  // 0 waiting, 1 good, 2 perfect, 3 miss\n}\n\n#[derive(Debug, Deserialize)]\nstruct Chart {\n    bars: Vec<String>,\n}\n\npub fn chart_bars() -> Vec<String> {\n    let text = crate::games::level_text(\"fit/charts\", include_str!(\"../charts.toml\"));\n    toml::from_str::<Chart>(&text).map(|c| c.bars).unwrap_or_default()\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Step {\n    pub t: f32,\n    pub notes: Vec<Note>,\n    pub points: f32,\n    pub combo: u32,\n    pub perfect: u32,\n    pub good: u32,\n    pub miss: u32,\n    pub end: f32,\n    side: f32,\n    stepping: f32,\n    last: u8,\n    flash: f32,\n    flash_text: u8,\n    band: bool,\n    center: Vec3,\n    claps: u32,\n}\n\nimpl Step {\n    pub fn start(cx: &mut Cx, o: Opt) -> Self {\n        let c = o.at.unwrap_or(cx.spot(BOARDWALK, \"center\") + Vec3::Y * 0.38);\n        cx.player(c, 0.0);\n        cx.core.wobble = if o.band { cx.r.step.wobble + cx.r.finale.wobble } else { cx.r.step.wobble };\n        *cx.shot = Shot { tilt: 20.0, yaw: 0.0, distance: 9.0, fov: 36.0, height: 0.8, focus: c };\n        let bar = 240.0 / cx.r.step.bpm;\n        let eighth = bar / 8.0;\n        let all = chart_bars();\n        let n = o.count.map(|c| c as usize).unwrap_or(all.len()).min(all.len());\n        let mut notes = Vec::new();\n        // The finale plays the chart's last bars, the busiest.\n        for (b, line) in all[all.len() - n..].iter().enumerate() {\n            for (k, ch) in line.chars().enumerate() {\n                let lane = match ch {\n                    'L' => 0,\n                    'R' => 1,\n                    'B' => 2,\n                    _ => continue,\n                };\n                notes.push(Note { at: bar * (b as f32 + 1.0) + eighth * k as f32, lane, hit: 0 });\n            }\n        }\n        let end = bar * (n as f32 + 1.0) + 1.0;\n        cx.ev.push(SimEvent::Music { song: if o.band { 6 } else { 4 } });\n        Self { t: 0.0, notes, points: 0.0, combo: 0, perfect: 0, good: 0, miss: 0, end, side: 1.0, stepping: 0.0, last: 0, flash: 0.0, flash_text: 0, band: o.band, center: c, claps: 0 }\n    }\n\n    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        let dt = cx.dt;\n        self.t += dt;\n        // The music's clock leads when it is running: slew toward it, jump only if far out.\n        if let Some(p) = i.song_pos {\n            let d = p - self.t;\n            if d.abs() < 1.0 {\n                self.t += d * 0.2;\n            }\n        }\n        let s = &cx.r.step;\n        let (perfect, good) = (s.perfect, s.good);\n        let beat = 60.0 / s.bpm;\n        let beats = (self.t / beat) as u32;\n        if beats != self.claps {\n            self.claps = beats;\n            if beats % 4 == 0 && !self.band {\n                cx.sfx(sfx::CLAP, 0.25, 1.0);\n            }\n        }\n        for n in self.notes.iter_mut() {\n            if n.hit == 0 && self.t > n.at + good {\n                n.hit = 3;\n                self.miss += 1;\n                self.combo = 0;\n                self.flash = 0.5;\n                self.flash_text = 3;\n            }\n        }\n        for (pressed, lane) in [(i.l_p, 0u8), (i.r_p, 1u8)] {\n            if !pressed {\n                continue;\n            }\n            self.side = if lane == 0 { -1.0 } else { 1.0 };\n            self.stepping = 1.0;\n            self.last = lane;\n            cx.sfx(sfx::STEP, 0.7, 1.0);\n            // Doubles want both feet: the other one is checked by being held or pressed too.\n            let other = if lane == 0 { i.r } else { i.l };\n            let found = self.notes.iter().position(|n| {\n                n.hit == 0 && (n.at - self.t).abs() <= good && (n.lane == lane || (n.lane == 2 && other))\n            });\n            if let Some(k) = found {\n                let d = (self.notes[k].at - self.t).abs();\n                let p = d <= perfect;\n                self.notes[k].hit = if p { 2 } else { 1 };\n                self.points += if p { 1.0 } else { 0.6 };\n                self.combo += 1;\n                if p {\n                    self.perfect += 1;\n                } else {\n                    self.good += 1;\n                }\n                self.flash = 0.5;\n                self.flash_text = if p { 2 } else { 1 };\n                cx.sfx(if p { sfx::PERFECT } else { sfx::GOOD }, 0.6, 1.0);\n                if self.combo % 16 == 0 {\n                    cx.ev.push(SimEvent::Burst { pos: self.center + Vec3::Y * 2.0, kind: 0, count: 30 });\n                }\n            }\n        }\n        self.flash = (self.flash - dt).max(0.0);\n        self.stepping = (self.stepping - dt * 5.0).max(0.0);\n        // The step: a little hop to the side, a clip per foot.\n        let clip = if self.last == 0 { \"FIT/StepL\" } else { \"FIT/StepR\" };\n        cx.scrub(clip, 1.0 - self.stepping);\n        cx.lean_body(0.0);\n        self.t >= self.end\n    }\n\n    pub fn bot(&self, core: &BalanceCore, _r: &Rules) -> Intent {\n        let mut i = Intent { lean: pd(core, Vec2::ZERO), ..Default::default() };\n        for n in &self.notes {\n            if n.hit == 0 && (n.at - self.t).abs() < 0.012 {\n                match n.lane {\n                    0 => {\n                        i.l = true;\n                        i.l_p = true;\n                    }\n                    1 => {\n                        i.r = true;\n                        i.r_p = true;\n                    }\n                    _ => {\n                        i.l = true;\n                        i.r = true;\n                        i.l_p = true;\n                    }\n                }\n            }\n        }\n        i\n    }\n\n    pub fn hud(&self, b: &mut B, _core: &BalanceCore, r: &Rules) {\n        // Two lanes falling to two footprints, in the middle of the screen's left and right.\n        let hit_y = 900.0;\n        let lanes = [640.0, 1280.0];\n        let speed = 520.0;\n        for x in lanes {\n            b.flat([x - 80.0, 110.0, x + 80.0, 1000.0], [255, 255, 255, 110], 40.0);\n            b.circle([x, hit_y], 74.0, [0, 0, 0, 0], INK, 8.0);\n        }\n        for n in &self.notes {\n            if n.hit == 1 || n.hit == 2 {\n                continue;\n            }\n            let y = hit_y - (n.at - self.t) * speed;\n            if !(60.0..=1040.0).contains(&y) {\n                continue;\n            }\n            let fill = if n.hit == 3 { [200, 208, 215, 170] } else if n.lane == 2 { SUN } else if n.lane == 0 { TEAL } else { CORAL };\n            let mut draw = |x: f32| b.circle([x, y], 62.0, fill, WHITE, 6.0);\n            match n.lane {\n                0 => draw(lanes[0]),\n                1 => draw(lanes[1]),\n                _ => {\n                    draw(lanes[0]);\n                    draw(lanes[1]);\n                }\n            }\n        }\n        b.prompt_center(lanes[0], 980.0, &[Glyph::StepL], \"\");\n        b.prompt_center(lanes[1], 980.0, &[Glyph::StepR], \"\");\n        b.title_left(60.0, 30.0, 80.0, INK, &format!(\"{}\", self.score(r) as u32));\n        if self.combo > 3 {\n            b.title(960.0, 110.0, 72.0, TEAL, &format!(\"{} in a row\", self.combo));\n        }\n        if self.flash > 0.0 {\n            let (t, c) = match self.flash_text {\n                2 => (\"Perfect\", MINT),\n                1 => (\"Good\", TEAL),\n                _ => (\"Hm\", CORAL),\n            };\n            b.title(960.0, 220.0, 72.0, c, t);\n        }\n    }\n\n    pub fn score(&self, _r: &Rules) -> f32 {\n        1000.0 * self.points / (self.notes.len().max(1) as f32)\n    }\n}\nRS\ncat > $F/events/spin.rs <<'RS'\n//! Floatie Spin: circle the lean to keep inflatable rings up; catch new ones as guests toss them.\n\nuse super::*;\nuse crate::games::fit::sfx;\n\n#[derive(Clone, Copy, Debug, Serialize, Deserialize)]\npub struct Ring {\n    pub id: EntityId,\n    pub height: f32,\n    pub angle: f32,\n    /// 0 on the hips; 1 in flight.\n    pub flying: f32,\n    pub side: i8,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Spin {\n    pub t: f32,\n    pub rings: Vec<Ring>,\n    pub speed: f32,\n    pub dir: f32,\n    last_angle: f32,\n    switch_in: f32,\n    toss_in: f32,\n    pub sum: f32,\n    pub caught: u32,\n    center: Vec3,\n    in_band: bool,\n    pub keys: bool,\n    colors: u32,\n    bot_a: f32,\n}\n\nconst COLORS: [&str; 5] = [\"#ff786e\", \"#ffd166\", \"#46bec8\", \"#78dcaa\", \"#ff9ec4\"];\n\nimpl Spin {\n    pub fn start(cx: &mut Cx, _o: Opt) -> Self {\n        let c = cx.spot(BOARDWALK, \"center\") + Vec3::Y * 0.38 + Vec3::new(0.0, 0.0, -1.4);\n        cx.player(c, 0.0);\n        cx.core.wobble = 0.5;\n        *cx.shot = Shot { tilt: 14.0, yaw: 0.0, distance: 8.0, fov: 36.0, height: 0.9, focus: c };\n        cx.ev.push(SimEvent::Music { song: 4 });\n        cx.clip(\"FIT/HipCircle\", 1.0);\n        let mut s = Self { t: 0.0, rings: Vec::new(), speed: 0.0, dir: 1.0, last_angle: 0.0, switch_in: cx.r.spin.switch_every, toss_in: 2.0, sum: 0.0, caught: 0, center: c, in_band: false, keys: false, colors: 0, bot_a: 0.0 };\n        for _ in 0..2 {\n            s.add(cx, 0.0, 0);\n        }\n        s\n    }\n\n    fn add(&mut self, cx: &mut Cx, flying: f32, side: i8) {\n        let color = COLORS[self.colors as usize % COLORS.len()];\n        self.colors += 1;\n        let at = self.center + Vec3::Y * 0.9;\n        let id = cx.prop_color(\"fit_ring\", at, 0.0, 0.9, color);\n        self.rings.push(Ring { id, height: 0.95, angle: self.rings.len() as f32, flying, side });\n    }\n\n    fn band(&self, r: &Rules) -> (f32, f32) {\n        let k = if self.keys { r.spin.band_scale_keys } else { 1.0 };\n        (r.spin.band_low * k, r.spin.band_high * k)\n    }\n\n    pub fn tick(&mut self, cx: &mut Cx, i: &Intent) -> bool {\n        let dt = cx.dt;\n        self.t += dt;\n        self.keys = i.keys;\n        let s = cx.r.spin.clone();\n        // Spin speed: the smoothed angular velocity of the lean, while it is leaned far enough.\n        let mut w = 0.0;\n        if i.lean.length() > 0.4 {\n            let a = i.lean.y.atan2(i.lean.x);\n            w = wrap_pi(a - self.last_angle) / dt;\n            self.last_angle = a;\n        }\n        self.speed += (w - self.speed) * (1.0 - (-6.0 * dt).exp());\n        self.switch_in -= dt;\n        if self.switch_in <= 0.0 {\n            self.switch_in = s.switch_every;\n            self.dir = -self.dir;\n            cx.say(\"Switch!\", 2.0);\n            cx.sfx(sfx::BELL, 0.7, 1.4);\n        }\n        let (lo, hi) = self.band(cx.r);\n        let v = self.speed * self.dir;\n        self.in_band = v >= lo && v <= hi;\n        // Guests toss rings from a side; press that side's step as it arrives.\n        self.toss_in -= dt;\n        if self.toss_in <= 0.0 && self.rings.len() < 7 {\n            self.toss_in = s.toss_every;\n            let side = if cx.rng().f32() < 0.5 { -1 } else { 1 };\n            self.add(cx, 1.0, side);\n            cx.sfx(sfx::WHOOSH, 0.6, 1.0);\n        }\n        let flight = 1.1;\n        let mut lost = Vec::new();\n        let mut caught_now = 0;\n        for (k, r) in self.rings.iter_mut().enumerate() {\n            if r.flying > 0.0 {\n                let left = r.flying * flight;\n                let pressed = if r.side < 0 { i.l_p } else { i.r_p };\n                if pressed && left <= s.catch_window {\n                    r.flying = 0.0;\n                    r.height = 0.95;\n                    r.side = 0;\n                    caught_now += 1;\n                    continue;\n                }\n                r.flying -= dt / flight;\n                if r.flying <= -s.catch_window / flight {\n                    lost.push(k);\n                }\n                continue;\n            }\n            let rate = if self.in_band { s.rise } else { -s.sink };\n            r.height = (r.height + rate * dt).clamp(0.0, 1.0);\n            if r.height <= 0.0 {\n                lost.push(k);\n            }\n            r.angle += self.speed * dt;\n        }\n        for _ in 0..caught_now {\n            self.caught += 1;\n            cx.sfx(sfx::POP, 0.7, 1.2);\n        }\n        for k in lost.into_iter().rev() {\n            let r = self.rings.remove(k);\n            cx.sim.despawn(r.id);\n            cx.sfx(sfx::SQUEAK, 0.6, 0.7);\n        }\n        if self.in_band {\n            let on = self.rings.iter().filter(|r| r.flying <= 0.0).count() as f32;\n            self.sum += on * dt;\n        }\n        // Draw.\n        let n = self.rings.len().max(1) as f32;\n        let phase = self.t * self.speed.clamp(-12.0, 12.0);\n        for (k, r) in self.rings.iter().enumerate() {\n            let pos = if r.flying > 0.0 {\n                let u = r.flying.clamp(0.0, 1.0);\n                self.center + Vec3::new(r.side as f32 * 9.0 * u, 0.9 + 3.0 * (u * PI).sin(), 0.0)\n            } else {\n                let wob = 0.12 + 0.05 * (k as f32 / n);\n                let a = phase + k as f32 * 1.7;\n                self.center + Vec3::new(a.cos() * wob, 0.05 + r.height * 0.85 + k as f32 * 0.06, a.sin() * wob)\n            };\n            let tilt = Quat::from_rotation_x(0.2 * (phase + k as f32).sin()) * Quat::from_rotation_z(0.2 * (phase + k as f32).cos());\n            cx.place(r.id, pos, tilt);\n        }\n        cx.lean_body(0.0);\n        self.t >= s.seconds\n    }\n\n    pub fn bot(&self, _core: &BalanceCore, r: &Rules) -> Intent {\n        let mut i = Intent::default();\n        // A steady circle at 7.5 rad/s the way the call asks.\n        let a = self.t * 7.5 * self.dir;\n        i.lean = Vec2::new(a.cos(), a.sin()) * 0.8;\n        for ring in &self.rings {\n            if ring.flying > 0.0 && ring.flying * 1.1 <= r.spin.catch_window * 0.6 {\n                if ring.side < 0 {\n                    i.l_p = true;\n                    i.l = true;\n                } else {\n                    i.r_p = true;\n                    i.r = true;\n                }\n            }\n        }\n        i\n    }\n\n    pub fn hud(&self, b: &mut B, core: &BalanceCore, r: &Rules) {\n        timer(b, r.spin.seconds - self.t);\n        b.puck(PUCK_TOP, PUCK_R, core.cob.into());\n        b.puck_stars(self.rings.len().min(7) as u8);\n        let (lo, hi) = self.band(r);\n        // The speed gauge: a bar with the sweet band marked.\n        let v = (self.speed * self.dir) / (hi * 1.4);\n        b.flat([560.0, 980.0, 1360.0, 1030.0], PALE, 24.0);\n        let (bl, bh) = (560.0 + 800.0 * lo / (hi * 1.4), 560.0 + 800.0 * hi / (hi * 1.4));\n        b.flat([bl, 980.0, bh, 1030.0], MINT, 24.0);\n        b.circle([560.0 + 800.0 * v.clamp(0.0, 1.0), 1005.0], 36.0, if self.in_band { CORAL } else { INK }, WHITE, 5.0);\n        let arrow = if self.dir > 0.0 { \"Circle this way: anticlockwise\" } else { \"Circle this way: clockwise\" };\n        b.center(960.0, 900.0, 44.0, INK, arrow);\n        for ring in &self.rings {\n            if ring.flying > 0.0 && ring.flying * 1.1 <= 0.6 {\n                let g = if ring.side < 0 { Glyph::StepL } else { Glyph::StepR };\n                b.prompt_center(if ring.side < 0 { 420.0 } else { 1500.0 }, 500.0, &[g], \"Catch\");\n            }\n        }\n    }\n\n    pub fn score(&self, r: &Rules) -> f32 {\n        1000.0 * self.sum / (r.spin.seconds * 5.2)\n    }\n}\nRS\ncat > $F/events/stillness.rs <<'RS'\n//! The Long Stillness: thirty seconds of nothing, while the game tries to make you press something.\n\nuse super::*;\nuse crate::games::fit::sfx;\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Stillness {\n    pub t: f32,\n    pub broke: bool,\n    pub fake: bool,\n    faded: bool,\n    pub seconds: f32,\n    pub spoken: bool,\n}\n\nimpl Stillness {\n    pub fn new(seconds: f32) -> Self {\n        Self { t: 0.0, broke: false, fake: false, faded: false, seconds, spoken: false }\n    }\n\n    /// Returns true when it is over. `any` is any button at all.\n    pub fn tick(&mut self, cx: &mut Cx, any: bool) -> bool {\n        self.t += cx.dt;\n        if !self.faded {\n            self.faded = true;\n            cx.ev.push(SimEvent::Music { song: 255 });\n        }\n        self.fake = self.t >= self.seconds * 0.5 && self.t < self.seconds * 0.5 + 8.0;\n        if any && !self.broke {\n            self.broke = true;\n            cx.sfx(sfx::SQUEAK, 0.5, 0.6);\n        }\n        cx.core.wobble = 0.6;\n        cx.scrub(\"FIT/Breath\", 0.5 + 0.1 * (self.t * 0.7).sin());\n        cx.lean_body(0.0);\n        self.t >= self.seconds\n    }\n\n    pub fn hud(&self, b: &mut B, core: &BalanceCore) {\n        b.puck([960.0, 200.0], PUCK_R, core.cob.into());\n        if self.fake {\n            b.card([560.0, 780.0, 1360.0, 900.0], DECK);\n            b.prompt_center(960.0, 810.0, &[Glyph::Confirm], \"Press to skip\");\n        }\n    }\n}\nRS\n","description":"Write event framework and the stillness, strength and cardio events"}}}
