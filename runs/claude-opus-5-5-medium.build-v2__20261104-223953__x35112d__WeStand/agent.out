160,sun=0.62,amb=1.15,sea=\"#8fdde0\",extra=\"\",fog=(25,110),sat=.95,bloom=.15,cx=30,cz=30):''','''def view(sky=\"#d6eef6\",el=52,az=160,sun=0.62,amb=1.15,sea=\"#8fdde0\",extra=\"\",fog=(25,110),sat=.95,bloom=.15,cx=30,cz=30,sea_y=-0.2):''')\ns=s.replace('''    t+=view(cx=40,cz=30)\n''','''    t+=view(cx=40,cz=30,sea_y=-0.13)\n''')\n# channel: segments that do not merge, so only the nearby ones ripple\ns=s.replace('''    write(\"channel\",sea_set(\"Paddle Channel\",\"A long channel between palm banks.\",40,300,dict(start=(20,0,10)),view(el=48,az=200,sun=.62,amb=1.15,cx=20,cz=150,fog=(40,170)),b))''','''    rows=[(\"~\" if (r//50)%2==0 else \"^\")*40 for r in range(300)]\n    sea=\"#8fdde0\"\n    t=head(\"Paddle Channel\",\"A long channel between palm banks.\",40,300,spots(start=(20,0,10)))+layout(rows)+legend(sea,f\\'\\'\\'\n[layout.legend.'^']\nblocks = [{{ y0 = -2.5, y1 = -0.059, color = \"{sea}\", look = \"flat\" }}]\nzone = {{ kind = \"water\", y0 = -2.0, y1 = 0.001, color = \"{sea}\" }}\n\\'\\'\\')+view(el=48,az=200,sun=.62,amb=1.15,cx=20,cz=150,fog=(40,170))+b\n    write(\"channel\",t)''')\nopen(p,'w').write(s)\np='engine/crates/pav_core/src/games/fit/mod.rs'\ns=open(p).read()\ns=s.replace('''            stage: {\n                let x = self.set_now as f32 * SET_GAP;\n                Some((Vec3::new(x - 180.0, -60.0, -180.0), Vec3::new(x + 200.0, 200.0, 520.0)))\n            },''','''            stage: {\n                let x = self.set_now as f32 * SET_GAP;\n                // The long channel draws (and ripples) only around the board.\n                let (z0, z1) = match (self.set_now, sim.state.player.and_then(|p| sim.feet(p))) {\n                    (CHANNEL, Some(f)) => (f.z - 50.0, f.z + 70.0),\n                    _ => (-180.0, 520.0),\n                };\n                Some((Vec3::new(x - 180.0, -60.0, z0), Vec3::new(x + 200.0, 200.0, z1)))\n            },''')\nopen(p,'w').write(s)\nPY\npython3 tools/gen_sets.py; grep -n \"chunk_of\\|CHUNK\" engi