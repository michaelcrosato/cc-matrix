           self.audio_settings.sfx = 1.0;\n            #[cfg(target_arch = \"wasm32\")]\n            {\n                self.fit.touch_only = crate::fit_link::web::touch_only();\n            }\n        }\n        self.host = Some(SimHost::start(sim));\n        self.gfx = Some(gfx);''')\n# devices block\nsub(A,'''        self.input.poll_gamepad();\n        if self.input.pad.start_pressed {\n            let open = !self.menu_open;\n            self.set_menu(open);\n        }\n        if self.input.pad.map_pressed {\n            self.game_ui.map = !self.game_ui.map;\n        }\n        self.pad_menus(dt);\n''','''        self.input.poll_gamepad();\n        #[cfg(target_arch = \"wasm32\")]\n        if self.input.pad.any_activity {\n            // A pad press counts as the gesture audio is waiting for, where the browser agrees.\n            self.resume_audio();\n        }\n        if !self.fit.active {\n            if self.input.pad.start_pressed {\n                let open = !self.menu_open;\n                self.set_menu(open);\n            }\n            if self.input.pad.map_pressed {\n                self.game_ui.map = !self.game_ui.map;\n            }\n            self.pad_menus(dt);\n        }\n''')\nsub(A,'''                self.input.bindings = b;\n                for e in errs {\n                    log::warn!(\"room keys: {e}\");\n                }\n            }''','''                self.input.bindings = b;\n                for e in errs {\n                    log::warn!(\"room keys: {e}\");\n                }\n                if self.fit.active {\n                    self.input.bindings = crate::input::Bindings::fit();\n                }\n            }''')\nsub(A,'''        let alpha = if self.app_settings.smoothing && !snap_camera {''','''        // A game that drives the camera itself, every tick.\n        if let Some(c) = curr.hud.camera {\n            let p = &mut self.rig.params;\n            p.tilt = c.tilt;\n            p.yaw = c.yaw;\n            p.