{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjFzs1myiH3FFm6H65W1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012YjyjEwNwazWjiSLAV6LR4","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953\nF=engine/crates/pav_core/src/games/fit\npython3 - <<'PY'\np='engine/crates/pav_core/src/games/fit/charts.toml'\ns=open(p).read()\ns=s[:s.index('bars = [')]+'''bars = [\n \"L...R...\", \"L...R...\", \"L...R...\", \"L...R...\",\n \"L.R.L.R.\", \"L.R.L...\", \"L.R.L.R.\", \"L.R.B...\",\n \"L.R.L.R.\", \"R.L.R.L.\", \"L.R.L.R.\", \"L...B...\",\n \"R.L.R.L.\", \"R.L.R...\", \"L.RLR.L.\", \"L.R.B...\",\n \"L.R.L.R.\", \"LR..LR..\", \"L.R.B.B.\", \"L.RL.RL.\",\n \"B.L.R.L.\", \"B.R.L.R.\", \"LRLR.LR.\", \"B.B.B...\",\n]\n'''\nopen(p,'w').write(s)\nPY\ngrep -o '\"[LRB.]\\{8\\}\"' $F/charts.toml | tr -d '\".\\n' | wc -c\ncat > $F/meta.rs <<'RS'\n//! What is kept between sessions, and the sums over it: guests, settings, Balance Age, stars.\n\nuse std::collections::{BTreeMap, BTreeSet};\n\nuse serde::{Deserialize, Serialize};\n\nuse super::ghost::Sample;\n\npub const SAVE_VERSION: u32 = 1;\npub const STAR_AT: [u32; 3] = [400, 650, 850];\npub const SLOTS: usize = 4;\npub const CHECKOUT_AGE: i32 = 40;\n\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct Settings {\n    pub music: f32,\n    pub sfx: f32,\n    pub voice: f32,\n    pub xbox: bool,\n    pub lean_sensitivity: f32,\n    pub wobble_assist: f32,\n    pub rhythm_offset: f32,\n    pub text_speed: f32,\n}\n\nimpl Default for Settings {\n    fn default() -> Self {\n        Self { music: 0.10, sfx: 0.8, voice: 0.8, xbox: false, lean_sensitivity: 1.0, wobble_assist: 0.0, rhythm_offset: 0.10, text_speed: 1.0 }\n    }\n}\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct Best {\n    pub score: u32,\n    pub stars: u8,\n}\n\n/// What a guest has on: picked in the Wardrobe from what the Clam has unlocked.\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct Wear {\n    pub hat: u8,\n    pub extra: u8,\n    pub gold_shoes: bool,\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct Guest {\n    pub name: String,\n    pub skin: u8,\n    pub outfit: u8,\n    /// 1..=5, the day of the stay.\n    pub day: u8,\n    /// Banked today, and ever.\n    pub minutes: u32,\n    pub total_minutes: u32,\n    pub bests: BTreeMap<String, Best>,\n    pub ghosts: BTreeMap<String, Vec<Sample>>,\n    pub ages: Vec<i32>,\n    pub stamps: u8,\n    pub flops: [bool; 5],\n    pub wear: Wear,\n    pub free_play: bool,\n    pub checked_out: bool,\n    /// The day number (days since 1970) last played, for absence comments.\n    pub last_day: i64,\n    pub real_stamps: u32,\n    /// Events cleared today (the first clear of each banks more).\n    pub done_today: BTreeSet<String>,\n    pub checked_today: bool,\n    pub goal_told: bool,\n    pub tom_rewarded: bool,\n    pub wobbles: u32,\n    pub best_final: u32,\n}\n\nimpl Guest {\n    pub fn new(name: &str, skin: u8, outfit: u8) -> Self {\n        Self { name: name.to_string(), skin, outfit, day: 1, ..Default::default() }\n    }\n\n    pub fn total_stars(&self) -> u32 {\n        self.bests.values().map(|b| b.stars as u32).sum()\n    }\n\n    pub fn age(&self) -> Option<i32> {\n        self.ages.last().copied()\n    }\n}\n\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct Save {\n    pub version: u32,\n    pub guests: [Option<Guest>; SLOTS],\n    pub settings: Settings,\n}\n\nimpl Default for Save {\n    fn default() -> Self {\n        Self { version: SAVE_VERSION, guests: Default::default(), settings: Settings::default() }\n    }\n}\n\nimpl Save {\n    /// Reads a stored save. Another version's or a broken one starts afresh, keeping nothing.\n    pub fn parse(text: &str) -> Self {\n        match serde_json::from_str::<Save>(text) {\n            Ok(s) if s.version == SAVE_VERSION => s,\n            _ => Save::default(),\n        }\n    }\n}\n\npub fn stars_for(score: u32) -> u8 {\n    STAR_AT.iter().filter(|s| score >= **s).count() as u8\n}\n\n/// The Morning Check's sum. `skill` is 0..1.\npub fn balance_age(skill: f32, days_completed: u32, total_stars: u32) -> i32 {\n    let raw = 24.0 + 56.0 * (1.0 - skill.clamp(0.0, 1.0)).powf(1.1) - 2.0 * days_completed as f32 - (total_stars as f32 / 3.0).min(8.0);\n    raw.round().clamp(18.0, 99.0) as i32\n}\n\n/// The six skin tones.\npub const SKINS: [&str; 6] = [\"#f6d7bd\", \"#eec09a\", \"#d39a70\", \"#a86f50\", \"#7a4e36\", \"#54352a\"];\n/// The eight outfits: name, shirt, shorts, shoes.\npub const OUTFITS: [(&str, &str, &str, &str); 8] = [\n    (\"Regulation Teal\", \"#46bec8\", \"#fbfaf6\", \"#fbfaf6\"),\n    (\"Polite Coral\", \"#ff786e\", \"#fbfaf6\", \"#fbfaf6\"),\n    (\"Mint Compliance\", \"#78dcaa\", \"#263e54\", \"#fbfaf6\"),\n    (\"Sunny Disposition\", \"#ffd166\", \"#46bec8\", \"#fbfaf6\"),\n    (\"Lobby Lilac\", \"#c7b1ec\", \"#fbfaf6\", \"#263e54\"),\n    (\"Towel White\", \"#fdfcf8\", \"#fdfcf8\", \"#e8e2d4\"),\n    (\"Evening Ink\", \"#263e54\", \"#46bec8\", \"#fbfaf6\"),\n    (\"Flamingo Adjacent\", \"#ff9ec4\", \"#fbfaf6\", \"#ff9ec4\"),\n];\n\n/// Wardrobe items and the total minutes that unlock them: (name, minutes).\npub const HATS: [(&str, u32); 5] = [(\"No Hat\", 0), (\"Sun Cap\", 3), (\"Towel Turban\", 8), (\"Modest Crown\", 20), (\"Unearned Halo\", 34)];\npub const EXTRAS: [(&str, u32); 4] = [(\"Nothing Extra\", 0), (\"Sweatbands\", 5), (\"Very Serious Belt\", 12), (\"Arm Floaties\", 26)];\n\n/// The puppet for a guest's look.\npub fn guest_def(skin: u8, outfit: u8, wear: &Wear) -> crate::puppet::PuppetDef {\n    use crate::puppet::{HelmKind, PuppetDef};\n    let (_, shirt, pants, shoes) = OUTFITS[outfit as usize % OUTFITS.len()];\n    let mut d = PuppetDef { skin: SKINS[skin as usize % SKINS.len()].into(), shirt: shirt.into(), pants: pants.into(), shoes: shoes.into(), ..Default::default() };\n    if wear.gold_shoes {\n        d.shoes = \"#ffcf4d\".into();\n    }\n    match wear.hat {\n        1 => {\n            d.gear.helm = HelmKind::Cap;\n            d.gear.helm_color = \"#ff786e\".into();\n        }\n        2 => {\n            d.gear.helm = HelmKind::Hood;\n            d.gear.helm_color = \"#f5f2ec\".into();\n        }\n        3 => {\n            d.gear.helm = HelmKind::Crown;\n            d.gear.helm_color = \"#ffd166\".into();\n        }\n        4 => {\n            d.gear.helm = HelmKind::Halo;\n            d.gear.helm_color = \"#ffe9a8\".into();\n            d.gear.glow = 0.6;\n        }\n        _ => {}\n    }\n    match wear.extra {\n        1 => d.gear.gloves = \"#ffffff\".into(),\n        2 => d.gear.belt = \"#263e54\".into(),\n        3 => {\n            d.gear.pauldrons = 1.0;\n            d.gear.armor_color = \"#ffd166\".into();\n        }\n        _ => {}\n    }\n    d\n}\nRS\ncat > $F/script.rs <<'RS'\n//! All the words, from `script.toml`.\n\nuse std::collections::BTreeMap;\nuse std::sync::OnceLock;\n\nuse serde::Deserialize;\n\n#[derive(Debug, Default, Deserialize)]\npub struct Script {\n    pub lines: BTreeMap<String, Vec<String>>,\n    pub names: Vec<String>,\n    pub titles: Vec<String>,\n}\n\nstatic SCRIPT: OnceLock<Script> = OnceLock::new();\n\npub fn script() -> &'static Script {\n    SCRIPT.get_or_init(|| {\n        let text = super::super::level_text(\"fit/script\", include_str!(\"script.toml\"));\n        toml::from_str(&text).unwrap_or_else(|e| panic!(\"fit/script.toml: {e}\"))\n    })\n}\n\n/// Lines under `key` (none: empty).\npub fn lines(key: &str) -> &'static [String] {\n    script().lines.get(key).map(|v| v.as_slice()).unwrap_or(&[])\n}\n\n/// A line under `key`, chosen by `pick`.\npub fn line(key: &str, pick: u32) -> String {\n    let l = lines(key);\n    if l.is_empty() { String::new() } else { l[pick as usize % l.len()].clone() }\n}\n\n/// The deadpan title for a score: the list runs from worst to best.\npub fn title(score: u32) -> String {\n    let t = &script().titles;\n    if t.is_empty() {\n        return String::new();\n    }\n    t[((score as usize).min(1000) * (t.len() - 1)) / 1000].clone()\n}\n\n/// Who speaks: name, base pitch.\npub const SPEAKERS: [&str; 10] = [\"Pip\", \"Posey\", \"Big Kettle\", \"Bounce\", \"Commodore Gull\", \"Marjorie\", \"Two-Towel Tom\", \"The Twins\", \"A Guest\", \"\"];\npub const PIP: u8 = 0;\npub const POSEY: u8 = 1;\npub const KETTLE: u8 = 2;\npub const BOUNCE: u8 = 3;\npub const GULL: u8 = 4;\npub const MARJORIE: u8 = 5;\npub const TOM: u8 = 6;\npub const TWINS: u8 = 7;\npub const GUEST: u8 = 8;\nRS\ncat > $F/dialog.rs <<'RS'\n//! Lines that type out with voice blips. Action completes the line, then advances.\n\nuse std::collections::VecDeque;\n\nuse serde::{Deserialize, Serialize};\n\nuse super::ui_model::*;\nuse crate::frame::SimEvent;\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Line {\n    pub who: u8,\n    pub text: String,\n}\n\n/// What happens when the lines run out.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum After {\n    #[default]\n    Nothing,\n    StartCheck,\n    IslandDay,\n    EndDay,\n    FinaleCheck,\n    Ending,\n    Credits,\n    GotoCheck,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Dialog {\n    pub lines: VecDeque<Line>,\n    /// Letters shown of the first line.\n    pub shown: f32,\n    pub after: After,\n    last_voice: usize,\n}\n\nimpl Dialog {\n    pub fn new(after: After) -> Self {\n        Self { after, ..Default::default() }\n    }\n\n    pub fn push(&mut self, who: u8, text: impl Into<String>) {\n        let text = text.into();\n        if !text.is_empty() {\n            self.lines.push_back(Line { who, text });\n        }\n    }\n\n    pub fn finished_line(&self) -> bool {\n        self.lines.front().is_none_or(|l| self.shown as usize >= l.text.chars().count())\n    }\n\n    /// Returns true when the dialog has run out of lines.\n    pub fn tick(&mut self, confirm: bool, speed: f32, dt: f32, ev: &mut Vec<SimEvent>) -> bool {\n        let Some(line) = self.lines.front() else { return true };\n        let n = line.text.chars().count();\n        let was_done = self.shown as usize >= n;\n        if confirm {\n            if was_done {\n                self.lines.pop_front();\n                self.shown = 0.0;\n                self.last_voice = 0;\n                ev.push(SimEvent::Sfx { id: super::sfx::MOVE, gain: 0.4, pitch: 1.2 });\n                return self.lines.is_empty();\n            }\n            self.shown = n as f32;\n            return false;\n        }\n        self.shown = (self.shown + 42.0 * speed * dt).min(n as f32);\n        // A syllable per few letters: vowel from the letter, pitch falling at \".\" and rising at \"?\".\n        let (rate, who) = (voice_rate(line.who), line.who);\n        let at = self.shown as usize;\n        while self.last_voice + rate <= at {\n            self.last_voice += rate;\n            let c = line.text.chars().nth(self.last_voice).unwrap_or(' ');\n            let end = line.text.chars().skip(self.last_voice).take(4).find(|x| matches!(x, '.' | '?' | '!'));\n            let pitch = match end {\n                Some('.') => 0.86,\n                Some('?') => 1.22,\n                Some('!') => 1.1,\n                _ => 0.96 + (c as u32 % 5) as f32 * 0.03,\n            };\n            if c.is_alphanumeric() {\n                let vowel = match c.to_ascii_lowercase() {\n                    'a' | 'h' | 'k' | 'q' | 'r' => 0,\n                    'e' | 'b' | 'c' | 'd' | 'p' | 't' => 1,\n                    'i' | 'g' | 'j' | 'l' | 'y' | 's' => 2,\n                    'o' | 'f' | 'm' | 'n' | 'x' => 3,\n                    _ => 4,\n                };\n                ev.push(SimEvent::Syllable { speaker: who, vowel, pitch });\n            }\n        }\n        false\n    }\n\n    pub fn draw(&self, b: &mut B) {\n        let Some(line) = self.lines.front() else { return };\n        b.card([240.0, 760.0, 1680.0, 1040.0], DECK);\n        let who = super::script::SPEAKERS.get(line.who as usize).copied().unwrap_or(\"\");\n        if !who.is_empty() {\n            b.flat([280.0, 730.0, 280.0 + 40.0 + who.len() as f32 * 26.0, 800.0], TEAL, 26.0);\n            b.text(300.0, 742.0, 40.0, WHITE, who);\n        }\n        let shown: String = line.text.chars().take(self.shown as usize).collect();\n        b.wrap(300.0, 826.0, 1320.0, 46.0, INK, &shown);\n        if self.finished_line() {\n            b.prompt_right(1640.0, 978.0, &[Glyph::Confirm], \"\");\n        }\n    }\n}\n\nfn voice_rate(who: u8) -> usize {\n    match who {\n        super::script::BOUNCE | super::script::GULL => 2,\n        super::script::KETTLE => 4,\n        _ => 3,\n    }\n}\nRS\ncat > $F/ghost.rs <<'RS'\n//! Ghosts: a run recorded a few times a second, replayed as a tinted figure. Three sources share\n//! this drawing: Yesterday You, Play Together, and other players in a hub session.\n\nuse std::sync::Arc;\n\nuse glam::{Quat, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse crate::color::Color;\nuse crate::entity::EntityId;\nuse crate::frame::{PuppetFrame, RenderObject};\nuse crate::puppet::{PuppetDef, PuppetState};\nuse crate::shape::{Shape, Visual};\n\n/// A moment of a run: position, facing, tilt, clip.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct Sample {\n    pub t: f32,\n    pub p: [f32; 3],\n    pub f: f32,\n    pub ts: f32,\n    pub tf: f32,\n    pub c: u32,\n    pub ct: f32,\n    #[serde(default)]\n    pub s: f32,\n}\n\n/// Samples per second recorded.\npub const RATE: f32 = 6.0;\n\n/// A sample at time `t`, between the two recorded around it.\npub fn at(samples: &[Sample], t: f32) -> Option<Sample> {\n    let first = samples.first()?;\n    if t <= first.t {\n        return Some(*first);\n    }\n    let i = samples.partition_point(|s| s.t <= t);\n    let Some(b) = samples.get(i) else { return samples.last().copied() };\n    let a = samples[i - 1];\n    let u = ((t - a.t) / (b.t - a.t).max(1e-4)).clamp(0.0, 1.0);\n    let l = |x: f32, y: f32| x + (y - x) * u;\n    Some(Sample {\n        t,\n        p: [l(a.p[0], b.p[0]), l(a.p[1], b.p[1]), l(a.p[2], b.p[2])],\n        f: l(a.f, b.f),\n        ts: l(a.ts, b.ts),\n        tf: l(a.tf, b.tf),\n        c: b.c,\n        ct: if a.c == b.c { l(a.ct, b.ct) } else { b.ct },\n        s: l(a.s, b.s),\n    })\n}\n\n/// The first id of the figures that are not entities.\npub const FIRST_ID: u32 = 3_000_000;\n\n/// A tinted figure at a sample, shifted by `offset`.\npub fn object(id: u32, s: &Sample, offset: Vec3, def: Arc<PuppetDef>, rgb: [f32; 3], strength: f32) -> RenderObject {\n    let mut state = PuppetState { facing: s.f, tilt_side: s.ts, tilt_fwd: s.tf, clip: s.c, clip_t: s.ct, clip_w: if s.c != 0 { 1.0 } else { 0.0 }, clip_speed: 1e-6, ..Default::default() };\n    state.time = s.t;\n    let feet_offset = 0.9 * def.scale;\n    RenderObject {\n        id: EntityId(FIRST_ID + id),\n        pos: Vec3::from(s.p) + offset + Vec3::Y * feet_offset,\n        rot: Quat::IDENTITY,\n        visual: Visual::new(Shape::Sphere { radius: 0.0 }, Color::WHITE),\n        prop: None,\n        puppet: Some(PuppetFrame { state, feet_offset, def: Some(def), rig: None, tint: Some((rgb, strength)) }),\n        pulse: -1.0,\n        soft: None,\n        vehicle: None,\n        cone: None,\n        scenery: false,\n    }\n}\n\n/// Seat colours, for hub and hot-seat ghosts.\npub const SEATS: [[f32; 3]; 4] = [[0.27, 0.75, 0.78], [1.0, 0.47, 0.43], [1.0, 0.82, 0.4], [0.47, 0.86, 0.67]];\nRS\ngrep -n \"pub struct EntityId\" -B2 -A2 engine/crates/pav_core/src/entity.rs; cat engine/crates/pav_core/src/rng.rs | grep -n \"pub fn\"; grep -n \"height()\\|fn height\" engine/crates/pav_core/src/character.rs | head -5; grep -n \"half_height\" engine/crates/pav_core/src/character.rs | head -6;grep -n \"pub mod\\|pub use\" engine/crates/pav_core/src/lib.rs | head -60 | grep -i \"rng\\|games\\|nav\\|prop\"","description":"Write save/meta, script loader, dialog and ghost modules"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10878,"cache_read_input_tokens":294622,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10878},"output_tokens":10,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cb437ba7-0477-4143-bb04-ff33f49efd62","uuid":"2c22b26e-df81-4b9e-84ca-0759519b1577","timestamp":"2026-11-05T05:53:45.625Z","request_id":"req_011CgjFzrWHB91huFbsCQc3V","wire_tool_inputs":{"toolu_012YjyjEwNwazWjiSLAV6LR4":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953\nF=engine/crates/pav_core/src/games/fit\npython3 - <<'PY'\np='engine/crates/pav_core/src/games/fit/charts.toml'\ns=open(p).read()\ns=s[:s.index('bars = [')]+'''bars = [\n \"L...R...\", \"L...R...\", \"L...R...\", \"L...R...\",\n \"L.R.L.R.\", \"L.R.L...\", \"L.R.L.R.\", \"L.R.B...\",\n \"L.R.L.R.\", \"R.L.R.L.\", \"L.R.L.R.\", \"L...B...\",\n \"R.L.R.L.\", \"R.L.R...\", \"L.RLR.L.\", \"L.R.B...\",\n \"L.R.L.R.\", \"LR..LR..\", \"L.R.B.B.\", \"L.RL.RL.\",\n \"B.L.R.L.\", \"B.R.L.R.\", \"LRLR.LR.\", \"B.B.B...\",\n]\n'''\nopen(p,'w').write(s)\nPY\ngrep -o '\"[LRB.]\\{8\\}\"' $F/charts.toml | tr -d '\".\\n' | wc -c\ncat > $F/meta.rs <<'RS'\n//! What is kept between sessions, and the sums over it: guests, settings, Balance Age, stars.\n\nuse std::collections::{BTreeMap, BTreeSet};\n\nuse serde::{Deserialize, Serialize};\n\nuse super::ghost::Sample;\n\npub const SAVE_VERSION: u32 = 1;\npub const STAR_AT: [u32; 3] = [400, 650, 850];\npub const SLOTS: usize = 4;\npub const CHECKOUT_AGE: i32 = 40;\n\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct Settings {\n    pub music: f32,\n    pub sfx: f32,\n    pub voice: f32,\n    pub xbox: bool,\n    pub lean_sensitivity: f32,\n    pub wobble_assist: f32,\n    pub rhythm_offset: f32,\n    pub text_speed: f32,\n}\n\nimpl Default for Settings {\n    fn default() -> Self {\n        Self { music: 0.10, sfx: 0.8, voice: 0.8, xbox: false, lean_sensitivity: 1.0, wobble_assist: 0.0, rhythm_offset: 0.10, text_speed: 1.0 }\n    }\n}\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct Best {\n    pub score: u32,\n    pub stars: u8,\n}\n\n/// What a guest has on: picked in the Wardrobe from what the Clam has unlocked.\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct Wear {\n    pub hat: u8,\n    pub extra: u8,\n    pub gold_shoes: bool,\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct Guest {\n    pub name: String,\n    pub skin: u8,\n    pub outfit: u8,\n    /// 1..=5, the day of the stay.\n    pub day: u8,\n    /// Banked today, and ever.\n    pub minutes: u32,\n    pub total_minutes: u32,\n    pub bests: BTreeMap<String, Best>,\n    pub ghosts: BTreeMap<String, Vec<Sample>>,\n    pub ages: Vec<i32>,\n    pub stamps: u8,\n    pub flops: [bool; 5],\n    pub wear: Wear,\n    pub free_play: bool,\n    pub checked_out: bool,\n    /// The day number (days since 1970) last played, for absence comments.\n    pub last_day: i64,\n    pub real_stamps: u32,\n    /// Events cleared today (the first clear of each banks more).\n    pub done_today: BTreeSet<String>,\n    pub checked_today: bool,\n    pub goal_told: bool,\n    pub tom_rewarded: bool,\n    pub wobbles: u32,\n    pub best_final: u32,\n}\n\nimpl Guest {\n    pub fn new(name: &str, skin: u8, outfit: u8) -> Self {\n        Self { name: name.to_string(), skin, outfit, day: 1, ..Default::default() }\n    }\n\n    pub fn total_stars(&self) -> u32 {\n        self.bests.values().map(|b| b.stars as u32).sum()\n    }\n\n    pub fn age(&self) -> Option<i32> {\n        self.ages.last().copied()\n    }\n}\n\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct Save {\n    pub version: u32,\n    pub guests: [Option<Guest>; SLOTS],\n    pub settings: Settings,\n}\n\nimpl Default for Save {\n    fn default() -> Self {\n        Self { version: SAVE_VERSION, guests: Default::default(), settings: Settings::default() }\n    }\n}\n\nimpl Save {\n    /// Reads a stored save. Another version's or a broken one starts afresh, keeping nothing.\n    pub fn parse(text: &str) -> Self {\n        match serde_json::from_str::<Save>(text) {\n            Ok(s) if s.version == SAVE_VERSION => s,\n            _ => Save::default(),\n        }\n    }\n}\n\npub fn stars_for(score: u32) -> u8 {\n    STAR_AT.iter().filter(|s| score >= **s).count() as u8\n}\n\n/// The Morning Check's sum. `skill` is 0..1.\npub fn balance_age(skill: f32, days_completed: u32, total_stars: u32) -> i32 {\n    let raw = 24.0 + 56.0 * (1.0 - skill.clamp(0.0, 1.0)).powf(1.1) - 2.0 * days_completed as f32 - (total_stars as f32 / 3.0).min(8.0);\n    raw.round().clamp(18.0, 99.0) as i32\n}\n\n/// The six skin tones.\npub const SKINS: [&str; 6] = [\"#f6d7bd\", \"#eec09a\", \"#d39a70\", \"#a86f50\", \"#7a4e36\", \"#54352a\"];\n/// The eight outfits: name, shirt, shorts, shoes.\npub const OUTFITS: [(&str, &str, &str, &str); 8] = [\n    (\"Regulation Teal\", \"#46bec8\", \"#fbfaf6\", \"#fbfaf6\"),\n    (\"Polite Coral\", \"#ff786e\", \"#fbfaf6\", \"#fbfaf6\"),\n    (\"Mint Compliance\", \"#78dcaa\", \"#263e54\", \"#fbfaf6\"),\n    (\"Sunny Disposition\", \"#ffd166\", \"#46bec8\", \"#fbfaf6\"),\n    (\"Lobby Lilac\", \"#c7b1ec\", \"#fbfaf6\", \"#263e54\"),\n    (\"Towel White\", \"#fdfcf8\", \"#fdfcf8\", \"#e8e2d4\"),\n    (\"Evening Ink\", \"#263e54\", \"#46bec8\", \"#fbfaf6\"),\n    (\"Flamingo Adjacent\", \"#ff9ec4\", \"#fbfaf6\", \"#ff9ec4\"),\n];\n\n/// Wardrobe items and the total minutes that unlock them: (name, minutes).\npub const HATS: [(&str, u32); 5] = [(\"No Hat\", 0), (\"Sun Cap\", 3), (\"Towel Turban\", 8), (\"Modest Crown\", 20), (\"Unearned Halo\", 34)];\npub const EXTRAS: [(&str, u32); 4] = [(\"Nothing Extra\", 0), (\"Sweatbands\", 5), (\"Very Serious Belt\", 12), (\"Arm Floaties\", 26)];\n\n/// The puppet for a guest's look.\npub fn guest_def(skin: u8, outfit: u8, wear: &Wear) -> crate::puppet::PuppetDef {\n    use crate::puppet::{HelmKind, PuppetDef};\n    let (_, shirt, pants, shoes) = OUTFITS[outfit as usize % OUTFITS.len()];\n    let mut d = PuppetDef { skin: SKINS[skin as usize % SKINS.len()].into(), shirt: shirt.into(), pants: pants.into(), shoes: shoes.into(), ..Default::default() };\n    if wear.gold_shoes {\n        d.shoes = \"#ffcf4d\".into();\n    }\n    match wear.hat {\n        1 => {\n            d.gear.helm = HelmKind::Cap;\n            d.gear.helm_color = \"#ff786e\".into();\n        }\n        2 => {\n            d.gear.helm = HelmKind::Hood;\n            d.gear.helm_color = \"#f5f2ec\".into();\n        }\n        3 => {\n            d.gear.helm = HelmKind::Crown;\n            d.gear.helm_color = \"#ffd166\".into();\n        }\n        4 => {\n            d.gear.helm = HelmKind::Halo;\n            d.gear.helm_color = \"#ffe9a8\".into();\n            d.gear.glow = 0.6;\n        }\n        _ => {}\n    }\n    match wear.extra {\n        1 => d.gear.gloves = \"#ffffff\".into(),\n        2 => d.gear.belt = \"#263e54\".into(),\n        3 => {\n            d.gear.pauldrons = 1.0;\n            d.gear.armor_color = \"#ffd166\".into();\n        }\n        _ => {}\n    }\n    d\n}\nRS\ncat > $F/script.rs <<'RS'\n//! All the words, from `script.toml`.\n\nuse std::collections::BTreeMap;\nuse std::sync::OnceLock;\n\nuse serde::Deserialize;\n\n#[derive(Debug, Default, Deserialize)]\npub struct Script {\n    pub lines: BTreeMap<String, Vec<String>>,\n    pub names: Vec<String>,\n    pub titles: Vec<String>,\n}\n\nstatic SCRIPT: OnceLock<Script> = OnceLock::new();\n\npub fn script() -> &'static Script {\n    SCRIPT.get_or_init(|| {\n        let text = super::super::level_text(\"fit/script\", include_str!(\"script.toml\"));\n        toml::from_str(&text).unwrap_or_else(|e| panic!(\"fit/script.toml: {e}\"))\n    })\n}\n\n/// Lines under `key` (none: empty).\npub fn lines(key: &str) -> &'static [String] {\n    script().lines.get(key).map(|v| v.as_slice()).unwrap_or(&[])\n}\n\n/// A line under `key`, chosen by `pick`.\npub fn line(key: &str, pick: u32) -> String {\n    let l = lines(key);\n    if l.is_empty() { String::new() } else { l[pick as usize % l.len()].clone() }\n}\n\n/// The deadpan title for a score: the list runs from worst to best.\npub fn title(score: u32) -> String {\n    let t = &script().titles;\n    if t.is_empty() {\n        return String::new();\n    }\n    t[((score as usize).min(1000) * (t.len() - 1)) / 1000].clone()\n}\n\n/// Who speaks: name, base pitch.\npub const SPEAKERS: [&str; 10] = [\"Pip\", \"Posey\", \"Big Kettle\", \"Bounce\", \"Commodore Gull\", \"Marjorie\", \"Two-Towel Tom\", \"The Twins\", \"A Guest\", \"\"];\npub const PIP: u8 = 0;\npub const POSEY: u8 = 1;\npub const KETTLE: u8 = 2;\npub const BOUNCE: u8 = 3;\npub const GULL: u8 = 4;\npub const MARJORIE: u8 = 5;\npub const TOM: u8 = 6;\npub const TWINS: u8 = 7;\npub const GUEST: u8 = 8;\nRS\ncat > $F/dialog.rs <<'RS'\n//! Lines that type out with voice blips. Action completes the line, then advances.\n\nuse std::collections::VecDeque;\n\nuse serde::{Deserialize, Serialize};\n\nuse super::ui_model::*;\nuse crate::frame::SimEvent;\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Line {\n    pub who: u8,\n    pub text: String,\n}\n\n/// What happens when the lines run out.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum After {\n    #[default]\n    Nothing,\n    StartCheck,\n    IslandDay,\n    EndDay,\n    FinaleCheck,\n    Ending,\n    Credits,\n    GotoCheck,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Dialog {\n    pub lines: VecDeque<Line>,\n    /// Letters shown of the first line.\n    pub shown: f32,\n    pub after: After,\n    last_voice: usize,\n}\n\nimpl Dialog {\n    pub fn new(after: After) -> Self {\n        Self { after, ..Default::default() }\n    }\n\n    pub fn push(&mut self, who: u8, text: impl Into<String>) {\n        let text = text.into();\n        if !text.is_empty() {\n            self.lines.push_back(Line { who, text });\n        }\n    }\n\n    pub fn finished_line(&self) -> bool {\n        self.lines.front().is_none_or(|l| self.shown as usize >= l.text.chars().count())\n    }\n\n    /// Returns true when the dialog has run out of lines.\n    pub fn tick(&mut self, confirm: bool, speed: f32, dt: f32, ev: &mut Vec<SimEvent>) -> bool {\n        let Some(line) = self.lines.front() else { return true };\n        let n = line.text.chars().count();\n        let was_done = self.shown as usize >= n;\n        if confirm {\n            if was_done {\n                self.lines.pop_front();\n                self.shown = 0.0;\n                self.last_voice = 0;\n                ev.push(SimEvent::Sfx { id: super::sfx::MOVE, gain: 0.4, pitch: 1.2 });\n                return self.lines.is_empty();\n            }\n            self.shown = n as f32;\n            return false;\n        }\n        self.shown = (self.shown + 42.0 * speed * dt).min(n as f32);\n        // A syllable per few letters: vowel from the letter, pitch falling at \".\" and rising at \"?\".\n        let (rate, who) = (voice_rate(line.who), line.who);\n        let at = self.shown as usize;\n        while self.last_voice + rate <= at {\n            self.last_voice += rate;\n            let c = line.text.chars().nth(self.last_voice).unwrap_or(' ');\n            let end = line.text.chars().skip(self.last_voice).take(4).find(|x| matches!(x, '.' | '?' | '!'));\n            let pitch = match end {\n                Some('.') => 0.86,\n                Some('?') => 1.22,\n                Some('!') => 1.1,\n                _ => 0.96 + (c as u32 % 5) as f32 * 0.03,\n            };\n            if c.is_alphanumeric() {\n                let vowel = match c.to_ascii_lowercase() {\n                    'a' | 'h' | 'k' | 'q' | 'r' => 0,\n                    'e' | 'b' | 'c' | 'd' | 'p' | 't' => 1,\n                    'i' | 'g' | 'j' | 'l' | 'y' | 's' => 2,\n                    'o' | 'f' | 'm' | 'n' | 'x' => 3,\n                    _ => 4,\n                };\n                ev.push(SimEvent::Syllable { speaker: who, vowel, pitch });\n            }\n        }\n        false\n    }\n\n    pub fn draw(&self, b: &mut B) {\n        let Some(line) = self.lines.front() else { return };\n        b.card([240.0, 760.0, 1680.0, 1040.0], DECK);\n        let who = super::script::SPEAKERS.get(line.who as usize).copied().unwrap_or(\"\");\n        if !who.is_empty() {\n            b.flat([280.0, 730.0, 280.0 + 40.0 + who.len() as f32 * 26.0, 800.0], TEAL, 26.0);\n            b.text(300.0, 742.0, 40.0, WHITE, who);\n        }\n        let shown: String = line.text.chars().take(self.shown as usize).collect();\n        b.wrap(300.0, 826.0, 1320.0, 46.0, INK, &shown);\n        if self.finished_line() {\n            b.prompt_right(1640.0, 978.0, &[Glyph::Confirm], \"\");\n        }\n    }\n}\n\nfn voice_rate(who: u8) -> usize {\n    match who {\n        super::script::BOUNCE | super::script::GULL => 2,\n        super::script::KETTLE => 4,\n        _ => 3,\n    }\n}\nRS\ncat > $F/ghost.rs <<'RS'\n//! Ghosts: a run recorded a few times a second, replayed as a tinted figure. Three sources share\n//! this drawing: Yesterday You, Play Together, and other players in a hub session.\n\nuse std::sync::Arc;\n\nuse glam::{Quat, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse crate::color::Color;\nuse crate::entity::EntityId;\nuse crate::frame::{PuppetFrame, RenderObject};\nuse crate::puppet::{PuppetDef, PuppetState};\nuse crate::shape::{Shape, Visual};\n\n/// A moment of a run: position, facing, tilt, clip.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct Sample {\n    pub t: f32,\n    pub p: [f32; 3],\n    pub f: f32,\n    pub ts: f32,\n    pub tf: f32,\n    pub c: u32,\n    pub ct: f32,\n    #[serde(default)]\n    pub s: f32,\n}\n\n/// Samples per second recorded.\npub const RATE: f32 = 6.0;\n\n/// A sample at time `t`, between the two recorded around it.\npub fn at(samples: &[Sample], t: f32) -> Option<Sample> {\n    let first = samples.first()?;\n    if t <= first.t {\n        return Some(*first);\n    }\n    let i = samples.partition_point(|s| s.t <= t);\n    let Some(b) = samples.get(i) else { return samples.last().copied() };\n    let a = samples[i - 1];\n    let u = ((t - a.t) / (b.t - a.t).max(1e-4)).clamp(0.0, 1.0);\n    let l = |x: f32, y: f32| x + (y - x) * u;\n    Some(Sample {\n        t,\n        p: [l(a.p[0], b.p[0]), l(a.p[1], b.p[1]), l(a.p[2], b.p[2])],\n        f: l(a.f, b.f),\n        ts: l(a.ts, b.ts),\n        tf: l(a.tf, b.tf),\n        c: b.c,\n        ct: if a.c == b.c { l(a.ct, b.ct) } else { b.ct },\n        s: l(a.s, b.s),\n    })\n}\n\n/// The first id of the figures that are not entities.\npub const FIRST_ID: u32 = 3_000_000;\n\n/// A tinted figure at a sample, shifted by `offset`.\npub fn object(id: u32, s: &Sample, offset: Vec3, def: Arc<PuppetDef>, rgb: [f32; 3], strength: f32) -> RenderObject {\n    let mut state = PuppetState { facing: s.f, tilt_side: s.ts, tilt_fwd: s.tf, clip: s.c, clip_t: s.ct, clip_w: if s.c != 0 { 1.0 } else { 0.0 }, clip_speed: 1e-6, ..Default::default() };\n    state.time = s.t;\n    let feet_offset = 0.9 * def.scale;\n    RenderObject {\n        id: EntityId(FIRST_ID + id),\n        pos: Vec3::from(s.p) + offset + Vec3::Y * feet_offset,\n        rot: Quat::IDENTITY,\n        visual: Visual::new(Shape::Sphere { radius: 0.0 }, Color::WHITE),\n        prop: None,\n        puppet: Some(PuppetFrame { state, feet_offset, def: Some(def), rig: None, tint: Some((rgb, strength)) }),\n        pulse: -1.0,\n        soft: None,\n        vehicle: None,\n        cone: None,\n        scenery: false,\n    }\n}\n\n/// Seat colours, for hub and hot-seat ghosts.\npub const SEATS: [[f32; 3]; 4] = [[0.27, 0.75, 0.78], [1.0, 0.47, 0.43], [1.0, 0.82, 0.4], [0.47, 0.86, 0.67]];\nRS\ngrep -n \"pub struct EntityId\" -B2 -A2 engine/crates/pav_core/src/entity.rs; cat engine/crates/pav_core/src/rng.rs | grep -n \"pub fn\"; grep -n \"height()\\|fn height\" engine/crates/pav_core/src/character.rs | head -5; grep -n \"half_height\" engine/crates/pav_core/src/character.rs | head -6;grep -n \"pub mod\\|pub use\" engine/crates/pav_core/src/lib.rs | head -60 | grep -i \"rng\\|games\\|nav\\|prop\"","description":"Write save/meta, script loader, dialog and ghost modules"}}}
