{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjJQbACEuN7F12BY7dbY","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014rJotgk5HuEjkaU9YQ7CmK","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953/engine\n# fonts\nmkdir -p ../notes/fontdl crates/pav_ui/fonts; (cd ../notes/fontdl && npm pack --silent @expo-google-fonts/fredoka @expo-google-fonts/nunito >/dev/null 2>&1; for t in *.tgz; do mkdir -p x_$t; tar xzf $t -C x_$t; done; F1=$(find . -name \"Fredoka_600SemiBold.ttf\" | head -1); F2=$(find . -name \"Nunito_700Bold.ttf\" | head -1); cp \"$F1\" \"$F2\" ../../engine/crates/pav_ui/fonts/); rm -rf ../notes/fontdl; ls -la crates/pav_ui/fonts\ncat > crates/pav_audio/src/music.rs <<'RS'\n//! The sequencer: original songs written by hand as patterns over chord progressions. It runs inside\n//! `Mixer::render`, so timing is sample-accurate and the rhythm clock is the music's own.\n\nuse crate::{Patch, Wave};\n\n/// One line of a song. `steps` holds semitones above the bar's chord root; `R` is a rest.\n#[derive(Clone, Copy)]\npub struct Track {\n    pub patch: Patch,\n    pub steps: &'static [i16],\n    /// Semitone offset of the whole track.\n    pub base: i16,\n    /// Pitched by the chord (false: drums keep their own patch pitch).\n    pub tuned: bool,\n    pub pan: f32,\n    /// Bars the pattern spans before repeating (the step list is divided among them).\n    pub bars: u32,\n}\n\npub const R: i16 = 999;\n\n#[derive(Clone, Copy)]\npub struct Song {\n    pub bpm: f32,\n    pub steps_per_beat: u32,\n    pub beats_per_bar: u32,\n    /// The chord roots, one per bar, in semitones above A (220 Hz).\n    pub chords: &'static [i16],\n    pub tracks: &'static [Track],\n}\n\nconst fn pluck(vol: f32) -> Patch {\n    Patch { attack: 0.003, decay: 0.28, sustain: 0.0, hold: 0.0, release: 0.08, volume: vol, cutoff: 2600.0, cutoff_end: 700.0, ..Patch::new(Wave::Triangle, 220.0) }\n}\nconst fn bass(vol: f32) -> Patch {\n    Patch { attack: 0.004, decay: 0.2, sustain: 0.5, hold: 0.08, release: 0.1, volume: vol, cutoff: 900.0, cutoff_end: 400.0, ..Patch::new(Wave::Triangle, 110.0) }\n}\nconst fn brush(vol: f32) -> Patch {\n    Patch { attack: 0.01, decay: 0.07, release: 0.03, volume: vol, cutoff: 8000.0, cutoff_end: 5000.0, ..Patch::new(Wave::Noise, 1.0) }\n}\nconst fn kick(vol: f32) -> Patch {\n    Patch { freq_end: 46.0, glide: 0.07, attack: 0.001, decay: 0.16, release: 0.02, volume: vol, ..Patch::new(Wave::Sine, 130.0) }\n}\nconst fn clap(vol: f32) -> Patch {\n    Patch { attack: 0.002, decay: 0.09, release: 0.04, volume: vol, cutoff: 5200.0, cutoff_end: 1800.0, ..Patch::new(Wave::Noise, 1.0) }\n}\nconst fn pad(vol: f32) -> Patch {\n    Patch { attack: 1.1, decay: 0.8, sustain: 0.7, hold: 2.4, release: 1.6, volume: vol, cutoff: 500.0, cutoff_end: 1200.0, ..Patch::new(Wave::Saw, 220.0) }\n}\nconst fn bell(vol: f32) -> Patch {\n    Patch { attack: 0.002, decay: 1.2, release: 0.5, volume: vol, ..Patch::new(Wave::Sine, 880.0) }\n}\nconst fn tuba(vol: f32) -> Patch {\n    Patch { attack: 0.03, decay: 0.2, sustain: 0.6, hold: 0.22, release: 0.12, volume: vol, cutoff: 700.0, cutoff_end: 420.0, duty: 0.4, ..Patch::new(Wave::Square, 110.0) }\n}\nconst fn pizz(vol: f32) -> Patch {\n    Patch { attack: 0.002, decay: 0.2, release: 0.06, volume: vol, cutoff: 1100.0, cutoff_end: 300.0, ..Patch::new(Wave::Triangle, 110.0) }\n}\nconst fn stab(vol: f32) -> Patch {\n    Patch { attack: 0.004, decay: 0.12, sustain: 0.0, release: 0.05, volume: vol, cutoff: 2800.0, cutoff_end: 900.0, duty: 0.3, ..Patch::new(Wave::Square, 220.0) }\n}\nconst fn marimba(vol: f32) -> Patch {\n    Patch { attack: 0.001, decay: 0.2, release: 0.05, volume: vol, cutoff: 3500.0, cutoff_end: 1200.0, ..Patch::new(Wave::Triangle, 440.0) }\n}\nconst fn brass(vol: f32) -> Patch {\n    Patch { attack: 0.05, decay: 0.15, sustain: 0.7, hold: 0.3, release: 0.15, volume: vol, cutoff: 1700.0, cutoff_end: 1100.0, ..Patch::new(Wave::Saw, 220.0) }\n}\nconst fn snare(vol: f32) -> Patch {\n    Patch { attack: 0.001, decay: 0.08, release: 0.03, volume: vol, cutoff: 6500.0, cutoff_end: 2800.0, ..Patch::new(Wave::Noise, 1.0) }\n}\n\n/// A shorthand for a track.\nconst fn t(patch: Patch, steps: &'static [i16], base: i16, tuned: bool, pan: f32, bars: u32) -> Track {\n    Track { patch, steps, base, tuned, pan, bars }\n}\n\n// 1 Lobby Bossa: resort lounge, not gym. Nylon-like plucks, brushes, a walking bass.\nconst BOSSA: Song = Song {\n    bpm: 84.0,\n    steps_per_beat: 2,\n    beats_per_bar: 4,\n    chords: &[0, 5, -2, 3, 0, 5, 7, -5],\n    tracks: &[\n        t(bass(0.5), &[0, R, 7, R, 12, R, 7, R], -12, true, 0.0, 1),\n        t(pluck(0.24), &[R, 10, R, R, 3, R, 7, R, R, 10, R, 3, R, R, 7, R], 12, true, -0.3, 2),\n        t(pluck(0.2), &[R, 3, R, R, 7, R, 10, R, R, 7, R, 10, R, R, 14, R], 12, true, 0.3, 2),\n        t(pluck(0.26), &[12, R, 10, 7, R, 3, R, 5, R, R, 7, R, R, R, 3, R, 0, R, 3, 5, R, 7, R, 10, R, R, 12, R, R, R, R, R], 24, true, 0.15, 4),\n        t(brush(0.11), &[0, 0, 0, R, 0, 0, 0, 0], 0, false, -0.2, 1),\n    ],\n};\n// 2 Tide Pad: slow pads and sparse bells, no beat.\nconst TIDEPAD: Song = Song {\n    bpm: 52.0,\n    steps_per_beat: 1,\n    beats_per_bar: 4,\n    chords: &[0, -4, -7, -2],\n    tracks: &[\n        t(pad(0.14), &[0, R, R, R], 0, true, -0.3, 1),\n        t(pad(0.12), &[7, R, R, R], 0, true, 0.3, 1),\n        t(pad(0.1), &[15, R, R, R], 0, true, 0.0, 1),\n        t(bell(0.13), &[R, R, 12, R, R, 19, R, R, R, R, 24, R, R, 15, R, R], 12, true, 0.4, 4),\n        t(bell(0.09), &[R, R, R, R, 7, R, R, R, R, R, R, 19, R, R, R, R, R, 12, R, R, R, R, R, R], 24, true, -0.4, 6),\n    ],\n};\n// 3 Iron Waltz: 3/4, low pizzicato bass and a dignified tuba.\nconst WALTZ: Song = Song {\n    bpm: 108.0,\n    steps_per_beat: 1,\n    beats_per_bar: 3,\n    chords: &[0, 0, 5, 0, 7, 7, 0, 0],\n    tracks: &[\n        t(pizz(0.5), &[0, R, R], -12, true, 0.0, 1),\n        t(pluck(0.14), &[R, 7, 7], 0, true, -0.25, 1),\n        t(pluck(0.12), &[R, 15, 15], 0, true, 0.25, 1),\n        t(tuba(0.34), &[12, 14, 15, 19, R, 15, 14, R, 12, 15, 14, 12, 7, R, R, 12, 14, 15, 19, 22, 24, 19, R, 15, 14, R, 12, 12, R, R], -12, true, 0.0, 10),\n    ],\n};\n// 4 Step Party: 96 BPM funk-pop, clear kick and clap for timing.\nconst PARTY: Song = Song {\n    bpm: 96.0,\n    steps_per_beat: 4,\n    beats_per_bar: 4,\n    chords: &[0, 0, 5, 7],\n    tracks: &[\n        t(kick(0.62), &[0, R, R, R, 0, R, R, R, 0, R, R, R, 0, R, R, R], 0, false, 0.0, 1),\n        t(clap(0.34), &[R, R, R, R, 0, R, R, R, R, R, R, R, 0, R, R, R], 0, false, 0.05, 1),\n        t(brush(0.12), &[R, R, 0, R, R, R, 0, R, R, R, 0, R, R, R, 0, 0], 0, false, -0.2, 1),\n        t(bass(0.46), &[0, R, R, 0, R, R, 12, R, R, 0, R, R, 10, R, 7, R], -12, true, 0.0, 1),\n        t(stab(0.14), &[R, R, 15, R, R, 15, R, R, R, R, 19, R, R, 15, R, R], 12, true, 0.3, 1),\n        t(stab(0.14), &[R, R, 7, R, R, 7, R, R, R, R, 10, R, R, 7, R, R], 12, true, -0.3, 1),\n        t(marimba(0.2), &[R, R, R, R, R, R, R, R, 24, R, 22, R, 19, R, 15, R, R, R, R, R, R, R, R, R, 12, R, 15, R, 19, R, 22, R], 12, true, 0.1, 2),\n    ],\n};\n// 5 Lagoon Mallets: 110 BPM, marimba-like and playful.\nconst LAGOON: Song = Song {\n    bpm: 110.0,\n    steps_per_beat: 2,\n    beats_per_bar: 4,\n    chords: &[0, 3, 5, 3],\n    tracks: &[\n        t(marimba(0.3), &[0, 7, 12, 7, 15, 12, 7, 12, 0, 7, 12, 15, 19, 15, 12, 7], 12, true, -0.2, 2),\n        t(marimba(0.22), &[R, R, 24, R, R, 22, R, 19, R, R, 24, 27, R, 24, R, R], 24, true, 0.3, 2),\n        t(bass(0.4), &[0, R, R, 7, R, R, 5, R], -12, true, 0.0, 1),\n        t(brush(0.08), &[0, R, 0, 0, 0, R, 0, 0], 0, false, 0.2, 1),\n    ],\n};\n// 6 Band of Guests: marching brass and snare.\nconst BAND: Song = Song {\n    bpm: 96.0,\n    steps_per_beat: 4,\n    beats_per_bar: 4,\n    chords: &[0, 5, 7, 0],\n    tracks: &[\n        t(snare(0.2), &[0, R, 0, 0, 0, R, 0, R, 0, R, 0, 0, 0, 0, 0, R], 0, false, -0.15, 1),\n        t(kick(0.5), &[0, R, R, R, R, R, R, R, 0, R, R, R, R, R, R, R], 0, false, 0.0, 1),\n        t(tuba(0.32), &[0, R, R, R, 7, R, R, R, 0, R, R, R, 7, R, R, R], -12, true, 0.0, 1),\n        t(brass(0.16), &[R, R, R, R, 12, R, 15, R, R, R, R, R, 19, R, 15, R], 0, true, 0.3, 1),\n        t(brass(0.13), &[R, R, R, R, 7, R, 12, R, R, R, R, R, 15, R, 12, R], 0, true, -0.3, 1),\n        t(brass(0.2), &[12, R, R, 12, 15, R, R, 19, 24, R, R, R, 22, R, 19, R, 19, R, R, 15, 12, R, R, 15, 19, R, R, R, R, R, R, R], 12, true, 0.1, 2),\n    ],\n};\n\n/// The song for a number. 0 and unknowns: silence. Song 7, the stingers, are one-shot sounds.\npub fn song(id: u8) -> Option<Song> {\n    match id {\n        1 => Some(BOSSA),\n        2 => Some(TIDEPAD),\n        3 => Some(WALTZ),\n        4 => Some(PARTY),\n        5 => Some(LAGOON),\n        6 => Some(BAND),\n        _ => None,\n    }\n}\n\npub const SONG_IDS: [u8; 6] = [1, 2, 3, 4, 5, 6];\n\n/// The sequencer's place in a song.\n#[derive(Clone, Copy)]\npub struct Sequencer {\n    pub song: Song,\n    pub step: u64,\n    /// Samples into the song.\n    pub at: u64,\n    pub next_at: f64,\n}\n\nimpl Sequencer {\n    pub fn new(song: Song) -> Self {\n        Self { song, step: 0, at: 0, next_at: 0.0 }\n    }\n\n    /// Advances one sample; calls `play` for each note due.\n    pub fn tick(&mut self, rate: f32, mut play: impl FnMut(Patch, f32)) {\n        if self.at as f64 >= self.next_at {\n            let s = &self.song;\n            let per_step = 60.0 / (s.bpm as f64 * s.steps_per_beat as f64) * rate as f64;\n            let steps_per_bar = (s.steps_per_beat * s.beats_per_bar) as u64;\n            let bar = (self.step / steps_per_bar) as usize;\n            let root = s.chords[bar % s.chords.len()];\n            for tr in s.tracks {\n                let span = steps_per_bar * tr.bars as u64;\n                let n = tr.steps.len() as u64;\n                // A pattern is spread evenly over its bars.\n                let pos = self.step % span;\n                if pos * n % span != 0 {\n                    continue;\n                }\n                let v = tr.steps[((pos * n / span) % n) as usize];\n                if v == R {\n                    continue;\n                }\n                let mut p = tr.patch;\n                if tr.tuned {\n                    let f = 220.0 * 2f32.powf((root + tr.base + v) as f32 / 12.0);\n                    p.freq = f;\n                    p.freq_end = f;\n                }\n                p.bus = 1;\n                play(p, tr.pan);\n            }\n            self.step += 1;\n            self.next_at += per_step;\n        }\n        self.at += 1;\n    }\n}\nRS\ncat > crates/pav_audio/src/voice.rs <<'RS'\n//! Voices in the Animalese manner: a formant-filtered blip per syllable and a tiny consonant click.\n//! No real words are ever spoken. Each speaker has a base pitch, rate and timbre.\n\nuse crate::{Patch, Wave};\n\n/// Formant pairs (Hz) for five vowels: ah, eh, ee, oh, oo.\npub const FORMANTS: [(f32, f32); 5] = [(800.0, 1200.0), (560.0, 1800.0), (320.0, 2300.0), (500.0, 900.0), (340.0, 800.0)];\n\n/// (base Hz, wave, length s, attack s, click) per speaker: Pip, Posey, Kettle, Bounce, Commodore,\n/// Marjorie, Tom, the Twins, a guest.\nconst SPEAKERS: [(f32, Wave, f32, f32, f32); 9] = [\n    (430.0, Wave::Saw, 0.075, 0.006, 0.05),\n    (250.0, Wave::Triangle, 0.1, 0.002, 0.16),\n    (92.0, Wave::Saw, 0.14, 0.015, 0.04),\n    (560.0, Wave::Saw, 0.05, 0.004, 0.05),\n    (360.0, Wave::Square, 0.06, 0.002, 0.1),\n    (290.0, Wave::Saw, 0.09, 0.01, 0.04),\n    (170.0, Wave::Saw, 0.09, 0.01, 0.05),\n    (380.0, Wave::Saw, 0.07, 0.005, 0.04),\n    (240.0, Wave::Saw, 0.08, 0.008, 0.04),\n];\n\npub fn syllable(speaker: u8, vowel: u8, pitch: f32) -> Vec<(Patch, f32)> {\n    let (base, wave, len, attack, click) = SPEAKERS[speaker as usize % SPEAKERS.len()];\n    let (f1, f2) = FORMANTS[vowel as usize % FORMANTS.len()];\n    let f = base * pitch;\n    // Rubber on Pip: the pitch slides up through the blip.\n    let end = if speaker == 0 { f * 1.12 } else { f * 0.97 };\n    let body = Patch {\n        freq_end: end,\n        glide: len,\n        attack,\n        decay: len,\n        sustain: 0.0,\n        release: 0.02,\n        volume: 0.5,\n        f1,\n        f2,\n        bus: 2,\n        cutoff: 9000.0,\n        cutoff_end: 6000.0,\n        ..Patch::new(wave, f)\n    };\n    let tick = Patch { attack: 0.0005, decay: 0.012, release: 0.004, volume: click, cutoff: 7000.0, cutoff_end: 3000.0, bus: 2, ..Patch::new(Wave::Noise, 1.0) };\n    vec![(tick, 0.0), (body, 0.004)]\n}\nRS\npython3 - <<'PY'\np='crates/pav_audio/src/lib.rs'\ns=open(p).read()\ns=s.replace('''use std::sync::mpsc::{Receiver, Sender, channel};\n''','''use std::sync::Arc;\nuse std::sync::atomic::{AtomicU64, Ordering};\nuse std::sync::mpsc::{Receiver, Sender, channel};\n''')\ns=s.replace('''use pav_core::SimEvent;\n''','''use pav_core::SimEvent;\n\npub mod music;\npub mod voice;\n''')\ns=s.replace('''    /// Square-wave duty cycle.\n    pub duty: f32,\n}''','''    /// Square-wave duty cycle.\n    pub duty: f32,\n    /// Two parallel band-passes when non-zero: a voice's formants (Hz).\n    pub f1: f32,\n    pub f2: f32,\n    /// 0 sound effects, 1 music, 2 voice.\n    pub bus: u8,\n}''')\ns=s.replace('''            duty: 0.5,\n        }\n    }\n    pub fn length''','''            duty: 0.5,\n            f1: 0.0,\n            f2: 0.0,\n            bus: 0,\n        }\n    }\n    pub fn length''')\ns=s.replace('''    gain_l: f32,\n    gain_r: f32,\n}\n\nimpl Voice {''','''    gain_l: f32,\n    gain_r: f32,\n    /// Formant band-pass states (low, band), one pair per formant.\n    bp: [f32; 4],\n}\n\nimpl Voice {''')\ns=s.replace('''        self.lp += (raw - self.lp) * a;\n        let s = self.lp * self.env() * p.volume;''','''        self.lp += (raw - self.lp) * a;\n        let mut out = self.lp;\n        if p.f1 > 0.0 {\n            // Two state-variable band-passes in parallel.\n            let mut sum = 0.0;\n            for (k, f) in [p.f1, p.f2].into_iter().enumerate() {\n                let g = (std::f32::consts::TAU * f * dt).min(1.4);\n                let q = 0.22;\n                let (low, band) = (self.bp[k * 2], self.bp[k * 2 + 1]);\n                let low = low + g * band;\n                let high = out - low - q * band;\n                let band = band + g * high;\n                self.bp[k * 2] = low;\n                self.bp[k * 2 + 1] = band;\n                sum += band * if k == 0 { 1.0 } else { 0.7 };\n            }\n            out = sum * 0.7;\n        }\n        let s = out * self.env() * p.volume;''')\ns=s.replace('''pub struct Mixer {\n    voices: Vec<Voice>,\n    pub sample_rate: f32,\n    pub master: f32,\n    seed: u32,\n}\n\nconst MAX_VOICES: usize = 64;\n''','''pub struct Mixer {\n    voices: Vec<Voice>,\n    pub sample_rate: f32,\n    pub master: f32,\n    seed: u32,\n    /// Sound effects, music, voice.\n    pub bus: [f32; 3],\n    seq: Option<music::Sequencer>,\n    /// Multiplies the music bus while a fade to silence runs.\n    fade: f32,\n    fading: bool,\n    /// Samples since the song started (read by the rhythm clock).\n    pub clock: Arc<AtomicU64>,\n}\n\nconst MAX_VOICES: usize = 96;\n''')\ns=s.replace('''        Self { voices: Vec::new(), sample_rate, master: 0.8, seed: 0x9e37_79b9 }\n    }\n''','''        Self {\n            voices: Vec::new(),\n            sample_rate,\n            master: 0.8,\n            seed: 0x9e37_79b9,\n            bus: [1.0, 1.0, 1.0],\n            seq: None,\n            fade: 1.0,\n            fading: false,\n            clock: Arc::new(AtomicU64::new(0)),\n        }\n    }\n\n    /// Starts a song from its beginning; 255 fades out over three seconds; 0 stops at once.\n    pub fn set_song(&mut self, id: u8) {\n        if id == 255 {\n            self.fading = true;\n            return;\n        }\n        self.fading = false;\n        self.fade = 1.0;\n        self.voices.retain(|v| v.p.bus != 1);\n        self.seq = music::song(id).map(music::Sequencer::new);\n        self.clock.store(0, Ordering::Relaxed);\n    }\n''')\ns=s.replace('''            gain_l: a.cos() * gain,\n            gain_r: a.sin() * gain,\n        });''','''            gain_l: a.cos() * gain,\n            gain_r: a.sin() * gain,\n            bp: [0.0; 4],\n        });''')\ns=s.replace('''        for frame in out.chunks_mut(2) {\n            let (mut l, mut r) = (0.0, 0.0);\n            for v in &mut self.voices {\n                let s = v.next(dt);\n                l += s * v.gain_l;\n                r += s * v.gain_r;\n            }''','''        for frame in out.chunks_mut(2) {\n            if let Some(mut seq) = self.seq.take() {\n                let rate = self.sample_rate;\n                seq.tick(rate, |p, pan| self.play(p, pan, 1.0, 0.0));\n                self.clock.store(seq.at, Ordering::Relaxed);\n                self.seq = Some(seq);\n            }\n            if self.fading {\n                self.fade = (self.fade - dt / 3.0).max(0.0);\n                if self.fade <= 0.0 {\n                    self.seq = None;\n                }\n            }\n            let (mut l, mut r) = (0.0, 0.0);\n            for v in &mut self.voices {\n                let b = self.bus[(v.p.bus as usize).min(2)] * if v.p.bus == 1 { self.fade } else { 1.0 };\n                let s = v.next(dt) * b;\n                l += s * v.gain_l;\n                r += s * v.gain_r;\n            }''')\ns=s.replace('''        SimEvent::Coin { .. } => vec![''','''        SimEvent::Sfx { id, gain, pitch } => fit_sfx(*id, *gain, *pitch),\n        SimEvent::Syllable { speaker, vowel, pitch } => voice::syllable(*speaker, *vowel, *pitch),\n        SimEvent::Coin { .. } => vec![''')\ns=s.replace('''/// Position of an event (None = not spatial).''','''/// We Stand's sound bank, by number (`pav_core::games::fit::sfx`). Every sound is synthesized.\npub fn fit_sfx(id: u8, gain: f32, pitch: f32) -> Vec<(Patch, f32)> {\n    use Wave::*;\n    use pav_core::games::fit::sfx::*;\n    let mut v: Vec<(Patch, f32)> = match id {\n        MOVE => vec![(Patch { decay: 0.04, volume: 0.1, cutoff: 3000.0, ..Patch::new(Sine, 880.0) }, 0.0)],\n        CONFIRM => vec![(Patch { decay: 0.08, volume: 0.14, ..Patch::new(Triangle, 880.0) }, 0.0), (Patch { decay: 0.12, volume: 0.14, ..Patch::new(Triangle, 1318.0) }, 0.06)],\n        BACK => vec![(Patch { decay: 0.1, volume: 0.13, freq_end: 440.0, glide: 0.1, ..Patch::new(Triangle, 660.0) }, 0.0)],\n        STAMP => vec![(Patch { freq_end: 40.0, glide: 0.1, decay: 0.22, volume: 0.6, ..Patch::new(Sine, 150.0) }, 0.0), (Patch { decay: 0.1, volume: 0.35, cutoff: 1500.0, cutoff_end: 300.0, ..Patch::new(Noise, 1.0) }, 0.0)],\n        GULP => vec![(Patch { freq_end: 90.0, glide: 0.2, attack: 0.02, decay: 0.2, volume: 0.45, ..Patch::new(Sine, 260.0) }, 0.0), (Patch { freq_end: 70.0, glide: 0.2, attack: 0.02, decay: 0.2, volume: 0.4, ..Patch::new(Sine, 200.0) }, 0.2)],\n        TICK => vec![(Patch { decay: 0.025, volume: 0.2, ..Patch::new(Square, 1400.0) }, 0.0)],\n        STEP => vec![(Patch { decay: 0.05, volume: 0.22, cutoff: 1800.0, cutoff_end: 500.0, ..Patch::new(Noise, 1.0) }, 0.0)],\n        SQUEAK => vec![(Patch { freq_end: 1400.0, glide: 0.12, attack: 0.01, decay: 0.14, volume: 0.22, f1: 900.0, f2: 2200.0, ..Patch::new(Saw, 620.0) }, 0.0)],\n        CREAK => vec![(Patch { freq_end: 95.0, glide: 0.4, attack: 0.03, decay: 0.4, volume: 0.2, cutoff: 900.0, duty: 0.1, ..Patch::new(Square, 140.0) }, 0.0)],\n        SPLASH_S => vec![(Patch { attack: 0.01, decay: 0.25, volume: 0.25, cutoff: 3000.0, cutoff_end: 500.0, ..Patch::new(Noise, 1.0) }, 0.0)],\n        SPLASH_B => vec![(Patch { attack: 0.005, decay: 0.7, sustain: 0.2, hold: 0.1, release: 0.7, volume: 0.65, cutoff: 5000.0, cutoff_end: 250.0, ..Patch::new(Noise, 1.0) }, 0.0), (Patch { freq_end: 36.0, glide: 0.3, decay: 0.45, volume: 0.6, ..Patch::new(Sine, 120.0) }, 0.0)],\n        GULL => vec![(Patch { freq_end: 720.0, glide: 0.15, attack: 0.01, decay: 0.2, volume: 0.17, f1: 1100.0, f2: 2600.0, ..Patch::new(Saw, 1100.0) }, 0.0), (Patch { freq_end: 640.0, glide: 0.2, attack: 0.01, decay: 0.26, volume: 0.17, f1: 1100.0, f2: 2600.0, ..Patch::new(Saw, 980.0) }, 0.2)],\n        MURMUR => vec![(Patch { attack: 0.4, decay: 0.6, sustain: 0.5, hold: 0.6, release: 0.7, volume: 0.1, cutoff: 700.0, cutoff_end: 500.0, ..Patch::new(Noise, 1.0) }, 0.0)],\n        CLAP => vec![(Patch { attack: 0.001, decay: 0.07, release: 0.03, volume: 0.3, cutoff: 5000.0, cutoff_end: 1800.0, ..Patch::new(Noise, 1.0) }, 0.0)],\n        GONG => vec![(Patch { attack: 0.004, decay: 1.8, release: 0.6, volume: 0.28, ..Patch::new(Sine, 160.0) }, 0.0), (Patch { attack: 0.004, decay: 1.2, volume: 0.14, ..Patch::new(Sine, 437.0) }, 0.0), (Patch { attack: 0.004, decay: 0.7, volume: 0.08, ..Patch::new(Sine, 1011.0) }, 0.0)],\n        BELL => vec![(Patch { attack: 0.002, decay: 0.8, release: 0.2, volume: 0.22, ..Patch::new(Sine, 660.0) }, 0.0), (Patch { attack: 0.002, decay: 0.4, volume: 0.1, ..Patch::new(Sine, 1660.0) }, 0.0)],\n        WHOOSH => vec![(Patch { attack: 0.08, decay: 0.25, volume: 0.22, cutoff: 700.0, cutoff_end: 4200.0, ..Patch::new(Noise, 1.0) }, 0.0)],\n        ROLL => vec![(Patch { attack: 0.01, decay: 0.09, volume: 0.1, cutoff: 900.0, cutoff_end: 500.0, ..Patch::new(Noise, 1.0) }, 0.0)],\n        PLOP => vec![(Patch { freq_end: 900.0, glide: 0.1, decay: 0.12, volume: 0.3, ..Patch::new(Sine, 260.0) }, 0.0)],\n        GLASS => vec![(Patch { decay: 0.3, volume: 0.15, ..Patch::new(Sine, 2100.0) }, 0.0), (Patch { freq_end: 700.0, glide: 0.12, decay: 0.15, volume: 0.3, ..Patch::new(Sine, 300.0) }, 0.25)],\n        POP => vec![(Patch { freq_end: 1100.0, glide: 0.04, decay: 0.05, volume: 0.3, ..Patch::new(Sine, 420.0) }, 0.0), (Patch { decay: 0.04, volume: 0.1, ..Patch::new(Noise, 1.0) }, 0.0)],\n        GUST => vec![(Patch { attack: 0.4, decay: 0.9, release: 0.5, volume: 0.22, cutoff: 500.0, cutoff_end: 1500.0, ..Patch::new(Noise, 1.0) }, 0.0)],\n        WAVE => vec![(Patch { attack: 0.2, decay: 0.8, release: 0.4, volume: 0.32, cutoff: 1700.0, cutoff_end: 500.0, ..Patch::new(Noise, 1.0) }, 0.0)],\n        SEA => vec![(Patch { attack: 1.4, decay: 1.8, release: 1.4, volume: 0.07, cutoff: 900.0, cutoff_end: 500.0, ..Patch::new(Noise, 1.0) }, 0.0)],\n        TONE => vec![(Patch { attack: 0.01, decay: 0.15, release: 0.03, volume: 0.22, ..Patch::new(Sine, 440.0) }, 0.0)],\n        CHIME => vec![(Patch { attack: 0.002, decay: 0.7, release: 0.2, volume: 0.22, ..Patch::new(Sine, 880.0) }, 0.0), (Patch { attack: 0.002, decay: 0.35, volume: 0.09, ..Patch::new(Sine, 1760.0) }, 0.0)],\n        STAR => vec![(Patch { decay: 0.3, volume: 0.18, ..Patch::new(Triangle, 1046.0) }, 0.0)],\n        GROAN => vec![(Patch { freq_end: 90.0, glide: 0.8, attack: 0.15, decay: 0.8, release: 0.3, volume: 0.17, f1: 450.0, f2: 900.0, ..Patch::new(Saw, 150.0) }, 0.0), (Patch { freq_end: 110.0, glide: 0.8, attack: 0.15, decay: 0.8, release: 0.3, volume: 0.15, f1: 500.0, f2: 1000.0, ..Patch::new(Saw, 185.0) }, 0.05)],\n        CHEER => vec![(Patch { attack: 0.15, decay: 1.1, release: 0.5, volume: 0.25, cutoff: 3200.0, cutoff_end: 1500.0, ..Patch::new(Noise, 1.0) }, 0.0)],\n        BURP => vec![(Patch { freq_end: 60.0, glide: 0.3, attack: 0.02, decay: 0.3, volume: 0.45, f1: 500.0, f2: 900.0, ..Patch::new(Saw, 95.0) }, 0.35)],\n        BOING => vec![(Patch { freq_end: 460.0, glide: 0.16, decay: 0.2, volume: 0.25, ..Patch::new(Sine, 150.0) }, 0.0)],\n        WOOD => vec![(Patch { decay: 0.05, volume: 0.32, cutoff: 3200.0, ..Patch::new(Square, 760.0) }, 0.0), (Patch { decay: 0.05, volume: 0.2, ..Patch::new(Square, 540.0) }, 0.08)],\n        PERFECT => vec![(Patch { decay: 0.14, volume: 0.13, ..Patch::new(Triangle, 1568.0) }, 0.0)],\n        GOOD => vec![(Patch { decay: 0.1, volume: 0.11, ..Patch::new(Triangle, 1046.0) }, 0.0)],\n        COUNT => vec![(Patch { decay: 0.14, volume: 0.2, ..Patch::new(Square, 660.0) }, 0.0)],\n        GO => vec![(Patch { decay: 0.4, volume: 0.22, ..Patch::new(Square, 1320.0) }, 0.0)],\n        FANFARE => vec![\n            (Patch { decay: 0.14, volume: 0.17, ..Patch::new(Triangle, 523.0) }, 0.0),\n            (Patch { decay: 0.14, volume: 0.17, ..Patch::new(Triangle, 659.0) }, 0.11),\n            (Patch { decay: 0.14, volume: 0.17, ..Patch::new(Triangle, 784.0) }, 0.22),\n            (Patch { decay: 0.5, volume: 0.2, ..Patch::new(Triangle, 1047.0) }, 0.33),\n        ],\n        REVEAL => vec![(Patch { attack: 0.4, decay: 2.4, release: 0.3, volume: 0.1, freq_end: 880.0, glide: 2.8, ..Patch::new(Saw, 110.0) }, 0.0)],\n        _ => Vec::new(),\n    };\n    for (p, _) in &mut v {\n        p.volume *= gain;\n        p.freq *= pitch;\n        p.freq_end *= pitch;\n    }\n    v\n}\n\n/// Position of an event (None = not spatial).''')\ns=s.replace('''pub fn play_event(mixer: &mut Mixer, ev: &SimEvent, l: &Listener, sfx: f32) {\n    let (pan, gain)''','''pub fn play_event(mixer: &mut Mixer, ev: &SimEvent, l: &Listener, sfx: f32) {\n    if let SimEvent::Music { song } = ev {\n        mixer.set_song(*song);\n        return;\n    }\n    let (pan, gain)''')\ns=s.replace('''enum Cmd {\n    Play(Patch, f32, f32, f32),\n    Master(f32),\n}''','''enum Cmd {\n    Play(Patch, f32, f32, f32),\n    Master(f32),\n    Song(u8),\n    Bus([f32; 3]),\n}''')\ns=s.replace('''    tx: Sender<Cmd>,\n    pub sample_rate: u32,\n    pub device: String,\n}''','''    tx: Sender<Cmd>,\n    pub sample_rate: u32,\n    pub device: String,\n    clock: Arc<AtomicU64>,\n}''')\ns=s.replace('''        let config: cpal::StreamConfig = supported.config();\n        let rate = config.sample_rate as u32;''','''        let mut config: cpal::StreamConfig = supported.config();\n        // Snappier effects in the browser: half cpal's default buffer there.\n        #[cfg(target_arch = \"wasm32\")]\n        {\n            config.buffer_size = cpal::BufferSize::Fixed(1024);\n        }\n        let rate = config.sample_rate as u32;\n        let clock = Arc::new(AtomicU64::new(0));''')\ns=s.replace('''            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels)?,\n            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels)?,\n            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels)?,''','''            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels, clock.clone())?,\n            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels, clock.clone())?,\n            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels, clock.clone())?,''')\ns=s.replace('''        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name })\n    }\n\n    pub fn play_event(&self, ev: &SimEvent, l: &Listener, sfx: f32) {\n        let (pan, gain)''','''        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name, clock })\n    }\n\n    /// Seconds since the song started, by the samples rendered.\n    pub fn song_seconds(&self) -> f32 {\n        self.clock.load(Ordering::Relaxed) as f32 / self.sample_rate.max(1) as f32\n    }\n\n    pub fn set_buses(&self, bus: [f32; 3]) {\n        let _ = self.tx.send(Cmd::Bus(bus));\n    }\n\n    pub fn play_event(&self, ev: &SimEvent, l: &Listener, sfx: f32) {\n        if let SimEvent::Music { song } = ev {\n            let _ = self.tx.send(Cmd::Song(*song));\n            return;\n        }\n        let (pan, gain)''')\ns=s.replace('''fn build<T>(device: &cpal::Device, config: cpal::StreamConfig, rx: Receiver<Cmd>, channels: usize) -> anyhow::Result<cpal::Stream>''','''fn build<T>(\n    device: &cpal::Device,\n    config: cpal::StreamConfig,\n    rx: Receiver<Cmd>,\n    channels: usize,\n    clock: Arc<AtomicU64>,\n) -> anyhow::Result<cpal::Stream>''')\ns=s.replace('''    let mut mixer = Mixer::new(config.sample_rate as f32);\n    let mut buf: Vec<f32> = Vec::new();''','''    let mut mixer = Mixer::new(config.sample_rate as f32);\n    mixer.clock = clock;\n    let mut buf: Vec<f32> = Vec::new();''')\ns=s.replace('''                    Cmd::Master(v) => mixer.master = v,\n''','''                    Cmd::Master(v) => mixer.master = v,\n                    Cmd::Song(id) => mixer.set_song(id),\n                    Cmd::Bus(b) => mixer.bus = b,\n''')\ns=s.replace('''    #[test]\n    fn explosion_is_loud_then_silent() {''','''    fn rms(buf: &[f32]) -> f32 {\n        (buf.iter().map(|s| s * s).sum::<f32>() / buf.len().max(1) as f32).sqrt()\n    }\n\n    fn song_rms(id: u8, music: f32, seconds: f32) -> f32 {\n        let mut m = Mixer::new(24000.0);\n        m.bus = [1.0, music, 1.0];\n        m.set_song(id);\n        let mut out = vec![0.0; (seconds * 24000.0) as usize * 2];\n        m.render(&mut out);\n        rms(&out)\n    }\n\n    #[test]\n    fn every_song_sounds_and_music_at_ten_percent_is_a_tenth() {\n        for id in music::SONG_IDS {\n            let full = song_rms(id, 1.0, 12.0);\n            assert!(full > 0.005, \"song {id} is silent: {full}\");\n            let low = song_rms(id, 0.1, 12.0);\n            // The soft clip bends a loud full-scale mix a little.\n            let ratio = low / full;\n            assert!((0.08..0.135).contains(&ratio), \"song {id}: {ratio}\");\n        }\n    }\n\n    #[test]\n    fn every_sfx_sounds_and_speakers_differ() {\n        for id in 1..=pav_core::games::fit::sfx::LAST {\n            let ev = SimEvent::Sfx { id, gain: 1.0, pitch: 1.0 };\n            let out = render_events(&[(0.0, ev)], 3.0, 24000.0, &Listener::default());\n            let peak = out.iter().fold(0.0f32, |m, s| m.max(s.abs()));\n            assert!(peak > 0.01, \"sfx {id} is silent: {peak}\");\n        }\n        let voice = |speaker: u8| {\n            let ev = SimEvent::Syllable { speaker, vowel: 0, pitch: 1.0 };\n            render_events(&[(0.0, ev)], 0.3, 24000.0, &Listener::default())\n        };\n        for s in 0..9 {\n            assert!(rms(&voice(s)) > 0.001, \"speaker {s} is silent\");\n        }\n        // Crossings count how high a voice is: Pip above Kettle.\n        let cross = |b: &[f32]| b.windows(2).step_by(2).filter(|w| w[0] * w[1] < 0.0).count();\n        assert!(voice(0) != voice(2));\n        assert!(cross(&voice(0)) != cross(&voice(2)));\n    }\n\n    #[test]\n    fn the_music_clock_counts_and_fades_to_silence() {\n        let mut m = Mixer::new(24000.0);\n        m.set_song(4);\n        let mut out = vec![0.0; 24000 * 2];\n        m.render(&mut out);\n        assert_eq!(m.clock.load(Ordering::Relaxed), 24000);\n        m.set_song(255);\n        let mut out = vec![0.0; 24000 * 8];\n        m.render(&mut out);\n        let tail = rms(&out[out.len() - 12000..]);\n        assert!(tail < 1e-3, \"faded: {tail}\");\n    }\n\n    #[test]\n    fn explosion_is_loud_then_silent() {''')\nopen(p,'w').write(s)\nPY\ncat > crates/pav_ui/src/fit_ui.rs <<'RS'\n//! Draws a `UiFrame`, on any screen: the frame is in a 1920x1080 space, scaled by\n//! `min(w/1920, h/1080)` and centred, so a hub's small frame gets the same screen. Reports what the\n//! pointer did to its items. Holds no state: everything shown comes from the sim.\n\nuse std::sync::Arc;\n\nuse egui::{Align2, Color32, FontData, FontDefinitions, FontFamily, FontId, Painter, Pos2, Rect, Shape, Stroke, StrokeKind, pos2, vec2};\nuse glam::{Mat4, Vec3, Vec4};\nuse pav_core::games::fit::ui_model::*;\n\nuse crate::Device;\n\n/// What the pointer did this frame.\n#[derive(Clone, Debug, Default)]\npub struct Out {\n    pub hover: Option<u16>,\n    pub click: Option<u16>,\n    pub slider: Option<(u16, f32)>,\n    /// Item rects, in window points, for the page's tests.\n    pub rects: Vec<(u16, [f32; 4])>,\n    /// The pointer is on an item, so a press there is not for the world.\n    pub over: bool,\n}\n\npub const TITLE_FONT: &str = \"fit_title\";\npub const BODY_FONT: &str = \"fit_body\";\n\n/// Puts the game's fonts in. A font family used in the same pass as `set_fonts` panics, so call\n/// this before the first pass.\npub fn install_fonts(ctx: &egui::Context) {\n    let mut f = FontDefinitions::default();\n    f.font_data.insert(TITLE_FONT.into(), Arc::new(FontData::from_static(include_bytes!(\"../fonts/Fredoka_600SemiBold.ttf\"))));\n    f.font_data.insert(BODY_FONT.into(), Arc::new(FontData::from_static(include_bytes!(\"../fonts/Nunito_700Bold.ttf\"))));\n    f.families.insert(FontFamily::Name(TITLE_FONT.into()), vec![TITLE_FONT.into(), BODY_FONT.into()]);\n    f.families.insert(FontFamily::Name(BODY_FONT.into()), vec![BODY_FONT.into()]);\n    ctx.set_fonts(f);\n}\n\nfn c(x: Rgba) -> Color32 {\n    Color32::from_rgba_unmultiplied(x[0], x[1], x[2], x[3])\n}\n\n/// The 1920x1080 space in the window.\n#[derive(Clone, Copy)]\nstruct Space {\n    k: f32,\n    ox: f32,\n    oy: f32,\n    size: egui::Vec2,\n}\n\nimpl Space {\n    fn p(&self, a: [f32; 2]) -> Pos2 {\n        pos2(self.ox + a[0] * self.k, self.oy + a[1] * self.k)\n    }\n    fn r(&self, a: [f32; 4]) -> Rect {\n        Rect::from_min_max(self.p([a[0], a[1]]), self.p([a[2], a[3]]))\n    }\n    fn s(&self, x: f32) -> f32 {\n        x * self.k\n    }\n}\n\nfn font(sp: &Space, size: f32, title: bool) -> FontId {\n    FontId::new(sp.s(size), FontFamily::Name(if title { TITLE_FONT } else { BODY_FONT }.into()))\n}\n\nfn text(p: &Painter, sp: &Space, at: [f32; 2], size: f32, color: Color32, align: u8, title: bool, s: &str, wrap: f32) {\n    let w = if wrap > 0.0 { sp.s(wrap) } else { f32::INFINITY };\n    let g = p.layout(s.to_string(), font(sp, size, title), color, w);\n    let at = sp.p(at);\n    let x = match align {\n        1 => at.x - if wrap > 0.0 { w * 0.5 } else { g.size().x * 0.5 },\n        2 => at.x - g.size().x,\n        _ => at.x,\n    };\n    p.galley(pos2(x, at.y), g, color);\n}\n\n/// Width a text takes, in 1080p units.\nfn width(p: &Painter, sp: &Space, size: f32, title: bool, s: &str) -> f32 {\n    p.layout_no_wrap(s.to_string(), font(sp, size, title), Color32::WHITE).size().x / sp.k.max(1e-3)\n}\n\nfn star(p: &Painter, c0: Pos2, r: f32, fill: Color32) {\n    let at = |i: i32, rr: f32| {\n        let a = -std::f32::consts::FRAC_PI_2 + i as f32 * std::f32::consts::TAU / 10.0;\n        c0 + vec2(a.cos(), a.sin()) * rr\n    };\n    for i in 0..5 {\n        let k = i * 2;\n        p.add(Shape::convex_polygon(vec![at(k, r), at(k + 1, r * 0.42), at(k - 1, r * 0.42)], fill, Stroke::NONE));\n    }\n    p.add(Shape::convex_polygon((0..5).map(|i| at(i * 2 + 1, r * 0.42)).collect(), fill, Stroke::NONE));\n}\n\n/// Draws a frame and reads the pointer. `mouse`: the mouse was used last among keys and mouse.\npub fn draw(ctx: &egui::Context, f: &UiFrame, device: Device, mouse: bool, vp: Mat4) -> Out {\n    let screen = ctx.content_rect();\n    let size = screen.size();\n    let k = (size.x / 1920.0).min(size.y / 1080.0);\n    let sp = Space { k, ox: (size.x - 1920.0 * k) * 0.5, oy: (size.y - 1080.0 * k) * 0.5, size };\n    let p = ctx.layer_painter(egui::LayerId::new(egui::Order::Foreground, egui::Id::new(\"fit_ui\")));\n    let (pointer, moved, clicked, down, rclick) = ctx.input(|i| {\n        (i.pointer.hover_pos(), i.pointer.delta().length() > 0.0 || i.pointer.is_moving(), i.pointer.primary_clicked(), i.pointer.primary_down(), i.pointer.secondary_clicked())\n    });\n    let _ = rclick;\n    let style = glyphs::Style { device, mouse, xbox: f.xbox };\n    let mut out = Out::default();\n    for item in &f.items {\n        match item {\n            Ui::Tint { color } => {\n                p.rect_filled(screen, 0.0, c(*color));\n            }\n            Ui::Card { rect, color, radius, shadow } => {\n                let r = sp.r(*rect);\n                if *shadow {\n                    p.rect_filled(r.translate(vec2(0.0, sp.s(10.0))).expand(sp.s(4.0)), sp.s(*radius), Color32::from_rgba_unmultiplied(38, 62, 84, 40));\n                }\n                p.rect_filled(r, sp.s(*radius), c(*color));\n            }\n            Ui::Text { pos, size, color, align, title, text: s, wrap } => text(&p, &sp, *pos, *size, c(*color), *align, *title, s, *wrap),\n            Ui::Button { id, rect, label, sub, focused, stars, value, fill, big } => {\n                let mut r = sp.r(*rect);\n                out.rects.push((*id, [r.min.x, r.min.y, r.max.x, r.max.y]));\n                let hovered = pointer.is_some_and(|q| r.contains(q));\n                if hovered {\n                    out.over = true;\n                    if moved {\n                        out.hover = Some(*id);\n                    }\n                    if clicked {\n                        out.click = Some(*id);\n                    }\n                    if down && fill.is_some() {\n                        if let Some(q) = pointer {\n                            // The slider's track is the right half of the row.\n                            let track = track_of(r);\n                            if q.x >= track.min.x - sp.s(20.0) {\n                                out.slider = Some((*id, ((q.x - track.min.x) / track.width()).clamp(0.0, 1.0)));\n                                out.click = None;\n                            }\n                        }\n                    }\n                }\n                if *focused {\n                    r = r.expand2(r.size() * 0.025);\n                    p.rect_filled(r.translate(vec2(0.0, sp.s(8.0))), sp.s(36.0), Color32::from_rgba_unmultiplied(38, 62, 84, 50));\n                }\n                p.rect_filled(r, sp.s(36.0), c(WHITE));\n                if *focused {\n                    p.rect_stroke(r, sp.s(36.0), Stroke::new(sp.s(8.0), c(TEAL)), StrokeKind::Inside);\n                }\n                let mid = (rect[1] + rect[3]) * 0.5;\n                let x = rect[0] + 44.0;\n                let ink = c(INK);\n                let label_size = if *big { 60.0 } else { 44.0 };\n                let has_sub = !sub.is_empty();\n                if *big || (fill.is_none() && value.is_empty() && !has_sub && *id < 1000 && rect[2] - rect[0] < 900.0) {\n                    text(&p, &sp, [(rect[0] + rect[2]) * 0.5, mid - label_size * 0.62], label_size, ink, 1, false, label, 0.0);\n                } else if has_sub {\n                    text(&p, &sp, [x, rect[1] + 2.0], label_size, ink, 0, false, label, 0.0);\n                    text(&p, &sp, [x, rect[1] + 54.0], 34.0, c(MUTED), 0, false, sub, 0.0);\n                } else {\n                    text(&p, &sp, [x, mid - label_size * 0.62], label_size, ink, 0, false, label, 0.0);\n                }\n                let right = rect[2] - 44.0;\n                if *stars >= 0 {\n                    for s in 0..3 {\n                        let col = if s < *stars { c(SUN) } else { c(PALE) };\n                        star(&p, sp.p([right - (2 - s) as f32 * 52.0 - 20.0, mid]), sp.s(26.0), col);\n                    }\n                } else if let Some(v) = fill {\n                    let t = track_of(r);\n                    p.rect_filled(t, t.height() * 0.5, c(PALE));\n                    let mut on = t;\n                    on.set_width(t.width() * v.clamp(0.0, 1.0));\n                    p.rect_filled(on, t.height() * 0.5, c(TEAL));\n                    p.circle(pos2(t.min.x + t.width() * v, t.center().y), t.height() * 0.8, c(WHITE), Stroke::new(sp.s(4.0), c(TEAL)));\n                    text(&p, &sp, [right, mid - 40.0], 34.0, ink, 2, false, value, 0.0);\n                } else if !value.is_empty() {\n                    text(&p, &sp, [right, mid - 26.0], 40.0, c(TEAL), 2, false, value, 0.0);\n                }\n            }\n            Ui::Prompt { pos, align, glyphs: gs, label, size } => {\n                let gw: f32 = gs.iter().map(|g| glyphs::width(&p, &sp.into(), *g, &style, *size)).sum::<f32>() + (gs.len() as f32 - 1.0).max(0.0) * 10.0;\n                let lw = if label.is_empty() { 0.0 } else { width(&p, &sp, *size, false, label) + 14.0 };\n                let total = gw + lw;\n                let x0 = match align {\n                    1 => pos[0] - total * 0.5,\n                    2 => pos[0] - total,\n                    _ => pos[0],\n                };\n                let bg = sp.r([x0 - 18.0, pos[1] - 6.0, x0 + total + 18.0, pos[1] + size * 1.45]);\n                p.rect_filled(bg, sp.s(24.0), Color32::from_rgba_unmultiplied(255, 255, 255, 215));\n                let mut x = x0;\n                for g in gs {\n                    let w = glyphs::width(&p, &sp.into(), *g, &style, *size);\n                    glyphs::draw(&p, &sp.into(), [x, pos[1]], *g, &style, *size);\n                    x += w + 10.0;\n                }\n                if !label.is_empty() {\n                    text(&p, &sp, [x + 4.0, pos[1] - 4.0], (*size).max(MIN_BODY), c(INK), 0, false, label, 0.0);\n                }\n            }\n            Ui::WorldPrompt { at, glyph, label } => {\n                let v = vp * Vec4::new(at[0], at[1], at[2], 1.0);\n                if v.w <= 0.0 {\n                    continue;\n                }\n                let n = v.truncate() / v.w;\n                let wx = (n.x * 0.5 + 0.5) * sp.size.x;\n                let wy = (0.5 - n.y * 0.5) * sp.size.y;\n                let x = (wx - sp.ox) / sp.k;\n                let y = (wy - sp.oy) / sp.k;\n                let sz = 42.0;\n                let gw = glyphs::width(&p, &sp.into(), *glyph, &style, sz);\n                let lw = width(&p, &sp, sz, false, label);\n                let tw = gw + 14.0 + lw;\n                let x0 = (x - tw * 0.5).clamp(30.0, 1890.0 - tw);\n                let bar = sp.r([x0 - 22.0, y - 12.0, x0 + tw + 22.0, y + 66.0]);\n                p.rect_filled(bar, sp.s(30.0), Color32::from_rgba_unmultiplied(255, 255, 255, 235));\n                p.rect_stroke(bar, sp.s(30.0), Stroke::new(sp.s(4.0), c(TEAL)), StrokeKind::Inside);\n                glyphs::draw(&p, &sp.into(), [x0, y], *glyph, &style, sz);\n                text(&p, &sp, [x0 + gw + 14.0, y - 4.0], sz, c(INK), 0, false, label, 0.0);\n            }\n            Ui::Puck { center, r, dot, ring, band, stars, trace } => {\n                let ct = sp.p(*center);\n                let rad = sp.s(*r);\n                p.circle(ct + vec2(0.0, sp.s(8.0)), rad, Color32::from_rgba_unmultiplied(38, 62, 84, 50), Stroke::NONE);\n                p.circle(ct, rad, c(DECK), Stroke::new(sp.s(8.0), c(INK)));\n                if let Some(h) = band {\n                    let w = rad * h;\n                    p.rect_filled(Rect::from_center_size(ct, vec2(w * 2.0, rad * 1.9)), rad * 0.1, Color32::from_rgba_unmultiplied(120, 220, 170, 110));\n                }\n                let u = |d: [f32; 2]| ct + vec2(d[0], -d[1]) * rad;\n                if let Some((at, rr)) = ring {\n                    p.circle(u(*at), rad * rr, Color32::from_rgba_unmultiplied(120, 220, 170, 90), Stroke::new(sp.s(8.0), c(MINT)));\n                }\n                p.line_segment([ct - vec2(rad * 0.08, 0.0), ct + vec2(rad * 0.08, 0.0)], Stroke::new(sp.s(3.0), c(MUTED)));\n                p.line_segment([ct - vec2(0.0, rad * 0.08), ct + vec2(0.0, rad * 0.08)], Stroke::new(sp.s(3.0), c(MUTED)));\n                for w in trace.windows(2) {\n                    p.line_segment([u(w[0]), u(w[1])], Stroke::new(sp.s(3.0), Color32::from_rgba_unmultiplied(255, 120, 110, 120)));\n                }\n                p.circle(u(*dot), sp.s(26.0), c(CORAL), Stroke::new(sp.s(5.0), c(WHITE)));\n                for s in 0..*stars {\n                    let a = -std::f32::consts::FRAC_PI_2 + s as f32 * 0.7 - (*stars as f32 - 1.0) * 0.35;\n                    star(&p, ct + vec2(a.cos(), a.sin()) * (rad + sp.s(30.0)), sp.s(24.0), c(SUN));\n                }\n            }\n            Ui::Stars { pos, size, n, of } => {\n                for s in 0..*of {\n                    let x = pos[0] + (s as f32 - (*of as f32 - 1.0) * 0.5) * size * 2.2;\n                    star(&p, sp.p([x, pos[1]]), sp.s(*size), if s < *n { c(SUN) } else { c(PALE) });\n                }\n            }\n            Ui::Bar { rect, frac, color, marker } => {\n                let r = sp.r(*rect);\n                let rad = r.height().min(r.width()) * 0.5;\n                p.rect_filled(r, rad, c(PALE));\n                if marker.is_none() {\n                    let mut on = r;\n                    on.set_width(r.width() * frac.clamp(0.0, 1.0));\n                    p.rect_filled(on, rad, c(*color));\n                } else if let Some(m) = marker {\n                    // A vertical scroll bar.\n                    let h = r.height() * 0.25;\n                    let top = r.min.y + (r.height() - h) * m;\n                    p.rect_filled(Rect::from_min_size(pos2(r.min.x, top), vec2(r.width(), h)), rad, c(*color));\n                }\n            }\n            Ui::Circle { c: center, r, fill, stroke, width } => {\n                p.circle(sp.p(*center), sp.s(*r), c(*fill), Stroke::new(sp.s(*width), c(*stroke)));\n            }\n            Ui::Line { a, b, width, color } => {\n                p.line_segment([sp.p(*a), sp.p(*b)], Stroke::new(sp.s(*width), c(*color)));\n            }\n        }\n    }\n    let _ = (Align2::LEFT_TOP, Vec3::ZERO);\n    out\n}\n\nfn track_of(r: Rect) -> Rect {\n    let h = (r.height() * 0.2).max(4.0);\n    let w = r.width() * 0.34;\n    let x = r.max.x - w - r.width() * 0.04;\n    Rect::from_min_size(pos2(x, r.center().y + h * 0.5), vec2(w, h))\n}\n\npub mod glyphs {\n    //! PlayStation, Xbox and keyboard-and-mouse prompts, drawn with the painter. One function says\n    //! what a prompt shows: `prompt(action, device, xbox)`.\n\n    use super::*;\n\n    #[derive(Clone, Copy, Debug)]\n    pub struct Style {\n        pub device: Device,\n        pub mouse: bool,\n        pub xbox: bool,\n    }\n\n    #[derive(Clone, Copy, Debug)]\n    pub struct Sp {\n        pub(super) k: f32,\n        pub(super) ox: f32,\n        pub(super) oy: f32,\n    }\n\n    impl From<Space> for Sp {\n        fn from(s: Space) -> Self {\n            Sp { k: s.k, ox: s.ox, oy: s.oy }\n        }\n    }\n\n    /// What a prompt shows.\n    #[derive(Clone, Debug, PartialEq, Eq)]\n    pub enum Shown {\n        /// A round face button: its shape (or Xbox letter) and colour.\n        Cross,\n        Circle,\n        Square,\n        Triangle,\n        Letter(&'static str, [u8; 3]),\n        /// A shoulder or menu pill, a stick or D-pad, a keycap.\n        Pill(&'static str),\n        Stick(&'static str),\n        Key(&'static str),\n        /// A little mouse: left button, right button, both, or movement.\n        Mouse(u8),\n    }\n\n    /// The one mapping from action, device and glyph setting to what is shown.\n    pub fn prompt(g: Glyph, device: Device, mouse: bool, xbox: bool) -> Shown {\n        use Shown::*;\n        match device {\n            Device::KeyboardMouse | Device::Touch => {\n                if mouse {\n                    match g {\n                        Glyph::Confirm | Glyph::StepL => return Mouse(0),\n                        Glyph::Back | Glyph::StepR => return Mouse(1),\n                        Glyph::Brace => return Mouse(2),\n                        Glyph::Lean => return Mouse(3),\n                        Glyph::Move => return Mouse(0),\n                        Glyph::Camera => return Mouse(1),\n                        _ => {}\n                    }\n                }\n                match g {\n                    Glyph::Confirm => Key(\"Space\"),\n                    Glyph::Back => Key(\"Esc\"),\n                    Glyph::Wave => Key(\"F\"),\n                    Glyph::Schedule => Key(\"Tab\"),\n                    Glyph::Pause => Key(\"Esc\"),\n                    Glyph::StepL => Key(\"Q\"),\n                    Glyph::StepR => Key(\"E\"),\n                    Glyph::Brace => Key(\"Q + E\"),\n                    Glyph::Lean | Glyph::Move => Key(\"W A S D\"),\n                    Glyph::Camera => Mouse(1),\n                    Glyph::Tabs => Key(\"Q  E\"),\n                    Glyph::Jog => Key(\"Shift\"),\n                }\n            }\n            Device::Gamepad => match (g, xbox) {\n                (Glyph::Confirm, false) => Cross,\n                (Glyph::Confirm, true) => Letter(\"A\", [0x5c, 0xb8, 0x5c]),\n                (Glyph::Back, false) => Circle,\n                (Glyph::Back, true) => Letter(\"B\", [0xe0, 0x5a, 0x4f]),\n                (Glyph::Wave, false) => Square,\n                (Glyph::Wave, true) => Letter(\"X\", [0x4f, 0x8f, 0xe0]),\n                (Glyph::Schedule, false) => Triangle,\n                (Glyph::Schedule, true) => Letter(\"Y\", [0xe6, 0xc0, 0x3c]),\n                (Glyph::Pause, false) => Pill(\"Options\"),\n                (Glyph::Pause, true) => Pill(\"Menu\"),\n                (Glyph::StepL, false) => Pill(\"L1\"),\n                (Glyph::StepL, true) => Pill(\"LB\"),\n                (Glyph::StepR, false) => Pill(\"R1\"),\n                (Glyph::StepR, true) => Pill(\"RB\"),\n                (Glyph::Brace, false) => Pill(\"L1 + R1\"),\n                (Glyph::Brace, true) => Pill(\"LB + RB\"),\n                (Glyph::Tabs, false) => Pill(\"L1  R1\"),\n                (Glyph::Tabs, true) => Pill(\"LB  RB\"),\n                (Glyph::Jog, false) => Pill(\"R2\"),\n                (Glyph::Jog, true) => Pill(\"RT\"),\n                (Glyph::Lean | Glyph::Move, _) => Stick(\"L\"),\n                (Glyph::Camera, _) => Stick(\"R\"),\n            },\n        }\n    }\n\n    fn fnt(sp: &Sp, s: f32) -> FontId {\n        FontId::new(s * sp.k, FontFamily::Name(BODY_FONT.into()))\n    }\n\n    fn tw(p: &Painter, sp: &Sp, s: &str, size: f32) -> f32 {\n        p.layout_no_wrap(s.to_string(), fnt(sp, size), Color32::WHITE).size().x / sp.k.max(1e-3)\n    }\n\n    pub fn width(p: &Painter, sp: &Sp, g: Glyph, st: &Style, size: f32) -> f32 {\n        match prompt(g, st.device, st.mouse, st.xbox) {\n            Shown::Key(s) | Shown::Pill(s) => tw(p, sp, s, size * 0.8) + size * 0.8,\n            _ => size * 1.3,\n        }\n    }\n\n    pub fn draw(p: &Painter, sp: &Sp, at: [f32; 2], g: Glyph, st: &Style, size: f32) {\n        let s = size * 1.3;\n        let pt = |x: f32, y: f32| pos2(sp.ox + x * sp.k, sp.oy + y * sp.k);\n        let center = pt(at[0] + s * 0.5, at[1] + s * 0.5);\n        let r = s * 0.5 * sp.k;\n        let ink = Color32::from_rgb(0x26, 0x3e, 0x54);\n        let centered = |t: &str, c0: Pos2, col: Color32, size: f32| {\n            p.text(c0, Align2::CENTER_CENTER, t, fnt(sp, size), col);\n        };\n        match prompt(g, st.device, st.mouse, st.xbox) {\n            Shown::Cross | Shown::Circle | Shown::Square | Shown::Triangle => {\n                p.circle_filled(center, r, ink);\n                let stroke = |col: [u8; 3]| Stroke::new(r * 0.16, Color32::from_rgb(col[0], col[1], col[2]));\n                let m = r * 0.48;\n                match prompt(g, st.device, st.mouse, st.xbox) {\n                    Shown::Cross => {\n                        let st0 = stroke([0x8f, 0xb8, 0xee]);\n                        p.line_segment([center + vec2(-m, -m), center + vec2(m, m)], st0);\n                        p.line_segment([center + vec2(-m, m), center + vec2(m, -m)], st0);\n                    }\n                    Shown::Circle => {\n                        p.circle_stroke(center, m, stroke([0xf0, 0x8a, 0x90]));\n                    }\n                    Shown::Square => {\n                        p.rect_stroke(Rect::from_center_size(center, vec2(m * 1.7, m * 1.7)), 0.0, stroke([0xd9, 0x9a, 0xd9]), StrokeKind::Middle);\n                    }\n                    _ => {\n                        let a = center + vec2(0.0, -m * 1.05);\n                        let b = center + vec2(m, m * 0.8);\n                        let c0 = center + vec2(-m, m * 0.8);\n                        let t = stroke([0x6e, 0xd6, 0xb0]);\n                        p.line_segment([a, b], t);\n                        p.line_segment([b, c0], t);\n                        p.line_segment([c0, a], t);\n                    }\n                }\n            }\n            Shown::Letter(l, col) => {\n                p.circle_filled(center, r, Color32::from_rgb(col[0], col[1], col[2]));\n                centered(l, center, Color32::WHITE, size * 0.86);\n            }\n            Shown::Pill(t) => {\n                let w = tw(p, sp, t, size * 0.8) + size * 0.8;\n                let rc = Rect::from_min_size(pt(at[0], at[1] + s * 0.08), vec2(w * sp.k, s * 0.84 * sp.k));\n                p.rect_filled(rc, r * 0.7, ink);\n                centered(t, rc.center(), Color32::WHITE, size * 0.8);\n            }\n            Shown::Key(t) => {\n                let w = tw(p, sp, t, size * 0.8) + size * 0.8;\n                let rc = Rect::from_min_size(pt(at[0], at[1] + s * 0.06), vec2(w * sp.k, s * 0.84 * sp.k));\n                p.rect_filled(rc.translate(vec2(0.0, r * 0.14)), r * 0.3, ink);\n                p.rect_filled(rc, r * 0.3, Color32::WHITE);\n                p.rect_stroke(rc, r * 0.3, Stroke::new(r * 0.08, ink), StrokeKind::Inside);\n                centered(t, rc.center(), ink, size * 0.8);\n            }\n            Shown::Stick(t) => {\n                p.circle_filled(center, r, ink);\n                p.circle_stroke(center, r * 0.68, Stroke::new(r * 0.1, Color32::WHITE));\n                centered(t, center, Color32::WHITE, size * 0.62);\n            }\n            Shown::Mouse(b) => {\n                let rc = Rect::from_center_size(center, vec2(r * 1.3, r * 1.9));\n                p.rect_filled(rc, r * 0.6, Color32::WHITE);\n                let teal = Color32::from_rgb(0x46, 0xbe, 0xc8);\n                let half = |left: bool| Rect::from_min_size(if left { rc.min } else { pos2(rc.center().x, rc.min.y) }, vec2(rc.width() * 0.5, rc.height() * 0.44));\n                if b == 0 || b == 2 {\n                    p.rect_filled(half(true), r * 0.3, teal);\n                }\n                if b == 1 || b == 2 {\n                    p.rect_filled(half(false), r * 0.3, teal);\n                }\n                if b == 3 {\n                    p.circle_filled(center, r * 0.22, teal);\n                }\n                p.rect_stroke(rc, r * 0.6, Stroke::new(r * 0.1, ink), StrokeKind::Inside);\n                p.line_segment([pos2(rc.center().x, rc.min.y), pos2(rc.center().x, rc.min.y + rc.height() * 0.44)], Stroke::new(r * 0.07, ink));\n            }\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::glyphs::*;\n    use super::*;\n\n    #[test]\n    fn prompts_follow_device_and_setting() {\n        assert_eq!(prompt(Glyph::Confirm, Device::Gamepad, false, false), Shown::Cross);\n        assert_eq!(prompt(Glyph::Back, Device::Gamepad, false, false), Shown::Circle);\n        assert_eq!(prompt(Glyph::Wave, Device::Gamepad, false, false), Shown::Square);\n        assert_eq!(prompt(Glyph::Schedule, Device::Gamepad, false, false), Shown::Triangle);\n        assert_eq!(prompt(Glyph::Confirm, Device::Gamepad, false, true), Shown::Letter(\"A\", [0x5c, 0xb8, 0x5c]));\n        assert_eq!(prompt(Glyph::StepL, Device::Gamepad, false, false), Shown::Pill(\"L1\"));\n        assert_eq!(prompt(Glyph::StepL, Device::Gamepad, false, true), Shown::Pill(\"LB\"));\n        assert_eq!(prompt(Glyph::Confirm, Device::KeyboardMouse, false, false), Shown::Key(\"Space\"));\n        assert_eq!(prompt(Glyph::Confirm, Device::KeyboardMouse, true, false), Shown::Mouse(0));\n        assert_eq!(prompt(Glyph::Back, Device::KeyboardMouse, true, true), Shown::Mouse(1));\n    }\n\n    #[test]\n    fn a_frame_draws_and_reports_the_pointer() {\n        let ctx = egui::Context::default();\n        install_fonts(&ctx);\n        let frame = UiFrame {\n            items: vec![Ui::Button { id: 3, rect: [100.0, 100.0, 900.0, 200.0], label: \"Resume\".into(), sub: String::new(), focused: true, stars: -1, value: String::new(), fill: None, big: false }],\n            ..Default::default()\n        };\n        let mut first = true;\n        let mut got = Out::default();\n        for pass in 0..3 {\n            let mut events = vec![egui::Event::PointerMoved(pos2(250.0, 75.0 + pass as f32))];\n            if pass == 2 {\n                events.push(egui::Event::PointerButton { pos: pos2(250.0, 75.0), button: egui::PointerButton::Primary, pressed: true, modifiers: Default::default() });\n                events.push(egui::Event::PointerButton { pos: pos2(250.0, 75.0), button: egui::PointerButton::Primary, pressed: false, modifiers: Default::default() });\n            }\n            let raw = egui::RawInput { screen_rect: Some(Rect::from_min_size(Pos2::ZERO, vec2(960.0, 540.0))), events, ..Default::default() };\n            let _ = ctx.run_ui(raw, |ui| {\n                got = draw(ui.ctx(), &frame, Device::KeyboardMouse, false, Mat4::IDENTITY);\n            });\n            first = false;\n        }\n        assert!(!first);\n        assert_eq!(got.rects.len(), 1);\n        assert!(got.over);\n    }\n}\nRS\npython3 - <<'PY'\np='crates/pav_ui/src/lib.rs'\ns=open(p).read()\ns=s.replace('pub mod arpg_ui;\\n','pub mod arpg_ui;\\npub mod fit_ui;\\n')\nopen(p,'w').write(s)\np='crates/pav_ui/src/headless.rs'\ns=open(p).read()\ns=s.replace('''    /// What the player gave by clicking (`Input::click`).\n    pub commands: Vec<GameCmd>,\n}''','''    /// What the player gave by clicking (`Input::click`).\n    pub commands: Vec<GameCmd>,\n    /// A `games::fit` frame's pointer report.\n    pub fit: Option<crate::fit_ui::Out>,\n}''')\ns=s.replace('''        let ctx = egui::Context::default();\n        let touch = self.device == Device::Touch;''','''        let ctx = egui::Context::default();\n        // Before the first pass: a font family used in the pass that installs it panics.\n        if hud_lines.fit.is_some() {\n            crate::fit_ui::install_fonts(&ctx);\n        }\n        let mut fit_out = None;\n        let touch = self.device == Device::Touch;''')\ns=s.replace('''                crate::game_lines(&ctx, hud_lines);\n''','''                crate::game_lines(&ctx, hud_lines);\n                if let Some(f) = &hud_lines.fit {\n                    fit_out = Some(crate::fit_ui::draw(&ctx, f, self.device, false, vp));\n                }\n''')\ns=s.replace('''        Drawn { paint: Paint { primitives, textures, pixels_per_point }, reading, commands }''','''        Drawn { paint: Paint { primitives, textures, pixels_per_point }, reading, commands, fit: fit_out }''')\nopen(p,'w').write(s)\np='crates/pav_core/src/games/fit/ui_model.rs'\ns=open(p).read()\ns=s.replace('''    /// How hard the pad should rumble now (0..1): Eyes Closed.\n    pub rumble: f32,\n}''','''    /// How hard the pad should rumble now (0..1): Eyes Closed.\n    pub rumble: f32,\n    /// Input shaping the host applies: stick dead zone and curve, key rates, mouse range.\n    pub shaping: [f32; 5],\n}''')\nopen(p,'w').write(s)\np='crates/pav_core/src/games/fit/menus.rs'\ns=open(p).read()\ns=s.replace('''            rumble: self.rumble,\n        }''','''            rumble: self.rumble,\n            shaping: {\n                let c = &self.rules.core;\n                [c.stick_deadzone, c.stick_curve, c.key_rate, c.key_return, c.mouse_range]\n            },\n        }''')\nopen(p,'w').write(s)\nPY\nCARGO_BUILD_JOBS=8 cargo test --locked -q -p pav_audio -p pav_ui 2>&1 | grep -E \"^error|^test result|panicked|FAILED|^  -->|error\\[\" -A4 | cut -c1-220 | head -60","description":"Fetch fonts, write the synth, UI drawing and glyphs, and test them","timeout":500000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10101,"cache_read_input_tokens":481881,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10101},"output_tokens":62,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cb437ba7-0477-4143-bb04-ff33f49efd62","uuid":"97e96ca6-82dd-4397-8374-c816336e1519","timestamp":"2026-11-05T06:26:30.124Z","request_id":"req_011CgjJQat5gRn94Ek6o8m8a","wire_tool_inputs":{"toolu_014rJotgk5HuEjkaU9YQ7CmK":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953/engine\n# fonts\nmkdir -p ../notes/fontdl crates/pav_ui/fonts; (cd ../notes/fontdl && npm pack --silent @expo-google-fonts/fredoka @expo-google-fonts/nunito >/dev/null 2>&1; for t in *.tgz; do mkdir -p x_$t; tar xzf $t -C x_$t; done; F1=$(find . -name \"Fredoka_600SemiBold.ttf\" | head -1); F2=$(find . -name \"Nunito_700Bold.ttf\" | head -1); cp \"$F1\" \"$F2\" ../../engine/crates/pav_ui/fonts/); rm -rf ../notes/fontdl; ls -la crates/pav_ui/fonts\ncat > crates/pav_audio/src/music.rs <<'RS'\n//! The sequencer: original songs written by hand as patterns over chord progressions. It runs inside\n//! `Mixer::render`, so timing is sample-accurate and the rhythm clock is the music's own.\n\nuse crate::{Patch, Wave};\n\n/// One line of a song. `steps` holds semitones above the bar's chord root; `R` is a rest.\n#[derive(Clone, Copy)]\npub struct Track {\n    pub patch: Patch,\n    pub steps: &'static [i16],\n    /// Semitone offset of the whole track.\n    pub base: i16,\n    /// Pitched by the chord (false: drums keep their own patch pitch).\n    pub tuned: bool,\n    pub pan: f32,\n    /// Bars the pattern spans before repeating (the step list is divided among them).\n    pub bars: u32,\n}\n\npub const R: i16 = 999;\n\n#[derive(Clone, Copy)]\npub struct Song {\n    pub bpm: f32,\n    pub steps_per_beat: u32,\n    pub beats_per_bar: u32,\n    /// The chord roots, one per bar, in semitones above A (220 Hz).\n    pub chords: &'static [i16],\n    pub tracks: &'static [Track],\n}\n\nconst fn pluck(vol: f32) -> Patch {\n    Patch { attack: 0.003, decay: 0.28, sustain: 0.0, hold: 0.0, release: 0.08, volume: vol, cutoff: 2600.0, cutoff_end: 700.0, ..Patch::new(Wave::Triangle, 220.0) }\n}\nconst fn bass(vol: f32) -> Patch {\n    Patch { attack: 0.004, decay: 0.2, sustain: 0.5, hold: 0.08, release: 0.1, volume: vol, cutoff: 900.0, cutoff_end: 400.0, ..Patch::new(Wave::Triangle, 110.0) }\n}\nconst fn brush(vol: f32) -> Patch {\n    Patch { attack: 0.01, decay: 0.07, release: 0.03, volume: vol, cutoff: 8000.0, cutoff_end: 5000.0, ..Patch::new(Wave::Noise, 1.0) }\n}\nconst fn kick(vol: f32) -> Patch {\n    Patch { freq_end: 46.0, glide: 0.07, attack: 0.001, decay: 0.16, release: 0.02, volume: vol, ..Patch::new(Wave::Sine, 130.0) }\n}\nconst fn clap(vol: f32) -> Patch {\n    Patch { attack: 0.002, decay: 0.09, release: 0.04, volume: vol, cutoff: 5200.0, cutoff_end: 1800.0, ..Patch::new(Wave::Noise, 1.0) }\n}\nconst fn pad(vol: f32) -> Patch {\n    Patch { attack: 1.1, decay: 0.8, sustain: 0.7, hold: 2.4, release: 1.6, volume: vol, cutoff: 500.0, cutoff_end: 1200.0, ..Patch::new(Wave::Saw, 220.0) }\n}\nconst fn bell(vol: f32) -> Patch {\n    Patch { attack: 0.002, decay: 1.2, release: 0.5, volume: vol, ..Patch::new(Wave::Sine, 880.0) }\n}\nconst fn tuba(vol: f32) -> Patch {\n    Patch { attack: 0.03, decay: 0.2, sustain: 0.6, hold: 0.22, release: 0.12, volume: vol, cutoff: 700.0, cutoff_end: 420.0, duty: 0.4, ..Patch::new(Wave::Square, 110.0) }\n}\nconst fn pizz(vol: f32) -> Patch {\n    Patch { attack: 0.002, decay: 0.2, release: 0.06, volume: vol, cutoff: 1100.0, cutoff_end: 300.0, ..Patch::new(Wave::Triangle, 110.0) }\n}\nconst fn stab(vol: f32) -> Patch {\n    Patch { attack: 0.004, decay: 0.12, sustain: 0.0, release: 0.05, volume: vol, cutoff: 2800.0, cutoff_end: 900.0, duty: 0.3, ..Patch::new(Wave::Square, 220.0) }\n}\nconst fn marimba(vol: f32) -> Patch {\n    Patch { attack: 0.001, decay: 0.2, release: 0.05, volume: vol, cutoff: 3500.0, cutoff_end: 1200.0, ..Patch::new(Wave::Triangle, 440.0) }\n}\nconst fn brass(vol: f32) -> Patch {\n    Patch { attack: 0.05, decay: 0.15, sustain: 0.7, hold: 0.3, release: 0.15, volume: vol, cutoff: 1700.0, cutoff_end: 1100.0, ..Patch::new(Wave::Saw, 220.0) }\n}\nconst fn snare(vol: f32) -> Patch {\n    Patch { attack: 0.001, decay: 0.08, release: 0.03, volume: vol, cutoff: 6500.0, cutoff_end: 2800.0, ..Patch::new(Wave::Noise, 1.0) }\n}\n\n/// A shorthand for a track.\nconst fn t(patch: Patch, steps: &'static [i16], base: i16, tuned: bool, pan: f32, bars: u32) -> Track {\n    Track { patch, steps, base, tuned, pan, bars }\n}\n\n// 1 Lobby Bossa: resort lounge, not gym. Nylon-like plucks, brushes, a walking bass.\nconst BOSSA: Song = Song {\n    bpm: 84.0,\n    steps_per_beat: 2,\n    beats_per_bar: 4,\n    chords: &[0, 5, -2, 3, 0, 5, 7, -5],\n    tracks: &[\n        t(bass(0.5), &[0, R, 7, R, 12, R, 7, R], -12, true, 0.0, 1),\n        t(pluck(0.24), &[R, 10, R, R, 3, R, 7, R, R, 10, R, 3, R, R, 7, R], 12, true, -0.3, 2),\n        t(pluck(0.2), &[R, 3, R, R, 7, R, 10, R, R, 7, R, 10, R, R, 14, R], 12, true, 0.3, 2),\n        t(pluck(0.26), &[12, R, 10, 7, R, 3, R, 5, R, R, 7, R, R, R, 3, R, 0, R, 3, 5, R, 7, R, 10, R, R, 12, R, R, R, R, R], 24, true, 0.15, 4),\n        t(brush(0.11), &[0, 0, 0, R, 0, 0, 0, 0], 0, false, -0.2, 1),\n    ],\n};\n// 2 Tide Pad: slow pads and sparse bells, no beat.\nconst TIDEPAD: Song = Song {\n    bpm: 52.0,\n    steps_per_beat: 1,\n    beats_per_bar: 4,\n    chords: &[0, -4, -7, -2],\n    tracks: &[\n        t(pad(0.14), &[0, R, R, R], 0, true, -0.3, 1),\n        t(pad(0.12), &[7, R, R, R], 0, true, 0.3, 1),\n        t(pad(0.1), &[15, R, R, R], 0, true, 0.0, 1),\n        t(bell(0.13), &[R, R, 12, R, R, 19, R, R, R, R, 24, R, R, 15, R, R], 12, true, 0.4, 4),\n        t(bell(0.09), &[R, R, R, R, 7, R, R, R, R, R, R, 19, R, R, R, R, R, 12, R, R, R, R, R, R], 24, true, -0.4, 6),\n    ],\n};\n// 3 Iron Waltz: 3/4, low pizzicato bass and a dignified tuba.\nconst WALTZ: Song = Song {\n    bpm: 108.0,\n    steps_per_beat: 1,\n    beats_per_bar: 3,\n    chords: &[0, 0, 5, 0, 7, 7, 0, 0],\n    tracks: &[\n        t(pizz(0.5), &[0, R, R], -12, true, 0.0, 1),\n        t(pluck(0.14), &[R, 7, 7], 0, true, -0.25, 1),\n        t(pluck(0.12), &[R, 15, 15], 0, true, 0.25, 1),\n        t(tuba(0.34), &[12, 14, 15, 19, R, 15, 14, R, 12, 15, 14, 12, 7, R, R, 12, 14, 15, 19, 22, 24, 19, R, 15, 14, R, 12, 12, R, R], -12, true, 0.0, 10),\n    ],\n};\n// 4 Step Party: 96 BPM funk-pop, clear kick and clap for timing.\nconst PARTY: Song = Song {\n    bpm: 96.0,\n    steps_per_beat: 4,\n    beats_per_bar: 4,\n    chords: &[0, 0, 5, 7],\n    tracks: &[\n        t(kick(0.62), &[0, R, R, R, 0, R, R, R, 0, R, R, R, 0, R, R, R], 0, false, 0.0, 1),\n        t(clap(0.34), &[R, R, R, R, 0, R, R, R, R, R, R, R, 0, R, R, R], 0, false, 0.05, 1),\n        t(brush(0.12), &[R, R, 0, R, R, R, 0, R, R, R, 0, R, R, R, 0, 0], 0, false, -0.2, 1),\n        t(bass(0.46), &[0, R, R, 0, R, R, 12, R, R, 0, R, R, 10, R, 7, R], -12, true, 0.0, 1),\n        t(stab(0.14), &[R, R, 15, R, R, 15, R, R, R, R, 19, R, R, 15, R, R], 12, true, 0.3, 1),\n        t(stab(0.14), &[R, R, 7, R, R, 7, R, R, R, R, 10, R, R, 7, R, R], 12, true, -0.3, 1),\n        t(marimba(0.2), &[R, R, R, R, R, R, R, R, 24, R, 22, R, 19, R, 15, R, R, R, R, R, R, R, R, R, 12, R, 15, R, 19, R, 22, R], 12, true, 0.1, 2),\n    ],\n};\n// 5 Lagoon Mallets: 110 BPM, marimba-like and playful.\nconst LAGOON: Song = Song {\n    bpm: 110.0,\n    steps_per_beat: 2,\n    beats_per_bar: 4,\n    chords: &[0, 3, 5, 3],\n    tracks: &[\n        t(marimba(0.3), &[0, 7, 12, 7, 15, 12, 7, 12, 0, 7, 12, 15, 19, 15, 12, 7], 12, true, -0.2, 2),\n        t(marimba(0.22), &[R, R, 24, R, R, 22, R, 19, R, R, 24, 27, R, 24, R, R], 24, true, 0.3, 2),\n        t(bass(0.4), &[0, R, R, 7, R, R, 5, R], -12, true, 0.0, 1),\n        t(brush(0.08), &[0, R, 0, 0, 0, R, 0, 0], 0, false, 0.2, 1),\n    ],\n};\n// 6 Band of Guests: marching brass and snare.\nconst BAND: Song = Song {\n    bpm: 96.0,\n    steps_per_beat: 4,\n    beats_per_bar: 4,\n    chords: &[0, 5, 7, 0],\n    tracks: &[\n        t(snare(0.2), &[0, R, 0, 0, 0, R, 0, R, 0, R, 0, 0, 0, 0, 0, R], 0, false, -0.15, 1),\n        t(kick(0.5), &[0, R, R, R, R, R, R, R, 0, R, R, R, R, R, R, R], 0, false, 0.0, 1),\n        t(tuba(0.32), &[0, R, R, R, 7, R, R, R, 0, R, R, R, 7, R, R, R], -12, true, 0.0, 1),\n        t(brass(0.16), &[R, R, R, R, 12, R, 15, R, R, R, R, R, 19, R, 15, R], 0, true, 0.3, 1),\n        t(brass(0.13), &[R, R, R, R, 7, R, 12, R, R, R, R, R, 15, R, 12, R], 0, true, -0.3, 1),\n        t(brass(0.2), &[12, R, R, 12, 15, R, R, 19, 24, R, R, R, 22, R, 19, R, 19, R, R, 15, 12, R, R, 15, 19, R, R, R, R, R, R, R], 12, true, 0.1, 2),\n    ],\n};\n\n/// The song for a number. 0 and unknowns: silence. Song 7, the stingers, are one-shot sounds.\npub fn song(id: u8) -> Option<Song> {\n    match id {\n        1 => Some(BOSSA),\n        2 => Some(TIDEPAD),\n        3 => Some(WALTZ),\n        4 => Some(PARTY),\n        5 => Some(LAGOON),\n        6 => Some(BAND),\n        _ => None,\n    }\n}\n\npub const SONG_IDS: [u8; 6] = [1, 2, 3, 4, 5, 6];\n\n/// The sequencer's place in a song.\n#[derive(Clone, Copy)]\npub struct Sequencer {\n    pub song: Song,\n    pub step: u64,\n    /// Samples into the song.\n    pub at: u64,\n    pub next_at: f64,\n}\n\nimpl Sequencer {\n    pub fn new(song: Song) -> Self {\n        Self { song, step: 0, at: 0, next_at: 0.0 }\n    }\n\n    /// Advances one sample; calls `play` for each note due.\n    pub fn tick(&mut self, rate: f32, mut play: impl FnMut(Patch, f32)) {\n        if self.at as f64 >= self.next_at {\n            let s = &self.song;\n            let per_step = 60.0 / (s.bpm as f64 * s.steps_per_beat as f64) * rate as f64;\n            let steps_per_bar = (s.steps_per_beat * s.beats_per_bar) as u64;\n            let bar = (self.step / steps_per_bar) as usize;\n            let root = s.chords[bar % s.chords.len()];\n            for tr in s.tracks {\n                let span = steps_per_bar * tr.bars as u64;\n                let n = tr.steps.len() as u64;\n                // A pattern is spread evenly over its bars.\n                let pos = self.step % span;\n                if pos * n % span != 0 {\n                    continue;\n                }\n                let v = tr.steps[((pos * n / span) % n) as usize];\n                if v == R {\n                    continue;\n                }\n                let mut p = tr.patch;\n                if tr.tuned {\n                    let f = 220.0 * 2f32.powf((root + tr.base + v) as f32 / 12.0);\n                    p.freq = f;\n                    p.freq_end = f;\n                }\n                p.bus = 1;\n                play(p, tr.pan);\n            }\n            self.step += 1;\n            self.next_at += per_step;\n        }\n        self.at += 1;\n    }\n}\nRS\ncat > crates/pav_audio/src/voice.rs <<'RS'\n//! Voices in the Animalese manner: a formant-filtered blip per syllable and a tiny consonant click.\n//! No real words are ever spoken. Each speaker has a base pitch, rate and timbre.\n\nuse crate::{Patch, Wave};\n\n/// Formant pairs (Hz) for five vowels: ah, eh, ee, oh, oo.\npub const FORMANTS: [(f32, f32); 5] = [(800.0, 1200.0), (560.0, 1800.0), (320.0, 2300.0), (500.0, 900.0), (340.0, 800.0)];\n\n/// (base Hz, wave, length s, attack s, click) per speaker: Pip, Posey, Kettle, Bounce, Commodore,\n/// Marjorie, Tom, the Twins, a guest.\nconst SPEAKERS: [(f32, Wave, f32, f32, f32); 9] = [\n    (430.0, Wave::Saw, 0.075, 0.006, 0.05),\n    (250.0, Wave::Triangle, 0.1, 0.002, 0.16),\n    (92.0, Wave::Saw, 0.14, 0.015, 0.04),\n    (560.0, Wave::Saw, 0.05, 0.004, 0.05),\n    (360.0, Wave::Square, 0.06, 0.002, 0.1),\n    (290.0, Wave::Saw, 0.09, 0.01, 0.04),\n    (170.0, Wave::Saw, 0.09, 0.01, 0.05),\n    (380.0, Wave::Saw, 0.07, 0.005, 0.04),\n    (240.0, Wave::Saw, 0.08, 0.008, 0.04),\n];\n\npub fn syllable(speaker: u8, vowel: u8, pitch: f32) -> Vec<(Patch, f32)> {\n    let (base, wave, len, attack, click) = SPEAKERS[speaker as usize % SPEAKERS.len()];\n    let (f1, f2) = FORMANTS[vowel as usize % FORMANTS.len()];\n    let f = base * pitch;\n    // Rubber on Pip: the pitch slides up through the blip.\n    let end = if speaker == 0 { f * 1.12 } else { f * 0.97 };\n    let body = Patch {\n        freq_end: end,\n        glide: len,\n        attack,\n        decay: len,\n        sustain: 0.0,\n        release: 0.02,\n        volume: 0.5,\n        f1,\n        f2,\n        bus: 2,\n        cutoff: 9000.0,\n        cutoff_end: 6000.0,\n        ..Patch::new(wave, f)\n    };\n    let tick = Patch { attack: 0.0005, decay: 0.012, release: 0.004, volume: click, cutoff: 7000.0, cutoff_end: 3000.0, bus: 2, ..Patch::new(Wave::Noise, 1.0) };\n    vec![(tick, 0.0), (body, 0.004)]\n}\nRS\npython3 - <<'PY'\np='crates/pav_audio/src/lib.rs'\ns=open(p).read()\ns=s.replace('''use std::sync::mpsc::{Receiver, Sender, channel};\n''','''use std::sync::Arc;\nuse std::sync::atomic::{AtomicU64, Ordering};\nuse std::sync::mpsc::{Receiver, Sender, channel};\n''')\ns=s.replace('''use pav_core::SimEvent;\n''','''use pav_core::SimEvent;\n\npub mod music;\npub mod voice;\n''')\ns=s.replace('''    /// Square-wave duty cycle.\n    pub duty: f32,\n}''','''    /// Square-wave duty cycle.\n    pub duty: f32,\n    /// Two parallel band-passes when non-zero: a voice's formants (Hz).\n    pub f1: f32,\n    pub f2: f32,\n    /// 0 sound effects, 1 music, 2 voice.\n    pub bus: u8,\n}''')\ns=s.replace('''            duty: 0.5,\n        }\n    }\n    pub fn length''','''            duty: 0.5,\n            f1: 0.0,\n            f2: 0.0,\n            bus: 0,\n        }\n    }\n    pub fn length''')\ns=s.replace('''    gain_l: f32,\n    gain_r: f32,\n}\n\nimpl Voice {''','''    gain_l: f32,\n    gain_r: f32,\n    /// Formant band-pass states (low, band), one pair per formant.\n    bp: [f32; 4],\n}\n\nimpl Voice {''')\ns=s.replace('''        self.lp += (raw - self.lp) * a;\n        let s = self.lp * self.env() * p.volume;''','''        self.lp += (raw - self.lp) * a;\n        let mut out = self.lp;\n        if p.f1 > 0.0 {\n            // Two state-variable band-passes in parallel.\n            let mut sum = 0.0;\n            for (k, f) in [p.f1, p.f2].into_iter().enumerate() {\n                let g = (std::f32::consts::TAU * f * dt).min(1.4);\n                let q = 0.22;\n                let (low, band) = (self.bp[k * 2], self.bp[k * 2 + 1]);\n                let low = low + g * band;\n                let high = out - low - q * band;\n                let band = band + g * high;\n                self.bp[k * 2] = low;\n                self.bp[k * 2 + 1] = band;\n                sum += band * if k == 0 { 1.0 } else { 0.7 };\n            }\n            out = sum * 0.7;\n        }\n        let s = out * self.env() * p.volume;''')\ns=s.replace('''pub struct Mixer {\n    voices: Vec<Voice>,\n    pub sample_rate: f32,\n    pub master: f32,\n    seed: u32,\n}\n\nconst MAX_VOICES: usize = 64;\n''','''pub struct Mixer {\n    voices: Vec<Voice>,\n    pub sample_rate: f32,\n    pub master: f32,\n    seed: u32,\n    /// Sound effects, music, voice.\n    pub bus: [f32; 3],\n    seq: Option<music::Sequencer>,\n    /// Multiplies the music bus while a fade to silence runs.\n    fade: f32,\n    fading: bool,\n    /// Samples since the song started (read by the rhythm clock).\n    pub clock: Arc<AtomicU64>,\n}\n\nconst MAX_VOICES: usize = 96;\n''')\ns=s.replace('''        Self { voices: Vec::new(), sample_rate, master: 0.8, seed: 0x9e37_79b9 }\n    }\n''','''        Self {\n            voices: Vec::new(),\n            sample_rate,\n            master: 0.8,\n            seed: 0x9e37_79b9,\n            bus: [1.0, 1.0, 1.0],\n            seq: None,\n            fade: 1.0,\n            fading: false,\n            clock: Arc::new(AtomicU64::new(0)),\n        }\n    }\n\n    /// Starts a song from its beginning; 255 fades out over three seconds; 0 stops at once.\n    pub fn set_song(&mut self, id: u8) {\n        if id == 255 {\n            self.fading = true;\n            return;\n        }\n        self.fading = false;\n        self.fade = 1.0;\n        self.voices.retain(|v| v.p.bus != 1);\n        self.seq = music::song(id).map(music::Sequencer::new);\n        self.clock.store(0, Ordering::Relaxed);\n    }\n''')\ns=s.replace('''            gain_l: a.cos() * gain,\n            gain_r: a.sin() * gain,\n        });''','''            gain_l: a.cos() * gain,\n            gain_r: a.sin() * gain,\n            bp: [0.0; 4],\n        });''')\ns=s.replace('''        for frame in out.chunks_mut(2) {\n            let (mut l, mut r) = (0.0, 0.0);\n            for v in &mut self.voices {\n                let s = v.next(dt);\n                l += s * v.gain_l;\n                r += s * v.gain_r;\n            }''','''        for frame in out.chunks_mut(2) {\n            if let Some(mut seq) = self.seq.take() {\n                let rate = self.sample_rate;\n                seq.tick(rate, |p, pan| self.play(p, pan, 1.0, 0.0));\n                self.clock.store(seq.at, Ordering::Relaxed);\n                self.seq = Some(seq);\n            }\n            if self.fading {\n                self.fade = (self.fade - dt / 3.0).max(0.0);\n                if self.fade <= 0.0 {\n                    self.seq = None;\n                }\n            }\n            let (mut l, mut r) = (0.0, 0.0);\n            for v in &mut self.voices {\n                let b = self.bus[(v.p.bus as usize).min(2)] * if v.p.bus == 1 { self.fade } else { 1.0 };\n                let s = v.next(dt) * b;\n                l += s * v.gain_l;\n                r += s * v.gain_r;\n            }''')\ns=s.replace('''        SimEvent::Coin { .. } => vec![''','''        SimEvent::Sfx { id, gain, pitch } => fit_sfx(*id, *gain, *pitch),\n        SimEvent::Syllable { speaker, vowel, pitch } => voice::syllable(*speaker, *vowel, *pitch),\n        SimEvent::Coin { .. } => vec![''')\ns=s.replace('''/// Position of an event (None = not spatial).''','''/// We Stand's sound bank, by number (`pav_core::games::fit::sfx`). Every sound is synthesized.\npub fn fit_sfx(id: u8, gain: f32, pitch: f32) -> Vec<(Patch, f32)> {\n    use Wave::*;\n    use pav_core::games::fit::sfx::*;\n    let mut v: Vec<(Patch, f32)> = match id {\n        MOVE => vec![(Patch { decay: 0.04, volume: 0.1, cutoff: 3000.0, ..Patch::new(Sine, 880.0) }, 0.0)],\n        CONFIRM => vec![(Patch { decay: 0.08, volume: 0.14, ..Patch::new(Triangle, 880.0) }, 0.0), (Patch { decay: 0.12, volume: 0.14, ..Patch::new(Triangle, 1318.0) }, 0.06)],\n        BACK => vec![(Patch { decay: 0.1, volume: 0.13, freq_end: 440.0, glide: 0.1, ..Patch::new(Triangle, 660.0) }, 0.0)],\n        STAMP => vec![(Patch { freq_end: 40.0, glide: 0.1, decay: 0.22, volume: 0.6, ..Patch::new(Sine, 150.0) }, 0.0), (Patch { decay: 0.1, volume: 0.35, cutoff: 1500.0, cutoff_end: 300.0, ..Patch::new(Noise, 1.0) }, 0.0)],\n        GULP => vec![(Patch { freq_end: 90.0, glide: 0.2, attack: 0.02, decay: 0.2, volume: 0.45, ..Patch::new(Sine, 260.0) }, 0.0), (Patch { freq_end: 70.0, glide: 0.2, attack: 0.02, decay: 0.2, volume: 0.4, ..Patch::new(Sine, 200.0) }, 0.2)],\n        TICK => vec![(Patch { decay: 0.025, volume: 0.2, ..Patch::new(Square, 1400.0) }, 0.0)],\n        STEP => vec![(Patch { decay: 0.05, volume: 0.22, cutoff: 1800.0, cutoff_end: 500.0, ..Patch::new(Noise, 1.0) }, 0.0)],\n        SQUEAK => vec![(Patch { freq_end: 1400.0, glide: 0.12, attack: 0.01, decay: 0.14, volume: 0.22, f1: 900.0, f2: 2200.0, ..Patch::new(Saw, 620.0) }, 0.0)],\n        CREAK => vec![(Patch { freq_end: 95.0, glide: 0.4, attack: 0.03, decay: 0.4, volume: 0.2, cutoff: 900.0, duty: 0.1, ..Patch::new(Square, 140.0) }, 0.0)],\n        SPLASH_S => vec![(Patch { attack: 0.01, decay: 0.25, volume: 0.25, cutoff: 3000.0, cutoff_end: 500.0, ..Patch::new(Noise, 1.0) }, 0.0)],\n        SPLASH_B => vec![(Patch { attack: 0.005, decay: 0.7, sustain: 0.2, hold: 0.1, release: 0.7, volume: 0.65, cutoff: 5000.0, cutoff_end: 250.0, ..Patch::new(Noise, 1.0) }, 0.0), (Patch { freq_end: 36.0, glide: 0.3, decay: 0.45, volume: 0.6, ..Patch::new(Sine, 120.0) }, 0.0)],\n        GULL => vec![(Patch { freq_end: 720.0, glide: 0.15, attack: 0.01, decay: 0.2, volume: 0.17, f1: 1100.0, f2: 2600.0, ..Patch::new(Saw, 1100.0) }, 0.0), (Patch { freq_end: 640.0, glide: 0.2, attack: 0.01, decay: 0.26, volume: 0.17, f1: 1100.0, f2: 2600.0, ..Patch::new(Saw, 980.0) }, 0.2)],\n        MURMUR => vec![(Patch { attack: 0.4, decay: 0.6, sustain: 0.5, hold: 0.6, release: 0.7, volume: 0.1, cutoff: 700.0, cutoff_end: 500.0, ..Patch::new(Noise, 1.0) }, 0.0)],\n        CLAP => vec![(Patch { attack: 0.001, decay: 0.07, release: 0.03, volume: 0.3, cutoff: 5000.0, cutoff_end: 1800.0, ..Patch::new(Noise, 1.0) }, 0.0)],\n        GONG => vec![(Patch { attack: 0.004, decay: 1.8, release: 0.6, volume: 0.28, ..Patch::new(Sine, 160.0) }, 0.0), (Patch { attack: 0.004, decay: 1.2, volume: 0.14, ..Patch::new(Sine, 437.0) }, 0.0), (Patch { attack: 0.004, decay: 0.7, volume: 0.08, ..Patch::new(Sine, 1011.0) }, 0.0)],\n        BELL => vec![(Patch { attack: 0.002, decay: 0.8, release: 0.2, volume: 0.22, ..Patch::new(Sine, 660.0) }, 0.0), (Patch { attack: 0.002, decay: 0.4, volume: 0.1, ..Patch::new(Sine, 1660.0) }, 0.0)],\n        WHOOSH => vec![(Patch { attack: 0.08, decay: 0.25, volume: 0.22, cutoff: 700.0, cutoff_end: 4200.0, ..Patch::new(Noise, 1.0) }, 0.0)],\n        ROLL => vec![(Patch { attack: 0.01, decay: 0.09, volume: 0.1, cutoff: 900.0, cutoff_end: 500.0, ..Patch::new(Noise, 1.0) }, 0.0)],\n        PLOP => vec![(Patch { freq_end: 900.0, glide: 0.1, decay: 0.12, volume: 0.3, ..Patch::new(Sine, 260.0) }, 0.0)],\n        GLASS => vec![(Patch { decay: 0.3, volume: 0.15, ..Patch::new(Sine, 2100.0) }, 0.0), (Patch { freq_end: 700.0, glide: 0.12, decay: 0.15, volume: 0.3, ..Patch::new(Sine, 300.0) }, 0.25)],\n        POP => vec![(Patch { freq_end: 1100.0, glide: 0.04, decay: 0.05, volume: 0.3, ..Patch::new(Sine, 420.0) }, 0.0), (Patch { decay: 0.04, volume: 0.1, ..Patch::new(Noise, 1.0) }, 0.0)],\n        GUST => vec![(Patch { attack: 0.4, decay: 0.9, release: 0.5, volume: 0.22, cutoff: 500.0, cutoff_end: 1500.0, ..Patch::new(Noise, 1.0) }, 0.0)],\n        WAVE => vec![(Patch { attack: 0.2, decay: 0.8, release: 0.4, volume: 0.32, cutoff: 1700.0, cutoff_end: 500.0, ..Patch::new(Noise, 1.0) }, 0.0)],\n        SEA => vec![(Patch { attack: 1.4, decay: 1.8, release: 1.4, volume: 0.07, cutoff: 900.0, cutoff_end: 500.0, ..Patch::new(Noise, 1.0) }, 0.0)],\n        TONE => vec![(Patch { attack: 0.01, decay: 0.15, release: 0.03, volume: 0.22, ..Patch::new(Sine, 440.0) }, 0.0)],\n        CHIME => vec![(Patch { attack: 0.002, decay: 0.7, release: 0.2, volume: 0.22, ..Patch::new(Sine, 880.0) }, 0.0), (Patch { attack: 0.002, decay: 0.35, volume: 0.09, ..Patch::new(Sine, 1760.0) }, 0.0)],\n        STAR => vec![(Patch { decay: 0.3, volume: 0.18, ..Patch::new(Triangle, 1046.0) }, 0.0)],\n        GROAN => vec![(Patch { freq_end: 90.0, glide: 0.8, attack: 0.15, decay: 0.8, release: 0.3, volume: 0.17, f1: 450.0, f2: 900.0, ..Patch::new(Saw, 150.0) }, 0.0), (Patch { freq_end: 110.0, glide: 0.8, attack: 0.15, decay: 0.8, release: 0.3, volume: 0.15, f1: 500.0, f2: 1000.0, ..Patch::new(Saw, 185.0) }, 0.05)],\n        CHEER => vec![(Patch { attack: 0.15, decay: 1.1, release: 0.5, volume: 0.25, cutoff: 3200.0, cutoff_end: 1500.0, ..Patch::new(Noise, 1.0) }, 0.0)],\n        BURP => vec![(Patch { freq_end: 60.0, glide: 0.3, attack: 0.02, decay: 0.3, volume: 0.45, f1: 500.0, f2: 900.0, ..Patch::new(Saw, 95.0) }, 0.35)],\n        BOING => vec![(Patch { freq_end: 460.0, glide: 0.16, decay: 0.2, volume: 0.25, ..Patch::new(Sine, 150.0) }, 0.0)],\n        WOOD => vec![(Patch { decay: 0.05, volume: 0.32, cutoff: 3200.0, ..Patch::new(Square, 760.0) }, 0.0), (Patch { decay: 0.05, volume: 0.2, ..Patch::new(Square, 540.0) }, 0.08)],\n        PERFECT => vec![(Patch { decay: 0.14, volume: 0.13, ..Patch::new(Triangle, 1568.0) }, 0.0)],\n        GOOD => vec![(Patch { decay: 0.1, volume: 0.11, ..Patch::new(Triangle, 1046.0) }, 0.0)],\n        COUNT => vec![(Patch { decay: 0.14, volume: 0.2, ..Patch::new(Square, 660.0) }, 0.0)],\n        GO => vec![(Patch { decay: 0.4, volume: 0.22, ..Patch::new(Square, 1320.0) }, 0.0)],\n        FANFARE => vec![\n            (Patch { decay: 0.14, volume: 0.17, ..Patch::new(Triangle, 523.0) }, 0.0),\n            (Patch { decay: 0.14, volume: 0.17, ..Patch::new(Triangle, 659.0) }, 0.11),\n            (Patch { decay: 0.14, volume: 0.17, ..Patch::new(Triangle, 784.0) }, 0.22),\n            (Patch { decay: 0.5, volume: 0.2, ..Patch::new(Triangle, 1047.0) }, 0.33),\n        ],\n        REVEAL => vec![(Patch { attack: 0.4, decay: 2.4, release: 0.3, volume: 0.1, freq_end: 880.0, glide: 2.8, ..Patch::new(Saw, 110.0) }, 0.0)],\n        _ => Vec::new(),\n    };\n    for (p, _) in &mut v {\n        p.volume *= gain;\n        p.freq *= pitch;\n        p.freq_end *= pitch;\n    }\n    v\n}\n\n/// Position of an event (None = not spatial).''')\ns=s.replace('''pub fn play_event(mixer: &mut Mixer, ev: &SimEvent, l: &Listener, sfx: f32) {\n    let (pan, gain)''','''pub fn play_event(mixer: &mut Mixer, ev: &SimEvent, l: &Listener, sfx: f32) {\n    if let SimEvent::Music { song } = ev {\n        mixer.set_song(*song);\n        return;\n    }\n    let (pan, gain)''')\ns=s.replace('''enum Cmd {\n    Play(Patch, f32, f32, f32),\n    Master(f32),\n}''','''enum Cmd {\n    Play(Patch, f32, f32, f32),\n    Master(f32),\n    Song(u8),\n    Bus([f32; 3]),\n}''')\ns=s.replace('''    tx: Sender<Cmd>,\n    pub sample_rate: u32,\n    pub device: String,\n}''','''    tx: Sender<Cmd>,\n    pub sample_rate: u32,\n    pub device: String,\n    clock: Arc<AtomicU64>,\n}''')\ns=s.replace('''        let config: cpal::StreamConfig = supported.config();\n        let rate = config.sample_rate as u32;''','''        let mut config: cpal::StreamConfig = supported.config();\n        // Snappier effects in the browser: half cpal's default buffer there.\n        #[cfg(target_arch = \"wasm32\")]\n        {\n            config.buffer_size = cpal::BufferSize::Fixed(1024);\n        }\n        let rate = config.sample_rate as u32;\n        let clock = Arc::new(AtomicU64::new(0));''')\ns=s.replace('''            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels)?,\n            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels)?,\n            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels)?,''','''            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels, clock.clone())?,\n            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels, clock.clone())?,\n            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels, clock.clone())?,''')\ns=s.replace('''        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name })\n    }\n\n    pub fn play_event(&self, ev: &SimEvent, l: &Listener, sfx: f32) {\n        let (pan, gain)''','''        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name, clock })\n    }\n\n    /// Seconds since the song started, by the samples rendered.\n    pub fn song_seconds(&self) -> f32 {\n        self.clock.load(Ordering::Relaxed) as f32 / self.sample_rate.max(1) as f32\n    }\n\n    pub fn set_buses(&self, bus: [f32; 3]) {\n        let _ = self.tx.send(Cmd::Bus(bus));\n    }\n\n    pub fn play_event(&self, ev: &SimEvent, l: &Listener, sfx: f32) {\n        if let SimEvent::Music { song } = ev {\n            let _ = self.tx.send(Cmd::Song(*song));\n            return;\n        }\n        let (pan, gain)''')\ns=s.replace('''fn build<T>(device: &cpal::Device, config: cpal::StreamConfig, rx: Receiver<Cmd>, channels: usize) -> anyhow::Result<cpal::Stream>''','''fn build<T>(\n    device: &cpal::Device,\n    config: cpal::StreamConfig,\n    rx: Receiver<Cmd>,\n    channels: usize,\n    clock: Arc<AtomicU64>,\n) -> anyhow::Result<cpal::Stream>''')\ns=s.replace('''    let mut mixer = Mixer::new(config.sample_rate as f32);\n    let mut buf: Vec<f32> = Vec::new();''','''    let mut mixer = Mixer::new(config.sample_rate as f32);\n    mixer.clock = clock;\n    let mut buf: Vec<f32> = Vec::new();''')\ns=s.replace('''                    Cmd::Master(v) => mixer.master = v,\n''','''                    Cmd::Master(v) => mixer.master = v,\n                    Cmd::Song(id) => mixer.set_song(id),\n                    Cmd::Bus(b) => mixer.bus = b,\n''')\ns=s.replace('''    #[test]\n    fn explosion_is_loud_then_silent() {''','''    fn rms(buf: &[f32]) -> f32 {\n        (buf.iter().map(|s| s * s).sum::<f32>() / buf.len().max(1) as f32).sqrt()\n    }\n\n    fn song_rms(id: u8, music: f32, seconds: f32) -> f32 {\n        let mut m = Mixer::new(24000.0);\n        m.bus = [1.0, music, 1.0];\n        m.set_song(id);\n        let mut out = vec![0.0; (seconds * 24000.0) as usize * 2];\n        m.render(&mut out);\n        rms(&out)\n    }\n\n    #[test]\n    fn every_song_sounds_and_music_at_ten_percent_is_a_tenth() {\n        for id in music::SONG_IDS {\n            let full = song_rms(id, 1.0, 12.0);\n            assert!(full > 0.005, \"song {id} is silent: {full}\");\n            let low = song_rms(id, 0.1, 12.0);\n            // The soft clip bends a loud full-scale mix a little.\n            let ratio = low / full;\n            assert!((0.08..0.135).contains(&ratio), \"song {id}: {ratio}\");\n        }\n    }\n\n    #[test]\n    fn every_sfx_sounds_and_speakers_differ() {\n        for id in 1..=pav_core::games::fit::sfx::LAST {\n            let ev = SimEvent::Sfx { id, gain: 1.0, pitch: 1.0 };\n            let out = render_events(&[(0.0, ev)], 3.0, 24000.0, &Listener::default());\n            let peak = out.iter().fold(0.0f32, |m, s| m.max(s.abs()));\n            assert!(peak > 0.01, \"sfx {id} is silent: {peak}\");\n        }\n        let voice = |speaker: u8| {\n            let ev = SimEvent::Syllable { speaker, vowel: 0, pitch: 1.0 };\n            render_events(&[(0.0, ev)], 0.3, 24000.0, &Listener::default())\n        };\n        for s in 0..9 {\n            assert!(rms(&voice(s)) > 0.001, \"speaker {s} is silent\");\n        }\n        // Crossings count how high a voice is: Pip above Kettle.\n        let cross = |b: &[f32]| b.windows(2).step_by(2).filter(|w| w[0] * w[1] < 0.0).count();\n        assert!(voice(0) != voice(2));\n        assert!(cross(&voice(0)) != cross(&voice(2)));\n    }\n\n    #[test]\n    fn the_music_clock_counts_and_fades_to_silence() {\n        let mut m = Mixer::new(24000.0);\n        m.set_song(4);\n        let mut out = vec![0.0; 24000 * 2];\n        m.render(&mut out);\n        assert_eq!(m.clock.load(Ordering::Relaxed), 24000);\n        m.set_song(255);\n        let mut out = vec![0.0; 24000 * 8];\n        m.render(&mut out);\n        let tail = rms(&out[out.len() - 12000..]);\n        assert!(tail < 1e-3, \"faded: {tail}\");\n    }\n\n    #[test]\n    fn explosion_is_loud_then_silent() {''')\nopen(p,'w').write(s)\nPY\ncat > crates/pav_ui/src/fit_ui.rs <<'RS'\n//! Draws a `UiFrame`, on any screen: the frame is in a 1920x1080 space, scaled by\n//! `min(w/1920, h/1080)` and centred, so a hub's small frame gets the same screen. Reports what the\n//! pointer did to its items. Holds no state: everything shown comes from the sim.\n\nuse std::sync::Arc;\n\nuse egui::{Align2, Color32, FontData, FontDefinitions, FontFamily, FontId, Painter, Pos2, Rect, Shape, Stroke, StrokeKind, pos2, vec2};\nuse glam::{Mat4, Vec3, Vec4};\nuse pav_core::games::fit::ui_model::*;\n\nuse crate::Device;\n\n/// What the pointer did this frame.\n#[derive(Clone, Debug, Default)]\npub struct Out {\n    pub hover: Option<u16>,\n    pub click: Option<u16>,\n    pub slider: Option<(u16, f32)>,\n    /// Item rects, in window points, for the page's tests.\n    pub rects: Vec<(u16, [f32; 4])>,\n    /// The pointer is on an item, so a press there is not for the world.\n    pub over: bool,\n}\n\npub const TITLE_FONT: &str = \"fit_title\";\npub const BODY_FONT: &str = \"fit_body\";\n\n/// Puts the game's fonts in. A font family used in the same pass as `set_fonts` panics, so call\n/// this before the first pass.\npub fn install_fonts(ctx: &egui::Context) {\n    let mut f = FontDefinitions::default();\n    f.font_data.insert(TITLE_FONT.into(), Arc::new(FontData::from_static(include_bytes!(\"../fonts/Fredoka_600SemiBold.ttf\"))));\n    f.font_data.insert(BODY_FONT.into(), Arc::new(FontData::from_static(include_bytes!(\"../fonts/Nunito_700Bold.ttf\"))));\n    f.families.insert(FontFamily::Name(TITLE_FONT.into()), vec![TITLE_FONT.into(), BODY_FONT.into()]);\n    f.families.insert(FontFamily::Name(BODY_FONT.into()), vec![BODY_FONT.into()]);\n    ctx.set_fonts(f);\n}\n\nfn c(x: Rgba) -> Color32 {\n    Color32::from_rgba_unmultiplied(x[0], x[1], x[2], x[3])\n}\n\n/// The 1920x1080 space in the window.\n#[derive(Clone, Copy)]\nstruct Space {\n    k: f32,\n    ox: f32,\n    oy: f32,\n    size: egui::Vec2,\n}\n\nimpl Space {\n    fn p(&self, a: [f32; 2]) -> Pos2 {\n        pos2(self.ox + a[0] * self.k, self.oy + a[1] * self.k)\n    }\n    fn r(&self, a: [f32; 4]) -> Rect {\n        Rect::from_min_max(self.p([a[0], a[1]]), self.p([a[2], a[3]]))\n    }\n    fn s(&self, x: f32) -> f32 {\n        x * self.k\n    }\n}\n\nfn font(sp: &Space, size: f32, title: bool) -> FontId {\n    FontId::new(sp.s(size), FontFamily::Name(if title { TITLE_FONT } else { BODY_FONT }.into()))\n}\n\nfn text(p: &Painter, sp: &Space, at: [f32; 2], size: f32, color: Color32, align: u8, title: bool, s: &str, wrap: f32) {\n    let w = if wrap > 0.0 { sp.s(wrap) } else { f32::INFINITY };\n    let g = p.layout(s.to_string(), font(sp, size, title), color, w);\n    let at = sp.p(at);\n    let x = match align {\n        1 => at.x - if wrap > 0.0 { w * 0.5 } else { g.size().x * 0.5 },\n        2 => at.x - g.size().x,\n        _ => at.x,\n    };\n    p.galley(pos2(x, at.y), g, color);\n}\n\n/// Width a text takes, in 1080p units.\nfn width(p: &Painter, sp: &Space, size: f32, title: bool, s: &str) -> f32 {\n    p.layout_no_wrap(s.to_string(), font(sp, size, title), Color32::WHITE).size().x / sp.k.max(1e-3)\n}\n\nfn star(p: &Painter, c0: Pos2, r: f32, fill: Color32) {\n    let at = |i: i32, rr: f32| {\n        let a = -std::f32::consts::FRAC_PI_2 + i as f32 * std::f32::consts::TAU / 10.0;\n        c0 + vec2(a.cos(), a.sin()) * rr\n    };\n    for i in 0..5 {\n        let k = i * 2;\n        p.add(Shape::convex_polygon(vec![at(k, r), at(k + 1, r * 0.42), at(k - 1, r * 0.42)], fill, Stroke::NONE));\n    }\n    p.add(Shape::convex_polygon((0..5).map(|i| at(i * 2 + 1, r * 0.42)).collect(), fill, Stroke::NONE));\n}\n\n/// Draws a frame and reads the pointer. `mouse`: the mouse was used last among keys and mouse.\npub fn draw(ctx: &egui::Context, f: &UiFrame, device: Device, mouse: bool, vp: Mat4) -> Out {\n    let screen = ctx.content_rect();\n    let size = screen.size();\n    let k = (size.x / 1920.0).min(size.y / 1080.0);\n    let sp = Space { k, ox: (size.x - 1920.0 * k) * 0.5, oy: (size.y - 1080.0 * k) * 0.5, size };\n    let p = ctx.layer_painter(egui::LayerId::new(egui::Order::Foreground, egui::Id::new(\"fit_ui\")));\n    let (pointer, moved, clicked, down, rclick) = ctx.input(|i| {\n        (i.pointer.hover_pos(), i.pointer.delta().length() > 0.0 || i.pointer.is_moving(), i.pointer.primary_clicked(), i.pointer.primary_down(), i.pointer.secondary_clicked())\n    });\n    let _ = rclick;\n    let style = glyphs::Style { device, mouse, xbox: f.xbox };\n    let mut out = Out::default();\n    for item in &f.items {\n        match item {\n            Ui::Tint { color } => {\n                p.rect_filled(screen, 0.0, c(*color));\n            }\n            Ui::Card { rect, color, radius, shadow } => {\n                let r = sp.r(*rect);\n                if *shadow {\n                    p.rect_filled(r.translate(vec2(0.0, sp.s(10.0))).expand(sp.s(4.0)), sp.s(*radius), Color32::from_rgba_unmultiplied(38, 62, 84, 40));\n                }\n                p.rect_filled(r, sp.s(*radius), c(*color));\n            }\n            Ui::Text { pos, size, color, align, title, text: s, wrap } => text(&p, &sp, *pos, *size, c(*color), *align, *title, s, *wrap),\n            Ui::Button { id, rect, label, sub, focused, stars, value, fill, big } => {\n                let mut r = sp.r(*rect);\n                out.rects.push((*id, [r.min.x, r.min.y, r.max.x, r.max.y]));\n                let hovered = pointer.is_some_and(|q| r.contains(q));\n                if hovered {\n                    out.over = true;\n                    if moved {\n                        out.hover = Some(*id);\n                    }\n                    if clicked {\n                        out.click = Some(*id);\n                    }\n                    if down && fill.is_some() {\n                        if let Some(q) = pointer {\n                            // The slider's track is the right half of the row.\n                            let track = track_of(r);\n                            if q.x >= track.min.x - sp.s(20.0) {\n                                out.slider = Some((*id, ((q.x - track.min.x) / track.width()).clamp(0.0, 1.0)));\n                                out.click = None;\n                            }\n                        }\n                    }\n                }\n                if *focused {\n                    r = r.expand2(r.size() * 0.025);\n                    p.rect_filled(r.translate(vec2(0.0, sp.s(8.0))), sp.s(36.0), Color32::from_rgba_unmultiplied(38, 62, 84, 50));\n                }\n                p.rect_filled(r, sp.s(36.0), c(WHITE));\n                if *focused {\n                    p.rect_stroke(r, sp.s(36.0), Stroke::new(sp.s(8.0), c(TEAL)), StrokeKind::Inside);\n                }\n                let mid = (rect[1] + rect[3]) * 0.5;\n                let x = rect[0] + 44.0;\n                let ink = c(INK);\n                let label_size = if *big { 60.0 } else { 44.0 };\n                let has_sub = !sub.is_empty();\n                if *big || (fill.is_none() && value.is_empty() && !has_sub && *id < 1000 && rect[2] - rect[0] < 900.0) {\n                    text(&p, &sp, [(rect[0] + rect[2]) * 0.5, mid - label_size * 0.62], label_size, ink, 1, false, label, 0.0);\n                } else if has_sub {\n                    text(&p, &sp, [x, rect[1] + 2.0], label_size, ink, 0, false, label, 0.0);\n                    text(&p, &sp, [x, rect[1] + 54.0], 34.0, c(MUTED), 0, false, sub, 0.0);\n                } else {\n                    text(&p, &sp, [x, mid - label_size * 0.62], label_size, ink, 0, false, label, 0.0);\n                }\n                let right = rect[2] - 44.0;\n                if *stars >= 0 {\n                    for s in 0..3 {\n                        let col = if s < *stars { c(SUN) } else { c(PALE) };\n                        star(&p, sp.p([right - (2 - s) as f32 * 52.0 - 20.0, mid]), sp.s(26.0), col);\n                    }\n                } else if let Some(v) = fill {\n                    let t = track_of(r);\n                    p.rect_filled(t, t.height() * 0.5, c(PALE));\n                    let mut on = t;\n                    on.set_width(t.width() * v.clamp(0.0, 1.0));\n                    p.rect_filled(on, t.height() * 0.5, c(TEAL));\n                    p.circle(pos2(t.min.x + t.width() * v, t.center().y), t.height() * 0.8, c(WHITE), Stroke::new(sp.s(4.0), c(TEAL)));\n                    text(&p, &sp, [right, mid - 40.0], 34.0, ink, 2, false, value, 0.0);\n                } else if !value.is_empty() {\n                    text(&p, &sp, [right, mid - 26.0], 40.0, c(TEAL), 2, false, value, 0.0);\n                }\n            }\n            Ui::Prompt { pos, align, glyphs: gs, label, size } => {\n                let gw: f32 = gs.iter().map(|g| glyphs::width(&p, &sp.into(), *g, &style, *size)).sum::<f32>() + (gs.len() as f32 - 1.0).max(0.0) * 10.0;\n                let lw = if label.is_empty() { 0.0 } else { width(&p, &sp, *size, false, label) + 14.0 };\n                let total = gw + lw;\n                let x0 = match align {\n                    1 => pos[0] - total * 0.5,\n                    2 => pos[0] - total,\n                    _ => pos[0],\n                };\n                let bg = sp.r([x0 - 18.0, pos[1] - 6.0, x0 + total + 18.0, pos[1] + size * 1.45]);\n                p.rect_filled(bg, sp.s(24.0), Color32::from_rgba_unmultiplied(255, 255, 255, 215));\n                let mut x = x0;\n                for g in gs {\n                    let w = glyphs::width(&p, &sp.into(), *g, &style, *size);\n                    glyphs::draw(&p, &sp.into(), [x, pos[1]], *g, &style, *size);\n                    x += w + 10.0;\n                }\n                if !label.is_empty() {\n                    text(&p, &sp, [x + 4.0, pos[1] - 4.0], (*size).max(MIN_BODY), c(INK), 0, false, label, 0.0);\n                }\n            }\n            Ui::WorldPrompt { at, glyph, label } => {\n                let v = vp * Vec4::new(at[0], at[1], at[2], 1.0);\n                if v.w <= 0.0 {\n                    continue;\n                }\n                let n = v.truncate() / v.w;\n                let wx = (n.x * 0.5 + 0.5) * sp.size.x;\n                let wy = (0.5 - n.y * 0.5) * sp.size.y;\n                let x = (wx - sp.ox) / sp.k;\n                let y = (wy - sp.oy) / sp.k;\n                let sz = 42.0;\n                let gw = glyphs::width(&p, &sp.into(), *glyph, &style, sz);\n                let lw = width(&p, &sp, sz, false, label);\n                let tw = gw + 14.0 + lw;\n                let x0 = (x - tw * 0.5).clamp(30.0, 1890.0 - tw);\n                let bar = sp.r([x0 - 22.0, y - 12.0, x0 + tw + 22.0, y + 66.0]);\n                p.rect_filled(bar, sp.s(30.0), Color32::from_rgba_unmultiplied(255, 255, 255, 235));\n                p.rect_stroke(bar, sp.s(30.0), Stroke::new(sp.s(4.0), c(TEAL)), StrokeKind::Inside);\n                glyphs::draw(&p, &sp.into(), [x0, y], *glyph, &style, sz);\n                text(&p, &sp, [x0 + gw + 14.0, y - 4.0], sz, c(INK), 0, false, label, 0.0);\n            }\n            Ui::Puck { center, r, dot, ring, band, stars, trace } => {\n                let ct = sp.p(*center);\n                let rad = sp.s(*r);\n                p.circle(ct + vec2(0.0, sp.s(8.0)), rad, Color32::from_rgba_unmultiplied(38, 62, 84, 50), Stroke::NONE);\n                p.circle(ct, rad, c(DECK), Stroke::new(sp.s(8.0), c(INK)));\n                if let Some(h) = band {\n                    let w = rad * h;\n                    p.rect_filled(Rect::from_center_size(ct, vec2(w * 2.0, rad * 1.9)), rad * 0.1, Color32::from_rgba_unmultiplied(120, 220, 170, 110));\n                }\n                let u = |d: [f32; 2]| ct + vec2(d[0], -d[1]) * rad;\n                if let Some((at, rr)) = ring {\n                    p.circle(u(*at), rad * rr, Color32::from_rgba_unmultiplied(120, 220, 170, 90), Stroke::new(sp.s(8.0), c(MINT)));\n                }\n                p.line_segment([ct - vec2(rad * 0.08, 0.0), ct + vec2(rad * 0.08, 0.0)], Stroke::new(sp.s(3.0), c(MUTED)));\n                p.line_segment([ct - vec2(0.0, rad * 0.08), ct + vec2(0.0, rad * 0.08)], Stroke::new(sp.s(3.0), c(MUTED)));\n                for w in trace.windows(2) {\n                    p.line_segment([u(w[0]), u(w[1])], Stroke::new(sp.s(3.0), Color32::from_rgba_unmultiplied(255, 120, 110, 120)));\n                }\n                p.circle(u(*dot), sp.s(26.0), c(CORAL), Stroke::new(sp.s(5.0), c(WHITE)));\n                for s in 0..*stars {\n                    let a = -std::f32::consts::FRAC_PI_2 + s as f32 * 0.7 - (*stars as f32 - 1.0) * 0.35;\n                    star(&p, ct + vec2(a.cos(), a.sin()) * (rad + sp.s(30.0)), sp.s(24.0), c(SUN));\n                }\n            }\n            Ui::Stars { pos, size, n, of } => {\n                for s in 0..*of {\n                    let x = pos[0] + (s as f32 - (*of as f32 - 1.0) * 0.5) * size * 2.2;\n                    star(&p, sp.p([x, pos[1]]), sp.s(*size), if s < *n { c(SUN) } else { c(PALE) });\n                }\n            }\n            Ui::Bar { rect, frac, color, marker } => {\n                let r = sp.r(*rect);\n                let rad = r.height().min(r.width()) * 0.5;\n                p.rect_filled(r, rad, c(PALE));\n                if marker.is_none() {\n                    let mut on = r;\n                    on.set_width(r.width() * frac.clamp(0.0, 1.0));\n                    p.rect_filled(on, rad, c(*color));\n                } else if let Some(m) = marker {\n                    // A vertical scroll bar.\n                    let h = r.height() * 0.25;\n                    let top = r.min.y + (r.height() - h) * m;\n                    p.rect_filled(Rect::from_min_size(pos2(r.min.x, top), vec2(r.width(), h)), rad, c(*color));\n                }\n            }\n            Ui::Circle { c: center, r, fill, stroke, width } => {\n                p.circle(sp.p(*center), sp.s(*r), c(*fill), Stroke::new(sp.s(*width), c(*stroke)));\n            }\n            Ui::Line { a, b, width, color } => {\n                p.line_segment([sp.p(*a), sp.p(*b)], Stroke::new(sp.s(*width), c(*color)));\n            }\n        }\n    }\n    let _ = (Align2::LEFT_TOP, Vec3::ZERO);\n    out\n}\n\nfn track_of(r: Rect) -> Rect {\n    let h = (r.height() * 0.2).max(4.0);\n    let w = r.width() * 0.34;\n    let x = r.max.x - w - r.width() * 0.04;\n    Rect::from_min_size(pos2(x, r.center().y + h * 0.5), vec2(w, h))\n}\n\npub mod glyphs {\n    //! PlayStation, Xbox and keyboard-and-mouse prompts, drawn with the painter. One function says\n    //! what a prompt shows: `prompt(action, device, xbox)`.\n\n    use super::*;\n\n    #[derive(Clone, Copy, Debug)]\n    pub struct Style {\n        pub device: Device,\n        pub mouse: bool,\n        pub xbox: bool,\n    }\n\n    #[derive(Clone, Copy, Debug)]\n    pub struct Sp {\n        pub(super) k: f32,\n        pub(super) ox: f32,\n        pub(super) oy: f32,\n    }\n\n    impl From<Space> for Sp {\n        fn from(s: Space) -> Self {\n            Sp { k: s.k, ox: s.ox, oy: s.oy }\n        }\n    }\n\n    /// What a prompt shows.\n    #[derive(Clone, Debug, PartialEq, Eq)]\n    pub enum Shown {\n        /// A round face button: its shape (or Xbox letter) and colour.\n        Cross,\n        Circle,\n        Square,\n        Triangle,\n        Letter(&'static str, [u8; 3]),\n        /// A shoulder or menu pill, a stick or D-pad, a keycap.\n        Pill(&'static str),\n        Stick(&'static str),\n        Key(&'static str),\n        /// A little mouse: left button, right button, both, or movement.\n        Mouse(u8),\n    }\n\n    /// The one mapping from action, device and glyph setting to what is shown.\n    pub fn prompt(g: Glyph, device: Device, mouse: bool, xbox: bool) -> Shown {\n        use Shown::*;\n        match device {\n            Device::KeyboardMouse | Device::Touch => {\n                if mouse {\n                    match g {\n                        Glyph::Confirm | Glyph::StepL => return Mouse(0),\n                        Glyph::Back | Glyph::StepR => return Mouse(1),\n                        Glyph::Brace => return Mouse(2),\n                        Glyph::Lean => return Mouse(3),\n                        Glyph::Move => return Mouse(0),\n                        Glyph::Camera => return Mouse(1),\n                        _ => {}\n                    }\n                }\n                match g {\n                    Glyph::Confirm => Key(\"Space\"),\n                    Glyph::Back => Key(\"Esc\"),\n                    Glyph::Wave => Key(\"F\"),\n                    Glyph::Schedule => Key(\"Tab\"),\n                    Glyph::Pause => Key(\"Esc\"),\n                    Glyph::StepL => Key(\"Q\"),\n                    Glyph::StepR => Key(\"E\"),\n                    Glyph::Brace => Key(\"Q + E\"),\n                    Glyph::Lean | Glyph::Move => Key(\"W A S D\"),\n                    Glyph::Camera => Mouse(1),\n                    Glyph::Tabs => Key(\"Q  E\"),\n                    Glyph::Jog => Key(\"Shift\"),\n                }\n            }\n            Device::Gamepad => match (g, xbox) {\n                (Glyph::Confirm, false) => Cross,\n                (Glyph::Confirm, true) => Letter(\"A\", [0x5c, 0xb8, 0x5c]),\n                (Glyph::Back, false) => Circle,\n                (Glyph::Back, true) => Letter(\"B\", [0xe0, 0x5a, 0x4f]),\n                (Glyph::Wave, false) => Square,\n                (Glyph::Wave, true) => Letter(\"X\", [0x4f, 0x8f, 0xe0]),\n                (Glyph::Schedule, false) => Triangle,\n                (Glyph::Schedule, true) => Letter(\"Y\", [0xe6, 0xc0, 0x3c]),\n                (Glyph::Pause, false) => Pill(\"Options\"),\n                (Glyph::Pause, true) => Pill(\"Menu\"),\n                (Glyph::StepL, false) => Pill(\"L1\"),\n                (Glyph::StepL, true) => Pill(\"LB\"),\n                (Glyph::StepR, false) => Pill(\"R1\"),\n                (Glyph::StepR, true) => Pill(\"RB\"),\n                (Glyph::Brace, false) => Pill(\"L1 + R1\"),\n                (Glyph::Brace, true) => Pill(\"LB + RB\"),\n                (Glyph::Tabs, false) => Pill(\"L1  R1\"),\n                (Glyph::Tabs, true) => Pill(\"LB  RB\"),\n                (Glyph::Jog, false) => Pill(\"R2\"),\n                (Glyph::Jog, true) => Pill(\"RT\"),\n                (Glyph::Lean | Glyph::Move, _) => Stick(\"L\"),\n                (Glyph::Camera, _) => Stick(\"R\"),\n            },\n        }\n    }\n\n    fn fnt(sp: &Sp, s: f32) -> FontId {\n        FontId::new(s * sp.k, FontFamily::Name(BODY_FONT.into()))\n    }\n\n    fn tw(p: &Painter, sp: &Sp, s: &str, size: f32) -> f32 {\n        p.layout_no_wrap(s.to_string(), fnt(sp, size), Color32::WHITE).size().x / sp.k.max(1e-3)\n    }\n\n    pub fn width(p: &Painter, sp: &Sp, g: Glyph, st: &Style, size: f32) -> f32 {\n        match prompt(g, st.device, st.mouse, st.xbox) {\n            Shown::Key(s) | Shown::Pill(s) => tw(p, sp, s, size * 0.8) + size * 0.8,\n            _ => size * 1.3,\n        }\n    }\n\n    pub fn draw(p: &Painter, sp: &Sp, at: [f32; 2], g: Glyph, st: &Style, size: f32) {\n        let s = size * 1.3;\n        let pt = |x: f32, y: f32| pos2(sp.ox + x * sp.k, sp.oy + y * sp.k);\n        let center = pt(at[0] + s * 0.5, at[1] + s * 0.5);\n        let r = s * 0.5 * sp.k;\n        let ink = Color32::from_rgb(0x26, 0x3e, 0x54);\n        let centered = |t: &str, c0: Pos2, col: Color32, size: f32| {\n            p.text(c0, Align2::CENTER_CENTER, t, fnt(sp, size), col);\n        };\n        match prompt(g, st.device, st.mouse, st.xbox) {\n            Shown::Cross | Shown::Circle | Shown::Square | Shown::Triangle => {\n                p.circle_filled(center, r, ink);\n                let stroke = |col: [u8; 3]| Stroke::new(r * 0.16, Color32::from_rgb(col[0], col[1], col[2]));\n                let m = r * 0.48;\n                match prompt(g, st.device, st.mouse, st.xbox) {\n                    Shown::Cross => {\n                        let st0 = stroke([0x8f, 0xb8, 0xee]);\n                        p.line_segment([center + vec2(-m, -m), center + vec2(m, m)], st0);\n                        p.line_segment([center + vec2(-m, m), center + vec2(m, -m)], st0);\n                    }\n                    Shown::Circle => {\n                        p.circle_stroke(center, m, stroke([0xf0, 0x8a, 0x90]));\n                    }\n                    Shown::Square => {\n                        p.rect_stroke(Rect::from_center_size(center, vec2(m * 1.7, m * 1.7)), 0.0, stroke([0xd9, 0x9a, 0xd9]), StrokeKind::Middle);\n                    }\n                    _ => {\n                        let a = center + vec2(0.0, -m * 1.05);\n                        let b = center + vec2(m, m * 0.8);\n                        let c0 = center + vec2(-m, m * 0.8);\n                        let t = stroke([0x6e, 0xd6, 0xb0]);\n                        p.line_segment([a, b], t);\n                        p.line_segment([b, c0], t);\n                        p.line_segment([c0, a], t);\n                    }\n                }\n            }\n            Shown::Letter(l, col) => {\n                p.circle_filled(center, r, Color32::from_rgb(col[0], col[1], col[2]));\n                centered(l, center, Color32::WHITE, size * 0.86);\n            }\n            Shown::Pill(t) => {\n                let w = tw(p, sp, t, size * 0.8) + size * 0.8;\n                let rc = Rect::from_min_size(pt(at[0], at[1] + s * 0.08), vec2(w * sp.k, s * 0.84 * sp.k));\n                p.rect_filled(rc, r * 0.7, ink);\n                centered(t, rc.center(), Color32::WHITE, size * 0.8);\n            }\n            Shown::Key(t) => {\n                let w = tw(p, sp, t, size * 0.8) + size * 0.8;\n                let rc = Rect::from_min_size(pt(at[0], at[1] + s * 0.06), vec2(w * sp.k, s * 0.84 * sp.k));\n                p.rect_filled(rc.translate(vec2(0.0, r * 0.14)), r * 0.3, ink);\n                p.rect_filled(rc, r * 0.3, Color32::WHITE);\n                p.rect_stroke(rc, r * 0.3, Stroke::new(r * 0.08, ink), StrokeKind::Inside);\n                centered(t, rc.center(), ink, size * 0.8);\n            }\n            Shown::Stick(t) => {\n                p.circle_filled(center, r, ink);\n                p.circle_stroke(center, r * 0.68, Stroke::new(r * 0.1, Color32::WHITE));\n                centered(t, center, Color32::WHITE, size * 0.62);\n            }\n            Shown::Mouse(b) => {\n                let rc = Rect::from_center_size(center, vec2(r * 1.3, r * 1.9));\n                p.rect_filled(rc, r * 0.6, Color32::WHITE);\n                let teal = Color32::from_rgb(0x46, 0xbe, 0xc8);\n                let half = |left: bool| Rect::from_min_size(if left { rc.min } else { pos2(rc.center().x, rc.min.y) }, vec2(rc.width() * 0.5, rc.height() * 0.44));\n                if b == 0 || b == 2 {\n                    p.rect_filled(half(true), r * 0.3, teal);\n                }\n                if b == 1 || b == 2 {\n                    p.rect_filled(half(false), r * 0.3, teal);\n                }\n                if b == 3 {\n                    p.circle_filled(center, r * 0.22, teal);\n                }\n                p.rect_stroke(rc, r * 0.6, Stroke::new(r * 0.1, ink), StrokeKind::Inside);\n                p.line_segment([pos2(rc.center().x, rc.min.y), pos2(rc.center().x, rc.min.y + rc.height() * 0.44)], Stroke::new(r * 0.07, ink));\n            }\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::glyphs::*;\n    use super::*;\n\n    #[test]\n    fn prompts_follow_device_and_setting() {\n        assert_eq!(prompt(Glyph::Confirm, Device::Gamepad, false, false), Shown::Cross);\n        assert_eq!(prompt(Glyph::Back, Device::Gamepad, false, false), Shown::Circle);\n        assert_eq!(prompt(Glyph::Wave, Device::Gamepad, false, false), Shown::Square);\n        assert_eq!(prompt(Glyph::Schedule, Device::Gamepad, false, false), Shown::Triangle);\n        assert_eq!(prompt(Glyph::Confirm, Device::Gamepad, false, true), Shown::Letter(\"A\", [0x5c, 0xb8, 0x5c]));\n        assert_eq!(prompt(Glyph::StepL, Device::Gamepad, false, false), Shown::Pill(\"L1\"));\n        assert_eq!(prompt(Glyph::StepL, Device::Gamepad, false, true), Shown::Pill(\"LB\"));\n        assert_eq!(prompt(Glyph::Confirm, Device::KeyboardMouse, false, false), Shown::Key(\"Space\"));\n        assert_eq!(prompt(Glyph::Confirm, Device::KeyboardMouse, true, false), Shown::Mouse(0));\n        assert_eq!(prompt(Glyph::Back, Device::KeyboardMouse, true, true), Shown::Mouse(1));\n    }\n\n    #[test]\n    fn a_frame_draws_and_reports_the_pointer() {\n        let ctx = egui::Context::default();\n        install_fonts(&ctx);\n        let frame = UiFrame {\n            items: vec![Ui::Button { id: 3, rect: [100.0, 100.0, 900.0, 200.0], label: \"Resume\".into(), sub: String::new(), focused: true, stars: -1, value: String::new(), fill: None, big: false }],\n            ..Default::default()\n        };\n        let mut first = true;\n        let mut got = Out::default();\n        for pass in 0..3 {\n            let mut events = vec![egui::Event::PointerMoved(pos2(250.0, 75.0 + pass as f32))];\n            if pass == 2 {\n                events.push(egui::Event::PointerButton { pos: pos2(250.0, 75.0), button: egui::PointerButton::Primary, pressed: true, modifiers: Default::default() });\n                events.push(egui::Event::PointerButton { pos: pos2(250.0, 75.0), button: egui::PointerButton::Primary, pressed: false, modifiers: Default::default() });\n            }\n            let raw = egui::RawInput { screen_rect: Some(Rect::from_min_size(Pos2::ZERO, vec2(960.0, 540.0))), events, ..Default::default() };\n            let _ = ctx.run_ui(raw, |ui| {\n                got = draw(ui.ctx(), &frame, Device::KeyboardMouse, false, Mat4::IDENTITY);\n            });\n            first = false;\n        }\n        assert!(!first);\n        assert_eq!(got.rects.len(), 1);\n        assert!(got.over);\n    }\n}\nRS\npython3 - <<'PY'\np='crates/pav_ui/src/lib.rs'\ns=open(p).read()\ns=s.replace('pub mod arpg_ui;\\n','pub mod arpg_ui;\\npub mod fit_ui;\\n')\nopen(p,'w').write(s)\np='crates/pav_ui/src/headless.rs'\ns=open(p).read()\ns=s.replace('''    /// What the player gave by clicking (`Input::click`).\n    pub commands: Vec<GameCmd>,\n}''','''    /// What the player gave by clicking (`Input::click`).\n    pub commands: Vec<GameCmd>,\n    /// A `games::fit` frame's pointer report.\n    pub fit: Option<crate::fit_ui::Out>,\n}''')\ns=s.replace('''        let ctx = egui::Context::default();\n        let touch = self.device == Device::Touch;''','''        let ctx = egui::Context::default();\n        // Before the first pass: a font family used in the pass that installs it panics.\n        if hud_lines.fit.is_some() {\n            crate::fit_ui::install_fonts(&ctx);\n        }\n        let mut fit_out = None;\n        let touch = self.device == Device::Touch;''')\ns=s.replace('''                crate::game_lines(&ctx, hud_lines);\n''','''                crate::game_lines(&ctx, hud_lines);\n                if let Some(f) = &hud_lines.fit {\n                    fit_out = Some(crate::fit_ui::draw(&ctx, f, self.device, false, vp));\n                }\n''')\ns=s.replace('''        Drawn { paint: Paint { primitives, textures, pixels_per_point }, reading, commands }''','''        Drawn { paint: Paint { primitives, textures, pixels_per_point }, reading, commands, fit: fit_out }''')\nopen(p,'w').write(s)\np='crates/pav_core/src/games/fit/ui_model.rs'\ns=open(p).read()\ns=s.replace('''    /// How hard the pad should rumble now (0..1): Eyes Closed.\n    pub rumble: f32,\n}''','''    /// How hard the pad should rumble now (0..1): Eyes Closed.\n    pub rumble: f32,\n    /// Input shaping the host applies: stick dead zone and curve, key rates, mouse range.\n    pub shaping: [f32; 5],\n}''')\nopen(p,'w').write(s)\np='crates/pav_core/src/games/fit/menus.rs'\ns=open(p).read()\ns=s.replace('''            rumble: self.rumble,\n        }''','''            rumble: self.rumble,\n            shaping: {\n                let c = &self.rules.core;\n                [c.stick_deadzone, c.stick_curve, c.key_rate, c.key_return, c.mouse_range]\n            },\n        }''')\nopen(p,'w').write(s)\nPY\nCARGO_BUILD_JOBS=8 cargo test --locked -q -p pav_audio -p pav_ui 2>&1 | grep -E \"^error|^test result|panicked|FAILED|^  -->|error\\[\" -A4 | cut -c1-220 | head -60","description":"Fetch fonts, write the synth, UI drawing and glyphs, and test them","timeout":500000}}}
