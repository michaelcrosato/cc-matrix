  if let Some(t) = self.thread.take() {\n211-            let _ = t.join();\n212-        }\n213-    }\n214-}\n215-\n216-fn publish(sim: &mut Sim, sh: &Shared, tick_wall: f32, at: Instant) {\n217-    let events = sim.drain_events();\n218-    if !events.is_empty() {\n219-        let mut q = sh.events.lock().unwrap();\n220-        q.extend(events);\n221-        let n = q.len();\n222-        if n > 512 {\n223-            q.drain(..n - 512);\n224-        }\n225-    }\n226-    let frame = Arc::new(sim.frame());\n227-    let mut f = sh.frames.lock().unwrap();\n228-    f.prev = std::mem::replace(&mut f.curr, frame);\n229-    f.curr_at = at;\n230-    f.tick_wall = tick_wall;\n231-}\n232-\n233-/// Fixed-rate ticking with time controls (pause, single steps, speed, rewind, scrubbing).\n234-struct Clock {\n235-    next: Instant,\n236-    window_start: Instant,\n237-    window_ticks: u32,\n238-    busy: Duration,\n239-    rewound: bool,\n240-    studio_mode: pav_core::prop_preview::StudioMode,\n241-}\n242-\n243-impl Clock {\n244-    fn new() -> Self {\n245-        Self {\n246-            next: Instant::now(),\n247-            window_start: Instant::now(),\n248-            window_ticks: 0,\n249-            busy: Duration::ZERO,\n250-            rewound: false,\n251-            studio_mode: pav_core::prop_preview::StudioMode::World,\n252-        }\n253-    }\n254-\n255-    /// Runs whatever is due now; returns how long until the next tick.\n256-    fn advance(&mut self, sim: &mut Sim, sh: &Shared) -> Duration {\n67:    pub input: Mutex<InputFrame>,\n73:    /// When the input that is waiting for the next tick was pressed (latency measurement).\n74:    pub input_stamp: Mutex<Option<Instant>>,\n75:    /// (pressed, consumed by a tick, that tick's number) for the latest measured press.\n77:    /// Menu commands waiting for a tick (one rides along with each tick's input).\n110:        input: Mutex::new(InputFrame::default()),\n115:        input_stamp: Mutex::new(None),\n269:            let input = if previewing {\n272:                let mut i = sh.input.lock().unwrap();\n274:                i.pressed = 0;\n278:            let stamp = if previewing { None } else { sh.input_stamp.lock().unwrap().take() };\n280:            sim.step(&input);\n---- session\n            gpu.renderer.clear_particles();\n            gpu.studio_mode = self.sim.studio_mode();\n        }\n    }\n\n    /// Applies a room's camera defaults when the player enters/leaves it, and level camera\n    /// cues, the way the game does (without blending). Called after every step.\n    pub fn sync_camera(&mut self) {\n        use pav_core::params::{ParamValue, apply_map};\n        if self.live || self.sim.studio_active() {\n            return;\n        }\n        let w = &self.sim.state.world;\n        let now = w.current_room;\n        let rot = |yaw: f64, q: u8| ParamValue::Float((yaw + q as f64 * 90.0 + 540.0).rem_euclid(360.0) - 180.0);\n        let c = &self.sim.state.courses;\n        if c.cue_serial != self.cue_serial {\n            self.cue_serial = c.cue_serial;\n\n    /// Renders the current state to RGBA8 pixels.\n    pub fn render(&mut self, width: u32, height: u32) -> Result<Vec<u8>> {\n        let frame = self.sim.frame();\n        let focus = frame.focus;\n        self.camera.snap(focus);\n        let camera = self.camera.clone();\n        let view = self.view_for(&frame);\n        let events = std::mem::take(&mut self.events);\n        let gpu = self.gpu()?;\n        gpu.prepare_frame(&frame);\n        if !frame.studio_active() {\n            gpu.builder.add_events(&events);\n        }\n        let scene = gpu.builder.build(&frame, &frame, 1.0, &camera, width as f32 / height as f32, &view, focus);\n        pav_render::capture::render_to_rgba(&mut gpu.renderer, &scene, width, height)\n    }\n\n    /// Renders like `render` with the game UI over it (when a game runs: Shardfall, or a\n    /// `pav_core::games` game's HUD lines): the pixels, and what the UI drew (`None` without a\n    /// game). `input` hovers or clicks.\n    pub fn render_ui(\n        &mut self,\n        width: u32,\n        height: u32,\n        input: pav_ui::headless::Input,\n    ) -> Result<(Vec<u8>, Option<pav_ui::headless::Drawn>)> {\n        let frame = self.sim.frame();\n        let focus = frame.focus;\n        self.camera.snap(focus);\n        let camera = self.camera.clone();\n        let view = self.view_for(&frame);\n        let events = std::mem::take(&mut self.events);\n        let gpu = self.gpu()?;\n        gpu.prepare_frame(&frame);\n        if !frame.studio_active() {\n            gpu.builder.add_events(&events);\n        }\n        let scene = gpu.builder.build(&frame, &frame, 1.0, &camera, width as f32 / height as f32, &view, focus);\n        let vp = scene.camera.proj * scene.camera.view;\n        let drawn = has_ui(&frame).then(|| self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input));\n        let gpu = self.gpu.as_mut().unwrap();\n        let Some(paint) = drawn.as_ref().map(|d| &d.paint) else {\n            return Ok((pav_render::capture::render_to_rgba(&mut gpu.renderer, &scene, width, height)?, None));\n        };\n        let device = gpu.renderer.device().clone();\n        let overlay =\n            gpu.overlay.get_or_insert_with(|| pav_ui::headless::Overlay::new(&device, pav_render::capture::CAPTURE_FORMAT));\n        let rgba = pav_render::capture::render_to_rgba_with(\n            &mut gpu.renderer,\n            &scene,\n            width,\n            height,\n            |device, queue, encoder, target| overlay.paint(device, queue, encoder, target, (width, height), paint),\n        )?;\n        Ok((rgba, drawn))\n    }\n\n    /// The game UI's reading without rendering (no GPU): what is on screen at `width` x\n    /// `height` from the session's camera. `None` without a game.\n    pub fn read_ui(&mut self, width: u32, height: u32, input: pav_ui::headless::Input) -> Option<pav_ui::headless::Drawn> {\n        let frame = self.sim.frame();\n        if !has_ui(&frame) {\n            return None;\n        }\n        self.camera.snap(frame.focus);\n        let vp = self.camera.view_proj(width as f32 / height.max(1) as f32);\n        Some(self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input))\n    }\n\n    /// Renders `frame`, a stage the simulation does not hold (a material swatch), from the\n    /// session's camera as it is.\n    pub fn render_frame(&mut self, frame: &RenderFrame, width: u32, height: u32) -> Result<Vec<u8>> {\n        let camera = self.camera.clone();\n        let view = self.view_for(frame);\n        let gpu = self.gpu()?;\n        gpu.prepare_frame(frame);\n        let scene = gpu.builder.build(frame, frame, 1.0, &camera, width as f32 / height as f32, &view, frame.focus);\n        pav_render::capture::render_to_rgba(&mut gpu.renderer, &scene, width, height)\n    }\n\n    /// Renders like `render` and also returns the camera's view-projection (to place marks).\n    pub fn render_with_camera(&mut self, width: u32, height: u32) -> Result<(Vec<u8>, glam::Mat4)> {\n        let frame = self.sim.frame();\n        let focus = frame.focus;\n        self.camera.snap(focus);\n        let camera = self.camera.clone();\n        let view = self.view_for(&frame);\n        let events = std::mem::take(&mut self.events);\n        let gpu = self.gpu()?;\n        gpu.prepare_frame(&frame);\n        if !frame.studio_active() {\n            gpu.builder.add_events(&events);\n        }\n        let scene = gpu.builder.build(&frame, &frame, 1.0, &camera, width as f32 / height as f32, &view, focus);\n        let vp = scene.camera.proj * scene.camera.view;\n        Ok((pav_render::capture::render_to_rgba(&mut gpu.renderer, &scene, width, height)?, vp))\n    }\n\n    pub fn camera_eye(&self) -> Vec3 {\n        self.camera.eye()\n    }\n\n    pub fn focus(&self) -> Vec3 {\n        self.sim.state.focus\n    }\n}\n\n/// A game's UI is on screen: Shardfall's, or a `pav_core::games` game's HUD lines.\npub fn has_ui(frame: &RenderFrame) -> bool {\n    frame.game.is_some() || !frame.hud.lines.is_empty()\n}\n---- spawn_prop\n    Bounds { min: center - extent, max: center + extent }\n}\n\nimpl Sim {\n    pub fn spawn_prop(\n        &mut self,\n        asset: &str,\n        pos: Vec3,\n        rot: Quat,\n        scale: f32,\n        collide: bool,\n        region: Option<RegionKey>,\n    ) -> Result<EntityId, String> {\n        // `NAME:preset` places a family's preset.\n        let (name, definition, params) = props::resolve_placed(asset, &props::Params::new())?;\n        self.place_prop(PropInstance::new(&name, definition, scale, collide)?.with_params(&params)?, pos, rot, region)\n    }\n\n    /// Place a prepared copy (its seed and palette set).\n    pub fn place_prop(\n        &mut self,\n        instance: PropInstance,\n        pos: Vec3,\n        rot: Quat,\n        region: Option<RegionKey>,\n    ) -> Result<EntityId, String> {\n        validate_pose(pos, rot)?;\n        let mut spawn = Spawn::new(&instance.definition.doc.name, pos).rot(rot).prop(instance);\n        spawn.region = region;\n        Ok(self.spawn(spawn))\n    }\n\n    /// A copy's variant, palette and knob values: its parts and collision follow them.\n    pub fn restyle_prop(\n        &mut self,\n        id: EntityId,\n            return Err(\"asset reference does not match its embedded definition\".into());\n        }\n        Ok(Self {\n            asset,\n            definition,\n            scale,\n            collide,\n            seed: 0,\n            roles: BTreeMap::new(),\n            params: props::Params::new(),\n            patch: Vec::new(),\n        })\n    }\n\n    /// This copy's variant: chance, jitter and pick resolve with `seed`.\n    pub fn with_seed(mut self, seed: u32) -> Self {\n        self.seed = seed;\n        self\n    }\n\n    /// Colours for the theme roles its parts name, e.g. `{\"$wall\":\"#5a6b7c\"}`.\n    pub fn with_roles(mut self, roles: BTreeMap<String, String>) -> Result<Self, String> {\n        validate_roles(&roles)?;\n        self.roles = roles;\n        Ok(self)\n    }\n\n    /// A family's knob values, checked against its definition (defaults are left out).\n    pub fn with_params(mut self, params: &props::Params) -> Result<Self, String> {\n        let params = self.definition.param_values(None, params)?;\n        self.definition.try_variant(&params, self.seed).map_err(|issues| issue::render(&issues))?;\n        self.params = params;\n        Ok(self)\n    }\n\n    /// Records the patch ops its definition was made with (see `props::patched`).\n---- parts\n//! Attachments: horns, antlers, spikes, crests, tusks, mandibles, shell plates, extra eyes,\n//! floating orbs and wings that go on *any* body plan. Each body builder reports a few anchor\n//! points (head, back line, shoulders); the parts are drawn from those, so a spider can grow\n//! antlers and a blob can have wings. This is the \"Spore\" layer of the monster genome.\n\nuse glam::Vec3;\nuse serde::{Deserialize, Serialize};\n\nuse crate::color::Color;\n\ncrate::choice_enum! {\n    /// Kinds of attachment.\n    #[derive(Default)]\n    pub enum AttachKind {\n        #[default]\n        Horns => \"horns\",\n        Antlers => \"antlers\",\n        Spikes => \"spikes\",\n        Crest => \"crest\",\n        Tusks => \"tusks\",\n        Mandibles => \"mandibles\",\n        Plates => \"plates\",\n        Eyes => \"eyes\",\n        Orbs => \"orbs\",\n        Wings => \"wings\",\n    }\n}\n\nimpl AttachKind {\n    pub const ALL: [AttachKind; 10] = [\n        AttachKind::Horns,\n        AttachKind::Antlers,\n        AttachKind::Spikes,\n        AttachKind::Crest,\n        AttachKind::Tusks,\n        AttachKind::Mandibles,\n        AttachKind::Plates,\n        AttachKind::Eyes,\n        AttachKind::Orbs,\n        AttachKind::Wings,\n    ];\n}\n\n/// One attachment on a puppet.\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct Attach {\n    pub kind: AttachKind,\n    /// Size multiplier (1 = normal).\n    pub size: f32,\n    /// How many (spikes, plates, eyes, orbs; 0 = the kind's usual number).\n    pub count: u32,\n    /// Colour (\"\" = the puppet's accent colour).\n    pub color: String,\n    /// Shine (orbs and eyes glow by default).\n    pub glow: f32,\n}\n\nimpl Default for Attach {\n    fn default() -> Self {\n        Self { kind: AttachKind::Horns, size: 1.0, count: 0, color: String::new(), glow: 0.0 }\n    }\n}\n\n/// Where parts attach, in the space the body builder works in.\n#[derive(Clone, Debug)]\npub struct Anchors {\n    pub head: Vec3,\n    pub head_r: f32,\n    /// The head's forward, the body's up and right.\n    pub fwd: Vec3,\n    pub up: Vec3,\n    pub right: Vec3,\n    /// Points along the back (front to rear), the back's thickness, and which way is \"out of\n    /// the back\" (up for creatures, backward for bipeds).\n    pub back: Vec<Vec3>,\n    pub back_r: f32,\n    pub back_out: Vec3,\n    pub shoulders: [Vec3; 2],\n    pub center: Vec3,\n    /// Overall size (puppet scale).\n    pub k: f32,\n}\n\n/// A point `t` (0..1) along a polyline.\nfn along(pts: &[Vec3], t: f32) -> Vec3 {\n    match pts.len() {\n        0 => Vec3::ZERO,\n        1 => pts[0],\n        n => {\n            let x = t.clamp(0.0, 1.0) * (n - 1) as f32;\n            let i = (x.floor() as usize).min(n - 2);\n            pts[i].lerp(pts[i + 1], x - i as f32)\n        }\n    }\n}\n\n/// Draws the attachments. `push(a, b, ra, rb, colour, glow)` adds one capsule.\npub fn attach(parts: &[Attach], accent: Color, a: &Anchors, time: f32, push: &mut dyn FnMut(Vec3, Vec3, f32, f32, Color, f32)) {\n    let (f, u, r) = (a.fwd, a.up, a.right);\n    let hr = a.head_r.max(0.06 * a.k);\n    for p in parts {\n        let c = Color::try_hex(&p.color).unwrap_or(accent);\n        let s = p.size.max(0.1);\n        let g = p.glow;\n        match p.kind {\n            AttachKind::Horns => {\n                for sd in [-1.0f32, 1.0] {\n                    let base = a.head + u * hr * 0.6 + r * sd * hr * 0.55;\n                    let mid = base + (u * 0.75 + r * sd * 0.35 - f * 0.2) * hr * s;\ncrates/pav_core/src/parts.rs:14:    pub enum AttachKind {\ncrates/pav_core/src/parts.rs:29:impl AttachKind {\ncrates/pav_core/src/parts.rs:30:    pub const ALL: [AttachKind; 10] = [\ncrates/pav_core/src/parts.rs:31:        AttachKind::Horns,\ncrates/pav_core/src/parts.rs:32:        AttachKind::Antlers,\ncrates/pav_core/src/parts.rs:33:        AttachKind::Spikes,\ncrates/pav_core/src/parts.rs:34:        AttachKind::Crest,\ncrates/pav_core/src/parts.rs:35:        AttachKind::Tusks,\ncrates/pav_core/src/parts.rs:36:        AttachKind::Mandibles,\ncrates/pav_core/src/parts.rs:37:        AttachKind::Plates,\ncrates/pav_core/src/parts.rs:38:        AttachKind::Eyes,\ncrates/pav_core/src/parts.rs:39:        AttachKind::Orbs,\ncrates/pav_core/src/parts.rs:40:        AttachKind::Wings,\ncrates/pav_core/src/parts.rs:48:    pub kind: AttachKind,\ncrates/pav_core/src/parts.rs:61:        Self { kind: AttachKind::Horns, size: 1.0, count: 0, color: String::new(), glow: 0.0 }\ncrates/pav_core/src/parts.rs:107:            AttachKind::Horns => {\ncrates/pav_core/src/parts.rs:116:            AttachKind::Antlers => {\ncrates/pav_core/src/parts.rs:131:            AttachKind::Spikes => {\ncrates/pav_core/src/parts.rs:141:            AttachKind::Crest => {\ncrates/pav_core/src/parts.rs:151:            AttachKind::Tusks => {\n---- clips\n//! Motion clips: animation captured or keyed elsewhere (motion-capture databases, animation\n//! libraries) as readable key poses, played on the biped puppet.\n//!\n//! The format is the one my-3D2dge introduced for AI models, kept as it is so clips move freely\n//! between the two engines. A clip is a short list of key poses; each names what an animator\n//! would: where the hips are, how the body, chest and head turn and lean, how the shoulders reach\n//! and shrug, which way each arm and leg points and how much the elbow or knee bends, how the\n//! feet point. Nothing in it depends on body size (limbs are a direction plus a bend, heights are\n//! shares of hip height), so the puppet plays any clip at its own proportions: each limb takes the\n//! clip's direction at its own length and the elbows and knees are solved with the same IK the\n//! walk uses. Every set file carries the legend (`legend`) and its credits.\n//!\n//! Sets are the `*.json` files in /anim (embedded at build time; `crate::anim::reload` re-reads\n//! them). A clip is named `SET/Clip` (or just `Clip` when only one set has it); animation state\n//! stores its `ClipId`, a hash of that name.\n\nuse std::collections::{BTreeMap, HashMap};\nuse std::sync::{Arc, RwLock};\n\nuse glam::{Quat, Vec3};\nuse serde::{Deserialize, Deserializer, Serialize};\n\nuse crate::puppet::{PuppetDef, PuppetState, Skel};\n\n/// Play flags (`PuppetState::clip_flags`).\n/// Only the chest, head and arms follow the clip; the legs keep walking.\npub const UPPER: u8 = 1;\n/// Left and right swapped.\npub const MIRROR: u8 = 2;\n/// The clip's own travel moves the body (otherwise it plays in place).\npub const TRAVEL: u8 = 4;\n/// Fading out (set by `PuppetState::stop_clip`).\npub const STOP: u8 = 8;\n/// Fades out by itself when the clip ends (one-shot gestures over the procedural animation).\npub const ONCE: u8 = 16;\n/// Play flag: fade in and out three times as fast (an attack's wind-up is short).\npub const QUICK: u8 = 32;\n/// Hold the first and last poses instead of wrapping. The editor uses this to inspect a\n/// loop's final key without changing how that clip plays in the game.\npub const CLAMP: u8 = 128;\n\n/// Seconds a clip takes to fade in or out.\npub const FADE: f32 = 0.25;\n\n/// Performance settings (the `anim` group): how fast performing characters play their clips\n/// and moves, and whether their clips are mirrored.\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct AnimParams {\n    pub tempo: f32,\n    pub mirror: bool,\n}\n\nimpl Default for AnimParams {\n    fn default() -> Self {\n        Self { tempo: 1.0, mirror: false }\n    }\n}\n\nimpl crate::params::Tunable for AnimParams {\n    fn visit(&mut self, v: &mut dyn crate::params::ParamVisitor) {\n        v.float(\"tempo\", &mut self.tempo, 0.1, 3.0, \"Speed of performers' clips and moves (1 = as captured)\");\n        v.bool(\"mirror\", &mut self.mirror, \"Performers play their clips mirrored, left for right\");\n    }\n}\n\nfn limb<'de, D: Deserializer<'de>>(d: D) -> Result<[f32; 5], D::Error> {\n    let v = Vec::<f32>::deserialize(d)?;\n    if v.len() < 3 || v.len() > 5 {\n        return Err(serde::de::Error::custom(format!(\"a limb is [forward, out, up, bend, twist], got {} numbers\", v.len())));\n27:pub const UPPER: u8 = 1;\n29:pub const MIRROR: u8 = 2;\n31:pub const TRAVEL: u8 = 4;\n33:pub const STOP: u8 = 8;\n35:pub const ONCE: u8 = 16;\n37:pub const QUICK: u8 = 32;\n40:pub const CLAMP: u8 = 128;\n43:pub const FADE: f32 = 0.25;\n109:pub const LEGEND: &[&str] = &[\n846:    pub fn find(&self, name: &str) -> Option<u32> {\n884:pub fn library() -> Arc<ClipLib> {\n967:pub fn find(name: &str) -> Option<u32> {\n974:pub fn find_cached(name: &str) -> u32 {\n//! Animation data files (/anim): the moves table (`moves.toml`) and the motion clip sets\n//! (`*.json`). They are embedded in the binary at build time; `reload(true)` reads them from\n//! ./anim (or $PAV_ANIM) instead, for live editing. Sub-folders of /anim (the full motion-capture\n//! libraries) are never embedded: `crate::clips` loads them from disk when a clip is asked for.\n\nuse std::path::PathBuf;\nuse std::sync::atomic::{AtomicBool, Ordering};\n\ninclude!(concat!(env!(\"OUT_DIR\"), \"/anim_data.rs\"));\n\nstatic USE_DISK: AtomicBool = AtomicBool::new(false);\n\n/// The anim folder on disk: $PAV_ANIM, else ./anim (when it holds moves.toml).\npub fn disk_dir() -> Option<PathBuf> {\n    let d = std::env::var(\"PAV_ANIM\").map(PathBuf::from).unwrap_or_else(|_| \"anim\".into());\n    d.join(\"moves.toml\").exists().then_some(d)\n}\n\n/// The text of an animation file (`\"moves.toml\"`, `\"quaternius.json\"`): from disk while live\n/// editing, else the embedded copy.\npub fn source(name: &str) -> Option<String> {\n    if USE_DISK.load(Ordering::Relaxed) {\n        if let Some(t) = disk_dir().and_then(|d| std::fs::read_to_string(d.join(name)).ok()) {\n            return Some(t);\n        }\n    }\n    ANIM_DATA.iter().find(|(k, _)| *k == name).map(|(_, v)| v.to_string())\n}\n\n/// Names of the animation files with extension `ext` (embedded, plus new ones on disk while live\n/// editing), sorted.\npub fn files(ext: &str) -> Vec<String> {\n    let dot = format!(\".{ext}\");\n    let mut v: Vec<String> = ANIM_DATA.iter().filter(|(k, _)| k.ends_with(&dot)).map(|(k, _)| k.to_string()).collect();\n    if USE_DISK.load(Ordering::Relaxed) {\n        if let Some(rd) = disk_dir().and_then(|d| std::fs::read_dir(d).ok()) {\n            for e in rd.flatten() {\n                let name = e.file_name().to_string_lossy().to_string();\n                if e.path().is_file() && name.ends_with(&dot) && !v.contains(&name) {\n                    v.push(name);\n                }\n            }\n        }\n    }\n    v.sort();\n    v\n}\n\n/// Re-reads the moves table and the clip sets (from disk when `from_disk`). An invalid file\n/// keeps the old data and returns the error. Returns a one-line summary.\npub fn reload(from_disk: bool) -> Result<String, String> {\n    // Establish known-good tables before changing the source. The first explicit reload may\n    // see a half-written file; it must report an error instead of panicking during lazy init.\n    let _ = crate::moves::table();\n    let _ = crate::clips::library();\n    USE_DISK.store(from_disk, Ordering::Relaxed);\n    let moves = crate::moves::reload()?;\n    let (sets, clips) = crate::clips::reload()?;\n    Ok(format!(\"{moves} moves, {clips} clips in {sets} sets\"))\n}\n---- room npc\n364:pub struct NpcDef {\n365-    #[serde(default)]\n366-    pub name: String,\n367-    /// Body plan preset: biped | spider | lizard | beetle | blob.\n368-    #[serde(default)]\n369-    pub kind: crate::puppet::BodyPlan,\n370-    /// Feet position (layout space).\n371-    pub pos: Vec3,\n372-    /// Facing (degrees about Y, 0 = +Z / south).\n373-    #[serde(default)]\n374-    pub yaw: f32,\n375-    #[serde(default)]\n376-    pub ai: crate::ai::AiDef,\n377-    /// Fraction of full speed (0..1).\n378-    #[serde(default = \"half_speed\")]\n379-    pub speed: f32,\n380-    /// Seconds between hops (0 = never).\n381-    #[serde(default)]\n382-    pub hop: f32,\n383-    /// Puppet settings over the preset (any puppet field: colours, proportions, look...).\n384-    #[serde(default)]\n385-    pub look: toml::Table,\n386-    /// A performance: motion clips (`SET/Clip`, see the `clips` tool) and then moves\n387-    /// (anim/moves.toml), played one after another for ever.\n388-    #[serde(default)]\n389-    pub clips: Vec<String>,\n390-    #[serde(default)]\n391-    pub moves: Vec<String>,\n392-    /// Seconds each looping clip plays before the next (default 5).\n393-    #[serde(default)]\n394-    pub hold: f32,\n395-    /// Clips mirrored left to right, or played on the upper body only (the legs keep walking).\n396-    #[serde(default)]\n397-    pub mirror: bool,\n398-    #[serde(default)]\n399-    pub upper: bool,\n400-    /// Speed of the performance (1 = as captured).\n401-    #[serde(default)]\n402-    pub tempo: f32,\n403-    /// Sits on the room object of this name through its prop's `sit` socket: placed in front of\n404-    /// the socket, facing the way the seat faces, so its first clip's pelvis lands on the seat\n42:pub struct ObjectDef {\n43-    #[serde(default)]\n44-    pub name: String,\n45-    #[serde(default = \"box_shape\")]\n46-    pub shape: Shape,\n47-    /// R