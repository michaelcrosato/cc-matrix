ore/src/shape.rs;grep -n \"pub struct Visual\" -A14 crates/pav_core/src/shape.rs\necho --- particles; sed -n 1,40p crates/pav_view/src/fx.rs; grep -n \"SimEvent::Splash\\|fn add_events\\|SimEvent::Explosion\" -A14 crates/pav_view/src/build.rs | head -70; grep -n \"Splash\\|dent\\|fn poke\\|fn splash\" crates/pav_view/src/water.rs | head -20;grep -n \"Splash\" crates/pav_view/src/*.rs crates/pav_core/src/*.rs | head","description":"Start the build; survey puppet, entity, prop and particle APIs"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016dXPQxRxRhUpezipHrn5kU","type":"tool_result","content":"/// Worn armour's look: helmet, shoulder plates, cape, gloves, belt buckle.\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct GearLook {\n    pub helm: HelmKind,\n    pub helm_color: String,\n    /// Shoulder plates (0 = none, 1 = full size) and their colour.\n    pub pauldrons: f32,\n    pub armor_color: String,\n    /// Cape (0 = none) and its colour.\n    pub cape: f32,\n    pub cape_color: String,\n    /// Glove and belt colours (\"\" = none).\n    pub gloves: String,\n    pub belt: String,\n    /// Enchanted shine on the helmet.\n    pub glow: f32,\n}\n\nimpl Default for GearLook {\n    fn default() -> Self {\n        Self {\n            helm: HelmKind::None,\n            helm_color: \"#8a8f99\".into(),\n            pauldrons: 0.0,\n            armor_color: \"#8a8f99\".into(),\n            cape: 0.0,\n            cape_color: \"#3a2f4a\".into(),\n            gloves: String::new(),\n            belt: String::new(),\n            glow: 0.0,\n        }\n    }\n}\n\nfn smooth(a: f32, b: f32, x: f32) -> f32 {\n    let t = ((x - a) / (b - a).max(1e-4)).clamp(0.0, 1.0);\n    t * t * (3.0 - 2.0 * t)\n}\n\n    pub enum BodyPlan {\n        #[default]\n        Biped => \"biped\",\n        Spider => \"spider\",\n        Lizard => \"lizard\",\n        Beetle => \"beetle\",\n        Blob => \"blob\",\n        /// Four legs under a raised body, a head on a neck: hounds, wolves, boars, the town dog.\n        Quadruped => \"quadruped\",\n    }\n}\n\n/// Proportions, colours and animation settings. Everything is a slider.\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct PuppetDef {\n    pub scale: f32,\n    pub head_radius: f32,\n    pub torso_length: f32,\n    pub torso_radius: f32,\n    pub hip_width: f32,\n    pub shoulder_width: f32,\n    pub leg_length: f32,\n    pub arm_length: f32,\n    pub limb_radius: f32,\n    pub skin: String,\n    pub shirt: String,\n    pub pants: String,\n    pub shoes: String,\n    pub eyes: String,\n    pub look: Look,\n    /// Metres travelled per full walk cycle (two steps).\n    pub stride: f32,\n    pub step_height: f32,\n    pub arm_swing: f32,\n    pub bob: f32,\n    pub lean: f32,\n\nfn wrap_angle(a: f32) -> f32 {\n    (a + std::f32::consts::PI).rem_euclid(std::f32::consts::TAU) - std::f32::consts::PI\n}\n\nimpl PuppetState {\n    pub fn update(&mut self, def: &PuppetDef, i: &AnimInput, dt: f32) {\n        self.time += dt;\n        let hspeed = Vec3::new(i.vel.x, 0.0, i.vel.z).length();\n        self.speed = approach(self.speed, hspeed, 14.0, dt);\n        let stride = (def.stride * def.scale).max(0.1);\n        self.act_side = side;\n    }\n\n    /// Plays motion clip `id` (`crate::clips::find`) with play `flags` at `speed` (0 = 1). The\n    /// clip playing before stays underneath while the new one fades in. Asking for the clip\n    /// already playing only updates its flags and speed.\n    pub fn play_clip(&mut self, id: u32, flags: u8, speed: f32) {\n        if id == 0 {\n            self.stop_clip();\n            return;\n        }\n        if id == self.clip && self.clip_flags & crate::clips::STOP == 0 {\n            self.clip_flags = flags & !crate::clips::STOP;\n            self.clip_speed = speed;\n            return;\n        }\n        if self.clip != 0 && self.clip_w > 0.0 {\n            self.clip2 = self.clip;\n            self.clip2_t = self.clip_t;\n            self.clip2_w = self.clip_w;\n            self.clip2_flags = self.clip_flags & !crate::clips::STOP;\n        }\n        self.clip = id;\n        self.clip_t = 0.0;\n        self.clip_w = 0.0;\n        self.clip_flags = flags & !crate::clips::STOP;\n        self.clip_speed = speed;\n    }\n\n    /// Plays clip `id` from its start even when it is the one playing (a second swing of the\n    /// same attack), the playing one fading out underneath.\n    pub fn replay_clip(&mut self, id: u32, flags: u8, speed: f32) {\n        if id != 0 && id == self.clip {\n            // Under itself: what plays now stays beneath while the new start fades in.\n            self.clip2 = self.clip;\n            self.clip2_t = self.clip_t;\n            self.clip2_w = self.clip_w;\n            self.clip2_flags = self.clip_flags & !crate::clips::STOP;\n            self.clip = 0;\n        }\n        self.play_clip(id, flags, speed);\n    }\n\n    /// Fades the clip out; the procedural animation takes over again.\n    pub fn stop_clip(&mut self) {\n        if self.clip != 0 {\n            self.clip_flags |= crate::clips::STOP;\n        }\n    }\n\n    /// Flinch away from a hit coming along `dir` (world), `strength` ~ 1 for a normal hit.\n    pub fn hit(&mut self, dir: Vec3, strength: f32) {\n        let (s, c) = self.facing.sin_cos();\n        let fwd = Vec3::new(s, 0.0, c);\n        let right = Vec3::new(c, 0.0, -s);\n        let d = Vec3::new(dir.x, 0.0, dir.z).normalize_or(-fwd);\n        let kick = 7.0 * strength.clamp(0.2, 3.0);\n        self.hit_vs += d.dot(right) * kick;\n        self.hit_vf += d.dot(fwd) * kick;\n        self.recoil = self.recoil.max(0.6 * strength.min(1.5));\n    }\n\n    /// Blends two states (for render interpolation).\n    pub fn lerp(&self, o: &PuppetState, t: f32) -> PuppetState {\n        let l = |a: f32, b: f32| a + (b - a) * t;\n        let lw = |a: f32, b: f32| {\n            let mut d = b - a;\n            if d > 0.5 {\n                d -= 1.0;\n            } else if d < -0.5 {\n                d += 1.0;\n            }\n            (a + d * t).rem_euclid(1.0)\n        };\n        PuppetState {\n            phase: lw(self.phase, o.phase),\npub fn body_motion(def: &PuppetDef, st: &PuppetState) -> (Quat, Vec3) {\n    let k = def.scale;\n    let fwd = Quat::from_rotation_y(st.facing) * Vec3::Z;\n    let right = Quat::from_rotation_y(st.facing) * Vec3::X;\n    let mut shift = Vec3::Y * st.lift;\n    if def.body != BodyPlan::Biped && st.act_kind != 0 {\n        // A creature's \"lunge\" springs the whole body forward (other moves lunge through the rig).\n        let table = crate::moves::table();\n        if table.get(st.act_kind).is_some_and(|m| m.name == \"lunge\") {\n            if let Some(f) = crate::moves::frame(&table, st.act_kind, st.act, st.act_hit, st.act_side) {\n                shift += fwd * (f.lunge / 0.25).clamp(-0.4, 1.0) * 0.45 * k;\n            }\n        }\n    }\n    let spin = (st.spin.abs() > 1e-4).then(|| Quat::from_rotation_y(st.spin));\n    let down = st.down.clamp(0.0, 1.0);\n    // A clip (a death fall) lays the body down itself; the procedural topple gives way to it.\n    // The sink comes after either (a body that lies where it fell, the hero's, stays at half).\n    let topple = (down > 0.0).then(|| Quat::from_axis_angle(right, -1.45 * smooth(0.0, 0.45, down) * (1.0 - st.clip_w)));\n    let sink = Vec3::Y * (-1.2 * k * smooth(0.55, 1.0, down));\n    (topple.unwrap_or(Quat::IDENTITY) * spin.unwrap_or(Quat::IDENTITY), shift + sink)\n}\n\n/// Camera-aware cheats applied to the finished parts: lean toward the camera, and the cutout\n/// look (the side view drawn flat on a card that faces the camera, mirrored by facing).\nfn camera_rules(def: &PuppetDef, facing: f32, feet: Vec3, cam_fwd: Vec3, parts: &mut [PuppetPart]) {\n    let flat_fwd = Vec3::new(cam_fwd.x, 0.0, cam_fwd.z);\n    let cam_right = Vec3::new(-flat_fwd.z, 0.0, flat_fwd.x).normalize_or(Vec3::X);\n    if def.face_camera > 0.0 {\n        let elev = (-cam_fwd.y).clamp(0.0, 1.0).asin();\n        let q = Quat::from_axis_angle(cam_right, elev * def.face_camera * 0.5);\n        for p in parts.iter_mut() {\n            p.a = feet + q * (p.a - feet);\n            p.b = feet + q * (p.b - feet);\n        }\n    }\n    if def.look == Look::Cutout {\n        // Character space -> card: forward maps to screen right (or left when facing left),\n        // up to the camera's up; depth shrinks to a thin layering offset.\n        let inv = Quat::from_rotation_y(facing).inverse();\n        let fwd_w = Quat::from_rotation_y(facing) * Vec3::Z;\n        let sign = if fwd_w.dot(cam_right) >= 0.0 { 1.0 } else { -1.0 };\n        let cam_up = cam_right.cross(cam_fwd).normalize_or(Vec3::Y);\n        let toward = -cam_fwd;\n        let card = |p: Vec3| -> Vec3 {\n            let l = inv * (p - feet);\n            feet + cam_right * (l.z * sign) + cam_up * l.y + toward * (-l.x * sign * 0.25)\n        };\n        for p in parts.iter_mut() {\n            p.a = card(p.a);\n            p.b = card(p.b);\n        }\n        // Small features (eyes, markings) inside a bigger ball sit on its front, so the flat\n    /// Direction of travel relative to facing (radians): the legs stride along it.\n    #[serde(default)]\n    pub travel: f32,\n    /// This character's own beat (0..1), so idle breathing and blinks don't march in step.\n    #[serde(default)]\n    pub seed: f32,\n    /// Motion clip (`crate::clips`): id (0 = none), time (seconds, not wrapped), how much of the\n    /// body it holds (fades in and out), play flags (`clips::UPPER`...) and speed (0 = 1).\n    #[serde(default)]\n    pub clip: u32,\n    #[serde(default)]\n    pub clip_t: f32,\n    #[serde(default)]\n    pub clip_w: f32,\n    #[serde(default)]\n    pub clip_flags: u8,\n    #[serde(default)]\n    pub clip_speed: f32,\n    /// The clip before, held under the new one while it fades in.\n    #[serde(default)]\n    pub clip2: u32,\n    #[serde(default)]\n    pub clip2_t: f32,\n    #[serde(default)]\n    pub clip2_w: f32,\n    #[serde(default)]\n    pub clip2_flags: u8,\n    /// A dodge was under way last tick (a captured dodge starts once per dodge).\n    #[serde(default)]\n    pub dodged: bool,\n}\n\n/// What the character is doing this tick (input to the animator).\n#[derive(Clone, Copy, Debug, Default)]\npub struct AnimInput {\n    pub vel: Vec3,\n    pub accel: Vec3,\n    pub grounded: bool,\n    pub crouch: bool,\n    pub crawl: bool,\n    pub climbing: bool,\n    pub facing: f32,\n    /// Landing impact speed this tick (m/s), 0 if none.\n    pub landed: f32,\n    pub jumped: bool,\n    pub swimming: bool,\n    pub rolling: bool,\n}\n\nfn approach(cur: f32, target: f32, rate: f32, dt: f32) -> f32 {\n    cur + (target - cur) * (1.0 - (-rate * dt).exp())\n}\n\n---- character\n300:pub struct Character {\n301-    pub vel: Vec3,\n302-    pub grounded: bool,\n303-    pub air_time: f32,\n304-    pub since_jump_press: f32,\n305-    pub jumping: bool,\n306-    pub posture: Posture,\n307-    pub crawl_toggle: bool,\n308-    pub climbing: Option<Ladder>,\n309-    /// Yaw in radians (0 = facing +Z).\n310-    pub facing: f32,\n311-    pub anim: PuppetState,\n312-    pub bomb_cooldown: f32,\n313-    /// Knockback applied on the next tick (explosions, hits).\n314-    pub impulse: Vec3,\n315-    #[serde(default)]\n316-    pub hang: Option<Hang>,\n317-    /// Seconds without ledge grabbing (after letting go).\n318-    #[serde(default)]\n319-    pub hang_cooldown: f32,\n320-    /// Committed model: dodge roll time left and direction.\n321-    #[serde(default)]\n322-    pub roll: f32,\n323-    #[serde(default)]\n324-    pub roll_dir: Vec3,\n325-    /// Grid model: tile centre being walked to, and ticks spent blocked.\n326-    #[serde(default)]\n327-    pub grid_target: Option<Vec3>,\n328-    #[serde(default)]\n329-    pub grid_blocked: u32,\n330-    /// Grid: pace of the current step (how far the stick was pushed when it began).\n331-    #[serde(default)]\n332-    pub grid_pace: f32,\n333-    /// Water depth at the feet (0 = dry) and whether swimming.\n334-    #[serde(default)]\n335-    pub water_depth: f32,\n336-    #[serde(default)]\n337-    pub swimming: bool,\n338-    /// Seconds without control (hits) and of invulnerability.\n339-    #[serde(default)]\n340-    pub stun: f32,\n471:pub fn tick(\n472-    st: &mut SimState,\n473-    id: EntityId,\n474-    input: &InputFrame,\n475-    mp: &MovementParams,\n476-    bp: &BombParams,\n477-    puppet: &PuppetDef,\n478-    prop_gravity: f32,\n479-    dt: f32,\n480-    events: &mut Vec<SimEvent>,\n481-    actions: &mut Vec<Action>,\n482-) {\n483-    let Some(ent) = st.entities.map.get_mut(&id) else { return };\n1166:    ch.anim.update(\n1212:                if crate::clips::run_over_walk(puppet, w, r, ground, ch.anim.clip == r) {\n1228:        let ours = ch.anim.clip == 0 || mine(ch.anim.clip) || ch.anim.clip_flags & crate::clips::STOP != 0;\n1233:            } else if mine(ch.anim.clip) {\n---- objects\n105:# prop = { ..., sway = \"leaves\" }   props (and [[object]]s) can sway: \"leaves\" | \"grass\"\n106-#\n107-# zone = { kind = \"...\", ... } makes the tile a trigger (identical neighbours merge):\n108-#   kind = \"start\" | \"finish\" | \"gate\" | \"checkpoint\" | \"kill\" | \"water\" | \"pad\" | \"camera\" |\n109-#          \"conveyor\" (facing = direction, speed = m/s; carries characters and props) |\n110-#          \"bounce\" (speed = launch m/s; trampolines for characters and props)\n111-#   course = \"name\"   start/finish/gates of one course share it; leaving START starts the timer,\n112-#                     gates must be passed in `index` order (missed gate = +2 s), FINISH stops it\n113-#   index = 1         gate order\n114-#   y0 = 0, y1 = 3    height range relative to the layer (kill zones in pits: e.g. y0 = -3, y1 = -1)\n115-#   label = \"TEXT\"    drawn on the floor (label_size = 0.5 to override the auto fit);\n116-#                     color = \"#rrggbb\" or \"none\"; facing = \"east\" (respawn direction)\n117-#   Zones are half-open boxes, so touching zones never overlap. A respawn point that lies in a\n118-#   zone does not trigger it (respawning onto START keeps the timer running).\n119-#   params = { \"movement.model\" = \"momentum\" }       pads: parameter changes until you leave\n120-#                     (\"view.bloom\" = 1.5 etc. change view settings the same way)\n121-#   signal = \"drop\"   pads: tells spawners listening for \"drop\" to fire\n122-#   note = \"...\"      pads: what it sets and what to look for (on screen while you stand on it;\n123-#                     required on every pad with params)\n124-#   camera = { set = { tilt = 90, ortho = true }, sweep = [{ param = \"tilt\", from = 90,\n125-#              to = 10, period = 12 }], flip_ortho = 6 }  pads (sticky) / camera zones (inside)\n126-#   water: swim below y1 (its surface ripples: a CPU wave simulation; neighbouring water tiles\n127-#   with the same top that form a rectangle ripple as one surface). kill: back to the last checkpoint.\n128-\n129-# Free text anywhere (layout space: x = column, y = height, z = row).\n130-# [[label]]\n131-# text = \"SIGN\"\n132-# pos = [5.0, 0.03, 3.0]\n133-# size = 0.6\n134-# mode = \"floor\"            # floor (turns to the camera) | wall (faces `facing`) | billboard\n135-# facing = \"south\"\n136-\n137-# Free-placed objects (keep them at the end of the file; edit mode rewrites this part).\n138:[[object]]\n139-name = \"ball\"\n140-shape = { type = \"sphere\", radius = 0.4 }\n141-pos = [3.5, 1.0, 3.5]           # x = column, y = height, z = row\n142-color = \"#5b8def\"\n143-body = \"dynamic\"                # dynamic | fixed | kinematic | none\n144-\n145-# Animated objects use body = \"kinematic\" and a behavior (vectors are in the object's own frame):\n146-#   behavior = { type = \"move\", offset = [0, 0, 4], period = 4, phase = 0, hold = 0.3, smooth = true }\n147-#     (hold = share of the cycle spent waiting, split between both ends)\n148-#   behavior = { type = \"rotate\", axis = [0, 1, 0], speed = 90 }                   (deg/s)\n149-#   behavior = { type = \"rotate\", axis = [1, 0, 0], swing = 60, period = 2, pivot = [0, 2, 0] }\n150-#   behavior = { type = \"spin\", speed = 1.5 }                                       (rad/s)\n151-# Projectile emitters (body = \"none\", or \"fixed\" with a slim shape; bullets ignore their emitter):\n152-#   behavior = { type = \"emitter\", pattern = \"aimed\", interval = 1.0, count = 1, spread = 0,\n153-#                speed = 6, radius = 0.15, height = 0, range = 30, delay = 0, burst = 0, pause = 1,\n154-#                color = \"#ff5a3c\", knockback = 6, gravity = 0, spin = 12, life = 6 }\n155-#     pattern: aimed (at the player) | forward (+Z of the object, see yaw) | ring | spiral | random\n156-# Touching a hazard knocks you back (respawn = true sends you to the last checkpoint):\n157-#   hazard = { knockback = 7, respawn = false }\n158-# Spawners drop props on a timer and/or when a pad sends their signal (body = \"none\"):\n159-#   behavior = { type = \"spawner\", shape = { type = \"box\", half = [0.3, 0.3, 0.3] }, color = \"\",\n160-#                count = 20, interval = 0, max = 200, area = [1.5, 0.5, 1.5], signal = \"drop\",\n161-#                clear = \"clear\", density = 1, friction = 0.5, restitution = 0.1, tumble = true }\n162-#     (pending = 1 drops one batch on the first tick, so the room starts with its props)\n163-# The store's catalogue (rooms/catalogue.toml; body = \"none\"): a pad's signal lays out the next\n164-# page of the store's object rows (embedded, then the committed packs on disk, then the shipped\n165-# packs the disk lacks), each beside a 1.8 m figure with its row; `back` pages back; toward = -1\n166-# grows the page toward -z with its first line at the object (put it by the pads):\n167-#   behavior = { type = \"catalogue\", signal = \"next\", back = \"back\", per_page = 20, columns = 5 }\n168-# The clip browser (rooms/clip_browser.toml; body = \"none\"): every [[npc]] whose name starts with\n169-# `cast` plays the same clip; pads step through the library, jump to a set's first clip or toggle\n170-# auto-play, and the clip's card lies on the floor at the object:\n171-#   behavior = { type = \"clip_browser\", next = \"clip_next\", back = \"clip_back\", auto = \"clip_auto\",\n172-#                cast = \"cast\", hold = 5, start = \"QUATERNIUS/Idle_Loop\",\n173-#                sets = [[\"clip_set_cmu\", \"CMU\"], [\"clip_set_quaternius\", \"QUATERNIUS\"]] }\n174-# An imported figure (a shipped pack's, e.g. LIB/kaykit_adventurers/knight) can wear any biped\n--- spawn\n21:pub struct PropInstance {\n22:    pub asset: String,\n25:    pub definition: Arc<PropDef>,\n26:    pub scale: f32,\n28:    pub collide: bool,\n32:    pub seed: u32,\n36:    pub roles: BTreeMap<String, String>,\n39:    pub params: props::Params,\n43:    pub patch: Vec<serde_json::Value>,\n51:pub struct PropFrame {\n55:    pub owner: String,\n56:    pub definition: Arc<PropDef>,\n58:    pub parts: Arc<CompiledProp>,\n59:    pub scale: f32,\n60:    pub roles: BTreeMap<String, String>,\ncrates/pav_core/src/statics.rs:532:    pub fn add_prop_to(&mut self, physics: &mut PhysicsState, key: RegionKey, mut prop: StaticProp) -> Result<(), String> {\ncrates/pav_core/src/statics.rs:548:    pub fn add_prop(&mut self, physics: &mut PhysicsState, prop: StaticProp) -> Result<RegionKey, String> {\ncrates/pav_core/src/statics.rs:562:    pub fn prop_count(&self) -> usize {\ncrates/pav_core/src/prop_instance.rs:128:    pub fn with_params(mut self, params: &props::Params) -> Result<Self, String> {\ncrates/pav_core/src/prop_instance.rs:235:    pub fn rebuild_prop_defs(&mut self) {\ncrates/pav_core/src/prop_instance.rs:254:    pub fn spawn_prop(\ncrates/pav_core/src/prop_instance.rs:269:    pub fn place_prop(\ncrates/pav_core/src/prop_instance.rs:283:    pub fn restyle_prop(\ncrates/pav_core/src/prop_instance.rs:308:    pub fn update_prop_instance(&mut self, id: EntityId, pos: Vec3, rot: Quat, scale: f32, collide: bool) -> Result<(), String> {\ncrates/pav_core/src/prop_instance.rs:326:    pub fn refresh_prop_instances(&mut self, name: &str, definition: Arc<PropDef>) -> usize {\n37:pub enum Behavior {\n38-    #[default]\n39-    None,\n40-    /// Drops random props over an area, keeping at most `max` alive.\n41-    Rain {\n