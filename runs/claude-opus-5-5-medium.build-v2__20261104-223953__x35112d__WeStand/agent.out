{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U71pzLLmUtqYvMvtoUXpd3","type":"tool_result","content":"375\t            },\n376\t        );\n377\t        id\n378\t    }\n379\t\n380\t    /// Creates a non-player character with its own look and (optionally) a brain.\n381\t    pub fn spawn_npc(\n382\t        &mut self,\n383\t        name: &str,\n384\t        feet: Vec3,\n385\t        facing: f32,\n386\t        def: PuppetDef,\n387\t        ai: Option<crate::ai::Ai>,\n388\t        region: Option<crate::statics::RegionKey>,\n389\t    ) -> EntityId {\n390\t        let id = self.spawn_character(name, feet);\n391\t        if let Some(e) = self.state.entities.get_mut(id) {\n392\t            e.region = region;\n393\t            e.ai = ai.map(Box::new);\n394\t            if let Some(ch) = &mut e.character {\n395\t                ch.facing = facing;\n396\t                ch.anim.facing = facing;\n397\t                ch.puppet = Some(std::sync::Arc::new(def));\n398\t            }\n399\t        }\n400\t        id\n401\t    }\n402\t\n403\t    /// A character's kinematic capsule (when it is created or wakes up).\n404\t    pub(crate) fn character_body(&mut self, id: EntityId, center: Vec3, posture: character::Posture) -> RigidBodyHandle {\n405\t        let body = RigidBodyBuilder::kinematic_position_based().translation(center);\n406\t        let collider =\n407\t            ColliderBuilder::capsule_y(posture.half_height() as Real, RADIUS as Real).friction(0.0).user_data(entity_tag(id.0));\n408\t        self.state.physics.insert(body, collider).0\n409\t    }\n410\t\n411\t    /// Spawns the player at the scene's spawn point and makes the camera follow it.\n412\t    pub fn spawn_player(&mut self) -> EntityId {\n413\t        let id = self.spawn_character(\"player\", self.state.spawn);\n414\t        self.state.player = Some(id);\n415\t        id\n416\t    }\n417\t\n418\t    /// Where an entity stands: a character's feet (its `pos` is the capsule's centre), else\n419\t    /// its position.\n420\t    pub fn feet(&self, id: EntityId) -> Option<Vec3> {\n421\t        let e = self.state.entities.get(id)?;\n422\t        Some(match &e.character {\n423\t            Some(c) => e.pos - Vec3::Y * c.height() * 0.5,\n424\t            None => e.pos,\n425\t        })\n426\t    }\n427\t\n428\t    pub fn player(&self) -> Option<&Entity> {\n429\t        self.state.player.and_then(|id| self.state.entities.get(id))\n430\t    }\n431\t\n432\t    pub fn despawn(&mut self, id: EntityId) -> bool {\n433\t        match self.state.entities.map.remove(&id) {\n434\t            Some(e) => {\n435\t                if e.prop.is_some() {\n436\t                    self.invalidate_prop_navigation();\n437\t                }\n438\t                if let Some(b) = e.body {\n439\t                    self.state.physics.remove_body(b);\n440\t                }\n441\t                if let Some(h) = e.soft.and_then(|s| s.handle) {\n442\t                    self.state.physics.remove_soft(h);\n443\t                }\n444\t                if self.state.player == Some(id) {\n445\t                    self.state.player = None;\n446\t                }\n447\t                true\n448\t            }\n449\t            None => false,\n450\t        }\n451\t    }\n452\t\n453\t    /// Moves an entity (teleport), resetting its velocity. For characters `pos` is the feet.\n454\t    pub fn set_position(&mut self, id: EntityId, pos: Vec3) -> bool {\n455\t        let Some(e) = self.state.entities.map.get_mut(&id) else { return false };\n456\t        let center = match &mut e.character {\n457\t            Some(ch) => {\n458\t                ch.vel = Vec3::ZERO;\n459\t                ch.impulse = Vec3::ZERO;\n460\t                ch.stun = 0.0;\n461\t                ch.roll = 0.0;\n462\t                ch.hang = None;\n463\t                ch.grid_target = None;\n464\t                ch.climbing = None;\n465\t                pos + Vec3::Y * (ch.height() * 0.5 + character::PLACE_LIFT)\n466\t            }\n467\t            None => pos,\n468\t        };\n469\t        e.pos = center;\n470\t        if self.state.player == Some(id) {\n471\t            self.state.focus = center;\n472\t        }\n473\t        if let Some(b) = e.body.and_then(|h| self.state.physics.bodies.get_mut(h)) {\n474\t            b.set_translation(center, true);\n475\t            if b.is_kinematic() {\n476\t                b.set_next_kinematic_translation(center);\n477\t            }\n478\t            b.set_linvel(Vector::ZERO, true);\n479\t            b.set_angvel(Vector::ZERO, true);\n480\t        }\n481\t        if e.prop.is_some() {\n482\t            self.invalidate_prop_navigation();\n483\t        }\n484\t        true\n485\t    }\n486\t\n487\t    /// Advances one fixed tick, recording the input for rewind and replays.\n488\t    pub fn step(&mut self, input: &InputFrame) {\n489\t        let dt = self.dt();\n490\t        match self.studio_mode() {\n491\t            crate::prop_preview::StudioMode::Animation => {\n492\t                if let Some(preview) = &mut self.state.animation_preview {\n493\t                    preview.advance(dt);\n494\t                }\n495\t                return;\n496\t            }\n497\t            crate::prop_preview::StudioMode::Prop => {\n498\t                if let Some(preview) = &mut self.state.prop_preview {\n499\t                    preview.advance(dt);\n500\t                }\n501\t                return;\n502\t            }\n503\t            crate::prop_preview::StudioMode::Creature => {\n504\t                if let Some(preview) = &mut self.state.creature_preview {\n505\t                    preview.advance(dt);\n506\t                }\n507\t                return;\n508\t            }\n509\t            crate::prop_preview::StudioMode::World => {}\n510\t        }\n511\t        if self.history.enabled && self.config.history_seconds > 0.0 {\n512\t            self.history.window = (self.config.history_seconds * self.config.tick_rate.hz() as f32) as u64;\n513\t            self.history.record(&self.state, input);\n514\t        }\n515\t        if self.recording.ticks() < MAX_RECORDING_TICKS {\n516\t            self.recording.push(input);\n517\t        }\n518\t        self.step_inner(input);\n519\t    }\n520\t\n521\t    fn step_inner(&mut self, input: &InputFrame) {\n522\t        // Hit-stop slows the whole world for a moment.\n523\t        let raw_dt = self.dt();\n524\t        let dt = raw_dt * self.game_time_scale();\n525\t        self.state.physics.params.dt = dt as Real;\n526\t        self.state.physics.gravity = Vector::new(0.0, -self.config.gravity as Real, 0.0);\n527\t\n528\t        // Behaviours set this tick's velocities of moving objects; characters then move\n529\t        // (rapier's controller carries them with kinematic platforms) and the physics step\n530\t        // advances everything together.\n531\t        self.run_behaviors(dt);\n532\t\n533\t        // Getting in and out of vehicles.\n534\t        self.vehicle_interact(input);\n535\t\n536\t        // The game decides what the hero and its monsters do this tick.\n537\t        let mut events = Vec::new();\n538\t        let mut game_inputs = self.game_pre(input, dt, &mut events);\n539\t        game_inputs.extend(self.play_pre(input, dt, &mut events));\n540\t\n541\t        // Characters.\n542\t        let ids: Vec<EntityId> = self.state.entities.iter().filter(|e| e.character.is_some()).map(|e| e.id).collect();\n543\t        let mut actions = Vec::new();\n544\t        let idle = InputFrame::default();\n545\t        let player_feet = self.player().and_then(|p| Some(p.pos - Vec3::Y * p.character.as_ref()?.height() * 0.5));\n546\t        let all_feet: Vec<Vec3> =\n547\t            self.state.entities.iter().filter_map(|e| Some(e.pos - Vec3::Y * e.character.as_ref()?.height() * 0.5)).collect();\n548\t        let mut fallen = Vec::new();\n549\t        for id in ids {\n550\t            let npc_input: InputFrame;\n551\t            let inp = if let Some(gi) = game_inputs.get(&id) {\n552\t                gi\n553\t            } else if Some(id) == self.state.player {\n554\t                input\n555\t            } else {\n556\t                // Non-player characters: their brain drives them like a player would.\n557\t                let st = &mut self.state;\n558\t                match st.entities.map.get_mut(&id) {\n559\t                    Some(e) if e.ai.is_some() => {\n560\t                        let feet = e.pos - Vec3::Y * e.character.as_ref().map(|c| c.height() * 0.5).unwrap_or(0.0);\n561\t                        let ai = e.ai.as_mut().unwrap();\n562\t                        if feet.y < crate::course::FALL_LIMIT {\n563\t                            fallen.push((id, ai.home));\n564\t                        }\n565\t                        npc_input = ai.think(feet, player_feet, &all_feet, &mut st.rng, dt);\n566\t                        if let (Some(f), Some(ch)) = (ai.rest_facing(), e.character.as_mut()) {\n567\t                            if ch.stun <= 0.0 {\n568\t                                ch.facing = f;\n569\t                            }\n570\t                        }\n571\t                        if let (Some(p), Some(ch)) = (ai.perform.as_mut(), e.character.as_mut()) {\n572\t                            p.tick(&mut ch.anim, dt, &self.config.anim);\n573\t                        }\n574\t                        &npc_input\n575\t                    }\n576\t                    _ => &idle,\n577\t                }\n578\t            };\n579\t            let own = self.state.entities.get(id).and_then(|e| e.character.as_ref()).and_then(|c| c.puppet.clone());\n580\t            character::tick(\n581\t                &mut self.state,\n582\t                id,\n583\t                inp,\n584\t                &self.config.movement,\n585\t                &self.config.bombs,\n586\t                own.as_deref().unwrap_or(&self.config.puppet),\n587\t                self.config.gravity,\n588\t                dt,\n589\t                &mut events,\n590\t                &mut actions,\n591\t            );\n592\t        }\n593\t        for (id, home) in fallen {\n594\t            self.set_position(id, home);\n595\t        }\n596\t        self.update_guards(dt, &mut events);\n597\t        for a in actions {\n598\t            match a {\n599\t                Action::ThrowBomb { from, vel, owner } => {\n600\t                    self.throw_bomb(from, vel, owner);\n601\t                    events.push(SimEvent::Throw { pos: from });\n602\t                }\n603\t                Action::Hit { id, at, dir, knockback, respawn } => {\n604\t                    self.hit_character(id, at, dir, knockback, respawn, &mut events)\n605\t                }\n606\t                Action::Shoot { from, vel, owner } => {\n607\t                    self.state.projectiles.spawn(crate::projectile::Projectile {\n608\t                        pos: from,\n609\t                        vel,\n610\t                        radius: 0.09,\n611\t                        life: self.config.bombs.shot_range / vel.length().max(0.1),\n612\t                        color: Color::hex(\"#9ef0ff\"),\n613\t                        knockback: 0.0,\n614\t                        gravity: 0.0,\n615\t                        owner: Some(owner),\n616\t                        team: crate::projectile::Team::Player,\n617\t                        damage: 1.0,\n618\t                    });\n619\t                    events.push(SimEvent::Shot { pos: from });\n620\t                }\n621\t            }\n622\t        }\n623\t        self.drive_vehicles(input, dt);\n624\t        self.zone_props(dt);\n625\t        let collector = EventCollector::default();\n626\t        self.state.physics.step(&mut self.pipeline, &collector);\n627\t        self.sync_from_physics();\n628\t        self.seat_riders();\n629\t        let contacts = collector.contacts.into_inner().unwrap_or_default();\n630\t        if !contacts.is_empty() {\n631\t            self.break_blocks(contacts, &mut events);\n632\t        }\n633\t        self.update_crumbles(dt, &mut events);\n634\t\n635\t        // Bombs and debris.\n636\t        let mut blasts = Vec::new();\n637\t        let mut expired = Vec::new();\n638\t        let settle_after = self.config.bombs.fuse - self.config.bombs.flight_time - 0.05;\n639\t        for e in self.state.entities.map.values_mut() {\n640\t            if let Some(b) = &mut e.bomb {\n641\t                b.fuse -= dt;\n642\t                if b.fuse <= 0.0 {\n643\t                    blasts.push((e.id, e.pos, b.radius));\n644\t                } else if b.fuse < settle_after {\n645\t                    // After the throw arc, bombs stop where they landed instead of rolling away.\n646\t                    if let Some(body) = e.body.and_then(|h| self.state.physics.bodies.get_mut(h)) {\n647\t                        let v = body.linvel();\n648\t                        body.set_linvel(Vec3::new(v.x * 0.8, v.y, v.z * 0.8), false);\n649\t                        body.set_angvel(body.angvel() * 0.8, false);\n650\t                    }\n651\t                }\n652\t            }\n653\t            if let Some(l) = &mut e.lifetime {\n654\t                *l = l.saturating_sub(1);\n655\t                if *l == 0 {\n656\t                    expired.push(e.id);\n657\t                }\n658\t            }\n659\t        }\n660\t        for (id, pos, radius) in blasts {\n661\t            self.despawn(id);\n662\t            self.explode(pos, radius, &mut events);\n663\t        }\n664\t        for id in expired {\n665\t            self.despawn(id);\n666\t        }\n667\t\n668\t        // Shootable things: sway, hit flash.\n669\t        self.update_health(dt);\n670\t\n671\t        // Projectiles.\n672\t        if !self.state.projectiles.list.is_empty() {\n673\t            let hitbox = self.config.movement.hitbox;\n674\t            let player = self.state.player;\n675\t            let targets: Vec<Target> = self\n676\t                .state\n677\t                .entities\n678\t                .iter()\n679\t                .filter_map(|e| {\n680\t                    let c = e.character.as_ref()?;\n681\t                    let radius = if Some(e.id) == player { hitbox } else { RADIUS };\n682\t                    Some(Target { id: e.id, feet: e.pos - Vec3::Y * c.height() * 0.5, height: c.height(), radius })\n683\t                })\n684\t                .collect();\n685\t            let enemies: Vec<crate::projectile::Enemy> = self\n686\t                .state\n687\t                .entities\n688\t                .iter()\n689\t                .filter(|e| e.health.is_some())\n690\t                .map(|e| crate::projectile::Enemy {\n691\t                    id: e.id,\n692\t                    center: e.pos,\n693\t                    radius: e.visual.as_ref().map(|v| v.shape.half_extents().max_element()).unwrap_or(0.5),\n694\t                })\n695\t                .collect();\n696\t            let physics = &self.state.physics;\n697\t            let entities = &self.state.entities;\n698\t            let out = self.state.projectiles.step(dt, &targets, &enemies, |from, dir, len, owner| {\n699\t                let ignore = owner.and_then(|id| entities.get(id)).and_then(|e| e.body);\n700\t                crate::projectile::static_blocked(physics, from, dir, len, ignore)\n701\t            });\n702\t            for (id, at, dir, kb) in out.hits {\n703\t                self.hit_character(id, at, dir, kb, false, &mut events);\n704\t            }\n705\t            for (id, at, dmg) in out.damage {\n706\t                self.damage(id, at, dmg, &mut events);\n707\t            }\n708\t        }\n709\t\n710\t        self.game_post(dt, raw_dt, &mut events);\n711\t        self.play_post(dt, &mut events);\n712\t        self.game_travel(&mut events);\n713\t\n714\t        if let Some(p) = self.player() {\n715\t            self.state.focus = p.pos;\n716\t        }\n717\t        self.update_zones(&mut events);\n718\t        self.measure_feel(input);\n719\t        self.update_room_tracking(&mut events);\n720\t        if self.state.tick.is_multiple_of(15) {\n721\t            self.update_streaming(2);\n722\t        }\n723\t        self.state.tick += 1;\n724\t        if !self.replaying {\n725\t            self.events.extend(events);\n726\t        }\n727\t    }\n728\t\n729\t    fn measure_feel(&mut self, input: &InputFrame) {\n730\t        let Some(e) = self.player() else { return };\n731\t        let Some(ch) = e.character.as_ref() else { return };\n732\t        let (vel, grounded, feet) =\n733\t            (ch.vel, ch.grounded || ch.climbing.is_some() || ch.hang.is_some(), e.pos - Vec3::Y * ch.height() * 0.5);\n734\t        let dt = self.dt();\n735\t        let tick = self.state.tick;\n736\t        self.state.feel.update(tick, dt, input.move_dir, vel, feet, grounded);\n737\t    }\n738\t\n739\t    fn throw_bomb(&mut self, from: Vec3, vel: Vec3, owner: EntityId) {\n740\t        let mut v = Visual::new(Shape::Sphere { radius: 0.2 }, Color::hex(\"#2b2d35\"));\n741\t        v.look = Look::Lit;\n742\t        let id = self.spawn(Spawn::new(\"bomb\", from).visual(v).body(BodyKind::Dynamic).restitution(0.15));\n743\t        if let Some(e) = self.state.entities.get_mut(id) {\n744\t            e.bomb = Some(Bomb { fuse: self.config.bombs.fuse, radius: self.config.bombs.radius, owner: Some(owner) });\n745\t            if let Some(b) = e.body.and_then(|h| self.state.physics.bodies.get_mut(h)) {\n746\t                b.set_linvel(vel, true);\n747\t                b.enable_ccd(true);\n748\t            }\n749\t        }\n750\t    }\n751\t\n752\t    /// Removes destructible blocks in the radius, throws debris and pushes things away.\n753\t    pub fn explode(&mut self, pos: Vec3, radius: f32, events: &mut Vec<SimEvent>) {\n754\t        let hit = self.state.statics.blocks_in_sphere(pos, radius);\n755\t        let mut debris = Vec::new();\n756\t        for r in hit {\n757\t            if !self.state.statics.get(r).is_some_and(|b| b.has(block_flags::DESTRUCTIBLE)) {\n758\t                continue;\n759\t            }\n760\t            let st = &mut self.state;\n761\t            if let Some(b) = st.statics.destroy(&mut st.physics, r) {\n762\t                debris.push((b.center(), b.half(), b.color));\n763\t            }\n764\t        }\n765\t        for (c, half, color) in debris {\n766\t            let n = 3 + self.state.rng.below(3);\n767\t            for _ in 0..n {\n768\t                let rng = &mut self.state.rng;\n769\t                let off = Vec3::new(rng.range(-half.x, half.x), rng.range(-half.y, half.y), rng.range(-half.z, half.z));\n770\t                let size = Vec3::new(rng.range(0.08, 0.2), rng.range(0.06, 0.14), rng.range(0.08, 0.2));\n771\t                let out = (c + off - pos).normalize_or(Vec3::Y);\n772\t                let vel = out * rng.range(2.0, 6.0) + Vec3::Y * rng.range(1.0, 4.0);\n773\t                let life = (rng.range(2.5, 4.0) * self.config.tick_rate.hz() as f32) as u32;\n774\t                let rot = Quat::from_euler(glam::EulerRot::XYZ, rng.range(0.0, 3.0), rng.range(0.0, 3.0), 0.0);\n775\t                let id = self.spawn(\n776\t                    Spawn::new(\"~debris\", c + off)\n777\t                        .visual(Visual::new(Shape::Box { half: size }, color))\n778\t                        .body(BodyKind::Dynamic)\n779\t                        .rot(rot),\n780\t                );\n781\t                if let Some(e) = self.state.entities.get_mut(id) {\n782\t                    e.lifetime = Some(life);\n783\t                    if let Some(b) = e.body.and_then(|h| self.state.physics.bodies.get_mut(h)) {\n784\t                        b.set_linvel(vel, true);\n785\t                    }\n786\t                }\n787\t            }\n788\t        }\n789\t        // Push props and characters.\n790\t        let push = self.config.bombs.push;\n791\t        let reach = radius * 2.5;\n792\t        for e in self.state.entities.map.values_mut() {\n793\t            let d = e.pos - pos;\n794\t            let dist = d.length();\n795\t            if dist > reach || e.bomb.is_some() {\n796\t                continue;\n797\t            }\n798\t            let fall = 1.0 - dist / reach;\n799\t            let dir = (d + Vec3::Y * 0.5).normalize_or(Vec3::Y);\n800\t            if let Some(h) = e.soft.as_ref().and_then(|s| s.handle) {\n801\t                // Soft bodies: every particle in reach gets kicked away from the blast.\n802\t                if let Some(sb) = self.state.physics.soft_bodies.get_mut(h) {\n803\t                    let pv: Vec<(Vec3, Vec3)> = sb.particle_positions().zip(sb.particle_velocities()).collect();\n804\t                    for (i, (p, v)) in pv.into_iter().enumerate() {\n805\t                        let d = p - pos;\n806\t                        let f = 1.0 - d.length() / reach;\n807\t                        if f > 0.0 {\n808\t                            sb.set_particle_velocity(i, v + (d + Vec3::Y * 0.5).normalize_or(Vec3::Y) * push * f);\n809\t                        }\n810\t                    }\n811\t                }\n812\t                continue;\n813\t            }\n814\t            if let Some(ch) = &mut e.character {\n815\t                ch.impulse += dir * push * fall;\n816\t                ch.stun = ch.stun.max(0.25 * fall);\n817\t                ch.hang = None;\n818\t                ch.anim.hit(dir, 0.5 + 1.5 * fall);\n819\t            } else if let Some(b) = e.body.and_then(|h| self.state.physics.bodies.get_mut(h)) {\n820\t                if b.is_dynamic() {\n821\t                    let m = b.mass();\n822\t                    b.apply_impulse(dir * push * fall * m, true);\n823\t                }\n824\t            }\n825\t        }\n826\t        self.state.physics.wake_near(pos, reach + 4.0);\n827\t        events.push(SimEvent::Explosion { pos, radius });\n828\t    }\n829\t\n830\t    /// Runs `n` ticks with the same input.\n831\t    pub fn run(&mut self, n: u64, input: &InputFrame) {\n832\t        for _ in 0..n {\n833\t            self.step(input);\n834\t        }\n835\t    }\n836\t\n837\t    /// Takes the events produced since the last call.\n838\t    pub fn drain_events(&mut self) -> Vec<SimEvent> {\n839\t        std::mem::take(&mut self.events)\n840\t    }\n841\t\n842\t    // ------------------------------------------------------------------ time travel\n843\t\n844\t    /// Shows the world as it was at `target` (restore + re-simulate). The recorded future is\n845\t    /// kept until `commit_rewind`, so scrubbing forward again works.\n846\t    pub fn rewind_to(&mut self, target: u64) -> bool {\n847\t        let Some(snap) = self.history.snapshots.iter().rev().find(|s| s.tick <= target).cloned() else { return false };\n848\t        self.restore(snap);\n849\t        self.replaying = true;\n850\t        while self.state.tick < target {\n851\t            let Some(input) = self.history.input_at(self.state.tick) else { break };\n852\t            self.step_inner(&input);\n853\t        }\n854\t        self.replaying = false;\n855\t        true\n856\t    }\n857\t\n858\t    /// Starts a new timeline from the current tick (drops the recorded future).\n859\t    pub fn commit_rewind(&mut self) {\n860\t        let t = self.state.tick;\n861\t        self.history.truncate_after(t);\n862\t        // The replay recording restarts from scratch semantics: keep inputs up to `t`.\n863\t        let mut r = Replay { scene: self.recording.scene.clone(), seed: self.recording.seed, ..Default::default() };\n864\t        for (i, f) in self.recording.iter().enumerate() {\n865\t            if i as u64 >= t {\n866\t                break;\n867\t            }\n868\t            r.push(f);\n869\t        }\n870\t        self.recording = r;\n871\t    }\n872\t\n873\t    /// Saves the full state to a file (binary).\n874\t    pub fn save_state(&self, path: &Path) -> Result<()> {\n875\t        let mut bytes = Vec::new();\n876\t        ciborium::into_writer(&self.snapshot(), &mut bytes).context(\"serializing state\")?;\n877\t        if let Some(d) = path.parent().filter(|d| !d.as_os_str().is_empty()) {\n878\t            std::fs::create_dir_all(d)?;\n879\t        }\n880\t        std::fs::write(path, bytes).with_context(|| format!(\"writing {}\", path.display()))\n881\t    }\n882\t\n883\t    pub fn load_state(&mut self, path: &Path) -> Result<()> {\n884\t        let bytes = std::fs::read(path).with_context(|| format!(\"reading {}\", path.display()))?;\n885\t        let state: SimState = ciborium::from_reader(&bytes[..]).context(\"snapshot file is invalid or from another version\")?;\n886\t        self.restore(state);\n887\t        self.history.clear();\n888\t        Ok(())\n889\t    }\n890\t\n891\t    // ------------------------------------------------------------------ internals\n892\t\n893\t    fn sync_from_physics(&mut self) {\n894\t        let ph = &self.state.physics;\n895\t        for e in self.state.entities.map.values_mut() {\n896\t            if let Some(b) = e.body.and_then(|h| ph.bodies.get(h)) {\n897\t                e.pos = b.translation();\n898\t                e.rot = *b.rotation();\n899\t            } else if let Some(sb) = e.soft.as_ref().and_then(|s| s.handle).and_then(|h| ph.soft_bodies.get(h)) {\n900\t                e.pos = sb.center_of_mass();\n901\t            }\n902\t        }\n903\t    }\n904\t\n905\t    /// Adds a joint owned by `owner` (to `link.other`, or the world) and creates it now if both\n906\t    /// bodies exist.\n907\t    pub fn add_joint(&mut self, owner: EntityId, link: crate::joints::JointLink) -> bool {\n908\t        let Some(a) = self.state.entities.get(owner).and_then(|e| e.body) else { return false };\n909\t        let b = match link.other {\n910\t            Some(o) => match self.state.entities.get(o).and_then(|e| e.body) {\n911\t                Some(b) => Some(b),\n912\t                None => return false,\n913\t            },\n914\t            None => None,\n915\t        };\n916\t        self.state.physics.insert_joint(a, b, &link);\n917\t        if let Some(e) = self.state.entities.get_mut(owner) {\n918\t            e.joints.push(link);\n919\t        }\n920\t        true\n921\t    }\n922\t\n923\t    /// Recreates the joints of the given entities (after their region wakes up).\n924\t    pub(crate) fn restore_joints(&mut self, ids: &[EntityId]) {\n925\t        for id in ids {\n926\t            let Some(e) = self.state.entities.get(*id) else { continue };\n927\t            let Some(a) = e.body else { continue };\n928\t            for link in e.joints.clone() {\n929\t                let b = match link.other {\n930\t                    Some(o) => match self.state.entities.get(o).and_then(|x| x.body) {\n931\t                        Some(b) => Some(b),\n932\t                        None => continue,\n933\t                    },\n934\t                    None => None,\n935\t                };\n936\t                self.state.physics.insert_joint(a, b, &link);\n937\t            }\n938\t        }\n939\t    }\n940\t\n941\t    pub fn frame(&mut self) -> RenderFrame {\n942\t        if *self.config_arc != self.config {\n943\t            self.config_arc = std::sync::Arc::new(self.config.clone());\n944\t        }\n945\t        match self.studio_mode() {\n946\t            crate::prop_preview::StudioMode::Animation => {\n947\t                if let Some(preview) = &self.state.animation_preview {\n948\t                    return preview.frame(self.config_arc.clone(), self.dt(), self.live_edit_ticket);\n949\t                }\n950\t            }\n951\t            crate::prop_preview::StudioMode::Prop => {\n952\t                if let Some(preview) = &self.state.prop_preview {\n953\t                    return preview.frame(self.config_arc.clone(), self.dt(), self.live_edit_ticket);\n954\t                }\n955\t            }\n956\t            crate::prop_preview::StudioMode::Creature => {\n957\t                return match &self.state.creature_preview {\n958\t                    Some(preview) => preview.frame(self.config_arc.clone(), self.dt(), self.live_edit_ticket),\n959\t                    None => crate::creature_preview::empty_frame(self.config_arc.clone(), self.dt(), self.live_edit_ticket),\n960\t                };\n961\t            }\n962\t            crate::prop_preview::StudioMode::World => {}\n963\t        }\n964\t        let room = self\n965\t            .state\n966\t            .world\n967\t            .current_room\n968\t            .and_then(|i| self.state.world.rooms.get(i as usize))\n969\t            .map(|r| crate::frame::RoomInfo { id: r.id, key: r.key.clone(), def: r.def.clone(), quarters: r.place.quarters });\n970\t        let c = &self.state.courses;\n971\t        let invuln = self.player().and_then(|p| p.character.as_ref()).map(|c| c.invuln).unwrap_or(0.0);\n972\t        let hud = crate::frame::HudFrame {\n973\t            course: c.hud(self.state.tick, self.dt()),\n974\t            last_result: c.last.clone(),\n975\t            message: c.message.clone(),\n976\t            feel: self.state.feel.report,\n977\t            cue: c.cue(),\n978\t            cue_serial: c.cue_serial,\n979\t            invuln,\n980\t            model: crate::params::ChoiceParam::name(self.config.movement.model).to_string(),\n981\t            physics: self.physics_stats(),\n982\t            view: c.view.clone(),\n983\t            view_serial: c.view_serial,\n984\t            boss: self.boss_bar(),\n985\t            pad_note: c.pad_note.clone(),\n986\t            lines: self.play_hud(),\n987\t        };\n988\t        RenderFrame {\n989\t            tick: self.state.tick,\n990\t            time: self.time(),\n991\t            dt: self.dt(),\n992\t            live_edit_ticket: self.live_edit_ticket,\n993\t            objects: self\n994\t                .state\n995\t                .entities\n996\t                .iter()\n997\t                .filter_map(|e| {\n998\t                    let puppet = e.character.as_ref().filter(|c| c.riding.is_none()).map(|c| PuppetFrame {\n999\t                        state: c.anim,\n1000\t                        feet_offset: c.height() * 0.5,\n1001\t                        def: c.puppet.clone(),\n1002\t                        rig: c.rig.as_ref().map(|r| r.view()),\n1003\t                        tint: self.state.game.as_ref().and_then(|g| g.tint(e.id)),\n1004\t                    });\n1005\t                    if e.visual.is_none() && puppet.is_none() {\n1006\t                        return None;\n1007\t                    }\n1008\t                    let mut visual = e.visual.clone().unwrap_or(Visual::new(Shape::Sphere { radius: 0.0 }, Color::WHITE));\n1009\t                    if e.health.as_ref().is_some_and(|h| h.flash > 0.0) {\n1010\t                        // Hit flash.\n1011\t                        visual.color = Color::WHITE;\n1012\t                        visual.emissive = visual.emissive.max(0.45);\n1013\t                    }\n1014\t                    let pulse = e.bomb.as_ref().map(|b| b.fuse).unwrap_or(-1.0);\n1015\t                    let soft = e.soft.as_ref().and_then(|s| {\n1016\t                        let h = s.handle?;\n1017\t                        let radius = match &s.def.shape {\n1018\t                            crate::softbody::SoftShape::Rope { radius, .. } => *radius,\n1019\t                            _ => 0.0,\n1020\t                        };\n1021\t                        Some(crate::frame::SoftView {\n1022\t                            points: self.state.physics.soft_positions(h),\n1023\t                            surface: s.surface.clone(),\n1024\t                            segments: s.segments.clone(),\n1025\t                            radius,\n1026\t                            two_sided: matches!(s.def.shape, crate::softbody::SoftShape::Cloth { .. }),\n1027\t                        })\n1028\t                    });\n1029\t                    let vehicle = e.vehicle.as_ref().map(|v| v.view());\n1030\t                    let cone = self.guard_cone(e);\n1031\t                    let scenery = e.character.is_none()\n1032\t                        && matches!(e.body_kind, BodyKind::None | BodyKind::Fixed)\n1033\t                        && matches!(e.behavior, Behavior::None)\n1034\t                        && e.bomb.is_none()\n1035\t                        && e.health.is_none()\n1036\t                        && e.vehicle.is_none()\n1037\t                        && e.soft.is_none()\n1038\t                        && e.lifetime.is_none()\n1039\t                        && !self.state.game.as_ref().is_some_and(|g| g.actors.contains_key(&e.id));\n1040\t                    Some(RenderObject {\n1041\t                        id: e.id,\n1042\t                        pos: e.pos,\n1043\t                        rot: e.rot,\n1044\t                        visual,\n1045\t                        prop: e.prop.as_ref().map(|p| p.frame()),\n1046\t                        puppet,\n1047\t                        pulse,\n1048\t                        soft,\n1049\t                        vehicle,\n1050\t                        cone,\n1051\t                        scenery,\n1052\t                    })\n1053\t                })\n1054\t                .collect(),\n1055\t            statics: self.state.statics.clone(),\n1056\t            focus: self.state.focus,\n1057\t            focus_is_player: self.state.player.is_some(),\n1058\t            player: self.state.player,\n1059\t            puppet_def: self.config.puppet.clone(),\n1060\t            room,\n1061\t            config: self.config_arc.clone(),\n1062\t            events: self.events.clone(),\n1063\t            projectiles: self\n1064\t                .state\n1065\t                .projectiles\n1066\t                .list\n1067\t                .iter()\n1068\t                .map(|p| crate::frame::ProjectileView { pos: p.pos, vel: p.vel, radius: p.radius, color: p.color })\n1069\t                .collect(),\n1070\t            hud,\n1071\t            game: self.state.game.as_ref().map(|g| std::sync::Arc::new(g.frame(self))),\n1072\t            animation_preview: None,\n1073\t            studio_mode: crate::prop_preview::StudioMode::World,\n1074\t            prop_preview: None,\n1075\t            creature_preview: None,\n1076\t            creature: None,\n1077\t        }\n1078\t    }\n1079\t\n1080\t    /// Counts for the physics overlay.\n1081\t    pub fn physics_stats(&self) -> crate::frame::PhysicsStats {\n1082\t        let ph = &self.state.physics;\n1083\t        let (mut dynamic, mut sleeping) = (0, 0);\n1084\t        for (_, b) in ph.bodies.iter() {\n1085\t            if b.is_dynamic() {\n1086\t                dynamic += 1;\n1087\t                if b.is_sleeping() {\n1088\t                    sleeping += 1;\n1089\t                }\n1090\t            }\n1091\t        }\n1092\t        crate::frame::PhysicsStats {\n1093\t            dynamic,\n1094\t            sleeping,\n1095\t            colliders: ph.colliders.len(),\n1096\t            joints: ph.impulse_joints.len(),\n1097\t            soft_bodies: ph.soft_bodies.len(),\n1098\t            particles: ph.soft_bodies.iter().map(|(_, s)| s.num_particles()).sum(),\n1099\t            contacts: ph.narrow_phase.contact_pairs().filter(|p| p.has_any_active_contact()).count(),\n1100\t            projectiles: self.state.projectiles.list.len(),\n1101\t        }\n1102\t    }\n1103\t\n1104\t    /// Hash of the gameplay state, for repeatability checks: the tick, the random numbers, every\n1105\t    /// entity, rigid and soft bodies (pose and velocity), the level's blocks and baked props,\n1106\t    /// projectiles, courses, signals, crumbling tiles and the game (hero, items, gold, monsters,\n1107\t    /// or a `games` game's own state).\n1108\t    /// Two runs that hash the same played out the same.\n1109\t    pub fn state_hash(&self) -> u64 {\n1110\t        let s = &self.state;\n1111\t        let mut h = Fnv::default();\n1112\t        h.u64(s.tick);\n1113\t        h.data(&s.rng);\n1114\t        h.data(&s.entities);\n1115\t        for (_, b) in s.physics.bodies.iter() {\n1116\t            h.floats(&b.translation().to_array());\n1117\t            h.floats(&b.rotation().to_array());\n1118\t            h.floats(&b.linvel().to_array());\n1119\t            h.floats(&b.angvel().to_array());\n1120\t        }\n1121\t        for (_, sb) in s.physics.soft_bodies.iter() {\n1122\t            for (p, v) in sb.particle_positions().zip(sb.particle_velocities()) {\n1123\t                h.floats(&p.to_array());\n1124\t                h.floats(&v.to_array());\n1125\t            }\n1126\t        }\n1127\t        h.u64(s.statics.block_count() as u64);\n1128\t        h.u64(s.statics.prop_count() as u64);\n1129\t        h.data(&s.projectiles);\n1130\t        h.data(&s.courses);\n1131\t        h.data(&s.signals);\n1132\t        h.data(&s.crumbles);\n1133\t        h.data(&s.game);\n1134\t        h.data(&s.play);\n1135\t        h.0\n1136\t    }\n1137\t}\n1138\t\n1139\t/// 64-bit FNV-1a over everything written to it.\n1140\tstruct Fnv(u64);\n1141\t\n1142\timpl Default for Fnv {\n1143\t    fn default() -> Self {\n1144\t        Self(0xcbf2_9ce4_8422_2325)\n1145\t    }\n1146\t}\n1147\t\n1148\timpl Fnv {\n1149\t    fn u64(&mut self, x: u64) {\n1150\t        for b in x.to_le_bytes() {\n1151\t            self.byte(b);\n1152\t        }\n1153\t    }\n1154\t\n1155\t    fn floats(&mut self, fs: &[f32]) {\n1156\t        for f in fs {\n1157\t            for b in f.to_bits().to_le_bytes() {\n1158\t                self.byte(b);\n1159\t            }\n1160\t        }\n1161\t    }\n1162\t\n1163\t    /// Mixes in a value's serialized form (the same CBOR that snapshot files use; the state\n1164\t    /// keeps its maps ordered, so the bytes are the same every run).\n1165\t    fn data<T: Serialize + ?Sized>(&mut self, value: &T) {\n1166\t        // Writing into the hash can't fail, and every state type serializes.\n1167\t        let _ = ciborium::into_writer(value, &mut *self);\n1168\t    }\n1169\t\n1170\t    fn byte(&mut self, b: u8) {\n1171\t        self.0 ^= b as u64;\n1172\t        self.0 = self.0.wrapping_mul(0x0100_0000_01b3);\n1173\t    }\n1174\t}\n1175\t\n1176\timpl std::io::Write for Fnv {\n1177\t    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {\n1178\t        for &b in buf {\n1179\t            self.byte(b);\n1180\t        }\n1181\t        Ok(buf.len())\n1182\t    }\n1183\t\n1184\t    fn flush(&mut self) -> std::io::Result<()> {"}]},"parent_tool_use_id":null,"session_id":"cb437ba7-0477-4143-bb04-ff33f49efd62","uuid":"e07acaf2-85b6-41d1-bd00-650f7639f089","timestamp":"2026-11-05T05:40:49.045Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953/engine/crates/pav_core/src/sim.rs","content":"            },\n        );\n        id\n    }\n\n    /// Creates a non-player character with its own look and (optionally) a brain.\n    pub fn spawn_npc(\n        &mut self,\n        name: &str,\n        feet: Vec3,\n        facing: f32,\n        def: PuppetDef,\n        ai: Option<crate::ai::Ai>,\n        region: Option<crate::statics::RegionKey>,\n    ) -> EntityId {\n        let id = self.spawn_character(name, feet);\n        if let Some(e) = self.state.entities.get_mut(id) {\n            e.region = region;\n            e.ai = ai.map(Box::new);\n            if let Some(ch) = &mut e.character {\n                ch.facing = facing;\n                ch.anim.facing = facing;\n                ch.puppet = Some(std::sync::Arc::new(def));\n            }\n        }\n        id\n    }\n\n    /// A character's kinematic capsule (when it is created or wakes up).\n    pub(crate) fn character_body(&mut self, id: EntityId, center: Vec3, posture: character::Posture) -> RigidBodyHandle {\n        let body = RigidBodyBuilder::kinematic_position_based().translation(center);\n        let collider =\n            ColliderBuilder::capsule_y(posture.half_height() as Real, RADIUS as Real).friction(0.0).user_data(entity_tag(id.0));\n        self.state.physics.insert(body, collider).0\n    }\n\n    /// Spawns the player at the scene's spawn point and makes the camera follow it.\n    pub fn spawn_player(&mut self) -> EntityId {\n        let id = self.spawn_character(\"player\", self.state.spawn);\n        self.state.player = Some(id);\n        id\n    }\n\n    /// Where an entity stands: a character's feet (its `pos` is the capsule's centre), else\n    /// its position.\n    pub fn feet(&self, id: EntityId) -> Option<Vec3> {\n        let e = self.state.entities.get(id)?;\n        Some(match &e.character {\n            Some(c) => e.pos - Vec3::Y * c.height() * 0.5,\n            None => e.pos,\n        })\n    }\n\n    pub fn player(&self) -> Option<&Entity> {\n        self.state.player.and_then(|id| self.state.entities.get(id))\n    }\n\n    pub fn despawn(&mut self, id: EntityId) -> bool {\n        match self.state.entities.map.remove(&id) {\n            Some(e) => {\n                if e.prop.is_some() {\n                    self.invalidate_prop_navigation();\n                }\n                if let Some(b) = e.body {\n                    self.state.physics.remove_body(b);\n                }\n                if let Some(h) = e.soft.and_then(|s| s.handle) {\n                    self.state.physics.remove_soft(h);\n                }\n                if self.state.player == Some(id) {\n                    self.state.player = None;\n                }\n                true\n            }\n            None => false,\n        }\n    }\n\n    /// Moves an entity (teleport), resetting its velocity. For characters `pos` is the feet.\n    pub fn set_position(&mut self, id: EntityId, pos: Vec3) -> bool {\n        let Some(e) = self.state.entities.map.get_mut(&id) else { return false };\n        let center = match &mut e.character {\n            Some(ch) => {\n                ch.vel = Vec3::ZERO;\n                ch.impulse = Vec3::ZERO;\n                ch.stun = 0.0;\n                ch.roll = 0.0;\n                ch.hang = None;\n                ch.grid_target = None;\n                ch.climbing = None;\n                pos + Vec3::Y * (ch.height() * 0.5 + character::PLACE_LIFT)\n            }\n            None => pos,\n        };\n        e.pos = center;\n        if self.state.player == Some(id) {\n            self.state.focus = center;\n        }\n        if let Some(b) = e.body.and_then(|h| self.state.physics.bodies.get_mut(h)) {\n            b.set_translation(center, true);\n            if b.is_kinematic() {\n                b.set_next_kinematic_translation(center);\n            }\n            b.set_linvel(Vector::ZERO, true);\n            b.set_angvel(Vector::ZERO, true);\n        }\n        if e.prop.is_some() {\n            self.invalidate_prop_navigation();\n        }\n        true\n    }\n\n    /// Advances one fixed tick, recording the input for rewind and replays.\n    pub fn step(&mut self, input: &InputFrame) {\n        let dt = self.dt();\n        match self.studio_mode() {\n            crate::prop_preview::StudioMode::Animation => {\n                if let Some(preview) = &mut self.state.animation_preview {\n                    preview.advance(dt);\n                }\n                return;\n            }\n            crate::prop_preview::StudioMode::Prop => {\n                if let Some(preview) = &mut self.state.prop_preview {\n                    preview.advance(dt);\n                }\n                return;\n            }\n            crate::prop_preview::StudioMode::Creature => {\n                if let Some(preview) = &mut self.state.creature_preview {\n                    preview.advance(dt);\n                }\n                return;\n            }\n            crate::prop_preview::StudioMode::World => {}\n        }\n        if self.history.enabled && self.config.history_seconds > 0.0 {\n            self.history.window = (self.config.history_seconds * self.config.tick_rate.hz() as f32) as u64;\n            self.history.record(&self.state, input);\n        }\n        if self.recording.ticks() < MAX_RECORDING_TICKS {\n            self.recording.push(input);\n        }\n        self.step_inner(input);\n    }\n\n    fn step_inner(&mut self, input: &InputFrame) {\n        // Hit-stop slows the whole world for a moment.\n        let raw_dt = self.dt();\n        let dt = raw_dt * self.game_time_scale();\n        self.state.physics.params.dt = dt as Real;\n        self.state.physics.gravity = Vector::new(0.0, -self.config.gravity as Real, 0.0);\n\n        // Behaviours set this tick's velocities of moving objects; characters then move\n        // (rapier's controller carries them with kinematic platforms) and the physics step\n        // advances everything together.\n        self.run_behaviors(dt);\n\n        // Getting in and out of vehicles.\n        self.vehicle_interact(input);\n\n        // The game decides what the hero and its monsters do this tick.\n        let mut events = Vec::new();\n        let mut game_inputs = self.game_pre(input, dt, &mut events);\n        game_inputs.extend(self.play_pre(input, dt, &mut events));\n\n        // Characters.\n        let ids: Vec<EntityId> = self.state.entities.iter().filter(|e| e.character.is_some()).map(|e| e.id).collect();\n        let mut actions = Vec::new();\n        let idle = InputFrame::default();\n        let player_feet = self.player().and_then(|p| Some(p.pos - Vec3::Y * p.character.as_ref()?.height() * 0.5));\n        let all_feet: Vec<Vec3> =\n            self.state.entities.iter().filter_map(|e| Some(e.pos - Vec3::Y * e.character.as_ref()?.height() * 0.5)).collect();\n        let mut fallen = Vec::new();\n        for id in ids {\n            let npc_input: InputFrame;\n            let inp = if let Some(gi) = game_inputs.get(&id) {\n                gi\n            } else if Some(id) == self.state.player {\n                input\n            } else {\n                // Non-player characters: their brain drives them like a player would.\n                let st = &mut self.state;\n                match st.entities.map.get_mut(&id) {\n                    Some(e) if e.ai.is_some() => {\n                        let feet = e.pos - Vec3::Y * e.character.as_ref().map(|c| c.height() * 0.5).unwrap_or(0.0);\n                        let ai = e.ai.as_mut().unwrap();\n                        if feet.y < crate::course::FALL_LIMIT {\n                            fallen.push((id, ai.home));\n                        }\n                        npc_input = ai.think(feet, player_feet, &all_feet, &mut st.rng, dt);\n                        if let (Some(f), Some(ch)) = (ai.rest_facing(), e.character.as_mut()) {\n                            if ch.stun <= 0.0 {\n                                ch.facing = f;\n                            }\n                        }\n                        if let (Some(p), Some(ch)) = (ai.perform.as_mut(), e.character.as_mut()) {\n                            p.tick(&mut ch.anim, dt, &self.config.anim);\n                        }\n                        &npc_input\n                    }\n                    _ => &idle,\n                }\n            };\n            let own = self.state.entities.get(id).and_then(|e| e.character.as_ref()).and_then(|c| c.puppet.clone());\n            character::tick(\n                &mut self.state,\n                id,\n                inp,\n                &self.config.movement,\n                &self.config.bombs,\n                own.as_deref().unwrap_or(&self.config.puppet),\n                self.config.gravity,\n                dt,\n                &mut events,\n                &mut actions,\n            );\n        }\n        for (id, home) in fallen {\n            self.set_position(id, home);\n        }\n        self.update_guards(dt, &mut events);\n        for a in actions {\n            match a {\n                Action::ThrowBomb { from, vel, owner } => {\n                    self.throw_bomb(from, vel, owner);\n                    events.push(SimEvent::Throw { pos: from });\n                }\n                Action::Hit { id, at, dir, knockback, respawn } => {\n                    self.hit_character(id, at, dir, knockback, respawn, &mut events)\n                }\n                Action::Shoot { from, vel, owner } => {\n                    self.state.projectiles.spawn(crate::projectile::Projectile {\n                        pos: from,\n                        vel,\n                        radius: 0.09,\n                        life: self.config.bombs.shot_range / vel.length().max(0.1),\n                        color: Color::hex(\"#9ef0ff\"),\n                        knockback: 0.0,\n                        gravity: 0.0,\n                        owner: Some(owner),\n                        team: crate::projectile::Team::Player,\n                        damage: 1.0,\n                    });\n                    events.push(SimEvent::Shot { pos: from });\n                }\n            }\n        }\n        self.drive_vehicles(input, dt);\n        self.zone_props(dt);\n        let collector = EventCollector::default();\n        self.state.physics.step(&mut self.pipeline, &collector);\n        self.sync_from_physics();\n        self.seat_riders();\n        let contacts = collector.contacts.into_inner().unwrap_or_default();\n        if !contacts.is_empty() {\n            self.break_blocks(contacts, &mut events);\n        }\n        self.update_crumbles(dt, &mut events);\n\n        // Bombs and debris.\n        let mut blasts = Vec::new();\n        let mut expired = Vec::new();\n        let settle_after = self.config.bombs.fuse - self.config.bombs.flight_time - 0.05;\n        for e in self.state.entities.map.values_mut() {\n            if let Some(b) = &mut e.bomb {\n                b.fuse -= dt;\n                if b.fuse <= 0.0 {\n                    blasts.push((e.id, e.pos, b.radius));\n                } else if b.fuse < settle_after {\n                    // After the throw arc, bombs stop where they landed instead of rolling away.\n                    if let Some(body) = e.body.and_then(|h| self.state.physics.bodies.get_mut(h)) {\n                        let v = body.linvel();\n                        body.set_linvel(Vec3::new(v.x * 0.8, v.y, v.z * 0.8), false);\n                        body.set_angvel(body.angvel() * 0.8, false);\n                    }\n                }\n            }\n            if let Some(l) = &mut e.lifetime {\n                *l = l.saturating_sub(1);\n                if *l == 0 {\n                    expired.push(e.id);\n                }\n            }\n        }\n        for (id, pos, radius) in blasts {\n            self.despawn(id);\n            self.explode(pos, radius, &mut events);\n        }\n        for id in expired {\n            self.despawn(id);\n        }\n\n        // Shootable things: sway, hit flash.\n        self.update_health(dt);\n\n        // Projectiles.\n        if !self.state.projectiles.list.is_empty() {\n            let hitbox = self.config.movement.hitbox;\n            let player = self.state.player;\n            let targets: Vec<Target> = self\n                .state\n                .entities\n                .iter()\n                .filter_map(|e| {\n                    let c = e.character.as_ref()?;\n                    let radius = if Some(e.id) == player { hitbox } else { RADIUS };\n                    Some(Target { id: e.id, feet: e.pos - Vec3::Y * c.height() * 0.5, height: c.height(), radius })\n                })\n                .collect();\n            let enemies: Vec<crate::projectile::Enemy> = self\n                .state\n                .entities\n                .iter()\n                .filter(|e| e.health.is_some())\n                .map(|e| crate::projectile::Enemy {\n                    id: e.id,\n                    center: e.pos,\n                    radius: e.visual.as_ref().map(|v| v.shape.half_extents().max_element()).unwrap_or(0.5),\n                })\n                .collect();\n            let physics = &self.state.physics;\n            let entities = &self.state.entities;\n            let out = self.state.projectiles.step(dt, &targets, &enemies, |from, dir, len, owner| {\n                let ignore = owner.and_then(|id| entities.get(id)).and_then(|e| e.body);\n                crate::projectile::static_blocked(physics, from, dir, len, ignore)\n            });\n            for (id, at, dir, kb) in out.hits {\n                self.hit_character(id, at, dir, kb, false, &mut events);\n            }\n            for (id, at, dmg) in out.damage {\n                self.damage(id, at, dmg, &mut events);\n            }\n        }\n\n        self.game_post(dt, raw_dt, &mut events);\n        self.play_post(dt, &mut events);\n        self.game_travel(&mut events);\n\n        if let Some(p) = self.player() {\n            self.state.focus = p.pos;\n        }\n        self.update_zones(&mut events);\n        self.measure_feel(input);\n        self.update_room_tracking(&mut events);\n        if self.state.tick.is_multiple_of(15) {\n            self.update_streaming(2);\n        }\n        self.state.tick += 1;\n        if !self.replaying {\n            self.events.extend(events);\n        }\n    }\n\n    fn measure_feel(&mut self, input: &InputFrame) {\n        let Some(e) = self.player() else { return };\n        let Some(ch) = e.character.as_ref() else { return };\n        let (vel, grounded, feet) =\n            (ch.vel, ch.grounded || ch.climbing.is_some() || ch.hang.is_some(), e.pos - Vec3::Y * ch.height() * 0.5);\n        let dt = self.dt();\n        let tick = self.state.tick;\n        self.state.feel.update(tick, dt, input.move_dir, vel, feet, grounded);\n    }\n\n    fn throw_bomb(&mut self, from: Vec3, vel: Vec3, owner: EntityId) {\n        let mut v = Visual::new(Shape::Sphere { radius: 0.2 }, Color::hex(\"#2b2d35\"));\n        v.look = Look::Lit;\n        let id = self.spawn(Spawn::new(\"bomb\", from).visual(v).body(BodyKind::Dynamic).restitution(0.15));\n        if let Some(e) = self.state.entities.get_mut(id) {\n            e.bomb = Some(Bomb { fuse: self.config.bombs.fuse, radius: self.config.bombs.radius, owner: Some(owner) });\n            if let Some(b) = e.body.and_then(|h| self.state.physics.bodies.get_mut(h)) {\n                b.set_linvel(vel, true);\n                b.enable_ccd(true);\n            }\n        }\n    }\n\n    /// Removes destructible blocks in the radius, throws debris and pushes things away.\n    pub fn explode(&mut self, pos: Vec3, radius: f32, events: &mut Vec<SimEvent>) {\n        let hit = self.state.statics.blocks_in_sphere(pos, radius);\n        let mut debris = Vec::new();\n        for r in hit {\n            if !self.state.statics.get(r).is_some_and(|b| b.has(block_flags::DESTRUCTIBLE)) {\n                continue;\n            }\n            let st = &mut self.state;\n            if let Some(b) = st.statics.destroy(&mut st.physics, r) {\n                debris.push((b.center(), b.half(), b.color));\n            }\n        }\n        for (c, half, color) in debris {\n            let n = 3 + self.state.rng.below(3);\n            for _ in 0..n {\n                let rng = &mut self.state.rng;\n                let off = Vec3::new(rng.range(-half.x, half.x), rng.range(-half.y, half.y), rng.range(-half.z, half.z));\n                let size = Vec3::new(rng.range(0.08, 0.2), rng.range(0.06, 0.14), rng.range(0.08, 0.2));\n                let out = (c + off - pos).normalize_or(Vec3::Y);\n                let vel = out * rng.range(2.0, 6.0) + Vec3::Y * rng.range(1.0, 4.0);\n                let life = (rng.range(2.5, 4.0) * self.config.tick_rate.hz() as f32) as u32;\n                let rot = Quat::from_euler(glam::EulerRot::XYZ, rng.range(0.0, 3.0), rng.range(0.0, 3.0), 0.0);\n                let id = self.spawn(\n                    Spawn::new(\"~debris\", c + off)\n                        .visual(Visual::new(Shape::Box { half: size }, color))\n                        .body(BodyKind::Dynamic)\n                        .rot(rot),\n                );\n                if let Some(e) = self.state.entities.get_mut(id) {\n                    e.lifetime = Some(life);\n                    if let Some(b) = e.body.and_then(|h| self.state.physics.bodies.get_mut(h)) {\n                        b.set_linvel(vel, true);\n                    }\n                }\n            }\n        }\n        // Push props and characters.\n        let push = self.config.bombs.push;\n        let reach = radius * 2.5;\n        for e in self.state.entities.map.values_mut() {\n            let d = e.pos - pos;\n            let dist = d.length();\n            if dist > reach || e.bomb.is_some() {\n                continue;\n            }\n            let fall = 1.0 - dist / reach;\n            let dir = (d + Vec3::Y * 0.5).normalize_or(Vec3::Y);\n            if let Some(h) = e.soft.as_ref().and_then(|s| s.handle) {\n                // Soft bodies: every particle in reach gets kicked away from the blast.\n                if let Some(sb) = self.state.physics.soft_bodies.get_mut(h) {\n                    let pv: Vec<(Vec3, Vec3)> = sb.particle_positions().zip(sb.particle_velocities()).collect();\n                    for (i, (p, v)) in pv.into_iter().enumerate() {\n                        let d = p - pos;\n                        let f = 1.0 - d.length() / reach;\n                        if f > 0.0 {\n                            sb.set_particle_velocity(i, v + (d + Vec3::Y * 0.5).normalize_or(Vec3::Y) * push * f);\n                        }\n                    }\n                }\n                continue;\n            }\n            if let Some(ch) = &mut e.character {\n                ch.impulse += dir * push * fall;\n                ch.stun = ch.stun.max(0.25 * fall);\n                ch.hang = None;\n                ch.anim.hit(dir, 0.5 + 1.5 * fall);\n            } else if let Some(b) = e.body.and_then(|h| self.state.physics.bodies.get_mut(h)) {\n                if b.is_dynamic() {\n                    let m = b.mass();\n                    b.apply_impulse(dir * push * fall * m, true);\n                }\n            }\n        }\n        self.state.physics.wake_near(pos, reach + 4.0);\n        events.push(SimEvent::Explosion { pos, radius });\n    }\n\n    /// Runs `n` ticks with the same input.\n    pub fn run(&mut self, n: u64, input: &InputFrame) {\n        for _ in 0..n {\n            self.step(input);\n        }\n    }\n\n    /// Takes the events produced since the last call.\n    pub fn drain_events(&mut self) -> Vec<SimEvent> {\n        std::mem::take(&mut self.events)\n    }\n\n    // ------------------------------------------------------------------ time travel\n\n    /// Shows the world as it was at `target` (restore + re-simulate). The recorded future is\n    /// kept until `commit_rewind`, so scrubbing forward again works.\n    pub fn rewind_to(&mut self, target: u64) -> bool {\n        let Some(snap) = self.history.snapshots.iter().rev().find(|s| s.tick <= target).cloned() else { return false };\n        self.restore(snap);\n        self.replaying = true;\n        while self.state.tick < target {\n            let Some(input) = self.history.input_at(self.state.tick) else { break };\n            self.step_inner(&input);\n        }\n        self.replaying = false;\n        true\n    }\n\n    /// Starts a new timeline from the current tick (drops the recorded future).\n    pub fn commit_rewind(&mut self) {\n        let t = self.state.tick;\n        self.history.truncate_after(t);\n        // The replay recording restarts from scratch semantics: keep inputs up to `t`.\n        let mut r = Replay { scene: self.recording.scene.clone(), seed: self.recording.seed, ..Default::default() };\n        for (i, f) in self.recording.iter().enumerate() {\n            if i as u64 >= t {\n                break;\n            }\n            r.push(f);\n        }\n        self.recording = r;\n    }\n\n    /// Saves the full state to a file (binary).\n    pub fn save_state(&self, path: &Path) -> Result<()> {\n        let mut bytes = Vec::new();\n        ciborium::into_writer(&self.snapshot(), &mut bytes).context(\"serializing state\")?;\n        if let Some(d) = path.parent().filter(|d| !d.as_os_str().is_empty()) {\n            std::fs::create_dir_all(d)?;\n        }\n        std::fs::write(path, bytes).with_context(|| format!(\"writing {}\", path.display()))\n    }\n\n    pub fn load_state(&mut self, path: &Path) -> Result<()> {\n        let bytes = std::fs::read(path).with_context(|| format!(\"reading {}\", path.display()))?;\n        let state: SimState = ciborium::from_reader(&bytes[..]).context(\"snapshot file is invalid or from another version\")?;\n        self.restore(state);\n        self.history.clear();\n        Ok(())\n    }\n\n    // ------------------------------------------------------------------ internals\n\n    fn sync_from_physics(&mut self) {\n        let ph = &self.state.physics;\n        for e in self.state.entities.map.values_mut() {\n            if let Some(b) = e.body.and_then(|h| ph.bodies.get(h)) {\n                e.pos = b.translation();\n                e.rot = *b.rotation();\n            } else if let Some(sb) = e.soft.as_ref().and_then(|s| s.handle).and_then(|h| ph.soft_bodies.get(h)) {\n                e.pos = sb.center_of_mass();\n            }\n        }\n    }\n\n    /// Adds a joint owned by `owner` (to `link.other`, or the world) and creates it now if both\n    /// bodies exist.\n    pub fn add_joint(&mut self, owner: EntityId, link: crate::joints::JointLink) -> bool {\n        let Some(a) = self.state.entities.get(owner).and_then(|e| e.body) else { return false };\n        let b = match link.other {\n            Some(o) => match self.state.entities.get(o).and_then(|e| e.body) {\n                Some(b) => Some(b),\n                None => return false,\n            },\n            None => None,\n        };\n        self.state.physics.insert_joint(a, b, &link);\n        if let Some(e) = self.state.entities.get_mut(owner) {\n            e.joints.push(link);\n        }\n        true\n    }\n\n    /// Recreates the joints of the given entities (after their region wakes up).\n    pub(crate) fn restore_joints(&mut self, ids: &[EntityId]) {\n        for id in ids {\n            let Some(e) = self.state.entities.get(*id) else { continue };\n            let Some(a) = e.body else { continue };\n            for link in e.joints.clone() {\n                let b = match link.other {\n                    Some(o) => match self.state.entities.get(o).and_then(|x| x.body) {\n                        Some(b) => Some(b),\n                        None => continue,\n                    },\n                    None => None,\n                };\n                self.state.physics.insert_joint(a, b, &link);\n            }\n        }\n    }\n\n    pub fn frame(&mut self) -> RenderFrame {\n        if *self.config_arc != self.config {\n            self.config_arc = std::sync::Arc::new(self.config.clone());\n        }\n        match self.studio_mode() {\n            crate::prop_preview::StudioMode::Animation => {\n                if let Some(preview) = &self.state.animation_preview {\n                    return preview.frame(self.config_arc.clone(), self.dt(), self.live_edit_ticket);\n                }\n            }\n            crate::prop_preview::StudioMode::Prop => {\n                if let Some(preview) = &self.state.prop_preview {\n                    return preview.frame(self.config_arc.clone(), self.dt(), self.live_edit_ticket);\n                }\n            }\n            crate::prop_preview::StudioMode::Creature => {\n                return match &self.state.creature_preview {\n                    Some(preview) => preview.frame(self.config_arc.clone(), self.dt(), self.live_edit_ticket),\n                    None => crate::creature_preview::empty_frame(self.config_arc.clone(), self.dt(), self.live_edit_ticket),\n                };\n            }\n            crate::prop_preview::StudioMode::World => {}\n        }\n        let room = self\n            .state\n            .world\n            .current_room\n            .and_then(|i| self.state.world.rooms.get(i as usize))\n            .map(|r| crate::frame::RoomInfo { id: r.id, key: r.key.clone(), def: r.def.clone(), quarters: r.place.quarters });\n        let c = &self.state.courses;\n        let invuln = self.player().and_then(|p| p.character.as_ref()).map(|c| c.invuln).unwrap_or(0.0);\n        let hud = crate::frame::HudFrame {\n            course: c.hud(self.state.tick, self.dt()),\n            last_result: c.last.clone(),\n            message: c.message.clone(),\n            feel: self.state.feel.report,\n            cue: c.cue(),\n            cue_serial: c.cue_serial,\n            invuln,\n            model: crate::params::ChoiceParam::name(self.config.movement.model).to_string(),\n            physics: self.physics_stats(),\n            view: c.view.clone(),\n            view_serial: c.view_serial,\n            boss: self.boss_bar(),\n            pad_note: c.pad_note.clone(),\n            lines: self.play_hud(),\n        };\n        RenderFrame {\n            tick: self.state.tick,\n            time: self.time(),\n            dt: self.dt(),\n            live_edit_ticket: self.live_edit_ticket,\n            objects: self\n                .state\n                .entities\n                .iter()\n                .filter_map(|e| {\n                    let puppet = e.character.as_ref().filter(|c| c.riding.is_none()).map(|c| PuppetFrame {\n                        state: c.anim,\n                        feet_offset: c.height() * 0.5,\n                        def: c.puppet.clone(),\n                        rig: c.rig.as_ref().map(|r| r.view()),\n                        tint: self.state.game.as_ref().and_then(|g| g.tint(e.id)),\n                    });\n                    if e.visual.is_none() && puppet.is_none() {\n                        return None;\n                    }\n                    let mut visual = e.visual.clone().unwrap_or(Visual::new(Shape::Sphere { radius: 0.0 }, Color::WHITE));\n                    if e.health.as_ref().is_some_and(|h| h.flash > 0.0) {\n                        // Hit flash.\n                        visual.color = Color::WHITE;\n                        visual.emissive = visual.emissive.max(0.45);\n                    }\n                    let pulse = e.bomb.as_ref().map(|b| b.fuse).unwrap_or(-1.0);\n                    let soft = e.soft.as_ref().and_then(|s| {\n                        let h = s.handle?;\n                        let radius = match &s.def.shape {\n                            crate::softbody::SoftShape::Rope { radius, .. } => *radius,\n                            _ => 0.0,\n                        };\n                        Some(crate::frame::SoftView {\n                            points: self.state.physics.soft_positions(h),\n                            surface: s.surface.clone(),\n                            segments: s.segments.clone(),\n                            radius,\n                            two_sided: matches!(s.def.shape, crate::softbody::SoftShape::Cloth { .. }),\n                        })\n                    });\n                    let vehicle = e.vehicle.as_ref().map(|v| v.view());\n                    let cone = self.guard_cone(e);\n                    let scenery = e.character.is_none()\n                        && matches!(e.body_kind, BodyKind::None | BodyKind::Fixed)\n                        && matches!(e.behavior, Behavior::None)\n                        && e.bomb.is_none()\n                        && e.health.is_none()\n                        && e.vehicle.is_none()\n                        && e.soft.is_none()\n                        && e.lifetime.is_none()\n                        && !self.state.game.as_ref().is_some_and(|g| g.actors.contains_key(&e.id));\n                    Some(RenderObject {\n                        id: e.id,\n                        pos: e.pos,\n                        rot: e.rot,\n                        visual,\n                        prop: e.prop.as_ref().map(|p| p.frame()),\n                        puppet,\n                        pulse,\n                        soft,\n                        vehicle,\n                        cone,\n                        scenery,\n                    })\n                })\n                .collect(),\n            statics: self.state.statics.clone(),\n            focus: self.state.focus,\n            focus_is_player: self.state.player.is_some(),\n            player: self.state.player,\n            puppet_def: self.config.puppet.clone(),\n            room,\n            config: self.config_arc.clone(),\n            events: self.events.clone(),\n            projectiles: self\n                .state\n                .projectiles\n                .list\n                .iter()\n                .map(|p| crate::frame::ProjectileView { pos: p.pos, vel: p.vel, radius: p.radius, color: p.color })\n                .collect(),\n            hud,\n            game: self.state.game.as_ref().map(|g| std::sync::Arc::new(g.frame(self))),\n            animation_preview: None,\n            studio_mode: crate::prop_preview::StudioMode::World,\n            prop_preview: None,\n            creature_preview: None,\n            creature: None,\n        }\n    }\n\n    /// Counts for the physics overlay.\n    pub fn physics_stats(&self) -> crate::frame::PhysicsStats {\n        let ph = &self.state.physics;\n        let (mut dynamic, mut sleeping) = (0, 0);\n        for (_, b) in ph.bodies.iter() {\n            if b.is_dynamic() {\n                dynamic += 1;\n                if b.is_sleeping() {\n                    sleeping += 1;\n                }\n            }\n        }\n        crate::frame::PhysicsStats {\n            dynamic,\n            sleeping,\n            colliders: ph.colliders.len(),\n            joints: ph.impulse_joints.len(),\n            soft_bodies: ph.soft_bodies.len(),\n            particles: ph.soft_bodies.iter().map(|(_, s)| s.num_particles()).sum(),\n            contacts: ph.narrow_phase.contact_pairs().filter(|p| p.has_any_active_contact()).count(),\n            projectiles: self.state.projectiles.list.len(),\n        }\n    }\n\n    /// Hash of the gameplay state, for repeatability checks: the tick, the random numbers, every\n    /// entity, rigid and soft bodies (pose and velocity), the level's blocks and baked props,\n    /// projectiles, courses, signals, crumbling tiles and the game (hero, items, gold, monsters,\n    /// or a `games` game's own state).\n    /// Two runs that hash the same played out the same.\n    pub fn state_hash(&self) -> u64 {\n        let s = &self.state;\n        let mut h = Fnv::default();\n        h.u64(s.tick);\n        h.data(&s.rng);\n        h.data(&s.entities);\n        for (_, b) in s.physics.bodies.iter() {\n            h.floats(&b.translation().to_array());\n            h.floats(&b.rotation().to_array());\n            h.floats(&b.linvel().to_array());\n            h.floats(&b.angvel().to_array());\n        }\n        for (_, sb) in s.physics.soft_bodies.iter() {\n            for (p, v) in sb.particle_positions().zip(sb.particle_velocities()) {\n                h.floats(&p.to_array());\n                h.floats(&v.to_array());\n            }\n        }\n        h.u64(s.statics.block_count() as u64);\n        h.u64(s.statics.prop_count() as u64);\n        h.data(&s.projectiles);\n        h.data(&s.courses);\n        h.data(&s.signals);\n        h.data(&s.crumbles);\n        h.data(&s.game);\n        h.data(&s.play);\n        h.0\n    }\n}\n\n/// 64-bit FNV-1a over everything written to it.\nstruct Fnv(u64);\n\nimpl Default for Fnv {\n    fn default() -> Self {\n        Self(0xcbf2_9ce4_8422_2325)\n    }\n}\n\nimpl Fnv {\n    fn u64(&mut self, x: u64) {\n        for b in x.to_le_bytes() {\n            self.byte(b);\n        }\n    }\n\n    fn floats(&mut self, fs: &[f32]) {\n        for f in fs {\n            for b in f.to_bits().to_le_bytes() {\n                self.byte(b);\n            }\n        }\n    }\n\n    /// Mixes in a value's serialized form (the same CBOR that snapshot files use; the state\n    /// keeps its maps ordered, so the bytes are the same every run).\n    fn data<T: Serialize + ?Sized>(&mut self, value: &T) {\n        // Writing into the hash can't fail, and every state type serializes.\n        let _ = ciborium::into_writer(value, &mut *self);\n    }\n\n    fn byte(&mut self, b: u8) {\n        self.0 ^= b as u64;\n        self.0 = self.0.wrapping_mul(0x0100_0000_01b3);\n    }\n}\n\nimpl std::io::Write for Fnv {\n    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {\n        for &b in buf {\n            self.byte(b);\n        }\n        Ok(buf.len())\n    }\n\n    fn flush(&mut self) -> std::io::Result<()> {","numLines":810,"startLine":375,"totalLines":1188}},"tool_result_meta":[{"id":"toolu_01U71pzLLmUtqYvMvtoUXpd3","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
