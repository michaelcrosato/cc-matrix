lue\"] for x in cdp.send(\"Performance.getMetrics\")[\"metrics\"]}\n    print(\"wall\",round(dt,1),\"ticks\",st()[\"tick\"]-a,\"task\",round(m1[\"TaskDuration\"]-m0[\"TaskDuration\"],2),\"script\",round(m1[\"ScriptDuration\"]-m0[\"ScriptDuration\"],2))\n    b.close()\nPY\npython3 ../tests/dev/prof.py fit/event/tide; python3 ../tests/dev/prof.py fit","description":"Measure main-thread versus GPU time in the browser","timeout":200000}}}
