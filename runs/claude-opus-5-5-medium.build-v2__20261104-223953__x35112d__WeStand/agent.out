e a head, for the host's own figures (hub ghosts).\npub fn world_label(ctx: &egui::Context, vp: Mat4, at: [f32; 3], s: &str) {\n    let v = vp * Vec4::new(at[0], at[1], at[2], 1.0);\n    if v.w <= 0.0 {\n        return;\n    }\n    let size = ctx.content_rect().size();\n    let n = v.truncate() / v.w;\n    let k = (size.x / 1920.0).min(size.y / 1080.0);\n    let p = ctx.layer_painter(egui::LayerId::new(egui::Order::Foreground, egui::Id::new(\"fit_labels\")));\n    p.text(pos2((n.x * 0.5 + 0.5) * size.x, (0.5 - n.y * 0.5) * size.y), Align2::CENTER_BOTTOM, s, FontId::new(40.0 * k, FontFamily::Name(BODY_FONT.into())), c(INK));\n}\n\nfn track_of(r: Rect) -> Rect {''')\nsub(U,'''            Ui::WorldPrompt { at, glyph, label } => {''','''            Ui::WorldLabel { at, text: s } => {\n                let v = vp * Vec4::new(at[0], at[1], at[2], 1.0);\n                if v.w > 0.0 {\n                    let n = v.truncate() / v.w;\n                    let wx = (n.x * 0.5 + 0.5) * sp.size.x;\n                    let wy = (0.5 - n.y * 0.5) * sp.size.y;\n                    p.text(pos2(wx, wy), Align2::CENTER_BOTTOM, s, font(&sp, 40.0, false), c(INK));\n                }\n            }\n            Ui::WorldPrompt { at, glyph, label } => {''')\nsub('engine/crates/pav_core/src/games/fit/ui_model.rs','''    /// The balance gauge.''','''    /// A name above a figure.\n    WorldLabel { at: [f32; 3], text: String },\n    /// The balance gauge.''')\nsub('engine/crates/pav_core/src/games/fit/ui_model.rs','''                Ui::Prompt { label, .. } | Ui::WorldPrompt { label, .. } => out.push(label.clone()),''','''                Ui::Prompt { label, .. } | Ui::WorldPrompt { label, .. } => out.push(label.clone()),\n                Ui::WorldLabel { text, .. } => out.push(text.clone()),''')\nL='engine/crates/pav_app/src/fit_link.rs'\nsub(L,'''    pub ui: Option<UiEvent>,\n    pub over: bool,''','''    pub ui: Option<UiEvent>,\n    pub over: bool,\n    pub last_hover: Option<u16>,''')\nA