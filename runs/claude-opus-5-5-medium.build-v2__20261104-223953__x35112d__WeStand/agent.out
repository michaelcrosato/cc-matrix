Two_Hands\"] if i%3==0 else [\"QUATERNIUS/Dance_Loop\"])''','''b+=npc(\"guest\",13+i*4,20.5+(i%2),yaw=0,clips=[\"MESH2MOTION/Cheering_Two_Hands\"] if i%3==0 else ([\"CMU/Hop_One_Foot_Loop\"] if i==4 else [\"QUATERNIUS/Dance_Loop\"]))''')\n# device published to the page\nL='engine/crates/pav_app/src/fit_link.rs'\nsub(L,'''    pub fn status(s: &str) {''','''    /// What the prompts show now, for the page's tests.\n    pub fn prompts(s: &str) {\n        if let Some(w) = win() {\n            let _ = Reflect::set(&w, &JsValue::from_str(\"__gamePrompts\"), &JsValue::from_str(s));\n        }\n    }\n\n    pub fn status(s: &str) {''')\nsub('engine/crates/pav_app/src/app.rs','''                crate::fit_link::web::rumble(ui_frame.rumble);''','''                crate::fit_link::web::rumble(ui_frame.rumble);\n                crate::fit_link::web::prompts(match (device, self.fit.mouse_last) {\n                    (Device::Gamepad, _) => {\n                        if ui_frame.xbox {\n                            \"xbox\"\n                        } else {\n                            \"playstation\"\n                        }\n                    }\n                    (_, true) => \"mouse\",\n                    _ => \"keyboard\",\n                });''')\n# tests\nT='engine/crates/pav_core/tests/fit.rs'\nsub(T,'''    let mut sim = Sim::new(\"fit/event/tide\", 3).unwrap();\n    for _ in 0..240 {\n        let f = sim.bot_input();\n        sim.step(&f);\n    }\n    let mut bytes''','''    let mut sim = Sim::new(\"fit/event/tide\", 3).unwrap();\n    sim.history.enabled = true;\n    for _ in 0..240 {\n        let f = sim.bot_input();\n        sim.step(&f);\n    }\n    let mut bytes''')\nsub(T,'''    assert_eq!(copy.state_hash(), sim.state_hash());\n    let hash = sim.state_hash();\n    let mut again''','''    assert_eq!(copy.state_hash(), sim.state_hash());\n    let (tick, hash) = (sim.state.tick, sim.state_hash());\n    assert!(sim.rewind_to(tick - 90));\n    assert!(sim.rewind_to(tick));\n    assert_eq!(sim.state_hash(), hash);\n    let mut again''')\nsub(T,'''    assert!(notes >= 80, \"{notes} notes\");''','''    assert!(notes >= 95, \"{notes} notes\");''')\nsub(T,'''    // Dev jump lands where it says.''','''    // Single step advances a paused event by exactly one tick.\n    let before = game(&sim).run.as_ref().unwrap().t;\n    sim.step(&InputFrame { ui: Some(UiEvent::Click(1002)), any: true, ..Default::default() });\n    let m = game(&sim).menus.last().copied().unwrap();\n    let step = game(&sim).menu_items(&m).iter().position(|i| matches!(i.act, menus::Act::Step)).unwrap();\n    sim.step(&InputFrame { ui: Some(UiEvent::Click(step as u16)), any: true, ..Default::default() });\n    assert!(game(&sim).run.as_ref().unwrap().t > before, \"single step\");\n    let after = game(&sim).run.as_ref().unwrap().t;\n    sim.step(&InputFrame::default());\n    assert_eq!(game(&sim).run.as_ref().unwrap().t, after, \"one step only\");\n    // Dev jump lands where it says.''')\nsub(T,'''    assert!(pip >= 80''','''    for c in [\"MESH2MOTION/Victory\", \"CMU/Hop_One_Foot_Loop\", \"MESH2MOTION/Jumping Jacks\", \"CMU/Stretch_Yawn\", \"MESH2MOTION/Cheering_Two_Hands\", \"MESH2MOTION/Sitting_Idle\", \"QUATERNIUS/Dance_Loop\"] {\n        assert!(pav_core::clips::find(c).is_some(), \"{c}\");\n    }\n    assert!(pip >= 80''')\nB='tests/browser.py'\nsub(B,'''        check(\"no errors after play\", not errors, errors[:3])\n        # A stay''','''        # Prompts follow the device; Settings has the Xbox option.\n        wait_status(page, lambda x: x.get(\"screen\") == \"title\", 10)\n        page.keyboard.press(\"ArrowDown\"); page.wait_for_timeout(2500)\n        page.keyboard.press(\"ArrowUp\"); page.wait_for_timeout(2500)\n        check(\"prompts show keys after a key\", page.evaluate(\"window.__gamePrompts\") == \"keyboard\", page.evaluate(\"window.__gamePrompts\"))\n        page.mouse.move(150, 90); page.wait_for_timeout(600); page.mouse.move(170, 100); page.wait_for_timeout(2500)\n        check(\"prompts show the mouse after it moves\", page.evaluate(\"window.__gamePrompts\") == \"mouse\", page.evaluate(\"window.__gamePrompts\"))\n        page.keyboard.press(\"ArrowUp\"); page.wait_for_timeout(2500)\n        check(\"no errors after play\", not errors, errors[:3])\n        # A stay''')\nsub(B,'''        check(\"no errors with a pad\", not errors, errors[:3])''','''        check(\"prompts show PlayStation on a pad\", page.evaluate(\"window.__gamePrompts\") == \"playstation\", page.evaluate(\"window.__gamePrompts\"))\n        # Settings, Glyphs: the Xbox option swaps them. New Stay, Together, Settings.\n        pad(13, lambda x: x.get(\"focus\") == 1, \"down to Together\")\n        pad(13, lambda x: x.get(\"focus\") == 2, \"down to Settings\")\n        pad(0, lambda x: x.get(\"screen\") == \"settings\", \"Settings opens by pad\")\n        for want in (1, 2, 3):\n            pad(13, lambda x, w=want: x.get(\"focus\") == w, f\"down to row {want}\")\n        pad(0, lambda x: x.get(\"xbox\") is True, \"the Xbox glyph option\")\n        page.wait_for_timeout(2500)\n        check(\"prompts show Xbox glyphs\", page.evaluate(\"window.__gamePrompts\") == \"xbox\", page.evaluate(\"window.__gamePrompts\"))\n        check(\"no errors with a pad\", not errors, errors[:3])''')\nPY\npython3 tools/gen_sets.py\ncat > notes/plan-audit.md <<'E'\n# PLAN.md and TASK.md, section by section\nStatus: done, or done differently (with why). Evidence: the named test, or the file.\n\n## PLAN.md\n- 0 Reading rules, title in one constant: done (`TITLE` in games/fit/mod.rs; decisions in notes/decisions.md).\n- 1 Genre, perspective, pillars, originality: done. script lint rejects Nintendo names and body talk (`content_is_complete`).\n- 2 Boot menu, New Stay (4 slots, 40 names, 6 skins, 8 outfits), skippable intro (Back skips), day table, goals, minutes, both endings, Free Play: done (`the_bot_plays_new_stay_to_credits`).\n- 3 Controls on pad, keys, mouse; Xbox swap; Options-with-Create ignored; engine keys off, F11 kept: done (input.rs, fit_link.rs; browser checks).\n- 4 Balance Core, shaping, Puck at 340 px: done (`balance_core_feels_like_a_body`). Differently: the arm-flail fades in only when no held clip owns the arms, since a pose or squat clip takes the body.\n- 5 All 11 events, common frame, Big Stand's 5 phases, Morning Check: done (`each_event_rewards...`, `the_big_stand...`, `better_input...`).\n- 6 Clam, calendar, 32 titles, wardrobe, flip-flops, Yesterday You, absence comments, saves: done (`ghosts_draw...`, `saves_round_trip...`).\n- 7 World and cast; Pip 80+, coaches 25+, guests about 8: done (`content_is_complete`). Differently: guests' 8 lines are per guest, not per day.\n- 8 Palette, view recipe, props, library generics (rowboat, bench, lamp, signpost, stall; fence and round table unused, not needed), sway, particles, sunset lights, iris: done (`every_prop_the_game_names_loads`).\n- 9 Clips made and used: done. Differently: Balance_Walk replaced by FIT/CarryTray (decisions.md).\n- 10 Buses, events, sequencer with LFO pads, rhythm clock, buffer 1024, gamepad resume, 6 songs + stingers, 38 SFX, voices: done (pav_audio tests).\n- 11 Route, fonts, rules, glyphs, screens, turntable, mouse ring, touch-only card, Dev Mode tabs and sliders: done. Differently: the Schedule's carousel of pavilions is tabs with rows.\n- 12 Attract: done (`attract_starts...`, browser).\n- 13 Hub ghost mode, tags, order, JS block, ghosts, Play Together: done (tests/hub.py, `medley...`).\n- 14 Architecture: all state in the sim. Differently: the plan's intent.rs, medley.rs, attract.rs and ui_model split are folded into mod.rs, run.rs and menus.rs; weblink.rs is fit_link.rs; rules parse with rules.rs.\n- 15 Traps: followed. Water grid and stage box added (decisions.md, feedback.md).\n- 16 Tests: core, browser, hub behind one command. Differently: UI prompts are tested through `prompt()` and `__gamePrompts`, not the Headless reading.\n- 17 Build order: followed. Nothing cut.\n- 18 Finishing: exit interview, tools/build.sh, full run, 1080p look, chat report, caches deleted.\n\n## TASK.md\n- Title by a real RNG from 50: done (`secrets.randbelow`, 48 of 50).\n- Single html named by the brief, in root: done.\n- Dev subfolder with the same name: done.\n- Engine base, art, animation, code-only audio, gibberish, music 10%: done.\n- AI Hub and on its own: done. Dev mode from pause with sliders and reset: done. Attract: done.\n- Controller-first, prompts by last device, Xbox option, not dense: done. Touch-only card, settings, attract: done.\n- About/Credits with Source Information and all three feedback blocks: done (about-data in the page). Usage reads \"added on import\" as the brief says.\n- exit-interview.json beside the html, parses, every field filled: done.\n- PROGRESS.md: done.\n\n## Cannot be done on this computer\nA person playing it (feel, difficulty), a real pad, phone, TV, ears, a real GPU's speed.\nE\nsed -i 's/^- Tray walk:/- Back skips any dialogue, which is how the intro is skippable.\\n- Tray walk:/' notes/decisions.md\necho \"- Audit round 2: single step did nothing from the pause menu (real bug), no turntable, palms not swaying, LFO and focus bounce missing, 85 notes, intro unskippable; tests added for rewind, step, prompts by device, Xbox.\" >> notes/feedback.md\npython3 - <<'PY'\nimport json\np='../exit-interview.json'; d=json.load(open(p))\nd['testingFeedback'][0]=d['testingFeedback'][0].replace('About 14 real issues','About 16 real issues').replace('and menu text overlaps found in screenshots.','menu text overlaps found in screenshots, and Dev Mode single step doing nothing from the pause menu, found by reading the plan against the code.')\nopen(p,'w').write(json.dumps(d,indent=1,ensure_ascii=False))\nPY\ntools/build.sh 2>&1 | tail -1 | cut -c1-40; tests/run.sh all > notes/final-tests.txt 2>&1; cut -c1-300 notes/final-tests.txt","description":"Fix audit gaps, write the section-by-section audit, rebuild, run the full suite","run_in_background":true,"timeout":2700000}}}
