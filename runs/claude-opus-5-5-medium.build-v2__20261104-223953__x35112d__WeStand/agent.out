{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjFtmduWvdskbBR4xXMq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01D4nPTv3Q7VmxUgAyo1FwPU","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953\nrm -f PROGRESS.md\nF=engine/crates/pav_core/src/games/fit\ncat > $F/ui_model.rs <<'RS'\n//! The UI as data: the sim writes a list of items in a 1920x1080 space, `pav_ui::fit_ui` draws\n//! them. Tests read this list directly, so every screen can be checked with no window or GPU.\n\nuse std::sync::Arc;\n\nuse serde::{Deserialize, Serialize};\n\npub type Rgba = [u8; 4];\n\npub const INK: Rgba = [0x26, 0x3e, 0x54, 255];\npub const WHITE: Rgba = [255, 255, 255, 255];\npub const DECK: Rgba = [0xfb, 0xfa, 0xf6, 255];\npub const TEAL: Rgba = [0x46, 0xbe, 0xc8, 255];\npub const MINT: Rgba = [0x78, 0xdc, 0xaa, 255];\npub const CORAL: Rgba = [0xff, 0x78, 0x6e, 255];\npub const SUN: Rgba = [0xff, 0xd1, 0x66, 255];\npub const PALE: Rgba = [0xe8, 0xf3, 0xf5, 255];\npub const MUTED: Rgba = [0x5d, 0x75, 0x88, 255];\n\n/// Smallest text allowed at 1080p: body and titles (the 10-foot rule).\npub const MIN_BODY: f32 = 34.0;\npub const MIN_TITLE: f32 = 64.0;\n\n/// What a prompt asks for. `pav_ui::glyphs` turns it into a PlayStation, Xbox or keyboard glyph.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub enum Glyph {\n    Confirm,\n    Back,\n    Wave,\n    Schedule,\n    Pause,\n    StepL,\n    StepR,\n    Brace,\n    Lean,\n    Camera,\n    Move,\n    Tabs,\n    Jog,\n}\n\n#[derive(Clone, Debug)]\npub enum Ui {\n    /// The whole screen washed with a colour.\n    Tint { color: Rgba },\n    Card { rect: [f32; 4], color: Rgba, radius: f32, shadow: bool },\n    /// `align`: 0 left, 1 centre, 2 right. `title` picks the display font. `wrap` > 0 wraps.\n    Text { pos: [f32; 2], size: f32, color: Rgba, align: u8, title: bool, text: String, wrap: f32 },\n    /// A focusable item. `value` is shown at the right; `fill` draws a slider (0..1).\n    Button { id: u16, rect: [f32; 4], label: String, sub: String, focused: bool, stars: i8, value: String, fill: Option<f32>, big: bool },\n    /// A row of glyphs and a label.\n    Prompt { pos: [f32; 2], align: u8, glyphs: Vec<Glyph>, label: String, size: f32 },\n    /// A prompt anchored to a point in the world.\n    WorldPrompt { at: [f32; 3], glyph: Glyph, label: String },\n    /// The balance gauge. `dot` and `ring` are unit-disc coordinates (x right, y up).\n    Puck { center: [f32; 2], r: f32, dot: [f32; 2], ring: Option<([f32; 2], f32)>, band: Option<f32>, stars: u8, trace: Vec<[f32; 2]> },\n    Stars { pos: [f32; 2], size: f32, n: u8, of: u8 },\n    Bar { rect: [f32; 4], frac: f32, color: Rgba, marker: Option<f32> },\n    Circle { c: [f32; 2], r: f32, fill: Rgba, stroke: Rgba, width: f32 },\n    Line { a: [f32; 2], b: [f32; 2], width: f32, color: Rgba },\n}\n\n/// One tick's UI, plus the settings the host applies.\n#[derive(Clone, Debug, Default)]\npub struct UiFrame {\n    pub items: Vec<Ui>,\n    /// A short name for the screen, for tests and the page's status.\n    pub screen: &'static str,\n    pub xbox: bool,\n    pub music: f32,\n    pub sfx: f32,\n    pub voice: f32,\n    pub rhythm_offset: f32,\n    /// Dev mode's time scale (1 = normal).\n    pub time_scale: f32,\n    /// Show the engine's stats overlay.\n    pub stats: bool,\n    /// Asks the host to toggle fullscreen when this changes.\n    pub fullscreen: u32,\n    /// The save to store when its serial changes (none in hub sessions).\n    pub save: Option<(u64, Arc<String>)>,\n    /// A hub session is open: the host adds hub ghosts.\n    pub hub: bool,\n    /// Asks the host to wipe nothing more than a reload would: the game is over in the hub.\n    pub silent: bool,\n    /// The input viewer and the dev overlay.\n    pub dev_overlay: bool,\n}\n\n/// Writes items, in the 1920x1080 space.\n#[derive(Default)]\npub struct B {\n    pub items: Vec<Ui>,\n}\n\nimpl B {\n    pub fn tint(&mut self, color: Rgba) {\n        self.items.push(Ui::Tint { color });\n    }\n    pub fn card(&mut self, rect: [f32; 4], color: Rgba) {\n        self.items.push(Ui::Card { rect, color, radius: 36.0, shadow: true });\n    }\n    pub fn flat(&mut self, rect: [f32; 4], color: Rgba, radius: f32) {\n        self.items.push(Ui::Card { rect, color, radius, shadow: false });\n    }\n    fn put(&mut self, pos: [f32; 2], size: f32, color: Rgba, align: u8, title: bool, text: &str, wrap: f32) {\n        // The size rule lives here: no screen can draw smaller.\n        let min = if title { MIN_TITLE } else { MIN_BODY };\n        self.items.push(Ui::Text { pos, size: size.max(min), color, align, title, text: text.to_string(), wrap });\n    }\n    /// Left-aligned body text.\n    pub fn text(&mut self, x: f32, y: f32, size: f32, color: Rgba, text: &str) {\n        self.put([x, y], size, color, 0, false, text, 0.0);\n    }\n    pub fn center(&mut self, x: f32, y: f32, size: f32, color: Rgba, text: &str) {\n        self.put([x, y], size, color, 1, false, text, 0.0);\n    }\n    pub fn right(&mut self, x: f32, y: f32, size: f32, color: Rgba, text: &str) {\n        self.put([x, y], size, color, 2, false, text, 0.0);\n    }\n    pub fn wrap(&mut self, x: f32, y: f32, w: f32, size: f32, color: Rgba, text: &str) {\n        self.put([x, y], size, color, 0, false, text, w);\n    }\n    pub fn wrap_center(&mut self, x: f32, y: f32, w: f32, size: f32, color: Rgba, text: &str) {\n        self.put([x, y], size, color, 1, false, text, w);\n    }\n    /// Display font, centred.\n    pub fn title(&mut self, x: f32, y: f32, size: f32, color: Rgba, text: &str) {\n        self.put([x, y], size, color, 1, true, text, 0.0);\n    }\n    pub fn title_left(&mut self, x: f32, y: f32, size: f32, color: Rgba, text: &str) {\n        self.put([x, y], size, color, 0, true, text, 0.0);\n    }\n    pub fn prompt(&mut self, x: f32, y: f32, glyphs: &[Glyph], label: &str) {\n        self.items.push(Ui::Prompt { pos: [x, y], align: 0, glyphs: glyphs.to_vec(), label: label.to_string(), size: 40.0 });\n    }\n    pub fn prompt_center(&mut self, x: f32, y: f32, glyphs: &[Glyph], label: &str) {\n        self.items.push(Ui::Prompt { pos: [x, y], align: 1, glyphs: glyphs.to_vec(), label: label.to_string(), size: 40.0 });\n    }\n    pub fn prompt_right(&mut self, x: f32, y: f32, glyphs: &[Glyph], label: &str) {\n        self.items.push(Ui::Prompt { pos: [x, y], align: 2, glyphs: glyphs.to_vec(), label: label.to_string(), size: 40.0 });\n    }\n    pub fn stars(&mut self, x: f32, y: f32, size: f32, n: u8, of: u8) {\n        self.items.push(Ui::Stars { pos: [x, y], size, n, of });\n    }\n    pub fn bar(&mut self, rect: [f32; 4], frac: f32, color: Rgba, marker: Option<f32>) {\n        self.items.push(Ui::Bar { rect, frac, color, marker });\n    }\n    pub fn circle(&mut self, c: [f32; 2], r: f32, fill: Rgba, stroke: Rgba, width: f32) {\n        self.items.push(Ui::Circle { c, r, fill, stroke, width });\n    }\n    pub fn puck(&mut self, center: [f32; 2], r: f32, dot: [f32; 2]) {\n        self.items.push(Ui::Puck { center, r, dot, ring: None, band: None, stars: 0, trace: Vec::new() });\n    }\n    /// Sets the last puck's ring, band or stars.\n    pub fn puck_ring(&mut self, at: [f32; 2], radius: f32) {\n        if let Some(Ui::Puck { ring, .. }) = self.items.iter_mut().rev().find(|i| matches!(i, Ui::Puck { .. })) {\n            *ring = Some((at, radius));\n        }\n    }\n    pub fn puck_band(&mut self, half: f32) {\n        if let Some(Ui::Puck { band, .. }) = self.items.iter_mut().rev().find(|i| matches!(i, Ui::Puck { .. })) {\n            *band = Some(half);\n        }\n    }\n    pub fn puck_stars(&mut self, n: u8) {\n        if let Some(Ui::Puck { stars, .. }) = self.items.iter_mut().rev().find(|i| matches!(i, Ui::Puck { .. })) {\n            *stars = n;\n        }\n    }\n    /// Every text on the frame, for tests.\n    pub fn texts(items: &[Ui]) -> Vec<String> {\n        let mut out = Vec::new();\n        for i in items {\n            match i {\n                Ui::Text { text, .. } => out.push(text.clone()),\n                Ui::Button { label, sub, value, .. } => {\n                    out.push(label.clone());\n                    if !sub.is_empty() {\n                        out.push(sub.clone());\n                    }\n                    if !value.is_empty() {\n                        out.push(value.clone());\n                    }\n                }\n                Ui::Prompt { label, .. } | Ui::WorldPrompt { label, .. } => out.push(label.clone()),\n                _ => {}\n            }\n        }\n        out\n    }\n}\nRS\ncat > $F/core.rs <<'RS'\n//! The Balance Core: one analog dot, driven by lean, used by every event.\n\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\n\nuse super::rules::CoreRules;\nuse crate::rng::Rng;\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct BalanceCore {\n    /// The dot: unit disc, x right, y up on screen.\n    pub cob: Vec2,\n    pub vel: Vec2,\n    phase: [f32; 4],\n    kick_in: f32,\n    t: f32,\n    over: f32,\n    /// Steady push (wind) and this tick's shove, both accelerations.\n    pub gust: Vec2,\n    pub nudge: Vec2,\n    /// The event's multiplier on the wobble.\n    pub wobble: f32,\n    /// Attract mode and the No Tips cheat.\n    pub no_tip: bool,\n    pub tips: u32,\n    /// Times the dot crossed from calm to wobbling, for Pip's commentary.\n    pub wobbles: u32,\n    calm: bool,\n    pub left_time: f32,\n    pub right_time: f32,\n}\n\nimpl BalanceCore {\n    pub fn new(rng: &mut Rng) -> Self {\n        let mut c = Self { wobble: 1.0, kick_in: 1.0, ..Default::default() };\n        c.reseed(rng);\n        c\n    }\n\n    pub fn reseed(&mut self, rng: &mut Rng) {\n        for p in &mut self.phase {\n            *p = rng.range(0.0, std::f32::consts::TAU);\n        }\n        self.kick_in = rng.range(1.0, 2.0);\n    }\n\n    /// Starts over at the centre, keeping the wobble's phases.\n    pub fn center(&mut self) {\n        self.cob = Vec2::ZERO;\n        self.vel = Vec2::ZERO;\n        self.over = 0.0;\n        self.gust = Vec2::ZERO;\n        self.nudge = Vec2::ZERO;\n    }\n\n    fn wobble_at(&self, r: &CoreRules) -> Vec2 {\n        use std::f32::consts::TAU;\n        let amp = r.wobble * self.wobble;\n        let w = |a: f32, b: f32| amp * (0.7 * (TAU * 1.3 * self.t + a).sin() + 0.3 * (TAU * 2.9 * self.t + b).sin());\n        Vec2::new(w(self.phase[0], self.phase[1]), w(self.phase[2], self.phase[3]))\n    }\n\n    /// One tick. Returns true on the tick the figure tips.\n    pub fn tick(&mut self, lean: Vec2, r: &CoreRules, rng: &mut Rng, dt: f32) -> bool {\n        self.t += dt;\n        let target = lean.clamp_length_max(1.0) * r.reach + self.wobble_at(r);\n        let acc = (target - self.cob) * r.stiffness - self.vel * r.damping + self.gust + self.nudge;\n        self.nudge = Vec2::ZERO;\n        self.vel += acc * dt;\n        self.kick_in -= dt;\n        if self.kick_in <= 0.0 {\n            self.kick_in = rng.range(1.0, 2.0);\n            let a = rng.range(0.0, std::f32::consts::TAU);\n            self.vel += Vec2::new(a.cos(), a.sin()) * r.kick * self.wobble;\n        }\n        self.cob += self.vel * dt;\n        if self.cob.x < -0.05 {\n            self.left_time += dt;\n        } else if self.cob.x > 0.05 {\n            self.right_time += dt;\n        }\n        let wobbling = self.vel.length() > 0.8;\n        if wobbling && self.calm {\n            self.wobbles += 1;\n        }\n        self.calm = !wobbling;\n        if self.cob.length() > 1.0 {\n            self.over += dt;\n            if self.over >= r.tip_time && !self.no_tip {\n                self.over = 0.0;\n                self.tips += 1;\n                self.cob *= 0.3;\n                self.vel = Vec2::ZERO;\n                return true;\n            }\n        } else {\n            self.over = 0.0;\n        }\n        false\n    }\n}\n\n/// A stick's shaping, as the host applies it (kept here so tests can check the curve).\npub fn shape_stick(v: Vec2, deadzone: f32, power: f32) -> Vec2 {\n    let l = v.length();\n    if l < deadzone {\n        return Vec2::ZERO;\n    }\n    let k = ((l - deadzone) / (1.0 - deadzone)).clamp(0.0, 1.0);\n    v / l * k.powf(power)\n}\n\n/// Keys: the target moves toward the held direction and eases back when released.\npub fn ramp_keys(cur: Vec2, held: Vec2, rate_in: f32, rate_out: f32, dt: f32) -> Vec2 {\n    let mut out = cur;\n    for (c, h) in [(&mut out.x, held.x), (&mut out.y, held.y)] {\n        if h != 0.0 {\n            *c = (*c + h * rate_in * dt).clamp(-1.0, 1.0);\n        } else {\n            let d = rate_out * dt;\n            *c = if c.abs() <= d { 0.0 } else { *c - c.signum() * d };\n        }\n    }\n    out.clamp_length_max(1.0)\n}\nRS\ncat > $F/rules.rs <<'RS'\n//! Every balance number, with a default, read from `rules.toml`. Dev mode's sliders come from the\n//! same declarations: range and help text sit beside each number.\n\nuse serde::{Deserialize, Serialize};\n\nuse crate::params::{ParamVisitor, Tunable, nested};\n\nmacro_rules! group {\n    ($name:ident { $($f:ident : $d:expr, $min:expr, $max:expr, $help:literal;)* }) => {\n        #[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n        #[serde(default)]\n        pub struct $name { $(pub $f: f32,)* }\n        impl Default for $name { fn default() -> Self { Self { $($f: $d,)* } } }\n        impl Tunable for $name {\n            fn visit(&mut self, v: &mut dyn ParamVisitor) {\n                $(v.float(stringify!($f), &mut self.$f, $min, $max, $help);)*\n            }\n        }\n    };\n}\n\ngroup!(CoreRules {\n    stiffness: 40.0, 5.0, 100.0, \"How hard the body follows the lean\";\n    damping: 8.5, 1.0, 30.0, \"How quickly a sway settles\";\n    reach: 0.92, 0.5, 1.2, \"How far a full lean reaches\";\n    tip_time: 0.35, 0.1, 1.5, \"Seconds outside the disc before you tip\";\n    wobble: 0.12, 0.0, 0.5, \"Size of the constant wobble\";\n    kick: 0.1, 0.0, 1.0, \"Random sway kicks\";\n    stick_deadzone: 0.12, 0.0, 0.4, \"Stick dead zone\";\n    stick_curve: 1.5, 1.0, 3.0, \"Stick response curve\";\n    key_rate: 1.6, 0.4, 5.0, \"Keys: lean build-up per second\";\n    key_return: 1.2, 0.4, 5.0, \"Keys: lean return per second\";\n    mouse_range: 0.38, 0.1, 0.5, \"Mouse: reach as a share of the window height\";\n});\ngroup!(BreathRules {\n    seconds_in: 4.0, 2.0, 8.0, \"Seconds of a breath in\";\n    match_width: 0.35, 0.1, 0.8, \"How close to the guide counts\";\n    ring: 0.35, 0.1, 0.7, \"Centre ring radius\";\n    wobble: 0.8, 0.0, 3.0, \"Wobble in this event\";\n});\ngroup!(PoseRules {\n    seconds: 20.0, 8.0, 40.0, \"Seconds per pose\";\n    ring_start: 0.30, 0.1, 0.6, \"Ring radius at the start of a pose\";\n    ring_end: 0.18, 0.05, 0.4, \"Ring radius at the end of a pose\";\n    drift: 0.35, 0.0, 0.8, \"How far the ring drifts\";\n    drift_hz: 0.12, 0.02, 0.5, \"How fast the ring drifts\";\n    gull_wobble: 1.6, 1.0, 4.0, \"Wobble with a gull on your head\";\n    full_score: 3.2, 1.0, 4.0, \"Mean multiplier worth 1000\";\n});\ngroup!(SquatRules {\n    reps: 10.0, 3.0, 20.0, \"Repetitions\";\n    down: 2.0, 0.5, 4.0, \"Seconds to full depth\";\n    up: 1.0, 0.3, 3.0, \"Seconds to rise\";\n    rest: 2.0, 0.2, 4.0, \"Seconds between reps\";\n    band: 0.25, 0.05, 0.6, \"Half width of the balance band\";\n    wobble_per_rep: 0.08, 0.0, 0.5, \"Extra wobble per rep\";\n});\ngroup!(PlankRules {\n    ring_start: 0.40, 0.15, 0.8, \"Ring radius at the start\";\n    ring_end: 0.20, 0.05, 0.5, \"Ring radius at the end\";\n    fatigue: 1.5, 0.0, 5.0, \"Wobble added over a minute\";\n    grace: 1.0, 0.2, 3.0, \"Seconds outside the ring before you flop\";\n    seconds: 60.0, 20.0, 120.0, \"Longest plank\";\n});\ngroup!(StepRules {\n    bpm: 96.0, 60.0, 160.0, \"Tempo\";\n    perfect: 0.055, 0.02, 0.15, \"Perfect window (s)\";\n    good: 0.12, 0.05, 0.3, \"Good window (s)\";\n    wobble: 0.6, 0.0, 3.0, \"Wobble while stepping\";\n});\ngroup!(SpinRules {\n    seconds: 50.0, 15.0, 90.0, \"Length\";\n    band_low: 6.0, 2.0, 10.0, \"Slowest good spin (rad/s)\";\n    band_high: 9.0, 4.0, 16.0, \"Fastest good spin (rad/s)\";\n    band_scale_keys: 0.45, 0.2, 1.0, \"Band scale on keyboard\";\n    switch_every: 15.0, 5.0, 40.0, \"Seconds between Switch calls\";\n    toss_every: 5.0, 1.0, 15.0, \"Seconds between tossed rings\";\n    catch_window: 0.25, 0.1, 0.8, \"Catch window (s)\";\n    sink: 0.5, 0.05, 2.0, \"How fast rings sink out of the band\";\n    rise: 0.8, 0.05, 2.0, \"How fast rings rise in the band\";\n});\ngroup!(LapRules {\n    seconds: 90.0, 30.0, 180.0, \"Time limit\";\n    pace_low: 1.6, 0.8, 3.0, \"Slowest good pace (steps/s)\";\n    pace_high: 2.4, 1.2, 4.0, \"Fastest good pace (steps/s)\";\n    speed_per_step: 1.65, 0.5, 4.0, \"Metres per step\";\n    stitch_rate: 0.35, 0.05, 1.5, \"Stitch build-up when too fast\";\n    side_reach: 1.2, 0.3, 2.5, \"How far you can move aside (m)\";\n    obstacles: 18.0, 0.0, 40.0, \"Crabs, towels and sunbathers\";\n    ribbons: 14.0, 0.0, 40.0, \"Ribbons\";\n});\ngroup!(TideRules {\n    seconds: 60.0, 20.0, 120.0, \"Time for all three boards\";\n    gravity: 9.0, 1.0, 25.0, \"How strongly the tilt rolls shells\";\n    friction: 0.9, 0.1, 4.0, \"Shell friction\";\n    skip_speed: 3.4, 1.0, 8.0, \"Faster shells skip over pools\";\n    pool_radius: 0.72, 0.3, 1.5, \"Pool radius (m)\";\n    half: 3.8, 2.0, 6.0, \"Half size of the raft (m)\";\n});\ngroup!(PaddleRules {\n    par: 45.0, 20.0, 120.0, \"Par time (s)\";\n    cruise: 2.0, 0.5, 6.0, \"Speed with no forward lean (m/s)\";\n    sprint: 9.0, 3.0, 20.0, \"Speed at a full forward lean (m/s)\";\n    steer: 7.0, 1.0, 20.0, \"Sideways speed at a full lean (m/s)\";\n    gust: 7.0, 0.0, 30.0, \"Gust strength\";\n    gates: 16.0, 4.0, 30.0, \"Gates on the course\";\n    gate_width: 2.6, 1.0, 6.0, \"Half width of a gate (m)\";\n    remount: 2.0, 0.5, 6.0, \"Seconds to climb back on\";\n    wobble: 1.4, 0.0, 4.0, \"Wobble on the board\";\n});\ngroup!(TrayRules {\n    pace: 1.55, 0.5, 4.0, \"Walking pace (m/s)\";\n    slide: 2.2, 0.5, 8.0, \"How fast glasses slide with tilt\";\n    friction: 1.3, 0.1, 5.0, \"Glass friction\";\n    edge: 0.42, 0.2, 0.8, \"Tray radius (m)\";\n    jolt: 26.0, 0.0, 100.0, \"Size of the jolts\";\n    sway: 0.55, 0.0, 1.2, \"How much the pier rolls the tray\";\n    no_spill_bonus: 100.0, 0.0, 300.0, \"Bonus for no spills\";\n});\ngroup!(DiveRules {\n    period: 1.2, 0.6, 2.4, \"Board bounce period (s)\";\n    timing: 0.22, 0.05, 0.5, \"Timing window around the bottom (s)\";\n    height: 4.2, 1.0, 12.0, \"Leap height at full power (m)\";\n    bounce_gain: 0.8, 0.1, 2.0, \"Height per good bounce\";\n    spin: 7.0, 1.0, 20.0, \"Rotation speed at a full lean (rad/s)\";\n    wait: 10.0, 3.0, 30.0, \"Seconds before the board tips you off\";\n});\ngroup!(FinaleRules {\n    gust: 11.0, 0.0, 40.0, \"Gusts in the pose phase\";\n    waves: 16.0, 0.0, 60.0, \"Wave shoves in the brace phase\";\n    wobble: 1.3, 0.0, 4.0, \"Extra wobble\";\n    stillness: 30.0, 5.0, 60.0, \"Seconds of the Long Stillness\";\n    bonus: 150.0, 0.0, 400.0, \"Inner Peace bonus\";\n    tip_cost: 40.0, 0.0, 200.0, \"Score lost per tip\";\n});\n\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct Rules {\n    pub core: CoreRules,\n    pub breath: BreathRules,\n    pub pose: PoseRules,\n    pub squats: SquatRules,\n    pub plank: PlankRules,\n    pub step: StepRules,\n    pub spin: SpinRules,\n    pub lap: LapRules,\n    pub tide: TideRules,\n    pub paddle: PaddleRules,\n    pub tray: TrayRules,\n    pub dive: DiveRules,\n    pub finale: FinaleRules,\n}\n\nimpl Tunable for Rules {\n    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n        nested(v, \"core\", &mut self.core);\n        nested(v, \"breath\", &mut self.breath);\n        nested(v, \"pose\", &mut self.pose);\n        nested(v, \"squats\", &mut self.squats);\n        nested(v, \"plank\", &mut self.plank);\n        nested(v, \"step\", &mut self.step);\n        nested(v, \"spin\", &mut self.spin);\n        nested(v, \"lap\", &mut self.lap);\n        nested(v, \"tide\", &mut self.tide);\n        nested(v, \"paddle\", &mut self.paddle);\n        nested(v, \"tray\", &mut self.tray);\n        nested(v, \"dive\", &mut self.dive);\n        nested(v, \"finale\", &mut self.finale);\n    }\n}\n\n/// The groups' names, in Dev Mode's order.\npub const GROUPS: [&str; 13] =\n    [\"core\", \"breath\", \"pose\", \"squats\", \"plank\", \"step\", \"spin\", \"lap\", \"tide\", \"paddle\", \"tray\", \"dive\", \"finale\"];\nRS\ncat > $F/rules.toml <<'RS'\n# Every balance number in We Stand. Running from engine/, the game reads this file at each load,\n# so a change here needs no rebuild. Numbers left out use the defaults in rules.rs, where each has\n# its range and help text. Dev Mode's Tuning tab edits these live.\n\n[core]\nstiffness = 40.0\ndamping = 8.5\nreach = 0.92\ntip_time = 0.35\nwobble = 0.12\n\n[pose]\nseconds = 20.0\n\n[step]\nbpm = 96.0\n\n[paddle]\npar = 45.0\nRS\ncat > $F/charts.toml <<'RS'\n# Step Party's notes: one string per bar of 4/4, eight steps a bar. L left, R right, B both, . rest.\n# The song is 96 BPM, a bar is 2.5 s. Notes start after one bar of count-in.\nbars = [\n \"L...R...\", \"L...R...\", \"L...R...\", \"L...R...\",\n \"L.R.L...\", \"R.L.R...\", \"L...R...\", \"L.R.B...\",\n \"L.R.L.R.\", \"L...R...\", \"L.R.L.R.\", \"L...B...\",\n \"R.L.R.L.\", \"R...L...\", \"L.RLR...\", \"L.R.B...\",\n \"L.R.L.R.\", \"LR..LR..\", \"L.R.B.B.\", \"L.RL.RL.\",\n \"B...L.R.\", \"B...R.L.\", \"LRLR....\", \"B.B.B...\",\n]\nRS\npython3 - <<'PY'\nimport re\nbars=re.findall(r'\"([LRB.]{8})\"',open('/dev/stdin').read()) if False else None\nPY\ngrep -o '\"[LRB.]\\{8\\}\"' $F/charts.toml | tr -d '\".\\n' | wc -c","description":"Write the UI model, Balance Core, rules and step chart"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12668,"cache_read_input_tokens":281954,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12668},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cb437ba7-0477-4143-bb04-ff33f49efd62","uuid":"368ffcd8-2583-4d43-aeac-37d8d97a8dee","timestamp":"2026-11-05T05:51:30.497Z","request_id":"req_011CgjFtm9PehBtqs5JubouH","wire_tool_inputs":{"toolu_01D4nPTv3Q7VmxUgAyo1FwPU":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261104-223953__x35112d/work/WeStand-WiiFit-claude-opus-5-5-medium-20261104-223953\nrm -f PROGRESS.md\nF=engine/crates/pav_core/src/games/fit\ncat > $F/ui_model.rs <<'RS'\n//! The UI as data: the sim writes a list of items in a 1920x1080 space, `pav_ui::fit_ui` draws\n//! them. Tests read this list directly, so every screen can be checked with no window or GPU.\n\nuse std::sync::Arc;\n\nuse serde::{Deserialize, Serialize};\n\npub type Rgba = [u8; 4];\n\npub const INK: Rgba = [0x26, 0x3e, 0x54, 255];\npub const WHITE: Rgba = [255, 255, 255, 255];\npub const DECK: Rgba = [0xfb, 0xfa, 0xf6, 255];\npub const TEAL: Rgba = [0x46, 0xbe, 0xc8, 255];\npub const MINT: Rgba = [0x78, 0xdc, 0xaa, 255];\npub const CORAL: Rgba = [0xff, 0x78, 0x6e, 255];\npub const SUN: Rgba = [0xff, 0xd1, 0x66, 255];\npub const PALE: Rgba = [0xe8, 0xf3, 0xf5, 255];\npub const MUTED: Rgba = [0x5d, 0x75, 0x88, 255];\n\n/// Smallest text allowed at 1080p: body and titles (the 10-foot rule).\npub const MIN_BODY: f32 = 34.0;\npub const MIN_TITLE: f32 = 64.0;\n\n/// What a prompt asks for. `pav_ui::glyphs` turns it into a PlayStation, Xbox or keyboard glyph.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub enum Glyph {\n    Confirm,\n    Back,\n    Wave,\n    Schedule,\n    Pause,\n    StepL,\n    StepR,\n    Brace,\n    Lean,\n    Camera,\n    Move,\n    Tabs,\n    Jog,\n}\n\n#[derive(Clone, Debug)]\npub enum Ui {\n    /// The whole screen washed with a colour.\n    Tint { color: Rgba },\n    Card { rect: [f32; 4], color: Rgba, radius: f32, shadow: bool },\n    /// `align`: 0 left, 1 centre, 2 right. `title` picks the display font. `wrap` > 0 wraps.\n    Text { pos: [f32; 2], size: f32, color: Rgba, align: u8, title: bool, text: String, wrap: f32 },\n    /// A focusable item. `value` is shown at the right; `fill` draws a slider (0..1).\n    Button { id: u16, rect: [f32; 4], label: String, sub: String, focused: bool, stars: i8, value: String, fill: Option<f32>, big: bool },\n    /// A row of glyphs and a label.\n    Prompt { pos: [f32; 2], align: u8, glyphs: Vec<Glyph>, label: String, size: f32 },\n    /// A prompt anchored to a point in the world.\n    WorldPrompt { at: [f32; 3], glyph: Glyph, label: String },\n    /// The balance gauge. `dot` and `ring` are unit-disc coordinates (x right, y up).\n    Puck { center: [f32; 2], r: f32, dot: [f32; 2], ring: Option<([f32; 2], f32)>, band: Option<f32>, stars: u8, trace: Vec<[f32; 2]> },\n    Stars { pos: [f32; 2], size: f32, n: u8, of: u8 },\n    Bar { rect: [f32; 4], frac: f32, color: Rgba, marker: Option<f32> },\n    Circle { c: [f32; 2], r: f32, fill: Rgba, stroke: Rgba, width: f32 },\n    Line { a: [f32; 2], b: [f32; 2], width: f32, color: Rgba },\n}\n\n/// One tick's UI, plus the settings the host applies.\n#[derive(Clone, Debug, Default)]\npub struct UiFrame {\n    pub items: Vec<Ui>,\n    /// A short name for the screen, for tests and the page's status.\n    pub screen: &'static str,\n    pub xbox: bool,\n    pub music: f32,\n    pub sfx: f32,\n    pub voice: f32,\n    pub rhythm_offset: f32,\n    /// Dev mode's time scale (1 = normal).\n    pub time_scale: f32,\n    /// Show the engine's stats overlay.\n    pub stats: bool,\n    /// Asks the host to toggle fullscreen when this changes.\n    pub fullscreen: u32,\n    /// The save to store when its serial changes (none in hub sessions).\n    pub save: Option<(u64, Arc<String>)>,\n    /// A hub session is open: the host adds hub ghosts.\n    pub hub: bool,\n    /// Asks the host to wipe nothing more than a reload would: the game is over in the hub.\n    pub silent: bool,\n    /// The input viewer and the dev overlay.\n    pub dev_overlay: bool,\n}\n\n/// Writes items, in the 1920x1080 space.\n#[derive(Default)]\npub struct B {\n    pub items: Vec<Ui>,\n}\n\nimpl B {\n    pub fn tint(&mut self, color: Rgba) {\n        self.items.push(Ui::Tint { color });\n    }\n    pub fn card(&mut self, rect: [f32; 4], color: Rgba) {\n        self.items.push(Ui::Card { rect, color, radius: 36.0, shadow: true });\n    }\n    pub fn flat(&mut self, rect: [f32; 4], color: Rgba, radius: f32) {\n        self.items.push(Ui::Card { rect, color, radius, shadow: false });\n    }\n    fn put(&mut self, pos: [f32; 2], size: f32, color: Rgba, align: u8, title: bool, text: &str, wrap: f32) {\n        // The size rule lives here: no screen can draw smaller.\n        let min = if title { MIN_TITLE } else { MIN_BODY };\n        self.items.push(Ui::Text { pos, size: size.max(min), color, align, title, text: text.to_string(), wrap });\n    }\n    /// Left-aligned body text.\n    pub fn text(&mut self, x: f32, y: f32, size: f32, color: Rgba, text: &str) {\n        self.put([x, y], size, color, 0, false, text, 0.0);\n    }\n    pub fn center(&mut self, x: f32, y: f32, size: f32, color: Rgba, text: &str) {\n        self.put([x, y], size, color, 1, false, text, 0.0);\n    }\n    pub fn right(&mut self, x: f32, y: f32, size: f32, color: Rgba, text: &str) {\n        self.put([x, y], size, color, 2, false, text, 0.0);\n    }\n    pub fn wrap(&mut self, x: f32, y: f32, w: f32, size: f32, color: Rgba, text: &str) {\n        self.put([x, y], size, color, 0, false, text, w);\n    }\n    pub fn wrap_center(&mut self, x: f32, y: f32, w: f32, size: f32, color: Rgba, text: &str) {\n        self.put([x, y], size, color, 1, false, text, w);\n    }\n    /// Display font, centred.\n    pub fn title(&mut self, x: f32, y: f32, size: f32, color: Rgba, text: &str) {\n        self.put([x, y], size, color, 1, true, text, 0.0);\n    }\n    pub fn title_left(&mut self, x: f32, y: f32, size: f32, color: Rgba, text: &str) {\n        self.put([x, y], size, color, 0, true, text, 0.0);\n    }\n    pub fn prompt(&mut self, x: f32, y: f32, glyphs: &[Glyph], label: &str) {\n        self.items.push(Ui::Prompt { pos: [x, y], align: 0, glyphs: glyphs.to_vec(), label: label.to_string(), size: 40.0 });\n    }\n    pub fn prompt_center(&mut self, x: f32, y: f32, glyphs: &[Glyph], label: &str) {\n        self.items.push(Ui::Prompt { pos: [x, y], align: 1, glyphs: glyphs.to_vec(), label: label.to_string(), size: 40.0 });\n    }\n    pub fn prompt_right(&mut self, x: f32, y: f32, glyphs: &[Glyph], label: &str) {\n        self.items.push(Ui::Prompt { pos: [x, y], align: 2, glyphs: glyphs.to_vec(), label: label.to_string(), size: 40.0 });\n    }\n    pub fn stars(&mut self, x: f32, y: f32, size: f32, n: u8, of: u8) {\n        self.items.push(Ui::Stars { pos: [x, y], size, n, of });\n    }\n    pub fn bar(&mut self, rect: [f32; 4], frac: f32, color: Rgba, marker: Option<f32>) {\n        self.items.push(Ui::Bar { rect, frac, color, marker });\n    }\n    pub fn circle(&mut self, c: [f32; 2], r: f32, fill: Rgba, stroke: Rgba, width: f32) {\n        self.items.push(Ui::Circle { c, r, fill, stroke, width });\n    }\n    pub fn puck(&mut self, center: [f32; 2], r: f32, dot: [f32; 2]) {\n        self.items.push(Ui::Puck { center, r, dot, ring: None, band: None, stars: 0, trace: Vec::new() });\n    }\n    /// Sets the last puck's ring, band or stars.\n    pub fn puck_ring(&mut self, at: [f32; 2], radius: f32) {\n        if let Some(Ui::Puck { ring, .. }) = self.items.iter_mut().rev().find(|i| matches!(i, Ui::Puck { .. })) {\n            *ring = Some((at, radius));\n        }\n    }\n    pub fn puck_band(&mut self, half: f32) {\n        if let Some(Ui::Puck { band, .. }) = self.items.iter_mut().rev().find(|i| matches!(i, Ui::Puck { .. })) {\n            *band = Some(half);\n        }\n    }\n    pub fn puck_stars(&mut self, n: u8) {\n        if let Some(Ui::Puck { stars, .. }) = self.items.iter_mut().rev().find(|i| matches!(i, Ui::Puck { .. })) {\n            *stars = n;\n        }\n    }\n    /// Every text on the frame, for tests.\n    pub fn texts(items: &[Ui]) -> Vec<String> {\n        let mut out = Vec::new();\n        for i in items {\n            match i {\n                Ui::Text { text, .. } => out.push(text.clone()),\n                Ui::Button { label, sub, value, .. } => {\n                    out.push(label.clone());\n                    if !sub.is_empty() {\n                        out.push(sub.clone());\n                    }\n                    if !value.is_empty() {\n                        out.push(value.clone());\n                    }\n                }\n                Ui::Prompt { label, .. } | Ui::WorldPrompt { label, .. } => out.push(label.clone()),\n                _ => {}\n            }\n        }\n        out\n    }\n}\nRS\ncat > $F/core.rs <<'RS'\n//! The Balance Core: one analog dot, driven by lean, used by every event.\n\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\n\nuse super::rules::CoreRules;\nuse crate::rng::Rng;\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct BalanceCore {\n    /// The dot: unit disc, x right, y up on screen.\n    pub cob: Vec2,\n    pub vel: Vec2,\n    phase: [f32; 4],\n    kick_in: f32,\n    t: f32,\n    over: f32,\n    /// Steady push (wind) and this tick's shove, both accelerations.\n    pub gust: Vec2,\n    pub nudge: Vec2,\n    /// The event's multiplier on the wobble.\n    pub wobble: f32,\n    /// Attract mode and the No Tips cheat.\n    pub no_tip: bool,\n    pub tips: u32,\n    /// Times the dot crossed from calm to wobbling, for Pip's commentary.\n    pub wobbles: u32,\n    calm: bool,\n    pub left_time: f32,\n    pub right_time: f32,\n}\n\nimpl BalanceCore {\n    pub fn new(rng: &mut Rng) -> Self {\n        let mut c = Self { wobble: 1.0, kick_in: 1.0, ..Default::default() };\n        c.reseed(rng);\n        c\n    }\n\n    pub fn reseed(&mut self, rng: &mut Rng) {\n        for p in &mut self.phase {\n            *p = rng.range(0.0, std::f32::consts::TAU);\n        }\n        self.kick_in = rng.range(1.0, 2.0);\n    }\n\n    /// Starts over at the centre, keeping the wobble's phases.\n    pub fn center(&mut self) {\n        self.cob = Vec2::ZERO;\n        self.vel = Vec2::ZERO;\n        self.over = 0.0;\n        self.gust = Vec2::ZERO;\n        self.nudge = Vec2::ZERO;\n    }\n\n    fn wobble_at(&self, r: &CoreRules) -> Vec2 {\n        use std::f32::consts::TAU;\n        let amp = r.wobble * self.wobble;\n        let w = |a: f32, b: f32| amp * (0.7 * (TAU * 1.3 * self.t + a).sin() + 0.3 * (TAU * 2.9 * self.t + b).sin());\n        Vec2::new(w(self.phase[0], self.phase[1]), w(self.phase[2], self.phase[3]))\n    }\n\n    /// One tick. Returns true on the tick the figure tips.\n    pub fn tick(&mut self, lean: Vec2, r: &CoreRules, rng: &mut Rng, dt: f32) -> bool {\n        self.t += dt;\n        let target = lean.clamp_length_max(1.0) * r.reach + self.wobble_at(r);\n        let acc = (target - self.cob) * r.stiffness - self.vel * r.damping + self.gust + self.nudge;\n        self.nudge = Vec2::ZERO;\n        self.vel += acc * dt;\n        self.kick_in -= dt;\n        if self.kick_in <= 0.0 {\n            self.kick_in = rng.range(1.0, 2.0);\n            let a = rng.range(0.0, std::f32::consts::TAU);\n            self.vel += Vec2::new(a.cos(), a.sin()) * r.kick * self.wobble;\n        }\n        self.cob += self.vel * dt;\n        if self.cob.x < -0.05 {\n            self.left_time += dt;\n        } else if self.cob.x > 0.05 {\n            self.right_time += dt;\n        }\n        let wobbling = self.vel.length() > 0.8;\n        if wobbling && self.calm {\n            self.wobbles += 1;\n        }\n        self.calm = !wobbling;\n        if self.cob.length() > 1.0 {\n            self.over += dt;\n            if self.over >= r.tip_time && !self.no_tip {\n                self.over = 0.0;\n                self.tips += 1;\n                self.cob *= 0.3;\n                self.vel = Vec2::ZERO;\n                return true;\n            }\n        } else {\n            self.over = 0.0;\n        }\n        false\n    }\n}\n\n/// A stick's shaping, as the host applies it (kept here so tests can check the curve).\npub fn shape_stick(v: Vec2, deadzone: f32, power: f32) -> Vec2 {\n    let l = v.length();\n    if l < deadzone {\n        return Vec2::ZERO;\n    }\n    let k = ((l - deadzone) / (1.0 - deadzone)).clamp(0.0, 1.0);\n    v / l * k.powf(power)\n}\n\n/// Keys: the target moves toward the held direction and eases back when released.\npub fn ramp_keys(cur: Vec2, held: Vec2, rate_in: f32, rate_out: f32, dt: f32) -> Vec2 {\n    let mut out = cur;\n    for (c, h) in [(&mut out.x, held.x), (&mut out.y, held.y)] {\n        if h != 0.0 {\n            *c = (*c + h * rate_in * dt).clamp(-1.0, 1.0);\n        } else {\n            let d = rate_out * dt;\n            *c = if c.abs() <= d { 0.0 } else { *c - c.signum() * d };\n        }\n    }\n    out.clamp_length_max(1.0)\n}\nRS\ncat > $F/rules.rs <<'RS'\n//! Every balance number, with a default, read from `rules.toml`. Dev mode's sliders come from the\n//! same declarations: range and help text sit beside each number.\n\nuse serde::{Deserialize, Serialize};\n\nuse crate::params::{ParamVisitor, Tunable, nested};\n\nmacro_rules! group {\n    ($name:ident { $($f:ident : $d:expr, $min:expr, $max:expr, $help:literal;)* }) => {\n        #[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n        #[serde(default)]\n        pub struct $name { $(pub $f: f32,)* }\n        impl Default for $name { fn default() -> Self { Self { $($f: $d,)* } } }\n        impl Tunable for $name {\n            fn visit(&mut self, v: &mut dyn ParamVisitor) {\n                $(v.float(stringify!($f), &mut self.$f, $min, $max, $help);)*\n            }\n        }\n    };\n}\n\ngroup!(CoreRules {\n    stiffness: 40.0, 5.0, 100.0, \"How hard the body follows the lean\";\n    damping: 8.5, 1.0, 30.0, \"How quickly a sway settles\";\n    reach: 0.92, 0.5, 1.2, \"How far a full lean reaches\";\n    tip_time: 0.35, 0.1, 1.5, \"Seconds outside the disc before you tip\";\n    wobble: 0.12, 0.0, 0.5, \"Size of the constant wobble\";\n    kick: 0.1, 0.0, 1.0, \"Random sway kicks\";\n    stick_deadzone: 0.12, 0.0, 0.4, \"Stick dead zone\";\n    stick_curve: 1.5, 1.0, 3.0, \"Stick response curve\";\n    key_rate: 1.6, 0.4, 5.0, \"Keys: lean build-up per second\";\n    key_return: 1.2, 0.4, 5.0, \"Keys: lean return per second\";\n    mouse_range: 0.38, 0.1, 0.5, \"Mouse: reach as a share of the window height\";\n});\ngroup!(BreathRules {\n    seconds_in: 4.0, 2.0, 8.0, \"Seconds of a breath in\";\n    match_width: 0.35, 0.1, 0.8, \"How close to the guide counts\";\n    ring: 0.35, 0.1, 0.7, \"Centre ring radius\";\n    wobble: 0.8, 0.0, 3.0, \"Wobble in this event\";\n});\ngroup!(PoseRules {\n    seconds: 20.0, 8.0, 40.0, \"Seconds per pose\";\n    ring_start: 0.30, 0.1, 0.6, \"Ring radius at the start of a pose\";\n    ring_end: 0.18, 0.05, 0.4, \"Ring radius at the end of a pose\";\n    drift: 0.35, 0.0, 0.8, \"How far the ring drifts\";\n    drift_hz: 0.12, 0.02, 0.5, \"How fast the ring drifts\";\n    gull_wobble: 1.6, 1.0, 4.0, \"Wobble with a gull on your head\";\n    full_score: 3.2, 1.0, 4.0, \"Mean multiplier worth 1000\";\n});\ngroup!(SquatRules {\n    reps: 10.0, 3.0, 20.0, \"Repetitions\";\n    down: 2.0, 0.5, 4.0, \"Seconds to full depth\";\n    up: 1.0, 0.3, 3.0, \"Seconds to rise\";\n    rest: 2.0, 0.2, 4.0, \"Seconds between reps\";\n    band: 0.25, 0.05, 0.6, \"Half width of the balance band\";\n    wobble_per_rep: 0.08, 0.0, 0.5, \"Extra wobble per rep\";\n});\ngroup!(PlankRules {\n    ring_start: 0.40, 0.15, 0.8, \"Ring radius at the start\";\n    ring_end: 0.20, 0.05, 0.5, \"Ring radius at the end\";\n    fatigue: 1.5, 0.0, 5.0, \"Wobble added over a minute\";\n    grace: 1.0, 0.2, 3.0, \"Seconds outside the ring before you flop\";\n    seconds: 60.0, 20.0, 120.0, \"Longest plank\";\n});\ngroup!(StepRules {\n    bpm: 96.0, 60.0, 160.0, \"Tempo\";\n    perfect: 0.055, 0.02, 0.15, \"Perfect window (s)\";\n    good: 0.12, 0.05, 0.3, \"Good window (s)\";\n    wobble: 0.6, 0.0, 3.0, \"Wobble while stepping\";\n});\ngroup!(SpinRules {\n    seconds: 50.0, 15.0, 90.0, \"Length\";\n    band_low: 6.0, 2.0, 10.0, \"Slowest good spin (rad/s)\";\n    band_high: 9.0, 4.0, 16.0, \"Fastest good spin (rad/s)\";\n    band_scale_keys: 0.45, 0.2, 1.0, \"Band scale on keyboard\";\n    switch_every: 15.0, 5.0, 40.0, \"Seconds between Switch calls\";\n    toss_every: 5.0, 1.0, 15.0, \"Seconds between tossed rings\";\n    catch_window: 0.25, 0.1, 0.8, \"Catch window (s)\";\n    sink: 0.5, 0.05, 2.0, \"How fast rings sink out of the band\";\n    rise: 0.8, 0.05, 2.0, \"How fast rings rise in the band\";\n});\ngroup!(LapRules {\n    seconds: 90.0, 30.0, 180.0, \"Time limit\";\n    pace_low: 1.6, 0.8, 3.0, \"Slowest good pace (steps/s)\";\n    pace_high: 2.4, 1.2, 4.0, \"Fastest good pace (steps/s)\";\n    speed_per_step: 1.65, 0.5, 4.0, \"Metres per step\";\n    stitch_rate: 0.35, 0.05, 1.5, \"Stitch build-up when too fast\";\n    side_reach: 1.2, 0.3, 2.5, \"How far you can move aside (m)\";\n    obstacles: 18.0, 0.0, 40.0, \"Crabs, towels and sunbathers\";\n    ribbons: 14.0, 0.0, 40.0, \"Ribbons\";\n});\ngroup!(TideRules {\n    seconds: 60.0, 20.0, 120.0, \"Time for all three boards\";\n    gravity: 9.0, 1.0, 25.0, \"How strongly the tilt rolls shells\";\n    friction: 0.9, 0.1, 4.0, \"Shell friction\";\n    skip_speed: 3.4, 1.0, 8.0, \"Faster shells skip over pools\";\n    pool_radius: 0.72, 0.3, 1.5, \"Pool radius (m)\";\n    half: 3.8, 2.0, 6.0, \"Half size of the raft (m)\";\n});\ngroup!(PaddleRules {\n    par: 45.0, 20.0, 120.0, \"Par time (s)\";\n    cruise: 2.0, 0.5, 6.0, \"Speed with no forward lean (m/s)\";\n    sprint: 9.0, 3.0, 20.0, \"Speed at a full forward lean (m/s)\";\n    steer: 7.0, 1.0, 20.0, \"Sideways speed at a full lean (m/s)\";\n    gust: 7.0, 0.0, 30.0, \"Gust strength\";\n    gates: 16.0, 4.0, 30.0, \"Gates on the course\";\n    gate_width: 2.6, 1.0, 6.0, \"Half width of a gate (m)\";\n    remount: 2.0, 0.5, 6.0, \"Seconds to climb back on\";\n    wobble: 1.4, 0.0, 4.0, \"Wobble on the board\";\n});\ngroup!(TrayRules {\n    pace: 1.55, 0.5, 4.0, \"Walking pace (m/s)\";\n    slide: 2.2, 0.5, 8.0, \"How fast glasses slide with tilt\";\n    friction: 1.3, 0.1, 5.0, \"Glass friction\";\n    edge: 0.42, 0.2, 0.8, \"Tray radius (m)\";\n    jolt: 26.0, 0.0, 100.0, \"Size of the jolts\";\n    sway: 0.55, 0.0, 1.2, \"How much the pier rolls the tray\";\n    no_spill_bonus: 100.0, 0.0, 300.0, \"Bonus for no spills\";\n});\ngroup!(DiveRules {\n    period: 1.2, 0.6, 2.4, \"Board bounce period (s)\";\n    timing: 0.22, 0.05, 0.5, \"Timing window around the bottom (s)\";\n    height: 4.2, 1.0, 12.0, \"Leap height at full power (m)\";\n    bounce_gain: 0.8, 0.1, 2.0, \"Height per good bounce\";\n    spin: 7.0, 1.0, 20.0, \"Rotation speed at a full lean (rad/s)\";\n    wait: 10.0, 3.0, 30.0, \"Seconds before the board tips you off\";\n});\ngroup!(FinaleRules {\n    gust: 11.0, 0.0, 40.0, \"Gusts in the pose phase\";\n    waves: 16.0, 0.0, 60.0, \"Wave shoves in the brace phase\";\n    wobble: 1.3, 0.0, 4.0, \"Extra wobble\";\n    stillness: 30.0, 5.0, 60.0, \"Seconds of the Long Stillness\";\n    bonus: 150.0, 0.0, 400.0, \"Inner Peace bonus\";\n    tip_cost: 40.0, 0.0, 200.0, \"Score lost per tip\";\n});\n\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct Rules {\n    pub core: CoreRules,\n    pub breath: BreathRules,\n    pub pose: PoseRules,\n    pub squats: SquatRules,\n    pub plank: PlankRules,\n    pub step: StepRules,\n    pub spin: SpinRules,\n    pub lap: LapRules,\n    pub tide: TideRules,\n    pub paddle: PaddleRules,\n    pub tray: TrayRules,\n    pub dive: DiveRules,\n    pub finale: FinaleRules,\n}\n\nimpl Tunable for Rules {\n    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n        nested(v, \"core\", &mut self.core);\n        nested(v, \"breath\", &mut self.breath);\n        nested(v, \"pose\", &mut self.pose);\n        nested(v, \"squats\", &mut self.squats);\n        nested(v, \"plank\", &mut self.plank);\n        nested(v, \"step\", &mut self.step);\n        nested(v, \"spin\", &mut self.spin);\n        nested(v, \"lap\", &mut self.lap);\n        nested(v, \"tide\", &mut self.tide);\n        nested(v, \"paddle\", &mut self.paddle);\n        nested(v, \"tray\", &mut self.tray);\n        nested(v, \"dive\", &mut self.dive);\n        nested(v, \"finale\", &mut self.finale);\n    }\n}\n\n/// The groups' names, in Dev Mode's order.\npub const GROUPS: [&str; 13] =\n    [\"core\", \"breath\", \"pose\", \"squats\", \"plank\", \"step\", \"spin\", \"lap\", \"tide\", \"paddle\", \"tray\", \"dive\", \"finale\"];\nRS\ncat > $F/rules.toml <<'RS'\n# Every balance number in We Stand. Running from engine/, the game reads this file at each load,\n# so a change here needs no rebuild. Numbers left out use the defaults in rules.rs, where each has\n# its range and help text. Dev Mode's Tuning tab edits these live.\n\n[core]\nstiffness = 40.0\ndamping = 8.5\nreach = 0.92\ntip_time = 0.35\nwobble = 0.12\n\n[pose]\nseconds = 20.0\n\n[step]\nbpm = 96.0\n\n[paddle]\npar = 45.0\nRS\ncat > $F/charts.toml <<'RS'\n# Step Party's notes: one string per bar of 4/4, eight steps a bar. L left, R right, B both, . rest.\n# The song is 96 BPM, a bar is 2.5 s. Notes start after one bar of count-in.\nbars = [\n \"L...R...\", \"L...R...\", \"L...R...\", \"L...R...\",\n \"L.R.L...\", \"R.L.R...\", \"L...R...\", \"L.R.B...\",\n \"L.R.L.R.\", \"L...R...\", \"L.R.L.R.\", \"L...B...\",\n \"R.L.R.L.\", \"R...L...\", \"L.RLR...\", \"L.R.B...\",\n \"L.R.L.R.\", \"LR..LR..\", \"L.R.B.B.\", \"L.RL.RL.\",\n \"B...L.R.\", \"B...R.L.\", \"LRLR....\", \"B.B.B...\",\n]\nRS\npython3 - <<'PY'\nimport re\nbars=re.findall(r'\"([LRB.]{8})\"',open('/dev/stdin').read()) if False else None\nPY\ngrep -o '\"[LRB.]\\{8\\}\"' $F/charts.toml | tr -d '\".\\n' | wc -c","description":"Write the UI model, Balance Core, rules and step chart"}}}
