{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CghxGnNLYyYFdTPgrfRMK","type":"message","role":"assistant","content":[{"type":"text","text":"The match scene has several rough spots: placeholder values, a per-pitch batter reset that would replay at-bats wrongly, a decal call with the wrong signature, and dead code. A rewrite is cleaner than patching piece by piece, so I'll rewrite the file with those fixed."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":20129,"cache_read_input_tokens":240010,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":20129},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3c80e66f-5c94-452e-938f-9b08d33b83c6","uuid":"8fbf04ce-94b0-424f-b477-e5653a1f9d6e","timestamp":"2026-11-04T13:18:48.660Z","request_id":"req_011CghxGn3zD51du3RtTYc4f"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CghxGnNLYyYFdTPgrfRMK","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012PHxhVHDcJwTi3AmhqoGc8","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-060643__x4549c1/work/BatzookaBaseball-Baseball-claude-haiku-5-5-medium-20261104-060643/src/30-match.js","content":"// The match: the scene that plays innings. It owns the phases of a plate appearance (intro, ready, windup, meter, pitch,\n// inplay, after, final), the input of whoever controls each side, the two views (the Plate Cam for the duel, the field\n// for the play), the HUD and the commentary. The rules and physics are the pure modules (10 to 14); this scene asks them\n// what happens and shows it.\n//\n// Control: team 1 (the home team) is player 1; team 0 (the visitors) is player 2 when one has joined, else the CPU.\n// On defense the pitcher and the chaser are the fielding team's controller; at the plate, the batting team's.\nBZ.LINES = {\n  intro: ['Ladies and gentlemen, the game is about to begin. The corn is high and the beer is cold.'],\n  ball: ['Ball one. The crowd has something to say about that.', 'That one was outside. Way outside.'],\n  strike: ['Strike! The scoreboard is blinking at him.', 'Right down the middle! Hooray!'],\n  foul: ['Foul ball! Into the corn!', 'That one went foul, and somebody in row nine is wearing it.'],\n  k: ['Strike three! He is out, and he is going home to tell the dog.', 'Struck him out looking! The dugout is crying.'],\n  walk: ['Four balls. The pitcher has forgotten the way to the plate.'],\n  single: ['A single, and that one has a little spin on it!', 'Base hit! The fans are tossing their hats!'],\n  double: ['A double into the gap! Two bases and a cloud of dust!'],\n  triple: ['A triple! He is going like corn in a windstorm!'],\n  hr: ['WAY BACK! WAY BACK! That one is GONE!', 'Home run! The Batzooka has spoken!'],\n  caught: ['Caught on the warning track! Oh my, what a catch!', 'Hauled it in! That fly is an out, folks.'],\n  groundOut: ['Grounder to the infield, and the throw beats him. Out!', 'Nimble work in the infield. He is out.'],\n  forceOut: ['Out at second! The runner was a bit slow on the basepaths.'],\n  safe: ['Safe! By a whisker!', 'He beat the throw. Safe at first.'],\n  over: ['That is the ballgame! Thank you for coming out to Kernel Field!'],\n  walkoff: ['A walk-off! The home crowd goes wild! Bring the cows out!']\n};\n\n// A line of commentary in the announcer's box; the big calls are also babbled (the Animalese voice).\nBZ.say = (talk, key) => {\n  const pool = BZ.LINES[key];\n  if (!pool || !talk) return;\n  const line = BZ.pick(BZ.rng.fx, pool);\n  talk.say(line, { name: 'PA', auto: 2.8, modal: false });\n  if (['hr', 'k', 'over', 'walkoff'].includes(key)) BZ.babble(line, { pitch: 230, rate: .07, vol: .12 });\n};\n\n// The match's state for a run: the rules, the two teams' rigs and fielders, the phase and its clocks.\n// opts: { innings, human: [visitorsHuman, homeHuman], drill, attract, cpuLevel, seed }.\nBZ.newMatchRun = (opts = {}) => {\n  BZ.meter = [0, 0];\n  BZ.seedMatch(opts.seed || 20261104);\n  const S = BZ.newMatch({ innings: opts.innings || BZ.TUNE.innings });\n  return {\n    opts, S,\n    rigs: [BZ.makeRigs(BZ.TEAMS[0]), BZ.makeRigs(BZ.TEAMS[1])],\n    fielders: [BZ.makeFielders(), BZ.makeFielders()],\n    human: [!!(opts.human && opts.human[0]), !!(opts.human && opts.human[1])],\n    phase: 'intro', clock: 0, introT: 2.4, afterT: 0, finalT: 3.2,\n    needNewBatter: true, paPrevKey: BZ.halfKey(S), paEnded: false,\n    pitchChoice: 'fastball', aim: { lat: 0, h: 2.6 }, fireball: false, pending: null,\n    meterT: 0, meterP: .5, windupK: 0, cpuPlanT: 1,\n    plan: null, pt: 0, trail: [], pitchPos: null, swung: false, swing: null, swingK: 0, swingPhase: null,\n    cpuSwing: null, swingAt: 0, reticle: null, prevPointer: null,\n    play: null, ball: null, cam: 'plate', batterRunT: 0, basePx: [],\n    stamp: null, talk: null, events: [],\n    drill: opts.drill ? { kind: opts.drill.kind, goal: opts.drill.goal, got: 0 } : null\n  };\n};\n\n// Start a match: the scene switches to it, and it begins with the first half's intro.\nBZ.startMatch = (game, opts) => {\n  BZ.M = BZ.newMatchRun(opts);\n  game.go('match', opts);\n};\n\n// The input that controls a team: player 1 is the home team, player 2 (if joined) the visitors; otherwise the CPU.\nBZ.controllerInput = (game, team) => (team === 1 ? game.players[0] : game.players[1]) || null;\n\n// Hold the half's key: the same for the whole half-inning, so a change of half is seen.\nBZ.halfKey = S => S.inning + (S.top ? 't' : 'b');\n\n// Resolve a swing at the pitch's clock: contact, a foul or a whiff, and the reticle's place. A catch drill's contact is\n// a fly ball to center, to give the human fielder something to catch.\nBZ.resolveSwing = (M, swingPt, reticle, batzooka) => {\n  const plan = M.plan, plate = BZ.plateLoc(plan);\n  let c = BZ.contact({ swingT: swingPt - plan.time, reticle, plate, batzooka });\n  if (M.drill && M.drill.kind === 'catch' && c.type === 'hit') c = Object.assign(c, { exit: 330, launch: 40, spray: 0 });\n  M.swung = true;\n  M.swing = Object.assign({ at: swingPt, reticle, batzooka }, c);\n  M.swingPhase = 'swing'; M.swingK = 0;\n  M.events.push({ type: 'swing', result: c.type, batzooka, q: c.q });\n  return c;\n};\n\nBZ.matchScene = {\n  pausable: true, view: 'threequarter', input: 'custom', touch: false,\n  enter() {\n    const game = BZ.game, M = BZ.M;\n    BZ.field = BZ.field || BZ.buildField();\n    game.lights.enabled = BZ.park === 'moondome';\n    game.lights.ambient = .55;\n    M.talk = BZ.talkFor(game);\n    BZ.beginHalfIntro(M);\n    BZ.playSong('match');\n  },\n  exit() { BZ.game.lights.enabled = false; BZ.playSong(null); },\n  update(dt) { BZ.matchUpdate(BZ.game, BZ.M, dt); },\n  draw(r) { BZ.matchDraw(r, BZ.M); }\n};\n\nBZ.talkFor = game => BZ.talk || (BZ.talk = new E.Dialog(game));\n\n// The intro card for a half: TOP or BOTTOM of an inning, with the batting team named.\nBZ.beginHalfIntro = M => {\n  const S = M.S;\n  M.phase = 'intro'; M.clock = 0; M.introT = 2.2; M.cam = 'plate';\n  M.needNewBatter = true;\n  M.paPrevKey = BZ.halfKey(S);\n  M.stamp = { text: (S.top ? 'TOP ' : 'BOTTOM ') + BZ.ordinal(S.inning).toUpperCase(), color: '#ffe6a0', t: 2.2, sub: BZ.TEAMS[BZ.battingTeam(S)].name + ' at bat' };\n  M.swung = false; M.swing = null; M.plan = null; M.pending = null;\n};\n\n// Each frame. Inputs are read here, once; the phases change the state; the rigs and the camera follow.\nBZ.matchUpdate = (game, M, dt) => {\n  if (!M) return;\n  const S = M.S, bt = BZ.battingTeam(S), ft = BZ.fieldingTeam(S);\n  const pitcherIn = M.human[ft] ? BZ.controllerInput(game, ft) : null;\n  const batterIn = M.human[bt] ? BZ.controllerInput(game, bt) : null;\n  M.clock += dt;\n  if (M.stamp) { M.stamp.t -= dt; if (M.stamp.t <= 0 && M.phase !== 'intro' && M.phase !== 'after') M.stamp = null; }\n  BZ.tickSwing(M, dt);\n\n  switch (M.phase) {\n    case 'intro':\n      M.introT -= dt;\n      if (M.introT <= 0) { M.stamp = null; M.phase = 'ready'; M.clock = 0; M.cpuPlanT = .9 + BZ.rng.fx() * .4; }\n      break;\n    case 'ready':\n      if (M.needNewBatter) { BZ.beginPA(S); M.needNewBatter = false; M.paEnded = false; M.reticle = null; }\n      M.cam = 'plate';\n      if (!M.human[ft] || M.opts.attract) {\n        if (M.clock >= M.cpuPlanT) { M.plan = BZ.botPitch(S); M.phase = 'windup'; M.clock = 0; }\n      } else if (pitcherIn) BZ.humanPitchReady(game, M, pitcherIn, dt);\n      break;\n    case 'windup':\n      M.windupK = Math.min(1, M.clock / .55);\n      if (M.clock >= .55) {\n        if (M.human[ft] && !M.opts.attract) { M.phase = 'meter'; M.meterT = 0; }\n        else BZ.release(M, .5);\n      }\n      break;\n    case 'meter':\n      M.meterT += dt;\n      M.meterP = .5 + .5 * Math.sin(M.meterT * Math.PI * 2 / 1.15 - Math.PI / 2);\n      if ((pitcherIn && pitcherIn.pressed('confirm')) || M.meterT > 2.4) BZ.release(M, M.meterP);\n      break;\n    case 'pitch':\n      BZ.pitchUpdate(game, M, dt, batterIn);\n      break;\n    case 'inplay':\n      BZ.playUpdate(game, M, dt, pitcherIn);\n      break;\n    case 'after':\n      M.afterT -= dt;\n      if (M.afterT <= 0) BZ.nextAfter(game, M);\n      break;\n    case 'final':\n      M.finalT -= dt;\n      if (M.finalT <= 0) BZ.endMatch(game, M);\n      break;\n  }\n  BZ.rigsUpdate(M, dt);\n  BZ.focusCam(game, M);\n  M.batterRunT = M.ball ? Math.min(1, M.batterRunT + dt / Math.max(.1, BZ.runTime())) : 0;\n};\n\n// The human pitcher's setup: the pitch (chips, Q/E, a click), the aim (stick, or the mouse), the Fireball, and a press to\n// wind up. Clicking the pitch's chip picks it; a click anywhere else on the screen winds up.\nBZ.humanPitchReady = (game, M, I, dt) => {\n  const S = M.S, plist = BZ.PITCH_IDS, idx = plist.indexOf(M.pitchChoice);\n  if (I.pressed('prevPitch')) M.pitchChoice = plist[(idx + plist.length - 1) % plist.length];\n  if (I.pressed('nextPitch')) M.pitchChoice = plist[(idx + 1) % plist.length];\n  const click = game.input.clicked();\n  const onChip = click ? BZ.chipAt(click[0], click[1]) : null;\n  const hover = BZ.chipAt(...(game.input.pointer() || [-1, -1]));\n  if (onChip) M.pitchChoice = onChip;\n  else if (hover) M.pitchChoice = hover;\n  // the aim: the stick moves it; a mouse that moves puts it on the pointer\n  const pt = game.input.pointer(), mv = I.move();\n  if (pt && M.prevPointer && Math.abs(pt[0] - M.prevPointer[0]) + Math.abs(pt[1] - M.prevPointer[1]) > 2) {\n    const p = BZ.plateFromScreen(pt[0], pt[1], game.W, game.H);\n    M.aim = BZ.clampAim(p.lat, p.h);\n  } else if (mv[0] || mv[1]) {\n    M.aim = BZ.clampAim(M.aim.lat + mv[0] * 1.8 * dt, M.aim.h - mv[1] * 1.8 * dt);\n  }\n  M.prevPointer = pt ? pt.slice() : null;\n  if (I.pressed('power') && BZ.meter[BZ.fieldingTeam(S)] >= 100) M.fireball = !M.fireball;\n  if (I.pressed('confirm') || (click && !onChip)) {\n    M.pending = { pitch: M.pitchChoice, aimLat: M.aim.lat, aimH: M.aim.h, superPitch: M.fireball };\n    if (M.fireball) { BZ.meter[BZ.fieldingTeam(S)] = 0; M.fireball = false; }\n    M.phase = 'windup'; M.clock = 0; M.prevPointer = null;\n  }\n};\n\n// Pitch selection chips at the bottom-left of the screen: their rectangles for hover and click.\nBZ.chipRects = game => BZ.PITCH_IDS.map((id, i) => ({ id, x0: 16 + i * 94, y0: game.H - 58, x1: 102 + i * 94, y1: game.H - 16 }));\nBZ.chipAt = (x, y) => {\n  const g = BZ.game;\n  if (!g || x < 0) return null;\n  for (const c of BZ.chipRects(g)) if (x >= c.x0 && x <= c.x1 && y >= c.y0 && y <= c.y1) return c.id;\n  return null;\n};\n\n// The release: the pitch the pitcher chose, with the meter's place, goes. A CPU's plan is ready already.\nBZ.release = (M, p) => {\n  const S = M.S;\n  let plan = M.plan;\n  if (M.pending) {\n    plan = BZ.planPitch({ pitch: M.pending.pitch, aimLat: M.pending.aimLat, aimH: M.pending.aimH, release: p, superPitch: M.pending.superPitch });\n    M.pending = null;\n  }\n  M.plan = plan;\n  M.pt = 0; M.phase = 'pitch'; M.clock = 0; M.trail = []; M.pitchPos = null;\n  M.swung = false; M.swing = null; M.cpuSwing = null; M.swingAt = 0;\n  // the batter: the CPU decides its swing now, unless a player is at the plate\n  const bt = BZ.battingTeam(S);\n  if (!M.human[bt] || M.opts.attract) {\n    const sw = BZ.cpuSwing(S, plan, BZ.rng.play, M.opts.cpuLevel || BZ.TUNE.cpuLevel);\n    if (sw) { M.cpuSwing = sw; M.swingAt = plan.time + sw.swingT; }\n    if (M.drill && M.drill.kind === 'catch') { M.cpuSwing = { swingT: 0, reticle: BZ.plateLoc(plan) }; M.swingAt = plan.time; }\n  }\n  M.events.push({ type: 'pitch', pitch: plan.pitch, time: plan.time, miss: plan.miss, super: plan.super });\n};\n\n// The pitch in flight: the batter's swing (a player's press or the CPU's timed one), and the umpire's call on arrival.\nBZ.pitchUpdate = (game, M, dt, batterIn) => {\n  const plan = M.plan, S = M.S, bt = BZ.battingTeam(S);\n  M.pt += dt;\n  const pos = BZ.pitchAt(plan, Math.min(1, M.pt / plan.time));\n  M.pitchPos = pos;\n  M.trail.push({ lat: pos.lat, h: pos.h, depth: pos.depth });\n  if (M.trail.length > 9) M.trail.shift();\n  const clickAt = game.input.clicked();\n  if (!M.swung && batterIn && !M.opts.attract) {\n    const ret = BZ.batterAim(game, M, batterIn, dt);\n    if (batterIn.pressed('confirm') || (clickAt && !BZ.chipAt(clickAt[0], clickAt[1]))) {\n      const bz = !!(batterIn.pressed('power') && BZ.meter[bt] >= 100);\n      if (bz) BZ.meter[bt] = 0;\n      BZ.afterSwing(game, M, BZ.resolveSwing(M, M.pt, ret, bz));\n    }\n  } else if (!M.swung && M.cpuSwing && M.pt >= M.swingAt) {\n    const bz = !!(M.opts.attract && BZ.meter[bt] >= 100);\n    if (bz) BZ.meter[bt] = 0;\n    BZ.afterSwing(game, M, BZ.resolveSwing(M, M.pt, M.cpuSwing.reticle, bz));\n  }\n  if (M.phase !== 'pitch') return;\n  if (M.pt >= plan.time + .3) {\n    if (!M.swung) {\n      const at = BZ.plateLoc(plan);\n      BZ.countEvent(game, M, BZ.inZone(at.lat, at.h) ? 'strike' : 'ball', false);\n    }\n    BZ.afterPitch(game, M);\n  }\n};\n\n// A player's reticle: the stick moves it, the mouse puts it on the pointer; the default is the middle of the plate.\nBZ.batterAim = (game, M, I, dt) => {\n  const pt = game.input.pointer(), mv = I.move();\n  M.reticle = M.reticle || { lat: 0, h: 2.6 };\n  if (pt && M.prevPointer && Math.abs(pt[0] - M.prevPointer[0]) + Math.abs(pt[1] - M.prevPointer[1]) > 2) {\n    const p = BZ.plateFromScreen(pt[0], pt[1], game.W, game.H);\n    M.reticle = { lat: BZ.clamp(p.lat, -1.6, 1.6), h: BZ.clamp(p.h, .6, 4.6) };\n  } else if (mv[0] || mv[1]) {\n    M.reticle = { lat: BZ.clamp(M.reticle.lat + mv[0] * 1.6 * dt, -1.6, 1.6), h: BZ.clamp(M.reticle.h - mv[1] * 1.6 * dt, .6, 4.6) };\n  }\n  M.prevPointer = pt ? pt.slice() : null;\n  return M.reticle;\n};\n\n// The swing's animation timer (the rig's swing and the bat), 0.32 s.\nBZ.tickSwing = (M, dt) => {\n  if (M.swingPhase === 'swing') {\n    M.swingK = Math.min(1, M.swingK + dt / .32);\n    if (M.swingK >= 1) M.swingPhase = null;\n  }\n};\n\n// After a swing: contact sends the ball into play; a foul or a whiff is counted here.\nBZ.afterSwing = (game, M, c) => {\n  const S = M.S, ft = BZ.fieldingTeam(S);\n  M.swing = Object.assign(M.swing, c);\n  if (c.type === 'hit') {\n    M.ball = BZ.launchBall({ exit: c.exit, launch: c.launch, spray: c.spray, batzooka: c.batzooka });\n    M.play = new BZ.Play(S, M.ball, M.fielders[ft]);\n    for (const f of M.fielders[ft]) f.human = !!M.human[ft] && !M.opts.attract;\n    M.phase = 'inplay'; M.cam = 'field'; M.clock = 0; M.batterRunT = 0;\n    BZ.sfx(c.batzooka ? 'rocket' : 'crack', { vol: c.batzooka ? .6 : 1 });\n    if (c.batzooka) BZ.sfx('fire', { vol: .4 });\n    return;\n  }\n  if (c.type === 'foul') { BZ.countEvent(game, M, 'foul', false); BZ.afterPitch(game, M); return; }\n  BZ.countEvent(game, M, 'strike', true);   // a whiff: a swinging strike\n  BZ.afterPitch(game, M);\n};\n\n// The count moves for a called or swung-at pitch. A walk, a strikeout or the half's end finishes the plate appearance.\n// kind: 'ball' | 'strike' (called or swung at) | 'foul'. Returns the rules' event.\nBZ.countEvent = (game, M, kind, swung) => {\n  const S = M.S, ft = BZ.fieldingTeam(S);\n  const ev = BZ.pitchCount(S, kind === 'ball' ? 'ball' : kind === 'strike' ? 'strike' : 'foul');\n  const count = BZ.countText(S);\n  M.events.push({ type: 'call', kind, ev: ev.ev, count });\n  if (kind === 'ball') { BZ.sfx('ball'); M.stamp = { text: 'BALL', color: '#7ad0ff', t: 1, sub: count }; if (BZ.rng.fx() < .3) BZ.say(M.talk, 'ball'); }\n  if (kind === 'strike') { BZ.sfx('strike'); M.stamp = { text: swung ? 'SWINGING STRIKE' : 'STRIKE', color: '#ffb020', t: 1, sub: count }; if (!swung && BZ.rng.fx() < .5) BZ.say(M.talk, 'strike'); }\n  if (kind === 'foul') { BZ.sfx('foul'); M.stamp = { text: 'FOUL', color: '#ffb020', t: 1, sub: count }; if (BZ.rng.fx() < .3) BZ.say(M.talk, 'foul'); }\n  if (kind === 'strike' && M.drill && M.drill.kind === 'strikes') M.drill.got = Math.min(M.drill.goal, M.drill.got + 1);\n  if (ev.ev === 'k') {\n    BZ.sfx('out'); BZ.say(M.talk, 'k');\n    M.stamp = { text: 'STRIKE THREE', color: '#ff6a5a', t: 1.8, sub: 'OUT' };\n    BZ.meter[ft] = Math.min(100, BZ.meter[ft] + 20);\n  }\n  if (ev.ev === 'walk') { BZ.sfx('confirm'); BZ.say(M.talk, 'walk'); M.stamp = { text: 'BALL FOUR', color: '#7ad0ff', t: 1.8, sub: 'WALK' }; }\n  if (ev.ev === 'k' || ev.ev === 'walk' || ev.end || ev.ev === 'gameOver') M.paEnded = true;\n  if (M.paEnded) M.needNewBatter = true;\n  return ev;\n};\n\n// The pitch is over: a pause for the call, then the next pitch, the next batter or the change of half.\nBZ.afterPitch = (game, M) => {\n  M.phase = 'after'; M.clock = 0;\n  M.afterT = M.paEnded ? 2 : 1.1;\n};\n\n// The batted ball: the defense plays it, the rules decide the play, and a result stamp says what happened.\nBZ.playUpdate = (game, M, dt, pitcherIn) => {\n  const human = { move: pitcherIn ? pitcherIn.move() : [0, 0], dive: !!(pitcherIn && pitcherIn.pressed('confirm')) };\n  if (M.play.phase === 'fielded' && pitcherIn) {\n    if (pitcherIn.pressed('up')) human.pick = 'second';\n    else if (pitcherIn.pressed('left')) human.pick = 'third';\n    else if (pitcherIn.pressed('right')) human.pick = 'first';\n    const click = game.input.clicked();\n    if (click) {\n      const b = M.basePx.findIndex(p => p && Math.hypot(p[0] - click[0], p[1] - click[1]) < 32);\n      if (b >= 0) human.pick = ['first', 'second', 'third', null][b];\n    }\n  }\n  M.play.step(dt, human);\n  for (const e of M.play.events.splice(0)) {\n    M.events.push({ type: 'play:' + e.type, who: e.fielder || e.target });\n    if (e.type === 'caught') BZ.sfx('catch');\n    if (e.type === 'fielded') BZ.sfx('thud');\n    if (e.type === 'throw') BZ.sfx('throw');\n  }\n  if (M.play.phase === 'over') BZ.playResolved(game, M);\n};\n\n// The play is over. The stamp says it, the batter's meter fills, the drill counts it, and the count moves on.\nBZ.playResolved = (game, M) => {\n  const S = M.S, bt = BZ.battingTeam(S), res = M.play.result;\n  const ball = M.ball;\n  let text = 'OUT', color = '#ff6a5a', sub = '', key = null;\n  if (res.kind === 'foul') {\n    BZ.countEvent(game, M, 'foul', false);\n    M.play = null; M.ball = null;\n    BZ.afterPitch(game, M);\n    return;\n  }\n  if (res.kind === 'caught') {\n    text = 'CAUGHT'; sub = res.deep ? 'deep fly: the runner tags up' : 'fly out'; key = 'caught';\n    BZ.sfx('out');\n    if (M.drill && M.drill.kind === 'catch') M.drill.got = Math.min(M.drill.goal, M.drill.got + 1);\n  } else if (res.kind === 'hit') {\n    const T = { single: ['SINGLE', '#ffe6a0'], double: ['DOUBLE', '#ffe6a0'], triple: ['TRIPLE', '#ffb020'], hr: ['HOME RUN', '#ffb020'] }[res.type];\n    text = T[0]; color = T[1]; key = res.type;\n    BZ.meter[bt] = Math.min(100, BZ.meter[bt] + ({ single: .5, double: 1, triple: 1.3, hr: 2 }[res.type]) * BZ.TUNE.meterGain);\n    if (res.type === 'hr' && ball) sub = Math.round(ball.homer ? ball.crossDist : ball.landDist) + ' FT' + (ball.batzooka ? ' · BATZOOKA' : '');\n    if (res.type === 'hr') { BZ.sfx('fanfare'); BZ.sfx('cheer'); if (ball) game.particles.explosion(ball.x, ball.y, 4, 1.2); }\n    else BZ.sfx('cheer', { vol: .5 });\n    if (M.drill && M.drill.kind === 'hit' && res.type !== undefined) M.drill.got = Math.min(M.drill.goal, M.drill.got + 1);\n    if (M.drill && M.drill.kind === 'homer' && res.type === 'hr' && ball && ball.batzooka) M.drill.got = Math.min(M.drill.goal, M.drill.got + 1);\n  } else if (res.kind === 'ground') {\n    if (res.batterOut) { text = 'OUT AT FIRST'; key = 'groundOut'; BZ.sfx('out'); }\n    else if (res.runnerOut) { text = 'FORCE OUT'; key = 'forceOut'; BZ.sfx('out'); }\n    else { text = 'SAFE'; color = '#7ad06a'; key = 'safe'; BZ.sfx('confirm'); }\n    if (res.r && res.r.runs) sub = res.r.runs + (res.r.runs > 1 ? ' RUNS SCORE' : ' RUN SCORES');\n  }\n  if (key) BZ.say(M.talk, key);\n  M.stamp = { text, color, t: 2, sub };\n  M.events.push({ type: 'result', kind: res.kind, text, S_outs: S.outs });\n  M.play = null; M.ball = null; M.swing = null;\n  M.paEnded = true; M.needNewBatter = true;\n  M.phase = 'after'; M.clock = 0; M.afterT = 2.1;\n};\n\n// The next thing after a count or a play: the final, the change of half, or the next pitch (the same batter, or the next).\nBZ.nextAfter = (game, M) => {\n  const S = M.S;\n  M.stamp = null;\n  if (S.over) {\n    M.phase = 'final'; M.finalT = 3.4; M.clock = 0; M.cam = 'plate';\n    BZ.playSong('results');\n    BZ.say(M.talk, S.walkoff ? 'walkoff' : 'over');\n    return;\n  }\n  if (BZ.halfKey(S) !== M.paPrevKey) { BZ.beginHalfIntro(M); return; }\n  M.paEnded = false;\n  M.phase = 'ready'; M.clock = 0; M.cpuPlanT = .9 + BZ.rng.fx() * .4; M.fireball = false;\n  M.cam = 'plate'; M.swung = false; M.swing = null; M.trail = []; M.plan = null; M.pitchPos = null;\n};\n\n// The match is over: its state goes to the results screen.\nBZ.endMatch = (game, M) => {\n  BZ.M = M;\n  BZ.playSong(null);\n  game.go('results', { S: M.S, drill: M.drill, opts: M.opts });\n};\n\n// The rigs' poses from the state: the wind-up and release, the swing, the stance, the runners on the bases, the fielders.\nBZ.rigsUpdate = (M, dt) => {\n  const S = M.S, bt = BZ.battingTeam(S), ft = BZ.fieldingTeam(S);\n  for (const t of [0, 1]) {\n    const R = M.rigs[t];\n    for (const f of M.fielders[t]) {\n      const st = { x: f.x, y: f.y, z: 0, facing: f.face || 0, vx: f.vx || 0, vy: f.vy || 0 };\n      if (t === ft && f.role === 'P') {\n        if (M.phase === 'windup' || M.phase === 'meter') st.attack = E.move('overhead', M.phase === 'windup' ? M.windupK : .5);\n        else if (M.phase === 'pitch') st.attack = E.move('overhead', 1, 'recover');\n      }\n      if (f.role === 'C') st.pose = 'crouch';\n      R.fielders[f.role].update(dt, st);\n    }\n    const bstate = { x: 0, y: 0, z: 0, facing: Math.PI / 2 };\n    if (t === bt && M.swingPhase === 'swing') bstate.attack = E.move('slash', M.swingK);\n    else bstate.stance = 'ready';\n    R.batter.update(dt, bstate);\n    R.runners.forEach((rr, i) => rr.update(dt, { x: 0, y: 0, z: 0, facing: 0, stance: 'ready' }));\n  }\n};\n\n// The camera: the Plate Cam has none; the field follows the ball, or the plate while nothing is in play.\nBZ.focusCam = (game, M) => {\n  if (M.cam !== 'field') return;\n  const b = M.ball;\n  if (b) game.focus(b.x, b.y - 90, b.z * .4);\n  else game.focus(BZ.HX, BZ.HY - 260, 0);\n};\n\n// The draw: the Plate Cam for the duel, the field for the play; then the HUD over both.\nBZ.matchDraw = (r, M) => {\n  if (!M) return;\n  const W = r.W, H = r.H, S = M.S, park = BZ.PARKS[BZ.park];\n  if (M.cam === 'field') BZ.drawField(r, M);\n  else {\n    r.sky(park.night ? ['#060818', '#2a2a5a'] : park.sky);\n    const ft = BZ.fieldingTeam(S), bt = BZ.battingTeam(S);\n    r.overlay(g => {\n      BZ.drawPlateGround(g, W, H, park);\n      BZ.drawZone(g, W, H);\n      BZ.drawPlatePlayers(g, W, H, { view: r.view, pitcher: M.rigs[ft].fielders.P, catcher: M.rigs[ft].fielders.C, batter: M.rigs[bt].batter });\n      if (M.plan && M.phase === 'pitch' && M.pitchPos) BZ.drawPitchBall(g, W, H, M.plan, Math.min(1, M.pt / M.plan.time), M.trail);\n      if (M.phase === 'ready' || M.phase === 'windup' || M.phase === 'meter') BZ.drawAimReticle(g, W, H, M);\n      if (M.phase === 'pitch' && !M.swung && M.human[bt]) BZ.drawBatterReticle(g, W, H, M);\n      if (M.swing && M.swing.type && M.swingPhase) BZ.drawBat(g, W, H, { swing: M.swingK, reticle: M.swing.reticle });\n    });\n  }\n  r.overlay(g => BZ.drawHud(g, r, M));\n  if (M.talk) M.talk.draw(r);\n};\n\n// The field view: the TileMap, the fielders, the runners, the batter's run and the ball, with the bases clickable.\nBZ.drawField = (r, M) => {\n  const S = M.S, ft = BZ.fieldingTeam(S), bt = BZ.battingTeam(S);\n  BZ.field.drawFloor(r);\n  BZ.field.queueWalls(r);\n  for (const f of M.fielders[ft]) {\n    const rig = M.rigs[ft].fielders[f.role];\n    r.shadow(f.x, f.y, 6, .3, undefined, 0);\n    r.actor(f.x, f.y, 0, (g, ox, oy) => rig.draw(g, ox, oy, r.view));\n  }\n  const bases = BZ.bases();\n  bases.forEach((b, i) => { M.basePx[i] = r.w(b.x, b.y, 0); });\n  bases.slice(0, 3).forEach((b, i) => {\n    if (S.bases[i]) { const rr = M.rigs[bt].runners[i]; r.actor(b.x, b.y, 0, (g, ox, oy) => rr.draw(g, ox, oy, r.view)); }\n  });\n  if (M.ball && M.batterRunT > 0 && M.batterRunT < 1) {\n    const p = bases[0], x = BZ.lerp(BZ.HX, p.x, M.batterRunT), y = BZ.lerp(BZ.HY - 10, p.y, M.batterRunT);\n    r.actor(x, y, 0, (g, ox, oy) => M.rigs[bt].batter.draw(g, ox, oy, r.view));\n  }\n  if (M.ball) {\n    const b = M.ball;\n    r.shadow(b.x, b.y, 4, .45, undefined, 0);\n    r.sprite(b.x, b.y, b.z + 4, BZ.BALL_SPR, { glow: .3 });\n  }\n};\n\n// The ball's sprite: a white ball with a red seam, drawn once.\nBZ.BALL_SPR = E.sprite(['.www.', 'wwrww', 'wrwrw', 'wwrww', '.www.'], { w: '#f8f8f0', r: '#c83a3a' }, 2);\n\n// The HUD for the match: the scorebug, the pitch chips, the meters, the release meter, the stamp and the prompt.\nBZ.drawHud = (g, r, M) => {\n  const S = M.S, W = r.W, H = r.H;\n  BZ.drawScorebug(g, S, 16, 16);\n  const bt = BZ.battingTeam(S), ft = BZ.fieldingTeam(S);\n  if (M.phase === 'ready' && M.human[ft]) BZ.drawChips(g, M);\n  if (M.human[bt]) BZ.drawBatzookaMeter(g, W - 178, H - 40, 150, BZ.meter[bt], 'BATZOOKA', BZ.meter[bt] >= 100);\n  if (M.human[ft]) BZ.drawBatzookaMeter(g, W - 178, H - 74, 150, BZ.meter[ft], 'FIREBALL', BZ.meter[ft] >= 100 || M.fireball);\n  if (M.phase === 'meter') {\n    BZ.drawMeter(g, W / 2 - 90, H * .72, 180, M.meterP);\n    BZ.text(g, BZ.prompt('confirm', 'RELEASE'), W / 2, H * .72 - 26, '#ffffff', { align: 'center', scale: 1.6 });\n  }\n  if (M.stamp) BZ.drawStamp(g, W, H, M.stamp, M.stamp.color, M.stamp.sub);\n  if (M.drill) BZ.text(g, BZ.drillText(M), W / 2, 14, '#ffe6a0', { align: 'center', scale: 1.4 });\n  BZ.drawPrompt(g, W, H, M);\n};\n\nBZ.drillText = M => {\n  const names = { strikes: 'THROW STRIKES', hit: 'PUT ONE IN PLAY', catch: 'CATCH A FLY', homer: 'HIT A HOMER WITH THE BATZOOKA' };\n  return names[M.drill.kind] + '   ' + M.drill.got + '/' + M.drill.goal;\n};\n\n// The pitch chips: the one picked is lit. Hover moves to it; a click picks it.\nBZ.drawChips = (g, M) => {\n  for (const c of BZ.chipRects(BZ.game)) {\n    const on = c.id === M.pitchChoice, P = BZ.PITCHES[c.id];\n    E.ui.box(g, c.x0, c.y0, c.x1 - c.x0, c.y1 - c.y0, { bg: on ? ['#ffe6a0', '#c8a060'] : ['#1a1d2a', '#0b0d16'], border: on ? '#ffffff' : '#c8a060', alpha: .92 });\n    BZ.text(g, P.name, c.x0 + 6, c.y0 + 6, on ? '#1a1020' : '#ffffff', { scale: 1.1, shadow: null });\n    BZ.text(g, P.tag + (c.id === 'fastball' ? '' : ''), c.x0 + 6, c.y0 + 22, on ? '#1a1020' : '#c8d0f0', { scale: 1, shadow: null });\n  }\n};\n\n// The prompt line at the bottom: what this player does now, with the label for their device.\nBZ.drawPrompt = (g, W, H, M) => {\n  const S = M.S, bt = BZ.battingTeam(S), ft = BZ.fieldingTeam(S);\n  let line = '';\n  if (M.phase === 'ready' && M.human[ft]) line = BZ.prompt('confirm', 'WIND UP') + '   ' + BZ.keys('prevPitch', 'nextPitch') + ' PITCH   STICK AIMS   ' + BZ.prompt('power', 'FIREBALL WHEN FULL');\n  else if (M.phase === 'pitch' && M.human[bt] && !M.swung) line = BZ.prompt('confirm', 'SWING') + '   STICK AIMS THE BAT   ' + BZ.prompt('power', 'BATZOOKA WHEN FULL');\n  else if (M.phase === 'inplay' && M.human[ft]) line = BZ.prompt('confirm', 'DIVE') + '   STICK RUNS   ' + (M.play && M.play.phase === 'fielded' ? 'UP 2ND   LEFT 3RD   RIGHT 1ST' : '');\n  if (line) {\n    const w = line.length * 6.4 + 28;\n    E.ui.box(g, W / 2 - w / 2, H - 26, w, 20, { bg: ['#101420', '#060810'], border: '#c8a060', alpha: .85 });\n    BZ.text(g, line, W / 2, H - 20, '#ffffff', { align: 'center', scale: 1.2, shadow: null });\n  }\n};\n\n// Two keys' labels as one: \"Q/E\".\nBZ.keys = (a, b) => (BZ.game.input.label(a) || '') + '/' + (BZ.game.input.label(b) || '');\n\n// The aim: the pitcher's target on the plate's plane.\nBZ.drawAimReticle = (g, W, H, M) => {\n  const p = BZ.project(M.aim.lat, M.aim.h, 0, W, H);\n  E.px.disc(g, p.x, p.y, Math.max(3, 2 * p.s), '#ffffff55');\n  E.px.disc(g, p.x, p.y, 2, '#ffe6a0');\n};\n\n// The batter's reticle: the bat's head, sized by the bat's reach.\nBZ.drawBatterReticle = (g, W, H, M) => {\n  const ret = M.reticle || { lat: 0, h: 2.6 };\n  const p = BZ.project(ret.lat, ret.h, 0, W, H);\n  E.px.disc(g, p.x, p.y, Math.max(3, BZ.TUNE.reach * p.s), '#ffe6a040');\n  E.px.disc(g, p.x, p.y, 2, '#ffe6a0');\n};\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":20129,"cache_read_input_tokens":240010,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":20129},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3c80e66f-5c94-452e-938f-9b08d33b83c6","uuid":"d1629d23-288c-4bc2-87dc-e43b58d3815b","timestamp":"2026-11-04T13:19:34.282Z","request_id":"req_011CghxGn3zD51du3RtTYc4f","wire_tool_inputs":{"toolu_012PHxhVHDcJwTi3AmhqoGc8":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-060643__x4549c1/work/BatzookaBaseball-Baseball-claude-haiku-5-5-medium-20261104-060643/src/30-match.js","content":"// The match: the scene that plays innings. It owns the phases of a plate appearance (intro, ready, windup, meter, pitch,\n// inplay, after, final), the input of whoever controls each side, the two views (the Plate Cam for the duel, the field\n// for the play), the HUD and the commentary. The rules and physics are the pure modules (10 to 14); this scene asks them\n// what happens and shows it.\n//\n// Control: team 1 (the home team) is player 1; team 0 (the visitors) is player 2 when one has joined, else the CPU.\n// On defense the pitcher and the chaser are the fielding team's controller; at the plate, the batting team's.\nBZ.LINES = {\n  intro: ['Ladies and gentlemen, the game is about to begin. The corn is high and the beer is cold.'],\n  ball: ['Ball one. The crowd has something to say about that.', 'That one was outside. Way outside.'],\n  strike: ['Strike! The scoreboard is blinking at him.', 'Right down the middle! Hooray!'],\n  foul: ['Foul ball! Into the corn!', 'That one went foul, and somebody in row nine is wearing it.'],\n  k: ['Strike three! He is out, and he is going home to tell the dog.', 'Struck him out looking! The dugout is crying.'],\n  walk: ['Four balls. The pitcher has forgotten the way to the plate.'],\n  single: ['A single, and that one has a little spin on it!', 'Base hit! The fans are tossing their hats!'],\n  double: ['A double into the gap! Two bases and a cloud of dust!'],\n  triple: ['A triple! He is going like corn in a windstorm!'],\n  hr: ['WAY BACK! WAY BACK! That one is GONE!', 'Home run! The Batzooka has spoken!'],\n  caught: ['Caught on the warning track! Oh my, what a catch!', 'Hauled it in! That fly is an out, folks.'],\n  groundOut: ['Grounder to the infield, and the throw beats him. Out!', 'Nimble work in the infield. He is out.'],\n  forceOut: ['Out at second! The runner was a bit slow on the basepaths.'],\n  safe: ['Safe! By a whisker!', 'He beat the throw. Safe at first.'],\n  over: ['That is the ballgame! Thank you for coming out to Kernel Field!'],\n  walkoff: ['A walk-off! The home crowd goes wild! Bring the cows out!']\n};\n\n// A line of commentary in the announcer's box; the big calls are also babbled (the Animalese voice).\nBZ.say = (talk, key) => {\n  const pool = BZ.LINES[key];\n  if (!pool || !talk) return;\n  const line = BZ.pick(BZ.rng.fx, pool);\n  talk.say(line, { name: 'PA', auto: 2.8, modal: false });\n  if (['hr', 'k', 'over', 'walkoff'].includes(key)) BZ.babble(line, { pitch: 230, rate: .07, vol: .12 });\n};\n\n// The match's state for a run: the rules, the two teams' rigs and fielders, the phase and its clocks.\n// opts: { innings, human: [visitorsHuman, homeHuman], drill, attract, cpuLevel, seed }.\nBZ.newMatchRun = (opts = {}) => {\n  BZ.meter = [0, 0];\n  BZ.seedMatch(opts.seed || 20261104);\n  const S = BZ.newMatch({ innings: opts.innings || BZ.TUNE.innings });\n  return {\n    opts, S,\n    rigs: [BZ.makeRigs(BZ.TEAMS[0]), BZ.makeRigs(BZ.TEAMS[1])],\n    fielders: [BZ.makeFielders(), BZ.makeFielders()],\n    human: [!!(opts.human && opts.human[0]), !!(opts.human && opts.human[1])],\n    phase: 'intro', clock: 0, introT: 2.4, afterT: 0, finalT: 3.2,\n    needNewBatter: true, paPrevKey: BZ.halfKey(S), paEnded: false,\n    pitchChoice: 'fastball', aim: { lat: 0, h: 2.6 }, fireball: false, pending: null,\n    meterT: 0, meterP: .5, windupK: 0, cpuPlanT: 1,\n    plan: null, pt: 0, trail: [], pitchPos: null, swung: false, swing: null, swingK: 0, swingPhase: null,\n    cpuSwing: null, swingAt: 0, reticle: null, prevPointer: null,\n    play: null, ball: null, cam: 'plate', batterRunT: 0, basePx: [],\n    stamp: null, talk: null, events: [],\n    drill: opts.drill ? { kind: opts.drill.kind, goal: opts.drill.goal, got: 0 } : null\n  };\n};\n\n// Start a match: the scene switches to it, and it begins with the first half's intro.\nBZ.startMatch = (game, opts) => {\n  BZ.M = BZ.newMatchRun(opts);\n  game.go('match', opts);\n};\n\n// The input that controls a team: player 1 is the home team, player 2 (if joined) the visitors; otherwise the CPU.\nBZ.controllerInput = (game, team) => (team === 1 ? game.players[0] : game.players[1]) || null;\n\n// Hold the half's key: the same for the whole half-inning, so a change of half is seen.\nBZ.halfKey = S => S.inning + (S.top ? 't' : 'b');\n\n// Resolve a swing at the pitch's clock: contact, a foul or a whiff, and the reticle's place. A catch drill's contact is\n// a fly ball to center, to give the human fielder something to catch.\nBZ.resolveSwing = (M, swingPt, reticle, batzooka) => {\n  const plan = M.plan, plate = BZ.plateLoc(plan);\n  let c = BZ.contact({ swingT: swingPt - plan.time, reticle, plate, batzooka });\n  if (M.drill && M.drill.kind === 'catch' && c.type === 'hit') c = Object.assign(c, { exit: 330, launch: 40, spray: 0 });\n  M.swung = true;\n  M.swing = Object.assign({ at: swingPt, reticle, batzooka }, c);\n  M.swingPhase = 'swing'; M.swingK = 0;\n  M.events.push({ type: 'swing', result: c.type, batzooka, q: c.q });\n  return c;\n};\n\nBZ.matchScene = {\n  pausable: true, view: 'threequarter', input: 'custom', touch: false,\n  enter() {\n    const game = BZ.game, M = BZ.M;\n    BZ.field = BZ.field || BZ.buildField();\n    game.lights.enabled = BZ.park === 'moondome';\n    game.lights.ambient = .55;\n    M.talk = BZ.talkFor(game);\n    BZ.beginHalfIntro(M);\n    BZ.playSong('match');\n  },\n  exit() { BZ.game.lights.enabled = false; BZ.playSong(null); },\n  update(dt) { BZ.matchUpdate(BZ.game, BZ.M, dt); },\n  draw(r) { BZ.matchDraw(r, BZ.M); }\n};\n\nBZ.talkFor = game => BZ.talk || (BZ.talk = new E.Dialog(game));\n\n// The intro card for a half: TOP or BOTTOM of an inning, with the batting team named.\nBZ.beginHalfIntro = M => {\n  const S = M.S;\n  M.phase = 'intro'; M.clock = 0; M.introT = 2.2; M.cam = 'plate';\n  M.needNewBatter = true;\n  M.paPrevKey = BZ.halfKey(S);\n  M.stamp = { text: (S.top ? 'TOP ' : 'BOTTOM ') + BZ.ordinal(S.inning).toUpperCase(), color: '#ffe6a0', t: 2.2, sub: BZ.TEAMS[BZ.battingTeam(S)].name + ' at bat' };\n  M.swung = false; M.swing = null; M.plan = null; M.pending = null;\n};\n\n// Each frame. Inputs are read here, once; the phases change the state; the rigs and the camera follow.\nBZ.matchUpdate = (game, M, dt) => {\n  if (!M) return;\n  const S = M.S, bt = BZ.battingTeam(S), ft = BZ.fieldingTeam(S);\n  const pitcherIn = M.human[ft] ? BZ.controllerInput(game, ft) : null;\n  const batterIn = M.human[bt] ? BZ.controllerInput(game, bt) : null;\n  M.clock += dt;\n  if (M.stamp) { M.stamp.t -= dt; if (M.stamp.t <= 0 && M.phase !== 'intro' && M.phase !== 'after') M.stamp = null; }\n  BZ.tickSwing(M, dt);\n\n  switch (M.phase) {\n    case 'intro':\n      M.introT -= dt;\n      if (M.introT <= 0) { M.stamp = null; M.phase = 'ready'; M.clock = 0; M.cpuPlanT = .9 + BZ.rng.fx() * .4; }\n      break;\n    case 'ready':\n      if (M.needNewBatter) { BZ.beginPA(S); M.needNewBatter = false; M.paEnded = false; M.reticle = null; }\n      M.cam = 'plate';\n      if (!M.human[ft] || M.opts.attract) {\n        if (M.clock >= M.cpuPlanT) { M.plan = BZ.botPitch(S); M.phase = 'windup'; M.clock = 0; }\n      } else if (pitcherIn) BZ.humanPitchReady(game, M, pitcherIn, dt);\n      break;\n    case 'windup':\n      M.windupK = Math.min(1, M.clock / .55);\n      if (M.clock >= .55) {\n        if (M.human[ft] && !M.opts.attract) { M.phase = 'meter'; M.meterT = 0; }\n        else BZ.release(M, .5);\n      }\n      break;\n    case 'meter':\n      M.meterT += dt;\n      M.meterP = .5 + .5 * Math.sin(M.meterT * Math.PI * 2 / 1.15 - Math.PI / 2);\n      if ((pitcherIn && pitcherIn.pressed('confirm')) || M.meterT > 2.4) BZ.release(M, M.meterP);\n      break;\n    case 'pitch':\n      BZ.pitchUpdate(game, M, dt, batterIn);\n      break;\n    case 'inplay':\n      BZ.playUpdate(game, M, dt, pitcherIn);\n      break;\n    case 'after':\n      M.afterT -= dt;\n      if (M.afterT <= 0) BZ.nextAfter(game, M);\n      break;\n    case 'final':\n      M.finalT -= dt;\n      if (M.finalT <= 0) BZ.endMatch(game, M);\n      break;\n  }\n  BZ.rigsUpdate(M, dt);\n  BZ.focusCam(game, M);\n  M.batterRunT = M.ball ? Math.min(1, M.batterRunT + dt / Math.max(.1, BZ.runTime())) : 0;\n};\n\n// The human pitcher's setup: the pitch (chips, Q/E, a click), the aim (stick, or the mouse), the Fireball, and a press to\n// wind up. Clicking the pitch's chip picks it; a click anywhere else on the screen winds up.\nBZ.humanPitchReady = (game, M, I, dt) => {\n  const S = M.S, plist = BZ.PITCH_IDS, idx = plist.indexOf(M.pitchChoice);\n  if (I.pressed('prevPitch')) M.pitchChoice = plist[(idx + plist.length - 1) % plist.length];\n  if (I.pressed('nextPitch')) M.pitchChoice = plist[(idx + 1) % plist.length];\n  const click = game.input.clicked();\n  const onChip = click ? BZ.chipAt(click[0], click[1]) : null;\n  const hover = BZ.chipAt(...(game.input.pointer() || [-1, -1]));\n  if (onChip) M.pitchChoice = onChip;\n  else if (hover) M.pitchChoice = hover;\n  // the aim: the stick moves it; a mouse that moves puts it on the pointer\n  const pt = game.input.pointer(), mv = I.move();\n  if (pt && M.prevPointer && Math.abs(pt[0] - M.prevPointer[0]) + Math.abs(pt[1] - M.prevPointer[1]) > 2) {\n    const p = BZ.plateFromScreen(pt[0], pt[1], game.W, game.H);\n    M.aim = BZ.clampAim(p.lat, p.h);\n  } else if (mv[0] || mv[1]) {\n    M.aim = BZ.clampAim(M.aim.lat + mv[0] * 1.8 * dt, M.aim.h - mv[1] * 1.8 * dt);\n  }\n  M.prevPointer = pt ? pt.slice() : null;\n  if (I.pressed('power') && BZ.meter[BZ.fieldingTeam(S)] >= 100) M.fireball = !M.fireball;\n  if (I.pressed('confirm') || (click && !onChip)) {\n    M.pending = { pitch: M.pitchChoice, aimLat: M.aim.lat, aimH: M.aim.h, superPitch: M.fireball };\n    if (M.fireball) { BZ.meter[BZ.fieldingTeam(S)] = 0; M.fireball = false; }\n    M.phase = 'windup'; M.clock = 0; M.prevPointer = null;\n  }\n};\n\n// Pitch selection chips at the bottom-left of the screen: their rectangles for hover and click.\nBZ.chipRects = game => BZ.PITCH_IDS.map((id, i) => ({ id, x0: 16 + i * 94, y0: game.H - 58, x1: 102 + i * 94, y1: game.H - 16 }));\nBZ.chipAt = (x, y) => {\n  const g = BZ.game;\n  if (!g || x < 0) return null;\n  for (const c of BZ.chipRects(g)) if (x >= c.x0 && x <= c.x1 && y >= c.y0 && y <= c.y1) return c.id;\n  return null;\n};\n\n// The release: the pitch the pitcher chose, with the meter's place, goes. A CPU's plan is ready already.\nBZ.release = (M, p) => {\n  const S = M.S;\n  let plan = M.plan;\n  if (M.pending) {\n    plan = BZ.planPitch({ pitch: M.pending.pitch, aimLat: M.pending.aimLat, aimH: M.pending.aimH, release: p, superPitch: M.pending.superPitch });\n    M.pending = null;\n  }\n  M.plan = plan;\n  M.pt = 0; M.phase = 'pitch'; M.clock = 0; M.trail = []; M.pitchPos = null;\n  M.swung = false; M.swing = null; M.cpuSwing = null; M.swingAt = 0;\n  // the batter: the CPU decides its swing now, unless a player is at the plate\n  const bt = BZ.battingTeam(S);\n  if (!M.human[bt] || M.opts.attract) {\n    const sw = BZ.cpuSwing(S, plan, BZ.rng.play, M.opts.cpuLevel || BZ.TUNE.cpuLevel);\n    if (sw) { M.cpuSwing = sw; M.swingAt = plan.time + sw.swingT; }\n    if (M.drill && M.drill.kind === 'catch') { M.cpuSwing = { swingT: 0, reticle: BZ.plateLoc(plan) }; M.swingAt = plan.time; }\n  }\n  M.events.push({ type: 'pitch', pitch: plan.pitch, time: plan.time, miss: plan.miss, super: plan.super });\n};\n\n// The pitch in flight: the batter's swing (a player's press or the CPU's timed one), and the umpire's call on arrival.\nBZ.pitchUpdate = (game, M, dt, batterIn) => {\n  const plan = M.plan, S = M.S, bt = BZ.battingTeam(S);\n  M.pt += dt;\n  const pos = BZ.pitchAt(plan, Math.min(1, M.pt / plan.time));\n  M.pitchPos = pos;\n  M.trail.push({ lat: pos.lat, h: pos.h, depth: pos.depth });\n  if (M.trail.length > 9) M.trail.shift();\n  const clickAt = game.input.clicked();\n  if (!M.swung && batterIn && !M.opts.attract) {\n    const ret = BZ.batterAim(game, M, batterIn, dt);\n    if (batterIn.pressed('confirm') || (clickAt && !BZ.chipAt(clickAt[0], clickAt[1]))) {\n      const bz = !!(batterIn.pressed('power') && BZ.meter[bt] >= 100);\n      if (bz) BZ.meter[bt] = 0;\n      BZ.afterSwing(game, M, BZ.resolveSwing(M, M.pt, ret, bz));\n    }\n  } else if (!M.swung && M.cpuSwing && M.pt >= M.swingAt) {\n    const bz = !!(M.opts.attract && BZ.meter[bt] >= 100);\n    if (bz) BZ.meter[bt] = 0;\n    BZ.afterSwing(game, M, BZ.resolveSwing(M, M.pt, M.cpuSwing.reticle, bz));\n  }\n  if (M.phase !== 'pitch') return;\n  if (M.pt >= plan.time + .3) {\n    if (!M.swung) {\n      const at = BZ.plateLoc(plan);\n      BZ.countEvent(game, M, BZ.inZone(at.lat, at.h) ? 'strike' : 'ball', false);\n    }\n    BZ.afterPitch(game, M);\n  }\n};\n\n// A player's reticle: the stick moves it, the mouse puts it on the pointer; the default is the middle of the plate.\nBZ.batterAim = (game, M, I, dt) => {\n  const pt = game.input.pointer(), mv = I.move();\n  M.reticle = M.reticle || { lat: 0, h: 2.6 };\n  if (pt && M.prevPointer && Math.abs(pt[0] - M.prevPointer[0]) + Math.abs(pt[1] - M.prevPointer[1]) > 2) {\n    const p = BZ.plateFromScreen(pt[0], pt[1], game.W, game.H);\n    M.reticle = { lat: BZ.clamp(p.lat, -1.6, 1.6), h: BZ.clamp(p.h, .6, 4.6) };\n  } else if (mv[0] || mv[1]) {\n    M.reticle = { lat: BZ.clamp(M.reticle.lat + mv[0] * 1.6 * dt, -1.6, 1.6), h: BZ.clamp(M.reticle.h - mv[1] * 1.6 * dt, .6, 4.6) };\n  }\n  M.prevPointer = pt ? pt.slice() : null;\n  return M.reticle;\n};\n\n// The swing's animation timer (the rig's swing and the bat), 0.32 s.\nBZ.tickSwing = (M, dt) => {\n  if (M.swingPhase === 'swing') {\n    M.swingK = Math.min(1, M.swingK + dt / .32);\n    if (M.swingK >= 1) M.swingPhase = null;\n  }\n};\n\n// After a swing: contact sends the ball into play; a foul or a whiff is counted here.\nBZ.afterSwing = (game, M, c) => {\n  const S = M.S, ft = BZ.fieldingTeam(S);\n  M.swing = Object.assign(M.swing, c);\n  if (c.type === 'hit') {\n    M.ball = BZ.launchBall({ exit: c.exit, launch: c.launch, spray: c.spray, batzooka: c.batzooka });\n    M.play = new BZ.Play(S, M.ball, M.fielders[ft]);\n    for (const f of M.fielders[ft]) f.human = !!M.human[ft] && !M.opts.attract;\n    M.phase = 'inplay'; M.cam = 'field'; M.clock = 0; M.batterRunT = 0;\n    BZ.sfx(c.batzooka ? 'rocket' : 'crack', { vol: c.batzooka ? .6 : 1 });\n    if (c.batzooka) BZ.sfx('fire', { vol: .4 });\n    return;\n  }\n  if (c.type === 'foul') { BZ.countEvent(game, M, 'foul', false); BZ.afterPitch(game, M); return; }\n  BZ.countEvent(game, M, 'strike', true);   // a whiff: a swinging strike\n  BZ.afterPitch(game, M);\n};\n\n// The count moves for a called or swung-at pitch. A walk, a strikeout or the half's end finishes the plate appearance.\n// kind: 'ball' | 'strike' (called or swung at) | 'foul'. Returns the rules' event.\nBZ.countEvent = (game, M, kind, swung) => {\n  const S = M.S, ft = BZ.fieldingTeam(S);\n  const ev = BZ.pitchCount(S, kind === 'ball' ? 'ball' : kind === 'strike' ? 'strike' : 'foul');\n  const count = BZ.countText(S);\n  M.events.push({ type: 'call', kind, ev: ev.ev, count });\n  if (kind === 'ball') { BZ.sfx('ball'); M.stamp = { text: 'BALL', color: '#7ad0ff', t: 1, sub: count }; if (BZ.rng.fx() < .3) BZ.say(M.talk, 'ball'); }\n  if (kind === 'strike') { BZ.sfx('strike'); M.stamp = { text: swung ? 'SWINGING STRIKE' : 'STRIKE', color: '#ffb020', t: 1, sub: count }; if (!swung && BZ.rng.fx() < .5) BZ.say(M.talk, 'strike'); }\n  if (kind === 'foul') { BZ.sfx('foul'); M.stamp = { text: 'FOUL', color: '#ffb020', t: 1, sub: count }; if (BZ.rng.fx() < .3) BZ.say(M.talk, 'foul'); }\n  if (kind === 'strike' && M.drill && M.drill.kind === 'strikes') M.drill.got = Math.min(M.drill.goal, M.drill.got + 1);\n  if (ev.ev === 'k') {\n    BZ.sfx('out'); BZ.say(M.talk, 'k');\n    M.stamp = { text: 'STRIKE THREE', color: '#ff6a5a', t: 1.8, sub: 'OUT' };\n    BZ.meter[ft] = Math.min(100, BZ.meter[ft] + 20);\n  }\n  if (ev.ev === 'walk') { BZ.sfx('confirm'); BZ.say(M.talk, 'walk'); M.stamp = { text: 'BALL FOUR', color: '#7ad0ff', t: 1.8, sub: 'WALK' }; }\n  if (ev.ev === 'k' || ev.ev === 'walk' || ev.end || ev.ev === 'gameOver') M.paEnded = true;\n  if (M.paEnded) M.needNewBatter = true;\n  return ev;\n};\n\n// The pitch is over: a pause for the call, then the next pitch, the next batter or the change of half.\nBZ.afterPitch = (game, M) => {\n  M.phase = 'after'; M.clock = 0;\n  M.afterT = M.paEnded ? 2 : 1.1;\n};\n\n// The batted ball: the defense plays it, the rules decide the play, and a result stamp says what happened.\nBZ.playUpdate = (game, M, dt, pitcherIn) => {\n  const human = { move: pitcherIn ? pitcherIn.move() : [0, 0], dive: !!(pitcherIn && pitcherIn.pressed('confirm')) };\n  if (M.play.phase === 'fielded' && pitcherIn) {\n    if (pitcherIn.pressed('up')) human.pick = 'second';\n    else if (pitcherIn.pressed('left')) human.pick = 'third';\n    else if (pitcherIn.pressed('right')) human.pick = 'first';\n    const click = game.input.clicked();\n    if (click) {\n      const b = M.basePx.findIndex(p => p && Math.hypot(p[0] - click[0], p[1] - click[1]) < 32);\n      if (b >= 0) human.pick = ['first', 'second', 'third', null][b];\n    }\n  }\n  M.play.step(dt, human);\n  for (const e of M.play.events.splice(0)) {\n    M.events.push({ type: 'play:' + e.type, who: e.fielder || e.target });\n    if (e.type === 'caught') BZ.sfx('catch');\n    if (e.type === 'fielded') BZ.sfx('thud');\n    if (e.type === 'throw') BZ.sfx('throw');\n  }\n  if (M.play.phase === 'over') BZ.playResolved(game, M);\n};\n\n// The play is over. The stamp says it, the batter's meter fills, the drill counts it, and the count moves on.\nBZ.playResolved = (game, M) => {\n  const S = M.S, bt = BZ.battingTeam(S), res = M.play.result;\n  const ball = M.ball;\n  let text = 'OUT', color = '#ff6a5a', sub = '', key = null;\n  if (res.kind === 'foul') {\n    BZ.countEvent(game, M, 'foul', false);\n    M.play = null; M.ball = null;\n    BZ.afterPitch(game, M);\n    return;\n  }\n  if (res.kind === 'caught') {\n    text = 'CAUGHT'; sub = res.deep ? 'deep fly: the runner tags up' : 'fly out'; key = 'caught';\n    BZ.sfx('out');\n    if (M.drill && M.drill.kind === 'catch') M.drill.got = Math.min(M.drill.goal, M.drill.got + 1);\n  } else if (res.kind === 'hit') {\n    const T = { single: ['SINGLE', '#ffe6a0'], double: ['DOUBLE', '#ffe6a0'], triple: ['TRIPLE', '#ffb020'], hr: ['HOME RUN', '#ffb020'] }[res.type];\n    text = T[0]; color = T[1]; key = res.type;\n    BZ.meter[bt] = Math.min(100, BZ.meter[bt] + ({ single: .5, double: 1, triple: 1.3, hr: 2 }[res.type]) * BZ.TUNE.meterGain);\n    if (res.type === 'hr' && ball) sub = Math.round(ball.homer ? ball.crossDist : ball.landDist) + ' FT' + (ball.batzooka ? ' · BATZOOKA' : '');\n    if (res.type === 'hr') { BZ.sfx('fanfare'); BZ.sfx('cheer'); if (ball) game.particles.explosion(ball.x, ball.y, 4, 1.2); }\n    else BZ.sfx('cheer', { vol: .5 });\n    if (M.drill && M.drill.kind === 'hit' && res.type !== undefined) M.drill.got = Math.min(M.drill.goal, M.drill.got + 1);\n    if (M.drill && M.drill.kind === 'homer' && res.type === 'hr' && ball && ball.batzooka) M.drill.got = Math.min(M.drill.goal, M.drill.got + 1);\n  } else if (res.kind === 'ground') {\n    if (res.batterOut) { text = 'OUT AT FIRST'; key = 'groundOut'; BZ.sfx('out'); }\n    else if (res.runnerOut) { text = 'FORCE OUT'; key = 'forceOut'; BZ.sfx('out'); }\n    else { text = 'SAFE'; color = '#7ad06a'; key = 'safe'; BZ.sfx('confirm'); }\n    if (res.r && res.r.runs) sub = res.r.runs + (res.r.runs > 1 ? ' RUNS SCORE' : ' RUN SCORES');\n  }\n  if (key) BZ.say(M.talk, key);\n  M.stamp = { text, color, t: 2, sub };\n  M.events.push({ type: 'result', kind: res.kind, text, S_outs: S.outs });\n  M.play = null; M.ball = null; M.swing = null;\n  M.paEnded = true; M.needNewBatter = true;\n  M.phase = 'after'; M.clock = 0; M.afterT = 2.1;\n};\n\n// The next thing after a count or a play: the final, the change of half, or the next pitch (the same batter, or the next).\nBZ.nextAfter = (game, M) => {\n  const S = M.S;\n  M.stamp = null;\n  if (S.over) {\n    M.phase = 'final'; M.finalT = 3.4; M.clock = 0; M.cam = 'plate';\n    BZ.playSong('results');\n    BZ.say(M.talk, S.walkoff ? 'walkoff' : 'over');\n    return;\n  }\n  if (BZ.halfKey(S) !== M.paPrevKey) { BZ.beginHalfIntro(M); return; }\n  M.paEnded = false;\n  M.phase = 'ready'; M.clock = 0; M.cpuPlanT = .9 + BZ.rng.fx() * .4; M.fireball = false;\n  M.cam = 'plate'; M.swung = false; M.swing = null; M.trail = []; M.plan = null; M.pitchPos = null;\n};\n\n// The match is over: its state goes to the results screen.\nBZ.endMatch = (game, M) => {\n  BZ.M = M;\n  BZ.playSong(null);\n  game.go('results', { S: M.S, drill: M.drill, opts: M.opts });\n};\n\n// The rigs' poses from the state: the wind-up and release, the swing, the stance, the runners on the bases, the fielders.\nBZ.rigsUpdate = (M, dt) => {\n  const S = M.S, bt = BZ.battingTeam(S), ft = BZ.fieldingTeam(S);\n  for (const t of [0, 1]) {\n    const R = M.rigs[t];\n    for (const f of M.fielders[t]) {\n      const st = { x: f.x, y: f.y, z: 0, facing: f.face || 0, vx: f.vx || 0, vy: f.vy || 0 };\n      if (t === ft && f.role === 'P') {\n        if (M.phase === 'windup' || M.phase === 'meter') st.attack = E.move('overhead', M.phase === 'windup' ? M.windupK : .5);\n        else if (M.phase === 'pitch') st.attack = E.move('overhead', 1, 'recover');\n      }\n      if (f.role === 'C') st.pose = 'crouch';\n      R.fielders[f.role].update(dt, st);\n    }\n    const bstate = { x: 0, y: 0, z: 0, facing: Math.PI / 2 };\n    if (t === bt && M.swingPhase === 'swing') bstate.attack = E.move('slash', M.swingK);\n    else bstate.stance = 'ready';\n    R.batter.update(dt, bstate);\n    R.runners.forEach((rr, i) => rr.update(dt, { x: 0, y: 0, z: 0, facing: 0, stance: 'ready' }));\n  }\n};\n\n// The camera: the Plate Cam has none; the field follows the ball, or the plate while nothing is in play.\nBZ.focusCam = (game, M) => {\n  if (M.cam !== 'field') return;\n  const b = M.ball;\n  if (b) game.focus(b.x, b.y - 90, b.z * .4);\n  else game.focus(BZ.HX, BZ.HY - 260, 0);\n};\n\n// The draw: the Plate Cam for the duel, the field for the play; then the HUD over both.\nBZ.matchDraw = (r, M) => {\n  if (!M) return;\n  const W = r.W, H = r.H, S = M.S, park = BZ.PARKS[BZ.park];\n  if (M.cam === 'field') BZ.drawField(r, M);\n  else {\n    r.sky(park.night ? ['#060818', '#2a2a5a'] : park.sky);\n    const ft = BZ.fieldingTeam(S), bt = BZ.battingTeam(S);\n    r.overlay(g => {\n      BZ.drawPlateGround(g, W, H, park);\n      BZ.drawZone(g, W, H);\n      BZ.drawPlatePlayers(g, W, H, { view: r.view, pitcher: M.rigs[ft].fielders.P, catcher: M.rigs[ft].fielders.C, batter: M.rigs[bt].batter });\n      if (M.plan && M.phase === 'pitch' && M.pitchPos) BZ.drawPitchBall(g, W, H, M.plan, Math.min(1, M.pt / M.plan.time), M.trail);\n      if (M.phase === 'ready' || M.phase === 'windup' || M.phase === 'meter') BZ.drawAimReticle(g, W, H, M);\n      if (M.phase === 'pitch' && !M.swung && M.human[bt]) BZ.drawBatterReticle(g, W, H, M);\n      if (M.swing && M.swing.type && M.swingPhase) BZ.drawBat(g, W, H, { swing: M.swingK, reticle: M.swing.reticle });\n    });\n  }\n  r.overlay(g => BZ.drawHud(g, r, M));\n  if (M.talk) M.talk.draw(r);\n};\n\n// The field view: the TileMap, the fielders, the runners, the batter's run and the ball, with the bases clickable.\nBZ.drawField = (r, M) => {\n  const S = M.S, ft = BZ.fieldingTeam(S), bt = BZ.battingTeam(S);\n  BZ.field.drawFloor(r);\n  BZ.field.queueWalls(r);\n  for (const f of M.fielders[ft]) {\n    const rig = M.rigs[ft].fielders[f.role];\n    r.shadow(f.x, f.y, 6, .3, undefined, 0);\n    r.actor(f.x, f.y, 0, (g, ox, oy) => rig.draw(g, ox, oy, r.view));\n  }\n  const bases = BZ.bases();\n  bases.forEach((b, i) => { M.basePx[i] = r.w(b.x, b.y, 0); });\n  bases.slice(0, 3).forEach((b, i) => {\n    if (S.bases[i]) { const rr = M.rigs[bt].runners[i]; r.actor(b.x, b.y, 0, (g, ox, oy) => rr.draw(g, ox, oy, r.view)); }\n  });\n  if (M.ball && M.batterRunT > 0 && M.batterRunT < 1) {\n    const p = bases[0], x = BZ.lerp(BZ.HX, p.x, M.batterRunT), y = BZ.lerp(BZ.HY - 10, p.y, M.batterRunT);\n    r.actor(x, y, 0, (g, ox, oy) => M.rigs[bt].batter.draw(g, ox, oy, r.view));\n  }\n  if (M.ball) {\n    const b = M.ball;\n    r.shadow(b.x, b.y, 4, .45, undefined, 0);\n    r.sprite(b.x, b.y, b.z + 4, BZ.BALL_SPR, { glow: .3 });\n  }\n};\n\n// The ball's sprite: a white ball with a red seam, drawn once.\nBZ.BALL_SPR = E.sprite(['.www.', 'wwrww', 'wrwrw', 'wwrww', '.www.'], { w: '#f8f8f0', r: '#c83a3a' }, 2);\n\n// The HUD for the match: the scorebug, the pitch chips, the meters, the release meter, the stamp and the prompt.\nBZ.drawHud = (g, r, M) => {\n  const S = M.S, W = r.W, H = r.H;\n  BZ.drawScorebug(g, S, 16, 16);\n  const bt = BZ.battingTeam(S), ft = BZ.fieldingTeam(S);\n  if (M.phase === 'ready' && M.human[ft]) BZ.drawChips(g, M);\n  if (M.human[bt]) BZ.drawBatzookaMeter(g, W - 178, H - 40, 150, BZ.meter[bt], 'BATZOOKA', BZ.meter[bt] >= 100);\n  if (M.human[ft]) BZ.drawBatzookaMeter(g, W - 178, H - 74, 150, BZ.meter[ft], 'FIREBALL', BZ.meter[ft] >= 100 || M.fireball);\n  if (M.phase === 'meter') {\n    BZ.drawMeter(g, W / 2 - 90, H * .72, 180, M.meterP);\n    BZ.text(g, BZ.prompt('confirm', 'RELEASE'), W / 2, H * .72 - 26, '#ffffff', { align: 'center', scale: 1.6 });\n  }\n  if (M.stamp) BZ.drawStamp(g, W, H, M.stamp, M.stamp.color, M.stamp.sub);\n  if (M.drill) BZ.text(g, BZ.drillText(M), W / 2, 14, '#ffe6a0', { align: 'center', scale: 1.4 });\n  BZ.drawPrompt(g, W, H, M);\n};\n\nBZ.drillText = M => {\n  const names = { strikes: 'THROW STRIKES', hit: 'PUT ONE IN PLAY', catch: 'CATCH A FLY', homer: 'HIT A HOMER WITH THE BATZOOKA' };\n  return names[M.drill.kind] + '   ' + M.drill.got + '/' + M.drill.goal;\n};\n\n// The pitch chips: the one picked is lit. Hover moves to it; a click picks it.\nBZ.drawChips = (g, M) => {\n  for (const c of BZ.chipRects(BZ.game)) {\n    const on = c.id === M.pitchChoice, P = BZ.PITCHES[c.id];\n    E.ui.box(g, c.x0, c.y0, c.x1 - c.x0, c.y1 - c.y0, { bg: on ? ['#ffe6a0', '#c8a060'] : ['#1a1d2a', '#0b0d16'], border: on ? '#ffffff' : '#c8a060', alpha: .92 });\n    BZ.text(g, P.name, c.x0 + 6, c.y0 + 6, on ? '#1a1020' : '#ffffff', { scale: 1.1, shadow: null });\n    BZ.text(g, P.tag + (c.id === 'fastball' ? '' : ''), c.x0 + 6, c.y0 + 22, on ? '#1a1020' : '#c8d0f0', { scale: 1, shadow: null });\n  }\n};\n\n// The prompt line at the bottom: what this player does now, with the label for their device.\nBZ.drawPrompt = (g, W, H, M) => {\n  const S = M.S, bt = BZ.battingTeam(S), ft = BZ.fieldingTeam(S);\n  let line = '';\n  if (M.phase === 'ready' && M.human[ft]) line = BZ.prompt('confirm', 'WIND UP') + '   ' + BZ.keys('prevPitch', 'nextPitch') + ' PITCH   STICK AIMS   ' + BZ.prompt('power', 'FIREBALL WHEN FULL');\n  else if (M.phase === 'pitch' && M.human[bt] && !M.swung) line = BZ.prompt('confirm', 'SWING') + '   STICK AIMS THE BAT   ' + BZ.prompt('power', 'BATZOOKA WHEN FULL');\n  else if (M.phase === 'inplay' && M.human[ft]) line = BZ.prompt('confirm', 'DIVE') + '   STICK RUNS   ' + (M.play && M.play.phase === 'fielded' ? 'UP 2ND   LEFT 3RD   RIGHT 1ST' : '');\n  if (line) {\n    const w = line.length * 6.4 + 28;\n    E.ui.box(g, W / 2 - w / 2, H - 26, w, 20, { bg: ['#101420', '#060810'], border: '#c8a060', alpha: .85 });\n    BZ.text(g, line, W / 2, H - 20, '#ffffff', { align: 'center', scale: 1.2, shadow: null });\n  }\n};\n\n// Two keys' labels as one: \"Q/E\".\nBZ.keys = (a, b) => (BZ.game.input.label(a) || '') + '/' + (BZ.game.input.label(b) || '');\n\n// The aim: the pitcher's target on the plate's plane.\nBZ.drawAimReticle = (g, W, H, M) => {\n  const p = BZ.project(M.aim.lat, M.aim.h, 0, W, H);\n  E.px.disc(g, p.x, p.y, Math.max(3, 2 * p.s), '#ffffff55');\n  E.px.disc(g, p.x, p.y, 2, '#ffe6a0');\n};\n\n// The batter's reticle: the bat's head, sized by the bat's reach.\nBZ.drawBatterReticle = (g, W, H, M) => {\n  const ret = M.reticle || { lat: 0, h: 2.6 };\n  const p = BZ.project(ret.lat, ret.h, 0, W, H);\n  E.px.disc(g, p.x, p.y, Math.max(3, BZ.TUNE.reach * p.s), '#ffe6a040');\n  E.px.disc(g, p.x, p.y, 2, '#ffe6a0');\n};\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012PHxhVHDcJwTi3AmhqoGc8","type":"tool_result","content":"The file /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-060643__x4549c1/work/BatzookaBaseball-Baseball-claude-haiku-5-5-medium-20261104-060643/src/30-match.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"3c80e66f-5c94-452e-938f-9b08d33b83c6","uuid":"963ccb27-5d39-4ca6-a02b-08173e1ee388","timestamp":"2026-11-04T13:19:34.309Z","tool_use_result":{"type":"update","filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-060643__x4549c1/work/BatzookaBaseball-Baseball-claude-haiku-5-5-medium-20261104-060643/src/30-match.js","content":"// The match: the scene that plays innings. It owns the phases of a plate appearance (intro, ready, windup, meter, pitch,\n// inplay, after, final), the input of whoever controls each side, the two views (the Plate Cam for the duel, the field\n// for the play), the HUD and the commentary. The rules and physics are the pure modules (10 to 14); this scene asks them\n// what happens and shows it.\n//\n// Control: team 1 (the home team) is player 1; team 0 (the visitors) is player 2 when one has joined, else the CPU.\n// On defense the pitcher and the chaser are the fielding team's controller; at the plate, the batting team's.\nBZ.LINES = {\n  intro: ['Ladies and gentlemen, the game is about to begin. The corn is high and the beer is cold.'],\n  ball: ['Ball one. The crowd has something to say about that.', 'That one was outside. Way outside.'],\n  strike: ['Strike! The scoreboard is blinking at him.', 'Right down the middle! Hooray!'],\n  foul: ['Foul ball! Into the corn!', 'That one went foul, and somebody in row nine is wearing it.'],\n  k: ['Strike three! He is out, and he is going home to tell the dog.', 'Struck him out looking! The dugout is crying.'],\n  walk: ['Four balls. The pitcher has forgotten the way to the plate.'],\n  single: ['A single, and that one has a little spin on it!', 'Base hit! The fans are tossing their hats!'],\n  double: ['A double into the gap! Two bases and a cloud of dust!'],\n  triple: ['A triple! He is going like corn in a windstorm!'],\n  hr: ['WAY BACK! WAY BACK! That one is GONE!', 'Home run! The Batzooka has spoken!'],\n  caught: ['Caught on the warning track! Oh my, what a catch!', 'Hauled it in! That fly is an out, folks.'],\n  groundOut: ['Grounder to the infield, and the throw beats him. Out!', 'Nimble work in the infield. He is out.'],\n  forceOut: ['Out at second! The runner was a bit slow on the basepaths.'],\n  safe: ['Safe! By a whisker!', 'He beat the throw. Safe at first.'],\n  over: ['That is the ballgame! Thank you for coming out to Kernel Field!'],\n  walkoff: ['A walk-off! The home crowd goes wild! Bring the cows out!']\n};\n\n// A line of commentary in the announcer's box; the big calls are also babbled (the Animalese voice).\nBZ.say = (talk, key) => {\n  const pool = BZ.LINES[key];\n  if (!pool || !talk) return;\n  const line = BZ.pick(BZ.rng.fx, pool);\n  talk.say(line, { name: 'PA', auto: 2.8, modal: false });\n  if (['hr', 'k', 'over', 'walkoff'].includes(key)) BZ.babble(line, { pitch: 230, rate: .07, vol: .12 });\n};\n\n// The match's state for a run: the rules, the two teams' rigs and fielders, the phase and its clocks.\n// opts: { innings, human: [visitorsHuman, homeHuman], drill, attract, cpuLevel, seed }.\nBZ.newMatchRun = (opts = {}) => {\n  BZ.meter = [0, 0];\n  BZ.seedMatch(opts.seed || 20261104);\n  const S = BZ.newMatch({ innings: opts.innings || BZ.TUNE.innings });\n  return {\n    opts, S,\n    rigs: [BZ.makeRigs(BZ.TEAMS[0]), BZ.makeRigs(BZ.TEAMS[1])],\n    fielders: [BZ.makeFielders(), BZ.makeFielders()],\n    human: [!!(opts.human && opts.human[0]), !!(opts.human && opts.human[1])],\n    phase: 'intro', clock: 0, introT: 2.4, afterT: 0, finalT: 3.2,\n    needNewBatter: true, paPrevKey: BZ.halfKey(S), paEnded: false,\n    pitchChoice: 'fastball', aim: { lat: 0, h: 2.6 }, fireball: false, pending: null,\n    meterT: 0, meterP: .5, windupK: 0, cpuPlanT: 1,\n    plan: null, pt: 0, trail: [], pitchPos: null, swung: false, swing: null, swingK: 0, swingPhase: null,\n    cpuSwing: null, swingAt: 0, reticle: null, prevPointer: null,\n    play: null, ball: null, cam: 'plate', batterRunT: 0, basePx: [],\n    stamp: null, talk: null, events: [],\n    drill: opts.drill ? { kind: opts.drill.kind, goal: opts.drill.goal, got: 0 } : null\n  };\n};\n\n// Start a match: the scene switches to it, and it begins with the first half's intro.\nBZ.startMatch = (game, opts) => {\n  BZ.M = BZ.newMatchRun(opts);\n  game.go('match', opts);\n};\n\n// The input that controls a team: player 1 is the home team, player 2 (if joined) the visitors; otherwise the CPU.\nBZ.controllerInput = (game, team) => (team === 1 ? game.players[0] : game.players[1]) || null;\n\n// Hold the half's key: the same for the whole half-inning, so a change of half is seen.\nBZ.halfKey = S => S.inning + (S.top ? 't' : 'b');\n\n// Resolve a swing at the pitch's clock: contact, a foul or a whiff, and the reticle's place. A catch drill's contact is\n// a fly ball to center, to give the human fielder something to catch.\nBZ.resolveSwing = (M, swingPt, reticle, batzooka) => {\n  const plan = M.plan, plate = BZ.plateLoc(plan);\n  let c = BZ.contact({ swingT: swingPt - plan.time, reticle, plate, batzooka });\n  if (M.drill && M.drill.kind === 'catch' && c.type === 'hit') c = Object.assign(c, { exit: 330, launch: 40, spray: 0 });\n  M.swung = true;\n  M.swing = Object.assign({ at: swingPt, reticle, batzooka }, c);\n  M.swingPhase = 'swing'; M.swingK = 0;\n  M.events.push({ type: 'swing', result: c.type, batzooka, q: c.q });\n  return c;\n};\n\nBZ.matchScene = {\n  pausable: true, view: 'threequarter', input: 'custom', touch: false,\n  enter() {\n    const game = BZ.game, M = BZ.M;\n    BZ.field = BZ.field || BZ.buildField();\n    game.lights.enabled = BZ.park === 'moondome';\n    game.lights.ambient = .55;\n    M.talk = BZ.talkFor(game);\n    BZ.beginHalfIntro(M);\n    BZ.playSong('match');\n  },\n  exit() { BZ.game.lights.enabled = false; BZ.playSong(null); },\n  update(dt) { BZ.matchUpdate(BZ.game, BZ.M, dt); },\n  draw(r) { BZ.matchDraw(r, BZ.M); }\n};\n\nBZ.talkFor = game => BZ.talk || (BZ.talk = new E.Dialog(game));\n\n// The intro card for a half: TOP or BOTTOM of an inning, with the batting team named.\nBZ.beginHalfIntro = M => {\n  const S = M.S;\n  M.phase = 'intro'; M.clock = 0; M.introT = 2.2; M.cam = 'plate';\n  M.needNewBatter = true;\n  M.paPrevKey = BZ.halfKey(S);\n  M.stamp = { text: (S.top ? 'TOP ' : 'BOTTOM ') + BZ.ordinal(S.inning).toUpperCase(), color: '#ffe6a0', t: 2.2, sub: BZ.TEAMS[BZ.battingTeam(S)].name + ' at bat' };\n  M.swung = false; M.swing = null; M.plan = null; M.pending = null;\n};\n\n// Each frame. Inputs are read here, once; the phases change the state; the rigs and the camera follow.\nBZ.matchUpdate = (game, M, dt) => {\n  if (!M) return;\n  const S = M.S, bt = BZ.battingTeam(S), ft = BZ.fieldingTeam(S);\n  const pitcherIn = M.human[ft] ? BZ.controllerInput(game, ft) : null;\n  const batterIn = M.human[bt] ? BZ.controllerInput(game, bt) : null;\n  M.clock += dt;\n  if (M.stamp) { M.stamp.t -= dt; if (M.stamp.t <= 0 && M.phase !== 'intro' && M.phase !== 'after') M.stamp = null; }\n  BZ.tickSwing(M, dt);\n\n  switch (M.phase) {\n    case 'intro':\n      M.introT -= dt;\n      if (M.introT <= 0) { M.stamp = null; M.phase = 'ready'; M.clock = 0; M.cpuPlanT = .9 + BZ.rng.fx() * .4; }\n      break;\n    case 'ready':\n      if (M.needNewBatter) { BZ.beginPA(S); M.needNewBatter = false; M.paEnded = false; M.reticle = null; }\n      M.cam = 'plate';\n      if (!M.human[ft] || M.opts.attract) {\n        if (M.clock >= M.cpuPlanT) { M.plan = BZ.botPitch(S); M.phase = 'windup'; M.clock = 0; }\n      } else if (pitcherIn) BZ.humanPitchReady(game, M, pitcherIn, dt);\n      break;\n    case 'windup':\n      M.windupK = Math.min(1, M.clock / .55);\n      if (M.clock >= .55) {\n        if (M.human[ft] && !M.opts.attract) { M.phase = 'meter'; M.meterT = 0; }\n        else BZ.release(M, .5);\n      }\n      break;\n    case 'meter':\n      M.meterT += dt;\n      M.meterP = .5 + .5 * Math.sin(M.meterT * Math.PI * 2 / 1.15 - Math.PI / 2);\n      if ((pitcherIn && pitcherIn.pressed('confirm')) || M.meterT > 2.4) BZ.release(M, M.meterP);\n      break;\n    case 'pitch':\n      BZ.pitchUpdate(game, M, dt, batterIn);\n      break;\n    case 'inplay':\n      BZ.playUpdate(game, M, dt, pitcherIn);\n      break;\n    case 'after':\n      M.afterT -= dt;\n      if (M.afterT <= 0) BZ.nextAfter(game, M);\n      break;\n    case 'final':\n      M.finalT -= dt;\n      if (M.finalT <= 0) BZ.endMatch(game, M);\n      break;\n  }\n  BZ.rigsUpdate(M, dt);\n  BZ.focusCam(game, M);\n  M.batterRunT = M.ball ? Math.min(1, M.batterRunT + dt / Math.max(.1, BZ.runTime())) : 0;\n};\n\n// The human pitcher's setup: the pitch (chips, Q/E, a click), the aim (stick, or the mouse), the Fireball, and a press to\n// wind up. Clicking the pitch's chip picks it; a click anywhere else on the screen winds up.\nBZ.humanPitchReady = (game, M, I, dt) => {\n  const S = M.S, plist = BZ.PITCH_IDS, idx = plist.indexOf(M.pitchChoice);\n  if (I.pressed('prevPitch')) M.pitchChoice = plist[(idx + plist.length - 1) % plist.length];\n  if (I.pressed('nextPitch')) M.pitchChoice = plist[(idx + 1) % plist.length];\n  const click = game.input.clicked();\n  const onChip = click ? BZ.chipAt(click[0], click[1]) : null;\n  const hover = BZ.chipAt(...(game.input.pointer() || [-1, -1]));\n  if (onChip) M.pitchChoice = onChip;\n  else if (hover) M.pitchChoice = hover;\n  // the aim: the stick moves it; a mouse that moves puts it on the pointer\n  const pt = game.input.pointer(), mv = I.move();\n  if (pt && M.prevPointer && Math.abs(pt[0] - M.prevPointer[0]) + Math.abs(pt[1] - M.prevPointer[1]) > 2) {\n    const p = BZ.plateFromScreen(pt[0], pt[1], game.W, game.H);\n    M.aim = BZ.clampAim(p.lat, p.h);\n  } else if (mv[0] || mv[1]) {\n    M.aim = BZ.clampAim(M.aim.lat + mv[0] * 1.8 * dt, M.aim.h - mv[1] * 1.8 * dt);\n  }\n  M.prevPointer = pt ? pt.slice() : null;\n  if (I.pressed('power') && BZ.meter[BZ.fieldingTeam(S)] >= 100) M.fireball = !M.fireball;\n  if (I.pressed('confirm') || (click && !onChip)) {\n    M.pending = { pitch: M.pitchChoice, aimLat: M.aim.lat, aimH: M.aim.h, superPitch: M.fireball };\n    if (M.fireball) { BZ.meter[BZ.fieldingTeam(S)] = 0; M.fireball = false; }\n    M.phase = 'windup'; M.clock = 0; M.prevPointer = null;\n  }\n};\n\n// Pitch selection chips at the bottom-left of the screen: their rectangles for hover and click.\nBZ.chipRects = game => BZ.PITCH_IDS.map((id, i) => ({ id, x0: 16 + i * 94, y0: game.H - 58, x1: 102 + i * 94, y1: game.H - 16 }));\nBZ.chipAt = (x, y) => {\n  const g = BZ.game;\n  if (!g || x < 0) return null;\n  for (const c of BZ.chipRects(g)) if (x >= c.x0 && x <= c.x1 && y >= c.y0 && y <= c.y1) return c.id;\n  return null;\n};\n\n// The release: the pitch the pitcher chose, with the meter's place, goes. A CPU's plan is ready already.\nBZ.release = (M, p) => {\n  const S = M.S;\n  let plan = M.plan;\n  if (M.pending) {\n    plan = BZ.planPitch({ pitch: M.pending.pitch, aimLat: M.pending.aimLat, aimH: M.pending.aimH, release: p, superPitch: M.pending.superPitch });\n    M.pending = null;\n  }\n  M.plan = plan;\n  M.pt = 0; M.phase = 'pitch'; M.clock = 0; M.trail = []; M.pitchPos = null;\n  M.swung = false; M.swing = null; M.cpuSwing = null; M.swingAt = 0;\n  // the batter: the CPU decides its swing now, unless a player is at the plate\n  const bt = BZ.battingTeam(S);\n  if (!M.human[bt] || M.opts.attract) {\n    const sw = BZ.cpuSwing(S, plan, BZ.rng.play, M.opts.cpuLevel || BZ.TUNE.cpuLevel);\n    if (sw) { M.cpuSwing = sw; M.swingAt = plan.time + sw.swingT; }\n    if (M.drill && M.drill.kind === 'catch') { M.cpuSwing = { swingT: 0, reticle: BZ.plateLoc(plan) }; M.swingAt = plan.time; }\n  }\n  M.events.push({ type: 'pitch', pitch: plan.pitch, time: plan.time, miss: plan.miss, super: plan.super });\n};\n\n// The pitch in flight: the batter's swing (a player's press or the CPU's timed one), and the umpire's call on arrival.\nBZ.pitchUpdate = (game, M, dt, batterIn) => {\n  const plan = M.plan, S = M.S, bt = BZ.battingTeam(S);\n  M.pt += dt;\n  const pos = BZ.pitchAt(plan, Math.min(1, M.pt / plan.time));\n  M.pitchPos = pos;\n  M.trail.push({ lat: pos.lat, h: pos.h, depth: pos.depth });\n  if (M.trail.length > 9) M.trail.shift();\n  const clickAt = game.input.clicked();\n  if (!M.swung && batterIn && !M.opts.attract) {\n    const ret = BZ.batterAim(game, M, batterIn, dt);\n    if (batterIn.pressed('confirm') || (clickAt && !BZ.chipAt(clickAt[0], clickAt[1]))) {\n      const bz = !!(batterIn.pressed('power') && BZ.meter[bt] >= 100);\n      if (bz) BZ.meter[bt] = 0;\n      BZ.afterSwing(game, M, BZ.resolveSwing(M, M.pt, ret, bz));\n    }\n  } else if (!M.swung && M.cpuSwing && M.pt >= M.swingAt) {\n    const bz = !!(M.opts.attract && BZ.meter[bt] >= 100);\n    if (bz) BZ.meter[bt] = 0;\n    BZ.afterSwing(game, M, BZ.resolveSwing(M, M.pt, M.cpuSwing.reticle, bz));\n  }\n  if (M.phase !== 'pitch') return;\n  if (M.pt >= plan.time + .3) {\n    if (!M.swung) {\n      const at = BZ.plateLoc(plan);\n      BZ.countEvent(game, M, BZ.inZone(at.lat, at.h) ? 'strike' : 'ball', false);\n    }\n    BZ.afterPitch(game, M);\n  }\n};\n\n// A player's reticle: the stick moves it, the mouse puts it on the pointer; the default is the middle of the plate.\nBZ.batterAim = (game, M, I, dt) => {\n  const pt = game.input.pointer(), mv = I.move();\n  M.reticle = M.reticle || { lat: 0, h: 2.6 };\n  if (pt && M.prevPointer && Math.abs(pt[0] - M.prevPointer[0]) + Math.abs(pt[1] - M.prevPointer[1]) > 2) {\n    const p = BZ.plateFromScreen(pt[0], pt[1], game.W, game.H);\n    M.reticle = { lat: BZ.clamp(p.lat, -1.6, 1.6), h: BZ.clamp(p.h, .6, 4.6) };\n  } else if (mv[0] || mv[1]) {\n    M.reticle = { lat: BZ.clamp(M.reticle.lat + mv[0] * 1.6 * dt, -1.6, 1.6), h: BZ.clamp(M.reticle.h - mv[1] * 1.6 * dt, .6, 4.6) };\n  }\n  M.prevPointer = pt ? pt.slice() : null;\n  return M.reticle;\n};\n\n// The swing's animation timer (the rig's swing and the bat), 0.32 s.\nBZ.tickSwing = (M, dt) => {\n  if (M.swingPhase === 'swing') {\n    M.swingK = Math.min(1, M.swingK + dt / .32);\n    if (M.swingK >= 1) M.swingPhase = null;\n  }\n};\n\n// After a swing: contact sends the ball into play; a foul or a whiff is counted here.\nBZ.afterSwing = (game, M, c) => {\n  const S = M.S, ft = BZ.fieldingTeam(S);\n  M.swing = Object.assign(M.swing, c);\n  if (c.type === 'hit') {\n    M.ball = BZ.launchBall({ exit: c.exit, launch: c.launch, spray: c.spray, batzooka: c.batzooka });\n    M.play = new BZ.Play(S, M.ball, M.fielders[ft]);\n    for (const f of M.fielders[ft]) f.human = !!M.human[ft] && !M.opts.attract;\n    M.phase = 'inplay'; M.cam = 'field'; M.clock = 0; M.batterRunT = 0;\n    BZ.sfx(c.batzooka ? 'rocket' : 'crack', { vol: c.batzooka ? .6 : 1 });\n    if (c.batzooka) BZ.sfx('fire', { vol: .4 });\n    return;\n  }\n  if (c.type === 'foul') { BZ.countEvent(game, M, 'foul', false); BZ.afterPitch(game, M); return; }\n  BZ.countEvent(game, M, 'strike', true);   // a whiff: a swinging strike\n  BZ.afterPitch(game, M);\n};\n\n// The count moves for a called or swung-at pitch. A walk, a strikeout or the half's end finishes the plate appearance.\n// kind: 'ball' | 'strike' (called or swung at) | 'foul'. Returns the rules' event.\nBZ.countEvent = (game, M, kind, swung) => {\n  const S = M.S, ft = BZ.fieldingTeam(S);\n  const ev = BZ.pitchCount(S, kind === 'ball' ? 'ball' : kind === 'strike' ? 'strike' : 'foul');\n  const count = BZ.countText(S);\n  M.events.push({ type: 'call', kind, ev: ev.ev, count });\n  if (kind === 'ball') { BZ.sfx('ball'); M.stamp = { text: 'BALL', color: '#7ad0ff', t: 1, sub: count }; if (BZ.rng.fx() < .3) BZ.say(M.talk, 'ball'); }\n  if (kind === 'strike') { BZ.sfx('strike'); M.stamp = { text: swung ? 'SWINGING STRIKE' : 'STRIKE', color: '#ffb020', t: 1, sub: count }; if (!swung && BZ.rng.fx() < .5) BZ.say(M.talk, 'strike'); }\n  if (kind === 'foul') { BZ.sfx('foul'); M.stamp = { text: 'FOUL', color: '#ffb020', t: 1, sub: count }; if (BZ.rng.fx() < .3) BZ.say(M.talk, 'foul'); }\n  if (kind === 'strike' && M.drill && M.drill.kind === 'strikes') M.drill.got = Math.min(M.drill.goal, M.drill.got + 1);\n  if (ev.ev === 'k') {\n    BZ.sfx('out'); BZ.say(M.talk, 'k');\n    M.stamp = { text: 'STRIKE THREE', color: '#ff6a5a', t: 1.8, sub: 'OUT' };\n    BZ.meter[ft] = Math.min(100, BZ.meter[ft] + 20);\n  }\n  if (ev.ev === 'walk') { BZ.sfx('confirm'); BZ.say(M.talk, 'walk'); M.stamp = { text: 'BALL FOUR', color: '#7ad0ff', t: 1.8, sub: 'WALK' }; }\n  if (ev.ev === 'k' || ev.ev === 'walk' || ev.end || ev.ev === 'gameOver') M.paEnded = true;\n  if (M.paEnded) M.needNewBatter = true;\n  return ev;\n};\n\n// The pitch is over: a pause for the call, then the next pitch, the next batter or the change of half.\nBZ.afterPitch = (game, M) => {\n  M.phase = 'after'; M.clock = 0;\n  M.afterT = M.paEnded ? 2 : 1.1;\n};\n\n// The batted ball: the defense plays it, the rules decide the play, and a result stamp says what happened.\nBZ.playUpdate = (game, M, dt, pitcherIn) => {\n  const human = { move: pitcherIn ? pitcherIn.move() : [0, 0], dive: !!(pitcherIn && pitcherIn.pressed('confirm')) };\n  if (M.play.phase === 'fielded' && pitcherIn) {\n    if (pitcherIn.pressed('up')) human.pick = 'second';\n    else if (pitcherIn.pressed('left')) human.pick = 'third';\n    else if (pitcherIn.pressed('right')) human.pick = 'first';\n    const click = game.input.clicked();\n    if (click) {\n      const b = M.basePx.findIndex(p => p && Math.hypot(p[0] - click[0], p[1] - click[1]) < 32);\n      if (b >= 0) human.pick = ['first', 'second', 'third', null][b];\n    }\n  }\n  M.play.step(dt, human);\n  for (const e of M.play.events.splice(0)) {\n    M.events.push({ type: 'play:' + e.type, who: e.fielder || e.target });\n    if (e.type === 'caught') BZ.sfx('catch');\n    if (e.type === 'fielded') BZ.sfx('thud');\n    if (e.type === 'throw') BZ.sfx('throw');\n  }\n  if (M.play.phase === 'over') BZ.playResolved(game, M);\n};\n\n// The play is over. The stamp says it, the batter's meter fills, the drill counts it, and the count moves on.\nBZ.playResolved = (game, M) => {\n  const S = M.S, bt = BZ.battingTeam(S), res = M.play.result;\n  const ball = M.ball;\n  let text = 'OUT', color = '#ff6a5a', sub = '', key = null;\n  if (res.kind === 'foul') {\n    BZ.countEvent(game, M, 'foul', false);\n    M.play = null; M.ball = null;\n    BZ.afterPitch(game, M);\n    return;\n  }\n  if (res.kind === 'caught') {\n    text = 'CAUGHT'; sub = res.deep ? 'deep fly: the runner tags up' : 'fly out'; key = 'caught';\n    BZ.sfx('out');\n    if (M.drill && M.drill.kind === 'catch') M.drill.got = Math.min(M.drill.goal, M.drill.got + 1);\n  } else if (res.kind === 'hit') {\n    const T = { single: ['SINGLE', '#ffe6a0'], double: ['DOUBLE', '#ffe6a0'], triple: ['TRIPLE', '#ffb020'], hr: ['HOME RUN', '#ffb020'] }[res.type];\n    text = T[0]; color = T[1]; key = res.type;\n    BZ.meter[bt] = Math.min(100, BZ.meter[bt] + ({ single: .5, double: 1, triple: 1.3, hr: 2 }[res.type]) * BZ.TUNE.meterGain);\n    if (res.type === 'hr' && ball) sub = Math.round(ball.homer ? ball.crossDist : ball.landDist) + ' FT' + (ball.batzooka ? ' · BATZOOKA' : '');\n    if (res.type === 'hr') { BZ.sfx('fanfare'); BZ.sfx('cheer'); if (ball) game.particles.explosion(ball.x, ball.y, 4, 1.2); }\n    else BZ.sfx('cheer', { vol: .5 });\n    if (M.drill && M.drill.kind === 'hit' && res.type !== undefined) M.drill.got = Math.min(M.drill.goal, M.drill.got + 1);\n    if (M.drill && M.drill.kind === 'homer' && res.type === 'hr' && ball && ball.batzooka) M.drill.got = Math.min(M.drill.goal, M.drill.got + 1);\n  } else if (res.kind === 'ground') {\n    if (res.batterOut) { text = 'OUT AT FIRST'; key = 'groundOut'; BZ.sfx('out'); }\n    else if (res.runnerOut) { text = 'FORCE OUT'; key = 'forceOut'; BZ.sfx('out'); }\n    else { text = 'SAFE'; color = '#7ad06a'; key = 'safe'; BZ.sfx('confirm'); }\n    if (res.r && res.r.runs) sub = res.r.runs + (res.r.runs > 1 ? ' RUNS SCORE' : ' RUN SCORES');\n  }\n  if (key) BZ.say(M.talk, key);\n  M.stamp = { text, color, t: 2, sub };\n  M.events.push({ type: 'result', kind: res.kind, text, S_outs: S.outs });\n  M.play = null; M.ball = null; M.swing = null;\n  M.paEnded = true; M.needNewBatter = true;\n  M.phase = 'after'; M.clock = 0; M.afterT = 2.1;\n};\n\n// The next thing after a count or a play: the final, the change of half, or the next pitch (the same batter, or the next).\nBZ.nextAfter = (game, M) => {\n  const S = M.S;\n  M.stamp = null;\n  if (S.over) {\n    M.phase = 'final'; M.finalT = 3.4; M.clock = 0; M.cam = 'plate';\n    BZ.playSong('results');\n    BZ.say(M.talk, S.walkoff ? 'walkoff' : 'over');\n    return;\n  }\n  if (BZ.halfKey(S) !== M.paPrevKey) { BZ.beginHalfIntro(M); return; }\n  M.paEnded = false;\n  M.phase = 'ready'; M.clock = 0; M.cpuPlanT = .9 + BZ.rng.fx() * .4; M.fireball = false;\n  M.cam = 'plate'; M.swung = false; M.swing = null; M.trail = []; M.plan = null; M.pitchPos = null;\n};\n\n// The match is over: its state goes to the results screen.\nBZ.endMatch = (game, M) => {\n  BZ.M = M;\n  BZ.playSong(null);\n  game.go('results', { S: M.S, drill: M.drill, opts: M.opts });\n};\n\n// The rigs' poses from the state: the wind-up and release, the swing, the stance, the runners on the bases, the fielders.\nBZ.rigsUpdate = (M, dt) => {\n  const S = M.S, bt = BZ.battingTeam(S), ft = BZ.fieldingTeam(S);\n  for (const t of [0, 1]) {\n    const R = M.rigs[t];\n    for (const f of M.fielders[t]) {\n      const st = { x: f.x, y: f.y, z: 0, facing: f.face || 0, vx: f.vx || 0, vy: f.vy || 0 };\n      if (t === ft && f.role === 'P') {\n        if (M.phase === 'windup' || M.phase === 'meter') st.attack = E.move('overhead', M.phase === 'windup' ? M.windupK : .5);\n        else if (M.phase === 'pitch') st.attack = E.move('overhead', 1, 'recover');\n      }\n      if (f.role === 'C') st.pose = 'crouch';\n      R.fielders[f.role].update(dt, st);\n    }\n    const bstate = { x: 0, y: 0, z: 0, facing: Math.PI / 2 };\n    if (t === bt && M.swingPhase === 'swing') bstate.attack = E.move('slash', M.swingK);\n    else bstate.stance = 'ready';\n    R.batter.update(dt, bstate);\n    R.runners.forEach((rr, i) => rr.update(dt, { x: 0, y: 0, z: 0, facing: 0, stance: 'ready' }));\n  }\n};\n\n// The camera: the Plate Cam has none; the field follows the ball, or the plate while nothing is in play.\nBZ.focusCam = (game, M) => {\n  if (M.cam !== 'field') return;\n  const b = M.ball;\n  if (b) game.focus(b.x, b.y - 90, b.z * .4);\n  else game.focus(BZ.HX, BZ.HY - 260, 0);\n};\n\n// The draw: the Plate Cam for the duel, the field for the play; then the HUD over both.\nBZ.matchDraw = (r, M) => {\n  if (!M) return;\n  const W = r.W, H = r.H, S = M.S, park = BZ.PARKS[BZ.park];\n  if (M.cam === 'field') BZ.drawField(r, M);\n  else {\n    r.sky(park.night ? ['#060818', '#2a2a5a'] : park.sky);\n    const ft = BZ.fieldingTeam(S), bt = BZ.battingTeam(S);\n    r.overlay(g => {\n      BZ.drawPlateGround(g, W, H, park);\n      BZ.drawZone(g, W, H);\n      BZ.drawPlatePlayers(g, W, H, { view: r.view, pitcher: M.rigs[ft].fielders.P, catcher: M.rigs[ft].fielders.C, batter: M.rigs[bt].batter });\n      if (M.plan && M.phase === 'pitch' && M.pitchPos) BZ.drawPitchBall(g, W, H, M.plan, Math.min(1, M.pt / M.plan.time), M.trail);\n      if (M.phase === 'ready' || M.phase === 'windup' || M.phase === 'meter') BZ.drawAimReticle(g, W, H, M);\n      if (M.phase === 'pitch' && !M.swung && M.human[bt]) BZ.drawBatterReticle(g, W, H, M);\n      if (M.swing && M.swing.type && M.swingPhase) BZ.drawBat(g, W, H, { swing: M.swingK, reticle: M.swing.reticle });\n    });\n  }\n  r.overlay(g => BZ.drawHud(g, r, M));\n  if (M.talk) M.talk.draw(r);\n};\n\n// The field view: the TileMap, the fielders, the runners, the batter's run and the ball, with the bases clickable.\nBZ.drawField = (r, M) => {\n  const S = M.S, ft = BZ.fieldingTeam(S), bt = BZ.battingTeam(S);\n  BZ.field.drawFloor(r);\n  BZ.field.queueWalls(r);\n  for (const f of M.fielders[ft]) {\n    const rig = M.rigs[ft].fielders[f.role];\n    r.shadow(f.x, f.y, 6, .3, undefined, 0);\n    r.actor(f.x, f.y, 0, (g, ox, oy) => rig.draw(g, ox, oy, r.view));\n  }\n  const bases = BZ.bases();\n  bases.forEach((b, i) => { M.basePx[i] = r.w(b.x, b.y, 0); });\n  bases.slice(0, 3).forEach((b, i) => {\n    if (S.bases[i]) { const rr = M.rigs[bt].runners[i]; r.actor(b.x, b.y, 0, (g, ox, oy) => rr.draw(g, ox, oy, r.view)); }\n  });\n  if (M.ball && M.batterRunT > 0 && M.batterRunT < 1) {\n    const p = bases[0], x = BZ.lerp(BZ.HX, p.x, M.batterRunT), y = BZ.lerp(BZ.HY - 10, p.y, M.batterRunT);\n    r.actor(x, y, 0, (g, ox, oy) => M.rigs[bt].batter.draw(g, ox, oy, r.view));\n  }\n  if (M.ball) {\n    const b = M.ball;\n    r.shadow(b.x, b.y, 4, .45, undefined, 0);\n    r.sprite(b.x, b.y, b.z + 4, BZ.BALL_SPR, { glow: .3 });\n  }\n};\n\n// The ball's sprite: a white ball with a red seam, drawn once.\nBZ.BALL_SPR = E.sprite(['.www.', 'wwrww', 'wrwrw', 'wwrww', '.www.'], { w: '#f8f8f0', r: '#c83a3a' }, 2);\n\n// The HUD for the match: the scorebug, the pitch chips, the meters, the release meter, the stamp and the prompt.\nBZ.drawHud = (g, r, M) => {\n  const S = M.S, W = r.W, H = r.H;\n  BZ.drawScorebug(g, S, 16, 16);\n  const bt = BZ.battingTeam(S), ft = BZ.fieldingTeam(S);\n  if (M.phase === 'ready' && M.human[ft]) BZ.drawChips(g, M);\n  if (M.human[bt]) BZ.drawBatzookaMeter(g, W - 178, H - 40, 150, BZ.meter[bt], 'BATZOOKA', BZ.meter[bt] >= 100);\n  if (M.human[ft]) BZ.drawBatzookaMeter(g, W - 178, H - 74, 150, BZ.meter[ft], 'FIREBALL', BZ.meter[ft] >= 100 || M.fireball);\n  if (M.phase === 'meter') {\n    BZ.drawMeter(g, W / 2 - 90, H * .72, 180, M.meterP);\n    BZ.text(g, BZ.prompt('confirm', 'RELEASE'), W / 2, H * .72 - 26, '#ffffff', { align: 'center', scale: 1.6 });\n  }\n  if (M.stamp) BZ.drawStamp(g, W, H, M.stamp, M.stamp.color, M.stamp.sub);\n  if (M.drill) BZ.text(g, BZ.drillText(M), W / 2, 14, '#ffe6a0', { align: 'center', scale: 1.4 });\n  BZ.drawPrompt(g, W, H, M);\n};\n\nBZ.drillText = M => {\n  const names = { strikes: 'THROW STRIKES', hit: 'PUT ONE IN PLAY', catch: 'CATCH A FLY', homer: 'HIT A HOMER WITH THE BATZOOKA' };\n  return names[M.drill.kind] + '   ' + M.drill.got + '/' + M.drill.goal;\n};\n\n// The pitch chips: the one picked is lit. Hover moves to it; a click picks it.\nBZ.drawChips = (g, M) => {\n  for (const c of BZ.chipRects(BZ.game)) {\n    const on = c.id === M.pitchChoice, P = BZ.PITCHES[c.id];\n    E.ui.box(g, c.x0, c.y0, c.x1 - c.x0, c.y1 - c.y0, { bg: on ? ['#ffe6a0', '#c8a060'] : ['#1a1d2a', '#0b0d16'], border: on ? '#ffffff' : '#c8a060', alpha: .92 });\n    BZ.text(g, P.name, c.x0 + 6, c.y0 + 6, on ? '#1a1020' : '#ffffff', { scale: 1.1, shadow: null });\n    BZ.text(g, P.tag + (c.id === 'fastball' ? '' : ''), c.x0 + 6, c.y0 + 22, on ? '#1a1020' : '#c8d0f0', { scale: 1, shadow: null });\n  }\n};\n\n// The prompt line at the bottom: what this player does now, with the label for their device.\nBZ.drawPrompt = (g, W, H, M) => {\n  const S = M.S, bt = BZ.battingTeam(S), ft = BZ.fieldingTeam(S);\n  let line = '';\n  if (M.phase === 'ready' && M.human[ft]) line = BZ.prompt('confirm', 'WIND UP') + '   ' + BZ.keys('prevPitch', 'nextPitch') + ' PITCH   STICK AIMS   ' + BZ.prompt('power', 'FIREBALL WHEN FULL');\n  else if (M.phase === 'pitch' && M.human[bt] && !M.swung) line = BZ.prompt('confirm', 'SWING') + '   STICK AIMS THE BAT   ' + BZ.prompt('power', 'BATZOOKA WHEN FULL');\n  else if (M.phase === 'inplay' && M.human[ft]) line = BZ.prompt('confirm', 'DIVE') + '   STICK RUNS   ' + (M.play && M.play.phase === 'fielded' ? 'UP 2ND   LEFT 3RD   RIGHT 1ST' : '');\n  if (line) {\n    const w = line.length * 6.4 + 28;\n    E.ui.box(g, W / 2 - w / 2, H - 26, w, 20, { bg: ['#101420', '#060810'], border: '#c8a060', alpha: .85 });\n    BZ.text(g, line, W / 2, H - 20, '#ffffff', { align: 'center', scale: 1.2, shadow: null });\n  }\n};\n\n// Two keys' labels as one: \"Q/E\".\nBZ.keys = (a, b) => (BZ.game.input.label(a) || '') + '/' + (BZ.game.input.label(b) || '');\n\n// The aim: the pitcher's target on the plate's plane.\nBZ.drawAimReticle = (g, W, H, M) => {\n  const p = BZ.project(M.aim.lat, M.aim.h, 0, W, H);\n  E.px.disc(g, p.x, p.y, Math.max(3, 2 * p.s), '#ffffff55');\n  E.px.disc(g, p.x, p.y, 2, '#ffe6a0');\n};\n\n// The batter's reticle: the bat's head, sized by the bat's reach.\nBZ.drawBatterReticle = (g, W, H, M) => {\n  const ret = M.reticle || { lat: 0, h: 2.6 };\n  const p = BZ.project(ret.lat, ret.h, 0, W, H);\n  E.px.disc(g, p.x, p.y, Math.max(3, BZ.TUNE.reach * p.s), '#ffe6a040');\n  E.px.disc(g, p.x, p.y, 2, '#ffe6a0');\n};\n","structuredPatch":[{"oldStart":1,"oldLines":202,"newStart":1,"newLines":198,"lines":["-// The match: the scene that plays innings. It owns the phases of a plate appearance (setup, windup, release, the pitch,","-// the swing, the play, the count), the input of whoever controls each side (a player or the CPU), the two views (the","-// Plate Cam for the duel, the field for the play), the HUD and the commentary. The rules and the physics are the pure","-// modules (10 to 14); this scene only asks them what happens and shows it.","+// The match: the scene that plays innings. It owns the phases of a plate appearance (intro, ready, windup, meter, pitch,","+// inplay, after, final), the input of whoever controls each side, the two views (the Plate Cam for the duel, the field","+// for the play), the HUD and the commentary. The rules and physics are the pure modules (10 to 14); this scene asks them","+// what happens and shows it."," //"," // Control: team 1 (the home team) is player 1; team 0 (the visitors) is player 2 when one has joined, else the CPU.","-// On the defense the pitcher is the team's controller; at the plate the batter is. A player with both jobs gets both.","+// On defense the pitcher and the chaser are the fielding team's controller; at the plate, the batting team's."," BZ.LINES = {","-  intro: ['Ladies and gentlemen, the Megamax Dome Stars take the field.', 'Good afternoon, folks. The corn is high and the beer is cold.'],","-  ball: ['Ball one, the crowd says a little something about that.', 'That one was outside. Way outside.'],","-  strike: ['Strike, and the scoreboard is blinking at him.', 'Right down the middle! Hooray!'],","+  intro: ['Ladies and gentlemen, the game is about to begin. The corn is high and the beer is cold.'],","+  ball: ['Ball one. The crowd has something to say about that.', 'That one was outside. Way outside.'],","+  strike: ['Strike! The scoreboard is blinking at him.', 'Right down the middle! Hooray!'],","   foul: ['Foul ball! Into the corn!', 'That one went foul, and somebody in row nine is wearing it.'],","   k: ['Strike three! He is out, and he is going home to tell the dog.', 'Struck him out looking! The dugout is crying.'],","   walk: ['Four balls. The pitcher has forgotten the way to the plate.'],","   single: ['A single, and that one has a little spin on it!', 'Base hit! The fans are tossing their hats!'],","   double: ['A double into the gap! Two bases and a cloud of dust!'],","-  triple: ['A triple! He is going like the corn on a windy day!'],","-  hr: ['WAY BACK! WAY BACK! That one is GONE!', 'Home run! Home run! The Batzooka has spoken!'],","+  triple: ['A triple! He is going like corn in a windstorm!'],","+  hr: ['WAY BACK! WAY BACK! That one is GONE!', 'Home run! The Batzooka has spoken!'],","   caught: ['Caught on the warning track! Oh my, what a catch!', 'Hauled it in! That fly is an out, folks.'],","   groundOut: ['Grounder to the infield, and the throw beats him. Out!', 'Nimble work in the infield. He is out.'],","-  forceOut: ['Out at second! The runner was a bit slow on the basepaths.', 'The force is on, and he is out at second.'],","+  forceOut: ['Out at second! The runner was a bit slow on the basepaths.'],","   safe: ['Safe! By a whisker!', 'He beat the throw. Safe at first.'],","   over: ['That is the ballgame! Thank you for coming out to Kernel Field!'],","   walkoff: ['A walk-off! The home crowd goes wild! Bring the cows out!']"," };"," ","-BZ.say = (talk, key, extra = '') => {","+// A line of commentary in the announcer's box; the big calls are also babbled (the Animalese voice).","+BZ.say = (talk, key) => {","   const pool = BZ.LINES[key];","   if (!pool || !talk) return;","-  const line = BZ.pick(BZ.rng.fx, pool) + (extra ? ' ' + extra : '');","+  const line = BZ.pick(BZ.rng.fx, pool);","   talk.say(line, { name: 'PA', auto: 2.8, modal: false });","-  if (key === 'hr' || key === 'k' || key === 'over' || key === 'walkoff') BZ.babble(line, { pitch: 230, rate: .07, vol: .12 });","+  if (['hr', 'k', 'over', 'walkoff'].includes(key)) BZ.babble(line, { pitch: 230, rate: .07, vol: .12 });"," };"," ","-// Set up a match from the options: { innings, home: 1, controllers: { 0: 'cpu' | 'human', 1: ... }, drill, attract, seed }.","+// The match's state for a run: the rules, the two teams' rigs and fielders, the phase and its clocks.","+// opts: { innings, human: [visitorsHuman, homeHuman], drill, attract, cpuLevel, seed }."," BZ.newMatchRun = (opts = {}) => {","+  BZ.meter = [0, 0];","+  BZ.seedMatch(opts.seed || 20261104);","   const S = BZ.newMatch({ innings: opts.innings || BZ.TUNE.innings });","-  const rigs = [BZ.makeRigs(BZ.TEAMS[0]), BZ.makeRigs(BZ.TEAMS[1])];","   return {","-    opts, S, rigs,","-    human: [!!opts.human[0], !!opts.human[1]],","-    phase: 'intro', clock: 0, pt: 0,","+    opts, S,","+    rigs: [BZ.makeRigs(BZ.TEAMS[0]), BZ.makeRigs(BZ.TEAMS[1])],","     fielders: [BZ.makeFielders(), BZ.makeFielders()],","-    plan: null, pending: null, pitchChoice: 'fastball', aim: { lat: 0, h: 2.6 }, aimTouched: false,","-    fireball: false, meterT: 0, meterP: .5, swing: null, swung: false, swingK: 0, swingAt: null, cpuSwing: null,","-    play: null, ball: null, cam: 'plate', trail: [], stamp: null, paPrevKey: null, outcome: null,","-    basePx: [], drill: opts.drill ? { kind: opts.drill.kind, goal: opts.drill.goal, got: 0 } : null,","-    events: [], introT: 2.2, afterT: 1.6, finalT: 3.2, prevAim: null, dirPick: null, lastCount: '0-0',","-    batterRunT: 0, humanPitchedPlans: [], resultLine: ''","+    human: [!!(opts.human && opts.human[0]), !!(opts.human && opts.human[1])],","+    phase: 'intro', clock: 0, introT: 2.4, afterT: 0, finalT: 3.2,","+    needNewBatter: true, paPrevKey: BZ.halfKey(S), paEnded: false,","+    pitchChoice: 'fastball', aim: { lat: 0, h: 2.6 }, fireball: false, pending: null,","+    meterT: 0, meterP: .5, windupK: 0, cpuPlanT: 1,","+    plan: null, pt: 0, trail: [], pitchPos: null, swung: false, swing: null, swingK: 0, swingPhase: null,","+    cpuSwing: null, swingAt: 0, reticle: null, prevPointer: null,","+    play: null, ball: null, cam: 'plate', batterRunT: 0, basePx: [],","+    stamp: null, talk: null, events: [],","+    drill: opts.drill ? { kind: opts.drill.kind, goal: opts.drill.goal, got: 0 } : null","   };"," };"," ","-// Start a match in the scene. Called from the menus (and the attract, and the lessons).","+// Start a match: the scene switches to it, and it begins with the first half's intro."," BZ.startMatch = (game, opts) => {","   BZ.M = BZ.newMatchRun(opts);","-  BZ.seedMatch(opts.seed || 20261104);","-  BZ.M.S.batter = null;","   game.go('match', opts);"," };"," ","-// The scene's input, per controller. A player's input object is game.players[n].","-BZ.controllerInput = (game, team) => {","-  if (team === 1) return game.players[0];","-  return game.players[1] || null;","-};","+// The input that controls a team: player 1 is the home team, player 2 (if joined) the visitors; otherwise the CPU.","+BZ.controllerInput = (game, team) => (team === 1 ? game.players[0] : game.players[1]) || null;"," ","-// ---- the swing ----------------------------------------------------------------------------------------------------","-// Resolve a swing at the pitch's clock: contact, a foul or a whiff. The batter's aim is the reticle.","+// Hold the half's key: the same for the whole half-inning, so a change of half is seen.","+BZ.halfKey = S => S.inning + (S.top ? 't' : 'b');","+","+// Resolve a swing at the pitch's clock: contact, a foul or a whiff, and the reticle's place. A catch drill's contact is","+// a fly ball to center, to give the human fielder something to catch."," BZ.resolveSwing = (M, swingPt, reticle, batzooka) => {","-  const plan = M.plan;","-  const plate = BZ.plateLoc(plan);","-  const c = BZ.contact({ swingT: swingPt - plan.time, reticle, plate, batzooka });","+  const plan = M.plan, plate = BZ.plateLoc(plan);","+  let c = BZ.contact({ swingT: swingPt - plan.time, reticle, plate, batzooka });","+  if (M.drill && M.drill.kind === 'catch' && c.type === 'hit') c = Object.assign(c, { exit: 330, launch: 40, spray: 0 });","   M.swung = true;","   M.swing = Object.assign({ at: swingPt, reticle, batzooka }, c);","+  M.swingPhase = 'swing'; M.swingK = 0;","   M.events.push({ type: 'swing', result: c.type, batzooka, q: c.q });","   return c;"," };"," ","-// ---- the scene -----------------------------------------------------------------------------------------------------"," BZ.matchScene = {","   pausable: true, view: 'threequarter', input: 'custom', touch: false,","-  enter(data) {","-    const game = BZ.game;","-    const M = BZ.M || BZ.newMatchRun({ human: [true, false] });","-    BZ.M = M;","+  enter() {","+    const game = BZ.game, M = BZ.M;","     BZ.field = BZ.field || BZ.buildField();","     game.lights.enabled = BZ.park === 'moondome';","     game.lights.ambient = .55;","     M.talk = BZ.talkFor(game);","-    M.talk.say(BZ.pick(BZ.rng.fx, BZ.LINES.intro), { name: 'PA', auto: 3, modal: false });","-    if (BZ.PARKS[BZ.park].night) BZ.playSong('match'); else BZ.playSong('match');","-    M.S.top = true;","+    BZ.beginHalfIntro(M);","+    BZ.playSong('match');","   },","-  exit() { const game = BZ.game; game.lights.enabled = false; BZ.playSong(null); },","+  exit() { BZ.game.lights.enabled = false; BZ.playSong(null); },","   update(dt) { BZ.matchUpdate(BZ.game, BZ.M, dt); },","   draw(r) { BZ.matchDraw(r, BZ.M); }"," };"," ","-BZ.talkFor = game => BZ.talk && BZ.talk.game === game ? BZ.talk : (BZ.talk = Object.assign(new E.Dialog(game), { game }));","+BZ.talkFor = game => BZ.talk || (BZ.talk = new E.Dialog(game));"," ","-// Setup the lines for the team at bat and in the field, the rigs' poses, and the moment's prompt.","+// The intro card for a half: TOP or BOTTOM of an inning, with the batting team named."," BZ.beginHalfIntro = M => {","   const S = M.S;","-  M.phase = 'intro'; M.clock = 0; M.introT = 2.2;","-  M.cam = 'plate';","-  M.stamp = { text: (S.top ? 'TOP ' : 'BOTTOM ') + S.inning, color: '#ffe6a0', t: 2.2, sub: BZ.TEAMS[BZ.battingTeam(S)].name + ' bat' };","+  M.phase = 'intro'; M.clock = 0; M.introT = 2.2; M.cam = 'plate';","+  M.needNewBatter = true;","+  M.paPrevKey = BZ.halfKey(S);","+  M.stamp = { text: (S.top ? 'TOP ' : 'BOTTOM ') + BZ.ordinal(S.inning).toUpperCase(), color: '#ffe6a0', t: 2.2, sub: BZ.TEAMS[BZ.battingTeam(S)].name + ' at bat' };","+  M.swung = false; M.swing = null; M.plan = null; M.pending = null;"," };"," ","-// Each frame. The phases in order: intro, ready, windup, meter, pitch, inplay, after, final.","+// Each frame. Inputs are read here, once; the phases change the state; the rigs and the camera follow."," BZ.matchUpdate = (game, M, dt) => {","   if (!M) return;","   const S = M.S, bt = BZ.battingTeam(S), ft = BZ.fieldingTeam(S);","   const pitcherIn = M.human[ft] ? BZ.controllerInput(game, ft) : null;","   const batterIn = M.human[bt] ? BZ.controllerInput(game, bt) : null;","   M.clock += dt;","-  if (M.stamp) M.stamp.t -= dt;","-  if (M.stamp && M.stamp.t <= 0 && M.phase !== 'intro') M.stamp = null;","+  if (M.stamp) { M.stamp.t -= dt; if (M.stamp.t <= 0 && M.phase !== 'intro' && M.phase !== 'after') M.stamp = null; }","   BZ.tickSwing(M, dt);"," ","-  if (M.phase === 'intro') {","-    M.introT -= dt;","-    if (M.introT <= 0) { M.stamp = null; M.phase = 'ready'; M.clock = 0; BZ.beginPA(S); M.paPrevKey = BZ.halfKey(S); M.pitchChoice = M.pitchChoice || 'fastball'; M.aim = { lat: 0, h: 2.6 }; M.cpuPlanT = .9 + BZ.rng.fx() * .4; M.fireball = false; }","-  } else if (M.phase === 'ready') {","-    if (!M.human[ft]) {","-      if (M.clock >= M.cpuPlanT) { M.pending = null; M.plan = BZ.botPitch(S); M.phase = 'windup'; M.clock = 0; M.plan.super = BZ.TUNE && false; }","-    } else if (pitcherIn) {","-      BZ.humanPitchReady(game, M, pitcherIn, dt);","-    }","-  } else if (M.phase === 'windup') {","-    const k = Math.min(1, M.clock / .55);","-    if (M.clock >= .55) {","-      if (M.human[ft] && !M.plan.released) { M.phase = 'meter'; M.meterT = 0; }","-      else BZ.release(M, M.human[ft] ? M.meterP : M.plan.release);","-    }","-    M.windupK = k;","-  } else if (M.phase === 'meter') {","-    M.meterT += dt;","-    M.meterP = .5 + .5 * Math.sin(M.meterT * Math.PI * 2 / 1.15 - Math.PI / 2);","-    const pressed = pitcherIn && pitcherIn.pressed('confirm');","-    if (pressed || M.meterT > 2.4) BZ.release(M, M.meterP);","-  } else if (M.phase === 'pitch') {","-    BZ.pitchUpdate(game, M, dt, batterIn);","-  } else if (M.phase === 'inplay') {","-    BZ.playUpdate(game, M, dt, pitcherIn);","-  } else if (M.phase === 'after') {","-    M.afterT -= dt;","-    if (M.afterT <= 0) BZ.nextAfter(game, M);","-  } else if (M.phase === 'final') {","-    M.finalT -= dt;","-    if (M.finalT <= 0) BZ.endMatch(game, M);","+  switch (M.phase) {","+    case 'intro':","+      M.introT -= dt;","+      if (M.introT <= 0) { M.stamp = null; M.phase = 'ready'; M.clock = 0; M.cpuPlanT = .9 + BZ.rng.fx() * .4; }","+      break;","+    case 'ready':","+      if (M.needNewBatter) { BZ.beginPA(S); M.needNewBatter = false; M.paEnded = false; M.reticle = null; }","+      M.cam = 'plate';","+      if (!M.human[ft] || M.opts.attract) {","+        if (M.clock >= M.cpuPlanT) { M.plan = BZ.botPitch(S); M.phase = 'windup'; M.clock = 0; }","+      } else if (pitcherIn) BZ.humanPitchReady(game, M, pitcherIn, dt);","+      break;","+    case 'windup':","+      M.windupK = Math.min(1, M.clock / .55);","+      if (M.clock >= .55) {","+        if (M.human[ft] && !M.opts.attract) { M.phase = 'meter'; M.meterT = 0; }","+        else BZ.release(M, .5);","+      }","+      break;","+    case 'meter':","+      M.meterT += dt;","+      M.meterP = .5 + .5 * Math.sin(M.meterT * Math.PI * 2 / 1.15 - Math.PI / 2);","+      if ((pitcherIn && pitcherIn.pressed('confirm')) || M.meterT > 2.4) BZ.release(M, M.meterP);","+      break;","+    case 'pitch':","+      BZ.pitchUpdate(game, M, dt, batterIn);","+      break;","+    case 'inplay':","+      BZ.playUpdate(game, M, dt, pitcherIn);","+      break;","+    case 'after':","+      M.afterT -= dt;","+      if (M.afterT <= 0) BZ.nextAfter(game, M);","+      break;","+    case 'final':","+      M.finalT -= dt;","+      if (M.finalT <= 0) BZ.endMatch(game, M);","+      break;","   }","-","   BZ.rigsUpdate(M, dt);","-  BZ.focusCam(game, M, dt);","-  // the batter's and runners' moves, for the field view","-  M.batterRunT = M.ball || M.play ? Math.min(1, (M.batterRunT || 0) + dt / Math.max(.1, BZ.runTime())) : 0;","+  BZ.focusCam(game, M);","+  M.batterRunT = M.ball ? Math.min(1, M.batterRunT + dt / Math.max(.1, BZ.runTime())) : 0;"," };"," ","-// The pitch's key: the same for the whole half-inning, so the next change of half is seen.","-BZ.halfKey = S => S.inning + (S.top ? 't' : 'b');","-","-// The human pitcher's setup: the pitch, the aim (stick, mouse), and the wind-up with a press.","+// The human pitcher's setup: the pitch (chips, Q/E, a click), the aim (stick, or the mouse), the Fireball, and a press to","+// wind up. Clicking the pitch's chip picks it; a click anywhere else on the screen winds up."," BZ.humanPitchReady = (game, M, I, dt) => {","-  const S = M.S;","-  const plist = BZ.PITCH_IDS;","-  const idx = plist.indexOf(M.pitchChoice);","+  const S = M.S, plist = BZ.PITCH_IDS, idx = plist.indexOf(M.pitchChoice);","   if (I.pressed('prevPitch')) M.pitchChoice = plist[(idx + plist.length - 1) % plist.length];","   if (I.pressed('nextPitch')) M.pitchChoice = plist[(idx + 1) % plist.length];","   const click = game.input.clicked();","-  const chip = click ? BZ.chipAt(click[0], click[1]) : null;","+  const onChip = click ? BZ.chipAt(click[0], click[1]) : null;","   const hover = BZ.chipAt(...(game.input.pointer() || [-1, -1]));","-  if (chip) M.pitchChoice = chip;","-  else if (hover && M.clock > .05) M.pitchChoice = hover;","-  // the aim: the stick moves it; a moved mouse puts it on the pointer","-  const mv = I.move();","-  const pt = game.input.pointer();","-  if (pt && M.prevPointer && (Math.abs(pt[0] - M.prevPointer[0]) + Math.abs(pt[1] - M.prevPointer[1]) > 2)) {","+  if (onChip) M.pitchChoice = onChip;","+  else if (hover) M.pitchChoice = hover;","+  // the aim: the stick moves it; a mouse that moves puts it on the pointer","+  const pt = game.input.pointer(), mv = I.move();","+  if (pt && M.prevPointer && Math.abs(pt[0] - M.prevPointer[0]) + Math.abs(pt[1] - M.prevPointer[1]) > 2) {","     const p = BZ.plateFromScreen(pt[0], pt[1], game.W, game.H);","-    M.aim = BZ.clampAim(p.lat, p.h); M.aimTouched = true;","+    M.aim = BZ.clampAim(p.lat, p.h);","   } else if (mv[0] || mv[1]) {","     M.aim = BZ.clampAim(M.aim.lat + mv[0] * 1.8 * dt, M.aim.h - mv[1] * 1.8 * dt);","   }","   M.prevPointer = pt ? pt.slice() : null;","-  if (I.pressed('power') && S && BZ.meter[BZ.fieldingTeam(S)] >= 100) M.fireball = !M.fireball;","-  const click2 = click && !chip;","-  if (I.pressed('confirm') || click2) {","-    M.plan = null;","+  if (I.pressed('power') && BZ.meter[BZ.fieldingTeam(S)] >= 100) M.fireball = !M.fireball;","+  if (I.pressed('confirm') || (click && !onChip)) {","     M.pending = { pitch: M.pitchChoice, aimLat: M.aim.lat, aimH: M.aim.h, superPitch: M.fireball };","-    if (M.fireball) BZ.meter[BZ.fieldingTeam(S)] = 0;","-    M.phase = 'windup'; M.clock = 0; M.plan = { pendingHuman: true };","-    M.pitchChoice = M.pitchChoice;","+    if (M.fireball) { BZ.meter[BZ.fieldingTeam(S)] = 0; M.fireball = false; }","+    M.phase = 'windup'; M.clock = 0; M.prevPointer = null;","   }"," };"," "," // Pitch selection chips at the bottom-left of the screen: their rectangles for hover and click.","-BZ.chipRects = game => {","-  const H = game.H, W = game.W;","-  return BZ.PITCH_IDS.map((id, i) => ({ id, x0: 16 + i * 94, y0: H - 58, x1: 16 + i * 94 + 86, y1: H - 16 }));","-};","+BZ.chipRects = game => BZ.PITCH_IDS.map((id, i) => ({ id, x0: 16 + i * 94, y0: game.H - 58, x1: 102 + i * 94, y1: game.H - 16 }));"," BZ.chipAt = (x, y) => {","   const g = BZ.game;","   if (!g || x < 0) return null;"]},{"oldStart":204,"oldLines":381,"newStart":200,"newLines":351,"lines":["   return null;"," };"," ","-// The release: plan the pitch from the wind-up's choice and the meter's place. The pitch starts now.","+// The release: the pitch the pitcher chose, with the meter's place, goes. A CPU's plan is ready already."," BZ.release = (M, p) => {","-  const S = M.S, ft = BZ.fieldingTeam(S);","-  let plan;","+  const S = M.S;","+  let plan = M.plan;","   if (M.pending) {","     plan = BZ.planPitch({ pitch: M.pending.pitch, aimLat: M.pending.aimLat, aimH: M.pending.aimH, release: p, superPitch: M.pending.superPitch });","     M.pending = null;","-  } else plan = M.plan;","-  plan.released = true;","+  }","   M.plan = plan;","-  M.pt = 0; M.phase = 'pitch'; M.clock = 0; M.trail = [];","-  M.swung = false; M.swing = null; M.swingAt = null; M.cpuSwing = null;","+  M.pt = 0; M.phase = 'pitch'; M.clock = 0; M.trail = []; M.pitchPos = null;","+  M.swung = false; M.swing = null; M.cpuSwing = null; M.swingAt = 0;","+  // the batter: the CPU decides its swing now, unless a player is at the plate","   const bt = BZ.battingTeam(S);","   if (!M.human[bt] || M.opts.attract) {","     const sw = BZ.cpuSwing(S, plan, BZ.rng.play, M.opts.cpuLevel || BZ.TUNE.cpuLevel);","     if (sw) { M.cpuSwing = sw; M.swingAt = plan.time + sw.swingT; }","-    if (M.opts.drill && M.opts.drill.kind === 'catch') M.cpuSwing = { swingT: 0, reticle: BZ.plateLoc(plan), forced: true }, M.swingAt = plan.time;","+    if (M.drill && M.drill.kind === 'catch') { M.cpuSwing = { swingT: 0, reticle: BZ.plateLoc(plan) }; M.swingAt = plan.time; }","   }","   M.events.push({ type: 'pitch', pitch: plan.pitch, time: plan.time, miss: plan.miss, super: plan.super });"," };"," ","-// The pitch in flight: the batter's swing (his or the CPU's), and the call when it arrives.","+// The pitch in flight: the batter's swing (a player's press or the CPU's timed one), and the umpire's call on arrival."," BZ.pitchUpdate = (game, M, dt, batterIn) => {","-  const plan = M.plan, S = M.S;","+  const plan = M.plan, S = M.S, bt = BZ.battingTeam(S);","   M.pt += dt;","   const pos = BZ.pitchAt(plan, Math.min(1, M.pt / plan.time));","+  M.pitchPos = pos;","   M.trail.push({ lat: pos.lat, h: pos.h, depth: pos.depth });","   if (M.trail.length > 9) M.trail.shift();","-  M.pitchPos = pos;","-  // the human batter","-  if (!M.swung && batterIn && M.human[BZ.battingTeam(S)] && !M.opts.attract) {","-    const aimReticle = BZ.batterAim(game, M, batterIn, dt);","-    if (batterIn.pressed('confirm') || (game.input.clicked() && !BZ.chipAt(...game.input.clicked()))) {","-      const bz = !!(batterIn.pressed('power') && BZ.meter[BZ.battingTeam(S)] >= 100);","-      if (bz) BZ.meter[BZ.battingTeam(S)] = 0;","-      M.swingK = 0; M.swingBz = bz;","-      BZ.resolveSwing(M, M.pt, aimReticle, bz);","-      M.swingPhase = 'swing'; M.swingK = 0;","-      BZ.afterSwing(game, M);","+  const clickAt = game.input.clicked();","+  if (!M.swung && batterIn && !M.opts.attract) {","+    const ret = BZ.batterAim(game, M, batterIn, dt);","+    if (batterIn.pressed('confirm') || (clickAt && !BZ.chipAt(clickAt[0], clickAt[1]))) {","+      const bz = !!(batterIn.pressed('power') && BZ.meter[bt] >= 100);","+      if (bz) BZ.meter[bt] = 0;","+      BZ.afterSwing(game, M, BZ.resolveSwing(M, M.pt, ret, bz));","     }","-  } else if (!M.swung && M.cpuSwing && M.pt >= (M.swingAt || 0)) {","-    const sw = M.cpuSwing;","-    const bz = !!((M.opts.attract || M.opts.cheat) && BZ.meter[BZ.battingTeam(S)] >= 100);","-    if (bz) BZ.meter[BZ.battingTeam(S)] = 0;","-    if (sw.forced) BZ.resolveSwing(M, M.pt, sw.reticle, false), M.swing.type = M.swing.type === 'hit' ? 'hit' : M.swing.type;","-    else BZ.resolveSwing(M, M.pt, sw.reticle, bz);","-    M.swingK = 0; M.swingPhase = 'swing';","-    BZ.afterSwing(game, M);","+  } else if (!M.swung && M.cpuSwing && M.pt >= M.swingAt) {","+    const bz = !!(M.opts.attract && BZ.meter[bt] >= 100);","+    if (bz) BZ.meter[bt] = 0;","+    BZ.afterSwing(game, M, BZ.resolveSwing(M, M.pt, M.cpuSwing.reticle, bz));","   }","   if (M.phase !== 'pitch') return;","   if (M.pt >= plan.time + .3) {","     if (!M.swung) {","-      // the umpire calls it","-      const plate = BZ.plateLoc(plan);","-      const strike = BZ.inZone(plate.lat, plate.h);","-      BZ.countEvent(game, M, strike ? 'strike' : 'ball', plan);","-      BZ.afterPitch(game, M);","-    } else BZ.afterPitch(game, M);","+      const at = BZ.plateLoc(plan);","+      BZ.countEvent(game, M, BZ.inZone(at.lat, at.h) ? 'strike' : 'ball', false);","+    }","+    BZ.afterPitch(game, M);","   }"," };"," ","-// The batter's reticle: the stick moves it, the mouse puts it on the pointer, and the default is the plate's middle.","+// A player's reticle: the stick moves it, the mouse puts it on the pointer; the default is the middle of the plate."," BZ.batterAim = (game, M, I, dt) => {","-  const pt = game.input.pointer();","-  const mv = I.move();","-  if (pt && M.prevPointer && (Math.abs(pt[0] - M.prevPointer[0]) + Math.abs(pt[1] - M.prevPointer[1]) > 2)) {","+  const pt = game.input.pointer(), mv = I.move();","+  M.reticle = M.reticle || { lat: 0, h: 2.6 };","+  if (pt && M.prevPointer && Math.abs(pt[0] - M.prevPointer[0]) + Math.abs(pt[1] - M.prevPointer[1]) > 2) {","     const p = BZ.plateFromScreen(pt[0], pt[1], game.W, game.H);","     M.reticle = { lat: BZ.clamp(p.lat, -1.6, 1.6), h: BZ.clamp(p.h, .6, 4.6) };","   } else if (mv[0] || mv[1]) {","-    M.reticle = M.reticle || { lat: 0, h: 2.6 };","     M.reticle = { lat: BZ.clamp(M.reticle.lat + mv[0] * 1.6 * dt, -1.6, 1.6), h: BZ.clamp(M.reticle.h - mv[1] * 1.6 * dt, .6, 4.6) };","   }","-  M.prevPointer = pt ? pt.slice() : M.prevPointer;","-  return M.reticle || { lat: 0, h: 2.6 };","+  M.prevPointer = pt ? pt.slice() : null;","+  return M.reticle;"," };"," ","-// The swing's animation: a timer from the swing, for the rig and the bat.","+// The swing's animation timer (the rig's swing and the bat), 0.32 s."," BZ.tickSwing = (M, dt) => {","-  if (M.swingPhase === 'swing') { M.swingK = Math.min(1, (M.swingK || 0) + dt / .32); if (M.swingK >= 1) M.swingPhase = null; }","-  else if (M.swingK < 1 && M.swingK > 0) M.swingK = Math.min(1, M.swingK + dt / .32);","+  if (M.swingPhase === 'swing') {","+    M.swingK = Math.min(1, M.swingK + dt / .32);","+    if (M.swingK >= 1) M.swingPhase = null;","+  }"," };"," "," // After a swing: contact sends the ball into play; a foul or a whiff is counted here.","-BZ.afterSwing = (game, M) => {","-  const S = M.S, c = M.swing;","+BZ.afterSwing = (game, M, c) => {","+  const S = M.S, ft = BZ.fieldingTeam(S);","+  M.swing = Object.assign(M.swing, c);","   if (c.type === 'hit') {","-    M.ball = BZ.launchBall({ exit: c.exit, launch: c.launch, spray: c.spray, batzooka: c.batzooka, from: { x: BZ.HX, y: BZ.HY - 10 } });","-    M.play = new BZ.Play(S, M.ball, M.fielders[BZ.fieldingTeam(S)]);","-    for (const f of M.fielders[BZ.fieldingTeam(S)]) f.human = !!M.human[BZ.fieldingTeam(S)];","+    M.ball = BZ.launchBall({ exit: c.exit, launch: c.launch, spray: c.spray, batzooka: c.batzooka });","+    M.play = new BZ.Play(S, M.ball, M.fielders[ft]);","+    for (const f of M.fielders[ft]) f.human = !!M.human[ft] && !M.opts.attract;","     M.phase = 'inplay'; M.cam = 'field'; M.clock = 0; M.batterRunT = 0;","     BZ.sfx(c.batzooka ? 'rocket' : 'crack', { vol: c.batzooka ? .6 : 1 });","-    if (c.batzooka) BZ.sfx('fire', { vol: .3 });","-    game.hitFx(BZ.HX, BZ.HY, 0, { power: c.q || .5, textScale: 0 });","+    if (c.batzooka) BZ.sfx('fire', { vol: .4 });","     return;","   }","-  if (c.type === 'foul') { BZ.countEvent(game, M, 'foul', M.plan); BZ.afterPitch(game, M); return; }","-  BZ.countEvent(game, M, 'strike', M.plan, true);","+  if (c.type === 'foul') { BZ.countEvent(game, M, 'foul', false); BZ.afterPitch(game, M); return; }","+  BZ.countEvent(game, M, 'strike', true);   // a whiff: a swinging strike","   BZ.afterPitch(game, M);"," };"," ","-// A called or swung-at pitch: the count moves, the crowd and the umpire react, a walk or a strikeout ends the at-bat.","-BZ.countEvent = (game, M, kind, plan, swung = false) => {","+// The count moves for a called or swung-at pitch. A walk, a strikeout or the half's end finishes the plate appearance.","+// kind: 'ball' | 'strike' (called or swung at) | 'foul'. Returns the rules' event.","+BZ.countEvent = (game, M, kind, swung) => {","   const S = M.S, ft = BZ.fieldingTeam(S);","-  let ev;","-  if (kind === 'strike' || kind === 'ball') {","-    ev = BZ.pitchCount(S, kind);","-  } else ev = BZ.pitchCount(S, 'foul');","-  M.lastCount = BZ.countText(S);","-  M.outcome = Object.assign({ kind }, ev);","-  M.events.push({ type: 'call', kind, ev: ev.ev, count: M.lastCount });","-  if (kind === 'ball') { BZ.sfx('ball'); M.stamp = { text: 'BALL', color: '#7ad0ff', t: 1, sub: M.lastCount }; }","-  if (kind === 'strike') { BZ.sfx('strike'); M.stamp = { text: swung ? 'SWINGING STRIKE' : 'STRIKE', color: '#ffb020', t: 1, sub: M.lastCount }; }","-  if (kind === 'foul') { BZ.sfx('foul'); M.stamp = { text: 'FOUL', color: '#ffb020', t: 1, sub: M.lastCount }; }","-  if (ev.ev === 'k') { BZ.sfx('out'); BZ.say(M.talk, 'k'); M.stamp = { text: 'STRIKE THREE', color: '#ff6a5a', t: 1.8, sub: 'OUT' }; BZ.meter[ft] = Math.min(100, BZ.meter[ft] + 20); M.events.push({ type: 'k' }); }","+  const ev = BZ.pitchCount(S, kind === 'ball' ? 'ball' : kind === 'strike' ? 'strike' : 'foul');","+  const count = BZ.countText(S);","+  M.events.push({ type: 'call', kind, ev: ev.ev, count });","+  if (kind === 'ball') { BZ.sfx('ball'); M.stamp = { text: 'BALL', color: '#7ad0ff', t: 1, sub: count }; if (BZ.rng.fx() < .3) BZ.say(M.talk, 'ball'); }","+  if (kind === 'strike') { BZ.sfx('strike'); M.stamp = { text: swung ? 'SWINGING STRIKE' : 'STRIKE', color: '#ffb020', t: 1, sub: count }; if (!swung && BZ.rng.fx() < .5) BZ.say(M.talk, 'strike'); }","+  if (kind === 'foul') { BZ.sfx('foul'); M.stamp = { text: 'FOUL', color: '#ffb020', t: 1, sub: count }; if (BZ.rng.fx() < .3) BZ.say(M.talk, 'foul'); }","+  if (kind === 'strike' && M.drill && M.drill.kind === 'strikes') M.drill.got = Math.min(M.drill.goal, M.drill.got + 1);","+  if (ev.ev === 'k') {","+    BZ.sfx('out'); BZ.say(M.talk, 'k');","+    M.stamp = { text: 'STRIKE THREE', color: '#ff6a5a', t: 1.8, sub: 'OUT' };","+    BZ.meter[ft] = Math.min(100, BZ.meter[ft] + 20);","+  }","   if (ev.ev === 'walk') { BZ.sfx('confirm'); BZ.say(M.talk, 'walk'); M.stamp = { text: 'BALL FOUR', color: '#7ad0ff', t: 1.8, sub: 'WALK' }; }","-  if (kind === 'strike' && M.drill && M.drill.kind === 'strikes' && M.plan && !M.plan.pendingHuman) { M.drill.got =