]++;\n  BZ.addRuns(S, t, runs);\n  return runs;\n};\n\n// A caught ball: an out. A deep fly lets the runner on third tag up and score.\nBZ.caughtFly = (S, deep) => {\n  const t = BZ.battingTeam(S);\n  let runs = 0;\n  if (deep && S.bases[2]) { runs = 1; S.bases[2] = null; }\n  BZ.addRuns(S, t, runs);\n  return Object.assign(BZ.recordOut(S, 'fly'), { runs });\n};\n\n// The play after a fielded ground ball. target: 0 (first), 1 (second) or 2 (third) is where the throw goes.\n// batterOut: the throw beat the batter to first. runnerOut: the throw beat the forced runner to that base.\nBZ.groundPlay = (S, target, { batterOut, runnerOut }) => {\n  const t = BZ.battingTeam(S);\n  if (target === 0 && batterOut) {\n    const o = BZ.recordOut(S, 'ground');\n    return Object.assign(o, { runs: 0 });\n  }\n  if (target > 0 && runnerOut) {\n    S.bases[target - 1] = null;\n    const o = BZ.recordOut(S, 'force');\n    if (o.end) return Object.assign(o, { runs: 0 });\n  }\n  const runs = BZ.forceAdvance(S);\n  BZ.addRuns(S, t, runs);\n  return { ev: runnerOut || batterOut ? 'forceOut' : 'safe', runs, batter: S.batter };\n};\n\n// The line score as rows of text, for the results screen.\nBZ.lineScore = S => {\n  const cols = Math.max(S.innings, S.line[0].length, S.line[1].length);\n  const row = team => Array.from({ length: cols }, (_, i) => i < S.line[team].length ? String(S.line[team][i]) : (i < S.inning - (team === 1 && !S.top ? 0 : 1) || (team === 1 && S.top ? false : i < S.inning) ? '0' : ''));\n  return { cols, away: row(0), home: row(1), R: S.score.slice(), H: S.hits.slice() };\n};\n","structuredPatch":[{"oldStart":1,"oldLines":36,"newStart":1,"newLines":35,"lines":[" // The rules engine: pure state and transitions, no drawing, no input. A match is one object (BZ.newMatch); each call"," // below moves it on and returns what happened, so the scene, the commentary and the tests all read the same events."," // Kept from baseball: balls, strikes, outs, the four bases with forces, innings, the walk, the strikeout, extra innings,","-// the walk-off and the rule that the home team does not bat in the last half when it is ahead.","+// the walk-off, and the rule that the home team does not bat in the last half when it is ahead."," // Simplified: runners never steal or tag up (a deep caught fly sends the runner on third home), one throw decides a","-// play, and a double play is a force at second with the batter beaten to first by the same throw.","+// play, and a runner is only forced by the batter (no double-play turns)."," BZ.newMatch = (o = {}) => ({","   innings: o.innings || 3, inning: 1, top: true, outs: 0, balls: 0, strikes: 0,","-  bases: [null, null, null],                  // what sits on 1B, 2B, 3B: the runner's name, or null","+  bases: [null, null, null],                  // who is on 1B, 2B, 3B: the runner's name, or null","   score: [0, 0],","   line: [[], []],                              // runs per inning, per team","   hits: [0, 0], hr: [0, 0], k: [0, 0], walks: [0, 0], errors: [0, 0],","-  lineup: [0, 0],                              // whose turn to bat, per team (0..8)","+  lineup: [0, 0],                              // the batting order's place, per team (0..8)","   over: false, walkoff: false, extra: false,","-  batter: null                                 // the batter's name, filled in by batterFor","+  batter: null                                 // the batter's name"," });"," BZ.battingTeam = S => S.top ? 0 : 1;"," BZ.fieldingTeam = S => 1 - BZ.battingTeam(S);"," BZ.batterFor = (S, team = BZ.battingTeam(S)) => BZ.TEAMS[team].players[S.lineup[team] % 9];","-BZ.countText = S => S.balls + '-' + S.strikes;"," ","-// Runs for a team this inning: the line score keeps them by inning.","+// Runs for a team this inning, by inning for the line score. A home team that takes the lead in its last chance walks it off."," BZ.addRuns = (S, team, n) => {","   if (n <= 0) return 0;","   S.score[team] += n;","   const L = S.line[team];"