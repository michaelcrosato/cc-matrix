,"-  if (res.kind === 'caught') { text = 'CAUGHT'; sub = res.deep ? 'deep fly, runner tags up' : 'fly out'; talkKey = 'caught'; }","-  else if (res.kind === 'hit') {","-    const types = { single: ['SINGLE', '#ffe6a0', 'single'], double: ['DOUBLE', '#ffe6a0', 'double'], triple: ['TRIPLE', '#ffb020', 'triple'], hr: ['HOME RUN', '#ffb020', 'hr'] };","-    const [t, c, k] = types[res.type];","-    text = t; color = c; talkKey = k;","-    const gain = { single: .5, double: 1, triple: 1.3, hr: 2 }[res.type] * BZ.TUNE.meterGain;","-    BZ.meter[bt] = Math.min(100, BZ.meter[bt] + gain);","-    sub = res.type === 'hr' ? BZ.fmtFt(M.ball.homer ? M.ball.crossDist * BZ.FT : M.ball.landDist * BZ.FT) : '';","-    if (M.drill && M.drill.kind === 'hit' && res.type !== 'hr' && M.drill) M.drill.got = Math.min(M.drill.goal, M.drill.got + 1);","-    if (M.drill && M.drill.kind === 'homer' && res.type === 'hr') M.drill.got = Math.min(M.drill.goal, M.drill.got + 1);","-    if (M.drill && M.drill.kind === 'hit' && res.type === 'hr') M.drill.got = Math.min(M.drill.goal, M.drill.got + 1);","-    if (res.type === 'hr') BZ.sfx('fanfare'), BZ.sfx('cheer');","+  const S = M.S, bt = BZ.battingTeam(S), res = M.play.result;","+  const ball = M.ball;","+  let text = 'OUT', color = '#ff6a5a', sub = '', key = null;","+  if (res.kind === 'foul') {","+    BZ.countEvent(game, M, 'foul', false);","+    M.play = null; M.ball = null;","+    BZ.afterPitch(game, M);","+    return;","+  }","+  if (res.kind === 'caught') {","+    text = 'CAUGHT'; sub = res.deep ? 'deep fly: the runner tags up' : 'fly out'; key = 'caught';","+    BZ.sfx('out');","+    if (M.drill && M.drill.kind === 'catch') M.drill.got = Math.min(M.drill.goal, M.drill.got + 1);","+  } else if (res.kind === 'hit') {","+    const T = { single: ['SINGLE', '#ffe6a0'], double: ['DOUBLE', '#ffe6a0'], triple: ['TRIPLE', '#ffb020'], hr: ['HOME RUN', '#ffb020'] }[res.type];","+    text = T[0]; color = T[1]; key = res.type;","+    BZ.meter[bt] = Math.min(100, BZ.meter[bt] + ({ single: .5, double: 1, triple: 1.3, hr: 2 }[res.type]) * BZ.TUNE.meterGain);","+    if (res.type === 'hr' && ball) sub = Math.round(ball.homer ? ball.crossDist : ball.landDist) + ' FT' + (ball.batzooka ? ' · BATZOOKA' : '');","+    if (res.type === 'hr') { BZ.sfx('fanfare'); BZ.sfx('cheer'); if (ball) game.particles.explosion(ball.x, ball.y, 4, 1.2); }","     else BZ.sfx('cheer', { vol: .5 });","-    if (res.type === 'hr' && M.ball) game.particles.explosion(M.ball.x, M.ball.y, 4, 1.2);","+    if (M.drill && M.drill.kind === 'hit' && res.type !== undefined) M.drill.got = Math.min(M.drill.goal, M.drill.got + 1);","+    if (M.drill && M.drill.kind === 'homer' && res.type === 'hr' && ball && ball.batzooka) M.drill.got = Math.min(M.drill.goal, M.drill.got + 1);","   } else if (res.kind === 'ground') {","-    if (res.batterOut) { text = 'OUT AT FIRST'; talkKey = 'groundOut'; }","-    else if (res.runnerOut) { text = 'FORCE OUT'; talkKey = 'forceOut'; }","-    else { text = 'SAFE'; color = '#7ad06a'; talkKey = 'safe'; }","-    if (res.r && res.r.runs) sub = res.r.runs + (res.r.runs > 1 ? ' runs score' : ' run scores');","-    if (res.kind === 'ground' && (text === 'SAFE')) BZ.sfx('confirm');","+    if (res.batterOut) { text = 'OUT AT FIRST'; key = 'groundOut'; BZ.sfx('out'); }","+    else if (res.runnerOut) { text = 'FORCE OUT'; key = 'forceOut'; BZ.sfx('out'); }","+    else { text = 'SAFE'; color = '#7ad06a'; key = 'safe'; BZ.sfx('confirm'); }","+    if (res.r && res.r.runs) sub = res.r.runs + (res.r.runs > 1 ? ' RUNS SCORE' : ' RUN SCORES');","   }","-  if (res.kind === 'caught' || (res.kind === 'ground' && res.batterOut)) { BZ.sfx('out'); }","-  if (res.kind === 'hit' || res.kind === 'ground' && res.r && res.r.runs) BZ.score ||= 0;","-  if (talkKey) BZ.say(M.talk, talkKey);","-  M.stamp = { text, color, t: 1.9, sub };","-  M.events.push({ type: 'result', kind: res.kind, text, runs: (res.runs || (res.r && res.r.runs) || 0) });","+  if (key) BZ.say(M.talk, key);","+  M.stamp = { text, color, t: 2, sub };","+  M.events.push({ type: 'result', kind: res.kind, text, S_outs: S.outs });","   M.play = null; M.ball = null; M.swing = null;","-  M.paEnded = true;","-  if (res.kind === 'hit' && M.drill && M.drill.kind === 'catch') { /* the catch drill counts catches, not hits */ }","-  if (res.kind === 'caught' && M.drill && M.drill.kind === 'catch') M.drill.got = Math.min(M.drill.goal, M.drill.got + 1);","-  if (S.over) { M.paOver = { ev: 'gameOver' }; }","-  M.phase = 'after'; M.afterT = 2.0; M.clock = 0;","+  M.paEnded = true; M.needNewBatter = true;","+  M.phase = 'after'; M.clock = 0; M.afterT = 2.1;"," };"," ","-// Move to the next thing after a play or a count: the next pitch, the next half, or the final.","+// The next thing after a count or a play: the final, the change of half, or the next pitch (the same batter, or the next)."," BZ.nextAfter = (game, M) => {","   const S = M.S;","   M.stamp = null;","-  if (S.over) { M.phase = 'final'; M.finalT = 3.2; M.clock = 0; BZ.playSong('results'); const walk = S.walkoff; if (walk) BZ.say(M.talk, 'walkoff'); else BZ.say(M.talk, 'over'); return; }","-  const key = BZ.halfKey(S);","-  if (key !== M.paPrevKey) { M.paPrevKey = key; BZ.beginHalfIntro(M); return; }","-  M.phase = 'ready'; M.clock = 0; BZ.beginPA(S); M.cpuPlanT = .9 + BZ.rng.fx() * .4; M.fireball = false; M.cam = 'plate';","-  M.swung = false; M.swing = null; M.trail = []; M.plan = null; M.reticle = null; M.prevPointer = null;","-  M.paDone = false; M.paEnded = false;","+  if (S.over) {","+    M.phase = 'final'; M.finalT = 3.4; M.clock = 0; M.cam = 'plate';","+    BZ.playSong('results');","+    BZ.say(M.talk, S.walkoff ? 'walkoff' : 'over');","+    return;","+  }","+  if (BZ.halfKey(S) !== M.paPrevKey) { BZ.beginHalfIntro(M); return; }","+  M.paEnded = false;","+  M.phase = 'ready'; M.clock = 0; M.cpuPlanT = .9 + BZ.rng.fx() * .4; M.fireball = false;","+  M.cam = 'plate'; M.swung = false; M.swing = null; M.trail = []; M.plan = null; M.pitchPos = null;"," };"," ","-// Human controls for the moment: the release meter is the pitcher's press; at the plate the swing is a press.","+// The match is over: its state goes to the results screen."," BZ.endMatch = (game, M) => {","   BZ.M = M;","-  game.go('results', { S: M.S, drill: M.drill, opts: M.opts, events: M.events.length });","+  BZ.playSong(null);","+  game.go('results', { S: M.S, drill: M.drill, opts: M.opts });"," };"," ","-// The rigs: each player's pose from the state (wind-up, swing, the stance, the runners on the bases, the fielders' moves).","+// The rigs' poses from the state: the wind-up and release, the swing, the stance, the runners on the bases, the fielders."," BZ.rigsUpdate = (M, dt) => {","   const S = M.S, bt = BZ.battingTeam(S), ft = BZ.fieldingTeam(S);","   for (const t of [0, 1]) {","     const R = M.rigs[t];","-    for (const role of BZ.ROLES) {","-      const f = M.fielders[t].find(x => x.role === role);","-      const st = { x: f.x, y: f.y, z: 0, vx: 0, vy: 0, facing: f.face || 0 };","-      if (role === 'P' && t === ft && M.phase === 'windup') st.attack = E.move('overhead', M.windupK || 0);","-      if (role === 'P' && t === ft && M.phase === 'pitch') st.attack = E.move('overhead', 1, 'recover');","-      if (role === 'C') st.pose = 'crouch';","-      R.fielders[role].update(dt, st);","+    for (const f of M.fielders[t]) {","+      const st = { x: f.x, y: f.y, z: 0, facing: f.face || 0, vx: f.vx || 0, vy: f.vy || 0 };","+      if (t === ft && f.role === 'P') {","+        if (M.phase === 'windup' || M.phase === 'meter') st.attack = E.move('overhead', M.phase === 'windup' ? M.windupK : .5);","+        else if (M.phase === 'pitch') st.attack = E.move('overhead', 1, 'recover');","+      }","+      if (f.role === 'C') st.pose = 'crouch';","+      R.fielders[f.role].update(dt, st);","     }","-    const br = R.batter;","     const bstate = { x: 0, y: 0, z: 0, facing: Math.PI / 2 };","-    if (t === bt && M.swingPhase === 'swing') bstate.attack = E.move('slash', M.swingK || 0);","+    if (t === bt && M.swingPhase === 'swing') bstate.attack = E.move('slash', M.swingK);","     else bstate.stance = 'ready';","-    br.update(dt, bstate);","-    R.runners.forEach((rr, i) => {","-      const on = S.bases[i] && t === bt && (M.ball || M.play);","-      rr.update(dt, { x: 0, y: 0, z: 0, facing: 0, stance: 'ready', pose: on ? undefined : 'wave' });","-    });","+    R.batter.update(dt, bstate);","+    R.runners.forEach((rr, i) => rr.update(dt, { x: 0, y: 0, z: 0, facing: 0, stance: 'ready' }));","   }"," };"," ","-BZ.rigPitchStance = (M, _cheer) => { /* poses are set in rigsUpdate from the phase */ };","-","-// The camera: the plate's view has no camera; in the field, it follows the play's ball, or the home plate.","-BZ.focusCam = (game, M, dt) => {","+// The camera: the Plate Cam has none; the field follows the ball, or the plate while nothing is in play.","+BZ.focusCam = (game, M) => {","   if (M.cam !== 'field') return;","   const b = M.ball;","-  const tx = b ? b.x : BZ.HX, ty = b ? b.y - 100 : BZ.HY - 260, tz = b ? b.z : 0;","-  game.focus(tx, ty, tz * .4);","+  if (b) game.focus(b.x, b.y - 90, b.z * .4);","+  else game.focus(BZ.HX, BZ.HY - 260, 0);"," };"," ","-// The draw: the Plate Cam for the duel, the field for the play.","+// The draw: the Plate Cam for the duel, the field for the play; then the HUD over both."," BZ.matchDraw = (r, M) => {","   if (!M) return;","-  const W = r.W, H = r.H, S = M.S;","-  const park = BZ.PARKS[BZ.park];","-  if (M.cam === 'field' && M.ball) {","-    BZ.drawField(r, M);","-  } else if (M.cam === 'field') {","-    BZ.drawField(r, M);","-  } else {","+  const W = r.W, H = r.H, S = M.S, park = BZ.PARKS[BZ.park];","+  if (M.cam === 'field') BZ.drawField(r, M);","+  else {","     r.sky(park.night ? ['#060818', '#2a2a5a'] : park.sky);","+    const ft = BZ.fieldingTeam(S), bt = BZ.battingTeam(S);","     r.overlay(g => {","       BZ.drawPlateGround(g, W, H, park);","       BZ.drawZone(g, W, H);","-      BZ.drawPlatePlayers(g, W, H, { view: r.view, pitcher: M.rigs[BZ.fieldingTeam(S)].fielders.P, catcher: M.rigs[BZ.fieldingTeam(S)].fielders.C, batter: M.rigs[BZ.battingTeam(S)].batter });","+      BZ.drawPlatePlayers(g, W, H, { view: r.view, pitcher: M.rigs[ft].fielders.P, catcher: M.rigs[ft].fielders.C, batter: M.rigs[bt].batter });","       if (M.plan && M.phase === 'pitch' && M.pitchPos) BZ.drawPitchBall(g, W, H, M.plan, Math.min(1, M.pt / M.plan.time), M.trail);","       if (M.phase === 'ready' || M.phase === 'windup' || M.phase === 'meter') BZ.drawAimReticle(g, W, H, M);","-      if (M.phase === 'pitch' && !M.swung) { /* the batter's reticle while the ball comes in */ BZ.drawBatterReticle(g, W, H, M); }","-      if (M.swing && M.swing.type) BZ.drawBat(g, W, H, { swing: M.swingK || 0, reticle: M.swing.reticle || { lat: 0, h: 2.6 } });","+      if (M.phase === 'pitch' && !M.swung && M.human[bt]) BZ.drawBatterReticle(g, W, H, M);","+      if (M.swing && M.swing.type && M.swingPhase) BZ.drawBat(g, W, H, { swing: M.swingK, reticle: M.swing.reticle });","     });","   }","   r.overlay(g => BZ.drawHud(g, r, M));","   if (M.talk) M.talk.draw(r);"," };"," ","-// The field view: the TileMap, the fielders, the runners, the ball, and the bases clickable for the throw.","+// The field view: the TileMap, the fielders, the runners, the batter's run and the ball, with the bases clickable."," BZ.drawField = (r, M) => {","-  const S = M.S;","+  const S = M.S, ft = BZ.fieldingTeam(S), bt = BZ.battingTeam(S);","   BZ.field.drawFloor(r);","   BZ.field.queueWalls(r);","-  const ft = BZ.fieldingTeam(S), bt = BZ.battingTeam(S);","-  const R = M.rigs[ft];","   for (const f of M.fielders[ft]) {","-    const rig = R.fielders[f.role];","+    const rig = M.rigs[ft].fielders[f.role];","     r.shadow(f.x, f.y, 6, .3, undefined, 0);","     r.actor(f.x, f.y, 0, (g, ox, oy) => rig.draw(g, ox, oy, r.view));","   }","-  BZ.bases().forEach((b, i) => { M.basePx[i] = r.w(b.x, b.y, 0); });","-  // the runners and the batter","-  BZ.bases().slice(0, 3).forEach((b, i) => {","+  const bases = BZ.bases();","+  bases.forEach((b, i) => { M.basePx[i] = r.w(b.x, b.y, 0); });","+  bases.slice(0, 3).forEach((b, i) => {","     if (S.bases[i]) { const rr = M.rigs[bt].runners[i]; r.actor(b.x, b.y, 0, (g, ox, oy) => rr.draw(g, ox, oy, r.view)); }","   });","-  if (M.batterRunT > 0 && M.batterRunT < 1) {","-    const p = BZ.bases()[0], x = BZ.lerp(BZ.HX, p.x, M.batterRunT), y = BZ.lerp(BZ.HY - 10, p.y, M.batterRunT);","+  if (M.ball && M.batterRunT > 0 && M.batterRunT < 1) {","+    const p = bases[0], x = BZ.lerp(BZ.HX, p.x, M.batterRunT), y = BZ.lerp(BZ.HY - 10, p.y, M.batterRunT);","     r.actor(x, y, 0, (g, ox, oy) => M.rigs[bt].batter.draw(g, ox, oy, r.view));","   }","   if (M.ball) {","     const b = M.ball;","     r.shadow(b.x, b.y, 4, .45, undefined, 0);","-    const sx = b.z > 0 ? b.z : 0;","     r.sprite(b.x, b.y, b.z + 4, BZ.BALL_SPR, { glow: .3 });","-    if (sx > 0) {/* the shadow shows the height */}","   }","-  if (M.play && M.play.phase === 'fielded') {","-    const f = M.play.holder;","-    if (f) r.decal(() => r.groundDisc(f.x, f.y, 9, '#ffffff55'));","-  }"," };"," ","-// The ball's sprite: a white ball with its seams, drawn once.","+// The ball's sprite: a white ball with a red seam, drawn once."," BZ.BALL_SPR = E.sprite(['.www.', 'wwrww', 'wrwrw', 'wwrww', '.www.'], { w: '#f8f8f0', r: '#c83a3a' }, 2);"," ","-// The HUD for the match: the scorebug, the count, the pitch chips, the meters, the prompts.","+// The HUD for the match: the scorebug, the pitch chips, the meters, the release meter, the stamp and the prompt."," BZ.drawHud = (g, r, M) => {","   const S = M.S, W = r.W, H = r.H;","   BZ.drawScorebug(g, S, 16, 16);","-  if (M.phase === 'ready' && M.human[BZ.fieldingTeam(S)]) BZ.drawChips(g, M, H);","   const bt = BZ.battingTeam(S), ft = BZ.fieldingTeam(S);","-  if (M.human[bt]) BZ.drawBatzookaMeter(g, W - 170, H - 40, 150, BZ.meter[bt], 'BATZOOKA', BZ.meter[bt] >= 100);","-  if (M.human[ft]) BZ.drawBatzookaMeter(g, W - 170, H - 72, 150, BZ.meter[ft], 'FIREBALL', BZ.meter[ft] >= 100 || M.fireball);","+  if (M.phase === 'ready' && M.human[ft]) BZ.drawChips(g, M);","+  if (M.human[bt]) BZ.drawBatzookaMeter(g, W - 178, H - 40, 150, BZ.meter[bt], 'BATZOOKA', BZ.meter[bt] >= 100);","+  if (M.human[ft]) BZ.drawBatzookaMeter(g, W - 178, H - 74, 150, BZ.meter[ft], 'FIREBALL', BZ.meter[ft] >= 100 || M.fireball);","   if (M.phase === 'meter') {","-    BZ.drawMeter(g, W / 2 - 90, H * .78, 180, M.meterP);","-    BZ.text(g, BZ.prompt('confirm', 'RELEASE'), W / 2 - 90, H * .78 - 22, '#ffffff', { align: 'center', scale: 1.6 });","+    BZ.drawMeter(g, W / 2 - 90, H * .72, 180, M.meterP);","+    BZ.text(g, BZ.prompt('confirm', 'RELEASE'), W / 2, H * .72 - 26, '#ffffff', { align: 'center', scale: 1.6 });","   }","   if (M.stamp) BZ.drawStamp(g, W, H, M.stamp, M.stamp.color, M.stamp.sub);","   if (M.drill) BZ.text(g, BZ.drillText(M), W / 2, 14, '#ffe6a0', { align: 'center', scale: 1.4 });","-  BZ.drawPrompt(g, r, M);","+  BZ.drawPrompt(g, W, H, M);"," };"," "," BZ.drillText = M => {","-  const d = M.drill;","-  const names = { strikes: 'THROW STRIKES', hit: 'PUT ONE IN PLAY', catch: 'CATCH A FLY', homer: 'HIT A HOMER' };","-  return names[d.kind] + '  ' + d.got + '/' + d.goal;","+  const names = { strikes: 'THROW STRIKES', hit: 'PUT ONE IN PLAY', catch: 'CATCH A FLY', homer: 'HIT A HOMER WITH THE BATZOOKA' };","+  return names[M.drill.kind] + '   ' + M.drill.got + '/' + M.drill.goal;"," };"," ","-BZ.drawChips = (g, M, H) => {","-  BZ.chipRects(BZ.game).forEach((c, i) => {","-    const on = c.id === M.pitchChoice;","+// The pitch chips: the one picked is lit. Hover moves to it; a click picks it.","+BZ.drawChips = (g, M) => {","+  for (const c of BZ.chipRects(BZ.game)) {","+    const on = c.id === M.pitchChoice, P = BZ.PITCHES[c.id];","     E.ui.box(g, c.x0, c.y0, c.x1 - c.x0, c.y1 - c.y0, { bg: on ? ['#ffe6a0', '#c8a060'] : ['#1a1d2a', '#0b0d16'], border: on ? '#ffffff' : '#c8a060', alpha: .92 });","-    const P = BZ.PITCHES[c.id];","     BZ.text(g, P.name, c.x0 + 6, c.y0 + 6, on ? '#1a1020' : '#ffffff', { scale: 1.1, shadow: null });","-    BZ.text(g, P.tag, c.x0 + 6, c.y0 + 20, on ? '#1a1020' : '#c8d0f0', { scale: 1 });","-  });","+    BZ.text(g, P.tag + (c.id === 'fastball' ? '' : ''), c.x0 + 6, c.y0 + 22, on ? '#1a1020' : '#c8d0f0', { scale: 1, shadow: null });","+  }"," };"," ","-// The prompt line at the bottom: what this player does now, on the device used last.","-BZ.drawPrompt = (g, r, M) => {","-  const S = M.S, W = r.W, H = r.H;","-  const bt = BZ.battingTeam(S), ft = BZ.fieldingTeam(S);","+// The prompt line at the bottom: what this player does now, with the label for their device.","+BZ.drawPrompt = (g, W, H, M) => {","+  const S = M.S, bt = BZ.battingTeam(S), ft = BZ.fieldingTeam(S);","   let line = '';","-  if (M.phase === 'ready' && M.human[ft]) line = BZ.prompt('confirm', 'WIND UP') + '    ' + BZ.prompt('prevPitch', '/ ') + '  ' + 'PICK A PITCH   ' + BZ.prompt('power', 'FIREBALL WHEN FULL');","-  else if (M.phase === 'pitch' && M.human[bt] && !M.swung) line = BZ.prompt('confirm', 'SWING') + '    ' + BZ.prompt('power', 'BATZOOKA WHEN FULL') + '    STICK AIMS THE BAT';","-  else if (M.phase === 'inplay' && M.human[ft]) line = BZ.prompt('confirm', 'DIVE') + '    STICK RUNS    ' + (M.play && M.play.phase === 'fielded' ? 'UP 2ND · LEFT 3RD · RIGHT 1ST' : '');","-  else if (M.phase === 'intro') line = '';","-  if (line) E.ui.box(g, W / 2 - (line.length * 3.4 + 16), H - 26, line.length * 6.8 + 32, 20, { bg: ['#101420', '#060810'], border: '#c8a060', alpha: .8 }), BZ.text(g, line, W / 2, H - 20, '#ffffff', { align: 'center', scale: 1.2, shadow: null });","+  if (M.phase === 'ready' && M.human[ft]) line = BZ.prompt('confirm', 'WIND UP') + '   ' + BZ.keys('prevPitch', 'nextPitch') + ' PITCH   STICK AIMS   ' + BZ.prompt('power', 'FIREBALL WHEN FULL');","+  else if (M.phase === 'pitch' && M.human[bt] && !M.swung) line = BZ.prompt('confirm', 'SWING') + '   STICK AIMS THE BAT   ' + BZ.prompt('power', 'BATZOOKA WHEN FULL');","+  else if (M.phase === 'inplay' && M.human[ft]) line = BZ.prompt('confirm', 'DIVE') + '   STICK RUNS   ' + (M.play && M.play.phase === 'fielded' ? 'UP 2ND   LEFT 3RD   RIGHT 1ST' : '');","+  if (line) {","+    const w = line.length * 6.4 + 28;","+    E.ui.box(g, W / 2 - w / 2, H - 26, w, 20, { bg: ['#101420', '#060810'], border: '#c8a060', alpha: .85 });","+    BZ.text(g, line, W / 2, H - 20, '#ffffff', { align: 'center', scale: 1.2, shadow: null });","+  }"," };"," ","-// The aim: the pitcher's target and the batter's reticle, in the plate's space.","+// Two keys' labels as one: \"Q/E\".","+BZ.keys = (a, b) => (BZ.game.input.label(a) || '') + '/' + (BZ.game.input.label(b) || '');","+","+// The aim: the pitcher's target on the plate's plane."," BZ.drawAimReticle = (g, W, H, M) => {","   const p = BZ.project(M.aim.lat, M.aim.h, 0, W, H);","-  const miss = 6 * (BZ.releaseError(M.meterP || .5) * BZ.TUNE.aimError);","   E.px.disc(g, p.x, p.y, Math.max(3, 2 * p.s), '#ffffff55');","   E.px.disc(g, p.x, p.y, 2, '#ffe6a0');"," };","+","+// The batter's reticle: the bat's head, sized by the bat's reach."," BZ.drawBatterReticle = (g, W, H, M) => {","   const ret = M.reticle || { lat: 0, h: 2.6 };","   const p = BZ.project(ret.lat, ret.h, 0, W, H);","   E.px.disc(g, p.x, p.y, Math.max(3, BZ.TUNE.reach * p.s), '#ffe6a040');","   E.px.disc(g, p.x, p.y, 2, '#ffe6a0');"," };","-","-// The meter's marker for the release, a swing's bat, and the umpire's booth are drawn by the view.","-BZ.drawSwing = () => {};","-","-// Human batter reticle is the bat's head (the reticle), and the release happens at the top of the meter.","-BZ.sceneFor = () => BZ.matchScene;"]}],"originalFile":"// The match: the scene that plays innings. It owns the phases of a plate appearance (setup, windup, release, the pitch,\n// the swing, the play, the count), the input of whoever controls each side (a player or the CPU), the two views (the\n// Plate Cam for the duel, the field for the play), the HUD and the commentary. The rules and the physics are the pure\n// modules (10 to 14); this scene only asks them what happens and shows it.\n//\n// Control: team 1 (the home team) is player 1; team 0 (the visitors) is player 2 when one has joined, else the CPU.\n// On the defense the pitcher is the team's controller; at the plate the batter is. A player with both jobs gets both.\nBZ.LINES = {\n  intro: ['Ladies and gentlemen, the Megamax Dome Stars take the field.', 'Good afternoon, folks. The corn is high and the beer is cold.'],\n  ball: ['Ball one, the crowd says a little something about that.', 'That one was outside. Way outside.'],\n  strike: ['Strike, and the scoreboard is blinking at him.', 'Right down the middle! Hooray!'],\n  foul: ['Foul ball! Into the corn!', 'That one went foul, and somebody in row nine is wearing it.'],\n  k: ['Strike three! He is out, and he is going home to tell the dog.', 'Struck him out looking! The dugout is crying.'],\n  walk: ['Four balls. The pitcher has forgotten the way to the plate.'],\n  single: ['A single, and that one has a little spin on it!', 'Base hit! The fans are tossing their hats!'],\n  double: ['A double into the gap! Two bases and a cloud of dust!'],\n  triple: ['A triple! He is going like the corn on a windy day!'],\n  hr: ['WAY BACK! WAY BACK! That one is GONE!', 'Home run! Home run! The Batzooka has spoken!'],\n  caught: ['Caught on the warning track! Oh my, what a catch!', 'Hauled it in! That fly is an out, folks.'],\n  groundOut: ['Grounder to the infield, and the throw beats him. Out!', 'Nimble work in the infield. He is out.'],\n  forceOut: ['Out at second! The runner was a bit slow on the basepaths.', 'The force is on, and he is out at second.'],\n  safe: ['Safe! By a whisker!', 'He beat the throw. Safe at first.'],\n  over: ['That is the ballgame! Thank you for coming out to Kernel Field!'],\n  walkoff: ['A walk-off! The home crowd goes wild! Bring the cows out!']\n};\n\nBZ.say = (talk, key, extra = '') => {\n  const pool = BZ.LINES[key];\n  if (!pool || !talk) return;\n  const line = BZ.pick(BZ.rng.fx, pool) + (extra ? ' ' + extra : '');\n  talk.say(line, { name: 'PA', auto: 2.8, modal: false });\n  if (key === 'hr' || key === 'k' || key === 'over' || key === 'walkoff') BZ.babble(line, { pitch: 230, rate: .07, vol: .12 });\n};\n\n// Set up a match from the options: { innings, home: 1, controllers: { 0: 'cpu' | 'human', 1: ... }, drill, attract, seed }.\nBZ.newMatchRun = (opts = {}) => {\n  const S = BZ.newMatch({ innings: opts.innings || BZ.TUNE.innings });\n  const rigs = [BZ.makeRigs(BZ.TEAMS[0]), BZ.makeRigs(BZ.TEAMS[1])];\n  return {\n    opts, S, rigs,\n    human: [!!opts.human[0], !!opts.human[1]],\n    phase: 'intro', clock: 0, pt: 0,\n    fielders: [BZ.makeFielders(), BZ.makeFielders()],\n    plan: null, pending: null, pitchChoice: 'fastball', aim: { lat: 0, h: 2.6 }, aimTouched: false,\n    fireball: false, meterT: 0, meterP: .5, swing: null, swung: false, swingK: 0, swingAt: null, cpuSwing: null,\n    play: null, ball: null, cam: 'plate', trail: [], stamp: null, paPrevKey: null, outcome: null,\n    basePx: [], drill: opts.drill ? { kind: opts.drill.kind, goal: opts.drill.goal, got: 0 } : null,\n    events: [], introT: 2.2, afterT: 1.6, finalT: 3.2, prevAim: null, dirPick: null, lastCount: '0-0',\n    batterRunT: 0, humanPitchedPlans: [], resultLine: ''\n  };\n};\n\n// Start a match in the scene. Called from the menus (and the attract, and the lessons).\nBZ.startMatch = (game, opts) => {\n  BZ.M = BZ.newMatchRun(opts);\n  BZ.seedMatch(opts.seed || 20261104);\n  BZ.M.S.batter = null;\n  game.go('match', opts);\n};\n\n// The scene's input, per controller. A player's input object is game.players[n].\nBZ.controllerInput = (game, team) => {\n  if (team === 1) return game.players[0];\n  return game.players[1] || null;\n};\n\n// ---- the swing ----------------------------------------------------------------------------------------------------\n// Resolve a swing at the pitch's clock: contact, a foul or a whiff. The batter's aim is the reticle.\nBZ.resolveSwing = (M, swingPt, reticle, batzooka) => {\n  const plan = M.plan;\n  const plate = BZ.plateLoc(plan);\n  const c = BZ.contact({ swingT: swingPt - plan.time, reticle, plate, batzooka });\n  M.swung = true;\n  M.swing = Object.assign({ at: swingPt, reticle, batzooka }, c);\n  M.events.push({ type: 'swing', result: c.type, batzooka, q: c.q });\n  return c;\n};\n\n// ---- the scene -----------------------------------------------------------------------------------------------------\nBZ.matchScene = {\n  pausable: true, view: 'threequarter', input: 'custom', touch: false,\n  enter(data) {\n    const game = BZ.game;\n    const M = BZ.M || BZ.newMatchRun({ human: [true, false] });\n    BZ.M = M;\n    BZ.field = BZ.field || BZ.buildField();\n    game.lights.enabled = BZ.park === 'moondome';\n    game.lights.ambient = .55;\n    M.talk = BZ.talkFor(game);\n    M.talk.say(BZ.pick(BZ.rng.fx, BZ.LINES.intro), { name: 'PA', auto: 3, modal: false });\n    if (BZ.PARKS[BZ.park].night) BZ.playSong('match'); else BZ.playSong('match');\n    M.S.top = true;\n  },\n  exit() { const game = BZ.game; game.lights.enabled = false; BZ.playSong(null); },\n  update(dt) { BZ.matchUpdate(BZ.game, BZ.M, dt); },\n  draw(r) { BZ.matchDraw(r, BZ.M); }\n};\n\nBZ.talkFor = game => BZ.talk && BZ.talk.game === game ? BZ.talk : (BZ.talk = Object.assign(new E.Dialog(game), { game }));\n\n// Setup the lines for the team at bat and in the field, the rigs' poses, and the moment's prompt.\nBZ.beginHalfIntro = M => {\n  const S = M.S;\n  M.phase = 'intro'; M.clock = 0; M.introT = 2.2;\n  M.cam = 'plate';\n  M.stamp = { text: (S.top ? 'TOP ' : 'BOTTOM ') + S.inning, color: '#ffe6a0', t: 2.2, sub: BZ.TEAMS[BZ.battingTeam(S)].name + ' bat' };\n};\n\n// Each frame. The phases in order: intro, ready, windup, meter, pitch, inplay, after, final.\nBZ.matchUpdate = (game, M, dt) => {\n  if (!M) return;\n  const S = M.S, bt = BZ.battingTeam(S), ft = BZ.fieldingTeam(S);\n  const pitcherIn = M.human[ft] ? BZ.controllerInput(game, ft) : null;\n  const batterIn = M.human[bt] ? BZ.controllerInput(game, bt) : null;\n  M.clock += dt;\n  if (M.stamp) M.stamp.t -= dt;\n  if (M.stamp && M.stamp.t <= 0 && M.phase !== 'intro') M.stamp = null;\n  BZ.tickSwing(M, dt);\n\n  if (M.phase === 'intro') {\n    M.introT -= dt;\n    if (M.introT <= 0) { M.stamp = null; M.phase = 'ready'; M.clock = 0; BZ.beginPA(S); M.paPrevKey = BZ.halfKey(S); M.pitchChoice = M.pitchChoice || 'fastball'; M.aim = { lat: 0, h: 2.6 }; M.cpuPlanT = .9 + BZ.rng.fx() * .4; M.fireball = false; }\n  } else if (M.phase === 'ready') {\n    if (!M.human[ft]) {\n      if (M.clock >= M.cpuPlanT) { M.pending = null; M.plan = BZ.botPitch(S); M.phase = 'windup'; M.clock = 0; M.plan.super = BZ.TUNE && false; }\n    } else if (pitcherIn) {\n      BZ.humanPitchReady(game, M, pitcherIn, dt);\n    }\n  } else if (M.phase === 'windup') {\n    const k = Math.min(1, M.clock / .55);\n    if (M.clock >= .55) {\n      if (M.human[ft] && !M.plan.released) { M.phase = 'meter'; M.meterT = 0; }\n      else BZ.release(M, M.human[ft] ? M.meterP : M.plan.release);\n    }\n    M.windupK = k;\n  } else if (M.phase === 'meter') {\n    M.meterT += dt;\n    M.meterP = .5 + .5 * Math.sin(M.meterT * Math.PI * 2 / 1.15 - Math.PI / 2);\n    const pressed = pitcherIn && pitcherIn.pressed('confirm');\n    if (pressed || M.meterT > 2.4) BZ.release(M, M.meterP);\n  } else if (M.phase === 'pitch') {\n    BZ.pitchUpdate(game, M, dt, batterIn);\n  } else if (M.phase === 'inplay') {\n    BZ.playUpdate(game, M, dt, pitcherIn);\n  } else if (M.phase === 'after') {\n    M.afterT -= dt;\n    if (M.afterT <= 0) BZ.nextAfter(game, M);\n  } else if (M.phase === 'final') {\n    M.finalT -= dt;\n    if (M.finalT <= 0) BZ.endMatch(game, M);\n  }\n\n  BZ.rigsUpdate(M, dt);\n  BZ.focusCam(game, M, dt);\n  // the batter's and runners' moves, for the field view\n  M.batterRunT = M.ball || M.play ? Math.min(1, (M.batterRunT || 0) + dt / Math.max(.1, BZ.runTime())) : 0;\n};\n\n// The pitch's key: the same for the whole half-inning, so the next change of half is seen.\nBZ.halfKey = S => S.inning + (S.top ? 't' : 'b');\n\n// The human pitcher's setup: the pitch, the aim (stick, mouse), and the wind-up with a press.\nBZ.humanPitchReady = (game, M, I, dt) => {\n  const S = M.S;\n  const plist = BZ.PITCH_IDS;\n  const idx = plist.indexOf(M.pitchChoice);\n  if (I.pressed('prevPitch')) M.pitchChoice = plist[(idx + plist.length - 1) % plist.length];\n  if (I.pressed('nextPitch')) M.pitchChoice = plist[(idx + 1) % plist.length];\n  const click = game.input.clicked();\n  const chip = click ? BZ.chipAt(click[0], click[1]) : null;\n  const hover = BZ.chipAt(...(game.input.pointer() || [-1, -1]));\n  if (chip) M.pitchChoice = chip;\n  else if (hover && M.clock > .05) M.pitchChoice = hover;\n  // the aim: the stick moves it; a moved mouse puts it on the pointer\n  const mv = I.move();\n  const pt = game.input.pointer();\n  if (pt && M.prevPointer && (Math.abs(pt[0] - M.prevPointer[0]) + Math.abs(pt[1] - M.prevPointer[1]) > 2)) {\n    const p = BZ.plateFromScreen(pt[0], pt[1], game.W, game.H);\n    M.aim = BZ.clampAim(p.lat, p.h); M.aimTouched = true;\n  } else if (mv[0] || mv[1]) {\n    M.aim = BZ.clampAim(M.aim.lat + mv[0] * 1.8 * dt, M.aim.h - mv[1] * 1.8 * dt);\n  }\n  M.prevPointer = pt ? pt.slice() : null;\n  if (I.pressed('power') && S && BZ.meter[BZ.fieldingTeam(S)] >= 100) M.fireball = !M.fireball;\n  const click2 = click && !chip;\n  if (I.pressed('confirm') || click2) {\n    M.plan = null;\n    M.pending = { pitch: M.pitchChoice, aimLat: M.aim.lat, aimH: M.aim.h, superPitch: M.fireball };\n    if (M.fireball) BZ.meter[BZ.fieldingTeam(S)] = 0;\n    M.phase = 'windup'; M.clock = 0; M.plan = { pendingHuman: true };\n    M.pitchChoice = M.pitchChoice;\n  }\n};\n\n// Pitch selection chips at the bottom-left of the screen: their rectangles for hover and click.\nBZ.chipRects = game => {\n  const H = game.H, W = game.W;\n  return BZ.PITCH_IDS.map((id, i) => ({ id, x0: 16 + i * 94, y0: H - 58, x1: 16 + i * 94 + 86, y1: H - 16 }));\n};\nBZ.chipAt = (x, y) => {\n  const g = BZ.game;\n  if (!g || x < 0) return null;\n  for (const c of BZ.chipRects(g)) if (x >= c.x0 && x <= c.x1 && y >= c.y0 && y <= c.y1) return c.id;\n  return null;\n};\n\n// The release: plan the pitch from the wind-up's choice and the meter's place. The pitch starts now.\nBZ.release = (M, p) => {\n  const S = M.S, ft = BZ.fieldingTeam(S);\n  let plan;\n  if (M.pending) {\n    plan = BZ.planPitch({ pitch: M.pending.pitch, aimLat: M.pending.aimLat, aimH: M.pending.aimH, release: p, superPitch: M.pending.superPitch });\n    M.pending = null;\n  } else plan = M.plan;\n  plan.released = true;\n  M.plan = plan;\n  M.pt = 0; M.phase = 'pitch'; M.clock = 0; M.trail = [];\n  M.swung = false; M.swing = null; M.swingAt = null; M.cpuSwing = null;\n  const bt = BZ.battingTeam(S);\n  if (!M.human[bt] || M.opts.attract) {\n    const sw = BZ.cpuSwing(S, plan, BZ.rng.play, M.opts.cpuLevel || BZ.TUNE.cpuLevel);\n    if (sw) { M.cpuSwing = sw; M.swingAt = plan.time + sw.swingT; }\n    if (M.opts.drill && M.opts.drill.kind === 'catch') M.cpuSwing = { swingT: 0, reticle: BZ.plateLoc(plan), forced: true }, M.swingAt = plan.time;\n  }\n  M.events.push({ type: 'pitch', pitch: plan.pitch, time: plan.time, miss: plan.miss, super: plan.super });\n};\n\n// The pitch in flight: the batter's swing (his or the CPU's), and the call when it arrives.\nBZ.pitchUpdate = (game, M, dt, batterIn) => {\n  const plan = M.plan, S = M.S;\n  M.pt += dt;\n  const pos = BZ.pitchAt(plan, Math.min(1, M.pt / plan.time));\n  M.trail.push({ lat: pos.lat, h: pos.h, depth: pos.depth });\n  if (M.trail.length > 9) M.trail.shift();\n  M.pitchPos = pos;\n  // the human batter\n  if (!M.swung && batterIn && M.human[BZ.battingTeam(S)] && !M.opts.attract) {\n    const aimReticle = BZ.batterAim(game, M, batterIn, dt);\n    if (batterIn.pressed('confirm') || (game.input.clicked() && !BZ.chipAt(...game.input.clicked()))) {\n      const bz = !!(batterIn.pressed('power') && BZ.meter[BZ.battingTeam(S)] >= 100);\n      if (bz) BZ.meter[BZ.battingTeam(S)] = 0;\n      M.swingK = 0; M.swingBz = bz;\n      BZ.resolveSwing(M, M.pt, aimReticle, bz);\n      M.swingPhase = 'swing'; M.swingK = 0;\n      BZ.afterSwing(game, M);\n    }\n  } else if (!M.swung && M.cpuSwing && M.pt >= (M.swingAt || 0)) {\n    const sw = M.cpuSwing;\n    const bz = !!((M.opts.attract || M.opts.cheat) && BZ.meter[BZ.battingTeam(S)] >= 100);\n    if (bz) BZ.meter[BZ.battingTeam(S)] = 0;\n    if (sw.forced) BZ.resolveSwing(M, M.pt, sw.reticle, false), M.swing.type = M.swing.type === 'hit' ? 'hit' : M.swing.type;\n    else BZ.resolveSwing(M, M.pt, sw.reticle, bz);\n    M.swingK = 0; M.swingPhase = 'swing';\n    BZ.afterSwing(game, M);\n  }\n  if (M.phase !== 'pitch') return;\n  if (M.pt >= plan.time + .3) {\n    if (!M.swung) {\n      // the umpire calls it\n      const plate = BZ.plateLoc(plan);\n      const strike = BZ.inZone(plate.lat, plate.h);\n      BZ.countEvent(game, M, strike ? 'strike' : 'ball', plan);\n      BZ.afterPitch(game, M);\n    } else BZ.afterPitch(game, M);\n  }\n};\n\n// The batter's reticle: the stick moves it, the mouse puts it on the pointer, and the default is the plate's middle.\nBZ.batterAim = (game, M, I, dt) => {\n  const pt = game.input.pointer();\n  const mv = I.move();\n  if (pt && M.prevPointer && (Math.abs(pt[0] - M.prevPointer[0]) + Math.abs(pt[1] - M.prevPointer[1]) > 2)) {\n    const p = BZ.plateFromScreen(pt[0], pt[1], game.W, game.H);\n    M.reticle = { lat: BZ.clamp(p.lat, -1.6, 1.6), h: BZ.clamp(p.h, .6, 4.6) };\n  } else if (mv[0] || mv[1]) {\n    M.reticle = M.reticle || { lat: 0, h: 2.6 };\n    M.reticle = { lat: BZ.clamp(M.reticle.lat + mv[0] * 1.6 * dt, -1.6, 1.6), h: BZ.clamp(M.reticle.h - mv[1] * 1.6 * dt, .6, 4.6) };\n  }\n  M.prevPointer = pt ? pt.slice() : M.prevPointer;\n  return M.reticle || { lat: 0, h: 2.6 };\n};\n\n// The swing's animation: a timer from the swing, for the rig and the bat.\nBZ.tickSwing = (M, dt) => {\n  if (M.swingPhase === 'swing') { M.swingK = Math.min(1, (M.swingK || 0) + dt / .32); if (M.swingK >= 1) M.swingPhase = null; }\n  else if (M.swingK < 1 && M.swingK > 0) M.swingK = Math.min(1, M.swingK + dt / .32);\n};\n\n// After a swing: contact sends the ball into play; a foul or a whiff is counted here.\nBZ.afterSwing = (game, M) => {\n  const S = M.S, c = M.swing;\n  if (c.type === 'hit') {\n    M.ball = BZ.launchBall({ exit: c.exit, launch: c.launch, spray: c.spray, batzooka: c.batzooka, from: { x: BZ.HX, y: BZ.HY - 10 } });\n    M.play = new BZ.Play(S, M.ball, M.fielders[BZ.fieldingTeam(S)]);\n    for (const f of M.fielders[BZ.fieldingTeam(S)]) f.human = !!M.human[BZ.fieldingTeam(S)];\n    M.phase = 'inplay'; M.cam = 'field'; M.clock = 0; M.batterRunT = 0;\n    BZ.sfx(c.batzooka ? 'rocket' : 'crack', { vol: c.batzooka ? .6 : 1 });\n    if (c.batzooka) BZ.sfx('fire', { vol: .3 });\n    game.hitFx(BZ.HX, BZ.HY, 0, { power: c.q || .5, textScale: 0 });\n    return;\n  }\n  if (c.type === 'foul') { BZ.countEvent(game, M, 'foul', M.plan); BZ.afterPitch(game, M); return; }\n  BZ.countEvent(game, M, 'strike', M.plan, true);\n  BZ.afterPitch(game, M);\n};\n\n// A called or swung-at pitch: the count moves, the crowd and the umpire react, a walk or a strikeout ends the at-bat.\nBZ.countEvent = (game, M, kind, plan, swung = false) => {\n  const S = M.S, ft = BZ.fieldingTeam(S);\n  let ev;\n  if (kind === 'strike' || kind === 'ball') {\n    ev = BZ.pitchCount(S, kind);\n  } else ev = BZ.pitchCount(S, 'foul');\n  M.lastCount = BZ.countText(S);\n  M.outcome = Object.assign({ kind }, ev);\n  M.events.push({ type: 'call', kind, ev: ev.ev, count: M.lastCount });\n  if (kind === 'ball') { BZ.sfx('ball'); M.stamp = { text: 'BALL', color: '#7ad0ff', t: 1, sub: M.lastCount }; }\n  if (kind === 'strike') { BZ.sfx('strike'); M.stamp = { text: swung ? 'SWINGING STRIKE' : 'STRIKE', color: '#ffb020', t: 1, sub: M.lastCount }; }\n  if (kind === 'foul') { BZ.sfx('foul'); M.stamp = { text: 'FOUL', color: '#ffb020', t: 1, sub: M.lastCount }; }\n  if (ev.ev === 'k') { BZ.sfx('out'); BZ.say(M.talk, 'k'); M.stamp = { text: 'STRIKE THREE', color: '#ff6a5a', t: 1.8, sub: 'OUT' }; BZ.meter[ft] = Math.min(100, BZ.meter[ft] + 20); M.events.push({ type: 'k' }); }\n  if (ev.ev === 'walk') { BZ.sfx('confirm'); BZ.say(M.talk, 'walk'); M.stamp = { text: 'BALL FOUR', color: '#7ad0ff', t: 1.8, sub: 'WALK' }; }\n  if (kind === 'strike' && M.drill && M.drill.kind === 'strikes' && M.plan && !M.plan.pendingHuman) { M.drill.got = Math.min(M.drill.goal, M.drill.got + 1); }\n  if (ev.ev === 'strike' && kind === 'strike' && !swung && M.opts && BZ.rng.fx() < .6) BZ.say(M.talk, 'strike');\n  if (ev.ev === 'ball' && BZ.rng.fx() < .3) BZ.say(M.talk, 'ball');\n  if (ev.ev === 'walk' || ev.ev === 'k' || ev.ev === 'gameOver' || ev.end) M.paEnded = true;\n  if (ev.ev === 'walk' || ev.ev === 'k' || ev.end || ev.ev === 'gameOver') { M.paOver = ev; M.paEnded = true; }\n  M.afterT = 1.5;\n  BZ.rigPitchStance(M, false);\n  return ev;\n};\n\n// The pitch is over: a short pause for the call, then the next pitch, the next batter, or the change of half.\nBZ.afterPitch = (game, M) => {\n  M.phase = 'after'; M.afterT = 1.1; M.clock = 0;\n  if (M.paEnded) M.afterT = 1.9;\n  M.paDone = M.paEnded;\n  if (M.paEnded) M.afterT = 1.9;\n};\n\n// The batted ball: the defense plays, the rules decide, the stamp says what happened.\nBZ.playUpdate = (game, M, dt, pitcherIn) => {\n  const S = M.S, ft = BZ.fieldingTeam(S);\n  const human = { move: pitcherIn ? pitcherIn.move() : [0, 0], dive: !!(pitcherIn && pitcherIn.pressed('confirm')) };\n  if (human.dive && M.play) {\n    // the human dives with ✕; the pick-up base comes from the stick (one press, in the moment after the pick-up)\n  }\n  if (M.play.phase === 'fielded' && pitcherIn) {\n    const mv = pitcherIn.move();\n    human.pick = Math.abs(mv[0]) + Math.abs(mv[1]) > .5 ? (Math.abs(mv[0]) > Math.abs(mv[1]) ? (mv[0] > 0 ? 'first' : 'third') : (mv[1] < 0 ? 'second' : null)) : null;\n    if (pitcherIn.pressed('up')) human.pick = 'second';\n    if (pitcherIn.pressed('left')) human.pick = 'third';\n    if (pitcherIn.pressed('right')) human.pick = 'first';\n    const click = game.input.clicked();\n    if (click) { const b = M.basePx.findIndex(p => p && Math.hypot(p[0] - click[0], p[1] - click[1]) < 30); if (b >= 0) human.pick = ['first', 'second', 'third'][b]; }\n  }\n  M.clock += 0;\n  const ev = M.play.step(dt, human);\n  for (const e of M.play.events.splice(0)) {\n    M.events.push({ type: 'play:' + e.type, kind: e.fielder || e.target });\n    if (e.type === 'caught') { BZ.sfx('catch'); }\n    if (e.type === 'fielded') { BZ.sfx('thud'); }\n    if (e.type === 'throw') BZ.sfx('throw');\n  }\n  if (M.play.phase === 'over' || (M.play.result && M.play.result.kind)) BZ.playResolved(game, M);\n};\n\n// The play is over: the result is stamped, the batter's meter fills, and the count resumes or the half ends.\nBZ.playResolved = (game, M) => {\n  const S = M.S, bt = BZ.battingTeam(S), ft = BZ.fieldingTeam(S), res = M.play.result;\n  let text = 'OUT', color = '#ff6a5a', sub = '', talkKey = null;\n  if (res.kind === 'foul') { BZ.countEvent(game, M, 'foul', M.plan); M.play = null; M.ball = null; BZ.afterPitch(game, M); return; }\n  if (res.kind === 'caught') { text = 'CAUGHT'; sub = res.deep ? 'deep fly, runner tags up' : 'fly out'; talkKey = 'caught'; }\n  else if (res.kind === 'hit') {\n    const types = { single: ['SINGLE', '#ffe6a0', 'single'], double: ['DOUBLE', '#ffe6a0', 'double'], triple: ['TRIPLE', '#ffb020', 'triple'], hr: ['HOME RUN', '#ffb020', 'hr'] };\n    const [t, c, k] = types[res.type];\n    text = t; color = c; talkKey = k;\n    const gain = { single: .5, double: 1, triple: 1.3, hr: 2 }[res.type] * BZ.TUNE.meterGain;\n    BZ.meter[bt] = Math.min(100, BZ.meter[bt] + gain);\n    sub = res.type === 'hr' ? BZ.fmtFt(M.ball.homer ? M.ball.crossDist * BZ.FT : M.ball.landDist * BZ.FT) : '';\n    if (M.drill && M.drill.kind === 'hit' && res.type !== 'hr' && M.drill) M.drill.got = Math.min(M.drill.goal, M.drill.got + 1);\n    if (M.drill && M.drill.kind === 'homer' && res.type === 'hr') M.drill.got = Math.min(M.drill.goal, M.drill.got + 1);\n    if (M.drill && M.drill.kind === 'hit' && res.type === 'hr') M.drill.got = Math.min(M.drill.goal, M.drill.got + 1);\n    if (res.type === 'hr') BZ.sfx('fanfare'), BZ.sfx('cheer');\n    else BZ.sfx('cheer', { vol: .5 });\n    if (res.type === 'hr' && M.ball) game.particles.explosion(M.ball.x, M.ball.y, 4, 1.2);\n  } else if (res.kind === 'ground') {\n    if (res.batterOut) { text = 'OUT AT FIRST'; talkKey = 'groundOut'; }\n    else if (res.runnerOut) { text = 'FORCE OUT'; talkKey = 'forceOut'; }\n    else { text = 'SAFE'; color = '#7ad06a'; talkKey = 'safe'; }\n    if (res.r && res.r.runs) sub = res.r.runs + (res.r.runs > 1 ? ' runs score' : ' run scores');\n    if (res.kind === 'ground' && (text === 'SAFE')) BZ.sfx('confirm');\n  }\n  if (res.kind === 'caught' || (res.kind === 'ground' && res.batterOut)) { BZ.sfx('out'); }\n  if (res.kind === 'hit' || res.kind === 'ground' && res.r && res.r.runs) BZ.score ||= 0;\n  if (talkKey) BZ.say(M.talk, talkKey);\n  M.stamp = { text, color, t: 1.9, sub };\n  M.events.push({ type: 'result', kind: res.kind, text, runs: (res.runs || (res.r && res.r.runs) || 0) });\n  M.play = null; M.ball = null; M.swing = null;\n  M.paEnded = true;\n  if (res.kind === 'hit' && M.drill && M.drill.kind === 'catch') { /* the catch drill counts catches, not hits */ }\n  if (res.kind === 'caught' && M.drill && M.drill.kind === 'catch') M.drill.got = Math.min(M.drill.goal, M.drill.got + 1);\n  if (S.over) { M.paOver = { ev: 'gameOver' }; }\n  M.phase = 'after'; M.afterT = 2.0; M.clock = 0;\n};\n\n// Move to the next thing after a play or a count: the next pitch, the next half, or the final.\nBZ.nextAfter = (game, M) => {\n  const S = M.S;\n  M.stamp = null;\n  if (S.over) { M.phase = 'final'; M.finalT = 3.2; M.clock = 0; BZ.playSong('results'); const walk = S.walkoff; if (walk) BZ.say(M.talk, 'walkoff'); else BZ.say(M.talk, 'over'); return; }\n  const key = BZ.halfKey(S);\n  if (key !== M.paPrevKey) { M.paPrevKey = key; BZ.beginHalfIntro(M); return; }\n  M.phase = 'ready'; M.clock = 0; BZ.beginPA(S); M.cpuPlanT = .9 + BZ.rng.fx() * .4; M.fireball = false; M.cam = 'plate';\n  M.swung = false; M.swing = null; M.trail = []; M.plan = null; M.reticle = null; M.prevPointer = null;\n  M.paDone = false; M.paEnded = false;\n};\n\n// Human controls for the moment: the release meter is the pitcher's press; at the plate the swing is a press.\nBZ.endMatch = (game, M) => {\n  BZ.M = M;\n  game.go('results', { S: M.S, drill: M.drill, opts: M.opts, events: M.events.length });\n};\n\n// The rigs: each player's pose from the state (wind-up, swing, the stance, the runners on the bases, the fielders' moves).\nBZ.rigsUpdate = (M, dt) => {\n  const S = M.S, bt = BZ.battingTeam(S), ft = BZ.fieldingTeam(S);\n  for (const t of [0, 1]) {\n    const R = M.rigs[t];\n    for (const role of BZ.ROLES) {\n      const f = M.fielders[t].find(x => x.role === role);\n      const st = { x: f.x, y: f.y, z: 0, vx: 0, vy: 0, facing: f.face || 0 };\n      if (role === 'P' && t === ft && M.phase === 'windup') st.attack = E.move('overhead', M.windupK || 0);\n      if (role === 'P' && t === ft && M.phase === 'pitch') st.attack = E.move('overhead', 1, 'recover');\n      if (role === 'C') st.pose = 'crouch';\n      R.fielders[role].update(dt, st);\n    }\n    const br = R.batter;\n    const bstate = { x: 0, y: 0, z: 0, facing: Math.PI / 2 };\n    if (t === bt && M.swingPhase === 'swing') bstate.attack = E.move('slash', M.swingK || 0);\n    else bstate.stance = 'ready';\n    br.update(dt, bstate);\n    R.runners.forEach((rr, i) => {\n      const on = S.bases[i] && t === bt && (M.ball || M.play);\n      rr.update(dt, { x: 0, y: 0, z: 0, facing: 0, stance: 'ready', pose: on ? undefined : 'wave' });\n    });\n  }\n};\n\nBZ.rigPitchStance = (M, _cheer) => { /* poses are set in rigsUpdate from the phase */ };\n\n// The camera: the plate's view has no camera; in the field, it follows the play's ball, or the home plate.\nBZ.focusCam = (game, M, dt) => {\n  if (M.cam !== 'field') return;\n  const b = M.ball;\n  const tx = b ? b.x : BZ.HX, ty = b ? b.y - 100 : BZ.HY - 260, tz = b ? b.z : 0;\n  game.focus(tx, ty, tz * .4);\n};\n\n// The draw: the Plate Cam for the duel, the field for the play.\nBZ.matchDraw = (r, M) => {\n  if (!M) return;\n  const W = r.W, H = r.H, S = M.S;\n  const park = BZ.PARKS[BZ.park];\n  if (M.cam === 'field' && M.ball) {\n    BZ.drawField(r, M);\n  } else if (M.cam === 'field') {\n    BZ.drawField(r, M);\n  } else {\n    r.sky(park.night ? ['#060818', '#2a2a5a'] : park.sky);\n    r.overlay(g => {\n      BZ.drawPlateGround(g, W, H, park);\n      BZ.drawZone(g, W, H);\n      BZ.drawPlatePlayers(g, W, H, { view: r.view, pitcher: M.rigs[BZ.fieldingTeam(S)].fielders.P, catcher: M.rigs[BZ.fieldingTeam(S)].fielders.C, batter: M.rigs[BZ.battingTeam(S)].batter });\n      if (M.plan && M.phase === 'pitch' && M.pitchPos) BZ.drawPitchBall(g, W, H, M.plan, Math.min(1, M.pt / M.plan.time), M.trail);\n      if (M.phase === 'ready' || M.phase === 'windup' || M.phase === 'meter') BZ.drawAimReticle(g, W, H, M);\n      if (M.phase === 'pitch' && !M.swung) { /* the batter's reticle while the ball comes in */ BZ.drawBatterReticle(g, W, H, M); }\n      if (M.swing && M.swing.type) BZ.drawBat(g, W, H, { swing: M.swingK || 0, reticle: M.swing.reticle || { lat: 0, h: 2.6 } });\n    });\n  }\n  r.overlay(g => BZ.drawHud(g, r, M));\n  if (M.talk) M.talk.draw(r);\n};\n\n// The field view: the TileMap, the fielders, the runners, the ball, and the bases clickable for the throw.\nBZ.drawField = (r, M) => {\n  const S = M.S;\n  BZ.field.drawFloor(r);\n  BZ.field.queueWalls(r);\n  const ft = BZ.fieldingTeam(S), bt = BZ.battingTeam(S);\n  const R = M.rigs[ft];\n  for (const f of M.fielders[ft]) {\n    const rig = R.fielders[f.role];\n    r.shadow(f.x, f.y, 6, .3, undefined, 0);\n    r.actor(f.x, f.y, 0, (g, ox, oy) => rig.draw(g, ox, oy, r.view));\n  }\n  BZ.bases().forEach((b, i) => { M.basePx[i] = r.w(b.x, b.y, 0); });\n  // the runners and the batter\n  BZ.bases().slice(0, 3).forEach((b, i) => {\n    if (S.bases[i]) { const rr = M.rigs[bt].runners[i]; r.actor(b.x, b.y, 0, (g, ox, oy) => rr.draw(g, ox, oy, r.view)); }\n  });\n  if (M.batterRunT > 0 && M.batterRunT < 1) {\n    const p = BZ.bases()[0], x = BZ.lerp(BZ.HX, p.x, M.batterRunT), y = BZ.lerp(BZ.HY - 10, p.y, M.batterRunT);\n    r.actor(x, y, 0, (g, ox, oy) => M.rigs[bt].batter.draw(g, ox, oy, r.view));\n  }\n  if (M.ball) {\n    const b = M.ball;\n    r.shadow(b.x, b.y, 4, .45, undefined, 0);\n    const sx = b.z > 0 ? b.z : 0;\n    r.sprite(b.x, b.y, b.z + 4, BZ.BALL_SPR, { glow: .3 });\n    if (sx > 0) {/* the shadow shows the height */}\n  }\n  if (M.play && M.play.phase === 'fielded') {\n    const f = M.play.holder;\n    if (f) r.decal(() => r.groundDisc(f.x, f.y, 9, '#ffffff55'));\n  }\n};\n\n// The ball's sprite: a white ball with its seams, drawn once.\nBZ.BALL_SPR = E.sprite(['.www.', 'wwrww', 'wrwrw', 'wwrww', '.www.'], { w: '#f8f8f0', r: '#c83a3a' }, 2);\n\n// The HUD for the match: the scorebug, the count, the pitch chips, the meters, the prompts.\nBZ.drawHud = (g, r, M) => {\n  const S = M.S, W = r.W, H = r.H;\n  BZ.drawScorebug(g, S, 16, 16);\n  if (M.phase === 'ready' && M.human[BZ.fieldingTeam(S)]) BZ.drawChips(g, M, H);\n  const bt = BZ.battingTeam(S), ft = BZ.fieldingTeam(S);\n  if (M.human[bt]) BZ.drawBatzookaMeter(g, W - 170, H - 40, 150, BZ.meter[bt], 'BATZOOKA', BZ.meter[bt] >= 100);\n  if (M.human[ft]) BZ.drawBatzookaMeter(g, W - 170, H - 72, 150, BZ.meter[ft], 'FIREBALL', BZ.meter[ft] >= 100 || M.fireball);\n  if (M.phase === 'meter') {\n    BZ.drawMeter(g, W / 2 - 90, H * .78, 180, M.meterP);\n    BZ.text(g, BZ.prompt('confirm', 'RELEASE'), W / 2 - 90, H * .78 - 22, '#ffffff', { align: 'center', scale: 1.6 });\n  }\n  if (M.stamp) BZ.drawStamp(g, W, H, M.stamp, M.stamp.color, M.stamp.sub);\n  if (M.drill) BZ.text(g, BZ.drillText(M), W / 2, 14, '#ffe6a0', { align: 'center', scale: 1.4 });\n  BZ.drawPrompt(g, r, M);\n};\n\nBZ.drillText = M => {\n  const d = M.drill;\n  const names = { strikes: 'THROW STRIKES', hit: 'PUT ONE IN PLAY', catch: 'CATCH A FLY', homer: 'HIT A HOMER' };\n  return names[d.kind] + '  ' + d.got + '/' + d.goal;\n};\n\nBZ.drawChips = (g, M, H) => {\n  BZ.chipRects(BZ.game).forEach((c, i) => {\n    const on = c.id === M.pitchChoice;\n    E.ui.box(g, c.x0, c.y0, c.x1 - c.x0, c.y1 - c.y0, { bg: on ? ['#ffe6a0', '#c8a060'] : ['#1a1d2a', '#0b0d16'], border: on ? '#ffffff' : '#c8a060', alpha: .92 });\n    const P = BZ.PITCHES[c.id];\n    BZ.text(g, P.name, c.x0 + 6, c.y0 + 6, on ? '#1a1020' : '#ffffff', { scale: 1.1, shadow: null });\n    BZ.text(g, P.tag, c.x0 + 6, c.y0 + 20, on ? '#1a1020' : '#c8d0f0', { scale: 1 });\n  });\n};\n\n// The prompt line at the bottom: what this player does now, on the device used last.\nBZ.drawPrompt = (g, r, M) => {\n  const S = M.S, W = r.W, H = r.H;\n  const bt = BZ.battingTeam(S), ft = BZ.fieldingTeam(S);\n  let line = '';\n  if (M.phase === 'ready' && M.human[ft]) line = BZ.prompt('confirm', 'WIND UP') + '    ' + BZ.prompt('prevPitch', '/ ') + '  ' + 'PICK A PITCH   ' + BZ.prompt('power', 'FIREBALL WHEN FULL');\n  else if (M.phase === 'pitch' && M.human[bt] && !M.swung) line = BZ.prompt('confirm', 'SWING') + '    ' + BZ.prompt('power', 'BATZOOKA WHEN FULL') + '    STICK AIMS THE BAT';\n  else if (M.phase === 'inplay' && M.human[ft]) line = BZ.prompt('confirm', 'DIVE') + '    STICK RUNS    ' + (M.play && M.play.phase === 'fielded' ? 'UP 2ND · LEFT 3RD · RIGHT 1ST' : '');\n  else if (M.phase === 'intro') line = '';\n  if (line) E.ui.box(g, W / 2 - (line.length * 3.4 + 16), H - 26, line.length * 6.8 + 32, 20, { bg: ['#101420', '#060810'], border: '#c8a060', alpha: .8 }), BZ.text(g, line, W / 2, H - 20, '#ffffff', { align: 'center', scale: 1.2, shadow: null });\n};\n\n// The aim: the pitcher's target and the batter's reticle, in the plate's space.\nBZ.drawAimReticle = (g, W, H, M) => {\n  const p = BZ.project(M.aim.lat, M.aim.h, 0, W, H);\n  const miss = 6 * (BZ.releaseError(M.meterP || .5) * BZ.TUNE.aimError);\n  E.px.disc(g, p.x, p.y, Math.max(3, 2 * p.s), '#ffffff55');\n  E.px.disc(g, p.x, p.y, 2, '#ffe6a0');\n};\nBZ.drawBatterReticle = (g, W, H, M) => {\n  const ret = M.reticle || { lat: 0, h: 2.6 };\n  const p = BZ.project(ret.lat, ret.h, 0, W, H);\n  E.px.disc(g, p.x, p.y, Math.max(3, BZ.TUNE.reach * p.s), '#ffe6a040');\n  E.px.disc(g, p.x, p.y, 2, '#ffe6a0');\n};\n\n// The meter's marker for the release, a swing's bat, and the umpire's booth are drawn by the view.\nBZ.drawSwing = () => {};\n\n// Human batter reticle is the bat's head (the reticle), and the release happens at the top of the meter.\nBZ.sceneFor = () => BZ.matchScene;\n","userModified":false},"tool_result_meta":[{"id":"toolu_012PHxhVHDcJwTi3AmhqoGc8","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
