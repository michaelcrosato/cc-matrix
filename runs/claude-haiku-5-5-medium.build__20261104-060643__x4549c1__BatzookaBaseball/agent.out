,"-    if (S.inning >= S.innings && S.score[1] > S.score[0]) { S.over = true; return { ev: 'gameOver' }; }","+    if (S.inning >= S.innings && S.score[1] > S.score[0]) { S.over = true; return { end: 'gameOver' }; }","     S.top = false;","-    return { ev: 'halfOver' };","+    return { end: 'halfOver' };","   }","-  if (S.inning >= S.innings && S.score[0] !== S.score[1]) { S.over = true; return { ev: 'gameOver' }; }","+  if (S.inning >= S.innings && S.score[0] !== S.score[1]) { S.over = true; return { end: 'gameOver' }; }","   S.top = true; S.inning++;","   if (S.inning > S.innings) S.extra = true;","-  return { ev: 'inningOver' };","+  return { end: 'inningOver' };"," };"," ","-// Hit a ball. type: 'single' | 'double' | 'triple' | 'hr'. Runners move the way the hit sends them; returns runs.","-BZ.hit = (S, type, batter = S.batter) => {","-  const t = BZ.battingTeam(S), b = S.bases;","+// A hit. type: 'single' | 'double' | 'triple' | 'hr'. Runners go the way the hit sends them; returns the runs.","+BZ.hit = (S, type) => {","+  const t = BZ.battingTeam(S), b = S.bases, batter = S.batter;","   let runs = 0;","-  const score = n => { runs += n; };","   if (type === 'hr') {","+    for (let i = 0; i < 3; i++) if (b[i]) { runs++; b[i] = null; }","+    runs++;","     S.hr[t]++;","-    for (let i = 0; i < 3; i++) if (b[i]) { score(1); b[i] = null; }","-    score(1);","   } else if (type === 'triple') {","-    for (let i = 0; i < 3; i++) if (b[i]) { score(1); b[i] = null; }","+    for (let i = 0; i < 3; i++) if (b[i]) { runs++; b[i] = null; }","     b[2] = batter;","   } else if (type === 'double') {","-    if (b[2]) { score(1); b[2] = null; }","-    if (b[1]) { score(1); b[1] = null; }","+    if (b[2]) { runs++; b[2] = null; }","+    if (b[1]) { runs++; b[1] = null; }","     if (b[0]) { b[2] = b[0]; b[0] = null; }","     b[1] = batter;","-  } else {   // single","-    if (b[2]) { score(1); b[2] = null; }","+  } else {","+    if (b[2]) { runs++; b[2] = null; }","     if (b[1]) { b[2] = b[1]; b[1] = null; }","     if (b[0]) { b[1] = b[0]; b[0] = null; }","     b[0] = batter;"]},{"oldStart":139,"oldLines":57,"newStart":134,"newLines":36,"lines":["   return runs;"," };"," ","-// A ball in play that the defense has put out or that is caught (outs, possibly a sacrifice).","+// A caught ball: an out. A deep fly lets the runner on third tag up and score."," BZ.caughtFly = (S, deep) => {","   const t = BZ.battingTeam(S);","   let runs = 0;","-  if (deep && S.bases[2]) { runs = 1; S.bases[2] = null; }   // a deep fly lets the third-base runner tag up and score","+  if (deep && S.bases[2]) { runs = 1; S.bases[2] = null; }","   BZ.addRuns(S, t, runs);","-  return { runs, ev: BZ.recordOut(S, 'fly') };","+  return Object.assign(BZ.recordOut(S, 'fly'), { runs });"," };"," ","-// The base play that followed a fielded ground ball. The batter is out or safe at first; forced runners may be out.","-// target: 0 (first), 1 (second), 2 (third). The batter out at first is the usual out.","-BZ.groundPlay = (S, target, outs) => {","-  const t = BZ.battingTeam(S), b = S.bases;","-  const res = { ev: 'safe', runs: 0 };","-  if (target === 0) {","-    // Batter out at first: the runners hold (the force is off once the batter is out).","-    if (outs.batter) { Object.assign(res, BZ.recordOut(S, 'ground')); res.ev = 'out'; return res; }","-    // Batter safe at first, force the runners in order.","-    res.runs = BZ.forceFrom(S, 0);","-  } else {","-    // A force at second or third: the runner there is out, and the batter is safe at first.","-    if (outs.runner) {","-      b[target - 1] = null;","-      Object.assign(res, BZ.recordOut(S, 'force'));","-      res.ev = 'forceOut';","-      if (S.over || S.outs === 0 && res.ev === 'inningOver') return res;","-    }","-    res.runs = BZ.forceFrom(S, 0);","+// The play after a fielded ground ball. target: 0 (first), 1 (second) or 2 (third) is where the throw goes.","+// batterOut: the throw beat the batter to first. runnerOut: the throw beat the forced runner to that base.","+BZ.groundPlay = (S, target, { batterOut, runnerOut }) => {","+  const t = BZ.battingTeam(S);","+  if (target === 0 && batterOut) {","+    const o = BZ.recordOut(S, 'ground');","+    return Object.assign(o, { runs: 0 });","   }","-  BZ.addRuns(S, t, res.runs);","-  return res;","+  if (target > 0 && runnerOut) {","+    S.bases[target - 1] = null;","+    const o = BZ.recordOut(S, 'force');","+    if (o.end) return Object.assign(o, { runs: 0 });","+  }","+  const runs = BZ.forceAdvance(S);","+  BZ.addRuns(S, t, runs);","+  return { ev: runnerOut || batterOut ? 'forceOut' : 'safe', runs, batter: S.batter };"," };"," ","-// Put the batter on first and push runners who are forced (a chain of forces from first).","-BZ.forceFrom = (S, _from) => {","-  const b = S.bases;","-  let runs = 0;","-  if (b[2] && b[1] && b[0]) { runs = 1; b[2] = null; }   // the full-base force scores the third-base runner","-  if (b[1] && b[0]) { b[2] = b[1]; } else if (b[1] && !b[0]) { /* a runner on second is not forced */ }","-  if (b[0]) { b[1] = b[0]; }","-  b[0] = S.batter;","-  return runs;","-};","-"," // The line score as rows of text, for the results screen."," BZ.lineScore = S => {","-  const cols = Math.max(S.line[0].length, S.line[1].length, S.innings);","-  const row = team => {","-    const cells = [];","-    for (let i = 0; i < cols; i++) cells.push(i < (S.line[team].length) ? String(S.line[team][i]) : (i < S.inning ? '0' : ''));","-    return cells;","-  };","-  return { cols, away: row(0), home: row(1), R: S.score, H: S.hits, E: S.errors };","+  const cols = Math.max(S.innings, S.line[0].length, S.line[1].length);","+  const row = team => Array.from({ length: cols }, (_, i) => i < S.line[team].length ? String(S.line[team][i]) : (i < S.inning - (team === 1 && !S.top ? 0 : 1) || (team === 1 && S.top ? false : i < S.inning) ? '0' : ''));","+  return { cols, away: row(0), home: row(1), R: S.score.slice(), H: S.hits.slice() };"," };"]}],"originalFile":"// The rules engine: pure state and transitions, no drawing, no input. A match is one object (BZ.newMatch); each call\n// below moves it on and returns what happened, so the scene, the commentary and the tests all read the same events.\n// Kept from baseball: balls, strikes, outs, the four bases with forces, innings, the walk, the strikeout, extra innings,\n// the walk-off and the rule that the home team does not bat in the last half when it is ahead.\n// Simplified: runners never steal or tag up (a deep caught fly sends the runner on third home), one throw decides a\n// play, and a double play is a force at second with the batter beaten to first by the same throw.\nBZ.newMatch = (o = {}) => ({\n  innings: o.innings || 3, inning: 1, top: true, outs: 0, balls: 0, strikes: 0,\n  bases: [null, null, null],                  // what sits on 1B, 2B, 3B: the runner's name, or null\n  score: [0, 0],\n  line: [[], []],                              // runs per inning, per team\n  hits: [0, 0], hr: [0, 0], k: [0, 0], walks: [0, 0], errors: [0, 0],\n  lineup: [0, 0],                              // whose turn to bat, per team (0..8)\n  over: false, walkoff: false, extra: false,\n  batter: null                                 // the batter's name, filled in by batterFor\n});\nBZ.battingTeam = S => S.top ? 0 : 1;\nBZ.fieldingTeam = S => 1 - BZ.battingTeam(S);\nBZ.batterFor = (S, team = BZ.battingTeam(S)) => BZ.TEAMS[team].players[S.lineup[team] % 9];\nBZ.countText = S => S.balls + '-' + S.strikes;\n\n// Runs for a team this inning: the line score keeps them by inning.\nBZ.addRuns = (S, team, n) => {\n  if (n <= 0) return 0;\n  S.score[team] += n;\n  const L = S.line[team];\n  while (L.length < S.inning) L.push(0);\n  L[S.inning - 1] = (L[S.inning - 1] || 0) + n;\n  if (!S.top && S.inning >= S.innings && S.score[1] > S.score[0]) { S.over = true; S.walkoff = true; }\n  return n;\n};\n\n// A fresh count for the next batter; the batter's turn in the order passes on.\nBZ.nextBatter = S => {\n  const t = BZ.battingTeam(S);\n  S.lineup[t] = (S.lineup[t] + 1) % 9;\n  S.balls = 0; S.strikes = 0;\n  S.batter = BZ.batterFor(S, t);\n  return S.batter;\n};\n\n// Walk: force the runners in order. Returns the runs that score.\nBZ.walk = S => {\n  const b = S.bases;\n  let runs = 0;\n  if (b[0] && b[1] && b[2]) runs = 1;\n  if (b[0] && b[1]) { if (b[2] || !b[2]) { if (b[0] && b[1] && b[2]) { /* full: run scores */ } } }\n  if (b[0]) {\n    if (b[1]) {\n      if (b[2]) runs = 1, b[2] = b[1];\n      else b[2] = b[1];\n      b[1] = b[0];\n    } else b[1] = b[0];\n    b[0] = null;\n  }\n  b[0] = S.batter;\n  S.walks[BZ.battingTeam(S)]++;\n  S.balls = 0; S.strikes = 0;\n  return runs;\n};\n\n// The count. kind: 'ball' | 'strike' (looking or swinging) | 'foul' | 'out' (put out, any way but a strikeout).\n// Returns { ev: 'ball'|'strike'|'foul'|'walk'|'k'|'out'|'halfOver'|'inningOver'|'gameOver', runs, ... }.\nBZ.pitchCount = (S, kind) => {\n  const t = BZ.battingTeam(S);\n  if (kind === 'ball') {\n    S.balls++;\n    if (S.balls >= 4) {\n      const runs = BZ.walk(S);\n      BZ.addRuns(S, t, runs);\n      return { ev: 'walk', runs, batter: S.batter };\n    }\n    return { ev: 'ball' };\n  }\n  if (kind === 'strike') {\n    S.strikes++;\n    if (S.strikes >= 3) {\n      S.k[t]++;\n      return BZ.recordOut(S, 'k');\n    }\n    return { ev: 'strike' };\n  }\n  if (kind === 'foul') {\n    if (S.strikes < 2) S.strikes++;\n    return { ev: 'foul' };\n  }\n  return { ev: 'out' };\n};\n\n// One out. Three outs end the half-inning. Returns the event, including halfOver/gameOver when it ends.\nBZ.recordOut = (S, why = 'out') => {\n  S.outs++;\n  const ev = { ev: why === 'k' ? 'k' : 'out', why, batter: S.batter };\n  S.balls = 0; S.strikes = 0;\n  if (S.outs >= 3) return Object.assign(ev, BZ.endHalf(S));\n  return ev;\n};\n\n// The half-inning ends: the bases clear, and the next half or the game's end.\nBZ.endHalf = S => {\n  const wasTop = S.top;\n  S.outs = 0; S.bases = [null, null, null];\n  if (wasTop) {\n    if (S.inning >= S.innings && S.score[1] > S.score[0]) { S.over = true; return { ev: 'gameOver' }; }\n    S.top = false;\n    return { ev: 'halfOver' };\n  }\n  if (S.inning >= S.innings && S.score[0] !== S.score[1]) { S.over = true; return { ev: 'gameOver' }; }\n  S.top = true; S.inning++;\n  if (S.inning > S.innings) S.extra = true;\n  return { ev: 'inningOver' };\n};\n\n// Hit a ball. type: 'single' | 'double' | 'triple' | 'hr'. Runners move the way the hit sends them; returns runs.\nBZ.hit = (S, type, batter = S.batter) => {\n  const t = BZ.battingTeam(S), b = S.bases;\n  let runs = 0;\n  const score = n => { runs += n; };\n  if (type === 'hr') {\n    S.hr[t]++;\n    for (let i = 0; i < 3; i++) if (b[i]) { score(1); b[i] = null; }\n    score(1);\n  } else if (type === 'triple') {\n    for (let i = 0; i < 3; i++) if (b[i]) { score(1); b[i] = null; }\n    b[2] = batter;\n  } else if (type === 'double') {\n    if (b[2]) { score(1); b[2] = null; }\n    if (b[1]) { score(1); b[1] = null; }\n    if (b[0]) { b[2] = b[0]; b[0] = null; }\n    b[1] = batter;\n  } else {   // single\n    if (b[2]) { score(1); b[2] = null; }\n    if (b[1]) { b[2] = b[1]; b[1] = null; }\n    if (b[0]) { b[1] = b[0]; b[0] = null; }\n    b[0] = batter;\n  }\n  S.hits[t]++;\n  BZ.addRuns(S, t, runs);\n  return runs;\n};\n\n// A ball in play that the defense has put out or that is caught (outs, possibly a sacrifice).\nBZ.caughtFly = (S, deep) => {\n  const t = BZ.battingTeam(S);\n  let runs = 0;\n  if (deep && S.bases[2]) { runs = 1; S.bases[2] = null; }   // a deep fly lets the third-base runner tag up and score\n  BZ.addRuns(S, t, runs);\n  return { runs, ev: BZ.recordOut(S, 'fly') };\n};\n\n// The base play that followed a fielded ground ball. The batter is out or safe at first; forced runners may be out.\n// target: 0 (first), 1 (second), 2 (third). The batter out at first is the usual out.\nBZ.groundPlay = (S, target, outs) => {\n  const t = BZ.battingTeam(S), b = S.bases;\n  const res = { ev: 'safe', runs: 0 };\n  if (target === 0) {\n    // Batter out at first: the runners hold (the force is off once the batter is out).\n    if (outs.batter) { Object.assign(res, BZ.recordOut(S, 'ground')); res.ev = 'out'; return res; }\n    // Batter safe at first, force the runners in order.\n    res.runs = BZ.forceFrom(S, 0);\n  } else {\n    // A force at second or third: the runner there is out, and the batter is safe at first.\n    if (outs.runner) {\n      b[target - 1] = null;\n      Object.assign(res, BZ.recordOut(S, 'force'));\n      res.ev = 'forceOut';\n      if (S.over || S.outs === 0 && res.ev === 'inningOver') return res;\n    }\n    res.runs = BZ.forceFrom(S, 0);\n  }\n  BZ.addRuns(S, t, res.runs);\n  return res;\n};\n\n// Put the batter on first and push runners who are forced (a chain of forces from first).\nBZ.forceFrom = (S, _from) => {\n  const b = S.bases;\n  let runs = 0;\n  if (b[2] && b[1] && b[0]) { runs = 1; b[2] = null; }   // the full-base force scores the third-base runner\n  if (b[1] && b[0]) { b[2] = b[1]; } else if (b[1] && !b[0]) { /* a runner on second is not forced */ }\n  if (b[0]) { b[1] = b[0]; }\n  b[0] = S.batter;\n  return runs;\n};\n\n// The line score as rows of text, for the results screen.\nBZ.lineScore = S => {\n  const cols = Math.max(S.line[0].length, S.line[1].length, S.innings);\n  const row = team => {\n    const cells = [];\n    for (let i = 0; i < cols; i++) cells.push(i < (S.line[team].length) ? String(S.line[team][i]) : (i < S.inning ? '0' : ''));\n    return cells;\n  };\n  return { cols, away: row(0), home: row(1), R: S.score, H: S.hits, E: S.errors };\n};\n","userModified":false},"tool_result_meta":[{"id":"toolu_013q4k9FEK4j3UgrpbrVJLmA","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
