json.load(open('data/anim/sets/mesh2motion/_set.json'))\nprint(list(d.keys()))\nprint(json.dumps(d,indent=None)[:900])\nEOF\nsed -n 1,12p data/anim/sets/mesh2motion/Pushup.json | cut -c1-210; grep -n \"LEGEND\" -A28 engine/anim/clip/lens.ts | sed -n 1,50p | cut -c1-170","description":"Render starter to image and read clip set format and legend","timeout":180000}}}
