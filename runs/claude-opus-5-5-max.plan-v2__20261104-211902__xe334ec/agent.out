{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjAMn7FG9GZBqTfN1oyD","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01M9JBJM6HzozXkYa2EAMm5E","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211902__xe334ec/work/_scratch/probe-game; sed -n 1,60p engine/input/devices/virtual.ts | cut -c1-170; echo ----; sed -n 1,50p engine/input/devices/inspector.ts | cut -c1-170; echo ----; sed -n 1,90p engine/input/codes.ts | cut -c1-170; echo ----; grep -n \"custom\\|'game:\\|\\\"game:\" engine/input/input.ts engine/input/intents.ts | head -20; sed -n 90,240p engine/input/input.ts | grep -n -E \"^\\s+[a-zA-Z]+\\??[(:]\" | cut -c1-150 | head -50","description":"Read virtual input device, codes, and custom intent handling"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11705,"cache_read_input_tokens":223540,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11705},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"21849288-0c8f-4994-9d0f-3ff83c647ec0","uuid":"73c89ddd-9b84-4c74-a459-176b8ef9abfe","timestamp":"2026-11-05T04:37:54.124Z","request_id":"req_011CgjAMmkR9QSfahh1ru3Qo","wire_tool_inputs":{"toolu_01M9JBJM6HzozXkYa2EAMm5E":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211902__xe334ec/work/_scratch/probe-game; sed -n 1,60p engine/input/devices/virtual.ts | cut -c1-170; echo ----; sed -n 1,50p engine/input/devices/inspector.ts | cut -c1-170; echo ----; sed -n 1,90p engine/input/codes.ts | cut -c1-170; echo ----; grep -n \"custom\\|'game:\\|\\\"game:\" engine/input/input.ts engine/input/intents.ts | head -20; sed -n 90,240p engine/input/input.ts | grep -n -E \"^\\s+[a-zA-Z]+\\??[(:]\" | cut -c1-150 | head -50","description":"Read virtual input device, codes, and custom intent handling"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M9JBJM6HzozXkYa2EAMm5E","type":"tool_result","content":"/**\n * @file The virtual device (PLAN.md WP 3.3, §8.3; doctrine: Agent-operable): input made by code instead of hands, the\n * one `__engine.input` drives (engine/input/devices/inspector.ts). It works in actions and intents, not codes:\n * `press('jump')` taps an action for the next step, `hold('sprint')` keeps one down, `axis('move', [0, 1])` pushes a\n * virtual stick (`[right, forward]`, turned by the camera as keys are), and `axis('cam' | 'look' | 'aim' | 'game:…',\n * value)` sets that intent outright; `null` lets go.\n *\n * `play(script, step)` runs a script one sim step at a time, each line `<steps> [move=x,y] [look=yaw,pitch] [cam=ψ]\n * [aim=x,y,z] [hold=a,b] [tap=a] [game:key=n]`, `#` comments (engine/input/script.ts): a line holds its values for\n * its steps on top of what the device holds, and taps on its first step. A page's input (engine/input/input.ts)\n * merges the device into every sample, so the same calls drive a running page.\n *\n * Invariants: taps last one step (the next sample or step played), holds and axes until changed. Values are checked\n * when given (`INPUT_BAD_VIRTUAL`): names are non-empty strings, `move` and `look` two finite numbers, `aim` three,\n * `cam` one, a custom key plain data. Intents come out unnormalized; the session normalizes them.\n *\n * @example\n * const pad = createVirtualDevice();\n * pad.axis('move', [0, 1]);\n * pad.press('jump');\n * virtualIntents(pad.take(), Math.PI / 2); // { move: [1, 6.1e-17], b: [], p: ['jump'] }: forward is +X at ψ = π/2\n * const steps: unknown[] = [];\n * playScript(pad, '2 hold=sprint tap=dash\\n1', (intents) => steps.push(intents));\n * steps.length; // 3: the second step holds sprint without the tap, the third holds nothing but the stick\n * @see engine/input/devices/virtual.test.ts\n */\nimport { codeError, defineCodes } from '../../core/log';\nimport { isPlainObject, show } from '../../core/schema';\nimport { fromCamera, type IntentValue } from '../intents';\nimport { names, numbers, parseScript, type ValueReader } from '../script';\n\n/** The codes this module raises, with their fixes. */\nexport const VIRTUAL_CODES = defineCodes('input', {\n  INPUT_BAD_VIRTUAL: {\n    template: '{what}: {problem}',\n    fix: \"press(action) and hold(action) take an action's name; axis takes 'move' or 'look' [x, y], 'aim' [x, y, z], 'cam' (rad) or a 'game:key' with plain data, and null\n    doc: 'Raised by the virtual device (engine/input/devices/virtual.ts) and `__engine.input` for an empty action name, an unknown axis, or a value of the wrong shape.',\n  },\n});\n\n/** The axes the device can hold, and how many numbers each takes (0 for a custom key's plain data). */\nconst AXES: Readonly<Record<string, number>> = { move: 2, look: 2, aim: 3, cam: 1 };\n\n/** A namespaced custom intent key. */\nconst CUSTOM = /^[a-z][A-Za-z0-9]*:[A-Za-z0-9_.-]+$/;\n\n/** What the device holds for one step: actions held and tapped, and its axes by name. */\nexport interface VirtualSample {\n  held: string[];\n  taps: string[];\n  axes: Record<string, IntentValue>;\n}\n\n/** The virtual device. */\nexport interface VirtualDevice {\n  /** Taps `action`: pressed in the next step, not held. */\n  press(action: string): void;\n  /** Holds `action` down (`down = false` lets go). */\n  hold(action: string, down?: boolean): void;\n  /** Sets an axis: `move` `[right, forward]`, `look`, `aim`, `cam` or a `game:key`; `null` lets go. */\n----\n/**\n * @file `__engine.input` (PLAN.md §8.3, WP 3.3; doctrine: Agent-operable): the inspector members that drive the virtual\n * device (engine/input/devices/virtual.ts) and record the run, registered from this file as entries of the registry\n * kind `inspectorMember` (engine/dev/members.ts), so no layer imports `dev/` and no other WP edits the inspector.\n *\n * - `input.press(action)`, `input.hold(action, down)`, `input.axis(name, value)`: change what the virtual device holds.\n *   A page's input merges it into every frame's intents; headless, `input.play` runs the steps.\n * - `input.play(script)`: runs a script one sim step at a time through the session (each step recorded), on top of\n *   what the device holds; returns the steps run and the tick after them. `input.play('30')` steps 30 times with it.\n * - `input.record()`: the run's intents from step 0 as a replay (PLAN.md §8.4), what `x replay` plays.\n * - `input.state()`: what the virtual device holds.\n *\n * Each engine has its own virtual device: the page's input when the app connects it (`connectVirtualDevice(host,\n * input.virtual)`), else one made on first use. Members change the sim only through `host.step`, which records.\n *\n * Invariants: this module registers on the shared registry when it loads, so `inspectorMember` must be declared first\n * (engine/dev/members.ts: the app and createHeadless load it before this module; a test imports it first).\n *\n * @example\n * import '../../dev/members';\n * import { createHeadless } from '../../app/headless';\n * import { createRegistry } from '../../core/registry';\n * import { defineScene } from '../../sim/scene';\n * const engine = await createHeadless({ scene: defineScene('walk', { setup: () => {} }, createRegistry()) });\n * const input = engine.input as Record<string, (...args: unknown[]) => unknown>;\n * input.axis('move', [0, 1]);\n * input.play('2 tap=jump'); // { steps: 2, tick: 2 }\n * (input.record() as { inputs: unknown[] }).inputs; // [[0, { move: [0, 1], p: ['jump'] }]]\n * @see engine/input/devices/virtual.test.ts\n */\nimport { def } from '../../core/registry';\nimport { createVirtualDevice, playScript, type VirtualDevice } from './virtual';\n\n/** What the input members use of an inspector host (engine/dev/members.ts `InspectorHost`). */\ninterface InputHost {\n  step(n: number, intents: unknown): void;\n  readonly session: { readonly world: { readonly tick: number }; record(): unknown };\n}\n\n/** Each host's virtual device. */\nconst devices = new WeakMap<object, VirtualDevice>();\n\n/** Gives `host` (the app's inspector host) the page input's virtual device, so `__engine.input` drives the page. */\nexport function connectVirtualDevice(host: object, device: VirtualDevice): void {\n  devices.set(host, device);\n}\n\n/** The virtual device of `host`, made on first use. */\nexport function virtualDeviceOf(host: object): VirtualDevice {\n  let device = devices.get(host);\n----\n/**\n * @file The physical input codes (PLAN.md WP 3.3, I-24; doctrine: Common ground): what a binding names, and the label\n * a prompt shows for it. Keys are `KeyboardEvent.code` values (`KeyW`, `Space`, `ArrowUp`), the physical key whatever\n * the layout, so WASD stays under the left hand on AZERTY; mouse buttons and the wheel are `MouseLeft`, `MouseRight`,\n * `MouseMiddle`, `MouseBack`, `MouseForward`, `WheelUp` and `WheelDown`; gamepad buttons follow the W3C standard\n * mapping by position (`PadSouth` is index 0: A on Xbox, Cross on PlayStation), and each stick has four direction codes\n * (`PadLeftStickUp`), so a stick binds like keys and still walks at half speed when half pushed.\n *\n * Labels per device: keys show the character the layout puts there when a layout map is given (`navigator.keyboard.\n * getLayoutMap()`, read by `readKeyboardLayout`), else a name from the code; pad buttons show the family's names\n * (`padStyle` reads it from `Gamepad.id`: Xbox by default, PlayStation, Nintendo).\n *\n * Touch buttons (WP 3.12) write `touch:<action>` (`touchCode`): every action binds its own implicitly, so no map\n * lists one and no player rebinds one; a button names its action with `data-action` (engine/input/devices/touch.ts).\n *\n * Held bindings (WP 13.20, Apex's pad: X held reloads, Y held holsters): `Hold:<code>` (`holdCode`) is a key, mouse\n * button or pad button kept down `HOLD_TIME`; let go sooner, the code is a tap of its plain binding (engine/input/\n * input.ts holds the plain one back until it knows which). It labels as `Hold X` and belongs to its code's device.\n *\n * Invariants: `isCode` accepts exactly the codes above, touch codes aside; `deviceOf` is `gamepad` for `Pad…`, `mouse`\n * for `Mouse…` and `Wheel…`, `touch` for `touch:…`, `keyboard` otherwise (a held binding its code's); `PAD_BUTTONS[i]`\n * is standard button i.\n *\n * Carried from `my-3d2dge:src/emberdeep/61-controls.js:28-116` (`bindingCode`, `PAD_LABELS`, `codeLabel`), with\n * position names for the pad and labels per pad family.\n *\n * @example\n * deviceOf('PadSouth'); // 'gamepad'\n * codeLabel('KeyW'); // 'W'\n * codeLabel('KeyW', { layout: new Map([['KeyW', 'z']]) }); // 'Z': the key AZERTY puts there\n * codeLabel('PadSouth', { pad: padStyle('DualSense Wireless Controller (STANDARD GAMEPAD Vendor: 054c)') }); // 'Cross'\n * isCode('KeyW') && !isCode('w'); // true: bindings name physical keys\n * codeLabel(holdCode('PadWest')); // 'Hold X': Apex's reload on a pad\n * @see engine/input/bindings.test.ts\n */\n\n/** The devices input comes from; `virtual` is the inspector's (engine/input/devices/virtual.ts). */\nexport type DeviceKind = 'keyboard' | 'mouse' | 'gamepad' | 'touch' | 'virtual';\n\n/** Where the devices write (engine/input/input.ts keeps it): codes going down and up, analog strengths, use. */\nexport interface InputSink {\n  /** A digital code went down (a key, a mouse button, a wheel notch): pressed at the next sample, even if up by then. */\n  press(code: string, device: DeviceKind): void;\n  /** A digital code went up. */\n  release(code: string): void;\n  /** An analog code's strength now, 0 to 1 (a trigger, a stick direction); `press` and `release` say when it is held. */\n  analog(code: string, value: number): void;\n  /** The device was used without a press (a stick pushed, the mouse moved): prompts follow it. */\n  used(device: DeviceKind): void;\n  /** Whether an action binds `code`: a bound key's default (Space scrolling the page) is prevented. */\n  bound(code: string): boolean;\n}\n\n/** A gamepad family, for labels. */\nexport type PadStyle = 'xbox' | 'playstation' | 'nintendo';\n\n/** The W3C standard gamepad buttons by index, named by position. */\nexport const PAD_BUTTONS = [\n  'PadSouth',\n  'PadEast',\n  'PadWest',\n  'PadNorth',\n  'PadLeftShoulder',\n  'PadRightShoulder',\n  'PadLeftTrigger',\n  'PadRightTrigger',\n  'PadSelect',\n  'PadStart',\n  'PadLeftStick',\n  'PadRightStick',\n  'PadUp',\n  'PadDown',\n  'PadLeft',\n  'PadRight',\n  'PadHome',\n] as const;\n\n/** The stick directions, each a code whose strength is how far the stick leans that way (after the deadzone). */\nexport const PAD_STICKS = [\n  'PadLeftStickUp',\n  'PadLeftStickDown',\n  'PadLeftStickLeft',\n  'PadLeftStickRight',\n  'PadRightStickUp',\n  'PadRightStickDown',\n  'PadRightStickLeft',\n  'PadRightStickRight',\n] as const;\n\n/** Mouse buttons by `MouseEvent.button` (0 left, 1 middle, 2 right, 3 back, 4 forward). */\n----\nengine/input/intents.ts:6: * and game code adds its own keys, namespaced (`'game:charge'`). Devices (WP 3.3) make intents; the sim only reads them.\nengine/input/intents.ts:9: * custom values are plain data) and returns a frozen object with keys in a fixed order, buttons sorted and unique, and\nengine/input/intents.ts:46:    fix: 'give intents as { move: [x, z], cam, aim: [x, y, z], look: [yaw, pitch], b: [held buttons], p: [pressed buttons] } with finite numbers, plus custom keys namespaced \"game:key\" holding plain data (engine/input/intents.ts); null or a missing key means not given',\nengine/input/intents.ts:47:    doc: 'Raised by `normalizeIntents`, `applyIntents` and the replay checks (engine/input/intents.ts, engine/sim/replay.ts) for an unknown key (named with the closest), a non-finite or misshapen number, a button that is not a non-empty string, or a custom value that is not plain data. Every problem is listed at once.',\nengine/input/intents.ts:51:/** A custom intent's value: plain data, as a replay file holds it. */\nengine/input/intents.ts:54:/** A namespaced key for game code's own intents: `'game:charge'`. */\nengine/input/intents.ts:95:/** The namespaced key a bad one most likely means: `'Game:x'` → `'game:x'`, `'charge'` → `'game:charge'`. */\nengine/input/intents.ts:96:function customKey(key: string): string {\nengine/input/intents.ts:107:/** Deepest nesting a custom value may have. */\nengine/input/intents.ts:128:    problems.push(`${path} is ${value === null ? 'null inside a value' : show(value)}; custom intents hold plain data`);\nengine/input/intents.ts:151: * Checks `raw` and returns the step's intents: frozen, keys in order (built-ins, then custom keys sorted), buttons\nengine/input/intents.ts:161:  const custom: string[] = [];\nengine/input/intents.ts:165:    if (CUSTOM.test(key)) custom.push(key);\nengine/input/intents.ts:168:        `unknown key ${show(key)}${didYouMean(key, Object.keys(INTENT_KEYS))} (custom keys are namespaced: \"${customKey(key)}\")`,\nengine/input/intents.ts:181:  for (const key of custom.sort(byText)) out[key] = plainData(raw[key], key, problems);\nengine/input/intents.ts:190:  for (const key of custom) ordered[key] = out[key];\nengine/input/input.ts:12: * pointer and the right stick (engine/input/aim.ts); the map's `values` as custom intents. The move actions, the map's\n1:  registry?: Registry;\n3:  log?: Log;\n8:  look: [number, number];\n9:  turn: [number, number];\n10:  zoom: number;\n18:  use(map: string | Bindings): Bindings;\n20:  bindingsFor(map: string): Bindings;\n37:  sample(camera?: CameraLike, now?: number): Record<string, unknown>;\n39:  held(action: string): boolean;\n41:  pressed(action: string): boolean;\n43:  strength(action: string): number;\n45:  camera(): CameraInputSample;\n47:  prompt(action: string): string;\n49:  listen(device: 'keyboard' | 'gamepad'): Promise<string | null>;\n51:  clear(): void;\n53:  dispose(): void;\n113:    press(code, device) {\n128:      tell(code);\n130:    release(code) {\n137:    analog(code, value) {\n142:    used(device) {\n145:    bound(code) {\n146:      codesOf('');","is_error":false}]},"parent_tool_use_id":null,"session_id":"21849288-0c8f-4994-9d0f-3ff83c647ec0","uuid":"8eaa166d-c4f2-44e8-8e6f-bf776e3d900f","timestamp":"2026-11-05T04:37:54.182Z","tool_use_result":{"stdout":"/**\n * @file The virtual device (PLAN.md WP 3.3, §8.3; doctrine: Agent-operable): input made by code instead of hands, the\n * one `__engine.input` drives (engine/input/devices/inspector.ts). It works in actions and intents, not codes:\n * `press('jump')` taps an action for the next step, `hold('sprint')` keeps one down, `axis('move', [0, 1])` pushes a\n * virtual stick (`[right, forward]`, turned by the camera as keys are), and `axis('cam' | 'look' | 'aim' | 'game:…',\n * value)` sets that intent outright; `null` lets go.\n *\n * `play(script, step)` runs a script one sim step at a time, each line `<steps> [move=x,y] [look=yaw,pitch] [cam=ψ]\n * [aim=x,y,z] [hold=a,b] [tap=a] [game:key=n]`, `#` comments (engine/input/script.ts): a line holds its values for\n * its steps on top of what the device holds, and taps on its first step. A page's input (engine/input/input.ts)\n * merges the device into every sample, so the same calls drive a running page.\n *\n * Invariants: taps last one step (the next sample or step played), holds and axes until changed. Values are checked\n * when given (`INPUT_BAD_VIRTUAL`): names are non-empty strings, `move` and `look` two finite numbers, `aim` three,\n * `cam` one, a custom key plain data. Intents come out unnormalized; the session normalizes them.\n *\n * @example\n * const pad = createVirtualDevice();\n * pad.axis('move', [0, 1]);\n * pad.press('jump');\n * virtualIntents(pad.take(), Math.PI / 2); // { move: [1, 6.1e-17], b: [], p: ['jump'] }: forward is +X at ψ = π/2\n * const steps: unknown[] = [];\n * playScript(pad, '2 hold=sprint tap=dash\\n1', (intents) => steps.push(intents));\n * steps.length; // 3: the second step holds sprint without the tap, the third holds nothing but the stick\n * @see engine/input/devices/virtual.test.ts\n */\nimport { codeError, defineCodes } from '../../core/log';\nimport { isPlainObject, show } from '../../core/schema';\nimport { fromCamera, type IntentValue } from '../intents';\nimport { names, numbers, parseScript, type ValueReader } from '../script';\n\n/** The codes this module raises, with their fixes. */\nexport const VIRTUAL_CODES = defineCodes('input', {\n  INPUT_BAD_VIRTUAL: {\n    template: '{what}: {problem}',\n    fix: \"press(action) and hold(action) take an action's name; axis takes 'move' or 'look' [x, y], 'aim' [x, y, z], 'cam' (rad) or a 'game:key' with plain data, and null\n    doc: 'Raised by the virtual device (engine/input/devices/virtual.ts) and `__engine.input` for an empty action name, an unknown axis, or a value of the wrong shape.',\n  },\n});\n\n/** The axes the device can hold, and how many numbers each takes (0 for a custom key's plain data). */\nconst AXES: Readonly<Record<string, number>> = { move: 2, look: 2, aim: 3, cam: 1 };\n\n/** A namespaced custom intent key. */\nconst CUSTOM = /^[a-z][A-Za-z0-9]*:[A-Za-z0-9_.-]+$/;\n\n/** What the device holds for one step: actions held and tapped, and its axes by name. */\nexport interface VirtualSample {\n  held: string[];\n  taps: string[];\n  axes: Record<string, IntentValue>;\n}\n\n/** The virtual device. */\nexport interface VirtualDevice {\n  /** Taps `action`: pressed in the next step, not held. */\n  press(action: string): void;\n  /** Holds `action` down (`down = false` lets go). */\n  hold(action: string, down?: boolean): void;\n  /** Sets an axis: `move` `[right, forward]`, `look`, `aim`, `cam` or a `game:key`; `null` lets go. */\n----\n/**\n * @file `__engine.input` (PLAN.md §8.3, WP 3.3; doctrine: Agent-operable): the inspector members that drive the virtual\n * device (engine/input/devices/virtual.ts) and record the run, registered from this file as entries of the registry\n * kind `inspectorMember` (engine/dev/members.ts), so no layer imports `dev/` and no other WP edits the inspector.\n *\n * - `input.press(action)`, `input.hold(action, down)`, `input.axis(name, value)`: change what the virtual device holds.\n *   A page's input merges it into every frame's intents; headless, `input.play` runs the steps.\n * - `input.play(script)`: runs a script one sim step at a time through the session (each step recorded), on top of\n *   what the device holds; returns the steps run and the tick after them. `input.play('30')` steps 30 times with it.\n * - `input.record()`: the run's intents from step 0 as a replay (PLAN.md §8.4), what `x replay` plays.\n * - `input.state()`: what the virtual device holds.\n *\n * Each engine has its own virtual device: the page's input when the app connects it (`connectVirtualDevice(host,\n * input.virtual)`), else one made on first use. Members change the sim only through `host.step`, which records.\n *\n * Invariants: this module registers on the shared registry when it loads, so `inspectorMember` must be declared first\n * (engine/dev/members.ts: the app and createHeadless load it before this module; a test imports it first).\n *\n * @example\n * import '../../dev/members';\n * import { createHeadless } from '../../app/headless';\n * import { createRegistry } from '../../core/registry';\n * import { defineScene } from '../../sim/scene';\n * const engine = await createHeadless({ scene: defineScene('walk', { setup: () => {} }, createRegistry()) });\n * const input = engine.input as Record<string, (...args: unknown[]) => unknown>;\n * input.axis('move', [0, 1]);\n * input.play('2 tap=jump'); // { steps: 2, tick: 2 }\n * (input.record() as { inputs: unknown[] }).inputs; // [[0, { move: [0, 1], p: ['jump'] }]]\n * @see engine/input/devices/virtual.test.ts\n */\nimport { def } from '../../core/registry';\nimport { createVirtualDevice, playScript, type VirtualDevice } from './virtual';\n\n/** What the input members use of an inspector host (engine/dev/members.ts `InspectorHost`). */\ninterface InputHost {\n  step(n: number, intents: unknown): void;\n  readonly session: { readonly world: { readonly tick: number }; record(): unknown };\n}\n\n/** Each host's virtual device. */\nconst devices = new WeakMap<object, VirtualDevice>();\n\n/** Gives `host` (the app's inspector host) the page input's virtual device, so `__engine.input` drives the page. */\nexport function connectVirtualDevice(host: object, device: VirtualDevice): void {\n  devices.set(host, device);\n}\n\n/** The virtual device of `host`, made on first use. */\nexport function virtualDeviceOf(host: object): VirtualDevice {\n  let device = devices.get(host);\n----\n/**\n * @file The physical input codes (PLAN.md WP 3.3, I-24; doctrine: Common ground): what a binding names, and the label\n * a prompt shows for it. Keys are `KeyboardEvent.code` values (`KeyW`, `Space`, `ArrowUp`), the physical key whatever\n * the layout, so WASD stays under the left hand on AZERTY; mouse buttons and the wheel are `MouseLeft`, `MouseRight`,\n * `MouseMiddle`, `MouseBack`, `MouseForward`, `WheelUp` and `WheelDown`; gamepad buttons follow the W3C standard\n * mapping by position (`PadSouth` is index 0: A on Xbox, Cross on PlayStation), and each stick has four direction codes\n * (`PadLeftStickUp`), so a stick binds like keys and still walks at half speed when half pushed.\n *\n * Labels per device: keys show the character the layout puts there when a layout map is given (`navigator.keyboard.\n * getLayoutMap()`, read by `readKeyboardLayout`), else a name from the code; pad buttons show the family's names\n * (`padStyle` reads it from `Gamepad.id`: Xbox by default, PlayStation, Nintendo).\n *\n * Touch buttons (WP 3.12) write `touch:<action>` (`touchCode`): every action binds its own implicitly, so no map\n * lists one and no player rebinds one; a button names its action with `data-action` (engine/input/devices/touch.ts).\n *\n * Held bindings (WP 13.20, Apex's pad: X held reloads, Y held holsters): `Hold:<code>` (`holdCode`) is a key, mouse\n * button or pad button kept down `HOLD_TIME`; let go sooner, the code is a tap of its plain binding (engine/input/\n * input.ts holds the plain one back until it knows which). It labels as `Hold X` and belongs to its code's device.\n *\n * Invariants: `isCode` accepts exactly the codes above, touch codes aside; `deviceOf` is `gamepad` for `Pad…`, `mouse`\n * for `Mouse…` and `Wheel…`, `touch` for `touch:…`, `keyboard` otherwise (a held binding its code's); `PAD_BUTTONS[i]`\n * is standard button i.\n *\n * Carried from `my-3d2dge:src/emberdeep/61-controls.js:28-116` (`bindingCode`, `PAD_LABELS`, `codeLabel`), with\n * position names for the pad and labels per pad family.\n *\n * @example\n * deviceOf('PadSouth'); // 'gamepad'\n * codeLabel('KeyW'); // 'W'\n * codeLabel('KeyW', { layout: new Map([['KeyW', 'z']]) }); // 'Z': the key AZERTY puts there\n * codeLabel('PadSouth', { pad: padStyle('DualSense Wireless Controller (STANDARD GAMEPAD Vendor: 054c)') }); // 'Cross'\n * isCode('KeyW') && !isCode('w'); // true: bindings name physical keys\n * codeLabel(holdCode('PadWest')); // 'Hold X': Apex's reload on a pad\n * @see engine/input/bindings.test.ts\n */\n\n/** The devices input comes from; `virtual` is the inspector's (engine/input/devices/virtual.ts). */\nexport type DeviceKind = 'keyboard' | 'mouse' | 'gamepad' | 'touch' | 'virtual';\n\n/** Where the devices write (engine/input/input.ts keeps it): codes going down and up, analog strengths, use. */\nexport interface InputSink {\n  /** A digital code went down (a key, a mouse button, a wheel notch): pressed at the next sample, even if up by then. */\n  press(code: string, device: DeviceKind): void;\n  /** A digital code went up. */\n  release(code: string): void;\n  /** An analog code's strength now, 0 to 1 (a trigger, a stick direction); `press` and `release` say when it is held. */\n  analog(code: string, value: number): void;\n  /** The device was used without a press (a stick pushed, the mouse moved): prompts follow it. */\n  used(device: DeviceKind): void;\n  /** Whether an action binds `code`: a bound key's default (Space scrolling the page) is prevented. */\n  bound(code: string): boolean;\n}\n\n/** A gamepad family, for labels. */\nexport type PadStyle = 'xbox' | 'playstation' | 'nintendo';\n\n/** The W3C standard gamepad buttons by index, named by position. */\nexport const PAD_BUTTONS = [\n  'PadSouth',\n  'PadEast',\n  'PadWest',\n  'PadNorth',\n  'PadLeftShoulder',\n  'PadRightShoulder',\n  'PadLeftTrigger',\n  'PadRightTrigger',\n  'PadSelect',\n  'PadStart',\n  'PadLeftStick',\n  'PadRightStick',\n  'PadUp',\n  'PadDown',\n  'PadLeft',\n  'PadRight',\n  'PadHome',\n] as const;\n\n/** The stick directions, each a code whose strength is how far the stick leans that way (after the deadzone). */\nexport const PAD_STICKS = [\n  'PadLeftStickUp',\n  'PadLeftStickDown',\n  'PadLeftStickLeft',\n  'PadLeftStickRight',\n  'PadRightStickUp',\n  'PadRightStickDown',\n  'PadRightStickLeft',\n  'PadRightStickRight',\n] as const;\n\n/** Mouse buttons by `MouseEvent.button` (0 left, 1 middle, 2 right, 3 back, 4 forward). */\n----\nengine/input/intents.ts:6: * and game code adds its own keys, namespaced (`'game:charge'`). Devices (WP 3.3) make intents; the sim only reads them.\nengine/input/intents.ts:9: * custom values are plain data) and returns a frozen object with keys in a fixed order, buttons sorted and unique, and\nengine/input/intents.ts:46:    fix: 'give intents as { move: [x, z], cam, aim: [x, y, z], look: [yaw, pitch], b: [held buttons], p: [pressed buttons] } with finite numbers, plus custom keys namespaced \"game:key\" holding plain data (engine/input/intents.ts); null or a missing key means not given',\nengine/input/intents.ts:47:    doc: 'Raised by `normalizeIntents`, `applyIntents` and the replay checks (engine/input/intents.ts, engine/sim/replay.ts) for an unknown key (named with the closest), a non-finite or misshapen number, a button that is not a non-empty string, or a custom value that is not plain data. Every problem is listed at once.',\nengine/input/intents.ts:51:/** A custom intent's value: plain data, as a replay file holds it. */\nengine/input/intents.ts:54:/** A namespaced key for game code's own intents: `'game:charge'`. */\nengine/input/intents.ts:95:/** The namespaced key a bad one most likely means: `'Game:x'` → `'game:x'`, `'charge'` → `'game:charge'`. */\nengine/input/intents.ts:96:function customKey(key: string): string {\nengine/input/intents.ts:107:/** Deepest nesting a custom value may have. */\nengine/input/intents.ts:128:    problems.push(`${path} is ${value === null ? 'null inside a value' : show(value)}; custom intents hold plain data`);\nengine/input/intents.ts:151: * Checks `raw` and returns the step's intents: frozen, keys in order (built-ins, then custom keys sorted), buttons\nengine/input/intents.ts:161:  const custom: string[] = [];\nengine/input/intents.ts:165:    if (CUSTOM.test(key)) custom.push(key);\nengine/input/intents.ts:168:        `unknown key ${show(key)}${didYouMean(key, Object.keys(INTENT_KEYS))} (custom keys are namespaced: \"${customKey(key)}\")`,\nengine/input/intents.ts:181:  for (const key of custom.sort(byText)) out[key] = plainData(raw[key], key, problems);\nengine/input/intents.ts:190:  for (const key of custom) ordered[key] = out[key];\nengine/input/input.ts:12: * pointer and the right stick (engine/input/aim.ts); the map's `values` as custom intents. The move actions, the map's\n1:  registry?: Registry;\n3:  log?: Log;\n8:  look: [number, number];\n9:  turn: [number, number];\n10:  zoom: number;\n18:  use(map: string | Bindings): Bindings;\n20:  bindingsFor(map: string): Bindings;\n37:  sample(camera?: CameraLike, now?: number): Record<string, unknown>;\n39:  held(action: string): boolean;\n41:  pressed(action: string): boolean;\n43:  strength(action: string): number;\n45:  camera(): CameraInputSample;\n47:  prompt(action: string): string;\n49:  listen(device: 'keyboard' | 'gamepad'): Promise<string | null>;\n51:  clear(): void;\n53:  dispose(): void;\n113:    press(code, device) {\n128:      tell(code);\n130:    release(code) {\n137:    analog(code, value) {\n142:    used(device) {\n145:    bound(code) {\n146:      codesOf('');","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01M9JBJM6HzozXkYa2EAMm5E","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
