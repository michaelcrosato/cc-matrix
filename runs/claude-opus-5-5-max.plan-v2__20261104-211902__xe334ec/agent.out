{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018kayj2qkmnaMZtuLawrrRP","type":"tool_result","content":"/**\n * @file The one-file playground, `playground.html` at the root (ADR-0023 amendment 5, the owner's call of\n * 2026-11-02): the playground (labs/playground/) built as one self-contained HTML page, its script and styles inline\n * and nothing fetched, so it opens from disk (file://) in a WebGPU browser, sent as one file. It is how the engine is\n * distributed and how the owner tests it, in place of the Vercel deployment it replaces.\n *\n * `buildOneFile` runs Vite's build on labs/playground/index.html with vite.config.ts's alias (a bare `three` is\n * `three/webgpu`), every dynamic import folded into the one script (`inlineDynamicImports`) and every asset a data URL;\n * `inlineBuild` then puts the script and the stylesheet into the page. The build gives the same bytes on every machine\n * (no path or time goes in: tools/lib/oneFile.test.ts), so `node x html --check` rebuilds it and compares, and the\n * quick gate runs that check (tools/cmd/ci.ts): the committed file matches its sources at every merge.\n *\n * Invariants: the page fetches nothing (`externalRefs` is empty); a `</script` inside the script is written\n * `<\\/script`, which means the same in a string, a template, a regular expression or a comment, and a `<!--` in it, which\n * no such rewrite makes safe, fails the build. Only the playground is in it: its links to the engine's other pages\n * (the Stress Box, the labs index, the labs) are the dev server's from the file, each saying in plain words to run\n * npm run dev first (labs/playground/ui/pages.ts).\n *\n * @example\n * inlineBuild('<script type=\"module\" crossorigin src=\"./a.js\"></script>', { 'a.js': 'go()' }); // '<script type=\"module\">go()</script>'\n * ONE_FILE; // 'playground.html'\n * @see tools/lib/oneFile.test.ts\n * @see tools/cmd/html.ts\n */\nimport { join } from 'node:path';\nimport type { Rollup } from 'vite';\n\n/** The file, from the repository root. */\nexport const ONE_FILE = 'playground.html';\n\n/** The page it is built from. */\nexport const ONE_FILE_PAGE = 'labs/playground/index.html';\n\n/** The note the file opens its head with. */\nexport const ONE_FILE_NOTE = `<!-- ${ONE_FILE}: the my-3dge playground as one self-contained page (https://github.com/michaelcrosato/my-3dge, MIT; it carries three.js, MIT, Rapier, Apache-2.0, and @stdlib functions, Apache-2.0: see lean/LICENSE). Open it in a browser with WebGPU. Written by node x html --write from ${ONE_FILE_PAGE}; never edit it by hand. -->`; // prettier-ignore\n\n/** A module script or stylesheet Vite's page loads from a file. */\nconst LOADED = /<script type=\"module\" crossorigin src=\"([^\"]+)\"><\\/script>|<link rel=\"stylesheet\" crossorigin href=\"([^\"]+)\">/g; // prettier-ignore\n\n/**\n * The page `html` with each script and stylesheet it loads put inline, from `files` (by file name; a reference\n * matches the file whose name it ends with), and `ONE_FILE_NOTE` after its charset. Throws, naming the file, when a\n * reference has no file or a script holds a `<!--`.\n */\nexport function inlineBuild(html: string, files: Readonly<Record<string, string>>): string {\n  const find = (ref: string): string => {\n    const name = Object.keys(files).find((file) => ref.endsWith(`/${file}`) || ref === file || ref === `./${file}`);\n    if (name === undefined) throw new Error(`${ref} is not in the build: the page loads a file Vite did not write`);\n    return files[name];\n  };\n  const inlined = html.replace(LOADED, (_tag, script?: string, style?: string) => {\n    if (style) return `<style>${find(style)}</style>`;\n    const code = find(script!).replaceAll('</script', '<\\\\/script');\n    if (code.includes('<!--')) {\n      throw new Error(`${script} holds \"<!--\", which an inline script cannot: write it apart ('<' + '!--') in the source`); // prettier-ignore\n    }\n    return `<script type=\"module\">${code}</script>`;\n  });\n  return inlined.replace('<meta charset=\"utf-8\" />', (charset) => `${charset}\\n    ${ONE_FILE_NOTE}`);\n}\n\n/** The `src` and `href` attributes of `html` that load something other than a data URL (none, in the one file). */\nexport function externalRefs(html: string): string[] {\n  const outside = html.replace(/<script type=\"module\">[\\s\\S]*?<\\/script>|<style>[\\s\\S]*?<\\/style>/g, '');\n  return [...outside.matchAll(/\\b(?:src|href)=\"([^\"]*)\"/g)].map((match) => match[1]).filter((ref) => !ref.startsWith('data:')); // prettier-ignore\n}\n\n/** Builds the one file from the repository at `root` and returns its text (about 7 MB; about 11 s). */\nexport async function buildOneFile(root: string): Promise<string> {\n  const { build } = await import('vite');\n  const result = await build({\n    root,\n    configFile: false,\n    logLevel: 'warn',\n    base: './',\n    resolve: { alias: [{ find: /^three$/, replacement: 'three/webgpu' }] },\n    build: {\n      write: false,\n      modulePreload: false,\n      cssCodeSplit: false,\n      assetsInlineLimit: () => true,\n      chunkSizeWarningLimit: Infinity,\n      rollupOptions: { input: { playground: join(root, ONE_FILE_PAGE) }, output: { inlineDynamicImports: true } },\n    },\n  });\n  const outputs = (Array.isArray(result) ? result : [result]) as Rollup.RollupOutput[];\n  const files: Record<string, string> = {};\n  let html: string | undefined;\n  for (const item of outputs.flatMap((output) => output.output)) {\n    const text = item.type === 'chunk' ? item.code : typeof item.source === 'string' ? item.source : new TextDecoder().decode(item.source); // prettier-ignore\n    if (item.fileName.endsWith('.html')) html = text;\n    else files[item.fileName] = text;\n  }\n  if (html === undefined) throw new Error(`Vite wrote no page from ${ONE_FILE_PAGE}: check that it exists`);\n  return inlineBuild(html, files);\n}\n\n------\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\" />\n    <meta name=\"theme-color\" content=\"#15171c\" />\n    <link rel=\"stylesheet\" href=\"../../engine/ui/touch.css\" />\n    <link rel=\"icon\" href=\"data:,\" />\n    <title>The starter game: my-3dge</title>\n    <!--\n      The starter game's page (labs/game/README.md): labs/game/main.ts starts the engine on the scene game:play and\n      shows the round in the HUD. Ready or error: until the engine publishes window.__engine, the inline script below\n      records a script that fails to load or throws, and shows it in #msg, so a broken page is one line of text,\n      never a blank one; `node x shot labs/game` reports the same headless.\n    -->\n    <style>\n      html,\n      body {\n        margin: 0;\n        height: 100%;\n        overflow: hidden;\n        background: #15171c;\n      }\n      canvas {\n        display: block;\n        width: 100vw;\n        height: 100vh;\n        height: 100dvh;\n        outline: none;\n        touch-action: none;\n      }\n      #msg {\n        position: fixed;\n        inset: 0;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        padding: 24px;\n        font:\n          18px system-ui,\n          sans-serif;\n        color: #c9ccd4;\n        text-align: center;\n        white-space: pre-line;\n        pointer-events: none;\n      }\n      #msg[hidden] {\n        display: none;\n      }\n    </style>\n    <script>\n      window.__engine = { ready: false, errors: [] };\n      function gameFailed(message) {\n        if (!window.__engine || typeof window.__engine.help === 'function') return; // the engine reports now\n        var fix = 'the console names the cause; node x shot labs/game reports it headless';\n        var record = { code: 'APP_START', message: 'the page failed to start: ' + message, fix: fix };\n        if (window.__engine.errors.length === 0) {\n          var msg = document.getElementById('msg');\n          if (msg) msg.textContent = record.code + ': ' + record.message + '\\nFix: ' + fix;\n        }\n        window.__engine.errors.push(record);\n      }\n      addEventListener('error', function (event) {\n        gameFailed(event.message || 'a script failed');\n      });\n      addEventListener('unhandledrejection', function (event) {\n        gameFailed(String((event.reason && event.reason.message) || event.reason));\n      });\n    </script>\n  </head>\n  <body>\n    <canvas id=\"view\"></canvas>\n    <div id=\"msg\" role=\"status\" aria-live=\"polite\">Loading…</div>\n    <script type=\"module\" src=\"./main.ts\" onerror=\"gameFailed('labs/game/main.ts did not load')\"></script>\n  </body>\n</html>\n------\n/**\n * @file The engine in a page (PLAN.md §6.4, §6.9, §8.3, WP 2.7): `createEngine({ canvas, scenes, levels })` registers\n * the levels the page imported as text, reads the page's routes (engine/app/routes.ts: `?scene ?seed ?cam ?replay`,\n * settings by path, a gallery link `#gallery/<kind>/<id>` with its driver, engine/dev/galleryShoot.ts), starts the\n * scene as a recorded run with its view (engine/app/headless.ts, engine/app/view.ts), publishes the run's inspector\n * as `window.__engine`, starts the renderer (WebGPU or nothing, engine/gfx/renderer.ts) and the post-processing chain\n * every frame and shot is drawn through (engine/gfx/post/chain.ts: the view settings `post.look`, `post.filters` and\n * `post.show`; the look's sky and style, engine/app/look.ts), warms up every pipeline the view needs (`gfx.warmUp`,\n * engine/gfx/warmup.ts), draws the first frame, then runs the frame loop (engine/app/loop.ts): the devices sampled\n * into intents (engine/input/input.ts; `__engine.input` drives the same session), fixed steps from the clock, the\n * view drawn at the clock's alpha; the map follows the camera, the look the view settings `input.*`, the aim the\n * view, and a click takes the pointer lock where the map's mouse looks (WP 13.9).\n *\n * Ready or error (§8.3): `__engine.ready` turns true once the first frame is done on the GPU, never after a startup\n * error; every failure (a frame that throws stops the loop) is one record in `__engine.errors` (the log's), shown as\n * page text by the error overlay (engine/dev/overlay.ts), so a startup crash is one line, never a hang. Without WebGPU\n * (`GFX_NO_WEBGPU`) the sim still runs, and `__engine` still steps it; only `render` and `shot` throw.\n *\n * Every frame drawn is timed by the run's stats meter, which reads the renderer's counts (`__engine.stats()`,\n * engine/dev/stats.ts), and feeds the performance governor (engine/dev/governor.ts: `auto`'s tier by frame rate). The\n * rendering members (engine/app/viewMembers.ts) draw through the page's drawing (engine/app/drawing.ts: `render(n)`,\n * `shot`, and `replay(text)` drawing a frame after every step, §6.7). `?replay=<name>` plays one of `options.replays`\n * in real time from step 0 (without `?scene`, in its own scene if the page has it), then hands back to the devices.\n * The overlay (engine/ui/overlay.ts, `engine.ui`, WP 6.7) shows the sim's hits as damage numbers\n * (engine/app/damageNumbers.ts); `onFrame` runs a page's own presentation (`EngineFrame`). A page's front end (WP\n * 13.25): `store` keeps the bindings across sessions; while `modal()` holds the page (a menu, a photo mode) the devices\n * still read the system layer, but no intent reaches the run; `cameraInput()` is laid over each frame's camera input.\n *\n * Touch (WP 3.12, ADR-0021: built, not tested): the app wires the touch device (engine/input/devices/touch.ts), the\n * page's chrome, the touch layer from `touchLayout` and swiping (engine/ui/), the quality budget's pixel caps\n * (engine/gfx/quality.ts) and, in touch mode, the loop's 60 fps cap; the menu button pauses, then calls `onMenu`.\n *\n * Invariants: rendering never writes the sim (doctrine: WebGPU only): the loop steps the session only with intents and\n * recorded settings; cameras and view settings never reach the hash; time comes from the frames, never a wall clock.\n *\n * @example\n * // const engine = await createEngine({ canvas, scenes: ['box:room'] }); // labs/box/main.ts\n * // engine.ready; // true once the first frame is drawn\n * @see tests/e2e/box.spec.ts\n */\nimport '../dev/members'; // declares the kind inspectorMember before input/devices/inspector registers its members\nimport {\n  codeError,\n  codeInfo,\n  defineCodes,\n  log as sharedLog,\n  type CodeValues,\n  type ErrorRecord,\n  type Log,\n} from '../core/log';\nimport { registry as sharedRegistry, type Registry } from '../core/registry';\nimport type { Settings } from '../core/settings';\nimport { createGalleryDriver, type GalleryDriver } from '../dev/galleryShoot';\nimport { createOverlay } from '../dev/overlay';\nimport { createMaterialLibrary } from '../gfx/materials/library';\nimport { createStyleSet } from '../gfx/materials/styles';\nimport type { QualitySetting } from '../gfx/quality';\nimport { createPost } from '../gfx/post/chain';\nimport { definePostSettings } from '../gfx/post/settings';\nimport { createRenderer } from '../gfx/renderer';\nimport { warmsAsked } from '../gfx/warmup';\nimport type { CameraInput } from '../gfx/cameras/pose';\nimport { connectVirtualDevice } from '../input/devices/inspector';\nimport { createInput, type CameraLike, type Input } from '../input/input';\nimport { lookOptions } from '../input/look';\nimport type { TouchSetting } from '../input/devices/touch';\nimport { createChrome } from '../ui/chrome';\nimport { attachSwipes } from '../ui/swipe';\nimport { createTouchLayer, getTouchLayout, type TouchLayout } from '../ui/touch';\nimport type { Inspector } from '../dev/inspector';\nimport { createOverlay as createUi, type Overlay } from '../ui/overlay';\nimport { createDamageNumbers } from './damageNumbers';\nimport { createPageDrawing, type EngineFrame, type PageParts } from './drawing';\nimport { createPageLook } from './look';\nimport { createAppHost, type AppRun } from './headless';\nimport { createLoop, type Loop } from './loop';\nimport { textStorage, type Store } from './store';\nimport { createPlayback, type Playback } from './playback';\nimport { defineLevel } from '../world/level/level';\nimport { parseRoutes, type Routes } from './routes';\nimport { createGovernor, governorMemory } from '../dev/governor';\n\n/** The codes this module raises, with their fixes. */\nexport const ENGINE_CODES = defineCodes('app', {\n  APP_START: {\n    template: 'the page failed to start: {message}',\n    fix: 'the console names the cause; node x shot <page> reports it headless',\n  },\n  APP_FRAME: {\n    template: 'a frame threw, so the loop stopped: {message}',\n    fix: 'the console names the cause; reload the page to start again, or read __engine.state() to see where the run stands',\n  },\n  APP_NO_REPLAY: {\n    template: 'the page has no replay {name}',\n    fix: 'use one of: {names}',\n  },\n  APP_NO_FRAME: {\n    template: 'no frame was drawn in {tries} tries: the warm-up never finished',\n    fix: 'read __engine.errors for GFX_WARMUP_FAILED; node x shot <page> reports it headless',\n  },\n});\n\nexport type { EngineFrame, FrameWorld } from './drawing';\n\n/** How a page starts the engine. */\nexport interface EngineOptions {\n  /** The canvas it draws into; the page sizes it with CSS. */\n  canvas: HTMLCanvasElement;\n  /** The page's scenes, by id (registered with defineScene); `?scene` picks one, the first by default. */\n  scenes: readonly string[];\n  /**\n   * The levels the page's scenes load, by id: their text (Vite's `?raw` import), file and material swaps (the level\n   * entry's `materials`); registered unless already.\n   */\n  levels?: Readonly<Record<string, { text: string; file?: string; materials?: Readonly<Record<string, string>> }>>;\n  /** Replays the page offers by name (`?replay=<name>`): name → its text, loaded when asked for. */\n  replays?: Readonly<Record<string, () => Promise<string>>>;\n  /** The query to read (`location.search`). */\n  search?: string;\n  /** The hash to read (`location.hash`): a gallery deep link, `#gallery/<kind>/<id>` (engine/app/routes.ts). */\n  hash?: string;\n  /** Where scenes, levels, components, settings and materials are declared (the shared registry). */\n  registry?: Registry;\n  /** Where errors and advice go (the shared log). */\n  log?: Log;\n  /** The page's touch buttons, a `touchlayout` id (engine/ui/touch.ts); without it, only the touch stick shows. */\n  touchLayout?: string;\n  /**\n   * The action map the devices read (`actionMap:thirdPerson` by default): its actions are the intents' buttons. A\n   * function gives the map for the camera now (its code, `cam3=first,…`), so each camera mode has its own (WP 13.9).\n   */\n  actionMap?: string | ((camera: string) => string);\n  /** A view action of the map pressed (its `view`: a camera switch, a view's turn), as it happens (WP 13.9). */\n  onView?: (action: string) => void;\n  /** Opens the page's menu, called after the touch menu button has paused the game. */\n  onMenu?: () => void;\n  /** The page's own presentation (its sound): called once per drawn frame, after the draw, with the run to read. */\n  onFrame?: (frame: EngineFrame) => void;\n  /** Where the bindings are kept across sessions (`createStore`, engine/app/store.ts); in memory without it. */\n  store?: Store;","is_error":false}]},"parent_tool_use_id":null,"session_id":"21849288-0c8f-4994-9d0f-3ff83c647ec0","uuid":"91af9726-54f5-4b95-93bc-fdd7160c1fe0","timestamp":"2026-11-05T04:24:15.559Z","tool_use_result":{"stdout":"/**\n * @file The one-file playground, `playground.html` at the root (ADR-0023 amendment 5, the owner's call of\n * 2026-11-02): the playground (labs/playground/) built as one self-contained HTML page, its script and styles inline\n * and nothing fetched, so it opens from disk (file://) in a WebGPU browser, sent as one file. It is how the engine is\n * distributed and how the owner tests it, in place of the Vercel deployment it replaces.\n *\n * `buildOneFile` runs Vite's build on labs/playground/index.html with vite.config.ts's alias (a bare `three` is\n * `three/webgpu`), every dynamic import folded into the one script (`inlineDynamicImports`) and every asset a data URL;\n * `inlineBuild` then puts the script and the stylesheet into the page. The build gives the same bytes on every machine\n * (no path or time goes in: tools/lib/oneFile.test.ts), so `node x html --check` rebuilds it and compares, and the\n * quick gate runs that check (tools/cmd/ci.ts): the committed file matches its sources at every merge.\n *\n * Invariants: the page fetches nothing (`externalRefs` is empty); a `</script` inside the script is written\n * `<\\/script`, which means the same in a string, a template, a regular expression or a comment, and a `<!--` in it, which\n * no such rewrite makes safe, fails the build. Only the playground is in it: its links to the engine's other pages\n * (the Stress Box, the labs index, the labs) are the dev server's from the file, each saying in plain words to run\n * npm run dev first (labs/playground/ui/pages.ts).\n *\n * @example\n * inlineBuild('<script type=\"module\" crossorigin src=\"./a.js\"></script>', { 'a.js': 'go()' }); // '<script type=\"module\">go()</script>'\n * ONE_FILE; // 'playground.html'\n * @see tools/lib/oneFile.test.ts\n * @see tools/cmd/html.ts\n */\nimport { join } from 'node:path';\nimport type { Rollup } from 'vite';\n\n/** The file, from the repository root. */\nexport const ONE_FILE = 'playground.html';\n\n/** The page it is built from. */\nexport const ONE_FILE_PAGE = 'labs/playground/index.html';\n\n/** The note the file opens its head with. */\nexport const ONE_FILE_NOTE = `<!-- ${ONE_FILE}: the my-3dge playground as one self-contained page (https://github.com/michaelcrosato/my-3dge, MIT; it carries three.js, MIT, Rapier, Apache-2.0, and @stdlib functions, Apache-2.0: see lean/LICENSE). Open it in a browser with WebGPU. Written by node x html --write from ${ONE_FILE_PAGE}; never edit it by hand. -->`; // prettier-ignore\n\n/** A module script or stylesheet Vite's page loads from a file. */\nconst LOADED = /<script type=\"module\" crossorigin src=\"([^\"]+)\"><\\/script>|<link rel=\"stylesheet\" crossorigin href=\"([^\"]+)\">/g; // prettier-ignore\n\n/**\n * The page `html` with each script and stylesheet it loads put inline, from `files` (by file name; a reference\n * matches the file whose name it ends with), and `ONE_FILE_NOTE` after its charset. Throws, naming the file, when a\n * reference has no file or a script holds a `<!--`.\n */\nexport function inlineBuild(html: string, files: Readonly<Record<string, string>>): string {\n  const find = (ref: string): string => {\n    const name = Object.keys(files).find((file) => ref.endsWith(`/${file}`) || ref === file || ref === `./${file}`);\n    if (name === undefined) throw new Error(`${ref} is not in the build: the page loads a file Vite did not write`);\n    return files[name];\n  };\n  const inlined = html.replace(LOADED, (_tag, script?: string, style?: string) => {\n    if (style) return `<style>${find(style)}</style>`;\n    const code = find(script!).replaceAll('</script', '<\\\\/script');\n    if (code.includes('<!--')) {\n      throw new Error(`${script} holds \"<!--\", which an inline script cannot: write it apart ('<' + '!--') in the source`); // prettier-ignore\n    }\n    return `<script type=\"module\">${code}</script>`;\n  });\n  return inlined.replace('<meta charset=\"utf-8\" />', (charset) => `${charset}\\n    ${ONE_FILE_NOTE}`);\n}\n\n/** The `src` and `href` attributes of `html` that load something other than a data URL (none, in the one file). */\nexport function externalRefs(html: string): string[] {\n  const outside = html.replace(/<script type=\"module\">[\\s\\S]*?<\\/script>|<style>[\\s\\S]*?<\\/style>/g, '');\n  return [...outside.matchAll(/\\b(?:src|href)=\"([^\"]*)\"/g)].map((match) => match[1]).filter((ref) => !ref.startsWith('data:')); // prettier-ignore\n}\n\n/** Builds the one file from the repository at `root` and returns its text (about 7 MB; about 11 s). */\nexport async function buildOneFile(root: string): Promise<string> {\n  const { build } = await import('vite');\n  const result = await build({\n    root,\n    configFile: false,\n    logLevel: 'warn',\n    base: './',\n    resolve: { alias: [{ find: /^three$/, replacement: 'three/webgpu' }] },\n    build: {\n      write: false,\n      modulePreload: false,\n      cssCodeSplit: false,\n      assetsInlineLimit: () => true,\n      chunkSizeWarningLimit: Infinity,\n      rollupOptions: { input: { playground: join(root, ONE_FILE_PAGE) }, output: { inlineDynamicImports: true } },\n    },\n  });\n  const outputs = (Array.isArray(result) ? result : [result]) as Rollup.RollupOutput[];\n  const files: Record<string, string> = {};\n  let html: string | undefined;\n  for (const item of outputs.flatMap((output) => output.output)) {\n    const text = item.type === 'chunk' ? item.code : typeof item.source === 'string' ? item.source : new TextDecoder().decode(item.source); // prettier-ignore\n    if (item.fileName.endsWith('.html')) html = text;\n    else files[item.fileName] = text;\n  }\n  if (html === undefined) throw new Error(`Vite wrote no page from ${ONE_FILE_PAGE}: check that it exists`);\n  return inlineBuild(html, files);\n}\n\n------\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\" />\n    <meta name=\"theme-color\" content=\"#15171c\" />\n    <link rel=\"stylesheet\" href=\"../../engine/ui/touch.css\" />\n    <link rel=\"icon\" href=\"data:,\" />\n    <title>The starter game: my-3dge</title>\n    <!--\n      The starter game's page (labs/game/README.md): labs/game/main.ts starts the engine on the scene game:play and\n      shows the round in the HUD. Ready or error: until the engine publishes window.__engine, the inline script below\n      records a script that fails to load or throws, and shows it in #msg, so a broken page is one line of text,\n      never a blank one; `node x shot labs/game` reports the same headless.\n    -->\n    <style>\n      html,\n      body {\n        margin: 0;\n        height: 100%;\n        overflow: hidden;\n        background: #15171c;\n      }\n      canvas {\n        display: block;\n        width: 100vw;\n        height: 100vh;\n        height: 100dvh;\n        outline: none;\n        touch-action: none;\n      }\n      #msg {\n        position: fixed;\n        inset: 0;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        padding: 24px;\n        font:\n          18px system-ui,\n          sans-serif;\n        color: #c9ccd4;\n        text-align: center;\n        white-space: pre-line;\n        pointer-events: none;\n      }\n      #msg[hidden] {\n        display: none;\n      }\n    </style>\n    <script>\n      window.__engine = { ready: false, errors: [] };\n      function gameFailed(message) {\n        if (!window.__engine || typeof window.__engine.help === 'function') return; // the engine reports now\n        var fix = 'the console names the cause; node x shot labs/game reports it headless';\n        var record = { code: 'APP_START', message: 'the page failed to start: ' + message, fix: fix };\n        if (window.__engine.errors.length === 0) {\n          var msg = document.getElementById('msg');\n          if (msg) msg.textContent = record.code + ': ' + record.message + '\\nFix: ' + fix;\n        }\n        window.__engine.errors.push(record);\n      }\n      addEventListener('error', function (event) {\n        gameFailed(event.message || 'a script failed');\n      });\n      addEventListener('unhandledrejection', function (event) {\n        gameFailed(String((event.reason && event.reason.message) || event.reason));\n      });\n    </script>\n  </head>\n  <body>\n    <canvas id=\"view\"></canvas>\n    <div id=\"msg\" role=\"status\" aria-live=\"polite\">Loading…</div>\n    <script type=\"module\" src=\"./main.ts\" onerror=\"gameFailed('labs/game/main.ts did not load')\"></script>\n  </body>\n</html>\n------\n/**\n * @file The engine in a page (PLAN.md §6.4, §6.9, §8.3, WP 2.7): `createEngine({ canvas, scenes, levels })` registers\n * the levels the page imported as text, reads the page's routes (engine/app/routes.ts: `?scene ?seed ?cam ?replay`,\n * settings by path, a gallery link `#gallery/<kind>/<id>` with its driver, engine/dev/galleryShoot.ts), starts the\n * scene as a recorded run with its view (engine/app/headless.ts, engine/app/view.ts), publishes the run's inspector\n * as `window.__engine`, starts the renderer (WebGPU or nothing, engine/gfx/renderer.ts) and the post-processing chain\n * every frame and shot is drawn through (engine/gfx/post/chain.ts: the view settings `post.look`, `post.filters` and\n * `post.show`; the look's sky and style, engine/app/look.ts), warms up every pipeline the view needs (`gfx.warmUp`,\n * engine/gfx/warmup.ts), draws the first frame, then runs the frame loop (engine/app/loop.ts): the devices sampled\n * into intents (engine/input/input.ts; `__engine.input` drives the same session), fixed steps from the clock, the\n * view drawn at the clock's alpha; the map follows the camera, the look the view settings `input.*`, the aim the\n * view, and a click takes the pointer lock where the map's mouse looks (WP 13.9).\n *\n * Ready or error (§8.3): `__engine.ready` turns true once the first frame is done on the GPU, never after a startup\n * error; every failure (a frame that throws stops the loop) is one record in `__engine.errors` (the log's), shown as\n * page text by the error overlay (engine/dev/overlay.ts), so a startup crash is one line, never a hang. Without WebGPU\n * (`GFX_NO_WEBGPU`) the sim still runs, and `__engine` still steps it; only `render` and `shot` throw.\n *\n * Every frame drawn is timed by the run's stats meter, which reads the renderer's counts (`__engine.stats()`,\n * engine/dev/stats.ts), and feeds the performance governor (engine/dev/governor.ts: `auto`'s tier by frame rate). The\n * rendering members (engine/app/viewMembers.ts) draw through the page's drawing (engine/app/drawing.ts: `render(n)`,\n * `shot`, and `replay(text)` drawing a frame after every step, §6.7). `?replay=<name>` plays one of `options.replays`\n * in real time from step 0 (without `?scene`, in its own scene if the page has it), then hands back to the devices.\n * The overlay (engine/ui/overlay.ts, `engine.ui`, WP 6.7) shows the sim's hits as damage numbers\n * (engine/app/damageNumbers.ts); `onFrame` runs a page's own presentation (`EngineFrame`). A page's front end (WP\n * 13.25): `store` keeps the bindings across sessions; while `modal()` holds the page (a menu, a photo mode) the devices\n * still read the system layer, but no intent reaches the run; `cameraInput()` is laid over each frame's camera input.\n *\n * Touch (WP 3.12, ADR-0021: built, not tested): the app wires the touch device (engine/input/devices/touch.ts), the\n * page's chrome, the touch layer from `touchLayout` and swiping (engine/ui/), the quality budget's pixel caps\n * (engine/gfx/quality.ts) and, in touch mode, the loop's 60 fps cap; the menu button pauses, then calls `onMenu`.\n *\n * Invariants: rendering never writes the sim (doctrine: WebGPU only): the loop steps the session only with intents and\n * recorded settings; cameras and view settings never reach the hash; time comes from the frames, never a wall clock.\n *\n * @example\n * // const engine = await createEngine({ canvas, scenes: ['box:room'] }); // labs/box/main.ts\n * // engine.ready; // true once the first frame is drawn\n * @see tests/e2e/box.spec.ts\n */\nimport '../dev/members'; // declares the kind inspectorMember before input/devices/inspector registers its members\nimport {\n  codeError,\n  codeInfo,\n  defineCodes,\n  log as sharedLog,\n  type CodeValues,\n  type ErrorRecord,\n  type Log,\n} from '../core/log';\nimport { registry as sharedRegistry, type Registry } from '../core/registry';\nimport type { Settings } from '../core/settings';\nimport { createGalleryDriver, type GalleryDriver } from '../dev/galleryShoot';\nimport { createOverlay } from '../dev/overlay';\nimport { createMaterialLibrary } from '../gfx/materials/library';\nimport { createStyleSet } from '../gfx/materials/styles';\nimport type { QualitySetting } from '../gfx/quality';\nimport { createPost } from '../gfx/post/chain';\nimport { definePostSettings } from '../gfx/post/settings';\nimport { createRenderer } from '../gfx/renderer';\nimport { warmsAsked } from '../gfx/warmup';\nimport type { CameraInput } from '../gfx/cameras/pose';\nimport { connectVirtualDevice } from '../input/devices/inspector';\nimport { createInput, type CameraLike, type Input } from '../input/input';\nimport { lookOptions } from '../input/look';\nimport type { TouchSetting } from '../input/devices/touch';\nimport { createChrome } from '../ui/chrome';\nimport { attachSwipes } from '../ui/swipe';\nimport { createTouchLayer, getTouchLayout, type TouchLayout } from '../ui/touch';\nimport type { Inspector } from '../dev/inspector';\nimport { createOverlay as createUi, type Overlay } from '../ui/overlay';\nimport { createDamageNumbers } from './damageNumbers';\nimport { createPageDrawing, type EngineFrame, type PageParts } from './drawing';\nimport { createPageLook } from './look';\nimport { createAppHost, type AppRun } from './headless';\nimport { createLoop, type Loop } from './loop';\nimport { textStorage, type Store } from './store';\nimport { createPlayback, type Playback } from './playback';\nimport { defineLevel } from '../world/level/level';\nimport { parseRoutes, type Routes } from './routes';\nimport { createGovernor, governorMemory } from '../dev/governor';\n\n/** The codes this module raises, with their fixes. */\nexport const ENGINE_CODES = defineCodes('app', {\n  APP_START: {\n    template: 'the page failed to start: {message}',\n    fix: 'the console names the cause; node x shot <page> reports it headless',\n  },\n  APP_FRAME: {\n    template: 'a frame threw, so the loop stopped: {message}',\n    fix: 'the console names the cause; reload the page to start again, or read __engine.state() to see where the run stands',\n  },\n  APP_NO_REPLAY: {\n    template: 'the page has no replay {name}',\n    fix: 'use one of: {names}',\n  },\n  APP_NO_FRAME: {\n    template: 'no frame was drawn in {tries} tries: the warm-up never finished',\n    fix: 'read __engine.errors for GFX_WARMUP_FAILED; node x shot <page> reports it headless',\n  },\n});\n\nexport type { EngineFrame, FrameWorld } from './drawing';\n\n/** How a page starts the engine. */\nexport interface EngineOptions {\n  /** The canvas it draws into; the page sizes it with CSS. */\n  canvas: HTMLCanvasElement;\n  /** The page's scenes, by id (registered with defineScene); `?scene` picks one, the first by default. */\n  scenes: readonly string[];\n  /**\n   * The levels the page's scenes load, by id: their text (Vite's `?raw` import), file and material swaps (the level\n   * entry's `materials`); registered unless already.\n   */\n  levels?: Readonly<Record<string, { text: string; file?: string; materials?: Readonly<Record<string, string>> }>>;\n  /** Replays the page offers by name (`?replay=<name>`): name → its text, loaded when asked for. */\n  replays?: Readonly<Record<string, () => Promise<string>>>;\n  /** The query to read (`location.search`). */\n  search?: string;\n  /** The hash to read (`location.hash`): a gallery deep link, `#gallery/<kind>/<id>` (engine/app/routes.ts). */\n  hash?: string;\n  /** Where scenes, levels, components, settings and materials are declared (the shared registry). */\n  registry?: Registry;\n  /** Where errors and advice go (the shared log). */\n  log?: Log;\n  /** The page's touch buttons, a `touchlayout` id (engine/ui/touch.ts); without it, only the touch stick shows. */\n  touchLayout?: string;\n  /**\n   * The action map the devices read (`actionMap:thirdPerson` by default): its actions are the intents' buttons. A\n   * function gives the map for the camera now (its code, `cam3=first,…`), so each camera mode has its own (WP 13.9).\n   */\n  actionMap?: string | ((camera: string) => string);\n  /** A view action of the map pressed (its `view`: a camera switch, a view's turn), as it happens (WP 13.9). */\n  onView?: (action: string) => void;\n  /** Opens the page's menu, called after the touch menu button has paused the game. */\n  onMenu?: () => void;\n  /** The page's own presentation (its sound): called once per drawn frame, after the draw, with the run to read. */\n  onFrame?: (frame: EngineFrame) => void;\n  /** Where the bindings are kept across sessions (`createStore`, engine/app/store.ts); in memory without it. */\n  store?: Store;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_018kayj2qkmnaMZtuLawrrRP","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
