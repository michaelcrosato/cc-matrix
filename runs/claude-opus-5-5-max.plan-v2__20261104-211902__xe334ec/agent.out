{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ENe3DPLGYtujYkeAkpANaT","type":"tool_result","content":"85:export interface EngineFrame {\n86-  /** The run's world: the same object until the run starts again (a new seed, a replay), so a reader compares it. */\n87-  readonly world: FrameWorld;\n88-  /** The running scene: its id, its level and whether it has physics. */\n89-  readonly scene: Scene;\n90-  /** The camera's pose this frame: where a listener goes. */\n91-  readonly camera: CameraPose;\n92-  /** The sim's physics queries, read-only, in a physics scene; null without physics. */\n93-  readonly queries: QueryView | null;\n94-  /** Real seconds since the last frame. */\n95-  readonly dt: number;\n96-  /** The value setting `key` has now, view settings among them (`x set`, `__engine.set`, the URL). */\n97-  setting(key: string): unknown;\n98-  /**\n99-   * Runs emitter `id` at its rate times `scale` (1) at `at` (m) for the next frame, `key` naming it so its fractions\n100-   * and light carry over: rain over the player, a fire in a hearth (engine/gfx/fx/effects.ts `emit`). An emitter that\n101-   * says `gpu` has its particles on the GPU's ring where `feature:gpuParticles` is on (WP 11.3). Presentation only.\n102-   */\n103-  emit(id: string, at: readonly [number, number, number], key: string, scale?: number): void;\n104-}\n105-\n106-/** What `createPageDrawing` draws with besides the parts. */\n107-export interface PageDrawingOptions {\n108-  /** The page's chrome: its touch class and top panel. */\n109-  chrome: Chrome;\n110-  /** The current run's settings (`quality`). */\n111-  settings: Settings;\n112-  /** The page's own presentation, after each drawn frame. */\n113-  onFrame?: (frame: EngineFrame) => void;\n----\n----\n33:// Materials and procedural textures (WP 2.3): materials as data with three.js's classic parameters, seeded tiling\n167:// frame (three.js's CSS2DRenderer pattern), HUD lines and a crosshair over the canvas; ui.state() for tests.\n297:// Clips in pages (WP 8.4): three.js's AnimationClip and AnimationMixer, for presentation only (a page plays a baked\n300:/** three.js's animation clip: `AnimationClip.parse(clipJSON(baked, skeleton))` makes one from a baked clip. */\n301:export { AnimationClip } from 'three/webgpu';\n302:/** three.js's animation mixer: plays clips on an object's bones (a puppet's mesh), for presentation only. */\n303:export { AnimationMixer } from 'three/webgpu';\n/**\n * @file The animation library on the box page (PLAN.md §10, WP 8.9): `loadLibrary(files)` registers every set of\n * `data/anim/sets/` the page loaded as text (labs/box/clipFiles.ts, one chunk through `import.meta.glob`, never a\n * fetch), each as a\n * `clipset` entry (engine/anim/clip/clipsets.ts: its `_set.json` and its clip files joined, `clipSetFromFiles`), then\n * the mannequin, its build and body, from the Quaternius set (engine/gfx/puppets/bodies/mannequin.ts): what clip mode\n * (labs/box/scenes/clips.ts) plays and draws. The page calls it before it opens clip mode; no other scene loads it.\n * tests/pages/replay.ts calls it too, so clip mode's replays play in the sim page as here; Node registers the same\n * entries through tools/anim/library.ts. The lab pages register through here too (WP 10.8), so no page entry calls a\n * `define…` itself: `loadMannequin(text)`, the mannequin alone from the Quaternius set's `_set.json` text (labs/anim/,\n * labs/index/gallery.ts), and `registerEdit`, a clip's edited text played as a set of its own (labs/library/).\n *\n * Invariants: the sets register sorted by directory, each once (`defineClipSet` keeps a set registered already); the\n * module does nothing at its top level, so tools that import it in Node (`x describe`) load it as it is.\n *\n * Game code, a page's: it imports only engine/index.ts.\n *\n * @example\n * // await loadLibrary((await import('./clipFiles')).CLIP_FILES); // __engine.describe('clipset').ids: ['clipset:cmu', …]\n */\nimport { clipSetFromFiles, defineClipSet, defineMannequin, getClipSet, parseClip } from '../../engine';\n\n/** Registers the sets in `files` (path → its text, loaded on demand), then the mannequin from the Quaternius set. */\nexport async function loadLibrary(files: Readonly<Record<string, () => Promise<string>>>): Promise<string[]> {\n  const dirs: Record<string, Record<string, string>> = {};\n  const read = async ([path, load]: [string, () => Promise<string>]) => {\n    const [dir, file] = path.split('/').slice(-2);\n    (dirs[dir] ??= {})[file] = await load();\n  };\n  await Promise.all(Object.entries(files).map(read));\n  const ids = Object.keys(dirs)\n    .sort()\n    .map((dir) => defineClipSet(clipSetFromFiles(dirs[dir], `data/anim/sets/${dir}`)).id);\n  defineMannequin(getClipSet('clipset:quaternius'));\n  return ids;\n}\n\n/** Registers the mannequin, its build and body, from the Quaternius set's `_set.json` text (the page's `?raw`). */\nexport function loadMannequin(text: string): void {\n  defineMannequin(JSON.parse(text) as Parameters<typeof defineMannequin>[0]);\n1.1M\tdata/anim/sets/cmu\n1.5M\tdata/anim/sets/mesh2motion\n780K\tdata/anim/sets/quaternius\n656K\tdata/anim/sets/style100\n536K\tdata/anim/sets/style100_back\n492K\tdata/anim/sets/style100_backrun\n500K\tdata/anim/sets/style100_idle\n604K\tdata/anim/sets/style100_run\n1.1M\tdata/anim/sets/style100_side\n1.1M\tdata/anim/sets/style100_siderun\n179\n{\"clip\": \"Meditate\", \"src\": \"M2M_ANIMATED\", \"dur\": 1.5, \"loop\": true, \"tags\": [\"sit\",\"rest\",\"idle\"], \"desc\": \"sits cross-legged, hands on the knees, b\n  {\"t\":0,\n   \"hips\":[-44,0,5], \"body\":[0,-16,0], \"chest\":[0,15,0], \"head\":[0,-1,0],\n   \"shL\":[0,0], \"shR\":[0,0], \"armL\":[77,17,-61,58,23], \"armR\":[76,27,-59,77,-30], \"handL\":[16,-2,-90], \"handR\":[8,-3,-90], \"gripL\":24, \"gripR\":29,\n   \"legL\":[72,-66,-22,141,41], \"legR\":[89,-40,-24,127,-49], \"footL\":[-22,-61,0], \"footR\":[-16,-77,0], \"rollL\