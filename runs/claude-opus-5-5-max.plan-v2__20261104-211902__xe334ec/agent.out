{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TrqdyyguRpU9atrryLPTxq","type":"tool_result","content":"/**\n * @file The humanoid's effector layers (PLAN.md WP 3.6, §5.2; I-09): for the names it takes (engine/anim/poseNames.ts:\n * `POSES`, `STANCES`, `WEAPONS`), the ordered tables that lay each pose, stance and state over the gait's targets:\n * `FOOT_LAYERS` for the soles, `HAND_LAYERS` for the wrists, `BLADE_LAYERS` for the weapon's direction.\n *\n * Invariants:\n * - A table's order is the priority: each layer moves the target toward its own by its weight (my-3d2dge's\n *   `V3.lerp`), or adds its offset, in turn, so a later layer wins. `layerWeights` lists every layer's weight now.\n * - Targets are rig-local metres before `size`, in the model frame, written `[forward, right, up]` (authoring.ts);\n *   blade directions are unit-free. Each row is the source's numbers ÷ 16 where they are lengths.\n * - The poses `die` and `down` have no layer here: they drive the down weight and the die timeline (humanoid.ts).\n * - What the view shows of the movement (WP 13.10) lies in both tables (locomotion/shown.ts `SHOWN_FOOT_LAYERS`, after\n *   the crouch, which a planted stride walks on through, and `SHOWN_HAND_LAYERS`, after the air): it weighs nothing on\n *   a body that shows nothing.\n * - Pure functions of the `EffectorContext`; the warnings go through the engine's log, once per name.\n *\n * Carried from `my-3d2dge:engine/my-3d2dge.js:1924-1937` (the feet's pose targets) and `:1955-1968` (the hands'),\n * and `:1979-1988` (the weapon's direction). The camera-side wave (`_camSide`) is gone: the free hand waves.\n *\n * @example\n * import { getBuild } from './builds';\n * import { restContext } from './locomotion';\n * const ctx = restContext(getBuild('build:heroic'));\n * layerWeights(HAND_LAYERS, ctx).every((w) => w.weight === 0); // true: nothing held at rest\n * @see engine/anim/poses.test.ts\n */\nimport { Vector3 } from '../core/math';\nimport { B, fromFRU, SIDES, sideSign, type FRU, type LimbSide, type Sided } from './authoring';\nimport {\n  gaitFoot,\n  gaitHand,\n  headDirection,\n  hipTarget,\n  pelvisTarget,\n  shoulderTarget,\n  spineDirection,\n} from './locomotion';\nimport type { EffectorContext } from './locomotion';\nimport { plantedEase } from './locomotion/planted';\nimport { WEAPONS, type Weapon } from './poseNames';\nimport { SHOWN_FOOT_LAYERS, SHOWN_HAND_LAYERS } from './locomotion/shown';\nimport { armBlade, layArm } from './strike';\n\n/** Places a layer's target for `side` (rig-local, model frame), given the target so far; an `add` layer's offset. */\nexport type Placement = (ctx: EffectorContext, side: LimbSide, current: Vector3, out: Vector3) => Vector3;\n\n/** One layer of an effector table. */\nexport interface EffectorLayer {\n  /** The pose, stance or state it shows. */\n  readonly name: string;\n  /** Its weight now on `side`, 0 to 1. */\n  readonly weight: (ctx: EffectorContext, side: LimbSide) => number;\n  /** Where it puts the target. */\n  readonly at: Placement;\n  /** `blend` (the default) moves the target toward `at` by the weight; `add` adds `at` times the weight. */\n  readonly mode?: 'blend' | 'add';\n}\n\n/** A fixed rig-local target per side. */\nconst fixed =\n243:  layers: readonly EffectorLayer[],\n244:  ctx: EffectorContext,\n245:  side: LimbSide,\n246:  current: Vector3,\n260:  layers: readonly EffectorLayer[],\n261:  ctx: EffectorContext,\ntools/templates/README.md\n\ntools/templates:\nREADME.md\naction\nbody\nbuild\ncamera\ncourse\nemitter\nfeature\ngeometry\ninteractable\nlevel\nlook\nmaterial\nmodule\nmove\nmovement\nprop\nrig\nscene\nsfx\nsong\ntelegraph\ntexture\nthing\nweapon\n\ntools/templates/action:\naction.test.ts.tmpl\naction.ts.tmpl\ntemplate.json\n\ntools/templates/body:\nbody.test.ts.tmpl\nbody.ts.tmpl\ntemplate.json\n\ntools/templates/build:\nbuild.test.ts.tmpl\nbuild.ts.tmpl\ntemplate.json\n\ntools/templates/camera:\ncamera.test.ts.tmpl\ncamera.ts.tmpl\ntemplate.json\n\ntools/templates/course:\ncourse.test.ts.tmpl\ncourse.ts.tmpl\ntemplate.json\n\ntools/templates/emitter:\nemitter.test.ts.tmpl\nemitter.ts.tmpl\ntemplate.json\n\ntools/templates/feature:\n/**\n * @file Unit tests for the action `action:{{name}}` ({{id}}.ts): it is defined, plays every beat to its end, and its\n * check passes animCheckBody on a heroic body with a sword.\n * @see {{id}}.ts\n */\nimport { describe, expect, it } from 'vitest';\nimport { actionCheck, Actions, animCheckBody, Animator } from '../../../engine/sim-api';\nimport { {{name}} } from './{{name}}';\n\ndescribe('action:{{name}}', () => {\n  it('is defined, and plays every beat to its end', () => {\n    expect({{name}}.id).toBe('action:{{name}}');\n    const acts = new Actions().play({{name}});\n    const begun: string[] = [];\n    for (let tick = 0; tick < 600 && acts.beat; tick++) {\n      for (const event of acts.step()) if (event.type === event.phase) begun.push(event.type); // each beat as it begins\n    }\n    expect(begun).toEqual({{name}}.beats.map((beat) => beat.name));\n    expect(acts.state.playing).toBe('');\n  });\n\n  it('passes its check: finite, on the floor, in reach, the same hash twice, 1/60 s against 1/120 s', () => {\n    const hero = (dt: number) => new Animator({ build: 'build:heroic', weapon: 'sword', clock: 1, dt });\n    expect(animCheckBody(hero, { states: { [{{name}}.id]: actionCheck({{name}}) } }).problems).toEqual([]);\n  });\n});\n/**\n * @file The action `action:{{name}}`: what sequence it is (replace this text; `x docs` puts the first sentence in INDEX).\n *\n * Invariants: each beat lasts its seconds and eases its channels to its own over them; effector targets are\n * `[forward, right, up]` metres, the hands' and the gaze's from the shoulder centre, the soles' from the ground; a beat\n * held `until: 'next'` or a loop needs `check.signals` (node x describe action lists the fields; data/anim/actions/\n * holds the engine's set, each a worked example).\n *\n * @example\n * {{name}}.id; // 'action:{{name}}'\n * @see {{id}}.test.ts\n */\nimport { defineAction } from '../../../engine/sim-api';\n\n/** The action `action:{{name}}`: replace this sentence with what sequence it is. */\nexport const {{name}} = defineAction('action:{{name}}', {\n  desc: 'Replace with what it is and where its timing comes from.',\n  beats: [\n    { name: 'wind', seconds: 0.15, motion: { lean: 0.15 } },\n    { name: 'reach', seconds: 0.2, effectors: { handR: [0.4, 0.15, -0.1] }, events: [{ type: 'contact', at: 1 }] },\n    { name: 'hold', seconds: 0.25, effectors: { handR: [0.4, 0.15, -0.1] } },\n    { name: 'recover', seconds: 0.2, cancel: { by: ['any'] } },\n  ],\n});\nbackflip.json\nbored.json\ncharge.json\n{\n  \"action\": \"backflip\",\n  \"desc\": \"A backflip (SM64: up 62, back 16): a crouch, one backward turn in the air, the landing squash. The game makes the jump.\",\n  \"beats\": [\n    {\n      \"name\": \"crouch\",\n      \"seconds\": 0.1,\n      \"motion\": { \"crouch\": 0.5, \"lean\": -0.1 },\n      \"events\": [{ \"type\": \"takeoff\", \"at\": 1 }]\n    },\n    {\n      \"name\": \"flip\",\n      \"seconds\": 0.5,\n      \"body\": { \"air\": true },\n      \"motion\": { \"crouch\": 0.4 },\n      \"flip\": { \"turns\": 1, \"axis\": \"back\" }\n    },\n    { \"name\": \"land\", \"seconds\": 0.15, \"motion\": { \"crouch\": 0.5, \"lean\": 0.2 }, \"events\": [{ \"type\": \"land\" }] },\n    { \"name\": \"recover\", \"seconds\": 0.15, \"cancel\": { \"by\": [\"any\"] } }\n  ],\n  \"check\": {\n    \"lift\": [\n      [0.1, 0],\n      [0.35, 0.9],\n      [0.6, 0]\n    ]\n  }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"21849288-0c8f-4994-9d0f-3ff83c647ec0","uuid":"9d64b27e-3b4b-42dc-a864-1da282608adf","timestamp":"2026-11-05T04:38:16.012Z","tool_use_result":{"stdout":"/**\n * @file The humanoid's effector layers (PLAN.md WP 3.6, §5.2; I-09): for the names it takes (engine/anim/poseNames.ts:\n