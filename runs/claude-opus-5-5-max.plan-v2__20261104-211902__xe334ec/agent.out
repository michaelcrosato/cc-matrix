type { EffectorContext } from './locomotion';\nimport { plantedEase } from './locomotion/planted';\nimport { WEAPONS, type Weapon } from './poseNames';\nimport { SHOWN_FOOT_LAYERS, SHOWN_HAND_LAYERS } from './locomotion/shown';\nimport { armBlade, layArm } from './strike';\n\n/** Places a layer's target for `side` (rig-local, model frame), given the target so far; an `add` layer's offset. */\nexport type Placement = (ctx: EffectorContext, side: LimbSide, current: Vector3, out: Vector3) => Vector3;\n\n/** One layer of an effector table. */\nexport interface EffectorLayer {\n  /** The pose, stance or state it shows. */\n  readonly name: string;\n  /** Its weight now on `side`, 0 to 1. */\n  readonly weight: (ctx: EffectorContext, side: LimbSide) => number;\n  /** Where it puts the target. */\n  readonly at: Placement;\n  /** `blend` (the default) moves the target toward `at` by the weight; `add` adds `at` times the weight. */\n  readonly mode?: 'blend' | 'add';\n}\n\n/** A fixed rig-local target per side. */\nconst fixed =\n243:  layers: readonly EffectorLayer[],\n244:  ctx: EffectorContext,\n245:  side: LimbSide,\n246:  current: Vector3,\n260:  layers: readonly EffectorLayer[],\n261:  ctx: EffectorContext,\ntools/templates/README.md\n\ntools/templates:\nREADME.md\naction\nbody\nbuild\ncamera\ncourse\nemitter\nfeature\ngeometry\ninteractable\nlevel\nlook\nmaterial\nmodule\nmove\nmovement\nprop\nrig\nscene\nsfx\nsong\ntelegraph\ntexture\nthing\nweapon\n\ntools/templates/action:\naction.test.ts.tmpl\naction.ts.tmpl\ntemplate.json\n\ntools/templates/body:\nbody.test.ts.tmpl\nbody.ts.tmpl\ntemplate.json\n\ntools/templates/build:\nbuild.test.ts.tmpl\nbuild.ts.tmpl\ntemplate.json\n\ntools/templates/camera:\ncamera.test.ts.tmpl\ncamera.ts.tmpl\ntemplate.json\n\ntools/templates/course:\ncourse.test.ts.tmpl\ncourse.ts.tmpl\ntemplate.json\n\ntools/templates/emitter:\nemitter.test.ts.tmpl\nemitter.ts.tmpl\ntemplate.json\n\ntools/templates/feature:\n/**\n * @file Unit tests for t