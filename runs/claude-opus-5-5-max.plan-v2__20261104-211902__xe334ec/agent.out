e.state() to see where the run stands',\n----\n86:    template: 'the page failed to start: {message}',\n87:    fix: 'the console names the cause; node x shot <page> reports it headless',\n90:    template: 'a frame threw, so the loop stopped: {message}',\n91:    fix: 'the console names the cause; reload the page to start again, or read __engine.state() to see where the run stands',\n94:    template: 'the page has no replay {name}',\n95:    fix: 'use one of: {names}',\n98:    template: 'no frame was drawn in {tries} tries: the warm-up never finished',\n99:    fix: 'read __engine.errors for GFX_WARMUP_FAILED; node x shot <page> reports it headless',\n108:  canvas: HTMLCanvasElement;\n110:  scenes: readonly string[];\n115:  levels?: Readonly<Record<string, { text: string; file?: string; materials?: Readonly<Record<string, string>> }>>;\n117:  replays?: Readonly<Record<string, () => Promise<string>>>;\n119:  search?: string;\n121:  hash?: string;\n123:  registry?: Registry;\n125:  log?: Log;\n127:  touchLayout?: string;\n132:  actionMap?: string | ((camera: string) => string);\n134:  onView?: (action: string) => void;\n136:  onMenu?: () => void;\n138:  onFrame?: (frame: EngineFrame) => void;\n140:  store?: Store;\n142:  modal?: () => boolean;\n144:  cameraInput?: () => CameraInput | undefined;\n160:  stop(): void;\n165:  playback?: Playback;\n166:  error?: unknown;\n186:    get(_, key: keyof Settings) {\n234:    info: () => ({ page: location.pathname, headless: true }),\n253:    stop: () => loop?.stop(),\n272:    definePostSettings(registry);\n291:    fail(error);\n312:    yaw: () => viewNow().camera.yaw(),\n313:    pose: () => viewNow().camera.pose(),\n314:    aim: (rule, devices) => viewNow().aim(rule, devices),\n328:  attachSwipes(document);\n329:  connectVirtualDevice(started.host, input.virtual);\n333:    fail(error);\n345:    viewNow().stage.register(gfx.warmup, gfx.features);\n349:    fail(error);\n362:    clock: () => started.clock,\n365:    draw: ({ alpha, dt })