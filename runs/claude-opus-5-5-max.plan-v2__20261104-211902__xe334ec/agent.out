character';\n * import { REST, standing } from '../../../tests/unit/anim/clip-fixtures';\n * import { loadClipLibrary } from './library';\n * const up = { ...standing(0.25), armR: [0, 30, 100, 0, 0] };\n * const wave = { src: 'A', dur: 0.5, keys: [standing(0), up, standing(0.5)] };\n * const library = loadClipLibrary({ set: 'TEST', sources: { A: { rest: REST } }, clips: { Wave: wave } });\n * const clips = new ClipLayer({ library, build: 'build:heroic' });\n * const hero = new Animator({ build: 'build:heroic' }).use('clips', clips);\n * clips.play('Wave', { mask: 'upper', walk: true }); // a wave over whatever the legs do\n * for (let i = 0; i < 12; i++) [hero.step(), clips.step({ groundSpeed: 0 })]; // the sim's ticks\n * hero.pose(); // the view: the body's own pose, then the wave laid over it\n * clips.current?.w; // 1: faded in over 0.12 s\n * @see engine/anim/clip/layer-play.test.ts (the play options; layer.test.ts, beside this file, tests the rest)\n */\nimport { codeError, didYouMean } from '../../core/log';\nimport { MathUtils, Quaternion, Vector3 } from '../../core/math';\nimport { SIM_DT } from '../../core/time';\nimport { getBuild, type Build } from '../builds';\nimport type { Animator } from '../character';\nimport { createWorldPose } from '../fk';\nimport { addPose, blendPoses, makeAdditive, Pose } from '../pose';\nimport { boneMask, createSkeleton, type Skeleton } from '../skeleton';\nimport type { AnimLayer } from '../weights';\nimport { travelAt, type BakedClip } from './bake';\nimport { clipPace, GROUND_SPEED, runOverWalk, walkRate, type ClipLibrary } from './library';\nimport type { Clip } from './readable';\nimport { CLIP_LAYER, type ClipLayerEvent, type ClipLayerOptions, type ClipLayerState, type ClipPlay, type ClipSlot, type ClipStepInput } from './layerData'; // prettier-ignore\nimport { hipRatio, retargetPose } from './retarget';\n\nexport { CLIP_LAYER } from './layerData';\nexport type { ClipLayerEvent, ClipLayerOptions, ClipLayerState, ClipPlay, ClipSlot, ClipStepInput } from './layerData';\n\nconst [clipPose, reference, delta, world] = [new Pose(), new Pose(), new Pose(), createWorldPose()];\nconst [UP, yaw, from, to] = [new Vector3(0, 1, 0), new Quaternion(), new Vector3(), new Vector3()];\n----\n7: * stop a clip on it (the layer's `play` and `stop`), `seekClip(w, id, t)` puts the clip on top at a moment (a frame\n42:export function defineClipKinds(registry: Registry = sharedRegistry): void {\n93:export function clipsFor<C extends object>(world: World<C>, spec: ClipsSpec, build: Build | string): ClipsData {\n109:export function addClips<C extends object>(world: World<C>, id: number, spec: ClipsSpec): ClipsData {\n129:export function playClip<C extends object>(world: World<C>, id: number, clip: string, play?: ClipPlay): ClipLayerState {\n134:export function stopClip<C extends object>(world: World<C>, id: number, fade?: number): ClipLayerState {\n139:export function locomoteClips<C extends object>(\n149: * is `seekClip(w, id, frame / BAKE_FPS)`. Nothing playing, it changes nothing.\n151:export function seekClip<C extends object>(world: World<C>, id: number, t: number): ClipLayerState {\n152:  return change(world as unknown as World, id, 'seekClip(w, id, t)', (layer) => {\n162:export function clipLayerOf<C extends object>(world: World<C>, id: number): ClipLayer {\n---\n/**\n * @file Readable key poses, the stored clip format (PLAN.md §10.2, WP 8.2; ADR-0010): its types, format 1 and the\n * fields format 2 adds, and the decode that rebuilds 36 body points from a key pose on a measured rest body. Ported\n * from `my-3d2dge:src/mocap/readable.js` with no change in behaviour, on the standard `Math` the source uses: every\n * curated clip decodes within 0.001 mm of the source decoder (tools/anim/legacy-readable.ts, the oracle).\n *\n * A key names what an animator would: where the hips are, how the body, chest and head turn, lean and tilt, how the\n * shoulders reach and shrug, which way each limb points with its bend and twist, and how the feet point (lens.ts's\n * `LEGEND`). Limbs are a direction plus a bend, so the same clip fits any build and mirrors by swapping L and R.\n * Between keys every stored number is in-betweened linearly; loops wrap, one-shots hold their last pose (`keyAt`).\n *\n * Invariants: a format-1 key decodes as the source's does; format 2's key fields are carried, in-betweened, mirrored\n * and printed, and decoded with the encode that writes them (WP 8.8, ADR-0010 amendment 7): a hand's turn and grip\n * place its four points (hands.ts), a foot's roll its toes (feet.ts), the spine override the spine's middle bones\n * (frames.ts `torso`). The frame math and `torso` are frames.ts's, which the encode (encode.ts)\n * shares, as the source shares them. Points are millimetres in the rig frame: f forward, r right, z up. validate.ts\n * reads clips and sets in (and types the `RestBody` their sources measured); lens.ts prints them; mirror.ts mirrors\n * them.\n *\n * @example\n * import { REST, standing } from '../../../tests/unit/anim/clip-fixtures'; // a measured rest body, a standing key\n * const clip = { dur: 1, keys: [standing(0), { ...standing(1), hips: [0, 0, 80] }] };\n * keyAt(clip, 0.5).hips; // [0, 0, 90]: every number in-betweened\n * const points = samplePose(REST, clip, 0.5); // a Float32Array: 36 points × [f, r, z], mm\n * points[POINT_INDEX.pelvis * 3 + 2]; // 825.03: 90% of the standing pelvis height, REST.H0\n * @see engine/anim/clip/readable.test.ts\n */\nimport { add, cross, DG, dot, hintFor, len, limbEnd, mul, norm, reachOf, SG, sub, torso, wld, type V } from './frames';\nimport { rolledToe } from './feet';\nimport { placeHand } from './hands';\nimport { KEY_ARRAYS, KEY_NUMBERS } from './lens';\nimport type { RestBody } from './validate';\n\n/** Three numbers: a point or direction `[f, r, z]`, or `[turn, lean, tilt]` in degrees. */\nexport type Triple = [number, number, number];\n/** A limb: `[forward, out, up]` as percentages (need not add up), then the bend and twist in degrees. */\nexport type LimbPose = [forward: number, out: number, up: number, bend: number, twist: number];\n\n/** One key pose. Format 1's fields, then format 2's (all optional). Angles in degrees, distances in % of hip height. */\nexport interface ClipKey {\n  /** Seconds from the clip's start. */\n  t: number;\n  /** The pelvis `[forward, right, up]`, % of standing hip height (100 = standing). */\n  hips: Triple;\n  /** The pelvis `[turn, lean, tilt]`: turn + toward the right, lean + forward, tilt + toward the right. */\nlabs/box/library.ts:5: * `clipset` entry (engine/anim/clip/clipsets.ts: its `_set.json` and its clip files joined, `clipSetFromFiles`), then\nlabs/box/library.ts:10: * `define…` itself: `loadMannequin(text)`, the mannequin alone from the Quaternius set's `_set.json` text (labs/anim/,\nlabs/box/library.ts:38:/** Registers the mannequin, its build and body, from the Quaternius set's `_set.json` text (the page's `?raw`). */\nengine/anim/clip/clipsets.ts:50:const SET_FILE = '_set.json';\nengine/anim/clip/clipsets.ts:92:      \"defineClipSet({ set: 'NAME', sources: { … }, clips: { … } }) with a set's _set.json and its clip files\",\n/**\n * @file Clip sets in the registry, and clip layers kept as plain data (PLAN.md §10.4, WP 8.9): the registry kind\n * `clipset`, one entry per set of readable clips (`clipset:quaternius`: the set's header and its clips), which the\n * reader registers, as levels and actions are (the engine imports nothing outside engine/: a page imports the files of\n * `data/anim/sets/<set>/` with `import.meta.glob`, a Node tool reads them, tools/anim/library.ts), so\n * `__engine.describe('clipset')` and `x describe clipset` list them; and `ClipLayerPool`, the clip layer (layer.ts) of\n * an entity, loaded from its plain data at every `get`, as `AnimatorPool` keeps animators (character.ts), so the sim\n * steps it and the view poses it from the same numbers.\n *\n * - `defineClipSet(set)` parses the set (validate.ts `parseClipSet`: a broken clip is refused with its `ANIM_CLIP_*`\n *   code) and registers it as `clipset:<set, lower case>`; the same set again returns the entry already there.\n *   `clipSetFromFiles(files)` joins a set directory's files into one set first (a page's import of the files);\n *   `getClipSet(id)` is one, `clipSetIds()` lists them; `defineSetBuild(id, setId)` registers the build a set's clips\n *   were captured on (`build:mannequin`).\n * - `ClipLayerPool.library(id)` loads a set for playing (library.ts `loadClipLibrary`) once per pool: the sim keeps a\n *   pool per world and the view its own, so a bake made while the sim steps (under its fdlibm maths) is never one the\n *   view made, and the reverse.\n * - `CLIPS_FIELDS` are the fields of an actor's component `clips` (engine/sim/actors.ts): the sets it plays from, its\n *   contact IK and blade, and the layer's state (`ClipLayerState`), which the sim's step changes and the hash covers.\n * - `legsHeld(layer)`: how much of the legs a layer's clips hold now, which the view's foot plant leaves them (WP 13.10).\n *\n * Invariants: an entry is the parsed set, frozen; clip names are the set's own, played as `SET/Clip` (or bare: the\n * first set's with that name, layer.ts). A pool's layer is made again only when its make (build, sets, IK, blade,\n * step) changes, and is loaded from the data at every `get`, so it keeps nothing of its own between calls.\n *\n * @example\n * import { createRegistry } from '../../core/registry';\n * import { REST, standing } from '../../../tests/unit/anim/clip-fixtures';\n * const registry = createRegistry();\n * const set = { set: 'TEST', sources: { A: { rest: REST } }, clips: { Stand: { src: 'A', dur: 1, keys: [standing(0)] } } };\n * defineClipSet(set, { registry }).id; // 'clipset:test'\n * const pool = new ClipLayerPool(registry);\n * const data = { sets: ['clipset:test'], ik: true, blade: 0, state: emptyClipState() };\n * pool.get(1, data, 'build:heroic').play('Stand').save().slots[0].clip; // 'TEST/Stand'\n * @see engine/anim/clip/clipsets.test.ts\n */\nimport { registry as sharedRegistry, sameValue, type Registry } from '../../core/registry';\nimport { defineSchema } from '../../core/schema';\nimport { codeError } from '../../core/log';\nimport { MathUtils } from '../../core/math';","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01W4vHZQy4XG2RTxRWdwPFgZ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
