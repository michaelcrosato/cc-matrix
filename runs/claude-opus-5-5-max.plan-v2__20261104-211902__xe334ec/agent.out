percent of standing hip height a second\",\n40-  'format 2, each optional: handL handR [flex, side, roll] at the wrist; rollL rollR (foot roll); yaw (root); spine [turn, lean, tilt]; gripL gripR (0-100)',\n41-];\n42-\n43-/** Each array field of a key: its length and its shape, as an error names it. */\n44-export const KEY_ARRAYS: Record<string, [size: number, shape: string]> = {\n45-  hips: [3, '[forward, right, up] in % of standing hip height'],\n46-  ...Object.fromEntries(['body', 'chest', 'head', 'spine'].map((f) => [f, [3, '[turn, lean, tilt] in degrees']])),\n47-  ...Object.fromEntries(['shL', 'shR'].map((f) => [f, [2, '[reach, shrug] in degrees']])),\n48-  ...Object.fromEntries(['armL', 'armR', 'legL', 'legR'].map((f) => [f, [5, '[forward, out, up, bend, twist]']])),\n49-  ...Object.fromEntries(['footL', 'footR'].map((f) => [f, [3, '[down, out, toes] in degrees']])),\n50-  blade: [3, '[forward, right, up], the blade’s direction'],\n51-  root: [2, '[forward, right] in % of standing hip height'],","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01U2qM1tTEp6V1S7fQkzPpe1","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
