le.mjs ../serve/game3.html | tail -1; node ../probe-tools/verify-client.mjs ../serve/game3.html ../ai-hub/scripts/lib/hub-client.mjs; grep -n \"hub:session-howto\\|metas\\|querySelector.*meta\" ../ai-hub/lib/hub/harness.html | head -6 | cut -c1-170","description":"Confirm formatted hub tags still build and client stays pristine","timeout":120000}}}
