 heights are float32, as the collider keeps them; outside the grid nothing stands (`terrainHeight` is null).\n *\n * Carried from shardfall@fa2dab6 `crates/pav_core/src/terrain.rs:93-153` (`raw_height`: fbm of 5 octaves at\n * lacunarity 2.03, the ridge term, the flattened footprints' smoothstep, `cell`'s terraces; `decor`'s hashed cells),\n * as a concept: on a heightfield's corners rather than in terraced tiles.\n *\n * @example\n * import { createRegistry } from '../core/registry';\n * const reg = createRegistry();\n * defineTerrain('terrain:knoll', { size: [16, 16], hills: [{ at: [8, 8], radius: 8, height: 2 }] }, reg);\n * const knoll = getTerrain('terrain:knoll', reg);\n * [knoll.cols, terrainHeight(knoll, 8, 8), terrainHeight(knoll, 0, 0), terrainHeight(knoll, -1, 0)]; // [16, 2, 0, null]\n * @see engine/world/terrain.test.ts\n */\nimport { mix32 } from '../core/hash';\nimport { codeError } from '../core/log';\nimport { registry as sharedRegistry, type Entry, type Registry } from '../core/registry';\nimport { createNoise2D } from '../core/noise';\nimport { Vector3 } from '../core/math';\nimport type { Schema, SpecOf } from '../core/schema';\n\n/** A two-number field (m). */\nconst pair = (description: string, required = false) =>\n  ({ type: 'array', items: { type: 'number' }, ...(required ? { required } : { default: [0, 0] }), unit: 'm', description }) as const; // prettier-ignore\n\n/** The fields of a `terrain` entry (see the file comment). */\nexport const TERRAIN_FIELDS = {\n  size: pair('Its extent along x and along z, each a whole number of cells: [24, 96].', true),\n  cell: { type: 'number', default: 1, minimum: 0.25, maximum: 8, unit: 'm', description: 'The grid’s spacing: a height stands at every cell’s corners.' }, // prettier-ignore\n  origin: { type: 'array', items: { type: 'number' }, default: [0, 0, 0], unit: 'm', description: 'Its north-west corner, at the height everything else is added to: [x, y, z].\n  seed: { type: 'integer', default: 0, description: 'The noise’s seed.' },\n  height: { type: 'number', default: 0, minimum: 0, unit: 'm', description: 'The noise’s range: rolling ground about this high (0: none).' }, // prettier-ignore\n  scale: { type: 'number', default: 40, minimum: 1, unit: 'm', description: 'The size of the noise’s features.' },\n  octaves: { type: 'integer', default: 5, minimum: 1, maximum: 8, description: 'The noise’s octaves.' },\n  ridges: { type: 'number', default: 0.5, minimum: 0, maximum: 1, description: 'How much ridged noise is added: shardfall’s half.' }, // prettier-ignore\n  hills: { type: 'array', items: { type: 'object' }, default: [], description: 'Smooth domes added: { at: [x, z], radius, height } (m; a negative height digs a hollow).' }, //\n  terrace: { type: 'number', default: 0, minimum: 0, unit: 'm', description: 'Rounds heights to steps this high (0: smooth).' }, // prettier-ignore\n  flats: { type: 'array', items: { type: 'object' }, default: [], description: 'Footprints flattened: { rect: [x0, z0, x1, z1], height, margin } (m), the ground blending back \n  surface: { type: 'string', default: 'grass', description: 'The surface tag underfoot (footsteps, particles).' },\n  steep: { type: 'number', default: 0.7, minimum: 0, unit: 'm/m', description: 'Ground rising this much a metre or more is steep (0.7: 35°).' }, // prettier-ignore\n  steepSurface: { type: 'string', default: 'rock', description: 'The surface tag on steep ground.' },\n  high: { type: 'number', default: 0, minimum: 0, unit: 'm', description: 'The high layer shows from this height over the origin up (0: none).' }, // prettier-ignore\n  materials: { type: 'array', items: { type: 'string' }, default: ['material:default'], description: 'Drawing only: the layers’ materials, the ground, then the steep and the h\n} as const satisfies Schema;\n\n/** A `terrain` entry: its spec. */\nexport type TerrainEntry = Entry<typeof TERRAIN_FIELDS>;\n/** What `defineTerrain` and `makeTerrain` take: each field of `TERRAIN_FIELDS` (`size` required). */\nexport type TerrainSpec = SpecOf<typeof TERRAIN_FIELDS>;\n----\nactorActions.test.ts\nactorActions.ts\nactorAnim.ts\nactorClips.test.ts\nactorClips.ts\nactorInput.ts\nactors.test.ts\nactors.ts\nbreakables.test.ts\nbreakables.ts\ncapture.test.ts\ncapture.ts\ncombatApi.ts\ncrowdBodies.test.ts\ncrowdBodies.ts\ndamage.test.ts\ndamage.ts\ndevActions.ts\ndoors.test.ts\ndoors.ts\nentities.ts\nentityTable.ts\nfeelCourse.test.ts\nfeelCourse.ts\nhits.test.ts\nhits.ts\nhouseApi.ts\ninteract.test.ts\ninteract.ts\nkitsApi.ts\nlevelBodies.test.ts\nlevelBodies.ts\nlights.test.ts\nlights.ts\nmelee.test.ts\nmelee.ts\nmovementApi.ts\npropBlocks.test.ts\npropBlocks.ts\nprops.test.ts\nprops.ts\nqueryView.test.ts\nqueryView.ts\nragdolls.test.ts\nragdolls.ts\nreactions.test.ts\nreactions.ts\nreplay.test.ts\nreplay.ts\nrestore.test.ts\nrides.test.ts\nrides.ts\nscene.test.ts\nscene.ts\nsession.ts\nsiteApi.ts\nstate.test.ts\nstate.ts\nswitches.test.ts\nswitches.ts\n----\n/**\n * @file The geometry `geometry:{{name}}`: what it is (replace this text; `x docs` puts the first sentence in INDEX).\n * It starts as a crate: a rounded box standing on the ground, sized and rounded by its parameters.\n *\n * Invariants: built from the engine's geometry kit (boxGeometry, roundedBoxGeometry, rampGeometry, frustumGeometry,\n * ringGeometry, limbGeometry, mergeGeometries, sidesThenTops), so it stands on the ground, in metres, with normals\n * and UVs in metres; within its vertex budget at its defaults (`node x qa geo` checks it).\n *\n * @example\n * {{name}}.budget; // 300\n * @see {{id}}.test.ts\n */\nimport { defineGeometry, roundedBoxGeometry } from '../../../engine';\n\n/** The geometry `geometry:{{name}}`: replace this sentence with what it is. */\nexport const {{name}} = defineGeometry('geometry:{{name}}', {\n  description: 'A crate: a rounded box standing on the ground (replace).',\n  params: {\n    size: { type: 'number', default: 0.8, minimum: 0.1, maximum: 10, unit: 'm', description: 'Its side.' },\n    radius: {\n      type: 'number',\n      default: 0.04,\n      minimum: 0,\n      maximum: 0.5,\n      unit: 'm',\n      description: 'The rounding of its edges, at most half its side.',\n    },\n  },\n  budget: 300,\n  create: ({ size, radius }) =>\n    roundedBoxGeometry({ width: size, height: size, depth: size, radius: Math.min(radius, size / 2), segments: 2 }),\n});\n---\n/**\n * @file The prop `prop:{{name}}`: what it is (replace this text; `x docs` puts the first sentence in INDEX).\n * It starts as a small wooden chest, a box of planks under a lid, that slides and tumbles when it is hit.\n *\n * Invariants: its parts stand on its base (the origin, +Y up), in metres, built from geometry and materials by id\n * (`node x describe geometry`, `node x describe material`); its body's shape stands on the base too, as tall as the\n * parts; `node x qa geo tex --only prop:{{name}}` checks its parts and their textures.\n *\n * @example\n * {{name}}.body.type; // 'dynamic'\n * @see {{id}}.test.ts\n */\nimport { defineProp } from '../../../engine/sim-api';\n\n/** The prop `prop:{{name}}`: replace this sentence with what it is. */\nexport const {{name}} = defineProp('prop:{{name}}', {\n  description: 'A small wooden chest: a box of planks under a lid (replace).',\n  parts: [\n    {\n      name: 'box',\n      geometry: 'geometry:box',\n      params: { width: 0.6, height: 0.3, depth: 0.4 },\n      material: 'material:planks',\n    },\n    {\n      name: 'lid',\n      geometry: 'geometry:box',\n      params: { width: 0.62, height: 0.15, depth: 0.42 },\n      material: 'material:planks',\n      position: [0, 0.3, 0],\n      tint: '#c8a080',\n    },\n  ],\n  body: { type: 'dynamic', shape: 'box', size: [0.6, 0.45, 0.4] },\n  place: { spawn: '{{name}}' },\n  gallery: { camera: 'turntable', duration: 0, states: [] }, // node x gallery: four views round it\n});","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"