tor').find((e) => (e.actor as { player?: boolean }).player === true);\n244:      const actor = other.actor as { player?: boolean; intents?: { look?: readonly [number, number] } };\n245:      if (actor.player === true) continue;\n253:  /** What the camera takes from the run this frame: whom it follows, his eye and what he does, the walls. */\n254:  const follow = (): {\n255:    follow: Vec3;\n259:    player: CameraPlayer | null;\n262:    const player = stage.actors.player();\n263:    const feet = player?.feet ?? stage.centre;\n264:    const eye: Vec3 | undefined = doing?.eye !== undefined ? [feet[0], feet[1] + doing.eye, feet[2]] : player?.posed?.eye; // prettier-ignore\n265:    return { follow: feet, eye, queries: queries(), also: shut, player: doing };\n267:  /** Steps the camera by `dt` with `input`, then draws the player for a first-person camera: his arms, his body hidden. */\n272:    const pose = rig.update({ ...follow(), ...input }, dt);\nengine/gfx/cameras/effects.ts:155:export function cameraPlayer(entity: EntityData, aiming = false): CameraPlayer | null {\nengine/gfx/cameras/effects.ts-156-  const actor = entity.actor as { vx?: number; vy?: number; vz?: number; grounded?: boolean } | undefined;\nengine/gfx/cameras/effects.ts-157-  if (!actor) return null;\nengine/gfx/cameras/effects.ts-158-  const velocity: Vec3 = [actor.vx ?? 0, actor.vy ?? 0, actor.vz ?? 0];\nengine/gfx/cameras/effects.ts-159-  const grounded = actor.grounded === true;\nengine/gfx/cameras/effects.ts-160-  const motion = entity.motion as Readonly<Record<string, unknown>> | undefined;\nengine/gfx/cameras/effects.ts-161-  const hitAt = (entity.melee as { hitAt?: number } | undefined)?.hitAt;\nengine/gfx/cameras/effects.ts-162-  const struck = hitAt !== undefined && hitAt >= 0 ? { struck: hitAt } : {};\nengine/gfx/cameras/effects.ts-163-  const weapons = entity.weapons as { kick?: readonly number[]; shots?: number } | undefined;\nengine/gfx/cameras/effects.ts-164-  const out = weapons ? weaponOut(entity) : null;\nengine/gfx/cameras/effects.ts-165-  const [up, right] = weapons?.kick ?? [0, 0];\nengine/gfx/cameras/effects.ts-166-  const armed = !weapons ? {} : out ? { recoil: [up * DEG, -right * DEG] as const, zoom: out.zoom, shots: weapons.shots ?? 0 }\nengine/gfx/cameras/effects.ts-167-  const aims = aiming && (!weapons || out !== null); // with weapons, only one out aims\nengine/gfx/cameras/effects.ts-168-  if (!motion) {\nengine/gfx/cameras/effects.ts-169-    const mode = grounded ? 'ground' : 'air';\nengine/gfx/cameras/effects.ts-170-    return { velocity, grounded, mode, sprinting: false, sliding: false, boosted: false, aiming: aims, ...struck, ...armed }; \nengine/gfx/cameras/effects.ts-171-  }\nengine/gfx/cameras/effects.ts-172-  const eye = CAMERA_EYE.stand + (CAMERA_EYE.crouch - CAMERA_EYE.stand) * crouchShare(motion);\nengine/gfx/cameras/effects.ts-173-  const sliding = motion.sliding === true;\nengine/gfx/cameras/effects.ts-174-  const boosted = sliding && Number(motion.slideBoost) > 0;\nengine/gfx/cameras/effects.ts-175-  return { velocity, grounded, eye, mode: String(motion.mode), sprinting: motion.sprinting === true, sliding, boosted, aiming:\nengine/gfx/cameras/effects.ts-176-}\nengine/gfx/cameras/effects.ts-177-\n/**\n * @file Camera poses (PLAN.md WP 2.5, §6.3; doctrine: Common ground): what every camera computes each frame, as plain\n * data in three.js's camera words, and the pure math over it. A `CameraPose` is a position, a heading (`yaw`) and a\n * `pitch`, the lens (`projection`, `fov`, `frustumSize`, `zoom`, `near`, `far`, as `PerspectiveCamera` and\n * `OrthographicCamera` name them), the height `boost` (engine/gfx/cameras/boost.ts) and the `distance` to the point\n * it looks at. Every camera (engine/gfx/cameras/{presets,orbit,fly,fixed}.ts) is a pure step `(state, input, dt) →\n * state` and a pure `(state) → pose`, wrapped in a `Camera` object; engine/gfx/cameras/place.ts puts a pose on a\n * three.js camera. None of it needs 