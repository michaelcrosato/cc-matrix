{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016kHx34hoB6Gtt82i8Qtsgs","type":"tool_result","content":"/**\n * @file The body-state vocabulary (PLAN.md WP 3.7, §4.6; I-09): the words a body is told each step, kept distinct\n * from input intents (what a player or an AI wants): where it is and how it moves, whether it dashes, flinches or is\n * airborne, the pose or stance it holds, the move it plays, the part that leaves a trail. `BODY_STATES` gives each\n * word the kind of value it takes; `checkBodyStates` warns once for a word outside the vocabulary, naming the closest\n * (`ANIM_UNKNOWN_STATE`), and once for a value of the wrong kind (`ANIM_BAD_STATE`), and drops both. `SAMPLE_STATES`\n * are named body states (idle, run, dodge…) with how long each is held, for tests, sheets and rig checks.\n *\n * Invariants:\n * - Any behaviour runs on any body: a body reads the words it knows and ignores the others without a warning; only a\n *   word outside the vocabulary (a typo) warns. The humanoid (engine/anim/humanoid.ts) reads every word but `trail`,\n *   which the animator samples (engine/anim/character.ts).\n * - `BODY_STATES` has exactly the keys of `AnimatorInput` (the compiler checks), so the vocabulary and what bodies\n *   read cannot drift. Pose and stance names are the body's to check (the humanoid's `ANIM_UNKNOWN_POSE`).\n * - Pure: no clock, no random stream; the warnings go through the given log, once per word.\n *\n * Carried from `my-3d2dge:src/emberdeep/18-characters.js:36-38` (the state bag a body's `update(dt, s)` takes, unknown\n * keys ignored) and `:82-88` (`CHAR_STATES`, as `SAMPLE_STATES` in metres, the three moves told as `body`, WP 6.1);\n * `src/emberdeep/33-beasts.js:1053-1060` reads the same words on a body that is not a humanoid.\n *\n * @example\n * import { createLog } from '../core/log';\n * const quiet = createLog({ console: { warn: () => {}, error: () => {} } });\n * checkBodyStates({ pose: 'cheer', dash: true }); // the same object: every word passes\n * checkBodyStates({ psoe: 'cheer' }, quiet); // {}, and quiet.advice[0].message is '\"psoe\" is not a body state (did you mean \"pose\"?); it is ignored'\n * checkBodyStates({ dash: 1 }, quiet); // {}: ANIM_BAD_STATE, dash takes true or false\n * SAMPLE_STATES.dodge.seconds; // 0.15\n * @see engine/anim/states.test.ts\n */\nimport { defineCodes, didYouMean, log as engineLog, type Log } from '../core/log';\nimport { Vector3 } from '../core/math';\nimport { isPlainObject, show } from '../core/schema';\nimport type { HumanoidInput } from './humanoid';\n\n/** The codes this module raises, with their fixes. */\nexport const STATE_CODES = defineCodes('anim', {\n  ANIM_UNKNOWN_STATE: {\n    template: '{name} is not a body state{suggestion}; it is ignored',\n    fix: 'use one of: {names}',\n    doc: 'Raised once per word by the animator (engine/anim/character.ts `step`, through `checkBodyStates`) for a body state outside the vocabulary, usually a typo. The messag\n  },\n  ANIM_BAD_STATE: {\n    template: 'body state {name} is {value}, not {expected}{suggestion}; it is ignored',\n    fix: 'give {name} {expected}',\n    doc: 'Raised once per word by the animator (engine/anim/character.ts `step`, through `checkBodyStates`) for a body state whose value is of the wrong kind: a number for `da\n  },\n});\n\n/** The parts that leave a trail, each with the span its ribbon covers. */\nexport const TRAILS = {\n  blade: 'The sword, from near the grip to its tip; another weapon or none trails as `fistR`.',\n  fistR: 'The right forearm, elbow to wrist.',\n  fistL: 'The left forearm, elbow to wrist.',\n  kick: 'The right shin, knee to sole.',\n} as const;\n\n/** A part that leaves a trail. */\nexport type TrailName = keyof typeof TRAILS;\n\n/** What a body is told each step: the humanoid's words and the trail. Every word is optional. */\nexport interface AnimatorInput extends HumanoidInput {\n  /** The part that leaves a trail this step (a move's strike sets it, WP 6.1); none when absent. */\n  trail?: TrailName;\n}\n\n/** The kind of value a body state takes; a `name` is checked by the body that reads it. */\nexport type StateKind = 'number' | 'boolean' | 'vector' | 'object' | 'name' | 'trail';\n\n/** Every body state and the kind of value it takes (`AnimatorInput` documents each word). */\nexport const BODY_STATES = {\n  position: 'vector',\n  velocity: 'vector',\n  yaw: 'number',\n  run: 'number',\n  dash: 'boolean',\n  hurt: 'boolean',\n  air: 'boolean',\n  climb: 'boolean',\n  point: 'boolean',\n  aim: 'number',\n  pose: 'name',\n  stance: 'name',\n  down: 'number',\n  body: 'object',\n  trail: 'trail',\n} as const satisfies { readonly [K in keyof Required<AnimatorInput>]: StateKind };\n\n/** A body state's name. */\nexport type BodyStateName = keyof typeof BODY_STATES;\n\n/** What a kind's value must be, as a message says it. */\nconst EXPECTED: Readonly<Record<StateKind, string>> = {\n  number: 'a finite number',\n  boolean: 'true or false',\n  vector: 'a Vector3',\n  object: 'an object',\n  name: 'a name',\n  trail: `one of ${Object.keys(TRAILS).join(', ')}`,\n};\n\n/** Whether `value` is of kind `kind`. */\nfunction fits(kind: StateKind, value: unknown): boolean {\n  switch (kind) {\n    case 'number':\n      // Stryker disable next-line ConditionalExpression: Number.isFinite is false for anything but a finite number, so the typeof test only says so\n      return typeof value === 'number' && Number.isFinite(value);\n    case 'boolean':\n      return typeof value === 'boolean';\n    case 'vector':\n      return value instanceof Vector3 && [value.x, value.y, value.z].every(Number.isFinite);\n----\n/**\n * @file Actions on actors (PLAN.md WP 13.11; engine/anim/actions.ts, WP 8.7): the component `actions` holds an animated\n * actor's `Actions` as the plain data `Actions.save()` writes (`ACTIONS_FIELDS`), so the sim hashes, captures and\n * restores what plays and where. `actOn(w, id, act)` runs `act` on actor `id`'s actions (the component added at rest\n * the first time a call changes them): `actOn(w, id, (a) => a.play('roll'))`, `a.next()` for a beat held\n * `until: 'next'`, `a.finish()`, `a.cancel('walk')`; the call's own events (the beat it begins, its first marks, an\n * `end`) go out as `action` from the call, at once between steps and at the step's end inside one. An action's clip\n * beats play on the actor's clip layer (the component `clips`, engine/sim/actorClips.ts), saved back with it; an actor\n * without one cannot play them (`SIM_ACTION_NO_CLIPS`).\n *\n * The system `actors.anim` (engine/sim/actors.ts) steps an actor's actions before its animator, in id order\n * (`stepActorActions`): what the beat tells the body (its states, a move, a motion) is laid over the animator's input,\n * and each event goes out as `action` `{ id, type, phase, late }`: a beat's name as it begins, its own events (`grab`,\n * `pull`, `top`…), and `end`. The view poses the effectors, the flip and the squash on the actor's puppet from the same\n * data (engine/gfx/puppets/actors.ts).\n *\n * Invariants: everything an actor's actions are is the component (the `Actions` here are made afresh for every call\n * and every step, so nothing, not a call's events, outlives one), so a capture restores them exactly wherever it is\n * taken; an actor at rest, its channels eased back, steps for nothing; a call that changes nothing adds nothing.\n *\n * @example\n * import { createCharacter } from '../physics/character';\n * import { spawnActor } from './actors';\n * // in a scene with a physics world, the actions loaded (loadActions):\n * // const id = spawnActor(w, { at: [0, 0, 0], character: createCharacter(), anim: { build: 'build:adult' } });\n * // actOn(w, id, (a) => a.play('roll'));\n * // w.step(); w.get(id).actions.playing; // 'action:roll'\n * @see engine/sim/actorActions.test.ts\n */\nimport { Actions, type ActionsState } from '../anim/actions';\nimport { ACTION } from '../anim/actions-data';\nimport type { AnimatorInput } from '../anim/states';\nimport type { EventMap } from '../core/events';\nimport { codeError, defineCodes } from '../core/log';\nimport { registry as sharedRegistry, type Registry } from '../core/registry';\nimport { defineSchema } from '../core/schema';\nimport { clipLayerOf } from './actorClips';\nimport type { ActorComponents } from './actors';\nimport { defineComponent } from './state';\nimport type { World } from './world';\n\n/** The codes this module raises. */\nexport const ACTOR_ACTION_CODES = defineCodes('sim', {\n  SIM_ACTION_NO_CLIPS: {\n    template: 'actor {id} cannot play action {action}: it plays clips ({clips}) and the actor has no clip layer',\n    fix: 'give the actor clips first, with the sets those clips come from: addClips(w, id, { sets }) (engine/sim/actorClips.ts)',\n    doc: 'Raised by `actOn` (engine/sim/actorActions.ts) when an action with a `clip` beat is played on an actor without the component `clips`: the beat would play nothing.',\n  },\n});\n\n----\n/**\n * @file The actors' animators in the sim (PLAN.md WP 3.7, WP 7.8, WP 13.10; engine/sim/actors.ts adds them): the\n * systems `actors.anim`, each animated actor's animator stepped in id order, told its `states`, what its reactions'\n * and actions' beats tell it, and the controller's (`velocity`, `yaw`, `air`, `dash`; a movement model's duck as the\n * pose `crouch`), its events emitted with its feet (`at`) and its gait; and `actors.pose`, the `preciseHits` animators\n * posed where their feet are now, so their trail is sim data. Split from actors.ts at its line cap.\n *\n * Invariants: the animators are a pool per world, loaded from the components at every step, so they keep no state of\n * their own and a capture restores them; a breathing phase is drawn from `rng.entity(id, 'anim')` at the first step.\n *\n * @example\n * // spawnActor(w, { at, character, anim: {} }) adds both systems on the first animated spawn (engine/sim/actors.ts)\n * @see engine/sim/actors.test.ts\n */\nimport { AnimatorPool } from '../anim/character';\nimport { STEP } from '../anim/humanoidRates';\nimport { Vector3 } from '../core/math';\nimport type { ActorComponents } from './actors';\nimport { stepActorActions } from './actorActions';\nimport { stepReactions, type ReactionComponents } from './reactions';\nimport type { World } from './world';\n\n/** The sim's animators, a pool per world: loaded from the components at every step, so they keep no state of their own. */\nconst pools = new WeakMap<World, AnimatorPool>();\nconst [velocity, feet] = [new Vector3(), new Vector3()];\n\n/** The animated actors of `w`, and its pool (pruned of the despawned). */\nfunction animated(w: World) {\n  const pool = pools.get(w) ?? new AnimatorPool();\n  pools.set(w, pool);\n  pool.prune((id) => w.has(id));\n  const actors = w.query('actor', 'animator') as unknown as (ActorComponents & Partial<ReactionComponents>)[];\n  return [actors as (ActorComponents & Partial<ReactionComponents> & { id: number })[], pool] as const;\n}\n\n/**\n * The system `actors.anim`: each animator's step in id order, told its `states` and the controller's (`velocity`, `yaw`,\n * `air`, `dash`; a movement model's duck as the pose `crouch` where the states hold no pose), its breathing phase drawn\n * from `rng.entity(id, 'anim')` at its first step; emits its events. An actor's `reactions` step first, what their phase\n * tells the body laid over its `states`, then its `actions` (engine/sim/actorActions.ts), what their beat tells it laid\n * over those.\n */\nexport function stepAnimators(w: World): void {\n  const [actors, pool] = animated(w);\n  for (const entity of actors) {\n    const { id, actor, animator: data, reactions, motion } = entity;\n    const rng = w.rng.entity(id, 'anim');\n    if (!data.started) [data.state.clock, data.started] = [rng.next() * STEP.clockSpread, true]; // as a humanoid does\n    const animator = pool.get(id, data, { rng, dt: w.dt });\n    velocity.set(actor.vx, actor.vy, actor.vz);\n    const reacted = reactions ? { ...data.states, ...stepReactions(reactions, w.dt) } : data.states;\n    const told = { ...reacted, ...stepActorActions(w, id, entity) };\n    const ducked = motion?.duck === 'ducking' || motion?.duck === 'ducked'; // the movement model's crouch\n    const pose = told.pose ?? (ducked ? 'crouch' : undefined);\n    animator.step({ ...told, pose, velocity, yaw: actor.yaw, air: !actor.grounded, dash: actor.dash > 0 }).save(data);\n    const [at, gait] = [[actor.x, actor.y, actor.z], motion?.gait];\n    for (const { type, ...event } of animator.events) w.emit(type, { id, ...event, at, ...(gait ? { gait } : {}) });\n  }\n}\n\n/** The system `actors.pose`: the `preciseHits` animators posed where their feet are now, so their trail is sim data. */\nexport function poseAnimators(w: World): void {\n  const [actors, pool] = animated(w);\n  for (const { id, actor, animator: data } of actors) {\n    if (!data.preciseHits) continue;\n    const animator = pool.get(id, data, { rng: w.rng.entity(id, 'anim'), dt: w.dt });\n    animator.pose({ at: feet.set(actor.x, actor.y, actor.z), yaw: actor.yaw }).save(data);\n  }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"21849288-0c8f-4994-9d0f-3ff83c647ec0","uuid":"0f8f9512-9360-4b73-a0aa-d025463bc60c","timestamp":"2026-11-05T04:41:13.691Z","tool_use_result":{"stdout":"/**\n * @file The body-state vocabulary (PLAN.md WP 3.7, §4.6; I-09): the words a body is told each step, kept distinct\n * from input intents (what a player or an AI wants): where it is and how it moves, whether it dashes, flinches or is\n * airborne, the pose or stance it holds, the move it plays, the part that leaves a trail. `BODY_STATES` gives each\n * word the kind of value it takes; `checkBodyStates` warns once for a word outside the vocabulary, naming the closest\n * (`ANIM_UNKNOWN_STATE`), and once for a value of the wrong kind (`ANIM_BAD_STATE`), and drops both. `SAMPLE_STATES`\n * are named body states (idle, run, dodge…) with how long each is held, for tests, sheets and rig checks.\n *\n * Invariants:\n * - Any behaviour runs on any body: a body reads the words it knows and ignores the others without a warning; only a\n *   word outside the vocabulary (a typo) warns. The humanoid (engine/anim/humanoid.ts) reads every word but `trail`,\n *   which the animator samples (engine/anim/character.ts).\n * - `BODY_STATES` has exactly the keys of `AnimatorInput` (the compiler checks), so the vocabulary and what bodies\n *   read cannot drift. Pose and stance names are the body's to check (the humanoid's `ANIM_UNKNOWN_POSE`).\n * - Pure: no clock, no random stream; the warnings go through the given log, once per word.\n *\n * Carried from `my-3d2dge:src/emberdeep/18-characters.js:36-38` (the state bag a body's `update(dt, s)` takes, unknown\n * keys ignored) and `:82-88` (`CHAR_STATES`, as `SAMPLE_STATES` in metres, the three moves told as `body`, WP 6.1);\n * `src/emberdeep/33-beasts.js:1053-1060` reads the same words on a body that is not a humanoid.\n *\n * @example\n * import { createLog } from '../core/log';\n * const quiet = createLog({ console: { warn: () => {}, error: () => {} } });\n * checkBodyStates({ pose: 'cheer', dash: true }); // the same object: every word passes\n * checkBodyStates({ psoe: 'cheer' }, quiet); // {}, and quiet.advice[0].message is '\"psoe\" is not a body state (did you mean \"pose\"?); it is ignored'\n * checkBodyStates({ dash: 1 }, quiet); // {}: ANIM_BAD_STATE, dash takes true or false\n * SAMPLE_STATES.dodge.seconds; // 0.15\n * @see engine/anim/states.test.ts\n */\nimport { defineCodes, didYouMean, log as engineLog, type Log } from '../core/log';\nimport { Vector3 } from '../core/math';\nimport { isPlainObject, show } from '../core/schema';\nimport type { HumanoidInput } from './humanoid';\n\n/** The codes this module raises, with their fixes. */\nexport const STATE_CODES = defineCodes('anim', {\n  ANIM_UNKNOWN_STATE: {\n    template: '{name} is not a body state{suggestion}; it is ignored',\n    fix: 'use one of: {names}',\n    doc: 'Raised once per word by the animator (engine/anim/character.ts `step`, through `checkBodyStates`) for a body state outside the vocabulary, usually a typo. The messag\n  },\n  ANIM_BAD_STATE: {\n    template: 'body state {name} is {value}, not {expected}{suggestion}; it is ignored',\n    fix: 'give {name} {expected}',\n    doc: 'Raised once per word by the animator (engine/anim/character.ts `step`, through `checkBodyStates`) for a body state whose value is of the wrong kind: a number for `da\n  },\n});\n\n/** The parts that leave a trail, each with the span its ribbon covers. */\nexport const TRAILS = {\n  blade: 'The sword, from near the grip to its tip; another weapon or none trails as `fistR`.',\n  fistR: 'The right forearm, elbow to wrist.',\n  fistL: 'The left forearm, elbow to wrist.',\n  kick: 'The right shin, knee to sole.',\n} as const;\n\n/** A part that leaves a trail. */\nexport type TrailName = keyof typeof TRAILS;\n\n/** What a body is told each step: the humanoid's words and the trail. Every word is optional. */\nexport interface AnimatorInput extends HumanoidInput {\n  /** The part that leaves a trail this step (a move's strike sets it, WP 6.1); none when absent. */\n  trail?: TrailName;\n}\n\n/** The kind of value a body state takes; a `name` is checked by the body that reads it. */\nexport type StateKind = 'number' | 'boolean' | 'vector' | 'object' | 'name' | 'trail';\n\n/** Every body state and the kind of value it takes (`AnimatorInput` documents each word). */\nexport const BODY_STATES = {\n  position: 'vector',\n  velocity: 'vector',\n  yaw: 'number',\n  run: 'number',\n  dash: 'boolean',\n  hurt: 'boolean',\n  air: 'boolean',\n  climb: 'boolean',\n  point: 'boolean',\n  aim: 'number',\n  pose: 'name',\n  stance: 'name',\n  down: 'number',\n  body: 'object',\n  trail: 'trail',\n} as const satisfies { readonly [K in keyof Required<AnimatorInput>]: StateKind };\n\n/** A body state's name. */\nexport type BodyStateName = keyof typeof BODY_STATES;\n\n/** What a kind's value must be, as a message says it. */\nconst EXPECTED: Readonly<Record<StateKind, string>> = {\n  number: 'a finite number',\n  boolean: 'true or false',\n  vector: 'a Vector3',\n  object: 'an object',\n  name: 'a name',\n  trail: `one of ${Object.keys(TRAILS).join(', ')}`,\n};\n\n/** Whether `value` is of kind `kind`. */\nfunction fits(kind: StateKind, value: unknown): boolean {\n  switch (kind) {\n    case 'number':\n      // Stryker disable next-line ConditionalExpression: Number.isFinite is false for anything but a finite number, so the typeof test only says so\n      return typeof value === 'number' && Number.isFinite(value);\n    case 'boolean':\n      return typeof value === 'boolean';\n    case 'vector':\n      return value instanceof Vector3 && [value.x, value.y, value.z].every(Number.isFinite);\n----\n/**\n * @file Actions on actors (PLAN.md WP 13.11; engine/anim/actions.ts, WP 8.7): the component `actions` holds an animated\n * actor's `Actions` as the plain data `Actions.save()` writes (`ACTIONS_FIELDS`), so the sim hashes, captures and\n * restores what plays and where. `actOn(w, id, act)` runs `act` on actor `id`'s actions (the component added at rest\n * the first time a call changes them): `actOn(w, id, (a) => a.play('roll'))`, `a.next()` for a beat held\n * `until: 'next'`, `a.finish()`, `a.cancel('walk')`; the call's own events (the beat it begins, its first marks, an\n * `end`) go out as `action` from the call, at once between steps and at the step's end inside one. An action's clip\n * beats play on the actor's clip layer (the component `clips`, engine/sim/actorClips.ts), saved back with it; an actor\n * without one cannot play them (`SIM_ACTION_NO_CLIPS`).\n *\n * The system `actors.anim` (engine/sim/actors.ts) steps an actor's actions before its animator, in id order\n * (`stepActorActions`): what the beat tells the body (its states, a move, a motion) is laid over the animator's input,\n * and each event goes out as `action` `{ id, type, phase, late }`: a beat's name as it begins, its own events (`grab`,\n * `pull`, `top`…), and `end`. The view poses the effectors, the flip and the squash on the actor's puppet from the same\n * data (engine/gfx/puppets/actors.ts).\n *\n * Invariants: everything an actor's actions are is the component (the `Actions` here are made afresh for every call\n * and every step, so nothing, not a call's events, outlives one), so a capture restores them exactly wherever it is\n * taken; an actor at rest, its channels eased back, steps for nothing; a call that changes nothing adds nothing.\n *\n * @example\n * import { createCharacter } from '../physics/character';\n * import { spawnActor } from './actors';\n * // in a scene with a physics world, the actions loaded (loadActions):\n * // const id = spawnActor(w, { at: [0, 0, 0], character: createCharacter(), anim: { build: 'build:adult' } });\n * // actOn(w, id, (a) => a.play('roll'));\n * // w.step(); w.get(id).actions.playing; // 'action:roll'\n * @see engine/sim/actorActions.test.ts\n */\nimport { Actions, type ActionsState } from '../anim/actions';\nimport { ACTION } from '../anim/actions-data';\nimport type { AnimatorInput } from '../anim/states';\nimport type { EventMap } from '../core/events';\nimport { codeError, defineCodes } from '../core/log';\nimport { registry as sharedRegistry, type Registry } from '../core/registry';\nimport { defineSchema } from '../core/schema';\nimport { clipLayerOf } from './actorClips';\nimport type { ActorComponents } from './actors';\nimport { defineComponent } from './state';\nimport type { World } from './world';\n\n/** The codes this module raises. */\nexport const ACTOR_ACTION_CODES = defineCodes('sim', {\n  SIM_ACTION_NO_CLIPS: {\n    template: 'actor {id} cannot play action {action}: it plays clips ({clips}) and the actor has no clip layer',\n    fix: 'give the actor clips first, with the sets those clips come from: addClips(w, id, { sets }) (engine/sim/actorClips.ts)',\n    doc: 'Raised by `actOn` (engine/sim/actorActions.ts) when an action with a `clip` beat is played on an actor without the component `clips`: the beat would play nothing.',\n  },\n});\n\n----\n/**\n * @file The actors' animators in the sim (PLAN.md WP 3.7, WP 7.8, WP 13.10; engine/sim/actors.ts adds them): the\n * systems `actors.anim`, each animated actor's animator stepped in id order, told its `states`, what its reactions'\n * and actions' beats tell it, and the controller's (`velocity`, `yaw`, `air`, `dash`; a movement model's duck as the\n * pose `crouch`), its events emitted with its feet (`at`) and its gait; and `actors.pose`, the `preciseHits` animators\n * posed where their feet are now, so their trail is sim data. Split from actors.ts at its line cap.\n *\n * Invariants: the animators are a pool per world, loaded from the components at every step, so they keep no state of\n * their own and a capture restores them; a breathing phase is drawn from `rng.entity(id, 'anim')` at the first step.\n *\n * @example\n * // spawnActor(w, { at, character, anim: {} }) adds both systems on the first animated spawn (engine/sim/actors.ts)\n * @see engine/sim/actors.test.ts\n */\nimport { AnimatorPool } from '../anim/character';\nimport { STEP } from '../anim/humanoidRates';\nimport { Vector3 } from '../core/math';\nimport type { ActorComponents } from './actors';\nimport { stepActorActions } from './actorActions';\nimport { stepReactions, type ReactionComponents } from './reactions';\nimport type { World } from './world';\n\n/** The sim's animators, a pool per world: loaded from the components at every step, so they keep no state of their own. */\nconst pools = new WeakMap<World, AnimatorPool>();\nconst [velocity, feet] = [new Vector3(), new Vector3()];\n\n/** The animated actors of `w`, and its pool (pruned of the despawned). */\nfunction animated(w: World) {\n  const pool = pools.get(w) ?? new AnimatorPool();\n  pools.set(w, pool);\n  pool.prune((id) => w.has(id));\n  const actors = w.query('actor', 'animator') as unknown as (ActorComponents & Partial<ReactionComponents>)[];\n  return [actors as (ActorComponents & Partial<ReactionComponents> & { id: number })[], pool] as const;\n}\n\n/**\n * The system `actors.anim`: each animator's step in id order, told its `states` and the controller's (`velocity`, `yaw`,\n * `air`, `dash`; a movement model's duck as the pose `crouch` where the states hold no pose), its breathing phase drawn\n * from `rng.entity(id, 'anim')` at its first step; emits its events. An actor's `reactions` step first, what their phase\n * tells the body laid over its `states`, then its `actions` (engine/sim/actorActions.ts), what their beat tells it laid\n * over those.\n */\nexport function stepAnimators(w: World): void {\n  const [actors, pool] = animated(w);\n  for (const entity of actors) {\n    const { id, actor, animator: data, reactions, motion } = entity;\n    const rng = w.rng.entity(id, 'anim');\n    if (!data.started) [data.state.clock, data.started] = [rng.next() * STEP.clockSpread, true]; // as a humanoid does\n    const animator = pool.get(id, data, { rng, dt: w.dt });\n    velocity.set(actor.vx, actor.vy, actor.vz);\n    const reacted = reactions ? { ...data.states, ...stepReactions(reactions, w.dt) } : data.states;\n    const told = { ...reacted, ...stepActorActions(w, id, entity) };\n    const ducked = motion?.duck === 'ducking' || motion?.duck === 'ducked'; // the movement model's crouch\n    const pose = told.pose ?? (ducked ? 'crouch' : undefined);\n    animator.step({ ...told, pose, velocity, yaw: actor.yaw, air: !actor.grounded, dash: actor.dash > 0 }).save(data);\n    const [at, gait] = [[actor.x, actor.y, actor.z], motion?.gait];\n    for (const { type, ...event } of animator.events) w.emit(type, { id, ...event, at, ...(gait ? { gait } : {}) });\n  }\n}\n\n/** The system `actors.pose`: the `preciseHits` animators posed where their feet are now, so their trail is sim data. */\nexport function poseAnimators(w: World): void {\n  const [actors, pool] = animated(w);\n  for (const { id, actor, animator: data } of actors) {\n    if (!data.preciseHits) continue;\n    const animator = pool.get(id, data, { rng: w.rng.entity(id, 'anim'), dt: w.dt });\n    animator.pose({ at: feet.set(actor.x, actor.y, actor.z), yaw: actor.yaw }).save(data);\n  }\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_016kHx34hoB6Gtt82i8Qtsgs","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
