{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"cat > tests/inspect.py <<'PY'\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nimport json\nroot=Path(__file__).resolve().parents[1]\nwith sync_playwright() as p:\n browser=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--autoplay-policy=no-user-gesture-required'])\n page=browser.new_page(viewport={'width':1920,'height':1080},device_scale_factor=1)\n errors=[]\n page.on('pageerror',lambda e: errors.append(str(e)))\n page.on('console',lambda m: errors.append(m.text) if m.type=='error' else None)\n page.goto((root/'index.html').as_uri())\n try:\n  page.wait_for_function('window.__caboodle?.ready',timeout=90000)\n  page.screenshot(path=str(root/'tests/title.png'))\n  print(json.dumps({'title':page.title(),'snapshot':page.evaluate('window.__caboodleTest.snapshot()'),'errors':errors},indent=2))\n  page.get_by_role('button',name='SCRAMBLE',exact=True).click()\n  page.wait_for_timeout(1800)\n  page.screenshot(path=str(root/'tests/gameplay.png'))\n  print(json.dumps({'after_start':page.evaluate('window.__caboodleTest.snapshot()'),'errors':errors},indent=2))\n except Exception as e:\n  print('ERROR',e,errors)\n  page.screenshot(path=str(root/'tests/error.png'))\n browser.close()\nPY\n/home/micha/.local/share/pipx/venvs/playwright/bin/python tests/inspect.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
