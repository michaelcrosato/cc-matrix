{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport json,shutil\nroot=Path.cwd();project=json.loads((root/'project.json').read_text());report=json.loads((root/'tests/artifacts/report.json').read_text());interview=json.loads((root.parent/'exit-interview.json').read_text())\nassert report['passed']==63 and not report['failed']\nassert all(report[k]['pass'] for k in ['hub-2-standard','hub-4-standard','hub-4-host-leave'])\nassert report['campaign']['won'] and report['campaign']['sector']==2\nassert (root/'index.html').read_bytes()==(root.parent/(project['slug']+'.html')).read_bytes()\nassert interview['sourceInformation']==json.loads((root/'src/credits.json').read_text())['sourceInformation']\nassert interview['aiHub']['name']==project['title']\nfor p in [root/'tests/__pycache__',root/'tests/.runtime']:\n if p.exists():shutil.rmtree(p)\nprint('Release verified: 63 passed, 0 failed; root HTML and exit interview complete.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
