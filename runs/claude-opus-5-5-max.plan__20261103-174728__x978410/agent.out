nsole.log('   ' + r);\n  }\n}\nEOF\ncat > tracks3.json <<'EOF'\n[\n {\"id\":\"solenne\",\"width\":26,\"points\":[\n  [0,0,3],[300,0,3],[600,0,4],[790,-50,7],[890,-210,14],[905,-420,24],[820,-600,32],[640,-690,36],[420,-670,38],[220,-705,36],[40,-645,30],\n  [-120,-560,24],[-200,-400,16],[-175,-240,10],[-255,-120,6],[-320,60,4],[-300,260,3],[-200,340,3],[-100,280,3],[-80,120,3],[-40,35,3]],\n  \"jumps\":[]},\n {\"id\":\"karakum\",\"width\":26,\"points\":[\n  [0,0,0],[0,-330,0],[30,-575,2],[130,-740,8],[295,-820,18],[490,-820,30],[640,-770,34],[730,-705,36],[840,-620,29],[905,-525,20],\n  [935,-360,12],[905,-195,9],[885,-65,7],[870,65,9],[790,165,15],[675,130,21],[655,15,26],[740,-50,30],[855,-50,32],[985,30,30],\n  [1035,180,22],[945,310,14],[740,355,8],[490,345,4],[245,345,2],[50,295,0],[-25,165,0]],\n  \"jumps\":[[1424,1470,\"gap\"]]},\n {\"id\":\"meridian\",\"width\":24,\"points\":[\n  [0,0,42],[250,-40,42],[480,-160,40],[640,-330,36],[655,-415,35],[640,-480,20],[600,-570,17],[460,-700,15],[240,-680,13],[100,-540,11],[0,-360,10],[-100,-180,10],\n  [-260,-40,12],[-480,0,18],[-680,-80,24],[-780,-280,30],[-700,-480,36],[-500,-560,40],[-300,-480,42],[-160,-300,42],[-60,-120,42]],\n  \"jumps\":[]},\n {\"id\":\"borealis\",\"width\":26,\"points\":[\n  [0,0,110],[-350,0,110],[-650,60,104],[-850,220,92],[-905,420,80],[-885,500,79],[-850,580,62],[-780,670,56],[-600,760,50],[-380,800,40],[-150,760,30],[60,820,22],\n  [260,950,14],[480,1000,10],[700,960,10],[880,860,12],[1000,700,18],[1020,520,30],[930,380,44],[1000,250,58],[900,120,72],[720,140,84],[560,60,96],[380,0,106],[190,-15,110]],\n  \"jumps\":[]}\n]\nEOF\nnode trackcheck.mjs tracks3.json 2>&1 | grep -v \"^  control\" ","description":"Add jump flight checks and re-run on refined layouts"}}}
