map((v, c) => v + (b[c] - v) * f)); } return { L, pts: out, ds: L / m }; }\nconst CLASSES = [['SPARK', 90], ['FLARE', 115], ['STORM', 140], ['SINGULARITY', 170]];\nfor (const T of tracks) {\n  const { L, pts, ds } = resample(catmull(T.points), 2), n = pts.length, W = 6;\n  const head = i => { const a = pts[(i - 1 + n) % n], b = pts[(i + 1) % n]; return Math.atan2(b[1] - a[1], b[0] - a[0]); };\n  const R = pts.map((_, i) => { let dh = head((i + W) % n) - head((i - W + n) % n); while (dh > Math.PI) dh -= 2 * Math.PI; while (dh < -Math.PI) dh += 2 * Math.PI; return Math.abs(2 * W * ds / (dh || 1e-9)); });\n  const line = [];\n  for (const [name, top] of CLASSES) {\n    const a0 = top * .55, lim = R.map(r => Math.min(top * 1.0, Math.sqrt(ALAT * r * 1.15)));   // (racing line: ~15% more radius than the centreline)\n    let v = lim.map(x => x);\n    for (let pass = 0; pass < 3; pass++) {\n      for (let i = 1; i < 2 * n; i++) { const k = i % n, p = (k - 1 + n) % n, acc = a0 * (1 - (v[p] / top) ** 2); v[k] = Math.min(lim[k], Math.sqrt(v[p] ** 2 + 2 * acc * ds)); }\n      for (let i = 2 * n; i > 0; i--) { const k = i % n, nx = (k + 1) % n; v[k] = Math.min(v[k], Math.sqrt(v[nx] ** 2 + 2 * BRAKE * ds)); }\n    }\n    const t = v.reduce((s, x) => s + ds / x, 0), avg = L / t, minv = Math.min(...v);\n    line.push(`${name} ${t.toFixed(1)} s (avg ${(avg * 3.6).toFixed(0)} km/h, slowest ${(minv * 3.6).toFixed(0)})`);\n  }\n  console.log(`${T.id} ${(L / 1000).toFixed(2)} km: ` + line.join(' | '));\n}\nEOF\nnode laptime.mjs final.json 40","description":"Estimate lap times per speed class for each track"}}}
