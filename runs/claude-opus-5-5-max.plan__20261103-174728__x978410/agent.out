{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011WFsgo6hqym95VCn9ZNeay","type":"tool_result","content":"File created successfully at: /home/micha/.cache/opus55-plan-x978410/scratch/trackcheck.mjs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"0af7cd7c-7b61-489d-86ab-010715e3fe6f","uuid":"8e09aea5-03fc-4cd8-9a7b-ef98f149ec48","timestamp":"2026-11-04T01:07:33.691Z","tool_use_result":{"type":"create","filePath":"/home/micha/.cache/opus55-plan-x978410/scratch/trackcheck.mjs","content":"// Track layout checker for the plan: closed centripetal Catmull-Rom through control points (metres),\n// resampled by arc length; prints length, tightest radius, slopes, crest/dip radii, self-overlaps.\n// usage: node trackcheck.mjs tracks.json [--dump id]\nimport { readFileSync } from 'node:fs';\n\nconst tracks = JSON.parse(readFileSync(process.argv[2], 'utf8'));\nconst dumpId = process.argv.includes('--dump') ? process.argv[process.argv.indexOf('--dump') + 1] : null;\n\nfunction catmull(P, samplesPerSeg = 48) {\n  const n = P.length, out = [];\n  const d = (a, b) => Math.hypot(b[0] - a[0], b[1] - a[1], b[2] - a[2]);\n  for (let i = 0; i < n; i++) {\n    const p0 = P[(i - 1 + n) % n], p1 = P[i], p2 = P[(i + 1) % n], p3 = P[(i + 2) % n];\n    const t0 = 0, t1 = t0 + Math.sqrt(d(p0, p1)), t2 = t1 + Math.sqrt(d(p1, p2)), t3 = t2 + Math.sqrt(d(p2, p3));\n    for (let k = 0; k < samplesPerSeg; k++) {\n      const t = t1 + (t2 - t1) * k / samplesPerSeg, q = [];\n      for (let c = 0; c < p1.length; c++) {\n        const A1 = (t1 - t) / (t1 - t0) * p0[c] + (t - t0) / (t1 - t0) * p1[c];\n        const A2 = (t2 - t) / (t2 - t1) * p1[c] + (t - t1) / (t2 - t1) * p2[c];\n        const A3 = (t3 - t) / (t3 - t2) * p2[c] + (t - t2) / (t3 - t2) * p3[c];\n        const B1 = (t2 - t) / (t2 - t0) * A1 + (t - t0) / (t2 - t0) * A2;\n        const B2 = (t3 - t) / (t3 - t1) * A2 + (t - t1) / (t3 - t1) * A3;\n        q.push((t2 - t) / (t2 - t1) * B1 + (t - t1) / (t2 - t1) * B2);\n      }\n      out.push(q);\n    }\n  }\n  return out;\n}\nfunction resample(pts, ds) {\n  const n = pts.length, acc = [0];\n  for (let i = 1; i <= n; i++) { const a = pts[i - 1], b = pts[i % n]; acc.push(acc[i - 1] + Math.hypot(b[0] - a[0], b[1] - a[1], b[2] - a[2])); }\n  const L = acc[n], m = Math.round(L / ds), out = [];\n  let j = 0;\n  for (let k = 0; k < m; k++) {\n    const s = k * L / m; while (acc[j + 1] < s) j++;\n    const a = pts[j], b = pts[(j + 1) % n], f = (s - acc[j]) / (acc[j + 1] - acc[j]);\n    out.push(a.map((v, c) => v + (b[c] - v) * f));\n  }\n  return { L, pts: out, ds: L / m };\n}\nfor (const T of tracks) {\n  const raw = catmull(T.points), { L, pts, ds } = resample(raw, 2), n = pts.length;\n  let minR = 1e9, minRAt = 0, maxSlope = -1e9, minSlope = 1e9, maxSlopeAt = 0, minSlopeAt = 0, crest = 1e9, crestAt = 0, dip = 1e9, dipAt = 0;\n  const head = i => { const a = pts[(i - 1 + n) % n], b = pts[(i + 1) % n]; return Math.atan2(b[1] - a[1], b[0] - a[0]); };\n  const W = 5; // radius measured over +-10 m\n  for (let i = 0; i < n; i++) {\n    const h0 = head((i - W + n) % n), h1 = head((i + W) % n);\n    let dh = h1 - h0; while (dh > Math.PI) dh -= 2 * Math.PI; while (dh < -Math.PI) dh += 2 * Math.PI;\n    const R = Math.abs(2 * W * ds / (dh || 1e-9)); if (R < minR) { minR = R; minRAt = i * ds; }\n    const a = pts[(i - W + n) % n], b = pts[(i + W) % n], hz = Math.hypot(b[0] - a[0], b[1] - a[1]);\n    const sl = (b[2] - a[2]) / hz; if (sl > maxSlope) { maxSlope = sl; maxSlopeAt = i * ds; } if (sl < minSlope) { minSlope = sl; minSlopeAt = i * ds; }\n    // vertical curvature from slope change over +-20 m\n    const a2 = pts[(i - 2 * W + n) % n], b2 = pts[(i + 2 * W) % n];\n    const s1 = (pts[i][2] - a2[2]) / Math.max(1e-6, Math.hypot(pts[i][0] - a2[0], pts[i][1] - a2[1]));\n    const s2 = (b2[2] - pts[i][2]) / Math.max(1e-6, Math.hypot(b2[0] - pts[i][0], b2[1] - pts[i][1]));\n    const dth = Math.atan(s2) - Math.atan(s1), Rv = Math.abs(2 * W * ds / (dth || 1e-9));\n    if (dth < 0 && Rv < crest) { crest = Rv; crestAt = i * ds; } if (dth > 0 && Rv < dip) { dip = Rv; dipAt = i * ds; }\n  }\n  // self overlaps: samples far apart along the track whose ribbons overlap in plan view\n  const wAt = i => T.width;\n  const overlaps = [];\n  for (let i = 0; i < n; i += 3) for (let j = i + 3; j < n; j += 3) {\n    const sep = Math.min(Math.abs(i - j), n - Math.abs(i - j)) * ds; if (sep < 120) continue;\n    const a = pts[i], b = pts[j], dxy = Math.hypot(a[0] - b[0], a[1] - b[1]);\n    if (dxy < T.width + 8) overlaps.push([i * ds, j * ds, dxy, b[2] - a[2]]);\n  }\n  // compress overlaps into ranges\n  const groups = [];\n  for (const o of overlaps) { const g = groups.find(g => Math.abs(g.a - o[0]) < 80 && Math.abs(g.b - o[1]) < 80); if (g) { g.minDz = Math.min(g.minDz, Math.abs(o[3])); g.minD = Math.min(g.minD, o[2]); g.a = o[0]; g.b = o[1]; } else groups.push({ a: o[0], b: o[1], minDz: Math.abs(o[3]), minD: o[2] }); }\n  const xs = pts.map(p => p[0]), ys = pts.map(p => p[1]), zs = pts.map(p => p[2]);\n  console.log(`\\n${T.id}: length ${(L / 1000).toFixed(2)} km, ${T.points.length} pts, bbox x ${Math.min(...xs).toFixed(0)}..${Math.max(...xs).toFixed(0)} y ${Math.min(...ys).toFixed(0)}..${Math.max(...ys).toFixed(0)} z ${Math.min(...zs).toFixed(0)}..${Math.max(...zs).toFixed(0)}`);\n  console.log(`  tightest radius ${minR.toFixed(0)} m at s=${minRAt.toFixed(0)}; slope max +${(maxSlope * 100).toFixed(0)}% at ${maxSlopeAt.toFixed(0)}, min ${(minSlope * 100).toFixed(0)}% at ${minSlopeAt.toFixed(0)}; sharpest crest R ${crest.toFixed(0)} m at ${crestAt.toFixed(0)}, dip R ${dip.toFixed(0)} m at ${dipAt.toFixed(0)}`);\n  for (const g of groups) console.log(`  overlap: s ${g.a.toFixed(0)} with s ${g.b.toFixed(0)}: plan distance ${g.minD.toFixed(0)} m, height gap ${g.minDz.toFixed(1)} m ${g.minDz >= 12 ? '(overpass ok)' : '<-- TOO CLOSE'}`);\n  // where each control point lands along the track (s), for feature placement\n  let s = 0; const cps = [];\n  for (let i = 0; i < T.points.length; i++) { let best = 0, bd = 1e9; for (let k = 0; k < n; k++) { const p = pts[k], q = T.points[i], dd = Math.hypot(p[0] - q[0], p[1] - q[1], p[2] - q[2]); if (dd < bd) { bd = dd; best = k; } } cps.push(Math.round(best * ds)); }\n  console.log('  control points at s =', cps.join(' '));\n  if (dumpId === T.id) {\n    const step = Math.round(50 / ds);\n    for (let k = 0; k < n; k += step) { const p = pts[k]; console.log(`   s=${(k * ds).toFixed(0)} x=${p[0].toFixed(0)} y=${p[1].toFixed(0)} z=${p[2].toFixed(1)} head=${(head(k) * 180 / Math.PI).toFixed(0)}`); }\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_011WFsgo6hqym95VCn9ZNeay","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
