 screens and a HUD with a minimap) from data: new E.Shell(game,\nKC-Chomp-Chase-KC-Munchkin-gpt-6.1-sol-ultra-20261106-022440/vendor/engine/my-3d2dge.js:4371:   * a close-up bust for dialog boxes and menus, drawn live from the rig (blinks, hair and hats included):\nKC-Chomp-Chase-KC-Munchkin-gpt-6.1-sol-ultra-20261106-022440/vendor/engine/my-3d2dge.js:4374:   * The bust stays upright while the rig kneels or lies down (upright: false shows the real pose); cape: false hides the cape;\nKC-Chomp-Chase-KC-Munchkin-gpt-6.1-sol-ultra-20261106-022440/vendor/engine/my-3d2dge.js:4911:  get busy() { return !!this.phase; }\nKC-Chomp-Chase-KC-Munchkin-gpt-6.1-sol-ultra-20261106-022440/vendor/engine/my-3d2dge.js:4959:  get busy() { return this.step >= 0 && this.current.busy; }\nKC-Chomp-Chase-KC-Munchkin-gpt-6.1-sol-ultra-20261106-022440/vendor/engine/my-3d2dge.js:4961:  get active() { return this.busy && this.current.active; }\nKC-Chomp-Chase-KC-Munchkin-gpt-6.1-sol-ultra-20261106-022440/vendor/engine/my-3d2dge.js:4963:  get state() { return this.busy ? this.current.state : null; }\nKC-Chomp-Chase-KC-Munchkin-gpt-6.1-sol-ultra-20261106-022440/vendor/engine/my-3d2dge.js:4967:    if (cur && cur.busy && cur.phase !== 'recover') return false;\nKC-Chomp-Chase-KC-Munchkin-gpt-6.1-sol-ultra-20261106-022440/vendor/engine/my-3d2dge.js:4968:    const next = (cur && (cur.busy || this.idle <= this.window) && this.step + 1 < this.moves.length) ? this.step + 1 : 0;\nKC-Chomp-Chase-KC-Munchkin-gpt-6.1-sol-ultra-20261106-022440/vendor/engine/my-3d2dge.js:4969:    if (cur && cur.busy) cur.cancel();\nKC-Chomp-Chase-KC-Munchkin-gpt-6.1-sol-ultra-20261106-022440/vendor/engine/my-3d2dge.js:4973:  update(dt) { if (this.step < 0) return null; const r = this.current.update(dt); if (!this.current.busy) this.idle += dt; return r; }\nKC-Chomp-Chase-KC-Munchkin-gpt-6.1-sol-ultra-20261106-022440/vendor/engine/my-3d2dge.js:5038:class Blob {\nKC-Chomp-Chase-KC-Munchkin-gpt-6.1-sol-ultra-20261106-022440/vendor