{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -lc \"cat >> src/style.css <<'EOF'\n/* Keep native contextual cards outside the playable theatre. */\n.esh-toast{left:var(--pl)\"'!important;right:auto!important;top:var(--pt)!important;bottom:auto!important;transform:translateY(calc(-100% - 40px))!important;max-width:175px!important;text-align:left!important}\n.esh-toast.on{transform:translateY(0)!important}\n@media(max-width:700px){.esh-toast{left:var(--pl)!important;right:var(--pr)!important;top:calc(var(--pt) + 42px)!important;bottom:auto!important;max-width:none!important}}\nEOF\nbiome check --write --unsafe src/main.js src/view.js --diagnostic-level=error\nnode tools/build.mjs'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
