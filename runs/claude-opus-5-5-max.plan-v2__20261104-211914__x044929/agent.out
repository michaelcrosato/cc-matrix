{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgj9YJw4LWzg5m5xbbMVw","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018UwuFVK5SYeC4TAMUHGnXS","name":"Bash","input":{"command":"mkdir -p /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211914__x044929/work/_research/spike && cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211914__x044929/work/_research/spike && cp ../engine/pixel-engine/pixel-engine.js ../engine/pixel-engine/check.mjs . && cp ../hub/session.js ../hub/harness.html ../hub/bridge.js ../hub/round.js . && cat > spike.js <<'EOF'\n// Spike: can the engine draw a believable operating field, instruments and a talking bust?\nimport { Engine, THREE, TSL, toonMaterial, glowMaterial, PALETTE, setLookLayer, model, buildModel, ModelCatalog, MODEL_LIBRARY, LOOK_PRESETS, withUrlOptions, twoBoneIK, hologramMaterial, RopeMesh, ropeLine } from './pixel-engine.js';\nconst { Mesh, PlaneGeometry, BoxGeometry, CylinderGeometry, SphereGeometry, Group, Vector3, DataTexture, RGBAFormat, UnsignedByteType, Color, NearestFilter, DoubleSide } = THREE;\n\nconst params = new URLSearchParams(location.search);\nconst VIEW = params.get('view') || 'field';\n\nconst COLS = { bg:[0x7a,0x2c,0x3a], flesh:[0xc8,0x55,0x55], flesh2:[0xe0,0x7a,0x6c], fat:[0xf0,0xc4,0x8a], vein:[0x5a,0x24,0x66], blood:[0x8e,0x12,0x22], blood2:[0xc2,0x18,0x28], cut:[0x38,0x08,0x18], gel:[0x7c,0xe0,0xd8], bruise:[0x6c,0x2c,0x70]};\n\nclass Field {\n  constructor(w,h){ this.w=w; this.h=h; this.data=new Uint8Array(w*h*4); this.tex=new DataTexture(this.data,w,h,RGBAFormat,UnsignedByteType); this.tex.magFilter=NearestFilter; this.tex.minFilter=NearestFilter; this.tex.flipY=false; }\n  put(x,y,c){ x|=0;y|=0; if(x<0||y<0||x>=this.w||y>=this.h) return; const i=(x+y*this.w)*4; this.data[i]=c[0];this.data[i+1]=c[1];this.data[i+2]=c[2];this.data[i+3]=255; }\n  disc(cx,cy,r,c){ for(let y=-r;y<=r;y++)for(let x=-r;x<=r;x++) if(x*x+y*y<=r*r) this.put(cx+x,cy+y,c); }\n  line(ax,ay,bx,by,c,th=1){ const n=Math.max(Math.abs(bx-ax),Math.abs(by-ay))|0; for(let i=0;i<=n;i++){ const t=i/n; this.disc(ax+(bx-ax)*t,ay+(by-ay)*t,th,c);} }\n}\n\nconst hashN=(x,y)=>{ const s=Math.sin(x*12.9898+y*78.233)*43758.5453; return s-Math.floor(s); };\nconst vnoise=(x,y)=>{ const xi=Math.floor(x),yi=Math.floor(y),xf=x-xi,yf=y-yi; const u=xf*xf*(3-2*xf),v=yf*yf*(3-2*yf); const a=hashN(xi,yi),b=hashN(xi+1,yi),c=hashN(xi,yi+1),d=hashN(xi+1,yi+1); return a+(b-a)*u+(c-a)*v+(a-b-c+d)*u*v; };\n\nclass Spike {\n  name='Spike'; t=0;\n  target=new Vector3(0,0,0);\n  async setup(ctx){\n    const { scene, engine } = ctx;\n    window.__spike=this;\n    this.ctx=ctx;\n    scene.background=new Color(0x10121c);\n    engine.sun.intensity=2.2;\n    engine.setSunDirection([0.25,1,0.35]);\n    engine.ambient.color.setHex(0xfff0e0);\n    engine.ambient.intensity=1.6;\n    if(VIEW==='field') this.buildField(ctx);\n    if(VIEW==='bust') this.buildBust(ctx);\n    if(VIEW==='or') this.buildOR(ctx);\n    if(VIEW==='boss') { this.buildField(ctx); this.buildBoss(ctx); }\n    ctx.hud.clear();\n  }\n  buildField(ctx){\n    const { scene } = ctx;\n    // the paintable tissue canvas\n    const f=this.f=new Field(240,135);\n    for(let y=0;y<135;y++)for(let x=0;x<240;x++){\n      const n=vnoise(x*0.07,y*0.09)+0.5*vnoise(x*0.17,y*0.21);\n      f.put(x,y, n>1.02?COLS.flesh2 : n>0.45?COLS.flesh : COLS.bg);\n      const m=vnoise(x*0.23+9,y*0.05+3); if(m>0.86) f.put(x,y,COLS.fat);\n    }\n    // veins\n    let vx=20,vy=30; for(let i=0;i<70;i++){ const nx=vx+3+hashN(i,1)*2, ny=vy+(hashN(i,2)-0.45)*6; f.line(vx,vy,nx,ny,COLS.vein,0); vx=nx; vy=ny; }\n    vx=200;vy=120; for(let i=0;i<50;i++){ const nx=vx-3-hashN(i,3)*2, ny=vy-(hashN(i,4)-0.3)*5; f.line(vx,vy,nx,ny,COLS.vein,0); vx=nx; vy=ny; }\n    // a wound, a pool of blood, a bruise, gel\n    f.line(90,60,150,74,COLS.cut,2); f.line(92,61,148,73,COLS.blood,1);\n    for(let i=0;i<220;i++){ const a=hashN(i,5)*6.28,r=hashN(i,6)*16; f.disc(60+Math.cos(a)*r*1.5,96+Math.sin(a)*r,2,i%5?COLS.blood:COLS.blood2);}\n    for(let i=0;i<120;i++){ const a=hashN(i,7)*6.28,r=hashN(i,8)*12; f.disc(186+Math.cos(a)*r*1.4,40+Math.sin(a)*r,1,COLS.bruise);}\n    for(let i=0;i<80;i++){ const a=hashN(i,9)*6.28,r=hashN(i,10)*9; f.disc(120+Math.cos(a)*r*1.5,28+Math.sin(a)*r,1,COLS.gel);}\n    f.tex.needsUpdate=true;\n    // the tissue surface: a grid, displaced every frame (breathing, bulges)\n    const geo=this.geo=new PlaneGeometry(16,9,160,90); geo.rotateX(-Math.PI/2);\n    this.basePos=geo.attributes.position.array.slice();\n    this.tissue=new Mesh(geo, toonMaterial(PALETTE.white,{map:f.tex}));\n    this.tissue.receiveShadow=true; this.tissue.castShadow=false;\n    scene.add(this.tissue);\n    this.displace(0);\n    // rim: surgical drapes\n    const drape=toonMaterial(PALETTE.teal);\n    for(const [x,z,w,d] of [[0,-5.6,20,2.4],[0,5.6,20,2.4],[-9.4,0,2.8,9],[9.4,0,2.8,9]]){ const m=new Mesh(new BoxGeometry(w,0.5,d),drape); m.position.set(x,0.25,z); m.castShadow=m.receiveShadow=true; scene.add(m); }\n    // instruments\n    this.tool=new Group(); setLookLayer(this.tool,'actors'); scene.add(this.tool);\n    const steel=toonMaterial(PALETTE.mist), steelD=toonMaterial(PALETTE.slate), handle=toonMaterial(PALETTE.white);\n    const blade=new Mesh(new BoxGeometry(0.06,0.04,0.7),steel); blade.position.set(0,0.12,-0.3); blade.rotation.x=-0.25;\n    const shaft=new Mesh(new BoxGeometry(0.16,0.12,2.2),steelD); shaft.position.set(0,0.42,0.85); shaft.rotation.x=-0.28;\n    this.tool.add(blade,shaft); this.tool.position.set(1.2,0.4,0.4); this.tool.rotation.y=-0.5;\n    for(const m of [blade,shaft]) m.castShadow=true;\n    // a gloved hand and forearm from below the frame\n    const glove=toonMaterial(PALETTE.sky), sleeve=toonMaterial(PALETTE.teal);\n    this.hand=new Group(); setLookLayer(this.hand,'actors'); scene.add(this.hand);\n    const palm=new Mesh(new BoxGeometry(0.8,0.34,0.9),glove); palm.position.set(1.65,1.0,2.1); palm.rotation.set(-0.3,-0.5,0);\n    const thumb=new Mesh(new BoxGeometry(0.22,0.22,0.6),glove); thumb.position.set(1.2,0.85,1.7); thumb.rotation.set(-0.3,-0.2,0);\n    const fingers=new Mesh(new BoxGeometry(0.62,0.2,0.6),glove); fingers.position.set(1.45,0.85,1.55); fingers.rotation.set(-0.25,-0.5,0);\n    const arm=new Mesh(new CylinderGeometry(0.42,0.5,5,8),glove); arm.rotation.set(1.28,0,0.36); arm.position.set(2.75,1.8,4.6);\n    const cuff=new Mesh(new CylinderGeometry(0.52,0.56,2.4,8),sleeve); cuff.rotation.copy(arm.rotation); cuff.position.set(3.5,2.1,6.4);\n    this.hand.add(palm,thumb,fingers,arm,cuff);\n    for(const m of this.hand.children) m.castShadow=true;\n    // a suture: rope mesh across the wound\n    this.rope=ropeLine([-0.9,0.3,0.2],[0.4,0.35,0.9],16,{slack:1.1}); this.rope.gravity=[0,-4,0];\n    const rm=this.ropeMesh=new RopeMesh(this.rope,toonMaterial(PALETTE.navy),0.05); scene.add(rm); setLookLayer(rm,'actors');\n    // shards of glass\n    const glass=toonMaterial(PALETTE.cyan);\n    this.shards=[];\n    for(const [x,z,ry] of [[-3.6,-1.8,0.4],[-2.4,-2.6,1.8],[3.7,1.3,2.5],[4.7,-0.4,0.9]]){ const m=new Mesh(new CylinderGeometry(0.02,0.24,0.8,3),glass); m.position.set(x,0.34,z); m.rotation.set(0.5,ry,0.4); m.castShadow=true; setLookLayer(m,'actors'); scene.add(m); this.shards.push(m); }\n    ctx.lights.request({ position:[0,4,0], color:0xfff4e0, intensity:9, radius:14 });\n  }\n  displace(t){\n    const p=this.geo.attributes.position.array, b=this.basePos;\n    for(let i=0;i<p.length;i+=3){\n      const x=b[i], z=b[i+2];\n      let h=0.28*vnoise(x*0.55+4,z*0.55+1)+0.12*vnoise(x*1.3,z*1.3);\n      h+=0.12*Math.sin(t*1.6+x*0.25+z*0.15); // breathing\n      const d2=(x+1)*(x+1)+(z-0.5)*(z-0.5); h+=0.25*Math.exp(-d2*0.5)*(0.6+0.4*Math.sin(t*6)); // a pulsing bulge\n      p[i+1]=h;\n    }\n    this.geo.attributes.position.needsUpdate=true; this.geo.computeVertexNormals();\n  }\n  buildBoss(ctx){\n    const { scene } = ctx;\n    const g=this.boss=new Group(); setLookLayer(g,'actors'); scene.add(g); g.position.set(-1.5,0.9,-1.2);\n    const core=new Mesh(new SphereGeometry(0.9,10,8),toonMaterial(PALETTE.plum,{rim:PALETTE.lime}));\n    const iris=new Mesh(new SphereGeometry(0.42,8,6),glowMaterial(PALETTE.lime)); iris.position.set(0,0.35,0.62);\n    const pupil=new Mesh(new BoxGeometry(0.22,0.22,0.12),glowMaterial(PALETTE.ink)); pupil.position.set(0,0.42,0.98);\n    g.add(core,iris,pupil);\n    for(let i=0;i<8;i++){ const a=i/8*6.28; const t=new Mesh(new CylinderGeometry(0.05,0.2,1.8,5),toonMaterial(PALETTE.plum)); t.position.set(Math.cos(a)*1.25,-0.3,Math.sin(a)*1.25); t.rotation.set(Math.sin(a)*1.0,0,-Math.cos(a)*1.0); g.add(t); }\n    for(const m of g.children) m.castShadow=true;\n    ctx.lights.request({ follow:g, offset:[0,1.0,0], color:0x88ff55, intensity:6, radius:5, flicker:'pulse' });\n  }\n  buildBust(ctx){\n    const { scene } = ctx;\n    const d=model({ id:'bust', about:'A nurse bust for the talking-head test', tags:['character'], floats:true,\n      palette:{ skin:'orange', skinD:'red', scrub:'teal', hair:'ink', white:'white', ink:'ink', cap:'sky', lip:'plum' },\n      parts:[\n        { name:'torso', cyl:[1.5,0.9,1.0], at:[0,0.45,0], c:'scrub', top:0.7, seg:8 },\n        { name:'neck', cyl:[0.3,0.3,0.3], at:[0,1.0,0], c:'skin' },\n        { name:'head', ball:[1.0,1.15,1.0], at:[0,1.55,0], c:'skin', seg:10 },\n        { name:'cap', ball:[1.12,0.8,1.12], at:[0,1.92,-0.02], c:'cap', half:true },\n        { name:'bun', ball:[0.46,0.46,0.46], at:[0,1.85,-0.56], c:'hair' },\n        { mirror:[{ name:'eyeW', box:[0.2,0.15,0.04], at:[0.22,1.6,0.47], c:'white' }, { name:'pup', box:[0.1,0.13,0.04], at:[0.2,1.59,0.49], c:'ink' }, { name:'brow', box:[0.26,0.06,0.04], at:[0.22,1.74,0.47], rot:[0,0,-14], c:'ink' }], axis:'x' },\n        { name:'nose', box:[0.09,0.14,0.08], at:[0,1.48,0.51], c:'skinD' },\n        { name:'mouth', box:[0.26,0.06,0.04], at:[0,1.3,0.47], c:'lip' },\n        { name:'collar', box:[0.5,0.14,0.08], at:[0,0.9,0.42], c:'white' },\n      ],\n    });\n    const b=buildModel(d); setLookLayer(b.object,'actors'); scene.add(b.object); this.bust=b.object; b.object.position.set(0,0,0); console.log('bust report',JSON.stringify(b.report||{}).slice(0,300));\n    const wall=new Mesh(new BoxGeometry(14,8,0.4),toonMaterial(PALETTE.navy)); wall.position.set(0,2,-2.5); wall.receiveShadow=true; scene.add(wall);\n    const win=new Mesh(new BoxGeometry(2.4,2.2,0.1),toonMaterial(PALETTE.sky)); win.position.set(-2.8,2.6,-2.25); scene.add(win);\n    ctx.lights.request({ position:[1.5,2.6,2.5], color:0xfff0d8, intensity:6, radius:8 });\n  }\n  buildOR(ctx){\n    const { scene } = ctx;\n    const floor=new Mesh(new BoxGeometry(20,0.2,20),toonMaterial(PALETTE.slate)); floor.position.y=-0.1; floor.receiveShadow=true; scene.add(floor);\n    const wall=new Mesh(new BoxGeometry(20,6,0.3),toonMaterial(PALETTE.teal)); wall.position.set(0,3,-5); wall.receiveShadow=true; scene.add(wall);\n    const table=new Mesh(new BoxGeometry(1.0,0.9,2.2),toonMaterial(PALETTE.mist)); table.position.set(0,0.45,0); table.castShadow=table.receiveShadow=true; scene.add(table);\n    const pat=new Mesh(new BoxGeometry(0.7,0.2,1.8),toonMaterial(PALETTE.teal)); pat.position.set(0,1.0,0); pat.castShadow=true; scene.add(pat);\n    const lampArm=new Mesh(new CylinderGeometry(0.05,0.05,2,6),toonMaterial(PALETTE.mist)); lampArm.position.set(0,3.2,0); scene.add(lampArm);\n    const lamp=new Mesh(new CylinderGeometry(0.75,0.5,0.25,10),toonMaterial(PALETTE.white)); lamp.position.set(0,2.3,0); scene.add(lamp);\n    const lens=new Mesh(new CylinderGeometry(0.45,0.45,0.05,10),glowMaterial(PALETTE.sand)); lens.position.set(0,2.16,0); scene.add(lens);\n    ctx.lights.request({ position:[0,2.0,0], color:0xfff4d0, intensity:12, radius:8 });\n    this.lib=[];\n    for(const [id,at,turn] of [['kenney-furniture/bathroom-sink-square',[-3.2,0,-4.5],0]]){ /* pack not loaded in spike */ }\n    const monitor=new Group();\n    const body=new Mesh(new BoxGeometry(0.9,0.7,0.2),toonMaterial(PALETTE.night)); body.position.y=1.5;\n    const screen=new Mesh(new BoxGeometry(0.75,0.55,0.02),glowMaterial(PALETTE.lime)); screen.position.set(0,1.5,0.11);\n    const pole=new Mesh(new CylinderGeometry(0.05,0.08,1.2,6),toonMaterial(PALETTE.slate)); pole.position.y=0.6;\n    monitor.add(body,screen,pole); monitor.position.set(1.8,0,-0.6); monitor.rotation.y=-0.5; scene.add(monitor);\n    const person=(x,z,c)=>{ const g=new Group(); const t=new Mesh(new CylinderGeometry(0.2,0.28,0.95,8),toonMaterial(c)); t.position.y=1.15; const l=new Mesh(new BoxGeometry(0.4,0.7,0.26),toonMaterial(c)); l.position.y=0.35; const h=new Mesh(new SphereGeometry(0.17,8,6),toonMaterial(PALETTE.orange)); h.position.y=1.8; const cap=new Mesh(new SphereGeometry(0.18,8,5,0,6.3,0,1.3),toonMaterial(PALETTE.sky)); cap.position.y=1.84; g.add(t,l,h,cap); g.position.set(x,0,z); g.traverse(m=>{m.castShadow=true}); setLookLayer(g,'actors'); scene.add(g); };\n    person(-1.0,0.2,PALETTE.teal); person(1.0,0.5,PALETTE.blue); person(-0.9,-1.1,PALETTE.sky);\n  }\n  update(ctx,dt){\n    this.t+=dt;\n    if(this.geo) this.displace(this.t);\n    if(this.rope){ this.rope.step?.(dt); this.ropeMesh.sync(); }\n    if(this.bust){ const m=this.bust; m.rotation.y=Math.sin(this.t*0.6)*0.08; }\n    if(this.boss){ this.boss.rotation.y=this.t*0.5; this.boss.position.y=0.9+0.1*Math.sin(this.t*3); }\n    if(VIEW==='field'||VIEW==='boss') this.drawHud(ctx);\n    if(VIEW==='bust') this.drawTalk(ctx);\n  }\n  drawHud(ctx){\n    const h=ctx.hud; h.clear();\n    h.rect(0,0,h.width,18,'ink','top-left');\n    h.text(6,6,'VITALS 78',{color:'lime'});\n    h.text(0,6,'TIME 02:41',{anchor:'top',color:'sand'});\n    h.text(6,6,'SCALPEL',{anchor:'top-right',color:'white'});\n    // ekg strip\n    const w=120; for(let i=0;i<w;i++){ const ph=(i+this.t*80)%60; const y=ph<4?-ph*2:ph<8?-(8-ph)*2:0; h.rect(70+i,9+y|0,1,1,'lime'); }\n    h.rect(0,0,h.width,30,'ink','bottom-left');\n    h.text(8,8,'REYES: PRESSURE IS FALLING, DOCTOR. DRAIN THAT POOL BEFORE YOU CUT ANYTHING ELSE!',{anchor:'bottom-left',color:'white'});\n  }\n  drawTalk(ctx){\n    const h=ctx.hud; h.clear();\n    h.rect(0,0,h.width,54,'ink','bottom-left');\n    h.text(10,40,'NURSE REYES',{anchor:'bottom-left',color:'sand',scale:1});\n    h.text(10,24,'YOU ARE HOLDING THAT SCALPEL LIKE A BREAD KNIFE, DOCTOR.',{anchor:'bottom-left',color:'white'});\n    h.text(10,12,'THE KIDNEY IS NOT GOING TO BUTTER ITSELF. AGAIN.',{anchor:'bottom-left',color:'white'});\n  }\n  cameraTarget(){ return this.target; }\n  status(){ return `spike ${VIEW}`; }\n}\n\nexport const createGame=()=>new Spike();\nconst cams={\n  field:{ preset:'fixed', position:[0,9.6,3.1], target:[0,0,0.1], fov:44 },\n  boss:{ preset:'fixed', position:[0,9.6,3.1], target:[0,0,0.1], fov:44 },\n  bust:{ preset:'fixed', position:[0.2,1.75,3.4], target:[0,1.4,0], fov:40 },\n  or:{ preset:'fixed', position:[4.8,3.8,5.2], target:[0,1.0,0], fov:40 },\n};\nconst LOOK=params.get('lk');\nif(typeof document!=='undefined') {\n  window.__ENGINE_START=performance.now();\n  const engine=await Engine.start(createGame(), withUrlOptions({ container:document.getElementById('app'), camera:cams[VIEW], background:0x10121c, touch:false, settings:{button:false}, ...(LOOK?{look:LOOK_PRESETS[LOOK]}:{}) }));\n  window.__ENGINE_READY_MS=performance.now()-window.__ENGINE_START;\n}\nEOF\ncat > build.mjs <<'EOF'\n// usage: node build.mjs entry.js out.html [mode]  -- bundles the engine + game into one html\nimport { execFileSync } from 'node:child_process';\nimport { readFileSync, writeFileSync } from 'node:fs';\nconst [entry,out,mode='parallel']=process.argv.slice(2);\nexecFileSync('esbuild',[entry,'--bundle','--format=esm','--platform=browser','--target=es2022','--outfile=bundle.tmp.js','--log-level=warning'],{stdio:'inherit'});\nlet js=readFileSync('bundle.tmp.js','utf8');\nconst closing=(js.match(/<\\/script/gi)||[]).length; js=js.replace(/<\\/script/gi,'<\\\\/script');\nconst session=readFileSync('session.js','utf8');\nconst html=`<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n<script>\n${session}\n</script>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Spike</title>\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"${mode}\">\n<meta name=\"hub:session-minutes\" content=\"3\">\n<meta name=\"hub:session-goal\" content=\"spike\">\n<meta name=\"hub:session-howto\" content=\"spike\">\n<meta name=\"hub:webgpu\" content=\"required\">\n</head><body><div id=\"app\"></div>\n<script type=\"module\">\n${js}\n</script></body></html>`;\nwriteFileSync(out,html);\nconsole.log('wrote',out,(html.length/1e6).toFixed(2),'MB; escaped </script x',closing);\nEOF\nnode build.mjs spike.js spike.html && ls -la spike.html && rm -f bundle.tmp.js","description":"Write a rendering spike and bundle it into one HTML file","timeout":120000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":26562,"cache_read_input_tokens":220960,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":26562},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8b716b92-81c2-4c62-8381-9131b2f861f1","uuid":"96126e68-1780-47da-b10c-aa20012453ce","timestamp":"2026-11-05T04:28:08.652Z","request_id":"req_011Cgj9YJewQ33m8JJomwFs4","wire_tool_inputs":{"toolu_018UwuFVK5SYeC4TAMUHGnXS":{"command":"mkdir -p /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211914__x044929/work/_research/spike && cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211914__x044929/work/_research/spike && cp ../engine/pixel-engine/pixel-engine.js ../engine/pixel-engine/check.mjs . && cp ../hub/session.js ../hub/harness.html ../hub/bridge.js ../hub/round.js . && cat > spike.js <<'EOF'\n// Spike: can the engine draw a believable operating field, instruments and a talking bust?\nimport { Engine, THREE, TSL, toonMaterial, glowMaterial, PALETTE, setLookLayer, model, buildModel, ModelCatalog, MODEL_LIBRARY, LOOK_PRESETS, withUrlOptions, twoBoneIK, hologramMaterial, RopeMesh, ropeLine } from './pixel-engine.js';\nconst { Mesh, PlaneGeometry, BoxGeometry, CylinderGeometry, SphereGeometry, Group, Vector3, DataTexture, RGBAFormat, UnsignedByteType, Color, NearestFilter, DoubleSide } = THREE;\n\nconst params = new URLSearchParams(location.search);\nconst VIEW = params.get('view') || 'field';\n\nconst COLS = { bg:[0x7a,0x2c,0x3a], flesh:[0xc8,0x55,0x55], flesh2:[0xe0,0x7a,0x6c], fat:[0xf0,0xc4,0x8a], vein:[0x5a,0x24,0x66], blood:[0x8e,0x12,0x22], blood2:[0xc2,0x18,0x28], cut:[0x38,0x08,0x18], gel:[0x7c,0xe0,0xd8], bruise:[0x6c,0x2c,0x70]};\n\nclass Field {\n  constructor(w,h){ this.w=w; this.h=h; this.data=new Uint8Array(w*h*4); this.tex=new DataTexture(this.data,w,h,RGBAFormat,UnsignedByteType); this.tex.magFilter=NearestFilter; this.tex.minFilter=NearestFilter; this.tex.flipY=false; }\n  put(x,y,c){ x|=0;y|=0; if(x<0||y<0||x>=this.w||y>=this.h) return; const i=(x+y*this.w)*4; this.data[i]=c[0];this.data[i+1]=c[1];this.data[i+2]=c[2];this.data[i+3]=255; }\n  disc(cx,cy,r,c){ for(let y=-r;y<=r;y++)for(let x=-r;x<=r;x++) if(x*x+y*y<=r*r) this.put(cx+x,cy+y,c); }\n  line(ax,ay,bx,by,c,th=1){ const n=Math.max(Math.abs(bx-ax),Math.abs(by-ay))|0; for(let i=0;i<=n;i++){ const t=i/n; this.disc(ax+(bx-ax)*t,ay+(by-ay)*t,th,c);} }\n}\n\nconst hashN=(x,y)=>{ const s=Math.sin(x*12.9898+y*78.233)*43758.5453; return s-Math.floor(s); };\nconst vnoise=(x,y)=>{ const xi=Math.floor(x),yi=Math.floor(y),xf=x-xi,yf=y-yi; const u=xf*xf*(3-2*xf),v=yf*yf*(3-2*yf); const a=hashN(xi,yi),b=hashN(xi+1,yi),c=hashN(xi,yi+1),d=hashN(xi+1,yi+1); return a+(b-a)*u+(c-a)*v+(a-b-c+d)*u*v; };\n\nclass Spike {\n  name='Spike'; t=0;\n  target=new Vector3(0,0,0);\n  async setup(ctx){\n    const { scene, engine } = ctx;\n    window.__spike=this;\n    this.ctx=ctx;\n    scene.background=new Color(0x10121c);\n    engine.sun.intensity=2.2;\n    engine.setSunDirection([0.25,1,0.35]);\n    engine.ambient.color.setHex(0xfff0e0);\n    engine.ambient.intensity=1.6;\n    if(VIEW==='field') this.buildField(ctx);\n    if(VIEW==='bust') this.buildBust(ctx);\n    if(VIEW==='or') this.buildOR(ctx);\n    if(VIEW==='boss') { this.buildField(ctx); this.buildBoss(ctx); }\n    ctx.hud.clear();\n  }\n  buildField(ctx){\n    const { scene } = ctx;\n    // the paintable tissue canvas\n    const f=this.f=new Field(240,135);\n    for(let y=0;y<135;y++)for(let x=0;x<240;x++){\n      const n=vnoise(x*0.07,y*0.09)+0.5*vnoise(x*0.17,y*0.21);\n      f.put(x,y, n>1.02?COLS.flesh2 : n>0.45?COLS.flesh : COLS.bg);\n      const m=vnoise(x*0.23+9,y*0.05+3); if(m>0.86) f.put(x,y,COLS.fat);\n    }\n    // veins\n    let vx=20,vy=30; for(let i=0;i<70;i++){ const nx=vx+3+hashN(i,1)*2, ny=vy+(hashN(i,2)-0.45)*6; f.line(vx,vy,nx,ny,COLS.vein,0); vx=nx; vy=ny; }\n    vx=200;vy=120; for(let i=0;i<50;i++){ const nx=vx-3-hashN(i,3)*2, ny=vy-(hashN(i,4)-0.3)*5; f.line(vx,vy,nx,ny,COLS.vein,0); vx=nx; vy=ny; }\n    // a wound, a pool of blood, a bruise, gel\n    f.line(90,60,150,74,COLS.cut,2); f.line(92,61,148,73,COLS.blood,1);\n    for(let i=0;i<220;i++){ const a=hashN(i,5)*6.28,r=hashN(i,6)*16; f.disc(60+Math.cos(a)*r*1.5,96+Math.sin(a)*r,2,i%5?COLS.blood:COLS.blood2);}\n    for(let i=0;i<120;i++){ const a=hashN(i,7)*6.28,r=hashN(i,8)*12; f.disc(186+Math.cos(a)*r*1.4,40+Math.sin(a)*r,1,COLS.bruise);}\n    for(let i=0;i<80;i++){ const a=hashN(i,9)*6.28,r=hashN(i,10)*9; f.disc(120+Math.cos(a)*r*1.5,28+Math.sin(a)*r,1,COLS.gel);}\n    f.tex.needsUpdate=true;\n    // the tissue surface: a grid, displaced every frame (breathing, bulges)\n    const geo=this.geo=new PlaneGeometry(16,9,160,90); geo.rotateX(-Math.PI/2);\n    this.basePos=geo.attributes.position.array.slice();\n    this.tissue=new Mesh(geo, toonMaterial(PALETTE.white,{map:f.tex}));\n    this.tissue.receiveShadow=true; this.tissue.castShadow=false;\n    scene.add(this.tissue);\n    this.displace(0);\n    // rim: surgical drapes\n    const drape=toonMaterial(PALETTE.teal);\n    for(const [x,z,w,d] of [[0,-5.6,20,2.4],[0,5.6,20,2.4],[-9.4,0,2.8,9],[9.4,0,2.8,9]]){ const m=new Mesh(new BoxGeometry(w,0.5,d),drape); m.position.set(x,0.25,z); m.castShadow=m.receiveShadow=true; scene.add(m); }\n    // instruments\n    this.tool=new Group(); setLookLayer(this.tool,'actors'); scene.add(this.tool);\n    const steel=toonMaterial(PALETTE.mist), steelD=toonMaterial(PALETTE.slate), handle=toonMaterial(PALETTE.white);\n    const blade=new Mesh(new BoxGeometry(0.06,0.04,0.7),steel); blade.position.set(0,0.12,-0.3); blade.rotation.x=-0.25;\n    const shaft=new Mesh(new BoxGeometry(0.16,0.12,2.2),steelD); shaft.position.set(0,0.42,0.85); shaft.rotation.x=-0.28;\n    this.tool.add(blade,shaft); this.tool.position.set(1.2,0.4,0.4); this.tool.rotation.y=-0.5;\n    for(const m of [blade,shaft]) m.castShadow=true;\n    // a gloved hand and forearm from below the frame\n    const glove=toonMaterial(PALETTE.sky), sleeve=toonMaterial(PALETTE.teal);\n    this.hand=new Group(); setLookLayer(this.hand,'actors'); scene.add(this.hand);\n    const palm=new Mesh(new BoxGeometry(0.8,0.34,0.9),glove); palm.position.set(1.65,1.0,2.1); palm.rotation.set(-0.3,-0.5,0);\n    const thumb=new Mesh(new BoxGeometry(0.22,0.22,0.6),glove); thumb.position.set(1.2,0.85,1.7); thumb.rotation.set(-0.3,-0.2,0);\n    const fingers=new Mesh(new BoxGeometry(0.62,0.2,0.6),glove); fingers.position.set(1.45,0.85,1.55); fingers.rotation.set(-0.25,-0.5,0);\n    const arm=new Mesh(new CylinderGeometry(0.42,0.5,5,8),glove); arm.rotation.set(1.28,0,0.36); arm.position.set(2.75,1.8,4.6);\n    const cuff=new Mesh(new CylinderGeometry(0.52,0.56,2.4,8),sleeve); cuff.rotation.copy(arm.rotation); cuff.position.set(3.5,2.1,6.4);\n    this.hand.add(palm,thumb,fingers,arm,cuff);\n    for(const m of this.hand.children) m.castShadow=true;\n    // a suture: rope mesh across the wound\n    this.rope=ropeLine([-0.9,0.3,0.2],[0.4,0.35,0.9],16,{slack:1.1}); this.rope.gravity=[0,-4,0];\n    const rm=this.ropeMesh=new RopeMesh(this.rope,toonMaterial(PALETTE.navy),0.05); scene.add(rm); setLookLayer(rm,'actors');\n    // shards of glass\n    const glass=toonMaterial(PALETTE.cyan);\n    this.shards=[];\n    for(const [x,z,ry] of [[-3.6,-1.8,0.4],[-2.4,-2.6,1.8],[3.7,1.3,2.5],[4.7,-0.4,0.9]]){ const m=new Mesh(new CylinderGeometry(0.02,0.24,0.8,3),glass); m.position.set(x,0.34,z); m.rotation.set(0.5,ry,0.4); m.castShadow=true; setLookLayer(m,'actors'); scene.add(m); this.shards.push(m); }\n    ctx.lights.request({ position:[0,4,0], color:0xfff4e0, intensity:9, radius:14 });\n  }\n  displace(t){\n    const p=this.geo.attributes.position.array, b=this.basePos;\n    for(let i=0;i<p.length;i+=3){\n      const x=b[i], z=b[i+2];\n      let h=0.28*vnoise(x*0.55+4,z*0.55+1)+0.12*vnoise(x*1.3,z*1.3);\n      h+=0.12*Math.sin(t*1.6+x*0.25+z*0.15); // breathing\n      const d2=(x+1)*(x+1)+(z-0.5)*(z-0.5); h+=0.25*Math.exp(-d2*0.5)*(0.6+0.4*Math.sin(t*6)); // a pulsing bulge\n      p[i+1]=h;\n    }\n    this.geo.attributes.position.needsUpdate=true; this.geo.computeVertexNormals();\n  }\n  buildBoss(ctx){\n    const { scene } = ctx;\n    const g=this.boss=new Group(); setLookLayer(g,'actors'); scene.add(g); g.position.set(-1.5,0.9,-1.2);\n    const core=new Mesh(new SphereGeometry(0.9,10,8),toonMaterial(PALETTE.plum,{rim:PALETTE.lime}));\n    const iris=new Mesh(new SphereGeometry(0.42,8,6),glowMaterial(PALETTE.lime)); iris.position.set(0,0.35,0.62);\n    const pupil=new Mesh(new BoxGeometry(0.22,0.22,0.12),glowMaterial(PALETTE.ink)); pupil.position.set(0,0.42,0.98);\n    g.add(core,iris,pupil);\n    for(let i=0;i<8;i++){ const a=i/8*6.28; const t=new Mesh(new CylinderGeometry(0.05,0.2,1.8,5),toonMaterial(PALETTE.plum)); t.position.set(Math.cos(a)*1.25,-0.3,Math.sin(a)*1.25); t.rotation.set(Math.sin(a)*1.0,0,-Math.cos(a)*1.0); g.add(t); }\n    for(const m of g.children) m.castShadow=true;\n    ctx.lights.request({ follow:g, offset:[0,1.0,0], color:0x88ff55, intensity:6, radius:5, flicker:'pulse' });\n  }\n  buildBust(ctx){\n    const { scene } = ctx;\n    const d=model({ id:'bust', about:'A nurse bust for the talking-head test', tags:['character'], floats:true,\n      palette:{ skin:'orange', skinD:'red', scrub:'teal', hair:'ink', white:'white', ink:'ink', cap:'sky', lip:'plum' },\n      parts:[\n        { name:'torso', cyl:[1.5,0.9,1.0], at:[0,0.45,0], c:'scrub', top:0.7, seg:8 },\n        { name:'neck', cyl:[0.3,0.3,0.3], at:[0,1.0,0], c:'skin' },\n        { name:'head', ball:[1.0,1.15,1.0], at:[0,1.55,0], c:'skin', seg:10 },\n        { name:'cap', ball:[1.12,0.8,1.12], at:[0,1.92,-0.02], c:'cap', half:true },\n        { name:'bun', ball:[0.46,0.46,0.46], at:[0,1.85,-0.56], c:'hair' },\n        { mirror:[{ name:'eyeW', box:[0.2,0.15,0.04], at:[0.22,1.6,0.47], c:'white' }, { name:'pup', box:[0.1,0.13,0.04], at:[0.2,1.59,0.49], c:'ink' }, { name:'brow', box:[0.26,0.06,0.04], at:[0.22,1.74,0.47], rot:[0,0,-14], c:'ink' }], axis:'x' },\n        { name:'nose', box:[0.09,0.14,0.08], at:[0,1.48,0.51], c:'skinD' },\n        { name:'mouth', box:[0.26,0.06,0.04], at:[0,1.3,0.47], c:'lip' },\n        { name:'collar', box:[0.5,0.14,0.08], at:[0,0.9,0.42], c:'white' },\n      ],\n    });\n    const b=buildModel(d); setLookLayer(b.object,'actors'); scene.add(b.object); this.bust=b.object; b.object.position.set(0,0,0); console.log('bust report',JSON.stringify(b.report||{}).slice(0,300));\n    const wall=new Mesh(new BoxGeometry(14,8,0.4),toonMaterial(PALETTE.navy)); wall.position.set(0,2,-2.5); wall.receiveShadow=true; scene.add(wall);\n    const win=new Mesh(new BoxGeometry(2.4,2.2,0.1),toonMaterial(PALETTE.sky)); win.position.set(-2.8,2.6,-2.25); scene.add(win);\n    ctx.lights.request({ position:[1.5,2.6,2.5], color:0xfff0d8, intensity:6, radius:8 });\n  }\n  buildOR(ctx){\n    const { scene } = ctx;\n    const floor=new Mesh(new BoxGeometry(20,0.2,20),toonMaterial(PALETTE.slate)); floor.position.y=-0.1; floor.receiveShadow=true; scene.add(floor);\n    const wall=new Mesh(new BoxGeometry(20,6,0.3),toonMaterial(PALETTE.teal)); wall.position.set(0,3,-5); wall.receiveShadow=true; scene.add(wall);\n    const table=new Mesh(new BoxGeometry(1.0,0.9,2.2),toonMaterial(PALETTE.mist)); table.position.set(0,0.45,0); table.castShadow=table.receiveShadow=true; scene.add(table);\n    const pat=new Mesh(new BoxGeometry(0.7,0.2,1.8),toonMaterial(PALETTE.teal)); pat.position.set(0,1.0,0); pat.castShadow=true; scene.add(pat);\n    const lampArm=new Mesh(new CylinderGeometry(0.05,0.05,2,6),toonMaterial(PALETTE.mist)); lampArm.position.set(0,3.2,0); scene.add(lampArm);\n    const lamp=new Mesh(new CylinderGeometry(0.75,0.5,0.25,10),toonMaterial(PALETTE.white)); lamp.position.set(0,2.3,0); scene.add(lamp);\n    const lens=new Mesh(new CylinderGeometry(0.45,0.45,0.05,10),glowMaterial(PALETTE.sand)); lens.position.set(0,2.16,0); scene.add(lens);\n    ctx.lights.request({ position:[0,2.0,0], color:0xfff4d0, intensity:12, radius:8 });\n    this.lib=[];\n    for(const [id,at,turn] of [['kenney-furniture/bathroom-sink-square',[-3.2,0,-4.5],0]]){ /* pack not loaded in spike */ }\n    const monitor=new Group();\n    const body=new Mesh(new BoxGeometry(0.9,0.7,0.2),toonMaterial(PALETTE.night)); body.position.y=1.5;\n    const screen=new Mesh(new BoxGeometry(0.75,0.55,0.02),glowMaterial(PALETTE.lime)); screen.position.set(0,1.5,0.11);\n    const pole=new Mesh(new CylinderGeometry(0.05,0.08,1.2,6),toonMaterial(PALETTE.slate)); pole.position.y=0.6;\n    monitor.add(body,screen,pole); monitor.position.set(1.8,0,-0.6); monitor.rotation.y=-0.5; scene.add(monitor);\n    const person=(x,z,c)=>{ const g=new Group(); const t=new Mesh(new CylinderGeometry(0.2,0.28,0.95,8),toonMaterial(c)); t.position.y=1.15; const l=new Mesh(new BoxGeometry(0.4,0.7,0.26),toonMaterial(c)); l.position.y=0.35; const h=new Mesh(new SphereGeometry(0.17,8,6),toonMaterial(PALETTE.orange)); h.position.y=1.8; const cap=new Mesh(new SphereGeometry(0.18,8,5,0,6.3,0,1.3),toonMaterial(PALETTE.sky)); cap.position.y=1.84; g.add(t,l,h,cap); g.position.set(x,0,z); g.traverse(m=>{m.castShadow=true}); setLookLayer(g,'actors'); scene.add(g); };\n    person(-1.0,0.2,PALETTE.teal); person(1.0,0.5,PALETTE.blue); person(-0.9,-1.1,PALETTE.sky);\n  }\n  update(ctx,dt){\n    this.t+=dt;\n    if(this.geo) this.displace(this.t);\n    if(this.rope){ this.rope.step?.(dt); this.ropeMesh.sync(); }\n    if(this.bust){ const m=this.bust; m.rotation.y=Math.sin(this.t*0.6)*0.08; }\n    if(this.boss){ this.boss.rotation.y=this.t*0.5; this.boss.position.y=0.9+0.1*Math.sin(this.t*3); }\n    if(VIEW==='field'||VIEW==='boss') this.drawHud(ctx);\n    if(VIEW==='bust') this.drawTalk(ctx);\n  }\n  drawHud(ctx){\n    const h=ctx.hud; h.clear();\n    h.rect(0,0,h.width,18,'ink','top-left');\n    h.text(6,6,'VITALS 78',{color:'lime'});\n    h.text(0,6,'TIME 02:41',{anchor:'top',color:'sand'});\n    h.text(6,6,'SCALPEL',{anchor:'top-right',color:'white'});\n    // ekg strip\n    const w=120; for(let i=0;i<w;i++){ const ph=(i+this.t*80)%60; const y=ph<4?-ph*2:ph<8?-(8-ph)*2:0; h.rect(70+i,9+y|0,1,1,'lime'); }\n    h.rect(0,0,h.width,30,'ink','bottom-left');\n    h.text(8,8,'REYES: PRESSURE IS FALLING, DOCTOR. DRAIN THAT POOL BEFORE YOU CUT ANYTHING ELSE!',{anchor:'bottom-left',color:'white'});\n  }\n  drawTalk(ctx){\n    const h=ctx.hud; h.clear();\n    h.rect(0,0,h.width,54,'ink','bottom-left');\n    h.text(10,40,'NURSE REYES',{anchor:'bottom-left',color:'sand',scale:1});\n    h.text(10,24,'YOU ARE HOLDING THAT SCALPEL LIKE A BREAD KNIFE, DOCTOR.',{anchor:'bottom-left',color:'white'});\n    h.text(10,12,'THE KIDNEY IS NOT GOING TO BUTTER ITSELF. AGAIN.',{anchor:'bottom-left',color:'white'});\n  }\n  cameraTarget(){ return this.target; }\n  status(){ return `spike ${VIEW}`; }\n}\n\nexport const createGame=()=>new Spike();\nconst cams={\n  field:{ preset:'fixed', position:[0,9.6,3.1], target:[0,0,0.1], fov:44 },\n  boss:{ preset:'fixed', position:[0,9.6,3.1], target:[0,0,0.1], fov:44 },\n  bust:{ preset:'fixed', position:[0.2,1.75,3.4], target:[0,1.4,0], fov:40 },\n  or:{ preset:'fixed', position:[4.8,3.8,5.2], target:[0,1.0,0], fov:40 },\n};\nconst LOOK=params.get('lk');\nif(typeof document!=='undefined') {\n  window.__ENGINE_START=performance.now();\n  const engine=await Engine.start(createGame(), withUrlOptions({ container:document.getElementById('app'), camera:cams[VIEW], background:0x10121c, touch:false, settings:{button:false}, ...(LOOK?{look:LOOK_PRESETS[LOOK]}:{}) }));\n  window.__ENGINE_READY_MS=performance.now()-window.__ENGINE_START;\n}\nEOF\ncat > build.mjs <<'EOF'\n// usage: node build.mjs entry.js out.html [mode]  -- bundles the engine + game into one html\nimport { execFileSync } from 'node:child_process';\nimport { readFileSync, writeFileSync } from 'node:fs';\nconst [entry,out,mode='parallel']=process.argv.slice(2);\nexecFileSync('esbuild',[entry,'--bundle','--format=esm','--platform=browser','--target=es2022','--outfile=bundle.tmp.js','--log-level=warning'],{stdio:'inherit'});\nlet js=readFileSync('bundle.tmp.js','utf8');\nconst closing=(js.match(/<\\/script/gi)||[]).length; js=js.replace(/<\\/script/gi,'<\\\\/script');\nconst session=readFileSync('session.js','utf8');\nconst html=`<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n<script>\n${session}\n</script>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Spike</title>\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"${mode}\">\n<meta name=\"hub:session-minutes\" content=\"3\">\n<meta name=\"hub:session-goal\" content=\"spike\">\n<meta name=\"hub:session-howto\" content=\"spike\">\n<meta name=\"hub:webgpu\" content=\"required\">\n</head><body><div id=\"app\"></div>\n<script type=\"module\">\n${js}\n</script></body></html>`;\nwriteFileSync(out,html);\nconsole.log('wrote',out,(html.length/1e6).toFixed(2),'MB; escaped </script x',closing);\nEOF\nnode build.mjs spike.js spike.html && ls -la spike.html && rm -f bundle.tmp.js","description":"Write a rendering spike and bundle it into one HTML file","timeout":120000}}}
