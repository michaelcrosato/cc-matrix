{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011RxrWc8SFwiR3DWJdbTp8n","type":"tool_result","content":"1\timport { AmbientLight, DirectionalLight, Scene, Vector3 } from 'three/webgpu';\n2\timport { type AssetReader, loadModel } from './assets';\n3\timport { AudioManager } from './audio/AudioManager';\n4\timport { type CameraConfig, type CameraRig } from './camera';\n5\timport { DebugUI } from './DebugUI';\n6\timport { type DebugKeyMap, type DebugKeysOption } from './debugKeys';\n7\timport { type AspectMode, type Resolution, type Viewport } from './framing';\n8\timport { Hud } from './hud/Hud';\n9\timport { Input } from './input';\n10\timport { Particles } from './particles/Particles';\n11\timport { type TouchButton, TouchControls, type TouchCorner } from './TouchControls';\n12\timport { Settings } from './settings';\n13\timport { PALETTE } from './palette';\n14\timport { Physics } from './physics/Physics';\n15\timport { type QualityLevel, type QualityOption } from './quality';\n16\timport { type Look } from './render/look';\n17\timport { LightPool } from './render/lights';\n18\timport { type EdgeSettings, PixelRenderer, type RenderMode } from './render/PixelRenderer';\n19\timport type { View } from './render/view';\n20\timport { Rng } from './random';\n21\timport { type Recording } from './replay';\n22\timport { CameraShake } from './shake';\n23\timport { type Snapshot } from './snapshot';\n24\timport { Tweens } from './tween';\n25\timport type { ScreenFx } from './render/screenFx';\n26\texport interface GameContext {\n27\t    readonly engine: Engine;\n28\t    readonly scene: Scene;\n29\t    readonly physics: Physics;\n30\t    readonly input: Input;\n31\t    readonly camera: CameraRig;\n32\t    readonly loadModel: typeof loadModel;\n33\t    readonly palette: typeof PALETTE;\n34\t    /** Game time in seconds since start. Frozen while paused or loading. */\n35\t    readonly time: number;\n36\t    /**\n37\t     * This level's seeded randomness (src/engine/random.ts): the same engine seed and game give\n38\t     * the same numbers. Use it (or forks of it) for everything random; never Math.random.\n39\t     */\n40\t    readonly random: Rng;\n41\t    /** Sound effects, music, volumes (src/engine/audio). */\n42\t    readonly audio: AudioManager;\n43\t    /** Pixel particles: `particles.burst('dust', at)` (src/engine/particles). */\n44\t    readonly particles: Particles;\n45\t    /** Pixel HUD text and icons in art pixels (src/engine/hud). */\n46\t    readonly hud: Hud;\n47\t    /**\n48\t     * Dynamic point lights: `lights.request({ position, color, intensity, radius, flicker })`\n49\t     * (src/engine/render/lights.ts). A fixed pool sized by quality, created on first use.\n50\t     */\n51\t    readonly lights: LightPool;\n52\t    /**\n53\t     * Tweens on game time: `tweens.to(door.position, { y: 3 }, { duration: 0.8, ease: 'outBack' })`\n54\t     * (src/engine/tween.ts). Cleared when the level unloads.\n55\t     */\n56\t    readonly tweens: Tweens;\n57\t}\n58\t/**\n59\t * A game is a plain object. The engine owns rendering, physics stepping, camera,\n60\t * lighting and debug UI; the game only builds its world and reacts to input.\n61\t */\n62\texport interface Game {\n63\t    readonly name: string;\n64\t    /**\n65\t     * The plain JSON the game was made with, when its name alone can't rebuild it (a lab's depth\n66\t     * and seed, the door a room was entered by): kept in its recordings (`Recording.args`), so a\n67\t     * tool can make the same game again to replay one (`npm run replay`, src/games.ts).\n68\t     */\n69\t    readonly args?: unknown;\n70\t    /**\n71\t     * Models `setup` will load (`ctx.loadModel` URLs). Optional: listing them lets the\n72\t     * engine start downloading while the renderer and physics initialise.\n73\t     */\n74\t    readonly assets?: readonly string[];\n75\t    /** Build the level: load models, add colliders, spawn entities. */\n76\t    setup(ctx: GameContext): Promise<void> | void;\n77\t    /** Runs before every fixed 60 Hz physics step. Move characters/apply forces here. */\n78\t    fixedUpdate?(ctx: GameContext, dt: number): void;\n79\t    /**\n80\t     * Runs when the engine starts running this game: after `Engine.start` (just before\n81\t     * `__PIXEL_READY__` resolves) and after each `loadGame`. Install page handles for tools here\n82\t     * (`window.__MYGAME__`), so they never exist before the engine can step. An exception is\n83\t     * reported like any hook's (`engine.errors`, on screen); the game runs on.\n84\t     */\n85\t    ready?(ctx: GameContext): void;\n86\t    /** Runs once per rendered frame after physics (animation, pickups, UI state). */\n87\t    update?(ctx: GameContext, dt: number): void;\n88\t    /** World position the camera follows. */\n89\t    cameraTarget(ctx: GameContext): Vector3;\n90\t    /** First-person eye position (defaults to cameraTarget + 0.7 up). */\n91\t    eyePosition?(ctx: GameContext): Vector3;\n92\t    /** One-line status for the debug UI (score, lives...). */\n93\t    status?(ctx: GameContext): string;\n94\t    /**\n95\t     * The game's own state as a short string or hash, for `engine.fingerprint()`: what lives\n96\t     * outside physics and `ctx.random` (positions, life, counters, the game's own random\n97\t     * streams), so two runs that should match (a replay) can be compared. Only what a replay must\n98\t     * reproduce: no timings or measurements.\n99\t     */\n100\t    fingerprint?(ctx: GameContext): string;\n101\t    /**\n102\t     * The game's own state as plain data, between frames (`engine.snapshot()`): everything a\n103\t     * later frame reads that the engine does not keep (its entities, timers, random streams; the\n104\t     * handles of its physics bodies). With `restore`, the game has save-states.\n105\t     */\n106\t    snapshot?(ctx: GameContext): unknown;\n107\t    /**\n108\t     * Put the game back to what `snapshot` returned (`engine.restore()`): the same game, already\n109\t     * set up. Find physics bodies again by handle (`ctx.physics.world.getRigidBody(h)`).\n110\t     */\n111\t    restore?(ctx: GameContext, state: unknown): void | Promise<void>;\n112\t    /**\n113\t     * Optional: leave whatever mode the game is in before a restore changes anything (a mode\n114\t     * with a camera of its own, a dialog, a level): `engine.restore()` calls it first, then checks\n115\t     * the snapshot fits (the camera preset) and puts the engine's part back, then `restore`.\n116\t     */\n117\t    beforeRestore?(ctx: GameContext): void | Promise<void>;\n118\t    /**\n119\t     * Called after `engine.setCamera()` swapped the camera preset mid-game. The world,\n120\t     * physics and player are untouched; adjust anything that depends on the preset\n121\t     * (e.g. side-scroller lane lock, hiding the player model in first person).\n122\t     */\n123\t    onCameraChange?(ctx: GameContext): void;\n124\t    /**\n125\t     * Called when the game is unloaded (`engine.loadGame(other)` or `engine.dispose()`),\n126\t     * before the engine removes its scene objects, physics bodies, triggers, particles, HUD\n127\t     * and music. Free anything else the game owns: DOM, timers, listeners, HMR hooks.\n128\t     */\n129\t    dispose?(ctx: GameContext): void;\n130\t}\n131\texport interface EngineOptions {\n132\t    container?: HTMLElement;\n133\t    resolution?: Resolution;\n134\t    /**\n135\t     * `adaptive` (default): the art height stays `resolution.height` and the art width\n136\t     * follows the screen's aspect (portrait phones fill the screen). `fixed`: always exactly\n137\t     * `resolution`, letterboxed. `fill`: adjusts both art dimensions to cover the viewport\n138\t     * at an integer scale, without black borders or stretched pixels.\n139\t     */\n140\t    aspect?: AspectMode;\n141\t    /**\n142\t     * Cap the render loop (simulation keeps its fixed 60 Hz physics step). Default 60, so\n143\t     * 120 Hz phones don't run the whole pipeline twice per game frame. 0 = display rate.\n144\t     */\n145\t    maxFps?: number;\n146\t    /** Shadow map quality, or `auto` (default: low on touch devices, else medium; lowered once on a slow start). */\n147\t    quality?: QualityOption;\n148\t    /** Pixel-styled loading indicator while the renderer, physics and assets load. Default true. */\n149\t    loadingScreen?: boolean;\n150\t    mode?: RenderMode;\n151\t    edges?: EdgeSettings;\n152\t    /** Camera preset + parameters. Pick one per game; not meant to change during play. */\n153\t    camera?: CameraConfig;\n154\t    /** Post filters (ids from FILTERS) applied in Pixel mode, in order. */\n155\t    filters?: readonly string[];\n156\t    /**\n157\t     * A full look: pixel art or clean rendering and filters per layer (characters & objects,\n158\t     * environment) plus whole-scene filters (render/look.ts). Wins over `filters` and `edges`.\n159\t     */\n160\t    look?: Look;\n161\t    /**\n162\t     * Seed for `ctx.random`: each level gets its own stream from this and the game's name, so\n163\t     * the same seed replays the same game. Default 1. `?seed=` in the URL.\n164\t     */\n165\t    seed?: number;\n166\t    /**\n167\t     * Frames of input the engine keeps for each level (`recording()`). Default `MAX_FRAMES`, an\n168\t     * hour at 60 fps (up to some 20 MB of JSON with the mouse moving all the time); 0 records nothing.\n169\t     */\n170\t    record?: number;\n171\t    /** Debug panel. Default: on in dev (`vite`) or with ?debug=1, off in production builds. */\n172\t    debugUI?: boolean;\n173\t    /**\n174\t     * Engine hotkeys (P Pixel/Raw, R resolution, ` debug panel, [ ] looks, M mute): developer\n175\t     * tools. Default: on with the debug panel (dev, ?debug=1), off in a shipped game, whose players\n176\t     * have the same options in the settings. `true` / `false`: always on / off; an object rebinds\n177\t     * or disables (null) single actions, and they still come with the debug panel.\n178\t     */\n179\t    debugKeys?: DebugKeysOption;\n180\t    /**\n181\t     * The player's settings (`engine.settings`): look, pixel art, pixel size, quality, frame rate,\n182\t     * sound and debug info, in a panel the ⚙ button opens. `button`: its corner (default, or true:\n183\t     * 'top-right'; on a mouse it shows while the pointer moves), or false for none: open the\n184\t     * panel from your own menu (`engine.settings.open()`). `key`: where they are saved\n185\t     * (localStorage `pixel-engine:settings:<key>`; default the first game's name), false: nowhere.\n186\t     */\n187\t    settings?: {\n188\t        button?: TouchCorner | boolean;\n189\t        key?: string | false;\n190\t    };\n191\t    /** On-screen joystick + buttons. Default: auto (coarse pointer), or ?touch=1 / ?touch=0. */\n192\t    touch?: boolean;\n193\t    /** On-screen action buttons. Default: the platformer's (DEFAULT_TOUCH_BUTTONS). */\n194\t    touchButtons?: readonly TouchButton[];\n195\t    /**\n196\t     * The touch top bar of the engine hotkeys (ⓘ debug panel, P, R, ◐ looks, ♪ mute), on a touch\n197\t     * screen while they are on (see `debugKeys`). Default true; false hides it even then, unless\n198\t     * the debug panel is on (`?debug=1`, dev builds).\n199\t     */\n200\t    touchBar?: boolean;\n201\t    background?: number;\n202\t}\n203\t/** `Engine.headless`: the page's options (those about the page do nothing), and where it runs. */\n204\texport interface HeadlessOptions extends EngineOptions {\n205\t    /**\n206\t     * The viewport the art resolution and framing come from, as a page's would (default 960×540 at\n207\t     * DPR 1). Pointer aim and HUD layout depend on it: a replay uses its recording's (`Recording.view`).\n208\t     */\n209\t    viewport?: Viewport;\n210\t    /** How models and packs are read: `nodeAssets()` (src/engine/node.ts) reads `public/`. */\n211\t    assets?: AssetReader;\n212\t}\n213\t/**\n214\t * Read engine options from the URL:\n215\t *   ?mode=raw  ?res=320  ?debug=1|0\n216\t *   ?aspect=fixed|adaptive  ?fps=30 (0 = uncapped)  ?quality=low|medium|high|auto\n217\t *   ?camera=iso|topdown|side|third|first|free|fixed  ?zoom=1.5\n218\t *   ?cam=<JSON CameraConfig>   (e.g. the config printed by the free camera)\n219\t *   ?filters=crt,lcd  or  ?look=handheld (a LOOK_PRESETS name, e.g. pixel_heroes)\n220\t */\n221\texport declare function optionsFromUrl(search?: string): Partial<EngineOptions>;\n222\t/**\n223\t * A game's own options with the review flags from the page URL (optionsFromUrl) on top:\n224\t * `Engine.start(game, withUrlOptions({ container, camera: { preset: 'side', zoom: 1.2 } }))`.\n225\t * The camera is merged key by key (`?zoom=1.5` keeps the game's `side` preset), and\n226\t * `?filters=` replaces the game's look (a look would win over filters otherwise).\n227\t */\n228\texport declare function withUrlOptions(options: EngineOptions, search?: string): EngineOptions;\n229\texport declare class Engine {\n230\t    readonly renderer: View;\n231\t    readonly physics: Physics;\n232\t    camera: CameraRig;\n233\t    readonly scene: Scene;\n234\t    /** The engine's version (package.json). */\n235\t    static readonly version: string;\n236\t    /**\n237\t     * Errors thrown by the game's hooks while the render loop ran, each message once, oldest\n238\t     * first (at most 20). They are logged to the console and shown in a box on screen; the\n239\t     * frame keeps rendering so the picture stays up. Fix the first one first. (`step()` throws\n240\t     * a hook's error to its caller instead: it is for tools.)\n241\t     */\n242\t    readonly errors: string[];\n243\t    readonly input: Input;\n244\t    readonly sun: DirectionalLight;\n245\t    readonly ambient: AmbientLight;\n246\t    readonly context: GameContext;\n247\t    readonly audio: AudioManager;\n248\t    readonly particles: Particles;\n249\t    readonly hud: Hud;\n250\t    /** Tweens on game time (`ctx.tweens`). */\n251\t    readonly tweens: Tweens;\n252\t    /**\n253\t     * Screen shake (trauma 0..1): `engine.shake.add(0.4)`. Added to the camera after the rig\n254\t     * placed it, on real time; ortho cameras move by whole art pixels. Reset on level unload.\n255\t     */\n256\t    readonly shake: CameraShake;\n257\t    /** Game time from real time: the speed and hitstops (`timeScale`, `hitstop()`). */\n258\t    private readonly clock;\n259\t    debug: DebugUI | null;\n260\t    touch: TouchControls | null;\n261\t    /**\n262\t     * The player's settings: look, pixel art, pixel size, quality, frame rate and debug info (plain\n263\t     * data, saved per game), applied over the game's own choices; `open()` shows them in the\n264\t     * settings panel (the ⚙ button, `EngineOptions.settings`). Sound is `audio`'s.\n265\t     */\n266\t    readonly settings: Settings;\n267\t    private settingsPanel;\n268\t    /** Whether the game was paused when the settings opened (they pause it, and give it back). */\n269\t    private pausedBeforeSettings;\n270\t    /** The dynamic light pool, created on first use of `ctx.lights` / `engine.lights`. */\n271\t    private _lights;\n272\t    /** Active engine hotkeys (from EngineOptions.debugKeys; none until the engine starts). */\n273\t    debugKeys: DebugKeyMap;\n274\t    private _game;\n275\t    private _paused;\n276\t    /** False while a game's setup() is running (start, loadGame): nothing advances. */\n277\t    private ready;\n278\t    /** True once the first start has finished: `step()` before it is a tool's race, and throws. */\n279\t    private started;\n280\t    private disposed;\n281\t    /** Incremented by every loadGame() and by dispose(): a load that is no longer the latest stops. */\n282\t    private loadToken;\n283\t    /** The load in flight (loads run one at a time), if any. */\n284\t    private loading;\n285\t    /** What a level may change and the next level starts from again (see unloadGame). */\n286\t    private defaults;\n287\t    /**\n288\t     * Tooling: the render loop stops driving the game; advance it yourself with `step()`.\n289\t     * Frame-exact and independent of how fast the browser renders (filmstrips, replays).\n290\t     */\n291\t    manual: boolean;\n292\t    frame: number;\n293\t    /** Rendered frames per second (measured over ~0.5 s). */\n294\t    fps: number;\n295\t    /** Requested quality (`auto` adapts); `quality` is the level in use. */\n296\t    readonly qualityOption: QualityOption;\n297\t    private _quality;\n298\t    /** The game's own camera config; switching back to its preset restores zoom, yaw etc. */\n299\t    private startCamera;\n300\t    time: number;\n301\t    private lastTime;\n302\t    private readonly limiter;\n303\t    private fpsFrames;\n304\t    private fpsSince;\n305\t    /** `auto` quality: one measurement window after start-up (ms timestamps), then done. */\n306\t    private autoQuality;\n307\t    /** The level `auto` gives: the device's, then what the measurement chose. */\n308\t    private autoLevel;\n309\t    private autoMeasured;\n310\t    private readonly sunDirection;\n311\t    private readonly sunRight;\n312\t    private readonly sunUp;\n313\t    private readonly sunFocus;\n314\t    private shadowRadius;\n315\t    /** Shadow depth-bias unit: one shadow texel in normalized light depth. */\n316\t    private readonly shadowTexelDepth;\n317\t    private readonly tmp;\n318\t    private readonly eye;\n319\t    private readonly cameraWorld;\n320\t    private readonly cameraUpdate;\n321\t    private constructor();\n322\t    /**\n323\t     * The page's renderer, for direct GPU work (readbacks, the canvas, compute): null headless\n324\t     * (`Engine.headless`), where nothing is drawn. Gameplay reads `renderer`, which both have.\n325\t     */\n326\t    get gpu(): PixelRenderer | null;\n327\t    /** The running game. Replace it with `loadGame()`. */\n328\t    get game(): Game;\n329\t    /**\n330\t     * Freeze simulation, animation, particles and game time (rendering continues). For\n331\t     * tooling, capture and pause menus. Queued key presses are dropped while paused.\n332\t     */\n333\t    get paused(): boolean;\n334\t    set paused(value: boolean);\n335\t    /**\n336\t     * The dynamic light pool (render/lights.ts), engine-owned: its lights stay in the scene\n337\t     * across levels, so loading another level never changes the light count (no recompiles).\n338\t     * Created on first use; sized by quality.\n339\t     */\n340\t    get lights(): LightPool;\n341\t    /**\n342\t     * Game speed: 1 normal, 0.25 slow motion, 2 double, 0 frozen (a menu: key presses made\n343\t     * meanwhile are dropped, like a pause). Scales game time, physics, animation, particles,\n344\t     * tweens and the camera follow; not transitions, shake or the render loop. Back to 1 when a\n345\t     * level unloads. Values that aren't numbers are ignored.\n346\t     */\n347\t    get timeScale(): number;\n348\t    set timeScale(v: number);\n349\t    /**\n350\t     * Freeze the game for `seconds` of real time: impact frames that sell a hit. Rendering,\n351\t     * screen shake and transitions keep going; overlapping hitstops keep the longest. Key\n352\t     * presses made during a hitstop still count afterwards (a buffered jump).\n353\t     */\n354\t    hitstop(seconds: number): void;\n355\t    /** Transitions, flashes and shockwaves (render/screenFx.ts): `await engine.screen.cover('iris')`. */\n356\t    get screen(): ScreenFx;\n357\t    /** The direction sunlight comes from (unit, pointing at the sun). */\n358\t    get sunDir(): Vector3;\n359\t    /**\n360\t     * Point the sun (and its shadows): a direction toward the sun, normalised here. A level's\n361\t     * time of day or a sun dial; reset to the engine default when the level unloads. Below the\n362\t     * horizon the sun is kept just above it (lower `sun.intensity` for night instead).\n363\t     */\n364\t    setSunDirection(dir: Vector3 | readonly [number, number, number]): void;\n365\t    /** The quality level in use (see `EngineOptions.quality`). */\n366\t    get quality(): QualityLevel;\n367\t    /**\n368\t     * Quality by option: a level, or `auto`: the device's level (low on phones and tablets, else\n369\t     * medium), lowered once if a few seconds of frames are slow (measured once, then remembered).\n370\t     */\n371\t    useQuality(option: QualityOption): void;\n372\t    /** Whether the debug panel is showing. */\n373\t    get debugShown(): boolean;\n374\t    /** Show or hide the debug panel (created the first time it shows, filled at once: the loop fills it only while the game runs). */\n375\t    showDebug(on: boolean): void;\n376\t    setQuality(level: QualityLevel): void;\n377\t    /** Frame cap of the render loop (0 = display rate). */\n378\t    get maxFps(): number;\n379\t    set maxFps(fps: number);\n380\t    static start(game: Game, options?: EngineOptions): Promise<Engine>;\n381\t    /**\n382\t     * The engine without a page (docs/engine/headless.md): the same boot, game code and frames as\n383\t     * `start`, with a `HeadlessView` that draws nothing, in Node. No DOM, no GPU, no listeners, no\n384\t     * AudioContext (`audio.counts` still counts), no panels; errors go to `engine.errors` and the\n385\t     * console. It runs in manual time from the start: advance it with `step()`, give it input with\n386\t     * `input.setKey` / `setPointer` / `send`, or `replay()` a recording. Models and packs are read\n387\t     * by `assets`, a reader of the game's own files (`(path) => Promise<ArrayBuffer>`; in this\n388\t     * engine's repository, `nodeAssets()`); the engine kit's built-in models need none.\n389\t     */\n390\t    static headless(game: Game, options?: HeadlessOptions): Promise<Engine>;\n391\t    /** The one boot sequence of `start` and `headless`: only the view and the page's parts differ. */\n392\t    private static boot;\n393\t    /** Debug panel, touch controls, then the render loop. */\n394\t    private finishStart;\n395\t    /**\n396\t     * Swap the camera preset mid-game (review tool: presets are a per-game choice). The\n397\t     * player, physics and the rest of the world are left exactly as they are. `free` and\n398\t     * `fixed` without an explicit position start from the view currently on screen.\n399\t     * Keeps `?camera=` in the URL in sync so a reload restores the preset; a game that swaps\n400\t     * presets as part of play (a side-scroller stage, a first-person hall, a photo mode) passes\n401\t     * `{ syncUrl: false }` so a reload still starts with its own camera.\n402\t     */\n403\t    setCamera(config: CameraConfig, options?: {\n404\t        syncUrl?: boolean;\n405\t    }): CameraRig;\n406\t    private wireRig;\n407\t    toggleMode(): RenderMode;\n408\t    toggleResolution(): Resolution;\n409\t    /** Every filter id the engine ships (see render/filters.ts). */\n410\t    get availableFilters(): readonly string[];\n411\t    get filters(): readonly string[];\n412\t    setFilters(ids: readonly string[]): void;\n413\t    /** The current look (a copy): per-layer pixel art and filters, whole-scene filters. */\n414\t    get look(): Look;\n415\t    /** Every named look (LOOK_PRESETS): `engine.setLook(engine.lookPresets.pixel_heroes)`. */\n416\t    get lookPresets(): Readonly<Record<string, Look>>;\n417\t    /** Apply a look (render/look.ts); `LOOK_PRESETS` has named ones. */\n418\t    setLook(look: Look): void;\n419\t    /** Cycle through LOOK_PRESETS ([ and ] keys). */\n420\t    cycleLook(step: 1 | -1): string;\n421\t    /** Snapshot for tests, tooling and agents. */\n422\t    state(): {\n423\t        version: string;\n424\t        game: string;\n425\t        seed: number;\n426\t        ready: boolean;\n427\t        paused: boolean;\n428\t        time: number;\n429\t        timeScale: number;\n430\t        hitstop: number;\n431\t        screen: import(\".\").ScreenFxState;\n432\t        backend: import(\".\").BackendName;\n433\t        mode: RenderMode;\n434\t        resolution: {\n435\t            width: number;\n436\t            height: number;\n437\t        };\n438\t        aspect: AspectMode;\n439\t        framing: {\n440\t            artWidth: number;\n441\t            artHeight: number;\n442\t            scale: number;\n443\t            integer: boolean;\n444\t            canvasWidth: number;\n445\t            canvasHeight: number;\n446\t            cssWidth: number;\n447\t            cssHeight: number;\n448\t            offsetX: number;\n449\t            offsetY: number;\n450\t        };\n451\t        frame: number;\n452\t        fps: number;\n453\t        maxFps: number;\n454\t        quality: QualityLevel;\n455\t        gpuRecoveries: number;\n456\t        physicsSteps: number;\n457\t        gpuErrors: {\n458\t            api: string;\n459\t            type: string;\n460\t            message: string;\n461\t        }[];\n462\t        /** Errors the game's hooks threw in the render loop (each once; also on screen). */\n463\t        errors: string[];\n464\t        target: import(\"three\").Vector3Tuple;\n465\t        camera: import(\"three\").Vector3Tuple;\n466\t        cameraRig: Record<string, unknown>;\n467\t        /** Visible world extents of an orthographic camera (what's in frame). */\n468\t        view: {\n469\t            left: number;\n470\t            right: number;\n471\t            top: number;\n472\t            bottom: number;\n473\t        } | null;\n474\t        filters: string[];\n475\t        /** The look preset in use, or `custom`; `split` when layers render as two passes. */\n476\t        look: string;\n477\t        split: boolean;\n478\t        status: string;\n479\t    };\n480\t    /**\n481\t     * Tooling: switch to manual time and advance `n` frames of `dt` seconds (simulation,\n482\t     * animation, camera). Nothing is drawn; call `renderer.capture()` to see the result.\n483\t     */\n484\t    step(n?: number, dt?: number): void;\n485\t    /**\n486\t     * One manual frame (`step()`), its input live or from a recorded frame (`replay()`). A game\n487\t     * hook's exception finishes the frame first, then is thrown to the caller of `step()`; in a\n488\t     * replay it is reported and the replay goes on, as in live play (`tick()`).\n489\t     */\n490\t    private frameStep;\n491\t    /** The end of every frame: input's per-frame state goes, and a marker notes when promise callbacks run. */\n492\t    private endFrame;\n493\t    /**\n494\t     * Unload the running game and start `game` in the same engine (renderer, canvas,\n495\t     * camera rig, input, audio context and debug UI stay).\n496\t     *\n497\t     * Safe to call from anywhere, including a game's own hooks (a level door in `update`,\n498\t     * `fixedUpdate` or a trigger's `onEnter`): the swap waits for the current frame to end.\n499\t     * Loads run one at a time, and only the latest one wins: a newer `loadGame()` (or\n500\t     * `dispose()`) makes an older one stop after its `setup()`, and the newer one unloads\n501\t     * whatever it built. The returned promise resolves when the level runs (or was superseded).\n502\t     *\n503\t     * Unloading calls the old game's `dispose(ctx)`, removes every scene object that is not\n504\t     * engine-owned and frees its GPU resources, clears physics (bodies, colliders, joints,\n505\t     * controllers, triggers, tags, movers, force fields, belts; gravity and the solver back to\n506\t     * their defaults), particles, HUD and music, and resets the scene background, fog and the\n507\t     * sun / ambient light to the engine defaults. Filters, render\n508\t     * mode, resolution, quality, volumes and the camera rig carry over; pass `camera` to\n509\t     * switch the preset (applied before `setup()`, so `ctx.camera` is already the new one).\n510\t     * Nothing advances while loading, and input made while loading is dropped (data sent with\n511\t     * `ctx.input.send` waits for the first frame that runs).\n512\t     */\n513\t    loadGame(game: Game, options?: {\n514\t        camera?: CameraConfig;\n515\t    }): Promise<void>;\n516\t    /**\n517\t     * Stop the loop and free everything: game, scene, physics, audio, input listeners, DOM,\n518\t     * GPU. With a `loadGame()` in flight, the world and GPU resources are freed once its\n519\t     * `setup()` has finished (it never runs against a freed physics world or renderer).\n520\t     */\n521\t    dispose(): void;\n522\t    /** Switch the camera preset for a level that is loading (no game hooks, no URL sync). */\n523\t    private useCamera;\n524\t    /** `Game.ready`: like any hook, an exception goes to `errors` and the screen; the game runs on. */\n525\t    private callReady;\n526\t    /** Start running the game: nothing pressed or timed while loading carries over. */\n527\t    private becomeReady;\n528\t    private readonly loop;\n529\t    /** The seed every level's `ctx.random` comes from (`EngineOptions.seed`, `?seed=`; a replay sets it). */\n530\t    get seed(): number;\n531\t    private _seed;\n532\t    private _random;\n533\t    /** The running level's recording (from its start), and whether a replay is driving the frames. */\n534\t    private rec;\n535\t    private replaying;\n536\t    private readonly recordLimit;\n537\t    /** Whether promise callbacks (microtasks) ran since the last frame ended (`InputFrame.sync`). */\n538\t    private drained;\n539\t    private readonly markDrained;\n540\t    /** This level's seeded randomness (`ctx.random`). */\n541\t    get random(): Rng;\n542\t    /** A fresh stream for `game`, before its setup: the same seed and game give the same numbers. */\n543\t    private reseed;\n544\t    /** Keep this frame's input in the level's recording (live play and `step()`, not replays). */\n545\t    private record;\n546\t    /**\n547\t     * The running level's recording: its seed, when it began and every frame's input since\n548\t     * (src/engine/replay.ts). Plain JSON: save it, attach it to a bug, replay it with `replay()`.\n549\t     */\n550\t    recording(): Recording | null;\n551\t    /**\n552\t     * Play a recording back: its seed and start time are restored, `start` loads the level it was\n553\t     * made in (e.g. `() => engine.loadGame(new MyGame())`; it must not wait on frames, so load\n554\t     * without a transition), then every frame runs with the recorded input, in manual time\n555\t     * (`step()`), waiting for promise callbacks wherever the recorded run did. `frames` stops\n556\t     * early. Afterwards the level is where the recorded one was (`fingerprint()` matches if the\n557\t     * game is deterministic) and stays in manual time: `step()` plays on from there, live, and\n558\t     * the level's recording carries on from it. Live input is ignored during a replay, from the\n559\t     * moment `start` runs (`input.playing`: a game's setup can tell); afterwards nothing the\n560\t     * recording held stays held. A game hook's exception is reported and the replay\n561\t     * goes on, as in live play.\n562\t     */\n563\t    replay(rec: Recording, start: () => unknown, o?: {\n564\t        frames?: number;\n565\t    }): Promise<void>;\n566\t    /**\n567\t     * The running level as data, between frames (docs/engine/determinism.md *Save-states*): game time, the\n568\t     * clock, `ctx.random`, the physics world, the camera, the shake, input still waiting, and the\n569\t     * game's own state (`Game.snapshot`). Plain JSON. Taken once the last frame's promise\n570\t     * callbacks have run (it waits a task, as a replay does between frames). Throws when the game\n571\t     * has no `snapshot` / `restore`, while a tween runs (its callbacks are code), or with physics\n572\t     * that lives outside the Rapier world (`Physics.state`).\n573\t     */\n574\t    snapshot(): Promise<Snapshot>;\n575\t    /**\n576\t     * Put the running level back to a snapshot of it: the same game (by name), already loaded;\n577\t     * nothing in between is replayed. The level's recording starts again from it (`Recording.from`),\n578\t     * so what is played next replays with `replay()`. Live input held now is let go.\n579\t     */\n580\t    restore(saved: Snapshot): Promise<void>;\n581\t    /** A task boundary: promise callbacks queued so far (and chains of them) have run when it resolves. */\n582\t    private task;\n583\t    /**\n584\t     * A hash of the simulation: game time, every physics body (exact), `ctx.random`'s state and\n585\t     * the game's own (`Game.fingerprint`). Two runs that should be the same (a replay) compare equal. Not the `status()` line: a\n586\t     * debug line may carry measurements (a step's milliseconds) that differ run to run.\n587\t     */\n588\t    fingerprint(): string;\n589\t    private unloadGame;\n590\t    private tick;\n591\t    /** A game hook threw in the render loop: log it (once per message) and show it on screen. */\n592\t    private reportError;\n593\t    private handleDebugKeys;\n594\t    /** Rendered-fps counter, and the one-shot `auto` quality check a few seconds in. */\n595\t    private measure;\n596\t    /**\n597\t     * One frame of simulation, game logic, camera and light (no drawing). `dt` is game time\n598\t     * (scaled, 0 in a hitstop); `realDt` drives the screen shake.\n599\t     */\n600\t    private advance;\n601\t    /** How far from the camera focus a light can matter: half the view diagonal. */\n602\t    private lightRange;\n603\t    /** Camera follow + shadow box for the current game state. */\n604\t    private updateView;\n605\t    private readonly fixedStep;\n606\t    /**\n607\t     * Fit the sun's shadow box to what the camera sees: ortho presets cover the visible\n608\t     * ground (so zooming out keeps shadows), perspective presets cover a box reaching ahead\n609\t     * of the camera. The box moves in whole shadow texels so shadow edges don't crawl while\n610\t     * the camera follows the player.\n611\t     */\n612\t    private updateShadow;\n613\t}\n614\t"}]},"parent_tool_use_id":null,"session_id":"8b716b92-81c2-4c62-8381-9131b2f861f1","uuid":"9d8bd97a-0a5d-41ce-81c4-e2ccc14b935d","timestamp":"2026-11-05T04:20:27.352Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211914__x044929/work/_research/engine/pixel-engine/types/engine/Engine.d.ts","content":"import { AmbientLight, DirectionalLight, Scene, Vector3 } from 'three/webgpu';\nimport { type AssetReader, loadModel } from './assets';\nimport { AudioManager } from './audio/AudioManager';\nimport { type CameraConfig, type CameraRig } from './camera';\nimport { DebugUI } from './DebugUI';\nimport { type DebugKeyMap, type DebugKeysOption } from './debugKeys';\nimport { type AspectMode, type Resolution, type Viewport } from './framing';\nimport { Hud } from './hud/Hud';\nimport { Input } from './input';\nimport { Particles } from './particles/Particles';\nimport { type TouchButton, TouchControls, type TouchCorner } from './TouchControls';\nimport { Settings } from './settings';\nimport { PALETTE } from './palette';\nimport { Physics } from './physics/Physics';\nimport { type QualityLevel, type QualityOption } from './quality';\nimport { type Look } from './render/look';\nimport { LightPool } from './render/lights';\nimport { type EdgeSettings, PixelRenderer, type RenderMode } from './render/PixelRenderer';\nimport type { View } from './render/view';\nimport { Rng } from './random';\nimport { type Recording } from './replay';\nimport { CameraShake } from './shake';\nimport { type Snapshot } from './snapshot';\nimport { Tweens } from './tween';\nimport type { ScreenFx } from './render/screenFx';\nexport interface GameContext {\n    readonly engine: Engine;\n    readonly scene: Scene;\n    readonly physics: Physics;\n    readonly input: Input;\n    readonly camera: CameraRig;\n    readonly loadModel: typeof loadModel;\n    readonly palette: typeof PALETTE;\n    /** Game time in seconds since start. Frozen while paused or loading. */\n    readonly time: number;\n    /**\n     * This level's seeded randomness (src/engine/random.ts): the same engine seed and game give\n     * the same numbers. Use it (or forks of it) for everything random; never Math.random.\n     */\n    readonly random: Rng;\n    /** Sound effects, music, volumes (src/engine/audio). */\n    readonly audio: AudioManager;\n    /** Pixel particles: `particles.burst('dust', at)` (src/engine/particles). */\n    readonly particles: Particles;\n    /** Pixel HUD text and icons in art pixels (src/engine/hud). */\n    readonly hud: Hud;\n    /**\n     * Dynamic point lights: `lights.request({ position, color, intensity, radius, flicker })`\n     * (src/engine/render/lights.ts). A fixed pool sized by quality, created on first use.\n     */\n    readonly lights: LightPool;\n    /**\n     * Tweens on game time: `tweens.to(door.position, { y: 3 }, { duration: 0.8, ease: 'outBack' })`\n     * (src/engine/tween.ts). Cleared when the level unloads.\n     */\n    readonly tweens: Tweens;\n}\n/**\n * A game is a plain object. The engine owns rendering, physics stepping, camera,\n * lighting and debug UI; the game only builds its world and reacts to input.\n */\nexport interface Game {\n    readonly name: string;\n    /**\n     * The plain JSON the game was made with, when its name alone can't rebuild it (a lab's depth\n     * and seed, the door a room was entered by): kept in its recordings (`Recording.args`), so a\n     * tool can make the same game again to replay one (`npm run replay`, src/games.ts).\n     */\n    readonly args?: unknown;\n    /**\n     * Models `setup` will load (`ctx.loadModel` URLs). Optional: listing them lets the\n     * engine start downloading while the renderer and physics initialise.\n     */\n    readonly assets?: readonly string[];\n    /** Build the level: load models, add colliders, spawn entities. */\n    setup(ctx: GameContext): Promise<void> | void;\n    /** Runs before every fixed 60 Hz physics step. Move characters/apply forces here. */\n    fixedUpdate?(ctx: GameContext, dt: number): void;\n    /**\n     * Runs when the engine starts running this game: after `Engine.start` (just before\n     * `__PIXEL_READY__` resolves) and after each `loadGame`. Install page handles for tools here\n     * (`window.__MYGAME__`), so they never exist before the engine can step. An exception is\n     * reported like any hook's (`engine.errors`, on screen); the game runs on.\n     */\n    ready?(ctx: GameContext): void;\n    /** Runs once per rendered frame after physics (animation, pickups, UI state). */\n    update?(ctx: GameContext, dt: number): void;\n    /** World position the camera follows. */\n    cameraTarget(ctx: GameContext): Vector3;\n    /** First-person eye position (defaults to cameraTarget + 0.7 up). */\n    eyePosition?(ctx: GameContext): Vector3;\n    /** One-line status for the debug UI (score, lives...). */\n    status?(ctx: GameContext): string;\n    /**\n     * The game's own state as a short string or hash, for `engine.fingerprint()`: what lives\n     * outside physics and `ctx.random` (positions, life, counters, the game's own random\n     * streams), so two runs that should match (a replay) can be compared. Only what a replay must\n     * reproduce: no timings or measurements.\n     */\n    fingerprint?(ctx: GameContext): string;\n    /**\n     * The game's own state as plain data, between frames (`engine.snapshot()`): everything a\n     * later frame reads that the engine does not keep (its entities, timers, random streams; the\n     * handles of its physics bodies). With `restore`, the game has save-states.\n     */\n    snapshot?(ctx: GameContext): unknown;\n    /**\n     * Put the game back to what `snapshot` returned (`engine.restore()`): the same game, already\n     * set up. Find physics bodies again by handle (`ctx.physics.world.getRigidBody(h)`).\n     */\n    restore?(ctx: GameContext, state: unknown): void | Promise<void>;\n    /**\n     * Optional: leave whatever mode the game is in before a restore changes anything (a mode\n     * with a camera of its own, a dialog, a level): `engine.restore()` calls it first, then checks\n     * the snapshot fits (the camera preset) and puts the engine's part back, then `restore`.\n     */\n    beforeRestore?(ctx: GameContext): void | Promise<void>;\n    /**\n     * Called after `engine.setCamera()` swapped the camera preset mid-game. The world,\n     * physics and player are untouched; adjust anything that depends on the preset\n     * (e.g. side-scroller lane lock, hiding the player model in first person).\n     */\n    onCameraChange?(ctx: GameContext): void;\n    /**\n     * Called when the game is unloaded (`engine.loadGame(other)` or `engine.dispose()`),\n     * before the engine removes its scene objects, physics bodies, triggers, particles, HUD\n     * and music. Free anything else the game owns: DOM, timers, listeners, HMR hooks.\n     */\n    dispose?(ctx: GameContext): void;\n}\nexport interface EngineOptions {\n    container?: HTMLElement;\n    resolution?: Resolution;\n    /**\n     * `adaptive` (default): the art height stays `resolution.height` and the art width\n     * follows the screen's aspect (portrait phones fill the screen). `fixed`: always exactly\n     * `resolution`, letterboxed. `fill`: adjusts both art dimensions to cover the viewport\n     * at an integer scale, without black borders or stretched pixels.\n     */\n    aspect?: AspectMode;\n    /**\n     * Cap the render loop (simulation keeps its fixed 60 Hz physics step). Default 60, so\n     * 120 Hz phones don't run the whole pipeline twice per game frame. 0 = display rate.\n     */\n    maxFps?: number;\n    /** Shadow map quality, or `auto` (default: low on touch devices, else medium; lowered once on a slow start). */\n    quality?: QualityOption;\n    /** Pixel-styled loading indicator while the renderer, physics and assets load. Default true. */\n    loadingScreen?: boolean;\n    mode?: RenderMode;\n    edges?: EdgeSettings;\n    /** Camera preset + parameters. Pick one per game; not meant to change during play. */\n    camera?: CameraConfig;\n    /** Post filters (ids from FILTERS) applied in Pixel mode, in order. */\n    filters?: readonly string[];\n    /**\n     * A full look: pixel art or clean rendering and filters per layer (characters & objects,\n     * environment) plus whole-scene filters (render/look.ts). Wins over `filters` and `edges`.\n     */\n    look?: Look;\n    /**\n     * Seed for `ctx.random`: each level gets its own stream from this and the game's name, so\n     * the same seed replays the same game. Default 1. `?seed=` in the URL.\n     */\n    seed?: number;\n    /**\n     * Frames of input the engine keeps for each level (`recording()`). Default `MAX_FRAMES`, an\n     * hour at 60 fps (up to some 20 MB of JSON with the mouse moving all the time); 0 records nothing.\n     */\n    record?: number;\n    /** Debug panel. Default: on in dev (`vite`) or with ?debug=1, off in production builds. */\n    debugUI?: boolean;\n    /**\n     * Engine hotkeys (P Pixel/Raw, R resolution, ` debug panel, [ ] looks, M mute): developer\n     * tools. Default: on with the debug panel (dev, ?debug=1), off in a shipped game, whose players\n     * have the same options in the settings. `true` / `false`: always on / off; an object rebinds\n     * or disables (null) single actions, and they still come with the debug panel.\n     */\n    debugKeys?: DebugKeysOption;\n    /**\n     * The player's settings (`engine.settings`): look, pixel art, pixel size, quality, frame rate,\n     * sound and debug info, in a panel the ⚙ button opens. `button`: its corner (default, or true:\n     * 'top-right'; on a mouse it shows while the pointer moves), or false for none: open the\n     * panel from your own menu (`engine.settings.open()`). `key`: where they are saved\n     * (localStorage `pixel-engine:settings:<key>`; default the first game's name), false: nowhere.\n     */\n    settings?: {\n        button?: TouchCorner | boolean;\n        key?: string | false;\n    };\n    /** On-screen joystick + buttons. Default: auto (coarse pointer), or ?touch=1 / ?touch=0. */\n    touch?: boolean;\n    /** On-screen action buttons. Default: the platformer's (DEFAULT_TOUCH_BUTTONS). */\n    touchButtons?: readonly TouchButton[];\n    /**\n     * The touch top bar of the engine hotkeys (ⓘ debug panel, P, R, ◐ looks, ♪ mute), on a touch\n     * screen while they are on (see `debugKeys`). Default true; false hides it even then, unless\n     * the debug panel is on (`?debug=1`, dev builds).\n     */\n    touchBar?: boolean;\n    background?: number;\n}\n/** `Engine.headless`: the page's options (those about the page do nothing), and where it runs. */\nexport interface HeadlessOptions extends EngineOptions {\n    /**\n     * The viewport the art resolution and framing come from, as a page's would (default 960×540 at\n     * DPR 1). Pointer aim and HUD layout depend on it: a replay uses its recording's (`Recording.view`).\n     */\n    viewport?: Viewport;\n    /** How models and packs are read: `nodeAssets()` (src/engine/node.ts) reads `public/`. */\n    assets?: AssetReader;\n}\n/**\n * Read engine options from the URL:\n *   ?mode=raw  ?res=320  ?debug=1|0\n *   ?aspect=fixed|adaptive  ?fps=30 (0 = uncapped)  ?quality=low|medium|high|auto\n *   ?camera=iso|topdown|side|third|first|free|fixed  ?zoom=1.5\n *   ?cam=<JSON CameraConfig>   (e.g. the config printed by the free camera)\n *   ?filters=crt,lcd  or  ?look=handheld (a LOOK_PRESETS name, e.g. pixel_heroes)\n */\nexport declare function optionsFromUrl(search?: string): Partial<EngineOptions>;\n/**\n * A game's own options with the review flags from the page URL (optionsFromUrl) on top:\n * `Engine.start(game, withUrlOptions({ container, camera: { preset: 'side', zoom: 1.2 } }))`.\n * The camera is merged key by key (`?zoom=1.5` keeps the game's `side` preset), and\n * `?filters=` replaces the game's look (a look would win over filters otherwise).\n */\nexport declare function withUrlOptions(options: EngineOptions, search?: string): EngineOptions;\nexport declare class Engine {\n    readonly renderer: View;\n    readonly physics: Physics;\n    camera: CameraRig;\n    readonly scene: Scene;\n    /** The engine's version (package.json). */\n    static readonly version: string;\n    /**\n     * Errors thrown by the game's hooks while the render loop ran, each message once, oldest\n     * first (at most 20). They are logged to the console and shown in a box on screen; the\n     * frame keeps rendering so the picture stays up. Fix the first one first. (`step()` throws\n     * a hook's error to its caller instead: it is for tools.)\n     */\n    readonly errors: string[];\n    readonly input: Input;\n    readonly sun: DirectionalLight;\n    readonly ambient: AmbientLight;\n    readonly context: GameContext;\n    readonly audio: AudioManager;\n    readonly particles: Particles;\n    readonly hud: Hud;\n    /** Tweens on game time (`ctx.tweens`). */\n    readonly tweens: Tweens;\n    /**\n     * Screen shake (trauma 0..1): `engine.shake.add(0.4)`. Added to the camera after the rig\n     * placed it, on real time; ortho cameras move by whole art pixels. Reset on level unload.\n     */\n    readonly shake: CameraShake;\n    /** Game time from real time: the speed and hitstops (`timeScale`, `hitstop()`). */\n    private readonly clock;\n    debug: DebugUI | null;\n    touch: TouchControls | null;\n    /**\n     * The player's settings: look, pixel art, pixel size, quality, frame rate and debug info (plain\n     * data, saved per game), applied over the game's own choices; `open()` shows them in the\n     * settings panel (the ⚙ button, `EngineOptions.settings`). Sound is `audio`'s.\n     */\n    readonly settings: Settings;\n    private settingsPanel;\n    /** Whether the game was paused when the settings opened (they pause it, and give it back). */\n    private pausedBeforeSettings;\n    /** The dynamic light pool, created on first use of `ctx.lights` / `engine.lights`. */\n    private _lights;\n    /** Active engine hotkeys (from EngineOptions.debugKeys; none until the engine starts). */\n    debugKeys: DebugKeyMap;\n    private _game;\n    private _paused;\n    /** False while a game's setup() is running (start, loadGame): nothing advances. */\n    private ready;\n    /** True once the first start has finished: `step()` before it is a tool's race, and throws. */\n    private started;\n    private disposed;\n    /** Incremented by every loadGame() and by dispose(): a load that is no longer the latest stops. */\n    private loadToken;\n    /** The load in flight (loads run one at a time), if any. */\n    private loading;\n    /** What a level may change and the next level starts from again (see unloadGame). */\n    private defaults;\n    /**\n     * Tooling: the render loop stops driving the game; advance it yourself with `step()`.\n     * Frame-exact and independent of how fast the browser renders (filmstrips, replays).\n     */\n    manual: boolean;\n    frame: number;\n    /** Rendered frames per second (measured over ~0.5 s). */\n    fps: number;\n    /** Requested quality (`auto` adapts); `quality` is the level in use. */\n    readonly qualityOption: QualityOption;\n    private _quality;\n    /** The game's own camera config; switching back to its preset restores zoom, yaw etc. */\n    private startCamera;\n    time: number;\n    private lastTime;\n    private readonly limiter;\n    private fpsFrames;\n    private fpsSince;\n    /** `auto` quality: one measurement window after start-up (ms timestamps), then done. */\n    private autoQuality;\n    /** The level `auto` gives: the device's, then what the measurement chose. */\n    private autoLevel;\n    private autoMeasured;\n    private readonly sunDirection;\n    private readonly sunRight;\n    private readonly sunUp;\n    private readonly sunFocus;\n    private shadowRadius;\n    /** Shadow depth-bias unit: one shadow texel in normalized light depth. */\n    private readonly shadowTexelDepth;\n    private readonly tmp;\n    private readonly eye;\n    private readonly cameraWorld;\n    private readonly cameraUpdate;\n    private constructor();\n    /**\n     * The page's renderer, for direct GPU work (readbacks, the canvas, compute): null headless\n     * (`Engine.headless`), where nothing is drawn. Gameplay reads `renderer`, which both have.\n     */\n    get gpu(): PixelRenderer | null;\n    /** The running game. Replace it with `loadGame()`. */\n    get game(): Game;\n    /**\n     * Freeze simulation, animation, particles and game time (rendering continues). For\n     * tooling, capture and pause menus. Queued key presses are dropped while paused.\n     */\n    get paused(): boolean;\n    set paused(value: boolean);\n    /**\n     * The dynamic light pool (render/lights.ts), engine-owned: its lights stay in the scene\n     * across levels, so loading another level never changes the light count (no recompiles).\n     * Created on first use; sized by quality.\n     */\n    get lights(): LightPool;\n    /**\n     * Game speed: 1 normal, 0.25 slow motion, 2 double, 0 frozen (a menu: key presses made\n     * meanwhile are dropped, like a pause). Scales game time, physics, animation, particles,\n     * tweens and the camera follow; not transitions, shake or the render loop. Back to 1 when a\n     * level unloads. Values that aren't numbers are ignored.\n     */\n    get timeScale(): number;\n    set timeScale(v: number);\n    /**\n     * Freeze the game for `seconds` of real time: impact frames that sell a hit. Rendering,\n     * screen shake and transitions keep going; overlapping hitstops keep the longest. Key\n     * presses made during a hitstop still count afterwards (a buffered jump).\n     */\n    hitstop(seconds: number): void;\n    /** Transitions, flashes and shockwaves (render/screenFx.ts): `await engine.screen.cover('iris')`. */\n    get screen(): ScreenFx;\n    /** The direction sunlight comes from (unit, pointing at the sun). */\n    get sunDir(): Vector3;\n    /**\n     * Point the sun (and its shadows): a direction toward the sun, normalised here. A level's\n     * time of day or a sun dial; reset to the engine default when the level unloads. Below the\n     * horizon the sun is kept just above it (lower `sun.intensity` for night instead).\n     */\n    setSunDirection(dir: Vector3 | readonly [number, number, number]): void;\n    /** The quality level in use (see `EngineOptions.quality`). */\n    get quality(): QualityLevel;\n    /**\n     * Quality by option: a level, or `auto`: the device's level (low on phones and tablets, else\n     * medium), lowered once if a few seconds of frames are slow (measured once, then remembered).\n     */\n    useQuality(option: QualityOption): void;\n    /** Whether the debug panel is showing. */\n    get debugShown(): boolean;\n    /** Show or hide the debug panel (created the first time it shows, filled at once: the loop fills it only while the game runs). */\n    showDebug(on: boolean): void;\n    setQuality(level: QualityLevel): void;\n    /** Frame cap of the render loop (0 = display rate). */\n    get maxFps(): number;\n    set maxFps(fps: number);\n    static start(game: Game, options?: EngineOptions): Promise<Engine>;\n    /**\n     * The engine without a page (docs/engine/headless.md): the same boot, game code and frames as\n     * `start`, with a `HeadlessView` that draws nothing, in Node. No DOM, no GPU, no listeners, no\n     * AudioContext (`audio.counts` still counts), no panels; errors go to `engine.errors` and the\n     * console. It runs in manual time from the start: advance it with `step()`, give it input with\n     * `input.setKey` / `setPointer` / `send`, or `replay()` a recording. Models and packs are read\n     * by `assets`, a reader of the game's own files (`(path) => Promise<ArrayBuffer>`; in this\n     * engine's repository, `nodeAssets()`); the engine kit's built-in models need none.\n     */\n    static headless(game: Game, options?: HeadlessOptions): Promise<Engine>;\n    /** The one boot sequence of `start` and `headless`: only the view and the page's parts differ. */\n    private static boot;\n    /** Debug panel, touch controls, then the render loop. */\n    private finishStart;\n    /**\n     * Swap the camera preset mid-game (review tool: presets are a per-game choice). The\n     * player, physics and the rest of the world are left exactly as they are. `free` and\n     * `fixed` without an explicit position start from the view currently on screen.\n     * Keeps `?camera=` in the URL in sync so a reload restores the preset; a game that swaps\n     * presets as part of play (a side-scroller stage, a first-person hall, a photo mode) passes\n     * `{ syncUrl: false }` so a reload still starts with its own camera.\n     */\n    setCamera(config: CameraConfig, options?: {\n        syncUrl?: boolean;\n    }): CameraRig;\n    private wireRig;\n    toggleMode(): RenderMode;\n    toggleResolution(): Resolution;\n    /** Every filter id the engine ships (see render/filters.ts). */\n    get availableFilters(): readonly string[];\n    get filters(): readonly string[];\n    setFilters(ids: readonly string[]): void;\n    /** The current look (a copy): per-layer pixel art and filters, whole-scene filters. */\n    get look(): Look;\n    /** Every named look (LOOK_PRESETS): `engine.setLook(engine.lookPresets.pixel_heroes)`. */\n    get lookPresets(): Readonly<Record<string, Look>>;\n    /** Apply a look (render/look.ts); `LOOK_PRESETS` has named ones. */\n    setLook(look: Look): void;\n    /** Cycle through LOOK_PRESETS ([ and ] keys). */\n    cycleLook(step: 1 | -1): string;\n    /** Snapshot for tests, tooling and agents. */\n    state(): {\n        version: string;\n        game: string;\n        seed: number;\n        ready: boolean;\n        paused: boolean;\n        time: number;\n        timeScale: number;\n        hitstop: number;\n        screen: import(\".\").ScreenFxState;\n        backend: import(\".\").BackendName;\n        mode: RenderMode;\n        resolution: {\n            width: number;\n            height: number;\n        };\n        aspect: AspectMode;\n        framing: {\n            artWidth: number;\n            artHeight: number;\n            scale: number;\n            integer: boolean;\n            canvasWidth: number;\n            canvasHeight: number;\n            cssWidth: number;\n            cssHeight: number;\n            offsetX: number;\n            offsetY: number;\n        };\n        frame: number;\n        fps: number;\n        maxFps: number;\n        quality: QualityLevel;\n        gpuRecoveries: number;\n        physicsSteps: number;\n        gpuErrors: {\n            api: string;\n            type: string;\n            message: string;\n        }[];\n        /** Errors the game's hooks threw in the render loop (each once; also on screen). */\n        errors: string[];\n        target: import(\"three\").Vector3Tuple;\n        camera: import(\"three\").Vector3Tuple;\n        cameraRig: Record<string, unknown>;\n        /** Visible world extents of an orthographic camera (what's in frame). */\n        view: {\n            left: number;\n            right: number;\n            top: number;\n            bottom: number;\n        } | null;\n        filters: string[];\n        /** The look preset in use, or `custom`; `split` when layers render as two passes. */\n        look: string;\n        split: boolean;\n        status: string;\n    };\n    /**\n     * Tooling: switch to manual time and advance `n` frames of `dt` seconds (simulation,\n     * animation, camera). Nothing is drawn; call `renderer.capture()` to see the result.\n     */\n    step(n?: number, dt?: number): void;\n    /**\n     * One manual frame (`step()`), its input live or from a recorded frame (`replay()`). A game\n     * hook's exception finishes the frame first, then is thrown to the caller of `step()`; in a\n     * replay it is reported and the replay goes on, as in live play (`tick()`).\n     */\n    private frameStep;\n    /** The end of every frame: input's per-frame state goes, and a marker notes when promise callbacks run. */\n    private endFrame;\n    /**\n     * Unload the running game and start `game` in the same engine (renderer, canvas,\n     * camera rig, input, audio context and debug UI stay).\n     *\n     * Safe to call from anywhere, including a game's own hooks (a level door in `update`,\n     * `fixedUpdate` or a trigger's `onEnter`): the swap waits for the current frame to end.\n     * Loads run one at a time, and only the latest one wins: a newer `loadGame()` (or\n     * `dispose()`) makes an older one stop after its `setup()`, and the newer one unloads\n     * whatever it built. The returned promise resolves when the level runs (or was superseded).\n     *\n     * Unloading calls the old game's `dispose(ctx)`, removes every scene object that is not\n     * engine-owned and frees its GPU resources, clears physics (bodies, colliders, joints,\n     * controllers, triggers, tags, movers, force fields, belts; gravity and the solver back to\n     * their defaults), particles, HUD and music, and resets the scene background, fog and the\n     * sun / ambient light to the engine defaults. Filters, render\n     * mode, resolution, quality, volumes and the camera rig carry over; pass `camera` to\n     * switch the preset (applied before `setup()`, so `ctx.camera` is already the new one).\n     * Nothing advances while loading, and input made while loading is dropped (data sent with\n     * `ctx.input.send` waits for the first frame that runs).\n     */\n    loadGame(game: Game, options?: {\n        camera?: CameraConfig;\n    }): Promise<void>;\n    /**\n     * Stop the loop and free everything: game, scene, physics, audio, input listeners, DOM,\n     * GPU. With a `loadGame()` in flight, the world and GPU resources are freed once its\n     * `setup()` has finished (it never runs against a freed physics world or renderer).\n     */\n    dispose(): void;\n    /** Switch the camera preset for a level that is loading (no game hooks, no URL sync). */\n    private useCamera;\n    /** `Game.ready`: like any hook, an exception goes to `errors` and the screen; the game runs on. */\n    private callReady;\n    /** Start running the game: nothing pressed or timed while loading carries over. */\n    private becomeReady;\n    private readonly loop;\n    /** The seed every level's `ctx.random` comes from (`EngineOptions.seed`, `?seed=`; a replay sets it). */\n    get seed(): number;\n    private _seed;\n    private _random;\n    /** The running level's recording (from its start), and whether a replay is driving the frames. */\n    private rec;\n    private replaying;\n    private readonly recordLimit;\n    /** Whether promise callbacks (microtasks) ran since the last frame ended (`InputFrame.sync`). */\n    private drained;\n    private readonly markDrained;\n    /** This level's seeded randomness (`ctx.random`). */\n    get random(): Rng;\n    /** A fresh stream for `game`, before its setup: the same seed and game give the same numbers. */\n    private reseed;\n    /** Keep this frame's input in the level's recording (live play and `step()`, not replays). */\n    private record;\n    /**\n     * The running level's recording: its seed, when it began and every frame's input since\n     * (src/engine/replay.ts). Plain JSON: save it, attach it to a bug, replay it with `replay()`.\n     */\n    recording(): Recording | null;\n    /**\n     * Play a recording back: its seed and start time are restored, `start` loads the level it was\n     * made in (e.g. `() => engine.loadGame(new MyGame())`; it must not wait on frames, so load\n     * without a transition), then every frame runs with the recorded input, in manual time\n     * (`step()`), waiting for promise callbacks wherever the recorded run did. `frames` stops\n     * early. Afterwards the level is where the recorded one was (`fingerprint()` matches if the\n     * game is deterministic) and stays in manual time: `step()` plays on from there, live, and\n     * the level's recording carries on from it. Live input is ignored during a replay, from the\n     * moment `start` runs (`input.playing`: a game's setup can tell); afterwards nothing the\n     * recording held stays held. A game hook's exception is reported and the replay\n     * goes on, as in live play.\n     */\n    replay(rec: Recording, start: () => unknown, o?: {\n        frames?: number;\n    }): Promise<void>;\n    /**\n     * The running level as data, between frames (docs/engine/determinism.md *Save-states*): game time, the\n     * clock, `ctx.random`, the physics world, the camera, the shake, input still waiting, and the\n     * game's own state (`Game.snapshot`). Plain JSON. Taken once the last frame's promise\n     * callbacks have run (it waits a task, as a replay does between frames). Throws when the game\n     * has no `snapshot` / `restore`, while a tween runs (its callbacks are code), or with physics\n     * that lives outside the Rapier world (`Physics.state`).\n     */\n    snapshot(): Promise<Snapshot>;\n    /**\n     * Put the running level back to a snapshot of it: the same game (by name), already loaded;\n     * nothing in between is replayed. The level's recording starts again from it (`Recording.from`),\n     * so what is played next replays with `replay()`. Live input held now is let go.\n     */\n    restore(saved: Snapshot): Promise<void>;\n    /** A task boundary: promise callbacks queued so far (and chains of them) have run when it resolves. */\n    private task;\n    /**\n     * A hash of the simulation: game time, every physics body (exact), `ctx.random`'s state and\n     * the game's own (`Game.fingerprint`). Two runs that should be the same (a replay) compare equal. Not the `status()` line: a\n     * debug line may carry measurements (a step's milliseconds) that differ run to run.\n     */\n    fingerprint(): string;\n    private unloadGame;\n    private tick;\n    /** A game hook threw in the render loop: log it (once per message) and show it on screen. */\n    private reportError;\n    private handleDebugKeys;\n    /** Rendered-fps counter, and the one-shot `auto` quality check a few seconds in. */\n    private measure;\n    /**\n     * One frame of simulation, game logic, camera and light (no drawing). `dt` is game time\n     * (scaled, 0 in a hitstop); `realDt` drives the screen shake.\n     */\n    private advance;\n    /** How far from the camera focus a light can matter: half the view diagonal. */\n    private lightRange;\n    /** Camera follow + shadow box for the current game state. */\n    private updateView;\n    private readonly fixedStep;\n    /**\n     * Fit the sun's shadow box to what the camera sees: ortho presets cover the visible\n     * ground (so zooming out keeps shadows), perspective presets cover a box reaching ahead\n     * of the camera. The box moves in whole shadow texels so shadow edges don't crawl while\n     * the camera follows the player.\n     */\n    private updateShadow;\n}\n","numLines":614,"startLine":1,"totalLines":614}},"tool_result_meta":[{"id":"toolu_011RxrWc8SFwiR3DWJdbTp8n","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
