r = '#5ff0e0';\\n  story.talk.color = '#e8fbf6';\\n230→  story.talk.nameColor = '#5ff0e0';\\n\\n  function beginCase(id, opts) {\\n    opts = opts || {};\\n    let def = GAME.CASES[id];\\n    if (id === 'ferry' || (def && def.id === 'ferry')) def = GAME.roundsCase(opts.players || 1);\\n    if (!def) return null;\\n    RT.def = def;\\n    RT.mode = opts.mode || def.mode || 'case';\\n    if (opts.fromStory != null) RT.fromStory = opts.fromStory;\\n240→    const S = GAME.Op.create(def, {\\n      seed: opts.seed == null ? 3 : opts.seed,\\n      difficulty: opts.difficulty || RT.diff || 'resident',\\n      players: opts.players || 1,\\n      phase: opts.phase || 0,\\n    });\\n    if (opts.clockDelta) S.clock += opts.clockDelta;\\n    if (opts.steadyDelta) S.steady += opts.steadyDelta;\\n    if (opts.cheat) S.cheat = Object.assign({}, S.cheat, opts.cheat);\\n    RT.S = S;\\n250→    RT.leftOp = false;\\n    RT.fieldKey = '';\\n    return S;\\n  }\\n  GAME.beginCase = beginCase;\\n\\n  function recordRank() {\\n    const S = RT.S;\\n    if (!S || !S.won || RT.attract || RT.cheatUsed || GAME.TUNE.dirty) return;\\n    if (S.lab || S.mode === 'rounds' || S.id === 'lab' || S.id === 'ferry') return;\\n260→    const ch = S.cheat || {};\\n    if (ch.reveal || ch.infSteady || ch.lockVitals || ch.freezeClock || ch.oneHit) return;\\n    RT.ranks[S.id] = S.rank;\\n    RT.cleared[S.id] = true;\\n    if (PERSON[S.id]) RT.saved[PERSON[S.id]] = true;\\n    const def = GAME.CASES[S.id];\\n    if (def && def.chapter) RT.chapter = def.chapter;\\n  }\\n\\n  function resumeHeld() {\\n270→    if (!(RT.fromStory && story._held)) return false;\\n    RT.redirect = false;\\n    story.resume();\\n    if (!RT.redirect) go('story');\\n    return true;\\n  }\\n\\n  function leaveResults() {\\n    if (resumeHeld()) return;\\n    const S = RT.S;\\n280→    if (S && (S.lab || S.id === 'lab')) { go('menu'); return; }\\n    if (RT.mode === 'rounds' || (S && S.mode === 'rounds')) { go('lobby'); return; }\\n    if (S && S.won && RT.fromStory) { go('ward'); return; }\\n    go('menu');\\n  }\\n\\n  function readLocal(p) {\\n    const I = game.input;\\n    const [ox, oy] = origin();\\n    let digit = 0;\\n290→    for (let n = 1; n <= 8; n++) if (I.pressed('tool' + n)) digit = n;\\n    const tools = CFG.TOOLS;\\n    const idx = Math.max(0, tools.indexOf(p.tool));\\n    if (!digit && I.pressed('toolPrev')) digit = ((idx + 7) % 8) + 1;\\n    if (!digit && I.pressed('toolNext')) digit = ((idx + 1) % 8) + 1;\\n    const devOpen = RT.devOpen;\\n    const keys = devOpen ? [0, 0] : [\\n      (I.down('curR') ? 1 : 0) - (I.down('curL') ? 1 : 0),\\n      (I.down('curD') ? 1 : 0) - (I.down('curU') ? 1 : 0),\\n    ];\\n300→    const nudge = devOpen ? [0, 0] : [\\n      (I.down('nudgeR') ? 1 : 0) - (I.down('nudgeL') ? 1 : 0),\\n      (I.down('nudgeD') ? 1 : 0) - (I.down('nudgeU') ? 1 : 0),\\n    ];\\n    const swap = !!PREFS.swap;\\n    const aimSrc = (swap ? I.padMove : I.padAim) || [0, 0];\\n    const moveSrc = (swap ? (I.padAim || [0, 0]) : (I.padMove || [0, 0]));\\n    const aim = [aimSrc[0] || 0, aimSrc[1] || 0];\\n    const move = [moveSrc[0] || 0, moveSrc[1] || 0];\\n    let mouse = null;\\n310→    const ptr = I.pointer();\\n    if (ptr && (I.lastDevice === 'mouse' || I._fedAt)) mouse = [ptr[0] - ox, ptr[1] - oy];\\n    let trig = I.value('useTool') || 0;\\n    if (PREFS.sustain === 'toggle') {\\n      if (I.pressed('useTool')) RT.latched = !RT.latched;\\n      trig = RT.latched ? 1 : 0;\\n    }\\n    const pan = I.pan();\\n    if (!digit && I.down('wheelHold') && pan && Math.hypot(pan[0], pan[1]) > 8) {\\n      move[0] += pan[0] / Math.max(8, Math.hypot(pan[0], pan[1]));\\n320→      move[1] += pan[1] / Math.max(8, Math.hypot(pan[0], pan[1]));\\n    }\\n    return {\\n      digit, mouse, aim, move, keys, nudge,\\n      fine: I.down('fine'),\\n      trig,\\n      gift: I.down('gift'),\\n      consult: I.down('consult'),\\n      cancel: I.down('cancel'),\\n    };\\n330→  }\\n\\n  function drive(S, dt, opts) {\\n    opts = opts || {};\\n    const inputs = [];\\n    const n = S.players.length;\\n    for (let i = 0; i < n; i++) {\\n      const p = S.players[i];\\n      if (p.gone) { inputs.push({ tool: p.tool, trig: 0 }); continue; }\\n      let dev;\",\"content_concise\":\"220→        RT.redirect = true;\\n        RT.creditPage = 0;\\n        go('credits');\\n      },\\n    },\\n  });\\n  story.talk.voice = (ch) => { try { GAME.Audio.blip(ch); } catch (e) { /* quiet */ } };\\n  story.talk.bg = '#06141a';\\n  story.talk.border = '#5ff0e0';\\n  story.talk.color = '#e8fbf6';\\n230→  story.talk.nameColor = '#5ff0e0';\\n\\n  function beginCase(id, opts) {\\n    opts = opts || {};\\n    let def = GAME.CASES[id];\\n    if (id === 'ferry' || (def && def.id === 'ferry')) def = GAME.roundsCase(opts.players || 1);\\n    if (!def) return null;\\n    RT.def = def;\\n    RT.mode = opts.mode || def.mode || 'case';\\n    if (opts.fromStory != null) RT.fromStory = opts.fromStory;\\n240→    const S = GAME.Op.create(def, {\\n      seed: opts.seed == null ? 3 : opts.seed,\\n      difficulty: opts.difficulty || RT.diff || 'resident',\\n      players: opts.players || 1,\\n      phase: opts.phase || 0,\\n    });\\n    if (opts.clockDelta) S.clock += opts.clockDelta;\\n    if (opts.steadyDelta) S.steady += opts.steadyDelta;\\n    if (opts.cheat) S.cheat = Object.assign({}, S.cheat, opts.cheat);\\n    RT.S = S;\\n250→    RT.leftOp = false;\\n    RT.fieldKey = '';\\n    return S;\\n  }\\n  GAME.beginCase = beginCase;\\n\\n  function recordRank() {\\n    const S = RT.S;\\n    if (!S || !S.won || RT.attract || RT.cheatUsed || GAME.TUNE.dirty) return;\\n    if (S.lab || S.mode === 'rounds' || S.id === 'lab' || S.id === 'ferry') return;\\n260→    const ch = S.cheat || {};\\n    if (ch.reveal || ch.infSteady || ch.lockVitals || ch.freezeClock || ch.oneHit) return;\\n    RT.ranks[S.id] = S.rank;\\n    RT.cleared[S.id] = true;\\n    if (PERSON[S.id]) RT.saved[PERSON[S.id]] = true;\\n    const def = GAME.CASES[S.id];\\n    if (def && def.chapter) RT.chapter = def.chapter;\\n  }\\n\\n  function resumeHeld() {\\n270→    if (!(RT.fromStory && story._held)) return false;\\n    RT.redirect = false;\\n    story.resume();\\n    if (!RT.redirect) go('story');\\n    return true;\\n  }\\n\\n  function leaveResults() {\\n    if (resumeHeld()) return;\\n    const S = RT.S;\\n280→    if (S && (S.lab || S.id === 'lab')) { go('menu'); return; }\\n    if (RT.mode === 'rounds' || (S && S.mode === 'rounds')) { go('lobby'); return; }\\n    if (S && S.won && RT.fromStory) { go('ward'); return; }\\n    go('menu');\\n  }\\n\\n  function readLocal(p) {\\n    const I = game.input;\\n    const [ox, oy] = origin();\\n    let digit = 0;\\n290→    for (let n = 1; n <= 8; n++) if (I.pressed('tool' + n)) digit = n;\\n    const tools = CFG.TOOLS;\\n    const idx = Math.max(0, tools.indexOf(p.tool));\\n    if (!digit && I.pressed('toolPrev')) digit = ((idx + 7) % 8) + 1;\\n    if (!digit && I.pressed('toolNext')) digit = ((idx + 1) % 8) + 1;\\n    const devOpen = RT.devOpen;\\n    const keys = devOpen ? [0, 0] : [\\n      (I.down('curR') ? 1 : 0) - (I.down('curL') ? 1 : 0),\\n      (I.down('curD') ? 1 : 0) - (I.down('curU') ? 1 : 0),\\n    ];\\n300→    const nudge = devOpen ? [0, 0] : [\\n      (I.down('nudgeR') ? 1 : 0) - (I.down('nudgeL') ? 1 : 0),\\n      (I.down('nudgeD') ? 1 : 0) - (I.down('nudgeU') ? 1 : 0),\\n    ];\\n    const swap = !!PREFS.swap;\\n    const aimSrc = (swap ? I.padMove : I.padAim) || [0, 0];\\n    const moveSrc = (swap ? (I.padAim || [0, 0]) : (I.padMove || [0, 0]));\\n    const aim = [aimSrc[0] || 0, aimSrc[1] || 0];\\n    const move = [moveSrc[0] || 0, moveSrc[1] || 0];\\n    let mouse = null;\\n310→    const ptr = I.pointer();\\n    if (ptr && (I.lastDevice === 'mouse' || I._fedAt)) mouse = [ptr[0] - ox, ptr[1] - oy];\\n    let trig = I.value('useTool') || 0;\\n    if (PREFS.sustain === 'toggle') {\\n      if (I.pressed('useTool')) RT.latched = !RT.latched;\\n      trig = RT.latched ? 1 : 0;\\n    }\\n    const pan = I.pan();\\n    if (!digit && I.down('wheelHold') && pan && Math.hypot(pan[0], pan[1]) > 8) {\\n      move[0] += pan[0] / Math.max(8, Math.hypot(pan[0], pan[1]));\\n320→      move[1] += pan[1] / Math.max(8, Math.hypot(pan[0], pan[1]));\\n    }\\n    return {\\n      digit, mouse, aim, move, keys, nudge,\\n      fine: I.down('fine'),\\n      trig,\\n      gift: I.down('gift'),\\n      consult: I.down('consult'),\\n      cancel: I.down('cancel'),\\n    };\\n330→  }\\n\\n  function drive(S, dt, opts) {\\n    opts = opts || {};\\n    const inputs = [];\\n    const n = S.players.length;\\n    for (let i = 0; i < n; i++) {\\n      const p = S.players[i];\\n      if (p.gone) { inputs.push({ tool: p.tool, trig: 0 }); continue; }\\n      let dev;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/scenes/shell.js\",\"offset\":220,\"limit\":120,\"raw_output\":\"        RT.redirect = true;\\n        RT.creditPage = 0;\\n        go('credits');\\n      },\\n    },\\n  });\\n  story.talk.voice = (ch) => { try { GAME.Audio.blip(ch); } catch (e) { /* quiet */ } };\\n  story.talk.bg = '#06141a';\\n  story.talk.border = '#5ff0e0';\\n  story.talk.color = '#e8fbf6';\\n  story.talk.nameColor = '#5ff0e0';\\n\\n  function beginCase(id, opts) {\\n    opts = opts || {};\\n    let def = GAME.CASES[id];\\n    if (id === 'ferry' || (def && def.id === 'ferry')) def = GAME.roundsCase(opts.players || 1);\\n    if (!def) return null;\\n    RT.def = def;\\n    RT.mode = opts.mode || def.mode || 'case';\\n    if (opts.fromStory != null) RT.fromStory = opts.fromStory;\\n    const S = GAME.Op.create(def, {\\n      seed: opts.seed == null ? 3 : opts.seed,\\n      difficulty: opts.difficulty || RT.diff || 'resident',\\n      players: opts.players || 1,\\n      phase: opts.phase || 0,\\n    });\\n    if (opts.clockDelta) S.clock += opts.clockDelta;\\n    if (opts.steadyDelta) S.steady += opts.steadyDelta;\\n    if (opts.cheat) S.cheat = Object.assign({}, S.cheat, opts.cheat);\\n    RT.S = S;\\n    RT.leftOp = false;\\n    RT.fieldKey = '';\\n    return S;\\n  }\\n  GAME.beginCase = beginCase;\\n\\n  function recordRank() {\\n    const S = RT.S;\\n    if (!S || !S.won || RT.attract || RT.cheatUsed || GAME.TUNE.dirty) return;\\n    if (S.lab || S.mode === 'rounds' || S.id === 'lab' || S.id === 'ferry') return;\\n    const ch = S.cheat || {};\\n    if (ch.reveal || ch.infSteady || ch.lockVitals || ch.freezeClock || ch.oneHit) return;\\n    RT.ranks[S.id] = S.rank;\\n    RT.cleared[S.id] = true;\\n    if (PERSON[S.id]) RT.saved[PERSON[S.id]] = true;\\n    const def = GAME.CASES[S.id];\\n    if (def && def.chapter) RT.chapter = def.chapter;\\n  }\\n\\n  function resumeHeld() {\\n    if (!(RT.fromStory && story._held)) return false;\\n    RT.redirect = false;\\n    story.resume();\\n    if (!RT.redirect) go('story');\\n    return true;\\n  }\\n\\n  function leaveResults() {\\n    if (resumeHeld()) return;\\n    const S = RT.S;\\n    if (S && (S.lab || S.id === 'lab')) { go('menu'); return; }\\n    if (RT.mode === 'rounds' || (S && S.mode === 'rounds')) { go('lobby'); return; }\\n    if (S && S.won && RT.fromStory) { go('ward'); return; }\\n    go('menu');\\n  }\\n\\n  function readLocal(p) {\\n    const I = game.input;\\n    const [ox, oy] = origin();\\n    let digit = 0;\\n    for (let n = 1; n <= 8; n++) if (I.pressed('tool' + n)) digit = n;\\n    const tools = CFG.TOOLS;\\n    const idx = Math.max(0, tools.indexOf(p.tool));\\n    if (!digit && I.pressed('toolPrev')) digit = ((idx + 7) % 8) + 1;\\n    if (!digit && I.pressed('toolNext')) digit = ((idx + 1) % 8) + 1;\\n    const devOpen = RT.devOpen;\\n    const keys = devOpen ? [0, 0] : [\\n      (I.down('curR') ? 1 : 0) - (I.down('curL') ? 1 : 0),\\n      (I.down('curD') ? 1 : 0) - (I.down('curU') ? 1 : 0),\\n    ];\\n    const nudge = devOpen ? [0, 0] : [\\n      (I.down('nudgeR') ? 1 : 0) - (I.down('nudgeL') ? 1 : 0),\\n      (I.down('nudgeD') ? 1 : 0) - (I.down('nudgeU') ? 1 : 0),\\n    ];\\n    const swap = !!PREFS.swap;\\n    const aimSrc = (swap ? I.padMove : I.padAim) || [0, 0];\\n    const moveSrc = (swap ? (I.padAim || [0, 0]) : (I.padMove || [0, 0]));\\n    const aim = [aimSrc[0] || 0, aimSrc[1] || 0];\\n    const move = [moveSrc[0] || 0, moveSrc[1] || 0];\\n    let mouse = null;\\n    const ptr = I.pointer();\\n    if (ptr && (I.lastDevice === 'mouse' || I._fedAt)) mouse = [ptr[0] - ox, ptr[1] - oy];\\n    let trig = I.value('useTool') || 0;\\n    if (PREFS.sustain === 'toggle') {\\n      if (I.pressed('useTool')) RT.latched = !RT.latched;\\n      trig = RT.latched ? 1 : 0;\\n    }\\n    const pan = I.pan();\\n    if (!digit && I.down('wheelHold') && pan && Math.hypot(pan[0], pan[1]) > 8) {\\n      move[0] += pan[0] / Math.max(8, Math.hypot(pan[0], pan[1]));\\n      move[1] += pan[1] / Math.max(8, Math.hypot(pan[0], pan[1]));\\n    }\\n    return {\\n      digit, mouse, aim, move, keys, nudge,\\n      fine: I.down('fine'),\\n      trig,\\n      gift: I.down('gift'),\\n      consult: I.down('consult'),\\n      cancel: I.down('cancel'),\\n    };\\n  }\\n\\n  function drive(S, dt, opts) {\\n    opts = opts || {};\\n    const inputs = [];\\n    const n = S.players.length;\\n    for (let i = 0; i < n; i++) {\\n      const p = S.players[i];\\n      if (p.gone) { inputs.push({ tool: p.tool, trig: 0 }); continue; }\\n      let dev;\\n\",\"total_lines\":1410}}","is_error":false},{"type":"tool_result","tool_use_id":"call-9d7b3234-f76a-4f1f-913f-077ab34a2d0b-24","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1400→    const def = (GAME.CASES || {})[S.id];\\n    if (!def) { finishCase(S); return; }\\n    if (S.phase + 1 >= def.phases.length) {\\n      if (!S.dressing && !S.won) {\\n        S.dressing = { t: 0, done: false };\\n        pushEv(S, ['dressing', 1]);\\n        return;\\n      }\\n      return;\\n    }\\n1410→    loadPhase(S, def, S.phase + 1);\\n  }\\n\\n  function create(def, opts) {\\n    opts = opts || {};\\n    const diff = opts.difficulty || opts.diff || 'resident';\\n    const doc = def.doctor || 'vale';\\n    const S = blank({\\n      id: def.id, seed: opts.seed || def.seed || 1, players: opts.players || 1,\\n      difficulty: diff, clock: def.clock, vitals: def.vitals, drain: def.drain,\\n1420→      gift: doc === 'sokolova' ? 'look' : doc === 'both' ? 'both' : 'breath',\\n      doctor: doc === 'both' ? 'vale' : doc, site: def.site, par: def.par || 1000,\\n      mode: def.mode || 'case', consult: !!def.consult || doc === 'both',\\n    });\\n    if (doc === 'both') S.activeDoc = 'vale';\\n    S.clock0 = S.clock;\\n    if (def.doctor === 'both') S.consult = true;\\n    loadPhase(S, def, opts.phase || 0);\\n    if (def.lab) { S.hold = true; S.lab = true; S.cheat = { lockVitals: true, freezeClock: true }; }\\n    return S;\\n1430→  }\\n\\n  function createRaw(opts) {\\n    const S = blank(opts);\\n    for (const spec of opts.objects || []) addObj(S, clone(spec));\\n    if (opts.strain) spawnStrain(S, opts.strain, opts.strainOpts || {});\\n    if (opts.scripts) S.scripts = opts.scripts.map(a => ({ t: a.t, do: a.do, done: false }));\\n    S.hold = opts.hold !== false;\\n    S.checkpoint = takeCore(S);\\n    return S;\\n1440→  }\\n\\n  function readInputs(S, inputs, dt) {\\n    inputs = inputs || [];\\n    for (let i = 0; i < S.players.length; i++) {\\n      const p = S.players[i];\\n      const inp = inputs[i] || {};\\n      const ox = p.lx != null ? p.lx : p.x, oy = p.ly != null ? p.ly : p.y;\\n      if (inp.x != null) { p.x = inp.x; p.y = inp.y; p.bx = inp.x; p.by = inp.y; }\\n      if (inp.tool) p.tool = inp.tool;\\n1450→      p.inst = hypot(p.x - ox, p.y - oy) / Math.max(dt, 1e-4);\\n      p.lx = p.x; p.ly = p.y;\\n      p.fine = !!inp.fine;\\n      p.mouse = !!inp.mouse;\\n      const trig = inp.trig || 0;\\n      p.trigEdge = trig > 0.3 && p.prevTrig <= 0.3;\\n      p.trigRelease = trig <= 0.3 && p.prevTrig > 0.3;\\n      p.prevTrig = trig;\\n      p.trig = trig;\\n      const gift = !!inp.gift;\\n1460→      p.giftEdge = gift && !p.giftPrev;\\n      p.giftPrev = gift;\\n      const consult = !!inp.consult;\\n      p.consultEdge = consult && !p.consultPrev;\\n      p.consultPrev = consult;\\n      p.cancelEdge = !!inp.cancel;\\n      if (p.cancelEdge) { p.held = 0; p.stroke = null; }\\n    }\\n  }\\n\\n1470→  function tryGifts(S, tune) {\\n    for (const p of S.players) {\\n      if (!p.giftEdge) continue;\\n      if (S.breath) { S.breath = false; S.worldScale = 1; pushEv(S, ['breath', 0]); continue; }\\n      const doc = S.activeDoc;\\n      const wantLook = doc === 'sokolova' || (S.gift === 'look' && doc !== 'vale');\\n      const wantBreath = doc === 'vale' || S.gift === 'breath' || (S.gift === 'both' && doc === 'vale');\\n      if (S.gift === 'both') {\\n        if (doc === 'sokolova') { if (secondLook(S, tune)) return; }\\n        else if (S.steady >= 35) { S.breath = true; pushEv(S, ['breath', 1]); return; }\\n1480→      } else if (S.gift === 'look' || wantLook && S.gift !== 'breath') {\\n        secondLook(S, tune);\\n      } else if (wantBreath && S.steady >= 35) {\\n        S.breath = true;\\n        pushEv(S, ['breath', 1]);\\n      }\\n    }\\n    for (const p of S.players) {\\n      if (!p.consultEdge || !S.consult) continue;\\n      S.activeDoc = S.activeDoc === 'vale' ? 'sokolova' : 'vale';\\n1490→      pushEv(S, ['consult', S.activeDoc]);\\n    }\\n  }\\n\\n  function stepCodeBlue(S, dt) {\\n    const cb = S.codeBlue;\\n    if (!cb) return;\\n    cb.t += dt;\\n    const peaks = [0.9, 1.8, 2.7, 3.6];\\n    const p = S.players[0];\\n1500→    if (cb.next == null) cb.next = 0;\\n    if (cb.next < 4) {\\n      const peak = peaks[cb.next];\\n      if (p && p.trigEdge) {\\n        const err = Math.abs(cb.t - peak);\\n        cb.attempts += 1;\\n        if (err <= 0.14) {\\n          cb.hits += 1;\\n          if (err <= 0.06) cb.textbook = (cb.textbook || 0) + 1;\\n          pushEv(S, ['shock', cb.hits, err]);\\n1510→        } else pushEv(S, ['miss', err]);\\n        cb.next += 1;\\n      } else if (cb.t > peak + 0.14) {\\n        cb.attempts += 1;\\n        cb.next += 1;\\n        pushEv(S, ['miss', 1]);\\n      }\\n    }\\n    if (cb.next >= 4 && !cb.resolved) {\\n      cb.resolved = true;\\n1520→      S.codeBlue = null;\\n      if (cb.hits >= 2) {\\n        S.vitals = 30;\\n        S.flags.crash = 0;\\n        pushEv(S, ['revived', cb.textbook >= 2 ? 'textbook' : 'clean']);\\n      } else lose(S, 'code');\\n    }\\n  }\\n\\n  function maybeDie(S) {\\n1530→    if (S.won || S.lost || S.codeBlue || S.dressing) return;\\n    if (S.clock <= 0) { lose(S, 'time'); return; }\\n    if (S.vitals <= 0) {\\n      if (S.diff === 'attending' || S.codeBlueUsed) { lose(S, 'vitals'); return; }\\n      S.codeBlueUsed = true;\\n      S.codeBlue = { t: 0, hits: 0, attempts: 0, next: 0, textbook: 0, resolved: false };\\n      S.vitals = 0;\\n      S.breath = false;\\n      pushEv(S, ['codeblue', 1]);\\n    }\\n1540→  }\\n\\n  function stepDressing(S, dt, tune) {\\n    const d = S.dressing;\\n    d.t += dt;\\n    const u = (d.t % 1.2) / 1.2;\\n    const edge = Math.min(u, 1 - u);\\n    const p = S.players[0];\\n    if (p && p.trigEdge) {\\n      const bonus = edge < 0.08 ? 80 : 20;\\n1550→      S.score += bonus;\\n      d.done = true;\\n      pushEv(S, ['stamp', bonus]);\\n      finishCase(S);\\n    } else if (d.t > 4) {\\n      d.done = true;\\n      finishCase(S);\\n    }\\n  }\\n\\n1560→  function step(S, inputs, dt, tune) {\\n    tune = tuneOf(tune);\\n    if (!dt || dt < 0) dt = 0;\\n    S.ev = [];\\n    if (S.won || S.lost) return S;\\n    readInputs(S, inputs, dt);\\n    if (S.codeBlue) { stepCodeBlue(S, dt); return S; }\\n    tryGifts(S, tune);\\n    if (S.breath) {\\n      S.steady = Math.max(0, S.steady - tune.gift.breathDrain * dt);\\n1570→      if (S.steady <= 0) { S.breath = false; pushEv(S, ['breath', 0]); }\\n    }\\n    S.worldScale = S.breath ? tune.gift.breathFactor : 1;\\n    const worldDt = dt * S.worldScale;\\n    if (S.dressing) { stepDressing(S, dt, tune); return S; }\\n\\n    const frozen = S.tutorial && !S.tutDone;\\n    const ch = S.cheat || {};\\n    if (ch.reveal) {\\n      for (const o of S.objects) if (o.hidden) { o.marked = true; o.markT = 4; }\",\"content_concise\":\"1400→    const def = (GAME.CASES || {})[S.id];\\n    if (!def) { finishCase(S); return; }\\n    if (S.phase + 1 >= def.phases.length) {\\n      if (!S.dressing && !S.won) {\\n        S.dressing = { t: 0, done: false };\\n        pushEv(S, ['dressing', 1]);\\n        return;\\n      }\\n      return;\\n    }\\n1410→    loadPhase(S, def, S.phase + 1);\\n  }\\n\\n  function create(def, opts) {\\n    opts = opts || {};\\n    const diff = opts.difficulty || opts.diff || 'resident';\\n    const doc = def.doctor || 'vale';\\n    const S = blank({\\n      id: def.id, seed: opts.seed || def.seed || 1, players: opts.players || 1,\\n      difficulty: diff, clock: def.clock, vitals: def.vitals, drain: def.drain,\\n1420→      gift: doc === 'sokolova' ? 'look' : doc === 'both' ? 'both' : 'breath',\\n      doctor: doc === 'both' ? 'vale' : doc, site: def.site, par: def.par || 1000,\\n      mode: def.mode || 'case', consult: !!def.consult || doc === 'both',\\n    });\\n    if (doc === 'both') S.activeDoc = 'vale';\\n    S.clock0 = S.clock;\\n    if (def.doctor === 'both') S.consult = true;\\n    loadPhase(S, def, opts.phase || 0);\\n    if (def.lab) { S.hold = true; S.lab = true; S.cheat = { lockVitals: true, freezeClock: true }; }\\n    return S;\\n1430→  }\\n\\n  function createRaw(opts) {\\n    const S = blank(opts);\\n    for (const spec of opts.objects || []) addObj(S, clone(spec));\\n    if (opts.strain) spawnStrain(S, opts.strain, opts.strainOpts || {});\\n    if (opts.scripts) S.scripts = opts.script