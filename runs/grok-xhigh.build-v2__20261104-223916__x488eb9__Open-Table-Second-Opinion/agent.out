     } else if (it.box ? xOver(it.box[0], it.box[1], it.box[2], it.box[3]) : !it.occ || (() => { const [sx, sy] = this.w(it.x, it.y, 0), s = this.view.scale || 1; return xOver(sx - 24 * s, sy - 120 * s, sx + 24 * s, sy + 20 * s); })()) { this._oG.globalAlpha = 1; it.fn(this._oG); this._oG.globalAlpha = 1; }   // (a wall block far from every silhouette is skipped: a generous box, a block is 16 wide and rarely 70 tall)\"},{\"line_number\":2319,\"content\":\"   *   scenes update and draw is skipped; drive it with advance() and input.press / release / tap / hold\"},{\"line_number\":2415,\"content\":\"     *  what it queued for drawing; actors: actors drawn; culled: actors skipped off screen */\"},{\"line_number\":2748,\"content\":\"      // than one and a half are read (a GPU behind skips the refresh between: read, a 120 Hz screen would pass for 60); never\"},{\"line_number\":7663,\"content\":\"  /** clear, then add every live thing in list (skips o.dead); do it once a step */\"},{\"line_number\":7739,\"content\":\"   *  rule); until then, and where there is no Web Audio, every call is silently skipped */\"},{\"line_number\":7993,\"content\":\"  // needs its notes 400 ms ahead, or they would fall in the past and be skipped), each at the sound's time its anchor maps it\"},{\"line_number\":9281,\"content\":\"    this._skip(1);\"},{\"line_number\":9285,\"content\":\"  _skip(dir) { for (let k = 0; k < this.items.length && this._off(this.items[this.i]); k++) this.i = (this.i + dir + this.items.length) % this.items.length; }\"},{\"line_number\":9307,\"content\":\"    if (any(I => I.repeat('up'))) { this.i = (this.i + n - 1) % n; this._skip(-1); }\"},{\"line_number\":9308,\"content\":\"    if (any(I => I.repeat('down'))) { this.i = (this.i + 1) % n; this._skip(1); }\"},{\"line_number\":10136,\"content\":\"    if ((this._inflight || 0) >= 2) { this.skipped = (this.skipped || 0) + 1; return; }\"},{\"line_number\":12831,\"content\":\"    /** world: its world; id: its number (the order added); sleeping: at rest, skipped until something wakes it; held: the\"},{\"line_number\":13060,\"content\":\"  // the first body a point of radius R meets moving by (mx, my) from (x, y): { body, t, x, y }, skipping those it\"},{\"line_number\":13689,\"content\":\"  sixteenth of HP each tick; regen heals that; sleep and stop skip turns; silence bars skills; haste and slow change\"},{\"line_number\":13690,\"content\":\"  spd), each { turns (0: till cured), hurt, heal, skip, mute, spd }. curve(lv): the experience a level needs in all.\"},{\"line_number\":13694,\"content\":\"  equip(id, inv) (the old piece back into inv), unequip(slot, inv), compare(id) → { atk: 3, def: -1 } (equipping it); afflict(k, turns), cure(k) (k left out: all), has(k), acts() (no skip), tick() (a turn: hurt, heal,\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"4ccec532-3932-443a-ab8b-0ef5ddd66478"}
