{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-8af2d28e-ff32-468f-92c9-cb558f4330ab-27","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"100→    const htmlPath = path.join(work, htmlName);\\n    if (fs.existsSync(htmlPath)) {\\n      const html = fs.readFileSync(htmlPath, 'utf8');\\n      check('bundle clean', !banned.test(html));\\n      check('bundle has no external script', !/<script[^>]+src=/i.test(html));\\n      check('bundle titles the game', html.includes('<title>Open Table Second Opinion</title>'));\\n      check('session.js is inlined first', html.indexOf('AI Hub Session Protocol') < html.indexOf('My3D2dge') || html.indexOf('hub:session') > 0);\\n    } else if (!fast) check('bundle exists', false, htmlName);\\n  });\\n\\n110→  group('cursor', () => {\\n    const travel = (doctor, fine) => {\\n      const S = raw({ doctor });\\n      S.activeDoc = doctor;\\n      const p = S.players[0];\\n      p.bx = 16; p.by = 120; p.x = 16; p.y = 16; p.speed = 0;\\n      const T = tune();\\n      for (let i = 0; i < 120; i++) GAME.Cursor.update(p, { aim: [1, 0], fine: !!fine }, S, 1 / 120, T);\\n      return p.bx - 16;\\n    };\\n120→    const full = travel('sokolova', false);\\n    const fineD = travel('sokolova', true);\\n    const vale = travel('vale', false);\\n    check('full stick covers 300', full >= 300, full.toFixed(1));\\n    check('fine stick stays within 120', fineD <= 120, fineD.toFixed(1));\\n    check('vale is quicker', vale > full * 1.1 && vale < full * 1.2, vale.toFixed(1) + ' vs ' + full.toFixed(1));\\n    const S = raw({ doctor: 'sokolova' });\\n    const p = S.players[0];\\n    p.tool = 'forceps';\\n    GAME.Wheel.update(p, { move: [1, -1] }, 0.05);\\n130→    check('wheel waits out a flick', p.tool === 'forceps', p.tool);\\n    GAME.Wheel.update(p, { move: [1, -1] }, 0.05);\\n    check('wheel settles by 100ms', p.tool === 'scalpel', p.tool);\\n    GAME.Wheel.update(p, { digit: 8 }, 0.016);\\n    check('digit picks at once', p.tool === 'sonar', p.tool);\\n  });\\n\\n  group('forceps', () => {\\n    const tear = raw();\\n    const shard = GAME.Sim.addObj(tear, { type: 'shard', x: 200, y: 140, depth: 40, tension: 120, axis: [1, 0], drain: 0 });\\n140→    const before = tear.objects.filter((o) => o.type === 'laceration').length;\\n    step(tear, [{ x: 200, y: 140, tool: 'forceps', trig: 1 }], 1 / 30);\\n    step(tear, [{ x: 200, y: 160, tool: 'forceps', trig: 1 }], 1 / 30);\\n    check('a sideways pull tears', (shard.tears || 0) >= 1, String(shard.tears));\\n    check('a tear leaves a laceration', tear.objects.filter((o) => o.type === 'laceration').length > before);\\n\\n    const dish = raw();\\n    const bit = GAME.Sim.addObj(dish, { type: 'shard', x: 180, y: 140, depth: 16, tension: 120, axis: [1, 0], drain: 0 });\\n    step(dish, [{ x: 180, y: 140, tool: 'forceps', trig: 1 }], 0.05);\\n    for (let x = 182; x <= 200; x += 2) step(dish, [{ x, y: 140, tool: 'forceps', trig: 1 }], 0.05);\\n150→    check('the shard comes free', !!bit.free, 'prog ' + bit.prog);\\n    step(dish, [{ x: 220, y: 140, tool: 'forceps', trig: 1 }], 0.05);\\n    step(dish, [{ x: 220, y: 140, tool: 'forceps', trig: 0 }], 0.05);\\n    check('a free shard dishes', !!bit.done, 'held ' + dish.players[0].held);\\n\\n    const snap = raw();\\n    const head = GAME.Sim.addObj(snap, { type: 'shard', x: 200, y: 140, depth: 40, tension: 120, axis: [1, 0], tag: 'legato-head', drain: 0 });\\n    step(snap, [{ x: 200, y: 140, tool: 'forceps', trig: 1 }], 1 / 30);\\n    const lac = snap.objects.filter((o) => o.type === 'laceration').length;\\n    step(snap, [{ x: 200, y: 160, tool: 'forceps', trig: 1 }], 1 / 30);\\n160→    check('a legato head snaps', !!head.snapped);\\n    check('a snap is not a cut', snap.objects.filter((o) => o.type === 'laceration').length === lac);\\n  });\\n\\n  group('scalpel and suture', () => {\\n    const slipS = raw();\\n    const cut = GAME.Sim.addObj(slipS, { type: 'cut', x: 200, y: 120, guide: [[160, 120], [280, 120]], drain: 0 });\\n    step(slipS, [{ x: 160, y: 120, tool: 'scalpel', trig: 1, mouse: true }], 1 / 60);\\n    hold(slipS, [{ x: 160, y: 142, tool: 'scalpel', trig: 1, mouse: true }], 0.2, 1 / 60);\\n    check('off the line is a slip', slipS.slips > 0, 'slips ' + slipS.slips + ' id ' + cut.id);\\n170→\\n    const ring = raw();\\n    const mass = GAME.Sim.addObj(ring, { type: 'mass', x: 213, y: 116, rad: 16, drain: 0 });\\n    const guide = mass.guide;\\n    step(ring, [{ x: guide[0][0], y: guide[0][1], tool: 'scalpel', trig: 1, mouse: true }], 1 / 60);\\n    for (const pt of guide) step(ring, [{ x: pt[0], y: pt[1], tool: 'scalpel', trig: 1, mouse: true }], 1 / 60);\\n    check('a closed ring finishes', !!mass.cut || mass.prog >= 0.98, 'prog ' + mass.prog);\\n\\n    const sew = raw();\\n    const wound = GAME.Sim.addObj(sew, { type: 'wound', x: 200, y: 130, stitches: 2, drain: 0 });\\n180→    const a = wound.pairs[0][0], b = wound.pairs[0][1];\\n    step(sew, [{ x: a[0], y: a[1], tool: 'suture', trig: 1 }], 1 / 60);\\n    hold(sew, [{ x: a[0], y: a[1], tool: 'suture', trig: 1 }], 0.2, 1 / 60);\\n    step(sew, [{ x: b[0], y: b[1], tool: 'suture', trig: 0 }], 1 / 60);\\n    check('a stitch lands on the far point', wound.stitch === 1, 'stitch ' + wound.stitch);\\n  });\\n\\n  group('salve syringe cautery suction sonar', () => {\\n    const gel = raw();\\n    const lac = GAME.Sim.addObj(gel, { type: 'laceration', x: 200, y: 120, r: 8, drain: 0 });\\n190→    for (const c of lac.cells) step(gel, [{ x: c[0], y: c[1], tool: 'salve', trig: 1 }], 1 / 30);\\n    check('salve covers the patch', !!lac.done, 'prog ' + (lac.prog || 0).toFixed(2));\\n\\n    const air = raw({ vitals: 40 });\\n    hold(air, [{ x: 40, y: 40, tool: 'syringe', trig: 1 }], 0.95, 0.05);\\n    step(air, [{ x: 40, y: 40, tool: 'syringe', trig: 0 }], 0.05);\\n    check('air in the line is sloppy', air.ev.some((e) => e[0] === 'iv' && e[2] === 'sloppy'), JSON.stringify(air.ev));\\n\\n    const reedS = raw();\\n    const reed = GAME.Sim.addObj(reedS, { type: 'reed', x: 200, y: 120, window: false, drain: 0 });\\n200→    hold(reedS, [{ x: 40, y: 40, tool: 'syringe', trig: 1 }], 0.6, 0.05);\\n    step(reedS, [{ x: reed.x, y: reed.y, tool: 'syringe', trig: 1 }], 0.05);\\n    step(reedS, [{ x: reed.x, y: reed.y, tool: 'syringe', trig: 0 }], 0.05);\\n    check('a closed reed splits', reedS.objects.some((o) => o.type === 'laceration'), 'ev ' + JSON.stringify(reedS.ev));\\n\\n    const burn = raw();\\n    hold(burn, [{ x: 40, y: 40, tool: 'cautery', trig: 1 }], 2.2, 0.05);\\n    check('the cautery locks', burn.slips > 0 && burn.ev.concat(burn.players[0].lock > 0 ? [['lock']] : []).length >= 0 && (burn.players[0].lock > 0 || burn.players[0].heat >= 1 || burn.slips > 0));\\n    check('lock was a slip', burn.players[0].slips > 0 || burn.slips > 0, 'lock ' + burn.players[0].lock);\\n\\n210→    const suck = raw();\\n    const pool = GAME.Sim.addObj(suck, { type: 'pool', x: 200, y: 140, vol: 30, max: 30, drain: 0 });\\n    hold(suck, [{ x: 200, y: 140, tool: 'suction', trig: 1 }], 0.7, 0.05);\\n    check('suction empties a pool', pool.vol <= 0.2 || pool.done, 'vol ' + pool.vol);\\n\\n    const ping = raw({ doctor: 'sokolova' });\\n    ping.activeDoc = 'sokolova';\\n    ping.gift = 'look';\\n    const hid = GAME.Sim.addObj(ping, { type: 'shard', x: 200, y: 140, hidden: true, drain: 0 });\\n    step(ping, [{ x: 200, y: 140, tool: 'sonar', trig: 1 }], 1 / 30);\\n220→    check('sonar marks a hidden shard', !!hid.marked);\\n  });\\n\\n  group('grades clock gifts', () => {\\n    const rank = GAME.Op.rankLetter;\\n    check('S', rank(1000, 1000, 'resident', 0, null) === 'S');\\n    check('A', rank(800, 1000, 'resident', 0, null) === 'A');\\n    check('B', rank(600, 1000, 'resident', 0, null) === 'B');\\n    check('C', rank(400, 1000, 'resident', 0, null) === 'C');\\n    check('D', rank(100, 1000, 'resident', 0, null) === 'D');\\n230→    check('S+', rank(1000, 1000, 'attending', 0, null) === 'S+');\\n    check('slips block S+', rank(1000, 1000, 'attending', 1, null) === 'S');\\n    check('retry caps at B', rank(1000, 1000, 'resident', 0, 'B') === 'B');\\n\\n    const again = GAME.Op.create(GAME.CASES.c1, { seed: 1, difficulty: 'resident' });\\n    again.lost = true;\\n    GAME.Op.retryPhase(again);\\n    check('retry clears the loss and caps the rank', again.rankCap === 'B' && again.lost === false);\\n\\n    const timed = raw({ clock: 0.01, vitals: 0.01, drain: 50 });\\n240→    step(timed, [{ trig: 0 }], 0.05);\\n    check('the clock fails before a crash', timed.reason === 'time' && !timed.codeBlue, timed.reason);\\n\\n    const hard = raw({ difficulty: 'attending', clock: 100, vitals: 0.2, drain: 20 });\\n    step(hard, [{ trig: 0 }], 0.1);\\n    check('attending has no Code Blue', hard.lost && hard.reason === 'vitals' && !hard.codeBlue, hard.reason);\\n\\n    const blue = raw({ clock: 100, vitals: 0.2, drain: 20 });\\n    step(blue, [{ trig: 0 }], 0.05);\\n    check('vitals open Code Blue', !!blue.codeBlue || blue.codeBlueUsed, blue.reason);\\n250→    const peaks = [0.9, 1.8, 2.7, 3.6];\\n    let pi = 0;\\n    let arm = false;\\n    for (let i = 0; i < 400 && blue.codeBlue; i++) {\\n      const want = blue.codeBlue && pi < 4 && Math.abs(blue.codeBlue.t - peaks[pi]) < 0.04;\\n      const press = want && !arm;\\n      if (want && !arm) arm = true;\\n      step(blue, [{ trig: press || (arm && want) ? 1 : 0 }], 1 / 60);\\n      if (press) { pi += 1; arm = false; }\\n    }\\n260→    check('two shocks bring the patient back', blue.vitals >= 30 && !blue.lost, 'vit ' + blue.vitals + ' ' + blue.reason + ' hits ' + pi);\\n\\n    const drop = (diff) => {\\n      const S = raw({ difficulty: diff, clock: 100, drain: 0, vitals: 80 });\\n      hold(S, [{ trig: 0 }], 1, 1 / 60);\\n      return 100 - S.clock;\\n    };\\n    const intern = drop('intern'), resident = drop('resident'), attending = drop('attending');\\n    check('intern clock is slower', intern < resident - 0.15 && intern > 0.6, intern.toFixed(3));\\n    check('attending clock is faster', attending > resident + 0.15, attending.toFixed(3));\\n270→\\n    const breath = raw({ doctor: 'vale', gift: 'breath', clock: 100, steady: 40 });\\n    breath.steady = 40;\\n    breath.gift = 'breath';\\n    breath.activeDoc = 'vale';\\n    step(breath, [{ gift: true, trig: 0 }], 1 / 60);\\n    check('Long Breath slows the field', breath.breath && breath.worldScale === 0.25, String(breath.worldScale));\\n    const p = breath.players[0];\\n    p.bx = 30; p.by = 120; p.speed = 0;\\n    const still = raw({ doctor: 'vale' });\\n280→    const q = still.players[0];\\n    q.bx = 30; q.by = 120; q.speed = 0;\\n    const T = tune();\\n    for (let i = 0; i < 60; i++) {\\n      GAME.Cursor.update(p, { aim: [1, 0] }, breath, 1 / 60, T);\\n      GAME.Cursor.update(q, { aim: [1, 0] }, still, 1 / 60, T);\\n    }\\n    check('the hand still moves in real time', Math.abs((p.bx - 30) - (q.bx - 30)) < 1.5, (p.bx - 30).toFixed(1));\\n    const c0 = breath.clock;\\n    hold(breath, [{ gift: false, trig: 0 }], 1, 1 / 60);\\n290→    const fell = c0 - breath.clock;\\n    check('the clock crawls under Long Breath', fell > 0.15 && fell < 0.4, fell.toFixed(3));\\n\\n    const look = raw({ doctor: 'sokolova', gift: 'look', clock: 200, steady: 0 });\\n    look.gift = 'look';\\n    look.activeDoc = 'sokolova';\\n    const shard = GAME.Sim.addObj(look, { type: 'shard', x: 180, y: 120, depth: 40, drain: 0 });\\n    hold(look, [{ trig: 0 }], 0.4, 0.05);\\n    look.players[0].x = 40;\\n    look.players[0].bx = 40;\\n300→    shard.x = 300;\\n    look.clock = 5;\\n    look.steady = 80;\\n    const rewound = GAME.Op.secondLook(look, tune());\\n    const back = look.objects.find((o) => o.type === 'shard');\\n    check('Second Look restores the field', rewound && back && Math.abs(back.x - 180) < 0.01 && look.clock > 100, 'x ' + (back && back.x) + ' clock ' + look.clock);\\n    check('the cursor stays put', Math.abs(look.players[0].x - 40) < 0.01, String(look.players[0].x));\\n    check('Second Look spends Steady', look.steady < 40, String(look.steady));\\n  });\\n\\n310→  group('window and strains', () => {\\n    const solo = raw({ players: 1 });\\n    GAME.Sim.addObj(solo, { type: 'retractor', x: 180, y: 140, drain: 0 });\\n    GAME.Sim.addObj(solo, { type: 'mass', x: 230, y: 140, needsWindow: true, drain: 0 });\\n    step(solo, [{ trig: 0 }], 1 / 30);\\n    check('one surgeon gets half the window', solo.windowOpen === 0.5, String(solo.windowOpen));\\n\\n    const pair = raw({ players: 2 });\\n    const ret = GAME.Sim.addObj(pair, { type: 'retractor', x: 170, y: 140, drain: 0 });\\n    const mass = GAME.Sim.addObj(pair, { type: 'mass', x: 240, y: 140, needsWindow: true, drain: 0, rad: 14 });\\n320→    step(pair, [{ trig: 0 }, { trig: 0 }], 1 / 30);\\n    check('two surgeons must hold the window', pair.windowOpen === 0, String(pair.windowOpen));\\n    const start = mass.guide[0];\\n    step(pair, [{ trig: 0 }, { x: start[0], y: start[1], tool: 'scalpel', trig: 1, mouse: true }], 1 / 30);\\n    check('a shut window refuses the scalpel', !pair.players[1].stroke);\\n    step(pair, [{ x: ret.x, y: ret.y, tool: 'forceps', trig: 1 }, { trig: 0 }], 1 / 30);\\n    step(pair, [\\n      { x: ret.x, y: ret.y, tool: 'forceps', trig: 1 },\\n      { x: start[0], y: start[1], tool: 'scalpel', trig: 1, mouse: true },\\n    ], 1 / 30);\\n330→    check('a held window lets the other hand cut', pair.windowOpen === 1 && !!pair.players[1].stroke, 'open ' + pair.windowOpen);\\n\\n    const capo = raw({ vitals: 80 });\\n    capo.cheat = { lockVitals: true };\\n    GAME.Sim.spawnStrain(capo, 'dacapo');\\n    const lobe = capo.objects.find((o) => o.type === 'lobe');\\n    lobe.done = true;\\n    step(capo, [{ trig: 0 }], 0.05);\\n    capo.strain.count = 0.02;\\n    const v0 = capo.vitals;\\n340→    step(capo, [{ trig: 0 }], 0.05);\\n    check('Da Capo regrows', capo.strain.repeated === 1 && !lobe.done && capo.vitals <= v0 - 7, 'rep ' + capo.strain.repeated + ' vit ' + capo.vitals);\\n\\n    const eyeS = raw();\\n    GAME.Sim.spawnStrain(eyeS, 'fermata');\\n    eyeS.strain.domes = [];\\n    step(eyeS, [{ trig: 0 }], 0.05);\\n    const eye = eyeS.objects.find((o) => o.type === 'eye');\\n    check('the Fermata eye opens', !!(eye && eye.open));\\n\\n350→    const cant = raw({ steady: 60, vitals: 90 });\\n    cant.steady = 60;\\n    GAME.Sim.spawnStrain(cant, 'cantor');\\n    hold(cant, [{ trig: 0 }], 0.6, 0.05);\\n    GAME.Sim.addObj(cant, { type: 'shard', x: 50, y: 50, tag: 'marker', drain: 0, depth: 80 });\\n    const steadyBefore = cant.steady;\\n    cant.strain.move = 3;\\n    cant.strain.cycleT = 20;\\n    hold(cant, [{ trig: 0 }], 3.3, 0.05);\\n    check('the Cantor rewinds the field', !cant.objects.some((o) => o.tag === 'marker'));\\n360→    check('the Cantor keeps Steady', cant.steady > steadyBefore + 0.4, cant.steady.toFixed(2) + ' vs ' + steadyBefore.toFixed(2));\\n  });\\n\\n  group('determinism and bots', () => {\\n    GAME.Dev.reset();\\n    GAME.Art.force = false;\\n    const hashRun = (force) => {\\n      GAME.Art.force = force;\\n      const S = GAME.Op.create(GAME.CASES.c1, { seed: 9, difficulty: 'resident' });\\n      const t0 = S.t;\\n370→      let guard = 0;\\n      while (S.t - t0 < 4 && !S.won && !S.lost && guard < 20000) {\\n        const inputs = [];\\n        for (let i = 0; i < S.players.length; i++) {\\n          const dev = GAME.Bot.device(S, i, 1 / 45);\\n          const p = S.players[i];\\n          GAME.Wheel.update(p, dev, 1 / 45);\\n          if (dev.mouse) GAME.Cursor.update(p, { mouse: dev.mouse, fine: dev.fine }, S, 1 / 45);\\n          inputs.push({ tool: p.tool, trig: dev.trig, fine: !!dev.fine, gift: !!dev.gift, consult: !!dev.consult, mouse: true });\\n        }\",\"content_concise\":\"100→    const htmlPath = path.join(work, htmlName);\\n    if (fs.existsSync(htmlPath)) {\\n      const html = fs.readFileSync(htmlPath, 'utf8');\\n      check('bundle clean', !banned.test(html));\\n      check('bundle has no external script', !/<script[^>]+src=/i.test(html));\\n      check('bundle titles the game', html.includes('<title>Open Table Second Opinion</title>'));\\n      check('session.js is inlined first', html.indexOf('AI Hub Session Protocol') < html.indexOf('My3D2dge') || html.indexOf('hub:session') > 0);\\n    } else if (!fast) check('bundle exists', false, htmlName);\\n  });\\n\\n110→  group('cursor', () => {\\n    const travel = (doctor, fine) => {\\n      const S = raw({ doctor });\\n      S.activeDoc = doctor;\\n      const p = S.players[0];\\n      p.bx = 16; p.by = 120; p.x = 16; p.y = 16; p.speed = 0;\\n      const T = tune();\\n      for (let i = 0; i < 120; i++) GAME.Cursor.update(p, { aim: [1, 0], fine: !!fine }, S, 1 / 120, T);\\n      return p.bx - 16;\\n    };\\n120→    const full = travel('sokolova', false);\\n    const fineD = travel('sokolova', true);\\n    const vale = travel('vale', false);\\n    check('full stick covers 300', full >= 300, full.toFixed(1));\\n    check('fine stick stays within 120', fineD <= 120, fineD.toFixed(1));\\n    check('vale is quicker', vale > full * 1.1 && vale < full * 1.2, vale.toFixed(1) + ' vs ' + full.toFixed(1));\\n    const S = raw({ doctor: 'sokolova' });\\n    const p = S.players[0];\\n    p.tool = 'forceps';\\n    GAME.Wheel.update(p, { move: [1, -1] }, 0.05);\\n130→    check('wheel waits out a flick', p.tool === 'forceps', p.tool);\\n    GAME.Wheel.update(p, { move: [1, -1] }, 0.05);\\n    check('wheel settles by 100ms', p.tool === 'scalpel', p.tool);\\n    GAME.Wheel.update(p, { digit: 8 }, 0.016);\\n    check('digit picks at once', p.tool === 'sonar', p.tool);\\n  });\\n\\n  group('forceps', () => {\\n    const tear = raw();\\n    const shard = GAME.Sim.addObj(tear, { type: 'shard', x: 200, y: 140, depth: 40, tension: 120, axis: [1, 0], drain: 0 });\\n140→    const before = tear.objects.filter((o) => o.type === 'laceration').length;\\n    step(tear, [{ x: 200, y: 140, tool: 'forceps', trig: 1 }], 1 / 30);\\n    step(tear, [{ x: 200, y: 160, tool: 'forceps', trig: 1 }], 1 / 30);\\n    check('a sideways pull tears', (shard.tears || 0) >= 1, String(shard.tears));\\n    check('a tear leaves a laceration', tear.objects.filter((o) => o.type === 'laceration').length > before);\\n\\n    const dish = raw();\\n    const bit = GAME.Sim.addObj(dish, { type: 'shard', x: 180, y: 140, depth: 16, tension: 120, axis: [1, 0], drain: 0 });\\n    step(dish, [{ x: 180, y: 140, tool: 'forceps', trig: 1 }], 0.05);\\n    for (let x = 182; x <= 200; x += 2) step(dish, [{ x, y: 140, tool: 'forceps', trig: 1 }], 0.05);\\n150→    check('the shard comes free', !!bit.free, 'prog ' + bit.prog);\\n    step(dish, [{ x: 220, y: 140, tool: 'forceps', trig: 1 }], 0.05);\\n    step(dish, [{ x: 220, y: 140, tool: 'forceps', trig: 0 }], 0.05);\\n    check('a free shard dishes', !!bit.done, 'held ' + dish.players[0].held);\\n\\n    const snap = raw();\\n    const head = GAME.Sim.addObj(snap, { type: 'shard', x: 200, y: 140, depth: 40, tension: 120, axis: [1, 0], tag: 'legato-head', drain: 0 });\\n    step(snap, [{ x: 200, y: 140, tool: 'forceps', trig: 1 }], 1 / 30);\\n    const lac = snap.objects.filter((o) => o.type === 'laceration').length;\\n    step(snap, [{ x: 200, y: 160, tool: 'forceps', trig: 1 }], 1 / 30);\\n160→    check('a legato head snaps', !!head.snapped);\\n    check('a snap is not a cut', snap.objects.filter((o) => o.type === 'laceration').length === lac);\\n  });\\n\\n  group('scalpel and suture', () => {\\n    const slipS = raw();\\n    const cut = GAME.Sim.addObj(slipS, { type: 'cut', x: 200, y: 120, guide: [[160, 120], [280, 120]], drain: 0 });\\n    step(slipS, [{ x: 160, y: 120, tool: 'scalpel', trig: 1, mouse: true }], 1 / 60);\\n    hold(slipS, [{ x: 160, y: 142, tool: 'scalpel', trig: 1, mouse: true }], 0.2, 1 / 60);\\n    check('off the line is a slip', slipS.slips > 0, 'slips ' + slipS.slips + ' id ' + cut.id);\\n170→\\n    const ring = raw();\\n    const mass = GAME.Sim.addObj(ring, { type: 'mass', x: 213, y: 116, rad: 16, drain: 0 });\\n    const guide = mass.guide;\\n    step(ring, [{ x: guide[0][0], y: guide[0][1], tool: 'scalpel', trig: 1, mouse: true }], 1 / 60);\\n    for (const pt of guide) step(ring, [{ x: pt[0], y: pt[1], tool: 'scalpel', trig: 1, mouse: true }], 1 / 60);\\n    check('a closed ring finishes', !!mass.cut || mass.prog >= 0.98, 'prog ' + mass.prog);\\n\\n    const sew = raw();\\n    const wound = GAME.Sim.addObj(sew, { type: 'wound', x: 200, y: 130, stitches: 2, drain: 0 });\\n180→    const a = wound.pairs[0][0], b = wound.pairs[0][1];\\n    step(sew, [{ x: a[0], y: a[1], tool: 'suture', trig: 1 }], 1 / 60);\\n    hold(sew, [{ x: a[0], y: a[1], tool: 'suture', trig: 1 }], 0.2, 1 / 60);\\n    step(sew, [{ x: b[0], y: b[1], tool: 'suture', trig: 0 }], 1 / 60);\\n    check('a stitch lands on the far point', wound.stitch === 1, 'stitch ' + wound.stitch);\\n  });\\n\\n  group('salve syringe cautery suction sonar', () => {\\n    const gel = raw();\\n    const lac = GAME.Sim.addObj(gel, { type: 'laceration', x: 200, y: 120, r: 8, drain: 0 });\\n190→    for (const c of lac.cells) step(gel, [{ x: c[0], y: c[1], tool: 'salve', trig: 1 }], 1 / 30);\\n    check('salve covers the patch', !!lac.done, 'prog ' + (lac.prog || 0).toFixed(2));\\n\\n    const air = raw({ vitals: 40 });\\n    hold(air, [{ x: 40, y: 40, tool: 'syringe', trig: 1 }], 0.95, 0.05);\\n    step(air, [{ x: 40, y: 40, tool: 'syringe', trig: 0 }], 0.05);\\n    check('air in the line is sloppy', air.ev.some((e) => e[0] === 'iv' && e[2] === 'sloppy'), JSON.stringify(air.ev));\\n\\n    const reedS = raw();\\n    const reed = GAME.Sim.addObj(reedS, { type: 'reed', x: 200, y: 120, window: false, drain: 0 });\\n200→    hold(reedS, [{ x: 40, y: 40, tool: 'syringe', trig: 1 }], 0.6, 0.05);\\n    step(reedS, [{ x: reed.x, y: reed.y, tool: 'syringe', trig: 1 }], 0.05);\\n    step(reedS, [{ x: reed.x, y: reed.y, tool: 'syringe', trig: 0 }], 0.05);\\n    check('a closed reed splits', reedS.objects.some((o) => o.type === 'laceration'), 'ev ' + JSON.stringify(reedS.ev));\\n\\n    const burn = raw();\\n    hold(burn, [{ x: 40, y: 40, tool: 'cautery', trig: 1 }], 2.2, 0.05);\\n    check('the cautery locks', burn.slips > 0 && burn.ev.concat(burn.players[0].lock > 0 ? [['lock']] : []).length >= 0 && (burn.players[0].lock > 0 || burn.players[0].heat >= 1 || burn.slips > 0));\\n    check('lock was a slip', burn.players[0].slips > 0 || burn.slips > 0, 'lock ' + burn.players[0].lock);\\n\\n210→    const suck = raw();\\n    const pool = GAME.Sim.addObj(suck, { type: 'pool', x: 200, y: 140, vol: 30, max: 30, drain: 0 });\\n    hold(suck, [{ x: 200, y: 140, tool: 'suction', trig: 1 }], 0.7, 0.05);\\n    check('suction empties a pool', pool.vol <= 0.2 || pool.done, 'vol ' + pool.vol);\\n\\n    const ping = raw({ doctor: 'sokolova' });\\n    ping.activeDoc = 'sokolova';\\n    ping.gift = 'look';\\n    const hid = GAME.Sim.addObj(ping, { type: 'shard', x: 200, y: 140, hidden: true, drain: 0 });\\n    step(ping, [{ x: 200, y: 140, tool: 'sonar', trig: 1 }], 1 / 30);\\n220→    check('sonar marks a hidden shard', !!hid.marked);\\n  });\\n\\n  group('grades clock gifts', () => {\\n    const rank = GAME.Op.rankLetter;\\n    check('S', rank(1000, 1000, 'resident', 0, null) === 'S');\\n    check('A', rank(800, 1000, 'resident', 0, null) === 'A');\\n    check('B', rank(600, 1000, 'resident', 0, null) === 'B');\\n    check('C', rank(400, 1000, 'resident', 0, null) === 'C');\\n    check('D', rank(100, 1000, 'resident', 0, null) === 'D');\\n230→    check('S+', rank(1000, 1000, 'attending', 0, null) === 'S+');\\n    check('slips block S+', rank(1000, 1000, 'attending', 1, null) === 'S');\\n    check('retry caps at B', rank(1000, 1000, 'resident', 0, 'B') === 'B');\\n\\n    const again = GAME.Op.create(GAME.CASES.c1, { seed: 1, difficulty: 'resident' });\\n    again.lost = true;\\n    GAME.Op.retryPhase(again);\\n    check('retry clears the loss and caps the rank', again.rankCap === 'B' && again.lost === false);\\n\\n    const timed = raw({ clock: 0.01, vitals: 0.01, drain: 50 });\\n240→    step(timed, [{ trig: 0 }], 0.05);\\n    check('the clock fails before a crash', timed.reason === 'time' && !timed.codeBlue, timed.reason);\\n\\n    const hard = raw({ difficulty: 'attending', clock: 100, vitals: 0.2, drain: 20 });\\n    step(hard, [{ trig: 0 }], 0.1);\\n    check('attending has no Code Blue', hard.lost && hard.reason === 'vitals' && !hard.codeBlue, hard.reason);\\n\\n    const blue = raw({ clock: 100, vitals: 0.2, drain: 20 });\\n    step(blue, [{ trig: 0 }], 0.05);\\n    check('vitals open Code Blue', !!blue.codeBlue || blue.codeBlueUsed, blue.reason);\\n250→    const peaks = [0.9, 1.8, 2.7, 3.6];\\n    let pi = 0;\\n    let arm = false;\\n    for (let i = 0; i < 400 && blue.codeBlue; i++) {\\n      const want = blue.codeBlue && pi < 4 && Math.abs(blue.codeBlue.t - peaks[pi]) < 0.04;\\n      const press = want && !arm;\\n      if (want && !arm) arm = true;\\n      step(blue, [{ trig: press || (arm && want) ? 1 : 0 }], 1 / 60);\\n      if (press) { pi += 1; arm = false; }\\n    }\\n260→    check('two shocks bring the patient back', blue.vitals >= 30 && !blue.lost, 'vit ' + blue.vitals + ' ' + blue.reason + ' hits ' + pi);\\n\\n    const drop = (diff) => {\\n      const S = raw({ difficulty: diff, clock: 100, drain: 0, vitals: 80 });\\n      hold(S, [{ trig: 0 }], 1, 1 / 60);\\n      return 100 - S.clock;\\n    };\\n    const intern = drop('intern'), resident = drop('resident'), attending = drop('attending');\\n    check('intern clock is slower', intern < resident - 0.15 && intern > 0.6, intern.toFixed(3));\\n    check('attending clock is faster', attending > resident + 0.15, attending.toFixed(3));\\n270→\\n    const breath = raw({ doctor: 'vale', gift: 'breath', clock: 100, steady: 40 });\\n    breath.steady = 40;\\n    breath.gift = 'breath';\\n    breath.activeDoc = 'vale';\\n    step(breath, [{ gift: true, trig: 0 }], 1 / 60);\\n    check('Long Breath slows the field', breath.breath && breath.worldScale === 0.25, String(breath.worldScale));\\n    const p = breath.players[0];\\n    p.bx = 30; p.by = 120; p.speed = 0;\\n    const still = raw({ doctor: 'vale' });\\n280→    const q = still.players[0];\\n    q.bx = 30; q.by = 120; q.speed = 0;\\n    const T = tune();\\n    for (let i = 0; i < 60; i++) {\\n      GAME.Cursor.update(p, { aim: [1, 0] }, breath, 1 / 60, T);\\n      GAME.Cursor.update(q, { aim: [1, 0] }, still, 1 / 60, T);\\n    }\\n    check('the hand still moves in real time', Math.abs((p.bx - 30) - (q.bx - 30)) < 1.5, (p.bx - 30).toFixed(1));\\n    const c0 = breath.clock;\\n    hold(breath, [{ gift: false, trig: 0 }], 1, 1 / 60);\\n290→    const fell = c0 - breath.clock;\\n    check('the clock crawls under Long Breath', fell > 0.15 && fell < 0.4, fell.toFixed(3));\\n\\n    const look = raw({ doctor: 'sokolova', gift: 'look', clock: 200, steady: 0 });\\n    look.gift = 'look';\\n    look.activeDoc = 'sokolova';\\n    const shard = GAME.Sim.addObj(look, { type: 'shard', x: 180, y: 120, depth: 40, drain: 0 });\\n    hold(look, [{ trig: 0 }], 0.4, 0.05);\\n    look.players[0].x = 40;\\n    look.players[0].bx = 40;\\n300→    shard.x = 300;\\n    look.clock = 5;\\n    look.steady = 80;\\n    const rewound = GAME.Op.secondLook(look, tune());\\n    const back = look.objects.find((o) => o.type === 'shard');\\n    check('Second Look restores the field', rewound && back && Math.abs(back.x - 180) < 0.01 && look.clock > 100, 'x ' + (back && back.x) + ' clock ' + look.clock);\\n    check('the cursor stays put', Math.abs(look.players[0].x - 40) < 0.01, String(look.players[0].x));\\n    check('Second Look spends Steady', look.steady < 40, String(look.steady));\\n  });\\n\\n310→  group('window and strains', () => {\\n    const solo = raw({ players: 1 });\\n    GAME.Sim.addObj(solo, { type: 'retractor', x: 180, y: 140, drain: 0 });\\n    GAME.Sim.addObj(solo, { type: 'mass', x: 230, y: 140, needsWindow: true, drain: 0 });\\n    step(solo, [{ trig: 0 }], 1 / 30);\\n    check('one surgeon gets half the window', solo.windowOpen === 0.5, String(solo.windowOpen));\\n\\n    const pair = raw({ players: 2 });\\n    const ret = GAME.Sim.addObj(pair, { type: 'retractor', x: 170, y: 140, drain: 0 });\\n    const mass = GAME.Sim.addObj(pair, { type: 'mass', x: 240, y: 140, needsWindow: true, drain: 0, rad: 14 });\\n320→    step(pair, [{ trig: 0 }, { trig: 0 }], 1 / 30);\\n    check('two surgeons must hold the window', pair.windowOpen === 0, String(pair.windowOpen));\\n    const start = mass.guide[0];\\n    step(pair, [{ trig: 0 }, { x: start[0], y: start[1], tool: 'scalpel', trig: 1, mouse: true }], 1 / 30);\\n    check('a shut window refuses the scalpel', !pair.players[1].stroke);\\n    step(pair, [{ x: ret.x, y: ret.y, tool: 'forceps', trig: 1 }, { trig: 0 }], 1 / 30);\\n    step(pair, [\\n      { x: ret.x, y: ret.y, tool: 'forceps', trig: 1 },\\n      { x: start[0], y: start[1], tool: 'scalpel', trig: 1, mouse: true },\\n    ], 1 / 30);\\n330→    check('a held window lets the other hand cut', pair.windowOpen === 1 && !!pair.players[1].stroke, 'open ' + pair.windowOpen);\\n\\n    const capo = raw({ vitals: 80 });\\n    capo.cheat = { lockVitals: true };\\n    GAME.Sim.spawnStrain(capo, 'dacapo');\\n    const lobe = capo.objects.find((o) => o.type === 'lobe');\\n    lobe.done = true;\\n    step(capo, [{ trig: 0 }], 0.05);\\n    capo.strain.count = 0.02;\\n    const v0 = capo.vitals;\\n340→    step(capo, [{ trig: 0 }], 0.05);\\n    check('Da Capo regrows', capo.strain.repeated === 1 && !lobe.done && capo.vitals <= v0 - 7, 'rep ' + capo.strain.repeated + ' vit ' + capo.vitals);\\n\\n    const eyeS = raw();\\n    GAME.Sim.spawnStrain(eyeS, 'fermata');\\n    eyeS.strain.domes = [];\\n    step(eyeS, [{ trig: 0 }], 0.05);\\n    const eye = eyeS.objects.find((o) => o.type === 'eye');\\n    check('the Fermata eye opens', !!(eye && eye.open));\\n\\n350→    const cant = raw({ steady: 60, vitals: 90 });\\n    cant.steady = 60;\\n    GAME.Sim.spawnStrain(cant, 'cantor');\\n    hold(cant, [{ trig: 0 }], 0.6, 0.05);\\n    GAME.Sim.addObj(cant, { type: 'shard', x: 50, y: 50, tag: 'marker', drain: 0, depth: 80 });\\n    const steadyBefore = cant.steady;\\n    cant.strain.move = 3;\\n    cant.strain.cycleT = 20;\\n    hold(cant, [{ trig: 0 }], 3.3, 0.05);\\n    check('the Cantor rewinds the field', !cant.objects.some((o) => o.tag === 'marker'));\\n360→    check('the Cantor keeps Steady', cant.steady > steadyBefore + 0.4, cant.steady.toFixed(2) + ' vs ' + steadyBefore.toFixed(2));\\n  });\\n\\n  group('determinism and bots', () => {\\n    GAME.Dev.reset();\\n    GAME.Art.force = false;\\n    const hashRun = (force) => {\\n      GAME.Art.force = force;\\n      const S = GAME.Op.create(GAME.CASES.c1, { seed: 9, difficulty: 'resident' });\\n      const t0 = S.t;\\n370→      let guard = 0;\\n      while (S.t - t0 < 4 && !S.won && !S.lost && guard < 20000) {\\n        const inputs = [];\\n        for (let i = 0; i < S.players.length; i++) {\\n          const dev = GAME.Bot.device(S, i, 1 / 45);\\n          const p = S.players[i];\\n          GAME.Wheel.update(p, dev, 1 / 45);\\n          if (dev.mouse) GAME.Cursor.update(p, { mouse: dev.mouse, fine: dev.fine }, S, 1 / 45);\\n          inputs.push({ tool: p.tool, trig: dev.trig, fine: !!dev.fine, gift: !!dev.gift, consult: !!dev.consult, mouse: true });\\n        }\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/tests/run.mjs\",\"offset\":100,\"limit\":280,\"raw_output\":\"    const htmlPath = path.join(work, htmlName);\\n    if (fs.existsSync(htmlPath)) {\\n      const html = fs.readFileSync(htmlPath, 'utf8');\\n      check('bundle clean', !banned.test(html));\\n      check('bundle has no external script', !/<script[^>]+src=/i.test(html));\\n      check('bundle titles the game', html.includes('<title>Open Table Second Opinion</title>'));\\n      check('session.js is inlined first', html.indexOf('AI Hub Session Protocol') < html.indexOf('My3D2dge') || html.indexOf('hub:session') > 0);\\n    } else if (!fast) check('bundle exists', false, htmlName);\\n  });\\n\\n  group('cursor', () => {\\n    const travel = (doctor, fine) => {\\n      const S = raw({ doctor });\\n      S.activeDoc = doctor;\\n      const p = S.players[0];\\n      p.bx = 16; p.by = 120; p.x = 16; p.y = 16; p.speed = 0;\\n      const T = tune();\\n      for (let i = 0; i < 120; i++) GAME.Cursor.update(p, { aim: [1, 0], fine: !!fine }, S, 1 / 120, T);\\n      return p.bx - 16;\\n    };\\n    const full = travel('sokolova', false);\\n    const fineD = travel('sokolova', true);\\n    const vale = travel('vale', false);\\n    check('full stick covers 300', full >= 300, full.toFixed(1));\\n    check('fine stick stays within 120', fineD <= 120, fineD.toFixed(1));\\n    check('vale is quicker', vale > full * 1.1 && vale < full * 1.2, vale.toFixed(1) + ' vs ' + full.toFixed(1));\\n    const S = raw({ doctor: 'sokolova' });\\n    const p = S.players[0];\\n    p.tool = 'forceps';\\n    GAME.Wheel.update(p, { move: [1, -1] }, 0.05);\\n    check('wheel waits out a flick', p.tool === 'forceps', p.tool);\\n    GAME.Wheel.update(p, { move: [1, -1] }, 0.05);\\n    check('wheel settles by 100ms', p.tool === 'scalpel', p.tool);\\n    GAME.Wheel.update(p, { digit: 8 }, 0.016);\\n    check('digit picks at once', p.tool === 'sonar', p.tool);\\n  });\\n\\n  group('forceps', () => {\\n    const tear = raw();\\n    const shard = GAME.Sim.addObj(tear, { type: 'shard', x: 200, y: 140, depth: 40, tension: 120, axis: [1, 0], drain: 0 });\\n    const before = tear.objects.filter((o) => o.type === 'laceration').length;\\n    step(tear, [{ x: 200, y: 140, tool: 'forceps', trig: 1 }], 1 / 30);\\n    step(tear, [{ x: 200, y: 160, tool: 'forceps', trig: 1 }], 1 / 30);\\n    check('a sideways pull tears', (shard.tears || 0) >= 1, String(shard.tears));\\n    check('a tear leaves a laceration', tear.objects.filter((o) => o.type === 'laceration').length > before);\\n\\n    const dish = raw();\\n    const bit = GAME.Sim.addObj(dish, { type: 'shard', x: 180, y: 140, depth: 16, tension: 120, axis: [1, 0], drain: 0 });\\n    step(dish, [{ x: 180, y: 140, tool: 'forceps', trig: 1 }], 0.05);\\n    for (let x = 182; x <= 200; x += 2) step(dish, [{ x, y: 140, tool: 'forceps', trig: 1 }], 0.05);\\n    check('the shard comes free', !!bit.free, 'prog ' + bit.prog);\\n    step(dish, [{ x: 220, y: 140, tool: 'forceps', trig: 1 }], 0.05);\\n    step(dish, [{ x: 220, y: 140, tool: 'forceps', trig: 0 }], 0.05);\\n    check('a free shard dishes', !!bit.done, 'held ' + dish.players[0].held);\\n\\n    const snap = raw();\\n    const head = GAME.Sim.addObj(snap, { type: 'shard', x: 200, y: 140, depth: 40, tension: 120, axis: [1, 0], tag: 'legato-head', drain: 0 });\\n    step(snap, [{ x: 200, y: 140, tool: 'forceps', trig: 1 }], 1 / 30);\\n    const lac = snap.objects.filter((o) => o.type === 'laceration').length;\\n    step(snap, [{ x: 200, y: 160, tool: 'forceps', trig: 1 }], 1 / 30);\\n    check('a legato head snaps', !!head.snapped);\\n    check('a snap is not a cut', snap.objects.filter((o) => o.type === 'laceration').length === lac);\\n  });\\n\\n  group('scalpel and suture', () => {\\n    const slipS = raw();\\n    const cut = GAME.Sim.addObj(slipS, { type: 'cut', x: 200, y: 120, guide: [[160, 120], [280, 120]], drain: 0 });\\n    step(slipS, [{ x: 160, y: 120, tool: 'scalpel', trig: 1, mouse: true }], 1 / 60);\\n    hold(slipS, [{ x: 160, y: 142, tool: 'scalpel', trig: 1, mouse: true }], 0.2, 1 / 60);\\n    check('off the line is a slip', slipS.slips > 0, 'slips ' + slipS.slips + ' id ' + cut.id);\\n\\n    const ring = raw();\\n    const mass = GAME.Sim.addObj(ring, { type: 'mass', x: 213, y: 116, rad: 16, drain: 0 });\\n    const guide = mass.guide;\\n    step(ring, [{ x: guide[0][0], y: guide[0][1], tool: 'scalpel', trig: 1, mouse: true }], 1 / 60);\\n    for (const pt of guide) step(ring, [{ x: pt[0], y: pt[1], tool: 'scalpel', trig: 1, mouse: true }], 1 / 60);\\n    check('a closed ring finishes', !!mass.cut || mass.prog >= 0.98, 'prog ' + mass.prog);\\n\\n    const sew = raw();\\n    const wound = GAME.Sim.addObj(sew, { type: 'wound', x: 200, y: 130, stitches: 2, drain: 0 });\\n    const a = wound.pairs[0][0], b = wound.pairs[0][1];\\n    step(sew, [{ x: a[0], y: a[1], tool: 'suture', trig: 1 }], 1 / 60);\\n    hold(sew, [{ x: a[0], y: a[1], tool: 'suture', trig: 1 }], 0.2, 1 / 60);\\n    step(sew, [{ x: b[0], y: b[1], tool: 'suture', trig: 0 }], 1 / 60);\\n    check('a stitch lands on the far point', wound.stitch === 1, 'stitch ' + wound.stitch);\\n  });\\n\\n  group('salve syringe cautery suction sonar', () => {\\n    const gel = raw();\\n    const lac = GAME.Sim.addObj(gel, { type: 'laceration', x: 200, y: 120, r: 8, drain: 0 });\\n    for (const c of lac.cells) step(gel, [{ x: c[0], y: c[1], tool: 'salve', trig: 1 }], 1 / 30);\\n    check('salve covers the patch', !!lac.done, 'prog ' + (lac.prog || 0).toFixed(2));\\n\\n    const air = raw({ vitals: 40 });\\n    hold(air, [{ x: 40, y: 40, tool: 'syringe', trig: 1 }], 0.95, 0.05);\\n    step(air, [{ x: 40, y: 40, tool: 'syringe', trig: 0 }], 0.05);\\n    check('air in the line is sloppy', air.ev.some((e) => e[0] === 'iv' && e[2] === 'sloppy'), JSON.stringify(air.ev));\\n\\n    const reedS = raw();\\n    const reed = GAME.Sim.addObj(reedS, { type: 'reed', x: 200, y: 120, window: false, drain: 0 });\\n    hold(reedS, [{ x: 40, y: 40, tool: 'syringe', trig: 1 }], 0.6, 0.05);\\n    step(reedS, [{ x: reed.x, y: reed.y, tool: 'syringe', trig: 1 }], 0.05);\\n    step(reedS, [{ x: reed.x, y: reed.y, tool: 'syringe', trig: 0 }], 0.05);\\n    check('a closed reed splits', reedS.objects.some((o) => o.type === 'laceration'), 'ev ' + JSON.stringify(reedS.ev));\\n\\n    const burn = raw();\\n    hold(burn, [{ x: 40, y: 40, tool: 'cautery', trig: 1 }], 2.2, 0.05);\\n    check('the cautery locks', burn.slips > 0 && burn.ev.concat(burn.players[0].lock > 0 ? [['lock']] : []).length >= 0 && (burn.players[0].lock > 0 || burn.players[0].heat >= 1 || burn.slips > 0));\\n    check('lock was a slip', burn.players[0].slips > 0 || burn.slips > 0, 'lock ' + burn.players[0].lock);\\n\\n    const suck = raw();\\n    const pool = GAME.Sim.addObj(suck, { type: 'pool', x: 200, y: 140, vol: 30, max: 30, drain: 0 });\\n    hold(suck, [{ x: 200, y: 140, tool: 'suction', trig: 1 }], 0.7, 0.05);\\n    check('suction empties a pool', pool.vol <= 0.2 || pool.done, 'vol ' + pool.vol);\\n\\n    const ping = raw({ doctor: 'sokolova' });\\n    ping.activeDoc = 'sokolova';\\n    ping.gift = 'look';\\n    const hid = GAME.Sim.addObj(ping, { type: 'shard', x: 200, y: 140, hidden: true, drain: 0 });\\n    step(ping, [{ x: 200, y: 140, tool: 'sonar', trig: 1 }], 1 / 30);\\n    check('sonar marks a hidden shard', !!hid.marked);\\n  });\\n\\n  group('grades clock gifts', () => {\\n    const rank = GAME.Op.rankLetter;\\n    check('S', rank(1000, 1000, 'resident', 0, null) === 'S');\\n    check('A', rank(800, 1000, 'resident', 0, null) === 'A');\\n    check('B', rank(600, 1000, 'resident', 0, null) === 'B');\\n    check('C', rank(400, 1000, 'resident', 0, null) === 'C');\\n    check('D', rank(100, 1000, 'resident', 0, null) === 'D');\\n    check('S+', rank(1000, 1000, 'attending', 0, null) === 'S+');\\n    check('slips block S+', rank(1000, 1000, 'attending', 1, null) === 'S');\\n    check('retry caps at B', rank(1000, 1000, 'resident', 0, 'B') === 'B');\\n\\n    const again = GAME.Op.create(GAME.CASES.c1, { seed: 1, difficulty: 'resident' });\\n    again.lost = true;\\n    GAME.Op.retryPhase(again);\\n    check('retry clears the loss and caps the rank', again.rankCap === 'B' && again.lost === false);\\n\\n    const timed = raw({ clock: 0.01, vitals: 0.01, drain: 50 });\\n    step(timed, [{ trig: 0 }], 0.05);\\n    check('the clock fails before a crash', timed.reason === 'time' && !timed.codeBlue, timed.reason);\\n\\n    const hard = raw({ difficulty: 'attending', clock: 100, vitals: 0.2, drain: 20 });\\n    step(hard, [{ trig: 0 }], 0.1);\\n    check('attending has no Code Blue', hard.lost && hard.reason === 'vitals' && !hard.codeBlue, hard.reason);\\n\\n    const blue = raw({ clock: 100, vitals: 0.2, drain: 20 });\\n    step(blue, [{ trig: 0 }], 0.05);\\n    check('vitals open Code Blue', !!blue.codeBlue || blue.codeBlueUsed, blue.reason);\\n    const peaks = [0.9, 1.8, 2.7, 3.6];\\n    let pi = 0;\\n    let arm = false;\\n    for (let i = 0; i < 400 && blue.codeBlue; i++) {\\n      const want = blue.codeBlue && pi < 4 && Math.abs(blue.codeBlue.t - peaks[pi]) < 0.04;\\n      const press = want && !arm;\\n      if (want && !arm) arm = true;\\n      step(blue, [{ trig: press || (arm && want) ? 1 : 0 }], 1 / 60);\\n      if (press) { pi += 1; arm = false; }\\n    }\\n    check('two shocks bring the patient back', blue.vitals >= 30 && !blue.lost, 'vit ' + blue.vitals + ' ' + blue.reason + ' hits ' + pi);\\n\\n    const drop = (diff) => {\\n      const S = raw({ difficulty: diff, clock: 100, drain: 0, vitals: 80 });\\n      hold(S, [{ trig: 0 }], 1, 1 / 60);\\n      return 100 - S.clock;\\n    };\\n    const intern = drop('intern'), resident = drop('resident'), attending = drop('attending');\\n    check('intern clock is slower', intern < resident - 0.15 && intern > 0.6, intern.toFixed(3));\\n    check('attending clock is faster', attending > resident + 0.15, attending.toFixed(3));\\n\\n    const breath = raw({ doctor: 'vale', gift: 'breath', clock: 100, steady: 40 });\\n    breath.steady = 40;\\n    breath.gift = 'breath';\\n    breath.activeDoc = 'vale';\\n    step(breath, [{ gift: true, trig: 0 }], 1 / 60);\\n    check('Long Breath slows the field', breath.breath && breath.worldScale === 0.25, String(breath.worldScale));\\n    const p = breath.players[0];\\n    p.bx = 30; p.by = 120; p.speed = 0;\\n    const still = raw({ doctor: 'vale' });\\n    const q = still.players[0];\\n    q.bx = 30; q.by = 120; q.speed = 0;\\n    const T = tune();\\n    for (let i = 0; i < 60; i++) {\\n      GAME.Cursor.update(p, { aim: [1, 0] }, breath, 1 / 60, T);\\n      GAME.Cursor.update(q, { aim: [1, 0] }, still, 1 / 60, T);\\n    }\\n    check('the hand still moves in real time', Math.abs((p.bx - 30) - (q.bx - 30)) < 1.5, (p.bx - 30).toFixed(1));\\n    const c0 = breath.clock;\\n    hold(breath, [{ gift: false, trig: 0 }], 1, 1 / 60);\\n    const fell = c0 - breath.clock;\\n    check('the clock crawls under Long Breath', fell > 0.15 && fell < 0.4, fell.toFixed(3));\\n\\n    const look = raw({ doctor: 'sokolova', gift: 'look', clock: 200, steady: 0 });\\n    look.gift = 'look';\\n    look.activeDoc = 'sokolova';\\n    const shard = GAME.Sim.addObj(look, { type: 'shard', x: 180, y: 120, depth: 40, drain: 0 });\\n    hold(look, [{ trig: 0 }], 0.4, 0.05);\\n    look.players[0].x = 40;\\n    look.players[0].bx = 40;\\n    shard.x = 300;\\n    look.clock = 5;\\n    look.steady = 80;\\n    const rewound = GAME.Op.secondLook(look, tune());\\n    const back = look.objects.find((o) => o.type === 'shard');\\n    check('Second Look restores the field', rewound && back && Math.abs(back.x - 180) < 0.01 && look.clock > 100, 'x ' + (back && back.x) + ' clock ' + look.clock);\\n    check('the cursor stays put', Math.abs(look.players[0].x - 40) < 0.01, String(look.players[0].x));\\n    check('Second Look spends Steady', look.steady < 40, String(look.steady));\\n  });\\n\\n  group('window and strains', () => {\\n    const solo = raw({ players: 1 });\\n    GAME.Sim.addObj(solo, { type: 'retractor', x: 180, y: 140, drain: 0 });\\n    GAME.Sim.addObj(solo, { type: 'mass', x: 230, y: 140, needsWindow: true, drain: 0 });\\n    step(solo, [{ trig: 0 }], 1 / 30);\\n    check('one surgeon gets half the window', solo.windowOpen === 0.5, String(solo.windowOpen));\\n\\n    const pair = raw({ players: 2 });\\n    const ret = GAME.Sim.addObj(pair, { type: 'retractor', x: 170, y: 140, drain: 0 });\\n    const mass = GAME.Sim.addObj(pair, { type: 'mass', x: 240, y: 140, needsWindow: true, drain: 0, rad: 14 });\\n    step(pair, [{ trig: 0 }, { trig: 0 }], 1 / 30);\\n    check('two surgeons must hold the window', pair.windowOpen === 0, String(pair.windowOpen));\\n    const start = mass.guide[0];\\n    step(pair, [{ trig: 0 }, { x: start[0], y: start[1], tool: 'scalpel', trig: 1, mouse: true }], 1 / 30);\\n    check('a shut window refuses the scalpel', !pair.players[1].stroke);\\n    step(pair, [{ x: ret.x, y: ret.y, tool: 'forceps', trig: 1 }, { trig: 0 }], 1 / 30);\\n    step(pair, [\\n      { x: ret.x, y: ret.y, tool: 'forceps', trig: 1 },\\n      { x: start[0], y: start[1], tool: 'scalpel', trig: 1, mouse: true },\\n    ], 1 / 30);\\n    check('a held window lets the other hand cut', pair.windowOpen === 1 && !!pair.players[1].stroke, 'open ' + pair.windowOpen);\\n\\n    const capo = raw({ vitals: 80 });\\n    capo.cheat = { lockVitals: true };\\n    GAME.Sim.spawnStrain(capo, 'dacapo');\\n    const lobe = capo.objects.find((o) => o.type === 'lobe');\\n    lobe.done = true;\\n    step(capo, [{ trig: 0 }], 0.05);\\n    capo.strain.count = 0.02;\\n    const v0 = capo.vitals;\\n    step(capo, [{ trig: 0 }], 0.05);\\n    check('Da Capo regrows', capo.strain.repeated === 1 && !lobe.done && capo.vitals <= v0 - 7, 'rep ' + capo.strain.repeated + ' vit ' + capo.vitals);\\n\\n    const eyeS = raw();\\n    GAME.Sim.spawnStrain(eyeS, 'fermata');\\n    eyeS.strain.domes = [];\\n    step(eyeS, [{ trig: 0 }], 0.05);\\n    const eye = eyeS.objects.find((o) => o.type === 'eye');\\n    check('the Fermata eye opens', !!(eye && eye.open));\\n\\n    const cant = raw({ steady: 60, vitals: 90 });\\n    cant.steady = 60;\\n    GAME.Sim.spawnStrain(cant, 'cantor');\\n    hold(cant, [{ trig: 0 }], 0.6, 0.05);\\n    GAME.Sim.addObj(cant, { type: 'shard', x: 50, y: 50, tag: 'marker', drain: 0, depth: 80 });\\n    const steadyBefore = cant.steady;\\n    cant.strain.move = 3;\\n    cant.strain.cycleT = 20;\\n    hold(cant, [{ trig: 0 }], 3.3, 0.05);\\n    check('the Cantor rewinds the field', !cant.objects.some((o) => o.tag === 'marker'));\\n    check('the Cantor keeps Steady', cant.steady > steadyBefore + 0.4, cant.steady.toFixed(2) + ' vs ' + steadyBefore.toFixed(2));\\n  });\\n\\n  group('determinism and bots', () => {\\n    GAME.Dev.reset();\\n    GAME.Art.force = false;\\n    const hashRun = (force) => {\\n      GAME.Art.force = force;\\n      const S = GAME.Op.create(GAME.CASES.c1, { seed: 9, difficulty: 'resident' });\\n      const t0 = S.t;\\n      let guard = 0;\\n      while (S.t - t0 < 4 && !S.won && !S.lost && guard < 20000) {\\n        const inputs = [];\\n        for (let i = 0; i < S.players.length; i++) {\\n          const dev = GAME.Bot.device(S, i, 1 / 45);\\n          const p = S.players[i];\\n          GAME.Wheel.update(p, dev, 1 / 45);\\n          if (dev.mouse) GAME.Cursor.update(p, { mouse: dev.mouse, fine: dev.fine }, S, 1 / 45);\\n          inputs.push({ tool: p.tool, trig: dev.trig, fine: !!dev.fine, gift: !!dev.gift, consult: !!dev.consult, mouse: true });\\n        }\\n\",\"total_lines\":810}}","is_error":false},{"type":"tool_result","tool_use_id":"call-8af2d28e-ff32-468f-92c9-cb558f4330ab-28","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1580→    }\\n    if (ch.infSteady) S.steady = 100;\\n    if (!frozen) {\\n      let hazard = 0;\\n      for (const o of S.objects) {\\n        if (o.done || !o.drain) continue;\\n        if (inDome(S, o.x, o.y)) continue;\\n        hazard += o.drain;\\n      }\\n      const bleed = hazard * tune.fluids.bleed * tune.strains.damage;\\n1590→      if (!ch.lockVitals) S.vitals -= (S.drain * tune.patient.drain * diffDrain(S) + bleed) * worldDt;\\n      if (!ch.freezeClock) S.clock -= worldDt * tune.patient.clock / diffClock(S);\\n      S.steady = Math.min(100, S.steady + 0.5 * tune.gift.charge * worldDt);\\n      if (ch.infSteady) S.steady = 100;\\n    }\\n    S.t += dt;\\n    S.worldT += frozen ? 0 : worldDt;\\n    S.phaseT += frozen ? 0 : worldDt;\\n\\n    const handDt = (S.cheat && S.cheat.oneHit) ? dt * 40 : dt;\\n1600→    for (const p of S.players) applyTools(S, p, handDt, tune);\\n    if (!frozen) {\\n      stepWorld(S, worldDt, dt, tune);\\n      stepStrain(S, worldDt, dt, tune);\\n    }\\n    if (S.ghostT > 0) S.ghostT -= dt;\\n\\n    if (!frozen) {\\n      S.ringAcc += worldDt;\\n      while (S.ringAcc >= 0.1) { S.ringAcc -= 0.1; pushRing(S); }\\n1610→    }\\n\\n    maybeDie(S);\\n    if (!S.lost && !S.won && !S.codeBlue && phaseClear(S)) advancePhase(S);\\n    return S;\\n  }\\n\\n  /* ---------- cursor and wheel ---------- */\\n\\n  function assistOf(S, tune) {\\n1620→    let a = tune.hands.assist;\\n    if (S && S.diff === 'intern') a += 0.2;\\n    if (S && (S.activeDoc === 'sokolova')) a += 0.2;\\n    return clamp(a, 0, 1.4);\\n  }\\n\\n  function jitterOf(S, p) {\\n    const st = S && S.strain;\\n    if (!st || !st.jitter || (S && S.breath)) return [0, 0];\\n    const amp = 5 * (st.amp == null ? 1 : st.amp) * (p.fine ? 0.35 : 1);\",\"content_concise\":\"1580→    }\\n    if (ch.infSteady) S.steady = 100;\\n    if (!frozen) {\\n      let hazard = 0;\\n      for (const o of S.objects) {\\n        if (o.done || !o.drain) continue;\\n        if (inDome(S, o.x, o.y)) continue;\\n        hazard += o.drain;\\n      }\\n      const bleed = hazard * tune.fluids.bleed * tune.strains.damage;\\n1590→      if (!ch.lockVitals) S.vitals -= (S.drain * tune.patient.drain * diffDrain(S) + bleed) * worldDt;\\n      if (!ch.freezeClock) S.clock -= worldDt * tune.patient.clock / diffClock(S);\\n      S.steady = Math.min(100, S.steady + 0.5 * tune.gift.charge * worldDt);\\n      if (ch.infSteady) S.steady = 100;\\n    }\\n    S.t += dt;\\n    S.worldT += frozen ? 0 : worldDt;\\n    S.phaseT += frozen ? 0 : worldDt;\\n\\n    const handDt = (S.cheat && S.cheat.oneHit) ? dt * 40 : dt;\\n1600→    for (const p of S.players) applyTools(S, p, handDt, tune);\\n    if (!frozen) {\\n      stepWorld(S, worldDt, dt, tune);\\n      stepStrain(S, worldDt, dt, tune);\\n    }\\n    if (S.ghostT > 0) S.ghostT -= dt;\\n\\n    if (!frozen) {\\n      S.ringAcc += worldDt;\\n      while (S.ringAcc >= 0.1) { S.ringAcc -= 0.1; pushRing(S); }\\n1610→    }\\n\\n    maybeDie(S);\\n    if (!S.lost && !S.won && !S.codeBlue && phaseClear(S)) advancePhase(S);\\n    return S;\\n  }\\n\\n  /* ---------- cursor and wheel ---------- */\\n\\n  function assistOf(S, tune) {\\n1620→    let a = tune.hands.assist;\\n    if (S && S.diff === 'intern') a += 0.2;\\n    if (S && (S.activeDoc === 'sokolova')) a += 0.2;\\n    return clamp(a, 0, 1.4);\\n  }\\n\\n  function jitterOf(S, p) {\\n    const st = S && S.strain;\\n    if (!st || !st.jitter || (S && S.breath)) return [0, 0];\\n    const amp = 5 * (st.amp == null ? 1 : st.amp) * (p.fine ? 0.35 : 1);\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/core/sim.js\",\"offset\":1580,\"limit\":50,\"raw_output\":\"    }\\n    if (ch.infSteady) S.steady = 100;\\n    if (!frozen) {\\n      let hazard = 0;\\n      for (const o of S.objects) {\\n        if (o.done || !o.drain) continue;\\n        if (inDome(S, o.x, o.y)) continue;\\n        hazard += o.drain;\\n      }\\n      const bleed = hazard * tune.fluids.bleed * tune.strains.damage;\\n      if (!ch.lockVitals) S.vitals -= (S.drain * tune.patient.drain * diffDrain(S) + bleed) * worldDt;\\n      if (!ch.freezeClock) S.clock -= worldDt * tune.patient.clock / diffClock(S);\\n      S.steady = Math.min(100, S.steady + 0.5 * tune.gift.charge * worldDt);\\n      if (ch.infSteady) S.steady = 100;\\n    }\\n    S.t += dt;\\n    S.worldT += frozen ? 0 : worldDt;\\n    S.phaseT += frozen ? 0 : worldDt;\\n\\n    const handDt = (S.cheat && S.cheat.oneHit) ? dt * 40 : dt;\\n    for (const p of S.players) applyTools(S, p, handDt, tune);\\n    if (!frozen) {\\n      stepWorld(S, worldDt, dt, tune);\\n      stepStrain(S, worldDt, dt, tune);\\n    }\\n    if (S.ghostT > 0) S.ghostT -= dt;\\n\\n    if (!frozen) {\\n      S.ringAcc += worldDt;\\n      while (S.ringAcc >= 0.1) { S.ringAcc -= 0.1; pushRing(S); }\\n    }\\n\\n    maybeDie(S);\\n    if (!S.lost && !S.won && !S.codeBlue && phaseClear(S)) advancePhase(S);\\n    return S;\\n  }\\n\\n  /* ---------- cursor and wheel ---------- */\\n\\n  function assistOf(S, tune) {\\n    let a = tune.hands.assist;\\n    if (S && S.diff === 'intern') a += 0.2;\\n    if (S && (S.activeDoc === 'sokolova')) a += 0.2;\\n    return clamp(a, 0, 1.4);\\n  }\\n\\n  function jitterOf(S, p) {\\n    const st = S && S.strain;\\n    if (!st || !st.jitter || (S && S.breath)) return [0, 0];\\n    const amp = 5 * (st.amp == null ? 1 : st.amp) * (p.fine ? 0.35 : 1);\\n\",\"total_lines\":1767}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"1715298c-6e01-4b0e-aa11-43c87fb7da7d"}
{"type":"assistant","message":{"id":"msg_397","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"A potential bug was noticed in the intern clock.\n\nThe intern clock drain is divided by 1.3, making the clock last 1.3 times longer. This matches the \"clock x1.3\" wording. The deviation says this slows the drain without multiplying the starting clock. Tests verify that less clock is lost.","signature":""},{"type":"tool_use","id":"call-4cf49c5a-d0ab-438d-9af2-b75ad31988a9-29","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/core/sim.js","offset":299,"limit":110}},{"type":"tool_use","id":"call-4cf49c5a-d0ab-438d-9af2-b75ad31988a9-30","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/core/sim.js","offset":399,"limit":420}},{"type":"tool_use","id":"call-4cf49c5a-d0ab-438d-9af2-b75ad31988a9-31","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/core/sim.js","offset":830,"limit":480}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":6644,"output_tokens":2259,"cache_read_input_tokens":73728,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"f10348b6-1a1d-40cc-b883-316f5d8ec565"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-4cf49c5a-d0ab-438d-9af2-b75ad31988a9-29","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"299→  function restoreCore(S, core, keepHands) {\\n300→    const hands = S.players.map(p => ({ id: p.id, x: p.x, y: p.y, bx: p.bx, by: p.by, color: p.color }));\\n    applyCore(S, core);\\n    for (let i = 0; i < S.players.length; i++) {\\n      const p = S.players[i];\\n      p.held = 0; p.stroke = null; p.fill = 0; p.over = 0; p.trig = 0; p.prevTrig = 0;\\n      if (keepHands && hands[i]) {\\n        p.x = hands[i].x; p.y = hands[i].y; p.bx = hands[i].bx; p.by = hands[i].by;\\n      }\\n    }\\n  }\\n310→\\n  function secondLook(S, tune) {\\n    if (S.mode === 'rounds') return false;\\n    if (S.gift !== 'look' && S.gift !== 'both' && S.activeDoc !== 'sokolova' && S.gift !== 'look') {\\n      if (!(S.gift === 'both' || S.activeDoc === 'sokolova' || S.gift === 'look')) return false;\\n    }\\n    const can = S.gift === 'look' || S.gift === 'both' || S.activeDoc === 'sokolova';\\n    if (!can) return false;\\n    if (S.steady < 45) return false;\\n    if (!S.ring.length) return false;\\n320→    const target = S.worldT - (tune.gift.lookSeconds || 6);\\n    let pick = S.ring[0];\\n    for (let i = 0; i < S.ring.length; i++) if (S.ring[i].t <= target) pick = S.ring[i];\\n    const ghosts = [];\\n    for (let i = 0; i < S.ring.length; i++) {\\n      if (S.ring[i].t + 1e-6 < pick.t) continue;\\n      ghosts.push({ t: S.ring[i].t - pick.t, cursors: S.ring[i].cursors, strains: S.ring[i].strains });\\n    }\\n    restoreCore(S, pick.core, true);\\n    S.steady = Math.max(0, S.steady - 45);\\n330→    S.ghosts = ghosts;\\n    S.ghostT = tune.gift.lookSeconds || 6;\\n    S.breath = false;\\n    S.worldScale = 1;\\n    pushEv(S, ['rewind', ghosts.length]);\\n    return true;\\n  }\\n\\n  function forceRewind(S, keepSteady) {\\n    const steady = S.steady;\\n340→    const breath = S.breath;\\n    if (!S.ring.length) return false;\\n    const target = S.worldT - 6;\\n    let pick = S.ring[0];\\n    for (let i = 0; i < S.ring.length; i++) if (S.ring[i].t <= target) pick = S.ring[i];\\n    restoreCore(S, pick.core, true);\\n    if (keepSteady) S.steady = steady;\\n    S.breath = breath;\\n    S.worldScale = breath ? 0.25 : 1;\\n    pushEv(S, ['forced', 1]);\\n350→    return true;\\n  }\\n\\n  /* ---------- tools ---------- */\\n\\n  function polyDist(pts, x, y) {\\n    let best = 1e9, arcAt = 0, along = 0, total = 0;\\n    const acc = [0];\\n    for (let i = 1; i < pts.length; i++) acc.push(acc[i - 1] + hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));\\n    total = acc[acc.length - 1] || 1;\\n360→    for (let i = 1; i < pts.length; i++) {\\n      const ax = pts[i - 1][0], ay = pts[i - 1][1], bx = pts[i][0], by = pts[i][1];\\n      const vx = bx - ax, vy = by - ay, L = hypot(vx, vy) || 1;\\n      let t = ((x - ax) * vx + (y - ay) * vy) / (L * L);\\n      t = clamp(t, 0, 1);\\n      const px = ax + vx * t, py = ay + vy * t;\\n      const d = hypot(x - px, y - py);\\n      if (d < best) { best = d; along = acc[i - 1] + t * L; }\\n    }\\n    return { d: best, along, total, tan: tangent(pts, along) };\\n370→  }\\n  function tangent(pts, along) {\\n    let left = along;\\n    for (let i = 1; i < pts.length; i++) {\\n      const L = hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]) || 1;\\n      if (left <= L || i === pts.length - 1) {\\n        return [(pts[i][0] - pts[i - 1][0]) / L, (pts[i][1] - pts[i - 1][1]) / L];\\n      }\\n      left -= L;\\n    }\\n380→    return [1, 0];\\n  }\\n\\n  function nerveHit(S, p, tune) {\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n      if (o.type !== 'nerve' && o.type !== 'eloquent') continue;\\n      const pts = o.guide || [[o.x - 20, o.y], [o.x + 20, o.y]];\\n      if (polyDist(pts, p.x, p.y).d < 6) { slip(S, p, 'nerve', 12, tune); return true; }\\n    }\\n390→    return false;\\n  }\\n\\n  function gradeMean(mean, a, b) {\\n    if (mean <= a) return 'textbook';\\n    if (mean <= b) return 'clean';\\n    return 'sloppy';\\n  }\\n\\n  function stepForceps(S, p, dt, tune) {\\n400→    const down = p.trig > 0.3;\\n    let held = p.held ? objById(S, p.held) : null;\\n    if (p.trigEdge && !held) {\\n      const o = nearest(S, p, 12, o => canTouch(S, o) && (o.type === 'shard' || o.type === 'fragment' || o.type === 'cork' || o.type === 'hook' || o.type === 'gaff' || o.type === 'clot' || o.type === 'mass' || o.type === 'nest' || o.type === 'note' || o.type === 'retractor' || o.type === 'screw' || (o.type === 'lobe' && o.mode === 'forceps')));\\n      if (o && o.type === 'clot' && !o.dosed) { /* no grip yet */ }\\n      else if (o && (o.type === 'hook' || o.type === 'gaff') && o.barbs) { slip(S, p, 'tear', 4, tune); o.tears = (o.tears || 0) + 1; }\\n      else if (o && o.type === 'mass' && !o.cut) { /* ring first */ }\\n      else if (o && o.type === 'nest' && !o.cut) { /* slash first */ }\\n      else if (o && o.type === 'screw') { p.held = o.id; o.lastAng = Math.atan2(p.y - o.y, p.x - o.x); o.spin = o.spin || 0; }\",\"content_concise\":\"299→  function restoreCore(S, core, keepHands) {\\n300→    const hands = S.players.map(p => ({ id: p.id, x: p.x, y: p.y, bx: p.bx, by: p.by, color: p.color }));\\n    applyCore(S, core);\\n    for (let i = 0; i < S.players.length; i++) {\\n      const p = S.players[i];\\n      p.held = 0; p.stroke = null; p.fill = 0; p.over = 0; p.trig = 0; p.prevTrig = 0;\\n      if (keepHands && hands[i]) {\\n        p.x = hands[i].x; p.y = hands[i].y; p.bx = hands[i].bx; p.by = hands[i].by;\\n      }\\n    }\\n  }\\n310→\\n  function secondLook(S, tune) {\\n    if (S.mode === 'rounds') return false;\\n    if (S.gift !== 'look' && S.gift !== 'both' && S.activeDoc !== 'sokolova' && S.gift !== 'look') {\\n      if (!(S.gift === 'both' || S.activeDoc === 'sokolova' || S.gift === 'look')) return false;\\n    }\\n    const can = S.gift === 'look' || S.gift === 'both' || S.activeDoc === 'sokolova';\\n    if (!can) return false;\\n    if (S.steady < 45) return false;\\n    if (!S.ring.length) return false;\\n320→    const target = S.worldT - (tune.gift.lookSeconds || 6);\\n    let pick = S.ring[0];\\n    for (let i = 0; i < S.ring.length; i++) if (S.ring[i].t <= target) pick = S.ring[i];\\n    const ghosts = [];\\n    for (let i = 0; i < S.ring.length; i++) {\\n      if (S.ring[i].t + 1e-6 < pick.t) continue;\\n      ghosts.push({ t: S.ring[i].t - pick.t, cursors: S.ring[i].cursors, strains: S.ring[i].strains });\\n    }\\n    restoreCore(S, pick.core, true);\\n    S.steady = Math.max(0, S.steady - 45);\\n330→    S.ghosts = ghosts;\\n    S.ghostT = tune.gift.lookSeconds || 6;\\n    S.breath = false;\\n    S.worldScale = 1;\\n    pushEv(S, ['rewind', ghosts.length]);\\n    return true;\\n  }\\n\\n  function forceRewind(S, keepSteady) {\\n    const steady = S.steady;\\n340→    const breath = S.breath;\\n    if (!S.ring.length) return false;\\n    const target = S.worldT - 6;\\n    let pick = S.ring[0];\\n    for (let i = 0; i < S.ring.length; i++) if (S.ring[i].t <= target) pick = S.ring[i];\\n    restoreCore(S, pick.core, true);\\n    if (keepSteady) S.steady = steady;\\n    S.breath = breath;\\n    S.worldScale = breath ? 0.25 : 1;\\n    pushEv(S, ['forced', 1]);\\n350→    return true;\\n  }\\n\\n  /* ---------- tools ---------- */\\n\\n  function polyDist(pts, x, y) {\\n    let best = 1e9, arcAt = 0, along = 0, total = 0;\\n    const acc = [0];\\n    for (let i = 1; i < pts.length; i++) acc.push(acc[i - 1] + hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));\\n    total = acc[acc.length - 1] || 1;\\n360→    for (let i = 1; i < pts.length; i++) {\\n      const ax = pts[i - 1][0], ay = pts[i - 1][1], bx = pts[i][0], by = pts[i][1];\\n      const vx = bx - ax, vy = by - ay, L = hypot(vx, vy) || 1;\\n      let t = ((x - ax) * vx + (y - ay) * vy) / (L * L);\\n      t = clamp(t, 0, 1);\\n      const px = ax + vx * t, py = ay + vy * t;\\n      const d = hypot(x - px, y - py);\\n      if (d < best) { best = d; along = acc[i - 1] + t * L; }\\n    }\\n    return { d: best, along, total, tan: tangent(pts, along) };\\n370→  }\\n  function tangent(pts, along) {\\n    let left = along;\\n    for (let i = 1; i < pts.length; i++) {\\n      const L = hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]) || 1;\\n      if (left <= L || i === pts.length - 1) {\\n        return [(pts[i][0] - pts[i - 1][0]) / L, (pts[i][1] - pts[i - 1][1]) / L];\\n      }\\n      left -= L;\\n    }\\n380→    return [1, 0];\\n  }\\n\\n  function nerveHit(S, p, tune) {\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n      if (o.type !== 'nerve' && o.type !== 'eloquent') continue;\\n      const pts = o.guide || [[o.x - 20, o.y], [o.x + 20, o.y]];\\n      if (polyDist(pts, p.x, p.y).d < 6) { slip(S, p, 'nerve', 12, tune); return true; }\\n    }\\n390→    return false;\\n  }\\n\\n  function gradeMean(mean, a, b) {\\n    if (mean <= a) return 'textbook';\\n    if (mean <= b) return 'clean';\\n    return 'sloppy';\\n  }\\n\\n  function stepForceps(S, p, dt, tune) {\\n400→    const down = p.trig > 0.3;\\n    let held = p.held ? objById(S, p.held) : null;\\n    if (p.trigEdge && !held) {\\n      const o = nearest(S, p, 12, o => canTouch(S, o) && (o.type === 'shard' || o.type === 'fragment' || o.type === 'cork' || o.type === 'hook' || o.type === 'gaff' || o.type === 'clot' || o.type === 'mass' || o.type === 'nest' || o.type === 'note' || o.type === 'retractor' || o.type === 'screw' || (o.type === 'lobe' && o.mode === 'forceps')));\\n      if (o && o.type === 'clot' && !o.dosed) { /* no grip yet */ }\\n      else if (o && (o.type === 'hook' || o.type === 'gaff') && o.barbs) { slip(S, p, 'tear', 4, tune); o.tears = (o.tears || 0) + 1; }\\n      else if (o && o.type === 'mass' && !o.cut) { /* ring first */ }\\n      else if (o && o.type === 'nest' && !o.cut) { /* slash first */ }\\n      else if (o && o.type === 'screw') { p.held = o.id; o.lastAng = Math.atan2(p.y - o.y, p.x - o.x); o.spin = o.spin || 0; }\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/core/sim.js\",\"offset\":299,\"limit\":110,\"raw_output\":\"  function restoreCore(S, core, keepHands) {\\n    const hands = S.players.map(p => ({ id: p.id, x: p.x, y: p.y, bx: p.bx, by: p.by, color: p.color }));\\n    applyCore(S, core);\\n    for (let i = 0; i < S.players.length; i++) {\\n      const p = S.players[i];\\n      p.held = 0; p.stroke = null; p.fill = 0; p.over = 0; p.trig = 0; p.prevTrig = 0;\\n      if (keepHands && hands[i]) {\\n        p.x = hands[i].x; p.y = hands[i].y; p.bx = hands[i].bx; p.by = hands[i].by;\\n      }\\n    }\\n  }\\n\\n  function secondLook(S, tune) {\\n    if (S.mode === 'rounds') return false;\\n    if (S.gift !== 'look' && S.gift !== 'both' && S.activeDoc !== 'sokolova' && S.gift !== 'look') {\\n      if (!(S.gift === 'both' || S.activeDoc === 'sokolova' || S.gift === 'look')) return false;\\n    }\\n    const can = S.gift === 'look' || S.gift === 'both' || S.activeDoc === 'sokolova';\\n    if (!can) return false;\\n    if (S.steady < 45) return false;\\n    if (!S.ring.length) return false;\\n    const target = S.worldT - (tune.gift.lookSeconds || 6);\\n    let pick = S.ring[0];\\n    for (let i = 0; i < S.ring.length; i++) if (S.ring[i].t <= target) pick = S.ring[i];\\n    const ghosts = [];\\n    for (let i = 0; i < S.ring.length; i++) {\\n      if (S.ring[i].t + 1e-6 < pick.t) continue;\\n      ghosts.push({ t: S.ring[i].t - pick.t, cursors: S.ring[i].cursors, strains: S.ring[i].strains });\\n    }\\n    restoreCore(S, pick.core, true);\\n    S.steady = Math.max(0, S.steady - 45);\\n    S.ghosts = ghosts;\\n    S.ghostT = tune.gift.lookSeconds || 6;\\n    S.breath = false;\\n    S.worldScale = 1;\\n    pushEv(S, ['rewind', ghosts.length]);\\n    return true;\\n  }\\n\\n  function forceRewind(S, keepSteady) {\\n    const steady = S.steady;\\n    const breath = S.breath;\\n    if (!S.ring.length) return false;\\n    const target = S.worldT - 6;\\n    let pick = S.ring[0];\\n    for (let i = 0; i < S.ring.length; i++) if (S.ring[i].t <= target) pick = S.ring[i];\\n    restoreCore(S, pick.core, true);\\n    if (keepSteady) S.steady = steady;\\n    S.breath = breath;\\n    S.worldScale = breath ? 0.25 : 1;\\n    pushEv(S, ['forced', 1]);\\n    return true;\\n  }\\n\\n  /* ---------- tools ---------- */\\n\\n  function polyDist(pts, x, y) {\\n    let best = 1e9, arcAt = 0, along = 0, total = 0;\\n    const acc = [0];\\n    for (let i = 1; i < pts.length; i++) acc.push(acc[i - 1] + hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));\\n    total = acc[acc.length - 1] || 1;\\n    for (let i = 1; i < pts.length; i++) {\\n      const ax = pts[i - 1][0], ay = pts[i - 1][1], bx = pts[i][0], by = pts[i][1];\\n      const vx = bx - ax, vy = by - ay, L = hypot(vx, vy) || 1;\\n      let t = ((x - ax) * vx + (y - ay) * vy) / (L * L);\\n      t = clamp(t, 0, 1);\\n      const px = ax + vx * t, py = ay + vy * t;\\n      const d = hypot(x - px, y - py);\\n      if (d < best) { best = d; along = acc[i - 1] + t * L; }\\n    }\\n    return { d: best, along, total, tan: tangent(pts, along) };\\n  }\\n  function tangent(pts, along) {\\n    let left = along;\\n    for (let i = 1; i < pts.length; i++) {\\n      const L = hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]) || 1;\\n      if (left <= L || i === pts.length - 1) {\\n        return [(pts[i][0] - pts[i - 1][0]) / L, (pts[i][1] - pts[i - 1][1]) / L];\\n      }\\n      left -= L;\\n    }\\n    return [1, 0];\\n  }\\n\\n  function nerveHit(S, p, tune) {\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n      if (o.type !== 'nerve' && o.type !== 'eloquent') continue;\\n      const pts = o.guide || [[o.x - 20, o.y], [o.x + 20, o.y]];\\n      if (polyDist(pts, p.x, p.y).d < 6) { slip(S, p, 'nerve', 12, tune); return true; }\\n    }\\n    return false;\\n  }\\n\\n  function gradeMean(mean, a, b) {\\n    if (mean <= a) return 'textbook';\\n    if (mean <= b) return 'clean';\\n    return 'sloppy';\\n  }\\n\\n  function stepForceps(S, p, dt, tune) {\\n    const down = p.trig > 0.3;\\n    let held = p.held ? objById(S, p.held) : null;\\n    if (p.trigEdge && !held) {\\n      const o = nearest(S, p, 12, o => canTouch(S, o) && (o.type === 'shard' || o.type === 'fragment' || o.type === 'cork' || o.type === 'hook' || o.type === 'gaff' || o.type === 'clot' || o.type === 'mass' || o.type === 'nest' || o.type === 'note' || o.type === 'retractor' || o.type === 'screw' || (o.type === 'lobe' && o.mode === 'forceps')));\\n      if (o && o.type === 'clot' && !o.dosed) { /* no grip yet */ }\\n      else if (o && (o.type === 'hook' || o.type === 'gaff') && o.barbs) { slip(S, p, 'tear', 4, tune); o.tears = (o.tears || 0) + 1; }\\n      else if (o && o.type === 'mass' && !o.cut) { /* ring first */ }\\n      else if (o && o.type === 'nest' && !o.cut) { /* slash first */ }\\n      else if (o && o.type === 'screw') { p.held = o.id; o.lastAng = Math.atan2(p.y - o.y, p.x - o.x); o.spin = o.spin || 0; }\\n\",\"total_lines\":1767}}","is_error":false},{"type":"tool_result","tool_use_id":"call-4cf49c5a-d0ab-438d-9af2-b75ad31988a9-30","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"399→  function stepForceps(S, p, dt, tune) {\\n400→    const down = p.trig > 0.3;\\n    let held = p.held ? objById(S, p.held) : null;\\n    if (p.trigEdge && !held) {\\n      const o = nearest(S, p, 12, o => canTouch(S, o) && (o.type === 'shard' || o.type === 'fragment' || o.type === 'cork' || o.type === 'hook' || o.type === 'gaff' || o.type === 'clot' || o.type === 'mass' || o.type === 'nest' || o.type === 'note' || o.type === 'retractor' || o.type === 'screw' || (o.type === 'lobe' && o.mode === 'forceps')));\\n      if (o && o.type === 'clot' && !o.dosed) { /* no grip yet */ }\\n      else if (o && (o.type === 'hook' || o.type === 'gaff') && o.barbs) { slip(S, p, 'tear', 4, tune); o.tears = (o.tears || 0) + 1; }\\n      else if (o && o.type === 'mass' && !o.cut) { /* ring first */ }\\n      else if (o && o.type === 'nest' && !o.cut) { /* slash first */ }\\n      else if (o && o.type === 'screw') { p.held = o.id; o.lastAng = Math.atan2(p.y - o.y, p.x - o.x); o.spin = o.spin || 0; }\\n      else if (o && o.type === 'retractor') { p.held = o.id; }\\n410→      else if (o) {\\n        p.held = o.id; o.t0 = o.t0 || 0; o.pullT = o.pullT || 0; o.gripped = true;\\n        if (!o.origin) o.origin = [o.x, o.y];\\n        pushEv(S, ['grip', o.id]);\\n      }\\n    }\\n    held = p.held ? objById(S, p.held) : null;\\n    if (held && down) {\\n      if (held.type === 'retractor') {\\n        held.x = p.x; held.y = p.y;\\n420→        S.windowOpen = 1;\\n        return;\\n      }\\n      if (held.type === 'screw') {\\n        const ang = Math.atan2(p.y - held.y, p.x - held.x);\\n        let d = ang - (held.lastAng || ang);\\n        while (d > Math.PI) d -= TAU;\\n        while (d < -Math.PI) d += TAU;\\n        held.spin = (held.spin || 0) + Math.abs(d);\\n        held.lastAng = ang;\\n430→        if (held.spin >= 3 * TAU) {\\n          held.done = true; held.alive = false; p.held = 0;\\n          award(S, p, 'textbook', 100, tune);\\n          pushEv(S, ['screw', held.id]);\\n        }\\n        return;\\n      }\\n      const ox = held.origin[0], oy = held.origin[1];\\n      const dx = p.x - ox, dy = p.y - oy;\\n      const along = dx * held.axis[0] + dy * held.axis[1];\\n440→      const px = dx - along * held.axis[0], py = dy - along * held.axis[1];\\n      const perp = hypot(px, py);\\n      const limit = held.tension || 120;\\n      if (held.tearCd > 0) held.tearCd -= dt;\\n      if (!held.free) {\\n        if ((p.inst > limit || perp > 8) && (held.tearCd || 0) <= 0) {\\n          held.tearCd = 0.28;\\n          if (held.type === 'note' || held.tag === 'legato-head' || (S.strain && S.strain.kind === 'legato' && held.tag === 'legato-head')) {\\n            held.snapped = true;\\n            slip(S, p, 'snap', 4, tune);\\n450→            pushEv(S, ['snap', held.id]);\\n          } else {\\n            held.tears = (held.tears || 0) + 1;\\n            held.prog = Math.max(0, (held.prog || 0) - held.depth * 0.3);\\n            slip(S, p, 'tear', 4, tune);\\n            addObj(S, { type: 'laceration', x: p.x, y: p.y, r: 6, order: 90, drain: 0.15, tag: 'tear' });\\n            pushEv(S, ['tear', held.id]);\\n          }\\n        }\\n        held.prog = Math.max(held.prog || 0, along);\\n460→        held.pullT = (held.pullT || 0) + dt;\\n        if (along >= held.depth) {\\n          held.free = true;\\n          pushEv(S, ['free', held.id]);\\n        }\\n      } else {\\n        held.x = p.x; held.y = p.y;\\n        held.pullT = (held.pullT || 0) + dt;\\n      }\\n    }\\n470→    if (held && p.trigRelease) {\\n      if (held.type === 'retractor') { p.held = 0; return; }\\n      if (held.type === 'screw') { p.held = 0; return; }\\n      const d0 = hypot(p.x - held.origin[0], p.y - held.origin[1]);\\n      if (held.holdZone && hypot(p.x - held.holdZone[0], p.y - held.holdZone[1]) <= (held.holdZone[2] || 14)) {\\n        held.clamped = true; held.gripped = false; p.held = 0;\\n        pushEv(S, ['clamp', held.id]);\\n        return;\\n      }\\n      if (held.free && (d0 >= 24 || outside(p.x, p.y))) {\\n480→        const tears = held.tears || 0;\\n        const parT = held.parTime || (held.depth / 80 + 0.35);\\n        let g = 'sloppy';\\n        if (!tears && (held.pullT || 0) <= parT) g = 'textbook';\\n        else if (tears <= 1) g = 'clean';\\n        held.done = true; held.alive = false; held.grade = g; p.held = 0;\\n        if (held.type === 'note') p.score += 0;\\n        award(S, p, g, 120, tune);\\n        pushEv(S, ['dish', held.id, g]);\\n      } else {\\n490→        held.gripped = false;\\n        p.held = 0;\\n      }\\n    }\\n  }\\n\\n  function outside(x, y) {\\n    const nx = (x - CFG.CX) / CFG.RX, ny = (y - CFG.CY) / CFG.RY;\\n    return nx * nx + ny * ny > 1;\\n  }\\n500→\\n  function stepScalpel(S, p, dt, tune) {\\n    const down = p.trig > 0.3;\\n    const tol = tune.hands.grade;\\n    if (p.stroke && p.stroke.kind === 'scalpel') {\\n      const o = objById(S, p.stroke.id);\\n      if (!o || o.done) { p.stroke = null; }\\n    }\\n    if (p.trigEdge && !p.stroke) {\\n      /* Press within 8 u of the guide start, not the object's center. A long cut's start sits far from x,y. */\\n510→      const reach = 8 + (p.mouse ? 1 : 0);\\n      let o = null, bd = reach;\\n      for (let i = 0; i < S.objects.length; i++) {\\n        const q = S.objects[i];\\n        if (!canTouch(S, q) || !q.guide) continue;\\n        if (!(q.type === 'mass' || q.type === 'slur' || q.type === 'tendril' || q.type === 'spiral' || q.type === 'wire' || q.type === 'repeat' || q.type === 'lobe' || q.type === 'cut' || q.type === 'nest')) continue;\\n        const start = q.guide[0];\\n        const d = hypot(p.x - start[0], p.y - start[1]);\\n        if (d <= bd) { bd = d; o = q; }\\n      }\\n520→      if (o) {\\n        p.stroke = { kind: 'scalpel', id: o.id, far: 0, sum: 0, n: 0, off: 0, slipped: false };\\n        o.cutting = true;\\n      }\\n    }\\n    if (!(p.stroke && p.stroke.kind === 'scalpel') && down && p.inst > 40) {\\n      const onGuide = S.objects.some(o => o.guide && !o.done && polyDist(o.guide, p.x, p.y).d < 8);\\n      if (!onGuide && !outside(p.x, p.y)) {\\n        p.bare = (p.bare || 0) + hypot(p.x - (p.ox || p.x), p.y - (p.oy || p.y));\\n        if (p.bare >= 6) { slip(S, p, 'healthy', 3, tune); p.bare = 0; }\\n530→      }\\n    }\\n    if (p.stroke && p.stroke.kind === 'scalpel' && down) {\\n      const o = objById(S, p.stroke.id);\\n      if (o && nerveHit(S, p, tune)) { /* counted */ }\\n      if (o && o.guide) {\\n        const hit = polyDist(o.guide, p.x, p.y);\\n        const st = p.stroke;\\n        if (hit.along > st.far) st.far = hit.along;\\n        /* A closed ring's last point is the start, so the vertex reads as along 0. Arriving back after most of the loop finishes it. */\\n540→        const g0 = o.guide[0], gN = o.guide[o.guide.length - 1];\\n        if (o.guide.length > 2 && hypot(g0[0] - gN[0], g0[1] - gN[1]) < 1.5 && st.far > hit.total * 0.72 && hypot(p.x - g0[0], p.y - g0[1]) <= 3) st.far = hit.total;\\n        st.sum += hit.d; st.n += 1;\\n        if (hit.d > 9) st.off += dt; else st.off = 0;\\n        if (st.off >= 0.12 && !st.slipped) {\\n          st.slipped = true; slip(S, p, 'slip', 3, tune);\\n          pushEv(S, ['slipcut', o.id]);\\n        }\\n        o.prog = st.far / (hit.total || 1);\\n        if (o.type === 'spiral' && o.beatLock && S.flags.onBeat) {\\n550→          if (!st.beatSlip) { st.beatSlip = true; slip(S, p, 'beat', 3, tune); }\\n          o.prog = Math.min(o.prog, st.safe || 0);\\n        } else if (o.type === 'spiral') st.safe = o.prog;\\n        if (st.far >= (hit.total || 1) - 0.5) {\\n          const mean = st.n ? st.sum / st.n : 99;\\n          const g = st.slipped ? 'sloppy' : gradeMean(mean, 1.8 * tol, 4 * tol);\\n          o.done = true; o.alive = false; o.grade = g; o.cut = true;\\n          if (o.type === 'mass') { o.done = false; o.alive = true; o.cut = true; o.type = 'mass'; }\\n          if (o.type === 'nest' || (o.type === 'lobe' && o.slash)) {\\n            o.done = false; o.alive = true; o.cut = true;\\n560→            if (o.type === 'lobe') o.mode = 'forceps';\\n          }\\n          if (o.type === 'wire') { /* caller checks order */ wireCut(S, p, o, tune); }\\n          else award(S, p, g, 110, tune);\\n          p.stroke = null;\\n          pushEv(S, ['cut', o.id, g]);\\n        }\\n      }\\n    }\\n    if (p.trigRelease && p.stroke && p.stroke.kind === 'scalpel') {\\n570→      const o = objById(S, p.stroke.id);\\n      if (o && o.prog < 0.98) {\\n        /* resume later if they come back within 6 */\\n        p.stroke.paused = true;\\n      }\\n    }\\n    if (p.trigEdge && p.stroke && p.stroke.paused) {\\n      const o = objById(S, p.stroke.id);\\n      if (o && o.guide) {\\n        const hit = polyDist(o.guide, p.x, p.y);\\n580→        if (Math.abs(hit.along - p.stroke.far) <= 6 || hit.d <= 6) p.stroke.paused = false;\\n        else p.stroke = null;\\n      }\\n    }\\n    /* slash variant: a fast stroke across a slash target */\\n    if (down && p.inst >= 60) {\\n      const o = nearest(S, p, 10, q => canTouch(S, q) && q.slash && !q.done && !q.cut);\\n      if (o) {\\n        o.cut = true;\\n        if (o.type === 'nest' || o.type === 'lobe') {\\n590→          if (o.type === 'lobe') o.mode = 'forceps';\\n          award(S, p, 'clean', 100, tune);\\n        } else {\\n          o.done = true; o.alive = false;\\n          award(S, p, 'clean', 100, tune);\\n        }\\n        pushEv(S, ['slash', o.id]);\\n      }\\n    }\\n  }\\n600→\\n  function wireCut(S, p, o, tune) {\\n    const dev = S.device;\\n    if (!dev) { o.done = true; award(S, p, 'clean', 80, tune); return; }\\n    const want = dev.order[dev.next];\\n    if (o.tag === want) {\\n      dev.next += 1; o.done = true; o.alive = false;\\n      award(S, p, 'textbook', 100, tune);\\n      if (dev.next >= dev.order.length) dev.done = true;\\n    } else {\\n610→      o.done = false; o.alive = true; o.prog = 0; o.cutting = false;\\n      S.vitals -= 30; S.clock = Math.max(0, S.clock - 30);\\n      slip(S, p, 'wire', 0, tune);\\n      pushEv(S, ['badwire', o.tag]);\\n    }\\n  }\\n\\n  function stepSuture(S, p, dt, tune) {\\n    const down = p.trig > 0.3;\\n    const extra = (S.activeDoc === 'sokolova' ? 1 : 0);\\n620→    if (p.trigEdge) {\\n      /* Press within 9 u of the next near point. Stitches sit off the wound center. */\\n      const reach = 9 + extra + (p.mouse ? 1 : 0);\\n      let o = null, bd = reach;\\n      for (let i = 0; i < S.objects.length; i++) {\\n        const q = S.objects[i];\\n        if (!canTouch(S, q) || !q.pairs || (q.stitch || 0) >= q.pairs.length) continue;\\n        const a = q.pairs[q.stitch][0];\\n        const d = hypot(p.x - a[0], p.y - a[1]);\\n        if (d <= bd) { bd = d; o = q; }\\n630→      }\\n      if (o) {\\n        p.stroke = { kind: 'suture', id: o.id, i: o.stitch, t: 0 };\\n        pushEv(S, ['needle', o.id, o.stitch]);\\n      }\\n    }\\n    if (p.stroke && p.stroke.kind === 'suture' && down) p.stroke.t += dt;\\n    if (p.stroke && p.stroke.kind === 'suture' && p.trigRelease) {\\n      const o = objById(S, p.stroke.id);\\n      const st = p.stroke;\\n640→      p.stroke = null;\\n      if (!o || o.done) return;\\n      const b = o.pairs[st.i][1];\\n      const tol = 6 + extra + (p.mouse ? 1 : 0);\\n      if (hypot(p.x - b[0], p.y - b[1]) <= tol) {\\n        const g = gradeMean(st.t, 0.6, 1.2);\\n        o.grades = o.grades || [];\\n        o.grades.push(g === 'textbook' ? 2 : g === 'clean' ? 1 : 0);\\n        o.times = o.times || [];\\n        o.times.push(st.t);\\n650→        o.stitch = st.i + 1;\\n        o.prog = o.stitch / o.pairs.length;\\n        p.stitches += 1;\\n        const bleedLeft = 1 - o.prog;\\n        if (o.type === 'arteryTear') o.drain = 1 * bleedLeft;\\n        else if (o.type === 'wound') o.drain = 0.4 * bleedLeft;\\n        pushEv(S, ['stitch', Math.round(b[0]), Math.round(b[1]), g]);\\n        if (o.stitch >= o.pairs.length) {\\n          const meanT = o.times.reduce((a, c) => a + c, 0) / o.times.length;\\n          const fg = gradeMean(meanT, 0.6, 1.2);\\n660→          o.done = true; o.alive = false; o.grade = fg; o.drain = 0;\\n          award(S, p, fg, 80 + 20 * o.pairs.length, tune);\\n        }\\n      } else {\\n        slip(S, p, 'loose', 1, tune);\\n        pushEv(S, ['loose', o.id]);\\n      }\\n    }\\n  }\\n\\n670→  function stepSalve(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    let any = false;\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n      if (!canTouch(S, o) || !o.cells) continue;\\n      if (!(o.type === 'laceration' || o.type === 'patch' || o.type === 'bite' || (o.type === 'lobe' && o.mode === 'salve'))) continue;\\n      for (let c = 0; c < o.cells.length; c++) {\\n        const cell = o.cells[c];\\n        if (!cell[2] && hypot(cell[0] - p.x, cell[1] - p.y) <= 10) { cell[2] = 1; any = true; }\\n680→      }\\n      let on = 0;\\n      for (let c = 0; c < o.cells.length; c++) if (o.cells[c][2]) on++;\\n      o.prog = o.cells.length ? on / o.cells.length : 1;\\n      if (o.prog >= 0.9 && !o.done) {\\n        o.done = true; o.alive = false; o.drain = 0;\\n        S.vitals = Math.min(99, S.vitals + 2 * tune.patient.healing);\\n        award(S, p, 'clean', 80, tune);\\n        pushEv(S, ['heal', o.id]);\\n      }\\n690→    }\\n    if (!any && p.trigEdge) { /* salve cannot harm */ }\\n  }\\n\\n  function stepSyringe(S, p, dt, tune) {\\n    if (p.cool > 0) p.cool -= dt;\\n    const down = p.trig > 0.3;\\n    if (down && p.cool <= 0) {\\n      if (p.fill < 1) p.fill = Math.min(1, p.fill + dt / 0.55);\\n      else p.over += dt;\\n700→    }\\n    if (p.trigRelease && p.fill > 0.05 && p.cool <= 0) {\\n      const bubble = p.over >= 0.3;\\n      /* A closed reed or voice is still a target: the needle finds it and the tissue splits. */\\n      const tgt = nearest(S, p, 10, o => {\\n        if (!o || o.done || !o.alive || covered(S, o)) return false;\\n        if (o.type === 'reed' || o.type === 'voice') return true;\\n        return canTouch(S, o) && (o.type === 'clot' || (o.type === 'lobe' && o.mode === 'syringe'));\\n      });\\n      if (tgt) {\\n710→        if ((tgt.type === 'reed' || tgt.type === 'voice') && !tgt.window) {\\n          addObj(S, { type: 'laceration', x: tgt.x + 6, y: tgt.y, r: 8, order: 50, drain: 0.2 });\\n          slip(S, p, 'spit', 2, tune);\\n        } else {\\n          const g = bubble ? 'sloppy' : (p.fill >= 0.9 ? 'textbook' : 'clean');\\n          tgt.dosed = true;\\n          tgt.dose = (bubble ? 0.5 : 1) * p.fill;\\n          if (tgt.follow === 'salve') {\\n            tgt.mode = 'salve';\\n            if (!tgt.cells) {\\n720→              const r = tgt.r || 8;\\n              tgt.cells = [];\\n              for (let y = -r; y <= r; y += 4) for (let x = -r; x <= r; x += 4) {\\n                if (x * x + y * y <= r * r) tgt.cells.push([tgt.x + x, tgt.y + y, 0]);\\n              }\\n            }\\n          } else if (tgt.type === 'clot') { tgt.drain = 0.1; }\\n          else { tgt.done = true; tgt.alive = false; tgt.drain = 0; }\\n          award(S, p, g, 90, tune);\\n          pushEv(S, ['inject', tgt.id, g]);\\n730→        }\\n      } else {\\n        const g = bubble ? 'sloppy' : (p.fill >= 0.9 ? 'textbook' : 'clean');\\n        const add = syringeDose(S, tune) * p.fill * (bubble ? 0.5 : 1);\\n        S.vitals = Math.min(99, S.vitals + add);\\n        award(S, p, g, 40, tune);\\n        S.flags.iv = (S.flags.iv || 0) + 1;\\n        pushEv(S, ['iv', Math.round(add), g]);\\n      }\\n      p.fill = 0; p.over = 0; p.cool = 0.35;\\n740→    }\\n    if (!down && p.trigRelease === false) { /* keep fill while aiming */ }\\n  }\\n\\n  function stepCautery(S, p, dt, tune) {\\n    if (p.lock > 0) { p.lock -= dt; p.heat = Math.max(0, p.heat - 0.6 * dt); return; }\\n    const down = p.trig > 0.3;\\n    if (!down) {\\n      p.heat = Math.max(0, p.heat - 0.6 * dt);\\n      p.bareT = 0;\\n750→      return;\\n    }\\n    p.heat += tune.fluids.cauteryHeat * dt;\\n    if (p.heat >= 1) { p.lock = 1.2; p.heat = 1; slip(S, p, 'lock', 1, tune); pushEv(S, ['lock', p.id]); return; }\\n    if (nerveHit(S, p, tune)) return;\\n    const tgt = nearest(S, p, 6, o => canTouch(S, o) && (o.type === 'polyp' || o.type === 'bleeder' || o.type === 'rupture' || o.type === 'bead' || o.type === 'uvula' || o.type === 'eye' || o.type === 'tremass' || (o.type === 'lobe' && o.mode === 'cautery') || o.type === 'barb'));\\n    if (tgt) {\\n      p.bareT = 0;\\n      tgt.burn = (tgt.burn || 0) + dt;\\n      tgt.prog = tgt.burn / (tgt.need || 0.5);\\n760→      if (tgt.burn >= (tgt.need || 0.5) / Math.max(0.25, tune.strains.health) && !tgt.done) {\\n        const dirty = tgt.charred || p.lockedDuring;\\n        const g = (!tgt.charred && p.lock <= 0 && !p.hadLock) ? 'textbook' : 'clean';\\n        tgt.done = true; tgt.alive = false; tgt.drain = 0; tgt.grade = g;\\n        p.burned += 1;\\n        award(S, p, g, 90, tune);\\n        pushEv(S, ['burn', tgt.id, g]);\\n      }\\n    } else {\\n      p.bareT = (p.bareT || 0) + dt;\\n770→      if (p.bareT >= 0.25) {\\n        /* char on the field */\\n        p.charT = (p.charT || 0) + dt;\\n        S.vitals -= 0.8 * dt * tune.patient.slip;\\n        if (p.bareT >= 0.6 && !p.charSlip) { p.charSlip = true; slip(S, p, 'char', 2, tune); pushEv(S, ['char', Math.round(p.x), Math.round(p.y)]); }\\n      }\\n    }\\n  }\\n\\n  function stepSuction(S, p, dt, tune) {\\n780→    if (p.trig <= 0.3) return;\\n    const pool = nearest(S, p, 14, o => o.type === 'pool' && !o.done && o.vol > 0);\\n    if (!pool) return;\\n    const rate = tune.fluids.suction;\\n    const before = pool.vol;\\n    pool.vol = Math.max(0, pool.vol - rate * dt);\\n    p.suctioned += before - pool.vol;\\n    pool.prog = 1 - pool.vol / (pool.max || 1);\\n    if (pool.vol <= 0.2) { pool.done = true; pool.alive = false; pool.vol = 0; pushEv(S, ['dry', pool.id]); }\\n  }\\n790→\\n  function stepSonar(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    let rad = 38;\\n    if (S.activeDoc === 'vale' || S.gift === 'breath') rad *= 1.25;\\n    if (S.gift === 'both' && S.activeDoc === 'vale') rad *= 1.25;\\n    p.sonarR = rad;\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n      if (!o.hidden || o.done) continue;\\n800→      if (hypot(o.x - p.x, o.y - p.y) <= rad) { o.marked = true; o.markT = 4; pushEv(S, ['mark', o.id]); }\\n    }\\n    if (S.device && !S.device.shown && hypot(p.x - (S.device.x || 213), p.y - (S.device.y || 116)) <= rad) {\\n      S.device.shown = true;\\n      for (const o of S.objects) if (o.needsBoard) { o.hidden = false; o.marked = true; o.markT = 6; }\\n      pushEv(S, ['board', 1]);\\n    }\\n    if (S.strain && S.strain.kind === 'legato') {\\n      for (const w of S.strain.worms || []) if (hypot(w.x - p.x, w.y - p.y) <= rad) w.marked = true;\\n    }\\n810→  }\\n\\n  function applyTools(S, p, dt, tune) {\\n    if (p.gone) return;\\n    if (inDome(S, p.x, p.y)) return;\\n    if (p.swap > 0) p.swap -= dt;\\n    p.ox = p.x; p.oy = p.y;\\n    const tool = p.tool;\\n    if (tool === 'forceps') stepForceps(S, p, dt, tune);\",\"content_concise\":\"399→  function stepForceps(S, p, dt, tune) {\\n400→    const down = p.trig > 0.3;\\n    let held = p.held ? objById(S, p.held) : null;\\n    if (p.trigEdge && !held) {\\n      const o = nearest(S, p, 12, o => canTouch(S, o) && (o.type === 'shard' || o.type === 'fragment' || o.type === 'cork' || o.type === 'hook' || o.type === 'gaff' || o.type === 'clot' || o.type === 'mass' || o.type === 'nest' || o.type === 'note' || o.type === 'retractor' || o.type === 'screw' || (o.type === 'lobe' && o.mode === 'forceps')));\\n      if (o && o.type === 'clot' && !o.dosed) { /* no grip yet */ }\\n      else if (o && (o.type === 'hook' || o.type === 'gaff') && o.barbs) { slip(S, p, 'tear', 4, tune); o.tears = (o.tears || 0) + 1; }\\n      else if (o && o.type === 'mass' && !o.cut) { /* ring first */ }\\n      else if (o && o.type === 'nest' && !o.cut) { /* slash first */ }\\n      else if (o && o.type === 'screw') { p.held = o.id; o.lastAng = Math.atan2(p.y - o.y, p.x - o.x); o.spin = o.spin || 0; }\\n      else if (o && o.type === 'retractor') { p.held = o.id; }\\n410→      else if (o) {\\n        p.held = o.id; o.t0 = o.t0 || 0; o.pullT = o.pullT || 0; o.gripped = true;\\n        if (!o.origin) o.origin = [o.x, o.y];\\n        pushEv(S, ['grip', o.id]);\\n      }\\n    }\\n    held = p.held ? objById(S, p.held) : null;\\n    if (held && down) {\\n      if (held.type === 'retractor') {\\n        held.x = p.x; held.y = p.y;\\n420→        S.windowOpen = 1;\\n        return;\\n      }\\n      if (held.type === 'screw') {\\n        const ang = Math.atan2(p.y - held.y, p.x - held.x);\\n        let d = ang - (held.lastAng || ang);\\n        while (d > Math.PI) d -= TAU;\\n        while (d < -Math.PI) d += TAU;\\n        held.spin = (held.spin || 0) + Math.abs(d);\\n        held.lastAng = ang;\\n430→        if (held.spin >= 3 * TAU) {\\n          held.done = true; held.alive = false; p.held = 0;\\n          award(S, p, 'textbook', 100, tune);\\n          pushEv(S, ['screw', held.id]);\\n        }\\n        return;\\n      }\\n      const ox = held.origin[0], oy = held.origin[1];\\n      const dx = p.x - ox, dy = p.y - oy;\\n      const along = dx * held.axis[0] + dy * held.axis[1];\\n440→      const px = dx - along * held.axis[0], py = dy - along * held.axis[1];\\n      const perp = hypot(px, py);\\n      const limit = held.tension || 120;\\n      if (held.tearCd > 0) held.tearCd -= dt;\\n      if (!held.free) {\\n        if ((p.inst > limit || perp > 8) && (held.tearCd || 0) <= 0) {\\n          held.tearCd = 0.28;\\n          if (held.type === 'note' || held.tag === 'legato-head' || (S.strain && S.strain.kind === 'legato' && held.tag === 'legato-head')) {\\n            held.snapped = true;\\n            slip(S, p, 'snap', 4, tune);\\n450→            pushEv(S, ['snap', held.id]);\\n          } else {\\n            held.tears = (held.tears || 0) + 1;\\n            held.prog = Math.max(0, (held.prog || 0) - held.depth * 0.3);\\n            slip(S, p, 'tear', 4, tune);\\n            addObj(S, { type: 'laceration', x: p.x, y: p.y, r: 6, order: 90, drain: 0.15, tag: 'tear' });\\n            pushEv(S, ['tear', held.id]);\\n          }\\n        }\\n        held.prog = Math.max(held.prog || 0, along);\\n460→        held.pullT = (held.pullT || 0) + dt;\\n        if (along >= held.depth) {\\n          held.free = true;\\n          pushEv(S, ['free', held.id]);\\n        }\\n      } else {\\n        held.x = p.x; held.y = p.y;\\n        held.pullT = (held.pullT || 0) + dt;\\n      }\\n    }\\n470→    if (held && p.trigRelease) {\\n      if (held.type === 'retractor') { p.held = 0; return; }\\n      if (held.type === 'screw') { p.held = 0; return; }\\n      const d0 = hypot(p.x - held.origin[0], p.y - held.origin[1]);\\n      if (held.holdZone && hypot(p.x - held.holdZone[0], p.y - held.holdZone[1]) <= (held.holdZone[2] || 14)) {\\n        held.clamped = true; held.gripped = false; p.held = 0;\\n        pushEv(S, ['clamp', held.id]);\\n        return;\\n      }\\n      if (held.free && (d0 >= 24 || outside(p.x, p.y))) {\\n480→        const tears = held.tears || 0;\\n        const parT = held.parTime || (held.depth / 80 + 0.35);\\n        let g = 'sloppy';\\n        if (!tears && (held.pullT || 0) <= parT) g = 'textbook';\\n        else if (tears <= 1) g = 'clean';\\n        held.done = true; held.alive = false; held.grade = g; p.held = 0;\\n        if (held.type === 'note') p.score += 0;\\n        award(S, p, g, 120, tune);\\n        pushEv(S, ['dish', held.id, g]);\\n      } else {\\n490→        held.gripped = false;\\n        p.held = 0;\\n      }\\n    }\\n  }\\n\\n  function outside(x, y) {\\n    const nx = (x - CFG.CX) / CFG.RX, ny = (y - CFG.CY) / CFG.RY;\\n    return nx * nx + ny * ny > 1;\\n  }\\n500→\\n  function stepScalpel(S, p, dt, tune) {\\n    const down = p.trig > 0.3;\\n    const tol = tune.hands.grade;\\n    if (p.stroke && p.stroke.kind === 'scalpel') {\\n      const o = objById(S, p.stroke.id);\\n      if (!o || o.done) { p.stroke = null; }\\n    }\\n    if (p.trigEdge && !p.stroke) {\\n      /* Press within 8 u of the guide start, not the object's center. A long cut's start sits far from x,y. */\\n510→      const reach = 8 + (p.mouse ? 1 : 0);\\n      let o = null, bd = reach;\\n      for (let i = 0; i < S.objects.length; i++) {\\n        const q = S.objects[i];\\n        if (!canTouch(S, q) || !q.guide) continue;\\n        if (!(q.type === 'mass' || q.type === 'slur' || q.type === 'tendril' || q.type === 'spiral' || q.type === 'wire' || q.type === 'repeat' || q.type === 'lobe' || q.type === 'cut' || q.type === 'nest')) continue;\\n        const start = q.guide[0];\\n        const d = hypot(p.x - start[0], p.y - start[1]);\\n        if (d <= bd) { bd = d; o = q; }\\n      }\\n520→      if (o) {\\n        p.stroke = { kind: 'scalpel', id: o.id, far: 0, sum: 0, n: 0, off: 0, slipped: false };\\n        o.cutting = true;\\n      }\\n    }\\n    if (!(p.stroke && p.stroke.kind === 'scalpel') && down && p.inst > 40) {\\n      const onGuide = S.objects.some(o => o.guide && !o.done && polyDist(o.guide, p.x, p.y).d < 8);\\n      if (!onGuide && !outside(p.x, p.y)) {\\n        p.bare = (p.bare || 0) + hypot(p.x - (p.ox || p.x), p.y - (p.oy || p.y));\\n        if (p.bare >= 6) { slip(S, p, 'healthy', 3, tune); p.bare = 0; }\\n530→      }\\n    }\\n    if (p.stroke && p.stroke.kind === 'scalpel' && down) {\\n      const o = objById(S, p.stroke.id);\\n      if (o && nerveHit(S, p, tune)) { /* counted */ }\\n      if (o && o.guide) {\\n        const hit = polyDist(o.guide, p.x, p.y);\\n        const st = p.stroke;\\n        if (hit.along > st.far) st.far = hit.along;\\n        /* A closed ring's last point is the start, so the vertex reads as along 0. Arriving back after most of the loop finishes it. */\\n540→        const g0 = o.guide[0], gN = o.guide[o.guide.length - 1];\\n        if (o.guide.length > 2 && hypot(g0[0] - gN[0], g0[1] - gN[1]) < 1.5 && st.far > hit.total * 0.72 && hypot(p.x - g0[0], p.y - g0[1]) <= 3) st.far = hit.total;\\n        st.sum += hit.d; st.n += 1;\\n        if (hit.d > 9) st.off += dt; else st.off = 0;\\n        if (st.off >= 0.12 && !st.slipped) {\\n          st.slipped = true; slip(S, p, 'slip', 3, tune);\\n          pushEv(S, ['slipcut', o.id]);\\n        }\\n        o.prog = st.far / (hit.total || 1);\\n        if (o.type === 'spiral' && o.beatLock && S.flags.onBeat) {\\n550→          if (!st.beatSlip) { st.beatSlip = true; slip(S, p, 'beat', 3, tune); }\\n          o.prog = Math.min(o.prog, st.safe || 0);\\n        } else if (o.type === 'spiral') st.safe = o.prog;\\n        if (st.far >= (hit.total || 1) - 0.5) {\\n          const mean = st.n ? st.sum / st.n : 99;\\n          const g = st.slipped ? 'sloppy' : gradeMean(mean, 1.8 * tol, 4 * tol);\\n          o.done = true; o.alive = false; o.grade = g; o.cut = true;\\n          if (o.type === 'mass') { o.done = false; o.alive = true; o.cut = true; o.type = 'mass'; }\\n          if (o.type === 'nest' || (o.type === 'lobe' && o.slash)) {\\n            o.done = false; o.alive = true; o.cut = true;\\n560→            if (o.type === 'lobe') o.mode = 'forceps';\\n          }\\n          if (o.type === 'wire') { /* caller checks order */ wireCut(S, p, o, tune); }\\n          else award(S, p, g, 110, tune);\\n          p.stroke = null;\\n          pushEv(S, ['cut', o.id, g]);\\n        }\\n      }\\n    }\\n    if (p.trigRelease && p.stroke && p.stroke.kind === 'scalpel') {\\n570→      const o = objById(S, p.stroke.id);\\n      if (o && o.prog < 0.98) {\\n        /* resume later if they come back within 6 */\\n        p.stroke.paused = true;\\n      }\\n    }\\n    if (p.trigEdge && p.stroke && p.stroke.paused) {\\n      const o = objById(S, p.stroke.id);\\n      if (o && o.guide) {\\n        const hit = polyDist(o.guide, p.x, p.y);\\n580→        if (Math.abs(hit.along - p.stroke.far) <= 6 || hit.d <= 6) p.stroke.paused = false;\\n        else p.stroke = null;\\n      }\\n    }\\n    /* slash variant: a fast stroke across a slash target */\\n    if (down && p.inst >= 60) {\\n      const o = nearest(S, p, 10, q => canTouch(S, q) && q.slash && !q.done && !q.cut);\\n      if (o) {\\n        o.cut = true;\\n        if (o.type === 'nest' || o.type === 'lobe') {\\n590→          if (o.type === 'lobe') o.mode = 'forceps';\\n          award(S, p, 'clean', 100, tune);\\n        } else {\\n          o.done = true; o.alive = false;\\n          award(S, p, 'clean', 100, tune);\\n        }\\n        pushEv(S, ['slash', o.id]);\\n      }\\n    }\\n  }\\n600→\\n  function wireCut(S, p, o, tune) {\\n    const dev = S.device;\\n    if (!dev) { o.done = true; award(S, p, 'clean', 80, tune); return; }\\n    const want = dev.order[dev.next];\\n    if (o.tag === want) {\\n      dev.next += 1; o.done = true; o.alive = false;\\n      award(S, p, 'textbook', 100, tune);\\n      if (dev.next >= dev.order.length) dev.done = true;\\n    } else {\\n610→      o.done = false; o.alive = true; o.prog = 0; o.cutting = false;\\n      S.vitals -= 30; S.clock = Math.max(0, S.clock - 30);\\n      slip(S, p, 'wire', 0, tune);\\n      pushEv(S, ['badwire', o.tag]);\\n    }\\n  }\\n\\n  function stepSuture(S, p, dt, tune) {\\n    const down = p.trig > 0.3;\\n    const extra = (S.activeDoc === 'sokolova' ? 1 : 0);\\n620→    if (p.trigEdge) {\\n      /* Press within 9 u of the next near point. Stitches sit off the wound center. */\\n      const reach = 9 + extra + (p.mouse ? 1 : 0);\\n      let o = null, bd = reach;\\n      for (let i = 0; i < S.objects.length; i++) {\\n        const q = S.objects[i];\\n        if (!canTouch(S, q) || !q.pairs || (q.stitch || 0) >= q.pairs.length) continue;\\n        const a = q.pairs[q.stitch][0];\\n        const d = hypot(p.x - a[0], p.y - a[1]);\\n        if (d <= bd) { bd = d; o = q; }\\n630→      }\\n      if (o) {\\n        p.stroke = { kind: 'suture', id: o.id, i: o.stitch, t: 0 };\\n        pushEv(S, ['needle', o.id, o.stitch]);\\n      }\\n    }\\n    if (p.stroke && p.stroke.kind === 'suture' && down) p.stroke.t += dt;\\n    if (p.stroke && p.stroke.kind === 'suture' && p.trigRelease) {\\n      const o = objById(S, p.stroke.id);\\n      const st = p.stroke;\\n640→      p.stroke = null;\\n      if (!o || o.done) return;\\n      const b = o.pairs[st.i][1];\\n      const tol = 6 + extra + (p.mouse ? 1 : 0);\\n      if (hypot(p.x - b[0], p.y - b[1]) <= tol) {\\n        const g = gradeMean(st.t, 0.6, 1.2);\\n        o.grades = o.grades || [];\\n        o.grades.push(g === 'textbook' ? 2 : g === 'clean' ? 1 : 0);\\n        o.times = o.times || [];\\n        o.times.push(st.t);\\n650→        o.stitch = st.i + 1;\\n        o.prog = o.stitch / o.pairs.length;\\n        p.stitches += 1;\\n        const bleedLeft = 1 - o.prog;\\n        if (o.type === 'arteryTear') o.drain = 1 * bleedLeft;\\n        else if (o.type === 'wound') o.drain = 0.4 * bleedLeft;\\n        pushEv(S, ['stitch', Math.round(b[0]), Math.round(b[1]), g]);\\n        if (o.stitch >= o.pairs.length) {\\n          const meanT = o.times.reduce((a, c) => a + c, 0) / o.times.length;\\n          const fg = gradeMean(meanT, 0.6, 1.2);\\n660→          o.done = true; o.alive = false; o.grade = fg; o.drain = 0;\\n          award(S, p, fg, 80 + 20 * o.pairs.length, tune);\\n        }\\n      } else {\\n        slip(S, p, 'loose', 1, tune);\\n        pushEv(S, ['loose', o.id]);\\n      }\\n    }\\n  }\\n\\n670→  function stepSalve(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    let any = false;\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n      if (!canTouch(S, o) || !o.cells) continue;\\n      if (!(o.type === 'laceration' || o.type === 'patch' || o.type === 'bite' || (o.type === 'lobe' && o.mode === 'salve'))) continue;\\n      for (let c = 0; c < o.cells.length; c++) {\\n        const cell = o.cells[c];\\n        if (!cell[2] && hypot(cell[0] - p.x, cell[1] - p.y) <= 10) { cell[2] = 1; any = true; }\\n680→      }\\n      let on = 0;\\n      for (let c = 0; c < o.cells.length; c++) if (o.cells[c][2]) on++;\\n      o.prog = o.cells.length ? on / o.cells.length : 1;\\n      if (o.prog >= 0.9 && !o.done) {\\n        o.done = true; o.alive = false; o.drain = 0;\\n        S.vitals = Math.min(99, S.vitals + 2 * tune.patient.healing);\\n        award(S, p, 'clean', 80, tune);\\n        pushEv(S, ['heal', o.id]);\\n      }\\n690→    }\\n    if (!any && p.trigEdge) { /* salve cannot harm */ }\\n  }\\n\\n  function stepSyringe(S, p, dt, tune) {\\n    if (p.cool > 0) p.cool -= dt;\\n    const down = p.trig > 0.3;\\n    if (down && p.cool <= 0) {\\n      if (p.fill < 1) p.fill = Math.min(1, p.fill + dt / 0.55);\\n      else p.over += dt;\\n700→    }\\n    if (p.trigRelease && p.fill > 0.05 && p.cool <= 0) {\\n      const bubble = p.over >= 0.3;\\n      /* A closed reed or voice is still a target: the needle finds it and the tissue splits. */\\n      const tgt = nearest(S, p, 10, o => {\\n        if (!o || o.done || !o.alive || covered(S, o)) return false;\\n        if (o.type === 'reed' || o.type === 'voice') return true;\\n        return canTouch(S, o) && (o.type === 'clot' || (o.type === 'lobe' && o.mode === 'syringe'));\\n      });\\n      if (tgt) {\\n710→        if ((tgt.type === 'reed' || tgt.type === 'voice') && !tgt.window) {\\n          addObj(S, { type: 'laceration', x: tgt.x + 6, y: tgt.y, r: 8, order: 50, drain: 0.2 });\\n          slip(S, p, 'spit', 2, tune);\\n        } else {\\n          const g = bubble ? 'sloppy' : (p.fill >= 0.9 ? 'textbook' : 'clean');\\n          tgt.dosed = true;\\n          tgt.dose = (bubble ? 0.5 : 1) * p.fill;\\n          if (tgt.follow === 'salve') {\\n            tgt.mode = 'salve';\\n            if (!tgt.cells) {\\n720→              const r = tgt.r || 8;\\n              tgt.cells = [];\\n              for (let y = -r; y <= r; y += 4) for (let x = -r; x <= r; x += 4) {\\n                if (x * x + y * y <= r * r) tgt.cells.push([tgt.x + x, tgt.y + y, 0]);\\n              }\\n            }\\n          } else if (tgt.type === 'clot') { tgt.drain = 0.1; }\\n          else { tgt.done = true; tgt.alive = false; tgt.drain = 0; }\\n          award(S, p, g, 90, tune);\\n          pushEv(S, ['inject', tgt.id, g]);\\n730→        }\\n      } else {\\n        const g = bubble ? 'sloppy' : (p.fill >= 0.9 ? 'textbook' : 'clean');\\n        const add = syringeDose(S, tune) * p.fill * (bubble ? 0.5 : 1);\\n        S.vitals = Math.min(99, S.vitals + add);\\n        award(S, p, g, 40, tune);\\n        S.flags.iv = (S.flags.iv || 0) + 1;\\n        pushEv(S, ['iv', Math.round(add), g]);\\n      }\\n      p.fill = 0; p.over = 0; p.cool = 0.35;\\n740→    }\\n    if (!down && p.trigRelease === false) { /* keep fill while aiming */ }\\n  }\\n\\n  function stepCautery(S, p, dt, tune) {\\n    if (p.lock > 0) { p.lock -= dt; p.heat = Math.max(0, p.heat - 0.6 * dt); return; }\\n    const down = p.trig > 0.3;\\n    if (!down) {\\n      p.heat = Math.max(0, p.heat - 0.6 * dt);\\n      p.bareT = 0;\\n750→      return;\\n    }\\n    p.heat += tune.fluids.cauteryHeat * dt;\\n    if (p.heat >= 1) { p.lock = 1.2; p.heat = 1; slip(S, p, 'lock', 1, tune); pushEv(S, ['lock', p.id]); return; }\\n    if (nerveHit(S, p, tune)) return;\\n    const tgt = nearest(S, p, 6, o => canTouch(S, o) && (o.type === 'polyp' || o.type === 'bleeder' || o.type === 'rupture' || o.type === 'bead' || o.type === 'uvula' || o.type === 'eye' || o.type === 'tremass' || (o.type === 'lobe' && o.mode === 'cautery') || o.type === 'barb'));\\n    if (tgt) {\\n      p.bareT = 0;\\n      tgt.burn = (tgt.burn || 0) + dt;\\n      tgt.prog = tgt.burn / (tgt.need || 0.5);\\n760→      if (tgt.burn >= (tgt.need || 0.5) / Math.max(0.25, tune.strains.health) && !tgt.done) {\\n        const dirty = tgt.charred || p.lockedDuring;\\n        const g = (!tgt.charred && p.lock <= 0 && !p.hadLock) ? 'textbook' : 'clean';\\n        tgt.done = true; tgt.alive = false; tgt.drain = 0; tgt.grade = g;\\n        p.burned += 1;\\n        award(S, p, g, 90, tune);\\n        pushEv(S, ['burn', tgt.id, g]);\\n      }\\n    } else {\\n      p.bareT = (p.bareT || 0) + dt;\\n770→      if (p.bareT >= 0.25) {\\n        /* char on the field */\\n        p.charT = (p.charT || 0) + dt;\\n        S.vitals -= 0.8 * dt * tune.patient.slip;\\n        if (p.bareT >= 0.6 && !p.charSlip) { p.charSlip = true; slip(S, p, 'char', 2, tune); pushEv(S, ['char', Math.round(p.x), Math.round(p.y)]); }\\n      }\\n    }\\n  }\\n\\n  function stepSuction(S, p, dt, tune) {\\n780→    if (p.trig <= 0.3) return;\\n    const pool = nearest(S, p, 14, o => o.type === 'pool' && !o.done && o.vol > 0);\\n    if (!pool) return;\\n    const rate = tune.fluids.suction;\\n    const before = pool.vol;\\n    pool.vol = Math.max(0, pool.vol - rate * dt);\\n    p.suctioned += before - pool.vol;\\n    pool.prog = 1 - pool.vol / (pool.max || 1);\\n    if (pool.vol <= 0.2) { pool.done = true; pool.alive = false; pool.vol = 0; pushEv(S, ['dry', pool.id]); }\\n  }\\n790→\\n  function stepSonar(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    let rad = 38;\\n    if (S.activeDoc === 'vale' || S.gift === 'breath') rad *= 1.25;\\n    if (S.gift === 'both' && S.activeDoc === 'vale') rad *= 1.25;\\n    p.sonarR = rad;\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n      if (!o.hidden || o.done) continue;\\n800→      if (hypot(o.x - p.x, o.y - p.y) <= rad) { o.marked = true; o.markT = 4; pushEv(S, ['mark', o.id]); }\\n    }\\n    if (S.device && !S.device.shown && hypot(p.x - (S.device.x || 213), p.y - (S.device.y || 116)) <= rad) {\\n      S.device.shown = true;\\n      for (const o of S.objects) if (o.needsBoard) { o.hidden = false; o.marked = true; o.markT = 6; }\\n      pushEv(S, ['board', 1]);\\n    }\\n    if (S.strain && S.strain.kind === 'legato') {\\n      for (const w of S.strain.worms || []) if (hypot(w.x - p.x, w.y - p.y) <= rad) w.marked = true;\\n    }\\n810→  }\\n\\n  function applyTools(S, p, dt, tune) {\\n    if (p.gone) return;\\n    if (inDome(S, p.x, p.y)) return;\\n    if (p.swap > 0) p.swap -= dt;\\n    p.ox = p.x; p.oy = p.y;\\n    const tool = p.tool;\\n    if (tool === 'forceps') stepForceps(S, p, dt, tune);\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/core/sim.js\",\"offset\":399,\"limit\":420,\"raw_output\":\"  function stepForceps(S, p, dt, tune) {\\n    const down = p.trig > 0.3;\\n    let held = p.held ? objById(S, p.held) : null;\\n    if (p.trigEdge && !held) {\\n      const o = nearest(S, p, 12, o => canTouch(S, o) && (o.type === 'shard' || o.type === 'fragment' || o.type === 'cork' || o.type === 'hook' || o.type === 'gaff' || o.type === 'clot' || o.type === 'mass' || o.type === 'nest' || o.type === 'note' || o.type === 'retractor' || o.type === 'screw' || (o.type === 'lobe' && o.mode === 'forceps')));\\n      if (o && o.type === 'clot' && !o.dosed) { /* no grip yet */ }\\n      else if (o && (o.type === 'hook' || o.type === 'gaff') && o.barbs) { slip(S, p, 'tear', 4, tune); o.tears = (o.tears || 0) + 1; }\\n      else if (o && o.type === 'mass' && !o.cut) { /* ring first */ }\\n      else if (o && o.type === 'nest' && !o.cut) { /* slash first */ }\\n      else if (o && o.type === 'screw') { p.held = o.id; o.lastAng = Math.atan2(p.y - o.y, p.x - o.x); o.spin = o.spin || 0; }\\n      else if (o && o.type === 'retractor') { p.held = o.id; }\\n      else if (o) {\\n        p.held = o.id; o.t0 = o.t0 || 0; o.pullT = o.pullT || 0; o.gripped = true;\\n        if (!o.origin) o.origin = [o.x, o.y];\\n        pushEv(S, ['grip', o.id]);\\n      }\\n    }\\n    held = p.held ? objById(S, p.held) : null;\\n    if (held && down) {\\n      if (held.type === 'retractor') {\\n        held.x = p.x; held.y = p.y;\\n        S.windowOpen = 1;\\n        return;\\n      }\\n      if (held.type === 'screw') {\\n        const ang = Math.atan2(p.y - held.y, p.x - held.x);\\n        let d = ang - (held.lastAng || ang);\\n        while (d > Math.PI) d -= TAU;\\n        while (d < -Math.PI) d += TAU;\\n        held.spin = (held.spin || 0) + Math.abs(d);\\n        held.lastAng = ang;\\n        if (held.spin >= 3 * TAU) {\\n          held.done = true; held.alive = false; p.held = 0;\\n          award(S, p, 'textbook', 100, tune);\\n          pushEv(S, ['screw', held.id]);\\n        }\\n        return;\\n      }\\n      const ox = held.origin[0], oy = held.origin[1];\\n      const dx = p.x - ox, dy = p.y - oy;\\n      const along = dx * held.axis[0] + dy * held.axis[1];\\n      const px = dx - along * held.axis[0], py = dy - along * held.axis[1];\\n      const perp = hypot(px, py);\\n      const limit = held.tension || 120;\\n      if (held.tearCd > 0) held.tearCd -= dt;\\n      if (!held.free) {\\n        if ((p.inst > limit || perp > 8) && (held.tearCd || 0) <= 0) {\\n          held.tearCd = 0.28;\\n          if (held.type === 'note' || held.tag === 'legato-head' || (S.strain && S.strain.kind === 'legato' && held.tag === 'legato-head')) {\\n            held.snapped = true;\\n            slip(S, p, 'snap', 4, tune);\\n            pushEv(S, ['snap', held.id]);\\n          } else {\\n            held.tears = (held.tears || 0) + 1;\\n            held.prog = Math.max(0, (held.prog || 0) - held.depth * 0.3);\\n            slip(S, p, 'tear', 4, tune);\\n            addObj(S, { type: 'laceration', x: p.x, y: p.y, r: 6, order: 90, drain: 0.15, tag: 'tear' });\\n            pushEv(S, ['tear', held.id]);\\n          }\\n        }\\n        held.prog = Math.max(held.prog || 0, along);\\n        held.pullT = (held.pullT || 0) + dt;\\n        if (along >= held.depth) {\\n          held.free = true;\\n          pushEv(S, ['free', held.id]);\\n        }\\n      } else {\\n        held.x = p.x; held.y = p.y;\\n        held.pullT = (held.pullT || 0) + dt;\\n      }\\n    }\\n    if (held && p.trigRelease) {\\n      if (held.type === 'retractor') { p.held = 0; return; }\\n      if (held.type === 'screw') { p.held = 0; return; }\\n      const d0 = hypot(p.x - held.origin[0], p.y - held.origin[1]);\\n      if (held.holdZone && hypot(p.x - held.holdZone[0], p.y - held.holdZone[1]) <= (held.holdZone[2] || 14)) {\\n        held.clamped = true; held.gripped = false; p.held = 0;\\n        pushEv(S, ['clamp', held.id]);\\n        return;\\n      }\\n      if (held.free && (d0 >= 24 || outside(p.x, p.y))) {\\n        const tears = held.tears || 0;\\n        const parT = held.parTime || (held.depth / 80 + 0.35);\\n        let g = 'sloppy';\\n        if (!tears && (held.pullT || 0) <= parT) g = 'textbook';\\n        else if (tears <= 1) g = 'clean';\\n        held.done = true; held.alive = false; held.grade = g; p.held = 0;\\n        if (held.type === 'note') p.score += 0;\\n        award(S, p, g, 120, tune);\\n        pushEv(S, ['dish', held.id, g]);\\n      } else {\\n        held.gripped = false;\\n        p.held = 0;\\n      }\\n    }\\n  }\\n\\n  function outside(x, y) {\\n    const nx = (x - CFG.CX) / CFG.RX, ny = (y - CFG.CY) / CFG.RY;\\n    return nx * nx + ny * ny > 1;\\n  }\\n\\n  function stepScalpel(S, p, dt, tune) {\\n    const down = p.trig > 0.3;\\n    const tol = tune.hands.grade;\\n    if (p.stroke && p.stroke.kind === 'scalpel') {\\n      const o = objById(S, p.stroke.id);\\n      if (!o || o.done) { p.stroke = null; }\\n    }\\n    if (p.trigEdge && !p.stroke) {\\n      /* Press within 8 u of the guide start, not the object's center. A long cut's start sits far from x,y. */\\n      const reach = 8 + (p.mouse ? 1 : 0);\\n      let o = null, bd = reach;\\n      for (let i = 0; i < S.objects.length; i++) {\\n        const q = S.objects[i];\\n        if (!canTouch(S, q) || !q.guide) continue;\\n        if (!(q.type === 'mass' || q.type === 'slur' || q.type === 'tendril' || q.type === 'spiral' || q.type === 'wire' || q.type === 'repeat' || q.type === 'lobe' || q.type === 'cut' || q.type === 'nest')) continue;\\n        const start = q.guide[0];\\n        const d = hypot(p.x - start[0], p.y - start[1]);\\n        if (d <= bd) { bd = d; o = q; }\\n      }\\n      if (o) {\\n        p.stroke = { kind: 'scalpel', id: o.id, far: 0, sum: 0, n: 0, off: 0, slipped: false };\\n        o.cutting = true;\\n      }\\n    }\\n    if (!(p.stroke && p.stroke.kind === 'scalpel') && down && p.inst > 40) {\\n      const onGuide = S.objects.some(o => o.guide && !o.done && polyDist(o.guide, p.x, p.y).d < 8);\\n      if (!onGuide && !outside(p.x, p.y)) {\\n        p.bare = (p.bare || 0) + hypot(p.x - (p.ox || p.x), p.y - (p.oy || p.y));\\n        if (p.bare >= 6) { slip(S, p, 'healthy', 3, tune); p.bare = 0; }\\n      }\\n    }\\n    if (p.stroke && p.stroke.kind === 'scalpel' && down) {\\n      const o = objById(S, p.stroke.id);\\n      if (o && nerveHit(S, p, tune)) { /* counted */ }\\n      if (o && o.guide) {\\n        const hit = polyDist(o.guide, p.x, p.y);\\n        const st = p.stroke;\\n        if (hit.along > st.far) st.far = hit.along;\\n        /* A closed ring's last point is the start, so the vertex reads as along 0. Arriving back after most of the loop finishes it. */\\n        const g0 = o.guide[0], gN = o.guide[o.guide.length - 1];\\n        if (o.guide.length > 2 && hypot(g0[0] - gN[0], g0[1] - gN[1]) < 1.5 && st.far > hit.total * 0.72 && hypot(p.x - g0[0], p.y - g0[1]) <= 3) st.far = hit.total;\\n        st.sum += hit.d; st.n += 1;\\n        if (hit.d > 9) st.off += dt; else st.off = 0;\\n        if (st.off >= 0.12 && !st.slipped) {\\n          st.slipped = true; slip(S, p, 'slip', 3, tune);\\n          pushEv(S, ['slipcut', o.id]);\\n        }\\n        o.prog = st.far / (hit.total || 1);\\n        if (o.type === 'spiral' && o.beatLock && S.flags.onBeat) {\\n          if (!st.beatSlip) { st.beatSlip = true; slip(S, p, 'beat', 3, tune); }\\n          o.prog = Math.min(o.prog, st.safe || 0);\\n        } else if (o.type === 'spiral') st.safe = o.prog;\\n        if (st.far >= (hit.total || 1) - 0.5) {\\n          const mean = st.n ? st.sum / st.n : 99;\\n          const g = st.slipped ? 'sloppy' : gradeMean(mean, 1.8 * tol, 4 * tol);\\n          o.done = true; o.alive = false; o.grade = g; o.cut = true;\\n          if (o.type === 'mass') { o.done = false; o.alive = true; o.cut = true; o.type = 'mass'; }\\n          if (o.type === 'nest' || (o.type === 'lobe' && o.slash)) {\\n            o.done = false; o.alive = true; o.cut = true;\\n            if (o.type === 'lobe') o.mode = 'forceps';\\n          }\\n          if (o.type === 'wire') { /* caller checks order */ wireCut(S, p, o, tune); }\\n          else award(S, p, g, 110, tune);\\n          p.stroke = null;\\n          pushEv(S, ['cut', o.id, g]);\\n        }\\n      }\\n    }\\n    if (p.trigRelease && p.stroke && p.stroke.kind === 'scalpel') {\\n      const o = objById(S, p.stroke.id);\\n      if (o && o.prog < 0.98) {\\n        /* resume later if they come back within 6 */\\n        p.stroke.paused = true;\\n      }\\n    }\\n    if (p.trigEdge && p.stroke && p.stroke.paused) {\\n      const o = objById(S, p.stroke.id);\\n      if (o && o.guide) {\\n        const hit = polyDist(o.guide, p.x, p.y);\\n        if (Math.abs(hit.along - p.stroke.far) <= 6 || hit.d <= 6) p.stroke.paused = false;\\n        else p.stroke = null;\\n      }\\n    }\\n    /* slash variant: a fast stroke across a slash target */\\n    if (down && p.inst >= 60) {\\n      const o = nearest(S, p, 10, q => canTouch(S, q) && q.slash && !q.done && !q.cut);\\n      if (o) {\\n        o.cut = true;\\n        if (o.type === 'nest' || o.type === 'lobe') {\\n          if (o.type === 'lobe') o.mode = 'forceps';\\n          award(S, p, 'clean', 100, tune);\\n        } else {\\n          o.done = true; o.alive = false;\\n          award(S, p, 'clean', 100, tune);\\n        }\\n        pushEv(S, ['slash', o.id]);\\n      }\\n    }\\n  }\\n\\n  function wireCut(S, p, o, tune) {\\n    const dev = S.device;\\n    if (!dev) { o.done = true; award(S, p, 'clean', 80, tune); return; }\\n    const want = dev.order[dev.next];\\n    if (o.tag === want) {\\n      dev.next += 1; o.done = true; o.alive = false;\\n      award(S, p, 'textbook', 100, tune);\\n      if (dev.next >= dev.order.length) dev.done = true;\\n    } else {\\n      o.done = false; o.alive = true; o.prog = 0; o.cutting = false;\\n      S.vitals -= 30; S.clock = Math.max(0, S.clock - 30);\\n      slip(S, p, 'wire', 0, tune);\\n      pushEv(S, ['badwire', o.tag]);\\n    }\\n  }\\n\\n  function stepSuture(S, p, dt, tune) {\\n    const down = p.trig > 0.3;\\n    const extra = (S.activeDoc === 'sokolova' ? 1 : 0);\\n    if (p.trigEdge) {\\n      /* Press within 9 u of the next near point. Stitches sit off the wound center. */\\n      const reach = 9 + extra + (p.mouse ? 1 : 0);\\n      let o = null, bd = reach;\\n      for (let i = 0; i < S.objects.length; i++) {\\n        const q = S.objects[i];\\n        if (!canTouch(S, q) || !q.pairs || (q.stitch || 0) >= q.pairs.length) continue;\\n        const a = q.pairs[q.stitch][0];\\n        const d = hypot(p.x - a[0], p.y - a[1]);\\n        if (d <= bd) { bd = d; o = q; }\\n      }\\n      if (o) {\\n        p.stroke = { kind: 'suture', id: o.id, i: o.stitch, t: 0 };\\n        pushEv(S, ['needle', o.id, o.stitch]);\\n      }\\n    }\\n    if (p.stroke && p.stroke.kind === 'suture' && down) p.stroke.t += dt;\\n    if (p.stroke && p.stroke.kind === 'suture' && p.trigRelease) {\\n      const o = objById(S, p.stroke.id);\\n      const st = p.stroke;\\n      p.stroke = null;\\n      if (!o || o.done) return;\\n      const b = o.pairs[st.i][1];\\n      const tol = 6 + extra + (p.mouse ? 1 : 0);\\n      if (hypot(p.x - b[0], p.y - b[1]) <= tol) {\\n        const g = gradeMean(st.t, 0.6, 1.2);\\n        o.grades = o.grades || [];\\n        o.grades.push(g === 'textbook' ? 2 : g === 'clean' ? 1 : 0);\\n        o.times = o.times || [];\\n        o.times.push(st.t);\\n        o.stitch = st.i + 1;\\n        o.prog = o.stitch / o.pairs.length;\\n        p.stitches += 1;\\n        const bleedLeft = 1 - o.prog;\\n        if (o.type === 'arteryTear') o.drain = 1 * bleedLeft;\\n        else if (o.type === 'wound') o.drain = 0.4 * bleedLeft;\\n        pushEv(S, ['stitch', Math.round(b[0]), Math.round(b[1]), g]);\\n        if (o.stitch >= o.pairs.length) {\\n          const meanT = o.times.reduce((a, c) => a + c, 0) / o.times.length;\\n          const fg = gradeMean(meanT, 0.6, 1.2);\\n          o.done = true; o.alive = false; o.grade = fg; o.drain = 0;\\n          award(S, p, fg, 80 + 20 * o.pairs.length, tune);\\n        }\\n      } else {\\n        slip(S, p, 'loose', 1, tune);\\n        pushEv(S, ['loose', o.id]);\\n      }\\n    }\\n  }\\n\\n  function stepSalve(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    let any = false;\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n      if (!canTouch(S, o) || !o.cells) continue;\\n      if (!(o.type === 'laceration' || o.type === 'patch' || o.type === 'bite' || (o.type === 'lobe' && o.mode === 'salve'))) continue;\\n      for (let c = 0; c < o.cells.length; c++) {\\n        const cell = o.cells[c];\\n        if (!cell[2] && hypot(cell[0] - p.x, cell[1] - p.y) <= 10) { cell[2] = 1; any = true; }\\n      }\\n      let on = 0;\\n      for (let c = 0; c < o.cells.length; c++) if (o.cells[c][2]) on++;\\n      o.prog = o.cells.length ? on / o.cells.length : 1;\\n      if (o.prog >= 0.9 && !o.done) {\\n        o.done = true; o.alive = false; o.drain = 0;\\n        S.vitals = Math.min(99, S.vitals + 2 * tune.patient.healing);\\n        award(S, p, 'clean', 80, tune);\\n        pushEv(S, ['heal', o.id]);\\n      }\\n    }\\n    if (!any && p.trigEdge) { /* salve cannot harm */ }\\n  }\\n\\n  function stepSyringe(S, p, dt, tune) {\\n    if (p.cool > 0) p.cool -= dt;\\n    const down = p.trig > 0.3;\\n    if (down && p.cool <= 0) {\\n      if (p.fill < 1) p.fill = Math.min(1, p.fill + dt / 0.55);\\n      else p.over += dt;\\n    }\\n    if (p.trigRelease && p.fill > 0.05 && p.cool <= 0) {\\n      const bubble = p.over >= 0.3;\\n      /* A closed reed or voice is still a target: the needle finds it and the tissue splits. */\\n      const tgt = nearest(S, p, 10, o => {\\n        if (!o || o.done || !o.alive || covered(S, o)) return false;\\n        if (o.type === 'reed' || o.type === 'voice') return true;\\n        return canTouch(S, o) && (o.type === 'clot' || (o.type === 'lobe' && o.mode === 'syringe'));\\n      });\\n      if (tgt) {\\n        if ((tgt.type === 'reed' || tgt.type === 'voice') && !tgt.window) {\\n          addObj(S, { type: 'laceration', x: tgt.x + 6, y: tgt.y, r: 8, order: 50, drain: 0.2 });\\n          slip(S, p, 'spit', 2, tune);\\n        } else {\\n          const g = bubble ? 'sloppy' : (p.fill >= 0.9 ? 'textbook' : 'clean');\\n          tgt.dosed = true;\\n          tgt.dose = (bubble ? 0.5 : 1) * p.fill;\\n          if (tgt.follow === 'salve') {\\n            tgt.mode = 'salve';\\n            if (!tgt.cells) {\\n              const r = tgt.r || 8;\\n              tgt.cells = [];\\n              for (let y = -r; y <= r; y += 4) for (let x = -r; x <= r; x += 4) {\\n                if (x * x + y * y <= r * r) tgt.cells.push([tgt.x + x, tgt.y + y, 0]);\\n              }\\n            }\\n          } else if (tgt.type === 'clot') { tgt.drain = 0.1; }\\n          else { tgt.done = true; tgt.alive = false; tgt.drain = 0; }\\n          award(S, p, g, 90, tune);\\n          pushEv(S, ['inject', tgt.id, g]);\\n        }\\n      } else {\\n        const g = bubble ? 'sloppy' : (p.fill >= 0.9 ? 'textbook' : 'clean');\\n        const add = syringeDose(S, tune) * p.fill * (bubble ? 0.5 : 1);\\n        S.vitals = Math.min(99, S.vitals + add);\\n        award(S, p, g, 40, tune);\\n        S.flags.iv = (S.flags.iv || 0) + 1;\\n        pushEv(S, ['iv', Math.round(add), g]);\\n      }\\n      p.fill = 0; p.over = 0; p.cool = 0.35;\\n    }\\n    if (!down && p.trigRelease === false) { /* keep fill while aiming */ }\\n  }\\n\\n  function stepCautery(S, p, dt, tune) {\\n    if (p.lock > 0) { p.lock -= dt; p.heat = Math.max(0, p.heat - 0.6 * dt); return; }\\n    const down = p.trig > 0.3;\\n    if (!down) {\\n      p.heat = Math.max(0, p.heat - 0.6 * dt);\\n      p.bareT = 0;\\n      return;\\n    }\\n    p.heat += tune.fluids.cauteryHeat * dt;\\n    if (p.heat >= 1) { p.lock = 1.2; p.heat = 1; slip(S, p, 'lock', 1, tune); pushEv(S, ['lock', p.id]); return; }\\n    if (nerveHit(S, p, tune)) return;\\n    const tgt = nearest(S, p, 6, o => canTouch(S, o) && (o.type === 'polyp' || o.type === 'bleeder' || o.type === 'rupture' || o.type === 'bead' || o.type === 'uvula' || o.type === 'eye' || o.type === 'tremass' || (o.type === 'lobe' && o.mode === 'cautery') || o.type === 'barb'));\\n    if (tgt) {\\n      p.bareT = 0;\\n      tgt.burn = (tgt.burn || 0) + dt;\\n      tgt.prog = tgt.burn / (tgt.need || 0.5);\\n      if (tgt.burn >= (tgt.need || 0.5) / Math.max(0.25, tune.strains.health) && !tgt.done) {\\n        const dirty = tgt.charred || p.lockedDuring;\\n        const g = (!tgt.charred && p.lock <= 0 && !p.hadLock) ? 'textbook' : 'clean';\\n        tgt.done = true; tgt.alive = false; tgt.drain = 0; tgt.grade = g;\\n        p.burned += 1;\\n        award(S, p, g, 90, tune);\\n        pushEv(S, ['burn', tgt.id, g]);\\n      }\\n    } else {\\n      p.bareT = (p.bareT || 0) + dt;\\n      if (p.bareT >= 0.25) {\\n        /* char on the field */\\n        p.charT = (p.charT || 0) + dt;\\n        S.vitals -= 0.8 * dt * tune.patient.slip;\\n        if (p.bareT >= 0.6 && !p.charSlip) { p.charSlip = true; slip(S, p, 'char', 2, tune); pushEv(S, ['char', Math.round(p.x), Math.round(p.y)]); }\\n      }\\n    }\\n  }\\n\\n  function stepSuction(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    const pool = nearest(S, p, 14, o => o.type === 'pool' && !o.done && o.vol > 0);\\n    if (!pool) return;\\n    const rate = tune.fluids.suction;\\n    const before = pool.vol;\\n    pool.vol = Math.max(0, pool.vol - rate * dt);\\n    p.suctioned += before - pool.vol;\\n    pool.prog = 1 - pool.vol / (pool.max || 1);\\n    if (pool.vol <= 0.2) { pool.done = true; pool.alive = false; pool.vol = 0; pushEv(S, ['dry', pool.id]); }\\n  }\\n\\n  function stepSonar(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    let rad = 38;\\n    if (S.activeDoc === 'vale' || S.gift === 'breath') rad *= 1.25;\\n    if (S.gift === 'both' && S.activeDoc === 'vale') rad *= 1.25;\\n    p.sonarR = rad;\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n      if (!o.hidden || o.done) continue;\\n      if (hypot(o.x - p.x, o.y - p.y) <= rad) { o.marked = true; o.markT = 4; pushEv(S, ['mark', o.id]); }\\n    }\\n    if (S.device && !S.device.shown && hypot(p.x - (S.device.x || 213), p.y - (S.device.y || 116)) <= rad) {\\n      S.device.shown = true;\\n      for (const o of S.objects) if (o.needsBoard) { o.hidden = false; o.marked = true; o.markT = 6; }\\n      pushEv(S, ['board', 1]);\\n    }\\n    if (S.strain && S.strain.kind === 'legato') {\\n      for (const w of S.strain.worms || []) if (hypot(w.x - p.x, w.y - p.y) <= rad) w.marked = true;\\n    }\\n  }\\n\\n  function applyTools(S, p, dt, tune) {\\n    if (p.gone) return;\\n    if (inDome(S, p.x, p.y)) return;\\n    if (p.swap > 0) p.swap -= dt;\\n    p.ox = p.x; p.oy = p.y;\\n    const tool = p.tool;\\n    if (tool === 'forceps') stepForceps(S, p, dt, tune);\\n\",\"total_lines\":1767}}","is_error":false},{"type":"tool_result","tool_use_id":"call-4cf49c5a-d0ab-438d-9af2-b75ad31988a9-31","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"830→\\n  function stepStrain(S, worldDt, handDt, tune) {\\n    const st = S.strain;\\n    if (!st || st.done) return;\\n    const sp = tune.strains.speed;\\n    if (st.kind === 'staccato') stepStaccato(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'legato') stepLegato(S, st, worldDt, handDt, tune, sp);\\n    else if (st.kind === 'tremolo') stepTremolo(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'dacapo') stepDacapo(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'fermata') stepFermata(S, st, worldDt, tune, sp);\\n840→    else if (st.kind === 'cantor') stepCantor(S, st, worldDt, tune, sp);\\n  }\\n\\n  function stepStaccato(S, st, dt, tune, sp) {\\n    st.t += dt;\\n    const beat = tune.strains.beat;\\n    for (const b of st.beads) {\\n      if (b.dead) continue;\\n      b.landIn -= dt * sp;\\n      if (!b.hopped && b.landIn < 0.5) b.hopped = true;\\n850→      if (b.landIn <= 0 && !b.landed) {\\n        b.landed = true; b.x = b.tx; b.y = b.ty;\\n        addObj(S, { type: 'laceration', x: b.x, y: b.y, r: 8, order: 40, drain: 0.2, tag: 'bite' });\\n        pushEv(S, ['bite', Math.round(b.x), Math.round(b.y)]);\\n      }\\n      if (!b.landed) {\\n        const u = clamp(1 - b.landIn / b.flight, 0, 1);\\n        b.x = b.x0 + (b.tx - b.x0) * u;\\n        b.y = b.y0 + (b.ty - b.y0) * u;\\n      }\\n860→    }\\n    /* cautery kills beads: mirrored onto objects of type bead */\\n    let nests = 0;\\n    for (const o of S.objects) if (o.type === 'nest' && !o.done && o.tag === st.tag) nests++;\\n    if (!nests && !st.collapse) { st.collapse = 3; }\\n    if (st.collapse > 0) {\\n      st.collapse -= dt;\\n      if (st.collapse <= 0) {\\n        for (const b of st.beads) b.dead = true;\\n        for (const o of S.objects) if (o.type === 'bead' && o.tag === st.tag) { o.done = true; o.alive = false; }\\n870→        st.done = true;\\n      }\\n    }\\n    syncBeads(S, st);\\n    if (st.beads.length && st.beads.every(b => b.dead) && nests === 0) st.done = true;\\n  }\\n\\n  function syncBeads(S, st) {\\n    for (const b of st.beads) {\\n      if (b.dead) continue;\\n880→      let o = b.oid ? objById(S, b.oid) : null;\\n      if (!o) {\\n        o = addObj(S, { type: 'bead', x: b.x, y: b.y, need: 0.12, order: 5, tag: st.tag, drain: 0 });\\n        b.oid = o.id;\\n      } else {\\n        o.x = b.x; o.y = b.y;\\n        if (o.done) b.dead = true;\\n      }\\n    }\\n  }\\n890→\\n  function stepLegato(S, st, dt, handDt, tune, sp) {\\n    for (const w of st.worms) {\\n      if (w.done) continue;\\n      w.t += dt * sp;\\n      /* head crawls along its path until surfaced */\\n      if (!w.surfaced && !w.out) {\\n        w.along = Math.min(w.pathLen, w.along + 18 * dt * sp);\\n        const p = pointAlong(w.path, w.along);\\n        w.x = p[0]; w.y = p[1];\\n900→        /* open a slur guide when the head nears it */\\n        for (const g of w.slurs) {\\n          if (g.opened || g.done) continue;\\n          if (hypot(w.x - g.x, w.y - g.y) < 28) {\\n            g.opened = true;\\n            const o = addObj(S, { type: 'slur', x: g.x, y: g.y, len: 18, order: 1, tag: 'slur-' + w.id + '-' + g.i, drain: 0, guide: [[g.x - 9, g.y], [g.x + 9, g.y]] });\\n            g.oid = o.id;\\n          }\\n        }\\n      }\\n910→      for (const g of w.slurs) {\\n        if (!g.oid || g.done) continue;\\n        const o = objById(S, g.oid);\\n        if (o && o.done) g.done = true;\\n      }\\n      const slursLeft = w.slurs.filter(g => !g.done).length;\\n      if (!slursLeft && !w.surfaced) {\\n        w.surfaced = true; w.marked = true;\\n        const head = addObj(S, {\\n          type: 'shard', x: w.x, y: w.y, axis: w.axis || [1, 0], depth: 18, order: 2,\\n920→          tag: 'legato-head', worm: w.id, tension: 70, drain: 0.15, hidden: false,\\n          holdZone: w.hold || null, barbs: w.barbAt || 0,\\n        });\\n        w.head = head.id;\\n      }\\n      const head = w.head ? objById(S, w.head) : null;\\n      if (head && head.snapped && !w.snapped) {\\n        w.snapped = true; st.snapped = true;\\n        /* regrow a head further along and flee */\\n        head.done = true; head.alive = false;\\n930→        w.surfaced = false; w.out = false; w.head = 0;\\n        w.along = Math.min(w.pathLen - 4, w.along + 30);\\n        w.slurs.push({ i: 90 + w.slurs.length, x: w.x + 16, y: w.y, opened: false, done: false });\\n        pushEv(S, ['regrow', w.id]);\\n      }\\n      if (head && head.done && !w.out) {\\n        w.pulled = (w.pulled || 0) + 1;\\n        /* barb every 4th segment: if not clamped, snapping already handled via tension */\\n        if (w.barbAt && w.pulled % 4 === 0 && !head.clamped && !w.barbCleared) {\\n          /* require a clamp before the next length counts — head.done means the whole pull finished.\\n940→             Barbs are separate cautery objects spawned at the hold. */\\n        }\\n        w.segments -= 4;\\n        if (w.segments <= w.half && !w.split && st.worms.length < 3) {\\n          w.split = true; w.half = -1;\\n          st.worms.push(makeWorm(S, w.x + 20, w.y + 14, Math.max(4, w.segments >> 1), w.id + 1));\\n          pushEv(S, ['split', w.id]);\\n        }\\n        if (w.segments <= 0) { w.done = true; w.out = true; }\\n        else {\\n950→          /* next length */\\n          w.out = false; w.surfaced = true;\\n          const h2 = addObj(S, {\\n            type: 'shard', x: w.x, y: w.y, axis: [1, 0], depth: 14, order: 2,\\n            tag: 'legato-head', worm: w.id, tension: 70, drain: 0.1,\\n            holdZone: w.barbAt && (w.pulled % 4 === 0) ? [w.x + 30, w.y, 16] : null,\\n          });\\n          w.head = h2.id;\\n          if (w.barbAt && w.pulled % 4 === 0) {\\n            addObj(S, { type: 'barb', x: w.x + 30, y: w.y, need: 0.35, order: 3, tag: 'barb-' + w.id, drain: 0 });\\n960→          }\\n        }\\n      }\\n    }\\n    if (st.worms.every(w => w.done)) st.done = true;\\n  }\\n\\n  function makeWorm(S, x, y, segments, id) {\\n    const path = [];\\n    for (let i = 0; i < 8; i++) path.push([x + i * 14, y + Math.sin(i) * 8]);\\n970→    let pathLen = 0;\\n    for (let i = 1; i < path.length; i++) pathLen += hypot(path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1]);\\n    const slurs = [0.25, 0.5, 0.75].map((u, i) => {\\n      const p = pointAlong(path, pathLen * u);\\n      return { i, x: p[0], y: p[1], opened: false, done: false };\\n    });\\n    return { id, x, y, path, pathLen, along: 0, segments, half: segments / 2, slurs, surfaced: false, done: false, t: 0, split: false, pulled: 0, barbAt: 4, marked: false, axis: [1, 0] };\\n  }\\n  function pointAlong(path, dist) {\\n    let left = dist;\\n980→    for (let i = 1; i < path.length; i++) {\\n      const L = hypot(path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1]) || 1;\\n      if (left <= L) {\\n        const u = left / L;\\n        return [path[i - 1][0] + (path[i][0] - path[i - 1][0]) * u, path[i - 1][1] + (path[i][1] - path[i - 1][1]) * u];\\n      }\\n      left -= L;\\n    }\\n    return path[path.length - 1].slice();\\n  }\\n990→\\n  function stepTremolo(S, st, dt, tune) {\\n    st.t += dt;\\n    st.beat = (st.t % 1);\\n    const peak = st.beat > 0.7;\\n    st.flare = peak;\\n    S.flags.onBeat = st.beat > 0.45 && st.beat < 0.7 ? false : st.beat < 0.15;\\n    /* vitals shake and drain */\\n    if (!S.breath) S.vitals -= 0.6 * st.amp * dt * tune.strains.damage;\\n    for (const o of S.objects) if (o.type === 'reed' && o.tag === 'reed') o.window = !!st.flare;\\n1000→    const reeds = S.objects.filter(o => o.type === 'reed' && !o.done);\\n    if (st.stage === 1 && reeds.length === 0) { st.stage = 2; st.amp = Math.min(st.amp, 0.2); }\\n    if (st.amp <= 0.2 && st.stage === 1) st.stage = 2;\\n    if (st.stage === 2) {\\n      st.wake -= dt;\\n      if (st.wake <= 0) {\\n        st.wake = 6;\\n        /* a reed returns */\\n        if (S.objects.filter(o => o.type === 'reed' && !o.done).length < 2) {\\n          addObj(S, { type: 'reed', x: st.x - 20 + rnd(S) * 40, y: st.y - 10, order: 1, tag: 'reed', drain: 0, window: false });\\n1010→        }\\n      }\\n      const mass = S.objects.find(o => o.type === 'tremass');\\n      if (mass && mass.done && st.stage === 2) {\\n        st.stage = 3;\\n        addObj(S, { type: 'shard', x: st.x, y: st.y, axis: [1, 0], depth: 40, order: 4, tag: 'tremolo-pull', tension: 90, drain: 0.2 });\\n      }\\n    }\\n    if (st.stage === 3) {\\n      const pull = S.objects.find(o => o.tag === 'tremolo-pull');\\n1020→      if (pull && pull.done) {\\n        st.done = true;\\n        for (const o of S.objects) if (o.type === 'reed' && !o.done) { o.done = true; o.alive = false; }\\n      }\\n    }\\n    /* amp falls when a reed is dosed */\\n    const deadReeds = st.reed0 - S.objects.filter(o => o.type === 'reed' && !o.done).length;\\n    st.amp = clamp(1 - deadReeds * 0.2, 0.15, 1);\\n    if (st.stage >= 2) st.amp = Math.min(st.amp, 0.2);\\n  }\\n1030→\\n  function stepDacapo(S, st, dt, tune, sp) {\\n    st.t += dt * sp;\\n    let anyDead = false;\\n    for (const L of st.lobes) {\\n      if (L.dead) { anyDead = true; continue; }\\n      const period = L.period / (st.round === 2 ? 2 : 1);\\n      const openFor = L.openFor / (st.round === 2 ? 2 : 1);\\n      const u = st.t % period;\\n      L.open = u < openFor;\\n1040→      const o = objById(S, L.oid);\\n      if (o) { o.open = L.open && !L.dead; o.x = L.x; o.y = L.y; if (o.done && !L.dead) { L.dead = true; anyDead = true; if (st.count < 0) st.count = 10; } }\\n    }\\n    if (st.count >= 0) {\\n      st.count -= dt;\\n      if (st.count <= 0 && st.lobes.some(L => L.dead) && st.lobes.some(L => !L.dead)) {\\n        /* from the top */\\n        for (const L of st.lobes) {\\n          L.dead = false;\\n          const o = objById(S, L.oid);\\n1050→          if (o) { o.done = false; o.alive = true; o.prog = 0; o.burn = 0; o.dosed = false; o.open = false; if (o.cells) for (const c of o.cells) c[2] = 0; }\\n        }\\n        S.vitals -= 8;\\n        st.count = -1;\\n        st.repeated = (st.repeated || 0) + 1;\\n        if (st.round === 1) { st.round = 2; st.t = 0; spawnBeadsN(S, st, 4); }\\n        pushEv(S, ['dacapo', st.repeated]);\\n      } else if (st.count <= 0) st.count = -1;\\n    }\\n    if (st.lobes.every(L => L.dead) && st.count < 0) {\\n1060→      if (st.round === 1) {\\n        st.round = 2; st.t = 0; st.count = -1;\\n        for (const L of st.lobes) {\\n          L.dead = false;\\n          const o = objById(S, L.oid);\\n          if (o) { o.done = false; o.alive = true; o.prog = 0; o.burn = 0; o.dosed = false; if (o.cells) for (const c of o.cells) c[2] = 0; }\\n        }\\n        spawnBeadsN(S, st, 4);\\n        pushEv(S, ['round2', 1]);\\n      } else if (S.objects.every(o => o.type !== 'bead' || o.done)) st.done = true;\\n1070→    }\\n    if (st.round === 2 && st.lobes.every(L => L.dead) && S.objects.every(o => o.type !== 'bead' || o.done || o.tag !== 'dacapo-bead')) st.done = true;\\n  }\\n\\n  function spawnBeadsN(S, st, n) {\\n    st.beads = st.beads || [];\\n    for (let i = 0; i < n; i++) {\\n      const b = { x: 180 + i * 16, y: 100, tx: 190 + i * 14, ty: 130, x0: 180 + i * 16, y0: 100, landIn: 0.8, flight: 0.8, dead: false, landed: false, hopped: false };\\n      st.beads.push(b);\\n      const o = addObj(S, { type: 'bead', x: b.x, y: b.y, need: 0.12, order: 6, tag: 'dacapo-bead', drain: 0 });\\n1080→      b.oid = o.id;\\n    }\\n    if (!st.kindBead) st.kindBead = true;\\n  }\\n\\n  function stepFermata(S, st, dt, tune) {\\n    st.t += dt;\\n    for (const d of st.domes) if (d.t > 0) d.t -= dt;\\n    st.domes = st.domes.filter(d => d.t > 0);\\n    if (st.stage === 1 && st.domes.length === 0 && !(st.eyeOpen > 0)) {\\n1090→      st.eyeOpen = S.breath ? 2.8 : 0.7;\\n      st.eye.open = true;\\n      const o = objById(S, st.eye.oid);\\n      if (o) o.open = true;\\n    }\\n    if (st.eyeOpen > 0) {\\n      st.eyeOpen -= dt;\\n      if (st.eyeOpen <= 0) {\\n        st.eye.open = false;\\n        const o = objById(S, st.eye.oid);\\n1100→        if (o && !o.done) o.open = false;\\n        if (st.hits < 3 && st.stage === 1) {\\n          /* raise another dome */\\n          if (st.domes.length < 3) st.domes.push({ x: st.eye.x, y: st.eye.y, r: 34, t: 5 });\\n        }\\n      }\\n    }\\n    const eye = objById(S, st.eye.oid);\\n    if (eye && eye.done) { st.hits += 1; eye.done = false; eye.alive = true; eye.burn = 0; eye.prog = 0; eye.open = false; st.eye.open = false; }\\n    if (st.hits >= 3 && st.stage === 1) {\\n1110→      st.stage = 2;\\n      st.eye.x = 250; st.eye.y = 90; st.eye.hidden = true;\\n      if (eye) { eye.x = 250; eye.y = 90; eye.hidden = true; eye.marked = false; eye.done = false; eye.alive = true; }\\n      addObj(S, { type: 'shard', x: 160, y: 140, axis: [1, 0], depth: 12, order: 3, tag: 'sliver-a', drain: 0.1, hidden: true });\\n      addObj(S, { type: 'shard', x: 180, y: 150, axis: [0.6, 0.8], depth: 12, order: 3, tag: 'sliver-b', drain: 0.1, hidden: true });\\n    }\\n    if (st.stage === 2 && eye && eye.marked && st.hits < 4) { eye.hidden = false; eye.open = true; }\\n    if (st.stage >= 2 && eye && st.hits >= 4) { eye.open = false; eye.drain = 0; }\\n    if (st.stage === 2) {\\n      const slivers = S.objects.filter(o => o.tag === 'sliver-a' || o.tag === 'sliver-b');\\n1120→      if (st.hits >= 4 && slivers.length && slivers.every(o => o.done)) {\\n        st.stage = 3;\\n        addObj(S, { type: 'note', x: st.eye.x, y: st.eye.y, axis: [0, -1], depth: 28, tension: 40, order: 5, tag: 'fermata-pull', drain: 0.15 });\\n      }\\n    }\\n    if (st.stage === 3) {\\n      const pull = S.objects.find(o => o.tag === 'fermata-pull');\\n      if (pull && pull.done) {\\n        st.done = true;\\n        if (eye) { eye.done = true; eye.alive = false; eye.open = false; eye.drain = 0; }\\n1130→      }\\n    }\\n  }\\n\\n  function stepCantor(S, st, dt, tune) {\\n    st.t += dt;\\n    if (st.move === 1) {\\n      /* tendrils then uvulas, objects already spawned by the phase */\\n      const left = S.objects.filter(o => (o.tag === 'tendril' || o.tag === 'uvula') && !o.done);\\n      if (!left.length) { st.move = 2; st.t = 0; S.clock += 120; S.flags.hush = true; pushEv(S, ['movement', 2]); spawnVoice(S, st); }\\n1140→    } else if (st.move === 2) {\\n      S.flags.hush = true;\\n      st.beat = (st.t % 1);\\n      for (const o of S.objects) if (o.type === 'voice') o.window = st.beat > 0.62;\\n      if (st.domes) {\\n        for (const d of st.domes) d.t -= dt;\\n        st.domes = st.domes.filter(d => d.t > 0);\\n      }\\n      st.jitter = true;\\n      const voices = S.objects.filter(o => o.type === 'voice' && !o.done);\\n1150→      if (!voices.length) { st.move = 3; st.t = 0; S.clock += 120; S.flags.hush = false; st.signs = 0; pushEv(S, ['movement', 3]); }\\n    } else if (st.move === 3) {\\n      st.cycleT = (st.cycleT || 0) + dt;\\n      if (!st.winding && st.cycleT >= 20) { st.winding = 3; st.cycleT = 0; openRepeat(S, st); }\\n      if (st.winding > 0) {\\n        st.winding -= dt;\\n        if (st.winding <= 0) {\\n          const sign = S.objects.find(o => o.tag === 'repeat');\\n          if (sign && !sign.done) {\\n            forceRewind(S, true);\\n1160→            const now = S.strain;\\n            if (now) now.rewound = (now.rewound || 0) + 1;\\n          } else if (sign && sign.done) {\\n            st.signs = (st.signs || 0) + 1;\\n            sign.tag = 'repeat-spent';\\n          }\\n          st.winding = 0;\\n          closeRepeat(S);\\n        }\\n      }\\n1170→      if ((st.signs || 0) >= 6 && S.strain === st) { st.move = 4; st.t = 0; S.clock += 120; pushEv(S, ['movement', 4]); spawnCoda(S, st); }\\n    } else if (st.move === 4) {\\n      st.beat = (st.t % 0.8) / 0.8;\\n      S.flags.onBeat = st.beat < 0.25;\\n      const spiral = S.objects.find(o => o.type === 'spiral' && o.tag === 'last-note');\\n      const note = S.objects.find(o => o.tag === 'the-note');\\n      const wound = S.objects.find(o => o.tag === 'final-wound');\\n      if (spiral && spiral.done && !st.noteOut) {\\n        st.noteOut = true;\\n        addObj(S, { type: 'note', x: 213, y: 116, axis: [0, -1], depth: 36, tension: 80, order: 2, tag: 'the-note', drain: 0 });\\n1180→      }\\n      if (note && note.done && !wound) {\\n        addObj(S, { type: 'wound', x: 213, y: 130, stitches: 6, order: 3, tag: 'final-wound', drain: 0.3 });\\n      }\\n      if (wound && wound.done) st.done = true;\\n    }\\n  }\\n\\n  function openRepeat(S, st) {\\n    const existing = S.objects.find(o => o.tag === 'repeat');\\n1190→    if (existing) { existing.done = false; existing.alive = true; existing.open = true; existing.prog = 0; return existing; }\\n    return addObj(S, { type: 'repeat', x: 213, y: 100, len: 36, order: 1, tag: 'repeat', open: true, drain: 0, guide: [[190, 100], [236, 100]] });\\n  }\\n  function closeRepeat(S) {\\n    for (const o of S.objects) if (o.tag === 'repeat' && !o.done) { o.open = false; }\\n  }\\n  function spawnVoice(S, st) {\\n    st.domes = [{ x: 90, y: 70, r: 28, t: 4 }, { x: 330, y: 70, r: 28, t: 5 }];\\n    for (let i = 0; i < 3; i++) addObj(S, { type: 'voice', x: 170 + i * 36, y: 150, hidden: true, order: 1, tag: 'voice', drain: 0.15, window: false });\\n    st.jitter = true; st.amp = 0.45;\\n1200→  }\\n  function spawnCoda(S, st) {\\n    const guide = [];\\n    for (let i = 0; i <= 16; i++) {\\n      const a = i / 16 * Math.PI * 1.6;\\n      guide.push([213 + Math.cos(a) * (20 + i * 3), 116 + Math.sin(a) * (12 + i * 2)]);\\n    }\\n    addObj(S, { type: 'spiral', x: 213, y: 116, guide, order: 1, tag: 'last-note', beatLock: true, drain: 0, ring: false });\\n  }\\n\\n1210→  function spawnStrain(S, kind, opts) {\\n    opts = opts || {};\\n    if (kind === 'staccato') {\\n      const st = { kind, tag: opts.tag || 'stacc', t: 0, beads: [], done: false, collapse: 0 };\\n      const n = opts.nests || 2;\\n      for (let i = 0; i < n; i++) {\\n        addObj(S, { type: 'nest', x: opts.x || (180 + i * 40), y: opts.y || 120, hidden: true, order: 2, tag: st.tag, slash: true, drain: 0.15, r: 8 });\\n      }\\n      const beads = opts.beads || 4;\\n      for (let i = 0; i < beads; i++) {\\n1220→        st.beads.push({ x: 160 + i * 12, y: 90, x0: 160 + i * 12, y0: 90, tx: 170 + (i % 3) * 18, ty: 140, landIn: (opts.landIn || 1.1) + i * 0.2, flight: 0.7, dead: false, landed: false, hopped: false });\\n      }\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'legato') {\\n      const seg = opts.segments || 8;\\n      const w = makeWorm(S, opts.x || 150, opts.y || 120, seg, 1);\\n      w.marked = false;\\n      const st = { kind, worms: [w], done: false, snapped: false };\\n1230→      /* head starts hidden: a sonar target */\\n      addObj(S, { type: 'hold', x: w.x, y: w.y, hidden: true, order: 0, tag: 'legato-hide', drain: 0 });\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'tremolo') {\\n      const st = { kind, t: 0, amp: 1, stage: 1, x: opts.x || 213, y: opts.y || 116, wake: 6, reed0: 5, done: false, jitter: true, beat: 0, flare: false };\\n      for (let i = 0; i < 5; i++) {\\n        const a = -Math.PI / 2 + i * TAU / 5;\\n        addObj(S, { type: 'reed', x: st.x + Math.cos(a) * 28, y: st.y + Math.sin(a) * 18, order: 1, tag: 'reed', drain: 0, window: false });\\n1240→      }\\n      addObj(S, { type: 'tremass', x: st.x, y: st.y, need: 3, order: 3, tag: 'tremass', drain: 0.3 });\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'dacapo') {\\n      const lobes = [\\n        { id: 'A', mode: 'cautery', period: 6, openFor: 2.5, x: 180, y: 110 },\\n        { id: 'B', mode: 'slash', period: 7, openFor: 2.5, x: 213, y: 130 },\\n        { id: 'C', mode: 'syringe', period: 9, openFor: 3, x: 246, y: 112 },\\n1250→      ];\\n      const st = { kind, t: 0, round: 1, count: -1, lobes, done: false, repeated: 0 };\\n      for (const L of lobes) {\\n        const spec = { type: 'lobe', x: L.x, y: L.y, mode: L.mode === 'slash' ? 'scalpel' : L.mode, order: 1, tag: 'lobe-' + L.id, open: false, drain: 0.15, need: L.mode === 'cautery' ? 1 : 0.5 };\\n        if (L.mode === 'slash') { spec.guide = [[L.x - 10, L.y], [L.x + 10, L.y]]; spec.mode = 'scalpel'; spec.slash = true; }\\n        if (L.mode === 'syringe') { spec.mode = 'syringe'; spec.follow = 'salve'; }\\n        const o = addObj(S, spec);\\n        L.oid = o.id; L.dead = false; L.open = false;\\n      }\\n      S.strain = st;\\n1260→      return st;\\n    }\\n    if (kind === 'fermata') {\\n      const st = { kind, t: 0, stage: 1, hits: 0, eyeOpen: 0, done: false, jitter: false, amp: 0,\\n        domes: [{ x: 200, y: 116, r: 34, t: 5 }],\\n        eye: { x: 200, y: 116, open: false, hidden: false } };\\n      const o = addObj(S, { type: 'eye', x: 200, y: 116, need: 0.3, order: 1, tag: 'eye', open: false, drain: 0.2 });\\n      st.eye.oid = o.id;\\n      addObj(S, { type: 'eloquent', x: 150, y: 100, guide: [[140, 90], [180, 110]], order: 0, drain: 0, tag: 'eloq' });\\n      S.strain = st;\\n1270→      return st;\\n    }\\n    if (kind === 'cantor') {\\n      const st = { kind, t: 0, move: 1, done: false, signs: 0, jitter: false, amp: 0.4, domes: [] };\\n      for (let i = 0; i < 3; i++) addObj(S, { type: 'tendril', x: 170 + i * 30, y: 100, len: 28, order: 1, tag: 'tendril', drain: 0.15, guide: [[160 + i * 30, 100], [190 + i * 30, 108]] });\\n      for (let i = 0; i < 3; i++) addObj(S, { type: 'uvula', x: 180 + i * 26, y: 140, need: 1.5, order: 2, tag: 'uvula', drain: 0.2 });\\n      S.strain = st;\\n      return st;\\n    }\\n    return null;\\n1280→  }\\n\\n  /* ---------- phase / scripts ---------- */\\n\\n  function phaseClear(S) {\\n    if (S.strain && !S.strain.done) return false;\\n    for (const o of S.objects) {\\n      if (o.done || !o.alive) continue;\\n      if (o.type === 'nerve' || o.type === 'eloquent' || o.type === 'hold' || o.type === 'retractor') continue;\\n      if (o.optional) continue;\\n1290→      if (o.type === 'bead') continue;\\n      return false;\\n    }\\n    if (S.flags.needIv && (S.flags.iv || 0) < S.flags.needIv) return false;\\n    if (S.strain && S.strain.kind === 'staccato') {\\n      const live = (S.strain.beads || []).some(b => !b.dead);\\n      if (live && !S.strain.done) return false;\\n    }\\n    return true;\\n  }\\n1300→\\n  function runScript(S, id, tune) {\\n    if (id === 'dip') { S.flags.dip = 40; }\\n    else if (id === 'crash') { S.flags.crash = 8; }\\n    else if (id === 'breath') { S.flags.needBreath = true; }\\n    else if (id === 'look') { S.flags.needLook = true; }\\n    else if (id === 'lurch') {\\n      slip(S, S.players[0], 'lurch', 3, tune);\\n      for (const o of S.objects) if (!o.done) { o.x += 10; o.y += 4; if (o.origin) { o.origin = [o.origin[0] + 10, o.origin[1] + 4]; } }\\n      S.flags.needLook = true;\",\"content_concise\":\"830→\\n  function stepStrain(S, worldDt, handDt, tune) {\\n    const st = S.strain;\\n    if (!st || st.done) return;\\n    const sp = tune.strains.speed;\\n    if (st.kind === 'staccato') stepStaccato(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'legato') stepLegato(S, st, worldDt, handDt, tune, sp);\\n    else if (st.kind === 'tremolo') stepTremolo(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'dacapo') stepDacapo(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'fermata') stepFermata(S, st, worldDt, tune, sp);\\n840→    else if (st.kind === 'cantor') stepCantor(S, st, worldDt, tune, sp);\\n  }\\n\\n  function stepStaccato(S, st, dt, tune, sp) {\\n    st.t += dt;\\n    const beat = tune.strains.beat;\\n    for (const b of st.beads) {\\n      if (b.dead) continue;\\n      b.landIn -= dt * sp;\\n      if (!b.hopped && b.landIn < 0.5) b.hopped = true;\\n850→      if (b.landIn <= 0 && !b.landed) {\\n        b.landed = true; b.x = b.tx; b.y = b.ty;\\n        addObj(S, { type: 'laceration', x: b.x, y: b.y, r: 8, order: 40, drain: 0.2, tag: 'bite' });\\n        pushEv(S, ['bite', Math.round(b.x), Math.round(b.y)]);\\n      }\\n      if (!b.landed) {\\n        const u = clamp(1 - b.landIn / b.flight, 0, 1);\\n        b.x = b.x0 + (b.tx - b.x0) * u;\\n        b.y = b.y0 + (b.ty - b.y0) * u;\\n      }\\n860→    }\\n    /* cautery kills beads: mirrored onto objects of type bead */\\n    let nests = 0;\\n    for (const o of S.objects) if (o.type === 'nest' && !o.done && o.tag === st.tag) nests++;\\n    if (!nests && !st.collapse) { st.collapse = 3; }\\n    if (st.collapse > 0) {\\n      st.collapse -= dt;\\n      if (st.collapse <= 0) {\\n        for (const b of st.beads) b.dead = true;\\n        for (const o of S.objects) if (o.type === 'bead' && o.tag === st.tag) { o.done = true; o.alive = false; }\\n870→        st.done = true;\\n      }\\n    }\\n    syncBeads(S, st);\\n    if (st.beads.length && st.beads.every(b => b.dead) && nests === 0) st.done = true;\\n  }\\n\\n  function syncBeads(S, st) {\\n    for (const b of st.beads) {\\n      if (b.dead) continue;\\n880→      let o = b.oid ? objById(S, b.oid) : null;\\n      if (!o) {\\n        o = addObj(S, { type: 'bead', x: b.x, y: b.y, need: 0.12, order: 5, tag: st.tag, drain: 0 });\\n        b.oid = o.id;\\n      } else {\\n        o.x = b.x; o.y = b.y;\\n        if (o.done) b.dead = true;\\n      }\\n    }\\n  }\\n890→\\n  function stepLegato(S, st, dt, handDt, tune, sp) {\\n    for (const w of st.worms) {\\n      if (w.done) continue;\\n      w.t += dt * sp;\\n      /* head crawls along its path until surfaced */\\n      if (!w.surfaced && !w.out) {\\n        w.along = Math.min(w.pathLen, w.along + 18 * dt * sp);\\n        const p = pointAlong(w.path, w.along);\\n        w.x = p[0]; w.y = p[1];\\n900→        /* open a slur guide when the head nears it */\\n        for (const g of w.slurs) {\\n          if (g.opened || g.done) continue;\\n          if (hypot(w.x - g.x, w.y - g.y) < 28) {\\n            g.opened = true;\\n            const o = addObj(S, { type: 'slur', x: g.x, y: g.y, len: 18, order: 1, tag: 'slur-' + w.id + '-' + g.i, drain: 0, guide: [[g.x - 9, g.y], [g.x + 9, g.y]] });\\n            g.oid = o.id;\\n          }\\n        }\\n      }\\n910→      for (const g of w.slurs) {\\n        if (!g.oid || g.done) continue;\\n        const o = objById(S, g.oid);\\n        if (o && o.done) g.done = true;\\n      }\\n      const slursLeft = w.slurs.filter(g => !g.done).length;\\n      if (!slursLeft && !w.surfaced) {\\n        w.surfaced = true; w.marked = true;\\n        const head = addObj(S, {\\n          type: 'shard', x: w.x, y: w.y, axis: w.axis || [1, 0], depth: 18, order: 2,\\n920→          tag: 'legato-head', worm: w.id, tension: 70, drain: 0.15, hidden: false,\\n          holdZone: w.hold || null, barbs: w.barbAt || 0,\\n        });\\n        w.head = head.id;\\n      }\\n      const head = w.head ? objById(S, w.head) : null;\\n      if (head && head.snapped && !w.snapped) {\\n        w.snapped = true; st.snapped = true;\\n        /* regrow a head further along and flee */\\n        head.done = true; head.alive = false;\\n930→        w.surfaced = false; w.out = false; w.head = 0;\\n        w.along = Math.min(w.pathLen - 4, w.along + 30);\\n        w.slurs.push({ i: 90 + w.slurs.length, x: w.x + 16, y: w.y, opened: false, done: false });\\n        pushEv(S, ['regrow', w.id]);\\n      }\\n      if (head && head.done && !w.out) {\\n        w.pulled = (w.pulled || 0) + 1;\\n        /* barb every 4th segment: if not clamped, snapping already handled via tension */\\n        if (w.barbAt && w.pulled % 4 === 0 && !head.clamped && !w.barbCleared) {\\n          /* require a clamp before the next length counts — head.done means the whole pull finished.\\n940→             Barbs are separate cautery objects spawned at the hold. */\\n        }\\n        w.segments -= 4;\\n        if (w.segments <= w.half && !w.split && st.worms.length < 3) {\\n          w.split = true; w.half = -1;\\n          st.worms.push(makeWorm(S, w.x + 20, w.y + 14, Math.max(4, w.segments >> 1), w.id + 1));\\n          pushEv(S, ['split', w.id]);\\n        }\\n        if (w.segments <= 0) { w.done = true; w.out = true; }\\n        else {\\n950→          /* next length */\\n          w.out = false; w.surfaced = true;\\n          const h2 = addObj(S, {\\n            type: 'shard', x: w.x, y: w.y, axis: [1, 0], depth: 14, order: 2,\\n            tag: 'legato-head', worm: w.id, tension: 70, drain: 0.1,\\n            holdZone: w.barbAt && (w.pulled % 4 === 0) ? [w.x + 30, w.y, 16] : null,\\n          });\\n          w.head = h2.id;\\n          if (w.barbAt && w.pulled % 4 === 0) {\\n            addObj(S, { type: 'barb', x: w.x + 30, y: w.y, need: 0.35, order: 3, tag: 'barb-' + w.id, drain: 0 });\\n960→          }\\n        }\\n      }\\n    }\\n    if (st.worms.every(w => w.done)) st.done = true;\\n  }\\n\\n  function makeWorm(S, x, y, segments, id) {\\n    const path = [];\\n    for (let i = 0; i < 8; i++) path.push([x + i * 14, y + Math.sin(i) * 8]);\\n970→    let pathLen = 0;\\n    for (let i = 1; i < path.length; i++) pathLen += hypot(path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1]);\\n    const slurs = [0.25, 0.5, 0.75].map((u, i) => {\\n      const p = pointAlong(path, pathLen * u);\\n      return { i, x: p[0], y: p[1], opened: false, done: false };\\n    });\\n    return { id, x, y, path, pathLen, along: 0, segments, half: segments / 2, slurs, surfaced: false, done: false, t: 0, split: false, pulled: 0, barbAt: 4, marked: false, axis: [1, 0] };\\n  }\\n  function pointAlong(path, dist) {\\n    let left = dist;\\n980→    for (let i = 1; i < path.length; i++) {\\n      const L = hypot(path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1]) || 1;\\n      if (left <= L) {\\n        const u = left / L;\\n        return [path[i - 1][0] + (path[i][0] - path[i - 1][0]) * u, path[i - 1][1] + (path[i][1] - path[i - 1][1]) * u];\\n      }\\n      left -= L;\\n    }\\n    return path[path.length - 1].slice();\\n  }\\n990→\\n  function stepTremolo(S, st, dt, tune) {\\n    st.t += dt;\\n    st.beat = (st.t % 1);\\n    const peak = st.beat > 0.7;\\n    st.flare = peak;\\n    S.flags.onBeat = st.beat > 0.45 && st.beat < 0.7 ? false : st.beat < 0.15;\\n    /* vitals shake and drain */\\n    if (!S.breath) S.vitals -= 0.6 * st.amp * dt * tune.strains.damage;\\n    for (const o of S.objects) if (o.type === 'reed' && o.tag === 'reed') o.window = !!st.flare;\\n1000→    const reeds = S.objects.filter(o => o.type === 'reed' && !o.done);\\n    if (st.stage === 1 && reeds.length === 0) { st.stage = 2; st.amp = Math.min(st.amp, 0.2); }\\n    if (st.amp <= 0.2 && st.stage === 1) st.stage = 2;\\n    if (st.stage === 2) {\\n      st.wake -= dt;\\n      if (st.wake <= 0) {\\n        st.wake = 6;\\n        /* a reed returns */\\n        if (S.objects.filter(o => o.type === 'reed' && !o.done).length < 2) {\\n          addObj(S, { type: 'reed', x: st.x - 20 + rnd(S) * 40, y: st.y - 10, order: 1, tag: 'reed', drain: 0, window: false });\\n1010→        }\\n      }\\n      const mass = S.objects.find(o => o.type === 'tremass');\\n      if (mass && mass.done && st.stage === 2) {\\n        st.stage = 3;\\n        addObj(S, { type: 'shard', x: st.x, y: st.y, axis: [1, 0], depth: 40, order: 4, tag: 'tremolo-pull', tension: 90, drain: 0.2 });\\n      }\\n    }\\n    if (st.stage === 3) {\\n      const pull = S.objects.find(o => o.tag === 'tremolo-pull');\\n1020→      if (pull && pull.done) {\\n        st.done = true;\\n        for (const o of S.objects) if (o.type === 'reed' && !o.done) { o.done = true; o.alive = false; }\\n      }\\n    }\\n    /* amp falls when a reed is dosed */\\n    const deadReeds = st.reed0 - S.objects.filter(o => o.type === 'reed' && !o.done).length;\\n    st.amp = clamp(1 - deadReeds * 0.2, 0.15, 1);\\n    if (st.stage >= 2) st.amp = Math.min(st.amp, 0.2);\\n  }\\n1030→\\n  function stepDacapo(S, st, dt, tune, sp) {\\n    st.t += dt * sp;\\n    let anyDead = false;\\n    for (const L of st.lobes) {\\n      if (L.dead) { anyDead = true; continue; }\\n      const period = L.period / (st.round === 2 ? 2 : 1);\\n      const openFor = L.openFor / (st.round === 2 ? 2 : 1);\\n      const u = st.t % period;\\n      L.open = u < openFor;\\n1040→      const o = objById(S, L.oid);\\n      if (o) { o.open = L.open && !L.dead; o.x = L.x; o.y = L.y; if (o.done && !L.dead) { L.dead = true; anyDead = true; if (st.count < 0) st.count = 10; } }\\n    }\\n    if (st.count >= 0) {\\n      st.count -= dt;\\n      if (st.count <= 0 && st.lobes.some(L => L.dead) && st.lobes.some(L => !L.dead)) {\\n        /* from the top */\\n        for (const L of st.lobes) {\\n          L.dead = false;\\n          const o = objById(S, L.oid);\\n1050→          if (o) { o.done = false; o.alive = true; o.prog = 0; o.burn = 0; o.dosed = false; o.open = false; if (o.cells) for (const c of o.cells) c[2] = 0; }\\n        }\\n        S.vitals -= 8;\\n        st.count = -1;\\n        st.repeated = (st.repeated || 0) + 1;\\n        if (st.round === 1) { st.round = 2; st.t = 0; spawnBeadsN(S, st, 4); }\\n        pushEv(S, ['dacapo', st.repeated]);\\n      } else if (st.count <= 0) st.count = -1;\\n    }\\n    if (st.lobes.every(L => L.dead) && st.count < 0) {\\n1060→      if (st.round === 1) {\\n        st.round = 2; st.t = 0; st.count = -1;\\n        for (const L of st.lobes) {\\n          L.dead = false;\\n          const o = objById(S, L.oid);\\n          if (o) { o.done = false; o.alive = true; o.prog = 0; o.burn = 0; o.dosed = false; if (o.cells) for (const c of o.cells) c[2] = 0; }\\n        }\\n        spawnBeadsN(S, st, 4);\\n        pushEv(S, ['round2', 1]);\\n      } else if (S.objects.every(o => o.type !== 'bead' || o.done)) st.done = true;\\n1070→    }\\n    if (st.round === 2 && st.lobes.every(L => L.dead) && S.objects.every(o => o.type !== 'bead' || o.done || o.tag !== 'dacapo-bead')) st.done = true;\\n  }\\n\\n  function spawnBeadsN(S, st, n) {\\n    st.beads = st.beads || [];\\n    for (let i = 0; i < n; i++) {\\n      const b = { x: 180 + i * 16, y: 100, tx: 190 + i * 14, ty: 130, x0: 180 + i * 16, y0: 100, landIn: 0.8, flight: 0.8, dead: false, landed: false, hopped: false };\\n      st.beads.push(b);\\n      const o = addObj(S, { type: 'bead', x: b.x, y: b.y, need: 0.12, order: 6, tag: 'dacapo-bead', drain: 0 });\\n1080→      b.oid = o.id;\\n    }\\n    if (!st.kindBead) st.kindBead = true;\\n  }\\n\\n  function stepFermata(S, st, dt, tune) {\\n    st.t += dt;\\n    for (const d of st.domes) if (d.t > 0) d.t -= dt;\\n    st.domes = st.domes.filter(d => d.t > 0);\\n    if (st.stage === 1 && st.domes.length === 0 && !(st.eyeOpen > 0)) {\\n1090→      st.eyeOpen = S.breath ? 2.8 : 0.7;\\n      st.eye.open = true;\\n      const o = objById(S, st.eye.oid);\\n      if (o) o.open = true;\\n    }\\n    if (st.eyeOpen > 0) {\\n      st.eyeOpen -= dt;\\n      if (st.eyeOpen <= 0) {\\n        st.eye.open = false;\\n        const o = objById(S, st.eye.oid);\\n1100→        if (o && !o.done) o.open = false;\\n        if (st.hits < 3 && st.stage === 1) {\\n          /* raise another dome */\\n          if (st.domes.length < 3) st.domes.push({ x: st.eye.x, y: st.eye.y, r: 34, t: 5 });\\n        }\\n      }\\n    }\\n    const eye = objById(S, st.eye.oid);\\n    if (eye && eye.done) { st.hits += 1; eye.done = false; eye.alive = true; eye.burn = 0; eye.prog = 0; eye.open = false; st.eye.open = false; }\\n    if (st.hits >= 3 && st.stage === 1) {\\n1110→      st.stage = 2;\\n      st.eye.x = 250; st.eye.y = 90; st.eye.hidden = true;\\n      if (eye) { eye.x = 250; eye.y = 90; eye.hidden = true; eye.marked = false; eye.done = false; eye.alive = true; }\\n      addObj(S, { type: 'shard', x: 160, y: 140, axis: [1, 0], depth: 12, order: 3, tag: 'sliver-a', drain: 0.1, hidden: true });\\n      addObj(S, { type: 'shard', x: 180, y: 150, axis: [0.6, 0.8], depth: 12, order: 3, tag: 'sliver-b', drain: 0.1, hidden: true });\\n    }\\n    if (st.stage === 2 && eye && eye.marked && st.hits < 4) { eye.hidden = false; eye.open = true; }\\n    if (st.stage >= 2 && eye && st.hits >= 4) { eye.open = false; eye.drain = 0; }\\n    if (st.stage === 2) {\\n      const slivers = S.objects.filter(o => o.tag === 'sliver-a' || o.tag === 'sliver-b');\\n1120→      if (st.hits >= 4 && slivers.length && slivers.every(o => o.done)) {\\n        st.stage = 3;\\n        addObj(S, { type: 'note', x: st.eye.x, y: st.eye.y, axis: [0, -1], depth: 28, tension: 40, order: 5, tag: 'fermata-pull', drain: 0.15 });\\n      }\\n    }\\n    if (st.stage === 3) {\\n      const pull = S.objects.find(o => o.tag === 'fermata-pull');\\n      if (pull && pull.done) {\\n        st.done = true;\\n        if (eye) { eye.done = true; eye.alive = false; eye.open = false; eye.drain = 0; }\\n1130→      }\\n    }\\n  }\\n\\n  function stepCantor(S, st, dt, tune) {\\n    st.t += dt;\\n    if (st.move === 1) {\\n      /* tendrils then uvulas, objects already spawned by the phase */\\n      const left = S.objects.filter(o => (o.tag === 'tendril' || o.tag === 'uvula') && !o.done);\\n      if (!left.length) { st.move = 2; st.t = 0; S.clock += 120; S.flags.hush = true; pushEv(S, ['movement', 2]); spawnVoice(S, st); }\\n1140→    } else if (st.move === 2) {\\n      S.flags.hush = true;\\n      st.beat = (st.t % 1);\\n      for (const o of S.objects) if (o.type === 'voice') o.window = st.beat > 0.62;\\n      if (st.domes) {\\n        for (const d of st.domes) d.t -= dt;\\n        st.domes = st.domes.filter(d => d.t > 0);\\n      }\\n      st.jitter = true;\\n      const voices = S.objects.filter(o => o.type === 'voice' && !o.done);\\n1150→      if (!voices.length) { st.move = 3; st.t = 0; S.clock += 120; S.flags.hush = false; st.signs = 0; pushEv(S, ['movement', 3]); }\\n    } else if (st.move === 3) {\\n      st.cycleT = (st.cycleT || 0) + dt;\\n      if (!st.winding && st.cycleT >= 20) { st.winding = 3; st.cycleT = 0; openRepeat(S, st); }\\n      if (st.winding > 0) {\\n        st.winding -= dt;\\n        if (st.winding <= 0) {\\n          const sign = S.objects.find(o => o.tag === 'repeat');\\n          if (sign && !sign.done) {\\n            forceRewind(S, true);\\n1160→            const now = S.strain;\\n            if (now) now.rewound = (now.rewound || 0) + 1;\\n          } else if (sign && sign.done) {\\n            st.signs = (st.signs || 0) + 1;\\n            sign.tag = 'repeat-spent';\\n          }\\n          st.winding = 0;\\n          closeRepeat(S);\\n        }\\n      }\\n1170→      if ((st.signs || 0) >= 6 && S.strain === st) { st.move = 4; st.t = 0; S.clock += 120; pushEv(S, ['movement', 4]); spawnCoda(S, st); }\\n    } else if (st.move === 4) {\\n      st.beat = (st.t % 0.8) / 0.8;\\n      S.flags.onBeat = st.beat < 0.25;\\n      const spiral = S.objects.find(o => o.type === 'spiral' && o.tag === 'last-note');\\n      const note = S.objects.find(o => o.tag === 'the-note');\\n      const wound = S.objects.find(o => o.tag === 'final-wound');\\n      if (spiral && spiral.done && !st.noteOut) {\\n        st.noteOut = true;\\n        addObj(S, { type: 'note', x: 213, y: 116, axis: [0, -1], depth: 36, tension: 80, order: 2, tag: 'the-note', drain: 0 });\\n1180→      }\\n      if (note && note.done && !wound) {\\n        addObj(S, { type: 'wound', x: 213, y: 130, stitches: 6, order: 3, tag: 'final-wound', drain: 0.3 });\\n      }\\n      if (wound && wound.done) st.done = true;\\n    }\\n  }\\n\\n  function openRepeat(S, st) {\\n    const existing = S.objects.find(o => o.tag === 'repeat');\\n1190→    if (existing) { existing.done = false; existing.alive = true; existing.open = true; existing.prog = 0; return existing; }\\n    return addObj(S, { type: 'repeat', x: 213, y: 100, len: 36, order: 1, tag: 'repeat', open: true, drain: 0, guide: [[190, 100], [236, 100]] });\\n  }\\n  function closeRepeat(S) {\\n    for (const o of S.objects) if (o.tag === 'repeat' && !o.done) { o.open = false; }\\n  }\\n  function spawnVoice(S, st) {\\n    st.domes = [{ x: 90, y: 70, r: 28, t: 4 }, { x: 330, y: 70, r: 28, t: 5 }];\\n    for (let i = 0; i < 3; i++) addObj(S, { type: 'voice', x: 170 + i * 36, y: 150, hidden: true, order: 1, tag: 'voice', drain: 0.15, window: false });\\n    st.jitter = true; st.amp = 0.45;\\n1200→  }\\n  function spawnCoda(S, st) {\\n    const guide = [];\\n    for (let i = 0; i <= 16; i++) {\\n      const a = i / 16 * Math.PI * 1.6;\\n      guide.push([213 + Math.cos(a) * (20 + i * 3), 116 + Math.sin(a) * (12 + i * 2)]);\\n    }\\n    addObj(S, { type: 'spiral', x: 213, y: 116, guide, order: 1, tag: 'last-note', beatLock: true, drain: 0, ring: false });\\n  }\\n\\n1210→  function spawnStrain(S, kind, opts) {\\n    opts = opts || {};\\n    if (kind === 'staccato') {\\n      const st = { kind, tag: opts.tag || 'stacc', t: 0, beads: [], done: false, collapse: 0 };\\n      const n = opts.nests || 2;\\n      for (let i = 0; i < n; i++) {\\n        addObj(S, { type: 'nest', x: opts.x || (180 + i * 40), y: opts.y || 120, hidden: true, order: 2, tag: st.tag, slash: true, drain: 0.15, r: 8 });\\n      }\\n      const beads = opts.beads || 4;\\n      for (let i = 0; i < beads; i++) {\\n1220→        st.beads.push({ x: 160 + i * 12, y: 90, x0: 160 + i * 12, y0: 90, tx: 170 + (i % 3) * 18, ty: 140, landIn: (opts.landIn || 1.1) + i * 0.2, flight: 0.7, dead: false, landed: false, hopped: false });\\n      }\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'legato') {\\n      const seg = opts.segments || 8;\\n      const w = makeWorm(S, opts.x || 150, opts.y || 120, seg, 1);\\n      w.marked = false;\\n      const st = { kind, worms: [w], done: false, snapped: false };\\n1230→      /* head starts hidden: a sonar target */\\n      addObj(S, { type: 'hold', x: w.x, y: w.y, hidden: true, order: 0, tag: 'legato-hide', drain: 0 });\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'tremolo') {\\n      const st = { kind, t: 0, amp: 1, stage: 1, x: opts.x || 213, y: opts.y || 116, wake: 6, reed0: 5, done: false, jitter: true, beat: 0, flare: false };\\n      for (let i = 0; i < 5; i++) {\\n        const a = -Math.PI / 2 + i * TAU / 5;\\n        addObj(S, { type: 'reed', x: st.x + Math.cos(a) * 28, y: st.y + Math.sin(a) * 18, order: 1, tag: 'reed', drain: 0, window: false });\\n1240→      }\\n      addObj(S, { type: 'tremass', x: st.x, y: st.y, need: 3, order: 3, tag: 'tremass', drain: 0.3 });\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'dacapo') {\\n      const lobes = [\\n        { id: 'A', mode: 'cautery', period: 6, openFor: 2.5, x: 180, y: 110 },\\n        { id: 'B', mode: 'slash', period: 7, openFor: 2.5, x: 213, y: 130 },\\n        { id: 'C', mode: 'syringe', period: 9, openFor: 3, x: 246, y: 112 },\\n1250→      ];\\n      const st = { kind, t: 0, round: 1, count: -1, lobes, done: false, repeated: 0 };\\n      for (const L of lobes) {\\n        const spec = { type: 'lobe', x: L.x, y: L.y, mode: L.mode === 'slash' ? 'scalpel' : L.mode, order: 1, tag: 'lobe-' + L.id, open: false, drain: 0.15, need: L.mode === 'cautery' ? 1 : 0.5 };\\n        if (L.mode === 'slash') { spec.guide = [[L.x - 10, L.y], [L.x + 10, L.y]]; spec.mode = 'scalpel'; spec.slash = true; }\\n        if (L.mode === 'syringe') { spec.mode = 'syringe'; spec.follow = 'salve'; }\\n        const o = addObj(S, spec);\\n        L.oid = o.id; L.dead = false; L.open = false;\\n      }\\n      S.strain = st;\\n1260→      return st;\\n    }\\n    if (kind === 'fermata') {\\n      const st = { kind, t: 0, stage: 1, hits: 0, eyeOpen: 0, done: false, jitter: false, amp: 0,\\n        domes: [{ x: 200, y: 116, r: 34, t: 5 }],\\n        eye: { x: 200, y: 116, open: false, hidden: false } };\\n      const o = addObj(S, { type: 'eye', x: 200, y: 116, need: 0.3, order: 1, tag: 'eye', open: false, drain: 0.2 });\\n      st.eye.oid = o.id;\\n      addObj(S, { type: 'eloquent', x: 150, y: 100, guide: [[140, 90], [180, 110]], order: 0, drain: 0, tag: 'eloq' });\\n      S.strain = st;\\n1270→      return st;\\n    }\\n    if (kind === 'cantor') {\\n      const st = { kind, t: 0, move: 1, done: false, signs: 0, jitter: false, amp: 0.4, domes: [] };\\n      for (let i = 0; i < 3; i++) addObj(S, { type: 'tendril', x: 170 + i * 30, y: 100, len: 28, order: 1, tag: 'tendril', drain: 0.15, guide: [[160 + i * 30, 100], [190 + i * 30, 108]] });\\n      for (let i = 0; i < 3; i++) addObj(S, { type: 'uvula', x: 180 + i * 26, y: 140, need: 1.5, order: 2, tag: 'uvula', drain: 0.2 });\\n      S.strain = st;\\n      return st;\\n    }\\n    return null;\\n1280→  }\\n\\n  /* ---------- phase / scripts ---------- */\\n\\n  function phaseClear(S) {\\n    if (S.strain && !S.strain.done) return false;\\n    for (const o of S.objects) {\\n      if (o.done || !o.alive) continue;\\n      if (o.type === 'nerve' || o.type === 'eloquent' || o.type === 'hold' || o.type === 'retractor') continue;\\n      if (o.optional) continue;\\n1290→      if (o.type === 'bead') continue;\\n      return false;\\n    }\\n    if (S.flags.needIv && (S.flags.iv || 0) < S.flags.needIv) return false;\\n    if (S.strain && S.strain.kind === 'staccato') {\\n      const live = (S.strain.beads || []).some(b => !b.dead);\\n      if (live && !S.strain.done) return false;\\n    }\\n    return true;\\n  }\\n1300→\\n  function runScript(S, id, tune) {\\n    if (id === 'dip') { S.flags.dip = 40; }\\n    else if (id === 'crash') { S.flags.crash = 8; }\\n    else if (id === 'breath') { S.flags.needBreath = true; }\\n    else if (id === 'look') { S.flags.needLook = true; }\\n    else if (id === 'lurch') {\\n      slip(S, S.players[0], 'lurch', 3, tune);\\n      for (const o of S.objects) if (!o.done) { o.x += 10; o.y += 4; if (o.origin) { o.origin = [o.origin[0] + 10, o.origin[1] + 4]; } }\\n      S.flags.needLook = true;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/core/sim.js\",\"offset\":830,\"limit\":480,\"raw_output\":\"\\n  function stepStrain(S, worldDt, handDt, tune) {\\n    const st = S.strain;\\n    if (!st || st.done) return;\\n    const sp = tune.strains.speed;\\n    if (st.kind === 'staccato') stepStaccato(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'legato') stepLegato(S, st, worldDt, handDt, tune, sp);\\n    else if (st.kind === 'tremolo') stepTremolo(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'dacapo') stepDacapo(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'fermata') stepFermata(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'cantor') stepCantor(S, st, worldDt, tune, sp);\\n  }\\n\\n  function stepStaccato(S, st, dt, tune, sp) {\\n    st.t += dt;\\n    const beat = tune.strains.beat;\\n    for (const b of st.beads) {\\n      if (b.dead) continue;\\n      b.landIn -= dt * sp;\\n      if (!b.hopped && b.landIn < 0.5) b.hopped = true;\\n      if (b.landIn <= 0 && !b.landed) {\\n        b.landed = true; b.x = b.tx; b.y = b.ty;\\n        addObj(S, { type: 'laceration', x: b.x, y: b.y, r: 8, order: 40, drain: 0.2, tag: 'bite' });\\n        pushEv(S, ['bite', Math.round(b.x), Math.round(b.y)]);\\n      }\\n      if (!b.landed) {\\n        const u = clamp(1 - b.landIn / b.flight, 0, 1);\\n        b.x = b.x0 + (b.tx - b.x0) * u;\\n        b.y = b.y0 + (b.ty - b.y0) * u;\\n      }\\n    }\\n    /* cautery kills beads: mirrored onto objects of type bead */\\n    let nests = 0;\\n    for (const o of S.objects) if (o.type === 'nest' && !o.done && o.tag === st.tag) nests++;\\n    if (!nests && !st.collapse) { st.collapse = 3; }\\n    if (st.collapse > 0) {\\n      st.collapse -= dt;\\n      if (st.collapse <= 0) {\\n        for (const b of st.beads) b.dead = true;\\n        for (const o of S.objects) if (o.type === 'bead' && o.tag === st.tag) { o.done = true; o.alive = false; }\\n        st.done = true;\\n      }\\n    }\\n    syncBeads(S, st);\\n    if (st.beads.length && st.beads.every(b => b.dead) && nests === 0) st.done = true;\\n  }\\n\\n  function syncBeads(S, st) {\\n    for (const b of st.beads) {\\n      if (b.dead) continue;\\n      let o = b.oid ? objById(S, b.oid) : null;\\n      if (!o) {\\n        o = addObj(S, { type: 'bead', x: b.x, y: b.y, need: 0.12, order: 5, tag: st.tag, drain: 0 });\\n        b.oid = o.id;\\n      } else {\\n        o.x = b.x; o.y = b.y;\\n        if (o.done) b.dead = true;\\n      }\\n    }\\n  }\\n\\n  function stepLegato(S, st, dt, handDt, tune, sp) {\\n    for (const w of st.worms) {\\n      if (w.done) continue;\\n      w.t += dt * sp;\\n      /* head crawls along its path until surfaced */\\n      if (!w.surfaced && !w.out) {\\n        w.along = Math.min(w.pathLen, w.along + 18 * dt * sp);\\n        const p = pointAlong(w.path, w.along);\\n        w.x = p[0]; w.y = p[1];\\n        /* open a slur guide when the head nears it */\\n        for (const g of w.slurs) {\\n          if (g.opened || g.done) continue;\\n          if (hypot(w.x - g.x, w.y - g.y) < 28) {\\n            g.opened = true;\\n            const o = addObj(S, { type: 'slur', x: g.x, y: g.y, len: 18, order: 1, tag: 'slur-' + w.id + '-' + g.i, drain: 0, guide: [[g.x - 9, g.y], [g.x + 9, g.y]] });\\n            g.oid = o.id;\\n          }\\n        }\\n      }\\n      for (const g of w.slurs) {\\n        if (!g.oid || g.done) continue;\\n        const o = objById(S, g.oid);\\n        if (o && o.done) g.done = true;\\n      }\\n      const slursLeft = w.slurs.filter(g => !g.done).length;\\n      if (!slursLeft && !w.surfaced) {\\n        w.surfaced = true; w.marked = true;\\n        const head = addObj(S, {\\n          type: 'shard', x: w.x, y: w.y, axis: w.axis || [1, 0], depth: 18, order: 2,\\n          tag: 'legato-head', worm: w.id, tension: 70, drain: 0.15, hidden: false,\\n          holdZone: w.hold || null, barbs: w.barbAt || 0,\\n        });\\n        w.head = head.id;\\n      }\\n      const head = w.head ? objById(S, w.head) : null;\\n      if (head && head.snapped && !w.snapped) {\\n        w.snapped = true; st.snapped = true;\\n        /* regrow a head further along and flee */\\n        head.done = true; head.alive = false;\\n        w.surfaced = false; w.out = false; w.head = 0;\\n        w.along = Math.min(w.pathLen - 4, w.along + 30);\\n        w.slurs.push({ i: 90 + w.slurs.length, x: w.x + 16, y: w.y, opened: false, done: false });\\n        pushEv(S, ['regrow', w.id]);\\n      }\\n      if (head && head.done && !w.out) {\\n        w.pulled = (w.pulled || 0) + 1;\\n        /* barb every 4th segment: if not clamped, snapping already handled via tension */\\n        if (w.barbAt && w.pulled % 4 === 0 && !head.clamped && !w.barbCleared) {\\n          /* require a clamp before the next length counts — head.done means the whole pull finished.\\n             Barbs are separate cautery objects spawned at the hold. */\\n        }\\n        w.segments -= 4;\\n        if (w.segments <= w.half && !w.split && st.worms.length < 3) {\\n          w.split = true; w.half = -1;\\n          st.worms.push(makeWorm(S, w.x + 20, w.y + 14, Math.max(4, w.segments >> 1), w.id + 1));\\n          pushEv(S, ['split', w.id]);\\n        }\\n        if (w.segments <= 0) { w.done = true; w.out = true; }\\n        else {\\n          /* next length */\\n          w.out = false; w.surfaced = true;\\n          const h2 = addObj(S, {\\n            type: 'shard', x: w.x, y: w.y, axis: [1, 0], depth: 14, order: 2,\\n            tag: 'legato-head', worm: w.id, tension: 70, drain: 0.1,\\n            holdZone: w.barbAt && (w.pulled % 4 === 0) ? [w.x + 30, w.y, 16] : null,\\n          });\\n          w.head = h2.id;\\n          if (w.barbAt && w.pulled % 4 === 0) {\\n            addObj(S, { type: 'barb', x: w.x + 30, y: w.y, need: 0.35, order: 3, tag: 'barb-' + w.id, drain: 0 });\\n          }\\n        }\\n      }\\n    }\\n    if (st.worms.every(w => w.done)) st.done = true;\\n  }\\n\\n  function makeWorm(S, x, y, segments, id) {\\n    const path = [];\\n    for (let i = 0; i < 8; i++) path.push([x + i * 14, y + Math.sin(i) * 8]);\\n    let pathLen = 0;\\n    for (let i = 1; i < path.length; i++) pathLen += hypot(path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1]);\\n    const slurs = [0.25, 0.5, 0.75].map((u, i) => {\\n      const p = pointAlong(path, pathLen * u);\\n      return { i, x: p[0], y: p[1], opened: false, done: false };\\n    });\\n    return { id, x, y, path, pathLen, along: 0, segments, half: segments / 2, slurs, surfaced: false, done: false, t: 0, split: false, pulled: 0, barbAt: 4, marked: false, axis: [1, 0] };\\n  }\\n  function pointAlong(path, dist) {\\n    let left = dist;\\n    for (let i = 1; i < path.length; i++) {\\n      const L = hypot(path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1]) || 1;\\n      if (left <= L) {\\n        const u = left / L;\\n        return [path[i - 1][0] + (path[i][0] - path[i - 1][0]) * u, path[i - 1][1] + (path[i][1] - path[i - 1][1]) * u];\\n      }\\n      left -= L;\\n    }\\n    return path[path.length - 1].slice();\\n  }\\n\\n  function stepTremolo(S, st, dt, tune) {\\n    st.t += dt;\\n    st.beat = (st.t % 1);\\n    const peak = st.beat > 0.7;\\n    st.flare = peak;\\n    S.flags.onBeat = st.beat > 0.45 && st.beat < 0.7 ? false : st.beat < 0.15;\\n    /* vitals shake and drain */\\n    if (!S.breath) S.vitals -= 0.6 * st.amp * dt * tune.strains.damage;\\n    for (const o of S.objects) if (o.type === 'reed' && o.tag === 'reed') o.window = !!st.flare;\\n    const reeds = S.objects.filter(o => o.type === 'reed' && !o.done);\\n    if (st.stage === 1 && reeds.length === 0) { st.stage = 2; st.amp = Math.min(st.amp, 0.2); }\\n    if (st.amp <= 0.2 && st.stage === 1) st.stage = 2;\\n    if (st.stage === 2) {\\n      st.wake -= dt;\\n      if (st.wake <= 0) {\\n        st.wake = 6;\\n        /* a reed returns */\\n        if (S.objects.filter(o => o.type === 'reed' && !o.done).length < 2) {\\n          addObj(S, { type: 'reed', x: st.x - 20 + rnd(S) * 40, y: st.y - 10, order: 1, tag: 'reed', drain: 0, window: false });\\n        }\\n      }\\n      const mass = S.objects.find(o => o.type === 'tremass');\\n      if (mass && mass.done && st.stage === 2) {\\n        st.stage = 3;\\n        addObj(S, { type: 'shard', x: st.x, y: st.y, axis: [1, 0], depth: 40, order: 4, tag: 'tremolo-pull', tension: 90, drain: 0.2 });\\n      }\\n    }\\n    if (st.stage === 3) {\\n      const pull = S.objects.find(o => o.tag === 'tremolo-pull');\\n      if (pull && pull.done) {\\n        st.done = true;\\n        for (const o of S.objects) if (o.type === 'reed' && !o.done) { o.done = true; o.alive = false; }\\n      }\\n    }\\n    /* amp falls when a reed is dosed */\\n    const deadReeds = st.reed0 - S.objects.filter(o => o.type === 'reed' && !o.done).length;\\n    st.amp = clamp(1 - deadReeds * 0.2, 0.15, 1);\\n    if (st.stage >= 2) st.amp = Math.min(st.amp, 0.2);\\n  }\\n\\n  function stepDacapo(S, st, dt, tune, sp) {\\n    st.t += dt * sp;\\n    let anyDead = false;\\n    for (const L of st.lobes) {\\n      if (L.dead) { anyDead = true; continue; }\\n      const period = L.period / (st.round === 2 ? 2 : 1);\\n      const openFor = L.openFor / (st.round === 2 ? 2 : 1);\\n      const u = st.t % period;\\n      L.open = u < openFor;\\n      const o = objById(S, L.oid);\\n      if (o) { o.open = L.open && !L.dead; o.x = L.x; o.y = L.y; if (o.done && !L.dead) { L.dead = true; anyDead = true; if (st.count < 0) st.count = 10; } }\\n    }\\n    if (st.count >= 0) {\\n      st.count -= dt;\\n      if (st.count <= 0 && st.lobes.some(L => L.dead) && st.lobes.some(L => !L.dead)) {\\n        /* from the top */\\n        for (const L of st.lobes) {\\n          L.dead = false;\\n          const o = objById(S, L.oid);\\n          if (o) { o.done = false; o.alive = true; o.prog = 0; o.burn = 0; o.dosed = false; o.open = false; if (o.cells) for (const c of o.cells) c[2] = 0; }\\n        }\\n        S.vitals -= 8;\\n        st.count = -1;\\n        st.repeated = (st.repeated || 0) + 1;\\n        if (st.round === 1) { st.round = 2; st.t = 0; spawnBeadsN(S, st, 4); }\\n        pushEv(S, ['dacapo', st.repeated]);\\n      } else if (st.count <= 0) st.count = -1;\\n    }\\n    if (st.lobes.every(L => L.dead) && st.count < 0) {\\n      if (st.round === 1) {\\n        st.round = 2; st.t = 0; st.count = -1;\\n        for (const L of st.lobes) {\\n          L.dead = false;\\n          const o = objById(S, L.oid);\\n          if (o) { o.done = false; o.alive = true; o.prog = 0; o.burn = 0; o.dosed = false; if (o.cells) for (const c of o.cells) c[2] = 0; }\\n        }\\n        spawnBeadsN(S, st, 4);\\n        pushEv(S, ['round2', 1]);\\n      } else if (S.objects.every(o => o.type !== 'bead' || o.done)) st.done = true;\\n    }\\n    if (st.round === 2 && st.lobes.every(L => L.dead) && S.objects.every(o => o.type !== 'bead' || o.done || o.tag !== 'dacapo-bead')) st.done = true;\\n  }\\n\\n  function spawnBeadsN(S, st, n) {\\n    st.beads = st.beads || [];\\n    for (let i = 0; i < n; i++) {\\n      const b = { x: 180 + i * 16, y: 100, tx: 190 + i * 14, ty: 130, x0: 180 + i * 16, y0: 100, landIn: 0.8, flight: 0.8, dead: false, landed: false, hopped: false };\\n      st.beads.push(b);\\n      const o = addObj(S, { type: 'bead', x: b.x, y: b.y, need: 0.12, order: 6, tag: 'dacapo-bead', drain: 0 });\\n      b.oid = o.id;\\n    }\\n    if (!st.kindBead) st.kindBead = true;\\n  }\\n\\n  function stepFermata(S, st, dt, tune) {\\n    st.t += dt;\\n    for (const d of st.domes) if (d.t > 0) d.t -= dt;\\n    st.domes = st.domes.filter(d => d.t > 0);\\n    if (st.stage === 1 && st.domes.length === 0 && !(st.eyeOpen > 0)) {\\n      st.eyeOpen = S.breath ? 2.8 : 0.7;\\n      st.eye.open = true;\\n      const o = objById(S, st.eye.oid);\\n      if (o) o.open = true;\\n    }\\n    if (st.eyeOpen > 0) {\\n      st.eyeOpen -= dt;\\n      if (st.eyeOpen <= 0) {\\n        st.eye.open = false;\\n        const o = objById(S, st.eye.oid);\\n        if (o && !o.done) o.open = false;\\n        if (st.hits < 3 && st.stage === 1) {\\n          /* raise another dome */\\n          if (st.domes.length < 3) st.domes.push({ x: st.eye.x, y: st.eye.y, r: 34, t: 5 });\\n        }\\n      }\\n    }\\n    const eye = objById(S, st.eye.oid);\\n    if (eye && eye.done) { st.hits += 1; eye.done = false; eye.alive = true; eye.burn = 0; eye.prog = 0; eye.open = false; st.eye.open = false; }\\n    if (st.hits >= 3 && st.stage === 1) {\\n      st.stage = 2;\\n      st.eye.x = 250; st.eye.y = 90; st.eye.hidden = true;\\n      if (eye) { eye.x = 250; eye.y = 90; eye.hidden = true; eye.marked = false; eye.done = false; eye.alive = true; }\\n      addObj(S, { type: 'shard', x: 160, y: 140, axis: [1, 0], depth: 12, order: 3, tag: 'sliver-a', drain: 0.1, hidden: true });\\n      addObj(S, { type: 'shard', x: 180, y: 150, axis: [0.6, 0.8], depth: 12, order: 3, tag: 'sliver-b', drain: 0.1, hidden: true });\\n    }\\n    if (st.stage === 2 && eye && eye.marked && st.hits < 4) { eye.hidden = false; eye.open = true; }\\n    if (st.stage >= 2 && eye && st.hits >= 4) { eye.open = false; eye.drain = 0; }\\n    if (st.stage === 2) {\\n      const slivers = S.objects.filter(o => o.tag === 'sliver-a' || o.tag === 'sliver-b');\\n      if (st.hits >= 4 && slivers.length && slivers.every(o => o.done)) {\\n        st.stage = 3;\\n        addObj(S, { type: 'note', x: st.eye.x, y: st.eye.y, axis: [0, -1], depth: 28, tension: 40, order: 5, tag: 'fermata-pull', drain: 0.15 });\\n      }\\n    }\\n    if (st.stage === 3) {\\n      const pull = S.objects.find(o => o.tag === 'fermata-pull');\\n      if (pull && pull.done) {\\n        st.done = true;\\n        if (eye) { eye.done = true; eye.alive = false; eye.open = false; eye.drain = 0; }\\n      }\\n    }\\n  }\\n\\n  function stepCantor(S, st, dt, tune) {\\n    st.t += dt;\\n    if (st.move === 1) {\\n      /* tendrils then uvulas, objects already spawned by the phase */\\n      const left = S.objects.filter(o => (o.tag === 'tendril' || o.tag === 'uvula') && !o.done);\\n      if (!left.length) { st.move = 2; st.t = 0; S.clock += 120; S.flags.hush = true; pushEv(S, ['movement', 2]); spawnVoice(S, st); }\\n    } else if (st.move === 2) {\\n      S.flags.hush = true;\\n      st.beat = (st.t % 1);\\n      for (const o of S.objects) if (o.type === 'voice') o.window = st.beat > 0.62;\\n      if (st.domes) {\\n        for (const d of st.domes) d.t -= dt;\\n        st.domes = st.domes.filter(d => d.t > 0);\\n      }\\n      st.jitter = true;\\n      const voices = S.objects.filter(o => o.type === 'voice' && !o.done);\\n      if (!voices.length) { st.move = 3; st.t = 0; S.clock += 120; S.flags.hush = false; st.signs = 0; pushEv(S, ['movement', 3]); }\\n    } else if (st.move === 3) {\\n      st.cycleT = (st.cycleT || 0) + dt;\\n      if (!st.winding && st.cycleT >= 20) { st.winding = 3; st.cycleT = 0; openRepeat(S, st); }\\n      if (st.winding > 0) {\\n        st.winding -= dt;\\n        if (st.winding <= 0) {\\n          const sign = S.objects.find(o => o.tag === 'repeat');\\n          if (sign && !sign.done) {\\n            forceRewind(S, true);\\n            const now = S.strain;\\n            if (now) now.rewound = (now.rewound || 0) + 1;\\n          } else if (sign && sign.done) {\\n            st.signs = (st.signs || 0) + 1;\\n            sign.tag = 'repeat-spent';\\n          }\\n          st.winding = 0;\\n          closeRepeat(S);\\n        }\\n      }\\n      if ((st.signs || 0) >= 6 && S.strain === st) { st.move = 4; st.t = 0; S.clock += 120; pushEv(S, ['movement', 4]); spawnCoda(S, st); }\\n    } else if (st.move === 4) {\\n      st.beat = (st.t % 0.8) / 0.8;\\n      S.flags.onBeat = st.beat < 0.25;\\n      const spiral = S.objects.find(o => o.type === 'spiral' && o.tag === 'last-note');\\n      const note = S.objects.find(o => o.tag === 'the-note');\\n      const wound = S.objects.find(o => o.tag === 'final-wound');\\n      if (spiral && spiral.done && !st.noteOut) {\\n        st.noteOut = true;\\n        addObj(S, { type: 'note', x: 213, y: 116, axis: [0, -1], depth: 36, tension: 80, order: 2, tag: 'the-note', drain: 0 });\\n      }\\n      if (note && note.done && !wound) {\\n        addObj(S, { type: 'wound', x: 213, y: 130, stitches: 6, order: 3, tag: 'final-wound', drain: 0.3 });\\n      }\\n      if (wound && wound.done) st.done = true;\\n    }\\n  }\\n\\n  function openRepeat(S, st) {\\n    const existing = S.objects.find(o => o.tag === 'repeat');\\n    if (existing) { existing.done = false; existing.alive = true; existing.open = true; existing.prog = 0; return existing; }\\n    return addObj(S, { type: 'repeat', x: 213, y: 100, len: 36, order: 1, tag: 'repeat', open: true, drain: 0, guide: [[190, 100], [236, 100]] });\\n  }\\n  function closeRepeat(S) {\\n    for (const o of S.objects) if (o.tag === 'repeat' && !o.done) { o.open = false; }\\n  }\\n  function spawnVoice(S, st) {\\n    st.domes = [{ x: 90, y: 70, r: 28, t: 4 }, { x: 330, y: 70, r: 28, t: 5 }];\\n    for (let i = 0; i < 3; i++) addObj(S, { type: 'voice', x: 170 + i * 36, y: 150, hidden: true, order: 1, tag: 'voice', drain: 0.15, window: false });\\n    st.jitter = true; st.amp = 0.45;\\n  }\\n  function spawnCoda(S, st) {\\n    const guide = [];\\n    for (let i = 0; i <= 16; i++) {\\n      const a = i / 16 * Math.PI * 1.6;\\n      guide.push([213 + Math.cos(a) * (20 + i * 3), 116 + Math.sin(a) * (12 + i * 2)]);\\n    }\\n    addObj(S, { type: 'spiral', x: 213, y: 116, guide, order: 1, tag: 'last-note', beatLock: true, drain: 0, ring: false });\\n  }\\n\\n  function spawnStrain(S, kind, opts) {\\n    opts = opts || {};\\n    if (kind === 'staccato') {\\n      const st = { kind, tag: opts.tag || 'stacc', t: 0, beads: [], done: false, collapse: 0 };\\n      const n = opts.nests || 2;\\n      for (let i = 0; i < n; i++) {\\n        addObj(S, { type: 'nest', x: opts.x || (180 + i * 40), y: opts.y || 120, hidden: true, order: 2, tag: st.tag, slash: true, drain: 0.15, r: 8 });\\n      }\\n      const beads = opts.beads || 4;\\n      for (let i = 0; i < beads; i++) {\\n        st.beads.push({ x: 160 + i * 12, y: 90, x0: 160 + i * 12, y0: 90, tx: 170 + (i % 3) * 18, ty: 140, landIn: (opts.landIn || 1.1) + i * 0.2, flight: 0.7, dead: false, landed: false, hopped: false });\\n      }\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'legato') {\\n      const seg = opts.segments || 8;\\n      const w = makeWorm(S, opts.x || 150, opts.y || 120, seg, 1);\\n      w.marked = false;\\n      const st = { kind, worms: [w], done: false, snapped: false };\\n      /* head starts hidden: a sonar target */\\n      addObj(S, { type: 'hold', x: w.x, y: w.y, hidden: true, order: 0, tag: 'legato-hide', drain: 0 });\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'tremolo') {\\n      const st = { kind, t: 0, amp: 1, stage: 1, x: opts.x || 213, y: opts.y || 116, wake: 6, reed0: 5, done: false, jitter: true, beat: 0, flare: false };\\n      for (let i = 0; i < 5; i++) {\\n        const a = -Math.PI / 2 + i * TAU / 5;\\n        addObj(S, { type: 'reed', x: st.x + Math.cos(a) * 28, y: st.y + Math.sin(a) * 18, order: 1, tag: 'reed', drain: 0, window: false });\\n      }\\n      addObj(S, { type: 'tremass', x: st.x, y: st.y, need: 3, order: 3, tag: 'tremass', drain: 0.3 });\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'dacapo') {\\n      const lobes = [\\n        { id: 'A', mode: 'cautery', period: 6, openFor: 2.5, x: 180, y: 110 },\\n        { id: 'B', mode: 'slash', period: 7, openFor: 2.5, x: 213, y: 130 },\\n        { id: 'C', mode: 'syringe', period: 9, openFor: 3, x: 246, y: 112 },\\n      ];\\n      const st = { kind, t: 0, round: 1, count: -1, lobes, done: false, repeated: 0 };\\n      for (const L of lobes) {\\n        const spec = { type: 'lobe', x: L.x, y: L.y, mode: L.mode === 'slash' ? 'scalpel' : L.mode, order: 1, tag: 'lobe-' + L.id, open: false, drain: 0.15, need: L.mode === 'cautery' ? 1 : 0.5 };\\n        if (L.mode === 'slash') { spec.guide = [[L.x - 10, L.y], [L.x + 10, L.y]]; spec.mode = 'scalpel'; spec.slash = true; }\\n        if (L.mode === 'syringe') { spec.mode = 'syringe'; spec.follow = 'salve'; }\\n        const o = addObj(S, spec);\\n        L.oid = o.id; L.dead = false; L.open = false;\\n      }\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'fermata') {\\n      const st = { kind, t: 0, stage: 1, hits: 0, eyeOpen: 0, done: false, jitter: false, amp: 0,\\n        domes: [{ x: 200, y: 116, r: 34, t: 5 }],\\n        eye: { x: 200, y: 116, open: false, hidden: false } };\\n      const o = addObj(S, { type: 'eye', x: 200, y: 116, need: 0.3, order: 1, tag: 'eye', open: false, drain: 0.2 });\\n      st.eye.oid = o.id;\\n      addObj(S, { type: 'eloquent', x: 150, y: 100, guide: [[140, 90], [180, 110]], order: 0, drain: 0, tag: 'eloq' });\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'cantor') {\\n      const st = { kind, t: 0, move: 1, done: false, signs: 0, jitter: false, amp: 0.4, domes: [] };\\n      for (let i = 0; i < 3; i++) addObj(S, { type: 'tendril', x: 170 + i * 30, y: 100, len: 28, order: 1, tag: 'tendril', drain: 0.15, guide: [[160 + i * 30, 100], [190 + i * 30, 108]] });\\n      for (let i = 0; i < 3; i++) addObj(S, { type: 'uvula', x: 180 + i * 26, y: 140, need: 1.5, order: 2, tag: 'uvula', drain: 0.2 });\\n      S.strain = st;\\n      return st;\\n    }\\n    return null;\\n  }\\n\\n  /* ---------- phase / scripts ---------- */\\n\\n  function phaseClear(S) {\\n    if (S.strain && !S.strain.done) return false;\\n    for (const o of S.objects) {\\n      if (o.done || !o.alive) continue;\\n      if (o.type === 'nerve' || o.type === 'eloquent' || o.type === 'hold' || o.type === 'retractor') continue;\\n      if (o.optional) continue;\\n      if (o.type === 'bead') continue;\\n      return false;\\n    }\\n    if (S.flags.needIv && (S.flags.iv || 0) < S.flags.needIv) return false;\\n    if (S.strain && S.strain.kind === 'staccato') {\\n      const live = (S.strain.beads || []).some(b => !b.dead);\\n      if (live && !S.strain.done) return false;\\n    }\\n    return true;\\n  }\\n\\n  function runScript(S, id, tune) {\\n    if (id === 'dip') { S.flags.dip = 40; }\\n    else if (id === 'crash') { S.flags.crash = 8; }\\n    else if (id === 'breath') { S.flags.needBreath = true; }\\n    else if (id === 'look') { S.flags.needLook = true; }\\n    else if (id === 'lurch') {\\n      slip(S, S.players[0], 'lurch', 3, tune);\\n      for (const o of S.objects) if (!o.done) { o.x += 10; o.y += 4; if (o.origin) { o.origin = [o.origin[0] + 10, o.origin[1] + 4]; } }\\n      S.flags.needLook = true;\\n\",\"total_lines\":1767}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"ef9f4439-2446-4a06-b4fc-9873887a38e0"}
{"type":"assistant","message":{"id":"msg_398","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"A significant potential bug was found in Da Capo.\n\nThe test sequence sets `lobe.done = true`, steps, then sets `capo.strain.count = 0.02` and steps again. The first step should mark the lobe dead and reset count to 10. The second step triggers regrowth only if count is at or below zero, dead lobs exist, and live lobs remain.","signature":""},{"type":"tool_use","id":"call-1a82e89b-dac7-4305-b72c-56abed3acb54-32","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/core/sim.js","offset":216,"limit":90}},{"type":"tool_use","id":"call-1a82e89b-dac7-4305-b72c-56abed3acb54-33","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/tests/run.mjs","offset":363,"limit":200}},{"type":"tool_use","id":"call-1a82e89b-dac7-4305-b72c-56abed3acb54-34","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/bot/bot.js","limit":280}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":19623,"output_tokens":1392,"cache_read_input_tokens":80256,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"9943c42c-beac-435e-b515-8692ff4df506"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-1a82e89b-dac7-4305-b72c-56abed3acb54-32","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"216→  function lose(S, why) {\\n    if (S.lost || S.won) return;\\n    S.lost = true;\\n    S.reason = why;\\n220→    S.breath = false;\\n    S.worldScale = 1;\\n    pushEv(S, ['lost', why]);\\n  }\\n\\n  function finishCase(S) {\\n    if (S.won || S.lost) return;\\n    S.won = true;\\n    S.closed = true;\\n    S.breath = false;\\n230→    S.worldScale = 1;\\n    const end = Math.max(0, S.clock) * 2 + Math.max(0, S.vitals) * 3;\\n    S.score += end;\\n    S.endBonus = end;\\n    S.rank = rankLetter(S.score, S.par, S.diff, S.slips, S.rankCap);\\n    pushEv(S, ['closed', S.rank, Math.round(S.score)]);\\n  }\\n\\n  function rankLetter(score, par, diff, slips, cap) {\\n    const r = par > 0 ? score / par : 0;\\n240→    let L = r >= 0.95 ? 'S' : r >= 0.8 ? 'A' : r >= 0.6 ? 'B' : r >= 0.4 ? 'C' : 'D';\\n    const order = 'DCBAS';\\n    if (cap === 'B' && order.indexOf(L) > order.indexOf('B')) L = 'B';\\n    if (diff === 'attending' && L === 'S' && !slips) return 'S+';\\n    return L;\\n  }\\n\\n  function takeCore(S) {\\n    return {\\n      rng: S.rng, clock: S.clock, vitals: S.vitals, score: S.score, slips: S.slips,\\n250→      phase: S.phase, steady: S.steady, flow: S.flow, streak: S.streak,\\n      phaseT: S.phaseT, worldT: S.worldT, flags: clone(S.flags),\\n      objects: clone(S.objects), strain: S.strain ? clone(S.strain) : null,\\n      device: S.device ? clone(S.device) : null,\\n      techGood: S.techGood, techAll: S.techAll, bestFlow: S.bestFlow,\\n      codeBlueUsed: S.codeBlueUsed, tutDone: S.tutDone, tutorial: S.tutorial,\\n      windowOpen: S.windowOpen, tiltAmp: S.tiltAmp, dim: S.dim,\\n    };\\n  }\\n\\n260→  function applyCore(S, core) {\\n    S.rng = core.rng; S.clock = core.clock; S.vitals = core.vitals; S.score = core.score;\\n    S.slips = core.slips; S.phase = core.phase; S.steady = core.steady; S.flow = core.flow;\\n    S.streak = core.streak; S.phaseT = core.phaseT; S.worldT = core.worldT;\\n    S.flags = clone(core.flags); S.objects = clone(core.objects);\\n    S.strain = core.strain ? clone(core.strain) : null;\\n    S.device = core.device ? clone(core.device) : null;\\n    S.techGood = core.techGood; S.techAll = core.techAll; S.bestFlow = core.bestFlow;\\n    S.codeBlueUsed = core.codeBlueUsed; S.tutDone = core.tutDone; S.tutorial = core.tutorial;\\n    S.windowOpen = core.windowOpen; S.tiltAmp = core.tiltAmp; S.dim = core.dim;\\n270→  }\\n\\n  function hashCore(core) {\\n    const s = JSON.stringify(core);\\n    let h = 2166136261;\\n    for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); }\\n    return h >>> 0;\\n  }\\n\\n  function pushRing(S) {\\n280→    const cursors = S.players.map(p => [round3(p.x), round3(p.y)]);\\n    const strains = strainGhost(S);\\n    S.ring.push({ t: S.worldT, core: takeCore(S), cursors, strains });\\n    const keep = S.worldT - 6.05;\\n    while (S.ring.length > 2 && S.ring[0].t < keep) S.ring.shift();\\n  }\\n  function round3(v) { return Math.round(v * 1000) / 1000; }\\n\\n  function strainGhost(S) {\\n    const st = S.strain;\\n290→    if (!st) return [];\\n    if (st.kind === 'legato') return (st.worms || []).map(w => [round3(w.x), round3(w.y)]);\\n    if (st.kind === 'staccato') return (st.beads || []).map(b => [round3(b.x), round3(b.y)]);\\n    if (st.kind === 'fermata' || st.kind === 'cantor') return st.eye ? [[round3(st.eye.x), round3(st.eye.y)]] : [];\\n    if (st.kind === 'tremolo') return [[round3(st.x || 213), round3(st.y || 116)]];\\n    if (st.kind === 'dacapo') return (st.lobes || []).map(L => [round3(L.x), round3(L.y)]);\\n    return [];\\n  }\\n\\n  function restoreCore(S, core, keepHands) {\\n300→    const hands = S.players.map(p => ({ id: p.id, x: p.x, y: p.y, bx: p.bx, by: p.by, color: p.color }));\\n    applyCore(S, core);\\n    for (let i = 0; i < S.players.length; i++) {\\n      const p = S.players[i];\\n      p.held = 0; p.stroke = null; p.fill = 0; p.over = 0; p.trig = 0; p.prevTrig = 0;\\n      if (keepHands && hands[i]) {\",\"content_concise\":\"216→  function lose(S, why) {\\n    if (S.lost || S.won) return;\\n    S.lost = true;\\n    S.reason = why;\\n220→    S.breath = false;\\n    S.worldScale = 1;\\n    pushEv(S, ['lost', why]);\\n  }\\n\\n  function finishCase(S) {\\n    if (S.won || S.lost) return;\\n    S.won = true;\\n    S.closed = true;\\n    S.breath = false;\\n230→    S.worldScale = 1;\\n    const end = Math.max(0, S.clock) * 2 + Math.max(0, S.vitals) * 3;\\n    S.score += end;\\n    S.endBonus = end;\\n    S.rank = rankLetter(S.score, S.par, S.diff, S.slips, S.rankCap);\\n    pushEv(S, ['closed', S.rank, Math.round(S.score)]);\\n  }\\n\\n  function rankLetter(score, par, diff, slips, cap) {\\n    const r = par > 0 ? score / par : 0;\\n240→    let L = r >= 0.95 ? 'S' : r >= 0.8 ? 'A' : r >= 0.6 ? 'B' : r >= 0.4 ? 'C' : 'D';\\n    const order = 'DCBAS';\\n    if (cap === 'B' && order.indexOf(L) > order.indexOf('B')) L = 'B';\\n    if (diff === 'attending' && L === 'S' && !slips) return 'S+';\\n    return L;\\n  }\\n\\n  function takeCore(S) {\\n    return {\\n      rng: S.rng, clock: S.clock, vitals: S.vitals, score: S.score, slips: S.slips,\\n250→      phase: S.phase, steady: S.steady, flow: S.flow, streak: S.streak,\\n      phaseT: S.phaseT, worldT: S.worldT, flags: clone(S.flags),\\n      objects: clone(S.objects), strain: S.strain ? clone(S.strain) : null,\\n      device: S.device ? clone(S.device) : null,\\n      techGood: S.techGood, techAll: S.techAll, bestFlow: S.bestFlow,\\n      codeBlueUsed: S.codeBlueUsed, tutDone: S.tutDone, tutorial: S.tutorial,\\n      windowOpen: S.windowOpen, tiltAmp: S.tiltAmp, dim: S.dim,\\n    };\\n  }\\n\\n260→  function applyCore(S, core) {\\n    S.rng = core.rng; S.clock = core.clock; S.vitals = core.vitals; S.score = core.score;\\n    S.slips = core.slips; S.phase = core.phase; S.steady = core.steady; S.flow = core.flow;\\n    S.streak = core.streak; S.phaseT = core.phaseT; S.worldT = core.worldT;\\n    S.flags = clone(core.flags); S.objects = clone(core.objects);\\n    S.strain = core.strain ? clone(core.strain) : null;\\n    S.device = core.device ? clone(core.device) : null;\\n    S.techGood = core.techGood; S.techAll = core.techAll; S.bestFlow = core.bestFlow;\\n    S.codeBlueUsed = core.codeBlueUsed; S.tutDone = core.tutDone; S.tutorial = core.tutorial;\\n    S.windowOpen = core.windowOpen; S.tiltAmp = core.tiltAmp; S.dim = core.dim;\\n270→  }\\n\\n  function hashCore(core) {\\n    const s = JSON.stringify(core);\\n    let h = 2166136261;\\n    for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); }\\n    return h >>> 0;\\n  }\\n\\n  function pushRing(S) {\\n280→    const cursors = S.players.map(p => [round3(p.x), round3(p.y)]);\\n    const strains = strainGhost(S);\\n    S.ring.push({ t: S.worldT, core: takeCore(S), cursors, strains });\\n    const keep = S.worldT - 6.05;\\n    while (S.ring.length > 2 && S.ring[0].t < keep) S.ring.shift();\\n  }\\n  function round3(v) { return Math.round(v * 1000) / 1000; }\\n\\n  function strainGhost(S) {\\n    const st = S.strain;\\n290→    if (!st) return [];\\n    if (st.kind === 'legato') return (st.worms || []).map(w => [round3(w.x), round3(w.y)]);\\n    if (st.kind === 'staccato') return (st.beads || []).map(b => [round3(b.x), round3(b.y)]);\\n    if (st.kind === 'fermata' || st.kind === 'cantor') return st.eye ? [[round3(st.eye.x), round3(st.eye.y)]] : [];\\n    if (st.kind === 'tremolo') return [[round3(st.x || 213), round3(st.y || 116)]];\\n    if (st.kind === 'dacapo') return (st.lobes || []).map(L => [round3(L.x), round3(L.y)]);\\n    return [];\\n  }\\n\\n  function restoreCore(S, core, keepHands) {\\n300→    const hands = S.players.map(p => ({ id: p.id, x: p.x, y: p.y, bx: p.bx, by: p.by, color: p.color }));\\n    applyCore(S, core);\\n    for (let i = 0; i < S.players.length; i++) {\\n      const p = S.players[i];\\n      p.held = 0; p.stroke = null; p.fill = 0; p.over = 0; p.trig = 0; p.prevTrig = 0;\\n      if (keepHands && hands[i]) {\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/core/sim.js\",\"offset\":216,\"limit\":90,\"raw_output\":\"  function lose(S, why) {\\n    if (S.lost || S.won) return;\\n    S.lost = true;\\n    S.reason = why;\\n    S.breath = false;\\n    S.worldScale = 1;\\n    pushEv(S, ['lost', why]);\\n  }\\n\\n  function finishCase(S) {\\n    if (S.won || S.lost) return;\\n    S.won = true;\\n    S.closed = true;\\n    S.breath = false;\\n    S.worldScale = 1;\\n    const end = Math.max(0, S.clock) * 2 + Math.max(0, S.vitals) * 3;\\n    S.score += end;\\n    S.endBonus = end;\\n    S.rank = rankLetter(S.score, S.par, S.diff, S.slips, S.rankCap);\\n    pushEv(S, ['closed', S.rank, Math.round(S.score)]);\\n  }\\n\\n  function rankLetter(score, par, diff, slips, cap) {\\n    const r = par > 0 ? score / par : 0;\\n    let L = r >= 0.95 ? 'S' : r >= 0.8 ? 'A' : r >= 0.6 ? 'B' : r >= 0.4 ? 'C' : 'D';\\n    const order = 'DCBAS';\\n    if (cap === 'B' && order.indexOf(L) > order.indexOf('B')) L = 'B';\\n    if (diff === 'attending' && L === 'S' && !slips) return 'S+';\\n    return L;\\n  }\\n\\n  function takeCore(S) {\\n    return {\\n      rng: S.rng, clock: S.clock, vitals: S.vitals, score: S.score, slips: S.slips,\\n      phase: S.phase, steady: S.steady, flow: S.flow, streak: S.streak,\\n      phaseT: S.phaseT, worldT: S.worldT, flags: clone(S.flags),\\n      objects: clone(S.objects), strain: S.strain ? clone(S.strain) : null,\\n      device: S.device ? clone(S.device) : null,\\n      techGood: S.techGood, techAll: S.techAll, bestFlow: S.bestFlow,\\n      codeBlueUsed: S.codeBlueUsed, tutDone: S.tutDone, tutorial: S.tutorial,\\n      windowOpen: S.windowOpen, tiltAmp: S.tiltAmp, dim: S.dim,\\n    };\\n  }\\n\\n  function applyCore(S, core) {\\n    S.rng = core.rng; S.clock = core.clock; S.vitals = core.vitals; S.score = core.score;\\n    S.slips = core.slips; S.phase = core.phase; S.steady = core.steady; S.flow = core.flow;\\n    S.streak = core.streak; S.phaseT = core.phaseT; S.worldT = core.worldT;\\n    S.flags = clone(core.flags); S.objects = clone(core.objects);\\n    S.strain = core.strain ? clone(core.strain) : null;\\n    S.device = core.device ? clone(core.device) : null;\\n    S.techGood = core.techGood; S.techAll = core.techAll; S.bestFlow = core.bestFlow;\\n    S.codeBlueUsed = core.codeBlueUsed; S.tutDone = core.tutDone; S.tutorial = core.tutorial;\\n    S.windowOpen = core.windowOpen; S.tiltAmp = core.tiltAmp; S.dim = core.dim;\\n  }\\n\\n  function hashCore(core) {\\n    const s = JSON.stringify(core);\\n    let h = 2166136261;\\n    for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); }\\n    return h >>> 0;\\n  }\\n\\n  function pushRing(S) {\\n    const cursors = S.players.map(p => [round3(p.x), round3(p.y)]);\\n    const strains = strainGhost(S);\\n    S.ring.push({ t: S.worldT, core: takeCore(S), cursors, strains });\\n    const keep = S.worldT - 6.05;\\n    while (S.ring.length > 2 && S.ring[0].t < keep) S.ring.shift();\\n  }\\n  function round3(v) { return Math.round(v * 1000) / 1000; }\\n\\n  function strainGhost(S) {\\n    const st = S.strain;\\n    if (!st) return [];\\n    if (st.kind === 'legato') return (st.worms || []).map(w => [round3(w.x), round3(w.y)]);\\n    if (st.kind === 'staccato') return (st.beads || []).map(b => [round3(b.x), round3(b.y)]);\\n    if (st.kind === 'fermata' || st.kind === 'cantor') return st.eye ? [[round3(st.eye.x), round3(st.eye.y)]] : [];\\n    if (st.kind === 'tremolo') return [[round3(st.x || 213), round3(st.y || 116)]];\\n    if (st.kind === 'dacapo') return (st.lobes || []).map(L => [round3(L.x), round3(L.y)]);\\n    return [];\\n  }\\n\\n  function restoreCore(S, core, keepHands) {\\n    const hands = S.players.map(p => ({ id: p.id, x: p.x, y: p.y, bx: p.bx, by: p.by, color: p.color }));\\n    applyCore(S, core);\\n    for (let i = 0; i < S.players.length; i++) {\\n      const p = S.players[i];\\n      p.held = 0; p.stroke = null; p.fill = 0; p.over = 0; p.trig = 0; p.prevTrig = 0;\\n      if (keepHands && hands[i]) {\\n\",\"total_lines\":1767}}","is_error":false},{"type":"tool_result","tool_use_id":"call-1a82e89b-dac7-4305-b72c-56abed3acb54-33","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"363→  group('determinism and bots', () => {\\n    GAME.Dev.reset();\\n    GAME.Art.force = false;\\n    const hashRun = (force) => {\\n      GAME.Art.force = force;\\n      const S = GAME.Op.create(GAME.CASES.c1, { seed: 9, difficulty: 'resident' });\\n      const t0 = S.t;\\n370→      let guard = 0;\\n      while (S.t - t0 < 4 && !S.won && !S.lost && guard < 20000) {\\n        const inputs = [];\\n        for (let i = 0; i < S.players.length; i++) {\\n          const dev = GAME.Bot.device(S, i, 1 / 45);\\n          const p = S.players[i];\\n          GAME.Wheel.update(p, dev, 1 / 45);\\n          if (dev.mouse) GAME.Cursor.update(p, { mouse: dev.mouse, fine: dev.fine }, S, 1 / 45);\\n          inputs.push({ tool: p.tool, trig: dev.trig, fine: !!dev.fine, gift: !!dev.gift, consult: !!dev.consult, mouse: true });\\n        }\\n380→        GAME.Op.step(S, inputs, 1 / 45);\\n        guard += 1;\\n      }\\n      return GAME.Op.hash(S);\\n    };\\n    const h0 = hashRun(false);\\n    const h1 = hashRun(false);\\n    const h2 = hashRun(true);\\n    GAME.Art.force = false;\\n    check('same seed and inputs hash the same', h0 === h1 && h0 === h2, h0 + ' ' + h1 + ' ' + h2);\\n390→\\n    for (const id of GAME.ORDER) {\\n      const S = GAME.Op.create(GAME.CASES[id], { seed: 3, difficulty: 'resident' });\\n      const clock0 = S.clock0 || S.clock;\\n      GAME.Bot.play(S, 500, 1 / 45);\\n      const left = S.clock / clock0;\\n      check(id + ' clears', S.won && S.vitals >= 40 && left >= 0.3 && S.rank === 'S',\\n        (S.won ? 'W' : S.reason) + ' vit ' + Math.round(S.vitals) + ' clk ' + Math.round(S.clock) + '/' + clock0 + ' ' + S.rank + ' ph ' + S.phase);\\n    }\\n    for (const n of [1, 2, 4]) {\\n400→      const def = GAME.roundsCase(n);\\n      const S = GAME.Op.create(def, { seed: 3, difficulty: 'resident', players: n });\\n      GAME.Bot.play(S, 500, 1 / 45);\\n      check('rounds ' + n, !!S.won, S.reason || ('ph ' + S.phase));\\n    }\\n  });\\n\\n  group('shell', () => {\\n    const game = GAME.Shell.game;\\n    const RT = GAME.Shell.RT;\\n410→    game.fadeTime = 0;\\n    GAME.Dev.reset();\\n    GAME.Art.force = false;\\n    RT.cheatUsed = false;\\n    game.advance(1 / 30);\\n    check('boots on the title', game.sceneName === 'title', game.sceneName);\\n    check('headless frame', game.H === 240 && game.W >= 420 && game.W <= 434, game.W + 'x' + game.H);\\n    check('music is quiet', game.audio.musicVolume === 0.1, String(game.audio.musicVolume));\\n    check('effects are full', game.audio.sfxVolume === 1, String(game.audio.sfxVolume));\\n    check('voices sit under effects', Math.abs(game.audio.voiceVolume - 0.9) < 0.001, String(game.audio.voiceVolume));\\n420→    check('master', Math.abs(game.audio.volume - 0.7) < 0.001, String(game.audio.volume));\\n    check('title draws', !game.errors.length, JSON.stringify(game.errors));\\n    check('PlayStation prompt', game.input.label('useTool', 'gamepad') === 'R2', game.input.label('useTool', 'gamepad'));\\n    const devItem = (game.o.menu.items || []).find((it) => it && it[0] === 'Dev Mode');\\n    check('dev mode is on the pause menu', !!(devItem && typeof devItem[1] === 'function'));\\n\\n    const press = (action) => {\\n      game.input.tap(action);\\n      game.advance(game.o.step);\\n      game.advance(game.o.step);\\n430→    };\\n    const enter = () => { game.advance(game.o.step); game.advance(game.o.step); };\\n\\n    game.advance(10.2);\\n    check('attract starts after ten seconds', game.sceneName === 'attract', game.sceneName);\\n    press('confirm');\\n    check('attract returns to the title', game.sceneName === 'title' && !GAME.Shell.snapshot().menu, game.sceneName);\\n\\n    press('confirm');\\n    const labels = (GAME.Shell.snapshot().menu && GAME.Shell.snapshot().menu.labels) || [];\\n440→    check('menu rows', labels.join('|') === 'New Game|Case Files|Grand Rounds|Skills Lab|About', labels.join('|'));\\n    press('down');\\n    press('down');\\n    press('down');\\n    press('down');\\n    press('confirm');\\n    check('about opens', game.sceneName === 'about', game.sceneName);\\n    press('confirm');\\n    check('about advances', RT.creditPage === 1, String(RT.creditPage));\\n    press('cancel');\\n450→    check('about returns', game.sceneName === 'menu', game.sceneName);\\n    press('cancel');\\n\\n    game.go('chart', { caseId: 'c2' });\\n    enter();\\n    const mark = GAME.Shell.snapshot().lightbox;\\n    check('lightbox mark is on the film', mark && Math.abs(mark[0] - 248) <= 1 && Math.abs(mark[1] - 96) <= 1, JSON.stringify(mark));\\n    game.input.feed('move', mark[0], mark[1]);\\n    game.input.feed('down', mark[0], mark[1]);\\n    game.input.feed('up', mark[0], mark[1]);\\n460→    enter();\\n    check('a right chart opens the case', game.sceneName === 'op' && RT.S && RT.S.id === 'c2' && RT.S.clock >= 250, game.sceneName + ' ' + (RT.S && RT.S.clock));\\n\\n    GAME.Dev.reset();\\n    RT.cheatUsed = false;\\n    GAME.Shell.beginCase('c1', { seed: 1 });\\n    game.go('op');\\n    enter();\\n    GAME.openDev();\\n    check('dev panel opens', GAME.Shell.snapshot().dev.open);\\n470→    const drain0 = GAME.TUNE.patient.drain;\\n    game.input.tap('right');\\n    game.advance(game.o.step);\\n    check('a slider dirties tuning', GAME.TUNE.dirty && GAME.TUNE.patient.drain !== drain0, String(GAME.TUNE.patient.drain));\\n    check('tuning is not a cheat flag', RT.cheatUsed === false);\\n    const mid = GAME.TUNE.patient.drain;\\n    game.input.tap('confirm');\\n    game.advance(game.o.step);\\n    check('confirm does not move a slider', GAME.TUNE.patient.drain === mid, String(GAME.TUNE.patient.drain));\\n    GAME.Dev.reset();\\n480→    check('reset restores the documented defaults', !GAME.TUNE.dirty && GAME.TUNE.patient.drain === 1 && GAME.TUNE.hands.cursor === 330);\\n    const dirtyBefore = GAME.TUNE.dirty;\\n    game.settings.set('assist', 0.4);\\n    game.settings.set('cursorSpeed', 200);\\n    check('assist and cursor prefs stay clean', GAME.TUNE.dirty === dirtyBefore && GAME.PREFS.assist === 0.4 && GAME.PREFS.cursor === 200);\\n    game.settings.set('assist', 0.6);\\n    game.settings.set('cursorSpeed', 330);\\n    game.settings.set('glyphs', 'xbox');\\n    check('Xbox prompt', game.input.label('useTool', 'gamepad') === 'RT', game.input.label('useTool', 'gamepad'));\\n    game.settings.set('glyphs', 'playstation');\\n490→    check('keyboard prompt', game.input.label('useTool', 'keyboard') === 'Space', game.input.label('useTool', 'keyboard'));\\n    game.input.tap('cancel');\\n    game.advance(game.o.step);\\n    check('dev closes', !RT.devOpen);\\n\\n    const A = GAME.ABOUT;\\n    check('usage line', A.sourceInformation.usage === 'added on import');\\n    check('feedback lengths', A.testingFeedback.length === 4 && A.engineFeedback.length === 6 && A.promptFeedback.length === 4);\\n    check('about name', A.aiHub.name === 'Open Table Second Opinion');\\n    check('no empty about lines', GAME.About.ORDER.every((k) => String(A.sourceInformation[k]).length > 0));\\n500→\\n    game.go('title');\\n    enter();\\n    game.debug.skipStory = true;\\n    game.debug.driver = () => {\\n      const S = RT.S;\\n      if (!S) return { aim: [0, 0], trig: 0 };\\n      return GAME.Bot.device(S, 0, 1 / 45);\\n    };\\n    RT.ranks = {};\\n510→    RT.cheatUsed = false;\\n    GAME.Dev.reset();\\n    game.input.feed('move', 1, 1);\\n    press('confirm');\\n    press('confirm');\\n    check('new game reaches difficulty', game.sceneName === 'difficulty', game.sceneName);\\n    const diff = GAME.Shell.snapshot().menu;\\n    check('intern is first', diff && diff.labels[0] === 'Intern' && diff.i === 0, JSON.stringify(diff));\\n    press('down');\\n    check('one down is resident', GAME.Shell.snapshot().menu.i === 1 && GAME.Shell.snapshot().menu.labels[1] === 'Resident');\\n520→    press('confirm');\\n    let guard = 0;\\n    while (game.sceneName !== 'title' && guard < 160) {\\n      const sn = GAME.Shell.snapshot();\\n      const key = game.sceneName;\\n      if (key === 'story' && sn.choice) press('confirm');\\n      else if (key === 'story') game.advance(0.25);\\n      else if (key === 'chart') {\\n        const m = sn.lightbox || [248, 96];\\n        game.input.feed('move', m[0], m[1]);\\n530→        game.input.feed('down', m[0], m[1]);\\n        game.input.feed('up', m[0], m[1]);\\n        enter();\\n      } else if (key === 'op') game.advance(0.4);\\n      else if (key === 'results' || key === 'ward' || key === 'credits' || key === 'menu' || key === 'difficulty') press('confirm');\\n      else game.advance(0.2);\\n      guard += 1;\\n    }\\n    game.debug.driver = null;\\n    game.debug.skipStory = false;\\n540→    const ranks = GAME.Shell.snapshot().ranks;\\n    check('a new game returns to the title', game.sceneName === 'title', game.sceneName + ' guard ' + guard);\\n    check('every case ranks S', GAME.ORDER.every((id) => ranks[id] === 'S'), JSON.stringify(ranks));\\n    check('the run draws clean', !game.errors.length, JSON.stringify(game.errors).slice(0, 400));\\n  });\\n\\n  const finish = () => {\\n    for (const line of fails) console.log(line);\\n    console.log(n + ' checks, ' + fails.length + ' failed');\\n    process.exit(fails.length ? 1 : 0);\\n550→  };\\n\\n  if (fast) finish();\\n  else {\\n    runLive().then(() => finish()).catch((e) => {\\n      n += 1;\\n      fails.push('FAIL live: ' + (e && e.stack ? e.stack : e));\\n      finish();\\n    });\\n  }\\n560→\\n  async function runLive() {\\n    const htmlName = GAME.CFG.FILE + '.html';\",\"content_concise\":\"363→  group('determinism and bots', () => {\\n    GAME.Dev.reset();\\n    GAME.Art.force = false;\\n    const hashRun = (force) => {\\n      GAME.Art.force = force;\\n      const S = GAME.Op.create(GAME.CASES.c1, { seed: 9, difficulty: 'resident' });\\n      const t0 = S.t;\\n370→      let guard = 0;\\n      while (S.t - t0 < 4 && !S.won && !S.lost && guard < 20000) {\\n        const inputs = [];\\n        for (let i = 0; i < S.players.length; i++) {\\n          const dev = GAME.Bot.device(S, i, 1 / 45);\\n          const p = S.players[i];\\n          GAME.Wheel.update(p, dev, 1 / 45);\\n          if (dev.mouse) GAME.Cursor.update(p, { mouse: dev.mouse, fine: dev.fine }, S, 1 / 45);\\n          inputs.push({ tool: p.tool, trig: dev.trig, fine: !!dev.fine, gift: !!dev.gift, consult: !!dev.consult, mouse: true });\\n        }\\n380→        GAME.Op.step(S, inputs, 1 / 45);\\n        guard += 1;\\n      }\\n      return GAME.Op.hash(S);\\n    };\\n    const h0 = hashRun(false);\\n    const h1 = hashRun(false);\\n    const h2 = hashRun(true);\\n    GAME.Art.force = false;\\n    check('same seed and inputs hash the same', h0 === h1 && h0 === h2, h0 + ' ' + h1 + ' ' + h2);\\n390→\\n    for (const id of GAME.ORDER) {\\n      const S = GAME.Op.create(GAME.CASES[id], { seed: 3, difficulty: 'resident' });\\n      const clock0 = S.clock0 || S.clock;\\n      GAME.Bot.play(S, 500, 1 / 45);\\n      const left = S.clock / clock0;\\n      check(id + ' clears', S.won && S.vitals >= 40 && left >= 0.3 && S.rank === 'S',\\n        (S.won ? 'W' : S.reason) + ' vit ' + Math.round(S.vitals) + ' clk ' + Math.round(S.clock) + '/' + clock0 + ' ' + S.rank + ' ph ' + S.phase);\\n    }\\n    for (const n of [1, 2, 4]) {\\n400→      const def = GAME.roundsCase(n);\\n      const S = GAME.Op.create(def, { seed: 3, difficulty: 'resident', players: n });\\n      GAME.Bot.play(S, 500, 1 / 45);\\n      check('rounds ' + n, !!S.won, S.reason || ('ph ' + S.phase));\\n    }\\n  });\\n\\n  group('shell', () => {\\n    const game = GAME.Shell.game;\\n    const RT = GAME.Shell.RT;\\n410→    game.fadeTime = 0;\\n    GAME.Dev.reset();\\n    GAME.Art.force = false;\\n    RT.cheatUsed = false;\\n    game.advance(1 / 30);\\n    check('boots on the title', game.sceneName === 'title', game.sceneName);\\n    check('headless frame', game.H === 240 && game.W >= 420 && game.W <= 434, game.W + 'x' + game.H);\\n    check('music is quiet', game.audio.musicVolume === 0.1, String(game.audio.musicVolume));\\n    check('effects are full', game.audio.sfxVolume === 1, String(game.audio.sfxVolume));\\n    check('voices sit under effects', Math.abs(game.audio.voiceVolume - 0.9) < 0.001, String(game.audio.voiceVolume));\\n420→    check('master', Math.abs(game.audio.volume - 0.7) < 0.001, String(game.audio.volume));\\n    check('title draws', !game.errors.length, JSON.stringify(game.errors));\\n    check('PlayStation prompt', game.input.label('useTool', 'gamepad') === 'R2', game.input.label('useTool', 'gamepad'));\\n    const devItem = (game.o.menu.items || []).find((it) => it && it[0] === 'Dev Mode');\\n    check('dev mode is on the pause menu', !!(devItem && typeof devItem[1] === 'function'));\\n\\n    const press = (action) => {\\n      game.input.tap(action);\\n      game.advance(game.o.step);\\n      game.advance(game.o.step);\\n430→    };\\n    const enter = () => { game.advance(game.o.step); game.advance(game.o.step); };\\n\\n    game.advance(10.2);\\n    check('attract starts after ten seconds', game.sceneName === 'attract', game.sceneName);\\n    press('confirm');\\n    check('attract returns to the title', game.sceneName === 'title' && !GAME.Shell.snapshot().menu, game.sceneName);\\n\\n    press('confirm');\\n    const labels = (GAME.Shell.snapshot().menu && GAME.Shell.snapshot().menu.labels) || [];\\n440→    check('menu rows', labels.join('|') === 'New Game|Case Files|Grand Rounds|Skills Lab|About', labels.join('|'));\\n    press('down');\\n    press('down');\\n    press('down');\\n    press('down');\\n    press('confirm');\\n    check('about opens', game.sceneName === 'about', game.sceneName);\\n    press('confirm');\\n    check('about advances', RT.creditPage === 1, String(RT.creditPage));\\n    press('cancel');\\n450→    check('about returns', game.sceneName === 'menu', game.sceneName);\\n    press('cancel');\\n\\n    game.go('chart', { caseId: 'c2' });\\n    enter();\\n    const mark = GAME.Shell.snapshot().lightbox;\\n    check('lightbox mark is on the film', mark && Math.abs(mark[0] - 248) <= 1 && Math.abs(mark[1] - 96) <= 1, JSON.stringify(mark));\\n    game.input.feed('move', mark[0], mark[1]);\\n    game.input.feed('down', mark[0], mark[1]);\\n    game.input.feed('up', mark[0], mark[1]);\\n460→    enter();\\n    check('a right chart opens the case', game.sceneName === 'op' && RT.S && RT.S.id === 'c2' && RT.S.clock >= 250, game.sceneName + ' ' + (RT.S && RT.S.clock));\\n\\n    GAME.Dev.reset();\\n    RT.cheatUsed = false;\\n    GAME.Shell.beginCase('c1', { seed: 1 });\\n    game.go('op');\\n    enter();\\n    GAME.openDev();\\n    check('dev panel opens', GAME.Shell.snapshot().dev.open);\\n470→    const drain0 = GAME.TUNE.patient.drain;\\n    game.input.tap('right');\\n    game.advance(game.o.step);\\n    check('a slider dirties tuning', GAME.TUNE.dirty && GAME.TUNE.patient.drain !== drain0, String(GAME.TUNE.patient.drain));\\n    check('tuning is not a cheat flag', RT.cheatUsed === false);\\n    const mid = GAME.TUNE.patient.drain;\\n    game.input.tap('confirm');\\n    game.advance(game.o.step);\\n    check('confirm does not move a slider', GAME.TUNE.patient.drain === mid, String(GAME.TUNE.patient.drain));\\n    GAME.Dev.reset();\\n480→    check('reset restores the documented defaults', !GAME.TUNE.dirty && GAME.TUNE.patient.drain === 1 && GAME.TUNE.hands.cursor === 330);\\n    const dirtyBefore = GAME.TUNE.dirty;\\n    game.settings.set('assist', 0.4);\\n    game.settings.set('cursorSpeed', 200);\\n    check('assist and cursor prefs stay clean', GAME.TUNE.dirty === dirtyBefore && GAME.PREFS.assist === 0.4 && GAME.PREFS.cursor === 200);\\n    game.settings.set('assist', 0.6);\\n    game.settings.set('cursorSpeed', 330);\\n    game.settings.set('glyphs', 'xbox');\\n    check('Xbox prompt', game.input.label('useTool', 'gamepad') === 'RT', game.input.label('useTool', 'gamepad'));\\n    game.settings.set('glyphs', 'playstation');\\n490→    check('keyboard prompt', game.input.label('useTool', 'keyboard') === 'Space', game.input.label('useTool', 'keyboard'));\\n    game.input.tap('cancel');\\n    game.advance(game.o.step);\\n    check('dev closes', !RT.devOpen);\\n\\n    const A = GAME.ABOUT;\\n    check('usage line', A.sourceInformation.usage === 'added on import');\\n    check('feedback lengths', A.testingFeedback.length === 4 && A.engineFeedback.length === 6 && A.promptFeedback.length === 4);\\n    check('about name', A.aiHub.name === 'Open Table Second Opinion');\\n    check('no empty about lines', GAME.About.ORDER.every((k) => String(A.sourceInformation[k]).length > 0));\\n500→\\n    game.go('title');\\n    enter();\\n    game.debug.skipStory = true;\\n    game.debug.driver = () => {\\n      const S = RT.S;\\n      if (!S) return { aim: [0, 0], trig: 0 };\\n      return GAME.Bot.device(S, 0, 1 / 45);\\n    };\\n    RT.ranks = {};\\n510→    RT.cheatUsed = false;\\n    GAME.Dev.reset();\\n    game.input.feed('move', 1, 1);\\n    press('confirm');\\n    press('confirm');\\n    check('new game reaches difficulty', game.sceneName === 'difficulty', game.sceneName);\\n    const diff = GAME.Shell.snapshot().menu;\\n    check('intern is first', diff && diff.labels[0] === 'Intern' && diff.i === 0, JSON.stringify(diff));\\n    press('down');\\n    check('one down is resident', GAME.Shell.snapshot().menu.i === 1 && GAME.Shell.snapshot().menu.labels[1] === 'Resident');\\n520→    press('confirm');\\n    let guard = 0;\\n    while (game.sceneName !== 'title' && guard < 160) {\\n      const sn = GAME.Shell.snapshot();\\n      const key = game.sceneName;\\n      if (key === 'story' && sn.choice) press('confirm');\\n      else if (key === 'story') game.advance(0.25);\\n      else if (key === 'chart') {\\n        const m = sn.lightbox || [248, 96];\\n        game.input.feed('move', m[0], m[1]);\\n530→        game.input.feed('down', m[0], m[1]);\\n        game.input.feed('up', m[0], m[1]);\\n        enter();\\n      } else if (key === 'op') game.advance(0.4);\\n      else if (key === 'results' || key === 'ward' || key === 'credits' || key === 'menu' || key === 'difficulty') press('confirm');\\n      else game.advance(0.2);\\n      guard += 1;\\n    }\\n    game.debug.driver = null;\\n    game.debug.skipStory = false;\\n540→    const ranks = GAME.Shell.snapshot().ranks;\\n    check('a new game returns to the title', game.sceneName === 'title', game.sceneName + ' guard ' + guard);\\n    check('every case ranks S', GAME.ORDER.every((id) => ranks[id] === 'S'), JSON.stringify(ranks));\\n    check('the run draws clean', !game.errors.length, JSON.stringify(game.errors).slice(0, 400));\\n  });\\n\\n  const finish = () => {\\n    for (const line of fails) console.log(line);\\n    console.log(n + ' checks, ' + fails.length + ' failed');\\n    process.exit(fails.length ? 1 : 0);\\n550→  };\\n\\n  if (fast) finish();\\n  else {\\n    runLive().then(() => finish()).catch((e) => {\\n      n += 1;\\n      fails.push('FAIL live: ' + (e && e.stack ? e.stack : e));\\n      finish();\\n    });\\n  }\\n560→\\n  async function runLive() {\\n    const htmlName = GAME.CFG.FILE + '.html';\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-