own' | 'move' | 'up', x, y, { touch: false,\"},{\"line_number\":1131,\"content\":\"    if (type === 'down') { this._fed = [x, y]; if (!o.touch) this.press('Mouse' + (o.button || 0)); this._gesture('down', x, y, { touch: !!o.touch, button: o.button || 0, id: 'fed' }); }\"},{\"line_number\":1142,\"content\":\"    if (type === 'down') { this._g = { id: o.id, x0: x, y0: y, x, y, t: this.clock, touch: !!o.touch, button: o.button || 0, mode: null, long: false, moved: false }; return; }\"},{\"line_number\":2301,\"content\":\"  res: v => typeof v === 'string' || (Array.isArray(v) && v.length === 2), expand: v => typeof v === 'boolean' || (!!v && typeof v === 'object'), touch: Array.isArray, camera: v => v === false || (!!v && typeof v === 'object' && !Array.isArray(v)) };\"},{\"line_number\":2617,\"content\":\"    if (this.o.touch === 'never' && this._needSync) this._needSync();   // (section 10l)\"},{\"line_number\":2714,\"content\":\"   * - view, views, input, res, expand, touch: a scene's, applied when it starts: input ('PLATFORMER'), res ('snes'),\"},{\"line_number\":3068,\"content\":\"  touch: { group: 'Touch', label: 'Touch buttons', type: 'select', value: 'auto', options: [['auto', 'Automatic'], ['on', 'Always'], ['off', 'Hidden']], apply: g => g.input._touchSync() },\"},{\"line_number\":3104,\"content\":\"    for (const k in STANDARD_SETTINGS) if (!(game.o.touch === 'never' && STANDARD_SETTINGS[k].group === 'Touch')) this.define(Object.assign({ key: k }, STANDARD_SETTINGS[k]));   // (touch: 'never': no Touch group)\"},{\"line_number\":3989,\"content\":\" *    game's own function on the engine's clock), and the notice a game made with touch: 'never' shows on a phone. In a\"},{\"line_number\":4015,\"content\":\"/** touch: 'never' on a device with touch alone: \\\"Controller or keyboard required\\\", with Settings, until a controller\"},{\"line_number\":4017,\"content\":\"Game.prototype._needSync = function () {\"},{\"line_number\":4024,\"content\":\"    d.innerHTML = '<div><div style=\\\"font-size:21px;margin-bottom:8px\\\">Controller or keyboard required</div><div style=\\\"opacity:.8;margin-bottom:18px\\\">This game plays with a controller or a keyboard. Connect one, then press any button.</div><button type=\\\"button\\\" style=\\\"font:inherit;padding:10px 22px;border-radius:10px;border:2px solid #b8a8ff;background:#2a2050;color:#fff;min-width:44px;min-height:44px\\\">Settings</button></div>';\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"d15c0425-a46f-4cdc-ba1f-22ab5c71abe9"}
