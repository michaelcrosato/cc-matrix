FIELD_H - 8);\\n    const j = S ? jitterOf(S, p) : [0, 0];\\n    p.x = p.bx + j[0];\\n    p.y = p.by + j[1];\\n    p.fine = !!dev.fine;\\n    return p;\\n  }\\n\\n  function wheelIndex(x, y) {\\n    const ang = Math.atan2(y, x); /* 0 east, clockwise because y grows downward */\\n    let d = ang - (-Math.PI / 2);\\n    if (d < 0) d += TAU;\\n    if (d >= TAU) d -= TAU;\\n    return Math.round(d / (Math.PI / 4)) % 8;\\n  }\\n\\n  function updateWheel(p, dev, dt) {\\n    dev = dev || {};\\n    if (dev.digit) {\\n      const i = (dev.digit - 1) % 8;\\n      if (p.tool !== CFG.TOOLS[i]) { p.tool = CFG.TOOLS[i]; p.swap = 0.12; }\\n      return p.tool;\\n    }\\n    const m = dev.move || [0, 0];\\n    const mag = hypot(m[0], m[1]);\\n    if (mag < 0.6) { p.wheelT = 0; p.wheelDir = -1; return p.tool; }\\n    const dir = wheelIndex(m[0], m[1]);\\n    if (dir !== p.wheelDir) { p.wheelDir = dir; p.wheelT = 0; }\\n    p.wheelT += dt;\\n    if (p.wheelT >= 0.08 && p.tool !== CFG.TOOLS[dir]) {\\n      p.tool = CFG.TOOLS[dir];\\n      p.swap = 0.12;\\n      p.wheelT = 0;\\n    }\\n    return p.tool;\\n  }\\n\\n  function retryPhase(S) {\\n    if (!S.checkpoint) return false;\\n    restoreCore(S, S.checkpoint, false);\\n    S.rankCap = 'B';\\n    S.lost = false;\\n    S.won = false;\\n    S.codeBlue = null;\\n    S.reason = '';\\n    for (const p of S.players) { p.held = 0; p.stroke = null; }\\n    pushEv(S, ['retry', S.phase]);\\n    return true;\\n  }\\n\\n  GAME.Sim = {\\n    rnd, clamp, clone, addObj, makePlayer, blank, create, createRaw, step,\\n    takeCore, applyCore, hashCore, rankLetter, secondLook, forceRewind, retryPhase,\\n    updateCursor, updateWheel, wheelIndex, spawnStrain, phaseClear, objById,\\n    polyDist, lose, DRAIN,\\n  };\\n  GAME.Op = { create, createRaw, step, takeCore, hash: S => hashCore(takeCore(S)), rankLetter, secondLook, forceRewind, retryPhase, spawnStrain };\\n\",\"total_lines\":1762}}","is_error":false},{"type":"tool_result","tool_use_id":"call-63a3390e-58c8-4664-accf-24518398fd82-34","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"240→    return F;\\n  }\\n\\n  const BAKERS = {\\n    forearm: bakeForearm, abdomen: bakeAbdomen, flank: bakeFlank, heart: bakeHeart,\\n    brain: bakeBrain, implant: bakeImplant, mediastinum: bakeMediastinum, ship: bakeAbdomen,\\n  };\\n  const cache = new Map();\\n  function fieldFor(site, seed, W, H) {\\n    const key = (site || 'abdomen') + ':' + (seed || 1) + ':' + W + 'x' + H;\\n250→    let F = cache.get(key);\\n    if (!F) {\\n      const bake = BAKERS[site] || bakeAbdomen;\\n      F = bake(W, H, (seed || 1) + (site === 'ship' ? 19 : 0));\\n      cache.set(key, F);\\n      if (cache.size > 8) cache.delete(cache.keys().next().value);\\n    }\\n    return F;\\n  }\\n\\n260→  function drawBust(g, c, o = {}) {\\n    const px = E.px, P = (pts, col) => px.poly(g, pts, col), T = E.tones;\\n    const skin = T(c.skin), hair = T(c.hair), cloth = T(c.cloth);\\n    let expr = o.expr || 'neutral';\\n    const cry = expr === 'cry', smirk = expr === 'smirk', tired = expr === 'tired';\\n    if (cry) expr = 'sad';\\n    if (smirk) expr = 'smile';\\n    if (tired) expr = 'sad';\\n    const blink = o.blink || 0, talk = o.talk || 0, cx = 56, top = 20;\\n    const jaw = c.jaw || 1, wide = c.wide || 1, f = (x, y) => [cx + x * wide, top + y];\\n270→    if (c.backHair) for (const s of c.backHair) P(s.map(([x, y]) => f(x, y)), hair.sh);\\n    P([[6, 128], [10, 104], [30, 92], [46, 88], [66, 88], [82, 92], [102, 104], [106, 128]], cloth.base);\\n    P([[6, 128], [10, 104], [30, 92], [34, 128]], cloth.sh);\\n    P([[78, 128], [82, 92], [102, 104], [106, 128]], cloth.lt);\\n    P([[46, 66], [66, 66], [68, 92], [56, 104], [44, 92]], skin.sh);\\n    P([[42, 88], [56, 110], [70, 88], [66, 86], [56, 100], [46, 86]], cloth.deep);\\n    P([[46, 86], [56, 100], [66, 86], [64, 92], [56, 104], [48, 92]], c.undershirt || skin.sh);\\n    if (c.coat) {\\n      P([[6, 128], [10, 104], [30, 92], [4