{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-132c531c-ea22-4534-aa3d-9d36959141d9-13","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"400→      line('vale', 'There is a researcher on the manifest. Hollis Crane. He says the device in his chest is a threat.'),\\n      { event: 'ward', wait: true }, { goto: 'c9_in' },\\n    ],\\n    c9_in: [\\n      line('sokolova', 'We are doctors. We do not defuse bombs. Today the bomb is a pacemaker, so we do.'),\\n      line('quill', 'I will fetch the other forceps.'),\\n      line('vale', 'If his heart stops, or if we force the can, the ship goes with him.'),\\n      line('sokolova', 'Then we will be polite to the can. Read the board. Do not trust the colors.'),\\n      { event: 'op', caseId: 'c9', wait: true }, { goto: 'c9_out' },\\n    ],\\n410→    c9_out: [\\n      line('quill', 'He is alive, which is more than his employer wanted.'),\\n      line('vale', 'He said it began with Hale\\\\'s daughter. Everything is singing to her.'),\\n      line('sokolova', 'Then we sail for Port Anselm. I have a coat somewhere. It will not help.'),\\n      { event: 'ward', wait: true }, { goto: 'c10_in' },\\n    ],\\n    c10_in: [\\n      line('percy', 'It is finally quiet. Immy. I am sorry. I have been taking it. To keep up with you.'),\\n      line('vale', 'Stay. Zhenya is here. We are both here. That is the point of a consult.'),\\n      line('sokolova', 'Eloquent cortex. Gold lines. You breathe, I rewind, nobody makes him a poet by accident.'),\\n420→      line('quill', 'Two surgeons, one nurse, one arrogant boy. A full table. I am content.'),\\n      { event: 'op', caseId: 'c10', wait: true }, { goto: 'c10_out' },\\n    ],\\n    c10_out: [\\n      line('percy', 'Your stitches are crooked.'),\\n      line('vale', 'I know. I am crying. It is fine. It is the good kind.'),\\n      line('oyelaran', 'Across the city, child. They are all falling at once. Hale is at our door.'),\\n      { event: 'ward', wait: true }, { goto: 'c11_in' },\\n    ],\\n    c11_in: [\\n430→      line('hale', 'I only wanted her not to hurt. I carried her through my own billboard. Please.'),\\n      line('clementine', 'Hello. I think I am supposed to be afraid. I cannot find it.'),\\n      line('sokolova', 'You will. That is the work. Immy, with me. Bartholomew, the long suction.'),\\n      line('oyelaran', 'Gallery is full. I brought the cane and not the pride. Do not rush the last note.'),\\n      line('quill', 'All of us, then. Don\\\\'t let it go quiet.'),\\n      { event: 'op', caseId: 'c11', wait: true }, { goto: 'c11_out' },\\n    ],\\n    c11_out: [\\n      line('clementine', 'It hurts. Oh, it hurts. I can feel my hands. They are cold. Thank you.'),\\n      line('hale', 'I surrender. Gently, if you can manage it. The city will be loud.'),\\n440→      line('quill', 'Doctor, I have a headache!'),\\n      line('vale', 'Wonderful.'),\\n      line('quill', 'Your hands, Doctor.'),\\n      line('vale', 'They have stopped shaking.'),\\n      line('quill', 'No. They have not.'),\\n      line('vale', 'Good.'),\\n      { event: 'credits', wait: true }, { goto: 'epilogue' },\\n    ],\\n    epilogue: [\\n      line('quill', 'Next shift starts at seven. Get some sleep, Doctor.'),\\n450→      { end: true },\\n    ],\\n  };\\n\\n  /* Fix the one bad who id if I typed odalis. */\\n  NODES.c4_in[0].who = 'quill';\\n  NODES.c4_in[0].say = 'Captain Ned Harrow. Gaff in the flank. Whistling the whole corridor down.';\\n\\n  const WARD = {\\n    1: ['agnes', 'slide', 'tam'],\\n460→    2: ['agnes', 'slide', 'tam', 'ned', 'ilse', 'oyelaran'],\\n    3: ['yusuf', 'perpetua', 'hollis'],\\n    4: ['agnes', 'slide', 'percy', 'clementine'],\\n  };\\n  const PEOPLE = {\\n    agnes: { name: 'Agnes Pellow', line: 'The grandchildren took the glass. Begonias on the sill. From them.' },\\n    slide: { name: 'Slide Achebe', line: 'I am practicing with a mute. The cork is framed. Do not tell Percy.' },\\n    tam: { name: 'Big Tam', line: 'Permit the dog is in the car. Tell the Chief the crane was not my idea.' },\\n    ned: { name: 'Ned Harrow', line: 'Hurts when I laugh. I am laughing anyway. Tide turns at four.' },\\n    ilse: { name: 'Ilse Brandt', line: 'I can feel the E string. It is awful. It is mine.' },\\n470→    oyelaran: { name: 'The Chief', line: 'Door is open. I am not dying. Do not hover. Hover a little.' },\\n    yusuf: { name: 'Yusuf Demir', line: 'The winch and I are no longer speaking. The ship fed me soup.' },\\n    perpetua: { name: 'Sister Perpetua', line: 'They are angry, which means they are awake. I can live with angry.' },\\n    hollis: { name: 'Hollis Crane', line: 'The can is in a basin, labeled. I would like to see the harbor sober.' },\\n    percy: { name: 'Percy', line: 'Your stitches are still crooked. I am keeping them. Go.' },\\n    clementine: { name: 'Clementine', line: 'The sheet is scratchy. I love it. I love all of it. Go sleep.' },\\n  };\\n\\n  GAME.CAST = CAST;\\n  GAME.BARKS = BARKS;\\n480→  GAME.CASES = CASES;\\n  GAME.ORDER = ['c1', 'c2', 'c3', 'c4', 'c5', 'c6', 'c7', 'c8', 'c9', 'c10', 'c11'];\\n  GAME.LIGHT = LIGHT;\\n  GAME.NODES = NODES;\\n  GAME.WARD = WARD;\\n  GAME.PEOPLE = PEOPLE;\\n  GAME.EXPR = EXPR;\\n  GAME.roundsCase = roundsCase;\\n})();\\n\",\"content_concise\":\"400→      line('vale', 'There is a researcher on the manifest. Hollis Crane. He says the device in his chest is a threat.'),\\n      { event: 'ward', wait: true }, { goto: 'c9_in' },\\n    ],\\n    c9_in: [\\n      line('sokolova', 'We are doctors. We do not defuse bombs. Today the bomb is a pacemaker, so we do.'),\\n      line('quill', 'I will fetch the other forceps.'),\\n      line('vale', 'If his heart stops, or if we force the can, the ship goes with him.'),\\n      line('sokolova', 'Then we will be polite to the can. Read the board. Do not trust the colors.'),\\n      { event: 'op', caseId: 'c9', wait: true }, { goto: 'c9_out' },\\n    ],\\n410→    c9_out: [\\n      line('quill', 'He is alive, which is more than his employer wanted.'),\\n      line('vale', 'He said it began with Hale\\\\'s daughter. Everything is singing to her.'),\\n      line('sokolova', 'Then we sail for Port Anselm. I have a coat somewhere. It will not help.'),\\n      { event: 'ward', wait: true }, { goto: 'c10_in' },\\n    ],\\n    c10_in: [\\n      line('percy', 'It is finally quiet. Immy. I am sorry. I have been taking it. To keep up with you.'),\\n      line('vale', 'Stay. Zhenya is here. We are both here. That is the point of a consult.'),\\n      line('sokolova', 'Eloquent cortex. Gold lines. You breathe, I rewind, nobody makes him a poet by accident.'),\\n420→      line('quill', 'Two surgeons, one nurse, one arrogant boy. A full table. I am content.'),\\n      { event: 'op', caseId: 'c10', wait: true }, { goto: 'c10_out' },\\n    ],\\n    c10_out: [\\n      line('percy', 'Your stitches are crooked.'),\\n      line('vale', 'I know. I am crying. It is fine. It is the good kind.'),\\n      line('oyelaran', 'Across the city, child. They are all falling at once. Hale is at our door.'),\\n      { event: 'ward', wait: true }, { goto: 'c11_in' },\\n    ],\\n    c11_in: [\\n430→      line('hale', 'I only wanted her not to hurt. I carried her through my own billboard. Please.'),\\n      line('clementine', 'Hello. I think I am supposed to be afraid. I cannot find it.'),\\n      line('sokolova', 'You will. That is the work. Immy, with me. Bartholomew, the long suction.'),\\n      line('oyelaran', 'Gallery is full. I brought the cane and not the pride. Do not rush the last note.'),\\n      line('quill', 'All of us, then. Don\\\\'t let it go quiet.'),\\n      { event: 'op', caseId: 'c11', wait: true }, { goto: 'c11_out' },\\n    ],\\n    c11_out: [\\n      line('clementine', 'It hurts. Oh, it hurts. I can feel my hands. They are cold. Thank you.'),\\n      line('hale', 'I surrender. Gently, if you can manage it. The city will be loud.'),\\n440→      line('quill', 'Doctor, I have a headache!'),\\n      line('vale', 'Wonderful.'),\\n      line('quill', 'Your hands, Doctor.'),\\n      line('vale', 'They have stopped shaking.'),\\n      line('quill', 'No. They have not.'),\\n      line('vale', 'Good.'),\\n      { event: 'credits', wait: true }, { goto: 'epilogue' },\\n    ],\\n    epilogue: [\\n      line('quill', 'Next shift starts at seven. Get some sleep, Doctor.'),\\n450→      { end: true },\\n    ],\\n  };\\n\\n  /* Fix the one bad who id if I typed odalis. */\\n  NODES.c4_in[0].who = 'quill';\\n  NODES.c4_in[0].say = 'Captain Ned Harrow. Gaff in the flank. Whistling the whole corridor down.';\\n\\n  const WARD = {\\n    1: ['agnes', 'slide', 'tam'],\\n460→    2: ['agnes', 'slide', 'tam', 'ned', 'ilse', 'oyelaran'],\\n    3: ['yusuf', 'perpetua', 'hollis'],\\n    4: ['agnes', 'slide', 'percy', 'clementine'],\\n  };\\n  const PEOPLE = {\\n    agnes: { name: 'Agnes Pellow', line: 'The grandchildren took the glass. Begonias on the sill. From them.' },\\n    slide: { name: 'Slide Achebe', line: 'I am practicing with a mute. The cork is framed. Do not tell Percy.' },\\n    tam: { name: 'Big Tam', line: 'Permit the dog is in the car. Tell the Chief the crane was not my idea.' },\\n    ned: { name: 'Ned Harrow', line: 'Hurts when I laugh. I am laughing anyway. Tide turns at four.' },\\n    ilse: { name: 'Ilse Brandt', line: 'I can feel the E string. It is awful. It is mine.' },\\n470→    oyelaran: { name: 'The Chief', line: 'Door is open. I am not dying. Do not hover. Hover a little.' },\\n    yusuf: { name: 'Yusuf Demir', line: 'The winch and I are no longer speaking. The ship fed me soup.' },\\n    perpetua: { name: 'Sister Perpetua', line: 'They are angry, which means they are awake. I can live with angry.' },\\n    hollis: { name: 'Hollis Crane', line: 'The can is in a basin, labeled. I would like to see the harbor sober.' },\\n    percy: { name: 'Percy', line: 'Your stitches are still crooked. I am keeping them. Go.' },\\n    clementine: { name: 'Clementine', line: 'The sheet is scratchy. I love it. I love all of it. Go sleep.' },\\n  };\\n\\n  GAME.CAST = CAST;\\n  GAME.BARKS = BARKS;\\n480→  GAME.CASES = CASES;\\n  GAME.ORDER = ['c1', 'c2', 'c3', 'c4', 'c5', 'c6', 'c7', 'c8', 'c9', 'c10', 'c11'];\\n  GAME.LIGHT = LIGHT;\\n  GAME.NODES = NODES;\\n  GAME.WARD = WARD;\\n  GAME.PEOPLE = PEOPLE;\\n  GAME.EXPR = EXPR;\\n  GAME.roundsCase = roundsCase;\\n})();\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/data/content.js\",\"offset\":400,\"limit\":120,\"raw_output\":\"      line('vale', 'There is a researcher on the manifest. Hollis Crane. He says the device in his chest is a threat.'),\\n      { event: 'ward', wait: true }, { goto: 'c9_in' },\\n    ],\\n    c9_in: [\\n      line('sokolova', 'We are doctors. We do not defuse bombs. Today the bomb is a pacemaker, so we do.'),\\n      line('quill', 'I will fetch the other forceps.'),\\n      line('vale', 'If his heart stops, or if we force the can, the ship goes with him.'),\\n      line('sokolova', 'Then we will be polite to the can. Read the board. Do not trust the colors.'),\\n      { event: 'op', caseId: 'c9', wait: true }, { goto: 'c9_out' },\\n    ],\\n    c9_out: [\\n      line('quill', 'He is alive, which is more than his employer wanted.'),\\n      line('vale', 'He said it began with Hale\\\\'s daughter. Everything is singing to her.'),\\n      line('sokolova', 'Then we sail for Port Anselm. I have a coat somewhere. It will not help.'),\\n      { event: 'ward', wait: true }, { goto: 'c10_in' },\\n    ],\\n    c10_in: [\\n      line('percy', 'It is finally quiet. Immy. I am sorry. I have been taking it. To keep up with you.'),\\n      line('vale', 'Stay. Zhenya is here. We are both here. That is the point of a consult.'),\\n      line('sokolova', 'Eloquent cortex. Gold lines. You breathe, I rewind, nobody makes him a poet by accident.'),\\n      line('quill', 'Two surgeons, one nurse, one arrogant boy. A full table. I am content.'),\\n      { event: 'op', caseId: 'c10', wait: true }, { goto: 'c10_out' },\\n    ],\\n    c10_out: [\\n      line('percy', 'Your stitches are crooked.'),\\n      line('vale', 'I know. I am crying. It is fine. It is the good kind.'),\\n      line('oyelaran', 'Across the city, child. They are all falling at once. Hale is at our door.'),\\n      { event: 'ward', wait: true }, { goto: 'c11_in' },\\n    ],\\n    c11_in: [\\n      line('hale', 'I only wanted her not to hurt. I carried her through my own billboard. Please.'),\\n      line('clementine', 'Hello. I think I am supposed to be afraid. I cannot find it.'),\\n      line('sokolova', 'You will. That is the work. Immy, with me. Bartholomew, the long suction.'),\\n      line('oyelaran', 'Gallery is full. I brought the cane and not the pride. Do not rush the last note.'),\\n      line('quill', 'All of us, then. Don\\\\'t let it go quiet.'),\\n      { event: 'op', caseId: 'c11', wait: true }, { goto: 'c11_out' },\\n    ],\\n    c11_out: [\\n      line('clementine', 'It hurts. Oh, it hurts. I can feel my hands. They are cold. Thank you.'),\\n      line('hale', 'I surrender. Gently, if you can manage it. The city will be loud.'),\\n      line('quill', 'Doctor, I have a headache!'),\\n      line('vale', 'Wonderful.'),\\n      line('quill', 'Your hands, Doctor.'),\\n      line('vale', 'They have stopped shaking.'),\\n      line('quill', 'No. They have not.'),\\n      line('vale', 'Good.'),\\n      { event: 'credits', wait: true }, { goto: 'epilogue' },\\n    ],\\n    epilogue: [\\n      line('quill', 'Next shift starts at seven. Get some sleep, Doctor.'),\\n      { end: true },\\n    ],\\n  };\\n\\n  /* Fix the one bad who id if I typed odalis. */\\n  NODES.c4_in[0].who = 'quill';\\n  NODES.c4_in[0].say = 'Captain Ned Harrow. Gaff in the flank. Whistling the whole corridor down.';\\n\\n  const WARD = {\\n    1: ['agnes', 'slide', 'tam'],\\n    2: ['agnes', 'slide', 'tam', 'ned', 'ilse', 'oyelaran'],\\n    3: ['yusuf', 'perpetua', 'hollis'],\\n    4: ['agnes', 'slide', 'percy', 'clementine'],\\n  };\\n  const PEOPLE = {\\n    agnes: { name: 'Agnes Pellow', line: 'The grandchildren took the glass. Begonias on the sill. From them.' },\\n    slide: { name: 'Slide Achebe', line: 'I am practicing with a mute. The cork is framed. Do not tell Percy.' },\\n    tam: { name: 'Big Tam', line: 'Permit the dog is in the car. Tell the Chief the crane was not my idea.' },\\n    ned: { name: 'Ned Harrow', line: 'Hurts when I laugh. I am laughing anyway. Tide turns at four.' },\\n    ilse: { name: 'Ilse Brandt', line: 'I can feel the E string. It is awful. It is mine.' },\\n    oyelaran: { name: 'The Chief', line: 'Door is open. I am not dying. Do not hover. Hover a little.' },\\n    yusuf: { name: 'Yusuf Demir', line: 'The winch and I are no longer speaking. The ship fed me soup.' },\\n    perpetua: { name: 'Sister Perpetua', line: 'They are angry, which means they are awake. I can live with angry.' },\\n    hollis: { name: 'Hollis Crane', line: 'The can is in a basin, labeled. I would like to see the harbor sober.' },\\n    percy: { name: 'Percy', line: 'Your stitches are still crooked. I am keeping them. Go.' },\\n    clementine: { name: 'Clementine', line: 'The sheet is scratchy. I love it. I love all of it. Go sleep.' },\\n  };\\n\\n  GAME.CAST = CAST;\\n  GAME.BARKS = BARKS;\\n  GAME.CASES = CASES;\\n  GAME.ORDER = ['c1', 'c2', 'c3', 'c4', 'c5', 'c6', 'c7', 'c8', 'c9', 'c10', 'c11'];\\n  GAME.LIGHT = LIGHT;\\n  GAME.NODES = NODES;\\n  GAME.WARD = WARD;\\n  GAME.PEOPLE = PEOPLE;\\n  GAME.EXPR = EXPR;\\n  GAME.roundsCase = roundsCase;\\n})();\\n\",\"total_lines\":488}}","is_error":false},{"type":"tool_result","tool_use_id":"call-132c531c-ea22-4534-aa3d-9d36959141d9-14","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"14217→class Story {\\n  /** new E.Story(game, { people, nodes, vars, on, dialog }): the talk of a game (the manual above) */\\n  constructor(game, o = {}) {\\n14220→    /** game: its game; people: who speaks, by id ({ name, portrait, at }); nodes: the conversations by id (lists of\\n     *  steps); on: the game's event handlers by name */\\n    this.game = game; this.people = o.people || {}; this.nodes = o.nodes || {}; this.on = Object.assign({}, o.on);\\n    /** vars: every flag and value (a line's {$name} reads them) */\\n    this.vars = Object.assign({}, o.vars);\\n    /** talk: the E.Dialog it speaks through */\\n    this.talk = o.dialog || new E.Dialog(game); this.talk.vars = this.vars;\\n    /** quests: the quest log, in the order taken ({ id, title, text, done }) */\\n    this.quests = [];\\n    /** log: what was said and chosen, oldest first ({ who, name, text }, the last 200: a visual novel's backlog) */\\n14230→    this.log = [];\\n    /** auto: seconds a page shows before it turns by itself (0: it waits for the player); skip: pages type at once and\\n     *  turn at once (choices still wait) */\\n    this.auto = 0; this.skip = false;\\n    /** running: a node runs; node: its id */\\n    this.running = false; this.node = null;\\n    this._steps = null; this._i = 0; this._wait = 0; this._held = false; this._then = null; this._pick = null; this._done = null; this._balloons = [];\\n  }\\n  /** start node id (stopping any other); o.onDone(story) when it ends */\\n  run(id, o = {}) {\\n14240→    if (!this.nodes[id]) { E.warn('story:' + id, 'E.Story: no node \\\"' + id + '\\\"'); return this; }\\n    if (this.talk.open) this.talk.close();\\n    this.running = true; this.node = id; this._steps = this.nodes[id]; this._i = 0; this._wait = 0; this._held = false; this._then = null; this._pick = null; this._done = o.onDone || null;\\n    this._next(); return this;\\n  }\\n  /** stop the node running (its box closes; onDone isn't called) */\\n  stop() { this.running = false; this.node = null; this._done = null; if (this.talk.open) this.talk.close(); }\\n  /** after an event with wait: true, go on (to the choice's goto, or the next step) */\\n  resume() { if (!this._held) return; this._held = false; const g = this._then; this._then = null; if (g && !this._jump(g)) return; this._next(); }\\n  // the steps until one waits (a line, a pause, a held event) or the node ends\\n14250→  _next() {\\n    while (this.running) {\\n      const s = this._steps[this._i++];\\n      if (!s) return this._end();\\n      if (s.if !== undefined && !this.test(s.if)) continue;\\n      if (s.say !== undefined) return this._say(s);   // (its event, goto and a choice's run when the box closes)\\n      this._act(s); if (!this.running) return;\\n      if (this._fire(s, s.goto)) return;\\n      if (s.goto && !this._jump(s.goto)) return;\\n      if (!s.event && s.wait > 0) { this._wait = s.wait; return; }\\n14260→    }\\n  }\\n  _say(s) {\\n    const p = this.people[s.who] || {}, ch = s.choices && s.choices.filter(c => c.if === undefined || this.test(c.if));\\n    this._act(s); if (!this.running) return;\\n    const name = s.name || p.name || '', note = e => { this.log.push(e); if (this.log.length > 200) this.log.shift(); };\\n    for (const t of [].concat(s.say)) note({ who: s.who || null, name, text: t });\\n    if (this._speed === undefined) this._speed = this.talk.speed;\\n    this.talk.speed = this.skip ? 1e6 : this._speed;\\n    this.talk.say(s.say, { name, portrait: p.portrait, auto: this.skip ? .08 : this.auto || undefined, choices: ch && ch.length ? ch.map(c => c.text) : null, onChoice: i => { this._pick = ch[i]; note({ who: 'choice', name: '', text: ch[i].text }); }, onDone: () => this._after(s) });\\n14270→  }\\n  _after(s) {\\n    const c = this._pick; this._pick = null;\\n    if (c) { this._act(c); if (!this.running || this._fire(c, c.goto)) return; if (c.goto) { if (this._jump(c.goto)) this._next(); return; } }\\n    if (this._fire(s, s.goto)) return;\\n    if (s.goto && !this._jump(s.goto)) return;\\n    this._next();\\n  }\\n  // a step's or a choice's event: true when the story stops here (it ended, or holds till resume(), then goes to then)\\n  _fire(s, then) {\\n14280→    if (!s.event) return false;\\n    const f = this.on[s.event];\\n    if (f) try { f(this, s); } catch (e) { this.game.fail('story event \\\"' + s.event + '\\\"', e); }\\n    else E.warn('story:on:' + s.event, 'E.Story: no handler for event \\\"' + s.event + '\\\" (on: { ' + s.event + '(story, step) {...} })');\\n    if (!this.running) return true;\\n    if (s.wait) { this._held = true; this._then = then || null; return true; }\\n    return false;\\n  }\\n  _jump(id) {\\n    if (!this.nodes[id]) { E.warn('story:' + id, 'E.Story: no node \\\"' + id + '\\\" (a goto)'); this._end(); return false; }\\n14290→    this.node = id; this._steps = this.nodes[id]; this._i = 0; return true;\\n  }\\n  // a step's or a choice's actions: set, add, quest, done, emote, end (its event: _fire)\\n  _act(s) {\\n    if (s.set !== undefined) { if (typeof s.set === 'string') this.vars[s.set] = true; else Object.assign(this.vars, s.set); }\\n    if (s.add) for (const k in s.add) this.vars[k] = (+this.vars[k] || 0) + s.add[k];\\n    if (s.quest) this.quest(...s.quest);\\n    if (s.done) this.done(s.done);\\n    if (s.emote) { const at = (this.people[s.who] || {}).at; if (at) this.emote(at, s.emote); }\\n    if (s.end) this._end();\\n14300→  }\\n  _end() { const f = this._done; this.running = false; this.node = null; this._done = null; if (f) f(this); }\\n  /** run the talk and the balloons; true while a node runs (play waits) */\\n  update(dt) {\\n    for (const b of this._balloons) b.t += dt;\\n    E.prune(this._balloons, b => b.t >= b.dur);\\n    if (!this.running) return false;\\n    if (this._wait > 0) { this._wait -= dt; if (this._wait <= 0) { this._wait = 0; this._next(); } return this.running; }\\n    if (!this._held) this.talk.update(dt);\\n    return this.running;\\n14310→  }\\n  /** a flag or value (key may be a dotted path into vars) */\\n  get(key) { let v = this.vars; for (const k of String(key).split('.')) v = v == null ? undefined : v[k]; return v; }\\n  /** set a flag (value true) or a value */\\n  set(key, value = true) { this.vars[key] = value; return value; }\\n  /** does a condition hold? (the manual's conditions) */\\n  test(c) {\\n    if (c === undefined || c === null) return true;\\n    if (typeof c === 'function') return !!c(this);\\n    if (Array.isArray(c)) return c.every(x => this.test(x));\\n14320→    c = String(c).trim();\\n    if (c[0] === '!') return !this.test(c.slice(1));\\n    let m = /^(quest|done):(.+)$/.exec(c);\\n    if (m) { const q = this.quests.find(q => q.id === m[2]); return !!q && (m[1] === 'quest' || q.done); }\\n    m = /^([\\\\w.$]+)\\\\s*(==|!=|>=|<=|>|<)\\\\s*(.+)$/.exec(c);\\n    if (m) {\\n      const a = this.get(m[1]), w = m[3].trim(), b = w !== '' && !isNaN(+w) ? +w : w.replace(/^['\\\"]|['\\\"]$/g, '');\\n      return m[2] === '==' ? a == b : m[2] === '!=' ? a != b : m[2] === '>=' ? a >= b : m[2] === '<=' ? a <= b : m[2] === '>' ? a > b : a < b;   // (a word compares as text)\\n    }\\n    return !!this.get(c);\\n14330→  }\\n  /** take a quest (or change its title and text): it joins the log */\\n  quest(id, title = id, text = '') {\\n    const q = this.quests.find(q => q.id === id);\\n    if (q) Object.assign(q, { title, text }); else this.quests.push({ id, title, text, done: false });\\n    return this;\\n  }\\n  /** finish a quest (taken now if it wasn't) */\\n  done(id) { if (!this.quests.some(q => q.id === id)) this.quest(id); this.quests.find(q => q.id === id).done = true; return this; }\\n  /** a balloon over target (x, y, z; h: its height) for seconds: '!', '?', 'heart', 'dots', 'note' */\\n14340→  emote(target, kind = '!', seconds = 1.5) { this._balloons.push({ at: target, kind, t: 0, dur: seconds }); return this; }\\n  /** draw the balloons over their targets and the box (anywhere in draw: both go to the overlay) */\\n  draw(r) {\\n    if (this._balloons.length) r.overlay(g => {\\n      for (const b of this._balloons) {\\n        const a = b.at, [sx, sy] = r.w(a.x, a.y, (a.z || 0) + (a.h || 28) + 4), x = Math.round(sx) - 6, y = Math.round(sy) - 14 - Math.round(Math.min(1, b.t * 8) * 3);\\n        px.rect(g, x, y + 1, 13, 9, '#1a1030'); px.rect(g, x + 1, y, 11, 11, '#1a1030'); px.rect(g, x + 1, y + 1, 11, 9, '#ffffff');   // a round-cornered white box,\\n        px.rect(g, x + 4, y + 10, 4, 1, '#ffffff'); px.rect(g, x + 5, y + 11, 2, 1, '#ffffff'); px.dot(g, x + 3, y + 10, '#1a1030'); px.dot(g, x + 8, y + 10, '#1a1030'); px.dot(g, x + 4, y + 11, '#1a1030'); px.dot(g, x + 7, y + 11, '#1a1030'); px.dot(g, x + 5, y + 12, '#1a1030'); px.dot(g, x + 6, y + 12, '#1a1030');   // its tail\\n        if (b.kind === '!') { px.rect(g, x + 6, y + 2, 2, 5, '#e8384a'); px.rect(g, x + 6, y + 8, 2, 1, '#e8384a'); }\\n        else if (b.kind === 'heart') px.sprite(g, HEART, x + 4, y + 3);\\n14350→        else if (b.kind === 'dots') for (let k = 0; k < Math.min(3, Math.floor(b.t * 3) + 1); k++) px.rect(g, x + 3 + k * 3, y + 6, 2, 2, '#1a1030');   // one, two, three\\n        else E.font.text(g, b.kind === 'note' ? '♪' : b.kind, x + 7, y + 2, '#1a1030', { outline: false, align: 'center' });\\n      }\\n    });\\n    this.talk.draw(r);\\n  }\\n  /** its vars and quests, as JSON (for a save) */\\n  state() { return JSON.parse(JSON.stringify({ vars: this.vars, quests: this.quests })); }\\n  /** put back what state() gave (a load) */\\n  restore(s) {\\n14360→    if (!s) return this;\\n    for (const k in this.vars) delete this.vars[k];   // (the same object: the box reads it)\\n    Object.assign(this.vars, JSON.parse(JSON.stringify(s.vars || {}))); this.quests = JSON.parse(JSON.stringify(s.quests || [])); return this;\\n  }\\n}\\nE.Story = Story;\\n})(typeof My3D2dge !== 'undefined' ? My3D2dge : undefined);\\n\\n/*!\\nmy-3D2dge module STRATEGY v0.89.1: real-time strategy and simulation: selection, orders, armies, production, resources, placement, fog, AI; a day clock, needs, overlays\\n14370→https://github.com/michaelcrosato/my-3d2dge (MIT License)\\nLoads after: the full engine only. Needs: grid.\\n\\nFor real-time strategy (Dune II, Warcraft II, Command & Conquer, StarCraft), builders and simulations (SimCity, Theme\\nPark, RollerCoaster Tycoon). It keeps the rules; the game draws (units are plain objects at x, y on a TileMap).\\n- const rts = new E.Strategy(game, { map, kinds, sides: { blue: { res: { gold: 300 } }, red: { res: { gold: 300 } } },\\n  player: 'blue', fog: true, on: { attack(u, t), death(u), made(u), built(b), gathered(u, n), ordered(at, u) } }).\\n  kinds[id]: a unit { hp, speed, r (5), tall (24: its bar's height), atk, range, rate (seconds a blow), sight (cells),\\n  cost: { gold: 50 }, time (to make), gather (a load) }, a building { building: true, w, h, hp, makes: ['worker'],\\n  depot: true, atk, range, cost, time } or a resource { resource: 'gold', amount, w, h }.\\n14380→- rts.spawn(kind, side, x, y, { built: false }) -> { id, kind, side, K, x, y, r, hp, max, orders, face, moving, working,\\n  carry, progress, queue, rally } (a building's or resource's x, y: its middle, snapped to cells it blocks);\\n  rts.of(side, kind), rts.units, rts.remove(u), rts.side(id).res.\\n- rts.order(units, kind, target, { queue }): 'move' ({ x, y }), 'attack' (a unit), 'amove' ({ x, y }: fighting what it\\n  meets), 'gather' (a resource: trips to the nearest depot), 'build' ({ kind, cx, cy }: paid now), 'patrol' ({ x, y }),\\n  'stop'; queue: after the orders it has (Shift). A group moves in formation, slots round the point facing the way, on\\n  one flow field to it, kept apart; idle units fight what comes into sight. rts.smart(units, x, y, target): attack a foe,\\n  gather a resource, else move (a right click).\\n- rts.train(building, kind) (paid now, made after its time, sent to building.rally), rts.cancel(building),\\n  rts.afford(side, cost); rts.canPlace(kind, cx, cy) (free, walkable, seen); rts.ghost(r, kind, cx, cy) draws it.\\n14390→- Selection, rts.input({ order: 'order' }) each step: a click or tap picks the player's unit under it (r.pick: draw them\\n  with { pick: u }) or none; input.box() selects the units inside; Shift adds; a double tap selects that kind on screen;\\n  Ctrl+1..9 keeps a group, 1..9 calls it; the order action (Mouse2) or a tap with a selection on ground, a foe or a\\n  resource gives rts.smart. rts.selected; rts.draw(r) after the world: rings, health bars, the box.\\n- rts.fog (E.Fog: the player's sight; walls block it), rts.visible(u); rts.minimap() is E.Shell's hud({ minimap }) (the\\n  fog, the camera's view, dots; a click moves the camera there).\\n- rts.ai(side, { build: [['worker', 5], ['barracks'], ['soldier', 6]], waves: { first: 90, every: 75, min: 4 }, script })\",\"content_concise\":\"14217→class Story {\\n  /** new E.Story(game, { people, nodes, vars, on, dialog }): the talk of a game (the manual above) */\\n  constructor(game, o = {}) {\\n14220→    /** game: its game; people: who speaks, by id ({ name, portrait, at }); nodes: the conversations by id (lists of\\n     *  steps); on: the game's event handlers by name */\\n    this.game = game; this.people = o.people || {}; this.nodes = o.nodes || {}; this.on = Object.assign({}, o.on);\\n    /** vars: every flag and value (a line's {$name} reads them) */\\n    this.vars = Object.assign({}, o.vars);\\n    /** talk: the E.Dialog it speaks through */\\n    this.talk = o.dialog || new E.Dialog(game); this.talk.vars = this.vars;\\n    /** quests: the quest log, in the order taken ({ id, title, text, done }) */\\n    this.quests = [];\\n    /** log: what was said and chosen, oldest first ({ who, name, text }, the last 200: a visual novel's backlog) */\\n14230→    this.log = [];\\n    /** auto: seconds a page shows before it turns by itself (0: it waits for the player); skip: pages type at once and\\n     *  turn at once (choices still wait) */\\n    this.auto = 0; this.skip = false;\\n    /** running: a node runs; node: its id */\\n    this.running = false; this.node = null;\\n    this._steps = null; this._i = 0; this._wait = 0; this._held = false; this._then = null; this._pick = null; this._done = null; this._balloons = [];\\n  }\\n  /** start node id (stopping any other); o.onDone(story) when it ends */\\n  run(id, o = {}) {\\n14240→    if (!this.nodes[id]) { E.warn('story:' + id, 'E.Story: no node \\\"' + id + '\\\"'); return this; }\\n    if (this.talk.open) this.talk.close();\\n    this.running = true; this.node = id; this._steps = this.nodes[id]; this._i = 0; this._wait = 0; this._held = false; this._then = null; this._pick = null; this._done = o.onDone || null;\\n    this._next(); return this;\\n  }\\n  /** stop the node running (its box closes; onDone isn't called) */\\n  stop() { this.running = false; this.node = null; this._done = null; if (this.talk.open) this.talk.close(); }\\n  /** after an event with wait: true, go on (to the choice's goto, or the next step) */\\n  resume() { if (!this._held) return; this._held = false; const g = this._then; this._then = null; if (g && !this._jump(g)) return; this._next(); }\\n  // the steps until one waits (a line, a pause, a held event) or the node ends\\n14250→  _next() {\\n    while (this.running) {\\n      const s = this._steps[this._i++];\\n      if (!s) return this._end();\\n      if (s.if !== undefined && !this.test(s.if)) continue;\\n      if (s.say !== undefined) return this._say(s);   // (its event, goto and a choice's run when the box closes)\\n      this._act(s); if (!this.running) return;\\n      if (this._fire(s, s.goto)) return;\\n      if (s.goto && !this._jump(s.goto)) return;\\n      if (!s.event && s.wait > 0) { this._wait = s.wait; return; }\\n14260→    }\\n  }\\n  _say(s) {\\n    const p = this.people[s.who] || {}, ch = s.choices && s.choices.filter(c => c.if === undefined || this.test(c.if));\\n    this._act(s); if (!this.running) return;\\n    const name = s.name || p.name || '', note = e => { this.log.push(e); if (this.log.length > 200) this.log.shift(); };\\n    for (const t of [].concat(s.say)) note({ who: s.who || null, name, text: t });\\n    if (this._speed === undefined) this._speed = this.talk.speed;\\n    this.talk.speed = this.skip ? 1e6 : this._speed;\\n    this.talk.say(s.say, { name, portrait: p.portrait, auto: this.skip ? .08 : this.auto || undefined, choices: ch && ch.length ? ch.map(c => c.text) : null, onChoice: i => { this._pick = ch[i]; note({ who: 'choice', name: '', text: ch[i].text }); }, onDone: () => this._after(s) });\\n14270→  }\\n  _after(s) {\\n    const c = this._pick; this._pick = null;\\n    if (c) { this._act(c); if (!this.running || this._fire(c, c.goto)) return; if (c.goto) { if (this._jump(c.goto)) this._next(); return; } }\\n    if (this._fire(s, s.goto)) return;\\n    if (s.goto && !this._jump(s.goto)) return;\\n    this._next();\\n  }\\n  // a step's or a choice's event: true when the story stops here (it ended, or holds till resume(), then goes to then)\\n  _fire(s, then) {\\n14280→    if (!s.event) return false;\\n    const f = this.on[s.event];\\n    if (f) try { f(this, s); } catch (e) { this.game.fail('story event \\\"' + s.event + '\\\"', e); }\\n    else E.warn('story:on:' + s.event, 'E.Story: no handler for event \\\"' + s.event + '\\\" (on: { ' + s.event + '(story, step) {...} })');\\n    if (!this.running) return true;\\n    if (s.wait) { this._held = true; this._then = then || null; return true; }\\n    return false;\\n  }\\n  _jump(id) {\\n    if (!this.nodes[id]) { E.warn('story:' + id, 'E.Story: no node \\\"' + id + '\\\" (a goto)'); this._end(); return false; }\\n14290→    this.node = id; this._steps = this.nodes[id]; this._i = 0; return true;\\n  }\\n  // a step's or a choice's actions: set, add, quest, done, emote, end (its event: _fire)\\n  _act(s) {\\n    if (s.set !==