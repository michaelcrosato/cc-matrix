11,40,39,111,112,39,41,59,34,93,44,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":33,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/tests/run.mjs\",\"matches\":[{\"line_number\":130,\"content\":\"    check('wheel waits out a flick', p.tool === 'forceps', p.tool);\"},{\"line_number\":132,\"content\":\"    check('wheel settles by 100ms', p.tool === 'scalpel', p.tool);\"},{\"line_number\":150,\"content\":\"      hand.wheelT = 0;\"},{\"line_number\":151,\"content\":\"      hand.wheelDir = -1;\"},{\"line_number\":153,\"content\":\"      check('wheel ' + tool, hand.tool === tool, hand.tool);\"},{\"line_number\":156,\"content\":\"    const magnet = (assist) => {\"},{\"line_number\":164,\"content\":\"      T.hands.magnet = 22;\"},{\"line_number\":168,\"content\":\"    const pulled = magnet(0.6);\"},{\"line_number\":169,\"content\":\"    const idle = magnet(0);\"},{\"line_number\":170,\"content\":\"    check('magnet pulls a still hand', pulled > 6, pulled.toFixed(2));\"},{\"line_number\":181,\"content\":\"      T.hands.magnet = 22;\"},{\"line_number\":198,\"content\":\"      T.hands.magnet = 0;\"},{\"line_number\":256,\"content\":\"    const loose = raw();\"},{\"line_number\":257,\"content\":\"    const gap = GAME.Sim.addObj(loose, { type: 'wound', x: 200, y: 130, stitches: 2, drain: 0 });\"},{\"line_number\":259,\"content\":\"    step(loose, [{ x: near[0], y: near[1], tool: 'suture', trig: 1 }], 1 / 60);\"},{\"line_number\":260,\"content\":\"    step(loose, [{ x: 40, y: 40, tool: 'suture', trig: 0 }], 1 / 60);\"},{\"line_number\":261,\"content\":\"    check('a loose stitch slips', loose.ev.some((e) => e[0] === 'loose') && (gap.stitch || 0) === 0, JSON.stringify(loose.ev));\"},{\"line_number\":293,\"content\":\"    check('the cautery locks', burn.players[0].lock > 0 && burned.some((e) => e[0] === 'lock'), 'lock ' + burn.players[0].lock + ' ' + JSON.stringify(burned.filter((e) => e[0] === 'lock' || e[0] === 'slip')));\"},{\"line_number\":391,\"content\":\"    check('Second Look restores the field', rewound && back && Math.abs(back.x - 180) < 0.01 && look.clock > 100, 'x ' + (back && back.x) + ' clock ' + look.clock);\"},{\"line_number\":394,\"content\":\"    check('Second Look leaves ghosts', !!(look.ghosts && look.ghosts.length > 0 && look.ghostT > 0 && look.ghosts[0].cursors && look.ghosts[0].cursors.length), String(look.ghosts && look.ghosts.length));\"},{\"line_number\":596,\"content\":\"    check('a right chart opens the case', game.sceneName === 'op' && RT.S && RT.S.id === 'c2' && RT.S.clock >= 250, game.sceneName + ' ' + (RT.S && RT.S.clock));\"},{\"line_number\":694,\"content\":\"    const ghostCase = GAME.Shell.beginCase('c2', { seed: 1, phase: 0 });\"},{\"line_number\":695,\"content\":\"    ghostCase.gift = 'look';\"},{\"line_number\":696,\"content\":\"    ghostCase.activeDoc = 'sokolova';\"},{\"line_number\":701,\"content\":\"    for (let i = 0; i < 8; i++) GAME.Op.step(ghostCase, [{ trig: 0 }], 0.05);\"},{\"line_number\":702,\"content\":\"    ghostCase.players[0].x = 40;\"},{\"line_number\":703,\"content\":\"    ghostCase.players[0].bx = 40;\"},{\"line_number\":704,\"content\":\"    ghostCase.clock = 5;\"},{\"line_number\":705,\"content\":\"    ghostCase.steady = 80;\"},{\"line_number\":706,\"content\":\"    const ghosted = GAME.Op.secondLook(ghostCase, tune());\"},{\"line_number\":707,\"content\":\"    check('the operation rewinds into ghosts', ghosted && ghostCase.ghosts.length > 0 && ghostCase.ghostT > 0, String(ghostCase.ghosts && ghostCase.ghosts.length));\"},{\"line_number\":718,\"content\":\"    check('Second Look ghosts are drawn', seenGhost.length > 0 && game.errors.length === errBefore, 'paints ' + seenGhost.length + ' ' + JSON.stringify(game.errors).slice(0, 240));\"},{\"line_number\":934,\"con