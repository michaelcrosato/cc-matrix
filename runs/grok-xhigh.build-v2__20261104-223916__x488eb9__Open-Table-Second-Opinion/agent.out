":\"      clock: 180, vitals: 80, drain: 0.05, par: 1400, brief: 'Glass in a greenhouse roof. She wants the pieces saved.',\"},{\"line_number\":49,\"content\":\"      phases: [\"},{\"line_number\":61,\"content\":\"      id: 'c2', name: 'Low Brass', patient: 'Desmond Achebe', chapter: 1, doctor: 'vale', site: 'abdomen',\"},{\"line_number\":62,\"content\":\"      clock: 240, vitals: 78, drain: 0.06, par: 2200, lightbox: true,\"},{\"line_number\":64,\"content\":\"      phases: [\"},{\"line_number\":81,\"content\":\"      id: 'c3', name: 'Crane Nine', patient: 'Big Tam Rennie', chapter: 1, doctor: 'vale', site: 'abdomen',\"},{\"line_number\":82,\"content\":\"      clock: 220, vitals: 72, drain: 0.08, par: 2600, brief: 'The harbor crane came down. The Chief is away.',\"},{\"line_number\":83,\"content\":\"      phases: [\"},{\"line_number\":106,\"content\":\"      id: 'c4', name: 'The Whistling Man', patient: 'Ned Harrow', chapter: 2, doctor: 'vale', site: 'flank',\"},{\"line_number\":107,\"content\":\"      clock: 230, vitals: 76, drain: 0.07, par: 2400, lightbox: true, brief: 'A gaff in his side, and he is whistling.',\"},{\"line_number\":108,\"content\":\"      phases: [\"},{\"line_number\":123,\"content\":\"      id: 'c5', name: 'Slur', patient: 'Ilse Brandt', chapter: 2, doctor: 'vale', site: 'forearm',\"},{\"line_number\":124,\"content\":\"      clock: 260, vitals: 76, drain: 0.06, par: 2800, brief: 'A violinist who cannot feel the string, and likes it.',\"},{\"line_number\":125,\"content\":\"      phases: [\"},{\"line_number\":136,\"content\":\"      id: 'c6', name: 'Bedside Manner', patient: 'Marguerite Oyelaran', chapter: 2, doctor: 'vale', site: 'heart',\"},{\"line_number\":137,\"content\":\"      clock: 280, vitals: 70, drain: 0.07, par: 3000, brief: 'The Chief drops her cane at her own gala.',\"},{\"line_number\":138,\"content\":\"      phases: [\"},{\"line_number\":151,\"content\":\"      id: 'c7', name: 'Force Nine', patient: 'Yusuf Demir', chapter: 3, doctor: 'sokolova', site: 'ship',\"},{\"line_number\":152,\"content\":\"      clock: 210, vitals: 70, drain: 0.07, par: 2400, brief: 'A winch, a storm, and a second look.',\"},{\"line_number\":153,\"content\":\"      phases: [\"},{\"line_number\":168,\"content\":\"      id: 'c8', name: 'From the Top', patient: 'Sister Perpetua', chapter: 3, doctor: 'sokolova', site: 'abdomen',\"},{\"line_number\":169,\"content\":\"      clock: 280, vitals: 74, drain: 0.06, par: 3200, brief: 'What you cut grows back, humming.',\"},{\"line_number\":170,\"content\":\"      phases: [\"},{\"line_number\":180,\"content\":\"      id: 'c9', name: \\\"Dead Man's Rhythm\\\", patient: 'Hollis Crane', chapter: 3, doctor: 'sokolova', site: 'implant',\"},{\"line_number\":181,\"content\":\"      clock: 240, vitals: 74, drain: 0.06, par: 2600, brief: 'A pacemaker that must not be bullied.',\"},{\"line_number\":182,\"content\":\"      phases: [\"},{\"line_number\":201,\"content\":\"      id: 'c10', name: 'Eloquent Cortex', patient: 'Percival Whitlock', chapter: 4, doctor: 'both', site: 'brain',\"},{\"line_number\":202,\"content\":\"      clock: 260, vitals: 70, drain: 0.06, par: 2000, lightbox: true, consult: true,\"},{\"line_number\":204,\"content\":\"      phases: [\"},{\"line_number\":217,\"content\":\"      id: 'c11', name: 'Last Note', patient: 'Clementine Hale', chapter: 4, doctor: 'both', site: 'mediastinum',\"},{\"line_number\":218,\"content\":\"      clock: 520, vitals: 82, drain: 0.04, par: 4000, consult: true,\"},{\"line_number\":220,\"content\":\"      phases: [\"},{\"line_number\":245,\"content\":\"      clock: 260 + 30 * n, vitals: 84, drain: 0.04, par: 2000 + 400 * n, mode: 'rounds', players: n,\"},{\"line_number\":247,\"content\":\"      phases: [\"},{\"line_number\":263,\"content\":\"    clock: 999, vitals: 90, drain: 0, par: 1, lab: true, brief: 'It has signed the waiver.',\"},{\"line_number\":264,\"content\":\"    phases: [{\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"sessio