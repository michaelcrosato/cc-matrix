umber\":9125,\"content\":\"  /** where choice i is on the screen while the choices show: [x, y] (its middle, for a test's tap), else null */\"},{\"line_number\":9126,\"content\":\"  choiceAt(i) { if (!this.open || !this.choices || this.typing || this.i < this.pages.length - 1 || !this.choices[i]) return null; const d = this._dims(), b = this._cbox(d); return [Math.round(b.x + b.w / 2), Math.round(b.y + 3 + (i + .5) * d.lh)]; }\"},{\"line_number\":9127,\"content\":\"  // the choices' box, over the box's right end\"},{\"line_number\":9128,\"content\":\"  _cbox(d) { const w = Math.max(...this.choices.map(c => E.font.width(c))) + 20, h = this.choices.length * d.lh + 7; return { x: d.x + d.w - w - 2, y: d.y - h - 2, w, h }; }\"},{\"line_number\":9140,\"content\":\"   * opts: { name, onDone, choices, onChoice, portrait: rig (a live close-up of that Humanoid beside the text) or a function (g, x, y, size),\"},{\"line_number\":9144,\"content\":\"   * choices: ['YES', 'NO'], shown on the last page (picked by the keys, or a tap or click on one); onChoice(i) gets the\"},{\"line_number\":9167,\"content\":\"    /** name: the speaker's name shown on the box; onDone: called when the last page closes; choices: the answers\"},{\"line_number\":9169,\"content\":\"    this.name = o.name || null; this.onDone = o.onDone || null; this.choices = o.choices || null; this.onChoice = o.onChoice || null; this._blip = 0;\"},{\"line_number\":9197,\"content\":\"    const last = this.i >= this.pages.length - 1, asking = last && this.choices && !this.typing;\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"c9a52493-104e-4d58-a1aa-951eb1af588a"}
