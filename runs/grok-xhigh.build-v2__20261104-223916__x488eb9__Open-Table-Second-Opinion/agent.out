playTune()); }\\n    catch (e) { game.fail('op', e); }\\n    if (S.ev) for (const ev of S.ev) { try { GAME.Audio.onEv(ev); } catch (err) { /* quiet */ } }\\n    return S;\\n  }\\n\\n  function fieldOf(S) {\\n    const key = (S.site || 'abdomen') + ':' + (S.seed || 1) + ':' + game.W + 'x' + game.H;\\n    if (RT.fieldKey !== key) {\\n      RT.field = GAME.Art.fieldFor(S.site || 'abdomen', S.seed || 1, game.W, game.H);\\n      RT.fieldKey = key;\\n    }\\n    return RT.field;\\n  }\\n\\n  const COL = {\\n    shard: '#d5dee6', laceration: '#e05050', wound: '#c43030', bleeder: '#ff4040', arteryTear: '#ff2060',\\n    pool: '#601828', polyp: '#e08898', mass: '#c06078', clot: '#682838', patch: '#e07070',\\n    nerve: '#e2c14a', eloquent: '#f0d060', retractor: '#c8d0d4', bead: '#5ff0e0', nest: '#14383c',\\n    lobe: '#7a5cff', eye: '#d0c8ff', tendril: '#3ec8b0', uvula: '#9a78ff', voice: '#5ff0e0', reed: '#8fd0c8',\\n    repeat: '#f5b700', slur: '#9ad8d0', hook: '#d0d4d8', screw: '#e8e0c8', wire: '#f0d060', lead: '#88e0c8',\\n    cut: '#f2f0e6', fed: '#401018', bite: '#e05050',\\n  };\\n  function bloodCol() {\\n    if (PREFS.blood === 'rose') return '#e07098';\\n    if (PREFS.blood === 'ink') return '#2a2030';\\n    return null;\\n  }\\n\\n  function drawOp(r, S, ribbon) {\\n    const [ox, oy] = origin();\\n\",\"total_lines\":1430}}","is_error":false},{"type":"tool_result","tool_use_id":"call-450bdec0-589c-4ccd-8033-b7d9882e2a24-36","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"540→  });\\n\\n  group('shell', () => {\\n    const game = GAME.Shell.game;\\n    const RT = GAME.Shell.RT;\\n    game.fadeTime = 0;\\n    GAME.Dev.reset();\\n    GAME.Art.force = false;\\n    RT.cheatUsed = false;\\n    game.advance(1 / 30);\\n550→    check('boots on the title', game.sceneName === 'title', game.sceneName);\\n    check('headless frame', game.H === 240 && game.W >= 420 && game.W <= 434, game.W + 'x' + game.H);\\n    check('music is quiet', game.audio.musicVolume === 0.1, String(game.audio.musicVolume));\\n    check('effects are full', game.audio.sfxVolume === 1, String(game.audio.sfxVolume));\\n    check('voices sit under effects', Math.abs(game.audio.voiceVolume - 0.9) < 0.001, String(game.audio.voiceVolume));\\n    check('master', Math.abs(game.audio.volume - 0.7) < 0.001, String(game.audio.volume));\\n    check('title draws', !game.errors.length, JSON.stringify(game.errors));\\n    check('PlayStation prompt', game.input.label('useTool', 'gamepad') === 'R2', game.input.label('useTool', 'gamepad'));\\n    const devItem = (game.o.menu.items || []).find((it) => it && it[0] === 'Dev Mode');\\n    check('dev mode is on the pause menu', !!(devItem && typeof devItem[1] === 'function'));\\n560→\\n    const press = (action) => {\\n      game.input.tap(action);\\n      game.advance(game.o.step);\\n      game.advance(game.o.step);\\n    };\\n    const enter = () => { game.advance(game.o.step); game.advance(game.o.step); };\\n\\n    game.advance(10.2);\\n    check('attract starts after ten seconds', game.sceneName === 'attract', game.sceneName);\\n570→    press('confirm');\\n    check('attract returns to the title', game.sceneName === 'title' && !GAME.Shell.snapshot().menu, game.sceneName);\\n\\n    press('confirm');\\n    const labels = (GAME.Shell.snapshot().menu && GAME.Shell.snapshot().menu.labels) || [];\\n    check('menu rows', labels.join('|') === 'New Game|Case Files|Grand Rounds|Skills Lab|About', labels.join('|'));\\n    press('down');\\n    press('down');\\n    press('down');\\n    press('down');\",\"content_concise\":\"540→  });\\n\\n  group('shell', () => {\\n    const game = GAME.Shell.game;\\n    const RT = GAME.Shell.RT;\\n    game.fadeTime = 0;\\n    GAME.Dev.reset();\\n    GAME.Art.force = false;\\n    RT.cheatUsed = false;\\n    game.advance(1 / 30);\\n550→    check('boots on the title', game.sceneName === 'title', game.sceneName);\\n    check('headless frame', game.H === 240 && game.W >= 420 && game.W <= 434, game.W +