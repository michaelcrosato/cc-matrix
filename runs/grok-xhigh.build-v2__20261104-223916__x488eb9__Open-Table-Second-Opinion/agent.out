59,34,93,44,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":16,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/tests/run.mjs\",\"matches\":[{\"line_number\":130,\"content\":\"    check('wheel waits out a flick', p.tool === 'forceps', p.tool);\"},{\"line_number\":132,\"content\":\"    check('wheel settles by 100ms', p.tool === 'scalpel', p.tool);\"},{\"line_number\":166,\"content\":\"    const cut = GAME.Sim.addObj(slipS, { type: 'cut', x: 200, y: 120, guide: [[160, 120], [280, 120]], drain: 0 });\"},{\"line_number\":173,\"content\":\"    const guide = mass.guide;\"},{\"line_number\":174,\"content\":\"    step(ring, [{ x: guide[0][0], y: guide[0][1], tool: 'scalpel', trig: 1, mouse: true }], 1 / 60);\"},{\"line_number\":175,\"content\":\"    for (const pt of guide) step(ring, [{ x: pt[0], y: pt[1], tool: 'scalpel', trig: 1, mouse: true }], 1 / 60);\"},{\"line_number\":322,\"content\":\"    const start = mass.guide[0];\"},{\"line_number\":482,\"content\":\"    game.settings.set('assist', 0.4);\"},{\"line_number\":484,\"content\":\"    check('assist and cursor prefs stay clean', GAME.TUNE.dirty === dirtyBefore && GAME.PREFS.assist === 0.4 && GAME.PREFS.cursor === 200);\"},{\"line_number\":485,\"content\":\"    game.settings.set('assist', 0.6);\"},{\"line_number\":575,\"content\":\"      const page = await browser.newPage({ viewport: { width: 1920, height: 1080 }, deviceScaleFactor: 1 });\"},{\"line_number\":588,\"content\":\"          cw: cvs && cvs.width, ch: cvs && cvs.height,\"},{\"line_number\":618,\"content\":\"      const page = await browser.newPage({ viewport: { width: 1280, height: 720 } });\"},{\"line_number\":630,\"content\":\"      const page = await browser.newPage({ viewport: { width: 1920, height: 1080 } });\"},{\"line_number\":689,\"content\":\"    const page = await browser.newPage({ viewport: { width: 1920, height: 1080 }, deviceScaleFactor: 1 });\"},{\"line_number\":707,\"content\":\"      ['wheel', \\\"GAME.Shell.beginCase('c1',{seed:3}); GAME.Shell.RT.wheelShow=4; game.fadeTime=0; game.go('op');\\\"],\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-08d45330-9b5a-4fe5-8480-871149e812f9-25","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1650→  function updateCursor(p, dev, S, dt, tune) {\\n    tune = tuneOf(tune);\\n    dev = dev || {};\\n    if (dev.mouse) {\\n      p.bx = dev.mouse[0]; p.by = dev.mouse[1];\\n      p.x = p.bx; p.y = p.by;\\n      p.fine = !!dev.fine;\\n      return p;\\n    }\\n    const aim = dev.aim || [0, 0];\\n1660→    let mag = hypot(aim[0], aim[1]);\\n    let dirx = mag > 1e-6 ? aim[0] / mag : 0;\\n    let diry = mag > 1e-6 ? aim[1] / mag : 0;\\n    mag = Math.min(1, mag);\\n    const curved = Math.pow(mag, tune.hands.curve);\\n    let speed = curved * tune.hands.cursor;\\n    if (dev.fine) speed *= tune.hands.fine;\\n    if (S && (S.activeDoc === 'vale')) speed *= 1.15;\\n    /* 0.06s ramp */\\n    const k = 1 - Math.exp(-dt / 0.06);\\n1670→    p.speed += (speed - (p.speed || 0)) * (dt > 0 ? k : 1);\\n    let vx = dirx * p.speed;\\n    let vy = diry * p.speed;\\n    const keys = dev.keys || [0, 0];\\n    const keySp = 200 * (dev.fine ? tune.hands.fine : 1);\\n    vx += keys[0] * keySp; vy += keys[1] * keySp;\\n    const nudge = dev.nudge || [0, 0];\\n    vx += nudge[0] * 40; vy += nudge[1] * 40;\\n\\n    const assist = S ? assistOf(S, tune) : tune.hands.assist;\\n1680→    const tgt = S ? validTarget(S, p, tune) : null;\\n    if (tgt && mag < 0.95) {\\n      vx *= 1 - 0.55 * Math.min(1, assist);\\n      vy *= 1 - 0.55 * Math.min(1, assist);\\n      if (mag < 0.12) {\\n        const dx = tgt.x - p.bx, dy = tgt.y - p.by;\\n        const d = hypot(dx, dy) || 1;\\n        const pull = 90 * assist;\\n        vx += (dx / d) * pull; vy += (dy / d) * pull;\\n      }\\n1690→    }\\n    if (S && p.stroke && (p.stroke.kind === 'scalpel' || p.stroke.kind === 'suture')) {\\n      const o = objById(S, p.stroke.id);\\n      let tanv = [1, 0];\\n      if (o && o.guide) tanv = polyDist(o.guide, p.bx, p.by).tan;\\n      else if (p.stroke.kind === 'suture' && o && o.pairs) {\\n        const pair = o.pairs[o.stitch] || o.pairs[0];\\n        const dx = pair[1][0] - pair[0][0], dy = pair[1][1] - pair[0][1];\\n        const L = hypot(dx, dy) || 1;\\n        tanv = [dx / L, dy / L];\\n1700→      }\\n      const along = vx * tanv[0] + vy * tanv[1];\\n      const cx = vx - along * tanv[0], cy = vy - along * tanv[1];\\n      const scale = 1 - 0.8 * Math.min(1, assist);\\n      vx = along * tanv[0] + cx * scale;\\n      vy = along * tanv[1] + cy * scale;\\n    }\\n    p.bx = clamp(p.bx + vx * dt, 8, CFG.FIELD_W - 8);\\n    p.by = clamp(p.by + vy * dt, 8, CFG.FIELD_H - 8);\\n    const j = S ? jitterOf(S, p) : [0, 0];\\n1710→    p.x = p.bx + j[0];\\n    p.y = p.by + j[1];\\n    p.fine = !!dev.fine;\\n    return p;\\n  }\\n\\n  function wheelIndex(x, y) {\\n    const ang = Math.atan2(y, x); /* 0 east, clockwise because y grows downward */\\n    let d = ang - (-Math.PI / 2);\\n    if (d < 0) d += TAU;\\n1720→    if (d >= TAU) d -= TAU;\\n    return Math.round(d / (Math.PI / 4)) % 8;\\n  }\\n\\n  function updateWheel(p, dev, dt) {\\n    dev = dev || {};\\n    if (dev.digit) {\\n      const i = (dev.digit - 1) % 8;\\n      if (p.tool !== CFG.TOOLS[i]) { p.tool = CFG.TOOLS[i]; p.swap = 0.12; }\\n      return p.tool;\\n1730→    }\\n    const m = dev.move || [0, 0];\\n    const mag = hypot(m[0], m[1]);\\n    if (mag < 0.6) { p.wheelT = 0; p.wheelDir = -1; return p.tool; }\\n    const dir = wheelIndex(m[0], m[1]);\\n    if (dir !== p.wheelDir) { p.wheelDir = dir; p.wheelT = 0; }\\n    p.wheelT += dt;\\n    if (p.wheelT >= 0.08 && p.tool !== CFG.TOOLS[dir]) {\\n      p.tool = CFG.TOOLS[dir];\\n      p.swap = 0.12;\\n1740→      p.wheelT = 0;\\n    }\\n    return p.tool;\\n  }\\n\\n  function retryPhase(S) {\\n    if (!S.checkpoint) return false;\\n    restoreCore(S, S.checkpoint, false);\\n    S.rankCap = 'B';\\n    S.lost = false;\\n1750→    S.won = false;\\n    S.codeBlue = null;\\n    S.reason = '';\\n    for (const p of S.players) { p.held = 0; p.stroke = null; }\\n    pushEv(S, ['retry', S.phase]);\\n    return true;\\n  }\\n\\n  GAME.Sim = {\\n    rnd, clamp, clone, addObj, makePlayer, blank, create, createRaw, step,\\n1760→    takeCore, applyCore, hashCore, rankLetter, secondLook, forceRewind, retryPhase,\\n    updateCursor, updateWheel, wheelIndex, spawnStrain, phaseClear, objById,\\n    polyDist, lose, DRAIN,\\n  };\\n  GAME.Op = { create, createRaw, step, takeCore, hash: S => hashCore(takeCore(S)), rankLetter, secondLook, forceRewind, retryPhase, spawnStrain };\\n  GAME.Cursor = { update: updateCursor, jitterOf, assistOf };\\n  GAME.Wheel = { update: updateWheel, index: wheelIndex, TOOLS: CFG.TOOLS };\\n})();\\n\",\"content_concise\":\"1650→  function updateCursor(p, dev, S, dt, tune) {\\n    tune = tuneOf(tune);\\n    dev = dev || {};\\n    if (dev.mouse) {\\n      p.bx = dev.mouse[0]; p.by = dev.mouse[1];\\n      p.x = p.bx; p.y = p.by;\\n      p.fine = !!dev.fine;\\n      return p;\\n    }\\n    const aim = dev.aim || [0, 0];\\n1660→    let mag = hypot(aim[0], aim[1]);\\n    let dirx = mag > 1e-6 ? aim[0] / mag : 0;\\n    let diry = mag > 1e-6 ? aim[1] / mag : 0;\\n    mag = Math.min(1, mag);\\n    const curved = Math.pow(mag, tune.hands.curve);\\n    let speed = curved * tune.hands.cursor;\\n    if (dev.fine) speed *= tune.hands.fine;\\n    if (S && (S.activeDoc === 'vale')) speed *= 1.15;\\n    /* 0.06s ramp */\\n    const k = 1 - Math.exp(-dt / 0.06);\\n1670→    p.speed += (speed - (p.speed || 0)) * (dt > 0 ? k : 1);\\n    let vx = dirx * p.speed;\\n    let vy = diry * p.speed;\\n    const keys = dev.keys || [0, 0];\\n    const keySp = 200 * (dev.fine ? tune.hands.fine : 1);\\n    vx += keys[0] * keySp; vy += keys[1] * keySp;\\n    const nudge = dev.nudge || [0, 0];\\n    vx += nudge[0] * 40; vy += nudge[1] * 40;\\n\\n    const assist = S ? assistOf(S, tune) : tune.hands.assist;\\n1680→    const tgt = S ? validTarget(S, p, tune) : null;\\n    if (tgt && mag < 0.95) {\\n      vx *= 1 - 0.55 * Math.min(1, assist);\\n      vy *= 1 - 0.55 * Math.min(1, assist);\\n      if (mag < 0.12) {\\n        const dx = tgt.x - p.bx, dy = tgt.y - p.by;\\n        const d = hypot(dx, dy) || 1;\\n        const pull = 90 * assist;\\n        vx += (dx / d) * pull; vy += (dy / d) * pull;\\n      }\\n1690→    }\\n    if (S && p.stroke && (p.stroke.kind === 'scalpel' || p.stroke.kind === 'suture')) {\\n      const o = objById(S, p.stroke.id);\\n      let tanv = [1, 0];\\n      if (o && o.guide) tanv = polyDist(o.guide, p.bx, p.by).tan;\\n      else if (p.stroke.kind === 'suture' && o && o.pairs) {\\n        const pair = o.pairs[o.stitch] || o.pairs[0];\\n        const dx = pair[1][0] - pair[0][0], dy = pair[1][1] - pair[0][1];\\n        const L = hypot(dx, dy) || 1;\\n        tanv = [dx / L, dy / L];\\n1700→      }\\n      const along = vx * tanv[0] + vy * tanv[1];\\n      const cx = vx - along * tanv[0], cy = vy - along * tanv[1];\\n      const scale = 1 - 0.8 * Math.min(1, assist);\\n      vx = along * tanv[0] + cx * scale;\\n      vy = along * tanv[1] + cy * scale;\\n    }\\n    p.bx = clamp(p.bx + vx * dt, 8, CFG.FIELD_W - 8);\\n    p.by = clamp(p.by + vy * dt, 8, CFG.FIELD_H - 8);\\n    const j = S ? jitterOf(S, p) : [0, 0];\\n1710→    p.x = p.bx + j[0];\\n    p.y = p.by + j[1];\\n    p.fine = !!dev.fine;\\n    return p;\\n  }\\n\\n  function wheelIndex(x, y) {\\n    const ang = Math.atan2(y, x); /* 0 east, clockwise because y grows downward */\\n    let d = ang - (-Math.PI / 2);\\n    if (d < 0) d += TAU;\\n1720→    if (d >= TAU) d -= TAU;\\n    return Math.round(d / (Math.PI / 4)) % 8;\\n  }\\n\\n  function updateWheel(p, dev, dt) {\\n    dev = dev || {};\\n    if (dev.digit) {\\n      const i = (dev.digit - 1) % 8;\\n      if (p.tool !== CFG.TOOLS[i]) { p.tool = CFG.TOOLS[i]; p.swap = 0.12; }\\n      return p.tool;\\n1730→    }\\n    const m = dev.move || [0, 0];\\n    const mag = hypot(m[0], m[1]);\\n    if (mag < 0.6) { p.wheelT = 0; p.wheelDir = -1; return p.tool; }\\n    const dir = wheelIndex(m[0], m[1]);\\n    if (dir !== p.wheelDir) { p.wheelDir = dir; p.wheelT = 0; }\\n    p.wheelT += dt;\\n    if (p.wheelT >= 0.08 && p.tool !== CFG.TOOLS[dir]) {\\n      p.tool = CFG.TOOLS[dir];\\n      p.swap = 0.12;\\n1740→      p.wheelT = 0;\\n    }\\n    return p.tool;\\n  }\\n\\n  function retryPhase(S) {\\n    if (!S.checkpoint) return false;\\n    restoreCore(S, S.checkpoint, false);\\n    S.rankCap = 'B';\\n    S.lost = false;\\n1750→    S.won = false;\\n    S.codeBlue = null;\\n    S.reason = '';\\n    for (const p of S.players) { p.held = 0; p.stroke = null; }\\n    pushEv(S, ['retry', S.phase]);\\n    return true;\\n  }\\n\\n  GAME.Sim = {\\n    rnd, clamp, clone, addObj, makePlayer, blank, create, createRaw, step,\\n1760→    takeCore, applyCore, hashCore, rankLetter, secondLook, forceRewind, retryPhase,\\n    updateCursor, updateWheel, wheelIndex, spawnStrain, phaseClear, objById,\\n    polyDist, lose, DRAIN,\\n  };\\n  GAME.Op = { create, createRaw, step, takeCore, hash: S => hashCore(takeCore(S)), rankLetter, secondLook, forceRewind, retryPhase, spawnStrain };\\n  GAME.Cursor = { update: updateCursor, jitterOf, assistOf };\\n  GAME.Wheel = { update: updateWheel, index: wheelIndex, TOOLS: CFG.TOOLS };\\n})();\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/core/sim.js\",\"offset\":1650,\"limit\":200,\"raw_output\":\"  function updateCursor(p, dev, S, dt, tune) {\\n    tune = tuneOf(tune);\\n    dev = dev || {};\\n    if (dev.mouse) {\\n      p.bx = dev.mouse[0]; p.by = dev.mouse[1];\\n      p.x = p.bx; p.y = p.by;\\n      p.fine = !!dev.fine;\\n      return p;\\n    }\\n    const aim = dev.aim || [0, 0];\\n    let mag = hypot(aim[0], aim[1]);\\n    let dirx = mag > 1e-6 ? aim[0] / mag : 0;\\n    let diry = mag > 1e-6 ? aim[1] / mag : 0;\\n    mag = Math.min(1, mag);\\n    const curved = Math.pow(mag, tune.hands.curve);\\n    let speed = curved * tune.hands.cursor;\\n    if (dev.fine) speed *= tune.hands.fine;\\n    if (S && (S.activeDoc === 'vale')) speed *= 1.15;\\n    /* 0.06s ramp */\\n    const k = 1 - Math.exp(-dt / 0.06);\\n    p.speed += (speed - (p.speed || 0)) * (dt > 0 ? k : 1);\\n    let vx = dirx * p.speed;\\n    let vy = diry * p.speed;\\n    const keys = dev.keys || [0, 0];\\n    const keySp = 200 * (dev.fine ? tune.hands.fine : 1);\\n    vx += keys[0] * keySp; vy += keys[1] * keySp;\\n    const nudge = dev.nudge || [0, 0];\\n    vx += nudge[0] * 40; vy += nudge[1] * 40;\\n\\n    const assist = S ? assistOf(S, tune) : tune.hands.assist;\\n    const tgt = S ? validTarget(S, p, tune) : null;\\n    if (tgt && mag < 0.95) {\\n      vx *= 1 - 0.55 * Math.min(1, assist);\\n      vy *= 1 - 0.55 * Math.min(1, assist);\\n      if (mag < 0.12) {\\n        const dx = tgt.x - p.bx, dy = tgt.y - p.by;\\n        const d = hypot(dx, dy) || 1;\\n        const pull = 90 * assist;\\n        vx += (dx / d) * pull; vy += (dy / d) * pull;\\n      }\\n    }\\n    if (S && p.stroke && (p.stroke.kind === 'scalpel' || p.stroke.kind === 'suture')) {\\n      const o = objById(S, p.stroke.id);\\n      let tanv = [1, 0];\\n      if (o && o.guide) tanv = polyDist(o.guide, p.bx, p.by).tan;\\n      else if (p.stroke.kind === 'suture' && o && o.pairs) {\\n        const pair = o.pairs[o.stitch] || o.pairs[0];\\n        const dx = pair[1][0] - pair[0][0], dy = pair[1][1] - pair[0][1];\\n        const L = hypot(dx, dy) || 1;\\n        tanv = [dx / L, dy / L];\\n      }\\n      const along = vx * tanv[0] + vy * tanv[1];\\n      const cx = vx - along * tanv[0], cy = vy - along * tanv[1];\\n      const scale = 1 - 0.8 * Math.min(1, assist);\\n      vx = along * tanv[0] + cx * scale;\\n      vy = along * tanv[1] + cy * scale;\\n    }\\n    p.bx = clamp(p.bx + vx * dt, 8, CFG.FIELD_W - 8);\\n    p.by = clamp(p.by + vy * dt, 8, CFG.FIELD_H - 8);\\n    const j = S ? jitterOf(S, p) : [0, 0];\\n    p.x = p.bx + j[0];\\n    p.y = p.by + j[1];\\n    p.fine = !!dev.fine;\\n    return p;\\n  }\\n\\n  function wheelIndex(x, y) {\\n    const ang = Math.atan2(y, x); /* 0 east, clockwise because y grows downward */\\n    let d = ang - (-Math.PI / 2);\\n    if (d < 0) d += TAU;\\n    if (d >= TAU) d -= TAU;\\n    return Math.round(d / (Math.PI / 4)) % 8;\\n  }\\n\\n  function updateWheel(p, dev, dt) {\\n    dev = dev || {};\\n    if (dev.digit) {\\n      const i = (dev.digit - 1) % 8;\\n      if (p.tool !== CFG.TOOLS[i]) { p.tool = CFG.TOOLS[i]; p.swap = 0.12; }\\n      return p.tool;\\n    }\\n    const m = dev.move || [0, 0];\\n    const mag = hypot(m[0], m[1]);\\n    if (mag < 0.6) { p.wheelT = 0; p.wheelDir = -1; return p.tool; }\\n    const dir = wheelIndex(m[0], m[1]);\\n    if (dir !== p.wheelDir) { p.wheelDir = dir; p.wheelT = 0; }\\n    p.wheelT += dt;\\n    if (p.wheelT >= 0.08 && p.tool !== CFG.TOOLS[dir]) {\\n      p.tool = CFG.TOOLS[dir];\\n      p.swap = 0.12;\\n      p.wheelT = 0;\\n    }\\n    return p.tool;\\n  }\\n\\n  function retryPhase(S) {\\n    if (!S.checkpoint) return false;\\n    restoreCore(S, S.checkpoint, false);\\n    S.rankCap = 'B';\\n    S.lost = false;\\n    S.won = false;\\n    S.codeBlue = null;\\n    S.reason = '';\\n    for (const p of S.players) { p.held = 0; p.stroke = null; }\\n    pushEv(S, ['retry', S.phase]);\\n    return true;\\n  }\\n\\n  GAME.Sim = {\\n    rnd, clamp, clone, addObj, makePlayer, blank, create, createRaw, step,\\n    takeCore, applyCore, hashCore, rankLetter, secondLook, forceRewind, retryPhase,\\n    updateCursor, updateWheel, wheelIndex, spawnStrain, phaseClear, objById,\\n    polyDist, lose, DRAIN,\\n  };\\n  GAME.Op = { create, createRaw, step, takeCore, hash: S => hashCore(takeCore(S)), rankLetter, secondLook, forceRewind, retryPhase, spawnStrain };\\n  GAME.Cursor = { update: updateCursor, jitterOf, assistOf };\\n  GAME.Wheel = { update: updateWheel, index: wheelIndex, TOOLS: CFG.TOOLS };\\n})();\\n\",\"total_lines\":1767}}","is_error":false},{"type":"tool_result","tool_use_id":"call-08d45330-9b5a-4fe5-8480-871149e812f9-26","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1310→      pushEv(S, ['lurch', 1]);\\n    } else if (id === 'blackout') { S.dim = 1; }\\n    else if (id === 'roll') { S.tiltAmp = 1; }\\n    else if (id === 'quiet') { S.flags.quiet = true; S.flags.needBreath = true; }\\n    else if (id === 'refill') { S.clock += 120; }\\n    else if (id === 'cantorRewind') { forceRewind(S, true); }\\n    else if (id === 'code') { S.vitals = 0; }\\n  }\\n\\n  function stepWorld(S, worldDt, handDt, tune) {\\n1320→    if (S.flags.dip) {\\n      S.vitals += (S.flags.dip - S.vitals) * Math.min(1, worldDt * 2);\\n      if (Math.abs(S.vitals - S.flags.dip) < 0.4) { S.vitals = S.flags.dip; S.flags.dip = 0; }\\n    }\\n    if (S.flags.crash) {\\n      S.vitals -= S.flags.crash * worldDt;\\n    }\\n    if (S.tiltAmp) {\\n      const drift = Math.sin(S.worldT * 0.7) * 25 * S.tiltAmp;\\n      for (const o of S.objects) if (o.type === 'pool' && !o.done) {\\n1330→        o.x = clamp(o.x + drift * worldDt, 60, 360);\\n      }\\n    }\\n    for (const o of S.objects) {\\n      if (o.markT > 0) { o.markT -= handDt; if (o.markT <= 0 && o.hidden) o.marked = false; }\\n      if (o.revealWhen && o.hidden) {\\n        const src = S.objects.find(q => q.tag === o.revealWhen);\\n        if (src && src.done) { o.hidden = false; o.marked = true; }\\n      }\\n      if (o.type === 'bleeder' && !o.done) {\\n1340→        let pool = S.objects.find(p => p.type === 'pool' && p.tag === 'fed-' + o.id);\\n        if (!pool) pool = addObj(S, { type: 'pool', x: o.x, y: o.y + 8, vol: 4, max: 40, order: o.order + 1, tag: 'fed-' + o.id, drain: 0 });\\n        if (!pool.done) pool.vol = Math.min(pool.max, pool.vol + 6 * worldDt * tune.fluids.bleed);\\n      }\\n      if (o.type === 'arteryTear' && !o.done) {\\n        let pool = S.objects.find(p => p.type === 'pool' && p.tag === 'fed-' + o.id);\\n        if (!pool) pool = addObj(S, { type: 'pool', x: o.x, y: o.y + 6, vol: 6, max: 50, order: o.order + 1, tag: 'fed-' + o.id, drain: 0 });\\n        if (!pool.done) pool.vol = Math.min(pool.max, pool.vol + 14 * worldDt * tune.fluids.bleed);\\n      }\\n    }\\n1350→    /* solo retractor: Quill holds at half the window */\\n    const retract = S.objects.find(o => o.type === 'retractor' && !o.done);\\n    if (retract) {\\n      const holder = S.players.some(p => p.held === retract.id && p.trig > 0.3);\\n      if (holder) S.windowOpen = 1;\\n      else if (S.players.filter(p => !p.gone).length <= 1) S.windowOpen = 0.5;\\n      else S.windowOpen = 0;\\n    }\\n    if (S.lab) {\\n      for (const o of S.objects) if (o.done && o.lab) {\\n1360→        o.labT = (o.labT || 0) + worldDt;\\n        if (o.labT > 1.2) {\\n          o.done = false; o.alive = true; o.prog = 0; o.cut = false; o.burn = 0; o.dosed = false; o.stitch = 0; o.free = false; o.tears = 0; o.spin = 0;\\n          o.x = o.origin[0]; o.y = o.origin[1]; o.labT = 0;\\n          if (o.cells) for (const c of o.cells) c[2] = 0;\\n        }\\n      } else o.labT = 0;\\n    }\\n    for (let i = 0; i < S.scripts.length; i++) {\\n      const sc = S.scripts[i];\\n1370→      if (sc.done) continue;\\n      if (S.phaseT >= sc.t) { sc.done = true; runScript(S, sc.do, tune); }\\n    }\\n  }\\n\\n  function loadPhase(S, def, index) {\\n    const ph = def.phases[index];\\n    S.phase = index;\\n    S.phaseCount = def.phases.length;\\n    S.phaseName = ph.name;\\n1380→    S.phaseT = 0;\\n    S.objects = S.objects.filter(o => o.persist);\\n    S.strain = null;\\n    S.scripts = (ph.at || []).map(a => ({ t: a.t, do: a.do, done: false }));\\n    S.tutorial = !!ph.tutorial;\\n    S.tutDone = !ph.tutorial;\\n    S.flags = Object.assign({}, S.flags, ph.flags || {});\\n    if (ph.dim != null) S.dim = ph.dim;\\n    if (ph.tilt) S.tiltAmp = ph.tilt;\\n    for (const spec of ph.objects || []) addObj(S, clone(spec));\\n1390→    if (ph.strain) spawnStrain(S, ph.strain, ph.strainOpts || {});\\n    if (ph.device) S.device = clone(ph.device);\\n    if (ph.onEnter) runScript(S, ph.onEnter, tuneOf(null));\\n    S.checkpoint = takeCore(S);\\n    /* drop the checkpoint's nested copy weight: checkpoint is the core itself */\\n    pushEv(S, ['phase', index, ph.name]);\\n  }\\n\\n  function advancePhase(S) {\\n    if (S.hold) return;\\n1400→    const def = (GAME.CASES || {})[S.id];\\n    if (!def) { finishCase(S); return; }\\n    if (S.phase + 1 >= def.phases.length) {\\n      if (!S.dressing && !S.won) {\\n        S.dressing = { t: 0, done: false };\\n        pushEv(S, ['dressing', 1]);\\n        return;\\n      }\\n      return;\\n    }\\n1410→    loadPhase(S, def, S.phase + 1);\\n  }\\n\\n  function create(def, opts) {\\n    opts = opts || {};\\n    const diff = opts.difficulty || opts.diff || 'resident';\\n    const doc = def.doctor || 'vale';\\n    const S = blank({\\n      id: def.id, seed: opts.seed || def.seed || 1, players: opts.players || 1,\\n      difficulty: diff, clock: def.clock, vitals: def.vitals, drain: def.drain,\\n1420→      gift: doc === 'sokolova' ? 'look' : doc === 'both' ? 'both' : 'breath',\\n      doctor: doc === 'both' ? 'vale' : doc, site: def.site, par: def.par || 1000,\\n      mode: def.mode || 'case', consult: !!def.consult || doc === 'both',\\n    });\\n    if (doc === 'both') S.activeDoc = 'vale';\\n    S.clock0 = S.clock;\\n    if (def.doctor === 'both') S.consult = true;\\n    loadPhase(S, def, opts.phase || 0);\\n    if (def.lab) { S.hold = true; S.lab = true; S.cheat = { lockVitals: true, freezeClock: true }; }\\n    return S;\\n1430→  }\\n\\n  function createRaw(opts) {\\n    const S = blank(opts);\\n    for (const spec of opts.objects || []) addObj(S, clone(spec));\\n    if (opts.strain) spawnStrain(S, opts.strain, opts.strainOpts || {});\\n    if (opts.scripts) S.scripts = opts.scripts.map(a => ({ t: a.t, do: a.do, done: false }));\\n    S.hold = opts.hold !== false;\\n    S.checkpoint = takeCore(S);\\n    return S;\\n1440→  }\\n\\n  function readInputs(S, inputs, dt) {\\n    inputs = inputs || [];\\n    for (let i = 0; i < S.players.length; i++) {\\n      const p = S.players[i];\\n      const inp = inputs[i] || {};\\n      const ox = p.lx != null ? p.lx : p.x, oy = p.ly != null ? p.ly : p.y;\\n      if (inp.x != null) { p.x = inp.x; p.y = inp.y; p.bx = inp.x; p.by = inp.y; }\\n      if (inp.tool) p.tool = inp.tool;\\n1450→      p.inst = hypot(p.x - ox, p.y - oy) / Math.max(dt, 1e-4);\\n      p.lx = p.x; p.ly = p.y;\\n      p.fine = !!inp.fine;\\n      p.mouse = !!inp.mouse;\\n      const trig = inp.trig || 0;\\n      p.trigEdge = trig > 0.3 && p.prevTrig <= 0.3;\\n      p.trigRelease = trig <= 0.3 && p.prevTrig > 0.3;\\n      p.prevTrig = trig;\\n      p.trig = trig;\\n      const gift = !!inp.gift;\\n1460→      p.giftEdge = gift && !p.giftPrev;\\n      p.giftPrev = gift;\\n      const consult = !!inp.consult;\\n      p.consultEdge = consult && !p.consultPrev;\\n      p.consultPrev = consult;\\n      p.cancelEdge = !!inp.cancel;\\n      if (p.cancelEdge) { p.held = 0; p.stroke = null; }\\n    }\\n  }\\n\\n1470→  function tryGifts(S, tune) {\\n    for (const p of S.players) {\\n      if (!p.giftEdge) continue;\\n      if (S.breath) { S.breath = false; S.worldScale = 1; pushEv(S, ['breath', 0]); continue; }\\n      const doc = S.activeDoc;\\n      const wantLook = doc === 'sokolova' || (S.gift === 'look' && doc !== 'vale');\\n      const wantBreath = doc === 'vale' || S.gift === 'breath' || (S.gift === 'both' && doc === 'vale');\\n      if (S.gift === 'both') {\\n        if (doc === 'sokolova') { if (secondLook(S, tune)) return; }\\n        else if (S.steady >= 35) { S.breath = true; pushEv(S, ['breath', 1]); return; }\\n1480→      } else if (S.gift === 'look' || wantLook && S.gift !== 'breath') {\\n        secondLook(S, tune);\\n      } else if (wantBreath && S.steady >= 35) {\\n        S.breath = true;\\n        pushEv(S, ['breath', 1]);\\n      }\\n    }\\n    for (const p of S.players) {\\n      if (!p.consultEdge || !S.consult) continue;\\n      S.activeDoc = S.activeDoc === 'vale' ? 'sokolova' : 'vale';\\n1490→      pushEv(S, ['consult', S.activeDoc]);\\n    }\\n  }\\n\\n  function stepCodeBlue(S, dt) {\\n    const cb = S.codeBlue;\\n    if (!cb) return;\\n    cb.t += dt;\\n    const peaks = [0.9, 1.8, 2.7, 3.6];\\n    const p = S.players[0];\\n1500→    if (cb.next == null) cb.next = 0;\\n    if (cb.next < 4) {\\n      const peak = peaks[cb.next];\\n      if (p && p.trigEdge) {\\n        const err = Math.abs(cb.t - peak);\\n        cb.attempts += 1;\\n        if (err <= 0.14) {\\n          cb.hits += 1;\\n          if (err <= 0.06) cb.textbook = (cb.textbook || 0) + 1;\\n          pushEv(S, ['shock', cb.hits, err]);\\n1510→        } else pushEv(S, ['miss', err]);\\n        cb.next += 1;\\n      } else if (cb.t > peak + 0.14) {\\n        cb.attempts += 1;\\n        cb.next += 1;\\n        pushEv(S, ['miss', 1]);\\n      }\\n    }\\n    if (cb.next >= 4 && !cb.resolved) {\\n      cb.resolved = true;\\n1520→      S.codeBlue = null;\\n      if (cb.hits >= 2) {\\n        S.vitals = 30;\\n        S.flags.crash = 0;\\n        pushEv(S, ['revived', cb.textbook >= 2 ? 'textbook' : 'clean']);\\n      } else lose(S, 'code');\\n    }\\n  }\\n\\n  function maybeDie(S) {\\n1530→    if (S.won || S.lost || S.codeBlue || S.dressing) return;\\n    if (S.clock <= 0) { lose(S, 'time'); return; }\\n    if (S.vitals <= 0) {\\n      if (S.diff === 'attending' || S.codeBlueUsed) { lose(S, 'vitals'); return; }\\n      S.codeBlueUsed = true;\\n      S.codeBlue = { t: 0, hits: 0, attempts: 0, next: 0, textbook: 0, resolved: false };\\n      S.vitals = 0;\\n      S.breath = false;\\n      pushEv(S, ['codeblue', 1]);\\n    }\\n1540→  }\\n\\n  function stepDressing(S, dt, tune) {\\n    const d = S.dressing;\\n    d.t += dt;\\n    const u = (d.t % 1.2) / 1.2;\\n    const edge = Math.min(u, 1 - u);\\n    const p = S.players[0];\\n    if (p && p.trigEdge) {\\n      const bonus = edge < 0.08 ? 80 : 20;\\n1550→      S.score += bonus;\\n      d.done = true;\\n      pushEv(S, ['stamp', bonus]);\\n      finishCase(S);\\n    } else if (d.t > 4) {\\n      d.done = true;\\n      finishCase(S);\\n    }\\n  }\\n\\n1560→  function step(S, inputs, dt, tune) {\\n    tune = tuneOf(tune);\\n    if (!dt || dt < 0) dt = 0;\\n    S.ev = [];\\n    if (S.won || S.lost) return S;\\n    readInputs(S, inputs, dt);\\n    if (S.codeBlue) { stepCodeBlue(S, dt); return S; }\\n    tryGifts(S, tune);\\n    if (S.breath) {\\n      S.steady = Math.max(0, S.steady - tune.gift.breathDrain * dt);\\n1570→      if (S.steady <= 0) { S.breath = false; pushEv(S, ['breath', 0]); }\\n    }\\n    S.worldScale = S.breath ? tune.gift.breathFactor : 1;\\n    const worldDt = dt * S.worldScale;\\n    if (S.dressing) { stepDressing(S, dt, tune); return S; }\\n\\n    const frozen = S.tutorial && !S.tutDone;\\n    const ch = S.cheat || {};\\n    if (ch.reveal) {\\n      for (const o of S.objects) if (o.hidden) { o.marked = true; o.markT = 4; }\\n1580→    }\\n    if (ch.infSteady) S.steady = 100;\\n    if (!frozen) {\\n      let hazard = 0;\\n      for (const o of S.objects) {\\n        if (o.done || !o.drain) continue;\\n        if (inDome(S, o.x, o.y)) continue;\\n        hazard += o.drain;\\n      }\\n      const bleed = hazard * tune.fluids.bleed * tune.strains.damage;\",\"content_concise\":\"1310→      pushEv(S, ['lurch', 1]);\\n    } else if (id === 'blackout') { S.dim = 1; }\\n    else if (id === 'roll') { S.tiltAmp = 1; }\\n    else if (id === 'quiet') { S.flags.quiet = true; S.flags.needBreath = true; }\\n    else if (id === 'refill') { S.clock += 120; }\\n    else if (id === 'cantorRewind') { forceRewind(S, true); }\\n    else if (id === 'code') { S.vitals = 0; }\\n  }\\n\\n  function stepWorld(S, worldDt, handDt, tune) {\\n1320→    if (S.flags.dip) {\\n      S.vitals += (S.flags.dip - S.vitals) * Math.min(1, worldDt * 2);\\n      if (Math.abs(S.vitals - S.flags.dip) < 0.4) { S.vitals = S.flags.dip; S.flags.dip = 0; }\\n    }\\n    if (S.flags.crash) {\\n      S.vitals -= S.flags.crash * worldDt;\\n    }\\n    if (S.tiltAmp) {\\n      const drift = Math.sin(S.worldT * 0.7) * 25 * S.tiltAmp;\\n      for (const o of S.objects) if (o.type === 'pool' && !o.done) {\\n1330→        o.x = clamp(o.x + drift * worldDt, 60, 360);\\n      }\\n    }\\n    for (const o of S.objects) {\\n      if (o.markT > 0) { o.markT -= handDt; if (o.markT <= 0 && o.hidden) o.marked = false; }\\n      if (o.revealWhen && o.hidden) {\\n        const src = S.objects.find(q => q.tag === o.revealWhen);\\n        if (src && src.done) { o.hidden = false; o.marked = true; }\\n      }\\n      if (o.type === 'bleeder' && !o.done) {\\n1340→        let pool = S.objects.find(p => p.type === 'pool' && p.tag === 'fed-' + o.id);\\n        if (!pool) pool = addObj(S, { type: 'pool', x: o.x, y: o.y + 8, vol: 4, max: 40, order: o.order + 1, tag: 'fed-' + o.id, drain: 0 });\\n        if (!pool.done) pool.vol = Math.min(pool.max, pool.vol + 6 * worldDt * tune.fluids.bleed);\\n      }\\n      if (o.type === 'arteryTear' && !o.done) {\\n        let pool = S.objects.find(p => p.type === 'pool' && p.tag === 'fed-' + o.id);\\n        if (!pool) pool = addObj(S, { type: 'pool', x: o.x, y: o.y + 6, vol: 6, max: 50, order: o.order + 1, tag: 'fed-' + o.id, drain: 0 });\\n        if (!pool.done) pool.vol = Math.min(pool.max, pool.vol + 14 * worldDt * tune.fluids.bleed);\\n      }\\n    }\\n1350→    /* solo retractor: Quill holds at half the window */\\n    const retract = S.objects.find(o => o.type === 'retractor' && !o.done);\\n    if (retract) {\\n      const holder = S.players.some(p => p.held === retract.id && p.trig > 0.3);\\n      if (holder) S.windowOpen = 1;\\n      else if (S.players.filter(p => !p.gone).length <= 1) S.windowOpen = 0.5;\\n      else S.windowOpen = 0;\\n    }\\n    if (S.lab) {\\n      for (const o of S.objects) if (o.done && o.lab) {\\n1360→        o.labT = (o.labT || 0) + worldDt;\\n        if (o.labT > 1.2) {\\n          o.done = false; o.alive = true; o.prog = 0; o.cut = false; o.burn = 0; o.dosed = false; o.stitch = 0; o.free = false; o.tears = 0; o.spin = 0;\\n          o.x = o.origin[0]; o.y = o.origin[1]; o.labT = 0;\\n          if (o.cells) for (const c of o.cells) c[2] = 0;\\n        }\\n      } else o.labT = 0;\\n    }\\n    for (let i = 0; i < S.scripts.length; i++) {\\n      const sc = S.scripts[i];\\n1370→      if (sc.done) continue;\\n      if (S.phaseT >= sc.t) { sc.done = true; runScript(S, sc.do, tune); }\\n    }\\n  }\\n\\n  function loadPhase(S, def, index) {\\n    const ph = def.phases[index];\\n    S.phase = index;\\n    S.phaseCount = def.phases.length;\\n    S.phaseName = ph.name;\\n1380→    S.phaseT = 0;\\n    S.objects = S.objects.filter(o => o.persist);\\n    S.strain = null;\\n    S.scripts = (ph.at || []).map(a => ({ t: a.t, do: a.do, done: false }));\\n    S.tutorial = !!ph.tutorial;\\n    S.tutDone = !ph.tutorial;\\n    S.flags = Object.assign({}, S.flags, ph.flags || {});\\n    if (ph.dim != null) S.dim = ph.dim;\\n    if (ph.tilt) S.tiltAmp = ph.tilt;\\n    for (const spec of ph.objects || []) addObj(S, clone(spec));\\n1390→    if (ph.strain) spawnStrain(S, ph.strain, ph.strainOpts || {});\\n    if (ph.device) S.device = clone(ph.device);\\n    if (ph.onEnter) runScript(S, ph.onEnter, tuneOf(null));\\n    S.checkpoint = takeCore(S);\\n    /* drop the checkpoint's nested copy weight: checkpoint is the core itself */\\n    pushEv(S, ['phase', index, ph.name]);\\n  }\\n\\n  function advancePhase(S) {\\n    if (S.hold) return;\\n1400→    const def = (GAME.CASES || {})[S.id];\\n    if (!def) { finishCase(S); return; }\\n    if (S.phase + 1 >= def.phases.length) {\\n      if (!S.dressing && !S.won) {\\n        S.dressing = { t: 0, done: false };\\n        pushEv(S, ['dressing', 1]);\\n        return;\\n      }\\n      return;\\n    }\\n1410→    loadPhase(S, def, S.phase + 1);\\n  }\\n\\n  function create(def, opts) {\\n    opts = opts || {};\\n    const diff = opts.difficulty || opts.diff || 'resident';\\n    const doc = def.doctor || 'vale';\\n    const S = blank({\\n      id: def.id, seed: opts.seed || def.seed || 1, players: opts.players || 1,\\n      difficulty: diff, clock: def.clock, vitals: def.vitals, drain: def.drain,\\n1420→      gift: doc === 'sokolova' ? 'look' : doc === 'both' ? 'both' : 'breath',\\n      doctor: doc === 'both' ? 'vale' : doc, site: def.site, par: def.par || 1000,\\n      mode: def.mode || 'case', consult: !!def.consult || doc === 'both',\\n    });\\n    if (doc === 'both') S.activeDoc = 'vale';\\n    S.clock0 = S.clock;\\n    if (def.doctor === 'both') S.consult = true;\\n    loadPhase(S, def, opts.phase || 0);\\n    if (def.lab) { S.hold = true; S.lab = true; S.cheat = { lockVitals: true, freezeClock: true }; }\\n    return S;\\n1430→  }\\n\\n  function createRaw(opts) {\\n    const S = blank(opts);\\n    for (const spec of opts.objects || []) addObj(S, clone(spec));\\n    if (opts.strain) spawnStrain(S, opts.strain, opts.strainOpts || {});\\n    if (opts.scripts) S.scripts = opts.scripts.map(a => ({ t: a.t, do: a.do, done: false }));\\n    S.hold = opts.hold !== false;\\n    S.checkpoint = takeCore(S);\\n    return S;\\n1440→  }\\n\\n  function readInputs(S, inputs, dt) {\\n    inputs = inputs || [];\\n    for (let i = 0; i < S.players.length; i++) {\\n      const p = S.players[i];\\n      const inp = inputs[i] || {};\\n      const ox = p.lx != null ? p.lx : p.x, oy = p.ly != null ? p.ly : p.y;\\n      if (inp.x != null) { p.x = inp.x; p.y = inp.y; p.bx = inp.x; p.by = inp.y; }\\n      if (inp.tool) p.tool = inp.tool;\\n1450→      p.inst = hypot(p.x - ox, p.y - oy) / Math.max(dt, 1e-4);\\n      p.lx = p.x; p.ly = p.y;\\n      p.fine = !!inp.fine;\\n      p.mouse = !!inp.mouse;\\n      const trig = inp.trig || 0;\\n      p.trigEdge = trig > 0.3 && p.prevTrig <= 0.3;\\n      p.trigRelease = trig <= 0.3 && p.prevTrig > 0.3;\\n      p.prevTrig = trig;\\n      p.trig = trig;\\n      const gift = !!inp.gift;\\n1460→      p.giftEdge = gift && !p.giftPrev;\\n      p.giftPrev = gift;\\n      const consult = !!inp.consult;\\n      p.consultEdge = consult && !p.consultPrev;\\n      p.consultPrev = consult;\\n      p.cancelEdge = !!inp.cancel;\\n      if (p.cancelEdge) { p.held = 0; p.stroke = null; }\\n    }\\n  }\\n\\n1470→  function tryGifts(S, tune) {\\n    for (const p of S.players) {\\n      if (!p.giftEdge) continue;\\n      if (S.breath) { S.breath = false; S.worldScale = 1; pushEv(S, ['breath', 0]); continue; }\\n      const doc = S.activeDoc;\\n      const wantLook = doc === 'sokolova' || (S.gift === 'look' && doc !== 'vale');\\n      const wantBreath = doc === 'vale' || S.gift === 'breath' || (S.gift === 'both' && doc === 'vale');\\n      if (S.gift === 'both') {\\n        if (doc === 'sokolova') { if (secondLook(S, tune)) return; }\\n        else if (S.steady >= 35) { S.breath = true; pushEv(S, ['breath', 1]); return; }\\n1480→      } else if (S.gift === 'look' || wantLook && S.gift !== 'breath') {\\n        secondLook(S, tune);\\n      } else if (wantBreath && S.steady >= 35) {\\n        S.breath = true;\\n        pushEv(S, ['breath', 1]);\\n      }\\n    }\\n    for (const p of S.players) {\\n      if (!p.consultEdge || !S.consult) continue;\\n      S.activeDoc = S.activeDoc === 'vale' ? 'sokolova' : 'vale';\\n1490→      pushEv(S, ['consult', S.activeDoc]);\\n    }\\n  }\\n\\n  function stepCodeBlue(S, dt) {\\n    const cb = S.codeBlue;\\n    if (!cb) return;\\n    cb.t += dt;\\n    const peaks = [0.9, 1.8, 2.7, 3.6];\\n    const p = S.players[0];\\n1500→    if (cb.next == null) cb.next = 0;\\n    if (cb.next < 4) {\\n      const peak = peaks[cb.next];\\n      if (p && p.trigEdge) {\\n        const err = Math.abs(cb.t - peak);\\n        cb.attempts += 1;\\n        if (err <= 0.14) {\\n          cb.hits += 1;\\n          if (err <= 0.06) cb.textbook = (cb.textbook || 0) + 1;\\n          pushEv(S, ['shock', cb.hits, err]);\\n1510→        } else pushEv(S, ['miss', err]);\\n        cb.next += 1;\\n      } else if (cb.t > peak + 0.14) {\\n        cb.attempts += 1;\\n        cb.next += 1;\\n        pushEv(S, ['miss', 1]);\\n      }\\n    }\\n    if (cb.next >= 4 && !cb.resolved) {\\n      cb.resolved = true;\\n1520→      S.codeBlue = null;\\n      if (cb.hits >= 2) {\\n        S.vitals = 30;\\n        S.flags.crash = 0;\\n        pushEv(S, ['revived', cb.textbook >= 2 ? 'textbook' : 'clean']);\\n      } else lose(S, 'code');\\n    }\\n  }\\n\\n  function maybeDie(S) {\\n1530→    if (S.won || S.lost || S.codeBlue || S.dressing) return;\\n    if (S.clock <= 0) { lose(S, 'time'); return; }\\n    if (S.vitals <= 0) {\\n      if (S.diff === 'attending' || S.codeBlueUsed) { lose(S, 'vitals'); return; }\\n      S.codeBlueUsed = true;\\n      S.codeBlue = { t: 0, hits: 0, attempts: 0, next: 0, textbook: 0, resolved: false };\\n      S.vitals = 0;\\n      S.breath = false;\\n      pushEv(S, ['codeblue', 1]);\\n    }\\n1540→  }\\n\\n  function stepDressing(S, dt, tune) {\\n    const d = S.dressing;\\n    d.t += dt;\\n    const u = (d.t % 1.2) / 1.2;\\n    const edge = Math.min(u, 1 - u);\\n    const p = S.players[0];\\n    if (p && p.trigEdge) {\\n      const bonus = edge < 0.08 ? 80 : 20;\\n1550→      S.score += bonus;\\n      d.done = true;\\n      pushEv(S, ['stamp', bonus]);\\n      finishCase(S);\\n    } else if (d.t > 4) {\\n      d.done = true;\\n      finishCase(S);\\n    }\\n  }\\n\\n1560→  function step(S, inputs, dt, tune) {\\n    tune = tuneOf(