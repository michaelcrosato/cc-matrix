,32,116,104,101,32,118,111,105,99,101,32,98,117,115,32,40,98,117,115,40,39,118,111,105,99,101,39,41,41,10,49,54,54,53,58,45,32,96,69,46,83,111,110,103,98,111,111,107,46,103,101,116,40,105,100,41,96,58,32,97,32,115,111,110,103,32,98,121,32,105,100,32,40,112,108,97,121,97,98,108,101,58,32,103,97,109,101,46,97,117,100,105,111,46,109,117,115,105,99,40,69,46,83,111,110,103,98,111,111,107,46,103,101,116,40,39,116,111,119,110,39,41,41,41,44,32,111,114,32,117,110,100,101,102,105,110,101,100,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":11,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/my-3d2dge/dist/handoff/API-INDEX.md\",\"matches\":[{\"line_number\":523,\"content\":\"- `game.audio`: chip-sound synthesizer: game.audio.sfx('jump'), game.audio.music(song)\"},{\"line_number\":1067,\"content\":\"- `E.songs: title, adventure, dungeon, boss, victory`: ready-made chiptune loops (original compositions). game.audio.music('adventure')\"},{\"line_number\":1070,\"content\":\"- `game.audio.bus(name = 'sfx')`: a bus for a sound of the game's own (Web Audio nodes it makes on audio.ctx: a babble voice, a loop, an instrument) to connect to, so it follows the volume, the mute and the player's settings: 'sfx', 'music', 'voice' (its level is voiceVolume) or 'master'. Returns a GainNode, or null where there is no sound (headless, no Web Audio)\"},{\"line_number\":1072,\"content\":\"- `game.audio.define(name, voice)`: add or replace a named sound: audio.define('zap', { wave: 'saw', freq: 1200, to: 200, dur: .2 })\"},{\"line_number\":1074,\"content\":\"- `game.audio.instrument(name, fn)` †: an instrument of the game's own: fn(ctx, bus, time, freq, dur, vol) makes a note's sound (Web Audio, into bus, from time); its name is a wave a music track (wave: 'pluck') or a voice takes\"},{\"line_number\":1075,\"content\":\"- `game.audio.layer(track, vol = 1, fade = .5)` †: a track's volume as the song plays, 0..1, faded over fade seconds: layers of one song (the chase's drums in when the guards see you, out when they lose you). track: its index in song.tracks, or its name\"},{\"line_number\":1076,\"content\":\"- `game.audio.music(song, o = {})`: Loop a song (or play once with { loop: false }). song = { bpm: 120, steps: 4, tracks: [ { wave: 'square', vol: .2, notes: 'C5 - E5 - G5 - . . | ...' }, one token per step { wave: 'triangle', notes: 'C3 . C3 . G2 . G2 .' }, { wave: 'drums', notes: 'k . h . s . h . k k h . s . h .' } ] } tokens: C4 F#3 Bb2 = note, '-' holds the previous note, '.' = rest, '|' is ignored (bar lines). steps = steps per beat (4 = sixteenth notes). Each track loops on its own length within the song's (len: steps, else its longest track's); a track may have a name, and on: false starts it silent (a layer that audio.layer brings in). THE MUSIC CLOCK: a song starts at the game's time and where it is is game time (audio.pos, headless too: the same steps hear the same beats); the sound follows that clock. o: { loop, sync: true (it pauses with the game, on game.time; else it plays on through a pause, on game.real), fade: seconds (a crossfade from the song playing), restart: true  [... truncated (1031 chars total)]\"},{\"line_number\":1082,\"content\":\"- `game.audio.sfx(what, o = {})`: Play a sound effect: a preset name ('jump', 'coin', 'hit', 'explode', ...), a voice object, or a list of voices. opts: { vol: 0..1, pitch: multiplier, vary: random pitch spread (default 0.03), step: a step of the music playing (it sounds on that step of the music clock, scheduled with the music: a rhythm game's calls and claps), pan: -1 (left) .. 1 (right), loop: true (it sounds on until stopped: an engine, rain; through the effects' bus, so it follows the volume and the mute) }. Returns its handle: { stop(fade .03), set({ pan, vol }), playing, pan }: a handle that does nothing when nothing plays (headless, before the first key, an unknown name)\"},{\"line_number\":1083,\"content\":\"- `game.audio.sting(song, o = {})` †: play a short song once over the music (a goal's jingle): o.at 'now', 'beat' or 'bar' (on the music's next beat or bar), o.duck (the music's volume under it, .4)\"},{\"line_number\":1091,\"content\":\"- `game.audio.musicVolume = .5`, `game.audio.sfxVolume = 1`, `game.audio.voiceVolume = 1`: 0..1 for effects, music and the voice bus (bus('voice'))\"},{\"line_number\":1665,\"content\":\"- `E.Songbook.get(id)`: a song by id (playable: game.audio.music(E.Songbook.get('town'))), or undefined\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"417b582c-6fe4-4377-9946-866f8a3db3fa"}
