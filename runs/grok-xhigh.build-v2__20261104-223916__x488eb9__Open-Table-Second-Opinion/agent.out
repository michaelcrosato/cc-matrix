LD_H), '#102830');\\n      px.rect(g, 0, oy, Math.max(0, ox), CFG.FIELD_H, '#102830');\\n      px.rect(g, ox + CFG.FIELD_W, oy, Math.max(0, r.W - ox - CFG.FIELD_W), CFG.FIELD_H, '#102830');\\n      px.rect(g, ox + 8, oy + 8, CFG.FIELD_W - 16, CFG.FIELD_H - 16, '#0c2428');\\n      if (!S) return;\\n      const ink = bloodCol();\\n      for (const o of S.objects) {\\n        if (!o.alive && o.type !== 'retractor') continue;\\n        if (o.hidden && !o.marked) continue;\\n        const x = o.x + ox, y = o.y + oy;\\n        let c = COL[o.type] || '#9ad0c8';\\n        if (ink && (o.type === 'bleeder' || o.type === 'pool' || o.type === 'wound' || o.type === 'laceration' || o.type === 'arteryTear')) c = ink;\\n        const rad = o.type === 'pool' ? 8 + (o.vol || 0) * 0.15 : o.type === 'mass' ? (o.rad || 12) : o.type === 'bead' ? 3 : 4;\\n        if (o.guide && o.guide.length > 1 && (o.type === 'cut' || o.type === 'mass' || o.type === 'slur')) {\\n          for (let k = 1; k < o.guide.length; k++) px.line(g, o.guide[k - 1][0] + ox, o.guide[k - 1][1] + oy, o.guide[k][0] + ox, o.guide[k][1] + oy, '#f2f0e6', 1);\\n        }\\n        px.disc(g, x, y, rad, o.done ? '#2a403c' : c);\\n        if (o.marked) px.disc(g, x, y, rad + 3, '#5ff0e0');\\n      }\\n      if (S.breath) {\\n        px.rect(g, ox + 20, oy + 16, CFG.FIELD_W - 40, 2, '#bfefff');\\n        px.rect(g, ox + 20, oy + CFG.FIELD_H - 18, CFG.FIELD_W - 40, 2, '#bfefff');\\n      }\\n      if (RT.wheelShow > 0 && S.players[0] && !S.players[0].gone) {\\n        const c = S.players[0];\\n        for (const w of CFG.WHEEL) {\\n          const x = c.x + ox + w.x * 22, y = c.y + oy + w.y * 22;\\n          const on = c.tool === w.tool;\\n          px.disc(g, x, y, on ? 8 : 5, on ? '#5ff0e0' : '#14343c');\\n          GAME.Art.toolIcon(g, w.tool, x - 4, y - 4, 1);\\n        }\\n      }\\n      for (const p of S.players) if (!p.gone) GAME.Art.drawHand(g, p, ox, oy);\\n      const vit = Math.max(0, Math.ceil(S.vitals));\\n      const clk = Math.max(0, Math.ceil(S.clock));\\n      E.font.text(g, 'VIT ' + vit, 8, 6, vit < 30 ? '#ff7a6a' : '#e8fbf6', { scale: 2, outline: '#06141a' });\\n      E.font.text(g, 'CLK ' + clk, 8, 26, clk < 20 ? '#ff7a6a' : '#e8fbf6', { scale: 2, outline: '#06141a' });\\n      E.font.text(g, (S.phaseName || '') + '  ' + (S.activeDoc || ''), 8, 48, '#8fb8b0', { outline: '#06141a' });\\n      const tool = (S.players[0] && S.players[0].tool) || 'forceps';\\n      GAME.Art.toolIcon(g, tool, r.W - 28, r.H - 28, 1);\\n      E.font.text(g, tool.toUpperCase(), r.W - 8, r.H - 36, '#e8fbf6', { align: 'right', outline: '#06141a' });\\n      if (PREFS.hints) E.font.text(g, game.input.label('useTool'), r.W - 8, r.H - 14, '#5ff0e0', { align: 'right', outline: false });\\n      const steady = Math.round(S.steady || 0);\\n      E.font.text(g, 'STEADY ' + steady, 8, r.H - 16, '#5ff0e0', { outline: '#06141a' });\\n      if (S.codeBlue) E.font.text(g, 'SHOCK', r.W / 2, 64, '#ff7a6a', { align: 'center', scale: 2, outline: '#06141a' });\\n      if (S.dressing) E.font.text(g, 'DRESSING', r.W / 2, 64, '#f2f0e6', { align: 'center', scale: 2, outline: '#06141a' });\\n      if (ribbon) E.font.text(g, 'DEMO', r.W - 8, 6, '#f5b700', { align: 'right', scale: 2, outline: '#06141a' });\\n      if (GAME.TUNE.dirty || RT.cheatUsed) E.font.text(g, 'DEV', 8, 66, '#f5b700', { outline: '#06141a' });\\n      if (S.t != null && GAME.BARKS && GAME.BARKS.length) {\\n        const bark = GAME.BARKS[Math.floor(S.t / 4) % GAME.BARKS.length];\\n        E.font.text(g, bark, r.W / 2, r.H - 28, '#d8e4dc', { align: 'center', outline: '#06141a' });\\n      }\\n      if (RT.devOpen) drawDev(g, r);\\n    });\\n  }\\n\\n  const CHEATS = [\\n    ['reveal', 'Reveal'],\\n    ['infSteady', 'Infinite Steady'],\\n    ['lockVitals', 'Lock vitals'],\\n    ['freezeClock', 'Freeze clock'],\\n    ['oneHit', 'One hit'],\\n    ['auto', 'Autosurgeon'],\\n    ['slow', 'Slow motion'],\\n    ['win', 'Clear phase'],\\n    ['lose', 'Force a loss'],\\n    ['code', 'Vitals to zero'],\\n  ];\\n  const SLOW = [0.25, 0.5, 1, 2];\\n\\n  function devRows() {\\n\",\"total_lines\":1410}}","is_error":false},{"type":"tool_result","tool_use_id":"call-36721c1d-74fb-4713-9b13-a6afcb093a41-8","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"620→    if (p.trigEdge) {\\n      /* Press within 9 u of the next near point. Stitches sit off the wound center. */\\n      const reach = 9 + extra + (p.mouse ? 1 : 0);\\n      let o = null, bd = reach;\\n      for (let i = 0; i < S.objects.length; i++) {\\n        const q = S.objects[i];\\n        if (!canTouch(S, q) || !q.pairs || (q.stitch || 0) >= q.pairs.length) continue;\\n        const a = q.pairs[q.stitch][0];\\n        const d = hypot(p.x - a[0], p.y - a[1]);\\n        if (d <= bd) { bd = d; o = q; }\\n630→      }\\n      if (o) {\\n        p.stroke = { kind: 'suture', id: o.id, i: o.stitch, t: 0 };\\n        pushEv(S, ['needle', o.id, o.stitch]);\\n      }\\n    }\\n    if (p.stroke && p.stroke.kind === 'suture' && down) p.stroke.t += dt;\\n    if (p.stroke && p.stroke.kind === 'suture' && p.trigRelease) {\\n      const o = objById(S, p.stroke.id);\\n      const st = p.stroke;\\n640→      p.stroke = null;\\n      if (!o || o.done) return;\\n      const b = o.pairs[st.i][1];\\n      const tol = 6 + extra + (p.mouse ? 1 : 0);\\n      if (hypot(p.x - b[0], p.y - b[1]) <= tol) {\\n        const g = gradeMean(st.t, 0.6, 1.2);\\n        o.grades = o.grades || [];\\n        o.grades.push(g === 'textbook' ? 2 : g === 'clean' ? 1 : 0);\\n        o.times = o.times || [];\\n        o.times.push(st.t);\\n650→        o.stitch = st.i + 1;\\n        o.prog = o.stitch / o.pairs.length;\\n        p.stitches += 1;\\n        const bleedLeft = 1 - o.prog;\\n        if (o.type === 'arteryTear') o.drain = 1 * bleedLeft;\\n        else if (o.type === 'wound') o.drain = 0.4 * bleedLeft;\\n        pushEv(S, ['stitch', Math.round(b[0]), Math.round(b[1]), g]);\\n        if (o.stitch >= o.pairs.length) {\\n          const meanT = o.times.reduce((a, c) => a + c, 0) / o.times.length;\\n          const fg = gradeMean(meanT, 0.6, 1.2);\\n660→          o.done = true; o.alive = false; o.grade = fg; o.drain = 0;\\n          award(S, p, fg, 80 + 20 * o.pairs.length, tune);\\n        }\\n      } else {\\n        slip(S, p, 'loose', 1, tune);\\n        pushEv(S, ['loose', o.id]);\\n      }\\n    }\\n  }\\n\\n670→  function stepSalve(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    let any = false;\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n      if (!canTouch(S, o) || !o.cells) continue;\\n      if (!(o.type === 'laceration' || o.type === 'patch' || o.type === 'bite' || (o.type === 'lobe' && o.mode === 'salve'))) continue;\\n      for (let c = 0; c < o.cells.length; c++) {\\n        const cell = o.cells[c];\\n        if (!cell[2] && hypot(cell[0] - p.x, cell[1] - p.y) <= 10) { cell[2] = 1; any = true; }\\n680→      }\\n      let on = 0;\\n      for (let c = 0; c < o.cells.length; c++) if (o.cells[c][2]) on++;\\n      o.prog = o.cells.length ? on / o.cells.length : 1;\\n      if (o.prog >= 0.9 && !o.done) {\\n        o.done = true; o.alive = false; o.drain = 0;\\n        S.vitals = Math.min(99, S.vitals + 2 * tune.patient.healing);\\n        award(S, p, 'clean', 80, tune);\\n        pushEv(S, ['heal', o.id]);\\n      }\\n690→    }\\n    if (!any && p.trigEdge) { /* salve cannot harm */ }\\n  }\\n\\n  function stepSyringe(S, p, dt, tune) {\\n    if (p.cool > 0) p.cool -= dt;\\n    const down = p.trig > 0.3;\\n    if (down && p.cool <= 0) {\\n      if (p.fill < 1) p.fill = Math.min(1, p.fill + dt / 0.55);\\n      else p.over += dt;\\n700→    }\\n    if (p.trigRelease && p.fill > 0.05 && p.cool <= 0) {\\n      const bubble = p.over >= 0.3;\\n      /* A closed reed or voice is still a target: the needle finds it and the tissue splits. */\\n      const tgt = nearest(S, p, 10, o => {\\n        if (!o || o.done || !o.alive || covered(S, o)) return false;\\n        if (o.type === 'reed' || o.type === 'voice') return true;\\n        return canTouch(S, o) && (o.type === 'clot' || (o.type === 'lobe' && o.mode === 'syringe'));\\n      });\\n      if (tgt) {\\n710→        if ((tgt.type === 'reed' || tgt.type === 'voice') && !tgt.window) {\\n          addObj(S, { type: 'laceration', x: tgt.x + 6, y: tgt.y, r: 8, order: 50, drain: 0.2 });\\n          slip(S, p, 'spit', 2, tune);\\n        } else {\\n          const g = bubble ? 'sloppy' : (p.fill >= 0.9 ? 'textbook' : 'clean');\\n          tgt.dosed = true;\\n          tgt.dose = (bubble ? 0.5 : 1) * p.fill;\\n          if (tgt.follow === 'salve') {\\n            tgt.mode = 'salve';\\n            if (!tgt.cells) {\\n720→              const r = tgt.r || 8;\\n              tgt.cells = [];\\n              for (let y = -r; y <= r; y += 4) for (let x = -r; x <= r; x += 4) {\\n                if (x * x + y * y <= r * r) tgt.cells.push([tgt.x + x, tgt.y + y, 0]);\\n              }\\n            }\\n          } else if (tgt.type === 'clot') { tgt.drain = 0.1; }\\n          else { tgt.done = true; tgt.alive = false; tgt.drain = 0; }\\n          award(S, p, g, 90, tune);\\n          pushEv(S, ['inject', tgt.id, g]);\\n730→        }\\n      } else {\\n        const g = bubble ? 'sloppy' : (p.fill >= 0.9 ? 'textbook' : 'clean');\\n        const add = syringeDose(S, tune) * p.fill * (bubble ? 0.5 : 1);\\n        S.vitals = Math.min(99, S.vitals + add);\\n        award(S, p, g, 40, tune);\\n        S.flags.iv = (S.flags.iv || 0) + 1;\\n        pushEv(S, ['iv', Math.round(add), g]);\\n      }\\n      p.fill = 0; p.over = 0; p.cool = 0.35;\\n740→    }\\n    if (!down && p.trigRelease === false) { /* keep fill while aiming */ }\\n  }\\n\\n  function stepCautery(S, p, dt, tune) {\\n    if (p.lock > 0) { p.lock -= dt; p.heat = Math.max(0, p.heat - 0.6 * dt); return; }\\n    const down = p.trig > 0.3;\\n    if (!down) {\\n      p.heat = Math.max(0, p.heat - 0.6 * dt);\\n      p.bareT = 0;\\n750→      return;\\n    }\\n    p.heat += tune.fluids.cauteryHeat * dt;\\n    if (p.heat >= 1) { p.lock = 1.2; p.heat = 1; slip(S, p, 'lock', 1, tune); pushEv(S, ['lock', p.id]); return; }\\n    if (nerveHit(S, p, tune)) return;\\n    const tgt = nearest(S, p, 6, o => canTouch(S, o) && (o.type === 'polyp' || o.type === 'bleeder' || o.type === 'rupture' || o.type === 'bead' || o.type === 'uvula' || o.type === 'eye' || o.type === 'tremass' || (o.type === 'lobe' && o.mode === 'cautery') || o.type === 'barb'));\\n    if (tgt) {\\n      p.bareT = 0;\\n      tgt.burn = (tgt.burn || 0) + dt;\\n      tgt.prog = tgt.burn / (tgt.need || 0.5);\\n760→      if (tgt.burn >= (tgt.need || 0.5) / Math.max(0.25, tune.strains.health) && !tgt.done) {\\n        const dirty = tgt.charred || p.lockedDuring;\\n        const g = (!tgt.charred && p.lock <= 0 && !p.hadLock) ? 'textbook' : 'clean';\\n        tgt.done = true; tgt.alive = false; tgt.drain = 0; tgt.grade = g;\\n        p.burned += 1;\\n        award(S, p, g, 90, tune);\\n        pushEv(S, ['burn', tgt.id, g]);\\n      }\\n    } else {\\n      p.bareT = (p.bareT || 0) + dt;\\n770→      if (p.bareT >= 0.25) {\\n        /* char on the field */\\n        p.charT = (p.charT || 0) + dt;\\n        S.vitals -= 0.8 * dt * tune.patient.slip;\\n        if (p.bareT >= 0.6 && !p.charSlip) { p.charSlip = true; slip(S, p, 'char', 2, tune); pushEv(S, ['char', Math.round(p.x), Math.round(p.y)]); }\\n      }\\n    }\\n  }\\n\\n  function stepSuction(S, p, dt, tune) {\",\"content_concise\":\"620→    if (p.trigEdge) {\\n      /* Press within 9 u of the next near point. Stitches sit off the wound center. */\\n      const reach = 9 + extra + (p.mouse ? 1 : 0);\\n      let o = null, bd = reach;\\n      for (let i = 0; i < S.objects.length; i++) {\\n        const q = S.objects[i];\\n        if (!canTouch(S, q) || !q.pairs || (q.stitch || 0) >= q.pairs.length) continue;\\n        const a = q.pairs[q.stitch][0];\\n        const d = hypot(p.x - a[0], p.y - a[1]);\\n        if (d <= bd) { bd = d; o = q; }\\n630→      }\\n      if (o) {\\n        p.stroke = { kind: 'suture', id: o.id, i: o.stitch, t: 0 };\\n        pushEv(S, ['needle', o.id, o.stitch]);\\n      }\\n    }\\n    if (p.stroke && p.stroke.kind === 'suture' && down) p.stroke.t += dt;\\n    if (p.stroke && p.stroke.kind === 'suture' && p.trigRelease) {\\n      const o = objById(S, p.stroke.id);\\n      const st = p.stroke;\\n640→      p.stroke = null;\\n      if (!o || o.done) return;\\n      const b = o.pairs[st.i][1];\\n      const tol = 6 + extra + (p.mouse ? 1 : 0);\\n      if (hypot(p.x - b[0], p.y - b[1]) <= tol) {\\n        const g = gradeMean(st.t, 0.6, 1.2);\\n        o.grades = o.grades || [];\\n        o.grades.push(g === 'textbook' ? 2 : g === 'clean' ? 1 : 0);\\n        o.times = o.times || [];\\n        o.times.push(st.t);\\n650→        o.stitch = st.i + 1;\\n        o.prog = o.stitch / o.pairs.length;\\n        p.stitches += 1;\\n        const bleedLeft = 1 - o.prog;\\n        if (o.type === 'arteryTear') o.drain = 1 * bleedLeft;\\n        else if (o.type === 'wound') o.drain = 0.4 * bleedLeft;\\n        pushEv(S, ['stitch', Math.round(b[0]), Math.round(b[1]), g]);\\n        if (o.stitch >= o.pairs.length) {\\n          const meanT = o.times.reduce((a, c) => a + c, 0) / o.times.length;\\n          const fg = gradeMean(meanT, 0.6, 1.2);\\n660→          o.done = true; o.alive = false; o.grade = fg; o.drain = 0;\\n          award(S, p, fg, 80 + 20 * o.pairs.length, tune);\\n        }\\n      } else {\\n        slip(S, p, 'loose', 1, tune);\\n        pushEv(S, ['loose', o.id]);\\n      }\\n    }\\n  }\\n\\n670→  function stepSalve(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    let any = false;\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n      if (!canTouch(S, o) || !o.cells) continue;\\n      if (!(o.type === 'laceration' || o.type === 'patch' || o.type === 'bite' || (o.type === 'lobe' && o.mode === 'salve'))) continue;\\n      for (let c = 0; c < o.cells.length; c++) {\\n        const cell = o.cells[c];\\n        if (!cell[2] && hypot(cell[0] - p.x, cell[1] - p.y) <= 10) { cell[2] = 1; any = true; }\\n680→      }\\n      let on = 0;\\n      for (let c = 0; c < o.cells.length; c++) if (o.cells[c][2]) on++;\\n      o.prog = o.cells.length ? on / o.cells.length : 1;\\n      if (o.prog >= 0.9 && !o.done) {\\n        o.done = true; o.alive = false; o.drain = 0;\\n        S.vitals = Math.min(99, S.vitals + 2 * tune.patient.healing);\\n        award(S, p, 'clean', 80, tune);\\n        pushEv(S, ['heal', o.id]);\\n      }\\n690→    }\\n    if (!any && p.trigEdge) { /* salve cannot harm */ }\\n  }\\n\\n  function stepSyringe(S, p, dt, tune) {\\n    if (p.cool > 0) p.cool -= dt;\\n    const down = p.trig > 0.3;\\n    if (down && p.cool <= 0) {\\n      if (p.fill < 1) p.fill = Math.min(1, p.fill + dt / 0.55);\\n      else p.over += dt;\\n700→    }\\n    if (p.trigRelease && p.fill > 0.05 && p.cool <= 0) {\\n      const bubble = p.over >= 0.3;\\n      /* A closed reed or voice is still a target: the needle finds it and the tissue splits. */\\n      const tgt = nearest(S, p, 10, o => {\\n        if (!o || o.done || !o.alive || covered(S, o)) return false;\\n        if (o.type === 'reed' || o.type === 'voice') return true;\\n        return canTouch(S, o) && (o.type === 'clot' || (o.type === 'lobe' && o.mode === 'syringe'));\\n      });\\n      if (tgt) {\\n710→        if ((tgt.type === 'reed' || tgt.type === 'voice') && !tgt.window) {\\n          addObj(S, { type: 'laceration', x: tgt.x + 6, y: tgt.y, r: 8, order: 50, drain: 0.2 });\\n          slip(S, p, 'spit', 2, tune);\\n        } else {\\n          const g = bubble ? 'sloppy' : (p.fill >= 0.9 ? 'textbook' : 'clean');\\n          tgt.dosed = true;\\n          tgt.dose = (bubble ? 0.5 : 1) * p.fill;\\n          if (tgt.follow === 'salve') {\\n            tgt.mode = 'salve';\\n            if (!tgt.cells) {\\n720→              const r = tgt.r || 8;\\n              tgt.cells = [];\\n              for (let y = -r; y <= r; y += 4) for (let x = -r; x <= r; x += 4) {\\n                if (x * x + y * y <= r * r) tgt.cells.push([tgt.x + x, tgt.y + y, 0]);\\n              }\\n            }\\n          } else if (tgt.type === 'clot') { tgt.drain = 0.1; }\\n          else { tgt.done = true; tgt.alive = false; tgt.drain = 0; }\\n          award(S, p, g, 90, tune);\\n          pushEv(S, ['inject', tgt.id, g]);\\n730→        }\\n      } else {\\n        const g = bubble ? 'sloppy' : (p.fill >= 0.9 ? 'textbook' : 'clean');\\n        const add = syringeDose(S, tune) * p.fill * (bubble ? 0.5 : 1);\\n        S.vitals = Math.min(99, S.vitals + add);\\n        award(S, p, g, 40, tune);\\n        S.flags.iv = (S.flags.iv || 0) + 1;\\n        pushEv(S, ['iv', Math.round(add), g]);\\n      }\\n      p.fill = 0; p.over = 0; p.cool = 0.35;\\n740→    }\\n    if (!down && p.trigRelease === false) { /* keep fill while aiming */ }\\n  }\\n\\n  function stepCautery(S, p, dt, tune) {\\n    if (p.lock > 0) { p.lock -= dt; p.heat = Math.max(0, p.heat - 0.6 * dt); return; }\\n    const down = p.trig > 0.3;\\n    if (!down) {\\n      p.heat = Math.max(0, p.heat - 0.6 * dt);\\n      p.bareT = 0;\\n750→      return;\\n    }\\n    p.heat += tune.fluids.cauteryHeat * dt;\\n    if (p.heat >= 1) { p.lock = 1.2; p.heat = 1; slip(S, p, 'lock', 1, tune); pushEv(S, ['lock', p.id]); return; }\\n    if (nerveHit(S, p, tune)) return;\\n    const tgt = nearest(S, p, 6, o => canTouch(S, o) && (o.type === 'polyp' || o.type === 'bleeder' || o.type === 'rupture' || o.type === 'bead' || o.type === 'uvula' || o.type === 'eye' || o.type === 'tremass' || (o.type === 'lobe' && o.mode === 'cautery') || o.type === 'barb'));\\n    if (tgt) {\\n      p.bareT = 0;\\n      tgt.burn = (tgt.burn || 0) + dt;\\n      tgt.prog = tgt.burn / (tgt.need || 0.5);\\n760→      if (tgt.burn >= (tgt.need || 0.5) / Math.max(0.25, tune.strains.health) && !tgt.done) {\\n        const dirty = tgt.charred || p.lockedDuring;\\n        const g = (!tgt.charred && p.lock <= 0 && !p.hadLock) ? 'textbook' : 'clean';\\n        tgt.done = true; tgt.alive = false; tgt.drain = 0; tgt.grade = g;\\n        p.burned += 1;\\n        award(S, p, g, 90, tune);\\n        pushEv(S, ['burn', tgt.id, g]);\\n      }\\n    } else {\\n      p.bareT = (p.bareT || 0) + dt;\\n770→      if (p.bareT >= 0.25) {\\n        /* char on the field */\\n        p.charT = (p.charT || 0) + dt;\\n        S.vitals -= 0.8 * dt * tune.patient.slip;\\n        if (p.bareT >= 0.6 && !p.charSlip) { p.charSlip = true; slip(S, p, 'char', 2, tune); pushEv(S, ['char', Math.round(p.x), Math.round(p.y)]); }\\n      }\\n    }\\n  }\\n\\n  function stepSuction(S, p, dt, tune) {\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/core/sim.js\",\"offset\":620,\"limit\":160,\"raw_output\":\"    if (p.trigEdge) {\\n      /* Press within 9 u of the next near point. Stitches sit off the wound center. */\\n      const reach = 9 + extra + (p.mouse ? 1 : 0);\\n      let o = null, bd = reach;\\n      for (let i = 0; i < S.objects.length; i++) {\\n        const q = S.objects[i];\\n        if (!canTouch(S, q) || !q.pairs || (q.stitch || 0) >= q.pairs.length) continue;\\n        const a = q.pairs[q.stitch][0];\\n        const d = hypot(p.x - a[0], p.y - a[1]);\\n        if (d <= bd) { bd = d; o = q; }\\n      }\\n      if (o) {\\n        p.stroke = { kind: 'suture', id: o.id, i: o.stitch, t: 0 };\\n        pushEv(S, ['needle', o.id, o.stitch]);\\n      }\\n    }\\n    if (p.stroke && p.stroke.kind === 'suture' && down) p.stroke.t += dt;\\n    if (p.stroke && p.stroke.kind === 'suture' && p.trigRelease) {\\n      const o = objById(S, p.stroke.id);\\n      const st = p.stroke;\\n      p.stroke = null;\\n      if (!o || o.done) return;\\n      const b = o.pairs[st.i][1];\\n      const tol = 6 + extra + (p.mouse ? 1 : 0);\\n      if (hypot(p.x - b[0], p.y - b[1]) <= tol) {\\n        const g = gradeMean(st.t, 0.6, 1.2);\\n        o.grades = o.grades || [];\\n        o.grades.push(g === 'textbook' ? 2 : g === 'clean' ? 1 : 0);\\n        o.times = o.times || [];\\n        o.times.push(st.t);\\n        o.stitch = st.i + 1;\\n        o.prog = o.stitch / o.pairs.length;\\n        p.stitches += 1;\\n        const bleedLeft = 1 - o.prog;\\n        if (o.type === 'arteryTear') o.drain = 1 * bleedLeft;\\n        else if (o.type === 'wound') o.drain = 0.4 * bleedLeft;\\n        pushEv(S, ['stitch', Math.round(b[0]), Math.round(b[1]), g]);\\n        if (o.stitch >= o.pairs.length) {\\n          const meanT = o.times.reduce((a, c) => a + c, 0) / o.times.length;\\n          const fg = gradeMean(meanT, 0.6, 1.2);\\n          o.done = true; o.alive = false; o.grade = fg; o.drain = 0;\\n          award(S, p, fg, 80 + 20 * o.pairs.length, tune);\\n        }\\n      } else {\\n        slip(S, p, 'loose', 1, tune);\\n        pushEv(S, ['loose', o.id]);\\n      }\\n    }\\n  }\\n\\n  function stepSalve(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    let any = false;\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n      if (!canTouch(S, o) || !o.cells) continue;\\n      if (!(o.type === 'laceration' || o.type === 'patch' || o.type === 'bite' || (o.type === 'lobe' && o.mode === 'salve'))) continue;\\n      for (let c = 0; c < o.cells.length; c++) {\\n        const cell = o.cells[c];\\n        if (!cell[2] && hypot(cell[0] - p.x, cell[1] - p.y) <= 10) { cell[2] = 1; any = true; }\\n      }\\n      let on = 0;\\n      for (let c = 0; c < o.cells.length; c++) if (o.cells[c][2]) on++;\\n      o.prog = o.cells.length ? on / o.cells.length : 1;\\n      if (o.prog >= 0.9 && !o.done) {\\n        o.done = true; o.alive = false; o.drain = 0;\\n        S.vitals = Math.min(99, S.vitals + 2 * tune.patient.healing);\\n        award(S, p, 'clean', 80, tune);\\n        pushEv(S, ['heal', o.id]);\\n      }\\n    }\\n    if (!any && p.trigEdge) { /* salve cannot harm */ }\\n  }\\n\\n  function stepSyringe(S, p, dt, tune) {\\n    if (p.cool > 0) p.cool -= dt;\\n    const down = p.trig > 0.3;\\n    if (down && p.cool <= 0) {\\n      if (p.fill < 1) p.fill = Math.min(1, p.fill + dt / 0.55);\\n      else p.over += dt;\\n    }\\n    if (p.trigRelease && p.fill > 0.05 && p.cool <= 0) {\\n      const bubble = p.over >= 0.3;\\n      /* A closed reed or voice is still a target: the needle finds it and the tissue splits. */\\n      const tgt = nearest(S, p, 10, o => {\\n        if (!o || o.done || !o.alive || covered(S, o)) return false;\\n        if (o.type === 'reed' || o.type === 'voice') return true;\\n        return canTouch(S, o) && (o.type === 'clot' || (o.type === 'lobe' && o.mode === 'syringe'));\\n      });\\n      if (tgt) {\\n        if ((tgt.type === 'reed' || tgt.type === 'voice') && !tgt.window) {\\n          addObj(S, { type: 'laceration', x: tgt.x + 6, y: tgt.y, r: 8, order: 50, drain: 0.2 });\\n          slip(S, p, 'spit', 2, tune);\\n        } else {\\n          const g = bubble ? 'sloppy' : (p.fill >= 0.9 ? 'textbook' : 'clean');\\n          tgt.dosed = true;\\n          tgt.dose = (bubble ? 0.5 : 1) * p.fill;\\n          if (tgt.follow === 'salve') {\\n            tgt.mode = 'salve';\\n            if (!tgt.cells) {\\n              const r = tgt.r || 8;\\n              tgt.cells = [];\\n              for (let y = -r; y <= r; y += 4) for (let x = -r; x <= r; x += 4) {\\n                if (x * x + y * y <= r * r) tgt.cells.push([tgt.x + x, tgt.y + y, 0]);\\n              }\\n            }\\n          } else if (tgt.type === 'clot') { tgt.drain = 0.1; }\\n          else { tgt.done = true; tgt.alive = false; tgt.drain = 0; }\\n          award(S, p, g, 90, tune);\\n          pushEv(S, ['inject', tgt.id, g]);\\n    