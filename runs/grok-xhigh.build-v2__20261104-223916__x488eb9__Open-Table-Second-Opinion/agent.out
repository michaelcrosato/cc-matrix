leContent\":{\"content\":\"1040→  }\\n  _check(a) { if (!this.map[a]) warn('action:' + a, 'unknown input action \\\"' + a + '\\\". Known actions: ' + Object.keys(this.map).join(', ') + '. Add your own with new E.Game({ input: { ...E.Input.DEFAULT, ' + a + \\\": ['KeyQ'] } })\\\"); }\\n  /** is the action held right now? */\\n  down(a) { const m = this.map[a]; if (!m) { this._check(a); return false; } if (this._suppressed.has(a)) return false; for (const c of m) if (this.held.has(c)) return true; return false; }\\n  /** true only during the first update step after the press (menus, jumps, one-shot actions) */\\n  pressed(a) { if (!this.map[a]) this._check(a); return !this._suppressed.has(a) && this._now.has(a); }\\n  /** true only during the first update step after the action was let go */\\n  released(a) { return this._nowUp.has(a); }\\n  /** pressed, then repeats while held (after `delay` s, every `rate` s): menu cursors, puzzle pieces */\\n  repeat(a, delay = .3, rate = .08) {\\n1050→    if (this.pressed(a)) return true;\\n    if (!this.down(a) || this._pt[a] === undefined) return false;\\n    const t = this.clock - this._pt[a]; if (t < delay) return false;\\n    const k = Math.floor((t - delay) / rate); if (k !== this._rk[a]) { this._rk[a] = k; return true; }\\n    return false;\\n  }\\n  /** was it pressed within the last `win` seconds and not yet consumed? (input buffering) */\\n  buffered(a, win = .15) { if (!this.map[a]) this._check(a); const t = this._pt[a]; return !this._suppressed.has(a) && t !== undefined && !this._used[a] && this.clock - t <= win; }\\n  /** mark a buffered press of action a as used, so buffered(a) is false until the next press */\\n  consume(a) { this._used[a] = true; }\\n1060→  /** Suppress a held action until the next tick (a HUD widget owns the pointer this step). */\\n  suppress(a) { this.consume(a); this._suppressed.add(a); }\\n  /** A widget owns this button; other devices bound to the same action still work. */\\n  suppressCode(code) {\\n    for (const a of this._codes[code] || []) if (!this.map[a].some(c => c !== code && this.held.has(c))) this.suppress(a);\\n  }\\n  /** forget every pending press (after closing a menu or dialog, so the same press does not also attack) */\\n  consumeAll() { for (const a in this.map) this._used[a] = true; this._now.clear(); this._fresh.clear(); this._freshCodes.clear(); this._clickAt = this._click = null; }\\n  /** the page went full screen or back: the keys and mouse buttons let go (one held through the change may never come up),\\n   *  but a finger on the glass goes on (the stick, a drag, a touch button) and a press that has landed counts: a phone's\\n1070→   *  first tap, the one that went full screen, is a JUMP */\\n  _refit() { for (const c of [...this.held]) if (!c.startsWith('Act:') && !c.startsWith('Pad')) this.release(c); this._down = null; }\\n  /** Release all devices and discard buffered input on focus loss or a modal transition. */\\n  clear() {\\n    this.held.clear(); this._holds.clear(); this.consumeAll(); this._nowUp.clear(); this._freshUp.clear(); this._pt = {}; this._rk = {}; this._down = null;\\n    this.padMove = [0, 0]; this.padAim = null; this._fingers.clear(); this._zoneOf.clear(); this._pinching = false; this._zoomAcc = 1;\\n    this._stickEnd({ pointerId: this.stickId });\\n    for (const b of this._boundButtons || []) { b.classList.remove('on'); b._inputPointers.clear(); }\\n  }\\n  /** the last second of input, oldest first: [{ t (input.clock), dir (numpad 1-9 for a fighter facing right: 5 neutral),\\n1080→   *  pressed: the actions pressed then, directions aside }], one entry each time the direction changes or a button is\\n   *  pressed: an input display draws it; sequence() and motion() read it (section 10h: a kit without it has none) */\\n  get history() { return this._hist || []; }\\n  /** any action pressed this step (title screens: \\\"press any button\\\") */\\n  anyPressed() { return this._now.size > 0; }\\n  /** movement intent in screen directions: x right, y down, length <= 1 */\\n  move() {\\n    let x = (this.down('right') ? 1 : 0) - (this.down('left') ? 1 : 0), y = (this.down('down') ? 1 : 0) - (this.down('up') ? 1 : 0);\\n    if (this.stickOn) { x = this.stick[0]; y = this.stick[1]; }\\n    if (Math.hypot(this.padMove[0], this.padMove[1]) > 0) { x = this.padMove[0]; y = this.padMove[1]; }\\n1090→    const l = Math.hypot(x, y); if (l > 1) { x /= l; y /= l; }\\n    return [x, y];\\n  }\\n  /** mouse position in projected screen pixels, or null */\\n  mouseScreen() { return this.mouse.active ? this.screen.clientToScreen(this.mouse.cx, this.mouse.cy) : null; }\\n  /** where a click or tap on the canvas landed, in screen pixels [x, y] (the HUD's space: r.W, r.H), during the step\\n   *  after it lifted (a press that drags away, like the touch stick's, is none); else null. Menus and dialogs answer to\\n   *  it; a HUD button of your own can: if (hit(input.clicked())) ... */\\n  clicked() { return this._clickAt; }\\n  /** how far the touch stick's finger moved since the last step, in screen pixels [dx, dy] (the HUD's space), or null while\\n1100→   *  no finger holds it: to steer one to one (a shooter's ship follows the thumb) instead of by the stick's direction */\\n  drag() { return this._drag || null; }\\n  /** the camera zoom the player asked for since the last step, as a factor (1.1: 10% closer, .9: farther; 1: none): the\\n   *  wheel, - and = and a pinch, where the scene lets them zoom. The game applies it (game.zoomBy) */\\n  zoom() { return this._zoomNow; }\\n  /** the mouse pointer in screen pixels [x, y] (the HUD's space), or null before it has moved over the canvas */\\n  pointer() { return this._fedAt || (this.mouse.active ? this.screenPoint(this.mouse.cx, this.mouse.cy) : null); }\\n  /** the pointer's gestures, read each step in screen pixels (the HUD's space), from a mouse or one finger:\\n   *  box() -> { x0, y0, x1, y1, from, to, done } while a box is drawn (a mouse's left button dragged; on a touch screen a long\\n   *  press, then a drag), done the step it is let go; else null */\\n1110→  box() { return this._boxAt; }\\n  /** [x, y] the step a press held still has been held .45 s (a long press), else null */\\n  longPress() { return this._longAt; }\\n  /** [x, y] the step a second tap or click lands within .35 s and 8 pixels of the first (a double tap), else null */\\n  doubleTap() { return this._tap2At; }\\n  /** [dx, dy] how far a drag moved this step: one finger on open ground (not a box), or a mouse's middle or right button;\\n   *  else null. A free camera pans by it (game.cam.free) */\\n  pan() { return this._panAt; }\\n  /** [x, y] where the last zoom was asked for: the mouse pointer for the wheel, between the fingers for a pinch; null when\\n   *  the keys zoomed (about the screen's middle) */\\n1120→  zoomPoint() { return this._zoomPt; }\\n  /** a pointer event in screen pixels, as the browser's would give: feed('down' | 'move' | 'up', x, y, { touch: false,\\n   *  button: 0, id: 0 (which finger, for zones) }) (a test's or a bot's mouse and fingers: clicks, boxes, long presses,\\n   *  double taps and pans follow; a finger in one of the zones holds its act), or\\n   *  feed('zoom', x, y, { k: 1.1 }): a wheel's notch or a pinch about that point */\\n  feed(type, x, y, o = {}) {\\n    if (type === 'zoom') { this._zoomAcc *= o.k || 1.1; this._zoomPt = [x, y]; return; }\\n    if (!o.touch) this._fedAt = [x, y];\\n    const S = this.screen, z = o.touch && type === 'down' && this.zones && this._zone(x / S.W, y / S.H);\\n    if (z) { this._zoneDown('fed' + (o.id || 0), z); return; }   // (a finger in a zone: its act, no gesture)\\n1130→    if (o.touch && type === 'up' && this._zoneOf.has('fed' + (o.id || 0))) { this._zoneUp('fed' + (o.id || 0)); return; }\\n    if (type === 'down') { this._fed = [x, y]; if (!o.touch) this.press('Mouse' + (o.button || 0)); this._gesture('down', x, y, { touch: !!o.touch, button: o.button |