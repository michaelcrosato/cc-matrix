 game.paused) return;\\n  if (game._lobby) { game._lobby.tick(dt); if (game._lobby.pressed('join') && !P.some(q => q.half === 'right') && I.lastDevice !== 'gamepad') game.addPlayer({ keys: 'right' }); }\\n  let pads = []; try { pads = navigator.getGamepads ? Array.from(navigator.getGamepads() || []) : []; } catch (e) { /* gamepads blocked */ }\\n  for (const p of pads) {   // Start on a pad no one holds: player 1's own once it plays on it (the press that just woke it joins)\\n    if (!p || p.connected === false || P.some(q => q.pad === p.index) || (was[0] === 'gamepad' && was[1] === p.index)) continue;\\n    const on = !!(p.buttons[9] && p.buttons[9].pressed), prev = (game._joinPrev || (game._joinPrev = {}))[p.index]; game._joinPrev[p.index] = on;\\n    if (!on || prev || P.length >= J.max || (p.buttons[8] && p.buttons[8].pressed)) continue;   // (Create + Options is the host's)\\n    if (I.padIndex === p.index) { I.consumeAll(); [I.lastDevice, , I.aimSource] = was; game._p1 = was; }   // (that Start was the joiner's: player 1 neither pauses nor turns to the pad)\\n    game.addPlayer({ pad: p.index });\\n3840→  }\\n});\\nHOOKS.enter.push(game => {   // a scene's start: the others take its keys too (a half each where they share the keyboard); a split ends\\n  game._split = null; const P = game._players; if (!P || P.length < 2) return;\\n  const I = P[0]; if (I.half && game.scene && game.scene.input) { I._full = I.preset; I.use(Input.halfKeys(I._full, 'left')); }\\n  for (const q of P.slice(1)) q.use(_pPreset(game, q));\\n});\\nHOOKS.step.push((game, dt) => { if (game._split) for (const v of game._split.vps) _vpCam(game, v, dt); });\\n// a split screen's frame: the scene drawn in each viewport (its own camera, lights and overlays, clipped to it), then\\n// the dividers, the scene's hud(r) over the whole screen and the frame's own overlays (notes, pause, fades)\\n3850→HOOKS.frame = (game, shx, shy) => {\\n  const r = game.r, sc = game.scene, S = game._split; _vpLayout(game);\\n  for (const v of S.vps) {\\n    if (v.cam.x === undefined) _vpCam(game, v, 0);\\n    game.lights._clear(); r._begin(v.cam.x + shx - v.x, v.cam.y + shy - v.y, v); r.viewport = v;\\n    if (sc && sc.draw) sc.draw(r);\\n    r._finish();\\n  }\\n  r.viewport = null; r._items.length = 0; r._decals.length = 0; r._overlays.length = 0; r._only = true;\\n  r.overlay(g => { for (const v of S.vps) { if (v.x > 0) px.rect(g, v.x - S.gap, v.y, S.gap, v.h, '#05040a'); if (v.y > 0) px.rect(g, v.x, v.y - S.gap, v.w, S.gap, '#05040a'); } });\\n3860→  if (sc && sc.hud) sc.hud(r);\\n};\\n\\n/* =============================================================================\\n * 10k. SAVE SLOTS  game.saves: three slots and an autosave, each holding the game's own data with its place, time\\n *    played and level, as Dragon Quest's adventure log and Final Fantasy's save screen do. A save is versioned (the\\n *    game's version of its data, migrate for older ones); nothing here throws, and when storage is blocked play goes\\n *    on with the saves kept for the visit (a headless game keeps them in memory only).\\n *      game.saves.write = () => ({ data: { hero, flags }, place: 'Brightwater', level: hero.lv });   // what a save holds\\n *      game.saves.read = save => { hero = save.data.hero; ... };                                    // what a load does\",\"content_concise\":\"3820→  [c.x, c.vx] = smoothDamp(c.x, tx, c.vx, c.smooth, dt); [c.y, c.vy] = smoothDamp(c.y, ty, c.vy, c.smooth, dt);\\n}\\n// each step: the other players' inputs, a pause by any of them, a lost controller, and joining\\nHOOKS.input.push((game, dt) => {\\n  const P = game._players; if (!P || (P.length < 2 && !game._join)) return;\\n  for (const q of P.slice(1)) {\\n    if (q.padLost) { game._autoPause('controller'); game.note(q.name + ': CONTROLLER DISCONNECTED', 2.5); }\\n    if (game.scene && game.scene.pausable && q.pressed('pause')) { game.paused = !game.paused; game.pauseReason = game.paused ? 'player' : null; game.pausedBy = q.player; game.audio.sfx('pause'); q.consumeAll(); }\\n  }\\n  const I = P[0], was = game._p1 || [I.lastDevice, I.padIndex, I.aimSource]; game._p1 = [I.lastDevice, I.padIndex, I.aimSource];\\n3830→  if (I.pressed('pause')) game.pausedBy = 1;\\n  const J = game._join; if (!J || P.length >= J.max || game.paused) return;\\n  if (game._lobby) { game._lobby.tick(dt); if (game._lobby.pressed('join') && !P.some(q => q.half === 'right') && I.lastDevice !== 'gamepad') game.addPlayer({ keys: 'right' }); }\\n  let pads = []; try { pads = navigator.getGamepads ? Array.from(navigator.getGamepads() || []) : []; } catch (e) { /* gamepads blocked */ }\\n  for (const p of pads) {   // Start on a pad no one holds: player 1's own once it plays on it (the press that just woke it joins)\\n    if (!p || p.connected === false || P.some(q => q.pad === p.index) || (was[0] === 'gamepad' && was[1] === p.index)) continue;\\n    const on = !!(p.buttons[9] && p.buttons[9].pressed), prev = (game._joinPrev || (game._joinPrev = {}))[p.index]; game._joinPrev[p.index] = on;\\n    if (!on || prev || P.length >= J.max || (p.buttons[8] && p.buttons[8].pressed)) continue;   // (Create + Options is the host's)\\n    if (I.padIndex === p.index) { I.consumeAll(); [I.lastDevice, , I.aimSource] = was; game._p1 = was; }   // (that Start was the joiner's: player 1 neither pauses nor turns to the pad)\\n    game.addPlayer({ pad: p.index });\\n3840→  }\\n});\\nHOOKS.enter.push(game => {   // a scene's start: the others take its keys too (a half each where they share the keyboard); a split ends\\n  game._split = null; const P = game._players; if (!P || P.length < 2) return;\\n  const I = P[0]; if (I.half && game.scene && game.scene.input) { I._full = I.preset; I.use(Input.halfKeys(I._full, 'left')); }\\n  for (const q of P.slice(1)) q.use(_pPreset(game, q));\\n});\\nHOOKS.step.push((game, dt) => { if (game._split) for (const v of game._split.vps) _vpCam(game, v, dt); });\\n// a split screen's frame: the scene drawn in each viewport (its own camera, lights and overlays, clipped to it), then\\n// the dividers, the scene's hud(r) over the whole screen and the frame's own overlays (notes, pause, fades)\\n3850→HOOKS.frame = (game, shx, shy) => {\\n  const r = game.r, sc = game.scene, S = game._split; _vpLayout(game);\\n  for (const v of S.vps) {\\n    if (v.cam.x === undefined) _vpCam(game, v, 0);\\n    game.lights._clear(); r._begin(v.cam.x + shx - v.x, v.cam.y + shy - v.y, v); r.viewport = v;\\n    if (sc && sc.draw) sc.draw(r);\\n    r._finish();\\n  }\\n  r.viewport = null; r._items.length = 0; r._decals.length = 0; r._overlays.length = 0; r._only = true;\\n  r.overlay(g => { for (const v of S.vps) { if (v.x > 0) px.rect(g, v.x - S.gap, v.y, S.gap, v.h, '#05040a'); if (v.y > 0) px.rect(g, v.x, v.y - S.gap, v.w, S.gap, '#05040a'); } });\\n3860→  if (sc && sc.hud) sc.hud(r);\\n};\\n\\n/* =============================================================================\\n * 10k. SAVE SLOTS  game.saves: three slots and an autosave, each holding the game's own data with its place, time\\n *    played and level, as Dragon Quest's adventure log and Final Fantasy's save screen do. A save is versioned (the\\n *    game's version of its data, migrate for older ones); nothing here throws, and when storage is blocked play goes\\n *    on with the saves kept for the visit (a headless game keeps them in memory only).\\n *      game.saves.write = () => ({ data: { hero, flags }, place: 'Brightwater', level: hero.lv });   // what a save holds\\n *      game.saves.read = save => { hero = save.data.hero; ... };                                    // what a load does\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/my-3d2dge/dist/handoff/my-3d2dge.js\",\"offset\":3820,\"limit\":50,\"raw_output\":\"  [c.x, c.vx] = smoothDamp(c.x, 