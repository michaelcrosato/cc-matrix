 = await metasOf(game);\\n  const mode = modeOf(metas?.mode);\\n\",\"total_lines\":548}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"5d5c1844-0a38-4837-b6b6-56da27fddf0b"}
