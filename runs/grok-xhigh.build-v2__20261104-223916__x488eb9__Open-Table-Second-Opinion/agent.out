pe: 'lobe', x: L.x, y: L.y, mode: L.mode === 'slash' ? 'scalpel' : L.mode, order: 1, tag: 'lobe-' + L.id, open: false, drain: 0.15, need: L.mode === 'cautery' ? 1 : 0.5 };\"},{\"line_number\":1299,\"content\":\"  function phaseClear(S) {\"},{\"line_number\":1300,\"content\":\"    if (S.strain && !S.strain.done) return false;\"},{\"line_number\":1311,\"content\":\"      if (live && !S.strain.done) return false;\"},{\"line_number\":1620,\"content\":\"    if (S.ghostT > 0) S.ghostT -= dt;\"},{\"line_number\":1628,\"content\":\"    if (!S.lost && !S.won && !S.codeBlue && phaseClear(S)) advancePhase(S);\"},{\"line_number\":1635,\"content\":\"    let a = tune.hands.assist;\"},{\"line_number\":1649,\"content\":\"    const rad = tune.hands.magnet;\"},{\"line_number\":1657,\"content\":\"      if (p.tool === 'cautery') return o.type === 'polyp' || o.type === 'bleeder' || o.type === 'bead' || o.type === 'uvula' || o.type === 'eye' || o.type === 'rupture' || o.type === 'tremass' || o.type === 'barb' || o.type === 'lobe';\"},{\"line_number\":1680,\"content\":\"    let speed = curved * tune.hands.cursor;\"},{\"line_number\":1694,\"content\":\"    const assist = S ? assistOf(S, tune) : tune.hands.assist;\"},{\"line_number\":1776,\"content\":\"    updateCursor, updateWheel, wheelIndex, spawnStrain, phaseClear, objById,\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/art/field.js\",\"matches\":[{\"line_number\":390,\"content\":\"    else if (name === 'cautery') { px.line(g, X(4), Y(16), X(12), Y(5), c, 1); px.disc(g, X(13), Y(4), 2, '#ffb45a'); }\"},{\"line_number\":400,\"content\":\"    if (p.tool === 'cautery' && p.trig > 0.3) px.disc(g, x + 10, y - 12, 3, '#ffcf70');\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104