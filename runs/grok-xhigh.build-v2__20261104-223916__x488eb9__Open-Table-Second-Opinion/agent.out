41,\"content\":\" *    interface (title, pause, settings, help, results, map screens and a HUD with a minimap) from data: new E.Shell(game,\"},{\"line_number\":45,\"content\":\" *    input.label(action) for prompts, and a boot (10c): heavy setup in game.start({ boot: { steps } }) runs behind a\"},{\"line_number\":2400,\"content\":\"    /** the E.Shell over this game (an HTML interface: screens and HUD), or null */\"},{\"line_number\":2709,\"content\":\"   * Start the loop. Either one scene:  game.start({ update(dt), draw(r) })\"},{\"line_number\":2710,\"content\":\"   * or several:  game.start({ scenes: { title: {...}, play: {...} }, scene: 'title' })\"},{\"line_number\":2728,\"content\":\"      if (!hooks || typeof hooks !== 'object') throw new Error('game.start needs { update(dt), draw(r) } or { scenes: { name: { update, draw } }, scene: \\\"name\\\" }');\"},{\"line_number\":2735,\"content\":\"        if (typeof hooks.update !== 'function' || typeof hooks.draw !== 'function') throw new Error('game.start({ update(dt), draw(r) }) needs both functions (or use { scenes, scene })');\"},{\"line_number\":2843,\"content\":\"    if (!this.scene && !this._next) throw new Error('game.advance() needs a started game: game.start({ update, draw }) first');\"},{\"line_number\":2883,\"content\":\"    if (!this.scenes) { warn('go:noscenes', 'game.go() needs game.start({ scenes: {...}, scene }) first'); return; }\"},{\"line_number\":3038,\"content\":\" *    E.Shell draws the menu's screens (pause, settings, controls): section 21d.\"},{\"line_number\":3098,\"content\":\"    /** onChange(key, value): called after every change (E.Shell's settings.onChange goes through it) */\"},{\"line_number\":3219,\"content\":\" *      game.start({ scenes, scene: 'title', boot: { title: 'VESPER', version: '1.0',\"},{\"line_number\":3947,\"content\":\"  /** open the standard save screen over the game (E.Shell's): 'save' (to a slot) or 'load'; done(save) after a load or\"},{\"line_number\":9269,\"content\":\"class Menu {\"},{\"line_number\":9343,\"content\":\" *      const ui = new E.Shell(game, { theme: { accent: '#d9b77c' }, settings: { items: ['sound', 'volume', 'motion'] },\"},{\"line_number\":9355,\"content\":\" *    THE STANDARD MENU: every game gets one (new E.Game makes this shell for itself, and a game's own E.Shell takes over\"},{\"line_number\":9361,\"content\":\" *    false }, quit: 'title' } }) adjusts it; menu: false, or new E.Shell(game, { standard: false }), leaves it out.\"},{\"line_number\":9417,\"content\":\"   * new E.Shell(game, { theme, screens: { name: spec }, settings: { items, onChange(settings, key) }, store: 'shell-settings',\"},{\"line_number\":9449,\"content\":\"    if (th.font && /\\\\d|\\\\b(bold|italic|normal|oblique)\\\\b/.test(th.font)) warn('shell:font', 'E.Shell theme.font is a family (\\\"Georgia, serif\\\"), not a CSS shorthand (\\\"' + th.font + '\\\"): the size comes from theme.scale');\"},{\"line_number\":9846,\"content\":\"E.Shell = Shell;\"},{\"line_number\":10869,\"content\":\"game.start({ update(dt) { pc.update(dt); }, draw(r) { pc.draw(r); } });\"},{\"line_number\":11450,\"content\":\"game.start({ update: dt => m.update(dt), draw: r => m.draw(r) });   // once a step, 120 times a second\"},{\"line_number\":13157,\"content\":\"const E = My3D2dge, game = new E.Game({ headless: true }); game.start({ update() {}, draw() {} });\"},{\"line_number\":13657,\"content\":\"  /** the explored map for E.Shell's minimap: game.shell.hud({ minimap: world.shellMap() }) (a cell a square, the save\"},{\"line_number\":14198,\"content\":\"game.start({ update(dt) { story.update(dt); }, draw(r) { story.draw(r); } });\"},{\"line_number\":14365,\"content\":\"E.Story = Story;\"},{\"line_number\":14394,\"content\":\"- rts.fog (E.Fog: the player's sight; walls block it), rts.visible(u); rts.minimap() is E.Shell's hud({ minimap }) (the\"},{\"line_number\":14416,\"content\":\"game.start({ update(dt) { rts.update(dt); }, draw() {} });\"},{\"line_num