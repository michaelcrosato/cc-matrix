rEach((on, i) => { if (on) this.release('Pad' + i); }); for (const c of ['PadAxisUp', 'PadAxisDown', 'PadAxisLeft', 'PadAxisRight', 'PadRAxisUp', 'PadRAxisDown', 'PadRAxisLeft', 'PadRAxisRight']) this.release(c); }   // (a pad gone or changed lets go once; with none, a script's pad codes stay held)\"},{\"line_number\":1193,\"content\":\"      ['PadAxisUp', 'PadAxisDown', 'PadAxisLeft', 'PadAxisRight'].forEach((c, i) => dirs[i] ? this.press(c) : this.release(c));\"},{\"line_number\":1290,\"content\":\"const FIXED_CODES = new Set(['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Pad12', 'Pad13', 'Pad14', 'Pad15', 'PadAxisUp', 'PadAxisDown', 'PadAxisLeft', 'PadAxisRight']);\"},{\"line_number\":1292,\"content\":\"const STICK_CODES = { up: 'PadAxisUp', down: 'PadAxisDown', left: 'PadAxisLeft', right: 'PadAxisRight' };\"},{\"line_number\":1306,\"content\":\"  PadAxisUp: 'L stick ↑', PadAxisDown: 'L stick ↓', PadAxisLeft: 'L stick ←', PadAxisRight: 'L stick →',\"},{\"line_number\":3993,\"content\":\" *  direction (PadAxisUp ..., or up / down / left / right on the touch stick) by its push, any other code held 1 */\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"d108c627-458f-4a1c-8cfd-412fb82719da"}
{"type":"assistant","message":{"id":"msg_269","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"Line 878 adds stick codes to the map when building it for up, down, left, and right actions.\n\nWriting the complete shell.js. Wrapping Audio.onEv to prevent sfx errors. Default fadeTime is .22 for play and 0 for tests. Hub player colors will use CFG.SEAT.\n\nRemote hand tool numbers map to the tools index. Snapshot objects use a TYPE list index, defaulting to 0 for unknown types. Flags encode done, hidden, marked, and alive states in bits 0 through 3. Living objects are those that are not done and are alive, capped at 28. Long guides are omitted from snapshots.\n\nClients will draw mirrors and harnesses as simple discs from snapshots. The host renders the full S shape. The server does not draw anything.\n\nClients may use H.view for drawing if available, otherwise they fall back to drawing the card directly.\n\nPlayer IDs may not be sequential starting at zero. Standings map IDs to indices via findIndex. Finish standings use q.id rather than simulation IDs. Scores are computed from actions of each seat.\n\nThe snapshot will include the hub player ID so clients can map it, though the host does not need this field for tests.\n\n`game.o.menu.items` must be set at construction time so later mutations work during pause rendering. `GAME.openDev` is assigned before any pause and is absent in session mode with an empty items array.\n\nA keyboard shortcut for dev mode is unnecessary.\n\nThe skills lab is pausable. `beginCase` already sets `cheat lockVitals` in the simulation. The lab should not save rank.\n\n`recordRank` is gated by several conditions. It returns early if the session is missing, the player lost, attract mode is active, cheat flags are set, or the tuning menu is dirty. It also skips `lab`, `rounds`, and `ferry`. Once passed, it stores the rank and marks the level as cleared and saved.\n\n`recordRank` now sets `RT.chapter` from the case definition when available. The save payload includes ranks, cleared flags, saved flags, chapter, story state, difficulty, and a fixed place and level string. `game.saves.write` will be assigned before any save access so the getter can create the Saves instance with menu options.\n\nThe Saves constructor copies write and read from the menu.saves options object. I will assign those properties directly on game.saves after creation. Headless mode will use memory-only storage with blocked storage APIs. Ward autosave calls will be wrapped in try/catch. The shell.js file is ready to be composed.\n\nScene updates call story.update(dt). Scene draws call both story.draw and the backdrop.\n\nThe skip key toggles story.skip while held. When skip turns on mid-line, talk.speed must be raised to catch up with the text.\n\nStory skip mode will raise talk.speed to 1e6 and set auto to 0.08 while the key is held. The log backlog can be toggled with the log button and drawn as an overlay. The stage background behind story scenes will use Art.stage based on the current chapter.\n\nStage backgrounds are mapped by chapter: 1 is theatre, 2 is office, 3 is harbor, and 4 is chapel. Chapter 11 uses the ship stage.\n\nA `GAME.liveS` getter will return `RT.S` for tests.\n\n`game.debug` will hold `driver`, `skipStory`, and `snapshot`. Tests can set the driver function and enable skip story mode.\n\nAttract mode ignores any assigned debug driver and runs on real time.\n\nAttract mode uses its own single-step update loop, so it ignores any leftover debug driver from tests. Playthroughs set the driver before operations begin, but story scenes remain unaffected. Results are unaffected by the driver as well. `beginCase` will accept an options object and clear `leftOp`.\n\n`beginCase` now resolves ferry and rounds cases through `GAME.roundsCase`. It stores the resolved definition and mode, preserves `fromStory`, and creates the operation with seed, difficulty, player count, and phase from options. It then applies optional clock and steady deltas.\n\n`beginCase` now merges cheat flags into the simulation state. It resets `leftOp`, `fieldKey`, and `shaded`. The `fromStory` flag is only overwritten when explicitly passed, so chart calls preserve the existing value. Ferry rounds cases are created with `fromStory: false`.\n\nA `fieldOf` helper caches operation fields by site, seed, and viewport dimensions. It rebuilds the cache when width or height changes. The shade flag resets at the start of each operation draw so it applies once per frame and skips substeps.\n\nThe `drawOp` function shades the operation field once per advance. It sets `RT.shaded` to false before the call and true after, wrapping it in a try/catch block. The field canvas is then drawn into the overlay layer.\n\nA colored rectangle is drawn behind the operation field when shading is skipped, preventing empty frames in headless mode. The tissue image is drawn after shading, with vectors layered on top so tools remain visible even in dark conditions. Shading is bypassed in headless mode unless forced, but vectors still render the operation.\n\nShading will default to off in headless mode. Tests can force it for a single frame. The shade call will be wrapped in try/catch to handle null canvases safely. The file is ready to be written. After writing, I will run node --check and a vm boot to verify it.\n\nShell audio event handlers will be wrapped in try/catch blocks for safety. Gamepads will be handled in tests rather than the shell, which relies solely on game.input. Menus will be created on scene entry instead of at module level to avoid initialization order issues with the game object. Story portraits close over the story instance. The talk box colors are being set to theme values, but I need to verify those properties exist.\n\nThe Dialog constructor will receive theme colors if those properties exist, otherwise it will be skipped. The file should stay under 80 KB so the tool can handle it in one pass. Input.held is a Set of key codes, so held keys are checked with .has(). Clicks will set the hero target coordinates for click-to-walk.\n\nHero movement combines analog stick input with held keys, moving at 80 pixels per second and clamped to 8 pixels inside the walls. The door is centered at the bottom edge, with the hero starting just left of it. On resize, the hero repositions if it was at the start. Visitors stay fixed after entering. When the player presses confirm near a visitor and is not at the door, the hero faces that person and enters a 3-second conversation line; otherwise the hero leaves.","signature":""},{"type":"text","text":"The sim and content are in place. Next I’ll add the scene shell so title, surgery, story, and the Hub all run on that same state."},{"type":"tool_use","id":"call-1e93bea0-c3d4-4bb7-86ca-432537efd70c-60","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/scenes/shell.js","new_string":"/* Scenes, input, attract reel, dev panel, and the Hub table. The sim stays free of drawing. */\n(() => {\n  const G = typeof window !== 'undefined' ? window : globalThis;\n  const GAME = (G.GAME ||= {});\n  const E = G.My3D2dge;\n  const HUB = G.AIHub || null;\n  const inSession = !!(HUB && HUB.active);\n  const CFG = GAME.CFG;\n  const TITLE = CFG.GAME_TITLE;\n\n  const RT = {\n    diff: 'resident',\n    prefsReady: false,\n    S: null,\n    def: null,\n    mode: 'case',\n    fromStory: false,\n    redirect: false,\n    chartFor: null,\n    chartCase: null,\n    light: null,\n    miss: 0,\n    leftOp: false,\n    fieldKey: '',\n    field: null,\n    menu: null,\n    devOpen: false,\n    devTab: 0,\n    devI: 0,\n    cheatUsed: false,\n    attract: false,\n    loops: 0,\n    seg: 0,\n    segT: 0,\n    mouseInit: false,\n    mouseT: 0,\n    idle: 0,\n    suppress: 0,\n    ranks: {},\n    cleared: {},\n    saved: {},\n    chapter: 1,\n    visitors: [],\n    nearDoor: false,\n    hero: { x: 200, y: 160, tx: null, ty: null },\n    door: { x: 210, y: 180 },\n    line: '',\n    lineT: 0,\n    creditPage: 0,\n    logOpen: false,\n    latched: false,\n    pending: 'story',\n    fileCase: 'c1',\n    lobbyN: 1,\n  };\n  const PREFS = {\n    assist: 0.6,\n    cursor: 330,\n    swap: false,\n    sustain: 'hold',\n    hints: true,\n    blood: 'red',\n    text: 1,\n  };\n  GAME.PREFS = PREFS;\n\n  const PERSON = {\n    c1: 'agnes', c2: 'slide', c3: 'tam', c4: 'ned', c5: 'ilse', c6: 'oyelaran',\n    c7: 'yusuf', c8: 'perpetua', c9: 'hollis', c10: 'percy', c11: 'clementine',\n  };\n\n  const DEF = E.Input.DEFAULT;\n  const INPUT = Object.assign({}, DEF, {\n    up: ['ArrowUp', 'Pad12'],\n    down: ['ArrowDown', 'Pad13'],\n    left: ['ArrowLeft', 'Pad14'],\n    right: ['ArrowRight', 'Pad15'],\n    useTool: ['Pad7', 'Pad0', 'Mouse0', 'Space'],\n    fine: ['Pad6', 'ShiftLeft', 'ShiftRight'],\n    gift: ['Pad3', 'KeyF', 'Mouse1'],\n    consult: ['Pad2', 'KeyC'],\n    toolPrev: ['Pad4', 'KeyQ', 'WheelUp'],\n    toolNext: ['Pad5', 'KeyE', 'WheelDown'],\n    wheelHold: ['Mouse2'],\n    curU: ['KeyW', 'ArrowUp'],\n    curD: ['KeyS', 'ArrowDown'],\n    curL: ['KeyA', 'ArrowLeft'],\n    curR: ['KeyD', 'ArrowRight'],\n    nudgeU: ['Pad12'],\n    nudgeD: ['Pad13'],\n    nudgeL: ['Pad14'],\n    nudgeR: ['Pad15'],\n    tool1: ['Digit1'], tool2: ['Digit2'], tool3: ['Digit3'], tool4: ['Digit4'],\n    tool5: ['Digit5'], tool6: ['Digit6'], tool7: ['Digit7'], tool8: ['Digit8'],\n    interact: ['Pad0', 'KeyE', 'Enter'],\n    skip: ['Pad2', 'ControlLeft'],\n    log: ['Pad3', 'KeyB'],\n    more: ['Pad3', 'KeyM'],\n  });\n\n  const SETTINGS = [\n    { key: 'music', value: 0.1 },\n    { key: 'glyphs', value: 'playstation', options: [['playstation', 'PlayStation'], ['xbox', 'Xbox']] },\n    { key: 'voices', label: 'Voices', type: 'slider', group: 'Sound', value: 0.9, min: 0, max: 1, step: 0.05, apply: (g, v) => { g.audio.voiceVolume = v; if (g.audio.applyVolume) g.audio.applyVolume(); } },\n    { key: 'difficulty', label: 'Difficulty', type: 'select', value: 'resident', options: [['intern', 'Intern'], ['resident', 'Resident'], ['attending', 'Attending']], apply: (g, v) => { RT.diff = v; } },\n    { key: 'assist', label: 'Surgical assist', type: 'slider', value: 0.6, min: 0, max: 1.4, step: 0.05, apply: (g, v) => { PREFS.assist = v; } },\n    { key: 'cursorSpeed', label: 'Cursor speed', type: 'slider', value: 330, min: 80, max: 500, step: 10, apply: (g, v) => { PREFS.cursor = v; } },\n    { key: 'swapSticks', label: 'Swap sticks', type: 'toggle', value: false, apply: (g, v) => { PREFS.swap = !!v; } },\n    { key: 'sustain', label: 'Sustained tools', type: 'select', value: 'hold', options: [['hold', 'Hold'], ['toggle', 'Toggle']], apply: (g, v) => { PREFS.sustain = v; } },\n    { key: 'hints', label: 'Hints', type: 'toggle', value: true, apply: (g, v) => { PREFS.hints = !!v; } },\n    { key: 'blood', label: 'Blood color', type: 'select', value: 'red', options: [['red', 'Red'], ['rose', 'Rose'], ['ink', 'Ink']], apply: (g, v) => { PREFS.blood = v; } },\n    { key: 'textSpeed', label: 'Text speed', type: 'slider', value: 1, min: 0.5, max: 3, step: 0.25, apply: (g, v) => { PREFS.text = v; } },\n  ];\n\n  const CONTROLS = {\n    useTool: 'Use tool', fine: 'Steady hand', gift: 'The Steady', consult: 'Consult',\n    toolPrev: 'Previous tool', toolNext: 'Next tool', wheelHold: 'Tool wheel',\n    interact: 'Talk or use', more: 'Ask for more time',\n    tool1: false, tool2: false, tool3: false, tool4: false, tool5: false, tool6: false, tool7: false, tool8: false,\n  };\n\n  const game = new E.Game({\n    canvas: 'screen',\n    id: TITLE,\n    res: [426, 240],\n    expand: true,\n    view: 'side',\n    touch: 'never',\n    draw: true,\n    live: inSession,\n    autoPause: !inSession,\n    corner: !inSession,\n    input: INPUT,\n    menu: {\n      quit: inSession ? false : 'title',\n      saves: true,\n      items: inSession ? [] : [['Dev Mode', () => GAME.openDev()]],\n      settings: SETTINGS,\n      controls: CONTROLS,\n    },\n  });\n  game.input.names = CONTROLS;\n\n  const ui = new E.Shell(game, {\n    tv: true,\n    theme: {\n      paper: 'rgba(6,22,26,.94)',\n      accent: '#5ff0e0',\n      line: 'rgba(95,240,224,.35)',\n      ink: '#e8fbf6',\n      muted: '#8fb8b0',\n      danger: '#ff7a6a',\n    },\n  });\n\n  GAME.openDev = () => {\n    if (inSession) return;\n    RT.devOpen = true;\n    RT.devTab = 0;\n    RT.devI = 0;\n    if (game.shell) game.shell.hide();\n  };\n\n  function origin() {\n    return [(game.W - CFG.FIELD_W) >> 1, (game.H - CFG.FIELD_H) >> 1];\n  }\n  function playTune() {\n    const t = CFG.cloneTune(GAME.TUNE);\n    t.hands.assist = PREFS.assist;\n    t.hands.cursor = PREFS.cursor;\n    return t;\n  }\n  function makeMenu(items, onPick, onCancel) {\n    return new E.Menu(game, items, {\n      scale: 2, rows: 6,\n      color: '#e8fbf6', pick: '#5ff0e0', dim: '#8fb8b0',\n      bg: '#06141a', border: '#5ff0e0',\n      onPick, onCancel,\n    });\n  }\n  function go(name, data) {\n    game.go(name, data, { fade: game.fadeTime });\n  }\n\n  const people = {};\n  for (const id in GAME.CAST) {\n    const c = GAME.CAST[id];\n    people[id] = {\n      name: c.name,\n      portrait: (g, x, y, size) => {\n        let expr = 'neutral';\n        if (story.running && story.node) {\n          const steps = story.nodes[story.node];\n          const line = steps && steps[story._i - 1];\n          if (line && line.who === id && line.expr) expr = line.expr;\n        }\n        GAME.Art.bust(g, id, { expr }, x, y, size || 40);\n      },\n    };\n  }\n  const story = new E.Story(game, {\n    people,\n    nodes: GAME.NODES,\n    on: {\n      op(st, step) {\n        RT.fromStory = true;\n        RT.redirect = true;\n        const id = step.caseId;\n        if (GAME.LIGHT[id] && RT.chartFor !== id) go('chart', { caseId: id });\n        else {\n          beginCase(id, { difficulty: RT.diff, seed: 3, fromStory: true });\n          go('op');\n        }\n      },\n      ward() {\n        RT.redirect = true;\n        go('ward');\n      },\n      credits() {\n        RT.redirect = true;\n        RT.creditPage = 0;\n        go('credits');\n      },\n    },\n  });\n  story.talk.voice = (ch) => { try { GAME.Audio.blip(ch); } catch (e) { /* quiet */ } };\n  story.talk.bg = '#06141a';\n  story.talk.border = '#5ff0e0';\n  story.talk.color = '#e8fbf6';\n  story.talk.nameColor = '#5ff0e0';\n\n  function beginCase(id, opts) {\n    opts = opts || {};\n    let def = GAME.CASES[id];\n    if (id === 'ferry' || (def && def.id === 'ferry')) def = GAME.roundsCase(opts.players || 1);\n    if (!def) return null;\n    RT.def = def;\n    RT.mode = opts.mode || def.mode || 'case';\n    if (opts.fromStory != null) RT.fromStory = opts.fromStory;\n    const S = GAME.Op.create(def, {\n      seed: opts.seed == null ? 3 : opts.seed,\n      difficulty: opts.difficulty || RT.diff || 'resident',\n      players: opts.players || 1,\n      phase: opts.phase || 0,\n    });\n    if (opts.clockDelta) S.clock += opts.clockDelta;\n    if (opts.steadyDelta) S.steady += opts.steadyDelta;\n    if (opts.cheat) S.cheat = Object.assign({}, S.cheat, opts.cheat);\n    RT.S = S;\n    RT.leftOp = false;\n    RT.fieldKey = '';\n    return S;\n  }\n  GAME.beginCase = beginCase;\n\n  function recordRank() {\n    const S = RT.S;\n    if (!S || !S.won || RT.attract || RT.cheatUsed || GAME.TUNE.dirty) return;\n    if (S.lab || S.mode === 'rounds' || S.id === 'lab' || S.id === 'ferry') return;\n    const ch = S.cheat || {};\n    if (ch.reveal || ch.infSteady || ch.lockVitals || ch.freezeClock || ch.oneHit) return;\n    RT.ranks[S.id] = S.rank;\n    RT.cleared[S.id] = true;\n    if (PERSON[S.id]) RT.saved[PERSON[S.id]] = true;\n    const def = GAME.CASES[S.id];\n    if (def && def.chapter) RT.chapter = def.chapter;\n  }\n\n  function resumeHeld() {\n    if (!(RT.fromStory && story._held)) return false;\n    RT.redirect = false;\n    story.resume();\n    if (!RT.redirect) go('story');\n    return true;\n  }\n\n  function leaveResults() {\n    if (resumeHeld()) return;\n    const S = RT.S;\n    if (S && (S.lab || S.id === 'lab')) { go('menu'); return; }\n    if (RT.mode === 'rounds' || (S && S.mode === 'rounds')) { go('lobby'); return; }\n    if (S && S.won && RT.fromStory) { go('ward'); return; }\n    go('menu');\n  }\n\n  function readLocal(p) {\n    const I = game.input;\n    const [ox, oy] = origin();\n    let digit = 0;\n    for (let n = 1; n <= 8; n++) if (I.pressed('tool' + n)) digit = n;\n    const tools = CFG.TOOLS;\n    const idx = Math.max(0, tools.indexOf(p.tool));\n    if (!digit && I.pressed('toolNext')) digit = (idx % 8) + 1 === idx + 1 ? ((idx + 1) % 8) + 1 : ((idx + 1) % 8) + 1;\n    if (!digit && I.pressed('toolNext')) digit = ((idx + 1) % 8) + 1;\n    if (I.pressed('toolPrev')) digit = ((idx + 7) % 8) + 1;\n    if (I.pressed('toolNext')) digit = ((idx + 1) % 8) + 1;\n    const devOpen = RT.devOpen;\n    const keys = devOpen ? [0, 0] : [\n      (I.down('curR') ? 1 : 0) - (I.down('curL') ? 1 : 0),\n      (I.down('curD') ? 1 : 0) - (I.down('curU') ? 1 : 0),\n    ];\n    const nudge = devOpen ? [0, 0] : [\n      (I.down('nudgeR') ? 1 : 0) - (I.down('nudgeL') ? 1 : 0),\n      (I.down('nudgeD') ? 1 : 0) - (I.down('nudgeU') ? 1 : 0),\n    ];\n    const swap = !!PREFS.swap;\n    const aim = (swap ? I.padMove : I.padAim) || [0, 0];\n    const move = (swap ? (I.padAim || [0, 0]) : (I.padMove || [0, 0]));\n    let mouse = null;\n    const ptr = I.pointer();\n    if (ptr && (I.lastDevice === 'mouse' || I._fedAt)) mouse = [ptr[0] - ox, ptr[1] - oy];\n    let trig = I.value('useTool') || 0;\n    if (PREFS.sustain === 'toggle') {\n      if (I.pressed('useTool')) RT.latched = !RT.latched;\n      trig = RT.latched ? 1 : 0;\n    }\n    const pan = I.pan();\n    if (!digit && I.down('wheelHold') && pan && Math.hypot(pan[0], pan[1]) > 8) {\n      move[0] += pan[0] / Math.max(8, Math.hypot(pan[0], pan[1]));\n      move[1] += pan[1] / Math.max(8, Math.hypot(pan[0], pan[1]));\n    }\n    return {\n      digit, mouse, aim, move, keys, nudge,\n      fine: I.down('fine'),\n      trig,\n      gift: I.down('gift'),\n      consult: I.down('consult'),\n      cancel: I.down('cancel'),\n    };\n  }\n\n  function drive(S, dt, opts) {\n    opts = opts || {};\n    const inputs = [];\n    const n = S.players.length;\n    for (let i = 0; i < n; i++) {\n      const p = S.players[i];\n      if (p.gone) { inputs.push({ tool: p.tool, trig: 0 }); continue; }\n      let dev;\n      if (opts.remote && opts.remote[i]) {\n        dev = opts.remote[i];\n      } else if (i === 0 && game.debug && game.debug.driver && !RT.attract) {\n        dev = game.debug.driver(S, dt) || GAME.Bot.device(S, 0, dt);\n      } else if (i === 0 && RT.auto && !RT.attract) {\n        dev = GAME.Bot.device(S, 0, dt);\n      } else if (i === 0 && !opts.bots && !RT.attract) {\n        dev = readLocal(p);\n      } else {\n        dev = GAME.Bot.device(S, i, dt);\n      }\n      GAME.Wheel.update(p, dev, dt);\n      const tune = playTune();\n      if (dev.mouse) GAME.Cursor.update(p, { mouse: dev.mouse, fine: dev.fine }, S, dt, tune);\n      else GAME.Cursor.update(p, { aim: dev.aim, keys: dev.keys, nudge: dev.nudge, fine: dev.fine }, S, dt, tune);\n      const row = {\n        tool: p.tool,\n        trig: dev.trig || 0,\n        fine: !!dev.fine,\n        gift: !!dev.gift,\n        consult: !!dev.consult,\n        cancel: !!dev.cancel,\n        mouse: !!dev.mouse,\n      };\n      if (dev.x != null) { row.x = dev.x; row.y = dev.y; }\n      inputs.push(row);\n    }\n    try { GAME.Op.step(S, inputs, dt, playTune()); }\n    catch (e) { game.fail('op', e); }\n    if (S.ev) for (const ev of S.ev) { try { GAME.Audio.onEv(ev); } catch (err) { /* quiet */ } }\n    return S;\n  }\n\n  function fieldOf(S) {\n    const key = (S.site || 'abdomen') + ':' + (S.seed || 1) + ':' + game.W + 'x' + game.H;\n    if (RT.fieldKey !== key) {\n      RT.field = GAME.Art.fieldFor(S.site || 'abdomen', S.seed || 1, game.W, game.H);\n      RT.fieldKey = key;\n    }\n    return RT.field;\n  }\n\n  const COL = {\n    shard: '#d5dee6', laceration: '#e05050', wound: '#c43030', bleeder: '#ff4040', arteryTear: '#ff2060',\n    pool: '#601828', polyp: '#e08898', mass: '#c06078', clot: '#682838', patch: '#e07070',\n    nerve: '#e2c14a', eloquent: '#f0d060', retractor: '#c8d0d4', bead: '#5ff0e0', nest: '#14383c',\n    lobe: '#7a5cff', eye: '#d0c8ff', tendril: '#3ec8b0', uvula: '#9a78ff', voice: '#5ff0e0', reed: '#8fd0c8',\n    repeat: '#f5b700', slur: '#9ad8d0', hook: '#d0d4d8', screw: '#e8e0c8', wire: '#f0d060', lead: '#88e0c8',\n    cut: '#f2f0e6', fed: '#401018', bite: '#e05050',\n  };\n  function bloodCol() {\n    if (PREFS.blood === 'rose') return '#e07098';\n    if (PREFS.blood === 'ink') return '#2a2030';\n    return null;\n  }\n\n  function drawOp(r, S, ribbon) {\n    const [ox, oy] = origin();\n    r.sky(['#071018', '#102028']);\n    const F = S ? fieldOf(S) : null;\n    const allow = (typeof document !== 'undefined') || GAME.Art.force;\n    if (allow && F) {\n      try { F.shade({ beat: ((S.t || 0) % 1), slow: !!S.breath, dim: S.dim || 0 }); }\n      catch (e) { /* painter */ }\n    }\n    r.overlay(g => {\n      const px = E.px;\n      if (F && F.cv && F.cv.width) { try { g.drawImage(F.cv, 0, 0); } catch (e) { /* no image */ } }\n      px.rect(g, 0, 0, r.W, Math.max(0, oy), '#102830');\n      px.rect(g, 0, oy + CFG.FIELD_H, r.W, Math.max(0, r.H - oy - CFG.FIELD_H), '#102830');\n      px.rect(g, 0, oy, Math.max(0, ox), CFG.FIELD_H, '#102830');\n      px.rect(g, ox + CFG.FIELD_W, oy, Math.max(0, r.W - ox - CFG.FIELD_W), CFG.FIELD_H, '#102830');\n      px.rect(g, ox + 8, oy + 8, CFG.FIELD_W - 16, CFG.FIELD_H - 16, '#0c2428');\n      if (!S) return;\n      const ink = bloodCol();\n      for (const o of S.objects) {\n        if (!o.alive && o.type !== 'retractor') continue;\n        if (o.hidden && !o.marked) continue;\n        const x = o.x + ox, y = o.y + oy;\n        let c = COL[o.type] || '#9ad0c8';\n        if (ink && (o.type === 'bleeder' || o.type === 'pool' || o.type === 'wound' || o.type === 'laceration' || o.type === 'arteryTear')) c = ink;\n        const rad = o.type === 'pool' ? 8 + (o.vol || 0) * 0.15 : o.type === 'mass' ? (o.rad || 12) : o.type === 'bead' ? 3 : 4;\n        if (o.guide && o.guide.length > 1 && (o.type === 'cut' || o.type === 'mass' || o.type === 'slur')) {\n          for (let k = 1; k < o.guide.length; k++) px.line(g, o.guide[k - 1][0] + ox, o.guide[k - 1][1] + oy, o.guide[k][0] + ox, o.guide[k][1] + oy, '#f2f0e6', 1);\n        }\n        px.disc(g, x, y, rad, o.done ? '#2a403c' : c);\n        if (o.marked) px.disc(g, x, y, rad + 3, '#5ff0e0');\n      }\n      if (S.breath) {\n        px.rect(g, ox + 20, oy + 16, CFG.FIELD_W - 40, 2, '#bfefff');\n        px.rect(g, ox + 20, oy + CFG.FIELD_H - 18, CFG.FIELD_W - 40, 2, '#bfefff');\n      }\n      for (const p of S.players) if (!p.gone) GAME.Art.drawHand(g, p, ox, oy);\n      const vit = Math.max(0, Math.ceil(S.vitals));\n      const clk = Math.max(0, Math.ceil(S.clock));\n      E.font.text(g, 'VIT ' + vit, 8, 6, vit < 30 ? '#ff7a6a' : '#e8fbf6', { scale: 2, outline: '#06141a' });\n      E.font.text(g, 'CLK ' + clk, 8, 26, clk < 20 ? '#ff7a6a' : '#e8fbf6', { scale: 2, outline: '#06141a' });\n      E.font.text(g, (S.phaseName || '') + '  ' + (S.activeDoc || ''), 8, 48, '#8fb8b0', { outline: '#06141a' });\n      const tool = (S.players[0] && S.players[0].tool) || 'forceps';\n      GAME.Art.toolIcon(g, tool, r.W - 28, r.H - 28, 1);\n      E.font.text(g, tool.toUpperCase(), r.W - 8, r.H - 36, '#e8fbf6', { align: 'right', outline: '#06141a' });\n      if (PREFS.hints) E.font.text(g, game.input.label('useTool'), r.W - 8, r.H - 14, '#5ff0e0', { align: 'right', outline: false });\n      const steady = Math.round(S.steady || 0);\n      E.font.text(g, 'STEADY ' + steady, 8, r.H - 16, '#5ff0e0', { outline: '#06141a' });\n      if (S.codeBlue) E.font.text(g, 'SHOCK', r.W / 2, 64, '#ff7a6a', { align: 'center', scale: 2, outline: '#06141a' });\n      if (S.dressing) E.font.text(g, 'DRESSING', r.W / 2, 64, '#f2f0e6', { align: 'center', scale: 2, outline: '#06141a' });\n      if (ribbon) E.font.text(g, 'DEMO', r.W - 8, 6, '#f5b700', { align: 'right', scale: 2, outline: '#06141a' });\n      if (GAME.TUNE.dirty || RT.cheatUsed) E.font.text(g, 'DEV', 8, 66, '#f5b700', { outline: '#06141a' });\n      if (S.t != null && GAME.BARKS && GAME.BARKS.length) {\n        const bark = GAME.BARKS[Math.floor(S.t / 4) % GAME.BARKS.length];\n        E.font.text(g, bark, r.W / 2, r.H - 28, '#d8e4dc', { align: 'center', outline: '#06141a' });\n      }\n      if (RT.devOpen) drawDev(g, r);\n    });\n  }\n\n  const CHEATS = [\n    ['reveal', 'Reveal'],\n    ['infSteady', 'Infinite Steady'],\n    ['lockVitals', 'Lock vitals'],\n    ['freezeClock', 'Freeze clock'],\n    ['oneHit', 'One hit'],\n    ['auto', 'Autosurgeon'],\n    ['slow', 'Slow motion'],\n    ['win', 'Clear phase'],\n    ['lose', 'Force a loss'],\n    ['code', 'Vitals to zero'],\n  ];\n  const SLOW = [0.25, 0.5, 1, 2];\n\n  function devRows() {\n    if (RT.devTab === 1) return CHEATS.map(c => c[1]);\n    if (RT.devTab === 2) {\n      const rows = [];\n      for (const id of GAME.ORDER) {\n        const def = GAME.CASES[id];\n        const n = (def.phases || []).length;\n        for (let p = 0; p < n; p++) rows.push(id + ' ' + (def.phases[p].name || p));\n      }\n      rows.push('Grand Rounds');\n      rows.push('Skills Lab');\n      return rows;\n    }\n    return GAME.Dev.KEYS.map(k => k[0]).concat(['Reset tuning']);\n  }\n\n  function devAct(dir) {\n    RT.cheatUsed = RT.devTab !== 0 || RT.cheatUsed;\n    const S = RT.S;\n    if (RT.devTab === 0) {\n      const keys = GAME.Dev.KEYS;\n      if (RT.devI >= keys.length) { if (dir === 0) GAME.Dev.reset(); return; }\n      const [path, lo, hi] = keys[RT.devI];\n      const [g, k] = path.split('.');\n      const step = (hi - lo) / 20;\n      const cur = GAME.TUNE[g][k];\n      const v = Math.max(lo, Math.min(hi, Math.round((cur + dir * step) * 1000) / 1000));\n      GAME.Dev.set(path, v);\n      return;\n    }\n    if (dir !== 0 && RT.devTab !== 1) return;\n    if (RT.devTab === 1 && dir === 0) {\n      const key = CHEATS[RT.devI][0];\n      if (key === 'auto') { RT.auto = !RT.auto; RT.cheatUsed = true; return; }\n      if (key === 'slow') {\n        const i = SLOW.indexOf(game.timeScale);\n        game.timeScale = SLOW[(i + 1) % SLOW.length] || 1;\n        RT.cheatUsed = true;\n        return;\n      }\n      if (key === 'win' && S) {\n        RT.cheatUsed = true;\n        for (const o of S.objects) { o.done = true; o.prog = 1; }\n        S.hold = false;\n        return;\n      }\n      if (key === 'lose' && S) { RT.cheatUsed = true; GAME.Sim.lose(S, 'dev'); return; }\n      if (key === 'code' && S) { RT.cheatUsed = true; S.vitals = 0; return; }\n      if (S) {\n        S.cheat = S.cheat || {};\n        const on = !S.cheat[key];\n        GAME.Dev.cheat(S, key, on);\n        RT.cheatUsed = true;\n      }\n      return;\n    }\n    if (RT.devTab === 2 && dir === 0) {\n      const rows = devRows();\n      const label = rows[RT.devI] || '';\n      RT.cheatUsed = true;\n      if (label === 'Grand Rounds') { beginCase('ferry', { players: 1, fromStory: false }); go('op'); return; }\n      if (label === 'Skills Lab') { beginCase('lab', { fromStory: false }); go('op'); return; }\n      const id = label.slice(0, 3);\n      const def = GAME.CASES[id];\n      if (!def) return;\n      const name = label.slice(4);\n      let phase = 0;\n      (def.phases || []).forEach((ph, i) => { if ((ph.name || String(i)) === name) phase = i; });\n      beginCase(id, { phase, fromStory: false });\n      go('op');\n    }\n  }\n\n  function handleDev() {\n    if (!RT.devOpen || inSession) return false;\n    const I = game.input;\n    const rows = devRows();\n    if (I.pressed('cancel')) { RT.devOpen = false; I.consumeAll(); return true; }\n    if (I.pressed('toolPrev')) RT.devTab = (RT.devTab + 2) % 3;\n    if (I.pressed('toolNext')) RT.devTab = (RT.devTab + 1) % 3;\n    if (I.pressed('up')) RT.devI = (RT.devI + rows.length - 1) % rows.length;\n    if (I.pressed('down')) RT.devI = (RT.devI + 1) % rows.length;\n    if (RT.devI >= rows.length) RT.devI = 0;\n    if (I.pressed('left')) devAct(-1);\n    if (I.pressed('right') || I.pressed('confirm')) devAct(I.pressed('confirm') ? 0 : 1);\n    return true;\n  }\n\n  function drawDev(g, r) {\n    const px = E.px;\n    const rows = devRows();\n    const tabs = ['Tune', 'Cheats', 'Jump'];\n    px.rect(g, r.W - 168, 8, 160, r.H - 16, '#06141a');\n    E.font.text(g, tabs[RT.devTab], r.W - 160, 12, '#f5b700', { outline: false });\n    const first = Math.max(0, Math.min(RT.devI - 6, rows.length - 12));\n    for (let i = 0; i < 12 && first + i < rows.length; i++) {\n      const k = first + i;\n      const on = k === RT.devI;\n      E.font.text(g, (on ? '> ' : '  ') + rows[k], r.W - 160, 28 + i * 12, on ? '#5ff0e0' : '#8fb8b0', { outline: false });\n    }\n  }\n\n  function drawTitle(r, t) {\n    r.sky(['#071018', '#0e2430']);\n    r.overlay(g => {\n      GAME.Art.titleBackdrop(g, r.W, r.H, t || game.real || 0);\n      E.font.title(g, 'OPEN TABLE', r.W / 2, 28, { scale: 2, align: 'center', colors: ['#f4fff8', '#9aefe4', '#1c6e78'] });\n      E.font.text(g, TITLE, r.W / 2, 78, '#e8fbf6', { align: 'center', scale: 1, outline: '#06141a' });\n      E.font.text(g, \"Don't let it go quiet\", r.W / 2, 96, '#5ff0e0', { align: 'center', outline: false });\n      const y = 120;\n      let x = 24;\n      const beat = [0, 2, 0, 6, 0, 2, 8, 0, 1, 0, 4, 0];\n      for (let i = 0; i < beat.length; i++) {\n        const h = 2 + beat[i];\n        E.px.rect(g, x, y - h, 6, h, '#7CFFB2');\n        x += 10;\n      }\n      const prompt = game.input.label('confirm');\n      E.font.text(g, prompt, r.W / 2, r.H - 28, '#e8fbf6', { align: 'center', scale: 2, outline: '#06141a' });\n    });\n  }\n\n  function snapshot() {\n    const S = RT.S;\n    const [ox, oy] = origin();\n    let mark = null;\n    if (RT.light && RT.light.mark) mark = [ox + RT.light.mark[0], oy + RT.light.mark[1]];\n    const choice = !!(story.talk && story.talk.open && story.talk.choices && story.talk.choices.length && !story.talk.typing);\n    return {\n      scene: game.sceneName,\n      menu: RT.menu ? { i: RT.menu.i, labels: RT.menu.items.map(it => (typeof it === 'string' ? it : it.label)) } : null,\n      story: story.running ? story.node : null,\n      held: !!story._held,\n      choice,\n      op: S ? {\n        id: S.id, won: !!S.won, lost: !!S.lost, phase: S.phase, phaseName: S.phaseName,\n        clock: S.clock, vitals: S.vitals, score: S.score, rank: S.rank,\n        breath: !!S.breath, worldScale: S.worldScale, closed: !!S.closed,\n      } : null,\n      lightbox: mark,\n      ward: { patients: RT.visitors.slice(), nearDoor: !!RT.nearDoor },\n      attract: RT.attract ? { on: true, loops: RT.loops, seg: RT.seg } : null,\n      dev: { open: !!RT.devOpen, dirty: !!GAME.TUNE.dirty },\n      ranks: Object.assign({}, RT.ranks),\n      cleared: Object.assign({}, RT.cleared),\n      reel: RT.loops,\n    };\n  }\n\n  const REEL = [\n    { kind: 'story', t: 4 },\n    { kind: 'op', id: 'c1', t: 15, cheat: { lockVitals: true, freezeClock: true, oneHit: true } },\n    { kind: 'op', id: 'c3', t: 8, cheat: { lockVitals: true, freezeClock: true, oneHit: true } },\n    { kind: 'op', id: 'c6', t: 8, cheat: { lockVitals: true, freezeClock: true, oneHit: true } },\n    { kind: 'op', id: 'c7', t: 8, cheat: { lockVitals: true, freezeClock: true, infSteady: true } },\n    { kind: 'rounds', t: 8 },\n    { kind: 'op', id: 'c11', t: 8, cheat: { lockVitals: true, freezeClock: true, oneHit: true } },\n    { kind: 'card', t: 4 },\n    { kind: 'title', t: 8 },\n  ];\n\n  function startSegment() {\n    const seg = REEL[RT.seg];\n    RT.segT = 0;\n    if (seg.kind === 'op') {\n      const S = beginCase(seg.id, { fromStory: false, cheat: seg.cheat, seed: 3 });\n      if (S) S.mode = 'attract';\n      game.setView('overhead');\n    } else if (seg.kind === 'rounds') {\n      const S = beginCase('ferry', { players: 4, fromStory: false, cheat: { lockVitals: true, freezeClock: true, oneHit: true } });\n      if (S) S.mode = 'attract';\n      game.setView('overhead');\n    } else if (seg.kind === 'story') {\n      game.setView('side');\n      if (!RT.reelStory) {\n        RT.reelStory = new E.Story(game, {\n          people,\n          nodes: { beat: [GAME.NODES.start[0]] },\n          on: {},\n        });\n      }\n      RT.reelStory.skip = true;\n      RT.reelStory.run('beat');\n    } else game.setView('side');\n  }\n\n  const H = {\n    info: null,\n    phase: 'solo',\n    over: false,\n    accS: 0,\n    accI: 0,\n    snapN: 0,\n    inN: 0,\n    heard: 0,\n    hands: {},\n    view: null,\n    card: null,\n    local: -1,\n  };\n\n  function hubFinish() {\n    if (H.over || !H.info || !H.info.isHost) return;\n    H.over = true;\n    const info = H.info;\n    const S = RT.S;\n    const scoreOf = (id) => {\n      const idx = info.players.findIndex(q => q.id === id);\n      const p = S && S.players[idx];\n      return p ? (p.actions | 0) : 0;\n    };\n    const ids = info.players.map(q => q.id);\n    ids.sort((a, b) => scoreOf(b) - scoreOf(a));\n    const standings = [];\n    for (const id of ids) {\n      const last = standings[standings.length - 1];\n      if (last && scoreOf(last[0]) === scoreOf(id)) last.push(id);\n      else standings.push([id]);\n    }\n    const scores = {};\n    for (const id of ids) scores[id] = scoreOf(id);\n    const best = ids[0];\n    const detail = (scores[best] || 0) + ' clean actions';\n    const awards = best == null ? [] : [{ id: best, title: 'Steadiest Hand', detail: detail.slice(0, 40) }];\n    try { HUB.send({ t: 'over', n: ++H.snapN }); } catch (e) { /* late */ }\n    HUB.finish({\n      standings,\n      scores,\n      won: !!(S && S.closed),\n      awards,\n      stats: { clock: S ? Math.round(S.clock) : 0, vitals: S ? Math.round(S.vitals) : 0 },\n    });\n  }\n\n  const TYPE_N = {};\n  ['shard', 'laceration', 'wound', 'bleeder', 'arteryTear', 'pool', 'polyp', 'mass', 'clot', 'bead', 'nest', 'lobe', 'eye', 'tendril', 'voice', 'repeat', 'retractor'].forEach((t, i) => { TYPE_N[t] = i + 1; });\n\n  function sendSnap() {\n    const S = RT.S;\n    const info = H.info;\n    if (!S || !info) return;\n    const objs = [];\n    for (const o of S.objects) {\n      if (objs.length >= 28) break;\n      if (o.done && o.type !== 'retractor') continue;\n      let flags = (o.done ? 1 : 0) | (o.hidden ? 2 : 0) | (o.marked ? 4 : 0) | (o.alive ? 8 : 0);\n      objs.push([o.id, o.x | 0, o.y | 0, TYPE_N[o.type] || 0, flags]);\n    }\n    const ps = info.players.map((q, i) => {\n      const p = S.players[i];\n      if (!p) return [q.id, 0, 0, 0, 0, 0, 1];\n      const tool = Math.max(0, CFG.TOOLS.indexOf(p.tool));\n      return [q.id, p.x | 0, p.y | 0, tool, p.trig > 0.3 ? 1 : 0, p.actions | 0, p.gone ? 1 : 0];\n    });\n    HUB.send({\n      t: 's', n: ++H.snapN,\n      clock: S.clock | 0, vitals: S.vitals | 0, phase: S.phase | 0,\n      won: S.won ? 1 : 0, closed: S.closed ? 1 : 0, breath: S.breath ? 1 : 0,\n      o: objs, p: ps,\n    }, { reliable: false });\n  }\n\n  function applyHands() {\n    const remote = {};\n    const info = H.info;\n    if (!info) return remote;\n    for (const key in H.hands) {\n      const i = +key;\n      const hnd = H.hands[key];\n      if (!hnd) continue;\n      remote[i] = { x: hnd.x, y: hnd.y, trig: hnd.trig || 0, digit: hnd.digit || 0, aim: [0, 0], mouse: null };\n    }\n    return remote;\n  }\n\n  async function connect() {\n    if (!HUB || !HUB.active) { H.phase = 'solo'; return; }\n    let info = null;\n    try { info = await HUB.connect({ mode: 'shared-world', seats: [1, 4], card: true }); }\n    catch (e) { H.phase = 'solo'; return; }\n    if (!info) { H.phase = 'solo'; return; }\n    H.info = info;\n    H.phase = 'wait';\n    H.local = info.players.findIndex(q => q.id === info.me);\n    HUB.on('card', c => { H.card = c; });\n    HUB.on('start', () => { H.phase = 'count'; });\n    HUB.on('message', (d, from) => {\n      if (!d) return;\n      if (info.isHost) {\n        if (d.t === 'i') {\n          const idx = info.players.findIndex(q => q.id === from);\n          if (idx >= 0) H.hands[idx] = { x: d.x, y: d.y, trig: d.trig || 0, digit: d.digit || 0, n: d.n || 0 };\n        }\n      } else if (from === info.host && d.t === 's' && d.n > H.heard) {\n        H.heard = d.n;\n        H.view = d;\n      }\n    });\n    HUB.on('leave', ({ id }) => {\n      const idx = info.players.findIndex(q => q.id === id);\n      if (RT.S && RT.S.players[idx]) RT.S.players[idx].gone = true;\n    });\n    HUB.on('time-up', () => { if (info.isHost) hubFinish(); });\n    HUB.on('end', () => { H.phase = 'over'; try { game.audio.music(null); game.audio.mute(true); } catch (e) { /* quiet */ } });\n    if (info.isHost) {\n      const rng = HUB.rng('sim');\n      const seed = ((rng() * 0x7fffffff) >>> 0) || 1;\n      const n = Math.max(1, Math.min(4, info.players.length || 1));\n      beginCase('ferry', { players: n, seed, fromStory: false, mode: 'rounds' });\n    }\n    HUB.ready();\n  }\n\n  function stickHot(I) {\n    const a = I.padAim, m = I.padMove;\n    return (a && Math.hypot(a[0], a[1]) > 0.25) || (m && Math.hypot(m[0], m[1]) > 0.25);\n  }\n\n  game.hook('input', (dt) => {\n    const I = game.input;\n    if (RT.suppress > 0) { RT.suppress--; I.consumeAll(); return; }\n    if (!RT.mouseInit) { RT.mouseInit = true; RT.mouseT = I.mouse ? I.mouse.t : 0; }\n    let mouseMoved = false;\n    if (I.mouse && I.mouse.t !== RT.mouseT) { mouseMoved = true; RT.mouseT = I.mouse.t; }\n    const scene = game.sceneName;\n    if (scene === 'attract') {\n      const hit = I.anyPressed() || I.clicked() || stickHot(I) || mouseMoved || (I.held && I.held.size > 0);\n      if (hit) {\n        RT.attract = false;\n        RT.idle = 0;\n        go('title');\n        I.consumeAll();\n        RT.suppress = 1;\n      }\n      return;\n    }\n    const watch = scene === 'title' || scene === 'menu' || scene === 'casefiles' || scene === 'lobby';\n    const shellUp = !!(game.shell && game.shell.screen);\n    if (!watch || shellUp || game.paused || inSession) { RT.idle = 0; return; }\n    let active = I.anyPressed() || !!I.clicked() || stickHot(I) || mouseMoved;\n    if (I.held && I.held.size > 0) active = true;\n    if (active) RT.idle = 0;\n    else RT.idle += dt;\n    if (RT.idle >= 10) {\n      RT.idle = 0;\n      RT.attract = true;\n      RT.seg = 0;\n      RT.loops = RT.loops || 0;\n      go('attract');\n    }\n  });\n\n  game.hook('enter', (name) => {\n    const song = {\n      title: 'night', menu: 'night', difficulty: 'night', casefiles: 'night', about: 'night',\n      story: 'night', chart: 'night', op: 'theatre', results: 'ward', ward: 'ward',\n      credits: 'end', lobby: 'night', lab: 'theatre', attract: 'hush', hub: 'theatre',\n    }[name] || 'night';\n    try { GAME.Audio.play(song); } catch (e) { /* quiet */ }\n  });\n\n  const CAM = { zoom: false, wheel: false };\n\n  const scenes = {\n    title: {\n      view: 'side', camera: CAM,\n      enter() { RT.menu = null; RT.attract = false; },\n      update() {\n        const I = game.input;\n        if (I.pressed('confirm') || I.pressed('start')) go('menu');\n      },\n      draw(r) { drawTitle(r, game.real); },\n    },\n    menu: {\n      view: 'side', camera: CAM,\n      enter() {\n        RT.menu = makeMenu(['New Game', 'Case Files', 'Grand Rounds', 'Skills Lab', 'About'], (i, label) => {\n          if (label === 'New Game') {\n            story.stop();\n            RT.saved = {}; RT.ranks = {}; RT.cleared = {}; RT.chapter = 1; RT.chartFor = null;\n            RT.fromStory = true; RT.pending = 'story'; RT.cheatUsed = false;\n            go('difficulty');\n          } else if (label === 'Case Files') go('casefiles');\n          else if (label === 'Grand Rounds') go('lobby');\n          else if (label === 'Skills Lab') { RT.pending = 'lab'; RT.fromStory = false; go('difficulty'); }\n          else if (label === 'About') go('about');\n        }, () => go('title'));\n      },\n      update() { if (RT.menu) RT.menu.update(); },\n      draw(r) {\n        drawTitle(r, game.real * 0.2);\n        if (RT.menu) RT.menu.draw(r);\n      },\n    },\n    difficulty: {\n      view: 'side', camera: CAM,\n      enter() {\n        const items = ['Intern', 'Resident', 'Attending'];\n        RT.menu = makeMenu(items, (i) => {\n          RT.diff = ['intern', 'resident', 'attending'][i];\n          if (game.settings && game.settings.set) { try { game.settings.set('difficulty', RT.diff); } catch (e) { /* pref */ } }\n          if (RT.pending === 'lab') { beginCase('lab', { difficulty: RT.diff, fromStory: false }); go('op'); }\n          else if (RT.pending === 'file') { beginCase(RT.fileCase, { difficulty: RT.diff, fromStory: false }); go('op'); }\n          else go('story');\n        }, () => go('menu'));\n        RT.menu.i = 0;\n      },\n      update() { if (RT.menu) RT.menu.update(); },\n      draw(r) {\n        r.sky(['#071018', '#102028']);\n        r.overlay(g => {\n          GAME.Art.stage(g, 'office', r.W, r.H, game.real);\n          E.font.text(g, 'DIFFICULTY', r.W / 2, 16, '#5ff0e0', { align: 'center', scale: 2, outline: '#06141a' });\n        });\n        if (RT.menu) RT.menu.draw(r);\n      },\n    },\n    casefiles: {\n      view: 'side', camera: CAM,\n      enter() {\n        const items = GAME.ORDER.map(id => {\n          const def = GAME.CASES[id];\n          const rank = RT.ranks[id] ? '  ' + RT.ranks[id] : '';\n          return (def.name || id) + rank;\n        });\n        RT.menu = makeMenu(items, (i) => {\n          RT.fileCase = GAME.ORDER[i];\n          RT.pending = 'file';\n          RT.fromStory = false;\n          go('difficulty');\n        }, () => go('menu'));\n      },\n      update() { if (RT.menu) RT.menu.update(); },\n      draw(r) {\n        r.sky(['#071018', '#102028']);\n        r.overlay(g => E.font.text(g, 'CASE FILES', r.W / 2, 12, '#5ff0e0', { align: 'center', scale: 2, outline: '#06141a' }));\n        if (RT.menu) RT.menu.draw(r);\n      },\n    },\n    lobby: {\n      view: 'side', camera: CAM,\n      enter() {\n        RT.menu = makeMenu(['1 surgeon', '2 surgeons', '3 surgeons', '4 surgeons'], (i) => {\n          RT.lobbyN = i + 1;\n          beginCase('ferry', { players: RT.lobbyN, fromStory: false, mode: 'rounds' });\n          go('op');\n        }, () => go('menu'));\n      },\n      update() { if (RT.menu) RT.menu.update(); },\n      draw(r) {\n        r.sky(['#071018', '#102028']);\n        r.overlay(g => {\n          E.font.text(g, 'GRAND ROUNDS', r.W / 2, 16, '#5ff0e0', { align: 'center', scale: 2, outline: '#06141a' });\n          E.font.text(g, 'One patient. Shared hands.', r.W / 2, 40, '#8fb8b0', { align: 'center', outline: false });\n        });\n        if (RT.menu) RT.menu.draw(r);\n      },\n    },\n    story: {\n      view: 'side', camera: CAM,\n      enter() {\n        if (!story.running && !story._held) {\n          story.skip = !!(game.debug && game.debug.skipStory);\n          story.run('start');\n        }\n      },\n      update(dt) {\n        const I = game.input;\n        if (I.down('skip') || (game.debug && game.debug.skipStory)) {\n          story.skip = true;\n          story.talk.speed = 1e6;\n        } else story.talk.speed = PREFS.text || 1;\n        if (I.pressed('log')) RT.logOpen = !RT.logOpen;\n        if (!story.running && !story._held) { go('title'); return; }\n        story.update(dt);\n      },\n      draw(r) {\n        const stage = RT.chapter >= 4 ? 'chapel' : RT.chapter === 3 ? 'harbor' : RT.chapter === 2 ? 'office' : 'theatre';\n        r.sky(['#071018', '#102028']);\n        r.overlay(g => GAME.Art.stage(g, stage, r.W, r.H, game.real));\n        story.draw(r);\n        if (RT.logOpen) r.overlay(g => {\n          E.px.rect(g, 8, 8, r.W - 16, 70, '#06141a');\n          const lines = story.log.slice(-4);\n          lines.forEach((ln, i) => E.font.text(g, (ln.name ? ln.name + ': ' : '') + ln.text, 12, 12 + i * 14, '#e8fbf6', { outline: false }));\n        });\n      },\n    },\n    chart: {\n      view: 'overhead', camera: CAM,\n      enter(data) {\n        const id = data && data.caseId;\n        RT.chartCase = id;\n        RT.light = GAME.LIGHT[id] || null;\n        RT.miss = 0;\n      },\n      update() {\n        const I = game.input;\n        const light = RT.light;\n        if (!light) {\n          beginCase(RT.chartCase, { fromStory: true, seed: 3 });\n          go('op');\n          return;\n        }\n        const c = I.clicked();\n        if (!c) return;\n        const [ox, oy] = origin();\n        const mx = ox + light.mark[0], my = oy + light.mark[1];\n        const d = Math.hypot(c[0] - mx, c[1] - my);\n        if (d <= 14) {\n          RT.chartFor = RT.chartCase;\n          const S = beginCase(RT.chartCase, { fromStory: true, seed: 3 });\n          if (S) { S.clock += 20; S.steady += 20; }\n          go('op');\n        } else {\n          RT.miss += 1;\n          if (RT.miss >= 3) {\n            RT.chartFor = RT.chartCase;\n            const S = beginCase(RT.chartCase, { fromStory: true, seed: 3 });\n            if (S) S.clock -= 10 * RT.miss;\n            go('op');\n          }\n        }\n      },\n      draw(r) {\n        r.sky(['#0c1418', '#183028']);\n        r.overlay(g => {\n          GAME.Art.stage(g, 'office', r.W, r.H, 0);\n          const light = RT.light;\n          E.font.text(g, 'SECOND OPINION', r.W / 2, 12, '#5ff0e0', { align: 'center', scale: 2, outline: '#06141a' });\n          if (!light) return;\n          const text = light.text || '';\n          E.font.text(g, text, r.W / 2, 36, '#e8fbf6', { align: 'center', outline: '#06141a', wrap: r.W - 40 });\n          const [ox, oy] = origin();\n          const mx = ox + light.mark[0], my = oy + light.mark[1];\n          E.px.rect(g, mx - 6, my - 1, 12, 2, '#f5b700');\n          E.px.rect(g, mx - 1, my - 6, 2, 12, '#f5b700');\n          E.font.text(g, 'Misses ' + RT.miss, 8, r.H - 16, '#8fb8b0', { outline: false });\n        });\n      },\n    },\n    op: {\n      view: 'overhead', camera: CAM, pausable: true,\n      enter() { game.setView('overhead'); },\n      update(dt) {\n        const S = RT.S;\n        if (!S) { go('menu'); return; }\n        handleDev();\n        game.focus(game.W / 2, game.H / 2, 0);\n        const fast = game.debug && game.debug.driver && !RT.attract;\n        if (fast) {\n          for (let k = 0; k < 16; k++) drive(S, 1 / 45);\n        } else drive(S, dt);\n        if ((S.won || S.lost) && !RT.leftOp) {\n          RT.leftOp = true;\n          if (!RT.attract) go('results');\n        }\n      },\n      draw(r) { game.focus(game.W / 2, game.H / 2, 0); drawOp(r, RT.S, false); },\n    },\n    results: {\n      view: 'side', camera: CAM,\n      enter() {\n        recordRank();\n        const S = RT.S;\n        const items = S && S.lost ? ['Retry', 'Give up'] : ['Continue'];\n        RT.menu = makeMenu(items, (i, label) => {\n          if (label === 'Retry' && RT.S) {\n            GAME.Op.retryPhase(RT.S);\n            RT.leftOp = false;\n            go('op');\n            return;\n          }\n          leaveResults();\n        });\n      },\n      update() { if (RT.menu) RT.menu.update(); },\n      draw(r) {\n        const S = RT.S;\n        r.sky(['#071018', '#102028']);\n        r.overlay(g => {\n          GAME.Art.stage(g, 'theatre', r.W, r.H, 0);\n          const head = S && S.won ? 'CLOSED' : 'LOST';\n          E.font.text(g, head, r.W / 2, 16, S && S.won ? '#5ff0e0' : '#ff7a6a', { align: 'center', scale: 2, outline: '#06141a' });\n          if (S) {\n            const tag = (GAME.TUNE.dirty || RT.cheatUsed) ? 'DEV' : (S.rank || '');\n            E.font.text(g, tag + '   ' + Math.round(S.score || 0), r.W / 2, 42, '#e8fbf6', { align: 'center', scale: 2, outline: '#06141a' });\n            E.font.text(g, 'Vitals ' + Math.round(S.vitals) + '   Clock ' + Math.round(S.clock), r.W / 2, 66, '#8fb8b0', { align: 'center', outline: false });\n          }\n        });\n        if (RT.menu) RT.menu.draw(r);\n      },\n    },\n    ward: {\n      view: 'threequarter', camera: CAM, pausable: true,\n      enter() {\n        game.saves.canSave = true;\n        try { game.saves.autosave(); } catch (e) { /* visit only */ }\n        const W = game.W, H = game.H;\n        RT.door = { x: (W / 2) | 0, y: H - 36 };\n        RT.hero = { x: RT.door.x - 18, y: RT.door.y, tx: null, ty: null };\n        const list = (GAME.WARD[RT.chapter] || GAME.WARD[1] || []).filter(id => RT.saved[id]);\n        RT.visitors = list.map((id, i) => ({ id, x: 36 + i * 40, y: 70 }));\n        RT.nearDoor = true;\n        RT.line = '';\n      },\n      exit() { game.saves.canSave = false; },\n      update(dt) {\n        if (handleDev()) {\n          /* panel owns the arrows; walking still uses the letter keys below when the panel is shut */\n        }\n        const I = game.input;\n        const h = RT.hero;\n        if (!RT.devOpen) {\n          let ax = 0, ay = 0;\n          const m = I.move();\n          ax += m[0]; ay += m[1];\n          if (I.held && I.held.has('KeyA')) ax -= 1;\n          if (I.held && I.held.has('KeyD')) ax += 1;\n          if (I.held && I.held.has('KeyW')) ay -= 1;\n          if (I.held && I.held.has('KeyS')) ay += 1;\n          const c = I.clicked();\n          if (c) { h.tx = c[0]; h.ty = c[1]; }\n          if (ax || ay) {\n            const L = Math.hypot(ax, ay) || 1;\n            h.x += (ax / L) * 80 * dt;\n            h.y += (ay / L) * 80 * dt;\n            h.tx = null;\n          } else if (h.tx != null) {\n            const dx = h.tx - h.x, dy = h.ty - h.y, d = Math.hypot(dx, dy);\n            if (d < 2) h.tx = null;\n            else { h.x += dx / d * Math.min(d, 80 * dt); h.y += dy / d * Math.min(d, 80 * dt); }\n          }\n          h.x = Math.max(12, Math.min(game.W - 12, h.x));\n          h.y = Math.max(28, Math.min(game.H - 16, h.y));\n        }\n        const doorD = Math.hypot(h.x - RT.door.x, h.y - RT.door.y);\n        RT.nearDoor = doorD <= 36;\n        if (RT.lineT > 0) RT.lineT -= dt;\n        if (!RT.devOpen && (I.pressed('confirm') || I.pressed('interact'))) {\n          if (RT.nearDoor) {\n            if (!resumeHeld()) go('menu');\n            return;\n          }\n          for (const v of RT.visitors) {\n            if (Math.hypot(h.x - v.x, h.y - v.y) < 28) {\n              const p = GAME.PEOPLE[v.id];\n              RT.line = p ? p.name + ': ' + p.line : '';\n              RT.lineT = 4;\n            }\n          }\n        }\n      },\n      draw(r) {\n        game.focus(r.W / 2, r.H / 2, 0);\n        r.sky(['#0c1814', '#163028']);\n        r.overlay(g => {\n          const px = E.px;\n          GAME.Art.stage(g, 'theatre', r.W, r.H, game.real);\n          px.rect(g, RT.door.x - 10, RT.door.y - 16, 20, 28, '#c8a45a');\n          px.rect(g, RT.door.x - 2, RT.door.y - 2, 3, 3, '#f0e2b0');\n          for (const v of RT.visitors) GAME.Art.bust(g, v.id, { expr: 'smile' }, v.x - 16, v.y - 28, 36);\n          px.disc(g, RT.hero.x, RT.hero.y, 5, '#e8443a');\n          E.font.text(g, 'WARD', 8, 8, '#5ff0e0', { scale: 2, outline: '#06141a' });\n          if (RT.nearDoor) E.font.text(g, game.input.label('interact'), RT.door.x, RT.door.y - 22, '#e8fbf6', { align: 'center', outline: '#06141a' });\n          if (RT.line && RT.lineT > 0) E.font.text(g, RT.line, r.W / 2, r.H - 28, '#e8fbf6', { align: 'center', outline: '#06141a', wrap: r.W - 24 });\n          if (RT.devOpen) drawDev(g, r);\n        });\n      },\n    },\n    credits: {\n      view: 'side', camera: CAM,\n      enter() { RT.creditPage = 0; },\n      update() {\n        const I = game.input;\n        const pages = creditPages();\n        if (I.pressed('confirm') || I.pressed('right') || I.pressed('start')) {\n          RT.creditPage += 1;\n          if (RT.creditPage >= pages.length) {\n            RT.redirect = false;\n            if (story._held) story.resume();\n            if (!RT.redirect) go('story');\n          }\n        } else if (I.pressed('left') && RT.creditPage > 0) RT.creditPage -= 1;\n      },\n      draw(r) {\n        const pages = creditPages();\n        const page = pages[Math.min(RT.creditPage, pages.length - 1)];\n        r.sky(['#070c14', '#142028']);\n        r.overlay(g => {\n          GAME.Art.stage(g, 'harbor', r.W, r.H, game.real);\n          E.font.text(g, page.title, r.W / 2, 16, '#5ff0e0', { align: 'center', scale: 2, outline: '#06141a' });\n          const body = page.body || '';\n          E.font.text(g, body, 16, 44, '#e8fbf6', { outline: '#06141a', wrap: r.W - 32 });\n          E.font.text(g, game.input.label('confirm'), r.W - 8, r.H - 14, '#8fb8b0', { align: 'right', outline: false });\n        });\n      },\n    },\n    about: {\n      view: 'side', camera: CAM,\n      enter() { RT.creditPage = 0; },\n      update() {\n        const I = game.input;\n        const pages = aboutPages();\n        if (I.pressed('cancel')) { go('menu'); return; }\n        if (I.pressed('confirm') || I.pressed('right')) {\n          RT.creditPage = Math.min(pages.length - 1, RT.creditPage + 1);\n        } else if (I.pressed('left') && RT.creditPage > 0) RT.creditPage -= 1;\n      },\n      draw(r) {\n        const pages = aboutPages();\n        const page = pages[RT.creditPage] || pages[0];\n        r.sky(['#071018', '#102028']);\n        r.overlay(g => {\n          E.font.text(g, page.title, 12, 8, '#5ff0e0', { scale: 2, outline: '#06141a' });\n          E.font.text(g, page.body, 12, 32, '#e8fbf6', { outline: '#06141a', wrap: r.W - 24 });\n        });\n      },\n    },\n    attract: {\n      view: 'side', camera: CAM,\n      enter() {\n        RT.attract = true;\n        RT.seg = 0;\n        startSegment();\n      },\n      exit() { RT.attract = false; },\n      update(dt) {\n        const seg = REEL[RT.seg];\n        RT.segT += dt;\n        if (seg.kind === 'story' && RT.reelStory) RT.reelStory.update(dt);\n        if ((seg.kind === 'op' || seg.kind === 'rounds') && RT.S && !RT.S.won && !RT.S.lost) {\n          game.focus(game.W / 2, game.H / 2, 0);\n          drive(RT.S, dt, { bots: true });\n        }\n        if (RT.segT >= seg.t) {\n          RT.seg += 1;\n          if (RT.seg >= REEL.length) { RT.seg = 0; RT.loops += 1; }\n          startSegment();\n        }\n      },\n      draw(r) {\n        const seg = REEL[RT.seg];\n        if (seg.kind === 'title') drawTitle(r, game.real);\n        else if (seg.kind === 'card') {\n          r.sky(['#071018', '#102028']);\n          r.overlay(g => {\n            E.font.text(g, 'DEMO', r.W / 2, 40, '#f5b700', { align: 'center', scale: 2, outline: '#06141a' });\n            E.font.text(g, TITLE, r.W / 2, 70, '#e8fbf6', { align: 'center', outline: '#06141a' });\n          });\n        } else if (seg.kind === 'story') {\n          r.sky(['#071018', '#102028']);\n          r.overlay(g => {\n            GAME.Art.stage(g, 'theatre', r.W, r.H, game.real);\n            E.font.text(g, 'DEMO', 8, 8, '#f5b700', { scale: 2, outline: '#06141a' });\n          });\n          if (RT.reelStory) RT.reelStory.draw(r);\n        } else drawOp(r, RT.S, true);\n      },\n    },\n    hub: {\n      view: 'overhead', camera: CAM, pausable: true,\n      enter() { game.setView('overhead'); },\n      update(dt) {\n        const I = game.input;\n        const info = H.info;\n        if (!info) return;\n        const server = !!(info.server || HUB.server || H.local < 0);\n        if (H.phase === 'wait') {\n          if (I.pressed('confirm') || I.pressed('start')) HUB.answer('ready');\n          if (I.pressed('more')) HUB.answer('more');\n          const c = I.clicked();\n          if (c) HUB.answer(c[1] > game.H * 0.7 ? 'more' : 'ready');\n          return;\n        }\n        if (H.phase === 'count' && HUB.time() >= 0) H.phase = 'play';\n        if (H.phase !== 'play' || H.over) return;\n        const S = RT.S;\n        if (info.isHost && S) {\n          game.focus(game.W / 2, game.H / 2, 0);\n          const remote = applyHands();\n          if (!server && H.local >= 0) {\n            const mine = readLocal(S.players[H.local] || S.players[0]);\n            remote[H.local] = mine;\n          }\n          drive(S, dt, { remote, bots: true });\n          for (const key in remote) {\n            const i = +key;\n            const hnd = remote[i];\n            if (hnd && hnd.x != null && S.players[i]) {\n              /* host already applied x,y through the step */\n            }\n          }\n          H.accS += dt;\n          if (H.accS >= 1 / 12) { H.accS = 0; sendSnap(); }\n        } else if (!server) {\n          const p = { tool: 'forceps', x: 213, y: 150 };\n          const mine = readLocal(p);\n          H.accI += dt;\n          if (H.accI >= 1 / 15) {\n            H.accI = 0;\n            const ptr = mine.mouse || [p.x, p.y];\n            HUB.send({\n              t: 'i', n: ++H.inN,\n              x: Math.round(ptr[0]), y: Math.round(ptr[1]),\n              trig: mine.trig > 0.3 ? 1 : 0,\n              digit: mine.digit || 0,\n            }, { to: info.host, reliable: false });\n          }\n        }\n      },\n      draw(r) {\n        const info = H.info;\n        if (info && (info.server || HUB.server)) return;\n        if (H.phase === 'play' && RT.S && H.info && H.info.isHost) { drawOp(r, RT.S, false); return; }\n        r.sky(['#071018', '#14504a']);\n        r.overlay(g => {\n          E.font.text(g, TITLE, 8, 8, '#e8fbf6', { outline: false });\n          E.font.text(g, H.phase, 8, 22, '#5ff0e0', { outline: false });\n          const left = H.card && H.card.left != null ? Math.ceil(H.card.left / 1000) : '';\n          if (left !== '') E.font.text(g, String(left), 8, 36, '#f5b700', { outline: false });\n          E.font.text(g, game.input.label('confirm'), 8, r.H - 28, '#e8fbf6', { outline: false });\n          E.font.text(g, game.input.label('more'), 8, r.H - 16, '#8fb8b0', { outline: false });\n          if (info) {\n            info.players.forEach((q, i) => {\n              const col = CFG.SEAT[i] || q.color || '#e8443a';\n              E.px.disc(g, 20, 60 + i * 16, 4, col);\n              E.font.text(g, String(q.name || ('P' + (i + 1))).slice(0, 12), 30, 54 + i * 16, col, { outline: false });\n            });\n          }\n        });\n      },\n    },\n  };\n\n  function aboutPages() {\n    const A = GAME.ABOUT;\n    const order = GAME.About.ORDER;\n    const labels = GAME.About.LABELS;\n    const src = order.map(k => labels[k] + ': ' + A.sourceInformation[k]).join('\\n');\n    return [\n      { title: 'Source Information', body: src },\n      { title: 'Testing Feedback', body: A.testingFeedback.join('\\n') },\n      { title: 'Engine Feedback', body: A.engineFeedback.join('\\n') },\n      { title: 'Prompt Feedback', body: A.promptFeedback.join('\\n') },\n    ];\n  }\n  function creditPages() {\n    const cast = Object.keys(GAME.CAST).map(id => GAME.CAST[id].name + '  ' + GAME.CAST[id].role).join('\\n');\n    return [{ title: 'Open Table', body: cast }].concat(aboutPages(), [\n      { title: 'Incoming', body: 'A chart is on the night desk. The shift is over. The next one starts at seven.' },\n    ]);\n  }\n\n  game.saves.write = () => ({\n    data: {\n      ranks: RT.ranks, cleared: RT.cleared, saved: RT.saved, chapter: RT.chapter,\n      story: story.state(), diff: RT.diff,\n    },\n    place: 'St. Erasmus Harbor Hospital',\n    level: RT.chapter || 1,\n  });\n  game.saves.read = (save) => {\n    const d = save && save.data || {};\n    RT.ranks = d.ranks || {};\n    RT.cleared = d.cleared || {};\n    RT.saved = d.saved || {};\n    RT.chapter = d.chapter || 1;\n    RT.diff = d.diff || RT.diff;\n    if (d.story) story.restore(d.story);\n  };\n  game.saves.canSave = false;\n\n  game.debug = {\n    skipStory: false,\n    driver: null,\n    snapshot,\n  };\n  G.__ot = () => game.debug.snapshot();\n  G.__hubProbe = () => ({\n    phase: H.phase,\n    over: !!H.over,\n    host: !!(H.info && H.info.isHost),\n    scene: game.sceneName,\n    active: !!(HUB && HUB.active),\n    players: (RT.S && RT.S.players || []).map(p => ({ id: p.id, x: p.x, y: p.y, tool: p.tool, trig: p.trig, actions: p.actions })),\n    t: HUB && HUB.active ? HUB.time() : 0,\n  });\n  G.__hubInject = (x, y, trig) => {\n    if (!H.info) return;\n    if (H.info.isHost && RT.S) {\n      const idx = H.local >= 0 ? H.local : 0;\n      const p = RT.S.players[idx];\n      if (p) { p.x = x; p.y = y; p.bx = x; p.by = y; p.trig = trig || 0; }\n      return;\n    }\n    try {\n      HUB.send({ t: 'i', n: ++H.inN, x, y, trig: trig || 0, digit: 0 }, { to: H.info.host, reliable: true });\n    } catch (e) { /* not in a session */ }\n  };\n\n  if (typeof document !== 'undefined') document.title = TITLE;\n\n  try { GAME.Audio.install(game); } catch (e) { /* headless */ }\n  game.audio.sfxVolume = 1;\n  game.audio.voiceVolume = 0.9;\n  game.audio.volume = 0.7;\n  if (game.audio.musicVolume == null || game.audio.musicVolume > 0.2) game.audio.musicVolume = 0.1;\n  if (game.audio.applyVolume) game.audio.applyVolume();\n\n  game.start({\n    scene: inSession ? 'hub' : 'title',\n    scenes,\n  });\n  try { GAME.Audio.play(inSession ? 'theatre' : 'night'); } catch (e) { /* quiet */ }\n\n  if (inSession) connect();\n\n  GAME.Shell = { game, story, RT, snapshot, beginCase, people };\n})();\n","old_string":""}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":1868,"output_tokens":22943,"cache_read_input_tokens":161152,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"58f30030-11c3-4449-a932-c222365e8002"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-1e93bea0-c3d4-4bb7-86ca-432537efd70c-60","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"\",\"new_string\":\"/* Scenes, input, attract reel, dev panel, and the Hub table. The sim stays free of drawing. */\\n(() => {\\n  const G = typeof window !== 'undefined' ? window : globalThis;\\n  const GAME = (G.GAME ||= {});\\n  const E = G.My3D2dge;\\n  const HUB = G.AIHub || null;\\n  const inSession = !!(HUB && HUB.active);\\n  const CFG = GAME.CFG;\\n  const TITLE = CFG.GAME_TITLE;\\n\\n  const RT = {\\n    diff: 'resident',\\n    prefsReady: false,\\n    S: null,\\n    def: null,\\n    mode: 'case',\\n    fromStory: false,\\n    redirect: false,\\n    chartFor: null,\\n    chartCase: null,\\n    light: null,\\n    miss: 0,\\n    leftOp: false,\\n    fieldKey: '',\\n    field: null,\\n    menu: null,\\n    devOpen: false,\\n    devTab: 0,\\n    devI: 0,\\n    cheatUsed: false,\\n    attract: false,\\n    loops: 0,\\n    seg: 0,\\n    segT: 0,\\n    mouseInit: false,\\n    mouseT: 0,\\n    idle: 0,\\n    suppress: 0,\\n    ranks: {},\\n    cleared: {},\\n    saved: {},\\n    chapter: 1,\\n    visitors: [],\\n    nearDoor: false,\\n    hero: { x: 200, y: 160, tx: null, ty: null },\\n    door: { x: 210, y: 180 },\\n    line: '',\\n    lineT: 0,\\n    creditPage: 0,\\n    logOpen: false,\\n    latched: false,\\n    pending: 'story',\\n    fileCase: 'c1',\\n    lobbyN: 1,\\n  };\\n  const PREFS = {\\n    assist: 0.6,\\n    cursor: 330,\\n    swap: false,\\n    sustain: 'hold',\\n    hints: true,\\n    blood: 'red',\\n    text: 1,\\n  };\\n  GAME.PREFS = PREFS;\\n\\n  const PERSON = {\\n    c1: 'agnes', c2: 'slide', c3: 'tam', c4: 'ned', c5: 'ilse', c6: 'oyelaran',\\n    c7: 'yusuf', c8: 'perpetua', c9: 'hollis', c10: 'percy', c11: 'clementine',\\n  };\\n\\n  const DEF = E.Input.DEFAULT;\\n  const INPUT = Object.assign({}, DEF, {\\n    up: ['ArrowUp', 'Pad12'],\\n    down: ['ArrowDown', 'Pad13'],\\n    left: ['ArrowLeft', 'Pad14'],\\n    right: ['ArrowRight', 'Pad15'],\\n    useTool: ['Pad7', 'Pad0', 'Mouse0', 'Space'],\\n    fine: ['Pad6', 'ShiftLeft', 'ShiftRight'],\\n    gift: ['Pad3', 'KeyF', 'Mouse1'],\\n    consult: ['Pad2', 'KeyC'],\\n    toolPrev: ['Pad4', 'KeyQ', 'WheelUp'],\\n    toolNext: ['Pad5', 'KeyE', 'WheelDown'],\\n    wheelHold: ['Mouse2'],\\n    curU: ['KeyW', 'ArrowUp'],\\n    curD: ['KeyS', 'ArrowDown'],\\n    curL: ['KeyA', 'ArrowLeft'],\\n    curR: ['KeyD', 'ArrowRight'],\\n    nudgeU: ['Pad12'],\\n    nudgeD: ['Pad13'],\\n    nudgeL: ['Pad14'],\\n    nudgeR: ['Pad15'],\\n    tool1: ['Digit1'], tool2: ['Digit2'], tool3: ['Digit3'], tool4: ['Digit4'],\\n    tool5: ['Digit5'], tool6: ['Digit6'], tool7: ['Digit7'], tool8: ['Digit8'],\\n    interact: ['Pad0', 'KeyE', 'Enter'],\\n    skip: ['Pad2', 'ControlLeft'],\\n    log: ['Pad3', 'KeyB'],\\n    more: ['Pad3', 'KeyM'],\\n  });\\n\\n  const SETTINGS = [\\n    { key: 'music', value: 0.1 },\\n    { key: 'glyphs', value: 'playstation', options: [['playstation', 'PlayStation'], ['xbox', 'Xbox']] },\\n    { key: 'voices', label: 'Voices', type: 'slider', group: 'Sound', value: 0.9, min: 0, max: 1, step: 0.05, apply: (g, v) => { g.audio.voiceVolume = v; if (g.audio.applyVolume) g.audio.applyVolume(); } },\\n    { key: 'difficulty', label: 'Difficulty', type: 'select', value: 'resident', options: [['intern', 'Intern'], ['resident', 'Resident'], ['attending', 'Attending']], apply: (g, v) => { RT.diff = v; } },\\n    { key: 'assist', label: 'Surgical assist', type: 'slider', value: 0.6, min: 0, max: 1.4, step: 0.05, apply: (g, v) => { PREFS.assist = v; } },\\n    { key: 'cursorSpeed', label: 'Cursor speed', type: 'slider', value: 330, min: 80, max: 500, step: 10, apply: (g, v) => { PREFS.cursor = v; } },\\n    { key: 'swapSticks', label: 'Swap sticks', type: 'toggle', value: false, apply: (g, v) => { PREFS.swap = !!v; } },\\n    { key: 'sustain', label: 'Sustained tools', type: 'select', value: 'hold', options: [['hold', 'Hold'], ['toggle', 'Toggle']], apply: (g, v) => { PREFS.sustain = v; } },\\n    { key: 'hints', label: 'Hints', type: 'toggle', value: true, apply: (g, v) => { PREFS.hints = !!v; } },\\n    { key: 'blood', label: 'Blood color', type: 'select', value: 'red', options: [['red', 'Red'], ['rose', 'Rose'], ['ink', 'Ink']], apply: (g, v) => { PREFS.blood = v; } },\\n    { key: 'textSpeed', label: 'Text speed', type: 'slider', value: 1, min: 0.5, max: 3, step: 0.25, apply: (g, v) => { PREFS.text = v; } },\\n  ];\\n\\n  const CONTROLS = {\\n    useTool: 'Use tool', fine: 'Steady hand', gift: 'The Steady', consult: 'Consult',\\n    toolPrev: 'Previous tool', toolNext: 'Next tool', wheelHold: 'Tool wheel',\\n    interact: 'Talk or use', more: 'Ask for more time',\\n    tool1: false, tool2: false, tool3: false, tool4: false, tool5: false, tool6: false, tool7: false, tool8: false,\\n  };\\n\\n  const game = new E.Game({\\n    canvas: 'screen',\\n    id: TITLE,\\n    res: [426, 240],\\n    expand: true,\\n    view: 'side',\\n    touch: 'never',\\n    draw: true,\\n    live: inSession,\\n    autoPause: !inSession,\\n    corner: !inSession,\\n    input: INPUT,\\n    menu: {\\n      quit: inSession ? false : 'title',\\n      saves: true,\\n      items: inSession ? [] : [['Dev Mode', () => GAME.openDev()]],\\n      settings: SETTINGS,\\n      controls: CONTROLS,\\n    },\\n  });\\n  game.input.names = CONTROLS;\\n\\n  const ui = new E.Shell(game, {\\n    tv: true,\\n    theme: {\\n      paper: 'rgba(6,22,26,.94)',\\n      accent: '#5ff0e0',\\n      line: 'rgba(95,240,224,.35)',\\n      ink: '#e8fbf6',\\n      muted: '#8fb8b0',\\n      danger: '#ff7a6a',\\n    },\\n  });\\n\\n  GAME.openDev = () => {\\n    if (inSession) return;\\n    RT.devOpen = true;\\n    RT.devTab = 0;\\n    RT.devI = 0;\\n    if (game.shell) game.shell.hide();\\n  };\\n\\n  function origin() {\\n    return [(game.W - CFG.FIELD_W) >> 1, (game.H - CFG.FIELD_H) >> 1];\\n  }\\n  function playTune() {\\n    const t = CFG.cloneTune(GAME.TUNE);\\n    t.hands.assist = PREFS.assist;\\n    t.hands.cursor = PREFS.cursor;\\n    return t;\\n  }\\n  function makeMenu(items, onPick, onCancel) {\\n    return new E.Menu(game, items, {\\n      scale: 2, rows: 6,\\n      color: '#e8fbf6', pick: '#5ff0e0', dim: '#8fb8b0',\\n      bg: '#06141a', border: '#5ff0e0',\\n      onPick, onCancel,\\n    });\\n  }\\n  function go(name, data) {\\n    game.go(name, data, { fade: game.fadeTime });\\n  }\\n\\n  const people = {};\\n  for (const id in GAME.CAST) {\\n    const c = GAME.CAST[id];\\n    people[id] = {\\n      name: c.name,\\n      portrait: (g, x, y, size) => {\\n        let expr = 'neutral';\\n        if (story.running && story.node) {\\n          const steps = story.nodes[story.node];\\n          const line = steps && steps[story._i - 1];\\n          if (line && line.who === id && line.expr) expr = line.expr;\\n        }\\n        GAME.Art.bust(g, id, { expr }, x, y, size || 40);\\n      },\\n    };\\n  }\\n  const story = new E.Story(game, {\\n    people,\\n    nodes: GAME.NODES,\\n    on: {\\n      op(st, step) {\\n        RT.fromStory = true;\\n        RT.redirect = true;\\n        const id = step.caseId;\\n        if (GAME.LIGHT[id] && RT.chartFor !== id) go('chart', { caseId: id });\\n        else {\\n          beginCase(id, { difficulty: RT.diff, seed: 3, fromStory: true });\\n          go('op');\\n        }\\n      },\\n      ward() {\\n        RT.redirect = true;\\n        go('ward');\\n      },\\n      credits() {\\n        RT.redirect = true;\\n        RT.creditPage = 0;\\n        go('credits');\\n      },\\n    },\\n  });\\n  story.talk.voice = (ch) => { try { GAME.Audio.blip(ch); } catch (e) { /* quiet */ } };\\n  story.talk.bg = '#06141a';\\n  story.talk.border = '#5ff0e0';\\n  story.talk.color = '#e8fbf6';\\n  story.talk.nameColor = '#5ff0e0';\\n\\n  function beginCase(id, opts) {\\n    opts = opts || {};\\n    let def = GAME.CASES[id];\\n    if (id === 'ferry' || (def && def.id === 'ferry')) def = GAME.roundsCase(opts.players || 1);\\n    if (!def) return null;\\n    RT.def = def;\\n    RT.mode = opts.mode || def.mode || 'case';\\n    if (opts.fromStory != null) RT.fromStory = opts.fromStory;\\n    const S = GAME.Op.create(def, {\\n      seed: opts.seed == null ? 3 : opts.seed,\\n      difficulty: opts.difficulty || RT.diff || 'resident',\\n      players: opts.players || 1,\\n      phase: opts.phase || 0,\\n    });\\n    if (opts.clockDelta) S.clock += opts.clockDelta;\\n    if (opts.steadyDelta) S.steady += opts.steadyDelta;\\n    if (opts.cheat) S.cheat = Object.assign({}, S.cheat, opts.cheat);\\n    RT.S = S;\\n    RT.leftOp = false;\\n    RT.fieldKey = '';\\n    return S;\\n  }\\n  GAME.beginCase = beginCase;\\n\\n  function recordRank() {\\n    const S = RT.S;\\n    if (!S || !S.won || RT.attract || RT.cheatUsed || GAME.TUNE.dirty) return;\\n    if (S.lab || S.mode === 'rounds' || S.id === 'lab' || S.id === 'ferry') return;\\n    const ch = S.cheat || {};\\n    if (ch.reveal || ch.infSteady || ch.lockVitals || ch.freezeClock || ch.oneHit) return;\\n    RT.ranks[S.id] = S.rank;\\n    RT.cleared[S.id] = true;\\n    if (PERSON[S.id]) RT.saved[PERSON[S.id]] = true;\\n    const def = GAME.CASES[S.id];\\n    if (def && def.chapter) RT.chapter = def.chapter;\\n  }\\n\\n  function resumeHeld() {\\n    if (!(RT.fromStory && story._held)) return false;\\n    RT.redirect = false;\\n    story.resume();\\n    if (!RT.redirect) go('story');\\n    return true;\\n  }\\n\\n  function leaveResults() {\\n    if (resumeHeld()) return;\\n    const S = RT.S;\\n    if (S && (S.lab || S.id === 'lab')) { go('menu'); return; }\\n    if (RT.mode === 'rounds' || (S && S.mode === 'rounds')) { go('lobby'); return; }\\n    if (S && S.won && RT.fromStory) { go('ward'); return; }\\n    go('menu');\\n  }\\n\\n  function readLocal(p) {\\n    const I = game.input;\\n    const [ox, oy] = origin();\\n    let digit = 0;\\n    for (let n = 1; n <= 8; n++) if (I.pressed('tool' + n)) digit = n;\\n    const tools = CFG.TOOLS;\\n    const idx = Math.max(0, tools.indexOf(p.tool));\\n    if (!digit && I.pressed('toolNext')) digit = (idx % 8) + 1 === idx + 1 ? ((idx + 1) % 8) + 1 : ((idx + 1) % 8) + 1;\\n    if (!digit && I.pressed('toolNext')) digit = ((idx + 1) % 8) + 1;\\n    if (I.pressed('toolPrev')) digit = ((idx + 7) % 8) + 1;\\n    if (I.pressed('toolNext')) digit = ((idx + 1) % 8) + 1;\\n    const devOpen = RT.devOpen;\\n    const keys = devOpen ? [0, 0] : [\\n      (I.down('curR') ? 1 : 0) - (I.down('curL') ? 1 : 0),\\n      (I.down('curD') ? 1 : 0) - (I.down('curU') ? 1 : 0),\\n    ];\\n    const nudge = devOpen ? [0, 0] : [\\n      (I.down('nudgeR') ? 1 : 0) - (I.down('nudgeL') ? 1 : 0),\\n      (I.down('nudgeD') ? 1 : 0) - (I.down('nudgeU') ? 1 : 0),\\n    ];\\n    const swap = !!PREFS.swap;\\n    const aim = (swap ? I.padMove : I.padAim) || [0, 0];\\n    const move = (swap ? (I.padAim || [0, 0]) : (I.padMove || [0, 0]));\\n    let mouse = null;\\n    const ptr = I.pointer();\\n    if (ptr && (I.lastDevice === 'mouse' || I._fedAt)) mouse = [ptr[0] - ox, ptr[1] - oy];\\n    let trig = I.value('useTool') || 0;\\n    if (PREFS.sustain === 'toggle') {\\n      if (I.pressed('useTool')) RT.latched = !RT.latched;\\n      trig = RT.latched ? 1 : 0;\\n    }\\n    const pan = I.pan();\\n    if (!digit && I.down('wheelHold') && pan && Math.hypot(pan[0], pan[1]) > 8) {\\n      move[0] += pan[0] / Math.max(8, Math.hypot(pan[0], pan[1]));\\n      move[1] += pan[1] / Math.max(8, Math.hypot(pan[0], pan[1]));\\n    }\\n    return {\\n      digit, mouse, aim, move, keys, nudge,\\n      fine: I.down('fine'),\\n      trig,\\n      gift: I.down('gift'),\\n      consult: I.down('consult'),\\n      cancel: I.down('cancel'),\\n    };\\n  }\\n\\n  function drive(S, dt, opts) {\\n    opts = opts || {};\\n    const inputs = [];\\n    const n = S.players.length;\\n    for (let i = 0; i < n; i++) {\\n      const p = S.players[i];\\n      if (p.gone) { inputs.push({ tool: p.tool, trig: 0 }); continue; }\\n      let dev;\\n      if (opts.remote && opts.remote[i]) {\\n        dev = opts.remote[i];\\n      } else if (i === 0 && game.debug && game.debug.driver && !RT.attract) {\\n        dev = game.debug.driver(S, dt) || GAME.Bot.device(S, 0, dt);\\n      } else if (i === 0 && RT.auto && !RT.attract) {\\n        dev = GAME.Bot.device(S, 0, dt);\\n      } else if (i === 0 && !opts.bots && !RT.attract) {\\n        dev = readLocal(p);\\n      } else {\\n        dev = GAME.Bot.device(S, i, dt);\\n      }\\n      GAME.Wheel.update(p, dev, dt);\\n      const tune = playTune();\\n      if (dev.mouse) GAME.Cursor.update(p, { mouse: dev.mouse, fine: dev.fine }, S, dt, tune);\\n      else GAME.Cursor.update(p, { aim: dev.aim, keys: dev.keys, nudge: dev.nudge, fine: dev.fine }, S, dt, tune);\\n      const row = {\\n        tool: p.tool,\\n        trig: dev.trig || 0,\\n        fine: !!dev.fine,\\n        gift: !!dev.gift,\\n        consult: !!dev.consult,\\n        cancel: !!dev.cancel,\\n        mouse: !!dev.mouse,\\n      };\\n      if (dev.x != null) { row.x = dev.x; row.y = dev.y; }\\n      inputs.push(row);\\n    }\\n    try { GAME.Op.step(S, inputs, dt, playTune()); }\\n    catch (e) { game.fail('op', e); }\\n    if (S.ev) for (const ev of S.ev) { try { GAME.Audio.onEv(ev); } catch (err) { /* quiet */ } }\\n    return S;\\n  }\\n\\n  function fieldOf(S) {\\n    const key = (S.site || 'abdomen') + ':' + (S.seed || 1) + ':' + game.W + 'x' + game.H;\\n    if (RT.fieldKey !== key) {\\n      RT.field = GAME.Art.fieldFor(S.site || 'abdomen', S.seed || 1, game.W, game.H);\\n      RT.fieldKey = key;\\n    }\\n    return RT.field;\\n  }\\n\\n  const COL = {\\n    shard: '#d5dee6', laceration: '#e05050', wound: '#c43030', bleeder: '#ff4040', arteryTear: '#ff2060',\\n    pool: '#601828', polyp: '#e08898', mass: '#c06078', clot: '#682838', patch: '#e07070',\\n    nerve: '#e2c14a', eloquent: '#f0d060', retractor: '#c8d0d4', bead: '#5ff0e0', nest: '#14383c',\\n    lobe: '#7a5cff', eye: '#d0c8ff', tendril: '#3ec8b0', uvula: '#9a78ff', voice: '#5ff0e0', reed: '#8fd0c8',\\n    repeat: '#f5b700', slur: '#9ad8d0', hook: '#d0d4d8', screw: '#e8e0c8', wire: '#f0d060', lead: '#88e0c8',\\n    cut: '#f2f0e6', fed: '#401018', bite: '#e05050',\\n  };\\n  function bloodCol() {\\n    if (PREFS.blood === 'rose') return '#e07098';\\n    if (PREFS.blood === 'ink') return '#2a2030';\\n    return null;\\n  }\\n\\n  function drawOp(r, S, ribbon) {\\n    const [ox, oy] = origin();\\n    r.sky(['#071018', '#102028']);\\n    const F = S ? fieldOf(S) : null;\\n    const allow = (typeof document !== 'undefined') || GAME.Art.force;\\n    if (allow && F) {\\n      try { F.shade({ beat: ((S.t || 0) % 1), slow: !!S.breath, dim: S.dim || 0 }); }\\n      catch (e) { /* painter */ }\\n    }\\n    r.overlay(g => {\\n      const px = E.px;\\n      if (F && F.cv && F.cv.width) { try { g.drawImage(F.cv, 0, 0); } catch (e) { /* no image */ } }\\n      px.rect(g, 0, 0, r.W, Math.max(0, oy), '#102830');\\n      px.rect(g, 0, oy + CFG.FIELD_H, r.W, Math.max(0, r.H - oy - CFG.FIELD_H), '#102830');\\n      px.rect(g, 0, oy, Math.max(0, ox), CFG.FIELD_H, '#102830');\\n      px.rect(g, ox + CFG.FIELD_W, oy, Math.max(0, r.W - ox - CFG.FIELD_W), CFG.FIELD_H, '#102830');\\n      px.rect(g, ox + 8, oy + 8, CFG.FIELD_W - 16, CFG.FIELD_H - 16, '#0c2428');\\n      if (!S) return;\\n      const ink = bloodCol();\\n      for (const o of S.objects) {\\n        if (!o.alive && o.type !== 'retractor') continue;\\n        if (o.hidden && !o.marked) continue;\\n        const x = o.x + ox, y = o.y + oy;\\n        let c = COL[o.type] || '#9ad0c8';\\n        if (ink && (o.type === 'bleeder' || o.type === 'pool' || o.type === 'wound' || o.type === 'laceration' || o.type === 'arteryTear')) c = ink;\\n        const rad = o.type === 'pool' ? 8 + (o.vol || 0) * 0.15 : o.type === 'mass' ? (o.rad || 12) : o.type === 'bead' ? 3 : 4;\\n        if (o.guide && o.guide.length > 1 && (o.type === 'cut' || o.type === 'mass' || o.type === 'slur')) {\\n          for (let k = 1; k < o.guide.length; k++) px.line(g, o.guide[k - 1][0] + ox, o.guide[k - 1][1] + oy, o.guide[k][0] + ox, o.guide[k][1] + oy, '#f2f0e6', 1);\\n        }\\n        px.disc(g, x, y, rad, o.done ? '#2a403c' : c);\\n        if (o.marked) px.disc(g, x, y, rad + 3, '#5ff0e0');\\n      }\\n      if (S.breath) {\\n        px.rect(g, ox + 20, oy + 16, CFG.FIELD_W - 40, 2, '#bfefff');\\n        px.rect(g, ox + 20, oy + CFG.FIELD_H - 18, CFG.FIELD_W - 40, 2, '#bfefff');\\n      }\\n      for (const p of S.players) if (!p.gone) GAME.Art.drawHand(g, p, ox, oy);\\n      const vit = Math.max(0, Math.ceil(S.vitals));\\n      const clk = Math.max(0, Math.ceil(S.clock));\\n      E.font.text(g, 'VIT ' + vit, 8, 6, vit < 30 ? '#ff7a6a' : '#e8fbf6', { scale: 2, outline: '#06141a' });\\n      E.font.text(g, 'CLK ' + clk, 8, 26, clk < 20 ? '#ff7a6a' : '#e8fbf6', { scale: 2, outline: '#06141a' });\\n      E.font.text(g, (S.phaseName || '') + '  ' + (S.activeDoc || ''), 8, 48, '#8fb8b0', { outline: '#06141a' });\\n      const tool = (S.players[0] && S.players[0].tool) || 'forceps';\\n      GAME.Art.toolIcon(g, tool, r.W - 28, r.H - 28, 1);\\n      E.font.text(g, tool.toUpperCase(), r.W - 8, r.H - 36, '#e8fbf6', { align: 'right', outline: '#06141a' });\\n      if (PREFS.hints) E.font.text(g, game.input.label('useTool'), r.W - 8, r.H - 14, '#5ff0e0', { align: 'right', outline: false });\\n      const steady = Math.round(S.steady || 0);\\n      E.font.text(g, 'STEADY ' + steady, 8, r.H - 16, '#5ff0e0', { outline: '#06141a' });\\n      if (S.codeBlue) E.font.text(g, 'SHOCK', r.W / 2, 64, '#ff7a6a', { align: 'center', scale: 2, outline: '#06141a' });\\n      if (S.dressing) E.font.text(g, 'DRESSING', r.W / 2, 64, '#f2f0e6', { align: 'center', scale: 2, outline: '#06141a' });\\n      if (ribbon) E.font.text(g, 'DEMO', r.W - 8, 6, '#f5b700', { align: 'right', scale: 2, outline: '#06141a' });\\n      if (GAME.TUNE.dirty || RT.cheatUsed) E.font.text(g, 'DEV', 8, 66, '#f5b700', { outline: '#06141a' });\\n      if (S.t != null && GAME.BARKS && GAME.BARKS.length) {\\n        const bark = GAME.BARKS[Math.floor(S.t / 4) % GAME.BARKS.length];\\n        E.font.text(g, bark, r.W / 2, r.H - 28, '#d8e4dc', { align: 'center', outline: '#06141a' });\\n      }\\n      if (RT.devOpen) drawDev(g, r);\\n    });\\n  }\\n\\n  const CHEATS = [\\n    ['reveal', 'Reveal'],\\n    ['infSteady', 'Infinite Steady'],\\n    ['lockVitals', 'Lock vitals'],\\n    ['freezeClock', 'Freeze clock'],\\n    ['oneHit', 'One hit'],\\n    ['auto', 'Autosurgeon'],\\n    ['slow', 'Slow motion'],\\n    ['win', 'Clear phase'],\\n    ['lose', 'Force a loss'],\\n    ['code', 'Vitals to zero'],\\n  ];\\n  const SLOW = [0.25, 0.5, 1, 2];\\n\\n  function devRows() {\\n    if (RT.devTab === 1) return CHEATS.map(c => c[1]);\\n    if (RT.devTab === 2) {\\n      const rows = [];\\n      for (const id of GAME.ORDER) {\\n        const def = GAME.CASES[id];\\n        const n = (def.phases || []).length;\\n        for (let p = 0; p < n; p++) rows.push(id + ' ' + (def.phases[p].name || p));\\n      }\\n      rows.push('Grand Rounds');\\n      rows.push('Skills Lab');\\n      return rows;\\n    }\\n    return GAME.Dev.KEYS.map(k => k[0]).concat(['Reset tuning']);\\n  }\\n\\n  function devAct(dir) {\\n    RT.cheatUsed = RT.devTab !== 0 || RT.cheatUsed;\\n    const S = RT.S;\\n    if (RT.devTab === 0) {\\n      const keys = GAME.Dev.KEYS;\\n      if (RT.devI >= keys.length) { if (dir === 0) GAME.Dev.reset(); return; }\\n      const [path, lo, hi] = keys[RT.devI];\\n      const [g, k] = path.split('.');\\n      const step = (hi - lo) / 20;\\n      const cur = GAME.TUNE[g][k];\\n      const v = Math.max(lo, Math.min(hi, Math.round((cur + dir * step) * 1000) / 1000));\\n      GAME.Dev.set(path, v);\\n      return;\\n    }\\n    if (dir !== 0 && RT.devTab !== 1) return;\\n    if (RT.devTab === 1 && dir === 0) {\\n      const key = CHEATS[RT.devI][0];\\n      if (key === 'auto') { RT.auto = !RT.auto; RT.cheatUsed = true; return; }\\n      if (key === 'slow') {\\n        const i = SLOW.indexOf(game.timeScale);\\n        game.timeScale = SLOW[(i + 1) % SLOW.length] || 1;\\n        RT.cheatUsed = true;\\n        return;\\n      }\\n      if (key === 'win' && S) {\\n        RT.cheatUsed = true;\\n        for (const o of S.objects) { o.done = true; o.prog = 1; }\\n        S.hold = false;\\n        return;\\n      }\\n      if (key === 'lose' && S) { RT.cheatUsed = true; GAME.Sim.lose(S, 'dev'); return; }\\n      if (key === 'code' && S) { RT.cheatUsed = true; S.vitals = 0; return; }\\n      if (S) {\\n        S.cheat = S.cheat || {};\\n        const on = !S.cheat[key];\\n        GAME.Dev.cheat(S, key, on);\\n        RT.cheatUsed = true;\\n      }\\n      return;\\n    }\\n    if (RT.devTab === 2 && dir === 0) {\\n      const rows = devRows();\\n      const label = rows[RT.devI] || '';\\n      RT.cheatUsed = true;\\n      if (label === 'Grand Rounds') { beginCase('ferry', { players: 1, fromStory: false }); go('op'); return; }\\n      if (label === 'Skills Lab') { beginCase('lab', { fromStory: false }); go('op'); return; }\\n      const id = label.slice(0, 3);\\n      const def = GAME.CASES[id];\\n      if (!def) return;\\n      const name = label.slice(4);\\n      let phase = 0;\\n      (def.phases || []).forEach((ph, i) => { if ((ph.name || String(i)) === name) phase = i; });\\n      beginCase(id, { phase, fromStory: false });\\n      go('op');\\n    }\\n  }\\n\\n  function handleDev() {\\n    if (!RT.devOpen || inSession) return false;\\n    const I = game.input;\\n    const rows = devRows();\\n    if (I.pressed('cancel')) { RT.devOpen = false; I.consumeAll(); return true; }\\n    if (I.pressed('toolPrev')) RT.devTab = (RT.devTab + 2) % 3;\\n    if (I.pressed('toolNext')) RT.devTab = (RT.devTab + 1) % 3;\\n    if (I.pressed('up')) RT.devI = (RT.devI + rows.length - 1) % rows.length;\\n    if (I.pressed('down')) RT.devI = (RT.devI + 1) % rows.length;\\n    if (RT.devI >= rows.length) RT.devI = 0;\\n    if (I.pressed('left')) devAct(-1);\\n    if (I.pressed('right') || I.pressed('confirm')) devAct(I.pressed('confirm') ? 0 : 1);\\n    return true;\\n  }\\n\\n  function drawDev(g, r) {\\n    const px = E.px;\\n    const rows = devRows();\\n    const tabs = ['Tune', 'Cheats', 'Jump'];\\n    px.rect(g, r.W - 168, 8, 160, r.H - 16, '#06141a');\\n    E.font.text(g, tabs[RT.devTab], r.W - 160, 12, '#f5b700', { outline: false });\\n    const first = Math.max(0, Math.min(RT.devI - 6, rows.length - 12));\\n    for (let i = 0; i < 12 && first + i < rows.length; i++) {\\n      const k = first + i;\\n      const on = k === RT.devI;\\n      E.font.text(g, (on ? '> ' : '  ') + rows[k], r.W - 160, 28 + i * 12, on ? '#5ff0e0' : '#8fb8b0', { outline: false });\\n    }\\n  }\\n\\n  function drawTitle(r, t) {\\n    r.sky(['#071018', '#0e2430']);\\n    r.overlay(g => {\\n      GAME.Art.titleBackdrop(g, r.W, r.H, t || game.real || 0);\\n      E.font.title(g, 'OPEN TABLE', r.W / 2, 28, { scale: 2, align: 'center', colors: ['#f4fff8', '#9aefe4', '#1c6e78'] });\\n      E.font.text(g, TITLE, r.W / 2, 78, '#e8fbf6', { align: 'center', scale: 1, outline: '#06141a' });\\n      E.font.text(g, \\\"Don't let it go quiet\\\", r.W / 2, 96, '#5ff0e0', { align: 'center', outline: false });\\n      const y = 120;\\n      let x = 24;\\n      const beat = [0, 2, 0, 6, 0, 2, 8, 0, 1, 0, 4, 0];\\n      for (let i = 0; i < beat.length; i++) {\\n        const h = 2 + beat[i];\\n        E.px.rect(g, x, y - h, 6, h, '#7CFFB2');\\n        x += 10;\\n      }\\n      const prompt = game.input.label('confirm');\\n      E.font.text(g, prompt, r.W / 2, r.H - 28, '#e8fbf6', { align: 'center', scale: 2, outline: '#06141a' });\\n    });\\n  }\\n\\n  function snapshot() {\\n    const S = RT.S;\\n    const [ox, oy] = origin();\\n    let mark = null;\\n    if (RT.light && RT.light.mark) mark = [ox + RT.light.mark[0], oy + RT.light.mark[1]];\\n    const choice = !!(story.talk && story.talk.open && story.talk.choices && story.talk.choices.length && !story.talk.typing);\\n    return {\\n      scene: game.sceneName,\\n      menu: RT.menu ? { i: RT.menu.i, labels: RT.menu.items.map(it => (typeof it === 'string' ? it : it.label)) } : null,\\n      story: story.running ? story.node : null,\\n      held: !!story._held,\\n      choice,\\n      op: S ? {\\n        id: S.id, won: !!S.won, lost: !!S.lost, phase: S.phase, phaseName: S.phaseName,\\n        clock: S.clock, vitals: S.vitals, score: S.score, rank: S.rank,\\n        breath: !!S.breath, worldScale: S.worldScale, closed: !!S.closed,\\n      } : null,\\n      lightbox: mark,\\n      ward: { patients: RT.visitors.slice(), nearDoor: !!RT.nearDoor },\\n      attract: RT.attract ? { on: true, loops: RT.loops, seg: RT.seg } : null,\\n      dev: { open: !!RT.devOpen, dirty: !!GAME.TUNE.dirty },\\n      ranks: Object.assign({}, RT.ranks),\\n      cleared: Object.assign({}, RT.cleared),\\n      reel: RT.loops,\\n    };\\n  }\\n\\n  const REEL = [\\n    { kind: 'story', t: 4 },\\n    { kind: 'op', id: 'c1', t: 15, cheat: { lockVitals: true, freezeClock: true, oneHit: true } },\\n    { kind: 'op', id: 'c3', t: 8, cheat: { lockVitals: true, freezeClock: true, oneHit: true } },\\n    { kind: 'op', id: 'c6', t: 8, cheat: { lockVitals: true, freezeClock: true, oneHit: true } },\\n    { kind: 'op', id: 'c7', t: 8, cheat: { lockVitals: true, freezeClock: true, infSteady: true } },\\n    { kind: 'rounds', t: 8 },\\n    { kind: 'op', id: 'c11', t: 8, cheat: { lockVitals: true, freezeClock: true, oneHit: true } },\\n    { kind: 'card', t: 4 },\\n    { kind: 'title', t: 8 },\\n  ];\\n\\n  function startSegment() {\\n    const seg = REEL[RT.seg];\\n    RT.segT = 0;\\n    if (seg.kind === 'op') {\\n      const S = beginCase(seg.id, { fromStory: false, cheat: seg.cheat, seed: 3 });\\n      if (S) S.mode = 'attract';\\n      game.setView('overhead');\\n    } else if (seg.kind === 'rounds') {\\n      const S = beginCase('ferry', { players: 4, fromStory: false, cheat: { lockVitals: true, freezeClock: true, oneHit: true } });\\n      if (S) S.mode = 'attract';\\n      game.setView('overhead');\\n    } else if (seg.kind === 'story') {\\n      game.setView('side');\\n      if (!RT.reelStory) {\\n        RT.reelStory = new E.Story(game, {\\n          people,\\n          nodes: { beat: [GAME.NODES.start[0]] },\\n          on: {},\\n        });\\n      }\\n      RT.reelStory.skip = true;\\n      RT.reelStory.run('beat');\\n    } else game.setView('side');\\n  }\\n\\n  const H = {\\n    info: null,\\n    phase: 'solo',\\n    over: false,\\n    accS: 0,\\n    accI: 0,\\n    snapN: 0,\\n    inN: 0,\\n    heard: 0,\\n    hands: {},\\n    view: null,\\n    card: null,\\n    local: -1,\\n  };\\n\\n  function hubFinish() {\\n    if (H.over || !H.info || !H.info.isHost) return;\\n    H.over = true;\\n    const info = H.info;\\n    const S = RT.S;\\n    const scoreOf = (id) => {\\n      const idx = info.players.findIndex(q => q.id === id);\\n      const p = S && S.players[idx];\\n      return p ? (p.actions | 0) : 0;\\n    };\\n    const ids = info.players.map(q => q.id);\\n    ids.sort((a, b) => scoreOf(b) - scoreOf(a));\\n    const standings = [];\\n    for (const id of ids) {\\n      const last = standings[standings.length - 1];\\n      if (last && scoreOf(last[0]) === scoreOf(id)) last.push(id);\\n      else standings.push([id]);\\n    }\\n    const scores = {};\\n    for (const id of ids) scores[id] = scoreOf(id);\\n    const best = ids[0];\\n    const detail = (scores[best] || 0) + ' clean actions';\\n    const awards = best == null ? [] : [{ id: best, title: 'Steadiest Hand', detail: detail.slice(0, 40) }];\\n    try { HUB.send({ t: 'over', n: ++H.snapN }); } catch (e) { /* late */ }\\n    HUB.finish({\\n      standings,\\n      scores,\\n      won: !!(S && S.closed),\\n      awards,\\n      stats: { clock: S ? Math.round(S.clock) : 0, vitals: S ? Math.round(S.vitals) : 0 },\\n    });\\n  }\\n\\n  const TYPE_N = {};\\n  ['shard', 'laceration', 'wound', 'bleeder', 'arteryTear', 'pool', 'polyp', 'mass', 'clot', 'bead', 'nest', 'lobe', 'eye', 'tendril', 'voice', 'repeat', 'retractor'].forEach((t, i) => { TYPE_N[t] = i + 1; });\\n\\n  function sendSnap() {\\n    const S = RT.S;\\n    const info = H.info;\\n    if (!S || !info) return;\\n    const objs = [];\\n    for (const o of S.objects) {\\n      if (objs.length >= 28) break;\\n      if (o.done && o.type !== 'retractor') continue;\\n      let flags = (o.done ? 1 : 0) | (o.hidden ? 2 : 0) | (o.marked ? 4 : 0) | (o.alive ? 8 : 0);\\n      objs.push([o.id, o.x | 0, o.y | 0, TYPE_N[o.type] || 0, flags]);\\n    }\\n    const ps = info.players.map((q, i) => {\\n      const p = S.players[i];\\n      if (!p) return [q.id, 0, 0, 0, 0, 0, 1];\\n      const tool = Math.max(0, CFG.TOOLS.indexOf(p.tool));\\n      return [q.id, p.x | 0, p.y | 0, tool, p.trig > 0.3 ? 1 : 0, p.actions | 0, p.gone ? 1 : 0];\\n    });\\n    HUB.send({\\n      t: 's', n: ++H.snapN,\\n      clock: S.clock | 0, vitals: S.vitals | 0, phase: S.phase | 0,\\n      won: S.won ? 1 : 0, closed: S.closed ? 1 : 0, breath: S.breath ? 1 : 0,\\n      o: objs, p: ps,\\n    }, { reliable: false });\\n  }\\n\\n  function applyHands() {\\n    const remote = {};\\n    const info = H.info;\\n    if (!info) return remote;\\n    for (const key in H.hands) {\\n      const i = +key;\\n      const hnd = H.hands[key];\\n      if (!hnd) continue;\\n      remote[i] = { x: hnd.x, y: hnd.y, trig: hnd.trig || 0, digit: hnd.digit || 0, aim: [0, 0], mouse: null };\\n    }\\n    return remote;\\n  }\\n\\n  async function connect() {\\n    if (!HUB || !HUB.active) { H.phase = 'solo'; return; }\\n    let info = null;\\n    try { info = await HUB.connect({ mode: 'shared-world', seats: [1, 4], card: true }); }\\n    catch (e) { H.phase = 'solo'; return; }\\n    if (!info) { H.phase = 'solo'; return; }\\n    H.info = info;\\n    H.phase = 'wait';\\n    H.local = info.players.findIndex(q => q.id === info.me);\\n    HUB.on('card', c => { H.card = c; });\\n    HUB.on('start', () => { H.phase = 'count'; });\\n    HUB.on('message', (d, from) => {\\n      if (!d) return;\\n      if (info.isHost) {\\n        if (d.t === 'i') {\\n          const idx = info.players.findIndex(q => q.id === from);\\n          if (idx >= 0) H.hands[idx] = { x: d.x, y: d.y, trig: d.trig || 0, digit: d.digit || 0, n: d.n || 0 };\\n        }\\n      } else if (from === info.host && d.t === 's' && d.n > H.heard) {\\n        H.heard = d.n;\\n        H.view = d;\\n      }\\n    });\\n    HUB.on('leave', ({ id }) => {\\n      const idx = info.players.findIndex(q => q.id === id);\\n      if (RT.S && RT.S.players[idx]) RT.S.players[idx].gone = true;\\n    });\\n    HUB.on('time-up', () => { if (info.isHost) hubFinish(); });\\n    HUB.on('end', () => { H.phase = 'over'; try { game.audio.music(null); game.audio.mute(true); } catch (e) { /* quiet */ } });\\n    if (info.isHost) {\\n      const rng = HUB.rng('sim');\\n      const seed = ((rng() * 0x7fffffff) >>> 0) || 1;\\n      const n = Math.max(1, Math.min(4, info.players.length || 1));\\n      beginCase('ferry', { players: n, seed, fromStory: false, mode: 'rounds' });\\n    }\\n    HUB.ready();\\n  }\\n\\n  function stickHot(I) {\\n    const a = I.padAim, m = I.padMove;\\n    return (a && Math.hypot(a[0], a[1]) > 0.25) || (m && Math.hypot(m[0], m[1]) > 0.25);\\n  }\\n\\n  game.hook('input', (dt) => {\\n    const I = game.input;\\n    if (RT.suppress > 0) { RT.suppress--; I.consumeAll(); return; }\\n    if (!RT.mouseInit) { RT.mouseInit = true; RT.mouseT = I.mouse ? I.mouse.t : 0; }\\n    let mouseMoved = false;\\n    if (I.mouse && I.mouse.t !== RT.mouseT) { mouseMoved = true; RT.mouseT = I.mouse.t; }\\n    const scene = game.sceneName;\\n    if (scene === 'attract') {\\n      const hit = I.anyPressed() || I.clicked() || stickHot(I) || mouseMoved || (I.held && I.held.size > 0);\\n      if (hit) {\\n        RT.attract = false;\\n        RT.idle = 0;\\n        go('title');\\n        I.consumeAll();\\n        RT.suppress = 1;\\n      }\\n      return;\\n    }\\n    const watch = scene === 'title' || scene === 'menu' || scene === 'casefiles' || scene === 'lobby';\\n    const shellUp = !!(game.shell && game.shell.screen);\\n    if (!watch || shellUp || game.paused || inSession) { RT.idle = 0; return; }\\n    let active = I.anyPressed() || !!I.clicked() || stickHot(I) || mouseMoved;\\n    if (I.held && I.held.size > 0) active = true;\\n    if (active) RT.idle = 0;\\n    else RT.idle += dt;\\n    if (RT.idle >= 10) {\\n      RT.idle = 0;\\n      RT.attract = true;\\n      RT.seg = 0;\\n      RT.loops = RT.loops || 0;\\n      go('attract');\\n    }\\n  });\\n\\n  game.hook('enter', (name) => {\\n    const song = {\\n      title: 'night', menu: 'night', difficulty: 'night', casefiles: 'night', about: 'night',\\n      story: 'night', chart: 'night', op: 'theatre', results: 'ward', ward: 'ward',\\n      credits: 'end', lobby: 'night', lab: 'theatre', attract: 'hush', hub: 'theatre',\\n    }[name] || 'night';\\n    try { GAME.Audio.play(song); } catch (e) { /* quiet */ }\\n  });\\n\\n  const CAM = { zoom: false, wheel: false };\\n\\n  const scenes = {\\n    title: {\\n      view: 'side', camera: CAM,\\n      enter() { RT.menu = null; RT.attract = false; },\\n      update() {\\n        const I = game.input;\\n        if (I.pressed('confirm') || I.pressed('start')) go('menu');\\n      },\\n      draw(r) { drawTitle(r, game.real); },\\n    },\\n    menu: {\\n      view: 'side', camera: CAM,\\n      enter() {\\n        RT.menu = makeMenu(['New Game', 'Case Files', 'Grand Rounds', 'Skills Lab', 'About'], (i, label) => {\\n          if (label === 'New Game') {\\n            story.stop();\\n            RT.saved = {}; RT.ranks = {}; RT.cleared = {}; RT.chapter = 1; RT.chartFor = null;\\n            RT.fromStory = true; RT.pending = 'story'; RT.cheatUsed = false;\\n            go('difficulty');\\n          } else if (label === 'Case Files') go('casefiles');\\n          else if (label === 'Grand Rounds') go('lobby');\\n          else if (label === 'Skills Lab') { RT.pending = 'lab'; RT.fromStory = false; go('difficulty'); }\\n          else if (label === 'About') go('about');\\n        }, () => go('title'));\\n      },\\n      update() { if (RT.menu) RT.menu.update(); },\\n      draw(r) {\\n        drawTitle(r, game.real * 0.2);\\n        if (RT.menu) RT.menu.draw(r);\\n      },\\n    },\\n    difficulty: {\\n      view: 'side', camera: CAM,\\n      enter() {\\n        const items = ['Intern', 'Resident', 'Attending'];\\n        RT.menu = makeMenu(items, (i) => {\\n          RT.diff = ['intern', 'resident', 'attending'][i];\\n          if (game.settings && game.settings.set) { try { game.settings.set('difficulty', RT.diff); } catch (e) { /* pref */ } }\\n          if (RT.pending === 'lab') { beginCase('lab', { difficulty: RT.diff, fromStory: false }); go('op'); }\\n          else if (RT.pending === 'file') { beginCase(RT.fileCase, { difficulty: RT.diff, fromStory: false }); go('op'); }\\n          else go('story');\\n        }, () => go('menu'));\\n        RT.menu.i = 0;\\n      },\\n      update() { if (RT.menu) RT.menu.update(); },\\n      draw(r) {\\n        r.sky(['#071018', '#102028']);\\n        r.overlay(g => {\\n          GAME.Art.stage(g, 'office', r.W, r.H, game.real);\\n          E.font.text(g, 'DIFFICULTY', r.W / 2, 16, '#5ff0e0', { align: 'center', scale: 2, outline: '#06141a' });\\n        });\\n        if (RT.menu) RT.menu.draw(r);\\n      },\\n    },\\n    casefiles: {\\n      view: 'side', camera: CAM,\\n      enter() {\\n        const items = GAME.ORDER.map(id => {\\n          const def = GAME.CASES[id];\\n          const rank = RT.ranks[id] ? '  ' + RT.ranks[id] : '';\\n          return (def.name || id) + rank;\\n        });\\n        RT.menu = makeMenu(items, (i) => {\\n          RT.fileCase = GAME.ORDER[i];\\n          RT.pending = 'file';\\n          RT.fromStory = false;\\n          go('difficulty');\\n        }, () => go('menu'));\\n      },\\n      update() { if (RT.menu) RT.menu.update(); },\\n      draw(r) {\\n        r.sky(['#071018', '#102028']);\\n        r.overlay(g => E.font.text(g, 'CASE FILES', r.W / 2, 12, '#5ff0e0', { align: 'center', scale: 2, outline: '#06141a' }));\\n        if (RT.menu) RT.menu.draw(r);\\n      },\\n    },\\n    lobby: {\\n      view: 'side', camera: CAM,\\n      enter() {\\n        RT.menu = makeMenu(['1 surgeon', '2 surgeons', '3 surgeons', '4 surgeons'], (i) => {\\n          RT.lobbyN = i + 1;\\n          beginCase('ferry', { players: RT.lobbyN, fromStory: false, mode: 'rounds' });\\n          go('op');\\n        }, () => go('menu'));\\n      },\\n      update() { if (RT.menu) RT.menu.update(); },\\n      draw(r) {\\n        r.sky(['#071018', '#102028']);\\n        r.overlay(g => {\\n          E.font.text(g, 'GRAND ROUNDS', r.W / 2, 16, '#5ff0e0', { align: 'center', scale: 2, outline: '#06141a' });\\n          E.font.text(g, 'One patient. Shared hands.', r.W / 2, 40, '#8fb8b0', { align: 'center', outline: false });\\n        });\\n        if (RT.menu) RT.menu.draw(r);\\n      },\\n    },\\n    story: {\\n      view: 'side', camera: CAM,\\n      enter() {\\n        if (!story.running && !story._held) {\\n          story.skip = !!(game.debug && game.debug.skipStory);\\n          story.run('start');\\n        }\\n      },\\n      update(dt) {\\n        const I = game.input;\\n        if (I.down('skip') || (game.debug && game.debug.skipStory)) {\\n          story.skip = true;\\n          story.talk.speed = 1e6;\\n        } else story.talk.speed = PREFS.text || 1;\\n        if (I.pressed('log')) RT.logOpen = !RT.logOpen;\\n        if (!story.running && !story._held) { go('title'); return; }\\n        story.update(dt);\\n      },\\n      draw(r) {\\n        const stage = RT.chapter >= 4 ? 'chapel' : RT.chapter === 3 ? 'harbor' : RT.chapter === 2 ? 'office' : 'theatre';\\n        r.sky(['#071018', '#102028']);\\n        r.overlay(g => GAME.Art.stage(g, stage, r.W, r.H, game.real));\\n        story.draw(r);\\n        if (RT.logOpen) r.overlay(g => {\\n          E.px.rect(g, 8, 8, r.W - 16, 70, '#06141a');\\n          const lines = story.log.slice(-4);\\n          lines.forEach((ln, i) => E.font.text(g, (ln.name ? ln.name + ': ' : '') + ln.text, 12, 12 + i * 14, '#e8fbf6', { outline: false }));\\n        });\\n      },\\n    },\\n    chart: {\\n      view: 'overhead', camera: CAM,\\n      enter(data) {\\n        const id = data && data.caseId;\\n        RT.chartCase = id;\\n        RT.light = GAME.LIGHT[id] || null;\\n        RT.miss = 0;\\n      },\\n      update() {\\n        const I = game.input;\\n        const light = RT.light;\\n        if (!light) {\\n          beginCase(RT.chartCase, { fromStory: true, seed: 3 });\\n          go('op');\\n          return;\\n        }\\n        const c = I.clicked();\\n        if (!c) return;\\n        const [ox, oy] = origin();\\n        const mx = ox + light.mark[0], my = oy + light.mark[1];\\n        const d = Math.hypot(c[0] - mx, c[1] - my);\\n        if (d <= 14) {\\n          RT.chartFor = RT.chartCase;\\n          const S = beginCase(RT.chartCase, { fromStory: true, seed: 3 });\\n          if (S) { S.clock += 20; S.steady += 20; }\\n          go('op');\\n        } else {\\n          RT.miss += 1;\\n          if (RT.miss >= 3) {\\n            RT.chartFor = RT.chartCase;\\n            const S = beginCase(RT.chartCase, { fromStory: true, seed: 3 });\\n            if (S) S.clock -= 10 * RT.miss;\\n            go('op');\\n          }\\n        }\\n      },\\n      draw(r) {\\n        r.sky(['#0c1418', '#183028']);\\n        r.overlay(g => {\\n          GAME.Art.stage(g, 'office', r.W, r.H, 0);\\n          const light = RT.light;\\n          E.font.text(g, 'SECOND OPINION', r.W / 2, 12, '#5ff0e0', { align: 'center', scale: 2, outline: '#06141a' });\\n          if (!light) return;\\n          const text = light.text || '';\\n          E.font.text(g, text, r.W / 2, 36, '#e8fbf6', { align: 'center', outline: '#06141a', wrap: r.W - 40 });\\n          const [ox, oy] = origin();\\n          const mx = ox + light.mark[0], my = oy + light.mark[1];\\n          E.px.rect(g, mx - 6, my - 1, 12, 2, '#f5b700');\\n          E.px.rect(g, mx - 1, my - 6, 2, 12, '#f5b700');\\n          E.font.text(g, 'Misses ' + RT.miss, 8, r.H - 16, '#8fb8b0', { outline: false });\\n        });\\n      },\\n    },\\n    op: {\\n      view: 'overhead', camera: CAM, pausable: true,\\n      enter() { game.setView('overhead'); },\\n      update(dt) {\\n        const S = RT.S;\\n        if (!S) { go('menu'); return; }\\n        handleDev();\\n        game.focus(game.W / 2, game.H / 2, 0);\\n        const fast = game.debug && game.debug.driver && !RT.attract;\\n        if (fast) {\\n          for (let k = 0; k < 16; k++) drive(S, 1 / 45);\\n        } else drive(S, dt);\\n        if ((S.won || S.lost) && !RT.leftOp) {\\n          RT.leftOp = true;\\n          if (!RT.attract) go('results');\\n        }\\n      },\\n      draw(r) { game.focus(game.W / 2, game.H / 2, 0); drawOp(r, RT.S, false); },\\n    },\\n    results: {\\n      view: 'side', camera: CAM,\\n      enter() {\\n        recordRank();\\n        const S = RT.S;\\n        const items = S && S.lost ? ['Retry', 'Give up'] : ['Continue'];\\n        RT.menu = makeMenu(items, (i, label) => {\\n          if (label === 'Retry' && RT.S) {\\n            GAME.Op.retryPhase(RT.S);\\n            RT.leftOp = false;\\n            go('op');\\n            return;\\n          }\\n          leaveResults();\\n        });\\n      },\\n      update() { if (RT.menu) RT.menu.update(); },\\n      draw(r) {\\n        const S = RT.S;\\n        r.sky(['#071018', '#102028']);\\n        r.overlay(g => {\\n          GAME.Art.stage(g, 'theatre', r.W, r.H, 0);\\n          const head = S && S.won ? 'CLOSED' : 'LOST';\\n          E.font.text(g, head, r.W / 2, 16, S && S.won ? '#5ff0e0' : '#ff7a6a', { align: 'center', scale: 2, outline: '#06141a' });\\n          if (S) {\\n            const tag = (GAME.TUNE.dirty || RT.cheatUsed) ? 'DEV' : (S.rank || '');\\n            E.font.text(g, tag + '   ' + Math.round(S.score || 0), r.W / 2, 42, '#e8fbf6', { align: 'center', scale: 2, outline: '#06141a' });\\n            E.font.text(g, 'Vitals ' + Math.round(S.vitals) + '   Clock ' + Math.round(S.clock), r.W / 2, 66, '#8fb8b0', { align: 'center', outline: false });\\n          }\\n        });\\n        if (RT.menu) RT.menu.draw(r);\\n      },\\n    },\\n    ward: {\\n      view: 'threequarter', camera: CAM, pausable: true,\\n      enter() {\\n        game.saves.canSave = true;\\n        try { game.saves.autosave(); } catch (e) { /* visit only */ }\\n        const W = game.W, H = game.H;\\n        RT.door = { x: (W / 2) | 0, y: H - 36 };\\n        RT.hero = { x: RT.door.x - 18, y: RT.door.y, tx: null, ty: null };\\n        const list = (GAME.WARD[RT.chapter] || GAME.WARD[1] || []).filter(id => RT.saved[id]);\\n        RT.visitors = list.map((id, i) => ({ id, x: 36 + i * 40, y: 70 }));\\n        RT.nearDoor = true;\\n        RT.line = '';\\n      },\\n      exit() { game.saves.canSave = false; },\\n      update(dt) {\\n        if (handleDev()) {\\n          /* panel owns the arrows; walking still uses the letter keys below when the panel is shut */\\n        }\\n        const I = game.input;\\n        const h = RT.hero;\\n        if (!RT.devOpen) {\\n          let ax = 0, ay = 0;\\n          const m = I.move();\\n          ax += m[0]; ay += m[1];\\n          if (I.held && I.held.has('KeyA')) ax -= 1;\\n          if (I.held && I.held.has('KeyD')) ax += 1;\\n          if (I.held && I.held.has('KeyW')) ay -= 1;\\n          if (I.held && I.held.has('KeyS')) ay += 1;\\n          const c = I.clicked();\\n          if (c) { h.tx = c[0]; h.ty = c[1]; }\\n          if (ax || ay) {\\n            const L = Math.hypot(ax, ay) || 1;\\n            h.x += (ax / L) * 80 * dt;\\n            h.y += (ay / L) * 80 * dt;\\n            h.tx = null;\\n          } else if (h.tx != null) {\\n            const dx = h.tx - h.x, dy = h.ty - h.y, d = Math.hypot(dx, dy);\\n            if (d < 2) h.tx = null;\\n            else { h.x += dx / d * Math.min(d, 80 * dt); h.y += dy / d * Math.min(d, 80 * dt); }\\n          }\\n          h.x = Math.max(12, Math.min(game.W - 12, h.x));\\n          h.y = Math.max(28, Math.min(game.H - 16, h.y));\\n        }\\n        const doorD = Math.hypot(h.x - RT.door.x, h.y - RT.door.y);\\n        RT.nearDoor = doorD <= 36;\\n        if (RT.lineT > 0) RT.lineT -= dt;\\n        if (!RT.devOpen && (I.pressed('confirm') || I.pressed('interact'))) {\\n          if (RT.nearDoor) {\\n            if (!resumeHeld()) go('menu');\\n            return;\\n          }\\n          for (const v of RT.visitors) {\\n            if (Math.hypot(h.x - v.x, h.y - v.y) < 28) {\\n              const p = GAME.PEOPLE[v.id];\\n              RT.line = p ? p.name + ': ' + p.line : '';\\n              RT.lineT = 4;\\n            }\\n          }\\n        }\\n      },\\n      draw(r) {\\n        game.focus(r.W / 2, r.H / 2, 0);\\n        r.sky(['#0c1814', '#163028']);\\n        r.overlay(g => {\\n          const px = E.px;\\n          GAME.Art.stage(g, 'theatre', r.W, r.H, game.real);\\n          px.rect(g, RT.door.x - 10, RT.door.y - 16, 20, 28, '#c8a45a');\\n          px.rect(g, RT.door.x - 2, RT.door.y - 2, 3, 3, '#f0e2b0');\\n          for (const v of RT.visitors) GAME.Art.bust(g, v.id, { expr: 'smile' }, v.x - 16, v.y - 28, 36);\\n          px.disc(g, RT.hero.x, RT.hero.y, 5, '#e8443a');\\n          E.font.text(g, 'WARD', 8, 8, '#5ff0e0', { scale: 2, outline: '#06141a' });\\n          if (RT.nearDoor) E.font.text(g, game.input.label('interact'), RT.door.x, RT.door.y - 22, '#e8fbf6', { align: 'center', outline: '#06141a' });\\n          if (RT.line && RT.lineT > 0) E.font.text(g, RT.line, r.W / 2, r.H - 28, '#e8fbf6', { align: 'center', outline: '#06141a', wrap: r.W - 24 });\\n          if (RT.devOpen) drawDev(g, r);\\n        });\\n      },\\n    },\\n    credits: {\\n      view: 'side', camera: CAM,\\n      enter() { RT.creditPage = 0; },\\n      update() {\\n        const I = game.input;\\n        const pages = creditPages();\\n        if (I.pressed('confirm') || I.pressed('right') || I.pressed('start')) {\\n          RT.creditPage += 1;\\n          if (RT.creditPage >= pages.length) {\\n            RT.redirect = false;\\n            if (story._held) story.resume();\\n            if (!RT.redirect) go('story');\\n          }\\n        } else if (I.pressed('left') && RT.creditPage > 0) RT.creditPage -= 1;\\n      },\\n      draw(r) {\\n        const pages = creditPages();\\n        const page = pages[Math.min(RT.creditPage, pages.length - 1)];\\n        r.sky(['#070c14', '#142028']);\\n        r.overlay(g => {\\n          GAME.Art.stage(g, 'harbor', r.W, r.H, game.real);\\n          E.font.text(g, page.title, r.W / 2, 16, '#5ff0e0', { align: 'center', scale: 2, outline: '#06141a' });\\n          const body = page.body || '';\\n          E.font.text(g, body, 16, 44, '#e8fbf6', { outline: '#06141a', wrap: r.W - 32 });\\n          E.font.text(g, game.input.label('confirm'), r.W - 8, r.H - 14, '#8fb8b0', { align: 'right', outline: false });\\n        });\\n      },\\n    },\\n    about: {\\n      view: 'side', camera: CAM,\\n      enter() { RT.creditPage = 0; },\\n      update() {\\n        const I = game.input;\\n        const pages = aboutPages();\\n        if (I.pressed('cancel')) { go('menu'); return; }\\n        if (I.pressed('confirm') || I.pressed('right')) {\\n          RT.creditPage = Math.min(pages.length - 1, RT.creditPage + 1);\\n        } else if (I.pressed('left') && RT.creditPage > 0) RT.creditPage -= 1;\\n      },\\n      draw(r) {\\n        const pages = aboutPages();\\n        const page = pages[RT.creditPage] || pages[0];\\n        r.sky(['#071018', '#102028']);\\n        r.overlay(g => {\\n          E.font.text(g, page.title, 12, 8, '#5ff0e0', { scale: 2, outline: '#06141a' });\\n          E.font.text(g, page.body, 12, 32, '#e8fbf6', { outline: '#06141a', wrap: r.W - 24 });\\n        });\\n      },\\n    },\\n    attract: {\\n      view: 'side', camera: CAM,\\n      enter() {\\n        RT.attract = true;\\n        RT.seg = 0;\\n        startSegment();\\n      },\\n      exit() { RT.attract = false; },\\n      update(dt) {\\n        const seg = REEL[RT.seg];\\n        RT.segT += dt;\\n        if (seg.kind === 'story' && RT.reelStory) RT.reelStory.update(dt);\\n        if ((seg.kind === 'op' || seg.kind === 'rounds') && RT.S && !RT.S.won && !RT.S.lost) {\\n          game.focus(game.W / 2, game.H / 2, 0);\\n          drive(RT.S, dt, { bots: true });\\n        }\\n        if (RT.segT >= seg.t) {\\n          RT.seg += 1;\\n          if (RT.seg >= REEL.length) { RT.seg = 0; RT.loops += 1; }\\n          startSegment();\\n        }\\n      },\\n      draw(r) {\\n        const seg = REEL[RT.seg];\\n        if (seg.kind === 'title') drawTitle(r, game.real);\\n        else if (seg.kind === 'card') {\\n          r.sky(['#071018', '#102028']);\\n          r.overlay(g => {\\n            E.font.text(g, 'DEMO', r.W / 2, 40, '#f5b700', { align: 'center', scale: 2, outline: '#06141a' });\\n            E.font.text(g, TITLE, r.W / 2, 70, '#e8fbf6', { align: 'center', outline: '#06141a' });\\n          });\\n        } else if (seg.kind === 'story') {\\n          r.sky(['#071018', '#102028']);\\n          r.overlay(g => {\\n            GAME.Art.stage(g, 'theatre', r.W, r.H, game.real);\\n            E.font.text(g, 'DEMO', 8, 8, '#f5b700', { scale: 2, outline: '#06141a' });\\n          });\\n          if (RT.reelStory) RT.reelStory.draw(r);\\n        } else drawOp(r, RT.S, true);\\n      },\\n    },\\n    hub: {\\n      view: 'overhead', camera: CAM, pausable: true,\\n      enter() { game.setView('overhead'); },\\n      update(dt) {\\n        const I = game.input;\\n        const info = H.info;\\n        if (!info) return;\\n        const server = !!(info.server || HUB.server || H.local < 0);\\n        if (H.phase === 'wait') {\\n          if (I.pressed('confirm') || I.pressed('start')) HUB.answer('ready');\\n          if (I.pressed('more')) HUB.answer('more');\\n          const c = I.clicked();\\n          if (c) HUB.answer(c[1] > game.H * 0.7 ? 'more' : 'ready');\\n          return;\\n        }\\n        if (H.phase === 'count' && HUB.time() >= 0) H.phase = 'play';\\n        if (H.phase !== 'play' || H.over) return;\\n        const S = RT.S;\\n        if (info.isHost && S) {\\n          game.focus(game.W / 2, game.H / 2, 0);\\n          const remote = applyHands();\\n          if (!server && H.local >= 0) {\\n            const mine = readLocal(S.players[H.local] || S.players[0]);\\n            remote[H.local] = mine;\\n          }\\n          drive(S, dt, { remote, bots: true });\\n          for (const key in remote) {\\n            const i = +key;\\n            const hnd = remote[i];\\n            if (hnd && hnd.x != null && S.players[i]) {\\n              /* host already applied x,y through the step */\\n            }\\n          }\\n          H.accS += dt;\\n          if (H.accS >= 1 / 12) { H.accS = 0; sendSnap(); }\\n        } else if (!server) {\\n          const p = { tool: 'forceps', x: 213, y: 150 };\\n          const mine = readLocal(p);\\n          H.accI += dt;\\n          if (H.accI >= 1 / 15) {\\n            H.accI = 0;\\n            const ptr = mine.mouse || [p.x, p.y];\\n            HUB.send({\\n              t: 'i', n: ++H.inN,\\n              x: Math.round(ptr[0]), y: Math.round(ptr[1]),\\n              trig: mine.trig > 0.3 ? 1 : 0,\\n              digit: mine.digit || 0,\\n            }, { to: info.host, reliable: false });\\n          }\\n        }\\n      },\\n      draw(r) {\\n        const info = H.info;\\n        if (info && (info.server || HUB.server)) return;\\n        if (H.phase === 'play' && RT.S && H.info && H.info.isHost) { drawOp(r, RT.S, false); return; }\\n        r.sky(['#071018', '#14504a']);\\n        r.overlay(g => {\\n          E.font.text(g, TITLE, 8, 8, '#e8fbf6', { outline: false });\\n          E.font.text(g, H.phase, 8, 22, '#5ff0e0', { outline: false });\\n          const left = H.card && H.card.left != null ? Math.ceil(H.card.left / 1000) : '';\\n          if (left !== '') E.font.text(g, String(left), 8, 36, '#f5b700', { outline: false });\\n          E.font.text(g, game.input.label('confirm'), 8, r.H - 28, '#e8fbf6', { outline: false });\\n          E.font.text(g, game.input.label('more'), 8, r.H - 16, '#8fb8b0', { outline: false });\\n          if (info) {\\n            info.players.forEach((q, i) => {\\n              const col = CFG.SEAT[i] || q.color || '#e8443a';\\n              E.px.disc(g, 20, 60 + i * 16, 4, col);\\n              E.font.text(g, String(q.name || ('P' + (i + 1))).slice(0, 12), 30, 54 + i * 16, col, { outline: false });\\n            });\\n          }\\n        });\\n      },\\n    },\\n  };\\n\\n  function aboutPages() {\\n    const A = GAME.ABOUT;\\n    const order = GAME.About.ORDER;\\n    const labels = GAME.About.LABELS;\\n    const src = order.map(k => labels[k] + ': ' + A.sourceInformation[k]).join('\\\\n');\\n    return [\\n      { title: 'Source Information', body: src },\\n      { title: 'Testing Feedback', body: A.testingFeedback.join('\\\\n') },\\n      { title: 'Engine Feedback', body: A.engineFeedback.join('\\\\n') },\\n      { title: 'Prompt Feedback', body: A.promptFeedback.join('\\\\n') },\\n    ];\\n  }\\n  function creditPages() {\\n    const cast = Object.keys(GAME.CAST).map(id => GAME.CAST[id].name + '  ' + GAME.CAST[id].role).join('\\\\n');\\n    return [{ title: 'Open Table', body: cast }].concat(aboutPages(), [\\n      { title: 'Incoming', body: 'A chart is on the night desk. The shift is over. The next one starts at seven.' },\\n    ]);\\n  }\\n\\n  game.saves.write = () => ({\\n    data: {\\n      ranks: RT.ranks, cleared: RT.cleared, saved: RT.saved, chapter: RT.chapter,\\n      story: story.state(), diff: RT.diff,\\n    },\\n    place: 'St. Erasmus Harbor Hospital',\\n    level: RT.chapter || 1,\\n  });\\n  game.saves.read = (save) => {\\n    const d = save && save.data || {};\\n    RT.ranks = d.ranks || {};\\n    RT.cleared = d.cleared || {};\\n    RT.saved = d.saved || {};\\n    RT.chapter = d.chapter || 1;\\n    RT.diff = d.diff || RT.diff;\\n    if (d.story) story.restore(d.story);\\n  };\\n  game.saves.canSave = false;\\n\\n  game.debug = {\\n    skipStory: false,\\n    driver: null,\\n    snapshot,\\n  };\\n  G.__ot = () => game.debug.snapshot();\\n  G.__hubProbe = () => ({\\n    phase: H.phase,\\n    over: !!H.over,\\n    host: !!(H.info && H.info.isHost),\\n    scene: game.sceneName,\\n    active: !!(HUB && HUB.active),\\n    players: (RT.S && RT.S.players || []).map(p => ({ id: p.id, x: p.x, y: p.y, tool: p.tool, trig: p.trig, actions: p.actions })),\\n    t: HUB && HUB.active ? HUB.time() : 0,\\n  });\\n  G.__hubInject = (x, y, trig) => {\\n    if (!H.info) return;\\n    if (H.info.isHost && RT.S) {\\n      const idx = H.local >= 0 ? H.local : 0;\\n      const p = RT.S.players[idx];\\n      if (p) { p.x = x; p.y = y; p.bx = x; p.by = y; p.trig = trig || 0; }\\n      return;\\n    }\\n    try {\\n      HUB.send({ t: 'i', n: ++H.inN, x, y, trig: trig || 0, digit: 0 }, { to: H.info.host, reliable: true });\\n    } catch (e) { /* not in a session */ }\\n  };\\n\\n  if (typeof document !== 'undefined') document.title = TITLE;\\n\\n  try { GAME.Audio.install(game); } catch (e) { /* headless */ }\\n  game.audio.sfxVolume = 1;\\n  game.audio.voiceVolume = 0.9;\\n  game.audio.volume = 0.7;\\n  if (game.audio.musicVolume == null || game.audio.musicVolume > 0.2) game.audio.musicVolume = 0.1;\\n  if (game.audio.applyVolume) game.audio.applyVolume();\\n\\n  game.start({\\n    scene: inSession ? 'hub' : 'title',\\n    scenes,\\n  });\\n  try { GAME.Audio.play(inSession ? 'theatre' : 'night'); } catch (e) { /* quiet */ }\\n\\n  if (inSession) connect();\\n\\n  GAME.Shell = { game, story, RT, snapshot, beginCase, people };\\n})();\\n\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/scenes/shell.js has been created successfully.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/scenes/shell.js has been created.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/scenes/shell.js\",\"edits\":{\"details\":[{\"old_string\":\"\",\"old_line\":1,\"new_string\":\"/* Scenes, input, attract reel, dev panel, and the Hub table. The sim stays free of drawing. */\\n(() => {\\n  const G = typeof window !== 'undefined' ? window : globalThis;\\n  const GAME = (G.GAME ||= {});\\n  const E = G.My3D2dge;\\n  const HUB = G.AIHub || null;\\n  const inSession = !!(HUB && HUB.active);\\n  const CFG = GAME.CFG;\\n  const TITLE = CFG.GAME_TITLE;\\n\\n  const RT = {\\n    diff: 'resident',\\n    prefsReady: false,\\n    S: null,\\n    def: null,\\n    mode: 'case',\\n    fromStory: false,\\n    redirect: false,\\n    chartFor: null,\\n    chartCase: null,\\n    light: null,\\n    miss: 0,\\n    leftOp: false,\\n    fieldKey: '',\\n    field: null,\\n    menu: null,\\n    devOpen: false,\\n    devTab: 0,\\n    devI: 0,\\n    cheatUsed: false,\\n    attract: false,\\n    loops: 0,\\n    seg: 0,\\n    segT: 0,\\n    mouseInit: false,\\n    mouseT: 0,\\n    idle: 0,\\n    suppress: 0,\\n    ranks: {},\\n    cleared: {},\\n    saved: {},\\n    chapter: 1,\\n    visitors: [],\\n    nearDoor: false,\\n    hero: { x: 200, y: 160, tx: null, ty: null },\\n    door: { x: 210, y: 180 },\\n    line: '',\\n    lineT: 0,\\n    creditPage: 0,\\n    logOpen: false,\\n    latched: false,\\n    pending: 'story',\\n    fileCase: 'c1',\\n    lobbyN: 1,\\n  };\\n  const PREFS = {\\n    assist: 0.6,\\n    cursor: 330,\\n    swap: false,\\n    sustain: 'hold',\\n    hints: true,\\n    blood: 'red',\\n    text: 1,\\n  };\\n  GAME.PREFS = PREFS;\\n\\n  const PERSON = {\\n    c1: 'agnes', c2: 'slide', c3: 'tam', c4: 'ned', c5: 'ilse', c6: 'oyelaran',\\n    c7: 'yusuf', c8: 'perpetua', c9: 'hollis', c10: 'percy', c11: 'clementine',\\n  };\\n\\n  const DEF = E.Input.DEFAULT;\\n  const INPUT = Object.assign({}, DEF, {\\n    up: ['ArrowUp', 'Pad12'],\\n    down: ['ArrowDown', 'Pad13'],\\n    left: ['ArrowLeft', 'Pad14'],\\n    right: ['ArrowRight', 'Pad15'],\\n    useTool: ['Pad7', 'Pad0', 'Mouse0', 'Space'],\\n    fine: ['Pad6', 'ShiftLeft', 'ShiftRight'],\\n    gift: ['Pad3', 'KeyF', 'Mouse1'],\\n    consult: ['Pad2', 'KeyC'],\\n    toolPrev: ['Pad4', 'KeyQ', 'WheelUp'],\\n    toolNext: ['Pad5', 'KeyE', 'WheelDown'],\\n    wheelHold: ['Mouse2'],\\n    curU: ['KeyW', 'ArrowUp'],\\n    curD: ['KeyS', 'ArrowDown'],\\n    curL: ['KeyA', 'ArrowLeft'],\\n    curR: ['KeyD', 'ArrowRight'],\\n    nudgeU: ['Pad12'],\\n    nudgeD: ['Pad13'],\\n    nudgeL: ['Pad14'],\\n    nudgeR: ['Pad15'],\\n    tool1: ['Digit1'], tool2: ['Digit2'], tool3: ['Digit3'], tool4: ['Digit4'],\\n    tool5: ['Digit5'], tool6: ['Digit6'], tool7: ['Digit7'], tool8: ['Digit8'],\\n    interact: ['Pad0', 'KeyE', 'Enter'],\\n    skip: ['Pad2', 'ControlLeft'],\\n    log: ['Pad3', 'KeyB'],\\n    more: ['Pad3', 'KeyM'],\\n  });\\n\\n  const SETTINGS = [\\n    { key: 'music', value: 0.1 },\\n    { key: 'glyphs', value: 'playstation', options: [['playstation', 'PlayStation'], ['xbox', 'Xbox']] },\\n    { key: 'voices', label: 'Voices', type: 'slider', group: 'Sound', value: 0.9, min: 0, max: 1, step: 0.05, apply: (g, v) => { g.audio.voiceVolume = v; if (g.audio.applyVolume) g.audio.applyVolume(); } },\\n    { key: 'difficulty', label: 'Difficulty', type: 'select', value: 'resident', options: [['intern', 'Intern'], ['resident', 'Resident'], ['attending', 'Attending']], apply: (g, v) => { RT.diff = v; } },\\n    { key: 'assist', label: 'Surgical assist', type: 'slider', value: 0.6, min: 0, max: 1.4, step: 0.05, apply: (g, v) => { PREFS.assist = v; } },\\n    { key: 'cursorSpeed', label: 'Cursor speed', type: 'slider', value: 330, min: 80, max: 500, step: 10, apply: (g, v) => { PREFS.cursor = v; } },\\n    { key: 'swapSticks', label: 'Swap sticks', type: 'toggle', value: false, apply: (g, v) => { PREFS.swap = !!v; } },\\n    { key: 'sustain', label: 'Sustained tools', type: 'select', value: 'hold', options: [['hold', 'Hold'], ['toggle', 'Toggle']], apply: (g, v) => { PREFS.sustain = v; } },\\n    { key: 'hints', label: 'Hints', type: 'toggle', value: true, apply: (g, v) => { PREFS.hints = !!v; } },\\n    { key: 'blood', label: 'Blood color', type: 'select', value: 'red', options: [['red', 'Red'], ['rose', 'Rose'], ['ink', 'Ink']], apply: (g, v) => { PREFS.blood = v; } },\\n    { key: 'textSpeed', label: 'Text speed', type: 'slider', value: 1, min: 0.5, max: 3, step: 0.25, apply: (g, v) => { PREFS.text = v; } },\\n  ];\\n\\n  const CONTROLS = {\\n    useTool: 'Use tool', fine: 'Steady hand', gift: 'The Steady', consult: 'Consult',\\n    toolPrev: 'Previous tool', toolNext: 'Next tool', wheelHold: 'Tool wheel',\\n    interact: 'Talk or use', more: 'Ask for more time',\\n    tool1: false, tool2: false, tool3: false, tool4: false, tool5: false, tool6: false, tool7: false, tool8: false,\\n  };\\n\\n  const game = new E.Game({\\n    canvas: 'screen',\\n    id: TITLE,\\n    res: [426, 240],\\n    expand: true,\\n    view: 'side',\\n    touch: 'never',\\n    draw: true,\\n    live: inSession,\\n    autoPause: !inSession,\\n    corner: !inSession,\\n    input: INPUT,\\n    menu: {\\n      quit: inSession ? false : 'title',\\n      saves: true,\\n      items: inSession ? [] : [['Dev Mode', () => GAME.openDev()]],\\n      settings: SETTINGS,\\n      controls: CONTROLS,\\n    },\\n  });\\n  game.input.names = CONTROLS;\\n\\n  const ui = new E.Shell(game, {\\n    tv: true,\\n    theme: {\\n      paper: 'rgba(6,22,26,.94)',\\n      accent: '#5ff0e0',\\n      line: 'rgba(95,240,224,.35)',\\n      ink: '#e8fbf6',\\n      muted: '#8fb8b0',\\n      danger: '#ff7a6a',\\n    },\\n  });\\n\\n  GAME.openDev = () => {\\n    if (inSession) return;\\n    RT.devOpen = true;\\n    RT.devTab = 0;\\n    RT.devI = 0;\\n    if (game.shell) game.shell.hide();\\n  };\\n\\n  function origin() {\\n    return [(game.W - CFG.FIELD_W) >> 1, (game.H - CFG.FIELD_H) >> 1];\\n  }\\n  function playTune() {\\n    const t = CFG.cloneTune(GAME.TUNE);\\n    t.hands.assist = PREFS.assist;\\n    t.hands.cursor = PREFS.cursor;\\n    return t;\\n  }\\n  function makeMenu(items, onPick, onCancel) {\\n    return new E.Menu(game, items, {\\n      scale: 2, rows: 6,\\n      color: '#e8fbf6', pick: '#5ff0e0', dim: '#8fb8b0',\\n      bg: '#06141a', border: '#5ff0e0',\\n      onPick, onCancel,\\n    });\\n  }\\n  function go(name, data) {\\n    game.go(name, data, { fade: game.fadeTime });\\n  }\\n\\n  const people = {};\\n  for (const id in GAME.CAST) {\\n    const c = GAME.CAST[id];\\n    people[id] = {\\n      name: c.name,\\n      portrait: (g, x, y, size) => {\\n        let expr = 'neutral';\\n        if (story.running && story.node) {\\n          const steps = story.nodes[story.node];\\n          const line = steps && steps[story._i - 1];\\n          if (line && line.who === id && line.expr) expr = line.expr;\\n        }\\n        GAME.Art.bust(g, id, { expr }, x, y, size || 40);\\n      },\\n    };\\n  }\\n  const story = new E.Story(game, {\\n    people,\\n    nodes: GAME.NODES,\\n    on: {\\n      op(st, step) {\\n        RT.fromStory = true;\\n        RT.redirect = true;\\n        const id = step.caseId;\\n        if (GAME.LIGHT[id] && RT.chartFor !== id) go('chart', { caseId: id });\\n        else {\\n          beginCase(id, { difficulty: RT.diff, seed: 3, fromStory: true });\\n          go('op');\\n        }\\n      },\\n      ward() {\\n        RT.redirect = true;\\n        go('ward');\\n      },\\n      credits() {\\n        RT.redirect = true;\\n        RT.creditPage = 0;\\n        go('credits');\\n      },\\n    },\\n  });\\n  story.talk.voice = (ch) => { try { GAME.Audio.blip(ch); } catch (e) { /* quiet */ } };\\n  story.talk.bg = '#06141a';\\n  story.talk.border = '#5ff0e0';\\n  story.talk.color = '#e8fbf6';\\n  story.talk.nameColor = '#5ff0e0';\\n\\n  function beginCase(id, opts) {\\n    opts = opts || {};\\n    let def = GAME.CASES[id];\\n    if (id === 'ferry' || (def && def.id === 'ferry')) def = GAME.roundsCase(opts.players || 1);\\n    if (!def) return null;\\n    RT.def = def;\\n    RT.mode = opts.mode || def.mode || 'case';\\n    if (opts.fromStory != null) RT.fromStory = opts.fromStory;\\n    const S = GAME.Op.create(def, {\\n      seed: opts.seed == null ? 3 : opts.seed,\\n      difficulty: opts.difficulty || RT.diff || 'resident',\\n      players: opts.players || 1,\\n      phase: opts.phase || 0,\\n    });\\n    if (opts.clockDelta) S.clock += opts.clockDelta;\\n    if (opts.steadyDelta) S.steady += opts.steadyDelta;\\n    if (opts.cheat) S.cheat = Object.assign({}, S.cheat, opts.cheat);\\n    RT.S = S;\\n    RT.leftOp = false;\\n    RT.fieldKey = '';\\n    return S;\\n  }\\n  GAME.beginCase = beginCase;\\n\\n  function recordRank() {\\n    const S = RT.S;\\n    if (!S || !S.won || RT.attract || RT.cheatUsed || GAME.TUNE.dirty) return;\\n    if (S.lab || S.mode === 'rounds' || S.id === 'lab' || S.id === 'ferry') return;\\n    const ch = S.cheat || {};\\n    if (ch.reveal || ch.infSteady || ch.lockVitals || ch.freezeClock || ch.oneHit) return;\\n    RT.ranks[S.id] = S.rank;\\n    RT.cleared[S.id] = true;\\n    if (PERSON[S.id]) RT.saved[PERSON[S.id]] = true;\\n    const def = GAME.CASES[S.id];\\n    if (def && def.chapter) RT.chapter = def.chapter;\\n  }\\n\\n  function resumeHeld() {\\n    if (!(RT.fromStory && story._held)) return false;\\n    RT.redirect = false;\\n    story.resume();\\n    if (!RT.redirect) go('story');\\n    return true;\\n  }\\n\\n  function leaveResults() {\\n    if (resumeHeld()) return;\\n    const S = RT.S;\\n    if (S && (S.lab || S.id === 'lab')) { go('menu'); return; }\\n    if (RT.mode === 'rounds' || (S && S.mode === 'rounds')) { go('lobby'); return; }\\n    if (S && S.won && RT.fromStory) { go('ward'); return; }\\n    go('menu');\\n  }\\n\\n  function readLocal(p) {\\n    const I = game.input;\\n    const [ox, oy] = origin();\\n    let digit = 0;\\n    for (let n = 1; n <= 8; n++) if (I.pressed('tool' + n)) digit = n;\\n    const tools = CFG.TOOLS;\\n    const idx = Math.max(0, tools.indexOf(p.tool));\\n    if (!digit && I.pressed('toolNext')) digit = (idx % 8) + 1 === idx + 1 ? ((idx + 1) % 8) + 1 : ((idx + 1) % 8) + 1;\\n    if (!digit && I.pressed('toolNext')) digit = ((idx + 1) % 8) + 1;\\n    if (I.pressed('toolPrev')) digit = ((idx + 7) % 8) + 1;\\n    if (I.pressed('toolNext')) digit = ((idx + 1) % 8) + 1;\\n    const devOpen = RT.devOpen;\\n    const keys = devOpen ? [0, 0] : [\\n      (I.down('curR') ? 1 : 0) - (I.down('curL') ? 1 : 0),\\n      (I.down('curD') ? 1 : 0) - (I.down('curU') ? 1 : 0),\\n    ];\\n    const nudge = devOpen ? [0, 0] : [\\n      (I.down('nudgeR') ? 1 : 0) - (I.down('nudgeL') ? 1 : 0),\\n      (I.down('nudgeD') ? 1 : 0) - (I.down('nudgeU') ? 1 : 0),\\n    ];\\n    const swap = !!PREFS.swap;\\n    const aim = (swap ? I.padMove : I.padAim) || [0, 0];\\n    const move = (swap ? (I.padAim || [0, 0]) : (I.padMove || [0, 0]));\\n    let mouse = null;\\n    const ptr = I.pointer();\\n    if (ptr && (I.lastDevice === 'mouse' || I._fedAt)) mouse = [ptr[0] - ox, ptr[1] - oy];\\n    let trig = I.value('useTool') || 0;\\n    if (PREFS.sustain === 'toggle') {\\n      if (I.pressed('useTool')) RT.latched = !RT.latched;\\n      trig = RT.latched ? 1 : 0;\\n    }\\n    const pan = I.pan();\\n    if (!digit && I.down('wheelHold') && pan && Math.hypot(pan[0], pan[1]) > 8) {\\n      move[0] += pan[0] / Math.max(8, Math.hypot(pan[0], pan[1]));\\n      move[1] += pan[1] / Math.max(8, Math.hypot(pan[0], pan[1]));\\n    }\\n    return {\\n      digit, mouse, aim, move, keys, nudge,\\n      fine: I.down('fine'),\\n      trig,\\n      gift: I.down('gift'),\\n      consult: I.down('consult'),\\n      cancel: I.down('cancel'),\\n    };\\n  }\\n\\n  function drive(S, dt, opts) {\\n    opts = opts || {};\\n    const inputs = [];\\n    const n = S.players.length;\\n    for (let i = 0; i < n; i++) {\\n      const p = S.players[i];\\n      if (p.gone) { inputs.push({ tool: p.tool, trig: 0 }); continue; }\\n      let dev;\\n      if (opts.remote && opts.remote[i]) {\\n        dev = opts.remote[i];\\n      } else if (i === 0 && game.debug && game.debug.driver && !RT.attract) {\\n        dev = game.debug.driver(S, dt) || GAME.Bot.device(S, 0, dt);\\n      } else if (i === 0 && RT.auto && !RT.attract) {\\n        dev = GAME.Bot.device(S, 0, dt);\\n      } else if (i === 0 && !opts.bots && !RT.attract) {\\n        dev = readLocal(p);\\n      } else {\\n        dev = GAME.Bot.device(S, i, dt);\\n      }\\n      GAME.Wheel.update(p, dev, dt);\\n      const tune = playTune();\\n      if (dev.mouse) GAME.Cursor.update(p, { mouse: dev.mouse, fine: dev.fine }, S, dt, tune);\\n      else GAME.Cursor.update(p, { aim: dev.aim, keys: dev.keys, nudge: dev.nudge, fine: dev.fine }, S, dt, tune);\\n      const row = {\\n        tool: p.tool,\\n        trig: dev.trig || 0,\\n        fine: !!dev.fine,\\n        gift: !!dev.gift,\\n        consult: !!dev.consult,\\n        cancel: !!dev.cancel,\\n        mouse: !!dev.mouse,\\n      };\\n      if (dev.x != null) { row.x = dev.x; row.y = dev.y; }\\n      inputs.push(row);\\n    }\\n    try { GAME.Op.step(S, inputs, dt, playTune()); }\\n    catch (e) { game.fail('op', e); }\\n    if (S.ev) for (const ev of S.ev) { try { GAME.Audio.onEv(ev); } catch (err) { /* quiet */ } }\\n    return S;\\n  }\\n\\n  function fieldOf(S) {\\n    const key = (S.site || 'abdomen') + ':' + (S.seed || 1) + ':' + game.W + 'x' + game.H;\\n    if (RT.fieldKey !== key) {\\n      RT.field = GAME.Art.fieldFor(S.site || 'abdomen', S.seed || 1, game.W, game.H);\\n      RT.fieldKey = key;\\n    }\\n    return RT.field;\\n  }\\n\\n  const COL = {\\n    shard: '#d5dee6', laceration: '#e05050', wound: '#c43030', bleeder: '#ff4040', arteryTear: '#ff2060',\\n    pool: '#601828', polyp: '#e08898', mass: '#c06078', clot: '#682838', patch: '#e07070',\\n    nerve: '#e2c14a', eloquent: '#f0d060', retractor: '#c8d0d4', bead: '#5ff0e0', nest: '#14383c',\\n    lobe: '#7a5cff', eye: '#d0c8ff', tendril: '#3ec8b0', uvula: '#9a78ff', voice: '#5ff0e0', reed: '#8fd0c8',\\n    repeat: '#f5b700', slur: '#9ad8d0', hook: '#d0d4d8', screw: '#e8e0c8', wire: '#f0d060', lead: '#88e0c8',\\n    cut: '#f2f0e6', fed: '#401018', bite: '#e05050',\\n  };\\n  function bloodCol() {\\n    if (PREFS.blood === 'rose') return '#e07098';\\n    if (PREFS.blood === 'ink') return '#2a2030';\\n    return null;\\n  }\\n\\n  function drawOp(r, S, ribbon) {\\n    const [ox, oy] = origin();\\n    r.sky(['#071018', '#102028']);\\n    const F = S ? fieldOf(S) : null;\\n    const allow = (typeof document !== 'undefined') || GAME.Art.force;\\n    if (allow && F) {\\n      try { F.shade({ beat: ((S.t || 0) % 1), slow: !!S.breath, dim: S.dim || 0 }); }\\n      catch (e) { /* painter */ }\\n    }\\n    r.overlay(g => {\\n      const px = E.px;\\n      if (F && F.cv && F.cv.width) { try { g.drawImage(F.cv, 0, 0); } catch (e) { /* no image */ } }\\n      px.rect(g, 0, 0, r.W, Math.max(0, oy), '#102830');\\n      px.rect(g, 0, oy + CFG.FIELD_H, r.W, Math.max(0, r.H - oy - CFG.FIELD_H), '#102830');\\n      px.rect(g, 0, oy, Math.max(0, ox), CFG.FIELD_H, '#102830');\\n      px.rect(g, ox + CFG.FIELD_W, oy, Math.max(0, r.W - ox - CFG.FIELD_W), CFG.FIELD_H, '#102830');\\n      px.rect(g, ox + 8, oy + 8, CFG.FIELD_W - 16, CFG.FIELD_H - 16, '#0c2428');\\n      if (!S) return;\\n      const ink = bloodCol();\\n      for (const o of S.objects) {\\n        if (!o.alive && o.type !== 'retractor') continue;\\n        if (o.hidden && !o.marked) continue;\\n        const x = o.x + ox, y = o.y + oy;\\n        let c = COL[o.type] || '#9ad0c8';\\n        if (ink && (o.type === 'bleeder' || o.type === 'pool' || o.type === 'wound' || o.type === 'laceration' || o.type === 'arteryTear')) c = ink;\\n        const rad = o.type === 'pool' ? 8 + (o.vol || 0) * 0.15 : o.type === 'mass' ? (o.rad || 12) : o.type === 'bead' ? 3 : 4;\\n        if (o.guide && o.guide.length > 1 && (o.type === 'cut' || o.type === 'mass' || o.type === 'slur')) {\\n          for (let k = 1; k < o.guide.length; k++) px.line(g, o.guide[k - 1][0] + ox, o.guide[k - 1][1] + oy, o.guide[k][0] + ox, o.guide[k][1] + oy, '#f2f0e6', 1);\\n        }\\n        px.disc(g, x, y, rad, o.done ? '#2a403c' : c);\\n        if (o.marked) px.disc(g, x, y, rad + 3, '#5ff0e0');\\n      }\\n      if (S.breath) {\\n        px.rect(g, ox + 20, oy + 16, CFG.FIELD_W - 40, 2, '#bfefff');\\n        px.rect(g, ox + 20, oy + CFG.FIELD_H - 18, CFG.FIELD_W - 40, 2, '#bfefff');\\n      }\\n      for (const p of S.players) if (!p.gone) GAME.Art.drawHand(g, p, ox, oy);\\n      const vit = Math.max(0, Math.ceil(S.vitals));\\n      const clk = Math.max(0, Math.ceil(S.clock));\\n      E.font.text(g, 'VIT ' + vit, 8, 6, vit < 30 ? '#ff7a6a' : '#e8fbf6', { scale: 2, outline: '#06141a' });\\n      E.font.text(g, 'CLK ' + clk, 8, 26, clk < 20 ? '#ff7a6a' : '#e8fbf6', { scale: 2, outline: '#06141a' });\\n      E.font.text(g, (S.phaseName || '') + '  ' + (S.activeDoc || ''), 8, 48, '#8fb8b0', { outline: '#06141a' });\\n      const tool = (S.players[0] && S.players[0].tool) || 'forceps';\\n      GAME.Art.toolIcon(g, tool, r.W - 28, r.H - 28, 1);\\n      E.font.text(g, tool.toUpperCase(), r.W - 8, r.H - 36, '#e8fbf6', { align: 'right', outline: '#06141a' });\\n      if (PREFS.hints) E.font.text(g, game.input.label('useTool'), r.W - 8, r.H - 14, '#5ff0e0', { align: 'right', outline: false });\\n      const steady = Math.round(S.steady || 0);\\n      E.font.text(g, 'STEADY ' + steady, 8, r.H - 16, '#5ff0e0', { outline: '#06141a' });\\n      if (S.codeBlue) E.font.text(g, 'SHOCK', r.W / 2, 64, '#ff7a6a', { align: 'center', scale: 2, outline: '#06141a' });\\n      if (S.dressing) E.font.text(g, 'DRESSING', r.W / 2, 64, '#f2f0e6', { align: 'center', scale: 2, outline: '#06141a' });\\n      if (ribbon) E.font.text(g, 'DEMO', r.W - 8, 6, '#f5b700', { align: 'right', scale: 2, outline: '#06141a' });\\n      if (GAME.TUNE.dirty || RT.cheatUsed) E.font.text(g, 'DEV', 8, 66, '#f5b700', { outline: '#06141a' });\\n      if (S.t != null && GAME.BARKS && GAME.BARKS.length) {\\n        const bark = GAME.BARKS[Math.floor(S.t / 4) % GAME.BARKS.length];\\n        E.font.text(g, bark, r.W / 2, r.H - 28, '#d8e4dc', { align: 'center', outline: '#06141a' });\\n      }\\n      if (RT.devOpen) drawDev(g, r);\\n    });\\n  }\\n\\n  const CHEATS = [\\n    ['reveal', 'Reveal'],\\n    ['infSteady', 'Infinite Steady'],\\n    ['lockVitals', 'Lock vitals'],\\n    ['freezeClock', 'Freeze clock'],\\n    ['oneHit', 'One hit'],\\n    ['auto', 'Autosurgeon'],\\n    ['slow', 'Slow motion'],\\n    ['win', 'Clear phase'],\\n    ['lose', 'Force a loss'],\\n    ['code', 'Vitals to zero'],\\n  ];\\n  const SLOW = [0.25, 0.5, 1, 2];\\n\\n  function devRows() {\\n    if (RT.devTab === 1) return CHEATS.map(c => c[1]);\\n    if (RT.devTab === 2) {\\n      const rows = [];\\n      for (const id of GAME.ORDER) {\\n        const def = GAME.CASES[id];\\n        const n = (def.phases || []).length;\\n        for (let p = 0; p < n; p++) rows.push(id + ' ' + (def.phases[p].name || p));\\n      }\\n      rows.push('Grand Rounds');\\n      rows.push('Skills Lab');\\n      return rows;\\n    }\\n    return GAME.Dev.KEYS.map(k => k[0]).concat(['Reset tuning']);\\n  }\\n\\n  function devAct(dir) {\\n    RT.cheatUsed = RT.devTab !== 0 || RT.cheatUsed;\\n    const S = RT.S;\\n    if (RT.devTab === 0) {\\n      const keys = GAME.Dev.KEYS;\\n      if (RT.devI >= keys.length) { if (dir === 0) GAME.Dev.reset(); return; }\\n      const [path, lo, hi] = keys[RT.devI];\\n      const [g, k] = path.split('.');\\n      const step = (hi - lo) / 20;\\n      const cur = GAME.TUNE[g][k];\\n      const v = Math.max(lo, Math.min(hi, Math.round((cur + dir * step) * 1000) / 1000));\\n      GAME.Dev.set(path, v);\\n      return;\\n    }\\n    if (dir !== 0 && RT.devTab !== 1) return;\\n    if (RT.devTab === 1 && dir === 0) {\\n      const key = CHEATS[RT.devI][0];\\n      if (key === 'auto') { RT.auto = !RT.auto; RT.cheatUsed = true; return; }\\n      if (key === 'slow') {\\n        const i = SLOW.indexOf(game.timeScale);\\n        game.timeScale = SLOW[(i + 1) % SLOW.length] || 1;\\n        RT.cheatUsed = true;\\n        return;\\n      }\\n      if (key === 'win' && S) {\\n        RT.cheatUsed = true;\\n        for (const o of S.objects) { o.done = true; o.prog = 1; }\\n        S.hold = false;\\n        return;\\n      }\\n      if (key === 'lose' && S) { RT.cheatUsed = true; GAME.Sim.lose(S, 'dev'); return; }\\n      if (key === 'code' && S) { RT.cheatUsed = true; S.vitals = 0; return; }\\n      if (S) {\\n        S.cheat = S.cheat || {};\\n        const on = !S.cheat[key];\\n        GAME.Dev.cheat(S, key, on);\\n        RT.cheatUsed = true;\\n      }\\n      return;\\n    }\\n    if (RT.devTab === 2 && dir === 0) {\\n      const rows = devRows();\\n      const label = rows[RT.devI] || '';\\n      RT.cheatUsed = true;\\n      if (label === 'Grand Rounds') { beginCase('ferry', { players: 1, fromStory: false }); go('op'); return; }\\n      if (label === 'Skills Lab') { beginCase('lab', { fromStory: false }); go('op'); return; }\\n      const id = label.slice(0, 3);\\n      const def = GAME.CASES[id];\\n      if (!def) return;\\n      const name = label.slice(4);\\n      let phase = 0;\\n      (def.phases || []).forEach((ph, i) => { if ((ph.name || String(i)) === name) phase = i; });\\n      beginCase(id, { phase, fromStory: false });\\n      go('op');\\n    }\\n  }\\n\\n  function handleDev() {\\n    if (!RT.devOpen || inSession) return false;\\n    const I = game.input;\\n    const rows = devRows();\\n    if (I.pressed('cancel')) { RT.devOpen = false; I.consumeAll(); return true; }\\n    if (I.pressed('toolPrev')) RT.devTab = (RT.devTab + 2) % 3;\\n    if (I.pressed('toolNext')) RT.devTab = (RT.devTab + 1) % 3;\\n    if (I.pressed('up')) RT.devI = (RT.devI + rows.length - 1) % rows.length;\\n    if (I.pressed('down')) RT.devI = (RT.devI + 1) % rows.length;\\n    if (RT.devI >= rows.length) RT.devI = 0;\\n    if (I.pressed('left')) devAct(-1);\\n    if (I.pressed('right') || I.pressed('confirm')) devAct(I.pressed('confirm') ? 0 : 1);\\n    return true;\\n  }\\n\\n  function drawDev(g, r) {\\n    const px = E.px;\\n    const rows = devRows();\\n    const tabs = ['Tune', 'Cheats', 'Jump'];\\n    px.rect(g, r.W - 168, 8, 160, r.H - 16, '#06141a');\\n    E.font.text(g, tabs[RT.devTab], r.W - 160, 12, '#f5b700', { outline: false });\\n    const first = Math.max(0, Math.min(RT.devI - 6, rows.length - 12));\\n    for (let i = 0; i < 12 && first + i < rows.length; i++) {\\n      const k = first + i;\\n      const on = k === RT.devI;\\n      E.font.text(g, (on ? '> ' : '  ') + rows[k], r.W - 160, 28 + i * 12, on ? '#5ff0e0' : '#8fb8b0', { outline: false });\\n    }\\n  }\\n\\n  function drawTitle(r, t) {\\n    r.sky(['#071018', '#0e2430']);\\n    r.overlay(g => {\\n      GAME.Art.titleBackdrop(g, r.W, r.H, t || game.real || 0);\\n      E.font.title(g, 'OPEN TABLE', r.W / 2, 28, { scale: 2, align: 'center', colors: ['#f4fff8', '#9aefe4', '#1c6e78'] });\\n      E.font.text(g, TITLE, r.W / 2, 78, '#e8fbf6', { align: 'center', scale: 1, outline: '#06141a' });\\n      E.font.text(g, \\\"Don't let it go quiet\\\", r.W / 2, 96, '#5ff0e0', { align: 'center', outline: false });\\n      const y = 120;\\n      let x = 24;\\n      const beat = [0, 2, 0, 6, 0, 2, 8, 0, 1, 0, 4, 0];\\n      for (let i = 0; i < beat.length; i++) {\\n        const h = 2 + beat[i];\\n        E.px.rect(g, x, y - h, 6, h, '#7CFFB2');\\n        x += 10;\\n      }\\n      const prompt = game.input.label('confirm');\\n      E.font.text(g, prompt, r.W / 2, r.H - 28, '#e8fbf6', { align: 'center', scale: 2, outline: '#06141a' });\\n    });\\n  }\\n\\n  function snapshot() {\\n    const S = RT.S;\\n    const [ox, oy] = origin();\\n    let mark = null;\\n    if (RT.light && RT.light.mark) mark = [ox + RT.light.mark[0], oy + RT.light.mark[1]];\\n    const choice = !!(story.talk && story.talk.open && story.talk.choices && story.talk.choices.length && !story.talk.typing);\\n    return {\\n      scene: game.sceneName,\\n      menu: RT.menu ? { i: RT.menu.i, labels: RT.menu.items.map(it => (typeof it === 'string' ? it : it.label)) } : null,\\n      story: story.running ? story.node : null,\\n      held: !!story._held,\\n      choice,\\n      op: S ? {\\n        id: S.id, won: !!S.won, lost: !!S.lost, phase: S.phase, phaseName: S.phaseName,\\n        clock: S.clock, vitals: S.vitals, score: S.score, rank: S.rank,\\n        breath: !!S.breath, worldScale: S.worldScale, closed: !!S.closed,\\n      } : null,\\n      lightbox: mark,\\n      ward: { patients: RT.visitors.slice(), nearDoor: !!RT.nearDoor },\\n      attract: RT.attract ? { on: true, loops: RT.loops, seg: RT.seg } : null,\\n      dev: { open: !!RT.devOpen, dirty: !!GAME.TUNE.dirty },\\n      ranks: Object.assign({}, RT.ranks),\\n      cleared: Object.assign({}, RT.cleared),\\n      reel: RT.loops,\\n    };\\n  }\\n\\n  const REEL = [\\n    { kind: 'story', t: 4 },\\n    { kind: 'op', id: 'c1', t: 15, cheat: { lockVitals: true, freezeClock: true, oneHit: true } },\\n    { kind: 'op', id: 'c3', t: 8, cheat: { lockVitals: true, freezeClock: true, oneHit: true } },\\n    { kind: 'op', id: 'c6', t: 8, cheat: { lockVitals: true, freezeClock: true, oneHit: true } },\\n    { kind: 'op', id: 'c7', t: 8, cheat: { lockVitals: true, freezeClock: true, infSteady: true } },\\n    { kind: 'rounds', t: 8 },\\n    { kind: 'op', id: 'c11', t: 8, cheat: { lockVitals: true, freezeClock: true, oneHit: true } },\\n    { kind: 'card', t: 4 },\\n    { kind: 'title', t: 8 },\\n  ];\\n\\n  function startSegment() {\\n    const seg = REEL[RT.seg];\\n    RT.segT = 0;\\n    if (seg.kind === 'op') {\\n      const S = beginCase(seg.id, { fromStory: false, cheat: seg.cheat, seed: 3 });\\n      if (S) S.mode = 'attract';\\n      game.setView('overhead');\\n    } else if (seg.kind === 'rounds') {\\n      const S = beginCase('ferry', { players: 4, fromStory: false, cheat: { lockVitals: true, freezeClock: true, oneHit: true } });\\n      if (S) S.mode = 'attract';\\n      game.setView('overhead');\\n    } else if (seg.kind === 'story') {\\n      game.setView('side');\\n      if (!RT.reelStory) {\\n        RT.reelStory = new E.Story(game, {\\n          people,\\n          nodes: { beat: [GAME.NODES.start[0]] },\\n          on: {},\\n        });\\n      }\\n      RT.reelStory.skip = true;\\n      RT.reelStory.run('beat');\\n    } else game.setView('side');\\n  }\\n\\n  const H = {\\n    info: null,\\n    phase: 'solo',\\n    over: false,\\n    accS: 0,\\n    accI: 0,\\n    snapN: 0,\\n    inN: 0,\\n    heard: 0,\\n    hands: {},\\n    view: null,\\n    card: null,\\n    local: -1,\\n  };\\n\\n  function hubFinish() {\\n    if (H.over || !H.info || !H.info.isHost) return;\\n    H.over = true;\\n    const info = H.info;\\n    const S = RT.S;\\n    const scoreOf = (id) => {\\n      const idx = info.players.findIndex(q => q.id === id);\\n      const p = S && S.players[idx];\\n      return p ? (p.actions | 0) : 0;\\n    };\\n    const ids = info.players.map(q => q.id);\\n    ids.sort((a, b) => scoreOf(b) - scoreOf(a));\\n    const standings = [];\\n    for (const id of ids) {\\n      const last = standings[standings.length - 1];\\n      if (last && scoreOf(last[0]) === scoreOf(id)) last.push(id);\\n      else standings.push([id]);\\n    }\\n    const scores = {};\\n    for (const id of ids) scores[id] = scoreOf(id);\\n    const best = ids[0];\\n    const detail = (scores[best] || 0) + ' clean actions';\\n    const awards = best == null ? [] : [{ id: best, title: 'Steadiest Hand', detail: detail.slice(0, 40) }];\\n    try { HUB.send({ t: 'over', n: ++H.snapN }); } catch (e) { /* late */ }\\n    HUB.finish({\\n      standings,\\n      scores,\\n      won: !!(S && S.closed),\\n      awards,\\n      stats: { clock: S ? Math.round(S.clock) : 0, vitals: S ? Math.round(S.vitals) : 0 },\\n    });\\n  }\\n\\n  const TYPE_N = {};\\n  ['shard', 'laceration', 'wound', 'bleeder', 'arteryTear', 'pool', 'polyp', 'mass', 'clot', 'bead', 'nest', 'lobe', 'eye', 'tendril', 'voice', 'repeat', 'retractor'].forEach((t, i) => { TYPE_N[t] = i + 1; });\\n\\n  function sendSnap() {\\n    const S = RT.S;\\n    const info = H.info;\\n    if (!S || !info) return;\\n    const objs = [];\\n    for (const o of S.objects) {\\n      if (objs.length >= 28) break;\\n      if (o.done && o.type !== 'retractor') continue;\\n      let flags = (o.done ? 1 : 0) | (o.hidden ? 2 : 0) | (o.marked ? 4 : 0) | (o.alive ? 8 : 0);\\n      objs.push([o.id, o.x | 0, o.y | 0, TYPE_N[o.type] || 0, flags]);\\n    }\\n    const ps = info.players.map((q, i) => {\\n      const p = S.players[i];\\n      if (!p) return [q.id, 0, 0, 0, 0, 0, 1];\\n      const tool = Math.max(0, CFG.TOOLS.indexOf(p.tool));\\n      return [q.id, p.x | 0, p.y | 0, tool, p.trig > 0.3 ? 1 : 0, p.actions | 0, p.gone ? 1 : 0];\\n    });\\n    HUB.send({\\n      t: 's', n: ++H.snapN,\\n      clock: S.clock | 0, vitals: S.vitals | 0, phase: S.phase | 0,\\n      won: S.won ? 1 : 0, closed: S.closed ? 1 : 0, breath: S.breath ? 1 : 0,\\n      o: objs, p: ps,\\n    }, { reliable: false });\\n  }\\n\\n  function applyHands() {\\n    const remote = {};\\n    const info = H.info;\\n    if (!info) return remote;\\n    for (const key in H.hands) {\\n      const i = +key;\\n      const hnd = H.hands[key];\\n      if (!hnd) continue;\\n      remote[i] = { x: hnd.x, y: hnd.y, trig: hnd.trig || 0, digit: hnd.digit || 0, aim: [0, 0], mouse: null };\\n    }\\n    return remote;\\n  }\\n\\n  async function connect() {\\n    if (!HUB || !HUB.active) { H.phase = 'solo'; return; }\\n    let info = null;\\n    try { info = await HUB.connect({ mode: 'shared-world', seats: [1, 4], card: true }); }\\n    catch (e) { H.phase = 'solo'; return; }\\n    if (!info) { H.phase = 'solo'; return; }\\n    H.info = info;\\n    H.phase = 'wait';\\n    H.local = info.players.findIndex(q => q.id === info.me);\\n    HUB.on('card', c => { H.card = c; });\\n    HUB.on('start', () => { H.phase = 'count'; });\\n    HUB.on('message', (d, from) => {\\n      if (!d) return;\\n      if (info.isHost) {\\n        if (d.t === 'i') {\\n          const idx = info.players.findIndex(q => q.id === from);\\n          if (idx >= 0) H.hands[idx] = { x: d.x, y: d.y, trig: d.trig || 0, digit: d.digit || 0, n: d.n || 0 };\\n        }\\n      } else if (from === info.host && d.t === 's' && d.n > H.heard) {\\n        H.heard = d.n;\\n        H.view = d;\\n      }\\n    });\\n    HUB.on('leave', ({ id }) => {\\n      const idx = info.players.findIndex(q => q.id === id);\\n      if (RT.S && RT.S.players[idx]) RT.S.players[idx].gone = true;\\n    });\\n    HUB.on('time-up', () => { if (info.isHost) hubFinish(); });\\n    HUB.on('end', () => { H.phase = 'over'; try { game.audio.music(null); game.audio.mute(true); } catch (e) { /* quiet */ } });\\n    if (info.isHost) {\\n      const rng = HUB.rng('sim');\\n      const seed = ((rng() * 0x7fffffff) >>> 0) || 1;\\n      const n = Math.max(1, Math.min(4, info.players.length || 1));\\n      beginCase('ferry', { players: n, seed, fromStory: false, mode: 'rounds' });\\n    }\\n    HUB.ready();\\n  }\\n\\n  function stickHot(I) {\\n    const a = I.padAim, m = I.padMove;\\n    return (a && Math.hypot(a[0], a[1]) > 0.25) || (m && Math.hypot(m[0], m[1]) > 0.25);\\n  }\\n\\n  game.hook('input', (dt) => {\\n    const I = game.input;\\n    if (RT.suppress > 0) { RT.suppress--; I.consumeAll(); return; }\\n    if (!RT.mouseInit) { RT.mouseInit = true; RT.mouseT = I.mouse ? I.mouse.t : 0; }\\n    let mouseMoved = false;\\n    if (I.mouse && I.mouse.t !== RT.mouseT) { mouseMoved = true; RT.mouseT = I.mouse.t; }\\n    const scene = game.sceneName;\\n    if (scene === 'attract') {\\n      const hit = I.anyPressed() || I.clicked() || stickHot(I) || mouseMoved || (I.held && I.held.size > 0);\\n      if (hit) {\\n        RT.attract = false;\\n        RT.idle = 0;\\n        go('title');\\n        I.consumeAll();\\n        RT.suppress = 1;\\n      }\\n      return;\\n    }\\n    const watch = scene === 'title' || scene === 'menu' || scene === 'casefiles' || scene === 'lobby';\\n    const shellUp = !!(game.shell && game.shell.screen);\\n    if (!watch || shellUp || game.paused || inSession) { RT.idle = 0; return; }\\n    let active = I.anyPressed() || !!I.clicked() || stickHot(I) || mouseMoved;\\n    if (I.held && I.held.size > 0) active = true;\\n    if (active) RT.idle = 0;\\n    else RT.idle += dt;\\n    if (RT.idle >= 10) {\\n      RT.idle = 0;\\n      RT.attract = true;\\n      RT.seg = 0;\\n      RT.loops = RT.loops || 0;\\n      go('attract');\\n    }\\n  });\\n\\n  game.hook('enter', (name) => {\\n    const song = {\\n      title: 'night', menu: 'night', difficulty: 'night', casefiles: 'night', about: 'night',\\n      story: 'night', chart: 'night', op: 'theatre', results: 'ward', ward: 'ward',\\n      credits: 'end', lobby: 'night', lab: 'theatre', attract: 'hush', hub: 'theatre',\\n    }[name] || 'night';\\n    try { GAME.Audio.play(song); } catch (e) { /* quiet */ }\\n  });\\n\\n  const CAM = { zoom: false, wheel: false };\\n\\n  const scenes = {\\n    title: {\\n      view: 'side', camera: CAM,\\n      enter() { RT.menu = null; RT.attract = false; },\\n      update() {\\n        const I = game.input;\\n        if (I.pressed('confirm') || I.pressed('start')) go('menu');\\n      },\\n      draw(r) { drawTitle(r, game.real); },\\n    },\\n    menu: {\\n      view: 'side', camera: CAM,\\n      enter() {\\n        RT.menu = makeMenu(['New Game', 'Case Files', 'Grand Rounds', 'Skills Lab', 'About'], (i, label) => {\\n          if (label === 'New Game') {\\n            story.stop();\\n            RT.saved = {}; RT.ranks = {}; RT.cleared = {}; RT.chapter = 1; RT.chartFor = null;\\n            RT.fromStory = true; RT.pending = 'story'; RT.cheatUsed = false;\\n            go('difficulty');\\n          } else if (label === 'Case Files') go('casefiles');\\n          else if (label === 'Grand Rounds') go('lobby');\\n          else if (label === 'Skills Lab') { RT.pending = 'lab'; RT.fromStory = false; go('difficulty'); }\\n          else if (label === 'About') go('about');\\n        }, () => go('title'));\\n      },\\n      update() { if (RT.menu) RT.menu.update(); },\\n      draw(r) {\\n        drawTitle(r, game.real * 0.2);\\n        if (RT.menu) RT.menu.draw(r);\\n      },\\n    },\\n    difficulty: {\\n      view: 'side', camera: CAM,\\n      enter() {\\n        const items = ['Intern', 'Resident', 'Attending'];\\n        RT.menu = makeMenu(items, (i) => {\\n          RT.diff = ['intern', 'resident', 'attending'][i];\\n          if (game.settings && game.settings.set) { try { game.settings.set('difficulty', RT.diff); } catch (e) { /* pref */ } }\\n          if (RT.pending === 'lab') { beginCase('lab', { difficulty: RT.diff, fromStory: false }); go('op'); }\\n          else if (RT.pending === 'file') { beginCase(RT.fileCase, { difficulty: RT.diff, fromStory: false }); go('op'); }\\n          else go('story');\\n        }, () => go('menu'));\\n        RT.menu.i = 0;\\n      },\\n      update() { if (RT.menu) RT.menu.update(); },\\n      draw(r) {\\n        r.sky(['#071018', '#102028']);\\n        r.overlay(g => {\\n          GAME.Art.stage(g, 'office', r.W, r.H, game.real);\\n          E.font.text(g, 'DIFFICULTY', r.W / 2, 16, '#5ff0e0', { align: 'center', scale: 2, outline: '#06141a' });\\n        });\\n        if (RT.menu) RT.menu.draw(r);\\n      },\\n    },\\n    casefiles: {\\n      view: 'side', camera: CAM,\\n      enter() {\\n        const items = GAME.ORDER.map(id => {\\n          const def = GAME.CASES[id];\\n          const rank = RT.ranks[id] ? '  ' + RT.ranks[id] : '';\\n          return (def.name || id) + rank;\\n        });\\n        RT.menu = makeMenu(items, (i) => {\\n          RT.fileCase = GAME.ORDER[i];\\n          RT.pending = 'file';\\n          RT.fromStory = false;\\n          go('difficulty');\\n        }, () => go('menu'));\\n      },\\n      update() { if (RT.menu) RT.menu.update(); },\\n      draw(r) {\\n        r.sky(['#071018', '#102028']);\\n        r.overlay(g => E.font.text(g, 'CASE FILES', r.W / 2, 12, '#5ff0e0', { align: 'center', scale: 2, outline: '#06141a' }));\\n        if (RT.menu) RT.menu.draw(r);\\n      },\\n    },\\n    lobby: {\\n      view: 'side', camera: CAM,\\n      enter() {\\n        RT.menu = makeMenu(['1 surgeon', '2 surgeons', '3 surgeons', '4 surgeons'], (i) => {\\n          RT.lobbyN = i + 1;\\n          beginCase('ferry', { players: RT.lobbyN, fromStory: false, mode: 'rounds' });\\n          go('op');\\n        }, () => go('menu'));\\n      },\\n      update() { if (RT.menu) RT.menu.update(); },\\n      draw(r) {\\n        r.sky(['#071018', '#102028']);\\n        r.overlay(g => {\\n          E.font.text(g, 'GRAND ROUNDS', r.W / 2, 16, '#5ff0e0', { align: 'center', scale: 2, outline: '#06141a' });\\n          E.font.text(g, 'One patient. Shared hands.', r.W / 2, 40, '#8fb8b0', { align: 'center', outline: false });\\n        });\\n        if (RT.menu) RT.menu.draw(r);\\n      },\\n    },\\n    story: {\\n      view: 'side', camera: CAM,\\n      enter() {\\n        if (!story.running && !story._held) {\\n          story.skip = !!(game.debug && game.debug.skipStory);\\n          story.run('start');\\n        }\\n      },\\n      update(dt) {\\n        const I = game.input;\\n        if (I.down('skip') || (game.debug && game.debug.skipStory)) {\\n          story.skip = true;\\n          story.talk.speed = 1e6;\\n        } else story.talk.speed = PREFS.text || 1;\\n        if (I.pressed('log')) RT.logOpen = !RT.logOpen;\\n        if (!story.running && !story._held) { go('title'); return; }\\n        story.update(dt);\\n      },\\n      draw(r) {\\n        const stage = RT.chapter >= 4 ? 'chapel' : RT.chapter === 3 ? 'harbor' : RT.chapter === 2 ? 'office' : 'theatre';\\n        r.sky(['#071018', '#102028']);\\n        r.overlay(g => GAME.Art.stage(g, stage, r.W, r.H, game.real));\\n        story.draw(r);\\n        if (RT.logOpen) r.overlay(g => {\\n          E.px.rect(g, 8, 8, r.W - 16, 70, '#06141a');\\n          const lines = story.log.slice(-4);\\n          lines.forEach((ln, i) => E.font.text(g, (ln.name ? ln.name + ': ' : '') + ln.text, 12, 12 + i * 14, '#e8fbf6', { outline: false }));\\n        });\\n      },\\n    },\\n    chart: {\\n      view: 'overhead', camera: CAM,\\n      enter(data) {\\n        const id = data && data.caseId;\\n        RT.chartCase = id;\\n        RT.light = GAME.LIGHT[id] || null;\\n        RT.miss = 0;\\n      },\\n      update() {\\n        const I = game.input;\\n        const light = RT.light;\\n        if (!light) {\\n          beginCase(RT.chartCase, { fromStory: true, seed: 3 });\\n          go('op');\\n          return;\\n        }\\n        const c = I.clicked();\\n        if (!c) return;\\n        const [ox, oy] = origin();\\n        const mx = ox + light.mark[0], my = oy + light.mark[1];\\n        const d = Math.hypot(c[0] - mx, c[1] - my);\\n        if (d <= 14) {\\n          RT.chartFor = RT.chartCase;\\n          const S = beginCase(RT.chartCase, { fromStory: true, seed: 3 });\\n          if (S) { S.clock += 20; S.steady += 20; }\\n          go('op');\\n        } else {\\n          RT.miss += 1;\\n          if (RT.miss >= 3) {\\n            RT.chartFor = RT.chartCase;\\n            const S = beginCase(RT.chartCase, { fromStory: true, seed: 3 });\\n            if (S) S.clock -= 10 * RT.miss;\\n            go('op');\\n          }\\n        }\\n      },\\n      draw(r) {\\n        r.sky(['#0c1418', '#183028']);\\n        r.overlay(g => {\\n          GAME.Art.stage(g, 'office', r.W, r.H, 0);\\n          const light = RT.light;\\n          E.font.text(g, 'SECOND OPINION', r.W / 2, 12, '#5ff0e0', { align: 'center', scale: 2, outline: '#06141a' });\\n          if (!light) return;\\n          const text = light.text || '';\\n          E.font.text(g, text, r.W / 2, 36, '#e8fbf6', { align: 'center', outline: '#06141a', wrap: r.W - 40 });\\n          const [ox, oy] = origin();\\n          const mx = ox + light.mark[0], my = oy + light.mark[1];\\n          E.px.rect(g, mx - 6, my - 1, 12, 2, '#f5b700');\\n          E.px.rect(g, mx - 1, my - 6, 2, 12, '#f5b700');\\n          E.font.text(g, 'Misses ' + RT.miss, 8, r.H - 16, '#8fb8b0', { outline: false });\\n        });\\n      },\\n    },\\n    op: {\\n      view: 'overhead', camera: CAM, pausable: true,\\n      enter() { game.setView('overhead'); },\\n      update(dt) {\\n        const S = RT.S;\\n        if (!S) { go('menu'); return; }\\n        handleDev();\\n        game.focus(game.W / 2, game.H / 2, 0);\\n        const fast = game.debug && game.debug.driver && !RT.attract;\\n        if (fast) {\\n          for (let k = 0; k < 16; k++) drive(S, 1 / 45);\\n        } else drive(S, dt);\\n        if ((S.won || S.lost) && !RT.leftOp) {\\n          RT.leftOp = true;\\n          if (!RT.attract) go('results');\\n        }\\n      },\\n      draw(r) { game.focus(game.W / 2, game.H / 2, 0); drawOp(r, RT.S, false); },\\n    },\\n    results: {\\n      view: 'side', camera: CAM,\\n      enter() {\\n        recordRank();\\n        const S = RT.S;\\n        const items = S && S.lost ? ['Retry', 'Give up'] : ['Continue'];\\n        RT.menu = makeMenu(items, (i, label) => {\\n          if (label === 'Retry' && RT.S) {\\n            GAME.Op.retryPhase(RT.S);\\n            RT.leftOp = false;\\n            go('op');\\n            return;\\n          }\\n          leaveResults();\\n        });\\n      },\\n      update() { if (RT.menu) RT.menu.update(); },\\n      draw(r) {\\n        const S = RT.S;\\n        r.sky(['#071018', '#102028']);\\n        r.overlay(g => {\\n          GAME.Art.stage(g, 'theatre', r.W, r.H, 0);\\n          const head = S && S.won ? 'CLOSED' : 'LOST';\\n          E.font.text(g, head, r.W / 2, 16, S && S.won ? '#5ff0e0' : '#ff7a6a', { align: 'center', scale: 2, outline: '#06141a' });\\n          if (S) {\\n            const tag = (GAME.TUNE.dirty || RT.cheatUsed) ? 'DEV' : (S.rank || '');\\n            E.font.text(g, tag + '   ' + Math.round(S.score || 0), r.W / 2, 42, '#e8fbf6', { align: 'center', scale: 2, outline: '#06141a' });\\n            E.font.text(g, 'Vitals ' + Math.round(S.vitals) + '   Clock ' + Math.round(S.clock), r.W / 2, 66, '#8fb8b0', { align: 'center', outline: false });\\n          }\\n        });\\n        if (RT.menu) RT.menu.draw(r);\\n      },\\n    },\\n    ward: {\\n      view: 'threequarter', camera: CAM, pausable: true,\\n      enter() {\\n        game.saves.canSave = true;\\n        try { game.saves.autosave(); } catch (e) { /* visit only */ }\\n        const W = game.W, H = game.H;\\n        RT.door = { x: (W / 2) | 0, y: H - 36 };\\n        RT.hero = { x: RT.door.x - 18, y: RT.door.y, tx: null, ty: null };\\n        const list = (GAME.WARD[RT.chapter] || GAME.WARD[1] || []).filter(id => RT.saved[id]);\\n        RT.visitors = list.map((id, i) => ({ id, x: 36 + i * 40, y: 70 }));\\n        RT.nearDoor = true;\\n        RT.line = '';\\n      },\\n      exit() { game.saves.canSave = false; },\\n      update(dt) {\\n        if (handleDev()) {\\n          /* panel owns the arrows; walking still uses the letter keys below when the panel is shut */\\n        }\\n        const I = game.input;\\n        const h = RT.hero;\\n        if (!RT.devOpen) {\\n          let ax = 0, ay = 0;\\n          const m = I.move();\\n          ax += m[0]; ay += m[1];\\n          if (I.held && I.held.has('KeyA')) ax -= 1;\\n          if (I.held && I.held.has('KeyD')) ax += 1;\\n          if (I.held && I.held.has('KeyW')) ay -= 1;\\n          if (I.held && I.held.has('KeyS')) ay += 1;\\n          const c = I.clicked();\\n          if (c) { h.tx = c[0]; h.ty = c[1]; }\\n          if (ax || ay) {\\n            const L = Math.hypot(ax, ay) || 1;\\n            h.x += (ax / L) * 80 * dt;\\n            h.y += (ay / L) * 80 * dt;\\n            h.tx = null;\\n          } else if (h.tx != null) {\\n            const dx = h.tx - h.x, dy = h.ty - h.y, d = Math.hypot(dx, dy);\\n            if (d < 2) h.tx = null;\\n            else { h.x += dx / d * Math.min(d, 80 * dt); h.y += dy / d * Math.min(d, 80 * dt); }\\n          }\\n          h.x = Math.max(12, Math.min(game.W - 12, h.x));\\n          h.y = Math.max(28, Math.min(game.H - 16, h.y));\\n        }\\n        const doorD = Math.hypot(h.x - RT.door.x, h.y - RT.door.y);\\n        RT.nearDoor = doorD <= 36;\\n        if (RT.lineT > 0) RT.lineT -= dt;\\n        if (!RT.devOpen && (I.pressed('confirm') || I.pressed('interact'))) {\\n          if (RT.nearDoor) {\\n            if (!resumeHeld()) go('menu');\\n            return;\\n          }\\n          for (const v of RT.visitors) {\\n            if (Math.hypot(h.x - v.x, h.y - v.y) < 28) {\\n              const p = GAME.PEOPLE[v.id];\\n              RT.line = p ? p.name + ': ' + p.line : '';\\n              RT.lineT = 4;\\n            }\\n          }\\n        }\\n      },\\n      draw(r) {\\n        game.focus(r.W / 2, r.H / 2, 0);\\n        r.sky(['#0c1814', '#163028']);\\n        r.overlay(g => {\\n          const px = E.px;\\n          GAME.Art.stage(g, 'theatre', r.W, r.H, game.real);\\n          px.rect(g, RT.door.x - 10, RT.door.y - 16, 20, 28, '#c8a45a');\\n          px.rect(g, RT.door.x - 2, RT.door.y - 2, 3, 3, '#f0e2b0');\\n          for (const v of RT.visitors) GAME.Art.bust(g, v.id, { expr: 'smile' }, v.x - 16, v.y - 28, 36);\\n          px.disc(g, RT.hero.x, RT.hero.y, 5, '#e8443a');\\n          E.font.text(g, 'WARD', 8, 8, '#5ff0e0', { scale: 2, outline: '#06141a' });\\n          if (RT.nearDoor) E.font.text(g, game.input.label('interact'), RT.door.x, RT.door.y - 22, '#e8fbf6', { align: 'center', outline: '#06141a' });\\n          if (RT.line && RT.lineT > 0) E.font.text(g, RT.line, r.W / 2, r.H - 28, '#e8fbf6', { align: 'center', outline: '#06141a', wrap: r.W - 24 });\\n          if (RT.devOpen) drawDev(g, r);\\n        });\\n      },\\n    },\\n    credits: {\\n      view: 'side', camera: CAM,\\n      enter() { RT.creditPage = 0; },\\n      update() {\\n        const I = game.input;\\n        const pages = creditPages();\\n        if (I.pressed('confirm') || I.pressed('right') || I.pressed('start')) {\\n          RT.creditPage += 1;\\n          if (RT.creditPage >= pages.length) {\\n            RT.redirect = false;\\n            if (story._held) story.resume();\\n            if (!RT.redirect) go('story');\\n          }\\n        } else if (I.pressed('left') && RT.creditPage > 0) RT.creditPage -= 1;\\n      },\\n      draw(r) {\\n        const pages = creditPages();\\n        const page = pages[Math.min(RT.creditPage, pages.length - 1)];\\n        r.sky(['#070c14', '#142028']);\\n        r.overlay(g => {\\n          GAME.Art.stage(g, 'harbor', r.W, r.H, game.real);\\n          E.font.text(g, page.title, r.W / 2, 16, '#5ff0e0', { align: 'center', scale: 2, outline: '#06141a' });\\n          const body = page.body || '';\\n          E.font.text(g, body, 16, 44, '#e8fbf6', { outline: '#06141a', wrap: r.W - 32 });\\n          E.font.text(g, game.input.label('confirm'), r.W - 8, r.H - 14, '#8fb8b0', { align: 'right', outline: false });\\n        });\\n      },\\n    },\\n    about: {\\n      view: 'side', camera: CAM,\\n      enter() { RT.creditPage = 0; },\\n      update() {\\n        const I = game.input;\\n        const pages = aboutPages();\\n        if (I.pressed('cancel')) { go('menu'); return; }\\n        if (I.pressed('confirm') || I.pressed('right')) {\\n          RT.creditPage = Math.min(pages.length - 1, RT.creditPage + 1);\\n        } else if (I.pressed('left') && RT.creditPage > 0) RT.creditPage -= 1;\\n      },\\n      draw(r) {\\n        const pages = aboutPages();\\n        const page = pages[RT.creditPage] || pages[0];\\n        r.sky(['#071018', '#102028']);\\n        r.overlay(g => {\\n          E.font.text(g, page.title, 12, 8, '#5ff0e0', { scale: 2, outline: '#06141a' });\\n          E.font.text(g, page.body, 12, 32, '#e8fbf6', { outline: '#06141a', wrap: r.W - 24 });\\n        });\\n      },\\n    },\\n    attract: {\\n      view: 'side', camera: CAM,\\n      enter() {\\n        RT.attract = true;\\n        RT.seg = 0;\\n        startSegment();\\n      },\\n      exit() { RT.attract = false; },\\n      update(dt) {\\n        const seg = REEL[RT.seg];\\n        RT.segT += dt;\\n        if (seg.kind === 'story' && RT.reelStory) RT.reelStory.update(dt);\\n        if ((seg.kind === 'op' || seg.kind === 'rounds') && RT.S && !RT.S.won && !RT.S.lost) {\\n          game.focus(game.W / 2, game.H / 2, 0);\\n          drive(RT.S, dt, { bots: true });\\n        }\\n        if (RT.segT >= seg.t) {\\n          RT.seg += 1;\\n          if (RT.seg >= REEL.length) { RT.seg = 0; RT.loops += 1; }\\n          startSegment();\\n        }\\n      },\\n      draw(r) {\\n        const seg = REEL[RT.seg];\\n        if (seg.kind === 'title') drawTitle(r, game.real);\\n        else if (seg.kind === 'card') {\\n          r.sky(['#071018', '#102028']);\\n          r.overlay(g => {\\n            E.font.text(g, 'DEMO', r.W / 2, 40, '#f5b700', { align: 'center', scale: 2, outline: '#06141a' });\\n            E.font.text(g, TITLE, r.W / 2, 70, '#e8fbf6', { align: 'center', outline: '#06141a' });\\n          });\\n        } else if (seg.kind === 'story') {\\n          r.sky(['#071018', '#102028']);\\n          r.overlay(g => {\\n            GAME.Art.stage(g, 'theatre', r.W, r.H, game.real);\\n            E.font.text(g, 'DEMO', 8, 8, '#f5b700', { scale: 2, outline: '#06141a' });\\n          });\\n          if (RT.reelStory) RT.reelStory.draw(r);\\n        } else drawOp(r, RT.S, true);\\n      },\\n    },\\n    hub: {\\n      view: 'overhead', camera: CAM, pausable: true,\\n      enter() { game.setView('overhead'); },\\n      update(dt) {\\n        const I = game.input;\\n        const info = H.info;\\n        if (!info) return;\\n        const server = !!(info.server || HUB.server || H.local < 0);\\n        if (H.phase === 'wait') {\\n          if (I.pressed('confirm') || I.pressed('start')) HUB.answer('ready');\\n          if (I.pressed('more')) HUB.answer('more');\\n          const c = I.clicked();\\n          if (c) HUB.answer(c[1] > game.H * 0.7 ? 'more' : 'ready');\\n          return;\\n        }\\n        if (H.phase === 'count' && HUB.time() >= 0) H.phase = 'play';\\n        if (H.phase !== 'play' || H.over) return;\\n        const S = RT.S;\\n        if (info.isHost && S) {\\n          game.focus(game.W / 2, game.H / 2, 0);\\n          const remote = applyHands();\\n          if (!server && H.local >= 0) {\\n            const mine = readLocal(S.players[H.local] || S.players[0]);\\n            remote[H.local] = mine;\\n          }\\n          drive(S, dt, { remote, bots: true });\\n          for (const key in remote) {\\n            const i = +key;\\n            const hnd = remote[i];\\n            if (hnd && hnd.x != null && S.players[i]) {\\n              /* host already applied x,y through the step */\\n            }\\n          }\\n          H.accS += dt;\\n          if (H.accS >= 1 / 12) { H.accS = 0; sendSnap(); }\\n        } else if (!server) {\\n          const p = { tool: 'forceps', x: 213, y: 150 };\\n          const mine = readLocal(p);\\n          H.accI += dt;\\n          if (H.accI >= 1 / 15) {\\n            H.accI = 0;\\n            const ptr = mine.mouse || [p.x, p.y];\\n            HUB.send({\\n              t: 'i', n: ++H.inN,\\n              x: Math.round(ptr[0]), y: Math.round(ptr[1]),\\n              trig: mine.trig > 0.3 ? 1 : 0,\\n              digit: mine.digit || 0,\\n            }, { to: info.host, reliable: false });\\n          }\\n        }\\n      },\\n      draw(r) {\\n        const info = H.info;\\n        if (info && (info.server || HUB.server)) return;\\n        if (H.phase === 'play' && RT.S && H.info && H.info.isHost) { drawOp(r, RT.S, false); return; }\\n        r.sky(['#071018', '#14504a']);\\n        r.overlay(g => {\\n          E.font.text(g, TITLE, 8, 8, '#e8fbf6', { outline: false });\\n          E.font.text(g, H.phase, 8, 22, '#5ff0e0', { outline: false });\\n          const left = H.card && H.card.left != null ? Math.ceil(H.card.left / 1000) : '';\\n          if (left !== '') E.font.text(g, String(left), 8, 36, '#f5b700', { outline: false });\\n          E.font.text(g, game.input.label('confirm'), 8, r.H - 28, '#e8fbf6', { outline: false });\\n          E.font.text(g, game.input.label('more'), 8, r.H - 16, '#8fb8b0', { outline: false });\\n          if (info) {\\n            info.players.forEach((q, i) => {\\n              const col = CFG.SEAT[i] || q.color || '#e8443a';\\n              E.px.disc(g, 20, 60 + i * 16, 4, col);\\n              E.font.text(g, String(q.name || ('P' + (i + 1))).slice(0, 12), 30, 54 + i * 16, col, { outline: false });\\n            });\\n          }\\n        });\\n      },\\n    },\\n  };\\n\\n  function aboutPages() {\\n    const A = GAME.ABOUT;\\n    const order = GAME.About.ORDER;\\n    const labels = GAME.About.LABELS;\\n    const src = order.map(k => labels[k] + ': ' + A.sourceInformation[k]).join('\\\\n');\\n    return [\\n      { title: 'Source Information', body: src },\\n      { title: 'Testing Feedback', body: A.testingFeedback.join('\\\\n') },\\n      { title: 'Engine Feedback', body: A.engineFeedback.join('\\\\n') },\\n      { title: 'Prompt Feedback', body: A.promptFeedback.join('\\\\n') },\\n    ];\\n  }\\n  function creditPages() {\\n    const cast = Object.keys(GAME.CAST).map(id => GAME.CAST[id].name + '  ' + GAME.CAST[id].role).join('\\\\n');\\n    return [{ title: 'Open Table', body: cast }].concat(aboutPages(), [\\n      { title: 'Incoming', body: 'A chart is on the night desk. The shift is over. The next one starts at seven.' },\\n    ]);\\n  }\\n\\n  game.saves.write = () => ({\\n    data: {\\n      ranks: RT.ranks, cleared: RT.cleared, saved: RT.saved, chapter: RT.chapter,\\n      story: story.state(), diff: RT.diff,\\n    },\\n    place: 'St. Erasmus Harbor Hospital',\\n    level: RT.chapter || 1,\\n  });\\n  game.saves.read = (save) => {\\n    const d = save && save.data || {};\\n    RT.ranks = d.ranks || {};\\n    RT.cleared = d.cleared || {};\\n    RT.saved = d.saved || {};\\n    RT.chapter = d.chapter || 1;\\n    RT.diff = d.diff || RT.diff;\\n    if (d.story) story.restore(d.story);\\n  };\\n  game.saves.canSave = false;\\n\\n  game.debug = {\\n    skipStory: false,\\n    driver: null,\\n    snapshot,\\n  };\\n  G.__ot = () => game.debug.snapshot();\\n  G.__hubProbe = () => ({\\n    phase: H.phase,\\n    over: !!H.over,\\n    host: !!(H.info && H.info.isHost),\\n    scene: game.sceneName,\\n    active: !!(HUB && HUB.active),\\n    players: (RT.S && RT.S.players || []).map(p => ({ id: p.id, x: p.x, y: p.y, tool: p.tool, trig: p.trig, actions: p.actions })),\\n    t: HUB && HUB.active ? HUB.time() : 0,\\n  });\\n  G.__hubInject = (x, y, trig) => {\\n    if (!H.info) return;\\n    if (H.info.isHost && RT.S) {\\n      const idx = H.local >= 0 ? H.local : 0;\\n      const p = RT.S.players[idx];\\n      if (p) { p.x = x; p.y = y; p.bx = x; p.by = y; p.trig = trig || 0; }\\n      return;\\n    }\\n    try {\\n      HUB.send({ t: 'i', n: ++H.inN, x, y, trig: trig || 0, digit: 0 }, { to: H.info.host, reliable: true });\\n    } catch (e) { /* not in a session */ }\\n  };\\n\\n  if (typeof document !== 'undefined') document.title = TITLE;\\n\\n  try { GAME.Audio.install(game); } catch (e) { /* headless */ }\\n  game.audio.sfxVolume = 1;\\n  game.audio.voiceVolume = 0.9;\\n  game.audio.volume = 0.7;\\n  if (game.audio.musicVolume == null || game.audio.musicVolume > 0.2) game.audio.musicVolume = 0.1;\\n  if (game.audio.applyVolume) game.audio.applyVolume();\\n\\n  game.start({\\n    scene: inSession ? 'hub' : 'title',\\n    scenes,\\n  });\\n  try { GAME.Audio.play(inSession ? 'theatre' : 'night'); } catch (e) { /* quiet */ }\\n\\n  if (inSession) connect();\\n\\n  GAME.Shell = { game, story, RT, snapshot, beginCase, people };\\n})();\\n\",\"new_line\":1,\"context_before\":\"\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"bc84cf2f-7491-4830-92bd-073e83faeaa1"}
{"type":"assistant","message":{"id":"msg_270","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"The readLocal digit logic is buggy. It was written twice messily.\n\nFixing the readLocal digit logic and checking for banned words before boot. The dev panel currently controls both hero movement and panel arrows; I will skip hero arrow movement while the dev panel is open.\n\nThe readLocal digit logic is redundant. The first two toolNext assignments are identical and can be removed. The last toolPrev line is also overwritten by the final toolNext assignment, so it is unnecessary too.\n\nThe digit logic needs a guard so toolNext only sets the digit when none is already selected. The move array must be copied before mutation to avoid altering the engine's padMove. Hub drive also overwrites local dev data with remote values that omit x and y coordinates.\n\nThe drive() fallback chain is being traced to confirm that local devices receive readLocal data instead of the remote array.\n\nThe drive() fallback chain is confirmed correct. Local seats receive readLocal data, while remote hands and empty seats fall back to bots.\n\nRemote hand updates only include x and y when dev.x is present. The host applies those coordinates to the device during its own drive step.\n\nThe server correctly routes local devices to bots and remote devices to remote or bot.\n\nA potential test timing issue was noted: a probe might read remote hand data immediately after injection before the next drive step applies the coordinates.\n\nThe host message handler will now set player position and trigger state immediately when it receives a remote hand update. This prevents the two-frame delay that could cause a probe to read stale coordinates before the next drive step applies them.\n\nThe host's own __hubInject applies to the local seat and is not used by the client. The handleDev confirm logic also triggers devAct when either confirm or right is pressed.\n\nConfirm on a tune row now only dirties the dev panel when the value actually changes. Confirm on the reset row still resets it.\n\nJump tab left and right controls are correctly disabled. The ward panel does not block movement because hero input is gated by `!devOpen`. The op dev panel continues simulation while open. Story skip input exists. Ferry and lab cases are present and beginCase validates the ferry ID. Menu onPick passes the item string directly.\n\nThe boot test is being added. The fake player object used by the hub client in readLocal only needs a tool property to determine the index, so it works correctly. Mouse coordinates are in field space.\n\nThe host sends remote hand updates ten times per second. Cursor.update runs before step readInputs, so any incoming x and y coordinates overwrite the cursor position.\n\nStory talk background assignment is safe even when the talk is sealed. Audio effects and scene entry are harmless in headless mode. The first scene title draws only after advance. Ready to fix the bugs and boot.\n\nI will apply the readLocal fixes with search_replace, then run node --check and boot the VM. I also need to grep stub/TODO for leftover markers. The beginCase ferry check is correct for both c1 and lab IDs. The ward handleDev empty block is valid. In attract mode, seat 0 becomes a bot because the non-bot condition is skipped.","signature":""},{"type":"tool_use","id":"call-39d6f615-8b29-4d03-ad99-a2686c0c62b7-61","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/scenes/shell.js","old_string":"    let digit = 0;\n    for (let n = 1; n <= 8; n++) if (I.pressed('tool' + n)) digit = n;\n    const tools = CFG.TOOLS;\n    const idx = Math.max(0, tools.indexOf(p.tool));\n    if (!digit && I.pressed('toolNext')) digit = (idx % 8) + 1 === idx + 1 ? ((idx + 1) % 8) + 1 : ((idx + 1) % 8) + 1;\n    if (!digit && I.pressed('toolNext')) digit = ((idx + 1) % 8) + 1;\n    if (I.pressed('toolPrev')) digit = ((idx + 7) % 8) + 1;\n    if (I.pressed('toolNext')) digit = ((idx + 1) % 8) + 1;\n    const devOpen = RT.devOpen;","new_string":"    let digit = 0;\n    for (let n = 1; n <= 8; n++) if (I.pressed('tool' + n)) digit = n;\n    const tools = CFG.TOOLS;\n    const idx = Math.max(0, tools.indexOf(p.tool));\n    if (!digit && I.pressed('toolPrev')) digit = ((idx + 7) % 8) + 1;\n    if (!digit && I.pressed('toolNext')) digit = ((idx + 1) % 8) + 1;\n    const devOpen = RT.devOpen;"}},{"type":"tool_use","id":"call-39d6f615-8b29-4d03-ad99-a2686c0c62b7-62","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/scenes/shell.js","old_string":"    const swap = !!PREFS.swap;\n    const aim = (swap ? I.padMove : I.padAim) || [0, 0];\n    const move = (swap ? (I.padAim || [0, 0]) : (I.padMove || [0, 0]));","new_string":"    const swap = !!PREFS.swap;\n    const aimSrc = (swap ? I.padMove : I.padAim) || [0, 0];\n    const moveSrc = (swap ? (I.padAim || [0, 0]) : (I.padMove || [0, 0]));\n    const aim = [aimSrc[0] || 0, aimSrc[1] || 0];\n    const move = [moveSrc[0] || 0, moveSrc[1] || 0];"}},{"type":"tool_use","id":"call-39d6f615-8b29-4d03-ad99-a2686c0c62b7-63","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/scenes/shell.js","old_string":"  function devAct(dir) {\n    RT.cheatUsed = RT.devTab !== 0 || RT.cheatUsed;\n    const S = RT.S;\n    if (RT.devTab === 0) {\n      const keys = GAME.Dev.KEYS;\n      if (RT.devI >= keys.length) { if (dir === 0) GAME.Dev.reset(); return; }\n      const [path, lo, hi] = keys[RT.devI];\n      const [g, k] = path.split('.');\n      const step = (hi - lo) / 20;\n      const cur = GAME.TUNE[g][k];\n      const v = Math.max(lo, Math.min(hi, Math.round((cur + dir * step) * 1000) / 1000));\n      GAME.Dev.set(path, v);\n      return;\n    }","new_string":"  function devAct(dir) {\n    const S = RT.S;\n    if (RT.devTab === 0) {\n      const keys = GAME.Dev.KEYS;\n      if (RT.devI >= keys.length) { if (dir === 0) GAME.Dev.reset(); return; }\n      if (!dir) return;\n      const [path, lo, hi] = keys[RT.devI];\n      const [g, k] = path.split('.');\n      const step = (hi - lo) / 20;\n      const cur = GAME.TUNE[g][k];\n      const v = Math.max(lo, Math.min(hi, Math.round((cur + dir * step) * 1000) / 1000));\n      GAME.Dev.set(path, v);\n      return;\n    }\n    RT.cheatUsed = true;"}},{"type":"tool_use","id":"call-39d6f615-8b29-4d03-ad99-a2686c0c62b7-64","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/scenes/shell.js","old_string":"        if (d.t === 'i') {\n          const idx = info.players.findIndex(q => q.id === from);\n          if (idx >= 0) H.hands[idx] = { x: d.x, y: d.y, trig: d.trig || 0, digit: d.digit || 0, n: d.n || 0 };\n        }","new_string":"        if (d.t === 'i') {\n          const idx = info.players.findIndex(q => q.id === from);\n          if (idx >= 0) {\n            H.hands[idx] = { x: d.x, y: d.y, trig: d.trig || 0, digit: d.digit || 0, n: d.n || 0 };\n            const p = RT.S && RT.S.players[idx];\n            if (p && d.x != null) { p.x = d.x; p.y = d.y; p.bx = d.x; p.by = d.y; p.trig = d.trig || 0; }\n          }\n        }"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":23114,"output_tokens":3962,"cache_read_input_tokens":162944,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e",