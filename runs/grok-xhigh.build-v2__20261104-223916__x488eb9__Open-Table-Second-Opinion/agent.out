Interval, clearInterval,\\n    navigator: { getGamepads: () => [] },\\n    queueMicrotask,\\n  };\\n  ctx.window = ctx;\\n  ctx.globalThis = ctx;\\n  vm.createContext(ctx);\\n  const load = (rel) => {\\n    const code = fs.readFileSync(path.join(dev, rel), 'utf8');\\n    vm.runInContext(code, ctx, { filename: rel });\\n  };\\n  load('vendor/my-3d2dge/dist/handoff/my-3d2dge.js');\\n  for (const rel of [\\n    'src/config.js', 'src/core/sim.js', 'src/data/content.js', 'src/art/field.js',\\n    'src/audio/audio.js', 'src/about.js', 'src/bot/bot.js', 'src/scenes/shell.js',\\n  ]) load(rel);\\n\\n  const GAME = ctx.GAME;\\n  const tune = () => GAME.CFG.cloneTune(GAME.CFG.TUNING);\\n  const raw = (opts) => GAME.Op.createRaw(Object.assign({ clock: 400, drain: 0, vitals: 90, hold: true }, opts || {}));\\n  const step = (S, inp, dt) => GAME.Op.step(S, inp, dt == null ? 1 / 60 : dt);\\n  const hold = (S, inp, seconds, dt) => {\\n    dt = dt || 1 / 60;\\n    let t = 0;\\n    while (t < seconds - 1e-9) { step(S, inp, dt); t += dt; }\\n  };\\n\\n  group('source', () => {\\n    const banned = /TODO|FIXME|placeholder|stub/;\\n    const files = [];\\n    const walk = (dir) => {\\n      for (const name of fs.readdirSync(dir)) {\\n        if (name === 'vendor' || name === 'node_modules') continue;\\n        const p = path.join(dir, name);\\n        const st = fs.statSync(p);\\n        if (st.isDirectory()) walk(p);\\n        else if (/\\\\.(js|mjs|html|json|md)$/.test(name) && !p.includes(path.sep + 'tests' + path.sep)) files.push(p);\\n      }\\n    };\\n    walk(path.join(dev, 'src'));\\n    const engine = fs.readFileSync(path.join(dev, 'vendor/my-3d2dge/dist/handoff/my-3d2dge.js'), 'utf8');\\n    check('engine comment is clean', !banned.test(engine), 'engine still has a banned token');\\n    let bad = '';\\n    for (const p of files) {\\n      const text = fs.readFileSync(p, 'utf8');\\n      if (banned.test(text)) bad += path.relative(dev, p) + ' ';\\n      if (p.endsWith('.js') && /Math\\\\.random\\\\(/.test(text)) bad += 'random:' + path.relative(dev, p) + ' ';\\n    }\\n    check('shipped scripts stay clean', bad === '', bad.trim());\\n    check('title', GAME.CFG.GAME_TITLE === 'Open Table Second Opinion', GAME.CFG.GAME_TITLE);\\n    check('eleven cases', GAME.ORDER.length === 11, String(GAME.ORDER.length));\\n    const htmlName = GAME.CFG.FILE + '.html';\\n    const htmlPath = path.join(work, htmlName);\\n    if (fs.existsSync(htmlPath)) {\\n      const html = fs.readFileSync(htmlPath, 'utf8');\\n      check('bundle clean', !banned.test(html));\\n      check('bundle has no external script', !/<script[^>]+src=/i.test(html));\\n      check('bundle titles the game', html.includes('<title>Open Table Second Opinion</title>'));\\n      check('session.js is inlined first', html.indexOf('AI Hub Session Protocol') < html.indexOf('My3D2dge') || html.indexOf('hub:session') > 0);\\n    } else if (!fast) check('bundle exists', false, htmlName);\\n  });\\n\\n  group('cursor', () => {\\n    const travel = (doctor, fine) => {\\n      const S = raw({ doctor });\\n      S.activeDoc = doctor;\\n      const p = S.players[0];\\n      p.bx = 16; p.by = 120; p.x = 16; p.y = 16; p.speed = 0;\\n      const T = tune();\\n      for (let i = 0; i < 120; i++) GAME.Cursor.update(p, { aim: [1, 0], fine: !!fine }, S, 1 / 120, T);\\n      return p.bx - 16;\\n    };\\n    const full = travel('sokolova', false);\\n\",\"total_lines\":1037}}","is_error":false},{"type":"tool_result","tool_use_id":"call-aa0ebc1a-b093-4dc1-8509-6402c18f2d68-7","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"155→\\n  GAME.openDev = () => {\\n    if (inSession) return;\\n    RT.devOpen = true;\\n    RT.devTab = 0;\\n160→    RT.devI = 0;\\n    if (game.shell) game.shell.hide();\\n  };\\n\\n  function origin() {\\n    return [(game.W - CFG.FIELD_W) >> 1, (game.H - CFG.FIELD_H) >> 1];\\n  }\\n  function playTune() {\\n    const t = CFG.cloneTune(GAME.TUNE);\\n    const def = CFG.TUNING.hands;\\n170→    /* A dev slider that has left the documented default wins. Settings apply while that slider still sits on the default. */\\n    if (t.hands.cursor === def.cursor) t.hands.cursor = PREFS.cursor;\\n    if (t.hands.assist === def.assist) t.hands.assist = PREFS.assist;\\n    return t;\\n  }\\n  function makeMenu(items, onPick, onCancel) {\\n    return new E.Menu(game, items, {\\n      scale: 2, rows: 6,\\n      color: '#e8fbf6', pick: '#5ff0e0', dim: '#8fb8b0',\\n      bg: '#06141a', border: '#5ff0e0',\\n180→      onPick, onCancel,\\n    });\\n  }\\n  function go(name, data) {\\n    game.go(name, data, { fade: game.fadeTime });\",\"content_concise\":\"155→\\n  GAME.openDev = () => {\\n    if (inSession) return;\\n    RT.devOpen = true;\\n    RT.devTab = 0;\\n160→    RT.devI = 0;\\n    if (game.shell) game.shell.hide();\\n  };\\n\\n  function origin() {\\n    return [(game.W - CFG.FIELD_W) >> 1, (game.H - CFG.FIELD_H) >> 1];\\n  }\\n  function playTune() {\\n    const t = CFG.cloneTune(GAME.TUNE);\\n    const def = CFG.TUNING.hands;\\n170→    /* A dev slider that has left the documented default wins. Settings apply while that slider still sits on the default. */\\n    if (t.hands.cursor === def.cursor) t.hands.cursor = PREFS.cursor;\\n    if (t.hands.assist === def.assist) t.hands.assist = PREFS.assist;\\n    return t;\\n  }\\n  function makeMenu(items, onPick, onCancel) {\\n    return new E.Menu(game, items, {\\n      scale: 2, rows: 6,\\n      color: '#e8fbf6', pick: '#5ff0e0', dim: '#8fb8b0',\\n      bg: '#06141a', border: '#5ff0e0',\\n180→      onPick, onCancel,\\n    });\\n  }\\n  function go(name, data) {\\n    game.go(name, data, { fade: game.fadeTime });\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/scenes/shell.js\",\"offset\":155,\"limit\":30,\"raw_output\":\"\\n  GAME.openDev = () => {\\n    if (inSession) return;\\n    RT.devOpen = true;\\n    RT.devTab = 0;\\n    RT.devI = 0;\\n    if (game.shell) game.shell.hide();\\n  };\\n\\n  function origin() {\\n    return [(game.W - CFG.FIELD_W) >> 1, (game.H - CFG.FIELD_H) >> 1];\\n  }\\n  function playTune() {\\n    const t = CFG.cloneTune(GAME.TUNE);\\n    const def = CFG.TUNING.hands;\\n    /* A dev slider that has left the documented default wins. Settings apply while that slider still sits on the default. */\\n    if (t.hands.cursor === def.cursor) t.hands.cursor = PREFS.cursor;\\n    if (t.hands.assist === def.assist) t.hands.assist = PREFS.assist;\\n    return t;\\n  }\\n  function makeMenu(items, onPick, onCancel) {\\n    return new E.Menu(game, items, {\\n      scale: 2, rows: 6,\\n      color: '#e8fbf6', pick: '#5ff0e0', dim: '#8fb8b0',\\n      bg: '#06141a', border: '#5ff0e0',\\n      onPick, onCancel,\\n    });\\n  }\\n  function go(name, data) {\\n    game.go(name, data, { fade: game.fadeTime });\\n\",\"total_lines\":1430}}","is_error":false},{"type":"tool_result","tool_use_id":"call-aa0ebc1a-b093-4dc1-8509-6402c18f2d68-8","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"400→    r.sky(['#071018', '#102028']);\\n    const F = S ? fieldOf(S) : null;\\n    const allow = (typeof document !== 'undefined') || GAME.Art.force;\\n    if (allow && F) {\\n      try { F.shade({ beat: ((S.t || 0) % 1), slow: !!S.breath, dim: S.dim || 0 }); }\\n      catch (e) { /* painter */ }\\n    }\\n    r.overlay(g => {\\n      const px = E.px;\\n      if (F && F.cv && F.cv.width) { try { g.drawImage(F.cv, 0, 0); } catch (e) { /* no image */ } }\\n410→      px.rect(g, 0, 0, r.W, Math.max(0, oy), '#102830');\\n      px.rect(g, 0, oy + CFG.FIELD_H, r.W, Math.max(0, r.H - oy - CFG.FIELD_H), '#102830');\\n      px.rect(g, 0, oy, Math.max(0, ox), CFG.FIELD_H, '#102830');\\n      px.rect(g, ox + CFG.FIELD_W, oy, Math.max(0, r.W - ox - CFG.FIELD_W), CFG.FIELD_H, '#102830');\\n      px.rect(g, ox + 8, oy + 8, CFG.FIELD_W - 16, CFG.FIELD_H - 16, '#0c2428');\\n      if (!S) return;\\n      const ink = bloodCol();\\n      for (const o of S.objects) {\\n        if (!o.alive && o.type !== 'retractor') continue;\\n        if (o.hidden && !o.marked) continue;\\n420→        const x = o.x + ox, y = o.y + oy;\\n        let c = COL[o.type] || '#9ad0c8';\\n        if (ink && (o.type === 'bleeder' || o.type === 'pool' || o.type === 'wound' || o.type === 'laceration' || o.type === 'arteryTear')) c = ink;\\n        const rad = o.type === 'pool' ? 8 + (o.vol || 0) * 0.15 : o.type === 'mass' ? (o.rad || 12) : o.type === 'bead' ? 3 : 4;\\n        if (o.guide && o.guide.length > 1 && (o.type === 'cut' || o.type === 'mass' || o.type === 'slur')) {\\n          for (let k = 1; k < o.guide.length; k++) px.line(g, o.guide[k - 1][0] + ox, o.guide[k - 1][1] + oy, o.guide[k][0] + ox, o.guide[k][1] + oy, '#f2f0e6', 1);\\n        }\\n        px.disc(g, x, y, rad, o.done ? '#2a403c' : c);\\n        if (o.marked) px.disc(g, x, y, rad + 3, '#5ff0e0');\\n      }\\n430→      if (S.ghostT > 0 && S.ghosts && S.ghosts.length) {\\n        for (let gi = 0; gi < S.ghosts.length; gi++) {\\n          const gh = S.ghosts[gi];\\n          const marks = (gh.cursors || []).concat(gh.strains || []);\\n          for (let mi = 0; mi < marks.length; mi++) {\\n            const xy = marks[mi];\\n            if (!xy) continue;\\n            px.disc(g, xy[0] + ox, xy[1] + oy, 3, '#67d6ff');\\n          }\\n        }\\n440→      }\\n      if (S.breath) {\\n        px.rect(g, ox + 20, oy + 16, CFG.FIELD_W - 40, 2, '#bfefff');\\n        px.rect(g, ox + 20, oy + CFG.FIELD_H - 18, CFG.FIELD_W - 40, 2, '#bfefff');\\n      }\\n      if (RT.wheelShow > 0 && S.players[0] && !S.players[0].gone) {\\n        const c = S.players[0];\\n        for (const w of CFG.WHEEL) {\\n          const x = c.x + ox + w.x * 22, y = c.y + oy + w.y * 22;\\n          const on = c.tool === w.tool;\\n450→          px.disc(g, x, y, on ? 8 : 5, on ? '#5ff0e0' : '#14343c');\\n          GAME.Art.toolIcon(g, w.tool, x - 4, y - 4, 1);\\n        }\\n      }\\n      for (const p of S.players) if (!p.gone) GAME.Art.drawHand(g, p, ox, oy);\\n      const vit = Math.max(0, Math.ceil(S.vitals));\\n      const clk = Math.max(0, Math.ceil(S.clock));\\n      E.font.text(g, 'VIT ' + vit, 8, 6, vit < 30 ? '#ff7a6a' : '#e8fbf6', { scale: 2, outline: '#06141a' });\\n      E.font.text(g, 'CLK ' + clk, 8, 26, clk < 20 ? '#ff7a6a' : '#e8fbf6', { scale: 2, outline: '#06141a' });\\n      E.font.text(g, (S.phaseName || '') + '  ' + (S.activeDoc || ''), 8, 48, '#8fb8b0', { outline: '#06141a' });\\n460→      const tool = (S.players[0] && S.players[0].tool) || 'forceps';\\n      GAME.Art.toolIcon(g, tool, r.W - 28, r.H - 28, 1);\\n      E.font.text(g, tool.toUpperCase(), r.W - 8, r.H - 36, '#e8fbf6', { align: 'right', outline: '#06141a' });\\n      if (PREFS.hints) E.font.text(g, game.input.label('useTool'), r.W - 8, r.H - 14, '#5ff0e0', { align: 'right', outline: false });\\n      const steady = Math.round(S.steady || 0);\\n      E.font.text(g, 'STEADY ' + steady, 8, r.H - 16, '#5ff0e0', { outline: '#06141a' });\\n      if (S.codeBlue) E.font.text(g, 'SHOCK', r.W / 2, 64, '#ff7a6a', { align: 'center', scale: 2, outline: '#06141a' });\\n      if (S.dressing) E.font.text(g, 'DRESSING', r.W / 2, 64, '#f2f0e6', { align: 'center', scale: 2, outline: '#06141a' });\\n      if (ribbon) E.font.text(g, 'DEMO', r.W - 8, 6, '#f5b700', { align: 'right', scale: 2, outline: '#06141a' });\\n      if (GAME.TUNE.dirty || RT.cheatUsed) E.font.text(g, 'DEV', 8, 66, '#f5b700', { outline: '#06141a' });\\n470→      if (S.t != null && GAME.BARKS && GAME.BARKS.length) {\\n        const bark = GAME.BARKS[Math.floor(S.t / 4) % GAME.BARKS.length];\\n        E.font.text(g, bark, r.W / 2, r.H - 28, '#d8e4dc', { align: 'center', outline: '#06141a' });\\n      }\\n      if (RT.devOpen) drawDev(g, r);\\n    });\\n  }\\n\\n  const CHEATS = [\\n    ['reveal', 'Reveal'],\\n480→    ['infSteady', 'Infinite Steady'],\\n    ['lockVitals', 'Lock vitals'],\\n    ['freezeClock', 'Freeze clock'],\\n    ['oneHit', 'One hit'],\\n    ['auto', 'Autosurgeon'],\\n    ['slow', 'Slow motion'],\\n    ['win', 'Clear phase'],\\n    ['lose', 'Force a loss'],\\n    ['code', 'Vitals to zero'],\\n  ];\\n490→  const SLOW = [0.25, 0.5, 1, 2];\\n\\n  function devRows() {\\n    if (RT.devTab === 1) return CHEATS.map(c => c[1]);\\n    if (RT.devTab === 2) {\\n      const rows = [];\\n      for (const id of GAME.ORDER) {\\n        const def = GAME.CASES[id];\\n        const n = (def.phases || []).length;\\n        for (let p = 0; p < n; p++) rows.push(id + ' ' + (def.phases[p].name || p));\\n500→      }\\n      rows.push('Grand Rounds');\\n      rows.push('Skills Lab');\\n      return rows;\\n    }\\n    return GAME.Dev.KEYS.map(k => k[0]).concat(['Reset tuning']);\\n  }\\n\\n  function devAct(dir) {\\n    const S = RT.S;\\n510→    if (RT.devTab === 0) {\\n      const keys = GAME.Dev.KEYS;\\n      if (RT.devI >= keys.length) { if (dir === 0) GAME.Dev.reset(); return; }\\n      if (!dir) return;\\n      const [path, lo, hi] = keys[RT.devI];\\n      const [g, k] = path.split('.');\\n      const step = (hi - lo) / 20;\\n      const cur = GAME.TUNE[g][k];\\n      const v = Math.max(lo, Math.min(hi, Math.round((cur + dir * step) * 1000) / 1000));\\n      GAME.Dev.set(path, v);\\n520→      return;\\n    }\\n    RT.cheatUsed = true;\\n    if (dir !== 0 && RT.devTab !== 1) return;\\n    if (RT.devTab === 1 && dir === 0) {\\n      const key = CHEATS[RT.devI][0];\\n      if (key === 'auto') { RT.auto = !RT.auto; RT.cheatUsed = true; return; }\\n      if (key === 'slow') {\\n        const i = SLOW.indexOf(game.timeScale);\\n        game.timeScale = SLOW[(i + 1) % SLOW.length] || 1;\\n530→        RT.cheatUsed = true;\\n        return;\\n      }\\n      if (key === 'win' && S) {\\n        RT.cheatUsed = true;\\n        for (const o of S.objects) { o.done = true; o.prog = 1; }\\n        if (S.strain) {\\n          S.strain.done = true;\\n          if (S.strain.beads) for (const b of S.strain.beads) b.dead = true;\\n          if (S.strain.worms) for (const w of S.strain.worms) w.done = true;\\n540→          if (S.strain.lobes) for (const L of S.strain.lobes) L.dead = true;\\n        }\\n        if (S.flags && S.flags.needIv) S.flags.iv = S.flags.needIv;\\n        S.hold = false;\\n        return;\\n      }\\n      if (key === 'lose' && S) { RT.cheatUsed = true; GAME.Sim.lose(S, 'dev'); return; }\\n      if (key === 'code' && S) { RT.cheatUsed = true; S.vitals = 0; return; }\\n      if (S) {\\n        S.cheat = S.cheat || {};\\n550→        const on = !S.cheat[key];\\n        GAME.Dev.cheat(S, key, on);\\n        RT.cheatUsed = true;\\n      }\\n      return;\\n    }\\n    if (RT.devTab === 2 && dir === 0) {\\n      const rows = devRows();\\n      const label = rows[RT.devI] || '';\\n      RT.cheatUsed = true;\",\"content_concise\":\"400→    r.sky(['#071018', '#102028']);\\n    const F = S ? fieldOf(S) : null;\\n    const allow = (typeof document !== 'undefined') || GAME.Art.force;\\n    if (allow && F) {\\n      try { F.shade({ beat: ((S.t || 0) % 1), slow: !!S.breath, dim: S.dim || 0 }); }\\n      catch (e) { /* painter */ }\\n    }\\n    r.overlay(g => {\\n      const px = E.px;\\n      if (F && F.cv && F.cv.width) { try { g.drawImage(F.cv, 0, 0); } catch (e) { /* no image */ } }\\n410→      px.rect(g, 0, 0, r.W, Math.max(0, oy), '#102830');\\n      px.rect(g, 0, oy + CFG.FIELD_H, r.W, Math.max(0, r.H - oy - CFG.FIELD_H), '#102830');\\n      px.rect(g, 0, oy, Math.max(0, ox), CFG.FIELD_H, '#102830');\\n      px.rect(g, ox + CFG.FIELD_W, oy, Math.max(0, r.W - ox - CFG.FIELD_W), CFG.FIELD_H, '#102830');\\n      px.rect(g, ox + 8, oy + 8, CFG.FIELD_W - 16, CFG.FIELD_H - 16, '#0c2428');\\n      if (!S) return;\\n      const ink = bloodCol();\\n      for (const o of S.objects) {\\n        if (!o.alive && o.type !== 'retractor') continue;\\n        if (o.hidden && !o.marked) continue;\\n420→        const x = o.x + ox, y = o.y + oy;\\n        let c = COL[o.type] || '#9ad0c8';\\n        if (ink && (o.type === 'bleeder' || o.type === 'pool' || o.type === 'wound' || o.type === 'laceration' || o.type === 'arteryTear')) c = ink;\\n        const rad = o.type === 'pool' ? 8 + (o.vol || 0) * 0.15 : o.type === 'mass' ? (o.rad || 12) : o.type === 'bead' ? 3 : 4;\\n        if (o.guide && o.guide.length > 1 && (o.type === 'cut' || o.type === 'mass' || o.type === 'slur')) {\\n          for (let k = 1; k < o.guide.length; k++) px.line(g, o.guide[k - 1][0] + ox, o.guide[k - 1][1] + oy, o.guide[k][0] + ox, o.guide[k][1] + oy, '#f2f0e6', 1);\\n        }\\n        px.disc(g, x, y, rad, o.done ? '#2a403c' : c);\\n        if (o.marked) px.disc(g, x, y, rad + 3, '#5ff0e0');\\n      }\\n430→      if (S.ghostT > 0 && S.ghosts && S.ghosts.length) {\\n        for (let gi = 0; gi < S.ghosts.length; gi++) {\\n          const gh = S.ghosts[gi];\\n          const marks = (gh.cursors || []).concat(gh.strains || []);\\n          for (let mi = 0; mi < marks.length; mi++) {\\n            const xy = marks[mi];\\n            if (!xy) continue;\\n            px.disc(g, xy[0] + ox, xy[1] + oy, 3, '#67d6ff');\\n          }\\n        }\\n440→      }\\n      if (S.breath) {\\n        px.rect(g, ox + 20, oy + 16, CFG.FIELD_W - 40, 2, '#bfefff');\\n        px.rect(g, ox + 20, oy + CFG.FIELD_H - 18, CFG.FIELD_W - 40, 2, '#bfefff');\\n      }\\n      if (RT.wheelShow > 0 && S.players[0] && !S.players[0].gone) {\\n        const c = S.players[0];\\n        for (const w of CFG.WHEEL) {\\n          const x = c.x + ox + w.x * 22, y = c.y + oy + w.y * 22;\\n          const on = c.tool === w.tool;\\n450→          px.disc(g, x, y, on ? 8 : 5, on ? '#5ff0e0' : '#14343c');\\n          GAME.Art.toolIcon(g, w.tool, x - 4, y - 4, 1);\\n        }\\n      }\\n      for (const p of S.players) if (!p.gone) GAME.Art.drawHand(g, p, ox, oy);\\n      const vit = Math.max(0, Math.