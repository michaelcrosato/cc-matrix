, fx * (1 - k), fy * (1 - k)); g.drawImage(t, 0, 0); g.restore(); g._c = null;\\n    }\\n  }\\n  /** end the frame: particles, decals, the queue, lighting, overlays, then present (the game calls it after your\\n   *  draw) */\\n  _finish() {\\n2220→    const game = this.game, g = this.ctx, gpu = this.gpu, iG = this._iG, vp = this._vp;\\n    if (this._only) { this._only = false; for (const f of this._overlays) f(g); game.screen._present(); return; }   // (a split screen's last pass: the frame's own overlays over every viewport)\\n    game.particles.draw(this); this._drawGhosts();\\n    for (const d of this._decals) {\\n      this._tg = null; d.fn(g);\\n      if (gpu && d.e > 0) { iG._mat = this._infoCol(0, 2, d.e); iG._c = null; this._tg = iG; d.fn(iG); }\\n    }\\n    this._tg = null;\\n    this._flush();\\n    if (gpu) {\\n2230→      if (game._zoomTo) this._zoomPreview(game._zoomTo / game.zoom);   // (the lights stay where they were until it is drawn at the new size)\\n      this._tg = this._vG; for (const f of HOOKS.draw) f(game, this, this._vG); for (const f of this._overlays) f(this._vG); this._tg = null;\\n      try { game.gpu._render(this); } catch (e) { game.gpu._fail(e); game.screen._present(); }\\n    } else {\\n      if (game.lights.on) {\\n        if (!g.canvas.standIn) game.lights.render(this);   // (a stand-in screen, headless: no pixels to light)\\n        if (this._emis.length) {\\n          const sG = this._sG, cv = g.canvas;\\n          if (this._emOn) { sG.globalCompositeOperation = 'source-over'; sG.globalAlpha = 1; sG.clearRect(0, 0, this.bw, this.bh); sG.drawImage(cv, 0, 0); sG.globalCompositeOperation = 'destination-in'; sG.drawImage(this._eCv, 0, 0); sG.globalCompositeOperation = 'source-over'; }\\n          this._emis.sort((a, b) => a.k - b.k); for (const it of this._emis) it.fn(g);\\n2240→          if (this._emOn) g.drawImage(this._sCv, 0, 0);   // walls and bodies in front of a glow keep their lit pixels\\n        }\\n      }\\n      if (ga