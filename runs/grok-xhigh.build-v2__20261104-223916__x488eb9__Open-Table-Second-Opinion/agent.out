d: p.index });\\n  }\\n});\\nHOOKS.enter.push(game => {   // a scene's start: the others take its keys too (a half each where they share the keyboard); a split ends\\n  game._split = null; const P = game._players; if (!P || P.length < 2) return;\\n  const I = P[0]; if (I.half && game.scene && game.scene.input) { I._full = I.preset; I.use(Input.halfKeys(I._full, 'left')); }\\n  for (const q of P.slice(1)) q.use(_pPreset(game, q));\\n});\\nHOOKS.step.push((game, dt) => { if (game._split) for (const v of game._split.vps) _vpCam(game, v, dt); });\\n// a split screen's frame: the scene drawn in each viewport (its own camera, lights and overlays, clipped to it), then\\n// the dividers, the scene's hud(r) over the whole screen and the frame's own overlays (notes, pause, fades)\\nHOOKS.frame = (game, shx, shy) => {\\n  const r = game.r, sc = game.scene, S = game._split; _vpLayout(game);\\n  for (const v of S.vps) {\\n    if (v.cam.x === undefined) _vpCam(game, v, 0);\\n    game.lights._clear(); r._begin(v.cam.x + shx - v.x, v.cam.y + shy - v.y, v); r.viewport = v;\\n    if (sc && sc.draw) sc.draw(r);\\n    r._finish();\\n  }\\n  r.viewport = null; r._items.length = 0; r._decals.length = 0; r._overlays.length = 0; r._only = true;\\n  r.overlay(g => { for (const v of S.vps) { if (v.x > 0) px.rect(g, v.x - S.gap, v.y, S.gap, v.h, '#05040a'); if (v.y > 0) px.rect(g, v.x, v.y - S.gap, v.w, S.gap, '#05040a'); } });\\n  if (sc && sc.hud) sc.hud(r);\\n};\\n\\n/* =============================================================================\\n * 10k. SAVE SLOTS  game.saves: three slots and an autosave, each holding the game's own data with its place, time\\n *    played and level, as Dragon Quest's adventure log and Final Fantasy's save screen do. A save is versioned (the\\n *    game's version of its data, migrate for older ones); nothing here throws, and when storage is blocked play goes\\n *    on with the saves kept for the visit (a headless game keeps them in memory only).\\n *      game.saves.write = () => ({ data: { hero, flags }, place: 'Brightwater', level: hero.lv });   // what a save holds\\n *      game.saves.read = save => { hero = save.data.hero; ... };                                    // what a load does\\n\",\"total_lines\":14974}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"e59e501c-e692-4fd2-987d-85cc1da751a4"}
