for (let dx = -hw; dx <= hw; dx++) if (a * (1 - (dx * dx + dy * dy) / R2 * .6) > bayer(cx + dx + wx, cy + dy + wy)) g.fillRect(cx + dx, cy + dy, 1, 1);\"},{\"line_number\":802,\"content\":\"    /** glyphs: the gamepad's button symbols for label(): 'auto' (from the controller's name) | 'xbox' | 'playstation' |\"},{\"line_number\":929,\"content\":\"    return /054c|playstation|dualsense|dualshock|wireless controller/i.test(id) ? 'playstation' : /057e|nintendo|pro controller|joy-con/i.test(id) ? 'nintendo' : 'xbox';\"},{\"line_number\":1298,\"content\":\"  playstation: ['✕', '○', '□', '△', 'L1', 'R1', 'L2', 'R2', 'Create', 'Options', 'L3', 'R3', 'D-pad ↑', 'D-pad ↓', 'D-pad ←', 'D-pad →', 'PS'],\"},{\"line_number\":1300,\"content\":\"  generic: ['Bottom', 'Right', 'Left', 'Top', 'L1', 'R1', 'L2', 'R2', 'Select', 'Start', 'L3', 'R3', 'D-pad ↑', 'D-pad ↓', 'D-pad ←', 'D-pad →', 'Home']\"},{\"line_number\":1517,\"content\":\"      const R = L.r, R2 = R * R, lc = L.color ? hex(L.color) : [255, 236, 200], cr = lc[0] / 255, cg = lc[1] / 255, cb = lc[2] / 255;\"},{\"line_number\":1529,\"content\":\"          for (let pxx = X0; pxx <= X1; pxx++, k++, gx += inv[0], gy += inv[2]) { const d2 = gx * gx + gy * gy; if (d2 < R2) { const f = (1 - d2 / R2) * L.i; I[k] += f; if (al) { CR[k] += f * cr; CG[k] += f * cg; CB[k] += f * cb; } } }\"},{\"line_number\":3025,\"content\":\" *      'playstation', options: [['playstation', 'PlayStation'], ['xbox', 'Xbox']] } shows PlayStation symbols unless the\"},{\"line_number\":3066,\"content\":\"  glyphs: { group: 'Controller', label: 'Button symbols', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['xbox', 'Xbox'], ['playstation', 'PlayStation'], ['nintendo', 'Nintendo'], ['generic', 'Positions']], apply: (g, v) => { for (const q of g._players || [g.input]) q.glyphs = v; } },\"},{\"line_number\":12328,\"content\":\"    const out = new Set([c[0] + ',' + c[1]]), R2 = (radius + .5) ** 2;\"},{\"line_number\":12329,\"content\":\"    cons