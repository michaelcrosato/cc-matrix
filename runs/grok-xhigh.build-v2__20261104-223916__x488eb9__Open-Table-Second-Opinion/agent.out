peed', 200);\\n    check('assist and cursor prefs stay clean', GAME.TUNE.dirty === dirtyBefore && GAME.PREFS.assist === 0.4 && GAME.PREFS.cursor === 200);\\n    game.settings.set('assist', 0.6);\\n    game.settings.set('cursorSpeed', 330);\\n    game.settings.set('glyphs', 'xbox');\\n    check('Xbox prompt', game.input.label('useTool', 'gamepad') === 'RT', game.input.label('useTool', 'gamepad'));\\n    game.settings.set('glyphs', 'playstation');\\n    check('keyboard prompt', game.input.label('useTool', 'keyboard') === 'Space', game.input.label('useTool', 'keyboard'));\\n    game.input.tap('cancel');\\n    game.advance(game.o.step);\\n    check('dev closes', !RT.devOpen);\\n\\n    const A = GAME.ABOUT;\\n    check('usage line', A.sourceInformation.usage === 'added on import');\\n    check('feedback lengths', A.testingFeedback.length === 4 && A.engineFeedback.length === 6 && A.promptFeedback.length === 4);\\n    check('about name', A.aiHub.name === 'Open Table Second Opinion');\\n    check('no empty about lines', GAME.About.ORDER.every((k) => String(A.sourceInformation[k]).length > 0));\\n\\n    game.go('title');\\n    enter();\\n    game.debug.skipStory = true;\\n    game.debug.driver = () => {\\n      const S = RT.S;\\n      if (!S) return { aim: [0, 0], trig: 0 };\\n      return GAME.Bot.device(S, 0, 1 / 45);\\n    };\\n    RT.ranks = {};\\n    RT.cheatUsed = false;\\n    GAME.Dev.reset();\\n    game.input.feed('move', 1, 1);\\n    press('confirm');\\n    press('confirm');\\n    check('new game reaches difficulty', game.sceneName === 'difficulty', game.sceneName);\\n    const diff = GAME.Shell.snapshot().menu;\\n    check('intern is first', diff && diff.labels[0] === 'Intern' && diff.i === 0, JSON.stringify(diff));\\n    press('down');\\n    check('one down is resident', GAME.Shell.snapshot().menu.i === 1 && GAME.Shell.snapshot().menu.labels[1] === 'Resident');\\n    press('confirm');\\n    let guard = 0;\\n    while (game.sceneName !== 'title' && guard < 160) {\\n      const sn = GAME.Shell.snapshot();\\n      const key = game.sceneName;\\n      if (key === 'story' && sn.choice) press('confirm');\\n      else if (key === 'story') game.advance(0.25);\\n      else if (key === 'chart') {\\n        const m = sn.lightbox || [248, 96];\\n        game.input.feed('move', m[0], m[1]);\\n        game.input.feed('down', m[0], m[1]);\\n        game.input.feed('up', m[0], m[1]);\\n        enter();\\n      } else if (key === 'op') game.advance(0.4);\\n      else if (key === 'results' || key === 'ward' || key === 'credits' || key === 'menu' || key === 'difficulty') press('confirm');\\n      else game.advance(0.2);\\n      guard += 1;\\n    }\\n    game.debug.driver = null;\\n    game.debug.skipStory = false;\\n    const ranks = GAME.Shell.snapshot().ranks;\\n    check('a new game returns to the title', game.sceneName === 'title', game.sceneName + ' guard ' + guard);\\n    check('every case ranks S', GAME.ORDER.every((id) => ranks[id] === 'S'), JSON.stringify(ranks));\\n    check('the run draws clean', !game.errors.length, JSON.stringify(game.errors).slice(0, 400));\\n  });\\n\\n  const finish = () => {\\n    for (const line of fails) console.log(line);\\n    console.log(n + ' checks, ' + fails.length + ' failed');\\n    process.exit(fails.length ? 1 : 0);\\n  };\\n\\n  if (fast) finish();\\n  else {\\n    runLive().then(() => finish()).catch((e) => {\\n      n += 1;\\n      fails.push('FAIL live: ' + (e && e.stack ? e.stack : e));\\n      finish();\\n    });\\n  }\\n\\n  async function runLive() {\\n    const htmlName = GAME.CFG.FILE + '.html';\\n\",\"total_lines\":810}}","is_error":false},{"type":"tool_result","tool_use_id":"call-1a82e89b-dac7-4305-b72c-56abed3acb54-34","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→/* Perfect resident. Reads the live operation and aims the way a mouse would.\\n   The same function drives tests, attract mode, and couch colleagues. */\\n(() => {\\n  const G = typeof window !== 'undefined' ? window : globalThis;\\n  const GAME = (G.GAME ||= {});\\n  const DIGIT = { forceps: 1, scalpel: 2, suture: 3, salve: 4, syringe: 5, cautery: 6, suction: 7, sonar: 8 };\\n  const mems = new WeakMap();\\n\\n  function hyp(x, y) { return Math.hypot(x, y); }\\n10→  function mem(S) {\\n    let m = mems.get(S);\\n    if (!m) {\\n      m = { ang: 0, skip: 0, giftCd: 0, saw: 0, stuck: 0, gid: 0, prog: -1 };\\n      mems.set(S, m);\\n    }\\n    return m;\\n  }\\n  function go(tool, x, y, trig, extra) {\\n    extra = extra || {};\\n20→    return {\\n      digit: DIGIT[tool] || 1, mouse: [x, y], trig: trig ? 1 : 0,\\n      fine: !!extra.fine, gift: !!extra.gift, consult: !!extra.consult, cancel: false,\\n      aim: [0, 0], move: [0, 0], why: extra.why || tool,\\n    };\\n  }\\n  function idle(p, extra) {\\n    return go(p.tool || 'forceps', p.bx, p.by, 0, extra);\\n  }\\n  function ignored(o) {\\n30→    if (!o || o.done || !o.alive || o.optional) return true;\\n    if (o.type === 'nerve' || o.type === 'eloquent' || o.type === 'hold' || o.type === 'retractor') return true;\\n    if (o.type === 'bead' && o.tag !== 'dacapo-bead') return true;\\n    return false;\\n  }\\n  function toolFor(o) {\\n    if (o.hidden && !o.marked) return 'sonar';\\n    if (o.type === 'pool') return 'suction';\\n    if (o.type === 'laceration' || o.type === 'patch' || o.type === 'bite') return 'salve';\\n    if (o.type === 'wound' || o.type === 'arteryTear') return 'suture';\\n40→    if (o.type === 'clot') return o.dosed ? 'forceps' : 'syringe';\\n    if (o.type === 'reed' || o.type === 'voice') return 'syringe';\\n    if (o.type === 'lobe') return o.mode === 'scalpel' ? 'scalpel' : o.mode || 'cautery';\\n    if (o.type === 'mass' || o.type === 'nest') return o.cut ? 'forceps' : 'scalpel';\\n    if (o.type === 'bleeder' || o.type === 'polyp' || o.type === 'rupture' || o.type === 'bead' || o.type === 'uvula' || o.type === 'eye' || o.type === 'tremass' || o.type === 'barb') return 'cautery';\\n    if (o.type === 'slur' || o.type === 'tendril' || o.type === 'spiral' || o.type === 'wire' || o.type === 'repeat' || o.type === 'cut') return 'scalpel';\\n    if (o.guide && !o.cut) return 'scalpel';\\n    if (o.pairs) return 'suture';\\n    if (o.cells && (o.type === 'laceration' || o.type === 'patch' || o.type === 'bite' || o.mode === 'salve')) return 'salve';\\n    return 'forceps';\\n50→  }\\n  function usable(S, o) {\\n    if (o.hidden && !o.marked) return true;\\n    if (o.type === 'lobe' && !o.open) return false;\\n    if (o.type === 'eye' && !o.open) return false;\\n    if (o.type === 'repeat' && !o.open) return false;\\n    if (o.type === 'reed' || o.type === 'voice') return true;\\n    if (o.needsWindow && S.windowOpen <= 0) return false;\\n    if (o.needsBoard && S.device && !S.device.shown) return false;\\n    return true;\\n60→  }\\n  function goals(S) {\\n    const list = [];\\n    const seen = new Set();\\n    const push = o => { if (o && !seen.has(o.id) && !ignored(o)) { seen.add(o.id); list.push(o); } };\\n    const sign = S.objects.find(o => o.tag === 'repeat' && o.open && !o.done);\\n    if (sign) push(sign);\\n    for (const o of S.objects) {\\n      if (ignored(o)) continue;\\n      if (S.device && S.device.order && o.type === 'wire' && o.tag !== S.device.order[S.device.next || 0]) continue;\\n70→      if (o.under) {\\n        const pool = GAME.Sim.objById(S, o.under);\\n        if (pool && !pool.done && pool.vol > 1) { push(pool); continue; }\\n      }\\n      push(o);\\n    }\\n    list.sort((a, b) => (a.order - b.order) || (b.drain - a.drain) || (a.id - b.id));\\n    return list;\\n  }\\n  function pointAlong(pts, dist) {\\n80→    let left = dist;\\n    for (let i = 1; i < pts.length; i++) {\\n      const L = hyp(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]) || 1;\\n      if (left <= L) {\\n        const u = left / L;\\n        return [pts[i - 1][0] + (pts[i][0] - pts[i - 1][0]) * u, pts[i - 1][1] + (pts[i][1] - pts[i - 1][1]) * u];\\n      }\\n      left -= L;\\n    }\\n    return pts[pts.length - 1].slice();\\n90→  }\\n  function polyLen(pts) {\\n    let n = 0;\\n    for (let i = 1; i < pts.length; i++) n += hyp(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]);\\n    return n || 1;\\n  }\\n  function shock(S, p) {\\n    const peaks = [0.9, 1.8, 2.7, 3.6];\\n    const cb = S.codeBlue;\\n    const peak = peaks[cb.next] == null ? 99 : peaks[cb.next];\\n100→    const on = Math.abs(cb.t - peak) <= 0.045;\\n    return go('forceps', p.bx, p.by, on, { why: 'shock' });\\n  }\\n  function dressing(S, p) {\\n    const u = S.dressing.t % 1.2;\\n    return go('suture', p.bx, p.by, u < 0.045, { why: 'stamp' });\\n  }\\n  function act(S, p, o, dt, m) {\\n    const tool = toolFor(o);\\n    const fine = !!(S.strain && S.strain.jitter) || (o.tension && o.tension < 80) || tool === 'suture' || tool === 'scalpel';\\n110→    const near = (x, y, r) => hyp(p.bx - x, p.by - y) <= r;\\n\\n    if (tool === 'sonar') return go('sonar', o.x, o.y, 1, { fine, why: 'sonar' });\\n    if (tool === 'suction') return go('suction', o.x, o.y, 1, { why: 'suction' });\\n\\n    if (tool === 'salve') {\\n      const cell = (o.cells || []).find(c => !c[2]);\\n      const x = cell ? cell[0] : o.x, y = cell ? cell[1] : o.y;\\n      return go('salve', x, y, 1, { why: 'salve' });\\n    }\\n120→\\n    if (tool === 'syringe' && (o.type === 'reed' || o.type === 'voice')) {\\n      const beat = (S.strain && S.strain.beat) || 0;\\n      /* Charge in clear tissue. A closed reed splits if the needle lets go on it, and the neighbors sit inside that reach. */\\n      const park = [46, 188];\\n      if (!o.window) {\\n        if (p.fill >= 0.97) return go('syringe', park[0], park[1], 0, { fine: true, why: 'dump' });\\n        const charging = p.cool <= 0 && p.fill < 0.94 && beat >= 0.12 && beat < 0.68;\\n        return go('syringe', park[0], park[1], charging || (p.fill > 0.05 && p.fill < 0.94), { fine: true, why: 'prime' });\\n      }\\n130→      if (p.fill < 0.9) return go('syringe', o.x, o.y, 1, { fine: true, why: 'fill' });\\n      return go('syringe', o.x, o.y, 0, { fine: true, why: 'dose' });\\n    }\\n\\n    if (tool === 'syringe') {\\n      if (!near(o.x, o.y, 3)) return go('syringe', o.x, o.y, p.fill > 0.2 && p.fill < 0.96 ? 1 : 0, { fine, why: 'aimdose' });\\n      if (p.fill < 0.93 && p.cool <= 0) return go('syringe', o.x, o.y, 1, { fine, why: 'fill' });\\n      return go('syringe', o.x, o.y, 0, { fine, why: 'dose' });\\n    }\\n\\n140→    if (tool === 'cautery') {\\n      if (p.lock > 0 || p.heat > 0.78) return go('cautery', o.x, o.y, 0, { why: 'cool' });\\n      return go('cautery', o.x, o.y, 1, { why: 'burn' });\\n    }\\n\\n    if (tool === 'suture') {\\n      const pair = o.pairs[o.stitch || 0];\\n      if (!pair) return idle(p, { why: 'nopair' });\\n      const a = pair[0], b = pair[1];\\n      if (!(p.stroke && p.stroke.kind === 'suture' && p.stroke.id === o.id)) {\\n150→        return go('suture', a[0], a[1], near(a[0], a[1], 2), { fine: true, why: 'needle' });\\n      }\\n      if (near(b[0], b[1], 1.2)) return go('suture', b[0], b[1], 0, { fine: true, why: 'pop' });\\n      const dx = b[0] - p.bx, dy = b[1] - p.by, d = hyp(dx, dy) || 1;\\n      const step = Math.min(d, 90 * dt);\\n      return go('suture', p.bx + dx / d * step, p.by + dy / d * step, 1, { fine: true, why: 'cross' });\\n    }\\n\\n    if (tool === 'scalpel' && (o.slash || o.type === 'nest' || (o.type === 'lobe' && o.mode === 'scalpel')) && !o.guide) {\\n      if (!near(o.x - 8, o.y, 2)) return go('scalpel', o.x - 8, o.y, 0, { why: 'windup' });\\n160→      return go('scalpel', o.x + 8, o.y, 1, { why: 'slash' });\\n    }\\n    if (tool === 'scalpel' && o.type === 'lobe' && o.slash && !o.cut) {\\n      if (!near(o.x - 8, o.y, 2)) return go('scalpel', o.x - 8, o.y, 0, { why: 'windup' });\\n      return go('scalpel', o.x + 8, o.y, 1, { why: 'slash' });\\n    }\\n\\n    if (tool === 'scalpel' && o.guide) {\\n      const g = o.guide;\\n      const start = g[0];\\n170→      if (!(p.stroke && p.stroke.kind === 'scalpel' && p.stroke.id === o.id) || p.stroke.paused) {\\n        return go('scalpel', start[0], start[1], near(start[0], start[1], 2) ? 1 : 0, { fine, why: 'start' });\\n      }\\n      if (o.beatLock && S.flags.onBeat) return go('scalpel', p.bx, p.by, 1, { fine: true, why: 'waitbeat' });\\n      const far = p.stroke.far || 0;\\n      const pt = pointAlong(g, Math.min(polyLen(g), far + 160 * dt + 0.8));\\n      return go('scalpel', pt[0], pt[1], 1, { fine, why: 'trace' });\\n    }\\n\\n    if (o.type === 'screw') {\\n180→      if (p.held !== o.id) {\\n        const on = near(o.x + 12, o.y, 3);\\n        return go('forceps', o.x + 12, o.y, on && p.prevTrig <= 0.3, { why: 'screw' });\\n      }\\n      m.ang += 0.55;\\n      return go('forceps', o.x + Math.cos(m.ang) * 12, o.y + Math.sin(m.ang) * 12, 1, { why: 'turn' });\\n    }\\n\\n    if (tool === 'forceps') {\\n      if (p.held && p.held !== o.id) return go('forceps', p.bx, p.by, 0, { why: 'drop' });\\n190→      if (p.held !== o.id) {\\n        const on = near(o.x, o.y, 2.5);\\n        return go('forceps', o.x, o.y, on && p.prevTrig <= 0.3, { fine, why: 'grip' });\\n      }\\n      const limit = Math.min(78, (o.tension || 120) * 0.6);\\n      const ox = o.origin[0], oy = o.origin[1];\\n      const along = (p.bx - ox) * o.axis[0] + (p.by - oy) * o.axis[1];\\n      /* Stay on the trigger until the sim calls it free. Releasing at depth-epsilon drops a deep pull. */\\n      if (!o.free) {\\n        const n = Math.min((o.depth || 16) + 1.5, along + limit * dt);\\n200→        return go('forceps', ox + o.axis[0] * n, oy + o.axis[1] * n, 1, { fine: limit < 70, why: 'pull' });\\n      }\\n      const tx = ox + o.axis[0] * (Math.max(o.depth, 0) + 30);\\n      const ty = oy + o.axis[1] * (Math.max(o.depth, 0) + 30);\\n      const dx = tx - p.bx, dy = ty - p.by, d = hyp(dx, dy) || 1;\\n      if (hyp(p.bx - ox, p.by - oy) < 26) {\\n        const step = Math.min(d, limit * dt);\\n        return go('forceps', p.bx + dx / d * step, p.by + dy / d * step, 1, { fine: true, why: 'carry' });\\n      }\\n      return go('forceps', p.bx, p.by, 0, { why: 'dish' });\\n210→    }\\n    return go(tool, o.x, o.y, 1, { why: 'generic' });\\n  }\\n\\n  function device(S, i, dt) {\\n    const p = S.players[i] || S.players[0];\\n    const m = mem(S);\\n    if (m.giftCd > 0) m.giftCd -= dt;\\n    if (m.consultCd > 0) m.consultCd -= dt;\\n    if (!p || p.gone) return idle(S.players[0] || { bx: 213, by: 150, tool: 'forceps' });\\n220→    if (S.won || S.lost) return idle(p);\\n    if (S.codeBlue) return shock(S, p);\\n    if (S.dressing) return dressing(S, p);\\n\\n    const n = S.players.filter(q => !q.gone).length;\\n    if (n > 1 && i === 0 && S.objects.some(o => o.needsWindow && !o.done && o.alive)) {\\n      const h = S.objects.find(o => o.type === 'retractor' && !o.done);\\n      if (h) return go('forceps', h.x, h.y, 1, { why: 'hold' });\\n    }\\n\\n230→    let gift = false, consult = false;\\n    const breathOk = S.gift === 'breath' || S.activeDoc === 'vale' || (S.gift === 'both' && S.activeDoc !== 'sokolova');\\n    const lookOk = S.gift === 'look' || S.activeDoc === 'sokolova' || S.gift === 'both';\\n    if (!S.breath && m.giftCd <= 0 && S.steady >= 35 && breathOk && (S.flags.needBreath || (S.strain && S.strain.jitter && S.strain.kind === 'tremolo'))) {\\n      gift = true; m.giftCd = 0.5;\\n    }\\n    if (!gift && !S.breath && m.giftCd <= 0 && S.steady >= 45 && lookOk && S.flags.needLook && S.mode !== 'rounds' && (S.slips || 0) > (m.seenSlips || 0)) {\\n      gift = true; m.giftCd = 1.2; m.seenSlips = S.slips;\\n    }\\n    const wantDoc = S.flags.needLook ? 'sokolova' : (S.flags.needBreath ? 'vale' : null);\\n240→    if (S.consult && wantDoc && S.activeDoc !== wantDoc && (m.consultCd || 0) <= 0) {\\n      consult = true; m.consultCd = 0.45;\\n    }\\n    if (gift || consult) return go(p.tool || 'forceps', p.bx, p.by, 0, { gift, consult, why: 'gift' });\\n\\n    if (S.device && !S.device.shown && S.objects.some(o => o.needsBoard && !o.done)) {\\n      return go('sonar', S.device.x || 213, S.device.y || 100, 1, { why: 'board' });\\n    }\\n\\n    const needIv = S.flags.needIv && (S.flags.iv || 0) < S.flags.needIv;\\n250→    const blocking = S.objects.some(o => !o.done && (o.type === 'rupture' || o.type === 'reed' || o.type === 'arteryTear'));\\n    if ((needIv || S.vitals < 42) && p.cool <= 0 && !blocking) {\\n      if (p.fill < 0.93) return go('syringe', 46, 188, 1, { why: 'iv' });\\n      return go('syringe', 46, 188, 0, { why: 'iv' });\\n    }\\n\\n    const list = goals(S).filter(o => usable(S, o));\\n    if (!list.length) return idle(p, { why: 'wait', fine: !!(S.strain && S.strain.jitter) });\\n    const o = list[Math.min(i, list.length - 1) % list.length];\\n    if (m.gid === o.id && Math.abs((o.prog || 0) - m.prog) < 0.01 && usable(S, o) && o.type !== 'reed' && o.type !== 'voice' && o.type !== 'lobe' && o.type !== 'eye') m.stuck += dt;\\n260→    else m.stuck = 0;\\n    m.gid = o.id; m.prog = o.prog || 0;\\n    if (m.stuck > 8) m.whyStuck = (S.phaseName || '') + ':' + o.type + ':' + (o.tag || '');\\n    const d = act(S, p, o, dt || 1 / 60, m);\\n    if (S.strain && S.strain.jitter) d.fine = true;\\n    return d;\\n  }\\n\\n  function play(S, maxT, dt) {\\n    dt = dt || 1 / 60;\\n270→    const t0 = S.t;\\n    let guard = 0;\\n    while (S.t - t0 < maxT && !S.won && !S.lost && guard < 200000) {\\n      const inputs = [];\\n      for (let i = 0; i < S.players.length; i++) {\\n        const dev = device(S, i, dt);\\n        const p = S.players[i];\\n        GAME.Wheel.update(p, dev, dt);\\n        if (dev.mouse) GAME.Cursor.update(p, { mouse: dev.mouse, fine: dev.fine }, S, dt);\\n        inputs.push({ tool: p.tool, trig: dev.trig, fine: !!dev.fine, gift: !!dev.gift, consult: !!dev.consult, cancel: false, mouse: true });\\n280→      }\",\"content_concise\":\"1→/* Perfect resident. Reads the live operation and aims the way a mouse would.\\n   The same function drives tests, attract mode, and couch colleagues. */\\n(() => {\\n  const G = typeof window !== 'undefined' ? window : globalThis;\\n  const GAME = (G.GAME ||= {});\\n  const DIGIT = { forceps: 1, scalpel: 2, suture: 3, salve: 4, syringe: 5, cautery: 6, suction: 7, sonar: 8 };\\n  const mems = new WeakMap();\\n\\n  function hyp(x, y) { return Math.hypot(x, y); }\\n10→  function mem(S) {\\n    let m = mems.get(S);\\n    if (!m) {\\n      m = { ang: 0, skip: 0, giftCd: 0, saw: 0, stuck: 0, gid: 0, prog: -1 };\\n      mems.set(S, m);\\n    }\\n    return m;\\n  }\\n  function go(tool, x, y, trig, extra) {\\n    extra = extra || {};\\n20→    return {\\n      digit: DIGIT[tool] || 1, mouse: [x, y], trig: trig ? 1 : 0,\\n      fine: !!extra.fine, gift: !!extra.gift, consult: !!extra.consult, cancel: false,\\n      aim: [0, 0], move: [0, 0], why: extra.why || tool,\\n    };\\n  }\\n  function idle(p, extra) {\\n    return go(p.tool || 'forceps', p.bx, p.by, 0, extra);\\n  }\\n  function ignored(o) {\\n30→    if (!o || o.done || !o.alive || o.optional) return true;\\n    if (o.type === 'nerve' || o.type === 'eloquent' || o.type === 'hold' || o.type === 'retractor') return true;\\n    if (o.type === 'bead' && o.tag !== 'dacapo-bead') return true;\\n    return false;\\n  }\\n  function toolFor(o) {\\n    if (o.hidden && !o.marked) return 'sonar';\\n    if (o.type === 'pool') return 'suction';\\n    if (o.type === 'laceration' || o.type === 'patch' || o.type === 'bite') return 'salve';\\n    if (o.type === 'wound' || o.type === 'arteryTear') return 'suture';\\n40→    if (o.type === 'clot') return o.dosed ? 'forceps' : 'syringe';\\n    if (o.type === 'reed' || o.type === 'voice') return 'syringe';\\n    if (o.type === 'lobe') return o.mode === 'scalpel' ? 'scalpel' : o.mode || 'cautery';\\n    if (o.type === 'mass' || o.type === 'nest') return o.cut ? 'forceps' : 'scalpel';\\n    if (o.type === 'bleeder' || o.type === 'polyp' || o.type === 'rupture' || o.type === 'bead' || o.type === 'uvula' || o.type === 'eye' || o.type === 'tremass' || o.type === 'barb') return 'cautery';\\n    if (o.type === 'slur' || o.type === 'tendril' || o.type === 'spiral' || o.type === 'wire' || o.type === 'repeat' || o.type === 'cut') return 'scalpel';\\n    if (o.guide && !o.cut) return 'scalpel';\\n    if (o.pairs) return 'suture';\\n    if (o.cells && (o.type === 'laceration' || o.type === 'patch' || o.type === 'bite' || o.mode === 'salve')) return 'salve';\\n    return 'forceps';\\n50→  }\\n  function usable(S, o) {\\n    if (o.hidden && !o.marked) return true;\\n    if (o.type === 'lobe' && !o.open) return false;\\n    if (o.type === 'eye' && !o.open) return false;\\n    if (o.type === 'repeat' && !o.open) return false;\\n    if (o.type === 'reed' || o.type === 'voice') return true;\\n    if (o.needsWindow && S.windowOpen <= 0) return false;\\n    if (o.needsBoard && S.device && !S.device.shown) return false;\\n    return true;\\n60→  }\\n  function goals(S) {\\n    const list = [];\\n    const seen = new Set();\\n    const push = o => { if (o && !seen.has(o.id) && !ignored(o)) { seen.add(o.id); list.push(o); } };\\n    const sign = S.objects.find(o => o.tag === 'repeat' && o.open && !o.done);\\n    if (sign) push(sign);\\n    for (const o of S.objects) {\\n      if (ignored(o)) continue;\\n      if (S.device && S.device.order && o.type === 'wire' && o.tag !== S.device.order[S.device.next || 0]) continue;\\n70→      if (o.under) {\\n        const pool = GAME.Sim.objById(S, o.under);\\n        if (pool && !pool.done && pool.vol > 1) { push(pool); continue; }\\n      }\\n      push(o);\\n    }\\n    list.sort((a, b) => (a.order - b.order) || (b.drain - a.drain) || (a.id - b.id));\\n    return list;\\n  }\\n  function pointAlong(pts, dist) {\\n80→    let left = dist;\\n    for (let i = 1; i < pts.length; i++) {\\n      const L = hyp(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]) || 1;\\n      if (left <= L) {\\n        const u = left / L;\\n        return [pts[i - 1][0] + (pts[i][0] - pts[i - 1][0]) * u, pts[i - 1][1] + (pts[i][1] - pts[i - 1][1]) * u];\\n      }\\n      left -= L;\\n    }\\n    return pts[pts.length - 1].slice();\\n90→  }\\n  function polyLen(pts) {\\n    let n = 0;\\n    for (let i = 1; i < pts.length; i++) n += hyp(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]);\\n    return n || 1;\\n  }\\n  function shock(S, p) {\\n    const peaks = [0.9, 1.8, 2.7, 3.6];\\n    const cb = S.codeBlue;\\n    const peak = peaks[cb.next] == null ? 99 : peaks[cb.next];\\n100→    const on = Math.abs(cb.t - peak) <= 0.045;\\n    return go('forceps', p.bx, p.by, on, { why: 'shock' });\\n  }\\n  function dressing(S, p) {\\n    const u = S.dressing.t % 1.2;\\n    return go('suture', p.bx, p.by, u < 0.045, { why: 'stamp' });\\n  }\\n  function act(S, p, o, dt, m) {\\n    const tool = toolFor(o);\\n    const fine = !!(S.strain && S.strain.jitter) || (o.tension && o.tension < 80) || tool === 'suture' || tool === 'scalpel';\\n110→    const near = (x, y, r) => hyp(p.bx - x, p.by - y) <= r;\\n\\n    if (tool === 'sonar') return go('sonar', o.x, o.y, 1, { fine, why: 'sonar' });\\n    if (tool === 'suction') return go('suction', o.x, o.y, 1, { why: 'suction' });\\n\\n    if (tool === 'salve') {\\n      const cell = (o.cells || []).find(c => !c[2]);\\n      const x = cell ? cell[0] : o.x, y = cell ? cell[1] : o.y;\\n      return go('salve', x, y, 1, { why: 'salve' });\\n    }\\n120→\\n    if (tool === 'syringe' && (o.type === 'reed' || o.type === 'voice')) {\\n      const beat = (S.strain && S.strain.beat) || 0;\\n      /* Charge in clear tissue. A closed reed splits if the needle lets go on it, and the neighbors sit inside that reach. */\\n      const park = [46, 188];\\n      if (!o.window) {\\n        if (p.fill >= 0.97) return go('syringe', park[0], park[1], 0, { fine: true, why: 'dump' });\\n        const charging = p.cool <= 0 && p.fill < 0.94 && beat >= 0.12 && beat < 0.68;\\n        return go('syringe', park[0], park[1], charging || (p.fill > 0.05 && p.fill < 0.94), { fine: true, why: 'prime' });\\n      }\\n130→      if (p.fill < 0.9) return go('syringe', o.x, o.y, 1, { fine: true, why: 'fill' });\\n      return go('syringe', o.x, o.y, 0, { fine: true, why: 'dose' });\\n    }\\n\\n    if (tool === 'syringe') {\\n      if (!near(o.x, o.y, 3)) return go('syringe', o.x, o.y, p.fill > 0.2 && p.fill < 0.96 ? 1 : 0, { fine, why: 'aimdose' });\\n      if (p.fill < 0.93 && p.cool <= 0) return go('syringe', o.x, o.y, 1, { fine, why: 'fill' });\\n      return go('syringe', o.x, o.y, 0, { fine, why: 'dose' });\\n    }\\n\\n140→    if (tool === 'cautery') {\\n      if (p.lock > 0 || p.heat > 0.78) return go('cautery', o.x, o.y, 0, { why: 'cool' });\\n      return go('cautery', o.x, o.y, 1, { why: 'burn' });\\n    }\\n\\n    if (tool === 'suture') {\\n      const pair = o.pairs[o.stitch || 0];\\n      if (!pair) return idle(p, { why: 'nopair' });\\n      const a = pair[0], b = pair[1];\\n      if (!(p.stroke && p.stroke.kind === 'suture' && p.stroke.id === o.id)) {\\n150→        return go('suture', a[0], a[1], near(a[0], a[1], 2), { fine: true, why: 'needle' });\\n      }\\n      if (near(b[0], b[1], 1.2)) return go('suture', b[0], b[1], 0, { fine: true, why: 'pop' });\\n      const dx = b[0] - p.bx, dy = b[1] - p.by, d = hyp(dx, dy) || 1;\\n      const step = Math.min(d, 90 * dt);\\n      return go('suture', p.bx + dx / d * step, p.by + dy / d * step, 1, { fine: true, why: 'cross' });\\n    }\\n\\n    if (tool === 'scalpel' && (o.slash || o.type === 'nest' || (o.type === 'lobe' && o.mode === 'scalpel')) && !o.guide) {\\n      if (!near(o.x - 8, o.y, 2)) return go('scalpel', o.x - 8, o.y, 0, { why: 'windup' });\\n160→      return go('scalpel', o.x + 8, o.y, 1, { why: 'slash' });\\n    }\\n    if (tool === 'scalpel' && o.type === 'lobe' && o.slash && !o.cut) {\\n      if (!near(o.x - 8, o.y, 2)) return go('scalpel', o.x - 8, o.y, 0, { why: 'windup' });\\n      return go('scalpel', o.x + 8, o.y, 1, { why: 'slash' });\\n    }\\n\\n    if (tool === 'scalpel' && o.guide) {\\n      const g = o.guide;\\n      const start = g[0];\\n170→      if (!(p.stroke && p.stroke.kind === 'scalpel' && p.stroke.id === o.id) || p.stroke.paused) {\\n        return go('scalpel', start[0], start[1], near(start[0], start[1], 2) ? 1 : 0, { fine, why: 'start' });\\n      }\\n      if (o.beatLock && S.flags.onBeat) return go('scalpel', p.bx, p.by, 1, { fine: true, why: 'waitbeat' });\\n      const far = p.stroke.far || 0;\\n      const pt = pointAlong(g, Math.min(polyLen(g), far + 160 * dt + 0.8));\\n      return go('scalpel', pt[0], pt[1], 1, { fine, why: 'trace' });\\n    }\\n\\n    if (o.type === 'screw') {\\n180→      if (p.held !== o.id) {\\n        const on = near(o.x + 12, o.y, 3);\\n        return go('forceps', o.x + 12, o.y, on && p.prevTrig <= 0.3, { why: 'screw' });\\n      }\\n      m.ang += 0.55;\\n      return go('forceps', o.x + Math.cos(m.ang) * 12, o.y + Math.sin(m.ang) * 12, 1, { why: 'turn' });\\n    }\\n\\n    if (tool === 'forceps') {\\n      if (p.held && p.held !== o.id) return go('forceps', p.bx, p.by, 0, { why: 'drop' });\\n190→      if (p.held !== o.id) {\\n        const on = near(o.x, o.y, 2.5);\\n        return go('forceps', o.x, o.y, on && p.prevTrig <= 0.3, { fine, why: 'grip' });\\n      }\\n      const limit = Math.min(78, (o.tension || 120) * 0.6);\\n      const ox = o.origin[0], oy = o.origin[1];\\n      const along = (p.bx - ox) * o.axis[0] + (p.by - oy) * o.axis[1];\\n      /* Stay on the trigger until the sim calls it free. Releasing at depth-epsilon drops a deep pull. */\\n      if (!o.free) {\\n        const n = Math.min((o.depth || 16) + 1.5, along + limit * dt);\\n200→        return go('forceps', ox + o.axis[0] * n, oy + o.axis[1] * n, 1, { fine: limit < 70, why: 'pull' });\\n      }\\n      const tx = ox + o.axis[0] * (Math.max(o.depth, 0) + 30);\\n      const ty = oy + o.axis[1] * (Math.max(o.depth, 0) + 30);\\n      const dx = tx - p.bx, dy = ty - p.by, d = hyp(dx, dy) || 1;\\n      if (hyp(p.bx - ox, p.by - oy) < 26) {\\n        const step = Math.min(d, limit * dt);\\n        return go('forceps', p.bx + dx / d * step, p.by + dy / d * step, 1, { fine: true, why: 'carry' });\\n      }\\n      return go('forceps', p.bx, p.by, 0, { why: 'dish' });\\n210→    }\\n    return go(tool, o.x, o.y, 1, { why: 'generic' });\\n  }\\n\\n  function device(S, i, dt) {\\n    const p = S.players[i] || S.players[0];\\n    const m = mem(S);\\n    if (m.giftCd > 0) m.giftCd -= dt;\\n    if (m.consultCd > 0) m.consultCd -= dt;\\n    if (!p || p.gone) return idle(S.players[0] || { bx: 213, by: 150, tool: 'forceps' });\\n220→    if (S.won || S.lost) return idle(p);\\n    if (S.codeBlue) return shock(S, p);\\n    if (S.dressing) return dressing(S, p);\\n\\n    const n = S.players.filter(q => !q.gone).length;\\n    if (n > 1 && i === 0 && S.objects.some(o => o.needsWindow && !o.done && o.alive)) {\\n      const h = S.objects.find(o => o.type === 'retractor' && !o.done);\\n      if (h) return go('forceps', h.x, h.y, 1, { why: 'hold' });\\n    }\\n\\n230→    let gift = false, consult = false;\\n    const breathOk = S.gift === 'breath' || S.activeDoc === 'vale' || (S.gift === 'both' && S.activeDoc !== 'sokolova');\\n    const lookOk = S.gift === 'look' || S.activeDoc === 'sokolova' || S.gift === 'both';\\n    if (!S.breath && m.giftCd <= 0 && S.steady >= 35 && breathOk && (S.flags.needBreath || (S.strain && S.strain.jitter && S.strain.kind === 'tremolo'))) {\\n      gift = true; m.giftCd = 0.5;\\n    }\\n    if (!gift && !S.breath && m.giftCd <= 0 && S.steady >= 45 && lookOk && S.flags.needLook && S.mode !== 'rounds' && (S.slips || 0) > (m.seenSlips || 0)) {\\n      gift = true; m.giftCd = 1.2; m.seenSlips = S.slips;\\n    }\\n    const wantDoc = S.flags.needLook ? 'sokolova' : (S.flags.needBreath ? 'vale' : null);\\n240→    if (S.consult && wantDoc && S.activeDoc !== wantDoc && (m.consultCd || 0) <= 0) {\\n      consult = true; m.consultCd = 0.45;\\n    }\\n    if (gift || consult) return go(p.tool || 'forceps', p.bx, p.by, 0, { gift, consult, why: 'gift' });\\n\\n    if (S.device && !S.device.shown && S.objects.some(o => o.needsBoard && !o.done)) {\\n      return go('sonar', S.device.x || 213, S.device.y || 100, 1, { why: 'board' });\\n    }\\n\\n    const needIv = S.flags.needIv && (S.flags.iv || 0) < S.flags.needIv;\\n250→    const blocking = S.objects.some(o => !o.done && (o.type === 'rupture' || o.type === 'reed' || o.type === 'arteryTear'));\\n    if ((needIv || S.vitals < 42) && p.cool <= 0 && !blocking) {\\n      if (p.fill < 0.93) return go('syringe', 46, 188, 1, { why: 'iv' });\\n      return go('syringe', 46, 188, 0, { why: 'iv' });\\n    }\\n\\n    const list = goals(S).filter(o => usable(S, o));\\n    if (!list.length) return idle(p, { why: 'wait', fine: !!(S.strain && S.strain.jitter) });\\n    const o = list[Math.min(i, list.length - 1) % list.length];\\n    if (m.gid === o.id && Math.abs((o.prog || 0) - m.prog) < 0.01 && usable(S, o) && o.type !== 'reed' && o.type !== 'voice' && o.type !== 'lobe' && o.type !== 'eye') m.stuck += dt;\\n260→    else m.stuck = 0;\\n    m.gid = o.id; m.prog = o.prog || 0;\\n    if (m.stuck > 8) m.whyStuck = (S.phaseName || '') + ':' + o.type + ':' + (o.tag || '');\\n    const d = act(S, p, o, dt || 1 / 60, m);\\n    if (S.strain && S.strain.jitter) d.fine = true;\\n    return d;\\n  }\\n\\n  function play(S, maxT, dt) {\\n    dt = dt || 1 / 60;\\n270→    const t0 = S.t;\\n    let guard = 0;\\n    while (S.t - t0 < maxT && !S.won && !S.lost && guard < 200000) {\\n      const inputs = [];\\n      for (let i = 0; i < S.players.length; i++) {\\n        const dev = device(S, i, dt);\\n        const p = S.players[i];\\n        GAME.Wheel.update(p, dev, dt);\\n        if (dev.mouse) GAME.Cursor.update(p, { mouse: dev.mouse, fine: dev.fine }, S, dt);\\n        inputs.push({ tool: p.tool, trig: dev.trig, fine: !!dev.fine, gift: !!dev.gift, consult: !!dev.consult, cancel: false, mouse: true });\\n280→      }\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/bot/bot.js\",\"offset\":null,\"limit\":280,\"raw_output\":\"/* Perfect resident. Reads the live operation and aims the way a mouse would.\\n   The same function drives tests, attract mode, and couch colleagues. */\\n(() => {\\n  const G = typeof window !== 'undefined' ? window : globalThis;\\n  const GAME = (G.GAME ||= {});\\n  const DIGIT = { forceps: 1, scalpel: 2, suture: 3, salve: 4, syringe: 5, cautery: 6, suction: 7, sonar: 8 };\\n  const mems = new WeakMap();\\n\\n  function hyp(x, y) { return Math.hypot(x, y); }\\n  function mem(S) {\\n    let m = mems.get(S);\\n    if (!m) {\\n      m = { ang: 0, skip: 0, giftCd: 0, saw: 0, stuck: 0, gid: 0, prog: -1 };\\n      mems.set(S, m);\\n    }\\n    return m;\\n  }\\n  function go(tool, x, y, trig, extra) {\\n    extra = extra || {};\\n    return {\\n      digit: DIGIT[tool] || 1, mouse: [x, y], trig: trig ? 1 : 0,\\n      fine: !!extra.fine, gift: !!extra.gift, consult: !!extra.consult, cancel: false,\\n      aim: [0, 0], move: [0, 0], why: extra.why || tool,\\n    };\\n  }\\n  function idle(p, extra) {\\n    return go(p.tool || 'forceps', p.bx, p.by, 0, extra);\\n  }\\n  function ignored(o) {\\n    if (!o || o.done || !o.alive || o.optional) return true;\\n    if (o.type === 'nerve' || o.type === 'eloquent' || o.type === 'hold' || o.type === 'retractor') return true;\\n    if (o.type === 'bead' && o.tag !== 'dacapo-bead') return true;\\n    return false;\\n  }\\n  function toolFor(o) {\\n    if (o.hidden && !o.marked) return 'sonar';\\n    if (o.type === 'pool') return 'suction';\\n    if (o.type === 'laceration' || o.type === 'patch' || o.type === 'bite') return 'salve';\\n    if (o.type === 'wound' || o.type === 'arteryTear') return 'suture';\\n    if (o.type === 'clot') return o.dosed ? 'forceps' : 'syringe';\\n    if (o.type === 'reed' || o.type === 'voice') return 'syringe';\\n    if (o.type === 'lobe') return o.mode === 'scalpel' ? 'scalpel' : o.mode || 'cautery';\\n    if (o.type === 'mass' || o.type === 'nest') return o.cut ? 'forceps' : 'scalpel';\\n    if (o.type === 'bleeder' || o.type === 'polyp' || o.type === 'rupture' || o.type === 'bead' || o.type === 'uvula' || o.type === 'eye' || o.type === 'tremass' || o.type === 'barb') return 'cautery';\\n    if (o.type === 'slur' || o.type === 'tendril' || o.type === 'spiral' || o.type === 'wire' || o.type === 'repeat' || o.type === 'cut') return 'scalpel';\\n    if (o.guide && !o.cut) return 'scalpel';\\n    if (o.pairs) return 'suture';\\n    if (o.cells && (o.type === 'laceration' || o.type === 'patch' || o.type === 'bite' || o.mode === 'salve')) return 'salve';\\n    return 'forceps';\\n  }\\n  function usable(S, o) {\\n    if (o.hidden && !o.marked) return true;\\n    if (o.type === 'lobe' && !o.open) return false;\\n    if (o.type === 'eye' && !o.open) return false;\\n    if (o.type === 'repeat' && !o.open) return false;\\n    if (o.type === 'reed' || o.type === 'voice') return true;\\n    if (o.needsWindow && S.windowOpen <= 0) return false;\\n    if (o.needsBoard && S.device && !S.device.shown) return false;\\n    return true;\\n  }\\n  function goals(S) {\\n    const list = [];\\n    const seen = new Set();\\n    const push = o => { if (o && !seen.has(o.id) && !ignored(o)) { seen.add(o.id); list.push(o); } };\\n    const sign = S.objects.find(o => o.tag === 'repeat' && o.open && !o.done);\\n    if (sign) push(sign);\\n    for (const o of S.objects) {\\n      if (ignored(o)) continue;\\n      if (S.device && S.device.order && o.type === 'wire' && o.tag !== S.device.order[S.device.next || 0]) continue;\\n      if (o.under) {\\n        const pool = GAME.Sim.objById(S, o.under);\\n        if (pool && !pool.done && pool.vol > 1) { push(pool); continue; }\\n      }\\n      push(o);\\n    }\\n    list.sort((a, b) => (a.order - b.order) || (b.drain - a.drain) || (a.id - b.id));\\n    return list;\\n  }\\n  function pointAlong(pts, dist) {\\n    let left = dist;\\n    for (let i = 1; i < pts.length; i++) {\\n      const L = hyp(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]) || 1;\\n      if (left <= L) {\\n        const u = left / L;\\n        return [pts[i - 1][0] + (pts[i][0] - pts[i - 1][0]) * u, pts[i - 1][1] + (pts[i][1] - pts[i - 1][1]) * u];\\n      }\\n      left -= L;\\n    }\\n    return pts[pts.length - 1].slice();\\n  }\\n  function polyLen(pts) {\\n    let n = 0;\\n    for (let i = 1; i < pts.length; i++) n += hyp(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]);\\n    return n || 1;\\n  }\\n  function shock(S, p) {\\n    const peaks = [0.9, 1.8, 2.7, 3.6];\\n    const cb = S.codeBlue;\\n    const peak = peaks[cb.next] == null ? 99 : peaks[cb.next];\\n    const on = Math.abs(cb.t - peak) <= 0.045;\\n    return go('forceps', p.bx, p.by, on, { why: 'shock' });\\n  }\\n  function dressing(S, p) {\\n    const u = S.dressing.t % 1.2;\\n    return go('suture', p.bx, p.by, u < 0.045, { why: 'stamp' });\\n  }\\n  function act(S, p, o, dt, m) {\\n    const tool = toolFor(o);\\n    const fine = !!(S.strain && S.strain.jitter) || (o.tension && o.tension < 80) || tool === 'suture' || tool === 'scalpel';\\n    const near = (x, y, r) => hyp(p.bx - x, p.by - y) <= r;\\n\\n    if (tool === 'sonar') return go('sonar', o.x, o.y, 1, { fine, why: 'sonar' });\\n    if (tool === 'suction') return go('suction', o.x, o.y, 1, { why: 'suction' });\\n\\n    if (tool === 'salve') {\\n      const cell = (o.cells || []).find(c => !c[2]);\\n      const x = cell ? cell[0] : o.x, y = cell ? cell[1] : o.y;\\n      return go('salve', x, y, 1, { why: 'salve' });\\n    }\\n\\n    if (tool === 'syringe' && (o.type === 'reed' || o.type === 'voice')) {\\n      const beat = (S.strain && S.strain.beat) || 0;\\n      /* Charge in clear tissue. A closed reed splits if the needle lets go on it, and the neighbors sit inside that reach. */\\n      const park = [46, 188];\\n      if (!o.window) {\\n        if (p.fill >= 0.97) return go('syringe', park[0], park[1], 0, { fine: true, why: 'dump' });\\n        const charging = p.cool <= 0 && p.fill < 0.94 && beat >= 0.12 && beat < 0.68;\\n        return go('syringe', park[0], park[1], charging || (p.fill > 0.05 && p.fill < 0.94), { fine: true, why: 'prime' });\\n      }\\n      if (p.fill < 0.9) return go('syringe', o.x, o.y, 1, { fine: true, why: 'fill' });\\n      return go('syringe', o.x, o.y, 0, { fine: true, why: 'dose' });\\n    }\\n\\n    if (tool === 'syringe') {\\n      if (!near(o.x, o.y, 3)) return go('syringe', o.x, o.y, p.fill > 0.2 && p.fill < 0.96 ? 1 : 0, { fine, why: 'aimdose' });\\n      if (p.fill < 0.93 && p.cool <= 0) return go('syringe', o.x, o.y, 1, { fine, why: 'fill' });\\n      return go('syringe', o.x, o.y, 0, { fine, why: 'dose' });\\n    }\\n\\n    if (tool === 'cautery') {\\n      if (p.lock > 0 || p.heat > 0.78) return go('cautery', o.x, o.y, 0, { why: 'cool' });\\n      return go('cautery', o.x, o.y, 1, { why: 'burn' });\\n    }\\n\\n    if (tool === 'suture') {\\n      const pair = o.pairs[o.stitch || 0];\\n      if (!pair) return idle(p, { why: 'nopair' });\\n      const a = pair[0], b = pair[1];\\n      if (!(p.stroke && p.stroke.kind === 'suture' && p.stroke.id === o.id)) {\\n        return go('suture', a[0], a[1], near(a[0], a[1], 2), { fine: true, why: 'needle' });\\n      }\\n      if (near(b[0], b[1], 1.2)) return go('suture', b[0], b[1], 0, { fine: true, why: 'pop' });\\n      const dx = b[0] - p.bx, dy = b[1] - p.by, d = hyp(dx, dy) || 1;\\n      const step = Math.min(d, 90 * dt);\\n      return go('suture', p.bx + dx / d * step, p.by + dy / d * step, 1, { fine: true, why: 'cross' });\\n    }\\n\\n    if (tool === 'scalpel' && (o.slash || o.type === 'nest' || (o.type === 'lobe' && o.mode === 'scalpel')) && !o.guide) {\\n      if (!near(o.x - 8, o.y, 2)) return go('scalpel', o.x - 8, o.y, 0, { why: 'windup' });\\n      return go('scalpel', o.x + 8, o.y, 1, { why: 'slash' });\\n    }\\n    if (tool === 'scalpel' && o.type === 'lobe' && o.slash && !o.cut) {\\n      if (!near(o.x - 8, o.y, 2)) return go('scalpel', o.x - 8, o.y, 0, { why: 'windup' });\\n      return go('scalpel', o.x + 8, o.y, 1, { why: 'slash' });\\n    }\\n\\n    if (tool === 'scalpel' && o.guide) {\\n      const g = o.guide;\\n      const start = g[0];\\n      if (!(p.stroke && p.stroke.kind === 'scalpel' && p.stroke.id === o.id) || p.stroke.paused) {\\n        return go('scalpel', start[0], start[1], near(start[0], start[1], 2) ? 1 : 0, { fine, why: 'start' });\\n      }\\n      if (o.beatLock && S.flags.onBeat) return go('scalpel', p.bx, p.by, 1, { fine: true, why: 'waitbeat' });\\n      const far = p.stroke.far || 0;\\n      const pt = pointAlong(g, Math.min(polyLen(g), far + 160 * dt + 0.8));\\n      return go('scalpel', pt[0], pt[1], 1, { fine, why: 'trace' });\\n    }\\n\\n    if (o.type === 'screw') {\\n      if (p.held !== o.id) {\\n        const on = near(o.x + 12, o.y, 3);\\n        return go('forceps', o.x + 12, o.y, on && p.prevTrig <= 0.3, { why: 'screw' });\\n      }\\n      m.ang += 0.55;\\n      return go('forceps', o.x + Math.cos(m.ang) * 12, o.y + Math.sin(m.ang) * 12, 1, { why: 'turn' });\\n    }\\n\\n    if (tool === 'forceps') {\\n      if (p.held && p.held !== o.id) return go('forceps', p.bx, p.by, 0, { why: 'drop' });\\n      if (p.held !== o.id) {\\n        const on = near(o.x, o.y, 2.5);\\n        return go('forceps', o.x, o.y, on && p.prevTrig <= 0.3, { fine, why: 'grip' });\\n      }\\n      const limit = Math.min(78, (o.tension || 120) * 0.6);\\n      const ox = o.origin[0], oy = o.origin[1];\\n      const along = (p.bx - ox) * o.axis[0] + (p.by - oy) * o.axis[1];\\n      /* Stay on the trigger until the sim calls it free. Releasing at depth-epsilon drops a deep pull. */\\n      if (!o.free) {\\n        const n = Math.min((o.depth || 16) + 1.5, along + limit * dt);\\n        return go('forceps', ox + o.axis[0] * n, oy + o.axis[1] * n, 1, { fine: limit < 70, why: 'pull' });\\n      }\\n      const tx = ox + o.axis[0] * (Math.max(o.depth, 0) + 30);\\n      const ty = oy + o.axis[1] * (Math.max(o.depth, 0) + 30);\\n      const dx = tx - p.bx, dy = ty - p.by, d = hyp(dx, dy) || 1;\\n      if (hyp(p.bx - ox, p.by - oy) < 26) {\\n        const step = Math.min(d, limit * dt);\\n        return go('forceps', p.bx + dx / d * step, p.by + dy / d * step, 1, { fine: true, why: 'carry' });\\n      }\\n      return go('forceps', p.bx, p.by, 0, { why: 'dish' });\\n    }\\n    return go(tool, o.x, o.y, 1, { why: 'generic' });\\n  }\\n\\n  function device(S, i, dt) {\\n    const p = S.players[i] || S.players[0];\\n    const m = mem(S);\\n    if (m.giftCd > 0) m.giftCd -= dt;\\n    if (m.consultCd > 0) m.consultCd -= dt;\\n    if (!p || p.gone) return idle(S.players[0] || { bx: 213, by: 150, tool: 'forceps' });\\n    if (S.won || S.lost) return idle(p);\\n    if (S.codeBlue) return shock(S, p);\\n    if (S.dressing) return dressing(S, p);\\n\\n    const n = S.players.filter(q => !q.gone).length;\\n    if (n > 1 && i === 0 && S.objects.some(o => o.needsWindow && !o.done && o.alive)) {\\n      const h = S.objects.find(o => o.type === 'retractor' && !o.done);\\n      if (h) return go('forceps', h.x, h.y, 1, { why: 'hold' });\\n    }\\n\\n    let gift = false, consult = false;\\n    const breathOk = S.gift === 'breath' || S.activeDoc === 'vale' || (S.gift === 'both' && S.activeDoc !== 'sokolova');\\n    const lookOk = S.gift === 'look' || S.activeDoc === 'sokolova' || S.gift === 'both';\\n    if (!S.breath && m.giftCd <= 0 && S.steady >= 35 && breathOk && (S.flags.needBreath || (S.strain && S.strain.jitter && S.strain.kind === 'tremolo'))) {\\n      gift = true; m.giftCd = 0.5;\\n    }\\n    if (!gift && !S.breath && m.giftCd <= 0 && S.steady >= 45 && lookOk && S.flags.needLook && S.mode !== 'rounds' && (S.slips || 0) > (m.seenSlips || 0)) {\\n      gift = true; m.giftCd = 1.2; m.seenSlips = S.slips;\\n    }\\n    const wantDoc = S.flags.needLook ? 'sokolova' : (S.flags.needBreath ? 'vale' : null);\\n    if (S.consult && wantDoc && S.activeDoc !== wantDoc && (m.consultCd || 0) <= 0) {\\n      consult = true; m.consultCd = 0.45;\\n    }\\n    if (gift || consult) return go(p.tool || 'forceps', p.bx, p.by, 0, { gift, consult, why: 'gift' });\\n\\n    if (S.device && !S.device.shown && S.objects.some(o => o.needsBoard && !o.done)) {\\n      return go('sonar', S.device.x || 213, S.device.y || 100, 1, { why: 'board' });\\n    }\\n\\n    const needIv = S.flags.needIv && (S.flags.iv || 0) < S.flags.needIv;\\n    const blocking = S.objects.some(o => !o.done && (o.type === 'rupture' || o.type === 'reed' || o.type === 'arteryTear'));\\n    if ((needIv || S.vitals < 42) && p.cool <= 0 && !blocking) {\\n      if (p.fill < 0.93) return go('syringe', 46, 188, 1, { why: 'iv' });\\n      return go('syringe', 46, 188, 0, { why: 'iv' });\\n    }\\n\\n    const list = goals(S).filter(o => usable(S, o));\\n    if (!list.length) return idle(p, { why: 'wait', fine: !!(S.strain && S.strain.jitter) });\\n    const o = list[Math.min(i, list.length - 1) % list.length];\\n    if (m.gid === o.id && Math.abs((o.prog || 0) - m.prog) < 0.01 && usable(S, o) && o.type !== 'reed' && o.type !== 'voice' && o.type !== 'lobe' && o.type !== 'eye') m.stuck += dt;\\n    else m.stuck = 0;\\n    m.gid = o.id; m.prog = o.prog || 0;\\n    if (m.stuck > 8) m.whyStuck = (S.phaseName || '') + ':' + o.type + ':' + (o.tag || '');\\n    const d = act(S, p, o, dt || 1 / 60, m);\\n    if (S.strain && S.strain.jitter) d.fine = true;\\n    return d;\\n  }\\n\\n  function play(S, maxT, dt) {\\n    dt = dt || 1 / 60;\\n    const t0 = S.t;\\n    let guard = 0;\\n    while (S.t - t0 < maxT && !S.won && !S.lost && guard < 200000) {\\n      const inputs = [];\\n      for (let i = 0; i < S.players.length; i++) {\\n        const dev = device(S, i, dt);\\n        const p = S.players[i];\\n        GAME.Wheel.update(p, dev, dt);\\n        if (dev.mouse) GAME.Cursor.update(p, { mouse: dev.mouse, fine: dev.fine }, S, dt);\\n        inputs.push({ tool: p.tool, trig: dev.trig, fine: !!dev.fine, gift: !!dev.gift, consult: !!dev.consult, cancel: false, mouse: true });\\n      }\\n\",\"total_lines\":289}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"64583400-fa1f-47c0-8a43-49ae7929cf97"}
{"type":"assistant","message":{"id":"msg_399","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"A potentially serious bug was found in the chained New Game playthrough involving `game.debug`.\n\n`skipStory = true` may bypass story scenes entirely. The chained New Game playthrough might not actually reach the ending or credits. This would fail Criterion 3.\n\nThe skipStory concern may be a false alarm. The feature could exist even if the test does not verify it.\n\nA more serious gameplay defect was found in the Cantor rewind mechanic. Forced rewinds incorrectly preserve strain state in snapshots.\n\nThe rewind bug specifically corrupts the strain's `signs` counter, `move`, and `cycleT`. If the player slashes a repeat sign during wind-up, the counter increments but forceRewind may not trigger because the sign is already done. Otherwise the ring restores the field from 6 seconds ago, including that corrupted strain state. The 6-second snapshot sits within the 3-second wind-up window, so the signs count would revert while objects are properly undone.\n\nThe rewind timeline is being traced. During the 3-second wind-up, cycleT stays at zero while winding decreases. Snapshots taken during this window capture cycleT=0 and winding=3. When forceRewind restores the field, it applies that old state. The next frame then sets winding to zero on the restored object rather than the current one.\n\nThe forced rewind snapshot is taken before the 3-second wind-up begins. It restores the strain to roughly 17 seconds into its cycle with zero winding. Three seconds later the field winds up again from that restored state. This is correct behavior for a 6-second rewind. The 20-second interval between forced rewinds corresponds to 20 real seconds of world time.\n\nThe ring snapshot is pushed after stepStrain in the step() loop. The signs counter increments and the sign is tagged repeat-spent on the current strain before any snapshot occurs. This means the corrupted state is not captured in the rewind buffer.\n\nThe signs counter is preserved across the forced rewind. The snapshot is taken after the counter increments, so the restored state retains the updated value.\n\nThe captured test log shows 142 checks with zero failures and a clean exit code. This suggests the bot successfully clears case 11 at rank S. A full browser run would be expensive, so a quick simulation-only spot-check using --fast is being considered to verify the result without repeating the costly test.\n\nRe-running the full suite would take several minutes, so that is being skipped in favor of direct code inspection. The focus is now on two new potential issues: whether skipStory actually bypasses required story scenes during the chained playthrough, and whether dev mode sliders for patient, hands, strains, gift, and fluids are properly wired or only patient.drain is functional.\n\nThe verification plan only covers dev-slider live changes and resets. It does not explicitly test whether cheats or jumps to any case or phase work, so Criterion 4 may be unverified.\n\nA new potential bug was spotted in the attract mode: any input might return to the title while also firing the control under the pointer.\n\nThe attract mode test only verifies exits to the title. It does not check that input avoids firing controls under the pointer, so the behavior may be correct.\n\nLoose stitch is implemented but untested.\n\nGhost data filling is also unverified by tests. The code populates ghosts from ring snapshots after a secondLook hold, yet no assertion checks ghosts.length.\n\nThe `wheelIndex` function is being checked for a real bug in the eight wheel directions. The north direction maps to index 0, but the northeast direction calculation is incomplete.\n\nThe northeast wheel direction maps to index 1, confirming the scalpel tool. The remaining seven directions are being checked against their expected tools.\n\nThe eight wheel directions are fully verified. The northwest direction maps to index 7, which corresponds to sonar, matching the test expectation.\n\nA potential magnet bug was spotted: the pull effect only triggers when magnetization is below 0.12, while speed drops apply whenever a target exists and magnetization is below 0.95.\n\nThe magnet pull radius is 22 units. The validTarget check is being reviewed.\n\nGuide-follow is implemented but untested. The code looks correct.\n\nCode Blue miss path is implemented. Tests only cover success.\n\nThe intern clock logic may be inverted. The plan says clock x1.3. The implementation divides drain by 1.3. This gives 30% more time.\n\nThe intern clock multiplier is being reinterpreted. \"Clock x1.3\" likely means the starting clock value is multiplied by 1.3, not that drain rate is divided by 1.3. This would make the two effects parallel multipliers on starting values rather than inverse operations.\n\nThe intern clock deviation is documented in the goal plan. Criterion 2 cites §5.2 and §7, which do not specify difficulty multipliers. The ambiguity of \"clock x1.3\" is resolved by the deviation record.\n\nThe intern clock multiplier is not a clear defect because the test locks in that interpretation.\n\nCase 10 may be gamed by inflating par to guarantee an S rank. Criterion 3 only requires finishing with time and vitals remaining, not a specific rank. The plan permits tuning numbers when a case misses.\n\nskipStory is the larger concern for chained playthrough honesty. The Hub session client HTML must be verified to inline session.js first and remain unmodified. Launch screenshots show empty text in launch.log, suggesting the canvas title was not OCR'd.\n\nThe HTML bundle is being checked for forbidden source names and close variants. The title \"Open Table Second Opinion\" contains the phrase \"Second Opinion,\" which the plan permits as a title riff and as the About screen source line. Criterion 3 allows these exceptions while prohibiting other forbidden names in play or text.\n\nCONTENT.md exists as a content note. The About page order matches TASK.md.\n\nThe syringe charging logic is confirmed correct: fill does not clear when the trigger is released.\n\nA cautery bare-tissue test case was traced: holding at (40,40) for 2.2 seconds should lock at 1 second and char slip at 0.6 seconds.\n\nThe cautery bare-tissue lock is not a bug; the slip check is tautological but the lock still fires. Mass rings survive cuts so forceps can lift them. Staccato beads are skipped during phaseClear, yet dacapo beads remain valid because strain.done must be true. The legato bot uses forceps for shards, hides its head until surfaced, and uses scalpel for slurs.\n\nThe legato bot pulls the head shard tagged legato-head and snaps it if pulled too fast. It limits speed to 60% of tension. Tests passed so this likely works.\n\nA potential bug was spotted in readInputs. Cursor.update receives mouse input but the x and y coordinates are not passed through.\n\nThe suspected readInputs bug is not a real issue. Cursor.update already sets the player position before step, and readInputs only overwrites coordinates when x is provided. The position persists correctly.\n\nThe mouse cursor path intentionally skips guide-follow and magnet logic, since the plan restricts those effects to pad input only. The bot uses mouse control, so it never exercises that code. This leaves a gap between the implemented pad-only behavior and the verification plan's missing assertions for those features.\n\nThe verification plan explicitly requires assertions for pad-only features like guide-follow and magnet. Their absence is a missing required test, which is grounds to refute. This creates tension with the rule that only dishonest tests can be refuted.\n\nThe missing pad-only cursor assertions are part of the verification plan's required observation procedure, not new requirements. Criterion 2 itself does not mention cursor magnet or guide-follow. The risks list only flags \"never cut\" features, so a missing test for these pad-only behaviors does not constitute a refutable defect.\n\nThe cursor code is confirmed to implement magnet and guide-follow. The missing test for these pad-only behaviors is a gray area, but it does not constitute a refutable defect because the code itself works. The focus is shifting to finding actual bugs.\n\nCode Blue freeze and dressing timer logic are confirmed correct. Tutorial freeze behavior is also sound. The skills lab freeze path is now under scrutiny: hold is set true, yet phaseClear may still advance the phase while the freeze is active.","signature":""},{"type":"tool_use","id":"call-8ecab167-ade2-4123-be1c-62409d084904-35","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/scenes/shell.js","offset":320,"limit":450}},{"type":"tool_use","id":"call-8ecab167-ade2-4123-be1c-62409d084904-36","name":"grep","input":{"pattern":"skipStory|attract|openDev|cheat|jump","path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src","glob":"*.js"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":11088,"output_tokens":4600,"cache_read_input_tokens":99840,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"9f4fd88b-e6da-4f92-98a5-1befa8600569"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-8ecab167-ade2-4123-be1c-62409d084904-35","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"320→      move[1] += pan[1] / Math.max(8, Math.hypot(pan[0], pan[1]));\\n    }\\n    return {\\n      digit, mouse, aim, move, keys, nudge,\\n      fine: I.down('fine'),\\n      trig,\\n      gift: I.down('gift'),\\n      consult: I.down('consult'),\\n      cancel: I.down('cancel'),\\n    };\\n330→  }\\n\\n  function drive(S, dt, opts) {\\n    opts = opts || {};\\n    const inputs = [];\\n    const n = S.players.length;\\n    for (let i = 0; i < n; i++) {\\n      const p = S.players[i];\\n      if (p.gone) { inputs.push({ tool: p.tool, trig: 0 }); continue; }\\n      let dev;\\n340→      if (opts.remote && opts.remote[i]) {\\n        dev = opts.remote[i];\\n      } else if (i === 0 && game.debug && game.debug.driver && !RT.attract) {\\n        dev = game.debug.driver(S, dt) || GAME.Bot.device(S, 0, dt);\\n      } else if (i === 0 && RT.auto && !RT.attract) {\\n        dev = GAME.Bot.device(S, 0, dt);\\n      } else if (i === 0 && !opts.bots && !RT.attract) {\\n        dev = readLocal(p);\\n      } else {\\n        dev = GAME.Bot.device(S, i, dt);\\n350→      }\\n      GAME.Wheel.update(p, dev, dt);\\n      const tune = playTune();\\n      if (dev.mouse) GAME.Cursor.update(p, { mouse: dev.mouse, fine: dev.fine }, S, dt, tune);\\n      else GAME.Cursor.update(p, { aim: dev.aim, keys: dev.keys, nudge: dev.nudge, fine: dev.fine }, S, dt, tune);\\n      const row = {\\n        tool: p.tool,\\n        trig: dev.trig || 0,\\n        fine: !!dev.fine,\\n        gift: !!dev.gift,\\n360→        consult: !!dev.consult,\\n        cancel: !!dev.cancel,\\n        mouse: !!dev.mouse,\\n      };\\n      if (dev.x != null) { row.x = dev.x; row.y = dev.y; }\\n      inputs.push(row);\\n    }\\n    try { GAME.Op.step(S, inputs, dt, playTune()); }\\n    catch (e) { game.fail('op', e); }\\n    if (S.ev) for (const ev of S.ev) { try { GAME.Audio.onEv(ev); } catch (err) { /* quiet */ } }\\n370→    return S;\\n  }\\n\\n  function fieldOf(S) {\\n    const key = (S.site || 'abdomen') + ':' + (S.seed || 1) + ':' + game.W + 'x' + game.H;\\n    if (RT.fieldKey !== key) {\\n      RT.field = GAME.Art.fieldFor(S.site || 'abdomen', S.seed || 1, game.W, game.H);\\n      RT.fieldKey = key;\\n    }\\n    return RT.field;\\n380→  }\\n\\n  const COL = {\\n    shard: '#d5dee6', laceration: '#e05050', wound: '#c43030', bleeder: '#ff4040', arteryTear: '#ff2060',\\n    pool: '#601828', polyp: '#e08898', mass: '#c06078', clot: '#682838', patch: '#e07070',\\n    nerve: '#e2c14a', eloquent: '#f0d060', retractor: '#c8d0d4', bead: '#5ff0e0', nest: '#14383c',\\n    lobe: '#7a5cff', eye: '#d0c8ff', tendril: '#3ec8b0', uvula: '#9a78ff', voice: '#5ff0e0', reed: '#8fd0c8',\\n    repeat: '#f5b700', slur: '#9ad8d0', hook: '#d0d4d8', screw: '#e8e0c8', wire: '#f0d060', lead: '#88e0c8',\\n    cut: '#f2f0e6', fed: '#401018', bite: '#e05050',\\n  };\\n390→  function bloodCol() {\\n    if (PREFS.blood === 'rose') return '#e07098';\\n    if (PREFS.blood === 'ink') return '#2a2030';\\n    return null;\\n  }\\n\\n  function drawOp(r, S, ribbon) {\\n    const [ox, oy] = origin();\\n    r.sky(['#071018', '#102028']);\\n    const F = S ? fieldOf(S) : null;\\n400→    const allow = (typeof document !== 'undefined') || GAME.Art.force;\\n    if (allow && F) {\\n      try { F.shade({ beat: ((S.t || 0) % 1), slow: !!S.breath, dim: S.dim || 0 }); }\\n      catch (e) { /* painter */ }\\n    }\\n    r.overlay(g => {\\n      const px = E.px;\\n      if (F && F.cv && F.cv.width) { try { g.drawImage(F.cv, 0, 0); } catch (e) { /* no image */ } }\\n      px.rect(g, 0, 0, r.W, Math.max(0, oy), '#102830');\\n      px.rect(g, 0, oy + CFG.FIELD_H, r.W, Math.max(0, r.H - oy - CFG.FIELD_H), '#102830');\\n410→      px.rect(g, 0, oy, Math.max(0, ox), CFG.FIELD_H, '#102830');\\n      px.rect(g, ox + CFG.FIELD_W, oy, Math.max(0, r.W - ox - CFG.FIELD_W), CFG.FIELD_H, '#102830');\\n      px.rect(g, ox + 8, oy + 8, CFG.FIELD_W - 16, CFG.FIELD_H - 16, '#0c2428');\\n      if (!S) return;\\n      const ink = bloodCol();\\n      for (const o of S.objects) {\\n        if (!o.alive && o.type !== 'retractor') continue;\\n        if (o.hidden && !o.marked) continue;\\n        const x = o.x + ox, y = o.y + oy;\\n        let c = COL[o.type] || '#9ad0c8';\\n420→        if (ink && (o.type === 'bleeder' || o.type === 'pool' || o.type === 'wound' || o.type === 'laceration' || o.type === 'arteryTear')) c = ink;\\n        const rad = o.type === 'pool' ? 8 + (o.vol || 0) * 0.15 : o.type === 'mass' ? (o.rad || 12) : o.type === 'bead' ? 3 : 4;\\n        if (o.guide && o.guide.length > 1 && (o.type === 'cut' || o.type === 'mass' || o.type === 'slur')) {\\n          for (let k = 1; k < o.guide.length; k++) px.line(g, o.guide[k - 1][0] + ox, o.guide[k - 1][1] + oy, o.guide[k][0] + ox, o.guide[k][1] + oy, '#f2f0e6', 1);\\n        }\\n        px.disc(g, x, y, rad, o.done ? '#2a403c' : c);\\n        if (o.marked) px.disc(g, x, y, rad + 3, '#5ff0e0');\\n      }\\n      if (S.breath) {\\n        px.rect(g, ox + 20, oy + 16, CFG.FIELD_W - 40, 2, '#bfefff');\\n430→        px.rect(g, ox + 20, oy + CFG.FIELD_H - 18, CFG.FIELD_W - 40, 2, '#bfefff');\\n      }\\n      if (RT.wheelShow > 0 && S.players[0] && !S.players[0].gone) {\\n        const c = S.players[0];\\n        for (const w of CFG.WHEEL) {\\n          const x = c.x + ox + w.x * 22, y = c.y + oy + w.y * 22;\\n          const on = c.tool === w.tool;\\n          px.disc(g, x, y, on ? 8 : 5, on ? '#5ff0e0' : '#14343c');\\n          GAME.Art.toolIcon(g, w.tool, x - 4, y - 4, 1);\\n        }\\n440→      }\\n      for (const p of S.players) if (!p.gone) GAME.Art.drawHand(g, p, ox, oy);\\n      const vit = Math.max(0, Math.ceil(S.vitals));\\n      const clk = Math.max(0, Math.ceil(S.clock));\\n      E.font.text(g, 'VIT ' + vit, 8, 6, vit < 30 ? '#ff7a6a' : '#e8fbf6', { scale: 2, outline: '#06141a' });\\n      E.font.text(g, 'CLK ' + clk, 8, 26, clk < 20 ? '#ff7a6a' : '#e8fbf6', { scale: 2, outline: '#06141a' });\\n      E.font.text(g, (S.phaseName || '') + '  ' + (S.activeDoc || ''), 8, 48, '#8fb8b0', { outline: '#06141a' });\\n      const tool = (S.players[0] && S.players[0].tool) || 'forceps';\\n      GAME.Art.toolIcon(g, tool, r.W - 28, r.H - 28, 1);\\n      E.font.text(g, tool.toUpperCase(), r.W - 8, r.H - 36, '#e8fbf6', { align: 'right', outline: '#06141a' });\\n450→      if (PREFS.hints) E.font.text(g, game.input.label('useTool'), r.W - 8, r.H - 14, '#5ff0e0', { align: 'right', outline: false });\\n      const steady = Math.round(S.steady || 0);\\n      E.font.text(g, 'STEADY ' + steady, 8, r.H - 16, '#5ff0e0', { outline: '#06141a' });\\n      if (S.codeBlue) E.font.text(g, 'SHOCK', r.W / 2, 64, '#ff7a6a', { align: 'center', scale: 2, outline: '#06141a' });\\n      if (S.dressing) E.font.text(g, 'DRESSING', r.W / 2, 64, '#f2f0e6', { align: 'center', scale: 2, outline: '#06141a' });\\n      if (ribbon) E.font.text(g, 'DEMO', r.W - 8, 6, '#f5b700', { align: 'right', scale: 2, outline: '#06141a' });\\n      if (GAME.TUNE.dirty || RT.cheatUsed) E.font.text(g, 'DEV', 8, 66, '#f5b700', { outline: '#06141a' });\\n      if (S.t != null && GAME.BARKS && GAME.BARKS.length) {\\n        const bark = GAME.BARKS[Math.floor(S.t / 4) % GAME.BARKS.length];\\n        E.font.text(g, bark, r.W / 2, r.H - 28, '#d8e4dc', { align: 'center', outline: '#06141a' });\\n460→      }\\n      if (RT.devOpen) drawDev(g, r);\\n    });\\n  }\\n\\n  const CHEATS = [\\n    ['reveal', 'Reveal'],\\n    ['infSteady', 'Infinite Steady'],\\n    ['lockVitals', 'Lock vitals'],\\n    ['freezeClock', 'Freeze clock'],\\n470→    ['oneHit', 'One hit'],\\n    ['auto', 'Autosurgeon'],\\n    ['slow', 'Slow motion'],\\n    ['win', 'Clear phase'],\\n    ['lose', 'Force a loss'],\\n    ['code', 'Vitals to zero'],\\n  ];\\n  const SLOW = [0.25, 0.5, 1, 2];\\n\\n  function devRows() {\\n480→    if (RT.devTab === 1) return CHEATS.map(c => c[1]);\\n    if (RT.devTab === 2) {\\n      const rows = [];\\n      for (const id of GAME.ORDER) {\\n        const def = GAME.CASES[id];\\n        const n = (def.phases || []).length;\\n        for (let p = 0; p < n; p++) rows.push(id + ' ' + (def.phases[p].name || p));\\n      }\\n      rows.push('Grand Rounds');\\n      rows.push('Skills Lab');\\n490→      return rows;\\n    }\\n    return GAME.Dev.KEYS.map(k => k[0]).concat(['Reset tuning']);\\n  }\\n\\n  function devAct(dir) {\\n    const S = RT.S;\\n    if (RT.devTab === 0) {\\n      const keys = GAME.Dev.KEYS;\\n      if (RT.devI >= keys.length) { if (dir === 0) GAME.Dev.reset(); return; }\\n500→      if (!dir) return;\\n      const [path, lo, hi] = keys[RT.devI];\\n      const [g, k] = path.split('.');\\n      const step = (hi - lo) / 20;\\n      const cur = GAME.TUNE[g][k];\\n      const v = Math.max(lo, Math.min(hi, Math.round((cur + dir * step) * 1000) / 1000));\\n      GAME.Dev.set(path, v);\\n      return;\\n    }\\n    RT.cheatUsed = true;\\n510→    if (dir !== 0 && RT.devTab !== 1) return;\\n    if (RT.devTab === 1 && dir === 0) {\\n      const key = CHEATS[RT.devI][0];\\n      if (key === 'auto') { RT.auto = !RT.auto; RT.cheatUsed = true; return; }\\n      if (key === 'slow') {\\n        const i = SLOW.indexOf(game.timeScale);\\n        game.timeScale = SLOW[(i + 1) % SLOW.length] || 1;\\n        RT.cheatUsed = true;\\n        return;\\n      }\\n520→      if (key === 'win' && S) {\\n        RT.cheatUsed = true;\\n        for (const o of S.objects) { o.done = true; o.prog = 1; }\\n        S.hold = false;\\n        return;\\n      }\\n      if (key === 'lose' && S) { RT.cheatUsed = true; GAME.Sim.lose(S, 'dev'); return; }\\n      if (key === 'code' && S) { RT.cheatUsed = true; S.vitals = 0; return; }\\n      if (S) {\\n        S.cheat = S.cheat || {};\\n530→        const on = !S.cheat[key];\\n        GAME.Dev.cheat(S, key, on);\\n        RT.cheatUsed = true;\\n      }\\n      return;\\n    }\\n    if (RT.devTab === 2 && dir === 0) {\\n      const rows = devRows();\\n      const label = rows[RT.devI] || '';\\n      RT.cheatUsed = true;\\n540→      if (label === 'Grand Rounds') { beginCase('ferry', { players: 1, fromStory: false }); go('op'); return; }\\n      if (label === 'Skills Lab') { beginCase('lab', { fromStory: false }); go('op'); return; }\\n      const sp = label.indexOf(' ');\\n      const id = sp < 0 ? label : label.slice(0, sp);\\n      const def = GAME.CASES[id];\\n      if (!def) return;\\n      const name = sp < 0 ? '' : label.slice(sp + 1);\\n      let phase = 0;\\n      (def.phases || []).forEach((ph, i) => { if ((ph.name || String(i)) === name) phase = i; });\\n      beginCase(id, { phase, fromStory: false });\\n550→      go('op');\\n    }\\n  }\\n\\n  function handleDev() {\\n    if (!RT.devOpen || inSession) return false;\\n    const I = game.input;\\n    const rows = devRows();\\n    if (I.pressed('cancel')) { RT.devOpen = false; I.consumeAll(); return true; }\\n    if (I.pressed('toolPrev')) RT.devTab = (RT.devTab + 2) % 3;\\n560→    if (I.pressed('toolNext')) RT.devTab = (RT.devTab + 1) % 3;\\n    if (I.pressed('up')) RT.devI = (RT.devI + rows.length - 1) % rows.length;\\n    if (I.pressed('down')) RT.devI = (RT.devI + 1) % rows.length;\\n    if (RT.devI >= rows.length) RT.devI = 0;\\n    if (I.pressed('left')) devAct(-1);\\n    if (I.pressed('right') || I.pressed('confirm')) devAct(I.pressed('confirm') ? 0 : 1);\\n    return true;\\n  }\\n\\n  function drawDev(g, r) {\\n570→    const px = E.px;\\n    const rows = devRows();\\n    const tabs = ['Tune', 'Cheats', 'Jump'];\\n    px.rect(g, r.W - 168, 8, 160, r.H - 16, '#06141a');\\n    E.font.text(g, tabs[RT.devTab], r.W - 160, 12, '#f5b700', { outline: false });\\n    const first = Math.max(0, Math.min(RT.devI - 6, rows.length - 12));\\n    for (let i = 0; i < 12 && first + i < rows.length; i++) {\\n      const k = first + i;\\n      const on = k === RT.devI;\\n      E.font.text(g, (on ? '> ' : '  ') + rows[k], r.W - 160, 28 + i * 12, on ? '#5ff0e0' : '#8fb8b0', { outline: false });\\n580→    }\\n  }\\n\\n  function drawTitle(r, t) {\\n    r.sky(['#071018', '#0e2430']);\\n    r.overlay(g => {\\n      GAME.Art.titleBackdrop(g, r.W, r.H, t || game.real || 0);\\n      E.font.title(g, 'OPEN TABLE', r.W / 2, 28, { scale: 2, align: 'center', colors: ['#f4fff8', '#9aefe4', '#1c6e78'] });\\n      E.font.text(g, TITLE, r.W / 2, 78, '#e8fbf6', { align: 'center', scale: 1, outline: '#06141a' });\\n      E.font.text(g, \\\"Don't let it go quiet\\\", r.W / 2, 96, '#5ff0e0', { align: 'center', outline: false });\\n590→      const y = 120;\\n      let x = 24;\\n      const beat = [0, 2, 0, 6, 0, 2, 8, 0, 1, 0, 4, 0];\\n      for (let i = 0; i < beat.length; i++) {\\n        const h = 2 + beat[i];\\n        E.px.rect(g, x, y - h, 6, h, '#7CFFB2');\\n        x += 10;\\n      }\\n      const prompt = game.input.label('confirm');\\n      E.font.text(g, prompt, r.W / 2, r.H - 28, '#e8fbf6', { align: 'center', scale: 2, outline: '#06141a' });\\n600→    });\\n  }\\n\\n  function snapshot() {\\n    const S = RT.S;\\n    const [ox, oy] = origin();\\n    let mark = null;\\n    if (RT.light && RT.light.mark) mark = [ox + RT.light.mark[0], oy + RT.light.mark[1]];\\n    const choice = !!(story.talk && story.talk.open && story.talk.choices && story.talk.choices.length && !story.talk.typing);\\n    return {\\n610→      scene: game.sceneName,\\n      menu: RT.menu ? { i: RT.menu.i, labels: RT.menu.items.map(it => (typeof it === 'string' ? it : it.label)) } : null,\\n      story: story.running ? story.node : null,\\n      held: !!story._held,\\n      choice,\\n      op: S ? {\\n        id: S.id, won: !!S.won, lost: !!S.lost, phase: S.phase, phaseName: S.phaseName,\\n        clock: S.clock, vitals: S.vitals, score: S.score, rank: S.rank,\\n        breath: !!S.breath, worldScale: S.worldScale, closed: !!S.closed,\\n      } : null,\\n620→      lightbox: mark,\\n      ward: { patients: RT.visitors.slice(), nearDoor: !!RT.nearDoor },\\n      attract: RT.attract ? { on: true, loops: RT.loops, seg: RT.seg } : null,\\n      dev: { open: !!RT.devOpen, dirty: !!GAME.TUNE.dirty },\\n      ranks: Object.assign({}, RT.ranks),\\n      cleared: Object.assign({}, RT.cleared),\\n      reel: RT.loops,\\n    };\\n  }\\n\\n630→  const REEL = [\\n    { kind: 'story', t: 4 },\\n    { kind: 'op', id: 'c1', t: 15, cheat: { lockVitals: true, freezeClock: true, oneHit: true } },\\n    { kind: 'op', id: 'c3', t: 8, cheat: { lockVitals: true, freezeClock: true, oneHit: true } },\\n    { kind: 'op', id: 'c6', t: 8, cheat: { lockVitals: true, freezeClock: true, oneHit: true } },\\n    { kind: 'op', id: 'c7', t: 8, cheat: { lockVitals: true, freezeClock: true, infSteady: true } },\\n    { kind: 'rounds', t: 8 },\\n    { kind: 'op', id: 'c11', t: 8, cheat: { lockVitals: true, freezeClock: true, oneHit: true } },\\n    { kind: 'card', t: 4 },\\n    { kind: 'title', t: 8 },\\n640→  ];\\n\\n  function startSegment() {\\n    const seg = REEL[RT.seg];\\n    RT.segT = 0;\\n    if (seg.kind === 'op') {\\n      const S = beginCase(seg.id, { fromStory: false, cheat: seg.cheat, seed: 3 });\\n      if (S) S.mode = 'attract';\\n      game.setView('overhead');\\n    } else if (seg.kind === 'rounds') {\\n650→      const S = beginCase('ferry', { players: 4, fromStory: false, cheat: { lockVitals: true, freezeClock: true, oneHit: true } });\\n      if (S) S.mode = 'attract';\\n      game.setView('overhead');\\n    } else if (seg.kind === 'story') {\\n      game.setView('side');\\n      if (!RT.reelStory) {\\n        RT.reelStory = new E.Story(game, {\\n          people,\\n          nodes: { beat: [GAME.NODES.start[0]] },\\n          on: {},\\n660→        });\\n      }\\n      RT.reelStory.skip = true;\\n      RT.reelStory.run('beat');\\n    } else game.setView('side');\\n  }\\n\\n  const H = {\\n    info: null,\\n    phase: 'solo',\\n670→    over: false,\\n    accS: 0,\\n    accI: 0,\\n    snapN: 0,\\n    inN: 0,\\n    heard: 0,\\n    hands: {},\\n    view: null,\\n    card: null,\\n    local: -1,\\n680→  };\\n\\n  function hubFinish() {\\n    if (H.over || !H.info || !H.info.isHost) return;\\n    H.over = true;\\n    const info = H.info;\\n    const S = RT.S;\\n    const scoreOf = (id) => {\\n      const idx = info.players.findIndex(q => q.id === id);\\n      const p = S && S.players[idx];\\n690→      return p ? (p.actions | 0) : 0;\\n    };\\n    const ids = info.players.map(q => q.id);\\n    ids.sort((a, b) => scoreOf(b) - scoreOf(a));\\n    const standings = [];\\n    for (const id of ids) {\\n      const last = standings[standings.length - 1];\\n      if (last && scoreOf(last[0]) === scoreOf(id)) last.push(id);\\n      else standings.push([id]);\\n    }\\n700→    const scores = {};\\n    for (const id of ids) scores[id] = scoreOf(id);\\n    const best = ids[0];\\n    const detail = (scores[best] || 0) + ' clean actions';\\n    const awards = best == null ? [] : [{ id: best, title: 'Steadiest Hand', detail: detail.slice(0, 40) }];\\n    try { HUB.send({ t: 'over', n: ++H.snapN }); } catch (e) { /* late */ }\\n    HUB.finish({\\n      standings,\\n      scores,\\n      won: !!(S && S.closed),\\n710→      awards,\\n      stats: { clock: S ? Math.round(S.clock) : 0, vitals: S ? Math.round(S.vitals) : 0 },\\n    });\\n  }\\n\\n  const TYPE_N = {};\\n  ['shard', 'laceration', 'wound', 'bleeder', 'arteryTear', 'pool', 'polyp', 'mass', 'clot', 'bead', 'nest', 'lobe', 'eye', 'tendril', 'voice', 'repeat', 'retractor'].forEach((t, i) => { TYPE_N[t] = i + 1; });\\n\\n  function sendSnap() {\\n    const S = RT.S;\\n720→    const info = H.info;\\n    if (!S || !info) return;\\n    const objs = [];\\n    for (const o of S.objects) {\\n      if (objs.length >= 28) break;\\n      if (o.done && o.type !== 'retractor') continue;\\n      let flags = (o.done ? 1 : 0) | (o.hidden ? 2 : 0) | (o.marked ? 4 : 0) | (o.alive ? 8 : 0);\\n      objs.push([o.id, o.x | 0, o.y | 0, TYPE_N[o.type] || 0, flags]);\\n    }\\n    const ps = info.players.map((q, i) => {\\n730→      const p = S.players[i];\\n      if (!p) return [q.id, 0, 0, 0, 0, 0, 1];\\n      const tool = Math.max(0, CFG.TOOLS.indexOf(p.tool));\\n      return [q.id, p.x | 0, p.y | 0, tool, p.trig > 0.3 ? 1 : 0, p.actions | 0, p.gone ? 1 : 0];\\n    });\\n    HUB.send({\\n      t: 's', n: ++H.snapN,\\n      clock: S.clock | 0, vitals: S.vitals | 0, phase: S.phase | 0,\\n      won: S.won ? 1 : 0, closed: S.closed ? 1 : 0, breath: S.breath ? 1 : 0,\\n      o: objs, p: ps,\\n740→    }, { reliable: false });\\n  }\\n\\n  function applyHands() {\\n    const remote = {};\\n    const info = H.info;\\n    if (!info) return remote;\\n    for (const key in H.hands) {\\n      const i = +key;\\n      const hnd = H.hands[key];\\n750→      if (!hnd) continue;\\n      remote[i] = { x: hnd.x, y: hnd.y, trig: hnd.trig || 0, digit: hnd.digit || 0, aim: [0, 0], mouse: null };\\n    }\\n    return remote;\\n  }\\n\\n  async function connect() {\\n    if (!HUB || !HUB.active) { H.phase = 'solo'; return; }\\n    let info = null;\\n    try { info = await HUB.connect({ mode: 'shared-world', seats: [1, 4], card: true }); }\\n760→    catch (e) { H.phase = 'solo'; return; }\\n    if (!info) { H.phase = 'solo'; return; }\\n    H.info = info;\\n    H.phase = 'wait';\\n    H.local = info.players.findIndex(q => q.id === info.me);\\n    HUB.on('card', c => { H.card = c; });\\n    HUB.on('start', () => { H.phase = 'count'; });\\n    HUB.on('message', (d, from) => {\\n      if (!d) return;\\n      if (info.isHost) {\",\"content_concise\":\"320→      move[1] += pan[1] / Math.max(8, Math.hypot(pan[0], pan[1]));\\n    }\\n    return {\\n      digit, mouse, aim, move, keys, nudge,\\n      fine: I.down('fine'),\\n      trig,\\n      gift: I.down('gift'),\\n      consult: I.down('consult'),\\n      cancel: I.down('cancel'),\\n    };\\n330→  }\\n\\n  function drive(S, dt, opts) {\\n    opts = opts || {};\\n    const inputs = [];\\n    const n = S.players.length;\\n    for (let i = 0; i < n; i++) {\\n      const p = S.players[i];\\n      if (p.gone) { inputs.push({ tool: p.tool, trig: 0 }); continue; }\\n      let dev;\\n340→      if (opts.remote && opts.remote[i]) {\\n        dev = opts.remote[i];\\n      } else if (i === 0 && game.debug && game.debug.driver && !RT.attract) {\\n        dev = game.debug.driver(S, dt) || GAME.Bot.device(S, 0, dt);\\n      } else if (i === 0 && RT.auto && !RT.attract) {\\n        dev = GAME.Bot.device(S, 0, dt);\\n      } else if (i === 0 && !opts.bots && !RT.attract) {\\n        dev = readLocal(p);\\n      } else {\\n        dev = GAME.Bot.device(S, i, dt);\\n350→      }\\n      GAME.Wheel.update(p, dev, dt);\\n      const tune = playTune();\\n      if (dev.mouse) GAME.Cursor.update(p, { mouse: dev.mouse, fine: dev.fine }, S, dt, tune);\\n      else GAME.Cursor.update(p, { aim: dev.aim, keys: dev.keys, nudge: dev.nudge, fine: dev.fine }, S, dt, tune);\\n      const row = {\\n        tool: p.tool,\\n        trig: dev.trig || 0,\\n        fine: !!dev.fine,\\n        gift: !!dev.gift,\\n360→        consult: !!dev.consult,\\n        cancel: !!dev.cancel,\\n        mouse: !!dev.mouse,\\n      };\\n      if (dev.x != null) { row.x = dev.x; row.y = dev.y; }\\n      inputs.push(row);\\n    }\\n    try { GAME.Op.step(S, inputs, dt, playTune()); }\\n    catch (e) { game.fail('op', e); }\\n    if (S.ev) for (const ev of S.ev) { try { GAME.Audio.onEv(ev); } catch (err) { /* quiet */ } }\\n370→    return S;\\n  }\\n\\n  function fieldOf(S) {\\n    const key = (S.site || 'abdomen') + ':' + (S.seed || 1) + ':' + game.W + 'x' + game.H;\\n    if (RT.fieldKey !== key) {\\n      RT.field = GAME.Art.fieldFor(S.site || 'abdomen', S.seed || 1, game.W, game.H);\\n      RT.fieldKey = key;\\n    }\\n    return RT.field;\\n380→  }\\n\\n  const COL = {\\n    shard: '#d5dee6', laceration: '#e05050', wound: '#c43030', bleeder: '#ff4040', arteryTear: '#ff2060',\\n    pool: '#601828', polyp: '#e08898', mass: '#c06078', clot: '#682838', patch: '#e07070',\\n    nerve: '#e2c14a', eloquent: '#f0d060', retractor: '#c8d0d4', bead: '#5ff0e0', nest: '#14383c',\\n    lobe: '#7a5cff', eye: '#d0c8ff', tendril: '#3ec8b0', uvula: '#9a78ff', voice: '#5ff0e0', reed: '#8fd0c8',\\n    repeat: '#f5b700', slur: '#9ad8d0', hook: '#d0d4d8', screw: '#e8e0c8', wire: '#f0d060', lead: '#88e0c8',\\n    cut: '#f2f0e6', fed: '#401018', bite: '#e05050',\\n  };\\n390→  function bloodCol() {\\n    if (PREFS.blood === 'rose') return '#e07098';\\n    if (PREFS.blood === 'ink') return '#2a2030';\\n    return null;\\n  }\\n\\n  function drawOp(r, S, ribbon) {\\n    const [ox, oy] = origin();\\n    r.sky(['#071018', '#102028']);\\n    const F = S ? fieldOf(S) : null;\\n400→    const allow = (typeof document !== 'undefined') || GAME.Art.force;\\n    if (allow && F) {\\n      try { F.shade({ beat: ((S.t || 0) % 1), slow: !!S.breath, dim: S.dim || 0 }); }\\n      catch (e) { /* painter */ }\\n    }\\n    r.overlay(g => {\\n      const px = E.px;\\n      if (F && F.cv && F.cv.width) { try { g.drawImage(F.cv, 0, 0); } catch (e) { /* no image */ } }\\n      px.rect(g, 0, 0, r.W, Math.max(0, oy), '#102830');\\n      px.rect(g, 0, oy + CFG.FIELD_H, r.W, Math.max(0, r.H - oy - CFG.FIELD_H), '#102830');\\n410→      px.rect(g, 0, oy, Math.max(0, ox), CFG.FIELD_H, '#102830');\\n      px.rect(g, ox + CFG.FIELD_W, oy, Math.max(0, r.W - ox - CFG.FIELD_W), CFG.FIELD_H, '#102830');\\n      px.rect(g, ox + 8, oy + 8, CFG.FIELD_W - 16, CFG.FIELD_H - 16, '#0c2428');\\n      if (!S) return;\\n      const ink = bloodCol();\\n      for (const o of S.objects) {\\n        if (!o.alive && o.type !== 'retractor') continue;\\n        if (o.hidden && !o.marked) continue;\\n        const x = o.x + ox, y = o.y + oy;\\n        let c = COL[o.type] || '#9ad0c8';\\n420→        if (ink && (o.type === 'bleeder' || o.type === 'pool' || o.type === 'wound' || o.type === 'laceration' || o.type === 'arteryTear')) c = ink;\\n        const rad = o.type === 'pool' ? 8 + (o.vol || 0) * 0.15 : o.type === 'mass' ? (o.rad || 12) : o.type === 'bead' ? 3 : 4;\\n        if (o.guide && o.guide.length > 1 && (o.type === 'cut' || o.type === 'mass' || o.type === 'slur')) {\\n          for (let k = 1; k < o.guide.length; k++) px.line(g, o.guide[k - 1][0] + ox, o.guide[k - 1][1] + oy, o.guide[k][0] + ox, o.guide[k][1] + oy, '#f2f0e6', 1);\\n        }\\n        px.disc(g, x, y, rad, o.done ? '#2a403c' : c);\\n        if (o.marked) px.disc(g, x, y, rad + 3, '#5ff0e0');\\n      }\\n      if (S.breath) {\\n        px.rect(g, ox + 20, oy + 16, CFG.FIELD_W - 40, 2, '#bfefff');\\n430→        px.rect(g, ox + 20, oy + CFG.FIELD_H - 18, CFG.FIELD_W - 40, 2, '#bfefff');\\n      }\\n      if (RT.wheelShow > 0 && S.players[0] && !S.players[0].gone) {\\n        const c = S.players[0];\\n        for (const w of CFG.WHEEL) {\\n          const x = c.x + ox + w.x * 22, y = c.y + oy + w.y * 22;\\n          const on = c.tool === w.tool;\\n          px.disc(g, x, y, on ? 8 : 5, on ? '#5ff0e0' : '#14343c');\\n          GAME.Art.toolIcon(g, w.tool, x - 4, y - 4, 1);\\n        }\\n440→      }\\n      for (const p of S.players) if (!p.gone) GAME.Art.drawHand(g, p, ox, oy);\\n      const vit = Math.max(0, Math.ceil(S.vitals));\\n      const clk = Math.max(0, Math.ceil(S.clock));\\n      E.font.text(g, 'VIT ' + vit, 8, 6, vit < 30 ? '#ff7a6a' : '#e8fbf6', { scale: 2, outline: '#06141a' });\\n      E.font.text(g, 'CLK ' + clk, 8, 26, clk < 20 ? '#ff7a6a' : '#e8fbf6', { scale: 2, outline: '#06141a' });\\n      E.font.text(g, (S.phaseName || '') + '  ' + (S.activeDoc || ''), 8, 48, '#8fb8b0', { outline: '#06141a' });\\n      const tool = (S.players[0] && S.players[0].tool) || 'forceps';\\n      GAME.Art.toolIcon(g, tool, r.W - 28, r.H - 28, 1);\\n      E.font.text(g, tool.toUpperCase(), r.W - 8, r.H - 36, '#e8fbf6', { align: 'right', outline: '#06141a' });\\n450→      if (PREFS.hints) E.font.text(g, game.input.label('useTool'), r.W - 8, r.H - 14, '#5ff0e0', { align: 'right', outline: false });\\n      const steady = Math.round(S.steady || 0);\\n      E.font.text(g, 'STEADY ' + steady, 8, r.H - 16, '#5ff0e0', { outline: '#06141a' });\\n      if (S.codeBlue) E.font.text(g, 'SHOCK', r.W / 2, 64, '#ff7a6a', { align: 'center', scale: 2, outline: '#06141a' });\\n      if (S.dressing) E.font.text(g, 'DRESSING', r.W / 2, 64, '#f2f0e6', { align: 'center', scale: 2, outline: '#06141a' });\\n      if (ribbon) E.font.text(g, 'DEMO', r.W - 8, 6, '#f5b700', { align: 'right', scale: 2, outline: '#06141a' });\\n      if (GAME.TUNE.dirty || RT.cheatUsed) E.font.text(g, 'DEV', 8, 66, '#f5b700', { outline: '#06141a' });\\n      if (S.t != null && GAME.BARKS && GAME.BARKS.length) {\\n        const bark = GAME.BARKS[Math.floor(S.t / 4) % GAME.BARKS.length];\\n        E.font.text(g, bark, r.W / 2, r.H - 28, '#d8e4dc', { align: 'center', outline: '#06141a' });\\n460→      }\\n      if (RT.devOpen) drawDev(g, r);\\n    });\\n  }\\n\\n  const CHEATS = [\\n    ['reveal', 'Reveal'],\\n    ['infSteady', 'Infinite Steady'],\\n    ['lockVitals', 'Lock vitals'],\\n    ['freezeClock', 'Freeze clock'],\\n470→    ['oneHit', 'One hit'],\\n    ['auto', 'Autosurgeon'],\\n    ['slow', 'Slow motion'],\\n    ['win', 'Clear phase'],\\n    ['lose', 'Force a loss'],\\n    ['code', 'Vitals to zero'],\\n  ];\\n  const SLOW = [0.25, 0.5, 1, 2];\\n\\n  function devRows() {\\n480→    if (RT.devTab === 1) return CHEATS.map(c => c[1]);\\n    if (RT.devTab === 2) {\\n      const rows = [];\\n      for (const id of GAME.ORDER) {\\n        const def = GAME.CASES[id];\\n        const n = (def.phases || []).length;\\n        for (let p = 0; p < n; p++) rows.push(id + ' ' + (def.phases[p].name || p));\\n      }\\n      rows.push('Grand Rounds');\\n      rows.push('Skills Lab');\\n490→      return rows;\\n    }\\n    return GAME.Dev.KEYS.map(k => k[0]).concat(['Reset tuning']);\\n  }\\n\\n  function devAct(dir) {\\n    const S = RT.S;\\n    if (RT.devTab === 0) {\\n      const keys = GAME.Dev.KEYS;\\n      if (RT.devI >= keys.length) { if (dir === 0) GAME.Dev.reset(); return; }\\n500→      if (!dir) return;\\n      const [path, lo, hi] = keys[RT.devI];\\n      const [g, k] = path.split('.');\\n      const step = (hi - lo) / 20;\\n      const cur = GAME.TUNE[g][k];\\n      const v = Math.max(lo, Math.min(hi, Math.round((cur + dir * step) * 1000) / 1000));\\n      GAME.Dev.set(path, v);\\n      return;\\n    }\\n    RT.cheatUsed = true;\\n510→    if (dir !== 0 && RT.devTab !== 1) return;\\n    if (RT.devTab === 1 && dir === 0) {\\n      const key = CHEATS[RT.devI][0];\\n      if (key === 'auto') { RT.auto = !RT.auto; RT.cheatUsed = true; return; }\\n      if (key === 'slow') {\\n        const i = SLOW.indexOf(game.timeScale);\\n        game.timeScale = SLOW[(i + 1) % SLOW.length] || 1;\\n        RT.cheatUsed = true;\\n        return;\\n      }\\n520→      if (key === 'win' && S) {\\n        RT.cheatUsed = true;\\n        for (const o of S.objects) { o.done = true; o.prog = 1; }\\n        S.hold = false;\\n        return;\\n      }\\n      if (key === 'lose' && S) { RT.cheatUsed = true; GAME.Sim.lose(S, 'dev'); return; }\\n      if (key === 'code' && S) { RT.cheatUsed = true; S.vitals = 0; return; }\\n      if (S) {\\n        S.cheat = S.cheat || {};\\n530→        const on = !S.cheat[key];\\n        GAME.Dev.cheat(S, key, on);\\n        RT.cheatUsed = true;\\n      }\\n      return;\\n    }\\n    if (RT.devTab === 2 && dir === 0) {\\n      const rows = devRows();\\n      const label = rows[RT.devI] || '';\\n      RT.cheatUsed = true;\\n540→      if (label === 'Grand Rounds') { beginCase('ferry', { players: 1, fromStory: false }); go('op'); return; }\\n      if (label === 'Skills Lab') { beginCase('lab', { fromStory: false }); go('op'); return; }\\n      const sp = label.indexOf(' ');\\n      const id = sp < 0 ? label : label.slice(0, sp);\\n      const def = GAME.CASES[id];\\n      if (!def) return;\\n      const name = sp < 0 ? '' : label.slice(sp + 1);\\n      let phase = 0;\\n      (def.phases || []).forEach((ph, i) => { if ((ph.name || String(i)) === name) phase = i; });\\n      beginCase(id, { phase, fromStory: false });\\n550→      go('op');\\n    }\\n  }\\n\\n  function handleDev() {\\n    if (!RT.devOpen || inSession) return false;\\n    const I = game.input;\\n    const rows = devRows();\\n    if (I.pressed('cancel')) { RT.devOpen = false; I.consumeAll(); return true; }\\n    if (I.pressed('toolPrev')) RT.devTab = (RT.devTab + 2) % 3;\\n560→    if (I.pressed('toolNext')) RT.devTab = (RT.devTab + 1) % 3;\\n    if (I.pressed('up')) RT.devI = (RT.devI + rows.length - 1) % rows.length;\\n    if (I.pressed('down')) RT.devI = (RT.devI + 1) % rows.length;\\n    if (RT.devI >= rows.length) RT.devI = 0;\\n    if (I.pressed('left')) devAct(-1);\\n    if (I.pressed('right') || I.pressed('confirm')) devAct(I.pressed('confirm') ? 0 : 1);\\n    return true;\\n  }\\n\\n  function drawDev(g, r) {\\n570→    const px = E.px;\\n    const rows = devRows();\\n    const tabs = ['Tune', 'Cheats', 'Jump'];\\n    px.rect(g, r.W - 168, 8, 160, r.H - 16, '#06141a');\\n    E.font.text(g, tabs[RT.devTab], r.W - 160, 12, '#f5b700', { outline: false });\\n    const first = Math.max(0, Math.min(RT.devI - 6, rows.length - 12));\\n    for (let i = 0; i < 12 && first + i < rows.length; i++) {\\n      const k = first + i;\\n      const on = k === RT.devI;\\n      E.font.text(g, (on ? '> ' : '  ') + rows[k], r.W - 160, 28 + i * 12, on ? '#5ff0e0' : '#8fb8b0', { outline: false });\\n580→    }\\n  }\\n\\n  function drawTitle(r, t) {\\n    r.sky(['#071018', '#0e2430']);\\n    r.overlay(g => {\\n      GAME.Art.titleBackdrop(g, r.W, r.H, t || game.real || 0);\\n      E.font.title(g, 'OPEN TABLE', r.W / 2, 28, { scale: 2, align: 'center', colors: ['#f4fff8', '#9aefe4', '#1c6e78'] });\\n      E.font.text(g, TITLE, r.W / 2, 78, '#e8fbf6', { align: 'center', scale: 1, outline: '#06141a' });\\n      E.font.text(g, \\\"Don't let it go quiet\\\", r.W / 2, 96, '#5ff0e0', { align: 'center', outline: false });\\n590→      const y = 120;\\n      let x = 24;\\n      const beat = [0, 2, 0, 6, 0, 2, 8, 0, 1, 0, 4, 0];\\n      for (let i = 0; i < beat.length; i++) {\\n        const h = 2 + beat[i];\\n        E.px.rect(g, x, y - h, 6, h, '#7CFFB2');\\n        x += 10;\\n      }\\n      const prompt = game.input.label('confirm');\\n      E.font.text(g, prompt, r.W / 2, r.H - 28, '#e8fbf6', { align: 'center', scale: 2, outline: '#06141a' });\\n600→    });\\n  }\\n\\n  function snapshot() {\\n    const S = RT.S;\\n    const [ox, oy] = origin();\\n    let mark = null;\\n    if (RT.light && RT.light.mark) mark = [ox + RT.light.mark[0], oy + RT.light.mark[1]];\\n    const choice = !!(story.talk && story.talk.open && story.talk.choices && story.talk.choices.length && !story.talk.typing);\\n    return {\\n610→      scene: game.sceneName,\\n      menu: RT.menu ? { i: RT.menu.i, labels: RT.menu.items.map(it => (typeof it === 'string' ? it : it.label)) } : null,\\n      story: story.running ? story.node : null,\\n      held: !!story._held,\\n      choice,\\n      op: S ? {\\n        id: S.id, won: !!S.won, lost: !!S.lost, phase: S.phase, phaseName: S.phaseName,\\n        clock: S.clock, vitals: S.vitals, score: S.score, rank: S.rank,\\n        breath: !!S.breath, worldScale: S.worldScale, closed: !!S.closed,\\n      } : null,\\n620→      lightbox: mark,\\n      ward: { patients: RT.visitors.slice(), nearDoor: !!RT.nearDoor },\\n      attract: RT.attract ? { on: true, loops: RT.loops, seg: RT.seg } : null,\\n      dev: { open: !!RT.devOpen, dirty: !!GAME.TUNE.dirty },\\n      ranks: Object.assign({}, RT.ranks),\\n      cleared: Object.assign({}, RT.cleared),\\n      reel: RT.loops,\\n    };\\n  }\\n\\n630→  const REEL = [\\n    { kind: 'story', t: 4 },\\n    { kind: 'op', id: 'c1', t: 15, cheat: { lockVitals: true, freezeClock: true, oneHit: true } },\\n    { kind: 'op', id: 'c3', t: 8, cheat: { lockVitals: true, freezeClock: true, oneHit: true } },\\n    { kind: 'op', id: 'c6', t: 8, cheat: { lockVitals: true, freezeClock: true, oneHit: true } },\\n    { kind: 'op', id: 'c7', t: 8, cheat: { lockVitals: true, freezeClock: true, infSteady: true } },\\n    { kind: 'rounds', t: 8 },\\n    { kind: 'op', id: 'c11', t: 8, cheat: { lockVitals: true, freezeClock: true, oneHit: true } },\\n    { kind: 'card', t: 4 },\\n    { kind: 'title', t: 8 },\\n640→  ];\\n\\n  function startSegment() {\\n    const seg = REEL[RT.seg];\\n    RT.segT = 0;\\n    if (seg.kind === 'op') {\\n      const S = beginCase(seg.id, { fromStory: false, cheat: seg.cheat, seed: 3 });\\n      if (S) S.mode = 'attract';\\n      game.setView('overhead');\\n    } else if (seg.kind === 'rounds') {\\n650→      const S = beginCase('ferry', { players: 4, fromStory: false, cheat: { lockVitals: true, freezeClock: true, oneHit: true } });\\n      if (S) S.mode = 'attract';\\n      game.setView('overhead');\\n    } else if (seg.kind === 'story') {\\n      game.setView('side');\\n      if (!RT.reelStory) {\\n        RT.reelStory = new E.Story(game, {\\n          people,\\n          nodes: { beat: [GAME.NODES.start[0]] },\\n          on: {},\\n660→        });\\n      }\\n      RT.reelStory.skip = true;\\n      RT.reelStory.run('beat');\\n    } else game.setView('side');\\n  }\\n\\n  const H = {\\n    info: null,\\n    phase: 'solo',\\n670→    over: false,\\n    accS: 0,\\n    accI: 0,\\n    snapN: 0,\\n    inN: 0,\\n    heard: 0,\\n    hands: {},\\n    view: null,\\n    card: null,\\n    local: -1,\\n680→  };\\n\\n  function hubFinish() {\\n    if (H.over || !H.info || !H.info.isHost) return;\\n    H.over = true;\\n    const info = H.info;\\n    const S = RT.S;\\n    const scoreOf = (id) => {\\n      const idx = info.players.findIndex(q => q.id === id);\\n      const p = S && S.players[idx];\\n690→      return p ? (p.actions | 0) : 0;\\n    };\\n    const ids = info.players.map(q => q.id);\\n    ids.sort((a, b) => scoreOf(b) - scoreOf(a));\\n    const standings = [];\\n    for (const id of ids) {\\n      const last = standings[standings.length - 1];\\n      if (last && scoreOf(last[0]) === scoreOf(id)) last.push(id);\\n      else standings.push([id]);\\n    }\\n700→    const scores = {};\\n    for (const id of ids) scores[id] = scoreOf(id);\\n    const best = ids[0];\\n    const detail = (scores[best] || 0) + ' clean actions';\\n    const awards = best == null ? [] : [{ id: best, title: 'Steadiest Hand', detail: detail.slice(0, 40) }];\\n    try { HUB.send({ t: 'over', n: ++H.snapN }); } catch (e) { /* late */ }\\n    HUB.finish({\\n      standings,\\n      scores,\\n      won: !!(S && S.closed),\\n710→      awards,\\n      stats: { clock: S ? Math.round(S.clock) : 0, vitals: S ? Math.round(S.vitals) : 0 },\\n    });\\n  }\\n\\n  const TYPE_N = {};\\n  ['shard', 'laceration', 'wound', 'bleeder', 'arteryTear', 'pool', 'polyp', 'mass', 'clot', 'bead', 'nest', 'lobe', 'eye', 'tendril', 'voice', 'repeat', 'retractor'].forEach((t, i) => { TYPE_N[t] = i + 1; });\\n\\n  function sendSnap() {\\n    const S = RT.S;\\n720→    const info = H.info;\\n    if (!S || !info) return;\\n    const objs = [];\\n    for (const o of S.objects) {\\n      if (objs.length >= 28) break;\\n      if (o.done && o.type !== 'retractor') continue;\\n      let flags = (o.done ? 1 : 0) | (o.hidden ? 2 : 0) | (o.marked ? 4 : 0) | (o.alive ? 8 : 0);\\n      objs.push([o.id, o.x | 0, o.y | 0, TYPE_N[o.type] || 0, flags]);\\n    }\\n    const ps = info.players.map((q, i) => {\\n730→      const p = S.players[i];\\n      if (!p) return [q.id, 0, 0, 0, 0, 0, 1];\\n      const tool = Math.max(0, CFG.TOOLS.indexOf(p.tool));\\n      return [q.id, p.x | 0, p.y | 0, tool, p.trig > 0.3 ? 1 : 0, p.actions | 0, p.gone ? 1 : 0];\\n    });\\n    HUB.send({\\n      t: 's', n: ++H.snapN,\\n      clock: S.clock | 0, vitals: S.vitals | 0, phase: S.phase | 0,\\n      won: S.won ? 1 : 0, closed: S.closed ? 1 : 0, breath: S.breath ? 1 : 0,\\n      o: objs, p: ps,\\n740→    }, { reliable: false });\\n  }\\n\\n  function applyHands() {\\n    const remote = {};\\n    const info = H.info;\\n    if (!info) return remote;\\n    for (const key in H.hands) {\\n      const i = +key;\\n      const hnd = H.hands[key];\\n750→      if (!hnd) continue;\\n      remote[i] = { x: hnd.x, y: hnd.y, trig: hnd.trig || 0, digit: hnd.digit || 0, aim: [0, 0], mouse: null };\\n    }\\n    return remote;\\n  }\\n\\n  async function connect() {\\n    if (!HUB || !HUB.active) { H.phase = 'solo'; return; }\\n    let info = null;\\n    try { info = await HUB.connect({ mode: 'shared-world', seats: [1, 4], card: true }); }\\n760→    catch (e) { H.phase = 'solo'; return; }\\n    if (!info) { H.phase = 'solo'; return; }\\n    H.info = info;\\n    H.phase = 'wait';\\n    H.local = info.players.findIndex(q => q.id === info.me);\\n    HUB.on('card', c => { H.card = c; });\\n    HUB.on('start', () => { H.phase = 'count'; });\\n    HUB.on('message', (d, from) => {\\n      if (!d) return;\\n      if (info.isHost) {\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/scenes/shell.js\",\"offset\":320,\"limit\":450,\"raw_output\":\"      move[1] += pan[1] / Math.max(8, Math.hypot(pan[0], pan[1]));\\n    }\\n    return {\\n      digit, mouse, aim, move, keys, nudge,\\n      fine: I.down('fine'),\\n      trig,\\n      gift: I.down('gift'),\\n      consult: I.down('consult'),\\n      cancel: I.down('cancel'),\\n    };\\n  }\\n\\n  function drive(S, dt, opts) {\\n    opts = opts || {};\\n    const inputs = [];\\n    const n = S.players.length;\\n    for (let i = 0; i < n; i++) {\\n      const p = S.players[i];\\n      if (p.gone) { inputs.push({ tool: p.tool, trig: 0 }); continue; }\\n      let dev;\\n      if (opts.remote && opts.remote[i]) {\\n        dev = opts.remote[i];\\n      } else if (i === 0 && game.debug && game.debug.driver && !RT.attract) {\\n        dev = game.debug.driver(S, dt) || GAME.Bot.device(S, 0, dt);\\n      } else if (i === 0 && RT.auto && !RT.attract) {\\n        dev = GAME.Bot.device(S, 0, dt);\\n      } else if (i === 0 && !opts.bots && !RT.attract) {\\n        dev = readLocal(p);\\n      } else {\\n        dev = GAME.Bot.device(S, i, dt);\\n      }\\n      GAME.Wheel.update(p, dev, dt);\\n      const tune = playTune();\\n      if (dev.mouse) GAME.Cursor.update(p, { mouse: dev.mouse, fine: dev.fine }, S, dt, tune);\\n      else GAME.Cursor.update(p, { aim: dev.aim, keys: dev.keys, nudge: dev.nudge, fine: dev.fine }, S, dt, tune);\\n      const row = {\\n        tool: p.tool,\\n        trig: dev.trig || 0,\\n        fine: !!dev.fine,\\n        gift: !!dev.gift,\\n        consult: !!dev.consult,\\n        cancel: !!dev.cancel,\\n        mouse: !!dev.mouse,\\n      };\\n      if (dev.x != null) { row.x = dev.x; row.y = dev.y; }\\n      inputs.push(row);\\n    }\\n    try { GAME.Op.step(S, inputs, dt, playTune()); }\\n    catch (e) { game.fail('op', e); }\\n    if (S.ev) for (const ev of S.ev) { try { GAME.Audio.onEv(ev); } catch (err) { /* quiet */ } }\\n    return S;\\n  }\\n\\n  function fieldOf(S) {\\n    const key = (S.site || 'abdomen') + ':' + (S.seed || 1) + ':' + game.W + 'x' + game.H;\\n    if (RT.fieldKey !== key) {\\n      RT.field = GAME.Art.fieldFor(S.site || 'abdomen', S.seed || 1, game.W, game.H);\\n      RT.fieldKey = key;\\n    }\\n    return RT.field;\\n  }\\n\\n  const COL = {\\n    shard: '#d5dee6', laceration: '#e05050', wound: '#c43030', bleeder: '#ff4040', arteryTear: '#ff2060',\\n    pool: '#601828', polyp: '#e08898', mass: '#c06078', clot: '#682838', patch: '#e07070',\\n    nerve: '#e2c14a', eloquent: '#f0d060', retractor: '#c8d0d4', bead: '#5ff0e0', nest: '#14383c',\\n    lobe: '#7a5cff', eye: '#d0c8ff', tendril: '#3ec8b0', uvula: '#9a78ff', voice: '#5ff0e0', reed: '#8fd0c8',\\n    repeat: '#f5b700', slur: '#9ad8d0', hook: '#d0d4d8', screw: '#e8e0c8', wire: '#f0d060', lead: '#88e0c8',\\n    cut: '#f2f0e6', fed: '#401018', bite: '#e05050',\\n  };\\n  function bloodCol() {\\n    if (PREFS.blood === 'rose') return '#e07098';\\n    if (PREFS.blood === 'ink') return '#2a2030';\\n    return null;\\n  }\\n\\n  function drawOp(r, S, ribbon) {\\n    const [ox, oy] = origin();\\n    r.sky(['#071018', '#102028']);\\n    const F = S ? fieldOf(S) : null;\\n    const allow = (typeof document !== 'undefined') || GAME.Art.force;\\n    if (allow && F) {\\n      try { F.shade({ beat: ((S.t || 0) % 1), slow: !!S.breath, dim: S.dim || 0 }); }\\n      catch (e) { /* painter */ }\\n    }\\n    r.overlay(g => {\\n      const px = E.px;\\n      if (F && F.cv && F.cv.width) { try { g.drawImage(F.cv, 0, 0); } catch (e) { /* no image */ } }\\n      px.rect(g, 0, 0, r.W, Math.max(0, oy), '#102830');\\n      px.rect(g, 0, oy + CFG.FIELD_H, r.W, Math.max(0, r.H - oy - CFG.FIELD_H), '#102830');\\n      px.rect(g, 0, oy, Math.max(0, ox), CFG.FIELD_H, '#102830');\\n      px.rect(g, ox + CFG.FIELD_W, oy, Math.max(0, r.W - ox - CFG.FIELD_W), CFG.FIELD_H, '#102830');\\n      px.rect(g, ox + 8, oy + 8, CFG.FIELD_W - 16, CFG.FIELD_H - 16, '#0c2428');\\n      if (!S) return;\\n      const ink = bloodCol();\\n      for (const o of S.objects) {\\n        if (!o.alive && o.type !== 'retractor') continue;\\n        if (o.hidden && !o.marked) continue;\\n        const x = o.x + ox, y = o.y + oy;\\n        let c = COL[o.type] || '#9ad0c8';\\n        if (ink && (o.type === 'bleeder' || o.type === 'pool' || o.type === 'wound' || o.type === 'laceration' || o.type === 'arteryTear')) c = ink;\\n        const rad = o.type === 'pool' ? 8 + (o.vol || 0) * 0.15 : o.type === 'mass' ? (o.rad || 12) : o.type === 'bead' ? 3 : 4;\\n        if (o.guide && o.guide.length > 1 && (o.type === 'cut' || o.type === 'mass' || o.type === 'slur')) {\\n          for (let k = 1; k < o.guide.length; k++) px.line(g, o.guide[k - 1][0] + ox, o.guide[k - 1][1] + oy, o.guide[k][0] + ox, o.guide[k][1] + oy, '#f2f0e6', 1);\\n        }\\n        px.disc(g, x, y, rad, o.done ? '#2a403c' : c);\\n        if (o.marked) px.disc(g, x, y, rad + 3, '#5ff0e0');\\n      }\\n      if (S.breath) {\\n        px.rect(g, ox + 20, oy + 16, CFG.FIELD_W - 40, 2, '#bfefff');\\n        px.rect(g, ox + 20, oy + CFG.FIELD_H - 18, CFG.FIELD_W - 40, 2, '#bfefff');\\n      }\\n      if (RT.wheelShow > 0 && S.players[0] && !S.players[0].gone) {\\n        const c = S.players[0];\\n        for (const w of CFG.WHEEL) {\\n          const x = c.x + ox + w.x * 22, y = c.y + oy + w.y * 22;\\n          const on = c.tool === w.tool;\\n          px.disc(g, x, y, on ? 8 : 5, on ? '#5ff0e0' : '#14343c');\\n          GAME.Art.toolIcon(g, w.tool, x - 4, y - 4, 1);\\n        }\\n      }\\n      for (const p of S.players) if (!p.gone) GAME.Art.drawHand(g, p, ox, oy);\\n      const vit = Math.max(0, Math.ceil(S.vitals));\\n      const clk = Math.max(0, Math.ceil(S.clock));\\n      E.font.text(g, 'VIT ' + vit, 8, 6, vit < 30 ? '#ff7a6a' : '#e8fbf6', { scale: 2, outline: '#06141a' });\\n      E.font.text(g, 'CLK ' + clk, 8, 26, clk < 20 ? '#ff7a6a' : '#e8fbf6', { scale: 2, outline: '#06141a' });\\n      E.font.text(g, (S.phaseName || '') + '  ' + (S.activeDoc || ''), 8, 48, '#8fb8b0', { outline: '#06141a' });\\n      const tool = (S.players[0] && S.players[0].tool) || 'forceps';\\n      GAME.Art.toolIcon(g, tool, r.W - 28, r.H - 28, 1);\\n      E.font.text(g, tool.toUpperCase(), r.W - 8, r.H - 36, '#e8fbf6', { align: 'right', outline: '#06141a' });\\n      if (PREFS.hints) E.font.text(g, game.input.label('useTool'), r.W - 8, r.H - 14, '#5ff0e0', { align: 'right', outline: false });\\n      const steady = Math.round(S.steady || 0);\\n      E.font.text(g, 'STEADY ' + steady, 8, r.H - 16, '#5ff0e0', { outline: '#06141a' });\\n      if (S.codeBlue) E.font.text(g, 'SHOCK', r.W / 2, 64, '#ff7a6a', { align: 'center', scale: 2, outline: '#06141a' });\\n      if (S.dressing) E.font.text(g, 'DRESSING', r.W / 2, 64, '#f2f0e6', { align: 'center', scale: 2, outline: '#06141a' });\\n      if (ribbon) E.font.text(g, 'DEMO', r.W - 8, 6, '#f5b700', { align: 'right', scale: 2, outline: '#06141a' });\\n      if (GAME.TUNE.dirty || RT.cheatUsed) E.font.text(g, 'DEV', 8, 66, '#f5b700', { outline: '#06141a' });\\n      if (S.t != null && GAME.BARKS && GAME.BARKS.length) {\\n        const bark = GAME.BARKS[Math.floor(S.t / 4) % GAME.BARKS.length];\\n        E.font.text(g, bark, r.W / 2, r.H - 28, '#d8e4dc', { align: 'center', outline: '#06141a' });\\n      }\\n      if (RT.devOpen) drawDev(g, r);\\n    });\\n  }\\n\\n  const CHEATS = [\\n    ['reveal', 'Reveal'],\\n    ['infSteady', 'Infinite Steady'],\\n    ['lockVitals', 'Lock vitals'],\\n    ['freezeClock', 'Freeze clock'],\\n    ['oneHit', 'One hit'],\\n    ['auto', 'Autosurgeon'],\\n    ['slow', 'Slow motion'],\\n    ['win', 'Clear phase'],\\n    ['lose', 'Force a loss'],\\n    ['code', 'Vitals to zero'],\\n  ];\\n  const SLOW = [0.25, 0.5, 1, 2];\\n\\n  function devRows() {\\n    if (RT.devTab === 1) return CHEATS.map(c => c[1]);\\n    if (RT.devTab === 2) {\\n      const rows = [];\\n      for (const id of GAME.ORDER) {\\n        const def = GAME.CASES[id];\\n        const n = (def.phases || []).length;\\n        for (let p = 0; p < n; p++) rows.push(id + ' ' + (def.phases[p].name || p));\\n      }\\n      rows.push('Grand Rounds');\\n      rows.push('Skills Lab');\\n      return rows;\\n    }\\n    return GAME.Dev.KEYS.map(k => k[0]).concat(['Reset tuning']);\\n  }\\n\\n  function devAct(dir) {\\n    const S = RT.S;\\n    if (RT.devTab === 0) {\\n      const keys = GAME.Dev.KEYS;\\n      if (RT.devI >= keys.length) { if (dir === 0) GAME.Dev.reset(); return; }\\n      if (!dir) return;\\n      const [path, lo, hi] = keys[RT.devI];\\n      const [g, k] = path.split('.');\\n      const step = (hi - lo) / 20;\\n      const cur = GAME.TUNE[g][k];\\n      const v = Math.max(lo, Math.min(hi, Math.round((cur + dir * step) * 1000) / 1000));\\n      GAME.Dev.set(path, v);\\n      return;\\n    }\\n    RT.cheatUsed = true;\\n    if (dir !== 0 && RT.devTab !== 1) return;\\n    if (RT.devTab === 1 && dir === 0) {\\n      const key = CHEATS[RT.devI][0];\\n      if (key === 'auto') { RT.auto = !RT.auto; RT.cheatUsed = true; return; }\\n      if (key === 'slow') {\\n        const i = SLOW.indexOf(game.timeScale);\\n        game.timeScale = SLOW[(i + 1) % SLOW.length] || 1;\\n        RT.cheatUsed = true;\\n        return;\\n      }\\n      if (key === 'win' && S) {\\n        RT.cheatUsed = true;\\n        for (const o of S.objects) { o.done = true; o.prog = 1; }\\n        S.hold = false;\\n        return;\\n      }\\n      if (key === 'lose' && S) { RT.cheatUsed = true; GAME.Sim.lose(S, 'dev'); return; }\\n      if (key === 'code' && S) { RT.cheatUsed = true; S.vitals = 0; return; }\\n      if (S) {\\n        S.cheat = S.cheat || {};\\n        const on = !S.cheat[key];\\n        GAME.Dev.cheat(S, key, on);\\n        RT.cheatUsed = true;\\n      }\\n      return;\\n    }\\n    if (RT.devTab === 2 && dir === 0) {\\n      const rows = devRows();\\n      const label = rows[RT.devI] || '';\\n      RT.cheatUsed = true;\\n      if (label === 'Grand Rounds') { beginCase('ferry', { players: 1, fromStory: false }); go('op'); return; }\\n      if (label === 'Skills Lab') { beginCase('lab', { fromStory: false }); go('op'); return; }\\n      const sp = label.indexOf(' ');\\n      const id = sp < 0 ? label : label.slice(0, sp);\\n      const def = GAME.CASES[id];\\n      if (!def) return;\\n      const name = sp < 0 ? '' : label.slice(sp + 1);\\n      let phase = 0;\\n      (def.phases || []).forEach((ph, i) => { if ((ph.name || String(i)) === name) phase = i; });\\n      beginCase(id, { phase, fromStory: false });\\n      go('op');\\n    }\\n  }\\n\\n  function handleDev() {\\n    if (!RT.devOpen || inSession) return false;\\n    const I = game.input;\\n    const rows = devRows();\\n    if (I.pressed('cancel')) { RT.devOpen = false; I.consumeAll(); return true; }\\n    if (I.pressed('toolPrev')) RT.devTab = (RT.devTab + 2) % 3;\\n    if (I.pressed('toolNext')) RT.devTab = (RT.devTab + 1) % 3;\\n    if (I.pressed('up')) RT.devI = (RT.devI + rows.length - 1) % rows.length;\\n    if (I.pressed('down')) RT.devI = (RT.devI + 1) % rows.length;\\n    if (RT.devI >= rows.length) RT.devI = 0;\\n    if (I.pressed('left')) devAct(-1);\\n    if (I.pressed('right') || I.pressed('confirm')) devAct(I.pressed('confirm') ? 0 : 1);\\n    return true;\\n  }\\n\\n  function drawDev(g, r) {\\n    const px = E.px;\\n    const rows = devRows();\\n    const tabs = ['Tune', 'Cheats', 'Jump'];\\n    px.rect(g, r.W - 168, 8, 160, r.H - 16, '#06141a');\\n    E.font.text(g, tabs[RT.devTab], r.W - 160, 12, '#f5b700', { outline: false });\\n    const first = Math.max(0, Math.min(RT.devI - 6, rows.length - 12));\\n    for (let i = 0; i < 12 && first + i < rows.length; i++) {\\n      const k = first + i;\\n      const on = k === RT.devI;\\n      E.font.text(g, (on ? '> ' : '  ') + rows[k], r.W - 160, 28 + i * 12, on ? '#5ff0e0' : '#8fb8b0', { outline: false });\\n    }\\n  }\\n\\n  function drawTitle(r, t) {\\n    r.sky(['#071018', '#0e2430']);\\n    r.overlay(g => {\\n      GAME.Art.titleBackdrop(g, r.W, r.H, t || game.real || 0);\\n      E.font.title(g, 'OPEN TABLE', r.W / 2, 28, { scale: 2, align: 'center', colors: ['#f4fff8', '#9aefe4', '#1c6e78'] });\\n      E.font.text(g, TITLE, r.W / 2, 78, '#e8fbf6', { align: 'center', scale: 1, outline: '#06141a' });\\n      E.font.text(g, \\\"Don't let it go quiet\\\", r.W / 2, 96, '#5ff0e0', { align: 'center', outline: false });\\n      const y = 120;\\n      let x = 24;\\n      const beat = [0, 2, 0, 6, 0, 2, 8, 0, 1, 0, 4, 0];\\n      for (let i = 0; i < beat.length; i++) {\\n        const h = 2 + beat[i];\\n        E.px.rect(g, x, y - h, 6, h, '#7CFFB2');\\n        x += 10;\\n      }\\n      const prompt = game.input.label('confirm');\\n      E.font.text(g, prompt, r.W / 2, r.H - 28, '#e8fbf6', { align: 'center', scale: 2, outline: '#06141a' });\\n    });\\n  }\\n\\n  function snapshot() {\\n    const S = RT.S;\\n    const [ox, oy] = origin();\\n    let mark = null;\\n    if (RT.light && RT.light.mark) mark = [ox + RT.light.mark[0], oy + RT.light.mark[1]];\\n    const choice = !!(story.talk && story.talk.open && story.talk.choices && story.talk.choices.length && !story.talk.typing);\\n    return {\\n      scene: game.sceneName,\\n      menu: RT.menu ? { i: RT.menu.i, labels: RT.menu.items.map(it => (typeof it === 'string' ? it : it.label)) } : null,\\n      story: story.running ? story.node : null,\\n      held: !!story._held,\\n      choice,\\n      op: S ? {\\n        id: S.id, won: !!S.won, lost: !!S.lost, phase: S.phase, phaseName: S.phaseName,\\n        clock: S.clock, vitals: S.vitals, score: S.score, rank: S.rank,\\n        breath: !!S.breath, worldScale: S.worldScale, closed: !!S.closed,\\n      } : null,\\n      lightbox: mark,\\n      ward: { patients: RT.visitors.slice(), nearDoor: !!RT.nearDoor },\\n      attract: RT.attract ? { on: true, loops: RT.loops, seg: RT.seg } : null,\\n      dev: { open: !!RT.devOpen, dirty: !!GAME.TUNE.dirty },\\n      ranks: Object.assign({}, RT.ranks),\\n      cleared: Object.assign({}, RT.cleared),\\n      reel: RT.loops,\\n    };\\n  }\\n\\n  const REEL = [\\n    { kind: 'story', t: 4 },\\n    { kind: 'op', id: 'c1', t: 15, cheat: { lockVitals: true, freezeClock: true, oneHit: true } },\\n    { kind: 'op', id: 'c3', t: 8, cheat: { lockVitals: true, freezeClock: true, oneHit: true } },\\n    { kind: 'op', id: 'c6', t: 8, cheat: { lockVitals: true, freezeClock: true, oneHit: true } },\\n    { kind: 'op', id: 'c7', t: 8, cheat: { lockVitals: true, freezeClock: true, infSteady: true } },\\n    { kind: 'rounds', t: 8 },\\n    { kind: 'op', id: 'c11', t: 8, cheat: { lockVitals: true, freezeClock: true, oneHit: true } },\\n    { kind: 'card', t: 4 },\\n    { kind: 'title', t: 8 },\\n  ];\\n\\n  function startSegment() {\\n    const seg = REEL[RT.seg];\\n    RT.segT = 0;\\n    if (seg.kind === 'op') {\\n      const S = beginCase(seg.id, { fromStory: false, cheat: seg.cheat, seed: 3 });\\n      if (S) S.mode = 'attract';\\n      game.setView('overhead');\\n    } else if (seg.kind === 'rounds') {\\n      const S = beginCase('ferry', { players: 4, fromStory: false, cheat: { lockVitals: true, freezeClock: true, oneHit: true } });\\n      if (S) S.mode = 'attract';\\n      game.setView('overhead');\\n    } else if (seg.kind === 'story') {\\n      game.setView('side');\\n      if (!RT.reelStory) {\\n        RT.reelStory = new E.Story(game, {\\n          people,\\n          nodes: { beat: [GAME.NODES.start[0]] },\\n          on: {},\\n        });\\n      }\\n      RT.reelStory.skip = true;\\n      RT.reelStory.run('beat');\\n    } else game.setView('side');\\n  }\\n\\n  const H = {\\n    info: null,\\n    phase: 'solo',\\n    over: false,\\n    accS: 0,\\n    accI: 0,\\n    snapN: 0,\\n    inN: 0,\\n    heard: 0,\\n    hands: {},\\n    view: null,\\n    card: null,\\n    local: -1,\\n  };\\n\\n  function hubFinish() {\\n    if (H.over || !H.info || !H.info.isHost) return;\\n    H.over = true;\\n    const info = H.info;\\n    const S = RT.S;\\n    const scoreOf = (id) => {\\n      const idx = info.players.findIndex(q => q.id === id);\\n      const p = S && S.players[idx];\\n      return p ? (p.actions | 0) : 0;\\n    };\\n    const ids = info.players.map(q => q.id);\\n    ids.sort((a, b) => scoreOf(b) - scoreOf(a));\\n    const standings = [];\\n    for (const id of ids) {\\n      const last = standings[standings.length - 1];\\n      if (last && scoreOf(last[0]) === scoreOf(id)) last.push(id);\\n      else standings.push([id]);\\n    }\\n    const scores = {};\\n    for (const id of ids) scores[id] = scoreOf(id);\\n    const best = ids[0];\\n    const detail = (scores[best] || 0) + ' clean actions';\\n    const awards = best == null ? [] : [{ id: best, title: 'Steadiest Hand', detail: detail.slice(0, 40) }];\\n    try { HUB.send({ t: 'over', n: ++H.snapN }); } catch (e) { /* late */ }\\n    HUB.finish({\\n      standings,\\n      scores,\\n      won: !!(S && S.closed),\\n      awards,\\n      stats: { clock: S ? Math.round(S.clock) : 0, vitals: S ? Math.round(S.vitals) : 0 },\\n    });\\n  }\\n\\n  const TYPE_N = {};\\n  ['shard', 'laceration', 'wound', 'bleeder', 'arteryTear', 'pool', 'polyp', 'mass', 'clot', 'bead', 'nest', 'lobe', 'eye', 'tendril', 'voice', 'repeat', 'retractor'].forEach((t, i) => { TYPE_N[t] = i + 1; });\\n\\n  function sendSnap() {\\n    const S = RT.S;\\n    const info = H.info;\\n    if (!S || !info) return;\\n    const objs = [];\\n    for (const o of S.objects) {\\n      if (objs.length >= 28) break;\\n      if (o.done && o.type !== 'retractor') continue;\\n      let flags = (o.done ? 1 : 0) | (o.hidden ? 2 : 0) | (o.marked ? 4 : 0) | (o.alive ? 8 : 0);\\n      objs.push([o.id, o.x | 0, o.y | 0, TYPE_N[o.type] || 0, flags]);\\n    }\\n    const ps = info.players.map((q, i) => {\\n      const p = S.players[i];\\n      if (!p) return [q.id, 0, 0, 0, 0, 0, 1];\\n      const tool = Math.max(0, CFG.TOOLS.indexOf(p.tool));\\n      return [q.id, p.x | 0, p.y | 0, tool, p.trig > 0.3 ? 1 : 0, p.actions | 0, p.gone ? 1 : 0];\\n    });\\n    HUB.send({\\n      t: 's', n: ++H.snapN,\\n      clock: S.clock | 0, vitals: S.vitals | 0, phase: S.phase | 0,\\n      won: S.won ? 1 : 0, closed: S.closed ? 1 : 0, breath: S.breath ? 1 : 0,\\n      o: objs, p: ps,\\n    }, { reliable: false });\\n  }\\n\\n  function applyHands() {\\n    const remote = {};\\n    const info = H.info;\\n    if (!info) return remote;\\n    for (const key in H.hands) {\\n      const i = +key;\\n      const hnd = H.hands[key];\\n      if (!hnd) continue;\\n      remote[i] = { x: hnd.x, y: hnd.y, trig: hnd.tri