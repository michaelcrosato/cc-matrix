2:46 my-3d2dge.js\\n-rw-r--r-- 1 micha micha     375 Nov  4 22:46 package.json\\ndrwxr-xr-x 3 micha micha    4096 Nov  4 22:46 src\\ndrwxr-xr-x 2 micha micha    4096 Nov  4 22:46 tools\\n==== sizes ====\\n1266871 /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/my-3d2dge/dist/handoff/my-3d2dge.js\\n   8139 /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/my-3d2dge/dist/handoff/README.md\\n  68162 /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/my-3d2dge/dist/handoff/API.md\\n   2609 /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/my-3d2dge/dist/handoff/game/test.mjs\\n  17587 /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/hub/README.md\\n  16707 /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/hub/session.js\\n  27469 /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/hub/harness.html\\n1407544 total\\n==== version ====\\n{\\n  \\\"name\\\": \\\"my-3d2dge-handoff\\\",\\n  \\\"version\\\": \\\"0.89.1\\\",\\n  \\\"private\\\": true,\\n  \\\"type\\\": \\\"module\\\",\\n  \\\"description\\\": \\\"my-3D2dge for coding agents: the engine, its card, index and guide, the tools and a template game\\\",\\n  \\\"scripts\\\": {\\n    \\\"test\\\": \\\"node game/test.mjs\\\",\\n    \\\"check\\\": \\\"node tools/check.mjs game/index.html\\\"\\n  },\\n  \\\"devDependencies\\\": {\\n    \\\"playwright\\\": \\\"1.63.0\\\"\\n  }\\n}\\n==== hub version ====\\n# AI Hub Session Protocol v1\\n\\nAn **AI Hub session** is up to four players, each on their own device,\\nplaying rounds of games one after another. The hub runs everything around a\\nround: the invite, the lobby, the seats and names, the network, the clock, the\\nscoreboard and the results. This page defines how a game takes part in a\\nround, and how the copies of a game send data to each other.\\n\\n**https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md**\\n\\nThe hub tests every game when it joins the library, with the same test\\ndescribed in *Test it*, and keeps a game that fails it out of sessions.\\n\\n- Client: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js\\n- Harness: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\\n\\nTo ask an agent for it, add this to the game's prompt:\\n\\n> This game must support AI Hub sessions. Follow\\n> https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md\\n> (AI Hub Session Protocol v1) and pass the harness's automatic check.\\n\\n---\\n\\n## Modes\\n\\nA game declares one mode.\\n\\n| Mode | What each copy runs | What the copies send each other |\\n|---|---|---|\\n| `parallel` | its own copy of the round | nothing |\\n| `ghost` | its own copy of the round | each copy's own player: where it is and what it is doing |\\n| `shared-world` | one world for all players, run by the host's copy | what each player does, to the host; the world, from the host |\\n\\n- **Parallel**: every player plays their own copy of the round, from the same\\n  start. Each copy reports its score to the hub.\\n- **Ghost**: as parallel, and each copy also shows the other players'\\n  characters where they are, when they are in the same area of the game.\\n  Those characters do not affect anything in the copy that shows them.\\n- **Shared world**: all players play in one world. The host's copy runs that\\n==== forbidden in engine ====\\n/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/my-3d2dge/dist/handoff/my-3d2dge.js\\n1\\n==== test.mjs head ====\\n    42 /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/my-3d2dge/dist/handoff/game/test.mjs\\n    98 /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/my-3d2dge/dist/handoff/README.md\\n   297 /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/my-3d2dge/dist/handoff/API.md\\n   410 /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/hub/README.md\\n   548 /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/hub/harness.html\\n  1395 total\\n\",\"exit_code\":0,\"command\":\"DEV=\\\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916\\\"\\nH=\\\"$DEV/vendor/my-3d2dge/dist/handoff\\\"\\nls -la \\\"$H\\\" | head -40\\necho \\\"==== sizes ====\\\"\\nwc -c \\\"$H\\\"/my-3d2dge.js \\\"$H\\\"/README.md \\\"$H\\\"/API.md \\\"$H\\\"/game/test.mjs \\\"$DEV/vendor/hub/README.md\\\" \\\"$DEV/vendor/hub/session.js\\\" \\\"$DEV/vendor/hub/harness.html\\\" 2>/dev/null\\necho \\\"==== version ====\\\"\\nhead -30 \\\"$H/package.json\\\"\\necho \\\"==== hub version ====\\\"\\nhead -40 \\\"$DEV/vendor/hub/README.md\\\"\\necho \\\"==== forbidden in engine ====\\\"\\nrg -l -i \\\"TODO|FIXME|placeholder|stub\\\" \\\"$H/my-3d2dge.js\\\" | head\\nrg -c -i \\\"TODO|FIXME|placeholder|\\\\bstub\\\" \\\"$H/my-3d2dge.js\\\" | head\\necho \\\"==== test.mjs head ====\\\"\\nwc -l \\\"$H/game/test.mjs\\\" \\\"$H/README.md\\\" \\\"$H/API.md\\\" \\\"$DEV/vendor/hub/README.md\\\" \\\"$DEV/vendor/hub/harness.html\\\"\",\"truncated\":false,\"signal\":null,\"timed_out\":false,\"description\":\"Locate engine, test harness, and Hub docs\",\"current_dir\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work\",\"output_file\":\"/home/micha/.grok/sessions/%2Fhome%2Fmicha%2Fdev%2Fcc-matrix%2Fruns%2Fgrok-xhigh.build-v2__20261104-223916__x488eb9%2Fwork/01a1aa37-f7cf-7001-9198-38ad04ed0f5e/terminal/call-1e4a9160-367c-4bff-8e07-726a63117b0b-11.log\",\"total_bytes\":5999}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"d9173da7-9c48-4232-93ca-bd30b57ff04a"}
{"type":"assistant","message":{"id":"msg_13","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"The engine version is 0.89.1, not 0.","signature":""},{"type":"tool_use","id":"call-585a106d-639f-424f-9e86-9db43f7d7288-12","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/my-3d2dge/dist/handoff/game/test.mjs"}},{"type":"tool_use","id":"call-585a106d-639f-424f-9e86-9db43f7d7288-13","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/my-3d2dge/dist/handoff/README.md"}},{"type":"tool_use","id":"call-585a106d-639f-424f-9e86-9db43f7d7288-14","name":"grep","input":{"pattern":"TODO|FIXME|placeholder|stub","path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/my-3d2dge/dist/handoff/my-3d2dge.js"}},{"type":"tool_use","id":"call-585a106d-639f-424f-9e86-9db43f7d7288-15","name":"grep","input":{"pattern":"_needSync|Controller or keyboard|touch:","path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/my-3d2dge/dist/handoff/my-3d2dge.js"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":2869,"output_tokens":553,"cache_read_input_tokens":91776,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"808aec08-6fd2-4cdf-b651-6a2ffd289613"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-585a106d-639f-424f-9e86-9db43f7d7288-12","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→// A headless test of the template game: the engine and game.js run in Node with no screen (new E.Game is headless where\\n// there is no DOM), driven by fixed steps (game.advance) and scripted input (input.tap, input.hold), and read through\\n// game.debug.snapshot(). Run it: node game/test.mjs (exit code 1 on a failure). Write one like it for your game.\\nimport vm from 'node:vm';\\nimport { readFileSync } from 'node:fs';\\n\\nconst ctx = { console };\\nvm.createContext(ctx);\\nfor (const f of ['../my-3d2dge.js', './game.js']) vm.runInContext(readFileSync(new URL(f, import.meta.url), 'utf8'), ctx, { filename: f });\\n10→const E = ctx.My3D2dge, game = E.current, I = game.input, snap = () => game.debug.snapshot();\\nlet failed = 0;\\nconst check = (what, ok, detail = '') => { console.log((ok ? 'ok   ' : 'FAIL ') + what + (ok ? '' : ': ' + detail)); if (!ok) failed++; };\\n\\ngame.advance(.5);\\ncheck('the title waits for start', snap().scene === 'title', JSON.stringify(snap()));\\nI.tap('start'); game.advance(.5);\\ncheck('start begins play', snap().scene === 'play', JSON.stringify(snap()));\\n\\n// climb: stand facing the roof's west wall (cells 7-9 of rows 4-6: x 112-160, y 64-112), press jump to take hold, then\\n20→// climb with up (up the screen is up the wall) until it pulls up onto the top\\ngame.debug.teleport(100, 88, 0, 0);\\nI.tap('jump'); game.advance(.1);\\ncheck('jump next to a wall takes hold of it', snap().climbing, JSON.stringify(snap()));\\nI.hold('up'); game.advance(.6); I.hold('up', false); game.advance(1);\\ncheck('climbing up pulls up onto the roof', !snap().climbing && snap().hero[2] === 32, JSON.stringify(snap()));\\n\\n// take the gem (on the roof's middle cell), then hop down into the street with it\\ngame.debug.teleport(136, 88, 32, 0); game.advance(.1);\\ncheck('walking onto the gem takes it', snap().got, JSON.stringify(snap()));\\n30→game.debug.teleport(156, 120, 32, Math.PI / 2); I.hold('down'); game.advance(1.5); I.hold('down', false); game.advance(.5);\\ncheck('back in the street with the gem wins', snap().scene === 'end' && snap().won, JSON.stringify(snap()));\\n\\n// get seen: stand in front of the guard, in the open, until its alert fills\\nI.tap('start'); game.advance(.5);\\nconst [gx, gy, gf] = snap().guard;\\ngame.debug.teleport(gx + Math.cos(gf) * 40, gy + Math.sin(gf) * 40, 0, gf + Math.PI);\\ngame.advance(2.5);\\ncheck('the guard catches a hero it sees', snap().scene === 'end' && !snap().won, JSON.stringify(snap()));\\ncheck('no errors', !game.errors.length, game.errors.map(e => e.message).join(' | '));\\n40→\\nconsole.log(failed ? `${failed} check(s) failed` : 'all checks passed');\\nprocess.exit(failed ? 1 : 0);\\n\",\"content_concise\":\"1→// A headless test of the template game: the engine and game.js run in Node with no screen (new E.Game is headless where\\n// there is no DOM), driven by fixed steps (game.advance) and scripted input (input.tap, input.hold), and read through\\n// game.debug.snapshot(). Run it: node game/test.mjs (exit code 1 on a failure). Write one like it for your game.\\nimport vm from 'node:vm';\\nimport { readFileSync } from 'node:fs';\\n\\nconst ctx = { console };\\nvm.createContext(ctx);\\nfor (const f of ['../my-3d2dge.js', './game.js']) vm.runInContext(readFileSync(new URL(f, import.meta.url), 'utf8'), ctx, { filename: f });\\n10→const E = ctx.My3D2dge, game = E.current, I = game.input, snap = () => game.debug.snapshot();\\nlet failed = 0;\\nconst check = (what, ok, detail = '') => { console.log((ok ? 'ok   ' : 'FAIL ') + what + (ok ? '' : ': ' + detail)); if (!ok) failed++; };\\n\\ngame.advance(.5);\\ncheck('the title waits for start', snap().scene === 'title', JSON.stringify(snap()));\\nI.tap('start'); game.advance(.5);\\ncheck('start begins play', snap().scene === 'play', JSON.stringify(snap()));\\n\\n// climb: stand facing the roof's west wall (cells 7-9 of rows 4-6: x 112-160, y 64-112), press jump to take hold, then\\n20→// climb with up (up the screen is up the wall) until it pulls up onto the top\\ngame.debug.teleport(100, 88, 0, 0);\\nI.tap('jump'); game.advance(.1);\\ncheck('jump next to a wall takes hold of it', snap().climbing, JSON.stringify(snap()));\\nI.hold('up'); game.advance(.6); I.hold('up', false); game.advance(1);\\ncheck('climbing up pulls up onto the roof', !snap().climbing && snap().hero[2] === 32, JSON.stringify(snap()));\\n\\n// take the gem (on the roof's middle cell), then hop down into the street with it\\ngame.debug.teleport(136, 88, 32, 0); game.advance(.1);\\ncheck('walking onto the gem takes it', snap().got, JSON.stringify(snap()));\\n30→game.debug.teleport(156, 120, 32, Math.PI / 2); I.hold('down'); game.advance(1.5); I.hold('down', false); game.advance(.5);\\ncheck('back in the street with the gem wins', snap().scene === 'end' && snap().won, JSON.stringify(snap()));\\n\\n// get seen: stand in front of the guard, in the open, until its alert fills\\nI.tap('start'); game.advance(.5);\\nconst [gx, gy, gf] = snap().guard;\\ngame.debug.teleport(gx + Math.cos(gf) * 40, gy + Math.sin(gf) * 40, 0, gf + Math.PI);\\ngame.advance(2.5);\\ncheck('the guard catches a hero it sees', snap().scene === 'end' && !snap().won, JSON.stringify(snap()));\\ncheck('no errors', !game.errors.length, game.errors.map(e => e.message).join(' | '));\\n40→\\nconsole.log(failed ? `${failed} check(s) failed` : 'all checks passed');\\nprocess.exit(failed ? 1 : 0);\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/my-3d2dge/dist/handoff/game/test.mjs\",\"offset\":null,\"raw_output\":\"// A headless test of the template game: the engine and game.js run in Node with no screen (new E.Game is headless where\\n// there is no DOM), driven by fixed steps (game.advance) and scripted input (input.tap, input.hold), and read through\\n// game.debug.snapshot(). Run it: node game/test.mjs (exit code 1 on a failure). Write one like it for your game.\\nimport vm from 'node:vm';\\nimport { readFileSync } from 'node:fs';\\n\\nconst ctx = { console };\\nvm.createContext(ctx);\\nfor (const f of ['../my-3d2dge.js', './game.js']) vm.runInContext(readFileSync(new URL(f, import.meta.url), 'utf8'), ctx, { filename: f });\\nconst E = ctx.My3D2dge, game = E.current, I = game.input, snap = () => game.debug.snapshot();\\nlet failed = 0;\\nconst check = (what, ok, detail = '') => { console.log((ok ? 'ok   ' : 'FAIL ') + what + (ok ? '' : ': ' + detail)); if (!ok) failed++; };\\n\\ngame.advance(.5);\\ncheck('the title waits for start', snap().scene === 'title', JSON.stringify(snap()));\\nI.tap('start'); game.advance(.5);\\ncheck('start begins play', snap().scene === 'play', JSON.stringify(snap()));\\n\\n// climb: stand facing the roof's west wall (cells 7-9 of rows 4-6: x 112-160, y 64-112), press jump to take hold, then\\n// climb with up (up the screen is up the wall) until it pulls up onto the top\\ngame.debug.teleport(100, 88, 0, 0);\\nI.tap('jump'); game.advance(.1);\\ncheck('jump next to a wall takes hold of it', snap().climbing, JSON.stringify(snap()));\\nI.hold('up'); game.advance(.6); I.hold('up', false); game.advance(1);\\ncheck('climbing up pulls up onto the roof', !snap().climbing && snap().hero[2] === 32, JSON.stringify(snap()));\\n\\n// take the gem (on the roof's middle cell), then hop down into the street with it\\ngame.debug.teleport(136, 88, 32, 0); game.advance(.1);\\ncheck('walking onto the gem takes it', snap().got, JSON.stringify(snap()));\\ngame.debug.teleport(156, 120, 32, Math.PI / 2); I.hold('down'); game.advance(1.5); I.hold('down', false); game.advance(.5);\\ncheck('back in the street with the gem wins', snap().scene === 'end' && snap().won, JSON.stringify(snap()));\\n\\n// get seen: stand in front of the guard, in the open, until its alert fills\\nI.tap('start'); game.advance(.5);\\nconst [gx, gy, gf] = snap().guard;\\ngame.debug.teleport(gx + Math.cos(gf) * 40, gy + Math.sin(gf) * 40, 0, gf + Math.PI);\\ngame.advance(2.5);\\ncheck('the guard catches a hero it sees', snap().scene === 'end' && !snap().won, JSON.stringify(snap()));\\ncheck('no errors', !game.errors.length, game.errors.map(e => e.message).join(' | '));\\n\\nconsole.log(failed ? `${failed} check(s) failed` : 'all checks passed');\\nprocess.exit(failed ? 1 : 0);\\n\",\"total_lines\":42}}","is_error":false},{"type":"tool_result","tool_use_id":"call-585a106d-639f-424f-9e86-9db43f7d7288-13","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→# my-3D2dge handoff package (v0.89.1)\\n\\nEverything a coding agent needs to build, run, test and check a game on the full my-3D2dge engine, in one folder of text\\nfiles. You don't need the engine's repository, and you don't need to read the engine's source below its header.\\n\\n**The engine is yours to change.** This copy is yours to fix, extend or rewrite in any way you see fit: `my-3d2dge.js`\\nis the engine, readable, with every module, and every page and test here loads it (`modules/` and `my-3d2dge-agent.js`\\nare separate copies). If you hand the game back, a line on what you changed and why helps: it shows what the engine\\nlacks.\\n10→\\n## Start here\\n\\n1. **Read `API.md`**, the API card: a complete game to start from, what x, y and z mean in each view, the rules, the\\n   common mistakes and the API by area. It is the one page to read whole.\\n2. **Start from a game, not an empty file.** The kit for your genre (`kits/`): the card's Genre playbook names one for\\n   each genre, and `kits/README.md` says which file is which. `kits/<id>.js` is a complete game in that genre, readable\\n   (its title, play and end, the modules it rests on, sound, touch controls), `kits/<id>.html` plays it, and\\n   `node kits/test.mjs <id>` runs it headless. Or the template, `game/`: a small complete game (climbing, a guard with\\n   sight, an HTML HUD, scenes) that `game/index.html` plays and `game/test.mjs` tests without a browser. Copy one into\\n20→   `game/` and make it yours.\\n3. **Search `API-INDEX.md`** when you need a name: every public name in the engine, one line each, with its signature,\\n   units and defaults, and the height rules at the top. `grep -n \\\"ledge\\\\|landing\\\" API-INDEX.md`. Don't read it whole.\\n4. **`AI_GUIDE.md`** has the recipes: genre by genre, the look to aim for, the frame order, heights, recorded sessions.\\n5. **Don't build a pause menu, settings, key rebinding, full screen or a loading screen**: every game has them (`API.md`,\\n   \\\"Standard features\\\"). Adjust them with `new E.Game({ menu: { items, settings, controls, quit } })`; heavy setup goes in\\n   `game.start({ boot: { steps } })`.\\n6. **Objects without drawing code:** read `docs/ASSETS.md` whole before you draw a barrel, a table or a tree.\\n   `r.shape('barrel', x, y, 0, { facing })` draws one of the core library's in every view; `node tools/asset-find.mjs\\n   \\\"market stall\\\"` searches it and the store (`src/assets/sets/`: about a thousand objects, materials and sprites,\\n30→   each with where it came from), and `node tools/asset-sheet.mjs mine.js#stool` draws one you wrote, to look at\\n   before you use it.\\n7. **A game in real 3D** (first person, a light gun, a racer on banked roads, flight, a dungeon crawled in 3D, fixed\\n   cameras): the 2D views have no perspective camera, but the engine has a 3D add-on, `World3D` (three.js r182 and\\n   Rapier 0.19.3 under the 2D engine, which keeps the HUD, menus and sound). It is not in this folder: take\\n   `engine/my-3d2dge-3d.js` (its header is its manual), `vendor/` and the 3D kit closest to your game\\n   (`src/starter3d/`) from the repository, github.com/michaelcrosato/my-3d2dge, and see them play at\\n   my-3d2dge.vercel.app/3d.\\n\\n## What is here\\n40→\\n| File | What it is |\\n| --- | --- |\\n| `my-3d2dge.js` | the full engine, readable (one file, no dependencies): the core, then every module |\\n| `modules/` | each engine module on its own, when there are any (one general system; its header is its manual), to load after the agent edition |\\n| `my-3d2dge-agent.js` | the agent edition: the essential engine, whose header is a shorter manual (a game written for it runs on the full engine) |\\n| `API.md`, `API-INDEX.md`, `AI_GUIDE.md` | the card, the index, the guide |\\n| `kits/` | the 2D genre kits, readable: each kit's game (`<id>.js`) and the page that plays it (`<id>.html`), the table of them (`README.md`) and their headless test (`test.mjs`) |\\n| `game/` | the template game: `index.html`, `game.js`, `test.mjs` |\\n| `tools/check.mjs` | plays a game in headless Chromium, switches its views, and reports errors, what is on screen, and `game.debug.snapshot()` |\\n50→| `tools/filmstrip.mjs` | records frames into one picture, to judge motion (`--seed 1` makes it repeatable, `--compare` marks what changed) |\\n| `tools/replay.mjs` | replays a recorded play session exactly (`E.session`, a bug seen on a phone) |\\n| `docs/ASSETS.md` | the asset card: still objects and materials as data (`r.shape`, `map.solid`, `E.MATERIALS`), the core library, writing one |\\n| `tools/asset-find.mjs`, `asset-sheet.mjs`, `asset-set.mjs` | search the core library and the store; draw an object in every view and lint it; cut the few entries a game uses into a set of its own (`asset-lib.mjs` is theirs) |\\n| `src/assets/` | the asset store: sets of objects and materials converted from CC0 libraries (Kenney, KayKit, ambientCG), with their catalogs. A game loads one with its script and `E.addAssets(window.ASSETS['kenney-furniture'])`; the Asset Lab shows them all at my-3d2dge.vercel.app/asset-lab |\\n| `package.json` | pins Playwright for the tools |\\n\\nNot here: the 3D engine (three.js and Rapier) and its kits, the playbook's 3D rows. They are on the site\\n(my-3d2dge.vercel.app/3d) and in the repository (github.com/michaelcrosato/my-3d2dge); here a 3D game is built on the 2D\\nengine's views (`kits/README.md`, 3D).\\n60→\\n## Run, test, check\\n\\n```sh\\nnpm install                          # Playwright, for the tools (once)\\nnpx playwright install chromium      # its browser (once)\\nnode game/test.mjs                   # the game's headless test: no browser, a second\\nnode tools/check.mjs game/index.html # play it in a browser: errors, screenshots, its snapshot\\nnode kits/test.mjs arcade            # a kit, headless: it plays, and its proof gives the same hash twice\\nnode tools/check.mjs kits/arcade.html#arcade/maze   # a kit in a browser, at a part (its deep link)\\n70→node tools/filmstrip.mjs game/index.html --steps \\\"wait:800 press:Enter wait:500 rec:16:2 down:KeyD wait:600\\\" --seed 1\\n```\\n\\nOpen `game/index.html` in a browser to play (or serve the folder: `npx serve`). To hand a single file to a person, inline\\nthe two scripts into the page, writing every `</script` inside them as `<\\\\/script` (the agent edition's header has one,\\nand the page would end there).\\n\\n## Testing a game without a browser\\n\\n`new E.Game()` is headless in Node (or with `{ headless: true }`): no screen, sound or DOM, and `draw` is skipped unless\\n80→the game is made with `draw: true` (the template is): then each `advance` draws a frame on a stand-in, and a draw error\\nlands in `game.errors`, as it would on a player's screen.\\n\\n- `game.advance(seconds)` runs exact fixed steps of 1/120 s at once: `advance(1)` is 120 updates.\\n- `game.input.tap('jump')` presses an action for one step, `hold('right')` holds one down, `hold('right', false)` lets go.\\n- `game.debug = { snapshot() { return {...} }, teleport(x, y, z) {...} }` is your game's handle: tests read it, and\\n  `tools/check.mjs` and `tools/replay.mjs` print it.\\n- `game.stop()`, `game.start()` and `game.dispose()` stop, resume and end a game.\\n- `game.go('play')` fades for `game.fadeTime` (.22 s) before the new scene enters: advance past it, or set\\n  `game.fadeTime = 0` in a test.\\n90→- A scene change clears `game.after` and `game.every` timers (`{ keep: true }` outlives it); those made before the first\\n  scene live into it. It ends a hit-stop; `game.timeScale` stays (restore a slow motion with a kept timer). A boot step's `game.go(name)` enters that scene when the boot ends.\\n- Draw changes nothing, and nothing your update or input relies on (a click target, what is on screen) may be made only\\n  in `draw`: `E.Menu`'s rows come from its update (`menu.rowAt(i)` is entry i's box, for a test's click), and the camera\\n  (`game.cam`) says where the screen is in update.\\n- `E.store` keeps values for the visit in Node, which has no `localStorage` (`E.store.clear()` between games in one test).\\n- A script's `tap` and `hold` are no device: `input.label()` keeps showing the keys or buttons the player used last.\\n\\nThe same inputs give the same game on every machine and at every refresh rate: the clock is an exact fixed step.\\n\",\"content_concise\":\"1→# my-3D2dge handoff package (v0.89.1)\\n\\nEverything a coding agent needs to build, run, test and check a game on the full my-3D2dge engine, in one folder of text\\nfiles. You don't need the engine's repository, and you don't need to read the engine's source below its header.\\n\\n**The engine is yours to change.** This copy is yours to fix, extend or rewrite in any way you see fit: `my-3d2dge.js`\\nis the engine, readable, with every module, and every page and test here loads it (`modules/` and `my-3d2dge-agent.js`\\nare separate copies). If you hand the game back, a line on what you changed and why helps: it shows what the engine\\nlacks.\\n10→\\n## Start here\\n\\n1. **Read `API.md`**, the API card: a complete game to start from, what x, y and z mean in each view, the rules, the\\n   common mistakes and the API by area. It is the one page to read whole.\\n2. **Start from a game, not an empty file.** The kit for your genre (`kits/`): the card's Genre playbook names one for\\n   each genre, and `kits/README.md` says which file is which. `kits/<id>.js` is a complete game in that genre, readable\\n   (its title, play and end, the modules it rests on, sound, touch controls), `kits/<id>.html` plays it, and\\n   `node kits/test.mjs <id>` runs it headless. Or the template, `game/`: a small complete game (climbing, a guard with\\n   sight, an HTML HUD, scenes) that `game/index.html` plays and `game/test.mjs` tests without a browser. Copy one into\\n20→   `game/` and make it yours.\\n3. **Search `API-INDEX.md`** when you need a name: every public name in the engine, one line each, with its signature,\\n   units and defaults, and the height rules at the top. `grep -n \\\"ledge\\\\|landing\\\" API-INDEX.md`. Don't read it whole.\\n4. **`AI_GUIDE.md`** has the recipes: genre by genre, the look to aim for, the frame order, heights, recorded sessions.\\n5. **Don't build a pause menu, settings, key rebinding, full screen or a loading screen**: every game has them (`API.md`,\\n   \\\"Standard features\\\"). Adjust them with `new E.Game({ menu: { items, settings, controls, quit } })`; heavy setup goes in\\n   `game.start({ boot: { steps } })`.\\n6. **Objects without drawing code:** read `docs/ASSETS.md` whole before you draw a barrel, a table or a tree.\\n   `r.shape('barrel', x, y, 0, { facing })` draws one of the core library's in every view; `node tools/asset-find.mjs\\n   \\\"market stall\\\"` searches it and the store (`src/assets/sets/`: about a thousand objects, materials and sprites,\\n30→   each with where it came from), and `node tools/asset-sheet.mjs mine.js#stool` draws one you wrote, to look at\\n   before you use it.\\n7. **A game in real 3D** (first person, a light gun, a racer on banked roads, flight, a dungeon crawled in 3D, fixed\\n   cameras): the 2D views have no perspective camera, but the engine has a 3D add-on, `World3D` (three.js r182 and\\n   Rapier 0.19.3 under the 2D engine, which keeps the HUD, menus and sound). It is not in this folder: take\\n   `engine/my-3d2dge-3d.js` (its header is its manual), `vendor/` and the 3D kit closest to your game\\n   (`src/starter3d/`) from the repository, github.com/michaelcrosato/my-3d2dge, and see them play at\\n   my-3d2dge.vercel.app/3d.\\n\\n## What is here\\n40→\\n| File | What it is |\\n| --- | --- |\\n| `my-3d2dge.js` | the full engine, readable (one file, no dependencies): the core, then every module |\\n| `modules/` | each engine module on its own, when there are any (one general system; its header is its manual), to load after the agent edition |\\n| `my-3d2dge-agent.js` | the agent edition: the essential engine, whose header is a shorter manual (a game written for it runs on the full engine) |\\n| `API.md`, `API-INDEX.md`, `AI_GUIDE.md` | the card, the index, the guide |\\n| `kits/` | the 2D genre kits, readable: each kit's game (`<id>.js`) and the page that plays it (`<id>.html`), the table of them (`README.md`) and their headless test (`test.mjs`) |\\n| `game/` | the template game: `index.html`, `game.js`, `test.mjs` |\\n| `tools/check.mjs` | plays a game in headless Chromium, switches its views, and reports errors, what is on screen, and `game.debug.snapshot()` |\\n50→| `tools/filmstrip.mjs` | records frames into one picture, to judge motion (`--seed 1` makes it repeatable, `--compare` marks what changed) |\\n| `tools/replay.mjs` | replays a recorded play session exactly (`E.session`, a bug seen on a phone) |\\n| `docs/ASSETS.md` | the asset card: still objects and materials as data (`r.shape`, `map.solid`, `E.MATERIALS`), the core library, writing one |\\n| `tools/asset-find.mjs`, `asset-sheet.mjs`, `asset-set.mjs` | search the core library and the store; draw an object in every view and lint it; cut the few entries a game uses into a set of its own (`asset-lib.mjs` is theirs) |\\n| `src/assets/` | the asset store: sets of objects and materials converted from CC0 libraries (Kenney, KayKit, ambientCG), with their catalogs. A game loads one with its script and `E.addAssets(window.ASSETS['kenney-furniture'])`; the Asset Lab shows them all at my-3d2dge.vercel.app/asset-lab |\\n| `package.json` | pins Playwright for the tools |\\n\\nNot here: the 3D engine (three.js and Rapier) and its kits, the playbook's 3D rows. They are on the site\\n(my-3d2dge.vercel.app/3d) and in the repository (github.com/michaelcrosato/my-3d2dge); here a 3D game is built on the 2D\\nengine's views (`kits/README.md`, 3D).\\n60→\\n## Run, test, check\\n\\n```sh\\nnpm install                          # Playwright, for the tools (once)\\nnpx playwright install chromium      # its browser (once)\\nnode game/test.mjs                   # the game's headless test: no browser, a second\\nnode tools/check.mjs game/index.html # play it in a browser: errors, screenshots, its snapshot\\nnode kits/test.mjs arcade            # a kit, headless: it plays, and its proof gives the same hash twice\\nnode tools/check.mjs kits/arcade.html#arcade/maze   # a kit in a browser, at a part (its deep link)\\n70→node tools/filmstrip.mjs game/index.html --steps \\\"wait:800 press:Enter wait:500 rec:16:2 down:KeyD wait:600\\\" --seed 1\\n```\\n\\nOpen `game/index.html` in a browser to play (or serve the folder: `npx serve`). To hand a single file to a person, inline\\nthe two scripts into the page, writing every `</script` inside them as `<\\\\/script` (the agent edition's header has one,\\nand the page would end there).\\n\\n## Testing a game without a browser\\n\\n`new E.Game()` is headless in Node (or with `{ headless: true }`): no screen, sound or DOM, and `draw` is skipped unless\\n80→the game is made with `draw: true` (the template is): then each `advance` draws a frame on a stand-in, and a draw error\\nlands in `game.errors`, as it would on a player's screen.\\n\\n- `game.advance(seconds)` runs exact fixed steps of 1/120 s at once: `advance(1)` is 120 updates.\\n- `game.input.tap('jump')` presses an action for one step, `hold('right')` holds one down, `hold('right', false)` lets go.\\n- `game.debug = { snapshot() { return {...} }, teleport(x, y, z) {...} }` is your game's handle: tests read it, and\\n  `tools/check.mjs` and `tools/replay.mjs` print it.\\n- `game.stop()`, `game.start()` and `game.dispose()` stop, resume and end a game.\\n- `game.go('play')` fades for `game.fadeTime` (.22 s) before the new scene enters: advance past it, or set\\n  `game.fadeTime = 0` in a test.\\n90→- A scene change clears `game.after` and `game.every` timers (`{ keep: true }` outlives it); those made before the first\\n  scene live into it. It ends a hit-stop; `game.timeScale` stays (restore a slow motion with a kept timer). A boot step's `game.go(name)` enters that scene when the boot ends.\\n- Draw changes nothing, and nothing your update or input relies on (a click target, what is on screen) may be made only\\n  in `draw`: `E.Menu`'s rows come from its update (`menu.rowAt(i)` is entry i's box, for a test's click), and the camera\\n  (`game.cam`) says where the screen is in update.\\n- `E.store` keeps values for the visit in Node, which has no `localStorage` (`E.store.clear()` between games in one test).\\n- A script's `tap` and `hold` are no device: `input.label()` keeps showing the keys or buttons the player used last.\\n\\nThe same inputs give the same game on every machine and at every refresh rate: the clock is an exact fixed step.\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/my-3d2dge/dist/handoff/README.md\",\"offset\":null,\"raw_output\":\"# my-3D2dge handoff package (v0.89.1)\\n\\nEverything a coding agent needs to build, run, test and check a game on the full my-3D2dge engine, in one folder of text\\nfiles. You don't need the engine's repository, and you don't need to read the engine's source below its header.\\n\\n**The engine is yours to change.** This copy is yours to fix, extend or rewrite in any way you see fit: `my-3d2dge.js`\\nis the engine, readable, with every module, and every page and test here loads it (`modules/` and `my-3d2dge-agent.js`\\nare separate copies). If you hand the game back, a line on what you changed and why helps: it shows what the engine\\nlacks.\\n\\n## Start here\\n\\n1. **Read `API.md`**, the API card: a complete game to start from, what x, y and z mean in each view, the rules, the\\n   common mistakes and the API by area. It is the one page to read whole.\\n2. **Start from a game, not an empty file.** The kit for your genre (`kits/`): the card's Genre playbook names one for\\n   each genre, and `kits/README.md` says which file is which. `kits/<id>.js` is a complete game in that genre, readable\\n   (its title, play and end, the modules it rests on, sound, touch controls), `kits/<id>.html` plays it, and\\n   `node kits/test.mjs <id>` runs it headless. Or the template, `game/`: a small complete game (climbing, a guard with\\n   sight, an HTML HUD, scenes) that `game/index.html` plays and `game/test.mjs` tests without a browser. Copy one into\\n   `game/` and make it yours.\\n3. **Search `API-INDEX.md`** when you need a name: every public name in the engine, one line each, with its signature,\\n   units and defaults, and the height rules at the top. `grep -n \\\"ledge\\\\|landing\\\" API-INDEX.md`. Don't read it whole.\\n4. **`AI_GUIDE.md`** has the recipes: genre by genre, the look to aim for, the frame order, heights, recorded sessions.\\n5. **Don't build a pause menu, settings, key rebinding, full screen or a loading screen**: every game has them (`API.md`,\\n   \\\"Standard features\\\"). Adjust them with `new E.Game({ menu: { items, settings, controls, quit } })`; heavy setup goes in\\n   `game.start({ boot: { steps } })`.\\n6. **Objects without drawing code:** read `docs/ASSETS.md` whole before you draw a barrel, a table or a tree.\\n   `r.shape('barrel', x, y, 0, { facing })` draws one of the core library's in every view; `node tools/asset-find.mjs\\n   \\\"market stall\\\"` searches it and the store (`src/assets/sets/`: about a thousand objects, materials and sprites,\\n   each with where it came from), and `node tools/asset-sheet.mjs mine.js#stool` draws one you wrote, to look at\\n   before you use it.\\n7. **A game in real 3D** (first person, a light gun, a racer on banked roads, flight, a dungeon crawled in 3D, fixed\\n   cameras): the 2D views have no perspective camera, but the engine has a 3D add-on, `World3D` (three.js r182 and\\n   Rapier 0.19.3 under the 2D engine, which keeps the HUD, menus and sound). It is not in this folder: take\\n   `engine/my-3d2dge-3d.js` (its header is its manual), `vendor/` and the 3D kit closest to your game\\n   (`src/starter3d/`) from the repository, github.com/michaelcrosato/my-3d2dge, and see them play at\\n   my-3d2dge.vercel.app/3d.\\n\\n## What is here\\n\\n| File | What it is |\\n| --- | --- |\\n| `my-3d2dge.js` | the full engine, readable (one file, no dependencies): the core, then every module |\\n| `modules/` | each engine module on its own, when there are any (one general system; its header is its manual), to load after the agent edition |\\n| `my-3d2dge-agent.js` | the agent edition: the essential engine, whose header is a shorter manual (a game written for it runs on the full engine) |\\n| `API.md`, `API-INDEX.md`, `AI_GUIDE.md` | the card, the index, the guide |\\n| `kits/` | the 2D genre kits, readable: each kit's game (`<id>.js`) and the page that plays it (`<id>.html`), the table of them (`README.md`) and their headless test (`test.mjs`) |\\n| `game/` | the template game: `index.html`, `game.js`, `test.mjs` |\\n| `tools/check.mjs` | plays a game in headless Chromium, switches its views, and reports errors, what is on screen, and `game.debug.snapshot()` |\\n| `tools/filmstrip.mjs` | records frames into one picture, to judge motion (`--seed 1` makes it repeatable, `--compare` marks what changed) |\\n| `tools/replay.mjs` | replays a recorded play session exactly (`E.session`, a bug seen on a phone) |\\n| `docs/ASSETS.md` | the asset card: still objects and materials as data (`r.shape`, `map.solid`, `E.MATERIALS`), the core library, writing one |\\n| `tools/asset-find.mjs`, `asset-sheet.mjs`, `asset-set.mjs` | search the core library and the store; draw an object in every view and lint it; cut the few entries a game uses into a set of its own (`asset-lib.mjs` is theirs) |\\n| `src/assets/` | the asset store: sets of objects and materials converted from CC0 libraries (Kenney, KayKit, ambientCG), with their catalogs. A game loads one with its script and `E.addAssets(window.ASSETS['kenney-furniture'])`; the Asset Lab shows them all at my-3d2dge.vercel.app/asset-lab |\\n| `package.json` | pins Playwright for the tools |\\n\\nNot here: the 3D engine (three.js and Rapier) and its kits, the playbook's 3D rows. They are on the site\\n(my-3d2dge.vercel.app/3d) and in the repository (github.com/michaelcrosato/my-3d2dge); here a 3D game is built on the 2D\\nengine's views (`kits/README.md`, 3D).\\n\\n## Run, test, check\\n\\n```sh\\nnpm install                          # Playwright, for the tools (once)\\nnpx playwright install chromium      # its browser (once)\\nnode game/test.mjs                   # the game's headless test: no browser, a second\\nnode tools/check.mjs game/index.html # play it in a browser: errors, screenshots, its snapshot\\nnode kits/test.mjs arcade            # a kit, headless: it plays, and its proof gives the same hash twice\\nnode tools/check.mjs kits/arcade.html#arcade/maze   # a kit in a browser, at a part (its deep link)\\nnode tools/filmstrip.mjs game/index.html --steps \\\"wait:800 press:Enter wait:500 rec:16:2 down:KeyD wait:600\\\" --seed 1\\n```\\n\\nOpen `game/index.html` in a browser to play (or serve the folder: `npx serve`). To hand a single file to a person, inline\\nthe two scripts into the page, writing every `</script` inside them as `<\\\\/script` (the agent edition's header has one,\\nand the page would end there).\\n\\n## Testing a game without a browser\\n\\n`new E.Game()` is headless in Node (or with `{ headless: true }`): no screen, sound or DOM, and `draw` is skipped unless\\nthe game is made with `draw: true` (the template is): then each `advance` draws a frame on a stand-in, and a draw error\\nlands in `game.errors`, as it would on a player's screen.\\n\\n- `game.advance(seconds)` runs exact fixed steps of 1/120 s at once: `advance(1)` is 120 updates.\\n- `game.input.tap('jump')` presses an action for one step, `hold('right')` holds one down, `hold('right', false)` lets go.\\n- `game.debug = { snapshot() { return {...} }, teleport(x, y, z) {...} }` is your game's handle: tests read it, and\\n  `tools/check.mjs` and `tools/replay.mjs` print it.\\n- `game.stop()`, `game.start()` and `game.dispose()` stop, resume and end a game.\\n- `game.go('play')` fades for `game.fadeTime` (.22 s) before the new scene enters: advance past it, or set\\n  `game.fadeTime = 0` in a test.\\n- A scene change clears `game.after` and `game.every` timers (`{ keep: true }` outlives it); those made before the first\\n  scene live into it. It ends a hit-stop; `game.timeScale` stays (restore a slow motion with a kept timer). A boot step's `game.go(name)` enters that scene when the boot ends.\\n- Draw changes nothing, and nothing your update or input relies on (a click target, what is on screen) may be made only\\n  in `draw`: `E.Menu`'s rows come from its update (`menu.rowAt(i)` is entry i's box, for a test's click), and the camera\\n  (`game.cam`) says where the screen is in update.\\n- `E.store` keeps values for the visit in Node, which has no `localStorage` (`E.store.clear()` between games in one test).\\n- A script's `tap` and `hold` are no device: `input.label()` keeps showing the keys or buttons the player used last.\\n\\nThe same inputs give the same game on every machine and at every refresh rate: the clock is an exact fixed step.\\n\",\"total_lines\":98}}","is_error":false},{"type":"tool_result","tool_use_id":"call-585a106d-639f-424f-9e86-9db43f7d7288-14","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,51,57,49,54,95,95,120,52,56,56,101,98,57,47,119,111,114,107,34,62,10,70,111,117,110,100,32,49,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,50,51,57,49,54,95,95,120,52,56,56,101,98,57,47,119,111,114,107,47,79,112,101,110,45,84,97,98,108,101,45,83,101,99,111,110,100,45,79,112,105,110,105,111,110,45,84,114,97,117,109,97,45,67,101,110,116,101,114,45,83,101,99,111,110,100,45,79,112,105,110,105,111,110,45,103,114,111,107,45,52,46,55,45,120,104,105,103,104,45,50,48,50,54,49,49,48,52,45,50,50,51,57,49,54,47,118,101,110,100,111,114,47,109,121,45,51,100,50,100,103,101,47,100,105,115,116,47,104,97,110,100,111,102,102,47,109,121,45,51,100,50,100,103,101,46,106,115,10,56,49,58,32,42,32,32,102,114,111,109,44,32,97,32,112,108,97,99,101,104,111,108,100,101,114,32,105,110,32,116,104,101,32,114,101,112,111,32,116,104,97,116,32,116,111,111,108,115,47,115,116,97,109,112,46,109,106,115,32,114,101,112,108,97,99,101,115,32,119,104,101,110,32,116,104,101,32,115,105,116,101,32,100,101,112,108,111,121,115,32,40,101,46,10