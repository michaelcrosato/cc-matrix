evice !== 'keyboard' && Math.hypot(e.clientX - this.mouse.cx, e.clientY - this.mouse.cy) > 3) this.lastDevice = 'mouse'; this.mouse.cx = e.clientX; this.mouse.cy = e.clientY; this.mouse.active = true; this.mouse.t = this.clock; this.aimSource = 'mouse'; this._fedAt = null; } else { this._pinchMove(e); this._stickMove(e); } if (this._g && this._g.id === e.pointerId) this._gesture('move', ...this.screenPoint(e.clientX, e.clientY)); });\"},{\"line_number\":1132,\"content\":\"    else if (type === 'move') { if (!o.touch) { this.mouse.t = this.clock; this.mouse.active = true; } this._gesture('move', x, y); }   // (menus hover by mouse.t, as a real move)\"},{\"line_number\":9123,\"content\":\"    this.open = false; this.pages = []; this.i = 0; this.shown = 0; this.choice = 0;\"},{\"line_number\":9165,\"content\":\"    this.pages = pages.length ? pages : [['']]; this.i = 0; this.shown = 0; this.open = true; this.choice = 0;\"},{\"line_number\":9273,\"content\":\"    this.game = game; this.items = items || []; this.i = 0; this.active = true;\"},{\"line_number\":9285,\"content\":\"  _skip(dir) { for (let k = 0; k < this.items.length && this._off(this.items[this.i]); k++) this.i = (this.i + dir + this.items.length) % this.items.length; }\"},{\"line_number\":9299,\"content\":\"  rowAt(i) { this._layout(); const b = this._box; return i < b.first || i >= b.first + b.vis ? null : [b.x, b.y + (i - b.first) * b.rowH, b.w, b.rowH]; }\"},{\"line_number\":9307,\"content\":\"    if (any(I => I.repeat('up'))) { this.i = (this.i + n - 1) % n; this._skip(-1); }\"},{\"line_number\":9308,\"content\":\"    if (any(I => I.repeat('down'))) { this.i = (this.i + 1) % n; this._skip(1); }\"},{\"line_number\":9309,\"content\":\"    if (inp.mouse.t !== this._mt) { this._mt = inp.mouse.t; const k = row(inp.pointer()); if (k >= 0) this.i = k; }   // the mouse moved over an entry\"},{\"line_number\":9311,\"content\":\"    if (tap >= 0) this.i = tap;\"}]}]}","is_error":false}]},"parent_tool_use_id":null