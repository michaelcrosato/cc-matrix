,98,46,97,99,116,105,118,101,41,32,123,10,49,49,57,58,32,32,105,102,32,40,104,117,98,46,97,99,116,105,118,101,32,38,38,32,115,101,101,100,65,114,103,41,32,123,10,49,50,57,58,32,32,105,102,32,40,104,117,98,46,97,99,116,105,118,101,32,38,38,32,114,111,111,116,46,69,108,101,109,101,110,116,32,38,38,32,114,111,111,116,46,100,111,99,117,109,101,110,116,41,32,123,10,49,53,52,58,32,32,32,32,104,117,98,46,97,99,116,105,118,101,32,61,32,102,97,108,115,101,59,10,49,56,56,58,32,32,118,97,114,32,75,69,69,80,32,61,32,123,32,97,105,104,117,98,58,32,49,44,32,116,121,112,101,58,32,49,44,32,118,101,114,115,105,111,110,58,32,49,44,32,112,114,111,116,111,99,111,108,58,32,49,44,32,97,99,116,105,118,101,58,32,49,44,32,115,101,101,100,101,100,58,32,49,32,125,59,10,50,57,56,58,32,32,32,32,105,102,32,40,33,104,117,98,46,97,99,116,105,118,101,41,32,123,10,52,56,51,58,32,32,32,32,105,102,32,40,33,104,117,98,46,97,99,116,105,118,101,41,32,114,101,116,117,114,110,59,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":9,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/hub/session.js\",\"matches\":[{\"line_number\":27,\"content\":\"    active: !!(flagged && framed),\"},{\"line_number\":36,\"content\":\"    /** True when the hub shows the round's splash and collects every player's ready: call ready() once loaded, with no prompt. */\"},{\"line_number\":105,\"content\":\"  if (hub.active) {\"},{\"line_number\":119,\"content\":\"  if (hub.active && seedArg) {\"},{\"line_number\":129,\"content\":\"  if (hub.active && root.Element && root.document) {\"},{\"line_number\":154,\"content\":\"    hub.active = false;\"},{\"line_number\":188,\"content\":\"  var KEEP = { aihub: 1, type: 1, version: 1, protocol: 1, active: 1, seeded: 1 };\"},{\"line_number\":298,\"content\":\"    if (!hub.a