\\n\\n  const ui = new E.Shell(game, {\\n    tv: true,\\n    theme: {\\n      paper: 'rgba(6,22,26,.94)',\\n      accent: '#5ff0e0',\\n      line: 'rgba(95,240,224,.35)',\\n150→      ink: '#e8fbf6',\\n      muted: '#8fb8b0',\\n      danger: '#ff7a6a',\\n    },\\n  });\\n\\n  GAME.openDev = () => {\\n    if (inSession) return;\\n    RT.devOpen = true;\\n    RT.devTab = 0;\\n160→    RT.devI = 0;\\n    if (game.shell) game.shell.hide();\\n  };\\n\\n  function origin() {\\n    return [(game.W - CFG.FIELD_W) >> 1, (game.H - CFG.FIELD_H) >> 1];\\n  }\\n  function playTune() {\\n    const t = CFG.cloneTune(GAME.TUNE);\\n    t.hands.assist = PREFS.assist;\\n170→    t.hands.cursor = PREFS.cursor;\\n    return t;\\n  }\\n  function makeMenu(items, onPick, onCancel) {\\n    return new E.Menu(game, items, {\\n      scale: 2, rows: 6,\\n      color: '#e8fbf6', pick: '#5ff0e0', dim: '#8fb8b0',\\n      bg: '#06141a', border: '#5ff0e0',\\n      onPick, onCancel,\\n    });\\n180→  }\\n  function go(name, data) {\\n    game.go(name, data, { fade: game.fadeTime });\\n  }\\n\\n  const people = {};\\n  for (const id in GAME.CAST) {\\n    const c = GAME.CAST[id];\\n    people[id] = {\\n      name: c.name,\",\"content_concise\":\"140→    },\\n  });\\n  game.input.names = CONTROLS;\\n\\n  const ui = new E.Shell(game, {\\n    tv: true,\\n    theme: {\\n      paper: 'rgba(6,22,26,.94)',\\n      accent: '#5ff0e0',\\n      line: 'rgba(95,240,224,.35)',\\n150→      ink: '#e8fbf6',\\n      muted: '#8fb8b0',\\n      danger: '#ff7a6a',\\n    },\\n  });\\n\\n  GAME.openDev = () => {\\n    if (inSession) return;\\n    RT.devOpen = true;\\n    RT.devTab = 0;\\n160→    RT.devI = 0;\\n    if (game.shell) game.shell.hide();\\n  };\\n\\n  function origin() {\\n    return [(game.W - CFG.FIELD_W) >> 1, (game.H - CFG.FIELD_H) >> 1];\\n  }\\n  function playTune() {\\n    const t = CFG.cloneTune(GAME.TUNE);\\n    t.hands.assist = PREFS.assist;\\n170→    t.hands.cursor = PREFS.cursor;\\n    return t;\\n  }\\n 