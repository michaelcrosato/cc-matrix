der-radius: 8px; overflow: hidden; background: #000; }\"},{\"line_number\":26,\"content\":\"  .cell__state { margin-left: auto; color: var(--dim); }\"},{\"line_number\":29,\"content\":\"  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\"},{\"line_number\":37,\"content\":\"  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\"},{\"line_number\":46,\"content\":\"  <label>Players <select id=\\\"players\\\"><option>1</option><option selected>2</option><option>3</option><option>4</option></select></label>\"},{\"line_number\":61,\"content\":\"    <section id=\\\"checks\\\"><h2>Conformance</h2><ul id=\\\"checklist\\\"><li class=\\\"hint\\\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\"},{\"line_number\":72,\"content\":\"const auto = params.get('auto') === '1';\"},{\"line_number\":73,\"content\":\"const scenario = params.get('scenario') || 'standard';\"},{\"line_number\":74,\"content\":\"/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\"},{\"line_number\":75,\"content\":\"const serverMode = scenario === 'server';\"},{\"line_number\":79,\"content\":\"for (const [id, key] of [['game', 'game'], ['players', 'players'], ['latency', 'latency'], ['jitter', 'jitter'], ['loss', 'loss']]) {\"},{\"line_number\":103,\"content\":\"      players: meta('hub:session-players'),\"},{\"line_number\":167,\"content\":\"  const n = Math.max(1, Math.min(4, Number($('players').value) || 2));\"},{\"line_number\":173,\"content\":\"  const players = Array.from({ length: n }, (_, slot) => ({ key: `p${slot}`, slot, name: NAMES[slot] }));\"},{\"line_number\":181,\"content\":\"  const state = { round, n, metas, mode, limitMs, seed, players, cells: [], hubEnd, status: null, record: null, hidden: false, splashUntil: performance.now() + SPLASH_MS, answers: { ready: new Set(), more: new Set() } };\"},{\"line_number\":187,\"content\":\"    players,\"},{\"line_number\":208,\"content\":\"  for (const p of [...players, ...(serverMode ? [{ key: 'server', slot: null, name: 'Server', server: true }] : [])]) {\"},{\"line_number\":211,\"content\":\"    frame.allow = 'fullscreen; autoplay; gamepad; pointer-lock';\"},{\"line_number\":258,\"content\":\"    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\"},{\"line_number\":301,\"content\":\"  const players = state.cells.filter((c) => !c.server && !c.gone);\"},{\"line_number\":302,\"content\":\"  if (!auto && players.every((c) => ready.has(c.key))) return releaseRound(state);\"},{\"line_number\":335,\"content\":\"    const p = s.players.find((q) => q.key === cell.key) ?? (s.server?.key === cell.key ? s.server : null);\"},{\"line_number\":352,\"content\":\"    const name = (id) => s.players[id]?.name ?? `#${id}`;\"},{\"line_number\":377,\"content\":\" * ?auto=1 — the conformance run. It presses keys inside each frame with\"},{\"line_number\":379,\"content\":\" * page's origin). Results land in window.__hubCheck, and body[data-complete]\"},{\"line_number\":411,\"content\":\"  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\"},{\"line_number\":412,\"content\":\"  window.__hubCheck = report;\"},{\"line_number\":422,\"content\":\"    const seats = String(m?.players ?? '').match(/\\\\d+/g)?.map(Number) ?? [];\"},{\"line_number\":424,\"content\":\"    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\"},{\"line_number\":427,\"content\":\"    // Every copy: the players, and in a server round the server's copy.\"},{\"line_number\":428,\"content\":\"    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\"},{\"line_number\":442,\"content\":\"    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\"},{\"line_number\":443,\"content\":\"    // A game that shows its own card takes the players' answers on it: Enter is Ready.\"},{\"line_number\":445,\"content\":\"      const players = state.cells.filter((c) => !c.server);\"},{\"line_number\":446,\"content\":\"      const sent = await until(() => players.every((c) => c.cardSent), 2000);\"},{\"line_number\":447,\"content\":\"      for (const cell of players) poke(cell, 'Enter');\"},{\"line_number\":448,\"content\":\"      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\"},{\"line_number\":449,\"content\":\"      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\"},{\"line_number\":477,\"content\":\"    if (scenario === 'host-leave') removeCell(state.cells[0]);\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-a8c93197-e52a-415a-a912-685d59715543-37","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→# AI Hub Session Protocol v1\\n\\nAn **AI Hub session** is up to four players, each on their own device,\\nplaying rounds of games one after another. The hub runs everything around a\\nround: the invite, the lobby, the seats and names, the network, the clock, the\\nscoreboard and the results. This page defines how a game takes part in a\\nround, and how the copies of a game send data to each other.\\n\\n**https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md**\\n10→\\nThe hub tests every game when it joins the library, with the same test\\ndescribed in *Test it*, and keeps a game that fails it out of sessions.\\n\\n- Client: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js\\n- Harness: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\\n\\nTo ask an agent for it, add this to the game's prompt:\\n\\n> This game must support AI Hub sessions. Follow\\n20→> https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md\\n> (AI Hub Session Protocol v1) and pass the harness's automatic check.\\n\\n---\\n\\n## Modes\\n\\nA game declares one mode.\\n\\n| Mode | What each copy runs | What the copies send each other |\\n30→|---|---|---|\\n| `parallel` | its own copy of the round | nothing |\\n| `ghost` | its own copy of the round | each copy's own player: where it is and what it is doing |\\n| `shared-world` | one world for all players, run by the host's copy | what each player does, to the host; the world, from the host |\\n\\n- **Parallel**: every player plays their own copy of the round, from the same\\n  start. Each copy reports its score to the hub.\\n- **Ghost**: as parallel, and each copy also shows the other players'\\n  characters where they are, when they are in the same area of the game.\\n  Those characters do not affect anything in the copy that shows them.\\n40→- **Shared world**: all players play in one world. The host's copy runs that\\n  world; the other copies send it what their own player does, and show the\\n  world the host sends them.\\n\\nGames tagged with the older modes keep working: `race` is played as ghost,\\n`co-op` and `versus` as shared world.\\n\\n---\\n\\n## A round\\n50→\\n1. The hub loads the game on every player's device, and the players get 10\\n   to 30 seconds with the game's card: what the game is, how to win, the\\n   controls. The card is the hub's, from the game's tags, or the game's own\\n   (*The card*).\\n2. The game connects and calls `ready()`.\\n3. The round starts on the hub's clock, on every device at once.\\n4. The game reports how it goes.\\n5. The round ends when every player has a result, when the host of a shared\\n   world finishes it, or when the hub calls time. The hub shows the results\\n60→   over the game, then removes it.\\n\\n### Tags\\n\\nIn the game's `<head>`:\\n\\n```html\\n<meta name=\\\"hub:session\\\" content=\\\"1\\\">\\n<meta name=\\\"hub:session-players\\\" content=\\\"MIN-MAX\\\">\\n<meta name=\\\"hub:session-mode\\\" content=\\\"MODE\\\">\\n70→<meta name=\\\"hub:session-goal\\\" content=\\\"GOAL\\\">\\n<meta name=\\\"hub:session-howto\\\" content=\\\"CONTROLS\\\">\\n```\\n\\n- `hub:session-players`: the smallest and largest number of players the game\\n  takes in a session. The hub deals the game only when the number of players\\n  is in that range.\\n- `hub:session-mode`: `parallel`, `ghost` or `shared-world`.\\n- `hub:session-goal` and `hub:session-howto`: how to win and the game's\\n  controls, shown on the hub's card.\\n80→\",\"content_concise\":\"1→# AI Hub Session Protocol v1\\n\\nAn **AI Hub session** is up to four players, each on their own device,\\nplaying rounds of games one after another. The hub runs everything around a\\nround: the invite, the lobby, the seats and names, the network, the clock, the\\nscoreboard and the results. This page defines how a game takes part in a\\nround, and how the copies of a game send data to each other.\\n\\n**https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md**\\n10→\\nThe hub tests every game when it joins the library, with the same test\\ndescribed in *Test it*, and keeps a game that fails it out of sessions.\\n\\n- Client: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js\\n- Harness: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\\n\\nTo ask an agent for it, add this to the game's prompt:\\n\\n> This game must support AI Hub sessions. Follow\\n20→> https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md\\n> (AI Hub Session Protocol v1) and pass the harness's automatic check.\\n\\n---\\n\\n## Modes\\n\\nA game declares one mode.\\n\\n| Mode | What each copy runs | What the copies send each other |\\n30→|---|---|---|\\n| `parallel` | its own copy of the round | nothing |\\n| `ghost` | its own copy of the round | each copy's own player: where it is and what it is doing |\\n| `shared-world` | one world for all players, run by the host's copy | what each player does, to the host; the world, from the host |\\n\\n- **Parallel**: every player plays their own copy of the round, from the same\\n  start. Each copy reports its score to the hub.\\n- **Ghost**: as parallel, and each copy also shows the other players'\\n  characters where they are, when they are in the same area of the game.\\n  Those characters do not affect anything in the copy that shows them.\\n40→- **Shared world**: all players play in one world. The host's copy runs that\\n  world; the other copies send it what their own player does, and show the\\n  world the host sends them.\\n\\nGames tagged with the older modes keep working: `race` is played as ghost,\\n`co-op` and `versus` as shared world.\\n\\n---\\n\\n## A round\\n50→\\n1. The hub loads the game on every player's device, and the players get 10\\n   to 30 seconds with the game's card: what the game is, how to win, the\\n   controls. The card is the hub's, from the game's tags, or the game's own\\n   (*The card*).\\n2. The game connects and calls `ready()`.\\n3. The round starts on the hub's clock, on every device at once.\\n4. The game reports how it goes.\\n5. The round ends when every player has a result, when the host of a shared\\n   world finishes it, or when the hub calls time. The hub shows the results\\n60→   over the game, then removes it.\\n\\n### Tags\\n\\nIn the game's `<head>`:\\n\\n```html\\n<meta name=\\\"hub:session\\\" content=\\\"1\\\">\\n<meta name=\\\"hub:session-players\\\" content=\\\"MIN-MAX\\\">\\n<meta name=\\\"hub:session-mode\\\" content=\\\"MODE\\\">\\n70→<meta name=\\\"hub:session-goal\\\" content=\\\"GOAL\\\">\\n<meta name=\\\"hub:session-howto\\\" content=\\\"CONTROLS\\\">\\n```\\n\\n- `hub:session-players`: the smallest and largest number of players the game\\n  takes in a session. The hub deals the game only when the number of players\\n  is in that range.\\n- `hub:session-mode`: `parallel`, `ghost` or `shared-world`.\\n- `hub:session-goal` and `hub:session-howto`: how to win and the game's\\n  controls, shown on the hub's card.\\n80→\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/hub/README.md\",\"offset\":null,\"limit\":80,\"raw_output\":\"# AI Hub Session Protocol v1\\n\\nAn **AI Hub session** is up to four players, each on their own device,\\nplaying rounds of games one after another. The hub runs everything around a\\nround: the invite, the lobby, the seats and names, the network, the clock, the\\nscoreboard and the results. This page defines how a game takes part in a\\nround, and how the copies of a game send data to each other.\\n\\n**https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md**\\n\\nThe hub tests every game when it joins the library, with the same test\\ndescribed in *Test it*, and keeps a game that fails it out of sessions.\\n\\n- Client: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js\\n- Harness: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\\n\\nTo ask an agent for it, add this to the game's prompt:\\n\\n> This game must support AI Hub sessions. Follow\\n> https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md\\n> (AI Hub Session Protocol v1) and pass the harness's automatic check.\\n\\n---\\n\\n## Modes\\n\\nA game declares one mode.\\n\\n| Mode | What each copy runs | What the copies send each other |\\n|---|---|---|\\n| `parallel` | its own copy of the round | nothing |\\n| `ghost` | its own copy of the round | each copy's own player: where it is and what it is doing |\\n| `shared-world` | one world for all players, run by the host's copy | what each player does, to the host; the world, from the host |\\n\\n- **Parallel**: every player plays their own copy of the round, from the same\\n  start. Each copy reports its score to the hub.\\n- **Ghost**: as parallel, and each copy also shows the other players'\\n  characters where they are, when they are in the same area of the game.\\n  Those characters do not affect anything in the copy that shows them.\\n- **Shared world**: all players play in one world. The host's copy runs that\\n  world; the other copies send it what their own player does, and show the\\n  world the host sends them.\\n\\nGames tagged with the older modes keep working: `race` is played as ghost,\\n`co-op` and `versus` as shared world.\\n\\n---\\n\\n## A round\\n\\n1. The hub loads the game on every player's device, and the players get 10\\n   to 30 seconds with the game's card: what the game is, how to win, the\\n   controls. The card is the hub's, from the game's tags, or the game's own\\n   (*The card*).\\n2. The game connects and calls `ready()`.\\n3. The round starts on the hub's clock, on every device at once.\\n4. The game reports how it goes.\\n5. The round ends when every player has a result, when the host of a shared\\n   world finishes it, or when the hub calls time. The hub shows the results\\n   over the game, then removes it.\\n\\n### Tags\\n\\nIn the game's `<head>`:\\n\\n```html\\n<meta name=\\\"hub:session\\\" content=\\\"1\\\">\\n<meta name=\\\"hub:session-players\\\" content=\\\"MIN-MAX\\\">\\n<meta name=\\\"hub:session-mode\\\" content=\\\"MODE\\\">\\n<meta name=\\\"hub:session-goal\\\" content=\\\"GOAL\\\">\\n<meta name=\\\"hub:session-howto\\\" content=\\\"CONTROLS\\\">\\n```\\n\\n- `hub:session-players`: the smallest and largest number of players the game\\n  takes in a session. The hub deals the game only when the number of players\\n  is in that range.\\n- `hub:session-mode`: `parallel`, `ghost` or `shared-world`.\\n- `hub:session-goal` and `hub:session-howto`: how to win and the game's\\n  controls, shown on the hub's card.\\n\\n\",\"total_lines\":410}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"8661da5a-1dd9-42f1-b728-9cddf2fbfdf5"}
