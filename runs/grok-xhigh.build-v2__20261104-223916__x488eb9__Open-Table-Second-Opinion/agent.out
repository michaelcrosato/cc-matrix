z axis\\n};\\n/** two-bone IK in 3D: returns [joint, end]. hint points the way the joint should bend. */\\nfunction ik3(a, b, L1, L2, hint) {\\n  let d = V3.sub(b, a), dist = V3.len(d);\\n  const max = L1 + L2 - .01;\",\"content_concise\":\"172→const nullCanvas = (w, h) => {\\n  const c = { width: w, height: h, standIn: true }, img = (iw, ih) => ({ width: iw, height: ih, data: new Uint8ClampedArray(Math.max(0, iw * ih * 4)) });\\n  const made = { getImageData: (x, y, iw, ih) => img(iw, ih), createImageData: (iw, ih) => img(iw.width || iw, ih || iw.height), measureText: () => ({ width: 0 }),\\n    createLinearGradient: () => ({ addColorStop() {} }), createRadialGradient: () => ({ addColorStop() {} }), createPattern: () => ({}), canvas: c };\\n  const g = new Proxy({}, { get: (t, k) => k in t ? t[k] : k in made ? made[k] : typeof k === 'string' && k[0] === '_' ? undefined : () => {}, set: (t, k, v) => { t[k] = v; return true; } });   // (the engine's own _ fields: unset)\\n  c.getContext = () => g;\\n  return c;\\n};\\n180→/** a canvas's 2D context with smoothing off (crisp pixels) */\\nconst ctx2d = c => { const g = c.getContext('2d'); g.imageSmoothingEnabled = false; return g; };\\n/** small 3D vector helpers on [x, y, z] arrays */\\nconst V3 = {\\n  add: (a, b) => [a[0] + b[0], a[1] + b[1], a[2] + b[2]],   // a + b\\n  sub: (a, b) => [a[0] - b[0], a[1] - b[1], a[2] - b[2]],   // a - b\\n  mul: (a, s) => [a[0] * s, a[1] * s, a[2] * s],   // a scaled by s\\n  dot: (a, b) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2],   // dot product\\n  len: a => Math.hypot(a[0], a[1], a[2]),   // length\\n  norm: a => { const l = Math.hypot(a[0], a[1], a[2]) || 1; return [a[0] / l, a[1] / l, a[2] / l]; },   // unit vector the same way\\n190→  lerp: (a, b, t) => [lerp(a[0], b[0], t), lerp(a[1], b[1], t), lerp(a[2], b[2], t)],   // the point t of the way from a to b\\n  rz: (v, a) => { const c = Math.cos(a), s = Math.sin(a); return [v[0] * c - v[1] * s, v[0] * s + v[1] * c, v[2]]; }   // v turned by angle a (radians) about the z axis\\n};\\n/** two-bone IK in 3D: returns [joint, end]. hint points the way the joint should bend. */\\nfunction ik3(a, b, L1, L2, hint) {\\n  let d = V3.sub(b, a), dist = V3.len(d);\\n  const max = L1 + L2 - .01;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/my-3d2dge/dist/handoff/my-3d2dge.js\",\"offset\":172,\"limit\":25,\"raw_output\":\"const nullCanvas = (w, h) => {\\n  const c = { width: w, height: h, standIn: true }, img = (iw, ih) => ({ width: iw, height: ih, data: new Uint8ClampedArray(Math.max(0, iw * ih * 4)) });\\n  const made = { getImageData: (x, y, iw, ih) => img(iw, ih), createImageData: (iw, ih) => img(iw.width || iw, ih || iw.height), measureText: () => ({ width: 0 }),\\n    createLinearGradient: () => ({ addColorStop() {} }), createRadialGradient: () => ({ addColorStop() {} }), createPattern: () => ({}), canvas: c };\\n  const g = new Proxy({}, { get: (t, k) => k in t ? t[k] : k in made ? made[k] : typeof k === 'string' && k[0] === '_' ? undefined : () => {}, set: (t, k, v) => { t[k] = v; return true; } });   // (the engine's own _ fields: unset)\\n  c.getContext = () => g;\\n  return c;\\n};\\n/** a canvas's 2D context with smoothing off (crisp pixels) */\\nconst ctx2d = c => { const g = c.getContext('2d'); g.imageSmoothingEnabled = false; return g; };\\n/** small 3D vector helpers on [x, y, z] arrays */\\nconst V3 = {\\n  add: (a, b) => [a[0] + b[0], a[1] + b[1], a[2] + b[2]],   // a + b\\n  sub: (a, b) => [a[0] - b[0], a[1] - b[1], a[2] - b[2]],   // a - b\\n  mul: (a, s) => [a[0] * s, a[1] * s, a[2] * s],   // a scaled by s\\n  dot: (a, b) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2],   // dot product\\n  len: a => Math.hypot(a[0], a[1], a[2]),   // length\\n  norm: a => { const l = Math.hypot(a[0], a[1], a[2]) || 1; return [a[0] / l, a[1] / l, a[2] / l]; },   // unit vector the same way\\n  lerp: (a, b, t) => [lerp(a[0], b[0], t), lerp(a[1], b[1], t), lerp(a[2], b[2], t)],   // the point t of the way from a to b\\n  rz: (v, a) => { const c = Math.cos(a), s = Math.sin(a); return [v[0] * c - v[1] * s, v[0] * s + v[1] * c, v[2]]; }   // v turned by angle a (radians) about the z axis\\n};\\n/** two-bone IK in 3D: returns [joint, end]. hint points the way the joint should bend. */\\nfunction ik3(a, b, L1, L2, hint) {\\n  let d = V3.sub(b, a), dist = V3.len(d);\\n  const max = L1 + L2 - .01;\\n\",\"total_lines\":14974}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"68114c23-25c5-45c3-83aa-fb5eeb72312e"}
{"type":"assistant","message":{"id":"msg_37","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"putImageData is a proxy that returns an empty function.\n\nshade() computes image data in JavaScript arrays, but putImageData does nothing. This could be slow for 426×240 frames. Determinism tests need only a few frames. Screenshots require the real browser canvas. createImageData handles numeric arguments correctly and returns a Uint8ClampedArray.\n\nUint32Array views on the image buffer work correctly. The 426×240 tissue field contains roughly 100,000 pixels, so shade() should not run every simulation step. I will now write the source files, starting with config, sim, and content, adding debug event logs to the simulator. Mass acceptance rules are being defined: stage 0 uses a scalpel ring, stage 1 uses forceps.\n\nA `ready()` helper will check prerequisite objects before the bot acts. The hook stage keeps barbs active so forceps tears; once relief cuts are done, barbs drop and forceps work. Objects chain via an `after` tag. I am now writing the simulator with clear section comments.\n\nA debug runner will live in scratch and remain separate from the official test. I am composing sim.js carefully. I am also adding explicit tool-mistake definitions: forceps tear, scalpel slip, suture loose, syringe air bubble, and cautery char with lockout.\n\nSalve on steel or nothing, suction on a dry field, and sonar taps without hidden objects all count as \"no effect\" mistakes. The test must cover every one of the eight specified mistake types.\n\nThe cautery lockout test will hold the tool for two seconds on bare tissue. Heat fills at 0.5 per second and locks after one second, so the test asserts that heat remains locked and a char or slip event occurs.\n\nSuction removes volume at 60 per second. A 30-unit pool empties in half a second.\n\nSonar marks hidden objects within 38 pixels.\n\nStrain tests are now defined. Staccato kills one nest and beads. Legato snap pulls fast to trigger a snapped strain while the head regrows. Legato success pulls slowly through a short worm. Da Capo regrowth lets the countdown reach zero, then asserts regrown lobes and dropped vitals. Da Capo success kills both rounds before time expires.\n\nTremolo success will be tested by scripting syringes during a flare, cautery, and pull. Fermata uses domes and eye cautery with a long breath window and gentle pull. Cantor rewind triggers a forced rewind and checks that progress is undone. Unit tests will call Op directly with small custom cases. The full case bot clear serves as the success test for each strain. Scripted inputs will cover failure branches more reliably than the bot. Mini constructors are being defined.\n\nSpawners will be exported for direct case construction. The Cantor rewind test will advance an object’s progress, set a steady value, step through the windup phase without slashing, and assert that the progress restores when rewind fires. The steady value should remain unchanged because passive charge does not reset it.\n\nThe Cantor rewind test will snapshot the steady value immediately before rewind resolution. Passive charge will be applied before the check, but the captured pre-rewind value will be restored exactly without adding charge for that frame. A one-unit tolerance may be allowed.\n\nThe Cantor rewind test will set the steady value to 40, mark an object done, and step the simulation until the rewind fires. It will assert that the object is no longer done and that the steady value remains 40. A second test will verify that a windup slash prevents the rewind from firing. The tests will use the real internal functions rather than exporting backdoors.\n\nStrain configuration can use `rewindEvery: 1` for rapid testing, or a phase script can trigger `cantorRewind` at a specific time. JSON cloning handles nested arrays correctly. The default player spawns at center coordinates 213,116. I will now write the source files and add the game shell in this same turn after a quick simulation test.\n\nI will seed PROGRESS.md so context compaction can resume. I am writing config.js first, then sim.js. A grid helper will generate case coordinates. Shard objects will use a template with origin, axis, depth, order, and drain. Templates will be stored in content and spawned as copies with unique ids.\n\nLightbox data will be added to case definitions. The chart scene uses it, and a correct guess grants the operation a harmless marker plus +20 seconds clock and +20 steady. The campaign stores the lightbox result.\n\nThe bot will handle every object type with its proper tool: shards, fragments, and corks pull with forceps; lacerations, patches, and bites salve; wounds and artery tears suture; bleeder, polyp, rupture, beads, and uvula cautery.\n\nObject-specific tool mappings are now defined. Pools suction. Masses use a ring then forceps. Hooks and gaffs need forceps after cuts. Clots use syringe then forceps. Nests slash then forceps. Screws use a circle. Wires slash across. Retractors hold. Slurs use a short scalpel guide. Lobs depend on kind. Eyes cautery during open. Tendrils, repeats, and spirals use scalpel. Notes pull with forceps slowly.\n\nThe strain sets `o.window = true` for injectable objects. The bot must wait for this flag before syringing. Otherwise the sim treats it as a cut and triggers tremolo.\n\nGeneric bot plans will branch by object type. Cautery holds until the object is done. Scalpel traces a guide path. Suture uses paired points. A screw object accumulates spin angle during forceps; three full revolutions mark it done. The bot circles a screw at radius 10 while holding the trigger. A wire gets a short scalpel slash across.\n\nWires are sequenced in `S.device.order` and cut in that exact order. Sonar reveals the true sequence, which is hidden behind a lie stored in `S.device.lie`. The bot waits for sonar before cutting. A scalpel slash crossing a wire at over 60 units per second severs it. Cutting the wrong wire penalizes vitals by 30 clock and 30 steady.\n\nThe cantor case will be simplified with sequential, straightforward objects. A stuck-bot guard will dump the current goal after eight seconds of no progress, but this logic belongs in the test runner rather than the bot itself. During simulation steps, phase advancement must load new objects exactly once and avoid double-loading; tutorial resets will also be handled carefully.\n\nThe dressing phase follows exhausted case phases. It runs for 1.2 seconds and triggers a hit when the ring is within 0.08 of its closing point. Any press closes the phase, but precise timing grants a bonus. The bot waits for this window to avoid softlocks. The final score includes that bonus. Clock and vitals continue running during dressing.\n\nVital drains will be frozen during dressing so the patient cannot die mid-operation. The bot will finish the phase in one cycle. I will now write the source files and use hand delta time for player input updates.\n\nTear threshold is hand speed. During long breath, hands stay full speed, so yanking fast still tears. The inst update uses hand delta time.\n\nIf the cursor is inside a dome, applyTool returns immediately.\n\nCursor jitter will be added to Cursor.update during strain. It scales with amplitude and fine-mode sensitivity. A concern arose that cursor movement consumes RNG state, which could break determinism if cursor updates happen before step.\n\nCursor jitter will use a deterministic sine and cosine function based on world time and object ID instead of the simulation RNG. This avoids mutating rewindable state and keeps determinism intact.\n\nCursor jitter will be a deterministic time-based offset applied after integration. The bot in fine mode has 1.75-unit amplitude, which may prevent it from settling within the 6–12-unit target tolerance because the aim point oscillates every frame. The bot must still land on the target despite this jitter. A `jitter(S, p)` helper is being drafted.\n\nThe jitter helper will be deterministic, using sine and cosine of world time scaled by strain amplitude and fine-mode sensitivity. Adding this offset after cursor integration risks compounding drift across frames, since the next frame would apply jitter to an already-jittered position.\n\nCursor jitter will be applied as a visual offset to the base position rather than accumulated. The cursor integrates its base coordinates by velocity each frame, then recomputes the sine and cosine offset from world time on every update. This prevents drift across frames while keeping the offset deterministic.\n\nThe game loop order causes cursor jitter to accumulate. Cursor.update applies the offset to p.x and p.y, but step then overwrites p.bx with that same jittered value. The next frame integrates from the already-jittered base position, so drift compounds across frames.\n\nThe cursor owns position exclusively. The game loop updates the wheel first, then the cursor, and step never overwrites x or y unless an absolute-position flag is set. Tool tests pass coordinates directly to step, but the game loop does not, so cursor jitter cannot compound across frames.","signature":""},{"type":"text","text":"The engine is in place and the touch notice is patched. Next I’ll build the operation sim, the cases, and the bot that drives them."},{"type":"tool_use","id":"call-7ceb3598-b8c7-4fbd-b22d-057f8f11825a-49","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/config.js","new_string":"/* Open Table Second Opinion — title, tuning, and the strings the page and the Hub share. */\n(() => {\n  const G = typeof window !== 'undefined' ? window : globalThis;\n  const GAME = (G.GAME ||= {});\n  const GAME_TITLE = 'Open Table Second Opinion';\n  const RUN = 'grok-4.7-xhigh-20261104-223916';\n  const SOURCE = 'Trauma Center: Second Opinion';\n\n  const TUNING = {\n    patient: { drain: 1, slip: 1, healing: 1, syringe: 18, clock: 1 },\n    hands: { cursor: 330, fine: 0.35, curve: 1.7, assist: 0.6, magnet: 22, grade: 1 },\n    strains: { speed: 1, health: 1, spawn: 1, damage: 1, beat: 0.5 },\n    gift: { charge: 1, breathDrain: 16, breathFactor: 0.25, lookSeconds: 6 },\n    fluids: { bleed: 1, suction: 60, cauteryHeat: 0.5 },\n  };\n\n  const TOOLS = ['forceps', 'scalpel', 'suture', 'salve', 'syringe', 'cautery', 'suction', 'sonar'];\n  /* Stick y is negative toward the top of the field. Clockwise from north. */\n  const WHEEL = [\n    { tool: 'forceps', x: 0, y: -1 },\n    { tool: 'scalpel', x: 1, y: -1 },\n    { tool: 'suture', x: 1, y: 0 },\n    { tool: 'salve', x: 1, y: 1 },\n    { tool: 'syringe', x: 0, y: 1 },\n    { tool: 'cautery', x: -1, y: 1 },\n    { tool: 'suction', x: -1, y: 0 },\n    { tool: 'sonar', x: -1, y: -1 },\n  ];\n\n  function cloneTune(t) {\n    return {\n      patient: Object.assign({}, t.patient),\n      hands: Object.assign({}, t.hands),\n      strains: Object.assign({}, t.strains),\n      gift: Object.assign({}, t.gift),\n      fluids: Object.assign({}, t.fluids),\n    };\n  }\n\n  GAME.CFG = {\n    GAME_TITLE, RUN, SOURCE,\n    FILE: 'Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-' + RUN,\n    TUNING, TOOLS, WHEEL, cloneTune,\n    FIELD_W: 426, FIELD_H: 240, CX: 213, CY: 116, RX: 171, RY: 91,\n    SEAT: ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'],\n  };\n  GAME.TUNE = cloneTune(TUNING);\n})();\n","old_string":""}},{"type":"tool_use","id":"call-7ceb3598-b8c7-4fbd-b22d-057f8f11825a-50","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/PROGRESS.md","new_string":"# Progress\n\nTitle: Open Table Second Opinion (RNG index 7 of 50, crypto.randomInt).\n\nDev folder: Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916\n\nEngine: my-3D2dge handoff 0.89.1. Hub client 1.4.0, pasted unmodified.\n\nEngine edits: touch-only notice sits at the bottom so attract can show; one comment no longer uses a banned token so the single HTML file stays clean.\n\nSim, content, bot, scenes, and the hand-in page are in progress. Tests live at `node tests/run.mjs` inside the dev folder.\n","old_string":""}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":996,"output_tokens":5351,"cache_read_input_tokens":194048,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"6c7b4603-0dea-4bf4-bb64-d83515af87c8"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-7ceb3598-b8c7-4fbd-b22d-057f8f11825a-49","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"\",\"new_string\":\"/* Open Table Second Opinion — title, tuning, and the strings the page and the Hub share. */\\n(() => {\\n  const G = typeof window !== 'undefined' ? window : globalThis;\\n  const GAME = (G.GAME ||= {});\\n  const GAME_TITLE = 'Open Table Second Opinion';\\n  const RUN = 'grok-4.7-xhigh-20261104-223916';\\n  const SOURCE = 'Trauma Center: Second Opinion';\\n\\n  const TUNING = {\\n    patient: { drain: 1, slip: 1, healing: 1, syringe: 18, clock: 1 },\\n    hands: { cursor: 330, fine: 0.35, curve: 1.7, assist: 0.6, magnet: 22, grade: 1 },\\n    strains: { speed: 1, health: 1, spawn: 1, damage: 1, beat: 0.5 },\\n    gift: { charge: 1, breathDrain: 16, breathFactor: 0.25, lookSeconds: 6 },\\n    fluids: { bleed: 1, suction: 60, cauteryHeat: 0.5 },\\n  };\\n\\n  const TOOLS = ['forceps', 'scalpel', 'suture', 'salve', 'syringe', 'cautery', 'suction', 'sonar'];\\n  /* Stick y is negative toward the top of the field. Clockwise from north. */\\n  const WHEEL = [\\n    { tool: 'forceps', x: 0, y: -1 },\\n    { tool: 'scalpel', x: 1, y: -1 },\\n    { tool: 'suture', x: 1, y: 0 },\\n    { tool: 'salve', x: 1, y: 1 },\\n    { tool: 'syringe', x: 0, y: 1 },\\n    { tool: 'cautery', x: -1, y: 1 },\\n    { tool: 'suction', x: -1, y: 0 },\\n    { tool: 'sonar', x: -1, y: -1 },\\n  ];\\n\\n  function cloneTune(t) {\\n    return {\\n      patient: Object.assign({}, t.patient),\\n      hands: Object.assign({}, t.hands),\\n      strains: Object.assign({}, t.strains),\\n      gift: Object.assign({}, t.gift),\\n      fluids: Object.assign({}, t.fluids),\\n    };\\n  }\\n\\n  GAME.CFG = {\\n    GAME_TITLE, RUN, SOURCE,\\n    FILE: 'Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-' + RUN,\\n    TUNING, TOOLS, WHEEL, cloneTune,\\n    FIELD_W: 426, FIELD_H: 240, CX: 213, CY: 116, RX: 171, RY: 91,\\n    SEAT: ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'],\\n  };\\n  GAME.TUNE = cloneTune(TUNING);\\n})();\\n\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/config.js has been created successfully.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/config.js has been created.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/config.js\",\"edits\":{\"details\":[{\"old_string\":\"\",\"old_line\":1,\"new_string\":\"/* Open Table Second Opinion — title, tuning, and the strings the page and the Hub share. */\\n(() => {\\n  const G = typeof window !== 'undefined' ? window : globalThis;\\n  const GAME = (G.GAME ||= {});\\n  const GAME_TITLE = 'Open Table Second Opinion';\\n  const RUN = 'grok-4.7-xhigh-20261104-223916';\\n  const SOURCE = 'Trauma Center: Second Opinion';\\n\\n  const TUNING = {\\n    patient: { drain: 1, slip: 1, healing: 1, syringe: 18, clock: 1 },\\n    hands: { cursor: 330, fine: 0.35, curve: 1.7, assist: 0.6, magnet: 22, grade: 1 },\\n    strains: { speed: 1, health: 1, spawn: 1, damage: 1, beat: 0.5 },\\n    gift: { charge: 1, breathDrain: 16, breathFactor: 0.25, lookSeconds: 6 },\\n    fluids: { bleed: 1, suction: 60, cauteryHeat: 0.5 },\\n  };\\n\\n  const TOOLS = ['forceps', 'scalpel', 'suture', 'salve', 'syringe', 'cautery', 'suction', 'sonar'];\\n  /* Stick y is negative toward the top of the field. Clockwise from north. */\\n  const WHEEL = [\\n    { tool: 'forceps', x: 0, y: -1 },\\n    { tool: 'scalpel', x: 1, y: -1 },\\n    { tool: 'suture', x: 1, y: 0 },\\n    { tool: 'salve', x: 1, y: 1 },\\n    { tool: 'syringe', x: 0, y: 1 },\\n    { tool: 'cautery', x: -1, y: 1 },\\n    { tool: 'suction', x: -1, y: 0 },\\n    { tool: 'sonar', x: -1, y: -1 },\\n  ];\\n\\n  function cloneTune(t) {\\n    return {\\n      patient: Object.assign({}, t.patient),\\n      hands: Object.assign({}, t.hands),\\n      strains: Object.assign({}, t.strains),\\n      gift: Object.assign({}, t.gift),\\n      fluids: Object.assign({}, t.fluids),\\n    };\\n  }\\n\\n  GAME.CFG = {\\n    GAME_TITLE, RUN, SOURCE,\\n    FILE: 'Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-' + RUN,\\n    TUNING, TOOLS, WHEEL, cloneTune,\\n    FIELD_W: 426, FIELD_H: 240, CX: 213, CY: 116, RX: 171, RY: 91,\\n    SEAT: ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'],\\n  };\\n  GAME.TUNE = cloneTune(TUNING);\\n})();\\n\",\"new_line\":1,\"context_before\":\"\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false},{"type":"tool_result","tool_use_id":"call-7ceb3598-b8c7-4fbd-b22d-057f8f11825a-50","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"\",\"new_string\":\"# Progress\\n\\nTitle: Open Table Second Opinion (RNG index 7 of 50, crypto.randomInt).\\n\\nDev folder: Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916\\n\\nEngine: my-3D2dge handoff 0.89.1. Hub client 1.4.0, pasted unmodified.\\n\\nEngine edits: touch-only notice sits at the bottom so attract can show; one comment no longer uses a banned token so the single HTML file stays clean.\\n\\nSim, content, bot, scenes, and the hand-in page are in progress. Tests live at `node tests/run.mjs` inside the dev folder.\\n\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/PROGRESS.md has been created successfully.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/PROGRESS.md has been created.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/PROGRESS.md\",\"edits\":{\"details\":[{\"old_string\":\"\",\"old_line\":1,\"new_string\":\"# Progress\\n\\nTitle: Open Table Second Opinion (RNG index 7 of 50, crypto.randomInt).\\n\\nDev folder: Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916\\n\\nEngine: my-3D2dge handoff 0.89.1. Hub client 1.4.0, pasted unmodified.\\n\\nEngine edits: touch-only notice sits at the bottom so attract can show; one comment no longer uses a banned token so the single HTML file stays clean.\\n\\nSim, content, bot, scenes, and the hand-in page are in progress. Tests live at `node tests/run.mjs` inside the dev folder.\\n\",\"new_line\":1,\"context_before\":\"\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"82ff2bf1-fdd9-4fbf-9e43-e0d5e35a51bc"}
{"type":"assistant","message":{"id":"msg_38","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"text","text":"The sim is the part the tests actually drive, so I’m writing that next: tools, vitals, gifts, and strains as plain data."},{"type":"tool_use","id":"call-688c113e-9f07-476e-8778-8013edf777ce-51","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/core/sim.js","new_string":"/* Operation sim. Plain data in, plain data out. No drawing, no audio, no DOM.\n   Cursor and the wheel sit beside it and feed the same inputs a pad does. */\n(() => {\n  const G = typeof window !== 'undefined' ? window : globalThis;\n  const GAME = (G.GAME ||= {});\n  const CFG = GAME.CFG;\n  const TAU = Math.PI * 2;\n\n  const DRAIN = {\n    shard: 0.1, fragment: 0.1, cork: 0.1, laceration: 0.2, bite: 0.2, wound: 0.4,\n    bleeder: 0.5, arteryTear: 1, polyp: 0.1, mass: 0.2, hook: 0.3, gaff: 0.3,\n    clot: 0.3, patch: 0.1, nest: 0.15, bead: 0, rupture: 0.45, screw: 0, wire: 0,\n    pool: 0, retractor: 0, slur: 0, reed: 0, tremass: 0.4, lobe: 0.2, eye: 0.35,\n    tendril: 0.2, uvula: 0.3, voice: 0.4, repeat: 0, spiral: 0, note: 0.2, nerve: 0,\n    eloquent: 0, hold: 0,\n  };\n\n  function rnd(S) {\n    let x = (S.rng >>> 0) || 1;\n    x ^= x << 13; x >>>= 0;\n    x ^= x >>> 17; x >>>= 0;\n    x ^= x << 5; x >>>= 0;\n    if (!x) x = 1;\n    S.rng = x;\n    return x / 4294967296;\n  }\n  function clamp(v, a, b) { return v < a ? a : v > b ? b : v; }\n  function hypot(x, y) { return Math.hypot(x, y); }\n  function clone(v) { return JSON.parse(JSON.stringify(v)); }\n  function tuneOf(t) { return t || GAME.TUNE || CFG.cloneTune(CFG.TUNING); }\n  function diffDrain(S) { return S.diff === 'intern' ? 0.7 : S.diff === 'attending' ? 1.3 : 1; }\n  function diffClock(S) { return S.diff === 'intern' ? 1.3 : S.diff === 'attending' ? 0.8 : 1; }\n  function syringeDose(S, tune) {\n    const base = tune.patient.syringe;\n    if (S.diff === 'intern') return 24 * (base / 18);\n    if (S.diff === 'attending') return 12 * (base / 18);\n    return base;\n  }\n\n  function objById(S, id) {\n    for (let i = 0; i < S.objects.length; i++) if (S.objects[i].id === id) return S.objects[i];\n    return null;\n  }\n\n  function pushEv(S, ev) { S.ev.push(ev); }\n\n  function slip(S, p, kind, dmg, tune) {\n    S.slips += 1;\n    if (p) p.slips += 1;\n    S.vitals -= dmg * tune.patient.slip;\n    S.streak = 0;\n    S.flow = 1;\n    pushEv(S, ['slip', kind, dmg, p ? p.id : -1]);\n  }\n\n  function award(S, p, grade, base, tune) {\n    const mult = grade === 'textbook' ? 1.5 : grade === 'clean' ? 1 : 0.4;\n    const pts = base * mult * S.flow;\n    S.score += pts;\n    p.score += pts;\n    p.actions += 1;\n    S.techAll += 1;\n    if (grade !== 'sloppy') S.techGood += 1;\n    if (grade === 'textbook') { p.textbooks += 1; S.steady = Math.min(100, S.steady + 10 * tune.gift.charge); }\n    else if (grade === 'clean') S.steady = Math.min(100, S.steady + 5 * tune.gift.charge);\n    if (grade === 'sloppy') { S.streak = 0; S.flow = 1; }\n    else {\n      S.streak += 1;\n      S.flow = Math.min(2, 1 + 0.05 * S.streak);\n      if (S.flow > S.bestFlow) S.bestFlow = S.flow;\n    }\n    if (!S.tutDone) S.tutDone = true;\n    pushEv(S, ['grade', Math.round(p.x), Math.round(p.y), grade, Math.round(pts)]);\n    return grade;\n  }\n\n  function makePlayer(i, color) {\n    return {\n      id: i, x: 213, y: 150, bx: 213, by: 150, tool: 'forceps', trig: 0, prevTrig: 0,\n      fine: false, held: 0, stroke: null, heat: 0, lock: 0, fill: 0, over: 0,\n      cool: 0, score: 0, slips: 0, actions: 0, textbooks: 0, stitches: 0,\n      suctioned: 0, burned: 0, speed: 0, wheelT: 0, wheelDir: -1, swap: 0,\n      giftPrev: false, consultPrev: false, color: color || CFG.SEAT[i] || '#e8443a',\n      gone: false,\n    };\n  }\n\n  function blank(opts) {\n    opts = opts || {};\n    const n = opts.players || 1;\n    const S = {\n      id: opts.id || 'raw', seed: (opts.seed >>> 0) || 1, rng: (opts.seed >>> 0) || 1,\n      diff: opts.difficulty || opts.diff || 'resident',\n      clock: opts.clock != null ? opts.clock : 180,\n      clock0: opts.clock != null ? opts.clock : 180,\n      vitals: opts.vitals != null ? opts.vitals : 80,\n      drain: opts.drain != null ? opts.drain : 0,\n      phase: 0, phaseCount: 1, phaseName: opts.phaseName || 'Work',\n      objects: [], nextId: 1, players: [],\n      steady: opts.steady || 0, breath: false, worldScale: 1,\n      gift: opts.gift || 'breath', doctor: opts.doctor || 'vale', activeDoc: opts.doctor || 'vale',\n      consult: !!opts.consult, mode: opts.mode || 'case',\n      codeBlueUsed: false, codeBlue: null, lost: false, won: false, closed: false, reason: '',\n      score: 0, slips: 0, flow: 1, streak: 0, bestFlow: 1, techGood: 0, techAll: 0,\n      t: 0, worldT: 0, phaseT: 0, ev: [], ghosts: [], ghostT: 0,\n      ring: [], ringAcc: 0, checkpoint: null, rankCap: null, par: opts.par || 1000,\n      site: opts.site || 'abdomen', tutorial: !!opts.tutorial, tutDone: !opts.tutorial,\n      strain: null, flags: {}, scripts: [], tiltAmp: 0, dim: 0, dressing: null,\n      device: null, windowOpen: 0, dev: !!opts.dev,\n    };\n    for (let i = 0; i < n; i++) S.players.push(makePlayer(i, opts.colors && opts.colors[i]));\n    return S;\n  }\n\n  function addObj(S, spec) {\n    const o = Object.assign({\n      id: S.nextId++, type: 'shard', x: 213, y: 116, alive: true, done: false,\n      hidden: false, marked: false, markT: 0, under: 0, prog: 0, order: 0,\n      drain: 0, grade: '', tag: '',\n    }, spec);\n    if (o.drain == null || spec.drain == null) o.drain = spec.drain != null ? spec.drain : (DRAIN[o.type] || 0);\n    if (!o.origin) o.origin = [o.x, o.y];\n    if (!o.axis) o.axis = [1, 0];\n    const al = hypot(o.axis[0], o.axis[1]) || 1;\n    o.axis = [o.axis[0] / al, o.axis[1] / al];\n    if (o.depth == null) o.depth = 16;\n    if (o.type === 'pool' && o.vol == null) o.vol = o.max || 36;\n    if (o.type === 'pool' && o.max == null) o.max = o.vol;\n    if ((o.type === 'wound' || o.type === 'arteryTear') && !o.pairs) {\n      const n = o.stitches || (o.type === 'arteryTear' ? 3 : 4);\n      o.pairs = [];\n      for (let i = 0; i < n; i++) {\n        const y = o.y - (n - 1) * 4 + i * 8;\n        o.pairs.push([[o.x - 8, y], [o.x + 8, y]]);\n      }\n    }\n    if (o.pairs) o.stitch = 0;\n    if ((o.type === 'laceration' || o.type === 'patch' || o.type === 'bite') && !o.cells) {\n      const r = o.r || 12;\n      o.cells = [];\n      for (let y = -r; y <= r; y += 4) for (let x = -r; x <= r; x += 4) {\n        if (x * x + y * y <= r * r) o.cells.push([o.x + x, o.y + y, 0]);\n      }\n    }\n    if ((o.type === 'mass' || o.type === 'spiral' || o.type === 'slur' || o.type === 'tendril' || o.type === 'wire' || o.type === 'repeat') && !o.guide) {\n      const len = o.len || 48;\n      o.guide = [[o.x - len / 2, o.y], [o.x + len / 2, o.y]];\n    }\n    if (o.type === 'mass' && !o.ring) {\n      o.ring = true;\n      const rad = o.rad || 16;\n      o.guide = [];\n      for (let i = 0; i <= 12; i++) {\n        const a = -Math.PI / 2 + TAU * i / 12;\n        o.guide.push([o.x + Math.cos(a) * rad, o.y + Math.sin(a) * rad]);\n      }\n    }\n    if (o.need == null) {\n      if (o.type === 'polyp') o.need = 0.5;\n      else if (o.type === 'bleeder' || o.type === 'rupture') o.need = 0.35;\n      else if (o.type === 'bead') o.need = 0.12;\n      else if (o.type === 'uvula') o.need = 1.5;\n      else if (o.type === 'eye') o.need = 0.3;\n      else if (o.type === 'tremass') o.need = 3;\n      else o.need = 0.5;\n    }\n    S.objects.push(o);\n    return o;\n  }\n\n  function inDome(S, x, y) {\n    const st = S.strain;\n    if (!st || !st.domes) return false;\n    for (let i = 0; i < st.domes.length; i++) {\n      const d = st.domes[i];\n      if (d.t > 0 && hypot(x - d.x, y - d.y) <= d.r) return true;\n    }\n    return false;\n  }\n\n  function covered(S, o) {\n    if (!o.under) return false;\n    const p = objById(S, o.under);\n    return !!(p && !p.done && p.vol > 1);\n  }\n\n  function canTouch(S, o) {\n    if (!o || o.done || !o.alive) return false;\n    if (covered(S, o)) return false;\n    if (o.hidden && !o.marked) return false;\n    if (o.needsWindow && S.windowOpen <= 0) return false;\n    if (o.type === 'reed' || o.type === 'voice') return !!o.window;\n    if (o.type === 'lobe') return !!o.open;\n    if (o.type === 'eye') return !!o.open;\n    if (o.type === 'repeat') return !!o.open;\n    return true;\n  }\n\n  function nearest(S, p, rad, pred) {\n    let best = null, bd = rad;\n    for (let i = 0; i < S.objects.length; i++) {\n      const o = S.objects[i];\n      if (!pred(o)) continue;\n      const d = hypot(o.x - p.x, o.y - p.y);\n      if (d <= bd) { bd = d; best = o; }\n    }\n    return best;\n  }\n\n  function lose(S, why) {\n    if (S.lost || S.won) return;\n    S.lost = true;\n    S.reason = why;\n    S.breath = false;\n    S.worldScale = 1;\n    pushEv(S, ['lost', why]);\n  }\n\n  function finishCase(S) {\n    if (S.won || S.lost) return;\n    S.won = true;\n    S.closed = true;\n    S.breath = false;\n    S.worldScale = 1;\n    const end = Math.max(0, S.clock) * 2 + Math.max(0, S.vitals) * 3;\n    S.score += end;\n    S.endBonus = end;\n    S.rank = rankLetter(S.score, S.par, S.diff, S.slips, S.rankCap);\n    pushEv(S, ['closed', S.rank, Math.round(S.score)]);\n  }\n\n  function rankLetter(score, par, diff, slips, cap) {\n    const r = par > 0 ? score / par : 0;\n    let L = r >= 0.95 ? 'S' : r >= 0.8 ? 'A' : r >= 0.6 ? 'B' : r >= 0.4 ? 'C' : 'D';\n    const order = 'DCBAS';\n    if (cap === 'B' && order.indexOf(L) > order.indexOf('B')) L = 'B';\n    if (diff === 'attending' && L === 'S' && !slips) return 'S+';\n    return L;\n  }\n\n  function takeCore(S) {\n    return {\n      rng: S.rng, clock: S.clock, vitals: S.vitals, score: S.score, slips: S.slips,\n      phase: S.phase, steady: S.steady, flow: S.flow, streak: S.streak,\n      phaseT: S.phaseT, worldT: S.worldT, flags: clone(S.flags),\n      objects: clone(S.objects), strain: S.strain ? clone(S.strain) : null,\n      device: S.device ? clone(S.device) : null,\n      techGood: S.techGood, techAll: S.techAll, bestFlow: S.bestFlow,\n      codeBlueUsed: S.codeBlueUsed, tutDone: S.tutDone, tutorial: S.tutorial,\n      windowOpen: S.windowOpen, tiltAmp: S.tiltAmp, dim: S.dim,\n    };\n  }\n\n  function applyCore(S, core) {\n    S.rng = core.rng; S.clock = core.clock; S.vitals = core.vitals; S.score = core.score;\n    S.slips = core.slips; S.phase = core.phase; S.steady = core.steady; S.flow = core.flow;\n    S.streak = core.streak; S.phaseT = core.phaseT; S.worldT = core.worldT;\n    S.flags = clone(core.flags); S.objects = clone(core.objects);\n    S.strain = core.strain ? clone(core.strain) : null;\n    S.device = core.device ? clone(core.device) : null;\n    S.techGood = core.techGood; S.techAll = core.techAll; S.bestFlow = core.bestFlow;\n    S.codeBlueUsed = core.codeBlueUsed; S.tutDone = core.tutDone; S.tutorial = core.tutorial;\n    S.windowOpen = core.windowOpen; S.tiltAmp = core.tiltAmp; S.dim = core.dim;\n  }\n\n  function hashCore(core) {\n    const s = JSON.stringify(core);\n    let h = 2166136261;\n    for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); }\n    return h >>> 0;\n  }\n\n  function pushRing(S) {\n    const cursors = S.players.map(p => [round3(p.x), round3(p.y)]);\n    const strains = strainGhost(S);\n    S.ring.push({ t: S.worldT, core: takeCore(S), cursors, strains });\n    const keep = S.worldT - 6.05;\n    while (S.ring.length > 2 && S.ring[0].t < keep) S.ring.shift();\n  }\n  function round3(v) { return Math.round(v * 1000) / 1000; }\n\n  function strainGhost(S) {\n    const st = S.strain;\n    if (!st) return [];\n    if (st.kind === 'legato') return (st.worms || []).map(w => [round3(w.x), round3(w.y)]);\n    if (st.kind === 'staccato') return (st.beads || []).map(b => [round3(b.x), round3(b.y)]);\n    if (st.kind === 'fermata' || st.kind === 'cantor') return st.eye ? [[round3(st.eye.x), round3(st.eye.y)]] : [];\n    if (st.kind === 'tremolo') return [[round3(st.x || 213), round3(st.y || 116)]];\n    if (st.kind === 'dacapo') return (st.lobes || []).map(L => [round3(L.x), round3(L.y)]);\n    return [];\n  }\n\n  function restoreCore(S, core, keepHands) {\n    const hands = S.players.map(p => ({ id: p.id, x: p.x, y: p.y, bx: p.bx, by: p.by, color: p.color }));\n    applyCore(S, core);\n    for (let i = 0; i < S.players.length; i++) {\n      const p = S.players[i];\n      p.held = 0; p.stroke = null; p.fill = 0; p.over = 0; p.trig = 0; p.prevTrig = 0;\n      if (keepHands && hands[i]) {\n        p.x = hands[i].x; p.y = hands[i].y; p.bx = hands[i].bx; p.by = hands[i].by;\n      }\n    }\n  }\n\n  function secondLook(S, tune) {\n    if (S.mode === 'rounds') return false;\n    if (S.gift !== 'look' && S.gift !== 'both' && S.activeDoc !== 'sokolova' && S.gift !== 'look') {\n      if (!(S.gift === 'both' || S.activeDoc === 'sokolova' || S.gift === 'look')) return false;\n    }\n    const can = S.gift === 'look' || S.gift === 'both' || S.activeDoc === 'sokolova';\n    if (!can) return false;\n    if (S.steady < 45) return false;\n    if (!S.ring.length) return false;\n    const target = S.worldT - (tune.gift.lookSeconds || 6);\n    let pick = S.ring[0];\n    for (let i = 0; i < S.ring.length; i++) if (S.ring[i].t <= target) pick = S.ring[i];\n    const ghosts = [];\n    for (let i = 0; i < S.ring.length; i++) {\n      if (S.ring[i].t + 1e-6 < pick.t) continue;\n      ghosts.push({ t: S.ring[i].t - pick.t, cursors: S.ring[i].cursors, strains: S.ring[i].strains });\n    }\n    restoreCore(S, pick.core, true);\n    S.steady = Math.max(0, S.steady - 45);\n    S.ghosts = ghosts;\n    S.ghostT = tune.gift.lookSeconds || 6;\n    S.breath = false;\n    S.worldScale = 1;\n    pushEv(S, ['rewind', ghosts.length]);\n    return true;\n  }\n\n  function forceRewind(S, keepSteady) {\n    const steady = S.steady;\n    const breath = S.breath;\n    if (!S.ring.length) return false;\n    const target = S.worldT - 6;\n    let pick = S.ring[0];\n    for (let i = 0; i < S.ring.length; i++) if (S.ring[i].t <= target) pick = S.ring[i];\n    restoreCore(S, pick.core, true);\n    if (keepSteady) S.steady = steady;\n    S.breath = breath;\n    S.worldScale = breath ? 0.25 : 1;\n    pushEv(S, ['forced', 1]);\n    return true;\n  }\n\n  /* ---------- tools ---------- */\n\n  function polyDist(pts, x, y) {\n    let best = 1e9, arcAt = 0, along = 0, total = 0;\n    const acc = [0];\n    for (let i = 1; i < pts.length; i++) acc.push(acc[i - 1] + hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));\n    total = acc[acc.length - 1] || 1;\n    for (let i = 1; i < pts.length; i++) {\n      const ax = pts[i - 1][0], ay = pts[i - 1][1], bx = pts[i][0], by = pts[i][1];\n      const vx = bx - ax, vy = by - ay, L = hypot(vx, vy) || 1;\n      let t = ((x - ax) * vx + (y - ay) * vy) / (L * L);\n      t = clamp(t, 0, 1);\n      const px = ax + vx * t, py = ay + vy * t;\n      const d = hypot(x - px, y - py);\n      if (d < best) { best = d; along = acc[i - 1] + t * L; }\n    }\n    return { d: best, along, total, tan: tangent(pts, along) };\n  }\n  function tangent(pts, along) {\n    let left = along;\n    for (let i = 1; i < pts.length; i++) {\n      const L = hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]) || 1;\n      if (left <= L || i === pts.length - 1) {\n        return [(pts[i][0] - pts[i - 1][0]) / L, (pts[i][1] - pts[i - 1][1]) / L];\n      }\n      left -= L;\n    }\n    return [1, 0];\n  }\n\n  function nerveHit(S, p, tune) {\n    for (let i = 0; i < S.objects.length; i++) {\n      const o = S.objects[i];\n      if (o.type !== 'nerve' && o.type !== 'eloquent') continue;\n      const pts = o.guide || [[o.x - 20, o.y], [o.x + 20, o.y]];\n      if (polyDist(pts, p.x, p.y).d < 6) { slip(S, p, 'nerve', 12, tune); return true; }\n    }\n    return false;\n  }\n\n  function gradeMean(mean, a, b) {\n    if (mean <= a) return 'textbook';\n    if (mean <= b) return 'clean';\n    return 'sloppy';\n  }\n\n  function stepForceps(S, p, dt, tune) {\n    const down = p.trig > 0.3;\n    let held = p.held ? objById(S, p.held) : null;\n    if (p.trigEdge && !held) {\n      const o = nearest(S, p, 12, o => canTouch(S, o) && (o.type === 'shard' || o.type === 'fragment' || o.type === 'cork' || o.type === 'hook' || o.type === 'gaff' || o.type === 'clot' || o.type === 'mass' || o.type === 'nest' || o.type === 'note' || o.type === 'retractor' || o.type === 'screw' || (o.type === 'lobe' && o.mode === 'forceps')));\n      if (o && o.type === 'clot' && !o.dosed) { /* no grip yet */ }\n      else if (o && (o.type === 'hook' || o.type === 'gaff') && o.barbs) { slip(S, p, 'tear', 4, tune); o.tears = (o.tears || 0) + 1; }\n      else if (o && o.type === 'mass' && !o.cut) { /* ring first */ }\n      else if (o && o.type === 'nest' && !o.cut) { /* slash first */ }\n      else if (o && o.type === 'screw') { p.held = o.id; o.lastAng = Math.atan2(p.y - o.y, p.x - o.x); o.spin = o.spin || 0; }\n      else if (o && o.type === 'retractor') { p.held = o.id; }\n      else if (o) {\n        p.held = o.id; o.t0 = o.t0 || 0; o.pullT = o.pullT || 0; o.gripped = true;\n        if (!o.origin) o.origin = [o.x, o.y];\n        pushEv(S, ['grip', o.id]);\n      }\n    }\n    held = p.held ? objById(S, p.held) : null;\n    if (held && down) {\n      if (held.type === 'retractor') {\n        held.x = p.x; held.y = p.y;\n        S.windowOpen = 1;\n        return;\n      }\n      if (held.type === 'screw') {\n        const ang = Math.atan2(p.y - held.y, p.x - held.x);\n        let d = ang - (held.lastAng || ang);\n        while (d > Math.PI) d -= TAU;\n        while (d < -Math.PI) d += TAU;\n        held.spin = (held.spin || 0) + Math.abs(d);\n        held.lastAng = ang;\n        if (held.spin >= 3 * TAU) {\n          held.done = true; held.alive = false; p.held = 0;\n          award(S, p, 'textbook', 100, tune);\n          pushEv(S, ['screw', held.id]);\n        }\n        return;\n      }\n      const ox = held.origin[0], oy = held.origin[1];\n      const dx = p.x - ox, dy = p.y - oy;\n      const along = dx * held.axis[0] + dy * held.axis[1];\n      const px = dx - along * held.axis[0], py = dy - along * held.axis[1];\n      const perp = hypot(px, py);\n      const limit = held.tension || 120;\n      if (!held.free) {\n        if (p.inst > limit || perp > 8) {\n          if (held.type === 'note' || (S.strain && S.strain.kind === 'legato' && held.tag === 'legato-head')) {\n            held.snapped = true;\n            slip(S, p, 'snap', 4, tune);\n            pushEv(S, ['snap', held.id]);\n          } else {\n            held.tears = (held.tears || 0) + 1;\n            held.prog = Math.max(0, (held.prog || 0) - held.depth * 0.3);\n            slip(S, p, 'tear', 4, tune);\n            pushEv(S, ['tear', held.id]);\n          }\n        }\n        held.prog = Math.max(held.prog || 0, along);\n        held.pullT = (held.pullT || 0) + dt;\n        if (along >= held.depth) {\n          held.free = true;\n          pushEv(S, ['free', held.id]);\n        }\n      } else {\n        held.x = p.x; held.y = p.y;\n        held.pullT = (held.pullT || 0) + dt;\n      }\n    }\n    if (held && p.trigRelease) {\n      if (held.type === 'retractor') { p.held = 0; return; }\n      if (held.type === 'screw') { p.held = 0; return; }\n      const d0 = hypot(p.x - held.origin[0], p.y - held.origin[1]);\n      if (held.holdZone && hypot(p.x - held.holdZone[0], p.y - held.holdZone[1]) <= (held.holdZone[2] || 14)) {\n        held.clamped = true; held.gripped = false; p.held = 0;\n        pushEv(S, ['clamp', held.id]);\n        return;\n      }\n      if (held.free && (d0 >= 24 || outside(p.x, p.y))) {\n        const tears = held.tears || 0;\n        const parT = held.parTime || (held.depth / 80 + 0.35);\n        let g = 'sloppy';\n        if (!tears && (held.pullT || 0) <= parT) g = 'textbook';\n        else if (tears <= 1) g = 'clean';\n        held.done = true; held.alive = false; held.grade = g; p.held = 0;\n        if (held.type === 'note') p.score += 0;\n        award(S, p, g, 120, tune);\n        pushEv(S, ['dish', held.id, g]);\n      } else {\n        held.gripped = false;\n        p.held = 0;\n      }\n    }\n  }\n\n  function outside(x, y) {\n    const nx = (x - CFG.CX) / CFG.RX, ny = (y - CFG.CY) / CFG.RY;\n    return nx * nx + ny * ny > 1;\n  }\n\n  function stepScalpel(S, p, dt, tune) {\n    const down = p.trig > 0.3;\n    const tol = tune.hands.grade;\n    if (p.stroke && p.stroke.kind === 'scalpel') {\n      const o = objById(S, p.stroke.id);\n      if (!o || o.done) { p.stroke = null; }\n    }\n    if (p.trigEdge && !p.stroke) {\n      const o = nearest(S, p, 8, o => canTouch(S, o) && o.guide && (o.type === 'mass' || o.type === 'slur' || o.type === 'tendril' || o.type === 'spiral' || o.type === 'wire' || o.type === 'repeat' || o.type === 'lobe' || o.type === 'cut' || o.type === 'nest'));\n      if (o && o.guide) {\n        const start = o.guide[0];\n        if (hypot(p.x - start[0], p.y - start[1]) <= 8 + (p.mouse ? 1 : 0)) {\n          p.stroke = { kind: 'scalpel', id: o.id, far: 0, sum: 0, n: 0, off: 0, slipped: false };\n          o.cutting = true;\n        }\n      }\n    }\n    if (!(p.stroke && p.stroke.kind === 'scalpel') && down && p.inst > 40) {\n      const onGuide = S.objects.some(o => o.guide && !o.done && polyDist(o.guide, p.x, p.y).d < 8);\n      if (!onGuide && !outside(p.x, p.y)) {\n        p.bare = (p.bare || 0) + hypot(p.x - (p.ox || p.x), p.y - (p.oy || p.y));\n        if (p.bare >= 6) { slip(S, p, 'healthy', 3, tune); p.bare = 0; }\n      }\n    }\n    if (p.stroke && p.stroke.kind === 'scalpel' && down) {\n      const o = objById(S, p.stroke.id);\n      if (o && nerveHit(S, p, tune)) { /* counted */ }\n      if (o && o.guide) {\n        const hit = polyDist(o.guide, p.x, p.y);\n        const st = p.stroke;\n        if (hit.along > st.far) st.far = hit.along;\n        st.sum += hit.d; st.n += 1;\n        if (hit.d > 9) st.off += dt; else st.off = 0;\n        if (st.off >= 0.12 && !st.slipped) {\n          st.slipped = true; slip(S, p, 'slip', 3, tune);\n          pushEv(S, ['slipcut', o.id]);\n        }\n        o.prog = st.far / (hit.total || 1);\n        if (o.type === 'spiral' && o.beatLock && S.flags.onBeat) {\n          if (!st.beatSlip) { st.beatSlip = true; slip(S, p, 'beat', 3, tune); }\n          o.prog = Math.min(o.prog, st.safe || 0);\n        } else if (o.type === 'spiral') st.safe = o.prog;\n        if (st.far >= (hit.total || 1) - 0.5) {\n          const mean = st.n ? st.sum / st.n : 99;\n          const g = st.slipped ? 'sloppy' : gradeMean(mean, 1.8 * tol, 4 * tol);\n          o.done = true; o.alive = false; o.grade = g; o.cut = true;\n          if (o.type === 'mass') { o.done = false; o.alive = true; o.cut = true; o.type = 'mass'; }\n          if (o.type === 'nest') { o.done = false; o.alive = true; o.cut = true; }\n          if (o.type === 'wire') { /* caller checks order */ wireCut(S, p, o, tune); }\n          else award(S, p, g, 110, tune);\n          p.stroke = null;\n          pushEv(S, ['cut', o.id, g]);\n        }\n      }\n    }\n    if (p.trigRelease && p.stroke && p.stroke.kind === 'scalpel') {\n      const o = objById(S, p.stroke.id);\n      if (o && o.prog < 0.98) {\n        /* resume later if they come back within 6 */\n        p.stroke.paused = true;\n      }\n    }\n    if (p.trigEdge && p.stroke && p.stroke.paused) {\n      const o = objById(S, p.stroke.id);\n      if (o && o.guide) {\n        const hit = polyDist(o.guide, p.x, p.y);\n        if (Math.abs(hit.along - p.stroke.far) <= 6 || hit.d <= 6) p.stroke.paused = false;\n        else p.stroke = null;\n      }\n    }\n    /* slash variant: a fast stroke across a slash target */\n    if (down && p.inst >= 60) {\n      const o = nearest(S, p, 10, q => canTouch(S, q) && q.slash && !q.done);\n      if (o) {\n        o.done = true; o.alive = false; o.cut = true;\n        award(S, p, 'clean', 100, tune);\n        pushEv(S, ['slash', o.id]);\n      }\n    }\n  }\n\n  function wireCut(S, p, o, tune) {\n    const dev = S.device;\n    if (!dev) { o.done = true; award(S, p, 'clean', 80, tune); return; }\n    const want = dev.order[dev.next];\n    if (o.tag === want) {\n      dev.next += 1; o.done = true; o.alive = false;\n      award(S, p, 'textbook', 100, tune);\n      if (dev.next >= dev.order.length) dev.done = true;\n    } else {\n      o.done = false; o.alive = true; o.prog = 0; o.cutting = false;\n      S.vitals -= 30; S.clock = Math.max(0, S.clock - 30);\n      slip(S, p, 'wire', 0, tune);\n      pushEv(S, ['badwire', o.tag]);\n    }\n  }\n\n  function stepSuture(S, p, dt, tune) {\n    const down = p.trig > 0.3;\n    const extra = (S.activeDoc === 'sokolova' ? 1 : 0);\n    if (p.trigEdge) {\n      const o = nearest(S, p, 9 + extra, q => canTouch(S, q) && q.pairs && (q.stitch || 0) < q.pairs.length);\n      if (o) {\n        const a = o.pairs[o.stitch][0];\n        if (hypot(p.x - a[0], p.y - a[1]) <= 9 + extra) {\n          p.stroke = { kind: 'suture', id: o.id, i: o.stitch, t: 0 };\n          pushEv(S, ['needle', o.id, o.stitch]);\n        }\n      }\n    }\n    if (p.stroke && p.stroke.kind === 'suture' && down) p.stroke.t += dt;\n    if (p.stroke && p.stroke.kind === 'suture' && p.trigRelease) {\n      const o = objById(S, p.stroke.id);\n      const st = p.stroke;\n      p.stroke = null;\n      if (!o || o.done) return;\n      const b = o.pairs[st.i][1];\n      const tol = 6 + extra + (p.mouse ? 1 : 0);\n      if (hypot(p.x - b[0], p.y - b[1]) <= tol) {\n        const g = gradeMean(st.t, 0.6, 1.2);\n        o.grades = o.grades || [];\n        o.grades.push(g === 'textbook' ? 2 : g === 'clean' ? 1 : 0);\n        o.times = o.times || [];\n        o.times.push(st.t);\n        o.stitch = st.i + 1;\n        o.prog = o.stitch / o.pairs.length;\n        p.stitches += 1;\n        const bleedLeft = 1 - o.prog;\n        if (o.type === 'arteryTear') o.drain = 1 * bleedLeft;\n        else if (o.type === 'wound') o.drain = 0.4 * bleedLeft;\n        pushEv(S, ['stitch', Math.round(b[0]), Math.round(b[1]), g]);\n        if (o.stitch >= o.pairs.length) {\n          const meanT = o.times.reduce((a, c) => a + c, 0) / o.times.length;\n          const fg = gradeMean(meanT, 0.6, 1.2);\n          o.done = true; o.alive = false; o.grade = fg; o.drain = 0;\n          award(S, p, fg, 80 + 20 * o.pairs.length, tune);\n        }\n      } else {\n        slip(S, p, 'loose', 1, tune);\n        pushEv(S, ['loose', o.id]);\n      }\n    }\n  }\n\n  function stepSalve(S, p, dt, tune) {\n    if (p.trig <= 0.3) return;\n    let any = false;\n    for (let i = 0; i < S.objects.length; i++) {\n      const o = S.objects[i];\n      if (!canTouch(S, o) || !o.cells) continue;\n      if (!(o.type === 'laceration' || o.type === 'patch' || o.type === 'bite' || (o.type === 'lobe' && o.mode === 'salve'))) continue;\n      for (let c = 0; c < o.cells.length; c++) {\n        const cell = o.cells[c];\n        if (!cell[2] && hypot(cell[0] - p.x, cell[1] - p.y) <= 10) { cell[2] = 1; any = true; }\n      }\n      let on = 0;\n      for (let c = 0; c < o.cells.length; c++) if (o.cells[c][2]) on++;\n      o.prog = o.cells.length ? on / o.cells.length : 1;\n      if (o.prog >= 0.9 && !o.done) {\n        o.done = true; o.alive = false; o.drain = 0;\n        S.vitals = Math.min(99, S.vitals + 2 * tune.patient.healing);\n        award(S, p, 'clean', 80, tune);\n        pushEv(S, ['heal', o.id]);\n      }\n    }\n    if (!any && p.trigEdge) { /* salve cannot harm */ }\n  }\n\n  function stepSyringe(S, p, dt, tune) {\n    if (p.cool > 0) p.cool -= dt;\n    const down = p.trig > 0.3;\n    if (down && p.cool <= 0) {\n      if (p.fill < 1) p.fill = Math.min(1, p.fill + dt / 0.55);\n      else p.over += dt;\n    }\n    if (p.trigRelease && p.fill > 0.05 && p.cool <= 0) {\n      const bubble = p.over >= 0.3;\n      const tgt = nearest(S, p, 10, o => canTouch(S, o) && (o.type === 'clot' || o.type === 'reed' || o.type === 'voice' || (o.type === 'lobe' && o.mode === 'syringe')));\n      if (tgt) {\n        if ((tgt.type === 'reed' || tgt.type === 'voice') && !tgt.window) {\n          addObj(S, { type: 'laceration', x: tgt.x + 6, y: tgt.y, r: 8, order: 50, drain: 0.2 });\n          slip(S, p, 'spit', 2, tune);\n        } else {\n          const g = bubble ? 'sloppy' : (p.fill >= 0.9 ? 'textbook' : 'clean');\n          tgt.dosed = true;\n          tgt.dose = (bubble ? 0.5 : 1) * p.fill;\n          if (tgt.type === 'clot') { /* forceps next */ tgt.drain = 0.1; }\n          else { tgt.done = true; tgt.alive = false; tgt.drain = 0; }\n          award(S, p, g, 90, tune);\n          pushEv(S, ['inject', tgt.id, g]);\n        }\n      } else {\n        const g = bubble ? 'sloppy' : (p.fill >= 0.9 ? 'textbook' : 'clean');\n        const add = syringeDose(S, tune) * p.fill * (bubble ? 0.5 : 1);\n        S.vitals = Math.min(99, S.vitals + add);\n        award(S, p, g, 40, tune);\n        pushEv(S, ['iv', Math.round(add), g]);\n      }\n      p.fill = 0; p.over = 0; p.cool = 0.35;\n    }\n    if (!down && p.trigRelease === false) { /* keep fill while aiming */ }\n  }\n\n  function stepCautery(S, p, dt, tune) {\n    if (p.lock > 0) { p.lock -= dt; p.heat = Math.max(0, p.heat - 0.6 * dt); return; }\n    const down = p.trig > 0.3;\n    if (!down) {\n      p.heat = Math.max(0, p.heat - 0.6 * dt);\n      p.bareT = 0;\n      return;\n    }\n    p.heat += tune.fluids.cauteryHeat * dt;\n    if (p.heat >= 1) { p.lock = 1.2; p.heat = 1; slip(S, p, 'lock', 1, tune); pushEv(S, ['lock', p.id]); return; }\n    if (nerveHit(S, p, tune)) return;\n    const tgt = nearest(S, p, 6, o => canTouch(S, o) && (o.type === 'polyp' || o.type === 'bleeder' || o.type === 'rupture' || o.type === 'bead' || o.type === 'uvula' || o.type === 'eye' || o.type === 'tremass' || (o.type === 'lobe' && o.mode === 'cautery') || o.type === 'barb'));\n    if (tgt) {\n      p.bareT = 0;\n      tgt.burn = (tgt.burn || 0) + dt;\n      tgt.prog = tgt.burn / (tgt.need || 0.5);\n      if (tgt.burn >= (tgt.need || 0.5) / Math.max(0.25, tune.strains.health) && !tgt.done) {\n        const dirty = tgt.charred || p.lockedDuring;\n        const g = (!tgt.charred && p.lock <= 0 && !p.hadLock) ? 'textbook' : 'clean';\n        tgt.done = true; tgt.alive = false; tgt.drain = 0; tgt.grade = g;\n        p.burned += 1;\n        award(S, p, g, 90, tune);\n        pushEv(S, ['burn', tgt.id, g]);\n      }\n    } else {\n      p.bareT = (p.bareT || 0) + dt;\n      if (p.bareT >= 0.25) {\n        /* char on the field */\n        p.charT = (p.charT || 0) + dt;\n        S.vitals -= 0.8 * dt * tune.patient.slip;\n        if (p.bareT >= 0.6 && !p.charSlip) { p.charSlip = true; slip(S, p, 'char', 2, tune); pushEv(S, ['char', Math.round(p.x), Math.round(p.y)]); }\n      }\n    }\n  }\n\n  function stepSuction(S, p, dt, tune) {\n    if (p.trig <= 0.3) return;\n    const pool = nearest(S, p, 14, o => o.type === 'pool' && !o.done && o.vol > 0);\n    if (!pool) return;\n    const rate = tune.fluids.suction;\n    const before = pool.vol;\n    pool.vol = Math.max(0, pool.vol - rate * dt);\n    p.suctioned += before - pool.vol;\n    pool.prog = 1 - pool.vol / (pool.max || 1);\n    if (pool.vol <= 0.2) { pool.done = true; pool.alive = false; pool.vol = 0; pushEv(S, ['dry', pool.id]); }\n  }\n\n  function stepSonar(S, p, dt, tune) {\n    if (p.trig <= 0.3) return;\n    let rad = 38;\n    if (S.activeDoc === 'vale' || S.gift === 'breath') rad *= 1.25;\n    if (S.gift === 'both' && S.activeDoc === 'vale') rad *= 1.25;\n    p.sonarR = rad;\n    for (let i = 0; i < S.objects.length; i++) {\n      const o = S.objects[i];\n      if (!o.hidden || o.done) continue;\n      if (hypot(o.x - p.x, o.y - p.y) <= rad) { o.marked = true; o.markT = 4; pushEv(S, ['mark', o.id]); }\n    }\n    if (S.device && !S.device.shown && hypot(p.x - (S.device.x || 213), p.y - (S.device.y || 116)) <= rad) {\n      S.device.shown = true;\n      pushEv(S, ['board', 1]);\n    }\n    if (S.strain && S.strain.kind === 'legato') {\n      for (const w of S.strain.worms || []) if (hypot(w.x - p.x, w.y - p.y) <= rad) w.marked = true;\n    }\n  }\n\n  function applyTools(S, p, dt, tune) {\n    if (p.gone) return;\n    if (inDome(S, p.x, p.y)) return;\n    if (p.swap > 0) p.swap -= dt;\n    p.ox = p.x; p.oy = p.y;\n    const tool = p.tool;\n    if (tool === 'forceps') stepForceps(S, p, dt, tune);\n    else if (tool === 'scalpel') stepScalpel(S, p, dt, tune);\n    else if (tool === 'suture') stepSuture(S, p, dt, tune);\n    else if (tool === 'salve') stepSalve(S, p, dt, tune);\n    else if (tool === 'syringe') stepSyringe(S, p, dt, tune);\n    else if (tool === 'cautery') stepCautery(S, p, dt, tune);\n    else if (tool === 'suction') stepSuction(S, p, dt, tune);\n    else if (tool === 'sonar') stepSonar(S, p, dt, tune);\n    /* marks expire */\n  }\n\n  /* ---------- strains ---------- */\n\n  function stepStrain(S, worldDt, handDt, tune) {\n    const st = S.strain;\n    if (!st || st.done) return;\n    const sp = tune.strains.speed;\n    if (st.kind === 'staccato') stepStaccato(S, st, worldDt, tune, sp);\n    else if (st.kind === 'legato') stepLegato(S, st, worldDt, handDt, tune, sp);\n    else if (st.kind === 'tremolo') stepTremolo(S, st, worldDt, tune, sp);\n    else if (st.kind === 'dacapo') stepDacapo(S, st, worldDt, tune, sp);\n    else if (st.kind === 'fermata') stepFermata(S, st, worldDt, tune, sp);\n    else if (st.kind === 'cantor') stepCantor(S, st, worldDt, tune, sp);\n  }\n\n  function stepStaccato(S, st, dt, tune, sp) {\n    st.t += dt;\n    const beat = tune.strains.beat;\n    for (const b of st.beads) {\n      if (b.dead) continue;\n      b.landIn -= dt * sp;\n      if (!b.hopped && b.landIn < 0.5) b.hopped = true;\n      if (b.landIn <= 0 && !b.landed) {\n        b.landed = true; b.x = b.tx; b.y = b.ty;\n        addObj(S, { type: 'laceration', x: b.x, y: b.y, r: 8, order: 40, drain: 0.2, tag: 'bite' });\n        pushEv(S, ['bite', Math.round(b.x), Math.round(b.y)]);\n      }\n      if (!b.landed) {\n        const u = clamp(1 - b.landIn / b.flight, 0, 1);\n        b.x = b.x0 + (b.tx - b.x0) * u;\n        b.y = b.y0 + (b.ty - b.y0) * u;\n      }\n    }\n    /* cautery kills beads: mirrored onto objects of type bead */\n    let nests = 0;\n    for (const o of S.objects) if (o.type === 'nest' && !o.done && o.tag === st.tag) nests++;\n    if (!nests && !st.collapse) { st.collapse = 3; }\n    if (st.collapse > 0) {\n      st.collapse -= dt;\n      if (st.collapse <= 0) {\n        for (const b of st.beads) b.dead = true;\n        for (const o of S.objects) if (o.type === 'bead' && o.tag === st.tag) { o.done = true; o.alive = false; }\n        st.done = true;\n      }\n    }\n    syncBeads(S, st);\n    if (st.beads.length && st.beads.every(b => b.dead) && nests === 0) st.done = true;\n  }\n\n  function syncBeads(S, st) {\n    for (const b of st.beads) {\n      if (b.dead) continue;\n      let o = b.oid ? objById(S, b.oid) : null;\n      if (!o) {\n        o = addObj(S, { type: 'bead', x: b.x, y: b.y, need: 0.12, order: 5, tag: st.tag, drain: 0 });\n        b.oid = o.id;\n      } else {\n        o.x = b.x; o.y = b.y;\n        if (o.done) b.dead = true;\n      }\n    }\n  }\n\n  function stepLegato(S, st, dt, handDt, tune, sp) {\n    for (const w of st.worms) {\n      if (w.done) continue;\n      w.t += dt * sp;\n      /* head crawls along its path until surfaced */\n      if (!w.surfaced && !w.out) {\n        w.along = Math.min(w.pathLen, w.along + 18 * dt * sp);\n        const p = pointAlong(w.path, w.along);\n        w.x = p[0]; w.y = p[1];\n        /* open a slur guide when the head nears it */\n        for (const g of w.slurs) {\n          if (g.opened || g.done) continue;\n          if (hypot(w.x - g.x, w.y - g.y) < 28) {\n            g.opened = true;\n            const o = addObj(S, { type: 'slur', x: g.x, y: g.y, len: 18, order: 1, tag: 'slur-' + w.id + '-' + g.i, drain: 0, guide: [[g.x - 9, g.y], [g.x + 9, g.y]] });\n            g.oid = o.id;\n          }\n        }\n      }\n      for (const g of w.slurs) {\n        if (!g.oid || g.done) continue;\n        const o = objById(S, g.oid);\n        if (o && o.done) g.done = true;\n      }\n      const slursLeft = w.slurs.filter(g => !g.done).length;\n      if (!slursLeft && !w.surfaced) {\n        w.surfaced = true; w.marked = true;\n        const head = addObj(S, {\n          type: 'shard', x: w.x, y: w.y, axis: w.axis || [1, 0], depth: 18, order: 2,\n          tag: 'legato-head', worm: w.id, tension: 70, drain: 0.15, hidden: false,\n          holdZone: w.hold || null, barbs: w.barbAt || 0,\n        });\n        w.head = head.id;\n      }\n      const head = w.head ? objById(S, w.head) : null;\n      if (head && head.snapped && !w.snapped) {\n        w.snapped = true; st.snapped = true;\n        /* regrow a head further along and flee */\n        head.done = true; head.alive = false;\n        w.surfaced = false; w.out = false; w.head = 0;\n        w.along = Math.min(w.pathLen - 4, w.along + 30);\n        w.slurs.push({ i: 90 + w.slurs.length, x: w.x + 16, y: w.y, opened: false, done: false });\n        pushEv(S, ['regrow', w.id]);\n      }\n      if (head && head.done && !w.out) {\n        w.pulled = (w.pulled || 0) + 1;\n        /* barb every 4th segment: if not clamped, snapping already handled via tension */\n        if (w.barbAt && w.pulled % 4 === 0 && !head.clamped && !w.barbCleared) {\n          /* require a clamp before the next length counts — head.done means the whole pull finished.\n             Barbs are separate cautery objects spawned at the hold. */\n        }\n        w.segments -= 4;\n        if (w.segments <= w.half && !w.split && st.worms.length < 3) {\n          w.split = true; w.half = -1;\n          st.worms.push(makeWorm(S, w.x + 20, w.y + 14, Math.max(4, w.segments >> 1), w.id + 1));\n          pushEv(S, ['split', w.id]);\n        }\n        if (w.segments <= 0) { w.done = true; w.out = true; }\n        else {\n          /* next length */\n          w.out = false; w.surfaced = true;\n          const h2 = addObj(S, {\n            type: 'shard', x: w.x, y: w.y, axis: [1, 0], depth: 14, order: 2,\n            tag: 'legato-head', worm: w.id, tension: 70, drain: 0.1,\n            holdZone: w.barbAt && (w.pulled % 4 === 0) ? [w.x + 30, w.y, 16] : null,\n          });\n          w.head = h2.id;\n          if (w.barbAt && w.pulled % 4 === 0) {\n            addObj(S, { type: 'barb', x: w.x + 30, y: w.y, need: 0.35, order: 3, tag: 'barb-' + w.id, drain: 0 });\n          }\n        }\n      }\n    }\n    if (st.worms.every(w => w.done)) st.done = true;\n  }\n\n  function makeWorm(S, x, y, segments, id) {\n    const path = [];\n    for (let i = 0; i < 8; i++) path.push([x + i * 14, y + Math.sin(i) * 8]);\n    let pathLen = 0;\n    for (let i = 1; i < path.length; i++) pathLen += hypot(path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1]);\n    const slurs = [0.25, 0.5, 0.75].map((u, i) => {\n      const p = pointAlong(path, pathLen * u);\n      return { i, x: p[0], y: p[1], opened: false, done: false };\n    });\n    return { id, x, y, path, pathLen, along: 0, segments, half: segments / 2, slurs, surfaced: false, done: false, t: 0, split: false, pulled: 0, barbAt: 4, marked: false, axis: [1, 0] };\n  }\n  function pointAlong(path, dist) {\n    let left = dist;\n    for (let i = 1; i < path.length; i++) {\n      const L = hypot(path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1]) || 1;\n      if (left <= L) {\n        const u = left / L;\n        return [path[i - 1][0] + (path[i][0] - path[i - 1][0]) * u, path[i - 1][1] + (path[i][1] - path[i - 1][1]) * u];\n      }\n      left -= L;\n    }\n    return path[path.length - 1].slice();\n  }\n\n  function stepTremolo(S, st, dt, tune) {\n    st.t += dt;\n    st.beat = (st.t % 0.8) / 0.8;\n    const peak = st.beat > 0.85 || st.beat < 0.1;\n    st.flare = peak;\n    S.flags.onBeat = st.beat > 0.45 && st.beat < 0.7 ? false : st.beat < 0.15;\n    /* vitals shake and drain */\n    if (!S.breath) S.vitals -= 0.6 * st.amp * dt * tune.strains.damage;\n    for (const o of S.objects) if (o.type === 'reed' && o.tag === 'reed') o.window = !!st.flare;\n    const reeds = S.objects.filter(o => o.type === 'reed' && !o.done);\n    if (st.stage === 1 && reeds.length === 0) { st.stage = 2; st.amp = Math.min(st.amp, 0.2); }\n    if (st.amp <= 0.2 && st.stage === 1) st.stage = 2;\n    if (st.stage === 2) {\n      st.wake -= dt;\n      if (st.wake <= 0) {\n        st.wake = 6;\n        /* a reed returns */\n        if (S.objects.filter(o => o.type === 'reed' && !o.done).length < 2) {\n          addObj(S, { type: 'reed', x: st.x - 20 + rnd(S) * 40, y: st.y - 10, order: 1, tag: 'reed', drain: 0, window: false });\n        }\n      }\n      const mass = S.objects.find(o => o.type === 'tremass');\n      if (mass && mass.done && st.stage === 2) {\n        st.stage = 3;\n        addObj(S, { type: 'shard', x: st.x, y: st.y, axis: [1, 0], depth: 40, order: 4, tag: 'tremolo-pull', tension: 90, drain: 0.2 });\n      }\n    }\n    if (st.stage === 3) {\n      const pull = S.objects.find(o => o.tag === 'tremolo-pull');\n      if (pull && pull.done) st.done = true;\n    }\n    /* amp falls when a reed is dosed */\n    const deadReeds = st.reed0 - S.objects.filter(o => o.type === 'reed' && !o.done).length;\n    st.amp = clamp(1 - deadReeds * 0.2, 0.15, 1);\n    if (st.stage >= 2) st.amp = Math.min(st.amp, 0.2);\n  }\n\n  function stepDacapo(S, st, dt, tune, sp) {\n    st.t += dt * sp * (st.round === 2 ? 2 : 1);\n    let anyDead = false;\n    for (const L of st.lobes) {\n      if (L.dead) { anyDead = true; continue; }\n      const period = L.period / (st.round === 2 ? 2 : 1);\n      const openFor = L.openFor / (st.round === 2 ? 2 : 1);\n      const u = st.t % period;\n      L.open = u < openFor;\n      const o = objById(S, L.oid);\n      if (o) { o.open = L.open && !L.dead; o.x = L.x; o.y = L.y; if (o.done && !L.dead) { L.dead = true; anyDead = true; if (st.count < 0) st.count = 10; } }\n    }\n    if (st.count >= 0) {\n      st.count -= dt;\n      if (st.count <= 0 && st.lobes.some(L => L.dead) && st.lobes.some(L => !L.dead)) {\n        /* from the top */\n        for (const L of st.lobes) {\n          L.dead = false;\n          const o = objById(S, L.oid);\n          if (o) { o.done = false; o.alive = true; o.prog = 0; o.burn = 0; o.dosed = false; o.open = false; if (o.cells) for (const c of o.cells) c[2] = 0; }\n        }\n        S.vitals -= 8;\n        st.count = -1;\n        st.repeated = (st.repeated || 0) + 1;\n        if (st.round === 1) { st.round = 2; st.t = 0; spawnBeadsN(S, st, 4); }\n        pushEv(S, ['dacapo', st.repeated]);\n      } else if (st.count <= 0) st.count = -1;\n    }\n    if (st.lobes.every(L => L.dead) && st.count < 0) {\n      if (st.round === 1) {\n        st.round = 2; st.t = 0; st.count = -1;\n        for (const L of st.lobes) {\n          L.dead = false;\n          const o = objById(S, L.oid);\n          if (o) { o.done = false; o.alive = true; o.prog = 0; o.burn = 0; o.dosed = false; if (o.cells) for (const c of o.cells) c[2] = 0; }\n        }\n        spawnBeadsN(S, st, 4);\n        pushEv(S, ['round2', 1]);\n      } else if (S.objects.every(o => o.type !== 'bead' || o.done)) st.done = true;\n    }\n    if (st.round === 2 && st.lobes.every(L => L.dead) && S.objects.every(o => o.type !== 'bead' || o.done || o.tag !== 'dacapo-bead')) st.done = true;\n  }\n\n  function spawnBeadsN(S, st, n) {\n    st.beads = st.beads || [];\n    for (let i = 0; i < n; i++) {\n      const b = { x: 180 + i * 16, y: 100, tx: 190 + i * 14, ty: 130, x0: 180 + i * 16, y0: 100, landIn: 0.8, flight: 0.8, dead: false, landed: false, hopped: false };\n      st.beads.push(b);\n      const o = addObj(S, { type: 'bead', x: b.x, y: b.y, need: 0.12, order: 6, tag: 'dacapo-bead', drain: 0 });\n      b.oid = o.id;\n    }\n    if (!st.kindBead) st.kindBead = true;\n  }\n\n  function stepFermata(S, st, dt, tune) {\n    st.t += dt;\n    for (const d of st.domes) if (d.t > 0) d.t -= dt;\n    st.domes = st.domes.filter(d => d.t > 0);\n    if (st.stage === 1 && st.domes.length === 0 && !st.eyeOpen) {\n      st.eyeOpen = S.breath ? 2.8 : 0.7;\n      st.eye.open = true;\n      const o = objById(S, st.eye.oid);\n      if (o) o.open = true;\n    }\n    if (st.eyeOpen > 0) {\n      st.eyeOpen -= dt;\n      if (st.eyeOpen <= 0) {\n        st.eye.open = false;\n        const o = objById(S, st.eye.oid);\n        if (o && !o.done) o.open = false;\n        if (st.hits < 3 && st.stage === 1) {\n          /* raise another dome */\n          if (st.domes.length < 3) st.domes.push({ x: st.eye.x, y: st.eye.y, r: 34, t: 5 });\n        }\n      }\n    }\n    const eye = objById(S, st.eye.oid);\n    if (eye && eye.done) { st.hits += 1; eye.done = false; eye.alive = true; eye.burn = 0; eye.prog = 0; eye.open = false; st.eye.open = false; }\n    if (st.hits >= 3 && st.stage === 1) {\n      st.stage = 2;\n      st.eye.x = 250; st.eye.y = 90; st.eye.hidden = true;\n      if (eye) { eye.x = 250; eye.y = 90; eye.hidden = true; eye.marked = false; eye.done = false; eye.alive = true; }\n      addObj(S, { type: 'shard', x: 160, y: 140, axis: [1, 0], depth: 12, order: 3, tag: 'sliver-a', drain: 0.1, hidden: true });\n      addObj(S, { type: 'shard', x: 180, y: 150, axis: [0.6, 0.8], depth: 12, order: 3, tag: 'sliver-b', drain: 0.1, hidden: true });\n    }\n    if (st.stage === 2 && eye && eye.marked) eye.hidden = false;\n    if (st.stage === 2 && eye && eye.done && S.objects.every(o => o.tag !== 'sliver-a' && o.tag !== 'sliver-b' || o.done)) {\n      /* eye.done was consumed as a hit; require the flee eye burned once more and slivers out */\n    }\n    if (st.stage === 2) {\n      const slivers = S.objects.filter(o => o.tag === 'sliver-a' || o.tag === 'sliver-b');\n      const eyeBurned = st.hits >= 4;\n      if (eye && eye.done) st.hits = Math.max(st.hits, 4);\n      if (eyeBurned && slivers.every(o => o.done)) {\n        st.stage = 3;\n        addObj(S, { type: 'note', x: st.eye.x, y: st.eye.y, axis: [0, -1], depth: 28, tension: 40, order: 5, tag: 'fermata-pull', drain: 0.15 });\n      }\n    }\n    if (st.stage === 3) {\n      const pull = S.objects.find(o => o.tag === 'fermata-pull');\n      if (pull && pull.done) st.done = true;\n    }\n  }\n\n  function stepCantor(S, st, dt, tune) {\n    st.t += dt;\n    if (st.move === 1) {\n      /* tendrils then uvulas, objects already spawned by the phase */\n      const left = S.objects.filter(o => (o.tag === 'tendril' || o.tag === 'uvula') && !o.done);\n      if (!left.length) { st.move = 2; st.t = 0; S.clock += 120; S.flags.hush = true; pushEv(S, ['movement', 2]); spawnVoice(S, st); }\n    } else if (st.move === 2) {\n      S.flags.hush = true;\n      st.beat = (st.t % 0.9);\n      for (const o of S.objects) if (o.type === 'voice') o.window = st.beat > 0.35 && st.beat < 0.7;\n      if (st.domes && st.t > 2 && st.domes.length < 2 && Math.floor(st.t) % 5 === 0) {\n        /* one dome refreshes */\n      }\n      st.jitter = true;\n      const voices = S.objects.filter(o => o.type === 'voice' && !o.done);\n      if (!voices.length) { st.move = 3; st.t = 0; S.clock += 120; S.flags.hush = false; st.signs = 0; pushEv(S, ['movement', 3]); }\n    } else if (st.move === 3) {\n      st.cycleT = (st.cycleT || 0) + dt;\n      if (!st.winding && st.cycleT >= 20) { st.winding = 3; st.cycleT = 0; openRepeat(S, st); }\n      if (st.winding > 0) {\n        st.winding -= dt;\n        if (st.winding <= 0) {\n          const sign = S.objects.find(o => o.tag === 'repeat' && !o.done);\n          if (sign) {\n            forceRewind(S, true);\n            st.rewound = (st.rewound || 0) + 1;\n          } else st.signs = (st.signs || 0) + 1;\n          st.winding = 0;\n          closeRepeat(S);\n        }\n      }\n      const sign = S.objects.find(o => o.tag === 'repeat' && o.done);\n      if (sign) { st.signs = (st.signs || 0) + 1; sign.tag = 'repeat-spent'; }\n      if ((st.signs || 0) >= 6) { st.move = 4; st.t = 0; S.clock += 120; pushEv(S, ['movement', 4]); spawnCoda(S, st); }\n    } else if (st.move === 4) {\n      st.beat = (st.t % 0.8) / 0.8;\n      S.flags.onBeat = st.beat < 0.25;\n      const spiral = S.objects.find(o => o.type === 'spiral' && o.tag === 'last-note');\n      const note = S.objects.find(o => o.tag === 'the-note');\n      const wound = S.objects.find(o => o.tag === 'final-wound');\n      if (spiral && spiral.done && !st.noteOut) {\n        st.noteOut = true;\n        addObj(S, { type: 'note', x: 213, y: 116, axis: [0, -1], depth: 36, tension: 80, order: 2, tag: 'the-note', drain: 0 });\n      }\n      if (note && note.done && !wound) {\n        addObj(S, { type: 'wound', x: 213, y: 130, stitches: 6, order: 3, tag: 'final-wound', drain: 0.3 });\n      }\n      if (wound && wound.done) st.done = true;\n    }\n  }\n\n  function openRepeat(S, st) {\n    const existing = S.objects.find(o => o.tag === 'repeat');\n    if (existing) { existing.done = false; existing.alive = true; existing.open = true; existing.prog = 0; return existing; }\n    return addObj(S, { type: 'repeat', x: 213, y: 100, len: 36, order: 1, tag: 'repeat', open: true, drain: 0, guide: [[190, 100], [236, 100]] });\n  }\n  function closeRepeat(S) {\n    for (const o of S.objects) if (o.tag === 'repeat' && !o.done) { o.open = false; }\n  }\n  function spawnVoice(S, st) {\n    st.domes = [{ x: 180, y: 120, r: 34, t: 4 }, { x: 240, y: 110, r: 34, t: 5 }];\n    for (let i = 0; i < 3; i++) addObj(S, { type: 'voice', x: 200 + i * 14, y: 116, hidden: true, order: 1, tag: 'voice', drain: 0.2, window: false });\n    st.jitter = true; st.amp = 0.6;\n  }\n  function spawnCoda(S, st) {\n    const guide = [];\n    for (let i = 0; i <= 16; i++) {\n      const a = i / 16 * Math.PI * 1.6;\n      guide.push([213 + Math.cos(a) * (20 + i * 3), 116 + Math.sin(a) * (12 + i * 2)]);\n    }\n    addObj(S, { type: 'spiral', x: 213, y: 116, guide, order: 1, tag: 'last-note', beatLock: true, drain: 0, ring: false });\n  }\n\n  function spawnStrain(S, kind, opts) {\n    opts = opts || {};\n    if (kind === 'staccato') {\n      const st = { kind, tag: opts.tag || 'stacc', t: 0, beads: [], done: false, collapse: 0 };\n      const n = opts.nests || 2;\n      for (let i = 0; i < n; i++) {\n        addObj(S, { type: 'nest', x: opts.x || (180 + i * 40), y: opts.y || 120, hidden: true, order: 2, tag: st.tag, slash: true, drain: 0.15, r: 8 });\n      }\n      const beads = opts.beads || 4;\n      for (let i = 0; i < beads; i++) {\n        st.beads.push({ x: 160 + i * 12, y: 90, x0: 160 + i * 12, y0: 90, tx: 170 + (i % 3) * 18, ty: 140, landIn: 0.6 + i * 0.15, flight: 0.7, dead: false, landed: false, hopped: false });\n      }\n      S.strain = st;\n      return st;\n    }\n    if (kind === 'legato') {\n      const seg = opts.segments || 8;\n      const w = makeWorm(S, opts.x || 150, opts.y || 120, seg, 1);\n      w.marked = false;\n      const st = { kind, worms: [w], done: false, snapped: false };\n      /* head starts hidden: a sonar target */\n      addObj(S, { type: 'hold', x: w.x, y: w.y, hidden: true, order: 0, tag: 'legato-hide', drain: 0 });\n      S.strain = st;\n      return st;\n    }\n    if (kind === 'tremolo') {\n      const st = { kind, t: 0, amp: 1, stage: 1, x: opts.x || 213, y: opts.y || 116, wake: 6, reed0: 5, done: false, jitter: true, beat: 0, flare: false };\n      for (let i = 0; i < 5; i++) {\n        const a = -Math.PI / 2 + i * TAU / 5;\n        addObj(S, { type: 'reed', x: st.x + Math.cos(a) * 28, y: st.y + Math.sin(a) * 18, order: 1, tag: 'reed', drain: 0, window: false });\n      }\n      addObj(S, { type: 'tremass', x: st.x, y: st.y, need: 3, order: 3, tag: 'tremass', drain: 0.3 });\n      S.strain = st;\n      return st;\n    }\n    if (kind === 'dacapo') {\n      const lobes = [\n        { id: 'A', mode: 'cautery', period: 6, openFor: 2.5, x: 180, y: 110 },\n        { id: 'B', mode: 'slash', period: 7, openFor: 2.5, x: 213, y: 130 },\n        { id: 'C', mode: 'syringe', period: 9, openFor: 3, x: 246, y: 112 },\n      ];\n      const st = { kind, t: 0, round: 1, count: -1, lobes, done: false, repeated: 0 };\n      for (const L of lobes) {\n        const spec = { type: 'lobe', x: L.x, y: L.y, mode: L.mode === 'slash' ? 'scalpel' : L.mode, order: 1, tag: 'lobe-' + L.id, open: false, drain: 0.15, need: L.mode === 'cautery' ? 1 : 0.5 };\n        if (L.mode === 'slash') { spec.guide = [[L.x - 10, L.y], [L.x + 10, L.y]]; spec.mode = 'scalpel'; spec.slash = true; }\n        if (L.mode === 'syringe') { spec.mode = 'syringe'; spec.follow = 'salve'; }\n        const o = addObj(S, spec);\n        L.oid = o.id; L.dead = false; L.open = false;\n      }\n      S.strain = st;\n      return st;\n    }\n    if (kind === 'fermata') {\n      const st = { kind, t: 0, stage: 1, hits: 0, eyeOpen: 0, done: false, jitter: false, amp: 0,\n        domes: [{ x: 200, y: 116, r: 34, t: 5 }],\n        eye: { x: 200, y: 116, open: false, hidden: false } };\n      const o = addObj(S, { type: 'eye', x: 200, y: 116, need: 0.3, order: 1, tag: 'eye', open: false, drain: 0.2 });\n      st.eye.oid = o.id;\n      addObj(S, { type: 'eloquent', x: 150, y: 100, guide: [[140, 90], [180, 110]], order: 0, drain: 0, tag: 'eloq' });\n      S.strain = st;\n      return st;\n    }\n    if (kind === 'cantor') {\n      const st = { kind, t: 0, move: 1, done: false, signs: 0, jitter: false, amp: 0.4, domes: [] };\n      for (let i = 0; i < 3; i++) addObj(S, { type: 'tendril', x: 170 + i * 30, y: 100, len: 28, order: 1, tag: 'tendril', drain: 0.15, guide: [[160 + i * 30, 100], [190 + i * 30, 108]] });\n      for (let i = 0; i < 3; i++) addObj(S, { type: 'uvula', x: 180 + i * 26, y: 140, need: 1.5, order: 2, tag: 'uvula', drain: 0.2 });\n      S.strain = st;\n      return st;\n    }\n    return null;\n  }\n\n  /* ---------- phase / scripts ---------- */\n\n  function phaseClear(S) {\n    if (S.strain && !S.strain.done) return false;\n    for (const o of S.objects) {\n      if (o.done || !o.alive) continue;\n      if (o.type === 'nerve' || o.type === 'eloquent' || o.type === 'hold') continue;\n      if (o.optional) continue;\n      if (o.type === 'bead') continue;\n      return false;\n    }\n    if (S.strain && S.strain.kind === 'staccato') {\n      const live = (S.strain.beads || []).some(b => !b.dead);\n      if (live && !S.strain.done) return false;\n    }\n    return true;\n  }\n\n  function runScript(S, id, tune) {\n    if (id === 'dip') { S.flags.dip = 40; }\n    else if (id === 'crash') { S.flags.crash = 8; }\n    else if (id === 'breath') { S.flags.needBreath = true; }\n    else if (id === 'look') { S.flags.needLook = true; }\n    else if (id === 'lurch') {\n      slip(S, S.players[0], 'lurch', 3, tune);\n      for (const o of S.objects) if (!o.done) { o.x += 10; o.y += 4; if (o.origin) { o.origin = [o.origin[0] + 10, o.origin[1] + 4]; } }\n      S.flags.needLook = true;\n      pushEv(S, ['lurch', 1]);\n    } else if (id === 'blackout') { S.dim = 1; }\n    else if (id === 'roll') { S.tiltAmp = 1; }\n    else if (id === 'quiet') { S.flags.quiet = true; S.flags.needBreath = true; }\n    else if (id === 'refill') { S.clock += 120; }\n    else if (id === 'cantorRewind') { forceRewind(S, true); }\n    else if (id === 'code') { S.vitals = 0; }\n  }\n\n  function stepWorld(S, worldDt, handDt, tune) {\n    if (S.flags.dip) {\n      S.vitals += (S.flags.dip - S.vitals) * Math.min(1, worldDt * 2);\n      if (Math.abs(S.vitals - S.flags.dip) < 0.4) { S.vitals = S.flags.dip; S.flags.dip = 0; }\n    }\n    if (S.flags.crash) {\n      S.vitals -= S.flags.crash * worldDt;\n    }\n    if (S.tiltAmp) {\n      const drift = Math.sin(S.worldT * 0.7) * 25 * S.tiltAmp;\n      for (const o of S.objects) if (o.type === 'pool' && !o.done) {\n        o.x = clamp(o.x + drift * worldDt, 60, 360);\n      }\n    }\n    for (const o of S.objects) {\n      if (o.markT > 0) { o.markT -= handDt; if (o.markT <= 0 && o.hidden) o.marked = false; }\n      if (o.type === 'bleeder' && !o.done) {\n        let pool = S.objects.find(p => p.type === 'pool' && p.tag === 'fed-' + o.id);\n        if (!pool) pool = addObj(S, { type: 'pool', x: o.x, y: o.y + 8, vol: 4, max: 40, order: o.order + 1, tag: 'fed-' + o.id, drain: 0 });\n        if (!pool.done) pool.vol = Math.min(pool.max, pool.vol + 6 * worldDt * tune.fluids.bleed);\n      }\n      if (o.type === 'arteryTear' && !o.done) {\n        let pool = S.objects.find(p => p.type === 'pool' && p.tag === 'fed-' + o.id);\n        if (!pool) pool = addObj(S, { type: 'pool', x: o.x, y: o.y + 6, vol: 6, max: 50, order: o.order + 1, tag: 'fed-' + o.id, drain: 0 });\n        if (!pool.done) pool.vol = Math.min(pool.max, pool.vol + 14 * worldDt * tune.fluids.bleed);\n      }\n    }\n    /* solo retractor: Quill holds at half the window */\n    const retract = S.objects.find(o => o.type === 'retractor' && !o.done);\n    if (retract) {\n      const holder = S.players.some(p => p.held === retract.id && p.trig > 0.3);\n      if (holder) S.windowOpen = 1;\n      else if (S.players.filter(p => !p.gone).length <= 1) S.windowOpen = 0.5;\n      else S.windowOpen = 0;\n    }\n    for (let i = 0; i < S.scripts.length; i++) {\n      const sc = S.scripts[i];\n      if (sc.done) continue;\n      if (S.phaseT >= sc.t) { sc.done = true; runScript(S, sc.do, tune); }\n    }\n  }\n\n  function loadPhase(S, def, index) {\n    const ph = def.phases[index];\n    S.phase = index;\n    S.phaseCount = def.phases.length;\n    S.phaseName = ph.name;\n    S.phaseT = 0;\n    S.objects = S.objects.filter(o => o.persist);\n    S.strain = null;\n    S.scripts = (ph.at || []).map(a => ({ t: a.t, do: a.do, done: false }));\n    S.tutorial = !!ph.tutorial;\n    S.tutDone = !ph.tutorial;\n    S.flags = Object.assign({}, S.flags, ph.flags || {});\n    if (ph.dim != null) S.dim = ph.dim;\n    if (ph.tilt) S.tiltAmp = ph.tilt;\n    for (const spec of ph.objects || []) addObj(S, clone(spec));\n    if (ph.strain) spawnStrain(S, ph.strain, ph.strainOpts || {});\n    if (ph.onEnter) runScript(S, ph.onEnter, tuneOf(null));\n    S.checkpoint = takeCore(S);\n    /* drop the checkpoint's nested copy weight: checkpoint is the core itself */\n    pushEv(S, ['phase', index, ph.name]);\n  }\n\n  function advancePhase(S) {\n    const def = (GAME.CASES || {})[S.id];\n    if (!def) { finishCase(S); return; }\n    if (S.phase + 1 >= def.phases.length) {\n      if (!S.dressing && !S.won) {\n        S.dressing = { t: 0, done: false };\n        pushEv(S, ['dressing', 1]);\n        return;\n      }\n      return;\n    }\n    loadPhase(S, def, S.phase + 1);\n  }\n\n  function create(def, opts) {\n    opts = opts || {};\n    const diff = opts.difficulty || opts.diff || 'resident';\n    const clockMul = diff === 'intern' ? 1.3 : diff === 'attending' ? 0.8 : 1;\n    const S = blank({\n      id: def.id, seed: opts.seed || def.seed || 1, players: opts.players || 1,\n      difficulty: diff, clock: def.clock * clockMul, vitals: def.vitals, drain: def.drain,\n      gift: def.doctor === 'sokolova' ? 'look' : def.doctor === 'both' ? 'both' : 'breath',\n      doctor: def.doctor || 'vale', site: def.site, par: def.par || 1000,\n      mode: def.mode || 'case', consult: !!def.consult,\n    });\n    S.clock0 = S.clock;\n    if (def.doctor === 'both') S.consult = true;\n    loadPhase(S, def, opts.phase || 0);\n    return S;\n  }\n\n  function createRaw(opts) {\n    const S = blank(opts);\n    for (const spec of opts.objects || []) addObj(S, clone(spec));\n    if (opts.strain) spawnStrain(S, opts.strain, opts.strainOpts || {});\n    if (opts.scripts) S.scripts = opts.scripts.map(a => ({ t: a.t, do: a.do, done: false }));\n    S.checkpoint = takeCore(S);\n    return S;\n  }\n\n  function readInputs(S, inputs, dt) {\n    inputs = inputs || [];\n    for (let i = 0; i < S.players.length; i++) {\n      const p = S.players[i];\n      const inp = inputs[i] || {};\n      const ox = p.x, oy = p.y;\n      if (inp.x != null) { p.x = inp.x; p.y = inp.y; p.bx = inp.x; p.by = inp.y; }\n      if (inp.tool) p.tool = inp.tool;\n      p.inst = hypot(p.x - ox, p.y - oy) / Math.max(dt, 1e-4);\n      p.fine = !!inp.fine;\n      p.mouse = !!inp.mouse;\n      const trig = inp.trig || 0;\n      p.trigEdge = trig > 0.3 && p.prevTrig <= 0.3;\n      p.trigRelease = trig <= 0.3 && p.prevTrig > 0.3;\n      p.prevTrig = trig;\n      p.trig = trig;\n      const gift = !!inp.gift;\n      p.giftEdge = gift && !p.giftPrev;\n      p.giftPrev = gift;\n      const consult = !!inp.consult;\n      p.consultEdge = consult && !p.consultPrev;\n      p.consultPrev = consult;\n      p.cancelEdge = !!inp.cancel;\n      if (p.cancelEdge) { p.held = 0; p.stroke = null; }\n    }\n  }\n\n  function tryGifts(S, tune) {\n    for (const p of S.players) {\n      if (!p.giftEdge) continue;\n      if (S.breath) { S.breath = false; S.worldScale = 1; pushEv(S, ['breath', 0]); continue; }\n      const doc = S.activeDoc;\n      const wantLook = doc === 'sokolova' || (S.gift === 'look' && doc !== 'vale');\n      const wantBreath = doc === 'vale' || S.gift === 'breath' || (S.gift === 'both' && doc === 'vale');\n      if (S.gift === 'both') {\n        if (doc === 'sokolova') { if (secondLook(S, tune)) return; }\n        else if (S.steady >= 35) { S.breath = true; pushEv(S, ['breath', 1]); return; }\n      } else if (S.gift === 'look' || wantLook && S.gift !== 'breath') {\n        secondLook(S, tune);\n      } else if (wantBreath && S.steady >= 35) {\n        S.breath = true;\n        pushEv(S, ['breath', 1]);\n      }\n    }\n    for (const p of S.players) {\n      if (!p.consultEdge || !S.consult) continue;\n      S.activeDoc = S.activeDoc === 'vale' ? 'sokolova' : 'vale';\n      pushEv(S, ['consult', S.activeDoc]);\n    }\n  }\n\n  function stepCodeBlue(S, dt) {\n    const cb = S.codeBlue;\n    if (!cb) return;\n    cb.t += dt;\n    const peaks = [0.9, 1.8, 2.7, 3.6];\n    const p = S.players[0];\n    if (cb.next == null) cb.next = 0;\n    if (cb.next < 4) {\n      const peak = peaks[cb.next];\n      if (p && p.trigEdge) {\n        const err = Math.abs(cb.t - peak);\n        cb.attempts += 1;\n        if (err <= 0.14) {\n          cb.hits += 1;\n          if (err <= 0.06) cb.textbook = (cb.textbook || 0) + 1;\n          pushEv(S, ['shock', cb.hits, err]);\n        } else pushEv(S, ['miss', err]);\n        cb.next += 1;\n      } else if (cb.t > peak + 0.14) {\n        cb.attempts += 1;\n        cb.next += 1;\n        pushEv(S, ['miss', 1]);\n      }\n    }\n    if (cb.next >= 4 && !cb.resolved) {\n      cb.resolved = true;\n      S.codeBlue = null;\n      if (cb.hits >= 2) {\n        S.vitals = 30;\n        S.flags.crash = 0;\n        pushEv(S, ['revived', cb.textbook >= 2 ? 'textbook' : 'clean']);\n      } else lose(S, 'code');\n    }\n  }\n\n  function maybeDie(S) {\n    if (S.won || S.lost || S.codeBlue || S.dressing) return;\n    if (S.clock <= 0) { lose(S, 'time'); return; }\n    if (S.vitals <= 0) {\n      if (S.diff === 'attending' || S.codeBlueUsed) { lose(S, 'vitals'); return; }\n      S.codeBlueUsed = true;\n      S.codeBlue = { t: 0, hits: 0, attempts: 0, next: 0, textbook: 0, resolved: false };\n      S.vitals = 0;\n      S.breath = false;\n      pushEv(S, ['codeblue', 1]);\n    }\n  }\n\n  function stepDressing(S, dt, tune) {\n    const d = S.dressing;\n    d.t += dt;\n    const u = (d.t % 1.2) / 1.2;\n    const edge = Math.min(u, 1 - u);\n    const p = S.players[0];\n    if (p && p.trigEdge) {\n      const bonus = edge < 0.08 ? 80 : 20;\n      S.score += bonus;\n      d.done = true;\n      pushEv(S, ['stamp', bonus]);\n      finishCase(S);\n    } else if (d.t > 4) {\n      d.done = true;\n      finishCase(S);\n    }\n  }\n\n  function step(S, inputs, dt, tune) {\n    tune = tuneOf(tune);\n    if (!dt || dt < 0) dt = 0;\n    S.ev = [];\n    if (S.won || S.lost) return S;\n    readInputs(S, inputs, dt);\n    if (S.codeBlue) { stepCodeBlue(S, dt); return S; }\n    tryGifts(S, tune);\n    if (S.breath) {\n      S.steady = Math.max(0, S.steady - tune.gift.breathDrain * dt);\n      if (S.steady <= 0) { S.breath = false; pushEv(S, ['breath', 0]); }\n    }\n    S.worldScale = S.breath ? tune.gift.breathFactor : 1;\n    const worldDt = dt * S.worldScale;\n    if (S.dressing) { stepDressing(S, dt, tune); return S; }\n\n    const frozen = S.tutorial && !S.tutDone;\n    if (!frozen) {\n      let hazard = 0;\n      for (const o of S.objects) {\n        if (o.done || !o.drain) continue;\n        if (inDome(S, o.x, o.y)) continue;\n        hazard += o.drain;\n      }\n      const bleed = hazard * tune.fluids.bleed * tune.strains.damage;\n      S.vitals -= (S.drain * tune.patient.drain * diffDrain(S) + bleed) * worldDt;\n      S.clock -= worldDt * tune.patient.clock / diffClock(S);\n      S.steady = Math.min(100, S.steady + 0.5 * tune.gift.charge * worldDt);\n    }\n    S.t += dt;\n    S.worldT += frozen ? 0 : worldDt;\n    S.phaseT += frozen ? 0 : worldDt;\n\n    for (const p of S.players) applyTools(S, p, dt, tune);\n    if (!frozen) {\n      stepWorld(S, worldDt, dt, tune);\n      stepStrain(S, worldDt, dt, tune);\n    }\n    if (S.ghostT > 0) S.ghostT -= dt;\n\n    if (!frozen) {\n      S.ringAcc += worldDt;\n      while (S.ringAcc >= 0.1) { S.ringAcc -= 0.1; pushRing(S); }\n    }\n\n    maybeDie(S);\n    if (!S.lost && !S.won && !S.codeBlue && phaseClear(S)) advancePhase(S);\n    return S;\n  }\n\n  /* ---------- cursor and wheel ---------- */\n\n  function assistOf(S, tune) {\n    let a = tune.hands.assist;\n    if (S && S.diff === 'intern') a += 0.2;\n    if (S && (S.activeDoc === 'sokolova')) a += 0.2;\n    return clamp(a, 0, 1.4);\n  }\n\n  function jitterOf(S, p) {\n    const st = S && S.strain;\n    if (!st || !st.jitter || (S && S.breath)) return [0, 0];\n    const amp = 5 * (st.amp == null ? 1 : st.amp) * (p.fine ? 0.35 : 1);\n    return [Math.sin((S.worldT || 0) * 17.3 + p.id) * amp, Math.cos((S.worldT || 0) * 13.1 + p.id * 2) * amp];\n  }\n\n  function validTarget(S, p, tune) {\n    const rad = tune.hands.magnet;\n    return nearest(S, p, rad, o => {\n      if (!canTouch(S, o)) return false;\n      if (o.type === 'pool') return p.tool === 'suction';\n      if (o.type === 'nerve' || o.type === 'eloquent' || o.type === 'hold') return false;\n      if (p.tool === 'sonar') return !!o.hidden;\n      if (p.tool === 'salve') return !!o.cells;\n      if (p.tool === 'syringe') return o.type === 'clot' || o.type === 'reed' || o.type === 'voice' || o.type === 'lobe';\n      if (p.tool === 'cautery') return o.type === 'polyp' || o.type === 'bleeder' || o.type === 'bead' || o.type === 'uvula' || o.type === 'eye' || o.type === 'rupture' || o.type === 'tremass' || o.type === 'barb' || o.type === 'lobe';\n      if (p.tool === 'forceps') return o.type === 'shard' || o.type === 'fragment' || o.type === 'mass' || o.type === 'hook' || o.type === 'gaff' || o.type === 'cork' || o.type === 'note' || o.type === 'retractor' || o.type === 'screw' || o.type === 'nest';\n      if (p.tool === 'scalpel') return !!o.guide;\n      if (p.tool === 'suture') return !!o.pairs;\n      return false;\n    });\n  }\n\n  function updateCursor(p, dev, S, dt, tune) {\n    tune = tuneOf(tune);\n    dev = dev || {};\n    if (dev.mouse) {\n      p.bx = dev.mouse[0]; p.by = dev.mouse[1];\n      p.x = p.bx; p.y = p.by;\n      p.fine = !!dev.fine;\n      return p;\n    }\n    const aim = dev.aim || [0, 0];\n    let mag = hypot(aim[0], aim[1]);\n    let dirx = mag > 1e-6 ? aim[0] / mag : 0;\n    let diry = mag > 1e-6 ? aim[1] / mag : 0;\n    mag = Math.min(1, mag);\n    const curved = Math.pow(mag, tune.hands.curve);\n    let speed = curved * tune.hands.cursor;\n    if (dev.fine) speed *= tune.hands.fine;\n    if (S && (S.activeDoc === 'vale')) speed *= 1.15;\n    /* 0.06s ramp */\n    const k = 1 - Math.exp(-dt / 0.06);\n    p.speed += (speed - (p.speed || 0)) * (dt > 0 ? k : 1);\n    let vx = dirx * p.speed;\n    let vy = diry * p.speed;\n    const keys = dev.keys || [0, 0];\n    const keySp = 200 * (dev.fine ? tune.hands.fine : 1);\n    vx += keys[0] * keySp; vy += keys[1] * keySp;\n    const nudge = dev.nudge || [0, 0];\n    vx += nudge[0] * 40; vy += nudge[1] * 40;\n\n    const assist = S ? assistOf(S, tune) : tune.hands.assist;\n    const tgt = S ? validTarget(S, p, tune) : null;\n    if (tgt && mag < 0.95) {\n      vx *= 1 - 0.55 * Math.min(1, assist);\n      vy *= 1 - 0.55 * Math.min(1, assist);\n      if (mag < 0.12) {\n        const dx = tgt.x - p.bx, dy = tgt.y - p.by;\n        const d = hypot(dx, dy) || 1;\n        const pull = 90 * assist;\n        vx += (dx / d) * pull; vy += (dy / d) * pull;\n      }\n    }\n    if (S && p.stroke && (p.stroke.kind === 'scalpel' || p.stroke.kind === 'suture')) {\n      const o = objById(S, p.stroke.id);\n      let tanv = [1, 0];\n      if (o && o.guide) tanv = polyDist(o.guide, p.bx, p.by).tan;\n      else if (p.stroke.kind === 'suture' && o && o.pairs) {\n        const pair = o.pairs[o.stitch] || o.pairs[0];\n        const dx = pair[1][0] - pair[0][0], dy = pair[1][1] - pair[0][1];\n        const L = hypot(dx, dy) || 1;\n        tanv = [dx / L, dy / L];\n      }\n      const along = vx * tanv[0] + vy * tanv[1];\n      const cx = vx - along * tanv[0], cy = vy - along * tanv[1];\n      const scale = 1 - 0.8 * Math.min(1, assist);\n      vx = along * tanv[0] + cx * scale;\n      vy = along * tanv[1] + cy * scale;\n    }\n    p.bx = clamp(p.bx + vx * dt, 8, CFG.FIELD_W - 8);\n    p.by = clamp(p.by + vy * dt, 8, CFG.FIELD_H - 8);\n    const j = S ? jitterOf(S, p) : [0, 0];\n    p.x = p.bx + j[0];\n    p.y = p.by + j[1];\n    p.fine = !!dev.fine;\n    return p;\n  }\n\n  function wheelIndex(x, y) {\n    const ang = Math.atan2(y, x); /* 0 east, clockwise because y grows downward */\n    let d = ang - (-Math.PI / 2);\n    if (d < 0) d += TAU;\n    if (d >= TAU) d -= TAU;\n    return Math.round(d / (Math.PI / 4)) % 8;\n  }\n\n  function updateWheel(p, dev, dt) {\n    dev = dev || {};\n    if (dev.digit) {\n      const i = (dev.digit - 1) % 8;\n      if (p.tool !== CFG.TOOLS[i]) { p.tool = CFG.TOOLS[i]; p.swap = 0.12; }\n      return p.tool;\n    }\n    const m = dev.move || [0, 0];\n    const mag = hypot(m[0], m[1]);\n    if (mag < 0.6) { p.wheelT = 0; p.wheelDir = -1; return p.tool; }\n    const dir = wheelIndex(m[0], m[1]);\n    if (dir !== p.wheelDir) { p.wheelDir = dir; p.wheelT = 0; }\n    p.wheelT += dt;\n    if (p.wheelT >= 0.08 && p.tool !== CFG.TOOLS[dir]) {\n      p.tool = CFG.TOOLS[dir];\n      p.swap = 0.12;\n      p.wheelT = 0;\n    }\n    return p.tool;\n  }\n\n  function retryPhase(S) {\n    if (!S.checkpoint) return false;\n    restoreCore(S, S.checkpoint, false);\n    S.rankCap = 'B';\n    S.lost = false;\n    S.won = false;\n    S.codeBlue = null;\n    S.reason = '';\n    for (const p of S.players) { p.held = 0; p.stroke = null; }\n    pushEv(S, ['retry', S.phase]);\n    return true;\n  }\n\n  GAME.Sim = {\n    rnd, clamp, clone, addObj, makePlayer, blank, create, createRaw, step,\n    takeCore, applyCore, hashCore, rankLetter, secondLook, forceRewind, retryPhase,\n    updateCursor, updateWheel, wheelIndex, spawnStrain, phaseClear, objById,\n    polyDist, lose, DRAIN,\n  };\n  GAME.Op = { create, createRaw, step, takeCore, hash: S => hashCore(takeCore(S)), rankLetter, secondLook, forceRewind, retryPhase, spawnStrain };\n  GAME.Cursor = { update: updateCursor, jitterOf, assistOf };\n  GAME.Wheel = { update: updateWheel, index: wheelIndex, TOOLS: CFG.TOOLS };\n})();\n","old_string":""}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":5595,"output_tokens":26586,"cache_read_input_tokens":194944,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"66868fe3-7ab4-4759-81fe-cb60138082e6"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-688c113e-9f07-476e-8778-8013edf777ce-51","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"\",\"new_string\":\"/* Operation sim. Plain data in, plain data out. No drawing, no audio, no DOM.\\n   Cursor and the wheel sit beside it and feed the same inputs a pad does. */\\n(() => {\\n  const G = typeof window !== 'undefined' ? window : globalThis;\\n  const GAME = (G.GAME ||= {});\\n  const CFG = GAME.CFG;\\n  const TAU = Math.PI * 2;\\n\\n  const DRAIN = {\\n    shard: 0.1, fragment: 0.1, cork: 0.1, laceration: 0.2, bite: 0.2, wound: 0.4,\\n    bleeder: 0.5, arteryTear: 1, polyp: 0.1, mass: 0.2, hook: 0.3, gaff: 0.3,\\n    clot: 0.3, patch: 0.1, nest: 0.15, bead: 0, rupture: 0.45, screw: 0, wire: 0,\\n    pool: 0, retractor: 0, slur: 0, reed: 0, tremass: 0.4, lobe: 0.2, eye: 0.35,\\n    tendril: 0.2, uvula: 0.3, voice: 0.4, repeat: 0, spiral: 0, note: 0.2, nerve: 0,\\n    eloquent: 0, hold: 0,\\n  };\\n\\n  function rnd(S) {\\n    let x = (S.rng >>> 0) || 1;\\n    x ^= x << 13; x >>>= 0;\\n    x ^= x >>> 17; x >>>= 0;\\n    x ^= x << 5; x >>>= 0;\\n    if (!x) x = 1;\\n    S.rng = x;\\n    return x / 4294967296;\\n  }\\n  function clamp(v, a, b) { return v < a ? a : v > b ? b : v; }\\n  function hypot(x, y) { return Math.hypot(x, y); }\\n  function clone(v) { return JSON.parse(JSON.stringify(v)); }\\n  function tuneOf(t) { return t || GAME.TUNE || CFG.cloneTune(CFG.TUNING); }\\n  function diffDrain(S) { return S.diff === 'intern' ? 0.7 : S.diff === 'attending' ? 1.3 : 1; }\\n  function diffClock(S) { return S.diff === 'intern' ? 1.3 : S.diff === 'attending' ? 0.8 : 1; }\\n  function syringeDose(S, tune) {\\n    const base = tune.patient.syringe;\\n    if (S.diff === 'intern') return 24 * (base / 18);\\n    if (S.diff === 'attending') return 12 * (base / 18);\\n    return base;\\n  }\\n\\n  function objById(S, id) {\\n    for (let i = 0; i < S.objects.length; i++) if (S.objects[i].id === id) return S.objects[i];\\n    return null;\\n  }\\n\\n  function pushEv(S, ev) { S.ev.push(ev); }\\n\\n  function slip(S, p, kind, dmg, tune) {\\n    S.slips += 1;\\n    if (p) p.slips += 1;\\n    S.vitals -= dmg * tune.patient.slip;\\n    S.streak = 0;\\n    S.flow = 1;\\n    pushEv(S, ['slip', kind, dmg, p ? p.id : -1]);\\n  }\\n\\n  function award(S, p, grade, base, tune) {\\n    const mult = grade === 'textbook' ? 1.5 : grade === 'clean' ? 1 : 0.4;\\n    const pts = base * mult * S.flow;\\n    S.score += pts;\\n    p.score += pts;\\n    p.actions += 1;\\n    S.techAll += 1;\\n    if (grade !== 'sloppy') S.techGood += 1;\\n    if (grade === 'textbook') { p.textbooks += 1; S.steady = Math.min(100, S.steady + 10 * tune.gift.charge); }\\n    else if (grade === 'clean') S.steady = Math.min(100, S.steady + 5 * tune.gift.charge);\\n    if (grade === 'sloppy') { S.streak = 0; S.flow = 1; }\\n    else {\\n      S.streak += 1;\\n      S.flow = Math.min(2, 1 + 0.05 * S.streak);\\n      if (S.flow > S.bestFlow) S.bestFlow = S.flow;\\n    }\\n    if (!S.tutDone) S.tutDone = true;\\n    pushEv(S, ['grade', Math.round(p.x), Math.round(p.y), grade, Math.round(pts)]);\\n    return grade;\\n  }\\n\\n  function makePlayer(i, color) {\\n    return {\\n      id: i, x: 213, y: 150, bx: 213, by: 150, tool: 'forceps', trig: 0, prevTrig: 0,\\n      fine: false, held: 0, stroke: null, heat: 0, lock: 0, fill: 0, over: 0,\\n      cool: 0, score: 0, slips: 0, actions: 0, textbooks: 0, stitches: 0,\\n      suctioned: 0, burned: 0, speed: 0, wheelT: 0, wheelDir: -1, swap: 0,\\n      giftPrev: false, consultPrev: false, color: color || CFG.SEAT[i] || '#e8443a',\\n      gone: false,\\n    };\\n  }\\n\\n  function blank(opts) {\\n    opts = opts || {};\\n    const n = opts.players || 1;\\n    const S = {\\n      id: opts.id || 'raw', seed: (opts.seed >>> 0) || 1, rng: (opts.seed >>> 0) || 1,\\n      diff: opts.difficulty || opts.diff || 'resident',\\n      clock: opts.clock != null ? opts.clock : 180,\\n      clock0: opts.clock != null ? opts.clock : 180,\\n      vitals: opts.vitals != null ? opts.vitals : 80,\\n      drain: opts.drain != null ? opts.drain : 0,\\n      phase: 0, phaseCount: 1, phaseName: opts.phaseName || 'Work',\\n      objects: [], nextId: 1, players: [],\\n      steady: opts.steady || 0, breath: false, worldScale: 1,\\n      gift: opts.gift || 'breath', doctor: opts.doctor || 'vale', activeDoc: opts.doctor || 'vale',\\n      consult: !!opts.consult, mode: opts.mode || 'case',\\n      codeBlueUsed: false, codeBlue: null, lost: false, won: false, closed: false, reason: '',\\n      score: 0, slips: 0, flow: 1, streak: 0, bestFlow: 1, techGood: 0, techAll: 0,\\n      t: 0, worldT: 0, phaseT: 0, ev: [], ghosts: [], ghostT: 0,\\n      ring: [], ringAcc: 0, checkpoint: null, rankCap: null, par: opts.par || 1000,\\n      site: opts.site || 'abdomen', tutorial: !!opts.tutorial, tutDone: !opts.tutorial,\\n      strain: null, flags: {}, scripts: [], tiltAmp: 0, dim: 0, dressing: null,\\n      device: null, windowOpen: 0, dev: !!opts.dev,\\n    };\\n    for (let i = 0; i < n; i++) S.players.push(makePlayer(i, opts.colors && opts.colors[i]));\\n    return S;\\n  }\\n\\n  function addObj(S, spec) {\\n    const o = Object.assign({\\n      id: S.nextId++, type: 'shard', x: 213, y: 116, alive: true, done: false,\\n      hidden: false, marked: false, markT: 0, under: 0, prog: 0, order: 0,\\n      drain: 0, grade: '', tag: '',\\n    }, spec);\\n    if (o.drain == null || spec.drain == null) o.drain = spec.drain != null ? spec.drain : (DRAIN[o.type] || 0);\\n    if (!o.origin) o.origin = [o.x, o.y];\\n    if (!o.axis) o.axis = [1, 0];\\n    const al = hypot(o.axis[0], o.axis[1]) || 1;\\n    o.axis = [o.axis[0] / al, o.axis[1] / al];\\n    if (o.depth == null) o.depth = 16;\\n    if (o.type === 'pool' && o.vol == null) o.vol = o.max || 36;\\n    if (o.type === 'pool' && o.max == null) o.max = o.vol;\\n    if ((o.type === 'wound' || o.type === 'arteryTear') && !o.pairs) {\\n      const n = o.stitches || (o.type === 'arteryTear' ? 3 : 4);\\n      o.pairs = [];\\n      for (let i = 0; i < n; i++) {\\n        const y = o.y - (n - 1) * 4 + i * 8;\\n        o.pairs.push([[o.x - 8, y], [o.x + 8, y]]);\\n      }\\n    }\\n    if (o.pairs) o.stitch = 0;\\n    if ((o.type === 'laceration' || o.type === 'patch' || o.type === 'bite') && !o.cells) {\\n      const r = o.r || 12;\\n      o.cells = [];\\n      for (let y = -r; y <= r; y += 4) for (let x = -r; x <= r; x += 4) {\\n        if (x * x + y * y <= r * r) o.cells.push([o.x + x, o.y + y, 0]);\\n      }\\n    }\\n    if ((o.type === 'mass' || o.type === 'spiral' || o.type === 'slur' || o.type === 'tendril' || o.type === 'wire' || o.type === 'repeat') && !o.guide) {\\n      const len = o.len || 48;\\n      o.guide = [[o.x - len / 2, o.y], [o.x + len / 2, o.y]];\\n    }\\n    if (o.type === 'mass' && !o.ring) {\\n      o.ring = true;\\n      const rad = o.rad || 16;\\n      o.guide = [];\\n      for (let i = 0; i <= 12; i++) {\\n        const a = -Math.PI / 2 + TAU * i / 12;\\n        o.guide.push([o.x + Math.cos(a) * rad, o.y + Math.sin(a) * rad]);\\n      }\\n    }\\n    if (o.need == null) {\\n      if (o.type === 'polyp') o.need = 0.5;\\n      else if (o.type === 'bleeder' || o.type === 'rupture') o.need = 0.35;\\n      else if (o.type === 'bead') o.need = 0.12;\\n      else if (o.type === 'uvula') o.need = 1.5;\\n      else if (o.type === 'eye') o.need = 0.3;\\n      else if (o.type === 'tremass') o.need = 3;\\n      else o.need = 0.5;\\n    }\\n    S.objects.push(o);\\n    return o;\\n  }\\n\\n  function inDome(S, x, y) {\\n    const st = S.strain;\\n    if (!st || !st.domes) return false;\\n    for (let i = 0; i < st.domes.length; i++) {\\n      const d = st.domes[i];\\n      if (d.t > 0 && hypot(x - d.x, y - d.y) <= d.r) return true;\\n    }\\n    return false;\\n  }\\n\\n  function covered(S, o) {\\n    if (!o.under) return false;\\n    const p = objById(S, o.under);\\n    return !!(p && !p.done && p.vol > 1);\\n  }\\n\\n  function canTouch(S, o) {\\n    if (!o || o.done || !o.alive) return false;\\n    if (covered(S, o)) return false;\\n    if (o.hidden && !o.marked) return false;\\n    if (o.needsWindow && S.windowOpen <= 0) return false;\\n    if (o.type === 'reed' || o.type === 'voice') return !!o.window;\\n    if (o.type === 'lobe') return !!o.open;\\n    if (o.type === 'eye') return !!o.open;\\n    if (o.type === 'repeat') return !!o.open;\\n    return true;\\n  }\\n\\n  function nearest(S, p, rad, pred) {\\n    let best = null, bd = rad;\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n      if (!pred(o)) continue;\\n      const d = hypot(o.x - p.x, o.y - p.y);\\n      if (d <= bd) { bd = d; best = o; }\\n    }\\n    return best;\\n  }\\n\\n  function lose(S, why) {\\n    if (S.lost || S.won) return;\\n    S.lost = true;\\n    S.reason = why;\\n    S.breath = false;\\n    S.worldScale = 1;\\n    pushEv(S, ['lost', why]);\\n  }\\n\\n  function finishCase(S) {\\n    if (S.won || S.lost) return;\\n    S.won = true;\\n    S.closed = true;\\n    S.breath = false;\\n    S.worldScale = 1;\\n    const end = Math.max(0, S.clock) * 2 + Math.max(0, S.vitals) * 3;\\n    S.score += end;\\n    S.endBonus = end;\\n    S.rank = rankLetter(S.score, S.par, S.diff, S.slips, S.rankCap);\\n    pushEv(S, ['closed', S.rank, Math.round(S.score)]);\\n  }\\n\\n  function rankLetter(score, par, diff, slips, cap) {\\n    const r = par > 0 ? score / par : 0;\\n    let L = r >= 0.95 ? 'S' : r >= 0.8 ? 'A' : r >= 0.6 ? 'B' : r >= 0.4 ? 'C' : 'D';\\n    const order = 'DCBAS';\\n    if (cap === 'B' && order.indexOf(L) > order.indexOf('B')) L = 'B';\\n    if (diff === 'attending' && L === 'S' && !slips) return 'S+';\\n    return L;\\n  }\\n\\n  function takeCore(S) {\\n    return {\\n      rng: S.rng, clock: S.clock, vitals: S.vitals, score: S.score, slips: S.slips,\\n      phase: S.phase, steady: S.steady, flow: S.flow, streak: S.streak,\\n      phaseT: S.phaseT, worldT: S.worldT, flags: clone(S.flags),\\n      objects: clone(S.objects), strain: S.strain ? clone(S.strain) : null,\\n      device: S.device ? clone(S.device) : null,\\n      techGood: S.techGood, techAll: S.techAll, bestFlow: S.bestFlow,\\n      codeBlueUsed: S.codeBlueUsed, tutDone: S.tutDone, tutorial: S.tutorial,\\n      windowOpen: S.windowOpen, tiltAmp: S.tiltAmp, dim: S.dim,\\n    };\\n  }\\n\\n  function applyCore(S, core) {\\n    S.rng = core.rng; S.clock = core.clock; S.vitals = core.vitals; S.score = core.score;\\n    S.slips = core.slips; S.phase = core.phase; S.steady = core.steady; S.flow = core.flow;\\n    S.streak = core.streak; S.phaseT = core.phaseT; S.worldT = core.worldT;\\n    S.flags = clone(core.flags); S.objects = clone(core.objects);\\n    S.strain = core.strain ? clone(core.strain) : null;\\n    S.device = core.device ? clone(core.device) : null;\\n    S.techGood = core.techGood; S.techAll = core.techAll; S.bestFlow = core.bestFlow;\\n    S.codeBlueUsed = core.codeBlueUsed; S.tutDone = core.tutDone; S.tutorial = core.tutorial;\\n    S.windowOpen = core.windowOpen; S.tiltAmp = core.tiltAmp; S.dim = core.dim;\\n  }\\n\\n  function hashCore(core) {\\n    const s = JSON.stringify(core);\\n    let h = 2166136261;\\n    for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); }\\n    return h >>> 0;\\n  }\\n\\n  function pushRing(S) {\\n    const cursors = S.players.map(p => [round3(p.x), round3(p.y)]);\\n    const strains = strainGhost(S);\\n    S.ring.push({ t: S.worldT, core: takeCore(S), cursors, strains });\\n    const keep = S.worldT - 6.05;\\n    while (S.ring.length > 2 && S.ring[0].t < keep) S.ring.shift();\\n  }\\n  function round3(v) { return Math.round(v * 1000) / 1000; }\\n\\n  function strainGhost(S) {\\n    const st = S.strain;\\n    if (!st) return [];\\n    if (st.kind === 'legato') return (st.worms || []).map(w => [round3(w.x), round3(w.y)]);\\n    if (st.kind === 'staccato') return (st.beads || []).map(b => [round3(b.x), round3(b.y)]);\\n    if (st.kind === 'fermata' || st.kind === 'cantor') return st.eye ? [[round3(st.eye.x), round3(st.eye.y)]] : [];\\n    if (st.kind === 'tremolo') return [[round3(st.x || 213), round3(st.y || 116)]];\\n    if (st.kind === 'dacapo') return (st.lobes || []).map(L => [round3(L.x), round3(L.y)]);\\n    return [];\\n  }\\n\\n  function restoreCore(S, core, keepHands) {\\n    const hands = S.players.map(p => ({ id: p.id, x: p.x, y: p.y, bx: p.bx, by: p.by, color: p.color }));\\n    applyCore(S, core);\\n    for (let i = 0; i < S.players.length; i++) {\\n      const p = S.players[i];\\n      p.held = 0; p.stroke = null; p.fill = 0; p.over = 0; p.trig = 0; p.prevTrig = 0;\\n      if (keepHands && hands[i]) {\\n        p.x = hands[i].x; p.y = hands[i].y; p.bx = hands[i].bx; p.by = hands[i].by;\\n      }\\n    }\\n  }\\n\\n  function secondLook(S, tune) {\\n    if (S.mode === 'rounds') return false;\\n    if (S.gift !== 'look' && S.gift !== 'both' && S.activeDoc !== 'sokolova' && S.gift !== 'look') {\\n      if (!(S.gift === 'both' || S.activeDoc === 'sokolova' || S.gift === 'look')) return false;\\n    }\\n    const can = S.gift === 'look' || S.gift === 'both' || S.activeDoc === 'sokolova';\\n    if (!can) return false;\\n    if (S.steady < 45) return false;\\n    if (!S.ring.length) return false;\\n    const target = S.worldT - (tune.gift.lookSeconds || 6);\\n    let pick = S.ring[0];\\n    for (let i = 0; i < S.ring.length; i++) if (S.ring[i].t <= target) pick = S.ring[i];\\n    const ghosts = [];\\n    for (let i = 0; i < S.ring.length; i++) {\\n      if (S.ring[i].t + 1e-6 < pick.t) continue;\\n      ghosts.push({ t: S.ring[i].t - pick.t, cursors: S.ring[i].cursors, strains: S.ring[i].strains });\\n    }\\n    restoreCore(S, pick.core, true);\\n    S.steady = Math.max(0, S.steady - 45);\\n    S.ghosts = ghosts;\\n    S.ghostT = tune.gift.lookSeconds || 6;\\n    S.breath = false;\\n    S.worldScale = 1;\\n    pushEv(S, ['rewind', ghosts.length]);\\n    return true;\\n  }\\n\\n  function forceRewind(S, keepSteady) {\\n    const steady = S.steady;\\n    const breath = S.breath;\\n    if (!S.ring.length) return false;\\n    const target = S.worldT - 6;\\n    let pick = S.ring[0];\\n    for (let i = 0; i < S.ring.length; i++) if (S.ring[i].t <= target) pick = S.ring[i];\\n    restoreCore(S, pick.core, true);\\n    if (keepSteady) S.steady = steady;\\n    S.breath = breath;\\n    S.worldScale = breath ? 0.25 : 1;\\n    pushEv(S, ['forced', 1]);\\n    return true;\\n  }\\n\\n  /* ---------- tools ---------- */\\n\\n  function polyDist(pts, x, y) {\\n    let best = 1e9, arcAt = 0, along = 0, total = 0;\\n    const acc = [0];\\n    for (let i = 1; i < pts.length; i++) acc.push(acc[i - 1] + hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));\\n    total = acc[acc.length - 1] || 1;\\n    for (let i = 1; i < pts.length; i++) {\\n      const ax = pts[i - 1][0], ay = pts[i - 1][1], bx = pts[i][0], by = pts[i][1];\\n      const vx = bx - ax, vy = by - ay, L = hypot(vx, vy) || 1;\\n      let t = ((x - ax) * vx + (y - ay) * vy) / (L * L);\\n      t = clamp(t, 0, 1);\\n      const px = ax + vx * t, py = ay + vy * t;\\n      const d = hypot(x - px, y - py);\\n      if (d < best) { best = d; along = acc[i - 1] + t * L; }\\n    }\\n    return { d: best, along, total, tan: tangent(pts, along) };\\n  }\\n  function tangent(pts, along) {\\n    let left = along;\\n    for (let i = 1; i < pts.length; i++) {\\n      const L = hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]) || 1;\\n      if (left <= L || i === pts.length - 1) {\\n        return [(pts[i][0] - pts[i - 1][0]) / L, (pts[i][1] - pts[i - 1][1]) / L];\\n      }\\n      left -= L;\\n    }\\n    return [1, 0];\\n  }\\n\\n  function nerveHit(S, p, tune) {\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n      if (o.type !== 'nerve' && o.type !== 'eloquent') continue;\\n      const pts = o.guide || [[o.x - 20, o.y], [o.x + 20, o.y]];\\n      if (polyDist(pts, p.x, p.y).d < 6) { slip(S, p, 'nerve', 12, tune); return true; }\\n    }\\n    return false;\\n  }\\n\\n  function gradeMean(mean, a, b) {\\n    if (mean <= a) return 'textbook';\\n    if (mean <= b) return 'clean';\\n    return 'sloppy';\\n  }\\n\\n  function stepForceps(S, p, dt, tune) {\\n    const down = p.trig > 0.3;\\n    let held = p.held ? objById(S, p.held) : null;\\n    if (p.trigEdge && !held) {\\n      const o = nearest(S, p, 12, o => canTouch(S, o) && (o.type === 'shard' || o.type === 'fragment' || o.type === 'cork' || o.type === 'hook' || o.type === 'gaff' || o.type === 'clot' || o.type === 'mass' || o.type === 'nest' || o.type === 'note' || o.type === 'retractor' || o.type === 'screw' || (o.type === 'lobe' && o.mode === 'forceps')));\\n      if (o && o.type === 'clot' && !o.dosed) { /* no grip yet */ }\\n      else if (o && (o.type === 'hook' || o.type === 'gaff') && o.barbs) { slip(S, p, 'tear', 4, tune); o.tears = (o.tears || 0) + 1; }\\n      else if (o && o.type === 'mass' && !o.cut) { /* ring first */ }\\n      else if (o && o.type === 'nest' && !o.cut) { /* slash first */ }\\n      else if (o && o.type === 'screw') { p.held = o.id; o.lastAng = Math.atan2(p.y - o.y, p.x - o.x); o.spin = o.spin || 0; }\\n      else if (o && o.type === 'retractor') { p.held = o.id; }\\n      else if (o) {\\n        p.held = o.id; o.t0 = o.t0 || 0; o.pullT = o.pullT || 0; o.gripped = true;\\n        if (!o.origin) o.origin = [o.x, o.y];\\n        pushEv(S, ['grip', o.id]);\\n      }\\n    }\\n    held = p.held ? objById(S, p.held) : null;\\n    if (held && down) {\\n      if (held.type === 'retractor') {\\n        held.x = p.x; held.y = p.y;\\n        S.windowOpen = 1;\\n        return;\\n      }\\n      if (held.type === 'screw') {\\n        const ang = Math.atan2(p.y - held.y, p.x - held.x);\\n        let d = ang - (held.lastAng || ang);\\n        while (d > Math.PI) d -= TAU;\\n        while (d < -Math.PI) d += TAU;\\n        held.spin = (held.spin || 0) + Math.abs(d);\\n        held.lastAng = ang;\\n        if (held.spin >= 3 * TAU) {\\n          held.done = true; held.alive = false; p.held = 0;\\n          award(S, p, 'textbook', 100, tune);\\n          pushEv(S, ['screw', held.id]);\\n        }\\n        return;\\n      }\\n      const ox = held.origin[0], oy = held.origin[1];\\n      const dx = p.x - ox, dy = p.y - oy;\\n      const along = dx * held.axis[0] + dy * held.axis[1];\\n      const px = dx - along * held.axis[0], py = dy - along * held.axis[1];\\n      const perp = hypot(px, py);\\n      const limit = held.tension || 120;\\n      if (!held.free) {\\n        if (p.inst > limit || perp > 8) {\\n          if (held.type === 'note' || (S.strain && S.strain.kind === 'legato' && held.tag === 'legato-head')) {\\n            held.snapped = true;\\n            slip(S, p, 'snap', 4, tune);\\n            pushEv(S, ['snap', held.id]);\\n          } else {\\n            held.tears = (held.tears || 0) + 1;\\n            held.prog = Math.max(0, (held.prog || 0) - held.depth * 0.3);\\n            slip(S, p, 'tear', 4, tune);\\n            pushEv(S, ['tear', held.id]);\\n          }\\n        }\\n        held.prog = Math.max(held.prog || 0, along);\\n        held.pullT = (held.pullT || 0) + dt;\\n        if (along >= held.depth) {\\n          held.free = true;\\n          pushEv(S, ['free', held.id]);\\n        }\\n      } else {\\n        held.x = p.x; held.y = p.y;\\n        held.pullT = (held.pullT || 0) + dt;\\n      }\\n    }\\n    if (held && p.trigRelease) {\\n      if (held.type === 'retractor') { p.held = 0; return; }\\n      if (held.type === 'screw') { p.held = 0; return; }\\n      const d0 = hypot(p.x - held.origin[0], p.y - held.origin[1]);\\n      if (held.holdZone && hypot(p.x - held.holdZone[0], p.y - held.holdZone[1]) <= (held.holdZone[2] || 14)) {\\n        held.clamped = true; held.gripped = false; p.held = 0;\\n        pushEv(S, ['clamp', held.id]);\\n        return;\\n      }\\n      if (held.free && (d0 >= 24 || outside(p.x, p.y))) {\\n        const tears = held.tears || 0;\\n        const parT = held.parTime || (held.depth / 80 + 0.35);\\n        let g = 'sloppy';\\n        if (!tears && (held.pullT || 0) <= parT) g = 'textbook';\\n        else if (tears <= 1) g = 'clean';\\n        held.done = true; held.alive = false; held.grade = g; p.held = 0;\\n        if (held.type === 'note') p.score += 0;\\n        award(S, p, g, 120, tune);\\n        pushEv(S, ['dish', held.id, g]);\\n      } else {\\n        held.gripped = false;\\n        p.held = 0;\\n      }\\n    }\\n  }\\n\\n  function outside(x, y) {\\n    const nx = (x - CFG.CX) / CFG.RX, ny = (y - CFG.CY) / CFG.RY;\\n    return nx * nx + ny * ny > 1;\\n  }\\n\\n  function stepScalpel(S, p, dt, tune) {\\n    const down = p.trig > 0.3;\\n    const tol = tune.hands.grade;\\n    if (p.stroke && p.stroke.kind === 'scalpel') {\\n      const o = objById(S, p.stroke.id);\\n      if (!o || o.done) { p.stroke = null; }\\n    }\\n    if (p.trigEdge && !p.stroke) {\\n      const o = nearest(S, p, 8, o => canTouch(S, o) && o.guide && (o.type === 'mass' || o.type === 'slur' || o.type === 'tendril' || o.type === 'spiral' || o.type === 'wire' || o.type === 'repeat' || o.type === 'lobe' || o.type === 'cut' || o.type === 'nest'));\\n      if (o && o.guide) {\\n        const start = o.guide[0];\\n        if (hypot(p.x - start[0], p.y - start[1]) <= 8 + (p.mouse ? 1 : 0)) {\\n          p.stroke = { kind: 'scalpel', id: o.id, far: 0, sum: 0, n: 0, off: 0, slipped: false };\\n          o.cutting = true;\\n        }\\n      }\\n    }\\n    if (!(p.stroke && p.stroke.kind === 'scalpel') && down && p.inst > 40) {\\n      const onGuide = S.objects.some(o => o.guide && !o.done && polyDist(o.guide, p.x, p.y).d < 8);\\n      if (!onGuide && !outside(p.x, p.y)) {\\n        p.bare = (p.bare || 0) + hypot(p.x - (p.ox || p.x), p.y - (p.oy || p.y));\\n        if (p.bare >= 6) { slip(S, p, 'healthy', 3, tune); p.bare = 0; }\\n      }\\n    }\\n    if (p.stroke && p.stroke.kind === 'scalpel' && down) {\\n      const o = objById(S, p.stroke.id);\\n      if (o && nerveHit(S, p, tune)) { /* counted */ }\\n      if (o && o.guide) {\\n        const hit = polyDist(o.guide, p.x, p.y);\\n        const st = p.stroke;\\n        if (hit.along > st.far) st.far = hit.along;\\n        st.sum += hit.d; st.n += 1;\\n        if (hit.d > 9) st.off += dt; else st.off = 0;\\n        if (st.off >= 0.12 && !st.slipped) {\\n          st.slipped = true; slip(S, p, 'slip', 3, tune);\\n          pushEv(S, ['slipcut', o.id]);\\n        }\\n        o.prog = st.far / (hit.total || 1);\\n        if (o.type === 'spiral' && o.beatLock && S.flags.onBeat) {\\n          if (!st.beatSlip) { st.beatSlip = true; slip(S, p, 'beat', 3, tune); }\\n          o.prog = Math.min(o.prog, st.safe || 0);\\n        } else if (o.type === 'spiral') st.safe = o.prog;\\n        if (st.far >= (hit.total || 1) - 0.5) {\\n          const mean = st.n ? st.sum / st.n : 99;\\n          const g = st.slipped ? 'sloppy' : gradeMean(mean, 1.8 * tol, 4 * tol);\\n          o.done = true; o.alive = false; o.grade = g; o.cut = true;\\n          if (o.type === 'mass') { o.done = false; o.alive = true; o.cut = true; o.type = 'mass'; }\\n          if (o.type === 'nest') { o.done = false; o.alive = true; o.cut = true; }\\n          if (o.type === 'wire') { /* caller checks order */ wireCut(S, p, o, tune); }\\n          else award(S, p, g, 110, tune);\\n          p.stroke = null;\\n          pushEv(S, ['cut', o.id, g]);\\n        }\\n      }\\n    }\\n    if (p.trigRelease && p.stroke && p.stroke.kind === 'scalpel') {\\n      const o = objById(S, p.stroke.id);\\n      if (o && o.prog < 0.98) {\\n        /* resume later if they come back within 6 */\\n        p.stroke.paused = true;\\n      }\\n    }\\n    if (p.trigEdge && p.stroke && p.stroke.paused) {\\n      const o = objById(S, p.stroke.id);\\n      if (o && o.guide) {\\n        const hit = polyDist(o.guide, p.x, p.y);\\n        if (Math.abs(hit.along - p.stroke.far) <= 6 || hit.d <= 6) p.stroke.paused = false;\\n        else p.stroke = null;\\n      }\\n    }\\n    /* slash variant: a fast stroke across a slash target */\\n    if (down && p.inst >= 60) {\\n      const o = nearest(S, p, 10, q => canTouch(S, q) && q.slash && !q.done);\\n      if (o) {\\n        o.done = true; o.alive = false; o.cut = true;\\n        award(S, p, 'clean', 100, tune);\\n        pushEv(S, ['slash', o.id]);\\n      }\\n    }\\n  }\\n\\n  function wireCut(S, p, o, tune) {\\n    const dev = S.device;\\n    if (!dev) { o.done = true; award(S, p, 'clean', 80, tune); return; }\\n    const want = dev.order[dev.next];\\n    if (o.tag === want) {\\n      dev.next += 1; o.done = true; o.alive = false;\\n      award(S, p, 'textbook', 100, tune);\\n      if (dev.next >= dev.order.length) dev.done = true;\\n    } else {\\n      o.done = false; o.alive = true; o.prog = 0; o.cutting = false;\\n      S.vitals -= 30; S.clock = Math.max(0, S.clock - 30);\\n      slip(S, p, 'wire', 0, tune);\\n      pushEv(S, ['badwire', o.tag]);\\n    }\\n  }\\n\\n  function stepSuture(S, p, dt, tune) {\\n    const down = p.trig > 0.3;\\n    const extra = (S.activeDoc === 'sokolova' ? 1 : 0);\\n    if (p.trigEdge) {\\n      const o = nearest(S, p, 9 + extra, q => canTouch(S, q) && q.pairs && (q.stitch || 0) < q.pairs.length);\\n      if (o) {\\n        const a = o.pairs[o.stitch][0];\\n        if (hypot(p.x - a[0], p.y - a[1]) <= 9 + extra) {\\n          p.stroke = { kind: 'suture', id: o.id, i: o.stitch, t: 0 };\\n          pushEv(S, ['needle', o.id, o.stitch]);\\n        }\\n      }\\n    }\\n    if (p.stroke && p.stroke.kind === 'suture' && down) p.stroke.t += dt;\\n    if (p.stroke && p.stroke.kind === 'suture' && p.trigRelease) {\\n      const o = objById(S, p.stroke.id);\\n      const st = p.stroke;\\n      p.stroke = null;\\n      if (!o || o.done) return;\\n      const b = o.pairs[st.i][1];\\n      const tol = 6 + extra + (p.mouse ? 1 : 0);\\n      if (hypot(p.x - b[0], p.y - b[1]) <= tol) {\\n        const g = gradeMean(st.t, 0.6, 1.2);\\n        o.grades = o.grades || [];\\n        o.grades.push(g === 'textbook' ? 2 : g === 'clean' ? 1 : 0);\\n        o.times = o.times || [];\\n        o.times.push(st.t);\\n        o.stitch = st.i + 1;\\n        o.prog = o.stitch / o.pairs.length;\\n        p.stitches += 1;\\n        const bleedLeft = 1 - o.prog;\\n        if (o.type === 'arteryTear') o.drain = 1 * bleedLeft;\\n        else if (o.type === 'wound') o.drain = 0.4 * bleedLeft;\\n        pushEv(S, ['stitch', Math.round(b[0]), Math.round(b[1]), g]);\\n        if (o.stitch >= o.pairs.length) {\\n          const meanT = o.times.reduce((a, c) => a + c, 0) / o.times.length;\\n          const fg = gradeMean(meanT, 0.6, 1.2);\\n          o.done = true; o.alive = false; o.grade = fg; o.drain = 0;\\n          award(S, p, fg, 80 + 20 * o.pairs.length, tune);\\n        }\\n      } else {\\n        slip(S, p, 'loose', 1, tune);\\n        pushEv(S, ['loose', o.id]);\\n      }\\n    }\\n  }\\n\\n  function stepSalve(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    let any = false;\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n      if (!canTouch(S, o) || !o.cells) continue;\\n      if (!(o.type === 'laceration' || o.type === 'patch' || o.type === 'bite' || (o.type === 'lobe' && o.mode === 'salve'))) continue;\\n      for (let c = 0; c < o.cells.length; c++) {\\n        const cell = o.cells[c];\\n        if (!cell[2] && hypot(cell[0] - p.x, cell[1] - p.y) <= 10) { cell[2] = 1; any = true; }\\n      }\\n      let on = 0;\\n      for (let c = 0; c < o.cells.length; c++) if (o.cells[c][2]) on++;\\n      o.prog = o.cells.length ? on / o.cells.length : 1;\\n      if (o.prog >= 0.9 && !o.done) {\\n        o.done = true; o.alive = false; o.drain = 0;\\n        S.vitals = Math.min(99, S.vitals + 2 * tune.patient.healing);\\n        award(S, p, 'clean', 80, tune);\\n        pushEv(S, ['heal', o.id]);\\n      }\\n    }\\n    if (!any && p.trigEdge) { /* salve cannot harm */ }\\n  }\\n\\n  function stepSyringe(S, p, dt, tune) {\\n    if (p.cool > 0) p.cool -= dt;\\n    const down = p.trig > 0.3;\\n    if (down && p.cool <= 0) {\\n      if (p.fill < 1) p.fill = Math.min(1, p.fill + dt / 0.55);\\n      else p.over += dt;\\n    }\\n    if (p.trigRelease && p.fill > 0.05 && p.cool <= 0) {\\n      const bubble = p.over >= 0.3;\\n      const tgt = nearest(S, p, 10, o => canTouch(S, o) && (o.type === 'clot' || o.type === 'reed' || o.type === 'voice' || (o.type === 'lobe' && o.mode === 'syringe')));\\n      if (tgt) {\\n        if ((tgt.type === 'reed' || tgt.type === 'voice') && !tgt.window) {\\n          addObj(S, { type: 'laceration', x: tgt.x + 6, y: tgt.y, r: 8, order: 50, drain: 0.2 });\\n          slip(S, p, 'spit', 2, tune);\\n        } else {\\n          const g = bubble ? 'sloppy' : (p.fill >= 0.9 ? 'textbook' : 'clean');\\n          tgt.dosed = true;\\n          tgt.dose = (bubble ? 0.5 : 1) * p.fill;\\n          if (tgt.type === 'clot') { /* forceps next */ tgt.drain = 0.1; }\\n          else { tgt.done = true; tgt.alive = false; tgt.drain = 0; }\\n          award(S, p, g, 90, tune);\\n          pushEv(S, ['inject', tgt.id, g]);\\n        }\\n      } else {\\n        const g = bubble ? 'sloppy' : (p.fill >= 0.9 ? 'textbook' : 'clean');\\n        const add = syringeDose(S, tune) * p.fill * (bubble ? 0.5 : 1);\\n        S.vitals = Math.min(99, S.vitals + add);\\n        award(S, p, g, 40, tune);\\n        pushEv(S, ['iv', Math.round(add), g]);\\n      }\\n      p.fill = 0; p.over = 0; p.cool = 0.35;\\n    }\\n    if (!down && p.trigRelease === false) { /* keep fill while aiming */ }\\n  }\\n\\n  function stepCautery(S, p, dt, tune) {\\n    if (p.lock > 0) { p.lock -= dt; p.heat = Math.max(0, p.heat - 0.6 * dt); return; }\\n    const down = p.trig > 0.3;\\n    if (!down) {\\n      p.heat = Math.max(0, p.heat - 0.6 * dt);\\n      p.bareT = 0;\\n      return;\\n    }\\n    p.heat += tune.fluids.cauteryHeat * dt;\\n    if (p.heat >= 1) { p.lock = 1.2; p.heat = 1; slip(S, p, 'lock', 1, tune); pushEv(S, ['lock', p.id]); return; }\\n    if (nerveHit(S, p, tune)) return;\\n    const tgt = nearest(S, p, 6, o => canTouch(S, o) && (o.type === 'polyp' || o.type === 'bleeder' || o.type === 'rupture' || o.type === 'bead' || o.type === 'uvula' || o.type === 'eye' || o.type === 'tremass' || (o.type === 'lobe' && o.mode === 'cautery') || o.type === 'barb'));\\n    if (tgt) {\\n      p.bareT = 0;\\n      tgt.burn = (tgt.burn || 0) + dt;\\n      tgt.prog = tgt.burn / (tgt.need || 0.5);\\n      if (tgt.burn >= (tgt.need || 0.5) / Math.max(0.25, tune.strains.health) && !tgt.done) {\\n        const dirty = tgt.charred || p.lockedDuring;\\n        const g = (!tgt.charred && p.lock <= 0 && !p.hadLock) ? 'textbook' : 'clean';\\n        tgt.done = true; tgt.alive = false; tgt.drain = 0; tgt.grade = g;\\n        p.burned += 1;\\n        award(S, p, g, 90, tune);\\n        pushEv(S, ['burn', tgt.id, g]);\\n      }\\n    } else {\\n      p.bareT = (p.bareT || 0) + dt;\\n      if (p.bareT >= 0.25) {\\n        /* char on the field */\\n        p.charT = (p.charT || 0) + dt;\\n        S.vitals -= 0.8 * dt * tune.patient.slip;\\n        if (p.bareT >= 0.6 && !p.charSlip) { p.charSlip = true; slip(S, p, 'char', 2, tune); pushEv(S, ['char', Math.round(p.x), Math.round(p.y)]); }\\n      }\\n    }\\n  }\\n\\n  function stepSuction(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    const pool = nearest(S, p, 14, o => o.type === 'pool' && !o.done && o.vol > 0);\\n    if (!pool) return;\\n    const rate = tune.fluids.suction;\\n    const before = pool.vol;\\n    pool.vol = Math.max(0, pool.vol - rate * dt);\\n    p.suctioned += before - pool.vol;\\n    pool.prog = 1 - pool.vol / (pool.max || 1);\\n    if (pool.vol <= 0.2) { pool.done = true; pool.alive = false; pool.vol = 0; pushEv(S, ['dry', pool.id]); }\\n  }\\n\\n  function stepSonar(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    let rad = 38;\\n    if (S.activeDoc === 'vale' || S.gift === 'breath') rad *= 1.25;\\n    if (S.gift === 'both' && S.activeDoc === 'vale') rad *= 1.25;\\n    p.sonarR = rad;\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n      if (!o.hidden || o.done) continue;\\n      if (hypot(o.x - p.x, o.y - p.y) <= rad) { o.marked = true; o.markT = 4; pushEv(S, ['mark', o.id]); }\\n    }\\n    if (S.device && !S.device.shown && hypot(p.x - (S.device.x || 213), p.y - (S.device.y || 116)) <= rad) {\\n      S.device.shown = true;\\n      pushEv(S, ['board', 1]);\\n    }\\n    if (S.strain && S.strain.kind === 'legato') {\\n      for (const w of S.strain.worms || []) if (hypot(w.x - p.x, w.y - p.y) <= rad) w.marked = true;\\n    }\\n  }\\n\\n  function applyTools(S, p, dt, tune) {\\n    if (p.gone) return;\\n    if (inDome(S, p.x, p.y)) return;\\n    if (p.swap > 0) p.swap -= dt;\\n    p.ox = p.x; p.oy = p.y;\\n    const tool = p.tool;\\n    if (tool === 'forceps') stepForceps(S, p, dt, tune);\\n    else if (tool === 'scalpel') stepScalpel(S, p, dt, tune);\\n    else if (tool === 'suture') stepSuture(S, p, dt, tune);\\n    else if (tool === 'salve') stepSalve(S, p, dt, tune);\\n    else if (tool === 'syringe') stepSyringe(S, p, dt, tune);\\n    else if (tool === 'cautery') stepCautery(S, p, dt, tune);\\n    else if (tool === 'suction') stepSuction(S, p, dt, tune);\\n    else if (tool === 'sonar') stepSonar(S, p, dt, tune);\\n    /* marks expire */\\n  }\\n\\n  /* ---------- strains ---------- */\\n\\n  function stepStrain(S, worldDt, handDt, tune) {\\n    const st = S.strain;\\n    if (!st || st.done) return;\\n    const sp = tune.strains.speed;\\n    if (st.kind === 'staccato') stepStaccato(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'legato') stepLegato(S, st, worldDt, handDt, tune, sp);\\n    else if (st.kind === 'tremolo') stepTremolo(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'dacapo') stepDacapo(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'fermata') stepFermata(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'cantor') stepCantor(S, st, worldDt, tune, sp);\\n  }\\n\\n  function stepStaccato(S, st, dt, tune, sp) {\\n    st.t += dt;\\n    const beat = tune.strains.beat;\\n    for (const b of st.beads) {\\n      if (b.dead) continue;\\n      b.landIn -= dt * sp;\\n      if (!b.hopped && b.landIn < 0.5) b.hopped = true;\\n      if (b.landIn <= 0 && !b.landed) {\\n        b.landed = true; b.x = b.tx; b.y = b.ty;\\n        addObj(S, { type: 'laceration', x: b.x, y: b.y, r: 8, order: 40, drain: 0.2, tag: 'bite' });\\n        pushEv(S, ['bite', Math.round(b.x), Math.round(b.y)]);\\n      }\\n      if (!b.landed) {\\n        const u = clamp(1 - b.landIn / b.flight, 0, 1);\\n        b.x = b.x0 + (b.tx - b.x0) * u;\\n        b.y = b.y0 + (b.ty - b.y0) * u;\\n      }\\n    }\\n    /* cautery kills beads: mirrored onto objects of type bead */\\n    let nests = 0;\\n    for (const o of S.objects) if (o.type === 'nest' && !o.done && o.tag === st.tag) nests++;\\n    if (!nests && !st.collapse) { st.collapse = 3; }\\n    if (st.collapse > 0) {\\n      st.collapse -= dt;\\n      if (st.collapse <= 0) {\\n        for (const b of st.beads) b.dead = true;\\n        for (const o of S.objects) if (o.type === 'bead' && o.tag === st.tag) { o.done = true; o.alive = false; }\\n        st.done = true;\\n      }\\n    }\\n    syncBeads(S, st);\\n    if (st.beads.length && st.beads.every(b => b.dead) && nests === 0) st.done = true;\\n  }\\n\\n  function syncBeads(S, st) {\\n    for (const b of st.beads) {\\n      if (b.dead) continue;\\n      let o = b.oid ? objById(S, b.oid) : null;\\n      if (!o) {\\n        o = addObj(S, { type: 'bead', x: b.x, y: b.y, need: 0.12, order: 5, tag: st.tag, drain: 0 });\\n        b.oid = o.id;\\n      } else {\\n        o.x = b.x; o.y = b.y;\\n        if (o.done) b.dead = true;\\n      }\\n    }\\n  }\\n\\n  function stepLegato(S, st, dt, handDt, tune, sp) {\\n    for (const w of st.worms) {\\n      if (w.done) continue;\\n      w.t += dt * sp;\\n      /* head crawls along its path until surfaced */\\n      if (!w.surfaced && !w.out) {\\n        w.along = Math.min(w.pathLen, w.along + 18 * dt * sp);\\n        const p = pointAlong(w.path, w.along);\\n        w.x = p[0]; w.y = p[1];\\n        /* open a slur guide when the head nears it */\\n        for (const g of w.slurs) {\\n          if (g.opened || g.done) continue;\\n          if (hypot(w.x - g.x, w.y - g.y) < 28) {\\n            g.opened = true;\\n            const o = addObj(S, { type: 'slur', x: g.x, y: g.y, len: 18, order: 1, tag: 'slur-' + w.id + '-' + g.i, drain: 0, guide: [[g.x - 9, g.y], [g.x + 9, g.y]] });\\n            g.oid = o.id;\\n          }\\n        }\\n      }\\n      for (const g of w.slurs) {\\n        if (!g.oid || g.done) continue;\\n        const o = objById(S, g.oid);\\n        if (o && o.done) g.done = true;\\n      }\\n      const slursLeft = w.slurs.filter(g => !g.done).length;\\n      if (!slursLeft && !w.surfaced) {\\n        w.surfaced = true; w.marked = true;\\n        const head = addObj(S, {\\n          type: 'shard', x: w.x, y: w.y, axis: w.axis || [1, 0], depth: 18, order: 2,\\n          tag: 'legato-head', worm: w.id, tension: 70, drain: 0.15, hidden: false,\\n          holdZone: w.hold || null, barbs: w.barbAt || 0,\\n        });\\n        w.head = head.id;\\n      }\\n      const head = w.head ? objById(S, w.head) : null;\\n      if (head && head.snapped && !w.snapped) {\\n        w.snapped = true; st.snapped = true;\\n        /* regrow a head further along and flee */\\n        head.done = true; head.alive = false;\\n        w.surfaced = false; w.out = false; w.head = 0;\\n        w.along = Math.min(w.pathLen - 4, w.along + 30);\\n        w.slurs.push({ i: 90 + w.slurs.length, x: w.x + 16, y: w.y, opened: false, done: false });\\n        pushEv(S, ['regrow', w.id]);\\n      }\\n      if (head && head.done && !w.out) {\\n        w.pulled = (w.pulled || 0) + 1;\\n        /* barb every 4th segment: if not clamped, snapping already handled via tension */\\n        if (w.barbAt && w.pulled % 4 === 0 && !head.clamped && !w.barbCleared) {\\n          /* require a clamp before the next length counts — head.done means the whole pull finished.\\n             Barbs are separate cautery objects spawned at the hold. */\\n        }\\n        w.segments -= 4;\\n        if (w.segments <= w.half && !w.split && st.worms.length < 3) {\\n          w.split = true; w.half = -1;\\n          st.worms.push(makeWorm(S, w.x + 20, w.y + 14, Math.max(4, w.segments >> 1), w.id + 1));\\n          pushEv(S, ['split', w.id]);\\n        }\\n        if (w.segments <= 0) { w.done = true; w.out = true; }\\n        else {\\n          /* next length */\\n          w.out = false; w.surfaced = true;\\n          const h2 = addObj(S, {\\n            type: 'shard', x: w.x, y: w.y, axis: [1, 0], depth: 14, order: 2,\\n            tag: 'legato-head', worm: w.id, tension: 70, drain: 0.1,\\n            holdZone: w.barbAt && (w.pulled % 4 === 0) ? [w.x + 30, w.y, 16] : null,\\n          });\\n          w.head = h2.id;\\n          if (w.barbAt && w.pulled % 4 === 0) {\\n            addObj(S, { type: 'barb', x: w.x + 30, y: w.y, need: 0.35, order: 3, tag: 'barb-' + w.id, drain: 0 });\\n          }\\n        }\\n      }\\n    }\\n    if (st.worms.every(w => w.done)) st.done = true;\\n  }\\n\\n  function makeWorm(S, x, y, segments, id) {\\n    const path = [];\\n    for (let i = 0; i < 8; i++) path.push([x + i * 14, y + Math.sin(i) * 8]);\\n    let pathLen = 0;\\n    for (let i = 1; i < path.length; i++) pathLen += hypot(path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1]);\\n    const slurs = [0.25, 0.5, 0.75].map((u, i) => {\\n      const p = pointAlong(path, pathLen * u);\\n      return { i, x: p[0], y: p[1], opened: false, done: false };\\n    });\\n    return { id, x, y, path, pathLen, along: 0, segments, half: segments / 2, slurs, surfaced: false, done: false, t: 0, split: false, pulled: 0, barbAt: 4, marked: false, axis: [1, 0] };\\n  }\\n  function pointAlong(path, dist) {\\n    let left = dist;\\n    for (let i = 1; i < path.length; i++) {\\n      const L = hypot(path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1]) || 1;\\n      if (left <= L) {\\n        const u = left / L;\\n        return [path[i - 1][0] + (path[i][0] - path[i - 1][0]) * u, path[i - 1][1] + (path[i][1] - path[i - 1][1]) * u];\\n      }\\n      left -= L;\\n    }\\n    return path[path.length - 1].slice();\\n  }\\n\\n  function stepTremolo(S, st, dt, tune) {\\n    st.t += dt;\\n    st.beat = (st.t % 0.8) / 0.8;\\n    const peak = st.beat > 0.85 || st.beat < 0.1;\\n    st.flare = peak;\\n    S.flags.onBeat = st.beat > 0.45 && st.beat < 0.7 ? false : st.beat < 0.15;\\n    /* vitals shake and drain */\\n    if (!S.breath) S.vitals -= 0.6 * st.amp * dt * tune.strains.damage;\\n    for (const o of S.objects) if (o.type === 'reed' && o.tag === 'reed') o.window = !!st.flare;\\n    const reeds = S.objects.filter(o => o.type === 'reed' && !o.done);\\n    if (st.stage === 1 && reeds.length === 0) { st.stage = 2; st.amp = Math.min(st.amp, 0.2); }\\n    if (st.amp <= 0.2 && st.stage === 1) st.stage = 2;\\n    if (st.stage === 2) {\\n      st.wake -= dt;\\n      if (st.wake <= 0) {\\n        st.wake = 6;\\n        /* a reed returns */\\n        if (S.objects.filter(o => o.type === 'reed' && !o.done).length < 2) {\\n          addObj(S, { type: 'reed', x: st.x - 20 + rnd(S) * 40, y: st.y - 10, order: 1, tag: 'reed', drain: 0, window: false });\\n        }\\n      }\\n      const mass = S.objects.find(o => o.type === 'tremass');\\n      if (mass && mass.done && st.stage === 2) {\\n        st.stage = 3;\\n        addObj(S, { type: 'shard', x: st.x, y: st.y, axis: [1, 0], depth: 40, order: 4, tag: 'tremolo-pull', tension: 90, drain: 0.2 });\\n      }\\n    }\\n    if (st.stage === 3) {\\n      const pull = S.objects.find(o => o.tag === 'tremolo-pull');\\n      if (pull && pull.done) st.done = true;\\n    }\\n    /* amp falls when a reed is dosed */\\n    const deadReeds = st.reed0 - S.objects.filter(o => o.type === 'reed' && !o.done).length;\\n    st.amp = clamp(1 - deadReeds * 0.2, 0.15, 1);\\n    if (st.stage >= 2) st.amp = Math.min(st.amp, 0.2);\\n  }\\n\\n  function stepDacapo(S, st, dt, tune, sp) {\\n    st.t += dt * sp * (st.round === 2 ? 2 : 1);\\n    let anyDead = false;\\n    for (const L of st.lobes) {\\n      if (L.dead) { anyDead = true; continue; }\\n      const period = L.period / (st.round === 2 ? 2 : 1);\\n      const openFor = L.openFor / (st.round === 2 ? 2 : 1);\\n      const u = st.t % period;\\n      L.open = u < openFor;\\n      const o = objById(S, L.oid);\\n      if (o) { o.open = L.open && !L.dead; o.x = L.x; o.y = L.y; if (o.done && !L.dead) { L.dead = true; anyDead = true; if (st.count < 0) st.count = 10; } }\\n    }\\n    if (st.count >= 0) {\\n      st.count -= dt;\\n      if (st.count <= 0 && st.lobes.some(L => L.dead) && st.lobes.some(L => !L.dead)) {\\n        /* from the top */\\n        for (const L of st.lobes) {\\n          L.dead = false;\\n          const o = objById(S, L.oid);\\n          if (o) { o.done = false; o.alive = true; o.prog = 0; o.burn = 0; o.dosed = false; o.open = false; if (o.cells) for (const c of o.cells) c[2] = 0; }\\n        }\\n        S.vitals -= 8;\\n        st.count = -1;\\n        st.repeated = (st.repeated || 0) + 1;\\n        if (st.round === 1) { st.round = 2; st.t = 0; spawnBeadsN(S, st, 4); }\\n        pushEv(S, ['dacapo', st.repeated]);\\n      } else if (st.count <= 0) st.count = -1;\\n    }\\n    if (st.lobes.every(L => L.dead) && st.count < 0) {\\n      if (st.round === 1) {\\n        st.round = 2; st.t = 0; st.count = -1;\\n        for (const L of st.lobes) {\\n          L.dead = false;\\n          const o = objById(S, L.oid);\\n          if (o) { o.done = false; o.alive = true; o.prog = 0; o.burn = 0; o.dosed = false; if (o.cells) for (const c of o.cells) c[2] = 0; }\\n        }\\n        spawnBeadsN(S, st, 4);\\n        pushEv(S, ['round2', 1]);\\n      } else if (S.objects.every(o => o.type !== 'bead' || o.done)) st.done = true;\\n    }\\n    if (st.round === 2 && st.lobes.every(L => L.dead) && S.objects.every(o => o.type !== 'bead' || o.done || o.tag !== 'dacapo-bead')) st.done = true;\\n  }\\n\\n  function spawnBeadsN(S, st, n) {\\n    st.beads = st.beads || [];\\n    for (let i = 0; i < n; i++) {\\n      const b = { x: 180 + i * 16, y: 100, tx: 190 + i * 14, ty: 130, x0: 180 + i * 16, y0: 100, landIn: 0.8, flight: 0.8, dead: false, landed: false, hopped: false };\\n      st.beads.push(b);\\n      const o = addObj(S, { type: 'bead', x: b.x, y: b.y, need: 0.12, order: 6, tag: 'dacapo-bead', drain: 0 });\\n      b.oid = o.id;\\n    }\\n    if (!st.kindBead) st.kindBead = true;\\n  }\\n\\n  function stepFermata(S, st, dt, tune) {\\n    st.t += dt;\\n    for (const d of st.domes) if (d.t > 0) d.t -= dt;\\n    st.domes = st.domes.filter(d => d.t > 0);\\n    if (st.stage === 1 && st.domes.length === 0 && !st.eyeOpen) {\\n      st.eyeOpen = S.breath ? 2.8 : 0.7;\\n      st.eye.open = true;\\n      const o = objById(S, st.eye.oid);\\n      if (o) o.open = true;\\n    }\\n    if (st.eyeOpen > 0) {\\n      st.eyeOpen -= dt;\\n      if (st.eyeOpen <= 0) {\\n        st.eye.open = false;\\n        const o = objById(S, st.eye.oid);\\n        if (o && !o.done) o.open = false;\\n        if (st.hits < 3 && st.stage === 1) {\\n          /* raise another dome */\\n          if (st.domes.length < 3) st.domes.push({ x: st.eye.x, y: st.eye.y, r: 34, t: 5 });\\n        }\\n      }\\n    }\\n    const eye = objById(S, st.eye.oid);\\n    if (eye && eye.done) { st.hits += 1; eye.done = false; eye.alive = true; eye.burn = 0; eye.prog = 0; eye.open = false; st.eye.open = false; }\\n    if (st.hits >= 3 && st.stage === 1) {\\n      st.stage = 2;\\n      st.eye.x = 250; st.eye.y = 90; st.eye.hidden = true;\\n      if (eye) { eye.x = 250; eye.y = 90; eye.hidden = true; eye.marked = false; eye.done = false; eye.alive = true; }\\n      addObj(S, { type: 'shard', x: 160, y: 140, axis: [1, 0], depth: 12, order: 3, tag: 'sliver-a', drain: 0.1, hidden: true });\\n      addObj(S, { type: 'shard', x: 180, y: 150, axis: [0.6, 0.8], depth: 12, order: 3, tag: 'sliver-b', drain: 0.1, hidden: true });\\n    }\\n    if (st.stage === 2 && eye && eye.marked) eye.hidden = false;\\n    if (st.stage === 2 && eye && eye.done && S.objects.every(o => o.tag !== 'sliver-a' && o.tag !== 'sliver-b' || o.done)) {\\n      /* eye.done was consumed as a hit; require the flee eye burned once more and slivers out */\\n    }\\n    if (st.stage === 2) {\\n      const slivers = S.objects.filter(o => o.tag === 'sliver-a' || o.tag === 'sliver-b');\\n      const eyeBurned = st.hits >= 4;\\n      if (eye && eye.done) st.hits = Math.max(st.hits, 4);\\n      if (eyeBurned && slivers.every(o => o.done)) {\\n        st.stage = 3;\\n        addObj(S, { type: 'note', x: st.eye.x, y: st.eye.y, axis: [0, -1], depth: 28, tension: 40, order: 5, tag: 'fermata-pull', drain: 0.15 });\\n      }\\n    }\\n    if (st.stage === 3) {\\n      const pull = S.objects.find(o => o.tag === 'fermata-pull');\\n      if (pull && pull.done) st.done = true;\\n    }\\n  }\\n\\n  function stepCantor(S, st, dt, tune) {\\n    st.t += dt;\\n    if (st.move === 1) {\\n      /* tendrils then uvulas, objects already spawned by the phase */\\n      const left = S.objects.filter(o => (o.tag === 'tendril' || o.tag === 'uvula') && !o.done);\\n      if (!left.length) { st.move = 2; st.t = 0; S.clock += 120; S.flags.hush = true; pushEv(S, ['movement', 2]); spawnVoice(S, st); }\\n    } else if (st.move === 2) {\\n      S.flags.hush = true;\\n      st.beat = (st.t % 0.9);\\n      for (const o of S.objects) if (o.type === 'voice') o.window = st.beat > 0.35 && st.beat < 0.7;\\n      if (st.domes && st.t > 2 && st.domes.length < 2 && Math.floor(st.t) % 5 === 0) {\\n        /* one dome refreshes */\\n      }\\n      st.jitter = true;\\n      const voices = S.objects.filter(o => o.type === 'voice' && !o.done);\\n      if (!voices.length) { st.move = 3; st.t = 0; S.clock += 120; S.flags.hush = false; st.signs = 0; pushEv(S, ['movement', 3]); }\\n    } else if (st.move === 3) {\\n      st.cycleT = (st.cycleT || 0) + dt;\\n      if (!st.winding && st.cycleT >= 20) { st.winding = 3; st.cycleT = 0; openRepeat(S, st); }\\n      if (st.winding > 0) {\\n        st.winding -= dt;\\n        if (st.winding <= 0) {\\n          const sign = S.objects.find(o => o.tag === 'repeat' && !o.done);\\n          if (sign) {\\n            forceRewind(S, true);\\n            st.rewound = (st.rewound || 0) + 1;\\n          } else st.signs = (st.signs || 0) + 1;\\n          st.winding = 0;\\n          closeRepeat(S);\\n        }\\n      }\\n      const sign = S.objects.find(o => o.tag === 'repeat' && o.done);\\n      if (sign) { st.signs = (st.signs || 0) + 1; sign.tag = 'repeat-spent'; }\\n      if ((st.signs || 0) >= 6) { st.move = 4; st.t = 0; S.clock += 120; pushEv(S, ['movement', 4]); spawnCoda(S, st); }\\n    } else if (st.move === 4) {\\n      st.beat = (st.t % 0.8) / 0.8;\\n      S.flags.onBeat = st.beat < 0.25;\\n      const spiral = S.objects.find(o => o.type === 'spiral' && o.tag === 'last-note');\\n      const note = S.objects.find(o => o.tag === 'the-note');\\n      const wound = S.objects.find(o => o.tag === 'final-wound');\\n      if (spiral && spiral.done && !st.noteOut) {\\n        st.noteOut = true;\\n        addObj(S, { type: 'note', x: 213, y: 116, axis: [0, -1], depth: 36, tension: 80, order: 2, tag: 'the-note', drain: 0 });\\n      }\\n      if (note && note.done && !wound) {\\n        addObj(S, { type: 'wound', x: 213, y: 130, stitches: 6, order: 3, tag: 'final-wound', drain: 0.3 });\\n      }\\n      if (wound && wound.done) st.done = true;\\n    }\\n  }\\n\\n  function openRepeat(S, st) {\\n    const existing = S.objects.find(o => o.tag === 'repeat');\\n    if (existing) { existing.done = false; existing.alive = true; existing.open = true; existing.prog = 0; return existing; }\\n    return addObj(S, { type: 'repeat', x: 213, y: 100, len: 36, order: 1, tag: 'repeat', open: true, drain: 0, guide: [[190, 100], [236, 100]] });\\n  }\\n  function closeRepeat(S) {\\n    for (const o of S.objects) if (o.tag === 'repeat' && !o.done) { o.open = false; }\\n  }\\n  function spawnVoice(S, st) {\\n    st.domes = [{ x: 180, y: 120, r: 34, t: 4 }, { x: 240, y: 110, r: 34, t: 5 }];\\n    for (let i = 0; i < 3; i++) addObj(S, { type: 'voice', x: 200 + i * 14, y: 116, hidden: true, order: 1, tag: 'voice', drain: 0.2, window: false });\\n    st.jitter = true; st.amp = 0.6;\\n  }\\n  function spawnCoda(S, st) {\\n    const guide = [];\\n    for (let i = 0; i <= 16; i++) {\\n      const a = i / 16 * Math.PI * 1.6;\\n      guide.push([213 + Math.cos(a) * (20 + i * 3), 116 + Math.sin(a) * (12 + i * 2)]);\\n    }\\n    addObj(S, { type: 'spiral', x: 213, y: 116, guide, order: 1, tag: 'last-note', beatLock: true, drain: 0, ring: false });\\n  }\\n\\n  function spawnStrain(S, kind, opts) {\\n    opts = opts || {};\\n    if (kind === 'staccato') {\\n      const st = { kind, tag: opts.tag || 'stacc', t: 0, beads: [], done: false, collapse: 0 };\\n      const n = opts.nests || 2;\\n      for (let i = 0; i < n; i++) {\\n        addObj(S, { type: 'nest', x: opts.x || (180 + i * 40), y: opts.y || 120, hidden: true, order: 2, tag: st.tag, slash: true, drain: 0.15, r: 8 });\\n      }\\n      const beads = opts.beads || 4;\\n      for (let i = 0; i < beads; i++) {\\n        st.beads.push({ x: 160 + i * 12, y: 90, x0: 160 + i * 12, y0: 90, tx: 170 + (i % 3) * 18, ty: 140, landIn: 0.6 + i * 0.15, flight: 0.7, dead: false, landed: false, hopped: false });\\n      }\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'legato') {\\n      const seg = opts.segments || 8;\\n      const w = makeWorm(S, opts.x || 150, opts.y || 120, seg, 1);\\n      w.marked = false;\\n      const st = { kind, worms: [w], done: false, snapped: false };\\n      /* head starts hidden: a sonar target */\\n      addObj(S, { type: 'hold', x: w.x, y: w.y, hidden: true, order: 0, tag: 'legato-hide', drain: 0 });\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'tremolo') {\\n      const st = { kind, t: 0, amp: 1, stage: 1, x: opts.x || 213, y: opts.y || 116, wake: 6, reed0: 5, done: false, jitter: true, beat: 0, flare: false };\\n      for (let i = 0; i < 5; i++) {\\n        const a = -Math.PI / 2 + i * TAU / 5;\\n        addObj(S, { type: 'reed', x: st.x + Math.cos(a) * 28, y: st.y + Math.sin(a) * 18, order: 1, tag: 'reed', drain: 0, window: false });\\n      }\\n      addObj(S, { type: 'tremass', x: st.x, y: st.y, need: 3, order: 3, tag: 'tremass', drain: 0.3 });\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'dacapo') {\\n      const lobes = [\\n        { id: 'A', mode: 'cautery', period: 6, openFor: 2.5, x: 180, y: 110 },\\n        { id: 'B', mode: 'slash', period: 7, openFor: 2.5, x: 213, y: 130 },\\n        { id: 'C', mode: 'syringe', period: 9, openFor: 3, x: 246, y: 112 },\\n      ];\\n      const st = { kind, t: 0, round: 1, count: -1, lobes, done: false, repeated: 0 };\\n      for (const L of lobes) {\\n        const spec = { type: 'lobe', x: L.x, y: L.y, mode: L.mode === 'slash' ? 'scalpel' : L.mode, order: 1, tag: 'lobe-' + L.id, open: false, drain: 0.15, need: L.mode === 'cautery' ? 1 : 0.5 };\\n        if (L.mode === 'slash') { spec.guide = [[L.x - 10, L.y], [L.x + 10, L.y]]; spec.mode = 'scalpel'; spec.slash = true; }\\n        if (L.mode === 'syringe') { spec.mode = 'syringe'; spec.follow = 'salve'; }\\n        const o = addObj(S, spec);\\n        L.oid = o.id; L.dead = false; L.open = false;\\n      }\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'fermata') {\\n      const st = { kind, t: 0, stage: 1, hits: 0, eyeOpen: 0, done: false, jitter: false, amp: 0,\\n        domes: [{ x: 200, y: 116, r: 34, t: 5 }],\\n        eye: { x: 200, y: 116, open: false, hidden: false } };\\n      const o = addObj(S, { type: 'eye', x: 200, y: 116, need: 0.3, order: 1, tag: 'eye', open: false, drain: 0.2 });\\n      st.eye.oid = o.id;\\n      addObj(S, { type: 'eloquent', x: 150, y: 100, guide: [[140, 90], [180, 110]], order: 0, drain: 0, tag: 'eloq' });\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'cantor') {\\n      const st = { kind, t: 0, move: 1, done: false, signs: 0, jitter: false, amp: 0.4, domes: [] };\\n      for (let i = 0; i < 3; i++) addObj(S, { type: 'tendril', x: 170 + i * 30, y: 100, len: 28, order: 1, tag: 'tendril', drain: 0.15, guide: [[160 + i * 30, 100], [190 + i * 30, 108]] });\\n      for (let i = 0; i < 3; i++) addObj(S, { type: 'uvula', x: 180 + i * 26, y: 140, need: 1.5, order: 2, tag: 'uvula', drain: 0.2 });\\n      S.strain = st;\\n      return st;\\n    }\\n    return null;\\n  }\\n\\n  /* ---------- phase / scripts ---------- */\\n\\n  function phaseClear(S) {\\n    if (S.strain && !S.strain.done) return false;\\n    for (const o of S.objects) {\\n      if (o.done || !o.alive) continue;\\n      if (o.type === 'nerve' || o.type === 'eloquent' || o.type === 'hold') continue;\\n      if (o.optional) continue;\\n      if (o.type === 'bead') continue;\\n      return false;\\n    }\\n    if (S.strain && S.strain.kind === 'staccato') {\\n      const live = (S.strain.beads || []).some(b => !b.dead);\\n      if (live && !S.strain.done) return false;\\n    }\\n    return true;\\n  }\\n\\n  function runScript(S, id, tune) {\\n    if (id === 'dip') { S.flags.dip = 40; }\\n    else if (id === 'crash') { S.flags.crash = 8; }\\n    else if (id === 'breath') { S.flags.needBreath = true; }\\n    else if (id === 'look') { S.flags.needLook = true; }\\n    else if (id === 'lurch') {\\n      slip(S, S.players[0], 'lurch', 3, tune);\\n      for (const o of S.objects) if (!o.done) { o.x += 10; o.y += 4; if (o.origin) { o.origin = [o.origin[0] + 10, o.origin[1] + 4]; } }\\n      S.flags.needLook = true;\\n      pushEv(S, ['lurch', 1]);\\n    } else if (id === 'blackout') { S.dim = 1; }\\n    else if (id === 'roll') { S.tiltAmp = 1; }\\n    else if (id === 'quiet') { S.flags.quiet = true; S.flags.needBreath = true; }\\n    else if (id === 'refill') { S.clock += 120; }\\n    else if (id === 'cantorRewind') { forceRewind(S, true); }\\n    else if (id === 'code') { S.vitals = 0; }\\n  }\\n\\n  function stepWorld(S, worldDt, handDt, tune) {\\n    if (S.flags.dip) {\\n      S.vitals += (S.flags.dip - S.vitals) * Math.min(1, worldDt * 2);\\n      if (Math.abs(S.vitals - S.flags.dip) < 0.4) { S.vitals = S.flags.dip; S.flags.dip = 0; }\\n    }\\n    if (S.flags.crash) {\\n      S.vitals -= S.flags.crash * worldDt;\\n    }\\n    if (S.tiltAmp) {\\n      const drift = Math.sin(S.worldT * 0.7) * 25 * S.tiltAmp;\\n      for (const o of S.objects) if (o.type === 'pool' && !o.done) {\\n        o.x = clamp(o.x + drift * worldDt, 60, 360);\\n      }\\n    }\\n    for (const o of S.objects) {\\n      if (o.markT > 0) { o.markT -= handDt; if (o.markT <= 0 && o.hidden) o.marked = false; }\\n      if (o.type === 'bleeder' && !o.done) {\\n        let pool = S.objects.find(p => p.type === 'pool' && p.tag === 'fed-' + o.id);\\n        if (!pool) pool = addObj(S, { type: 'pool', x: o.x, y: o.y + 8, vol: 4, max: 40, order: o.order + 1, tag: 'fed-' + o.id, drain: 0 });\\n        if (!pool.done) pool.vol = Math.min(pool.max, pool.vol + 6 * worldDt * tune.fluids.bleed);\\n      }\\n      if (o.type === 'arteryTear' && !o.done) {\\n        let pool = S.objects.find(p => p.type === 'pool' && p.tag === 'fed-' + o.id);\\n        if (!pool) pool = addObj(S, { type: 'pool', x: o.x, y: o.y + 6, vol: 6, max: 50, order: o.order + 1, tag: 'fed-' + o.id, drain: 0 });\\n        if (!pool.done) pool.vol = Math.min(pool.max, pool.vol + 14 * worldDt * tune.fluids.bleed);\\n      }\\n    }\\n    /* solo retractor: Quill holds at half the window */\\n    const retract = S.objects.find(o => o.type === 'retractor' && !o.done);\\n    if (retract) {\\n      const holder = S.players.some(p => p.held === retract.id && p.trig > 0.3);\\n      if (holder) S.windowOpen = 1;\\n      else if (S.players.filter(p => !p.gone).length <= 1) S.windowOpen = 0.5;\\n      else S.windowOpen = 0;\\n    }\\n    for (let i = 0; i < S.scripts.length; i++) {\\n      const sc = S.scripts[i];\\n      if (sc.done) continue;\\n      if (S.phaseT >= sc.t) { sc.done = true; runScript(S, sc.do, tune); }\\n    }\\n  }\\n\\n  function loadPhase(S, def, index) {\\n    const ph = def.phases[index];\\n    S.phase = index;\\n    S.phaseCount = def.phases.length;\\n    S.phaseName = ph.name;\\n    S.phaseT = 0;\\n    S.objects = S.objects.filter(o => o.persist);\\n    S.strain = null;\\n    S.scripts = (ph.at || []).map(a => ({ t: a.t, do: a.do, done: false }));\\n    S.tutorial = !!ph.tutorial;\\n    S.tutDone = !ph.tutorial;\\n    S.flags = Object.assign({}, S.flags, ph.flags || {});\\n    if (ph.dim != null) S.dim = ph.dim;\\n    if (ph.tilt) S.tiltAmp = ph.tilt;\\n    for (const spec of ph.objects || []) addObj(S, clone(spec));\\n    if (ph.strain) spawnStrain(S, ph.strain, ph.strainOpts || {});\\n    if (ph.onEnter) runScript(S, ph.onEnter, tuneOf(null));\\n    S.checkpoint = takeCore(S);\\n    /* drop the checkpoint's nested copy weight: checkpoint is the core itself */\\n    pushEv(S, ['phase', index, ph.name]);\\n  }\\n\\n  function advancePhase(S) {\\n    const def = (GAME.CASES || {})[S.id];\\n    if (!def) { finishCase(S); return; }\\n    if (S.phase + 1 >= def.phases.length) {\\n      if (!S.dressing && !S.won) {\\n        S.dressing = { t: 0, done: false };\\n        pushEv(S, ['dressing', 1]);\\n        return;\\n      }\\n      return;\\n    }\\n    loadPhase(S, def, S.phase + 1);\\n  }\\n\\n  function create(def, opts) {\\n    opts = opts || {};\\n    const diff = opts.difficulty || opts.diff || 'resident';\\n    const clockMul = diff === 'intern' ? 1.3 : diff === 'attending' ? 0.8 : 1;\\n    const S = blank({\\n      id: def.id, seed: opts.seed || def.seed || 1, players: opts.players || 1,\\n      difficulty: diff, clock: def.clock * clockMul, vitals: def.vitals, drain: def.drain,\\n      gift: def.doctor === 'sokolova' ? 'look' : def.doctor === 'both' ? 'both' : 'breath',\\n      doctor: def.doctor || 'vale', site: def.site, par: def.par || 1000,\\n      mode: def.mode || 'case', consult: !!def.consult,\\n    });\\n    S.clock0 = S.clock;\\n    if (def.doctor === 'both') S.consult = true;\\n    loadPhase(S, def, opts.phase || 0);\\n    return S;\\n  }\\n\\n  function createRaw(opts) {\\n    const S = blank(opts);\\n    for (const spec of opts.objects || []) addObj(S, clone(spec));\\n    if (opts.strain) spawnStrain(S, opts.strain, opts.strainOpts || {});\\n    if (opts.scripts) S.scripts = opts.scripts.map(a => ({ t: a.t, do: a.do, done: false }));\\n    S.checkpoint = takeCore(S);\\n    return S;\\n  }\\n\\n  function readInputs(S, inputs, dt) {\\n    inputs = inputs || [];\\n    for (let i = 0; i < S.players.length; i++) {\\n      const p = S.players[i];\\n      const inp = inputs[i] || {};\\n      const ox = p.x, oy = p.y;\\n      if (inp.x != null) { p.x = inp.x; p.y = inp.y; p.bx = inp.x; p.by = inp.y; }\\n      if (inp.tool) p.tool = inp.tool;\\n      p.inst = hypot(p.x - ox, p.y - oy) / Math.max(dt, 1e-4);\\n      p.fine = !!inp.fine;\\n      p.mouse = !!inp.mouse;\\n      const trig = inp.trig || 0;\\n      p.trigEdge = trig > 0.3 && p.prevTrig <= 0.3;\\n      p.trigRelease = trig <= 0.3 && p.prevTrig > 0.3;\\n      p.prevTrig = trig;\\n      p.trig = trig;\\n      const gift = !!inp.gift;\\n      p.giftEdge = gift && !p.giftPrev;\\n      p.giftPrev = gift;\\n      const consult = !!inp.consult;\\n      p.consultEdge = consult && !p.consultPrev;\\n      p.consultPrev = consult;\\n      p.cancelEdge = !!inp.cancel;\\n      if (p.cancelEdge) { p.held = 0; p.stroke = null; }\\n    }\\n  }\\n\\n  function tryGifts(S, tune) {\\n    for (const p of S.players) {\\n      if (!p.giftEdge) continue;\\n      if (S.breath) { S.breath = false; S.worldScale = 1; pushEv(S, ['breath', 0]); continue; }\\n      const doc = S.activeDoc;\\n      const wantLook = doc === 'sokolova' || (S.gift === 'look' && doc !== 'vale');\\n      const wantBreath = doc === 'vale' || S.gift === 'breath' || (S.gift === 'both' && doc === 'vale');\\n      if (S.gift === 'both') {\\n        if (doc === 'sokolova') { if (secondLook(S, tune)) return; }\\n        else if (S.steady >= 35) { S.breath = true; pushEv(S, ['breath', 1]); return; }\\n      } else if (S.gift === 'look' || wantLook && S.gift !== 'breath') {\\n        secondLook(S, tune);\\n      } else if (wantBreath && S.steady >= 35) {\\n        S.breath = true;\\n        pushEv(S, ['breath', 1]);\\n      }\\n    }\\n    for (const p of S.players) {\\n      if (!p.consultEdge || !S.consult) continue;\\n      S.activeDoc = S.activeDoc === 'vale' ? 'sokolova' : 'vale';\\n      pushEv(S, ['consult', S.activeDoc]);\\n    }\\n  }\\n\\n  function stepCodeBlue(S, dt) {\\n    const cb = S.codeBlue;\\n    if (!cb) return;\\n    cb.t += dt;\\n    const peaks = [0.9, 1.8, 2.7, 3.6];\\n    const p = S.players[0];\\n    if (cb.next == null) cb.next = 0;\\n    if (cb.next < 4) {\\n      const peak = peaks[cb.next];\\n      if (p && p.trigEdge) {\\n        const err = Math.abs(cb.t - peak);\\n        cb.attempts += 1;\\n        if (err <= 0.14) {\\n          cb.hits += 1;\\n          if (err <= 0.06) cb.textbook = (cb.textbook || 0) + 1;\\n          pushEv(S, ['shock', cb.hits, err]);\\n        } else pushEv(S, ['miss', err]);\\n        cb.next += 1;\\n      } else if (cb.t > peak + 0.14) {\\n        cb.attempts += 1;\\n        cb.next += 1;\\n        pushEv(S, ['miss', 1]);\\n      }\\n    }\\n    if (cb.next >= 4 && !cb.resolved) {\\n      cb.resolved = true;\\n      S.codeBlue = null;\\n      if (cb.hits >= 2) {\\n        S.vitals = 30;\\n        S.flags.crash = 0;\\n        pushEv(S, ['revived', cb.textbook >= 2 ? 'textbook' : 'clean']);\\n      } else lose(S, 'code');\\n    }\\n  }\\n\\n  function maybeDie(S) {\\n    if (S.won || S.lost || S.codeBlue || S.dressing) return;\\n    if (S.clock <= 0) { lose(S, 'time'); return; }\\n    if (S.vitals <= 0) {\\n      if (S.diff === 'attending' || S.codeBlueUsed) { lose(S, 'vitals'); return; }\\n      S.codeBlueUsed = true;\\n      S.codeBlue = { t: 0, hits: 0, attempts: 0, next: 0, textbook: 0, resolved: false };\\n      S.vitals = 0;\\n      S.breath = false;\\n      pushEv(S, ['codeblue', 1]);\\n    }\\n  }\\n\\n  function stepDressing(S, dt, tune) {\\n    const d = S.dressing;\\n    d.t += dt;\\n    const u = (d.t % 1.2) / 1.2;\\n    const edge = Math.min(u, 1 - u);\\n    const p = S.players[0];\\n    if (p && p.trigEdge) {\\n      const bonus = edge < 0.08 ? 80 : 20;\\n      S.score += bonus;\\n      d.done = true;\\n      pushEv(S, ['stamp', bonus]);\\n      finishCase(S);\\n    } else if (d.t > 4) {\\n      d.done = true;\\n      finishCase(S);\\n    }\\n  }\\n\\n  function step(S, inputs, dt, tune) {\\n    tune = tuneOf(tune);\\n    if (!dt || dt < 0) dt = 0;\\n    S.ev = [];\\n    if (S.won || S.lost) return S;\\n    readInputs(S, inputs, dt);\\n    if (S.codeBlue) { stepCodeBlue(S, dt); return S; }\\n    tryGifts(S, tune);\\n    if (S.breath) {\\n      S.steady = Math.max(0, S.steady - tune.gift.breathDrain * dt);\\n      if (S.steady <= 0) { S.breath = false; pushEv(S, ['breath', 0]); }\\n    }\\n    S.worldScale = S.breath ? tune.gift.breathFactor : 1;\\n    const worldDt = dt * S.worldScale;\\n    if (S.dressing) { stepDressing(S, dt, tune); return S; }\\n\\n    const frozen = S.tutorial && !S.tutDone;\\n    if (!frozen) {\\n      let hazard = 0;\\n      for (const o of S.objects) {\\n        if (o.done || !o.drain) continue;\\n        if (inDome(S, o.x, o.y)) continue;\\n        hazard += o.drain;\\n      }\\n      const bleed = hazard * tune.fluids.bleed * tune.strains.damage;\\n      S.vitals -= (S.drain * tune.patient.drain * diffDrain(S) + bleed) * worldDt;\\n      S.clock -= worldDt * tune.patient.clock / diffClock(S);\\n      S.steady = Math.min(100, S.steady + 0.5 * tune.gift.charge * worldDt);\\n    }\\n    S.t += dt;\\n    S.worldT += frozen ? 0 : worldDt;\\n    S.phaseT += frozen ? 0 : worldDt;\\n\\n    for (const p of S.players) applyTools(S, p, dt, tune);\\n    if (!frozen) {\\n      stepWorld(S, worldDt, dt, tune);\\n      stepStrain(S, worldDt, dt, tune);\\n    }\\n    if (S.ghostT > 0) S.ghostT -= dt;\\n\\n    if (!frozen) {\\n      S.ringAcc += worldDt;\\n      while (S.ringAcc >= 0.1) { S.ringAcc -= 0.1; pushRing(S); }\\n    }\\n\\n    maybeDie(S);\\n    if (!S.lost && !S.won && !S.codeBlue && phaseClear(S)) advancePhase(S);\\n    return S;\\n  }\\n\\n  /* ---------- cursor and wheel ---------- */\\n\\n  function assistOf(S, tune) {\\n    let a = tune.hands.assist;\\n    if (S && S.diff === 'intern') a += 0.2;\\n    if (S && (S.activeDoc === 'sokolova')) a += 0.2;\\n    return clamp(a, 0, 1.4);\\n  }\\n\\n  function jitterOf(S, p) {\\n    const st = S && S.strain;\\n    if (!st || !st.jitter || (S && S.breath)) return [0, 0];\\n    const amp = 5 * (st.amp == null ? 1 : st.amp) * (p.fine ? 0.35 : 1);\\n    return [Math.sin((S.worldT || 0) * 17.3 + p.id) * amp, Math.cos((S.worldT || 0) * 13.1 + p.id * 2) * amp];\\n  }\\n\\n  function validTarget(S, p, tune) {\\n    const rad = tune.hands.magnet;\\n    return nearest(S, p, rad, o => {\\n      if (!canTouch(S, o)) return false;\\n      if (o.type === 'pool') return p.tool === 'suction';\\n      if (o.type === 'nerve' || o.type === 'eloquent' || o.type === 'hold') return false;\\n      if (p.tool === 'sonar') return !!o.hidden;\\n      if (p.tool === 'salve') return !!o.cells;\\n      if (p.tool === 'syringe') return o.type === 'clot' || o.type === 'reed' || o.type === 'voice' || o.type === 'lobe';\\n      if (p.tool === 'cautery') return o.type === 'polyp' || o.type === 'bleeder' || o.type === 'bead' || o.type === 'uvula' || o.type === 'eye' || o.type === 'rupture' || o.type === 'tremass' || o.type === 'barb' || o.type === 'lobe';\\n      if (p.tool === 'forceps') return o.type === 'shard' || o.type === 'fragment' || o.type === 'mass' || o.type === 'hook' || o.type === 'gaff' || o.type === 'cork' || o.type === 'note' || o.type === 'retractor' || o.type === 'screw' || o.type === 'nest';\\n      if (p.tool === 'scalpel') return !!o.guide;\\n      if (p.tool === 'suture') return !!o.pairs;\\n      return false;\\n    });\\n  }\\n\\n  function updateCursor(p, dev, S, dt, tune) {\\n    tune = tuneOf(tune);\\n    dev = dev || {};\\n    if (dev.mouse) {\\n      p.bx = dev.mouse[0]; p.by = dev.mouse[1];\\n      p.x = p.bx; p.y = p.by;\\n      p.fine = !!dev.fine;\\n      return p;\\n    }\\n    const aim = dev.aim || [0, 0];\\n    let mag = hypot(aim[0], aim[1]);\\n    let dirx = mag > 1e-6 ? aim[0] / mag : 0;\\n    let diry = mag > 1e-6 ? aim[1] / mag : 0;\\n    mag = Math.min(1, mag);\\n    const curved = Math.pow(mag, tune.hands.curve);\\n    let speed = curved * tune.hands.cursor;\\n    if (dev.fine) speed *= tune.hands.fine;\\n    if (S && (S.activeDoc === 'vale')) speed *= 1.15;\\n    /* 0.06s ramp */\\n    const k = 1 - Math.exp(-dt / 0.06);\\n    p.speed += (speed - (p.speed || 0)) * (dt > 0 ? k : 1);\\n    let vx = dirx * p.speed;\\n    let vy = diry * p.speed;\\n    const keys = dev.keys || [0, 0];\\n    const keySp = 200 * (dev.fine ? tune.hands.fine : 1);\\n    vx += keys[0] * keySp; vy += keys[1] * keySp;\\n    const nudge = dev.nudge || [0, 0];\\n    vx += nudge[0] * 40; vy += nudge[1] * 40;\\n\\n    const assist = S ? assistOf(S, tune) : tune.hands.assist;\\n    const tgt = S ? validTarget(S, p, tune) : null;\\n    if (tgt && mag < 0.95) {\\n      vx *= 1 - 0.55 * Math.min(1, assist);\\n      vy *= 1 - 0.55 * Math.min(1, assist);\\n      if (mag < 0.12) {\\n        const dx = tgt.x - p.bx, dy = tgt.y - p.by;\\n        const d = hypot(dx, dy) || 1;\\n        const pull = 90 * assist;\\n        vx += (dx / d) * pull; vy += (dy / d) * pull;\\n      }\\n    }\\n    if (S && p.stroke && (p.stroke.kind === 'scalpel' || p.stroke.kind === 'suture')) {\\n      const o = objById(S, p.stroke.id);\\n      let tanv = [1, 0];\\n      if (o && o.guide) tanv = polyDist(o.guide, p.bx, p.by).tan;\\n      else if (p.stroke.kind === 'suture' && o && o.pairs) {\\n        const pair = o.pairs[o.stitch] || o.pairs[0];\\n        const dx = pair[1][0] - pair[0][0], dy = pair[1][1] - pair[0][1];\\n        const L = hypot(dx, dy) || 1;\\n        tanv = [dx / L, dy / L];\\n      }\\n      const along = vx * tanv[0] + vy * tanv[1];\\n      const cx = vx - along * tanv[0], cy = vy - along * tanv[1];\\n      const scale = 1 - 0.8 * Math.min(1, assist);\\n      vx = along * tanv[0] + cx * scale;\\n      vy = along * tanv[1] + cy * scale;\\n    }\\n    p.bx = clamp(p.bx + vx * dt, 8, CFG.FIELD_W - 8);\\n    p.by = clamp(p.by + vy * dt, 8, CFG.FIELD_H - 8);\\n    const j = S ? jitterOf(S, p) : [0, 0];\\n    p.x = p.bx + j[0];\\n    p.y = p.by + j[1];\\n    p.fine = !!dev.fine;\\n    return p;\\n  }\\n\\n  function wheelIndex(x, y) {\\n    const ang = Math.atan2(y, x); /* 0 east, clockwise because y grows downward */\\n    let d = ang - (-Math.PI / 2);\\n    if (d < 0) d += TAU;\\n    if (d >= TAU) d -= TAU;\\n    return Math.round(d / (Math.PI / 4)) % 8;\\n  }\\n\\n  function updateWheel(p, dev, dt) {\\n    dev = dev || {};\\n    if (dev.digit) {\\n      const i = (dev.digit - 1) % 8;\\n      if (p.tool !== CFG.TOOLS[i]) { p.tool = CFG.TOOLS[i]; p.swap = 0.12; }\\n      return p.tool;\\n    }\\n    const m = dev.move || [0, 0];\\n    const mag = hypot(m[0], m[1]);\\n    if (mag < 0.6) { p.wheelT = 0; p.wheelDir = -1; return p.tool; }\\n    const dir = wheelIndex(m[0], m[1]);\\n    if (dir !== p.wheelDir) { p.wheelDir = dir; p.wheelT = 0; }\\n    p.wheelT += dt;\\n    if (p.wheelT >= 0.08 && p.tool !== CFG.TOOLS[dir]) {\\n      p.tool = CFG.TOOLS[dir];\\n      p.swap = 0.12;\\n      p.wheelT = 0;\\n    }\\n    return p.tool;\\n  }\\n\\n  function retryPhase(S) {\\n    if (!S.checkpoint) return false;\\n    restoreCore(S, S.checkpoint, false);\\n    S.rankCap = 'B';\\n    S.lost = false;\\n    S.won = false;\\n    S.codeBlue = null;\\n    S.reason = '';\\n    for (const p of S.players) { p.held = 0; p.stroke = null; }\\n    pushEv(S, ['retry', S.phase]);\\n    return true;\\n  }\\n\\n  GAME.Sim = {\\n    rnd, clamp, clone, addObj, makePlayer, blank, create, createRaw, step,\\n    takeCore, applyCore, hashCore, rankLetter, secondLook, forceRewind, retryPhase,\\n    updateCursor, updateWheel, wheelIndex, spawnStrain, phaseClear, objById,\\n    polyDist, lose, DRAIN,\\n  };\\n  GAME.Op = { create, createRaw, step, takeCore, hash: S => hashCore(takeCore(S)), rankLetter, secondLook, forceRewind, retryPhase, spawnStrain };\\n  GAME.Cursor = { update: updateCursor, jitterOf, assistOf };\\n  GAME.Wheel = { update: updateWheel, index: wheelIndex, TOOLS: CFG.TOOLS };\\n})();\\n\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/core/sim.js has been created successfully.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/core/sim.js has been created.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/core/sim.js\",\"edits\":{\"details\":[{\"old_string\":\"\",\"old_line\":1,\"new_string\":\"/* Operation sim. Plain data in, plain data out. No drawing, no audio, no DOM.\\n   Cursor and the wheel sit beside it and feed the same inputs a pad does. */\\n(() => {\\n  const G = typeof window !== 'undefined' ? window : globalThis;\\n  const GAME = (G.GAME ||= {});\\n  const CFG = GAME.CFG;\\n  const TAU = Math.PI * 2;\\n\\n  const DRAIN = {\\n    shard: 0.1, fragment: 0.1, cork: 0.1, laceration: 0.2, bite: 0.2, wound: 0.4,\\n    bleeder: 0.5, arteryTear: 1, polyp: 0.1, mass: 0.2, hook: 0.3, gaff: 0.3,\\n    clot: 0.3, patch: 0.1, nest: 0.15, bead: 0, rupture: 0.45, screw: 0, wire: 0,\\n    pool: 0, retractor: 0, slur: 0, reed: 0, tremass: 0.4, lobe: 0.2, eye: 0.35,\\n    tendril: 0.2, uvula: 0.3, voice: 0.4, repeat: 0, spiral: 0, note: 0.2, nerve: 0,\\n    eloquent: 0, hold: 0,\\n  };\\n\\n  function rnd(S) {\\n    let x = (S.rng >>> 0) || 1;\\n    x ^= x << 13; x >>>= 0;\\n    x ^= x >>> 17; x >>>= 0;\\n    x ^= x << 5; x >>>= 0;\\n    if (!x) x = 1;\\n    S.rng = x;\\n    return x / 4294967296;\\n  }\\n  function clamp(v, a, b) { return v < a ? a : v > b ? b : v; }\\n  function hypot(x, y) { return Math.hypot(x, y); }\\n  function clone(v) { return JSON.parse(JSON.stringify(v)); }\\n  function tuneOf(t) { return t || GAME.TUNE || CFG.cloneTune(CFG.TUNING); }\\n  function diffDrain(S) { return S.diff === 'intern' ? 0.7 : S.diff === 'attending' ? 1.3 : 1; }\\n  function diffClock(S) { return S.diff === 'intern' ? 1.3 : S.diff === 'attending' ? 0.8 : 1; }\\n  function syringeDose(S, tune) {\\n    const base = tune.patient.syringe;\\n    if (S.diff === 'intern') return 24 * (base / 18);\\n    if (S.diff === 'attending') return 12 * (base / 18);\\n    return base;\\n  }\\n\\n  function objById(S, id) {\\n    for (let i = 0; i < S.objects.length; i++) if (S.objects[i].id === id) return S.objects[i];\\n    return null;\\n  }\\n\\n  function pushEv(S, ev) { S.ev.push(ev); }\\n\\n  function slip(S, p, kind, dmg, tune) {\\n    S.slips += 1;\\n    if (p) p.slips += 1;\\n    S.vitals -= dmg * tune.patient.slip;\\n    S.streak = 0;\\n    S.flow = 1;\\n    pushEv(S, ['slip', kind, dmg, p ? p.id : -1]);\\n  }\\n\\n  function award(S, p, grade, base, tune) {\\n    const mult = grade === 'textbook' ? 1.5 : grade === 'clean' ? 1 : 0.4;\\n    const pts = base * mult * S.flow;\\n    S.score += pts;\\n    p.score += pts;\\n    p.actions += 1;\\n    S.techAll += 1;\\n    if (grade !== 'sloppy') S.techGood += 1;\\n    if (grade === 'textbook') { p.textbooks += 1; S.steady = Math.min(100, S.steady + 10 * tune.gift.charge); }\\n    else if (grade === 'clean') S.steady = Math.min(100, S.steady + 5 * tune.gift.charge);\\n    if (grade === 'sloppy') { S.streak = 0; S.flow = 1; }\\n    else {\\n      S.streak += 1;\\n      S.flow = Math.min(2, 1 + 0.05 * S.streak);\\n      if (S.flow > S.bestFlow) S.bestFlow = S.flow;\\n    }\\n    if (!S.tutDone) S.tutDone = true;\\n    pushEv(S, ['grade', Math.round(p.x), Math.round(p.y), grade, Math.round(pts)]);\\n    return grade;\\n  }\\n\\n  function makePlayer(i, color) {\\n    return {\\n      id: i, x: 213, y: 150, bx: 213, by: 150, tool: 'forceps', trig: 0, prevTrig: 0,\\n      fine: false, held: 0, stroke: null, heat: 0, lock: 0, fill: 0, over: 0,\\n      cool: 0, score: 0, slips: 0, actions: 0, textbooks: 0, stitches: 0,\\n      suctioned: 0, burned: 0, speed: 0, wheelT: 0, wheelDir: -1, swap: 0,\\n      giftPrev: false, consultPrev: false, color: color || CFG.SEAT[i] || '#e8443a',\\n      gone: false,\\n    };\\n  }\\n\\n  function blank(opts) {\\n    opts = opts || {};\\n    const n = opts.players || 1;\\n    const S = {\\n      id: opts.id || 'raw', seed: (opts.seed >>> 0) || 1, rng: (opts.seed >>> 0) || 1,\\n      diff: opts.difficulty || opts.diff || 'resident',\\n      clock: opts.clock != null ? opts.clock : 180,\\n      clock0: opts.clock != null ? opts.clock : 180,\\n      vitals: opts.vitals != null ? opts.vitals : 80,\\n      drain: opts.drain != null ? opts.drain : 0,\\n      phase: 0, phaseCount: 1, phaseName: opts.phaseName || 'Work',\\n      objects: [], nextId: 1, players: [],\\n      steady: opts.steady || 0, breath: false, worldScale: 1,\\n      gift: opts.gift || 'breath', doctor: opts.doctor || 'vale', activeDoc: opts.doctor || 'vale',\\n      consult: !!opts.consult, mode: opts.mode || 'case',\\n      codeBlueUsed: false, codeBlue: null, lost: false, won: false, closed: false, reason: '',\\n      score: 0, slips: 0, flow: 1, streak: 0, bestFlow: 1, techGood: 0, techAll: 0,\\n      t: 0, worldT: 0, phaseT: 0, ev: [], ghosts: [], ghostT: 0,\\n      ring: [], ringAcc: 0, checkpoint: null, rankCap: null, par: opts.par || 1000,\\n      site: opts.site || 'abdomen', tutorial: !!opts.tutorial, tutDone: !opts.tutorial,\\n      strain: null, flags: {}, scripts: [], tiltAmp: 0, dim: 0, dressing: null,\\n      device: null, windowOpen: 0, dev: !!opts.dev,\\n    };\\n    for (let i = 0; i < n; i++) S.players.push(makePlayer(i, opts.colors && opts.colors[i]));\\n    return S;\\n  }\\n\\n  function addObj(S, spec) {\\n    const o = Object.assign({\\n      id: S.nextId++, type: 'shard', x: 213, y: 116, alive: true, done: false,\\n      hidden: false, marked: false, markT: 0, under: 0, prog: 0, order: 0,\\n      drain: 0, grade: '', tag: '',\\n    }, spec);\\n    if (o.drain == null || spec.drain == null) o.drain = spec.drain != null ? spec.drain : (DRAIN[o.type] || 0);\\n    if (!o.origin) o.origin = [o.x, o.y];\\n    if (!o.axis) o.axis = [1, 0];\\n    const al = hypot(o.axis[0], o.axis[1]) || 1;\\n    o.axis = [o.axis[0] / al, o.axis[1] / al];\\n    if (o.depth == null) o.depth = 16;\\n    if (o.type === 'pool' && o.vol == null) o.vol = o.max || 36;\\n    if (o.type === 'pool' && o.max == null) o.max = o.vol;\\n    if ((o.type === 'wound' || o.type === 'arteryTear') && !o.pairs) {\\n      const n = o.stitches || (o.type === 'arteryTear' ? 3 : 4);\\n      o.pairs = [];\\n      for (let i = 0; i < n; i++) {\\n        const y = o.y - (n - 1) * 4 + i * 8;\\n        o.pairs.push([[o.x - 8, y], [o.x + 8, y]]);\\n      }\\n    }\\n    if (o.pairs) o.stitch = 0;\\n    if ((o.type === 'laceration' || o.type === 'patch' || o.type === 'bite') && !o.cells) {\\n      const r = o.r || 12;\\n      o.cells = [];\\n      for (let y = -r; y <= r; y += 4) for (let x = -r; x <= r; x += 4) {\\n        if (x * x + y * y <= r * r) o.cells.push([o.x + x, o.y + y, 0]);\\n      }\\n    }\\n    if ((o.type === 'mass' || o.type === 'spiral' || o.type === 'slur' || o.type === 'tendril' || o.type === 'wire' || o.type === 'repeat') && !o.guide) {\\n      const len = o.len || 48;\\n      o.guide = [[o.x - len / 2, o.y], [o.x + len / 2, o.y]];\\n    }\\n    if (o.type === 'mass' && !o.ring) {\\n      o.ring = true;\\n      const rad = o.rad || 16;\\n      o.guide = [];\\n      for (let i = 0; i <= 12; i++) {\\n        const a = -Math.PI / 2 + TAU * i / 12;\\n        o.guide.push([o.x + Math.cos(a) * rad, o.y + Math.sin(a) * rad]);\\n      }\\n    }\\n    if (o.need == null) {\\n      if (o.type === 'polyp') o.need = 0.5;\\n      else if (o.type === 'bleeder' || o.type === 'rupture') o.need = 0.35;\\n      else if (o.type === 'bead') o.need = 0.12;\\n      else if (o.type === 'uvula') o.need = 1.5;\\n      else if (o.type === 'eye') o.need = 0.3;\\n      else if (o.type === 'tremass') o.need = 3;\\n      else o.need = 0.5;\\n    }\\n    S.objects.push(o);\\n    return o;\\n  }\\n\\n  function inDome(S, x, y) {\\n    const st = S.strain;\\n    if (!st || !st.domes) return false;\\n    for (let i = 0; i < st.domes.length; i++) {\\n      const d = st.domes[i];\\n      if (d.t > 0 && hypot(x - d.x, y - d.y) <= d.r) return true;\\n    }\\n    return false;\\n  }\\n\\n  function covered(S, o) {\\n    if (!o.under) return false;\\n    const p = objById(S, o.under);\\n    return !!(p && !p.done && p.vol > 1);\\n  }\\n\\n  function canTouch(S, o) {\\n    if (!o || o.done || !o.alive) return false;\\n    if (covered(S, o)) return false;\\n    if (o.hidden && !o.marked) return false;\\n    if (o.needsWindow && S.windowOpen <= 0) return false;\\n    if (o.type === 'reed' || o.type === 'voice') return !!o.window;\\n    if (o.type === 'lobe') return !!o.open;\\n    if (o.type === 'eye') return !!o.open;\\n    if (o.type === 'repeat') return !!o.open;\\n    return true;\\n  }\\n\\n  function nearest(S, p, rad, pred) {\\n    let best = null, bd = rad;\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n      if (!pred(o)) continue;\\n      const d = hypot(o.x - p.x, o.y - p.y);\\n      if (d <= bd) { bd = d; best = o; }\\n    }\\n    return best;\\n  }\\n\\n  function lose(S, why) {\\n    if (S.lost || S.won) return;\\n    S.lost = true;\\n    S.reason = why;\\n    S.breath = false;\\n    S.worldScale = 1;\\n    pushEv(S, ['lost', why]);\\n  }\\n\\n  function finishCase(S) {\\n    if (S.won || S.lost) return;\\n    S.won = true;\\n    S.closed = true;\\n    S.breath = false;\\n    S.worldScale = 1;\\n    const end = Math.max(0, S.clock) * 2 + Math.max(0, S.vitals) * 3;\\n    S.score += end;\\n    S.endBonus = end;\\n    S.rank = rankLetter(S.score, S.par, S.diff, S.slips, S.rankCap);\\n    pushEv(S, ['closed', S.rank, Math.round(S.score)]);\\n  }\\n\\n  function rankLetter(score, par, diff, slips, cap) {\\n    const r = par > 0 ? score / par : 0;\\n    let L = r >= 0.95 ? 'S' : r >= 0.8 ? 'A' : r >= 0.6 ? 'B' : r >= 0.4 ? 'C' : 'D';\\n    const order = 'DCBAS';\\n    if (cap === 'B' && order.indexOf(L) > order.indexOf('B')) L = 'B';\\n    if (diff === 'attending' && L === 'S' && !slips) return 'S+';\\n    return L;\\n  }\\n\\n  function takeCore(S) {\\n    return {\\n      rng: S.rng, clock: S.clock, vitals: S.vitals, score: S.score, slips: S.slips,\\n      phase: S.phase, steady: S.steady, flow: S.flow, streak: S.streak,\\n      phaseT: S.phaseT, worldT: S.worldT, flags: clone(S.flags),\\n      objects: clone(S.objects), strain: S.strain ? clone(S.strain) : null,\\n      device: S.device ? clone(S.device) : null,\\n      techGood: S.techGood, techAll: S.techAll, bestFlow: S.bestFlow,\\n      codeBlueUsed: S.codeBlueUsed, tutDone: S.tutDone, tutorial: S.tutorial,\\n      windowOpen: S.windowOpen, tiltAmp: S.tiltAmp, dim: S.dim,\\n    };\\n  }\\n\\n  function applyCore(S, core) {\\n    S.rng = core.rng; S.clock = core.clock; S.vitals = core.vitals; S.score = core.score;\\n    S.slips = core.slips; S.phase = core.phase; S.steady = core.steady; S.flow = core.flow;\\n    S.streak = core.streak; S.phaseT = core.phaseT; S.worldT = core.worldT;\\n    S.flags = clone(core.flags); S.objects = clone(core.objects);\\n    S.strain = core.strain ? clone(core.strain) : null;\\n    S.device = core.device ? clone(core.device) : null;\\n    S.techGood = core.techGood; S.techAll = core.techAll; S.bestFlow = core.bestFlow;\\n    S.codeBlueUsed = core.codeBlueUsed; S.tutDone = core.tutDone; S.tutorial = core.tutorial;\\n    S.windowOpen = core.windowOpen; S.tiltAmp = core.tiltAmp; S.dim = core.dim;\\n  }\\n\\n  function hashCore(core) {\\n    const s = JSON.stringify(core);\\n    let h = 2166136261;\\n    for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); }\\n    return h >>> 0;\\n  }\\n\\n  function pushRing(S) {\\n    const cursors = S.players.map(p => [round3(p.x), round3(p.y)]);\\n    const strains = strainGhost(S);\\n    S.ring.push({ t: S.worldT, core: takeCore(S), cursors, strains });\\n    const keep = S.worldT - 6.05;\\n    while (S.ring.length > 2 && S.ring[0].t < keep) S.ring.shift();\\n  }\\n  function round3(v) { return Math.round(v * 1000) / 1000; }\\n\\n  function strainGhost(S) {\\n    const st = S.strain;\\n    if (!st) return [];\\n    if (st.kind === 'legato') return (st.worms || []).map(w => [round3(w.x), round3(w.y)]);\\n    if (st.kind === 'staccato') return (st.beads || []).map(b => [round3(b.x), round3(b.y)]);\\n    if (st.kind === 'fermata' || st.kind === 'cantor') return st.eye ? [[round3(st.eye.x), round3(st.eye.y)]] : [];\\n    if (st.kind === 'tremolo') return [[round3(st.x || 213), round3(st.y || 116)]];\\n    if (st.kind === 'dacapo') return (st.lobes || []).map(L => [round3(L.x), round3(L.y)]);\\n    return [];\\n  }\\n\\n  function restoreCore(S, core, keepHands) {\\n    const hands = S.players.map(p => ({ id: p.id, x: p.x, y: p.y, bx: p.bx, by: p.by, color: p.color }));\\n    applyCore(S, core);\\n    for (let i = 0; i < S.players.length; i++) {\\n      const p = S.players[i];\\n      p.held = 0; p.stroke = null; p.fill = 0; p.over = 0; p.trig = 0; p.prevTrig = 0;\\n      if (keepHands && hands[i]) {\\n        p.x = hands[i].x; p.y = hands[i].y; p.bx = hands[i].bx; p.by = hands[i].by;\\n      }\\n    }\\n  }\\n\\n  function secondLook(S, tune) {\\n    if (S.mode === 'rounds') return false;\\n    if (S.gift !== 'look' && S.gift !== 'both' && S.activeDoc !== 'sokolova' && S.gift !== 'look') {\\n      if (!(S.gift === 'both' || S.activeDoc === 'sokolova' || S.gift === 'look')) return false;\\n    }\\n    const can = S.gift === 'look' || S.gift === 'both' || S.activeDoc === 'sokolova';\\n    if (!can) return false;\\n    if (S.steady < 45) return false;\\n    if (!S.ring.length) return false;\\n    const target = S.worldT - (tune.gift.lookSeconds || 6);\\n    let pick = S.ring[0];\\n    for (let i = 0; i < S.ring.length; i++) if (S.ring[i].t <= target) pick = S.ring[i];\\n    const ghosts = [];\\n    for (let i = 0; i < S.ring.length; i++) {\\n      if (S.ring[i].t + 1e-6 < pick.t) continue;\\n      ghosts.push({ t: S.ring[i].t - pick.t, cursors: S.ring[i].cursors, strains: S.ring[i].strains });\\n    }\\n    restoreCore(S, pick.core, true);\\n    S.steady = Math.max(0, S.steady - 45);\\n    S.ghosts = ghosts;\\n    S.ghostT = tune.gift.lookSeconds || 6;\\n    S.breath = false;\\n    S.worldScale = 1;\\n    pushEv(S, ['rewind', ghosts.length]);\\n    return true;\\n  }\\n\\n  function forceRewind(S, keepSteady) {\\n    const steady = S.steady;\\n    const breath = S.breath;\\n    if (!S.ring.length) return false;\\n    const target = S.worldT - 6;\\n    let pick = S.ring[0];\\n    for (let i = 0; i < S.ring.length; i++) if (S.ring[i].t <= target) pick = S.ring[i];\\n    restoreCore(S, pick.core, true);\\n    if (keepSteady) S.steady = steady;\\n    S.breath = breath;\\n    S.worldScale = breath ? 0.25 : 1;\\n    pushEv(S, ['forced', 1]);\\n    return true;\\n  }\\n\\n  /* ---------- tools ---------- */\\n\\n  function polyDist(pts, x, y) {\\n    let best = 1e9, arcAt = 0, along = 0, total = 0;\\n    const acc = [0];\\n    for (let i = 1; i < pts.length; i++) acc.push(acc[i - 1] + hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));\\n    total = acc[acc.length - 1] || 1;\\n    for (let i = 1; i < pts.length; i++) {\\n      const ax = pts[i - 1][0], ay = pts[i - 1][1], bx = pts[i][0], by = pts[i][1];\\n      const vx = bx - ax, vy = by - ay, L = hypot(vx, vy) || 1;\\n      let t = ((x - ax) * vx + (y - ay) * vy) / (L * L);\\n      t = clamp(t, 0, 1);\\n      const px = ax + vx * t, py = ay + vy * t;\\n      const d = hypot(x - px, y - py);\\n      if (d < best) { best = d; along = acc[i - 1] + t * L; }\\n    }\\n    return { d: best, along, total, tan: tangent(pts, along) };\\n  }\\n  function tangent(pts, along) {\\n    let left = along;\\n    for (let i = 1; i < pts.length; i++) {\\n      const L = hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]) || 1;\\n      if (left <= L || i === pts.length - 1) {\\n        return [(pts[i][0] - pts[i - 1][0]) / L, (pts[i][1] - pts[i - 1][1]) / L];\\n      }\\n      left -= L;\\n    }\\n    return [1, 0];\\n  }\\n\\n  function nerveHit(S, p, tune) {\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n      if (o.type !== 'nerve' && o.type !== 'eloquent') continue;\\n      const pts = o.guide || [[o.x - 20, o.y], [o.x + 20, o.y]];\\n      if (polyDist(pts, p.x, p.y).d < 6) { slip(S, p, 'nerve', 12, tune); return true; }\\n    }\\n    return false;\\n  }\\n\\n  function gradeMean(mean, a, b) {\\n    if (mean <= a) return 'textbook';\\n    if (mean <= b) return 'clean';\\n    return 'sloppy';\\n  }\\n\\n  function stepForceps(S, p, dt, tune) {\\n    const down = p.trig > 0.3;\\n    let held = p.held ? objById(S, p.held) : null;\\n    if (p.trigEdge && !held) {\\n      const o = nearest(S, p, 12, o => canTouch(S, o) && (o.type === 'shard' || o.type === 'fragment' || o.type === 'cork' || o.type === 'hook' || o.type === 'gaff' || o.type === 'clot' || o.type === 'mass' || o.type === 'nest' || o.type === 'note' || o.type === 'retractor' || o.type === 'screw' || (o.type === 'lobe' && o.mode === 'forceps')));\\n      if (o && o.type === 'clot' && !o.dosed) { /* no grip yet */ }\\n      else if (o && (o.type === 'hook' || o.type === 'gaff') && o.barbs) { slip(S, p, 'tear', 4, tune); o.tears = (o.tears || 0) + 1; }\\n      else if (o && o.type === 'mass' && !o.cut) { /* ring first */ }\\n      else if (o && o.type === 'nest' && !o.cut) { /* slash first */ }\\n      else if (o && o.type === 'screw') { p.held = o.id; o.lastAng = Math.atan2(p.y - o.y, p.x - o.x); o.spin = o.spin || 0; }\\n      else if (o && o.type === 'retractor') { p.held = o.id; }\\n      else if (o) {\\n        p.held = o.id; o.t0 = o.t0 || 0; o.pullT = o.pullT || 0; o.gripped = true;\\n        if (!o.origin) o.origin = [o.x, o.y];\\n        pushEv(S, ['grip', o.id]);\\n      }\\n    }\\n    held = p.held ? objById(S, p.held) : null;\\n    if (held && down) {\\n      if (held.type === 'retractor') {\\n        held.x = p.x; held.y = p.y;\\n        S.windowOpen = 1;\\n        return;\\n      }\\n      if (held.type === 'screw') {\\n        const ang = Math.atan2(p.y - held.y, p.x - held.x);\\n        let d = ang - (held.lastAng || ang);\\n        while (d > Math.PI) d -= TAU;\\n        while (d < -Math.PI) d += TAU;\\n        held.spin = (held.spin || 0) + Math.abs(d);\\n        held.lastAng = ang;\\n        if (held.spin >= 3 * TAU) {\\n          held.done = true; held.alive = false; p.held = 0;\\n          award(S, p, 'textbook', 100, tune);\\n          pushEv(S, ['screw', held.id]);\\n        }\\n        return;\\n      }\\n      const ox = held.origin[0], oy = held.origin[1];\\n      const dx = p.x - ox, dy = p.y - oy;\\n      const along = dx * held.axis[0] + dy * held.axis[1];\\n      const px = dx - along * held.axis[0], py = dy - along * held.axis[1];\\n      const perp = hypot(px, py);\\n      const limit = held.tension || 120;\\n      if (!held.free) {\\n        if (p.inst > limit || perp > 8) {\\n          if (held.type === 'note' || (S.strain && S.strain.kind === 'legato' && held.tag === 'legato-head')) {\\n            held.snapped = true;\\n            slip(S, p, 'snap', 4, tune);\\n            pushEv(S, ['snap', held.id]);\\n          } else {\\n            held.tears = (held.tears || 0) + 1;\\n            held.prog = Math.max(0, (held.prog || 0) - held.depth * 0.3);\\n            slip(S, p, 'tear', 4, tune);\\n            pushEv(S, ['tear', held.id]);\\n          }\\n        }\\n        held.prog = Math.max(held.prog || 0, along);\\n        held.pullT = (held.pullT || 0) + dt;\\n        if (along >= held.depth) {\\n          held.free = true;\\n          pushEv(S, ['free', held.id]);\\n        }\\n      } else {\\n        held.x = p.x; held.y = p.y;\\n        held.pullT = (held.pullT || 0) + dt;\\n      }\\n    }\\n    if (held && p.trigRelease) {\\n      if (held.type === 'retractor') { p.held = 0; return; }\\n      if (held.type === 'screw') { p.held = 0; return; }\\n      const d0 = hypot(p.x - held.origin[0], p.y - held.origin[1]);\\n      if (held.holdZone && hypot(p.x - held.holdZone[0], p.y - held.holdZone[1]) <= (held.holdZone[2] || 14)) {\\n        held.clamped = true; held.gripped = false; p.held = 0;\\n        pushEv(S, ['clamp', held.id]);\\n        return;\\n      }\\n      if (held.free && (d0 >= 24 || outside(p.x, p.y))) {\\n        const tears = held.tears || 0;\\n        const parT = held.parTime || (held.depth / 80 + 0.35);\\n        let g = 'sloppy';\\n        if (!tears && (held.pullT || 0) <= parT) g = 'textbook';\\n        else if (tears <= 1) g = 'clean';\\n        held.done = true; held.alive = false; held.grade = g; p.held = 0;\\n        if (held.type === 'note') p.score += 0;\\n        award(S, p, g, 120, tune);\\n        pushEv(S, ['dish', held.id, g]);\\n      } else {\\n        held.gripped = false;\\n        p.held = 0;\\n      }\\n    }\\n  }\\n\\n  function outside(x, y) {\\n    const nx = (x - CFG.CX) / CFG.RX, ny = (y - CFG.CY) / CFG.RY;\\n    return nx * nx + ny * ny > 1;\\n  }\\n\\n  function stepScalpel(S, p, dt, tune) {\\n    const down = p.trig > 0.3;\\n    const tol = tune.hands.grade;\\n    if (p.stroke && p.stroke.kind === 'scalpel') {\\n      const o = objById(S, p.stroke.id);\\n      if (!o || o.done) { p.stroke = null; }\\n    }\\n    if (p.trigEdge && !p.stroke) {\\n      const o = nearest(S, p, 8, o => canTouch(S, o) && o.guide && (o.type === 'mass' || o.type === 'slur' || o.type === 'tendril' || o.type === 'spiral' || o.type === 'wire' || o.type === 'repeat' || o.type === 'lobe' || o.type === 'cut' || o.type === 'nest'));\\n      if (o && o.guide) {\\n        const start = o.guide[0];\\n        if (hypot(p.x - start[0], p.y - start[1]) <= 8 + (p.mouse ? 1 : 0)) {\\n          p.stroke = { kind: 'scalpel', id: o.id, far: 0, sum: 0, n: 0, off: 0, slipped: false };\\n          o.cutting = true;\\n        }\\n      }\\n    }\\n    if (!(p.stroke && p.stroke.kind === 'scalpel') && down && p.inst > 40) {\\n      const onGuide = S.objects.some(o => o.guide && !o.done && polyDist(o.guide, p.x, p.y).d < 8);\\n      if (!onGuide && !outside(p.x, p.y)) {\\n        p.bare = (p.bare || 0) + hypot(p.x - (p.ox || p.x), p.y - (p.oy || p.y));\\n        if (p.bare >= 6) { slip(S, p, 'healthy', 3, tune); p.bare = 0; }\\n      }\\n    }\\n    if (p.stroke && p.stroke.kind === 'scalpel' && down) {\\n      const o = objById(S, p.stroke.id);\\n      if (o && nerveHit(S, p, tune)) { /* counted */ }\\n      if (o && o.guide) {\\n        const hit = polyDist(o.guide, p.x, p.y);\\n        const st = p.stroke;\\n        if (hit.along > st.far) st.far = hit.along;\\n        st.sum += hit.d; st.n += 1;\\n        if (hit.d > 9) st.off += dt; else st.off = 0;\\n        if (st.off >= 0.12 && !st.slipped) {\\n          st.slipped = true; slip(S, p, 'slip', 3, tune);\\n          pushEv(S, ['slipcut', o.id]);\\n        }\\n        o.prog = st.far / (hit.total || 1);\\n        if (o.type === 'spiral' && o.beatLock && S.flags.onBeat) {\\n          if (!st.beatSlip) { st.beatSlip = true; slip(S, p, 'beat', 3, tune); }\\n          o.prog = Math.min(o.prog, st.safe || 0);\\n        } else if (o.type === 'spiral') st.safe = o.prog;\\n        if (st.far >= (hit.total || 1) - 0.5) {\\n          const mean = st.n ? st.sum / st.n : 99;\\n          const g = st.slipped ? 'sloppy' : gradeMean(mean, 1.8 * tol, 4 * tol);\\n          o.done = true; o.alive = false; o.grade = g; o.cut = true;\\n          if (o.type === 'mass') { o.done = false; o.alive = true; o.cut = true; o.type = 'mass'; }\\n          if (o.type === 'nest') { o.done = false; o.alive = true; o.cut = true; }\\n          if (o.type === 'wire') { /* caller checks order */ wireCut(S, p, o, tune); }\\n          else award(S, p, g, 110, tune);\\n          p.stroke = null;\\n          pushEv(S, ['cut', o.id, g]);\\n        }\\n      }\\n    }\\n    if (p.trigRelease && p.stroke && p.stroke.kind === 'scalpel') {\\n      const o = objById(S, p.stroke.id);\\n      if (o && o.prog < 0.98) {\\n        /* resume later if they come back within 6 */\\n        p.stroke.paused = true;\\n      }\\n    }\\n    if (p.trigEdge && p.stroke && p.stroke.paused) {\\n      const o = objById(S, p.stroke.id);\\n      if (o && o.guide) {\\n        const hit = polyDist(o.guide, p.x, p.y);\\n        if (Math.abs(hit.along - p.stroke.far) <= 6 || hit.d <= 6) p.stroke.paused = false;\\n        else p.stroke = null;\\n      }\\n    }\\n    /* slash variant: a fast stroke across a slash target */\\n    if (down && p.inst >= 60) {\\n      const o = nearest(S, p, 10, q => canTouch(S, q) && q.slash && !q.done);\\n      if (o) {\\n        o.done = true; o.alive = false; o.cut = true;\\n        award(S, p, 'clean', 100, tune);\\n        pushEv(S, ['slash', o.id]);\\n      }\\n    }\\n  }\\n\\n  function wireCut(S, p, o, tune) {\\n    const dev = S.device;\\n    if (!dev) { o.done = true; award(S, p, 'clean', 80, tune); return; }\\n    const want = dev.order[dev.next];\\n    if (o.tag === want) {\\n      dev.next += 1; o.done = true; o.alive = false;\\n      award(S, p, 'textbook', 100, tune);\\n      if (dev.next >= dev.order.length) dev.done = true;\\n    } else {\\n      o.done = false; o.alive = true; o.prog = 0; o.cutting = false;\\n      S.vitals -= 30; S.clock = Math.max(0, S.clock - 30);\\n      slip(S, p, 'wire', 0, tune);\\n      pushEv(S, ['badwire', o.tag]);\\n    }\\n  }\\n\\n  function stepSuture(S, p, dt, tune) {\\n    const down = p.trig > 0.3;\\n    const extra = (S.activeDoc === 'sokolova' ? 1 : 0);\\n    if (p.trigEdge) {\\n      const o = nearest(S, p, 9 + extra, q => canTouch(S, q) && q.pairs && (q.stitch || 0) < q.pairs.length);\\n      if (o) {\\n        const a = o.pairs[o.stitch][0];\\n        if (hypot(p.x - a[0], p.y - a[1]) <= 9 + extra) {\\n          p.stroke = { kind: 'suture', id: o.id, i: o.stitch, t: 0 };\\n          pushEv(S, ['needle', o.id, o.stitch]);\\n        }\\n      }\\n    }\\n    if (p.stroke && p.stroke.kind === 'suture' && down) p.stroke.t += dt;\\n    if (p.stroke && p.stroke.kind === 'suture' && p.trigRelease) {\\n      const o = objById(S, p.stroke.id);\\n      const st = p.stroke;\\n      p.stroke = null;\\n      if (!o || o.done) return;\\n      const b = o.pairs[st.i][1];\\n      const tol = 6 + extra + (p.mouse ? 1 : 0);\\n      if (hypot(p.x - b[0], p.y - b[1]) <= tol) {\\n        const g = gradeMean(st.t, 0.6, 1.2);\\n        o.grades = o.grades || [];\\n        o.grades.push(g === 'textbook' ? 2 : g === 'clean' ? 1 : 0);\\n        o.times = o.times || [];\\n        o.times.push(st.t);\\n        o.stitch = st.i + 1;\\n        o.prog = o.stitch / o.pairs.length;\\n        p.stitches += 1;\\n        const bleedLeft = 1 - o.prog;\\n        if (o.type === 'arteryTear') o.drain = 1 * bleedLeft;\\n        else if (o.type === 'wound') o.drain = 0.4 * bleedLeft;\\n        pushEv(S, ['stitch', Math.round(b[0]), Math.round(b[1]), g]);\\n        if (o.stitch >= o.pairs.length) {\\n          const meanT = o.times.reduce((a, c) => a + c, 0) / o.times.length;\\n          const fg = gradeMean(meanT, 0.6, 1.2);\\n          o.done = true; o.alive = false; o.grade = fg; o.drain = 0;\\n          award(S, p, fg, 80 + 20 * o.pairs.length, tune);\\n        }\\n      } else {\\n        slip(S, p, 'loose', 1, tune);\\n        pushEv(S, ['loose', o.id]);\\n      }\\n    }\\n  }\\n\\n  function stepSalve(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    let any = false;\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n      if (!canTouch(S, o) || !o.cells) continue;\\n      if (!(o.type === 'laceration' || o.type === 'patch' || o.type === 'bite' || (o.type === 'lobe' && o.mode === 'salve'))) continue;\\n      for (let c = 0; c < o.cells.length; c++) {\\n        const cell = o.cells[c];\\n        if (!cell[2] && hypot(cell[0] - p.x, cell[1] - p.y) <= 10) { cell[2] = 1; any = true; }\\n      }\\n      let on = 0;\\n      for (let c = 0; c < o.cells.length; c++) if (o.cells[c][2]) on++;\\n      o.prog = o.cells.length ? on / o.cells.length : 1;\\n      if (o.prog >= 0.9 && !o.done) {\\n        o.done = true; o.alive = false; o.drain = 0;\\n        S.vitals = Math.min(99, S.vitals + 2 * tune.patient.healing);\\n        award(S, p, 'clean', 80, tune);\\n        pushEv(S, ['heal', o.id]);\\n      }\\n    }\\n    if (!any && p.trigEdge) { /* salve cannot harm */ }\\n  }\\n\\n  function stepSyringe(S, p, dt, tune) {\\n    if (p.cool > 0) p.cool -= dt;\\n    const down = p.trig > 0.3;\\n    if (down && p.cool <= 0) {\\n      if (p.fill < 1) p.fill = Math.min(1, p.fill + dt / 0.55);\\n      else p.over += dt;\\n    }\\n    if (p.trigRelease && p.fill > 0.05 && p.cool <= 0) {\\n      const bubble = p.over >= 0.3;\\n      const tgt = nearest(S, p, 10, o => canTouch(S, o) && (o.type === 'clot' || o.type === 'reed' || o.type === 'voice' || (o.type === 'lobe' && o.mode === 'syringe')));\\n      if (tgt) {\\n        if ((tgt.type === 'reed' || tgt.type === 'voice') && !tgt.window) {\\n          addObj(S, { type: 'laceration', x: tgt.x + 6, y: tgt.y, r: 8, order: 50, drain: 0.2 });\\n          slip(S, p, 'spit', 2, tune);\\n        } else {\\n          const g = bubble ? 'sloppy' : (p.fill >= 0.9 ? 'textbook' : 'clean');\\n          tgt.dosed = true;\\n          tgt.dose = (bubble ? 0.5 : 1) * p.fill;\\n          if (tgt.type === 'clot') { /* forceps next */ tgt.drain = 0.1; }\\n          else { tgt.done = true; tgt.alive = false; tgt.drain = 0; }\\n          award(S, p, g, 90, tune);\\n          pushEv(S, ['inject', tgt.id, g]);\\n        }\\n      } else {\\n        const g = bubble ? 'sloppy' : (p.fill >= 0.9 ? 'textbook' : 'clean');\\n        const add = syringeDose(S, tune) * p.fill * (bubble ? 0.5 : 1);\\n        S.vitals = Math.min(99, S.vitals + add);\\n        award(S, p, g, 40, tune);\\n        pushEv(S, ['iv', Math.round(add), g]);\\n      }\\n      p.fill = 0; p.over = 0; p.cool = 0.35;\\n    }\\n    if (!down && p.trigRelease === false) { /* keep fill while aiming */ }\\n  }\\n\\n  function stepCautery(S, p, dt, tune) {\\n    if (p.lock > 0) { p.lock -= dt; p.heat = Math.max(0, p.heat - 0.6 * dt); return; }\\n    const down = p.trig > 0.3;\\n    if (!down) {\\n      p.heat = Math.max(0, p.heat - 0.6 * dt);\\n      p.bareT = 0;\\n      return;\\n    }\\n    p.heat += tune.fluids.cauteryHeat * dt;\\n    if (p.heat >= 1) { p.lock = 1.2; p.heat = 1; slip(S, p, 'lock', 1, tune); pushEv(S, ['lock', p.id]); return; }\\n    if (nerveHit(S, p, tune)) return;\\n    const tgt = nearest(S, p, 6, o => canTouch(S, o) && (o.type === 'polyp' || o.type === 'bleeder' || o.type === 'rupture' || o.type === 'bead' || o.type === 'uvula' || o.type === 'eye' || o.type === 'tremass' || (o.type === 'lobe' && o.mode === 'cautery') || o.type === 'barb'));\\n    if (tgt) {\\n      p.bareT = 0;\\n      tgt.burn = (tgt.burn || 0) + dt;\\n      tgt.prog = tgt.burn / (tgt.need || 0.5);\\n      if (tgt.burn >= (tgt.need || 0.5) / Math.max(0.25, tune.strains.health) && !tgt.done) {\\n        const dirty = tgt.charred || p.lockedDuring;\\n        const g = (!tgt.charred && p.lock <= 0 && !p.hadLock) ? 'textbook' : 'clean';\\n        tgt.done = true; tgt.alive = false; tgt.drain = 0; tgt.grade = g;\\n        p.burned += 1;\\n        award(S, p, g, 90, tune);\\n        pushEv(S, ['burn', tgt.id, g]);\\n      }\\n    } else {\\n      p.bareT = (p.bareT || 0) + dt;\\n      if (p.bareT >= 0.25) {\\n        /* char on the field */\\n        p.charT = (p.charT || 0) + dt;\\n        S.vitals -= 0.8 * dt * tune.patient.slip;\\n        if (p.bareT >= 0.6 && !p.charSlip) { p.charSlip = true; slip(S, p, 'char', 2, tune); pushEv(S, ['char', Math.round(p.x), Math.round(p.y)]); }\\n      }\\n    }\\n  }\\n\\n  function stepSuction(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    const pool = nearest(S, p, 14, o => o.type === 'pool' && !o.done && o.vol > 0);\\n    if (!pool) return;\\n    const rate = tune.fluids.suction;\\n    const before = pool.vol;\\n    pool.vol = Math.max(0, pool.vol - rate * dt);\\n    p.suctioned += before - pool.vol;\\n    pool.prog = 1 - pool.vol / (pool.max || 1);\\n    if (pool.vol <= 0.2) { pool.done = true; pool.alive = false; pool.vol = 0; pushEv(S, ['dry', pool.id]); }\\n  }\\n\\n  function stepSonar(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    let rad = 38;\\n    if (S.activeDoc === 'vale' || S.gift === 'breath') rad *= 1.25;\\n    if (S.gift === 'both' && S.activeDoc === 'vale') rad *= 1.25;\\n    p.sonarR = rad;\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n      if (!o.hidden || o.done) continue;\\n      if (hypot(o.x - p.x, o.y - p.y) <= rad) { o.marked = true; o.markT = 4; pushEv(S, ['mark', o.id]); }\\n    }\\n    if (S.device && !S.device.shown && hypot(p.x - (S.device.x || 213), p.y - (S.device.y || 116)) <= rad) {\\n      S.device.shown = true;\\n      pushEv(S, ['board', 1]);\\n    }\\n    if (S.strain && S.strain.kind === 'legato') {\\n      for (const w of S.strain.worms || []) if (hypot(w.x - p.x, w.y - p.y) <= rad) w.marked = true;\\n    }\\n  }\\n\\n  function applyTools(S, p, dt, tune) {\\n    if (p.gone) return;\\n    if (inDome(S, p.x, p.y)) return;\\n    if (p.swap > 0) p.swap -= dt;\\n    p.ox = p.x; p.oy = p.y;\\n    const tool = p.tool;\\n    if (tool === 'forceps') stepForceps(S, p, dt, tune);\\n    else if (tool === 'scalpel') stepScalpel(S, p, dt, tune);\\n    else if (tool === 'suture') stepSuture(S, p, dt, tune);\\n    else if (tool === 'salve') stepSalve(S, p, dt, tune);\\n    else if (tool === 'syringe') stepSyringe(S, p, dt, tune);\\n    else if (tool === 'cautery') stepCautery(S, p, dt, tune);\\n    else if (tool === 'suction') stepSuction(S, p, dt, tune);\\n    else if (tool === 'sonar') stepSonar(S, p, dt, tune);\\n    /* marks expire */\\n  }\\n\\n  /* ---------- strains ---------- */\\n\\n  function stepStrain(S, worldDt, handDt, tune) {\\n    const st = S.strain;\\n    if (!st || st.done) return;\\n    const sp = tune.strains.speed;\\n    if (st.kind === 'staccato') stepStaccato(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'legato') stepLegato(S, st, worldDt, handDt, tune, sp);\\n    else if (st.kind === 'tremolo') stepTremolo(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'dacapo') stepDacapo(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'fermata') stepFermata(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'cantor') stepCantor(S, st, worldDt, tune, sp);\\n  }\\n\\n  function stepStaccato(S, st, dt, tune, sp) {\\n    st.t += dt;\\n    const beat = tune.strains.beat;\\n    for (const b of st.beads) {\\n      if (b.dead) continue;\\n      b.landIn -= dt * sp;\\n      if (!b.hopped && b.landIn < 0.5) b.hopped = true;\\n      if (b.landIn <= 0 && !b.landed) {\\n        b.landed = true; b.x = b.tx; b.y = b.ty;\\n        addObj(S, { type: 'laceration', x: b.x, y: b.y, r: 8, order: 40, drain: 0.2, tag: 'bite' });\\n        pushEv(S, ['bite', Math.round(b.x), Math.round(b.y)]);\\n      }\\n      if (!b.landed) {\\n        const u = clamp(1 - b.landIn / b.flight, 0, 1);\\n        b.x = b.x0 + (b.tx - b.x0) * u;\\n        b.y = b.y0 + (b.ty - b.y0) * u;\\n      }\\n    }\\n    /* cautery kills beads: mirrored onto objects of type bead */\\n    let nests = 0;\\n    for (const o of S.objects) if (o.type === 'nest' && !o.done && o.tag === st.tag) nests++;\\n    if (!nests && !st.collapse) { st.collapse = 3; }\\n    if (st.collapse > 0) {\\n      st.collapse -= dt;\\n      if (st.collapse <= 0) {\\n        for (const b of st.beads) b.dead = true;\\n        for (const o of S.objects) if (o.type === 'bead' && o.tag === st.tag) { o.done = true; o.alive = false; }\\n        st.done = true;\\n      }\\n    }\\n    syncBeads(S, st);\\n    if (st.beads.length && st.beads.every(b => b.dead) && nests === 0) st.done = true;\\n  }\\n\\n  function syncBeads(S, st) {\\n    for (const b of st.beads) {\\n      if (b.dead) continue;\\n      let o = b.oid ? objById(S, b.oid) : null;\\n      if (!o) {\\n        o = addObj(S, { type: 'bead', x: b.x, y: b.y, need: 0.12, order: 5, tag: st.tag, drain: 0 });\\n        b.oid = o.id;\\n      } else {\\n        o.x = b.x; o.y = b.y;\\n        if (o.done) b.dead = true;\\n      }\\n    }\\n  }\\n\\n  function stepLegato(S, st, dt, handDt, tune, sp) {\\n    for (const w of st.worms) {\\n      if (w.done) continue;\\n      w.t += dt * sp;\\n      /* head crawls along its path until surfaced */\\n      if (!w.surfaced && !w.out) {\\n        w.along = Math.min(w.pathLen, w.along + 18 * dt * sp);\\n        const p = pointAlong(w.path, w.along);\\n        w.x = p[0]; w.y = p[1];\\n        /* open a slur guide when the head nears it */\\n        for (const g of w.slurs) {\\n          if (g.opened || g.done) continue;\\n          if (hypot(w.x - g.x, w.y - g.y) < 28) {\\n            g.opened = true;\\n            const o = addObj(S, { type: 'slur', x: g.x, y: g.y, len: 18, order: 1, tag: 'slur-' + w.id + '-' + g.i, drain: 0, guide: [[g.x - 9, g.y], [g.x + 9, g.y]] });\\n            g.oid = o.id;\\n          }\\n        }\\n      }\\n      for (const g of w.slurs) {\\n        if (!g.oid || g.done) continue;\\n        const o = objById(S, g.oid);\\n        if (o && o.done) g.done = true;\\n      }\\n      const slursLeft = w.slurs.filter(g => !g.done).length;\\n      if (!slursLeft && !w.surfaced) {\\n        w.surfaced = true; w.marked = true;\\n        const head = addObj(S, {\\n          type: 'shard', x: w.x, y: w.y, axis: w.axis || [1, 0], depth: 18, order: 2,\\n          tag: 'legato-head', worm: w.id, tension: 70, drain: 0.15, hidden: false,\\n          holdZone: w.hold || null, barbs: w.barbAt || 0,\\n        });\\n        w.head = head.id;\\n      }\\n      const head = w.head ? objById(S, w.head) : null;\\n      if (head && head.snapped && !w.snapped) {\\n        w.snapped = true; st.snapped = true;\\n        /* regrow a head further along and flee */\\n        head.done = true; head.alive = false;\\n        w.surfaced = false; w.out = false; w.head = 0;\\n        w.along = Math.min(w.pathLen - 4, w.along + 30);\\n        w.slurs.push({ i: 90 + w.slurs.length, x: w.x + 16, y: w.y, opened: false, done: false });\\n        pushEv(S, ['regrow', w.id]);\\n      }\\n      if (head && head.done && !w.out) {\\n        w.pulled = (w.pulled || 0) + 1;\\n        /* barb every 4th segment: if not clamped, snapping already handled via tension */\\n        if (w.barbAt && w.pulled % 4 === 0 && !head.clamped && !w.barbCleared) {\\n          /* require a clamp before the next length counts — head.done means the whole pull finished.\\n             Barbs are separate cautery objects spawned at the hold. */\\n        }\\n        w.segments -= 4;\\n        if (w.segments <= w.half && !w.split && st.worms.length < 3) {\\n          w.split = true; w.half = -1;\\n          st.worms.push(makeWorm(S, w.x + 20, w.y + 14, Math.max(4, w.segments >> 1), w.id + 1));\\n          pushEv(S, ['split', w.id]);\\n        }\\n        if (w.segments <= 0) { w.done = true; w.out = true; }\\n        else {\\n          /* next length */\\n          w.out = false; w.surfaced = true;\\n          const h2 = addObj(S, {\\n            type: 'shard', x: w.x, y: w.y, axis: [1, 0], depth: 14, order: 2,\\n            tag: 'legato-head', worm: w.id, tension: 70, drain: 0.1,\\n            holdZone: w.barbAt && (w.pulled % 4 === 0) ? [w.x + 30, w.y, 16] : null,\\n          });\\n          w.head = h2.id;\\n          if (w.barbAt && w.pulled % 4 === 0) {\\n            addObj(S, { type: 'barb', x: w.x + 30, y: w.y, need: 0.35, order: 3, tag: 'barb-' + w.id, drain: 0 });\\n          }\\n        }\\n      }\\n    }\\n    if (st.worms.every(w => w.done)) st.done = true;\\n  }\\n\\n  function makeWorm(S, x, y, segments, id) {\\n    const path = [];\\n    for (let i = 0; i < 8; i++) path.push([x + i * 14, y + Math.sin(i) * 8]);\\n    let pathLen = 0;\\n    for (let i = 1; i < path.length; i++) pathLen += hypot(path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1]);\\n    const slurs = [0.25, 0.5, 0.75].map((u, i) => {\\n      const p = pointAlong(path, pathLen * u);\\n      return { i, x: p[0], y: p[1], opened: false, done: false };\\n    });\\n    return { id, x, y, path, pathLen, along: 0, segments, half: segments / 2, slurs, surfaced: false, done: false, t: 0, split: false, pulled: 0, barbAt: 4, marked: false, axis: [1, 0] };\\n  }\\n  function pointAlong(path, dist) {\\n    let left = dist;\\n    for (let i = 1; i < path.length; i++) {\\n      const L = hypot(path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1]) || 1;\\n      if (left <= L) {\\n        const u = left / L;\\n        return [path[i - 1][0] + (path[i][0] - path[i - 1][0]) * u, path[i - 1][1] + (path[i][1] - path[i - 1][1]) * u];\\n      }\\n      left -= L;\\n    }\\n    return path[path.length - 1].slice();\\n  }\\n\\n  function stepTremolo(S, st, dt, tune) {\\n    st.t += dt;\\n    st.beat = (st.t % 0.8) / 0.8;\\n    const peak = st.beat > 0.85 || st.beat < 0.1;\\n    st.flare = peak;\\n    S.flags.onBeat = st.beat > 0.45 && st.beat < 0.7 ? false : st.beat < 0.15;\\n    /* vitals shake and drain */\\n    if (!S.breath) S.vitals -= 0.6 * st.amp * dt * tune.strains.damage;\\n    for (const o of S.objects) if (o.type === 'reed' && o.tag === 'reed') o.window = !!st.flare;\\n    const reeds = S.objects.filter(o => o.type === 'reed' && !o.done);\\n    if (st.stage === 1 && reeds.length === 0) { st.stage = 2; st.amp = Math.min(st.amp, 0.2); }\\n    if (st.amp <= 0.2 && st.stage === 1) st.stage = 2;\\n    if (st.stage === 2) {\\n      st.wake -= dt;\\n      if (st.wake <= 0) {\\n        st.wake = 6;\\n        /* a reed returns */\\n        if (S.objects.filter(o => o.type === 'reed' && !o.done).length < 2) {\\n          addObj(S, { type: 'reed', x: st.x - 20 + rnd(S) * 40, y: st.y - 10, order: 1, tag: 'reed', drain: 0, window: false });\\n        }\\n      }\\n      const mass = S.objects.find(o => o.type === 'tremass');\\n      if (mass && mass.done && st.stage === 2) {\\n        st.stage = 3;\\n        addObj(S, { type: 'shard', x: st.x, y: st.y, axis: [1, 0], depth: 40, order: 4, tag: 'tremolo-pull', tension: 90, drain: 0.2 });\\n      }\\n    }\\n    if (st.stage === 3) {\\n      const pull = S.objects.find(o => o.tag === 'tremolo-pull');\\n      if (pull && pull.done) st.done = true;\\n    }\\n    /* amp falls when a reed is dosed */\\n    const deadReeds = st.reed0 - S.objects.filter(o => o.type === 'reed' && !o.done).length;\\n    st.amp = clamp(1 - deadReeds * 0.2, 0.15, 1);\\n    if (st.stage >= 2) st.amp = Math.min(st.amp, 0.2);\\n  }\\n\\n  function stepDacapo(S, st, dt, tune, sp) {\\n    st.t += dt * sp * (st.round === 2 ? 2 : 1);\\n    let anyDead = false;\\n    for (const L of st.lobes) {\\n      if (L.dead) { anyDead = true; continue; }\\n      const period = L.period / (st.round === 2 ? 2 : 1);\\n      const openFor = L.openFor / (st.round === 2 ? 2 : 1);\\n      const u = st.t % period;\\n      L.open = u < openFor;\\n      const o = objById(S, L.oid);\\n      if (o) { o.open = L.open && !L.dead; o.x = L.x; o.y = L.y; if (o.done && !L.dead) { L.dead = true; anyDead = true; if (st.count < 0) st.count = 10; } }\\n    }\\n    if (st.count >= 0) {\\n      st.count -= dt;\\n      if (st.count <= 0 && st.lobes.some(L => L.dead) && st.lobes.some(L => !L.dead)) {\\n        /* from the top */\\n        for (const L of st.lobes) {\\n          L.dead = false;\\n          const o = objById(S, L.oid);\\n          if (o) { o.done = false; o.alive = true; o.prog = 0; o.burn = 0; o.dosed = false; o.open = false; if (o.cells) for (const c of o.cells) c[2] = 0; }\\n        }\\n        S.vitals -= 8;\\n        st.count = -1;\\n        st.repeated = (st.repeated || 0) + 1;\\n        if (st.round === 1) { st.round = 2; st.t = 0; spawnBeadsN(S, st, 4); }\\n        pushEv(S, ['dacapo', st.repeated]);\\n      } else if (st.count <= 0) st.count = -1;\\n    }\\n    if (st.lobes.every(L => L.dead) && st.count < 0) {\\n      if (st.round === 1) {\\n        st.round = 2; st.t = 0; st.count = -1;\\n        for (const L of st.lobes) {\\n          L.dead = false;\\n          const o = objById(S, L.oid);\\n          if (o) { o.done = false; o.alive = true; o.prog = 0; o.burn = 0; o.dosed = false; if (o.cells) for (const c of o.cells) c[2] = 0; }\\n        }\\n        spawnBeadsN(S, st, 4);\\n        pushEv(S, ['round2', 1]);\\n      } else if (S.objects.every(o => o.type !== 'bead' || o.done)) st.done = true;\\n    }\\n    if (st.round === 2 && st.lobes.every(L => L.dead) && S.objects.every(o => o.type !== 'bead' || o.done || o.tag !== 'dacapo-bead')) st.done = true;\\n  }\\n\\n  function spawnBeadsN(S, st, n) {\\n    st.beads = st.beads || [];\\n    for (let i = 0; i < n; i++) {\\n      const b = { x: 180 + i * 16, y: 100, tx: 190 + i * 14, ty: 130, x0: 180 + i * 16, y0: 100, landIn: 0.8, flight: 0.8, dead: false, landed: false, hopped: false };\\n      st.beads.push(b);\\n      const o = addObj(S, { type: 'bead', x: b.x, y: b.y, need: 0.12, order: 6, tag: 'dacapo-bead', drain: 0 });\\n      b.oid = o.id;\\n    }\\n    if (!st.kindBead) st.kindBead = true;\\n  }\\n\\n  function stepFermata(S, st, dt, tune) {\\n    st.t += dt;\\n    for (const d of st.domes) if (d.t > 0) d.t -= dt;\\n    st.domes = st.domes.filter(d => d.t > 0);\\n    if (st.stage === 1 && st.domes.length === 0 && !st.eyeOpen) {\\n      st.eyeOpen = S.breath ? 2.8 : 0.7;\\n      st.eye.open = true;\\n      const o = objById(S, st.eye.oid);\\n      if (o) o.open = true;\\n    }\\n    if (st.eyeOpen > 0) {\\n      st.eyeOpen -= dt;\\n      if (st.eyeOpen <= 0) {\\n        st.eye.open = false;\\n        const o = objById(S, st.eye.oid);\\n        if (o && !o.done) o.open = false;\\n        if (st.hits < 3 && st.stage === 1) {\\n          /* raise another dome */\\n          if (st.domes.length < 3) st.domes.push({ x: st.eye.x, y: st.eye.y, r: 34, t: 5 });\\n        }\\n      }\\n    }\\n    const eye = objById(S, st.eye.oid);\\n    if (eye && eye.done) { st.hits += 1; eye.done = false; eye.alive = true; eye.burn = 0; eye.prog = 0; eye.open = false; st.eye.open = false; }\\n    if (st.hits >= 3 && st.stage === 1) {\\n      st.stage = 2;\\n      st.eye.x = 250; st.eye.y = 90; st.eye.hidden = true;\\n      if (eye) { eye.x = 250; eye.y = 90; eye.hidden = true; eye.marked = false; eye.done = false; eye.alive = true; }\\n      addObj(S, { type: 'shard', x: 160, y: 140, axis: [1, 0], depth: 12, order: 3, tag: 'sliver-a', drain: 0.1, hidden: true });\\n      addObj(S, { type: 'shard', x: 180, y: 150, axis: [0.6, 0.8], depth: 12, order: 3, tag: 'sliver-b', drain: 0.1, hidden: true });\\n    }\\n    if (st.stage === 2 && eye && eye.marked) eye.hidden = false;\\n    if (st.stage === 2 && eye && eye.done && S.objects.every(o => o.tag !== 'sliver-a' && o.tag !== 'sliver-b' || o.done)) {\\n      /* eye.done was consumed as a hit; require the flee eye burned once more and slivers out */\\n    }\\n    if (st.stage === 2) {\\n      const slivers = S.objects.filter(o => o.tag === 'sliver-a' || o.tag === 'sliver-b');\\n      const eyeBurned = st.hits >= 4;\\n      if (eye && eye.done) st.hits = Math.max(st.hits, 4);\\n      if (eyeBurned && slivers.every(o => o.done)) {\\n        st.stage = 3;\\n        addObj(S, { type: 'note', x: st.eye.x, y: st.eye.y, axis: [0, -1], depth: 28, tension: 40, order: 5, tag: 'fermata-pull', drain: 0.15 });\\n      }\\n    }\\n    if (st.stage === 3) {\\n      const pull = S.objects.find(o => o.tag === 'fermata-pull');\\n      if (pull && pull.done) st.done = true;\\n    }\\n  }\\n\\n  function stepCantor(S, st, dt, tune) {\\n    st.t += dt;\\n    if (st.move === 1) {\\n      /* tendrils then uvulas, objects already spawned by the phase */\\n      const left = S.objects.filter(o => (o.tag === 'tendril' || o.tag === 'uvula') && !o.done);\\n      if (!left.length) { st.move = 2; st.t = 0; S.clock += 120; S.flags.hush = true; pushEv(S, ['movement', 2]); spawnVoice(S, st); }\\n    } else if (st.move === 2) {\\n      S.flags.hush = true;\\n      st.beat = (st.t % 0.9);\\n      for (const o of S.objects) if (o.type === 'voice') o.window = st.beat > 0.35 && st.beat < 0.7;\\n      if (st.domes && st.t > 2 && st.domes.length < 2 && Math.floor(st.t) % 5 === 0) {\\n        /* one dome refreshes */\\n      }\\n      st.jitter = true;\\n      const voices = S.objects.filter(o => o.type === 'voice' && !o.done);\\n      if (!voices.length) { st.move = 3; st.t = 0; S.clock += 120; S.flags.hush = false; st.signs = 0; pushEv(S, ['movement', 3]); }\\n    } else if (st.move === 3) {\\n      st.cycleT = (st.cycleT || 0) + dt;\\n      if (!st.winding && st.cycleT >= 20) { st.winding = 3; st.cycleT = 0; openRepeat(S, st); }\\n      if (st.winding > 0) {\\n        st.winding -= dt;\\n        if (st.winding <= 0) {\\n          const sign = S.objects.find(o => o.tag === 'repeat' && !o.done);\\n          if (sign) {\\n            forceRewind(S, true);\\n            st.rewound = (st.rewound || 0) + 1;\\n          } else st.signs = (st.signs || 0) + 1;\\n          st.winding = 0;\\n          closeRepeat(S);\\n        }\\n      }\\n      const sign = S.objects.find(o => o.tag === 'repeat' && o.done);\\n      if (sign) { st.signs = (st.signs || 0) + 1; sign.tag = 'repeat-spent'; }\\n      if ((st.signs || 0) >= 6) { st.move = 4; st.t = 0; S.clock += 120; pushEv(S, ['movement', 4]); spawnCoda(S, st); }\\n    } else if (st.move === 4) {\\n      st.beat = (st.t % 0.8) / 0.8;\\n      S.flags.onBeat = st.beat < 0.25;\\n      const spiral = S.objects.find(o => o.type === 'spiral' && o.tag === 'last-note');\\n      const note = S.objects.find(o => o.tag === 'the-note');\\n      const wound = S.objects.find(o => o.tag === 'final-wound');\\n      if (spiral && spiral.done && !st.noteOut) {\\n        st.noteOut = true;\\n        addObj(S, { type: 'note', x: 213, y: 116, axis: [0, -1], depth: 36, tension: 80, order: 2, tag: 'the-note', drain: 0 });\\n      }\\n      if (note && note.done && !wound) {\\n        addObj(S, { type: 'wound', x: 213, y: 130, stitches: 6, order: 3, tag: 'final-wound', drain: 0.3 });\\n      }\\n      if (wound && wound.done) st.done = true;\\n    }\\n  }\\n\\n  function openRepeat(S, st) {\\n    const existing = S.objects.find(o => o.tag === 'repeat');\\n    if (existing) { existing.done = false; existing.alive = true; existing.open = true; existing.prog = 0; return existing; }\\n    return addObj(S, { type: 'repeat', x: 213, y: 100, len: 36, order: 1, tag: 'repeat', open: true, drain: 0, guide: [[190, 100], [236, 100]] });\\n  }\\n  function closeRepeat(S) {\\n    for (const o of S.objects) if (o.tag === 'repeat' && !o.done) { o.open = false; }\\n  }\\n  function spawnVoice(S, st) {\\n    st.domes = [{ x: 180, y: 120, r: 34, t: 4 }, { x: 240, y: 110, r: 34, t: 5 }];\\n    for (let i = 0; i < 3; i++) addObj(S, { type: 'voice', x: 200 + i * 14, y: 116, hidden: true, order: 1, tag: 'voice', drain: 0.2, window: false });\\n    st.jitter = true; st.amp = 0.6;\\n  }\\n  function spawnCoda(S, st) {\\n    const guide = [];\\n    for (let i = 0; i <= 16; i++) {\\n      const a = i / 16 * Math.PI * 1.6;\\n      guide.push([213 + Math.cos(a) * (20 + i * 3), 116 + Math.sin(a) * (12 + i * 2)]);\\n    }\\n    addObj(S, { type: 'spiral', x: 213, y: 116, guide, order: 1, tag: 'last-note', beatLock: true, drain: 0, ring: false });\\n  }\\n\\n  function spawnStrain(S, kind, opts) {\\n    opts = opts || {};\\n    if (kind === 'staccato') {\\n      const st = { kind, tag: opts.tag || 'stacc', t: 0, beads: [], done: false, collapse: 0 };\\n      const n = opts.nests || 2;\\n      for (let i = 0; i < n; i++) {\\n        addObj(S, { type: 'nest', x: opts.x || (180 + i * 40), y: opts.y || 120, hidden: true, order: 2, tag: st.tag, slash: true, drain: 0.15, r: 8 });\\n      }\\n      const beads = opts.beads || 4;\\n      for (let i = 0; i < beads; i++) {\\n        st.beads.push({ x: 160 + i * 12, y: 90, x0: 160 + i * 12, y0: 90, tx: 170 + (i % 3) * 18, ty: 140, landIn: 0.6 + i * 0.15, flight: 0.7, dead: false, landed: false, hopped: false });\\n      }\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'legato') {\\n      const seg = opts.segments || 8;\\n      const w = makeWorm(S, opts.x || 150, opts.y || 120, seg, 1);\\n      w.marked = false;\\n      const st = { kind, worms: [w], done: false, snapped: false };\\n      /* head starts hidden: a sonar target */\\n      addObj(S, { type: 'hold', x: w.x, y: w.y, hidden: true, order: 0, tag: 'legato-hide', drain: 0 });\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'tremolo') {\\n      const st = { kind, t: 0, amp: 1, stage: 1, x: opts.x || 213, y: opts.y || 116, wake: 6, reed0: 5, done: false, jitter: true, beat: 0, flare: false };\\n      for (let i = 0; i < 5; i++) {\\n        const a = -Math.PI / 2 + i * TAU / 5;\\n        addObj(S, { type: 'reed', x: st.x + Math.cos(a) * 28, y: st.y + Math.sin(a) * 18, order: 1, tag: 'reed', drain: 0, window: false });\\n      }\\n      addObj(S, { type: 'tremass', x: st.x, y: st.y, need: 3, order: 3, tag: 'tremass', drain: 0.3 });\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'dacapo') {\\n      const lobes = [\\n        { id: 'A', mode: 'cautery', period: 6, openFor: 2.5, x: 180, y: 110 },\\n        { id: 'B', mode: 'slash', period: 7, openFor: 2.5, x: 213, y: 130 },\\n        { id: 'C', mode: 'syringe', period: 9, openFor: 3, x: 246, y: 112 },\\n      ];\\n      const st = { kind, t: 0, round: 1, count: -1, lobes, done: false, repeated: 0 };\\n      for (const L of lobes) {\\n        const spec = { type: 'lobe', x: L.x, y: L.y, mode: L.mode === 'slash' ? 'scalpel' : L.mode, order: 1, tag: 'lobe-' + L.id, open: false, drain: 0.15, need: L.mode === 'cautery' ? 1 : 0.5 };\\n        if (L.mode === 'slash') { spec.guide = [[L.x - 10, L.y], [L.x + 10, L.y]]; spec.mode = 'scalpel'; spec.slash = true; }\\n        if (L.mode === 'syringe') { spec.mode = 'syringe'; spec.follow = 'salve'; }\\n        const o = addObj(S, spec);\\n        L.oid = o.id; L.dead = false; L.open = false;\\n      }\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'fermata') {\\n      const st = { kind, t: 0, stage: 1, hits: 0, eyeOpen: 0, done: false, jitter: false, amp: 0,\\n        domes: [{ x: 200, y: 116, r: 34, t: 5 }],\\n        eye: { x: 200, y: 116, open: false, hidden: false } };\\n      const o = addObj(S, { type: 'eye', x: 200, y: 116, need: 0.3, order: 1, tag: 'eye', open: false, drain: 0.2 });\\n      st.eye.oid = o.id;\\n      addObj(S, { type: 'eloquent', x: 150, y: 100, guide: [[140, 90], [180, 110]], order: 0, drain: 0, tag: 'eloq' });\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'cantor') {\\n      const st = { kind, t: 0, move: 1, done: false, signs: 0, jitter: false, amp: 0.4, domes: [] };\\n      for (let i = 0; i < 3; i++) addObj(S, { type: 'tendril', x: 170 + i * 30, y: 100, len: 28, order: 1, tag: 'tendril', drain: 0.15, guide: [[160 + i * 30, 100], [190 + i * 30, 108]] });\\n      for (let i = 0; i < 3; i++) addObj(S, { type: 'uvula', x: 180 + i * 26, y: 140, need: 1.5, order: 2, tag: 'uvula', drain: 0.2 });\\n      S.strain = st;\\n      return st;\\n    }\\n    return null;\\n  }\\n\\n  /* ---------- phase / scripts ---------- */\\n\\n  function phaseClear(S) {\\n    if (S.strain && !S.strain.done) return false;\\n    for (const o of S.objects) {\\n      if (o.done || !o.alive) continue;\\n      if (o.type === 'nerve' || o.type === 'eloquent' || o.type === 'hold') continue;\\n      if (o.optional) continue;\\n      if (o.type === 'bead') continue;\\n      return false;\\n    }\\n    if (S.strain && S.strain.kind === 'staccato') {\\n      const live = (S.strain.beads || []).some(b => !b.dead);\\n      if (live && !S.strain.done) return false;\\n    }\\n    return true;\\n  }\\n\\n  function runScript(S, id, tune) {\\n    if (id === 'dip') { S.flags.dip = 40; }\\n    else if (id === 'crash') { S.flags.crash = 8; }\\n    else if (id === 'breath') { S.flags.needBreath = true; }\\n    else if (id === 'look') { S.flags.needLook = true; }\\n    else if (id === 'lurch') {\\n      slip(S, S.players[0], 'lurch', 3, tune);\\n      for (const o of S.objects) if (!o.done) { o.x += 10; o.y += 4; if (o.origin) { o.origin = [o.origin[0] + 10, o.origin[1] + 4]; } }\\n      S.flags.needLook = true;\\n      pushEv(S, ['lurch', 1]);\\n    } else if (id === 'blackout') { S.dim = 1; }\\n    else if (id === 'roll') { S.tiltAmp = 1; }\\n    else if (id === 'quiet') { S.flags.quiet = true; S.flags.needBreath = true; }\\n    else if (id === 'refill') { S.clock += 120; }\\n    else if (id === 'cantorRewind') { forceRewind(S, true); }\\n    else if (id === 'code') { S.vitals = 0; }\\n  }\\n\\n  function stepWorld(S, worldDt, handDt, tune) {\\n    if (S.flags.dip) {\\n      S.vitals += (S.flags.dip - S.vitals) * Math.min(1, worldDt * 2);\\n      if (Math.abs(S.vitals - S.flags.dip) < 0.4) { S.vitals = S.flags.dip; S.flags.dip = 0; }\\n    }\\n    if (S.flags.crash) {\\n      S.vitals -= S.flags.crash * worldDt;\\n    }\\n    if (S.tiltAmp) {\\n      const drift = Math.sin(S.worldT * 0.7) * 25 * S.tiltAmp;\\n      for (const o of S.objects) if (o.type === 'pool' && !o.done) {\\n        o.x = clamp(o.x + drift * worldDt, 60, 360);\\n      }\\n    }\\n    for (const o of S.objects) {\\n      if (o.markT > 0) { o.markT -= handDt; if (o.markT <= 0 && o.hidden) o.marked = false; }\\n      if (o.type === 'bleeder' && !o.done) {\\n        let pool = S.objects.find(p => p.type === 'pool' && p.tag === 'fed-' + o.id);\\n        if (!pool) pool = addObj(S, { type: 'pool', x: o.x, y: o.y + 8, vol: 4, max: 40, order: o.order + 1, tag: 'fed-' + o.id, drain: 0 });\\n        if (!pool.done) pool.vol = Math.min(pool.max, pool.vol + 6 * worldDt * tune.fluids.bleed);\\n      }\\n      if (o.type === 'arteryTear' && !o.done) {\\n        let pool = S.objects.find(p => p.type === 'pool' && p.tag === 'fed-' + o.id);\\n        if (!pool) pool = addObj(S, { type: 'pool', x: o.x, y: o.y + 6, vol: 6, max: 50, order: o.order + 1, tag: 'fed-' + o.id, drain: 0 });\\n        if (!pool.done) pool.vol = Math.min(pool.max, pool.vol + 14 * worldDt * tune.fluids.bleed);\\n      }\\n    }\\n    /* solo retractor: Quill holds at half the window */\\n    const retract = S.objects.find(o => o.type === 'retractor' && !o.done);\\n    if (retract) {\\n      const holder = S.players.some(p => p.held === retract.id && p.trig > 0.3);\\n      if (holder) S.windowOpen = 1;\\n      else if (S.players.filter(p => !p.gone).length <= 1) S.windowOpen = 0.5;\\n      else S.windowOpen = 0;\\n    }\\n    for (let i = 0; i < S.scripts.length; i++) {\\n      const sc = S.scripts[i];\\n      if (sc.done) continue;\\n      if (S.phaseT >= sc.t) { sc.done = true; runScript(S, sc.do, tune); }\\n    }\\n  }\\n\\n  function loadPhase(S, def, index) {\\n    const ph = def.phases[index];\\n    S.phase = index;\\n    S.phaseCount = def.phases.length;\\n    S.phaseName = ph.name;\\n    S.phaseT = 0;\\n    S.objects = S.objects.filter(o => o.persist);\\n    S.strain = null;\\n    S.scripts = (ph.at || []).map(a => ({ t: a.t, do: a.do, done: false }));\\n    S.tutorial = !!ph.tutorial;\\n    S.tutDone = !ph.tutorial;\\n    S.flags = Object.assign({}, S.flags, ph.flags || {});\\n    if (ph.dim != null) S.dim = ph.dim;\\n    if (ph.tilt) S.tiltAmp = ph.tilt;\\n    for (const spec of ph.objects || []) addObj(S, clone(spec));\\n    if (ph.strain) spawnStrain(S, ph.strain, ph.strainOpts || {});\\n    if (ph.onEnter) runScript(S, ph.onEnter, tuneOf(null));\\n    S.checkpoint = takeCore(S);\\n    /* drop the checkpoint's nested copy weight: checkpoint is the core itself */\\n    pushEv(S, ['phase', index, ph.name]);\\n  }\\n\\n  function advancePhase(S) {\\n    const def = (GAME.CASES || {})[S.id];\\n    if (!def) { finishCase(S); return; }\\n    if (S.phase + 1 >= def.phases.length) {\\n      if (!S.dressing && !S.won) {\\n        S.dressing = { t: 0, done: false };\\n        pushEv(S, ['dressing', 1]);\\n        return;\\n      }\\n      return;\\n    }\\n    loadPhase(S, def, S.phase + 1);\\n  }\\n\\n  function create(def, opts) {\\n    opts = opts || {};\\n    const diff = opts.difficulty || opts.diff || 'resident';\\n    const clockMul = diff === 'intern' ? 1.3 : diff === 'attending' ? 0.8 : 1;\\n    const S = blank({\\n      id: def.id, seed: opts.seed || def.seed || 1, players: opts.players || 1,\\n      difficulty: diff, clock: def.clock * clockMul, vitals: def.vitals, drain: def.drain,\\n      gift: def.doctor === 'sokolova' ? 'look' : def.doctor === 'both' ? 'both' : 'breath',\\n      doctor: def.doctor || 'vale', site: def.site, par: def.par || 1000,\\n      mode: def.mode || 'case', consult: !!def.consult,\\n    });\\n    S.clock0 = S.clock;\\n    if (def.doctor === 'both') S.consult = true;\\n    loadPhase(S, def, opts.phase || 0);\\n    return S;\\n  }\\n\\n  function createRaw(opts) {\\n    const S = blank(opts);\\n    for (const spec of opts.objects || []) addObj(S, clone(spec));\\n    if (opts.strain) spawnStrain(S, opts.strain, opts.strainOpts || {});\\n    if (opts.scripts) S.scripts = opts.scripts.map(a => ({ t: a.t, do: a.do, done: false }));\\n    S.checkpoint = takeCore(S);\\n    return S;\\n  }\\n\\n  function readInputs(S, inputs, dt) {\\n    inputs = inputs || [];\\n    for (let i = 0; i < S.players.length; i++) {\\n      const p = S.players[i];\\n      const inp = inputs[i] || {};\\n      const ox = p.x, oy = p.y;\\n      if (inp.x != null) { p.x = inp.x; p.y = inp.y; p.bx = inp.x; p.by = inp.y; }\\n      if (inp.tool) p.tool = inp.tool;\\n      p.inst = hypot(p.x - ox, p.y - oy) / Math.max(dt, 1e-4);\\n      p.fine = !!inp.fine;\\n      p.mouse = !!inp.mouse;\\n      const trig = inp.trig || 0;\\n      p.trigEdge = trig > 0.3 && p.prevTrig <= 0.3;\\n      p.trigRelease = trig <= 0.3 && p.prevTrig > 0.3;\\n      p.prevTrig = trig;\\n      p.trig = trig;\\n      const gift = !!inp.gift;\\n      p.giftEdge = gift && !p.giftPrev;\\n      p.giftPrev = gift;\\n      const consult = !!inp.consult;\\n      p.consultEdge = consult && !p.consultPrev;\\n      p.consultPrev = consult;\\n      p.cancelEdge = !!inp.cancel;\\n      if (p.cancelEdge) { p.held = 0; p.stroke = null; }\\n    }\\n  }\\n\\n  function tryGifts(S, tune) {\\n    for (const p of S.players) {\\n      if (!p.giftEdge) continue;\\n      if (S.breath) { S.breath = false; S.worldScale = 1; pushEv(S, ['breath', 0]); continue; }\\n      const doc = S.activeDoc;\\n      const wantLook = doc === 'sokolova' || (S.gift === 'look' && doc !== 'vale');\\n      const wantBreath = doc === 'vale' || S.gift === 'breath' || (S.gift === 'both' && doc === 'vale');\\n      if (S.gift === 'both') {\\n        if (doc === 'sokolova') { if (secondLook(S, tune)) return; }\\n        else if (S.steady >= 35) { S.breath = true; pushEv(S, ['breath', 1]); return; }\\n      } else if (S.gift === 'look' || wantLook && S.gift !== 'breath') {\\n        secondLook(S, tune);\\n      } else if (wantBreath && S.steady >= 35) {\\n        S.breath = true;\\n        pushEv(S, ['breath', 1]);\\n      }\\n    }\\n    for (const p of S.players) {\\n      if (!p.consultEdge || !S.consult) continue;\\n      S.activeDoc = S.activeDoc === 'vale' ? 'sokolova' : 'vale';\\n      pushEv(S, ['consult', S.activeDoc]);\\n    }\\n  }\\n\\n  function stepCodeBlue(S, dt) {\\n    const cb = S.codeBlue;\\n    if (!cb) return;\\n    cb.t += dt;\\n    const peaks = [0.9, 1.8, 2.7, 3.6];\\n    const p = S.players[0];\\n    if (cb.next == null) cb.next = 0;\\n    if (cb.next < 4) {\\n      const peak = peaks[cb.next];\\n      if (p && p.trigEdge) {\\n        const err = Math.abs(cb.t - peak);\\n        cb.attempts += 1;\\n        if (err <= 0.14) {\\n          cb.hits += 1;\\n          if (err <= 0.06) cb.textbook = (cb.textbook || 0) + 1;\\n          pushEv(S, ['shock', cb.hits, err]);\\n        } else pushEv(S, ['miss', err]);\\n        cb.next += 1;\\n      } else if (cb.t > peak + 0.14) {\\n        cb.attempts += 1;\\n        cb.next += 1;\\n        pushEv(S, ['miss', 1]);\\n      }\\n    }\\n    if (cb.next >= 4 && !cb.resolved) {\\n      cb.resolved = true;\\n      S.codeBlue = null;\\n      if (cb.hits >= 2) {\\n        S.vitals = 30;\\n        S.flags.crash = 0;\\n        pushEv(S, ['revived', cb.textbook >= 2 ? 'textbook' : 'clean']);\\n      } else lose(S, 'code');\\n    }\\n  }\\n\\n  function maybeDie(S) {\\n    if (S.won || S.lost || S.codeBlue || S.dressing) return;\\n    if (S.clock <= 0) { lose(S, 'time'); return; }\\n    if (S.vitals <= 0) {\\n      if (S.diff === 'attending' || S.codeBlueUsed) { lose(S, 'vitals'); return; }\\n      S.codeBlueUsed = true;\\n      S.codeBlue = { t: 0, hits: 0, attempts: 0, next: 0, textbook: 0, resolved: false };\\n      S.vitals = 0;\\n      S.breath = false;\\n      pushEv(S, ['codeblue', 1]);\\n    }\\n  }\\n\\n  function stepDressing(S, dt, tune) {\\n    const d = S.dressing;\\n    d.t += dt;\\n    const u = (d.t % 1.2) / 1.2;\\n    const edge = Math.min(u, 1 - u);\\n    const p = S.players[0];\\n    if (p && p.trigEdge) {\\n      const bonus = edge < 0.08 ? 80 : 20;\\n      S.score += bonus;\\n      d.done = true;\\n      pushEv(S, ['stamp', bonus]);\\n      finishCase(S);\\n    } else if (d.t > 4) {\\n      d.done = true;\\n      finishCase(S);\\n    }\\n  }\\n\\n  function step(S, inputs, dt, tune) {\\n    tune = tuneOf(tune);\\n    if (!dt || dt < 0) dt = 0;\\n    S.ev = [];\\n    if (S.won || S.lost) return S;\\n    readInputs(S, inputs, dt);\\n    if (S.codeBlue) { stepCodeBlue(S, dt); return S; }\\n    tryGifts(S, tune);\\n    if (S.breath) {\\n      S.steady = Math.max(0, S.steady - tune.gift.breathDrain * dt);\\n      if (S.steady <= 0) { S.breath = false; pushEv(S, ['breath', 0]); }\\n    }\\n    S.worldScale = S.breath ? tune.gift.breathFactor : 1;\\n    const worldDt = dt * S.worldScale;\\n    if (S.dressing) { stepDressing(S, dt, tune); return S; }\\n\\n    const frozen = S.tutorial && !S.tutDone;\\n    if (!frozen) {\\n      let hazard = 0;\\n      for (const o of S.objects) {\\n        if (o.done || !o.drain) continue;\\n        if (inDome(S, o.x, o.y)) continue;\\n        hazard += o.drain;\\n      }\\n      const bleed = hazard * tune.fluids.bleed * tune.strains.damage;\\n      S.vitals -= (S.drain * tune.patient.drain * diffDrain(S) + bleed) * worldDt;\\n      S.clock -= worldDt * tune.patient.clock / diffClock(S);\\n      S.steady = Math.min(100, S.steady + 0.5 * tune.gift.charge * worldDt);\\n    }\\n    S.t += dt;\\n    S.worldT += frozen ? 0 : worldDt;\\n    S.phaseT += frozen ? 0 : worldDt;\\n\\n    for (const p of S.players) applyTools(S, p, dt, tune);\\n    if (!frozen) {\\n      stepWorld(S, worldDt, dt, tune);\\n      stepStrain(S, worldDt, dt, tune);\\n    }\\n    if (S.ghostT > 0) S.ghostT -= dt;\\n\\n    if (!frozen) {\\n      S.ringAcc += worldDt;\\n      while (S.ringAcc >= 0.1) { S.ringAcc -= 0.1; pushRing(S); }\\n    }\\n\\n    maybeDie(S);\\n    if (!S.lost && !S.won && !S.codeBlue && phaseClear(S)) advancePhase(S);\\n    return S;\\n  }\\n\\n  /* ---------- cursor and wheel ---------- */\\n\\n  function assistOf(S, tune) {\\n    let a = tune.hands.assist;\\n    if (S && S.diff === 'intern') a += 0.2;\\n    if (S && (S.activeDoc === 'sokolova')) a += 0.2;\\n    return clamp(a, 0, 1.4);\\n  }\\n\\n  function jitterOf(S, p) {\\n    const st = S && S.strain;\\n    if (!st || !st.jitter || (S && S.breath)) return [0, 0];\\n    const amp = 5 * (st.amp == null ? 1 : st.amp) * (p.fine ? 0.35 : 1);\\n    return [Math.sin((S.worldT || 0) * 17.3 + p.id) * amp, Math.cos((S.worldT || 0) * 13.1 + p.id * 2) * amp];\\n  }\\n\\n  function validTarget(S, p, tune) {\\n    const rad = tune.hands.magnet;\\n    return nearest(S, p, rad, o => {\\n      if (!canTouch(S, o)) return false;\\n      if (o.type === 'pool') return p.tool === 'suction';\\n      if (o.type === 'nerve' || o.type === 'eloquent' || o.type === 'hold') return false;\\n      if (p.tool === 'sonar') return !!o.hidden;\\n      if (p.tool === 'salve') return !!o.cells;\\n      if (p.tool === 'syringe') return o.type === 'clot' || o.type === 'reed' || o.type === 'voice' || o.type === 'lobe';\\n      if (p.tool === 'cautery') return o.type === 'polyp' || o.type === 'bleeder' || o.type === 'bead' || o.type === 'uvula' || o.type === 'eye' || o.type === 'rupture' || o.type === 'tremass' || o.type === 'barb' || o.type === 'lobe';\\n      if (p.tool === 'forceps') return o.type === 'shard' || o.type === 'fragment' || o.type === 'mass' || o.type === 'hook' || o.type === 'gaff' || o.type === 'cork' || o.type === 'note' || o.type === 'retractor' || o.type === 'screw' || o.type === 'nest';\\n      if (p.tool === 'scalpel') return !!o.guide;\\n      if (p.tool === 'suture') return !!o.pairs;\\n      return false;\\n    });\\n  }\\n\\n  function updateCursor(p, dev, S, dt, tune) {\\n    tune = tuneOf(tune);\\n    dev = dev || {};\\n    if (dev.mouse) {\\n      p.bx = dev.mouse[0]; p.by = dev.mouse[1];\\n      p.x = p.bx; p.y = p.by;\\n      p.fine = !!dev.fine;\\n      return p;\\n    }\\n    const aim = dev.aim || [0, 0];\\n    let mag = hypot(aim[0], aim[1]);\\n    let dirx = mag > 1e-6 ? aim[0] / mag : 0;\\n    let diry = mag > 1e-6 ? aim[1] / mag : 0;\\n    mag = Math.min(1, mag);\\n    const curved = Math.pow(mag, tune.hands.curve);\\n    let speed = curved * tune.hands.cursor;\\n    if (dev.fine) speed *= tune.hands.fine;\\n    if (S && (S.activeDoc === 'vale')) speed *= 1.15;\\n    /* 0.06s ramp */\\n    const k = 1 - Math.exp(-dt / 0.06);\\n    p.speed += (speed - (p.speed || 0)) * (dt > 0 ? k : 1);\\n    let vx = dirx * p.speed;\\n    let vy = diry * p.speed;\\n    const keys = dev.keys || [0, 0];\\n    const keySp = 200 * (dev.fine ? tune.hands.fine : 1);\\n    vx += keys[0] * keySp; vy += keys[1] * keySp;\\n    const nudge = dev.nudge || [0, 0];\\n    vx += nudge[0] * 40; vy += nudge[1] * 40;\\n\\n    const assist = S ? assistOf(S, tune) : tune.hands.assist;\\n    const tgt = S ? validTarget(S, p, tune) : null;\\n    if (tgt && mag < 0.95) {\\n      vx *= 1 - 0.55 * Math.min(1, assist);\\n      vy *= 1 - 0.55 * Math.min(1, assist);\\n      if (mag < 0.12) {\\n        const dx = tgt.x - p.bx, dy = tgt.y - p.by;\\n        const d = hypot(dx, dy) || 1;\\n        const pull = 90 * assist;\\n        vx += (dx / d) * pull; vy += (dy / d) * pull;\\n      }\\n    }\\n    if (S && p.stroke && (p.stroke.kind === 'scalpel' || p.stroke.kind === 'suture')) {\\n      const o = objById(S, p.stroke.id);\\n      let tanv = [1, 0];\\n      if (o && o.guide) tanv = polyDist(o.guide, p.bx, p.by).tan;\\n      else if (p.stroke.kind === 'suture' && o && o.pairs) {\\n        const pair = o.pairs[o.stitch] || o.pairs[0];\\n        const dx = pair[1][0] - pair[0][0], dy = pair[1][1] - pair[0][1];\\n        const L = hypot(dx, dy) || 1;\\n        tanv = [dx / L, dy / L];\\n      }\\n      const along = vx * tanv[0] + vy * tanv[1];\\n      const cx = vx - along * tanv[0], cy = vy - along * tanv[1];\\n      const scale = 1 - 0.8 * Math.min(1, assist);\\n      vx = along * tanv[0] + cx * scale;\\n      vy = along * tanv[1] + cy * scale;\\n    }\\n    p.bx = clamp(p.bx + vx * dt, 8, CFG.FIELD_W - 8);\\n    p.by = clamp(p.by + vy * dt, 8, CFG.FIELD_H - 8);\\n    const j = S ? jitterOf(S, p) : [0, 0];\\n    p.x = p.bx + j[0];\\n    p.y = p.by + j[1];\\n    p.fine = !!dev.fine;\\n    return p;\\n  }\\n\\n  function wheelIndex(x, y) {\\n    const ang = Math.atan2(y, x); /* 0 east, clockwise because y grows downward */\\n    let d = ang - (-Math.PI / 2);\\n    if (d < 0) d += TAU;\\n    if (d >= TAU) d -= TAU;\\n    return Math.round(d / (Math.PI / 4)) % 8;\\n  }\\n\\n  function updateWheel(p, dev, dt) {\\n    dev = dev || {};\\n    if (dev.digit) {\\n      const i = (dev.digit - 1) % 8;\\n      if (p.tool !== CFG.TOOLS[i]) { p.tool = CFG.TOOLS[i]; p.swap = 0.12; }\\n      return p.tool;\\n    }\\n    const m = dev.move || [0, 0];\\n    const mag = hypot(m[0], m[1]);\\n    if (mag < 0.6) { p.wheelT = 0; p.wheelDir = -1; return p.tool; }\\n    const dir = wheelIndex(m[0], m[1]);\\n    if (dir !== p.wheelDir) { p.wheelDir = dir; p.wheelT = 0; }\\n    p.wheelT += dt;\\n    if (p.wheelT >= 0.08 && p.tool !== CFG.TOOLS[dir]) {\\n      p.tool = CFG.TOOLS[dir];\\n      p.swap = 0.12;\\n      p.wheelT = 0;\\n    }\\n    return p.tool;\\n  }\\n\\n  function retryPhase(S) {\\n    if (!S.checkpoint) return false;\\n    restoreCore(S, S.checkpoint, false);\\n    S.rankCap = 'B';\\n    S.lost = false;\\n    S.won = false;\\n    S.codeBlue = null;\\n    S.reason = '';\\n    for (const p of S.players) { p.held = 0; p.stroke = null; }\\n    pushEv(S, ['retry', S.phase]);\\n    return true;\\n  }\\n\\n  GAME.Sim = {\\n    rnd, clamp, clone, addObj, makePlayer, blank, create, createRaw, step,\\n    takeCore, applyCore, hashCore, rankLetter, secondLook, forceRewind, retryPhase,\\n    updateCursor, updateWheel, wheelIndex, spawnStrain, phaseClear, objById,\\n    polyDist, lose, DRAIN,\\n  };\\n  GAME.Op = { create, createRaw, step, takeCore, hash: S => hashCore(takeCore(S)), rankLetter, secondLook, forceRewind, retryPhase, spawnStrain };\\n  GAME.Cursor = { update: updateCursor, jitterOf, assistOf };\\n  GAME.Wheel = { update: updateWheel, index: wheelIndex, TOOLS: CFG.TOOLS };\\n})();\\n\",\"new_line\":1,\"context_before\":\"\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"a2a28342-5404-4f23-967b-7b13e8c34aaf"}
