/45);\\n};\\nconst press = (a) => { game.input.tap(a); game.advance(game.o.step); game.advance(game.o.step); };\\npress('confirm'); // title -> menu\\npress('confirm'); // new game -> difficulty\\npress('down');\\npress('confirm'); // resident -> story\\nconst t0 = Date.now();\\nlet guard = 0;\\nlet last = '';\\nconst seen = [];\\nwhile (guard++ < 8000 && Date.now()-t0 < 60000) {\\n  const s = game.debug.snapshot();\\n  const key = s.scene + ':' + (s.story||'') + ':' + (s.op && s.op.id) + ':' + (s.op && s.op.phase);\\n  if (key !== last) { seen.push(key + (s.choice?'?':'') + (s.op?(s.op.won?'W':s.op.lost?'L':''):'')); last = key; if (seen.length > 80) seen.shift(); }\\n  if (s.scene === 'title' && seen.length > 5) break;\\n  if (s.scene === 'story') {\\n    if (s.choice) press('confirm');\\n    else game.advance(0.25);\\n  } else if (s.scene === 'chart') {\\n    const [x,y] = s.lightbox;\\n    game.input.feed('move', x, y);\\n    game.input.feed('down', x, y);\\n    game.input.feed('up', x, y);\\n    game.advance(game.o.step);\\n    game.advance(game.o.step);\\n  } else if (s.scene === 'op') {\\n    game.advance(0.4);\\n  } else if (s.scene === 'results' || s.scene === 'ward' || s.scene === 'credits') {\\n    press('confirm');\\n  } else if (s.scene === 'menu' || s.scene === 'difficulty') {\\n    press('confirm');\\n  } else game.advance(0.1);\\n}\\nconsole.log('done', game.sceneName, 'guard', guard, 'ms', Date.now()-t0);\\nconsole.log(seen.join('\\\\n'));\\nconsole.log('errs', game.errors.slice(0,3).map(e => e.message));\\nconsole.log('ranks', JSON.stringify(game.debug.snapshot().ranks));\\nEOF\",\"truncated\":false,\"signal\":null,\"timed_out\":false,\"description\":\"Smoke a chained New Game through the story\",\"current_dir\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work\",\"output_file\":\"/home/micha/.grok/sessions/%2Fhome%2Fmicha%2Fdev%2Fcc-matrix%2Fruns%2Fgrok-xhigh.build-v2__20261104-223916__x488eb9%2Fwork/01a1aa37-f7cf