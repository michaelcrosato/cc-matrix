, Math.max(0, oy), '#102830');\\n      px.rect(g, 0, oy + CFG.FIELD_H, r.W, Math.max(0, r.H - oy - CFG.FIELD_H), '#102830');\\n      px.rect(g, 0, oy, Math.max(0, ox), CFG.FIELD_H, '#102830');\\n      px.rect(g, ox + CFG.FIELD_W, oy, Math.max(0, r.W - ox - CFG.FIELD_W), CFG.FIELD_H, '#102830');\\n      px.rect(g, ox + 8, oy + 8, CFG.FIELD_W - 16, CFG.FIELD_H - 16, '#0c2428');\\n      if (!S) return;\\n      const ink = bloodCol();\\n      for (const o of S.objects) {\\n        if (!o.alive && o.type !== 'retractor') continue;\\n        if (o.hidden && !o.marked) continue;\\n        const x = o.x + ox, y = o.y + oy;\\n        let c = COL[o.type] || '#9ad0c8';\\n        if (ink && (o.type === 'bleeder' || o.type === 'pool' || o.type === 'wound' || o.type === 'laceration' || o.type === 'arteryTear')) c = ink;\\n        const rad = o.type === 'pool' ? 8 + (o.vol || 0) * 0.15 : o.type === 'mass' ? (o.rad || 12) : o.type === 'bead' ? 3 : 4;\\n        if (o.guide && o.guide.length > 1 && (o.type === 'cut' || o.type === 'mass' || o.type === 'slur')) {\\n          for (let k = 1; k < o.guide.length; k++) px.line(g, o.guide[k - 1][0] + ox, o.guide[k - 1][1] + oy, o.guide[k][0] + ox, o.guide[k][1] + oy, '#f2f0e6', 1);\\n        }\\n        px.disc(g, x, y, rad, o.done ? '#2a403c' : c);\\n        if (o.marked) px.disc(g, x, y, rad + 3, '#5ff0e0');\\n      }\\n      if (S.ghostT > 0 && S.ghosts && S.ghosts.length) {\\n        for (let gi = 0; gi < S.ghosts.length; gi++) {\\n          const gh = S.ghosts[gi];\\n          const marks = (gh.cursors || []).concat(gh.strains || []);\\n          for (let mi = 0; mi < marks.length; mi++) {\\n            const xy = marks[mi];\\n            if (!xy) continue;\\n            px.disc(g, xy[0] + ox, xy[1] + oy, 3, '#67d6ff');\\n          }\\n        }\\n      }\\n      if (S.breath) {\\n        px.rect(g, ox + 20, oy + 16, CFG.FIELD_W - 40, 2, '#bfefff');\\n        px.rect(g, ox + 20, oy + CFG.FIELD_H - 18, CFG.FIELD_W - 40, 2, '#bfefff');\\n      }\\n      if (RT.wheelShow > 0 && S.players[0] && !S.players[0].gone) {\\n        const c = S.players[0];\\n        for (const w of CFG.WHEEL) {\\n          const x = c.x + ox + w.x * 22, y = c.y + oy + w.y * 22;\\n          const on = c.tool === w.tool;\\n          px.disc(g, x, y, on ? 8 : 5, on ? '#5ff0e0' : '#14343c');\\n          GAME.Art.toolIcon(g, w.tool, x - 4, y - 4, 1);\\n        }\\n      }\\n      for (const p of S.players) if (!p.gone) GAME.Art.drawHand(g, p, ox, oy);\\n      const vit = Math.max(0, Math.ceil(S.vitals));\\n      const clk = Math.max(0, Math.ceil(S.clock));\\n      E.font.text(g, 'VIT ' + vit, 8, 6, vit < 30 ? '#ff7a6a' : '#e8fbf6', { scale: 2, outline: '#06141a' });\\n      E.font.text(g, 'CLK ' + clk, 8, 26, clk < 20 ? '#ff7a6a' : '#e8fbf6', { scale: 2, outline: '#06141a' });\\n      E.font.text(g, (S.phaseName || '') + '  ' + (S.activeDoc || ''), 8, 48, '#8fb8b0', { outline: '#06141a' });\\n\",\"total_lines\":1430}}","is_error":false},{"type":"tool_result","tool_use_id":"call-9b194cf3-c516-4e68-87fd-7ef6158af51b-76","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"510→    if (RT.devTab === 0) {\\n      const keys = GAME.Dev.KEYS;\\n      if (RT.devI >= keys.length) { if (dir === 0) GAME.Dev.reset(); return; }\\n      if (!dir) return;\\n      const [path, lo, hi] = keys[RT.devI];\\n      const [g, k] = path.split('.');\\n      const step = (hi - lo) / 20;\\n      const cur = GAME.TUNE[g][k];\\n      const v = Math.max(lo, Math.min(hi, Math.round((cur + dir * step) * 1000) / 1000));\\n      GAME.Dev.set(path, v);\\n520→      return;\\n    }\\n    RT.cheatUsed = true;\\n    if (dir !== 0 && RT.devTab !== 1) return;\\n    if (RT.devTab === 1 && dir === 0) {\\n      const key = CHEATS[RT.devI][0];\\n      if (key === 'auto') { RT.auto = !RT.auto; RT.cheatUsed = true; return; }\\n      if (key === 'slow') {\\n        const i = SLOW.indexOf(game.timeScale);\\n        game.timeScale = SLOW[(i + 1) % SLOW.length] || 1;\\n530→        RT.cheatUsed = true;\\n        return;\\n      }\\n      if (key === 'win' && S) {\\n        RT.cheatUsed = true;\\n        for (const o of S.objects) { o.done = true; o.prog = 1; }\\n        if (S.strain) {\\n          S.strain.done = true;\\n          if (S.strain.beads) for (const b of S.strain.beads) b.dead = true;\\n          if (S.strain.worms) for (const w of S.strain.worms) w.done = true;\\n540→          if (S.strain.lobes) for (const L of S.strain.lobes) L.dead = true;\\n        }\\n        if (S.flags && S.flags.needIv) S.flags.iv = S.flags.needIv;\\n        S.hold = false;\\n        return;\\n      }\\n      if (key === 'lose' && S) { RT.cheatUsed = true; GAME.Sim.lose(S, 'dev'); return; }\\n      if (key === 'code' && S) { RT.cheatUsed = true; S.vitals = 0; return; }\\n      if (S) {\\n        S.cheat = S.cheat || {};\\n550→        const on = !S.cheat[key];\\n        GAME.Dev.cheat(S, key, on);\\n        RT.cheatUsed = true;\\n      }\\n      return;\\n    }\\n    if (RT.devTab === 2 && dir === 0) {\\n      const rows = devRows();\\n      const label = rows[RT.devI] || '';\\n      RT.cheatUsed = true;\",\"content_concise\":\"510→    if (RT.devTab === 0) {\\n      const keys = GAME.Dev.KEYS;\\n      if (RT.devI >= keys.length) { if (dir === 0) GAME.Dev.reset(); return; }\\n      if (!dir) return;\\n      const [path, lo, hi] = keys[RT.devI];\\n      const [g, k] = path.split('.');\\n      const step = (hi - lo) / 20;\\n      const cur = GAME.TUNE[g][k];\\n      const v = Math.max(lo, Math.min(hi, Math.round((cur + dir * step) * 1000) / 1000));\\n      GAME.Dev.set(path, v);\\n520→      return;\\n    }\\n    RT.cheatUsed = true;\\n    if (dir !== 0 && RT.devTab !== 1) return;\\n    if (RT.devTab === 1 && dir === 0) {\\n      const key = CHEATS[RT.devI][0];\\n      if (key === 'auto') { RT.auto = !RT.auto; RT.cheatUsed = true; return; }\\n      if (key === 'slow') {\\n        const i = SLOW.indexOf(game.timeScale);\\n        game.timeScale = SLOW[(i + 1) % SLOW.length] || 1;\\n530→        RT.cheatUsed = true;\\n        return;\\n      }\\n      if (key === 'win' && S) {\\n        RT.cheatUsed = true;\\n        for (const o of S.objects) { o.done = true; o.prog = 1; }\\n        if (S.strain) {\\n          S.strain.done = true;\\n          if (S.strain.beads) for (const b of S.strain.beads) b.dead = true;\\n          if (S.strain.worms) for (const w of S.strain.worms) w.done = true;\\n540→          if (S.strain.lobes) for (const L of S.strain.lobes) L.dead = true;\\n        }\\n        if (S.flags && S.flags.needIv) S.flags.iv = S.flags.needIv;\\n        S.hold = false;\\n        return;\\n      }\\n      if (key === 'lose' && S) { RT.cheatUsed = true; GAME.Sim.lose(S, 'dev'); return; }\\n      if (key === 'code' && S) { RT.cheatUsed = true; S.vitals = 0; return; }\\n      if (S) {\\n        S.cheat = S.cheat || {};\\n550→        const on = !S.cheat[key];\\n        GAME.Dev.cheat(S, key, on);\\n        RT.cheatUsed = true;\\n      }\\n      return;\\n    }\\n    if (RT.devTab === 2 && dir === 0) {\\n      const rows = devRows();\\n      const label = rows[RT.devI] || '';\\n      RT.cheatUsed = true;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/scenes/shell.js\",\"offset\":510,\"limit\":50,\"raw_output\":\"    if (RT.devTab === 0) {\\n      const keys = GAME.Dev.KEYS;\\n      if (RT.devI >= keys.length) { if (dir === 0) GAME.Dev.reset(); return; }\\n      if (!dir) return;\\n      const [path, lo, hi] = keys[RT.devI];\\n      const [g, k] = path.split('.');\\n      const step = (hi - lo) / 20;\\n      const cur = GAME.TUNE[g][k];\\n      const v = Math.max(lo, Math.min(hi, Math.round((cur + dir * step) * 1000) / 1000));\\n      GAME.Dev.set(path, v);\\n      return;\\n    }\\n    RT.cheatUsed = true;\\n    if (dir !== 0 && RT.devTab !== 1) return;\\n    if (RT.devTab === 1 && dir === 0) {\\n      const key = CHEATS[RT.devI][0];\\n      if (key === 'auto') { RT.auto = !RT.auto; RT.cheatUsed = true; return; }\\n      if (key === 'slow') {\\n        const i = SLOW.indexOf(game.timeScale);\\n        game.timeScale = SLOW[(i + 1) % SLOW.length] || 1;\\n        RT.cheatUsed = true;\\n        return;\\n      }\\n      if (key === 'win' && S) {\\n        RT.cheatUsed = true;\\n        for (const o of S.objects) { o.done = true; o.prog = 1; }\\n        if (S.strain) {\\n          S.strain.done = true;\\n          if (S.strain.beads) for (const b of S.strain.beads) b.dead = true;\\n          if (S.strain.worms) for (const w of S.strain.worms) w.done = true;\\n          if (S.strain.lobes) for (const L of S.strain.lobes) L.dead = true;\\n        }\\n        if (S.flags && S.flags.needIv) S.flags.iv = S.flags.needIv;\\n        S.hold = false;\\n        return;\\n      }\\n      if (key === 'lose' && S) { RT.cheatUsed = true; GAME.Sim.lose(S, 'dev'); return; }\\n      if (key === 'code' && S) { RT.cheatUsed = true; S.vitals = 0; return; }\\n      if (S) {\\n        S.cheat = S.cheat || {};\\n        const on = !S.cheat[key];\\n        GAME.Dev.cheat(S, key, on);\\n        RT.cheatUsed = true;\\n      }\\n      return;\\n    }\\n    if (RT.devTab === 2 && dir === 0) {\\n      const rows = devRows();\\n      const label = rows[RT.devI] || '';\\n      RT.cheatUsed = true;\\n\",\"total_lines\":1430}}","is_error":false},{"type":"tool_result","tool_use_id":"call-9b194cf3-c516-4e68-87fd-7ef6158af51b-77","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"820→    else if (tool === 'suture') stepSuture(S, p, dt, tune);\\n    else if (tool === 'salve') stepSalve(S, p, dt, tune);\\n    else if (tool === 'syringe') stepSyringe(S, p, dt, tune);\\n    else if (tool === 'cautery') stepCautery(S, p, dt, tune);\\n    else if (tool === 'suction') stepSuction(S, p, dt, tune);\\n    else if (tool === 'sonar') stepSonar(S, p, dt, tune);\\n    /* marks expire */\\n  }\\n\\n  /* ---------- strains ---------- */\\n830→\\n  /* Documented defaults are beat 0.5 and spawn 1. Both scales are 1 there, so a case clock does not move. */\\n  function strainBeat(tune) {\\n    const b = tune && tune.strains ? tune.strains.beat : 0.5;\\n    return b > 0 ? b : 0.5;\\n  }\\n  function strainSpawn(tune) {\\n    const s = tune && tune.strains ? tune.strains.spawn : 1;\\n    return s > 0 ? s : 1;\\n  }\\n840→\\n  function stepStrain(S, worldDt, handDt, tune) {\\n    const st = S.strain;\\n    if (!st || st.done) return;\\n    const sp = tune.strains.speed;\\n    if (st.kind === 'staccato') stepStaccato(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'legato') stepLegato(S, st, worldDt, handDt, tune, sp);\\n    else if (st.kind === 'tremolo') stepTremolo(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'dacapo') stepDacapo(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'fermata') stepFermata(S, st, worldDt, tune, sp);\\n850→    else if (st.kind === 'cantor') stepCantor(S, st, worldDt, tune, sp);\\n  }\\n\\n  function stepStaccato(S, st, dt, tune, sp) {\\n    st.t += dt;\\n    const tempo = strainBeat(tune) / 0.5;\\n    for (const b of st.beads) {\\n      if (b.dead) continue;\\n      b.landIn -= dt * sp * tempo;\\n      if (!b.hopped && b.landIn < 0.5) b.hopped = true;\\n860→      if (b.landIn <= 0 && !b.landed) {\\n        b.landed = true; b.x = b.tx; b.y = b.ty;\\n        addObj(S, { type: 'laceration', x: b.x, y: b.y, r: 8, order: 40, drain: 0.2, tag: 'bite' });\\n        pushEv(S, ['bite', Math.round(b.x), Math.round(b.y)]);\\n      }\\n      if (!b.landed) {\\n        const u = clamp(1 - b.landIn / b.flight, 0, 1);\\n        b.x = b.x0 + (b.tx - b.x0) * u;\\n        b.y = b.y0 + (b.ty - b.y0) * u;\\n      }\",\"content_concise\":\"820→    else if (tool === 'suture') stepSuture(S, p, dt, tune);\\n    else if (tool === 'salve') stepSalve(S, p, dt, tune);\\n    else if (tool === 'syringe') stepSyringe(S, p, dt, tune);\\n    else if (tool === 'cautery') stepCautery(S, p, dt, tune);\\n    else if (tool === 'suction') stepSuction(S, p, dt, tune);\\n    else if (tool === 'sonar') stepSonar(S, p, dt, tune);\\n    /* marks expire */\\n  }\\n\\n  /* ---------- strains ---------- */\\n830→\\n  /* Documented defaults are beat 0.5 and spawn 1. Both scales are 1 there, so a case clock does not move. */\\n  function strainBeat(tune) {\\n    const b = tune && tune.strains ? tune.strains.beat : 0.5;\\n    return b > 0 ? b : 0.5;\\n  }\\n  function strainSpawn(tune) {\\n    const s = tune && tune.strains ? tune.strains.spawn : 1;\\n    return s > 0 ? s : 1;\\n  }\\n840→\\n  function stepStrain(S, worldDt, handDt, tune) {\\n    const st = S.strain;\\n    if (!st || st.done) return;\\n    const sp = tune.strains.speed;\\n    if (st.kind === 'staccato') stepStaccato(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'legato') stepLegato(S, st, worldDt, handDt, tune, sp);\\n    else if (st.kind === 'tremolo') stepTremolo(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'dacapo') stepDacapo(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'fermata') stepFermata(S, st, worldDt, tune, sp);\\n850→    else if (st.kind === 'cantor') stepCantor(S, st, worldDt, tune, sp);\\n  }\\n\\n  function stepStaccato(S, st, dt, tune, sp) {\\n    st.t += dt;\\n    const tempo = strainBeat(tune) / 0.5;\\n    for (const b of st.beads) {\\n      if (b.dead) continue;\\n      b.landIn -= dt * sp * tempo;\\n      if (!b.hopped && b.landIn < 0.5) b.hopped = true;\\n860→      if (b.landIn <= 0 && !b.landed) {\\n        b.landed = true; b.x = b.tx; b.y = b.ty;\\n        addObj(S, { type: 'laceration', x: b.x, y: b.y, r: 8, order: 40, drain: 0.2, tag: 'bite' });\\n        pushEv(S, ['bite', Math.round(b.x), Math.round(b.y)]);\\n      }\\n      if (!b.landed) {\\n        const u = clamp(1 - b.landIn / b.flight, 0, 1);\\n        b.x = b.x0 + (b.tx - b.x0) * u;\\n        b.y = b.y0 + (b.ty - b.y0) * u;\\n      }\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/core/sim.js\",\"offset\":820,\"limit\":50,\"raw_output\":\"    else if (tool === 'suture') stepSuture(S, p, dt, tune);\\n    else if (tool === 'salve') stepSalve(S, p, dt, tune);\\n    else if (tool === 'syringe') stepSyringe(S, p, dt, tune);\\n    else if (tool === 'cautery') stepCautery(S, p, dt, tune);\\n    else if (tool === 'suction') stepSuction(S, p, dt, tune);\\n    else if (tool === 'sonar') stepSonar(S, p, dt, tune);\\n    /* marks expire */\\n  }\\n\\n  /* ---------- strains ---------- */\\n\\n  /* Documented defaults are beat 0.5 and spawn 1. Both scales are 1 there, so a case clock does not move. */\\n  function strainBeat(tune) {\\n    const b = tune && tune.strains ? tune.strains.beat : 0.5;\\n    return b > 0 ? b : 0.5;\\n  }\\n  function strainSpawn(tune) {\\n    const s = tune && tune.strains ? tune.strains.spawn : 1;\\n    return s > 0 ? s : 1;\\n  }\\n\\n  function stepStrain(S, worldDt, handDt, tune) {\\n    const st = S.strain;\\n    if (!st || st.done) return;\\n    const sp = tune.strains.speed;\\n    if (st.kind === 'staccato') stepStaccato(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'legato') stepLegato(S, st, worldDt, handDt, tune, sp);\\n    else if (st.kind === 'tremolo') stepTremolo(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'dacapo') stepDacapo(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'fermata') stepFermata(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'cantor') stepCantor(S, st, worldDt, tune, sp);\\n  }\\n\\n  function stepStaccato(S, st, dt, tune, sp) {\\n    st.t += dt;\\n    const tempo = strainBeat(tune) / 0.5;\\n    for (const b of st.beads) {\\n      if (b.dead) continue;\\n      b.landIn -= dt * sp * tempo;\\n      if (!b.hopped && b.landIn < 0.5) b.hopped = true;\\n      if (b.landIn <= 0 && !b.landed) {\\n        b.landed = true; b.x = b.tx; b.y = b.ty;\\n        addObj(S, { type: 'laceration', x: b.x, y: b.y, r: 8, order: 40, drain: 0.2, tag: 'bite' });\\n        pushEv(S, ['bite', Math.round(b.x), Math.round(b.y)]);\\n      }\\n      if (!b.landed) {\\n        const u = clamp(1 - b.landIn / b.flight, 0, 1);\\n        b.x = b.x0 + (b.tx - b.x0) * u;\\n        b.y = b.y0 + (b.ty - b.y0) * u;\\n      }\\n\",\"total_lines\":1782}}","is_error":false},{"type":"tool_result","tool_use_id":"call-9b194cf3-c516-4e68-87fd-7ef6158af51b-78","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"110→  group('cursor', () => {\\n    const travel = (doctor, fine) => {\\n      const S = raw({ doctor });\\n      S.activeDoc = doctor;\\n      const p = S.players[0];\\n      p.bx = 16; p.by = 120; p.x = 16; p.y = 16; p.speed = 0;\\n      const T = tune();\\n      for (let i = 0; i < 120; i++) GAME.Cursor.update(p, { aim: [1, 0], fine: !!fine }, S, 1 / 120, T);\\n      return p.bx - 16;\\n    };\\n120→    const full = travel('sokolova', false);\\n    const fineD = travel('sokolova', true);\\n    const vale = travel('vale', false);\\n    check('full stick covers 300', full >= 300, full.toFixed(1));\\n    check('fine stick stays within 120', fineD <= 120, fineD.toFixed(1));\\n    check('vale is quicker', vale > full * 1.1 && vale < full * 1.2, vale.toFixed(1) + ' vs ' + full.toFixed(1));\\n    const S = raw({ doctor: 'sokolova' });\\n    const p = S.players[0];\\n    p.tool = 'forceps';\\n    GAME.Wheel.update(p, { move: [1, -1] }, 0.05);\\n130→    check('wheel waits out a flick', p.tool === 'forceps', p.tool);\\n    GAME.Wheel.update(p, { move: [1, -1] }, 0.05);\\n    check('wheel settles by 100ms', p.tool === 'scalpel', p.tool);\\n    GAME.Wheel.update(p, { digit: 8 }, 0.016);\\n    check('digit picks at once', p.tool === 'sonar', p.tool);\\n\\n    const sectors = [\\n      [[0, -1], 'forceps'],\\n      [[1, -1], 'scalpel'],\\n      [[1, 0], 'suture'],\\n140→      [[1, 1], 'salve'],\\n      [[0, 1], 'syringe'],\\n      [[-1, 1], 'cautery'],\\n      [[-1, 0], 'suction'],\\n      [[-1, -1], 'sonar'],\\n    ];\\n    for (const [move, tool] of sectors) {\\n      const w = raw();\\n      const hand = w.players[0];\\n      hand.tool = tool === 'forceps' ? 'sonar' : 'forceps';\\n150→      hand.wheelT = 0;\\n      hand.wheelDir = -1;\\n      GAME.Wheel.update(hand, { move }, 0.1);\\n      check('wheel ' + tool, hand.tool === tool, hand.tool);\\n    }\\n\\n    const magnet = (assist) => {\\n      const S = raw();\\n      GAME.Sim.addObj(S, { type: 'polyp', x: 200, y: 120, need: 1, drain: 0 });\\n      const hand = S.players[0];\\n160→      hand.tool = 'cautery';\\n      hand.bx = 190; hand.by = 120; hand.x = 190; hand.y = 120; hand.speed = 0;\\n      const T = tune();\\n      T.hands.assist = assist;\\n      T.hands.magnet = 22;\\n      for (let i = 0; i < 30; i++) GAME.Cursor.update(hand, { aim: [0, 0] }, S, 1 / 60, T);\\n      return hand.bx - 190;\\n    };\\n    const pulled = magnet(0.6);\\n    const idle = magnet(0);\\n170→    check('magnet pulls a still hand', pulled > 6, pulled.toFixed(2));\\n    check('assist off leaves the hand', Math.abs(idle) < 0.2, idle.toFixed(2));\\n\\n    const aimed = (assist) => {\\n      const S = raw();\\n      GAME.Sim.addObj(S, { type: 'polyp', x: 200, y: 120, need: 1, drain: 0 });\\n      const hand = S.players[0];\\n      hand.tool = 'cautery';\\n      hand.bx = 200; hand.by = 120; hand.x = 200; hand.y = 120; hand.speed = 0;\\n      const T = tune();\\n180→      T.hands.assist = assist;\\n      T.hands.magnet = 22;\\n      for (let i = 0; i < 30; i++) GAME.Cursor.update(hand, { aim: [0.5, 0] }, S, 1 / 60, T);\\n      return hand.bx - 200;\\n    };\\n    const openAim = aimed(0);\\n    const heldAim = aimed(0.6);\\n    check('assist slows the hand on a target', heldAim > 8 && heldAim < openAim * 0.85, heldAim.toFixed(1) + ' vs ' + openAim.toFixed(1));\\n\\n    const alongGuide = (assist) => {\\n190→      const S = raw();\\n      const cut = GAME.Sim.addObj(S, { type: 'cut', x: 200, y: 120, guide: [[160, 120], [280, 120]], drain: 0 });\\n      const hand = S.players[0];\\n      hand.tool = 'scalpel';\\n      hand.bx = 200; hand.by = 120; hand.x = 200; hand.y = 120; hand.speed = 0;\\n      hand.stroke = { kind: 'scalpel', id: cut.id, t: 0 };\\n      const T = tune();\\n      T.hands.assist = assist;\\n      T.hands.magnet = 0;\\n      for (let i = 0; i < 20; i++) GAME.Cursor.update(hand, { aim: [0, 1] }, S, 1 / 60, T);\\n200→      return hand.by - 120;\\n    };\\n    const offLine = alongGuide(0);\\n    const onLine = alongGuide(1);\\n    check('the guide holds the blade', onLine > 0 && onLine < offLine * 0.35, onLine.toFixed(2) + ' vs ' + offLine.toFixed(2));\\n  });\\n\\n  group('forceps', () => {\\n    const tear = raw();\\n    const shard = GAME.Sim.addObj(tear, { type: 'shard', x: 200, y: 140, depth: 40, tension: 120, axis: [1, 0], drain: 0 });\\n210→    const before = tear.objects.filter((o) => o.type === 'laceration').length;\\n    step(tear, [{ x: 200, y: 140, tool: 'forceps', trig: 1 }], 1 / 30);\\n    step(tear, [{ x: 200, y: 160, tool: 'forceps', trig: 1 }], 1 / 30);\\n    check('a sideways pull tears', (shard.tears || 0) >= 1, String(shard.tears));\\n    check('a tear leaves a laceration', tear.objects.filter((o) => o.type === 'laceration').length > before);\\n\\n    const dish = raw();\\n    const bit = GAME.Sim.addObj(dish, { type: 'shard', x: 180, y: 140, depth: 16, tension: 120, axis: [1, 0], drain: 0 });\\n    step(dish, [{ x: 180, y: 140, tool: 'forceps', trig: 1 }], 0.05);\\n    for (let x = 182; x <= 200; x += 2) step(dish, [{ x, y: 140, tool: 'forceps', trig: 1 }], 0.05);\\n220→    check('the shard comes free', !!bit.free, 'prog ' + bit.prog);\\n    step(dish, [{ x: 220, y: 140, tool: 'forceps', trig: 1 }], 0.05);\\n    step(dish, [{ x: 220, y: 140, tool: 'forceps', trig: 0 }], 0.05);\\n    check('a free shard dishes', !!bit.done, 'held ' + dish.players[0].held);\\n\\n    const snap = raw();\\n    const head = GAME.Sim.addObj(snap, { type: 'shard', x: 200, y: 140, depth: 40, tension: 120, axis: [1, 0], tag: 'legato-head', drain: 0 });\\n    step(snap, [{ x: 200, y: 140, tool: 'forceps', trig: 1 }], 1 / 30);\\n    const lac = snap.objects.filter((o) => o.type === 'laceration').length;\\n    step(snap, [{ x: 200, y: 160, tool: 'forceps', trig: 1 }], 1 / 30);\\n230→    check('a legato head snaps', !!head.snapped);\\n    check('a snap is not a cut', snap.objects.filter((o) => o.type === 'laceration').length === lac);\\n  });\\n\\n  group('scalpel and suture', () => {\\n    const slipS = raw();\\n    const cut = GAME.Sim.addObj(slipS, { type: 'cut', x: 200, y: 120, guide: [[160, 120], [280, 120]], drain: 0 });\\n    step(slipS, [{ x: 160, y: 120, tool: 'scalpel', trig: 1, mouse: true }], 1 / 60);\\n    hold(slipS, [{ x: 160, y: 142, tool: 'scalpel', trig: 1, mouse: true }], 0.2, 1 / 60);\\n    check('off the line is a slip', slipS.slips > 0, 'slips ' + slipS.slips + ' id ' + cut.id);\\n240→\\n    const ring = raw();\\n    const mass = GAME.Sim.addObj(ring, { type: 'mass', x: 213, y: 116, rad: 16, drain: 0 });\\n    const guide = mass.guide;\\n    step(ring, [{ x: guide[0][0], y: guide[0][1], tool: 'scalpel', trig: 1, mouse: true }], 1 / 60);\\n    for (const pt of guide) step(ring, [{ x: pt[0], y: pt[1], tool: 'scalpel', trig: 1, mouse: true }], 1 / 60);\\n    check('a closed ring finishes', !!mass.cut || mass.prog >= 0.98, 'prog ' + mass.prog);\\n\\n    const sew = raw();\\n    const wound = GAME.Sim.addObj(sew, { type: 'wound', x: 200, y: 130, stitches: 2, drain: 0 });\\n250→    const a = wound.pairs[0][0], b = wound.pairs[0][1];\\n    step(sew, [{ x: a[0], y: a[1], tool: 'suture', trig: 1 }], 1 / 60);\\n    hold(sew, [{ x: a[0], y: a[1], tool: 'suture', trig: 1 }], 0.2, 1 / 60);\\n    step(sew, [{ x: b[0], y: b[1], tool: 'suture', trig: 0 }], 1 / 60);\\n    check('a stitch lands on the far point', wound.stitch === 1, 'stitch ' + wound.stitch);\\n\\n    const loose = raw();\\n    const gap = GAME.Sim.addObj(loose, { type: 'wound', x: 200, y: 130, stitches: 2, drain: 0 });\\n    const near = gap.pairs[0][0];\\n    step(loose, [{ x: near[0], y: near[1], tool: 'suture', trig: 1 }], 1 / 60);\\n260→    step(loose, [{ x: 40, y: 40, tool: 'suture', trig: 0 }], 1 / 60);\\n    check('a loose stitch slips', loose.ev.some((e) => e[0] === 'loose') && (gap.stitch || 0) === 0, JSON.stringify(loose.ev));\\n  });\\n\\n  group('salve syringe cautery suction sonar', () => {\\n    const gel = raw();\\n    const lac = GAME.Sim.addObj(gel, { type: 'laceration', x: 200, y: 120, r: 8, drain: 0 });\\n    for (const c of lac.cells) step(gel, [{ x: c[0], y: c[1], tool: 'salve', trig: 1 }], 1 / 30);\\n    check('salve covers the patch', !!lac.done, 'prog ' + (lac.prog || 0).toFixed(2));\\n\\n270→    const air = raw({ vitals: 40 });\\n    hold(air, [{ x: 40, y: 40, tool: 'syringe', trig: 1 }], 0.95, 0.05);\\n    step(air, [{ x: 40, y: 40, tool: 'syringe', trig: 0 }], 0.05);\\n    check('air in the line is sloppy', air.ev.some((e) => e[0] === 'iv' && e[2] === 'sloppy'), JSON.stringify(air.ev));\\n\\n    const reedS = raw();\\n    const reed = GAME.Sim.addObj(reedS, { type: 'reed', x: 200, y: 120, window: false, drain: 0 });\\n    hold(reedS, [{ x: 40, y: 40, tool: 'syringe', trig: 1 }], 0.6, 0.05);\\n    step(reedS, [{ x: reed.x, y: reed.y, tool: 'syringe', trig: 1 }], 0.05);\\n    step(reedS, [{ x: reed.x, y: reed.y, tool: 'syringe', trig: 0 }], 0.05);\\n280→    check('a closed reed splits', reedS.objects.some((o) => o.type === 'laceration'), 'ev ' + JSON.stringify(reedS.ev));\\n\\n    const burn = raw();\\n    const burned = [];\\n    {\\n      const dt = 0.05;\\n      let t = 0;\\n      while (t < 2.2 - 1e-9) {\\n        step(burn, [{ x: 40, y: 40, tool: 'cautery', trig: 1 }], dt);\\n        for (const e of burn.ev) burned.push(e);\\n290→        t += dt;\\n      }\\n    }\\n    check('the cautery locks', burn.players[0].lock > 0 && burned.some((e) => e[0] === 'lock'), 'lock ' + burn.players[0].lock + ' ' + JSON.stringify(burned.filter((e) => e[0] === 'lock' || e[0] === 'slip')));\\n    check('lock was a slip', burned.some((e) => e[0] === 'slip' && e[1] === 'lock'), JSON.stringify(burned.filter((e) => e[0] === 'slip')));\\n\\n    const suck = raw();\\n    const pool = GAME.Sim.addObj(suck, { type: 'pool', x: 200, y: 140, vol: 30, max: 30, drain: 0 });\\n    hold(suck, [{ x: 200, y: 140, tool: 'suction', trig: 1 }], 0.7, 0.05);\\n    check('suction empties a pool', pool.vol <= 0.2 || pool.done, 'vol ' + pool.vol);\\n300→\\n    const ping = raw({ doctor: 'sokolova' });\\n    ping.activeDoc = 'sokolova';\\n    ping.gift = 'look';\\n    const hid = GAME.Sim.addObj(ping, { type: 'shard', x: 200, y: 140, hidden: true, drain: 0 });\\n    step(ping, [{ x: 200, y: 140, tool: 'sonar', trig: 1 }], 1 / 30);\\n    check('sonar marks a hidden shard', !!hid.marked);\\n  });\\n\\n  group('grades clock gifts', () => {\",\"content_concise\":\"110→  group('cursor', () => {\\n    const travel = (doctor, fine) => {\\n      const S = raw({ doctor });\\n      S.activeDoc = doctor;\\n      const p = S.players[0];\\n      p.bx = 16; p.by = 120; p.x = 16; p.y = 16; p.speed = 0;\\n      const T = tune();\\n      for (let i = 0; i < 120; i++) GAME.Cursor.update(p, { aim: [1, 0], fine: !!fine }, S, 1 / 120, T);\\n      return p.bx - 16;\\n    };\\n120→    const full = travel('sokolova', false);\\n    const fineD = travel('sokolova', true);\\n    const vale = travel('vale', false);\\n    check('full stick covers 300', full >= 300, full.toFixed(1));\\n    check('fine stick stays within 120', fineD <= 120, fineD.toFixed(1));\\n    check('vale is quicker', vale > full * 1.1 && vale < full * 1.2, vale.toFixed(1) + ' vs ' + full.toFixed(1));\\n    const S = raw({ doctor: 'sokolova' });\\n    const p = S.players[0];\\n    p.tool = 'forceps';\\n    GAME.Wheel.update(p, { move: [1, -1] }, 0.05);\\n130→    check('wheel waits out a flick', p.tool === 'forceps', p.tool);\\n    GAME.Wheel.update(p, { move: [1, -1] }, 0.05);\\n    check('wheel settles by 100ms', p.tool === 'scalpel', p.tool);\\n    GAME.Wheel.update(p, { digit: 8 }, 0.016);\\n    check('digit picks at once', p.tool === 'sonar', p.tool);\\n\\n    const sectors = [\\n      [[0, -1], 'forceps'],\\n      [[1, -1], 'scalpel'],\\n      [[1, 0], 'suture'],\\n140→      [[1, 1], 'salve'],\\n      [[0, 1], 'syringe'],\\n      [[-1, 1], 'cautery'],\\n      [[-1, 0], 'suction'],\\n      [[-1, -1], 'sonar'],\\n    ];\\n    for (const [move, tool] of sectors) {\\n      const w = raw();\\n      const hand = w.players[0];\\n      hand.tool = tool === 'forceps' ? 'sonar' : 'forceps';\\n150→      hand.wheelT = 0;\\n      hand.wheelDir = -1;\\n      GAME.Wheel.update(hand, { move }, 0.1);\\n      check('wheel ' + tool, hand.tool === tool, hand.tool);\\n    }\\n\\n    const magnet = (assist) => {\\n      const S = raw();\\n      GAME.Sim.addObj(S, { type: 'polyp', x: 200, y: 120, need: 1, drain: 0 });\\n      const hand = S.players[0];\\n160→      hand.tool = 'cautery';\\n      hand.bx = 190; hand.by = 120; hand.x = 190; hand.y = 120; hand.speed = 0;\\n      const T = tune();\\n      T.hands.assist = assist;\\n      T.hands.magnet = 22;\\n      for (let i = 0; i < 30; i++) GAME.Cursor.update(hand, { aim: [0, 0] }, S, 1 / 60, T);\\n      return hand.bx - 190;\\n    };\\n    const pulled = magnet(0.6);\\n    const idle = magnet(0);\\n170→    check('magnet pulls a still hand', pulled > 6, pulled.toFixed(2));\\n    check('assist off leaves the hand', Math.abs(idle) < 0.2, idle.toFixed(2));\\n\\n    const aimed = (assist) => {\\n      const S = raw();\\n      GAME.Sim.addObj(S, { type: 'polyp', x: 200, y: 120, need: 1, drain: 0 });\\n      const hand = S.players[0];\\n      hand.tool = 'cautery';\\n      hand.bx = 200; hand.by = 120; hand.x = 200; hand.y = 120; hand.speed = 0;\\n      const T = tune();\\n180→      T.hands.assist = assist;\\n      T.hands.magnet = 22;\\n      for (let i = 0; i < 30; i++) GAME.Cursor.update(hand, { aim: [0.5, 0] }, S, 1 / 60, T);\\n      return hand.bx - 200;\\n    };\\n    const openAim = aimed(0);\\n    const heldAim = aimed(0.6);\\n    check('assist slows the hand on a target', heldAim > 8 && heldAim < openAim * 0.85, heldAim.toFixed(1) + ' vs ' + openAim.toFixed(1));\\n\\n    const alongGuide = (assist) => {\\n190→      const S = raw();\\n      const cut = GAME.Sim.addObj(S, { type: 'cut', x: 200, y: 120, guide: [[160, 120], [280, 120]], drain: 0 });\\n      const hand = S.players[0];\\n      hand.tool = 'scalpel';\\n      hand.bx = 200; hand.by = 120; hand.x = 200; hand.y = 120; hand.speed = 0;\\n      hand.stroke = { kind: 'scalpel', id: cut.id, t: 0 };\\n      const T = tune();\\n      T.hands.assist = assist;\\n      T.hands.magnet = 0;\\n      for (let i = 0; i < 20; i++) GAME.Cursor.update(hand, { aim: [0, 1] }, S, 1 / 60, T);\\n200→      return hand.by - 120;\\n    };\\n    const offLine = alongGuide(0);\\n    const onLine = alongGuide(1);\\n    check('the guide holds the blade', onLine > 0 && onLine < offLine * 0.35, onLine.toFixed(2) + ' vs ' + offLine.toFixed(2));\\n  });\\n\\n  group('forceps', () => {\\n    const tear = raw();\\n    const shard = GAME.Sim.addObj(tear, { type: 'shard', x: 200, y: 140, depth: 40, tension: 120, axis: [1, 0], drain: 0 });\\n210→    const before = tear.objects.filter((o) => o.type === 'laceration').length;\\n    step(tear, [{ x: 200, y: 140, tool: 'forceps', trig: 1 }], 1 / 30);\\n    step(tear, [{ x: 200, y: 160, tool: 'forceps', trig: 1 }], 1 / 30);\\n    check('a sideways pull tears', (shard.tears || 0) >= 1, String(shard.tears));\\n    check('a tear leaves a laceration', tear.objects.filter((o) => o.type === 'laceration').length > before);\\n\\n    const dish = raw();\\n    const bit = GAME.Sim.addObj(dish, { type: 'shard', x: 180, y: 140, depth: 16, tension: 120, axis: [1, 0], drain: 0 });\\n    step(dish, [{ x: 180, y: 140, tool: 'forceps', trig: 1 }], 0.05);\\n    for (let x = 182; x <= 200; x += 2) step(dish, [{ x, y: 140, tool: 'forceps', trig: 1 }], 0.05);\\n220→    check('the shard comes free', !!bit.free, 'prog ' + bit.prog);\\n    step(dish, [{ x: 220, y: 140, tool: 'forceps', trig: 1 }], 0.05);\\n    step(dish, [{ x: 220, y: 140, tool: 'forceps', trig: 0 }], 0.05);\\n    check('a free shard dishes', !!bit.done, 'held ' + dish.players[0].held);\\n\\n    const snap = raw();\\n    const head = GAME.Sim.addObj(snap, { type: 'shard', x: 200, y: 140, depth: 40, tension: 120, axis: [1, 0], tag: 'legato-head', drain: 0 });\\n    step(snap, [{ x: 200, y: 140, tool: 'forceps', trig: 1 }], 1 / 30);\\n    const lac = snap.objects.filter((o) => o.type === 'laceration').length;\\n    step(snap, [{ x: 200, y: 160, tool: 'forceps', trig: 1 }], 1 / 30);\\n230→    check('a legato head snaps', !!head.snapped);\\n    check('a snap is not a cut', snap.objects.filter((o) => o.type === 'laceration').length === lac);\\n  });\\n\\n  group('scalpel and suture', () => {\\n    const slipS = raw();\\n    const cut = GAME.Sim.addObj(slipS, { type: 'cut', x: 200, y: 120, guide: [[160, 120], [280, 120]], drain: 0 });\\n    step(slipS, [{ x: 160, y: 120, tool: 'scalpel', trig: 1, mouse: true }], 1 / 60);\\n    hold(slipS, [{ x: 160, y: 142, tool: 'scalpel', trig: 1, mouse: true }], 0.2, 1 / 60);\\n    check('off the line is a slip', slipS.slips > 0, 'slips ' + slipS.slips + ' id ' + cut.id);\\n240→\\n    const ring = raw();\\n    const mass = GAME.Sim.addObj(ring, { type: 'mass', x: 213, y: 116, rad: 16, drain: 0 });\\n    const guide = mass.guide;\\n    step(ring, [{ x: guide[0][0], y: guide[0][1], tool: 'scalpel', trig: 1, mouse: true }], 1 / 60);\\n    for (const pt of guide) step(ring, [{ x: pt[0], y: pt[1], tool: 'scalpel', trig: 1, mouse: true }], 1 / 60);\\n    check('a closed ring finishes', !!mass.cut || mass.prog >= 0.98, 'prog ' + mass.prog);\\n\\n    const sew = raw();\\n    const wound = GAME.Sim.addObj(sew, { type: 'wound', x: 200, y: 130, stitches: 2, drain: 0 });\\n250→    const a = wound.pairs[0][0], b = wound.pairs[0][1];\\n    step(sew, [{ x: a[0], y: a[1], tool: 'suture', trig: 1 }], 1 / 60);\\n    hold(sew, [{ x: a[0], y: a[1], tool: 'suture', trig: 1 }], 0.2, 1 / 60);\\n    step(sew, [{ x: b[0], y: b[1], tool: 'suture', trig: 0 }], 1 / 60);\\n    check('a stitch lands on the far point', wound.stitch === 1, 'stitch ' + wound.stitch);\\n\\n    const loose = raw();\\n    const gap = GAME.Sim.addObj(loose, { type: 'wound', x: 200, y: 130, stitches: 2, drain: 0 });\\n    const near = gap.pairs[0][0];\\n    step(loose, [{ x: near[0], y: near[1], tool: 'suture', trig: 1 }], 1 / 60);\\n260→    step(loose, [{ x: 40, y: 40, tool: 'suture', trig: 0 }], 1 / 60);\\n    check('a loose stitch slips', loose.ev.some((e) => e[0] === 'loose') && (gap.stitch || 0) === 0, JSON.stringify(loose.ev));\\n  });\\n\\n  group('salve syringe cautery suction sonar', () => {\\n    const gel = raw();\\n    const lac = GAME.Sim.addObj(gel, { type: 'laceration', x: 200, y: 120, r: 8, drain: 0 });\\n    for (const c of lac.cells) step(gel, [{ x: c[0], y: c[1], tool: 'salve', trig: 1 }], 1 / 30);\\n    check('salve covers the patch', !!lac.done, 'prog ' + (lac.prog || 0).toFixed(2));\\n\\n270→    const air = raw({ vitals: 40 });\\n    hold(air, [{ x: 40, y: 40, tool: 'syringe', trig: 1 }], 0.95, 0.05);\\n    step(air, [{ x: 40, y: 40, tool: 'syringe', trig: 0 }], 0.05);\\n    check('air in the line is sloppy', air.ev.some((e) => e[0] === 'iv' && e[2] === 'sloppy'), JSON.stringify(air.ev));\\n\\n    const reedS = raw();\\n    const reed = GAME.Sim.addObj(reedS, { type: 'reed', x: 200, y: 120, window: false, drain: 0 });\\n    hold(reedS, [{ x: 40, y: 40, tool: 'syringe', trig: 1 }], 0.6, 0.05);\\n    step(reedS, [{ x: reed.x, y: reed.y, tool: 'syringe', trig: 1 }], 0.05);\\n    step(reedS, [{ x: reed.x, y: reed.y, tool: 'syringe', trig: 0 