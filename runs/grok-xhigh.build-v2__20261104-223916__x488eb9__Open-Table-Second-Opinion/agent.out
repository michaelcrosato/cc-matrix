,109,111,118,101,40,41,44,32,97,32,61,32,73,46,112,97,100,65,105,109,44,32,112,116,114,32,61,32,73,46,112,111,105,110,116,101,114,40,41,59,32,108,101,116,32,100,120,32,61,32,40,97,32,63,32,97,91,48,93,32,58,32,48,41,32,43,32,109,91,48,93,44,32,100,121,32,61,32,40,97,32,63,32,97,91,49,93,32,58,32,48,41,32,43,32,109,91,49,93,59,32,109,105,110,101,46,120,32,61,32,69,46,99,108,97,109,112,40,109,105,110,101,46,120,32,43,32,100,120,32,42,32,51,48,48,32,42,32,100,116,44,32,48,44,32,87,48,41,59,32,109,105,110,101,46,121,32,61,32,69,46,99,108,97,109,112,40,109,105,110,101,46,121,32,43,32,100,121,32,42,32,51,48,48,32,42,32,100,116,44,32,48,44,32,72,48,41,59,32,105,102,32,40,112,116,114,32,38,38,32,73,46,108,97,115,116,68,101,118,105,99,101,32,61,61,61,32,39,109,111,117,115,101,39,41,32,123,32,109,105,110,101,46,120,32,61,32,112,116,114,91,48,93,59,32,109,105,110,101,46,121,32,61,32,112,116,114,91,49,93,59,32,125,32,109,105,110,101,46,116,32,61,32,73,46,118,97,108,117,101,40,39,117,115,101,84,111,111,108,39,41,59,32,125,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":16,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/PLAN.md\",\"matches\":[{\"line_number\":70,\"content\":\"| Two doctors with different gifts | Two doctors, then both at once in the finale | The second doctor was mostly post-game | She joins the main story (Chapter 3) |\"},{\"line_number\":116,\"content\":\"5. **Glyphs.** `{ key: 'glyphs', value: 'playstation', options: [['playstation', 'PlayStation'], ['xbox', 'Xbox']] }` in the same list gives the required Settings option. With `useTool: ['Pad7', 'Pad0', 'Mouse0', 'Space']`, `input.label('useTool')` gave `R2` (PlayStation), `RT` (Xbox), `Left click` (mouse last used), `Space` (keyboard last used). The Pad code listed first is the one shown. The 5x7 font draws `✕ ○ □ △`.\"},{\"line_number\":117,\"content\":\"6. **Pad reading** with the stub in Appendix E: `input.padIndex === 0`, `input.padStyle() === 'playstation'`, `input.value('useTool') === .5` from `buttons[7].value = .5`, `input.padAim` is the right stick and `input.padMove` the left, both after the dead zone.\"},{\"line_number\":264,\"content\":\"### 5.7 The Steady (the gift)\"},{\"line_number\":272,\"content\":\"**Consult (Cases 10 and 11).** □ or C hands over to the other doctor in .4 s. Gauge shared, each doctor's gift and passive apply: Vale has +15% cursor speed and +25% Sonar radius; Sokolova has +.2 assist and +1 u suture tolerance.\"},{\"line_number\":316,\"content\":\"## 6. Controls and prompts\"},{\"line_number\":342,\"content\":\"const INPUT = { ...base,\"},{\"line_number\":343,\"content\":\"  useTool: ['Pad7', 'Pad0', 'Mouse0', 'Space'], fine: ['Pad6', 'ShiftLeft', 'ShiftRight'], gift: ['Pad3', 'KeyF', 'Mouse1'], consult: ['Pad2', 'KeyC'],\"},{\"line_number\":351,\"content\":\"Read the two sticks from `input.padAim` and `input.padMove`, the trigger from `input.value('useTool')`. Name the actions and hide `tool1` to `tool8` from rebinding through `menu.controls`. Give the scene `camera: { zoom: false, wheel: false }`, because the wheel is the game's.\"},{\"line_number\":509,\"content\":\"**Case 11, Last Note** (both, mediastinum; 420, 70, .3, with +120 s at each new movement). All tools, both gifts, Consult free.\"},{\"line_number\":941,\"content\":\"Op.step(S, inputs, dt)                                      // inputs[i]: { x, y, tool, trig, fine, gift, consult, cancel }, sim only\"},{\"line_number\":967,\"content\":\"const game = new E.Game({ canvas: 'screen', id: GAME_TITLE, res: [426, 240], expand: true, view: 'overhead', touch: 'never', input: INPUT,\"},{\"line_number\":970,\"content\":\"    controls: { useTool: 'Use tool', fine: 'Steady hand', gift: 'The Steady', consult: 'Consult', toolPrev: 'Previous tool', toolNext: 'Next tool', wheelHold: 'Tool wheel', tool1: false, tool2: false, tool3: false, tool4: false, tool5: false, tool6: false, tool7: false, tool8: false },\"},{\"line_number\":1036,\"content\":\"**If you run out of runway**, cut content from the end of this list and keep everything else: Case 9, then Skills Lab, then Da Capo's round 2, then the ship's ward (reuse Ward 3), then a stage or two. **Never cut:** the cursor's quality, any of the eight tools, both gifts, the finale, Grand Rounds and the Hub tests, attract mode, dev mode, the 10-foot UI, About, the exit interview. Whatever ships is complete: no stubs, no TODOs.\"},{\"line_number\":1259,\"content\":\"  input: { ...base, useTool: ['Pad7', 'Pad0', 'Mouse0', 'Space'], more: ['Pad3', 'KeyM'] }, menu: { quit: inSession ? false : 'title', settings: [{ key: 'music', value: .1 }, { key: 'glyphs', value: 'playstation', options: [['playstation', 'PlayStation'], ['xbox', 'Xbox']] }] } });\"},{\"line_number\":1279,\"content\":\"function step(dt) { const I = game.input, m = I.move(), a = I.padAim, ptr = I.pointer(); let dx = (a ? a[0] : 0) + m[0], dy = (a ? a[1] : 0) + m[1]; mine.x = E.clamp(mine.x + dx * 300 * dt, 0, W0); mine.y = E.clamp(mine.y + dy * 300 * dt, 0, H0); if (ptr && I.lastDevice === 'mouse') { mine.x = ptr[0]; mine.y = ptr[1]; } mine.t = I.value('useTool'); }\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-a818ad12-2b27-47db-a15c-f375719742a8-18","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1260→    let dx = (e.clientX - this._stickO[0]) / this.stickRadius, dy = (e.clientY - this._stickO[1]) / this.stickRadius;\\n    const l = Math.hypot(dx, dy), d = clamp(this.stickDeadzone, 0, .5), k = l <= d ? 0 : Math.min(1, (l - d) / (1 - d)) / l;   // a thumb resting on the glass doesn't creep\\n    this.stick = [dx * k, dy * k]; this._stickDirs(); this._stickDraw();\\n  }\\n  _stickEnd(e) { if (e.pointerId !== this.stickId) return; this.stickOn = false; this.stick = [0, 0]; this._stickDirs(); if (this._stickEl) this._stickEl.style.display = this._knobEl.style.display = 'none'; }\\n  // past halfway the stick presses the direction actions, as a d-pad would (and lets go of them)\\n  _stickDirs() {\\n    const [x, y] = this.stick, on = [y < -.5, y > .5, x < -.5, x > .5], was = this._sd || (this._sd = [false, false, false, false]);\\n    ['up', 'down', 'left', 'right'].forEach((d, i) => { if (on[i] !== was[i]) { was[i] = on[i]; if (on[i]) this.press('Act:' + d); else this.release('Act:' + d); } });\\n  }\\n1270→  _stickDraw() {\\n    if (this.steer === 'drag') { this._stickEl.style.display = this._knobEl.style.display = 'none'; return; }   // a drag steers what it moves: no stick to show\\n    const rc = this.screen.canvas.getBoundingClientRect(), pr = this.screen.canvas.parentElement.getBoundingClientRect();\\n    const ox = this._stickO[0] - pr.left, oy = this._stickO[1] - pr.top;\\n    Object.assign(this._stickEl.style, { display: 'block', left: ox - 48 + 'px', top: oy - 48 + 'px' });\\n    Object.assign(this._knobEl.style, { display: 'block', left: ox - 20 + this.stick[0] * 36 + 'px', top: oy - 20 + this.stick[1] * 36 + 'px' });\\n    void rc;\\n  }\\n}\\n/* the player's zoom keys (Input: where no action uses them): - farther, = closer, and the numpad's */\\n1280→const ZOOM_KEYS = { Minus: 1 / 1.1, NumpadSubtract: 1 / 1.1, Equal: 1.1, NumpadAdd: 1.1 };\\n/* menu actions shared by every preset. Pad9 = Start, Pad0 = A (bottom), Pad1 = B (right). use() adds 'Act:menu', the\\n   touch START button, to start and pause in any layout: like Start, it starts on a title and pauses a pausable scene */\\nconst MENU_KEYS = {\\n  start: ['Enter', 'NumpadEnter', 'Pad9'], pause: ['Escape', 'KeyP', 'Pad9'],\\n  confirm: ['Enter', 'NumpadEnter', 'Space', 'KeyJ', 'KeyZ', 'Pad0'], cancel: ['Escape', 'Backspace', 'KeyX', 'KeyK', 'Pad1']\\n};\\n/* rebinding: the codes a player may bind (not Escape, Enter, the F keys, Start or Home: the menus and the browser keep\\n   them), the arrow keys and d-pad that stay on the moves whatever is bound, and which codes are a gamepad's */\\nconst BINDABLE = /^(Key[A-Z]|Digit\\\\d|Numpad\\\\d|Arrow(Up|Down|Left|Right)|Space|Shift(Left|Right)|Control(Left|Right)|Alt(Left|Right)|Tab|Backspace|Backquote|Minus|Equal|Bracket(Left|Right)|Backslash|Semicolon|Quote|Comma|Period|Slash|CapsLock|Mouse[0-4]|Wheel(Up|Down)|Pad([0-8]|1[0-5])|PadRAxis(Up|Down|Left|Right))$/;\\n1290→const FIXED_CODES = new Set(['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Pad12', 'Pad13', 'Pad14', 'Pad15', 'PadAxisUp', 'PadAxisDown', 'PadAxisLeft', 'PadAxisRight']);\\n/* the left stick past halfway presses the direction actions, as the d-pad does (menus, dialog choices, ladders) */\\nconst STICK_CODES = { up: 'PadAxisUp', down: 'PadAxisDown', left: 'PadAxisLeft', right: 'PadAxisRight' };\\nconst padCode = c => c.startsWith('Pad'), RSTICK = ['PadRAxisUp', 'PadRAxisDown', 'PadRAxisLeft', 'PadRAxisRight'];   // (the right stick's codes, past halfway)\\n/* a standard gamepad's buttons by position (0 bottom, 1 right, 2 left, 3 top, 4-7 shoulders and triggers, 8 back, 9 start,\\n   10-11 stick clicks, 12-15 d-pad, 16 home), as each family prints them */\\nconst PAD_GLYPHS = {\\n  xbox: ['A', 'B', 'X', 'Y', 'LB', 'RB', 'LT', 'RT', 'View', 'Menu', 'LS', 'RS', 'D-pad ↑', 'D-pad ↓', 'D-pad ←', 'D-pad →', 'Guide'],\\n  playstation: ['✕', '○', '□', '△', 'L1', 'R1', 'L2', 'R2', 'Create', 'Options', 'L3', 'R3', 'D-pad ↑', 'D-pad ↓', 'D-pad ←', 'D-pad →', 'PS'],\\n  nintendo: ['B', 'A', 'Y', 'X', 'L', 'R', 'ZL', 'ZR', '−', '+', 'L stick', 'R stick', 'D-pad ↑', 'D-pad ↓', 'D-pad ←', 'D-pad →', 'Home'],\\n1300→  generic: ['Bottom', 'Right', 'Left', 'Top', 'L1', 'R1', 'L2', 'R2', 'Select', 'Start', 'L3', 'R3', 'D-pad ↑', 'D-pad ↓', 'D-pad ←', 'D-pad →', 'Home']\\n};\\nconst CODE_LABELS = { Space: 'Space', ShiftLeft: 'Shift', ShiftRight: 'R Shift', ControlLeft: 'Ctrl', ControlRight: 'R Ctrl', AltLeft: 'Alt', AltRight: 'R Alt',\\n  Enter: 'Enter', NumpadEnter: 'Enter', Escape: 'Esc', Backspace: 'Backspace', Tab: 'Tab', CapsLock: 'Caps', ArrowUp: '↑', ArrowDown: '↓', ArrowLeft: '←', ArrowRight: '→',\\n  Mouse0: 'Left click', Mouse1: 'Middle click', Mouse2: 'Right click', Mouse3: 'Mouse 4', Mouse4: 'Mouse 5', Backquote: '`', Minus: '-', Equal: '=', BracketLeft: '[',\\n  BracketRight: ']', Backslash: '\\\\\\\\', Semicolon: ';', Quote: \\\"'\\\", Comma: ',', Period: '.', Slash: '/',\\n  PadAxisUp: 'L stick ↑', PadAxisDown: 'L stick ↓', PadAxisLeft: 'L stick ←', PadAxisRight: 'L stick →',\\n  PadRAxisUp: 'R stick ↑', PadRAxisDown: 'R stick ↓', PadRAxisLeft: 'R stick ←', PadRAxisRight: 'R stick →', WheelUp: 'Wheel up', WheelDown: 'Wheel down' };\\n/** top-down / isometric action (Zelda, Diablo): Space dashes, J or click attacks */\\nInput.DEFAULT = {\\n1310→  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\\n  attack: ['KeyJ', 'KeyX', 'Mouse0', 'Pad0', 'Pad7'], dash: ['Space', 'ShiftLeft', 'ShiftRight', 'KeyK', 'Pad1', 'Pad6'],\\n  skill: ['KeyL', 'KeyE', 'Mouse2', 'Pad2', 'Pad5'], jump: ['KeyZ', 'Pad3'], ...MENU_KEYS\\n};\\n/** side-scrollers (Mario, Mega Man): Space / Z / K jump, X / J attack or shoot, Shift / C dash */\\nInput.PLATFORMER = {\\n  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\\n  jump: ['Space', 'KeyZ', 'KeyK', 'Pad0'], attack: ['KeyX', 'KeyJ', 'Mouse0', 'Pad2'], dash: ['ShiftLeft', 'ShiftRight', 'KeyC', 'KeyL', 'Pad1', 'Pad5'],\\n  skill: ['KeyE', 'KeyV', 'Mouse2', 'Pad3'], ...MENU_KEYS\\n};\\n1320→/** third-person action and stealth (Assassin's Creed, Metal Gear): WASD / stick move, Shift sprint, Space jump and parkour,\\n *  C crouch (a toggle), E interact, J attack, K block, L dodge, Q use, M map. Pad: A jump, B crouch, X attack, Y interact,\\n *  LB block, RB dodge, LT use, RT or L3 sprint, Back map */\\nInput.THIRDPERSON = {\\n  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\\n  sprint: ['ShiftLeft', 'ShiftRight', 'Pad7', 'Pad10'], jump: ['Space', 'Pad0'], crouch: ['KeyC', 'ControlLeft', 'Pad1'], interact: ['KeyE', 'KeyF', 'Pad3'],\\n  attack: ['KeyJ', 'Mouse0', 'Pad2'], block: ['KeyK', 'Mouse2', 'Pad4'], dodge: ['KeyL', 'Pad5'], use: ['KeyQ', 'Pad6'], map: ['KeyM', 'Tab', 'Pad8'], ...MENU_KEYS\\n};\\n/** shoot-'em-ups (1942, Gradius): Space / Z / J fire (hold for autofire), X / K bomb */\\nInput.SHMUP = {\\n1330→  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\\n  fire: ['Space', 'KeyZ', 'KeyJ', 'Mouse0', 'Pad0', 'Pad7'], bomb: ['KeyX', 'KeyK', 'Mouse2', 'Pad1', 'Pad6'], ...MENU_KEYS\\n};\\nE.Input = Input;\\n\\n/* =============================================================================\\n * 6. PIXEL FONTS  the 5x7 text font (the default) and the 3x5 one for in-world numbers and labels\\n * ============================================================================= */\\n// Both fonts are tables of glyphs: each entry a character, then one digit for each row of its pixels, top to bottom, the\\n// row's pixels being the digit's bits from the left. The 3x5 ('tiny', upper case, for in-world numbers and labels): five\\n1340→// octal digits, so '075557' is 0 drawn as 7 = ###, 5 = #.#, #.#, #.#, ###. The 5x7 ('normal', the default): its width,\\n// then a base-32 digit a row (0-9 then a-v, 5 bits), seven above the baseline and up to two below, so 'A5ehhvhhh' is A,\\n// 5 wide, e = .###., h = #...#, h, v = #####, h, h, h. The 5x7 is proportional with lower case and descenders; beside\\n// ASCII it draws every symbol input.label() returns (✕ ○ □ △ and the arrows), ✓ ✗ · • … – — ° ² ³ × € £ ¢ ¡ ¿ ’ “ ”,\\n// ▲ ▼ ◀ ▶ ◂ ▸ ● ■ ★ ♥ ♪ © and the accented letters of the Latin alphabets (é à ç ñ ü ö ß ..., a capital five rows tall\\n// under its accent); any other character draws as ?. It is the agent edition's table. To see glyphs as rows of # and .:\\n// node tools/font.mjs <characters> [--tiny]\\nconst GLYPHS = \\\"075557 126227 271747 371717 455711 574717 674757 771222 875757 975717 A25755 B65656 C34443 D65556 E74647 F74644 G34553 H55755 I72227 J11152 K55655 L44447 M57755 N65555 O25552 P65644 Q25563 R65655 S34216 T72222 U55557 V55552 W55775 X55255 Y55222 Z71247 +02720 -00700 !22202 .00002 :02020 /11244 x05250 ?71202 ,00024 '22000 \\\\\\\"55000 (12221 )42224 %51245 *05250 =07070 <12421 >42124 #57575 &25253 _00007 ;02024 [64446 ]31113 $36736 ^25000 @75743 ~03600 ♥57720 ♡55520 ★27250 •02720 ←04740 →01710 ↑27222 ↓22272 ©75557 ✕05250 ○02520 □07570 △02570 ✓01520 ·00200 –00700 —00700 ▲02700 ▼07200 ▶46764 ◀13731 ▸46764 ◂13731 °25200 −00700\\\";\\nconst G57 = \\\"05ehjlphe 154c4444e 25eh1248v 35u11e11u 4526aiv22 55vgu11he 65egguhhe 75v124888 85ehhehhe 95ehhf11e A5ehhvhhh B5uhhuhhu C5ehggghe D5uhhhhhu E5vgguggv F5vgguggg G5ehgnhhf H5hhhvhhh I37222227 J572222ic K5hikokih L5ggggggv M5hrllhhh N5hhpljhh O5ehhhhhe P5uhhuggg Q5ehhhlid R5uhhukih S5fgge11u T5v444444 U5hhhhhhe V5hhhhha4 W5hhhllla X5hha4ahh Y5hha4444 Z5v1248gv a500e1fhf b5gguhhhu c500eggge d511fhhhf e500ehvge f434f4444 g500fhhhf1e h5gguhhhh i11011111 j3101111152 k4889aca9 l22222221 m500qllll n500uhhhh o500ehhhe p500uhhhugg q500fhhhf11 r400bc888 s500fge1u t444f4443 u500hhhhf v500hhha4 w500hhlla x500ha4ah y500hhhhf1e z500v248v !11111101 \\\\\\\"35500000 #5aavavaa $54fke5u4 %5pp248jj &5cik8lid '11100000 (31244421 )34211124 *50level0 +5044v440 ,200000112 -4000f000 .10000001 /511248gg :10010010 ;200100112 <41248421 =500v0v00 >48421248 ?5eh12404 @5ehnlngf [37444447 \\\\\\\\5gg84211 ]37111117 ^54ah0000 _5000000v `22100000 {43448443 |11111111 }4c22122c ~5008l200 ♥50avve40 ★544veah0 ←5048v840 →5042v240 ↑54el4440 ↓50444le4 •30027200 ©5ehlklhe ×50ha4ah0 ▸48cefec8 ♪56544cs8 ✕50ha4ah0 ○50ehhhe0 □50vhhhv0 △504aahv0 ✓50012k80 ✗50ha4ah0 ◂4137f731 ◀4137f731 ▶48cefec8 ◄4137f731 ►48cefec8 ▲5004ev00 ▼500ve400 ●50evvve0 ■50vvvvv0 ·10001000 –4000f000 —5000v000 …5000000l ’21120000 ‘21220000 “45aa0000 ”455a0000 °32520000 ²36127000 ³37317000 €578u8u87 £5698s88v ¢504ekke4 ¡11011111 ¿54048ghe ß5ciimhhm á524e1fhf é524ehvge í31222222 ó524ehhhe ú524hhhhf ý524hhhhf1e Á524ehvhh É524vgugv Í31272227 Ó524ehhhe Ú524hhhhe Ý524ha444 à584e1fhf è584ehvge ì34222222 ò584ehhhe ù584hhhhf À584ehvhh È584vgugv Ì34272227 Ò584ehhhe Ù584hhhhe â54ae1fhf ê54aehvge î32522222 ô54aehhhe û54ahhhhf Â54aehvhh Ê54avgugv Î32572227 Ô54aehhhe Û54ahhhhe ä5a0e1fhf ë5a0ehvge ï35022222 ö5a0ehhhe ü5a0hhhhf ÿ5a0hhhhf1e Ä5a0ehvhh Ë5a0vgugv Ï35072227 Ö5a0ehhhe Ü5a0hhhhe ã59me1fhf õ59mehhhe ñ59muhhhh Ã59mehvhh Õ59mehhhe Ñ59mhpljh ç500eggge4c Ç5ehggghe4c −5000v000\\\";\\nconst parseFont = (src, mono) => {   // -> { char: { w, runs: [[x, y, n] ...] } }, the lit pixels of each row in runs\",\"content_concise\":\"1260→    let dx = (e.clientX - this._stickO[0]) / this.stickRadius, dy = (e.clientY - this._stickO[1]) / this.stickRadius;\\n    const l = Math.hypot(dx, dy), d = clamp(this.stickDeadzone, 0, .5), k = l <= d ? 0 : Math.min(1, (l - d) / (1 - d)) / l;   // a thumb resting on the glass doesn't creep\\n    this.stick = [dx * k, dy * k]; this._stickDirs(); this._stickDraw();\\n  }\\n  _stickEnd(e) { if (e.pointerId !== this.stickId) return; this.stickOn = false; this.stick = [0, 0]; this._stickDirs(); if (this._stickEl) this._stickEl.style.display = this._knobEl.style.display = 'none'; }\\n  // past halfway the stick presses the direction actions, as a d-pad would (and lets go of them)\\n  _stickDirs() {\\n    const [x, y] = this.stick, on = [y < -.5, y > .5, x < -.5, x > .5], was = this._sd || (this._sd = [false, false, false, false]);\\n    ['up', 'down', 'left', 'right'].forEach((d, i) => { if (on[i] !== was[i]) { was[i] = on[i]; if (on[i]) this.press('Act:' + d); else this.release('Act:' + d); } });\\n  }\\n1270→  _stickDraw() {\\n    if (this.steer === 'drag') { this._stickEl.style.display = this._knobEl.style.display = 'none'; return; }   // a drag steers what it moves: no stick to show\\n    const rc = this.screen.canvas.getBoundingClientRect(), pr = this.screen.canvas.parentElement.getBoundingClientRect();\\n    const ox = this._stickO[0] - pr.left, oy = this._stickO[1] - pr.top;\\n    Object.assign(this._stickEl.style, { display: 'block', left: ox - 48 + 'px', top: oy - 48 + 'px' });\\n    Object.assign(this._knobEl.style, { display: 'block', left: ox - 20 + this.stick[0] * 36 + 'px', top: oy - 20 + this.stick[1] * 36 + 'px' });\\n    void rc;\\n  }\\n}\\n/* the player's zoom keys (Input: where no action uses them): - farther, = closer, and the numpad's */\\n1280→const ZOOM_KEYS = { Minus: 1 / 1.1, NumpadSubtract: 1 / 1.1, Equal: 1.1, NumpadAdd: 1.1 };\\n/* menu actions shared by every preset. Pad9 = Start, Pad0 = A (bottom), Pad1 = B (right). use() adds 'Act:menu', the\\n   touch START button, to start and pause in any layout: like Start, it starts on a title and pauses a pausable scene */\\nconst MENU_KEYS = {\\n  start: ['Enter', 'NumpadEnter', 'Pad9'], pause: ['Escape', 'KeyP', 'Pad9'],\\n  confirm: ['Enter', 'NumpadEnter', 'Space', 'KeyJ', 'KeyZ', 'Pad0'], cancel: ['Escape', 'Backspace', 'KeyX', 'KeyK', 'Pad1']\\n};\\n/* rebinding: the codes a player may bind (not Escape, Enter, the F keys, Start or Home: the menus and the browser keep\\n   them), the arrow keys and d-pad that stay on the moves whatever is bound, and which codes are a gamepad's */\\nconst BINDABLE = /^(Key[A-Z]|Digit\\\\d|Numpad\\\\d|Arrow(Up|Down|Left|Right)|Space|Shift(Left|Right)|Control(Left|Right)|Alt(Left|Right)|Tab|Backspace|Backquote|Minus|Equal|Bracket(Left|Right)|Backslash|Semicolon|Quote|Comma|Period|Slash|CapsLock|Mouse[0-4]|Wheel(Up|Down)|Pad([0-8]|1[0-5])|PadRAxis(Up|Down|Left|Right))$/;\\n1290→const FIXED_CODES = new Set(['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Pad12', 'Pad13', 'Pad14', 'Pad15', 'PadAxisUp', 'PadAxisDown', 'PadAxisLeft', 'PadAxisRight']);\\n/* the left stick past halfway presses the direction actions, as the d-pad does (menus, dialog choices, ladders) */\\nconst STICK_CODES = { up: 'PadAxisUp', down: 'PadAxisDown', left: 'PadAxisLeft', right: 'PadAxisRight' };\\nconst padCode = c => c.startsWith('Pad'), RSTICK = ['PadRAxisUp', 'PadRAxisDown', 'PadRAxisLeft', 'PadRAxisRight'];   // (the right stick's codes, past halfway)\\n/* a standard gamepad's buttons by position (0 bottom, 1 right, 2 left, 3 top, 4-7 shoulders and triggers, 8 back, 9 start,\\n   10-11 stick clicks, 12-15 d-pad, 16 home), as each family prints them */\\nconst PAD_GLYPHS = {\\n  xbox: ['A', 'B', 'X', 'Y', 'LB', 'RB', 'LT', 'RT', 'View', 'Menu', 'LS', 'RS', 'D-pad ↑', 'D-pad ↓', 'D-pad ←', 'D-pad →', 'Guide'],\\n  playstation: ['✕', '○', '□', '△', 'L1', 'R1', 'L2', 'R2', 'Create', 'Options', 'L3', 'R3', 'D-pad ↑', 'D-pad ↓', 'D-pad ←', 'D-pad →', 'PS'],\\n  nintendo: ['B', 'A', 'Y', 'X', 'L', 'R', 'ZL', 'ZR', '−', '+', 'L stick', 'R stick', 'D-pad ↑', 'D-pad ↓', 'D-pad ←', 'D-pad →', 'Home'],\\n1300→  generic: ['Bottom', 'Right', 'Left', 'Top', 'L1', 'R1', 'L2', 'R2', 'Select', 'Start', 'L3', 'R3', 'D-pad ↑', 'D-pad ↓', 'D-pad ←', 'D-pad →', 'Home']\\n};\\nconst CODE_LABELS = { Space: 'Space', ShiftLeft: 'Shift', ShiftRight: 'R Shift', ControlLeft: 'Ctrl', ControlRight: 'R Ctrl', AltLeft: 'Alt', AltRight: 'R Alt',\\n  Enter: 'Enter', NumpadEnter: 'Enter', Escape: 'Esc', Backspace: 'Backspace', Tab: 'Tab', CapsLock: 'Caps', ArrowUp: '↑', ArrowDown: '↓', ArrowLeft: '←', ArrowRight: '→',\\n  Mouse0: 'Left click', Mouse1: 'Middle click', Mouse2: 'Right click', Mouse3: 'Mouse 4', Mouse4: 'Mouse 5', Backquote: '`', Minus: '-', Equal: '=', BracketLeft: '[',\\n  BracketRight: ']', Backslash: '\\\\\\\\', Semicolon: ';', Quote: \\\"'\\\", Comma: ',', Period: '.', Slash: '/',\\n  PadAxisUp: 'L stick ↑', PadAxisDown: 'L stick ↓', PadAxisLeft: 'L stick ←', PadAxisRight: 'L stick →',\\n  PadRAxisUp: 'R stick ↑', PadRAxisDown: 'R stick ↓', PadRAxisLeft: 'R stick ←', PadRAxisRight: 'R stick →', WheelUp: 'Wheel up', WheelDown: 'Wheel down' };\\n/** top-down / isometric action (Zelda, Diablo): Space dashes, J or click attacks */\\nInput.DEFAULT = {\\n1310→  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\\n  attack: ['KeyJ', 'KeyX', 'Mouse0', 'Pad0', 'Pad7'], dash: ['Space', 'ShiftLeft', 'ShiftRight', 'KeyK', 'Pad1', 'Pad6'],\\n  skill: ['KeyL', 'KeyE', 'Mouse2', 'Pad2', 'Pad5'], jump: ['KeyZ', 'Pad3'], ...MENU_KEYS\\n};\\n/** side-scrollers (Mario, Mega Man): Space / Z / K jump, X / J attack or shoot, Shift / C dash */\\nInput.PLATFORMER = {\\n  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\\n  jump: ['Space', 'KeyZ', 'KeyK', 'Pad0'], attack: ['KeyX', 'KeyJ', 'Mouse0', 'Pad2'], dash: ['ShiftLeft', 'ShiftRight', 'KeyC', 'KeyL', 'Pad1', 'Pad5'],\\n  skill: ['KeyE', 'KeyV', 'Mouse2', 'Pad3'], ...MENU_KEYS\\n};\\n1320→/** third-person action and stealth (Assassin's Creed, Metal Gear): WASD / stick move, Shift sprint, Space jump and parkour,\\n *  C crouch (a toggle), E interact, J attack, K block, L dodge, Q use, M map. Pad: A jump, B crouch, X attack, Y interact,\\n *  LB block, RB dodge, LT use, RT or L3 sprint, Back map */\\nInput.THIRDPERSON = {\\n  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\\n  sprint: ['ShiftLeft', 'ShiftRight', 'Pad7', 'Pad10'], jump: ['Space', 'Pad0'], crouch: ['KeyC', 'ControlLeft', 'Pad1'], interact: ['KeyE', 'KeyF', 'Pad3'],\\n  attack: ['KeyJ', 'Mouse0', 'Pad2'], block: ['KeyK', 'Mouse2', 'Pad4'], dodge: ['KeyL', 'Pad5'], use: ['KeyQ', 'Pad6'], map: ['KeyM', 'Tab', 'Pad8'], ...MENU_KEYS\\n};\\n/** shoot-'em-ups (1942, Gradius): Space / Z / J fire (hold for autofire), X / K bomb */\\nInput.SHMUP = {\\n1330→  up: ['KeyW', 'ArrowUp', 'Pad12'], down: ['KeyS', 'ArrowDown', 'Pad13'], left: ['KeyA', 'ArrowLeft', 'Pad14'], right: ['KeyD', 'ArrowRight', 'Pad15'],\\n  fire: ['Space', 'KeyZ', 'KeyJ', 'Mouse0', 'Pad0', 'Pad7'], bomb: ['KeyX', 'KeyK', 'Mouse2', 'Pad1', 'Pad6'], ...MENU_KEYS\\n};\\nE.Input = Input;\\n\\n/* =============================================================================\\n * 6. PIXEL FONTS  the 5x7 text font (the default) and the 3x5 one for in-world numbers and labels\\n * ============================================================================= */\\n// Both fonts are tables of glyphs: each entry a character, then one digit for each row of its pixels, top to bottom, the\\n// row's pixels being the digit's bits from the left. The 3x5 ('tiny', upper case, for in-world numbers and labels): five\\n1340→// octal digits, so '075557' is 0 drawn as 7 = ###, 5 = #.#, #.#, #.#, ###. The 5x7 ('normal', the default): its width,\\n// then a base-32 digit a row (0-9 then a-v, 5 bits), seven above the baseline and up to two below, so 'A5ehhvhhh' is A,\\n// 5 wide, e = .###., h = #...#, h, v = #####, h, h, h. The 5x7 is proportional with lower case and descenders; beside\\n// ASCII it draws every symbol input.label() returns (✕ ○ □ △ and the arrows), ✓ ✗ · • … – — ° ² ³ × € £ ¢ ¡ ¿ ’ “ ”,\\n// ▲ ▼ ◀ ▶ ◂ ▸ ● ■ ★ ♥ ♪ © and the accented letters of the Latin alphabets (é à ç ñ ü ö ß ..., a capital five rows tall\\n// under its accent); any other character draws as ?. It is the agent edition's table. To see glyphs as rows of # and .:\\n// node tools/font.mjs <characters> [--tiny]\\nconst GLYPHS = \\\"075557 126227 271747 371717 455711 574717 674757 771222 875757 975717 A25755 B65656 C34443 D65556 E74647 F74644 G34553 H55755 I72227 J11152 K55655 L44447 M57755 N65555 O25552 P65644 Q25563 R65655 S34216 T72222 U55557 V55552 W55775 X55255 Y55222 Z71247 +02720 -00700 !22202 .00002 :02020 /11244 x05250 ?71202 ,00024 '22000 \\\