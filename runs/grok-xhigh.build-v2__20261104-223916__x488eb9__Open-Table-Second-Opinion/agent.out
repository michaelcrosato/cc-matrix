,115,116,32,40,84,65,83,75,46,109,100,44,32,108,105,110,101,32,98,121,32,108,105,110,101,41,10,49,48,57,48,58,35,35,32,65,112,112,101,110,100,105,120,32,65,58,32,116,105,115,115,117,101,32,112,97,105,110,116,101,114,10,49,49,52,54,58,35,35,32,65,112,112,101,110,100,105,120,32,66,58,32,97,32,115,105,116,101,32,114,101,99,105,112,101,10,49,49,54,55,58,35,35,32,65,112,112,101,110,100,105,120,32,67,58,32,112,111,114,116,114,97,105,116,32,112,97,105,110,116,101,114,10,49,50,51,54,58,35,35,32,65,112,112,101,110,100,105,120,32,68,58,32,72,117,98,32,115,107,101,108,101,116,111,110,44,32,112,97,103,101,32,104,101,97,100,32,97,110,100,32,104,97,114,110,101,115,115,32,114,117,110,110,101,114,10,49,51,50,49,58,35,35,32,65,112,112,101,110,100,105,120,32,69,58,32,103,97,109,101,112,97,100,32,115,116,117,98,32,97,110,100,32,116,111,117,99,104,45,110,111,116,105,99,101,32,112,97,116,99,104,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":29,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/PLAN.md\",\"matches\":[{\"line_number\":5,\"content\":\"## Contents\"},{\"line_number\":38,\"content\":\"## 0. How to use this plan\"},{\"line_number\":49,\"content\":\"## 1. The game on one page\"},{\"line_number\":81,\"content\":\"## 2. Direction decisions\"},{\"line_number\":102,\"content\":\"## 3. Verified engine and Hub facts\"},{\"line_number\":134,\"content\":\"## 4. Game flow\"},{\"line_number\":159,\"content\":\"## 5. The operation\"},{\"line_number\":316,\"content\":\"## 6. Controls and prompts\"},{\"line_number\":357,\"content\":\"## 7. Things on the table\"},{\"line_number\":382,\"content\":\"## 8. HUSH: the strains\"},{\"line_number\":425,\"content\":\"## 9. The cases\"},{\"line_number\":522,\"content\":\"## 10. Story bible\"},{\"line_number\":603,\"content\":\"## 11. The ward\"},{\"line_number\":616,\"content\":\"## 12. Multiplayer: Grand Rounds\"},{\"