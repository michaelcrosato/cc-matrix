 st = S.strain;\\n    if (!st || !st.domes) return false;\\n    for (let i = 0; i < st.domes.length; i++) {\\n      const d = st.domes[i];\\n      if (d.t > 0 && hypot(x - d.x, y - d.y) <= d.r) return true;\\n    }\\n    return false;\\n  }\\n\\n  function covered(S, o) {\\n    if (!o.under) return false;\\n    const p = objById(S, o.under);\\n    return !!(p && !p.done && p.vol > 1);\\n  }\\n\\n  function canTouch(S, o) {\\n    if (!o || o.done || !o.alive) return false;\\n    if (covered(S, o)) return false;\\n    if (o.hidden && !o.marked) return false;\\n    if (o.needsWindow && S.windowOpen <= 0) return false;\\n    if (o.type === 'reed' || o.type === 'voice') return !!o.window;\\n    if (o.type === 'lobe') return !!o.open;\\n    if (o.type === 'eye') return !!o.open;\\n    if (o.type === 'repeat') return !!o.open;\\n    return true;\\n  }\\n\\n  function nearest(S, p, rad, pred) {\\n    let best = null, bd = rad;\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n      if (!pred(o)) continue;\\n      const d = hypot(o.x - p.x, o.y - p.y);\\n      if (d <= bd) { bd = d; best = o; }\\n    }\\n    return best;\\n  }\\n\\n  function lose(S, why) {\\n    if (S.lost || S.won) return;\\n    S.lost = true;\\n    S.reason = why;\\n    S.breath = false;\\n    S.worldScale = 1;\\n    pushEv(S, ['lost', why]);\\n  }\\n\\n  function finishCase(S) {\\n    if (S.won || S.lost) return;\\n    S.won = true;\\n    S.closed = true;\\n    S.breath = false;\\n    S.worldScale = 1;\\n    const end = Math.max(0, S.clock) * 2 + Math.max(0, S.vitals) * 3;\\n    S.score += end;\\n    S.endBonus = end;\\n    S.rank = rankLetter(S.score, S.par, S.diff, S.slips, S.rankCap);\\n    pushEv(S, ['closed', S.rank, Math.round(S.score)]);\\n  }\\n\\n  function rankLetter(score, par, diff, slips, cap) {\\n    const r = par > 0 ? score / par : 0;\\n    let L = r >= 0.95 ? 'S' : r >= 0.8 ? 'A' : r >= 0.6 ? 'B' : r >= 0.4 ? 'C' : 'D';\\n    const order = 'DCBAS';\\n    if (cap === 'B' && order.indexOf(L) > order.indexOf('B')) L = 'B';\\n    if (diff === 'attending' && L === 'S' && !slips) return 'S+';\\n    return L;\\n  }\\n\\n  function takeCore(S) {\\n    return {\\n      rng: S.rng, clock: S.clock, vitals: S.vitals, score: S.score, slips: S.slips,\\n      phase: S.phase, steady: S.steady, flow: S.flow, streak: S.streak,\\n      phaseT: S.phaseT, worldT: S.worldT, flags: clone(S.flags),\\n      objects: clone(S.objects), strain: S.strain ? clone(S.strain) : null,\\n      device: S.device ? clone(S.device) : null,\\n      techGood: S.techGood, techAll: S.techAll, bestFlow: S.bestFlow,\\n      codeBlueUsed: S.codeBlueUsed, tutDone: S.tutDone, tutorial: S.tutorial,\\n      windowOpen: S.windowOpen, tiltAmp: S.tiltAmp, dim: S.dim,\\n    };\\n  }\\n\\n  function applyCore(S, core) {\\n    S.rng = core.rng; S.clock = core.clock; S.vitals = core.vitals; S.score = core.score;\\n    S.slips = core.slips; S.phase = core.phase; S.steady = core.steady; S.flow = core.flow;\\n\",\"total_lines\":1684}}","is_error":false},{"type":"tool_result","tool_use_id":"call-e88b2744-9d18-489b-9aba-539ca13bcbe9-6","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"380→      if (o.type !== 'nerve' && o.type !== 'eloquent') continue;\\n      const pts = o.guide || [[o.x - 20, o.y], [o.x + 20, o.y]];\\n      if (polyDist(pts, p.x, p.y).d < 6) { slip(S, p, 'nerve', 12, tune); return true; }\\n    }\\n    return false;\\n  }\\n\\n  function gradeMean(mean, a, b) {\\n    if (mean <= a) return 'textbook';\\n    if (mean <= b) return 'clean';\\n390→    return 'sloppy';\\n  }\\n\\n  function stepForceps(S, p, dt, tune) {\\n    const down = p.trig > 0.3;\\n    let held = p.held ? objById(S, p.held) : null;\\n    if (p.trigEdge && !held) {\\n      const o = nearest(S, p, 12, o => canTouch(S, o) && (o.type === 'shard' || o.type === 'fragment' || o.type === 'cork' || o.type === 'hook' || o.type === 'gaff' || o.type === 'clot' || o.type === 'mass' || o.type === 'nest' || o.type === 'note' || o.type === 'retractor' || o.type === 'screw' || (o.type === 'lobe' && o.mode === 'forceps')));\\n      if (o && o.type === 'clot' && !o.dosed) { /* no grip yet */ }\\n      else if (o && (o.type === 'hook' || o.type === 'gaff') && o.barbs) { slip(S, p, 'tear', 4, tune); o.tears = (o.tears || 0) + 1; }\\n400→      else if (o && o.type === 'mass' && !o.cut) { /* ring first */ }\\n      else if (o && o.type === 'nest' && !o.cut) { /* slash first */ }\\n      else if (o && o.type === 'screw') { p.held = o.id; o.lastAng = Math.atan2(p.y - o.y, p.x - o.x); o.spin = o.spin || 0; }\\n      else if (o && o.type === 'retractor') { p.held = o.id; }\\n      else if (o) {\\n        p.held = o.id; o.t0 = o.t0 || 0; o.pullT = o.pullT || 0; o.gripped = true;\\n        if (!o.origin) o.origin = [o.x, o.y];\\n        pushEv(S, ['grip', o.id]);\\n      }\\n    }\\n410→    held = p.held ? objById(S, p.held) : null;\\n    if (held && down) {\\n      if (held.type === 'retractor') {\\n        held.x = p.x; held.y = p.y;\\n        S.windowOpen = 1;\\n        return;\\n      }\\n      if (held.type === 'screw') {\\n        const ang = Math.atan2(p.y - held.y, p.x - held.x);\\n        let d = ang - (held.lastAng || ang);\\n420→        while (d > Math.PI) d -= TAU;\\n        while (d < -Math.PI) d += TAU;\\n        held.spin = (held.spin || 0) + Math.abs(d);\\n        held.lastAng = ang;\\n        if (held.spin >= 3 * TAU) {\\n          held.done = true; held.alive = false; p.held = 0;\\n          award(S, p, 'textbook', 100, tune);\\n          pushEv(S, ['screw', held.id]);\\n        }\\n        return;\\n430→      }\\n      const ox = held.origin[0], oy = held.origin[1];\\n      const dx = p.x - ox, dy = p.y - oy;\\n      const along = dx * held.axis[0] + dy * held.axis[1];\\n      const px = dx - along * held.axis[0], py = dy - along * held.axis[1];\\n      const perp = hypot(px, py);\\n      const limit = held.tension || 120;\\n      if (!held.free) {\\n        if (p.inst > limit || perp > 8) {\\n          if (held.type === 'note' || (S.strain && S.strain.kind === 'legato' && held.tag === 'legato-head')) {\\n440→            held.snapped = true;\\n            slip(S, p, 'snap', 4, tune);\\n            pushEv(S, ['snap', held.id]);\\n          } else {\\n            held.tears = (held.tears || 0) + 1;\\n            held.prog = Math.max(0, (held.prog || 0) - held.depth * 0.3);\\n            slip(S, p, 'tear', 4, tune);\\n            pushEv(S, ['tear', held.id]);\\n          }\\n        }\\n450→        held.prog = Math.max(held.prog || 0, along);\\n        held.pullT = (held.pullT || 0) + dt;\\n        if (along >= held.depth) {\\n          held.free = true;\\n          pushEv(S, ['free', held.id]);\\n        }\\n      } else {\\n        held.x = p.x; held.y = p.y;\\n        held.pullT = (held.pullT || 0) + dt;\\n      }\\n460→    }\\n    if (held && p.trigRelease) {\\n      if (held.type === 'retractor') { p.held = 0; return; }\\n      if (held.type === 'screw') { p.held = 0; return; }\\n      const d0 = hypot(p.x - held.origin[0], p.y - held.origin[1]);\\n      if (held.holdZone && hypot(p.x - held.holdZone[0], p.y - held.holdZone[1]) <= (held.holdZone[2] || 14)) {\\n        held.clamped = true; held.gripped = false; p.held = 0;\\n        pushEv(S, ['clamp', held.id]);\\n        return;\\n      }\\n470→      if (held.free && (d0 >= 24 || outside(p.x, p.y))) {\\n        const tears = held.tears || 0;\\n        const parT = held.parTime || (held.depth / 80 + 0.35);\\n        let g = 'sloppy';\\n        if (!tears && (held.pullT || 0) <= parT) g = 'textbook';\\n        else if (tears <= 1) g = 'clean';\\n        held.done = true; held.alive = false; held.grade = g; p.held = 0;\\n        if (held.type === 'note') p.score += 0;\\n        award(S, p, g, 120, tune);\\n        pushEv(S, ['dish', held.id, g]);\\n480→      } else {\\n        held.gripped = false;\\n        p.held = 0;\\n      }\\n    }\\n  }\\n\\n  function outside(x, y) {\\n    const nx = (x - CFG.CX) / CFG.RX, ny = (y - CFG.CY) / CFG.RY;\\n    return nx * nx + ny * ny > 1;\\n490→  }\\n\\n  function stepScalpel(S, p, dt, tune) {\\n    const down = p.trig > 0.3;\\n    const tol = tune.hands.grade;\\n    if (p.stroke && p.stroke.kind === 'scalpel') {\\n      const o = objById(S, p.stroke.id);\\n      if (!o || o.done) { p.stroke = null; }\\n    }\\n    if (p.trigEdge && !p.stroke) {\\n500→      const o = nearest(S, p, 8, o => canTouch(S, o) && o.guide && (o.type === 'mass' || o.type === 'slur' || o.type === 'tendril' || o.type === 'spiral' || o.type === 'wire' || o.type === 'repeat' || o.type === 'lobe' || o.type === 'cut' || o.type === 'nest'));\\n      if (o && o.guide) {\\n        const start = o.guide[0];\\n        if (hypot(p.x - start[0], p.y - start[1]) <= 8 + (p.mouse ? 1 : 0)) {\\n          p.stroke = { kind: 'scalpel', id: o.id, far: 0, sum: 0, n: 0, off: 0, slipped: false };\\n          o.cutting = true;\\n        }\\n      }\\n    }\\n    if (!(p.stroke && p.stroke.kind === 'scalpel') && down && p.inst > 40) {\\n510→      const onGuide = S.objects.some(o => o.guide && !o.done && polyDist(o.guide, p.x, p.y).d < 8);\\n      if (!onGuide && !outside(p.x, p.y)) {\\n        p.bare = (p.bare || 0) + hypot(p.x - (p.ox || p.x), p.y - (p.oy || p.y));\\n        if (p.bare >= 6) { slip(S, p, 'healthy', 3, tune); p.bare = 0; }\\n      }\\n    }\\n    if (p.stroke && p.stroke.kind === 'scalpel' && down) {\\n      const o = objById(S, p.stroke.id);\\n      if (o && nerveHit(S, p, tune)) { /* counted */ }\\n      if (o && o.guide) {\\n520→        const hit = polyDist(o.guide, p.x, p.y);\\n        const st = p.stroke;\\n        if (hit.along > st.far) st.far = hit.along;\\n        st.sum += hit.d; st.n += 1;\\n        if (hit.d > 9) st.off += dt; else st.off = 0;\\n        if (st.off >= 0.12 && !st.slipped) {\\n          st.slipped = true; slip(S, p, 'slip', 3, tune);\\n          pushEv(S, ['slipcut', o.id]);\\n        }\\n        o.prog = st.far / (hit.total || 1);\\n530→        if (o.type === 'spiral' && o.beatLock && S.flags.onBeat) {\\n          if (!st.beatSlip) { st.beatSlip = true; slip(S, p, 'beat', 3, tune); }\\n          o.prog = Math.min(o.prog, st.safe || 0);\\n        } else if (o.type === 'spiral') st.safe = o.prog;\\n        if (st.far >= (hit.total || 1) - 0.5) {\\n          const mean = st.n ? st.sum / st.n : 99;\\n          const g = st.slipped ? 'sloppy' : gradeMean(mean, 1.8 * tol, 4 * tol);\\n          o.done = true; o.alive = false; o.grade = g; o.cut = true;\\n          if (o.type === 'mass') { o.done = false; o.alive = true; o.cut = true; o.type = 'mass'; }\\n          if (o.type === 'nest') { o.done = false; o.alive = true; o.cut = true; }\\n540→          if (o.type === 'wire') { /* caller checks order */ wireCut(S, p, o, tune); }\\n          else award(S, p, g, 110, tune);\\n          p.stroke = null;\\n          pushEv(S, ['cut', o.id, g]);\\n        }\\n      }\\n    }\\n    if (p.trigRelease && p.stroke && p.stroke.kind === 'scalpel') {\\n      const o = objById(S, p.stroke.id);\\n      if (o && o.prog < 0.98) {\\n550→        /* resume later if they come back within 6 */\\n        p.stroke.paused = true;\\n      }\\n    }\\n    if (p.trigEdge && p.stroke && p.stroke.paused) {\\n      const o = objById(S, p.stroke.id);\\n      if (o && o.guide) {\\n        const hit = polyDist(o.guide, p.x, p.y);\\n        if (Math.abs(hit.along - p.stroke.far) <= 6 || hit.d <= 6) p.stroke.paused = false;\\n        else p.stroke = null;\\n560→      }\\n    }\\n    /* slash variant: a fast stroke across a slash target */\\n    if (down && p.inst >= 60) {\\n      const o = nearest(S, p, 10, q => canTouch(S, q) && q.slash && !q.done);\\n      if (o) {\\n        o.done = true; o.alive = false; o.cut = true;\\n        award(S, p, 'clean', 100, tune);\\n        pushEv(S, ['slash', o.id]);\\n      }\\n570→    }\\n  }\\n\\n  function wireCut(S, p, o, tune) {\\n    const dev = S.device;\\n    if (!dev) { o.done = true; award(S, p, 'clean', 80, tune); return; }\\n    const want = dev.order[dev.next];\\n    if (o.tag === want) {\\n      dev.next += 1; o.done = true; o.alive = false;\\n      award(S, p, 'textbook', 100, tune);\\n580→      if (dev.next >= dev.order.length) dev.done = true;\\n    } else {\\n      o.done = false; o.alive = true; o.prog = 0; o.cutting = false;\\n      S.vitals -= 30; S.clock = Math.max(0, S.clock - 30);\\n      slip(S, p, 'wire', 0, tune);\\n      pushEv(S, ['badwire', o.tag]);\\n    }\\n  }\\n\\n  function stepSuture(S, p, dt, tune) {\\n590→    const down = p.trig > 0.3;\\n    const extra = (S.activeDoc === 'sokolova' ? 1 : 0);\\n    if (p.trigEdge) {\\n      const o = nearest(S, p, 9 + extra, q => canTouch(S, q) && q.pairs && (q.stitch || 0) < q.pairs.length);\\n      if (o) {\\n        const a = o.pairs[o.stitch][0];\\n        if (hypot(p.x - a[0], p.y - a[1]) <= 9 + extra) {\\n          p.stroke = { kind: 'suture', id: o.id, i: o.stitch, t: 0 };\\n          pushEv(S, ['needle', o.id, o.stitch]);\\n        }\\n600→      }\\n    }\\n    if (p.stroke && p.stroke.kind === 'suture' && down) p.stroke.t += dt;\\n    if (p.stroke && p.stroke.kind === 'suture' && p.trigRelease) {\\n      const o = objById(S, p.stroke.id);\\n      const st = p.stroke;\\n      p.stroke = null;\\n      if (!o || o.done) return;\\n      const b = o.pairs[st.i][1];\\n      const tol = 6 + extra + (p.mouse ? 1 : 0);\\n610→      if (hypot(p.x - b[0], p.y - b[1]) <= tol) {\\n        const g = gradeMean(st.t, 0.6, 1.2);\\n        o.grades = o.grades || [];\\n        o.grades.push(g === 'textbook' ? 2 : g === 'clean' ? 1 : 0);\\n        o.times = o.times || [];\\n        o.times.push(st.t);\\n        o.stitch = st.i + 1;\\n        o.prog = o.stitch / o.pairs.length;\\n        p.stitches += 1;\\n        const bleedLeft = 1 - o.prog;\\n620→        if (o.type === 'arteryTear') o.drain = 1 * bleedLeft;\\n        else if (o.type === 'wound') o.drain = 0.4 * bleedLeft;\\n        pushEv(S, ['stitch', Math.round(b[0]), Math.round(b[1]), g]);\\n        if (o.stitch >= o.pairs.length) {\\n          const meanT = o.times.reduce((a, c) => a + c, 0) / o.times.length;\\n          const fg = gradeMean(meanT, 0.6, 1.2);\\n          o.done = true; o.alive = false; o.grade = fg; o.drain = 0;\\n          award(S, p, fg, 80 + 20 * o.pairs.length, tune);\\n        }\\n      } else {\\n630→        slip(S, p, 'loose', 1, tune);\\n        pushEv(S, ['loose', o.id]);\\n      }\\n    }\\n  }\\n\\n  function stepSalve(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    let any = false;\\n    for (let i = 0; i < S.objects.length; i++) {\\n640→      const o = S.objects[i];\\n      if (!canTouch(S, o) || !o.cells) continue;\\n      if (!(o.type === 'laceration' || o.type === 'patch' || o.type === 'bite' || (o.type === 'lobe' && o.mode === 'salve'))) continue;\\n      for (let c = 0; c < o.cells.length; c++) {\\n        const cell = o.cells[c];\\n        if (!cell[2] && hypot(cell[0] - p.x, cell[1] - p.y) <= 10) { cell[2] = 1; any = true; }\\n      }\\n      let on = 0;\\n      for (let c = 0; c < o.cells.length; c++) if (o.cells[c][2]) on++;\\n      o.prog = o.cells.length ? on / o.cells.length : 1;\\n650→      if (o.prog >= 0.9 && !o.done) {\\n        o.done = true; o.alive = false; o.drain = 0;\\n        S.vitals = Math.min(99, S.vitals + 2 * tune.patient.healing);\\n        award(S, p, 'clean', 80, tune);\\n        pushEv(S, ['heal', o.id]);\\n      }\\n    }\\n    if (!any && p.trigEdge) { /* salve cannot harm */ }\\n  }\\n\\n660→  function stepSyringe(S, p, dt, tune) {\\n    if (p.cool > 0) p.cool -= dt;\\n    const down = p.trig > 0.3;\\n    if (down && p.cool <= 0) {\\n      if (p.fill < 1) p.fill = Math.min(1, p.fill + dt / 0.55);\\n      else p.over += dt;\\n    }\\n    if (p.trigRelease && p.fill > 0.05 && p.cool <= 0) {\\n      const bubble = p.over >= 0.3;\\n      const tgt = nearest(S, p, 10, o => canTouch(S, o) && (o.type === 'clot' || o.type === 'reed' || o.type === 'voice' || (o.type === 'lobe' && o.mode === 'syringe')));\\n670→      if (tgt) {\\n        if ((tgt.type === 'reed' || tgt.type === 'voice') && !tgt.window) {\\n          addObj(S, { type: 'laceration', x: tgt.x + 6, y: tgt.y, r: 8, order: 50, drain: 0.2 });\\n          slip(S, p, 'spit', 2, tune);\\n        } else {\\n          const g = bubble ? 'sloppy' : (p.fill >= 0.9 ? 'textbook' : 'clean');\\n          tgt.dosed = true;\\n          tgt.dose = (bubble ? 0.5 : 1) * p.fill;\\n          if (tgt.type === 'clot') { /* forceps next */ tgt.drain = 0.1; }\\n          else { tgt.done = true; tgt.alive = false; tgt.drain = 0; }\\n680→          award(S, p, g, 90, tune);\\n          pushEv(S, ['inject', tgt.id, g]);\\n        }\\n      } else {\\n        const g = bubble ? 'sloppy' : (p.fill >= 0.9 ? 'textbook' : 'clean');\\n        const add = syringeDose(S, tune) * p.fill * (bubble ? 0.5 : 1);\\n        S.vitals = Math.min(99, S.vitals + add);\\n        award(S, p, g, 40, tune);\\n        pushEv(S, ['iv', Math.round(add), g]);\\n      }\\n690→      p.fill = 0; p.over = 0; p.cool = 0.35;\\n    }\\n    if (!down && p.trigRelease === false) { /* keep fill while aiming */ }\\n  }\\n\\n  function stepCautery(S, p, dt, tune) {\\n    if (p.lock > 0) { p.lock -= dt; p.heat = Math.max(0, p.heat - 0.6 * dt); return; }\\n    const down = p.trig > 0.3;\\n    if (!down) {\\n      p.heat = Math.max(0, p.heat - 0.6 * dt);\\n700→      p.bareT = 0;\\n      return;\\n    }\\n    p.heat += tune.fluids.cauteryHeat * dt;\\n    if (p.heat >= 1) { p.lock = 1.2; p.heat = 1; slip(S, p, 'lock', 1, tune); pushEv(S, ['lock', p.id]); return; }\\n    if (nerveHit(S, p, tune)) return;\\n    const tgt = nearest(S, p, 6, o => canTouch(S, o) && (o.type === 'polyp' || o.type === 'bleeder' || o.type === 'rupture' || o.type === 'bead' || o.type === 'uvula' || o.type === 'eye' || o.type === 'tremass' || (o.type === 'lobe' && o.mode === 'cautery') || o.type === 'barb'));\\n    if (tgt) {\\n      p.bareT = 0;\\n      tgt.burn = (tgt.burn || 0) + dt;\\n710→      tgt.prog = tgt.burn / (tgt.need || 0.5);\\n      if (tgt.burn >= (tgt.need || 0.5) / Math.max(0.25, tune.strains.health) && !tgt.done) {\\n        const dirty = tgt.charred || p.lockedDuring;\\n        const g = (!tgt.charred && p.lock <= 0 && !p.hadLock) ? 'textbook' : 'clean';\\n        tgt.done = true; tgt.alive = false; tgt.drain = 0; tgt.grade = g;\\n        p.burned += 1;\\n        award(S, p, g, 90, tune);\\n        pushEv(S, ['burn', tgt.id, g]);\\n      }\\n    } else {\\n720→      p.bareT = (p.bareT || 0) + dt;\\n      if (p.bareT >= 0.25) {\\n        /* char on the field */\\n        p.charT = (p.charT || 0) + dt;\\n        S.vitals -= 0.8 * dt * tune.patient.slip;\\n        if (p.bareT >= 0.6 && !p.charSlip) { p.charSlip = true; slip(S, p, 'char', 2, tune); pushEv(S, ['char', Math.round(p.x), Math.round(p.y)]); }\\n      }\\n    }\\n  }\\n\\n730→  function stepSuction(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    const pool = nearest(S, p, 14, o => o.type === 'pool' && !o.done && o.vol > 0);\\n    if (!pool) return;\\n    const rate = tune.fluids.suction;\\n    const before = pool.vol;\\n    pool.vol = Math.max(0, pool.vol - rate * dt);\\n    p.suctioned += before - pool.vol;\\n    pool.prog = 1 - pool.vol / (pool.max || 1);\\n    if (pool.vol <= 0.2) { pool.done = true; pool.alive = false; pool.vol = 0; pushEv(S, ['dry', pool.id]); }\\n740→  }\\n\\n  function stepSonar(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    let rad = 38;\\n    if (S.activeDoc === 'vale' || S.gift === 'breath') rad *= 1.25;\\n    if (S.gift === 'both' && S.activeDoc === 'vale') rad *= 1.25;\\n    p.sonarR = rad;\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n750→      if (!o.hidden || o.done) continue;\\n      if (hypot(o.x - p.x, o.y - p.y) <= rad) { o.marked = true; o.markT = 4; pushEv(S, ['mark', o.id]); }\\n    }\\n    if (S.device && !S.device.shown && hypot(p.x - (S.device.x || 213), p.y - (S.device.y || 116)) <= rad) {\\n      S.device.shown = true;\\n      pushEv(S, ['board', 1]);\\n    }\\n    if (S.strain && S.strain.kind === 'legato') {\\n      for (const w of S.strain.worms || []) if (hypot(w.x - p.x, w.y - p.y) <= rad) w.marked = true;\\n    }\\n760→  }\\n\\n  function applyTools(S, p, dt, tune) {\\n    if (p.gone) return;\\n    if (inDome(S, p.x, p.y)) return;\\n    if (p.swap > 0) p.swap -= dt;\\n    p.ox = p.x; p.oy = p.y;\\n    const tool = p.tool;\\n    if (tool === 'forceps') stepForceps(S, p, dt, tune);\\n    else if (tool === 'scalpel') stepScalpel(S, p, dt, tune);\\n770→    else if (tool === 'suture') stepSuture(S, p, dt, tune);\\n    else if (tool === 'salve') stepSalve(S, p, dt, tune);\\n    else if (tool === 'syringe') stepSyringe(S, p, dt, tune);\\n    else if (tool === 'cautery') stepCautery(S, p, dt, tune);\\n    else if (tool === 'suction') stepSuction(S, p, dt, tune);\\n    else if (tool === 'sonar') stepSonar(S, p, dt, tune);\\n    /* marks expire */\\n  }\\n\\n  /* ---------- strains ---------- */\",\"content_concise\":\"380→      if (o.type !== 'nerve' && o.type !== 'eloquent') continue;\\n      const pts = o.guide || [[o.x - 20, o.y], [o.x + 20, o.y]];\\n      if (polyDist(pts, p.x, p.y).d < 6) { slip(S, p, 'nerve', 12, tune); return true; }\\n    }\\n    return false;\\n  }\\n\\n  function gradeMean(mean, a, b) {\\n    if (mean <= a) return 'textbook';\\n    if (mean <= b) return 'clean';\\n390→    return 'sloppy';\\n  }\\n\\n  function stepForceps(S, p, dt, tune) {\\n    const down = p.trig > 0.3;\\n    let held = p.held ? objById(S, p.held) : null;\\n    if (p.trigEdge && !held) {\\n      const o = nearest(S, p, 12, o => canTouch(S, o) && (o.type === 'shard' || o.type === 'fragment' || o.type === 'cork' || o.type === 'hook' || o.type === 'gaff' || o.type === 'clot' || o.type === 'mass' || o.type === 'nest' || o.type === 'note' || o.type === 'retractor' || o.type === 'screw' || (o.type === 'lobe' && o.mode === 'forceps')));\\n      if (o && o.type === 'clot' && !o.dosed) { /* no grip yet */ }\\n      else if (o && (o.type === 'hook' || o.type === 'gaff') && o.barbs) { slip(S, p, 'tear', 4, tune); o.tears = (o.tears || 0) + 1; }\\n400→      else if (o && o.type === 'mass' && !o.cut) { /* ring first */ }\\n      else if (o && o.type === 'nest' && !o.cut) { /* slash first */ }\\n      else if (o && o.type === 'screw') { p.held = o.id; o.lastAng = Math.atan2(p.y - o.y, p.x - o.x); o.spin = o.spin || 0; }\\n      else if (o && o.type === 'retractor') { p.held = o.id; }\\n      else if (o) {\\n        p.held = o.id; o.t0 = o.t0 || 0; o.pullT = o.pullT || 0; o.gripped = true;\\n        if (!o.origin) o.origin = [o.x, o.y];\\n        pushEv(S, ['grip', o.id]);\\n      }\\n    }\\n410→    held = p.held ? objById(S, p.held) : null;\\n    if (held && down) {\\n      if (held.type === 'retractor') {\\n        held.x = p.x; held.y = p.y;\\n        S.windowOpen = 1;\\n        return;\\n      }\\n      if (held.type === 'screw') {\\n        const ang = Math.atan2(p.y - held.y, p.x - held.x);\\n        let d = ang - (held.lastAng || ang);\\n420→        while (d > Math.PI) d -= TAU;\\n        while (d < -Math.PI) d += TAU;\\n        held.spin = (held.spin || 0) + Math.abs(d);\\n        held.lastAng = ang;\\n        if (held.spin >= 3 * TAU) {\\n          held.done = true; held.alive = false; p.held = 0;\\n          award(S, p, 'textbook', 100, tune);\\n          pushEv(S, ['screw', held.id]);\\n        }\\n        return;\\n430→      }\\n      const ox = held.origin[0], oy = held.origin[1];\\n      const dx = p.x - ox, dy = p.y - oy;\\n      const along = dx * held.axis[0] + dy * held.axis[1];\\n      const px = dx - along * held.axis[0], py = dy - along * held.axis[1];\\n      const perp = hypot(px, py);\\n      const limit = held.tension || 120;\\n      if (!held.free) {\\n        if (p.inst > limit || perp > 8) {\\n          if (held.type === 'note' || (S.strain && S.strain.kind === 'legato' && held.tag === 'legato-head')) {\\n440→            held.snapped = true;\\n            slip(S, p, 'snap', 4, tune);\\n            pushEv(S, ['snap', held.id]);\\n          } else {\\n            held.tears = (held.tears || 0) + 1;\\n            held.prog = Math.max(0, (held.prog || 0) - held.depth * 0.3);\\n            slip(S, p, 'tear', 4, tune);\\n            pushEv(S, ['tear', held.id]);\\n          }\\n        }\\n450→        held.prog = Math.max(held.prog || 0, along);\\n        held.pullT = (held.pullT || 0) + dt;\\n        if (along >= held.depth) {\\n          held.free = true;\\n          pushEv(S, ['free', held.id]);\\n        }\\n      } else {\\n        held.x = p.x; held.y = p.y;\\n        held.pullT = (held.pullT || 0) + dt;\\n      }\\n460→    }\\n    if (held && p.trigRelease) {\\n      if (held.type === 'retractor') { p.held = 0; return; }\\n      if (held.type === 'screw') { p.held = 0; return; }\\n      const d0 = hypot(p.x - held.origin[0], p.y - held.origin[1]);\\n      if (held.holdZone && hypot(p.x - held.holdZone[0], p.y - held.holdZone[1]) <= (held.holdZone[2] || 14)) {\\n        held.clamped = true; held.gripped = false; p.held = 0;\\n        pushEv(S, ['clamp', held.id]);\\n        return;\\n      }\\n470→      if (held.free && (d0 >= 24 || outside(p.x, p.y))) {\\n        const tears = held.tears || 0;\\n        const parT = held.parTime || (held.depth / 80 + 0.35);\\n        let g = 'sloppy';\\n        if (!tears && (held.pullT || 0) <= parT) g = 'textbook';\\n        else if (tears <= 1) g = 'clean';\\n        held.done = true; held.alive = false; held.grade = g; p.held = 0;\\n        if (held.type === 'note') p.score += 0;\\n        award(S, p, g, 120, tune);\\n        pushEv(S, ['dish', held.id, g]);\\n480→      } else {\\n        held.gripped = false;\\n        p.held = 0;\\n      }\\n    }\\n  }\\n\\n  function outside(x, y) {\\n    const nx = (x - CFG.CX) / CFG.RX, ny = (y - CFG.CY) / CFG.RY;\\n    return nx * nx + ny * ny > 1;\\n490→  }\\n\\n  function stepScalpel(S, p, dt, tune) {\\n    const down = p.trig > 0.3;\\n    const tol = tune.hands.grade;\\n    if (p.stroke && p.stroke.kind === 'scalpel') {\\n      const o = objById(S, p.stroke.id);\\n      if (!o || o.done) { p.stroke = null; }\\n    }\\n    if (p.trigEdge && !p.stroke) {\\n500→      const o = nearest(S, p, 8, o => canTouch(S, o) && o.guide && (o.type === 'mass' || o.type === 'slur' || o.type === 'tendril' || o.type === 'spiral' || o.type === 'wire' || o.type === 'repeat' || o.type === 'lobe' || o.type === 'cut' || o.type === 'nest'));\\n      if (o && o.guide) {\\n        const start = o.guide[0];\\n        if (hypot(p.x - start[0], p.y - start[1]) <= 8 + (p.mouse ? 1 : 0)) {\\n          p.stroke = { kind: 'scalpel', id: o.id, far: 0, sum: 0, n: 0, off: 0, slipped: false };\\n          o.cutting = true;\\n        }\\n      }\\n    }\\n    if (!(p.stroke && p.stroke.kind === 'scalpel') && down && p.inst > 40) {\\n510→      const onGuide = S.objects.some(o => o.guide && !o.done && polyDist(o.guide, p.x, p.y).d < 8);\\n      if (!onGuide && !outside(p.x, p.y)) {\\n        p.bare = (p.bare || 0) + hypot(p.x - (p.ox || p.x), p.y - (p.oy || p.y));\\n        if (p.bare >= 6) { slip(S, p, 'healthy', 3, tune); p.bare = 0; }\\n      }\\n    }\\n    if (p.stroke && p.stroke.kind === 'scalpel' && down) {\\n      const o = objById(S, p.stroke.id);\\n      if (o && nerveHit(S, p, tune)) { /* counted */ }\\n      if (o && o.guide) {\\n520→        const hit = polyDist(o.guide, p.x, p.y);\\n        const st = p.stroke;\\n        if (hit.along > st.far) st.far = hit.along;\\n        st.sum += hit.d; st.n += 1;\\n        if (hit.d > 9) st.off += dt; else st.off = 0;\\n        if (st.off >= 0.12 && !st.slipped) {\\n          st.slipped = true; slip(S, p, 'slip', 3, tune);\\n          pushEv(S, ['slipcut', o.id]);\\n        }\\n        o.prog = st.far / (hit.total || 1);\\n530→        if (o.type === 'spiral' && o.beatLock && S.flags.onBeat) {\\n          if (!st.beatSlip) { st.beatSlip = true; slip(S, p, 'beat', 3, tune); }\\n          o.prog = Math.min(o.prog, st.safe || 0);\\n        } else if (o.type === 'spiral') st.safe = o.prog;\\n        if (st.far >= (hit.total || 1) - 0.5) {\\n          const mean = st.n ? st.sum / st.n : 99;\\n          const g = st.slipped ? 'sloppy' : gradeMean(mean, 1.8 * tol, 4 * tol);\\n          o.done = true; o.alive = false; o.grade = g; o.cut = true;\\n          if (o.type === 'mass') { o.done = false; o.alive = true; o.cut = true; o.type = 'mass'; }\\n          if (o.type === 'nest') { o.done = false; o.alive = true; o.cut = true; }\\n540→          if (o.type === 'wire') { /* caller checks order */ wireCut(S, p, o, tune); }\\n          else award(S, p, g, 110, tune);\\n          p.stroke = null;\\n          pushEv(S, ['cut', o.id, g]);\\n        }\\n      }\\n    }\\n    if (p.trigRelease && p.stroke && p.stroke.kind === 'scalpel') {\\n      const o = objById(S, p.stroke.id);\\n      if (o && o.prog < 0.98) {\\n550→        /* resume later if they come back within 6 */\\n        p.stroke.paused = true;\\n      }\\n    }\\n    if (p.trigEdge && p.stroke && p.stroke.paused) {\\n      const o = objById(S, p.stroke.id);\\n      if (o && o.guide) {\\n        const hit = polyDist(o.guide, p.x, p.y);\\n        if (Math.abs(hit.along - p.stroke.far) <= 6 || hit.d <= 6) p.stroke.paused = false;\\n        else p.stroke = null;\\n560→      }\\n    }\\n    /* slash variant: a fast stroke across a slash target */\\n    if (down && p.inst >= 60) {\\n      const o = nearest(S, p, 10, q => canTouch(S, q) && q.slash && !q.done);\\n      if (o) {\\n        o.done = true; o.alive = false; o.cut = true;\\n        award(S, p, 'clean', 100, tune);\\n        pushEv(S, ['slash', o.id]);\\n      }\\n570→    }\\n  }\\n\\n  function wireCut(S, p, o, tune) {\\n    const dev = S.device;\\n    if (!dev) { o.done = true; award(S, p, 'clean', 80, tune); return; }\\n    const want = dev.order[dev.next];\\n    if (o.tag === want) {\\n      dev.next += 1; o.done = true; o.alive = false;\\n      award(S, p, 'textbook', 100, tune);\\n580→      if (dev.next >= dev.order.length) dev.done = true;\\n    } else {\\n      o.done = false; o.alive = true; o.prog = 0; o.cutting = false;\\n      S.vitals -= 30; S.clock = Math.max(0, S.clock - 30);\\n      slip(S, p, 'wire', 0, tune);\\n      pushEv(S, ['badwire', o.tag]);\\n    }\\n  }\\n\\n  function stepSuture(S, p, dt, tune) {\\n590→    const down = p.trig > 0.3;\\n    const extra = (S.activeDoc === 'sokolova' ? 1 : 0);\\n    if (p.trigEdge) {\\n      const o = nearest(S, p, 9 + extra, q => canTouch(S, q) && q.pairs && (q.stitch || 0) < q.pairs.length);\\n      if (o) {\\n        const a = o.pairs[o.stitch][0];\\n        if (hypot(p.x - a[0], p.y - a[1]) <= 9 + extra) {\\n          p.stroke = { kind: 'suture', id: o.id, i: o.stitch, t: 0 };\\n          pushEv(S, ['needle', o.id, o.stitch]);\\n        }\\n600→      }\\n    }\\n    if (p.stroke && p.stroke.kind === 'suture' && down) p.stroke.t += dt;\\n    if (p.stroke && p.stroke.kind === 'suture' && p.trigRelease) {\\n      const o = objById(S, p.stroke.id);\\n      const st = p.stroke;\\n      p.stroke = null;\\n      if (!o || o.done) return;\\n      const b = o.pairs[st.i][1];\\n      const tol = 6 + extra + (p.mouse ? 1 : 0);\\n610→      if (hypot(p.x - b[0], p.y - b[1]) <= tol) {\\n        const g = gradeMean(st.t, 0.6, 1.2);\\n        o.grades = o.grades || [];\\n        o.grades.push(g === 'textbook' ? 2 : g === 'clean' ? 1 : 0);\\n        o.times = o.times || [];\\n        o.times.push(st.t);\\n        o.stitch = st.i + 1;\\n        o.prog = o.stitch / o.pairs.length;\\n        p.stitches += 1;\\n        const bleedLeft = 1 - o.prog;\\n620→        if (o.type === 'arteryTear') o.drain = 1 * bleedLeft;\\n        else if (o.type === 'wound') o.drain = 0.4 * bleedLeft;\\n        pushEv(S, ['stitch', Math.round(b[0]), Math.round(b[1]), g]);\\n        if (o.stitch >= o.pairs.length) {\\n          const meanT = o.times.reduce((a, c) => a + c, 0) / o.times.length;\\n          const fg = gradeMean(meanT, 0.6, 1.2);\\n          o.done = true; o.alive = false; o.grade = fg; o.drain = 0;\\n          award(S, p, fg, 80 + 20 * o.pairs.length, tune);\\n        }\\n      } else {\\n630→        slip(S, p, 'loose', 1, tune);\\n        pushEv(S, ['loose', o.id]);\\n      }\\n    }\\n  }\\n\\n  function stepSalve(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    let any = false;\\n    for (let i = 0; i < S.objects.length; i++) {\\n640→      const o = S.objects[i];\\n      if (!canTouch(S, o) || !o.cells) continue;\\n      if (!(o.type === 'laceration' || o.type === 'patch' || o.type === 'bite' || (o.type === 'lobe' && o.mode === 'salve'))) continue;\\n      for (let c = 0; c < o.cells.length; c++) {\\n        const cell = o.cells[c];\\n        if (!cell[2] && hypot(cell[0] - p.x, cell[1] - p.y) <= 10) { cell[2] = 1; any = true; }\\n      }\\n      let on = 0;\\n      for (let c = 0; c < o.cells.length; c++) if (o.cells[c][2]) on++;\\n      o.prog = o.cells.length ? on / o.cells.length : 1;\\n650→      if (o.prog >= 0.9 && !o.done) {\\n        o.done = true; o.alive = false; o.drain = 0;\\n        S.vitals = Math.min(99, S.vitals + 2 * tune.patient.healing);\\n        award(S, p, 'clean', 80, tune);\\n        pushEv(S, ['heal', o.id]);\\n      }\\n    }\\n    if (!any && p.trigEdge) { /* salve cannot harm */ }\\n  }\\n\\n660→  function stepSyringe(S, p, dt, tune) {\\n    if (p.cool > 0) p.cool -= dt;\\n    const down = p.trig > 0.3;\\n    if (down && p.cool <= 0) {\\n      if (p.fill < 1) p.fill = Math.min(1, p.fill + dt / 0.55);\\n      else p.over += dt;\\n    }\\n    if (p.trigRelease && p.fill > 0.05 && p.cool <= 0) {\\n      const bubble = p.over >= 0.3;\\n      const tgt = nearest(S, p, 10, o => canTouch(S, o) && (o.type === 'clot' || o.type === 'reed' || o.type === 'voice' || (o.type === 'lobe' && o.mode === 'syringe')));\\n670→      if (tgt) {\\n        if ((tgt.type === 'reed' || tgt.type === 'voice') && !tgt.window) {\\n          addObj(S, { type: 'laceration', x: tgt.x + 6, y: tgt.y, r: 8, order: 50, drain: 0.2 });\\n          slip(S, p, 'spit', 2, tune);\\n        } else {\\n          const g = bubble ? 'sloppy' : (p.fill >= 0.9 ? 'textbook' : 'clean');\\n          tgt.dosed = true;\\n          tgt.dose = (bubble ? 0.5 : 1) * p.fill;\\n          if (tgt.type === 'clot') { /* forceps next */ tgt.drain = 0.1; }\\n          else { tgt.done = true; tgt.alive = false; tgt.drain = 0; }\\n680→          award(S, p, g, 90, tune);\\n          pushEv(S, ['inject', tgt.id, g]);\\n        }\\n      } else {\\n        const g = bubble ? 'sloppy' : (p.fill >= 0.9 ? 'textbook' : 'clean');\\n        const add = syringeDose(S, tune) * p.fill * (bubble ? 0.5 : 1);\\n        S.vitals = Math.min(99, S.vitals + add);\\n        award(S, p, g, 40, tune);\\n        pushEv(S, ['iv', Math.round(add), g]);\\n      }\\n690→      p.fill = 0; p.over = 0; p.cool = 0.35;\\n    }\\n    if (!down && p.trigRelease === false) { /* keep fill while aiming */ }\\n  }\\n\\n  function stepCautery(S, p, dt, tune) {\\n    if (p.lock > 0) { p.lock -= dt; p.heat = Math.max(0, p.heat - 0.6 * dt); return; }\\n    const down = p.trig > 0.3;\\n    if (!down) {\\n      p.heat = Math.max(0, p.heat - 0.6 * dt);\\n700→      p.bareT = 0;\\n      return;\\n    }\\n    p.heat += tune.fluids.cauteryHeat * dt;\\n    if (p.heat >= 1) { p.lock = 1.2; p.heat = 1; slip(S, p, 'lock', 1, tune); pushEv(S, ['lock', p.id]); return; }\\n    if (nerveHit(S, p, tune)) return;\\n    const tgt = nearest(S, p, 6, o => canTouch(S, o) && (o.type === 'polyp' || o.type === 'bleeder' || o.type === 'rupture' || o.type === 'bead' || o.type === 'uvula' || o.type === 'eye' || o.type === 'tremass' || (o.type === 'lobe' && o.mode === 'cautery') || o.type === 'barb'));\\n    if (tgt) {\\n      p.bareT = 0;\\n      tgt.burn = (tgt.burn || 0) + dt;\\n710→      tgt.prog = tgt.burn / (tgt.need || 0.5);\\n      if (tgt.burn >= (tgt.need || 0.5) / Math.max(0.25, tune.strains.health) && !tgt.done) {\\n        const dirty = tgt.charred || p.lockedDuring;\\n        const g = (!tgt.charred && p.lock <= 0 && !p.hadLock) ? 'textbook' : 'clean';\\n        tgt.done = true; tgt.alive = false; tgt.drain = 0; tgt.grade = g;\\n        p.burned += 1;\\n        award(S, p, g, 90, tune);\\n        pushEv(S, ['burn', tgt.id, g]);\\n      }\\n    } else {\\n720→      p.bareT = (p.bareT || 0) + dt;\\n      if (p.bareT >= 0.25) {\\n        /* char on the field */\\n        p.charT = (p.charT || 0) + dt;\\n        S.vitals -= 0.8 * dt * tune.patient.slip;\\n        if (p.bareT >= 0.6 && !p.charSlip) { p.charSlip = true; slip(S, p, 'char', 2, tune); pushEv(S, ['char', Math.round(p.x), Math.round(p.y)]); }\\n      }\\n    }\\n  }\\n\\n730→  function stepSuction(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    const pool = nearest(S, p, 14, o => o.type === 'pool' && !o.done && o.vol > 0);\\n    if (!pool) return;\\n    const rate = tune.fluids.suction;\\n    const before = pool.vol;\\n    pool.vol = Math.max(0, pool.vol - rate * dt);\\n    p.suctioned += before - pool.vol;\\n    pool.prog = 1 - pool.vol / (pool.max || 1);\\n    if (pool.vol <= 0.2) { pool.done = true; pool.alive = false; pool.vol = 0; pushEv(S, ['dry', pool.id]); }\\n740→  }\\n\\n  function stepSonar(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    let rad = 38;\\n    if (S.activeDoc === 'vale' || S.gift === 'breath') rad *= 1.25;\\n    if (S.gift === 'both' && S.activeDoc === 'vale') rad *= 1.25;\\n    p.sonarR = rad;\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n750→      if (!o.hidden || o.done) continue;\\n      if (hypot(o.x - p.x, o.y - p.y) <= rad) { o.marked = true; o.markT = 4; pushEv(S, ['mark', o.id]); }\\n    }\\n    if (S.device && !S.device.shown && hypot(p.x - (S.device.x || 213), p.y - (S.device.y || 116)) <= rad) {\\n      S.device.shown = true;\\n      pushEv(S, ['board', 1]);\\n    }\\n    if (S.strain && S.strain.kind === 'legato') {\\n      for (const w of S.strain.worms || []) if (hypot(w.x - p.x, w.y - p.y) <= rad) w.marked = true;\\n    }\\n760→  }\\n\\n  function applyTools(S, p, dt, tune) {\\n    if (p.gone) return;\\n    if (inDome(S, p.x, p.y)) return;\\n    if (p.swap > 0) p.swap -= dt;\\n    p.ox = p.x; p.oy = p.y;\\n    const tool = p.tool;\\n    if (tool === 'forceps') stepForceps(S, p, dt, tune);\\n    else if (tool === 'scalpel') stepScalpel(S, p, dt, tune);\\n770→    else if (tool === 'suture') stepSuture(S, p, dt, tune);\\n    else if (tool === 'salve') stepSalve(S, p, dt, tune);\\n    else if (tool === 'syringe') stepSyringe(S, p, dt, tune);\\n    else if (tool === 'cautery') stepCautery(S, p, dt, tune);\\n    else if (tool === 'suction') stepSuction(S, p, dt, tune);\\n    else if (tool === 'sonar') stepSonar(S, p, dt, tune);\\n    /* marks expire */\\n  }\\n\\n  /* ---------- strains ---------- */\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/core/sim.js\",\"offset\":380,\"limit\":400,\"raw_output\":\"      if (o.type !== 'nerve' && o.type !== 'eloquent') continue;\\n      const pts = o.guide || [[o.x - 20, o.y], [o.x + 20, o.y]];\\n      if (polyDist(pts, p.x, p.y).d < 6) { slip(S, p, 'nerve', 12, tune); return true; }\\n    }\\n    return false;\\n  }\\n\\n  function gradeMean(mean, a, b) {\\n    if (mean <= a) return 'textbook';\\n    if (mean <= b) return 'clean';\\n    return 'sloppy';\\n  }\\n\\n  function stepForceps(S, p, dt, tune) {\\n    const down = p.trig > 0.3;\\n    let held = p.held ? objById(S, p.held) : null;\\n    if (p.trigEdge && !held) {\\n      const o = nearest(S, p, 12, o => canTouch(S, o) && (o.type === 'shard' || o.type === 'fragment' || o.type === 'cork' || o.type === 'hook' || o.type === 'gaff' || o.type === 'clot' || o.type === 'mass' || o.type === 'nest' || o.type === 'note' || o.type === 'retractor' || o.type === 'screw' || (o.type === 'lobe' && o.mode === 'forceps')));\\n      if (o && o.type === 'clot' && !o.dosed) { /* no grip yet */ }\\n      else if (o && (o.type === 'hook' || o.type === 'gaff') && o.barbs) { slip(S, p, 'tear', 4, tune); o.tears = (o.tears || 0) + 1; }\\n      else if (o && o.type === 'mass' && !o.cut) { /* ring first */ }\\n      else if (o && o.type === 'nest' && !o.cut) { /* slash first */ }\\n      else if (o && o.type === 'screw') { p.held = o.id; o.lastAng = Math.atan2(p.y - o.y, p.x - o.x); o.spin = o.spin || 0; }\\n      else if (o && o.type === 'retractor') { p.held = o.id; }\\n      else if (o) {\\n        p.held = o.id; o.t0 = o.t0 || 0; o.pullT = o.pullT || 0; o.gripped = true;\\n        if (!o.origin) o.origin = [o.x, o.y];\\n        pushEv(S, ['grip', o.id]);\\n      }\\n    }\\n    held = p.held ? objById(S, p.held) : null;\\n    if (held && down) {\\n      if (held.type === 'retractor') {\\n        held.x = p.x; held.y = p.y;\\n        S.windowOpen = 1;\\n        return;\\n      }\\n      if (held.type === 'screw') {\\n        const ang = Math.atan2(p.y - held.y, p.x - held.x);\\n        let d = ang - (held.lastAng || ang);\\n        while (d > Math.PI) d -= TAU;\\n        while (d < -Math.PI) d += TAU;\\n        held.spin = (held.spin || 0) + Math.abs(d);\\n        held.lastAng = ang;\\n        if (held.spin >= 3 * TAU) {\\n          held.done = true; held.alive = false; p.held = 0;\\n          award(S, p, 'textbook', 100, tune);\\n          pushEv(S, ['screw', held.id]);\\n        }\\n        return;\\n      }\\n      const ox = held.origin[0], oy = held.origin[1];\\n      const dx = p.x - ox, dy = p.y - oy;\\n      const along = dx * held.axis[0] + dy * held.axis[1];\\n      const px = dx - along * held.axis[0], py = dy - along * held.axis[1];\\n      const perp = hypot(px, py);\\n      const limit = held.tension || 120;\\n      if (!held.free) {\\n        if (p.inst > limit || perp > 8) {\\n          if (held.type === 'note' || (S.strain && S.strain.kind === 'legato' && held.tag === 'legato-head')) {\\n            held.snapped = true;\\n            slip(S, p, 'snap', 4, tune);\\n            pushEv(S, ['snap', held.id]);\\n          } else {\\n            held.tears = (held.tears || 0) + 1;\\n            held.prog = Math.max(0, (held.prog || 0) - held.depth * 0.3);\\n            slip(S, p, 'tear', 4, tune);\\n            pushEv(S, ['tear', held.id]);\\n          }\\n        }\\n        held.prog = Math.max(held.prog || 0, along);\\n        held.pullT = (held.pullT || 0) + dt;\\n        if (along >= held.depth) {\\n          held.free = true;\\n          pushEv(S, ['free', held.id]);\\n        }\\n      } else {\\n        held.x = p.x; held.y = p.y;\\n        held.pullT = (held.pullT || 0) + dt;\\n      }\\n    }\\n    if (held && p.trigRelease) {\\n      if (held.type === 'retractor') { p.held = 0; return; }\\n      if (held.type === 'screw') { p.held = 0; return; }\\n      const d0 = hypot(p.x - held.origin[0], p.y - held.origin[1]);\\n      if (held.holdZone && hypot(p.x - held.holdZone[0], p.y - held.holdZone[1]) <= (held.holdZone[2] || 14)) {\\n        held.clamped = true; held.gripped = false; p.held = 0;\\n        pushEv(S, ['clamp', held.id]);\\n        return;\\n      }\\n      if (held.free && (d0 >= 24 || outside(p.x, p.y))) {\\n        const tears = held.tears || 0;\\n        const parT = held.parTime || (held.depth / 80 + 0.35);\\n        let g = 'sloppy';\\n        if (!tears && (held.pullT || 0) <= parT) g = 'textbook';\\n        else if (tears <= 1) g = 'clean';\\n        held.done = true; held.alive = false; held.grade = g; p.held = 0;\\n        if (held.type === 'note') p.score += 0;\\n        award(S, p, g, 120, tune);\\n        pushEv(S, ['dish', held.id, g]);\\n      } else {\\n        held.gripped = false;\\n        p.held = 0;\\n      }\\n    }\\n  }\\n\\n  function outside(x, y) {\\n    const nx = (x - CFG.CX) / CFG.RX, ny = (y - CFG.CY) / CFG.RY;\\n    return nx * nx + ny * ny > 1;\\n  }\\n\\n  function stepScalpel(S, p, dt, tune) {\\n    const down = p.trig > 0.3;\\n    const tol = tune.hands.grade;\\n    if (p.stroke && p.stroke.kind === 'scalpel') {\\n      const o = objById(S, p.stroke.id);\\n      if (!o || o.done) { p.stroke = null; }\\n    }\\n    if (p.trigEdge && !p.stroke) {\\n      const o = nearest(S, p, 8, o => canTouch(S, o) && o.guide && (o.type === 'mass' || o.type === 'slur' || o.type === 'tendril' || o.type === 'spiral' || o.type === 'wire' || o.type === 'repeat' || o.type === 'lobe' || o.type === 'cut' || o.type === 'nest'));\\n      if (o && o.guide) {\\n        const start = o.guide[0];\\n        if (hypot(p.x - start[0], p.y - start[1]) <= 8 + (p.mouse ? 1 : 0)) {\\n          p.stroke = { kind: 'scalpel', id: o.id, far: 0, sum: 0, n: 0, off: 0, slipped: false };\\n          o.cutting = true;\\n        }\\n      }\\n    }\\n    if (!(p.stroke && p.stroke.kind === 'scalpel') && down && p.inst > 40) {\\n      const onGuide = S.objects.some(o => o.guide && !o.done && polyDist(o.guide, p.x, p.y).d < 8);\\n      if (!onGuide && !outside(p.x, p.y)) {\\n        p.bare = (p.bare || 0) + hypot(p.x - (p.ox || p.x), p.y - (p.oy || p.y));\\n        if (p.bare >= 6) { slip(S, p, 'healthy', 3, tune); p.bare = 0; }\\n      }\\n    }\\n    if (p.stroke && p.stroke.kind === 'scalpel' && down) {\\n      const o = objById(S, p.stroke.id);\\n      if (o && nerveHit(S, p, tune)) { /* counted */ }\\n      if (o && o.guide) {\\n        const hit = polyDist(o.guide, p.x, p.y);\\n        const st = p.stroke;\\n        if (hit.along > st.far) st.far = hit.along;\\n        st.sum += hit.d; st.n += 1;\\n        if (hit.d > 9) st.off += dt; else st.off = 0;\\n        if (st.off >= 0.12 && !st.slipped) {\\n          st.slipped = true; slip(S, p, 'slip', 3, tune);\\n          pushEv(S, ['slipcut', o.id]);\\n        }\\n        o.prog = st.far / (hit.total || 1);\\n        if (o.type === 'spiral' && o.beatLock && S.flags.onBeat) {\\n          if (!st.beatSlip) { st.beatSlip = true; slip(S, p, 'beat', 3, tune); }\\n          o.prog = Math.min(o.prog, st.safe || 0);\\n        } else if (o.type === 'spiral') st.safe = o.prog;\\n        if (st.far >= (hit.total || 1) - 0.5) {\\n          const mean = st.n ? st.sum / st.n : 99;\\n          const g = st.slipped ? 'sloppy' : gradeMean(mean, 1.8 * tol, 4 * tol);\\n          o.done = true; o.alive = false; o.grade = g; o.cut = true;\\n          if (o.type === 'mass') { o.done = false; o.alive = true; o.cut = true; o.type = 'mass'; }\\n          if (o.type === 'nest') { o.done = false; o.alive = true; o.cut = true; }\\n          if (o.type === 'wire') { /* caller checks order */ wireCut(S, p, o, tune); }\\n          else award(S, p, g, 110, tune);\\n          p.stroke = null;\\n          pushEv(S, ['cut', o.id, g]);\\n        }\\n      }\\n    }\\n    if (p.trigRelease && p.stroke && p.stroke.kind === 'scalpel') {\\n      const o = objById(S, p.stroke.id);\\n      if (o && o.prog < 0.98) {\\n        /* resume later if they come back within 6 */\\n        p.stroke.paused = true;\\n      }\\n    }\\n    if (p.trigEdge && p.stroke && p.stroke.paused) {\\n      const o = objById(S, p.stroke.id);\\n      if (o && o.guide) {\\n        const hit = polyDist(o.guide, p.x, p.y);\\n        if (Math.abs(hit.along - p.stroke.far) <= 6 || hit.d <= 6) p.stroke.paused = false;\\n        else p.stroke = null;\\n      }\\n    }\\n    /* slash variant: a fast stroke across a slash target */\\n    if (down && p.inst >= 60) {\\n      const o = nearest(S, p, 10, q => canTouch(S, q) && q.slash && !q.done);\\n      if (o) {\\n        o.done = true; o.alive = false; o.cut = true;\\n        award(S, p, 'clean', 100, tune);\\n        pushEv(S, ['slash', o.id]);\\n      }\\n    }\\n  }\\n\\n  function wireCut(S, p, o, tune) {\\n    const dev = S.device;\\n    if (!dev) { o.done = true; award(S, p, 'clean', 80, tune); return; }\\n    const want = dev.order[dev.next];\\n    if (o.tag === want) {\\n      dev.next += 1; o.done = true; o.alive = false;\\n      award(S, p, 'textbook', 100, tune);\\n      if (dev.next >= dev.order.length) dev.done = true;\\n    } else {\\n      o.done = false; o.alive = true; o.prog = 0; o.cutting = false;\\n      S.vitals -= 30; S.clock = Math.max(0, S.clock - 30);\\n      slip(S, p, 'wire', 0, tune);\\n      pushEv(S, ['badwire', o.tag]);\\n    }\\n  }\\n\\n  function stepSuture(S, p, dt, tune) {\\n    const down = p.trig > 0.3;\\n    const extra = (S.activeDoc === 'sokolova' ? 1 : 0);\\n    if (p.trigEdge) {\\n      const o = nearest(S, p, 9 + extra, q => canTouch(S, q) && q.pairs && (q.stitch || 0) < q.pairs.length);\\n      if (o) {\\n        const a = o.pairs[o.stitch][0];\\n        if (hypot(p.x - a[0], p.y - a[1]) <= 9 + extra) {\\n          p.stroke = { kind: 'suture', id: o.id, i: o.stitch, t: 0 };\\n          pushEv(S, ['needle', o.id, o.stitch]);\\n        }\\n      }\\n    }\\n    if (p.stroke && p.stroke.kind === 'suture' && down) p.stroke.t += dt;\\n    if (p.stroke && p.stroke.kind === 'suture' && p.trigRelease) {\\n      const o = objById(S, p.stroke.id);\\n      const st = p.stroke;\\n      p.stroke = null;\\n      if (!o || o.done) return;\\n      const b = o.pairs[st.i][1];\\n      const tol = 6 + extra + (p.mouse ? 1 : 0);\\n      if (hypot(p.x - b[0], p.y - b[1]) <= tol) {\\n        const g = gradeMean(st.t, 0.6, 1.2);\\n        o.grades = o.grades || [];\\n        o.grades.push(g === 'textbook' ? 2 : g === 'clean' ? 1 : 0);\\n        o.times = o.times || [];\\n        o.times.push(st.t);\\n        o.stitch = st.i + 1;\\n        o.prog = o.stitch / o.pairs.length;\\n        p.stitches += 1;\\n        const bleedLeft = 1 - o.prog;\\n        if (o.type === 'arteryTear') o.drain = 1 * bleedLeft;\\n        else if (o.type === 'wound') o.drain = 0.4 * bleedLeft;\\n        pushEv(S, ['stitch', Math.round(b[0]), Math.round(b[1]), g]);\\n        if (o.stitch >= o.pairs.length) {\\n          const meanT = o.times.reduce((a, c) => a + c, 0) / o.times.length;\\n          const fg = gradeMean(meanT, 0.6, 1.2);\\n          o.done = true; o.alive = false; o.grade = fg; o.drain = 0;\\n          award(S, p, fg, 80 + 20 * o.pairs.length, tune);\\n        }\\n      } else {\\n        slip(S, p, 'loose', 1, tune);\\n        pushEv(S, ['loose', o.id]);\\n      }\\n    }\\n  }\\n\\n  function stepSalve(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    let any = false;\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n      if (!canTouch(S, o) || !o.cells) continue;\\n      if (!(o.type === 'laceration' || o.type === 'patch' || o.type === 'bite' || (o.type === 'lobe' && o.mode === 'salve'))) continue;\\n      for (let c = 0; c < o.cells.length; c++) {\\n        const cell = o.cells[c];\\n        if (!cell[2] && hypot(cell[0] - p.x, cell[1] - p.y) <= 10) { cell[2] = 1; any = true; }\\n      }\\n      let on = 0;\\n      for (let c = 0; c < o.cells.length; c++) if (o.cells[c][2]) on++;\\n      o.prog = o.cells.length ? on / o.cells.length : 1;\\n      if (o.prog >= 0.9 && !o.done) {\\n        o.done = true; o.alive = false; o.drain = 0;\\n        S.vitals = Math.min(99, S.vitals + 2 * tune.patient.healing);\\n        award(S, p, 'clean', 80, tune);\\n        pushEv(S, ['heal', o.id]);\\n      }\\n    }\\n    if (!any && p.trigEdge) { /* salve cannot harm */ }\\n  }\\n\\n  function stepSyringe(S, p, dt, tune) {\\n    if (p.cool > 0) p.cool -= dt;\\n    const down = p.trig > 0.3;\\n    if (down && p.cool <= 0) {\\n      if (p.fill < 1) p.fill = Math.min(1, p.fill + dt / 0.55);\\n      else p.over += dt;\\n    }\\n    if (p.trigRelease && p.fill > 0.05 && p.cool <= 0) {\\n      const bubble = p.over >= 0.3;\\n      const tgt = nearest(S, p, 10, o => canTouch(S, o) && (o.type === 'clot' || o.type === 'reed' || o.type === 'voice' || (o.type === 'lobe' && o.mode === 'syringe')));\\n      if (tgt) {\\n        if ((tgt.type === 'reed' || tgt.type === 'voice') && !tgt.window) {\\n          addObj(S, { type: 'laceration', x: tgt.x + 6, y: tgt.y, r: 8, order: 50, drain: 0.2 });\\n          slip(S, p, 'spit', 2, tune);\\n        } else {\\n          const g = bubble ? 'sloppy' : (p.fill >= 0.9 ? 'textbook' : 'clean');\\n          tgt.dosed = true;\\n          tgt.dose = (bubble ? 0.5 : 1) * p.fill;\\n          if (tgt.type === 'clot') { /* forceps next */ tgt.drain = 0.1; }\\n          else { tgt.done = true; tgt.alive = false; tgt.drain = 0; }\\n          award(S, p, g, 90, tune);\\n          pushEv(S, ['inject', tgt.id, g]);\\n        }\\n      } else {\\n        const g = bubble ? 'sloppy' : (p.fill >= 0.9 ? 'textbook' : 'clean');\\n        const add = syringeDose(S, tune) * p.fill * (bubble ? 0.5 : 1);\\n        S.vitals = Math.min(99, S.vitals + add);\\n        award(S, p, g, 40, tune);\\n        pushEv(S, ['iv', Math.round(add), g]);\\n      }\\n      p.fill = 0; p.over = 0; p.cool = 0.35;\\n    }\\n    if (!down && p.trigRelease === false) { /* keep fill while aiming */ }\\n  }\\n\\n  function stepCautery(S, p, dt, tune) {\\n    if (p.lock > 0) { p.lock -= dt; p.heat = Math.max(0, p.heat - 0.6 * dt); return; }\\n    const down = p.trig > 0.3;\\n    if (!down) {\\n      p.heat = Math.max(0, p.heat - 0.6 * dt);\\n      p.bareT = 0;\\n      return;\\n    }\\n    p.heat += tune.fluids.cauteryHeat * dt;\\n    if (p.heat >= 1) { p.lock = 1.2; p.heat = 1; slip(S, p, 'lock', 1, tune); pushEv(S, ['lock', p.id]); return; }\\n    if (nerveHit(S, p, tune)) return;\\n    const tgt = nearest(S, p, 6, o => canTouch(S, o) && (o.type === 'polyp' || o.type === 'bleeder' || o.type === 'rupture' || o.type === 'bead' || o.type === 'uvula' || o.type === 'eye' || o.type === 'tremass' || (o.type === 'lobe' && o.mode === 'cautery') || o.type === 'barb'));\\n    if (tgt) {\\n      p.bareT = 0;\\n      tgt.burn = (tgt.burn || 0) + dt;\\n      tgt.prog = tgt.burn / (tgt.need || 0.5);\\n      if (tgt.burn >= (tgt.need || 0.5) / Math.max(0.25, tune.strains.health) && !tgt.done) {\\n        const dirty = tgt.charred || p.lockedDuring;\\n        const g = (!tgt.charred && p.lock <= 0 && !p.hadLock) ? 'textbook' : 'clean';\\n        tgt.done = true; tgt.alive = false; tgt.drain = 0; tgt.grade = g;\\n        p.burned += 1;\\n        award(S, p, g, 90, tune);\\n        pushEv(S, ['burn', tgt.id, g]);\\n      }\\n    } else {\\n      p.bareT = (p.bareT || 0) + dt;\\n      if (p.bareT >= 0.25) {\\n        /* char on the field */\\n        p.charT = (p.charT || 0) + dt;\\n        S.vitals -= 0.8 * dt * tune.patient.slip;\\n        if (p.bareT >= 0.6 && !p.charSlip) { p.charSlip = true; slip(S, p, 'char', 2, tune); pushEv(S, ['char', Math.round(p.x), Math.round(p.y)]); }\\n      }\\n    }\\n  }\\n\\n  function stepSuction(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    const pool = nearest(S, p, 14, o => o.type === 'pool' && !o.done && o.vol > 0);\\n    if (!pool) return;\\n    const rate = tune.fluids.suction;\\n    const before = pool.vol;\\n    pool.vol = Math.max(0, pool.vol - rate * dt);\\n    p.suctioned += before - pool.vol;\\n    pool.prog = 1 - pool.vol / (pool.max || 1);\\n    if (pool.vol <= 0.2) { pool.done = true; pool.alive = false; pool.vol = 0; pushEv(S, ['dry', pool.id]); }\\n  }\\n\\n  function stepSonar(S, p, dt, tune) {\\n    if (p.trig <= 0.3) return;\\n    let rad = 38;\\n    if (S.activeDoc === 'vale' || S.gift === 'breath') rad *= 1.25;\\n    if (S.gift === 'both' && S.activeDoc === 'vale') rad *= 1.25;\\n    p.sonarR = rad;\\n    for (let i = 0; i < S.objects.length; i++) {\\n      const o = S.objects[i];\\n      if (!o.hidden || o.done) continue;\\n      if (hypot(o.x - p.x, o.y - p.y) <= rad) { o.marked = true; o.markT = 4; pushEv(S, ['mark', o.id]); }\\n    }\\n    if (S.device && !S.device.shown && hypot(p.x - (S.device.x || 213), p.y - (S.device.y || 116)) <= rad) {\\n      S.device.shown = true;\\n      pushEv(S, ['board', 1]);\\n    }\\n    if (S.strain && S.strain.kind === 'legato') {\\n      for (const w of S.strain.worms || []) if (hypot(w.x - p.x, w.y - p.y) <= rad) w.marked = true;\\n    }\\n  }\\n\\n  function applyTools(S, p, dt, tune) {\\n    if (p.gone) return;\\n    if (inDome(S, p.x, p.y)) return;\\n    if (p.swap > 0) p.swap -= dt;\\n    p.ox = p.x; p.oy = p.y;\\n    const tool = p.tool;\\n    if (tool === 'forceps') stepForceps(S, p, dt, tune);\\n    else if (tool === 'scalpel') stepScalpel(S, p, dt, tune);\\n    else if (tool === 'suture') stepSuture(S, p, dt, tune);\\n    else if (tool === 'salve') stepSalve(S, p, dt, tune);\\n    else if (tool === 'syringe') stepSyringe(S, p, dt, tune);\\n    else if (tool === 'cautery') stepCautery(S, p, dt, tune);\\n    else if (tool === 'suction') stepSuction(S, p, dt, tune);\\n    else if (tool === 'sonar') stepSonar(S, p, dt, tune);\\n    /* marks expire */\\n  }\\n\\n  /* ---------- strains ---------- */\\n\",\"total_lines\":1684}}","is_error":false},{"type":"tool_result","tool_use_id":"call-e88b2744-9d18-489b-9aba-539ca13bcbe9-7","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1140→  }\\n  function spawnVoice(S, st) {\\n    st.domes = [{ x: 180, y: 120, r: 34, t: 4 }, { x: 240, y: 110, r: 34, t: 5 }];\\n    for (let i = 0; i < 3; i++) addObj(S, { type: 'voice', x: 200 + i * 14, y: 116, hidden: true, order: 1, tag: 'voice', drain: 0.2, window: false });\\n    st.jitter = true; st.amp = 0.6;\\n  }\\n  function spawnCoda(S, st) {\\n    const guide = [];\\n    for (let i = 0; i <= 16; i++) {\\n      const a = i / 16 * Math.PI * 1.6;\\n1150→      guide.push([213 + Math.cos(a) * (20 + i * 3), 116 + Math.sin(a) * (12 + i * 2)]);\\n    }\\n    addObj(S, { type: 'spiral', x: 213, y: 116, guide, order: 1, tag: 'last-note', beatLock: true, drain: 0, ring: false });\\n  }\\n\\n  function spawnStrain(S, kind, opts) {\\n    opts = opts || {};\\n    if (kind === 'staccato') {\\n      const st = { kind, tag: opts.tag || 'stacc', t: 0, beads: [], done: false, collapse: 0 };\\n      const n = opts.nests || 2;\\n1160→      for (let i = 0; i < n; i++) {\\n        addObj(S, { type: 'nest', x: opts.x || (180 + i * 40), y: opts.y || 120, hidden: true, order: 2, tag: st.tag, slash: true, drain: 0.15, r: 8 });\\n      }\\n      const beads = opts.beads || 4;\\n      for (let i = 0; i < beads; i++) {\\n        st.beads.push({ x: 160 + i * 12, y: 90, x0: 160 + i * 12, y0: 90, tx: 170 + (i % 3) * 18, ty: 140, landIn: 0.6 + i * 0.15, flight: 0.7, dead: false, landed: false, hopped: false });\\n      }\\n      S.strain = st;\\n      return st;\\n    }\\n1170→    if (kind === 'legato') {\\n      const seg = opts.segments || 8;\\n      const w = makeWorm(S, opts.x || 150, opts.y || 120, seg, 1);\\n      w.marked = false;\\n      const st = { kind, worms: [w], done: false, snapped: false };\\n      /* head starts hidden: a sonar target */\\n      addObj(S, { type: 'hold', x: w.x, y: w.y, hidden: true, order: 0, tag: 'legato-hide', drain: 0 });\\n      S.strain = st;\\n      return st;\\n    }\\n1180→    if (kind === 'tremolo') {\\n      const st = { kind, t: 0, amp: 1, stage: 1, x: opts.x || 213, y: opts.y || 116, wake: 6, reed0: 5, done: false, jitter: true, beat: 0, flare: false };\\n      for (let i = 0; i < 5; i++) {\\n        const a = -Math.PI / 2 + i * TAU / 5;\\n        addObj(S, { type: 'reed', x: st.x + Math.cos(a) * 28, y: st.y + Math.sin(a) * 18, order: 1, tag: 'reed', drain: 0, window: false });\\n      }\\n      addObj(S, { type: 'tremass', x: st.x, y: st.y, need: 3, order: 3, tag: 'tremass', drain: 0.3 });\\n      S.strain = st;\\n      return st;\\n    }\\n1190→    if (kind === 'dacapo') {\\n      const lobes = [\\n        { id: 'A', mode: 'cautery', period: 6, openFor: 2.5, x: 180, y: 110 },\\n        { id: 'B', mode: 'slash', period: 7, openFor: 2.5, x: 213, y: 130 },\\n        { id: 'C', mode: 'syringe', period: 9, openFor: 3, x: 246, y: 112 },\\n      ];\\n      const st = { kind, t: 0, round: 1, count: -1, lobes, done: false, repeated: 0 };\\n      for (const L of lobes) {\\n        const spec = { type: 'lobe', x: L.x, y: L.y, mode: L.mode === 'slash' ? 'scalpel' : L.mode, order: 1, tag: 'lobe-' + L.id, open: false, drain: 0.15, need: L.mode === 'cautery' ? 1 : 0.5 };\\n        if (L.mode === 'slash') { spec.guide = [[L.x - 10, L.y], [L.x + 10, L.y]]; spec.mode = 'scalpel'; spec.slash = true; }\\n1200→        if (L.mode === 'syringe') { spec.mode = 'syringe'; spec.follow = 'salve'; }\\n        const o = addObj(S, spec);\\n        L.oid = o.id; L.dead = false; L.open = false;\\n      }\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'fermata') {\\n      const st = { kind, t: 0, stage: 1, hits: 0, eyeOpen: 0, done: false, jitter: false, amp: 0,\\n        domes: [{ x: 200, y: 116, r: 34, t: 5 }],\\n1210→        eye: { x: 200, y: 116, open: false, hidden: false } };\\n      const o = addObj(S, { type: 'eye', x: 200, y: 116, need: 0.3, order: 1, tag: 'eye', open: false, drain: 0.2 });\\n      st.eye.oid = o.id;\\n      addObj(S, { type: 'eloquent', x: 150, y: 100, guide: [[140, 90], [180, 110]], order: 0, drain: 0, tag: 'eloq' });\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'cantor') {\\n      const st = { kind, t: 0, move: 1, done: false, signs: 0, jitter: false, amp: 0.4, domes: [] };\\n      for (let i = 0; i < 3; i++) addObj(S, { type: 'tendril', x: 170 + i * 30, y: 100, len: 28, order: 1, tag: 'tendril', drain: 0.15, guide: [[160 + i * 30, 100], [190 + i * 30, 108]] });\\n1220→      for (let i = 0; i < 3; i++) addObj(S, { type: 'uvula', x: 180 + i * 26, y: 140, need: 1.5, order: 2, tag: 'uvula', drain: 0.2 });\\n      S.strain = st;\\n      return st;\\n    }\\n    return null;\\n  }\\n\\n  /* ---------- phase / scripts ---------- */\\n\\n  function phaseClear(S) {\\n1230→    if (S.strain && !S.strain.done) return false;\\n    for (const o of S.objects) {\\n      if (o.done || !o.alive) continue;\\n      if (o.type === 'nerve' || o.type === 'eloquent' || o.type === 'hold') continue;\\n      if (o.optional) continue;\\n      if (o.type === 'bead') continue;\\n      return false;\\n    }\\n    if (S.strain && S.strain.kind === 'staccato') {\\n      const live = (S.strain.beads || []).some(b => !b.dead);\\n1240→      if (live && !S.strain.done) return false;\\n    }\\n    return true;\\n  }\\n\\n  function runScript(S, id, tune) {\\n    if (id === 'dip') { S.flags.dip = 40; }\\n    else if (id === 'crash') { S.flags.crash = 8; }\\n    else if (id === 'breath') { S.flags.needBreath = true; }\\n    else if (id === 'look') { S.flags.needLook = true; }\\n1250→    else if (id === 'lurch') {\\n      slip(S, S.players[0], 'lurch', 3, tune);\\n      for (const o of S.objects) if (!o.done) { o.x += 10; o.y += 4; if (o.origin) { o.origin = [o.origin[0] + 10, o.origin[1] + 4]; } }\\n      S.flags.needLook = true;\\n      pushEv(S, ['lurch', 1]);\\n    } else if (id === 'blackout') { S.dim = 1; }\\n    else if (id === 'roll') { S.tiltAmp = 1; }\\n    else if (id === 'quiet') { S.flags.quiet = true; S.flags.needBreath = true; }\\n    else if (id === 'refill') { S.clock += 120; }\\n    else if (id === 'cantorRewind') { forceRewind(S, true); }\\n1260→    else if (id === 'code') { S.vitals = 0; }\\n  }\\n\\n  function stepWorld(S, worldDt, handDt, tune) {\\n    if (S.flags.dip) {\\n      S.vitals += (S.flags.dip - S.vitals) * Math.min(1, worldDt * 2);\\n      if (Math.abs(S.vitals - S.flags.dip) < 0.4) { S.vitals = S.flags.dip; S.flags.dip = 0; }\\n    }\\n    if (S.flags.crash) {\\n      S.vitals -= S.flags.crash * worldDt;\\n1270→    }\\n    if (S.tiltAmp) {\\n      const drift = Math.sin(S.worldT * 0.7) * 25 * S.tiltAmp;\\n      for (const o of S.objects) if (o.type === 'pool' && !o.done) {\\n        o.x = clamp(o.x + drift * worldDt, 60, 360);\\n      }\\n    }\\n    for (const o of S.objects) {\\n      if (o.markT > 0) { o.markT -= handDt; if (o.markT <= 0 && o.hidden) o.marked = false; }\\n      if (o.type === 'bleeder' && !o.done) {\\n1280→        let pool = S.objects.find(p => p.type === 'pool' && p.tag === 'fed-' + o.id);\\n        if (!pool) pool = addObj(S, { type: 'pool', x: o.x, y: o.y + 8, vol: 4, max: 40, order: o.order + 1, tag: 'fed-' + o.id, drain: 0 });\\n        if (!pool.done) pool.vol = Math.min(pool.max, pool.vol + 6 * worldDt * tune.fluids.bleed);\\n      }\\n      if (o.type === 'arteryTear' && !o.done) {\\n        let pool = S.objects.find(p => p.type === 'pool' && p.tag === 'fed-' + o.id);\\n        if (!pool) pool = addObj(S, { type: 'pool', x: o.x, y: o.y + 6, vol: 6, max: 50, order: o.order + 1, tag: 'fed-' + o.id, drain: 0 });\\n        if (!pool.done) pool.vol = Math.min(pool.max, pool.vol + 14 * worldDt * tune.fluids.bleed);\\n      }\\n    }\\n1290→    /* solo retractor: Quill holds at half the window */\\n    const retract = S.objects.find(o => o.type === 'retractor' && !o.done);\\n    if (retract) {\\n      const holder = S.players.some(p => p.held === retract.id && p.trig > 0.3);\\n      if (holder) S.windowOpen = 1;\\n      else if (S.players.filter(p => !p.gone).length <= 1) S.windowOpen = 0.5;\\n      else S.windowOpen = 0;\\n    }\\n    for (let i = 0; i < S.scripts.length; i++) {\\n      const sc = S.scripts[i];\\n1300→      if (sc.done) continue;\\n      if (S.phaseT >= sc.t) { sc.done = true; runScript(S, sc.do, tune); }\\n    }\\n  }\\n\\n  function loadPhase(S, def, index) {\\n    const ph = def.phases[index];\\n    S.phase = index;\\n    S.phaseCount = def.phases.length;\\n    S.phaseName = ph.name;\\n1310→    S.phaseT = 0;\\n    S.objects = S.objects.filter(o => o.persist);\\n    S.strain = null;\\n    S.scripts = (ph.at || []).map(a => ({ t: a.t, do: a.do, done: false }));\\n    S.tutorial = !!ph.tutorial;\\n    S.tutDone = !ph.tutorial;\\n    S.flags = Object.assign({}, S.flags, ph.flags || {});\\n    if (ph.dim != null) S.dim = ph.dim;\\n    if (ph.tilt) S.tiltAmp = ph.tilt;\\n    for (const spec of ph.objects || []) addObj(S, clone(spec));\\n1320→    if (ph.strain) spawnStrain(S, ph.strain, ph.strainOpts || {});\\n    if (ph.onEnter) runScript(S, ph.onEnter, tuneOf(null));\\n    S.checkpoint = takeCore(S);\\n    /* drop the checkpoint's nested copy weight: checkpoint is the core itself */\\n    pushEv(S, ['phase', index, ph.name]);\\n  }\\n\\n  function advancePhase(S) {\\n    const def = (GAME.CASES || {})[S.id];\\n    if (!def) { finishCase(S); return; }\\n1330→    if (S.phase + 1 >= def.phases.length) {\\n      if (!S.dressing && !S.won) {\\n        S.dressing = { t: 0, done: false };\\n        pushEv(S, ['dressing', 1]);\\n        return;\\n      }\\n      return;\\n    }\\n    loadPhase(S, def, S.phase + 1);\\n  }\\n1340→\\n  function create(def, opts) {\\n    opts = opts || {};\\n    const diff = opts.difficulty || opts.diff || 'resident';\\n    const clockMul = diff === 'intern' ? 1.3 : diff === 'attending' ? 0.8 : 1;\\n    const S = blank({\\n      id: def.id, seed: opts.seed || def.seed || 1, players: opts.players || 1,\\n      difficulty: diff, clock: def.clock * clockMul, vitals: def.vitals, drain: def.drain,\\n      gift: def.doctor === 'sokolova' ? 'look' : def.doctor === 'both' ? 'both' : 'breath',\\n      doctor: def.doctor || 'vale', site: def.site, par: def.par || 1000,\\n1350→      mode: def.mode || 'case', consult: !!def.consult,\\n    });\\n    S.clock0 = S.clock;\\n    if (def.doctor === 'both') S.consult = true;\\n    loadPhase(S, def, opts.phase || 0);\\n    return S;\\n  }\\n\\n  function createRaw(opts) {\\n    const S = blank(opts);\\n1360→    for (const spec of opts.objects || []) addObj(S, clone(spec));\\n    if (opts.strain) spawnStrain(S, opts.strain, opts.strainOpts || {});\\n    if (opts.scripts) S.scripts = opts.scripts.map(a => ({ t: a.t, do: a.do, done: false }));\\n    S.checkpoint = takeCore(S);\\n    return S;\\n  }\\n\\n  function readInputs(S, inputs, dt) {\\n    inputs = inputs || [];\\n    for (let i = 0; i < S.players.length; i++) {\\n1370→      const p = S.players[i];\\n      const inp = inputs[i] || {};\\n      const ox = p.x, oy = p.y;\\n      if (inp.x != null) { p.x = inp.x; p.y = inp.y; p.bx = inp.x; p.by = inp.y; }\\n      if (inp.tool) p.tool = inp.tool;\\n      p.inst = hypot(p.x - ox, p.y - oy) / Math.max(dt, 1e-4);\\n      p.fine = !!inp.fine;\\n      p.mouse = !!inp.mouse;\\n      const trig = inp.trig || 0;\\n      p.trigEdge = trig > 0.3 && p.prevTrig <= 0.3;\\n1380→      p.trigRelease = trig <= 0.3 && p.prevTrig > 0.3;\\n      p.prevTrig = trig;\\n      p.trig = trig;\\n      const gift = !!inp.gift;\\n      p.giftEdge = gift && !p.giftPrev;\\n      p.giftPrev = gift;\\n      const consult = !!inp.consult;\\n      p.consultEdge = consult && !p.consultPrev;\\n      p.consultPrev = consult;\\n      p.cancelEdge = !!inp.cancel;\\n1390→      if (p.cancelEdge) { p.held = 0; p.stroke = null; }\\n    }\\n  }\\n\\n  function tryGifts(S, tune) {\\n    for (const p of S.players) {\\n      if (!p.giftEdge) continue;\\n      if (S.breath) { S.breath = false; S.worldScale = 1; pushEv(S, ['breath', 0]); continue; }\\n      const doc = S.activeDoc;\\n      const wantLook = doc === 'sokolova' || (S.gift === 'look' && doc !== 'vale');\\n1400→      const wantBreath = doc === 'vale' || S.gift === 'breath' || (S.gift === 'both' && doc === 'vale');\\n      if (S.gift === 'both') {\\n        if (doc === 'sokolova') { if (secondLook(S, tune)) return; }\\n        else if (S.steady >= 35) { S.breath = true; pushEv(S, ['breath', 1]); return; }\\n      } else if (S.gift === 'look' || wantLook && S.gift !== 'breath') {\\n        secondLook(S, tune);\\n      } else if (wantBreath && S.steady >= 35) {\\n        S.breath = true;\\n        pushEv(S, ['breath', 1]);\\n      }\\n1410→    }\\n    for (const p of S.players) {\\n      if (!p.consultEdge || !S.consult) continue;\\n      S.activeDoc = S.activeDoc === 'vale' ? 'sokolova' : 'vale';\\n      pushEv(S, ['consult', S.activeDoc]);\\n    }\\n  }\\n\\n  function stepCodeBlue(S, dt) {\\n    const cb = S.codeBlue;\\n1420→    if (!cb) return;\\n    cb.t += dt;\\n    const peaks = [0.9, 1.8, 2.7, 3.6];\\n    const p = S.players[0];\\n    if (cb.next == null) cb.next = 0;\\n    if (cb.next < 4) {\\n      const peak = peaks[cb.next];\\n      if (p && p.trigEdge) {\\n        const err = Math.abs(cb.t - peak);\\n        cb.attempts += 1;\\n1430→        if (err <= 0.14) {\\n          cb.hits += 1;\\n          if (err <= 0.06) cb.textbook = (cb.textbook || 0) + 1;\\n          pushEv(S, ['shock', cb.hits, err]);\\n        } else pushEv(S, ['miss', err]);\\n        cb.next += 1;\\n      } else if (cb.t > peak + 0.14) {\\n        cb.attempts += 1;\\n        cb.next += 1;\\n        pushEv(S, ['miss', 1]);\\n1440→      }\\n    }\\n    if (cb.next >= 4 && !cb.resolved) {\\n      cb.resolved = true;\\n      S.codeBlue = null;\\n      if (cb.hits >= 2) {\\n        S.vitals = 30;\\n        S.flags.crash = 0;\\n        pushEv(S, ['revived', cb.textbook >= 2 ? 'textbook' : 'clean']);\\n      } else lose(S, 'code');\\n1450→    }\\n  }\\n\\n  function maybeDie(S) {\\n    if (S.won || S.lost || S.codeBlue || S.dressing) return;\\n    if (S.clock <= 0) { lose(S, 'time'); return; }\\n    if (S.vitals <= 0) {\\n      if (S.diff === 'attending' || S.codeBlueUsed) { lose(S, 'vitals'); return; }\\n      S.codeBlueUsed = true;\\n      S.codeBlue = { t: 0, hits: 0, attempts: 0, next: 0, textbook: 0, resolved: false };\\n1460→      S.vitals = 0;\\n      S.breath = false;\\n      pushEv(S, ['codeblue', 1]);\\n    }\\n  }\\n\\n  function stepDressing(S, dt, tune) {\\n    const d = S.dressing;\\n    d.t += dt;\\n    const u = (d.t % 1.2) / 1.2;\\n1470→    const edge = Math.min(u, 1 - u);\\n    const p = S.players[0];\\n    if (p && p.trigEdge) {\\n      const bonus = edge < 0.08 ? 80 : 20;\\n      S.score += bonus;\\n      d.done = true;\\n      pushEv(S, ['stamp', bonus]);\\n      finishCase(S);\\n    } else if (d.t > 4) {\\n      d.done = true;\\n1480→      finishCase(S);\\n    }\\n  }\\n\\n  function step(S, inputs, dt, tune) {\\n    tune = tuneOf(tune);\\n    if (!dt || dt < 0) dt = 0;\\n    S.ev = [];\\n    if (S.won || S.lost) return S;\\n    readInputs(S, inputs, dt);\\n1490→    if (S.codeBlue) { stepCodeBlue(S, dt); return S; }\\n    tryGifts(S, tune);\\n    if (S.breath) {\\n      S.steady = Math.max(0, S.steady - tune.gift.breathDrain * dt);\\n      if (S.steady <= 0) { S.breath = false; pushEv(S, ['breath', 0]); }\\n    }\\n    S.worldScale = S.breath ? tune.gift.breathFactor : 1;\\n    const worldDt = dt * S.worldScale;\\n    if (S.dressing) { stepDressing(S, dt, tune); return S; }\\n\\n1500→    const frozen = S.tutorial && !S.tutDone;\\n    if (!frozen) {\\n      let hazard = 0;\\n      for (const o of S.objects) {\\n        if (o.done || !o.drain) continue;\\n        if (inDome(S, o.x, o.y)) continue;\\n        hazard += o.drain;\\n      }\\n      const bleed = hazard * tune.fluids.bleed * tune.strains.damage;\\n      S.vitals -= (S.drain * tune.patient.drain * diffDrain(S) + bleed) * worldDt;\\n1510→      S.clock -= worldDt * tune.patient.clock / diffClock(S);\\n      S.steady = Math.min(100, S.steady + 0.5 * tune.gift.charge * worldDt);\\n    }\\n    S.t += dt;\\n    S.worldT += frozen ? 0 : worldDt;\\n    S.phaseT += frozen ? 0 : worldDt;\\n\\n    for (const p of S.players) applyTools(S, p, dt, tune);\\n    if (!frozen) {\\n      stepWorld(S, worldDt, dt, tune);\\n1520→      stepStrain(S, worldDt, dt, tune);\\n    }\\n    if (S.ghostT > 0) S.ghostT -= dt;\\n\\n    if (!frozen) {\\n      S.ringAcc += worldDt;\\n      while (S.ringAcc >= 0.1) { S.ringAcc -= 0.1; pushRing(S); }\\n    }\\n\\n    maybeDie(S);\\n1530→    if (!S.lost && !S.won && !S.codeBlue && phaseClear(S)) advancePhase(S);\\n    return S;\\n  }\\n\\n  /* ---------- cursor and wheel ---------- */\\n\\n  function assistOf(S, tune) {\\n    let a = tune.hands.assist;\\n    if (S && S.diff === 'intern') a += 0.2;\\n    if (S && (S.activeDoc === 'sokolova')) a += 0.2;\\n1540→    return clamp(a, 0, 1.4);\\n  }\\n\\n  function jitterOf(S, p) {\\n    const st = S && S.strain;\\n    if (!st || !st.jitter || (S && S.breath)) return [0, 0];\\n    const amp = 5 * (st.amp == null ? 1 : st.amp) * (p.fine ? 0.35 : 1);\\n    return [Math.sin((S.worldT || 0) * 17.3 + p.id) * amp, Math.cos((S.worldT || 0) * 13.1 + p.id * 2) * amp];\\n  }\\n\\n1550→  function validTarget(S, p, tune) {\\n    const rad = tune.hands.magnet;\\n    return nearest(S, p, rad, o => {\\n      if (!canTouch(S, o)) return false;\\n      if (o.type === 'pool') return p.tool === 'suction';\\n      if (o.type === 'nerve' || o.type === 'eloquent' || o.type === 'hold') return false;\\n      if (p.tool === 'sonar') return !!o.hidden;\\n      if (p.tool === 'salve') return !!o.cells;\\n      if (p.tool === 'syringe') return o.type === 'clot' || o.type === 'reed' || o.type === 'voice' || o.type === 'lobe';\\n      if (p.tool === 'cautery') return o.type === 'polyp' || o.type === 'bleeder' || o.type === 'bead' || o.type === 'uvula' || o.type === 'eye' || o.type === 'rupture' || o.type === 'tremass' || o.type === 'barb' || o.type === 'lobe';\\n1560→      if (p.tool === 'forceps') return o.type === 'shard' || o.type === 'fragment' || o.type === 'mass' || o.type === 'hook' || o.type === 'gaff' || o.type === 'cork' || o.type === 'note' || o.type === 'retractor' || o.type === 'screw' || o.type === 'nest';\\n      if (p.tool === 'scalpel') return !!o.guide;\\n      if (p.tool === 'suture') return !!o.pairs;\\n      return false;\\n    });\\n  }\\n\\n  function updateCursor(p, dev, S, dt, tune) {\\n    tune = tuneOf(tune);\\n    dev = dev || {};\\n1570→    if (dev.mouse) {\\n      p.bx = dev.mouse[0]; p.by = dev.mouse[1];\\n      p.x = p.bx; p.y = p.by;\\n      p.fine = !!dev.fine;\\n      return p;\\n    }\\n    const aim = dev.aim || [0, 0];\\n    let mag = hypot(aim[0], aim[1]);\\n    let dirx = mag > 1e-6 ? aim[0] / mag : 0;\\n    let diry = mag > 1e-6 ? aim[1] / mag : 0;\\n1580→    mag = Math.min(1, mag);\\n    const curved = Math.pow(mag, tune.hands.curve);\\n    let speed = curved * tune.hands.cursor;\\n    if (dev.fine) speed *= tune.hands.fine;\\n    if (S && (S.activeDoc === 'vale')) speed *= 1.15;\\n    /* 0.06s ramp */\\n    const k = 1 - Math.exp(-dt / 0.06);\\n    p.speed += (speed - (p.speed || 0)) * (dt > 0 ? k : 1);\\n    let vx = dirx * p.speed;\\n    let vy = diry * p.speed;\\n1590→    const keys = dev.keys || [0, 0];\\n    const keySp = 200 * (dev.fine ? tune.hands.fine : 1);\\n    vx += keys[0] * keySp; vy += keys[1] * keySp;\\n    const nudge = dev.nudge || [0, 0];\\n    vx += nudge[0] * 40; vy += nudge[1] * 40;\\n\\n    const assist = S ? assistOf(S, tune) : tune.hands.assist;\\n    const tgt = S ? validTarget(S, p, tune) : null;\\n    if (tgt && mag < 0.95) {\\n      vx *= 1 - 0.55 * Math.min(1, assist);\\n1600→      vy *= 1 - 0.55 * Math.min(1, assist);\\n      if (mag < 0.12) {\\n        const dx = tgt.x - p.bx, dy = tgt.y - p.by;\\n        const d = hypot(dx, dy) || 1;\\n        const pull = 90 * assist;\\n        vx += (dx / d) * pull; vy += (dy / d) * pull;\\n      }\\n    }\\n    if (S && p.stroke && (p.stroke.kind === 'scalpel' || p.stroke.kind === 'suture')) {\\n      const o = objById(S, p.stroke.id);\\n1610→      let tanv = [1, 0];\\n      if (o && o.guide) tanv = polyDist(o.guide, p.bx, p.by).tan;\\n      else if (p.stroke.kind === 'suture' && o && o.pairs) {\\n        const pair = o.pairs[o.stitch] || o.pairs[0];\\n        const dx = pair[1][0] - pair[0][0], dy = pair[1][1] - pair[0][1];\\n        const L = hypot(dx, dy) || 1;\\n        tanv = [dx / L, dy / L];\\n      }\\n      const along = vx * tanv[0] + vy * tanv[1];\\n      const cx = vx - along * tanv[0], cy = vy - along * tanv[1];\\n1620→      const scale = 1 - 0.8 * Math.min(1, assist);\\n      vx = along * tanv[0] + cx * scale;\\n      vy = along * tanv[1] + cy * scale;\\n    }\\n    p.bx = clamp(p.bx + vx * dt, 8, CFG.FIELD_W - 8);\\n    p.by = clamp(p.by + vy * dt, 8, CFG.FIELD_H - 8);\\n    const j = S ? jitterOf(S, p) : [0, 0];\\n    p.x = p.bx + j[0];\\n    p.y = p.by + j[1];\\n    p.fine = !!dev.fine;\\n1630→    return p;\\n  }\\n\\n  function wheelIndex(x, y) {\\n    const ang = Math.atan2(y, x); /* 0 east, clockwise because y grows downward */\\n    let d = ang - (-Math.PI / 2);\\n    if (d < 0) d += TAU;\\n    if (d >= TAU) d -= TAU;\\n    return Math.round(d / (Math.PI / 4)) % 8;\\n  }\\n1640→\\n  function updateWheel(p, dev, dt) {\\n    dev = dev || {};\\n    if (dev.digit) {\\n      const i = (dev.digit - 1) % 8;\\n      if (p.tool !== CFG.TOOLS[i]) { p.tool = CFG.TOOLS[i]; p.swap = 0.12; }\\n      return p.tool;\\n    }\\n    const m = dev.move || [0, 0];\\n    const mag = hypot(m[0], m[1]);\\n1650→    if (mag < 0.6) { p.wheelT = 0; p.wheelDir = -1; return p.tool; }\\n    const dir = wheelIndex(m[0], m[1]);\\n    if (dir !== p.wheelDir) { p.wheelDir = dir; p.wheelT = 0; }\\n    p.wheelT += dt;\\n    if (p.wheelT >= 0.08 && p.tool !== CFG.TOOLS[dir]) {\\n      p.tool = CFG.TOOLS[dir];\\n      p.swap = 0.12;\\n      p.wheelT = 0;\\n    }\\n    return p.tool;\\n1660→  }\\n\\n  function retryPhase(S) {\\n    if (!S.checkpoint) return false;\\n    restoreCore(S, S.checkpoint, false);\\n    S.rankCap = 'B';\\n    S.lost = false;\\n    S.won = false;\\n    S.codeBlue = null;\\n    S.reason = '';\\n1670→    for (const p of S.players) { p.held = 0; p.stroke = null; }\\n    pushEv(S, ['retry', S.phase]);\\n    return true;\\n  }\\n\\n  GAME.Sim = {\\n    rnd, clamp, clone, addObj, makePlayer, blank, create, createRaw, step,\\n    takeCore, applyCore, hashCore, rankLetter, secondLook, forceRewind, retryPhase,\\n    updateCursor, updateWheel, wheelIndex, spawnStrain, phaseClear, objById,\\n    polyDist, lose, DRAIN,\\n1680→  };\\n  GAME.Op = { create, createRaw, step, takeCore, hash: S => hashCore(takeCore(S)), rankLetter, secondLook, forceRewind, retryPhase, spawnStrain };\\n  GAME.Cursor = { update: updateCursor, jitterOf, assistOf };\\n  GAME.Wheel = { update: updateWheel, index: wheelIndex, TOOLS: CFG.TOOLS };\\n})();\\n\",\"content_concise\":\"1140→  }\\n  function spawnVoice(S, st) {\\n    st.domes = [{ x: 180, y: 120, r: 34, t: 4 }, { x: 240, y: 110, r: 34, t: 5 }];\\n    for (let i = 0; i < 3; i++) addObj(S, { type: 'voice', x: 200 + i * 14, y: 116, hidden: true, order: 1, tag: 'voice', drain: 0.2, window: false });\\n    st.jitter = true; st.amp = 0.6;\\n  }\\n  function spawnCoda(S, st) {\\n    const guide = [];\\n    for (let i = 0; i <= 16; i++) {\\n      const a = i / 16 * Math.PI * 1.6;\\n1150→      guide.push([213 + Math.cos(a) * (20 + i * 3), 116 + Math.sin(a) * (12 + i * 2)]);\\n    }\\n    addObj(S, { type: 'spiral', x: 213, y: 116, guide, order: 1, tag: 'last-note', beatLock: true, drain: 0, ring: false });\\n  }\\n\\n  function spawnStrain(S, kind, opts) {\\n    opts = opts || {};\\n    if (kind === 'staccato') {\\n      const st = { kind, tag: opts.tag || 'stacc', t: 0, beads: [], done: false, collapse: 0 };\\n      const n = opts.nests || 2;\\n1160→      for (let i = 0; i < n; i++) {\\n        addObj(S, { type: 'nest', x: opts.x || (180 + i * 40), y: opts.y || 120, hidden: true, order: 2, tag: st.tag, slash: true, drain: 0.15, r: 8 });\\n      }\\n      const beads = opts.beads || 4;\\n      for (let i = 0; i < beads; i++) {\\n        st.beads.push({ x: 160 + i * 12, y: 90, x0: 160 + i * 12, y0: 90, tx: 170 + (i % 3) * 18, ty: 140, landIn: 0.6 + i * 0.15, flight: 0.7, dead: false, landed: false, hopped: false });\\n      }\\n      S.strain = st;\\n      return st;\\n    }\\n1170→    if (kind === 'legato') {\\n      const seg = opts.segments || 8;\\n      const w = makeWorm(S, opts.x || 150, opts.y || 120, seg, 1);\\n      w.marked = false;\\n      const st = { kind, worms: [w], done: false, snapped: false };\\n      /* head starts hidden: a sonar target */\\n      addObj(S, { type: 'hold', x: w.x, y: w.y, hidden: true, order: 0, tag: 'legato-hide', drain: 0 });\\n      S.strain = st;\\n      return st;\\n    }\\n1180→    if (kind === 'tremolo') {\\n      const st = { kind, t: 0, amp: 1, stage: 1, x: opts.x || 213, y: opts.y || 116, wake: 6, reed0: 5, done: false, jitter: true, beat: 0, flare: false };\\n      for (let i = 0; i < 5; i++) {\\n        const a = -Math.PI / 2 + i * TAU / 5;\\n        addObj(S, { type: 'reed', x: st.x + Math.cos(a) * 28, y: st.y + Math.sin(a) * 18, order: 1, tag: 'reed', drain: 0, window: false });\\n      }\\n      addObj(S, { type: 'tremass', x: st.x, y: st.y, need: 3, order: 3, tag: 'tremass', drain: 0.3 });\\n      S.strain = st;\\n      return st;\\n    }\\n1190→    if (kind === 'dacapo') {\\n      const lobes = [\\n        { id: 'A', mode: 'cautery', period: 6, openFor: 2.5, x: 180, y: 110 },\\n        { id: 'B', mode: 'slash', period: 7, openFor: 2.5, x: 213, y: 130 },\\n        { id: 'C', mode: 'syringe', period: 9, openFor: 3, x: 246, y: 112 },\\n      ];\\n      const st = { kind, t: 0, round: 1, count: -1, lobes, done: false, repeated: 0 };\\n      for (const L of lobes) {\\n        const spec = { type: 'lobe', x: L.x, y: L.y, mode: L.mode === 'slash' ? 'scalpel' : L.mode, order: 1, tag: 'lobe-' + L.id, open: false, drain: 0.15, need: L.mode === 'cautery' ? 1 : 0.5 };\\n        if (L.mode === 'slash') { spec.guide = [[L.x - 10, L.y], [L.x + 10, L.y]]; spec.mode = 'scalpel'; spec.slash = true; }\\n1200→        if (L.mode === 'syringe') { spec.mode = 'syringe'; spec.follow = 'salve'; }\\n        const o = addObj(S, spec);\\n        L.oid = o.id; L.dead = false; L.open = false;\\n      }\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'fermata') {\\n      const st = { kind, t: 0, stage: 1, hits: 0, eyeOpen: 0, done: false, jitter: false, amp: 0,\\n        domes: [{ x: 200, y: 116, r: 34, t: 5 }],\\n1210→        eye: { x: 200, y: 116, open: false, hidden: false } };\\n      const o = addObj(S, { type: 'eye', x: 200, y: 116, need: 0.3, order: 1, tag: 'eye', open: false, drain: 0.2 });\\n      st.eye.oid = o.id;\\n      addObj(S, { type: 'eloquent', x: 150, y: 100, guide: [[140, 90], [180, 110]], order: 0, drain: 0, tag: 'eloq' });\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'cantor') {\\n      const st = { kind, t: 0, move: 1, done: false, signs: 0, jitter: false, amp: 0.4, domes: [] };\\n      for (let i = 0; i < 3; i++) addObj(S, { type: 'tendril', x: 170 + i * 30, y: 100, len: 28, order: 1, tag: 'tendril', drain: 0.15, guide: [[160 + i * 30, 100], [190 + i * 30, 108]] });\\n1220→      for (let i = 0; i < 3; i++) addObj(S, { type: 'uvula', x: 180 + i * 26, y: 140, need: 1.5, order: 2, tag: 'uvula', drain: 0.2 });\\n      S.strain = st;\\n      return st;\\n    }\\n    return null;\\n  }\\n\\n  /* ---------- phase / scripts ---------- */\\n\\n  function phaseClear(S) {\\n1230→    if (S.strain && !S.strain.done) return false;\\n    for (const o of S.objects) {\\n      if (o.done || !o.alive) continue;\\n      if (o.type === 'nerve' || o.type === 'eloquent' || o.type === 'hold') continue;\\n      if (o.optional) continue;\\n      if (o.type === 'bead') continue;\\n      return false;\\n    }\\n    if (S.strain && S.strain.kind === 'staccato') {\\n      const live = (S.strain.beads || []).some(b => !b.dead);\\n1240→      if (live && !S.strain.done) return false;\\n    }\\n    return true;\\n  }\\n\\n  function runScript(S, id, tune) {\\n    if (id === 'dip') { S.flags.dip = 40; }\\n    else if (id === 'crash') { S.flags.crash = 8; }\\n    else if (id === 'breath') { S.flags.needBreath = true; }\\n    else if (id === 'look') { S.flags.needLook = true; }\\n1250→    else if (id === 'lurch') {\\n      slip(S, S.players[0], 'lurch', 3, tune);\\n      for (const o of S.objects) if (!o.done) { o.x += 10; o.y += 4; if (o.origin) { o.origin = [o.origin[0] + 10, o.origin[1] + 4]; } }\\n      S.flags.needLook = true;\\n      pushEv(S, ['lurch', 1]);\\n    } else if (id === 'blackout') { S.dim = 1; }\\n    else if (id === 'roll') { S.tiltAmp = 1; }\\n    else if (id === 'quiet') { S.flags.quiet = true; S.flags.needBreath = true; }\\n    else if (id === 'refill') { S.clock += 120; }\\n    else if (id === 'cantorRewind') { forceRewind(S, true); }\\n1260→    else if (id === 'code') { S.vitals = 0; }\\n  }\\n\\n  function stepWorld(S, worldDt, handDt, tune) {\\n    if (S.flags.dip) {\\n      S.vitals += (S.flags.dip - S.vitals) * Math.min(1, worldDt * 2);\\n      if (Math.abs(S.vitals - S.flags.dip) < 0.4) { S.vitals = S.flags.dip; S.flags.dip = 0; }\\n    }\\n    if (S.flags.crash) {\\n      S.vitals -= S.flags.crash * worldDt;\\n1270→    }\\n    if (S.tiltAmp) {\\n      const drift = Math.sin(S.worldT * 0.7) * 25 * S.tiltAmp;\\n      for (const o of S.objects) if (o.type === 'pool' && !o.done) {\\n        o.x = clamp(o.x + drift * worldDt, 60, 360);\\n      }\\n    }\\n    for (const o of S.objects) {\\n      if (o.markT > 0) { o.markT -= handDt; if (o.markT <= 0 && o.hidden) o.marked = false; }\\n      if (o.type === 'bleeder' && !o.done) {\\n1280→        let pool = S.objects.find(p => p.type === 'pool' && p.tag === 'fed-' + o.id);\\n        if (!pool) pool = addObj(S, { type: 'pool', x: o.x, y: o.y + 8, vol: 4, max: 40, order: o.order + 1, tag: 'fed-' + o.id, drain: 0 });\\n        if (!pool.done) pool.vol = Math.min(pool.max, pool.vol + 6 * worldDt * tune.fluids.bleed);\\n      }\\n      if (o.type === 'arteryTear' && !o.done) {\\n        let pool = S.objects.find(p => p.type === 'pool' && p.tag === 'fed-' + o.id);\\n        if (!pool) pool = addObj(S, { type: 'pool', x: o.x, y: o.y + 6, vol: 6, max: 50, order: o.order + 1, tag: 'fed-' + o.id, drain: 0 });\\n        if (!pool.done) pool.vol = Math.min(pool.max, pool.vol + 14 * worldDt * tune.fluids.bleed);\\n      }\\n    }\\n1290→    /* solo retractor: Quill holds at half the window */\\n    const retract = S.objects.find(o => o.type === 'retractor' && !o.done);\\n    if (retract) {\\n      const holder = S.players.some(p => p.held === retract.id && p.trig > 0.3);\\n      if (holder) S.windowOpen = 1;\\n      else if (S.players.filter(p => !p.gone).length <= 1) S.windowOpen = 0.5;\\n      else S.windowOpen = 0;\\n    }\\n    for (let i = 0; i < S.scripts.length; i++) {\\n      const sc = S.scripts[i];\\n1300→      if (sc.done) continue;\\n      if (S.phaseT >= sc.t) { sc.done = true; runScript(S, sc.do, tune); }\\n    }\\n  }\\n\\n  function loadPhase(S, def, index) {\\n    const ph = def.phases[index];\\n    S.phase = index;\\n    S.phaseCount = def.phases.length;\\n    S.phaseName = ph.name;\\n1310→    S.phaseT = 0;\\n    S.objects = S.objects.filter(o => o.persist);\\n    S.strain = null;\\n    S.scripts = (ph.at || []).map(a => ({ t: a.t, do: a.do, done: false }));\\n    S.tutorial = !!ph.tutorial;\\n    S.tutDone = !ph.tutorial;\\n    S.flags = Object.assign({}, S.flags, ph.flags || {});\\n    if (ph.dim != null) S.dim = ph.dim;\\n    if (ph.tilt) S.tiltAmp = ph.tilt;\\n    for (const spec of ph.objects || []) addObj(S, clone(spec));\\n1320→    if (ph.strain) spawnStrain(S, ph.strain, ph.strainOpts || {});\\n    if (ph.onEnter) runScript(S, ph.onEnter, tuneOf(null));\\n    S.checkpoint = takeCore(S);\\n    /* drop the checkpoint's nested copy weight: checkpoint is the core itself */\\n    pushEv(S, ['phase', index, ph.name]);\\n  }\\n\\n  function advancePhase(S) {\\n    const def = (GAME.CASES || {})[S.id];\\n    if (!def) { finishCase(S); return; }\\n1330→    if (S.phase + 1 >= def.phases.length) {\\n      if (!S.dressing && !S.won) {\\n        S.dressing = { t: 0, done: false };\\n        pushEv(S, ['dressing', 1]);\\n        return;\\n      }\\n      return;\\n    }\\n    loadPhase(S, def, S.phase + 1);\\n  }\\n1340→\\n  function create(def, opts) {\\n    opts = opts || {};\\n    const diff = opts.difficulty || opts.diff || 'resident';\\n    const clockMul = diff === 'intern' ? 1.3 : diff === 'attending' ? 0.8 : 1;\\n    const S = blank({\\n      id: def.id, seed: opts.seed || def.seed || 1, players: opts.players || 1,\\n      difficulty: diff, clock: def.clock * clockMul, vitals: def.vitals, drain: def.drain,\\n      gift: def.doctor === 'sokolova' ? 'look' : def.doctor === 'both' ? 'both' : 'breath',\\n      doctor: def.doctor || 'vale', site: def.site, par: def.par || 1000,\\n1350→      mode: def.mode || 'case', consult: !!def.consult,\\n    });\\n    S.clock0 = S.clock;\\n    if (def.doctor === 'both') S.consult = true;\\n    loadPhase(S, def, opts.phase || 0);\\n    return S;\\n  }\\n\\n  function createRaw(opts) {\\n    const S = blank(opts);\\n1360→    for (const spec of opts.objects || []) addObj(S, clone(spec));\\n    if (opts.strain) spawnStrain(S, opts.strain, opts.strainOpts || {});\\n    if (opts.scripts) S.scripts = opts.scripts.map(a => ({ t: a.t, do: a.do, done: false }));\\n    S.checkpoint = takeCore(S);\\n    return S;\\n  }\\n\\n  function readInputs(S, inputs, dt) {\\n    inputs = inputs || [];\\n    for (let i = 0; i < S.players.length; i++) {\\n1370→      const p = S.players[i];\\n      const inp = inputs[i] || {};\\n      const ox = p.x, oy = p.y;\\n      if (inp.x != null) { p.x = inp.x; p.y = inp.y; p.bx = inp.x; p.by = inp.y; }\\n      if (inp.tool) p.tool = inp.tool;\\n      p.inst = hypot(p.x - ox, p.y - oy) / Math.max(dt, 1e-4);\\n      p.fine = !!inp.fine;\\n      p.mouse = !!inp.mouse;\\n      const trig = inp.trig || 0;\\n      p.trigEdge = trig > 0.3 && p.prevTrig <= 0.3;\\n1380→      p.trigRelease = trig <= 0.3 && p.prevTrig > 0.3;\\n      p.prevTrig = trig;\\n      p.trig = trig;\\n      const gift = !!inp.gift;\\n      p.giftEdge = gift && !p.giftPrev;\\n      p.giftPrev = gift;\\n      const consult = !!inp.consult;\\n      p.consultEdge = consult && !p.consultPrev;\\n      p.consultPrev = consult;\\n      p.cancelEdge = !!inp.cancel;\\n1390→      if (p.cancelEdge) { p.held = 0; p.stroke = null; }\\n    }\\n  }\\n\\n  function tryGifts(S, tune) {\\n    for (const p of S.players) {\\n      if (!p.giftEdge) continue;\\n      if (S.breath) { S.breath = false; S.worldScale = 1; pushEv(S, ['breath', 0]); continue; }\\n      const doc = S.activeDoc;\\n      const wantLook = doc === 'sokolova' || (S.gift === 'look' && doc !== 'vale');\\n1400→      const wantBreath = doc === 'vale' || S.gift === 'breath' || (S.gift === 'both' && doc === 'vale');\\n      if (S.gift === 'both') {\\n        if (doc === 'sokolova') { if (secondLook(S, tune)) return; }\\n        else if (S.steady >= 35) { S.breath = true; pushEv(S, ['breath', 1]); return; }\\n      } else if (S.gift === 'look' || wantLook && S.gift !== 'breath') {\\n        secondLook(S, tune);\\n      } else if (wantBreath && S.steady >= 35) {\\n        S.breath = true;\\n        pushEv(S, ['breath', 1]);\\n      }\\n1410→    }\\n    for (const p of S.players) {\\n      if (!p.consultEdge || !S.consult) continue;\\n      S.activeDoc = S.activeDoc === 'vale' ? 'sokolova' : 'vale';\\n      pushEv(S, ['consult', S.activeDoc]);\\n    }\\n  }\\n\\n  function stepCodeBlue(S, dt) {\\n    const cb = S.codeBlue;\\n1420→    if (!cb) return;\\n    cb.t += dt;\\n    const peaks = [0.9, 1.8, 2.7, 3.6];\\n    const p = S.players[0];\\n    if (cb.next == null) cb.next = 0;\\n    if (cb.next < 4) {\\n      const peak = peaks[cb.next];\\n      if (p && p.trigEdge) {\\n        const err = Math.abs(cb.t - peak);\\n        cb.attempts += 1;\\n1430→        if (err <= 0.14) {\\n          cb.hits += 1;\\n          if (err <= 0.06) cb.textbook = (cb.textbook || 0) + 1;\\n          pushEv(S, ['shock', cb.hits, err]);\\n        } else pushEv(S, ['miss', err]);\\n        cb.next += 1;\\n      } else if (cb.t > peak + 0.14) {\\n        cb.attempts += 1;\\n        cb.next += 1;\\n        pushEv(S, ['miss', 1]);\\n1440→      }\\n    }\\n    if (cb.next >= 4 && !cb.resolved) {\\n      cb.resolved = true;\\n      S.codeBlue = null;\\n      if (cb.hits >= 2) {\\n        S.vitals = 30;\\n        S.flags.crash = 0;\\n        pushEv(S, ['revived', cb.textbook >= 2 ? 'textbook' : 'clean']);\\n      } else lose(S, 'code');\\n1450→    }\\n  }\\n\\n  function maybeDie(S) {\\n    if (S.won || S.lost || S.codeBlue || S.dressing) return;\\n    if (S.clock <= 0) { lose(S, 'time'); return; }\\n    if (S.vitals <= 0) {\\n      if (S.diff === 'attending' || S.codeBlueUsed) { lose(S, 'vitals'); return; }\\n      S.codeBlueUsed = true;\\n      S.codeBlue = { t: 0, hits: 0, attempts: 0, next: 0, textbook: 0, resolved: false };\\n1460→      S.vitals = 0;\\n      S.breath = false;\\n      pushEv(S, ['codeblue', 1]);\\n    }\\n  }\\n\\n  function stepDressing(S, dt, tune) {\\n    const d = S.dressing;\\n    d.t += dt;\\n    const u = (d.t % 1.2) / 1.2;\\n1470→    const edge = Math.min(u, 1 - u);\\n    const p = S.players[0];\\n    if (p && p.trigEdge) {\\n      const bonus = edge < 0.08 ? 80 : 20;\\n      S.score += bonus;\\n      d.done = true;\\n      pushEv(S, ['stamp', bonus]);\\n      finishCase(S);\\n    } else if (d.t > 4) {\\n      d.done = true;\\n1480→      finishCase(S);\\n    }\\n  }\\n\\n  function step(S, inputs, dt, tune) {\\n    tune = tuneOf(tune);\\n    if (!dt || dt < 0) dt = 0;\\n    S.ev = [];\\n    if (S.won || S.lost) return S;\\n    readInputs(S, inputs, dt);\\n1490→    if (S.codeBlue) { stepCodeBlue(S, dt); return S; }\\n    tryGifts(S, tune);\\n    if (S.breath) {\\n      S.steady = Math.max(0, S.steady - tune.gift.breathDrain * dt);\\n      if (S.steady <= 0) { S.breath = false; pushEv(S, ['breath', 0]); }\\n    }\\n    S.worldScale = S.breath ? tune.gift.breathFactor : 1;\\n    const worldDt = dt * S.worldScale;\\n    if (S.dressing) { stepDressing(S, dt, tune); return S; }\\n\\n1500→    const frozen = S.tutorial && !S.tutDone;\\n    if (!frozen) {\\n      let hazard = 0;\\n      for (const o of S.objects) {\\n        if (o.done || !o.drain) continue;\\n        if (inDome(S, o.x, o.y)) continue;\\n        hazard += o.drain;\\n      }\\n      const bleed = hazard * tune.fluids.bleed * tune.strains.damage;\\n      S.vitals -= (S.drain * tune.patient.drain * diffDrain(S) + bleed) * worldDt;\\n1510→      S.clock -= worldDt * tune.patient.clock / diffClock(S);\\n      S.steady = Math.min(100, S.steady + 0.5 * tune.gift.charge * worldDt);\\n    }\\n    S.t += dt;\\n    S.worldT += frozen ? 0 : worldDt;\\n    S.phaseT += frozen ? 0 : worldDt;\\n\\n    for (const p of S.players) applyTools(S, p, dt, tune);\\n    if (!frozen) {\\n      stepWorld(S, worldDt, dt, tune);\\n1520→      stepStrain(S, worldDt, dt, tune);\\n    }\\n    if (S.ghostT > 0) S.ghostT -= dt;\\n\\n    if (!frozen) {\\n      S.ringAcc += worldDt;\\n      while (S.ringAcc >= 0.1) { S.ringAcc -= 0.1; pushRing(S); }\\n    }\\n\\n    maybeDie(S);\\n1530→    if (!S.lost && !S.won && !S.codeBlue && phaseClear(S)) advancePhase(S);\\n    return S;\\n  }\\n\\n  /* ---------- cursor and wheel ---------- */\\n\\n  function assistOf(S, tune) {\\n    let a = tune.hands.assist;\\n    if (S && S.diff === 'intern') a += 0.2;\\n    if (S && (S.activeDoc === 'sokolova')) a += 0.2;\\n1540→    return clamp(a, 0, 1.4);\\n  }\\n\\n  function jitterOf(S, p) {\\n    const st = S && S.strain;\\n    if (!st || !st.jitter || (S && S.breath)) return [0, 0];\\n    const amp = 5 * (st.amp == null ? 1 : st.amp) * (p.fine ? 0.35 : 1);\\n    return [Math.sin((S.worldT || 0) * 17.3 + p.id) * amp, Math.cos((S.worldT || 0) * 13.1 + p.id * 2) * amp];\\n  }\\n\\n1550→  function validTarget(S, p, tune) {\\n    const rad = tune.hands.magnet;\\n    return nearest(S, p, rad, o => {\\n      if (!canTouch(S, o)) return false;\\n      if (o.type === 'pool') return p.tool === 'suction';\\n      if (o.type === 'nerve' || o.type === 'eloquent' || o.type === 'hold') return false;\\n      if (p.tool === 'sonar') return !!o.hidden;\\n      if (p.tool === 'salve') return !!o.cells;\\n      if (p.tool === 'syringe') return o.type === 'clot' || o.type === 'reed' || o.type === 'voice' || o.type === 'lobe';\\n      if (p.tool === 'cautery') return o.type === 'polyp' || o.type === 'bleeder' || o.type === 'bead' || o.type === 'uvula' || o.type === 'eye' || o.type === 'rupture' || o.type === 'tremass' || o.type === 'barb' || o.type === 'lobe';\\n1560→      if (p.tool === 'forceps') return o.type === 'shard' || o.type === 'fragment' || o.type === 'mass' || o.type === 'hook' || o.type === 'gaff' || o.type === 'cork' || o.type === 'note' || o.type === 'retractor' || o.type === 'screw' || o.type === 'nest';\\n      if (p.tool === 'scalpel') return !!o.guide;\\n      if (p.tool === 'suture') return !!o.pairs;\\n      return false;\\n    });\\n  }\\n\\n  function updateCursor(p, dev, S, dt, tune) {\\n    tune = tuneOf(tune);\\n    dev = dev || {};\\n1570→    if (dev.mouse) {\\n      p.bx = dev.mouse[0]; p.by = dev.mouse[1];\\n      p.x = p.bx; p.y = p.by;\\n      p.fine = !!dev.fine;\\n      return p;\\n    }\\n    const aim = dev.aim || [0, 0];\\n    let mag = hypot(aim[0], aim[1]);\\n    let dirx = mag > 1e-6 ? aim[0] / mag : 0;\\n    let diry = mag > 1e-6 ? aim[1] / mag : 0;\\n1580→    mag = Math.min(1, mag);\\n    const curved = Math.pow(mag, tune.hands.curve);\\n    let speed = curved * tune.hands.cursor;\\n    if (dev.fine) speed *= tune.hands.fine;\\n    if (S && (S.activeDoc === 'vale')) speed *= 1.15;\\n    /* 0.06s ramp */\\n    const k = 1 - Math.exp(-dt / 0.06);\\n    p.speed += (speed - (p.speed || 0)) * (dt > 0 ? k : 1);\\n    let vx = dirx * p.speed;\\n    let vy = diry * p.speed;\\n1590→    const keys = dev.keys || [0, 0];\\n    const keySp = 200 * (dev.fine ? tune.hands.fine : 1);\\n    vx += keys[0] * keySp; vy += keys[1] * keySp;\\n    const nudge = dev.nudge || [0, 0];\\n    vx += nudge[0] * 40; vy += nudge[1] * 40;\\n\\n    const assist = S ? assistOf(S, tune) : tune.hands.assist;\\n    const tgt = S ? validTarget(S, p, tune) : null;\\n    if (tgt && mag < 0.95) {\\n      vx *= 1 - 0.55 * Math.min(1, assist);\\n1600→      vy *= 1 - 0.55 * Math.min(1, assist);\\n      if (mag < 0.12) {\\n        const dx = tgt.x - p.bx, dy = tgt.y - p.by;\\n        const d = hypot(dx, dy) || 1;\\n        const pull = 90 * assist;\\n        vx += (dx / d) * pull; vy += (dy / d) * pull;\\n      }\\n    }\\n    if (S && p.stroke && (p.stroke.kind === 'scalpel' || p.stroke.kind === 'suture')) {\\n      const o = objById(S, p.stroke.id);\\n1610→      let tanv = [1, 0];\\n      if (o && o.guide) tanv = polyDist(o.guide, p.bx, p.by).tan;\\n      else if (p.stroke.kind === 'suture' && o && o.pairs) {\\n        const pair = o.pairs[o.stitch] || o.pairs[0];\\n        const dx = pair[1][0] - pair[0][0], dy = pair[1][1] - pair[0][1];\\n        const L = hypot(dx, dy) || 1;\\n        tanv = [dx / L, dy / L];\\n      }\\n      const along = vx * tanv[0] + vy * tanv[1];\\n      const cx = vx - along * tanv[0], cy = vy - along * tanv[1];\\n1620→      const scale = 1 - 0.8 * Math.min(1, assist);\\n      vx = along * tanv[0] + cx * scale;\\n      vy = along * tanv[1] + cy * scale;\\n    }\\n    p.bx = clamp(p.bx + vx * dt, 8, CFG.FIELD_W - 8);\\n    p.by = clamp(p.by + vy * dt, 8, CFG.FIELD_H - 8);\\n    const j = S ? jitterOf(S, p) : [0, 0];\\n    p.x = p.bx + j[0];\\n    p.y = p.by + j[1];\\n    p.fine = !!dev.fine;\\n1630→    return p;\\n  }\\n\\n  function wheelIndex(x, y) {\\n    const ang = Math.atan2(y, x); /* 0 east, clockwise because y grows downward */\\n    let d = ang - (-Math.PI / 2);\\n    if (d < 0) d += TAU;\\n    if (d >= TAU) d -= TAU;\\n    return Math.round(d / (Math.PI / 4)) % 8;\\n  }\\n1640→\\n  function updateWheel(p, dev, dt) {\\n    dev = dev || {};\\n    if (dev.digit) {\\n      const i = (dev.digit - 1) % 8;\\n      if (p.tool !== CFG.TOOLS[i]) { p.tool = CFG.TOOLS[i]; p.swap = 0.12; }\\n      return p.tool;\\n    }\\n    const m = dev.move || [0, 0];\\n    const mag = hypot(m[0], m[1]);\\n1650→    if (mag < 0.6) { p.wheelT = 0; p.wheelDir = -1; return p.tool; }\\n    const dir = wheelIndex(m[0], m[1]);\\n    if (dir !== p.wheelDir) { p.wheelDir = dir; p.wheelT = 0; }\\n    p.wheelT += dt;\\n    if (p.wheelT >= 0.08 && p.tool !== CFG.TOOLS[dir]) {\\n      p.tool = CFG.TOOLS[dir];\\n      p.swap = 0.12;\\n      p.wheelT = 0;\\n    }\\n    return p.tool;\\n1660→  }\\n\\n  function retryPhase(S) {\\n    if (!S.checkpoint) return false;\\n    restoreCore(S, S.checkpoint, false);\\n    S.rankCap = 'B';\\n    S.lost = false;\\n    S.won = false;\\n    S.codeBlue = null;\\n    S.reason = '';\\n1670→    for (const p of S.players) { p.held = 0; p.stroke = null; }\\n    pushEv(S, ['retry', S.phase]);\\n    return true;\\n  }\\n\\n  GAME.Sim = {\\n    rnd, clamp, clone, addObj, makePlayer, blank, create, createRaw, step,\\n    takeCore, applyCore, hashCore, rankLetter, secondLook, forceRewind, retryPhase,\\n    updateCursor, updateWheel, wheelIndex, spawnStrain, phaseClear, objById,\\n    polyDist, lose, DRAIN,\\n1680→  };\\n  GAME.Op = { create, createRaw, step, takeCore, hash: S => hashCore(takeCore(S)), rankLetter, secondLook, forceRewind, retryPhase, spawnStrain };\\n  GAME.Cursor = { update: updateCursor, jitterOf, assistOf };\\n  GAME.Wheel = { update: updateWheel, index: wheelIndex, TOOLS: CFG.TOOLS };\\n})();\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/core/sim.js\",\"offset\":1140,\"limit\":550,\"raw_output\":\"  }\\n  function spawnVoice(S, st) {\\n    st.domes = [{ x: 180, y: 120, r: 34, t: 4 }, { x: 240, y: 110, r: 34, t: 5 }];\\n    for (let i = 0; i < 3; i++) addObj(S, { type: 'voice', x: 200 + i * 14, y: 116, hidden: true, order: 1, tag: 'voice', drain: 0.2, window: false });\\n    st.jitter = true; st.amp = 0.6;\\n  }\\n  function spawnCoda(S, st) {\\n    const guide = [];\\n    for (let i = 0; i <= 16; i++) {\\n      const a = i / 16 * Math.PI * 1.6;\\n      guide.push([213 + Math.cos(a) * (20 + i * 3), 116 + Math.sin(a) * (12 + i * 2)]);\\n    }\\n    addObj(S, { type: 'spiral', x: 213, y: 116, guide, order: 1, tag: 'last-note', beatLock: true, drain: 0, ring: false });\\n  }\\n\\n  function spawnStrain(S, kind, opts) {\\n    opts = opts || {};\\n    if (kind === 'staccato') {\\n      const st = { kind, tag: opts.tag || 'stacc', t: 0, beads: [], done: false, collapse: 0 };\\n      const n = opts.nests || 2;\\n      for (let i = 0; i < n; i++) {\\n        addObj(S, { type: 'nest', x: opts.x || (180 + i * 40), y: opts.y || 120, hidden: true, order: 2, tag: st.tag, slash: true, drain: 0.15, r: 8 });\\n      }\\n      const beads = opts.beads || 4;\\n      for (let i = 0; i < beads; i++) {\\n        st.beads.push({ x: 160 + i * 12, y: 90, x0: 160 + i * 12, y0: 90, tx: 170 + (i % 3) * 18, ty: 140, landIn: 0.6 + i * 0.15, flight: 0.7, dead: false, landed: false, hopped: false });\\n      }\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'legato') {\\n      const seg = opts.segments || 8;\\n      const w = makeWorm(S, opts.x || 150, opts.y || 120, seg, 1);\\n      w.marked = false;\\n      const st = { kind, worms: [w], done: false, snapped: false };\\n      /* head starts hidden: a sonar target */\\n      addObj(S, { type: 'hold', x: w.x, y: w.y, hidden: true, order: 0, tag: 'legato-hide', drain: 0 });\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'tremolo') {\\n      const st = { kind, t: 0, amp: 1, stage: 1, x: opts.x || 213, y: opts.y || 116, wake: 6, reed0: 5, done: false, jitter: true, beat: 0, flare: false };\\n      for (let i = 0; i < 5; i++) {\\n        const a = -Math.PI / 2 + i * TAU / 5;\\n        addObj(S, { type: 'reed', x: st.x + Math.cos(a) * 28, y: st.y + Math.sin(a) * 18, order: 1, tag: 'reed', drain: 0, window: false });\\n      }\\n      addObj(S, { type: 'tremass', x: st.x, y: st.y, need: 3, order: 3, tag: 'tremass', drain: 0.3 });\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'dacapo') {\\n      const lobes = [\\n        { id: 'A', mode: 'cautery', period: 6, openFor: 2.5, x: 180, y: 110 },\\n        { id: 'B', mode: 'slash', period: 7, openFor: 2.5, x: 213, y: 130 },\\n        { id: 'C', mode: 'syringe', period: 9, openFor: 3, x: 246, y: 112 },\\n      ];\\n      const st = { kind, t: 0, round: 1, count: -1, lobes, done: false, repeated: 0 };\\n      for (const L of lobes) {\\n        const spec = { type: 'lobe', x: L.x, y: L.y, mode: L.mode === 'slash' ? 'scalpel' : L.mode, order: 1, tag: 'lobe-' + L.id, open: false, drain: 0.15, need: L.mode === 'cautery' ? 1 : 0.5 };\\n        if (L.mode === 'slash') { spec.guide = [[L.x - 10, L.y], [L.x + 10, L.y]]; spec.mode = 'scalpel'; spec.slash = true; }\\n        if (L.mode === 'syringe') { spec.mode = 'syringe'; spec.follow = 'salve'; }\\n        const o = addObj(S, spec);\\n        L.oid = o.id; L.dead = false; L.open = false;\\n      }\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'fermata') {\\n      const st = { kind, t: 0, stage: 1, hits: 0, eyeOpen: 0, done: false, jitter: false, amp: 0,\\n        domes: [{ x: 200, y: 116, r: 34, t: 5 }],\\n        eye: { x: 200, y: 116, open: false, hidden: false } };\\n      const o = addObj(S, { type: 'eye', x: 200, y: 116, need: 0.3, order: 1, tag: 'eye', open: false, drain: 0.2 });\\n      st.eye.oid = o.id;\\n      addObj(S, { type: 'eloquent', x: 150, y: 100, guide: [[140, 90], [180, 110]], order: 0, drain: 0, tag: 'eloq' });\\n      S.strain = st;\\n      return st;\\n    }\\n    if (kind === 'cantor') {\\n      const st = { kind, t: 0, move: 1, done: false, signs: 0, jitter: false, amp: 0.4, domes: [] };\\n      for (let i = 0; i < 3; i++) addObj(S, { type: 'tendril', x: 170 + i * 30, y: 100, len: 28, order: 1, tag: 'tendril', drain: 0.15, guide: [[160 + i * 30, 100], [190 + i * 30, 108]] });\\n      for (let i = 0; i < 3; i++) addObj(S, { type: 'uvula', x: 180 + i * 26, y: 140, need: 1.5, order: 2, tag: 'uvula', drain: 0.2 });\\n      S.strain = st;\\n      return st;\\n    }\\n    return null;\\n  }\\n\\n  /* ---------- phase / scripts ---------- */\\n\\n  function phaseClear(S) {\\n    if (S.strain && !S.strain.done) return false;\\n    for (const o of S.objects) {\\n      if (o.done || !o.alive) continue;\\n      if (o.type === 'nerve' || o.type === 'eloquent' || o.type === 'hold') continue;\\n      if (o.optional) continue;\\n      if (o.type === 'bead') continue;\\n      return false;\\n    }\\n    if (S.strain && S.strain.kind === 'staccato') {\\n      const live = (S.strain.beads || []).some(b => !b.dead);\\n      if (live && !S.strain.done) return false;\\n    }\\n    return true;\\n  }\\n\\n  function runScript(S, id, tune) {\\n    if (id === 'dip') { S.flags.dip = 40; }\\n    else if (id === 'crash') { S.flags.crash = 8; }\\n    else if (id === 'breath') { S.flags.needBreath = true; }\\n    else if (id === 'look') { S.flags.needLook = true; }\\n    else if (id === 'lurch') {\\n      slip(S, S.players[0], 'lurch', 3, tune);\\n      for (const o of S.objects) if (!o.done) { o.x += 10; o.y += 4; if (o.origin) { o.origin = [o.origin[0] + 10, o.origin[1] + 4]; } }\\n      S.flags.needLook = true;\\n      pushEv(S, ['lurch', 1]);\\n    } else if (id === 'blackout') { S.dim = 1; }\\n    else if (id === 'roll') { S.tiltAmp = 1; }\\n    else if (id === 'quiet') { S.flags.quiet = true; S.flags.needBreath = true; }\\n    else if (id === 'refill') { S.clock += 120; }\\n    else if (id === 'cantorRewind') { forceRewind(S, true); }\\n    else if (id === 'code') { S.vitals = 0; }\\n  }\\n\\n  function stepWorld(S, worldDt, handDt, tune) {\\n    if (S.flags.dip) {\\n      S.vitals += (S.flags.dip - S.vitals) * Math.min(1, worldDt * 2);\\n      if (Math.abs(S.vitals - S.flags.dip) < 0.4) { S.vitals = S.flags.dip; S.flags.dip = 0; }\\n    }\\n    if (S.flags.crash) {\\n      S.vitals -= S.flags.crash * worldDt;\\n    }\\n    if (S.tiltAmp) {\\n      const drift = Math.sin(S.worldT * 0.7) * 25 * S.tiltAmp;\\n      for (const o of S.objects) if (o.type === 'pool' && !o.done) {\\n        o.x = clamp(o.x + drift * worldDt, 60, 360);\\n      }\\n    }\\n    for (const o of S.objects) {\\n      if (o.markT > 0) { o.markT -= handDt; if (o.markT <= 0 && o.hidden) o.marked = false; }\\n      if (o.type === 'bleeder' && !o.done) {\\n        let pool = S.objects.find(p => p.type === 'pool' && p.tag === 'fed-' + o.id);\\n        if (!pool) pool = addObj(S, { type: 'pool', x: o.x, y: o.y + 8, vol: 4, max: 40, order: o.order + 1, tag: 'fed-' + o.id, drain: 0 });\\n        if (!pool.done) pool.vol = Math.min(pool.max, pool.vol + 6 * worldDt * tune.fluids.bleed);\\n      }\\n      if (o.type === 'arteryTear' && !o.done) {\\n        let pool = S.objects.find(p => p.type === 'pool' && p.tag === 'fed-' + o.id);\\n        if (!pool) pool = addObj(S, { type: 'pool', x: o.x, y: o.y + 6, vol: 6, max: 50, order: o.order + 1, tag: 'fed-' + o.id, drain: 0 });\\n        if (!pool.done) pool.vol = Math.min(pool.max, pool.vol + 14 * worldDt * tune.fluids.bleed);\\n      }\\n    }\\n    /* solo retractor: Quill holds at half the window */\\n    const retract = S.objects.find(o => o.type === 'retractor' && !o.done);\\n    if (retract) {\\n      const holder = S.players.some(p => p.held === retract.id && p.trig > 0.3);\\n      if (holder) S.windowOpen = 1;\\n      else if (S.players.filter(p => !p.gone).length <= 1) S.windowOpen = 0.5;\\n      else S.windowOpen = 0;\\n    }\\n    for (let i = 0; i < S.scripts.length; i++) {\\n      const sc = S.scripts[i];\\n      if (sc.done) continue;\\n      if (S.phaseT >= sc.t) { sc.done = true; runScript(S, sc.do, tune); }\\n    }\\n  }\\n\\n  function loadPhase(S, def, index) {\\n    const ph = def.phases[index];\\n    S.phase = index;\\n    S.phaseCount = def.phases.length;\\n    S.phaseName = ph.name;\\n    S.phaseT = 0;\\n    S.objects = S.objects.filter(o => o.persist);\\n    S.strain = null;\\n    S.scripts = (ph.at || []).map(a => ({ t: a.t, do: a.do, done: false }));\\n    S.tutorial = !!ph.tutorial;\\n    S.tutDone = !ph.tutorial;\\n    S.flags = Object.assign({}, S.flags, ph.flags || {});\\n    if (ph.dim != null) S.dim = ph.dim;\\n    if (ph.tilt) S.tiltAmp = ph.tilt;\\n    for (const spec of ph.objects || []) addObj(S, clone(spec));\\n    if (ph.strain) spawnStrain(S, ph.strain, ph.strainOpts || {});\\n    if (ph.onEnter) runScript(S, ph.onEnter, tuneOf(null));\\n    S.checkpoint = takeCore(S);\\n    /* drop the checkpoint's nested copy weight: checkpoint is the core itself */\\n    pushEv(S, ['phase', index, ph.name]);\\n  }\\n\\n  function advancePhase(S) {\\n    const def = (GAME.CASES || {})[S.id];\\n    if (!def) { finishCase(S); return; }\\n    if (S.phase + 1 >= def.phases.length) {\\n      if (!S.dressing && !S.won) {\\n        S.dressing = { t: 0, done: false };\\n        pushEv(S, ['dressing', 1]);\\n        return;\\n      }\\n      return;\\n    }\\n    loadPhase(S, def, S.phase + 1);\\n  }\\n\\n  function create(def, opts) {\\n    opts = opts || {};\\n    const diff = opts.difficulty || opts.diff || 'resident';\\n    const clockMul = diff === 'intern' ? 1.3 : diff === 'attending' ? 0.8 : 1;\\n    const S = blank({\\n      id: def.id, seed: opts.seed || def.seed || 1, players: opts.players || 1,\\n      difficulty: diff, clock: def.clock * clockMul, vitals: def.vitals, drain: def.drain,\\n      gift: def.doctor === 'sokolova' ? 'look' : def.doctor === 'both' ? 'both' : 'breath',\\n      doctor: def.doctor || 'vale', site: def.site, par: def.par || 1000,\\n      mode: def.mode || 'case', consult: !!def.consult,\\n    });\\n    S.clock0 = S.clock;\\n    if (def.doctor === 'both') S.consult = true;\\n    loadPhase(S, def, opts.phase || 0);\\n    return S;\\n  }\\n\\n  function createRaw(opts) {\\n    const S = blank(opts);\\n    for (const spec of opts.objects || []) addObj(S, clone(spec));\\n    if (opts.strain) spawnStrain(S, opts.strain, opts.strainOpts || {});\\n    if (opts.scripts) S.scripts = opts.scripts.map(a => ({ t: a.t, do: a.do, done: false }));\\n    S.checkpoint = takeCore(S);\\n    return S;\\n  }\\n\\n  function readInputs(S, inputs, dt) {\\n    inputs = inputs || [];\\n    for (let i = 0; i < S.players.length; i++) {\\n      const p = S.players[i];\\n      const inp = inputs[i] || {};\\n      const ox = p.x, oy = p.y;\\n      if (inp.x != null) { p.x = inp.x; p.y = inp.y; p.bx = inp.x; p.by = inp.y; }\\n      if (inp.tool) p.tool = inp.tool;\\n      p.inst = hypot(p.x - ox, p.y - oy) / Math.max(dt, 1e-4);\\n      p.fine = !!inp.fine;\\n      p.mouse = !!inp.mouse;\\n      const trig = inp.trig || 0;\\n      p.trigEdge = trig > 0.3 && p.prevTrig <= 0.3;\\n      p.trigRelease = trig <= 0.3 && p.prevTrig > 0.3;\\n      p.prevTrig = trig;\\n      p.trig = trig;\\n      const gift = !!inp.gift;\\n      p.giftEdge = gift && !p.giftPrev;\\n      p.giftPrev = gift;\\n      const consult = !!inp.consult;\\n      p.consultEdge = consult && !p.consultPrev;\\n      p.consultPrev = consult;\\n      p.cancelEdge = !!inp.cancel;\\n      if (p.cancelEdge) { p.held = 0; p.stroke = null; }\\n    }\\n  }\\n\\n  function tryGifts(S, tune) {\\n    for (const p of S.players) {\\n      if (!p.giftEdge) continue;\\n      if (S.breath) { S.breath = false; S.worldScale = 1; pushEv(S, ['breath', 0]); continue; }\\n      const doc = S.activeDoc;\\n      const wantLook = doc === 'sokolova' || (S.gift === 'look' && doc !== 'vale');\\n      const wantBreath = doc === 'vale' || S.gift === 'breath' || (S.gift === 'both' && doc === 'vale');\\n      if (S.gift === 'both') {\\n        if (doc === 'sokolova') { if (secondLook(S, tune)) return; }\\n        else if (S.steady >= 35) { S.breath = true; pushEv(S, ['breath', 1]); return; }\\n      } else if (S.gift === 'look' || wantLook && S.gift !== 'breath') {\\n        secondLook(S, tune);\\n      } else if (wantBreath && S.steady >= 35) {\\n        S.breath = true;\\n        pushEv(S, ['breath', 1]);\\n      }\\n    }\\n    for (const p of S.players) {\\n      if (!p.consultEdge || !S.consult) continue;\\n      S.activeDoc = S.activeDoc === 'vale' ? 'sokolova' : 'vale';\\n      pushEv(S, ['consult', S.activeDoc]);\\n    }\\n  }\\n\\n  function stepCodeBlue(S, dt) {\\n    const cb = S.codeBlue;\\n    if (!cb) return;\\n    cb.t += dt;\\n    const peaks = [0.9, 1.8, 2.7, 3.6];\\n    const p = S.players[0];\\n    if (cb.next == null) cb.next = 0;\\n    if (cb.next < 4) {\\n      const peak = peaks[cb.next];\\n      if (p && p.trigEdge) {\\n        const err = Math.abs(cb.t - peak);\\n        cb.attempts += 1;\\n        if (err <= 0.14) {\\n          cb.hits += 1;\\n          if (err <= 0.06) cb.textbook = (cb.textbook || 0) + 1;\\n          pushEv(S, ['shock', cb.hits, err]);\\n        } else pushEv(S, ['miss', err]);\\n        cb.next += 1;\\n      } else if (cb.t > peak + 0.14) {\\n        cb.attempts += 1;\\n        cb.next += 1;\\n        pushEv(S, ['miss', 1]);\\n      }\\n    }\\n    if (cb.next >= 4 && !cb.resolved) {\\n      cb.resolved = true;\\n      S.codeBlue = null;\\n      if (cb.hits >= 2) {\\n        S.vitals = 30;\\n        S.flags.crash = 0;\\n        pushEv(S, ['revived', cb.textbook >= 2 ? 'textbook' : 'clean']);\\n      } else lose(S, 'code');\\n    }\\n  }\\n\\n  function maybeDie(S) {\\n    if (S.won || S.lost || S.codeBlue || S.dressing) return;\\n    if (S.clock <= 0) { lose(S, 'time'); return; }\\n    if (S.vitals <= 0) {\\n      if (S.diff === 'attending' || S.codeBlueUsed) { lose(S, 'vitals'); return; }\\n      S.codeBlueUsed = true;\\n      S.codeBlue = { t: 0, hits: 0, attempts: 0, next: 0, textbook: 0, resolved: false };\\n      S.vitals = 0;\\n      S.breath = false;\\n      pushEv(S, ['codeblue', 1]);\\n    }\\n  }\\n\\n  function stepDressing(S, dt, tune) {\\n    const d = S.dressing;\\n    d.t += dt;\\n    const u = (d.t % 1.2) / 1.2;\\n    const edge = Math.min(u, 1 - u);\\n    const p = S.players[0];\\n    if (p && p.trigEdge) {\\n      const bonus = edge < 0.08 ? 80 : 20;\\n      S.score += bonus;\\n      d.done = true;\\n      pushEv(S, ['stamp', bonus]);\\n      finishCase(S);\\n    } else if (d.t > 4) {\\n      d.done = true;\\n      finishCase(S);\\n    }\\n  }\\n\\n  function step(S, inputs, dt, tune) {\\n    tune = tuneOf(tune);\\n    if (!dt || dt < 0) dt = 0;\\n    S.ev = [];\\n    if (S.won || S.lost) return S;\\n    readInputs(S, inputs, dt);\\n    if (S.codeBlue) { stepCodeBlue(S, dt); return S; }\\n    tryGifts(S, tune);\\n    if (S.breath) {\\n      S.steady = Math.max(0, S.steady - tune.gift.breathDrain * dt);\\n      if (S.steady <= 0) { S.breath = false; pushEv(S, ['breath', 0]); }\\n    }\\n    S.worldScale = S.breath ? tune.gift.breathFactor : 1;\\n    const worldDt = dt * S.worldScale;\\n    if (S.dressing) { stepDressing(S, dt, tune); return S; }\\n\\n    const frozen = S.tutorial && !S.tutDone;\\n    if (!frozen) {\\n      let hazard = 0;\\n      for (const o of S.objects) {\\n        if (o.done || !o.drain) continue;\\n        if (inDome(S, o.x, o.y)) continue;\\n        hazard += o.drain;\\n      }\\n      const bleed = hazard * tune.fluids.bleed * tune.strains.damage;\\n      S.vitals -= (S.drain * tune.patient.drain * diffDrain(S) + bleed) * worldDt;\\n      S.clock -= worldDt * tune.patient.clock / diffClock(S);\\n      S.steady = Math.min(100, S.steady + 0.5 * tune.gift.charge * worldDt);\\n    }\\n    S.t += dt;\\n    S.worldT += frozen ? 0 : worldDt;\\n    S.phaseT += frozen ? 0 : worldDt;\\n\\n    for (const p of S.players) applyTools(S, p, dt, tune);\\n    if (!frozen) {\\n      stepWorld(S, worldDt, dt, tune);\\n      stepStrain(S, worldDt, dt, tune);\\n    }\\n    if (S.ghostT > 0) S.ghostT -= dt;\\n\\n    if (!frozen) {\\n      S.ringAcc += worldDt;\\n      while (S.ringAcc >= 0.1) { S.ringAcc -= 0.1; pushRing(S); }\\n    }\\n\\n    maybeDie(S);\\n    if (!S.lost && !S.won && !S.codeBlue && phaseClear(S)) advancePhase(S);\\n    return S;\\n  }\\n\\n  /* ---------- cursor and wheel ---------- */\\n\\n  function assistOf(S, tune) {\\n    let a = tune.hands.assist;\\n    if (S && S.diff === 'intern') a += 0.2;\\n    if (S && (S.activeDoc === 'sokolova')) a += 0.2;\\n    return clamp(a, 0, 1.4);\\n  }\\n\\n  function jitterOf(S, p) {\\n    const st = S && S.strain;\\n    if (!st || !st.jitter || (S && S.breath)) return [0, 0];\\n    const amp = 5 * (st.amp == null ? 1 : st.amp) * (p.fine ? 0.35 : 1);\\n    return [Math.sin((S.worldT || 0) * 17.3 + p.id) * amp, Math.cos((S.worldT || 0) * 13.1 + p.id * 2) * amp];\\n  }\\n\\n  function validTarget(S, p, tune) {\\n    const rad = tune.hands.magnet;\\n    return nearest(S, p, rad, o => {\\n      if (!canTouch(S, o)) return false;\\n      if (o.type === 'pool') return p.tool === 'suction';\\n      if (o.type === 'nerve' || o.type === 'eloquent' || o.type === 'hold') return false;\\n      if (p.tool === 'sonar') return !!o.hidden;\\n      if (p.tool === 'salve') return !!o.cells;\\n      if (p.tool === 'syringe') return o.type === 'clot' || o.type === 'reed' || o.type === 'voice' || o.type === 'lobe';\\n      if (p.tool === 'cautery') return o.type === 'polyp' || o.type === 'bleeder' || o.type === 'bead' || o.type === 'uvula' || o.type === 'eye' || o.type === 'rupture' || o.type === 'tremass' || o.type === 'barb' || o.type === 'lobe';\\n      if (p.tool === 'forceps') return o.type === 'shard' || o.type === 'fragment' || o.type === 'mass' || o.type === 'hook' || o.type === 'gaff' || o.type === 'cork' || o.type === 'note' || o.type === 'retractor' || o.type === 'screw' || o.type === 'nest';\\n      if (p.tool === 'scalpel') return !!o.guide;\\n      if (p.tool === 'suture') return !!o.pairs;\\n      return false;\\n    });\\n  }\\n\\n  function updateCursor(p, dev, S, dt, tune) {\\n    tune = tuneOf(tune);\\n    dev = dev || {};\\n    if (dev.mouse) {\\n      p.bx = dev.mouse[0]; p.by = dev.mouse[1];\\n      p.x = p.bx; p.y = p.by;\\n      p.fine = !!dev.fine;\\n      return p;\\n    }\\n    const aim = dev.aim || [0, 0];\\n    let mag = hypot(aim[0], aim[1]);\\n    let dirx = mag > 1e-6 ? aim[0] / mag : 0;\\n    let diry = mag > 1e-6 ? aim[1] / mag : 0;\\n    mag = Math.min(1, mag);\\n    const curved = Math.pow(mag, tune.hands.curve);\\n    let speed = curved * tune.hands.cursor;\\n    if (dev.fine) speed *= tune.hands.fine;\\n    if (S && (S.activeDoc === 'vale')) speed *= 1.15;\\n    /* 0.06s ramp */\\n    const k = 1 - Math.exp(-dt / 0.06);\\n    p.speed += (speed - (p.speed || 0)) * (dt > 0 ? k : 1);\\n    let vx = dirx * p.speed;\\n    let vy = diry * p.speed;\\n    const keys = dev.keys || [0, 0];\\n    const keySp = 200 * (dev.fine ? tune.hands.fine : 1);\\n    vx += keys[0] * keySp; vy += keys[1] * keySp;\\n    const nudge = dev.nudge || [0, 0];\\n    vx += nudge[0] * 40; vy += nudge[1] * 40;\\n\\n    const assist = S ? assistOf(S, tune) : tune.hands.assist;\\n    const tgt = S ? validTarget(S, p, tune) : null;\\n    if (tgt && mag < 0.95) {\\n      vx *= 1 - 0.55 * Math.min(1, assist);\\n      vy *= 1 - 0.55 * Math.min(1, assist);\\n      if (mag < 0.12) {\\n        const dx = tgt.x - p.bx, dy = tgt.y - p.by;\\n        const d = hypot(dx, dy) || 1;\\n        const pull = 90 * assist;\\n        vx += (dx / d) * pull; vy += (dy / d) * pull;\\n      }\\n    }\\n    if (S && p.stroke && (p.stroke.kind === 'scalpel' || p.stroke.kind === 'suture')) {\\n      const o = objById(S, p.stroke.id);\\n      let tanv = [1, 0];\\n      if (o && o.guide) tanv = polyDist(o.guide, p.bx, p.by).tan;\\n      else if (p.stroke.kind === 'suture' && o && o.pairs) {\\n        const pair = o.pairs[o.stitch] || o.pairs[0];\\n        const dx = pair[1][0] - pair[0][0], dy = pair[1][1] - pair[0][1];\\n        const L = hypot(dx, dy) || 1;\\n        tanv = [dx / L, dy / L];\\n      }\\n      const along = vx * tanv[0] + vy * tanv[1];\\n      const cx = vx - along * tanv[0], cy = vy - along * tanv[1];\\n      const scale = 1 - 0.8 * Math.min(1, assist);\\n      vx = along * tanv[0] + cx * scale;\\n      vy = along * tanv[1] + cy * scale;\\n    }\\n    p.bx = clamp(p.bx + vx * dt, 8, CFG.FIELD_W - 8);\\n    p.by = clamp(p.by + vy * dt, 8, CFG.FIELD_H - 8);\\n    const j = S ? jitterOf(S, p) : [0, 0];\\n    p.x = p.bx + j[0];\\n    p.y = p.by + j[1];\\n    p.fine = !!dev.fine;\\n    return p;\\n  }\\n\\n  function wheelIndex(x, y) {\\n    const ang = Math.atan2(y, x); /* 0 east, clockwise because y grows downward */\\n    let d = ang - (-Math.PI / 2);\\n    if (d < 0) d += TAU;\\n    if (d >= TAU) d -= TAU;\\n    return Math.round(d / (Math.PI / 4)) % 8;\\n  }\\n\\n  function updateWheel(p, dev, dt) {\\n    dev = dev || {};\\n    if (dev.digit) {\\n      const i = (dev.digit - 1) % 8;\\n      if (p.tool !== CFG.TOOLS[i]) { p.tool = CFG.TOOLS[i]; p.swap = 0.12; }\\n      return p.tool;\\n    }\\n    const m = dev.move || [0, 0];\\n    const mag = hypot(m[0], m[1]);\\n    if (mag < 0.6) { p.wheelT = 0; p.wheelDir = -1; return p.tool; }\\n    const dir = wheelIndex(m[0], m[1]);\\n    if (dir !== p.wheelDir) { p.wheelDir = dir; p.wheelT = 0; }\\n    p.wheelT += dt;\\n    if (p.wheelT >= 0.08 && p.tool !== CFG.TOOLS[dir]) {\\n      p.tool = CFG.TOOLS[dir];\\n      p.swap = 0.12;\\n      p.wheelT = 0;\\n    }\\n    return p.tool;\\n  }\\n\\n  function retryPhase(S) {\\n    if (!S.checkpoint) return false;\\n    restoreCore(S, S.checkpoint, false);\\n    S.rankCap = 'B';\\n    S.lost = false;\\n    S.won = false;\\n    S.codeBlue = null;\\n    S.reason = '';\\n    for (const p of S.players) { p.held = 0; p.stroke = null; }\\n    pushEv(S, ['retry', S.phase]);\\n    return true;\\n  }\\n\\n  GAME.Sim = {\\n    rnd, clamp, clone, addObj, makePlayer, blank, create, createRaw, step,\\n    takeCore, applyCore, hashCore, rankLetter, secondLook, forceRewind, retryPhase,\\n    updateCursor, updateWheel, wheelIndex, spawnStrain, phaseClear, objById,\\n    polyDist, lose, DRAIN,\\n  };\\n  GAME.Op = { create, createRaw, step, takeCore, hash: S => hashCore(takeCore(S)), rankLetter, secondLook, forceRewind, retryPhase, spawnStrain };\\n  GAME.Cursor = { update: updateCursor, jitterOf, assistOf };\\n  GAME.Wheel = { update: updateWheel, index: wheelIndex, TOOLS: CFG.TOOLS };\\n})();\\n\",\"total_lines\":1684}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"732699a2-1f41-4f57-8f3a-47da27b614c3"}
{"type":"assistant","message":{"id":"msg_42","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"The simulation is now clear.\n\nA smoke test will be written first. Bugs will be fixed next. The rest of the game will be built in large files. The architecture must be planned carefully to avoid structural problems. The required modules include data, bot, art, audio, scenes, network, main entry point, test runner, and build tools.\n\nThe test runner will exercise the simulation through a virtual machine. It will verify cursor movement, wheel controls, tools, code blue, gifts, strains, determinism, rank, retractor, and difficulty. It will also run the perfect bot across all cases and support a fast mode to skip browser tests. The plan is to fix the simulation until tests pass, then build content and the bot until all cases clear, then write the engine shell. Exact requirements from PLAN sections 5, 8, 9, 10, 12, and 20 still need review.\n\nI will read the remaining PLAN sections while writing the smoke test. I also found a clock bug: the simulation currently multiplies the starting clock by clockMul and then divides by diffClock, which doubles the intern duration. I will remove the initial multiplication and let the step decrement alone control the clock length.\n\nA second bug was found in the cursor path. When the game loop calls Cursor.update then Op.step without coordinates, the instruction is zeroed out. Tests pass coordinates explicitly so they avoid this. The fix belongs in readInputs: if an input lacks x and y, the code should preserve the base position instead of overwriting it with jitter.\n\nThe cursor path bug is now traced to the game loop sequence. Cursor.update sets x and y, but readInputs overwrites p.inst with the delta from the previous frame. Because the position was already updated by the cursor, the instruction becomes zero. The fix should compute p.inst from the base movement inside Cursor.update itself.\n\nThe cursor path bug is now traced to the exact readInputs sequence. Cursor.update overwrites p.x before step begins, so the old position ox becomes identical to the new one. The fix is to store the previous base position as p.px and p.py at the end of each step, then compute instruction from p.x minus p.px inside readInputs.\n\nThe cursor path fix is being refined. Cursor.update runs between steps, so storing the previous base position at the end of step would capture the cursor movement itself. The plan is to keep p.lx and p.ly, compute instruction from p.x minus p.lx when no input coordinates are given, and update p.lx at the end of each step.\n\nThe cursor path fix is now concrete. The previous base position will be stored as p.lx and p.ly at the end of each step. Cursor.update shifts the player position between steps. readInputs will compute instruction from the cursor delta using those stored coordinates. p.lx and p.ly will be initialized to the starting position in makePlayer so tests that pass explicit coordinates still work.\n\nThe cursor path fix is being refined. Storing the previous base position at the end of readInputs would capture the cursor shift, but tools might move the player between frames. The exact placement of p.lx and p.ly is being reconsidered to ensure instruction deltas remain accurate.\n\nA tear-latching bug was found. Fast yanking currently stacks tears every frame and kills vitals instantly. The fix is to add a held.tearCd so each yank produces exactly one tear.\n\ncreateRaw auto-wins when objects clear. This breaks unit tests that assert on the returned state of the completing step. A hold flag will be added to opts so raw drills can pause instead of finishing automatically.\n\nThe hold flag will be set directly by createRaw when opts.hold is true, and advancePhase will return early if S.hold is active. Auto-fed pools will be marked optional so they do not block phases, though they still damage the player.\n\nThe optional pool idea is abandoned. Blood must cover the bleeder via the under property, so the bot cannot cauterize a bleeding target while blood remains. The pool will block phase clear until suctioned.\n\nCantor domes may not tick because stepCantor might not advance their timers. The tutorial freeze is acceptable. Solo cut progress should be halved when the retractor window is less than full, matching the plan's \"half window\" wording.","signature":""},{"type":"tool_use","id":"call-d279b093-0547-474d-b43c-dfa1b2f48052-8","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/core/sim.js","offset":47,"limit":30}},{"type":"tool_use","id":"call-d279b093-0547-474d-b43c-dfa1b2f48052-9","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/core/sim.js","offset":781,"limit":360}},{"type":"tool_use","id":"call-d279b093-0547-474d-b43c-dfa1b2f48052-10","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/PLAN.md","offset":159,"limit":270}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":18012,"output_tokens":2701,"cache_read_input_tokens":41216,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"0bc42cad-1cee-40b5-8635-6b550231e427"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-d279b093-0547-474d-b43c-dfa1b2f48052-8","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"47→  function slip(S, p, kind, dmg, tune) {\\n    S.slips += 1;\\n    if (p) p.slips += 1;\\n50→    S.vitals -= dmg * tune.patient.slip;\\n    S.streak = 0;\\n    S.flow = 1;\\n    pushEv(S, ['slip', kind, dmg, p ? p.id : -1]);\\n  }\\n\\n  function award(S, p, grade, base, tune) {\\n    const mult = grade === 'textbook' ? 1.5 : grade === 'clean' ? 1 : 0.4;\\n    const pts = base * mult * S.flow;\\n    S.score += pts;\\n60→    p.score += pts;\\n    p.actions += 1;\\n    S.techAll += 1;\\n    if (grade !== 'sloppy') S.techGood += 1;\\n    if (grade === 'textbook') { p.textbooks += 1; S.steady = Math.min(100, S.steady + 10 * tune.gift.charge); }\\n    else if (grade === 'clean') S.steady = Math.min(100, S.steady + 5 * tune.gift.charge);\\n    if (grade === 'sloppy') { S.streak = 0; S.flow = 1; }\\n    else {\\n      S.streak += 1;\\n      S.flow = Math.min(2, 1 + 0.05 * S.streak);\\n70→      if (S.flow > S.bestFlow) S.bestFlow = S.flow;\\n    }\\n    if (!S.tutDone) S.tutDone = true;\\n    pushEv(S, ['grade', Math.round(p.x), Math.round(p.y), grade, Math.round(pts)]);\\n    return grade;\\n  }\\n\",\"content_concise\":\"47→  function slip(S, p, kind, dmg, tune) {\\n    S.slips += 1;\\n    if (p) p.slips += 1;\\n50→    S.vitals -= dmg * tune.patient.slip;\\n    S.streak = 0;\\n    S.flow = 1;\\n    pushEv(S, ['slip', kind, dmg, p ? p.id : -1]);\\n  }\\n\\n  function award(S, p, grade, base, tune) {\\n    const mult = grade === 'textbook' ? 1.5 : grade === 'clean' ? 1 : 0.4;\\n    const pts = base * mult * S.flow;\\n    S.score += pts;\\n60→    p.score += pts;\\n    p.actions += 1;\\n    S.techAll += 1;\\n    if (grade !== 'sloppy') S.techGood += 1;\\n    if (grade === 'textbook') { p.textbooks += 1; S.steady = Math.min(100, S.steady + 10 * tune.gift.charge); }\\n    else if (grade === 'clean') S.steady = Math.min(100, S.steady + 5 * tune.gift.charge);\\n    if (grade === 'sloppy') { S.streak = 0; S.flow = 1; }\\n    else {\\n      S.streak += 1;\\n      S.flow = Math.min(2, 1 + 0.05 * S.streak);\\n70→      if (S.flow > S.bestFlow) S.bestFlow = S.flow;\\n    }\\n    if (!S.tutDone) S.tutDone = true;\\n    pushEv(S, ['grade', Math.round(p.x), Math.round(p.y), grade, Math.round(pts)]);\\n    return grade;\\n  }\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/core/sim.js\",\"offset\":47,\"limit\":30,\"raw_output\":\"  function slip(S, p, kind, dmg, tune) {\\n    S.slips += 1;\\n    if (p) p.slips += 1;\\n    S.vitals -= dmg * tune.patient.slip;\\n    S.streak = 0;\\n    S.flow = 1;\\n    pushEv(S, ['slip', kind, dmg, p ? p.id : -1]);\\n  }\\n\\n  function award(S, p, grade, base, tune) {\\n    const mult = grade === 'textbook' ? 1.5 : grade === 'clean' ? 1 : 0.4;\\n    const pts = base * mult * S.flow;\\n    S.score += pts;\\n    p.score += pts;\\n    p.actions += 1;\\n    S.techAll += 1;\\n    if (grade !== 'sloppy') S.techGood += 1;\\n    if (grade === 'textbook') { p.textbooks += 1; S.steady = Math.min(100, S.steady + 10 * tune.gift.charge); }\\n    else if (grade === 'clean') S.steady = Math.min(100, S.steady + 5 * tune.gift.charge);\\n    if (grade === 'sloppy') { S.streak = 0; S.flow = 1; }\\n    else {\\n      S.streak += 1;\\n      S.flow = Math.min(2, 1 + 0.05 * S.streak);\\n      if (S.flow > S.bestFlow) S.bestFlow = S.flow;\\n    }\\n    if (!S.tutDone) S.tutDone = true;\\n    pushEv(S, ['grade', Math.round(p.x), Math.round(p.y), grade, Math.round(pts)]);\\n    return grade;\\n  }\\n\\n\",\"total_lines\":1684}}","is_error":false},{"type":"tool_result","tool_use_id":"call-d279b093-0547-474d-b43c-dfa1b2f48052-9","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"781→  function stepStrain(S, worldDt, handDt, tune) {\\n    const st = S.strain;\\n    if (!st || st.done) return;\\n    const sp = tune.strains.speed;\\n    if (st.kind === 'staccato') stepStaccato(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'legato') stepLegato(S, st, worldDt, handDt, tune, sp);\\n    else if (st.kind === 'tremolo') stepTremolo(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'dacapo') stepDacapo(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'fermata') stepFermata(S, st, worldDt, tune, sp);\\n790→    else if (st.kind === 'cantor') stepCantor(S, st, worldDt, tune, sp);\\n  }\\n\\n  function stepStaccato(S, st, dt, tune, sp) {\\n    st.t += dt;\\n    const beat = tune.strains.beat;\\n    for (const b of st.beads) {\\n      if (b.dead) continue;\\n      b.landIn -= dt * sp;\\n      if (!b.hopped && b.landIn < 0.5) b.hopped = true;\\n800→      if (b.landIn <= 0 && !b.landed) {\\n        b.landed = true; b.x = b.tx; b.y = b.ty;\\n        addObj(S, { type: 'laceration', x: b.x, y: b.y, r: 8, order: 40, drain: 0.2, tag: 'bite' });\\n        pushEv(S, ['bite', Math.round(b.x), Math.round(b.y)]);\\n      }\\n      if (!b.landed) {\\n        const u = clamp(1 - b.landIn / b.flight, 0, 1);\\n        b.x = b.x0 + (b.tx - b.x0) * u;\\n        b.y = b.y0 + (b.ty - b.y0) * u;\\n      }\\n810→    }\\n    /* cautery kills beads: mirrored onto objects of type bead */\\n    let nests = 0;\\n    for (const o of S.objects) if (o.type === 'nest' && !o.done && o.tag === st.tag) nests++;\\n    if (!nests && !st.collapse) { st.collapse = 3; }\\n    if (st.collapse > 0) {\\n      st.collapse -= dt;\\n      if (st.collapse <= 0) {\\n        for (const b of st.beads) b.dead = true;\\n        for (const o of S.objects) if (o.type === 'bead' && o.tag === st.tag) { o.done = true; o.alive = false; }\\n820→        st.done = true;\\n      }\\n    }\\n    syncBeads(S, st);\\n    if (st.beads.length && st.beads.every(b => b.dead) && nests === 0) st.done = true;\\n  }\\n\\n  function syncBeads(S, st) {\\n    for (const b of st.beads) {\\n      if (b.dead) continue;\\n830→      let o = b.oid ? objById(S, b.oid) : null;\\n      if (!o) {\\n        o = addObj(S, { type: 'bead', x: b.x, y: b.y, need: 0.12, order: 5, tag: st.tag, drain: 0 });\\n        b.oid = o.id;\\n      } else {\\n        o.x = b.x; o.y = b.y;\\n        if (o.done) b.dead = true;\\n      }\\n    }\\n  }\\n840→\\n  function stepLegato(S, st, dt, handDt, tune, sp) {\\n    for (const w of st.worms) {\\n      if (w.done) continue;\\n      w.t += dt * sp;\\n      /* head crawls along its path until surfaced */\\n      if (!w.surfaced && !w.out) {\\n        w.along = Math.min(w.pathLen, w.along + 18 * dt * sp);\\n        const p = pointAlong(w.path, w.along);\\n        w.x = p[0]; w.y = p[1];\\n850→        /* open a slur guide when the head nears it */\\n        for (const g of w.slurs) {\\n          if (g.opened || g.done) continue;\\n          if (hypot(w.x - g.x, w.y - g.y) < 28) {\\n            g.opened = true;\\n            const o = addObj(S, { type: 'slur', x: g.x, y: g.y, len: 18, order: 1, tag: 'slur-' + w.id + '-' + g.i, drain: 0, guide: [[g.x - 9, g.y], [g.x + 9, g.y]] });\\n            g.oid = o.id;\\n          }\\n        }\\n      }\\n860→      for (const g of w.slurs) {\\n        if (!g.oid || g.done) continue;\\n        const o = objById(S, g.oid);\\n        if (o && o.done) g.done = true;\\n      }\\n      const slursLeft = w.slurs.filter(g => !g.done).length;\\n      if (!slursLeft && !w.surfaced) {\\n        w.surfaced = true; w.marked = true;\\n        const head = addObj(S, {\\n          type: 'shard', x: w.x, y: w.y, axis: w.axis || [1, 0], depth: 18, order: 2,\\n870→          tag: 'legato-head', worm: w.id, tension: 70, drain: 0.15, hidden: false,\\n          holdZone: w.hold || null, barbs: w.barbAt || 0,\\n        });\\n        w.head = head.id;\\n      }\\n      const head = w.head ? objById(S, w.head) : null;\\n      if (head && head.snapped && !w.snapped) {\\n        w.snapped = true; st.snapped = true;\\n        /* regrow a head further along and flee */\\n        head.done = true; head.alive = false;\\n880→        w.surfaced = false; w.out = false; w.head = 0;\\n        w.along = Math.min(w.pathLen - 4, w.along + 30);\\n        w.slurs.push({ i: 90 + w.slurs.length, x: w.x + 16, y: w.y, opened: false, done: false });\\n        pushEv(S, ['regrow', w.id]);\\n      }\\n      if (head && head.done && !w.out) {\\n        w.pulled = (w.pulled || 0) + 1;\\n        /* barb every 4th segment: if not clamped, snapping already handled via tension */\\n        if (w.barbAt && w.pulled % 4 === 0 && !head.clamped && !w.barbCleared) {\\n          /* require a clamp before the next length counts — head.done means the whole pull finished.\\n890→             Barbs are separate cautery objects spawned at the hold. */\\n        }\\n        w.segments -= 4;\\n        if (w.segments <= w.half && !w.split && st.worms.length < 3) {\\n          w.split = true; w.half = -1;\\n          st.worms.push(makeWorm(S, w.x + 20, w.y + 14, Math.max(4, w.segments >> 1), w.id + 1));\\n          pushEv(S, ['split', w.id]);\\n        }\\n        if (w.segments <= 0) { w.done = true; w.out = true; }\\n        else {\\n900→          /* next length */\\n          w.out = false; w.surfaced = true;\\n          const h2 = addObj(S, {\\n            type: 'shard', x: w.x, y: w.y, axis: [1, 0], depth: 14, order: 2,\\n            tag: 'legato-head', worm: w.id, tension: 70, drain: 0.1,\\n            holdZone: w.barbAt && (w.pulled % 4 === 0) ? [w.x + 30, w.y, 16] : null,\\n          });\\n          w.head = h2.id;\\n          if (w.barbAt && w.pulled % 4 === 0) {\\n            addObj(S, { type: 'barb', x: w.x + 30, y: w.y, need: 0.35, order: 3, tag: 'barb-' + w.id, drain: 0 });\\n910→          }\\n        }\\n      }\\n    }\\n    if (st.worms.every(w => w.done)) st.done = true;\\n  }\\n\\n  function makeWorm(S, x, y, segments, id) {\\n    const path = [];\\n    for (let i = 0; i < 8; i++) path.push([x + i * 14, y + Math.sin(i) * 8]);\\n920→    let pathLen = 0;\\n    for (let i = 1; i < path.length; i++) pathLen += hypot(path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1]);\\n    const slurs = [0.25, 0.5, 0.75].map((u, i) => {\\n      const p = pointAlong(path, pathLen * u);\\n      return { i, x: p[0], y: p[1], opened: false, done: false };\\n    });\\n    return { id, x, y, path, pathLen, along: 0, segments, half: segments / 2, slurs, surfaced: false, done: false, t: 0, split: false, pulled: 0, barbAt: 4, marked: false, axis: [1, 0] };\\n  }\\n  function pointAlong(path, dist) {\\n    let left = dist;\\n930→    for (let i = 1; i < path.length; i++) {\\n      const L = hypot(path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1]) || 1;\\n      if (left <= L) {\\n        const u = left / L;\\n        return [path[i - 1][0] + (path[i][0] - path[i - 1][0]) * u, path[i - 1][1] + (path[i][1] - path[i - 1][1]) * u];\\n      }\\n      left -= L;\\n    }\\n    return path[path.length - 1].slice();\\n  }\\n940→\\n  function stepTremolo(S, st, dt, tune) {\\n    st.t += dt;\\n    st.beat = (st.t % 0.8) / 0.8;\\n    const peak = st.beat > 0.85 || st.beat < 0.1;\\n    st.flare = peak;\\n    S.flags.onBeat = st.beat > 0.45 && st.beat < 0.7 ? false : st.beat < 0.15;\\n    /* vitals shake and drain */\\n    if (!S.breath) S.vitals -= 0.6 * st.amp * dt * tune.strains.damage;\\n    for (const o of S.objects) if (o.type === 'reed' && o.tag === 'reed') o.window = !!st.flare;\\n950→    const reeds = S.objects.filter(o => o.type === 'reed' && !o.done);\\n    if (st.stage === 1 && reeds.length === 0) { st.stage = 2; st.amp = Math.min(st.amp, 0.2); }\\n    if (st.amp <= 0.2 && st.stage === 1) st.stage = 2;\\n    if (st.stage === 2) {\\n      st.wake -= dt;\\n      if (st.wake <= 0) {\\n        st.wake = 6;\\n        /* a reed returns */\\n        if (S.objects.filter(o => o.type === 'reed' && !o.done).length < 2) {\\n          addObj(S, { type: 'reed', x: st.x - 20 + rnd(S) * 40, y: st.y - 10, order: 1, tag: 'reed', drain: 0, window: false });\\n960→        }\\n      }\\n      const mass = S.objects.find(o => o.type === 'tremass');\\n      if (mass && mass.done && st.stage === 2) {\\n        st.stage = 3;\\n        addObj(S, { type: 'shard', x: st.x, y: st.y, axis: [1, 0], depth: 40, order: 4, tag: 'tremolo-pull', tension: 90, drain: 0.2 });\\n      }\\n    }\\n    if (st.stage === 3) {\\n      const pull = S.objects.find(o => o.tag === 'tremolo-pull');\\n970→      if (pull && pull.done) st.done = true;\\n    }\\n    /* amp falls when a reed is dosed */\\n    const deadReeds = st.reed0 - S.objects.filter(o => o.type === 'reed' && !o.done).length;\\n    st.amp = clamp(1 - deadReeds * 0.2, 0.15, 1);\\n    if (st.stage >= 2) st.amp = Math.min(st.amp, 0.2);\\n  }\\n\\n  function stepDacapo(S, st, dt, tune, sp) {\\n    st.t += dt * sp * (st.round === 2 ? 2 : 1);\\n980→    let anyDead = false;\\n    for (const L of st.lobes) {\\n      if (L.dead) { anyDead = true; continue; }\\n      const period = L.period / (st.round === 2 ? 2 : 1);\\n      const openFor = L.openFor / (st.round === 2 ? 2 : 1);\\n      const u = st.t % period;\\n      L.open = u < openFor;\\n      const o = objById(S, L.oid);\\n      if (o) { o.open = L.open && !L.dead; o.x = L.x; o.y = L.y; if (o.done && !L.dead) { L.dead = true; anyDead = true; if (st.count < 0) st.count = 10; } }\\n    }\\n990→    if (st.count >= 0) {\\n      st.count -= dt;\\n      if (st.count <= 0 && st.lobes.some(L => L.dead) && st.lobes.some(L => !L.dead)) {\\n        /* from the top */\\n        for (const L of st.lobes) {\\n          L.dead = false;\\n          const o = objById(S, L.oid);\\n          if (o) { o.done = false; o.alive = true; o.prog = 0; o.burn = 0; o.dosed = false; o.open = false; if (o.cells) for (const c of o.cells) c[2] = 0; }\\n        }\\n        S.vitals -= 8;\\n1000→        st.count = -1;\\n        st.repeated = (st.repeated || 0) + 1;\\n        if (st.round === 1) { st.round = 2; st.t = 0; spawnBeadsN(S, st, 4); }\\n        pushEv(S, ['dacapo', st.repeated]);\\n      } else if (st.count <= 0) st.count = -1;\\n    }\\n    if (st.lobes.every(L => L.dead) && st.count < 0) {\\n      if (st.round === 1) {\\n        st.round = 2; st.t = 0; st.count = -1;\\n        for (const L of st.lobes) {\\n1010→          L.dead = false;\\n          const o = objById(S, L.oid);\\n          if (o) { o.done = false; o.alive = true; o.prog = 0; o.burn = 0; o.dosed = false; if (o.cells) for (const c of o.cells) c[2] = 0; }\\n        }\\n        spawnBeadsN(S, st, 4);\\n        pushEv(S, ['round2', 1]);\\n      } else if (S.objects.every(o => o.type !== 'bead' || o.done)) st.done = true;\\n    }\\n    if (st.round === 2 && st.lobes.every(L => L.dead) && S.objects.every(o => o.type !== 'bead' || o.done || o.tag !== 'dacapo-bead')) st.done = true;\\n  }\\n1020→\\n  function spawnBeadsN(S, st, n) {\\n    st.beads = st.beads || [];\\n    for (let i = 0; i < n; i++) {\\n      const b = { x: 180 + i * 16, y: 100, tx: 190 + i * 14, ty: 130, x0: 180 + i * 16, y0: 100, landIn: 0.8, flight: 0.8, dead: false, landed: false, hopped: false };\\n      st.beads.push(b);\\n      const o = addObj(S, { type: 'bead', x: b.x, y: b.y, need: 0.12, order: 6, tag: 'dacapo-bead', drain: 0 });\\n      b.oid = o.id;\\n    }\\n    if (!st.kindBead) st.kindBead = true;\\n1030→  }\\n\\n  function stepFermata(S, st, dt, tune) {\\n    st.t += dt;\\n    for (const d of st.domes) if (d.t > 0) d.t -= dt;\\n    st.domes = st.domes.filter(d => d.t > 0);\\n    if (st.stage === 1 && st.domes.length === 0 && !st.eyeOpen) {\\n      st.eyeOpen = S.breath ? 2.8 : 0.7;\\n      st.eye.open = true;\\n      const o = objById(S, st.eye.oid);\\n1040→      if (o) o.open = true;\\n    }\\n    if (st.eyeOpen > 0) {\\n      st.eyeOpen -= dt;\\n      if (st.eyeOpen <= 0) {\\n        st.eye.open = false;\\n        const o = objById(S, st.eye.oid);\\n        if (o && !o.done) o.open = false;\\n        if (st.hits < 3 && st.stage === 1) {\\n          /* raise another dome */\\n1050→          if (st.domes.length < 3) st.domes.push({ x: st.eye.x, y: st.eye.y, r: 34, t: 5 });\\n        }\\n      }\\n    }\\n    const eye = objById(S, st.eye.oid);\\n    if (eye && eye.done) { st.hits += 1; eye.done = false; eye.alive = true; eye.burn = 0; eye.prog = 0; eye.open = false; st.eye.open = false; }\\n    if (st.hits >= 3 && st.stage === 1) {\\n      st.stage = 2;\\n      st.eye.x = 250; st.eye.y = 90; st.eye.hidden = true;\\n      if (eye) { eye.x = 250; eye.y = 90; eye.hidden = true; eye.marked = false; eye.done = false; eye.alive = true; }\\n1060→      addObj(S, { type: 'shard', x: 160, y: 140, axis: [1, 0], depth: 12, order: 3, tag: 'sliver-a', drain: 0.1, hidden: true });\\n      addObj(S, { type: 'shard', x: 180, y: 150, axis: [0.6, 0.8], depth: 12, order: 3, tag: 'sliver-b', drain: 0.1, hidden: true });\\n    }\\n    if (st.stage === 2 && eye && eye.marked) eye.hidden = false;\\n    if (st.stage === 2 && eye && eye.done && S.objects.every(o => o.tag !== 'sliver-a' && o.tag !== 'sliver-b' || o.done)) {\\n      /* eye.done was consumed as a hit; require the flee eye burned once more and slivers out */\\n    }\\n    if (st.stage === 2) {\\n      const slivers = S.objects.filter(o => o.tag === 'sliver-a' || o.tag === 'sliver-b');\\n      const eyeBurned = st.hits >= 4;\\n1070→      if (eye && eye.done) st.hits = Math.max(st.hits, 4);\\n      if (eyeBurned && slivers.every(o => o.done)) {\\n        st.stage = 3;\\n        addObj(S, { type: 'note', x: st.eye.x, y: st.eye.y, axis: [0, -1], depth: 28, tension: 40, order: 5, tag: 'fermata-pull', drain: 0.15 });\\n      }\\n    }\\n    if (st.stage === 3) {\\n      const pull = S.objects.find(o => o.tag === 'fermata-pull');\\n      if (pull && pull.done) st.done = true;\\n    }\\n1080→  }\\n\\n  function stepCantor(S, st, dt, tune) {\\n    st.t += dt;\\n    if (st.move === 1) {\\n      /* tendrils then uvulas, objects already spawned by the phase */\\n      const left = S.objects.filter(o => (o.tag === 'tendril' || o.tag === 'uvula') && !o.done);\\n      if (!left.length) { st.move = 2; st.t = 0; S.clock += 120; S.flags.hush = true; pushEv(S, ['movement', 2]); spawnVoice(S, st); }\\n    } else if (st.move === 2) {\\n      S.flags.hush = true;\\n1090→      st.beat = (st.t % 0.9);\\n      for (const o of S.objects) if (o.type === 'voice') o.window = st.beat > 0.35 && st.beat < 0.7;\\n      if (st.domes && st.t > 2 && st.domes.length < 2 && Math.floor(st.t) % 5 === 0) {\\n        /* one dome refreshes */\\n      }\\n      st.jitter = true;\\n      const voices = S.objects.filter(o => o.type === 'voice' && !o.done);\\n      if (!voices.length) { st.move = 3; st.t = 0; S.clock += 120; S.flags.hush = false; st.signs = 0; pushEv(S, ['movement', 3]); }\\n    } else if (st.move === 3) {\\n      st.cycleT = (st.cycleT || 0) + dt;\\n1100→      if (!st.winding && st.cycleT >= 20) { st.winding = 3; st.cycleT = 0; openRepeat(S, st); }\\n      if (st.winding > 0) {\\n        st.winding -= dt;\\n        if (st.winding <= 0) {\\n          const sign = S.objects.find(o => o.tag === 'repeat' && !o.done);\\n          if (sign) {\\n            forceRewind(S, true);\\n            st.rewound = (st.rewound || 0) + 1;\\n          } else st.signs = (st.signs || 0) + 1;\\n          st.winding = 0;\\n1110→          closeRepeat(S);\\n        }\\n      }\\n      const sign = S.objects.find(o => o.tag === 'repeat' && o.done);\\n      if (sign) { st.signs = (st.signs || 0) + 1; sign.tag = 'repeat-spent'; }\\n      if ((st.signs || 0) >= 6) { st.move = 4; st.t = 0; S.clock += 120; pushEv(S, ['movement', 4]); spawnCoda(S, st); }\\n    } else if (st.move === 4) {\\n      st.beat = (st.t % 0.8) / 0.8;\\n      S.flags.onBeat = st.beat < 0.25;\\n      const spiral = S.objects.find(o => o.type === 'spiral' && o.tag === 'last-note');\\n1120→      const note = S.objects.find(o => o.tag === 'the-note');\\n      const wound = S.objects.find(o => o.tag === 'final-wound');\\n      if (spiral && spiral.done && !st.noteOut) {\\n        st.noteOut = true;\\n        addObj(S, { type: 'note', x: 213, y: 116, axis: [0, -1], depth: 36, tension: 80, order: 2, tag: 'the-note', drain: 0 });\\n      }\\n      if (note && note.done && !wound) {\\n        addObj(S, { type: 'wound', x: 213, y: 130, stitches: 6, order: 3, tag: 'final-wound', drain: 0.3 });\\n      }\\n      if (wound && wound.done) st.done = true;\\n1130→    }\\n  }\\n\\n  function openRepeat(S, st) {\\n    const existing = S.objects.find(o => o.tag === 'repeat');\\n    if (existing) { existing.done = false; existing.alive = true; existing.open = true; existing.prog = 0; return existing; }\\n    return addObj(S, { type: 'repeat', x: 213, y: 100, len: 36, order: 1, tag: 'repeat', open: true, drain: 0, guide: [[190, 100], [236, 100]] });\\n  }\\n  function closeRepeat(S) {\\n    for (const o of S.objects) if (o.tag === 'repeat' && !o.done) { o.open = false; }\\n1140→  }\",\"content_concise\":\"781→  function stepStrain(S, worldDt, handDt, tune) {\\n    const st = S.strain;\\n    if (!st || st.done) return;\\n    const sp = tune.strains.speed;\\n    if (st.kind === 'staccato') stepStaccato(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'legato') stepLegato(S, st, worldDt, handDt, tune, sp);\\n    else if (st.kind === 'tremolo') stepTremolo(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'dacapo') stepDacapo(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'fermata') stepFermata(S, st, worldDt, tune, sp);\\n790→    else if (st.kind === 'cantor') stepCantor(S, st, worldDt, tune, sp);\\n  }\\n\\n  function stepStaccato(S, st, dt, tune, sp) {\\n    st.t += dt;\\n    const beat = tune.strains.beat;\\n    for (const b of st.beads) {\\n      if (b.dead) continue;\\n      b.landIn -= dt * sp;\\n      if (!b.hopped && b.landIn < 0.5) b.hopped = true;\\n800→      if (b.landIn <= 0 && !b.landed) {\\n        b.landed = true; b.x = b.tx; b.y = b.ty;\\n        addObj(S, { type: 'laceration', x: b.x, y: b.y, r: 8, order: 40, drain: 0.2, tag: 'bite' });\\n        pushEv(S, ['bite', Math.round(b.x), Math.round(b.y)]);\\n      }\\n      if (!b.landed) {\\n        const u = clamp(1 - b.landIn / b.flight, 0, 1);\\n        b.x = b.x0 + (b.tx - b.x0) * u;\\n        b.y = b.y0 + (b.ty - b.y0) * u;\\n      }\\n810→    }\\n    /* cautery kills beads: mirrored onto objects of type bead */\\n    let nests = 0;\\n    for (const o of S.objects) if (o.type === 'nest' && !o.done && o.tag === st.tag) nests++;\\n    if (!nests && !st.collapse) { st.collapse = 3; }\\n    if (st.collapse > 0) {\\n      st.collapse -= dt;\\n      if (st.collapse <= 0) {\\n        for (const b of st.beads) b.dead = true;\\n        for (const o of S.objects) if (o.type === 'bead' && o.tag === st.tag) { o.done = true; o.alive = false; }\\n820→        st.done = true;\\n      }\\n    }\\n    syncBeads(S, st);\\n    if (st.beads.length && st.beads.every(b => b.dead) && nests === 0) st.done = true;\\n  }\\n\\n  function syncBeads(S, st) {\\n    for (const b of st.beads) {\\n      if (b.dead) continue;\\n830→      let o = b.oid ? objById(S, b.oid) : null;\\n      if (!o) {\\n        o = addObj(S, { type: 'bead', x: b.x, y: b.y, need: 0.12, order: 5, tag: st.tag, drain: 0 });\\n        b.oid = o.id;\\n      } else {\\n        o.x = b.x; o.y = b.y;\\n        if (o.done) b.dead = true;\\n      }\\n    }\\n  }\\n840→\\n  function stepLegato(S, st, dt, handDt, tune, sp) {\\n    for (const w of st.worms) {\\n      if (w.done) continue;\\n      w.t += dt * sp;\\n      /* head crawls along its path until surfaced */\\n      if (!w.surfaced && !w.out) {\\n        w.along = Math.min(w.pathLen, w.along + 18 * dt * sp);\\n        const p = pointAlong(w.path, w.along);\\n        w.x = p[0]; w.y = p[1];\\n850→        /* open a slur guide when the head nears it */\\n        for (const g of w.slurs) {\\n          if (g.opened || g.done) continue;\\n          if (hypot(w.x - g.x, w.y - g.y) < 28) {\\n            g.opened = true;\\n            const o = addObj(S, { type: 'slur', x: g.x, y: g.y, len: 18, order: 1, tag: 'slur-' + w.id + '-' + g.i, drain: 0, guide: [[g.x - 9, g.y], [g.x + 9, g.y]] });\\n            g.oid = o.id;\\n          }\\n        }\\n      }\\n860→      for (const g of w.slurs) {\\n        if (!g.oid || g.done) continue;\\n        const o = objById(S, g.oid);\\n        if (o && o.done) g.done = true;\\n      }\\n      const slursLeft = w.slurs.filter(g => !g.done).length;\\n      if (!slursLeft && !w.surfaced) {\\n        w.surfaced = true; w.marked = true;\\n        const head = addObj(S, {\\n          type: 'shard', x: w.x, y: w.y, axis: w.axis || [1, 0], depth: 18, order: 2,\\n870→          tag: 'legato-head', worm: w.id, tension: 70, drain: 0.15, hidden: false,\\n          holdZone: w.hold || null, barbs: w.barbAt || 0,\\n        });\\n        w.head = head.id;\\n      }\\n      const head = w.head ? objById(S, w.head) : null;\\n      if (head && head.snapped && !w.snapped) {\\n        w.snapped = true; st.snapped = true;\\n        /* regrow a head further along and flee */\\n        head.done = true; head.alive = false;\\n880→        w.surfaced = false; w.out = false; w.head = 0;\\n        w.along = Math.min(w.pathLen - 4, w.along + 30);\\n        w.slurs.push({ i: 90 + w.slurs.length, x: w.x + 16, y: w.y, opened: false, done: false });\\n        pushEv(S, ['regrow', w.id]);\\n      }\\n      if (head && head.done && !w.out) {\\n        w.pulled = (w.pulled || 0) + 1;\\n        /* barb every 4th segment: if not clamped, snapping already handled via tension */\\n        if (w.barbAt && w.pulled % 4 === 0 && !head.clamped && !w.barbCleared) {\\n          /* require a clamp before the next length counts — head.done means the whole pull finished.\\n890→             Barbs are separate cautery objects spawned at the hold. */\\n        }\\n        w.segments -= 4;\\n        if (w.segments <= w.half && !w.split && st.worms.length < 3) {\\n          w.split = true; w.half = -1;\\n          st.worms.push(makeWorm(S, w.x + 20, w.y + 14, Math.max(4, w.segments >> 1), w.id + 1));\\n          pushEv(S, ['split', w.id]);\\n        }\\n        if (w.segments <= 0) { w.done = true; w.out = true; }\\n        else {\\n900→          /* next length */\\n          w.out = false; w.surfaced = true;\\n          const h2 = addObj(S, {\\n            type: 'shard', x: w.x, y: w.y, axis: [1, 0], depth: 14, order: 2,\\n            tag: 'legato-head', worm: w.id, tension: 70, drain: 0.1,\\n            holdZone: w.barbAt && (w.pulled % 4 === 0) ? [w.x + 30, w.y, 16] : null,\\n          });\\n          w.head = h2.id;\\n          if (w.barbAt && w.pulled % 4 === 0) {\\n            addObj(S, { type: 'barb', x: w.x + 30, y: w.y, need: 0.35, order: 3, tag: 'barb-' + w.id, drain: 0 });\\n910→          }\\n        }\\n      }\\n    }\\n    if (st.worms.every(w => w.done)) st.done = true;\\n  }\\n\\n  function makeWorm(S, x, y, segments, id) {\\n    const path = [];\\n    for (let i = 0; i < 8; i++) path.push([x + i * 14, y + Math.sin(i) * 8]);\\n920→    let pathLen = 0;\\n    for (let i = 1; i < path.length; i++) pathLen += hypot(path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1]);\\n    const slurs = [0.25, 0.5, 0.75].map((u, i) => {\\n      const p = pointAlong(path, pathLen * u);\\n      return { i, x: p[0], y: p[1], opened: false, done: false };\\n    });\\n    return { id, x, y, path, pathLen, along: 0, segments, half: segments / 2, slurs, surfaced: false, done: false, t: 0, split: false, pulled: 0, barbAt: 4, marked: false, axis: [1, 0] };\\n  }\\n  function pointAlong(path, dist) {\\n    let left = dist;\\n930→    for (let i = 1; i < path.length; i++) {\\n      const L = hypot(path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1]) || 1;\\n      if (left <= L) {\\n        const u = left / L;\\n        return [path[i - 1][0] + (path[i][0] - path[i - 1][0]) * u, path[i - 1][1] + (path[i][1] - path[i - 1][1]) * u];\\n      }\\n      left -= L;\\n    }\\n    return path[path.length - 1].slice();\\n  }\\n940→\\n  function stepTremolo(S, st, dt, tune) {\\n    st.t += dt;\\n    st.beat = (st.t % 0.8) / 0.8;\\n    const peak = st.beat > 0.85 || st.beat < 0.1;\\n    st.flare = peak;\\n    S.flags.onBeat = st.beat > 0.45 && st.beat < 0.7 ? false : st.beat < 0.15;\\n    /* vitals shake and drain */\\n    if (!S.breath) S.vitals -= 0.6 * st.amp * dt * tune.strains.damage;\\n    for (const o of S.objects) if (o.type === 'reed' && o.tag === 'reed') o.window = !!st.flare;\\n950→    const reeds = S.objects.filter(o => o.type === 'reed' && !o.done);\\n    if (st.stage === 1 && reeds.length === 0) { st.stage = 2; st.amp = Math.min(st.amp, 0.2); }\\n    if (st.amp <= 0.2 && st.stage === 1) st.stage = 2;\\n    if (st.stage === 2) {\\n      st.wake -= dt;\\n      if (st.wake <= 0) {\\n        st.wake = 6;\\n        /* a reed returns */\\n        if (S.objects.filter(o => o.type === 'reed' && !o.done).length < 2) {\\n          addObj(S, { type: 'reed', x: st.x - 20 + rnd(S) * 40, y: st.y - 10, order: 1, tag: 'reed', drain: 0, window: false });\\n960→        }\\n      }\\n      const mass = S.objects.find(o => o.type === 'tremass');\\n      if (mass && mass.done && st.stage === 2) {\\n        st.stage = 3;\\n        addObj(S, { type: 'shard', x: st.x, y: st.y, axis: [1, 0], depth: 40, order: 4, tag: 'tremolo-pull', tension: 90, drain: 0.2 });\\n      }\\n    }\\n    if (st.stage === 3) {\\n      const pull = S.objects.find(o => o.tag === 'tremolo-pull');\\n970→      if (pull && pull.done) st.done = true;\\n    }\\n    /* amp falls when a reed is dosed */\\n    const deadReeds = st.reed0 - S.objects.filter(o => o.type === 'reed' && !o.done).length;\\n    st.amp = clamp(1 - deadReeds * 0.2, 0.15, 1);\\n    if (st.stage >= 2) st.amp = Math.min(st.amp, 0.2);\\n  }\\n\\n  function stepDacapo(S, st, dt, tune, sp) {\\n    st.t += dt * sp * (st.round === 2 ? 2 : 1);\\n980→    let anyDead = false;\\n    for (const L of st.lobes) {\\n      if (L.dead) { anyDead = true; continue; }\\n      const period = L.period / (st.round === 2 ? 2 : 1);\\n      const openFor = L.openFor / (st.round === 2 ? 2 : 1);\\n      const u = st.t % period;\\n      L.open = u < openFor;\\n      const o = objById(S, L.oid);\\n      if (o) { o.open = L.open && !L.dead; o.x = L.x; o.y = L.y; if (o.done && !L.dead) { L.dead = true; anyDead = true; if (st.count < 0) st.count = 10; } }\\n    }\\n990→    if (st.count >= 0) {\\n      st.count -= dt;\\n      if (st.count <= 0 && st.lobes.some(L => L.dead) && st.lobes.some(L => !L.dead)) {\\n        /* from the top */\\n        for (const L of st.lobes) {\\n          L.dead = false;\\n          const o = objById(S, L.oid);\\n          if (o) { o.done = false; o.alive = true; o.prog = 0; o.burn = 0; o.dosed = false; o.open = false; if (o.cells) for (const c of o.cells) c[2] = 0; }\\n        }\\n        S.vitals -= 8;\\n1000→        st.count = -1;\\n        st.repeated = (st.repeated || 0) + 1;\\n        if (st.round === 1) { st.round = 2; st.t = 0; spawnBeadsN(S, st, 4); }\\n        pushEv(S, ['dacapo', st.repeated]);\\n      } else if (st.count <= 0) st.count = -1;\\n    }\\n    if (st.lobes.every(L => L.dead) && st.count < 0) {\\n      if (st.round === 1) {\\n        st.round = 2; st.t = 0; st.count = -1;\\n        for (const L of st.lobes) {\\n1010→          L.dead = false;\\n          const o = objById(S, L.oid);\\n          if (o) { o.done = false; o.alive = true; o.prog = 0; o.burn = 0; o.dosed = false; if (o.cells) for (const c of o.cells) c[2] = 0; }\\n        }\\n        spawnBeadsN(S, st, 4);\\n        pushEv(S, ['round2', 1]);\\n      } else if (S.objects.every(o => o.type !== 'bead' || o.done)) st.done = true;\\n    }\\n    if (st.round === 2 && st.lobes.every(L => L.dead) && S.objects.every(o => o.type !== 'bead' || o.done || o.tag !== 'dacapo-bead')) st.done = true;\\n  }\\n1020→\\n  function spawnBeadsN(S, st, n) {\\n    st.beads = st.beads || [];\\n    for (let i = 0; i < n; i++) {\\n      const b = { x: 180 + i * 16, y: 100, tx: 190 + i * 14, ty: 130, x0: 180 + i * 16, y0: 100, landIn: 0.8, flight: 0.8, dead: false, landed: false, hopped: false };\\n      st.beads.push(b);\\n      const o = addObj(S, { type: 'bead', x: b.x, y: b.y, need: 0.12, order: 6, tag: 'dacapo-bead', drain: 0 });\\n      b.oid = o.id;\\n    }\\n    if (!st.kindBead) st.kindBead = true;\\n1030→  }\\n\\n  function stepFermata(S, st, dt, tune) {\\n    st.t += dt;\\n    for (const d of st.domes) if (d.t > 0) d.t -= dt;\\n    st.domes = st.domes.filter(d => d.t > 0);\\n    if (st.stage === 1 && st.domes.length === 0 && !st.eyeOpen) {\\n      st.eyeOpen = S.breath ? 2.8 : 0.7;\\n      st.eye.open = true;\\n      const o = objById(S, st.eye.oid);\\n1040→      if (o) o.open = true;\\n    }\\n    if (st.eyeOpen > 0) {\\n      st.eyeOpen -= dt;\\n      if (st.eyeOpen <= 0) {\\n        st.eye.open = false;\\n        const o = objById(S, st.eye.oid);\\n        if (o && !o.done) o.open = false;\\n        if (st.hits < 3 && st.stage === 1) {\\n          /* raise another dome */\\n1050→          if (st.domes.length < 3) st.domes.push({ x: st.eye.x, y: st.eye.y, r: 34, t: 5 });\\n        }\\n      }\\n    }\\n    const eye = objById(S, st.eye.oid);\\n    if (eye && eye.done) { st.hits += 1; eye.done = false; eye.alive = true; eye.burn = 0; eye.prog = 0; eye.open = false; st.eye.open = false; }\\n    if (st.hits >= 3 && st.stage === 1) {\\n      st.stage = 2;\\n      st.eye.x = 250; st.eye.y = 90; st.eye.hidden = true;\\n      if (eye) { eye.x = 250; eye.y = 90; eye.hidden = true; eye.marked = false; eye.done = false; eye.alive = true; }\\n1060→      addObj(S, { type: 'shard', x: 160, y: 140, axis: [1, 0], depth: 12, order: 3, tag: 'sliver-a', drain: 0.1, hidden: true });\\n      addObj(S, { type: 'shard', x: 180, y: 150, axis: [0.6, 0.8], depth: 12, order: 3, tag: 'sliver-b', drain: 0.1, hidden: true });\\n    }\\n    if (st.stage === 2 && eye && eye.marked) eye.hidden = false;\\n    if (st.stage === 2 && eye && eye.done && S.objects.every(o => o.tag !== 'sliver-a' && o.tag !== 'sliver-b' || o.done)) {\\n      /* eye.done was consumed as a hit; require the flee eye burned once more and slivers out */\\n    }\\n    if (st.stage === 2) {\\n      const slivers = S.objects.filter(o => o.tag === 'sliver-a' || o.tag === 'sliver-b');\\n      const eyeBurned = st.hits >= 4;\\n1070→      if (eye && eye.done) st.hits = Math.max(st.hits, 4);\\n      if (eyeBurned && slivers.every(o => o.done)) {\\n        st.stage = 3;\\n        addObj(S, { type: 'note', x: st.eye.x, y: st.eye.y, axis: [0, -1], depth: 28, tension: 40, order: 5, tag: 'fermata-pull', drain: 0.15 });\\n      }\\n    }\\n    if (st.stage === 3) {\\n      const pull = S.objects.find(o => o.tag === 'fermata-pull');\\n      if (pull && pull.done) st.done = true;\\n    }\\n1080→  }\\n\\n  function stepCantor(S, st, dt, tune) {\\n    st.t += dt;\\n    if (st.move === 1) {\\n      /* tendrils then uvulas, objects already spawned by the phase */\\n      const left = S.objects.filter(o => (o.tag === 'tendril' || o.tag === 'uvula') && !o.done);\\n      if (!left.length) { st.move = 2; st.t = 0; S.clock += 120; S.flags.hush = true; pushEv(S, ['movement', 2]); spawnVoice(S, st); }\\n    } else if (st.move === 2) {\\n      S.flags.hush = true;\\n1090→      st.beat = (st.t % 0.9);\\n      for (const o of S.objects) if (o.type === 'voice') o.window = st.beat > 0.35 && st.beat < 0.7;\\n      if (st.domes && st.t > 2 && st.domes.length < 2 && Math.floor(st.t) % 5 === 0) {\\n        /* one dome refreshes */\\n      }\\n      st.jitter = true;\\n      const voices = S.objects.filter(o => o.type === 'voice' && !o.done);\\n      if (!voices.length) { st.move = 3; st.t = 0; S.clock += 120; S.flags.hush = false; st.signs = 0; pushEv(S, ['movement', 3]); }\\n    } else if (st.move === 3) {\\n      st.cycleT = (st.cycleT || 0) + dt;\\n1100→      if (!st.winding && st.cycleT >= 20) { st.winding = 3; st.cycleT = 0; openRepeat(S, st); }\\n      if (st.winding > 0) {\\n        st.winding -= dt;\\n        if (st.winding <= 0) {\\n          const sign = S.objects.find(o => o.tag === 'repeat' && !o.done);\\n          if (sign) {\\n            forceRewind(S, true);\\n            st.rewound = (st.rewound || 0) + 1;\\n          } else st.signs = (st.signs || 0) + 1;\\n          st.winding = 0;\\n1110→          closeRepeat(S);\\n        }\\n      }\\n      const sign = S.objects.find(o => o.tag === 'repeat' && o.done);\\n      if (sign) { st.signs = (st.signs || 0) + 1; sign.tag = 'repeat-spent'; }\\n      if ((st.signs || 0) >= 6) { st.move = 4; st.t = 0; S.clock += 120; pushEv(S, ['movement', 4]); spawnCoda(S, st); }\\n    } else if (st.move === 4) {\\n      st.beat = (st.t % 0.8) / 0.8;\\n      S.flags.onBeat = st.beat < 0.25;\\n      const spiral = S.objects.find(o => o.type === 'spiral' && o.tag === 'last-note');\\n1120→      const note = S.objects.find(o => o.tag === 'the-note');\\n      const wound = S.objects.find(o => o.tag === 'final-wound');\\n      if (spiral && spiral.done && !st.noteOut) {\\n        st.noteOut = true;\\n        addObj(S, { type: 'note', x: 213, y: 116, axis: [0, -1], depth: 36, tension: 80, order: 2, tag: 'the-note', drain: 0 });\\n      }\\n      if (note && note.done && !wound) {\\n        addObj(S, { type: 'wound', x: 213, y: 130, stitches: 6, order: 3, tag: 'final-wound', drain: 0.3 });\\n      }\\n      if (wound && wound.done) st.done = true;\\n1130→    }\\n  }\\n\\n  function openRepeat(S, st) {\\n    const existing = S.objects.find(o => o.tag === 'repeat');\\n    if (existing) { existing.done = false; existing.alive = true; existing.open = true; existing.prog = 0; return existing; }\\n    return addObj(S, { type: 'repeat', x: 213, y: 100, len: 36, order: 1, tag: 'repeat', open: true, drain: 0, guide: [[190, 100], [236, 100]] });\\n  }\\n  function closeRepeat(S) {\\n    for (const o of S.objects) if (o.tag === 'repeat' && !o.done) { o.open = false; }\\n1140→  }\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/src/core/sim.js\",\"offset\":781,\"limit\":360,\"raw_output\":\"  function stepStrain(S, worldDt, handDt, tune) {\\n    const st = S.strain;\\n    if (!st || st.done) return;\\n    const sp = tune.strains.speed;\\n    if (st.kind === 'staccato') stepStaccato(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'legato') stepLegato(S, st, worldDt, handDt, tune, sp);\\n    else if (st.kind === 'tremolo') stepTremolo(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'dacapo') stepDacapo(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'fermata') stepFermata(S, st, worldDt, tune, sp);\\n    else if (st.kind === 'cantor') stepCantor(S, st, worldDt, tune, sp);\\n  }\\n\\n  function stepStaccato(S, st, dt, tune, sp) {\\n    st.t += dt;\\n    const beat = tune.strains.beat;\\n    for (const b of st.beads) {\\n      if (b.dead) continue;\\n      b.landIn -= dt * sp;\\n      if (!b.hopped && b.landIn < 0.5) b.hopped = true;\\n      if (b.landIn <= 0 && !b.landed) {\\n        b.landed = true; b.x = b.tx; b.y = b.ty;\\n        addObj(S, { type: 'laceration', x: b.x, y: b.y, r: 8, order: 40, drain: 0.2, tag: 'bite' });\\n        pushEv(S, ['bite', Math.round(b.x), Math.round(b.y)]);\\n      }\\n      if (!b.landed) {\\n        const u = clamp(1 - b.landIn / b.flight, 0, 1);\\n        b.x = b.x0 + (b.tx - b.x0) * u;\\n        b.y = b.y0 + (b.ty - b.y0) * u;\\n      }\\n    }\\n    /* cautery kills beads: mirrored onto objects of type bead */\\n    let nests = 0;\\n    for (const o of S.objects) if (o.type === 'nest' && !o.done && o.tag === st.tag) nests++;\\n    if (!nests && !st.collapse) { st.collapse = 3; }\\n    if (st.collapse > 0) {\\n      st.collapse -= dt;\\n      if (st.collapse <= 0) {\\n        for (const b of st.beads) b.dead = true;\\n        for (const o of S.objects) if (o.type === 'bead' && o.tag === st.tag) { o.done = true; o.alive = false; }\\n        st.done = true;\\n      }\\n    }\\n    syncBeads(S, st);\\n    if (st.beads.length && st.beads.every(b => b.dead) && nests === 0) st.done = true;\\n  }\\n\\n  function syncBeads(S, st) {\\n    for (const b of st.beads) {\\n      if (b.dead) continue;\\n      let o = b.oid ? objById(S, b.oid) : null;\\n      if (!o) {\\n        o = addObj(S, { type: 'bead', x: b.x, y: b.y, need: 0.12, order: 5, tag: st.tag, drain: 0 });\\n        b.oid = o.id;\\n      } else {\\n        o.x = b.x; o.y = b.y;\\n        if (o.done) b.dead = true;\\n      }\\n    }\\n  }\\n\\n  function stepLegato(S, st, dt, handDt, tune, sp) {\\n    for (const w of st.worms) {\\n      if (w.done) continue;\\n      w.t += dt * sp;\\n      /* head crawls along its path until surfaced */\\n      if (!w.surfaced && !w.out) {\\n        w.along = Math.min(w.pathLen, w.along + 18 * dt * sp);\\n        const p = pointAlong(w.path, w.along);\\n        w.x = p[0]; w.y = p[1];\\n        /* open a slur guide when the head nears it */\\n        for (const g of w.slurs) {\\n          if (g.opened || g.done) continue;\\n          if (hypot(w.x - g.x, w.y - g.y) < 28) {\\n            g.opened = true;\\n            const o = addObj(S, { type: 'slur', x: g.x, y: g.y, len: 18, order: 1, tag: 'slur-' + w.id + '-' + g.i, drain: 0, guide: [[g.x - 9, g.y], [g.x + 9, g.y]] });\\n            g.oid = o.id;\\n          }\\n        }\\n      }\\n      for (const g of w.slurs) {\\n        if (!g.oid || g.done) continue;\\n        const o = objById(S, g.oid);\\n        if (o && o.done) g.done = true;\\n      }\\n      const slursLeft = w.slurs.filter(g => !g.done).length;\\n      if (!slursLeft && !w.surfaced) {\\n        w.surfaced = true; w.marked = true;\\n        const head = addObj(S, {\\n          type: 'shard', x: w.x, y: w.y, axis: w.axis || [1, 0], depth: 18, order: 2,\\n          tag: 'legato-head', worm: w.id, tension: 70, drain: 0.15, hidden: false,\\n          holdZone: w.hold || null, barbs: w.barbAt || 0,\\n        });\\n        w.head = head.id;\\n      }\\n      const head = w.head ? objById(S, w.head) : null;\\n      if (head && head.snapped && !w.snapped) {\\n        w.snapped = true; st.snapped = true;\\n        /* regrow a head further along and flee */\\n        head.done = true; head.alive = false;\\n        w.surfaced = false; w.out = false; w.head = 0;\\n        w.along = Math.min(w.pathLen - 4, w.along + 30);\\n        w.slurs.push({ i: 90 + w.slurs.length, x: w.x + 16, y: w.y, opened: false, done: false });\\n        pushEv(S, ['regrow', w.id]);\\n      }\\n      if (head && head.done && !w.out) {\\n        w.pulled = (w.pulled || 0) + 1;\\n        /* barb every 4th segment: if not clamped, snapping already handled via tension */\\n        if (w.barbAt && w.pulled % 4 === 0 && !head.clamped && !w.barbCleared) {\\n          /* require a clamp before the next length counts — head.done means the whole pull finished.\\n             Barbs are separate cautery objects spawned at the hold. */\\n        }\\n        w.segments -= 4;\\n        if (w.segments <= w.half && !w.split && st.worms.length < 3) {\\n          w.split = true; w.half = -1;\\n          st.worms.push(makeWorm(S, w.x + 20, w.y + 14, Math.max(4, w.segments >> 1), w.id + 1));\\n          pushEv(S, ['split', w.id]);\\n        }\\n        if (w.segments <= 0) { w.done = true; w.out = true; }\\n        else {\\n          /* next length */\\n          w.out = false; w.surfaced = true;\\n          const h2 = addObj(S, {\\n            type: 'shard', x: w.x, y: w.y, axis: [1, 0], depth: 14, order: 2,\\n            tag: 'legato-head', worm: w.id, tension: 70, drain: 0.1,\\n            holdZone: w.barbAt && (w.pulled % 4 === 0) ? [w.x + 30, w.y, 16] : null,\\n          });\\n          w.head = h2.id;\\n          if (w.barbAt && w.pulled % 4 === 0) {\\n            addObj(S, { type: 'barb', x: w.x + 30, y: w.y, need: 0.35, order: 3, tag: 'barb-' + w.id, drain: 0 });\\n          }\\n        }\\n      }\\n    }\\n    if (st.worms.every(w => w.done)) st.done = true;\\n  }\\n\\n  function makeWorm(S, x, y, segments, id) {\\n    const path = [];\\n    for (let i = 0; i < 8; i++) path.push([x + i * 14, y + Math.sin(i) * 8]);\\n    let pathLen = 0;\\n    for (let i = 1; i < path.length; i++) pathLen += hypot(path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1]);\\n    const slurs = [0.25, 0.5, 0.75].map((u, i) => {\\n      const p = pointAlong(path, pathLen * u);\\n      return { i, x: p[0], y: p[1], opened: false, done: false };\\n    });\\n    return { id, x, y, path, pathLen, along: 0, segments, half: segments / 2, slurs, surfaced: false, done: false, t: 0, split: false, pulled: 0, barbAt: 4, marked: false, axis: [1, 0] };\\n  }\\n  function pointAlong(path, dist) {\\n    let left = dist;\\n    for (let i = 1; i < path.length; i++) {\\n      const L = hypot(path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1]) || 1;\\n      if (left <= L) {\\n        const u = left / L;\\n        return [path[i - 1][0] + (path[i][0] - path[i - 1][0]) * u, path[i - 1][1] + (path[i][1] - path[i - 1][1]) * u];\\n      }\\n      left -= L;\\n    }\\n    return path[path.length - 1].slice();\\n  }\\n\\n  function stepTremolo(S, st, dt, tune) {\\n    st.t += dt;\\n    st.beat = (st.t % 0.8) / 0.8;\\n    const peak = st.beat > 0.85 || st.beat < 0.1;\\n    st.flare = peak;\\n    S.flags.onBeat = st.beat > 0.45 && st.beat < 0.7 ? false : st.beat < 0.15;\\n    /* vitals shake and drain */\\n    if (!S.breath) S.vitals -= 0.6 * st.amp * dt * tune.strains.damage;\\n    for (const o of S.objects) if (o.type === 'reed' && o.tag === 'reed') o.window = !!st.flare;\\n    const reeds = S.objects.filter(o => o.type === 'reed' && !o.done);\\n    if (st.stage === 1 && reeds.length === 0) { st.stage = 2; st.amp = Math.min(st.amp, 0.2); }\\n    if (st.amp <= 0.2 && st.stage === 1) st.stage = 2;\\n    if (st.stage === 2) {\\n      st.wake -= dt;\\n      if (st.wake <= 0) {\\n        st.wake = 6;\\n        /* a reed returns */\\n        if (S.objects.filter(o => o.type === 'reed' && !o.done).length < 2) {\\n          addObj(S, { type: 'reed', x: st.x - 20 + rnd(S) * 40, y: st.y - 10, order: 1, tag: 'reed', drain: 0, window: false });\\n        }\\n      }\\n      const mass = S.objects.find(o => o.type === 'tremass');\\n      if (mass && mass.done && st.stage === 2) {\\n        st.stage = 3;\\n        addObj(S, { type: 'shard', x: st.x, y: st.y, axis: [1, 0], depth: 40, order: 4, tag: 'tremolo-pull', tension: 90, drain: 0.2 });\\n      }\\n    }\\n    if (st.stage === 3) {\\n      const pull = S.objects.find(o => o.tag === 'tremolo-pull');\\n      if (pull && pull.done) st.done = true;\\n    }\\n    /* amp falls when a reed is dosed */\\n    const deadReeds = st.reed0 - S.objects.filter(o => o.type === 'reed' && !o.done).length;\\n    st.amp = clamp(1 - deadReeds * 0.2, 0.15, 1);\\n    if (st.stage >= 2) st.amp = Math.min(st.amp, 0.2);\\n  }\\n\\n  function stepDacapo(S, st, dt, tune, sp) {\\n    st.t += dt * sp * (st.round === 2 ? 2 : 1);\\n    let anyDead = false;\\n    for (const L of st.lobes) {\\n      if (L.dead) { anyDead = true; continue; }\\n      const period = L.period / (st.round === 2 ? 2 : 1);\\n      const openFor = L.openFor / (st.round === 2 ? 2 : 1);\\n      const u = st.t % period;\\n      L.open = u < openFor;\\n      const o = objById(S, L.oid);\\n      if (o) { o.open = L.open && !L.dead; o.x = L.x; o.y = L.y; if (o.done && !L.dead) { L.dead = true; anyDead = true; if (st.count < 0) st.count = 10; } }\\n    }\\n    if (st.count >= 0) {\\n      st.count -= dt;\\n      if (st.count <= 0 && st.lobes.some(L => L.dead) && st.lobes.some(L => !L.dead)) {\\n        /* from the top */\\n        for (const L of st.lobes) {\\n          L.dead = false;\\n          const o = objById(S, L.oid);\\n          if (o) { o.done = false; o.alive = true; o.prog = 0; o.burn = 0; o.dosed = false; o.open = false; if (o.cells) for (const c of o.cells) c[2] = 0; }\\n        }\\n        S.vitals -= 8;\\n        st.count = -1;\\n        st.repeated = (st.repeated || 0) + 1;\\n        if (st.round === 1) { st.round = 2; st.t = 0; spawnBeadsN(S, st, 4); }\\n        pushEv(S, ['dacapo', st.repeated]);\\n      } else if (st.count <= 0) st.count = -1;\\n    }\\n    if (st.lobes.every(L => L.dead) && st.count < 0) {\\n      if (st.round === 1) {\\n        st.round = 2; st.t = 0; st.count = -1;\\n        for (const L of st.lobes) {\\n          L.dead = false;\\n          const o = objById(S, L.oid);\\n          if (o) { o.done = false; o.alive = true; o.prog = 0; o.burn = 0; o.dosed = false; if (o.cells) for (const c of o.cells) c[2] = 0; }\\n        }\\n        spawnBeadsN(S, st, 4);\\n        pushEv(S, ['round2', 1]);\\n      } else if (S.objects.every(o => o.type !== 'bead' || o.done)) st.done = true;\\n    }\\n    if (st.round === 2 && st.lobes.every(L => L.dead) && S.objects.every(o => o.type !== 'bead' || o.done || o.tag !== 'dacapo-bead')) st.done = true;\\n  }\\n\\n  function spawnBeadsN(S, st, n) {\\n    st.beads = st.beads || [];\\n    for (let i = 0; i < n; i++) {\\n      const b = { x: 180 + i * 16, y: 100, tx: 190 + i * 14, ty: 130, x0: 180 + i * 16, y0: 100, landIn: 0.8, flight: 0.8, dead: false, landed: false, hopped: false };\\n      st.beads.push(b);\\n      const o = addObj(S, { type: 'bead', x: b.x, y: b.y, need: 0.12, order: 6, tag: 'dacapo-bead', drain: 0 });\\n      b.oid = o.id;\\n    }\\n    if (!st.kindBead) st.kindBead = true;\\n  }\\n\\n  function stepFermata(S, st, dt, tune) {\\n    st.t += dt;\\n    for (const d of st.domes) if (d.t > 0) d.t -= dt;\\n    st.domes = st.domes.filter(d => d.t > 0);\\n    if (st.stage === 1 && st.domes.length === 0 && !st.eyeOpen) {\\n      st.eyeOpen = S.breath ? 2.8 : 0.7;\\n      st.eye.open = true;\\n      const o = objById(S, st.eye.oid);\\n      if (o) o.open = true;\\n    }\\n    if (st.eyeOpen > 0) {\\n      st.eyeOpen -= dt;\\n      if (st.eyeOpen <= 0) {\\n        st.eye.open = false;\\n        const o = objById(S, st.eye.oid);\\n        if (o && !o.done) o.open = false;\\n        if (st.hits < 3 && st.stage === 1) {\\n          /* raise another dome */\\n          if (st.domes.length < 3) st.domes.push({ x: st.eye.x, y: st.eye.y, r: 34, t: 5 });\\n        }\\n      }\\n    }\\n    const eye = objById(S, st.eye.oid);\\n    if (eye && eye.done) { st.hits += 1; eye.done = false; eye.alive = true; eye.burn = 0; eye.prog = 0; eye.open = false; st.eye.open = false; }\\n    if (st.hits >= 3 && st.stage === 1) {\\n      st.stage = 2;\\n      st.eye.x = 250; st.eye.y = 90; st.eye.hidden = true;\\n      if (eye) { eye.x = 250; eye.y = 90; eye.hidden = true; eye.marked = false; eye.done = false; eye.alive = true; }\\n      addObj(S, { type: 'shard', x: 160, y: 140, axis: [1, 0], depth: 12, order: 3, tag: 'sliver-a', drain: 0.1, hidden: true });\\n      addObj(S, { type: 'shard', x: 180, y: 150, axis: [0.6, 0.8], depth: 12, order: 3, tag: 'sliver-b', drain: 0.1, hidden: true });\\n    }\\n    if (st.stage === 2 && eye && eye.marked) eye.hidden = false;\\n    if (st.stage === 2 && eye && eye.done && S.objects.every(o => o.tag !== 'sliver-a' && o.tag !== 'sliver-b' || o.done)) {\\n      /* eye.done was consumed as a hit; require the flee eye burned once more and slivers out */\\n    }\\n    if (st.stage === 2) {\\n      const slivers = S.objects.filter(o => o.tag === 'sliver-a' || o.tag === 'sliver-b');\\n      const eyeBurned = st.hits >= 4;\\n      if (eye && eye.done) st.hits = Math.max(st.hits, 4);\\n      if (eyeBurned && slivers.every(o => o.done)) {\\n        st.stage = 3;\\n        addObj(S, { type: 'note', x: st.eye.x, y: st.eye.y, axis: [0, -1], depth: 28, tension: 40, order: 5, tag: 'fermata-pull', drain: 0.15 });\\n      }\\n    }\\n    if (st.stage === 3) {\\n      const pull = S.objects.find(o => o.tag === 'fermata-pull');\\n      if (pull && pull.done) st.done = true;\\n    }\\n  }\\n\\n  function stepCantor(S, st, dt, tune) {\\n    st.t += dt;\\n    if (st.move === 1) {\\n      /* tendrils then uvulas, objects already spawned by the phase */\\n      const left = S.objects.filter(o => (o.tag === 'tendril' || o.tag === 'uvula') && !o.done);\\n      if (!left.length) { st.move = 2; st.t = 0; S.clock += 120; S.flags.hush = true; pushEv(S, ['movement', 2]); spawnVoice(S, st); }\\n    } else if (st.move === 2) {\\n      S.flags.hush = true;\\n      st.beat = (st.t % 0.9);\\n      for (const o of S.objects) if (o.type === 'voice') o.window = st.beat > 0.35 && st.beat < 0.7;\\n      if (st.domes && st.t > 2 && st.domes.length < 2 && Math.floor(st.t) % 5 === 0) {\\n        /* one dome refreshes */\\n      }\\n      st.jitter = true;\\n      const voices = S.objects.filter(o => o.type === 'voice' && !o.done);\\n      if (!voices.length) { st.move = 3; st.t = 0; S.clock += 120; S.flags.hush = false; st.signs = 0; pushEv(S, ['movement', 3]); }\\n    } else if (st.move === 3) {\\n      st.cycleT = (st.cycleT || 0) + dt;\\n      if (!st.winding && st.cycleT >= 20) { st.winding = 3; st.cycleT = 0; openRepeat(S, st); }\\n      if (st.winding > 0) {\\n        st.winding -= dt;\\n        if (st.winding <= 0) {\\n          const sign = S.objects.find(o => o.tag === 'repeat' && !o.done);\\n          if (sign) {\\n            forceRewind(S, true);\\n            st.rewound = (st.rewound || 0) + 1;\\n          } else st.signs = (st.signs || 0) + 1;\\n          st.winding = 0;\\n          closeRepeat(S);\\n        }\\n      }\\n      const sign = S.objects.find(o => o.tag === 'repeat' && o.done);\\n      if (sign) { st.signs = (st.signs || 0) + 1; sign.tag = 'repeat-spent'; }\\n      if ((st.signs || 0) >= 6) { st.move = 4; st.t = 0; S.clock += 120; pushEv(S, ['movement', 4]); spawnCoda(S, st); }\\n    } else if (st.move === 4) {\\n      st.beat = (st.t % 0.8) / 0.8;\\n      S.flags.onBeat = st.beat < 0.25;\\n      const spiral = S.objects.find(o => o.type === 'spiral' && o.tag === 'last-note');\\n      const note = S.objects.find(o => o.tag === 'the-note');\\n      const wound = S.objects.find(o => o.tag === 'final-wound');\\n      if (spiral && spiral.done && !st.noteOut) {\\n        st.noteOut = true;\\n        addObj(S, { type: 'note', x: 213, y: 116, axis: [0, -1], depth: 36, tension: 80, order: 2, tag: 'the-note', drain: 0 });\\n      }\\n      if (note && note.done && !wound) {\\n        addObj(S, { type: 'wound', x: 213, y: 130, stitches: 6, order: 3, tag: 'final-wound', drain: 0.3 });\\n      }\\n      if (wound && wound.done) st.done = true;\\n    }\\n  }\\n\\n  function openRepeat(S, st) {\\n    const existing = S.objects.find(o => o.tag === 'repeat');\\n    if (existing) { existing.done = false; existing.alive = true; existing.open = true; existing.prog = 0; return existing; }\\n    return addObj(S, { type: 'repeat', x: 213, y: 100, len: 36, order: 1, tag: 'repeat', open: true, drain: 0, guide: [[190, 100], [236, 100]] });\\n  }\\n  function closeRepeat(S) {\\n    for (const o of S.objects) if (o.tag === 'repeat' && !o.done) { o.open = false; }\\n  }\\n\",\"total_lines\":1684}}","is_error":false},{"type":"tool_result","tool_use_id":"call-d279b093-0547-474d-b43c-dfa1b2f48052-10","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"159→## 5. The operation\\n160→\\nSim rules for this whole section: fixed steps, `dt` from the engine, all state in one plain object (19.2). Every number below is a default in the `TUNING` table in `src/config.js`, read live so dev mode's sliders reach it.\\n\\n### 5.1 The table\\n\\n- Positions are in **field units (u)**: design space 426 x 240, origin top left, 1 u = 1 buffer pixel. To the screen: add `OX = (r.W - 426) >> 1`, `OY = (r.H - 240) >> 1`.\\n- The **cavity** is an ellipse centered at (213, 116) with radii (171, 91). Everything interactive stays inside it. Bigger screens show more drape, never a bigger cavity. Its ellipse leaves the four corners free for the HUD.\\n- Draw back to front: drape fill, field (tissue, pools, wounds, gel, char, ridges, all through the painter's stamps), objects, engine particles, then `r.overlay` (stitches, strains' glow, guides, instruments, cursors, HUD).\\n\\n**HUD on the smallest screen, anchored to `r.W` and `r.H`:**\\n170→\\n| Piece | Place | Contents |\\n|---|---|---|\\n| Monitor | (6, 6), 148 x 30 | ECG trace, vitals number at font scale 2 |\\n| Clock | right edge, y 6, 70 x 22 | `01:42` at font scale 2 |\\n| Objective | top center, y 12 | At most 26 characters, a verb first: \\\"Drain the pool\\\" |\\n| Speaker | bottom left, a 56 x 64 crop of a cached bust (from its 28, 16) at (4, H-62), masked in theatre | Who is barking |\\n| Bark box | (62, H-34), 236 x 28 | Name, one line of at most 40 characters, gone after 2.5 s plus .05 s a character |\\n| Steady gauge | bottom right, 90 x 16 | Bar, its glyph, READY when usable |\\n| Flow | above the gauge | `FLOW x6` from a chain of 3 |\\n180→| Cursor prompt | beside the cursor, flipping near edges | `R2 Pull`, only over a valid target |\\n\\nKeep it this sparse. The patient is the screen.\\n\\n### 5.2 Vitals, clock, slips\\n\\n- **Vitals** run 0 to 99 (a float in the sim, shown whole). Each case has a start value and a base drain. Each open hazard adds its own drain (section 7).\\n- The player feels vitals through five channels so no one needs to look: the number, the ECG's rate, the monitor beep's rate and pitch, a double-thump rumble below 30, and Quill's calm readouts (\\\"Pulse forty. I mention it only in passing.\\\"). Below 30 the number flashes and CRITICAL appears, so it is never color alone.\\n- At 0: Code Blue if unused (5.8), else the patient is lost.\\n- **Clock:** counts down in world time. At 0 the patient is lost, with no Code Blue (\\\"Time of death, oh-four-twelve.\\\").\\n190→- **Slips** (mistakes): no cap on them. Each one costs vitals, breaks Flow, and shows in Results.\\n\\n### 5.3 The cursor\\n\\nThis is where the game lives or dies on a pad. Make it good before making anything else.\\n\\n- **Pad:** velocity = `stick^1.7 x 330 u/s` with a .06 s ramp. Fine mode (L2) multiplies by .35. Full deflection crosses the field in about a second, and small pushes are slow enough to place a stitch.\\n- **Magnet** (`assist` setting, default .6): within 22 u of a target valid for the held tool, speed drops by `.55 x assist` and, while the stick is near neutral, the cursor is pulled to the target at `90 x assist` u/s.\\n- **Guide-follow:** during a Scalpel stroke or a stitch, the part of the stick's push across the guide is scaled by `1 - .8 x assist`. At full assist a rough push along the line traces it, which is the accessibility floor.\\n- **Mouse:** the cursor is the pointer, 1:1, never moved by the game. Assist only widens the tolerances, by up to 1 u.\\n200→- **Keyboard:** WASD or arrows at 200 u/s, Shift for fine. D-pad nudges at 40 u/s.\\n- **Look:** an instrument whose tip is the exact aim point, gripped by a gloved hand down and to the right, so the hand never hides the target. In co-op the glove is the seat's color. Hide the OS pointer in `op`, and bring it back while paused.\\n- **Loupe:** holding Fine for .15 s shows a 2x lens of radius 34 around the cursor, pixel-doubled from the finished frame, with row-by-row `drawImage` and smoothing off. It is cosmetic.\\n\\n### 5.4 The tool wheel\\n\\nEight tools, eight stick directions, always the same place, so hands learn them like a real surgeon's \\\"Forceps!\\\".\\n\\n```\\n         N  Forceps\\n210→  NW Sonar        NE Scalpel\\nW Suction            E Suture\\n  SW Cautery      SE Salve\\n         S  Syringe\\n```\\n\\nTop takes, right closes, bottom medicates, left clears. Number keys 1 to 8 run clockwise from Forceps.\\n\\n- **Pad:** push the left stick past .6. The sector stable for 80 ms is picked. The ring shows around the cursor while the stick is out and .3 s after, with a clack, Quill's slap in the palm, and his gibberish bark of the tool's name. L1 and R1 step through the wheel too.\\n- **Mouse:** scroll steps. Hold Right click, flick, release to pick.\\n220→- **Keys:** 1 to 8, or Q and E.\\n- A swap takes .12 s. Time does not stop for the wheel.\\n- **Hints:** on Intern (and with Hints on, after 6 s of idling or a repeated slip), the next tool's tile glows and Quill names it.\\n- Tile art is 20 x 20, each tool a distinct silhouette, readable at 10 feet.\\n\\n### 5.5 The eight tools\\n\\nAnalog input only ever gives more control, never more power: a key or a click counts as a full press. \\\"Hold or toggle\\\" for sustained tools is a setting.\\n\\n| Tool | Gesture | Marker on the field |\\n230→|---|---|---|\\n| **Forceps** | Grip, pull along the axis, release | White corner brackets |\\n| **Scalpel** | Press on the start dot, trace the line | Purple dashed marker line, start dot |\\n| **Suture** | Press at one side, cross the wound, release at the other | Blue paired dots |\\n| **Salve** | Hold and paint over the patch | Green hatch |\\n| **Syringe** | Hold to draw, release to inject | A plus-sign ring on targets. Anywhere else goes to the IV |\\n| **Cautery** | Hold the beam on the target | Orange ring |\\n| **Suction** | Hold over the pool | None needed, the pool is the marker |\\n| **Sonar** | Hold to sweep a lens | Arcs when something hidden is near |\\n\\n240→**Forceps.** Grip within 12 u at trigger .3. An *embedded* object has an out-axis and a depth: progress is cursor travel along the axis. Pulling faster than 120 u/s, or more than 8 u off axis, **tears** (laceration, vitals -4, progress -30%). Past its depth it comes free and follows the cursor. Release 24 u or more from its origin, or past the cavity's edge, and Quill's dish catches it with a clink. Grade: no tears and under its par time is Textbook, one tear is Clean, else Sloppy. A held piece can be handed off in some cases: release inside a **hold zone** and Quill clamps it (Case 5).\\n\\n**Scalpel.** The guide is a polyline. Press within 8 u of the start. Progress is the furthest arc length reached. Distance from the line over 9 u for .12 s is a **slip** (short laceration, vitals -3), and the stroke goes on when you come back. Release early and resume within 6 u. Grade by mean distance: 1.8 u or less is Textbook, 4 u or less is Clean, else Sloppy. Variants: a *ring* (closed loop around a mass), and a *slash* (any stroke crossing a target at 60 u/s or more). Dragging the blade 6 u over healthy tissue with no guide is a slip. Crossing a nerve or eloquent line costs vitals -12 and always counts as a slip.\\n\\n**Suture.** A wound has N stitches, each a pair of points across it. Press within 9 u of the next near point, carry across, release within 6 u of the far point. A bad release is a loose stitch (vitals -1, redo it). Each stitch set closes 1/N of the wound and cuts its bleeding. Per stitch: .6 s or less is Textbook, 1.2 s or less is Clean. The wound's grade is the mean. The needle arcs across, the thread pulls tight with a pop, and the wound's lips close on the field.\\n\\n**Salve.** Paints a coverage grid of 4 u cells with a 10 u brush. A patch needs 90% coverage, then heals with a sparkle and gives +2 vitals. It also coats some strain parts. It cannot harm, only waste time.\\n\\n**Syringe.** Hold to fill, 0 to full in .55 s. Release to inject. Over a target within 10 u, that is a targeted dose: at .9 full or more it counts Textbook; held .3 s past full gets an air bubble (Sloppy, half effect). Anywhere else it goes to the IV: vitals +18 x fill (Intern +24, Attending +12). .35 s cooldown. This is the panic button, so it must always feel available.\\n\\n250→**Cautery.** Hold for a beam on a 6 u spot. Polyp .5 s, pinhole bleeder .35 s, Staccato bead .12 s. Heat fills at .5/s and cools at .6/s; at 1 it locks for 1.2 s. On bare tissue for .25 s it leaves char, -.8 vitals/s, and a slip at .6 s. Grade: no char and no lockout during the kill is Textbook.\\n\\n**Suction.** Hold within 14 u of a pool: removes 60 volume/s, with a gurgle that rises as it empties. Objects under a pool can't be seen or targeted until it's cleared. It has no grade, but it never breaks Flow, so it is always a safe move.\\n\\n**Sonar.** Hold for a lens of radius 38 in the cold palette (the painter's `lens`). Hidden objects show inside it and stay marked for 4 s after it leaves. A ping rises in rate with proximity. HUSH's song grows and pans toward the nearest strain, so the player can hunt by ear. Hidden objects cannot be touched until marked.\\n\\n### 5.6 Grades, Flow, ranks\\n\\n- Every finished action gets a popup at its location, with sound: **Sloppy** (x.4), **Clean** (x1), **Textbook** (x1.5). Text, size and sound differ, so it is never color alone.\\n- **Flow:** consecutive non-Sloppy actions, +5% each up to x2. A slip resets it.\\n260→- **End bonus:** clock left x 2, vitals x 3.\\n- **Rank:** score against the case's `par` (a perfect bot's score at Resident, section 20): S 95%, A 80%, B 60%, C 40%, else D. On Attending, S with no slips earns a star, **★ Textbook**. Each difficulty keeps its own best rank.\\n- **Results shows only four tiles**, one at a time, each with a tick: Time left, Pulse held, Technique (share of Clean or better), Best Flow. Then the rank stamp and Quill's line for that rank. No tables.\\n\\n### 5.7 The Steady (the gift)\\n\\nAn old word in theatre for surgeons who can do what shouldn't be possible. The gauge runs 0 to 100, shared in the finale: +5 per Clean, +10 per Textbook, +.5/s. One button (△, F or Middle click). Activation never fails.\\n\\n**Long Breath (Dr. Vale).** Needs 35. The world runs at .25 speed while the hands stay at full speed. Drains 16/s; press again to stop. Implement it with a world-time factor in the sim, **not** `game.timeScale`. The field shifts to the cold palette (the painter's `slow`), so glowing strains and dark blood stand out. Music thins, sound low-passes, the heartbeat dominates. Strains and hazards all pulse with outlines. This image is the game's signature: *Verified*, it reads beautifully in the prototype.\\n\\n270→**Second Look (Dr. Sokolova).** Needs 45. Rewinds the sim up to 6 s. A ring buffer holds a snapshot of the state every .1 s. Restoring is exact: vitals, clock, objects, RNG. Then, for the next 6 s, **ghosts** replay: pale afterimages of her own cursor and of every strain, taken from the buffer, where they were last time. Rewinding is literally a second look at what is about to happen. Presentation: 1.2 s of fast reverse with VCR tracking lines, a falling tape sweep, Quill's bark reversed. Her line: \\\"No. Again.\\\" The rewound seconds' grades and score vanish. There is no rank penalty. Her hands are outside time: the cursor stays where the player has it, and anything held or mid-stroke is let go, so a rewind can never force a slip. Not available in Grand Rounds.\\n\\n**Consult (Cases 10 and 11).** □ or C hands over to the other doctor in .4 s. Gauge shared, each doctor's gift and passive apply: Vale has +15% cursor speed and +25% Sonar radius; Sokolova has +.2 assist and +1 u suture tolerance.\\n\\n### 5.8 Code Blue\\n\\nThe first time vitals reach 0 in a case (not on Attending): the world freezes and the paddles come out. The ECG scrolls full-width with 4 charge pips, a marker crossing the peak every .9 s. Press L2 and R2 together (Left click or Space on keyboard and mouse) inside ±.14 s of the peak; ±.06 s is Textbook. Two hits in four attempts: vitals to 30, and play resumes with a jolt, a huge rumble and a white flash. Fewer: patient lost. \\\"Clear!\\\" in gibberish. It doesn't cap the rank: the lost time and low vitals already cost enough.\\n\\n### 5.9 Closing\\n\\n280→When the last phase clears, the op doesn't just end. Quill: \\\"Dressing.\\\" A timing ring closes on the wound; press on the ring for a stamp, with a bonus for the timing. \\\"CASE CLOSED\\\" stamps across the screen, with `TIME OF COMPLETION 02:14`. Sound drops to one held chord. This is the reward beat. Land it.\\n\\n### 5.10 Failing and retrying\\n\\n- Phase boundaries are checkpoints. **Retry from this phase** restores the phase's starting state with rank capped at B. **Restart case** is uncapped.\\n- After 2 failures in one phase, Quill offers Intern for this case only.\\n- Tutorial moments (Cases 1 to 4) freeze the clock and vitals until the first success of a new verb, with a big prompt beside the target.\\n\\n**Difficulty.** Intern: drains x.7, clock x1.3, hints on, assist +.2. Resident: baseline. Attending: drains x1.3, clock x.8, no Code Blue, hints only after 10 s, ★ available. Changeable between cases.\\n\\n290→**Balance targets at Resident.** A first-time player clears Cases 1 and 2 first try, fails Case 3 once or twice, needs 2 to 4 tries on Tremolo and 3 to 6 on the Cantor. By bot (19.4): a human-like bot (reaction .25 s, aim error 3 u, speed 260 u/s) clears every case on Intern and at least 70% of them on Resident; the perfect bot finishes every case with at least 30% of the clock and 40 vitals left. If a case misses, tune its numbers, not the core.\\n\\n### 5.11 Feel table\\n\\nEvery tool gets all three channels. `input.rumble(strength, seconds)`, scaled by the engine's Vibration setting.\\n\\n| Moment | Sound | Particles or picture | Rumble |\\n|---|---|---|---|\\n| Tool swap | Clack, palm slap | Ring flash, instrument changes | .15 / .03 |\\n| Forceps grip, free | Tick, then clink in dish | Glint, droplets | .15 / .04, .3 / .05 |\\n300→| Tear | Wet rip | Spurt, hit-stop .04 s, screen shake 2 | .5 / .1 |\\n| Scalpel stroke | Rising hiss | Thin blood line opening behind the tip | .1 steady |\\n| Stitch pop | Thread twang | Lips close, thread pulls tight | .25 / .05 |\\n| Cautery | Sizzle | Spark, smoke, hot spot | .2 steady |\\n| Suction | Gurgle rising in pitch | Pool shrinks toward the tip | .1 steady |\\n| Syringe | Plunger hiss | Bubbles in the barrel, pulse flash on the monitor | .1 / .1 |\\n| Textbook | Bright two-note chime | Big popup, gold sparkle | .2 / .05 |\\n| Slip | Low thud, Quill sighs | Red flash on the field, monitor jumps | .6 / .12 |\\n| Vitals critical | Monitor alarm | Vignette, number flashes | double thump per beat |\\n| Code Blue shock | Whine, bang | White flash, field jumps | 1 / .35 |\\n310→| Boss phase | Choir swell | Shake, field darkens | .7 / .4 |\\n\\nComfort: `game.shake` and `game.flash` already follow the comfort settings. Settings adds **Blood color** (Surgical red, or Clinical teal-grey, a swap of the blood and wound ramps).\\n\\n---\\n\\n## 6. Controls and prompts\\n\\nThe keyboard and mouse are native here, not stand-ins for controller buttons: the same game on the same screens, with the keys PC players expect for this kind of game. The mouse is the best pointer in the game, and the pad is the best-feeling couch device.\\n\\n320→| Action | DualSense (standard mapping) | Keyboard and mouse |\\n|---|---|---|\\n| Aim | Right stick. D-pad nudges | Mouse, or WASD or arrows |\\n| Use tool | R2 (analog) or ✕ | Left click or Space |\\n| Fine mode, loupe | L2 | Shift |\\n| Pick tool | Left stick flick | 1 to 8. Hold Right click and flick |\\n| Step tool | L1, R1 | Q, E, or the wheel |\\n| The Steady | △ | F or Middle click |\\n| Consult | □ | C |\\n| Drop, cancel stroke | ○ | X or Backspace |\\n330→| Code Blue shock | L2 + R2 | Left click or Space |\\n| Pause | Options | Esc or P |\\n| Ward: walk | Left stick or D-pad | WASD or arrows, or click to walk |\\n| Ward: talk, use | ✕ | E or Enter, or click the person |\\n| Story: advance | ✕ | Enter, Space or click |\\n| Story: fast-forward | Hold □ | Hold Ctrl |\\n| Story: backlog | △ | B |\\n\\nSettings adds **Swap sticks** for left-handers (cursor and wheel trade sticks).\\n\\n340→```js\\nconst { attack, dash, skill, jump, ...base } = E.Input.DEFAULT;\\nconst INPUT = { ...base,\\n  useTool: ['Pad7', 'Pad0', 'Mouse0', 'Space'], fine: ['Pad6', 'ShiftLeft', 'ShiftRight'], gift: ['Pad3', 'KeyF', 'Mouse1'], consult: ['Pad2', 'KeyC'],\\n  toolPrev: ['Pad4', 'KeyQ', 'WheelUp'], toolNext: ['Pad5', 'KeyE', 'WheelDown'], wheelHold: ['Mouse2'],\\n  curU: ['KeyW', 'ArrowUp'], curD: ['KeyS', 'ArrowDown'], curL: ['KeyA', 'ArrowLeft'], curR: ['KeyD', 'ArrowRight'],   // separate from up/down/left/right, which the left stick also presses\\n  nudgeU: ['Pad12'], nudgeD: ['Pad13'], nudgeL: ['Pad14'], nudgeR: ['Pad15'],\\n  tool1: ['Digit1'], tool2: ['Digit2'], tool3: ['Digit3'], tool4: ['Digit4'], tool5: ['Digit5'], tool6: ['Digit6'], tool7: ['Digit7'], tool8: ['Digit8'],\\n  interact: ['Pad0', 'KeyE', 'Enter'], skip: ['Pad2', 'ControlLeft'], log: ['Pad3', 'KeyB'], more: ['Pad3', 'KeyM'] };\\n```\\n350→\\nRead the two sticks from `input.padAim` and `input.padMove`, the trigger from `input.value('useTool')`. Name the actions and hide `tool1` to `tool8` from rebinding through `menu.controls`. Give the scene `camera: { zoom: false, wheel: false }`, because the wheel is the game's.\\n\\n**Prompts.** Always through `game.input.label(action)`, so they follow the device used last and the player's rebinding. Draw a label as a button cap: a rounded rectangle with the label in it, the PlayStation or Xbox face colors on face buttons, and plain keycaps for keys. For the sticks, draw a small stick icon with L or R. Never hard-code a key in text. PlayStation glyphs by default with the Xbox option from fact 5.\\n\\n---\\n\\n## 7. Things on the table\\n\\nA registry (`defObject`), each with sim behavior, a draw function kept apart, and a bot plan.\\n360→\\n| Type | Looks like | Fixed by | Vitals/s while open | Other effects |\\n|---|---|---|---|---|\\n| `shard` | Glass or steel sliver with a glint | Forceps along its axis | .1 | |\\n| `laceration` | Short red cut | Salve | .2 | Small pool over time |\\n| `wound` | Gaping cut with lips | Suture N stitches | .4 | Bleeding falls with each stitch |\\n| `bleeder` | Pinhole spurting on the beat | Cautery | .5 | Feeds a pool, 6 volume/s |\\n| `arteryTear` | Pulsing spurts | Suture 3 | 1 | Feeds a pool, 14 volume/s |\\n| `pool` | Dark wet metaball, specular | Suction | none | Hides what's under it, drifts on a tilt |\\n| `polyp` | Pink nub | Cautery | .1 | |\\n370→| `mass` | Large lump | Scalpel ring, Forceps lift, leaves a `wound` | .2 | |\\n| `hook` | Barbed steel | Scalpel relief cuts at each barb, then Forceps | .3 | Tears if pulled with barbs set |\\n| `clot` | Dark lump in a vessel | Targeted Syringe, then Forceps | .3 | |\\n| `patch` | Inflamed red hatch | Salve | .1 | |\\n| `nerve`, `eloquent` | Gold line (no-touch) | Avoid | | Touching with Scalpel or Cautery: -12 and a slip |\\n| `retractorHandle` | Steel handle (Grand Rounds) | Forceps hold | | Opens a window on a target while held |\\n| device parts | Screws, wires, leads (Case 9) | Per Case 9 | | |\\n\\nObjects can be **hidden** (need Sonar), **under a pool**, or **tied** to a phase script. Phase scripts are data: `at: [{ t: 25, do: 'lurch' }]`, `when: 'clear'`.\\n\\n380→---\\n\\n## 8. HUSH: the strains\\n\\n**HUSH** stands for *Hyperplastic Undifferentiated Synaptic Hive*: an engineered parasite colony that feeds on pain signals and leaves its host blissful, numb and dying. Strains are named after musical markings, because they sing. Chief Oyelaran: \\\"They sing, Doctor. So we name them like songs.\\\"\\n\\n**Common look and sound.** Teal bioluminescence (`#5ff0e0`) with a dark core (`#0b2a30`), additive halo, lavender on bosses. Teal always means HUSH. They stay bright in Long Breath's cold palette. Every strain has its own figure in the choir voice (18), on the **effects** bus: music defaults to 10%, so no gameplay information may depend on music.\\n\\n### Staccato (Case 4 on)\\nSwarm of beads hopping in bursts on a fixed beat, from hidden **nests**. A closing dotted ring shows each landing spot .5 s ahead. A landing bite leaves a `laceration`. Cautery kills a bead in .12 s. Find nests with Sonar; slash, then Forceps. When the last nest goes, the remaining beads die within 3 s. Sound: \\\"tk-tk-tk\\\" on the beat, so the rhythm is playable by ear.\\n390→\\n### Legato (Case 5 on)\\nA long worm under the tissue, seen as a moving ridge (the painter's `stampLine` with positive height). Its head shows on Sonar.\\n1. Three slur marks lie on its route. Cut the short guide as the ridge nears one; it surfaces.\\n2. Forceps grips the head. Pull slowly: a tension gauge shows the safe rate. Too fast snaps it: the rest regrows a head and flees.\\n3. Every 4th segment has a barb. Release in the hold zone so Quill clamps, burn the barb, regrip. Pull, clamp, burn, regrip is the rhythm of the fight.\\n4. At half length it splits once no matter what, and a smaller worm flees. Repeat, faster.\\n\\n### Tremolo (Case 6, first boss)\\nA shivering web around a coronary vessel on the beating heart, five **reeds** around a mass.\\n400→- **Aura:** within 70 u the cursor (with a mouse, the aim point around the pointer) jitters by up to ±5 u x `amp`; x.35 in fine mode, none in Long Breath. Vitals shake ±3 and drain .6/s x `amp`.\\n- **Stage 1:** after each heartbeat's peak the reeds flare for .3 s. A targeted Syringe in that window sedates one (`amp` -.2). Outside the window it spits a small cut. The beat, the ECG and the flare sound are the telegraph, so this plays like a rhythm game.\\n- **Stage 2:** at `amp` .2 or less the shell cracks. Cautery burns the mass (3 s in all) while reeds wake every 6 s and need sedating again. Below half, it tears free and crawls along the vessel leaving cuts. Holding it with Forceps pins it for 2 s.\\n- **Stage 3:** a last slow Forceps pull of 40 u.\\n\\n### Da Capo (Case 8)\\nThree **lobes** on a glowing staff line with repeat signs. Each lobe's armor opens on its own timer: A every 6 s for 2.5 s, B every 7 s for 2.5 s, C every 9 s for 3 s. A: Cautery 1 s. B: slash, then Forceps. C: targeted Syringe, then Salve 1 s. The first kill starts a 10 s countdown. At 0 the dead lobes regrow, \\\"from the top\\\": vitals -8, a repeat sign flashes, and the staff plays its figure again. Round 2 runs at double speed and adds Staccato beads. Second Look's ghosts show when each lobe will open, so the winning move is to rewind once and plan the order. It can be beaten without rewinding, on skill.\\n\\n### Fermata (Case 10)\\nAn eye-like organism in the gyri of the brain, among gold eloquent lines.\\n410→- It raises **hold domes** of radius 34, up to three, for 5 s each. Inside a dome everything waits: tools do nothing, and bleeders inside are paused too, which a clever player can use.\\n- Its eye opens for .7 s the moment a dome collapses. Cautery .3 s three times. Long Breath stretches that window to 2.8 s, and Second Look undoes a slip across an eloquent line. Both matter, so this is where Consult is taught.\\n- Stage 2: the eye flees to another gyrus (find it with Sonar, where Vale's radius helps) and two Legato slivers appear.\\n- Stage 3: a gentle Forceps pull with a very low tension limit.\\n\\n### Cantor (Case 11, final)\\nA vast choir-organ of tissue wrapped around the heart, three mouths on the great vessels. Clock refills between movements.\\n\\n1. **Exposition.** It conducts: a baton tendril draws glowing arcs, and each beat a section sings: Staccato from one mouth, Legato slivers from another, bleeders along the vessels. Slash three baton tendrils at the pause of each arc. Then burn each mouth's uvula (Cautery 1.5 s).\\n2. **Development.** The hush falls. **All sound cuts except the choir, and the monitor goes to static:** no number, no trace, no beep, for stretches of 15 s. Only Quill's readouts remain (\\\"Forty, Doctor.\\\"), plus the tissue's pulse. Fermata domes and Tremolo jitter combine. Find the voice box with Sonar and sedate it on beat windows, three times. This is the game's most memorable moment. Make it feel terrible and wonderful.\\n420→3. **Recapitulation.** Every 20 s it forcibly rewinds the field 6 s: everything you did is undone, though your Steady stays. A 3 s wind-up shows a giant repeat sign. Slash it during the wind-up (Long Breath makes it easy), or answer with Second Look right after, undoing its rewind (\\\"I've seen this one.\\\"). Six slashes or counters end it.\\n4. **Coda: the Last Note.** One spiral guide, 200 u long, over the beating heart. Fine mode. The stroke can only advance between beats; moving on the beat is a slip. Then Forceps draws the Note out on a rising tone, up to a scream, then **total silence**. Hold it for three seconds. Then one beep. Then Quill: \\\"...Doctor.\\\" Six final stitches to a quiet piano figure, then the dressing.\\n\\n---\\n\\n## 9. The cases\\n\\nA first clear runs about an hour on Resident: eleven cases of 3 to 5 minutes each, plus story and ward. Numbers are Resident defaults, to be balanced with the bot and by hand. Each case's data: patient, doctor, site, clock, vitals, drain, par, phases, barks, story nodes. All text in sections 9 and 10 is direction: write the finished lines yourself in that voice.\\n\",\"content_concise\":\"159→## 5. The operation\\n160→\\nSim rules for this whole section: fixed steps, `dt` from the engine, all state in one plain object (19.2). Every number below is a default in the `TUNING` table in `src/config.js`, read live so dev mode's sliders reach it.\\n\\n### 5.1 The table\\n\\n- Positions are in **field units (u)**: design space 426 x 240, origin top left, 1 u = 1 buffer pixel. To the screen: add `OX = (r.W - 426) >> 1`, `OY = (r.H - 240) >> 1`.\\n- The **cavity** is an ellipse centered at (213, 116) with radii (171, 91). Everything interactive stays inside it. Bigger screens show more drape, never a bigger cavity. Its ellipse leaves the four corners free for the HUD.\\n- Draw back to front: drape fill, field (tissue, pools, wounds, gel, char, ridges, all through the painter's stamps), objects, engine particles, then `r.overlay` (stitches, strains' glow, guides, instruments, cursors, HUD).\\n\\n**HUD on the smallest screen, anchored to `r.W` and `r.H`:**\\n170→\\n| Piece | Place | Contents |\\n|---|---|---|\\n| Monitor | (6, 6), 148 x 30 | ECG trace, vitals number at font scale 2 |\\n| Clock | right edge, y 6, 70 x 22 | `01:42` at font scale 2 |\\n| Objective | top center, y 12 | At most 26 characters, a verb first: \\\"Drain the pool\\\" |\\n| Speaker | bottom left, a 56 x 64 crop of a cached bust (from its 28, 16) at (4, H-62), masked in theatre | Who is barking |\\n| Bark box | (62, H-34), 236 x 28 | Name, one line of at most 40 characters, gone after 2.5 s plus .05 s a character |\\n| Steady gauge | bottom right, 90 x 16 | Bar, its glyph, READY when usable |\\n| Flow | above the gauge | `FLOW x6` from a chain of 3 |\\n180→| Cursor prompt | beside the cursor, flipping near edges | `R2 Pull`, only over a valid target |\\n\\nKeep it this sparse. The patient is the screen.\\n\\n### 5.2 Vitals, clock, slips\\n\\n- **Vitals** run 0 to 99 (a float in the sim, shown whole). Each case has a start value and a base drain. Each open hazard adds its own drain (section 7).\\n- The player feels vitals through five channels so no one needs to look: the number, the ECG's rate, the monitor beep's rate and pitch, a double-thump rumble below 30, and Quill's calm readouts (\\\"Pulse forty. I mention it only in passing.\\\"). Below 30 the number flashes and CRITICAL appears, so it is never color alone.\\n- At 0: Code Blue if unused (5.8), else the patient is lost.\\n- **Clock:** counts down in world time. At 0 the patient is lost, with no Code Blue (\\\"Time of death, oh-four-twelve.\\\").\\n190→- **Slips** (mistakes): no cap on them. Each one costs vitals, breaks Flow, and shows in Results.\\n\\n### 5.3 The cursor\\n\\nThis is where the game lives or dies on a pad. Make it good before making anything else.\\n\\n- **Pad:** velocity = `stick^1.7 x 330 u/s` with a .06 s ramp. Fine mode (L2) multiplies by .35. Full deflection crosses the field in about a second, and small pushes are slow enough to place a stitch.\\n- **Magnet** (`assist` setting, default .6): within 22 u of a target valid for the held tool, speed drops by `.55 x assist` and, while the stick is near neutral, the cursor is pulled to the target at `90 x assist` u/s.\\n- **Guide-follow:** during a Scalpel stroke or a stitch, the part of the stick's push across the guide is scaled by `1 - .8 x assist`. At full assist a rough push along the line traces it, which is the accessibility floor.\\n- **Mouse:** the cursor is the pointer, 1:1, never moved by the game. Assist only widens the tolerances, by up to 1 u.\\n200→- **Keyboard:** WASD or arrows at 200 u/s, Shift for fine. D-pad nudges at 40 u/s.\\n- **Look:** an instrument whose tip is the exact aim point, gripped by a gloved hand down and to the right, so the hand never hides the target. In co-op the glove is the seat's color. Hide the OS pointer in `op`, and bring it back while paused.\\n- **Loupe:** holding Fine for .15 s shows a 2x lens of radius 34 around the cursor, pixel-doubled from the finished frame, with row-by-row `drawImage` and smoothing off. It is cosmetic.\\n\\n### 5.4 The tool wheel\\n\\nEight tools, eight stick directions, always the same place, so hands learn them like a real surgeon's \\\"Forceps!\\\".\\n\\n```\\n         N  Forceps\\n210→  NW Sonar        NE Scalpel\\nW Suction            E Suture\\n  SW Cautery      SE Salve\\n         S  Syringe\\n```\\n\\nTop takes, right closes, bottom medicates, left clears. Number keys 1 to 8 run clockwise from Forceps.\\n\\n- **Pad:** push the left stick past .6. The sector stable for 80 ms is picked. The ring shows around the cursor while the stick is out and .3 s after, with a clack, Quill's slap in the palm, and his gibberish bark of the tool's name. L1 and R1 step through the wheel too.\\n- **Mouse:** scroll steps. Hold Right click, flick, release to pick.\\n220→- **Keys:** 1 to 8, or Q and E.\\n- A swap takes .12 s. Time does not stop for the wheel.\\n- **Hints:** on Intern (and with Hints on, after 6 s of idling or a repeated slip), the next tool's tile glows and Quill names it.\\n- Tile art is 20 x 20, each tool a distinct silhouette, readable at 10 feet.\\n\\n### 5.5 The eight tools\\n\\nAnalog input only ever gives more control, never more power: a key or a click counts as a full press. \\\"Hold or toggle\\\" for sustained tools is a setting.\\n\\n| Tool | Gesture | Marker on the field |\\n230→|---|---|---|\\n| **Forceps** | Grip, pull along the axis, release | White corner brackets |\\n| **Scalpel** | Press on the start dot, trace the line | Purple dashed marker line, start dot |\\n| **Suture** | Press at one side, cross the wound, release at the other | Blue paired dots |\\n| **Salve** | Hold and paint over the patch | Green hatch |\\n| **Syringe** | Hold to draw, release to inject | A plus-sign ring on targets. Anywhere else goes to the IV |\\n| **Cautery** | Hold the beam on the target | Orange ring |\\n| **Suction** | Hold over the pool | None needed, the pool is the marker |\\n| **Sonar** | Hold to sweep a lens | Arcs when something hidden is near |\\n\\n240→**Forceps.** Grip within 12 u at trigger .3. An *embedded* object has an out-axis and a depth: progress is cursor travel along the axis. Pulling faster than 120 u/s, or more than 8 u off axis, **tears** (laceration, vitals -4, progress -30%). Past its depth it comes free and follows the cursor. Release 24 u or more from its origin, or past the cavity's edge, and Quill's dish catches it with a clink. Grade: no tears and under its par time is Textbook, one tear is Clean, else Sloppy. A held piece can be handed off in some cases: release inside a **hold zone** and Quill clamps it (Case 5).\\n\\n**Scalpel.** The guide is a polyline. Press within 8 u of the start. Progress is the furthest arc length reached. Distance from the line over 9 u for .12 s is a **slip** (short laceration, vitals -3), and the stroke goes on when you come back. Release early and resume within 6 u. Grade by mean distance: 1.8 u or less is Textbook, 4 u or less is Clean, else Sloppy. Variants: a *ring* (closed loop around a mass), and a *slash* (any stroke crossing a target at 60 u/s or more). Dragging the blade 6 u over healthy tissue with no guide is a slip. Crossing a nerve or eloquent line costs vitals -12 and always counts as a slip.\\n\\n**Suture.** A wound has N stitches, each a pair of points across it. Press within 9 u of the next near point, carry across, release within 6 u of the far point. A bad release is a loose stitch (vitals -1, redo it). Each stitch set closes 1/N of the wound and cuts its bleeding. Per stitch: .6 s or less is Textbook, 1.2 s or less is Clean. The wound's grade is the mean. The needle arcs across, the thread pulls tight with a pop, and the wound's lips close on the field.\\n\\n**Salve.** Paints a coverage grid of 4 u cells with a 10 u brush. A patch needs 90% coverage, then heals with a sparkle and gives +2 vitals. It also coats some strain parts. It cannot harm, only waste time.\\n\\n**Syringe.** Hold to fill, 0 to full in .55 s. Release to inject. Over a target within 10 u, that is a targeted dose: at .9 full or more it counts Textbook; held .3 s past full gets an air bubble (Sloppy, half effect). Anywhere else it goes to the IV: vitals +18 x fill (Intern +24, Attending +12). .35 s cooldown. This is the panic button, so it must always feel available.\\n\\n250→**Cautery.** Hold for a beam on a 6 u spot. Polyp .5 s, pinhole bleeder .35 s, Staccato bead .12 s. Heat fills at .5/s and cools at .6/s; at 1 it locks for 1.2 s. On bare tissue for .25 s it leaves char, -.8 vitals/s, and a slip at .6 s. Grade: no char and no lockout during the kill is Textbook.\\n\\n**Suction.** Hold within 14 u of a pool: removes 60 volume/s, with a gurgle that rises as it empties. Objects under a pool can't be seen or targeted until it's cleared. It has no grade, but it never breaks Flow, so it is always a safe move.\\n\\n**Sonar.** Hold for a lens of radius 38 in the cold palette (the painter's `lens`). Hidden objects show inside it and stay marked for 4 s after it leaves. A ping rises in rate with proximity. HUSH's song grows and pans toward the nearest strain, so the player can hunt by ear. Hidden objects cannot be touched until marked.\\n\\n### 5.6 Grades, Flow, ranks\\n\\n- Every finished action gets a popup at its location, with sound: **Sloppy** (x.4), **Clean** (x1), **Textbook** (x1.5). Text, size and sound differ, so it is never color alone.\\n- **Flow:** consecutive non-Sloppy actions, +5% each up to x2. A slip resets it.\\n260→- **End bonus:** clock left x 2, vitals x 3.\\n- **Rank:** score against the case's `par` (a perfect bot's score at Resident, section 20): S 95%, A 80%, B 60%, C 40%, else D. On Attending, S with no slips earns a star, **★ Textbook**. Each difficulty keeps its own best rank.\\n- **Results shows only four tiles**, one at a time, each with a tick: Time left, Pulse held, Technique (share of Clean or better), Best Flow. Then the rank stamp and Quill's line for that rank. No tables.\\n\\n### 5.7 The Steady (the gift)\\n\\nAn old word in theatre for surgeons who can do what shouldn't be possible. The gauge runs 0 to 100, shared in the finale: +5 per Clean, +10 per Textbook, +.5/s. One button (△, F or Middle click). Activation never fails.\\n\\n**Long Breath (Dr. Vale).** Needs 35. The world runs at .25 speed while the hands stay at full speed. Drains 16/s; press again to stop. Implement it with a world-time factor in the sim, **not** `game.timeScale`. The field shifts to the cold palette (the painter's `slow`), so glowing strains and dark blood stand out. Music thins, sound low-passes, the heartbeat dominates. Strains and hazards all pulse with outlines. This image is the game's signature: *Verified*, it reads beautifully in the prototype.\\n\\n270→**Second Look (Dr. Sokolova).** Needs 45. Rewinds the sim up to 6 s. A ring buffer holds a snapshot of the state every .1 s. Restoring is exact: vitals, clock, objects, RNG. Then, for the next 6 s, **ghosts** replay: pale afterimages of her own cursor and of every strain, taken from the buffer, where they were last time. Rewinding is literally a second look at what is about to happen. Presentation: 1.2 s of fast reverse with VCR tracking lines, a falling tape sweep, Quill's bark reversed. Her line: \\\"No. Again.\\\" The rewound seconds' grades and score vanish. There is no rank penalty. Her hands are outside time: the cursor stays where the player has it, and anything held or mid-stroke is let go, so a rewind can never force a slip. Not available in Grand Rounds.\\n\\n**Consult (Cases 10 and 11).** □ or C hands over to the other doctor in .4 s. Gauge shared, each doctor's gift and passive apply: Vale has +15% cursor speed and +25% Sonar radius; Sokolova has +.2 assist and +1 u suture tolerance.\\n\\n### 5.8 Code Blue\\n\\nThe first time vitals reach 0 in a case (not on Attending): the world freezes and the paddles come out. The ECG scrolls full-width with 4 charge pips, a marker crossing the peak every .9 s. Press L2 and R2 together (Left click or Space on keyboard and mouse) inside ±.14 s of the peak; ±.06 s is Textbook. Two hits in four attempts: vitals to 30, and play resumes with a jolt, a huge rumble and a white flash. Fewer: patient lost. \\\"Clear!\\\" in gibberish. It doesn't cap the rank: the lost time and low vitals already cost enough.\\n\\n### 5.9 Closing\\n\\n280→When the last phase clears, the op doesn't just end. Quill: \\\"Dressing.\\\" A timing ring closes on the wound; press on the ring for a stamp, with a bonus for the timing. \\\"CASE CLOSED\\\" stamps across the screen, with `TIME OF COMPLETION 02:14`. Sound drops to one held chord. This is the reward beat. Land it.\\n\\n### 5.10 Failing and retrying\\n\\n- Phase boundaries are checkpoints. **Retry from this phase** restores the phase's starting state with rank capped at B. **Restart case** is uncapped.\\n- After 2 failures in one phase, Quill offers Intern for this case only.\\n- Tutorial moments (Cases 1 to 4) freeze the clock and vitals until the first success of a new verb, with a big prompt beside the target.\\n\\n**Difficulty.** Intern: drains x.7, clock x1.3, hints on, assist +.2. Resident: baseline. Attending: drains x1.3, clock x.8, no Code Blue, hints only after 10 s, ★ available. Changeable between cases.\\n\\n290→**Balance targets at Resident.** A first-time player clears Cases 1 and 2 first try, fails Case 3 once or twice, needs 2 to 4 tries on Tremolo and 3 to 6 on the Cantor. By bot (19.4): a human-like bot (reaction .25 s, aim error 3 u, speed 260 u/s) clears every case on Intern and at least 70% of them on Resident; the perfect bot finishes every case with at least 30% of the clock and 40 vitals left. If a case misses, tune its numbers, not the core.\\n\\n### 5.11 Feel table\\n\\nEvery tool gets all three channels. `input.rumble(strength, seconds)`, scaled by the engine's Vibration setting.\\n\\n| Moment | Sound | Particles or picture | Rumble |\\n|---|---|---|---|\\n| Tool swap | Clack, palm slap | Ring flash, instrument changes | .15 / .03 |\\n| Forceps grip, free | Tick, then clink in dish | Glint, droplets | .15 / .04, .3 / .05 |\\n300→| Tear | Wet rip | Spurt, hit-stop .04 s, screen shake 2 | .5 / .1 |\\n| Scalpel stroke | Rising hiss | Thin blood line opening behind the tip | .1 steady |\\n| Stitch pop | Thread twang | Lips close, thread pulls tight | .25 / .05 |\\n| Cautery | Sizzle | Spark, smoke, hot spot | .2 steady |\\n| Suction | Gurgle rising in pitch | Pool shrinks toward the tip | .1 steady |\\n| Syringe | Plunger hiss | Bubbles in the barrel, pulse flash on the monitor | .1 / .1 |\\n| Textbook | Bright two-note chime | Big popup, gold sparkle | .2 / .05 |\\n| Slip | Low thud, Quill sighs | Red flash on the field, monitor jumps | .6 / .12 |\\n| Vitals critical | Monitor alarm | Vignette, number flashes | double thump per beat |\\n| Code Blue shock | Whine, bang | White flash, field jumps | 1 / .35 |\\n310→| Boss phase | Choir swell | Shake, field darkens | .7 / .4 |\\n\\nComfort: `game.shake` and `game.flash` already follow the comfort settings. Settings adds **Blood color** (Surgical red, or Clinical teal-grey, a swap of the blood and wound ramps).\\n\\n---\\n\\n## 6. Controls and prompts\\n\\nThe keyboard and mouse are native here, not stand-ins for controller buttons: the same game on the same screens, with the keys PC players expect for this kind of game. The mouse is the best pointer in the game, and the pad is the best-feeling couch device.\\n\\n320→| Action | DualSense (standard mapping) | Keyboard and mouse |\\n|---|---|---|\\n| Aim | Right stick. D-pad nudges | Mouse, or WASD or arrows |\\n| Use tool | R2 (analog) or ✕ | Left click or Space |\\n| Fine mode, loupe | L2 | Shift |\\n| Pick tool | Left stick flick | 1 to 8. Hold Right click and flick |\\n| Step tool | L1, R1 | Q, E, or the wheel |\\n| The Steady | △ | F or Middle click |\\n| Consult | □ | C |\\n| Drop, cancel stroke | ○ | X or Backspace |\\n330→| Code Blue shock | L2 + R2 | Left click or Space |\\n| Pause | Options | Esc or P |\\n| Ward: walk | Left stick or D-pad | WASD or arrows, or click to walk |\\n| Ward: talk, use | ✕ | E or Enter, or click the person |\\n| Story: advance | ✕ | Enter, Space or click |\\n| Story: fast-forward | Hold □ | Hold Ctrl |\\n| Story: backlog | △ | B |\\n\\nSettings adds **Swap sticks** for left-handers (cursor and wheel trade sticks).\\n\\n340→```js\\nconst { attack, dash, skill, jump, ...base } = E.Input.DEFAULT;\\nconst INPUT = { ...base,\\n  useTool: ['Pad7', 'Pad0', 'Mouse0', 'Space'], fine: ['Pad6', 'ShiftLeft', 'ShiftRight'], gift: ['Pad3', 'KeyF', 'Mouse1'], consult: ['Pad2', 'KeyC'],\\n  toolPrev: ['Pad4', 'KeyQ', 'WheelUp'], toolNext: ['Pad5', 'KeyE', 'WheelDown'], wheelHold: ['Mouse2'],\\n  curU: ['KeyW', 'ArrowUp'], curD: ['KeyS', 'ArrowDown'], curL: ['KeyA', 'ArrowLeft'], curR: ['KeyD', 'ArrowRight'],   // separate from up/down/left/right, which the left stick also presses\\n  nudgeU: ['Pad12'], nudgeD: ['Pad13'], nudgeL: ['Pad14'], nudgeR: ['Pad15'],\\n  tool1: ['Digit1'], tool2: ['Digit2'], tool3: ['Digit3'], tool4: ['Digit4'], tool5: ['Digit5'], tool6: ['Digit6'], tool7: ['Digit7'], tool8: ['Digit8'],\\n  interact: ['Pad0', 'KeyE', 'Enter'], skip: ['Pad2', 'ControlLeft'], log: ['Pad3', 'KeyB'], more: ['Pad3', 'KeyM'] };\\n```\\n350→\\nRead the two sticks from `input.padAim` and `input.padMove`, the trigger from `input.value('useTool')`. Name the actions and hide `tool1` to `tool8` from rebinding through `menu.controls`. Give the scene `camera: { zoom: false, wheel: false }`, because the wheel is the game's.\\n\\n**Prompts.** Always through `game.input.label(action)`, so they follow the device used last and the player's rebinding. Draw a label as a button cap: a rounded rectangle with the label in it, the PlayStation or Xbox face colors on face buttons, and plain keycaps for keys. For the sticks, draw a small stick icon with L or R. Never hard-code a key in text. PlayStation glyphs by default with the Xbox option from fact 5.\\n\\n---\\n\\n## 7. Things on the table\\n\\nA registry (`defObject`), each with sim behavior, a draw function kept apart, and a bot plan.\\n360→\\n| Type | Looks like | Fixed by | Vitals/s while open | Other effects |\\n|---|---|---|---|---|\\n| `shard` | Glass or steel sliver with a glint | Forceps along its axis | .1 | |\\n| `laceration` | Short red cut | Salve | .2 | Small pool over time |\\n| `wound` | Gaping cut with lips | Suture N stitches | .4 | Bleeding falls with each stitch |\\n| `bleeder` | Pinhole spurting on the beat | Cautery | .5 | Feeds a pool, 6 volume/s |\\n| `arteryTear` | Pulsing spurts | Suture 3 | 1 | Feeds a pool, 14 volume/s |\\n| `pool` | Dark wet metaball, specular | Suction | none | Hides what's under it, drifts on a tilt |\\n| `polyp` | Pink nub | Cautery | .1 | |\\n370→| `mass` | Large lump | Scalpel ring, Forceps lift, leaves a `wound` | .2 | |\\n| `hook` | Barbed steel | Scalpel relief cuts at each barb, then Forceps | .3 | Tears if pulled with barbs set |\\n| `clot` | Dark lump in a vessel | Targeted Syringe, then Forceps | .3 | |\\n| `patch` | Inflamed red hatch | Salve | .1 | |\\n| `nerve`, `eloquent` | Gold line (no-touch) | Avoid | | Touching with Scalpel or Cautery: -12 and a slip |\\n| `retractorHandle` | Steel handle (Grand Rounds) | Forceps hold | | Opens a window on a target while held |\\n| device parts | Screws, wires, leads (Case 9) | Per Case 9 | | |\\n\\nObjects can be **hidden** (need Sonar), **under a pool**, or **tied** to a phase script. Phase scripts are data: `at: [{ t: 25, do: 'lurch' }]`, `when: 'clear'`.\\n\\n380→---\\n\\n## 8. HUSH: the strains\\n\\n**HUSH** stands for *Hyperplastic Undifferentiated Synaptic Hive*: an engineered parasite colony that feeds on pain signals and leaves its host blissful, numb and dying. Strains are named after musical markings, because they sing. Chief Oyelaran: \\\"They sing, Doctor. So we name them like songs.\\\"\\n\\n**Common look and sound.** Teal bioluminescence (`#5ff0e0`) with a dark core (`#0b2a30`), additive halo, lavender on bosses. Teal always means HUSH. They stay bright in Long Breath's cold palette. Every strain has its own figure in the choir voice (18), on the **effects** bus: music defaults to 10%, so no gameplay information may depend on music.\\n\\n### Staccato (Case 4 on)\\nSwarm of beads hopping in bursts on a fixed beat, from hidden **nests**. A closing dotted ring shows each landing spot .5 s ahead. A landing bite leaves a `laceration`. Cautery kills a bead in .12 s. Find nests with Sonar; slash, then Forceps. When the last nest goes, the remaining beads die within 3 s. Sound: \\\"tk-tk-tk\\\" on the beat, so the rhythm is playable by ear.\\n390→\\n### Legato (Case 5 on)\\nA long worm under the tissue, seen as a moving ridge (the painter's `stampLine` with positive height). Its head shows on Sonar.\\n1. Three slur marks lie on its route. Cut the short guide as the ridge nears one; it surfaces.\\n2. Forceps grips the head. Pull slowly: a tension gauge shows the safe rate. Too fast snaps it: the rest regrows a head and flees.\\n3. Every 4th segment has a barb. Release in the hold zone so Quill clamps, burn the barb, regrip. Pull, clamp, burn, regrip is the rhythm of the fight.\\n4. At half length it splits once no matter what, and a smaller worm flees. Repeat, faster.\\n\\n### Tremolo (Case 6, first boss)\\nA shivering web around a coronary vessel on the beating heart, five **reeds** around a mass.\\n400→- **Aura:** within 70 u the cursor (with a mouse, the aim point around the pointer) jitters by up to ±5 u x `amp`; x.35 in fine mode, none in Long Breath. Vitals shake ±3 and drain .6/s x `amp`.\\n- **Stage 1:** after each heartbeat's peak the reeds flare for .3 s. A targeted Syringe in that window sedates one (`amp` -.2). Outside the window it spits a small cut. The beat, the ECG and the flare sound are the telegraph, so this plays like a rhythm game.\\n- **Stage 2:** at `amp` .2 or less the shell cracks. Cautery burns the mass (3 s in all) while reeds wake every 6 s and need sedating again. Below half, it tears free and crawls along the vessel leaving cuts. Holding it with Forceps pins it for 2 s.\\n- **Stage 3:** a last slow Forceps pull of 40 u.\\n\\n### Da Capo (Case 8)\\nThree **lobes** on a glowing staff line with repeat signs. Each lobe's armor opens on its own timer: A every 6 s for 2.5 s, B every 7 s for 2.5 s, C every 9 s for 3 s. A: Cautery 1 s. B: slash, then Forceps. C: targeted Syringe, then Salve 1 s. The first kill starts a 10 s countdown. At 0 the dead lobes regrow, \\\"from the top\\\": vitals -8, a repeat sign flashes, and the staff plays its figure again. Round 2 runs at double speed and adds Staccato beads. Second Look's ghosts show when each lobe will open, so the winning move is to rewind once and plan the order. It can be beaten without rewinding, on skill.\\n\\n### Fermata (Case 10)\\nAn eye-like organism in the gyri of the brain, among gold eloquent lines.\\n410→- It raises **hold domes** of radius 34, up to three, for 5 s each. Inside a dome everything waits: tools do nothing, and bleeders inside are paused too, which a clever player can use.\\n- Its eye opens for .7 s the moment a dome collapses. Cautery .3 s three times. Long Breath stretches that window to 2.8 s, and Second Look undoes a slip across an eloquent line. Both matter, so this is where Consult is taught.\\n- Stage 2: the eye flees to another gyrus (find it with Sonar, where Vale's radius helps) and two Legato slivers appear.\\n- Stage 3: a gentle Forceps pull with a very low tension limit.\\n\\n### Cantor (Case 11, final)\\nA vast choir-organ of tissue wrapped around the heart, three mouths on the great vessels. Clock refills between movements.\\n\\n1. **Exposition.** It conducts: a baton tendril draws glowing arcs, and each beat a section sings: Staccato from one mouth, Legato slivers from another, bleeders along the vessels. Slash three baton tendrils at the pause of each arc. Then burn each mouth's uvula (Cautery 1.5 s).\\n2. **Development.** The hush falls. **All sound cuts except the choir, and the monitor goes to static:** no number, no trace, no beep, for stretches of 15 s. Only Quill's readouts remain (\\\"Forty, Doctor.\\\"), plus the tissue's pulse. Fermata domes and Tremolo jitter combine. Find the voice box with Sonar and sedate it on beat windows, three times. This is the game's most memorable moment. Make it feel terrible and wonderful.\\n420→3. **Recapitulation.** Every 20 s it forcibly rewinds the field 6 s: everything you did is undone, though your Steady stays. A 3 s wind-up shows a giant repeat sign. Slash it during the wind-up (Long Breath makes it easy), or answer with Second Look right after, undoing its rewind (\\\"I've seen this one.\\\"). Six slashes or counters end it.\\n4. **Coda: the Last Note.** One spiral guide, 200 u long, over the beating heart. Fine mode. The stroke can only advance between beats; moving on the beat is a slip. Then Forceps draws the Note out on a rising tone, up to a scream, then **total silence**. Hold it for three seconds. Then one beep. Then Quill: \\\"...Doctor.\\\" Six final stitches to a quiet piano figure, then the dressing.\\n\\n---\\n\\n## 9. The cases\\n\\nA first clear runs about an hour on Resident: eleven cases of 3 to 5 minutes each, plus story and ward. Numbers are Resident defaults, to be balanced with the bot and by hand. Each case's data: patient, doctor, site, clock, vitals, drain, par, phases, barks, story nodes. All text in sections 9 and 10 is direction: write the finished lines yourself in that voice.\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/PLAN.md\",\"offset\":159,\"limit\":270,\"raw_output\":\"## 5. The operation\\n\\nSim rules for this whole section: fixed steps, `dt` from the engine, all state in one plain object (19.2). Every number below is a default in the `TUNING` table in `src/config.js`, read live so dev mode's sliders reach it.\\n\\n### 5.1 The table\\n\\n- Positions are in **field units (u)**: design space 426 x 240, origin top left, 1 u = 1 buffer pixel. To the screen: add `OX = (r.W - 426) >> 1`, `OY = (r.H - 240) >> 1`.\\n- The **cavity** is an ellipse centered at (213, 116) with radii (171, 91). Everything interactive stays inside it. Bigger screens show more drape, never a bigger cavity. Its ellipse leaves the four corners free for the HUD.\\n- Draw back to front: drape fill, field (tissue, pools, wounds, gel, char, ridges, all through the painter's stamps), objects, engine particles, then `r.overlay` (stitches, strains' glow, guides, instruments, cursors, HUD).\\n\\n**HUD on the smallest screen, anchored to `r.W` and `r.H`:**\\n\\n| Piece | Place | Contents |\\n|---|---|---|\\n| Monitor | (6, 6), 148 x 30 | ECG trace, vitals number at font scale 2 |\\n| Clock | right edge, y 6, 70 x 22 | `01:42` at font scale 2 |\\n| Objective | top center, y 12 | At most 26 characters, a verb first: \\\"Drain the pool\\\" |\\n| Speaker | bottom left, a 56 x 64 crop of a cached bust (from its 28, 16) at (4, H-62), masked in theatre | Who is barking |\\n| Bark box | (62, H-34), 236 x 28 | Name, one line of at most 40 characters, gone after 2.5 s plus .05 s a character |\\n| Steady gauge | bottom right, 90 x 16 | Bar, its glyph, READY when usable |\\n| Flow | above the gauge | `FLOW x6` from a chain of 3 |\\n| Cursor prompt | beside the cursor, flipping near edges | `R2 Pull`, only over a valid target |\\n\\nKeep it this sparse. The patient is the screen.\\n\\n### 5.2 Vitals, clock, slips\\n\\n- **Vitals** run 0 to 99 (a float in the sim, shown whole). Each case has a start value and a base drain. Each open hazard adds its own drain (section 7).\\n- The player feels vitals through five channels so no one needs to look: the number, the ECG's rate, the monitor beep's rate and pitch, a double-thump rumble below 30, and Quill's calm readouts (\\\"Pulse forty. I mention it only in passing.\\\"). Below 30 the number flashes and CRITICAL appears, so it is never color alone.\\n- At 0: Code Blue if unused (5.8), else the patient is lost.\\n- **Clock:** counts down in world time. At 0 the patient is lost, with no Code Blue (\\\"Time of death, oh-four-twelve.\\\").\\n- **Slips** (mistakes): no cap on them. Each one costs vitals, breaks Flow, and shows in Results.\\n\\n### 5.3 The cursor\\n\\nThis is where the game lives or dies on a pad. Make it good before making anything else.\\n\\n- **Pad:** velocity = `stick^1.7 x 330 u/s` with a .06 s ramp. Fine mode (L2) multiplies by .35. Full deflection crosses the field in about a second, and small pushes are slow enough to place a stitch.\\n- **Magnet** (`assist` setting, default .6): within 22 u of a target valid for the held tool, speed drops by `.55 x assist` and, while the stick is near neutral, the cursor is pulled to the target at `90 x assist` u/s.\\n- **Guide-follow:** during a Scalpel stroke or a stitch, the part of the stick's push across the guide is scaled by `1 - .8 x assist`. At full assist a rough push along the line traces it, which is the accessibility floor.\\n- **Mouse:** the cursor is the pointer, 1:1, never moved by the game. Assist only widens the tolerances, by up to 1 u.\\n- **Keyboard:** WASD or arrows at 200 u/s, Shift for fine. D-pad nudges at 40 u/s.\\n- **Look:** an instrument whose tip is the exact aim point, gripped by a gloved hand down and to the right, so the hand never hides the target. In co-op the glove is the seat's color. Hide the OS pointer in `op`, and bring it back while paused.\\n- **Loupe:** holding Fine for .15 s shows a 2x lens of radius 34 around the cursor, pixel-doubled from the finished frame, with row-by-row `drawImage` and smoothing off. It is cosmetic.\\n\\n### 5.4 The tool wheel\\n\\nEight tools, eight stick directions, always the same place, so hands learn them like a real surgeon's \\\"Forceps!\\\".\\n\\n```\\n         N  Forceps\\n  NW Sonar        NE Scalpel\\nW Suction            E Suture\\n  SW Cautery      SE Salve\\n         S  Syringe\\n```\\n\\nTop takes, right closes, bottom medicates, left clears. Number keys 1 to 8 run clockwise from Forceps.\\n\\n- **Pad:** push the left stick past .6. The sector stable for 80 ms is picked. The ring shows around the cursor while the stick is out and .3 s after, with a clack, Quill's slap in the palm, and his gibberish bark of the tool's name. L1 and R1 step through the wheel too.\\n- **Mouse:** scroll steps. Hold Right click, flick, release to pick.\\n- **Keys:** 1 to 8, or Q and E.\\n- A swap takes .12 s. Time does not stop for the wheel.\\n- **Hints:** on Intern (and with Hints on, after 6 s of idling or a repeated slip), the next tool's tile glows and Quill names it.\\n- Tile art is 20 x 20, each tool a distinct silhouette, readable at 10 feet.\\n\\n### 5.5 The eight tools\\n\\nAnalog input only ever gives more control, never more power: a key or a click counts as a full press. \\\"Hold or toggle\\\" for sustained tools is a setting.\\n\\n| Tool | Gesture | Marker on the field |\\n|---|---|---|\\n| **Forceps** | Grip, pull along the axis, release | White corner brackets |\\n| **Scalpel** | Press on the start dot, trace the line | Purple dashed marker line, start dot |\\n| **Suture** | Press at one side, cross the wound, release at the other | Blue paired dots |\\n| **Salve** | Hold and paint over the patch | Green hatch |\\n| **Syringe** | Hold to draw, release to inject | A plus-sign ring on targets. Anywhere else goes to the IV |\\n| **Cautery** | Hold the beam on the target | Orange ring |\\n| **Suction** | Hold over the pool | None needed, the pool is the marker |\\n| **Sonar** | Hold to sweep a lens | Arcs when something hidden is near |\\n\\n**Forceps.** Grip within 12 u at trigger .3. An *embedded* object has an out-axis and a depth: progress is cursor travel along the axis. Pulling faster than 120 u/s, or more than 8 u off axis, **tears** (laceration, vitals -4, progress -30%). Past its depth it comes free and follows the cursor. Release 24 u or more from its origin, or past the cavity's edge, and Quill's dish catches it with a clink. Grade: no tears and under its par time is Textbook, one tear is Clean, else Sloppy. A held piece can be handed off in some cases: release inside a **hold zone** and Quill clamps it (Case 5).\\n\\n**Scalpel.** The guide is a polyline. Press within 8 u of the start. Progress is the furthest arc length reached. Distance from the line over 9 u for .12 s is a **slip** (short laceration, vitals -3), and the stroke goes on when you come back. Release early and resume within 6 u. Grade by mean distance: 1.8 u or less is Textbook, 4 u or less is Clean, else Sloppy. Variants: a *ring* (closed loop around a mass), and a *slash* (any stroke crossing a target at 60 u/s or more). Dragging the blade 6 u over healthy tissue with no guide is a slip. Crossing a nerve or eloquent line costs vitals -12 and always counts as a slip.\\n\\n**Suture.** A wound has N stitches, each a pair of points across it. Press within 9 u of the next near point, carry across, release within 6 u of the far point. A bad release is a loose stitch (vitals -1, redo it). Each stitch set closes 1/N of the wound and cuts its bleeding. Per stitch: .6 s or less is Textbook, 1.2 s or less is Clean. The wound's grade is the mean. The needle arcs across, the thread pulls tight with a pop, and the wound's lips close on the field.\\n\\n**Salve.** Paints a coverage grid of 4 u cells with a 10 u brush. A patch needs 90% coverage, then heals with a sparkle and gives +2 vitals. It also coats some strain parts. It cannot harm, only waste time.\\n\\n**Syringe.** Hold to fill, 0 to full in .55 s. Release to inject. Over a target within 10 u, that is a targeted dose: at .9 full or more it counts Textbook; held .3 s past full gets an air bubble (Sloppy, half effect). Anywhere else it goes to the IV: vitals +18 x fill (Intern +24, Attending +12). .35 s cooldown. This is the panic button, so it must always feel available.\\n\\n**Cautery.** Hold for a beam on a 6 u spot. Polyp .5 s, pinhole bleeder .35 s, Staccato bead .12 s. Heat fills at .5/s and cools at .6/s; at 1 it locks for 1.2 s. On bare tissue for .25 s it leaves char, -.8 vitals/s, and a slip at .6 s. Grade: no char and no lockout during the kill is Textbook.\\n\\n**Suction.** Hold within 14 u of a pool: removes 60 volume/s, with a gurgle that rises as it empties. Objects under a pool can't be seen or targeted until it's cleared. It has no grade, but it never breaks Flow, so it is always a safe move.\\n\\n**Sonar.** Hold for a lens of radius 38 in the cold palette (the painter's `lens`). Hidden objects show inside it and stay marked for 4 s after it leaves. A ping rises in rate with proximity. HUSH's song grows and pans toward the nearest strain, so the player can hunt by ear. Hidden objects cannot be touched until marked.\\n\\n### 5.6 Grades, Flow, ranks\\n\\n- Every finished action gets a popup at its location, with sound: **Sloppy** (x.4), **Clean** (x1), **Textbook** (x1.5). Text, size and sound differ, so it is never color alone.\\n- **Flow:** consecutive non-Sloppy actions, +5% each up to x2. A slip resets it.\\n- **End bonus:** clock left x 2, vitals x 3.\\n- **Rank:** score against the case's `par` (a perfect bot's score at Resident, section 20): S 95%, A 80%, B 60%, C 40%, else D. On Attending, S with no slips earns a star, **★ Textbook**. Each difficulty keeps its own best rank.\\n- **Results shows only four tiles**, one at a time, each with a tick: Time left, Pulse held, Technique (share of Clean or better), Best Flow. Then the rank stamp and Quill's line for that rank. No tables.\\n\\n### 5.7 The Steady (the gift)\\n\\nAn old word in theatre for surgeons who can do what shouldn't be possible. The gauge runs 0 to 100, shared in the finale: +5 per Clean, +10 per Textbook, +.5/s. One button (△, F or Middle click). Activation never fails.\\n\\n**Long Breath (Dr. Vale).** Needs 35. The world runs at .25 speed while the hands stay at full speed. Drains 16/s; press again to stop. Implement it with a world-time factor in the sim, **not** `game.timeScale`. The field shifts to the cold palette (the painter's `slow`), so glowing strains and dark blood stand out. Music thins, sound low-passes, the heartbeat dominates. Strains and hazards all pulse with outlines. This image is the game's signature: *Verified*, it reads beautifully in the prototype.\\n\\n**Second Look (Dr. Sokolova).** Needs 45. Rewinds the sim up to 6 s. A ring buffer holds a snapshot of the state every .1 s. Restoring is exact: vitals, clock, objects, RNG. Then, for the next 6 s, **ghosts** replay: pale afterimages of her own cursor and of every strain, taken from the buffer, where they were last time. Rewinding is literally a second look at what is about to happen. Presentation: 1.2 s of fast reverse with VCR tracking lines, a falling tape sweep, Quill's bark reversed. Her line: \\\"No. Again.\\\" The rewound seconds' grades and score vanish. There is no rank penalty. Her hands are outside time: the cursor stays where the player has it, and anything held or mid-stroke is let go, so a rewind can never force a slip. Not available in Grand Rounds.\\n\\n**Consult (Cases 10 and 11).** □ or C hands over to the other doctor in .4 s. Gauge shared, each doctor's gift and passive apply: Vale has +15% cursor speed and +25% Sonar radius; Sokolova has +.2 assist and +1 u suture tolerance.\\n\\n### 5.8 Code Blue\\n\\nThe first time vitals reach 0 in a case (not on Attending): the world freezes and the paddles come out. The ECG scrolls full-width with 4 charge pips, a marker crossing the peak every .9 s. Press L2 and R2 together (Left click or Space on keyboard and mouse) inside ±.14 s of the peak; ±.06 s is Textbook. Two hits in four attempts: vitals to 30, and play resumes with a jolt, a huge rumble and a white flash. Fewer: patient lost. \\\"Clear!\\\" in gibberish. It doesn't cap the rank: the lost time and low vitals already cost enough.\\n\\n### 5.9 Closing\\n\\nWhen the last phase clears, the op doesn't just end. Quill: \\\"Dressing.\\\" A timing ring closes on the wound; press on the ring for a stamp, with a bonus for the timing. \\\"CASE CLOSED\\\" stamps across the screen, with `TIME OF COMPLETION 02:14`. Sound drops to one held chord. This is the reward beat. Land it.\\n\\n### 5.10 Failing and retrying\\n\\n- Phase boundaries are checkpoints. **Retry from this phase** restores the phase's starting state with rank capped at B. **Restart case** is uncapped.\\n- After 2 failures in one phase, Quill offers Intern for this case only.\\n- Tutorial moments (Cases 1 to 4) freeze the clock and vitals until the first success of a new verb, with a big prompt beside the target.\\n\\n**Difficulty.** Intern: drains x.7, clock x1.3, hints on, assist +.2. Resident: baseline. Attending: drains x1.3, clock x.8, no Code Blue, hints only after 10 s, ★ available. Changeable between cases.\\n\\n**Balance targets at Resident.** A first-time player clears Cases 1 and 2 first try, fails Case 3 once or twice, needs 2 to 4 tries on Tremolo and 3 to 6 on the Cantor. By bot (19.4): a human-like bot (reaction .25 s, aim error 3 u, speed 260 u/s) clears every case on Intern and at least 70% of them on Resident; the perfect bot finishes every case with at least 30% of the clock and 40 vitals left. If a case misses, tune its numbers, not the core.\\n\\n### 5.11 Feel table\\n\\nEvery tool gets all three channels. `input.rumble(strength, seconds)`, scaled by the engine's Vibration setting.\\n\\n| Moment | Sound | Particles or picture | Rumble |\\n|---|---|---|---|\\n| Tool swap | Clack, palm slap | Ring flash, instrument changes | .15 / .03 |\\n| Forceps grip, free | Tick, then clink in dish | Glint, droplets | .15 / .04, .3 / .05 |\\n| Tear | Wet rip | Spurt, hit-stop .04 s, screen shake 2 | .5 / .1 |\\n| Scalpel stroke | Rising hiss | Thin blood line opening behind the tip | .1 steady |\\n| Stitch pop | Thread twang | Lips close, thread pulls tight | .25 / .05 |\\n| Cautery | Sizzle | Spark, smoke, hot spot | .2 steady |\\n| Suction | Gurgle rising in pitch | Pool shrinks toward the tip | .1 steady |\\n| Syringe | Plunger hiss | Bubbles in the barrel, pulse flash on the monitor | .1 / .1 |\\n| Textbook | Bright two-note chime | Big popup, gold sparkle | .2 / .05 |\\n| Slip | Low thud, Quill sighs | Red flash on the field, monitor jumps | .6 / .12 |\\n| Vitals critical | Monitor alarm | Vignette, number flashes | double thump per beat |\\n| Code Blue shock | Whine, bang | White flash, field jumps | 1 / .35 |\\n| Boss phase | Choir swell | Shake, field darkens | .7 / .4 |\\n\\nComfort: `game.shake` and `game.flash` already follow the comfort settings. Settings adds **Blood color** (Surgical red, or Clinical teal-grey, a swap of the blood and wound ramps).\\n\\n---\\n\\n## 6. Controls and prompts\\n\\nThe keyboard and mouse are native here, not stand-ins for controller buttons: the same game on the same screens, with the keys PC players expect for this kind of game. The mouse is the best pointer in the game, and the pad is the best-feeling couch device.\\n\\n| Action | DualSense (standard mapping) | Keyboard and mouse |\\n|---|---|---|\\n| Aim | Right stick. D-pad nudges | Mouse, or WASD or arrows |\\n| Use tool | R2 (analog) or ✕ | Left click or Space |\\n| Fine mode, loupe | L2 | Shift |\\n| Pick tool | Left stick flick | 1 to 8. Hold Right click and flick |\\n| Step tool | L1, R1 | Q, E, or the wheel |\\n| The Steady | △ | F or Middle click |\\n| Consult | □ | C |\\n| Drop, cancel stroke | ○ | X or Backspace |\\n| Code Blue shock | L2 + R2 | Left click or Space |\\n| Pause | Options | Esc or P |\\n| Ward: walk | Left stick or D-pad | WASD or arrows, or click to walk |\\n| Ward: talk, use | ✕ | E or Enter, or click the person |\\n| Story: advance | ✕ | Enter, Space or click |\\n| Story: fast-forward | Hold □ | Hold Ctrl |\\n| Story: backlog | △ | B |\\n\\nSettings adds **Swap sticks** for left-handers (cursor and wheel trade sticks).\\n\\n```js\\nconst { attack, dash, skill, jump, ...base } = E.Input.DEFAULT;\\nconst INPUT = { ...base,\\n  useTool: ['Pad7', 'Pad0', 'Mouse0', 'Space'], fine: ['Pad6', 'ShiftLeft', 'ShiftRight'], gift: ['Pad3', 'KeyF', 'Mouse1'], consult: ['Pad2', 'KeyC'],\\n  toolPrev: ['Pad4', 'KeyQ', 'WheelUp'], toolNext: ['Pad5', 'KeyE', 'WheelDown'], wheelHold: ['Mouse2'],\\n  curU: ['KeyW', 'ArrowUp'], curD: ['KeyS', 'ArrowDown'], curL: ['KeyA', 'ArrowLeft'], curR: ['KeyD', 'ArrowRight'],   // separate from up/down/left/right, which the left stick also presses\\n  nudgeU: ['Pad12'], nudgeD: ['Pad13'], nudgeL: ['Pad14'], nudgeR: ['Pad15'],\\n  tool1: ['Digit1'], tool2: ['Digit2'], tool3: ['Digit3'], tool4: ['Digit4'], tool5: ['Digit5'], tool6: ['Digit6'], tool7: ['Digit7'], tool8: ['Digit8'],\\n  interact: ['Pad0', 'KeyE', 'Enter'], skip: ['Pad2', 'ControlLeft'], log: ['Pad3', 'KeyB'], more: ['Pad3', 'KeyM'] };\\n```\\n\\nRead the two sticks from `input.padAim` and `input.padMove`, the trigger from `input.value('useTool')`. Name the actions and hide `tool1` to `tool8` from rebinding through `menu.controls`. Give the scene `camera: { zoom: false, wheel: false }`, because the wheel is the game's.\\n\\n**Prompts.** Always through `game.input.label(action)`, so they follow the device used last and the player's rebinding. Draw a label as a button cap: a rounded rectangle with the label in it, the PlayStation or Xbox face colors on face buttons, and plain keycaps for keys. For the sticks, draw a small stick icon with L or R. Never hard-code a key in text. PlayStation glyphs by default with the Xbox option from fact 5.\\n\\n---\\n\\n## 7. Things on the table\\n\\nA registry (`defObject`), each with sim behavior, a draw function kept apart, and a bot plan.\\n\\n| Type | Looks like | Fixed by | Vitals/s while open | Other effects |\\n|---|---|---|---|---|\\n| `shard` | Glass or steel sliver with a glint | Forceps along its axis | .1 | |\\n| `laceration` | Short red cut | Salve | .2 | Small pool over time |\\n| `wound` | Gaping cut with lips | Suture N stitches | .4 | Bleeding falls with each stitch |\\n| `bleeder` | Pinhole spurting on the beat | Cautery | .5 | Feeds a pool, 6 volume/s |\\n| `arteryTear` | Pulsing spurts | Suture 3 | 1 | Feeds a pool, 14 volume/s |\\n| `pool` | Dark wet metaball, specular | Suction | none | Hides what's under it, drifts on a tilt |\\n| `polyp` | Pink nub | Cautery | .1 | |\\n| `mass` | Large lump | Scalpel ring, Forceps lift, leaves a `wound` | .2 | |\\n| `hook` | Barbed steel | Scalpel relief cuts at each barb, then Forceps | .3 | Tears if pulled with barbs set |\\n| `clot` | Dark lump in a vessel | Targeted Syringe, then Forceps | .3 | |\\n| `patch` | Inflamed red hatch | Salve | .1 | |\\n| `nerve`, `eloquent` | Gold line (no-touch) | Avoid | | Touching with Scalpel or Cautery: -12 and a slip |\\n| `retractorHandle` | Steel handle (Grand Rounds) | Forceps hold | | Opens a window on a target while held |\\n| device parts | Screws, wires, leads (Case 9) | Per Case 9 | | |\\n\\nObjects can be **hidden** (need Sonar), **under a pool**, or **tied** to a phase script. Phase scripts are data: `at: [{ t: 25, do: 'lurch' }]`, `when: 'clear'`.\\n\\n---\\n\\n## 8. HUSH: the strains\\n\\n**HUSH** stands for *Hyperplastic Undifferentiated Synaptic Hive*: an engineered parasite colony that feeds on pain signals and leaves its host blissful, numb and dying. Strains are named after musical markings, because they sing. Chief Oyelaran: \\\"They sing, Doctor. So we name them like songs.\\\"\\n\\n**Common look and sound.** Teal bioluminescence (`#5ff0e0`) with a dark core (`#0b2a30`), additive halo, lavender on bosses. Teal always means HUSH. They stay bright in Long Breath's cold palette. Every strain has its own figure in the choir voice (18), on the **effects** bus: music defaults to 10%, so no gameplay information may depend on music.\\n\\n### Staccato (Case 4 on)\\nSwarm of beads hopping in bursts on a fixed beat, from hidden **nests**. A closing dotted ring shows each landing spot .5 s ahead. A landing bite leaves a `laceration`. Cautery kills a bead in .12 s. Find nests with Sonar; slash, then Forceps. When the last nest goes, the remaining beads die within 3 s. Sound: \\\"tk-tk-tk\\\" on the beat, so the rhythm is playable by ear.\\n\\n### Legato (Case 5 on)\\nA long worm under the tissue, seen as a moving ridge (the painter's `stampLine` with positive height). Its head shows on Sonar.\\n1. Three slur marks lie on its route. Cut the short guide as the ridge nears one; it surfaces.\\n2. Forceps grips the head. Pull slowly: a tension gauge shows the safe rate. Too fast snaps it: the rest regrows a head and flees.\\n3. Every 4th segment has a barb. Release in the hold zone so Quill clamps, burn the barb, regrip. Pull, clamp, burn, regrip is the rhythm of the fight.\\n4. At half length it splits once no matter what, and a smaller worm flees. Repeat, faster.\\n\\n### Tremolo (Case 6, first boss)\\nA shivering web around a coronary vessel on the beating heart, five **reeds** around a mass.\\n- **Aura:** within 70 u the cursor (with a mouse, the aim point around the pointer) jitters by up to ±5 u x `amp`; x.35 in fine mode, none in Long Breath. Vitals shake ±3 and drain .6/s x `amp`.\\n- **Stage 1:** after each heartbeat's peak the reeds flare for .3 s. A targeted Syringe in that window sedates one (`amp` -.2). Outside the window it spits a small cut. The beat, the ECG and the flare sound are the telegraph, so this plays like a rhythm game.\\n- **Stage 2:** at `amp` .2 or less the shell cracks. Cautery burns the mass (3 s in all) while reeds wake every 6 s and need sedating again. Below half, it tears free and crawls along the vessel leaving cuts. Holding it with Forceps pins it for 2 s.\\n- **Stage 3:** a last slow Forceps pull of 40 u.\\n\\n### Da Capo (Case 8)\\nThree **lobes** on a glowing staff line with repeat signs. Each lobe's armor opens on its own timer: A every 6 s for 2.5 s, B every 7 s for 2.5 s, C every 9 s for 3 s. A: Cautery 1 s. B: slash, then Forceps. C: targeted Syringe, then Salve 1 s. The first kill starts a 10 s countdown. At 0 the dead lobes regrow, \\\"from the top\\\": vitals -8, a repeat sign flashes, and the staff plays its figure again. Round 2 runs at double speed and adds Staccato beads. Second Look's ghosts show when each lobe will open, so the winning move is to rewind once and plan the order. It can be beaten without rewinding, on skill.\\n\\n### Fermata (Case 10)\\nAn eye-like organism in the gyri of the brain, among gold eloquent lines.\\n- It raises **hold domes** of radius 34, up to three, for 5 s each. Inside a dome everything waits: tools do nothing, and bleeders inside are paused too, which a clever player can use.\\n- Its eye opens for .7 s the moment a dome collapses. Cautery .3 s three times. Long Breath stretches that window to 2.8 s, and Second Look undoes a slip across an eloquent line. Both matter, so this is where Consult is taught.\\n- Stage 2: the eye flees to another gyrus (find it with Sonar, where Vale's radius helps) and two Legato slivers appear.\\n- Stage 3: a gentle Forceps pull with a very low tension limit.\\n\\n### Cantor (Case 11, final)\\nA vast choir-organ of tissue wrapped around the heart, three mouths on the great vessels. Clock refills between movements.\\n\\n1. **Exposition.** It conducts: a baton tendril draws glowing arcs, and each beat a section sings: Staccato from one mouth, Legato slivers from another, bleeders along the vessels. Slash three baton tendrils at the pause of each arc. Then burn each mouth's uvula (Cautery 1.5 s).\\n2. **Development.** The hush falls. **All sound cuts except the choir, and the monitor goes to static:** no number, no trace, no beep, for stretches of 15 s. Only Quill's readouts remain (\\\"Forty, Doctor.\\\"), plus the tissue's pulse. Fermata domes and Tremolo jitter combine. Find the voice box with Sonar and sedate it on beat windows, three times. This is the game's most memorable moment. Make it feel terrible and wonderful.\\n3. **Recapitulation.** Every 20 s it forcibly rewinds the field 6 s: everything you did is undone, though your Steady stays. A 3 s wind-up shows a giant repeat sign. Slash it during the wind-up (Long Breath makes it easy), or answer with Second Look right after, undoing its rewind (\\\"I've seen this one.\\\"). Six slashes or counters end it.\\n4. **Coda: the Last Note.** One spiral guide, 200 u long, over the beating heart. Fine mode. The stroke can only advance between beats; moving on the beat is a slip. Then Forceps draws the Note out on a rising tone, up to a scream, then **total silence**. Hold it for three seconds. Then one beep. Then Quill: \\\"...Doctor.\\\" Six final stitches to a quiet piano figure, then the dressing.\\n\\n---\\n\\n## 9. The cases\\n\\nA first clear runs about an hour on Resident: eleven cases of 3 to 5 minutes each, plus story and ward. Numbers are Resident defaults, to be balanced with the bot and by hand. Each case's data: patient, doctor, site, clock, vitals, drain, par, phases, barks, story nodes. All text in sections 9 and 10 is direction: write the finished lines yourself in that voice.\\n\\n\",\"total_lines\":1339}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"66d496c4-0fe4-4522-b599-e43607bafc85"}
{"type":"assistant","message":{"id":"msg_43","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"This is a large project. I will be pragmatic and ship a complete game.\n\nThree bugs need fixing before the bot. Remove clockMul from create so only step rate applies. Track p.lx and p.ly for inst from cursor. Add a 0.2-second tear latch to prevent continuous yank from draining vitals, with a one-time -30% progress penalty. Mass extraction must leave a wound.\n\nHook barbs should be modeled as a count that scalpel relief cuts down. Lobe C syringe must enter follow mode to salve instead of marking the lobe done immediately.\n\nLobe B has a slash-then-forceps bug. The scalpel slash currently marks the nest done and kills it, which skips forceps extraction entirely.\n\nThe slash fix will set cut=true without marking done, letting forceps extract the nest. Da Capo round 2 always starts after round 1, even if all three nests are killed early; the bot must kill all three within ten seconds of the first kill, then survive double-speed round two and kill four beads.\n\nCantor domes fully cover all three voices. Tools cannot reach inside them, so the bot cannot sedate the voices.\n\nDomes will tick down and expire in stepCantor instead of covering voices permanently. Voices will be placed at y=160 or higher so they sit outside the dome radius.\n\nLegato head snap detection is confirmed. Dishing the head splits the worm when segments reach half its starting count, spawning a new head with surfaced true. The original head must be fully fought before the split can surface, and the split itself needs its three slurs cut.\n\nThe legato snap path is confirmed: a snapped head dies, surfaced resets, and a new slur spawns for the bot to cut before pulling again.\n\nA bug in the barb spawn logic was found. On an eight-segment worm, the first pull increments pulled to one, so the barb check never triggers because it waits for pulled % 4 === 0. The barb will instead be set on the first pull or every pull until burned.\n\nBarbs will spawn on every pull to match the required rhythm. The bot must release the head in the hold zone, cauterize the barb, and regrip before it can dish again. This creates a complex but necessary fight loop.\n\nBarbs and hold zones will be optional objects so the bot can fight the legato without getting stuck. The fight ends when segments reach zero.\n\nTremolo amplitude recomputes from remaining reeds each frame, but stage two caps it at 0.2.\n\nTremolo stage one ends when all reeds are killed. Stage two requires three seconds of cautery. Reeds respawn every six seconds if fewer than two remain. During mass burn a reed can still respawn and keep amplitude capped at 0.2. Reed windows only open during flares. Live reeds block phase clear even after their strain is done. The bot must kill every reed, the mass, and any respawned reeds.\n\nStage three disables reed respawn entirely, so the bot only needs to sedate existing reeds to clear the phase. During stage two, a mass burn at amplitude 0.2 or below is valid even if a reed respawns mid-burn, provided the bot sedates it afterward. Staccato nests are hidden and must be found with sonar before scalpel slash and forceps extraction.\n\nSalve doses on a lobe will add cells to the bot. Tool tests can verify grades before the case finishes because the object is marked complete immediately. Fed pools remain mandatory and must be suctioned.\n\nSuctioning a pool now triggers automatically when its source is done. Tutorial phases freeze until the first award and should not carry time pressure. Code blue and clock zero share the same step because maybeDie checks the clock first. The secondLook function needs review to ensure it works correctly. Hash determinism is preserved: only hypot, sin, atan2, and JSON are used in simulation, the RNG is xorshift, and jitter derives from worldT rather than randomness.\n\nThe intern clock will lose its double scale. Forceps tears will carry a 0.2-second cooldown per object. Scalpel cuts on healthy tissue require the bot to be above 40 units of instant health and travel. Fermata pulls use forceps and snap if the bot exceeds 40 units per second of tension; the bot will cap its pull speed at 70 percent of that limit. Legato tension is 70, so the bot must pull at 50 units per second or it will snap.\n\nThe slash handler will switch lobe targets to forceps mode after cutting them, so the bot can extract them with forceps instead of finishing them immediately. Syringe salve doses will set the target mode to salve and add missing cells.\n\nStaccato nests are hidden and must be sonar-marked before the bot can slash them. Nest slashes do not need a guide. After a nest is cut, the forceps handler falls through to grip because the cut flag blocks the nest branch. Bead cautery requires 0.12.\n\nBeads are not hidden. They are a fixed list and do not respawn. The bot can kill them early or ignore them entirely. Nests must collapse first. Then beads die. Lacerations from bead landings are mandatory. They block phase clear. The bot must salve them.\n\nBeads land at 0.6 seconds plus 0.15-second intervals. Nest slashes and forceps take roughly two seconds, so lacerations will already exist when the bot reaches them. The bot must slash and forceps nests quickly to avoid more bites before salving the lacerations.","signature":""},{"type":"tool_use","id":"call-bc633dc4-70ae-43af-9d9a-395139a2a91a-11","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/PLAN.md","offset":425,"limit":200}},{"type":"tool_use","id":"call-bc633dc4-70ae-43af-9d9a-395139a2a91a-12","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/PLAN.md","offset":616,"limit":90}},{"type":"tool_use","id":"call-bc633dc4-70ae-43af-9d9a-395139a2a91a-13","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/PLAN.md","offset":978,"limit":70}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":16525,"output_tokens":3339,"cache_read_input_tokens":59136,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"16b7b8a1-9aba-4d95-aa7b-d195eb004f5a"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-bc633dc4-70ae-43af-9d9a-395139a2a91a-11","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"425→## 9. The cases\\n\\nA first clear runs about an hour on Resident: eleven cases of 3 to 5 minutes each, plus story and ward. Numbers are Resident defaults, to be balanced with the bot and by hand. Each case's data: patient, doctor, site, clock, vitals, drain, par, phases, barks, story nodes. All text in sections 9 and 10 is direction: write the finished lines yourself in that voice.\\n\\n### 9.1 The Lightbox (Second Opinion)\\n430→\\nBefore Cases 2, 4 and 10. The chart carries someone's **first opinion**. On the lightbox is the film: procedural X-ray art (ribs, spine or skull in pale polygons, soft-tissue haze, noise, one anomaly). Odalys chats. Point and press to mark what's really wrong (within 14 u; three tries; no fail state).\\n\\n- Right: \\\"Second opinion confirmed.\\\" +20 s and +20 Steady, and a marker on the op's field.\\n- Wrong: -10 s, a Percy smirk, and try again.\\n\\nIt is short (20 to 40 s), it teaches pointing, and it is the source's subtitle turned into a mechanic.\\n\\n### 9.2 Chapter 1: First Incision\\n\\n440→**Case 1, Glasshouse** (Dr. Vale, forearm; clock 180, vitals 80, drain .1). *New: cursor, wheel, trigger, four tools, grades.* Tutorial freezes on.\\n1. Pull the glass: 4 shards.\\n2. Clean the cuts: 3 lacerations, Salve.\\n3. Close: 1 wound, 4 stitches.\\n4. Give her a boost: a scripted dip to 40, Syringe to the IV. Dressing.\\n\\n**Case 2, Low Brass** (Vale, abdomen; 210, 70, .2). *New: Lightbox, Scalpel, Suction, Cautery, excision.* First opinion: Percy's \\\"Hernia. Obviously.\\\"\\n1. Open: 60 u guide.\\n2. Clear the field: 2 pools, 1 bleeder.\\n3. Burn the polyps: 5.\\n450→4. Take the mass: ring cut, lift. Underneath, a trombone spit-valve cork swallowed decades ago, which comes out with Forceps. Quill: \\\"I'll label it.\\\"\\n5. Close: 6 stitches, Salve.\\n\\n**Case 3, Crane Nine** (Vale, abdomen; 150, 55, .5). *New: triage, Code Blue, Long Breath.* The harbor crane has collapsed, and the Chief is away.\\n1. Stop the bleeding: 3 artery tears, bleeders, pools everywhere.\\n2. Shrapnel: 5 fragments, 2 under pools.\\n3. He's crashing: vitals ramp to 0, the guaranteed first Code Blue. On the revive the world goes quiet, rain hangs in the theatre window on the cutaway, and the prompt for Long Breath appears: six ruptures in a ring to seal within 12 s.\\n4. Close.\\n\\n### 9.3 Chapter 2: The Quiet Ones\\n460→\\n**Case 4, The Whistling Man** (Vale, flank; 200, 75, .25). *New: Sonar, barbed extraction, first strain.* Lightbox: the chart says superficial, and the film shows something moving.\\n1. Free the gaff: 2 relief cuts, a long axis pull.\\n2. Something moved: Sonar, 2 hidden nests.\\n3. Staccato.\\n4. Repair: 6 bites with Salve, Suture the gaff wound.\\n\\n**Case 5, Slur** (Vale, wrist with tendons and a gold nerve line; 220, 70, .2). *New: Legato, fine mode, no-touch anatomy, the clamp hand-off.*\\n1. Find it with Sonar.\\n2. Intercept at the slur marks.\\n470→3. The long pull with barbs.\\n4. It split.\\n5. Repair: Salve the track, 5 fine stitches.\\n\\n**Case 6, Bedside Manner** (Vale, heart; 240, 60, .35). *New: the beating heart, timing to the beat, cursor tremor, first boss.* The patient is the Chief.\\n1. Open: long sternal guide, Suction.\\n2. Tremolo.\\n3. Mend: a graft along the vessel, where stitches only land between beats. Salve.\\n\\n### 9.4 Chapter 3: Second Look\\n480→\\n**Case 7, Force Nine** (Dr. Sokolova, abdomen on the hospital ship; 170, 60, .35). *New: Second Look, the ship's roll, blackout.* `tilt` drifts pools at up to 25 u/s, and loose objects slide. The lamp sways: pass a moving `light` to the painter, so highlights roll around the field.\\n1. Winch damage: 4 fragments, 2 artery tears. At about 25 s a scripted lurch forces a slip. \\\"No. Again.\\\" Prompt: △. The ghost shows the lurch, and now you wait it out.\\n2. Blackout: the power fails, `dim` and a small `spot` follow the cursor. Find and seal 3 hidden bleeders by Sonar's lens alone.\\n3. Close on the roll: 8 stitches whose points shift ±6 u.\\n\\n**Case 8, From the Top** (Sokolova, abdomen; 210, 65, .3). *New: Da Capo, planning with ghosts.* The patient is Sister Perpetua.\\n1. Open, clear.\\n2. Da Capo, round 1.\\n3. Round 2.\\n490→4. Close.\\n\\n**Case 9, Dead Man's Rhythm** (Sokolova, chest wall with an implant; 200, 70, .25). *New: a device instead of a disease.* The patient is a whistleblower, whose pacemaker has been rigged to detonate if his heart stops or the can is forced. Sokolova: \\\"We are doctors.\\\" Quill: \\\"I'll fetch the other forceps.\\\" Vitals under 25 or clock at 0 sets it off: the ship goes, and you retry from the last checkpoint.\\n1. Expose the can: guide, Suction.\\n2. Four screws: Forceps turn, circling the stick or mouse three times per screw.\\n3. Read the board: the patient's halting instructions name a wire order, but Sonar shows the board differs. A real second opinion. Wires are marked ▲ ● ■, never by color alone.\\n4. Cautery solders a bypass lead, then Scalpel slashes the wires in the true order. A wrong wire: vitals -30, clock -30.\\n5. Lift it with Forceps at a very low tension limit while the ship rolls.\\n6. Close.\\n\\n500→### 9.5 Chapter 4: Coda\\n\\n**Case 10, Eloquent Cortex** (Vale and Sokolova, brain; 240, 60, .3). *New: Consult.* Lightbox: Percy's chart on himself, in his own hand, says migraine.\\n1. Open: curved scalp guide, Suction, Sokolova's hands.\\n2. Fermata, stage 1. Prompt to Consult when the first eye opens: Vale's Long Breath lands the window, then back to Sokolova when a slip needs undoing.\\n3. Stage 2: Sonar for the eye, two Legato slivers.\\n4. Stage 3: the gentle pull.\\n5. Close: 6 fine stitches, Salve.\\n\\n**Case 11, Last Note** (both, mediastinum; 420, 70, .3, with +120 s at each new movement). All tools, both gifts, Consult free.\\n510→1. Open: the long sternal guide again, Suction, with bleeders already running.\\n2. The Cantor's four movements (section 8), each a checkpoint.\\n3. The dressing, with no music at all.\\n\\n### 9.6 Outside the story\\n\\n**Skills Lab** in Case Files: a sandbox with no clock and locked vitals, respawning one of everything unlocked so far. It reuses the op scene. Quill: \\\"This is a pig's trotter. It has signed the waiver.\\\"\\n\\n**Grand Rounds:** section 12.\\n\\n520→---\\n\\n## 10. Story bible\\n\\n### World\\n\\n**Port Anselm**, a rain-soaked North Atlantic harbor city, a few years from now. Gulls, foghorns, cranes. **St. Erasmus Harbor Hospital**, \\\"St. Raz's\\\" to the staff, is old, underfunded and proud, and its gleaming new east wing is paid for by the **Anodyne Foundation**, whose billboards say A LIFE WITHOUT PAIN. Its product is **Lull**, a miracle analgesic that really works. Its secret is HUSH.\\n\\n**Theme.** Pain is information. Pain means you're still here. A doctor's job is to listen to it, not abolish it. Motto among the staff who know: \\\"Don't let it go quiet.\\\"\\n\\n530→**The Steady.** An old theatre word, never said aloud in the lift. Surgeons who have it stretch a moment or take it back. Quill has passed instruments to three of them.\\n\\n### Cast\\n\\nPronouns as listed. Portraits per Appendix C.\\n\\n| Character | Role | Voice and manner | Look |\\n|---|---|---|---|\\n| **Dr. Imogen \\\"Immy\\\" Vale** (she), 26 | Second-year resident, first protagonist. Long Breath | Talks too fast, apologizes to unconscious patients, sure she's a fraud in clogs. Grows into quiet courage | Copper hair, freckles, teal cap and scrubs, lucky pen |\\n| **Bartholomew Quill** (he), 58 | Scrub nurse, Theatre 3, 31 years. The player's constant companion | Deadpan, unhurried, calls everyone \\\"Doctor\\\" in forty intonations. Knits. Ex-merchant navy | Grey moustache, blue scrubs, mask, heavy brows |\\n540→| **Dr. Marguerite Oyelaran** (she), 61 | Chief of Surgery | Dry, exacting, proud. Took the Foundation's money to keep the doors open, and takes Lull for her hands | Dark skin, white crop, gold glasses, white coat, cane |\\n| **Dr. Yevgenia \\\"Zhenya\\\" Sokolova** (she), 67 | Surgeon of the hospital ship *Samaritan's Wake*, second protagonist. Second Look | Gleeful, salty, ruthless with sentiment, pipe never lit. \\\"At my age, dear, everything happens twice.\\\" Unfinished business with Quill | White hair, face scar, olive fatigues, red headband |\\n| **Dr. Percival Whitlock** (he), 29 | Fellow resident, rival, author of wrong first opinions | Smug, handsome, terrified. Secretly on Lull to keep up | Perfect hair, pristine coat |\\n| **Odalys Ferreira** (she), 31 | Night radiology tech, runs the Lightbox | Excitable, conspiracy-minded, always right, always eating | Curls, oversized glasses, cardigan |\\n| **Dr. Lucian Hale** (he), 55 | Founder of the Anodyne Foundation. Beloved TV doctor | Soft, warm, perfect bedside voice. Never raises it. Means every word | Silver hair, tailored suit, kind eyes |\\n| **Clementine Hale** (she), 19 | His daughter, patient zero | Serene, smiling, has felt nothing since she was nine | Pale, cropped hair, hospital gown, faint teal under the skin |\\n\\n### How it sounds\\n\\nMelodrama played straight, as in the source: earnest speeches, jargon in bursts, cliffhanger reveals, sudden collapses, a villain who explains himself. Humor comes from character and never winks at the camera.\\n550→\\nRules:\\n- A line fits two rows of the dialog box, at most 90 characters. A scene runs 6 to 14 lines.\\n- Jargon in bursts, translated by someone immediately.\\n- Every patient gets one human detail.\\n- End scenes on a turn or a big sincere line.\\n- Tone choices now and then (Quill reacts; the story doesn't branch).\\n- American spelling, except \\\"theatre\\\", which is what the staff call the operating room.\\n\\nSamples, for pitch. Use these and write hundreds more:\\n560→\\n- **Quill:** \\\"That was the liver, Doctor. We keep that one.\\\"\\n- **Quill:** \\\"Pulse forty. I mention it only in passing.\\\"\\n- **Quill:** \\\"I have seen worse. He was a plumber.\\\"\\n- **Quill:** \\\"Breathe, Doctor. One of you should.\\\"\\n- **Quill, after a Textbook stitch:** \\\"...Hm.\\\"\\n- **Vale:** \\\"Okay okay okay. Sorry! Sorry. She can't hear me. Sorry.\\\"\\n- **Vale:** \\\"My hands won't stop shaking.\\\" **Quill:** \\\"They stop around year thirty, Doctor. I'm told.\\\"\\n- **Oyelaran:** \\\"A surgeon who argues with a chart. How tiresome. Do it again.\\\"\\n- **Sokolova:** \\\"No. Again.\\\"\\n570→- **Sokolova:** \\\"In the navy we did this with a spoon.\\\"\\n- **Sokolova:** \\\"You're late, Bartholomew.\\\" **Quill:** \\\"Thirty-one years, Yevgenia.\\\"\\n- **Percy:** \\\"Hernia. Obviously.\\\"\\n- **Odalys:** \\\"Okay so don't freak out, but your X-ray is humming.\\\"\\n- **Hale:** \\\"Pain is the last disease, Doctor. I only ask you to stop defending it.\\\"\\n- **Ilse, waking:** \\\"It hurts. Oh, it hurts. Thank you.\\\"\\n\\n### Beats\\n\\n**Chapter 1: First Incision.**\\n580→- *Case 1.* Night shift. Immy's first solo: **Agnes Pellow**, 74, fell through her greenhouse roof, and wants the glass kept for the grandchildren. Quill walks Immy through it. After: her hands shake.\\n- *Case 2.* **Desmond \\\"Slide\\\" Achebe**, trombonist at the Harbor Jazz Hall. Percy's chart says hernia. Odalys's film says otherwise. Immy argues. Inside: a mass, and a cork he swallowed in 1987. \\\"I wondered where that went.\\\" The Chief notices her.\\n- *Case 3.* Crane Nine falls. **Big Tam Rennie**, foreman, arrives on a gurney. Chief away, Immy alone. He dies on the table, then doesn't, and something happens to the time. After, Quill: \\\"How long did that feel, Doctor?\\\" \\\"A minute?\\\" \\\"Eleven seconds. We don't discuss it in the lift.\\\" The Chief, at last: \\\"There is an old word in theatre.\\\"\\n\\n**Chapter 2: The Quiet Ones.**\\n- *Case 4.* **Captain Ned Harrow** walks into the ER whistling with a gaff through his side, wants to get back to sea, feels nothing. Inside, something hops. Immy hears singing no one else hears. Quill, for the first time, says nothing. Odalys: \\\"It's not in any database.\\\" The Chief: not a word until she has spoken to the Foundation.\\n- *Case 5.* **Ilse Brandt**, 19, conservatory violinist, numb left hand, never happier. She doesn't want treatment. Legato. She wakes crying with pain, and thanks Immy. Odalys finds the pattern: every case went to an Anodyne clinic. Percy: \\\"You've been up for forty hours.\\\"\\n- *Case 6.* At the Foundation's gala in the new wing, with Hale speaking and chandeliers overhead, the Chief collapses, cane rolling across the floor. She has been hiding it. Immy operates on her mentor. Waking, the Chief confesses the bargain, names the disease, and gives Immy a name: Sokolova, on the *Samaritan's Wake*. Quill drops a tray for the first time in 31 years. On the ward TV, Hale: \\\"I hear Dr. Oyelaran is recovering. Wonderful.\\\" End of chapter.\\n\\n**Chapter 3: Second Look.** The player becomes Zhenya.\\n590→- *Case 7.* A North Atlantic storm. Immy and Quill arrive by launch as a winch crushes deckhand **Yusuf Demir**. Zhenya operates with a pipe in her teeth and shows Immy what the Steady can also do. Immy watches something un-happen.\\n- *Case 8.* **Sister Perpetua** runs the seamen's hospice, and brings aboard patients who've never been happier. Her strain regrows when cut. Afterward the hard argument, played fairly: \\\"You'd give them back their pain?\\\" Zhenya: \\\"I'd give them back their choice.\\\"\\n- *Case 9.* **Dr. Hollis Crane**, a Foundation researcher, comes aboard to confess, with a rigged pacemaker. Saved, he gives the last piece: it began with Hale's daughter. \\\"Everything is singing to her.\\\" They sail for Port Anselm.\\n\\n**Chapter 4: Coda.**\\n- *Case 10.* Percy collapses in Immy's arms: \\\"It's finally quiet.\\\" He has been on Lull all along. First time Immy and Zhenya operate together. Waking: \\\"Your stitches are crooked.\\\" Immy cries laughing.\\n- *Case 11.* Across the city, every Anodyne patient begins to fail at once. Hale carries his daughter into St. Raz's himself, his voice finally breaking: \\\"I only wanted her not to hurt.\\\" Everyone is there: the Chief in a wheelchair in the gallery, Percy on the monitors, Odalys at the film, Quill passing instruments. The last operation.\\n- *Ending.* Silence. A beep. Clementine wakes screaming, then laughing: she can feel her hands. The city wakes in pain, and St. Raz's ER is the happiest, loudest, most furious place on earth (\\\"Doctor, I have a headache!\\\" \\\"Wonderful!\\\"). Hale surrenders, gently. Immy looks at her hands. Quill: \\\"They've stopped shaking, Doctor.\\\" She looks again. \\\"No, they haven't.\\\" \\\"Good.\\\" Credits. After the credits, in Case Files, a new blank folder appears with a chart that reads *Incoming*, leaving the door open for more game without being a stub: it simply says \\\"Next shift starts at seven. Get some sleep, Doctor.\\\"\\n\\n**Barks.** Each case has lines for phase enter, idle hint, slip, low vitals, phase done. A shared pool of at least 40 Quill lines by situation, so play never repeats fast. Barks never pause play. Sokolova's scenes give barks to Quill or Immy as the scene suits.\\n600→\\n---\\n\\n## 11. The ward\\n\\nBetween cases the player walks **Ward 3** (Chapters 1, 2 and 4) or the **ship's ward** (Chapter 3, a smaller map with a swinging lamp). This second perspective makes the world real: the people you saved are in the beds.\\n\\n- `threequarter` view, `E.TileMap` from text rows, `E.Body`, `E.Humanoid` in scrubs at `size: 1.3`, E.Story for talk, lights on: fluorescent panels, a window wall with rain, a warm desk lamp. Start from `kits/adventure.js` for the movement and talk loop.\\n- **People:** saved patients appear in beds after their case, each with new lines per chapter (Agnes's grandchildren bring begonias; Slide practices with a mute). Odalys at her lightbox, Percy at the vending machine, Quill knitting, the Chief's door.\\n- **Input:** stick or WASD walks. ✕ or E talks when near. **Hover moves the focus to a person or door with an outline and a name, and clicking walks there** (`game.mouseGround()`, `E.FlowField`) and talks.\\n610→- **Theatre door:** a glowing NEXT CASE sign, at most 8 tiles from where you arrive, so the ward is never a chore. It's an optional breather.\\n- **Saves:** autosave on arrival, `menu: { saves: true }`. The pause menu's Save row is on by default, so keep `game.saves.canSave` true here and false in every other scene.\\n- **Small reward:** talking to everyone before the next case starts it with +10 Steady (\\\"Morale,\\\" Quill says, as if it were a diagnosis).\\n\\n---\\n\\n## 12. Multiplayer: Grand Rounds\\n\\nOne case for 1 to 4 surgeons on one patient, each with their own cursor, wheel and glove color. The host runs the world. Team result, individual standings. About 4 minutes. It plays **the same on one couch and over the Hub.**\\n\\n620→### 12.1 The case\\n\\nA ferry disaster, mass casualty. Scales with N players:\\n1. **Triage:** 3N bleeders and tears, pools everywhere.\\n2. **Swarm:** Staccato, N nests, 4N beads at once.\",\"content_concise\":\"425→## 9. The cases\\n\\nA first clear runs about an hour on Resident: eleven cases of 3 to 5 minutes each, plus story and ward. Numbers are Resident defaults, to be balanced with the bot and by hand. Each case's data: patient, doctor, site, clock, vitals, drain, par, phases, barks, story nodes. All text in sections 9 and 10 is direction: write the finished lines yourself in that voice.\\n\\n### 9.1 The Lightbox (Second Opinion)\\n430→\\nBefore Cases 2, 4 and 10. The chart carries someone's **first opinion**. On the lightbox is the film: procedural X-ray art (ribs, spine or skull in pale polygons, soft-tissue haze, noise, one anomaly). Odalys chats. Point and press to mark what's really wrong (within 14 u; three tries; no fail state).\\n\\n- Right: \\\"Second opinion confirmed.\\\" +20 s and +20 Steady, and a marker on the op's field.\\n- Wrong: -10 s, a Percy smirk, and try again.\\n\\nIt is short (20 to 40 s), it teaches pointing, and it is the source's subtitle turned into a mechanic.\\n\\n### 9.2 Chapter 1: First Incision\\n\\n440→**Case 1, Glasshouse** (Dr. Vale, forearm; clock 180, vitals 80, drain .1). *New: cursor, wheel, trigger, four tools, grades.* Tutorial freezes on.\\n1. Pull the glass: 4 shards.\\n2. Clean the cuts: 3 lacerations, Salve.\\n3. Close: 1 wound, 4 stitches.\\n4. Give her a boost: a scripted dip to 40, Syringe to the IV. Dressing.\\n\\n**Case 2, Low Brass** (Vale, abdomen; 210, 70, .2). *New: Lightbox, Scalpel, Suction, Cautery, excision.* First opinion: Percy's \\\"Hernia. Obviously.\\\"\\n1. Open: 60 u guide.\\n2. Clear the field: 2 pools, 1 bleeder.\\n3. Burn the polyps: 5.\\n450→4. Take the mass: ring cut, lift. Underneath, a trombone spit-valve cork swallowed decades ago, which comes out with Forceps. Quill: \\\"I'll label it.\\\"\\n5. Close: 6 stitches, Salve.\\n\\n**Case 3, Crane Nine** (Vale, abdomen; 150, 55, .5). *New: triage, Code Blue, Long Breath.* The harbor crane has collapsed, and the Chief is away.\\n1. Stop the bleeding: 3 artery tears, bleeders, pools everywhere.\\n2. Shrapnel: 5 fragments, 2 under pools.\\n3. He's crashing: vitals ramp to 0, the guaranteed first Code Blue. On the revive the world goes quiet, rain hangs in the theatre window on the cutaway, and the prompt for Long Breath appears: six ruptures in a ring to seal within 12 s.\\n4. Close.\\n\\n### 9.3 Chapter 2: The Quiet Ones\\n460→\\n**Case 4, The Whistling Man** (Vale, flank; 200, 75, .25). *New: Sonar, barbed extraction, first strain.* Lightbox: the chart says superficial, and the film shows something moving.\\n1. Free the gaff: 2 relief cuts, a long axis pull.\\n2. Something moved: Sonar, 2 hidden nests.\\n3. Staccato.\\n4. Repair: 6 bites with Salve, Suture the gaff wound.\\n\\n**Case 5, Slur** (Vale, wrist with tendons and a gold nerve line; 220, 70, .2). *New: Legato, fine mode, no-touch anatomy, the clamp hand-off.*\\n1. Find it with Sonar.\\n2. Intercept at the slur marks.\\n470→3. The long pull with barbs.\\n4. It split.\\n5. Repair: Salve the track, 5 fine stitches.\\n\\n**Case 6, Bedside Manner** (Vale, heart; 240, 60, .35). *New: the beating heart, timing to the beat, cursor tremor, first boss.* The patient is the Chief.\\n1. Open: long sternal guide, Suction.\\n2. Tremolo.\\n3. Mend: a graft along the vessel, where stitches only land between beats. Salve.\\n\\n### 9.4 Chapter 3: Second Look\\n480→\\n**Case 7, Force Nine** (Dr. Sokolova, abdomen on the hospital ship; 170, 60, .35). *New: Second Look, the ship's roll, blackout.* `tilt` drifts pools at up to 25 u/s, and loose objects slide. The lamp sways: pass a moving `light` to the painter, so highlights roll around the field.\\n1. Winch damage: 4 fragments, 2 artery tears. At about 25 s a scripted lurch forces a slip. \\\"No. Again.\\\" Prompt: △. The ghost shows the lurch, and now you wait it out.\\n2. Blackout: the power fails, `dim` and a small `spot` follow the cursor. Find and seal 3 hidden bleeders by Sonar's lens alone.\\n3. Close on the roll: 8 stitches whose points shift ±6 u.\\n\\n**Case 8, From the Top** (Sokolova, abdomen; 210, 65, .3). *New: Da Capo, planning with ghosts.* The patient is Sister Perpetua.\\n1. Open, clear.\\n2. Da Capo, round 1.\\n3. Round 2.\\n490→4. Close.\\n\\n**Case 9, Dead Man's Rhythm** (Sokolova, chest wall with an implant; 200, 70, .25). *New: a device instead of a disease.* The patient is a whistleblower, whose pacemaker has been rigged to detonate if his heart stops or the can is forced. Sokolova: \\\"We are doctors.\\\" Quill: \\\"I'll fetch the other forceps.\\\" Vitals under 25 or clock at 0 sets it off: the ship goes, and you retry from the last checkpoint.\\n1. Expose the can: guide, Suction.\\n2. Four screws: Forceps turn, circling the stick or mouse three times per screw.\\n3. Read the board: the patient's halting instructions name a wire order, but Sonar shows the board differs. A real second opinion. Wires are marked ▲ ● ■, never by color alone.\\n4. Cautery solders a bypass lead, then Scalpel slashes the wires in the true order. A wrong wire: vitals -30, clock -30.\\n5. Lift it with Forceps at a very low tension limit while the ship rolls.\\n6. Close.\\n\\n500→### 9.5 Chapter 4: Coda\\n\\n**Case 10, Eloquent Cortex** (Vale and Sokolova, brain; 240, 60, .3). *New: Consult.* Lightbox: Percy's chart on himself, in his own hand, says migraine.\\n1. Open: curved scalp guide, Suction, Sokolova's hands.\\n2. Fermata, stage 1. Prompt to Consult when the first eye opens: Vale's Long Breath lands the window, then back to Sokolova when a slip needs undoing.\\n3. Stage 2: Sonar for the eye, two Legato slivers.\\n4. Stage 3: the gentle pull.\\n5. Close: 6 fine stitches, Salve.\\n\\n**Case 11, Last Note** (both, mediastinum; 420, 70, .3, with +120 s at each new movement). All tools, both gifts, Consult free.\\n510→1. Open: the long sternal guide again, Suction, with bleeders already running.\\n2. The Cantor's four movements (section 8), each a checkpoint.\\n3. The dressing, with no music at all.\\n\\n### 9.6 Outside the story\\n\\n**Skills Lab** in Case Files: a sandbox with no clock and locked vitals, respawning one of everything unlocked so far. It reuses the op scene. Quill: \\\"This is a pig's trotter. It has signed the waiver.\\\"\\n\\n**Grand Rounds:** section 12.\\n\\n520→---\\n\\n## 10. Story bible\\n\\n### World\\n\\n**Port Anselm**, a rain-soaked North Atlantic harbor city, a few years from now. Gulls, foghorns, cranes. **St. Erasmus Harbor Hospital**, \\\"St. Raz's\\\" to the staff, is old, underfunded and proud, and its gleaming new east wing is paid for by the **Anodyne Foundation**, whose billboards say A LIFE WITHOUT PAIN. Its product is **Lull**, a miracle analgesic that really works. Its secret is HUSH.\\n\\n**Theme.** Pain is information. Pain means you're still here. A doctor's job is to listen to it, not abolish it. Motto among the staff who know: \\\"Don't let it go quiet.\\\"\\n\\n530→**The Steady.** An old theatre word, never said aloud in the lift. Surgeons who have it stretch a moment or take it back. Quill has passed instruments to three of them.\\n\\n### Cast\\n\\nPronouns as listed. Portraits per Appendix C.\\n\\n| Character | Role | Voice and manner | Look |\\n|---|---|---|---|\\n| **Dr. Imogen \\\"Immy\\\" Vale** (she), 26 | Second-year resident, first protagonist. Long Breath | Talks too fast, apologizes to unconscious patients, sure she's a fraud in clogs. Grows into quiet courage | Copper hair, freckles, teal cap and scrubs, lucky pen |\\n| **Bartholomew Quill** (he), 58 | Scrub nurse, Theatre 3, 31 years. The player's constant companion | Deadpan, unhurried, calls everyone \\\"Doctor\\\" in forty intonations. Knits. Ex-merchant navy | Grey moustache, blue scrubs, mask, heavy brows |\\n540→| **Dr. Marguerite Oyelaran** (she), 61 | Chief of Surgery | Dry, exacting, proud. Took the Foundation's money to keep the doors open, and takes Lull for her hands | Dark skin, white crop, gold glasses, white coat, cane |\\n| **Dr. Yevgenia \\\"Zhenya\\\" Sokolova** (she), 67 | Surgeon of the hospital ship *Samaritan's Wake*, second protagonist. Second Look | Gleeful, salty, ruthless with sentiment, pipe never lit. \\\"At my age, dear, everything happens twice.\\\" Unfinished business with Quill | White hair, face scar, olive fatigues, red headband |\\n| **Dr. Percival Whitlock** (he), 29 | Fellow resident, rival, author of wrong first opinions | Smug, handsome, terrified. Secretly on Lull to keep up | Perfect hair, pristine coat |\\n| **Odalys Ferreira** (she), 31 | Night radiology tech, runs the Lightbox | Excitable, conspiracy-minded, always right, always eating | Curls, oversized glasses, cardigan |\\n| **Dr. Lucian Hale** (he), 55 | Founder of the Anodyne Foundation. Beloved TV doctor | Soft, warm, perfect bedside voice. Never raises it. Means every word | Silver hair, tailored suit, kind eyes |\\n| **Clementine Hale** (she), 19 | His daughter, patient zero | Serene, smiling, has felt nothing since she was nine | Pale, cropped hair, hospital gown, faint teal under the skin |\\n\\n### How it sounds\\n\\nMelodrama played straight, as in the source: earnest speeches, jargon in bursts, cliffhanger reveals, sudden collapses, a villain who explains himself. Humor comes from character and never winks at the camera.\\n550→\\nRules:\\n- A line fits two rows of the dialog box, at most 90 characters. A scene runs 6 to 14 lines.\\n- Jargon in bursts, translated by someone immediately.\\n- Every patient gets one human detail.\\n- End scenes on a turn or a big sincere line.\\n- Tone choices now and then (Quill reacts; the story doesn't branch).\\n- American spelling, except \\\"theatre\\\", which is what the staff call the operating room.\\n\\nSamples, for pitch. Use these and write hundreds more:\\n560→\\n- **Quill:** \\\"That was the liver, Doctor. We keep that one.\\\"\\n- **Quill:** \\\"Pulse forty. I mention it only in passing.\\\"\\n- **Quill:** \\\"I have seen worse. He was a plumber.\\\"\\n- **Quill:** \\\"Breathe, Doctor. One of you should.\\\"\\n- **Quill, after a Textbook stitch:** \\\"...Hm.\\\"\\n- **Vale:** \\\"Okay okay okay. Sorry! Sorry. She can't hear me. Sorry.\\\"\\n- **Vale:** \\\"My hands won't stop shaking.\\\" **Quill:** \\\"They stop around year thirty, Doctor. I'm told.\\\"\\n- **Oyelaran:** \\\"A surgeon who argues with a chart. How tiresome. Do it again.\\\"\\n- **Sokolova:** \\\"No. Again.\\\"\\n570→- **Sokolova:** \\\"In the navy we did this with a spoon.\\\"\\n- **Sokolova:** \\\"You're late, Bartholomew.\\\" **Quill:** \\\"Thirty-one years, Yevgenia.\\\"\\n- **Percy:** \\\"Hernia. Obviously.\\\"\\n- **Odalys:** \\\"Okay so don't freak out, but your X-ray is humming.\\\"\\n- **Hale:** \\\"Pain is the last disease, Doctor. I only ask you to stop defending it.\\\"\\n- **Ilse, waking:** \\\"It hurts. Oh, it hurts. Thank you.\\\"\\n\\n### Beats\\n\\n**Chapter 1: First Incision.**\\n580→- *Case 1.* Night shift. Immy's first solo: **Agnes Pellow**, 74, fell through her greenhouse roof, and wants the glass kept for the grandchildren. Quill walks Immy through it. After: her hands shake.\\n- *Case 2.* **Desmond \\\"Slide\\\" Achebe**, trombonist at the Harbor Jazz Hall. Percy's chart says hernia. Odalys's film says otherwise. Immy argues. Inside: a mass, and a cork he swallowed in 1987. \\\"I wondered where that went.\\\" The Chief notices her.\\n- *Case 3.* Crane Nine falls. **Big Tam Rennie**, foreman, arrives on a gurney. Chief away, Immy alone. He dies on the table, then doesn't, and something happens to the time. After, Quill: \\\"How long did that feel, Doctor?\\\" \\\"A minute?\\\" \\\"Eleven seconds. We don't discuss it in the lift.\\\" The Chief, at last: \\\"There is an old word in theatre.\\\"\\n\\n**Chapter 2: The Quiet Ones.**\\n- *Case 4.* **Captain Ned Harrow** walks into the ER whistling with a gaff through his side, wants to get back to sea, feels nothing. Inside, something hops. Immy hears singing no one else hears. Quill, for the first time, says nothing. Odalys: \\\"It's not in any database.\\\" The Chief: not a word until she has spoken to the Foundation.\\n- *Case 5.* **Ilse Brandt**, 19, conservatory violinist, numb left hand, never happier. She doesn't want treatment. Legato. She wakes crying with pain, and thanks Immy. Odalys finds the pattern: every case went to an Anodyne clinic. Percy: \\\"You've been up for forty hours.\\\"\\n- *Case 6.* At the Foundation's gala in the new wing, with Hale speaking and chandeliers overhead, the Chief collapses, cane rolling across the floor. She has been hiding it. Immy operates on her mentor. Waking, the Chief confesses the bargain, names the disease, and gives Immy a name: Sokolova, on the *Samaritan's Wake*. Quill drops a tray for the first time in 31 years. On the ward TV, Hale: \\\"I hear Dr. Oyelaran is recovering. Wonderful.\\\" End of chapter.\\n\\n**Chapter 3: Second Look.** The player becomes Zhenya.\\n590→- *Case 7.* A North Atlantic storm. Immy and Quill arrive by launch as a winch crushes deckhand **Yusuf Demir**. Zhenya operates with a pipe in her teeth and shows Immy what the Steady can also do. Immy watches something un-happen.\\n- *Case 8.* **Sister Perpetua** runs the seamen's hospice, and brings aboard patients who've never been happier. Her strain regrows when cut. Afterward the hard argument, played fairly: \\\"You'd give them back their pain?\\\" Zhenya: \\\"I'd give them back their choice.\\\"\\n- *Case 9.* **Dr. Hollis Crane**, a Foundation researcher, comes aboard to confess, with a rigged pacemaker. Saved, he gives the last piece: it began with Hale's daughter. \\\"Everything is singing to her.\\\" They sail for Port Anselm.\\n\\n**Chapter 4: Coda.**\\n- *Case 10.* Percy collapses in Immy's arms: \\\"It's finally quiet.\\\" He has been on Lull all along. First time Immy and Zhenya operate together. Waking: \\\"Your stitches are crooked.\\\" Immy cries laughing.\\n- *Case 11.* Across the city, every Anodyne patient begins to fail at once. Hale carries his daughter into St. Raz's himself, his voice finally breaking: \\\"I only wanted her not to hurt.\\\" Everyone is there: the Chief in a wheelchair in the gallery, Percy on the monitors, Odalys at the film, Quill passing instruments. The last operation.\\n- *Ending.* Silence. A beep. Clementine wakes screaming, then laughing: she can feel her hands. The city wakes in pain, and St. Raz's ER is the happiest, loudest, most furious place on earth (\\\"Doctor, I have a headache!\\\" \\\"Wonderful!\\\"). Hale surrenders, gently. Immy looks at her hands. Quill: \\\"They've stopped shaking, Doctor.\\\" She looks again. \\\"No, they haven't.\\\" \\\"Good.\\\" Credits. After the credits, in Case Files, a new blank folder appears with a chart that reads *Incoming*, leaving the door open for more game without being a stub: it simply says \\\"Next shift starts at seven. Get some sleep, Doctor.\\\"\\n\\n**Barks.** Each case has lines for phase enter, idle hint, slip, low vitals, phase done. A shared pool of at least 40 Quill lines by situation, so play never repeats fast. Barks never pause play. Sokolova's scenes give barks to Quill or Immy as the scene suits.\\n600→\\n---\\n\\n## 11. The ward\\n\\nBetween cases the player walks **Ward 3** (Chapters 1, 2 and 4) or the **ship's ward** (Chapter 3, a smaller map with a swinging lamp). This second perspective makes the world real: the people you saved are in the beds.\\n\\n- `threequarter` view, `E.TileMap` from text rows, `E.Body`, `E.Humanoid` in scrubs at `size: 1.3`, E.Story for talk, lights on: fluorescent panels, a window wall with rain, a warm desk lamp. Start from `kits/adventure.js` for the movement and talk loop.\\n- **People:** saved patients appear in beds after their case, each with new lines per chapter (Agnes's grandchildren bring begonias; Slide practices with a mute). Odalys at her lightbox, Percy at the vending machine, Quill knitting, the Chief's door.\\n- **Input:** stick or WASD walks. ✕ or E talks when near. **Hover moves the focus to a person or door with an outline and a name, and clicking walks there** (`game.mouseGround()`, `E.FlowField`) and talks.\\n610→- **Theatre door:** a glowing NEXT CASE sign, at most 8 tiles from where you arrive, so the ward is never a chore. It's an optional breather.\\n- **Saves:** autosave on arrival, `menu: { saves: true }`. The pause menu's Save row is on by default, so keep `game.saves.canSave` true here and false in every other scene.\\n- **Small reward:** talking to everyone before the next case starts it with +10 Steady (\\\"Morale,\\\" Quill says, as if it were a diagnosis).\\n\\n---\\n\\n## 12. Multiplayer: Grand Rounds\\n\\nOne case for 1 to 4 surgeons on one patient, each with their own cursor, wheel and glove color. The host runs the world. Team result, individual standings. About 4 minutes. It plays **the same on one couch and over the Hub.**\\n\\n620→### 12.1 The case\\n\\nA ferry disaster, mass casualty. Scales with N players:\\n1. **Triage:** 3N bleeders and tears, pools everywhere.\\n2. **Swarm:** Staccato, N nests, 4N beads at once.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/PLAN.md\",\"offset\":425,\"limit\":200,\"raw_output\":\"## 9. The cases\\n\\nA first clear runs about an hour on Resident: eleven cases of 3 to 5 minutes each, plus story and ward. Numbers are Resident defaults, to be balanced with the bot and by hand. Each case's data: patient, doctor, site, clock, vitals, drain, par, phases, barks, story nodes. All text in sections 9 and 10 is direction: write the finished lines yourself in that voice.\\n\\n### 9.1 The Lightbox (Second Opinion)\\n\\nBefore Cases 2, 4 and 10. The chart carries someone's **first opinion**. On the lightbox is the film: procedural X-ray art (ribs, spine or skull in pale polygons, soft-tissue haze, noise, one anomaly). Odalys chats. Point and press to mark what's really wrong (within 14 u; three tries; no fail state).\\n\\n- Right: \\\"Second opinion confirmed.\\\" +20 s and +20 Steady, and a marker on the op's field.\\n- Wrong: -10 s, a Percy smirk, and try again.\\n\\nIt is short (20 to 40 s), it teaches pointing, and it is the source's subtitle turned into a mechanic.\\n\\n### 9.2 Chapter 1: First Incision\\n\\n**Case 1, Glasshouse** (Dr. Vale, forearm; clock 180, vitals 80, drain .1). *New: cursor, wheel, trigger, four tools, grades.* Tutorial freezes on.\\n1. Pull the glass: 4 shards.\\n2. Clean the cuts: 3 lacerations, Salve.\\n3. Close: 1 wound, 4 stitches.\\n4. Give her a boost: a scripted dip to 40, Syringe to the IV. Dressing.\\n\\n**Case 2, Low Brass** (Vale, abdomen; 210, 70, .2). *New: Lightbox, Scalpel, Suction, Cautery, excision.* First opinion: Percy's \\\"Hernia. Obviously.\\\"\\n1. Open: 60 u guide.\\n2. Clear the field: 2 pools, 1 bleeder.\\n3. Burn the polyps: 5.\\n4. Take the mass: ring cut, lift. Underneath, a trombone spit-valve cork swallowed decades ago, which comes out with Forceps. Quill: \\\"I'll label it.\\\"\\n5. Close: 6 stitches, Salve.\\n\\n**Case 3, Crane Nine** (Vale, abdomen; 150, 55, .5). *New: triage, Code Blue, Long Breath.* The harbor crane has collapsed, and the Chief is away.\\n1. Stop the bleeding: 3 artery tears, bleeders, pools everywhere.\\n2. Shrapnel: 5 fragments, 2 under pools.\\n3. He's crashing: vitals ramp to 0, the guaranteed first Code Blue. On the revive the world goes quiet, rain hangs in the theatre window on the cutaway, and the prompt for Long Breath appears: six ruptures in a ring to seal within 12 s.\\n4. Close.\\n\\n### 9.3 Chapter 2: The Quiet Ones\\n\\n**Case 4, The Whistling Man** (Vale, flank; 200, 75, .25). *New: Sonar, barbed extraction, first strain.* Lightbox: the chart says superficial, and the film shows something moving.\\n1. Free the gaff: 2 relief cuts, a long axis pull.\\n2. Something moved: Sonar, 2 hidden nests.\\n3. Staccato.\\n4. Repair: 6 bites with Salve, Suture the gaff wound.\\n\\n**Case 5, Slur** (Vale, wrist with tendons and a gold nerve line; 220, 70, .2). *New: Legato, fine mode, no-touch anatomy, the clamp hand-off.*\\n1. Find it with Sonar.\\n2. Intercept at the slur marks.\\n3. The long pull with barbs.\\n4. It split.\\n5. Repair: Salve the track, 5 fine stitches.\\n\\n**Case 6, Bedside Manner** (Vale, heart; 240, 60, .35). *New: the beating heart, timing to the beat, cursor tremor, first boss.* The patient is the Chief.\\n1. Open: long sternal guide, Suction.\\n2. Tremolo.\\n3. Mend: a graft along the vessel, where stitches only land between beats. Salve.\\n\\n### 9.4 Chapter 3: Second Look\\n\\n**Case 7, Force Nine** (Dr. Sokolova, abdomen on the hospital ship; 170, 60, .35). *New: Second Look, the ship's roll, blackout.* `tilt` drifts pools at up to 25 u/s, and loose objects slide. The lamp sways: pass a moving `light` to the painter, so highlights roll around the field.\\n1. Winch damage: 4 fragments, 2 artery tears. At about 25 s a scripted lurch forces a slip. \\\"No. Again.\\\" Prompt: △. The ghost shows the lurch, and now you wait it out.\\n2. Blackout: the power fails, `dim` and a small `spot` follow the cursor. Find and seal 3 hidden bleeders by Sonar's lens alone.\\n3. Close on the roll: 8 stitches whose points shift ±6 u.\\n\\n**Case 8, From the Top** (Sokolova, abdomen; 210, 65, .3). *New: Da Capo, planning with ghosts.* The patient is Sister Perpetua.\\n1. Open, clear.\\n2. Da Capo, round 1.\\n3. Round 2.\\n4. Close.\\n\\n**Case 9, Dead Man's Rhythm** (Sokolova, chest wall with an implant; 200, 70, .25). *New: a device instead of a disease.* The patient is a whistleblower, whose pacemaker has been rigged to detonate if his heart stops or the can is forced. Sokolova: \\\"We are doctors.\\\" Quill: \\\"I'll fetch the other forceps.\\\" Vitals under 25 or clock at 0 sets it off: the ship goes, and you retry from the last checkpoint.\\n1. Expose the can: guide, Suction.\\n2. Four screws: Forceps turn, circling the stick or mouse three times per screw.\\n3. Read the board: the patient's halting instructions name a wire order, but Sonar shows the board differs. A real second opinion. Wires are marked ▲ ● ■, never by color alone.\\n4. Cautery solders a bypass lead, then Scalpel slashes the wires in the true order. A wrong wire: vitals -30, clock -30.\\n5. Lift it with Forceps at a very low tension limit while the ship rolls.\\n6. Close.\\n\\n### 9.5 Chapter 4: Coda\\n\\n**Case 10, Eloquent Cortex** (Vale and Sokolova, brain; 240, 60, .3). *New: Consult.* Lightbox: Percy's chart on himself, in his own hand, says migraine.\\n1. Open: curved scalp guide, Suction, Sokolova's hands.\\n2. Fermata, stage 1. Prompt to Consult when the first eye opens: Vale's Long Breath lands the window, then back to Sokolova when a slip needs undoing.\\n3. Stage 2: Sonar for the eye, two Legato slivers.\\n4. Stage 3: the gentle pull.\\n5. Close: 6 fine stitches, Salve.\\n\\n**Case 11, Last Note** (both, mediastinum; 420, 70, .3, with +120 s at each new movement). All tools, both gifts, Consult free.\\n1. Open: the long sternal guide again, Suction, with bleeders already running.\\n2. The Cantor's four movements (section 8), each a checkpoint.\\n3. The dressing, with no music at all.\\n\\n### 9.6 Outside the story\\n\\n**Skills Lab** in Case Files: a sandbox with no clock and locked vitals, respawning one of everything unlocked so far. It reuses the op scene. Quill: \\\"This is a pig's trotter. It has signed the waiver.\\\"\\n\\n**Grand Rounds:** section 12.\\n\\n---\\n\\n## 10. Story bible\\n\\n### World\\n\\n**Port Anselm**, a rain-soaked North Atlantic harbor city, a few years from now. Gulls, foghorns, cranes. **St. Erasmus Harbor Hospital**, \\\"St. Raz's\\\" to the staff, is old, underfunded and proud, and its gleaming new east wing is paid for by the **Anodyne Foundation**, whose billboards say A LIFE WITHOUT PAIN. Its product is **Lull**, a miracle analgesic that really works. Its secret is HUSH.\\n\\n**Theme.** Pain is information. Pain means you're still here. A doctor's job is to listen to it, not abolish it. Motto among the staff who know: \\\"Don't let it go quiet.\\\"\\n\\n**The Steady.** An old theatre word, never said aloud in the lift. Surgeons who have it stretch a moment or take it back. Quill has passed instruments to three of them.\\n\\n### Cast\\n\\nPronouns as listed. Portraits per Appendix C.\\n\\n| Character | Role | Voice and manner | Look |\\n|---|---|---|---|\\n| **Dr. Imogen \\\"Immy\\\" Vale** (she), 26 | Second-year resident, first protagonist. Long Breath | Talks too fast, apologizes to unconscious patients, sure she's a fraud in clogs. Grows into quiet courage | Copper hair, freckles, teal cap and scrubs, lucky pen |\\n| **Bartholomew Quill** (he), 58 | Scrub nurse, Theatre 3, 31 years. The player's constant companion | Deadpan, unhurried, calls everyone \\\"Doctor\\\" in forty intonations. Knits. Ex-merchant navy | Grey moustache, blue scrubs, mask, heavy brows |\\n| **Dr. Marguerite Oyelaran** (she), 61 | Chief of Surgery | Dry, exacting, proud. Took the Foundation's money to keep the doors open, and takes Lull for her hands | Dark skin, white crop, gold glasses, white coat, cane |\\n| **Dr. Yevgenia \\\"Zhenya\\\" Sokolova** (she), 67 | Surgeon of the hospital ship *Samaritan's Wake*, second protagonist. Second Look | Gleeful, salty, ruthless with sentiment, pipe never lit. \\\"At my age, dear, everything happens twice.\\\" Unfinished business with Quill | White hair, face scar, olive fatigues, red headband |\\n| **Dr. Percival Whitlock** (he), 29 | Fellow resident, rival, author of wrong first opinions | Smug, handsome, terrified. Secretly on Lull to keep up | Perfect hair, pristine coat |\\n| **Odalys Ferreira** (she), 31 | Night radiology tech, runs the Lightbox | Excitable, conspiracy-minded, always right, always eating | Curls, oversized glasses, cardigan |\\n| **Dr. Lucian Hale** (he), 55 | Founder of the Anodyne Foundation. Beloved TV doctor | Soft, warm, perfect bedside voice. Never raises it. Means every word | Silver hair, tailored suit, kind eyes |\\n| **Clementine Hale** (she), 19 | His daughter, patient zero | Serene, smiling, has felt nothing since she was nine | Pale, cropped hair, hospital gown, faint teal under the skin |\\n\\n### How it sounds\\n\\nMelodrama played straight, as in the source: earnest speeches, jargon in bursts, cliffhanger reveals, sudden collapses, a villain who explains himself. Humor comes from character and never winks at the camera.\\n\\nRules:\\n- A line fits two rows of the dialog box, at most 90 characters. A scene runs 6 to 14 lines.\\n- Jargon in bursts, translated by someone immediately.\\n- Every patient gets one human detail.\\n- End scenes on a turn or a big sincere line.\\n- Tone choices now and then (Quill reacts; the story doesn't branch).\\n- American spelling, except \\\"theatre\\\", which is what the staff call the operating room.\\n\\nSamples, for pitch. Use these and write hundreds more:\\n\\n- **Quill:** \\\"That was the liver, Doctor. We keep that one.\\\"\\n- **Quill:** \\\"Pulse forty. I mention it only in passing.\\\"\\n- **Quill:** \\\"I have seen worse. He was a plumber.\\\"\\n- **Quill:** \\\"Breathe, Doctor. One of you should.\\\"\\n- **Quill, after a Textbook stitch:** \\\"...Hm.\\\"\\n- **Vale:** \\\"Okay okay okay. Sorry! Sorry. She can't hear me. Sorry.\\\"\\n- **Vale:** \\\"My hands won't stop shaking.\\\" **Quill:** \\\"They stop around year thirty, Doctor. I'm told.\\\"\\n- **Oyelaran:** \\\"A surgeon who argues with a chart. How tiresome. Do it again.\\\"\\n- **Sokolova:** \\\"No. Again.\\\"\\n- **Sokolova:** \\\"In the navy we did this with a spoon.\\\"\\n- **Sokolova:** \\\"You're late, Bartholomew.\\\" **Quill:** \\\"Thirty-one years, Yevgenia.\\\"\\n- **Percy:** \\\"Hernia. Obviously.\\\"\\n- **Odalys:** \\\"Okay so don't freak out, but your X-ray is humming.\\\"\\n- **Hale:** \\\"Pain is the last disease, Doctor. I only ask you to stop defending it.\\\"\\n- **Ilse, waking:** \\\"It hurts. Oh, it hurts. Thank you.\\\"\\n\\n### Beats\\n\\n**Chapter 1: First Incision.**\\n- *Case 1.* Night shift. Immy's first solo: **Agnes Pellow**, 74, fell through her greenhouse roof, and wants the glass kept for the grandchildren. Quill walks Immy through it. After: her hands shake.\\n- *Case 2.* **Desmond \\\"Slide\\\" Achebe**, trombonist at the Harbor Jazz Hall. Percy's chart says hernia. Odalys's film says otherwise. Immy argues. Inside: a mass, and a cork he swallowed in 1987. \\\"I wondered where that went.\\\" The Chief notices her.\\n- *Case 3.* Crane Nine falls. **Big Tam Rennie**, foreman, arrives on a gurney. Chief away, Immy alone. He dies on the table, then doesn't, and something happens to the time. After, Quill: \\\"How long did that feel, Doctor?\\\" \\\"A minute?\\\" \\\"Eleven seconds. We don't discuss it in the lift.\\\" The Chief, at last: \\\"There is an old word in theatre.\\\"\\n\\n**Chapter 2: The Quiet Ones.**\\n- *Case 4.* **Captain Ned Harrow** walks into the ER whistling with a gaff through his side, wants to get back to sea, feels nothing. Inside, something hops. Immy hears singing no one else hears. Quill, for the first time, says nothing. Odalys: \\\"It's not in any database.\\\" The Chief: not a word until she has spoken to the Foundation.\\n- *Case 5.* **Ilse Brandt**, 19, conservatory violinist, numb left hand, never happier. She doesn't want treatment. Legato. She wakes crying with pain, and thanks Immy. Odalys finds the pattern: every case went to an Anodyne clinic. Percy: \\\"You've been up for forty hours.\\\"\\n- *Case 6.* At the Foundation's gala in the new wing, with Hale speaking and chandeliers overhead, the Chief collapses, cane rolling across the floor. She has been hiding it. Immy operates on her mentor. Waking, the Chief confesses the bargain, names the disease, and gives Immy a name: Sokolova, on the *Samaritan's Wake*. Quill drops a tray for the first time in 31 years. On the ward TV, Hale: \\\"I hear Dr. Oyelaran is recovering. Wonderful.\\\" End of chapter.\\n\\n**Chapter 3: Second Look.** The player becomes Zhenya.\\n- *Case 7.* A North Atlantic storm. Immy and Quill arrive by launch as a winch crushes deckhand **Yusuf Demir**. Zhenya operates with a pipe in her teeth and shows Immy what the Steady can also do. Immy watches something un-happen.\\n- *Case 8.* **Sister Perpetua** runs the seamen's hospice, and brings aboard patients who've never been happier. Her strain regrows when cut. Afterward the hard argument, played fairly: \\\"You'd give them back their pain?\\\" Zhenya: \\\"I'd give them back their choice.\\\"\\n- *Case 9.* **Dr. Hollis Crane**, a Foundation researcher, comes aboard to confess, with a rigged pacemaker. Saved, he gives the last piece: it began with Hale's daughter. \\\"Everything is singing to her.\\\" They sail for Port Anselm.\\n\\n**Chapter 4: Coda.**\\n- *Case 10.* Percy collapses in Immy's arms: \\\"It's finally quiet.\\\" He has been on Lull all along. First time Immy and Zhenya operate together. Waking: \\\"Your stitches are crooked.\\\" Immy cries laughing.\\n- *Case 11.* Across the city, every Anodyne patient begins to fail at once. Hale carries his daughter into St. Raz's himself, his voice finally breaking: \\\"I only wanted her not to hurt.\\\" Everyone is there: the Chief in a wheelchair in the gallery, Percy on the monitors, Odalys at the film, Quill passing instruments. The last operation.\\n- *Ending.* Silence. A beep. Clementine wakes screaming, then laughing: she can feel her hands. The city wakes in pain, and St. Raz's ER is the happiest, loudest, most furious place on earth (\\\"Doctor, I have a headache!\\\" \\\"Wonderful!\\\"). Hale surrenders, gently. Immy looks at her hands. Quill: \\\"They've stopped shaking, Doctor.\\\" She looks again. \\\"No, they haven't.\\\" \\\"Good.\\\" Credits. After the credits, in Case Files, a new blank folder appears with a chart that reads *Incoming*, leaving the door open for more game without being a stub: it simply says \\\"Next shift starts at seven. Get some sleep, Doctor.\\\"\\n\\n**Barks.** Each case has lines for phase enter, idle hint, slip, low vitals, phase done. A shared pool of at least 40 Quill lines by situation, so play never repeats fast. Barks never pause play. Sokolova's scenes give barks to Quill or Immy as the scene suits.\\n\\n---\\n\\n## 11. The ward\\n\\nBetween cases the player walks **Ward 3** (Chapters 1, 2 and 4) or the **ship's ward** (Chapter 3, a smaller map with a swinging lamp). This second perspective makes the world real: the people you saved are in the beds.\\n\\n- `threequarter` view, `E.TileMap` from text rows, `E.Body`, `E.Humanoid` in scrubs at `size: 1.3`, E.Story for talk, lights on: fluorescent panels, a window wall with rain, a warm desk lamp. Start from `kits/adventure.js` for the movement and talk loop.\\n- **People:** saved patients appear in beds after their case, each with new lines per chapter (Agnes's grandchildren bring begonias; Slide practices with a mute). Odalys at her lightbox, Percy at the vending machine, Quill knitting, the Chief's door.\\n- **Input:** stick or WASD walks. ✕ or E talks when near. **Hover moves the focus to a person or door with an outline and a name, and clicking walks there** (`game.mouseGround()`, `E.FlowField`) and talks.\\n- **Theatre door:** a glowing NEXT CASE sign, at most 8 tiles from where you arrive, so the ward is never a chore. It's an optional breather.\\n- **Saves:** autosave on arrival, `menu: { saves: true }`. The pause menu's Save row is on by default, so keep `game.saves.canSave` true here and false in every other scene.\\n- **Small reward:** talking to everyone before the next case starts it with +10 Steady (\\\"Morale,\\\" Quill says, as if it were a diagnosis).\\n\\n---\\n\\n## 12. Multiplayer: Grand Rounds\\n\\nOne case for 1 to 4 surgeons on one patient, each with their own cursor, wheel and glove color. The host runs the world. Team result, individual standings. About 4 minutes. It plays **the same on one couch and over the Hub.**\\n\\n### 12.1 The case\\n\\nA ferry disaster, mass casualty. Scales with N players:\\n1. **Triage:** 3N bleeders and tears, pools everywhere.\\n2. **Swarm:** Staccato, N nests, 4N beads at once.\\n\",\"total_lines\":1339}}","is_error":false},{"type":"tool_result","tool_use_id":"call-bc633dc4-70ae-43af-9d9a-395139a2a91a-12","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"616→## 12. Multiplayer: Grand Rounds\\n\\nOne case for 1 to 4 surgeons on one patient, each with their own cursor, wheel and glove color. The host runs the world. Team result, individual standings. About 4 minutes. It plays **the same on one couch and over the Hub.**\\n\\n620→### 12.1 The case\\n\\nA ferry disaster, mass casualty. Scales with N players:\\n1. **Triage:** 3N bleeders and tears, pools everywhere.\\n2. **Swarm:** Staccato, N nests, 4N beads at once.\\n3. **One holds, one cuts:** a `retractorHandle`: one player holds it with Forceps to open a window on a target another player cuts. Alone, Quill holds it at half the window, so solo still works.\\n4. **Choir:** a small three-lobed Da Capo.\\n5. **Close:** N wounds, then the dressing together.\\n\\nRules:\\n630→- Vitals and clock are shared. Steady is shared, and any player can call Long Breath for everyone. No Second Look in this mode.\\n- Each player's score sums their actions by grade, with slips subtracted. Standings by score. `won` is whether the patient lived.\\n- **Awards:** Steadiest Hand (Textbook rate), Needlework (stitches), Hoover (volume suctioned), Firebrand (burns).\\n- Seat colors follow the Hub's: `#e8443a`, `#3b82f6`, `#22c55e`, `#f5b700`.\\n\\n### 12.2 On its own\\n\\nThe `lobby` scene: four seats. Player 1 is already in. `game.allowJoin({ max: 4, onJoin })` lets a second pad join with Start or the keyboard's right half with 2. **Add AI colleague** fills a seat with a bot, so a solo player can see co-op and the attract mode can show it. The mouse belongs to player 1. One shared screen, no split. Each player's wheel appears around their own cursor.\\n\\n### 12.3 In a Hub session\\n640→\\nFollow the protocol page and Appendix D. Exact behavior:\\n- `session.js`, unmodified, is the first script in `<head>`, right after `<meta charset>`. Tags: `hub:session` 1, `hub:session-players` 1-4, `hub:session-mode` shared-world, `hub:session-minutes` 5, a goal of at most 60 characters, controls of at most 80.\\n- `AIHub.active`: no title, menus or attract. `await AIHub.connect({ mode: 'shared-world', seats: [1, 4], card: true })` early, then `AIHub.ready()` with no key press when the world is built. `null` means no Hub: run as usual.\\n- **Your own card** (`card: true`): the theatre's whiteboard showing the game's name, each player in their color with a tick when ready, how to win, this player's controls from the device they used last, and the time left from the `card` event. Enter, ✕ or a tap answers `ready`. △ or M, named on the card, answers `more`. No menus, no settings, no choices. Use `AIHub.rng('card')` for anything random.\\n- `start`: count down on the card until `AIHub.time() >= 0`, then play.\\n- `Math.random` is not seeded in shared world, and the sim never uses it anyway: the host seeds from `AIHub.rng('sim')`.\\n- `leave`: drop that cursor, and rescale nothing mid-phase.\\n- `time-up`: the host calls `finish` at once, with `won: false` unless the patient is already closed. Patient closed or lost: the host sends a last reliable state, then `AIHub.finish({ standings, scores, won, stats, awards })`.\\n- `end`: no more input, no more sends, all sound off.\\n650→- `AIHub.server`: the host's copy has no player, camera or input. It runs the world and draws nothing.\\n- A touch-only copy can answer the card by tap, then shows the notice and watches: no touch controls in a session either, and no `AIHub.fail`.\\n- Rules: no chat, emotes or custom names, including pings. Names come from the Hub and are never inserted as HTML. No `alert`, `confirm`, `prompt`, `window.open`, navigation, sockets or `fetch`. In a session the pause menu has only Resume, Settings, Controls, Full screen (fact 15): no Quit, Restart or Dev Mode, and the world keeps running under it. The engine already ignores Options while Create is held.\\n\\n### 12.4 The network shape\\n\\nThe sim runs only on the host. Other copies keep a **mirror** with the same shape as the state, so the same draw code runs everywhere. Each copy moves its own cursor at once and never waits for the network.\\n\\n| Message | Direction | Rate and kind | Contents |\\n|---|---|---|---|\\n660→| `i` | Client → host | 15/s, unreliable | Sequence, cursor, tool, trigger, flags, up to 6 recent cursor samples so a stroke traces correctly at 150 ms latency |\\n| `p` | Client → host | Reliable, on press | Gift pressed |\\n| `s` | Host → all | 12/s, unreliable | Sequence, clock ms, vitals, phase, Steady, players, objects as short arrays. At most 1,100 bytes: rotate objects if needed, players always |\\n| `e` | Host → all | 4/s, reliable, batched | Presentation events (sound, popup, particles) and phase changes |\\n| `over` | Host → all | Once, reliable | Final state |\\n\\nThat stays within the limit of 20 messages a second per copy, bursts to 40. An unreliable message over about 1,200 bytes is lost whole if any packet drops. Drop old `s` by sequence number. Draw other players' cursors eased toward the last report.\\n\\n---\\n\\n670→## 13. Attract mode\\n\\nAfter 10 seconds with no input on `title`, `menu`, `casefiles` or `lobby`, start the demo; not on reading screens (About, Settings, Controls) or anywhere else. Track idleness with `game.hook('input', ...)`: any pressed action, held code, mouse move (`input.mouse.t`), click, or stick past .25.\\n\\n**A looping 2.5 minute reel, AI-played with cheats allowed** (locked vitals, instant wheel, perfect aim), showing as much as possible:\\n1. A story beat with portraits, auto-advanced.\\n2. Case 1 for 15 s: wheel flicks, Forceps, Suture.\\n3. Case 3: pools, Suction, Cautery, Code Blue, Long Breath.\\n4. Case 6: Tremolo on the beating heart.\\n5. Case 7: Second Look's rewind and ghosts, the tilt.\\n680→6. Grand Rounds with four bot surgeons.\\n7. The Cantor's Development.\\n8. A Results stamp, then the title for 8 s, then again.\\n\\nEach segment runs the real scene with an attract flag, so the reel is always the real game. A DEMO ribbon and \\\"Press any button\\\" stay on screen. **Any input exits to `title`, and that press does nothing else** (`input.consumeAll()`). It never saves. The bot is the same one the tests use (19.4), driving real input.\\n\\n**Touch-only devices:** no touch controls, the notice and Settings button per Appendix E, and the attract reel runs behind the notice. A tap returns to the title with the notice, and 10 s later the reel resumes. Tall screens just show more drape.\\n\\n---\\n\\n690→## 14. Dev mode\\n\\n**Reached from the pause menu's Dev Mode item, on any pausable scene.** It closes the menu and docks a panel on the left third, with the game running behind it, so slider changes show live. Drawn in the game's pixel UI at 10-foot size, at most 8 rows a page. D-pad or arrows move, ←/→ adjust (hold to speed up), mouse hover and drag work, ✕ or Enter toggles, L1 and R1 or Q and E change tab, ○ closes. Right stick, R2 and the mouse keep working on the field, so you can test as you tune. Hidden in Hub sessions.\\n\\n| Tab | Contents |\\n|---|---|\\n| **Tuning** | Live sliders, grouped in pages. **Patient:** drain x, slip damage x, healing x, syringe dose, clock x. **Hands:** cursor speed, fine factor, stick curve, assist, magnet radius, grade tolerance x. **Strains:** speed x, health x, spawn rate x, damage x, Staccato beat. **Gift:** charge x, Long Breath drain, Long Breath time factor, Second Look seconds. **Fluids:** bleed x, suction rate, cautery heat. **Reset to defaults** per page and for everything. Values persist under a dev key in `E.store`; a default mark shows on each slider |\\n| **Cheats** | Lock vitals, freeze clock, infinite Steady, one-hit strains, reveal hidden, show hit radii, autosurgeon on or off (the bot takes over), slow motion (`game.timeScale` .25, .5, 1, 2) |\\n| **Jump** | Any case, any phase. Force win, force lost, trigger Code Blue, spawn any strain or object at the cursor, jump to any story node, unlock all, clear save |\\n| **Info** | Phase, object counts, seed, state hash, last events, and Copy tuning (to clipboard and console) so good values can go back into `TUNING` |\\n700→\\nAny case played with changed tuning or cheats shows a DEV tag in Results and does not save a rank.\\n\\n---\\n\\n## 15. UI and the 10-foot rules\",\"content_concise\":\"616→## 12. Multiplayer: Grand Rounds\\n\\nOne case for 1 to 4 surgeons on one patient, each with their own cursor, wheel and glove color. The host runs the world. Team result, individual standings. About 4 minutes. It plays **the same on one couch and over the Hub.**\\n\\n620→### 12.1 The case\\n\\nA ferry disaster, mass casualty. Scales with N players:\\n1. **Triage:** 3N bleeders and tears, pools everywhere.\\n2. **Swarm:** Staccato, N nests, 4N beads at once.\\n3. **One holds, one cuts:** a `retractorHandle`: one player holds it with Forceps to open a window on a target another player cuts. Alone, Quill holds it at half the window, so solo still works.\\n4. **Choir:** a small three-lobed Da Capo.\\n5. **Close:** N wounds, then the dressing together.\\n\\nRules:\\n630→- Vitals and clock are shared. Steady is shared, and any player can call Long Breath for everyone. No Second Look in this mode.\\n- Each player's score sums their actions by grade, with slips subtracted. Standings by score. `won` is whether the patient lived.\\n- **Awards:** Steadiest Hand (Textbook rate), Needlework (stitches), Hoover (volume suctioned), Firebrand (burns).\\n- Seat colors follow the Hub's: `#e8443a`, `#3b82f6`, `#22c55e`, `#f5b700`.\\n\\n### 12.2 On its own\\n\\nThe `lobby` scene: four seats. Player 1 is already in. `game.allowJoin({ max: 4, onJoin })` lets a second pad join with Start or the keyboard's right half with 2. **Add AI colleague** fills a seat with a bot, so a solo player can see co-op and the attract mode can show it. The mouse belongs to player 1. One shared screen, no split. Each player's wheel appears around their own cursor.\\n\\n### 12.3 In a Hub session\\n640→\\nFollow the protocol page and Appendix D. Exact behavior:\\n- `session.js`, unmodified, is the first script in `<head>`, right after `<meta charset>`. Tags: `hub:session` 1, `hub:session-players` 1-4, `hub:session-mode` shared-world, `hub:session-minutes` 5, a goal of at most 60 characters, controls of at most 80.\\n- `AIHub.active`: no title, menus or attract. `await AIHub.connect({ mode: 'shared-world', seats: [1, 4], card: true })` early, then `AIHub.ready()` with no key press when the world is built. `null` means no Hub: run as usual.\\n- **Your own card** (`card: true`): the theatre's whiteboard showing the game's name, each player in their color with a tick when ready, how to win, this player's controls from the device they used last, and the time left from the `card` event. Enter, ✕ or a tap answers `ready`. △ or M, named on the card, answers `more`. No menus, no settings, no choices. Use `AIHub.rng('card')` for anything random.\\n- `start`: count down on the card until `AIHub.time() >= 0`, then play.\\n- `Math.random` is not seeded in shared world, and the sim never uses it anyway: the host seeds from `AIHub.rng('sim')`.\\n- `leave`: drop that cursor, and rescale nothing mid-phase.\\n- `time-up`: the host calls `finish` at once, with `won: false` unless the patient is already closed. Patient closed or lost: the host sends a last reliable state, then `AIHub.finish({ standings, scores, won, stats, awards })`.\\n- `end`: no more input, no more sends, all sound off.\\n650→- `AIHub.server`: the host's copy has no player, camera or input. It runs the world and draws nothing.\\n- A touch-only copy can answer the card by tap, then shows the notice and watches: no touch controls in a session either, and no `AIHub.fail`.\\n- Rules: no chat, emotes or custom names, including pings. Names come from the Hub and are never inserted as HTML. No `alert`, `confirm`, `prompt`, `window.open`, navigation, sockets or `fetch`. In a session the pause menu has only Resume, Settings, Controls, Full screen (fact 15): no Quit, Restart or Dev Mode, and the world keeps running under it. The engine already ignores Options while Create is held.\\n\\n### 12.4 The network shape\\n\\nThe sim runs only on the host. Other copies keep a **mirror** with the same shape as the state, so the same draw code runs everywhere. Each copy moves its own cursor at once and never waits for the network.\\n\\n| Message | Direction | Rate and kind | Contents |\\n|---|---|---|---|\\n660→| `i` | Client → host | 15/s, unreliable | Sequence, cursor, tool, trigger, flags, up to 6 recent cursor samples so a stroke traces correctly at 150 ms latency |\\n| `p` | Client → host | Reliable, on press | Gift pressed |\\n| `s` | Host → all | 12/s, unreliable | Sequence, clock ms, vitals, phase, Steady, players, objects as short arrays. At most 1,100 bytes: rotate objects if needed, players always |\\n| `e` | Host → all | 4/s, reliable, batched | Presentation events (sound, popup, particles) and phase changes |\\n| `over` | Host → all | Once, reliable | Final state |\\n\\nThat stays within the limit of 20 messages a second per copy, bursts to 40. An unreliable message over about 1,200 bytes is lost whole if any packet drops. Drop old `s` by sequence number. Draw other players' cursors eased toward the last report.\\n\\n---\\n\\n670→## 13. Attract mode\\n\\nAfter 10 seconds with no input on `title`, `menu`, `casefiles` or `lobby`, start the demo; not on reading screens (About, Settings, Controls) or anywhere else. Track idleness with `game.hook('input', ...)`: any pressed action, held code, mouse move (`input.mouse.t`), click, or stick past .25.\\n\\n**A looping 2.5 minute reel, AI-played with cheats allowed** (locked vitals, instant wheel, perfect aim), showing as much as possible:\\n1. A story beat with portraits, auto-advanced.\\n2. Case 1 for 15 s: wheel flicks, Forceps, Suture.\\n3. Case 3: pools, Suction, Cautery, Code Blue, Long Breath.\\n4. Case 6: Tremolo on the beating heart.\\n5. Case 7: Second Look's rewind and ghosts, the tilt.\\n680→6. Grand Rounds with four bot surgeons.\\n7. The Cantor's Development.\\n8. A Results stamp, then the title for 8 s, then again.\\n\\nEach segment runs the real scene with an attract flag, so the reel is always the real game. A DEMO ribbon and \\\"Press any button\\\" stay on screen. **Any input exits to `title`, and that press does nothing else** (`input.consumeAll()`). It never saves. The bot is the same one the tests use (19.4), driving real input.\\n\\n**Touch-only devices:** no touch controls, the notice and Settings button per Appendix E, and the attract reel runs behind the notice. A tap returns to the title with the notice, and 10 s later the reel resumes. Tall screens just show more drape.\\n\\n---\\n\\n690→## 14. Dev mode\\n\\n**Reached from the pause menu's Dev Mode item, on any pausable scene.** It closes the menu and docks a panel on the left third, with the game running behind it, so slider changes show live. Drawn in the game's pixel UI at 10-foot size, at most 8 rows a page. D-pad or arrows move, ←/→ adjust (hold to speed up), mouse hover and drag work, ✕ or Enter toggles, L1 and R1 or Q and E change tab, ○ closes. Right stick, R2 and the mouse keep working on the field, so you can test as you tune. Hidden in Hub sessions.\\n\\n| Tab | Contents |\\n|---|---|\\n| **Tuning** | Live sliders, grouped in pages. **Patient:** drain x, slip damage x, healing x, syringe dose, clock x. **Hands:** cursor speed, fine factor, stick curve, assist, magnet radius, grade tolerance x. **Strains:** speed x, health x, spawn rate x, damage x, Staccato beat. **Gift:** charge x, Long Breath drain, Long Breath time factor, Second Look seconds. **Fluids:** bleed x, suction rate, cautery heat. **Reset to defaults** per page and for everything. Values persist under a dev key in `E.store`; a default mark shows on each slider |\\n| **Cheats** | Lock vitals, freeze clock, infinite Steady, one-hit strains, reveal hidden, show hit radii, autosurgeon on or off (the bot takes over), slow motion (`game.timeScale` .25, .5, 1, 2) |\\n| **Jump** | Any case, any phase. Force win, force lost, trigger Code Blue, spawn any strain or object at the cursor, jump to any story node, unlock all, clear save |\\n| **Info** | Phase, object counts, seed, state hash, last events, and Copy tuning (to clipboard and console) so good values can go back into `TUNING` |\\n700→\\nAny case played with changed tuning or cheats shows a DEV tag in Results and does not save a rank.\\n\\n---\\n\\n## 15. UI and the 10-foot rules\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/PLAN.md\",\"offset\":616,\"limit\":90,\"raw_output\":\"## 12. Multiplayer: Grand Rounds\\n\\nOne case for 1 to 4 surgeons on one patient, each with their own cursor, wheel and glove color. The host runs the world. Team result, individual standings. About 4 minutes. It plays **the same on one couch and over the Hub.**\\n\\n### 12.1 The case\\n\\nA ferry disaster, mass casualty. Scales with N players:\\n1. **Triage:** 3N bleeders and tears, pools everywhere.\\n2. **Swarm:** Staccato, N nests, 4N beads at once.\\n3. **One holds, one cuts:** a `retractorHandle`: one player holds it with Forceps to open a window on a target another player cuts. Alone, Quill holds it at half the window, so solo still works.\\n4. **Choir:** a small three-lobed Da Capo.\\n5. **Close:** N wounds, then the dressing together.\\n\\nRules:\\n- Vitals and clock are shared. Steady is shared, and any player can call Long Breath for everyone. No Second Look in this mode.\\n- Each player's score sums their actions by grade, with slips subtracted. Standings by score. `won` is whether the patient lived.\\n- **Awards:** Steadiest Hand (Textbook rate), Needlework (stitches), Hoover (volume suctioned), Firebrand (burns).\\n- Seat colors follow the Hub's: `#e8443a`, `#3b82f6`, `#22c55e`, `#f5b700`.\\n\\n### 12.2 On its own\\n\\nThe `lobby` scene: four seats. Player 1 is already in. `game.allowJoin({ max: 4, onJoin })` lets a second pad join with Start or the keyboard's right half with 2. **Add AI colleague** fills a seat with a bot, so a solo player can see co-op and the attract mode can show it. The mouse belongs to player 1. One shared screen, no split. Each player's wheel appears around their own cursor.\\n\\n### 12.3 In a Hub session\\n\\nFollow the protocol page and Appendix D. Exact behavior:\\n- `session.js`, unmodified, is the first script in `<head>`, right after `<meta charset>`. Tags: `hub:session` 1, `hub:session-players` 1-4, `hub:session-mode` shared-world, `hub:session-minutes` 5, a goal of at most 60 characters, controls of at most 80.\\n- `AIHub.active`: no title, menus or attract. `await AIHub.connect({ mode: 'shared-world', seats: [1, 4], card: true })` early, then `AIHub.ready()` with no key press when the world is built. `null` means no Hub: run as usual.\\n- **Your own card** (`card: true`): the theatre's whiteboard showing the game's name, each player in their color with a tick when ready, how to win, this player's controls from the device they used last, and the time left from the `card` event. Enter, ✕ or a tap answers `ready`. △ or M, named on the card, answers `more`. No menus, no settings, no choices. Use `AIHub.rng('card')` for anything random.\\n- `start`: count down on the card until `AIHub.time() >= 0`, then play.\\n- `Math.random` is not seeded in shared world, and the sim never uses it anyway: the host seeds from `AIHub.rng('sim')`.\\n- `leave`: drop that cursor, and rescale nothing mid-phase.\\n- `time-up`: the host calls `finish` at once, with `won: false` unless the patient is already closed. Patient closed or lost: the host sends a last reliable state, then `AIHub.finish({ standings, scores, won, stats, awards })`.\\n- `end`: no more input, no more sends, all sound off.\\n- `AIHub.server`: the host's copy has no player, camera or input. It runs the world and draws nothing.\\n- A touch-only copy can answer the card by tap, then shows the notice and watches: no touch controls in a session either, and no `AIHub.fail`.\\n- Rules: no chat, emotes or custom names, including pings. Names come from the Hub and are never inserted as HTML. No `alert`, `confirm`, `prompt`, `window.open`, navigation, sockets or `fetch`. In a session the pause menu has only Resume, Settings, Controls, Full screen (fact 15): no Quit, Restart or Dev Mode, and the world keeps running under it. The engine already ignores Options while Create is held.\\n\\n### 12.4 The network shape\\n\\nThe sim runs only on the host. Other copies keep a **mirror** with the same shape as the state, so the same draw code runs everywhere. Each copy moves its own cursor at once and never waits for the network.\\n\\n| Message | Direction | Rate and kind | Contents |\\n|---|---|---|---|\\n| `i` | Client → host | 15/s, unreliable | Sequence, cursor, tool, trigger, flags, up to 6 recent cursor samples so a stroke traces correctly at 150 ms latency |\\n| `p` | Client → host | Reliable, on press | Gift pressed |\\n| `s` | Host → all | 12/s, unreliable | Sequence, clock ms, vitals, phase, Steady, players, objects as short arrays. At most 1,100 bytes: rotate objects if needed, players always |\\n| `e` | Host → all | 4/s, reliable, batched | Presentation events (sound, popup, particles) and phase changes |\\n| `over` | Host → all | Once, reliable | Final state |\\n\\nThat stays within the limit of 20 messages a second per copy, bursts to 40. An unreliable message over about 1,200 bytes is lost whole if any packet drops. Drop old `s` by sequence number. Draw other players' cursors eased toward the last report.\\n\\n---\\n\\n## 13. Attract mode\\n\\nAfter 10 seconds with no input on `title`, `menu`, `casefiles` or `lobby`, start the demo; not on reading screens (About, Settings, Controls) or anywhere else. Track idleness with `game.hook('input', ...)`: any pressed action, held code, mouse move (`input.mouse.t`), click, or stick past .25.\\n\\n**A looping 2.5 minute reel, AI-played with cheats allowed** (locked vitals, instant wheel, perfect aim), showing as much as possible:\\n1. A story beat with portraits, auto-advanced.\\n2. Case 1 for 15 s: wheel flicks, Forceps, Suture.\\n3. Case 3: pools, Suction, Cautery, Code Blue, Long Breath.\\n4. Case 6: Tremolo on the beating heart.\\n5. Case 7: Second Look's rewind and ghosts, the tilt.\\n6. Grand Rounds with four bot surgeons.\\n7. The Cantor's Development.\\n8. A Results stamp, then the title for 8 s, then again.\\n\\nEach segment runs the real scene with an attract flag, so the reel is always the real game. A DEMO ribbon and \\\"Press any button\\\" stay on screen. **Any input exits to `title`, and that press does nothing else** (`input.consumeAll()`). It never saves. The bot is the same one the tests use (19.4), driving real input.\\n\\n**Touch-only devices:** no touch controls, the notice and Settings button per Appendix E, and the attract reel runs behind the notice. A tap returns to the title with the notice, and 10 s later the reel resumes. Tall screens just show more drape.\\n\\n---\\n\\n## 14. Dev mode\\n\\n**Reached from the pause menu's Dev Mode item, on any pausable scene.** It closes the menu and docks a panel on the left third, with the game running behind it, so slider changes show live. Drawn in the game's pixel UI at 10-foot size, at most 8 rows a page. D-pad or arrows move, ←/→ adjust (hold to speed up), mouse hover and drag work, ✕ or Enter toggles, L1 and R1 or Q and E change tab, ○ closes. Right stick, R2 and the mouse keep working on the field, so you can test as you tune. Hidden in Hub sessions.\\n\\n| Tab | Contents |\\n|---|---|\\n| **Tuning** | Live sliders, grouped in pages. **Patient:** drain x, slip damage x, healing x, syringe dose, clock x. **Hands:** cursor speed, fine factor, stick curve, assist, magnet radius, grade tolerance x. **Strains:** speed x, health x, spawn rate x, damage x, Staccato beat. **Gift:** charge x, Long Breath drain, Long Breath time factor, Second Look seconds. **Fluids:** bleed x, suction rate, cautery heat. **Reset to defaults** per page and for everything. Values persist under a dev key in `E.store`; a default mark shows on each slider |\\n| **Cheats** | Lock vitals, freeze clock, infinite Steady, one-hit strains, reveal hidden, show hit radii, autosurgeon on or off (the bot takes over), slow motion (`game.timeScale` .25, .5, 1, 2) |\\n| **Jump** | Any case, any phase. Force win, force lost, trigger Code Blue, spawn any strain or object at the cursor, jump to any story node, unlock all, clear save |\\n| **Info** | Phase, object counts, seed, state hash, last events, and Copy tuning (to clipboard and console) so good values can go back into `TUNING` |\\n\\nAny case played with changed tuning or cheats shows a DEV tag in Results and does not save a rank.\\n\\n---\\n\\n## 15. UI and the 10-foot rules\\n\",\"total_lines\":1339}}","is_error":false},{"type":"tool_result","tool_use_id":"call-bc633dc4-70ae-43af-9d9a-395139a2a91a-13","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"978→## 20. Testing\\n\\n980→As TASK.md says: headless tools first, scripts that play the game and check its state, including a scripted playthrough of the whole game; **one command that prints only failures and a one-line count**; rerun only after changing what it covers; screenshots only for what a script can't check; no subagents or workflows to debate, review, judge or audit.\\n\\n**`node tests/run.mjs`** (add `--fast` to skip the browser parts). Load engine and sources with `node:vm` as `game/test.mjs` does, giving the context `console`, `performance` and `window` (itself), drive with `game.advance`, `input.tap`, `input.hold`, `input.feed`, read `game.debug.snapshot()`. Output, and nothing else: failures, then e.g. `412 checks, 0 failed`.\\n\\n**Headless:**\\n- Every tool: right gesture finishes the object; each wrong gesture gives the specified slip, tear or lock.\\n- Cursor: full stick for 1 s moves 300 u or more; with Fine, 120 u or less; magnet settles on a target; guide-follow holds a line at full assist.\\n- Wheel: each of the eight stick directions picks its tool within 100 ms; 1 to 8 and mouse-hold picking do the same.\\n- Vitals and clock: drains add up as table 7 says; Code Blue timing window; lost path; phase checkpoint restores exactly.\\n- Grades and ranks: known inputs give the expected grade and rank.\\n990→- Every strain's stages reach their ends, and the failure branches (Legato snapping, Da Capo repeat, Cantor's rewind).\\n- Long Breath: world time at .25, hands at 1.\\n- Second Look: restored `S` deep-equals the old snapshot, and the ghost list is filled.\\n- Determinism: same seed and inputs give the same hash twice, and again with `draw: true` (draw changes nothing, no draw errors).\\n- Content validator: every id resolves, every story node reachable, every portrait expression exists.\\n- `TODO|FIXME|placeholder|stub` grep over `src/`.\\n- **Full playthrough:** New Game → every story scene (auto) → ward → every case, bot with cheats off at Resident → ending → credits → title. Checks the save, ranks, and unlocks. This is your most valuable test. Keep it fast by not drawing, then draw one case for draw errors.\\n- **Attract:** title idle 10 s starts it; each device's input exits to the title; the press does nothing else; it loops at least twice with no errors. Not on reading screens.\\n- **Dev mode:** every slider changes behavior live, Reset restores `TUNING`, each cheat works.\\n- Grand Rounds with 1 to 4 bots: all phases finish; `retractorHandle` works solo and with two.\\n1000→- The exit interview and `src/about-data.json` parse as JSON, and every field is filled.\\n\\n**Browser (Playwright, one or two browsers at a time, from `file://` where possible):** launch Chromium with `--autoplay-policy=no-user-gesture-required` for audio checks. Without it, the console's AudioContext warning before the first gesture is not a bug, so don't count warnings as failures.\\n- The built HTML plays 30 s with no errors in Chromium, Firefox and WebKit.\\n- `node tools/check.mjs` on the page (add `#scene` to jump to a scene): errors, what's on screen, look notes. Act on every look note.\\n- Settings defaults: music .1; glyphs PlayStation; the Xbox option switches labels.\\n- Pad with the Appendix E stub: `R2` and `△` prompts, stick cursor, wheel, trigger; keyboard and mouse switch the prompts.\\n- Phone profiles (Chromium, and WebKit with an iPhone profile, the closest thing here to iOS): notice and Settings button show, no touch buttons, attract runs behind, and a tap on Settings (`page.touchscreen.tap`) opens it.\\n- Audio: render through an `OfflineAudioContext` or read an `AnalyserNode`: effects, each voice and the choir are not silent; at defaults music is well below effects.\\n- Sizes: 1280x720, 1920x1080, 2560x1440, 3440x1440: HUD inside the screen, cavity centered.\\n1010→- **Hub harness, all four runs (Appendix D's runner):** `players=2&auto=1`; `players=4&latency=150&jitter=50&loss=5&auto=1`; the same with `&scenario=host-leave`; `players=2&scenario=server&auto=1`. Pass means `window.__hubCheck.pass === true`. Then open the page outside a session.\\n- This computer has no second player, so use the harness's frames, or two browser pages or contexts, as the stand-in. With 2 players in the harness, whose game frames are same-origin and reachable from the test: feed a client's cursor through a stroke, and check the stroke lands on the host's state.\\n\\n**Screenshots, for what scripts can't judge:** each site, each stage, the portraits, one frame of each strain, the wheel, Long Breath. Use `tools/filmstrip.mjs` for motion. Judge at 1920x1080 for the 10-foot view. WebGPU isn't used, so screenshots work.\\n\\n**This computer** (full detail in TASK.md): no display, so `xvfb-run` if you ever need headed; Playwright 1.63 is ready (`npm install playwright@1.63.0` in the dev folder for Node); never run `playwright install`; for a Python library such as Pillow, use `uv` as TASK.md says; `Target closed` means memory ran out, not a bug: run fewer browsers. Other agents share this machine, so keep one or two browsers open and only read what you need, never the folders beside yours. Keep all files in your folder, not `/tmp`. Prefer `file://` and the engine's headless tools. Other agents share this machine's ports and processes: use a server only for the harness, bound to `127.0.0.1` on a port the OS picks (`python3 -m http.server 0 --bind 127.0.0.1` prints it), and confirm the page is your game before trusting a result. Stop only processes you started, by their PID: never `pkill`, `killall`, `fuser -k`, or kill whatever holds a port.\\n\\n---\\n\\n## 21. Build order\\n1020→\\nEach milestone ends with a playable, tested game. Multiplayer comes early because it constrains the sim.\\n\\n| # | Milestone | Done when |\\n|---|---|---|\\n| M0 | Title picked. Folders, vendor, manifest, bundler, dev page, test runner, Hub client in the page | Empty game builds, runs, one test passes, harness runner works on Appendix D |\\n| M1 | **Hands:** sim core, tissue painter, cursor, wheel, Forceps, Salve, Suture, Syringe, vitals, clock, grades, HUD, Results, Case 1 end to end, bot | A person would enjoy Case 1 on a stubbed pad and mouse. Tune this until it's good; everything rests on it |\\n| M2 | **Shell:** title, menu, settings, glyphs, pause, TV scale, About skeleton, Dev Mode, attract v1, touch notice, saves, story system, busts, voices, first music, Case 1's story | First launch to Case 1 to Results feels finished, all TASK.md's cross-cutting features exist |\\n| M3 | Scalpel, Suction, Cautery, Sonar, Lightbox, Code Blue, Long Breath, Cases 2 and 3, Chapter 1 complete | Chapter 1 plays through, bot and all |\\n| M4 | **Grand Rounds:** local, then Hub, own card | All four harness runs pass, co-op works with bots |\\n1030→| M5 | Staccato, Legato, Tremolo, ward, Cases 4 to 6, Chapter 2 | Chapter 2 plays through |\\n| M6 | Second Look, tilt, blackout, Da Capo, device gestures, Cases 7 to 9, Chapter 3 | Chapter 3 plays through |\\n| M7 | Consult, Fermata, Cantor, Cases 10 and 11, ending, credits | The whole story plays through |\\n| M8 | **Polish:** feel table complete, cinematics, stages, title art, full score and mix, attract final reel, Skills Lab, balance runs, three browsers, CONTENT.md | Section 22 all true |\\n| M9 | About text, exit interview, final build, final test run, chat reply | Done |\\n\\n**If you run out of runway**, cut content from the end of this list and keep everything else: Case 9, then Skills Lab, then Da Capo's round 2, then the ship's ward (reuse Ward 3), then a stage or two. **Never cut:** the cursor's quality, any of the eight tools, both gifts, the finale, Grand Rounds and the Hub tests, attract mode, dev mode, the 10-foot UI, About, the exit interview. Whatever ships is complete: no stubs, no TODOs.\\n\\n---\\n\\n1040→## 22. Done checklist (TASK.md, line by line)\\n\\nGo through this at the end. Everything must be true.\\n\\n**Source, genre, perspective, title.**\\n- [ ] Original game from *Trauma Center: Second Opinion* per the originality rule; genre and perspective per section 2.\\n- [ ] Title is a playful riff, chosen by TASK.md's method with a real RNG, stored in one constant.\\n\",\"content_concise\":\"978→## 20. Testing\\n\\n980→As TASK.md says: headless tools first, scripts that play the game and check its state, including a scripted playthrough of the whole game; **one command that prints only failures and a one-line count**; rerun only after changing what it covers; screenshots only for what a script can't check; no subagents or workflows to debate, review, judge or audit.\\n\\n**`node tests/run.mjs`** (add `--fast` to skip the browser parts). Load engine and sources with `node:vm` as `game/test.mjs` does, giving the context `console`, `performance` and `window` (itself), drive with `game.advance`, `input.tap`, `input.hold`, `input.feed`, read `game.debug.snapshot()`. Output, and nothing else: failures, then e.g. `412 checks, 0 failed`.\\n\\n**Headless:**\\n- Every tool: right gesture finishes the object; each wrong gesture gives the specified slip, tear or lock.\\n- Cursor: full stick for 1 s moves 300 u or more; with Fine, 120 u or less; magnet settles on a target; guide-follow holds a line at full assist.\\n- Wheel: each of the eight stick directions picks its tool within 100 ms; 1 to 8 and mouse-hold picking do the same.\\n- Vitals and clock: drains add up as table 7 says; Code Blue timing window; lost path; phase checkpoint restores exactly.\\n- Grades and ranks: known inputs give the expected grade and rank.\\n990→- Every strain's stages reach their ends, and the failure branches (Legato snapping, Da Capo repeat, Cantor's rewind).\\n- Long Breath: world time at .25, hands at 1.\\n- Second Look: restored `S` deep-equals the old snapshot, and the ghost list is filled.\\n- Determinism: same seed and inputs give the same hash twice, and again with `draw: true` (draw changes nothing, no draw errors).\\n- Content validator: every id resolves, every story node reachable, every portrait expression exists.\\n- `TODO|FIXME|placeholder|stub` grep over `src/`.\\n- **Full playthrough:** New Game → every story scene (auto) → ward → every case, bot with cheats off at Resident → ending → credits → title. Checks the save, ranks, and unlocks. This is your most valuable test. Keep it fast by not drawing, then draw one case for draw errors.\\n- **Attract:** title idle 10 s starts it; each device's input exits to the title; the press does nothing else; it loops at least twice with no errors. Not on reading screens.\\n- **Dev mode:** every slider changes behavior live, Reset restores `TUNING`, each cheat works.\\n- Grand Rounds with 1 to 4 bots: all phases finish; `retractorHandle` works solo and with two.\\n1000→- The exit interview and `src/about-data.json` parse as JSON, and every field is filled.\\n\\n**Browser (Playwright, one or two browsers at a time, from `file://` where possible):** launch Chromium with `--autoplay-policy=no-user-gesture-required` for audio checks. Without it, the console's AudioContext warning before the first gesture is not a bug, so don't count warnings as failures.\\n- The built HTML plays 30 s with no errors in Chromium, Firefox and WebKit.\\n- `node tools/check.mjs` on the page (add `#scene` to jump to a scene): errors, what's on screen, look notes. Act on every look note.\\n- Settings defaults: music .1; glyphs PlayStation; the Xbox option switches labels.\\n- Pad with the Appendix E stub: `R2` and `△` prompts, stick cursor, wheel, trigger; keyboard and mouse switch the prompts.\\n- Phone profiles (Chromium, and WebKit with an iPhone profile, the closest thing here to iOS): notice and Settings button show, no touch buttons, attract runs behind, and a tap on Settings (`page.touchscreen.tap`) opens it.\\n- Audio: render through an `OfflineAudioContext` or read an `AnalyserNode`: effects, each voice and the choir are not silent; at defaults music is well below effects.\\n- Sizes: 1280x720, 1920x1080, 2560x1440, 3440x1440: HUD inside the screen, cavity centered.\\n1010→- **Hub harness, all four runs (Appendix D's runner):** `players=2&auto=1`; `players=4&latency=150&jitter=50&loss=5&auto=1`; the same with `&scenario=host-leave`; `players=2&scenario=server&auto=1`. Pass means `window.__hubCheck.pass === true`. Then open the page outside a session.\\n- This computer has no second player, so use the harness's frames, or two browser pages or contexts, as the stand-in. With 2 players in the harness, whose game frames are same-origin and reachable from the test: feed a client's cursor through a stroke, and check the stroke lands on the host's state.\\n\\n**Screenshots, for what scripts can't judge:** each site, each stage, the portraits, one frame of each strain, the wheel, Long Breath. Use `tools/filmstrip.mjs` for motion. Judge at 1920x1080 for the 10-foot view. WebGPU isn't used, so screenshots work.\\n\\n**This computer** (full detail in TASK.md): no display, so `xvfb-run` if you ever need headed; Playwright 1.63 is ready (`npm install playwright@1.63.0` in the dev folder for Node); never run `playwright install`; for a Python library such as Pillow, use `uv` as TASK.md says; `Target closed` means memory ran out, not a bug: run fewer browsers. Other agents share this machine, so keep one or two browsers open and only read what you need, never the folders beside yours. Keep all files in your folder, not `/tmp`. Prefer `file://` and the engine's headless tools. Other agents share this machine's ports and processes: use a server only for the harness, bound to `127.0.0.1` on a port the OS picks (`python3 -m http.server 0 --bind 127.0.0.1` prints it), and confirm the page is your game before trusting a result. Stop only processes you started, by their PID: never `pkill`, `killall`, `fuser -k`, or kill whatever holds a port.\\n\\n---\\n\\n## 21. Build order\\n1020→\\nEach milestone ends with a playable, tested game. Multiplayer comes early because it constrains the sim.\\n\\n| # | Milestone | Done when |\\n|---|---|---|\\n| M0 | Title picked. Folders, vendor, manifest, bundler, dev page, test runner, Hub client in the page | Empty game builds, runs, one test passes, harness runner works on Appendix D |\\n| M1 | **Hands:** sim core, tissue painter, cursor, wheel, Forceps, Salve, Suture, Syringe, vitals, clock, grades, HUD, Results, Case 1 end to end, bot | A person would enjoy Case 1 on a stubbed pad and mouse. Tune this until it's good; everything rests on it |\\n| M2 | **Shell:** title, menu, settings, glyphs, pause, TV scale, About skeleton, Dev Mode, attract v1, touch notice, saves, story system, busts, voices, first music, Case 1's story | First launch to Case 1 to Results feels finished, all TASK.md's cross-cutting features exist |\\n| M3 | Scalpel, Suction, Cautery, Sonar, Lightbox, Code Blue, Long Breath, Cases 2 and 3, Chapter 1 complete | Chapter 1 plays through, bot and all |\\n| M4 | **Grand Rounds:** local, then Hub, own card | All four harness runs pass, co-op works with bots |\\n1030→| M5 | Staccato, Legato, Tremolo, ward, Cases 4 to 6, Chapter 2 | Chapter 2 plays through |\\n| M6 | Second Look, tilt, blackout, Da Capo, device gestures, Cases 7 to 9, Chapter 3 | Chapter 3 plays through |\\n| M7 | Consult, Fermata, Cantor, Cases 10 and 11, ending, credits | The whole story plays through |\\n| M8 | **Polish:** feel table complete, cinematics, stages, title art, full score and mix, attract final reel, Skills Lab, balance runs, three browsers, CONTENT.md | Section 22 all true |\\n| M9 | About text, exit interview, final build, final test run, chat reply | Done |\\n\\n**If you run out of runway**, cut content from the end of this list and keep everything else: Case 9, then Skills Lab, then Da Capo's round 2, then the ship's ward (reuse Ward 3), then a stage or two. **Never cut:** the cursor's quality, any of the eight tools, both gifts, the finale, Grand Rounds and the Hub tests, attract mode, dev mode, the 10-foot UI, About, the exit interview. Whatever ships is complete: no stubs, no TODOs.\\n\\n---\\n\\n1040→## 22. Done checklist (TASK.md, line by line)\\n\\nGo through this at the end. Everything must be true.\\n\\n**Source, genre, perspective, title.**\\n- [ ] Original game from *Trauma Center: Second Opinion* per the originality rule; genre and perspective per section 2.\\n- [ ] Title is a playful riff, chosen by TASK.md's method with a real RNG, stored in one constant.\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/PLAN.md\",\"offset\":978,\"limit\":70,\"raw_output\":\"## 20. Testing\\n\\nAs TASK.md says: headless tools first, scripts that play the game and check its state, including a scripted playthrough of the whole game; **one command that prints only failures and a one-line count**; reru