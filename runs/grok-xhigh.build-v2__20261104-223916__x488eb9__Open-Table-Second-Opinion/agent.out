to an action: a notch taps it, no zoom)\"},{\"line_number\":840,\"content\":\"    on(el, 'pointermove', e => { if (e.pointerType === 'mouse') { if (this.lastDevice !== 'mouse' && this.lastDevice !== 'keyboard' && Math.hypot(e.clientX - this.mouse.cx, e.clientY - this.mouse.cy) > 3) this.lastDevice = 'mouse'; this.mouse.cx = e.clientX; this.mouse.cy = e.clientY; this.mouse.active = true; this.mouse.t = this.clock; this.aimSource = 'mouse'; this._fedAt = null; } else { this._pinchMove(e); this._stickMove(e); } if (this._g && this._g.id === e.pointerId) this._gesture('move', ...this.screenPoint(e.clientX, e.clientY)); });\"},{\"line_number\":842,\"content\":\"      if (e.pointerType !== 'mouse') this.lastDevice = 'touch';   // any touch, on the stick's half or not: prompts follow it\"},{\"line_number\":933,\"content\":\"  label(a, device = this.lastDevice) {\"},{\"line_number\":1021,\"content\":\"    if (code.startsWith('Pad')) { this.lastDevice = 'gamepad'; this.aimSource = 'pad'; }\"},{\"line_number\":1022,\"content\":\"    else if (code.startsWith('Act:')) this.lastDevice = 'touch';\"},{\"line_number\":1023,\"content\":\"    else this.lastDevice = code.startsWith('Mouse') ? 'mouse' : 'keyboard';\"},{\"line_number\":1033,\"content\":\"  tap(a) { if (!this.map[a]) { this._check(a); return; } const d = this.lastDevice; this._tapCode('Act:' + a); this.lastDevice = d; }   // (a script's tap is no device: prompts keep the player's)\"},{\"line_number\":1038,\"content\":\"    const c = 'Act:' + a, d = this.lastDevice; if (on) { this._holds.add(c); this.press(c); } else { this._holds.delete(c); this.release(c); }\"},{\"line_number\":1039,\"content\":\"    this.lastDevice = d;   // (no device either; and a tap of a held action leaves it held)\"},{\"line_number\":1067,\"content\":\"  consumeAll() { for (const a in this.map) this._used[a] = true; this._now.clear(); this._fresh.clear(); this._freshCodes.clear(); this._clickAt = this._click = null; }\"},{\"line_number\":1074,\"content\":\"    this.held.clear(); this._holds.clear(); this.consumeAll(); this._nowUp.clear(); this._freshUp.clear(); this._pt = {}; this._rk = {}; this._down = null;\"},{\"line_number\":1084,\"content\":\"  anyPressed() { return this._now.size > 0; }\"},{\"line_number\":1175,\"content\":\"      if (!p && this.padIndex !== null) { this.padLost = this.lastDevice === 'gamepad'; this.stopRumble(); }   // unplugged while in use\"},{\"line_number\":1190,\"content\":\"      if (this.padAim || Math.hypot(...this.padMove) > 0) { this.aimSource = 'pad'; this.lastDevice = 'gamepad'; }\"},{\"line_number\":1247,\"content\":\"    this.screen.canvas.setPointerCapture(e.pointerId); this.aimSource = 'move'; this.lastDevice = 'touch';\"},{\"line_number\":2423,\"content\":\"    this.settings = new Settings(this, (this.o.menu && this.o.menu.settings) || []);\"},{\"line_number\":2479,\"content\":\"    const f = clamp(clamp(+this.settings.zoom || 1, lo, hi) * k, lo, hi); this.settings.set('zoom', f);   // (one carried from a scene with more room starts at this one's end: every step moves it)\"},{\"line_number\":2504,\"content\":\"    const R = this.zoomRange(), b = this._zoomBase, f = R && this._zoomStd() ? +this.settings.zoom || 1 : 1;\"},{\"line_number\":2523,\"content\":\"  _zoomStd() { const sp = this.settings && this.settings.spec('zoom'); return !!sp && sp.apply === STANDARD_SETTINGS.zoom.apply; }\"},{\"line_number\":2560,\"content\":\"    on(document, 'visibilitychange', () => { if (document.hidden) this._autoPause('focus'); this.audio._background(document.hidden && !this.settings.background); });   // a hidden page sleeps its sound\"},{\"line_number\":2586,\"content\":\"    if ((o !== undefined && o !== 'tap') || this.settings.fullscreen === false || !fs.supported || fs.standalone) return false;\"},{\"line_number\":2647,\"content\":\"  shake(a) { if (!this.reduceMotion) this._shakeAmt = Math.min(10, this._shakeAmt + a * clamp(this.settings.shake, 0, 1)); }\"}]}]}","is_error":fals