,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":8,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-223916__x488eb9/work/Open-Table-Second-Opinion-Trauma-Center-Second-Opinion-grok-4.7-xhigh-20261104-223916/vendor/hub/harness.html\",\"matches\":[{\"line_number\":145,\"content\":\"        cell.violations.push(`${name}() called`);\"},{\"line_number\":151,\"content\":\"    win.addEventListener('error', (e) => cell.violations.push(`error: ${e.message}`));\"},{\"line_number\":152,\"content\":\"    win.addEventListener('unhandledrejection', (e) => cell.violations.push(`unhandled rejection: ${e.reason?.message || e.reason}`));\"},{\"line_number\":224,\"content\":\"    const cell = { ...p, el, label, frame, endpoint, violations: [], instrumented: true, gone: false, progress: [], cardSent: '' };\"},{\"line_number\":514,\"content\":\"    const violations = state.cells.flatMap((c) => {\"},{\"line_number\":517,\"content\":\"        extra = c.frame.contentWindow?.__hubViolations ?? [];\"},{\"line_number\":519,\"content\":\"      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\"},{\"line_number\":521,\"content\":\"    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa37-f7cf-7001-9198-38ad04ed0f5e","uuid":"b903e24c-4076-4f93-8dd7-46fdd05aa18c"}
