{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('ComBop-Combat-1977-gpt-6.1-sol-ultra-20261105-212552')\nf=p/'sim.js';s=f.read_text().replace(\\\"this.mode==='solo'&&i===1)?this.ai\\\", \\\"this.mode==='solo'&&i===1||this.mode==='attract')?this.ai\\\");f.write_text(s)\nf=p/'app.js';s=f.read_text().replace(\\\"onPeer(info){if(\"'!info.joined\", \"onPeer(info){if(!info.joined&&sim&&online.isHost&&info.seat>=0)sim.input(info.seat,{});if(!info.joined\")\ns=s.replace(\"online.finish(sim.scores,{shots:sim.metrics.shots,bounces:sim.metrics.bounces})\", \"online.finish(sim.scores)\")\ns=s.replace(\"pad?'\"'Left stick to move · × to select'\\\", \\\"pad?\"'`Left stick to move · ${xbox?'\"'A':'×'} to select\"'`\")\nf.write_text(s)\nf=p/'\"'view.js';s=f.read_text().replace(\\\"this.aimLines=[];\\\", \\\"this.aimLines=[];this.aimMaterial=new THREE.LineDashedMaterial({color:0x365f58,dashSize:.22,gapSize:.16,transparent:true,opacity:.5});this.bankMaterial=new THREE.LineDashedMaterial({color:0xd99a37,dashSize:.22,gapSize:.16,transparent:true,opacity:.5});this.aimRingMaterial=new THREE.MeshBasicMaterial({color:0xd18f31,side:THREE.DoubleSide});\\\")\ns=s.replace(\\\"new THREE.LineDashedMaterial({color:i?0xd99a37:0x365f58,dashSize:.22,gapSize:.16,transparent:true,opacity:i?.5:.5})\\\", \\\"i?this.bankMaterial:this.aimMaterial\\\")\ns=s.replace(\\\"new THREE.MeshBasicMaterial({color:0xd18f31,side:THREE.DoubleSide})\\\", \\\"this.aimRingMaterial\\\",1) if False else s\n# Replace only the per-frame ring construction, preserving constructor material.\ns=s.replace(\\\"new THREE.RingGeometry(.1,.17,12),new THREE.MeshBasicMaterial({color:0xd18f31,side:THREE.DoubleSide})\\\", \\\"new THREE.RingGeometry(.1,.17,12),this.aimRingMaterial\\\")\nf.write_text(s)\nPY\npython3 ComBop-Combat-1977-gpt-6.1-sol-ultra-20261105-212552/build.py\nnode --check ComBop-Combat-1977-gpt-6.1-sol-ultra-20261105-21