auto}.shell{height:12px;width:6px;border-radius:3px 3px 0 0;background:var(--ink)}.shell.empty{background:#193b3c22}.stage-card{text-align:center;padding:6px 20px}.stage-name{font-size:16px;letter-spacing:2px;font-weight:1000;text-transform:uppercase}.stage-sub{font-size:12px;letter-spacing:1.4px;margin-top:5px;color:var(--muted);font-weight:900}.timer{font-size:32px;font-weight:1000;letter-spacing:2px;margin-top:8px}.timer.danger{color:var(--orange)}#pause-button{position:fixed;bottom:25px;right:28px;pointer-events:auto;width:48px;height:48px;border:2px solid var(--ink);background:var(--paper);border-radius:50%;font-size:20px;font-weight:1000}#combat-help{position:fixed;bottom:27px;left:32px;display:flex;gap:22px;align-items:center;font-size:14px;font-weight:900}.ability-meter{height:5px;width:70px;background:#193b3c25;display:inline-block;margin-left:8px}.ability-meter i{display:block;height:100%;background:var(--teal);width:100%}#announce{position:fixed;top:24%;left:50%;transform:translateX(-50%) rotate(-3deg);font-size:clamp(22px,3.6vw,56px);line-height:1;font-weight:1000;font-style:italic;text-transform:uppercase;background:var(--gold);padding:15px 28px;border:2px solid var(--ink);box-shadow:5px 5px 0 var(--ink);white-space:nowrap;opacity:0;transition:opacity .13s;pointer-events:none;z-index:3}#announce.show{opacity:1}#toast{position:fixed;left:50%;bottom:85px;transform:translateX(-50%);background:var(--ink);color:var(--paper);padding:12px 24px;font-weight:800;font-size:16px;z-index:20;opacity:0;transition:opacity .15s;max-width:90vw;text-align:center;pointer-events:none}#toast.show{opacity:1}#attract-bar{position:fixed;left:50%;bottom:34px;transform:translateX(-50%);z-index:4;text-align:center;background:var(--paper);border:2px solid var(--ink);padding:15px 30px;display:none;font-size:14px;font-weight:900;letter-spacing:2px}#attract-bar strong{color:var(--orange);display:block;font-size:20px;letter-spacing:3px;margin-bottom:5px}\n.setting{display:grid;grid-tem