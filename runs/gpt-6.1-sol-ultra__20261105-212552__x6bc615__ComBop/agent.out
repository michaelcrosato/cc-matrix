ect/2;this.camera.top=height/2;this.camera.bottom=-height/2;this.camera.updateProjectionMatrix();}\n setTitle(v){if(this.title\"'!==v){this.title=v;this.resize();}}\n worldPoint(x,y){this.raycaster.setFromCamera(new THREE.Vector2(x/innerWidth*2-1,1-y/innerHeight*2),this.camera);const out=new THREE.Vector3();this.raycaster.ray.intersectPlane(this.plane,out);return{x:out.x,z:out.z};}\n buildZone(zone){if(!this.zoneGroup)return;for(const c of [...this.zoneGroup.children]){this.zoneGroup.remove(c);c.geometry?.dispose();}if(zone>=16)return;const mat=new THREE.MeshBasicMaterial({color:CORAL,transparent:true,opacity:.17,side:THREE.DoubleSide,depthWrite:false});for(const [x,z,w,d] of [[-(14+zone)/2,0,Math.max(.01,14-zone),18],[(14+zone)/2,0,Math.max(.01,14-zone),18],[0,-(9+zone*.64)/2,Math.min(28,zone*2),Math.max(.01,9-zone*.64)],[0,(9+zone*.64)/2,Math.min(28,zone*2),Math.max(.01,9-zone*.64)]]){const m=new THREE.Mesh(new THREE.PlaneGeometry(w,d),mat);m.rotation.x=-Math.PI/2;m.position.set(x,.12,z);this.zoneGroup.add(m);}this.line([[-zone,.15,-zone*.64],[zone,.15,-zone*.64],[zone,.15,zone*.64],[-zone,.15,zone*.64],[-zone,.15,-zone*.64]],CORAL,this.zoneGroup);}\n effect(type,data){const x=data.x||0,z=data.z||0;if(type==='\"'shoot'){const t=this.tankViews[data.tank];t.recoil.reset().play();t.flashTime=.08;this.shake=Math.max(this.shake,.025);return;}if(type==='hit')this.shake=.16;if(type==='explode'||type==='barrel')this.shake=.32;const n=type==='explode'?24:type==='barrel'?28:type==='hit'?9:type==='cover'?15:type==='bounce'?5:type==='dash'?5:type==='chip'?7:8;for(let i=0;i<n;i++){const col=type==='pickup'?0x65bb99:type==='dash'?0xd4d4b2:i%3?0xf0c35b:CORAL;const m=this.mesh(new THREE.BoxGeometry(.13,.13,.13),col,this.root,x,.5,z,false);this.effects.push({mesh:m,vx:rand(-4,4),vy:rand(1,6),vz:rand(-4,4),life:rand(.25,.65),max:.65,spin:rand(-5,5)});}if(['explode','hit','barrel','pickup','respawn'].includes(type)){const ring=new THREE.Mesh(new THREE.RingGeometry(.7,.88,24),new THREE.MeshBasicMaterial({color:type==='pickup'?TEAL:0xf3be4e,transparent:true,opacity:.8,side:THREE.DoubleSide,depthWrite:false}));ring.rotation.x=-Math.PI/2;ring.position.set(x,.13,z);this.root.add(ring);this.effects.push({mesh:ring,ring:true,life:.45,max:.45,vx:0,vz:0,vy:0});}}\n update(state,dt,{aim=null,assist=true,seat=0,shake=true,title=false}={}){this.elapsed+=dt;if(state.round\"'!==this.round)this.build(state.round);this.setTitle(title);const portrait=innerWidth<600;const targetX=title&&!portrait?-8:0,targetZ=title&&portrait?8:0;const cx=targetX,cz=targetZ;this.camera.position.set(cx,34,cz+27);this.camera.lookAt(cx,0,cz);if(shake&&this.shake>0){this.camera.position.x+=rand(-this.shake,this.shake);this.camera.position.z+=rand(-this.shake,this.shake);this.shake=Math.max(0,this.shake-dt*1.2);}\n  for(let i=0;i<2;i++){const t=state.tanks[i],v=this.tankViews[i];if(!t||!v)continue;v.g.position.set(t.x,0,t.z);v.g.visible=t.dead<=0;v.hull.rotation.y=t.angle;v.turret.rotation.y=t.aim;v.trackAction.timeScale=(t.moving||0)*2.3;v.mixer.update(dt);v.gunMixer.update(dt);v.flashTime-=dt;v.flash.visible=v.flashTime>0;v.flash.scale.setScalar(1+Math.random()*.5);v.shield.visible=t.shield>0;v.shield.rotation.y+=dt;v.ring.material.opacity=t.overdrive>0?.8:.3;v.ring.scale.setScalar(t.overdrive>0?1.1+Math.sin(this.elapsed*8)*.07:1);for(const mat of v.fadeMats)mat.opacity=t.cloak?(i===seat?.4:.11):1;v.ring.visible=!t.cloak||i===seat;v.dust-=dt;if(t.moving>.1&&v.dust<0&&t.dead<=0){v.dust=.12;const m=this.mesh(new THREE.IcosahedronGeometry(.13,0),0xcdc7a9,this.root,t.x-Math.sin(t.angle)*.8,.2,t.z-Math.cos(t.angle)*.8,false);this.effects.push({mesh:m,vx:rand(-.3,.3),vy:.35,vz:rand(-.3,.3),life:.35,max:.35,dust:true});}}\n  this.obstacleMeshes.forEach((v,i)=>{const o=state.obstacles[i];if(o){v.visible=o.hp>0;if(o.type==='\"'crate')v.scale.y=.7+Math.min(3,o.hp)*.1;}});\n  const active=new Set();for(const b of state.bullets){active.add(b.id);let m=this.bulletMeshes.get(b.id);if(\"'!m){m=new THREE.Group();this.mesh(new THREE.SphereGeometry(.14,7,6),b.owner?CORAL:0xfff5c1,m,0,0,0);for(let j=1;j<4;j++){const trail=this.box(.14-j*.025,.08,.19,0xe8b94e,m,0,0,-j*.24,false);trail.material=this.mat(0xe8b94e);}this.root.add(m);this.bulletMeshes.set(b.id,m);}m.position.set(b.x,.58,b.z);m.rotation.y=Math.atan2(b.dx,b.dz);}for(const [id,m] of this.bulletMeshes)if(!active.has(id)){this.root.remove(m);this.bulletMeshes.delete(id);}\n  const activeP=new Set();for(const p of state.pickups){activeP.add(p.id);let m=this.pickMeshes.get(p.id);if(!m){m=new THREE.Group();this.cylinder(.52,.15,INK,m,0,.1,0,20);this.cylinder(.42,.16,p.type==='\"'repair'?0x65ae85:0xeabd4c,m,0,.18,0,20);if(p.type==='repair'){this.box(.18,.12,.65,CREAM,m,0,.45,0);this.box(.65,.12,.18,CREAM,m,0,.45,0);}else{const mark=this.label('ϟ',.8,1,INK);mark.position.y=.4;m.add(mark);}const r=new THREE.Mesh(new THREE.RingGeometry(.7,.74,32),new THREE.MeshBasicMaterial({color:p.type==='repair'?TEAL:0xd08b2d,side:THREE.DoubleSide,transparent:true,opacity:.6}));r.rotation.x=-Math.PI/2;r.position.y=.1;m.add(r);this.root.add(m);this.pickMeshes.set(p.id,m);}m.position.set(p.x,Math.sin(this.elapsed*3)*.08,p.z);m.rotation.y=this.elapsed*.8;}for(const [id,m]of this.pickMeshes)if(\"'!activeP.has(id)){this.root.remove(m);this.pickMeshes.delete(id);}\n  for(let i=this.effects.length-1;i>=0;i--){const f=this.effects[i];f.life-=dt;if(f.life<=0){this.root.remove(f.mesh);f.mesh.geometry?.dispose();this.effects.splice(i,1);continue;}f.mesh.position.x+=f.vx*dt;f.mesh.position.y+=f.vy*dt;f.mesh.position.z+=f.vz*dt;if(f.ring)f.mesh.scale.setScalar(1+(1-f.life/f.max)*3);else if(f.dust)f.mesh.scale.setScalar(1+(1-f.life/f.max)*2);else{f.vy-=14*dt;f.mesh.rotation.x+=dt*f.spin;f.mesh.rotation.z+=dt*f.spin;}}\n  if(Math.abs((this.lastZone||17)-state.zone)>.12){this.buildZone(state.zone);this.lastZone=state.zone;}\n  for(const c of [...this.aimGroup.children]){this.aimGroup.remove(c);c.geometry?.dispose();}if(assist&&aim&&seat>=0&&!title&&!state.tanks[seat].dead){for(let i=0;i<aim.length;i++){const s=aim[i],geo=new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(s.x1,.15,s.z1),new THREE.Vector3(s.x2,.15,s.z2)]);const m=new THREE.Line(geo,new THREE.LineDashedMaterial({color:i?0xd99a37:0x365f58,dashSize:.22,gapSize:.16,transparent:true,opacity:i?.5:.5}));m.computeLineDistances();this.aimGroup.add(m);if(s.hit){const ring=new THREE.Mesh(new THREE.RingGeometry(.1,.17,12),new THREE.MeshBasicMaterial({color:0xd18f31,side:THREE.DoubleSide}));ring.rotation.x=-Math.PI/2;ring.position.set(s.x2,.16,s.z2);this.aimGroup.add(ring);}}}\n  if(this.planeModel){this.planeModel.position.set(Math.sin(this.elapsed*.09)*25,7,-17+Math.cos(this.elapsed*.09)*6);this.planeModel.rotation.y=Math.PI*.5+this.elapsed*.04;this.planeModel.visible=title;}\n }\n render(){this.renderer.render(this.scene,this.camera);}\n inspect(){return{backend:this.backend,mixers:this.tankViews?.length*2||0,effects:this.effects.length,meshes:this.scene.children.length};}\n}\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"cat ComBop-Combat-1977-gpt-6.1-sol-ultra-20261105-212552/hub-integration.md && sed -n '1,240p' ComBop-Combat-1977-gpt-6.1-sol-ultra-20261105-212552/hub.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"cat ComBop-Combat-1977-gpt-6.1-sol-ultra-20261105-212552/hub-integration.md && sed -n '1,240p' ComBop-Combat-1977-gpt-6.1-sol-ultra-20261105-212552/hub.js\"","aggregated_output":"# ComBop multiplayer\n\nThe supplied AI Hub source was downloaded directly, without search or general web research. Its README identifies AI Hub Session Protocol v1 and client 1.4.0. The raw, unmodified client is `session.js`; inline it as the first script directly after the HTML charset declaration.\n\nRequired head metadata:\n\n```html\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"2-2\">\n<meta name=\"hub:session-mode\" content=\"shared-world\">\n<meta name=\"hub:session-goal\" content=\"Score five knockouts. Bank shots around cover and dodge incoming shells.\">\n<meta name=\"hub:session-howto\" content=\"Move: left stick / WASD. Aim: right stick / mouse. Fire: R2 / mouse. Dash: L2 / Space.\">\n<meta name=\"hub:session-minutes\" content=\"3\">\n```\n\nIf WebGPU has no WebGL fallback, also include `<meta name=\"hub:webgpu\" content=\"required\">`.\n\n## Adapter contract\n\n`createOnline(callbacks)` from `hub.js` returns:\n\n- `connectHub(): Promise<info|null>`: immediately returns null outside a hub session; in the hub joins shared-world with two seats.\n- `ready()`: call after all game loading is complete. No button press may be required.\n- `host(): Promise<string>`: standalone host invitation code.\n- `join(invitation): Promise<string>`: standalone guest return code.\n- `accept(returnCode): Promise<void>`: host accepts the guest. Both copies start on their `onStart` callback when the data channel opens.\n- `sendInput(input)`: client-to-host. Call every frame; rate capped under twenty per second.\n- `sendSnapshot(state)`: host-to-clients. Call every frame; same cap.\n- `finish([score0,score1])`: host submits valid hub standings or sends standalone final scores. Once per round.\n- `leave()`: closes standalone networking. Deliberately does nothing in the hub.\n- `time()`: hub's shared clock, or standalone time since connection. A hub round plays when this reaches zero.\n- `inspect()`: lifecycle, transport, sent/received counts, seat and connection state.\n- Getter properties: `active`, `inHub`, `isHost`, `isServer`, `seat`, `players`, `connected`, `started`, `ended`.\n\nCallbacks: `onStatus(text)`, `onInput(input,seatIndex)`, `onSnapshot(state)`, `onPeer({joined,seat,name,reason})`, `onStart(info)`, `onEnd(event)`, `onTimeUp(event)`.\n\nIn hub sessions, the host can have no seat. If `isServer` is true, `seat` is -1; it runs the whole world and receives both players' inputs. Do not attach local input to either tank. AI Hub's player names are text only. Never use `innerHTML` for them.\n\nWhen `onTimeUp` arrives, host calls `finish(currentScores)` immediately. When `onEnd` arrives, stop input, outgoing traffic and all audio. Hide title, restart and quit actions in a hub round. Ignore controller Options while Create is held.\n\n## Standalone direct connections\n\nUses browser-native WebRTC with a reliable ordered data channel. Invitation and return codes contain gzipped SDP (prefix `CBZ1.`); browsers without CompressionStream use raw `CB1.` codes. In the verified local two-page connection, invitation was 703 characters and return code was 629 characters. Exact lengths vary with network candidates.\n\nOutside AI Hub only, Google STUN discovers public connection addresses. No public game broker or match server is required. There is no TURN relay. Restrictive NATs/firewalls may prevent direct connections; AI Hub sessions are the alternative. Creating codes is limited to six seconds of ICE gathering; all discovered local candidates are retained.\n\n## Verification performed\n\nChromium headless, two pages on OS-assigned loopback HTTP server. Fourteen transport assertions passed: standalone hub detection, code encoding, two peer roles, exactly one start callback, bidirectional payload integrity and seat routing, authority guards, invalid input rejection, final score delivery, disconnect notification and packet counters. All opened browser/server resources were closed. Node syntax check passed.\n\nThe supplied harness and dependencies are saved as `harness.html`, `bridge.js`, and `round.js`. To test the final root artifact from the workspace server use `/ComBop-Combat-1977-gpt-6.1-sol-ultra-20261105-212552/harness.html?game=../ComBop-Combat-1977-gpt-6.1-sol-ultra-20261105-212552.html&players=2&auto=1`. Also run `&scenario=server`, `&scenario=host-leave`, and a latency/jitter/loss case. Passing is `window.__hubCheck.pass === true` once `document.body.dataset.complete === 'true'`.\n/* ComBop multiplayer adapter. AI Hub Session Protocol v1 + direct WebRTC. */\nexport function createOnline(callbacks = {}) {\n  const cb = {\n    onStatus() {}, onInput() {}, onSnapshot() {}, onPeer() {},\n    onStart() {}, onEnd() {}, onTimeUp() {}, ...callbacks,\n  };\n  const state = {\n    active: false, inHub: false, isHost: false, isServer: false,\n    seat: -1, players: [], connected: false, started: false,\n    ended: false, transport: 'none', sent: 0, received: 0,\n  };\n  let pc = null;\n  let channel = null;\n  let generation = 0;\n  let startedAt = 0;\n  let resultSent = false;\n  let lastInput = -Infinity;\n  let lastSnapshot = -Infinity;\n  let currentStatus = 'Offline';\n  let hubInfo = null;\n  const liveIds = new Set();\n  const subscriptions = [];\n\n  const status = (text) => {\n    currentStatus = text;\n    cb.onStatus(text);\n  };\n  const info = () => ({ ...state, players: state.players.map(p => ({ ...p })), delay: state.inHub ? Math.max(0, -globalThis.AIHub.time()) : 0 });\n  const cleanInput = (input) => {\n    if (!input || typeof input !== 'object' || Array.isArray(input)) return null;\n    // The game owns its compact input schema; JSON size and finite numbers\n    // are checked here so a malformed remote input cannot poison physics.\n    const serialized = JSON.stringify(input);\n    if (serialized.length > 1024) return null;\n    const valid = (value, depth = 0) => {\n      if (depth > 3) return false;\n      if (typeof value === 'number') return Number.isFinite(value) && Math.abs(value) <= 1e6;\n      if (value === null || typeof value === 'boolean' || typeof value === 'string') return typeof value !== 'string' || value.length < 80;\n      if (Array.isArray(value)) return value.length <= 8 && value.every(v => valid(v, depth + 1));\n      return typeof value === 'object' && Object.keys(value).length <= 16 && Object.values(value).every(v => valid(v, depth + 1));\n    };\n    return valid(input) ? input : null;\n  };\n\n  function receive(data, from) {\n    if (state.ended || !data || data.game !== 'combop-1') return;\n    state.received++;\n    if (data.type === 'input' && state.isHost) {\n      const seat = state.inHub ? state.players.findIndex(p => p.id === from) : 1;\n      const input = cleanInput(data.input);\n      if (seat >= 0 && input && (!state.inHub || liveIds.has(from))) cb.onInput(input, seat);\n    } else if (data.type === 'snapshot' && !state.isHost && (!state.inHub || from === hubInfo.host)) {\n      if (data.state && typeof data.state === 'object') cb.onSnapshot(data.state);\n    } else if (!state.inHub && data.type === 'finish' && !state.isHost) {\n      resultSent = true;\n      cb.onEnd({ reason: 'finished', scores: data.scores, standalone: true });\n    }\n  }\n\n  function send(data, reliable = false) {\n    if (!state.connected || state.ended || !state.started) return false;\n    const packet = { game: 'combop-1', ...data };\n    let sent = false;\n    if (state.inHub) {\n      sent = globalThis.AIHub.send(packet, { ...(state.isHost ? {} : { to: hubInfo.host }), reliable });\n    } else if (channel?.readyState === 'open' && channel.bufferedAmount < 128 * 1024) {\n      const text = JSON.stringify(packet);\n      if (text.length <= 16000) {\n        channel.send(text);\n        sent = true;\n      }\n    }\n    if (sent) state.sent++;\n    return sent;\n  }\n\n  function disconnect(reason = 'disconnected') {\n    if (state.ended || !state.active) return;\n    const wasConnected = state.connected;\n    state.connected = false;\n    state.ended = true;\n    status(reason === 'left' ? 'Connection closed' : 'Opponent disconnected');\n    if (wasConnected) cb.onPeer({ joined: false, seat: state.isHost ? 1 : 0, name: state.isHost ? 'Coral' : 'Mint', reason });\n    cb.onEnd({ reason, standalone: !state.inHub });\n  }\n\n  async function connectHub() {\n    const hub = globalThis.AIHub;\n    if (!hub?.active) return null;\n    state.active = state.inHub = true;\n    state.transport = 'ai-hub';\n    subscriptions.push(hub.on('message', receive));\n    subscriptions.push(hub.on('start', event => {\n      state.started = state.connected = true;\n      state.ended = false;\n      startedAt = performance.now() + (event?.in || 0);\n      status('AI Hub • connected');\n      cb.onStart({ ...info(), delay: event?.in || 0 });\n    }));\n    subscriptions.push(hub.on('leave', event => {\n      liveIds.delete(event.id);\n      const seat = state.players.findIndex(p => p.id === event.id);\n      cb.onPeer({ joined: false, seat, name: state.players[seat]?.name || 'Player', reason: event.reason });\n      status('AI Hub • player left');\n    }));\n    subscriptions.push(hub.on('time-up', event => cb.onTimeUp(event)));\n    subscriptions.push(hub.on('end', event => {\n      state.ended = true;\n      state.connected = false;\n      status('AI Hub • round ended');\n      cb.onEnd(event);\n    }));\n    hubInfo = await hub.connect({ mode: 'shared-world', seats: [2, 2] });\n    if (!hubInfo) {\n      state.active = state.inHub = false;\n      state.transport = 'none';\n      subscriptions.splice(0).forEach(off => off());\n      return null;\n    }\n    state.isHost = hubInfo.isHost;\n    state.isServer = !!hubInfo.server;\n    state.players = hubInfo.players.map(p => ({ ...p }));\n    state.seat = state.players.findIndex(p => p.id === hubInfo.me);\n    state.players.forEach(p => liveIds.add(p.id));\n    status('AI Hub • waiting for the round');\n    return { ...hubInfo, seat: state.seat };\n  }\n\n  function ready() {\n    if (state.inHub && !state.ended) globalThis.AIHub.ready();\n  }\n\n  // Direct connections use one reliable ordered data channel. No game server\n  // sees match data. A public STUN service discovers public addresses; no TURN\n  // relay is available, so restrictive networks may need AI Hub instead.\n  function newPeer(host) {\n    if (globalThis.AIHub?.active) throw new Error('AI Hub owns network connections during sessions.');\n    if (!globalThis.RTCPeerConnection) throw new Error('This browser does not support direct online play.');\n    closePeer();\n    generation++;\n    const token = generation;\n    resultSent = false;\n    Object.assign(state, {\n      active: true, inHub: false, isHost: host, isServer: false,\n      seat: host ? 0 : 1, players: [{ id: 0, name: 'Mint', color: '#84e6bf' }, { id: 1, name: 'Coral', color: '#ff805b' }],\n      connected: false, started: false, ended: false, transport: 'webrtc', sent: 0, received: 0,\n    });\n    lastInput = lastSnapshot = -Infinity;\n    pc = new RTCPeerConnection({ iceServers: [{ urls: 'stun:stun.l.google.com:19302' }], iceCandidatePoolSize: 0 });\n    pc.onconnectionstatechange = () => {\n      if (generation !== token || !pc) return;\n      if (['failed', 'closed'].includes(pc.connectionState)) disconnect('disconnected');\n      if (pc.connectionState === 'disconnected') status('Connection interrupted • attempting to reconnect');\n      if (pc.connectionState === 'connected' && state.connected) status('Direct online • connected');\n    };\n    const bind = dc => {\n      channel = dc;\n      channel.onopen = () => {\n        if (generation !== token) return;\n        state.connected = state.started = true;\n        state.ended = false;\n        startedAt = performance.now();\n        status('Direct online • connected');\n        cb.onPeer({ joined: true, seat: host ? 1 : 0, name: host ? 'Coral' : 'Mint' });\n        cb.onStart({ ...info(), delay: 0 });\n      };\n      channel.onmessage = event => {\n        if (generation !== token || typeof event.data !== 'string' || event.data.length > 16000) return;\n        try { receive(JSON.parse(event.data), host ? 1 : 0); } catch { /* Ignore malformed packets. */ }\n      };\n      channel.onclose = () => { if (generation === token) disconnect('disconnected'); };\n      channel.onerror = () => { if (generation === token) status('Connection error • create a new invitation'); };\n    };\n    if (host) bind(pc.createDataChannel('combop', { ordered: true }));\n    else pc.ondatachannel = event => bind(event.channel);\n    return pc;\n  }\n\n  async function iceComplete(peer) {\n    if (peer.iceGatheringState === 'complete') return;\n    await new Promise((resolve, reject) => {\n      const timeout = setTimeout(() => {\n        peer.removeEventListener('icegatheringstatechange', done);\n        // Local candidates are usable even if a STUN response timed out.\n        resolve();\n      }, 6000);\n      function done() {\n        if (peer.signalingState === 'closed') {\n          clearTimeout(timeout);\n          peer.removeEventListener('icegatheringstatechange', done);\n          reject(new Error('Connection was closed. Create another invitation.'));\n        } else if (peer.iceGatheringState === 'complete') {\n          clearTimeout(timeout);\n          peer.removeEventListener('icegatheringstatechange', done);\n          resolve();\n        }\n      }\n      peer.addEventListener('icegatheringstatechange', done);\n    });\n  }\n\n  async function encode(description) {\n    const raw = new TextEncoder().encode(JSON.stringify({ type: description.type, sdp: description.sdp }));\n    let data = raw;\n    let prefix = 'CB1';\n    if (globalThis.CompressionStream) {\n      data = new Uint8Array(await new Response(new Blob([raw]).stream().pipeThrough(new CompressionStream('gzip'))).arrayBuffer());\n      prefix = 'CBZ1';\n    }\n    return prefix + '.' + btoa(String.fromCharCode(...data)).replaceAll('+', '-').replaceAll('/', '_').replace(/=+$/, '');\n  }\n\n  async function decode(code, expected) {\n    const clean = String(code).trim().replace(/\\s/g, '');\n    if (clean.length > 20000) throw new Error('That code is too long. Paste only the ComBop code.');\n    const match = /^(CBZ?1)\\.([A-Za-z0-9_-]+)$/.exec(clean);\n    if (!match) throw new Error('Paste a complete ComBop invitation or return code.');\n    try {\n      let bytes = Uint8Array.from(atob(match[2].replaceAll('-', '+').replaceAll('_', '/')), c => c.charCodeAt(0));\n      if (match[1] === 'CBZ1') {\n        if (!globalThis.DecompressionStream) throw new Error('Compression is unavailable.');\n        bytes = new Uint8Array(await new Response(new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'))).arrayBuffer());\n      }\n      if (bytes.length > 40000) throw new Error('Code too large.');\n      const result = JSON.parse(new TextDecoder().decode(bytes));\n      if (result.type !== expected || typeof result.sdp !== 'string' || !result.sdp.startsWith('v=0')) throw new Error('Unexpected code type.');\n      return result;\n    } catch {\n      throw new Error(expected === 'offer' ? 'That is not an invitation code. Ask the host for a new one.' : 'That is not a return code. Paste the code your opponent sent back.');\n    }\n  }\n\n  async function host() {\n    const peer = newPeer(true);\n    status('Creating invitation…');\n    await peer.setLocalDescription(await peer.createOffer());\n    await iceComplete(peer);\n    const code = await encode(peer.localDescription);\n    status('Invitation ready • send it to your opponent');\n    return code;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' ComBop-Combat-1977-gpt-6.1-sol-ultra-20261105-212552/audio.js && tail -n 80 ComBop-Combat-1977-gpt-6.1-sol-ultra-20261105-212552/hub.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' ComBop-Combat-1977-gpt-6.1-sol-ultra-20261105-212552/audio.js && tail -n 80 ComBop-Combat-1977-gpt-6.1-sol-ultra-20261105-212552/hub.js\"","aggregated_output":"/* ComBop — every sound is synthesized here. No samples or audio downloads. */\nconst clamp01 = value => Math.max(0, Math.min(1, Number(value) || 0));\n\nexport class AudioSystem {\n  constructor({ context = null } = {}) {\n    this.ctx = null;\n    this.musicVolume = .10;\n    this.sfxVolume = .70;\n    this.muted = false;\n    this.musicPlaying = false;\n    this.musicStep = 0;\n    this.nextNote = 0;\n    this.voices = 0;\n    this.events = {};\n    this.lastSounds = {};\n    this.lastVoice = -10;\n    this.activeNodes = 0;\n    if (context) this._setup(context);\n  }\n\n  _setup(context) {\n    this.ctx = context;\n    this.master = context.createGain();\n    this.master.gain.value = this.muted ? 0 : .72;\n    this.limiter = context.createDynamicsCompressor();\n    this.limiter.threshold.value = -14;\n    this.limiter.knee.value = 12;\n    this.limiter.ratio.value = 5;\n    this.limiter.attack.value = .003;\n    this.limiter.release.value = .14;\n    this.musicBus = context.createGain();\n    this.musicBus.gain.value = this.musicVolume;\n    this.sfxBus = context.createGain();\n    this.sfxBus.gain.value = this.sfxVolume;\n    this.voiceBus = context.createGain();\n    this.voiceBus.gain.value = this.sfxVolume * .70;\n    this.musicBus.connect(this.master);\n    this.sfxBus.connect(this.master);\n    this.voiceBus.connect(this.master);\n    this.master.connect(this.limiter);\n    this.analyser = context.createAnalyser();\n    this.analyser.fftSize = 256;\n    this.limiter.connect(this.analyser);\n    this.analyser.connect(context.destination);\n    this.noise = context.createBuffer(1, context.sampleRate * 2, context.sampleRate);\n    const data = this.noise.getChannelData(0);\n    let seed = 1977;\n    for (let i = 0; i < data.length; i++) {\n      seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;\n      data[i] = seed / 2147483648 - 1;\n    }\n  }\n\n  async unlock() {\n    try {\n      if (!this.ctx) {\n        const Context = globalThis.AudioContext || globalThis.webkitAudioContext;\n        if (!Context) return false;\n        this._setup(new Context());\n      }\n      if (this.ctx.state === 'suspended' && !('startRendering' in this.ctx)) await this.ctx.resume();\n      return true;\n    } catch {\n      return false;\n    }\n  }\n\n  _gain(parameter, value, seconds = .03) {\n    if (parameter && this.ctx) parameter.setTargetAtTime(value, this.ctx.currentTime, seconds);\n  }\n  setMusic(value) {\n    this.musicVolume = clamp01(value);\n    this._gain(this.musicBus?.gain, this.musicVolume);\n  }\n  setSfx(value) {\n    this.sfxVolume = clamp01(value);\n    this._gain(this.sfxBus?.gain, this.sfxVolume);\n    this._gain(this.voiceBus?.gain, this.sfxVolume * .70);\n  }\n  setMuted(value) {\n    this.muted = !!value;\n    this._gain(this.master?.gain, this.muted ? 0 : .72, .01);\n  }\n  startMusic() {\n    if (this.musicPlaying) return;\n    this.musicPlaying = true;\n    this.musicStep = 0;\n    this.nextNote = (this.ctx?.currentTime || 0) + .025;\n  }\n  stopMusic() { this.musicPlaying = false; }\n\n  _track(source, end, nodes = []) {\n    this.activeNodes++;\n    source.onended = () => {\n      source.disconnect();\n      nodes.forEach(node => node.disconnect());\n      this.activeNodes = Math.max(0, this.activeNodes - 1);\n    };\n    source.stop(end);\n  }\n\n  _tone(freq, time, duration, volume, type = 'triangle', bus = this.sfxBus, endFreq = freq, attack = .004) {\n    const ctx = this.ctx;\n    const oscillator = ctx.createOscillator();\n    const gain = ctx.createGain();\n    oscillator.type = type;\n    oscillator.frequency.setValueAtTime(Math.max(20, freq), time);\n    oscillator.frequency.exponentialRampToValueAtTime(Math.max(20, endFreq), time + duration);\n    gain.gain.setValueAtTime(.0001, time);\n    gain.gain.exponentialRampToValueAtTime(Math.max(.0002, volume), time + Math.min(attack, duration * .25));\n    gain.gain.exponentialRampToValueAtTime(.0001, time + duration);\n    oscillator.connect(gain);\n    gain.connect(bus);\n    oscillator.start(time);\n    this._track(oscillator, time + duration + .01, [gain]);\n  }\n\n  _noise(time, duration, volume, frequency, type = 'lowpass', bus = this.sfxBus) {\n    const ctx = this.ctx;\n    const source = ctx.createBufferSource();\n    source.buffer = this.noise;\n    const filter = ctx.createBiquadFilter();\n    filter.type = type;\n    filter.frequency.value = frequency;\n    filter.Q.value = .7;\n    const gain = ctx.createGain();\n    gain.gain.setValueAtTime(.0001, time);\n    gain.gain.exponentialRampToValueAtTime(Math.max(.0002, volume), time + .003);\n    gain.gain.exponentialRampToValueAtTime(.0001, time + duration);\n    source.connect(filter);\n    filter.connect(gain);\n    gain.connect(bus);\n    source.start(time);\n    this._track(source, time + duration + .01, [filter, gain]);\n  }\n\n  sfx(name, intensity = 1) {\n    if (!this.ctx || this.ctx.state === 'closed') return;\n    const t = this.ctx.currentTime + .002;\n    if (t - (this.lastSounds[name] ?? -10) < (name === 'bounce' ? .018 : .035)) return;\n    this.lastSounds[name] = t;\n    this.events[name] = (this.events[name] || 0) + 1;\n    const v = Math.max(.05, Math.min(1.5, intensity));\n    switch (name) {\n      case 'shoot':\n        this._tone(210, t, .13, .30 * v, 'square', this.sfxBus, 48);\n        this._tone(75, t, .18, .26 * v, 'sine', this.sfxBus, 32);\n        this._noise(t, .075, .21 * v, 2000);\n        break;\n      case 'bounce':\n        this._tone(1150, t, .085, .14 * v, 'triangle', this.sfxBus, 720);\n        this._tone(1670, t, .06, .06 * v, 'sine', this.sfxBus, 1100);\n        break;\n      case 'hit':\n        this._tone(330, t, .16, .24 * v, 'square', this.sfxBus, 85);\n        this._tone(710, t, .095, .14 * v, 'triangle', this.sfxBus, 240);\n        this._noise(t, .14, .25 * v, 1500);\n        break;\n      case 'explode':\n        this._noise(t, .63, .65 * v, 1000);\n        this._noise(t, .14, .28 * v, 2800);\n        this._tone(115, t, .57, .60 * v, 'sine', this.sfxBus, 24);\n        this._tone(62, t + .055, .37, .30 * v, 'triangle', this.sfxBus, 27);\n        break;\n      case 'dash':\n        this._noise(t, .22, .22 * v, 1900, 'bandpass');\n        this._tone(125, t, .20, .14 * v, 'sawtooth', this.sfxBus, 420);\n        break;\n      case 'pickup':\n      case 'respawn':\n        [523.25, 659.25, 783.99, 1046.5].forEach((f, i) => this._tone(f, t + i * .065, .22, .15 * v, 'triangle'));\n        break;\n      case 'click':\n        this._tone(620, t, .035, .12 * v, 'triangle', this.sfxBus, 900);\n        break;\n      case 'start':\n        [261.63, 392, 523.25].forEach((f, i) => this._tone(f, t + i * .11, .24, .20 * v, 'square'));\n        this._noise(t + .25, .15, .13 * v, 5500, 'highpass');\n        break;\n      case 'win':\n    await peer.setRemoteDescription(offer);\n    await peer.setLocalDescription(await peer.createAnswer());\n    await iceComplete(peer);\n    const code = await encode(peer.localDescription);\n    status('Return code ready • send it back to the host');\n    return code;\n  }\n\n  async function accept(answer) {\n    if (!pc || !state.isHost || pc.signalingState !== 'have-local-offer') throw new Error('Create an invitation first.');\n    const description = await decode(answer, 'answer');\n    status('Connecting to your opponent…');\n    await pc.setRemoteDescription(description);\n    // The data channel's open event starts the match on both peers.\n  }\n\n  function sendInput(input) {\n    if (state.isHost) return false;\n    const now = performance.now();\n    if (now - lastInput < 55) return false;\n    const cleaned = cleanInput(input);\n    if (!cleaned) return false;\n    lastInput = now;\n    return send({ type: 'input', input: cleaned });\n  }\n\n  function sendSnapshot(snapshot) {\n    if (!state.isHost) return false;\n    const now = performance.now();\n    if (now - lastSnapshot < 55) return false;\n    lastSnapshot = now;\n    return send({ type: 'snapshot', state: snapshot });\n  }\n\n  function finish(scores, stats) {\n    if (!state.isHost || state.ended || resultSent) return false;\n    const values = state.players.map((p, i) => Number.isFinite(Number(scores?.[i])) ? Number(scores[i]) : 0);\n    if (state.inHub) {\n      const players = state.players.filter(p => liveIds.has(p.id));\n      players.sort((a, b) => values[state.players.indexOf(b)] - values[state.players.indexOf(a)]);\n      const standings = [];\n      for (const player of players) {\n        const value = values[state.players.indexOf(player)];\n        const previous = standings.at(-1);\n        if (previous && values[state.players.findIndex(p => p.id === previous[0])] === value) previous.push(player.id);\n        else standings.push([player.id]);\n      }\n      const byId = Object.fromEntries(state.players.filter(p => liveIds.has(p.id)).map((p, i) => [p.id, values[state.players.indexOf(p)]]));\n      globalThis.AIHub.finish({ standings, scores: byId, ...(stats ? { stats } : {}) });\n    } else send({ type: 'finish', scores: values }, true);\n    resultSent = true;\n    return true;\n  }\n\n  function closePeer() {\n    generation++;\n    if (channel) { channel.onclose = null; channel.onerror = null; channel.onmessage = null; channel.onopen = null; channel.close(); }\n    if (pc) { pc.onconnectionstatechange = null; pc.ondatachannel = null; pc.close(); }\n    pc = channel = null;\n  }\n\n  function leave() {\n    // A hub round controls its own lifetime; an in-game Quit never leaves it.\n    if (state.inHub) return false;\n    const wasActive = state.active;\n    if (wasActive) disconnect('left');\n    closePeer();\n    Object.assign(state, { active: false, connected: false, started: false, transport: 'none' });\n    status('Offline');\n    return true;\n  }\n\n  const api = {\n    connectHub, ready, host, join, accept, sendInput, sendSnapshot, finish, leave,\n    time: () => state.inHub ? globalThis.AIHub.time() : state.started ? performance.now() - startedAt : -Infinity,\n    inspect: () => ({ ...info(), status: currentStatus, resultSent, peerState: pc?.connectionState || 'none', channelState: channel?.readyState || 'none' }),\n  };\n  for (const key of ['active', 'inHub', 'isHost', 'isServer', 'seat', 'players', 'connected', 'started', 'ended']) Object.defineProperty(api, key, { get: () => state[key] });\n  return api;\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"cat > ComBop-Combat-1977-gpt-6.1-sol-ultra-20261105-212552/app.js <<'EOF'\nimport {Simulation,MAPS,DEFAULTS} from './sim.js';\nimport {GameView} from './view.js';\nimport {AudioSystem} from './audio.js';\nimport {createOnline} from './hub.js';\n// CREDITS_DATA\nconst \"'$=id=>document.getElementById(id);\nconst app={ready:false,screen:'\"'loading',mode:'solo',round:0,lastInput:performance.now(),inputMode:'keyboard',previous:'title',settings:{music:.1,sfx:.7,glyph:'ps',assist:true,shake:true,arena:0},completed:[],toastUntil:0,announceUntil:0,attractElapsed:0,attractRound:0,remote:null,eventId:0,events:[],lastRemoteEvent:0,finishPending:false,hubEnded:false,keys:new Set(),pads:[],padPrev:[],padRepeat:0,mouse:{x:innerWidth*.6,y:innerHeight*.5,down:false,active:false},touches:new Map(),touchDash:false,debugInputs:[null,null]};\nconst audio=new AudioSystem();let sim,view;let accumulator=0;let lastFrame=0;let menuFocus=null;\nconst online=createOnline({\n onStatus(text){\"'$('\"'online-status').textContent=text;},\n onInput(input,seat){if(sim&&seat>=0){sim.input(seat,input);app.remoteInputAt=performance.now();}},\n onSnapshot(state){if(\"'!state?.tanks||state.tanks.length!==2)return;app.remote=state;if(state.round!==app.round){app.round=state.round;view?.build(state.round);}for(const ev of state.events||[]){if(ev.id>app.lastRemoteEvent){app.lastRemoteEvent=ev.id;handleEffect(ev.type,ev.data,false);}}if(state.ended&&app.screen==='\"'play')roundover({winner:state.winner,scores:state.scores},false);},\n onPeer(info){if(\"'!info.joined&&app.mode==='\"'online'&&\"'!app.hubEnded)toast(info.name+'\"' left the rumble.');},\n onStart(info){if(\"'!app.ready)return;app.hubEnded=false;app.lastRemoteEvent=0;app.remote=null;startGame('\"'online',app.settings.arena);\"'$('\"'online-status').textContent='Connected. Let the rumble begin\"'!'\"';},\n onTimeUp(){if(online.isHost&&sim){sim.ended=true;sim.winner=sim.scores[0]>=sim.scores[1]?0:1;online.finish(sim.scores,{shots:sim.metrics.shots,bounces:sim.metrics.bounces});}},\n onEnd(info){if(\"'!sim)return;app.hubEnded=online.inHub;app.finishPending=false;if(info.scores&&Array.isArray(info.scores)){sim.scores=[...info.scores];if(app.remote)app.remote.scores=[...info.scores];}if(online.inHub){audio.stopMusic();audio.setMuted(true);}if(app.mode==='\"'online'&&app.screen\"'!=='\"'roundover'){const s=app.remote||sim;roundover({winner:s.scores[0]>=s.scores[1]?0:1,scores:s.scores},false);if(info.reason\"'!=='\"'finished'&&\"'!online.inHub){$('\"'roundover-title').textContent='The radio went quiet.';\"'$('\"'roundover-copy').textContent='Your opponent disconnected. Return to title to create a fresh invitation.';}}applyHubUI();}\n});\nfunction applyHubUI(){if(\"'!online.inHub)return;document.querySelectorAll('\"'[data-action=\\\"title\\\"],[data-action=\\\"solo\\\"],[data-action=\\\"local\\\"],[data-action=\\\"online\\\"],[data-action=\\\"next-round\\\"]').forEach(b=>b.classList.add('hidden'));\"'$('\"'dev-button').disabled=true;\"'$('\"'pause-copy').textContent='Online play keeps moving during a pit stop.';}\nfunction gesture(mode='keyboard'){app.lastInput=performance.now();if(app.inputMode\"'!==mode){app.inputMode=mode;document.body.classList.toggle('\"'touch',mode==='touch');updatePrompts();}if(\"'!app.hubEnded){audio.unlock().then(ok=>{if(ok&&!audio.musicPlaying)audio.startMusic();});}}\nfunction activity(mode='\"'keyboard'){if(app.screen==='attract'){exitAttract();gesture(mode);return true;}gesture(mode);return false;}\nfunction toast(text,time=2.5){\"'$('\"'toast').textContent=text;\"'$('\"'toast').classList.add('show');app.toastUntil=performance.now()+time*1000;}\nfunction announce(text,time=1.5){\"'$('\"'announce').textContent=text;\"'$('\"'announce').classList.add('show');app.announceUntil=performance.now()+time*1000;}\nfunction focusables(){const panel=document.querySelector('.screen.active');return panel?[...panel.querySelectorAll('button,input,select,textarea')].filter(b=>\"'!b.disabled&&!b.closest('\"'.hidden')&&b.offsetParent\"'!==null):[];}\nfunction setFocus(b,real=true){document.querySelectorAll('\"'.focused').forEach(x=>x.classList.remove('focused'));menuFocus=b;if(b){b.classList.add('focused');if(real)b.focus({preventScroll:true});}}\nfunction refreshFocus(){const f=focusables();setFocus(f[0],false);}\nfunction show(screen,remember=true){if(remember&&['settings','guide','about','dev'].includes(screen))app.previous=app.screen;app.screen=screen;for(const e of document.querySelectorAll('.screen'))e.classList.toggle('active',e.id===screen+'-screen');const playing=screen==='play'||screen==='attract'||app.mode==='online'&&['paused','settings','guide','dev'].includes(screen);\"'$('\"'hud').style.display=playing?'block':'none';\"'$('\"'pause-button').style.display=screen==='attract'?'none':'block';\"'$('\"'attract-bar').style.display=screen==='attract'?'block':'none';\"'$('\"'dash-touch').style.display=screen==='play'&&app.inputMode==='touch'?'block':'none';\"'$('\"'announce').classList.remove('show');app.mouse.down=false;app.keys.clear();app.touches.clear();\"'$('\"'touch-ring').style.display='none';app.touchDash=false;refreshFocus();if(screen==='about')renderCredits('sourceInformation');if(screen==='dev')refreshDev();applyHubUI();}\nfunction goBack(){if(app.screen==='paused'){show('play',false);return;}if(['settings','guide','about','dev'].includes(app.screen)){show(app.previous==='settings'?'paused':app.previous,false);return;}if(app.screen==='online'){online.leave();show('title',false);app.lastInput=performance.now();return;}if(app.screen==='play'){show('paused',false);\"'$('\"'pause-copy').textContent=app.mode==='online'?'Online play keeps moving during a pit stop.':'Your tank can catch its breath.';return;}}\nfunction title(){if(online.inHub)return;app.mode='solo';online.leave();app.remote=null;app.finishPending=false;app.debugInputs=[null,null];sim.reset(0,'solo');view.build(0);app.round=0;app.lastInput=performance.now();audio.setMuted(false);show('title',false);}\nfunction startGame(mode='solo',round=0){app.mode=mode;app.round=round;app.remote=null;app.debugInputs=[null,null];app.finishPending=false;app.hubEnded=false;app.events=[];if(mode==='solo'&&round===0)app.completed=[];sim.reset(round,mode,mode==='solo'&&round>0);view.build(round);show('play',false);audio.setMuted(false);audio.sfx('start');audio.voice('start');announce(mode==='local'?'A little friendly fire.':MAPS[round].name,2);if(mode==='local')toast('TEAL: WASD + mouse  ·  CORAL: arrows + IJKL / Enter / Shift',6);if(mode==='solo')toast(MAPS[round].rule,4);if(mode==='online')applyHubUI();}\nfunction roundover(data,finish=true){if(app.screen==='attract')return;const won=data.winner===0;show('roundover',false);\"'$('\"'roundover-kicker').textContent=app.mode==='solo'?\"'`CIRCUIT / BOUT ${app.round+1} OF 3`:'\"'DUEL COMPLETE';\"'$('\"'roundover-title').textContent=app.mode==='solo'?(won?'Well bopped.':'A minor dent in the plan.'):data.winner===0?'Teal takes the cake.':'Coral makes a comeback.';\"'$('\"'roundover-copy').textContent=app.mode==='solo'?(won?(app.round<2?'One down. Keep the good angles coming.':'All three bouts in the bag. That’s some fine tanking.'):'The rival found your angle. Retry this bout and give them a little bop back.'):'A good clean rumble. Mostly.';\"'$('\"'roundover-score').innerHTML=\"'`${Number(data.scores[0])} : <span>${Number(data.scores[1])}</span>`;const next=$('\"'next-round');next.classList.remove('hidden');next.textContent=app.mode==='solo'?(won?(app.round<2?'Next arena ↗':'Collect your trophy ↗'):'Try this bout again ↗'):'Rematch ↗';if(app.mode==='online'){next.classList.add('hidden');\"'$('\"'roundover-copy').textContent=online.inHub?'Round complete. AI Hub has the result.':'Duel complete. Return to title for a fresh connection.';if(finish&&online.isHost)app.finishPending=true;}if(app.mode==='solo'&&won&&\"'!app.completed.includes(app.round))app.completed.push(app.round);audio.sfx(won?'\"'win':'lose');audio.voice(won?'win':'lose');refreshFocus();}\nfunction nextRound(){if(app.mode==='solo'){if(sim.winner===0){if(app.round===2){show('results',false);\"'$('\"'results-stats').textContent=\"'`${sim.metrics.shots} shells sent · ${sim.metrics.bounces} good bounces · ${sim.metrics.bankshots} bankshot wrecks`;return;}startGame('\"'solo',app.round+1);}else startGame('solo',app.round);}else if(app.mode==='local')startGame('local',app.round);}\nfunction enterAttract(){if(online.inHub||app.screen\"'!=='\"'title')return;app.mode='attract';app.attractElapsed=0;app.attractRound=0;app.round=0;sim.reset(0,'attract');view.build(0);show('attract',false);}\nfunction exitAttract(){app.mode='solo';sim.reset(0,'solo');app.round=0;view.build(0);app.lastInput=performance.now();show('title',false);}\nfunction handleEffect(type,data,replicate=true){if(\"'!view)return;if(replicate&&app.mode==='\"'online'&&online.isHost){app.events.push({id:++app.eventId,type,data});if(app.events.length>18)app.events.shift();}if(type==='roundover'){roundover(data);return;}view.effect(type,data);audio.sfx(type==='barrel'?'explode':type==='cover'||type==='chip'?'hit':type,.7);if(type==='hit'&&data.bank)announce('A good angle\"'!'\"',.8);if(type==='explode')announce(data.bank?'Bank you very much\"'!'\"':data.tank===0?'A minor setback.':'BOP\"'!'\"',1.2);if(type==='pickup'&&data.tank===(app.mode==='online'?online.seat:0)){toast(data.type==='repair'?'Armour patched. Back to it.':'DOUBLE TIME · seven seconds of rapid fire',2);audio.voice('pickup');}if(type==='sudden'){announce('Hot zone\"'! Keep moving.'\"',2);audio.voice('start');}}\nconst settingsDefaults={music:.1,sfx:.7,glyph:'ps',assist:true,shake:true,arena:0};\nfunction loadSettings(){try{const v=JSON.parse(localStorage.getItem('combop-settings')||'null');if(v){app.settings={...settingsDefaults,...v};app.settings.music=Math.max(0,Math.min(1,+app.settings.music||0));app.settings.sfx=Math.max(0,Math.min(1,+app.settings.sfx||0));}}catch{}syncSettings();}\nfunction syncSettings(){\"'$('\"'music-volume').value=app.settings.music*100;\"'$('\"'music-value').textContent=Math.round(app.settings.music*100)+'%';\"'$('\"'sfx-volume').value=app.settings.sfx*100;\"'$('\"'sfx-value').textContent=Math.round(app.settings.sfx*100)+'%';\"'$('\"'glyph-style').value=app.settings.glyph;\"'$('\"'assist').value=app.settings.assist?'on':'off';\"'$('\"'shake').value=app.settings.shake?'on':'off';\"'$('\"'arena-select').value=app.settings.arena;audio.setMusic(app.settings.music);audio.setSfx(app.settings.sfx);updatePrompts();}\nfunction saveSettings(){try{localStorage.setItem('combop-settings',JSON.stringify(app.settings));}catch{}syncSettings();}\nfunction updatePrompts(){const pad=app.inputMode==='gamepad',xbox=app.settings.glyph==='xbox';const values=pad?{move:'L',aim:'R',fire:xbox?'RT':'R2',dash:xbox?'B':'○'}:{move:'WASD',aim:'Mouse',fire:'LMB',dash:'Space'};for(const el of document.querySelectorAll('.prompt')){el.textContent=values[el.dataset.prompt];el.className='prompt glyph'+(pad?' pad':'');}\"'$('\"'title-prompt').textContent=app.inputMode==='touch'?'Drag to drive · Aim & fire assisted':pad?'Left stick to move · × to select':'WASD + mouse · Controller ready';}\nconst devSpecs=[['speed','Tank speed',2,10,.1],['shellSpeed','Shell speed',8,28,.5],['reload','Shell refill time',.2,2,.05],['ai','Rival skill',.3,1.4,.05],['ricochets','Wall bounces',0,5,1],['damage','Shell damage',1,3,1]];\nfunction buildDev(){for(const [key,label,min,max,step]of devSpecs){const row=document.createElement('div');row.className='setting';row.innerHTML=\"'`<label for=\"dev-${key}\">${label}</label><div class=\"range-wrap\"><input id=\"dev-${key}\" data-dev=\"${key}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${DEFAULTS[key]}\"><output id=\"dev-value-${key}\">${DEFAULTS[key]}</output></div>`;$('\"'dev-sliders').append(row);row.querySelector('input').addEventListener('input',e=>{sim.balance[key]=Number(e.target.value);\"'$('\"'dev-value-'+key).textContent=Number(e.target.value).toFixed(key==='reload'||key==='ai'?2:1).replace(/\\\\.0\"'$/,'\"'');});}}\nfunction refreshDev(){for(const [key]of devSpecs){\"'$('\"'dev-'+key).value=sim.balance[key];\"'$('\"'dev-value-'+key).textContent=sim.balance[key];}\"'$('\"'dev-god').textContent='Invulnerable: '+(sim.god?'on':'off');}\nconst feedbackQuestions={testingFeedback:['How many issues did testing catch?','How many were critical or game breaking?','Most helpful test','Least helpful test'],engineFeedback:['What did you like most about the engine?','Did you get stuck or guess wrong?','Most important thing built yourself','Hardest part about using the engine','Engine changes','One thing you would change'],promptFeedback:['What did you like most about this prompt?','What was confusing?','Hardest thing to do','What would you change?']};\nfunction renderCredits(tab){const root=\"'$('\"'credits-body');root.replaceChildren();document.querySelectorAll('[data-credit]').forEach(b=>b.classList.toggle('primary',b.dataset.credit===tab));if(tab==='sourceInformation'){const dl=document.createElement('dl');dl.className='credits-grid';for(const [key,value]of Object.entries(CREDITS.sourceInformation)){const dt=document.createElement('dt');dt.textContent=key.replace(/([A-Z])/g,' \"'$1'\"').replace(/\"'^./,s=>s.toUpperCase());const dd=document.createElement('\"'dd');dd.textContent=value;dl.append(dt,dd);}root.append(dl);}else{CREDITS[tab].forEach((value,i)=>{const section=document.createElement('div');section.className='feedback-item';const h=document.createElement('strong');h.textContent=feedbackQuestions[tab][i]||'';const p=document.createElement('p');p.textContent=value;section.append(h,p);root.append(section);});}root.scrollTop=0;}\nasync function action(name){audio.sfx('click');switch(name){case'solo':startGame('solo',0);break;case'local':startGame('local',app.settings.arena);break;case'online':show('online');break;case'pause':if(app.screen==='play')goBack();break;case'resume':show('play',false);break;case'back':goBack();break;case'title':title();break;case'settings':case'guide':case'about':case'dev':show(name);break;case'next-round':nextRound();break;case'reset-settings':app.settings={...settingsDefaults};saveSettings();toast('Factory-fresh settings.');break;case'dev-reset':sim.balance={...DEFAULTS};sim.god=false;refreshDev();break;case'dev-god':sim.god=\"'!sim.god;refreshDev();break;case'\"'dev-next':show('play',false);sim.scores[0]=2;sim.award(0);break;case'dev-repair':for(const t of sim.tanks){t.hp=3;t.ammo=3;if(t.dead>0)sim.respawn(t);}toast('Both tanks repaired.');break;case'dev-time':sim.time=0;toast('Hot zone begins when you resume.');break;case'host-online':try{\"'$('\"'host-online').disabled=true;\"'$('\"'online-code').value=await online.host();\"'$('\"'code-label').textContent='Your invitation — copy and send to your friend';\"'$('\"'code-help').textContent='After your friend joins, replace this invitation with their return code and choose Accept return code.';}catch(e){toast(e.message,5);}finally{\"'$('\"'host-online').disabled=false;}break;case'join-online':try{const invite=\"'$('\"'online-code').value;\"'$('\"'join-online').disabled=true;const answer=await online.join(invite);\"'$('\"'online-code').value=answer;\"'$('\"'code-label').textContent='Your return code — send it back to the host';\"'$('\"'code-help').textContent='Keep this screen open. The duel starts when the host accepts your return code.';}catch(e){toast(e.message,5);}finally{\"'$('\"'join-online').disabled=false;}break;case'accept-code':try{await online.accept(\"'$('\"'online-code').value);}catch(e){toast(e.message,5);}break;case'copy-code':try{await navigator.clipboard.writeText(\"'$('\"'online-code').value);toast('Code copied.');}catch{\"'$('\"'online-code').select();toast('Select and copy the code from the box.');}break;}}\nfunction wireUI(){document.querySelectorAll('[data-action]').forEach(b=>{b.addEventListener('click',()=>action(b.dataset.action));b.addEventListener('pointerenter',()=>{if(app.inputMode\"'!=='\"'touch')setFocus(b,false);});});document.querySelectorAll('[data-credit]').forEach(b=>b.addEventListener('click',()=>renderCredits(b.dataset.credit)));for(const [id,key,convert]of [['music-volume','music',v=>Number(v)/100],['sfx-volume','sfx',v=>Number(v)/100],['glyph-style','glyph',v=>v],['assist','assist',v=>v==='on'],['shake','shake',v=>v==='on'],['arena-select','arena',v=>Number(v)]]){\"'$(id).addEventListener('\"'input',e=>{app.settings[key]=convert(e.target.value);saveSettings();});}}\nfunction moveMenu(dir){const list=focusables();if(\"'!list.length)return;let i=list.indexOf(menuFocus);i=(i+dir+list.length)%list.length;setFocus(list[i]);audio.sfx('\"'click',.5);list[i].scrollIntoView({block:'nearest'});}\nfunction adjustMenu(dir){const e=menuFocus;if(e?.tagName==='INPUT'&&e.type==='range'){e.value=Number(e.value)+Number(e.step||1)*dir;e.dispatchEvent(new Event('input',{bubbles:true}));}else if(e?.tagName==='SELECT'){e.selectedIndex=(e.selectedIndex+dir+e.options.length)%e.options.length;e.dispatchEvent(new Event('input',{bubbles:true}));}else moveMenu(dir);}\nfunction activateMenu(){if(menuFocus?.tagName==='BUTTON')menuFocus.click();else if(menuFocus?.tagName==='SELECT')adjustMenu(1);}\nfunction isEditing(e){return ['TEXTAREA','INPUT','SELECT'].includes(e?.tagName);}\nwindow.addEventListener('keydown',e=>{if(isEditing(e.target)){app.lastInput=performance.now();if(e.code==='Escape'){e.target.blur();goBack();}return;}if(activity('keyboard')){e.preventDefault();return;}if(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Tab','Enter'].includes(e.code))e.preventDefault();if(e.repeat)return;if(e.code==='Escape'){goBack();return;}if(app.screen==='play'){app.keys.add(e.code);return;}if(e.code==='ArrowDown'||e.code==='KeyS'||e.code==='Tab')moveMenu(e.shiftKey?-1:1);if(e.code==='ArrowUp'||e.code==='KeyW')moveMenu(-1);if(e.code==='ArrowLeft'||e.code==='KeyA')adjustMenu(-1);if(e.code==='ArrowRight'||e.code==='KeyD')adjustMenu(1);if(e.code==='Enter'||e.code==='Space')activateMenu();});\nwindow.addEventListener('keyup',e=>{app.keys.delete(e.code);});\nwindow.addEventListener('blur',()=>{app.keys.clear();app.mouse.down=false;app.touches.clear();if(app.ready&&app.screen==='play'&&app.mode\"'!=='\"'online')show('paused',false);});\nwindow.addEventListener('pointerdown',e=>{if(app.screen==='attract'){e.preventDefault();e.stopImmediatePropagation();exitAttract();gesture(e.pointerType==='touch'?'touch':'keyboard');return;}gesture(e.pointerType==='touch'?'touch':'keyboard');},true);\nwindow.addEventListener('pointermove',e=>{if(e.pointerType==='mouse'){if(app.screen==='attract'){exitAttract();gesture('keyboard');return;}if(e.movementX||e.movementY)gesture('keyboard');app.mouse.x=e.clientX;app.mouse.y=e.clientY;app.mouse.active=true;}else if(app.touches.has(e.pointerId)){const t=app.touches.get(e.pointerId);t.x=e.clientX;t.y=e.clientY;gesture('touch');}},{passive:true});\n\"'$('\"'world').style.touchAction='none';\"'$('\"'world').addEventListener('contextmenu',e=>e.preventDefault());\"'$('\"'world').addEventListener('pointerdown',e=>{if(app.screen\"'!=='\"'play')return;if(e.pointerType==='touch'){app.touches.set(e.pointerId,{x:e.clientX,y:e.clientY,sx:e.clientX,sy:e.clientY,side:e.clientX<innerWidth*.5?'left':'right'});\"'$('\"'world').setPointerCapture(e.pointerId);if(e.clientX<innerWidth*.5){\"'$('\"'touch-ring').style.cssText=\"'`display:block;left:${e.clientX-55}px;top:${e.clientY-55}px`;}}else if(e.button===0)app.mouse.down=true;});\nwindow.addEventListener('\"'pointerup',e=>{app.mouse.down=false;if(app.touches.has(e.pointerId)){const t=app.touches.get(e.pointerId);if(t.side==='left')\"'$('\"'touch-ring').style.display='none';app.touches.delete(e.pointerId);}if(e.target===\"'$('\"'dash-touch'))app.touchDash=false;});window.addEventListener('pointercancel',e=>{app.mouse.down=false;app.touches.delete(e.pointerId);app.touchDash=false;\"'$('\"'touch-ring').style.display='none';});\n\"'$('\"'dash-touch').addEventListener('pointerdown',e=>{e.preventDefault();gesture('touch');app.touchDash=true;});\nfunction getPads(now){const pads=Array.from(navigator.getGamepads?.()||[]).filter(Boolean);app.pads=pads;let menuUsed=false;for(let i=0;i<pads.length;i++){const p=pads[i],prev=app.padPrev[p.index]||{buttons:[],axes:[]};const pressed=n=>\"'!!p.buttons[n]?.pressed||p.buttons[n]?.value>.25;const edge=n=>pressed(n)&&!prev.buttons[n];const meaningful=p.axes.some(a=>Math.abs(a)>.25)||p.buttons.some(b=>b.pressed||b.value>.25);if(meaningful){if(activity('\"'gamepad')){app.padPrev[p.index]={buttons:p.buttons.map(b=>b.pressed||b.value>.25),axes:[...p.axes]};return;}if(edge(9)&&\"'!pressed(8)){if(app.screen==='\"'play'||app.screen==='paused')goBack();menuUsed=true;}if(app.screen\"'!=='\"'play'&&app.screen\"'!=='\"'attract'&&now>app.padRepeat){if(edge(0)){activateMenu();app.padRepeat=now+200;menuUsed=true;}else if(edge(1)){goBack();app.padRepeat=now+200;menuUsed=true;}else if(pressed(12)||p.axes[1]<-.5){moveMenu(-1);app.padRepeat=now+220;}else if(pressed(13)||p.axes[1]>.5){moveMenu(1);app.padRepeat=now+220;}else if(pressed(14)||p.axes[0]<-.5){adjustMenu(-1);app.padRepeat=now+180;}else if(pressed(15)||p.axes[0]>.5){adjustMenu(1);app.padRepeat=now+180;}}}app.padPrev[p.index]={buttons:p.buttons.map(b=>b.pressed||b.value>.25),axes:[...p.axes]};}return menuUsed;}\nfunction localInput(seat){const k=app.keys;let v={mx:0,mz:0,ax:0,az:0,fire:false,dash:false};if(seat===0){v.mx=+k.has('KeyD')-+k.has('KeyA');v.mz=+k.has('KeyS')-+k.has('KeyW');if(app.mode\"'!=='\"'local'){v.mx+=+k.has('ArrowRight')-+k.has('ArrowLeft');v.mz+=+k.has('ArrowDown')-+k.has('ArrowUp');}v.fire=app.mouse.down;v.dash=k.has('Space');if(app.mouse.active){const t=(app.remote||sim).tanks[app.mode==='online'?Math.max(0,online.seat):0],p=view.worldPoint(app.mouse.x,app.mouse.y);v.ax=p.x-t.x;v.az=p.z-t.z;}}\n else{v.mx=+k.has('ArrowRight')-+k.has('ArrowLeft');v.mz=+k.has('ArrowDown')-+k.has('ArrowUp');v.ax=+k.has('KeyL')-+k.has('KeyJ');v.az=+k.has('KeyK')-+k.has('KeyI');v.fire=k.has('Enter')||k.has('NumpadEnter');v.dash=k.has('ShiftRight')||k.has('ShiftLeft');}\n const pad=app.pads[seat];if(pad){const dead=a=>Math.abs(a||0)<.16?0:a;const x=dead(pad.axes[0]),z=dead(pad.axes[1]),ax=dead(pad.axes[2]),az=dead(pad.axes[3]);if(Math.hypot(x,z)>.1){v.mx=x;v.mz=z;}if(Math.hypot(ax,az)>.1){v.ax=ax;v.az=az;}v.fire||=\"'!!pad.buttons[7]?.pressed||pad.buttons[7]?.value>.25;v.dash||=!!pad.buttons[1]?.pressed||!!pad.buttons[6]?.pressed;}\n if(seat===0&&app.touches.size&&app.screen==='\"'play'){let right=null;for(const t of app.touches.values()){const dx=(t.x-t.sx)/55,dy=(t.y-t.sy)/55;if(t.side==='left'){v.mx=dx;v.mz=dy;}else right={dx,dy};}const tank=(app.remote||sim).tanks[app.mode==='online'?Math.max(0,online.seat):0],enemy=(app.remote||sim).tanks[app.mode==='online'?1-Math.max(0,online.seat):1];if(right&&Math.hypot(right.dx,right.dy)>.15){v.ax=right.dx;v.az=right.dy;v.fire=true;}else{v.ax=enemy.x-tank.x;v.az=enemy.z-tank.z;v.fire=enemy.dead<=0;}v.dash=app.touchDash;}\n if(v.mx||v.mz||v.fire||v.dash||app.touches.size)app.lastInput=performance.now();return v;}\nfunction currentState(){return app.mode==='online'&&\"'!online.isHost&&app.remote?app.remote:sim.snapshot();}\nlet hudTick=0;\nfunction updateHud(state){$('\"'score-0').textContent=state.scores[0];\"'$('\"'score-1').textContent=state.scores[1];\"'$('\"'name-0').textContent=app.mode==='solo'?'YOU / TEAL':online.active&&online.players[0]?online.players[0].name+' / TEAL':'TEAL / 01';\"'$('\"'name-1').textContent=app.mode==='solo'?'RIVAL / CORAL':online.active&&online.players[1]?online.players[1].name+' / CORAL':'CORAL / 02';\"'$('\"'stage-name').textContent=MAPS[state.round].name;\"'$('\"'stage-sub').textContent=app.mode==='solo'?\"'`${String(state.round+1).padStart(2,'\"'0')} / 03 · FIRST TO 3\"'`:app.mode==='\"'attract'?'AI DEMO · TWO GOOD LITTLE TANKS':'DUEL · FIRST TO 3';const seconds=Math.max(0,Math.ceil(state.time));\"'$('\"'timer').textContent=state.sudden?'HOT ZONE':\"'`${Math.floor(seconds/60)}:${String(seconds%60).padStart(2,'\"'0')}\"'`;$('\"'timer').classList.toggle('danger',seconds<15);for(let i=0;i<2;i++){const t=state.tanks[i];\"'$('\"'armor-'+i).innerHTML=Array.from({length:3},(_,j)=>\"'`<i class=\"armor${t.hp>j?'\"'':' empty'}\\\"></i>\"'`).join('\"'')+\"'`<span class=\"ammo-row\">${Array.from({length:3},(_,j)=>`<i class=\"shell${t.ammo>j?'\"'':' empty'}\\\"></i>\"'`).join('\"'')}</span>\"'`;}$('\"'dash-meter').style.width=(1-state.tanks[Math.max(0,app.mode==='online'?online.seat:0)].dash/3)*100+'%';}\nfunction stepSimulation(){if(app.mode==='online'&&\"'!online.isHost)return;if(app.mode!=='\"'attract'){if(app.mode==='online'){if(online.seat>=0)sim.input(online.seat,app.screen==='play'?(app.debugInputs[online.seat]||localInput(0)):{});}else{sim.input(0,app.debugInputs[0]||localInput(0));sim.input(1,app.debugInputs[1]||(app.mode==='local'?localInput(1):null));}}sim.step();}\nfunction frame(now){if(\"'!app.ready)return;const dt=Math.min((now-lastFrame)/1000||.016,.08);lastFrame=now;getPads(now);if(app.screen==='\"'title'&&now-app.lastInput>=10000)enterAttract();const active=app.screen==='play'||app.screen==='attract'||app.mode==='online'&&\"'!app.hubEnded&&['\"'paused','settings','guide','dev'].includes(app.screen);if(active){if(app.mode==='attract'){app.attractElapsed+=dt;if(app.attractElapsed>19){app.attractElapsed=0;app.attractRound=(app.attractRound+1)%3;app.round=app.attractRound;sim.reset(app.round,'attract');sim.spawnPickup('overdrive',...MAPS[app.round].pickup);view.build(app.round);}}if(app.mode==='online'&&\"'!online.isHost){online.sendInput(app.screen==='\"'play'?localInput(0):{});}else if(\"'!(app.mode==='\"'online'&&online.inHub&&online.time()<0)){accumulator+=dt;let steps=0;while(accumulator>=1/60&&steps++<8){stepSimulation();accumulator-=1/60;if(sim.ended)break;}}if(app.mode==='online'&&online.isHost&&\"'!online.ended){const snap=sim.snapshot();snap.events=app.events;online.sendSnapshot(snap);}}\n if(app.finishPending&&online.isHost){const snap=sim.snapshot();snap.events=app.events;online.sendSnapshot(snap);online.finish(sim.scores,{shots:sim.metrics.shots,bounces:sim.metrics.bounces});app.finishPending=false;}\n const state=currentState();let aim=null;const seat=app.mode==='\"'online'?online.seat:0;if(app.settings.assist&&seat>=0&&\"'!state.tanks[seat].dead&&app.screen==='\"'play'){const t=state.tanks[seat],dx=Math.sin(t.aim),dz=Math.cos(t.aim);aim=sim.trace(t.x+dx*1.2,t.z+dz*1.2,dx,dz,sim.balance.ricochets,35);}view.update(state,dt,{aim,assist:app.settings.assist,seat,shake:app.settings.shake,title:app.screen==='title'});view.render();if(++hudTick%4===0)updateHud(state);if(now>app.toastUntil)\"'$('\"'toast').classList.remove('show');if(now>app.announceUntil)\"'$('\"'announce').classList.remove('show');audio.update(dt,{paused:app.screen==='paused'});}\nfunction inspect(){if(\"'!sim)return{ready:false,screen:app.screen};const s=currentState();return{ready:app.ready,screen:app.screen,mode:app.mode,round:s.round,scores:[...s.scores],tanks:s.tanks.map(t=>({...t,body:undefined,col:undefined})),bullets:s.bullets.length,pickups:s.pickups.map(p=>({...p})),obstacles:s.obstacles.map(o=>({hp:o.hp,type:o.type})),time:s.time,sudden:s.sudden,zone:s.zone,physics:'\"'rapier 0.19.3',renderer:view.backend,musicVolume:audio.musicVolume,inputMode:app.inputMode,settings:{...app.settings,...sim.balance},balance:{...sim.balance},metrics:{...s.metrics},audio:audio.inspect(),animation:view.inspect(),online:online.inspect(),completed:[...app.completed]};}\nconst debug={start:(mode='solo',round=0)=>startGame(mode,round),award:seat=>sim.award(seat),damage:(seat,n=1)=>sim.damage(seat,n),setTank:(seat,v)=>sim.setTank(seat,v),spawnShot:(owner,v)=>sim.spawnShot(owner,v),setTime:seconds=>{sim.time=seconds;},spawnPickup:(type,x,z)=>sim.spawnPickup(type,x,z),setInput:(i,v)=>{app.debugInputs[i]=v;sim.input(i,v);},step:seconds=>{for(let i=0;i<Math.round(seconds*60);i++){stepSimulation();if(sim.ended)break;}updateHud(currentState());},setIdle:seconds=>{app.lastInput=performance.now()-seconds*1000;},reset:()=>title(),online};\nwindow.__COMBOP__={ready:false,inspect,debug,online,audio,AudioSystem};\nasync function boot(){try{loadSettings();wireUI();buildDev();\"'$('\"'loading-detail').textContent='Pouring the concrete…';await Simulation.init();sim=new Simulation((type,data)=>handleEffect(type,data));view=new GameView(\"'$('\"'world'));\"'$('\"'loading-detail').textContent='Inking the little tanks…';await view.init();view.build(0);view.update(sim.snapshot(),0,{title:true});view.render();app.ready=true;window.__COMBOP__.ready=true;app.lastInput=performance.now();\"'$('\"'loading').style.display='none';show('title',false);lastFrame=performance.now();view.renderer.setAnimationLoop(frame);const info=await online.connectHub();if(info){app.mode='online';show('online',false);\"'$('\"'online-steps')?.classList.add('hidden');document.querySelector('.online-steps').classList.add('hidden');\"'$('\"'online-screen').querySelector('.back-row').classList.add('hidden');\"'$('\"'online-screen').querySelector('h2').textContent='Tanks on the starting line.';\"'$('\"'online-screen').querySelector('p').textContent='Connected to AI Hub. The round starts automatically.';online.ready();}}catch(error){console.error(error);\"'$('\"'loading-detail').textContent=\"'`Could not prepare the range: ${error.message}. This game needs WebGPU or WebGL2 and internet access for Three.js and Rapier.`;document.querySelector('\"'.loader-track').style.display='none';window.__COMBOP__.error=String(error);}}\nboot();\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"cat > ComBop-Combat-1977-gpt-6.1-sol-ultra-20261105-212552/app.js <<'EOF'\nimport {Simulation,MAPS,DEFAULTS} from './sim.js';\nimport {GameView} from './view.js';\nimport {AudioSystem} from './audio.js';\nimport {createOnline} from './hub.js';\n// CREDITS_DATA\nconst \"'$=id=>document.getElementById(id);\nconst app={ready:false,screen:'\"'loading',mode:'solo',round:0,lastInput:performance.now(),inputMode:'keyboard',previous:'title',settings:{music:.1,sfx:.7,glyph:'ps',assist:true,shake:true,arena:0},completed:[],toastUntil:0,announceUntil:0,attractElapsed:0,attractRound:0,remote:null,eventId:0,events:[],lastRemoteEvent:0,finishPending:false,hubEnded:false,keys:new Set(),pads:[],padPrev:[],padRepeat:0,mouse:{x:innerWidth*.6,y:innerHeight*.5,down:false,active:false},touches:new Map(),touchDash:false,debugInputs:[null,null]};\nconst audio=new AudioSystem();let sim,view;let accumulator=0;let lastFrame=0;let menuFocus=null;\nconst online=createOnline({\n onStatus(text){\"'$('\"'online-status').textContent=text;},\n onInput(input,seat){if(sim&&seat>=0){sim.input(seat,input);app.remoteInputAt=performance.now();}},\n onSnapshot(state){if(\"'!state?.tanks||state.tanks.length!==2)return;app.remote=state;if(state.round!==app.round){app.round=state.round;view?.build(state.round);}for(const ev of state.events||[]){if(ev.id>app.lastRemoteEvent){app.lastRemoteEvent=ev.id;handleEffect(ev.type,ev.data,false);}}if(state.ended&&app.screen==='\"'play')roundover({winner:state.winner,scores:state.scores},false);},\n onPeer(info){if(\"'!info.joined&&app.mode==='\"'online'&&\"'!app.hubEnded)toast(info.name+'\"' left the rumble.');},\n onStart(info){if(\"'!app.ready)return;app.hubEnded=false;app.lastRemoteEvent=0;app.remote=null;startGame('\"'online',app.settings.arena);\"'$('\"'online-status').textContent='Connected. Let the rumble begin\"'!'\"';},\n onTimeUp(){if(online.isHost&&sim){sim.ended=true;sim.winner=sim.scores[0]>=sim.scores[1]?0:1;online.finish(sim.scores,{shots:sim.metrics.shots,bounces:sim.metrics.bounces});}},\n onEnd(info){if(\"'!sim)return;app.hubEnded=online.inHub;app.finishPending=false;if(info.scores&&Array.isArray(info.scores)){sim.scores=[...info.scores];if(app.remote)app.remote.scores=[...info.scores];}if(online.inHub){audio.stopMusic();audio.setMuted(true);}if(app.mode==='\"'online'&&app.screen\"'!=='\"'roundover'){const s=app.remote||sim;roundover({winner:s.scores[0]>=s.scores[1]?0:1,scores:s.scores},false);if(info.reason\"'!=='\"'finished'&&\"'!online.inHub){$('\"'roundover-title').textContent='The radio went quiet.';\"'$('\"'roundover-copy').textContent='Your opponent disconnected. Return to title to create a fresh invitation.';}}applyHubUI();}\n});\nfunction applyHubUI(){if(\"'!online.inHub)return;document.querySelectorAll('\"'[data-action=\\\"title\\\"],[data-action=\\\"solo\\\"],[data-action=\\\"local\\\"],[data-action=\\\"online\\\"],[data-action=\\\"next-round\\\"]').forEach(b=>b.classList.add('hidden'));\"'$('\"'dev-button').disabled=true;\"'$('\"'pause-copy').textContent='Online play keeps moving during a pit stop.';}\nfunction gesture(mode='keyboard'){app.lastInput=performance.now();if(app.inputMode\"'!==mode){app.inputMode=mode;document.body.classList.toggle('\"'touch',mode==='touch');updatePrompts();}if(\"'!app.hubEnded){audio.unlock().then(ok=>{if(ok&&!audio.musicPlaying)audio.startMusic();});}}\nfunction activity(mode='\"'keyboard'){if(app.screen==='attract'){exitAttract();gesture(mode);return true;}gesture(mode);return false;}\nfunction toast(text,time=2.5){\"'$('\"'toast').textContent=text;\"'$('\"'toast').classList.add('show');app.toastUntil=performance.now()+time*1000;}\nfunction announce(text,time=1.5){\"'$('\"'announce').textContent=text;\"'$('\"'announce').classList.add('show');app.announceUntil=performance.now()+time*1000;}\nfunction focusables(){const panel=document.querySelector('.screen.active');return panel?[...panel.querySelectorAll('button,input,select,textarea')].filter(b=>\"'!b.disabled&&!b.closest('\"'.hidden')&&b.offsetParent\"'!==null):[];}\nfunction setFocus(b,real=true){document.querySelectorAll('\"'.focused').forEach(x=>x.classList.remove('focused'));menuFocus=b;if(b){b.classList.add('focused');if(real)b.focus({preventScroll:true});}}\nfunction refreshFocus(){const f=focusables();setFocus(f[0],false);}\nfunction show(screen,remember=true){if(remember&&['settings','guide','about','dev'].includes(screen))app.previous=app.screen;app.screen=screen;for(const e of document.querySelectorAll('.screen'))e.classList.toggle('active',e.id===screen+'-screen');const playing=screen==='play'||screen==='attract'||app.mode==='online'&&['paused','settings','guide','dev'].includes(screen);\"'$('\"'hud').style.display=playing?'block':'none';\"'$('\"'pause-button').style.display=screen==='attract'?'none':'block';\"'$('\"'attract-bar').style.display=screen==='attract'?'block':'none';\"'$('\"'dash-touch').style.display=screen==='play'&&app.inputMode==='touch'?'block':'none';\"'$('\"'announce').classList.remove('show');app.mouse.down=false;app.keys.clear();app.touches.clear();\"'$('\"'touch-ring').style.display='none';app.touchDash=false;refreshFocus();if(screen==='about')renderCredits('sourceInformation');if(screen==='dev')refreshDev();applyHubUI();}\nfunction goBack(){if(app.screen==='paused'){show('play',false);return;}if(['settings','guide','about','dev'].includes(app.screen)){show(app.previous==='settings'?'paused':app.previous,false);return;}if(app.screen==='online'){online.leave();show('title',false);app.lastInput=performance.now();return;}if(app.screen==='play'){show('paused',false);\"'$('\"'pause-copy').textContent=app.mode==='online'?'Online play keeps moving during a pit stop.':'Your tank can catch its breath.';return;}}\nfunction title(){if(online.inHub)return;app.mode='solo';online.leave();app.remote=null;app.finishPending=false;app.debugInputs=[null,null];sim.reset(0,'solo');view.build(0);app.round=0;app.lastInput=performance.now();audio.setMuted(false);show('title',false);}\nfunction startGame(mode='solo',round=0){app.mode=mode;app.round=round;app.remote=null;app.debugInputs=[null,null];app.finishPending=false;app.hubEnded=false;app.events=[];if(mode==='solo'&&round===0)app.completed=[];sim.reset(round,mode,mode==='solo'&&round>0);view.build(round);show('play',false);audio.setMuted(false);audio.sfx('start');audio.voice('start');announce(mode==='local'?'A little friendly fire.':MAPS[round].name,2);if(mode==='local')toast('TEAL: WASD + mouse  ·  CORAL: arrows + IJKL / Enter / Shift',6);if(mode==='solo')toast(MAPS[round].rule,4);if(mode==='online')applyHubUI();}\nfunction roundover(data,finish=true){if(app.screen==='attract')return;const won=data.winner===0;show('roundover',false);\"'$('\"'roundover-kicker').textContent=app.mode==='solo'?\"'`CIRCUIT / BOUT ${app.round+1} OF 3`:'\"'DUEL COMPLETE';\"'$('\"'roundover-title').textContent=app.mode==='solo'?(won?'Well bopped.':'A minor dent in the plan.'):data.winner===0?'Teal takes the cake.':'Coral makes a comeback.';\"'$('\"'roundover-copy').textContent=app.mode==='solo'?(won?(app.round<2?'One down. Keep the good angles coming.':'All three bouts in the bag. That’s some fine tanking.'):'The rival found your angle. Retry this bout and give them a little bop back.'):'A good clean rumble. Mostly.';\"'$('\"'roundover-score').innerHTML=\"'`${Number(data.scores[0])} : <span>${Number(data.scores[1])}</span>`;const next=$('\"'next-round');next.classList.remove('hidden');next.textContent=app.mode==='solo'?(won?(app.round<2?'Next arena ↗':'Collect your trophy ↗'):'Try this bout again ↗'):'Rematch ↗';if(app.mode==='online'){next.classList.add('hidden');\"'$('\"'roundover-copy').textContent=online.inHub?'Round complete. AI Hub has the result.':'Duel complete. Return to title for a fresh connection.';if(finish&&online.isHost)app.finishPending=true;}if(app.mode==='solo'&&won&&\"'!app.completed.includes(app.round))app.completed.push(app.round);audio.sfx(won?'\"'win':'lose');audio.voice(won?'win':'lose');refreshFocus();}\nfunction nextRound(){if(app.mode==='solo'){if(sim.winner===0){if(app.round===2){show('results',false);\"'$('\"'results-stats').textContent=\"'`${sim.metrics.shots} shells sent · ${sim.metrics.bounces} good bounces · ${sim.metrics.bankshots} bankshot wrecks`;return;}startGame('\"'solo',app.round+1);}else startGame('solo',app.round);}else if(app.mode==='local')startGame('local',app.round);}\nfunction enterAttract(){if(online.inHub||app.screen\"'!=='\"'title')return;app.mode='attract';app.attractElapsed=0;app.attractRound=0;app.round=0;sim.reset(0,'attract');view.build(0);show('attract',false);}\nfunction exitAttract(){app.mode='solo';sim.reset(0,'solo');app.round=0;view.build(0);app.lastInput=performance.now();show('title',false);}\nfunction handleEffect(type,data,replicate=true){if(\"'!view)return;if(replicate&&app.mode==='\"'online'&&online.isHost){app.events.push({id:++app.eventId,type,data});if(app.events.length>18)app.events.shift();}if(type==='roundover'){roundover(data);return;}view.effect(type,data);audio.sfx(type==='barrel'?'explode':type==='cover'||type==='chip'?'hit':type,.7);if(type==='hit'&&data.bank)announce('A good angle\"'!'\"',.8);if(type==='explode')announce(data.bank?'Bank you very much\"'!'\"':data.tank===0?'A minor setback.':'BOP\"'!'\"',1.2);if(type==='pickup'&&data.tank===(app.mode==='online'?online.seat:0)){toast(data.type==='repair'?'Armour patched. Back to it.':'DOUBLE TIME · seven seconds of rapid fire',2);audio.voice('pickup');}if(type==='sudden'){announce('Hot zone\"'! Keep moving.'\"',2);audio.voice('start');}}\nconst settingsDefaults={music:.1,sfx:.7,glyph:'ps',assist:true,shake:true,arena:0};\nfunction loadSettings(){try{const v=JSON.parse(localStorage.getItem('combop-settings')||'null');if(v){app.settings={...settingsDefaults,...v};app.settings.music=Math.max(0,Math.min(1,+app.settings.music||0));app.settings.sfx=Math.max(0,Math.min(1,+app.settings.sfx||0));}}catch{}syncSettings();}\nfunction syncSettings(){\"'$('\"'music-volume').value=app.settings.music*100;\"'$('\"'music-value').textContent=Math.round(app.settings.music*100)+'%';\"'$('\"'sfx-volume').value=app.settings.sfx*100;\"'$('\"'sfx-value').textContent=Math.round(app.settings.sfx*100)+'%';\"'$('\"'glyph-style').value=app.settings.glyph;\"'$('\"'assist').value=app.settings.assist?'on':'off';\"'$('\"'shake').value=app.settings.shake?'on':'off';\"'$('\"'arena-select').value=app.settings.arena;audio.setMusic(app.settings.music);audio.setSfx(app.settings.sfx);updatePrompts();}\nfunction saveSettings(){try{localStorage.setItem('combop-settings',JSON.stringify(app.settings));}catch{}syncSettings();}\nfunction updatePrompts(){const pad=app.inputMode==='gamepad',xbox=app.settings.glyph==='xbox';const values=pad?{move:'L',aim:'R',fire:xbox?'RT':'R2',dash:xbox?'B':'○'}:{move:'WASD',aim:'Mouse',fire:'LMB',dash:'Space'};for(const el of document.querySelectorAll('.prompt')){el.textContent=values[el.dataset.prompt];el.className='prompt glyph'+(pad?' pad':'');}\"'$('\"'title-prompt').textContent=app.inputMode==='touch'?'Drag to drive · Aim & fire assisted':pad?'Left stick to move · × to select':'WASD + mouse · Controller ready';}\nconst devSpecs=[['speed','Tank speed',2,10,.1],['shellSpeed','Shell speed',8,28,.5],['reload','Shell refill time',.2,2,.05],['ai','Rival skill',.3,1.4,.05],['ricochets','Wall bounces',0,5,1],['damage','Shell damage',1,3,1]];\nfunction buildDev(){for(const [key,label,min,max,step]of devSpecs){const row=document.createElement('div');row.className='setting';row.innerHTML=\"'`<label for=\"dev-${key}\">${label}</label><div class=\"range-wrap\"><input id=\"dev-${key}\" data-dev=\"${key}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${DEFAULTS[key]}\"><output id=\"dev-value-${key}\">${DEFAULTS[key]}</output></div>`;$('\"'dev-sliders').append(row);row.querySelector('input').addEventListener('input',e=>{sim.balance[key]=Number(e.target.value);\"'$('\"'dev-value-'+key).textContent=Number(e.target.value).toFixed(key==='reload'||key==='ai'?2:1).replace(/\\\\.0\"'$/,'\"'');});}}\nfunction refreshDev(){for(const [key]of devSpecs){\"'$('\"'dev-'+key).value=sim.balance[key];\"'$('\"'dev-value-'+key).textContent=sim.balance[key];}\"'$('\"'dev-god').textContent='Invulnerable: '+(sim.god?'on':'off');}\nconst feedbackQuestions={testingFeedback:['How many issues did testing catch?','How many were critical or game breaking?','Most helpful test','Least helpful test'],engineFeedback:['What did you like most about the engine?','Did you get stuck or guess wrong?','Most important thing built yourself','Hardest part about using the engine','Engine changes','One thing you would change'],promptFeedback:['What did you like most about this prompt?','What was confusing?','Hardest thing to do','What would you change?']};\nfunction renderCredits(tab){const root=\"'$('\"'credits-body');root.replaceChildren();document.querySelectorAll('[data-credit]').forEach(b=>b.classList.toggle('primary',b.dataset.credit===tab));if(tab==='sourceInformation'){const dl=document.createElement('dl');dl.className='credits-grid';for(const [key,value]of Object.entries(CREDITS.sourceInformation)){const dt=document.createElement('dt');dt.textContent=key.replace(/([A-Z])/g,' \"'$1'\"').replace(/\"'^./,s=>s.toUpperCase());const dd=document.createElement('\"'dd');dd.textContent=value;dl.append(dt,dd);}root.append(dl);}else{CREDITS[tab].forEach((value,i)=>{const section=document.createElement('div');section.className='feedback-item';const h=document.createElement('strong');h.textContent=feedbackQuestions[tab][i]||'';const p=document.createElement('p');p.textContent=value;section.append(h,p);root.append(section);});}root.scrollTop=0;}\nasync function action(name){audio.sfx('click');switch(name){case'solo':startGame('solo',0);break;case'local':startGame('local',app.settings.arena);break;case'online':show('online');break;case'pause':if(app.screen==='play')goBack();break;case'resume':show('play',false);break;case'back':goBack();break;case'title':title();break;case'settings':case'guide':case'about':case'dev':show(name);break;case'next-round':nextRound();break;case'reset-settings':app.settings={...settingsDefaults};saveSettings();toast('Factory-fresh settings.');break;case'dev-reset':sim.balance={...DEFAULTS};sim.god=false;refreshDev();break;case'dev-god':sim.god=\"'!sim.god;refreshDev();break;case'\"'dev-next':show('play',false);sim.scores[0]=2;sim.award(0);break;case'dev-repair':for(const t of sim.tanks){t.hp=3;t.ammo=3;if(t.dead>0)sim.respawn(t);}toast('Both tanks repaired.');break;case'dev-time':sim.time=0;toast('Hot zone begins when you resume.');break;case'host-online':try{\"'$('\"'host-online').disabled=true;\"'$('\"'online-code').value=await online.host();\"'$('\"'code-label').textContent='Your invitation — copy and send to your friend';\"'$('\"'code-help').textContent='After your friend joins, replace this invitation with their return code and choose Accept return code.';}catch(e){toast(e.message,5);}finally{\"'$('\"'host-online').disabled=false;}break;case'join-online':try{const invite=\"'$('\"'online-code').value;\"'$('\"'join-online').disabled=true;const answer=await online.join(invite);\"'$('\"'online-code').value=answer;\"'$('\"'code-label').textContent='Your return code — send it back to the host';\"'$('\"'code-help').textContent='Keep this screen open. The duel starts when the host accepts your return code.';}catch(e){toast(e.message,5);}finally{\"'$('\"'join-online').disabled=false;}break;case'accept-code':try{await online.accept(\"'$('\"'online-code').value);}catch(e){toast(e.message,5);}break;case'copy-code':try{await navigator.clipboard.writeText(\"'$('\"'online-code').value);toast('Code copied.');}catch{\"'$('\"'online-code').select();toast('Select and copy the code from the box.');}break;}}\nfunction wireUI(){document.querySelectorAll('[data-action]').forEach(b=>{b.addEventListener('click',()=>action(b.dataset.action));b.addEventListener('pointerenter',()=>{if(app.inputMode\"'!=='\"'touch')setFocus(b,false);});});document.querySelectorAll('[data-credit]').forEach(b=>b.addEventListener('click',()=>renderCredits(b.dataset.credit)));for(const [id,key,convert]of [['music-volume','music',v=>Number(v)/100],['sfx-volume','sfx',v=>Number(v)/100],['glyph-style','glyph',v=>v],['assist','assist',v=>v==='on'],['shake','shake',v=>v==='on'],['arena-select','arena',v=>Number(v)]]){\"'$(id).addEventListener('\"'input',e=>{app.settings[key]=convert(e.target.value);saveSettings();});}}\nfunction moveMenu(dir){const list=focusables();if(\"'!list.length)return;let i=list.indexOf(menuFocus);i=(i+dir+list.length)%list.length;setFocus(list[i]);audio.sfx('\"'click',.5);list[i].scrollIntoView({block:'nearest'});}\nfunction adjustMenu(dir){const e=menuFocus;if(e?.tagName==='INPUT'&&e.type==='range'){e.value=Number(e.value)+Number(e.step||1)*dir;e.dispatchEvent(new Event('input',{bubbles:true}));}else if(e?.tagName==='SELECT'){e.selectedIndex=(e.selectedIndex+dir+e.options.length)%e.options.length;e.dispatchEvent(new Event('input',{bubbles:true}));}else moveMenu(dir);}\nfunction activateMenu(){if(menuFocus?.tagName==='BUTTON')menuFocus.click();else if(menuFocus?.tagName==='SELECT')adjustMenu(1);}\nfunction isEditing(e){return ['TEXTAREA','INPUT','SELECT'].includes(e?.tagName);}\nwindow.addEventListener('keydown',e=>{if(isEditing(e.target)){app.lastInput=performance.now();if(e.code==='Escape'){e.target.blur();goBack();}return;}if(activity('keyboard')){e.preventDefault();return;}if(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Tab','Enter'].includes(e.code))e.preventDefault();if(e.repeat)return;if(e.code==='Escape'){goBack();return;}if(app.screen==='play'){app.keys.add(e.code);return;}if(e.code==='ArrowDown'||e.code==='KeyS'||e.code==='Tab')moveMenu(e.shiftKey?-1:1);if(e.code==='ArrowUp'||e.code==='KeyW')moveMenu(-1);if(e.code==='ArrowLeft'||e.code==='KeyA')adjustMenu(-1);if(e.code==='ArrowRight'||e.code==='KeyD')adjustMenu(1);if(e.code==='Enter'||e.code==='Space')activateMenu();});\nwindow.addEventListener('keyup',e=>{app.keys.delete(e.code);});\nwindow.addEventListener('blur',()=>{app.keys.clear();app.mouse.down=false;app.touches.clear();if(app.ready&&app.screen==='play'&&app.mode\"'!=='\"'online')show('paused',false);});\nwindow.addEventListener('pointerdown',e=>{if(app.screen==='attract'){e.preventDefault();e.stopImmediatePropagation();exitAttract();gesture(e.pointerType==='touch'?'touch':'keyboard');return;}gesture(e.pointerType==='touch'?'touch':'keyboard');},true);\nwindow.addEventListener('pointermove',e=>{if(e.pointerType==='mouse'){if(app.screen==='attract'){exitAttract();gesture('keyboard');return;}if(e.movementX||e.movementY)gesture('keyboard');app.mouse.x=e.clientX;app.mouse.y=e.clientY;app.mouse.active=true;}else if(app.touches.has(e.pointerId)){const t=app.touches.get(e.pointerId);t.x=e.clientX;t.y=e.clientY;gesture('touch');}},{passive:true});\n\"'$('\"'world').style.touchAction='none';\"'$('\"'world').addEventListener('contextmenu',e=>e.preventDefault());\"'$('\"'world').addEventListener('pointerdown',e=>{if(app.screen\"'!=='\"'play')return;if(e.pointerType==='touch'){app.touches.set(e.pointerId,{x:e.clientX,y:e.clientY,sx:e.clientX,sy:e.clientY,side:e.clientX<innerWidth*.5?'left':'right'});\"'$('\"'world').setPointerCapture(e.pointerId);if(e.clientX<innerWidth*.5){\"'$('\"'touch-ring').style.cssText=\"'`display:block;left:${e.clientX-55}px;top:${e.clientY-55}px`;}}else if(e.button===0)app.mouse.down=true;});\nwindow.addEventListener('\"'pointerup',e=>{app.mouse.down=false;if(app.touches.has(e.pointerId)){const t=app.touches.get(e.pointerId);if(t.side==='left')\"'$('\"'touch-ring').style.display='none';app.touches.delete(e.pointerId);}if(e.target===\"'$('\"'dash-touch'))app.touchDash=false;});window.addEventListener('pointercancel',e=>{app.mouse.down=false;app.touches.delete(e.pointerId);app.touchDash=false;\"'$('\"'touch-ring').style.display='none';});\n\"'$('\"'dash-touch').addEventListener('pointerdown',e=>{e.preventDefault();gesture('touch');app.touchDash=true;});\nfunction getPads(now){const pads=Array.from(navigator.getGamepads?.()||[]).filter(Boolean);app.pads=pads;let menuUsed=false;for(let i=0;i<pads.length;i++){const p=pads[i],prev=app.padPrev[p.index]||{buttons:[],axes:[]};const pressed=n=>\"'!!p.buttons[n]?.pressed||p.buttons[n]?.value>.25;const edge=n=>pressed(n)&&!prev.buttons[n];const meaningful=p.axes.some(a=>Math.abs(a)>.25)||p.buttons.some(b=>b.pressed||b.value>.25);if(meaningful){if(activity('\"'gamepad')){app.padPrev[p.index]={buttons:p.buttons.map(b=>b.pressed||b.value>.25),axes:[...p.axes]};return;}if(edge(9)&&\"'!pressed(8)){if(app.screen==='\"'play'||app.screen==='paused')goBack();menuUsed=true;}if(app.screen\"'!=='\"'play'&&app.screen\"'!=='\"'attract'&&now>app.padRepeat){if(edge(0)){activateMenu();app.padRepeat=now+200;menuUsed=true;}else if(edge(1)){goBack();app.padRepeat=now+200;menuUsed=true;}else if(pressed(12)||p.axes[1]<-.5){moveMenu(-1);app.padRepeat=now+220;}else if(pressed(13)||p.axes[1]>.5){moveMenu(1);app.padRepeat=now+220;}else if(pressed(14)||p.axes[0]<-.5){adjustMenu(-1);app.padRepeat=now+180;}else if(pressed(15)||p.axes[0]>.5){adjustMenu(1);app.padRepeat=now+180;}}}app.padPrev[p.index]={buttons:p.buttons.map(b=>b.pressed||b.value>.25),axes:[...p.axes]};}return menuUsed;}\nfunction localInput(seat){const k=app.keys;let v={mx:0,mz:0,ax:0,az:0,fire:false,dash:false};if(seat===0){v.mx=+k.has('KeyD')-+k.has('KeyA');v.mz=+k.has('KeyS')-+k.has('KeyW');if(app.mode\"'!=='\"'local'){v.mx+=+k.has('ArrowRight')-+k.has('ArrowLeft');v.mz+=+k.has('ArrowDown')-+k.has('ArrowUp');}v.fire=app.mouse.down;v.dash=k.has('Space');if(app.mouse.active){const t=(app.remote||sim).tanks[app.mode==='online'?Math.max(0,online.seat):0],p=view.worldPoint(app.mouse.x,app.mouse.y);v.ax=p.x-t.x;v.az=p.z-t.z;}}\n else{v.mx=+k.has('ArrowRight')-+k.has('ArrowLeft');v.mz=+k.has('ArrowDown')-+k.has('ArrowUp');v.ax=+k.has('KeyL')-+k.has('KeyJ');v.az=+k.has('KeyK')-+k.has('KeyI');v.fire=k.has('Enter')||k.has('NumpadEnter');v.dash=k.has('ShiftRight')||k.has('ShiftLeft');}\n const pad=app.pads[seat];if(pad){const dead=a=>Math.abs(a||0)<.16?0:a;const x=dead(pad.axes[0]),z=dead(pad.axes[1]),ax=dead(pad.axes[2]),az=dead(pad.axes[3]);if(Math.hypot(x,z)>.1){v.mx=x;v.mz=z;}if(Math.hypot(ax,az)>.1){v.ax=ax;v.az=az;}v.fire||=\"'!!pad.buttons[7]?.pressed||pad.buttons[7]?.value>.25;v.dash||=!!pad.buttons[1]?.pressed||!!pad.buttons[6]?.pressed;}\n if(seat===0&&app.touches.size&&app.screen==='\"'play'){let right=null;for(const t of app.touches.values()){const dx=(t.x-t.sx)/55,dy=(t.y-t.sy)/55;if(t.side==='left'){v.mx=dx;v.mz=dy;}else right={dx,dy};}const tank=(app.remote||sim).tanks[app.mode==='online'?Math.max(0,online.seat):0],enemy=(app.remote||sim).tanks[app.mode==='online'?1-Math.max(0,online.seat):1];if(right&&Math.hypot(right.dx,right.dy)>.15){v.ax=right.dx;v.az=right.dy;v.fire=true;}else{v.ax=enemy.x-tank.x;v.az=enemy.z-tank.z;v.fire=enemy.dead<=0;}v.dash=app.touchDash;}\n if(v.mx||v.mz||v.fire||v.dash||app.touches.size)app.lastInput=performance.now();return v;}\nfunction currentState(){return app.mode==='online'&&\"'!online.isHost&&app.remote?app.remote:sim.snapshot();}\nlet hudTick=0;\nfunction updateHud(state){$('\"'score-0').textContent=state.scores[0];\"'$('\"'score-1').textContent=state.scores[1];\"'$('\"'name-0').textContent=app.mode==='solo'?'YOU / TEAL':online.active&&online.players[0]?online.players[0].name+' / TEAL':'TEAL / 01';\"'$('\"'name-1').textContent=app.mode==='solo'?'RIVAL / CORAL':online.active&&online.players[1]?online.players[1].name+' / CORAL':'CORAL / 02';\"'$('\"'stage-name').textContent=MAPS[state.round].name;\"'$('\"'stage-sub').textContent=app.mode==='solo'?\"'`${String(state.round+1).padStart(2,'\"'0')} / 03 · FIRST TO 3\"'`:app.mode==='\"'attract'?'AI DEMO · TWO GOOD LITTLE TANKS':'DUEL · FIRST TO 3';const seconds=Math.max(0,Math.ceil(state.time));\"'$('\"'timer').textContent=state.sudden?'HOT ZONE':\"'`${Math.floor(seconds/60)}:${String(seconds%60).padStart(2,'\"'0')}\"'`;$('\"'timer').classList.toggle('danger',seconds<15);for(let i=0;i<2;i++){const t=state.tanks[i];\"'$('\"'armor-'+i).innerHTML=Array.from({length:3},(_,j)=>\"'`<i class=\"armor${t.hp>j?'\"'':' empty'}\\\"></i>\"'`).join('\"'')+\"'`<span class=\"ammo-row\">${Array.from({length:3},(_,j)=>`<i class=\"shell${t.ammo>j?'\"'':' empty'}\\\"></i>\"'`).join('\"'')}</span>\"'`;}$('\"'dash-meter').style.width=(1-state.tanks[Math.max(0,app.mode==='online'?online.seat:0)].dash/3)*100+'%';}\nfunction stepSimulation(){if(app.mode==='online'&&\"'!online.isHost)return;if(app.mode!=='\"'attract'){if(app.mode==='online'){if(online.seat>=0)sim.input(online.seat,app.screen==='play'?(app.debugInputs[online.seat]||localInput(0)):{});}else{sim.input(0,app.debugInputs[0]||localInput(0));sim.input(1,app.debugInputs[1]||(app.mode==='local'?localInput(1):null));}}sim.step();}\nfunction frame(now){if(\"'!app.ready)return;const dt=Math.min((now-lastFrame)/1000||.016,.08);lastFrame=now;getPads(now);if(app.screen==='\"'title'&&now-app.lastInput>=10000)enterAttract();const active=app.screen==='play'||app.screen==='attract'||app.mode==='online'&&\"'!app.hubEnded&&['\"'paused','settings','guide','dev'].includes(app.screen);if(active){if(app.mode==='attract'){app.attractElapsed+=dt;if(app.attractElapsed>19){app.attractElapsed=0;app.attractRound=(app.attractRound+1)%3;app.round=app.attractRound;sim.reset(app.round,'attract');sim.spawnPickup('overdrive',...MAPS[app.round].pickup);view.build(app.round);}}if(app.mode==='online'&&\"'!online.isHost){online.sendInput(app.screen==='\"'play'?localInput(0):{});}else if(\"'!(app.mode==='\"'online'&&online.inHub&&online.time()<0)){accumulator+=dt;let steps=0;while(accumulator>=1/60&&steps++<8){stepSimulation();accumulator-=1/60;if(sim.ended)break;}}if(app.mode==='online'&&online.isHost&&\"'!online.ended){const snap=sim.snapshot();snap.events=app.events;online.sendSnapshot(snap);}}\n if(app.finishPending&&online.isHost){const snap=sim.snapshot();snap.events=app.events;online.sendSnapshot(snap);online.finish(sim.scores,{shots:sim.metrics.shots,bounces:sim.metrics.bounces});app.finishPending=false;}\n const state=currentState();let aim=null;const seat=app.mode==='\"'online'?online.seat:0;if(app.settings.assist&&seat>=0&&\"'!state.tanks[seat].dead&&app.screen==='\"'play'){const t=state.tanks[seat],dx=Math.sin(t.aim),dz=Math.cos(t.aim);aim=sim.trace(t.x+dx*1.2,t.z+dz*1.2,dx,dz,sim.balance.ricochets,35);}view.update(state,dt,{aim,assist:app.settings.assist,seat,shake:app.settings.shake,title:app.screen==='title'});view.render();if(++hudTick%4===0)updateHud(state);if(now>app.toastUntil)\"'$('\"'toast').classList.remove('show');if(now>app.announceUntil)\"'$('\"'announce').classList.remove('show');audio.update(dt,{paused:app.screen==='paused'});}\nfunction inspect(){if(\"'!sim)return{ready:false,screen:app.screen};const s=currentState();return{ready:app.ready,screen:app.screen,mode:app.mode,round:s.round,scores:[...s.scores],tanks:s.tanks.map(t=>({...t,body:undefined,col:undefined})),bullets:s.bullets.length,pickups:s.pickups.map(p=>({...p})),obstacles:s.obstacles.map(o=>({hp:o.hp,type:o.type})),time:s.time,sudden:s.sudden,zone:s.zone,physics:'\"'rapier 0.19.3',renderer:view.backend,musicVolume:audio.musicVolume,inputMode:app.inputMode,settings:{...app.settings,...sim.balance},balance:{...sim.balance},metrics:{...s.metrics},audio:audio.inspect(),animation:view.inspect(),online:online.inspect(),completed:[...app.completed]};}\nconst debug={start:(mode='solo',round=0)=>startGame(mode,round),award:seat=>sim.award(seat),damage:(seat,n=1)=>sim.damage(seat,n),setTank:(seat,v)=>sim.setTank(seat,v),spawnShot:(owner,v)=>sim.spawnShot(owner,v),setTime:seconds=>{sim.time=seconds;},spawnPickup:(type,x,z)=>sim.spawnPickup(type,x,z),setInput:(i,v)=>{app.debugInputs[i]=v;sim.input(i,v);},step:seconds=>{for(let i=0;i<Math.round(seconds*60);i++){stepSimulation();if(sim.ended)break;}updateHud(currentState());},setIdle:seconds=>{app.lastInput=performance.now()-seconds*1000;},reset:()=>title(),online};\nwindow.__COMBOP__={ready:false,inspect,debug,online,audio,AudioSystem};\nasync function boot(){try{loadSettings();wireUI();buildDev();\"'$('\"'loading-detail').textContent='Pouring the concrete…';await Simulation.init();sim=new Simulation((type,data)=>handleEffect(type,data));view=new GameView(\"'$('\"'world'));\"'$('\"'loading-detail').textContent='Inking the little tanks…';await view.init();view.build(0);view.update(sim.snapshot(),0,{title:true});view.render();app.ready=true;window.__COMBOP__.ready=true;app.lastInput=performance.now();\"'$('\"'loading').style.display='none';show('title',false);lastFrame=performance.now();view.renderer.setAnimationLoop(frame);const info=await online.connectHub();if(info){app.mode='online';show('online',false);\"'$('\"'online-steps')?.classList.add('hidden');document.querySelector('.online-steps').classList.add('hidden');\"'$('\"'online-screen').querySelector('.back-row').classList.add('hidden');\"'$('\"'online-screen').querySelector('h2').textContent='Tanks on the starting line.';\"'$('\"'online-screen').querySelector('p').textContent='Connected to AI Hub. The round starts automatically.';online.ready();}}catch(error){console.error(error);\"'$('\"'loading-detail').textContent=\"'`Could not prepare the range: ${error.message}. This game needs WebGPU or WebGL2 and internet access for Three.js and Rapier.`;document.querySelector('\"'.loader-track').style.display='none';window.__COMBOP__.error=String(error);}}\nboot();\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
