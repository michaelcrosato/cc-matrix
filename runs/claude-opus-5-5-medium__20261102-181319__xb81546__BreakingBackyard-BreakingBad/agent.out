ingify(snap()));","+playMini(); talkThrough();","+check('chapter one ends on the couch', waitFor(() => snap().scene === 'therapy'), JSON.stringify(snap()));","+// SESSION TWO","+run(1.5); talkThrough();","+check('session two ends in chapter two (night)', waitFor(() => snap().scene === 'play' && snap().ch === 3) && W.night, JSON.stringify(snap()));","+run(1);","+use(t1.frankie); talkThrough();","+check('Frankie hands over the pistol', S.flags.gun === 1 && S.ammo >= 24);","+check('three waves at the Velvet Brass', waitFor(() => snap().foes > 0, 5) && fightAll(150) && waitFor(() => snap().foes > 0 || S.flags.clubSafe, 5) && fightAll(150) && waitFor(() => snap().foes > 0 || S.flags.clubSafe, 5) && fightAll(150), JSON.stringify(snap()));","+check('the club is safe', waitFor(() => S.flags.clubSafe), JSON.stringify(snap()));","+waitFor(() => /Frankie/.test(snap().objective || ''));","+run(3); use(t1.frankie); talkThrough();","+check('chapter three: the Pine Barrens', waitFor(() => snap().place === 'barrens', 10), JSON.stringify(snap()));","+run(1);","+const b = D.BARRENS.at;","+check('Nicky comes along', snap().heroes === 2);","+D.teleport(b.shoe.x, b.shoe.y - 2); run(1.2); talkThrough();","+check('Lenny lost a shoe', S.flags.shoe === 1, JSON.stringify(snap()));","+check('the cold drains warmth', W.cold < 100);","+waitFor(() => /trail/.test(snap().objective || ''));","+D.teleport(b.pond.x - 60, b.pond.y); run(.5); talkThrough();","+check('the ambush by the pond', S.flags.ambush === 1 && fightAll(), JSON.stringify(snap()));","+waitFor(() => /cabin/.test(snap().objective || ''));","+D.teleport(b.lenny.x, b.lenny.y + 40); run(.5); talkThrough();","+check('Lenny the Ledger fights, then gives up', fightAll(120) && W.lenny && W.lenny.surrender, JSON.stringify(snap()));","+talkThrough(30, CHOICE % 2);","+const bag = W.items.find(i => i.kind === 'bag');","+check('the bag drops', !!bag);","+if (bag) { D.teleport(bag.x, bag.y); run(1); talkThrough(); }","+check('the book and the money', S.flags.book === 1 && S.cash >= 5000, JSON.stringify(snap()));","+waitFor(() => /road/.test(snap().objective || ''));","+D.teleport(b.exit.x, b.exit.y); run(.5); talkThrough();","+check('session three', waitFor(() => snap().scene === 'therapy'), JSON.stringify(snap()));","+run(1.5); talkThrough();","+check('chapter four: rain at night', waitFor(() => snap().scene === 'play' && snap().ch === 6) && game.weather && game.weather.kind === 'rain', JSON.stringify(snap()));","+run(1); use(t1.gino); talkThrough();","+waitFor(() => /yard/.test(snap().objective || ''));","+D.teleport(t1.yardGate.x, t1.yardGate.y); run(.5);","+check('the yard gate fight', fightAll(120) && waitFor(() => S.flags.gateDone), JSON.stringify(snap()));","+waitFor(() => !!W.carmine); talkThrough();","+check('Carmine \"The Tenor\" fights in three movements', fightAll(240) && W.carmine.surrender, JSON.stringify(snap()) + ' phase ' + (W.carmine && W.carmine.phase));","+talkThrough();","+check('the Feds take him', waitFor(() => S.flags.yard), JSON.stringify(snap()));","+waitFor(() => /Diner/.test(snap().objective || ''));","+use(t1.diner, 10);","+check('the epilogue at the diner', waitFor(() => snap().scene === 'diner', 5), JSON.stringify(snap()));","+check('the diner plays out and cuts to black, then the credits', waitFor(() => snap().scene === 'credits', 90), JSON.stringify(snap()));","+I.tap('start'); run(1);","+check('the credits end on the title', snap().scene === 'title', JSON.stringify(snap()));","+check('a save is there to continue', game.saves.any);","+check('no errors', !game.errors.length, game.errors.map(e => e.where + ': ' + e.message + ' ' + (e.stack || '').split('\\n')[1]).join(' | '));","+console.log(`final: cash ${S.cash}, respect ${S.respect}, family ${S.family}, panics ${S.panics || 0}, choices ${S.choices.length}`);","+console.log(failed ? `${failed} check(s) failed` : 'all checks passed');","+process.exit(failed ? 1 : 0);"]}],"created":true},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181319__xb81546/work/BreakingBackyard-BreakingBad-claude-opus-5-5-medium-20261102-181319.html","hunks":[{"oldStart":16031,"oldLines":7,"newStart":16031,"newLines":7,"lines":["     const ln = lines[i];","     if (typeof ln === 'function') { const r = ln(); if (r === false) return; run(i + 1); return; }","     const [who, text, o = {}] = ln;","-    if (o.choices) say(who, text, { choices: o.choices, onChoice: k => { if (o.onChoice) o.onChoice(k); run(i + 1); } });","+    if (o.choices) say(who, text, { choices: o.choices, onChoice: k => { if (o.onChoice) o.onChoice(k); game.after(.01, () => run(i + 1)); } });","     else say(who, text, { ...o, onDone: () => run(i + 1) });","   };","   run(0);"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181319__xb81546/work/BreakingBackyard-BreakingBad-claude-opus-5-5-medium-20261102-181319/dist/BreakingBackyard-BreakingBad-claude-opus-5-5-medium-20261102-181319.html","hunks":[{"oldStart":16031,"oldLines":7,"newStart":16031,"newLines":7,"lines":["     const ln = lines[i];","     if (typeof ln === 'function') { const r = ln(); if (r === false) return; run(i + 1); return; }","     const [who, text, o = {}] = ln;","-    if (o.choices) say(who, text, { choices: o.choices, onChoice: k => { if (o.onChoice) o.onChoice(k); run(i + 1); } });","+    if (o.choices) say(who, text, { choices: o.choices, onChoice: k => { if (o.onChoice) o.onChoice(k); game.after(.01, () => run(i + 1)); } });","     else say(who, text, { ...o, onDone: () => run(i + 1) });","   };","   run(0);"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181319__xb81546/work/BreakingBackyard-BreakingBad-claude-opus-5-5-medium-20261102-181319/dist/game.js","hunks":[{"oldStart":820,"oldLines":7,"newStart":820,"newLines":7,"lines":["     const ln = lines[i];","     if (typeof ln === 'function') { const r = ln(); if (r === false) return; run(i + 1); return; }","     const [who,