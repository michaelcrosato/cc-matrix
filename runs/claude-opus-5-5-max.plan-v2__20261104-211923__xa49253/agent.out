lay-policy=no-user-gesture-required'])\n    pg = b.new_page(viewport={'width':1920,'height':1080}); errs=[]; pg.on('pageerror', lambda e: errs.append(str(e)[:300]))\n    pg.goto(url+'#shooter'); pg.wait_for_function('window.__game && window.__game.game && window.__game.game.scene', timeout=120000); pg.wait_for_timeout(800)\n    print('settings', pg.evaluate(\"() => { const g=__game.game, i=g.input; return { music:g.audio.musicVolume, pic:g.settings.picture3d, glyphs:g.settings.glyphs, device:i.lastDevice, fireKB:i.label('fire','keyboard'), aimKB:i.label('aim','keyboard'), fireMouse:i.label('fire','mouse'), firePad:i.label('fire','gamepad'), world3dBackend:My3D2dge.World3D.backend }; }\"))\n    pg.evaluate(\"() => { __game.game.pause('t'); }\"); pg.wait_for_timeout(500)\n    print('menu', pg.evaluate(\"() => { const m=document.querySelector('.esh'); return { zoom:getComputedStyle(m).zoom, buttons:[...m.querySelectorAll('button')].map(x=>x.textContent.trim()).slice(0,8) }; }\"))\n    box = pg.evaluate(\"() => { const m=document.querySelector('.esh'); const b=[...m.querySelectorAll('button')].find(x=>x.textContent.includes('About')); const r=b.getBoundingClientRect(); return [r.x+r.width/2, r.y+r.height/2]; }\")\n    pg.mouse.click(box[0], box[1]); pg.wait_for_timeout(900); pg.screenshot(path='about.png')\n    print('about', pg.evaluate(\"() => { const m=document.querySelector('.esh'); const q=[...m.querySelectorAll('*')].find(e=>e.scrollHeight>e.clientHeight+20 && getComputedStyle(e).overflowY!=='visible'); const t=m.innerText; return { hasText: t.includes('Prompt Feedback'), scroller: q ? [q.className, q.scrollHeight, q.clientHeight, getComputedStyle(q).overflowY] : null }; }\"))\n    print('errors', errs[:5]); b.close()\nsrv = subprocess.Popen(['python3','-u','-m','http.server','0','--bind','127.0.0.1'], cwd='hub', stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)\nport = int(re.search(r'port (\\d+)', srv.stdout.readline()).group(1))\nthreading.Thread(tar