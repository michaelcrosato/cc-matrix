ncludes(S.move)) {\n      const gap = Math.round(2 + spreadNow() * H * 1.25), L = S.cur === 'shotgun' ? 2 : 3, a = 1 - S.adsB * 1.6;\n      g.globalAlpha = clamp(a, 0, 1);\n      if (S.cur === 'shotgun') { g.strokeStyle = OL; g.lineWidth = 3; g.beginPath(); g.arc(cx + .5, cy + .5, gap + 2, 0, TAU); g.stroke(); g.strokeStyle = '#ffffff'; g.lineWidth = 1; g.beginPath(); g.arc(cx + .5, cy + .5, gap + 2, 0, TAU); \n      for (const [dx, dy] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) { const x = cx + dx * (gap + (dx > 0 ? 0 : L)) - (dx < 0 ? 0 : 0), y = cy + dy * (gap + (dy > 0 ? 0 : L)); const w = dx ? L : 1, h = dy ? L : 1; rect(x - 1 - (dx < 0 ? 0 : 0),\n      for (const [dx, dy] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) { const x = cx + dx * (gap + (dx > 0 ? 0 : L)), y = cy + dy * (gap + (dy > 0 ? 0 : L)); rect(x, y, dx ? L : 1, dy ? L : 1, '#ffffff'); }\n      rect(cx - 1, cy - 1, 3, 3, OL); rect(cx, cy, 1, 1, '#ffffff');\n      g.globalAlpha = 1;\n    }\n    if (S.mark && S.mark.t > 0) {\n      const k = S.mark.kind, c = { shield: '#8ad8ff', hit: '#ffffff', head: '#ffd23a', break: '#c89aff', kill: '#ff3a2a' }[k], u = 1 - S.mark.t / S.mark.dur;\n      const pop = Math.round(3 * Math.max(0, 1 - u * 5)), big = k === 'kill' || k === 'break', i0 = 4 + pop + (big ? 1 : 0), i1 = (big ? 10 : 8) + pop, th = k === 'kill' ? 2 : 1;\n      g.globalAlpha = u > .7 ? (1 - u) / .3 : 1;\n      for (const [sx, sy] of [[1, 1], [-1, 1], [1, -1], [-1, -1]]) for (let i = i0; i <= i1; i++) rect(cx + sx * i - (sx < 0 ? th : 0) - 1, cy + sy * i - (sy < 0 ? th : 0) - 1, th + 2, th + 2, OL);\n      for (const [sx, sy] of [[1, 1], [-1, 1], [1, -1], [-1, -1]]) for (let i = i0; i <= i1; i++) rect(cx + sx * i - (sx < 0 ? th : 0), cy + sy * i - (sy < 0 ? th : 0), th, th, c);\n      g.globalAlpha = 1;\n    }\n...\n  /* =====================================================================\n   * SOUNDS: the guns, their parts, hits and kills, the body's moves (chip voices: no sound files)\n   * ===================================================================== */\n  const SOUNDS = {\n    ar: [{ wave: 'noise', freq: 2600, to: 380, dur: .085, vol: .5, filter: 'lowpass' }, { wave: 'square', freq: 170, to: 55, dur: .06, vol: .26 }, { wave: 'noise', freq: 6400, dur: .025, vol: .16, filter: 'highpass' }],\n    ar2: [{ wave: 'noise', freq: 1900, to: 300, dur: .08, vol: .42, filter: 'lowpass' }, { wave: 'square', freq: 140, to: 50, dur: .05, vol: .18 }],\n    sg: [{ wave: 'noise', freq: 1500, to: 110, dur: .32, vol: .68, filter: 'lowpass' }, { wave: 'sine', freq: 95, to: 32, dur: .26, vol: .6 }, { wave: 'noise', freq: 5000, dur: .04, vol: .2, filter: 'highpass' }],\n    empty: { wave: 'square', freq: 1500, dur: .014, vol: .14 },\n    magout: [{ wave: 'noise', freq: 1600, to: 900, dur: .05, vol: .22 }, { wave: 'square', freq: 320, to: 260, dur: .03, vol: .1 }],\n    magin: [{ wave: 'noise', freq: 2600, dur: .03, vol: .28 }, { wave: 'square', freq: 360, to: 200, dur: .035, vol: .14, delay: .035 }],\n    bolt: [{ wave: 'noise', freq: 3000, to: 1800, dur: .04, vol: .24 }, { wave: 'noise', freq: 1800, to: 3200, dur: .045, vol: .26, delay: .1 }],\n    shell: [{ wave: 'noise', freq: 2200, to: 1400, dur: .04, vol: .22 }, { wave: 'square', freq: 520, dur: .02, vol: .08, delay: .03 }],\n    pump: [{ wave: 'noise', freq: 2400, to: 1300, dur: .06, vol: .26 }, { wave: 'noise', freq: 1500, to: 2600, dur: .06, vol: .26, delay: .14 }],\n    swapw: { wave: 'noise', freq: 1400, to: 2200, dur: .08, vol: .16 },\n    tick: [{ wave: 'square', freq: 1900, dur: .022, vol: .16 }, { wave: 'noise', freq: 4000, dur: .02, vol: .1 }],\n  vehicle(o = {}) {\n    const K = VEHICLES[o.kind] ? o.kind : 'kart', v = new Vehicle(this, Object.assign({}, VEHICLES[K], o, { kind: K })), pw = this.pw;\n    let z = o.z ?? this.floorAt(v.x, v.y); if (o.z === undefined) for (const t of this.tracks) { const q = t.where(v.x, v.y); if (Math.abs(q.across) <= t.o.width / 2 + t.o.kerb) z = Math.max(z, q.z); }   // (on a track: on its road)\n    const desc = RAPIER.RigidBodyDesc.dynamic().setTranslation(v.x, v.y, z + v.r + .2).lockRotations().setCcdEnabled(true).setCanSleep(false);\n    if (v.o.float) desc.setGravityScale(0);\n    v.z = z; v.body = pw.createRigidBody(desc);\n    v.col = pw.createCollider(RAPIER.ColliderDesc.ball(v.r).setFriction(0).setFrictionCombineRule(RAPIER.CoefficientCombineRule.Min).setRestitution(.2).setDensity(v.o.mass).setCollisionGroups(GROUPS.mob), v.body);\n    v.sink = -v.o.seat; this.actors.push(v); this._owners.set(v.col.handle, v);\n    return v;\n  }\n  /** a flyer (section 8b): { x, y, z, yaw, speed, min, max, turn, climb, bank, invert, low, bounds | rail: { path, speed,\n   *  w, h, slide } } -> a flyer (world.flyers; gone with a reset) */\n  flyer(o = {}) { const f = new Flyer(this, o); this.flyers.push(f); return f; }\n    const B = this.B, cam = this.camera, v = cam.cv, t = this.time, k = 1 - (this._al ?? 1); let drawn = 0, nr = 0;\n    const one = a => {\n      if (!a.visible || a.fade <= 0 || !cam.sees(a.x, a.y, a.z)) return;\n      if (firstOf && (a === firstOf || Math.hypot(a.x - firstOf.x, a.y - firstOf.y) < 12)) return;   // (first person: its own body, and one pressed against the camera, would fill the picture)\n      const flash = a.flash > 0, sink = -a.sink, alpha = clamp(a.fade, 0, 1);\n      if (a.orb) { orbParts(B, a, t); drawn++; return; }\n      if (a.isVehicle) { vehicleParts(this.pen, a, t); if (!a.rig) { shadowAt(this, a.x, a.y, a.z, 10, alpha); drawn++; return; } }\n      if (a.shadow) shadowAt(this, a.x, a.y, a.z, a.blob ? a.blob.o.R || 6 : a.r + 1, alpha);\n      drawn++;\n      const look = a.look || this.look;\n      if (look === 'card' && this.atlas.add(a.x, a.y, a.z - a.sink, (g, ox, oy) => a.rig ? a.rig.draw(g, ox, oy, view) : a.blob.draw(g, ox, oy, view), flash, alpha, v)) { if (a.trail && a.rig && a.rig.trail.length > 1 && nr < 24) this._ribb\n      if (a.rig) { a.rig._cheat = 0; _sink = sink; humanParts(B, a.rig, flash);