{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HN7hy5BwUsZyBkpSkk76fj","type":"tool_result","content":"#!/usr/bin/env node\n/**\n * hub-check.mjs — does a game keep the AI Hub Session Protocol?\n *\n * Runs lib/hub/harness.html?auto=1 against each game, at the player counts its\n * hub:session-players allows: hello, ready under the hub's card with no key\n * press, the start, traffic, a player leaving, time-up and a valid result. Then\n * once more with the host leaving. Then the game on its own, outside a session:\n * it opens, Enter and Space are pressed, and it must draw its screen with no\n * errors, the session client inactive and Math.random left alone. Before any\n * game script runs, every frame in session mode gets alert, confirm, prompt,\n * window.open and socket constructors wrapped, so calling them is caught.\n * Needs Playwright, which is not a dependency (see shots.mjs).\n *\n * Parallel is played at 1 and 2 players: nothing is shared, so more copies\n * prove nothing more. Its checks expect Math.random seeded the same on every\n * copy, progress from every copy, and no game traffic.\n *\n * Ghost and shared world are played at 2, 3 and 4 players on a poor network\n * (150 ± 50 ms, 5% loss). Ghost is checked like parallel, except that every\n * copy sends its player. A shared world wants traffic both ways, and is\n * played once more at 2 players with its world hosted by one more copy that\n * has no player of its own, as a dedicated server would host it (README,\n * \"Shared world\"). That run is reported like any; --record does not hold it\n * against a game, since no server runs yet.\n *\n * --retrofit is for an existing game upgraded to parallel: it is played once,\n * at 2 players with one of them leaving. With --original <path>, errors the\n * original page already had are forgiven when it is opened on its own.\n * --draws-only does only that last part, for any page: the retrofit runs it on\n * a game before spending a model on it, since a page this browser cannot run\n * cannot be checked here. A WebGPU-only game without WebGPU is caught even\n * when its title screen shows: it asked for an adapter, got none, and drew\n * nothing with WebGL or a 2D canvas instead. --browser-args passes flags to\n * Chromium; on a machine without a GPU, SwiftShader gives such games a\n * software adapter:\n *   --browser-args \"--enable-unsafe-webgpu --enable-features=Vulkan --use-vulkan=swiftshader --use-webgpu-adapter=swiftshader --use-angle=swiftshader\"\n *\n * Every game's pasted client is also read from disk and must be exactly a\n * released one (scripts/lib/hub-client.mjs).\n *\n * --record writes the outcome into data/overrides.json, which is how the hub\n * keeps a failing game out of sessions: a game that fails gets \"session\": \"0\"\n * (it overrides the game's own hub:session meta, so Random Mode never deals\n * it) and a sessionNote naming what failed; a game that passes loses both.\n *\n * Usage:  node scripts/hub-check.mjs [game paths…] [--players 2,3,4] [--base URL] [--json] [--no-solo]\n *                                    [--retrofit [--original <path>]] [--draws-only] [--record] [--browser-args \"<flags>\"]\n *         (games default to the three examples in lib/hub/examples/)\n */\n\nimport { createServer } from 'node:http';\nimport { createRequire } from 'node:module';\nimport { mkdir, readdir, readFile, writeFile } from 'node:fs/promises';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nimport { staticHandler } from './lib/serve.mjs';\nimport { modeOf, SELF_REPORTED } from '../lib/hub/round.js';\nimport { findClients } from './lib/hub-client.mjs';\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');\nconst EXAMPLES = ['/lib/hub/examples/arena.html', '/lib/hub/examples/ghost.html', '/lib/hub/examples/parallel.html'];\nconst PAGE_MS = 300_000;\n\nconst args = process.argv.slice(2);\nconst option = (name, fallback) => {\n  const at = args.indexOf(`--${name}`);\n  if (at === -1) return fallback;\n  const [value] = args.splice(at, 2).slice(1);\n99:    const html = await (await fetch(/^https?:/.test(game) ? game : `${base}${game}`)).text();\n131:        const adapter = await ask(...a);\n170:  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));\n174:const browser = await chromium.launch({ headless: true, executablePath: process.env.CHROMIUM_PATH, args: ['--no-sandbox', '--autoplay-policy=no-user-gesture-required', ...browserArgs] });\n179:      const report = await stillWorks(game, null, { bare: true });\n180:      runs.push({ game, players: 1, scenario: 'draws', pass: report.pass, checks: report.checks });\n184:    const client = await clientCheck(game);\n186:      runs.push({ game, players: 0, scenario: 'static', pass: client.pass, checks: [client] });\n189:    const { mode, seats } = await headOf(game);\n192:    const plan = retrofit && !asked ? [] : counts.map((n) => ({ n, scenario: 'standard' }));\n194:    if (asked || leaving <= seats[1]) plan.push({ n: leaving, scenario: 'host-leave' });\n196:    if (!retrofit && mode && !SELF_REPORTED.includes(mode) && (asked || (seats[0] <= 2 && seats[1] >= 2))) plan.push({ n: 2, scenario: 'server' });\n197:    for (const { n, scenario } of plan) {\n198:      const context = await browser.newContext({ viewport: { width: 1280, height: 860 } });\n199:      await context.addInitScript(watch);\n200:      const page = await context.newPage();\n205:      const query = { game, players: n, latency: 150, jitter: 50, loss: 5, auto: 1, scenario, play: 8000 };\n207:      await page.goto(url);\n210:      const finished = await page.waitForSelector('body[data-complete=\"true\"]', { timeout: PAGE_MS }).then(() => true, () => false);\n211:      const report = (await page.evaluate(() => window.__hubCheck).catch(() => null)) || { pass: false, checks: [] };\n222:      runs.push({ game, players: n, scenario, pass: report.pass, checks: report.checks });\n224:        console.log(`${report.pass ? 'PASS' : 'FAIL'}  ${game}  ${n} players  ${scenario}`);\n227:      await context.close();\n230:      const report = await stillWorks(game, original && asPath(original));\n231:      runs.push({ game, players: 1, scenario: 'alone', pass: report.pass, checks: report.checks });\n239:  await browser.close();\n249:    text = await readFile(file, 'utf8');\n255:    for (const name of await readdir(path.dirname(file)).catch(() => [])) {\n256:      if (/\\.m?js$/.test(name)) text += '\\n' + (await readFile(path.join(path.dirname(file), name), 'utf8').catch(() => ''));\n275:    const context = await browser.newContext({ viewport: { width: 1280, height: 800 } });\n276:    await context.addInitScript(watch);\n277:    const tab = await context.newPage();\n280:    await tab.goto(/^https?:/.test(page) ? page : `${base}${page}`);\n281:    await tab.waitForTimeout(2500);\n283:      await tab.keyboard.press(key).catch(() => {});\n284:      await tab.waitForTimeout(500);\n286:    await tab.waitForTimeout(2000);\n287:    const hub = await tab.evaluate(() => (window.AIHub ? { active: window.AIHub.active, seeded: window.AIHub.seeded } : null)).catch(() => null);\n288:    const gfx = await tab.evaluate(() => window.__gfx ?? null).catch(() => null);\n291:    const bytes = (await tab.screenshot({ type: 'png' }).catch(() => Buffer.alloc(0))).length;\n292:    await context.close();\n295:  const blank = await (async () => {\n296:    const context = await browser.newContext({ viewport: { width: 1280, height: 800 } });\n297:    const tab = await context.newPage();\n298:    await tab.setContent('<body style=\"margin:0;background:#000\"></body>');\n299:    const bytes = (await tab.screenshot({ type: 'png' })).length;\n300:    await context.close();\n303:  const after = await visit(game);\n306:  const known = before ? new Set((await visit(before)).errors) : new Set();\n330:    manifest = JSON.parse(await readFile(path.join(ROOT, 'data/games.json'), 'utf8'));\n==== matrix\n#!/usr/bin/env node\n/**\n * Bring packaged gpt-matrix runs onto the wall.\n *\n * Each run's game is the single HTML file directly inside workspace/. The\n * file is renamed to GameTitle-SOURCE-model-effort-YYYYMMDD-HHMM.html and\n * handed to `scripts/ingest.mjs`, which skips byte-identical pages, refuses\n * to overwrite anything, and rewrites known Three.js and Rapier URLs.\n *\n *   node scripts/import-matrix-runs.mjs --dry-run\n *   node scripts/import-matrix-runs.mjs\n */\n\nimport { spawn } from 'node:child_process';\nimport { createHash } from 'node:crypto';\nimport { link, mkdir, readdir, readFile, rm, stat, writeFile } from 'node:fs/promises';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nimport { planMatrixRun, finalizeMatrixPlans, matrixPageText } from './lib/matrix-runs.mjs';\nimport { slugify } from './lib/parse.mjs';\nimport { ROOT, GAMES_DIR } from './scan.mjs';\n\nconst HERE = path.dirname(fileURLToPath(import.meta.url));\nconst RUNS = process.env.MATRIX_RUNS || '/home/micha/dev/gpt-matrix/data/runs';\nconst STAGE_ROOT = process.env.MATRIX_STAGE || path.join(process.env.HOME || '/home/micha', '.cache/ai-hub-matrix-intake');\nconst STAGE = path.join(STAGE_ROOT, 'pages');\nconst DRY = process.argv.includes('--dry-run');\nconst HTML = /\\.html?$/i;\n\nconst sha256 = (buf) => createHash('sha256').update(buf).digest('hex');\n\nasync function walkHtml(dir, out) {\n  let entries;\n  try {\n    entries = await readdir(dir, { withFileTypes: true });\n  } catch {\n    return;\n  }\n  for (const entry of entries) {","is_error":false}]},"parent_tool_use_id":null,"session_id":"5ea1b61d-e1b8-4350-be76-ae4a4cbc51a9","uuid":"5b08fee0-9de1-45c8-9fc7-15c33fada1a6","timestamp":"2026-11-05T04:29:57.023Z","tool_use_result":{"stdout":"#!/usr/bin/env node\n/**\n * hub-check.mjs — does a game keep the AI Hub Session Protocol?\n *\n * Runs lib/hub/harness.html?auto=1 against each game, at the player counts its\n *