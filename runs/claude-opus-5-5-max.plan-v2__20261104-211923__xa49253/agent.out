n3 run9.py out/single.html; echo ---; timeout 200 python3 run9.py out/proto4.html","description":"Compare the plain kit and the prototype on WebGPU","timeout":420000}},"wire_ingest_context":{"toolu_0119xQoHfrXCH2i7e5PcNLNS":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211923__xa49253/work/.research/exp"}}}
