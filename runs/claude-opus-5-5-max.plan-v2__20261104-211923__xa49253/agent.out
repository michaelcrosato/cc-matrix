   const dt = clamp(drawT - (lastDraw ?? drawT), 0, .05); lastDraw = drawT;\n    let cam = S.cam || w.camera.fixed;\n    if (S.cam) {   // the camera where the frame is, turned by the newest mouse moves at once (the next step takes them)\n      const live = S.alive && !S.won, m = w.camera.mouse, k = live ? lookK() : 0, pc = ip.cam || cam;\n      const yaw = cam.yaw + m[0] * k, pitch = clamp(cam.pitch - m[1] * k, -1.5, 1.5), roll = lerp(pc.roll, cam.roll, al), fov = lerp(pc.fov, cam.fov, al);\n      let p = between(pc && [pc.x, pc.y, pc.z], cam.x, cam.y, cam.z, al);\n      if (S.view === 'third' && live) p = thirdCam(hp[0], hp[1], hp[2], lerp(ip.eye, S.eye, al), lerp(ip.adsB, S.adsB, al), lerp(ip.ph, S.stepPh, al), yaw, pitch, lerp(ip.clr, S.camClr, al)).p;\n      cam = Object.assign({}, cam, { x: p[0], y: p[1], z: p[2], yaw, pitch, roll, fov }); w.camera.pose = Object.assign({ ortho: false }, cam);\n    }\n    fx.cam = [cam.x, cam.y, cam.z];\n    drawGrass(w, cam.x, cam.y); grass.uT.value = drawT; grass.uP.value.set(hp[0] / M, hp[2] / M, hp[1] / M); drawTracers(dt);\n    const pen = w.pen; pen.at();\n    syncBody(dt, hp);\n    if (S.view === 'third' || !S.alive) { pose(w, pb, dt); if (pb.gun.mag === 1) pb.gun.magP = add(pb.J.hands[0], pb.G.u, 2.1); drawSoldier(pen, pb); }\n    for (const e of raiders) {\n      const d = Math.hypot(e.a.x - cam.x, e.a.y - cam.y); if (d > 320 * M || !w.camera.sees(e.a.x, e.a.y, e.a.z, 40)) continue;\n      if (S.view === 'first' && e.alive && d < 8 && cam.z > e.a.z && cam.z < e.a.z + 32 * e.b.k) continue;   // (a body the eye is inside isn't drawn)\n      syncRaider(e, dt, al); e.b.visible = d < 110 * M; pose(w, e.b, dt); drawSoldier(pen, e.b);\n      if (e.flash > .6 && e.b.G) w.glow(...at(e.b.G, 12.8, .55), 1.2, '#ffc870', { light: true, core: '#fff4d0' });\n    }\n    drawWorks(pen, cam.x, cam.y, al);\n    const L = lights, F = frameYP([cam.x, cam.y, cam.z], S.yaw, S.pitch), mz = muzzlePoint(F);\n    Object.assign(L.muzzle, { x: mz[0], y: mz[1], z: mz[2], on: S.flash > .6, power: (S.view === 'third' ? 11 : 6) * S.flash, reach: S.view === 'third' ? 160 : 100 });   // (the shot's own frame only: no strobe)\n    if (S.boom && S.boom.t > 0) { Object.assign(L.boom, { x: S.boom.x, y: S.boom.y, z: S.boom.z + 20, on: true, power: 90 * S.boom.t / .35 }); S.boom.t -= dt; } else L.boom.on = false;\n    const fire = OP.ridge.fire; if (fire) { const fl = .85 + Math.sin(drawT * 13) * .08 + Math.sin(drawT * 29) * .06; Object.assign(L.fire, { x: fire[0], y: fire[1], z: fire[2] + 10, on: Math.hypot(fire[0] - cam.x, fire[1] - cam.y) < 140 * M, power: 18 * fl }); w.glow(fire[0], fire[1], fire[2] + 3, 2.6 * fl, '#ff9a3a', { core: '#fff0b0' }); }\n    for (const o of OUTPOSTS) if (o.beacon && (w.time % 1.6) < .8) w.glow(...o.beacon, 4, '#ff3a2a', { core: '#ffd0c0' });\n    w.overlay.on = S.view === 'first' && S.alive;\n    if (w.overlay.on) { w.overlay.camera.fov = lerp(54, 44, ease(S.adsB)); drawViewModel(w.overlay.pen, dt, cam); }\n    const now = performance.now() / 1000, rdt = clamp(now - (lastReal ?? now), 0, .05); lastReal = now;   // (hits' stars run on the clock: a hit-stop freezes the world, not the spark)\n    for (const st of fx.stars) {\n      const list = st.ov ? fx.flashes.ov : fx.flashes.world; if (list.length >= FL_MAX) continue;\n      if (st.v) { const u = st.t / st.life, q = add(st.p, st.v, st.t); q[2] -= (st.ov ? 450 : 900) * st.t * st.t; list.push({ p: q, f: st.f, s: st.s * (1 - u * .5), heat: .7 * (1 - u * .7), seed: st.seed + Math.floor(st.t * 60), pal: st.pal, thin: true }); }\n      // (the first frame is anything under half a frame old: a frame of clock time can compare as a hair under 1/60)\n      else { const first = st.t < .5 / 60; list.push({ p: st.p, f: st.f, s: st.s * (first ? 1.5 : .85), heat: first ? 1 : .5, seed: st.seed, pal: st.pal, thin: !first }); }\n    }\n    for (const st of fx.stars) st.t += rdt;\n    fx.stars = fx.stars.filter(st => st.t < (st.life || 1.5 / 60));\n    drawFlashes(fx.flW, fx.flashes.world, fx.cam); drawFlashes(fx.flO, fx.flashes.ov, [0, 0, 0]);\n  }\n  /** a fresh run: the world reset, the structures' blocks, doors shut, bins full, crews home, the player at the drop\n   *  point facing the range, the scatter round them at once */\n  function reset(seed = 1) {\n    world.reset(); rnd = E.rng(seed);\n    raiders.length = loot.length = nades.length = 0; placed.clear(); fx.tracers.length = fx.stars.length = 0; lastDraw = null; ip.h = ip.cam = null;\n    for (const s of solids) world.block(s);\n    for (const d of doors) Object.assign(d, { state: 'shut', ang: 0, want: 0, block: null, deb: null });\n    for (const b of bins) Object.assign(b, { open: 0, want: 0, used: false });\n    for (const sl of spawns) { sl.dead = false; sl.e = null; }\n    for (const o of OUTPOSTS) { o.spawned = false; o.left = spawns.filter(s => s.op === o.id).length; }\n    S = newState(); const P0 = OP.drop.P, s0 = atP(P0, 0, 14); S.yaw = P0.yaw - Math.PI / 2;\n    hero = world.hero({ x: s0[0], y: s0[1], r: RADIUS, half: HALF, visible: false, shadow: false, slope: 48, step: 5, snap: 5 });\n    pb = body('player'); pb.yaw = S.yaw;\n    for (const d of dummies) spawnRaider(Object.assign({ dummy: true, op: 'drop' }, d));\n    streamScatter(world, hero.x, hero.y, 1e9);\n    world.camera.set('fixed'); world.camera.follow(S.focus); camStep(0);\n  }\n  const I = { move: [0, 0], mouse: [0, 0], stick2: null, pressed: (a, w) => game.input.buffered(a, w), use: a => game.input.consume(a), down: a => game.input.down(a) };\n  /** the proof: a scripted run from the drop point (moving, sprinting, a slide, jumps, bursts at the range, a punch, a\n   *  swap, a reload, aiming), n steps of 1/120 s; returns the world's hash */\n  function run(n = 600) {\n    reset(3); let i = 0;\n    const c = { move: [0, -1], mouse: [0, 0], stick2: null, use() {},\n      pressed: a => (a === 'jump' && i % 150 === 40) || (a === 'crouch' && i === 190) || (a === 'melee' && i === 330) || (a === 'swap' && i === 400) || (a === 'fire' && i > 420 && i % 50 === 0) || (a === 'reload' && i === 560),\n      down: a => (a === 'sprint' && i < 200) || (a === 'fire' && i > 100 && i < 330 && i % 60 < 30) || (a === 'aim' && i > 440) || (a === 'crouch' && i > 190 && i < 230) };\n    for (i = 0; i < n; i++) { c.move = [Math.sin(i / 70) * .5, -1]; c.mouse = [Math.sin(i / 50) * 3, Math.cos(i / 80) * 1.2]; step(1 / 120, c); }\n    return world.hash([S.kills, S.ammo.rifle[0], S.ammo.shotgun[0], S.hp, S.shield, raiders.length, Math.round(S.yaw * 1000)]);\n  }\n  /* ---- a phone: a finger on the look side drags the view (the move stick is on the other) ---- */\n  function touchLook() {\n    const cv = game.screen.canvas; if (!cv || typeof document === 'undefined') return;\n    const ids = new Map();\n    cv.addEventListener('pointerdown', e => { if (e.pointerType === 'mouse' || active !== world || game.paused) return; const r = cv.getBoundingClientRect(), right = e.clientX - r.left > r.width * .5; if (right === (game.input.stickSide === 'right')) return; ids.set(e.pointerId, [e.clientX, e.clientY]); });\n    cv.addEventListener('pointermove', e => { const p = ids.get(e.pointerId); if (!p || active !== world) return; world.camera.mouse[0] += (e.clientX - p[0]) * 2.4; world.camera.mouse[1] += (e.clientY - p[1]) * 2.4; p[0] = e.clientX; p[1] = e.clientY; });\n    const up = e => ids.delete(e.pointerId); addEventListener('pointerup', up); addEventListener('pointercancel', up);\n  }\n  BOOT.push(['The badlands: land, roads and outposts', () => { for (const [k, v] of Object.entries(SOUNDS)) A.define(k, v); planLand(); layout(); }]);\n  BOOT.push(['The open world', () => {\n    world = new W3(game, { terrain: { size: SIZE, cell: 32, chunk: 32, height, color, far: 17000, physics: 1400, detail: 1.2, rock: { colors: ['#a8644a', '#c47e5a', '#8e523c', '#d0946a', '#b06e50', '#7a4632', '#c8885e'], band: 46, slope: [.34, .52] }, speckle: .2, mottle: .34 },\n      sky: { top: '#3d6fb8', horizon: '#f2dcb4', ground: '#b49070', sun: '#fff0c8', haze: .3 }, fog: { color: '#ead4b0', near: 2200, far: 19000 },\n      ambient: ['#c4d4ee', '#8a6a48', 1.55], sun: { color: '#fff0d8', intensity: 3.1, dir: [-.55, .4, -.62], area: 1150, map: 2048 },\n      torchLights: 0, glowLights: 4, lights: 3, overlay: { fov: 58 }, camera: { mode: 'fixed', capture: true, near: 1.2 }, res: 'balanced', gravity: GRAV, onDraw });\n    structureMesh(world); grassMeshes(world); fxMeshes(world);\n    lights = { muzzle: world.light({ color: '#ffc870', reach: 220, power: 0 }), boom: world.light({ color: '#ff9a4a', reach: 700, power: 0 }), fire: world.light({ color: '#ff8a3a', reach: 170, power: 0 }) };\n    reset(1); touchLook();\n  }]);\n  return {\n    view: 'iso', input: KEYS, pausable: true, touch: TOUCH,\n    enter() { reset(1); active = world; A.music(null); game.input.touchButtons(TOUCH, { labels: TOUCH_LABELS }); },\n    update(dt) {\n      I.move = game.input.move(); world.camera.takeMouse(I.mouse); I.stick2 = game.input.padAim;\n      step(dt, I);\n      const inp = game.input; inp.touchSet('use', S.near ? 'USE' : null, !!S.near); inp.touchSet('melee', S.near && S.near.kick ? 'KICK' : null, !!(S.near && S.near.kick) || raiders.some(e => e.alive && Math.hypot(e.a.x - hero.x, e.a.y - hero.y) < 5 * M));\n    },\n    draw(r) { world.draw(r); r.overlay(g => hud(g, r)); },\n    get world() { return world; }, get hero() { return hero; }, get state() { return S; }, get raiders() { return raiders; },\n    /** the player's soldier (b.J: its joints, posed each frame it is drawn) and the first-person arms and gun (vm.F: the\n     *  gun's frame in the eyes' space, vm.L, vm.R: the hands), for tools that measure the motion */\n    get player() { return pb; }, get viewModel() { return vm; }, get outposts() { return OUTPOSTS; }, reset, run,\n    /** the soldier's rig, for a sheet of its poses (tools, tests): body(look), pose(world, b, dt), draw(pen, b) */\n    rig: { body, pose, draw: drawSoldier, onDraw }\n  };\n})();\nscenes.shooter = SHOOT;\n===== START\n/* ---- START: the boot (the 3D engine, then each slice's world, behind the boot screen), then the title menu, or a\n * slice named in the address (#platformer; #racing/vs: the slice's enter(data) gets { part }) ---- */\n// a 3D genre kit file holds one slice: the menu lists only the slices in this file\nfor (let i = SLICES.length - 1; i >= 0; i--) if (!scenes[SLICES[i].id]) SLICES.splice(i, 1);\ntitleMenu = menuOf(SLICES, { y: 0, room: 34, onPick: i => game.go(SLICES[i].id) });\nconst [first, part] = (location.hash || '').slice(1).split('/');\ngame.start({ scenes, scene: scenes[first] ? first : 'title', data: scenes[first] && part ? { part } : undefined, boot: { title: 'my-3D2dge 3D', steps: [\n  ['The 3D engine: three.js r182, Rapier 0.19.3', () => W3.init(game)],\n  ...BOOT,\n  ['Building the shaders', () => { for (const w of W3.worlds) w.prepare(); }]\n] } });\nwindow.__game = { game, scenes, titleMenu, get title() { return title; } };   // for tests\n/* =============================== GAME END =============================== */","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_013tnZocthsrZFsobgqa5Pk2","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgj9PPG1axoXys3uZshLW","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NhpgHuXD73Mo7hU64cxFnh","name":"Bash","input":{"command":"sed -n 1,60p tools/kit3d-test.mjs | cut -c1-360; echo; echo ===== STANDARD; sed -n 1,127p docs/STANDARD-FEATURES.md | cut -c1-420","description":"Read how the 3D kits are tested and what standard features exist"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11291,"cache_read_input_tokens":152635,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11291},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5ea1b61d-e1b8-4350-be76-ae4a4cbc51a9","uuid":"4b3564ae-5704-460a-a991-79e96c9e0e0c","timestamp":"2026-11-05T04:26:55.697Z","request_id":"req_011Cgj9PNzskbrzW6Ye6TMKN","wire_tool_inputs":{"toolu_01NhpgHuXD73Mo7hU64cxFnh":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211923__xa49253/work/.research/engine/my-3d2dge && sed -n 1,60p tools/kit3d-test.mjs | cut -c1-360; echo; echo ===== STANDARD; sed -n 1,127p docs/STANDARD-FEATURES.md | cut -c1-420","description":"Read how the 3D kits are tested and what standard features exist"}},"wire_ingest_context":{"toolu_01NhpgHuXD73Mo7hU64cxFnh":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211923__xa49253/work/.research/engine/my-3d2dge"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NhpgHuXD73Mo7hU64cxFnh","type":"tool_result","content":"// The 3D engine's check (engine/my-3d2dge-3d.js) and its kits (src/starter3d/, built into dist/my-3d2dge-3d.html and\n// dist/kits/my-3d2dge-3d-<slice>.html).\n//   1. the rules, read from the 3D engine's and the kits' own sources (not the vendored libraries): three.js through\n//      WebGPURenderer and node materials only (no WebGLRenderer, ShaderMaterial, onBeforeCompile, EffectComposer,\n//      addons), no WebGPU-only compute or storage buffers, nothing read back from the GPU; the import map points at\n//      vendored files that exist, and those files match their checksums (tools/vendor-3d.mjs --check)\n//   2. the manual's quick start (the ```js quickstart block in the engine's header) runs as the manual hosts it: no\n//      errors, a hero that walks and jumps, gems to take\n//   3. every 3D kit, served as Vercel serves it (/kits/3d-<slice>, /3d), on WebGL 2 and on WebGPU (headless Chromium runs\n//      WebGPU on SwiftShader, through a stand-in canvas): no page errors, the title\n//      draws, each slice starts; each slice's proof run gives the same hash twice and on both backends (the game never\n//      reads the renderer); a minute of scripted play builds no GPU pipeline mid-game (the warm-up's job) and moves\n//      the hero; pictures in check-output/kit3d/ (read them)\n//   3b. shapes (world.shape: the 2D engine's entries in 3D): every core shape builds and draws on WebGL 2 and on WebGPU (its\n//      pixels change where it stands), a hero walking into a solid one stops and one dropped on a table lands on it; a\n//      sheet of every core shape in 3D beside its 2D picture (check-output/kit3d/shapes-<backend>.png: read it)\n//   3c. the camera's contracts (lock-on, camera zones, tank steering) and the door between rooms, on a page of their own:\n//      lock picks the one in sight nearest where the hero faces (never one behind a wall), cycle goes round to the next\n//      and keeps the lock when none other is in sight, the chase camera frames both and ground() strafes round the\n//      target, the lock lets go of a target that dies, leaves or goes out of range; a zone's cut waits until the target\n//      is margin units in (and not back on the border), the stick held across a cut keeps its way until it is let go;\n//      tank steering turns and walks along the facing; world.reach finds the door in front, world.unlock takes the key,\n//      world.through puts the actor beyond the door while nothing else moves; the same at 60, 90, 120 and 144 frames\n//   3d. vehicles, tracks, flight and split screen, on a page of their own, on WebGL 2 and on WebGPU: a kart takes to its\n//      top speed along the road, a boost pad boosts it, a wall stops it, the grass beside the road slows it, a hop held\n//      into a bend drifts and charges a boost, a hovercraft rides its cushion, a kart on a banked bend sits on the bank;\n//      E.Race (the drive module) races two AI vehicles a lap over the hump (in the air) to the finish; a flyer on rails\n//      keeps the rail's pace and moves within its window, a barrel roll ends, one in free flight turns back into its\n//      bounds, seek picks the one in its cone and in sight; all of it twice the same and the same on both backends; a\n//      split screen draws two views through world.cameras (check-output/kit3d/split-<backend>.png: read it), side by side\n//      and stacked (viewport 0 on top, as the 2D layout has it: split-rows-<backend>.png)\n//   3e. first person with the cel filter, on both backends: the filtered hall and the overlay's gun are both drawn\n//      (check-output/kit3d/fps-cel-<backend>.png)\n//   4. on an emulated phone held upright (390 x 844 at 3x, touch): every kit starts, the 3D picture lies exactly under the\n//      game's, the touch buttons are there\n// Usage: node tools/kit3d-test.mjs   (run node tools/build.mjs first; CHROMIUM_PATH picks a browser). Exit code 1 on failure.\nimport { chromium } from 'playwright';\nimport { createServer } from 'node:http';\nimport { readFileSync, existsSync, statSync, readdirSync, mkdirSync, writeFileSync } from 'node:fs';\nimport { execFileSync } from 'node:child_process';\nimport { resolve, join, extname } from 'node:path';\n\nconst root = resolve('.');\nconst problems = [], notes = [];\nconst fail = m => problems.push(m);\nconst read = f => readFileSync(join(root, f), 'utf8');\n\n/* 1. the rules */\ntry { execFileSync('node', ['tools/vendor-3d.mjs', '--check'], { cwd: root, stdio: 'pipe' }); } catch (e) { fail(String(e.stderr || e.message).trim()); }   // the vendored files\nconst BANNED = [\n  [/\\bWebGLRenderer\\b/, 'WebGLRenderer (use WebGPURenderer: it falls back to WebGL 2 by itself)'],\n  [/\\b(Raw)?ShaderMaterial\\b/, 'ShaderMaterial (write node materials or TSL)'],\n  [/\\bonBeforeCompile\\b/, 'onBeforeCompile (not run by WebGPURenderer)'],\n  [/\\bEffectComposer\\b|three\\/examples|three\\/addons/, 'addons and EffectComposer (not vendored; post-processing is TSL)'],\n  [/\\bcompute\\s*\\(|\\bStorageBufferAttribute\\b|\\bstorage\\s*\\(|\\bcomputeAsync\\b/, 'compute shaders or storage buffers (WebGPU only)'],\n  [/readRenderTargetPixels|readPixels\\s*\\(/, 'reading pixels back (nothing comes back from the GPU into gameplay)']\n];\nconst SLICES = readdirSync(join(root, 'src/starter3d')).filter(f => /^[1-8]\\d-.+\\.js$/.test(f)).map(f => f.replace(/^\\d+-|\\.js$/g, ''));\nconst SOURCES = ['engine/my-3d2dge-3d.js', 'src/starter3d.template.html', ...readdirSync(join(root, 'src/starter3d')).filter(f => f.endsWith('.js')).map(f => 'src/starter3d/' + f)];\nconst engine3d = read('engine/my-3d2dge-3d.js'), manual = engine3d.slice(0, engine3d.indexOf('*/'));\n\n===== STANDARD\n# Standard features: what every game gets, and the quality prompt they answer\n\nGames built on the engine used to start without the things players expect of a modern release: no full screen, no\nsettings, no way to rebind a key, a pause that ignored a hidden tab. The owner then had to send each builder a long\nquality prompt (\"Universal Game Controls, Display, Accessibility, and Quality Upgrade\", v2) and pay for the output tokens\nit took to write them, game by game. Since v0.23.0 the engine gives them to every game with no code (engine section 10b,\nand `E.Shell`'s standard menu), and the manuals say so up front: a few hundred input tokens instead of thousands of output\ntokens per game.\n\nThis file is that prompt's review: its requirement matrix (section 2 of the prompt), the action coverage of the presets,\nwhat stays each game's job, and how it was verified. How to use and adjust the features: `AI_GUIDE.md`, \"Standard\nfeatures\"; the API card's section of the same name; the full engine's header, point 8a.\n\n## What a game gets, and how it adjusts it\n\n| Feature | With no code | Adjust | Leave out |\n| --- | --- | --- | --- |\n| Pause menu (full engine) | a pausable scene pauses on Escape, P, Start, the touch START or the corner's menu button: Resume, Settings, Controls, Full screen, Help, Quit to title (asks first) | `menu: { items: [['Restart', fn]], quit: 'title' }` | `menu: false` (the canvas PAUSED overlay) |\n| Settings | `game.settings`: Display (full screen, camera zoom where a scene allows it, pixel scaling), Sound (sound, volume, music, effects, sound in the background), Comfort (reduce motion, shake, flashes), saved per game | `menu: { settings: [{ key, label, value, options, min, max }] }`, read `game.settings.key` | |\n| Controls | every action of the preset rebound by pressing the new key or button; the controller (dead zone, invert aim, button symbols, vibration); the touch buttons (visibility, side, size, opacity); restore defaults | `menu: { controls: { attack: 'Sword', debug: false } }` | |\n| Full screen | `game.fullscreen`; a phone's first tap; the corner's button; the menu; the player's choice kept | | `fullscreen: 'button'` (no tap) or `false` |\n| Pausing by itself | a pausable scene pauses when the page is hidden, the window loses focus or the controller in use is unplugged; only the player resumes (`game.pauseReason`) | `game.pause(reason)`, `game.resume()` | `autoPause: false` |\n| The corner | menu and full-screen buttons, top right in the safe area: on titles, pauses and game overs, when the mouse nears the top, and the menu on a touch screen without touch buttons | `game.menu('settings')` from a canvas title's OPTIONS | `corner: false` |\n| Prompts | `game.input.label(action)`: the key or button on the device in use, after rebinding, in the controller's own symbols | `settings.glyphs` | |\n| Boot (v0.24.0) | a page's splash from its first paint (the built pages have it); the game's heavy setup one step a frame behind a boot screen (the system's checks, a progress bar, the game's own lines), then a warm-up frame; any error before play becomes a report to screenshot | `game.start({ boot: { title, version, steps, messages, min } })`; `E.diagnose()` | `boot: false` |\n| Phones | a viewport reaching the safe areas, no page gestures on the canvas, touch buttons in the safe areas, a stick with a dead zone, a fixed resolution filling a high-density screen | `settings.scale` | |\n\nThe agent edition has `game.settings`, `game.fullscreen`, the corner, the pausing and `input.label`, not the menu screens\n(its corner's menu button pauses and resumes). Emberdeep and the labs with panels of their own keep theirs (`menu: false,\ncorner: false, fullscreen: 'button'`); Emberdeep's full screen now goes through `game.fullscreen`.\n\n## Requirement matrix\n\nStatus: **built in** (the engine does it for every game), **already met** (it did before v0.23.0), **the game's job** (only\nthe game knows it; the manuals say so), **deferred** (production hardening, principle 10: done when a game heads to\nproduction, which pays for it), **not applicable** (with the reason).\n\n| Prompt section | Requirement | Before (v0.22.4) | Now (v0.23.0) | Status | Verified by |\n| --- | --- | --- | --- | --- | --- |\n| 3 Display | Separate CSS size from the render buffer; a pixel-ratio limit; sharp UI text | low-res buffer, whole-number upscale, ratio capped at 3; HTML text | same | already met | existing suites |\n| 3 Display | Use the whole area without stretching | a fixed `res` letterboxed at a whole-number scale: up to a fifth of a phone's screen black | `scale`: Auto (fill on screens of 2x density and up), Sharp, Fill; since v0.26.0 `expand: true` makes `res` the least the screen shows and fills every shape with no bars (the starter kits use it) | built in | `standard-test` (fill at 3x, whole with Sharp, expand at five sh\n| 3 Display | Portrait and landscape both work | adaptive size and `portrait` options; a fixed `res` letterboxes | same, and a fixed `res` fills more; with `expand` it fills both ways (what fills the extra space is the game's job: since v0.27.0 the kits fill it edge to edge, the HUD over the world's corners, `AI_GUIDE.md`) | already met | phone emulation, both ways |\n| 3 Display | Safe areas | the Shell's panels and Emberdeep's HUD keep out of them | the corner and the touch buttons too; the viewport reaches them (`viewport-fit=cover`) | built in; a canvas HUD under a notch is the game's job | `standard-test` (viewport) |\n| 3 Display | After a resize or rotation: rebase drags, recalculate input | canvas and mouse mapping recalculated | the touch stick is lifted on a resize, input cleared on a full-screen change | built in | code review; phone emulation |\n| 3 Display | Folds and hinges | none | none | deferred | |\n| 3 Display | The on-screen keyboard | no text fields | no text fields | not applicable | |\n| 4 Full screen | A clear control, from a player action, of the whole page (game, HUD, menus) | Emberdeep only | `game.fullscreen` on `document.documentElement`; a phone's first tap, the corner, the menu | built in | `standard-test`; phone screenshots |\n| 4 Full screen | Handle refusals and changes; never force it back after the player leaves | Emberdeep only | a refusal noted on screen and kept in `failed`; the player's choice saved on every change, and a phone's tap honors it. Since v0.27.0 the choice is what the player turns off (the corner's button, the menu); leaving by a back gesture or Escape is not one: a game started by a tap goes full screen again (D24) | \n| 4 Full screen | Explain what a platform can't do | Emberdeep's README note | the settings row: \"On an iPhone: Share, then Add to Home Screen\"; the home-screen app tags added to the page | built in | code review (no iPhone here) |\n| 4 Full screen | Pointer lock, orientation lock, wake lock | none | none: the engine's cameras need no pointer lock, both orientations work, wake lock is not asked for | not applicable (pointer, orientation); deferred (wake lock) | |\n| 4 Full screen | No page gestures on the game, menus still scroll, pinch zoom not disabled | `touch-action: none` in the pages' own CSS | set on every game's canvas by the engine; the menu is a separate layer that scrolls; the viewport leaves zoom alone | built in | `standard-test` |\n| 4 Full screen | A PWA manifest, offline play, updates at a safe point | none | none | deferred: the site is the review surface, not a store release | |\n| 5 Input | Named actions, several sources, pressed / held / released, buffering, clearing on focus loss | yes | same; menus hold the game's input back; the touch START is the gamepad's Start (since v0.27.0 the corner's menu button, top right, there in play on a touch screen) | already met, extended | contract and standard suites |\n| 5 Input | Radial dead zones; no drift; no duplicate events | the gamepad's sticks | the touch stick too (12%); prompts follow the last device used | built in | code review |\n| 6 Keyboard and mouse | Remap gameplay actions and mouse buttons; conflicts shown before applying; recovery from a lost essential | Emberdeep only | `input.rebind` and the Controls screen; menu keys reserved; restore defaults | built in | `standard-test` (rebind, conflict, reserved, cancel, saved) |\n| 6 Keyboard and mouse | Labels true to the keyboard layout | QWERTY codes | the browser's layout map where it gives one (an AZERTY Z), the code's position elsewhere | built in | code review (Chromium only) |\n| 6 Gamepads | Sticks, buttons, triggers, d-pad; menus without a mouse | yes (standard mapping) | same; the menu by d-pad and stick | already met | contract (focus by input) |\n| 6 Gamepads | Dead zone, inversion, remapping, restore defaults | dead zone and inversion as fields | settings on the Controls screen | built in | `standard-test` |\n| 6 Gamepads | Symbols by family, a manual choice, a positional fallback | Emberdeep's labels | Xbox, PlayStation, Nintendo from the controller's name, or chosen; \"Positions\" | built in | `standard-test` |\n| 6 Gamepads | Disconnects: clear its input, pause, a message, keep playing on another device | input released | a pausable scene pauses with \"Controller disconnected\" | built in | `standard-test` |\n| 6 Gamepads | Vibration where there is an actuator, an off and a strength setting, stopped on pause | none | `input.rumble`, `hitFx` rumbles, the Vibration slider, stopped on pause, focus loss and unplugging | built in | code review (no controller here) |\n| 6 Gamepads | Non-standard mappings, analog trigger values, adaptive triggers | standard mapping assumed | same | deferred | |\n| 7 Touch | A floating stick from the first contact, neutral on release, ownership per finger | yes | a dead zone; side, size, opacity and visibility from settings; a laptop's touch screen shows the buttons once touched; since v0.26.0 the stick past halfway presses the directions (menus, dialog choices, ladders) and a bottom dialog keeps clear of the buttons (`input.touchArea()`); since v0.26.1 a tap or click on an `\n| 7 Touch | Camera and aim by touch, pinch zoom | Emberdeep's own | since v0.32.0 the player's zoom: a two-finger pinch (both fingers moving: not the stick), the wheel, - and =, Settings, Camera zoom, within a scene's `camera.zoom`, kept on top of the zoom the scene starts at | built in (zoom, where a scene allows it); aim the game's job (the engine has no free camera) | `phone-test` (zoom) |\n| 8 Context actions | Stable positions; hidden controls get no input; tap and hold | the touch buttons don't move | same; hidden corner buttons are `display: none`; since v0.27.0 `input.touchSet(a, label, show)` relabels a button or hides it while it has nothing to do (a hidden one lets go and leaves `touchArea()`), as the adventure's TALK and the stealth's TAKE DOWN and PARRY do | built in; which action fits the mom\n| 9 Camera comfort | Shake, flashes, motion | reduce motion (from the system) | settings for each, applied to `game.shake` and `game.flash` | built in | `standard-test` |\n| 10 Assistance | Aim assist, auto-fire, input buffering, hold or toggle | `buffered` | a place for them (`menu.settings`); since v0.27.0 the shooter kit fires by itself on a touch screen and the RPG kit takes taps on its commands and foes | the game's job | phone screenshots |\n| 11 Menus and accessibility | Full menu use by touch, mouse, keys, gamepad; focus shown, set on open, restored on close, scrolled into view | the Shell's pause and settings | the same for every game, with focus restored on the way back; since v0.27.0 every screen has a close button at the top right (where the menu button was), one over another a back arrow at the top left, and a sideways swipe goes back a screen | b\n| 11 Menus and accessibility | The back gesture never strands the player | none: a phone's back left the page | since v0.27.0 an entry of the game's own in the page's history, added on a tap while there is somewhere to go back to: back closes the menu screen, pauses play into the menu, or takes a scene's own `back()` (`game.back()`), and only then leaves; `overscroll-behavior: none` stops pull to refresh and the side\n| 11 Menus and accessibility | Names and states; 44-pixel targets; 200% text; contrast; not color alone | roles on switches and dialogs | `role=switch`, `aria-checked`, a live status line on the Controls screen, 44-pixel buttons; the theme's ink on paper is high contrast | built in for menus; gameplay is the game's job | code review; no screen-reader run |\n| 11 Menus and accessibility | Subtitles and captions | `Dialog` shows speech as text | same | the game's job | |\n| 12 Settings | Display, interface, keyboard, gamepad, touch, camera, audio and gameplay groups | the Shell's sound, volume and motion | every group the engine can make work (see the table above); frame-rate limit, brightness, text size and HUD scale are not offered because nothing would honor them yet | built in where it can take effect | |\n| 12 Settings | Versioned, validated, blocked storage, migration, restore defaults per group | none | `{ v: 2, values }` under `settings:<path>` (v0.27.0: version 2, D24); each value checked on load; a broken save loads as defaults; blocked storage plays on (`saved: false`); the Shell's older saves carried over; `reset(group)` | built in | `standard-test` |\n| 13 Saving | Atomic, versioned saves, checkpoints, confirm before loss | `E.store` | same; Quit to title asks first | the game's job | |\n| 13 Pause | Pause reasons kept apart; focus never resumes; explicit resume | Emberdeep only | `pauseReason`; focus loss and unplugging pause, nothing resumes by itself | built in | `standard-test` |\n| 13 Recovery | Clear recovery for failed loads; real progress when it can be measured, an honest indicator when not | the red box, for developers | the boot screen: each step and a bar (measured by steps), a moving bar while the page loads; a failure before play shows what failed, the error, a code and the system, with Try again, Copy report and Continue | built in (v0.24.0) | `standard-test` (the screen, the report\n| 13 Pause | Long suspensions: no backlog | the clock takes at most 50 ms a frame | same | already met | contract (the clock) |\n| 13 Pause | Restart and reload without leaks | `dispose()` removes every listener | the corner and menus too | already met | contract (dispose) |\n| 14 Audio | Starts after a gesture; volumes per channel; settings before the first sound | yes; the Shell's volume | master, music, effects and mute saved and applied when the game is made | built in | `standard-test` |\n| 14 Audio | The background | music kept playing, choppy, in a hidden tab | the sound sleeps while the page is hidden unless \"Sound in the background\" is on | built in | code review |\n| 15 Performance | No cost when unused | | the menu is built only when it opens; the corner compares one number a frame | built in | the full suite's timings |\n| 16 First use | Instructions for the active input; settings before demanding play | | `input.label`; the corner's menu on a title opens the settings | built in; tutorials are the game's job | `standard-test` |\n| 17 Verification | Evidence a player can send: environment, build, reproduction | sessions (`E.session`) for developers | the failure report and `E.diagnose()`: engine and game versions, build, browser, device, screen, canvas, GPU, sound, storage, input, scene | built in (v0.24.0) | `standard-test` |\n| 17 Verification | Physical devices, browsers, controllers | | headless Chromium on Linux, phones emulated (390 x 844 and 844 x 390 at 3x) | deferred: no physical phone, iPhone or controller was used | |\n\n## Action coverage (the presets)\n\nWhat each action answers to in every preset, before the player rebinds. Touch: the move stick is the screen's free side\n(the left, or the right for a left-handed player); a scene's `touch: [...]` lists the buttons it needs; START is the\nmenu. Gamepad buttons are named by position, with the Xbox symbol (`input.label` shows the family's own).\n\n| Action | Keyboard and mouse | Gamepad | Touch | Presets |\n| --- | --- | --- | --- | --- |\n| up / down / left / right | WASD, arrows | left stick (past halfway), d-pad | the stick (past halfway it presses these too) | all |\n| start | Enter | Start | START | all (menus) |\n| pause | Escape, P | Start | START, the corner's menu | all (pausable scenes) |\n| confirm | Enter, Space, J, Z | A (south) | a tap on a menu | all (menus) |\n| cancel | Escape, Backspace, X, K | B (east) | the menu's Back | all (menus) |\n| attack | J, X, left click | A, RT (DEFAULT); X (PLATFORMER, THIRDPERSON) | a scene's button | DEFAULT, PLATFORMER, THIRDPERSON |\n| dash | Space, Shift, K (DEFAULT); Shift, C, L (PLATFORMER) | B, LT (DEFAULT); B, RB (PLATFORMER) | a scene's button | DEFAULT, PLATFORMER |\n| skill | L, E, right click (DEFAULT); E, V, right click | X, RB (DEFAULT); Y | a scene's button | DEFAULT, PLATFORMER |\n| jump | Z (DEFAULT); Space, Z, K | Y (DEFAULT); A | a scene's button | DEFAULT, PLATFORMER, THIRDPERSON (Space) |\n| sprint, crouch, interact, block, dodge, use, map | Shift; C, Ctrl; E, F; K, right click; L; Q; M, Tab | RT, L3; B; Y; LB; RB; LT; View | a scene's buttons | THIRDPERSON |\n| fire, bomb | Space, Z, J, click (hold); X, K, right click | A, RT; B, LT | a scene's buttons | SHMUP |\n| menu (the engine's) | the corner's button | | START, the corner's button | every game |\n| full screen (the engine's) | the corner's button, the menu (F11 is the browser's own) | the menu | a phone's first tap, the corner, the menu | every game |\n\nCommon actions never need a stick click or a two-button chord. On a touch screen without the engine's touch buttons, the\ncorner's menu button stays in reach while playing.\n\n## What stays the game's job\n\nThe manuals list these where a builder reads them (`AI_GUIDE.md`, Standard features; the API card): every gameplay scene\n`pausable: true`; prompts from `input.label`; touch buttons for every action a level needs; the assists its mechanics\ncall for, as settings; its own saves, versioned, written at checkpoints, confirmed before a loss; a canvas HUD clear of a\nphone's notch; nothing told by color alone.\n\n## Verification (v0.23.0)\n\n| Case | Environment | Evidence | Result |\n| --- | --- | --- | --- |\n| Settings, pausing, labels, rebinding, the touch START, boot steps and their failures (both editions) | Node 24 | automated (`tools/standard-test.mjs`) | pass |\n| The boot screen, the report, an error before and after play, `boot: false` (both editions); Emberdeep's first paint on a slowed CPU (0.16 s, was 1.6 s) | headless Chromium (4x CPU slowdown for the timing) | automated (`tools/standard-test.mjs`, 94 checks in all); screenshots | pass |\n| The page, the corner, the pause menu, Settings, Controls, rebinding, Quit, saved settings, bad and blocked storage, full screen, touch buttons, a game's own Shell, `menu: false` (both editions) | headless Chromium, desk and emulated phones | automated (`tools/standard-test.mjs`) | pass |\n| The menus by eye: title, play, pause, settings, controls, rebound | Chromium at 1280 x 720; emulated phone 390 x 844 and 844 x 390 at 3x | screenshots | pass |\n| The rest of the engine, Emberdeep and the labs | headless Chromium | `npm run test:changed` (all 20 suites) | pass |\n| A physical phone, an iPhone, a physical gamepad (rumble, symbols), a screen reader, a fold | none here | none | not tested |","is_error":false}]},"parent_tool_use_id":null,"session_id":"5ea1b61d-e1b8-4350-be76-ae4a4cbc51a9","uuid":"92881f12-e870-4259-bb61-dc5a131dcf11","timestamp":"2026-11-05T04:26:55.818Z","tool_use_result":{"stdout":"// The 3D engine's check (engine/my-3d2dge-3d.js) and its kits (src/starter3d/, built into dist/my-3d2dge-3d.html and\n// dist/kits/my-3d2dge-3d-<slice>.html).\n//   1. the rules, read from the 3D engine's and the kits' own sources (not the vendored libraries): three.js through\n//      WebGPURenderer and node materials only (no WebGLRenderer, ShaderMaterial, onBeforeCompile, EffectComposer,\n//      addons), no WebGPU-only compute or storage buffers, nothing read back from the GPU; the import map points at\n//      vendored files that exist, and those files match their checksums (tools/vendor-3d.mjs --check)\n//   2. the manual's quick start (the ```js quickstart block in the engine's header) runs as the manual hosts it: no\n//      errors, a hero that walks and jumps, gems to take\n//   3. every 3D kit, served as Vercel serves it (/kits/3d-<slice>, /3d), on WebGL 2 and on WebGPU (headless Chromium runs\n//      WebGPU on SwiftShader, through a stand-in canvas): no page errors, the title\n//      draws, each slice starts; each slice's proof run gives the same hash twice and on both backends (the game never\n//      reads the renderer); a minute of scripted play builds no GPU pipeline mid-game (the warm-up's job) and moves\n//      the hero; pictures in check-output/kit3d/ (read them)\n//   3b. shapes (world.shape: the 2D engine's entries in 3D): every core shape builds and draws on WebGL 2 and on WebGPU (its\n//      pixels change where it stands), a hero walking into a solid one stops and one dropped on a table lands on it; a\n//      sheet of every core shape in 3D beside its 2D picture (check-output/kit3d/shapes-<backend>.png: read it)\n//   3c. the camera's contracts (lock-on, camera zones, tank steering) and the door between rooms, on a page of their own:\n//      lock picks the one in sight nearest where the hero faces (never one behind a wall), cycle goes round to the next\n//      and keeps the lock when none other is in sight, the chase camera frames both and ground() strafes round the\n//      target, the lock lets go of a target that dies, leaves or goes out of range; a zone's cut waits until the target\n//      is margin units in (and not back on the border), the stick held across a cut keeps its way until it is let go;\n//      tank steering turns and walks along the facing; world.reach finds the door in front, world.unlock takes the key,\n//      world.through puts the actor beyond the door while nothing else moves; the same at 60, 90, 120 and 144 frames\n//   3d. vehicles, tracks, flight and split screen, on a page of their own, on WebGL 2 and on WebGPU: a kart takes to its\n//      top speed along the road, a boost pad boosts it, a wall stops it, the grass beside the road slows it, a hop held\n//      into a bend drifts and charges a boost, a hovercraft rides its cushion, a kart on a banked bend sits on the bank;\n//      E.Race (the drive module) races two AI vehicles a lap over the hump (in the air) to the finish; a flyer on rails\n//      keeps the rail's pace and moves within its window, a barrel roll ends, one in free flight turns back into its\n//      bounds, seek picks the one in its cone and in sight; all of it twice the same and the same on both backends; a\n//      split screen draws two views through world.cameras (check-output/kit3d/split-<backend>.png: read it), side by side\n//      and stacked (viewport 0 on top, as the 2D layout has it: split-rows-<backend>.png)\n//   3e. first person with the cel filter, on both backends: the filtered hall and the overlay's gun are both drawn\n//      (check-output/kit3d/fps-cel-<backend>.png)\n//   4. on an emulated phone held upright (390 x 844 at 3x, touch): every kit starts, the 3D picture lies exactly under the\n//      game's, the touch buttons are there\n// Usage: node tools/kit3d-test.mjs   (run node tools/build.mjs first; CHROMIUM_PATH picks a browser). Exit code 1 on failure.\nimport { chromium } from 'playwright';\nimport { createServer } from 'node:http';\nimport { readFileSync, existsSync, statSync, readdirSync, mkdirSync, writeFileSync } from 'node:fs';\nimport { execFileSync } from 'node:child_process';\nimport { resolve, join, extname } from 'node:path';\n\nconst root = resolve('.');\nconst problems = [], notes = [];\nconst fail = m => problems.push(m);\nconst read = f => readFileSync(join(root, f), 'utf8');\n\n/* 1. the rules */\ntry { execFileSync('node', ['tools/vendor-3d.mjs', '--check'], { cwd: root, stdio: 'pipe' }); } catch (e) { fail(String(e.stderr || e.message).trim()); }   // the vendored files\nconst BANNED = [\n  [/\\bWebGLRenderer\\b/, 'WebGLRenderer (use WebGPURenderer: it falls back to WebGL 2 by itself)'],\n  [/\\b(Raw)?ShaderMaterial\\b/, 'ShaderMaterial (write node materials or TSL)'],\n  [/\\bonBeforeCompile\\b/, 'onBeforeCompile (not run by WebGPURenderer)'],\n  [/\\bEffectComposer\\b|three\\/examples|three\\/addons/, 'addons and EffectComposer (not vendored; post-processing is TSL)'],\n  [/\\bcompute\\s*\\(|\\bStorageBufferAttribute\\b|\\bstorage\\s*\\(|\\bcomputeAsync\\b/, 'compute shaders or storage buffers (WebGPU only)'],\n  [/readRenderTargetPixels|readPixels\\s*\\(/, 'reading pixels back (nothing comes back from the GPU into gameplay)']\n];\nconst SLICES = readdirSync(join(root, 'src/starter3d')).filter(f => /^[1-8]\\d-.+\\.js$/.test(f)).map(f => f.replace(/^\\d+-|\\.js$/g, ''));\nconst SOURCES = ['engine/my-3d2dge-3d.js', 'src/starter3d.template.html', ...readdirSync(join(root, 'src/starter3d')).filter(f => f.endsWith('.js')).map(f => 'src/starter3d/' + f)];\nconst engine3d = read('engine/my-3d2dge-3d.js'), manual = engine3d.slice(0, engine3d.indexOf('*/'));\n\n===== STANDARD\n# Standard features: what every game gets, and the quality prompt they answer\n\nGames built on the engine used to start without the things players expect of a modern release: no full screen, no\nsettings, no way to rebind a key, a pause that ignored a hidden tab. The owner then had to send each builder a long\nquality prompt (\"Universal Game Controls, Display, Accessibility, and Quality Upgrade\", v2) and pay for the output tokens\nit took to write them, game by game. Since v0.23.0 the engine gives them to every game with no code (engine section 10b,\nand `E.Shell`'s standard menu), and the manuals say so up front: a few hundred input tokens instead of thousands of output\ntokens per game.\n\nThis file is that prompt's review: its requirement matrix (section 2 of the prompt), the action coverage of the presets,\nwhat stays each game's job, and how it was verified. How to use and adjust the features: `AI_GUIDE.md`, \"Standard\nfeatures\"; the API card's section of the same name; the full engine's header, point 8a.\n\n## What a game gets, and how it adjusts it\n\n| Feature | With no code | Adjust | Leave out |\n| --- | --- | --- | --- |\n| Pause menu (full engine) | a pausable scene pauses on Escape, P, Start, the touch START or the corner's menu button: Resume, Settings, Controls, Full screen, Help, Quit to title (asks first) | `menu: { items: [['Restart', fn]], quit: 'title' }` | `menu: false` (the canvas PAUSED overlay) |\n| Settings | `game.settings`: Display (full screen, camera zoom where a scene allows it, pixel scaling), Sound (sound, volume, music, effects, sound in the background), Comfort (reduce motion, shake, flashes), saved per game | `menu: { settings: [{ key, label, value, options, min, max }] }`, read `game.settings.key` | |\n| Controls | every action of the preset rebound by pressing the new key or button; the controller (dead zone, invert aim, button symbols, vibration); the touch buttons (visibility, side, size, opacity); restore defaults | `menu: { controls: { attack: 'Sword', debug: false } }` | |\n| Full screen | `game.fullscreen`; a phone's first tap; the corner's button; the menu; the player's choice kept | | `fullscreen: 'button'` (no tap) or `false` |\n| Pausing by itself | a pausable scene pauses when the page is hidden, the window loses focus or the controller in use is unplugged; only the player resumes (`game.pauseReason`) | `game.pause(reason)`, `game.resume()` | `autoPause: false` |\n| The corner | menu and full-screen buttons, top right in the safe area: on titles, pauses and game overs, when the mouse nears the top, and the menu on a touch screen without touch buttons | `game.menu('settings')` from a canvas title's OPTIONS | `corner: false` |\n| Prompts | `game.input.label(action)`: the key or button on the device in use, after rebinding, in the controller's own symbols | `settings.glyphs` | |\n| Boot (v0.24.0) | a page's splash from its first paint (the built pages have it); the game's heavy setup one step a frame behind a boot screen (the system's checks, a progress bar, the game's own lines), then a warm-up frame; any error before play becomes a report to screenshot | `game.start({ boot: { title, version, steps, messages, min } })`; `E.diagnose()` | `boot: false` |\n| Phones | a viewport reaching the safe areas, no page gestures on the canvas, touch buttons in the safe areas, a stick with a dead zone, a fixed resolution filling a high-density screen | `settings.scale` | |\n\nThe agent edition has `game.settings`, `game.fullscreen`, the corner, the pausing and `input.label`, not the menu screens\n(its corner's menu button pauses and resumes). Emberdeep and the labs with panels of their own keep theirs (`menu: false,\ncorner: false, fullscreen: 'button'`); Emberdeep's full screen now goes through `game.fullscreen`.\n\n## Requirement matrix\n\nStatus: **built in** (the engine does it for every game), **already met** (it did before v0.23.0), **the game's job** (only\nthe game knows it; the manuals say so), **deferred** (production hardening, principle 10: done when a game heads to\nproduction, which pays for it), **not applicable** (with the reason).\n\n| Prompt section | Requirement | Before (v0.22.4) | Now (v0.23.0) | Status | Verified by |\n| --- | --- | --- | --- | --- | --- |\n| 3 Display | Separate CSS size from the render buffer; a pixel-ratio limit; sharp UI text | low-res buffer, whole-number upscale, ratio capped at 3; HTML text | same | already met | existing suites |\n| 3 Display | Use the whole area without stretching | a fixed `res` letterboxed at a whole-number scale: up to a fifth of a phone's screen black | `scale`: Auto (fill on screens of 2x density and up), Sharp, Fill; since v0.26.0 `expand: true` makes `res` the least the screen shows and fills every shape with no bars (the starter kits use it) | built in | `standard-test` (fill at 3x, whole with Sharp, expand at five sh\n| 3 Display | Portrait and landscape both work | adaptive size and `portrait` options; a fixed `res` letterboxes | same, and a fixed `res` fills more; with `expand` it fills both ways (what fills the extra space is the game's job: since v0.27.0 the kits fill it edge to edge, the HUD over the world's corners, `AI_GUIDE.md`) | already met | phone emulation, both ways |\n| 3 Display | Safe areas | the Shell's panels and Emberdeep's HUD keep out of them | the corner and the touch buttons too; the viewport reaches them (`viewport-fit=cover`) | built in; a canvas HUD under a notch is the game's job | `standard-test` (viewport) |\n| 3 Display | After a resize or rotation: rebase drags, recalculate input | canvas and mouse mapping recalculated | the touch stick is lifted on a resize, input cleared on a full-screen change | built in | code review; phone emulation |\n| 3 Display | Folds and hinges | none | none | deferred | |\n| 3 Display | The on-screen keyboard | no text fields | no text fields | not applicable | |\n| 4 Full screen | A clear control, from a player action, of the whole page (game, HUD, menus) | Emberdeep only | `game.fullscreen` on `document.documentElement`; a phone's first tap, the corner, the menu | built in | `standard-test`; phone screenshots |\n| 4 Full screen | Handle refusals and changes; never force it back after the player leaves | Emberdeep only | a refusal noted on screen and kept in `failed`; the player's choice saved on every change, and a phone's tap honors it. Since v0.27.0 the choice is what the player turns off (the corner's button, the menu); leaving by a back gesture or Escape is not one: a game started by a tap goes full screen again (D24) | \n| 4 Full screen | Explain what a platform can't do | Emberdeep's README note | the settings row: \"On an iPhone: Share, then Add to Home Screen\"; the home-screen app tags added to the page | built in | code review (no iPhone here) |\n| 4 Full screen | Pointer lock, orientation lock, wake lock | none | none: the engine's cameras need no pointer lock, both orientations work, wake lock is not asked for | not applicable (pointer, orientation); deferred (wake lock) | |\n| 4 Full screen | No page gestures on the game, menus still scroll, pinch zoom not disabled | `touch-action: none` in the pages' own CSS | set on every game's canvas by the engine; the menu is a separate layer that scrolls; the viewport leaves zoom alone | built in | `standard-test` |\n| 4 Full screen | A PWA manifest, offline play, updates at a safe point | none | none | deferred: the site is the review surface, not a store release | |\n| 5 Input | Named actions, several sources, pressed / held / released, buffering, clearing on focus loss | yes | same; menus hold the game's input back; the touch START is the gamepad's Start (since v0.27.0 the corner's menu button, top right, there in play on a touch screen) | already met, extended | contract and standard suites |\n| 5 Input | Radial dead zones; no drift; no duplicate events | the gamepad's sticks | the touch stick too (12%); prompts follow the last device used | built in | code review |\n| 6 Keyboard and mouse | Remap gameplay actions and mouse buttons; conflicts shown before applying; recovery from a lost essential | Emberdeep only | `input.rebind` and the Controls screen; menu keys reserved; restore defaults | built in | `standard-test` (rebind, conflict, reserved, cancel, saved) |\n| 6 Keyboard and mouse | Labels true to the keyboard layout | QWERTY codes | the browser's layout map where it gives one (an AZERTY Z), the code's position elsewhere | built in | code review (Chromium only) |\n| 6 Gamepads | Sticks, buttons, triggers, d-pad; menus without a mouse | yes (standard mapping) | same; the menu by d-pad and stick | already met | contract (focus by input) |\n| 6 Gamepads | Dead zone, inversion, remapping, restore defaults | dead zone and inversion as fields | settings on the Controls screen | built in | `standard-test` |\n| 6 Gamepads | Symbols by family, a manual choice, a positional fallback | Emberdeep's labels | Xbox, PlayStation, Nintendo from the controller's name, or chosen; \"Positions\" | built in | `standard-test` |\n| 6 Gamepads | Disconnects: clear its input, pause, a message, keep playing on another device | input released | a pausable scene pauses with \"Controller disconnected\" | built in | `standard-test` |\n| 6 Gamepads | Vibration where there is an actuator, an off and a strength setting, stopped on pause | none | `input.rumble`, `hitFx` rumbles, the Vibration slider, stopped on pause, focus loss and unplugging | built in | code review (no controller here) |\n| 6 Gamepads | Non-standard mappings, analog trigger values, adaptive triggers | standard mapping assumed | same | deferred | |\n| 7 Touch | A floating stick from the first contact, neutral on release, ownership per finger | yes | a dead zone; side, size, opacity and visibility from settings; a laptop's touch screen shows the buttons once touched; since v0.26.0 the stick past halfway presses the directions (menus, dialog choices, ladders) and a bottom dialog keeps clear of the buttons (`input.touchArea()`); since v0.26.1 a tap or click on an `\n| 7 Touch | Camera and aim by touch, pinch zoom | Emberdeep's own | since v0.32.0 the player's zoom: a two-finger pinch (both fingers moving: not the stick), the wheel, - and =, Settings, Camera zoom, within a scene's `camera.zoom`, kept on top of the zoom the scene starts at | built in (zoom, where a scene allows it); aim the game's job (the engine has no free camera) | `phone-test` (zoom) |\n| 8 Context actions | Stable positions; hidden controls get no input; tap and hold | the touch buttons don't move | same; hidden corner buttons are `display: none`; since v0.27.0 `input.touchSet(a, label, show)` relabels a button or hides it while it has nothing to do (a hidden one lets go and leaves `touchArea()`), as the adventure's TALK and the stealth's TAKE DOWN and PARRY do | built in; which action fits the mom\n| 9 Camera comfort | Shake, flashes, motion | reduce motion (from the system) | settings for each, applied to `game.shake` and `game.flash` | built in | `standard-test` |\n| 10 Assistance | Aim assist, auto-fire, input buffering, hold or toggle | `buffered` | a place for them (`menu.settings`); since v0.27.0 the shooter kit fires by itself on a touch screen and the RPG kit takes taps on its commands and foes | the game's job | phone screenshots |\n| 11 Menus and accessibility | Full menu use by touch, mouse, keys, gamepad; focus shown, set on open, restored on close, scrolled into view | the Shell's pause and settings | the same for every game, with focus restored on the way back; since v0.27.0 every screen has a close button at the top right (where the menu button was), one over another a back arrow at the top left, and a sideways swipe goes back a screen | b\n| 11 Menus and accessibility | The back gesture never strands the player | none: a phone's back left the page | since v0.27.0 an entry of the game's own in the page's history, added on a tap while there is somewhere to go back to: back closes the menu screen, pauses play into the menu, or takes a scene's own `back()` (`game.back()`), and only then leaves; `overscroll-behavior: none` stops pull to refresh and the side\n| 11 Menus and accessibility | Names and states; 44-pixel targets; 200% text; contrast; not color alone | roles on switches and dialogs | `role=switch`, `aria-checked`, a live status line on the Controls screen, 44-pixel buttons; the theme's ink on paper is high contrast | built in for menus; gameplay is the game's job | code review; no screen-reader run |\n| 11 Menus and accessibility | Subtitles and captions | `Dialog` shows speech as text | same | the game's job | |\n| 12 Settings | Display, interface, keyboard, gamepad, touch, camera, audio and gameplay groups | the Shell's sound, volume and motion | every group the engine can make work (see the table above); frame-rate limit, brightness, text size and HUD scale are not offered because nothing would honor them yet | built in where it can take effect | |\n| 12 Settings | Versioned, validated, blocked storage, migration, restore defaults per group | none | `{ v: 2, values }` under `settings:<path>` (v0.27.0: version 2, D24); each value checked on load; a broken save loads as defaults; blocked storage plays on (`saved: false`); the Shell's older saves carried over; `reset(group)` | built in | `standard-test` |\n| 13 Saving | Atomic, versioned saves, checkpoints, confirm before loss | `E.store` | same; Quit to title asks first | the game's job | |\n| 13 Pause | Pause reasons kept apart; focus never resumes; explicit resume | Emberdeep only | `pauseReason`; focus loss and unplugging pause, nothing resumes by itself | built in | `standard-test` |\n| 13 Recovery | Clear recovery for failed loads; real progress when it can be measured, an honest indicator when not | the red box, for developers | the boot screen: each step and a bar (measured by steps), a moving bar while the page loads; a failure before play shows what failed, the error, a code and the system, with Try again, Copy report and Continue | built in (v0.24.0) | `standard-test` (the screen, the report\n| 13 Pause | Long suspensions: no backlog | the clock takes at most 50 ms a frame | same | already met | contract (the clock) |\n| 13 Pause | Restart and reload without leaks | `dispose()` removes every listener | the corner and menus too | already met | contract (dispose) |\n| 14 Audio | Starts after a gesture; volumes per channel; settings before the first sound | yes; the Shell's volume | master, music, effects and mute saved and applied when the game is made | built in | `standard-test` |\n| 14 Audio | The background | music kept playing, choppy, in a hidden tab | the sound sleeps while the page is hidden unless \"Sound in the background\" is on | built in | code review |\n| 15 Performance | No cost when unused | | the menu is built only when it opens; the corner compares one number a frame | built in | the full suite's timings |\n| 16 First use | Instructions for the active input; settings before demanding play | | `input.label`; the corner's menu on a title opens the settings | built in; tutorials are the game's job | `standard-test` |\n| 17 Verification | Evidence a player can send: environment, build, reproduction | sessions (`E.session`) for developers | the failure report and `E.diagnose()`: engine and game versions, build, browser, device, screen, canvas, GPU, sound, storage, input, scene | built in (v0.24.0) | `standard-test` |\n| 17 Verification | Physical devices, browsers, controllers | | headless Chromium on Linux, phones emulated (390 x 844 and 844 x 390 at 3x) | deferred: no physical phone, iPhone or controller was used | |\n\n## Action coverage (the presets)\n\nWhat each action answers to in every preset, before the player rebinds. Touch: the move stick is the screen's free side\n(the left, or the right for a left-handed player); a scene's `touch: [...]` lists the buttons it needs; START is the\nmenu. Gamepad buttons are named by position, with the Xbox symbol (`input.label` shows the family's own).\n\n| Action | Keyboard and mouse | Gamepad | Touch | Presets |\n| --- | --- | --- | --- | --- |\n| up / down / left / right | WASD, arrows | left stick (past halfway), d-pad | the stick (past halfway it presses these too) | all |\n| start | Enter | Start | START | all (menus) |\n| pause | Escape, P | Start | START, the corner's menu | all (pausable scenes) |\n| confirm | Enter, Space, J, Z | A (south) | a tap on a menu | all (menus) |\n| cancel | Escape, Backspace, X, K | B (east) | the menu's Back | all (menus) |\n| attack | J, X, left click | A, RT (DEFAULT); X (PLATFORMER, THIRDPERSON) | a scene's button | DEFAULT, PLATFORMER, THIRDPERSON |\n| dash | Space, Shift, K (DEFAULT); Shift, C, L (PLATFORMER) | B, LT (DEFAULT); B, RB (PLATFORMER) | a scene's button | DEFAULT, PLATFORMER |\n| skill | L, E, right click (DEFAULT); E, V, right click | X, RB (DEFAULT); Y | a scene's button | DEFAULT, PLATFORMER |\n| jump | Z (DEFAULT); Space, Z, K | Y (DEFAULT); A | a scene's button | DEFAULT, PLATFORMER, THIRDPERSON (Space) |\n| sprint, crouch, interact, block, dodge, use, map | Shift; C, Ctrl; E, F; K, right click; L; Q; M, Tab | RT, L3; B; Y; LB; RB; LT; View | a scene's buttons | THIRDPERSON |\n| fire, bomb | Space, Z, J, click (hold); X, K, right click | A, RT; B, LT | a scene's buttons | SHMUP |\n| menu (the engine's) | the corner's button | | START, the corner's button | every game |\n| full screen (the engine's) | the corner's button, the menu (F11 is the browser's own) | the menu | a phone's first tap, the corner, the menu | every game |\n\nCommon actions never need a stick click or a two-button chord. On a touch screen without the engine's touch buttons, the\ncorner's menu button stays in reach while playing.\n\n## What stays the game's job\n\nThe manuals list these where a builder reads them (`AI_GUIDE.md`, Standard features; the API card): every gameplay scene\n`pausable: true`; prompts from `input.label`; touch buttons for every action a level needs; the assists its mechanics\ncall for, as settings; its own saves, versioned, written at checkpoints, confirmed before a loss; a canvas HUD clear of a\nphone's notch; nothing told by color alone.\n\n## Verification (v0.23.0)\n\n| Case | Environment | Evidence | Result |\n| --- | --- | --- | --- |\n| Settings, pausing, labels, rebinding, the touch START, boot steps and their failures (both editions) | Node 24 | automated (`tools/standard-test.mjs`) | pass |\n| The boot screen, the report, an error before and after play, `boot: false` (both editions); Emberdeep's first paint on a slowed CPU (0.16 s, was 1.6 s) | headless Chromium (4x CPU slowdown for the timing) | automated (`tools/standard-test.mjs`, 94 checks in all); screenshots | pass |\n| The page, the corner, the pause menu, Settings, Controls, rebinding, Quit, saved settings, bad and blocked storage, full screen, touch buttons, a game's own Shell, `menu: false` (both editions) | headless Chromium, desk and emulated phones | automated (`tools/standard-test.mjs`) | pass |\n| The menus by eye: title, play, pause, settings, controls, rebound | Chromium at 1280 x 720; emulated phone 390 x 844 and 844 x 390 at 3x | screenshots | pass |\n| The rest of the engine, Emberdeep and the labs | headless Chromium | `npm run test:changed` (all 20 suites) | pass |\n| A physical phone, an iPhone, a physical gamepad (rumble, symbols), a screen reader, a fold | none here | none | not tested |","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01NhpgHuXD73Mo7hU64cxFnh","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
