append('console:'+m.text[:500]) if m.type=='error' else None)\n    pg.goto(url+'#shooter')\n    pg.wait_for_function('window.__game && window.__game.game && window.__game.game.scene', timeout=300000)\n    pg.wait_for_timeout(1500)\n    print(pg.evaluate(\"\"\"() => { const P=__proto; P.fireInit(); return [P.initBurn(), P.initFlames(), P.initDay(), P.initMap(), P.initWater()]; }\"\"\"))\n    print(pg.evaluate(\"\"\"() => { const P=__proto, s=__game.scenes.shooter, h=s.hero, S=s.state, M=16, w=s.world;\n       const x0=h.x+230*M, y0=h.y+10*M; h.place(x0,y0,w.ground(x0,y0)+4); S.yaw=0; S.pitch=-.03; P.spot=[x0,y0];\n       const old=w.onDraw; w.onDraw=(wo,r)=>{ old&&old(wo,r); const c=wo.camera.pose||wo.camera.fixed; P.nFlames=P.fireDraw(wo,c); if(P.water) P.water.uT.value=wo.time; };\n       P.ignite(x0+60*M, y0-4*M, 8*M); P.ignite(x0+70*M, y0+40*M, 6*M); P.ignite(x0+90*M, y0-50*M, 6*M); return {x0,y0,g:w.ground(x0,y0)}; }\"\"\"))\n    pg.wait_for_timeout(4000)\n    n = pg.evaluate(\"() => { const P=__proto; let n=0; for(let i=0;i<40*4;i++) n=P.fireStep(.25); return n; }\")\n    print('burning cells after 40 s', n)\n    for hour,name in [(12,'noon'),(18.2,'dusk'),(23,'night')]:\n        pg.evaluate('(h)=>__proto.setHour(h)', hour); pg.wait_for_timeout(3500)\n        pg.screenshot(path=f'out/fire2-{name}.png'); print(name,' flames', pg.evaluate('()=>__proto.nFlames'))\n    # the soldier close up, by day\n    pg.evaluate(\"\"\"() => { const P=__proto, s=__game.scenes.shooter, h=s.hero, M=16, w=s.world; const d=s.raiders.find(e=>e.dummy); h.place(d.a.x, d.a.y+40, w.ground(d.a.x,d.a.y+40)+2); s.state.yaw=-Math.PI/2; s.state.pitch=-.02; P.setHour(10); P.fire.burning.length=0; return true; }\"\"\")\n    pg.wait_for_timeout(3500); pg.screenshot(path='out/soldier.png')\n    # the flood: water up to a metre under the eye at the same spot's plain\n    pg.evaluate(\"\"\"() => { const P=__proto, s=__game.scenes.shooter, h=s.hero, M=16, w=s.world; const [x0,y0]=P.spot; h.place(x0-40*M,y0,w.ground(x0-40*M,y0)+2); s.state.yaw=0; P.water.mesh.position.y=(w.ground(x0-40*M,y0)+10)/M; P.setHour(7); }\"\"\")\n    pg.wait_for_timeout(3500); pg.screenshot(path='out/flood.png')\n    print('errors', errs[:12])\n    b.close()\n'''\nopen('run7.py','w').write(r)\nEOF\nnode build4.mjs && python3 run7.py","description":"Tune flames, smoke, night light and test a flood plane","timeout":560000}},"wire_ingest_context":{"toolu_011tRhYFSaogtPt5iF3mpjmh":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211923__xa49253/work/.research/exp"}}}
