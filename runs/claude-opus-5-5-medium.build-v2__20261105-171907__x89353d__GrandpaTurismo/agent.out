.3, 1.5, 0.1], at: [x, y, -p.d / 2 - 0.03], c: win, glow: true, collide: false }); }\n    return parts; } }),\n  model({ id: 'crane', about: 'A dockside crane', tags: ['city'], palette: { steel: 'orange', dark: 'ink', lamp: 'red' }, collider: 'none', parts: [mir([{ box: [1, 22, 1], at: [5, 11, 0], c: 'steel' }]), { box: [12, 1, 1], at: [0, 20, 0], c: 'steel' }, { box: [1.6, 1.6, 44], at: [0, 25, 10], c: 'steel' }, { box: [5, 4, 5], at: [0, 22.5, -5], c: 'dark' }, { box: [0.3, 9, 0.3], at: [0, 20, 26], c: 'dark' }, { box: [5, 1, 3], at: [0, 15, 26], c: 'steel' }, { box: [0.5, 0.5, 0.5], at: [0, 26.2, 32], c: 'lamp', glow: true }] }),\n  model({ id: 'containers', about: 'Stacked shipping containers', tags: ['city'], palette: { a: 'red', b: 'blue', c: 'lime', d: 'orange' }, collider: 'none', parts: [{ box: [12, 2.6, 2.6], at: [0, 1.3, 0], c: 'a' }, { box: [12, 2.6, 2.6], at: [0, 1.3, 2.9], c: 'b' }, { box: [12, 2.6, 2.6], at: [0, 1.3, -2.9], c: 'd' }, { box: [12, 2.6, 2.6], at: [0, 3.9, 0], c: 'c' }, { box: [12, 2.6, 2.6], at: [0, 3.9, 2.9], c: 'a' }, { box: [12, 2.6, 2.6], at: [0.5, 6.5, 0.2], c: 'b' }] }),\n  model({ id: 'wheel-frame', about: 'The legs of a Ferris wheel', tags: ['city'], palette: { steel: 'mist' }, collider: 'none', parts: [mir([{ box: [1, 34, 1], at: [7, 16.5, 2], rot: [0, 0, 12], c: 'steel' }, { box: [1, 34, 1], at: [7, 16.5, -2], rot: [0, 0, 12], c: 'steel' }])] }),\n  model({ id: 'wheel-ring', about: 'A Ferris wheel ring with lit cabins', tags: ['city'], floats: true, palette: { steel: 'mist', a: 'red', b: 'sand', c: 'cyan', d: 'lime' }, collider: 'none', parts: [\n    { torus: [36, 1, 36], at: [0, 0, 0], rot: [90, 0, 0], c: 'steel', seg: 24 }, ...Array.from({ length: 6 }, (_, i) => ({ box: [36, 0.5, 0.5], at: [0, 0, 0], rot: [0, 0, i * 30], c: 'steel' })),\n    ...Array.from({ length: 12 }, (_, i) => ({ box: [2.4, 2.4, 2.4], at: [Math.cos((i * Math.PI) / 6) * 18, Math.sin((i * Math.PI) / 6) * 18, 0], c: ['a', 'b', 'c', 'd'][i % 4], glow: true })) ] }),\n  model({ id: 'flag-tower', about: 'A tall flag tower', tags: ['landmark'], palette: { steel: 'white', cap: 'red' }, collider: 'none', parts: [{ box: [3, 34, 3], at: [0, 17, 0], c: 'steel' }, { box: [6, 3, 6], at: [0, 35, 0], c: 'cap' }, { box: [0.4, 10, 0.4], at: [0, 41, 0], c: 'steel' }] }),\n  model({ id: 'blimp', about: 'A blimp with a small gondola', tags: ['landmark'], floats: true, palette: { hull: 'sand', band: 'red', dark: 'ink', word: 'white' }, collider: 'none', parts: [{ ball: [10, 10, 32], at: [0, 0, 0], c: 'hull', seg: 10 }, { box: [10.2, 2, 8], at: [0, 0, 0], c: 'band' }, { box: [2.4, 2, 6], at: [0, -5.6, 2], c: 'dark' }, { box: [0.5, 7, 5], at: [0, 2.5, -14], c: 'band' }, { box: [7, 0.5, 5], at: [0, 0, -14], c: 'band' }] }),\n  model({ id: 'mesa', about: 'A flat-topped desert mesa', tags: ['landmark'], palette: { rock: 'orange', top: 'plum' }, collider: 'none', params: { h: [70, 30, 140] }, parts: (p) => [{ cyl: [180, p.h, 150], top: 0.72, at: [0, p.h / 2, 0], c: 'rock', seg: 7 }, { cyl: [132, 4, 110], at: [0, p.h + 1.5, 0], c: 'top', seg: 7 }] }),\n  model({ id: 'water-tower', about: 'A rusted water tower', tags: ['landmark'], palette: { rust: 'red', steel: 'plum' }, collider: 'none', parts: [{ mirror: [{ mirror: [{ box: [0.5, 12, 0.5], at: [2.4, 6, 2.4], c: 'steel' }], axis: 'z' }], axis: 'x' }, { cyl: [7, 5, 7], at: [0, 14, 0], c: 'rust', seg: 8 }, { cone: [7.6, 2.2, 7.6], at: [0, 17.6, 0], c: 'steel', seg: 8 }] }),\n  model({ id: 'wood-stand', about: 'Wooden spectator stands', tags: ['track'], palette: { wood: 'orange', seat: 'sand' }, collider: 'none', parts: [{ box: [14, 0.5, 1.6], at: [0, 0.8, 2], c: 'seat' }, { box: [14, 0.5, 1.6], at: [0, 1.8, 0.4], c: 'seat' }, { box: [14, 0.5, 1.6], at: [0, 2.8, -1.2], c: 'seat' }, ...[-6, 0, 6].map((x) => ({ box: [0.4, 3, 5], at: [x, 1.5, 0.4], c: 'wood' }))] }),\n  model({ id: 'warn-board', about: 'A warning arrow board', tags: ['track'], palette: { face: 'sand', mark: 'ink', post: 'orange' }, collider: 'none', parts: [{ box: [0.2, 1.4, 0.2], at: [-1, 0.7, 0], c: 'post' }, { box: [0.2, 1.4, 0.2], at: [1, 0.7, 0], c: 'post' }, { box: [2.6, 1.2, 0.14], at: [0, 1.8, 0], c: 'face' }, { box: [1.5, 0.3, 0.16], at: [0, 1.8, 0], rot: [0, 0, 25], c: 'mark' }] }),\n  model({ id: 'control-tower', about: 'The airfield control tower: the Licence Centre', tags: ['building'], palette: { wall: 'white', glass: 'cyan', roof: 'navy', band: 'orange' }, collider: 'none', parts: [{ box: [7, 16, 7], at: [0, 8, 0], c: 'wall' }, { box: [7.2, 0.6, 7.2], at: [0, 10, 0], c: 'band' }, { box: [10, 3.4, 10], at: [0, 17.7, 0], c: 'glass' }, { box: [11, 0.5, 11], at: [0, 19.6, 0], c: 'roof' }, { box: [0.3, 4, 0.3], at: [0, 22, 0], c: 'wall' }] }),\n  model({ id: 'hangar', about: 'A big round-roofed hangar', tags: ['building'], palette: { wall: 'mist', door: 'slate', roof: 'night' }, collider: 'none', parts: [{ box: [34, 10, 26], at: [0, 5, 0], c: 'wall' }, { cyl: [34, 26, 9], at: [0, 10, 0], rot: [90, 0, 0], c: 'roof', seg: 10 }, { box: [26, 9, 0.3], at: [0, 4.5, 13.05], c: 'door' }] }),\n  model({ id: 'van', about: \"The examiner's van\", tags: ['vehicle'], palette: { body: 'white', glass: 'navy', stripe: 'orange', tyre: 'ink' }, collider: 'none', parts: [{ box: [2, 2, 4.8], at: [0, 1.4, 0], c: 'body' }, { box: [1.8, 0.7, 1], at: [0, 1.9, 2.0], c: 'glass' }, { box: [2.04, 0.3, 4.84], at: [0, 1.0, 0], c: 'stripe' }, mir([{ cyl: [0.5, 0.6, 0.6], at: [0.9, 0.32, 1.6], rot: [0, 0, 90], c: 'tyre' }, { cyl: [0.5, 0.6, 0.6], at: [0.9, 0.32, -1.6], rot: [0, 0, 90], c: 'tyre' }])] }),\n  model({ id: 'showroom', about: 'A glass-fronted showroom', tags: ['diorama'], palette: { wall: 'white', glass: 'cyan', roof: 'navy' }, collider: 'none', parts: [{ box: [8, 3, 5], at: [0, 1.5, 0], c: 'glass' }, { box: [8.4, 0.5, 5.4], at: [0, 3.25, 0], c: 'roof' }, mir([{ box: [0.4, 3, 0.4], at: [3.9, 1.5, 2.4], c: 'wall' }])] }),\n  model({ id: 'garage-tall', about: 'A corrugated tuning garage', tags: ['diorama'], palette: { wall: 'slate', door: 'ink', band: 'orange' }, collider: 'none', parts: [{ box: [9, 5, 6], at: [0, 2.5, 0], c: 'wall' }, { box: [6.4, 3.6, 0.2], at: [0, 1.8, 3.05], c: 'door' }, { box: [9.2, 0.5, 6.2], at: [0, 5.2, 0], c: 'band' }] }),\n  model({ id: 'home-house', about: 'A small house with a roll-up door', tags: ['diorama'], palette: { wall: 'sand', roof: 'red', door: 'mist', win: 'sky' }, collider: 'none', parts: [{ box: [8, 3.6, 6], at: [0, 1.8, 0], c: 'wall' }, { wedge: [8.4, 2.2, 3.2], at: [0, 4.7, 1.6], c: 'roof' }, { wedge: [8.4, 2.2, 3.2], at: [0, 4.7, -1.6], rot: [0, 180, 0], c: 'roof' }, { box: [4, 2.6, 0.2], at: [-1.4, 1.3, 3.05], c: 'door' }, { box: [1.6, 1.3, 0.2], at: [2.5, 2, 3.05], c: 'win' }] }),\n  model({ id: 'museum', about: 'A small museum with columns', tags: ['diorama'], palette: { stone: 'white', roof: 'mist', dark: 'slate' }, collider: 'none', parts: [{ box: [9, 0.6, 6], at: [0, 0.3, 0], c: 'dark' }, { box: [8, 3.4, 4], at: [0, 2.3, -0.6], c: 'dark' }, ...[-3.4, -1.7, 0, 1.7, 3.4].map((x) => ({ cyl: [0.7, 3.2, 0.7], at: [x, 2.2, 2.2], c: 'stone' })), { box: [9, 0.6, 6], at: [0, 4.1, 0], c: 'stone' }, { wedge: [9.2, 1.2, 6], at: [0, 5, 0], rot: [0, 90, 0], c: 'roof' }] }),\n  model({ id: 'marquee', about: 'A theatre with a marquee of lights', tags: ['diorama'], palette: { wall: 'plum', sign: 'sand', roof: 'ink', red: 'red' }, collider: 'none', parts: [{ box: [8, 5, 6], at: [0, 2.5, 0], c: 'wall' }, { box: [8.6, 1.4, 3], at: [0, 3.5, 3.6], c: 'red' }, ...Array.from({ length: 8 }, (_, i) => ({ box: [0.5, 0.4, 0.16], at: [-3.5 + i, 3.5, 5.15], c: 'sign', glow: true })), { box: [8.4, 0.4, 6.4], at: [0, 5.2, 0], c: 'roof' }] }),\n  model({ id: 'arch', about: 'A neon arch: the Arcade Gate', tags: ['diorama'], palette: { steel: 'ink', neon: 'cyan', neon2: 'red' }, collider: 'none', parts: [mir([{ box: [0.8, 5.4, 0.8], at: [3.4, 2.7, 0], c: 'steel' }, { box: [0.2, 5, 0.9], at: [3, 2.7, 0], c: 'neon', glow: true }]), { box: [7.6, 1.4, 0.8], at: [0, 6, 0], c: 'steel' }, { box: [7.2, 0.3, 0.9], at: [0, 6.3, 0], c: 'neon2', glow: true }, { box: [7.2, 0.3, 0.9], at: [0, 5.7, 0], c: 'neon', glow: true }] }),\n  model({ id: 'lift', about: 'A two-post car lift with tool chests', tags: ['set'], palette: { steel: 'slate', red: 'red', top: 'mist', dark: 'ink' }, collider: 'none', parts: [mir([{ box: [0.4, 3.4, 0.4], at: [1.6, 1.7, 0.2], c: 'steel' }, { box: [1, 0.08, 0.3], at: [1.2, 0.5, 0.2], c: 'red' }]), { box: [3.6, 0.3, 0.4], at: [0, 3.5, 0.2], c: 'steel' }, { box: [1.4, 1.1, 0.6], at: [4, 0.55, -2], c: 'red' }, { box: [1.4, 0.1, 0.6], at: [4, 1.15, -2], c: 'top' }, { box: [1.2, 0.8, 0.5], at: [-4, 0.4, -2], c: 'dark' }] }),\n  model({ id: 'rollers', about: 'Dyno rollers set into the floor', tags: ['set'], palette: { steel: 'mist', dark: 'ink' }, collider: 'none', parts: [{ box: [2.6, 0.08, 1.1], at: [0, 0.04, 0], c: 'dark' }, { cyl: [0.34, 2.5, 0.34], at: [0, 0.12, 0.22], rot: [0, 0, 90], c: 'steel' }, { cyl: [0.34, 2.5, 0.34], at: [0, 0.12, -0.22], rot: [0, 0, 90], c: 'steel' }] }),\n  model({ id: 'brush', about: 'A tall car-wash brush', tags: ['set'], palette: { bristle: 'blue', cap: 'white', post: 'slate' }, floats: true, collider: 'none', parts: [{ cyl: [1, 2.4, 1], at: [0, 1.2, 0], c: 'bristle', seg: 8 }, { cyl: [0.5, 0.2, 0.5], at: [0, 2.5, 0], c: 'cap' }, { box: [0.14, 0.5, 0.14], at: [0, 2.8, 0], c: 'post' }] }),\n  model({ id: 'podium', about: 'A three-step winners podium', tags: ['set'], palette: { a: 'sand', b: 'mist', c: 'orange', base: 'navy' }, collider: 'none', parts: [{ box: [2, 1.2, 2], at: [0, 0.6, 0], c: 'a' }, { box: [2, 0.8, 2], at: [-2, 0.4, 0], c: 'b' }, { box: [2, 0.5, 2], at: [2, 0.25, 0], c: 'c' }] }),\n  model({ id: 'cup', about: 'A trophy cup', tags: ['trophy'], palette: { gold: 'sand', base: 'ink' }, collider: 'none', parts: [{ box: [0.26, 0.08, 0.26], at: [0, 0.04, 0], c: 'base' }, { cyl: [0.08, 0.14, 0.08], at: [0, 0.14, 0], c: 'gold' }, { cyl: [0.26, 0.26, 0.26], top: 1.25, at: [0, 0.34, 0], c: 'gold' }, mir([{ box: [0.08, 0.14, 0.06], at: [0.2, 0.36, 0], c: 'gold' }])] }),\n  model({ id: 'helmet', about: 'A gold racing helmet', tags: ['trophy'], palette: { gold: 'sand', visor: 'ink' }, collider: 'none', parts: [{ ball: [0.32, 0.32, 0.34], at: [0, 0.17, 0], c: 'gold' }, { box: [0.28, 0.08, 0.06], at: [0, 0.18, 0.16], c: 'visor' }] }),\n  model({ id: 'car-cover', about: 'A dust sheet over a car, for the prize reveal', tags: ['set'], palette: { cloth: 'mist', cloth2: 'white' }, collider: 'none', parts: [{ box: [2.2, 1, 5], at: [0, 0.6, 0], c: 'cloth' }, { box: [1.7, 0.5, 2.6], at: [0, 1.3, -0.2], c: 'cloth2' }] }),\n  model({ id: 'jack', about: 'A trolley jack', tags: ['set'], palette: { red: 'red', dark: 'ink' }, collider: 'none', parts: [{ box: [0.3, 0.14, 0.8], at: [0, 0.07, 0], c: 'red' }, { box: [0.1, 0.1, 0.7], at: [0, 0.3, -0.5], rot: [30, 0, 0], c: 'dark' }] }),\n  model({ id: 'flag-pole', about: 'A slim flag pole', tags: ['track'], palette: { p: 'mist' }, collider: 'none', parts: [{ box: [0.12, 6, 0.12], at: [0, 3, 0], c: 'p' }] }),\n  model({ id: 'neon-kobo', about: 'A neon sign: KOBO', tags: ['city'], palette: { glow: 'red', back: 'ink' }, collider: 'none', floats: true, parts: [{ box: [6, 2.6, 0.2], at: [0, 1.3, -0.1], c: 'back' }, ...wordParts('KOBO', 0.34, [0, 0.46, 0.05])] }),\n  model({ id: 'neon-umami', about: 'A neon sign: UMAMI', tags: ['city'], palette: { glow: 'cyan', back: 'ink' }, collider: 'none', floats: true, parts: [{ box: [7, 2.6, 0.2], at: [0, 1.3, -0.1], c: 'back' }, ...wordParts('UMAMI', 0.32, [0, 0.46, 0.05])] }),\n  model({ id: 'neon-hotel', about: 'A neon sign: HOTEL MIZU', tags: ['city'], palette: { glow: 'sand', back: 'ink' }, collider: 'none', floats: true, parts: [{ box: [13, 2.4, 0.2], at: [0, 1.2, -0.1], c: 'back' }, ...wordParts('HOTEL MIZU', 0.3, [0, 0.46, 0.05])] }),\n  model({ id: 'neon-zipp', about: 'A neon sign: ZIPP TYRES', tags: ['city'], palette: { glow: 'lime', back: 'ink' }, collider: 'none', floats: true, parts: [{ box: [13, 2.4, 0.2], at: [0, 1.2, -0.1], c: 'back' }, ...wordParts('ZIPP TYRES', 0.3, [0, 0.46, 0.05])] }),\n];\nexport const PROP_DEFS = defs;\nexport const CATALOG = new ModelCatalog([...MODEL_LIBRARY.all(), ...defs]);\nE\ncat > src/game/render/dressing.js <<'E'\n// Each track's look and landmarks, built from primitives and the library. Returns things that move.\nimport { buildModel, mergeStaticMeshes, THREE, toonMaterial, PALETTE, WaterSurface, WAVES_CALM, Boids, clothGrid, SoftMesh, Precipitation } from '../../pixel-engine.js';\nimport { CATALOG } from '../models/props.js';\nimport { pointAt, groundHeight } from './trackmesh.js';\nimport { PIT_WIDTH } from '../sim/race.js';\nconst { Group, Mesh, BoxGeometry, Vector3 } = THREE;\nconst P = PALETTE;\nfunction makeRand(seed) { let a = seed >>> 0; return () => { a = (a + 0x6d2b79f5) >>> 0; let t = a; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }\nexport class Dresser {\n  constructor(ctx, T, hub = false) { this.ctx = ctx; this.T = T; this.tr = T.tr; this.statics = []; this.dyn = []; this.rand = makeRand(T.id.length * 977 + 13); this.hub = hub; this.crowds = []; this.stands = []; }\n  model(id, x, y, z, yaw = 0, o = {}) { const b = buildModel(id, { catalog: CATALOG, ...o }); const m = b.object; m.position.set(x, y, z); m.rotation.y = yaw; m.updateMatrixWorld(true); return m; }\n  put(id, x, y, z, yaw = 0, o = {}) { const m = this.model(id, x, y, z, yaw, o); this.statics.push(m); return m; }\n  /** Place by track position: t > 0 on the driver's right, turned to face the road. */\n  side(id, s, t, o = {}) {\n    const tr = this.tr, q = pointAt(tr, s, t), side = Math.sign(t) || 1, d = Math.abs(t) - tr.width[q.i] / 2, y = o.y ?? groundHeight(this.T, this.T.id, q.i, side, Math.max(0, d)) + (o.lift ?? 0);\n    const yaw = q.yaw + (side > 0 ? -Math.PI / 2 : Math.PI / 2) + (o.turn ?? 0);\n    return this.put(id, q.x, y, q.z, yaw, o.build ?? {});\n  }\n  scatter(id, n, tMin, tMax, o = {}) {\n    const tr = this.tr, grid = this.T.grid; let placed = 0;\n    for (let k = 0; k < n * 3 && placed < n; k++) {\n      const s = this.rand() * tr.length, side = this.rand() < 0.5 ? -1 : 1, d = tMin + this.rand() * (tMax - tMin), i = Math.round(s / tr.ds) % tr.N, hw = tr.width[i] / 2, wall = (side > 0 ? tr.wallR : tr.wallL)[i], t = hw + Math.max(d, wall + 2.5);\n      if (this.T.reach && t - hw > this.T.reach[side > 0 ? 1 : 0][i] + (o.beyond ?? 80)) continue;\n      const q = pointAt(tr, s, side * t);\n      if (grid.near(q.x, q.z, 30) < (o.clear ?? 7)) continue;\n      const y = groundHeight(this.T, this.T.id, q.i, side, t - hw);\n      this.put(id, q.x, y, q.z, this.rand() * 6.28, { seed: k, ...(o.build ? o.build(k, this.rand) : {}) }); placed++;\n    }\n  }\n  stand(s, side, o = {}) { const tr = this.tr, i = Math.round((((s % tr.length) + tr.length) % tr.length) / tr.ds) % tr.N, hw = tr.width[i] / 2, wall = (side > 0 ? tr.wallR : tr.wallL)[i], t = side * (hw + wall + (o.gap ?? 9)); this.side(o.id ?? 'grandstand', s, t, { y: o.y ?? (tr.y[i] - 0.2) }); this.crowd(s, t, side, o.w ?? 36, o.rows ?? 5, o.y ?? tr.y[i], o.stepZ ?? 1.9, o.stepY ?? 1.3); }\n  /** Stand-ins for spectators: small coloured boxes on terrace rows, in groups that bob (the CrowdCheer loop). */\n  crowd(s, t, side, width, rows, y0, stepZ, stepY) {\n    const tr = this.tr, q = pointAt(tr, s, t), yaw = q.yaw + (side > 0 ? -Math.PI / 2 : Math.PI / 2), r = this.rand, cols = ['red', 'blue', 'sand', 'white', 'lime', 'orange', 'plum', 'sky'];\n    for (let g = 0; g < 3; g++) {\n      const parts = [], grp = new Group();\n      for (let a = 0; a < rows; a++) for (let b = 0; b < width * 0.7; b++) { if (r() > 0.25 || (a + b) % 3 !== g) continue; const m = new Mesh(new BoxGeometry(0.42, 0.75, 0.3), toonMaterial(P[cols[Math.floor(r() * cols.length)]])); m.position.set(-width / 2 + b / 0.7 + r() * 0.6, 2.7 + a * stepY, 4.4 - a * stepZ); m.updateMatrix(); parts.push(m); }\n      grp.position.set(q.x, y0 - 0.2, q.z); grp.rotation.y = yaw; grp.add(...mergeStaticMeshes(parts)); this.ctx.scene.add(grp); this.crowds.push({ grp, y: y0 - 0.2, ph: g * 2.1 });\n    }\n    this.stands.push({ x: q.x, y: y0, z: q.z });\n  }\n  flag(x, y, z, c = P.red, w = 2.6, h = 1.6) { const body = clothGrid({ width: w, height: h, cols: 9, rows: 6, origin: [x, y, z], pin: 'left', across: [1, 0, 0] }), mesh = new SoftMesh(body, toonMaterial(c)); mesh.castShadow = false; this.ctx.scene.add(mesh); this.dyn.push((dt, t) => { for (const q of body.points ?? []) void q; body.gravity ??= undefined; applyWind(body, t, x + z); body.step(Math.min(dt, 1 / 30)); mesh.sync(); }); return mesh; }\n  finish() { if (this.statics.length) { for (const m of this.statics) m.updateMatrixWorld(true); this.ctx.scene.add(...mergeStaticMeshes(this.statics)); this.statics = []; } }\n  update(dt, t) { for (const f of this.dyn) f(dt, t); for (const c of this.crowds) c.grp.position.y = c.y + Math.max(0, Math.sin(t * 5 + c.ph)) * 0.14; }\n}\nfunction applyWind(body, t, ph) { if (body.wind) { body.wind[0] = 6 + Math.sin(t * 1.3 + ph) * 3; body.wind[2] = Math.sin(t * 2.1 + ph) * 3; } else if (body.applyForce) body.applyForce([5 + Math.sin(t * 1.3 + ph) * 3, 0, Math.sin(t * 2.1 + ph) * 3]); }\nconst pitSide = (d, s, o = {}) => { const tr = d.tr, i = Math.round((((s % tr.length) + tr.length) % tr.length) / tr.ds) % tr.N, hw = tr.width[i] / 2; return d.side('pit-building', s, hw + PIT_WIDTH + 2 + 7, { y: tr.y[i] - 0.1, ...o }); };\nconst gantry = (d, s = 0) => { const tr = d.tr, q = pointAt(tr, s, 0), w = tr.width[q.i] + 4; d.put('gantry', q.x, q.y, q.z, q.yaw + Math.PI / 2, { params: { w: Math.min(30, w) } }); return { ...q, w }; };\nfunction kestrel(d) {\n  const tr = d.tr; pitSide(d, 0); gantry(d);\n  d.stand(-60, -1); d.stand(-110, -1); d.stand(0, -1); d.stand(70, -1);\n  d.stand(tr.cornerS[6], 1, { gap: 12 });\n  const hill = pointAt(tr, tr.cornerS[9], 90), hy = groundHeight(d.T, 'kestrel', hill.i, 1, 80) + 2;\n  d.put('windmill', hill.x, hy - 1, hill.z, 0);\n  const sails = d.model('windmill-sails', hill.x, hy + 13, hill.z + 4.2); d.ctx.scene.add(sails); d.dyn.push((dt) => (sails.rotation.z += dt * 0.6));\n  const ch = pointAt(tr, tr.cornerS[3], -70); d.put('church', ch.x, groundHeight(d.T, 'kestrel', ch.i, -1, 60) - 0.5, ch.z, 0.7);\n  d.scatter('oak', 150, 6, 110, { build: (k, r) => ({ params: { h: 3 + r() * 2 } }), clear: 7 }); d.scatter('birch', 50, 10, 100); d.scatter('haystack', 40, 12, 60); d.scatter('fence', 70, 5, 12, { build: () => ({ params: { length: 8 } }), clear: 3 });\n  for (let n = 0; n < 8; n++) { const s = tr.cornerS[n * 2 % tr.cornerS.length]; const side = n % 2 ? 1 : -1, hw = 7, q = pointAt(tr, s + 30, side * (hw + tr.wallL[0] + 2)); d.put('marshal-post', q.x, q.y, q.z, q.yaw); d.flag(q.x + 1.1, q.y + 5.4, q.z, n % 2 ? P.orange : P.lime, 1.4, 0.9); d.put('flag-pole', q.x + 1.1, q.y, q.z); }\n  const flock = new Boids(26, { bounds: { min: [hill.x - 80, 30, hill.z - 80], max: [hill.x + 80, 62, hill.z + 80] }, view: 14, space: 5, maxSpeed: 12, minSpeed: 6, seed: 3 }); const geo = new BoxGeometry(0.9, 0.2, 0.45), mat = toonMaterial(P.ink), birds = []; for (let i = 0; i < flock.count; i++) { const m = new Mesh(geo, mat); d.ctx.scene.add(m); birds.push(m); } d.dyn.push((dt) => { flock.step(Math.min(dt, 1 / 30)); birds.forEach((m, i) => m.position.set(flock.pos[i * 3], flock.pos[i * 3 + 1], flock.pos[i * 3 + 2])); });\n}\nfunction cedar(d) {\n  const tr = d.tr; gantry(d); d.stand(40, 1, { gap: 8 });\n  d.scatter('pine', 900, 5, 130, { build: (k, r) => ({ params: { h: 3.2 + r() * 1.8 }, palette: {} }), clear: 5.5 }); d.scatter('snowy-pine', 90, 40, 130); d.scatter('boulders', 90, 4, 40, { clear: 4 }); d.scatter('rock', 40, 4, 20, { clear: 4 });\n  // the tunnel on the rise after C6\n  const s0 = tr.cornerS[6] + 40, tun = { from: s0 + 90, to: s0 + 170 };\n  for (let s = tun.from; s < tun.to; s += 8) { const q = pointAt(tr, s, 0); if (Math.abs(tr.kappa[q.i]) > 0.02) continue; d.put('tunnel-arch', q.x, q.y, q.z, q.yaw + Math.PI / 2, { params: { w: Math.min(30, tr.width[q.i] + (tr.wallL[q.i]) * 2 + 1) } }); }\n  d.T.tunnel = tun;\n  const v = pointAt(tr, tr.cornerS[11] + 60, 0); d.put('viaduct', v.x, v.y - 3, v.z, v.yaw + Math.PI / 2 + 0.1);\n  const h = pointAt(tr, tr.cornerS[2], 26); d.put('hut', h.x, groundHeight(d.T, 'cedar', h.i, 1, 20), h.z, 0.4);\n  for (let k = 0; k < 3; k++) d.hikers.push({ s: tr.cornerS[2], t: 18 + k * 2.2 });\n  // the waterfall\n  const wf = pointAt(tr, tr.cornerS[8], 34), wy = groundHeight(d.T, 'cedar', wf.i, 1, 26);\n  const cliff = new Mesh(new BoxGeometry(14, 26, 8), toonMaterial(P.slate)); cliff.position.set(wf.x, wy + 11, wf.z - 8); cliff.castShadow = true; d.statics.push(cliff);\n  const fall = new Mesh(new BoxGeometry(5, 24, 0.5), toonMaterial(P.cyan)); fall.position.set(wf.x, wy + 12, wf.z - 3.8); d.statics.push(fall);\n  const water = new WaterSurface({ size: [26, 18], at: [wf.x, wy + 0.3, wf.z + 6], waves: WAVES_CALM, segments: [13, 9] }); d.ctx.scene.add(water); let tp = 0;\n  d.dyn.push((dt, t) => { water.update(t); tp -= dt; if (tp < 0) { tp = 0.08; d.ctx.particles.burst('waterfall', [wf.x, wy + 22, wf.z - 3.4]); d.ctx.particles.burst('foam', [wf.x, wy + 0.6, wf.z - 2.5]); } });\n  let mp = 0; d.dyn.push((dt) => { mp -= dt; if (mp < 0 && d.focus) { mp = 0.5; d.ctx.particles.burst('mist', [d.focus.x, d.focus.y + 3, d.focus.z]); } });\n}\nfunction harbour(d) {\n  const tr = d.tr, r = d.rand; pitSide(d, 0, { build: { palette: { wall: 'mist', band: 'cyan' } } }); gantry(d);\n  d.stand(-40, -1, { gap: 5, y: tr.y[0] }); d.stand(90, -1, { gap: 5, y: tr.y[0] });\n  // lamps with baked pools: every 64 m on alternating sides\n  for (let s = 8, k = 0; s < tr.length; s += 64, k++) { const side = k % 2 ? 1 : -1, i = Math.round(s / tr.ds) % tr.N, hw = tr.width[i] / 2, wall = (side > 0 ? tr.wallR : tr.wallL)[i], q = pointAt(tr, s, side * (hw + wall + 0.5)); d.put('lamp-post', q.x, q.y, q.z, q.yaw + (side > 0 ? 1.57 : -1.57), {}); const m = new Mesh(new BoxGeometry(0.7, 0.3, 0.5), toonMaterial(P.sand)); }\n  // city blocks both sides, close\n  for (let k = 0; k < 150; k++) {\n    const s = r() * tr.length, side = r() < 0.5 ? -1 : 1, i = Math.round(s / tr.ds) % tr.N, hw = tr.width[i] / 2, depth = 18 + r() * 60, t = hw + 11 + depth * 0.5, q = pointAt(tr, s, side * t), w = 12 + r() * 20, dd = 12 + r() * 14, h = 8 + r() * 42;\n    if (d.T.grid.near(q.x, q.z, 40) < Math.max(w, dd) * 0.72 + 4) continue;\n    if (q.z < -15) continue; // the water front\n    d.put('city-block', q.x, 0 - 0.2, q.z, q.yaw, { params: { w, h, d: dd }, seed: k });\n  }\n  // neon signs in the game's own words, near the road\n  const signs = ['neon-kobo', 'neon-umami', 'neon-hotel', 'neon-zipp']; for (let k = 0; k < 18; k++) { const s = (k + 0.5) * tr.length / 18, side = k % 2 ? 1 : -1, i = Math.round(s / tr.ds) % tr.N, hw = tr.width[i] / 2, wall = (side > 0 ? tr.wallR : tr.wallL)[i], q = pointAt(tr, s, side * (hw + wall + 4)); if (T0(tr, i) || (d.T.pit && (i * tr.ds - d.T.pit.inS + tr.length) % tr.length < d.T.pit.span && side > 0)) continue; d.put(signs[k % 4], q.x, q.y + 3.2, q.z, q.yaw + (side > 0 ? -1.57 : 1.57)); const pole = new Mesh(new BoxGeometry(0.3, 3.2, 0.3), toonMaterial(P.ink)); pole.position.set(q.x, q.y + 1.6, q.z); d.statics.push(pole); }\n  // water along the front straight\n  const water = new WaterSurface({ size: [1600, 300], at: [60, -2.2, -175], waves: WAVES_CALM, segments: [60, 12], deep: P.navy, shallow: P.night, foam: P.sky }); d.ctx.scene.add(water); d.dyn.push((dt, t) => water.update(t));\n  // cranes and containers along the quay\n  for (const [x, z] of [[-200, -18], [120, -16], [360, -18]]) d.put('crane', x, -0.2, z - 8, 0);\n  for (let k = 0; k < 12; k++) d.put('containers', -260 + k * 58, -0.2, -14 - (k % 3) * 2, 0);\n  // the Ferris wheel, turning in the distance\n  const w = { x: 760, z: 120 }; d.put('wheel-frame', w.x, -0.2, w.z, 1.2); const ring = d.model('wheel-ring', w.x, 31, w.z, 1.2); d.ctx.scene.add(ring); const spin = new Group(); void spin; d.dyn.push((dt) => (ring.rotation.z += dt * 0.12));\n  d.fireworks = true;\n}\nconst T0 = (tr, i) => Math.abs(tr.kappa[i]) > 0.03;\nfunction saltline(d) {\n  const tr = d.tr; pitSide(d, 0); gantry(d);\n  for (const s of [-180, -120, -60, 0, 60, 120, 180]) d.stand(s, -1, { gap: 7 });\n  const q = pointAt(tr, 40, 80); d.put('flag-tower', q.x, -0.2, q.z); d.flag(q.x + 0.2, 45, q.z, P.red, 7, 4);\n  const blimp = d.model('blimp', 0, 110, 400); d.ctx.scene.add(blimp); blimp.traverse((m) => { if (m.isMesh) m.castShadow = false; }); d.dyn.push((dt, t) => { const a = t * 0.05; blimp.position.set(Math.cos(a) * 760, 110, 420 + Math.sin(a) * 760); blimp.rotation.y = -a; });\n  const r = d.rand; for (let k = 0; k < 14; k++) { const a = r() * 6.28, R = 1100 + r() * 800; d.put('mesa', Math.cos(a) * R, -6, 400 + Math.sin(a) * R, r() * 6, { params: { h: 40 + r() * 90 } }); }\n  const devils = [[-900, 900], [1000, 1300], [300, -500]]; let tp = 0; d.dyn.push((dt, t) => { tp -= dt; if (tp < 0) { tp = 0.12; devils.forEach(([x, z], i) => d.ctx.particles.burst('devil', [x + Math.sin(t * 0.3 + i) * 120, 2, z + Math.cos(t * 0.21 + i) * 120], { count: 3 })); } });\n  for (let n = 0; n < 40; n++) { const s = n * tr.length / 40, side = n % 2 ? 1 : -1, i = Math.round(s / tr.ds) % tr.N, hw = tr.width[i] / 2, qq = pointAt(tr, s, side * (hw + 4.5)); if (d.T.pit && side > 0 && (i * tr.ds - d.T.pit.inS + tr.length) % tr.length < d.T.pit.span) continue; d.put('flag-pole', qq.x, qq.y, qq.z); }\n}\nfunction redclay(d) {\n  const tr = d.tr; gantry(d, 0);\n  d.scatter('cactus', 110, 3, 16, { clear: 4, beyond: 120 }); d.scatter('boulders', 110, 3, 40, { clear: 3.5, beyond: 120, build: () => ({ palette: {} }) });\n  const w = pointAt(tr, tr.cornerS[4] + 30, 30); d.put('water-tower', w.x, groundHeight(d.T, 'redclay', w.i, 1, 24), w.z);\n  for (const s of [tr.cornerS[1], tr.cornerS[6], tr.cornerS[9], 30]) { const i = Math.round(((s % tr.length) + tr.length) % tr.length / tr.ds) % tr.N, side = Math.sign(tr.kappa[i]) || 1; d.stand(s, -side, { id: 'wood-stand', gap: 4, y: groundHeight(d.T, 'redclay', i, -side, 7) + 0.1, w: 12, rows: 3, stepZ: 1.6, stepY: 1 }); }\n  for (const [cs] of tr.def.crests) { for (const off of [-130, -70]) { const q = pointAt(tr, cs + off, -(tr.width[0] / 2 + 3)); d.side('warn-board', cs + off, -(4.5 + 3)); void q; } }\n  tr.def.corners.forEach((c, n) => { if (c[2] > 22) return; const q = tr.cornerS[n] - 60, i = Math.round(((q + tr.length) % tr.length) / tr.ds) % tr.N, side = -Math.sign(tr.kappa[Math.round(tr.cornerS[n] / tr.ds) % tr.N] || 1); void i; d.side('warn-board', q, side * 7.5); });\n}\nfunction proving(d) {\n  const tr = d.tr; gantry(d, 0);\n  const t = pointAt(tr, -40, -34); d.put('control-tower', t.x, -0.2, t.z); d.put('van', t.x + 16, -0.2, t.z + 6, 1.2);\n  for (const [s, off] of [[-180, -60], [40, -60], [240, -66]]) { const q = pointAt(tr, s, off); d.put('hangar', q.x, -0.2, q.z, q.yaw + Math.PI); }\n  d.scatter('crate', 14, 20, 60); d.scatter('barrel', 24, 20, 60); d.scatter('bench', 8, 20, 40);\n  const sock = pointAt(tr, 30, -28); d.put('flag-pole', sock.x, -0.2, sock.z); d.flag(sock.x, 5.8, sock.z, P.orange, 3, 0.8);\n  // painted boxes and cones lying around the apron\n  for (let k = 0; k < 18; k++) { const q = pointAt(tr, -260 + k * 46, -24 - (k % 3) * 5), c = new Mesh(new BoxGeometry(0.4, 0.7, 0.4), toonMaterial(P.orange)); c.position.set(q.x, q.y + 0.35, q.z); d.statics.push(c); }\n}\nexport function dressTrack(ctx, T, hub = false) {\n  const d = new Dresser(ctx, T, hub); d.hikers = [];\n  ({ kestrel, cedar, harbour, saltline, redclay, proving })[T.id](d);\n  d.finish();\n  return d;\n}\n/** Baked lamp pools for the Harbour: brightness per road sample. */\nexport function lampPools(tr) { const a = new Float32Array(tr.N); for (let s = 8; s < tr.length; s += 64) { const i0 = Math.round(s / tr.ds); for (let k = -3; k <= 3; k++) { const i = (i0 + k + tr.N) % tr.N; a[i] = Math.max(a[i], 1 - Math.abs(k) / 4); } } return a; }\nvoid Vector3; void Precipitation;\nE\ngrep -n \"class VerletBody\" -A30 src/types/engine/physics/*.d.ts | grep -E \"step|wind|gravity|force|points|pos\" | head","description":"Write props and track dressing"}}}
