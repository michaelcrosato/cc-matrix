()\"); screen_is(pg,'map')\n        print(tag,pg.evaluate(\"[window.__GAME__.app.hud.width,window.__GAME__.app.hud.height]\"))\n        def shot(n,ms=900): pg.wait_for_timeout(ms); pg.screenshot(path=f'tools/shots/w{tag}_{n}.png')\n        shot('map',1500)\n        for name,e in [('dealer','a.screens.Dealer()'),('parts',\"a.screens.Tuning()\"),('card',\"a.screens.EventCard('dawn')\")]:\n            pg.evaluate(\"(()=>{const a=window.__GAME__.app;a.ui.push(%s)})()\"%e); shot(name); pg.evaluate(\"window.__GAME__.app.ui.pop()\")\n        # a real quick race, finish, results, replay\n        pg.evaluate(\"(()=>{const a=window.__GAME__.app;a.ui.push(a.screens.Arcade())})()\"); pg.wait_for_timeout(300)\n        if tag=='43':\n            pg.keyboard.press('Enter'); pg.wait_for_timeout(600); pg.keyboard.press('Enter'); pg.wait_for_timeout(600); pg.keyboard.press('Enter'); pg.wait_for_timeout(600);\n            for k in range(8):\n                if st(pg)['focus']=='go': break\n                pg.keyboard.press('ArrowDown'); pg.wait_for_timeout(200)\n            pg.keyboard.press('Enter'); wait(pg,\"window.__GAME__.state().scene==='race'\",40000); pg.wait_for_timeout(8000); shot('race',200); pg.evaluate(\"window.__GAME__.app.scene.sim.finishNow(2)\"); screen_is(pg,'results'); shot('results',2600); pg.keyboard.press('ArrowRight'); pg.wait_for_timeout(250);pg.keyboard.press('ArrowRight'); pg.wait_for_timeout(250); print(st(pg)['focus']); pg.keyboard.press('Enter'); wait(pg,\"window.__GAME__.state().scene==='replay'\",30000); shot('replay',5000); print(st(pg)['status'])\n        print(errs[:5]); ctx.close()\n    b.close()\nE\nnode tools/build.mjs | tail -1; timeout 200 python3 tools/tour4.py 2>&1 | tail -7 | cut -c1-300; cd tools/shots; magick \\( w43_map.png w43_dealer.png w43_parts.png w43_card.png -resize 480x360 +append \\) \\( w43_race.png w43_results.png w43_replay.png -resize 480x360 +append \\) -append w43.png; cd ../..","description":"Check 4:3 and ultrawide layouts,