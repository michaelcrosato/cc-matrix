sity = 0.55; } }, { at: 3.0, name: 'cover', run: () => { tw.to(cover.position, { x: 9, y: 2.4 }, { duration: 1.3, ease: 'inOutSine' }); app.mix.ui('fanfare2'); app.ctx.particles.burst('confetti', [X, 4, 0]); } }, { at: 5.0, name: 'amb', run: () => { app.ctx.engine.ambient.intensity = 1; } }], lines: [{ at: 0.4, until: 3, text: 'A PRIZE CAR. PLEASE HOLD STILL.' }, { at: 4.4, until: 7.9, text: CARS[carId].name }] }); this.tl.play(); },\n  draw(ui, dt) { const app = ui.app, sc = app.scene; this.tl.update(dt); const shot = this.tl.camera(); if (shot) { const cam = app.ctx.camera.camera; cam.position.set(...toArr(shot.position)); cam.lookAt(...toArr(shot.target)); } const bars = this.tl.bars(); if (bars > 0) { const h = Math.round(20 * bars); ui.hud.rect(0, 0, ui.W, h, 'ink'); ui.hud.rect(0, ui.H - h, ui.W, h, 'ink'); } const line = this.tl.line(); if (line) ui.center(ui.H - 42, line.text, { color: 'sand' }); const a = app.actions; if (this.tl.ended || a.pressed('confirm') || a.click) { sc.shotOverride = false; next(); } ui.prompts([['confirm', 'CONTINUE']]); } });\nexport const Ending = () => scr('ending', { set: 'theatre', music: 'credits', t: 0, onEnter(app) { this.t = 0; app.ui.say(LINES.ending, SPEAKERS.dell, { time: 6 }); },\n  draw(ui, dt) { const app = ui.app; this.t += dt; ui.hud.rect(0, 0, ui.W, ui.H, 'ink'); const lines = [TITLE, '', 'FOURTEEN CARS', 'SIX ROADS', 'FOUR PEOPLE WHO WERE VERY POLITE ABOUT IT', '', 'THE HALCYON PENINSULA THANKS YOU', 'FOR WASHING YOUR CAR', '', 'INSPIRED BY THE GREAT CATALOGUE DRIVING GAMES', '', 'MADE BY CLAUDE, FROM A PLAN'], base = ui.H - this.t * 18; lines.forEach((l, i) => { const y = Math.round(base + i * 16); if (y > 10 && y < ui.H - 40) ui.center(y, l, { color: i === 0 ? 'sand' : 'white', scale: i === 0 ? 2 : 1 }); }); if (base + lines.length * 16 < 60) { ui.center(90, 'YOU MAY KEEP DRIVING.', { scale: 2, color: 'sand' }); ui.center(114, 'MOST PEOPLE DO.', { scale: 2, color: 'white' }); } if (ui.button('done', ui.cx - 60, 