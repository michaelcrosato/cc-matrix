washing -= dt; if (this.time % 0.1 < dt) ctx.particles.burst('foam', [s.x + (Math.sin(this.time * 7) > 0 ? 1 : -1), 0.9, this.sets.service.userData.brushes[0].position.z]); this.sets.service.userData.brushes.forEach((b) => (b.rotation.y += dt * 12)); }\n  }\n  cameraTarget() { return this.target; }\n  status() { const u = this.app.ui; return `menu ${u.top?.id ?? this.current} focus=${u.focus ?? ''}`; }\n  ready(ctx) { this.app.onReady?.(ctx, this); }\n  fingerprint() { return `${this.current}|${this.app.ui.top?.id}|${this.app.profile?.credits ?? 0}`; }\n}\nvoid Timeline;\nexport { SETS };\nE\ncat > src/game/ui/screens/podium.js <<'E'\n// Podium, prize reveal, ending. Timeline scenes: shots, cues, subtitles, confetti.\nimport { Timeline } from '../../../pixel-engine.js';\nimport { scr } from './common.js';\nimport { CARS } from '../../data/cars.js';\nimport { carRec } from '../../sim/career.js';\nimport { wrap } from '../ui.js';\nimport { LINES } from '../../data/text.js';\nimport { TITLE } from '../../data/meta.js';\nimport { SPEAKERS } from '../../audio/voice.js';\nimport { SETS } from '../../scenes/menu.js';\nexport const Podium = (o, next) => scr('podium', { set: 'podium', music: 'credits', setArgs(app) { const r = carRec(app.profile); return { car: r?.id, install: r?.install, dirt: r?.dirt }; },\n  onEnter(app) { const sc = app.scene, s = SETS.podium, X = s.x, pos = (p, x, y, z, clip) => { p.root.visible = true; p.root.position.set(X + x, y, z); p.root.rotation.y = 0; p.play(clip); }; pos(sc.people.driver, 0, 1.44, -2, 'PodiumCheer'); pos(sc.people.d2, -2.4, 0.96, -2, 'PodiumBow'); pos(sc.people.d3, 2.4, 0.6, -2, 'PodiumBow'); sc.shotOverride = true; const pts = (x, y, z) => [X + x, y, z]; this.tl = new Timeline({ duration: 7.5, bars: 0.5, shots: [{ at: 0, position: pts(-8, 3, 8), target: pts(0, 2.4, -2) }, { at: 3.2, position: pts(0, 2.4, 6), target: pts(0, 2.6, -2) }, { at: 7.5, position: pts(5, 2, 9), target: pts(0, 1.4, 2) }], cues: [{ at: 0.3, name: 'horn',