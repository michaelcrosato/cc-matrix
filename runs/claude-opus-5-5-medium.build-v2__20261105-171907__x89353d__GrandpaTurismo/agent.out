{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkkfmF7ZocFyfMpErq6b","type":"message","role":"assistant","content":[{"type":"text","text":"The title, map, licence, event and dealer screens are written. Next are tuning, garage, settings and the post-race screens, then the menu scene and the app shell."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16974,"cache_read_input_tokens":371011,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16974},"output_tokens":71,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c060cbf0-9de2-4b69-aed6-69ef0ff7f0ee","uuid":"150772bc-e35f-46e5-98ab-52bfffe7b91a","timestamp":"2026-11-06T00:48:06.548Z","request_id":"req_011CgkkfkyVgq1Luor8viHrP"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkkfmF7ZocFyfMpErq6b","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01U5PLHaaNN3v7jYjc3ZbsR4","name":"Bash","input":{"command":"cat > src/game/ui/screens/tuning.js <<'E'\n// Tuning Street: eight tiles, four to a page; in a tile up to five parts; the Setup tab; the dyno. Service Bay: oil and soap.\nimport { CATEGORIES, PARTS, SETTINGS, PART, OIL_PRICE, WASH_PRICE, PAINT_PRICE, RIM_PRICE } from '../../data/parts.js';\nimport { TYRES } from '../../data/tyres.js';\nimport { PAINTS, RIMS, CARS } from '../../data/cars.js';\nimport { carRec, canBuyPart, buyPart, buyTyre, buyPaint, buyRims, partOwned, partSuperseded, changeOil, washCar, oilFactor } from '../../sim/career.js';\nimport { specOf, dynoCurve } from '../../sim/tuning.js';\nimport { torqueShape } from '../../sim/sim.js';\nimport { testDriveSetup } from '../../sim/setups.js';\nimport { LINES } from '../../data/text.js';\nimport { scr, stdBack, statusStrip } from './common.js';\nimport { fmtCr } from '../ui.js';\nimport { SPEAKERS } from '../../audio/voice.js';\nconst BEN = SPEAKERS.benno;\nconst specLine = (a, b) => { const parts = []; if (a.ps !== b.ps) parts.push(`${a.ps} > ${b.ps} PS`); if (a.kg !== b.kg) parts.push(`${a.kg} > ${b.kg} KG`); return parts.join('  '); };\nexport const Tuning = () => scr('tuning', { set: 'tuning', music: 'tuning', tab: 0, page: 0, setArgs(app) { const r = carRec(app.profile); return { car: r.id, install: r.install, dirt: r.dirt }; },\n  draw(ui) { const app = ui.app, p = app.profile, r = carRec(p), a = app.actions, s = specOf(r.id, r.install); ui.title('TUNING STREET'); statusStrip(app, ui); ui.tabs(26, ['PARTS', 'SETUP'], this.tab, (i) => (this.tab = i)); ui.text(ui.W - 170, 30, `${CARS[r.id].shortName}  ${s.ps} PS  ${s.kg} KG`, { color: 'white' });\n    if (this.tab === 0) { const per = 4, list = CATEGORIES.slice(this.page * per, this.page * per + per); list.forEach((c, i) => { const x = 10 + (i % 2) * 112, y = 46 + Math.floor(i / 2) * 62; if (ui.button(c.id, x, y, 106, 56, c.name, { sub: '' })) ui.push(c.id === 'body' ? BodyTile() : c.id === 'tyres' ? TyreTile() : PartTile(c.id)); }); const cur = CATEGORIES.find((c) => c.id === ui.focus); if (cur) ui.para(10, 174, cur.line, 40, { color: 'mist' }); if (ui.button('morepage', 10, 196, 106, 18, this.page ? 'FIRST FOUR' : 'NEXT FOUR')) { this.page = 1 - this.page; ui.focus = null; } if (ui.button('drive', 122, 196, 106, 18, 'TEST DRIVE')) this.drive(app, r); }\n    else { const avail = SETTINGS.filter((x) => x.needs(r.install.parts)); if (!avail.length) ui.para(10, 50, 'NO SETTINGS YET. A RACE GEARBOX, LSD, SUSPENSION, BRAKE KIT OR BIG WING WILL EACH ADD ONE.', 40, { color: 'mist' }); avail.slice(0, 5).forEach((st, i) => { const v = r.install.settings[st.id] ?? st.def; ui.slider(st.id, 10, 46 + i * 24, 222, st.name, v, st.min, st.max, (st.max - st.min) / 20, (nv) => { r.install.settings[st.id] = nv; app.save(); }, { format: (x) => (x < (st.min + st.max) / 2 ? st.lo : x > (st.min + st.max) / 2 ? st.hi : 'MIDDLE'), dflt: st.def, h: 20 }); }); const cur = avail.find((x) => x.id === ui.focus); if (cur) ui.para(10, 172, cur.line, 40, { color: 'mist' }); if (ui.button('drive', 122, 196, 106, 18, 'TEST DRIVE')) this.drive(app, r); }\n    if (a.pressed('alt')) this.drive(app, r);\n    if (stdBack(app, ui)) return; ui.prompts([['confirm', 'SELECT'], ['alt', 'DRIVE'], ['tabs', 'TAB'], ['back', 'BACK']]); },\n  drive(app, r) { app.startRace(testDriveSetup(r.id, r.install, { screen: 'tuning' })); },\n});\nexport const PartTile = (cat) => scr('parts', { set: 'tuning', music: 'tuning',\n  draw(ui) { const app = ui.app, p = app.profile, r = carRec(p), c = CATEGORIES.find((x) => x.id === cat), before = specOf(r.id, r.install), list = PARTS.filter((x) => x.cat === cat); ui.title(c.name); statusStrip(app, ui);\n    list.forEach((pt, i) => { const owned = partOwned(r, pt), sup = partSuperseded(r, pt), can = canBuyPart(p, r, pt), y = 28 + i * 31; if (ui.button(pt.id, 10, y, 226, 28, pt.name, { left: true, sub: owned ? 'FITTED' : sup ? 'YOU HAVE BETTER' : fmtCr(pt.price), disabled: !can.ok, subColor: owned ? 'lime' : p.credits >= pt.price ? 'mist' : 'orange' })) { const prevInstall = JSON.parse(JSON.stringify(r.install)); if (buyPart(p, r, pt.id)) { app.save(); app.mix.ui('register'); app.scene.partFitted?.(r); if (cat === 'engine') { ui.say(LINES.bennoEngine, BEN); ui.push(DynoScreen(prevInstall, r)); } else ui.say(cat === 'aero' && pt.id === 'wing' ? LINES.bennoWing : cat === 'brakes' ? LINES.bennoBrakes : cat === 'weight' ? LINES.bennoWeight : LINES.bennoGeneric, BEN); } } });\n    const cur = PART[ui.focus]; if (cur) { const wx = 246, w = Math.min(ui.W - wx - 8, 200); ui.panel(wx, 30, w, 66); ui.para(wx + 6, 36, cur.line, Math.floor((w - 12) / 6), { color: 'white' }); const inst = JSON.parse(JSON.stringify(r.install)); inst.parts[cur.slot] = cur.level; const line = specLine(before, specOf(r.id, inst)); ui.text(wx + 6, 84, line || 'NO NUMBER CHANGES. YOU WILL FEEL IT.', { color: 'lime' }); }\n    if (stdBack(app, ui)) return; ui.prompts([['confirm', 'BUY'], ['back', 'BACK']]); } });\nexport const TyreTile = () => scr('tyres', { set: 'tuning', music: 'tuning',\n  draw(ui) { const app = ui.app, p = app.profile, r = carRec(p); ui.title('TYRES'); statusStrip(app, ui); TYRES.forEach((t, i) => { const owned = r.install.tyre === t.id, y = 28 + i * 31; if (ui.button(t.id, 10, y, 226, 28, t.name, { left: true, sub: owned ? 'FITTED' : fmtCr(t.price), disabled: owned || p.credits < t.price, subColor: owned ? 'lime' : 'mist' })) { if (buyTyre(p, r, t.id)) { app.save(); app.mix.ui('register'); ui.say(LINES.bennoTyres, BEN); } } }); const cur = TYRES.find((t) => t.id === ui.focus); if (cur) { const wx = 246, w = Math.min(ui.W - wx - 8, 200); ui.panel(wx, 30, w, 66); ui.para(wx + 6, 36, cur.line, Math.floor((w - 12) / 6), { color: 'white' }); ui.text(wx + 6, 72, `GRIP ${cur.tyreMu.toFixed(2)}  DIRT ${cur.dirt.toFixed(2)}`, { color: 'lime' }); ui.text(wx + 6, 84, `WEAR X${cur.wearX.toFixed(1)}`, { color: 'sand' }); } if (stdBack(app, ui)) return; ui.prompts([['confirm', 'BUY'], ['back', 'BACK']]); } });\nexport const BodyTile = () => scr('body', { set: 'tuning', music: 'tuning', tab: 0,\n  draw(ui) { const app = ui.app, p = app.profile, r = carRec(p); ui.title('BODY'); statusStrip(app, ui); ui.tabs(26, ['PAINT', 'RIMS'], this.tab, (i) => (this.tab = i));\n    if (this.tab === 0) { PAINTS.forEach((c, i) => { const x = 10 + (i % 4) * 34, y = 46 + Math.floor(i / 4) * 30, id = `p${c}`; ui.hud.rect(x, y, 30, 26, c); if (r.install.paint === c) ui.hud.rect(x + 11, y + 9, 8, 8, 'white'); if (ui.item(id, x, y, 30, 26, { label: c })) { if (buyPaint(p, r, c)) { app.save(); app.mix.ui('register'); app.scene.partFitted?.(r); ui.toast('PAINT APPLIED. IT IS STILL WET.'); } } }); ui.text(10, 172, `PAINT ${fmtCr(PAINT_PRICE)}`, { color: 'mist' }); }\n    else { RIMS.forEach((m, i) => { const y = 46 + i * 28; if (ui.button(`rim${i}`, 10, y, 136, 24, m.name, { left: true, disabled: r.install.rims === i })) { if (buyRims(p, r, i)) { app.save(); app.mix.ui('register'); app.scene.partFitted?.(r); } } ui.hud.rect(122, y + 4, 16, 16, m.hub); ui.hud.rect(128, y + 2, 4, 20, m.spoke); }); ui.text(10, 172, `RIMS ${fmtCr(RIM_PRICE)}`, { color: 'mist' }); }\n    if (stdBack(app, ui)) return; ui.prompts([['confirm', 'BUY'], ['tabs', 'TAB'], ['back', 'BACK']]); } });\nexport const DynoScreen = (before, rec) => scr('dyno', { set: 'tuning', music: 'tuning', t: 0, onEnter(app) { this.a = dynoCurve(rec.id, before, torqueShape); this.b = dynoCurve(rec.id, rec.install, torqueShape); app.scene.dynoStart?.(); this.t = 0; },\n  draw(ui, dt) { const app = ui.app; this.t += dt; ui.title('DYNO'); const x = 14, y = 34, w = 196, h = 118, peak = Math.max(this.b.peak, this.a.peak) * 1.05, f = Math.min(1, this.t / 4); ui.panel(x - 4, y - 4, w + 8, h + 20); for (let i = 1; i < 4; i++) ui.hud.rect(x, y + (h * i) / 4, w, 1, 'night');\n    const plot = (cv, col, frac) => { const n = Math.floor(cv.curve.length * frac); for (let i = 0; i < n; i++) { const q = cv.curve[i], px = x + Math.round((i / (cv.curve.length - 1)) * (w - 2)), py = y + h - Math.round((q.ps / peak) * h); ui.hud.rect(px, py, 2, 2, col); } };\n    plot(this.a, 'mist', 1); plot(this.b, 'lime', f);\n    ui.text(x, y + h + 3, `BEFORE ${Math.round(this.a.peak)} PS`, { color: 'mist' }); if (f >= 1) ui.right(x + w, y + h + 3, `NOW ${Math.round(this.b.peak)} PS`, { color: 'lime' });\n    const rpm = 1500 + (this.b.redline - 1500) * f; app.scene.dynoFrame?.(rpm, f < 1 ? 1 : 0.1, dt, rec);\n    if (ui.button('ok', ui.W - 120, ui.H - 46, 110, 22, f < 1 ? 'SKIP' : 'CONTINUE')) { if (f < 1) this.t = 99; else { app.scene.dynoEnd?.(); ui.pop(); return; } }\n    if (stdBack(app, ui, () => { app.scene.dynoEnd?.(); ui.pop(); })) return; ui.prompts([['confirm', 'CONTINUE'], ['back', 'BACK']]); } });\nexport const Service = () => scr('service', { set: 'service', music: 'service', setArgs(app) { const r = carRec(app.profile); return { car: r.id, install: r.install, dirt: r.dirt }; }, onEnter(app) { const r = carRec(app.profile); app.ui.say(r.oilKm > 200 ? LINES.bennoOil : LINES.bennoHello, BEN); },\n  draw(ui, dt) { const app = ui.app, p = app.profile, r = carRec(p); ui.title('SERVICE BAY'); statusStrip(app, ui); const oil = oilFactor(r), pct = Math.round((oil - 1) * 1000) / 10; ui.panel(10, 30, 210, 62); ui.text(16, 36, CARS[r.id].shortName, { color: 'sand' }); ui.text(16, 48, `OIL: ${Math.round(r.oilKm)} KM SINCE A CHANGE`, { color: 'white' }); ui.text(16, 60, `POWER ${pct >= 0 ? '+' : ''}${pct}%`, { color: pct < 0 ? 'orange' : 'lime' }); ui.text(16, 72, `DIRT: ${Math.round(r.dirt * 100)}%`, { color: r.dirt > 0.3 ? 'orange' : 'white' });\n    if (ui.button('oil', 10, 100, 210, 30, 'OIL CHANGE', { left: true, sub: fmtCr(OIL_PRICE), disabled: p.credits < OIL_PRICE || r.oilKm === 0 })) { if (changeOil(p, r)) { app.save(); app.mix.ui('register'); ui.say(LINES.bennoOilDone, BEN); app.scene.oilAnim?.(); } }\n    if (ui.button('wash', 10, 134, 210, 30, 'CAR WASH', { left: true, sub: fmtCr(WASH_PRICE), disabled: p.credits < WASH_PRICE })) { if (washCar(p, r)) { app.save(); app.mix.ui('register'); ui.say(LINES.bennoWash, BEN); app.scene.washAnim?.(); } }\n    void dt; if (stdBack(app, ui)) return; ui.prompts([['confirm', 'SELECT'], ['back', 'BACK']]); } });\nE\ncat > src/game/ui/screens/garage.js <<'E'\n// Home Garage, Museum and Theatre.\nimport { CAR_LIST, CARS } from '../../data/cars.js';\nimport { carRec, canSell, sellCar, collected, medalName } from '../../sim/career.js';\nimport { specOf } from '../../sim/tuning.js';\nimport { getTrack } from '../../sim/race.js';\nimport { TRACKS } from '../../data/tracks.js';\nimport { drawMini } from './events.js';\nimport { TEST } from '../../data/licences.js';\nimport { scr, stdBack, statusStrip } from './common.js';\nimport { wrap, fmtCr, fmtTime } from '../ui.js';\nimport { oilFactor } from '../../sim/career.js';\nexport const Garage = () => scr('garage', { set: 'garage', music: 'map', tab: 0, idx: 0, setArgs(app) { const p = app.profile, r = carRec(p) ?? p.cars[0]; this.idx = Math.max(0, p.cars.indexOf(r)); return r ? { car: r.id, install: r.install, dirt: r.dirt, trophies: p.trophies } : {}; },\n  draw(ui) { const app = ui.app, p = app.profile; ui.title('HOME GARAGE'); statusStrip(app, ui); ui.tabs(26, ['CARS', 'SHELF', 'STATS'], this.tab, (i) => (this.tab = i)); const x = ui.W - 190, W = 182;\n    if (this.tab === 0 && p.cars.length) { if (ui.leftRight) { this.idx = (this.idx + ui.leftRight + p.cars.length) % p.cars.length; const q = p.cars[this.idx]; app.scene.showCarAt?.(q.id, q.install, q.dirt); app.mix.ui('tick'); }\n      const r = p.cars[this.idx] ?? p.cars[0], s = specOf(r.id, r.install), cur = r.uid === p.current; ui.panel(x, 44, W, 88); ui.text(x + 6, 49, CARS[r.id].shortName, { color: 'sand' }); ui.text(x + 6, 61, `${s.layout}  ${s.ps} PS  ${s.kg} KG`, { color: 'white' }); ui.text(x + 6, 73, `${Math.round(r.km).toLocaleString('en-US')} KM`, { color: 'white' }); const o = Math.round((oilFactor(r) - 1) * 1000) / 10; ui.text(x + 6, 85, `OIL ${o >= 0 ? '+' : ''}${o}%`, { color: o < 0 ? 'orange' : 'lime' }); ui.text(x + 6, 97, `TYRES ${(r.install.tyre ?? 'STOCK').toUpperCase()}`, { color: 'white' }); ui.text(x + 6, 109, `PARTS ${Object.keys(r.install.parts).length}  DIRT ${Math.round(r.dirt * 100)}%`, { color: 'white' }); ui.text(x + 6, 120, `${this.idx + 1} OF ${p.cars.length}${cur ? '  CURRENT' : ''}`, { color: 'mist' });\n      if (ui.button('choose', x, 138, W, 22, cur ? 'YOUR RIDE' : 'CHOOSE THIS CAR', { disabled: cur })) { p.current = r.uid; app.save(); ui.toast(`${CARS[r.id].shortName} CHOSEN`); } const can = canSell(p, r.uid); if (ui.button('sell', x, 164, W, 20, can.ok ? `SELL ${fmtCr(can.value)}` : 'SELL', { disabled: !can.ok })) { const v = sellCar(p, r.uid); if (v) { app.save(); app.mix.ui('register'); this.idx = 0; const q = p.cars[0]; app.scene.showCarAt?.(q.id, q.install, q.dirt); } } if (!can.ok && ui.focus === 'sell') ui.para(10, 196, can.why, 40, { color: 'orange' }); }\n    if (this.tab === 1) { ui.item('shelf', 10, 44, 10, 10, {}); ui.panel(10, 44, 280, 44 + Math.max(0, Math.min(5, p.trophies.length)) * 12); ui.text(16, 49, `TROPHIES: ${p.trophies.length}`, { color: 'sand' }); p.trophies.slice(-5).forEach((t, i) => ui.text(16, 62 + i * 12, `DAY ${t.day}  ${t.name}`, { color: 'white' })); if (!p.trophies.length) ui.text(16, 62, 'THE SHELF IS DUSTED AND READY.', { color: 'mist' }); }\n    if (this.tab === 2) { ui.item('stats', 10, 44, 10, 10, {}); ui.panel(10, 44, 280, 94); const rows = [`DAYS ${p.day}`, `DISTANCE ${Math.round(p.stats.km).toLocaleString('en-US')} KM`, `RACES ${p.stats.races}  WINS ${p.stats.wins}`, `GOLD MEDALS ${p.stats.golds}`, `CREDITS EARNED ${Math.round(p.stats.earned).toLocaleString('en-US')}`, `COLLECTED ${collected(p)}%`]; rows.forEach((l, i) => ui.text(16, 50 + i * 14, l, { color: i === 5 ? 'lime' : 'white' })); }\n    if (stdBack(app, ui)) return; ui.prompts([['confirm', 'SELECT'], ['lr', 'CAR'], ['tabs', 'TAB'], ['back', 'BACK']]); } });\nconst metOf = (p, id) => !!p?.seen?.[id];\nexport const Museum = () => scr('museum', { set: 'museum', music: 'museum', tab: 0, idx: 0, tr: 0, setArgs(app) { return { car: CAR_LIST[this.idx].id, dark: !metOf(app.profile, CAR_LIST[this.idx].id) }; },\n  draw(ui) { const app = ui.app, p = app.profile; ui.title('MUSEUM'); statusStrip(app, ui); ui.tabs(26, ['CARS', 'TRACKS'], this.tab, (i) => { this.tab = i; if (i === 1) app.scene.setSet('museum', { car: null }); else { const c = CAR_LIST[this.idx]; app.scene.setSet('museum', { car: c.id, dark: !metOf(p, c.id) }); } });\n    if (this.tab === 0) { if (ui.leftRight) { this.idx = (this.idx + ui.leftRight + CAR_LIST.length) % CAR_LIST.length; const c = CAR_LIST[this.idx]; app.scene.showCarAt?.(c.id, null, 0, !metOf(p, c.id)); app.mix.ui('tick'); } const c = CAR_LIST[this.idx], met = metOf(p, c.id), lines = wrap(met ? c.brochure : 'YOU HAVE NOT YET MET THIS CAR. MEETING ONE IN A RACE WILL DO.', 40); ui.item('car', 8, 44, 248, lines.length * 10 + 42); ui.panel(8, 44, 248, lines.length * 10 + 42); ui.text(14, 49, met ? c.name : '????', { color: 'sand' }); if (met) { const s = specOf(c.id, {}); ui.text(14, 61, `${c.year} ${s.layout} ${s.ps} PS ${s.kg} KG`, { color: 'white' }); } lines.forEach((l, i) => ui.text(14, 74 + i * 10, l, { color: 'white' })); ui.text(8, ui.H - 30, `${this.idx + 1} OF ${CAR_LIST.length}`, { color: 'mist' }); }\n    else { const ids = Object.keys(TRACKS); if (ui.leftRight) { this.tr = (this.tr + ui.leftRight + ids.length) % ids.length; app.mix.ui('tick'); } const id = ids[this.tr], T = TRACKS[id], tr = getTrack(id).tr, rec = p.records[id]; ui.item('track', 8, 44, 330, 140); ui.panel(8, 44, 330, 140); drawMini(ui, id, 16, 54, 120, 'sand'); ui.text(150, 54, T.name, { color: 'sand' }); ui.text(150, 70, `${Math.round(tr.length).toLocaleString('en-US')} M`, { color: 'white' }); ui.text(150, 84, `${T.corners.length} CORNERS`, { color: 'white' }); ui.text(150, 98, T.surface === 'dirt' ? 'DIRT' : 'TARMAC', { color: 'white' }); ui.text(150, 112, rec ? `RECORD ${fmtTime(rec.lap)}` : 'NO RECORD YET', { color: 'lime' }); if (rec) ui.text(150, 124, CARS[rec.car]?.shortName ?? '', { color: 'mist' }); ui.text(8, ui.H - 30, `${this.tr + 1} OF ${ids.length}`, { color: 'mist' }); }\n    if (stdBack(app, ui)) return; ui.prompts([['lr', 'NEXT'], ['tabs', 'TAB'], ['back', 'BACK']]); } });\nexport const Theatre = () => scr('theatre', { set: 'theatre', music: 'replay',\n  draw(ui) { const app = ui.app, p = app.profile; ui.title('THEATRE'); statusStrip(app, ui); const last = app.lastReplay; if (ui.button('last', 10, 34, 240, 30, 'LAST RACE', { left: true, sub: last ? last.label || TRACKS[last.track].name : 'NOTHING HAS BEEN RECORDED TODAY', disabled: !last })) app.startReplay(last, { screen: 'theatre' });\n    for (let i = 0; i < 3; i++) { const s = p.replays[i], y = 68 + i * 34; if (ui.button(`slot${i}`, 10, y, 240, 30, `SLOT ${i + 1}`, { left: true, sub: s ? `${s.label || TRACKS[s.track].name}  DAY ${s.day}` : 'EMPTY', disabled: !s })) app.startReplay(app.unpackReplay(s), { screen: 'theatre' }); if (s && ui.focus === `slot${i}`) { ui.text(258, y + 10, 'INFO: DELETE', { color: 'mist' }); if (app.actions.pressed('info')) { p.replays.splice(i, 1); app.save(); } } }\n    if (stdBack(app, ui)) return; ui.prompts([['confirm', 'WATCH'], ['back', 'BACK']]); } });\nvoid TEST; void medalName;\nE\ncat > src/game/ui/screens/arcade.js <<'E'\n// The Arcade Gate: Quick Race, Time Trial, Couch Duel as big tiles, then two or three simple picker screens.\nimport { CAR_LIST, CARS } from '../../data/cars.js';\nimport { TRACKS } from '../../data/tracks.js';\nimport { quickRaceSetup, trialSetup, couchSetup } from '../../sim/setups.js';\nimport { drawMini } from './events.js';\nimport { specOf } from '../../sim/tuning.js';\nimport { scr, stdBack } from './common.js';\nconst TRACK_IDS = Object.keys(TRACKS);\nexport const Arcade = () => scr('arcade', { set: 'arcade', music: 'map',\n  draw(ui) { const app = ui.app; ui.title('ARCADE GATE', 'NO LICENCE REQUIRED. NO MONEY EITHER.'); const w = Math.min(130, Math.floor((ui.W - 40) / 3)), y = 70, h = 90; [['quick', 'QUICK RACE', 'ANY TRACK, ANY CAR'], ['trial', 'TIME TRIAL', 'YOU AND YOUR GHOST'], ['couch', 'COUCH DUEL', 'TWO PLAYERS, ONE TV']].forEach(([id, l, sub], i) => { const x = Math.round(ui.cx - (w * 3 + 16) / 2 + i * (w + 8)); if (ui.button(id, x, y, w, h, l, {})) { const cfg = { mode: id, track: 'kestrel', carId: 'ginga', car2: 'kite', laps: 2, field: 6, pace: 0.92, hour: null, rain: false, ai: 0 }; ui.push(TrackPick(cfg)); } ui.center; const t = sub; ui.hud.text(Math.round(x + (w - t.length * 6) / 2), y + h - 16, t.length * 6 > w - 4 ? t.slice(0, Math.floor((w - 4) / 6)) : t, { color: 'mist' }); }); if (stdBack(app, ui)) return; ui.prompts([['confirm', 'SELECT'], ['back', 'BACK']]); } });\nconst TrackPick = (cfg) => scr('picktrack', { set: 'arcade', music: 'map', idx: 0,\n  draw(ui) { const app = ui.app; ui.title('CHOOSE A CIRCUIT'); if (ui.leftRight) { this.idx = (this.idx + ui.leftRight + TRACK_IDS.length) % TRACK_IDS.length; app.mix.ui('tick'); } const id = TRACK_IDS[this.idx], T = TRACKS[id]; cfg.track = id; ui.panel(ui.cx - 110, 34, 220, 150); drawMini(ui, id, ui.cx - 55, 42, 110, 'sand'); ui.center(158, T.name, { color: 'white', scale: 1 }); ui.center(170, `< ${this.idx + 1} OF ${TRACK_IDS.length} >`, { color: 'mist' }); if (ui.button('next', ui.cx - 60, 192, 120, 24, 'THIS ONE')) ui.push(CarPick(cfg)); if (stdBack(app, ui)) return; ui.prompts([['lr', 'CHANGE'], ['confirm', 'NEXT'], ['back', 'BACK']]); } });\nconst CarPick = (cfg, which = 1) => scr('pickcar', { set: 'arcade', music: 'map', idx: CAR_LIST.findIndex((c) => c.id === (which === 1 ? cfg.carId : cfg.car2)), setArgs() { return { car: CAR_LIST[this.idx].id }; },\n  draw(ui) { const app = ui.app; ui.title(cfg.mode === 'couch' ? `PLAYER ${which}: CHOOSE A CAR` : 'CHOOSE A CAR'); if (ui.leftRight) { this.idx = (this.idx + ui.leftRight + CAR_LIST.length) % CAR_LIST.length; app.scene.showCarAt?.(CAR_LIST[this.idx].id); app.mix.ui('tick'); } const c = CAR_LIST[this.idx], s = specOf(c.id, {}); const x = ui.W - 170; ui.panel(x, 34, 160, 66); ui.text(x + 6, 40, c.shortName, { color: 'sand' }); ui.text(x + 6, 54, `${s.layout}  ${c.year}`, { color: 'white' }); ui.text(x + 6, 66, `${s.ps} PS`, { color: 'white' }); ui.text(x + 6, 78, `${s.kg.toLocaleString('en-US')} KG`, { color: 'white' }); ui.text(x + 6, 89, `< ${this.idx + 1} OF ${CAR_LIST.length} >`, { color: 'mist' });\n    if (ui.button('next', x, 110, 160, 24, 'THIS ONE')) { if (which === 1) cfg.carId = c.id; else cfg.car2 = c.id; if (cfg.mode === 'couch' && which === 1) ui.push(CarPick(cfg, 2)); else ui.push(Options(cfg)); }\n    if (stdBack(app, ui)) return; ui.prompts([['lr', 'CHANGE'], ['confirm', 'NEXT'], ['back', 'BACK']]); } });\nconst HOURS = [[null, 'USUAL HOUR'], [11, 'MORNING'], [18.5, 'DUSK'], [21, 'NIGHT']], DIFF = [[0.85, 'EASY'], [0.92, 'NORMAL'], [0.98, 'HARD']];\nconst Options = (cfg) => scr('pickoptions', { set: 'arcade', music: 'map', hi: 0, di: 1,\n  draw(ui) { const app = ui.app; ui.title('THE LAST FEW QUESTIONS'); const x = ui.cx - 110, w = 220; let y = 34, r = 0; const row = (id, label, val, adj) => { const f = ui.focus === id; ui.button(id, x, y, w, 22, `${label}: ${val}`, {}); if (f && ui.leftRight) { adj(ui.leftRight); app.mix.ui('tick'); } y += 25; r++; };\n    if (cfg.mode !== 'trial') row('laps', 'LAPS', cfg.laps, (d) => (cfg.laps = Math.max(1, Math.min(10, cfg.laps + d))));\n    if (cfg.mode === 'quick') { row('field', 'FIELD', cfg.field, (d) => (cfg.field = Math.max(2, Math.min(8, cfg.field + d)))); row('diff', 'PACE', DIFF[this.di][1], (d) => { this.di = (this.di + d + 3) % 3; cfg.pace = DIFF[this.di][0]; }); }\n    if (cfg.mode === 'couch') row('ai', 'AI CARS', cfg.ai, (d) => (cfg.ai = Math.max(0, Math.min(4, cfg.ai + d))));\n    row('hour', 'HOUR', HOURS[this.hi][1], (d) => { this.hi = (this.hi + d + 4) % 4; cfg.hour = HOURS[this.hi][0]; }); row('rain', 'RAIN', cfg.rain ? 'YES' : 'NO', () => (cfg.rain = !cfg.rain));\n    if (ui.button('go', x, y + 4, w, 26, 'GO', { color: 'lime' })) this.go(app, cfg);\n    if (stdBack(app, ui)) return; ui.prompts([['lr', 'CHANGE'], ['confirm', 'GO'], ['back', 'BACK']]); },\n  go(app, c) { const h = c.hour ?? undefined; if (c.mode === 'quick') app.startRace(quickRaceSetup({ ...c, hour: h, seed: (app.profile?.day ?? 1) * 7 + c.laps })); if (c.mode === 'trial') app.startRace(trialSetup({ ...c, hour: h })); if (c.mode === 'couch') app.startCouch(couchSetup({ track: c.track, car1: c.carId, car2: c.car2, laps: c.laps, ai: c.ai, hour: h, rain: c.rain, pace: 0.9 })); },\n});\nvoid CARS;\nE\ncat > src/game/ui/screens/settings.js <<'E'\n// Settings, Handbook, About.\nimport { HANDBOOK, CONTROLS_TEXT } from '../../data/text.js';\nimport { scr, stdBack } from './common.js';\nimport { wrap } from '../ui.js';\nimport { ABOUT } from '../../data/about.gen.js';\nimport { TITLE } from '../../data/meta.js';\nconst LOOKS = [['none', 'NATIVE'], ['playstation', 'PLAYSTATION'], ['arcade', 'ARCADE'], ['vhs_rental', 'VHS RENTAL'], ['no_filters', 'NO FILTERS']];\nexport const Settings = () => scr('settings', { tab: 0, overlay: true,\n  draw(ui) { const app = ui.app, s = app.settings, audio = app.mix.audio, a = app.actions; if (app.inRace?.()) ui.hud.rect(0, 0, ui.W, ui.H, 'ink'); ui.title('SETTINGS'); ui.tabs(26, ['SOUND', 'PICTURE', 'CONTROLS', 'ASSISTS'], this.tab, (i) => (this.tab = i)); const x = ui.cx - 130, w = 260; let y = 46; const pct = (v) => `${Math.round(v * 100)}%`;\n    const vol = (id, label, val, set) => { ui.slider(id, x, y, w, label, val, 0, 1, 0.05, set, { format: pct }); y += 22; };\n    const opt = (id, label, val, adj, cb) => { const f = ui.focus === id; if (ui.button(id, x, y, w, 19, `${label}: ${val}`, {}) && cb) cb(); if (f && ui.leftRight) { adj(ui.leftRight); app.mix.ui('tick'); app.saveSettings(); } y += 22; };\n    if (this.tab === 0) { vol('master', 'MASTER', audio.volume.master, (v) => audio.setVolume('master', v)); vol('sfx', 'EFFECTS', audio.volume.sfx, (v) => audio.setVolume('sfx', v)); vol('music', 'MUSIC', audio.volume.music, (v) => { audio.setVolume('music', v); s.musicSet = true; app.saveSettings(); }); vol('voices', 'VOICES', s.voices, (v) => { s.voices = v; app.saveSettings(); }); opt('racemusic', 'MUSIC IN RACES', s.raceMusic === false ? 'OFF' : 'ON', () => (s.raceMusic = s.raceMusic === false), () => { s.raceMusic = s.raceMusic === false; app.saveSettings(); }); if (!audio.unlocked) ui.center(y + 2, 'PRESS A KEY OR CLICK FOR SOUND', { color: 'orange' }); }\n    if (this.tab === 1) { const e = app.ctx.engine, cur = e.settings.values, li = Math.max(0, LOOKS.findIndex(([k]) => k === (cur.look ?? 'none'))); opt('pixel', 'PIXEL SIZE', (cur.pixelSize ?? 'fine').toUpperCase(), () => e.settings.set({ pixelSize: cur.pixelSize === 'chunky' ? 'fine' : 'chunky' }), () => e.settings.set({ pixelSize: cur.pixelSize === 'chunky' ? 'fine' : 'chunky' })); opt('look', 'LOOK', LOOKS[li][1], (d) => { const n = LOOKS[(li + d + LOOKS.length) % LOOKS.length][0]; e.settings.set({ look: n === 'none' ? undefined : n }); }, () => { const n = LOOKS[(li + 1) % LOOKS.length][0]; e.settings.set({ look: n === 'none' ? undefined : n }); }); const Q = ['auto', 'low', 'medium', 'high'], qi = Math.max(0, Q.indexOf(cur.quality ?? 'auto')); opt('quality', 'QUALITY', Q[qi].toUpperCase(), (d) => e.settings.set({ quality: Q[(qi + d + 4) % 4] }), () => e.settings.set({ quality: Q[(qi + 1) % 4] })); const F = [60, 30, 0], fi = Math.max(0, F.indexOf(cur.fps ?? 60)); opt('fps', 'FRAME CAP', F[fi] ? `${F[fi]}` : 'DISPLAY', (d) => e.settings.set({ fps: F[(fi + d + 3) % 3] }), () => e.settings.set({ fps: F[(fi + 1) % 3] })); opt('fullscreen', 'FULLSCREEN', typeof document !== 'undefined' && document.fullscreenElement ? 'ON' : 'OFF', () => app.toggleFullscreen(), () => app.toggleFullscreen()); }\n    if (this.tab === 2) { opt('glyphs', 'BUTTON GLYPHS', s.glyphs === 'xbox' ? 'XBOX' : 'PLAYSTATION', () => (s.glyphs = s.glyphs === 'xbox' ? 'ps' : 'xbox'), () => { s.glyphs = s.glyphs === 'xbox' ? 'ps' : 'xbox'; app.saveSettings(); }); opt('vib', 'VIBRATION', s.vibration === false ? 'OFF' : 'ON', () => (s.vibration = s.vibration === false), () => { s.vibration = s.vibration === false; app.saveSettings(); }); ui.slider('curve', x, y, w, 'STEERING RESPONSE', s.steerCurve, 1, 2, 0.1, (v) => { s.steerCurve = v; app.saveSettings(); }, { format: (v) => (v <= 1.05 ? 'DIRECT' : v >= 1.95 ? 'GENTLE' : v.toFixed(1)) }); y += 22; opt('mousesteer', 'MOUSE STEERING', s.mouseSteer ? 'ON' : 'OFF', () => (s.mouseSteer = !s.mouseSteer), () => { s.mouseSteer = !s.mouseSteer; app.saveSettings(); }); opt('units', 'UNITS', s.units === 'mph' ? 'MPH' : 'KM/H', () => (s.units = s.units === 'mph' ? 'kmh' : 'mph'), () => { s.units = s.units === 'mph' ? 'kmh' : 'mph'; app.saveSettings(); }); }\n    if (this.tab === 3) { const as = app.assistsTarget(); opt('abs', 'ABS', as.abs ? 'ON' : 'OFF', () => (as.abs = !as.abs), () => { as.abs = !as.abs; app.save(); }); ui.slider('tcs', x, y, w, 'TRACTION CONTROL', as.tcs, 0, 10, 1, (v) => { as.tcs = v; app.save(); }, { format: (v) => `${Math.round(v)}`, dflt: 5 }); y += 22; ui.slider('asm', x, y, w, 'STABILITY CONTROL', as.asm, 0, 10, 1, (v) => { as.asm = v; app.save(); }, { format: (v) => `${Math.round(v)}`, dflt: 5 }); y += 22; opt('auto', 'GEARS', as.auto ? 'AUTOMATIC' : 'MANUAL', () => (as.auto = !as.auto), () => { as.auto = !as.auto; app.save(); }); opt('line', 'DRIVING LINE', as.line ? 'ON' : 'OFF', () => (as.line = !as.line), () => { as.line = !as.line; app.save(); }); }\n    if (!app.session) { if (ui.button('reset', x, ui.H - 44, 126, 18, 'RESET DEFAULTS')) { app.resetSettings(); ui.toast('RESET. THE MUSIC IS AT 10% AGAIN.'); } if (ui.button('about', x + 134, ui.H - 44, 126, 18, 'ABOUT')) ui.push(About()); }\n    void a; if (stdBack(app, ui)) return; ui.prompts([['confirm', 'SELECT'], ['lr', 'CHANGE'], ['tabs', 'TAB'], ['back', 'BACK']]); } });\nexport const Handbook = () => scr('handbook', { overlay: false, page: 0,\n  draw(ui) { const app = ui.app; ui.hud.rect(0, 0, ui.W, ui.H, 'night'); ui.title('THE HANDBOOK'); if (ui.leftRight || app.actions.pressed('tabR') || app.actions.pressed('tabL')) { const d = ui.leftRight || (app.actions.pressed('tabR') ? 1 : -1); this.page = (this.page + d + HANDBOOK.length) % HANDBOOK.length; app.mix.ui('tick'); } const pg = HANDBOOK[this.page]; ui.item('page', ui.cx - 180, 40, 360, 100); ui.panel(ui.cx - 180, 40, 360, 140); ui.center(48, pg.title, { color: 'sand' }); const lines = pg.controls ? CONTROLS_TEXT[app.actions.device === 'pad' ? 'pad' : 'kb'] : pg.lines; lines.forEach((l, i) => ui.hud.text(ui.cx - 174, 66 + i * 16, l, { color: 'white' })); ui.center(162, `PAGE ${this.page + 1} OF ${HANDBOOK.length}`, { color: 'mist' }); if (stdBack(app, ui)) return; ui.prompts([['lr', 'PAGE'], ['back', 'BACK']]); } });\nfunction aboutPages() {\n  const pages = [], paged = (title, rows) => { let cur = []; let lines = 0; for (const [k, v] of rows) { const body = wrap(`${k ? `${k}: ` : ''}${v}`, 60); if (lines + body.length > 14 && cur.length) { pages.push({ title, lines: cur }); cur = []; lines = 0; } cur.push(...body, ''); lines += body.length + 1; } if (cur.length) pages.push({ title, lines: cur }); };\n  const si = ABOUT.exit.sourceInformation; paged('SOURCE INFORMATION', [['DATE', si.date], ['SOURCE', si.source], ['PLAN', si.plan], ['GENRE', si.genre], ['PERSPECTIVE', si.perspective], ['TECH', si.tech], ['ART DIRECTION', si.artDirection], ['ANIMATION', si.animation], ['AUDIO', si.audio], ['ONLINE', si.online], ['TESTING', si.testing], ['RESEARCH', si.research], ['ENVIRONMENT', si.environment], ['MODEL', si.model], ['USAGE', si.usage]]);\n  const Q = { 'TESTING FEEDBACK': ['How many issues did testing catch?', 'How many would be considered critical issues / game breaking?', 'What was the most helpful test you ran?', 'What was the least helpful test you ran?'], 'ENGINE FEEDBACK': ['What did you like most about the engine?', 'Did you get stuck or guess wrong?', 'What was the most important thing you had to build yourself?', 'What was the hardest part about using the engine?', 'What did you change in the engine, and why? (none if nothing)', 'If you could change one thing about the engine, what would it be?'], 'PROMPT FEEDBACK': ['What did you like most about this prompt?', 'What was confusing?', 'What was the hardest thing to do?', 'What would you change in this prompt?'] };\n  const ans = { 'TESTING FEEDBACK': ABOUT.exit.testingFeedback, 'ENGINE FEEDBACK': ABOUT.exit.engineFeedback, 'PROMPT FEEDBACK': ABOUT.exit.promptFeedback };\n  for (const t of Object.keys(Q)) paged(t, Q[t].map((q, i) => ['', `${q} ${ans[t][i] ?? 'unknown'}`]));\n  pages.push({ title: 'CREDITS', lines: [TITLE, ...wrap(`INSPIRED BY ${si.source}. AN ORIGINAL GAME: NO REAL CARS, CIRCUITS, LOGOS OR MUSIC FROM IT ARE USED.`, 60), '', ...wrap('MADE BY CLAUDE (ANTHROPIC) FROM A PLAN, FOR MICHAEL CROSATO.', 60), '', ...wrap(`PIXEL ENGINE ${ABOUT.engineVersion}. THREE.JS R186 (MIT). RAPIER (APACHE-2.0). SWEETIE 16 PALETTE BY GRAFXKID.`, 60), '', 'THE KIT\\'S CREDITS FILE FOLLOWS.'] });\n  const cr = ABOUT.credits.split('\\n').flatMap((l) => (l.trim() ? wrap(l.replace(/[#*`|]/g, ' ').replace(/\\s+/g, ' ').trim(), 60) : []));\n  for (let i = 0; i < cr.length; i += 15) pages.push({ title: 'CREDITS FILE', lines: cr.slice(i, i + 15), scroll: true });\n  return pages;\n}\nlet cachedPages = null;\nexport const About = () => scr('about', { page: 0, onEnter() { cachedPages ??= aboutPages(); },\n  draw(ui) { const app = ui.app, pages = cachedPages; ui.hud.rect(0, 0, ui.W, ui.H, 'night'); ui.title('ABOUT'); ui.right(ui.W - 10, 8, `PAGE ${this.page + 1} OF ${pages.length}`, { color: 'mist' }); let d = ui.leftRight; if (app.actions.pressed('tabR')) d = 10; if (app.actions.pressed('tabL')) d = -10; if (app.actions.pressed('down')) d = 1; if (app.actions.pressed('up')) d = -1; if (app.actions.wheel) d = app.actions.wheel > 0 ? 1 : -1; if (d) { this.page = Math.max(0, Math.min(pages.length - 1, this.page + d)); app.mix.ui('tick'); } const pg = pages[this.page]; ui.item('page', 8, 26, ui.W - 16, ui.H - 46); ui.text(ui.cx - 180, 30, pg.title, { color: 'sand' }); pg.lines.slice(0, 15).forEach((l, i) => ui.hud.text(ui.cx - 180, 42 + i * 13, l, { color: 'white' })); if (stdBack(app, ui)) return; ui.prompts([['lr', 'PAGE'], ['tabs', 'FAR'], ['back', 'BACK']]); },\n  allText() { return (cachedPages ??= aboutPages()).flatMap((p) => [p.title, ...p.lines]).join('\\n'); } });\nE\ncat > src/game/ui/screens/race.js <<'E'\n// Over a race: pause, results, the licence result, assists. Results also return after a replay, so they read app.lastResult.\nimport { fmtTime, fmtCr, wrap } from '../ui.js';\nimport { CARS } from '../../data/cars.js';\nimport { TEST, LICENCE } from '../../data/licences.js';\nimport { EVENT } from '../../data/events.js';\nimport { TRACKS } from '../../data/tracks.js';\nimport { scr, stdBack } from './common.js';\nimport { LINES } from '../../data/text.js';\nimport { medalName } from '../../sim/career.js';\nimport { medalIcon } from './licence.js';\nimport { licenceSetup } from '../../sim/setups.js';\nimport { SPEAKERS } from '../../audio/voice.js';\nconst dim = (ui) => { ui.hud.rect(0, 0, ui.W, ui.H, 'ink'); };\nexport const Pause = (scene) => scr('pause', { overlay: false, onEnter(app) { app.paused = true; }, leave(app) { if (app.ui.stack.length <= 1) app.paused = false; },\n  draw(ui) { const app = ui.app, sim = scene.sim, W = 160, x = ui.cx - W / 2; ui.panel(x, 34, W, 202, 'ink', 'slate'); ui.center(40, 'PAUSED', { color: 'sand', scale: 2 }); const mode = scene.setup.mode; const items = [['resume', 'RESUME'], ['restart', 'RESTART'], ['retire', mode === 'testdrive' ? 'END DRIVE' : 'RETIRE'], ['assists', 'ASSISTS'], ['settings', 'SETTINGS'], ['handbook', 'HANDBOOK']]; if (mode === 'trial') items.push(['pass', 'PASS THE PAD']); items.push(['dev', 'DEV MODE']);\n    items.forEach(([id, l], i) => { if (ui.button(id, x + 12, 60 + i * 21, W - 24, 18, l)) this.pick(app, id, scene); });\n    if (scene.trial) { const t = scene.trial; ui.text(x + 12, 60 + items.length * 21, `D1 ${fmtTime(t.drivers[0])}`, { color: t.driver === 0 ? 'lime' : 'mist' }); ui.text(x + 12, 70 + items.length * 21, `D2 ${fmtTime(t.drivers[1])}`, { color: t.driver === 1 ? 'lime' : 'mist' }); }\n    void sim;\n    if (app.actions.pressed('pause') || ui.backHit) { ui.backHit = false; ui.pop(); app.paused = false; return; } ui.prompts([['confirm', 'SELECT'], ['back', 'RESUME']]); },\n  pick(app, id, sc) { const ui = app.ui; if (id === 'resume') { ui.pop(); app.paused = false; } if (id === 'restart') { app.paused = false; ui.clearStack(); app.restartRace(sc); } if (id === 'retire') { app.paused = false; ui.clearStack(); app.retire(sc); } if (id === 'assists') { const s = app.screens.Settings(); s.tab = 3; ui.push(s); } if (id === 'settings') ui.push(app.screens.Settings()); if (id === 'handbook') ui.push(app.screens.Handbook()); if (id === 'dev') ui.push(app.screens.Dev(sc)); if (id === 'pass') { sc.trial.driver = 1 - sc.trial.driver; ui.pop(); app.paused = false; app.restartTrialLap(sc); } },\n});\nexport const Results = () => scr('results', { t: 0, shown: 0,\n  onEnter(app) { const R = app.lastResult; this.t = 0; this.shown = 0; if (R.outcome) { const o = R.outcome; app.mix.ui(o.place === 1 ? 'fanfare2' : 'medal'); const line = o.place === 1 ? LINES.dellWin : o.place <= 3 ? LINES.dellPodium : LINES.dellOther; app.ui.say(R.recordLap ? LINES.dellLap.replace('Kestrel Park', TRACKS[R.setup.track].name).replace('One minute, fifty-one', fmtTime(R.recordLap)) : line, SPEAKERS.dell, { time: 5 }); } },\n  draw(ui, dt) { const app = ui.app, R = app.lastResult, o = R.outcome; this.t += dt; if (!ui.app.inRace?.()) ui.hud.rect(0, 0, 0, 0, 'ink'); const W = Math.min(340, ui.W - 16), x = Math.round(ui.cx - W / 2), rows = R.rows.slice(0, 8); ui.panel(x, 8, W, 26 + rows.length * 13 + 42, 'ink', 'slate'); ui.center(12, R.setup.label || 'RESULTS', { color: 'sand' }); const y0 = 24; rows.forEach((r, i) => { const y = y0 + i * 13, c = r.player || r.seat >= 0 ? 'lime' : 'white', showT = this.t > i * 0.12; if (!showT) return; if (r.player) ui.hud.rect(x + 2, y - 1, W - 4, 11, 'navy'); ui.text(x + 5, y, `${i + 1}`, { color: 'sand' }); ui.text(x + 18, y, r.name.slice(0, 12), { color: c }); ui.text(x + 100, y, CARS[r.carId]?.shortName.slice(0, 12) ?? '', { color: 'mist' }); ui.right(x + W - 6, y, `${r.estimated ? '~' : ''}${fmtTime(r.time)}`, { color: c }); });\n    const by = y0 + rows.length * 13 + 2; if (o) { const money = Math.min(o.money + o.bonus, Math.round(((o.money + o.bonus) * Math.max(0, this.t - 1)) / 1.2)); if (money !== this.shown && Math.floor(this.t * 12) % 2 === 0) app.mix.play('countTick'); if (money === o.money + o.bonus && this.shown !== money && money > 0) app.mix.ui('register'); this.shown = money; ui.text(x + 6, by, `+${fmtCr(money)}`, { color: 'lime', scale: 1 }); ui.text(x + 120, by, `+${o.points} POINTS`, { color: 'sand' }); const top = o.seriesOver ? (o.seriesWon ? 'SERIES WON' : 'SERIES LOST. YOU MAY ENTER AGAIN') : `STANDING ${1 + o.standings.findIndex(([k]) => k === 'player')}`; ui.right(x + W - 6, by, top, { color: o.seriesWon ? 'lime' : 'white' }); } else ui.text(x + 6, by, R.setup.mode === 'couch' ? `WINNER: ${R.rows[0].name}` : 'THE ARCADE PAYS NO CREDITS.', { color: 'mist' });\n    const bw = Math.floor((W - 20) / 4), byy = by + 12, bx = (i) => x + 5 + i * (bw + 3); if (ui.button('continue', bx(0), byy, bw, 18, 'CONTINUE')) { ui.subtitle = null; app.continueAfterResult(); return; } if (ui.button('retry', bx(1), byy, bw, 18, 'RETRY')) { ui.subtitle = null; app.retryResult(); return; } if (ui.button('watch', bx(2), byy, bw, 18, 'REPLAY', { disabled: !R.replay })) { ui.subtitle = null; app.watchResult(); return; } if (ui.button('save', bx(3), byy, bw, 18, R.saved ? 'SAVED' : 'SAVE', { disabled: !R.replay || R.saved })) { const ok = app.saveReplay(R.replay); if (ok) { R.saved = true; ui.toast('THE REPLAY IS SAVED.'); } else ui.toast('NO ROOM. THE THEATRE IS FULL.', 'orange'); } ui.prompts([['confirm', 'SELECT']]); ui.backHit = false; } });\nexport const LicenceResult = () => scr('licenceresult', { t: 0, onEnter(app) { const R = app.lastResult, o = R.outcome; const m = o.medal; app.mix.ui(m ? 'medal' : 'fail'); app.ui.say(m === 3 ? LINES.aiGold : m === 2 ? LINES.aiSilver : m === 1 ? LINES.aiBronze : R.reason === 'THE BOX HAS NOT MOVED' ? LINES.aiFail : LINES.aiFail2, SPEAKERS.arai, { time: 4.5 }); },\n  draw(ui, dt) { const app = ui.app, R = app.lastResult, o = R.outcome, t = TEST[R.testId], W = 320, x = Math.round(ui.cx - W / 2); this.t += dt; ui.panel(x, 18, W, 150, 'ink', 'slate'); ui.center(24, `${t.id}  ${t.title}`, { color: 'sand' }); if (o.medal) { const iconSc = 3; medalIcon(ui, x + 12, 42, o.medal, iconSc); ui.text(x + 44, 44, medalName(o.medal), { scale: 2, color: ['', 'orange', 'mist', 'sand'][o.medal] }); } else { ui.text(x + 12, 44, R.reason ?? 'NOT THIS TIME', { color: 'orange', scale: R.reason && R.reason.length > 20 ? 1 : 2 }); } ui.text(x + 12, 72, `TIME ${R.failed ? '--:--.--' : fmtTime(R.time)}${R.hits ? `  INCL. +${R.hits} S` : ''}`, { color: 'white' }); const next = o.medal === 3 ? null : o.medal === 2 ? ['GOLD', t.medals.gold] : o.medal === 1 ? ['SILVER', t.medals.silver] : ['BRONZE', t.medals.bronze]; if (next && !R.failed) ui.text(x + 12, 84, `${next[0]} IS ${(R.time - next[1]).toFixed(2)} S AWAY`, { color: 'mist' }); else if (next) ui.text(x + 12, 84, `${next[0]} IS ${fmtTime(next[1])}`, { color: 'mist' });\n    if (o.licenceWon) { ui.text(x + 12, 98, `LICENCE ${o.licenceWon} WON. +${o.reward.toLocaleString('en-US')} CR`, { color: 'lime' }); } if (o.goldBonus) ui.text(x + 12, 110, wrap(`ALL GOLD: ${LICENCE[o.goldBonus].goldLine}`, 50)[0], { color: 'sand' }); if (app.profile.failStreak[R.testId] >= 3 && !app.profile.assists.line) { if (ui.button('line', x + 12, 120, W - 24, 15, 'PAINT THE DRIVING LINE')) { app.profile.assists.line = true; app.save(); ui.say(LINES.aiLine, SPEAKERS.arai); } }\n    const bw = Math.floor((W - 20) / 4), y = 142, bx = (i) => x + 5 + i * (bw + 3); if (ui.button('retry', bx(0), y, bw, 20, 'RETRY')) { ui.subtitle = null; app.startRace(licenceSetup(R.testId, 0)); return; } if (ui.button('watch', bx(1), y, bw, 20, 'REPLAY', { disabled: !R.replay })) { ui.subtitle = null; app.watchResult(); return; } if (ui.button('demo', bx(2), y, bw, 20, 'DEMO')) { ui.subtitle = null; app.startRace(licenceSetup(R.testId, 0, { demo: true })); return; } if (ui.button('back', bx(3), y, bw, 20, 'BACK')) { ui.subtitle = null; app.continueAfterResult(); return; } if (ui.backHit) { ui.backHit = false; ui.subtitle = null; app.continueAfterResult(); return; } ui.prompts([['confirm', 'SELECT'], ['back', 'BACK']]); } });\nvoid EVENT; void stdBack; void dim;\nE\ncat >> ../PROGRESS.md <<'E'\n- screens tuning, garage, arcade, settings, race written. Remaining: ui/screens/podium.js, dev/devmode.js, scenes/menu.js, scenes/replay.js, attract/director.js, net/hub.js, net/couch.js, app.js, main.js, tools/build.mjs, tools/test.mjs + suites, docs/adding-content.md, exit-interview.json.\nE","description":"Write tuning, garage, arcade, settings and race screens"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16974,"cache_read_input_tokens":371011,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16974},"output_tokens":71,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c060cbf0-9de2-4b69-aed6-69ef0ff7f0ee","uuid":"0c263b3a-bbd5-46b5-9125-9b988799f2ae","timestamp":"2026-11-06T00:50:44.896Z","request_id":"req_011CgkkfkyVgq1Luor8viHrP","wire_tool_inputs":{"toolu_01U5PLHaaNN3v7jYjc3ZbsR4":{"command":"cat > src/game/ui/screens/tuning.js <<'E'\n// Tuning Street: eight tiles, four to a page; in a tile up to five parts; the Setup tab; the dyno. Service Bay: oil and soap.\nimport { CATEGORIES, PARTS, SETTINGS, PART, OIL_PRICE, WASH_PRICE, PAINT_PRICE, RIM_PRICE } from '../../data/parts.js';\nimport { TYRES } from '../../data/tyres.js';\nimport { PAINTS, RIMS, CARS } from '../../data/cars.js';\nimport { carRec, canBuyPart, buyPart, buyTyre, buyPaint, buyRims, partOwned, partSuperseded, changeOil, washCar, oilFactor } from '../../sim/career.js';\nimport { specOf, dynoCurve } from '../../sim/tuning.js';\nimport { torqueShape } from '../../sim/sim.js';\nimport { testDriveSetup } from '../../sim/setups.js';\nimport { LINES } from '../../data/text.js';\nimport { scr, stdBack, statusStrip } from './common.js';\nimport { fmtCr } from '../ui.js';\nimport { SPEAKERS } from '../../audio/voice.js';\nconst BEN = SPEAKERS.benno;\nconst specLine = (a, b) => { const parts = []; if (a.ps !== b.ps) parts.push(`${a.ps} > ${b.ps} PS`); if (a.kg !== b.kg) parts.push(`${a.kg} > ${b.kg} KG`); return parts.join('  '); };\nexport const Tuning = () => scr('tuning', { set: 'tuning', music: 'tuning', tab: 0, page: 0, setArgs(app) { const r = carRec(app.profile); return { car: r.id, install: r.install, dirt: r.dirt }; },\n  draw(ui) { const app = ui.app, p = app.profile, r = carRec(p), a = app.actions, s = specOf(r.id, r.install); ui.title('TUNING STREET'); statusStrip(app, ui); ui.tabs(26, ['PARTS', 'SETUP'], this.tab, (i) => (this.tab = i)); ui.text(ui.W - 170, 30, `${CARS[r.id].shortName}  ${s.ps} PS  ${s.kg} KG`, { color: 'white' });\n    if (this.tab === 0) { const per = 4, list = CATEGORIES.slice(this.page * per, this.page * per + per); list.forEach((c, i) => { const x = 10 + (i % 2) * 112, y = 46 + Math.floor(i / 2) * 62; if (ui.button(c.id, x, y, 106, 56, c.name, { sub: '' })) ui.push(c.id === 'body' ? BodyTile() : c.id === 'tyres' ? TyreTile() : PartTile(c.id)); }); const cur = CATEGORIES.find((c) => c.id === ui.focus); if (cur) ui.para(10, 174, cur.line, 40, { color: 'mist' }); if (ui.button('morepage', 10, 196, 106, 18, this.page ? 'FIRST FOUR' : 'NEXT FOUR')) { this.page = 1 - this.page; ui.focus = null; } if (ui.button('drive', 122, 196, 106, 18, 'TEST DRIVE')) this.drive(app, r); }\n    else { const avail = SETTINGS.filter((x) => x.needs(r.install.parts)); if (!avail.length) ui.para(10, 50, 'NO SETTINGS YET. A RACE GEARBOX, LSD, SUSPENSION, BRAKE KIT OR BIG WING WILL EACH ADD ONE.', 40, { color: 'mist' }); avail.slice(0, 5).forEach((st, i) => { const v = r.install.settings[st.id] ?? st.def; ui.slider(st.id, 10, 46 + i * 24, 222, st.name, v, st.min, st.max, (st.max - st.min) / 20, (nv) => { r.install.settings[st.id] = nv; app.save(); }, { format: (x) => (x < (st.min + st.max) / 2 ? st.lo : x > (st.min + st.max) / 2 ? st.hi : 'MIDDLE'), dflt: st.def, h: 20 }); }); const cur = avail.find((x) => x.id === ui.focus); if (cur) ui.para(10, 172, cur.line, 40, { color: 'mist' }); if (ui.button('drive', 122, 196, 106, 18, 'TEST DRIVE')) this.drive(app, r); }\n    if (a.pressed('alt')) this.drive(app, r);\n    if (stdBack(app, ui)) return; ui.prompts([['confirm', 'SELECT'], ['alt', 'DRIVE'], ['tabs', 'TAB'], ['back', 'BACK']]); },\n  drive(app, r) { app.startRace(testDriveSetup(r.id, r.install, { screen: 'tuning' })); },\n});\nexport const PartTile = (cat) => scr('parts', { set: 'tuning', music: 'tuning',\n  draw(ui) { const app = ui.app, p = app.profile, r = carRec(p), c = CATEGORIES.find((x) => x.id === cat), before = specOf(r.id, r.install), list = PARTS.filter((x) => x.cat === cat); ui.title(c.name); statusStrip(app, ui);\n    list.forEach((pt, i) => { const owned = partOwned(r, pt), sup = partSuperseded(r, pt), can = canBuyPart(p, r, pt), y = 28 + i * 31; if (ui.button(pt.id, 10, y, 226, 28, pt.name, { left: true, sub: owned ? 'FITTED' : sup ? 'YOU HAVE BETTER' : fmtCr(pt.price), disabled: !can.ok, subColor: owned ? 'lime' : p.credits >= pt.price ? 'mist' : 'orange' })) { const prevInstall = JSON.parse(JSON.stringify(r.install)); if (buyPart(p, r, pt.id)) { app.save(); app.mix.ui('register'); app.scene.partFitted?.(r); if (cat === 'engine') { ui.say(LINES.bennoEngine, BEN); ui.push(DynoScreen(prevInstall, r)); } else ui.say(cat === 'aero' && pt.id === 'wing' ? LINES.bennoWing : cat === 'brakes' ? LINES.bennoBrakes : cat === 'weight' ? LINES.bennoWeight : LINES.bennoGeneric, BEN); } } });\n    const cur = PART[ui.focus]; if (cur) { const wx = 246, w = Math.min(ui.W - wx - 8, 200); ui.panel(wx, 30, w, 66); ui.para(wx + 6, 36, cur.line, Math.floor((w - 12) / 6), { color: 'white' }); const inst = JSON.parse(JSON.stringify(r.install)); inst.parts[cur.slot] = cur.level; const line = specLine(before, specOf(r.id, inst)); ui.text(wx + 6, 84, line || 'NO NUMBER CHANGES. YOU WILL FEEL IT.', { color: 'lime' }); }\n    if (stdBack(app, ui)) return; ui.prompts([['confirm', 'BUY'], ['back', 'BACK']]); } });\nexport const TyreTile = () => scr('tyres', { set: 'tuning', music: 'tuning',\n  draw(ui) { const app = ui.app, p = app.profile, r = carRec(p); ui.title('TYRES'); statusStrip(app, ui); TYRES.forEach((t, i) => { const owned = r.install.tyre === t.id, y = 28 + i * 31; if (ui.button(t.id, 10, y, 226, 28, t.name, { left: true, sub: owned ? 'FITTED' : fmtCr(t.price), disabled: owned || p.credits < t.price, subColor: owned ? 'lime' : 'mist' })) { if (buyTyre(p, r, t.id)) { app.save(); app.mix.ui('register'); ui.say(LINES.bennoTyres, BEN); } } }); const cur = TYRES.find((t) => t.id === ui.focus); if (cur) { const wx = 246, w = Math.min(ui.W - wx - 8, 200); ui.panel(wx, 30, w, 66); ui.para(wx + 6, 36, cur.line, Math.floor((w - 12) / 6), { color: 'white' }); ui.text(wx + 6, 72, `GRIP ${cur.tyreMu.toFixed(2)}  DIRT ${cur.dirt.toFixed(2)}`, { color: 'lime' }); ui.text(wx + 6, 84, `WEAR X${cur.wearX.toFixed(1)}`, { color: 'sand' }); } if (stdBack(app, ui)) return; ui.prompts([['confirm', 'BUY'], ['back', 'BACK']]); } });\nexport const BodyTile = () => scr('body', { set: 'tuning', music: 'tuning', tab: 0,\n  draw(ui) { const app = ui.app, p = app.profile, r = carRec(p); ui.title('BODY'); statusStrip(app, ui); ui.tabs(26, ['PAINT', 'RIMS'], this.tab, (i) => (this.tab = i));\n    if (this.tab === 0) { PAINTS.forEach((c, i) => { const x = 10 + (i % 4) * 34, y = 46 + Math.floor(i / 4) * 30, id = `p${c}`; ui.hud.rect(x, y, 30, 26, c); if (r.install.paint === c) ui.hud.rect(x + 11, y + 9, 8, 8, 'white'); if (ui.item(id, x, y, 30, 26, { label: c })) { if (buyPaint(p, r, c)) { app.save(); app.mix.ui('register'); app.scene.partFitted?.(r); ui.toast('PAINT APPLIED. IT IS STILL WET.'); } } }); ui.text(10, 172, `PAINT ${fmtCr(PAINT_PRICE)}`, { color: 'mist' }); }\n    else { RIMS.forEach((m, i) => { const y = 46 + i * 28; if (ui.button(`rim${i}`, 10, y, 136, 24, m.name, { left: true, disabled: r.install.rims === i })) { if (buyRims(p, r, i)) { app.save(); app.mix.ui('register'); app.scene.partFitted?.(r); } } ui.hud.rect(122, y + 4, 16, 16, m.hub); ui.hud.rect(128, y + 2, 4, 20, m.spoke); }); ui.text(10, 172, `RIMS ${fmtCr(RIM_PRICE)}`, { color: 'mist' }); }\n    if (stdBack(app, ui)) return; ui.prompts([['confirm', 'BUY'], ['tabs', 'TAB'], ['back', 'BACK']]); } });\nexport const DynoScreen = (before, rec) => scr('dyno', { set: 'tuning', music: 'tuning', t: 0, onEnter(app) { this.a = dynoCurve(rec.id, before, torqueShape); this.b = dynoCurve(rec.id, rec.install, torqueShape); app.scene.dynoStart?.(); this.t = 0; },\n  draw(ui, dt) { const app = ui.app; this.t += dt; ui.title('DYNO'); const x = 14, y = 34, w = 196, h = 118, peak = Math.max(this.b.peak, this.a.peak) * 1.05, f = Math.min(1, this.t / 4); ui.panel(x - 4, y - 4, w + 8, h + 20); for (let i = 1; i < 4; i++) ui.hud.rect(x, y + (h * i) / 4, w, 1, 'night');\n    const plot = (cv, col, frac) => { const n = Math.floor(cv.curve.length * frac); for (let i = 0; i < n; i++) { const q = cv.curve[i], px = x + Math.round((i / (cv.curve.length - 1)) * (w - 2)), py = y + h - Math.round((q.ps / peak) * h); ui.hud.rect(px, py, 2, 2, col); } };\n    plot(this.a, 'mist', 1); plot(this.b, 'lime', f);\n    ui.text(x, y + h + 3, `BEFORE ${Math.round(this.a.peak)} PS`, { color: 'mist' }); if (f >= 1) ui.right(x + w, y + h + 3, `NOW ${Math.round(this.b.peak)} PS`, { color: 'lime' });\n    const rpm = 1500 + (this.b.redline - 1500) * f; app.scene.dynoFrame?.(rpm, f < 1 ? 1 : 0.1, dt, rec);\n    if (ui.button('ok', ui.W - 120, ui.H - 46, 110, 22, f < 1 ? 'SKIP' : 'CONTINUE')) { if (f < 1) this.t = 99; else { app.scene.dynoEnd?.(); ui.pop(); return; } }\n    if (stdBack(app, ui, () => { app.scene.dynoEnd?.(); ui.pop(); })) return; ui.prompts([['confirm', 'CONTINUE'], ['back', 'BACK']]); } });\nexport const Service = () => scr('service', { set: 'service', music: 'service', setArgs(app) { const r = carRec(app.profile); return { car: r.id, install: r.install, dirt: r.dirt }; }, onEnter(app) { const r = carRec(app.profile); app.ui.say(r.oilKm > 200 ? LINES.bennoOil : LINES.bennoHello, BEN); },\n  draw(ui, dt) { const app = ui.app, p = app.profile, r = carRec(p); ui.title('SERVICE BAY'); statusStrip(app, ui); const oil = oilFactor(r), pct = Math.round((oil - 1) * 1000) / 10; ui.panel(10, 30, 210, 62); ui.text(16, 36, CARS[r.id].shortName, { color: 'sand' }); ui.text(16, 48, `OIL: ${Math.round(r.oilKm)} KM SINCE A CHANGE`, { color: 'white' }); ui.text(16, 60, `POWER ${pct >= 0 ? '+' : ''}${pct}%`, { color: pct < 0 ? 'orange' : 'lime' }); ui.text(16, 72, `DIRT: ${Math.round(r.dirt * 100)}%`, { color: r.dirt > 0.3 ? 'orange' : 'white' });\n    if (ui.button('oil', 10, 100, 210, 30, 'OIL CHANGE', { left: true, sub: fmtCr(OIL_PRICE), disabled: p.credits < OIL_PRICE || r.oilKm === 0 })) { if (changeOil(p, r)) { app.save(); app.mix.ui('register'); ui.say(LINES.bennoOilDone, BEN); app.scene.oilAnim?.(); } }\n    if (ui.button('wash', 10, 134, 210, 30, 'CAR WASH', { left: true, sub: fmtCr(WASH_PRICE), disabled: p.credits < WASH_PRICE })) { if (washCar(p, r)) { app.save(); app.mix.ui('register'); ui.say(LINES.bennoWash, BEN); app.scene.washAnim?.(); } }\n    void dt; if (stdBack(app, ui)) return; ui.prompts([['confirm', 'SELECT'], ['back', 'BACK']]); } });\nE\ncat > src/game/ui/screens/garage.js <<'E'\n// Home Garage, Museum and Theatre.\nimport { CAR_LIST, CARS } from '../../data/cars.js';\nimport { carRec, canSell, sellCar, collected, medalName } from '../../sim/career.js';\nimport { specOf } from '../../sim/tuning.js';\nimport { getTrack } from '../../sim/race.js';\nimport { TRACKS } from '../../data/tracks.js';\nimport { drawMini } from './events.js';\nimport { TEST } from '../../data/licences.js';\nimport { scr, stdBack, statusStrip } from './common.js';\nimport { wrap, fmtCr, fmtTime } from '../ui.js';\nimport { oilFactor } from '../../sim/career.js';\nexport const Garage = () => scr('garage', { set: 'garage', music: 'map', tab: 0, idx: 0, setArgs(app) { const p = app.profile, r = carRec(p) ?? p.cars[0]; this.idx = Math.max(0, p.cars.indexOf(r)); return r ? { car: r.id, install: r.install, dirt: r.dirt, trophies: p.trophies } : {}; },\n  draw(ui) { const app = ui.app, p = app.profile; ui.title('HOME GARAGE'); statusStrip(app, ui); ui.tabs(26, ['CARS', 'SHELF', 'STATS'], this.tab, (i) => (this.tab = i)); const x = ui.W - 190, W = 182;\n    if (this.tab === 0 && p.cars.length) { if (ui.leftRight) { this.idx = (this.idx + ui.leftRight + p.cars.length) % p.cars.length; const q = p.cars[this.idx]; app.scene.showCarAt?.(q.id, q.install, q.dirt); app.mix.ui('tick'); }\n      const r = p.cars[this.idx] ?? p.cars[0], s = specOf(r.id, r.install), cur = r.uid === p.current; ui.panel(x, 44, W, 88); ui.text(x + 6, 49, CARS[r.id].shortName, { color: 'sand' }); ui.text(x + 6, 61, `${s.layout}  ${s.ps} PS  ${s.kg} KG`, { color: 'white' }); ui.text(x + 6, 73, `${Math.round(r.km).toLocaleString('en-US')} KM`, { color: 'white' }); const o = Math.round((oilFactor(r) - 1) * 1000) / 10; ui.text(x + 6, 85, `OIL ${o >= 0 ? '+' : ''}${o}%`, { color: o < 0 ? 'orange' : 'lime' }); ui.text(x + 6, 97, `TYRES ${(r.install.tyre ?? 'STOCK').toUpperCase()}`, { color: 'white' }); ui.text(x + 6, 109, `PARTS ${Object.keys(r.install.parts).length}  DIRT ${Math.round(r.dirt * 100)}%`, { color: 'white' }); ui.text(x + 6, 120, `${this.idx + 1} OF ${p.cars.length}${cur ? '  CURRENT' : ''}`, { color: 'mist' });\n      if (ui.button('choose', x, 138, W, 22, cur ? 'YOUR RIDE' : 'CHOOSE THIS CAR', { disabled: cur })) { p.current = r.uid; app.save(); ui.toast(`${CARS[r.id].shortName} CHOSEN`); } const can = canSell(p, r.uid); if (ui.button('sell', x, 164, W, 20, can.ok ? `SELL ${fmtCr(can.value)}` : 'SELL', { disabled: !can.ok })) { const v = sellCar(p, r.uid); if (v) { app.save(); app.mix.ui('register'); this.idx = 0; const q = p.cars[0]; app.scene.showCarAt?.(q.id, q.install, q.dirt); } } if (!can.ok && ui.focus === 'sell') ui.para(10, 196, can.why, 40, { color: 'orange' }); }\n    if (this.tab === 1) { ui.item('shelf', 10, 44, 10, 10, {}); ui.panel(10, 44, 280, 44 + Math.max(0, Math.min(5, p.trophies.length)) * 12); ui.text(16, 49, `TROPHIES: ${p.trophies.length}`, { color: 'sand' }); p.trophies.slice(-5).forEach((t, i) => ui.text(16, 62 + i * 12, `DAY ${t.day}  ${t.name}`, { color: 'white' })); if (!p.trophies.length) ui.text(16, 62, 'THE SHELF IS DUSTED AND READY.', { color: 'mist' }); }\n    if (this.tab === 2) { ui.item('stats', 10, 44, 10, 10, {}); ui.panel(10, 44, 280, 94); const rows = [`DAYS ${p.day}`, `DISTANCE ${Math.round(p.stats.km).toLocaleString('en-US')} KM`, `RACES ${p.stats.races}  WINS ${p.stats.wins}`, `GOLD MEDALS ${p.stats.golds}`, `CREDITS EARNED ${Math.round(p.stats.earned).toLocaleString('en-US')}`, `COLLECTED ${collected(p)}%`]; rows.forEach((l, i) => ui.text(16, 50 + i * 14, l, { color: i === 5 ? 'lime' : 'white' })); }\n    if (stdBack(app, ui)) return; ui.prompts([['confirm', 'SELECT'], ['lr', 'CAR'], ['tabs', 'TAB'], ['back', 'BACK']]); } });\nconst metOf = (p, id) => !!p?.seen?.[id];\nexport const Museum = () => scr('museum', { set: 'museum', music: 'museum', tab: 0, idx: 0, tr: 0, setArgs(app) { return { car: CAR_LIST[this.idx].id, dark: !metOf(app.profile, CAR_LIST[this.idx].id) }; },\n  draw(ui) { const app = ui.app, p = app.profile; ui.title('MUSEUM'); statusStrip(app, ui); ui.tabs(26, ['CARS', 'TRACKS'], this.tab, (i) => { this.tab = i; if (i === 1) app.scene.setSet('museum', { car: null }); else { const c = CAR_LIST[this.idx]; app.scene.setSet('museum', { car: c.id, dark: !metOf(p, c.id) }); } });\n    if (this.tab === 0) { if (ui.leftRight) { this.idx = (this.idx + ui.leftRight + CAR_LIST.length) % CAR_LIST.length; const c = CAR_LIST[this.idx]; app.scene.showCarAt?.(c.id, null, 0, !metOf(p, c.id)); app.mix.ui('tick'); } const c = CAR_LIST[this.idx], met = metOf(p, c.id), lines = wrap(met ? c.brochure : 'YOU HAVE NOT YET MET THIS CAR. MEETING ONE IN A RACE WILL DO.', 40); ui.item('car', 8, 44, 248, lines.length * 10 + 42); ui.panel(8, 44, 248, lines.length * 10 + 42); ui.text(14, 49, met ? c.name : '????', { color: 'sand' }); if (met) { const s = specOf(c.id, {}); ui.text(14, 61, `${c.year} ${s.layout} ${s.ps} PS ${s.kg} KG`, { color: 'white' }); } lines.forEach((l, i) => ui.text(14, 74 + i * 10, l, { color: 'white' })); ui.text(8, ui.H - 30, `${this.idx + 1} OF ${CAR_LIST.length}`, { color: 'mist' }); }\n    else { const ids = Object.keys(TRACKS); if (ui.leftRight) { this.tr = (this.tr + ui.leftRight + ids.length) % ids.length; app.mix.ui('tick'); } const id = ids[this.tr], T = TRACKS[id], tr = getTrack(id).tr, rec = p.records[id]; ui.item('track', 8, 44, 330, 140); ui.panel(8, 44, 330, 140); drawMini(ui, id, 16, 54, 120, 'sand'); ui.text(150, 54, T.name, { color: 'sand' }); ui.text(150, 70, `${Math.round(tr.length).toLocaleString('en-US')} M`, { color: 'white' }); ui.text(150, 84, `${T.corners.length} CORNERS`, { color: 'white' }); ui.text(150, 98, T.surface === 'dirt' ? 'DIRT' : 'TARMAC', { color: 'white' }); ui.text(150, 112, rec ? `RECORD ${fmtTime(rec.lap)}` : 'NO RECORD YET', { color: 'lime' }); if (rec) ui.text(150, 124, CARS[rec.car]?.shortName ?? '', { color: 'mist' }); ui.text(8, ui.H - 30, `${this.tr + 1} OF ${ids.length}`, { color: 'mist' }); }\n    if (stdBack(app, ui)) return; ui.prompts([['lr', 'NEXT'], ['tabs', 'TAB'], ['back', 'BACK']]); } });\nexport const Theatre = () => scr('theatre', { set: 'theatre', music: 'replay',\n  draw(ui) { const app = ui.app, p = app.profile; ui.title('THEATRE'); statusStrip(app, ui); const last = app.lastReplay; if (ui.button('last', 10, 34, 240, 30, 'LAST RACE', { left: true, sub: last ? last.label || TRACKS[last.track].name : 'NOTHING HAS BEEN RECORDED TODAY', disabled: !last })) app.startReplay(last, { screen: 'theatre' });\n    for (let i = 0; i < 3; i++) { const s = p.replays[i], y = 68 + i * 34; if (ui.button(`slot${i}`, 10, y, 240, 30, `SLOT ${i + 1}`, { left: true, sub: s ? `${s.label || TRACKS[s.track].name}  DAY ${s.day}` : 'EMPTY', disabled: !s })) app.startReplay(app.unpackReplay(s), { screen: 'theatre' }); if (s && ui.focus === `slot${i}`) { ui.text(258, y + 10, 'INFO: DELETE', { color: 'mist' }); if (app.actions.pressed('info')) { p.replays.splice(i, 1); app.save(); } } }\n    if (stdBack(app, ui)) return; ui.prompts([['confirm', 'WATCH'], ['back', 'BACK']]); } });\nvoid TEST; void medalName;\nE\ncat > src/game/ui/screens/arcade.js <<'E'\n// The Arcade Gate: Quick Race, Time Trial, Couch Duel as big tiles, then two or three simple picker screens.\nimport { CAR_LIST, CARS } from '../../data/cars.js';\nimport { TRACKS } from '../../data/tracks.js';\nimport { quickRaceSetup, trialSetup, couchSetup } from '../../sim/setups.js';\nimport { drawMini } from './events.js';\nimport { specOf } from '../../sim/tuning.js';\nimport { scr, stdBack } from './common.js';\nconst TRACK_IDS = Object.keys(TRACKS);\nexport const Arcade = () => scr('arcade', { set: 'arcade', music: 'map',\n  draw(ui) { const app = ui.app; ui.title('ARCADE GATE', 'NO LICENCE REQUIRED. NO MONEY EITHER.'); const w = Math.min(130, Math.floor((ui.W - 40) / 3)), y = 70, h = 90; [['quick', 'QUICK RACE', 'ANY TRACK, ANY CAR'], ['trial', 'TIME TRIAL', 'YOU AND YOUR GHOST'], ['couch', 'COUCH DUEL', 'TWO PLAYERS, ONE TV']].forEach(([id, l, sub], i) => { const x = Math.round(ui.cx - (w * 3 + 16) / 2 + i * (w + 8)); if (ui.button(id, x, y, w, h, l, {})) { const cfg = { mode: id, track: 'kestrel', carId: 'ginga', car2: 'kite', laps: 2, field: 6, pace: 0.92, hour: null, rain: false, ai: 0 }; ui.push(TrackPick(cfg)); } ui.center; const t = sub; ui.hud.text(Math.round(x + (w - t.length * 6) / 2), y + h - 16, t.length * 6 > w - 4 ? t.slice(0, Math.floor((w - 4) / 6)) : t, { color: 'mist' }); }); if (stdBack(app, ui)) return; ui.prompts([['confirm', 'SELECT'], ['back', 'BACK']]); } });\nconst TrackPick = (cfg) => scr('picktrack', { set: 'arcade', music: 'map', idx: 0,\n  draw(ui) { const app = ui.app; ui.title('CHOOSE A CIRCUIT'); if (ui.leftRight) { this.idx = (this.idx + ui.leftRight + TRACK_IDS.length) % TRACK_IDS.length; app.mix.ui('tick'); } const id = TRACK_IDS[this.idx], T = TRACKS[id]; cfg.track = id; ui.panel(ui.cx - 110, 34, 220, 150); drawMini(ui, id, ui.cx - 55, 42, 110, 'sand'); ui.center(158, T.name, { color: 'white', scale: 1 }); ui.center(170, `< ${this.idx + 1} OF ${TRACK_IDS.length} >`, { color: 'mist' }); if (ui.button('next', ui.cx - 60, 192, 120, 24, 'THIS ONE')) ui.push(CarPick(cfg)); if (stdBack(app, ui)) return; ui.prompts([['lr', 'CHANGE'], ['confirm', 'NEXT'], ['back', 'BACK']]); } });\nconst CarPick = (cfg, which = 1) => scr('pickcar', { set: 'arcade', music: 'map', idx: CAR_LIST.findIndex((c) => c.id === (which === 1 ? cfg.carId : cfg.car2)), setArgs() { return { car: CAR_LIST[this.idx].id }; },\n  draw(ui) { const app = ui.app; ui.title(cfg.mode === 'couch' ? `PLAYER ${which}: CHOOSE A CAR` : 'CHOOSE A CAR'); if (ui.leftRight) { this.idx = (this.idx + ui.leftRight + CAR_LIST.length) % CAR_LIST.length; app.scene.showCarAt?.(CAR_LIST[this.idx].id); app.mix.ui('tick'); } const c = CAR_LIST[this.idx], s = specOf(c.id, {}); const x = ui.W - 170; ui.panel(x, 34, 160, 66); ui.text(x + 6, 40, c.shortName, { color: 'sand' }); ui.text(x + 6, 54, `${s.layout}  ${c.year}`, { color: 'white' }); ui.text(x + 6, 66, `${s.ps} PS`, { color: 'white' }); ui.text(x + 6, 78, `${s.kg.toLocaleString('en-US')} KG`, { color: 'white' }); ui.text(x + 6, 89, `< ${this.idx + 1} OF ${CAR_LIST.length} >`, { color: 'mist' });\n    if (ui.button('next', x, 110, 160, 24, 'THIS ONE')) { if (which === 1) cfg.carId = c.id; else cfg.car2 = c.id; if (cfg.mode === 'couch' && which === 1) ui.push(CarPick(cfg, 2)); else ui.push(Options(cfg)); }\n    if (stdBack(app, ui)) return; ui.prompts([['lr', 'CHANGE'], ['confirm', 'NEXT'], ['back', 'BACK']]); } });\nconst HOURS = [[null, 'USUAL HOUR'], [11, 'MORNING'], [18.5, 'DUSK'], [21, 'NIGHT']], DIFF = [[0.85, 'EASY'], [0.92, 'NORMAL'], [0.98, 'HARD']];\nconst Options = (cfg) => scr('pickoptions', { set: 'arcade', music: 'map', hi: 0, di: 1,\n  draw(ui) { const app = ui.app; ui.title('THE LAST FEW QUESTIONS'); const x = ui.cx - 110, w = 220; let y = 34, r = 0; const row = (id, label, val, adj) => { const f = ui.focus === id; ui.button(id, x, y, w, 22, `${label}: ${val}`, {}); if (f && ui.leftRight) { adj(ui.leftRight); app.mix.ui('tick'); } y += 25; r++; };\n    if (cfg.mode !== 'trial') row('laps', 'LAPS', cfg.laps, (d) => (cfg.laps = Math.max(1, Math.min(10, cfg.laps + d))));\n    if (cfg.mode === 'quick') { row('field', 'FIELD', cfg.field, (d) => (cfg.field = Math.max(2, Math.min(8, cfg.field + d)))); row('diff', 'PACE', DIFF[this.di][1], (d) => { this.di = (this.di + d + 3) % 3; cfg.pace = DIFF[this.di][0]; }); }\n    if (cfg.mode === 'couch') row('ai', 'AI CARS', cfg.ai, (d) => (cfg.ai = Math.max(0, Math.min(4, cfg.ai + d))));\n    row('hour', 'HOUR', HOURS[this.hi][1], (d) => { this.hi = (this.hi + d + 4) % 4; cfg.hour = HOURS[this.hi][0]; }); row('rain', 'RAIN', cfg.rain ? 'YES' : 'NO', () => (cfg.rain = !cfg.rain));\n    if (ui.button('go', x, y + 4, w, 26, 'GO', { color: 'lime' })) this.go(app, cfg);\n    if (stdBack(app, ui)) return; ui.prompts([['lr', 'CHANGE'], ['confirm', 'GO'], ['back', 'BACK']]); },\n  go(app, c) { const h = c.hour ?? undefined; if (c.mode === 'quick') app.startRace(quickRaceSetup({ ...c, hour: h, seed: (app.profile?.day ?? 1) * 7 + c.laps })); if (c.mode === 'trial') app.startRace(trialSetup({ ...c, hour: h })); if (c.mode === 'couch') app.startCouch(couchSetup({ track: c.track, car1: c.carId, car2: c.car2, laps: c.laps, ai: c.ai, hour: h, rain: c.rain, pace: 0.9 })); },\n});\nvoid CARS;\nE\ncat > src/game/ui/screens/settings.js <<'E'\n// Settings, Handbook, About.\nimport { HANDBOOK, CONTROLS_TEXT } from '../../data/text.js';\nimport { scr, stdBack } from './common.js';\nimport { wrap } from '../ui.js';\nimport { ABOUT } from '../../data/about.gen.js';\nimport { TITLE } from '../../data/meta.js';\nconst LOOKS = [['none', 'NATIVE'], ['playstation', 'PLAYSTATION'], ['arcade', 'ARCADE'], ['vhs_rental', 'VHS RENTAL'], ['no_filters', 'NO FILTERS']];\nexport const Settings = () => scr('settings', { tab: 0, overlay: true,\n  draw(ui) { const app = ui.app, s = app.settings, audio = app.mix.audio, a = app.actions; if (app.inRace?.()) ui.hud.rect(0, 0, ui.W, ui.H, 'ink'); ui.title('SETTINGS'); ui.tabs(26, ['SOUND', 'PICTURE', 'CONTROLS', 'ASSISTS'], this.tab, (i) => (this.tab = i)); const x = ui.cx - 130, w = 260; let y = 46; const pct = (v) => `${Math.round(v * 100)}%`;\n    const vol = (id, label, val, set) => { ui.slider(id, x, y, w, label, val, 0, 1, 0.05, set, { format: pct }); y += 22; };\n    const opt = (id, label, val, adj, cb) => { const f = ui.focus === id; if (ui.button(id, x, y, w, 19, `${label}: ${val}`, {}) && cb) cb(); if (f && ui.leftRight) { adj(ui.leftRight); app.mix.ui('tick'); app.saveSettings(); } y += 22; };\n    if (this.tab === 0) { vol('master', 'MASTER', audio.volume.master, (v) => audio.setVolume('master', v)); vol('sfx', 'EFFECTS', audio.volume.sfx, (v) => audio.setVolume('sfx', v)); vol('music', 'MUSIC', audio.volume.music, (v) => { audio.setVolume('music', v); s.musicSet = true; app.saveSettings(); }); vol('voices', 'VOICES', s.voices, (v) => { s.voices = v; app.saveSettings(); }); opt('racemusic', 'MUSIC IN RACES', s.raceMusic === false ? 'OFF' : 'ON', () => (s.raceMusic = s.raceMusic === false), () => { s.raceMusic = s.raceMusic === false; app.saveSettings(); }); if (!audio.unlocked) ui.center(y + 2, 'PRESS A KEY OR CLICK FOR SOUND', { color: 'orange' }); }\n    if (this.tab === 1) { const e = app.ctx.engine, cur = e.settings.values, li = Math.max(0, LOOKS.findIndex(([k]) => k === (cur.look ?? 'none'))); opt('pixel', 'PIXEL SIZE', (cur.pixelSize ?? 'fine').toUpperCase(), () => e.settings.set({ pixelSize: cur.pixelSize === 'chunky' ? 'fine' : 'chunky' }), () => e.settings.set({ pixelSize: cur.pixelSize === 'chunky' ? 'fine' : 'chunky' })); opt('look', 'LOOK', LOOKS[li][1], (d) => { const n = LOOKS[(li + d + LOOKS.length) % LOOKS.length][0]; e.settings.set({ look: n === 'none' ? undefined : n }); }, () => { const n = LOOKS[(li + 1) % LOOKS.length][0]; e.settings.set({ look: n === 'none' ? undefined : n }); }); const Q = ['auto', 'low', 'medium', 'high'], qi = Math.max(0, Q.indexOf(cur.quality ?? 'auto')); opt('quality', 'QUALITY', Q[qi].toUpperCase(), (d) => e.settings.set({ quality: Q[(qi + d + 4) % 4] }), () => e.settings.set({ quality: Q[(qi + 1) % 4] })); const F = [60, 30, 0], fi = Math.max(0, F.indexOf(cur.fps ?? 60)); opt('fps', 'FRAME CAP', F[fi] ? `${F[fi]}` : 'DISPLAY', (d) => e.settings.set({ fps: F[(fi + d + 3) % 3] }), () => e.settings.set({ fps: F[(fi + 1) % 3] })); opt('fullscreen', 'FULLSCREEN', typeof document !== 'undefined' && document.fullscreenElement ? 'ON' : 'OFF', () => app.toggleFullscreen(), () => app.toggleFullscreen()); }\n    if (this.tab === 2) { opt('glyphs', 'BUTTON GLYPHS', s.glyphs === 'xbox' ? 'XBOX' : 'PLAYSTATION', () => (s.glyphs = s.glyphs === 'xbox' ? 'ps' : 'xbox'), () => { s.glyphs = s.glyphs === 'xbox' ? 'ps' : 'xbox'; app.saveSettings(); }); opt('vib', 'VIBRATION', s.vibration === false ? 'OFF' : 'ON', () => (s.vibration = s.vibration === false), () => { s.vibration = s.vibration === false; app.saveSettings(); }); ui.slider('curve', x, y, w, 'STEERING RESPONSE', s.steerCurve, 1, 2, 0.1, (v) => { s.steerCurve = v; app.saveSettings(); }, { format: (v) => (v <= 1.05 ? 'DIRECT' : v >= 1.95 ? 'GENTLE' : v.toFixed(1)) }); y += 22; opt('mousesteer', 'MOUSE STEERING', s.mouseSteer ? 'ON' : 'OFF', () => (s.mouseSteer = !s.mouseSteer), () => { s.mouseSteer = !s.mouseSteer; app.saveSettings(); }); opt('units', 'UNITS', s.units === 'mph' ? 'MPH' : 'KM/H', () => (s.units = s.units === 'mph' ? 'kmh' : 'mph'), () => { s.units = s.units === 'mph' ? 'kmh' : 'mph'; app.saveSettings(); }); }\n    if (this.tab === 3) { const as = app.assistsTarget(); opt('abs', 'ABS', as.abs ? 'ON' : 'OFF', () => (as.abs = !as.abs), () => { as.abs = !as.abs; app.save(); }); ui.slider('tcs', x, y, w, 'TRACTION CONTROL', as.tcs, 0, 10, 1, (v) => { as.tcs = v; app.save(); }, { format: (v) => `${Math.round(v)}`, dflt: 5 }); y += 22; ui.slider('asm', x, y, w, 'STABILITY CONTROL', as.asm, 0, 10, 1, (v) => { as.asm = v; app.save(); }, { format: (v) => `${Math.round(v)}`, dflt: 5 }); y += 22; opt('auto', 'GEARS', as.auto ? 'AUTOMATIC' : 'MANUAL', () => (as.auto = !as.auto), () => { as.auto = !as.auto; app.save(); }); opt('line', 'DRIVING LINE', as.line ? 'ON' : 'OFF', () => (as.line = !as.line), () => { as.line = !as.line; app.save(); }); }\n    if (!app.session) { if (ui.button('reset', x, ui.H - 44, 126, 18, 'RESET DEFAULTS')) { app.resetSettings(); ui.toast('RESET. THE MUSIC IS AT 10% AGAIN.'); } if (ui.button('about', x + 134, ui.H - 44, 126, 18, 'ABOUT')) ui.push(About()); }\n    void a; if (stdBack(app, ui)) return; ui.prompts([['confirm', 'SELECT'], ['lr', 'CHANGE'], ['tabs', 'TAB'], ['back', 'BACK']]); } });\nexport const Handbook = () => scr('handbook', { overlay: false, page: 0,\n  draw(ui) { const app = ui.app; ui.hud.rect(0, 0, ui.W, ui.H, 'night'); ui.title('THE HANDBOOK'); if (ui.leftRight || app.actions.pressed('tabR') || app.actions.pressed('tabL')) { const d = ui.leftRight || (app.actions.pressed('tabR') ? 1 : -1); this.page = (this.page + d + HANDBOOK.length) % HANDBOOK.length; app.mix.ui('tick'); } const pg = HANDBOOK[this.page]; ui.item('page', ui.cx - 180, 40, 360, 100); ui.panel(ui.cx - 180, 40, 360, 140); ui.center(48, pg.title, { color: 'sand' }); const lines = pg.controls ? CONTROLS_TEXT[app.actions.device === 'pad' ? 'pad' : 'kb'] : pg.lines; lines.forEach((l, i) => ui.hud.text(ui.cx - 174, 66 + i * 16, l, { color: 'white' })); ui.center(162, `PAGE ${this.page + 1} OF ${HANDBOOK.length}`, { color: 'mist' }); if (stdBack(app, ui)) return; ui.prompts([['lr', 'PAGE'], ['back', 'BACK']]); } });\nfunction aboutPages() {\n  const pages = [], paged = (title, rows) => { let cur = []; let lines = 0; for (const [k, v] of rows) { const body = wrap(`${k ? `${k}: ` : ''}${v}`, 60); if (lines + body.length > 14 && cur.length) { pages.push({ title, lines: cur }); cur = []; lines = 0; } cur.push(...body, ''); lines += body.length + 1; } if (cur.length) pages.push({ title, lines: cur }); };\n  const si = ABOUT.exit.sourceInformation; paged('SOURCE INFORMATION', [['DATE', si.date], ['SOURCE', si.source], ['PLAN', si.plan], ['GENRE', si.genre], ['PERSPECTIVE', si.perspective], ['TECH', si.tech], ['ART DIRECTION', si.artDirection], ['ANIMATION', si.animation], ['AUDIO', si.audio], ['ONLINE', si.online], ['TESTING', si.testing], ['RESEARCH', si.research], ['ENVIRONMENT', si.environment], ['MODEL', si.model], ['USAGE', si.usage]]);\n  const Q = { 'TESTING FEEDBACK': ['How many issues did testing catch?', 'How many would be considered critical issues / game breaking?', 'What was the most helpful test you ran?', 'What was the least helpful test you ran?'], 'ENGINE FEEDBACK': ['What did you like most about the engine?', 'Did you get stuck or guess wrong?', 'What was the most important thing you had to build yourself?', 'What was the hardest part about using the engine?', 'What did you change in the engine, and why? (none if nothing)', 'If you could change one thing about the engine, what would it be?'], 'PROMPT FEEDBACK': ['What did you like most about this prompt?', 'What was confusing?', 'What was the hardest thing to do?', 'What would you change in this prompt?'] };\n  const ans = { 'TESTING FEEDBACK': ABOUT.exit.testingFeedback, 'ENGINE FEEDBACK': ABOUT.exit.engineFeedback, 'PROMPT FEEDBACK': ABOUT.exit.promptFeedback };\n  for (const t of Object.keys(Q)) paged(t, Q[t].map((q, i) => ['', `${q} ${ans[t][i] ?? 'unknown'}`]));\n  pages.push({ title: 'CREDITS', lines: [TITLE, ...wrap(`INSPIRED BY ${si.source}. AN ORIGINAL GAME: NO REAL CARS, CIRCUITS, LOGOS OR MUSIC FROM IT ARE USED.`, 60), '', ...wrap('MADE BY CLAUDE (ANTHROPIC) FROM A PLAN, FOR MICHAEL CROSATO.', 60), '', ...wrap(`PIXEL ENGINE ${ABOUT.engineVersion}. THREE.JS R186 (MIT). RAPIER (APACHE-2.0). SWEETIE 16 PALETTE BY GRAFXKID.`, 60), '', 'THE KIT\\'S CREDITS FILE FOLLOWS.'] });\n  const cr = ABOUT.credits.split('\\n').flatMap((l) => (l.trim() ? wrap(l.replace(/[#*`|]/g, ' ').replace(/\\s+/g, ' ').trim(), 60) : []));\n  for (let i = 0; i < cr.length; i += 15) pages.push({ title: 'CREDITS FILE', lines: cr.slice(i, i + 15), scroll: true });\n  return pages;\n}\nlet cachedPages = null;\nexport const About = () => scr('about', { page: 0, onEnter() { cachedPages ??= aboutPages(); },\n  draw(ui) { const app = ui.app, pages = cachedPages; ui.hud.rect(0, 0, ui.W, ui.H, 'night'); ui.title('ABOUT'); ui.right(ui.W - 10, 8, `PAGE ${this.page + 1} OF ${pages.length}`, { color: 'mist' }); let d = ui.leftRight; if (app.actions.pressed('tabR')) d = 10; if (app.actions.pressed('tabL')) d = -10; if (app.actions.pressed('down')) d = 1; if (app.actions.pressed('up')) d = -1; if (app.actions.wheel) d = app.actions.wheel > 0 ? 1 : -1; if (d) { this.page = Math.max(0, Math.min(pages.length - 1, this.page + d)); app.mix.ui('tick'); } const pg = pages[this.page]; ui.item('page', 8, 26, ui.W - 16, ui.H - 46); ui.text(ui.cx - 180, 30, pg.title, { color: 'sand' }); pg.lines.slice(0, 15).forEach((l, i) => ui.hud.text(ui.cx - 180, 42 + i * 13, l, { color: 'white' })); if (stdBack(app, ui)) return; ui.prompts([['lr', 'PAGE'], ['tabs', 'FAR'], ['back', 'BACK']]); },\n  allText() { return (cachedPages ??= aboutPages()).flatMap((p) => [p.title, ...p.lines]).join('\\n'); } });\nE\ncat > src/game/ui/screens/race.js <<'E'\n// Over a race: pause, results, the licence result, assists. Results also return after a replay, so they read app.lastResult.\nimport { fmtTime, fmtCr, wrap } from '../ui.js';\nimport { CARS } from '../../data/cars.js';\nimport { TEST, LICENCE } from '../../data/licences.js';\nimport { EVENT } from '../../data/events.js';\nimport { TRACKS } from '../../data/tracks.js';\nimport { scr, stdBack } from './common.js';\nimport { LINES } from '../../data/text.js';\nimport { medalName } from '../../sim/career.js';\nimport { medalIcon } from './licence.js';\nimport { licenceSetup } from '../../sim/setups.js';\nimport { SPEAKERS } from '../../audio/voice.js';\nconst dim = (ui) => { ui.hud.rect(0, 0, ui.W, ui.H, 'ink'); };\nexport const Pause = (scene) => scr('pause', { overlay: false, onEnter(app) { app.paused = true; }, leave(app) { if (app.ui.stack.length <= 1) app.paused = false; },\n  draw(ui) { const app = ui.app, sim = scene.sim, W = 160, x = ui.cx - W / 2; ui.panel(x, 34, W, 202, 'ink', 'slate'); ui.center(40, 'PAUSED', { color: 'sand', scale: 2 }); const mode = scene.setup.mode; const items = [['resume', 'RESUME'], ['restart', 'RESTART'], ['retire', mode === 'testdrive' ? 'END DRIVE' : 'RETIRE'], ['assists', 'ASSISTS'], ['settings', 'SETTINGS'], ['handbook', 'HANDBOOK']]; if (mode === 'trial') items.push(['pass', 'PASS THE PAD']); items.push(['dev', 'DEV MODE']);\n    items.forEach(([id, l], i) => { if (ui.button(id, x + 12, 60 + i * 21, W - 24, 18, l)) this.pick(app, id, scene); });\n    if (scene.trial) { const t = scene.trial; ui.text(x + 12, 60 + items.length * 21, `D1 ${fmtTime(t.drivers[0])}`, { color: t.driver === 0 ? 'lime' : 'mist' }); ui.text(x + 12, 70 + items.length * 21, `D2 ${fmtTime(t.drivers[1])}`, { color: t.driver === 1 ? 'lime' : 'mist' }); }\n    void sim;\n    if (app.actions.pressed('pause') || ui.backHit) { ui.backHit = false; ui.pop(); app.paused = false; return; } ui.prompts([['confirm', 'SELECT'], ['back', 'RESUME']]); },\n  pick(app, id, sc) { const ui = app.ui; if (id === 'resume') { ui.pop(); app.paused = false; } if (id === 'restart') { app.paused = false; ui.clearStack(); app.restartRace(sc); } if (id === 'retire') { app.paused = false; ui.clearStack(); app.retire(sc); } if (id === 'assists') { const s = app.screens.Settings(); s.tab = 3; ui.push(s); } if (id === 'settings') ui.push(app.screens.Settings()); if (id === 'handbook') ui.push(app.screens.Handbook()); if (id === 'dev') ui.push(app.screens.Dev(sc)); if (id === 'pass') { sc.trial.driver = 1 - sc.trial.driver; ui.pop(); app.paused = false; app.restartTrialLap(sc); } },\n});\nexport const Results = () => scr('results', { t: 0, shown: 0,\n  onEnter(app) { const R = app.lastResult; this.t = 0; this.shown = 0; if (R.outcome) { const o = R.outcome; app.mix.ui(o.place === 1 ? 'fanfare2' : 'medal'); const line = o.place === 1 ? LINES.dellWin : o.place <= 3 ? LINES.dellPodium : LINES.dellOther; app.ui.say(R.recordLap ? LINES.dellLap.replace('Kestrel Park', TRACKS[R.setup.track].name).replace('One minute, fifty-one', fmtTime(R.recordLap)) : line, SPEAKERS.dell, { time: 5 }); } },\n  draw(ui, dt) { const app = ui.app, R = app.lastResult, o = R.outcome; this.t += dt; if (!ui.app.inRace?.()) ui.hud.rect(0, 0, 0, 0, 'ink'); const W = Math.min(340, ui.W - 16), x = Math.round(ui.cx - W / 2), rows = R.rows.slice(0, 8); ui.panel(x, 8, W, 26 + rows.length * 13 + 42, 'ink', 'slate'); ui.center(12, R.setup.label || 'RESULTS', { color: 'sand' }); const y0 = 24; rows.forEach((r, i) => { const y = y0 + i * 13, c = r.player || r.seat >= 0 ? 'lime' : 'white', showT = this.t > i * 0.12; if (!showT) return; if (r.player) ui.hud.rect(x + 2, y - 1, W - 4, 11, 'navy'); ui.text(x + 5, y, `${i + 1}`, { color: 'sand' }); ui.text(x + 18, y, r.name.slice(0, 12), { color: c }); ui.text(x + 100, y, CARS[r.carId]?.shortName.slice(0, 12) ?? '', { color: 'mist' }); ui.right(x + W - 6, y, `${r.estimated ? '~' : ''}${fmtTime(r.time)}`, { color: c }); });\n    const by = y0 + rows.length * 13 + 2; if (o) { const money = Math.min(o.money + o.bonus, Math.round(((o.money + o.bonus) * Math.max(0, this.t - 1)) / 1.2)); if (money !== this.shown && Math.floor(this.t * 12) % 2 === 0) app.mix.play('countTick'); if (money === o.money + o.bonus && this.shown !== money && money > 0) app.mix.ui('register'); this.shown = money; ui.text(x + 6, by, `+${fmtCr(money)}`, { color: 'lime', scale: 1 }); ui.text(x + 120, by, `+${o.points} POINTS`, { color: 'sand' }); const top = o.seriesOver ? (o.seriesWon ? 'SERIES WON' : 'SERIES LOST. YOU MAY ENTER AGAIN') : `STANDING ${1 + o.standings.findIndex(([k]) => k === 'player')}`; ui.right(x + W - 6, by, top, { color: o.seriesWon ? 'lime' : 'white' }); } else ui.text(x + 6, by, R.setup.mode === 'couch' ? `WINNER: ${R.rows[0].name}` : 'THE ARCADE PAYS NO CREDITS.', { color: 'mist' });\n    const bw = Math.floor((W - 20) / 4), byy = by + 12, bx = (i) => x + 5 + i * (bw + 3); if (ui.button('continue', bx(0), byy, bw, 18, 'CONTINUE')) { ui.subtitle = null; app.continueAfterResult(); return; } if (ui.button('retry', bx(1), byy, bw, 18, 'RETRY')) { ui.subtitle = null; app.retryResult(); return; } if (ui.button('watch', bx(2), byy, bw, 18, 'REPLAY', { disabled: !R.replay })) { ui.subtitle = null; app.watchResult(); return; } if (ui.button('save', bx(3), byy, bw, 18, R.saved ? 'SAVED' : 'SAVE', { disabled: !R.replay || R.saved })) { const ok = app.saveReplay(R.replay); if (ok) { R.saved = true; ui.toast('THE REPLAY IS SAVED.'); } else ui.toast('NO ROOM. THE THEATRE IS FULL.', 'orange'); } ui.prompts([['confirm', 'SELECT']]); ui.backHit = false; } });\nexport const LicenceResult = () => scr('licenceresult', { t: 0, onEnter(app) { const R = app.lastResult, o = R.outcome; const m = o.medal; app.mix.ui(m ? 'medal' : 'fail'); app.ui.say(m === 3 ? LINES.aiGold : m === 2 ? LINES.aiSilver : m === 1 ? LINES.aiBronze : R.reason === 'THE BOX HAS NOT MOVED' ? LINES.aiFail : LINES.aiFail2, SPEAKERS.arai, { time: 4.5 }); },\n  draw(ui, dt) { const app = ui.app, R = app.lastResult, o = R.outcome, t = TEST[R.testId], W = 320, x = Math.round(ui.cx - W / 2); this.t += dt; ui.panel(x, 18, W, 150, 'ink', 'slate'); ui.center(24, `${t.id}  ${t.title}`, { color: 'sand' }); if (o.medal) { const iconSc = 3; medalIcon(ui, x + 12, 42, o.medal, iconSc); ui.text(x + 44, 44, medalName(o.medal), { scale: 2, color: ['', 'orange', 'mist', 'sand'][o.medal] }); } else { ui.text(x + 12, 44, R.reason ?? 'NOT THIS TIME', { color: 'orange', scale: R.reason && R.reason.length > 20 ? 1 : 2 }); } ui.text(x + 12, 72, `TIME ${R.failed ? '--:--.--' : fmtTime(R.time)}${R.hits ? `  INCL. +${R.hits} S` : ''}`, { color: 'white' }); const next = o.medal === 3 ? null : o.medal === 2 ? ['GOLD', t.medals.gold] : o.medal === 1 ? ['SILVER', t.medals.silver] : ['BRONZE', t.medals.bronze]; if (next && !R.failed) ui.text(x + 12, 84, `${next[0]} IS ${(R.time - next[1]).toFixed(2)} S AWAY`, { color: 'mist' }); else if (next) ui.text(x + 12, 84, `${next[0]} IS ${fmtTime(next[1])}`, { color: 'mist' });\n    if (o.licenceWon) { ui.text(x + 12, 98, `LICENCE ${o.licenceWon} WON. +${o.reward.toLocaleString('en-US')} CR`, { color: 'lime' }); } if (o.goldBonus) ui.text(x + 12, 110, wrap(`ALL GOLD: ${LICENCE[o.goldBonus].goldLine}`, 50)[0], { color: 'sand' }); if (app.profile.failStreak[R.testId] >= 3 && !app.profile.assists.line) { if (ui.button('line', x + 12, 120, W - 24, 15, 'PAINT THE DRIVING LINE')) { app.profile.assists.line = true; app.save(); ui.say(LINES.aiLine, SPEAKERS.arai); } }\n    const bw = Math.floor((W - 20) / 4), y = 142, bx = (i) => x + 5 + i * (bw + 3); if (ui.button('retry', bx(0), y, bw, 20, 'RETRY')) { ui.subtitle = null; app.startRace(licenceSetup(R.testId, 0)); return; } if (ui.button('watch', bx(1), y, bw, 20, 'REPLAY', { disabled: !R.replay })) { ui.subtitle = null; app.watchResult(); return; } if (ui.button('demo', bx(2), y, bw, 20, 'DEMO')) { ui.subtitle = null; app.startRace(licenceSetup(R.testId, 0, { demo: true })); return; } if (ui.button('back', bx(3), y, bw, 20, 'BACK')) { ui.subtitle = null; app.continueAfterResult(); return; } if (ui.backHit) { ui.backHit = false; ui.subtitle = null; app.continueAfterResult(); return; } ui.prompts([['confirm', 'SELECT'], ['back', 'BACK']]); } });\nvoid EVENT; void stdBack; void dim;\nE\ncat >> ../PROGRESS.md <<'E'\n- screens tuning, garage, arcade, settings, race written. Remaining: ui/screens/podium.js, dev/devmode.js, scenes/menu.js, scenes/replay.js, attract/director.js, net/hub.js, net/couch.js, app.js, main.js, tools/build.mjs, tools/test.mjs + suites, docs/adding-content.md, exit-interview.json.\nE","description":"Write tuning, garage, arcade, settings and race screens"}}}
