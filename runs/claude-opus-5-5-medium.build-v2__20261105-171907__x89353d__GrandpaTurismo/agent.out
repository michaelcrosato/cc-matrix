ion buildSkyDome(lookId, hour, o = {}) {\n  const look = LOOKS[lookId], g = new Group(), near = new Group(), n = nightOf(hour);\n  const pos = [], col = [], c = new Color();\n  const ring = (R, base, H, colour, f1, f2) => { c.set(colour); const steps = 96; for (let i = 0; i < steps; i++) { const a0 = (i / steps) * 6.283, a1 = ((i + 1) / steps) * 6.283, hAt = (a) => { const v = Math.abs(Math.sin(a * f1 + R)) * 0.6 + Math.abs(Math.sin(a * f2 + 1.7)) * 0.4; return base + (lookId === 'saltline' ? (v > 0.68 ? H : H * 0.04) : lookId === 'harbour' ? Math.floor(v * 7) / 7 * H : v * H); }; const h0 = hAt(a0), h1 = hAt(lookId === 'harbour' || lookId === 'saltline' ? a0 : a1); const p = [[Math.sin(a0) * R, base - 30, Math.cos(a0) * R], [Math.sin(a0) * R, h0, Math.cos(a0) * R], [Math.sin(a1) * R, h1, Math.cos(a1) * R], [Math.sin(a1) * R, base - 30, Math.cos(a1) * R]]; for (const k of [0, 2, 1, 0, 3, 2]) { pos.push(...p[k]); col.push(c.r, c.g, c.b); } } };\n  ring(3000, -10, lookId === 'saltline' ? 180 : lookId === 'harbour' ? 200 : 340, look.far[0], 5, 13);\n  ring(2300, -10, lookId === 'saltline' ? 90 : lookId === 'harbour' ? 120 : 200, look.far[1], 9, 21);\n  const gm = new BufferGeometry(); gm.setAttribute('position', new Float32BufferAttribute(pos, 3)); gm.setAttribute('color', new Float32BufferAttribute(col, 3)); gm.computeVertexNormals();\n  const ringMesh = new Mesh(gm, toonMaterial(0xffffff, { vertexColors: true })); g.add(ringMesh);\n  // sun or moon: a glowing billboard-ish disc built as a model part\n  const sky = skyAt(hour), dir = sky.sunDir, disc = buildModel({ id: `disc-${n > 0.5 ? 'moon' : 'sun'}`, about: 'sky disc', tags: ['sky'], palette: { d: n > 0.5 ? 'white' : 'sand' }, floats: true, collider: 'none', parts: [{ ball: [200, 200, 200], at: [0, 0, 0], c: 'd', glow: true }] }).object;\n  disc.position.set(dir[0] * 2800, Math.max(120, dir[1] * 2800), dir[2] * 2800); g.add(disc);\n  // chunky clouds\n  const cloudMat = flat(o.rain ? PALETTE.slate : n > 0.5 ? PALETTE.night : hour > 17 ? PALETTE.orange : PALETTE.white);\n  let sd = 7; const rd = () => { sd = (sd * 16807) % 2147483647; return sd / 2147483647; };\n  const clouds = [];\n  for (let i = 0; i < (o.rain ? 26 : 14); i++) { const a = rd() * 6.283, R = 600 + rd() * 1400, y = 240 + rd() * 200, cl = new Group(); for (let k = 0; k < 3; k++) { const b = new Mesh(new BoxGeometry(120 + rd() * 180, 26 + rd() * 26, 70 + rd() * 90), cloudMat); b.position.set((k - 1) * 90, k === 1 ? 14 : 0, rd() * 40); cl.add(b); } cl.position.set(Math.sin(a) * R, y, Math.cos(a) * R); clouds.push(cl); g.add(cl); }\n  g.traverse((m) => { if (m.isMesh) { m.castShadow = false; m.receiveShadow = false; m.frustumCulled = false; } });\n  g.userData.clouds = clouds; void near; void MeshBasicNodeMaterial;\n  return g;\n}\nexport const followSky = (g, cam, t) => { g.position.set(cam.position.x, 0, cam.position.z); g.userData.clouds?.forEach((c, i) => (c.rotation.y = 0, c.position.x += Math.sin(i) * 0)); void t; };\nE\ncat > src/game/render/skid.js <<'E'\n// Skid marks: a ring buffer of dark quads laid where the car slides or locks.\nimport { THREE, toonMaterial, PALETTE } from '../../pixel-engine.js';\nconst { BufferGeometry, BufferAttribute, Mesh, DynamicDrawUsage } = THREE;\nexport class SkidMarks {\n  constructor(max = 1200, color = PALETTE.ink) {\n    this.max = max; this.n = 0; this.pos = new Float32Array(max * 18);\n    this.g = new BufferGeometry(); this.attr = new BufferAttribute(this.pos, 3); this.attr.setUsage(DynamicDrawUsage); this.g.setAttribute('position', this.attr);\n    const nrm = new Float32Array(max * 18); for (let i = 1; i < nrm.length; i += 3) nrm[i] = 1; this.g.setAttribute('normal', new BufferAttribute(nrm, 3));\n    this.mesh = new Mesh(this.g, toonMaterial(color)); this.mesh.frustumCulled = false; this.mesh.receiveShadow = false; this.g.setDrawRange(0, 0); this.last = new Map();\n  }\n  lay(id, x, y, z, rx, rz, w = 0.14) {\n    const l = this.last.get(id);\n    this.last.set(id, { x, y, z, t: 0 });\n    if (!l || Math.hypot(l.x - x, l.z - z) > 5) return;\n    if (Math.hypot(l.x - x, l.z - z) < 0.4) { this.last.set(id, l); return; }\n    const o = (this.n % this.max) * 18, p = this.pos, a = [l.x - rx * w, l.y + 0.05, l.z - rz * w], b = [l.x + rx * w, l.y + 0.05, l.z + rz * w], c = [x - rx * w, y + 0.05, z - rz * w], d = [x + rx * w, y + 0.05, z + rz * w];\n    [a, b, c, b, d, c].forEach((v, i) => { p[o + i * 3] = v[0]; p[o + i * 3 + 1] = v[1]; p[o + i * 3 + 2] = v[2]; });\n    this.n++; this.g.setDrawRange(0, Math.min(this.n, this.max) * 6); this.attr.needsUpdate = true;\n  }\n  lift(id) { this.last.delete(id); }\n}\nE\ncat > src/game/render/particles.js <<'E'\n// Particle presets, sizes in whole art pixels, palette colours.\nexport function registerParticles(p) {\n  p.register('tyreSmoke', { count: [1, 2], life: [0.5, 1.1], speed: [0.4, 1.4], gravity: -0.8, drag: 1, size: [2, 4], colors: ['white', 'mist', 'mist', 'slate'], radius: 0.25, max: 300 });\n  p.register('dust', { count: [1, 3], life: [0.8, 2.4], speed: [0.6, 2.2], gravity: -0.4, drag: 0.8, size: [2, 5], colors: ['sand', 'orange', 'orange', 'plum'], radius: 0.4, flatten: 0.5, max: 500 });\n  p.register('gravelSpray', { count: [1, 2], life: [0.3, 0.6], speed: [2, 5], gravity: 9, spread: 40, size: [1, 1], colors: ['sand', 'orange', 'slate'], max: 200 });\n  p.register('sparks', { count: [5, 10], life: [0.2, 0.5], speed: [3, 9], gravity: 12, size: [1, 1], colors: ['white', 'sand', 'orange'], max: 200 });\n  p.register('rainSpray', { count: [1, 2], life: [0.25, 0.6], speed: [0.6, 2], gravity: 1, size: [1, 3], colors: ['white', 'mist', 'slate'], radius: 0.3, max: 300 });\n  p.register('exhaustPop', { count: [2, 4], life: [0.08, 0.2], speed: [1, 3], size: [1, 2], colors: ['white', 'sand', 'orange'], max: 60 });\n  p.register('foam', { count: [2, 4], life: [0.6, 1.4], speed: [0.2, 1], gravity: 1.5, drag: 1, size: [2, 3], colors: ['white', 'white', 'cyan'], radius: 0.4, max: 300 });\n  p.register('confetti', { count: [8, 14], life: [1.2, 2.6], speed: [3, 7], gravity: 3, drag: 0.6, size: [1, 2], colors: ['red', 'sand', 'lime', 'sky', 'white', 'orange'], radius: 1, max: 500 });\n  p.register('firework', { count: [40, 60], life: [0.7, 1.5], speed: [8, 18], gravity: 6, drag: 1.2, size: [2, 1], colors: ['white', 'sand', 'orange', 'red'], max: 500 });\n  p.register('firework2', { count: [40, 60], life: [0.7, 1.5], speed: [8, 18], gravity: 6, drag: 1.2, size: [2, 1], colors: ['white', 'cyan', 'sky', 'lime'], max: 500 });\n  p.register('mist', { count: [1, 2], life: [2, 4], speed: [0.2, 0.6], gravity: -0.05, size: [4, 7], colors: ['mist', 'white', 'mist'], radius: 18, max: 120 });\n  p.register('waterfall', { count: [3, 5], life: [0.8, 1.2], speed: [1, 3], gravity: 14, direction: [0, -1, 0], spread: 15, size: [2, 2], colors: ['white', 'cyan', 'mist'], radius: 2.5, max: 300 });\n  p.register('landDust', { count: [10, 18], life: [0.5, 1.4], speed: [1, 4], gravity: -0.2, flatten: 0.3, drag: 1, size: [3, 5], colors: ['sand', 'orange', 'plum'], radius: 0.8, max: 200 });\n  p.register('devil', { count: [1, 2], life: [1, 2], speed: [1, 2.5], direction: [0, 1, 0], spread: 25, size: [3, 4], colors: ['white', 'sand', 'mist'], radius: 1.5, max: 100 });\n}\nE\ncat >> ../PROGRESS.md <<'E'\n- models/cars.js, render/{carview,trackmesh,sky,skid,particles}.js written. Next: input, ui, app, scenes/race, main, tools/build.\nE","description":"Write track mesh, sky, skid marks, particles"}}}
