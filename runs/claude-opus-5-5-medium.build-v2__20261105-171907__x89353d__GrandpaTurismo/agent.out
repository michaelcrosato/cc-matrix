{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgkm88juxpJGYpLBe93rx","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01H5JV5H7QofvwDXQyJkspWj","name":"Bash","input":{"command":"cat > src/game/dev/devmode.js <<'E'\n// Dev mode: a pad-friendly panel over the running game. Live sliders, tools, overlays and career shortcuts.\nimport { TUNE_DEFAULTS, profileFor } from '../sim/race.js';\nimport { scr } from '../ui/screens/common.js';\nimport { CAR_LIST, CARS } from '../data/cars.js';\nimport { TEST, TESTS, LICENCES } from '../data/licences.js';\nimport { EVENTS, EVENT } from '../data/events.js';\nimport { applyRound, applyTest, buyCar, newProfile } from '../sim/career.js';\nimport { tunedParams } from '../sim/tuning.js';\nimport { careerRoundSetup, licenceSetup } from '../sim/setups.js';\nimport { THREE } from '../../pixel-engine.js';\nconst { Vector3 } = THREE;\nexport const SLIDERS = [\n  ['grip', 'GRIP', 0.5, 1.5, 0.05], ['power', 'POWER', 0.5, 2, 0.05], ['brake', 'BRAKE STRENGTH', 0.5, 1.5, 0.05], ['downforce', 'DOWNFORCE', 0, 2, 0.1], ['wear', 'TYRE WEAR', 0, 5, 0.25], ['fuel', 'FUEL USE', 0, 5, 0.25], ['steerRate', 'STEERING RATE', 1, 8, 0.25],\n  ['stability', 'STABILITY STRENGTH', 0, 2, 0.1], ['traction', 'TRACTION STRENGTH', 0, 2, 0.1], ['aiPace', 'AI PACE (0: EVENT)', 0, 1.05, 0.01], ['rubber', 'AI RUBBER BAND', 0, 0.03, 0.002], ['wallLoss', 'WALL SPEED LOSS', 0, 2, 0.1], ['slip', 'SLIPSTREAM', 0.4, 1, 0.05], ['prize', 'PRIZE MONEY', 0, 5, 0.25],\n  ['chase', 'CHASE DISTANCE', 4, 14, 0.5], ['fov', 'FOV', 40, 90, 1],\n];\nconst OVERLAYS = [['line', 'RACING LINE'], ['loads', 'WHEEL LOADS AND SLIP'], ['surface', 'SURFACE TINT'], ['circles', 'COLLISION CIRCLES'], ['targets', 'AI TARGETS AND LANES'], ['telemetry', 'TELEMETRY STRIP']];\nexport class DevState {\n  constructor() { this.tune = { ...TUNE_DEFAULTS }; this.god = false; this.overlays = {}; this.freeCam = false; this.hideHud = false; this.saved = null; this.fieldSize = null; }\n  get dirty() { for (const k in TUNE_DEFAULTS) if (this.tune[k] !== TUNE_DEFAULTS[k]) return true; return this.god; }\n  reset() { Object.assign(this.tune, TUNE_DEFAULTS); this.god = false; this.overlays = {}; this.freeCam = false; }\n  /** Dev overlays: drawn in the HUD, over the race. */\n  drawOverlays(scene, ctx) {\n    const o = this.overlays, sim = scene.sim, hud = ctx.hud; if (!sim) return; const c = sim.cars[scene.focusIdx], cam = ctx.camera.camera; if (!c) return; cam.updateMatrixWorld();\n    const proj = (x, y, z) => { const v = (this._v ??= new Vector3()).set(x, y, z).project(cam); if (v.z > 1 || v.z < -1) return null; return [Math.round(((v.x + 1) / 2) * hud.width), Math.round(((1 - v.y) / 2) * hud.height)]; };\n    if (o.loads) { const x0 = 8, y0 = 64; hud.rect(x0 - 2, y0 - 2, 76, 50, 'ink'); c.fz.forEach((f, i) => { const X = x0 + (i % 2) * 38, Y = y0 + (i >> 1) * 24; hud.rect(X, Y, Math.round(Math.min(34, (f / (c.p.mass * 9.81)) * 60)), 6, 'sky'); hud.rect(X, Y + 8, Math.round(Math.min(34, c.use[i] * 18)), 6, c.use[i] > 1.2 ? 'red' : 'lime'); }); }\n    if (o.surface) { const col = { asphalt: 'slate', kerb: 'red', grass: 'green', gravel: 'sand', dirt: 'orange', apron: 'mist' }[c.surface]; hud.rect(0, 0, hud.width, 2, col); hud.rect(0, hud.height - 2, hud.width, 2, col); hud.text(hud.width / 2 - 30, 14, c.surface.toUpperCase(), { color: col }); }\n    if (o.circles) for (const k of sim.cars) for (const off of [-1.35, 0, 1.35]) { const p = proj(k.x + Math.sin(k.yaw) * off, k.y + 0.3, k.z + Math.cos(k.yaw) * off); if (p) { hud.rect(p[0] - 3, p[1], 7, 1, 'cyan'); hud.rect(p[0], p[1] - 3, 1, 7, 'cyan'); } }\n    if (o.targets) for (const k of sim.cars) { if (!k.ai) continue; const idx = (k.loc.i + Math.round(Math.max(7, Math.hypot(k.vx, k.vz) * 0.62) / sim.tr.ds)) % sim.tr.N, p = proj(sim.line.px[idx], sim.tr.y[idx] + 0.3, sim.line.pz[idx]); if (p) hud.rect(p[0] - 1, p[1] - 1, 3, 3, 'lime'); const q = proj(k.x, k.y + 1.9, k.z); if (q) hud.text(q[0] - 14, q[1], `${k.skill.toFixed(2)}`, { color: 'lime' }); }\n    if (o.telemetry) { const i = c.lastInp ?? {}, h = hud.height, y = h - 52; hud.rect(hud.width / 2 - 96, y, 192, 10, 'ink'); hud.text(hud.width / 2 - 94, y + 2, `${Math.round(Math.abs(c.u) * 3.6)} T${(i.throttle ?? 0).toFixed(1)} B${(i.brake ?? 0).toFixed(1)} AX${(c.ax / 9.81).toFixed(1)} AY${(c.ay / 9.81).toFixed(1)}`, { color: 'white' }); }\n  }\n}\nconst TAB_NAMES = ['SLIDERS', 'RACE', 'VIEW', 'CAREER'];\nexport const Dev = (scene = null) => scr('dev', { tab: 0, page: 0, sub: 0, overlay: false, onEnter(app) { this.scene = scene ?? (app.scene?.sim ? app.scene : null); this.ev = 0; this.test = 0; this.car = 0; },\n  draw(ui) { const app = ui.app, d = app.dev, a = app.actions; ui.hud.rect(0, 0, 200, ui.H, 'ink'); ui.hud.rect(200, 0, 1, ui.H, 'slate'); ui.hud.rect(0, 0, 200, 16, 'navy'); ui.text(6, 4, 'DEV MODE', { color: 'orange' }); const X = 4, W = 192; const names = TAB_NAMES; let idx = this.tab; if (a.pressed('tabR')) idx = (idx + 1) % names.length; if (a.pressed('tabL')) idx = (idx - 1 + names.length) % names.length; if (idx !== this.tab) { this.tab = idx; ui.focus = null; app.mix.ui('tick'); } ui.text(60, 4, names[this.tab], { color: 'sand' }); const pt = app.ctx.input.pointer; names.forEach((n, i) => { const x = 4 + i * 49; ui.hud.rect(x, 18, 47, 11, i === this.tab ? 'navy' : 'night'); ui.hud.text(x + 2, 20, n.slice(0, 7), { color: i === this.tab ? 'sand' : 'mist' }); if (a.click && ui.rectHit(pt, { x, y: 18, w: 47, h: 11 })) { this.tab = i; ui.focus = null; } });\n    const y0 = 32, btn = (id, i, label, fn, o = {}) => { if (ui.button(id, X, y0 + i * 20, W, 17, label, { left: true, ...o })) fn(); };\n    if (this.tab === 0) { const per = 7, pages = Math.ceil(SLIDERS.length / per); if (ui.focus && SLIDERS.findIndex((s) => s[0] === ui.focus) === -1) ui.focus = null; if (a.pressed('confirm') && SLIDERS.find((s) => s[0] === ui.focus)) { const k = ui.focus; d.tune[k] = TUNE_DEFAULTS[k]; a.consume('confirm'); app.mix.ui('back'); } if (a.pressed('info')) { d.reset(); app.mix.ui('back'); ui.toast('ALL SLIDERS RESET'); } if (a.pressed('alt')) { this.page = (this.page + 1) % pages; ui.focus = null; } SLIDERS.slice(this.page * per, this.page * per + per).forEach(([k, label, min, max, step], i) => { ui.slider(k, X, y0 + i * 26, W, label, d.tune[k], min, max, step, (v) => (d.tune[k] = v), { h: 22, dflt: TUNE_DEFAULTS[k] }); }); ui.text(X, ui.H - 30, `PAGE ${this.page + 1}/${pages}`, { color: 'mist' }); }\n    const sc = this.scene, sim = sc?.sim;\n    if (this.tab === 1) { if (!sim) ui.para(X, y0, 'NO RACE IS RUNNING. START ONE, THEN OPEN THIS FROM THE PAUSE MENU.', 30, { color: 'mist' }); else { const me = sim.player, ts = [0.25, 0.5, 1, 2, 4], e = app.ctx.engine, cur = ts.indexOf(e.timeScale); btn('teleport', 0, `TELEPORT +200 M (S=${Math.round(me.loc.s)})`, () => sim.teleport(me, me.loc.s + 200)); btn('finish', 1, `FINISH NOW, P${this.sub + 1}. L/R: PLACE`, () => { ui.clearStack(); app.paused = false; sim.finishNow(this.sub + 1); }); if (ui.focus === 'finish' && ui.leftRight) this.sub = (this.sub + ui.leftRight + sim.cars.length) % sim.cars.length; btn('end', 2, 'END RACE', () => { ui.clearStack(); app.paused = false; sim.finishRace(true); }); btn('restart', 3, 'RESTART', () => { ui.clearStack(); app.paused = false; app.restartRace(sc); }); btn('reset', 4, 'RESET CAR', () => sim.recover(me)); btn('speed', 5, `TIME SCALE X${e.timeScale}`, () => { e.timeScale = ts[(cur + 1) % 5]; }); btn('frame', 6, sc.frozen ? 'FROZEN: STEP ONE FRAME' : 'FREEZE', () => { if (!sc.frozen) sc.frozen = true; else sim.step([]); }); btn('save', 7, d.saved ? 'SAVE STATE (HAS ONE)' : 'SAVE STATE', () => (d.saved = sim.saveState())); btn('load', 8, 'LOAD STATE', () => { if (d.saved) sim.loadState(d.saved); }); btn('god', 9, `GOD MODE ${d.god ? 'ON' : 'OFF'}`, () => { d.god = !d.god; for (const c of sim.cars) if (c.seat >= 0) c.god = d.god; }); } }\n    if (this.tab === 2) { const rows = OVERLAYS.map(([k, l]) => [k, `${l}: ${d.overlays[k] ? 'ON' : 'OFF'}`, () => (d.overlays[k] = !d.overlays[k])]); rows.push(['freecam', `FREE CAMERA: ${d.freeCam ? 'ON' : 'OFF'}`, () => { d.freeCam = !d.freeCam; if (sc) sc.freeCam = null; }], ['debug', 'ENGINE DEBUG PANEL', () => app.ctx.engine.showDebug(!app.ctx.engine.debugShown)]); if (sim) rows.push(['hour', `HOUR ${(sc.hour ?? 12).toFixed(1)} (L/R)`, () => {}], ['rain', `RAIN: ${sim.setup.rain ? 'ON' : 'OFF'}`, () => app.devRestart(sc, { rain: !sim.setup.rain })], ['car', `CAR: ${CARS[sim.player.carId].shortName} (L/R)`, () => {}], ['field', `FIELD: ${sim.cars.length} (L/R)`, () => {}]); rows.push(['attract', 'START ATTRACT NOW', () => { ui.clearStack(); app.paused = false; app.attract.start(); }]); rows.forEach(([id, l, fn], i) => { if (ui.button(id, X, y0 + i * 18, W, 15, l, { left: true })) fn(); }); if (sim && ui.leftRight) { if (ui.focus === 'hour') { sc.hour = ((sc.hour ?? 12) + ui.leftRight + 24) % 24; app.setSkyNow(sc); } if (ui.focus === 'car') { const i = CAR_LIST.findIndex((c) => c.id === sim.player.carId), next = CAR_LIST[(i + ui.leftRight + CAR_LIST.length) % CAR_LIST.length].id; app.devRestart(sc, { car: next }); } if (ui.focus === 'field') app.devRestart(sc, { field: Math.max(1, Math.min(8, sim.cars.length + ui.leftRight)) }); } }\n    if (this.tab === 3) { const p = app.profile; if (!p) ui.para(X, y0, 'NO SAVE IS LOADED.', 30, { color: 'mist' }); else { const tests = TESTS, evs = EVENTS; btn('credits', 0, 'GIVE 100,000 CR', () => { p.credits += 100000; app.save(); ui.toast('100,000 CR'); }); btn('allcars', 1, 'UNLOCK ALL CARS', () => { for (const c of CAR_LIST) if (!p.cars.some((x) => x.id === c.id)) { p.cars.push({ uid: p.nextUid++, id: c.id, install: { parts: {}, settings: {}, tyre: null, paint: c.paint, rims: 0 }, km: 0, oilKm: 0, dirt: 0, wins: 0, prize: c.where === 'prize' }); p.seen[c.id] = true; } if (p.current == null) p.current = p.cars[0].uid; app.save(); ui.toast('ALL FOURTEEN CARS'); }); btn('gold', 2, 'ALL TESTS GOLD', () => { for (const l of LICENCES) for (const id of l.tests) applyTest(p, id, TEST[id].medals.gold - 0.01); app.save(); ui.toast('ALL GOLD'); }); btn('winev', 3, `WIN ROUND OF ${EVENT[evs[this.ev].id].name.slice(0, 12)} (L/R)`, () => { const e = evs[this.ev]; applyRound(p, e.id, [{ key: 'player', name: 'YOU', player: true }, { key: 'x', name: 'X' }]); app.save(); ui.toast('ROUND WON'); }); if (ui.focus === 'winev' && ui.leftRight) this.ev = (this.ev + ui.leftRight + evs.length) % evs.length; btn('jumpev', 4, `JUMP TO EVENT ${evs[this.ev].id} (L/R)`, () => { if (!p.cars.length) buyCar(p, 'kite'); ui.clearStack(); app.paused = false; app.startRace(careerRoundSetup(p, evs[this.ev].id)); }); if (ui.focus === 'jumpev' && ui.leftRight) this.ev = (this.ev + ui.leftRight + evs.length) % evs.length; btn('jumptest', 5, `JUMP TO TEST ${tests[this.test].id} (L/R)`, () => { ui.clearStack(); app.paused = false; app.startRace(licenceSetup(tests[this.test].id)); }); if (ui.focus === 'jumptest' && ui.leftRight) this.test = (this.test + ui.leftRight + tests.length) % tests.length; const menus = ['dealer', 'tuning', 'service', 'garage', 'museum', 'theatre', 'arcade', 'licence', 'events']; this.m ??= 0; btn('jumpmenu', 6, `JUMP TO ${menus[this.m].toUpperCase()} (L/R)`, () => { if (!p.cars.length) buyCar(p, 'kite'); ui.clearStack(); app.paused = false; app.toMenu({ screen: menus[this.m] }); }); if (ui.focus === 'jumpmenu' && ui.leftRight) this.m = (this.m + ui.leftRight + menus.length) % menus.length; btn('resetsave', 7, 'RESET THE SAVE', () => { app.profile = newProfile(); app.save(); ui.clearStack(); app.paused = false; app.toTitle(); }, { color: 'orange' }); } }\n    if (ui.backHit || a.pressed('pause')) { ui.backHit = false; app.mix.ui('back'); ui.pop(); return; }\n    ui.prompts(this.tab === 0 ? [['lr', 'CHANGE'], ['confirm', 'RESET ONE'], ['info', 'RESET ALL'], ['alt', 'PAGE'], ['tabs', 'TAB'], ['back', 'BACK']] : [['confirm', 'DO IT'], ['tabs', 'TAB'], ['back', 'BACK']]);\n    void tunedParams; void profileFor; } });\nE\ncat > src/game/attract/director.js <<'E'\n// Attract mode: after 10 s without input on the title or the Map, a looping demo. Any input stops it at once. It may cheat freely. The player's profile isn't touched.\nimport { tunedParams, emptyInstall } from '../sim/tuning.js';\nimport { licenceSetup } from '../sim/setups.js';\nimport { CARS } from '../data/cars.js';\nimport { TEST } from '../data/licences.js';\nimport { TITLE } from '../data/meta.js';\nimport { SPEAKERS } from '../audio/voice.js';\nimport { wrap, clean } from '../ui/ui.js';\nimport { SETS, MenuScene } from '../scenes/menu.js';\nimport { RaceScene } from '../scenes/race.js';\nimport { getTrack } from '../sim/race.js';\nconst god = (carId, skill, name, paint, o = {}) => { const install = { ...emptyInstall(), paint, ...o }; return { params: tunedParams(carId, install), name, ai: true, seat: -1, skill, carId, install, god: true }; };\nconst SHOW = ['kite', 'ginga', 'libeccio'];\nexport class Attract {\n  constructor(app) { this.app = app; this.active = false; this.i = 0; this.t = 0; this.loading = false; this.loops = 0; }\n  start() { const app = this.app; if (this.active || app.session) return; this.active = true; this.i = 0; this.t = 0; this.resumeRoute = app.currentRoute(); this.saved = { profile: app.profile }; app.ui.clearStack(); this.play(0); }\n  stop() { if (!this.active) return; const app = this.app; this.active = false; this.exiting = true; app.ui.clearStack(); app.bot = null; app.profile = this.saved.profile; app.ctx.engine.timeScale = 1; app.goScene(() => new MenuScene(app, this.resumeRoute)).then(() => { this.exiting = false; }); }\n  /** Each frame while it runs. */\n  update(ctx, dt) {\n    if (!this.active || this.exiting) return; const app = this.app, clip = CLIPS[this.i]; this.t += dt;\n    if (app.actions.touched && this.t > 0.15 && !this.ignoreInput) { this.stop(); return; }\n    if (!this.loading) { clip.tick?.(this, ctx, dt); this.drawCard(ctx); if (this.t >= clip.dur) this.play((this.i + 1) % CLIPS.length); }\n  }\n  async play(i) { this.i = i; this.t = 0; if (i === 0) this.loops++; const clip = CLIPS[i], app = this.app; this.loading = true; await clip.enter(this, app); this.loading = false; this.t = 0; }\n  async menu(set, args) { const app = this.app; if (!(app.scene instanceof MenuScene) || app.scene.attractSceneDone) await app.goScene(() => new MenuScene(app, null)); app.ui.clearStack(); app.scene.shotOverride = false; app.scene.setSet(set, args); }\n  async race(setup) { const app = this.app; await app.goScene(() => new RaceScene(app, { mode: 'attract', after: { kind: 'attract' }, rules: { contact: true, wearMult: 0, fuelMult: 0, pits: true }, seed: 3 + this.loops, ...setup })); }\n  drawCard(ctx) { const c = CLIPS[this.i], hud = ctx.hud; hud.rect(4, hud.height - 14, 30, 10, 'ink'); hud.text(6, hud.height - 12, 'DEMO', { color: 'orange' }); if (c.draw) c.draw(this, hud); if (Math.floor(this.t * 2) % 2 === 0) { const s = 'PRESS ANY BUTTON'; hud.text(hud.width - s.length * 6 - 6, hud.height - 12, s, { color: 'white' }); } }\n}\nconst bigCentered = (hud, y, s, sc, col) => { const t = clean(s); hud.text(Math.round(hud.width / 2 - (t.length * 6 * sc) / 2), y, t, { scale: sc, color: col }); };\nconst CLIPS = [\n  { name: 'title', dur: 3, async enter(a, app) { await a.menu('map', { title: true }); app.mix.music('title'); }, draw(a, hud) { bigCentered(hud, 40, 'GRANDPA', 4, 'white'); bigCentered(hud, 72, 'TURISMO', 4, 'sand'); bigCentered(hud, 110, TITLE ? 'DEMO' : '', 2, 'orange'); } },\n  { name: 'showroom', dur: 10, async enter(a, app) { await a.menu('showroom', { car: SHOW[0] }); app.mix.music('dealer'); a.k = -1; }, tick(a, ctx) { const app = a.app, k = Math.min(2, Math.floor(a.t / 3.33)); if (k !== a.k) { a.k = k; app.scene.showCarAt(SHOW[k]); app.ui.say(CARS[SHOW[k]].fenn ?? 'Precise, if you are.', SPEAKERS.fenn, { time: 3 }); } const c = CARS[SHOW[Math.max(0, a.k)]], lines = wrap(c.brochure, 40).slice(0, 4), hud = ctx.hud, x = hud.width - 250; hud.rect(x, 26, 244, 20 + lines.length * 10, 'ink'); hud.text(x + 4, 30, c.name, { color: 'sand' }); lines.forEach((l, i) => hud.text(x + 4, 42 + i * 10, l, { color: 'white' })); } },\n  { name: 'tuning', dur: 8, async enter(a, app) { const install = { ...emptyInstall(), paint: 'white' }; a.demoCar = { id: 'ginga', install }; await a.menu('tuning', { car: 'ginga', install }); app.mix.music('tuning'); app.scene.dynoOn = true; app.scene.spinRate = 0; app.scene.orbit = -2.3; app.mix.setCars([{ carId: 'ginga', params: { redline: 7300, exhaustUp: true } }]); a.wing = false; }, tick(a, ctx, dt) { const app = a.app, sc = app.scene, f = Math.min(1, a.t / 4.5), hud = ctx.hud, x = 12, y = 40, w = 180, h = 100; sc.dynoFrame?.(1500 + 5800 * f, f < 1 ? 1 : 0.1, dt); hud.rect(x - 4, y - 4, w + 8, h + 8, 'ink'); for (let i = 0; i < 44; i++) { const fr = i / 43, py = (p) => y + h - Math.round(h * p * Math.min(1, 0.45 + fr * 0.8) * (fr > 0.85 ? 1 - (fr - 0.85) * 0.5 : 1)); hud.rect(x + Math.round(fr * w), py(0.72), 2, 2, 'mist'); if (fr <= f) hud.rect(x + Math.round(fr * w), py(0.96), 2, 2, 'lime'); } if (a.t > 5 && !a.wing) { a.wing = true; a.demoCar.install.parts.aero = 2; sc.dynoEnd(); sc.showCarAt('ginga', a.demoCar.install); sc.orbit = 2.6; app.mix.ui('register'); app.ui.say('You now have more downforce. You also have more drag. There is no third thing.', SPEAKERS.benno, { time: 3 }); } } },\n  { name: 'licence', dur: 10, async enter(a) { await a.app.goScene(() => new RaceScene(a.app, { ...licenceSetup('B-1', 0, { demo: true }), attractClip: true })); a.medal = false; }, tick(a) { const sc = a.app.scene, sim = sc.sim; if (sim?.run?.over && !a.medal) { a.medal = true; a.app.mix.ui('medal'); } }, draw(a, hud) { if (a.medal) { bigCentered(hud, 60, 'GOLD', 3, 'sand'); bigCentered(hud, 90, TEST['B-1'].title, 1, 'white'); } bigCentered(hud, 30, TEST['B-1'].lesson, 1, 'white'); } },\n  { name: 'kestrel', dur: 20, async enter(a) { const f = ['ginga', 'brandt32', 'kite', 'ryu', 'longhorn', 'moth'].map((id, i) => god(id, 0.96 + i * 0.006, `D${i}`, ['red', 'white', 'blue', 'sand', 'navy', 'green'][i])); await a.race({ track: 'kestrel', laps: 3, hour: 15, start: 'rolling', cars: f, focus: 5, label: 'KESTREL PARK' }); a.app.scene.focusIdx = 5; a.app.scene.cameraSnap(); }, tick(a) { a.app.scene.camTV = a.t > 7; } },\n  { name: 'rally', dur: 12, async enter(a) { const c = [god('ryuRally', 0.98, 'RYU', 'cyan', { })]; await a.race({ track: 'redclay', laps: 2, hour: 17, start: 'standing', cars: c, rules: { contact: false, wearMult: 0, fuelMult: 0, pits: false }, onBuilt: (sim) => { sim.setGreen(); sim.phase = 'green'; const car = sim.cars[0]; sim.placeCar(car, 300, 0, 22); car.lap = 1; car.lapStart = 0; } }); a.app.mix.music('rally'); } },\n  { name: 'harbour', dur: 20, async enter(a) { const f = [god('heck', 0.96, 'A', 'mist'), god('libeccio', 0.965, 'B', 'red')]; await a.race({ track: 'harbour', laps: 5, hour: 21, start: 'rolling', cars: f, crew: true, rules: { contact: true, wearMult: 0, fuelMult: 0, pits: true, endurance: true }, onBuilt: (sim) => { sim.setGreen(); sim.phase = 'green'; f.forEach((o, i) => { const c = sim.cars[i]; sim.placeCar(c, sim.tr.length - 950 - i * 16, 0, 40); c.lap = 1; }); sim.cars[1].wantPit = true; } }); a.app.scene.focusIdx = 1; a.app.scene.cameraSnap(); a.app.mix.music('night'); await a.app.scene.buildCrew?.(a.app.ctx).catch?.(() => {}); }, tick(a) { const sc = a.app.scene, c = sc.sim.cars[1]; sc.camTV = a.t > 13 && !c.pit; if (c.pit?.state === 'in' && !c.pitWide) { c.pitWide = true; } } },\n  { name: 'saltline', dur: 10, async enter(a) { const f = [god('type9', 1.0, 'A', 'teal'), god('corsa', 1.05, 'B', 'sand')]; await a.race({ track: 'saltline', laps: 5, hour: 18.5, start: 'rolling', cars: f, onBuilt: (sim) => { sim.setGreen(); sim.phase = 'green'; sim.placeCar(sim.cars[0], 900, 0, 76); sim.placeCar(sim.cars[1], 880, 0, 80); sim.cars.forEach((c) => (c.lap = 1)); } }); a.app.scene.focusIdx = 1; a.app.scene.chase.mode = 1; a.app.scene.cameraSnap(); } },\n  { name: 'podium', dur: 8, async enter(a, app) { await a.app.goScene(() => new MenuScene(app, null)); app.ui.clearStack(); app.mix.music('credits'); const sc = app.scene; sc.setSet('reveal', { car: 'type9' }); sc.lights[0].intensity = 26; sc.lights[1].intensity = 18; app.ctx.engine.ambient.intensity = 0.6; sc.sets.reveal.userData.cover.position.set(0, 0.12, 0); sc.spinRate = 0.3; a.step = 0; const X = SETS.reveal.x; a.X = X; }, tick(a, ctx) { const sc = a.app.scene; if (a.t > 1.5 && a.step === 0) { a.step = 1; ctx.tweens.to(sc.sets.reveal.userData.cover.position, { x: 9, y: 2.4 }, { duration: 1.2, ease: 'inOutSine' }); a.app.mix.ui('fanfare2'); ctx.particles.burst('confetti', [a.X, 4, 0]); } }, draw(a, hud) { if (a.t > 2.5) bigCentered(hud, 30, CARS.type9.name, 1, 'sand'); } },\n  { name: 'credits', dur: 4, async enter(a) { await a.menu('map', { title: true }); }, draw(a, hud) { hud.rect(0, 0, hud.width, hud.height, 'ink'); bigCentered(hud, 70, 'GRANDPA TURISMO', 3, 'sand'); bigCentered(hud, 120, 'PRESS ANY BUTTON', 2, 'white'); } },\n];\nvoid getTrack;\nE\ncat > src/game/net/hub.js <<'E'\n// AI Hub session: ghost mode. Every copy runs its own physics; others are drawn as ghosts through a 150 ms buffer.\nimport { Engine, withUrlOptions, THREE, PALETTE } from '../../pixel-engine.js';\nimport { RaceScene } from '../scenes/race.js';\nimport { hubRoundSetup, SEAT_COLORS } from '../sim/setups.js';\nimport { CarView } from '../render/carview.js';\nimport { fmtTime, clean } from '../ui/ui.js';\nimport { CONTROLS_TEXT } from '../data/text.js';\nimport { TRACKS } from '../data/tracks.js';\nimport { CARS } from '../data/cars.js';\nimport { drawMap } from '../ui/racehud.js';\nimport { TITLE } from '../data/meta.js';\nimport { scr } from '../ui/screens/common.js';\nconst { Vector3 } = THREE;\nexport class Session {\n  constructor(app, hub, info) { this.app = app; this.hub = hub; this.info = info; this.card = { left: null, ready: [], asking: 0, asked: false, starting: false, paused: false }; this.started = false; this.finishedDone = false; this.ghosts = new Map(); this.lastSend = 0; this.over = false; this.lastPad = {}; this.onKey = (e) => this.key(e); this.tagV = new Vector3(); }\n  get me() { return this.info.me; }\n  wire() {\n    const h = this.hub;\n    h.on('card', (c) => (this.card = c)); h.on('start', () => { this.started = true; });\n    h.on('message', (d, from) => this.receive(d, from)); h.on('leave', ({ id }) => this.remove(id));\n    h.on('time-up', () => this.timeUp()); h.on('end', () => this.end());\n    addEventListener('keydown', this.onKey);\n    addEventListener('pointerdown', (e) => this.pointer(e));\n  }\n  key(e) { if (this.hub.time() !== -Infinity) return; if (e.code === 'Enter') this.hub.answer('ready'); if (e.code === 'KeyM') this.hub.answer('more'); }\n  pointer(e) { if (this.hub.time() !== -Infinity) return; const y = e.clientY / innerHeight, x = e.clientX / innerWidth; if (y > 0.74 && y < 0.92) { if (x < 0.5) this.hub.answer('ready'); else this.hub.answer('more'); } }\n  /** Per frame from RaceScene.afterStep: lights, ghost send, progress. */\n  tick(sim) {\n    const h = this.hub, t = h.time(), me = sim.player, scene = this.app.scene;\n    if (!this.started) return;\n    if (t < 0) { const n = Math.min(3, Math.floor(t / 1000) + 4); if (n !== this.lights) { this.lights = n; if (n > 0) this.app.mix.play('beepLow'); } sim.lights = Math.max(0, n); sim.phase = 'lights'; return; }\n    if (!sim.green) sim.go();\n    const now = performance.now();\n    if (now - this.lastSend >= 100 && !this.over) {\n      this.lastSend = now; const r = (v) => Math.round(v * 10) / 10;\n      h.send({ t: 'g', a: sim.setup.track, x: r(me.x), y: r(me.y), z: r(me.z), yaw: Math.round(me.yaw * 100) / 100, v: r(me.u), s: Math.round(me.loc.s), lap: me.lap, steer: Math.round(me.delta * 100) / 100, br: (me.lastInp?.brake ?? 0) > 0.1 ? 1 : 0 }, { reliable: false });\n      const metres = Math.max(0, sim.metresOf(me)); this.metres = metres;\n      if (!this.finishedDone) h.progress({ score: Math.floor(metres), label: me.lap === 0 ? 'GRID' : `LAP ${Math.min(me.lap, sim.laps)}/${sim.laps} P${this.place(sim, metres)}` });\n    }\n    void scene;\n  }\n  place(sim, metres) { let p = 1; for (const g of this.ghosts.values()) { const m = g.lap > 0 ? (g.lap - 1) * sim.tr.length + g.s : 0; if (m > metres) p++; } return p; }\n  receive(d, from) { if (d?.t === 'g') { let g = this.ghosts.get(from); if (!g) { g = { id: from, buf: [], view: null, lap: 0, s: 0 }; this.ghosts.set(from, g); } g.buf.push({ at: performance.now(), ...d }); if (g.buf.length > 20) g.buf.shift(); g.lap = d.lap; g.s = d.s; g.a = d.a; } if (d?.t === 'done') { const g = this.ghosts.get(from); if (g) g.done = d.time; } }\n  remove(id) { const g = this.ghosts.get(id); g?.view?.dispose(); this.ghosts.delete(id); }\n  finished(e) { if (this.finishedDone) return; this.finishedDone = true; const sim = this.app.scene.sim, me = sim.player, stats = { 'Best lap': isFinite(me.bestLap) ? Math.round(me.bestLap * 100) / 100 : 0, 'Top km/h': Math.round(me.topSpeed * 3.6), Walls: me.walls }, awards = me.walls === 0 ? [{ title: 'NO WALLS', detail: 'The barriers were not disturbed.' }] : []; this.hub.result({ time: Math.round(this.hub.time()), stats, awards }); this.hub.send({ t: 'done', time: e.time }); void e; }\n  timeUp() { if (this.finishedDone) return; this.finishedDone = true; const sim = this.app.scene?.sim, me = sim?.player; this.hub.result({ score: Math.floor(Math.max(0, me ? sim.metresOf(me) : 0)), stats: me ? { 'Top km/h': Math.round(me.topSpeed * 3.6), Walls: me.walls } : {} }); }\n  end() { this.over = true; removeEventListener('keydown', this.onKey); this.app.mix.stopEverything(); this.app.frozenInput = true; if (this.app.scene) this.app.scene.frozen = true; }\n  toggleMenu() { const ui = this.app.ui; if (ui.top?.id === 'sessionmenu' ) { ui.pop(); return; } if (!ui.top) ui.push(SessionMenu()); }\n  // ---- draw ghosts in the scene\n  drawGhosts(scene, dt) {\n    const now = performance.now() - 150, ctx = scene.ctx, carId = scene.sim.player.carId;\n    for (const g of this.ghosts.values()) {\n      if (g.a && g.a !== scene.setup.track) continue;\n      if (!g.view) { const seat = this.info.players.find((p) => p.id === g.id), col = seat?.color ? parseInt(seat.color.slice(1), 16) : PALETTE[SEAT_COLORS[g.id % 4]]; g.view = new CarView(carId, null, { ghost: col }); ctx.scene.add(g.view.root); g.name = clean(seat?.name ?? `P${g.id + 1}`) || `P${g.id + 1}`; if (/[^A-Z0-9 .,'-]/.test(g.name)) g.name = `P${g.id + 1}`; g.colorName = SEAT_COLORS[g.id % 4]; }\n      const b = g.buf; if (!b.length) continue; let a = b[0], c = b[b.length - 1]; for (let i = 0; i < b.length - 1; i++) if (b[i].at <= now && b[i + 1].at >= now) { a = b[i]; c = b[i + 1]; break; }\n      const f = c.at > a.at ? Math.max(0, Math.min(1, (now - a.at) / (c.at - a.at))) : 1; let dy = c.yaw - a.yaw; if (dy > Math.PI) dy -= 2 * Math.PI; if (dy < -Math.PI) dy += 2 * Math.PI;\n      g.pos = { x: a.x + (c.x - a.x) * f, y: a.y + (c.y - a.y) * f, z: a.z + (c.z - a.z) * f, yaw: a.yaw + dy * f, u: c.v, delta: c.steer, brake: !!c.br, s: c.s };\n      g.view.pose(g.pos, dt, null);\n    }\n  }\n  /** Name tags and the card. */\n  drawOver(scene, ctx) {\n    const hud = ctx.hud, cam = ctx.camera.camera; cam.updateMatrixWorld();\n    for (const g of this.ghosts.values()) { if (!g.pos || !g.view) continue; const v = this.tagV.set(g.pos.x, g.pos.y + 1.9, g.pos.z).project(cam); if (v.z < 1 && v.z > -1) { const x = Math.round(((v.x + 1) / 2) * hud.width), y = Math.round(((1 - v.y) / 2) * hud.height); hud.text(x - g.name.length * 3, y, g.name, { color: g.colorName }); } }\n    if (this.hub.time() === -Infinity || !this.started) this.drawCard(scene, ctx);\n    if (this.touchBlocked()) { hud.rect(hud.width / 2 - 120, 110, 240, 20, 'ink'); hud.text(hud.width / 2 - 93, 116, 'CONTROLLER OR KEYBOARD REQUIRED', { color: 'sand' }); }\n  }\n  touchBlocked() { return this.app.touchGate(); }\n  drawCard(scene, ctx) {\n    const hud = ctx.hud, W = hud.width, H = hud.height, s = scene.setup, c = this.card, cx = W / 2, a = this.app.actions, dev = a.device === 'pad' ? 'pad' : 'kb';\n    hud.rect(cx - 170, 14, 340, 226, 'ink'); hud.text(cx - (TITLE.length * 12) / 2, 22, TITLE, { scale: 2, color: 'sand' });\n    hud.text(cx - 160, 44, clean(`${TRACKS[s.track].name}. ${s.laps} LAPS. ${CARS[s.hubCar].shortName}${s.rain ? '. RAIN' : ''}`), { color: 'white' });\n    hud.text(cx - 160, 56, 'LOWEST TIME WINS: SAME CAR, SAME TRACK.', { color: 'lime' });\n    this.info.players.forEach((p, i) => { const col = SEAT_COLORS[p.id % 4], name = /^[\\x20-\\x7e]+$/.test(p.name ?? '') ? clean(p.name).slice(0, 14) : `P${p.id + 1}`; hud.rect(cx - 160, 70 + i * 12, 8, 8, col); hud.text(cx - 148, 71 + i * 12, name, { color: 'white' }); hud.text(cx - 40, 71 + i * 12, (c.ready ?? []).includes(p.id) ? 'READY' : '...', { color: (c.ready ?? []).includes(p.id) ? 'lime' : 'mist' }); });\n    if (scene.map) drawMap(hud, scene.map, cx + 96, 68, [], null);\n    CONTROLS_TEXT[dev].forEach((l, i) => hud.text(cx - 160, 124 + i * 10, l, { color: 'white' }));\n    const left = c.left == null ? (c.starting ? 'STARTING' : c.paused ? 'HELD' : '') : `${Math.ceil(c.left / 1000)} S`; hud.text(cx + 100, 44, left, { color: 'sand' });\n    hud.rect(cx - 160, 190, 150, 30, c.asked ? 'night' : 'navy'); hud.text(cx - 148, 202, dev === 'pad' ? 'CROSS: READY' : 'ENTER: READY', { color: (c.ready ?? []).includes(this.me) ? 'lime' : 'white' });\n    hud.rect(cx + 10, 190, 150, 30, c.asked ? 'plum' : 'navy'); hud.text(cx + 20, 202, dev === 'pad' ? 'TRIANGLE: MORE TIME' : 'M: MORE TIME', { color: c.asked ? 'sand' : 'white' }); if (c.asking) hud.text(cx + 20, 180, `${c.asking} ASKED FOR TIME`, { color: 'mist' });\n    if (a.pressed('confirm')) this.hub.answer('ready'); if (a.pressed('info')) this.hub.answer('more');\n  }\n}\nconst SessionMenu = () => scr('sessionmenu', { overlay: true, draw(ui) { const app = ui.app; ui.panel(ui.cx - 80, 60, 160, 92, 'ink', 'slate'); ui.center(66, 'THE ROUND GOES ON', { color: 'sand' }); [['sound', 'SOUND AND BUTTONS'], ['handbook', 'HANDBOOK'], ['resume', 'BACK']].forEach(([id, l], i) => { if (ui.button(id, ui.cx - 70, 80 + i * 22, 140, 18, l)) { if (id === 'sound') ui.push(app.screens.Settings()); if (id === 'handbook') ui.push(app.screens.Handbook()); if (id === 'resume') ui.pop(); } }); if (ui.backHit) { ui.backHit = false; ui.pop(); } ui.prompts([['confirm', 'SELECT'], ['back', 'BACK']]); } });\nexport async function startHub(app, hub, container) {\n  const info = await hub.connect({ mode: 'ghost', seats: [1, 4], card: true });\n  if (!info) return null;\n  const session = new Session(app, hub, info); app.session = session; session.wire();\n  const setup = hubRoundSetup(hub.rng('round'), info.players); setup.seed = info.seed;\n  try {\n    const engine = await Engine.start(new RaceScene(app, setup), withUrlOptions(app.engineOptions(container, { seed: info.seed })));\n    app.engine = engine; hub.ready();\n    return engine;\n  } catch (e) { hub.fail(`This game needs WebGPU: ${e?.message ?? e}`); throw e; }\n}\nvoid fmtTime;\nE\ncat > src/game/net/couch.js <<'E'\n// Couch Duel: two players, one TV, split screen. One RaceSim is shared: P1's scene steps it, P2's only draws it.\nimport { Engine } from '../../pixel-engine.js';\nimport { RaceScene } from '../scenes/race.js';\nexport class Couch {\n  constructor(app) { this.app = app; this.engine2 = null; }\n  async start(setup) {\n    const app = this.app, p1 = document.getElementById('p1'), p2 = document.getElementById('p2');\n    app.couch = true; p1.style.width = p2.style.width = '50vw'; p2.style.display = 'block';\n    await app.goScene(() => new RaceScene(app, setup));\n    const scene = app.scene;\n    this.engine2 = await Engine.start(new RaceScene(app, setup, { viewer: true, sim: scene.sim, seat: 1 }), { container: p2, camera: { preset: 'fixed', position: [0, 5, -10], target: [0, 1, 0], fov: 58, minZoom: 1, maxZoom: 1 }, settings: { button: false, key: false }, touch: false, seed: 9, debugUI: false });\n    this.engine2.audio.persist = false; this.engine2.audio.setMuted(true); this.engine2.input.gamepadButtons = {}; this.engine2.input.gamepadLookSpeed = 0;\n    app.engine.input.gamepadButtons = {};\n    scene.hold = 0;\n  }\n  end() { if (!this.engine2) { this.app.couch = false; return; } const app = this.app, e2 = this.engine2; this.engine2 = null; app.couch = false; try { e2.dispose(); } catch (err) { console.warn(err); } const p1 = document.getElementById('p1'), p2 = document.getElementById('p2'); p2.style.display = 'none'; p2.style.width = ''; p1.style.width = '100vw'; }\n}\nE\ncat > src/game/app.js <<'E'\n// App: profile, settings, input, audio mix, scene switching.\nimport { Engine, withUrlOptions, LOOK_PRESETS } from '../pixel-engine.js';\nimport { Actions } from './input/actions.js';\nimport { pollPads } from './input/pad.js';\nimport { UI } from './ui/ui.js';\nimport { Mix } from './audio/mix.js';\nimport { MenuScene } from './scenes/menu.js';\nimport { RaceScene } from './scenes/race.js';\nimport { ReplayScene } from './scenes/replay.js';\nimport { DevState, Dev } from './dev/devmode.js';\nimport { Attract } from './attract/director.js';\nimport { Couch } from './net/couch.js';\nimport { SAVE_KEY, SETTINGS_KEY, TITLE } from './data/meta.js';\nimport { TRACKS } from './data/tracks.js';\nimport { newProfile, migrate, applyRound, applyTest, addMileage, carRec, record } from './sim/career.js';\nimport { EVENT } from './data/events.js';\nimport { TEST } from './data/licences.js';\nimport { setSky } from './render/sky.js';\nimport { licenceSetup, quickRaceSetup, couchSetup } from './sim/setups.js';\nimport { b64, unb64 } from './scenes/race.js';\nimport * as Title from './ui/screens/title.js';\nimport * as Lic from './ui/screens/licence.js';\nimport * as Ev from './ui/screens/events.js';\nimport { Dealer } from './ui/screens/dealer.js';\nimport { Tuning, Service } from './ui/screens/tuning.js';\nimport { Garage, Museum, Theatre } from './ui/screens/garage.js';\nimport { Arcade } from './ui/screens/arcade.js';\nimport { Settings, Handbook, About } from './ui/screens/settings.js';\nimport { Pause, Results, LicenceResult } from './ui/screens/race.js';\nimport { Podium, PrizeReveal, Ending } from './ui/screens/podium.js';\nconst storage = () => { try { return typeof localStorage !== 'undefined' ? localStorage : null; } catch { return null; } };\nconst DEFAULT_SETTINGS = { voices: 0.8, raceMusic: true, glyphs: 'ps', vibration: true, steerCurve: 1.4, mouseSteer: false, units: 'kmh', musicSet: false };\nexport class App {\n  constructor() {\n    this.actions = new Actions(this); this.ui = new UI(this); this.mix = new Mix(this); this.dev = new DevState(); this.attract = new Attract(this); this.couchMgr = new Couch(this);\n    this.settings = { ...DEFAULT_SETTINGS, ...this.readJSON(SETTINGS_KEY) }; this.profile = this.loadProfile(); this.scene = null; this.paused = false; this.couch = false; this.session = null; this.bot = null; this.lastResult = null; this.lastReplay = null; this.loading = false; this.keySeen = false; this.cursorIdle = 0; this.fresh = !this.settings.musicSet;\n    this.screens = { Map: Title.MapScreen, MapPause: Title.MapPause, Title: Title.TitleScreen, Greet: Title.GreetScreen, LicenceCentre: Lic.LicenceCentre, TestList: Lic.TestList, TestCard: Lic.TestCard, EventHall: Ev.EventHall, EventCard: Ev.EventCard, RoundCard: Ev.RoundCard, Dealer, Tuning, Service, Garage, Museum, Theatre, Arcade, Settings, Handbook, About, Dev, Pause, Results, LicenceResult };\n    if (typeof addEventListener !== 'undefined') { addEventListener('keydown', () => { this.keySeen = true; this.actions.anyKeyEvent = true; }); addEventListener('mousemove', () => (this.cursorIdle = 0)); }\n  }\n  readJSON(k) { try { const s = storage()?.getItem(k); return s ? JSON.parse(s) : null; } catch { return null; } }\n  loadProfile() { const p = this.readJSON(SAVE_KEY); return p ? migrate(p) : null; }\n  hasSave() { return !!this.readJSON(SAVE_KEY); }\n  save() { if (!this.profile || this.session) return true; try { storage()?.setItem(SAVE_KEY, JSON.stringify(this.profile)); return true; } catch { return false; } }\n  saveSettings() { try { storage()?.setItem(SETTINGS_KEY, JSON.stringify(this.settings)); } catch { /* storage refused */ } }\n  resetSettings() { Object.assign(this.settings, DEFAULT_SETTINGS); this.saveSettings(); const a = this.mix.audio; a?.resetVolumes(); a?.setVolume('music', 0.1); this.ctx?.engine.settings.reset(); }\n  assistsTarget() { return (this.profile ??= newProfile()).assists; }\n  engineOptions(container, o = {}) { return { container, camera: { preset: 'fixed', position: [0, 5, -10], target: [0, 1, 0], fov: 58, minZoom: 1, maxZoom: 1 }, settings: { button: false }, touch: false, look: LOOK_PRESETS.none, background: 0x1a1c2c, ...o }; }\n  /** Called by every scene's setup. */\n  bind(ctx, scene) {\n    this.ctx = ctx; this.scene = scene; this.hud = ctx.hud; this.engine = ctx.engine; this.mix.bind(ctx); this.ui.prompted = false;\n    const input = ctx.input; input.gamepadButtons = {}; input.gamepadLookSpeed = 0; for (const k of ['Tab', 'F1', 'F2', 'ControlLeft', 'Backspace', 'Slash', 'Period', 'Comma']) input.preventKeys.add(k);\n    // first launch and every hub round: music at 10%.\n    if (!this.settings.musicSet) { ctx.audio.setVolume('music', 0.1); }\n  }\n  onReady(ctx, scene) { if (typeof window !== 'undefined') window.__GAME__ = this.hook(); void ctx; void scene; }\n  frameStart(ctx) { return this.actions.latch(ctx); }\n  /** End of update: UI, attract, pads, cursor. */\n  frameEnd(ctx, dt, skipUi = false) {\n    this.realDt = dt;\n    this.attract.update(ctx, dt);\n    if (!skipUi && !this.attract.active) { if (this.ui.top) this.ui.frame(dt); else if (this.ui.subtitle || this.ui.toasts.length) { this.ui.dt = dt; if (this.ui.subtitle) this.ui.drawSubtitle(dt); this.ui.drawToasts(dt); } }\n    else if (this.attract.active && this.ui.subtitle) this.ui.drawSubtitle(dt);\n    if (this.session) { const s = this.scene; if (s?.sim) this.session.drawOver(s, ctx); }\n    if (this.ui.top?.attract && !this.attract.active && !this.session && this.actions.idle > 10) this.attract.start();\n    if (this.url?.attract && !this.attractDone) { this.attractDone = true; this.attract.start(); }\n    pollPads(ctx.input);\n    if (!this.mix.audio?.unlocked && this.actions.anyInput && this.actions.device === 'pad') this.mix.audio?.unlock();\n    this.mix.ensureGraph(); this.mix.updateLevels();\n    this.cursorIdle += dt; if (typeof document !== 'undefined') { const hide = this.cursorIdle > 2 || (this.scene instanceof RaceScene && !this.paused && !this.ui.top); document.body.style.cursor = hide ? 'none' : 'default'; }\n  }\n  touchGate() { if (typeof matchMedia === 'undefined') return false; if (this.keySeen || this.actions.pads.length || this.actions.sawKey) return false; return !matchMedia('(any-pointer: fine)').matches && matchMedia('(pointer: coarse)').matches; }\n  inRace() { return this.scene instanceof RaceScene; }\n  tracksName(id) { return TRACKS[id].name.toUpperCase(); }\n  async goScene(make) {\n    if (this.loading) return; this.loading = true; const e = this.engine;\n    try {\n      const fx = !this.instant && e.screen?.cover ? e.screen : null;\n      if (fx) await fx.cover('wipe', { duration: 0.22 });\n      this.mix.clearEngines(); e.timeScale = 1; this.paused = false;\n      await e.loadGame(make());\n      if (fx) fx.reveal('wipe', { duration: 0.25 });\n    } finally { this.loading = false; }\n  }\n  // ---- routes\n  currentRoute() { const t = this.ui.top; return t?.id === 'map' ? { screen: 'map' } : { screen: 'title' }; }\n  toTitle() { this.couchMgr.end(); this.ui.clearStack(); return this.goScene(() => new MenuScene(this, { screen: 'title' })); }\n  toMap() { this.couchMgr.end(); this.ui.clearStack(); return this.goScene(() => new MenuScene(this, { screen: 'map' })); }\n  toMenu(route) { this.couchMgr.end(); this.ui.clearStack(); return this.goScene(() => new MenuScene(this, route)); }\n  applyRoute(r) {\n    const ui = this.ui, s = this.screens; ui.clearStack(); const route = r ?? { screen: 'title' };\n    if (route.screen === 'title' || !this.profile && route.screen !== 'title') { ui.push(s.Title()); return; }\n    if (route.screen === 'none') return;\n    ui.push(s.Map());\n    const open = { map: null, dealer: () => s.Dealer(route.room ?? 0, route.car ?? 0), tuning: () => s.Tuning(), service: () => s.Service(), garage: () => s.Garage(), museum: () => s.Museum(), theatre: () => s.Theatre(), arcade: () => s.Arcade(), licence: () => s.LicenceCentre(), tests: () => s.TestList(route.lic), testcard: () => s.TestCard(route.id), events: () => s.EventHall(), eventcard: () => s.EventCard(route.id), roundcard: () => s.RoundCard(route.id), results: () => (this.lastResult?.licence ? s.LicenceResult() : s.Results()) }[route.screen];\n    if (route.screen === 'tests' || route.screen === 'testcard') ui.push(s.LicenceCentre()); if (route.screen === 'testcard') ui.push(s.TestList(route.id[0]));\n    if (route.screen === 'eventcard' || route.screen === 'roundcard') ui.push(s.EventHall()); if (route.screen === 'roundcard') ui.push(s.EventCard(route.id));\n    if (open) { const sc = open(); ui.push(sc); }\n    if (route.then) route.then(this);\n  }\n  newGame() { this.profile = newProfile(); this.save(); this.ui.clearStack(); this.ui.push(this.screens.Greet()); }\n  onboard() { /* the Map's nudge takes it from here */ }\n  // ---- racing\n  startRace(setup) { this.couchMgr.end(); this.ui.clearStack(); this.paused = false; return this.goScene(() => new RaceScene(this, setup)); }\n  startCouch(setup) { this.ui.clearStack(); return this.couchMgr.start(setup); }\n  startReplay(data, back) { this.couchMgr.end(); this.ui.clearStack(); return this.goScene(() => new ReplayScene(this, data, back)); }\n  leaveReplay(back) { this.ui.clearStack(); return this.goScene(() => new MenuScene(this, back)); }\n  pause(scene) { this.ui.push(Pause(scene)); this.paused = true; this.mix.quietDriving(); }\n  restartRace(sc) { const s = sc.setup; if (s.mode === 'couch') { this.couchMgr.end(); return this.startCouch(s); } return this.startRace(s); }\n  restartTrialLap(sc) { const sim = sc.sim, me = sim.player; sim.placeCar(me, sim.tr.length - 12, 0, 0); me.lap = 0; me.prevS = me.loc.s; me.lapStart = sim.t; me.midSeen = false; sc.trial.cur = []; sc.chase.snap(); }\n  devRestart(sc, o) { const s = { ...sc.setup }; if (o.rain != null) s.rain = o.rain; const me = sc.sim.player; if (o.car) { const i = s.cars.findIndex((c) => c.seat === 0); if (s.mode === 'arcade' || s.mode === 'race' || s.mode === 'testdrive' || s.mode === 'trial') { s.cars = s.cars.slice(); const q = quickRaceSetup({ track: s.track, carId: o.car, field: 1, pace: 0.9 }).cars[0]; s.cars[i] = { ...q }; } } if (o.field && s.mode !== 'licence') { const carId = me.carId; const q = quickRaceSetup({ track: s.track, carId, field: o.field, pace: 0.92 }); s.cars = q.cars; } this.ui.clearStack(); this.paused = false; return this.startRace(s); }\n  setSkyNow(sc) { setSky(this.ctx.engine, sc.hour, { rain: sc.setup.rain }); }\n  retire(sc) {\n    const a = sc.setup.after;\n    if (a.kind === 'career') return this.toMenu({ screen: 'eventcard', id: a.eventId });\n    if (a.kind === 'licence') return this.toMenu({ screen: 'testcard', id: a.testId });\n    if (a.kind === 'route') return this.toMenu(a.route);\n    return this.toMenu({ screen: 'arcade' });\n  }\n  raceOver(scene) {\n    const { setup, sim } = scene, a = setup.after, p = this.profile, dev = this.dev.dirty;\n    this.lastReplay = sim.replayData();\n    if (setup.mode === 'attract' || scene.setup.attractClip || this.attract.active) return;\n    if (setup.mode === 'hub') return;\n    if (a.kind === 'route') { return this.toMenu(a.route); }\n    if (a.kind === 'licence') return this.licenceOver(scene);\n    const rows = sim.results ?? [];\n    const res = { setup, rows, replay: this.lastReplay, outcome: null, saved: false };\n    if (a.kind === 'career') {\n      res.snapshot = JSON.stringify(p);\n      const me = sim.player, rec = carRec(p); addMileage(p, rec, me.metres, setup.track === 'redclay' ? 0.34 : 0);\n      for (const c of sim.cars) p.seen[c.carId] = true;\n      res.outcome = applyRound(p, a.eventId, rows.map((r) => ({ key: r.key, name: r.name, player: r.player })), this.dev.tune.prize);\n      res.outcome.eventName = EVENT[a.eventId].name; res.eventId = a.eventId;\n      if (isFinite(me.bestLap) && !dev && record(p, setup.track, me.bestLap, me.carId)) res.recordLap = me.bestLap;\n      this.save();\n    }\n    this.lastResult = res; this.ui.clearStack(); this.ui.push(Results());\n  }\n  licenceOver(scene) {\n    const { setup, sim } = scene, a = setup.after, R = sim.run, p = this.profile, test = TEST[a.testId], total = a.times + (R.total ?? R.time);\n    // three layouts: the next car, times added\n    if (test.runs && !R.failed && a.run < test.runs.length - 1) { return this.startRace(licenceSetup(a.testId, a.run + 1, { times: total, demo: a.demo })); }\n    if (a.demo) return this.toMenu({ screen: 'testcard', id: a.testId });\n    const outcome = applyTest(p, a.testId, total, R.failed, this.dev.dirty); this.save();\n    this.lastResult = { licence: true, setup, testId: a.testId, time: total, failed: R.failed, reason: R.reason, hits: R.hits, outcome, replay: this.lastReplay };\n    this.ui.clearStack(); this.ui.push(LicenceResult());\n  }\n  continueAfterResult() {\n    const R = this.lastResult, a = R.setup.after;\n    if (R.licence) return this.toMenu({ screen: 'tests', lic: R.testId[0] });\n    if (a.kind === 'career') {\n      const o = R.outcome, id = a.eventId;\n      if (o.seriesOver && o.seriesWon) return this.toMenu({ screen: 'map', then: (app) => app.seriesEnd(o) });\n      if (o.seriesOver) return this.toMenu({ screen: 'eventcard', id });\n      return this.toMenu({ screen: 'roundcard', id });\n    }\n    return this.toMenu({ screen: 'arcade' });\n  }\n  seriesEnd(o) { const ui = this.ui, afterPrize = () => { if (o.ending) ui.replace(Ending()); else ui.pop(); }, afterPodium = () => { if (o.prizeCar) ui.replace(PrizeReveal(o.prizeCar, afterPrize)); else afterPrize(); }; ui.push(Podium(o, afterPodium)); }\n  retryResult() { const R = this.lastResult; if (R.snapshot) this.profile = JSON.parse(R.snapshot); this.save(); const a = R.setup.after; if (a.kind === 'career') return this.startRace(R.setup); return this.startRace(R.setup); }\n  watchResult() { const R = this.lastResult; return this.startReplay(R.replay, { screen: 'results' }); }\n  packReplay(d) { const every = Math.max(1, Math.round(d.hz / 10)), n = Math.floor(d.n / every), cars = d.data.map((a) => { const o = new Int16Array(n * 7); for (let i = 0; i < n; i++) { const k = i * every * 12, q = i * 7; o[q] = Math.round(a[k] * 4); o[q + 1] = Math.round(a[k + 1] * 16); o[q + 2] = Math.round(a[k + 2] * 4); o[q + 3] = Math.round(((a[k + 3] % 6.2832) + 6.2832) % 6.2832 * 4000); o[q + 4] = Math.round(a[k + 7] / 2); o[q + 5] = a[k + 10]; o[q + 6] = Math.round(a[k + 11] * 16); } return b64(o); }); return { track: d.track, hour: d.hour, rain: d.rain, n, label: d.label, cars: d.cars, data: cars, day: this.profile.day }; }\n  unpackReplay(s) { const data = s.data.map((str) => { const o = unb64(str), a = new Float32Array(s.n * 12); for (let i = 0; i < s.n; i++) { const k = i * 12, q = i * 7; a[k] = o[q] / 4; a[k + 1] = o[q + 1] / 16; a[k + 2] = o[q + 2] / 4; a[k + 3] = o[q + 3] / 4000; a[k + 7] = o[q + 4] * 2; a[k + 8] = 0.6; a[k + 9] = 3; a[k + 10] = o[q + 5]; a[k + 11] = o[q + 6] / 16; } return a; }); return { track: s.track, hour: s.hour, rain: s.rain, n: s.n, hz: 10, label: s.label, cars: s.cars, data }; }\n  saveReplay(d) { const p = this.profile; if (!p) return false; try { const s = this.packReplay(d); const prev = p.replays.slice(); p.replays.unshift(s); p.replays = p.replays.slice(0, 3); if (!this.save()) { p.replays = prev; this.save(); return false; } return true; } catch { return false; } }\n  toggleFullscreen() { if (typeof document === 'undefined') return; if (document.fullscreenElement) document.exitFullscreen?.(); else document.documentElement.requestFullscreen?.()?.catch?.(() => {}); }\n  // ---- test hooks\n  hook() { const app = this; return { app, state() { const s = app.scene, u = app.ui; return { scene: s?.name, screen: u.top?.id ?? null, stack: u.stack.map((x) => x.id), focus: u.focus, items: u.items.map((i) => i.id), prompts: (u.promptList ?? []).map((p) => p[1]), device: app.actions.device, idle: app.actions.idle, attract: app.attract.active, clip: app.attract.i, paused: app.paused, loading: app.loading, status: s?.status?.(), music: app.mix.audio?.volume?.music, profile: app.profile ? { credits: app.profile.credits, day: app.profile.day, cars: app.profile.cars.map((c) => c.id), licences: app.profile.licences } : null, tune: { ...app.dev.tune }, race: s?.sim ? { track: s.setup.track, phase: s.sim.phase, lap: s.sim.player.lap, pos: s.sim.player.position, done: s.sim.done, t: s.sim.t } : null, couch: app.couch, engine2: !!app.couchMgr.engine2 }; }, press(a) { app.actions.inject(a); } }; }\n}\nexport const parseUrl = () => { if (typeof location === 'undefined') return {}; const q = new URLSearchParams(location.search), o = {}; for (const [k, v] of q) o[k] = v; return o; };\nexport { TITLE, Engine, withUrlOptions, couchSetup };\nE\ncat > src/main.js <<'E'\n// Boot. Exports createGame() so check.mjs --headless and the tests can run the game in Node.\nimport { Engine, withUrlOptions } from './pixel-engine.js';\nimport { App, parseUrl } from './game/app.js';\nimport { MenuScene } from './game/scenes/menu.js';\nimport { RaceScene } from './game/scenes/race.js';\nimport { ReplayScene } from './game/scenes/replay.js';\nimport { startHub } from './game/net/hub.js';\nimport { quickRaceSetup, licenceSetup } from './game/sim/setups.js';\nimport { newProfile, buyCar } from './game/sim/career.js';\nimport { RaceSim } from './game/sim/race.js';\nimport { TITLE } from './game/data/meta.js';\nexport function createGame() { return new MenuScene(new App(), { screen: 'title' }); }\nfunction firstScene(app, u) {\n  if (u.scene === 'race') { const s = quickRaceSetup({ track: u.track ?? 'kestrel', carId: u.car ?? 'ginga', field: Number(u.ai ?? 5) + 1, pace: Number(u.pace ?? 0.92), laps: Number(u.laps ?? 2), hour: u.hour != null ? Number(u.hour) : undefined, rain: u.rain === '1' }); return new RaceScene(app, s); }\n  if (u.scene === 'licence') return new RaceScene(app, licenceSetup(u.test ?? 'C-1'));\n  if (u.scene === 'replay') { const s = quickRaceSetup({ track: u.track ?? 'kestrel', carId: u.car ?? 'ginga', field: 4, pace: 0.92, laps: 1 }); s.cars.forEach((c) => { c.ai = true; c.seat = c.seat ?? -1; }); const sim = new RaceSim({ ...s, tune: app.dev.tune }); for (let i = 0; i < 60 * 40; i++) sim.step([]); return new ReplayScene(app, sim.replayData(), { screen: 'title' }); }\n  return new MenuScene(app, app.profile ? { screen: 'title' } : { screen: 'title' });\n}\nif (typeof document !== 'undefined') {\n  document.title = TITLE;\n  const container = document.getElementById('p1');\n  const app = new App(); app.url = parseUrl(); window.__APP__ = app;\n  const fail = (e) => { const msg = 'THIS GAME NEEDS WEBGPU: A RECENT CHROME OR EDGE, SAFARI 26, OR FIREFOX 141 ON WINDOWS.'; const d = document.createElement('div'); d.textContent = msg; d.style.cssText = 'position:fixed;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;background:#1a1c2c;font:20px monospace;padding:40px;text-align:center'; document.body.append(d); console.warn(e); };\n  const hub = window.AIHub;\n  try {\n    let started = null;\n    if (hub && hub.active) started = await startHub(app, hub, container);\n    if (!started) {\n      const opts = withUrlOptions(app.engineOptions(container));\n      if (app.url.scene) { app.profile ??= newProfile(); if (!app.profile.cars.length) buyCar(app.profile, 'ginga'); app.instant = false; }\n      if (app.url.dev) app.devOpen = true;\n      const e = await Engine.start(firstScene(app, app.url), opts); app.engine = e; window.__ENGINE__ = e;\n    }\n  } catch (e) { fail(e); if (hub?.active) hub.fail('This game needs WebGPU.'); }\n}\nE\ncat > src/index.html <<'E'\n<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Grandpa Turismo (dev)</title>\n<style>html,body{margin:0;height:100%;background:#000;overflow:hidden}#row{display:flex;width:100vw;height:100vh}#p1{position:relative;width:100vw;height:100vh;overflow:hidden}#p2{display:none;position:relative;height:100vh;overflow:hidden}</style></head>\n<body><div id=\"row\"><div id=\"p1\"></div><div id=\"p2\"></div></div><script type=\"module\" src=\"./main.js\"></script></body></html>\nE\ncat > tools/hub-metas.html <<'E'\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"hub:type\" content=\"Game\">\n<meta name=\"hub:players\" content=\"1-2\">\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"ghost\">\n<meta name=\"hub:session-minutes\" content=\"4\">\n<meta name=\"hub:session-goal\" content=\"Lowest time wins: same car, same track\">\n<meta name=\"hub:session-howto\" content=\"Steer stick or A D. R2 or W go. L2 or S brake.\">\n<meta name=\"hub:webgpu\" content=\"required\">\nE\ncat > tools/build.mjs <<'E'\n// node tools/build.mjs [out.html]: the single HTML, with the exit interview and the kit's credits embedded.\nimport { execFileSync } from 'node:child_process';\nimport { readFileSync, writeFileSync, rmSync, existsSync } from 'node:fs';\nconst out = process.argv[2] ?? '../GrandpaTurismo-GranTurismo3ASpec-claude-opus-5-5-medium-20261105-171907.html', bundle = 'tools/.bundle.js';\nconst exitPath = '../exit-interview.json', exit = existsSync(exitPath) ? JSON.parse(readFileSync(exitPath, 'utf8')) : { sourceInformation: {}, testingFeedback: [], engineFeedback: [], promptFeedback: [] };\nconst credits = readFileSync('src/CREDITS.md', 'utf8').split('\\n').slice(0, 400).join('\\n');\nconst version = /\\*\\*([0-9.]+)\\*\\*/.exec(readFileSync('src/GUIDE.md', 'utf8'))?.[1] ?? 'unknown';\nwriteFileSync('src/game/data/about.gen.js', `// Written by tools/build.mjs from the exit interview and the kit's CREDITS.md.\\nexport const ABOUT = ${JSON.stringify({ exit, credits, engineVersion: version })};\\n`);\nexecFileSync('esbuild', ['src/main.js', '--bundle', '--format=esm', '--target=esnext', '--charset=utf8', '--legal-comments=none', `--outfile=${bundle}`, '--log-level=warning'], { stdio: 'inherit' });\nconst js = readFileSync(bundle, 'utf8').replace(/<\\/script/gi, '<\\\\/script');\nrmSync(bundle);\nconst session = readFileSync('tools/hub/session.js', 'utf8');\nconst metas = readFileSync('tools/hub-metas.html', 'utf8');\nconst html = `<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><script>${session}</script><title>Grandpa Turismo</title>\n${metas}\n<style>html,body{margin:0;height:100%;background:#000;overflow:hidden}#row{display:flex;width:100vw;height:100vh}#p1{position:relative;width:100vw;height:100vh;overflow:hidden}#p2{display:none;position:relative;height:100vh;overflow:hidden}</style>\n</head><body><div id=\"row\"><div id=\"p1\"></div><div id=\"p2\"></div></div><script type=\"module\">${js}</script></body></html>`;\nwriteFileSync(out, html);\nconsole.log(`${out}: ${(html.length / 1048576).toFixed(1)} MB`);\nE\ncat >> ../PROGRESS.md <<'E'\n- All first-draft modules written (dev, attract, hub, couch, app, main, build). Next: build + browser test + fix; then tests suites, medals rerun, balance, screenshots, docs, exit interview.\nE\ncat > ../exit-interview.json <<'E'\n{\"sourceInformation\":{\"date\":\"2026-11-05 17:19:07\",\"source\":\"Gran Turismo 3: A-Spec\",\"plan\":\"PLAN.md\",\"genre\":\"\",\"perspective\":\"\",\"tech\":\"\",\"artDirection\":\"\",\"animation\":\"\",\"audio\":\"\",\"online\":\"\",\"testing\":\"\",\"research\":\"\",\"environment\":\"Claude Code CLI (headless); Linux\",\"model\":\"Anthropic, claude-opus-5-5, reasoning effort medium\",\"usage\":\"added on import\"},\"testingFeedback\":[],\"engineFeedback\":[],\"promptFeedback\":[]}\nE\nnode tools/build.mjs 2>&1 | tail -20","description":"Write dev mode, attract, hub, couch, app, main, build"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":24098,"cache_read_input_tokens":410358,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":24098},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c060cbf0-9de2-4b69-aed6-69ef0ff7f0ee","uuid":"b53ed738-1a62-4d05-9340-59be776d14f0","timestamp":"2026-11-06T00:57:24.734Z","request_id":"req_011Cgkm88L7JF8yYVS3AAovq","wire_tool_inputs":{"toolu_01H5JV5H7QofvwDXQyJkspWj":{"command":"cat > src/game/dev/devmode.js <<'E'\n// Dev mode: a pad-friendly panel over the running game. Live sliders, tools, overlays and career shortcuts.\nimport { TUNE_DEFAULTS, profileFor } from '../sim/race.js';\nimport { scr } from '../ui/screens/common.js';\nimport { CAR_LIST, CARS } from '../data/cars.js';\nimport { TEST, TESTS, LICENCES } from '../data/licences.js';\nimport { EVENTS, EVENT } from '../data/events.js';\nimport { applyRound, applyTest, buyCar, newProfile } from '../sim/career.js';\nimport { tunedParams } from '../sim/tuning.js';\nimport { careerRoundSetup, licenceSetup } from '../sim/setups.js';\nimport { THREE } from '../../pixel-engine.js';\nconst { Vector3 } = THREE;\nexport const SLIDERS = [\n  ['grip', 'GRIP', 0.5, 1.5, 0.05], ['power', 'POWER', 0.5, 2, 0.05], ['brake', 'BRAKE STRENGTH', 0.5, 1.5, 0.05], ['downforce', 'DOWNFORCE', 0, 2, 0.1], ['wear', 'TYRE WEAR', 0, 5, 0.25], ['fuel', 'FUEL USE', 0, 5, 0.25], ['steerRate', 'STEERING RATE', 1, 8, 0.25],\n  ['stability', 'STABILITY STRENGTH', 0, 2, 0.1], ['traction', 'TRACTION STRENGTH', 0, 2, 0.1], ['aiPace', 'AI PACE (0: EVENT)', 0, 1.05, 0.01], ['rubber', 'AI RUBBER BAND', 0, 0.03, 0.002], ['wallLoss', 'WALL SPEED LOSS', 0, 2, 0.1], ['slip', 'SLIPSTREAM', 0.4, 1, 0.05], ['prize', 'PRIZE MONEY', 0, 5, 0.25],\n  ['chase', 'CHASE DISTANCE', 4, 14, 0.5], ['fov', 'FOV', 40, 90, 1],\n];\nconst OVERLAYS = [['line', 'RACING LINE'], ['loads', 'WHEEL LOADS AND SLIP'], ['surface', 'SURFACE TINT'], ['circles', 'COLLISION CIRCLES'], ['targets', 'AI TARGETS AND LANES'], ['telemetry', 'TELEMETRY STRIP']];\nexport class DevState {\n  constructor() { this.tune = { ...TUNE_DEFAULTS }; this.god = false; this.overlays = {}; this.freeCam = false; this.hideHud = false; this.saved = null; this.fieldSize = null; }\n  get dirty() { for (const k in TUNE_DEFAULTS) if (this.tune[k] !== TUNE_DEFAULTS[k]) return true; return this.god; }\n  reset() { Object.assign(this.tune, TUNE_DEFAULTS); this.god = false; this.overlays = {}; this.freeCam = false; }\n  /** Dev overlays: drawn in the HUD, over the race. */\n  drawOverlays(scene, ctx) {\n    const o = this.overlays, sim = scene.sim, hud = ctx.hud; if (!sim) return; const c = sim.cars[scene.focusIdx], cam = ctx.camera.camera; if (!c) return; cam.updateMatrixWorld();\n    const proj = (x, y, z) => { const v = (this._v ??= new Vector3()).set(x, y, z).project(cam); if (v.z > 1 || v.z < -1) return null; return [Math.round(((v.x + 1) / 2) * hud.width), Math.round(((1 - v.y) / 2) * hud.height)]; };\n    if (o.loads) { const x0 = 8, y0 = 64; hud.rect(x0 - 2, y0 - 2, 76, 50, 'ink'); c.fz.forEach((f, i) => { const X = x0 + (i % 2) * 38, Y = y0 + (i >> 1) * 24; hud.rect(X, Y, Math.round(Math.min(34, (f / (c.p.mass * 9.81)) * 60)), 6, 'sky'); hud.rect(X, Y + 8, Math.round(Math.min(34, c.use[i] * 18)), 6, c.use[i] > 1.2 ? 'red' : 'lime'); }); }\n    if (o.surface) { const col = { asphalt: 'slate', kerb: 'red', grass: 'green', gravel: 'sand', dirt: 'orange', apron: 'mist' }[c.surface]; hud.rect(0, 0, hud.width, 2, col); hud.rect(0, hud.height - 2, hud.width, 2, col); hud.text(hud.width / 2 - 30, 14, c.surface.toUpperCase(), { color: col }); }\n    if (o.circles) for (const k of sim.cars) for (const off of [-1.35, 0, 1.35]) { const p = proj(k.x + Math.sin(k.yaw) * off, k.y + 0.3, k.z + Math.cos(k.yaw) * off); if (p) { hud.rect(p[0] - 3, p[1], 7, 1, 'cyan'); hud.rect(p[0], p[1] - 3, 1, 7, 'cyan'); } }\n    if (o.targets) for (const k of sim.cars) { if (!k.ai) continue; const idx = (k.loc.i + Math.round(Math.max(7, Math.hypot(k.vx, k.vz) * 0.62) / sim.tr.ds)) % sim.tr.N, p = proj(sim.line.px[idx], sim.tr.y[idx] + 0.3, sim.line.pz[idx]); if (p) hud.rect(p[0] - 1, p[1] - 1, 3, 3, 'lime'); const q = proj(k.x, k.y + 1.9, k.z); if (q) hud.text(q[0] - 14, q[1], `${k.skill.toFixed(2)}`, { color: 'lime' }); }\n    if (o.telemetry) { const i = c.lastInp ?? {}, h = hud.height, y = h - 52; hud.rect(hud.width / 2 - 96, y, 192, 10, 'ink'); hud.text(hud.width / 2 - 94, y + 2, `${Math.round(Math.abs(c.u) * 3.6)} T${(i.throttle ?? 0).toFixed(1)} B${(i.brake ?? 0).toFixed(1)} AX${(c.ax / 9.81).toFixed(1)} AY${(c.ay / 9.81).toFixed(1)}`, { color: 'white' }); }\n  }\n}\nconst TAB_NAMES = ['SLIDERS', 'RACE', 'VIEW', 'CAREER'];\nexport const Dev = (scene = null) => scr('dev', { tab: 0, page: 0, sub: 0, overlay: false, onEnter(app) { this.scene = scene ?? (app.scene?.sim ? app.scene : null); this.ev = 0; this.test = 0; this.car = 0; },\n  draw(ui) { const app = ui.app, d = app.dev, a = app.actions; ui.hud.rect(0, 0, 200, ui.H, 'ink'); ui.hud.rect(200, 0, 1, ui.H, 'slate'); ui.hud.rect(0, 0, 200, 16, 'navy'); ui.text(6, 4, 'DEV MODE', { color: 'orange' }); const X = 4, W = 192; const names = TAB_NAMES; let idx = this.tab; if (a.pressed('tabR')) idx = (idx + 1) % names.length; if (a.pressed('tabL')) idx = (idx - 1 + names.length) % names.length; if (idx !== this.tab) { this.tab = idx; ui.focus = null; app.mix.ui('tick'); } ui.text(60, 4, names[this.tab], { color: 'sand' }); const pt = app.ctx.input.pointer; names.forEach((n, i) => { const x = 4 + i * 49; ui.hud.rect(x, 18, 47, 11, i === this.tab ? 'navy' : 'night'); ui.hud.text(x + 2, 20, n.slice(0, 7), { color: i === this.tab ? 'sand' : 'mist' }); if (a.click && ui.rectHit(pt, { x, y: 18, w: 47, h: 11 })) { this.tab = i; ui.focus = null; } });\n    const y0 = 32, btn = (id, i, label, fn, o = {}) => { if (ui.button(id, X, y0 + i * 20, W, 17, label, { left: true, ...o })) fn(); };\n    if (this.tab === 0) { const per = 7, pages = Math.ceil(SLIDERS.length / per); if (ui.focus && SLIDERS.findIndex((s) => s[0] === ui.focus) === -1) ui.focus = null; if (a.pressed('confirm') && SLIDERS.find((s) => s[0] === ui.focus)) { const k = ui.focus; d.tune[k] = TUNE_DEFAULTS[k]; a.consume('confirm'); app.mix.ui('back'); } if (a.pressed('info')) { d.reset(); app.mix.ui('back'); ui.toast('ALL SLIDERS RESET'); } if (a.pressed('alt')) { this.page = (this.page + 1) % pages; ui.focus = null; } SLIDERS.slice(this.page * per, this.page * per + per).forEach(([k, label, min, max, step], i) => { ui.slider(k, X, y0 + i * 26, W, label, d.tune[k], min, max, step, (v) => (d.tune[k] = v), { h: 22, dflt: TUNE_DEFAULTS[k] }); }); ui.text(X, ui.H - 30, `PAGE ${this.page + 1}/${pages}`, { color: 'mist' }); }\n    const sc = this.scene, sim = sc?.sim;\n    if (this.tab === 1) { if (!sim) ui.para(X, y0, 'NO RACE IS RUNNING. START ONE, THEN OPEN THIS FROM THE PAUSE MENU.', 30, { color: 'mist' }); else { const me = sim.player, ts = [0.25, 0.5, 1, 2, 4], e = app.ctx.engine, cur = ts.indexOf(e.timeScale); btn('teleport', 0, `TELEPORT +200 M (S=${Math.round(me.loc.s)})`, () => sim.teleport(me, me.loc.s + 200)); btn('finish', 1, `FINISH NOW, P${this.sub + 1}. L/R: PLACE`, () => { ui.clearStack(); app.paused = false; sim.finishNow(this.sub + 1); }); if (ui.focus === 'finish' && ui.leftRight) this.sub = (this.sub + ui.leftRight + sim.cars.length) % sim.cars.length; btn('end', 2, 'END RACE', () => { ui.clearStack(); app.paused = false; sim.finishRace(true); }); btn('restart', 3, 'RESTART', () => { ui.clearStack(); app.paused = false; app.restartRace(sc); }); btn('reset', 4, 'RESET CAR', () => sim.recover(me)); btn('speed', 5, `TIME SCALE X${e.timeScale}`, () => { e.timeScale = ts[(cur + 1) % 5]; }); btn('frame', 6, sc.frozen ? 'FROZEN: STEP ONE FRAME' : 'FREEZE', () => { if (!sc.frozen) sc.frozen = true; else sim.step([]); }); btn('save', 7, d.saved ? 'SAVE STATE (HAS ONE)' : 'SAVE STATE', () => (d.saved = sim.saveState())); btn('load', 8, 'LOAD STATE', () => { if (d.saved) sim.loadState(d.saved); }); btn('god', 9, `GOD MODE ${d.god ? 'ON' : 'OFF'}`, () => { d.god = !d.god; for (const c of sim.cars) if (c.seat >= 0) c.god = d.god; }); } }\n    if (this.tab === 2) { const rows = OVERLAYS.map(([k, l]) => [k, `${l}: ${d.overlays[k] ? 'ON' : 'OFF'}`, () => (d.overlays[k] = !d.overlays[k])]); rows.push(['freecam', `FREE CAMERA: ${d.freeCam ? 'ON' : 'OFF'}`, () => { d.freeCam = !d.freeCam; if (sc) sc.freeCam = null; }], ['debug', 'ENGINE DEBUG PANEL', () => app.ctx.engine.showDebug(!app.ctx.engine.debugShown)]); if (sim) rows.push(['hour', `HOUR ${(sc.hour ?? 12).toFixed(1)} (L/R)`, () => {}], ['rain', `RAIN: ${sim.setup.rain ? 'ON' : 'OFF'}`, () => app.devRestart(sc, { rain: !sim.setup.rain })], ['car', `CAR: ${CARS[sim.player.carId].shortName} (L/R)`, () => {}], ['field', `FIELD: ${sim.cars.length} (L/R)`, () => {}]); rows.push(['attract', 'START ATTRACT NOW', () => { ui.clearStack(); app.paused = false; app.attract.start(); }]); rows.forEach(([id, l, fn], i) => { if (ui.button(id, X, y0 + i * 18, W, 15, l, { left: true })) fn(); }); if (sim && ui.leftRight) { if (ui.focus === 'hour') { sc.hour = ((sc.hour ?? 12) + ui.leftRight + 24) % 24; app.setSkyNow(sc); } if (ui.focus === 'car') { const i = CAR_LIST.findIndex((c) => c.id === sim.player.carId), next = CAR_LIST[(i + ui.leftRight + CAR_LIST.length) % CAR_LIST.length].id; app.devRestart(sc, { car: next }); } if (ui.focus === 'field') app.devRestart(sc, { field: Math.max(1, Math.min(8, sim.cars.length + ui.leftRight)) }); } }\n    if (this.tab === 3) { const p = app.profile; if (!p) ui.para(X, y0, 'NO SAVE IS LOADED.', 30, { color: 'mist' }); else { const tests = TESTS, evs = EVENTS; btn('credits', 0, 'GIVE 100,000 CR', () => { p.credits += 100000; app.save(); ui.toast('100,000 CR'); }); btn('allcars', 1, 'UNLOCK ALL CARS', () => { for (const c of CAR_LIST) if (!p.cars.some((x) => x.id === c.id)) { p.cars.push({ uid: p.nextUid++, id: c.id, install: { parts: {}, settings: {}, tyre: null, paint: c.paint, rims: 0 }, km: 0, oilKm: 0, dirt: 0, wins: 0, prize: c.where === 'prize' }); p.seen[c.id] = true; } if (p.current == null) p.current = p.cars[0].uid; app.save(); ui.toast('ALL FOURTEEN CARS'); }); btn('gold', 2, 'ALL TESTS GOLD', () => { for (const l of LICENCES) for (const id of l.tests) applyTest(p, id, TEST[id].medals.gold - 0.01); app.save(); ui.toast('ALL GOLD'); }); btn('winev', 3, `WIN ROUND OF ${EVENT[evs[this.ev].id].name.slice(0, 12)} (L/R)`, () => { const e = evs[this.ev]; applyRound(p, e.id, [{ key: 'player', name: 'YOU', player: true }, { key: 'x', name: 'X' }]); app.save(); ui.toast('ROUND WON'); }); if (ui.focus === 'winev' && ui.leftRight) this.ev = (this.ev + ui.leftRight + evs.length) % evs.length; btn('jumpev', 4, `JUMP TO EVENT ${evs[this.ev].id} (L/R)`, () => { if (!p.cars.length) buyCar(p, 'kite'); ui.clearStack(); app.paused = false; app.startRace(careerRoundSetup(p, evs[this.ev].id)); }); if (ui.focus === 'jumpev' && ui.leftRight) this.ev = (this.ev + ui.leftRight + evs.length) % evs.length; btn('jumptest', 5, `JUMP TO TEST ${tests[this.test].id} (L/R)`, () => { ui.clearStack(); app.paused = false; app.startRace(licenceSetup(tests[this.test].id)); }); if (ui.focus === 'jumptest' && ui.leftRight) this.test = (this.test + ui.leftRight + tests.length) % tests.length; const menus = ['dealer', 'tuning', 'service', 'garage', 'museum', 'theatre', 'arcade', 'licence', 'events']; this.m ??= 0; btn('jumpmenu', 6, `JUMP TO ${menus[this.m].toUpperCase()} (L/R)`, () => { if (!p.cars.length) buyCar(p, 'kite'); ui.clearStack(); app.paused = false; app.toMenu({ screen: menus[this.m] }); }); if (ui.focus === 'jumpmenu' && ui.leftRight) this.m = (this.m + ui.leftRight + menus.length) % menus.length; btn('resetsave', 7, 'RESET THE SAVE', () => { app.profile = newProfile(); app.save(); ui.clearStack(); app.paused = false; app.toTitle(); }, { color: 'orange' }); } }\n    if (ui.backHit || a.pressed('pause')) { ui.backHit = false; app.mix.ui('back'); ui.pop(); return; }\n    ui.prompts(this.tab === 0 ? [['lr', 'CHANGE'], ['confirm', 'RESET ONE'], ['info', 'RESET ALL'], ['alt', 'PAGE'], ['tabs', 'TAB'], ['back', 'BACK']] : [['confirm', 'DO IT'], ['tabs', 'TAB'], ['back', 'BACK']]);\n    void tunedParams; void profileFor; } });\nE\ncat > src/game/attract/director.js <<'E'\n// Attract mode: after 10 s without input on the title or the Map, a looping demo. Any input stops it at once. It may cheat freely. The player's profile isn't touched.\nimport { tunedParams, emptyInstall } from '../sim/tuning.js';\nimport { licenceSetup } from '../sim/setups.js';\nimport { CARS } from '../data/cars.js';\nimport { TEST } from '../data/licences.js';\nimport { TITLE } from '../data/meta.js';\nimport { SPEAKERS } from '../audio/voice.js';\nimport { wrap, clean } from '../ui/ui.js';\nimport { SETS, MenuScene } from '../scenes/menu.js';\nimport { RaceScene } from '../scenes/race.js';\nimport { getTrack } from '../sim/race.js';\nconst god = (carId, skill, name, paint, o = {}) => { const install = { ...emptyInstall(), paint, ...o }; return { params: tunedParams(carId, install), name, ai: true, seat: -1, skill, carId, install, god: true }; };\nconst SHOW = ['kite', 'ginga', 'libeccio'];\nexport class Attract {\n  constructor(app) { this.app = app; this.active = false; this.i = 0; this.t = 0; this.loading = false; this.loops = 0; }\n  start() { const app = this.app; if (this.active || app.session) return; this.active = true; this.i = 0; this.t = 0; this.resumeRoute = app.currentRoute(); this.saved = { profile: app.profile }; app.ui.clearStack(); this.play(0); }\n  stop() { if (!this.active) return; const app = this.app; this.active = false; this.exiting = true; app.ui.clearStack(); app.bot = null; app.profile = this.saved.profile; app.ctx.engine.timeScale = 1; app.goScene(() => new MenuScene(app, this.resumeRoute)).then(() => { this.exiting = false; }); }\n  /** Each frame while it runs. */\n  update(ctx, dt) {\n    if (!this.active || this.exiting) return; const app = this.app, clip = CLIPS[this.i]; this.t += dt;\n    if (app.actions.touched && this.t > 0.15 && !this.ignoreInput) { this.stop(); return; }\n    if (!this.loading) { clip.tick?.(this, ctx, dt); this.drawCard(ctx); if (this.t >= clip.dur) this.play((this.i + 1) % CLIPS.length); }\n  }\n  async play(i) { this.i = i; this.t = 0; if (i === 0) this.loops++; const clip = CLIPS[i], app = this.app; this.loading = true; await clip.enter(this, app); this.loading = false; this.t = 0; }\n  async menu(set, args) { const app = this.app; if (!(app.scene instanceof MenuScene) || app.scene.attractSceneDone) await app.goScene(() => new MenuScene(app, null)); app.ui.clearStack(); app.scene.shotOverride = false; app.scene.setSet(set, args); }\n  async race(setup) { const app = this.app; await app.goScene(() => new RaceScene(app, { mode: 'attract', after: { kind: 'attract' }, rules: { contact: true, wearMult: 0, fuelMult: 0, pits: true }, seed: 3 + this.loops, ...setup })); }\n  drawCard(ctx) { const c = CLIPS[this.i], hud = ctx.hud; hud.rect(4, hud.height - 14, 30, 10, 'ink'); hud.text(6, hud.height - 12, 'DEMO', { color: 'orange' }); if (c.draw) c.draw(this, hud); if (Math.floor(this.t * 2) % 2 === 0) { const s = 'PRESS ANY BUTTON'; hud.text(hud.width - s.length * 6 - 6, hud.height - 12, s, { color: 'white' }); } }\n}\nconst bigCentered = (hud, y, s, sc, col) => { const t = clean(s); hud.text(Math.round(hud.width / 2 - (t.length * 6 * sc) / 2), y, t, { scale: sc, color: col }); };\nconst CLIPS = [\n  { name: 'title', dur: 3, async enter(a, app) { await a.menu('map', { title: true }); app.mix.music('title'); }, draw(a, hud) { bigCentered(hud, 40, 'GRANDPA', 4, 'white'); bigCentered(hud, 72, 'TURISMO', 4, 'sand'); bigCentered(hud, 110, TITLE ? 'DEMO' : '', 2, 'orange'); } },\n  { name: 'showroom', dur: 10, async enter(a, app) { await a.menu('showroom', { car: SHOW[0] }); app.mix.music('dealer'); a.k = -1; }, tick(a, ctx) { const app = a.app, k = Math.min(2, Math.floor(a.t / 3.33)); if (k !== a.k) { a.k = k; app.scene.showCarAt(SHOW[k]); app.ui.say(CARS[SHOW[k]].fenn ?? 'Precise, if you are.', SPEAKERS.fenn, { time: 3 }); } const c = CARS[SHOW[Math.max(0, a.k)]], lines = wrap(c.brochure, 40).slice(0, 4), hud = ctx.hud, x = hud.width - 250; hud.rect(x, 26, 244, 20 + lines.length * 10, 'ink'); hud.text(x + 4, 30, c.name, { color: 'sand' }); lines.forEach((l, i) => hud.text(x + 4, 42 + i * 10, l, { color: 'white' })); } },\n  { name: 'tuning', dur: 8, async enter(a, app) { const install = { ...emptyInstall(), paint: 'white' }; a.demoCar = { id: 'ginga', install }; await a.menu('tuning', { car: 'ginga', install }); app.mix.music('tuning'); app.scene.dynoOn = true; app.scene.spinRate = 0; app.scene.orbit = -2.3; app.mix.setCars([{ carId: 'ginga', params: { redline: 7300, exhaustUp: true } }]); a.wing = false; }, tick(a, ctx, dt) { const app = a.app, sc = app.scene, f = Math.min(1, a.t / 4.5), hud = ctx.hud, x = 12, y = 40, w = 180, h = 100; sc.dynoFrame?.(1500 + 5800 * f, f < 1 ? 1 : 0.1, dt); hud.rect(x - 4, y - 4, w + 8, h + 8, 'ink'); for (let i = 0; i < 44; i++) { const fr = i / 43, py = (p) => y + h - Math.round(h * p * Math.min(1, 0.45 + fr * 0.8) * (fr > 0.85 ? 1 - (fr - 0.85) * 0.5 : 1)); hud.rect(x + Math.round(fr * w), py(0.72), 2, 2, 'mist'); if (fr <= f) hud.rect(x + Math.round(fr * w), py(0.96), 2, 2, 'lime'); } if (a.t > 5 && !a.wing) { a.wing = true; a.demoCar.install.parts.aero = 2; sc.dynoEnd(); sc.showCarAt('ginga', a.demoCar.install); sc.orbit = 2.6; app.mix.ui('register'); app.ui.say('You now have more downforce. You also have more drag. There is no third thing.', SPEAKERS.benno, { time: 3 }); } } },\n  { name: 'licence', dur: 10, async enter(a) { await a.app.goScene(() => new RaceScene(a.app, { ...licenceSetup('B-1', 0, { demo: true }), attractClip: true })); a.medal = false; }, tick(a) { const sc = a.app.scene, sim = sc.sim; if (sim?.run?.over && !a.medal) { a.medal = true; a.app.mix.ui('medal'); } }, draw(a, hud) { if (a.medal) { bigCentered(hud, 60, 'GOLD', 3, 'sand'); bigCentered(hud, 90, TEST['B-1'].title, 1, 'white'); } bigCentered(hud, 30, TEST['B-1'].lesson, 1, 'white'); } },\n  { name: 'kestrel', dur: 20, async enter(a) { const f = ['ginga', 'brandt32', 'kite', 'ryu', 'longhorn', 'moth'].map((id, i) => god(id, 0.96 + i * 0.006, `D${i}`, ['red', 'white', 'blue', 'sand', 'navy', 'green'][i])); await a.race({ track: 'kestrel', laps: 3, hour: 15, start: 'rolling', cars: f, focus: 5, label: 'KESTREL PARK' }); a.app.scene.focusIdx = 5; a.app.scene.cameraSnap(); }, tick(a) { a.app.scene.camTV = a.t > 7; } },\n  { name: 'rally', dur: 12, async enter(a) { const c = [god('ryuRally', 0.98, 'RYU', 'cyan', { })]; await a.race({ track: 'redclay', laps: 2, hour: 17, start: 'standing', cars: c, rules: { contact: false, wearMult: 0, fuelMult: 0, pits: false }, onBuilt: (sim) => { sim.setGreen(); sim.phase = 'green'; const car = sim.cars[0]; sim.placeCar(car, 300, 0, 22); car.lap = 1; car.lapStart = 0; } }); a.app.mix.music('rally'); } },\n  { name: 'harbour', dur: 20, async enter(a) { const f = [god('heck', 0.96, 'A', 'mist'), god('libeccio', 0.965, 'B', 'red')]; await a.race({ track: 'harbour', laps: 5, hour: 21, start: 'rolling', cars: f, crew: true, rules: { contact: true, wearMult: 0, fuelMult: 0, pits: true, endurance: true }, onBuilt: (sim) => { sim.setGreen(); sim.phase = 'green'; f.forEach((o, i) => { const c = sim.cars[i]; sim.placeCar(c, sim.tr.length - 950 - i * 16, 0, 40); c.lap = 1; }); sim.cars[1].wantPit = true; } }); a.app.scene.focusIdx = 1; a.app.scene.cameraSnap(); a.app.mix.music('night'); await a.app.scene.buildCrew?.(a.app.ctx).catch?.(() => {}); }, tick(a) { const sc = a.app.scene, c = sc.sim.cars[1]; sc.camTV = a.t > 13 && !c.pit; if (c.pit?.state === 'in' && !c.pitWide) { c.pitWide = true; } } },\n  { name: 'saltline', dur: 10, async enter(a) { const f = [god('type9', 1.0, 'A', 'teal'), god('corsa', 1.05, 'B', 'sand')]; await a.race({ track: 'saltline', laps: 5, hour: 18.5, start: 'rolling', cars: f, onBuilt: (sim) => { sim.setGreen(); sim.phase = 'green'; sim.placeCar(sim.cars[0], 900, 0, 76); sim.placeCar(sim.cars[1], 880, 0, 80); sim.cars.forEach((c) => (c.lap = 1)); } }); a.app.scene.focusIdx = 1; a.app.scene.chase.mode = 1; a.app.scene.cameraSnap(); } },\n  { name: 'podium', dur: 8, async enter(a, app) { await a.app.goScene(() => new MenuScene(app, null)); app.ui.clearStack(); app.mix.music('credits'); const sc = app.scene; sc.setSet('reveal', { car: 'type9' }); sc.lights[0].intensity = 26; sc.lights[1].intensity = 18; app.ctx.engine.ambient.intensity = 0.6; sc.sets.reveal.userData.cover.position.set(0, 0.12, 0); sc.spinRate = 0.3; a.step = 0; const X = SETS.reveal.x; a.X = X; }, tick(a, ctx) { const sc = a.app.scene; if (a.t > 1.5 && a.step === 0) { a.step = 1; ctx.tweens.to(sc.sets.reveal.userData.cover.position, { x: 9, y: 2.4 }, { duration: 1.2, ease: 'inOutSine' }); a.app.mix.ui('fanfare2'); ctx.particles.burst('confetti', [a.X, 4, 0]); } }, draw(a, hud) { if (a.t > 2.5) bigCentered(hud, 30, CARS.type9.name, 1, 'sand'); } },\n  { name: 'credits', dur: 4, async enter(a) { await a.menu('map', { title: true }); }, draw(a, hud) { hud.rect(0, 0, hud.width, hud.height, 'ink'); bigCentered(hud, 70, 'GRANDPA TURISMO', 3, 'sand'); bigCentered(hud, 120, 'PRESS ANY BUTTON', 2, 'white'); } },\n];\nvoid getTrack;\nE\ncat > src/game/net/hub.js <<'E'\n// AI Hub session: ghost mode. Every copy runs its own physics; others are drawn as ghosts through a 150 ms buffer.\nimport { Engine, withUrlOptions, THREE, PALETTE } from '../../pixel-engine.js';\nimport { RaceScene } from '../scenes/race.js';\nimport { hubRoundSetup, SEAT_COLORS } from '../sim/setups.js';\nimport { CarView } from '../render/carview.js';\nimport { fmtTime, clean } from '../ui/ui.js';\nimport { CONTROLS_TEXT } from '../data/text.js';\nimport { TRACKS } from '../data/tracks.js';\nimport { CARS } from '../data/cars.js';\nimport { drawMap } from '../ui/racehud.js';\nimport { TITLE } from '../data/meta.js';\nimport { scr } from '../ui/screens/common.js';\nconst { Vector3 } = THREE;\nexport class Session {\n  constructor(app, hub, info) { this.app = app; this.hub = hub; this.info = info; this.card = { left: null, ready: [], asking: 0, asked: false, starting: false, paused: false }; this.started = false; this.finishedDone = false; this.ghosts = new Map(); this.lastSend = 0; this.over = false; this.lastPad = {}; this.onKey = (e) => this.key(e); this.tagV = new Vector3(); }\n  get me() { return this.info.me; }\n  wire() {\n    const h = this.hub;\n    h.on('card', (c) => (this.card = c)); h.on('start', () => { this.started = true; });\n    h.on('message', (d, from) => this.receive(d, from)); h.on('leave', ({ id }) => this.remove(id));\n    h.on('time-up', () => this.timeUp()); h.on('end', () => this.end());\n    addEventListener('keydown', this.onKey);\n    addEventListener('pointerdown', (e) => this.pointer(e));\n  }\n  key(e) { if (this.hub.time() !== -Infinity) return; if (e.code === 'Enter') this.hub.answer('ready'); if (e.code === 'KeyM') this.hub.answer('more'); }\n  pointer(e) { if (this.hub.time() !== -Infinity) return; const y = e.clientY / innerHeight, x = e.clientX / innerWidth; if (y > 0.74 && y < 0.92) { if (x < 0.5) this.hub.answer('ready'); else this.hub.answer('more'); } }\n  /** Per frame from RaceScene.afterStep: lights, ghost send, progress. */\n  tick(sim) {\n    const h = this.hub, t = h.time(), me = sim.player, scene = this.app.scene;\n    if (!this.started) return;\n    if (t < 0) { const n = Math.min(3, Math.floor(t / 1000) + 4); if (n !== this.lights) { this.lights = n; if (n > 0) this.app.mix.play('beepLow'); } sim.lights = Math.max(0, n); sim.phase = 'lights'; return; }\n    if (!sim.green) sim.go();\n    const now = performance.now();\n    if (now - this.lastSend >= 100 && !this.over) {\n      this.lastSend = now; const r = (v) => Math.round(v * 10) / 10;\n      h.send({ t: 'g', a: sim.setup.track, x: r(me.x), y: r(me.y), z: r(me.z), yaw: Math.round(me.yaw * 100) / 100, v: r(me.u), s: Math.round(me.loc.s), lap: me.lap, steer: Math.round(me.delta * 100) / 100, br: (me.lastInp?.brake ?? 0) > 0.1 ? 1 : 0 }, { reliable: false });\n      const metres = Math.max(0, sim.metresOf(me)); this.metres = metres;\n      if (!this.finishedDone) h.progress({ score: Math.floor(metres), label: me.lap === 0 ? 'GRID' : `LAP ${Math.min(me.lap, sim.laps)}/${sim.laps} P${this.place(sim, metres)}` });\n    }\n    void scene;\n  }\n  place(sim, metres) { let p = 1; for (const g of this.ghosts.values()) { const m = g.lap > 0 ? (g.lap - 1) * sim.tr.length + g.s : 0; if (m > metres) p++; } return p; }\n  receive(d, from) { if (d?.t === 'g') { let g = this.ghosts.get(from); if (!g) { g = { id: from, buf: [], view: null, lap: 0, s: 0 }; this.ghosts.set(from, g); } g.buf.push({ at: performance.now(), ...d }); if (g.buf.length > 20) g.buf.shift(); g.lap = d.lap; g.s = d.s; g.a = d.a; } if (d?.t === 'done') { const g = this.ghosts.get(from); if (g) g.done = d.time; } }\n  remove(id) { const g = this.ghosts.get(id); g?.view?.dispose(); this.ghosts.delete(id); }\n  finished(e) { if (this.finishedDone) return; this.finishedDone = true; const sim = this.app.scene.sim, me = sim.player, stats = { 'Best lap': isFinite(me.bestLap) ? Math.round(me.bestLap * 100) / 100 : 0, 'Top km/h': Math.round(me.topSpeed * 3.6), Walls: me.walls }, awards = me.walls === 0 ? [{ title: 'NO WALLS', detail: 'The barriers were not disturbed.' }] : []; this.hub.result({ time: Math.round(this.hub.time()), stats, awards }); this.hub.send({ t: 'done', time: e.time }); void e; }\n  timeUp() { if (this.finishedDone) return; this.finishedDone = true; const sim = this.app.scene?.sim, me = sim?.player; this.hub.result({ score: Math.floor(Math.max(0, me ? sim.metresOf(me) : 0)), stats: me ? { 'Top km/h': Math.round(me.topSpeed * 3.6), Walls: me.walls } : {} }); }\n  end() { this.over = true; removeEventListener('keydown', this.onKey); this.app.mix.stopEverything(); this.app.frozenInput = true; if (this.app.scene) this.app.scene.frozen = true; }\n  toggleMenu() { const ui = this.app.ui; if (ui.top?.id === 'sessionmenu' ) { ui.pop(); return; } if (!ui.top) ui.push(SessionMenu()); }\n  // ---- draw ghosts in the scene\n  drawGhosts(scene, dt) {\n    const now = performance.now() - 150, ctx = scene.ctx, carId = scene.sim.player.carId;\n    for (const g of this.ghosts.values()) {\n      if (g.a && g.a !== scene.setup.track) continue;\n      if (!g.view) { const seat = this.info.players.find((p) => p.id === g.id), col = seat?.color ? parseInt(seat.color.slice(1), 16) : PALETTE[SEAT_COLORS[g.id % 4]]; g.view = new CarView(carId, null, { ghost: col }); ctx.scene.add(g.view.root); g.name = clean(seat?.name ?? `P${g.id + 1}`) || `P${g.id + 1}`; if (/[^A-Z0-9 .,'-]/.test(g.name)) g.name = `P${g.id + 1}`; g.colorName = SEAT_COLORS[g.id % 4]; }\n      const b = g.buf; if (!b.length) continue; let a = b[0], c = b[b.length - 1]; for (let i = 0; i < b.length - 1; i++) if (b[i].at <= now && b[i + 1].at >= now) { a = b[i]; c = b[i + 1]; break; }\n      const f = c.at > a.at ? Math.max(0, Math.min(1, (now - a.at) / (c.at - a.at))) : 1; let dy = c.yaw - a.yaw; if (dy > Math.PI) dy -= 2 * Math.PI; if (dy < -Math.PI) dy += 2 * Math.PI;\n      g.pos = { x: a.x + (c.x - a.x) * f, y: a.y + (c.y - a.y) * f, z: a.z + (c.z - a.z) * f, yaw: a.yaw + dy * f, u: c.v, delta: c.steer, brake: !!c.br, s: c.s };\n      g.view.pose(g.pos, dt, null);\n    }\n  }\n  /** Name tags and the card. */\n  drawOver(scene, ctx) {\n    const hud = ctx.hud, cam = ctx.camera.camera; cam.updateMatrixWorld();\n    for (const g of this.ghosts.values()) { if (!g.pos || !g.view) continue; const v = this.tagV.set(g.pos.x, g.pos.y + 1.9, g.pos.z).project(cam); if (v.z < 1 && v.z > -1) { const x = Math.round(((v.x + 1) / 2) * hud.width), y = Math.round(((1 - v.y) / 2) * hud.height); hud.text(x - g.name.length * 3, y, g.name, { color: g.colorName }); } }\n    if (this.hub.time() === -Infinity || !this.started) this.drawCard(scene, ctx);\n    if (this.touchBlocked()) { hud.rect(hud.width / 2 - 120, 110, 240, 20, 'ink'); hud.text(hud.width / 2 - 93, 116, 'CONTROLLER OR KEYBOARD REQUIRED', { color: 'sand' }); }\n  }\n  touchBlocked() { return this.app.touchGate(); }\n  drawCard(scene, ctx) {\n    const hud = ctx.hud, W = hud.width, H = hud.height, s = scene.setup, c = this.card, cx = W / 2, a = this.app.actions, dev = a.device === 'pad' ? 'pad' : 'kb';\n    hud.rect(cx - 170, 14, 340, 226, 'ink'); hud.text(cx - (TITLE.length * 12) / 2, 22, TITLE, { scale: 2, color: 'sand' });\n    hud.text(cx - 160, 44, clean(`${TRACKS[s.track].name}. ${s.laps} LAPS. ${CARS[s.hubCar].shortName}${s.rain ? '. RAIN' : ''}`), { color: 'white' });\n    hud.text(cx - 160, 56, 'LOWEST TIME WINS: SAME CAR, SAME TRACK.', { color: 'lime' });\n    this.info.players.forEach((p, i) => { const col = SEAT_COLORS[p.id % 4], name = /^[\\x20-\\x7e]+$/.test(p.name ?? '') ? clean(p.name).slice(0, 14) : `P${p.id + 1}`; hud.rect(cx - 160, 70 + i * 12, 8, 8, col); hud.text(cx - 148, 71 + i * 12, name, { color: 'white' }); hud.text(cx - 40, 71 + i * 12, (c.ready ?? []).includes(p.id) ? 'READY' : '...', { color: (c.ready ?? []).includes(p.id) ? 'lime' : 'mist' }); });\n    if (scene.map) drawMap(hud, scene.map, cx + 96, 68, [], null);\n    CONTROLS_TEXT[dev].forEach((l, i) => hud.text(cx - 160, 124 + i * 10, l, { color: 'white' }));\n    const left = c.left == null ? (c.starting ? 'STARTING' : c.paused ? 'HELD' : '') : `${Math.ceil(c.left / 1000)} S`; hud.text(cx + 100, 44, left, { color: 'sand' });\n    hud.rect(cx - 160, 190, 150, 30, c.asked ? 'night' : 'navy'); hud.text(cx - 148, 202, dev === 'pad' ? 'CROSS: READY' : 'ENTER: READY', { color: (c.ready ?? []).includes(this.me) ? 'lime' : 'white' });\n    hud.rect(cx + 10, 190, 150, 30, c.asked ? 'plum' : 'navy'); hud.text(cx + 20, 202, dev === 'pad' ? 'TRIANGLE: MORE TIME' : 'M: MORE TIME', { color: c.asked ? 'sand' : 'white' }); if (c.asking) hud.text(cx + 20, 180, `${c.asking} ASKED FOR TIME`, { color: 'mist' });\n    if (a.pressed('confirm')) this.hub.answer('ready'); if (a.pressed('info')) this.hub.answer('more');\n  }\n}\nconst SessionMenu = () => scr('sessionmenu', { overlay: true, draw(ui) { const app = ui.app; ui.panel(ui.cx - 80, 60, 160, 92, 'ink', 'slate'); ui.center(66, 'THE ROUND GOES ON', { color: 'sand' }); [['sound', 'SOUND AND BUTTONS'], ['handbook', 'HANDBOOK'], ['resume', 'BACK']].forEach(([id, l], i) => { if (ui.button(id, ui.cx - 70, 80 + i * 22, 140, 18, l)) { if (id === 'sound') ui.push(app.screens.Settings()); if (id === 'handbook') ui.push(app.screens.Handbook()); if (id === 'resume') ui.pop(); } }); if (ui.backHit) { ui.backHit = false; ui.pop(); } ui.prompts([['confirm', 'SELECT'], ['back', 'BACK']]); } });\nexport async function startHub(app, hub, container) {\n  const info = await hub.connect({ mode: 'ghost', seats: [1, 4], card: true });\n  if (!info) return null;\n  const session = new Session(app, hub, info); app.session = session; session.wire();\n  const setup = hubRoundSetup(hub.rng('round'), info.players); setup.seed = info.seed;\n  try {\n    const engine = await Engine.start(new RaceScene(app, setup), withUrlOptions(app.engineOptions(container, { seed: info.seed })));\n    app.engine = engine; hub.ready();\n    return engine;\n  } catch (e) { hub.fail(`This game needs WebGPU: ${e?.message ?? e}`); throw e; }\n}\nvoid fmtTime;\nE\ncat > src/game/net/couch.js <<'E'\n// Couch Duel: two players, one TV, split screen. One RaceSim is shared: P1's scene steps it, P2's only draws it.\nimport { Engine } from '../../pixel-engine.js';\nimport { RaceScene } from '../scenes/race.js';\nexport class Couch {\n  constructor(app) { this.app = app; this.engine2 = null; }\n  async start(setup) {\n    const app = this.app, p1 = document.getElementById('p1'), p2 = document.getElementById('p2');\n    app.couch = true; p1.style.width = p2.style.width = '50vw'; p2.style.display = 'block';\n    await app.goScene(() => new RaceScene(app, setup));\n    const scene = app.scene;\n    this.engine2 = await Engine.start(new RaceScene(app, setup, { viewer: true, sim: scene.sim, seat: 1 }), { container: p2, camera: { preset: 'fixed', position: [0, 5, -10], target: [0, 1, 0], fov: 58, minZoom: 1, maxZoom: 1 }, settings: { button: false, key: false }, touch: false, seed: 9, debugUI: false });\n    this.engine2.audio.persist = false; this.engine2.audio.setMuted(true); this.engine2.input.gamepadButtons = {}; this.engine2.input.gamepadLookSpeed = 0;\n    app.engine.input.gamepadButtons = {};\n    scene.hold = 0;\n  }\n  end() { if (!this.engine2) { this.app.couch = false; return; } const app = this.app, e2 = this.engine2; this.engine2 = null; app.couch = false; try { e2.dispose(); } catch (err) { console.warn(err); } const p1 = document.getElementById('p1'), p2 = document.getElementById('p2'); p2.style.display = 'none'; p2.style.width = ''; p1.style.width = '100vw'; }\n}\nE\ncat > src/game/app.js <<'E'\n// App: profile, settings, input, audio mix, scene switching.\nimport { Engine, withUrlOptions, LOOK_PRESETS } from '../pixel-engine.js';\nimport { Actions } from './input/actions.js';\nimport { pollPads } from './input/pad.js';\nimport { UI } from './ui/ui.js';\nimport { Mix } from './audio/mix.js';\nimport { MenuScene } from './scenes/menu.js';\nimport { RaceScene } from './scenes/race.js';\nimport { ReplayScene } from './scenes/replay.js';\nimport { DevState, Dev } from './dev/devmode.js';\nimport { Attract } from './attract/director.js';\nimport { Couch } from './net/couch.js';\nimport { SAVE_KEY, SETTINGS_KEY, TITLE } from './data/meta.js';\nimport { TRACKS } from './data/tracks.js';\nimport { newProfile, migrate, applyRound, applyTest, addMileage, carRec, record } from './sim/career.js';\nimport { EVENT } from './data/events.js';\nimport { TEST } from './data/licences.js';\nimport { setSky } from './render/sky.js';\nimport { licenceSetup, quickRaceSetup, couchSetup } from './sim/setups.js';\nimport { b64, unb64 } from './scenes/race.js';\nimport * as Title from './ui/screens/title.js';\nimport * as Lic from './ui/screens/licence.js';\nimport * as Ev from './ui/screens/events.js';\nimport { Dealer } from './ui/screens/dealer.js';\nimport { Tuning, Service } from './ui/screens/tuning.js';\nimport { Garage, Museum, Theatre } from './ui/screens/garage.js';\nimport { Arcade } from './ui/screens/arcade.js';\nimport { Settings, Handbook, About } from './ui/screens/settings.js';\nimport { Pause, Results, LicenceResult } from './ui/screens/race.js';\nimport { Podium, PrizeReveal, Ending } from './ui/screens/podium.js';\nconst storage = () => { try { return typeof localStorage !== 'undefined' ? localStorage : null; } catch { return null; } };\nconst DEFAULT_SETTINGS = { voices: 0.8, raceMusic: true, glyphs: 'ps', vibration: true, steerCurve: 1.4, mouseSteer: false, units: 'kmh', musicSet: false };\nexport class App {\n  constructor() {\n    this.actions = new Actions(this); this.ui = new UI(this); this.mix = new Mix(this); this.dev = new DevState(); this.attract = new Attract(this); this.couchMgr = new Couch(this);\n    this.settings = { ...DEFAULT_SETTINGS, ...this.readJSON(SETTINGS_KEY) }; this.profile = this.loadProfile(); this.scene = null; this.paused = false; this.couch = false; this.session = null; this.bot = null; this.lastResult = null; this.lastReplay = null; this.loading = false; this.keySeen = false; this.cursorIdle = 0; this.fresh = !this.settings.musicSet;\n    this.screens = { Map: Title.MapScreen, MapPause: Title.MapPause, Title: Title.TitleScreen, Greet: Title.GreetScreen, LicenceCentre: Lic.LicenceCentre, TestList: Lic.TestList, TestCard: Lic.TestCard, EventHall: Ev.EventHall, EventCard: Ev.EventCard, RoundCard: Ev.RoundCard, Dealer, Tuning, Service, Garage, Museum, Theatre, Arcade, Settings, Handbook, About, Dev, Pause, Results, LicenceResult };\n    if (typeof addEventListener !== 'undefined') { addEventListener('keydown', () => { this.keySeen = true; this.actions.anyKeyEvent = true; }); addEventListener('mousemove', () => (this.cursorIdle = 0)); }\n  }\n  readJSON(k) { try { const s = storage()?.getItem(k); return s ? JSON.parse(s) : null; } catch { return null; } }\n  loadProfile() { const p = this.readJSON(SAVE_KEY); return p ? migrate(p) : null; }\n  hasSave() { return !!this.readJSON(SAVE_KEY); }\n  save() { if (!this.profile || this.session) return true; try { storage()?.setItem(SAVE_KEY, JSON.stringify(this.profile)); return true; } catch { return false; } }\n  saveSettings() { try { storage()?.setItem(SETTINGS_KEY, JSON.stringify(this.settings)); } catch { /* storage refused */ } }\n  resetSettings() { Object.assign(this.settings, DEFAULT_SETTINGS); this.saveSettings(); const a = this.mix.audio; a?.resetVolumes(); a?.setVolume('music', 0.1); this.ctx?.engine.settings.reset(); }\n  assistsTarget() { return (this.profile ??= newProfile()).assists; }\n  engineOptions(container, o = {}) { return { container, camera: { preset: 'fixed', position: [0, 5, -10], target: [0, 1, 0], fov: 58, minZoom: 1, maxZoom: 1 }, settings: { button: false }, touch: false, look: LOOK_PRESETS.none, background: 0x1a1c2c, ...o }; }\n  /** Called by every scene's setup. */\n  bind(ctx, scene) {\n    this.ctx = ctx; this.scene = scene; this.hud = ctx.hud; this.engine = ctx.engine; this.mix.bind(ctx); this.ui.prompted = false;\n    const input = ctx.input; input.gamepadButtons = {}; input.gamepadLookSpeed = 0; for (const k of ['Tab', 'F1', 'F2', 'ControlLeft', 'Backspace', 'Slash', 'Period', 'Comma']) input.preventKeys.add(k);\n    // first launch and every hub round: music at 10%.\n    if (!this.settings.musicSet) { ctx.audio.setVolume('music', 0.1); }\n  }\n  onReady(ctx, scene) { if (typeof window !== 'undefined') window.__GAME__ = this.hook(); void ctx; void scene; }\n  frameStart(ctx) { return this.actions.latch(ctx); }\n  /** End of update: UI, attract, pads, cursor. */\n  frameEnd(ctx, dt, skipUi = false) {\n    this.realDt = dt;\n    this.attract.update(ctx, dt);\n    if (!skipUi && !this.attract.active) { if (this.ui.top) this.ui.frame(dt); else if (this.ui.subtitle || this.ui.toasts.length) { this.ui.dt = dt; if (this.ui.subtitle) this.ui.drawSubtitle(dt); this.ui.drawToasts(dt); } }\n    else if (this.attract.active && this.ui.subtitle) this.ui.drawSubtitle(dt);\n    if (this.session) { const s = this.scene; if (s?.sim) this.session.drawOver(s, ctx); }\n    if (this.ui.top?.attract && !this.attract.active && !this.session && this.actions.idle > 10) this.attract.start();\n    if (this.url?.attract && !this.attractDone) { this.attractDone = true; this.attract.start(); }\n    pollPads(ctx.input);\n    if (!this.mix.audio?.unlocked && this.actions.anyInput && this.actions.device === 'pad') this.mix.audio?.unlock();\n    this.mix.ensureGraph(); this.mix.updateLevels();\n    this.cursorIdle += dt; if (typeof document !== 'undefined') { const hide = this.cursorIdle > 2 || (this.scene instanceof RaceScene && !this.paused && !this.ui.top); document.body.style.cursor = hide ? 'none' : 'default'; }\n  }\n  touchGate() { if (typeof matchMedia === 'undefined') return false; if (this.keySeen || this.actions.pads.length || this.actions.sawKey) return false; return !matchMedia('(any-pointer: fine)').matches && matchMedia('(pointer: coarse)').matches; }\n  inRace() { return this.scene instanceof RaceScene; }\n  tracksName(id) { return TRACKS[id].name.toUpperCase(); }\n  async goScene(make) {\n    if (this.loading) return; this.loading = true; const e = this.engine;\n    try {\n      const fx = !this.instant && e.screen?.cover ? e.screen : null;\n      if (fx) await fx.cover('wipe', { duration: 0.22 });\n      this.mix.clearEngines(); e.timeScale = 1; this.paused = false;\n      await e.loadGame(make());\n      if (fx) fx.reveal('wipe', { duration: 0.25 });\n    } finally { this.loading = false; }\n  }\n  // ---- routes\n  currentRoute() { const t = this.ui.top; return t?.id === 'map' ? { screen: 'map' } : { screen: 'title' }; }\n  toTitle() { this.couchMgr.end(); this.ui.clearStack(); return this.goScene(() => new MenuScene(this, { screen: 'title' })); }\n  toMap() { this.couchMgr.end(); this.ui.clearStack(); return this.goScene(() => new MenuScene(this, { screen: 'map' })); }\n  toMenu(route) { this.couchMgr.end(); this.ui.clearStack(); return this.goScene(() => new MenuScene(this, route)); }\n  applyRoute(r) {\n    const ui = this.ui, s = this.screens; ui.clearStack(); const route = r ?? { screen: 'title' };\n    if (route.screen === 'title' || !this.profile && route.screen !== 'title') { ui.push(s.Title()); return; }\n    if (route.screen === 'none') return;\n    ui.push(s.Map());\n    const open = { map: null, dealer: () => s.Dealer(route.room ?? 0, route.car ?? 0), tuning: () => s.Tuning(), service: () => s.Service(), garage: () => s.Garage(), museum: () => s.Museum(), theatre: () => s.Theatre(), arcade: () => s.Arcade(), licence: () => s.LicenceCentre(), tests: () => s.TestList(route.lic), testcard: () => s.TestCard(route.id), events: () => s.EventHall(), eventcard: () => s.EventCard(route.id), roundcard: () => s.RoundCard(route.id), results: () => (this.lastResult?.licence ? s.LicenceResult() : s.Results()) }[route.screen];\n    if (route.screen === 'tests' || route.screen === 'testcard') ui.push(s.LicenceCentre()); if (route.screen === 'testcard') ui.push(s.TestList(route.id[0]));\n    if (route.screen === 'eventcard' || route.screen === 'roundcard') ui.push(s.EventHall()); if (route.screen === 'roundcard') ui.push(s.EventCard(route.id));\n    if (open) { const sc = open(); ui.push(sc); }\n    if (route.then) route.then(this);\n  }\n  newGame() { this.profile = newProfile(); this.save(); this.ui.clearStack(); this.ui.push(this.screens.Greet()); }\n  onboard() { /* the Map's nudge takes it from here */ }\n  // ---- racing\n  startRace(setup) { this.couchMgr.end(); this.ui.clearStack(); this.paused = false; return this.goScene(() => new RaceScene(this, setup)); }\n  startCouch(setup) { this.ui.clearStack(); return this.couchMgr.start(setup); }\n  startReplay(data, back) { this.couchMgr.end(); this.ui.clearStack(); return this.goScene(() => new ReplayScene(this, data, back)); }\n  leaveReplay(back) { this.ui.clearStack(); return this.goScene(() => new MenuScene(this, back)); }\n  pause(scene) { this.ui.push(Pause(scene)); this.paused = true; this.mix.quietDriving(); }\n  restartRace(sc) { const s = sc.setup; if (s.mode === 'couch') { this.couchMgr.end(); return this.startCouch(s); } return this.startRace(s); }\n  restartTrialLap(sc) { const sim = sc.sim, me = sim.player; sim.placeCar(me, sim.tr.length - 12, 0, 0); me.lap = 0; me.prevS = me.loc.s; me.lapStart = sim.t; me.midSeen = false; sc.trial.cur = []; sc.chase.snap(); }\n  devRestart(sc, o) { const s = { ...sc.setup }; if (o.rain != null) s.rain = o.rain; const me = sc.sim.player; if (o.car) { const i = s.cars.findIndex((c) => c.seat === 0); if (s.mode === 'arcade' || s.mode === 'race' || s.mode === 'testdrive' || s.mode === 'trial') { s.cars = s.cars.slice(); const q = quickRaceSetup({ track: s.track, carId: o.car, field: 1, pace: 0.9 }).cars[0]; s.cars[i] = { ...q }; } } if (o.field && s.mode !== 'licence') { const carId = me.carId; const q = quickRaceSetup({ track: s.track, carId, field: o.field, pace: 0.92 }); s.cars = q.cars; } this.ui.clearStack(); this.paused = false; return this.startRace(s); }\n  setSkyNow(sc) { setSky(this.ctx.engine, sc.hour, { rain: sc.setup.rain }); }\n  retire(sc) {\n    const a = sc.setup.after;\n    if (a.kind === 'career') return this.toMenu({ screen: 'eventcard', id: a.eventId });\n    if (a.kind === 'licence') return this.toMenu({ screen: 'testcard', id: a.testId });\n    if (a.kind === 'route') return this.toMenu(a.route);\n    return this.toMenu({ screen: 'arcade' });\n  }\n  raceOver(scene) {\n    const { setup, sim } = scene, a = setup.after, p = this.profile, dev = this.dev.dirty;\n    this.lastReplay = sim.replayData();\n    if (setup.mode === 'attract' || scene.setup.attractClip || this.attract.active) return;\n    if (setup.mode === 'hub') return;\n    if (a.kind === 'route') { return this.toMenu(a.route); }\n    if (a.kind === 'licence') return this.licenceOver(scene);\n    const rows = sim.results ?? [];\n    const res = { setup, rows, replay: this.lastReplay, outcome: null, saved: false };\n    if (a.kind === 'career') {\n      res.snapshot = JSON.stringify(p);\n      const me = sim.player, rec = carRec(p); addMileage(p, rec, me.metres, setup.track === 'redclay' ? 0.34 : 0);\n      for (const c of sim.cars) p.seen[c.carId] = true;\n      res.outcome = applyRound(p, a.eventId, rows.map((r) => ({ key: r.key, name: r.name, player: r.player })), this.dev.tune.prize);\n      res.outcome.eventName = EVENT[a.eventId].name; res.eventId = a.eventId;\n      if (isFinite(me.bestLap) && !dev && record(p, setup.track, me.bestLap, me.carId)) res.recordLap = me.bestLap;\n      this.save();\n    }\n    this.lastResult = res; this.ui.clearStack(); this.ui.push(Results());\n  }\n  licenceOver(scene) {\n    const { setup, sim } = scene, a = setup.after, R = sim.run, p = this.profile, test = TEST[a.testId], total = a.times + (R.total ?? R.time);\n    // three layouts: the next car, times added\n    if (test.runs && !R.failed && a.run < test.runs.length - 1) { return this.startRace(licenceSetup(a.testId, a.run + 1, { times: total, demo: a.demo })); }\n    if (a.demo) return this.toMenu({ screen: 'testcard', id: a.testId });\n    const outcome = applyTest(p, a.testId, total, R.failed, this.dev.dirty); this.save();\n    this.lastResult = { licence: true, setup, testId: a.testId, time: total, failed: R.failed, reason: R.reason, hits: R.hits, outcome, replay: this.lastReplay };\n    this.ui.clearStack(); this.ui.push(LicenceResult());\n  }\n  continueAfterResult() {\n    const R = this.lastResult, a = R.setup.after;\n    if (R.licence) return this.toMenu({ screen: 'tests', lic: R.testId[0] });\n    if (a.kind === 'career') {\n      const o = R.outcome, id = a.eventId;\n      if (o.seriesOver && o.seriesWon) return this.toMenu({ screen: 'map', then: (app) => app.seriesEnd(o) });\n      if (o.seriesOver) return this.toMenu({ screen: 'eventcard', id });\n      return this.toMenu({ screen: 'roundcard', id });\n    }\n    return this.toMenu({ screen: 'arcade' });\n  }\n  seriesEnd(o) { const ui = this.ui, afterPrize = () => { if (o.ending) ui.replace(Ending()); else ui.pop(); }, afterPodium = () => { if (o.prizeCar) ui.replace(PrizeReveal(o.prizeCar, afterPrize)); else afterPrize(); }; ui.push(Podium(o, afterPodium)); }\n  retryResult() { const R = this.lastResult; if (R.snapshot) this.profile = JSON.parse(R.snapshot); this.save(); const a = R.setup.after; if (a.kind === 'career') return this.startRace(R.setup); return this.startRace(R.setup); }\n  watchResult() { const R = this.lastResult; return this.startReplay(R.replay, { screen: 'results' }); }\n  packReplay(d) { const every = Math.max(1, Math.round(d.hz / 10)), n = Math.floor(d.n / every), cars = d.data.map((a) => { const o = new Int16Array(n * 7); for (let i = 0; i < n; i++) { const k = i * every * 12, q = i * 7; o[q] = Math.round(a[k] * 4); o[q + 1] = Math.round(a[k + 1] * 16); o[q + 2] = Math.round(a[k + 2] * 4); o[q + 3] = Math.round(((a[k + 3] % 6.2832) + 6.2832) % 6.2832 * 4000); o[q + 4] = Math.round(a[k + 7] / 2); o[q + 5] = a[k + 10]; o[q + 6] = Math.round(a[k + 11] * 16); } return b64(o); }); return { track: d.track, hour: d.hour, rain: d.rain, n, label: d.label, cars: d.cars, data: cars, day: this.profile.day }; }\n  unpackReplay(s) { const data = s.data.map((str) => { const o = unb64(str), a = new Float32Array(s.n * 12); for (let i = 0; i < s.n; i++) { const k = i * 12, q = i * 7; a[k] = o[q] / 4; a[k + 1] = o[q + 1] / 16; a[k + 2] = o[q + 2] / 4; a[k + 3] = o[q + 3] / 4000; a[k + 7] = o[q + 4] * 2; a[k + 8] = 0.6; a[k + 9] = 3; a[k + 10] = o[q + 5]; a[k + 11] = o[q + 6] / 16; } return a; }); return { track: s.track, hour: s.hour, rain: s.rain, n: s.n, hz: 10, label: s.label, cars: s.cars, data }; }\n  saveReplay(d) { const p = this.profile; if (!p) return false; try { const s = this.packReplay(d); const prev = p.replays.slice(); p.replays.unshift(s); p.replays = p.replays.slice(0, 3); if (!this.save()) { p.replays = prev; this.save(); return false; } return true; } catch { return false; } }\n  toggleFullscreen() { if (typeof document === 'undefined') return; if (document.fullscreenElement) document.exitFullscreen?.(); else document.documentElement.requestFullscreen?.()?.catch?.(() => {}); }\n  // ---- test hooks\n  hook() { const app = this; return { app, state() { const s = app.scene, u = app.ui; return { scene: s?.name, screen: u.top?.id ?? null, stack: u.stack.map((x) => x.id), focus: u.focus, items: u.items.map((i) => i.id), prompts: (u.promptList ?? []).map((p) => p[1]), device: app.actions.device, idle: app.actions.idle, attract: app.attract.active, clip: app.attract.i, paused: app.paused, loading: app.loading, status: s?.status?.(), music: app.mix.audio?.volume?.music, profile: app.profile ? { credits: app.profile.credits, day: app.profile.day, cars: app.profile.cars.map((c) => c.id), licences: app.profile.licences } : null, tune: { ...app.dev.tune }, race: s?.sim ? { track: s.setup.track, phase: s.sim.phase, lap: s.sim.player.lap, pos: s.sim.player.position, done: s.sim.done, t: s.sim.t } : null, couch: app.couch, engine2: !!app.couchMgr.engine2 }; }, press(a) { app.actions.inject(a); } }; }\n}\nexport const parseUrl = () => { if (typeof location === 'undefined') return {}; const q = new URLSearchParams(location.search), o = {}; for (const [k, v] of q) o[k] = v; return o; };\nexport { TITLE, Engine, withUrlOptions, couchSetup };\nE\ncat > src/main.js <<'E'\n// Boot. Exports createGame() so check.mjs --headless and the tests can run the game in Node.\nimport { Engine, withUrlOptions } from './pixel-engine.js';\nimport { App, parseUrl } from './game/app.js';\nimport { MenuScene } from './game/scenes/menu.js';\nimport { RaceScene } from './game/scenes/race.js';\nimport { ReplayScene } from './game/scenes/replay.js';\nimport { startHub } from './game/net/hub.js';\nimport { quickRaceSetup, licenceSetup } from './game/sim/setups.js';\nimport { newProfile, buyCar } from './game/sim/career.js';\nimport { RaceSim } from './game/sim/race.js';\nimport { TITLE } from './game/data/meta.js';\nexport function createGame() { return new MenuScene(new App(), { screen: 'title' }); }\nfunction firstScene(app, u) {\n  if (u.scene === 'race') { const s = quickRaceSetup({ track: u.track ?? 'kestrel', carId: u.car ?? 'ginga', field: Number(u.ai ?? 5) + 1, pace: Number(u.pace ?? 0.92), laps: Number(u.laps ?? 2), hour: u.hour != null ? Number(u.hour) : undefined, rain: u.rain === '1' }); return new RaceScene(app, s); }\n  if (u.scene === 'licence') return new RaceScene(app, licenceSetup(u.test ?? 'C-1'));\n  if (u.scene === 'replay') { const s = quickRaceSetup({ track: u.track ?? 'kestrel', carId: u.car ?? 'ginga', field: 4, pace: 0.92, laps: 1 }); s.cars.forEach((c) => { c.ai = true; c.seat = c.seat ?? -1; }); const sim = new RaceSim({ ...s, tune: app.dev.tune }); for (let i = 0; i < 60 * 40; i++) sim.step([]); return new ReplayScene(app, sim.replayData(), { screen: 'title' }); }\n  return new MenuScene(app, app.profile ? { screen: 'title' } : { screen: 'title' });\n}\nif (typeof document !== 'undefined') {\n  document.title = TITLE;\n  const container = document.getElementById('p1');\n  const app = new App(); app.url = parseUrl(); window.__APP__ = app;\n  const fail = (e) => { const msg = 'THIS GAME NEEDS WEBGPU: A RECENT CHROME OR EDGE, SAFARI 26, OR FIREFOX 141 ON WINDOWS.'; const d = document.createElement('div'); d.textContent = msg; d.style.cssText = 'position:fixed;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;background:#1a1c2c;font:20px monospace;padding:40px;text-align:center'; document.body.append(d); console.warn(e); };\n  const hub = window.AIHub;\n  try {\n    let started = null;\n    if (hub && hub.active) started = await startHub(app, hub, container);\n    if (!started) {\n      const opts = withUrlOptions(app.engineOptions(container));\n      if (app.url.scene) { app.profile ??= newProfile(); if (!app.profile.cars.length) buyCar(app.profile, 'ginga'); app.instant = false; }\n      if (app.url.dev) app.devOpen = true;\n      const e = await Engine.start(firstScene(app, app.url), opts); app.engine = e; window.__ENGINE__ = e;\n    }\n  } catch (e) { fail(e); if (hub?.active) hub.fail('This game needs WebGPU.'); }\n}\nE\ncat > src/index.html <<'E'\n<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Grandpa Turismo (dev)</title>\n<style>html,body{margin:0;height:100%;background:#000;overflow:hidden}#row{display:flex;width:100vw;height:100vh}#p1{position:relative;width:100vw;height:100vh;overflow:hidden}#p2{display:none;position:relative;height:100vh;overflow:hidden}</style></head>\n<body><div id=\"row\"><div id=\"p1\"></div><div id=\"p2\"></div></div><script type=\"module\" src=\"./main.js\"></script></body></html>\nE\ncat > tools/hub-metas.html <<'E'\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"hub:type\" content=\"Game\">\n<meta name=\"hub:players\" content=\"1-2\">\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"ghost\">\n<meta name=\"hub:session-minutes\" content=\"4\">\n<meta name=\"hub:session-goal\" content=\"Lowest time wins: same car, same track\">\n<meta name=\"hub:session-howto\" content=\"Steer stick or A D. R2 or W go. L2 or S brake.\">\n<meta name=\"hub:webgpu\" content=\"required\">\nE\ncat > tools/build.mjs <<'E'\n// node tools/build.mjs [out.html]: the single HTML, with the exit interview and the kit's credits embedded.\nimport { execFileSync } from 'node:child_process';\nimport { readFileSync, writeFileSync, rmSync, existsSync } from 'node:fs';\nconst out = process.argv[2] ?? '../GrandpaTurismo-GranTurismo3ASpec-claude-opus-5-5-medium-20261105-171907.html', bundle = 'tools/.bundle.js';\nconst exitPath = '../exit-interview.json', exit = existsSync(exitPath) ? JSON.parse(readFileSync(exitPath, 'utf8')) : { sourceInformation: {}, testingFeedback: [], engineFeedback: [], promptFeedback: [] };\nconst credits = readFileSync('src/CREDITS.md', 'utf8').split('\\n').slice(0, 400).join('\\n');\nconst version = /\\*\\*([0-9.]+)\\*\\*/.exec(readFileSync('src/GUIDE.md', 'utf8'))?.[1] ?? 'unknown';\nwriteFileSync('src/game/data/about.gen.js', `// Written by tools/build.mjs from the exit interview and the kit's CREDITS.md.\\nexport const ABOUT = ${JSON.stringify({ exit, credits, engineVersion: version })};\\n`);\nexecFileSync('esbuild', ['src/main.js', '--bundle', '--format=esm', '--target=esnext', '--charset=utf8', '--legal-comments=none', `--outfile=${bundle}`, '--log-level=warning'], { stdio: 'inherit' });\nconst js = readFileSync(bundle, 'utf8').replace(/<\\/script/gi, '<\\\\/script');\nrmSync(bundle);\nconst session = readFileSync('tools/hub/session.js', 'utf8');\nconst metas = readFileSync('tools/hub-metas.html', 'utf8');\nconst html = `<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><script>${session}</script><title>Grandpa Turismo</title>\n${metas}\n<style>html,body{margin:0;height:100%;background:#000;overflow:hidden}#row{display:flex;width:100vw;height:100vh}#p1{position:relative;width:100vw;height:100vh;overflow:hidden}#p2{display:none;position:relative;height:100vh;overflow:hidden}</style>\n</head><body><div id=\"row\"><div id=\"p1\"></div><div id=\"p2\"></div></div><script type=\"module\">${js}</script></body></html>`;\nwriteFileSync(out, html);\nconsole.log(`${out}: ${(html.length / 1048576).toFixed(1)} MB`);\nE\ncat >> ../PROGRESS.md <<'E'\n- All first-draft modules written (dev, attract, hub, couch, app, main, build). Next: build + browser test + fix; then tests suites, medals rerun, balance, screenshots, docs, exit interview.\nE\ncat > ../exit-interview.json <<'E'\n{\"sourceInformation\":{\"date\":\"2026-11-05 17:19:07\",\"source\":\"Gran Turismo 3: A-Spec\",\"plan\":\"PLAN.md\",\"genre\":\"\",\"perspective\":\"\",\"tech\":\"\",\"artDirection\":\"\",\"animation\":\"\",\"audio\":\"\",\"online\":\"\",\"testing\":\"\",\"research\":\"\",\"environment\":\"Claude Code CLI (headless); Linux\",\"model\":\"Anthropic, claude-opus-5-5, reasoning effort medium\",\"usage\":\"added on import\"},\"testingFeedback\":[],\"engineFeedback\":[],\"promptFeedback\":[]}\nE\nnode tools/build.mjs 2>&1 | tail -20","description":"Write dev mode, attract, hub, couch, app, main, build"}}}
