.p.root.position.x; d.step(120); t.ok(app.scene.hikers[0].p.root.position.x !== x0, 'the hikers move'); }\n{ const r = new RaceScene(app, quickRaceSetup({ track: 'kestrel', carId: 'ginga', field: 3, pace: 0.9, laps: 1 })); await e.loadGame(r); r.sim.cars.forEach((c) => (c.ai = true)); for (let i = 0; i < 1500; i++) r.sim.step([]); const data = r.sim.replayData(); await e.loadGame(new ReplayScene(app, data, { screen: 'map' })); d.step(300); const sp = app.scene; t.ok(app.mix.lastVoice?.speaker === 'dell', 'Dell talks over the replay', JSON.stringify(app.mix.lastVoice)); t.ok(app.ui.subtitle?.speaker === 'DELL', 'with subtitles'); const seen = new Set(); for (let i = 0; i < 40 && seen.size < 2; i++) { sp.tv.timer = 0; d.step(2); seen.add(sp.tv.shot); } t.ok(seen.size >= 2, 'the director cuts between shots', [...seen].join()); const fakes = sp.data.data[1]; const save = sp.t; sp.t = 2; const k = Math.floor(2 * sp.data.hz) * 12; const old = fakes[k + 10]; fakes[k + 10] = 2; fakes[k + 12 + 10] = 2; t.ok(sp.interest() === 1, 'the director prefers a sliding car', `${sp.interest()}`); fakes[k + 10] = old; sp.t = save; app.ui.subtitle = null; }\n{ const lp = app.profile; app.ui.clearStack(); const prof = JSON.stringify(lp); lp.licences = {}; await e.loadGame(new MenuScene(app, { screen: 'map' })); d.step(3); const dayA = e.ambient.intensity; lp.licences = { C: true, B: true, A: true }; lp.events.h200 = { won: true, round: 0, points: {} }; app.scene.setSet('map', {}); d.step(2); t.ok(app.scene.mapNight > 0.7 && app.scene.nightLamps.visible, 'the Map has night lamps once the Grand Prix is near'); t.ok(e.ambient.intensity < dayA + 0.01 && e.sun.intensity < 0.5, 'the Map at night is dark', `${e.ambient.intensity} ${e.sun.intensity}`); lp.licences = {}; delete lp.events.h200; app.scene.setSet('map', {}); t.ok(!app.scene.nightLamps.visible, 'no lamps by day'); app.profile = JSON.parse(prof); app.ui.clearStack(); }\n// clips\n\"\"\")\nsub(H,\"import { RaceScene } from '../../src/game/scenes/race.js';\",\"import { RaceScene } from '../../src/game/scenes/race.js';\\nimport { ReplayScene } from '../../src/game/scenes/replay.js';\")\nB='tools/tests/browser.py'\nsub(B,\"\"\"pg.keyboard.press if False else None\n    pg.evaluate(\"window.__GAME__.app.ui.pop()\"); screen_is(pg,'title');\"\"\",\"\"\"\n    r=pg.evaluate(\"(()=>{const a=window.__GAME__.app,c=document.querySelector('#p1 canvas').getBoundingClientRect();return {x:c.left+(a.hud.width-20)/a.hud.width*c.width,y:c.top+(a.hud.height-9)/a.hud.height*c.height}})()\")\n    pg.touchscreen.tap(r['x'],r['y']); screen_is(pg,'title'); t.ok(True,'a tap on the Back prompt leaves settings');\"\"\")\nE\ngrep -n \"Dressing\\|hikers\" src/game/render/dressing.js | cut -c1-110 | head -4; node tools/build.mjs | tail -1; timeout 280 node tools/test.mjs data headless 2>&1 | cut -c1-420 | tail -8","description":"Build the gaps found by the plan audit; run suites","timeout":300000}}}
