cus = items[0]?.id ?? this.focus;\n    const pt = this.app.ctx.input.pointer;\n    if ((a.mouseMoved || a.click || a.touchDown) && pt) for (const it of items) if (this.rectHit(pt, it)) { if (this.focus !== it.id) { this.focus = it.id; this.playTick(); } if (a.click || a.touchDown) this.clickHit = it.id; }\n    const lr = this.prevItems.find((i) => i.id === this.focus)?.slider;\n    for (const [d, dx, dy] of [['up', 0, -1], ['down', 0, 1], ['left', -1, 0], ['right', 1, 0]]) {\n      if (!a.pressed(d) || (lr && dx !== 0)) continue;\n      const cur = items.find((i) => i.id === this.focus); if (!cur) break;\n      const cxx = cur.x + cur.w / 2, cyy = cur.y + cur.h / 2; let best = null, bd = 1e9;\n      for (const it of items) { if (it === cur) continue; const ix = it.x + it.w / 2, iy = it.y + it.h / 2, ddx = ix - cxx, ddy = iy - cyy, along = ddx * dx + ddy * dy, across = Math.abs(ddx * dy) + Math.abs(ddy * dx); if (along <= 2) continue; const score = along + across * 2.2; if (score < bd) { bd = score; best = it; } }\n      if (best) { this.focus = best.id; this.playTick(); }\n    }\n  }\n  playTick() { this.app.mix?.ui('tick'); }\n  // ---- widgets\n  text(x, y, s, o = {}) { this.hud.text(x, y, clean(s), o); }\n  center(y, s, o = {}) { const t = clean(s), sc = o.scale ?? 1; this.hud.text(Math.round(this.cx - (t.length * 6 * sc) / 2), y, t, o); }\n  right(xr, y, s, o = {}) { const t = clean(s), sc = o.scale ?? 1; this.hud.text(Math.round(xr - t.length * 6 * sc), y, t, o); }\n  rect(x, y, w, h, c) { this.hud.rect(x, y, w, h, c); }\n  panel(x, y, w, h, c = 'ink', edge = 'night') { this.hud.rect(x, y, w, h, c); this.hud.rect(x, y, w, 1, edge); this.hud.rect(x, y + h - 1, w, 1, edge); this.hud.rect(x, y, 1, h, edge); this.hud.rect(x + w - 1, y, 1, h, edge); }\n  title(s, sub) { this.hud.rect(0, 0, this.W, 22, 'ink'); this.hud.rect(0, 22, this.W, 1, 'slate'); this.text(10, 5, s, { scale: 2, color: 'sand' }); if (sub) this.right(this.W - 10, 8, sub, { color: 'mist' }); }\n  para(x, y, s, width = 60, o = {}) { const lines = wrap(s, width); lines.forEach((l, i) => this.hud.text(x, y + i * 10, l, o)); return y + lines.length * 10; }\n  bar(x, y, w, h, f, c = 'lime', bg = 'night') { this.hud.rect(x, y, w, h, bg); this.hud.rect(x, y, Math.max(0, Math.round(w * Math.min(1, f))), h, c); }\n  /** A focusable item. Returns true on the frame it is confirmed. */\n  item(id, x, y, w, h, o = {}) {\n    const it = { id, x, y, w, h, label: o.label, slider: o.slider, disabled: o.disabled }; this.items.push(it);\n    const a = this.app.actions, focused = this.focus === id;\n    if (this.focus == null) this.focus = id;\n    let hit = false;\n    if (this.clickHit === id) { hit = true; this.clickHit = null; }\n    else if (focused && a.pressed('confirm')) hit = true;\n    if (hit) { a.consume('confirm'); this.confirmHit = id; if (o.disabled) { this.app.mix?.ui('denied'); return false; } this.app.mix?.ui('confirm'); }\n    return hit;\n  }\n  button(id, x, y, w, h, label, o = {}) {\n    const f = this.focus === id, bg = o.disabled ? 'ink' : f ? 'night' : o.bg ?? 'ink';\n    this.hud.rect(x, y, w, h, bg); if (o.edge !== false) { this.hud.rect(x, y, w, 1, 'slate'); this.hud.rect(x, y + h - 1, w, 1, 'slate'); this.hud.rect(x, y, 1, h, 'slate'); this.hud.rect(x + w - 1, y, 1, h, 'slate'); }\n    const sc = o.scale ?? 1, t = clean(label), tw = t.length * 6 * sc;\n    this.hud.text(o.left ? x + 6 : Math.round(x + (w - tw) / 2), o.sub ? y + 4 : Math.round(y + (h - 7 * sc) / 2), t, { scale: sc, color: o.disabled ? 'slate' : o.color ?? (f ? 'sand' : 'white') });\n    if (o.sub) { const s = clean(o.sub); this.hud.text(o.left ? x + 6 : Math.round(x + (w - s.length * 6) / 2), y + 5 + 7 * sc + 2, s, { color: o.disabled ? 'slate' : o.subColor ?? 'mist' }); }\n    return this.item(id, x, y, w, h, { label, disabled: o.disabled });\n  }\n  slider(id, x, y, w, label, value, min, max, step, onChange, o = {}) {\n    const f = this.focus === id, h = o.h ?? 18;\n    this.hud.rect(x, y, w, h, f ? 'night' : 'ink');\n    this.text(x + 4, y + 2, label, { color: f ? 'sand' : 'white' });\n    const fmt = o.format ?? ((v) => v.toFixed(2)); this.right(x + w - 4, y + 2, fmt(value), { color: 'white' });\n    const bx = x + 4, bw = w - 8, by = y + 11; this.hud.rect(bx, by, bw, 4, 'navy'); const fr = (value - min) / (max - min); this.hud.rect(bx, by, Math.round(bw * fr), 4, f ? 'lime' : 'mist'); this.hud.rect(bx + Math.round((bw - 2) * fr), by - 1, 2, 6, 'white');\n    if (o.dflt != null) this.hud.rect(bx + Math.round((bw - 1) * ((o.dflt - min) / (max - min))), by + 4, 1, 2, 'sand');\n    this.item(id, x, y, w, h, { label, slider: true });\n    let v = value;\n    if (f && this.leftRight) { v = Math.max(min, Math.min(max, Math.round((value + this.leftRight * step) / step) * step)); }\n    const a = this.app.actions, input = this.app.ctx.input, pt = input.pointer;\n    if (input.isDown('MouseLeft') && this.rectHit(pt, { x, y, w, h })) { const px = ((pt.x + 1) / 2) * this.W; v = min + (max - min) * Math.max(0, Math.min(1, (px - bx) / bw)); v = Math.round(v / step) * step; this.focus = id; }\n    void a;\n    if (Math.abs(v - value) > 1e-9) { this.app.mix?.ui('tick'); onChange(Math.round(v * 1e6) / 1e6); }\n  }\n  tabs(y, names, cur, onChange, id = 'tab') {\n    const a = this.app.actions; let idx = cur;\n    if (a.pressed('tabL')) idx = (cur - 1 + names.length) % names.length; if (a.pressed('tabR')) idx = (cur + 1) % names.length;\n    const w = Math.min(90, Math.floor((this.W - 20) / names.length)); let x = 10;\n    names.forEach((n, i) => { const on = i === cur; this.hud.rect(x, y, w - 2, 13, on ? 'navy' : 'ink'); if (on) this.hud.rect(x, y + 12, w - 2, 1, 'sand'); const t = clean(n); this.hud.text(Math.round(x + (w - 2 - t.length * 6) / 2), y + 3, t, { color: on ? 'sand' : 'mist' }); const pt = this.app.ctx.input.pointer; if (this.app.actions.click && this.rectHit(pt, { x, y, w: w - 2, h: 13 })) idx = i; x += w; });\n    if (idx !== cur) { this.app.mix?.ui('tick'); onChange(idx); this.focus = null; this.clickHit = null; }\n    void id;\n  }\n  /** Bottom prompt row: what the buttons do right now. Clicking a prompt does what the button does. */\n  prompts(list) {\n    const a = this.app.actions, dev = a.device, xb = this.app.settings.glyphs === 'xbox'; const y = this.H - 15;\n    this.hud.rect(0, y - 2, this.W, 17, 'ink'); this.hud.rect(0, y - 3, this.W, 1, 'slate');\n    let w = 0; for (const [act, label] of list) w += glyphWidth(act, dev, xb) + 3 + clean(label).length * 6 + 10;\n    let x = this.W - 8 - w + 10; if (x < 4) x = 4;\n    const pt = this.app.ctx.input.pointer;\n    for (const [act, label, cb] of list) {\n      const x0 = x; x += drawGlyph(this.hud, x, y, act, dev, xb) + 3; const t = clean(label); this.hud.text(x, y + 2, t, { color: 'white' }); x += t.length * 6 + 10;\n      if ((a.click || a.touchDown) && this.rectHit(pt, { x: x0, y: y - 2, w: x - x0, h: 15 })) { if (act === 'back') this.backHit = true; else if (cb) cb(); else a.pressedSet[act] = true; }\n    }\n    this.promptList = list;\n  }\n  status(line) { this.text(6, this.H - 13, line, { color: 'mist' }); }\n  drawFocus(dt) {\n    const it = this.items.find((i) => i.id === this.focus); if (!it) return;\n    const b = this.box; if (!b.init) { Object.assign(b, { x: it.x, y: it.y, w: it.w, h: it.h, init: true }); }\n    const k = 1 - Math.exp(-dt * 22); b.x += (it.x - b.x) * k; b.y += (it.y - b.y) * k; b.w += (it.w - b.w) * k; b.h += (it.h - b.h) * k;\n    const pulse = Math.floor(this.t * 5) % 2 ? 'sand' : 'white', x = Math.round(b.x) - 2, y = Math.round(b.y) - 2, w = Math.round(b.w) + 4, h = Math.round(b.h) + 4;\n    this.hud.rect(x, y, w, 2, pulse); this.hud.rect(x, y + h - 2, w, 2, pulse); this.hud.rect(x, y, 2, h, pulse); this.hud.rect(x + w - 2, y, 2, h, pulse);\n  }\n  say(text, speaker, o = {}) { const lines = wrap(text, 58).slice(0, 4); this.subtitle = { lines, speaker: speaker?.name ?? '', t: o.time ?? Math.max(2.5, text.length * 0.07) }; this.app.mix?.say(text, speaker?.id ?? speaker); }\n  drawSubtitle(dt) {\n    const s = this.subtitle; s.t -= dt; if (s.t <= 0) { this.subtitle = null; return; }\n    const h = s.lines.length * 10 + (s.speaker ? 11 : 4) + 4, y = this.H - 19 - h - 2, w = 60 * 6 + 12, x = this.cx - w / 2;\n    this.hud.rect(x, y, w, h, 'ink'); this.hud.rect(x, y, 2, h, 'sand');\n    if (s.speaker) this.hud.text(x + 7, y + 3, clean(s.speaker), { color: 'sand' });\n    s.lines.forEach((l, i) => this.hud.text(x + 7, y + (s.speaker ? 13 : 4) + i * 10, l, { color: 'white' }));\n  }\n  toast(text, c = 'lime') { this.toasts.push({ text: clean(text), t: 2.4, c }); }\n  drawToasts(dt) { this.toasts = this.toasts.filter((x) => (x.t -= dt) > 0); this.toasts.slice(-3).forEach((x, i) => { const w = x.text.length * 6 + 10, X = this.cx - w / 2, Y = 28 + i * 14; this.hud.rect(X, Y, w, 12, 'ink'); this.hud.rect(X, Y, w, 1, x.c); this.hud.text(X + 5, Y + 3, x.text, { color: x.c }); }); }\n}\nE\ncat >> ../PROGRESS.md <<'E'\n- input/{pad,actions}, ui/{glyphs,ui} written. Next: audio/mix+enginesynth, app.js, scenes/race.js, main.js, tools/build.mjs; then menus.\nE","description":"Write input layer, glyphs and UI core"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":864,"cache_read_input_tokens":273827,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":864},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c060cbf0-9de2-4b69-aed6-69ef0ff7f0ee","uuid":"dfa1b305-f947-4372-8029-dab0fab0b2c2","timestamp":"2026-11-06T00:35:10.324Z","request_id":"req_011CgkjYQAXszJhnGBLHfxVy","wire_tool_inputs":{"toolu_01HYumAKpkyaGsAHygAz7VtS":{"command":"cat > src/game/input/pad.js <<'E'\n// Reads every pad in the standard mapping once a frame, quantised, and sends changes through the engine's command queue so recordings replay them.\nconst q = (v) => Math.round(v * 255) / 255;\nlet last = '';\nexport function pollPads(input) {\n  if (typeof navigator === 'undefined' || !navigator.getGamepads) return;\n  let raw; try { raw = navigator.getGamepads(); } catch { return; }\n  const pads = [];\n  for (const p of raw ?? []) { if (!p || p.connected === false) continue; pads.push({ i: p.index, b: Array.from(p.buttons, (b) => q(b.value ?? (b.pressed ? 1 : 0))), a: Array.from(p.axes, q) }); }\n  const key = JSON.stringify(pads);\n  if (key !== last) { last = key; input.send({ pads }); }\n}\nexport function rumble(index, strong, weak, ms) {\n  if (typeof navigator === 'undefined' || !navigator.getGamepads) return;\n  try { const p = navigator.getGamepads()?.[index]; p?.vibrationActuator?.playEffect?.('dual-rumble', { duration: ms, strongMagnitude: strong, weakMagnitude: weak })?.catch?.(() => {}); } catch { /* a pad without rumble */ }\n}\nE\ncat > src/game/input/actions.js <<'E'\n// Keys, mouse and latched pad state become per-player actions. Tracks the last device (for prompts) and idle time (for attract mode).\nconst KEYS = { confirm: ['Enter', 'NumpadEnter'], back: ['Escape', 'Backspace'], alt: ['KeyT'], info: ['KeyI'], tabL: ['KeyQ'], tabR: ['KeyE', 'Tab'], pause: ['Escape'], up: ['ArrowUp', 'KeyW'], down: ['ArrowDown', 'KeyS'], left: ['ArrowLeft', 'KeyA'], right: ['ArrowRight', 'KeyD'] };\nconst PAD = { confirm: 0, back: 1, alt: 2, info: 3, tabL: 4, tabR: 5, pause: 9, up: 12, down: 13, left: 14, right: 15 };\nconst ALL_ACTIONS = Object.keys(KEYS), DIRS = ['up', 'down', 'left', 'right'];\nconst WATCH_KEYS = new Set(['Enter', 'NumpadEnter', 'Escape', 'Backspace', 'KeyT', 'KeyI', 'KeyQ', 'KeyE', 'Tab', 'ArrowUp', 'KeyW', 'ArrowDown', 'KeyS', 'ArrowLeft', 'KeyA', 'ArrowRight', 'KeyD', 'Space', 'KeyC', 'KeyB', 'KeyR', 'ShiftLeft', 'ControlLeft', 'KeyM', 'KeyP', 'F1', 'F2']);\nexport class Actions {\n  constructor(app) {\n    this.app = app; this.device = 'kb'; this.idle = 0; this.pads = []; this.prevPads = []; this.frame = -1; this.now = {}; this.prev = {}; this.pressedSet = {}; this.repeat = {}; this.injected = []; this.anyInput = false; this.shiftQ = [{ up: 0, down: 0 }, { up: 0, down: 0 }];\n    this.seat = [this.newSeat(), this.newSeat()]; this.mouseMoved = false; this.lastPointer = { x: 0, y: 0 }; this.wheel = 0; this.click = false; this.rightClick = false; this.touchDown = false; this.sawKey = false; this.keysDown = new Set();\n  }\n  newSeat() { return { steer: 0, throttle: 0, brake: 0, digitalT: false, digitalB: false, triHold: 0, triWas: false, cameraTap: false, recoverHeld: 0, seenAnalogT: false, seenAnalogB: false }; }\n  /** Once per frame, at the top of whichever hook runs first. */\n  latch(ctx) {\n    if (ctx.engine.frame === this.frame) return false;\n    this.frame = ctx.engine.frame;\n    const input = ctx.input;\n    for (const cmd of input.commands) if (cmd && cmd.pads) { this.prevPadsRaw = this.pads; this.pads = cmd.pads; }\n    let active = false;\n    // pads: anything moved by more than 0.2 counts as input\n    const prevPads = this.prevPads;\n    for (const p of this.pads) { const o = prevPads.find((x) => x.i === p.i); if (!o) { active = true; continue; } let moved = false; p.b.forEach((v, k) => { if (Math.abs(v - (o.b[k] ?? 0)) > 0.2) moved = true; }); p.a.forEach((v, k) => { if (Math.abs(v - (o.a[k] ?? 0)) > 0.2) moved = true; }); if (moved) { active = true; this.device = 'pad'; } }\n    this.padNow = this.pads[0] ?? null;\n    // keys\n    let keyActive = false;\n    for (const code of WATCH_KEYS) if (input.wasPressed(code)) keyActive = true;\n    if (keyActive) { this.device = 'kb'; active = true; this.sawKey = true; }\n    if (this.anyKeyEvent) { active = true; this.anyKeyEvent = false; this.sawKey = true; }\n    // mouse\n    const pt = input.pointer; this.mouseMoved = false;\n    const dpx = Math.hypot(pt.x - this.lastPointer.x, pt.y - this.lastPointer.y);\n    if (dpx > 0.006 && pt.over !== false) { this.mouseMoved = true; this.lastPointer.x = pt.x; this.lastPointer.y = pt.y; if (!pt.touch) { this.device = this.device === 'pad' ? 'mouse' : 'mouse'; active = true; } }\n    this.click = input.wasPressed('MouseLeft'); this.rightClick = input.wasPressed('MouseRight'); this.touchDown = input.wasPressed('Touch'); this.wheel = input.wheel;\n    if (this.click || this.rightClick) { this.device = 'mouse'; active = true; }\n    if (this.touchDown || this.wheel) active = true;\n    // actions: edges\n    this.prev = this.now; this.now = {}; this.pressedSet = {};\n    const pad = this.mergedPad();\n    for (const a of ALL_ACTIONS) { const held = input.anyDown(KEYS[a]) || this.padBtn(pad, a); this.now[a] = held; if (input.wasPressed(...KEYS[a]) || (this.padEdge(a))) this.pressedSet[a] = true; }\n    if (pad) { const x = pad.a[0] ?? 0, y = pad.a[1] ?? 0; const was = this.stickDir ?? {}; const d = { left: x < -0.5, right: x > 0.5, up: y < -0.5, down: y > 0.5 }; for (const k of DIRS) { if (d[k]) this.now[k] = true; if (d[k] && !was[k]) this.pressedSet[k] = true; } this.stickDir = d; }\n    // Create + Options is the hub's: ignore Options while Create is held.\n    if (pad && (pad.b[8] ?? 0) > 0.5 && (pad.b[9] ?? 0) > 0.5) { delete this.pressedSet.pause; this.now.pause = false; }\n    for (const a of this.injected) this.pressedSet[a] = true;\n    if (this.injected.length) active = true;\n    this.injected.length = 0;\n    // repeat for menu moves\n    const dt = ctx.engine.realDt ?? 1 / 60;\n    for (const k of DIRS) { const r = (this.repeat[k] ??= { t: 0 }); if (this.pressedSet[k]) r.t = -0.35; else if (this.now[k]) { r.t += dt; if (r.t >= 0) { r.t -= 0.09; this.pressedSet[k] = true; this.repeated = true; } } else r.t = 0; }\n    this.idle = active ? 0 : this.idle + dt;\n    this.anyInput = active;\n    // shift presses wait for the next fixed step\n    this.queueShifts(0, input, pad); if (this.app.couch) this.queueShifts(1, input, this.padForSeat(1));\n    this.prevPads = this.pads;\n    return true;\n  }\n  mergedPad() { return this.pads.find((p) => p.b.some((v) => v > 0.1) || p.a.some((v) => Math.abs(v) > 0.15)) ?? this.pads[0] ?? null; }\n  padBtn(pad, a) { return !!pad && (pad.b[PAD[a]] ?? 0) > 0.5; }\n  padEdge(a) { const k = PAD[a]; for (const p of this.pads) { const o = this.prevPads.find((x) => x.i === p.i); if ((p.b[k] ?? 0) > 0.5 && (o?.b[k] ?? 0) <= 0.5) return true; } return false; }\n  pressed(a) { return !!this.pressedSet[a]; }\n  down(a) { return !!this.now[a]; }\n  inject(a) { this.injected.push(a); }\n  consume(a) { const v = !!this.pressedSet[a]; delete this.pressedSet[a]; return v; }\n  /** Which pad belongs to a seat. Single player: whichever is active. Couch: P1 is pad 0, P2 is pad 1. */\n  padForSeat(seat) { if (!this.app.couch) return seat === 0 ? this.mergedPad() : null; return this.pads[seat] ?? null; }\n  keysFor(seat) {\n    if (!this.app.couch) return { left: ['KeyA', 'ArrowLeft'], right: ['KeyD', 'ArrowRight'], go: ['KeyW', 'ArrowUp'], brake: ['KeyS', 'ArrowDown'], hand: ['Space'], up: ['KeyE', 'ShiftLeft'], dn: ['KeyQ', 'ControlLeft'], cam: ['KeyC'], back: ['KeyB'], rec: ['KeyR'] };\n    const pads = this.pads.length;\n    const wasd = { left: ['KeyA'], right: ['KeyD'], go: ['KeyW'], brake: ['KeyS'], hand: ['Space'], up: ['KeyE'], dn: ['KeyQ'], cam: ['KeyC'], back: ['KeyB'], rec: ['KeyR'] };\n    const arrows = { left: ['ArrowLeft'], right: ['ArrowRight'], go: ['ArrowUp'], brake: ['ArrowDown'], hand: ['Enter', 'NumpadEnter'], up: ['Period'], dn: ['Comma'], cam: ['Slash'], back: ['KeyL'], rec: ['KeyK'] };\n    if (pads >= 2) return null; // both on pads\n    if (pads === 1) return seat === 1 ? wasd : null; // the pad is P1, the keyboard is P2\n    return seat === 0 ? wasd : arrows;\n  }\n  queueShifts(seat, input, pad) {\n    const k = this.keysFor(seat), q = this.shiftQ[seat];\n    if (k) { if (input.wasPressed(...k.up)) q.up++; if (input.wasPressed(...k.dn)) q.down++; }\n    if (pad) { const o = this.prevPads.find((x) => x.i === pad.i); if ((pad.b[5] ?? 0) > 0.5 && (o?.b[5] ?? 0) <= 0.5) q.up++; if ((pad.b[4] ?? 0) > 0.5 && (o?.b[4] ?? 0) <= 0.5) q.down++; }\n  }\n  /** Driving input for one seat, with the plan's filters. Called once per fixed step. */\n  driving(ctx, seat, dt, s = this.app.settings) {\n    const st = this.seat[seat], input = ctx.input, keys = this.keysFor(seat), pad = this.padForSeat(seat);\n    let steerT = 0, thr = 0, brk = 0, hand = false, analogSteer = false, tKey = false, bKey = false;\n    if (keys) { if (input.anyDown(keys.left)) steerT -= 1; if (input.anyDown(keys.right)) steerT += 1; if (input.anyDown(keys.go)) { thr = 1; tKey = true; } if (input.anyDown(keys.brake)) { brk = 1; bKey = true; } if (input.anyDown(keys.hand)) hand = true; }\n    if (pad) {\n      let x = pad.a[0] ?? 0; const dz = 0.08, mag = Math.abs(x);\n      if (mag > dz) { x = Math.sign(x) * Math.pow((mag - dz) / (1 - dz), s.steerCurve ?? 1.4); analogSteer = true; steerT = x; }\n      const r2 = pad.b[7] ?? 0, l2 = pad.b[6] ?? 0;\n      if (r2 > 0 && r2 < 1) st.seenAnalogT = true; if (l2 > 0 && l2 < 1) st.seenAnalogB = true;\n      if (r2 > 0.02) { thr = Math.max(thr, r2); if (!st.seenAnalogT) tKey = true; } if (l2 > 0.02) { brk = Math.max(brk, l2); if (!st.seenAnalogB) bKey = true; }\n      if ((pad.b[2] ?? 0) > 0.5) hand = true;\n      if (pad.b[12] > 0.5 && !analogSteer) { /* d-pad up is free */ }\n      if ((pad.b[14] ?? 0) > 0.5) steerT = -1; if ((pad.b[15] ?? 0) > 0.5) steerT = 1;\n    }\n    if (s.mouseSteer && seat === 0 && !this.app.couch) { const pt = input.pointer; steerT = Math.max(-1, Math.min(1, pt.x * 1.4)); analogSteer = true; if (input.isDown('MouseLeft')) { thr = 1; tKey = true; } if (input.isDown('MouseRight')) { brk = 1; bKey = true; } }\n    // filters: keyboard steering goes toward ±1 at 3.2/s, returns at 6/s; digital pedals ramp over 0.1 s\n    if (analogSteer) st.steer = steerT;\n    else { const rate = steerT === 0 ? 6 : Math.sign(steerT) !== Math.sign(st.steer) && st.steer !== 0 ? 6 : 3.2, d = steerT - st.steer, m = rate * dt; st.steer += Math.max(-m, Math.min(m, d)); }\n    const ramp = (cur, tgt, digital) => (digital ? cur + Math.max(-dt / 0.1, Math.min(dt / 0.1, tgt - cur)) : tgt);\n    st.throttle = ramp(st.throttle, thr, tKey || thr === 0); st.brake = ramp(st.brake, brk, bKey || brk === 0);\n    const q = this.shiftQ[seat], up = q.up > 0, down = q.down > 0; q.up = 0; q.down = 0;\n    return { steer: st.steer, throttle: st.throttle, brake: st.brake, handbrake: hand, up, down };\n  }\n  /** Tap camera, hold to recover: per frame. Returns { camera, lookBack, recover, orbitX, orbitY }. */\n  driveExtras(ctx, seat, dt) {\n    const st = this.seat[seat], input = ctx.input, keys = this.keysFor(seat), pad = this.padForSeat(seat);\n    let cam = false, lookBack = false, rec = false, ox = 0, oy = 0;\n    const tri = !!pad && (pad.b[3] ?? 0) > 0.5;\n    if (tri) st.triHold += dt; else { if (st.triWas && st.triHold < 0.3) cam = true; st.triHold = 0; }\n    st.triWas = tri;\n    if (tri && st.triHold >= 0.3) rec = true;\n    if (keys) { if (input.wasPressed(...keys.cam)) cam = true; if (input.anyDown(keys.back)) lookBack = true; if (input.anyDown(keys.rec)) rec = true; }\n    if (pad && (pad.b[1] ?? 0) > 0.5) lookBack = true;\n    if (pad) { ox = Math.abs(pad.a[2] ?? 0) > 0.15 ? pad.a[2] : 0; oy = Math.abs(pad.a[3] ?? 0) > 0.15 ? pad.a[3] : 0; }\n    st.recoverHeld = rec ? st.recoverHeld + dt : 0;\n    return { camera: cam, lookBack, recoverHeld: st.recoverHeld, orbitX: ox, orbitY: oy };\n  }\n  /** Any input at all, for leaving attract mode. */\n  get touched() { return this.anyInput; }\n}\nE\ncat > src/game/ui/glyphs.js <<'E'\n// Prompts: PlayStation, Xbox, keycaps and mouse icons as hud.sprite rows, about 11×11 art pixels.\nconst pad = (rows, c = 'white') => ({ rows, colors: { '#': c, o: 'ink' } });\nconst CIRCLE_BASE = ['...#####...', '..#ooooo#..', '.#ooooooo#.', '#ooooooooo#', '#ooooooooo#', '#ooooooooo#', '#ooooooooo#', '#ooooooooo#', '.#ooooooo#.', '..#ooooo#..', '...#####...'];\nfunction stamp(inner, ic) { const r = CIRCLE_BASE.map((s) => s.split('')); inner.forEach((row, y) => [...row].forEach((ch, x) => { if (ch === 'x') r[y + 2][x + 2] = 'i'; })); return { rows: r.map((a) => a.join('')), colors: { '#': 'mist', o: 'ink', i: ic } }; }\nconst PS = {\n  cross: stamp(['x.....x', '.x...x.', '..x.x..', '...x...', '..x.x..', '.x...x.', 'x.....x'], 'sky'),\n  circle: stamp(['..xxx..', '.x...x.', 'x.....x', 'x.....x', 'x.....x', '.x...x.', '..xxx..'], 'red'),\n  square: stamp(['xxxxxxx', 'x.....x', 'x.....x', 'x.....x', 'x.....x', 'x.....x', 'xxxxxxx'], 'orange'),\n  triangle: stamp(['...x...', '...x...', '..x.x..', '..x.x..', '.x...x.', '.x...x.', 'xxxxxxx'], 'lime'),\n};\nconst LETTER = { A: ['..x..', '.x.x.', 'x...x', 'x...x', 'xxxxx', 'x...x', 'x...x'], B: ['xxxx.', 'x...x', 'x...x', 'xxxx.', 'x...x', 'x...x', 'xxxx.'], X: ['x...x', 'x...x', '.x.x.', '..x..', '.x.x.', 'x...x', 'x...x'], Y: ['x...x', 'x...x', '.x.x.', '..x..', '..x..', '..x..', '..x..'] };\nconst pad1 = (rows) => rows.map((r) => `.${r}.`);\nconst XB = { cross: stamp(pad1(LETTER.A), 'lime'), circle: stamp(pad1(LETTER.B), 'red'), square: stamp(pad1(LETTER.X), 'sky'), triangle: stamp(pad1(LETTER.Y), 'sand') };\nexport const MOUSE = {\n  left: { rows: ['..#####..', '.#xx#oo#.', '#xxx#ooo#', '#xxx#ooo#', '#########', '#ooooooo#', '#ooooooo#', '#ooooooo#', '#ooooooo#', '.#ooooo#.', '..#####..'], colors: { '#': 'mist', o: 'ink', x: 'sand' } },\n  right: { rows: ['..#####..', '.#oo#xx#.', '#ooo#xxx#', '#ooo#xxx#', '#########', '#ooooooo#', '#ooooooo#', '#ooooooo#', '#ooooooo#', '.#ooooo#.', '..#####..'], colors: { '#': 'mist', o: 'ink', x: 'sand' } },\n  wheel: { rows: ['..#####..', '.#oo#oo#.', '#ooxxxoo#', '#ooxxxoo#', '#ooxxxoo#', '#########', '#ooooooo#', '#ooooooo#', '#ooooooo#', '.#ooooo#.', '..#####..'], colors: { '#': 'mist', o: 'ink', x: 'sand' } },\n};\n/** action → how each device shows it. */\nconst MAP = {\n  confirm: { pad: 'cross', key: 'ENTER', mouse: 'left' }, back: { pad: 'circle', key: 'ESC', mouse: 'right' }, alt: { pad: 'square', key: 'T' }, info: { pad: 'triangle', key: 'I' },\n  tabL: { pad: 'L1', xb: 'LB', key: 'Q' }, tabR: { pad: 'R1', xb: 'RB', key: 'E' }, tabs: { pad: 'L1/R1', xb: 'LB/RB', key: 'Q/E' }, pause: { pad: 'OPTIONS', xb: 'MENU', key: 'ESC' }, move: { pad: 'DPAD', key: 'ARROWS' }, lr: { pad: '</>', key: '</>' }, updown: { pad: 'UP/DN', key: 'UP/DN' },\n  more: { pad: 'triangle', key: 'M' }, slow: { pad: 'R2', xb: 'RT', key: 'SHIFT' }, hide: { pad: 'square', key: 'H' }, camera: { pad: 'triangle', key: 'C' }, recover: { pad: 'triangle', key: 'R' }, retire: { pad: 'circle', key: 'ESC' },\n  steer: { pad: 'L STICK', key: 'A D' }, go: { pad: 'R2', xb: 'RT', key: 'W' }, brake: { pad: 'L2', xb: 'LT', key: 'S' }, hand: { pad: 'square', key: 'SPACE' }, shift: { pad: 'L1 R1', xb: 'LB RB', key: 'Q E' },\n};\nconst ICONS = { cross: 1, circle: 1, square: 1, triangle: 1 };\n/** Draw one glyph; returns its width. */\nexport function drawGlyph(hud, x, y, action, device, xbox = false) {\n  const m = MAP[action] ?? { key: action, pad: action }, dev = device === 'pad' ? 'pad' : device === 'mouse' && m.mouse ? 'mouse' : 'key';\n  if (dev === 'mouse') { const g = MOUSE[m.mouse]; hud.sprite(x, y, g.rows, g.colors); return 9; }\n  let name = dev === 'pad' ? (xbox && m.xb ? m.xb : m.pad) : m.key;\n  if (dev === 'pad' && ICONS[name]) { const g = (xbox ? XB : PS)[name]; hud.sprite(x, y, g.rows, g.colors); return 11; }\n  const w = name.length * 6 + 5;\n  hud.rect(x, y, w, 11, 'mist'); hud.rect(x + 1, y + 1, w - 2, 9, 'ink'); hud.text(x + 3, y + 2, name, { color: 'white', shadow: false });\n  return w;\n}\nexport const glyphWidth = (action, device, xbox = false) => { const m = MAP[action] ?? { key: action, pad: action }, dev = device === 'pad' ? 'pad' : device === 'mouse' && m.mouse ? 'mouse' : 'key'; if (dev === 'mouse') return 9; const n = dev === 'pad' ? (xbox && m.xb ? m.xb : m.pad) : m.key; if (dev === 'pad' && ICONS[n]) return 11; return n.length * 6 + 5; };\nvoid pad;\nE\ncat > src/game/ui/ui.js <<'E'\n// The 10-foot UI: immediate-mode widgets drawn through the HUD font. There is always exactly one focused thing.\nimport { drawGlyph, glyphWidth } from './glyphs.js';\nconst CLEAN = { '×': 'X', '—': '-', '–': '-', '’': \"'\", '‘': \"'\", '“': '\"', '”': '\"', '…': '...', '≤': '<=', '♭': 'B', '✕': 'X', '○': 'O', '□': '#', '△': '^', 'é': 'E', '÷': '/' };\nexport const clean = (s) => String(s).toUpperCase().replace(/[^\\x20-\\x7e]/g, (c) => CLEAN[c] ?? '');\nexport const fmtTime = (t) => { if (t == null || !isFinite(t)) return '--:--.--'; const m = Math.floor(t / 60), s = t - m * 60; return `${m}:${s < 10 ? '0' : ''}${s.toFixed(2)}`; };\nexport const fmtCr = (n) => `${Math.round(n).toLocaleString('en-US')} CR`;\nexport function wrap(text, width = 60) { const out = []; for (const para of clean(text).split('\\n')) { let line = ''; for (const w of para.split(' ')) { if ((line + ' ' + w).trim().length > width) { out.push(line); line = w; } else line = (line + ' ' + w).trim(); } out.push(line); } return out; }\nexport class UI {\n  constructor(app) { this.app = app; this.stack = []; this.items = []; this.prevItems = []; this.focus = null; this.box = { x: 0, y: 0, w: 0, h: 0, init: false }; this.t = 0; this.queued = null; this.subtitle = null; this.toasts = []; this.tick = 0; this.modal = null; }\n  get hud() { return this.app.hud; }\n  get W() { return this.hud.width; } get H() { return this.hud.height; } get cx() { return Math.floor(this.hud.width / 2); }\n  get top() { return this.stack[this.stack.length - 1] ?? null; }\n  push(screen, keepFocus = false) { if (this.top) this.top._focus = this.focus; this.stack.push(screen); if (!keepFocus) this.focus = null; this.box.init = false; screen.enter?.(this.app); this.prevItems = []; this.items = []; this.app.onScreenChange?.(screen); }\n  pop() { const s = this.stack.pop(); s?.leave?.(this.app); this.focus = this.top?._focus ?? null; this.box.init = false; this.prevItems = []; this.items = []; if (this.top) { this.top.resume?.(this.app); this.app.onScreenChange?.(this.top); } }\n  replace(screen) { const s = this.stack.pop(); s?.leave?.(this.app); this.focus = null; this.stack.push(screen); this.box.init = false; screen.enter?.(this.app); this.prevItems = []; this.items = []; this.app.onScreenChange?.(screen); }\n  clearStack() { while (this.stack.length) this.stack.pop()?.leave?.(this.app); this.focus = null; this.box.init = false; }\n  /** One frame: input, then the screen's widgets. */\n  frame(dt) {\n    this.t += dt; const a = this.app.actions, s = this.top; this.dt = dt;\n    this.prevItems = this.items; this.items = []; this.confirmHit = null; this.leftRight = 0;\n    if (s?.modalInput !== false) this.navigate(a);\n    if (a.pressed('left')) this.leftRight = -1; if (a.pressed('right')) this.leftRight = 1; if (a.wheel && this.prevItems.some((i) => i.slider && i.id === this.focus)) this.leftRight = a.wheel > 0 ? -1 : 1;\n    this.backHit = a.pressed('back') || a.rightClick;\n    s?.draw?.(this, dt);\n    this.drawFocus(dt);\n    if (this.subtitle) this.drawSubtitle(dt);\n    this.drawToasts(dt);\n    if (this.queued) { const q = this.queued; this.queued = null; q(); }\n  }\n  rectHit(pt, it) { const px = ((pt.x + 1) / 2) * this.W, py = ((1 - pt.y) / 2) * this.H; return px >= it.x && px < it.x + it.w && py >= it.y && py < it.y + it.h; }\n  navigate(a) {\n    const items = this.prevItems.filter((i) => !i.dead);\n    if (!items.some((i) => i.id === this.focus)) this.focus = items[0]?.id ?? this.focus;\n    const pt = this.app.ctx.input.pointer;\n    if ((a.mouseMoved || a.click || a.touchDown) && pt) for (const it of items) if (this.rectHit(pt, it)) { if (this.focus !== it.id) { this.focus = it.id; this.playTick(); } if (a.click || a.touchDown) this.clickHit = it.id; }\n    const lr = this.prevItems.find((i) => i.id === this.focus)?.slider;\n    for (const [d, dx, dy] of [['up', 0, -1], ['down', 0, 1], ['left', -1, 0], ['right', 1, 0]]) {\n      if (!a.pressed(d) || (lr && dx !== 0)) continue;\n      const cur = items.find((i) => i.id === this.focus); if (!cur) break;\n      const cxx = cur.x + cur.w / 2, cyy = cur.y + cur.h / 2; let best = null, bd = 1e9;\n      for (const it of items) { if (it === cur) continue; const ix = it.x + it.w / 2, iy = it.y + it.h / 2, ddx = ix - cxx, ddy = iy - cyy, along = ddx * dx + ddy * dy, across = Math.abs(ddx * dy) + Math.abs(ddy * dx); if (along <= 2) continue; const score = along + across * 2.2; if (score < bd) { bd = score; best = it; } }\n      if (best) { this.focus = best.id; this.playTick(); }\n    }\n  }\n  playTick() { this.app.mix?.ui('tick'); }\n  // ---- widgets\n  text(x, y, s, o = {}) { this.hud.text(x, y, clean(s), o); }\n  center(y, s, o = {}) { const t = clean(s), sc = o.scale ?? 1; this.hud.text(Math.round(this.cx - (t.length * 6 * sc) / 2), y, t, o); }\n  right(xr, y, s, o = {}) { const t = clean(s), sc = o.scale ?? 1; this.hud.text(Math.round(xr - t.length * 6 * sc), y, t, o); }\n  rect(x, y, w, h, c) { this.hud.rect(x, y, w, h, c); }\n  panel(x, y, w, h, c = 'ink', edge = 'night') { this.hud.rect(x, y, w, h, c); this.hud.rect(x, y, w, 1, edge); this.hud.rect(x, y + h - 1, w, 1, edge); this.hud.rect(x, y, 1, h, edge); this.hud.rect(x + w - 1, y, 1, h, edge); }\n  title(s, sub) { this.hud.rect(0, 0, this.W, 22, 'ink'); this.hud.rect(0, 22, this.W, 1, 'slate'); this.text(10, 5, s, { scale: 2, color: 'sand' }); if (sub) this.right(this.W - 10, 8, sub, { color: 'mist' }); }\n  para(x, y, s, width = 60, o = {}) { const lines = wrap(s, width); lines.forEach((l, i) => this.hud.text(x, y + i * 10, l, o)); return y + lines.length * 10; }\n  bar(x, y, w, h, f, c = 'lime', bg = 'night') { this.hud.rect(x, y, w, h, bg); this.hud.rect(x, y, Math.max(0, Math.round(w * Math.min(1, f))), h, c); }\n  /** A focusable item. Returns true on the frame it is confirmed. */\n  item(id, x, y, w, h, o = {}) {\n    const it = { id, x, y, w, h, label: o.label, slider: o.slider, disabled: o.disabled }; this.items.push(it);\n    const a = this.app.actions, focused = this.focus === id;\n    if (this.focus == null) this.focus = id;\n    let hit = false;\n    if (this.clickHit === id) { hit = true; this.clickHit = null; }\n    else if (focused && a.pressed('confirm')) hit = true;\n    if (hit) { a.consume('confirm'); this.confirmHit = id; if (o.disabled) { this.app.mix?.ui('denied'); return false; } this.app.mix?.ui('confirm'); }\n    return hit;\n  }\n  button(id, x, y, w, h, label, o = {}) {\n    const f = this.focus === id, bg = o.disabled ? 'ink' : f ? 'night' : o.bg ?? 'ink';\n    this.hud.rect(x, y, w, h, bg); if (o.edge !== false) { this.hud.rect(x, y, w, 1, 'slate'); this.hud.rect(x, y + h - 1, w, 1, 'slate'); this.hud.rect(x, y, 1, h, 'slate'); this.hud.rect(x + w - 1, y, 1, h, 'slate'); }\n    const sc = o.scale ?? 1, t = clean(label), tw = t.length * 6 * sc;\n    this.hud.text(o.left ? x + 6 : Math.round(x + (w - tw) / 2), o.sub ? y + 4 : Math.round(y + (h - 7 * sc) / 2), t, { scale: sc, color: o.disabled ? 'slate' : o.color ?? (f ? 'sand' : 'white') });\n    if (o.sub) { const s = clean(o.sub); this.hud.text(o.left ? x + 6 : Math.round(x + (w - s.length * 6) / 2), y + 5 + 7 * sc + 2, s, { color: o.disabled ? 'slate' : o.subColor ?? 'mist' }); }\n    return this.item(id, x, y, w, h, { label, disabled: o.disabled });\n  }\n  slider(id, x, y, w, label, value, min, max, step, onChange, o = {}) {\n    const f = this.focus === id, h = o.h ?? 18;\n    this.hud.rect(x, y, w, h, f ? 'night' : 'ink');\n    this.text(x + 4, y + 2, label, { color: f ? 'sand' : 'white' });\n    const fmt = o.format ?? ((v) => v.toFixed(2)); this.right(x + w - 4, y + 2, fmt(value), { color: 'white' });\n    const bx = x + 4, bw = w - 8, by = y + 11; this.hud.rect(bx, by, bw, 4, 'navy'); const fr = (value - min) / (max - min); this.hud.rect(bx, by, Math.round(bw * fr), 4, f ? 'lime' : 'mist'); this.hud.rect(bx + Math.round((bw - 2) * fr), by - 1, 2, 6, 'white');\n    if (o.dflt != null) this.hud.rect(bx + Math.round((bw - 1) * ((o.dflt - min) / (max - min))), by + 4, 1, 2, 'sand');\n    this.item(id, x, y, w, h, { label, slider: true });\n    let v = value;\n    if (f && this.leftRight) { v = Math.max(min, Math.min(max, Math.round((value + this.leftRight * step) / step) * step)); }\n    const a = this.app.actions, input = this.app.ctx.input, pt = input.pointer;\n    if (input.isDown('MouseLeft') && this.rectHit(pt, { x, y, w, h })) { const px = ((pt.x + 1) / 2) * this.W; v = min + (max - min) * Math.max(0, Math.min(1, (px - bx) / bw)); v = Math.round(v / step) * step; this.focus = id; }\n    void a;\n    if (Math.abs(v - value) > 1e-9) { this.app.mix?.ui('tick'); onChange(Math.round(v * 1e6) / 1e6); }\n  }\n  tabs(y, names, cur, onChange, id = 'tab') {\n    const a = this.app.actions; let idx = cur;\n    if (a.pressed('tabL')) idx = (cur - 1 + names.length) % names.length; if (a.pressed('tabR')) idx = (cur + 1) % names.length;\n    const w = Math.min(90, Math.floor((this.W - 20) / names.length)); let x = 10;\n    names.forEach((n, i) => { const on = i === cur; this.hud.rect(x, y, w - 2, 13, on ? 'navy' : 'ink'); if (on) this.hud.rect(x, y + 12, w - 2, 1, 'sand'); const t = clean(n); this.hud.text(Math.round(x + (w - 2 - t.length * 6) / 2), y + 3, t, { color: on ? 'sand' : 'mist' }); const pt = this.app.ctx.input.pointer; if (this.app.actions.click && this.rectHit(pt, { x, y, w: w - 2, h: 13 })) idx = i; x += w; });\n    if (idx !== cur) { this.app.mix?.ui('tick'); onChange(idx); this.focus = null; this.clickHit = null; }\n    void id;\n  }\n  /** Bottom prompt row: what the buttons do right now. Clicking a prompt does what the button does. */\n  prompts(list) {\n    const a = this.app.actions, dev = a.device, xb = this.app.settings.glyphs === 'xbox'; const y = this.H - 15;\n    this.hud.rect(0, y - 2, this.W, 17, 'ink'); this.hud.rect(0, y - 3, this.W, 1, 'slate');\n    let w = 0; for (const [act, label] of list) w += glyphWidth(act, dev, xb) + 3 + clean(label).length * 6 + 10;\n    let x = this.W - 8 - w + 10; if (x < 4) x = 4;\n    const pt = this.app.ctx.input.pointer;\n    for (const [act, label, cb] of list) {\n      const x0 = x; x += drawGlyph(this.hud, x, y, act, dev, xb) + 3; const t = clean(label); this.hud.text(x, y + 2, t, { color: 'white' }); x += t.length * 6 + 10;\n      if ((a.click || a.touchDown) && this.rectHit(pt, { x: x0, y: y - 2, w: x - x0, h: 15 })) { if (act === 'back') this.backHit = true; else if (cb) cb(); else a.pressedSet[act] = true; }\n    }\n    this.promptList = list;\n  }\n  status(line) { this.text(6, this.H - 13, line, { color: 'mist' }); }\n  drawFocus(dt) {\n    const it = this.items.find((i) => i.id === this.focus); if (!it) return;\n    const b = this.box; if (!b.init) { Object.assign(b, { x: it.x, y: it.y, w: it.w, h: it.h, init: true }); }\n    const k = 1 - Math.exp(-dt * 22); b.x += (it.x - b.x) * k; b.y += (it.y - b.y) * k; b.w += (it.w - b.w) * k; b.h += (it.h - b.h) * k;\n    const pulse = Math.floor(this.t * 5) % 2 ? 'sand' : 'white', x = Math.round(b.x) - 2, y = Math.round(b.y) - 2, w = Math.round(b.w) + 4, h = Math.round(b.h) + 4;\n    this.hud.rect(x, y, w, 2, pulse); this.hud.rect(x, y + h - 2, w, 2, pulse); this.hud.rect(x, y, 2, h, pulse); this.hud.rect(x + w - 2, y, 2, h, pulse);\n  }\n  say(text, speaker, o = {}) { const lines = wrap(text, 58).slice(0, 4); this.subtitle = { lines, speaker: speaker?.name ?? '', t: o.time ?? Math.max(2.5, text.length * 0.07) }; this.app.mix?.say(text, speaker?.id ?? speaker); }\n  drawSubtitle(dt) {\n    const s = this.subtitle; s.t -= dt; if (s.t <= 0) { this.subtitle = null; return; }\n    const h = s.lines.length * 10 + (s.speaker ? 11 : 4) + 4, y = this.H - 19 - h - 2, w = 60 * 6 + 12, x = this.cx - w / 2;\n    this.hud.rect(x, y, w, h, 'ink'); this.hud.rect(x, y, 2, h, 'sand');\n    if (s.speaker) this.hud.text(x + 7, y + 3, clean(s.speaker), { color: 'sand' });\n    s.lines.forEach((l, i) => this.hud.text(x + 7, y + (s.speaker ? 13 : 4) + i * 10, l, { color: 'white' }));\n  }\n  toast(text, c = 'lime') { this.toasts.push({ text: clean(text), t: 2.4, c }); }\n  drawToasts(dt) { this.toasts = this.toasts.filter((x) => (x.t -= dt) > 0); this.toasts.slice(-3).forEach((x, i) => { const w = x.text.length * 6 + 10, X = this.cx - w / 2, Y = 28 + i * 14; this.hud.rect(X, Y, w, 12, 'ink'); this.hud.rect(X, Y, w, 1, x.c); this.hud.text(X + 5, Y + 3, x.text, { color: x.c }); }); }\n}\nE\ncat >> ../PROGRESS.md <<'E'\n- input/{pad,actions}, ui/{glyphs,ui} written. Next: audio/mix+enginesynth, app.js, scenes/race.js, main.js, tools/build.mjs; then menus.\nE","description":"Write input layer, glyphs and UI core"}}}
