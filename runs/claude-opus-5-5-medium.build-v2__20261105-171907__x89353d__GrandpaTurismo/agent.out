{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgkk6QFeBj8uTsZ3h6kqL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01L1QxJ9vAMEssVZPt8sXhnr","name":"Bash","input":{"command":"python3 - <<'E'\np='src/game/render/dressing.js';s=open(p).read()\na=s.index(\"  flag(x, y, z, c = P.red\")\nb=s.index(\"  finish() {\")\ns=s[:a]+\"\"\"  flag(x, y, z, c = P.red, w = 2.6, h = 1.6) {\n    const body = clothGrid({ width: w, height: h, cols: 9, rows: 6, origin: [x, y, z], pin: 'left', across: [1, 0, 0] }), mesh = new SoftMesh(body, toonMaterial(c)); mesh.castShadow = false; this.ctx.scene.add(mesh);\n    this.dyn.push((dt, t) => { body.wind[0] = 7 + Math.sin(t * 1.3 + x) * 3; body.wind[2] = Math.sin(t * 2.1 + z) * 3; body.step(Math.min(dt, 1 / 30)); mesh.sync(); });\n    return mesh;\n  }\n\"\"\"+s[b:]\na=s.index(\"function applyWind\");b=s.index(\"const pitSide\")\ns=s[:a]+s[b:]\ns=s.replace(\" const m = new Mesh(new BoxGeometry(0.7, 0.3, 0.5), toonMaterial(P.sand)); }\\n  // city\",\" }\\n  // city\")\nopen(p,'w').write(s)\nE\ncat > src/game/render/camera.js <<'E'\n// The chase camera, the bonnet view and the television director. Recipes from the kit's fixed rig: set position, look-at and FOV yourself.\nimport { THREE } from '../../pixel-engine.js';\nimport { groundHeight } from './trackmesh.js';\nconst { Vector3 } = THREE;\nexport const CAM_MODES = ['near', 'far', 'bonnet'];\nexport class ChaseCam {\n  constructor(cam, app) { this.cam = cam; this.app = app; this.mode = 0; this.pos = new Vector3(); this.look = new Vector3(); this.yaw = 0; this.init = false; this.orbit = 0; this.orbitP = 0; this.want = new Vector3(); this.tmp = new Vector3(); }\n  cycle() { this.mode = (this.mode + 1) % CAM_MODES.length; this.init = false; }\n  snap() { this.init = false; }\n  update(c, dt, o = {}) {\n    const tune = this.app.dev?.tune ?? {}, mode = CAM_MODES[this.mode], cam = this.cam, speed = Math.abs(c.u ?? 0);\n    let e = c.yaw - this.yaw; while (e > Math.PI) e -= 2 * Math.PI; while (e < -Math.PI) e += 2 * Math.PI;\n    if (!this.init) this.yaw = c.yaw; else this.yaw += e * (1 - Math.exp(-dt * 7));\n    // right stick or right drag orbits and springs back\n    if (o.orbitX || o.orbitY) { this.orbit += (o.orbitX ?? 0) * dt * 3; this.orbitP = Math.max(-0.4, Math.min(0.8, this.orbitP + (o.orbitY ?? 0) * dt * 1.5)); } else { this.orbit *= Math.exp(-dt * 3); this.orbitP *= Math.exp(-dt * 3); }\n    const yaw = (mode === 'bonnet' ? c.yaw : this.yaw) + this.orbit + (o.lookBack ? Math.PI : 0), sn = Math.sin(yaw), cs = Math.cos(yaw);\n    let fov = (tune.fov ?? 58) + 8 * Math.min(1, speed / 80);\n    if (mode === 'bonnet') {\n      const fsn = Math.sin(c.yaw), fcs = Math.cos(c.yaw), z = o.lookBack ? -1 : 1;\n      cam.position.set(c.x + fsn * 0.2 * z, c.y + 1.05, c.z + fcs * 0.2 * z); this.look.set(c.x + sn * 20, c.y + 1.0, c.z + cs * 20); this.pos.copy(cam.position); fov += 6;\n    } else {\n      const far = mode === 'far', back = far ? tune.chase ?? 8.5 : (tune.chase ?? 8.5) * 0.8, height = (far ? 3.1 : 2.4) + this.orbitP * back;\n      this.want.set(c.x - sn * back, c.y + height, c.z - cs * back);\n      if (!this.init) this.pos.copy(this.want); else this.pos.lerp(this.want, 1 - Math.exp(-dt * 8));\n      cam.position.copy(this.pos);\n      this.look.set(c.x + sn * 8, c.y + 1.1, c.z + cs * 8);\n    }\n    this.init = true;\n    cam.lookAt(this.look);\n    if (Math.abs(cam.fov - fov) > 0.05) { cam.fov = fov; cam.updateProjectionMatrix(); }\n  }\n}\n/** Trackside posts every ~280 m, tele lenses, and a few authored shots. Picks the next post ahead of the focus car. */\nexport class TVDirector {\n  constructor(T) {\n    this.T = T; const tr = T.tr; this.posts = [];\n    let side = 1;\n    for (let s = 40; s < tr.length; s += 280) { const i = Math.round(s / tr.ds) % tr.N, hw = tr.width[i] / 2, sd = T.id === 'harbour' ? -side : side, wall = (sd > 0 ? tr.wallR : tr.wallL)[i], d = T.id === 'harbour' ? wall + 3 : 15 + ((i * 7) % 11), t = hw + d, h = 3 + ((i * 13) % 6); this.posts.push({ s, x: tr.x[i] - tr.tz[i] * sd * t, z: tr.z[i] + tr.tx[i] * sd * t, y: Math.max(tr.y[i], groundHeight(T, T.id, i, sd, d)) + h, fov: 18 + ((i * 3) % 13) }); side = -side; }\n    this.cur = null; this.timer = 0; this.count = 0; this.focusChanged = false; this.shot = 'post'; this.heliA = 0; this.lookS = new Vector3(); this.init = false;\n  }\n  cut(c) {\n    const tr = this.T.tr, L = tr.length; this.timer = 4 + ((this.count * 37) % 5); this.count++;\n    this.shot = this.count % 7 === 3 ? 'heli' : this.count % 7 === 5 ? 'low' : 'post';\n    if (this.shot === 'post') { let best = this.posts[0], bd = Infinity; for (const p of this.posts) { const d = (p.s - c.s + L) % L; if (d > 12 && d < bd) { bd = d; best = p; } } this.cur = best; }\n    if (this.shot === 'low') { this.lowS = (c.s + 60 + Math.abs(c.u) * 2) % L; }\n    this.init = false;\n  }\n  update(cam, c, dt, force = false) {\n    this.timer -= dt;\n    if (this.timer <= 0 || !this.cur || force) { this.cut(c); }\n    const tr = this.T.tr; let fov = 24;\n    if (this.shot === 'post' && this.cur) {\n      const p = this.cur; cam.position.set(p.x, p.y, p.z); const d = Math.hypot(p.x - c.x, p.z - c.z); fov = Math.max(10, Math.min(46, p.fov * (160 / Math.max(50, d)))); if (d > 320) this.timer = 0;\n    } else if (this.shot === 'heli') {\n      this.heliA += dt * 0.2; cam.position.set(c.x + Math.sin(this.heliA) * 34, c.y + 30, c.z + Math.cos(this.heliA) * 34); fov = 40;\n    } else {\n      const i = Math.round(this.lowS / tr.ds) % tr.N, hw = tr.width[i] / 2; cam.position.set(tr.x[i] - tr.tz[i] * (hw + 1.6), tr.y[i] + 0.5, tr.z[i] + tr.tx[i] * (hw + 1.6)); fov = 34; const d = Math.hypot(cam.position.x - c.x, cam.position.z - c.z); if (d > 130) this.timer = 0;\n    }\n    cam.lookAt(c.x, c.y + 0.7, c.z);\n    if (Math.abs(cam.fov - fov) > 0.05) { cam.fov = fov; cam.updateProjectionMatrix(); }\n  }\n}\nE\nmkdir -p src/game/animation; cat > src/game/animation/clips.js <<'E'\n// New clips as ClipDef data, on the engine's hero rig. Faces +Z; arms: X -90 ahead, -180 overhead; Z spreads.\nconst stand = { LegR: [0, 0, 0], ShinR: [0, 0, 0], FootR: [0, 0, 0], LegL: [0, 0, 0], ShinL: [0, 0, 0], FootL: [0, 0, 0] };\nconst crouch = { LegR: [-70, 0, 0], ShinR: [110, 0, 0], FootR: [-40, 0, 0], LegL: [-40, 0, 0], ShinL: [100, 0, 0], FootL: [-60, 0, 0] };\nconst P = (y, r = [0, 0, 0]) => ({ r, p: [0, y, 0], s: 1 });\nconst k = (f, pose) => [f, pose];\nexport const GAME_CLIPS = [\n  { name: 'PitJack', frames: 40, loop: true, keys: [\n    k(0, { Pelvis: P(-0.28, [20, 0, 0]), Torso: [20, 0, 0], Head: [-20, 0, 0], ...crouch, ArmR: [-60, 0, -10], ForearmR: [-30, 0, 0], ArmL: [-60, 0, 10], ForearmL: [-30, 0, 0] }),\n    k(20, { Pelvis: P(-0.34, [30, 0, 0]), Torso: [35, 0, 0], Head: [-30, 0, 0], ...crouch, ArmR: [-25, 0, -10], ForearmR: [-10, 0, 0], ArmL: [-25, 0, 10], ForearmL: [-10, 0, 0] }),\n    k(40, { Pelvis: P(-0.28, [20, 0, 0]), Torso: [20, 0, 0], Head: [-20, 0, 0], ...crouch, ArmR: [-60, 0, -10], ForearmR: [-30, 0, 0], ArmL: [-60, 0, 10], ForearmL: [-30, 0, 0] }) ] },\n  { name: 'PitWheelGun', frames: 80, keys: [\n    k(0, { Pelvis: P(-0.02), Torso: [5, 0, 0], ...stand, ArmR: [-50, 0, -10], ForearmR: [-40, 0, 0], ArmL: [-20, 0, 10], ForearmL: [-40, 0, 0] }),\n    k(12, { Pelvis: P(-0.34, [10, 0, 0]), Torso: [25, 0, 0], Head: [-15, 0, 0], ...crouch, ArmR: [-80, 0, -5], ForearmR: [-15, 0, 0], ArmL: [-70, 0, 10], ForearmL: [-15, 0, 0] }),\n    k(30, { Pelvis: P(-0.36, [10, 0, 0]), Torso: [28, -6, 0], Head: [-15, 0, 0], ...crouch, ArmR: [-85, 0, -5], ForearmR: [-10, 0, 0], ArmL: [-70, 0, 10], ForearmL: [-20, 0, 0] }),\n    k(45, { Pelvis: P(-0.34, [10, 0, 0]), Torso: [15, 16, 0], Head: [-10, 10, 0], ...crouch, ArmR: [-40, 30, -20], ForearmR: [-40, 0, 0], ArmL: [-40, 30, 20], ForearmL: [-40, 0, 0] }),\n    k(60, { Pelvis: P(-0.36, [10, 0, 0]), Torso: [28, 6, 0], Head: [-15, 0, 0], ...crouch, ArmR: [-85, 0, -5], ForearmR: [-10, 0, 0], ArmL: [-70, 0, 10], ForearmL: [-20, 0, 0] }),\n    k(80, { Pelvis: P(-0.02), Torso: [5, 0, 0], ...stand, ArmR: [-50, 0, -10], ForearmR: [-40, 0, 0], ArmL: [-20, 0, 10], ForearmL: [-40, 0, 0] }) ] },\n  { name: 'PitFuel', frames: 60, loop: true, keys: [\n    k(0, { Pelvis: P(0), Torso: [8, 0, 0], Head: [-4, 0, 0], ...stand, ArmR: [-70, 0, -8], ForearmR: [-20, 0, 0], ArmL: [-60, 0, 12], ForearmL: [-40, 0, 0] }),\n    k(30, { Pelvis: P(-0.015), Torso: [11, 0, 0], Head: [-2, 6, 0], ...stand, ArmR: [-72, 0, -8], ForearmR: [-20, 0, 0], ArmL: [-62, 0, 12], ForearmL: [-40, 0, 0] }),\n    k(60, { Pelvis: P(0), Torso: [8, 0, 0], Head: [-4, 0, 0], ...stand, ArmR: [-70, 0, -8], ForearmR: [-20, 0, 0], ArmL: [-60, 0, 12], ForearmL: [-40, 0, 0] }) ] },\n  { name: 'MarshalFlag', frames: 28, loop: true, keys: [\n    k(0, { Pelvis: P(0), Torso: [0, 0, -4], Head: [-8, 0, 0], ...stand, ArmR: [-170, 0, -28], ForearmR: [-12, 0, 0], ArmL: [6, 0, 9], ForearmL: [-14, 0, 0] }),\n    k(14, { Pelvis: P(0), Torso: [0, 0, 4], Head: [-8, 0, 0], ...stand, ArmR: [-170, 0, 22], ForearmR: [-12, 0, 0], ArmL: [6, 0, 9], ForearmL: [-14, 0, 0] }),\n    k(28, { Pelvis: P(0), Torso: [0, 0, -4], Head: [-8, 0, 0], ...stand, ArmR: [-170, 0, -28], ForearmR: [-12, 0, 0], ArmL: [6, 0, 9], ForearmL: [-14, 0, 0] }) ] },\n  { name: 'ExaminerClipboard', frames: 120, loop: true, keys: [\n    k(0, { Pelvis: P(0), Torso: [4, 0, 0], Head: [18, 0, 0], ...stand, ArmL: [-60, 0, 14], ForearmL: [-60, 0, 0], ArmR: [-50, 0, -14], ForearmR: [-70, 0, 0], HandR: [0, 0, 0] }),\n    k(40, { Pelvis: P(0), Torso: [5, 0, 0], Head: [22, 4, 0], ...stand, ArmL: [-60, 0, 14], ForearmL: [-60, 0, 0], ArmR: [-54, 8, -12], ForearmR: [-74, 0, 0], HandR: [12, 0, 0] }),\n    k(70, { Pelvis: P(0), Torso: [2, 0, 0], Head: [-4, 0, 0], ...stand, ArmL: [-60, 0, 14], ForearmL: [-60, 0, 0], ArmR: [-50, 0, -14], ForearmR: [-70, 0, 0] }),\n    k(90, { Pelvis: P(0), Torso: [3, 0, 0], Head: [12, 0, 0], ...stand, ArmL: [-60, 0, 14], ForearmL: [-60, 0, 0], ArmR: [-50, 0, -14], ForearmR: [-70, 0, 0] }),\n    k(104, { Pelvis: P(0), Torso: [2, 0, 0], Head: [-2, 0, 0], ...stand, ArmL: [-60, 0, 14], ForearmL: [-60, 0, 0], ArmR: [-50, 0, -14], ForearmR: [-70, 0, 0] }),\n    k(120, { Pelvis: P(0), Torso: [4, 0, 0], Head: [18, 0, 0], ...stand, ArmL: [-60, 0, 14], ForearmL: [-60, 0, 0], ArmR: [-50, 0, -14], ForearmR: [-70, 0, 0] }) ] },\n  { name: 'DealerPresent', frames: 90, loop: true, keys: [\n    k(0, { Pelvis: P(0), Torso: [2, 0, 0], Head: [0, 0, 0], ...stand, ArmR: [6, 0, -9], ForearmR: [-22, 0, 0], ArmL: [6, 0, 9], ForearmL: [-22, 0, 0] }),\n    k(24, { Pelvis: P(0), Torso: [2, -14, 0], Head: [-4, -20, 0], ...stand, ArmR: [-70, -30, -30], ForearmR: [-14, 0, 0], HandR: [-10, 0, 0], ArmL: [6, 0, 9], ForearmL: [-22, 0, 0] }),\n    k(55, { Pelvis: P(0), Torso: [2, -6, 0], Head: [-4, -24, 0], ...stand, ArmR: [-82, -60, -34], ForearmR: [-8, 0, 0], HandR: [-10, 0, 0], ArmL: [6, 0, 9], ForearmL: [-22, 0, 0] }),\n    k(90, { Pelvis: P(0), Torso: [2, 0, 0], Head: [0, 0, 0], ...stand, ArmR: [6, 0, -9], ForearmR: [-22, 0, 0], ArmL: [6, 0, 9], ForearmL: [-22, 0, 0] }) ] },\n  { name: 'MechanicWipe', frames: 80, loop: true, keys: [\n    k(0, { Pelvis: P(0), Torso: [6, 0, 0], Head: [10, 0, 0], ...stand, ArmR: [-40, 10, -6], ForearmR: [-60, 0, 0], ArmL: [-40, -10, 6], ForearmL: [-60, 0, 0] }),\n    k(20, { Pelvis: P(0), Torso: [6, 0, 0], Head: [12, 4, 0], ...stand, ArmR: [-36, 20, -2], ForearmR: [-70, 0, 0], ArmL: [-44, -2, 8], ForearmL: [-54, 0, 0] }),\n    k(40, { Pelvis: P(0), Torso: [6, 0, 0], Head: [10, -4, 0], ...stand, ArmR: [-44, 2, -8], ForearmR: [-54, 0, 0], ArmL: [-36, -20, 2], ForearmL: [-70, 0, 0] }),\n    k(60, { Pelvis: P(0), Torso: [2, 0, 0], Head: [-6, -22, 0], ...stand, ArmR: [-36, 16, -2], ForearmR: [-66, 0, 0], ArmL: [-36, -16, 2], ForearmL: [-66, 0, 0] }),\n    k(80, { Pelvis: P(0), Torso: [6, 0, 0], Head: [10, 0, 0], ...stand, ArmR: [-40, 10, -6], ForearmR: [-60, 0, 0], ArmL: [-40, -10, 6], ForearmL: [-60, 0, 0] }) ] },\n  { name: 'PodiumCheer', frames: 30, loop: true, keys: [\n    k(0, { Pelvis: P(-0.06), Torso: [2, 0, 0], Head: [-14, 0, 0], ...stand, ArmR: [-175, 0, -18], ForearmR: [-8, 0, 0], ArmL: [-175, 0, 18], ForearmL: [-8, 0, 0] }),\n    k(15, { Pelvis: P(0.2), Torso: [-3, 0, 0], Head: [-18, 0, 0], LegR: [-12, 0, 0], ShinR: [24, 0, 0], FootR: [-10, 0, 0], LegL: [-12, 0, 0], ShinL: [24, 0, 0], FootL: [-10, 0, 0], ArmR: [-170, 0, -28], ForearmR: [-4, 0, 0], ArmL: [-170, 0, 28], ForearmL: [-4, 0, 0] }),\n    k(30, { Pelvis: P(-0.06), Torso: [2, 0, 0], Head: [-14, 0, 0], ...stand, ArmR: [-175, 0, -18], ForearmR: [-8, 0, 0], ArmL: [-175, 0, 18], ForearmL: [-8, 0, 0] }) ] },\n  { name: 'PodiumBow', frames: 70, keys: [\n    k(0, { Pelvis: P(0), Torso: [0, 0, 0], ...stand, ArmR: [4, 0, -6], ForearmR: [-8, 0, 0], ArmL: [4, 0, 6], ForearmL: [-8, 0, 0] }),\n    k(24, { Pelvis: P(-0.04, [18, 0, 0]), Torso: [32, 0, 0], Head: [12, 0, 0], ...stand, ArmR: [20, 0, -2], ForearmR: [-4, 0, 0], ArmL: [20, 0, 2], ForearmL: [-4, 0, 0] }),\n    k(44, { Pelvis: P(-0.04, [18, 0, 0]), Torso: [32, 0, 0], Head: [12, 0, 0], ...stand, ArmR: [20, 0, -2], ForearmR: [-4, 0, 0], ArmL: [20, 0, 2], ForearmL: [-4, 0, 0] }),\n    k(70, { Pelvis: P(0), Torso: [0, 0, 0], ...stand, ArmR: [4, 0, -6], ForearmR: [-8, 0, 0], ArmL: [4, 0, 6], ForearmL: [-8, 0, 0] }) ] },\n  { name: 'CrowdCheer', frames: 20, loop: true, keys: [\n    k(0, { Pelvis: P(-0.03), ...stand, ArmR: [-150, 0, -20], ForearmR: [-20, 0, 0], ArmL: [-150, 0, 20], ForearmL: [-20, 0, 0] }),\n    k(10, { Pelvis: P(0.06), ...stand, ArmR: [-172, 0, -24], ForearmR: [-6, 0, 0], ArmL: [-172, 0, 24], ForearmL: [-6, 0, 0] }),\n    k(20, { Pelvis: P(-0.03), ...stand, ArmR: [-150, 0, -20], ForearmR: [-20, 0, 0], ArmL: [-150, 0, 20], ForearmL: [-20, 0, 0] }) ] },\n];\nE\ncat > src/game/render/people.js <<'E'\n// People: the engine's hero model, recoloured by swapping mesh materials by name, with its clips and ours.\nimport { HERO_MODEL, HERO_RIG, HERO_CLIPS, compileClips, setLookLayer, THREE, toonMaterial, PALETTE } from '../../pixel-engine.js';\nimport { GAME_CLIPS } from '../animation/clips.js';\nconst { AnimationMixer, LoopRepeat, LoopOnce } = THREE;\nexport const OUTFITS = {\n  arai: { top: 'navy', legs: 'navy', hat: 'white', glove: 'white', shoe: 'ink' },\n  benno: { top: 'orange', legs: 'orange', hat: 'night', glove: 'ink', shoe: 'ink' },\n  fenn: { top: 'plum', legs: 'plum', hat: 'sand', glove: 'white', shoe: 'ink' },\n  dell: { top: 'sky', legs: 'navy', hat: 'sky', glove: 'white', shoe: 'ink' },\n  crew: { top: 'red', legs: 'red', hat: 'white', glove: 'ink', shoe: 'ink' },\n  driver: { top: 'white', legs: 'white', hat: 'red', glove: 'red', shoe: 'ink' },\n  marshal: { top: 'orange', legs: 'white', hat: 'orange', glove: 'white', shoe: 'ink' },\n  hiker: { top: 'lime', legs: 'slate', hat: 'sand', glove: 'sand', shoe: 'plum' },\n};\nconst SLOT = { Overalls: 'legs', Shirt: 'top', Hat: 'hat', Brim: 'hat', SleeveR: 'top', SleeveL: 'top', ForearmR_Mesh: 'top', ForearmL_Mesh: 'top', GloveR: 'glove', GloveL: 'glove', ThighR: 'legs', ThighL: 'legs', ShinR_Mesh: 'legs', ShinL_Mesh: 'legs', ShoeR: 'shoe', ShoeL: 'shoe' };\nlet compiled = null;\nexport const ALL_CLIPS = () => [...HERO_CLIPS.filter((c) => ['Idle', 'IdleLook', 'Walk', 'Run', 'Wave', 'Sit', 'SideFlip', 'Victory'].includes(c.name)), ...GAME_CLIPS];\nexport class Person {\n  static async create(ctx, outfit = 'crew', o = {}) { const m = await ctx.loadModel(HERO_MODEL, { castShadow: true }); return new Person(m.scene, outfit, o); }\n  constructor(root, outfit, o = {}) {\n    this.root = root; const f = OUTFITS[outfit] ?? OUTFITS.crew;\n    root.traverse((n) => { if (n.isMesh) { const s = SLOT[n.name]; if (s) n.material = toonMaterial(PALETTE[f[s]]); n.receiveShadow = false; n.castShadow = true; } });\n    setLookLayer(root, 'actors');\n    compiled ??= new WeakMap();\n    this.clips = compileClips(ALL_CLIPS(), HERO_RIG, root);\n    this.mixer = new AnimationMixer(root); this.actions = {}; for (const c of this.clips) this.actions[c.name] = this.mixer.clipAction(c);\n    this.current = null; if (o.scale) root.scale.setScalar(o.scale);\n    this.play(o.clip ?? 'Idle');\n  }\n  play(name, o = {}) {\n    const a = this.actions[name]; if (!a || this.currentName === name) return; const prev = this.current;\n    a.reset(); a.setLoop(o.once ? LoopOnce : LoopRepeat, Infinity); a.clampWhenFinished = !!o.once; a.timeScale = o.speed ?? 1; a.play();\n    if (prev) prev.crossFadeTo(a, o.fade ?? 0.2, false);\n    this.current = a; this.currentName = name;\n  }\n  update(dt) { this.mixer.update(dt); }\n}\nE\ncat > src/game/ui/racehud.js <<'E'\n// The race HUD. Top-left: position, lap. Top-right: time, best, gap. Bottom-right: speed, gear, revs. Bottom-left: map, tyres, fuel, assist flashes.\nimport { fmtTime, clean } from './ui.js';\nexport function miniMap(tr, size) {\n  let x0 = 1e9, x1 = -1e9, z0 = 1e9, z1 = -1e9; for (let i = 0; i < tr.N; i++) { x0 = Math.min(x0, tr.x[i]); x1 = Math.max(x1, tr.x[i]); z0 = Math.min(z0, tr.z[i]); z1 = Math.max(z1, tr.z[i]); }\n  const k = (size - 2) / Math.max(x1 - x0, z1 - z0), pts = [], w = (x1 - x0) * k, h = (z1 - z0) * k, last = {};\n  const map = (x, z) => [Math.round(size - 1 - (x - x0) * k - (size - w) / 2), Math.round(size - 1 - (z - z0) * k - (size - h) / 2)];\n  for (let i = 0; i < tr.N; i += 1) { const [px, py] = map(tr.x[i], tr.z[i]), key = `${px},${py}`; if (!last[key]) { last[key] = 1; pts.push(px, py); } }\n  return { pts, map, size };\n}\nexport function drawMap(hud, m, x, y, cars, focus) {\n  for (let i = 0; i < m.pts.length; i += 2) hud.rect(x + m.pts[i], y + m.pts[i + 1], 1, 1, 'mist');\n  for (const c of cars) { if (c === focus) continue; const [px, py] = m.map(c.x, c.z); hud.rect(x + px - 1, y + py - 1, 3, 3, 'ink'); hud.rect(x + px, y + py, 1, 1, c.hudColor ?? 'red'); }\n  if (focus) { const [px, py] = m.map(focus.x, focus.z); hud.rect(x + px - 2, y + py - 2, 5, 5, 'ink'); hud.rect(x + px - 1, y + py - 1, 3, 3, 'lime'); }\n}\nconst WEAR = (w) => (w > 0.6 ? 'lime' : w > 0.3 ? 'sand' : w > 0.1 ? 'orange' : 'red');\nexport function drawRaceHud(hud, s) {\n  const { sim, car: c, units, map, compact, tag } = s, W = hud.width, H = hud.height, mph = units === 'mph';\n  const box = (x, y, w, h) => hud.rect(x, y, w, h, 'ink');\n  const speed = Math.abs(c.u ?? 0) * 3.6 * (mph ? 0.6214 : 1), R = sim?.run;\n  // position and lap\n  if (!R) {\n    box(4, 4, compact ? 62 : 72, 28);\n    hud.text(7, 6, `P${c.position}/${sim.cars.length}`, { scale: 2, color: 'sand' });\n    hud.text(7, 22, c.lap === 0 ? `LAP -/${sim.laps}` : `LAP ${Math.min(c.lap, sim.laps)}/${sim.laps}`, { color: 'white' });\n    box(W - (compact ? 74 : 84), 4, compact ? 70 : 80, 34);\n    const t = c.finishT ?? (sim.green && sim.t > c.startT ? sim.t - c.startT : 0), lapT = c.lap > 0 && c.finishT == null ? sim.t - c.lapStart : 0;\n    hud.text(W - (compact ? 71 : 81), 6, fmtTime(lapT), { color: 'white' });\n    hud.text(W - (compact ? 71 : 81), 16, `B ${fmtTime(c.bestLap)}`, { color: 'mist' });\n    if (s.gap != null) hud.text(W - (compact ? 71 : 81), 26, s.gap, { color: s.gapColor ?? 'lime' }); else hud.text(W - (compact ? 71 : 81), 26, `T ${fmtTime(t)}`, { color: 'mist' });\n  } else {\n    box(4, 4, 100, 18); hud.text(7, 8, clean(R.test.id + ' ' + fmtTime(R.time + R.hits)), { color: 'sand' });\n    if (R.hits) hud.text(7, 26, `+${R.hits} S`, { color: 'orange' });\n    box(W - 88, 4, 84, 34); const m = R.test.medals; if (m) { hud.text(W - 85, 6, `G ${fmtTime(m.gold)}`, { color: 'sand' }); hud.text(W - 85, 16, `S ${fmtTime(m.silver)}`, { color: 'mist' }); hud.text(W - 85, 26, `B ${fmtTime(m.bronze)}`, { color: 'orange' }); }\n  }\n  // speed and gear, rev bar with shift light\n  const p = c.p, rpmF = Math.min(1, (c.rpm ?? 0) / p.redline), sw = compact ? 72 : 96, sx = W - sw - 4, sy = H - 40;\n  box(sx, sy, sw, 36);\n  const sp = String(Math.round(speed)).padStart(3, ' ');\n  hud.text(sx + 3, sy + 3, sp, { scale: compact ? 2 : 3, color: 'white' });\n  hud.text(sx + (compact ? 42 : 58), sy + 3, c.reversing ? 'R' : String(c.gear), { scale: compact ? 2 : 3, color: 'sand' });\n  hud.text(sx + 3, sy + 26, mph ? 'MPH' : 'KM/H', { color: 'mist' });\n  const segs = 12, seg = Math.floor((sw - 6 - 24) / segs), rs = Math.round(rpmF * segs), flash = rpmF > 0.94;\n  for (let i = 0; i < segs; i++) hud.rect(sx + 27 + i * seg, sy + 27, seg - 1, 5, i < rs ? (i >= segs - 2 ? 'red' : i >= segs - 4 ? 'orange' : 'lime') : 'night');\n  if (flash && Math.floor(sim.t * 14) % 2) hud.rect(sx + 3, sy - 4, sw - 6, 3, 'red');\n  // bottom-left: map, wear, fuel, assists\n  const mapSize = map?.size ?? 0, mx = 4, my = H - mapSize - 6;\n  if (map) { box(mx, my - 2, mapSize + 4, mapSize + 4); drawMap(hud, map, mx + 2, my, sim.cars.filter((x) => x.visibleOnMap !== false), c); }\n  const wx = mx + mapSize + 8, wy = H - 22;\n  if (s.showWear !== false) { box(wx, wy, 19, 18); [[0, 0], [1, 0], [0, 1], [1, 1]].forEach(([a, b], i) => hud.rect(wx + 2 + a * 8, wy + 2 + b * 8, 7, 6, WEAR(c.wear[i]))); }\n  if (sim.rules.endurance || s.showFuel) { box(wx + 21, wy, 42, 18); hud.text(wx + 23, wy + 2, 'FUEL', { color: c.fuel < 0.15 ? 'red' : 'mist' }); hud.rect(wx + 23, wy + 11, 38, 4, 'night'); hud.rect(wx + 23, wy + 11, Math.round(38 * c.fuel), 4, c.fuel < 0.15 ? 'red' : 'sky'); }\n  let ax = wx + (sim.rules.endurance ? 65 : 21);\n  for (const [lab, on] of [['ABS', s.flash?.abs], ['TCS', s.flash?.tcs], ['STB', s.flash?.stb]]) { if (on) { box(ax, wy, 22, 11); hud.text(ax + 2, wy + 2, lab, { color: 'orange' }); ax += 24; } }\n  if (c.slip) { box(ax, wy, 28, 11); hud.text(ax + 2, wy + 2, '>>>', { color: 'cyan' }); }\n  if (tag) { hud.text(W / 2 - 9, 4, tag, { color: 'orange' }); }\n}\nexport function drawLights(hud, n, cx, y, on) { if (!on) return; const w = 5 * 18; hud.rect(cx - w / 2 - 3, y - 3, w + 6, 22, 'ink'); for (let i = 0; i < 5; i++) { hud.rect(cx - w / 2 + i * 18 + 2, y, 14, 16, i < n ? 'red' : 'night'); } }\nexport function banner(hud, text, y = 44, c = 'sand', scale = 2) { const t = clean(text), w = t.length * 6 * scale; hud.rect(Math.round(hud.width / 2 - w / 2 - 6), y - 3, w + 12, 7 * scale + 6, 'ink'); hud.text(Math.round(hud.width / 2 - w / 2), y, t, { scale, color: c }); }\nE\ncat >> ../PROGRESS.md <<'E'\n- models/props.js, render/{dressing,camera,people}.js, animation/clips.js, ui/racehud.js written. Next: scenes/race.js, ui/screens/race.js, app.js, main.js, tools/build.mjs (then browser-test a race), then menus.\nE","description":"Write camera, clips, people and race HUD"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":22912,"cache_read_input_tokens":307895,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":22912},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c060cbf0-9de2-4b69-aed6-69ef0ff7f0ee","uuid":"23caec67-7194-40cc-92be-6ad3506b3bb5","timestamp":"2026-11-06T00:42:37.728Z","request_id":"req_011Cgkk6Py2Cn68jcP7igfb5","wire_tool_inputs":{"toolu_01L1QxJ9vAMEssVZPt8sXhnr":{"command":"python3 - <<'E'\np='src/game/render/dressing.js';s=open(p).read()\na=s.index(\"  flag(x, y, z, c = P.red\")\nb=s.index(\"  finish() {\")\ns=s[:a]+\"\"\"  flag(x, y, z, c = P.red, w = 2.6, h = 1.6) {\n    const body = clothGrid({ width: w, height: h, cols: 9, rows: 6, origin: [x, y, z], pin: 'left', across: [1, 0, 0] }), mesh = new SoftMesh(body, toonMaterial(c)); mesh.castShadow = false; this.ctx.scene.add(mesh);\n    this.dyn.push((dt, t) => { body.wind[0] = 7 + Math.sin(t * 1.3 + x) * 3; body.wind[2] = Math.sin(t * 2.1 + z) * 3; body.step(Math.min(dt, 1 / 30)); mesh.sync(); });\n    return mesh;\n  }\n\"\"\"+s[b:]\na=s.index(\"function applyWind\");b=s.index(\"const pitSide\")\ns=s[:a]+s[b:]\ns=s.replace(\" const m = new Mesh(new BoxGeometry(0.7, 0.3, 0.5), toonMaterial(P.sand)); }\\n  // city\",\" }\\n  // city\")\nopen(p,'w').write(s)\nE\ncat > src/game/render/camera.js <<'E'\n// The chase camera, the bonnet view and the television director. Recipes from the kit's fixed rig: set position, look-at and FOV yourself.\nimport { THREE } from '../../pixel-engine.js';\nimport { groundHeight } from './trackmesh.js';\nconst { Vector3 } = THREE;\nexport const CAM_MODES = ['near', 'far', 'bonnet'];\nexport class ChaseCam {\n  constructor(cam, app) { this.cam = cam; this.app = app; this.mode = 0; this.pos = new Vector3(); this.look = new Vector3(); this.yaw = 0; this.init = false; this.orbit = 0; this.orbitP = 0; this.want = new Vector3(); this.tmp = new Vector3(); }\n  cycle() { this.mode = (this.mode + 1) % CAM_MODES.length; this.init = false; }\n  snap() { this.init = false; }\n  update(c, dt, o = {}) {\n    const tune = this.app.dev?.tune ?? {}, mode = CAM_MODES[this.mode], cam = this.cam, speed = Math.abs(c.u ?? 0);\n    let e = c.yaw - this.yaw; while (e > Math.PI) e -= 2 * Math.PI; while (e < -Math.PI) e += 2 * Math.PI;\n    if (!this.init) this.yaw = c.yaw; else this.yaw += e * (1 - Math.exp(-dt * 7));\n    // right stick or right drag orbits and springs back\n    if (o.orbitX || o.orbitY) { this.orbit += (o.orbitX ?? 0) * dt * 3; this.orbitP = Math.max(-0.4, Math.min(0.8, this.orbitP + (o.orbitY ?? 0) * dt * 1.5)); } else { this.orbit *= Math.exp(-dt * 3); this.orbitP *= Math.exp(-dt * 3); }\n    const yaw = (mode === 'bonnet' ? c.yaw : this.yaw) + this.orbit + (o.lookBack ? Math.PI : 0), sn = Math.sin(yaw), cs = Math.cos(yaw);\n    let fov = (tune.fov ?? 58) + 8 * Math.min(1, speed / 80);\n    if (mode === 'bonnet') {\n      const fsn = Math.sin(c.yaw), fcs = Math.cos(c.yaw), z = o.lookBack ? -1 : 1;\n      cam.position.set(c.x + fsn * 0.2 * z, c.y + 1.05, c.z + fcs * 0.2 * z); this.look.set(c.x + sn * 20, c.y + 1.0, c.z + cs * 20); this.pos.copy(cam.position); fov += 6;\n    } else {\n      const far = mode === 'far', back = far ? tune.chase ?? 8.5 : (tune.chase ?? 8.5) * 0.8, height = (far ? 3.1 : 2.4) + this.orbitP * back;\n      this.want.set(c.x - sn * back, c.y + height, c.z - cs * back);\n      if (!this.init) this.pos.copy(this.want); else this.pos.lerp(this.want, 1 - Math.exp(-dt * 8));\n      cam.position.copy(this.pos);\n      this.look.set(c.x + sn * 8, c.y + 1.1, c.z + cs * 8);\n    }\n    this.init = true;\n    cam.lookAt(this.look);\n    if (Math.abs(cam.fov - fov) > 0.05) { cam.fov = fov; cam.updateProjectionMatrix(); }\n  }\n}\n/** Trackside posts every ~280 m, tele lenses, and a few authored shots. Picks the next post ahead of the focus car. */\nexport class TVDirector {\n  constructor(T) {\n    this.T = T; const tr = T.tr; this.posts = [];\n    let side = 1;\n    for (let s = 40; s < tr.length; s += 280) { const i = Math.round(s / tr.ds) % tr.N, hw = tr.width[i] / 2, sd = T.id === 'harbour' ? -side : side, wall = (sd > 0 ? tr.wallR : tr.wallL)[i], d = T.id === 'harbour' ? wall + 3 : 15 + ((i * 7) % 11), t = hw + d, h = 3 + ((i * 13) % 6); this.posts.push({ s, x: tr.x[i] - tr.tz[i] * sd * t, z: tr.z[i] + tr.tx[i] * sd * t, y: Math.max(tr.y[i], groundHeight(T, T.id, i, sd, d)) + h, fov: 18 + ((i * 3) % 13) }); side = -side; }\n    this.cur = null; this.timer = 0; this.count = 0; this.focusChanged = false; this.shot = 'post'; this.heliA = 0; this.lookS = new Vector3(); this.init = false;\n  }\n  cut(c) {\n    const tr = this.T.tr, L = tr.length; this.timer = 4 + ((this.count * 37) % 5); this.count++;\n    this.shot = this.count % 7 === 3 ? 'heli' : this.count % 7 === 5 ? 'low' : 'post';\n    if (this.shot === 'post') { let best = this.posts[0], bd = Infinity; for (const p of this.posts) { const d = (p.s - c.s + L) % L; if (d > 12 && d < bd) { bd = d; best = p; } } this.cur = best; }\n    if (this.shot === 'low') { this.lowS = (c.s + 60 + Math.abs(c.u) * 2) % L; }\n    this.init = false;\n  }\n  update(cam, c, dt, force = false) {\n    this.timer -= dt;\n    if (this.timer <= 0 || !this.cur || force) { this.cut(c); }\n    const tr = this.T.tr; let fov = 24;\n    if (this.shot === 'post' && this.cur) {\n      const p = this.cur; cam.position.set(p.x, p.y, p.z); const d = Math.hypot(p.x - c.x, p.z - c.z); fov = Math.max(10, Math.min(46, p.fov * (160 / Math.max(50, d)))); if (d > 320) this.timer = 0;\n    } else if (this.shot === 'heli') {\n      this.heliA += dt * 0.2; cam.position.set(c.x + Math.sin(this.heliA) * 34, c.y + 30, c.z + Math.cos(this.heliA) * 34); fov = 40;\n    } else {\n      const i = Math.round(this.lowS / tr.ds) % tr.N, hw = tr.width[i] / 2; cam.position.set(tr.x[i] - tr.tz[i] * (hw + 1.6), tr.y[i] + 0.5, tr.z[i] + tr.tx[i] * (hw + 1.6)); fov = 34; const d = Math.hypot(cam.position.x - c.x, cam.position.z - c.z); if (d > 130) this.timer = 0;\n    }\n    cam.lookAt(c.x, c.y + 0.7, c.z);\n    if (Math.abs(cam.fov - fov) > 0.05) { cam.fov = fov; cam.updateProjectionMatrix(); }\n  }\n}\nE\nmkdir -p src/game/animation; cat > src/game/animation/clips.js <<'E'\n// New clips as ClipDef data, on the engine's hero rig. Faces +Z; arms: X -90 ahead, -180 overhead; Z spreads.\nconst stand = { LegR: [0, 0, 0], ShinR: [0, 0, 0], FootR: [0, 0, 0], LegL: [0, 0, 0], ShinL: [0, 0, 0], FootL: [0, 0, 0] };\nconst crouch = { LegR: [-70, 0, 0], ShinR: [110, 0, 0], FootR: [-40, 0, 0], LegL: [-40, 0, 0], ShinL: [100, 0, 0], FootL: [-60, 0, 0] };\nconst P = (y, r = [0, 0, 0]) => ({ r, p: [0, y, 0], s: 1 });\nconst k = (f, pose) => [f, pose];\nexport const GAME_CLIPS = [\n  { name: 'PitJack', frames: 40, loop: true, keys: [\n    k(0, { Pelvis: P(-0.28, [20, 0, 0]), Torso: [20, 0, 0], Head: [-20, 0, 0], ...crouch, ArmR: [-60, 0, -10], ForearmR: [-30, 0, 0], ArmL: [-60, 0, 10], ForearmL: [-30, 0, 0] }),\n    k(20, { Pelvis: P(-0.34, [30, 0, 0]), Torso: [35, 0, 0], Head: [-30, 0, 0], ...crouch, ArmR: [-25, 0, -10], ForearmR: [-10, 0, 0], ArmL: [-25, 0, 10], ForearmL: [-10, 0, 0] }),\n    k(40, { Pelvis: P(-0.28, [20, 0, 0]), Torso: [20, 0, 0], Head: [-20, 0, 0], ...crouch, ArmR: [-60, 0, -10], ForearmR: [-30, 0, 0], ArmL: [-60, 0, 10], ForearmL: [-30, 0, 0] }) ] },\n  { name: 'PitWheelGun', frames: 80, keys: [\n    k(0, { Pelvis: P(-0.02), Torso: [5, 0, 0], ...stand, ArmR: [-50, 0, -10], ForearmR: [-40, 0, 0], ArmL: [-20, 0, 10], ForearmL: [-40, 0, 0] }),\n    k(12, { Pelvis: P(-0.34, [10, 0, 0]), Torso: [25, 0, 0], Head: [-15, 0, 0], ...crouch, ArmR: [-80, 0, -5], ForearmR: [-15, 0, 0], ArmL: [-70, 0, 10], ForearmL: [-15, 0, 0] }),\n    k(30, { Pelvis: P(-0.36, [10, 0, 0]), Torso: [28, -6, 0], Head: [-15, 0, 0], ...crouch, ArmR: [-85, 0, -5], ForearmR: [-10, 0, 0], ArmL: [-70, 0, 10], ForearmL: [-20, 0, 0] }),\n    k(45, { Pelvis: P(-0.34, [10, 0, 0]), Torso: [15, 16, 0], Head: [-10, 10, 0], ...crouch, ArmR: [-40, 30, -20], ForearmR: [-40, 0, 0], ArmL: [-40, 30, 20], ForearmL: [-40, 0, 0] }),\n    k(60, { Pelvis: P(-0.36, [10, 0, 0]), Torso: [28, 6, 0], Head: [-15, 0, 0], ...crouch, ArmR: [-85, 0, -5], ForearmR: [-10, 0, 0], ArmL: [-70, 0, 10], ForearmL: [-20, 0, 0] }),\n    k(80, { Pelvis: P(-0.02), Torso: [5, 0, 0], ...stand, ArmR: [-50, 0, -10], ForearmR: [-40, 0, 0], ArmL: [-20, 0, 10], ForearmL: [-40, 0, 0] }) ] },\n  { name: 'PitFuel', frames: 60, loop: true, keys: [\n    k(0, { Pelvis: P(0), Torso: [8, 0, 0], Head: [-4, 0, 0], ...stand, ArmR: [-70, 0, -8], ForearmR: [-20, 0, 0], ArmL: [-60, 0, 12], ForearmL: [-40, 0, 0] }),\n    k(30, { Pelvis: P(-0.015), Torso: [11, 0, 0], Head: [-2, 6, 0], ...stand, ArmR: [-72, 0, -8], ForearmR: [-20, 0, 0], ArmL: [-62, 0, 12], ForearmL: [-40, 0, 0] }),\n    k(60, { Pelvis: P(0), Torso: [8, 0, 0], Head: [-4, 0, 0], ...stand, ArmR: [-70, 0, -8], ForearmR: [-20, 0, 0], ArmL: [-60, 0, 12], ForearmL: [-40, 0, 0] }) ] },\n  { name: 'MarshalFlag', frames: 28, loop: true, keys: [\n    k(0, { Pelvis: P(0), Torso: [0, 0, -4], Head: [-8, 0, 0], ...stand, ArmR: [-170, 0, -28], ForearmR: [-12, 0, 0], ArmL: [6, 0, 9], ForearmL: [-14, 0, 0] }),\n    k(14, { Pelvis: P(0), Torso: [0, 0, 4], Head: [-8, 0, 0], ...stand, ArmR: [-170, 0, 22], ForearmR: [-12, 0, 0], ArmL: [6, 0, 9], ForearmL: [-14, 0, 0] }),\n    k(28, { Pelvis: P(0), Torso: [0, 0, -4], Head: [-8, 0, 0], ...stand, ArmR: [-170, 0, -28], ForearmR: [-12, 0, 0], ArmL: [6, 0, 9], ForearmL: [-14, 0, 0] }) ] },\n  { name: 'ExaminerClipboard', frames: 120, loop: true, keys: [\n    k(0, { Pelvis: P(0), Torso: [4, 0, 0], Head: [18, 0, 0], ...stand, ArmL: [-60, 0, 14], ForearmL: [-60, 0, 0], ArmR: [-50, 0, -14], ForearmR: [-70, 0, 0], HandR: [0, 0, 0] }),\n    k(40, { Pelvis: P(0), Torso: [5, 0, 0], Head: [22, 4, 0], ...stand, ArmL: [-60, 0, 14], ForearmL: [-60, 0, 0], ArmR: [-54, 8, -12], ForearmR: [-74, 0, 0], HandR: [12, 0, 0] }),\n    k(70, { Pelvis: P(0), Torso: [2, 0, 0], Head: [-4, 0, 0], ...stand, ArmL: [-60, 0, 14], ForearmL: [-60, 0, 0], ArmR: [-50, 0, -14], ForearmR: [-70, 0, 0] }),\n    k(90, { Pelvis: P(0), Torso: [3, 0, 0], Head: [12, 0, 0], ...stand, ArmL: [-60, 0, 14], ForearmL: [-60, 0, 0], ArmR: [-50, 0, -14], ForearmR: [-70, 0, 0] }),\n    k(104, { Pelvis: P(0), Torso: [2, 0, 0], Head: [-2, 0, 0], ...stand, ArmL: [-60, 0, 14], ForearmL: [-60, 0, 0], ArmR: [-50, 0, -14], ForearmR: [-70, 0, 0] }),\n    k(120, { Pelvis: P(0), Torso: [4, 0, 0], Head: [18, 0, 0], ...stand, ArmL: [-60, 0, 14], ForearmL: [-60, 0, 0], ArmR: [-50, 0, -14], ForearmR: [-70, 0, 0] }) ] },\n  { name: 'DealerPresent', frames: 90, loop: true, keys: [\n    k(0, { Pelvis: P(0), Torso: [2, 0, 0], Head: [0, 0, 0], ...stand, ArmR: [6, 0, -9], ForearmR: [-22, 0, 0], ArmL: [6, 0, 9], ForearmL: [-22, 0, 0] }),\n    k(24, { Pelvis: P(0), Torso: [2, -14, 0], Head: [-4, -20, 0], ...stand, ArmR: [-70, -30, -30], ForearmR: [-14, 0, 0], HandR: [-10, 0, 0], ArmL: [6, 0, 9], ForearmL: [-22, 0, 0] }),\n    k(55, { Pelvis: P(0), Torso: [2, -6, 0], Head: [-4, -24, 0], ...stand, ArmR: [-82, -60, -34], ForearmR: [-8, 0, 0], HandR: [-10, 0, 0], ArmL: [6, 0, 9], ForearmL: [-22, 0, 0] }),\n    k(90, { Pelvis: P(0), Torso: [2, 0, 0], Head: [0, 0, 0], ...stand, ArmR: [6, 0, -9], ForearmR: [-22, 0, 0], ArmL: [6, 0, 9], ForearmL: [-22, 0, 0] }) ] },\n  { name: 'MechanicWipe', frames: 80, loop: true, keys: [\n    k(0, { Pelvis: P(0), Torso: [6, 0, 0], Head: [10, 0, 0], ...stand, ArmR: [-40, 10, -6], ForearmR: [-60, 0, 0], ArmL: [-40, -10, 6], ForearmL: [-60, 0, 0] }),\n    k(20, { Pelvis: P(0), Torso: [6, 0, 0], Head: [12, 4, 0], ...stand, ArmR: [-36, 20, -2], ForearmR: [-70, 0, 0], ArmL: [-44, -2, 8], ForearmL: [-54, 0, 0] }),\n    k(40, { Pelvis: P(0), Torso: [6, 0, 0], Head: [10, -4, 0], ...stand, ArmR: [-44, 2, -8], ForearmR: [-54, 0, 0], ArmL: [-36, -20, 2], ForearmL: [-70, 0, 0] }),\n    k(60, { Pelvis: P(0), Torso: [2, 0, 0], Head: [-6, -22, 0], ...stand, ArmR: [-36, 16, -2], ForearmR: [-66, 0, 0], ArmL: [-36, -16, 2], ForearmL: [-66, 0, 0] }),\n    k(80, { Pelvis: P(0), Torso: [6, 0, 0], Head: [10, 0, 0], ...stand, ArmR: [-40, 10, -6], ForearmR: [-60, 0, 0], ArmL: [-40, -10, 6], ForearmL: [-60, 0, 0] }) ] },\n  { name: 'PodiumCheer', frames: 30, loop: true, keys: [\n    k(0, { Pelvis: P(-0.06), Torso: [2, 0, 0], Head: [-14, 0, 0], ...stand, ArmR: [-175, 0, -18], ForearmR: [-8, 0, 0], ArmL: [-175, 0, 18], ForearmL: [-8, 0, 0] }),\n    k(15, { Pelvis: P(0.2), Torso: [-3, 0, 0], Head: [-18, 0, 0], LegR: [-12, 0, 0], ShinR: [24, 0, 0], FootR: [-10, 0, 0], LegL: [-12, 0, 0], ShinL: [24, 0, 0], FootL: [-10, 0, 0], ArmR: [-170, 0, -28], ForearmR: [-4, 0, 0], ArmL: [-170, 0, 28], ForearmL: [-4, 0, 0] }),\n    k(30, { Pelvis: P(-0.06), Torso: [2, 0, 0], Head: [-14, 0, 0], ...stand, ArmR: [-175, 0, -18], ForearmR: [-8, 0, 0], ArmL: [-175, 0, 18], ForearmL: [-8, 0, 0] }) ] },\n  { name: 'PodiumBow', frames: 70, keys: [\n    k(0, { Pelvis: P(0), Torso: [0, 0, 0], ...stand, ArmR: [4, 0, -6], ForearmR: [-8, 0, 0], ArmL: [4, 0, 6], ForearmL: [-8, 0, 0] }),\n    k(24, { Pelvis: P(-0.04, [18, 0, 0]), Torso: [32, 0, 0], Head: [12, 0, 0], ...stand, ArmR: [20, 0, -2], ForearmR: [-4, 0, 0], ArmL: [20, 0, 2], ForearmL: [-4, 0, 0] }),\n    k(44, { Pelvis: P(-0.04, [18, 0, 0]), Torso: [32, 0, 0], Head: [12, 0, 0], ...stand, ArmR: [20, 0, -2], ForearmR: [-4, 0, 0], ArmL: [20, 0, 2], ForearmL: [-4, 0, 0] }),\n    k(70, { Pelvis: P(0), Torso: [0, 0, 0], ...stand, ArmR: [4, 0, -6], ForearmR: [-8, 0, 0], ArmL: [4, 0, 6], ForearmL: [-8, 0, 0] }) ] },\n  { name: 'CrowdCheer', frames: 20, loop: true, keys: [\n    k(0, { Pelvis: P(-0.03), ...stand, ArmR: [-150, 0, -20], ForearmR: [-20, 0, 0], ArmL: [-150, 0, 20], ForearmL: [-20, 0, 0] }),\n    k(10, { Pelvis: P(0.06), ...stand, ArmR: [-172, 0, -24], ForearmR: [-6, 0, 0], ArmL: [-172, 0, 24], ForearmL: [-6, 0, 0] }),\n    k(20, { Pelvis: P(-0.03), ...stand, ArmR: [-150, 0, -20], ForearmR: [-20, 0, 0], ArmL: [-150, 0, 20], ForearmL: [-20, 0, 0] }) ] },\n];\nE\ncat > src/game/render/people.js <<'E'\n// People: the engine's hero model, recoloured by swapping mesh materials by name, with its clips and ours.\nimport { HERO_MODEL, HERO_RIG, HERO_CLIPS, compileClips, setLookLayer, THREE, toonMaterial, PALETTE } from '../../pixel-engine.js';\nimport { GAME_CLIPS } from '../animation/clips.js';\nconst { AnimationMixer, LoopRepeat, LoopOnce } = THREE;\nexport const OUTFITS = {\n  arai: { top: 'navy', legs: 'navy', hat: 'white', glove: 'white', shoe: 'ink' },\n  benno: { top: 'orange', legs: 'orange', hat: 'night', glove: 'ink', shoe: 'ink' },\n  fenn: { top: 'plum', legs: 'plum', hat: 'sand', glove: 'white', shoe: 'ink' },\n  dell: { top: 'sky', legs: 'navy', hat: 'sky', glove: 'white', shoe: 'ink' },\n  crew: { top: 'red', legs: 'red', hat: 'white', glove: 'ink', shoe: 'ink' },\n  driver: { top: 'white', legs: 'white', hat: 'red', glove: 'red', shoe: 'ink' },\n  marshal: { top: 'orange', legs: 'white', hat: 'orange', glove: 'white', shoe: 'ink' },\n  hiker: { top: 'lime', legs: 'slate', hat: 'sand', glove: 'sand', shoe: 'plum' },\n};\nconst SLOT = { Overalls: 'legs', Shirt: 'top', Hat: 'hat', Brim: 'hat', SleeveR: 'top', SleeveL: 'top', ForearmR_Mesh: 'top', ForearmL_Mesh: 'top', GloveR: 'glove', GloveL: 'glove', ThighR: 'legs', ThighL: 'legs', ShinR_Mesh: 'legs', ShinL_Mesh: 'legs', ShoeR: 'shoe', ShoeL: 'shoe' };\nlet compiled = null;\nexport const ALL_CLIPS = () => [...HERO_CLIPS.filter((c) => ['Idle', 'IdleLook', 'Walk', 'Run', 'Wave', 'Sit', 'SideFlip', 'Victory'].includes(c.name)), ...GAME_CLIPS];\nexport class Person {\n  static async create(ctx, outfit = 'crew', o = {}) { const m = await ctx.loadModel(HERO_MODEL, { castShadow: true }); return new Person(m.scene, outfit, o); }\n  constructor(root, outfit, o = {}) {\n    this.root = root; const f = OUTFITS[outfit] ?? OUTFITS.crew;\n    root.traverse((n) => { if (n.isMesh) { const s = SLOT[n.name]; if (s) n.material = toonMaterial(PALETTE[f[s]]); n.receiveShadow = false; n.castShadow = true; } });\n    setLookLayer(root, 'actors');\n    compiled ??= new WeakMap();\n    this.clips = compileClips(ALL_CLIPS(), HERO_RIG, root);\n    this.mixer = new AnimationMixer(root); this.actions = {}; for (const c of this.clips) this.actions[c.name] = this.mixer.clipAction(c);\n    this.current = null; if (o.scale) root.scale.setScalar(o.scale);\n    this.play(o.clip ?? 'Idle');\n  }\n  play(name, o = {}) {\n    const a = this.actions[name]; if (!a || this.currentName === name) return; const prev = this.current;\n    a.reset(); a.setLoop(o.once ? LoopOnce : LoopRepeat, Infinity); a.clampWhenFinished = !!o.once; a.timeScale = o.speed ?? 1; a.play();\n    if (prev) prev.crossFadeTo(a, o.fade ?? 0.2, false);\n    this.current = a; this.currentName = name;\n  }\n  update(dt) { this.mixer.update(dt); }\n}\nE\ncat > src/game/ui/racehud.js <<'E'\n// The race HUD. Top-left: position, lap. Top-right: time, best, gap. Bottom-right: speed, gear, revs. Bottom-left: map, tyres, fuel, assist flashes.\nimport { fmtTime, clean } from './ui.js';\nexport function miniMap(tr, size) {\n  let x0 = 1e9, x1 = -1e9, z0 = 1e9, z1 = -1e9; for (let i = 0; i < tr.N; i++) { x0 = Math.min(x0, tr.x[i]); x1 = Math.max(x1, tr.x[i]); z0 = Math.min(z0, tr.z[i]); z1 = Math.max(z1, tr.z[i]); }\n  const k = (size - 2) / Math.max(x1 - x0, z1 - z0), pts = [], w = (x1 - x0) * k, h = (z1 - z0) * k, last = {};\n  const map = (x, z) => [Math.round(size - 1 - (x - x0) * k - (size - w) / 2), Math.round(size - 1 - (z - z0) * k - (size - h) / 2)];\n  for (let i = 0; i < tr.N; i += 1) { const [px, py] = map(tr.x[i], tr.z[i]), key = `${px},${py}`; if (!last[key]) { last[key] = 1; pts.push(px, py); } }\n  return { pts, map, size };\n}\nexport function drawMap(hud, m, x, y, cars, focus) {\n  for (let i = 0; i < m.pts.length; i += 2) hud.rect(x + m.pts[i], y + m.pts[i + 1], 1, 1, 'mist');\n  for (const c of cars) { if (c === focus) continue; const [px, py] = m.map(c.x, c.z); hud.rect(x + px - 1, y + py - 1, 3, 3, 'ink'); hud.rect(x + px, y + py, 1, 1, c.hudColor ?? 'red'); }\n  if (focus) { const [px, py] = m.map(focus.x, focus.z); hud.rect(x + px - 2, y + py - 2, 5, 5, 'ink'); hud.rect(x + px - 1, y + py - 1, 3, 3, 'lime'); }\n}\nconst WEAR = (w) => (w > 0.6 ? 'lime' : w > 0.3 ? 'sand' : w > 0.1 ? 'orange' : 'red');\nexport function drawRaceHud(hud, s) {\n  const { sim, car: c, units, map, compact, tag } = s, W = hud.width, H = hud.height, mph = units === 'mph';\n  const box = (x, y, w, h) => hud.rect(x, y, w, h, 'ink');\n  const speed = Math.abs(c.u ?? 0) * 3.6 * (mph ? 0.6214 : 1), R = sim?.run;\n  // position and lap\n  if (!R) {\n    box(4, 4, compact ? 62 : 72, 28);\n    hud.text(7, 6, `P${c.position}/${sim.cars.length}`, { scale: 2, color: 'sand' });\n    hud.text(7, 22, c.lap === 0 ? `LAP -/${sim.laps}` : `LAP ${Math.min(c.lap, sim.laps)}/${sim.laps}`, { color: 'white' });\n    box(W - (compact ? 74 : 84), 4, compact ? 70 : 80, 34);\n    const t = c.finishT ?? (sim.green && sim.t > c.startT ? sim.t - c.startT : 0), lapT = c.lap > 0 && c.finishT == null ? sim.t - c.lapStart : 0;\n    hud.text(W - (compact ? 71 : 81), 6, fmtTime(lapT), { color: 'white' });\n    hud.text(W - (compact ? 71 : 81), 16, `B ${fmtTime(c.bestLap)}`, { color: 'mist' });\n    if (s.gap != null) hud.text(W - (compact ? 71 : 81), 26, s.gap, { color: s.gapColor ?? 'lime' }); else hud.text(W - (compact ? 71 : 81), 26, `T ${fmtTime(t)}`, { color: 'mist' });\n  } else {\n    box(4, 4, 100, 18); hud.text(7, 8, clean(R.test.id + ' ' + fmtTime(R.time + R.hits)), { color: 'sand' });\n    if (R.hits) hud.text(7, 26, `+${R.hits} S`, { color: 'orange' });\n    box(W - 88, 4, 84, 34); const m = R.test.medals; if (m) { hud.text(W - 85, 6, `G ${fmtTime(m.gold)}`, { color: 'sand' }); hud.text(W - 85, 16, `S ${fmtTime(m.silver)}`, { color: 'mist' }); hud.text(W - 85, 26, `B ${fmtTime(m.bronze)}`, { color: 'orange' }); }\n  }\n  // speed and gear, rev bar with shift light\n  const p = c.p, rpmF = Math.min(1, (c.rpm ?? 0) / p.redline), sw = compact ? 72 : 96, sx = W - sw - 4, sy = H - 40;\n  box(sx, sy, sw, 36);\n  const sp = String(Math.round(speed)).padStart(3, ' ');\n  hud.text(sx + 3, sy + 3, sp, { scale: compact ? 2 : 3, color: 'white' });\n  hud.text(sx + (compact ? 42 : 58), sy + 3, c.reversing ? 'R' : String(c.gear), { scale: compact ? 2 : 3, color: 'sand' });\n  hud.text(sx + 3, sy + 26, mph ? 'MPH' : 'KM/H', { color: 'mist' });\n  const segs = 12, seg = Math.floor((sw - 6 - 24) / segs), rs = Math.round(rpmF * segs), flash = rpmF > 0.94;\n  for (let i = 0; i < segs; i++) hud.rect(sx + 27 + i * seg, sy + 27, seg - 1, 5, i < rs ? (i >= segs - 2 ? 'red' : i >= segs - 4 ? 'orange' : 'lime') : 'night');\n  if (flash && Math.floor(sim.t * 14) % 2) hud.rect(sx + 3, sy - 4, sw - 6, 3, 'red');\n  // bottom-left: map, wear, fuel, assists\n  const mapSize = map?.size ?? 0, mx = 4, my = H - mapSize - 6;\n  if (map) { box(mx, my - 2, mapSize + 4, mapSize + 4); drawMap(hud, map, mx + 2, my, sim.cars.filter((x) => x.visibleOnMap !== false), c); }\n  const wx = mx + mapSize + 8, wy = H - 22;\n  if (s.showWear !== false) { box(wx, wy, 19, 18); [[0, 0], [1, 0], [0, 1], [1, 1]].forEach(([a, b], i) => hud.rect(wx + 2 + a * 8, wy + 2 + b * 8, 7, 6, WEAR(c.wear[i]))); }\n  if (sim.rules.endurance || s.showFuel) { box(wx + 21, wy, 42, 18); hud.text(wx + 23, wy + 2, 'FUEL', { color: c.fuel < 0.15 ? 'red' : 'mist' }); hud.rect(wx + 23, wy + 11, 38, 4, 'night'); hud.rect(wx + 23, wy + 11, Math.round(38 * c.fuel), 4, c.fuel < 0.15 ? 'red' : 'sky'); }\n  let ax = wx + (sim.rules.endurance ? 65 : 21);\n  for (const [lab, on] of [['ABS', s.flash?.abs], ['TCS', s.flash?.tcs], ['STB', s.flash?.stb]]) { if (on) { box(ax, wy, 22, 11); hud.text(ax + 2, wy + 2, lab, { color: 'orange' }); ax += 24; } }\n  if (c.slip) { box(ax, wy, 28, 11); hud.text(ax + 2, wy + 2, '>>>', { color: 'cyan' }); }\n  if (tag) { hud.text(W / 2 - 9, 4, tag, { color: 'orange' }); }\n}\nexport function drawLights(hud, n, cx, y, on) { if (!on) return; const w = 5 * 18; hud.rect(cx - w / 2 - 3, y - 3, w + 6, 22, 'ink'); for (let i = 0; i < 5; i++) { hud.rect(cx - w / 2 + i * 18 + 2, y, 14, 16, i < n ? 'red' : 'night'); } }\nexport function banner(hud, text, y = 44, c = 'sand', scale = 2) { const t = clean(text), w = t.length * 6 * scale; hud.rect(Math.round(hud.width / 2 - w / 2 - 6), y - 3, w + 12, 7 * scale + 6, 'ink'); hud.text(Math.round(hud.width / 2 - w / 2), y, t, { scale, color: c }); }\nE\ncat >> ../PROGRESS.md <<'E'\n- models/props.js, render/{dressing,camera,people}.js, animation/clips.js, ui/racehud.js written. Next: scenes/race.js, ui/screens/race.js, app.js, main.js, tools/build.mjs (then browser-test a race), then menus.\nE","description":"Write camera, clips, people and race HUD"}}}
