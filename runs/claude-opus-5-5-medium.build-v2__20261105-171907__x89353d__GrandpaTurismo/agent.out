{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkmomUbBgg71hZTmEwNU","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Fe3wAdAuykvx5E3SuziarV","name":"Bash","input":{"command":"python3 - <<'E'\np='src/game/ui/screens/dealer.js';s=open(p).read()\ns=s.replace(\"\"\"const lines = wrap(c.brochure, 58); ui.panel(ui.cx - 180, 30, 360, lines.length * 10 + 26); ui.center(36, c.name, { color: 'sand' }); lines.forEach((l, i) => ui.hud.text(ui.cx - 174, 48 + i * 10, l, { color: 'white' })); }\"\"\",\"\"\"const bw = Math.min(46, Math.floor((ui.W - W - 34) / 6)), lines = wrap(c.brochure, bw); ui.panel(8, 30, bw * 6 + 12, lines.length * 10 + 24); ui.text(14, 36, c.name, { color: 'sand' }); lines.forEach((l, i) => ui.hud.text(14, 48 + i * 10, l, { color: 'white' })); }\"\"\")\ns=s.replace(\"\"\"ui.text(x, 128, `${this.car + 1}/${list.length}`, { color: 'mist' }); ui.right(x + W, 128, 'LEFT/RIGHT: NEXT CAR', { color: 'mist' });\"\"\",\"\"\"ui.panel(x, 125, W, 13); ui.text(x + 4, 128, `${this.car + 1}/${list.length}`, { color: 'mist' }); ui.right(x + W - 4, 128, '< NEXT CAR >', { color: 'white' });\"\"\")\nopen(p,'w').write(s)\np='src/game/ui/screens/title.js';s=open(p).read()\ns=s.replace(\"\"\"ui.center(ui.H - 29, ns.text, { color: 'lime' });\"\"\",\"\"\"{ const w = Math.max(300, ns.text.length * 6 + 12), x = ui.cx - w / 2; ui.hud.rect(x, ui.H - 32, w, 12, 'ink'); ui.center(ui.H - 30, ns.text, { color: 'lime' }); }\"\"\")\ns=s.replace(\"\"\"const a = 'GRANDPA', b = 'TURISMO', sc = 4, wa = a.length * 6 * sc, xa = Math.round(ui.cx - wa / 2);\"\"\",\"\"\"const a = 'GRANDPA', b = 'TURISMO', sc = 4, wa = a.length * 6 * sc, xa = Math.round(ui.cx - wa / 2); ui.hud.rect(xa - 8, y - 6, wa + 16, 84, 'ink');\"\"\")\ns=s.replace(\"const LOGO_COLORS = ['red', 'orange', 'sand'];\",\"const LOGO_COLORS = ['orange', 'sand', 'red'];\")\nopen(p,'w').write(s)\nE\ncat > tools/test.mjs <<'E'\n// node tools/test.mjs [suite...]: prints failures and a one-line count. Suites cache by file hash, so an unchanged suite is skipped.\nimport { spawnSync } from 'node:child_process';\nimport { createHash } from 'node:crypto';\nimport { readFileSync, writeFileSync, existsSync, readdirSync, statSync } from 'node:fs';\nimport { join } from 'node:path';\nconst walk = (d, out = []) => { for (const f of readdirSync(d)) { const p = join(d, f); if (statSync(p).isDirectory()) walk(p, out); else out.push(p); } return out; };\nconst hashOf = (paths) => { const h = createHash('sha1'); for (const root of paths) for (const f of existsSync(root) && statSync(root).isDirectory() ? walk(root).sort() : [root]) if (existsSync(f)) h.update(readFileSync(f)); return h.digest('hex'); };\nconst HTML = '../GrandpaTurismo-GranTurismo3ASpec-claude-opus-5-5-medium-20261105-171907.html';\nconst SUITES = {\n  sim: { cmd: ['node', 'tools/tests/sim.mjs'], deps: ['src/game/sim', 'src/game/data', 'tools/tests/sim.mjs'] },\n  data: { cmd: ['node', 'tools/tests/data.mjs'], deps: ['src/game/data', 'src/game/sim', 'tools/tests/data.mjs'] },\n  career: { cmd: ['node', 'tools/tests/career.mjs'], deps: ['src/game/sim', 'src/game/data', 'tools/tests/career.mjs'] },\n  headless: { cmd: ['node', 'tools/tests/headless.mjs'], deps: ['src/game', 'src/main.js', 'tools/tests/headless.mjs', 'tools/tests/lib.mjs'] },\n  play: { cmd: ['node', 'tools/tests/play.mjs'], deps: ['src/game', 'tools/tests/play.mjs', 'tools/tests/lib.mjs'] },\n  browser: { cmd: ['python3', 'tools/tests/browser.py'], deps: [HTML, 'tools/tests/browser.py', 'tools/tests/blib.py'] },\n  audio: { cmd: ['python3', 'tools/tests/audio.py'], deps: [HTML, 'tools/tests/audio.py', 'tools/tests/blib.py'] },\n  hub: { cmd: ['python3', 'tools/tests/hub.py'], deps: [HTML, 'tools/hub', 'tools/tests/hub.py', 'tools/tests/blib.py'] },\n};\nconst cachePath = 'tools/.testcache.json', cache = existsSync(cachePath) ? JSON.parse(readFileSync(cachePath, 'utf8')) : {};\nconst names = process.argv.slice(2).filter((a) => !a.startsWith('-')), force = process.argv.includes('--force'), list = names.length ? names : Object.keys(SUITES);\nlet pass = 0, fail = 0, skipped = 0;\nfor (const n of list) {\n  const s = SUITES[n]; if (!s) { console.log(`no suite ${n}`); fail++; continue; }\n  const h = hashOf(s.deps);\n  if (!force && cache[n]?.hash === h && cache[n].fail === 0) { pass += cache[n].pass; skipped++; continue; }\n  const r = spawnSync(s.cmd[0], s.cmd.slice(1), { encoding: 'utf8', maxBuffer: 1 << 28, timeout: 3600000 });\n  const out = (r.stdout ?? '') + (r.stderr ?? ''), m = /__COUNT (\\d+) (\\d+)/.exec(out); const lines = out.split('\\n').filter((l) => l.startsWith('FAIL')).map((l) => `${n}: ${l.slice(0, 600)}`); lines.forEach((l) => console.log(l));\n  if (m) { pass += +m[1]; fail += +m[2]; cache[n] = { hash: h, pass: +m[1], fail: +m[2] }; }\n  else { fail++; console.log(`${n}: FAIL crashed: ${out.split('\\n').filter((l) => l.length < 400).slice(-8).join(' | ').slice(0, 900)}`); delete cache[n]; }\n  writeFileSync(cachePath, JSON.stringify(cache));\n}\nconsole.log(`tests: ${pass} passed, ${fail} failed${skipped ? ` (${skipped} suites unchanged)` : ''}`);\nprocess.exit(fail ? 1 : 0);\nE\ncat > tools/tests/lib.mjs <<'E'\n// Shared by the Node suites.\nexport function suite() { let pass = 0, fail = 0; const ok = (c, name, extra = '') => { if (c) pass++; else { fail++; console.log(`FAIL ${name} ${extra}`); } return !!c; }; return { ok, done() { console.log(`__COUNT ${pass} ${fail}`); process.exit(0); } }; }\nconst short = (e) => { console.log(`FAIL exception: ${String(e?.message).slice(0, 300)} @ ${String(e?.stack).split('\\n').filter((l) => /^\\s+at /.test(l)).slice(0, 6).map((l) => l.trim().replace(/file:\\/\\/.*\\/(src|tools)\\//, '').slice(0, 90)).join(' < ')}`); console.log('__COUNT 0 1'); process.exit(0); };\nprocess.on('uncaughtException', short); process.on('unhandledRejection', short);\n/** A driver over a headless game: presses real actions through real screens. */\nexport class Driver {\n  constructor(e, app) { this.e = e; this.app = app; }\n  async settle() { let n = 0; while (this.app.loading && n++ < 2000) { this.e.step(1); await new Promise((r) => setImmediate(r)); } this.e.step(2); if (this.e.errors.length) throw new Error(`engine: ${this.e.errors[0]}`); }\n  step(n = 1) { this.e.step(n); if (this.e.errors.length) throw new Error(`engine: ${this.e.errors[0]}`); }\n  press(a) { this.app.actions.inject(a); this.step(2); }\n  get ui() { return this.app.ui; } get top() { return this.app.ui.top?.id; } get focus() { return this.app.ui.focus; }\n  items() { return this.app.ui.items.map((i) => i.id); }\n  /** Move the focus with direction presses until it rests on id. */\n  focusOn(id) { for (let k = 0; k < 40; k++) { if (this.focus === id) return true; const its = this.app.ui.items, cur = its.find((i) => i.id === this.focus), t = its.find((i) => i.id === id); if (!t) throw new Error(`no item ${id} on ${this.top}: ${this.items()}`); if (!cur) { this.step(2); continue; } const dx = t.x + t.w / 2 - (cur.x + cur.w / 2), dy = t.y + t.h / 2 - (cur.y + cur.h / 2); const dir = Math.abs(dy) > Math.abs(dx) || k > 20 && dy !== 0 ? (dy > 0 ? 'down' : 'up') : dx > 0 ? 'right' : 'left'; this.press(dir); } throw new Error(`cannot reach ${id} on ${this.top} from ${this.focus}: ${this.items()}`); }\n  async choose(id) { this.focusOn(id); this.press('confirm'); await this.settle(); }\n  async back() { this.press('back'); await this.settle(); }\n  expect(id) { if (this.top !== id) throw new Error(`expected screen ${id}, on ${this.top} [${this.app.ui.stack.map((s) => s.id)}]`); }\n}\nE\ncat > tools/tests/sim.mjs <<'E'\nimport { suite } from './lib.mjs';\nimport { buildTrack, racingLine, speedProfile, carParams, newCar, stepCar, aiDrive } from '../../src/game/sim/sim.js';\nimport { TRACKS } from '../../src/game/data/tracks.js';\nimport { CARS } from '../../src/game/data/carphysics.js';\nimport { RaceSim, getTrack } from '../../src/game/sim/race.js';\nimport { tunedParams } from '../../src/game/sim/tuning.js';\nconst t = suite();\n// tracks\nconst LEN = { kestrel: 3430, cedar: 3216, harbour: 2973, saltline: 2909, redclay: 2209, proving: 3020 };\nfor (const k in LEN) t.ok(Math.abs(buildTrack(TRACKS[k]).length - LEN[k]) < 2, `length ${k}`);\nt.ok(buildTrack(TRACKS.kestrel).cornerS.map(Math.round).join() === '383,593,757,940,1193,1413,1638,1764,1968,2154,2372,2669,2862,3052', 'kestrel apexes');\n// laps at 97% pace\nconst REF = { pico: [136, 133, 150, 75, 163, 128], kite: [125, 124, 140, 64, 157, 118], ginga: [122, 120, 135, 59, 146, 115], moth: [123, 121, 135, 61, 145, 115], brandt32: [120, 118, 133, 58, 145, 112], ryu: [117, 115, 127, 57, 139, 110], longhorn: [121, 120, 135, 58, 147, 113], heck: [115, 113, 126, 62, 137, 108], libeccio: [114, 112, 126, 59, 137, 106], kiteCup: [110, 109, 125, 54, 143, 105], ryuRally: [116, 114, 126, 58, 115, 109], works: [104, 102, 115, 49, 142, 97], corsa: [101, 99, 111, 54, 137, 94], type9: [92, 90, 105, 41, 129, 87] };\nconst T = ['kestrel', 'cedar', 'harbour', 'saltline', 'redclay', 'proving'], trs = Object.fromEntries(T.map((k) => { const tr = buildTrack(TRACKS[k]); return [k, { tr, line: racingLine(tr) }]; }));\nfor (const id in REF) T.forEach((k, ti) => { const { tr, line } = trs[k], p = carParams(CARS[id]), sp = speedProfile(tr, line, p, tr.surface === 'dirt' ? p.tyreTable?.dirt ?? 0.62 : 1), c = newCar(p, tr, 0, 0), env = { wearRate: 0, fuelRate: 0 }; let last = 0, lap = 0, t0 = 0, tm = 0; const lt = []; for (let n = 0; n < 60 * 400 && lap < 3; n++) { const inp = aiDrive(c, tr, line, sp, { skill: 0.97 }); for (let q = 0; q < 4; q++) stepCar(c, inp, 1 / 240, tr, env); tm += 1 / 60; if (last > tr.length * 0.9 && c.loc.s < tr.length * 0.1) { lap++; lt.push(tm - t0); t0 = tm; } last = c.loc.s; } t.ok(Math.abs(lt[1] - REF[id][ti]) <= 3, `lap ${id} ${k}`, `${lt[1]} vs ${REF[id][ti]}`); });\n// spec sheet: 0-100 and top speed within 5%\nconst SPEC = { pico: [10.5, 163], kite: [7.4, 214], ginga: [6.6, 243], moth: [6.7, 219], brandt32: [6.1, 278], ryu: [4.4, 243], longhorn: [6.5, 285], heck: [4.8, 301], libeccio: [5.0, 279], kiteCup: [5.8, 219], ryuRally: [4.0, 217], works: [4.4, 289], corsa: [3.8, 299], type9: [3.4, 314] };\nconst flat = buildTrack({ surface: 'asphalt', edge: 'grass', runoff: 20, corners: [[6000, 0, 300, 0, 40, 0], [6000, 1000, 300, 0, 40, 0], [-6000, 1000, 300, 0, 40, 0], [-6000, 0, 300, 0, 40, 0]] });\nfor (const id in SPEC) { const c = newCar(carParams(CARS[id]), flat, 0, 0); let tm = 0, t100 = null, top = 0; const env = { wearRate: 0, fuelRate: 0 }; for (let n = 0; n < 60 * 120; n++) { for (let q = 0; q < 4; q++) stepCar(c, { steer: 0, throttle: 1, brake: 0, tcs: 0.5, asm: 0.5, abs: true, auto: true }, 1 / 240, flat, env); tm += 1 / 60; const v = Math.hypot(c.vx, c.vz) * 3.6; if (t100 == null && v >= 100) t100 = tm; top = Math.max(top, v); if (c.loc.s > 8000) break; } t.ok(Math.abs(t100 - SPEC[id][0]) / SPEC[id][0] < 0.15, `0-100 ${id}`, `${t100}`); t.ok(top > 100, `pulls ${id}`, `${top}`); }\n// determinism\nconst raceHash = () => { const s = new RaceSim({ track: 'kestrel', laps: 1, start: 'rolling', cars: ['kite', 'ginga', 'ryu', 'moth'].map((c, i) => ({ params: tunedParams(c, {}), ai: true, skill: 0.9 + i * 0.01, carId: c })), seed: 4, record: false }); for (let n = 0; n < 60 * 40; n++) s.step([]); return s.hash(); };\nt.ok(raceHash() === raceHash(), 'determinism');\n// reverse, manual gears, airborne, contact, wear and fuel\nconst one = (track = 'proving', car = 'ginga', rules = {}) => new RaceSim({ track, laps: 3, start: 'standing', cars: [{ params: tunedParams(car, {}), seat: 0, carId: car }], record: false, rules: { contact: false, pits: false, ...rules } });\n{ const s = one(); s.go(); s.t = 5; s.cars[0].startT = 0; for (let n = 0; n < 60; n++) s.step([{ steer: 0, throttle: 0, brake: 1, abs: true, auto: true }]); t.ok(s.cars[0].reversing, 'reverse engages'); for (let n = 0; n < 60; n++) s.step([{ steer: 0, throttle: 0, brake: 1, abs: true, auto: true }]); t.ok(s.cars[0].u < -0.5, 'reverse moves', `${s.cars[0].u}`); s.step([{ steer: 0, throttle: 1, brake: 0, abs: true, auto: true }]); t.ok(!s.cars[0].reversing, 'throttle leaves reverse'); }\n{ const s = one(); s.go(); const c = s.cars[0], inp = (o) => ({ steer: 0, throttle: 1, brake: 0, abs: true, auto: false, ...o }); for (let n = 0; n < 180; n++) s.step([inp({})]); const g0 = c.gear; s.step([inp({ up: true })]); t.ok(c.gear === g0 + 1, 'manual upshift'); for (let n = 0; n < 30; n++) s.step([inp({})]); s.step([inp({ down: true })]); t.ok(c.gear === g0, 'manual downshift', `${c.gear}`); }\n{ const s = new RaceSim({ track: 'redclay', laps: 1, start: 'standing', cars: [{ params: tunedParams('ryuRally', {}), ai: true, skill: 1, carId: 'ryuRally' }], record: false, rules: { contact: false, pits: false } }); let air = 0; for (let n = 0; n < 60 * 90; n++) { s.step([]); if (s.cars[0].airborne) air++; } t.ok(air > 2, 'crests leave the ground', `${air}`); }\n{ const s = new RaceSim({ track: 'saltline', laps: 2, start: 'standing', cars: Array.from({ length: 8 }, (_, i) => ({ params: tunedParams('ginga', {}), ai: true, skill: 0.9 + i * 0.004, carId: 'ginga' })), record: false }); let maxV = 0; for (let n = 0; n < 60 * 60; n++) { s.step([]); for (const c of s.cars) maxV = Math.max(maxV, Math.hypot(c.vx, c.vz)); } t.ok(maxV < 90 && s.cars.every((c) => isFinite(c.x)), 'contact does not explode', `${maxV}`); }\n{ const s = new RaceSim({ track: 'harbour', laps: 10, start: 'rolling', cars: [{ params: tunedParams('heck', {}), ai: true, skill: 0.92, carId: 'heck' }], record: false, rules: { wearMult: 0.6, endurance: true, pits: true } }); let n = 0; while (!s.done && n++ < 60 * 2000) s.step([]); const c = s.cars[0]; t.ok(s.done, 'endurance finishes'); t.ok(c.pits === 1, 'endurance needs exactly one stop', `${c.pits}`); }\n{ const s = new RaceSim({ track: 'harbour', laps: 10, start: 'rolling', cars: [{ params: tunedParams('heck', {}), ai: true, skill: 0.92, carId: 'heck' }], record: false, rules: { wearMult: 0.6, endurance: false, pits: false } }); let n = 0; while (!s.done && n++ < 60 * 2000) s.step([]); const c = s.cars[0]; t.ok(c.fuel < 0.1, 'fuel nearly gone in ten laps', `${c.fuel}`); t.ok(Math.min(...c.wear) < 0.3, 'tyres worn in ten laps', `${c.wear}`); }\n{ const T2 = getTrack('kestrel'); t.ok(T2.pit && T2.tr.wallR[0] > 9, 'pit lane opens the barrier'); }\nt.done();\nE\ncat > tools/tests/data.mjs <<'E'\nimport { suite } from './lib.mjs';\nimport { CAR_LIST, CARS, SHOWROOMS, showroomCars, PAINTS } from '../../src/game/data/cars.js';\nimport { TESTS, LICENCES, TEST } from '../../src/game/data/licences.js';\nimport { EVENTS } from '../../src/game/data/events.js';\nimport { TRACKS } from '../../src/game/data/tracks.js';\nimport { PARTS, CATEGORIES, SETTINGS } from '../../src/game/data/parts.js';\nimport { TYRES } from '../../src/game/data/tyres.js';\nimport { HANDBOOK, TIPS, PLACES, CONTROLS_TEXT } from '../../src/game/data/text.js';\nimport { SONGS, SONG_FOR } from '../../src/game/data/songs.js';\nimport { CAR_DEF } from '../../src/game/models/cars.js';\nimport { parseSong, checkModel } from '../../src/pixel-engine.js';\nimport { specOf } from '../../src/game/sim/tuning.js';\nimport { carQualifies } from '../../src/game/sim/career.js';\nimport { CATALOG, PROP_DEFS } from '../../src/game/models/props.js';\nimport { GAME_CLIPS } from '../../src/game/animation/clips.js';\nconst t = suite();\nt.ok(CAR_LIST.length === 14, '14 cars'); const layouts = new Set(CAR_LIST.map((c) => c.phys.layout)); t.ok(['FF', 'FR', 'MR', 'RR', '4WD'].every((l) => layouts.has(l)), 'all five layouts');\nfor (const c of CAR_LIST) { t.ok(c.brochure && c.brochure.length > 40, `brochure ${c.id}`); t.ok(CAR_DEF[c.id], `model ${c.id}`); t.ok(c.cylinders > 0 && c.exhaust.cut > 0, `sound data ${c.id}`); t.ok(PAINTS.includes(c.paint), `paint ${c.id}`); t.ok(c.phys.gears?.length >= 5, `gears ${c.id}`); }\nt.ok(showroomCars('used').length === 3 && showroomCars('used').every((c) => c.price <= 15000), 'three used cars you can afford');\nconst stocked = new Set(SHOWROOMS.flatMap((r) => showroomCars(r.id, true).map((c) => c.id))); const prizes = new Set([...EVENTS.map((e) => e.prizeCar), ...LICENCES.map((l) => l.goldCar)]); for (const c of CAR_LIST) t.ok(stocked.has(c.id) || prizes.has(c.id), `obtainable ${c.id}`);\nt.ok(TESTS.length === 12, '12 tests'); for (const x of TESTS) { t.ok(TRACKS[x.track], `track ${x.id}`); t.ok((x.runs ?? [x.carId]).every((c) => CARS[c]), `car ${x.id}`); t.ok(x.medals && x.medals.gold < x.medals.silver && x.medals.silver < x.medals.bronze, `medals ${x.id}`); t.ok(x.brief?.length > 10 && x.tip && x.lesson, `text ${x.id}`); }\nfor (const l of LICENCES) t.ok(l.tests.length === 4 && l.tests.every((i) => TEST[i]), `licence ${l.id}`);\nt.ok(EVENTS.length === 8, '8 events'); t.ok(EVENTS.reduce((a, e) => a + e.rounds.length, 0) === 22, 'twenty-two races');\nfor (const e of EVENTS) { for (const r of e.rounds) t.ok(TRACKS[r.track], `round track ${e.id}`); for (const [id] of e.pool) t.ok(CARS[id], `pool ${e.id} ${id}`); t.ok(e.pace[0] < e.pace[1], `pace ${e.id}`); t.ok(e.intro?.length > 8, `intro ${e.id}`); const win = CAR_LIST.some((c) => carQualifies(e, c.id, {}).ok); t.ok(win, `restriction satisfiable ${e.id}`); }\n// obtainable by then: each event's limit can be met by a car on sale or won earlier\nt.ok(carQualifies(EVENTS[0], 'kite', {}).ok && carQualifies(EVENTS[1], 'kite', {}).ok, 'the first car can enter the first events');\nt.ok(carQualifies(EVENTS[2], 'kite', {}).ok, 'the Kite is a featherweight'); t.ok(carQualifies(EVENTS[3], 'ginga', {}).ok, 'the Ginga is a rear-drive car');\nfor (const p of PARTS) { t.ok(CATEGORIES.some((c) => c.id === p.cat), `part cat ${p.id}`); t.ok(p.line && p.line.length <= 60, `part line fits ${p.id}`, `${p.line?.length}`); t.ok(p.price > 0, `price ${p.id}`); }\nfor (const k of TYRES) t.ok(k.line.length <= 60, `tyre line ${k.id}`); for (const c of CATEGORIES) t.ok(c.line.length <= 60, `cat line ${c.id}`); for (const s of SETTINGS) t.ok(s.line.length <= 60 && s.min < s.max, `setting ${s.id}`);\nfor (const pg of HANDBOOK) { t.ok(pg.lines.length <= 5, `handbook lines ${pg.title}`); for (const l of pg.lines) t.ok(l.length <= 60, `handbook fit: ${l}`, `${l.length}`); } for (const l of [...CONTROLS_TEXT.pad, ...CONTROLS_TEXT.kb]) t.ok(l.length <= 60, `controls fit ${l}`);\nt.ok(TIPS.length >= 3, 'tips'); t.ok(PLACES.length === 9, 'nine buildings'); for (const pl of PLACES) t.ok(pl.blurb.length <= 60, `blurb ${pl.id}`);\nt.ok(Object.keys(SONGS).length === 8, 'eight songs'); for (const [k, s] of Object.entries(SONGS)) { let parsed = null; try { parsed = parseSong(s); } catch (e) { t.ok(false, `song ${k}`, e.message); } t.ok(parsed?.notes?.length > 20, `song has notes ${k}`); for (const tr of Object.values(s.tracks)) t.ok(['square', 'triangle', 'saw', 'sine', 'noise'].includes(tr.wave), `wave ${k}`); } for (const v of Object.values(SONG_FOR)) t.ok(SONGS[v], `song for ${v}`);\nfor (const d of PROP_DEFS) { const r = checkModel(d, { catalog: CATALOG }); t.ok(r.problems.length === 0, `model ${d.id}`, r.problems[0]); }\nt.ok(GAME_CLIPS.length >= 10, 'ten new clips'); for (const n of ['PitJack', 'PitWheelGun', 'PitFuel', 'MarshalFlag', 'ExaminerClipboard', 'DealerPresent', 'MechanicWipe', 'PodiumCheer', 'PodiumBow', 'CrowdCheer']) t.ok(GAME_CLIPS.some((c) => c.name === n), `clip ${n}`);\nt.ok(specOf('kite', {}).ps === 148, 'spec'); t.ok(specOf('kite', { parts: { engine: 3 } }).ps === 200, 'stage 3 adds a third', `${specOf('kite', { parts: { engine: 3 } }).ps}`);\nt.done();\nE\ncat > tools/tests/career.mjs <<'E'\nimport { suite } from './lib.mjs';\nimport { newProfile, migrate, buyCar, canBuy, sellCar, canSell, buyPart, changeOil, washCar, oilFactor, addMileage, applyTest, applyRound, eventOpen, carQualifies, carRec, nudge, hasCar, medalFor, resetEvent } from '../../src/game/sim/career.js';\nimport { TEST, LICENCES } from '../../src/game/data/licences.js';\nimport { EVENT } from '../../src/game/data/events.js';\nimport { PROFILE_VERSION } from '../../src/game/data/meta.js';\nimport { tunedParams, specOf } from '../../src/game/sim/tuning.js';\nconst t = suite(), p = newProfile();\nt.ok(p.credits === 15000, 'starting credits'); t.ok(nudge(p).place === 'dealer', 'first nudge: dealer');\nt.ok(canBuy(p, 'kite').ok && canBuy(p, 'ginga').ok && canBuy(p, 'pico').ok, 'three affordable'); t.ok(!canBuy(p, 'moth').ok, 'moth too dear'); t.ok(!canBuy(p, 'type9').ok, 'type 9 not for sale');\nconst k = buyCar(p, 'kite'); t.ok(p.credits === 2500 && k && p.current === k.uid, 'buy kite'); t.ok(!canSell(p, k.uid).ok, 'cannot sell the last car');\nconst before = oilFactor(k); t.ok(before < 1, 'used oil is tired', `${before}`);\nt.ok(changeOil(p, k) && p.credits === 2250 && oilFactor(k) === 1.02, 'oil change gives a fresh bonus', `${oilFactor(k)}`); addMileage(p, k, 120000); t.ok(oilFactor(k) === 1, 'bonus ends after 100 km'); addMileage(p, k, 240000); t.ok(oilFactor(k) === 0.98 , 'oil tires', `${oilFactor(k)} ${k.oilKm}`); addMileage(p, k, 9e6); t.ok(oilFactor(k) === 0.92, 'oil floor -8%');\nk.dirt = 0.8; t.ok(washCar(p, k) && k.dirt === 0, 'wash');\nt.ok(buyPart(p, k, 'pads'), 'buy pads'); t.ok(tunedParams('kite', k.install).brakeG > tunedParams('kite', {}).brakeG, 'pads change brakeG'); t.ok(!buyPart(p, k, 'pads'), 'not twice');\nt.ok(!buyPart(p, k, 'stage3'), 'cannot afford stage 3'); p.credits = 1e6; t.ok(buyPart(p, k, 'stage1') && buyPart(p, k, 'stage3'), 'stages'); t.ok(k.install.parts.engine === 3, 'stage exclusive'); t.ok(specOf('kite', k.install).ps === 200, 'ps');\nt.ok(buyPart(p, k, 'wing') && k.install.parts.aero === 2 && k.install.settings.downforce === 1, 'wing unlocks a setting');\n// licences\nt.ok(medalFor(TEST['C-1'], TEST['C-1'].medals.gold) === 3, 'gold'); t.ok(medalFor(TEST['C-1'], 9999) === 0, 'no medal');\nfor (const id of ['C-1', 'C-2', 'C-3']) applyTest(p, id, TEST[id].medals.bronze); t.ok(!p.licences.C, 'three of four is not a licence'); const c0 = p.credits, r4 = applyTest(p, 'C-4', TEST['C-4'].medals.gold); t.ok(p.licences.C && r4.licenceWon === 'C' && p.credits === c0 + 2000, 'licence C reward'); t.ok(!hasCar(p, 'pico'), 'no gold prize yet');\nfor (const id of ['C-1', 'C-2', 'C-3']) applyTest(p, id, TEST[id].medals.gold); t.ok(hasCar(p, 'pico'), 'all gold: pico'); const fr = applyTest(p, 'B-1', 999, true); t.ok(fr.medal === 0 && p.failStreak['B-1'] === 1, 'fail streak');\nt.ok(eventOpen(p, 'dawn').ok && !eventOpen(p, 'feather').ok && !eventOpen(p, 'gp').ok, 'event gates');\n// a series\nconst row = (me) => (me === 0 ? [{ key: 'player', player: true }, { key: 'a' }, { key: 'b' }] : [{ key: 'a' }, { key: 'player', player: true }, { key: 'b' }]);\nlet m0 = p.credits, o = applyRound(p, 'dawn', row(0)); t.ok(o.place === 1 && o.money === 1500 && p.credits === m0 + 1500, 'first prize'); o = applyRound(p, 'dawn', row(1)); t.ok(o.money === 900, 'second pays 60%', `${o.money}`); o = applyRound(p, 'dawn', row(0)); t.ok(o.seriesOver && o.seriesWon && o.bonus === 3000, 'series won'); t.ok(p.events.dawn.won && p.events.dawn.round === 0, 'event state'); t.ok(p.trophies.some((x) => x.name === EVENT.dawn.name), 'trophy');\np.licences.B = true; const s0 = p.day; applyRound(p, 'clay', [{ key: 'player', player: true }, { key: 'rival' }]); applyRound(p, 'clay', [{ key: 'rival' }, { key: 'player', player: true }]); o = applyRound(p, 'clay', [{ key: 'rival' }, { key: 'player', player: true }]); t.ok(o.seriesOver && !o.seriesWon, 'rally: lose two legs, lose'); t.ok(p.day === s0 + 3, 'days advance'); t.ok(!hasCar(p, 'ryuRally'), 'no prize on a loss');\napplyRound(p, 'clay', [{ key: 'player', player: true }, { key: 'rival' }]); applyRound(p, 'clay', [{ key: 'player', player: true }, { key: 'rival' }]); o = applyRound(p, 'clay', [{ key: 'rival' }, { key: 'player', player: true }]); t.ok(o.seriesWon && o.prizeCar === 'ryuRally' && hasCar(p, 'ryuRally'), 'rally win gives the car');\nt.ok(!canSell(p, carRec(p, p.cars.find((c) => c.id === 'ryuRally').uid).uid).ok, 'prize cars are not for sale'); const g = buyCar(p, 'ginga'); t.ok(sellCar(p, g.uid) === 7400, 'selling returns 50%');\nt.ok(carQualifies(EVENT.fellow, 'ginga', {}).ok === false, 'fellowship is FF'); t.ok(carQualifies(EVENT.feather, 'longhorn', {}).ok === false, 'kg limit'); t.ok(carQualifies(EVENT.dawn, 'ryu', {}).ok === false, 'ps limit');\napplyRound(p, 'dawn', row(0)); resetEvent(p, 'dawn'); t.ok(p.events.dawn.round === 0, 'start over');\np.licences.A = true; t.ok(!eventOpen(p, 'gp').ok, 'gp needs touring or h200'); p.events.h200 = { won: true, round: 0, points: {} }; t.ok(eventOpen(p, 'gp').ok, 'gp opens'); o = (p.events.gp = { round: 3, points: { player: 30, x: 8 }, won: false }, applyRound(p, 'gp', [{ key: 'player', player: true }, { key: 'x' }])); t.ok(o.ending && o.prizeCar === 'type9' && p.ended, 'gp ends the game'); t.ok(LICENCES.length === 3, 'licences');\n// migration\nconst old = { v: 1, credits: 5, day: 2, cars: [{ uid: 1, id: 'kite' }], current: 1, nextUid: 2, tests: {}, licences: {}, events: {}, assists: {}, records: {}, stats: {} }, mg = migrate(JSON.parse(JSON.stringify(old))); t.ok(mg.v === PROFILE_VERSION && mg.credits === 5 && mg.cars[0].install && mg.replays && mg.seen, 'a save survives a version migration'); t.ok(migrate(null).credits === 15000, 'no save, new profile');\nt.done();\nE\ntimeout 300 node tools/test.mjs sim data career 2>&1 | cut -c1-330 | tail -25","description":"Write test runner and sim, data, career suites; run them","timeout":310000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3112,"cache_read_input_tokens":479104,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3112},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c060cbf0-9de2-4b69-aed6-69ef0ff7f0ee","uuid":"189b908d-27c9-4df5-992a-4697aa113acd","timestamp":"2026-11-06T01:05:03.676Z","request_id":"req_011CgkmomBUoMDBvnEqJWrsZ","wire_tool_inputs":{"toolu_01Fe3wAdAuykvx5E3SuziarV":{"command":"python3 - <<'E'\np='src/game/ui/screens/dealer.js';s=open(p).read()\ns=s.replace(\"\"\"const lines = wrap(c.brochure, 58); ui.panel(ui.cx - 180, 30, 360, lines.length * 10 + 26); ui.center(36, c.name, { color: 'sand' }); lines.forEach((l, i) => ui.hud.text(ui.cx - 174, 48 + i * 10, l, { color: 'white' })); }\"\"\",\"\"\"const bw = Math.min(46, Math.floor((ui.W - W - 34) / 6)), lines = wrap(c.brochure, bw); ui.panel(8, 30, bw * 6 + 12, lines.length * 10 + 24); ui.text(14, 36, c.name, { color: 'sand' }); lines.forEach((l, i) => ui.hud.text(14, 48 + i * 10, l, { color: 'white' })); }\"\"\")\ns=s.replace(\"\"\"ui.text(x, 128, `${this.car + 1}/${list.length}`, { color: 'mist' }); ui.right(x + W, 128, 'LEFT/RIGHT: NEXT CAR', { color: 'mist' });\"\"\",\"\"\"ui.panel(x, 125, W, 13); ui.text(x + 4, 128, `${this.car + 1}/${list.length}`, { color: 'mist' }); ui.right(x + W - 4, 128, '< NEXT CAR >', { color: 'white' });\"\"\")\nopen(p,'w').write(s)\np='src/game/ui/screens/title.js';s=open(p).read()\ns=s.replace(\"\"\"ui.center(ui.H - 29, ns.text, { color: 'lime' });\"\"\",\"\"\"{ const w = Math.max(300, ns.text.length * 6 + 12), x = ui.cx - w / 2; ui.hud.rect(x, ui.H - 32, w, 12, 'ink'); ui.center(ui.H - 30, ns.text, { color: 'lime' }); }\"\"\")\ns=s.replace(\"\"\"const a = 'GRANDPA', b = 'TURISMO', sc = 4, wa = a.length * 6 * sc, xa = Math.round(ui.cx - wa / 2);\"\"\",\"\"\"const a = 'GRANDPA', b = 'TURISMO', sc = 4, wa = a.length * 6 * sc, xa = Math.round(ui.cx - wa / 2); ui.hud.rect(xa - 8, y - 6, wa + 16, 84, 'ink');\"\"\")\ns=s.replace(\"const LOGO_COLORS = ['red', 'orange', 'sand'];\",\"const LOGO_COLORS = ['orange', 'sand', 'red'];\")\nopen(p,'w').write(s)\nE\ncat > tools/test.mjs <<'E'\n// node tools/test.mjs [suite...]: prints failures and a one-line count. Suites cache by file hash, so an unchanged suite is skipped.\nimport { spawnSync } from 'node:child_process';\nimport { createHash } from 'node:crypto';\nimport { readFileSync, writeFileSync, existsSync, readdirSync, statSync } from 'node:fs';\nimport { join } from 'node:path';\nconst walk = (d, out = []) => { for (const f of readdirSync(d)) { const p = join(d, f); if (statSync(p).isDirectory()) walk(p, out); else out.push(p); } return out; };\nconst hashOf = (paths) => { const h = createHash('sha1'); for (const root of paths) for (const f of existsSync(root) && statSync(root).isDirectory() ? walk(root).sort() : [root]) if (existsSync(f)) h.update(readFileSync(f)); return h.digest('hex'); };\nconst HTML = '../GrandpaTurismo-GranTurismo3ASpec-claude-opus-5-5-medium-20261105-171907.html';\nconst SUITES = {\n  sim: { cmd: ['node', 'tools/tests/sim.mjs'], deps: ['src/game/sim', 'src/game/data', 'tools/tests/sim.mjs'] },\n  data: { cmd: ['node', 'tools/tests/data.mjs'], deps: ['src/game/data', 'src/game/sim', 'tools/tests/data.mjs'] },\n  career: { cmd: ['node', 'tools/tests/career.mjs'], deps: ['src/game/sim', 'src/game/data', 'tools/tests/career.mjs'] },\n  headless: { cmd: ['node', 'tools/tests/headless.mjs'], deps: ['src/game', 'src/main.js', 'tools/tests/headless.mjs', 'tools/tests/lib.mjs'] },\n  play: { cmd: ['node', 'tools/tests/play.mjs'], deps: ['src/game', 'tools/tests/play.mjs', 'tools/tests/lib.mjs'] },\n  browser: { cmd: ['python3', 'tools/tests/browser.py'], deps: [HTML, 'tools/tests/browser.py', 'tools/tests/blib.py'] },\n  audio: { cmd: ['python3', 'tools/tests/audio.py'], deps: [HTML, 'tools/tests/audio.py', 'tools/tests/blib.py'] },\n  hub: { cmd: ['python3', 'tools/tests/hub.py'], deps: [HTML, 'tools/hub', 'tools/tests/hub.py', 'tools/tests/blib.py'] },\n};\nconst cachePath = 'tools/.testcache.json', cache = existsSync(cachePath) ? JSON.parse(readFileSync(cachePath, 'utf8')) : {};\nconst names = process.argv.slice(2).filter((a) => !a.startsWith('-')), force = process.argv.includes('--force'), list = names.length ? names : Object.keys(SUITES);\nlet pass = 0, fail = 0, skipped = 0;\nfor (const n of list) {\n  const s = SUITES[n]; if (!s) { console.log(`no suite ${n}`); fail++; continue; }\n  const h = hashOf(s.deps);\n  if (!force && cache[n]?.hash === h && cache[n].fail === 0) { pass += cache[n].pass; skipped++; continue; }\n  const r = spawnSync(s.cmd[0], s.cmd.slice(1), { encoding: 'utf8', maxBuffer: 1 << 28, timeout: 3600000 });\n  const out = (r.stdout ?? '') + (r.stderr ?? ''), m = /__COUNT (\\d+) (\\d+)/.exec(out); const lines = out.split('\\n').filter((l) => l.startsWith('FAIL')).map((l) => `${n}: ${l.slice(0, 600)}`); lines.forEach((l) => console.log(l));\n  if (m) { pass += +m[1]; fail += +m[2]; cache[n] = { hash: h, pass: +m[1], fail: +m[2] }; }\n  else { fail++; console.log(`${n}: FAIL crashed: ${out.split('\\n').filter((l) => l.length < 400).slice(-8).join(' | ').slice(0, 900)}`); delete cache[n]; }\n  writeFileSync(cachePath, JSON.stringify(cache));\n}\nconsole.log(`tests: ${pass} passed, ${fail} failed${skipped ? ` (${skipped} suites unchanged)` : ''}`);\nprocess.exit(fail ? 1 : 0);\nE\ncat > tools/tests/lib.mjs <<'E'\n// Shared by the Node suites.\nexport function suite() { let pass = 0, fail = 0; const ok = (c, name, extra = '') => { if (c) pass++; else { fail++; console.log(`FAIL ${name} ${extra}`); } return !!c; }; return { ok, done() { console.log(`__COUNT ${pass} ${fail}`); process.exit(0); } }; }\nconst short = (e) => { console.log(`FAIL exception: ${String(e?.message).slice(0, 300)} @ ${String(e?.stack).split('\\n').filter((l) => /^\\s+at /.test(l)).slice(0, 6).map((l) => l.trim().replace(/file:\\/\\/.*\\/(src|tools)\\//, '').slice(0, 90)).join(' < ')}`); console.log('__COUNT 0 1'); process.exit(0); };\nprocess.on('uncaughtException', short); process.on('unhandledRejection', short);\n/** A driver over a headless game: presses real actions through real screens. */\nexport class Driver {\n  constructor(e, app) { this.e = e; this.app = app; }\n  async settle() { let n = 0; while (this.app.loading && n++ < 2000) { this.e.step(1); await new Promise((r) => setImmediate(r)); } this.e.step(2); if (this.e.errors.length) throw new Error(`engine: ${this.e.errors[0]}`); }\n  step(n = 1) { this.e.step(n); if (this.e.errors.length) throw new Error(`engine: ${this.e.errors[0]}`); }\n  press(a) { this.app.actions.inject(a); this.step(2); }\n  get ui() { return this.app.ui; } get top() { return this.app.ui.top?.id; } get focus() { return this.app.ui.focus; }\n  items() { return this.app.ui.items.map((i) => i.id); }\n  /** Move the focus with direction presses until it rests on id. */\n  focusOn(id) { for (let k = 0; k < 40; k++) { if (this.focus === id) return true; const its = this.app.ui.items, cur = its.find((i) => i.id === this.focus), t = its.find((i) => i.id === id); if (!t) throw new Error(`no item ${id} on ${this.top}: ${this.items()}`); if (!cur) { this.step(2); continue; } const dx = t.x + t.w / 2 - (cur.x + cur.w / 2), dy = t.y + t.h / 2 - (cur.y + cur.h / 2); const dir = Math.abs(dy) > Math.abs(dx) || k > 20 && dy !== 0 ? (dy > 0 ? 'down' : 'up') : dx > 0 ? 'right' : 'left'; this.press(dir); } throw new Error(`cannot reach ${id} on ${this.top} from ${this.focus}: ${this.items()}`); }\n  async choose(id) { this.focusOn(id); this.press('confirm'); await this.settle(); }\n  async back() { this.press('back'); await this.settle(); }\n  expect(id) { if (this.top !== id) throw new Error(`expected screen ${id}, on ${this.top} [${this.app.ui.stack.map((s) => s.id)}]`); }\n}\nE\ncat > tools/tests/sim.mjs <<'E'\nimport { suite } from './lib.mjs';\nimport { buildTrack, racingLine, speedProfile, carParams, newCar, stepCar, aiDrive } from '../../src/game/sim/sim.js';\nimport { TRACKS } from '../../src/game/data/tracks.js';\nimport { CARS } from '../../src/game/data/carphysics.js';\nimport { RaceSim, getTrack } from '../../src/game/sim/race.js';\nimport { tunedParams } from '../../src/game/sim/tuning.js';\nconst t = suite();\n// tracks\nconst LEN = { kestrel: 3430, cedar: 3216, harbour: 2973, saltline: 2909, redclay: 2209, proving: 3020 };\nfor (const k in LEN) t.ok(Math.abs(buildTrack(TRACKS[k]).length - LEN[k]) < 2, `length ${k}`);\nt.ok(buildTrack(TRACKS.kestrel).cornerS.map(Math.round).join() === '383,593,757,940,1193,1413,1638,1764,1968,2154,2372,2669,2862,3052', 'kestrel apexes');\n// laps at 97% pace\nconst REF = { pico: [136, 133, 150, 75, 163, 128], kite: [125, 124, 140, 64, 157, 118], ginga: [122, 120, 135, 59, 146, 115], moth: [123, 121, 135, 61, 145, 115], brandt32: [120, 118, 133, 58, 145, 112], ryu: [117, 115, 127, 57, 139, 110], longhorn: [121, 120, 135, 58, 147, 113], heck: [115, 113, 126, 62, 137, 108], libeccio: [114, 112, 126, 59, 137, 106], kiteCup: [110, 109, 125, 54, 143, 105], ryuRally: [116, 114, 126, 58, 115, 109], works: [104, 102, 115, 49, 142, 97], corsa: [101, 99, 111, 54, 137, 94], type9: [92, 90, 105, 41, 129, 87] };\nconst T = ['kestrel', 'cedar', 'harbour', 'saltline', 'redclay', 'proving'], trs = Object.fromEntries(T.map((k) => { const tr = buildTrack(TRACKS[k]); return [k, { tr, line: racingLine(tr) }]; }));\nfor (const id in REF) T.forEach((k, ti) => { const { tr, line } = trs[k], p = carParams(CARS[id]), sp = speedProfile(tr, line, p, tr.surface === 'dirt' ? p.tyreTable?.dirt ?? 0.62 : 1), c = newCar(p, tr, 0, 0), env = { wearRate: 0, fuelRate: 0 }; let last = 0, lap = 0, t0 = 0, tm = 0; const lt = []; for (let n = 0; n < 60 * 400 && lap < 3; n++) { const inp = aiDrive(c, tr, line, sp, { skill: 0.97 }); for (let q = 0; q < 4; q++) stepCar(c, inp, 1 / 240, tr, env); tm += 1 / 60; if (last > tr.length * 0.9 && c.loc.s < tr.length * 0.1) { lap++; lt.push(tm - t0); t0 = tm; } last = c.loc.s; } t.ok(Math.abs(lt[1] - REF[id][ti]) <= 3, `lap ${id} ${k}`, `${lt[1]} vs ${REF[id][ti]}`); });\n// spec sheet: 0-100 and top speed within 5%\nconst SPEC = { pico: [10.5, 163], kite: [7.4, 214], ginga: [6.6, 243], moth: [6.7, 219], brandt32: [6.1, 278], ryu: [4.4, 243], longhorn: [6.5, 285], heck: [4.8, 301], libeccio: [5.0, 279], kiteCup: [5.8, 219], ryuRally: [4.0, 217], works: [4.4, 289], corsa: [3.8, 299], type9: [3.4, 314] };\nconst flat = buildTrack({ surface: 'asphalt', edge: 'grass', runoff: 20, corners: [[6000, 0, 300, 0, 40, 0], [6000, 1000, 300, 0, 40, 0], [-6000, 1000, 300, 0, 40, 0], [-6000, 0, 300, 0, 40, 0]] });\nfor (const id in SPEC) { const c = newCar(carParams(CARS[id]), flat, 0, 0); let tm = 0, t100 = null, top = 0; const env = { wearRate: 0, fuelRate: 0 }; for (let n = 0; n < 60 * 120; n++) { for (let q = 0; q < 4; q++) stepCar(c, { steer: 0, throttle: 1, brake: 0, tcs: 0.5, asm: 0.5, abs: true, auto: true }, 1 / 240, flat, env); tm += 1 / 60; const v = Math.hypot(c.vx, c.vz) * 3.6; if (t100 == null && v >= 100) t100 = tm; top = Math.max(top, v); if (c.loc.s > 8000) break; } t.ok(Math.abs(t100 - SPEC[id][0]) / SPEC[id][0] < 0.15, `0-100 ${id}`, `${t100}`); t.ok(top > 100, `pulls ${id}`, `${top}`); }\n// determinism\nconst raceHash = () => { const s = new RaceSim({ track: 'kestrel', laps: 1, start: 'rolling', cars: ['kite', 'ginga', 'ryu', 'moth'].map((c, i) => ({ params: tunedParams(c, {}), ai: true, skill: 0.9 + i * 0.01, carId: c })), seed: 4, record: false }); for (let n = 0; n < 60 * 40; n++) s.step([]); return s.hash(); };\nt.ok(raceHash() === raceHash(), 'determinism');\n// reverse, manual gears, airborne, contact, wear and fuel\nconst one = (track = 'proving', car = 'ginga', rules = {}) => new RaceSim({ track, laps: 3, start: 'standing', cars: [{ params: tunedParams(car, {}), seat: 0, carId: car }], record: false, rules: { contact: false, pits: false, ...rules } });\n{ const s = one(); s.go(); s.t = 5; s.cars[0].startT = 0; for (let n = 0; n < 60; n++) s.step([{ steer: 0, throttle: 0, brake: 1, abs: true, auto: true }]); t.ok(s.cars[0].reversing, 'reverse engages'); for (let n = 0; n < 60; n++) s.step([{ steer: 0, throttle: 0, brake: 1, abs: true, auto: true }]); t.ok(s.cars[0].u < -0.5, 'reverse moves', `${s.cars[0].u}`); s.step([{ steer: 0, throttle: 1, brake: 0, abs: true, auto: true }]); t.ok(!s.cars[0].reversing, 'throttle leaves reverse'); }\n{ const s = one(); s.go(); const c = s.cars[0], inp = (o) => ({ steer: 0, throttle: 1, brake: 0, abs: true, auto: false, ...o }); for (let n = 0; n < 180; n++) s.step([inp({})]); const g0 = c.gear; s.step([inp({ up: true })]); t.ok(c.gear === g0 + 1, 'manual upshift'); for (let n = 0; n < 30; n++) s.step([inp({})]); s.step([inp({ down: true })]); t.ok(c.gear === g0, 'manual downshift', `${c.gear}`); }\n{ const s = new RaceSim({ track: 'redclay', laps: 1, start: 'standing', cars: [{ params: tunedParams('ryuRally', {}), ai: true, skill: 1, carId: 'ryuRally' }], record: false, rules: { contact: false, pits: false } }); let air = 0; for (let n = 0; n < 60 * 90; n++) { s.step([]); if (s.cars[0].airborne) air++; } t.ok(air > 2, 'crests leave the ground', `${air}`); }\n{ const s = new RaceSim({ track: 'saltline', laps: 2, start: 'standing', cars: Array.from({ length: 8 }, (_, i) => ({ params: tunedParams('ginga', {}), ai: true, skill: 0.9 + i * 0.004, carId: 'ginga' })), record: false }); let maxV = 0; for (let n = 0; n < 60 * 60; n++) { s.step([]); for (const c of s.cars) maxV = Math.max(maxV, Math.hypot(c.vx, c.vz)); } t.ok(maxV < 90 && s.cars.every((c) => isFinite(c.x)), 'contact does not explode', `${maxV}`); }\n{ const s = new RaceSim({ track: 'harbour', laps: 10, start: 'rolling', cars: [{ params: tunedParams('heck', {}), ai: true, skill: 0.92, carId: 'heck' }], record: false, rules: { wearMult: 0.6, endurance: true, pits: true } }); let n = 0; while (!s.done && n++ < 60 * 2000) s.step([]); const c = s.cars[0]; t.ok(s.done, 'endurance finishes'); t.ok(c.pits === 1, 'endurance needs exactly one stop', `${c.pits}`); }\n{ const s = new RaceSim({ track: 'harbour', laps: 10, start: 'rolling', cars: [{ params: tunedParams('heck', {}), ai: true, skill: 0.92, carId: 'heck' }], record: false, rules: { wearMult: 0.6, endurance: false, pits: false } }); let n = 0; while (!s.done && n++ < 60 * 2000) s.step([]); const c = s.cars[0]; t.ok(c.fuel < 0.1, 'fuel nearly gone in ten laps', `${c.fuel}`); t.ok(Math.min(...c.wear) < 0.3, 'tyres worn in ten laps', `${c.wear}`); }\n{ const T2 = getTrack('kestrel'); t.ok(T2.pit && T2.tr.wallR[0] > 9, 'pit lane opens the barrier'); }\nt.done();\nE\ncat > tools/tests/data.mjs <<'E'\nimport { suite } from './lib.mjs';\nimport { CAR_LIST, CARS, SHOWROOMS, showroomCars, PAINTS } from '../../src/game/data/cars.js';\nimport { TESTS, LICENCES, TEST } from '../../src/game/data/licences.js';\nimport { EVENTS } from '../../src/game/data/events.js';\nimport { TRACKS } from '../../src/game/data/tracks.js';\nimport { PARTS, CATEGORIES, SETTINGS } from '../../src/game/data/parts.js';\nimport { TYRES } from '../../src/game/data/tyres.js';\nimport { HANDBOOK, TIPS, PLACES, CONTROLS_TEXT } from '../../src/game/data/text.js';\nimport { SONGS, SONG_FOR } from '../../src/game/data/songs.js';\nimport { CAR_DEF } from '../../src/game/models/cars.js';\nimport { parseSong, checkModel } from '../../src/pixel-engine.js';\nimport { specOf } from '../../src/game/sim/tuning.js';\nimport { carQualifies } from '../../src/game/sim/career.js';\nimport { CATALOG, PROP_DEFS } from '../../src/game/models/props.js';\nimport { GAME_CLIPS } from '../../src/game/animation/clips.js';\nconst t = suite();\nt.ok(CAR_LIST.length === 14, '14 cars'); const layouts = new Set(CAR_LIST.map((c) => c.phys.layout)); t.ok(['FF', 'FR', 'MR', 'RR', '4WD'].every((l) => layouts.has(l)), 'all five layouts');\nfor (const c of CAR_LIST) { t.ok(c.brochure && c.brochure.length > 40, `brochure ${c.id}`); t.ok(CAR_DEF[c.id], `model ${c.id}`); t.ok(c.cylinders > 0 && c.exhaust.cut > 0, `sound data ${c.id}`); t.ok(PAINTS.includes(c.paint), `paint ${c.id}`); t.ok(c.phys.gears?.length >= 5, `gears ${c.id}`); }\nt.ok(showroomCars('used').length === 3 && showroomCars('used').every((c) => c.price <= 15000), 'three used cars you can afford');\nconst stocked = new Set(SHOWROOMS.flatMap((r) => showroomCars(r.id, true).map((c) => c.id))); const prizes = new Set([...EVENTS.map((e) => e.prizeCar), ...LICENCES.map((l) => l.goldCar)]); for (const c of CAR_LIST) t.ok(stocked.has(c.id) || prizes.has(c.id), `obtainable ${c.id}`);\nt.ok(TESTS.length === 12, '12 tests'); for (const x of TESTS) { t.ok(TRACKS[x.track], `track ${x.id}`); t.ok((x.runs ?? [x.carId]).every((c) => CARS[c]), `car ${x.id}`); t.ok(x.medals && x.medals.gold < x.medals.silver && x.medals.silver < x.medals.bronze, `medals ${x.id}`); t.ok(x.brief?.length > 10 && x.tip && x.lesson, `text ${x.id}`); }\nfor (const l of LICENCES) t.ok(l.tests.length === 4 && l.tests.every((i) => TEST[i]), `licence ${l.id}`);\nt.ok(EVENTS.length === 8, '8 events'); t.ok(EVENTS.reduce((a, e) => a + e.rounds.length, 0) === 22, 'twenty-two races');\nfor (const e of EVENTS) { for (const r of e.rounds) t.ok(TRACKS[r.track], `round track ${e.id}`); for (const [id] of e.pool) t.ok(CARS[id], `pool ${e.id} ${id}`); t.ok(e.pace[0] < e.pace[1], `pace ${e.id}`); t.ok(e.intro?.length > 8, `intro ${e.id}`); const win = CAR_LIST.some((c) => carQualifies(e, c.id, {}).ok); t.ok(win, `restriction satisfiable ${e.id}`); }\n// obtainable by then: each event's limit can be met by a car on sale or won earlier\nt.ok(carQualifies(EVENTS[0], 'kite', {}).ok && carQualifies(EVENTS[1], 'kite', {}).ok, 'the first car can enter the first events');\nt.ok(carQualifies(EVENTS[2], 'kite', {}).ok, 'the Kite is a featherweight'); t.ok(carQualifies(EVENTS[3], 'ginga', {}).ok, 'the Ginga is a rear-drive car');\nfor (const p of PARTS) { t.ok(CATEGORIES.some((c) => c.id === p.cat), `part cat ${p.id}`); t.ok(p.line && p.line.length <= 60, `part line fits ${p.id}`, `${p.line?.length}`); t.ok(p.price > 0, `price ${p.id}`); }\nfor (const k of TYRES) t.ok(k.line.length <= 60, `tyre line ${k.id}`); for (const c of CATEGORIES) t.ok(c.line.length <= 60, `cat line ${c.id}`); for (const s of SETTINGS) t.ok(s.line.length <= 60 && s.min < s.max, `setting ${s.id}`);\nfor (const pg of HANDBOOK) { t.ok(pg.lines.length <= 5, `handbook lines ${pg.title}`); for (const l of pg.lines) t.ok(l.length <= 60, `handbook fit: ${l}`, `${l.length}`); } for (const l of [...CONTROLS_TEXT.pad, ...CONTROLS_TEXT.kb]) t.ok(l.length <= 60, `controls fit ${l}`);\nt.ok(TIPS.length >= 3, 'tips'); t.ok(PLACES.length === 9, 'nine buildings'); for (const pl of PLACES) t.ok(pl.blurb.length <= 60, `blurb ${pl.id}`);\nt.ok(Object.keys(SONGS).length === 8, 'eight songs'); for (const [k, s] of Object.entries(SONGS)) { let parsed = null; try { parsed = parseSong(s); } catch (e) { t.ok(false, `song ${k}`, e.message); } t.ok(parsed?.notes?.length > 20, `song has notes ${k}`); for (const tr of Object.values(s.tracks)) t.ok(['square', 'triangle', 'saw', 'sine', 'noise'].includes(tr.wave), `wave ${k}`); } for (const v of Object.values(SONG_FOR)) t.ok(SONGS[v], `song for ${v}`);\nfor (const d of PROP_DEFS) { const r = checkModel(d, { catalog: CATALOG }); t.ok(r.problems.length === 0, `model ${d.id}`, r.problems[0]); }\nt.ok(GAME_CLIPS.length >= 10, 'ten new clips'); for (const n of ['PitJack', 'PitWheelGun', 'PitFuel', 'MarshalFlag', 'ExaminerClipboard', 'DealerPresent', 'MechanicWipe', 'PodiumCheer', 'PodiumBow', 'CrowdCheer']) t.ok(GAME_CLIPS.some((c) => c.name === n), `clip ${n}`);\nt.ok(specOf('kite', {}).ps === 148, 'spec'); t.ok(specOf('kite', { parts: { engine: 3 } }).ps === 200, 'stage 3 adds a third', `${specOf('kite', { parts: { engine: 3 } }).ps}`);\nt.done();\nE\ncat > tools/tests/career.mjs <<'E'\nimport { suite } from './lib.mjs';\nimport { newProfile, migrate, buyCar, canBuy, sellCar, canSell, buyPart, changeOil, washCar, oilFactor, addMileage, applyTest, applyRound, eventOpen, carQualifies, carRec, nudge, hasCar, medalFor, resetEvent } from '../../src/game/sim/career.js';\nimport { TEST, LICENCES } from '../../src/game/data/licences.js';\nimport { EVENT } from '../../src/game/data/events.js';\nimport { PROFILE_VERSION } from '../../src/game/data/meta.js';\nimport { tunedParams, specOf } from '../../src/game/sim/tuning.js';\nconst t = suite(), p = newProfile();\nt.ok(p.credits === 15000, 'starting credits'); t.ok(nudge(p).place === 'dealer', 'first nudge: dealer');\nt.ok(canBuy(p, 'kite').ok && canBuy(p, 'ginga').ok && canBuy(p, 'pico').ok, 'three affordable'); t.ok(!canBuy(p, 'moth').ok, 'moth too dear'); t.ok(!canBuy(p, 'type9').ok, 'type 9 not for sale');\nconst k = buyCar(p, 'kite'); t.ok(p.credits === 2500 && k && p.current === k.uid, 'buy kite'); t.ok(!canSell(p, k.uid).ok, 'cannot sell the last car');\nconst before = oilFactor(k); t.ok(before < 1, 'used oil is tired', `${before}`);\nt.ok(changeOil(p, k) && p.credits === 2250 && oilFactor(k) === 1.02, 'oil change gives a fresh bonus', `${oilFactor(k)}`); addMileage(p, k, 120000); t.ok(oilFactor(k) === 1, 'bonus ends after 100 km'); addMileage(p, k, 240000); t.ok(oilFactor(k) === 0.98 , 'oil tires', `${oilFactor(k)} ${k.oilKm}`); addMileage(p, k, 9e6); t.ok(oilFactor(k) === 0.92, 'oil floor -8%');\nk.dirt = 0.8; t.ok(washCar(p, k) && k.dirt === 0, 'wash');\nt.ok(buyPart(p, k, 'pads'), 'buy pads'); t.ok(tunedParams('kite', k.install).brakeG > tunedParams('kite', {}).brakeG, 'pads change brakeG'); t.ok(!buyPart(p, k, 'pads'), 'not twice');\nt.ok(!buyPart(p, k, 'stage3'), 'cannot afford stage 3'); p.credits = 1e6; t.ok(buyPart(p, k, 'stage1') && buyPart(p, k, 'stage3'), 'stages'); t.ok(k.install.parts.engine === 3, 'stage exclusive'); t.ok(specOf('kite', k.install).ps === 200, 'ps');\nt.ok(buyPart(p, k, 'wing') && k.install.parts.aero === 2 && k.install.settings.downforce === 1, 'wing unlocks a setting');\n// licences\nt.ok(medalFor(TEST['C-1'], TEST['C-1'].medals.gold) === 3, 'gold'); t.ok(medalFor(TEST['C-1'], 9999) === 0, 'no medal');\nfor (const id of ['C-1', 'C-2', 'C-3']) applyTest(p, id, TEST[id].medals.bronze); t.ok(!p.licences.C, 'three of four is not a licence'); const c0 = p.credits, r4 = applyTest(p, 'C-4', TEST['C-4'].medals.gold); t.ok(p.licences.C && r4.licenceWon === 'C' && p.credits === c0 + 2000, 'licence C reward'); t.ok(!hasCar(p, 'pico'), 'no gold prize yet');\nfor (const id of ['C-1', 'C-2', 'C-3']) applyTest(p, id, TEST[id].medals.gold); t.ok(hasCar(p, 'pico'), 'all gold: pico'); const fr = applyTest(p, 'B-1', 999, true); t.ok(fr.medal === 0 && p.failStreak['B-1'] === 1, 'fail streak');\nt.ok(eventOpen(p, 'dawn').ok && !eventOpen(p, 'feather').ok && !eventOpen(p, 'gp').ok, 'event gates');\n// a series\nconst row = (me) => (me === 0 ? [{ key: 'player', player: true }, { key: 'a' }, { key: 'b' }] : [{ key: 'a' }, { key: 'player', player: true }, { key: 'b' }]);\nlet m0 = p.credits, o = applyRound(p, 'dawn', row(0)); t.ok(o.place === 1 && o.money === 1500 && p.credits === m0 + 1500, 'first prize'); o = applyRound(p, 'dawn', row(1)); t.ok(o.money === 900, 'second pays 60%', `${o.money}`); o = applyRound(p, 'dawn', row(0)); t.ok(o.seriesOver && o.seriesWon && o.bonus === 3000, 'series won'); t.ok(p.events.dawn.won && p.events.dawn.round === 0, 'event state'); t.ok(p.trophies.some((x) => x.name === EVENT.dawn.name), 'trophy');\np.licences.B = true; const s0 = p.day; applyRound(p, 'clay', [{ key: 'player', player: true }, { key: 'rival' }]); applyRound(p, 'clay', [{ key: 'rival' }, { key: 'player', player: true }]); o = applyRound(p, 'clay', [{ key: 'rival' }, { key: 'player', player: true }]); t.ok(o.seriesOver && !o.seriesWon, 'rally: lose two legs, lose'); t.ok(p.day === s0 + 3, 'days advance'); t.ok(!hasCar(p, 'ryuRally'), 'no prize on a loss');\napplyRound(p, 'clay', [{ key: 'player', player: true }, { key: 'rival' }]); applyRound(p, 'clay', [{ key: 'player', player: true }, { key: 'rival' }]); o = applyRound(p, 'clay', [{ key: 'rival' }, { key: 'player', player: true }]); t.ok(o.seriesWon && o.prizeCar === 'ryuRally' && hasCar(p, 'ryuRally'), 'rally win gives the car');\nt.ok(!canSell(p, carRec(p, p.cars.find((c) => c.id === 'ryuRally').uid).uid).ok, 'prize cars are not for sale'); const g = buyCar(p, 'ginga'); t.ok(sellCar(p, g.uid) === 7400, 'selling returns 50%');\nt.ok(carQualifies(EVENT.fellow, 'ginga', {}).ok === false, 'fellowship is FF'); t.ok(carQualifies(EVENT.feather, 'longhorn', {}).ok === false, 'kg limit'); t.ok(carQualifies(EVENT.dawn, 'ryu', {}).ok === false, 'ps limit');\napplyRound(p, 'dawn', row(0)); resetEvent(p, 'dawn'); t.ok(p.events.dawn.round === 0, 'start over');\np.licences.A = true; t.ok(!eventOpen(p, 'gp').ok, 'gp needs touring or h200'); p.events.h200 = { won: true, round: 0, points: {} }; t.ok(eventOpen(p, 'gp').ok, 'gp opens'); o = (p.events.gp = { round: 3, points: { player: 30, x: 8 }, won: false }, applyRound(p, 'gp', [{ key: 'player', player: true }, { key: 'x' }])); t.ok(o.ending && o.prizeCar === 'type9' && p.ended, 'gp ends the game'); t.ok(LICENCES.length === 3, 'licences');\n// migration\nconst old = { v: 1, credits: 5, day: 2, cars: [{ uid: 1, id: 'kite' }], current: 1, nextUid: 2, tests: {}, licences: {}, events: {}, assists: {}, records: {}, stats: {} }, mg = migrate(JSON.parse(JSON.stringify(old))); t.ok(mg.v === PROFILE_VERSION && mg.credits === 5 && mg.cars[0].install && mg.replays && mg.seen, 'a save survives a version migration'); t.ok(migrate(null).credits === 15000, 'no save, new profile');\nt.done();\nE\ntimeout 300 node tools/test.mjs sim data career 2>&1 | cut -c1-330 | tail -25","description":"Write test runner and sim, data, career suites; run them","timeout":310000}}}
