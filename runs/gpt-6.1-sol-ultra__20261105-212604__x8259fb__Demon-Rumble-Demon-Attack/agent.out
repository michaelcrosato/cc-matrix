{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='main.js';s=open(p).read();s=s.replace(\\\"let targetX=target?.x||Math.sin(simTime)*9;\\\", \\\"const flight=target?Math.max(0,(target.y-s.y)/23):0;let targetX=target?.x??Math.sin(simTime)*9;if(target){if(target.type==='boss')targetX=Math.sin((simTime+flight)*.55)*8;else if(target.type==='shard')targetX=target.x+target.vx*flight;else targetX=target.baseX+Math.sin((simTime+flight)*(.65+wave*.05)+target.phase)*1.6;}\\\")\ns=s.replace(\\\"pulse:s.pulse<=0&&(entities.filter(a=>a.type==='hostile').length>12||wave===6)\\\",\\\"pulse:s.pulse<=0&&(entities.filter(a=>a.type==='hostile').length>12||wave===6||wave>=2&&simTime>14)\\\")\ns=s.replace(\\\"({id:a.id,type:a.type,hp:a.hp})\\\", \\\"({id:a.id,type:a.type,hp:a.hp,x:a.x,y:a.y})\\\")\nopen(p,'w').write(s)\nPY\nnode build.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='main.js';s=open(p).read();s=s.replace(\\\"let targetX=target?.x||Math.sin(simTime)*9;\\\", \\\"const flight=target?Math.max(0,(target.y-s.y)/23):0;let targetX=target?.x??Math.sin(simTime)*9;if(target){if(target.type==='boss')targetX=Math.sin((simTime+flight)*.55)*8;else if(target.type==='shard')targetX=target.x+target.vx*flight;else targetX=target.baseX+Math.sin((simTime+flight)*(.65+wave*.05)+target.phase)*1.6;}\\\")\ns=s.replace(\\\"pulse:s.pulse<=0&&(entities.filter(a=>a.type==='hostile').length>12||wave===6)\\\",\\\"pulse:s.pulse<=0&&(entities.filter(a=>a.type==='hostile').length>12||wave===6||wave>=2&&simTime>14)\\\")\ns=s.replace(\\\"({id:a.id,type:a.type,hp:a.hp})\\\", \\\"({id:a.id,type:a.type,hp:a.hp,x:a.x,y:a.y})\\\")\nopen(p,'w').write(s)\nPY\nnode build.mjs\"","aggregated_output":"Built Demon-Rumble-Demon-Attack-gpt-6.1-sol-ultra-20261105-212604.html (3.01 MB)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"cat > verify.mjs <<'EOF'\nimport { testNetwork } from './network.test.mjs';\nimport { spawnSync } from 'node:child_process';\nimport { readFile } from 'node:fs/promises';\nimport { fileURLToPath } from 'node:url';\nimport path from 'node:path';\nprocess.chdir(path.dirname(fileURLToPath(import.meta.url)));\nlet count=0;const failures=[];\nfunction check(condition,label){count++;if(\"'!condition)failures.push(label);}\ntry{\n const metadata=JSON.parse(await readFile('\"'../exit-interview.json','utf8'));\n check(metadata.aiHub.name==='Demon Rumble','Exit interview has title');\n check(metadata.sourceInformation.usage==='added on import','Usage is added on import');\n check([metadata.testingFeedback.length,metadata.engineFeedback.length,metadata.promptFeedback.length].join(',')==='4,6,4','Feedback answer counts');\n check(\"'!JSON.stringify(metadata).includes('\"'Pending'),'Final metadata has no pending answers');\n const sel=JSON.parse(await readFile('title-selection.json','utf8'));\n const html=await readFile(\"'`../${sel.basename}.html`,'\"'utf8');\n const client=await readFile('hub-reference/session.js','utf8');\n check(html.includes(\"'`<script>${client.replaceAll('\"'</script','<\\\\\\\\/script')}</script>\"'`),'\"'Unmodified AI Hub client is first script');\n check(\"'!/<script[''^>]+src=/.test(html)&&!/<link[''^>]+href=/.test(html),'\"'HTML has no external script or stylesheet dependency');\n const net=await testNetwork();count+=net.count;failures.push(...net.failures);\n}catch(e){failures.push(e.stack);}\nconst python='/home/micha/.local/share/pipx/venvs/playwright/bin/python';\nfor(const name of ['gameplay-test.py','network-browser-test.py','fullgame-network-test.py','hub-test.py']){\n const result=spawnSync(python,[name],{encoding:'utf8',maxBuffer:4*1024*1024});\n const stdout=result.stdout||'';\n const matches=[...stdout.matchAll(/(?:Gameplay:\\\\s*(\\\\d+)\\\\/(\\\\d+) checks passed|(\\\\d+) (?:direct-network|full-game network|hub) checks, (\\\\d+) failures)/g)];\n for(const m of matches)count+=Number(m[2]||m[3]||0);\n if(result.status\"'!==0)failures.push(`${name}: ${stdout.trim()} ${(result.stderr||'\"'').trim()}\"'`);\n}\nfor(const f of failures)console.log('\"'FAIL: '+f);\nconsole.log(\"'`${count} checks, ${failures.length} failures`);\nprocess.exitCode=failures.length?1:0;\nEOF\npython3 - <<'\"'PY'\nimport json\np='package.json';x=json.load(open(p));x['type']='module';x['description']='A self-contained cel-shaded arcade demon shooter';x['scripts']={'build':'node build.mjs','test':'node verify.mjs'};x['dependencies']={k:v.lstrip('\"'^'\"') for k,v in x['dependencies'].items()};open(p,'w').write(json.dumps(x,indent=2)+'\\\\n')\np='main.js';s=open(p).read().replace(\\\"lastInput='keyboard'\\\", \\\"lastInput=matchMedia('(pointer:coarse)').matches?'touch':'keyboard'\\\")\ns=s.replace(\\\"\"'$('\"'#music').value=settings.music;\\\", \\\"\"'$('\"'button[data-action=\\\\\\\"glyphs\\\\\\\"]').textContent=\"'`Controller glyphs: ${settings.glyphs==='\"'ps'?'PlayStation':'Xbox'}\"'`;$('\"'button[data-action=\\\\\\\"reduced\\\\\\\"]').textContent=\"'`Reduced motion: ${settings.reduced?'\"'ON':'OFF'}\"'`;$('\"'#music').value=settings.music;\\\")\nopen(p,'w').write(s)\nPY\nnode build.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"cat > verify.mjs <<'EOF'\nimport { testNetwork } from './network.test.mjs';\nimport { spawnSync } from 'node:child_process';\nimport { readFile } from 'node:fs/promises';\nimport { fileURLToPath } from 'node:url';\nimport path from 'node:path';\nprocess.chdir(path.dirname(fileURLToPath(import.meta.url)));\nlet count=0;const failures=[];\nfunction check(condition,label){count++;if(\"'!condition)failures.push(label);}\ntry{\n const metadata=JSON.parse(await readFile('\"'../exit-interview.json','utf8'));\n check(metadata.aiHub.name==='Demon Rumble','Exit interview has title');\n check(metadata.sourceInformation.usage==='added on import','Usage is added on import');\n check([metadata.testingFeedback.length,metadata.engineFeedback.length,metadata.promptFeedback.length].join(',')==='4,6,4','Feedback answer counts');\n check(\"'!JSON.stringify(metadata).includes('\"'Pending'),'Final metadata has no pending answers');\n const sel=JSON.parse(await readFile('title-selection.json','utf8'));\n const html=await readFile(\"'`../${sel.basename}.html`,'\"'utf8');\n const client=await readFile('hub-reference/session.js','utf8');\n check(html.includes(\"'`<script>${client.replaceAll('\"'</script','<\\\\\\\\/script')}</script>\"'`),'\"'Unmodified AI Hub client is first script');\n check(\"'!/<script[''^>]+src=/.test(html)&&!/<link[''^>]+href=/.test(html),'\"'HTML has no external script or stylesheet dependency');\n const net=await testNetwork();count+=net.count;failures.push(...net.failures);\n}catch(e){failures.push(e.stack);}\nconst python='/home/micha/.local/share/pipx/venvs/playwright/bin/python';\nfor(const name of ['gameplay-test.py','network-browser-test.py','fullgame-network-test.py','hub-test.py']){\n const result=spawnSync(python,[name],{encoding:'utf8',maxBuffer:4*1024*1024});\n const stdout=result.stdout||'';\n const matches=[...stdout.matchAll(/(?:Gameplay:\\\\s*(\\\\d+)\\\\/(\\\\d+) checks passed|(\\\\d+) (?:direct-network|full-game network|hub) checks, (\\\\d+) failures)/g)];\n for(const m of matches)count+=Number(m[2]||m[3]||0);\n if(result.status\"'!==0)failures.push(`${name}: ${stdout.trim()} ${(result.stderr||'\"'').trim()}\"'`);\n}\nfor(const f of failures)console.log('\"'FAIL: '+f);\nconsole.log(\"'`${count} checks, ${failures.length} failures`);\nprocess.exitCode=failures.length?1:0;\nEOF\npython3 - <<'\"'PY'\nimport json\np='package.json';x=json.load(open(p));x['type']='module';x['description']='A self-contained cel-shaded arcade demon shooter';x['scripts']={'build':'node build.mjs','test':'node verify.mjs'};x['dependencies']={k:v.lstrip('\"'^'\"') for k,v in x['dependencies'].items()};open(p,'w').write(json.dumps(x,indent=2)+'\\\\n')\np='main.js';s=open(p).read().replace(\\\"lastInput='keyboard'\\\", \\\"lastInput=matchMedia('(pointer:coarse)').matches?'touch':'keyboard'\\\")\ns=s.replace(\\\"\"'$('\"'#music').value=settings.music;\\\", \\\"\"'$('\"'button[data-action=\\\\\\\"glyphs\\\\\\\"]').textContent=\"'`Controller glyphs: ${settings.glyphs==='\"'ps'?'PlayStation':'Xbox'}\"'`;$('\"'button[data-action=\\\\\\\"reduced\\\\\\\"]').textContent=\"'`Reduced motion: ${settings.reduced?'\"'ON':'OFF'}\"'`;$('\"'#music').value=settings.music;\\\")\nopen(p,'w').write(s)\nPY\nnode build.mjs\"","aggregated_output":"Built Demon-Rumble-Demon-Attack-gpt-6.1-sol-ultra-20261105-212604.html (3.00 MB)\n","exit_code":0,"status":"completed"}}
