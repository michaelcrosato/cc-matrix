{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc 'cat network.test.mjs | tail -35 && tail -45 hub-test.py && cat package.json'","aggregated_output":"  await guest.initHub();\n  handlers.start({ in: 0 });\n  guest.update(0.1, null, { fire: true });\n  check(sent.at(-1).message.kind === 'input' && sent.at(-1).options.to === 0, 'Guest sends input to host');\n  handlers.message({ dr: 1, seq: 1, kind: 'world', value: { score: 99 } }, 1);\n  check(snapshot === undefined, 'Guest ignores world from non-host');\n  handlers.message({ dr: 1, seq: 1, kind: 'world', value: { score: 99 } }, 0);\n  check(snapshot?.score === 99, 'Guest accepts host world');\n  guest.end();\n\n  globalThis.AIHub.connect = async () => ({ ...info, me: -1, host: -1, server: true });\n  const server = new NetworkDirector();\n  await server.initHub();\n  check(server.server && server.localSeat === -1 && server.isHost && server.playerCount === 4, 'Dedicated server has no local seat');\n  server.end();\n  globalThis.AIHub = { active: false };\n  const offline = new NetworkDirector();\n  check(await offline.initHub() === null && !offline.active && offline.isHost, 'Standalone initialization without Hub');\n  let invalidRejected = false;\n  try { offline._decodeDescription('bad', 'offer'); } catch { invalidRejected = true; }\n  check(invalidRejected, 'Invalid signaling code is rejected');\n  return { count, failures };\n}\n\nif (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {\n  try {\n    const result = await testNetwork();\n    for (const failure of result.failures) console.error(`FAIL: ${failure}`);\n    console.log(`${result.count} network checks, ${result.failures.length} failures`);\n    if (result.failures.length) process.exitCode = 1;\n  } catch (error) {\n    console.error(`FAIL: ${error.message}`);\n    process.exitCode = 1;\n  }\n}\n                                failures.append(f\"{name}: {check['name']}: {check.get('detail', '')}\")\n                        count += 1\n                        if errors:\n                            failures.append(f\"{name}: page errors: {'; '.join(errors[:3])}\")\n                        count += 1\n                        if not report.get('gameStates'):\n                            failures.append(f'{name}: no live game state found')\n                        if report.get('pass') is not True and not any(name + ':' in failure for failure in failures):\n                            failures.append(f'{name}: harness did not pass')\n                        reports.append(report)\n                    except Exception as error:\n                        count += 1\n                        failures.append(f'{name}: {error}')\n                        reports.append({'scenarioName': name, 'pass': False, 'error': str(error), 'pageErrors': errors})\n                    finally:\n                        context.close()\n            finally:\n                browser.close()\n    finally:\n        server.terminate()\n        try:\n            server.wait(timeout=5)\n        except subprocess.TimeoutExpired:\n            server.kill()\n            server.wait(timeout=5)\n        if server.stdout:\n            server.stdout.close()\n    (DEV / 'hub-test-results.json').write_text(json.dumps({'count': count, 'failures': failures, 'scenarios': reports}, indent=2))\n    return count, failures\n\n\nif __name__ == '__main__':\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--scenario', action='append', choices=[name for name, _ in SCENARIOS])\n    parser.add_argument('--fallback', action='store_true')\n    args = parser.parse_args()\n    try:\n        count, failures = run(args.scenario, args.fallback)\n    except Exception as error:\n        print(f'FAIL: Hub checks could not run: {error}')\n        raise SystemExit(1)\n    for failure in failures:\n        print(f'FAIL: {failure}')\n    print(f'{count} hub checks, {len(failures)} failures')\n    raise SystemExit(bool(failures))\n{\n  \"name\": \"demon-rumble-demon-attack-gpt-6.1-sol-ultra-20261105-212604\",\n  \"version\": \"1.0.0\",\n  \"description\": \"\",\n  \"main\": \"index.js\",\n  \"scripts\": {\n    \"test\": \"echo \\\"Error: no test specified\\\" && exit 1\"\n  },\n  \"keywords\": [],\n  \"type\": \"commonjs\",\n  \"dependencies\": {\n    \"@dimforge/rapier3d-compat\": \"^0.19.3\",\n    \"esbuild\": \"^0.28.2\",\n    \"three\": \"^0.180.0\"\n  }\n}\n","exit_code":0,"status":"completed"}}
