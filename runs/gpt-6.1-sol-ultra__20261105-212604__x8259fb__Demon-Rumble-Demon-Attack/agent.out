{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"rg -n 'modal|touch-action|overflow' style.css | head -25 && rg -n 'pollPads|function bindInput|PageDown|prompt-footer|const el = menuItems' main.js\"","aggregated_output":"22:\toverflow: hidden;\n28:\ttouch-action: none;\n494:.modal {\n496:\toverflow-y: auto;\n500:\ttouch-action: pan-y;\n502:.modal .menu {\n505:.modal .eyebrow {\n508:.modal .description {\n541:\ttouch-action: pan-x;\n643:\ttouch-action: pan-y;\n668:.touch-action {\n685:.touch-action:active {\n917:\t.modal {\n920:\t.modal .description {\n1085:\t.modal {\n1303:\t$(\"#prompt-footer\").textContent = `${p.accept} SELECT   ·   ${p.back} BACK`;\n1328:\t$(\"#prompt-footer\").classList.toggle(\"hidden\", name === null);\n1562:function bindInput() {\n1590:\t\t\tconst el = menuItems()[focusIndex];\n1675:function pollPads(dt) {\n1712:\t\t\tconst el = menuItems()[focusIndex],\n1928:\t\t\tpollPads(dt);\n","exit_code":0,"status":"completed"}}
