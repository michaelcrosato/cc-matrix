\"physicsBodies\": 3, \"tuning\": {\"enemySpeed\": 1, \"bulletSpeed\": 1, \"fireRate\": 1, \"damage\": 1, \"invincible\": false, \"autoplay\": false}, \"audio\": {\"state\": \"locked\", \"musicVolume\": 0.1, \"sfxVolume\": 0.65, \"muted\": false, \"paused\": false, \"sequencerStep\": 0, \"scheduledNotes\": 0, \"events\": {}, \"rms\": 0, \"voices\": 0}, \"network\": {\"transport\": \"none\", \"status\": \"offline\", \"active\": false, \"isHost\": true, \"localSeat\": 0, \"players\": 1, \"server\": false, \"started\": false, \"ended\": false, \"sent\": 0, \"received\": 0, \"rejected\": 0, \"lastError\": \"\", \"peerState\": null, \"iceState\": null, \"channelState\": null}, \"lastInput\": \"keyboard\", \"isAttract\": false}, \"loading\": \"WARMING UP THE UNDERWORLDDEMON RUMBLE\"}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' style.css && rg -n 'title-screen|logo|title-footer|menu-row|bottom-hud|prompt' style.css && sed -n '1,130p' network.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' style.css && rg -n 'title-screen|logo|title-footer|menu-row|bottom-hud|prompt' style.css && sed -n '1,130p' network.js\"","aggregated_output":":root {\n\tcolor-scheme: dark;\n\t--ink: #071d26;\n\t--paper: #fff5d8;\n\t--muted: #9db6af;\n\t--citron: #eff96b;\n\t--coral: #ff715e;\n\t--teal: #81e8cb;\n\t--line: rgba(218, 242, 212, 0.22);\n\t--shadow: 5px 6px 0 #020d14;\n\tfont-family: \"Trebuchet MS\", Arial, sans-serif;\n\tfont-synthesis: none;\n}\n* {\n\tbox-sizing: border-box;\n}\nhtml,\nbody {\n\twidth: 100%;\n\theight: 100%;\n\tmargin: 0;\n\toverflow: hidden;\n\toverscroll-behavior: none;\n}\nbody {\n\tbackground: var(--ink);\n\tcolor: var(--paper);\n\ttouch-action: none;\n\t-webkit-user-select: none;\n\tuser-select: none;\n}\nbutton,\ninput,\nselect,\ntextarea {\n\tfont: inherit;\n}\nbutton {\n\t-webkit-tap-highlight-color: transparent;\n}\nbutton:focus-visible,\ninput:focus-visible,\nselect:focus-visible,\ntextarea:focus-visible {\n\toutline: 3px solid var(--teal);\n\toutline-offset: 5px;\n}\nbutton:disabled {\n\topacity: 0.38;\n\tcursor: default;\n}\na {\n\tcolor: var(--citron);\n}\n#game {\n\tposition: fixed;\n\tinset: 0;\n\tdisplay: block;\n\twidth: 100%;\n\theight: 100%;\n\toutline: 0;\n\tz-index: 0;\n}\n#ui {\n\tposition: fixed;\n\tinset: 0;\n\tz-index: 2;\n\tpointer-events: none;\n}\n#ui::after {\n\tcontent: \"\";\n\tposition: absolute;\n\tinset: 0;\n\tpointer-events: none;\n\tz-index: 20;\n\topacity: 0.1;\n\tbackground: repeating-linear-gradient(\n\t\t0deg,\n\t\ttransparent 0,\n\t\ttransparent 3px,\n\t\t#06141c 4px,\n\t\ttransparent 5px\n\t);\n\tmix-blend-mode: multiply;\n}\n.hidden,\n[hidden] {\n\tdisplay: none !important;\n}\n.screen {\n\tposition: absolute;\n\tinset: 0;\n\tdisplay: flex;\n\tflex-direction: column;\n\talign-items: center;\n\tjustify-content: center;\n\tpadding: 5vh 5vw;\n\tbackground: rgba(3, 16, 23, 0.43);\n\tpointer-events: none;\n}\n.screen h2 {\n\tmargin: 0 0 22px;\n\tcolor: var(--paper);\n\tfont-family: Impact, \"Arial Black\", sans-serif;\n\tfont-size: clamp(34px, 4vw, 58px);\n\tfont-weight: 400;\n\ttext-transform: uppercase;\n\tletter-spacing: 0.035em;\n\tline-height: 0.95;\n}\n.screen h3 {\n\tmargin: 22px 0 12px;\n\tcolor: var(--citron);\n\tfont-size: 19px;\n\tletter-spacing: 0.08em;\n\ttext-transform: uppercase;\n}\n.screen p {\n\tline-height: 1.5;\n}\n.panel {\n\tposition: relative;\n\twidth: min(720px, 100%);\n\tpadding: 32px 40px 36px;\n\tbackground: linear-gradient(\n\t\t135deg,\n\t\trgba(16, 46, 53, 0.98),\n\t\trgba(7, 29, 38, 0.98)\n\t);\n\tborder: 2px solid var(--paper);\n\tbox-shadow: 9px 10px 0 rgba(0, 7, 13, 0.65);\n\tpointer-events: auto;\n}\n.panel::before {\n\tcontent: \"\";\n\tposition: absolute;\n\ttop: -5px;\n\tleft: 24px;\n\twidth: 86px;\n\theight: 7px;\n\ttransform: rotate(-2deg);\n\tbackground: var(--citron);\n}\n.panel > :first-child {\n\tmargin-top: 0;\n}\n.panel > :last-child {\n\tmargin-bottom: 0;\n}\n.eyebrow,\n.kicker {\n\tdisplay: block;\n\tmargin: 0 0 14px;\n\tcolor: var(--citron);\n\tfont-size: clamp(12px, 1.2vw, 17px);\n\tline-height: 1.2;\n\tfont-weight: 800;\n\tletter-spacing: 0.2em;\n\ttext-transform: uppercase;\n}\n.title-screen {\n\talign-items: flex-start;\n\tpadding: 5vh 7vw;\n\tbackground: linear-gradient(\n\t\t90deg,\n\t\trgba(3, 18, 25, 0.97) 0%,\n\t\trgba(3, 18, 25, 0.9) 25%,\n\t\trgba(3, 18, 25, 0.5) 47%,\n\t\ttransparent 72%\n\t);\n}\n.title-screen .eyebrow {\n\tmargin-bottom: 20px;\n\tpadding-left: 5px;\n}\n.logo,\nh1.logo {\n\tmargin: 0;\n\tfont-family: Impact, \"Arial Black\", sans-serif;\n\tfont-size: clamp(78px, 10.8vw, 168px);\n161:.title-screen {\n172:.title-screen .eyebrow {\n176:.logo,\n177:h1.logo {\n191:.logo span {\n194:.logo .accent {\n273:.menu-row {\n279:.menu-row > * {\n282:.menu-row .button {\n286:.title-footer {\n296:.title-footer strong {\n369:.bottom-hud {\n380:.bottom-hud .right {\n383:.bottom-hud .label {\n390:.bottom-hud strong {\n807:\t.title-screen .tagline {\n810:\t.title-footer {\n822:\t.title-screen {\n826:\t.logo,\n827:\th1.logo {\n830:\t.title-screen .eyebrow {\n846:\t.title-footer {\n867:\t.title-screen {\n877:\t.logo,\n878:\th1.logo {\n881:\t.title-screen .eyebrow {\n901:\t.title-footer {\n906:\t.title-footer .controls-strip {\n939:\t.menu-row {\n942:\t.menu-row .button {\n962:\t.bottom-hud {\n968:\t.bottom-hud .label {\n976:\t.bottom-hud .controls-strip {\n1014:\t.title-screen {\n1018:\t.logo,\n1019:\th1.logo {\n1022:\t.title-screen .tagline {\n1025:\t.title-footer {\n1034:\t.bottom-hud .right .controls-strip {\n1052:\t.title-screen {\n1055:\t.logo,\n1056:\th1.logo {\n1059:\t.title-screen .eyebrow {\n1067:\t.title-screen .menu {\n1073:\t.title-screen .menu button {\n1078:\t.title-footer {\n1082:\t.title-footer .controls-strip {\n1097:\t.bottom-hud {\n/* Demon Rumble networking. AI Hub Session Protocol v1; standalone direct WebRTC. */\nconst NETWORK_RATE = 1 / 12;\nconst PACKET_LIMIT = 16000;\nconst empty = () => {};\nconst byteLength = (text) => new TextEncoder().encode(text).length;\n\nexport class NetworkDirector {\n  constructor(callbacks = {}) {\n    this.callbacks = { onStart: empty, onSnapshot: empty, onRemoteInput: empty, onEnd: empty, onTimeUp: empty, onLeave: empty, ...callbacks };\n    this._transport = 'none';\n    this._status = 'offline';\n    this._info = null;\n    this._ended = false;\n    this._started = false;\n    this._pendingStart = false;\n    this._reported = false;\n    this._ready = false;\n    this._accumulator = 0;\n    this._sendSequence = 0;\n    this._receiveSequences = new Map();\n    this._removed = new Set();\n    this._unsubscribers = [];\n    this._startTimer = null;\n    this._peer = null;\n    this._channel = null;\n    this._lastSnapshot = null;\n    this._sent = 0;\n    this._received = 0;\n    this._rejected = 0;\n    this._lastError = '';\n  }\n\n  get active() { return this._transport === 'hub' || (this._transport === 'peer' && this._started); }\n  get hub() { return this._transport === 'hub'; }\n  get isHost() { return this._info ? this._info.isHost === true : true; }\n  get localSeat() { return this.server ? -1 : (this._info?.me ?? 0); }\n  get playerCount() { return this._info?.players?.filter(p => !this._removed.has(p.id)).length ?? 1; }\n  get players() { return this._info?.players?.filter(p => !this._removed.has(p.id)) ?? [{ id: 0, name: 'Pilot 1', color: '#5de0e7' }]; }\n  get server() { return this._info?.server === true; }\n  get info() { return this._info; }\n  get status() { return this._status; }\n  get mode() { return this.active ? 'shared-world' : 'offline'; }\n  get ended() { return this._ended; }\n\n  async initHub() {\n    const hub = globalThis.AIHub;\n    if (!hub?.active) return null;\n    this._transport = 'hub';\n    this._status = 'joining';\n    const info = await hub.connect({ mode: 'shared-world', seats: [1, 4] });\n    if (!info) {\n      this._transport = 'none';\n      this._status = 'offline';\n      return null;\n    }\n    this._info = { ...info, source: 'hub' };\n    this._status = 'waiting';\n    this._unsubscribers.push(\n      hub.on('start', () => {\n        if (this._ended) return;\n        this._pendingStart = true;\n        this._status = 'countdown';\n        this._tryHubStart();\n      }),\n      hub.on('message', (data, from) => this._receive(data, from)),\n      hub.on('leave', ({ id, reason }) => {\n        this._removed.add(id);\n        this.callbacks.onLeave(id, reason);\n      }),\n      hub.on('time-up', () => {\n        if (!this._ended && !this._reported) this.callbacks.onTimeUp();\n      }),\n      hub.on('end', ({ reason, standings }) => this.end(reason, { standings }))\n    );\n    return this._info;\n  }\n\n  hubReady() {\n    if (!this.hub || this._ready || this._ended) return;\n    this._ready = true;\n    globalThis.AIHub.ready();\n  }\n\n  _tryHubStart() {\n    if (!this.hub || !this._pendingStart || this._ended || this._started) return;\n    const left = globalThis.AIHub.time();\n    if (left >= 0) {\n      this._pendingStart = false;\n      this._started = true;\n      this._status = 'playing';\n      if (this._startTimer !== null) clearTimeout(this._startTimer);\n      this._startTimer = null;\n      this.callbacks.onStart(this._info);\n      return;\n    }\n    if (this._startTimer !== null) clearTimeout(this._startTimer);\n    this._startTimer = setTimeout(() => {\n      this._startTimer = null;\n      this._tryHubStart();\n    }, Number.isFinite(left) ? Math.min(100, Math.max(1, -left + 1)) : 100);\n  }\n\n  update(dt, snapshot, localInput) {\n    if (this.hub && this._pendingStart) this._tryHubStart();\n    if (!this.active || this._ended || this._reported || !this._started) return;\n    this._accumulator += Math.min(Math.max(Number(dt) || 0, 0), 1);\n    if (this._accumulator < NETWORK_RATE) return;\n    this._accumulator %= NETWORK_RATE;\n    if (this.isHost) {\n      if (snapshot == null) return;\n      this._lastSnapshot = snapshot;\n      this._send({ kind: 'world', value: snapshot });\n    } else {\n      this._send({ kind: 'input', value: localInput ?? {} }, this.hub ? this._info.host : undefined);\n    }\n  }\n\n  _send(payload, to) {\n    if (!this.active || this._ended) return false;\n    const packet = { dr: 1, seq: ++this._sendSequence, ...payload };\n    let text;\n    try { text = JSON.stringify(packet); } catch { this._rejected++; return false; }\n    if (byteLength(text) > PACKET_LIMIT) {\n      this._rejected++;\n      this._lastError = 'Network snapshot exceeds 16 KB. Reduce the number of serialized objects.';\n      return false;\n    }\n    if (this.hub) {\n      const sent = globalThis.AIHub.send(packet, { reliable: true, ...(to == null ? {} : { to }) });\n      if (sent) this._sent++;\n","exit_code":0,"status":"completed"}}
