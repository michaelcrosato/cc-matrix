{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='main.js'\ns=open(p).read().replace(\\\"const pad=navigator.getGamepads?.()[seat];\\\",\\\"const pad=navigator.getGamepads?.()[net?.active&&seat===net.localSeat?0:seat];\\\")\ns=s.replace(\\\"return c;}\\\\nfunction aiInput\\\", \\\"if(seat===(net?.active?net.localSeat:0)){const s=ships.find(a=>a.seat===seat);if(s&&pointer.active&&lastInput==='mouse')c.move=clamp((pointer.x-s.x)*3,-1,1);if(touchStart&&lastInput==='touch')c.move=clamp((touchStart.current-touchStart.start)/55,-1,1);}return c;}\\\\nfunction aiInput\\\")\ns=s.replace(\\\"if(action==='retry')startRun({coop:localCoop});\\\", \\\"if(action==='retry'&&\"'!net?.active)startRun({coop:localCoop});\")\ns=s.replace(\"if(net?.active)net.finish(score,won);\", \"if(net?.active&&net.isHost)net.finish(score,won);\")\ns=s.replace(\"onEnd(reason){stopped=true;mode='\"'ended';audio.setMuted(true);showScreen(null);textToast('ROUND COMPLETE');}\\\", \\\"onEnd(reason,details){audio.setMuted(true);if(net.hub){stopped=true;mode='ended';showScreen(null);textToast('ROUND COMPLETE');}else{if(reason==='finished'){score=details?.score??score;mode='playing';endRun(\"'!!details?.won);}else{mode='\"'defeat';\"'$('\"'#result-kicker').textContent='CONNECTION CLOSED';\"'$('\"'#result-title').textContent='WINGMATE DISCONNECTED';\"'$('\"'#result-score').textContent=String(score).padStart(6,'0');\"'$('\"'#result-detail').textContent='Open a new shift to play together again.';showScreen('results');}net.disconnect();audio.setMuted(false);}}\\\")\ns=s.replace(\\\"if(action==='title')title();\\\", \\\"if(action==='title'){if(net?.active&&\"'!net.hub)net.disconnect();title();}\")\ns=s.replace(\"$('\"'#touch-menu').classList.toggle('hidden',name\"'!==null);\", \"$('\"'#touch-menu').classList.toggle('hidden',name\"'!==null);$('\"'#prompt-footer').classList.toggle('hidden',name===null);\\\")\nopen(p,'w').write(s)\np='shell.html'