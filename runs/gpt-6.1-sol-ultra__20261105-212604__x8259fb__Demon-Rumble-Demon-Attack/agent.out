{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"ls -lh && cat network-browser-test.py | head -70 && sed -n '130,250p' network.js && sed -n '1,100p' audio.js\"","aggregated_output":"total 908K\ndrwxr-xr-x 2 micha micha 4.0K Nov  5 21:35 __pycache__\n-rw-r--r-- 1 micha micha  16K Nov  5 21:28 audio.js\n-rw-r--r-- 1 micha micha  898 Nov  5 21:34 build.mjs\n-rw-r--r-- 1 micha micha 7.5K Nov  5 21:35 gameplay-test-results.json\n-rw-r--r-- 1 micha micha  12K Nov  5 21:35 gameplay-test.py\n-rw-r--r-- 1 micha micha 163K Nov  5 21:35 gameplay.png\ndrwxr-xr-x 2 micha micha 4.0K Nov  5 21:26 hub-reference\n-rw-r--r-- 1 micha micha 5.7K Nov  5 21:35 hub-test.py\n-rw-r--r-- 1 micha micha  40K Nov  5 21:35 main.js\n-rw-r--r-- 1 micha micha 3.2K Nov  5 21:30 network-browser-test.py\n-rw-r--r-- 1 micha micha  14K Nov  5 21:30 network.js\n-rw-r--r-- 1 micha micha 5.4K Nov  5 21:29 network.test.mjs\ndrwxr-xr-x 7 micha micha 4.0K Nov  5 21:27 node_modules\n-rw-r--r-- 1 micha micha  15K Nov  5 21:27 package-lock.json\n-rw-r--r-- 1 micha micha  378 Nov  5 21:27 package.json\n-rw-r--r-- 1 micha micha 9.5K Nov  5 21:35 shell.html\n-rw-r--r-- 1 micha micha  20K Nov  5 21:35 style.css\n-rw-r--r-- 1 micha micha  174 Nov  5 21:26 title-selection.json\n-rw-r--r-- 1 micha micha 555K Nov  5 21:35 title.png\n-rw-r--r-- 1 micha micha 1.3K Nov  5 21:35 visual-check.py\n\"\"\"Standalone direct-connection smoke test; no server or physical controller needed.\"\"\"\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\n\n\ndef run():\n    failures = []\n    count = 0\n\n    def check(condition, name):\n        nonlocal count\n        count += 1\n        if not condition:\n            failures.append(name)\n\n    source = Path(__file__).with_name('network.js').read_text().replace('export class NetworkDirector', 'globalThis.NetworkDirector = class NetworkDirector')\n    with sync_playwright() as p:\n        browser = p.chromium.launch(headless=True)\n        context = browser.new_context()\n        host, guest = context.new_page(), context.new_page()\n        for page in (host, guest):\n            page.set_content('<title>Demon Rumble network check</title>')\n            page.add_script_tag(content=source)\n            page.evaluate('''() => {\n              window.starts=0; window.world=null; window.input=null; window.endInfo=null;\n              window.net = new NetworkDirector({\n                onStart:()=>starts++, onSnapshot:w=>world=w,\n                onRemoteInput:(v,s)=>input={v,s}, onEnd:(reason,details)=>endInfo={reason,details}\n              });\n            }''')\n        offer = host.evaluate('net.createOffer()')\n        check(offer.startswith('DR1:'), 'Host generates invite')\n        answer = guest.evaluate('(code)=>net.acceptOffer(code)', offer)\n        check(answer.startswith('DR1:'), 'Guest generates reply')\n        host.evaluate('(code)=>net.acceptAnswer(code)', answer)\n        try:\n            host.wait_for_function('starts === 1 && net.active', timeout=15000)\n            guest.wait_for_function('starts === 1 && net.active', timeout=15000)\n            check(True, 'Both peers connect and start once')\n        except Exception:\n            check(False, 'Both peers connect and start once')\n        host.evaluate('net.update(.1,{score:73,wave:2},{})')\n        guest.wait_for_function('world?.score === 73', timeout=5000)\n        check(guest.evaluate('world.wave === 2'), 'Host world reaches guest')\n        guest.evaluate('net.update(.1,null,{axis:-.5,fire:true})')\n        host.wait_for_function('input?.v.fire', timeout=5000)\n        check(host.evaluate('input.s === 1 && input.v.axis === -.5'), 'Guest input reaches correct host seat')\n        host.evaluate('net.finish(73,true)')\n        guest.wait_for_function('endInfo !== null', timeout=5000)\n        check(guest.evaluate('endInfo.reason === \"finished\" && endInfo.details.won && endInfo.details.score === 73'), 'Guest receives final outcome')\n        check(host.evaluate('net.active && net.status === \"finished\"'), 'Finished session retains role until disconnect')\n        for page in (host, guest):\n            page.evaluate('net.disconnect()')\n        check(host.evaluate('!net.active && net.status === \"offline\"'), 'Disconnect releases session')\n        browser.close()\n    return count, failures\n\n\nif __name__ == '__main__':\n    try:\n        count, failures = run()\n    except Exception as error:\n        print(f'FAIL: WebRTC smoke test: {error}')\n        raise SystemExit(1)\n    for failure in failures:\n        print(f'FAIL: {failure}')\n    print(f'{count} direct-network checks, {len(failures)} failures')\n    raise SystemExit(bool(failures))\n      if (sent) this._sent++;\n      return sent;\n    }\n    if (this._channel?.readyState !== 'open') return false;\n    // Let WebRTC drain its reliable queue before adding another obsolete world.\n    if (payload.kind === 'world' && this._channel.bufferedAmount > 256000) return false;\n    try { this._channel.send(text); this._sent++; return true; }\n    catch (error) { this._lastError = error.message; return false; }\n  }\n\n  _receive(data, from) {\n    if (this._ended || !data || data.dr !== 1 || !Number.isFinite(data.seq)) return;\n    if (this.hub && !this.players.some(p => p.id === from) && from !== this._info.host) return;\n    const previous = this._receiveSequences.get(from) ?? -1;\n    if (data.seq <= previous) return;\n    this._receiveSequences.set(from, data.seq);\n    this._received++;\n    if (data.kind === 'world' && !this.isHost && from === this._info.host) {\n      this.callbacks.onSnapshot(data.value);\n    } else if (data.kind === 'input' && this.isHost && from !== this._info.host && data.value && typeof data.value === 'object') {\n      this.callbacks.onRemoteInput(data.value, from);\n    } else if (data.kind === 'finish' && !this.isHost && from === this._info.host && !this.hub) {\n      this.end('finished', { score: data.score, won: data.won });\n    }\n  }\n\n  finish(score, won = false) {\n    if (!this.active || !this.isHost || this._reported || this._ended) return;\n    const safeScore = Number.isFinite(Number(score)) ? Number(score) : 0;\n    if (this.hub) {\n      const ids = this.players.map(p => p.id);\n      globalThis.AIHub.finish({\n        standings: [ids],\n        scores: Object.fromEntries(ids.map(id => [id, safeScore])),\n        won: Boolean(won),\n        stats: Object.fromEntries(ids.map(id => [id, { 'Team score': safeScore }]))\n      });\n    } else {\n      if (this._lastSnapshot != null) this._send({ kind: 'world', value: this._lastSnapshot });\n      this._send({ kind: 'finish', score: safeScore, won: Boolean(won) });\n    }\n    this._reported = true;\n    this._status = 'finished';\n  }\n\n  end(reason = 'ended', details) {\n    if (this._ended) return;\n    this._ended = true;\n    this._pendingStart = false;\n    this._status = 'ended';\n    if (this._startTimer !== null) clearTimeout(this._startTimer);\n    this._startTimer = null;\n    this.callbacks.onEnd(reason, details);\n  }\n\n  _assertStandalone() {\n    if (globalThis.AIHub?.active || this.hub) throw new Error('AI Hub manages all connections during a session.');\n    if (!globalThis.RTCPeerConnection) throw new Error('Direct online play needs WebRTC in a secure browser page.');\n  }\n\n  _newPeer(isHost) {\n    this._assertStandalone();\n    this.disconnect();\n    this._transport = 'peer';\n    this._status = isHost ? 'creating-offer' : 'creating-answer';\n    this._ended = false;\n    this._reported = false;\n    this._started = false;\n    this._accumulator = 0;\n    this._sendSequence = 0;\n    this._receiveSequences.clear();\n    this._removed.clear();\n    this._info = {\n      source: 'peer', mode: 'shared-world', me: isHost ? 0 : 1, host: 0, isHost, server: false,\n      players: [{ id: 0, name: 'Pilot 1', color: '#5de0e7' }, { id: 1, name: 'Pilot 2', color: '#ffb64f' }]\n    };\n    const peer = new RTCPeerConnection({\n      iceServers: [{ urls: 'stun:stun.l.google.com:19302' }, { urls: 'stun:stun.cloudflare.com:3478' }],\n      iceCandidatePoolSize: 0\n    });\n    this._peer = peer;\n    peer.ondatachannel = ({ channel }) => this._attachChannel(channel);\n    peer.onconnectionstatechange = () => {\n      if (peer !== this._peer) return;\n      if (peer.connectionState === 'failed') {\n        this._lastError = 'Connection failed. Check that both codes were exchanged completely; strict NAT may require AI Hub instead.';\n        this._status = 'failed';\n        this.end('connection-failed');\n      } else if (peer.connectionState === 'disconnected') {\n        this._status = 'reconnecting';\n      } else if (peer.connectionState === 'connected' && this._channel?.readyState === 'open') {\n        this._status = 'connected';\n      }\n    };\n    return peer;\n  }\n\n  _attachChannel(channel) {\n    this._channel = channel;\n    channel.onopen = () => {\n      if (channel !== this._channel || this._ended) return;\n      this._status = 'connected';\n      this._started = true;\n      this.callbacks.onStart(this._info);\n    };\n    channel.onmessage = ({ data }) => {\n      if (typeof data !== 'string' || data.length > PACKET_LIMIT) return;\n      try { this._receive(JSON.parse(data), this.isHost ? 1 : 0); }\n      catch { this._rejected++; }\n    };\n    channel.onclose = () => {\n      if (channel !== this._channel || this._ended) return;\n      this.callbacks.onLeave(this.isHost ? 1 : 0, 'disconnected');\n      this.end('disconnected');\n    };\n    channel.onerror = () => { this._lastError = 'The direct connection encountered a data-channel error.'; };\n  }\n\n  async _gather(peer) {\n    if (peer.iceGatheringState === 'complete') return;\n    await new Promise((resolve) => {\n// Demon Rumble: every sound is synthesized; no samples, speech service or audio files.\nconst clamp01 = value => Math.max(0, Math.min(1, Number(value) || 0));\nconst frequency = midi => 440 * 2 ** ((midi - 69) / 12);\n\nexport class AudioDirector {\n  constructor(options = {}) {\n    this.context = null;\n    this.musicVolume = 0.1;\n    this.sfxVolume = 0.75;\n    this.muted = false;\n    this.paused = false;\n    this.intensity = 0;\n    this.step = 0;\n    this.nextBeat = 0;\n    this.events = {};\n    this.scheduledNotes = 0;\n    this.lastEvents = {};\n    this.voiceSerial = 0;\n    this.noiseSeed = 0x51f15e;\n    if (options.context) this._initialize(options.context);\n  }\n\n  _initialize(context) {\n    if (this.context) return;\n    this.context = context;\n    this.master = context.createGain();\n    this.master.gain.value = this.muted ? 0 : 0.72;\n    this.compressor = context.createDynamicsCompressor();\n    this.compressor.threshold.value = -14;\n    this.compressor.knee.value = 12;\n    this.compressor.ratio.value = 5;\n    this.compressor.attack.value = 0.003;\n    this.compressor.release.value = 0.16;\n    this.analyser = context.createAnalyser();\n    this.analyser.fftSize = 256;\n    this.master.connect(this.compressor);\n    this.compressor.connect(this.analyser);\n    this.analyser.connect(context.destination);\n    this.musicBus = context.createGain();\n    this.sfxBus = context.createGain();\n    this.musicBus.gain.value = this.musicVolume;\n    this.sfxBus.gain.value = this.sfxVolume;\n    this.musicBus.connect(this.master);\n    this.sfxBus.connect(this.master);\n    // A short, filtered tape echo gives melodies depth without muddying shots.\n    this.echo = context.createDelay(1);\n    this.echo.delayTime.value = 3 / 22;\n    this.echoFilter = context.createBiquadFilter();\n    this.echoFilter.type = 'lowpass';\n    this.echoFilter.frequency.value = 1900;\n    this.echoFeedback = context.createGain();\n    this.echoFeedback.gain.value = 0.22;\n    this.echoReturn = context.createGain();\n    this.echoReturn.gain.value = 0.16;\n    this.echo.connect(this.echoFilter);\n    this.echoFilter.connect(this.echoFeedback);\n    this.echoFeedback.connect(this.echo);\n    this.echoFilter.connect(this.echoReturn);\n    this.echoReturn.connect(this.musicBus);\n    const frames = Math.ceil(context.sampleRate * 0.5);\n    this.noiseBuffer = context.createBuffer(1, frames, context.sampleRate);\n    const samples = this.noiseBuffer.getChannelData(0);\n    let seed = this.noiseSeed;\n    for (let index = 0; index < frames; index++) {\n      seed = (Math.imul(seed, 1664525) + 1013904223) | 0;\n      samples[index] = (seed >>> 0) / 2147483648 - 1;\n    }\n    this.nextBeat = context.currentTime + 0.04;\n  }\n\n  async unlock() {\n    if (!this.context) {\n      const Context = globalThis.AudioContext || globalThis.webkitAudioContext;\n      if (!Context) return false;\n      this._initialize(new Context());\n    }\n    if (this.context.state === 'suspended' && typeof this.context.startRendering !== 'function') {\n      await this.context.resume();\n    }\n    this.paused = false;\n    this.nextBeat = Math.max(this.nextBeat, this.context.currentTime + 0.015);\n    return this.context.state !== 'closed';\n  }\n\n  _gain(parameter, value) {\n    if (!parameter || !this.context || this.context.state === 'closed') return;\n    parameter.cancelScheduledValues(this.context.currentTime);\n    parameter.setTargetAtTime(value, this.context.currentTime, 0.025);\n  }\n\n  setMusic(value) {\n    this.musicVolume = clamp01(value);\n    this._gain(this.musicBus?.gain, this.musicVolume);\n  }\n\n  setSfx(value) {\n    this.sfxVolume = clamp01(value);\n    this._gain(this.sfxBus?.gain, this.sfxVolume);\n  }\n\n","exit_code":0,"status":"completed"}}
