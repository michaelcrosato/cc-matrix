{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc 'head -75 Attack-of-the-Timelout-Attack-of-the-Timelord-gpt-6.1-sol-ultra-20261106-022923/tests/audio.py && head -65 Attack-of-the-Timelout-Attack-of-the-Timelord-gpt-6.1-sol-ultra-20261106-022923/tests/hub/run-harness.py && tail -35 Attack-of-the-Timelout-Attack-of-the-Timelord-gpt-6.1-sol-ultra-20261106-022923/tests/hub/run-peer.py && tail -20 Attack-of-the-Timelout-Attack-of-the-Timelord-gpt-6.1-sol-ultra-20261106-022923/tests/state.test.mjs && tail -20 Attack-of-the-Timelout-Attack-of-the-Timelord-gpt-6.1-sol-ultra-20261106-022923/tests/engine.test.mjs && head -12 Attack-of-the-Timelout-Attack-of-the-Timelord-gpt-6.1-sol-ultra-20261106-022923/tests/hub/network.test.mjs'","aggregated_output":"\"\"\"Offline Web Audio verification; prints failures and one count, no listening claim.\"\"\"\n\nimport json\nfrom pathlib import Path\n\nfrom playwright.sync_api import Error as PlaywrightError\nfrom playwright.sync_api import sync_playwright\n\nROOT = Path(__file__).resolve().parents[1]\nsource = (ROOT / \"src/audio/audio.js\").read_text().replace(\"export \", \"\")\nfailures = []\nchecks = 0\nwith sync_playwright() as p:\n    browser = p.chromium.launch(headless=True)\n    try:\n        page = browser.new_page()\n        result = page.evaluate(\n            \"async () => {\" + source + \"\\nreturn await verifyAudioSignals();}\"\n        )\n        for bus in [\"music\", \"effects\", \"voice\"]:\n            signal = result[bus]\n            for label, ok in [\n                (\"finite output\", signal[\"finite\"]),\n                (\"nonzero signal\", signal[\"rms\"] > 0.00001),\n                (\"peak below clipping\", signal[\"peak\"] < 0.99),\n                (\"muted bus silent\", result[bus + \"Muted\"] < 0.000001),\n            ]:\n                checks += 1\n                if not ok:\n                    failures.append(bus + \": \" + label)\n        checks += 1\n        if result[\"defaults\"][\"music\"] != 0.1:\n            failures.append(\"music default must be 0.1\")\n        checks += 1\n        if result[\"terminatedPeak\"] > 0.000001:\n            failures.append(\"terminated voice sources continued\")\n        lifecycle = page.evaluate(\n            \"async () => {\"\n            + source\n            + \"\"\"\n          const ctx = new OfflineAudioContext(1, 48000, 48000);\n          const audio = createAudio({context:ctx});\n          audio.event('fire'); audio.speak('Your clock is mine!');\n          const before=audio.snapshot(); audio.pause(true); const paused=audio.snapshot();\n          audio.event('fire'); audio.speak('No speech'); const silent=audio.snapshot();\n          audio.pause(false); audio.setScene('boss'); audio.setVolumes({music:.3,effects:.2,voice:0});\n          await audio.destroy(); audio.event('hit'); audio.speak('No speech');\n          return {before,paused,silent,after:audio.snapshot()};\n        }\"\"\"\n        )\n        for label, ok in [\n            (\"live sources scheduled\", lifecycle[\"before\"][\"activeSources\"] > 0),\n            (\"pause cancels sources\", lifecycle[\"paused\"][\"activeSources\"] == 0),\n            (\n                \"paused events skipped\",\n                lifecycle[\"silent\"][\"effects\"] == lifecycle[\"paused\"][\"effects\"],\n            ),\n            (\n                \"paused voice skipped\",\n                lifecycle[\"silent\"][\"syllables\"] == lifecycle[\"paused\"][\"syllables\"],\n            ),\n            (\"destroy terminates\", lifecycle[\"after\"][\"terminated\"]),\n            (\"destroy cancels sources\", lifecycle[\"after\"][\"activeSources\"] == 0),\n            (\n                \"volume changes apply\",\n                lifecycle[\"after\"][\"volumes\"]\n                == {\"music\": 0.3, \"effects\": 0.2, \"voice\": 0},\n            ),\n        ]:\n            checks += 1\n            if not ok:\n                failures.append(label)\n        page.set_content('<canvas id=\"screen\"></canvas>')\n        page.add_script_tag(\n            path=str(ROOT / \"vendor/engine-repo/dist/handoff/my-3d2dge.js\")\n\"\"\"Run the unmodified official Hub harness against the delivered HTML.\"\"\"\nimport functools\nimport http.server\nimport json\nimport sys\nimport threading\nfrom pathlib import Path\nfrom urllib.parse import urlencode\n\nfrom playwright.sync_api import sync_playwright\n\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *_):\n        pass\n\n\ndef run(artifact):\n    artifact = Path(artifact).resolve()\n    dev = Path(__file__).resolve().parents[2]\n    root = artifact.parent\n    reports = []\n    failures = []\n    handler = functools.partial(QuietHandler, directory=str(root))\n    server = http.server.ThreadingHTTPServer((\"127.0.0.1\", 0), handler)\n    thread = threading.Thread(target=server.serve_forever, daemon=True)\n    thread.start()\n    base = f\"http://127.0.0.1:{server.server_address[1]}\"\n    harness = (dev / \"tests/hub/harness.html\").relative_to(root).as_posix()\n    scenarios = [\n        {\"players\": 2},\n        {\"players\": 4, \"latency\": 150, \"jitter\": 50, \"loss\": 5},\n        {\"players\": 4, \"latency\": 150, \"jitter\": 50, \"loss\": 5, \"scenario\": \"host-leave\"},\n        {\"players\": 2, \"scenario\": \"server\"},\n    ]\n    try:\n        with sync_playwright() as p:\n            browser = p.chromium.launch(headless=True, args=[\"--enable-webgl\", \"--use-gl=angle\", \"--use-angle=swiftshader\", \"--enable-unsafe-swiftshader\"])\n            for parameters in scenarios:\n                page = browser.new_page(viewport={\"width\": 1280, \"height\": 800})\n                query = {\"game\": f\"/{artifact.name}\", \"auto\": 1, \"seed\": 1701, **parameters}\n                try:\n                    page.goto(f\"{base}/{harness}?{urlencode(query)}\", wait_until=\"domcontentloaded\")\n                    page.wait_for_function(\"document.body.dataset.complete === 'true'\", timeout=100000)\n                    result = page.evaluate(\"window.__hubCheck\")\n                    reports.append({\"parameters\": query, \"result\": result})\n                    if not result or not result.get(\"pass\"):\n                        failures.append(f\"Hub {parameters}: \" + \"; \".join(c[\"name\"] + \": \" + c.get(\"detail\", \"\") for c in (result or {}).get(\"checks\", []) if not c[\"pass\"]))\n                except Exception as error:\n                    failures.append(f\"Hub {parameters}: {error}\")\n                    reports.append({\"parameters\": query, \"error\": str(error)})\n                finally:\n                    page.close()\n            browser.close()\n    finally:\n        server.shutdown()\n        server.server_close()\n        thread.join()\n    (dev / \"test-artifacts/hub-results.json\").write_text(json.dumps({\"revision\": \"35a1047f2067b2af3de3943f0fe452f39105d869\", \"reports\": reports}, indent=2))\n    for failure in failures:\n        print(f\"FAIL {failure}\")\n    print(f\"Hub harness: {len(scenarios) - len(failures)}/{len(scenarios)} passed\")\n    return bool(failures)\n\n\n            host.evaluate(\"net.leave()\")\n            guest.wait_for_function(\"net.roomState === 'disconnected'\")\n            check(\"host leave terminates the guest session\", guest.evaluate(\"!net.started && state.ends.some(e=>e.reason==='host-left')\"))\n            failed = False\n            try:\n                guest.evaluate(\"() => net.joinRoom('ZZZZZZZZ')\")\n            except Exception as error:\n                failed = any(text in str(error) for text in [\"No room answered\", \"data link failed\", \"connection closed\"])\n            check(\"failed join gives an actionable error\", failed)\n            guest.evaluate(\"net.leave()\")\n            check(\"failed join can return offline\", guest.evaluate(\"net.roomState === 'offline' && !net.peer\"))\n    except Exception as error:\n        if \"run is in progress\" in str(error):\n            result[\"checks\"].append({\"name\": \"active roster lock rejects late joins\", \"pass\": True, \"detail\": \"Host rejected late join\"})\n        else:\n            result[\"error\"] = str(error)\n    finally:\n        with contextlib.suppress(Exception):\n            for page in pages:\n                page.evaluate(\"net.leave()\")\n            browser.close()\n        server.shutdown()\n        server.server_close()\n        thread.join()\n    result[\"pass\"] = \"error\" not in result and len(result[\"checks\"]) >= 13 and all(c[\"pass\"] for c in result[\"checks\"])\n    (dev / \"test-artifacts/peer-results.json\").write_text(json.dumps(result, indent=2))\n    if not result[\"pass\"]:\n        print(\"FAIL standalone online: \" + result.get(\"error\", \"; \".join(c[\"name\"] for c in result[\"checks\"] if not c[\"pass\"])))\n    print(f\"Standalone public WebRTC: {sum(c['pass'] for c in result['checks'])}/{len(result['checks'])} checks passed\")\n    return not result[\"pass\"]\n\n\nif __name__ == \"__main__\":\n    import contextlib\n    sys.exit(run())\n  test('one hit event with overlapping hazards and visible invulnerability',()=>{const w=bare();w.players[0].invuln=0;for(let i=0;i<4;i++)spawnThreat(w,'missile',{x:0,y:240,warning:0});stepWorld(w);assert.equal(w.players[0].hp,2);assert.equal(w.events.filter(e=>e.type==='hit').length,1);assert.ok(w.players[0].invuln>2);assert.equal(hitPlayer(w,'p1'),false);assert.equal(w.threats.length,0);});\n  test('solo zero integrity ends and once-only outcome cancels hazards',()=>{const w=bare();for(let i=0;i<3;i++){w.players[0].invuln=0;hitPlayer(w,'p1');}assert.equal(w.outcome,'defeat');assert.equal(w.threats.length,0);assert.equal(finishWorld(w,'victory'),false);play(w,3);assert.equal(w.phase,'results');const tick=w.tick;stepWorld(w,{p1:{fire:true}});assert.equal(w.tick,tick);});\n  test('co-op disabled seat stays disabled until wave-clear repair',()=>{const w=bare({players:[{id:'a'},{id:'b'}]});for(let i=0;i<3;i++){w.players[0].invuln=0;hitPlayer(w,'a');}assert.equal(w.outcome,null);assert.equal(w.players[0].hp,0);stepWorld(w,{a:{fire:true,move:1}});assert.equal(w.shots.length,0);w.enemies=[];stepWorld(w);assert.equal(w.phase,'intermission');assert.equal(w.players[0].hp,1);assert.equal(w.players[1].hp,3);});\n  test('departed seats cannot keep team alive or block targeting',()=>{const w=bare({players:[{id:'a'},{id:'b'}]});removePlayer(w,'b');assert.equal(w.players[1].connected,false);for(let i=0;i<3;i++){w.players[0].invuln=0;hitPlayer(w,'a');}assert.equal(w.outcome,'defeat');});\n  test('fair targeting rotates live seats with stable ordering',()=>{const w=bare({players:[{id:'z'},{id:'a'},{id:'q'}]});const ids=Array.from({length:6},()=>spawnThreat(w,'missile',{warning:0}).targetId);assert.deepEqual(ids,['a','q','z','a','q','z']);});\n  test('mine steering is bounded and follows host-selected seat',()=>{const w=bare();w.players[0].x=300;const t=spawnThreat(w,'mine',{x:-200,y:-100,warning:0});stepWorld(w);assert.ok(t.vx>0&&t.vx<=DEFAULT_TUNING.mineTurnRate*STEP+.00001);assert.equal(t.targetId,'p1');});\n  test('hunter commits once to warned prediction instead of continuous homing',()=>{const w=bare();w.players[0].vx=300;const t=spawnThreat(w,'hunter',{x:-200,y:-150,warning:.1});const warned=t.targetX;play(w,.15,{p1:{move:-1}});const vx=t.vx;play(w,.3,{p1:{move:1}});assert.equal(t.targetX,warned);assert.equal(t.vx,vx);assert.ok(t.committed);});\n  test('airborne rollers are interceptable, grounded rollers are not',()=>{const w=bare();w.players[0].x=150;const t=spawnThreat(w,'roller',{x:150,y:150,warning:0});assert.ok(t);w.shots=[{id:9999,owner:'p1',x:150,y:165,py:165}];stepWorld(w,{},.02);assert.equal(w.stats.intercepts,1);const g=spawnThreat({...w,lastRoller:-100},'roller',{x:150,y:240,warning:0,grounded:true,life:2,left:40,right:250,dir:1});assert.ok(g);w.threats=[g];w.players[0].x=-200;w.shots=[{id:9998,owner:'p1',x:150,y:245,py:245}];stepWorld(w,{},.02);assert.equal(w.stats.intercepts,1);assert.ok(w.threats.some(x=>x.id===g.id));});\n  test('roller sweep has reachable exit and finite expiry without brake',()=>{for(const x of [-440,-260,0,260,440]){const w=bare();w.players[0].x=x;const t=spawnThreat(w,'roller',{y:-120,warning:.8});assert.ok(t,`roller at ${x}`);assert.ok(t.safeX<t.left-25||t.safeX>t.right+25);const time=(240-t.y)/145+t.warning;assert.ok(Math.abs(t.safeX-x)<DEFAULT_TUNING.playerSpeed*time);play(w,8,{p1:{targetX:t.safeX}});assert.equal(w.stats.hits,0);assert.equal(w.threats.length,0);assert.equal(w.charge,0);}});\n  test('simultaneous brake requests produce one activation and consume shared meter',()=>{const w=bare({players:[{id:'a'},{id:'b'}]});w.charge=100;stepWorld(w,{a:{brake:true},b:{brake:true}});assert.equal(w.events.filter(e=>e.type==='brake').length,1);assert.equal(w.charge,0);assert.equal(w.stats.brakes,1);w.charge=100;play(w,3,{a:{brake:true},b:{brake:true}});assert.equal(w.stats.brakes,1);stepWorld(w,{a:{brake:false},b:{brake:false}});stepWorld(w,{a:{brake:true}});assert.equal(w.stats.brakes,2);});\n  test('brake slows only hostile movement and clocks; no catch-up burst',()=>{const a=bare(),b=bare();a.charge=100;spawnThreat(a,'missile',{x:300,y:0,warning:0});spawnThreat(b,'missile',{x:300,y:0,warning:0});stepWorld(a,{p1:{brake:true,move:1,fire:true}});stepWorld(b,{p1:{move:1,fire:true}});assert.equal(a.players[0].x,b.players[0].x);assert.equal(a.shots[0].y,b.shots[0].y);assert.ok(Math.abs(a.threats[0].y/b.threats[0].y-.35)<.00001);a.fireClock=.1;play(a,1.7);assert.equal(a.brake,0);assert.ok(a.threats.length<=2);});\n  test('wave clear dissolves all ordnance and transitions promptly',()=>{const w=bare();spawnThreat(w,'mine');w.shots.push({id:9999,owner:'p1',x:300,y:0,py:0});w.enemies=[];stepWorld(w);assert.equal(w.phase,'intermission');assert.equal(w.threats.length,0);assert.equal(w.shots.length,0);play(w,3.3);assert.equal(w.phase,'playing');assert.equal(w.wave,1);});\n  test('same seed and actions produce identical canonical state',()=>{const a=createWorld({seed:123}),b=createWorld({seed:123});for(let i=0;i<4000;i++){const actions={p1:{move:Math.sin(i*.003),fire:i%3!==0,brake:i%500===0}};stepWorld(a,actions);stepWorld(b,actions);}assert.deepEqual(a,b);const c={};applySnapshot(c,getSnapshot(a));assert.deepEqual(c,a);});\n  test('dev jump/refill marks run and reset copies immutable defaults',()=>{const w=createWorld();jumpEncounter(w,8,2);assert.equal(w.modified,true);assert.equal(w.phase,'finale');assert.equal(w.bossPhase,2);w.tuning.playerSpeed=600;resetTuning(w);assert.equal(w.tuning.playerSpeed,DEFAULT_TUNING.playerSpeed);refillWorld(w);assert.equal(w.charge,100);assert.equal(w.players[0].hp,3);const inherited=createWorld({tuning:{playerSpeed:600}});assert.equal(inherited.modified,true);});\n  test('legitimate full campaign seed 1982 covers every encounter and ends once',()=>{const w=createWorld({seed:1982});while(w.time<1400&&w.phase!=='results')stepWorld(w,{p1:autoPilot(w,'p1')});assert.equal(w.outcome,'victory');assert.equal(w.stats.waveClears,8);assert.equal(w.stats.bossPhases,3);assert.equal(w.stats.visited.length,11);assert.deepEqual(new Set(w.stats.threatsSeen),new Set(['missile','mine','roller','hunter']));assert.ok(w.stats.intercepts>20);assert.ok(w.stats.brakes>0);assert.ok(w.score>1200);assert.equal(w.modified,false);assert.equal(w.invulnerable,undefined);assert.equal(w.demo,false);assert.equal(w.threats.length,0);assert.equal(w.enemies.length,0);assert.equal(w.players[0].hp>0,true);});\n  test('four-player campaign uses same rules and reaches one shared victory',()=>{const w=createWorld({seed:77,players:['a','b','c','d'].map(id=>({id}))});while(w.time<1400&&w.phase!=='results')stepWorld(w,Object.fromEntries(w.players.map(p=>[p.id,autoPilot(w,p.id)])));assert.equal(w.outcome,'victory');assert.equal(w.stats.waveClears,8);assert.equal(w.stats.bossPhases,3);assert.equal(w.stats.visited.length,11);assert.equal(w.modified,false);assert.ok(w.players.some(p=>p.hp>0));});\n  return {count,failures};\n}\n\nif(import.meta.url===`file://${process.argv[1]}`){const result=runStateTests();for(const failure of result.failures)console.error(failure);console.log(`${result.count-result.failures.length}/${result.count} state checks passed`);process.exitCode=result.failures.length?1:0;}\nconst E=globalThis.My3D2dge;\n\nexport function runEngineTests(){\n  let count=0;const failures=[];const active=[];\n  const test=(name,fn)=>{count++;try{fn();}catch(error){failures.push(`${name}: ${error.message}`);}finally{for(const game of active.splice(0))game.dispose();}};\n  const make=(draw,seed=1982)=>{\n    const game=new E.Game({id:`timelout-engine-test-${seed}-${draw}`,headless:true,draw,view:'overhead',res:[1066,600],expand:false,input:{left:['KeyA','ArrowLeft'],right:['KeyD','ArrowRight'],up:['KeyW','ArrowUp'],down:['KeyS','ArrowDown'],fire:['Space']}});active.push(game);game.cam.smooth=0;game.lights.enabled=false;\n    const world=createWorld({seed}),renderer=new Renderer(game);let scripted=true;\n    game.start({update(dt){game.focus(0,0,0);const action=scripted?autoPilot(world,'p1'):{move:game.input.move()[0],fire:game.input.down('fire')};stepWorld(world,{p1:action},dt);renderer.update(dt);renderer.events(world.events);},draw(r){renderer.draw(r,world,{hitboxes:true,trajectories:true});}});\n    return {game,world,renderer,setScripted(value){scripted=value;}};\n  };\n  test('native exact 120Hz clock calls canonical simulation and renders without errors',()=>{const {game,world}=make(true);game.advance(3);assert.equal(world.tick,360);assert.ok(Math.abs(world.time-3)<1e-10);assert.equal(world.phase,'playing');assert.deepEqual(game.errors,[]);});\n  test('native drawing on/off leaves canonical state identical',()=>{const a=make(true,84),b=make(false,84);for(let i=0;i<60;i++){a.game.advance(.5);b.game.advance(.5);}assert.deepEqual(a.world,b.world);assert.deepEqual(a.game.errors,[]);assert.deepEqual(b.game.errors,[]);});\n  test('pause holds world; single canonical step advances exactly one tick while paused',()=>{const {game,world}=make(true);game.advance(4);const tick=world.tick;assert.equal(game.pause('player'),true);game.advance(1);assert.equal(world.tick,tick);stepWorld(world,{p1:{move:1,fire:true}});assert.equal(world.tick,tick+1);assert.equal(game.paused,true);game.advance(.5);assert.equal(world.tick,tick+1);game.resume();game.advance(1);assert.equal(world.tick,tick+121);assert.deepEqual(game.errors,[]);});\n  test('native test input moves and fires through normal action mapping',()=>{const q=make(false);q.setScripted(false);q.game.advance(3);q.game.input.hold('right');q.game.input.hold('fire');q.game.advance(.4);assert.ok(q.world.players[0].x>100);assert.ok(q.world.shots.length>0);const x=q.world.players[0].x;q.game.input.hold('right',false);q.game.input.hold('fire',false);q.game.advance(.1);assert.equal(q.world.players[0].x,x);});\n  test('all threat, disabled machine and finale presentations draw with actual native API',()=>{const {game,world,renderer}=make(true);game.advance(3);jumpEncounter(world,7);for(const type of ['missile','mine','roller','hunter'])spawnThreat(world,type,{x:0,y:0,warning:1});game.advance(.01);const roller=world.threats.find(t=>t.type==='roller');if(roller){roller.grounded=true;roller.y=240;roller.life=2;game.advance(.01);}world.players[0].hp=0;game.advance(.01);for(let phase=0;phase<3;phase++){jumpEncounter(world,8,phase);game.advance(.01);world.boss.vulnerable=true;game.advance(.01);world.boss.vulnerable=false;game.advance(.01);}renderer.events([{id:9999,type:'brake'},{id:10000,type:'hit',x:0,y:240}]);game.advance(.01);assert.deepEqual(game.errors,[]);});\n  test('whole normal campaign runs to victory on native game.advance with drawing enabled',()=>{const {game,world}=make(true,1982);while(world.time<1400&&world.phase!=='results')game.advance(1);assert.equal(world.outcome,'victory');assert.equal(world.stats.waveClears,8);assert.equal(world.stats.bossPhases,3);assert.equal(world.modified,false);assert.ok(world.stats.brakes>0);assert.ok(world.stats.intercepts>20);assert.deepEqual(game.errors,[]);});\n  return {count,failures};\n}\nif(import.meta.url===`file://${process.argv[1]}`){const result=runEngineTests();for(const failure of result.failures)console.error(failure);console.log(`${result.count-result.failures.length}/${result.count} engine checks passed`);process.exitCode=result.failures.length?1:0;}\nimport assert from 'node:assert/strict';\nimport {test,afterEach} from 'node:test';\nimport fs from 'node:fs';\nimport {NetworkSession} from '../../src/network/session.js';\nimport {decodeWorld,encodeWorld,splitWorld,packetBytes,validInput,roomCode,makeRoomCode,validRoomCode} from '../../src/network/protocol.js';\n\nconst world=()=>({tick:10,time:1,hostileTime:1,phase:'playing',phaseTime:1,wave:0,bossPhase:0,score:25,charge:50,brake:0,cooldown:0,seed:3,outcome:null,modified:false,demo:false,\n players:[{id:0,name:'Pilot 1',x:0,hp:3,invuln:0,vx:0,recoil:0,connected:true,colorIndex:0},{id:1,name:'Pilot 2',x:130,hp:2,invuln:1,vx:0,recoil:0,connected:true,colorIndex:1}],\n enemies:[{id:4,kind:2,x:34,y:-100,hp:1,angle:0,arrival:1,delay:0}],\n threats:[{id:5,type:'roller',x:20,y:240,vx:80,vy:0,r:11,warning:0,age:3,targetId:0,targetX:0,targetY:240,grounded:true,left:-80,right:150,safeX:-150,life:2,committed:true,angle:2}],\n shots:[{id:6,owner:1,x:130,y:50}],boss:null,stats:{intercepts:3},subtitle:'Your minutes are numbered.'});\nconst input=(q=0,b=0)=>({t:'a',g:0,q,m:1,x:null,f:true,b});\n","exit_code":0,"status":"completed"}}
