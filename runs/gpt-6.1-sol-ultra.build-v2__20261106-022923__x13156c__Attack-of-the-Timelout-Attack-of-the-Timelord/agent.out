 40, step: 1 },\n]);\n\nexport const PATHS = Object.freeze({\n  curlLeft: [[-40,-322],[-240,-245],[-350,-140],[-165,-58],[35,-160],[-35,-210]],\n  curlRight: [[40,-322],[240,-245],[350,-140],[165,-58],[-35,-160],[35,-210]],\n  braidLeft: [[-85,-322],[320,-260],[280,-95],[-240,-75],[-300,-195],[-60,-205]],\n  braidRight: [[85,-322],[-320,-260],[-280,-95],[240,-75],[300,-195],[60,-205]],\n  loopLeft: [[-100,-322],[-340,-200],[-170,-75],[75,-125],[300,-200],[-80,-200]],\n  loopRight: [[100,-322],[340,-200],[170,-75],[-75,-125],[-300,-200],[80,-200]],\n});\nconst formation = (count, paths, rows=3, spread=700, stagger=0.15) => ({ count, paths, rows, spread, stagger, arrivalSpeed: 0.17, sway: 35 });\nexport const WAVES = Object.freeze([\n  { id:'first-minute',name:'A MINOR INCONVENIENCE',cue:'SLIDE • HOLD FIRE • SHOOT THE WHITE DARTS',nominal:45,formation:formation(16,['curlLeft','curlRight'],2,650,0.23),mix:['missile'],interval:1.05,firstLaunch:3.8,warning:0.65,line:'One tiny machine? I have socks older than your century.',clear:'You have scratched my punctuality.',emotion:'gloat' },\n  { id:'red-letter',name:'RED LETTER DAY',cue:'RED ORBS CURVE TOWARD YOU. BAIT, THEN INTERCEPT.',nominal:50,formation:formation(20,['curlRight','loopLeft'],3,680,0.2),mix:['mine','missile','missile','mine'],interval:0.98,firstLaunch:2.8,warning:0.75,line:'These little orbs adore you. Do not encourage them.',clear:'Stop charging that vulgar time brake!',emotion:'gloat' },\n  { id:'ground-rules',name:'GROUND RULES',cue:'GREEN CROSSES LAND AND SWEEP. ESCAPE THE MARKED SEGMENT.',nominal:60,formation:formation(22,['loopLeft','loopRight'],3,700,0.18),mix:['roller','missile','mine','missile','missile'],interval:0.95,firstLaunch:2.5,warning:0.85,line:'I have brought a very unreasonable lawn mower.',clear:'That was a VERY expensive lawn mower.',emotion:'annoyed' },\n  { id:'future-tense',name:'FUTURE TENSE',cue:'DIAMONDS MARK YOUR FUTURE. CHANGE DIRECTION AFTER THE TELL.',nominal:60,formation:formation(24,['braidLeft','curlRight'],3,710,0.19),mix:['hunter','missile','mine','roller','missile'],interval:0.96,firstLaunch:2.4,warning:1.05,line:'I know your next move. Approximately. In theory.',clear:'Your refusal to be predictable is rude.',emotion:'annoyed' },\n  { id:'double-booked',name:'DOUBLE BOOKED',cue:'BRAIDED FLEETS • CHOOSE YOUR INTERCEPTIONS',nominal:75,formation:formation(28,['braidLeft','braidRight'],4,720,0.17),mix:['mine','missile','hunter','missile','mine','roller'],interval:0.92,firstLaunch:2.2,warning:0.8,line:'I have scheduled your doom twice. For convenience.',clear:'Your persistence is becoming statistically impressive.',emotion:'praise' },\n  { id:'rush-hour',name:'RUSH HOUR',cue:'WATCH THE LANDING MARKS. EVERY SWEEP LEAVES AN EXIT.',nominal:75,formation:formation(30,['loopRight','braidLeft'],4,740,0.17),mix:['roller','missile','missile','hunter','mine','missile'],interval:0.9,firstLaunch:2.2,warning:0.9,line:'Mind the gap. It is the only polite thing here.',clear:'You are making my clocks sweat.',emotion:'annoyed' },\n  { id:'borrowed-time',name:'BORROWED TIME',cue:'HOLD A LANE • BUILD CHARGE • BRAKE THE CROSSFIRE',nominal:90,formation:formation(32,['braidRight','loopLeft'],4,730,0.16),mix:['hunter','mine','missile','roller','hunter','missile','mine'],interval:0.88,firstLaunch:2.1,warning:0.9,line:'Your borrowed seconds are accruing interest!',clear:'Fine. That was almost magnificent.',emotion:'praise' },\n  { id:'last-call',name:'LAST CALL FOR YESTERDAY',cue:'ALL WEAPONS ACTIVE. BREAK THROUGH TO THE RIFT.',nominal:90,formation:formation(36,['braidLeft','braidRight','loopLeft','loopRight'],4,740,0.16),mix:['missile','hunter','mine','roller','mine','hunter','missile'],interval:0.84,firstLaunch:2,warning:0.95,line:'I shall handle this myself. After these final minions.',clear:'ENOUGH! Come and face the management.',emotion:'furious' },\n]);\nexport const BOSS_PHASES = Object.freeze([\n  { id:'mask',name:'THE FACE OF BAD TIMING',hp:38,mix:['missile','mine','missile','mine'],interval:0.82,cycle:8,openAt:2.1,openFor:4.7,warning:0.8,line:'BEHOLD! My extremely intimidating projection!',clear:'That was only the decorative face!',emotion:'gloat',xAmplitude:220,xSpeed:0.33 },\n  { id:'machine',name:'THE UNREASONABLE MACHINE',hp:44,mix:['roller','missile','hunter','mine','missile'],interval:0.86,cycle:8.5,openAt:2.2,openFor:4.6,warning:0.95,line:'My warranty specifically excludes laser damage!',clear:'You have invalidated EVERYTHING!',emotion:'furious',xAmplitude:260,xSpeed:0.38 },\n  { id:'last-second',name:'THE LAST SECOND',hp:50,mix:['hunter','missile','mine','roller','hunter','missile'],interval:0.8,cycle:7.5,openAt:1.9,openFor:3.9,warning:0.95,line:'I AM TIMELESS! Stop checking the expiration date!',clear:'I demand a rematch. Next Tuesday. Approximately.',emotion:'furious',xAmplitude:280,xSpeed:0.42 },\n]);\nexport const THREAT_VALUES = Object.freeze({missile:2,mine:4,roller:8,hunter:16});\nexport function validateCampaign() {\n  const errors=[];\n  if(WAVES.length!==8||BOSS_PHASES.length!==3)errors.push('Campaign must have eight waves and three boss phases.');\n  for(const [i,w] of WAVES.entries()){\n    if(!w.id||!w.name||!w.line||!w.clear||!w.cue)errors.push(`Wave ${i}: missing copy.`);\n    if(w.formation.count<1||w.interval<=0||w.firstLaunch<0)errors.push(`Wave ${i}: invalid timings/count.`);\n    if(w.formation.paths.some(p=>!PATHS[p]))errors.push(`Wave ${i}: unknown path.`);\n    if(w.mix.some(t=>!(t in THREAT_VALUES)))errors.push(`Wave ${i}: unknown threat.`);\n  }\n  for(const [key,points] of Object.entries(PATHS))if(points.length<4||points.some(p=>p.length!==2||p.some(v=>!Number.isFinite(v))))errors.push(`Invalid path ${key}.`);\n  for(const spec of TUNING_SPEC)if(!(DEFAULT_TUNING[spec.key]>=spec.min&&DEFAULT_TUNING[spec.key]<=spec.max))errors.push(`Invalid default ${spec.key}.`);\n  for(const p of BOSS_PHASES)if(p.hp<=0||p.openAt<0||p.openAt+p.openFor>p.cycle)errors.push(`Invalid boss ${p.id}.`);\n  return errors;\n}\nimport { DEFAULT_TUNING, WAVES, BOSS_PHASES, PATHS, THREAT_VALUES } from '../content/campaign.js';\n\nexport const STEP = 1 / 120;\nexport const ARENA = Object.freeze({left:-450,right:450,top:-300,bottom:300,lane:240,playerRadius:9});\nconst clamp=(n,a,b)=>Math.max(a,Math.min(b,n));\nconst livePlayers=w=>w.players.filter(p=>p.connected&&p.hp>0).sort((a,b)=>String(a.id).localeCompare(String(b.id)));\nconst clone=value=>JSON.parse(JSON.stringify(value));\nconst pathCache=new Map();\nfunction rng(w){let x=w.rngState>>>0;x^=x<<13;x^=x>>>17;x^=x<<5;w.rngState=x>>>0;return w.rngState/4294967296;}\nfunction event(w,type,data={}){const e={id:++w.eventId,type,...data};w.events.push(e);return e;}\nfunction say(w,text,emotion='gloat'){w.subtitle={text,until:w.time+5,emotion};event(w,'voice',{text,emotion});}\nfunction addScore(w,n,category){w.score+=n;w.stats[category]=(w.stats[category]||0)+n;}\nfunction markModified(w){w.modified=true;}\nfunction effectiveTuning(overrides={}){\n  const t={...DEFAULT_TUNING};\n  for(const key of Object.keys(t))if(Number.isFinite(overrides[key])&&overrides[key]>0)t[key]=overrides[key];\n  return t;\n}\n\nexport function createWorld({seed=0x1982,players=[{id:'p1',name:'PILOT'}],tuning={},assists={},demo=false}={}){\n  const balance=effectiveTuning(tuning);\n  const w={version:1,seed:seed>>>0,rngState:(seed>>>0)||1,tick:0,time:0,hostileTime:0,phase:'countdown',phaseTime:2.4,wave:0,bossPhase:0,players:[],enemies:[],threats:[],shots:[],boss:null,events:[],eventId:0,nextId:1,score:0,charge:0,brake:0,cooldown:0,outcome:null,tuning:balance,assists:{autoFire:false,reducedSpeed:false,emergencyBrake:false,...assists},modified:Object.keys(DEFAULT_TUNING).some(k=>balance[k]!==DEFAULT_TUNING[k]),demo:!!demo,subtitle:{text:'THE RIFT IS OPENING. HOLD THE LINE.',until:4,emotion:'gloat'},encounterTime:0,fireClock:0,launchIndex:0,targetCursor:0,safeCorridors:[],lastRoller:-100,stats:{kills:0,intercepts:0,hits:0,brakes:0,waveClears:0,bossPhases:0,fleetPoints:0,interceptPoints:0,bonusPoints:0,visited:[],threatsSeen:[]}};\n  const seats=players.slice(0,4);\n  w.players=seats.map((p,i)=>({id:String(p.id??`p${i+1}`),name:String(p.name??`PILOT ${i+1}`).slice(0,24),x:(i-(seats.length-1)/2)*110,y:ARENA.lane,hp:3,invuln:2.4,vx:0,recoil:0,connected:true,colorIndex:i,cool:0,brakeHeld:false,lastInputSeq:-1,hit:0}));\n  return w;\n}\n\n// Like the FORMATION kit, paths are Catmull-smoothed and sampled by distance.\n// Cache is presentation-independent and never enters serialized authoritative state.\nfunction sampledPath(id){\n  if(pathCache.has(id))return pathCache.get(id);\n  const pts=PATHS[id];let samples;\n  const NativePath=globalThis.My3D2dge?.Path;\n  if(NativePath){const p=new NativePath(pts,{smooth:'catmull'});samples=Array.from({length:181},(_,i)=>{const a=p.at(i*p.length/180);return [a.x,a.y];});}\n  else{\n    samples=[];\n    for(let j=0;j<pts.length-1;j++)for(let k=0;k<36;k++){\n      const t=k/36,t2=t*t,t3=t2*t,p0=pts[Math.max(0,j-1)],p1=pts[j],p2=pts[j+1],p3=pts[Math.min(pts.length-1,j+2)];\n      samples.push([0,1].map(d=>0.5*((2*p1[d])+(-p0[d]+p2[d])*t+(2*p0[d]-5*p1[d]+4*p2[d]-p3[d])*t2+(-p0[d]+3*p1[d]-3*p2[d]+p3[d])*t3)));\n    }\n    samples.push(pts.at(-1));\n  }\n  // Normalize both implementations to an arc-length lookup.\n  let length=0;const distances=[0];\n  for(let i=1;i<samples.length;i++){length+=Math.hypot(samples[i][0]-samples[i-1][0],samples[i][1]-samples[i-1][1]);distances.push(length);}\n  const result={samples,distances,length};pathCache.set(id,result);return result;\n}\nfunction pointOnPath(id,t){const p=sampledPath(id),d=clamp(t,0,1)*p.length;let i=1;while(i<p.distances.length-1&&p.distances[i]<d)i++;const f=(d-p.distances[i-1])/(p.distances[i]-p.distances[i-1]||1),a=p.samples[i-1],b=p.samples[i];return {x:a[0]+(b[0]-a[0])*f,y:a[1]+(b[1]-a[1])*f,angle:Math.atan2(b[1]-a[1],b[0]-a[0])};}\n\nfunction startEncounter(w){\n  w.enemies=[];w.threats=[];w.shots=[];w.safeCorridors=[];w.brake=0;w.encounterTime=0;w.launchIndex=0;w.fireClock=0;\n  if(w.wave<8){\n    const c=WAVES[w.wave],f=c.formation;\n    w.phase='playing';w.boss=null;w.fireClock=c.firstLaunch;\n    for(let i=0;i<f.count;i++){\n      const cols=Math.ceil(f.count/f.rows),row=Math.floor(i/cols),column=i%cols,group=Math.floor(i/6),slotX=(column-(cols-1)/2)*f.spread/(cols-1),slotY=-185+row*54;\n      const delay=group*0.65+(i%6)*f.stagger,pathId=f.paths[group%f.paths.length],p=pointOnPath(pathId,0);\n      w.enemies.push({id:w.nextId++,kind:row%3,x:p.x,y:p.y,px:p.x,py:p.y,hp:w.wave>=4&&i%7===0?2:1,maxHp:w.wave>=4&&i%7===0?2:1,angle:p.angle,arrival:0,delay,slotX,slotY,group,index:i,pathId,hit:0});\n    }\n    w.stats.visited.push(`wave-${w.wave+1}`);say(w,c.line,c.emotion);\n  }else{\n    const c=BOSS_PHASES[w.bossPhase];w.phase='finale';w.boss={x:0,y:-142,hp:c.hp,maxHp:c.hp,vulnerable:false,cycle:0,phase:w.bossPhase,hit:0};w.fireClock=2;\n    w.stats.visited.push(`boss-${w.bossPhase+1}`);say(w,c.line,c.emotion);\n  }\n  event(w,'phase',{wave:w.wave,bossPhase:w.bossPhase});\n}\nfunction clearHazards(w){for(const t of w.threats)event(w,'dissolve',{x:t.x,y:t.y,kind:t.type});w.threats=[];w.shots=[];w.safeCorridors=[];}\nfunction waveClear(w){\n  if(w.phase!=='playing'&&w.phase!=='finale')return;\n  clearHazards(w);w.brake=0;\n  const survivors=w.players.filter(p=>p.connected);\n  const integrityBonus=survivors.reduce((sum,p)=>sum+p.hp*5,0),interceptBonus=Math.min(40,w.stats.intercepts*2);\n  addScore(w,integrityBonus+interceptBonus,'bonusPoints');\n  for(const p of survivors){const old=p.hp;p.hp=Math.min(3,Math.max(1,p.hp+1));p.invuln=2.5;p.hit=0;p.vx=0;if(p.hp>old)event(w,'recover',{owner:p.id,x:p.x,y:p.y,hp:p.hp});}\n  if(w.wave<8){w.stats.waveClears++;say(w,WAVES[w.wave].clear,'annoyed');w.wave++;}\n  else{w.stats.bossPhases++;say(w,BOSS_PHASES[w.bossPhase].clear,'furious');w.bossPhase++;if(w.bossPhase>=3){finishWorld(w,'victory');return;}}\n  w.phase='intermission';w.phaseTime=3.2;event(w,'clear',{wave:w.wave,bossPhase:w.bossPhase,bonus:integrityBonus+interceptBonus});\n}\nexport function finishWorld(w,outcome='defeat'){\n  if(w.outcome)return false;\n  w.outcome=outcome;clearHazards(w);w.enemies=[];w.brake=0;w.boss=null;w.phase='ending';w.phaseTime=outcome==='victory'?6:2.4;\n  for(const p of w.players)p.vx=0;\n  event(w,outcome,{score:w.score});\n  say(w,outcome==='victory'?'The clocks are free. Tomorrow belongs to everyone.':'A moment lost. The next one is still yours.',outcome==='victory'?'praise':'annoyed');\n  return true;\n}\nexport function removePlayer(w,id){const p=w.players.find(p=>p.id===String(id));if(!p)return false;p.connected=false;p.vx=0;p.brakeHeld=false;w.shots=w.shots.filter(s=>s.owner!==p.id);if(!w.outcome&&!livePlayers(w).length)finishWorld(w,'defeat');return true;}\nexport function hitPlayer(w,id){\n  const p=w.players.find(p=>p.id===String(id));\n  if(!p||!p.connected||p.hp<=0||p.invuln>0||w.outcome)return false;\n  if(w.demo||w.invulnerable){p.invuln=0.4;return false;}\n  p.hp--;p.invuln=2.1;p.hit=0.45;p.recoil=0.32;w.stats.hits++;event(w,'hit',{owner:p.id,x:p.x,y:p.y,hp:p.hp});\n  // Remove immediate overlapping hazards once, before the next machine is checked.\n  w.threats=w.threats.filter(t=>Math.hypot(t.x-p.x,t.y-p.y)>70);\n  if(!livePlayers(w).length)finishWorld(w,'defeat');\n  return true;\n}\nfunction charge(w,n){const old=w.charge;w.charge=clamp(old+n,0,100);if(old<100&&w.charge>=100){event(w,'brake-ready');if(w.stats.brakes===0)say(w,'Stealing my seconds? Press TIME BRAKE. How uncivilized!','annoyed');}}\nfunction activateBrake(w,owner){if(w.charge<100||w.brake>0||w.cooldown>0)return false;w.charge=0;w.brake=w.tuning.brakeDuration;w.cooldown=2.2;w.stats.brakes++;event(w,'brake',{owner});if(w.stats.brakes===1)say(w,'That is MY time you are spending!','furious');return true;}\nfunction nextTarget(w){const p=livePlayers(w);if(!p.length)return null;const target=p[w.targetCursor%p.length];w.targetCursor++;return target;}\nfunction safeAt(w,x){return w.safeCorridors.some(c=>Math.abs(x-c.x)<c.radius);}\nfunction avoidSafeLane(w,x){if(!safeAt(w,x))return clamp(x,-415,415);const alternatives=[x-130,x+130,-360,360,0].filter(a=>a>=-415&&a<=415&&!safeAt(w,a));return alternatives.length?alternatives.reduce((a,b)=>Math.abs(a-x)<Math.abs(b-x)?a:b):null;}\n\nexport function spawnThreat(w,type,overrides={}){\n  if(!(type in THREAT_VALUES))return null;\n  const target=nextTarget(w);if(!target)return null;\n  const config=w.wave<8?WAVES[w.wave]:BOSS_PHASES[Math.min(2,w.bossPhase)];\n  let x=Number.isFinite(overrides.x)?overrides.x:target.x+(rng(w)-0.5)*100;\n  const origin=w.boss||w.enemies.filter(e=>e.arrival>=1)[Math.floor(rng(w)*Math.max(1,w.enemies.filter(e=>e.arrival>=1).length))];\n  let y=Number.isFinite(overrides.y)?overrides.y:(origin?.y??-160)+18;\n  x=avoidSafeLane(w,x);if(x===null)return null;\n  if(type==='roller'){\n    // At most one sweep. Its full segment and one reachable exit are decided before descent.\n    if(w.hostileTime-w.lastRoller<6.5||w.threats.some(t=>t.type==='roller'))return null;\n    const safeX=clamp(target.x+(target.x<0?175:-175),-410,410);\n    if(w.threats.some(t=>t.y>65&&Math.abs(t.x-safeX)<80))return null;\n    x=clamp(target.x,-330,330);\n    const left=clamp(x-105,-395,185),right=left+210;\n    if(safeX>=left-25&&safeX<=right+25)return null;\n    w.lastRoller=w.hostileTime;\n    w.safeCorridors.push({x:safeX,radius:64,until:w.hostileTime+(ARENA.lane-y)/145+config.warning+3});\n    overrides={left,right,safeX,dir:safeX<x?1:-1,...overrides};\n  }\n  let targetX=clamp(target.x+target.vx*w.tuning.hunterPrediction,-420,420);\n  if(type==='hunter'){targetX=avoidSafeLane(w,targetX);if(targetX===null)return null;}\n  const t={id:w.nextId++,type,x,y,px:x,py:y,vx:0,vy:type==='mine'?w.tuning.mineSpeed:type==='roller'?145:w.tuning.missileSpeed,r:type==='missile'?6:type==='mine'?12:11,warning:type==='hunter'?1.0:config.warning,age:0,targetId:target.id,targetX,target