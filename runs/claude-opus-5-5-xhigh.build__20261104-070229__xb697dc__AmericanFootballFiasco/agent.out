> c.id);\n/** does card id fit this play: offense ('off'), defense ('def'), a kick ('kick') */\nFF.cardFits = (id, role) => { const c = FF.data.cards[id]; return !!c && (c.side === 'any' || c.side === role || (c.side === 'kick' && role === 'kick')); };\n})();\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_017L9gEy6iRkrysAvdsdTbrS","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
