'say', 'chet', 'THE QUARTERFINAL! THE NEON NITE OWLS AT THE AFTERGLOW!'],\n        ['say', 'djhoot', 'Welcome to the Afterglow, small town. Hope your eyes can keep up.'],\n        ['say', 'lumen', 'I see the open man in the dark. I AM the open man in the dark.'],\n        ['say', 'zap', 'You blinked. I\\'m already in the end zone.'],\n        ['card', '3RD QUARTER.  OWLS 21, FIASCOS 7'],\n        ['say', 'bluster', 'We\\'re down fourteen because SOMEBODY slept through the first half!', { expr: 'shout' }],\n        ['say', 'wheels', '...I needed my beauty rest, Coach.']] },\n    ch3_lights: { radio: true, steps: [['say', 'chet', 'WAIT, THE LIGHTS! THE LIGHTS ARE OUT AT THE AFTERGLOW!'], ['say', 'lou', 'Looks like a tumbleweed tripped over the power cable, Chet.'], ['say', 'fumbles', 'hmm hmm hrrm... oops.'], ['say', 'bluster', 'Glow paint! Everybody rub on the glow paint!']] },\n    ch3_win: { set: 'field', stadium: 'afterglow', night: true, cast: [['djhoot', 0, 0], ['zap', 30, 0], ['hap', -40, 10]],\n      steps: [['say', 'djhoot', 'Respect, Tumbleweed. That comeback was a banger.'], ['say', 'zap', '...Can I get your rookie\\'s autograph? For my cousin. Not for me.'], ['reward', 'ROCKET_CLEATS'], ['reward', 'GLUE_GLOVES']] },\n    ch3_loss: { steps: [['say', 'bluster', 'Somebody turn the lights back on in your heads! Again!']] },\n    ch4_intro: { set: 'field', stadium: 'frostbite', cast: [['iceberg', 0, 0], ['avalanche', 40, 0], ['bluster', -60, 20], ['hap', -90, 20]],\n      steps: [['card', 'CHAPTER 4: FROSTBITE'], ['say', 'chet', 'THE SEMIFINAL! IT\\'S MINUS TWELVE AND THE HOT DOGS ARE FROZEN SOLID!'],\n        ['say', 'iceberg', 'The glacier does not hurry. Yet it carves the valley.'], ['say', 'bluster', '...Is that a threat or a fortune cookie?'],\n        ['say', 'avalanche', 'GRRRRRRRRRRRRMMMMMMM.'], ['fx', 'shake'],\n        ['say', 'lou', 'That\\'s Avalanche. Seven feet tall. Speaks only in growls and sacks.'],\n        ['card', '4TH QUARTER, 1:30 LEFT.  Y