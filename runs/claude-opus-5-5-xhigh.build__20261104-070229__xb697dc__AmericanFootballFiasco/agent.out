am', options: FF.data.teamList.map(t => [t, FF.data.teams[t].short]), value: 'mudhogs', apply: (g, v) => { LAB.away = v; } });\n23:S().define({ key: 'devj.score0', group: 'Dev Jump', label: 'Home score', type: 'slider', min: 0, max: 63, step: 1, value: 0, apply: (g, v) => { JS.score0 = v; } });\n24:S().define({ key: 'devj.score1', group: 'Dev Jump', label: 'Away score', type: 'slider', min: 0, max: 63, step: 1, value: 0, apply: (g, v) => { JS.score1 = v; } });\n25:S().define({ key: 'devj.clock', group: 'Dev Jump', label: 'Clock (s)', type: 'slider', min: 1, max: 300, step: 1, value: 60, apply: (g, v) => { JS.clock = v; } });\n26:S().define({ key: 'devj.down', group: 'Dev Jump', label: 'Down', type: 'slider', min: 1, max: 4, step: 1, value: 1, apply: (g, v) => { JS.down = v; } });\n27:S().define({ key: 'devj.toGo', group: 'Dev Jump', label: 'Yards to go', type: 'slider', min: 1, max: 40, step: 1, value: 20, apply: (g, v) => { JS.toGo = v; } });\n28:S().define({ key: 'devj.stadium', group: 'Dev Jump', label: 'Stadium', options: FF.data.stadiumList.map(s => [s, FF.data.stadiums[s].name]), value: 'tumbleweed', apply: (g, v) => { JS.stadium = v; } });\n29:S().define({ key: 'devj.weather', group: 'Dev Jump', label: 'Weather', options: [['stadium', 'Stadium'], ['clear', 'Clear'], ['rain', 'Rain'], ['snow', 'Snow']], value: 'stadium', apply: (g, v) => { JS.weather = v; } });\n37:const page = (name, spec) => game.shell.show(name, Object.assign({ kicker: 'DEV MODE', back: () => game.shell.back() }, spec));\n9361:  _row(key) {\n9396:    if (!this._std) { for (const k of own) add(this._row(k)); return; }\n9401:      add(this._el('div', 'esh-k esh-sec', g)); for (const k of keys) add(this._row(k));","is_error":false}]},"parent_tool_use_id":null,"session_id":"e1931e3d-b97b-4f9d-8b9d-c7660f7740b5","uuid":"0930e32c-b745-4cc1-a48c-8ccc9ab9d747","timestamp":"2026-11-04T16:06:27.651Z","tool_use_result":{"stdout":"1:// Dev mode (from the pause menu, the #dev link, or ` once opened): TU