{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgi9hQB4m1RDsTyGH9d86","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BuhCP8qWkMjBkrdDM6PyU6","name":"Bash","input":{"command":"cat > test/lib/sim.mjs <<'EOF'\n// Helpers for sim tests: a match context without the scenes, a match at a situation, stepping until a phase.\nimport { load } from './context.mjs';\nexport function simCtx() { return load({ only: s => !/\\/(5\\d|70|80|90|37|38|39|40|41|14|15|17|2[013])-/.test(s) }); }\nexport function match(FF, o = {}) { const m = new FF.Match(Object.assign({ home: 'fiascos', away: 'mudhogs', seed: 7, mode: 'lab', start: { possession: 0, los: 50, down: 1, toGo: 20 } }, o)); m.fastCalls = true; return m; }\nexport function until(m, cond, max = 60) { let t = 0; while (!cond(m) && t < max) { m.stepSim(1 / 120); t += 1 / 120; } return t < max; }\nexport function call(m, off, def, card) { m.forceCall = { [m.poss]: { play: off, flip: false, card: card || null }, [1 - m.poss]: { play: def, flip: false } }; }\nEOF\ncat > test/suites/03-rules.mjs <<'EOF'\nimport { simCtx, match, until, call } from '../lib/sim.mjs';\nexport default async ok => {\n  const { FF } = simCtx(), YD = 16;\n  // a touchdown by a run (god mode on the carrier's side), then the PAT kick, then the kickoff by the scorers\n  let m = match(FF, { start: { possession: 0, los: 90, down: 1, toGo: 10 }, cheats: { godMode: true, both: true } }); m.cheatSide = 0; call(m, 'qb_sneak', 'cover2');\n  ok('a run scores a touchdown', until(m, m => m.phase === 'CELEBRATE') && m.score[0] === 6, m.score + ' ' + m.phase);\n  m.forceCall = { 0: { play: 'pat_kick' }, 1: { play: 'fg_block' } }; m.forceKick = { power: .9, acc: 0 }; m.cheats = {};\n  ok('the PAT is kicked', until(m, m => m.score[0] === 7, 40), m.score);\n  ok('then the scorers kick off', until(m, m => m.phase === 'PRESNAP' && m.play.off.type === 'kickoff', 20) && m.poss === 0);\n  // a field goal: good, and its points\n  m = match(FF, { start: { possession: 0, los: 75, down: 4, toGo: 10 } }); call(m, 'field_goal', 'cover2'); m.forceKick = { power: .9, acc: 0 };\n  ok('a straight 42-yard field goal is good', until(m, m => m.score[0] === 3, 30), m.score + ' ' + JSON.stringify(m.fgResult));\n  m = match(FF, { start: { possession: 0, los: 75, down: 4, toGo: 10 } }); call(m, 'field_goal', 'cover2'); m.forceKick = { power: .9, acc: 1 };\n  until(m, m => m.phase === 'DEAD' || m.phase === 'CELEBRATE', 30); ok('a hooked field goal is no good, the ball goes over', m.score[0] === 0 && m.poss === 1, m.score + ' poss ' + m.poss);\n  // a turnover on downs\n  m = match(FF, { start: { possession: 0, los: 30, down: 4, toGo: 15 } }); call(m, 'hb_dive', 'goal_line'); m.forceTackle = true;\n  until(m, m => m.phase === 'PLAYCALL' && m.playNo >= 1, 30); ok('a short 4th down turns the ball over', m.poss === 1 && m.down === 1, 'poss ' + m.poss);\n  // an incomplete pass: the ball back at the spot, the next down, the clock stopped (no runoff)\n  m = match(FF, { start: { possession: 0, los: 40, down: 1, toGo: 20 }, cheats: { forceINT: false } }); call(m, 'deep_post', 'cover2');\n  let clock0 = null; until(m, m => { if (m.phase === 'LIVE' && clock0 === null) clock0 = m.clock; return m.phase === 'DEAD'; }, 30);\n  const inc = m.result.why === 'incomplete'; until(m, m => m.phase === 'PLAYCALL', 10);\n  if (inc) ok('an incompletion: 2nd down at the same spot', m.down === 2 && Math.abs(m.los - m.xAt(0, 40)) < 1, m.down + ' ' + m.spotText());\n  // the clock: runs in a live play, runoff after an in-bounds tackle\n  m = match(FF, { start: { possession: 0, los: 40 }, quarterLength: 120 }); call(m, 'hb_dive', 'cover2'); m.forceTackle = true;\n  const c0 = m.clock; until(m, m => m.phase === 'PLAYCALL' && m.playNo >= 1, 30);\n  ok('the clock runs during the play and runs off after an in-bounds tackle', c0 - m.clock >= FF.T.runoff, (c0 - m.clock).toFixed(1));\n  // a safety: the carrier tackled in his own end zone\n  m = match(FF, { start: { possession: 0, los: 1, down: 1, toGo: 20 } }); call(m, 'hb_sweep', 'fiasco_blitz');\n  until(m, m => m.phase === 'LIVE', 10); const qb = m.bySlot[0].QB; m.ball.holder && (m.ball.holder.x = m.ownGoalX(0) - m.dir(0) * 3 * YD); m.forceTackle = true;\n  until(m, m => m.phase !== 'LIVE', 10); ok('a tackle in your own end zone is a safety', m.score[1] === 2, m.score + ' ' + (m.result && m.result.why)); void qb;\n  // quarters, halftime, the final\n  m = match(FF, { quarterLength: 20, start: 'kickoff' }); until(m, m => m.quarter === 2, 400);\n  ok('the first quarter ends into the second', m.quarter === 2);\n  until(m, m => m.phase === 'HALFTIME', 400); ok('halftime after the 2nd quarter', m.phase === 'HALFTIME');\n  until(m, m => m.quarter === 3, 30); ok('the 3rd quarter starts with the ends switched', m.quarter === 3 && m.dir(0) === -1);\n  until(m, m => m.over, 900); ok('the game ends with a final', m.over && m.phase === 'FINAL', m.phase + ' q' + m.quarter);\n  // overtime: tied at the end of regulation, sudden death\n  m = match(FF, { quarter: 4, clock: 1, score: [7, 7], start: { possession: 0, los: 20 } }); call(m, 'kneel', 'cover2');\n  until(m, m => m.ot, 60); ok('tied at the end of regulation: overtime', m.ot && m.quarter === 5);\n  // a touchback on a kickoff into the end zone\n  m = match(FF, { start: { possession: 0, los: 30, kickoff: true } }); m.forceCall = { 0: { play: 'ko_deep' }, 1: { play: 'ret_mid' } }; m.forceKick = { power: 1, acc: 0 };\n  until(m, m => m.phase === 'PLAYCALL' && m.playNo >= 1, 30); ok('a kickoff ends with the other side\\'s ball', m.poss === 1, 'poss ' + m.poss);\n};\nEOF\ncat > test/suites/04-actions.mjs <<'EOF'\nimport { simCtx, match, until, call } from '../lib/sim.mjs';\nexport default async ok => {\n  const { FF, E } = simCtx(), YD = 16, T = FF.T;\n  const m = match(FF); call(m, 'hb_dive', 'cover2'); until(m, m => m.phase === 'LIVE', 10);\n  const a = m.bySlot[0].WR1, b = m.bySlot[1].NT;\n  ok('top speed follows SPD', m.topSpeed(a) > m.topSpeed(b), m.topSpeed(a) + ' vs ' + m.topSpeed(b));\n  // turbo: faster, it drains while held and comes back\n  a.turbo = 1; a.intent = Object.assign(FF.blankIntent(), { mx: 1, turbo: true }); a.action = null; a.downT = 0; a.engaged = null;\n  for (let i = 0; i < 120; i++) m.moveOne(a, 1 / 120);\n  ok('turbo goes faster than the top speed', Math.hypot(a.vx, a.vy) > m.topSpeed(a) * 1.1, Math.hypot(a.vx, a.vy));\n  ok('turbo drains while held', a.turbo < .7, a.turbo);\n  const t0 = a.turbo; a.intent.turbo = false; for (let i = 0; i < 120; i++) m.moveOne(a, 1 / 120); ok('turbo comes back when let go', a.turbo > t0, a.turbo);\n  // collisions separate opponents\n  const o = m.bySlot[1].LB1; o.x = a.x + 2; o.y = a.y; o.engaged = null; a.engaged = null; m.collide(); ok('collision pushes opponents apart', Math.hypot(o.x - a.x, o.y - a.y) >= a.rad + o.rad - .5, Math.hypot(o.x - a.x, o.y - a.y));\n  // a perfect pass lands where it was aimed\n  const m2 = match(FF, { cheats: { perfectPass: true, both: true } }); call(m2, 'slants', 'cover2'); until(m2, m => m.phase === 'LIVE' && m.ball.state === 'held' && m.ball.holder.slot === 'QB', 10);\n  const qb = m2.ball.holder; m2.startThrow(qb, 0, false); until(m2, m => m.ball.state === 'pass' && (m.ball.type === 'lob'), 2); const L = m2.ball.to;\n  let landed = null; until(m2, m => { if (m.ball.state === 'pass' && m.ball.t >= m.ball.T - 1 / 120) landed = { x: m.ball.x + m.ball.vx / 120, y: m.ball.y + m.ball.vy / 120 }; return m.ball.state !== 'pass'; }, 4);\n  ok('a pass with no aim error lands within a unit of its target', landed && Math.hypot(landed.x - L.x, landed.y - L.y) < 4, JSON.stringify(landed) + ' vs ' + JSON.stringify(L));\n  // the Big Hit: it launches the carrier; its fumble roll is about 3x a normal tackle's (seeded Monte Carlo)\n  const fum = big => { let n = 0; for (let s = 0; s < 400; s++) { const mm = match(FF, { seed: 1000 + s }); call(mm, 'hb_dive', 'cover2'); until(mm, x => x.phase === 'LIVE' && x.ball.holder && x.ball.holder.slot === 'RB', 6); const c = mm.ball.holder; if (!c) continue; const t = mm.bySlot[1].LB1; t.x = c.x + 10; t.y = c.y; t.action = big ? { id: 'bigHit', t: .1, dur: .35 } : null; mm.forceTackle = true; mm.tackle(t, c, 1); if (mm.play.fumbled) n++; mm.ots.dispose(); } return n / 400; };\n  const T0 = T.fumbleBase; FF.T.fumbleBase = .05; const pn = fum(false), pb = fum(true); FF.T.fumbleBase = T0;\n  ok('a Big Hit fumbles about 3x as often', pb > pn * 2 && pb < pn * 4.5, pn.toFixed(3) + ' vs ' + pb.toFixed(3));\n  // a spin evades a frontal tackle inside its window, not after it\n  const ev = (late) => { const mm = match(FF, { seed: 5 }); call(mm, 'hb_dive', 'cover2'); until(mm, x => x.phase === 'LIVE' && x.ball.holder && x.ball.holder.slot === 'RB', 6); const c = mm.ball.holder, t = mm.bySlot[1].LB1; c.facing = 0; t.x = c.x + 12; t.y = c.y; c.action = { id: 'spin', t: late ? .3 : .05, dur: .32 }; mm.forceTackle = true; mm.tackle(t, c, 1); const r = mm.phase; mm.ots.dispose(); return r; };\n  ok('a spin evades a frontal tackle in its window', ev(false) === 'LIVE', ev(false));\n  ok('a spin past its window doesn\\'t', ev(true) !== 'LIVE', ev(true));\n  // the 3-press kick meter: power, then accuracy, then the kick\n  const mk = match(FF, { start: { possession: 0, los: 75, down: 4 }, humans: { 0: [0], 1: [] } }); mk.forceCall = { 0: { play: 'field_goal' }, 1: { play: 'cover2' } };\n  until(mk, x => x.phase === 'PLAYCALL', 2); mk.callPlay(0, 'field_goal'); mk.callPlay(1, 'cover2');\n  until(mk, x => x.phase === 'PRESNAP' && x.set, 5); mk.meterPress = true; mk.stepSim(1 / 120); ok('press 1 starts the power needle', mk.meterK.stage === 1);\n  for (let i = 0; i < 40; i++) mk.stepSim(1 / 120); mk.meterPress = true; mk.stepSim(1 / 120); ok('press 2 sets the power', mk.meterK.stage === 2 && mk.meterK.power > 0);\n  for (let i = 0; i < 30; i++) mk.stepSim(1 / 120); mk.meterPress = true; mk.stepSim(1 / 120); ok('press 3 sets the aim and kicks', mk.phase === 'LIVE' && mk.meterK.done);\n  // the late-hit window after the whistle\n  const ml = match(FF); call(ml, 'hb_dive', 'cover2'); ml.forceTackle = true; until(ml, x => x.phase === 'DEAD', 10);\n  const v = ml.on.find(x => x.side === 1 && x.downT <= 0), l = ml.on.find(x => x.side === 0); l.downT = 0; l.action = null; l.x = v.x + 10; l.y = v.y;\n  ok('a late hit lands within the window', ml.lateHit(l), ml.lateHitT);\n  ml.lateHitT = 0; ok('and not after it', !ml.lateHit(ml.on.find(x => x.side === 1 && x.downT <= 0 && x !== v) || l));\n  void E;\n};\nEOF\ntimeout 900 node test/run.mjs rules actions 2>&1 | tail -12","description":"Write and run rules and actions suites","timeout":960000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1627,"cache_read_input_tokens":943935,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1627},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e1931e3d-b97b-4f9d-8b9d-c7660f7740b5","uuid":"013f67df-f905-46ad-aa4f-792d30952127","timestamp":"2026-11-04T15:49:04.998Z","request_id":"req_011Cgi9hPkGgp4q2CsTftJ6G","wire_tool_inputs":{"toolu_01BuhCP8qWkMjBkrdDM6PyU6":{"command":"cat > test/lib/sim.mjs <<'EOF'\n// Helpers for sim tests: a match context without the scenes, a match at a situation, stepping until a phase.\nimport { load } from './context.mjs';\nexport function simCtx() { return load({ only: s => !/\\/(5\\d|70|80|90|37|38|39|40|41|14|15|17|2[013])-/.test(s) }); }\nexport function match(FF, o = {}) { const m = new FF.Match(Object.assign({ home: 'fiascos', away: 'mudhogs', seed: 7, mode: 'lab', start: { possession: 0, los: 50, down: 1, toGo: 20 } }, o)); m.fastCalls = true; return m; }\nexport function until(m, cond, max = 60) { let t = 0; while (!cond(m) && t < max) { m.stepSim(1 / 120); t += 1 / 120; } return t < max; }\nexport function call(m, off, def, card) { m.forceCall = { [m.poss]: { play: off, flip: false, card: card || null }, [1 - m.poss]: { play: def, flip: false } }; }\nEOF\ncat > test/suites/03-rules.mjs <<'EOF'\nimport { simCtx, match, until, call } from '../lib/sim.mjs';\nexport default async ok => {\n  const { FF } = simCtx(), YD = 16;\n  // a touchdown by a run (god mode on the carrier's side), then the PAT kick, then the kickoff by the scorers\n  let m = match(FF, { start: { possession: 0, los: 90, down: 1, toGo: 10 }, cheats: { godMode: true, both: true } }); m.cheatSide = 0; call(m, 'qb_sneak', 'cover2');\n  ok('a run scores a touchdown', until(m, m => m.phase === 'CELEBRATE') && m.score[0] === 6, m.score + ' ' + m.phase);\n  m.forceCall = { 0: { play: 'pat_kick' }, 1: { play: 'fg_block' } }; m.forceKick = { power: .9, acc: 0 }; m.cheats = {};\n  ok('the PAT is kicked', until(m, m => m.score[0] === 7, 40), m.score);\n  ok('then the scorers kick off', until(m, m => m.phase === 'PRESNAP' && m.play.off.type === 'kickoff', 20) && m.poss === 0);\n  // a field goal: good, and its points\n  m = match(FF, { start: { possession: 0, los: 75, down: 4, toGo: 10 } }); call(m, 'field_goal', 'cover2'); m.forceKick = { power: .9, acc: 0 };\n  ok('a straight 42-yard field goal is good', until(m, m => m.score[0] === 3, 30), m.score + ' ' + JSON.stringify(m.fgResult));\n  m = match(FF, { start: { possession: 0, los: 75, down: 4, toGo: 10 } }); call(m, 'field_goal', 'cover2'); m.forceKick = { power: .9, acc: 1 };\n  until(m, m => m.phase === 'DEAD' || m.phase === 'CELEBRATE', 30); ok('a hooked field goal is no good, the ball goes over', m.score[0] === 0 && m.poss === 1, m.score + ' poss ' + m.poss);\n  // a turnover on downs\n  m = match(FF, { start: { possession: 0, los: 30, down: 4, toGo: 15 } }); call(m, 'hb_dive', 'goal_line'); m.forceTackle = true;\n  until(m, m => m.phase === 'PLAYCALL' && m.playNo >= 1, 30); ok('a short 4th down turns the ball over', m.poss === 1 && m.down === 1, 'poss ' + m.poss);\n  // an incomplete pass: the ball back at the spot, the next down, the clock stopped (no runoff)\n  m = match(FF, { start: { possession: 0, los: 40, down: 1, toGo: 20 }, cheats: { forceINT: false } }); call(m, 'deep_post', 'cover2');\n  let clock0 = null; until(m, m => { if (m.phase === 'LIVE' && clock0 === null) clock0 = m.clock; return m.phase === 'DEAD'; }, 30);\n  const inc = m.result.why === 'incomplete'; until(m, m => m.phase === 'PLAYCALL', 10);\n  if (inc) ok('an incompletion: 2nd down at the same spot', m.down === 2 && Math.abs(m.los - m.xAt(0, 40)) < 1, m.down + ' ' + m.spotText());\n  // the clock: runs in a live play, runoff after an in-bounds tackle\n  m = match(FF, { start: { possession: 0, los: 40 }, quarterLength: 120 }); call(m, 'hb_dive', 'cover2'); m.forceTackle = true;\n  const c0 = m.clock; until(m, m => m.phase === 'PLAYCALL' && m.playNo >= 1, 30);\n  ok('the clock runs during the play and runs off after an in-bounds tackle', c0 - m.clock >= FF.T.runoff, (c0 - m.clock).toFixed(1));\n  // a safety: the carrier tackled in his own end zone\n  m = match(FF, { start: { possession: 0, los: 1, down: 1, toGo: 20 } }); call(m, 'hb_sweep', 'fiasco_blitz');\n  until(m, m => m.phase === 'LIVE', 10); const qb = m.bySlot[0].QB; m.ball.holder && (m.ball.holder.x = m.ownGoalX(0) - m.dir(0) * 3 * YD); m.forceTackle = true;\n  until(m, m => m.phase !== 'LIVE', 10); ok('a tackle in your own end zone is a safety', m.score[1] === 2, m.score + ' ' + (m.result && m.result.why)); void qb;\n  // quarters, halftime, the final\n  m = match(FF, { quarterLength: 20, start: 'kickoff' }); until(m, m => m.quarter === 2, 400);\n  ok('the first quarter ends into the second', m.quarter === 2);\n  until(m, m => m.phase === 'HALFTIME', 400); ok('halftime after the 2nd quarter', m.phase === 'HALFTIME');\n  until(m, m => m.quarter === 3, 30); ok('the 3rd quarter starts with the ends switched', m.quarter === 3 && m.dir(0) === -1);\n  until(m, m => m.over, 900); ok('the game ends with a final', m.over && m.phase === 'FINAL', m.phase + ' q' + m.quarter);\n  // overtime: tied at the end of regulation, sudden death\n  m = match(FF, { quarter: 4, clock: 1, score: [7, 7], start: { possession: 0, los: 20 } }); call(m, 'kneel', 'cover2');\n  until(m, m => m.ot, 60); ok('tied at the end of regulation: overtime', m.ot && m.quarter === 5);\n  // a touchback on a kickoff into the end zone\n  m = match(FF, { start: { possession: 0, los: 30, kickoff: true } }); m.forceCall = { 0: { play: 'ko_deep' }, 1: { play: 'ret_mid' } }; m.forceKick = { power: 1, acc: 0 };\n  until(m, m => m.phase === 'PLAYCALL' && m.playNo >= 1, 30); ok('a kickoff ends with the other side\\'s ball', m.poss === 1, 'poss ' + m.poss);\n};\nEOF\ncat > test/suites/04-actions.mjs <<'EOF'\nimport { simCtx, match, until, call } from '../lib/sim.mjs';\nexport default async ok => {\n  const { FF, E } = simCtx(), YD = 16, T = FF.T;\n  const m = match(FF); call(m, 'hb_dive', 'cover2'); until(m, m => m.phase === 'LIVE', 10);\n  const a = m.bySlot[0].WR1, b = m.bySlot[1].NT;\n  ok('top speed follows SPD', m.topSpeed(a) > m.topSpeed(b), m.topSpeed(a) + ' vs ' + m.topSpeed(b));\n  // turbo: faster, it drains while held and comes back\n  a.turbo = 1; a.intent = Object.assign(FF.blankIntent(), { mx: 1, turbo: true }); a.action = null; a.downT = 0; a.engaged = null;\n  for (let i = 0; i < 120; i++) m.moveOne(a, 1 / 120);\n  ok('turbo goes faster than the top speed', Math.hypot(a.vx, a.vy) > m.topSpeed(a) * 1.1, Math.hypot(a.vx, a.vy));\n  ok('turbo drains while held', a.turbo < .7, a.turbo);\n  const t0 = a.turbo; a.intent.turbo = false; for (let i = 0; i < 120; i++) m.moveOne(a, 1 / 120); ok('turbo comes back when let go', a.turbo > t0, a.turbo);\n  // collisions separate opponents\n  const o = m.bySlot[1].LB1; o.x = a.x + 2; o.y = a.y; o.engaged = null; a.engaged = null; m.collide(); ok('collision pushes opponents apart', Math.hypot(o.x - a.x, o.y - a.y) >= a.rad + o.rad - .5, Math.hypot(o.x - a.x, o.y - a.y));\n  // a perfect pass lands where it was aimed\n  const m2 = match(FF, { cheats: { perfectPass: true, both: true } }); call(m2, 'slants', 'cover2'); until(m2, m => m.phase === 'LIVE' && m.ball.state === 'held' && m.ball.holder.slot === 'QB', 10);\n  const qb = m2.ball.holder; m2.startThrow(qb, 0, false); until(m2, m => m.ball.state === 'pass' && (m.ball.type === 'lob'), 2); const L = m2.ball.to;\n  let landed = null; until(m2, m => { if (m.ball.state === 'pass' && m.ball.t >= m.ball.T - 1 / 120) landed = { x: m.ball.x + m.ball.vx / 120, y: m.ball.y + m.ball.vy / 120 }; return m.ball.state !== 'pass'; }, 4);\n  ok('a pass with no aim error lands within a unit of its target', landed && Math.hypot(landed.x - L.x, landed.y - L.y) < 4, JSON.stringify(landed) + ' vs ' + JSON.stringify(L));\n  // the Big Hit: it launches the carrier; its fumble roll is about 3x a normal tackle's (seeded Monte Carlo)\n  const fum = big => { let n = 0; for (let s = 0; s < 400; s++) { const mm = match(FF, { seed: 1000 + s }); call(mm, 'hb_dive', 'cover2'); until(mm, x => x.phase === 'LIVE' && x.ball.holder && x.ball.holder.slot === 'RB', 6); const c = mm.ball.holder; if (!c) continue; const t = mm.bySlot[1].LB1; t.x = c.x + 10; t.y = c.y; t.action = big ? { id: 'bigHit', t: .1, dur: .35 } : null; mm.forceTackle = true; mm.tackle(t, c, 1); if (mm.play.fumbled) n++; mm.ots.dispose(); } return n / 400; };\n  const T0 = T.fumbleBase; FF.T.fumbleBase = .05; const pn = fum(false), pb = fum(true); FF.T.fumbleBase = T0;\n  ok('a Big Hit fumbles about 3x as often', pb > pn * 2 && pb < pn * 4.5, pn.toFixed(3) + ' vs ' + pb.toFixed(3));\n  // a spin evades a frontal tackle inside its window, not after it\n  const ev = (late) => { const mm = match(FF, { seed: 5 }); call(mm, 'hb_dive', 'cover2'); until(mm, x => x.phase === 'LIVE' && x.ball.holder && x.ball.holder.slot === 'RB', 6); const c = mm.ball.holder, t = mm.bySlot[1].LB1; c.facing = 0; t.x = c.x + 12; t.y = c.y; c.action = { id: 'spin', t: late ? .3 : .05, dur: .32 }; mm.forceTackle = true; mm.tackle(t, c, 1); const r = mm.phase; mm.ots.dispose(); return r; };\n  ok('a spin evades a frontal tackle in its window', ev(false) === 'LIVE', ev(false));\n  ok('a spin past its window doesn\\'t', ev(true) !== 'LIVE', ev(true));\n  // the 3-press kick meter: power, then accuracy, then the kick\n  const mk = match(FF, { start: { possession: 0, los: 75, down: 4 }, humans: { 0: [0], 1: [] } }); mk.forceCall = { 0: { play: 'field_goal' }, 1: { play: 'cover2' } };\n  until(mk, x => x.phase === 'PLAYCALL', 2); mk.callPlay(0, 'field_goal'); mk.callPlay(1, 'cover2');\n  until(mk, x => x.phase === 'PRESNAP' && x.set, 5); mk.meterPress = true; mk.stepSim(1 / 120); ok('press 1 starts the power needle', mk.meterK.stage === 1);\n  for (let i = 0; i < 40; i++) mk.stepSim(1 / 120); mk.meterPress = true; mk.stepSim(1 / 120); ok('press 2 sets the power', mk.meterK.stage === 2 && mk.meterK.power > 0);\n  for (let i = 0; i < 30; i++) mk.stepSim(1 / 120); mk.meterPress = true; mk.stepSim(1 / 120); ok('press 3 sets the aim and kicks', mk.phase === 'LIVE' && mk.meterK.done);\n  // the late-hit window after the whistle\n  const ml = match(FF); call(ml, 'hb_dive', 'cover2'); ml.forceTackle = true; until(ml, x => x.phase === 'DEAD', 10);\n  const v = ml.on.find(x => x.side === 1 && x.downT <= 0), l = ml.on.find(x => x.side === 0); l.downT = 0; l.action = null; l.x = v.x + 10; l.y = v.y;\n  ok('a late hit lands within the window', ml.lateHit(l), ml.lateHitT);\n  ml.lateHitT = 0; ok('and not after it', !ml.lateHit(ml.on.find(x => x.side === 1 && x.downT <= 0 && x !== v) || l));\n  void E;\n};\nEOF\ntimeout 900 node test/run.mjs rules actions 2>&1 | tail -12","description":"Write and run rules and actions suites","timeout":960000}}}
