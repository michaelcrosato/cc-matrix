g, '‹ ' + val + ' ›', x + w - 12, y + 6, f ? '#fff4d8' : '#e8e4f0', { align: 'right', scale: 2 }); });\\n  const py = 34 + 4 * 30 + 6; items.push({ x: x + 40, y: py, w: w - 80, h: 30, go: () => startExhibition() }); ui.button(g, x + 40, py, w - 80, 30, 'PLAY BALL!', { focus: SU.focus.i === 4, scale: 3 });\\n  SU.focus.set(items);\\n  ui.prompts(g, [['move', 'CHANGE'], ['b1', 'SELECT'], ['b2', 'BACK']], r.W / 2, r.H - 14, { align: 'center' });\",\n  \"  rows.forEach(([lab, val, cyc], k) => { const y = 34 + k * 30, f = SU.focus.i === k; items.push({ x, y, w, h: 24, cycle: d => { cyc(d); game.audio.sfx('menuMove'); } }); if (g) { ui.button(g, x, y, w, 24, '', { focus: f }); ui.T(g, lab, x + 22, y + 9, '#a9a6c0'); ui.T(g, '‹ ' + val + ' ›', x + w - 12, y + 6, f ? '#fff4d8' : '#e8e4f0', { align: 'right', scale: 2 }); } });\\n  const py = 34 + 4 * 30 + 6; items.push({ x: x + 40, y: py, w: w - 80, h: 30, go: () => startExhibition() }); if (g) ui.button(g, x + 40, py, w - 80, 30, 'PLAY BALL!', { focus: SU.focus.i === 4, scale: 3 });\\n  SU.focus.set(items);\\n  if (g) ui.prompts(g, [['move', 'CHANGE'], ['b1', 'SELECT'], ['b2', 'BACK']], r.W / 2, r.H - 14, { align: 'center' });\"),\n])\n# story board: build the items in update too\nedit('src/54-scene-story.js', [\n (\"    const it = SB.focus.update(); if (!it) return;\", \"    SB.focus.set(boardItems({ W: game.W, H: game.H }));\\n    const it = SB.focus.update(); if (!it) return;\"),\n (\"/* ---- THAT'S A FIASCO! (a lost chapter)\", \"function boardItems(r) {\\n  const items = [], cw = Math.floor((r.W - 24) / 5) - 4, nx = story.next();\\n  D().chapters.forEach((c, k) => items.push({ x: 12 + k * (cw + 4), y: 26, w: cw, h: 86, kind: 'ch', id: c.id, open: !!(ST.done[c.id] || (nx && nx.id === c.id)) }));\\n  FF.data.cardList.forEach((id, k) => { if (ST.collection.includes(id)) items.push({ x: 12 + k * 52, y: 128, w: 48, h: 58, kind: 'card', id }); });\\n  items.push({ x: r.W - 150, y: r.H - 40, w: 138, h: 26, kind: 'go' });\\n  