 explode: { wave: 'noise', freq: 900, to: 60, dur: .6, vol: .55, filter: 'lowpass' },\n7509:  boom: [{ wave: 'noise', freq: 600, to: 40, dur: 1.1, vol: .6, filter: 'lowpass' }, { wave: 'sine', freq: 90, to: 30, dur: .8, vol: .55 }],\n7525:  h: [{ wave: 'noise', freq: 7500, dur: .035, vol: .14, filter: 'highpass' }],\n7526:  o: [{ wave: 'noise', freq: 6500, dur: .2, vol: .13, filter: 'highpass' }],\n7527:  c: [{ wave: 'noise', freq: 4500, dur: .7, vol: .18, filter: 'highpass' }],\n7550:  _init() {\n7560:      this._noise = nb;\n7570:  applyVolume() { if (!this.ctx) return; this._master.gain.value = this.muted ? 0 : this.volume; this._sfxBus.gain.value = this.sfxVolume; this._musBus.gain.value = this.musicVolume * (this._ducked || this.ducked ? .35 : 1); }\n7580:  _pulse(duty) {\n7586:  _voice(p, bus, t0, mul = 1) {\n7594:      src = c.createBufferSource(); src.buffer = this._noise; src.loop = true;\n7599:      if (wave === 'pulse' || wave === 'pulse12') src.setPeriodicWave(this._pulse(wave === 'pulse' ? .25 : .125));\n7614:  sfx(what, o = {}) {\n7623:    try { for (const v of Array.isArray(p) ? p : [p]) this._voice(o.vol === undefined ? v : Object.assign({}, v, { vol: (v.vol === undefined ? .3 : v.vol) * o.vol }), this._sfxBus, at, mul); }\n7627:  define(name, voice) { this.presets[name] = voice; }\n7791:      for (const v of kit) this._voice(Object.assign({}, v, { vol: v.vol * vol / .18 }), bus, time);\n7796:    this._voice({ wave: t.wave || 'square', freq: f * Math.pow(2, t.octave || 0), dur: n * spb * (t.gate || .9), vol, hold: true, attack: .006, vib: t.vib }, bus, time);","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01FuXcRjSgDiN1xg7csiqWcR","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
