{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgi9v51GRUXcrVmwGkAt6","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3524,"cache_read_input_tokens":959866,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3524},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e1931e3d-b97b-4f9d-8b9d-c7660f7740b5","uuid":"1014eb4e-c9a9-459d-874a-f38322134fdd","timestamp":"2026-11-04T15:51:12.236Z","request_id":"req_011Cgi9v4XEriJDGU6Ziy1V2","thinking_duration_ms":1822,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgi9v51GRUXcrVmwGkAt6","type":"message","role":"assistant","content":[{"type":"text","text":"UI, audio and Dev suites pass. Now the network suite: 2–4 game copies in separate VM contexts joined by a fake hub with latency, jitter, loss, a rate limiter and the card/start/time-up/end flow."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3524,"cache_read_input_tokens":959866,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3524},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e1931e3d-b97b-4f9d-8b9d-c7660f7740b5","uuid":"62167aa5-bd85-471b-99c8-3a76079162c9","timestamp":"2026-11-04T15:51:12.236Z","request_id":"req_011Cgi9v4XEriJDGU6Ziy1V2"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgi9v51GRUXcrVmwGkAt6","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DG2GqgAPgKDtyTkPTUUsfD","name":"Bash","input":{"command":"cat > test/lib/fakehub.mjs <<'EOF'\n// A fake AI Hub for the net tests: N copies of the game, each given its own AIHub object, joined by a bus with latency,\n// jitter and loss for unreliable messages, in-order reliable delivery, a 20/s burst-40 limiter, the 16 KB limit, and the\n// card -> start -> time-up -> end flow on a shared virtual clock.\nexport function makeHub(n, o = {}) {\n  const H = { now: 0, n, players: [], copies: [], queue: [], startAt: null, finished: null, ended: false, log: [], sent: {}, server: !!o.server, hostLeft: false, limitMs: o.limitMs || 200000, rngSeed: o.seed || 12345 };\n  const ids = [...Array(n).keys()];\n  H.players = ids.map(i => ({ id: i, name: 'P' + i, color: ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'][i] }));\n  const rand = (() => { let s = 99; return () => { s = (s * 1103515245 + 12345) & 0x7fffffff; return s / 0x7fffffff; }; })();\n  const mkRng = label => { let h = H.rngSeed; for (const ch of label) h = Math.imul(h ^ ch.charCodeAt(0), 16777619) >>> 0; return () => { h = (Math.imul(h, 1664525) + 1013904223) >>> 0; return h / 4294967296; }; };\n  const copies = (H.server ? [-1] : []).concat(ids);\n  for (const me of copies) {\n    const handlers = {}, pend = [], bucket = { t: 0, tokens: 40 };\n    const api = {\n      active: true, seeded: false, me, isHost: me === (H.server ? -1 : 0), host: H.server ? -1 : 0, server: me === -1, players: H.players,\n      connect: async () => { const info = { me, players: H.players, host: H.server ? -1 : 0, isHost: me === (H.server ? -1 : 0), server: me === -1, mode: 'shared-world', round: 1, limitMs: H.limitMs, seed: H.rngSeed }; Object.assign(api, info); return info; },\n      ready() { api._ready = true; }, answer(a) { H.log.push(['answer', me, a]); },\n      on(ev, fn) { (handlers[ev] = handlers[ev] || []).push(fn); for (const p of pend.filter(p => p[0] === ev)) fn(...p[1]); return () => {}; },\n      time() { return H.startAt === null ? -Infinity : H.now - H.startAt - 3000; },\n      rng: mkRng,\n      send(data, opt = {}) {\n        if (H.ended || api._left) return false;\n        const js = JSON.stringify(data); if (js.length > 16384) return false;\n        bucket.tokens = Math.min(40, bucket.tokens + (H.now - bucket.t) / 1000 * 20); bucket.t = H.now; if (bucket.tokens < 1) { H.log.push(['limited', me]); return false; } bucket.tokens--;\n        (H.sent[me] = H.sent[me] || []).push({ t: H.now, len: js.length, kind: data.t, reliable: opt.reliable !== false });\n        const tos = opt.to !== undefined ? [opt.to] : copies.filter(c => c !== me);\n        for (const to of tos) { if (opt.reliable === false && (rand() < (o.loss || 0) || js.length > 1200 && rand() < .3)) continue; const lat = (o.latency || 0) + (rand() - .5) * 2 * (o.jitter || 0); H.queue.push({ at: H.now + Math.max(0, lat), to, from: me, data: JSON.parse(js), rel: opt.reliable !== false }); }\n        return true;\n      },\n      finish(r) { if (H.finished) H.log.push(['finish twice']); H.finished = r; H.log.push(['finish', me, JSON.stringify(r.standings)]); },\n      result() {}, progress() {}, fail(msg) { H.log.push(['fail', me, msg]); },\n      _emit(ev, ...args) { if (handlers[ev]) for (const f of handlers[ev]) f(...args); else pend.push([ev, args]); }\n    };\n    H.copies.push({ me, api });\n  }\n  H.api = me => H.copies.find(c => c.me === me).api;\n  H.tick = ms => {\n    H.now += ms;\n    H.queue.sort((a, b) => a.at - b.at);\n    while (H.queue.length && H.queue[0].at <= H.now) { const q = H.queue.shift(); const c = H.copies.find(c => c.me === q.to); if (c && !c.api._left && !H.ended) c.api._emit('message', q.data, q.from); }\n    if (H.startAt === null && H.copies.every(c => c.api._ready)) { H.startAt = H.now; for (const c of H.copies) c.api._emit('start', { in: 3000 }); }\n    if (!H.ended && H.finished) { H.ended = true; for (const c of H.copies) if (!c.api._left) c.api._emit('end', { reason: 'finished', standings: H.finished.standings }); }\n  };\n  H.timeUp = () => { for (const c of H.copies) if (!c.api._left) c.api._emit('time-up', { graceMs: 5000 }); };\n  H.leave = id => { const c = H.copies.find(c => c.me === id); c.api._left = true; for (const d of H.copies) if (d.me !== id && !d.api._left) d.api._emit('leave', { id, reason: 'left' }); if (id === (H.server ? -1 : 0)) { H.ended = true; for (const d of H.copies) if (!d.api._left) d.api._emit('end', { reason: 'host-left' }); } };\n  return H;\n}\nEOF\ncat > test/suites/14-net.mjs <<'EOF'\n// The AI Hub session over a fake hub: traffic both ways, the message budget, snapshot sizes, prediction near the host,\n// play calls arriving, a player or the host leaving, a server host, time-up and the end.\nimport { load } from '../lib/context.mjs';\nimport { makeHub } from '../lib/fakehub.mjs';\nasync function run(n, o, steps, ok, label) {\n  const H = makeHub(n, o), C = H.copies.map(c => ({ me: c.me, ctx: load({ hub: c.api }) }));\n  const yieldp = () => new Promise(r => setImmediate(r));\n  for (const c of C) c.ctx.game.advance(.05); await yieldp(); await yieldp();\n  let t = 0, near = 0, nearN = 0;\n  for (let i = 0; i < steps; i++) {\n    for (const c of C) if (!H.copies.find(x => x.me === c.me).api._left) c.ctx.game.advance(1 / 30);\n    H.tick(1000 / 30); t += 1 / 30; if (i % 15 === 0) await yieldp();\n    if (o.leaveAt && Math.abs(t - o.leaveAt) < 1 / 60) H.leave(o.leaveId);\n    if (o.timeUpAt && Math.abs(t - o.timeUpAt) < 1 / 60) H.timeUp();\n    // prediction: a client's own athlete near the host's copy of it\n    const host = C.find(c => c.me === (H.server ? -1 : 0)), cl = C.find(c => c.me === 1);\n    if (host && cl && cl.ctx.FF.match && host.ctx.FF.match && cl.ctx.FF.match.phase === 'LIVE') { const a = cl.ctx.FF.match.on.find(x => x.ctl === 0); if (a) { const b = host.ctx.FF.match.all.find(x => x.id === a.id); if (b && !(b.downT > 0)) { nearN++; if (Math.hypot(a.x - b.x, a.y - b.y) < 2 * 16 + Math.hypot(b.vx, b.vy) * .25) near++; } } }\n    if (H.ended && i > 10 && !o.keep) { for (let k = 0; k < 10; k++) { for (const c of C) c.ctx.game.advance(1 / 30); H.tick(33); } break; }\n  }\n  const errs = C.flatMap(c => c.ctx.game.errors.map(e => 'p' + c.me + ': ' + e.message));\n  ok(label + ': no errors', !errs.length, errs.slice(0, 3).join(' | '));\n  return { H, C, near: nearN ? near / nearN : 1, nearN };\n}\nexport default async ok => {\n  // two players: the round plays, the host is told time is up and finishes once\n  let r = await run(2, { latency: 60 }, 30 * 70, ok, '2 players');\n  const { H } = r;\n  ok('2 players: both copies started a match', r.C.every(c => c.ctx.FF.match), r.C.map(c => c.ctx.game.sceneName).join(','));\n  ok('2 players: traffic both ways', (H.sent[0] || []).length > 20 && (H.sent[1] || []).length > 20, (H.sent[0] || []).length + ' / ' + (H.sent[1] || []).length);\n  const rate = me => { const s = H.sent[me] || []; let worst = 0; for (const m of s) worst = Math.max(worst, s.filter(x => x.t > m.t - 1000 && x.t <= m.t).length); return worst; };\n  ok('2 players: at most 18 messages a second from each copy', rate(0) <= 18 && rate(1) <= 18, rate(0) + ' / ' + rate(1));\n  ok('2 players: snapshots stay under 1,100 bytes', Math.max(...(H.sent[0] || []).filter(m => m.kind === 's').map(m => m.len)) <= 1100, Math.max(...(H.sent[0] || []).filter(m => m.kind === 's').map(m => m.len)));\n  ok('2 players: the client sees the live play', r.C[1].ctx.FF.match.on.length >= 14, r.C[1].ctx.FF.match.on.length);\n  ok('2 players: the predicted athlete stays near the host\\'s (95% when not locked)', r.near >= .9 || r.nearN < 30, r.near.toFixed(2) + ' of ' + r.nearN);\n  // time-up: the host finishes within the grace, everyone is told the end\n  r = await run(2, { latency: 100, timeUpAt: 30 }, 30 * 45, ok, 'time-up');\n  ok('time-up: finish called once with every player in the standings', !!r.H.finished && r.H.finished.standings.flat().sort().join() === '0,1' && !r.H.log.some(l => l[0] === 'finish twice'), JSON.stringify(r.H.finished));\n  ok('time-up: every copy ended', r.C.every(c => c.ctx.FF.net.ended));\n  const after = (r.H.sent[0] || []).filter(m => m.t > r.H.now - 100).length; ok('nothing is sent after the end', after === 0, after);\n  // four players with latency and loss; a player leaves: his athletes go back to the CPU\n  r = await run(4, { latency: 150, jitter: 50, loss: .05, leaveAt: 25, leaveId: 3, timeUpAt: 40 }, 30 * 50, ok, '4 players');\n  ok('4 players: the host finishes with the three left', r.H.finished && r.H.finished.standings.flat().length === 3, JSON.stringify(r.H.finished));\n  const m0 = r.C[0].ctx.FF.match; ok('4 players: the leaver\\'s athletes go back to the CPU', !m0.all.some(a => a.ctl === 'net:3'));\n  // the host leaves: the round ends for the others\n  r = await run(3, { latency: 80, leaveAt: 20, leaveId: 0, keep: true }, 30 * 25, ok, 'host leaves');\n  ok('host leaves: the clients end', r.C.filter(c => c.me !== 0).every(c => c.ctx.FF.net.ended && c.ctx.FF.net.endReason === 'host-left'));\n  // a server host with no player of its own\n  r = await run(2, { server: true, latency: 60, timeUpAt: 25 }, 30 * 35, ok, 'server');\n  ok('server: the server hosts and finishes', !!r.H.finished && r.C.find(c => c.me === -1).ctx.FF.net.server, JSON.stringify(r.H.finished));\n  ok('server: both players saw the match', r.C.filter(c => c.me >= 0).every(c => c.ctx.FF.match && c.ctx.FF.match.on.length >= 14));\n};\nEOF\ntimeout 1200 node test/run.mjs net 2>&1 | tail -16","description":"Write the fake hub and run the net suite","timeout":1260000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3524,"cache_read_input_tokens":959866,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3524},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e1931e3d-b97b-4f9d-8b9d-c7660f7740b5","uuid":"1ca98143-bd77-489b-8af0-e37fd3333d87","timestamp":"2026-11-04T15:51:47.071Z","request_id":"req_011Cgi9v4XEriJDGU6Ziy1V2","wire_tool_inputs":{"toolu_01DG2GqgAPgKDtyTkPTUUsfD":{"command":"cat > test/lib/fakehub.mjs <<'EOF'\n// A fake AI Hub for the net tests: N copies of the game, each given its own AIHub object, joined by a bus with latency,\n// jitter and loss for unreliable messages, in-order reliable delivery, a 20/s burst-40 limiter, the 16 KB limit, and the\n// card -> start -> time-up -> end flow on a shared virtual clock.\nexport function makeHub(n, o = {}) {\n  const H = { now: 0, n, players: [], copies: [], queue: [], startAt: null, finished: null, ended: false, log: [], sent: {}, server: !!o.server, hostLeft: false, limitMs: o.limitMs || 200000, rngSeed: o.seed || 12345 };\n  const ids = [...Array(n).keys()];\n  H.players = ids.map(i => ({ id: i, name: 'P' + i, color: ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'][i] }));\n  const rand = (() => { let s = 99; return () => { s = (s * 1103515245 + 12345) & 0x7fffffff; return s / 0x7fffffff; }; })();\n  const mkRng = label => { let h = H.rngSeed; for (const ch of label) h = Math.imul(h ^ ch.charCodeAt(0), 16777619) >>> 0; return () => { h = (Math.imul(h, 1664525) + 1013904223) >>> 0; return h / 4294967296; }; };\n  const copies = (H.server ? [-1] : []).concat(ids);\n  for (const me of copies) {\n    const handlers = {}, pend = [], bucket = { t: 0, tokens: 40 };\n    const api = {\n      active: true, seeded: false, me, isHost: me === (H.server ? -1 : 0), host: H.server ? -1 : 0, server: me === -1, players: H.players,\n      connect: async () => { const info = { me, players: H.players, host: H.server ? -1 : 0, isHost: me === (H.server ? -1 : 0), server: me === -1, mode: 'shared-world', round: 1, limitMs: H.limitMs, seed: H.rngSeed }; Object.assign(api, info); return info; },\n      ready() { api._ready = true; }, answer(a) { H.log.push(['answer', me, a]); },\n      on(ev, fn) { (handlers[ev] = handlers[ev] || []).push(fn); for (const p of pend.filter(p => p[0] === ev)) fn(...p[1]); return () => {}; },\n      time() { return H.startAt === null ? -Infinity : H.now - H.startAt - 3000; },\n      rng: mkRng,\n      send(data, opt = {}) {\n        if (H.ended || api._left) return false;\n        const js = JSON.stringify(data); if (js.length > 16384) return false;\n        bucket.tokens = Math.min(40, bucket.tokens + (H.now - bucket.t) / 1000 * 20); bucket.t = H.now; if (bucket.tokens < 1) { H.log.push(['limited', me]); return false; } bucket.tokens--;\n        (H.sent[me] = H.sent[me] || []).push({ t: H.now, len: js.length, kind: data.t, reliable: opt.reliable !== false });\n        const tos = opt.to !== undefined ? [opt.to] : copies.filter(c => c !== me);\n        for (const to of tos) { if (opt.reliable === false && (rand() < (o.loss || 0) || js.length > 1200 && rand() < .3)) continue; const lat = (o.latency || 0) + (rand() - .5) * 2 * (o.jitter || 0); H.queue.push({ at: H.now + Math.max(0, lat), to, from: me, data: JSON.parse(js), rel: opt.reliable !== false }); }\n        return true;\n      },\n      finish(r) { if (H.finished) H.log.push(['finish twice']); H.finished = r; H.log.push(['finish', me, JSON.stringify(r.standings)]); },\n      result() {}, progress() {}, fail(msg) { H.log.push(['fail', me, msg]); },\n      _emit(ev, ...args) { if (handlers[ev]) for (const f of handlers[ev]) f(...args); else pend.push([ev, args]); }\n    };\n    H.copies.push({ me, api });\n  }\n  H.api = me => H.copies.find(c => c.me === me).api;\n  H.tick = ms => {\n    H.now += ms;\n    H.queue.sort((a, b) => a.at - b.at);\n    while (H.queue.length && H.queue[0].at <= H.now) { const q = H.queue.shift(); const c = H.copies.find(c => c.me === q.to); if (c && !c.api._left && !H.ended) c.api._emit('message', q.data, q.from); }\n    if (H.startAt === null && H.copies.every(c => c.api._ready)) { H.startAt = H.now; for (const c of H.copies) c.api._emit('start', { in: 3000 }); }\n    if (!H.ended && H.finished) { H.ended = true; for (const c of H.copies) if (!c.api._left) c.api._emit('end', { reason: 'finished', standings: H.finished.standings }); }\n  };\n  H.timeUp = () => { for (const c of H.copies) if (!c.api._left) c.api._emit('time-up', { graceMs: 5000 }); };\n  H.leave = id => { const c = H.copies.find(c => c.me === id); c.api._left = true; for (const d of H.copies) if (d.me !== id && !d.api._left) d.api._emit('leave', { id, reason: 'left' }); if (id === (H.server ? -1 : 0)) { H.ended = true; for (const d of H.copies) if (!d.api._left) d.api._emit('end', { reason: 'host-left' }); } };\n  return H;\n}\nEOF\ncat > test/suites/14-net.mjs <<'EOF'\n// The AI Hub session over a fake hub: traffic both ways, the message budget, snapshot sizes, prediction near the host,\n// play calls arriving, a player or the host leaving, a server host, time-up and the end.\nimport { load } from '../lib/context.mjs';\nimport { makeHub } from '../lib/fakehub.mjs';\nasync function run(n, o, steps, ok, label) {\n  const H = makeHub(n, o), C = H.copies.map(c => ({ me: c.me, ctx: load({ hub: c.api }) }));\n  const yieldp = () => new Promise(r => setImmediate(r));\n  for (const c of C) c.ctx.game.advance(.05); await yieldp(); await yieldp();\n  let t = 0, near = 0, nearN = 0;\n  for (let i = 0; i < steps; i++) {\n    for (const c of C) if (!H.copies.find(x => x.me === c.me).api._left) c.ctx.game.advance(1 / 30);\n    H.tick(1000 / 30); t += 1 / 30; if (i % 15 === 0) await yieldp();\n    if (o.leaveAt && Math.abs(t - o.leaveAt) < 1 / 60) H.leave(o.leaveId);\n    if (o.timeUpAt && Math.abs(t - o.timeUpAt) < 1 / 60) H.timeUp();\n    // prediction: a client's own athlete near the host's copy of it\n    const host = C.find(c => c.me === (H.server ? -1 : 0)), cl = C.find(c => c.me === 1);\n    if (host && cl && cl.ctx.FF.match && host.ctx.FF.match && cl.ctx.FF.match.phase === 'LIVE') { const a = cl.ctx.FF.match.on.find(x => x.ctl === 0); if (a) { const b = host.ctx.FF.match.all.find(x => x.id === a.id); if (b && !(b.downT > 0)) { nearN++; if (Math.hypot(a.x - b.x, a.y - b.y) < 2 * 16 + Math.hypot(b.vx, b.vy) * .25) near++; } } }\n    if (H.ended && i > 10 && !o.keep) { for (let k = 0; k < 10; k++) { for (const c of C) c.ctx.game.advance(1 / 30); H.tick(33); } break; }\n  }\n  const errs = C.flatMap(c => c.ctx.game.errors.map(e => 'p' + c.me + ': ' + e.message));\n  ok(label + ': no errors', !errs.length, errs.slice(0, 3).join(' | '));\n  return { H, C, near: nearN ? near / nearN : 1, nearN };\n}\nexport default async ok => {\n  // two players: the round plays, the host is told time is up and finishes once\n  let r = await run(2, { latency: 60 }, 30 * 70, ok, '2 players');\n  const { H } = r;\n  ok('2 players: both copies started a match', r.C.every(c => c.ctx.FF.match), r.C.map(c => c.ctx.game.sceneName).join(','));\n  ok('2 players: traffic both ways', (H.sent[0] || []).length > 20 && (H.sent[1] || []).length > 20, (H.sent[0] || []).length + ' / ' + (H.sent[1] || []).length);\n  const rate = me => { const s = H.sent[me] || []; let worst = 0; for (const m of s) worst = Math.max(worst, s.filter(x => x.t > m.t - 1000 && x.t <= m.t).length); return worst; };\n  ok('2 players: at most 18 messages a second from each copy', rate(0) <= 18 && rate(1) <= 18, rate(0) + ' / ' + rate(1));\n  ok('2 players: snapshots stay under 1,100 bytes', Math.max(...(H.sent[0] || []).filter(m => m.kind === 's').map(m => m.len)) <= 1100, Math.max(...(H.sent[0] || []).filter(m => m.kind === 's').map(m => m.len)));\n  ok('2 players: the client sees the live play', r.C[1].ctx.FF.match.on.length >= 14, r.C[1].ctx.FF.match.on.length);\n  ok('2 players: the predicted athlete stays near the host\\'s (95% when not locked)', r.near >= .9 || r.nearN < 30, r.near.toFixed(2) + ' of ' + r.nearN);\n  // time-up: the host finishes within the grace, everyone is told the end\n  r = await run(2, { latency: 100, timeUpAt: 30 }, 30 * 45, ok, 'time-up');\n  ok('time-up: finish called once with every player in the standings', !!r.H.finished && r.H.finished.standings.flat().sort().join() === '0,1' && !r.H.log.some(l => l[0] === 'finish twice'), JSON.stringify(r.H.finished));\n  ok('time-up: every copy ended', r.C.every(c => c.ctx.FF.net.ended));\n  const after = (r.H.sent[0] || []).filter(m => m.t > r.H.now - 100).length; ok('nothing is sent after the end', after === 0, after);\n  // four players with latency and loss; a player leaves: his athletes go back to the CPU\n  r = await run(4, { latency: 150, jitter: 50, loss: .05, leaveAt: 25, leaveId: 3, timeUpAt: 40 }, 30 * 50, ok, '4 players');\n  ok('4 players: the host finishes with the three left', r.H.finished && r.H.finished.standings.flat().length === 3, JSON.stringify(r.H.finished));\n  const m0 = r.C[0].ctx.FF.match; ok('4 players: the leaver\\'s athletes go back to the CPU', !m0.all.some(a => a.ctl === 'net:3'));\n  // the host leaves: the round ends for the others\n  r = await run(3, { latency: 80, leaveAt: 20, leaveId: 0, keep: true }, 30 * 25, ok, 'host leaves');\n  ok('host leaves: the clients end', r.C.filter(c => c.me !== 0).every(c => c.ctx.FF.net.ended && c.ctx.FF.net.endReason === 'host-left'));\n  // a server host with no player of its own\n  r = await run(2, { server: true, latency: 60, timeUpAt: 25 }, 30 * 35, ok, 'server');\n  ok('server: the server hosts and finishes', !!r.H.finished && r.C.find(c => c.me === -1).ctx.FF.net.server, JSON.stringify(r.H.finished));\n  ok('server: both players saw the match', r.C.filter(c => c.me >= 0).every(c => c.ctx.FF.match && c.ctx.FF.match.on.length >= 14));\n};\nEOF\ntimeout 1200 node test/run.mjs net 2>&1 | tail -16","description":"Write the fake hub and run the net suite","timeout":1260000}}}
