{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MNRLLt4j55dBgJMG6iYSNT","type":"tool_result","content":"1\t/**\n2\t * bridge.js — the hub's end of one game frame in a session.\n3\t *\n4\t * A game speaks the AI Hub Session Protocol over postMessage (lib/hub/README.md).\n5\t * The bridge checks every message, enforces the limits, and routes it: control\n6\t * messages (hello, ready, result, finish, error) to whoever coordinates the\n7\t * round (lib/hub/round.js), game traffic straight to the other players, and a\n8\t * game's answers on its own card to the page that holds it. What\n9\t * comes back from the network is checked again before it reaches the game,\n10\t * and anything from another round is dropped, so a slow packet can never land\n11\t * in the next game.\n12\t *\n13\t * The network is anything with `send(toKey, envelope, {reliable})`: the\n14\t * simulated one below (harness, tests), a BroadcastChannel between tabs, or a\n15\t * WebRTC mesh. Envelopes:\n16\t *   {k:'c', r, m}       to the coordinator: a message from this game\n17\t *   {k:'h', r, m}       from the coordinator: welcome, start, leave, time-up, end\n18\t *   {k:'g', r, f, d}    game traffic from player id f\n19\t *   {k:'p', r, f, d}    player id f's progress, {score, label}, for the scoreboard\n20\t */\n21\t\n22\texport const LIMITS = Object.freeze({\n23\t  maxBytes: 16_384,\n24\t  ratePerS: 20,\n25\t  burst: 40,\n26\t  queueMessages: 64,\n27\t  queueBytes: 262_144,\n28\t  /**\n29\t   * progress() reaches the hub about once a second. Two closer than this are a\n30\t   * report delivered late (a long task in the game) or a client misbehaving:\n31\t   * the later is dropped, and the next report, a second on, has the newest score.\n32\t   */\n33\t  progressMs: 250,\n34\t  label: 24,\n35\t});\n36\t\n37\tconst FROM_GAME = new Set(['hello', 'ready', 'send', 'result', 'finish', 'error', 'progress', 'fullscreen', 'answer']);\n38\t\n39\t/** A progress report, checked: a finite score and an optional short label. Null when it is not one. */\n40\texport function cleanProgress(p) {\n41\t  if (!p || typeof p !== 'object') return null;\n42\t  // A number, or text that is one: never null, '', true or [], which Number() would make 0 or 1.\n43\t  const score = typeof p.score === 'number' || (typeof p.score === 'string' && p.score.trim() !== '') ? Number(p.score) : NaN;\n44\t  if (!Number.isFinite(score)) return null;\n45\t  const label = typeof p.label === 'string' ? p.label.trim().slice(0, LIMITS.label) : '';\n46\t  return label ? { score, label } : { score };\n47\t}\n48\t\n49\t/**\n50\t * @param {object} o\n51\t * @param {string} o.key              this player's key in the session\n52\t * @param {number} o.round\n53\t * @param {string} o.coordinator      key of whoever runs round.js\n54\t * @param {(msg:object) => void} o.post            to the game frame\n55\t * @param {{send:Function}} o.net\n56\t * @param {{now:()=>number}} [o.clock]             the coordinator's time, as seen here\n57\t * @param {(issue:{key:string, problem:string}) => void} [o.onIssue]\n58\t * @param {(id:number, progress:{score:number, label?:string}) => void} [o.onProgress]   a player's\n59\t *        progress, this one's included, for the hub's scoreboard; it never reaches the games\n60\t * @param {(on:boolean) => void} [o.onFullscreen]   the game asked for fullscreen (or out of it): the\n61\t *        hub's page takes it, so the hub's own cards stay over the game\n62\t * @param {(what:'ready'|'more') => void} [o.onAnswer]   this player answered on the game's own card\n63\t */\n64\texport function createBridge({ key, round, coordinator, post, net, clock = Date, onIssue = () => {}, onProgress = () => {}, onFullscreen = () => {}, onAnswer = () => {} }) {\n65\t  let welcomed = false;\n66\t  let ended = false;\n67\t  let started = false;\n68\t  let helloSent = false;\n69\t  let ownsCard = false;\n70\t  let readySent = false;\n71\t  let me = null;\n72\t  let keys = [];\n73\t  const gone = new Set();\n74\t  const queue = [];\n75\t  let queuedBytes = 0;\n76\t  let tokens = LIMITS.burst;\n77\t  let refilled = clock.now();\n78\t  let progressAt = -Infinity;\n79\t  const issues = [];\n80\t  const stats = { sent: 0, received: 0, bytesSent: 0, dropped: 0 };\n81\t\n82\t  const toGame = (msg) => post({ aihub: 1, ...msg });\n83\t  const toHub = (m) => net.send(coordinator, { k: 'c', r: round, m }, { reliable: true });\n84\t  const issue = (problem) => {\n85\t    const entry = { key, problem };\n86\t    issues.push(entry);\n87\t    onIssue(entry);\n88\t  };\n89\t\n90\t  function fromGame(msg) {\n91\t    if (!msg || msg.aihub !== 1) return;\n92\t    if (!FROM_GAME.has(msg.type)) return issue(`unknown message type ${JSON.stringify(msg.type)}`);\n93\t    if (msg.type === 'fullscreen') return onFullscreen(msg.on === true);\n94\t    if (ended && msg.type !== 'error') return;\n95\t    switch (msg.type) {\n96\t      case 'hello':\n97\t        if (helloSent) return;\n98\t        helloSent = true;\n99\t        ownsCard = msg.card === true;\n100\t        return toHub({ type: 'hello', v: msg.v, client: String(msg.client || ''), mode: msg.mode ?? null, seats: msg.seats ?? null, card: ownsCard });\n101\t      case 'ready':\n102\t        if (!welcomed) return issue('ready before welcome');\n103\t        readySent = true;\n104\t        return toHub({ type: 'ready' });\n105\t      case 'answer':\n106\t        if (!ownsCard) return issue('answer without its own card: connect({ card: true })');\n107\t        if (!welcomed || started) return;\n108\t        if (msg.answer !== 'ready' && msg.answer !== 'more') return issue(`answer ${JSON.stringify(msg.answer)} is not ready or more`);\n109\t        return onAnswer(msg.answer);\n110\t      case 'result':\n111\t        if (!welcomed) return issue('result before welcome');\n112\t        return toHub({ type: 'result', time: msg.time, score: msg.score, stats: msg.stats, awards: msg.awards });\n113\t      case 'finish':\n114\t        if (!welcomed) return issue('finish before welcome');\n115\t        return toHub({ type: 'finish', standings: msg.standings, scores: msg.scores, won: msg.won, stats: msg.stats, awards: msg.awards });\n116\t      case 'error':\n117\t        return toHub({ type: 'error', message: String(msg.message || '').slice(0, 500), fatal: msg.fatal === true });\n118\t      case 'send':\n119\t        return sendGame(msg);\n120\t      case 'progress':\n121\t        return sendProgress(msg);\n122\t    }\n123\t  }\n124\t\n125\t  /** Progress goes to this hub's scoreboard and to every other player's, never to a game. */\n126\t  function sendProgress(msg) {\n127\t    if (!welcomed) return issue('progress before welcome');\n128\t    const p = cleanProgress(msg);\n129\t    if (!p) return issue('progress needs a finite score');\n130\t    const now = clock.now();\n131\t    if (now - progressAt < LIMITS.progressMs) {\n132\t      stats.dropped++;\n133\t      return;\n134\t    }\n135\t    progressAt = now;\n136\t    onProgress(me, p);\n137\t    const envelope = { k: 'p', r: round, f: me, d: p };\n138\t    for (const target of keys.filter((k, id) => id !== me && !gone.has(id))) net.send(target, envelope, { reliable: false });\n139\t  }\n140\t\n141\t  function sendGame(msg) {\n142\t    if (!welcomed) return issue('send before welcome');\n143\t    let text;\n144\t    try {\n145\t      text = JSON.stringify(msg.data);\n146\t    } catch {\n147\t      return issue('send: data is not JSON');\n148\t    }\n149\t    if (text === undefined) return issue('send: no data');\n150\t    if (text.length > LIMITS.maxBytes) {\n151\t      stats.dropped++;\n152\t      return issue(`send: ${text.length} bytes is over the ${LIMITS.maxBytes}-byte limit`);\n153\t    }\n154\t    const now = clock.now();\n155\t    tokens = Math.min(LIMITS.burst, tokens + ((now - refilled) / 1000) * LIMITS.ratePerS);\n156\t    refilled = now;\n157\t    if (tokens < 1) {\n158\t      stats.dropped++;\n159\t      return issue(`send: over ${LIMITS.ratePerS} messages a second`);\n160\t    }\n161\t    tokens -= 1;\n162\t    let targets;\n163\t    if (msg.to === undefined || msg.to === null) {\n164\t      targets = keys.filter((k, id) => id !== me && !gone.has(id));\n165\t    } else {\n166\t      if (!Number.isInteger(msg.to) || msg.to < 0 || msg.to >= keys.length || msg.to === me) {\n167\t        return issue(`send: no player ${JSON.stringify(msg.to)} to send to`);\n168\t      }\n169\t      if (gone.has(msg.to)) return;\n170\t      targets = [keys[msg.to]];\n171\t    }\n172\t    const reliable = msg.reliable !== false;\n173\t    const envelope = { k: 'g', r: round, f: me, d: JSON.parse(text) };\n174\t    for (const target of targets) net.send(target, envelope, { reliable });\n175\t    stats.sent++;\n176\t    stats.bytesSent += text.length;\n177\t  }\n178\t\n179\t  function deliverGame(fromKey, env) {\n180\t    if (ended || gone.has(env.f)) return;\n181\t    if (keys[env.f] !== fromKey) return issue(`traffic from ${fromKey} claims to be player ${env.f}`);\n182\t    stats.received++;\n183\t    toGame({ type: 'message', from: env.f, data: env.d });\n184\t  }\n185\t\n186\t  function fromNet(fromKey, env) {\n187\t    if (!env || env.r !== round) return;\n188\t    if (env.k === 'p') {\n189\t      const p = cleanProgress(env.d);\n190\t      if (welcomed && !ended && p && keys[env.f] === fromKey && !gone.has(env.f)) onProgress(env.f, p);\n191\t      return;\n192\t    }\n193\t    if (env.k === 'g') {\n194\t      if (welcomed) return deliverGame(fromKey, env);\n195\t      const size = JSON.stringify(env.d ?? null).length;\n196\t      if (queue.length >= LIMITS.queueMessages || queuedBytes + size > LIMITS.queueBytes) {\n197\t        stats.dropped++;\n198\t        return;\n199\t      }\n200\t      queue.push([fromKey, env]);\n201\t      queuedBytes += size;\n202\t      return;\n203\t    }\n204\t    if (env.k !== 'h' || fromKey !== coordinator || !env.m) return;\n205\t    const m = env.m;\n206\t    switch (m.type) {\n207\t      case 'welcome': {\n208\t        if (welcomed) return;\n209\t        welcomed = true;\n210\t        me = m.me;\n211\t        keys = Array.isArray(m.keys) ? m.keys : [];\n212\t        const { keys: _keys, round: _round, ...rest } = m;\n213\t        // The limits ride in the welcome, so a client of 1.3.0 or later follows whatever this hub enforces.\n214\t        toGame({ ...rest, round, limits: { maxBytes: LIMITS.maxBytes, ratePerS: LIMITS.ratePerS, burst: LIMITS.burst } });\n215\t        for (const [k, e] of queue.splice(0)) deliverGame(k, e);\n216\t        queuedBytes = 0;\n217\t        return;\n218\t      }\n219\t      case 'start':\n220\t        started = true;\n221\t        return toGame({ type: 'start', in: Math.round(m.at - clock.now()) });\n222\t      case 'leave':\n223\t        gone.add(m.id);\n224\t        return toGame({ type: 'leave', id: m.id, reason: m.reason });\n225\t      case 'time-up':\n226\t        return toGame({ type: 'time-up', graceMs: m.graceMs });\n227\t      case 'end':\n228\t        ended = true;\n229\t        return toGame({ type: 'end', reason: m.reason, ...(m.standings ? { standings: m.standings } : {}) });\n230\t    }\n231\t  }\n232\t\n233\t  return {\n234\t    key,\n235\t    round,\n236\t    fromGame,\n237\t    fromNet,\n238\t    /** The game's own card, while it is on: { left, paused, starting, ready, asking, asked } (lib/hub/README.md, \"The card\"). */\n239\t    card(state) {\n240\t      if (ownsCard && welcomed && !started && !ended) toGame({ type: 'card', ...state });\n241\t    },\n242\t    /** The page holding this frame was hidden or shown: the coordinator watches the host's. */\n243\t    visibility(hidden) {\n244\t      if (helloSent && !ended) toHub({ type: 'vis', hidden: !!hidden });\n245\t    },\n246\t    issues,\n247\t    stats,\n248\t    get me() {\n249\t      return me;\n250\t    },\n251\t    get ended() {\n252\t      return ended;\n253\t    },\n254\t    /** The game shows its own card, and has loaded: the hub's card steps aside for it. */\n255\t    get showsCard() {\n256\t      return ownsCard && readySent && !ended;\n257\t    },\n258\t  };\n259\t}\n260\t\n261\t/**\n262\t * Wire a bridge to an iframe: only messages from that frame's window count.\n263\t * Returns a function that unhooks it.\n264\t */\n265\texport function attachFrame(frame, onMessage) {\n266\t  const listener = (event) => {\n267\t    if (event.source !== frame.contentWindow) return;\n268\t    if (!event.data || event.data.aihub !== 1) return;\n269\t    onMessage(event.data);\n270\t  };\n271\t  addEventListener('message', listener);\n272\t  return () => removeEventListener('message', listener);\n273\t}\n274\t\n275\t/** Post to a frame. The games may be served from anywhere, and nothing here is secret. */\n276\texport const postTo = (frame) => (msg) => frame.contentWindow?.postMessage(msg, '*');\n277\t\n278\t/**\n279\t * A simulated network for the harness and tests: one-way latency with jitter,\n280\t * and loss for unreliable messages. Reliable messages stay in order per pair,\n281\t * as a WebRTC ordered channel would keep them.\n282\t */\n283\texport function createLocalNetwork({ latency = 0, jitter = 0, loss = 0, random = Math.random, clock = globalThis } = {}) {\n284\t  const endpoints = new Map();\n285\t  const pairs = new Map(); // \"from\\0to\" -> reliable messages waiting, in send order\n286\t  const now = () => (clock.performance?.now ? clock.performance.now() : Date.now());\n287\t  const settings = { latency, jitter, loss };\n288\t\n289\t  const deliver = (from, to, target, copy) => {\n290\t    if (endpoints.get(to) === target) for (const fn of target.listeners) fn(from, copy);\n291\t  };\n292\t\n293\t  /** Reliable traffic leaves each pair's queue strictly in order, never before its time. */\n294\t  function drain(pair) {\n295\t    const q = pairs.get(pair);\n296\t    q.timer = null;\n297\t    while (q.items.length && q.items[0].at <= now() + 0.5) {\n298\t      const { from, to, target, copy } = q.items.shift();\n299\t      deliver(from, to, target, copy);\n300\t    }\n301\t    if (q.items.length) q.timer = clock.setTimeout(() => drain(pair), Math.max(1, Math.ceil(q.items[0].at - now())));\n302\t  }\n303\t\n304\t  function endpoint(key) {\n305\t    const listeners = new Set();\n306\t    const self = {\n307\t      key,\n308\t      send(to, env, { reliable = true } = {}) {\n309\t        const target = endpoints.get(to);\n310\t        if (!target || !endpoints.has(key)) return;\n311\t        if (!reliable && random() < settings.loss) return;\n312\t        const copy = JSON.parse(JSON.stringify(env));\n313\t        const delay = to === key ? 0 : Math.max(0, settings.latency + (random() * 2 - 1) * settings.jitter);\n314\t        if (!reliable) {\n315\t          clock.setTimeout(() => deliver(key, to, target, copy), delay);\n316\t          return;\n317\t        }\n318\t        const pair = `${key}\\u0000${to}`;\n319\t        if (!pairs.has(pair)) pairs.set(pair, { items: [], timer: null });\n320\t        const q = pairs.get(pair);\n321\t        const last = q.items.at(-1)?.at ?? 0;\n322\t        q.items.push({ at: Math.max(now() + delay, last), from: key, to, target, copy });\n323\t        if (!q.timer) q.timer = clock.setTimeout(() => drain(pair), Math.ceil(delay));\n324\t      },\n325\t      onMessage(fn) {\n326\t        listeners.add(fn);\n327\t        return () => listeners.delete(fn);\n328\t      },\n329\t      close() {\n330\t        endpoints.delete(key);\n331\t      },\n332\t      listeners,\n333\t    };\n334\t    endpoints.set(key, self);\n335\t    return self;\n336\t  }\n337\t\n338\t  return { endpoint, settings };\n339\t}\n340\t"}]},"parent_tool_use_id":null,"session_id":"9dbc4055-18d5-4f5b-aa46-86fd0623cd25","uuid":"4f91e8a0-d613-4102-81a0-883c2381a249","timestamp":"2026-11-05T04:20:38.273Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211944__x51597c/work/.research/hub/bridge.js","content":"/**\n * bridge.js — the hub's end of one game frame in a session.\n *\n * A game speaks the AI Hub Session Protocol over postMessage (lib/hub/README.md).\n * The bridge checks every message, enforces the limits, and routes it: control\n * messages (hello, ready, result, finish, error) to whoever coordinates the\n * round (lib/hub/round.js), game traffic straight to the other players, and a\n * game's answers on its own card to the page that holds it. What\n * comes back from the network is checked again before it reaches the game,\n * and anything from another round is dropped, so a slow packet can never land\n * in the next game.\n *\n * The network is anything with `send(toKey, envelope, {reliable})`: the\n * simulated one below (harness, tests), a BroadcastChannel between tabs, or a\n * WebRTC mesh. Envelopes:\n *   {k:'c', r, m}       to the coordinator: a message from this game\n *   {k:'h', r, m}       from the coordinator: welcome, start, leave, time-up, end\n *   {k:'g', r, f, d}    game traffic from player id f\n *   {k:'p', r, f, d}    player id f's progress, {score, label}, for the scoreboard\n */\n\nexport const LIMITS = Object.freeze({\n  maxBytes: 16_384,\n  ratePerS: 20,\n  burst: 40,\n  queueMessages: 64,\n  queueBytes: 262_144,\n  /**\n   * progress() reaches the hub about once a second. Two closer than this are a\n   * report delivered late (a long task in the game) or a client misbehaving:\n   * the later is dropped, and the next report, a second on, has the newest score.\n   */\n  progressMs: 250,\n  label: 24,\n});\n\nconst FROM_GAME = new Set(['hello', 'ready', 'send', 'result', 'finish', 'error', 'progress', 'fullscreen', 'answer']);\n\n/** A progress report, checked: a finite score and an optional short label. Null when it is not one. */\nexport function cleanProgress(p) {\n  if (!p || typeof p !== 'object') return null;\n  // A number, or text that is one: never null, '', true or [], which Number() would make 0 or 1.\n  const score = typeof p.score === 'number' || (typeof p.score === 'string' && p.score.trim() !== '') ? Number(p.score) : NaN;\n  if (!Number.isFinite(score)) return null;\n  const label = typeof p.label === 'string' ? p.label.trim().slice(0, LIMITS.label) : '';\n  return label ? { score, label } : { score };\n}\n\n/**\n * @param {object} o\n * @param {string} o.key              this player's key in the session\n * @param {number} o.round\n * @param {string} o.coordinator      key of whoever runs round.js\n * @param {(msg:object) => void} o.post            to the game frame\n * @param {{send:Function}} o.net\n * @param {{now:()=>number}} [o.clock]             the coordinator's time, as seen here\n * @param {(issue:{key:string, problem:string}) => void} [o.onIssue]\n * @param {(id:number, progress:{score:number, label?:string}) => void} [o.onProgress]   a player's\n *        progress, this one's included, for the hub's scoreboard; it never reaches the games\n * @param {(on:boolean) => void} [o.onFullscreen]   the game asked for fullscreen (or out of it): the\n *        hub's page takes it, so the hub's own cards stay over the game\n * @param {(what:'ready'|'more') => void} [o.onAnswer]   this player answered on the game's own card\n */\nexport function createBridge({ key, round, coordinator, post, net, clock = Date, onIssue = () => {}, onProgress = () => {}, onFullscreen = () => {}, onAnswer = () => {} }) {\n  let welcomed = false;\n  let ended = false;\n  let started = false;\n  let helloSent = false;\n  let ownsCard = false;\n  let readySent = false;\n  let me = null;\n  let keys = [];\n  const gone = new Set();\n  const queue = [];\n  let queuedBytes = 0;\n  let tokens = LIMITS.burst;\n  let refilled = clock.now();\n  let progressAt = -Infinity;\n  const issues = [];\n  const stats = { sent: 0, received: 0, bytesSent: 0, dropped: 0 };\n\n  const toGame = (msg) => post({ aihub: 1, ...msg });\n  const toHub = (m) => net.send(coordinator, { k: 'c', r: round, m }, { reliable: true });\n  const issue = (problem) => {\n    const entry = { key, problem };\n    issues.push(entry);\n    onIssue(entry);\n  };\n\n  function fromGame(msg) {\n    if (!msg || msg.aihub !== 1) return;\n    if (!FROM_GAME.has(msg.type)) return issue(`unknown message type ${JSON.stringify(msg.type)}`);\n    if (msg.type === 'fullscreen') return onFullscreen(msg.on === true);\n    if (ended && msg.type !== 'error') return;\n    switch (msg.type) {\n      case 'hello':\n        if (helloSent) return;\n        helloSent = true;\n        ownsCard = msg.card === true;\n        return toHub({ type: 'hello', v: msg.v, client: String(msg.client || ''), mode: msg.mode ?? null, seats: msg.seats ?? null, card: ownsCard });\n      case 'ready':\n        if (!welcomed) return issue('ready before welcome');\n        readySent = true;\n        return toHub({ type: 'ready' });\n      case 'answer':\n        if (!ownsCard) return issue('answer without its own card: connect({ card: true })');\n        if (!welcomed || started) return;\n        if (msg.answer !== 'ready' && msg.answer !== 'more') return issue(`answer ${JSON.stringify(msg.answer)} is not ready or more`);\n        return onAnswer(msg.answer);\n      case 'result':\n        if (!welcomed) return issue('result before welcome');\n        return toHub({ type: 'result', time: msg.time, score: msg.score, stats: msg.stats, awards: msg.awards });\n      case 'finish':\n        if (!welcomed) return issue('finish before welcome');\n        return toHub({ type: 'finish', standings: msg.standings, scores: msg.scores, won: msg.won, stats: msg.stats, awards: msg.awards });\n      case 'error':\n        return toHub({ type: 'error', message: String(msg.message || '').slice(0, 500), fatal: msg.fatal === true });\n      case 'send':\n        return sendGame(msg);\n      case 'progress':\n        return sendProgress(msg);\n    }\n  }\n\n  /** Progress goes to this hub's scoreboard and to every other player's, never to a game. */\n  function sendProgress(msg) {\n    if (!welcomed) return issue('progress before welcome');\n    const p = cleanProgress(msg);\n    if (!p) return issue('progress needs a finite score');\n    const now = clock.now();\n    if (now - progressAt < LIMITS.progressMs) {\n      stats.dropped++;\n      return;\n    }\n    progressAt = now;\n    onProgress(me, p);\n    const envelope = { k: 'p', r: round, f: me, d: p };\n    for (const target of keys.filter((k, id) => id !== me && !gone.has(id))) net.send(target, envelope, { reliable: false });\n  }\n\n  function sendGame(msg) {\n    if (!welcomed) return issue('send before welcome');\n    let text;\n    try {\n      text = JSON.stringify(msg.data);\n    } catch {\n      return issue('send: data is not JSON');\n    }\n    if (text === undefined) return issue('send: no data');\n    if (text.length > LIMITS.maxBytes) {\n      stats.dropped++;\n      return issue(`send: ${text.length} bytes is over the ${LIMITS.maxBytes}-byte limit`);\n    }\n    const now = clock.now();\n    tokens = Math.min(LIMITS.burst, tokens + ((now - refilled) / 1000) * LIMITS.ratePerS);\n    refilled = now;\n    if (tokens < 1) {\n      stats.dropped++;\n      return issue(`send: over ${LIMITS.ratePerS} messages a second`);\n    }\n    tokens -= 1;\n    let targets;\n    if (msg.to === undefined || msg.to === null) {\n      targets = keys.filter((k, id) => id !== me && !gone.has(id));\n    } else {\n      if (!Number.isInteger(msg.to) || msg.to < 0 || msg.to >= keys.length || msg.to === me) {\n        return issue(`send: no player ${JSON.stringify(msg.to)} to send to`);\n      }\n      if (gone.has(msg.to)) return;\n      targets = [keys[msg.to]];\n    }\n    const reliable = msg.reliable !== false;\n    const envelope = { k: 'g', r: round, f: me, d: JSON.parse(text) };\n    for (const target of targets) net.send(target, envelope, { reliable });\n    stats.sent++;\n    stats.bytesSent += text.length;\n  }\n\n  function deliverGame(fromKey, env) {\n    if (ended || gone.has(env.f)) return;\n    if (keys[env.f] !== fromKey) return issue(`traffic from ${fromKey} claims to be player ${env.f}`);\n    stats.received++;\n    toGame({ type: 'message', from: env.f, data: env.d });\n  }\n\n  function fromNet(fromKey, env) {\n    if (!env || env.r !== round) return;\n    if (env.k === 'p') {\n      const p = cleanProgress(env.d);\n      if (welcomed && !ended && p && keys[env.f] === fromKey && !gone.has(env.f)) onProgress(env.f, p);\n      return;\n    }\n    if (env.k === 'g') {\n      if (welcomed) return deliverGame(fromKey, env);\n      const size = JSON.stringify(env.d ?? null).length;\n      if (queue.length >= LIMITS.queueMessages || queuedBytes + size > LIMITS.queueBytes) {\n        stats.dropped++;\n        return;\n      }\n      queue.push([fromKey, env]);\n      queuedBytes += size;\n      return;\n    }\n    if (env.k !== 'h' || fromKey !== coordinator || !env.m) return;\n    const m = env.m;\n    switch (m.type) {\n      case 'welcome': {\n        if (welcomed) return;\n        welcomed = true;\n        me = m.me;\n        keys = Array.isArray(m.keys) ? m.keys : [];\n        const { keys: _keys, round: _round, ...rest } = m;\n        // The limits ride in the welcome, so a client of 1.3.0 or later follows whatever this hub enforces.\n        toGame({ ...rest, round, limits: { maxBytes: LIMITS.maxBytes, ratePerS: LIMITS.ratePerS, burst: LIMITS.burst } });\n        for (const [k, e] of queue.splice(0)) deliverGame(k, e);\n        queuedBytes = 0;\n        return;\n      }\n      case 'start':\n        started = true;\n        return toGame({ type: 'start', in: Math.round(m.at - clock.now()) });\n      case 'leave':\n        gone.add(m.id);\n        return toGame({ type: 'leave', id: m.id, reason: m.reason });\n      case 'time-up':\n        return toGame({ type: 'time-up', graceMs: m.graceMs });\n      case 'end':\n        ended = true;\n        return toGame({ type: 'end', reason: m.reason, ...(m.standings ? { standings: m.standings } : {}) });\n    }\n  }\n\n  return {\n    key,\n    round,\n    fromGame,\n    fromNet,\n    /** The game's own card, while it is on: { left, paused, starting, ready, asking, asked } (lib/hub/README.md, \"The card\"). */\n    card(state) {\n      if (ownsCard && welcomed && !started && !ended) toGame({ type: 'card', ...state });\n    },\n    /** The page holding this frame was hidden or shown: the coordinator watches the host's. */\n    visibility(hidden) {\n      if (helloSent && !ended) toHub({ type: 'vis', hidden: !!hidden });\n    },\n    issues,\n    stats,\n    get me() {\n      return me;\n    },\n    get ended() {\n      return ended;\n    },\n    /** The game shows its own card, and has loaded: the hub's card steps aside for it. */\n    get showsCard() {\n      return ownsCard && readySent && !ended;\n    },\n  };\n}\n\n/**\n * Wire a bridge to an iframe: only messages from that frame's window count.\n * Returns a function that unhooks it.\n */\nexport function attachFrame(frame, onMessage) {\n  const listener = (event) => {\n    if (event.source !== frame.contentWindow) return;\n    if (!event.data || event.data.aihub !== 1) return;\n    onMessage(event.data);\n  };\n  addEventListener('message', listener);\n  return () => removeEventListener('message', listener);\n}\n\n/** Post to a frame. The games may be served from anywhere, and nothing here is secret. */\nexport const postTo = (frame) => (msg) => frame.contentWindow?.postMessage(msg, '*');\n\n/**\n * A simulated network for the harness and tests: one-way latency with jitter,\n * and loss for unreliable messages. Reliable messages stay in order per pair,\n * as a WebRTC ordered channel would keep them.\n */\nexport function createLocalNetwork({ latency = 0, jitter = 0, loss = 0, random = Math.random, clock = globalThis } = {}) {\n  const endpoints = new Map();\n  const pairs = new Map(); // \"from\\0to\" -> reliable messages waiting, in send order\n  const now = () => (clock.performance?.now ? clock.performance.now() : Date.now());\n  const settings = { latency, jitter, loss };\n\n  const deliver = (from, to, target, copy) => {\n    if (endpoints.get(to) === target) for (const fn of target.listeners) fn(from, copy);\n  };\n\n  /** Reliable traffic leaves each pair's queue strictly in order, never before its time. */\n  function drain(pair) {\n    const q = pairs.get(pair);\n    q.timer = null;\n    while (q.items.length && q.items[0].at <= now() + 0.5) {\n      const { from, to, target, copy } = q.items.shift();\n      deliver(from, to, target, copy);\n    }\n    if (q.items.length) q.timer = clock.setTimeout(() => drain(pair), Math.max(1, Math.ceil(q.items[0].at - now())));\n  }\n\n  function endpoint(key) {\n    const listeners = new Set();\n    const self = {\n      key,\n      send(to, env, { reliable = true } = {}) {\n        const target = endpoints.get(to);\n        if (!target || !endpoints.has(key)) return;\n        if (!reliable && random() < settings.loss) return;\n        const copy = JSON.parse(JSON.stringify(env));\n        const delay = to === key ? 0 : Math.max(0, settings.latency + (random() * 2 - 1) * settings.jitter);\n        if (!reliable) {\n          clock.setTimeout(() => deliver(key, to, target, copy), delay);\n          return;\n        }\n        const pair = `${key}\\u0000${to}`;\n        if (!pairs.has(pair)) pairs.set(pair, { items: [], timer: null });\n        const q = pairs.get(pair);\n        const last = q.items.at(-1)?.at ?? 0;\n        q.items.push({ at: Math.max(now() + delay, last), from: key, to, target, copy });\n        if (!q.timer) q.timer = clock.setTimeout(() => drain(pair), Math.ceil(delay));\n      },\n      onMessage(fn) {\n        listeners.add(fn);\n        return () => listeners.delete(fn);\n      },\n      close() {\n        endpoints.delete(key);\n      },\n      listeners,\n    };\n    endpoints.set(key, self);\n    return self;\n  }\n\n  return { endpoint, settings };\n}\n","numLines":340,"startLine":1,"totalLines":340}},"tool_result_meta":[{"id":"toolu_01MNRLLt4j55dBgJMG6iYSNT","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
