94,107,'added on import',['Date, Source, Plan, Genre and Perspective, Tech, Art Direction, Animation, Audio, Online, Testing, Research, Environment, Model, Usage','`artDirection`','`added on import`','never estimate']),\n (109,109,'Exit interview',['The exit interview and the feedback','check that it parses','beside the game']),(110,127,'sourceInformation',['\"sourceInformation\"','\"aiHub\"']),\n (128,128,'catalogue',[\"catalogue's model, effort, CLI, date and usage\"]),(130,135,'How many issues',['**Testing Feedback**']),(137,144,'like most about the engine',['**Engine Feedback**']),(146,151,'What was confusing',['**Prompt Feedback**']),\n]\ncovered, fails = set(), []\nfor a, b, key, must in R:\n    span = '\\n'.join(task[a-1:b]); bad = [] if key.lower() in span.lower() else [f'TASK lacks {key}']\n    bad += [f'plan lacks \"{m}\"' for m in must if not where(m)]\n    covered.update(range(a, b+1))\n    if bad: fails.append((a, b, bad))\nnonblank = {i+1 for i, l in enumerate(task) if l.strip()}\nunmapped = sorted(nonblank - covered)\nprint(f\"coverage rows: {len(R)}, failed: {len(fails)} {fails or ''}\")\nprint(f\"TASK.md non-blank lines: {len(nonblank)}, mapped: {len(nonblank & covered)}, unmapped: {unmapped}\")\nextra = []\ndef check(ok, label):\n    extra.append((ok, label))\n    if not ok: print('FAIL', label)\nshape_task = '\\n'.join(task[109:127])\nplan_shape = next((b for b in re.findall(r'```json\\n(.*?)\\n```', plan_text, re.S) if '\"sourceInformation\"' in b), '')\ncheck(plan_shape == shape_task, 'exit interview block byte-identical to TASK.md 110-127')\nJ = json.loads(plan_shape)\ncheck(json.loads(shape_task) == J and list(J) == ['sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub'] and len(J['sourceInformation']) == 15 and len(J['aiHub']) == 10, 'shape: keys')\nfor name, x, y in [('Testing',132,135),('Engine',139,144),('Prompt',148,151)]:\n    qs = [l for l in task[x-1:y] if l.startswith('- ')]\n    check(all(q in plan for q in qs), f'{name} questions word for word')\nsec = plan_text[plan_text.index('**`sourceInformation`**'):plan_text.index('**Answer each of these')]\ncheck(not [k for k in J['sourceInformation'] if f'`{k}`' not in sec], 'every sourceInformation key has a row')\nsug = plan_text[plan_text.index('**`aiHub`:**'):]\ntags = re.findall(r'`([^`]+)`', re.search(r'- tags: (.*)', sug).group(1))\nallowed = re.search(r'e\\.g\\. (.*)$', J['aiHub']['tags'][0]).group(1).split(', ')\ncheck(re.search(r'type: `(.*?)`', sug).group(1) in ['Game','Tech demo','Tool'] and re.search(r'genre: `(.*?)`', sug).group(1) in J['aiHub']['genre'].replace('one of ','').split(', ') and 'players: `1–4`' in sug and 3 <= len(tags) <= 6 and all(t in allowed for t in tags), 'suggested aiHub values allowed')\nfor bad in ['GameTitle','claude-opus','20261104-211944','exit-interview.json','planner-exit']:\n    check(bad not in plan_text, f'plan leaves out {bad}')\nd = json.load(open('planner-exit-interview.json'))\nqs = re.findall(r'^- (.*\\?)$', stage, re.M)\ncheck(isinstance(d, list) and all(set(x) == {'question','answer'} for x in d) and [x['question'] for x in d] == qs and len(qs) == 4 and all(len(x['answer']) > 40 for x in d), 'planner interview shape and questions')\nheads = {int(m) for m in re.findall(r'^## (\\d+)\\.', plan_text, re.M)}\ncheck({int(m) for m in re.findall(r'section (\\d+)', plan_text)} <= heads, 'section refs')\nfacts = {int(x) for x in re.findall(r'^(\\d+)\\. ', plan_text[plan_text.index('## 2. Facts'):plan_text.index('## 3. World')], re.M)}\ncheck({int(m) for m in re.findall(r'item (\\d+)', plan_text)} <= facts and 31 in facts, f'item refs ({len(facts)} facts)')\ncheck('Heroes start at level 12' in plan_text and 'a level 30 hero with every skill' in plan_text and 'level 20 hero' not in plan_text, 'levels')\ncheck(not re.search(r'(?<!\\*)\\*Requiem:\\*(?!\\*)', plan_text) and not re.search(r'(?<!\\*)\\*Penance\\*(?!\\*)', plan_text), 'names mean one thing')\ncheck('`series` may be empty' in plan_text and '−3%' not in plan_text and 'rng.fork' not in plan_text, 'fixes in place')\nprint(f\"other checks: {len(extra)}, failed: {sum(1 for ok, _ in extra if not ok)}\")\nPY\ncat > .audit/scripts/substance.py <<'PY'\n# For each TASK.md requirement: the plan's actual instruction, quoted, and my judgement of it.\nimport re\nplan = open('PLAN.md', encoding='utf-8').read().split('\\n')\ndef quote(anchor):\n    for i, l in enumerate(plan):\n        if anchor.lower() in l.lower():\n            parts = re.split(r'(?<=[.!?])\\s+', l)\n            s = next((p for p in parts if anchor.lower() in p.lower()), l).strip(' |-*')\n            return i + 1, (s[:165] + '...') if len(s) > 168 else s\n    return None, None\nE = [\n ('1,68','Original game inspired by the source','This is a new game in the same genre','Names what to take and what never to copy; banned-name lint enforces it.'),\n ('72','Capture its world, characters, themes, tone','A grim old keeper of lore','Each trait has a named counterpart to build (section 1 table, section 3 bible).'),\n ('72','...turned into mechanics','Skills with swappable modifiers','Mechanics mapped one by one, with full data tables in sections 4 to 7.'),\n ('72','...into pacing','Pacing target: about 60 minutes','Minutes per zone, checked by the balance report.'),\n ('72','...into UX','one job per screen','Fifteen screens specified in section 10.'),\n ('3','Genre chosen','co-op action RPG (hack-and-slash','A decision, not a menu of options.'),\n ('5','Perspective chosen','viewHeight: 11.5, pitch: 42, yaw: 45 }` looks right','Exact camera values, rendered and looked at.'),\n ('7','Title: riff, 50 ideas, real RNG','silently brainstorm 50 titles','Method given; the title itself stays with the builder, as STAGE.md says.'),\n ('9','Research is a choice','No more source research is needed','Section 1 supplies it; they may still choose more, and report it.'),\n ('11','Single HTML package','One HTML file,','Recipe run here: boots on file://, passes the hub harness.'),\n ('11','Dependencies optional','TASK.md allows CDN dependencies','Deliberately inlines all, which is what makes file:// work.'),\n ('13','Build on the kit, engine as shipped','Never edit `pixel-engine.js`','Absolute rule, with a hash test.'),\n ('13','Systems on top of it','`src/sim` is plain JavaScript','Architecture says where every system lives.'),\n ('15','Native style as the base','the engine\\'s native look','Named look preset and rules to follow.'),\n ('15','New art that feels like the source','square shoulders, cowl','Asset list for heroes, NPCs, monsters, bosses, props; template verified.'),\n ('15','Library fine for generic props','use it freely for generic props','Families named; ids in the plan exist.'),\n ('17','Native animation as the base','Use `HERO_CLIPS` on every humanoid','Verified working on custom bodies.'),\n ('17','New animations','New clips, as `ClipDef`s','17 clips named, format verified.'),\n ('19','Everything in code, no audio files','Everything is synthesised in code','Sounds and songs are data; 60+ sounds, 10 songs specified.'),\n ('19','Gibberish voices','No real speech','Concrete method: syllable bank, hash, per-speaker settings.'),\n ('19','Music at 10% by default','call `audio.setVolume(\\'music\\', 0.1)`','Handles the engine default of 0.6 and its Reset; tested on first run.'),\n ('21,78','Hub integration','AIHub.connect({ mode: \\'shared-world\\'','Mode, tags, flow, round, end all specified; harness run here.'),\n ('78','Hub: results and end','AIHub.finish({ standings, scores, won: true','Standings, time-up and end are spelled out.'),\n ('78','...and the game on its own','Opened directly, with no hub','Interpretation stated: full solo plus couch co-op. Flagged to the user as a judgement call.'),\n ('24','Dev folder, modules, bundle','The day-to-day loop:','With a folder layout; names come from each TASK.md.'),\n ('24','Prefer file:// and headless tools','Prefer `file://`','And section 2 shows how.'),\n ('24','Server rule','bind `127.0.0.1` on a port the OS picks','And confirm the page, in section 16.'),\n ('24','Stop own processes only','Stop only processes you started','Lists the banned commands.'),\n ('26','Unlimited budget, no optimisation','as much detail and as many monsters','States scale and that optimising is out of scope.'),\n ('26','...lights and shadows','Everything casts and receives shadows','Added after this review found shadows missing.'),\n ('28','Scripted whole-game playthrough','Whole-game playthrough, once per class','Per class, through real menus, with a list of asserts.'),\n ('28','One command, failures and a count','runs everything and prints **only failures','Exactly as asked, with one flag per tier.'),\n ('28','Rerun only when code changes','rerun only the tier','Tier flags make this possible.'),\n ('28','Screenshots only where needed','Use screenshots only for what a script can','A fixed list, for judging looks.'),\n ('28','No review subagents','Don\\'t use subagents or workflows','Stated.'),\n ('52','Stand-in: pad','stubbed `navigator.getGamepads`','A whole flow by pad alone.'),\n ('53','Stand-in: touch','tapping with `page.touchscreen`','Phone and tablet profiles.'),\n ('54','Stand-in: listener','Sound, by what Web Audio produces','Analyser tap on real output, plus renderSound.'),\n ('55','Stand-in: second player','drive P2 by synthetic keys','Beyond the protocol: asserts P2 moves in P1\\'s world.'),\n ('56','Stand-in: iPhone','WebKit here has no WebGPU','Honest limit noted.'),\n ('57','Stand-in: TV','at 1920×1080','10-foot view judged at that size.'),\n ('61-64','Sharing rules','Stay out of the folders beside yours','Restated with the one correction to TASK.md\\'s flags.'),\n ('72','Show ALL features','TASK.md wants every feature shown','Table of 15 rows; tests assert each. Devotion hole fixed via The Last Bell.'),\n ('72','Player understands what they can and can\\'t do','How to Play** in six big pages','Plus contextual tutorial prompts.'),\n ('72','Polished vertical slice','treated as a complete, polished vertical slice','The stated bar, with a feel recipe.'),\n ('72','Infrastructure for designer tools','So the rest of the game can be built later','All content is data, with a recipe page.'),\n ('74','Dev mode from the pause menu','Pause menu → Dev Mode','Pause screen lists it; pad-navigable.'),\n ('74','Standard testing tools','*Spawn:* any monster','Seven groups of tools.'),\n ('74','Live sliders','Monster HP, Monster damage, Monster density','18 named; the sim reads them live.'),\n ('74','Reset to defaults','Reset to defaults** button','Test confirms it restores.'),\n ('76','Attract after 10 s idle on title or menu','After **10 seconds with no input','Both screens; tested by stepping 600 frames.'),\n ('76','Loops, may cheat','cheating freely','Scripted tour of 7 stops covering every zone and class.'),\n ('76','Any input exits','**Any input**','Defines input for each device.'),\n ('80','Writing style like the source\\'s','High gothic proclamation','Three registers and 32 sample lines to write from.'),\n ('83','Designed for a DualSense or standard pad','Triangle (3), Circle (1)','Full button map with standard-mapping indices.'),\n ('83','TV at 10 feet','Body text is scale 1','Sizes, safe zone, checked by 1080p shots.'),\n ('83','Same game, same screens','the same screens for pad and mouse','Single UI layer.'),\n ('83','Keyboard and mouse feel native','Left click on a monster walks into range and attacks','Click-to-move, hold to steer, shift-click: real genre behaviour, not stand-ins.'),\n ('83','Keys PC players expect','I or C (gear), K (skills), L (quests)','Full key table.'),\n ('83','Hover moves focus','Mouse hover moves focus when the pointer moved','Tested with page.mouse.move.'),\n ('83','Prompts follow last input','`lastDevice` flips to `pad`','Defined and used everywhere; tested.'),\n ('83','PlayStation glyphs by default','PlayStation (default)','Sprite list given.'),\n ('83','Xbox glyphs in Se