 = []\n    for m in must:\n        w = where(m)\n        if w: hits.append(w[0])\n        else: bad.append(f'plan lacks \"{m}\"')\n    covered.update(range(a, b+1))\n    if bad: fails.append(label)\n    print(f\"{'FAIL' if bad else 'ok  '} TASK {a:>3}-{b:<3} {label[:54]:<54} plan {sorted(set(hits))[:7]}\" + (('  <-- ' + '; '.join(bad)) if bad else ''))\nnonblank = {i+1 for i, l in enumerate(task) if l.strip()}\nunmapped = sorted(nonblank - covered)\n\nextra = []\ndef check(ok, label):\n    extra.append((ok, label)); print(f\"{'ok  ' if ok else 'FAIL'} {label}\")\n\nprint('\\n--- exit interview, compared exactly with TASK.md')\nshape_task = '\\n'.join(task[109:127])\nblocks = re.findall(r'```json\\n(.*?)\\n```', plan_text, re.S)\nplan_shape = next((b for b in blocks if '\"sourceInformation\"' in b), '')\ncheck(plan_shape == shape_task, 'plan\\'s JSON block is byte-identical to TASK.md lines 110-127')\ncheck(json.loads(plan_shape) == json.loads(shape_task), 'it parses, and equals TASK.md\\'s object')\nJ = json.loads(plan_shape)\ncheck(list(J) == ['sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub'], 'top-level keys and order: ' + ', '.join(J))\ncheck(len(J['sourceInformation']) == 15 and J['sourceInformation']['usage'] == 'added on import', f\"sourceInformation has {len(J['sourceInformation'])} keys; usage is 'added on import'\")\ncheck(len(J['aiHub']) == 10, f\"aiHub has {len(J['aiHub'])} keys\")\nfor name, x, y in [('Testing',132,135),('Engine',139,144),('Prompt',148,151)]:\n    qs = [l for l in task[x-1:y] if l.startswith('- ')]\n    check(all(q in plan for q in qs), f'{name} Feedback: all {len(qs)} questions are in the plan word for word')\nfields = re.findall(r'^- (Date|Source|Plan|Genre and Perspective|Tech|Art Direction|Animation|Audio|Online|Testing|Research|Environment|Model|Usage):', '\\n'.join(task[93:107]), re.M)\nabout = next(l for l in plan if l.count('Date, Source, Plan') == 1 and 'Usage' in l)\ncheck(len(fields) == 14 and ', '.join(fields) in about, f'all {len(fields)} Source Information labels are on the About page, in TASK.md\\'s order')\nsec = plan_text[plan_text.index('**`sourceInformation`**'):plan_text.index('**Answer each of these')]\nmissing = [k for k in J['sourceInformation'] if f'`{k}`' not in sec]\ncheck(not missing, f'every sourceInformation key has a \"what to write\" row; missing: {missing}')\n\nprint('\\n--- suggested aiHub values against what TASK.md allows')\nsug = plan_text[plan_text.index('**`aiHub`:**'):]\ntags = re.findall(r'`([^`]+)`', re.search(r'- tags: (.*)', sug).group(1))\nallowed_tags = re.search(r'e\\.g\\. (.*)$', J['aiHub']['tags'][0]).group(1).split(', ')\ngenres = J['aiHub']['genre'].replace('one of ', '').split(', ')\ncheck(re.search(r'type: `(.*?)`', sug).group(1) in ['Game','Tech demo','Tool'], 'type is an allowed value')\ncheck(re.search(r'genre: `(.*?)`', sug).group(1) in genres, 'genre is an allowed value')\ncheck('players: `1–4`' in sug, 'players uses TASK.md\\'s form')\ncheck(3 <= len(tags) <= 6 and all(t == t.lower() and t in allowed_tags for t in tags), f'{len(tags)} lowercase tags, all from TASK.md\\'s list')\n\nprint('\\n--- STAGE.md')\nfor bad in ['GameTitle','claude-opus','20261104-211944','exit-interview.json','planner-exit']:\n    check(bad not in plan_text, f'plan leaves out the name: {bad}')\nd = json.load(open('planner-exit-interview.json'))\nqs = re.findall(r'^- (.*\\?)$', stage, re.M)\ncheck(isinstance(d, list) and all(set(x) == {'question','answer'} for x in d), 'planner-exit-interview.json is a list of {question, answer}')\ncheck([x['question'] for x in d] == qs and len(qs) == 4, 'its 4 questions match STAGE.md exactly, in order')\ncheck(all(len(x['answer']) > 40 for x in d), 'every answer is filled in')\n\nprint('\\n--- plan consistency')\nheads = {int(m) for m in re.findall(r'^## (\\d+)\\.', plan_text, re.M)}\nrefs = {int(m) for m in re.findall(r'section (\\d+)', plan_text)}\ncheck(refs <= heads, f'every \"section N\" exists: {sorted(refs)}')\nitems = {int(m) for m in re.findall(r'item (\\d+)', plan_text)}\nfacts = {int(x) for x in re.findall(r'^(\\d+)\\. ', plan_text[plan_text.index('## 2. Facts'):plan_text.index('## 3. World')], re.M)}\ncheck(items <= facts, f'every \"item N\" exists among the {len(facts)} facts in section 2')\ncheck('level 10 with' not in plan_text and 'Heroes start at level 12' in plan_text, 'session heroes start at level 12')\ncheck('level 20 hero' not in plan_text and 'a level 30 hero with every skill' in plan_text, 'The Last Bell is a level 30 hero')\ncheck(not re.search(r'(?<!\\*)\\*Requiem:\\*(?!\\*)', plan_text) and '*Finale:*' in plan_text, 'the Tone is Finale; Requiem means only the kill streak')\ncheck(not re.search(r'(?<!\\*)\\*Penance\\*(?!\\*)', plan_text) and '*Contrition*' in plan_text, 'the Vow is Contrition; Penance means only the difficulty tiers')\ntbl = plan_text[plan_text.index('### Where the player meets each feature'):]; tbl = tbl[:tbl.index('\\n---')]\nrows = [r for r in tbl.split('\\n') if r.startswith('|') and not r.startswith('|---') and 'First met' not in r]\ncheck(len(rows) == 15 and all(len(r.split('|')[2].strip()) > 2 for r in rows), f'feature table: {len(rows)} rows, all filled')\ncheck('`series` may be empty' in plan_text, 'the shape test allows an empty series, as TASK.md does')\n\nfailed_extra = [l for ok, l in extra if not ok]\nprint(f\"\\nSUMMARY: {len(R)} coverage rows, {len(fails)} failed. TASK.md non-blank lines {len(nonblank)}, mapped {len(nonblank & covered)}, unmapped {unmapped}. Other checks {len(extra)}, failed {len(failed_extra)}.\")\nif fails or failed_extra or unmapped: print('FAILURES:', fails, failed_extra, unmapped)\nPY\necho; echo \"--- folder\"; ls -A; sha256sum PLAN.md | cut -c1-16","description":"Run the complete audit on the final PLAN.md"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5103,"cache_rea