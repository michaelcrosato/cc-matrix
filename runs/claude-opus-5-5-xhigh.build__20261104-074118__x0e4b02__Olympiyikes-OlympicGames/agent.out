amps.add(ctx.def.turboName, { dur: 1.2, scale: 2, y: 92,\")\np.write_text(s)\nEOF\ngrep -c \"O.humanSkill\" src/12-eventkit.js","description":"Add a human skill override and shrink turbo stamp"}}}
