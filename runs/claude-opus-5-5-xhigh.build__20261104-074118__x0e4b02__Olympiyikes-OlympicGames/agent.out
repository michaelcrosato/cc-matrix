6)[1];\", \"const top = r.w(0, -30, 70)[1], horizon = r.w(0, -24, 50)[1];\")\ns = s.replace(\"const yT0 = 18, yT1 = 140;\", \"const yT0 = 18, yT1 = 196;\")\ns = s.replace(\"for (let i = 0; i <= 8; i++) { const ly = LANE_Y(i) - 7 + (i === 8 ? 0 : 0); const yy = i === 8 ? LANE_Y(7) - 7 : LANE_Y(i) + 7; Art.wline(r, [xa, yy, 0], [xb, yy, 0], '#f4f0e8', 1); void ly; }\",\n              \"for (let i = 0; i <= 8; i++) { const yy = i === 8 ? LANE_Y(7) - 11 : LANE_Y(i) + 11; Art.wline(r, [xa, yy, 0], [xb, yy, 0], '#f4f0e8', 1); }\")\ns = s.replace(\"const fx = 1200; for (let j = 0; j < 30; j++) { const y0 = yT0 + j * 4.1;\", \"const fx = 1200; for (let j = 0; j < 44; j++) { const y0 = yT0 + j * 4;\")\ns = s.replace(\"[fx + 2, y0 + 4.1, 0], [fx - 2, y0 + 4.1, 0]]\", \"[fx + 2, y0 + 4, 0], [fx - 2, y0 + 4, 0]]\")\ns = s.replace(\"const a = r.w(k * 64, 146, 0), b = r.w(k * 64 + 62, 146, 7);\", \"const a = r.w(k * 64, 204, 0), b = r.w(k * 64 + 62, 204, 7);\")\ns = s.replace(\"const a = r.w(x, 10, 0), b = r.w(x, 10, 64), c = r.w(x, 150, 0);\", \"const a = r.w(x, 10, 0), b = r.w(x, 10, 64), c = r.w(x, 200, 0);\")\ns = s.replace(\"game.focus(Math.min(ctx.w.camX, 1280), 66, 26);\", \"game.focus(Math.min(ctx.w.camX, 1280), 107, 29);\")\ns = s.replace(\"if (!s) { game.focus(60, 66, 26); return; }\", \"if (!s) { game.focus(60, 107, 29); return; }\")\ns = s.replace(\"tx = lerp(-30, -30, k); game.focus(tx + 60, lerp(30, 128, k) * .4 + 30, 26); return; }\", \"tx = lerp(-60, 40, k); game.focus(tx + 60, 107, 29); return; }\")\ns = s.replace(\"ctx.fx(P => P.smoke(-30, 150, 40, 6, { size: 4, color: '#e8e8e8' }));\", \"ctx.fx(P => P.smoke(-30, 200, 40, 6, { size: 4, color: '#e8e8e8' }));\")\ns = s.replace(\"[1, 6, 0.7, 'Top speed (m/s)']\", \"x\")\ns = s.replace(\"'Acceleration (m/s²)'\", \"'Acceleration (m/s/s)'\").replace(\"'Deceleration (m/s²)'\", \"'Deceleration (m/s/s)'\")\np.write_text(s)\np = pathlib.Path('src/12-eventkit.js'); s = p.read_text()\ns = s.replace(\"tag(g, def, o = {}) { c