_modules/three/src/materials/nodes/MeshToonNodeMaterial.js:37:\t\tthis.isMeshToonNodeMaterial = true;\nnode_modules/three/src/materials/nodes/MeshToonNodeMaterial.js:66:export default MeshToonNodeMaterial;\n/*! aihub-session 1.4.0 — AI Hub Session Protocol v1 client. Paste it into your game unmodified. */\n(function (root) {\n  'use strict';\n  if (root.AIHub) return;\n\n  var VERSION = '1.4.0';\n  var HELLO_EVERY_MS = 500;\n  var HELLO_TIMEOUT_MS = 10000;\n  var PROGRESS_EVERY_MS = 1000;\n  /** The hub's welcome may change these; a newer hub never needs a newer copy of this file for it. */\n  var limits = { maxBytes: 16384, ratePerS: 20, burst: 40 };\n\n  var framed = false;\n  try {\n    framed = root.parent && root.parent !== root;\n  } catch (e) {\n    framed = true;\n  }\n  var search = String(root.location && root.location.search);\n  var flagged = /[?&]aihub=/.test(search);\n  var seedArg = /[?&]aihub-seed=(\\d+)/.exec(search);\n\n  var hub = {\n    version: VERSION,\n    protocol: 1,\n    /** True when the hub launched this page for a session (?aihub=1 inside a frame). */\n    active: !!(flagged && framed),\n    me: null,\n    host: null,\n    isHost: false,\n    players: [],\n    mode: null,\n    seed: 0,\n    limitMs: 0,\n    round: 0,\n    /** True when the hub shows the round's splash and collects every player's ready: call ready() once loaded, with no prompt. */\n    splash: false,\n    /** True when the hub seeded Math.random for this round (side by side): every copy draws the same numbers. */\n    seeded: false,\n  };\n\n  /** A storage that lives and dies with the page: the Storage methods, and items as properties too. */\n  function memoryStorage() {\n    var data = Object.create(null);\n    var api = {\n12:  body { display: grid; grid-template-rows: auto 1fr; }\n23:  .cell { position: relative; display: grid; grid-template-rows: auto 1fr; min-height: 0; border: 2px solid var(--line); border-radius: 8px; overflow: hidden; background: #000; }\n26:  .cell__state { margin-left: auto; color: var(--dim); }\n27:  .cell iframe { width: 100%; height: 100%; border: 0; background: #000; }\n29:  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\n37:  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\n61:    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n67:import { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\n72:const auto = params.get('auto') === '1';\n73:const scenario = params.get('scenario') || 'standard';\n74:/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\n75:const serverMode = scenario === 'server';\n170:  const limitMs = params.has('limit') ? Number(params.get('limit')) * 1000 : limitFor(metas?.minutes);\n181:  const state = { round, n, metas, mode, limitMs, seed, players, cells: [], hubEnd, status: null, record: null, hidden: false, splashUntil: performance.now() + SPLASH_MS, answers: { ready: new Set(),  [... omitted end of long line]\n183:  log(`round ${round}: ${n} player${n > 1 ? 's' : ''}, seed ${seed}, limit ${Math.round(limitMs / 1000)} s, mode ${mode || '(from hello)'}`);\n192:    limitMs,\n210:    const frame = document.createElement('iframe');\n211:    frame.allow = 'fullscreen; autoplay; gamepad; pointer-lock';\n258:    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\n302:  if (!auto && players.every((c) => ready.has(c.key))) return releaseRound(state);\n377: * ?auto=1 — the conformance run. It presses keys inside each frame with\n379: * page's origin). Results land in window.__hubCheck, and body[data-complete]\n411:  const report = { done: false, pass: false, game: $('game').value, p