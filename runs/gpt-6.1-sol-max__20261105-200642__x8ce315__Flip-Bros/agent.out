{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport os,re,subprocess,json\ncwd=os.getcwd()\nfor line in subprocess.check_output(['ps','-C','python3','-o','pid=,args='],text=True).splitlines():\n pid,*args=line.split(maxsplit=1)\n try:\n  if args and args[0]=='python3 -m http.server 0 --bind 127.0.0.1' and os.readlink('/proc/'+pid+'/cwd')==cwd:\n   sockets=subprocess.check_output(['ss','-ltnp'],text=True)\n   for sock in sockets.splitlines():\n    if 'pid='+pid+',' in sock:\n     port=int(re.search(r'127\\\\.0\\\\.0\\\\.1:(\\\\d+)',sock)[1]);Path('server.json').write_text(json.dumps({'pid':int(pid),'port':port}));print(json.dumps({'pid':int(pid),'port':port}))\n except (FileNotFoundError,PermissionError):pass\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
