Y_INPUT();return out;}\naddEventListener('beforeunload',()=>{if(net.kind==='room'){roomSend({t:net.host?'closed':'leave'});net.bc?.close();net.peer?.destroy();}});\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
