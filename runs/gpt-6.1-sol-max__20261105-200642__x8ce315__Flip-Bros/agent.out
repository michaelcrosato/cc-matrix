{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -lc \"command -v biome\npython3 - <<'PY'\nimport json\nfrom pathlib import Path\nr=json.loads(Path('test-report.json').read_text());print(json.dumps({'passed':sum(x['pass'] for x in r['results']),'checks':len(r['results']),'graphics':r['notes']['graphics'],'hub':{k:v['pass'] for k,v in r['notes'].items() if k.startswith('hub-')}}))\nprint('Release bytes:',(Path('..')/'Flip-Bros-Mario-Bros-1983-gpt-6.1-sol-max-20261105-200642.html').stat().st_size)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
