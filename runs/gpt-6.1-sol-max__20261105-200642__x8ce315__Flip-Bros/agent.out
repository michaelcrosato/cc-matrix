ode:'\"'shared-world',seats:[1,4]});if(\"'!info)return false;Object.assign(net,{kind:'\"'hub',host:info.isHost,me:info.server?-1:info.me,members:info.players.map(p=>({id:p.id,name:p.name})),started:false,finished:false,ended:false,clock:0});paused=false;game.reset(net.members);game.status='waiting';hideScreen();\"'$('\"'hint').textContent='Crew ready. Waiting for the hub’s starting bell…';\n AIHub.on('start',()=>{net.startReceived=true;});\n AIHub.on('message',(d,from)=>{if(net.ended||\"'!d||typeof d!=='\"'object')return;if(net.host&&d.t==='input'&&net.members.some(p=>p.id===from))net.inputs.set(from,{input:cleanInput(d.input),time:performance.now()});else if(\"'!net.host&&from===AIHub.host&&d.t==='\"'world'){game.receive(d);}});\n AIHub.on('time-up',()=>{if(net.host)finishOnline(game.status==='won');});\n AIHub.on('leave',({id})=>{net.members=net.members.filter(p=>p.id\"'!==id);game.removePlayer(id);net.inputs.delete(id);});\n AIHub.on('\"'end',()=>{net.ended=true;paused=true;game.status='ended';audio.stop();\"'$('\"'toast').classList.add('hidden');\"'$('\"'screen').classList.add('hidden');screenMode='hub-ended';});\n await renderer.renderAsync(scene,camera);AIHub.ready();return true;}\nfunction networkTick(dt,local){if(\"'!isNetworked()||net.ended)return;if(net.kind==='\"'hub'&&\"'!net.started&&net.startReceived&&AIHub.time()>=0){net.started=true;game.status='\"'playing';notify('CREW READY · GO\"'!'\"',1.5);}\n if(\"'!net.started)return;net.clock+=dt;if(net.clock<1/14)return;net.clock=0;if(net.host){const s=game.snapshot();if(net.kind==='\"'hub')AIHub.send(s);else roomSend(s);}else{const d={t:'input',input:cleanInput(screenMode==='playing'?local:EMPTY_INPUT())};if(net.kind==='hub')AIHub.send(d,{to:AIHub.host,reliable:false});else roomSend(d);}}\nfunction onlineInputs(local){const out={};if(\"'!isNetworked())return out;if(net.me>=0)out[net.me]=screenMode==='\"'playing'?local:EMPTY_INPUT();for(const [id,r]of net.inputs)out[id]=performance.now()-r.time<650?r.input:EMPTY_INPUT();return out;}\naddEventListener('beforeunload',()=>{if(net.kind==='room'){roomSend({t:net.host?'closed':'leave'});net.bc?.close();net.peer?.destroy();}});\nJS\"","aggregated_output":"","exit_code":0,"status":"completed"}}
