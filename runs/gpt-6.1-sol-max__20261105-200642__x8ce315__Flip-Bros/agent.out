ta.t==='leave')dropRoomPlayer(fromToken);return;}\n switch(data.t){case'welcome':clearTimeout(net.joinTimer);net.me=data.id;net.members=data.players;net.notice='Connected. Waiting for the host.';if(data.started){net.started=true;paused=false;hideScreen();}else showLobby();break;case'roster':net.members=data.players;if(screenMode==='lobby')showLobby();break;case'begin':net.started=true;net.finished=false;net.members=data.players;paused=false;game.reset(net.members);hideScreen();notify('CREW CONNECTED · Clocking in\"'!'\"',2);break;case'world':if(\"'!net.started)break;game.receive(data);if(['\"'won','lost'].includes(game.status)&&screenMode\"'!=='\"'result')showResult(game.status==='won');break;case'full':clearTimeout(net.joinTimer);closeNetwork();showOnline();\"'$('\"'network-status').textContent='That room is full. Try another crew.';break;case'closed':closeNetwork();showOnline();\"'$('\"'network-status').textContent='The host closed the room.';break;}}\nfunction dropRoomPlayer(token){const c=net.channels.get(token);if(\"'!c)return;net.members=net.members.filter(p=>p.id!==c.id);net.inputs.delete(c.id);game.removePlayer(c.id);net.channels.delete(token);broadcastMembers();notify('\"'A crew member clocked out.');}\nasync function loadPeer(){if(window.Peer)return window.Peer;if(window.__peerLoading)return window.__peerLoading;window.__peerLoading=new Promise((resolve,reject)=>{const s=document.createElement('script');s.src='https://cdn.jsdelivr.net/npm/peerjs@1.5.5/dist/peerjs.min.js';s.onload=()=>resolve(window.Peer);s.onerror=()=>{window.__peerLoading=null;reject(new Error('Peer networking library could not load.'));};document.head.appendChild(s);});return window.__peerLoading;}\nfunction randomCode(){const a=new Uint8Array(6);crypto.getRandomValues(a);return [...a].map(n=>'ABCDEFGHJKLMNPQRSTUVWXYZ'[n%24]).join('');}\nfunction channelFor(code){try{net.bc=new BroadcastChannel('flipbros-v1-'+code);net.bc.onmessage=e=>{if(e.data.sender===net.token||(e.data.to&&e.data.to\"'!==net.token))return;receiveRoom(e.data.data,e.data.sender);};}catch{net.bc=null;}}\nasync function hostRoom(){closeNetwork();Object.assign(net,{kind:'\"'room',host:true,me:0,code:randomCode(),token:[REDACTED_SECRET]'Axle'}],notice:'Opening the internet connection…',started:false,finished:false,ended:false});channelFor(net.code);showLobby();const code=net.code;try{const Peer=await loadPeer();if(net.kind\"'!=='\"'room'||net.code\"'!==code)return;const peer=net.peer=new Peer('\"'flipbros-v1-'+code,{debug:0});peer.on('open',()=>{if(net.peer\"'!==peer)return;net.notice='\"'Room is online. Share the code with your crew.';if(screenMode==='lobby')showLobby();});peer.on('connection',c=>{const token=[REDACTED_SECRET]'open',()=>acceptRoom(token,c));c.on('data',data=>receiveRoom(data,token));c.on('close',()=>dropRoomPlayer(token));c.on('error',()=>dropRoomPlayer(token));});peer.on('error',e=>{net.notice='Internet connection unavailable ('+e.type+'). Nearby tabs can still join.';if(screenMode==='lobby')showLobby();});}catch(e){net.notice=e.message+' Nearby tabs can still join.';if(screenMode==='lobby')showLobby();}}\nasync function joinRoom(raw){const code=raw.toUpperCase().replace(/[\"'^A-Z]/g,'\"'');if(code.length\"'!==6){$('\"'network-status').textContent='Enter the six-letter code from your host.';return;}closeNetwork();Object.assign(net,{kind:'room',host:false,me:-1,code,token:[REDACTED_SECRET]'Finding your crew…',started:false,finished:false,ended:false});channelFor(code);\"'$('\"'network-status').textContent='Finding room '+code+'…';roomSend({t:'hello'});net.joinTimer=setTimeout(()=>{if(net.kind==='room'&&net.me<0){closeNetwork();showOnline();\"'$('\"'network-status').textContent='Could not reach that room. Check the code and keep the host’s page open.';}},14000);setTimeout(async()=>{if(net.kind\"'!=='\"'room'||net.code\"'!==code||net.me>=0)return;try{const Peer=await loadPeer();if(net.kind!=='\"'room'||net.code\"'!==code||net.me>=0)return;const peer=net.peer=new Peer(