{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('ui.js');s=p.read_text().replace('function setFocus(i){','function setFocus(i,scroll=true){').replace(\\\"if(\"'!['\"'title'].includes(screenMode))el.scrollIntoView\\\", \\\"if(scroll&&\"'!['\"'title'].includes(screenMode))el.scrollIntoView\\\").replace('menuFocus=0;setFocus(0);updateVisibility();', 'menuFocus=0;setFocus(0,false);updateVisibility();')\ns=s.replace(\\\"if(el.matches('button'))el.click();\\\", \\\"if(el.id==='room-code'){showCodeEntry();return;}if(el.matches('button'))el.click();\\\")\ns=s.replace('<input id=\\\"room-code\\\" class=\\\"room-input\\\"', '<input data-nav id=\\\"room-code\\\" class=\\\"room-input\\\"')\ns=s.replace(\\\"lastInput='keyboard';setFocus(navItems().indexOf(el));\\\", \\\"inputActivity('keyboard');setFocus(navItems().indexOf(el));\\\")\ns=s.replace(\\\"case'join':joinRoom(\"'$('\"'room-code')?.value||'');break;\\\", \\\"case'join':if(lastInput==='gamepad'&&\"'!$('\"'room-code')?.value)showCodeEntry();else joinRoom(\"'$('\"'room-code')?.value||'');break;case'code-join':joinRoom(roomLetters.join(''));break;case'code-back':showOnline();break;\\\")\ns=s.replace(\\\"else if(screenMode==='info')showAbout();\\\", \\\"else if(screenMode==='info')showAbout();else if(screenMode==='code-entry')showOnline();\\\")\ns+='''\nlet roomLetters=['A','A','A','A','A','A'],roomCursor=0;\nconst ROOM_ALPHABET='ABCDEFGHJKLMNPQRSTUVWXYZ';\nfunction updateDials(){document.querySelectorAll('[data-dial]').forEach(el=>{const i=Number(el.dataset.dial);el.querySelector('strong').textContent=roomLetters[i];el.classList.toggle('selected',i===roomCursor);});}\nfunction editDial(dir){const n=ROOM_ALPHABET.indexOf(roomLetters[roomCursor]);roomLetters[roomCursor]=ROOM_ALPHABET[(n+dir+24)%24];updateDials();audio.sfx('menu');}\nfunction moveDial(dir){roomCursor=(roomCursor+dir+6)%6;updateDials();}\nfunction showCodeEntry(){const previous=\"'$('\"'room-code')?.value.toUpperCase();roomLetters=previous?.length===6?[...previous]:['A','A','A','A','A','A'];roomCursor=0;setScreen('code-entry',\"'`<div class=\"eyebrow\">Your host has the secret code</div><h2>FIND YOUR CREW</h2><div class=\"code-dials\">${roomLetters.map((c,i)=>`<div data-dial=\"${i}\" class=\"dial-box\"><button data-dial-step=\"1\" data-index=\"${i}\" aria-label=\"Next letter ${i+1}\">▲</button><strong>${c}</strong><button data-dial-step=\"-1\" data-index=\"${i}\" aria-label=\"Previous letter ${i+1}\">▼</button></div>`).join('\"'')}</div><p class=\\\"fine\\\">← → Choose letter · ↑ ↓ Change letter<br>\"'${glyph('\"'confirm')} Join crew · \"'${glyph('\"'back')} Back<br>You can also type the code.</p><div class=\\\"menu\\\">\"'${btn('\"'Join crew','code-join','→','primary')}\"'${btn('\"'Back','code-back','←')}</div><p class=\\\"fine\\\" id=\\\"network-status\\\">Enter the six letters from your host’s screen.</p>\"'`);updateDials();}\n$('\"'screen').addEventListener('click',e=>{const arrow=e.target.closest('[data-dial-step]');if(arrow){inputActivity(lastInput);roomCursor=Number(arrow.dataset.index);editDial(Number(arrow.dataset.dialStep));}});\nfunction scrollBook(dir){const panel=\"'$('\"'screen').querySelector('.panel');panel.scrollTop+=dir*Math.max(70,innerHeight*.17);}\n'''\np.write_text(s)\np=Path('index.template.html');s=p.read_text().replace('.roster{font-size:21px;', '.room-input.focused{outline:3px solid var(--gold)}.code-dials{display:flex;gap:10px;justify-content:center;margin:25px 0}.dial-box{border:2px solid #527776;border-radius:7px;display:flex;flex-direction:column;align-items:center;background:#0e2730;min-width:48px;flex:1;max-width:80px}.dial-box.selected{border-color:var(--gold);box-shadow:0 0 0 2px var(--gold)}.dial-box strong{font-size:42px;color:var(--gold);line-height:1.4}.dial-box button{width:100%;background:transparent;border:0;color:var(--muted);padding:8px;font-size:17px}.dial-box button:hover{color:var(--ink);background:var(--gold)}.roster{font-size:21px;')\ns=s.replace('.roomcode{font-size:28px}', '.code-dials{gap:5px}.dial-box{min-width:36px}.dial-box strong{font-size:29px}.roomcode{font-size:28px}')\np.write_text(s)\np=Path('app.js');s=p.read_text()\nneedle=\\\" if(screenMode\"'!=='\"'playing'){if(['ArrowDown'\\\"\ninsert=\\\"\\\"\\\" if(screenMode==='code-entry'){e.preventDefault();if(e.key==='ArrowLeft')moveDial(-1);else if(e.key==='ArrowRight')moveDial(1);else if(e.key==='ArrowUp')editDial(1);else if(e.key==='ArrowDown')editDial(-1);else if(e.key==='Enter')joinRoom(roomLetters.join(''));else if(/\"'^[a-z]$/i.test(e.key)){roomLetters[roomCursor]=e.key.toUpperCase();roomCursor=(roomCursor+1)%6;updateDials();}else if(e.key==='\"'Backspace')moveDial(-1);return;}\n if(['info','how'].includes(screenMode)&&['ArrowUp','ArrowDown','w','s'].includes(e.key)){scrollBook(['ArrowUp','w'].includes(e.key)?-1:1);return;}\n\\\"\\\"\\\"\nassert needle in s;s=s.replace(needle,insert+needle)\nneedle2=\\\" if(screenMode\"'!=='\"'playing'){if((now[13]\\\"\ninsert2=\\\"\\\"\\\" if(screenMode==='code-entry'){if(padRepeat<=0){if(now[14]||axis<-.55){moveDial(-1);padRepeat=.18;}else if(now[15]||axis>.55){moveDial(1);padRepeat=.18;}else if(now[12]||ay<-.55){editDial(1);padRepeat=.13;}else if(now[13]||ay>.55){editDial(-1);padRepeat=.13;}}if(edge(0))joinRoom(roomLetters.join(''));if(edge(1))showOnline();oldPadButtons[index]=now;continue;}\n if(['info','how'].includes(screenMode)){if(padRepeat<=0){if(now[13]||ay>.55){scrollBook(1);padRepeat=.15;}else if(now[12]||ay<-.55){scrollBook(-1);padRepeat=.15;}}if(edge(0))activateMenu();if(edge(1))back();oldPadButtons[index]=now;continue;}\n\\\"\\\"\\\"\nassert needle2 in s;s=s.replace(needle2,insert2+needle2);p.write_text(s)\nPY\n./test.sh --section core\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
