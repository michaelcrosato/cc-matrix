tes) > 0, `hub:session-minutes=${m.minutes}`);\n\n    // Every copy: the players, and in a server round the server's copy.\n    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\n    const helloed = await until(() => copies().every((p) => p.hello), TIMINGS.helloMs + 1000);\n    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\n    if (!helloed) return;\n    const caps = state.coordinator.seats().map((s) => s.caps);\n    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\n    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\n    if (state.cells.some((c) => !c.frame.contentDocument)) {\n      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\n      return;\n    }\n\n    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\n    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\n    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\n    // A game that shows its own card takes the players' answers on it: Enter is Ready.\n    if (caps.some((c) => c?.card)) {\n      const players = state.cells.filter((c) => !c.server);\n      const sent = await until(() => players.every((c) => c.cardSent), 2000);\n      for (const cell of players) poke(cell, 'Enter');\n      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\n      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\n    }\n    releaseRound(state);\n    const started = await until(() => state.status?.phase !== 'loading', 15_000);\n    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\n    if (!started || state.record) return;\n\n    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\n    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\n    const randomly = async (ms) => {\n      const end = performance.now() + ms;\n      while (performance.now() < end && !state.record) {\n        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\n        await sleep(150);\n      }\n    };\n    await randomly(Math.min(1500, playMs / 4));\n\n    const mode = state.coordinator.mode;\n    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\n    // still tagged race was built to race's contract: no seeded start, and no progress asked.\n    const own = SELF_REPORTED.includes(mode);\n    const legacyRace = own && !seedsRandom(m?.mode);\n    if (own && !legacyRace) {\n      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\n      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\n    }\n\n    if (scenario === 'host-leave') removeCell(state.cells[0]);\n    else if (n >= 3) removeCell(state.cells[n - 1]);\n    await randomly(playMs / 2);\n    const remaining = state.cells.filter((c) => !c.gone);\n    if (own) {\n      if (mode === 'parallel') {\n        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\n          state.cells.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      } else {\n        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\n          remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      }\n      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\n        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\n    } else {\n      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\n        remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent} ↓${c.bridge.stats.received}`).join(' '));\n    }\n\n    if (!state.record) state.coordinator.timeUp();\n    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\n    const record = state.record;\n    if (serverMode) {\n      // The world ran on the server: the players heard it, and only the host may finish a shared world.\n      const serverCell = state.cells.find((c) => c.server);\n      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\n        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\n    }\n    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\n    } else {\n      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\n    }\n    await sleep(300);\n    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\n    const issues = [...(state.status?.issues ?? []), ...state.cells.flatMap((c) => c.bridge.issues)];\n    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\n    const violations = state.cells.flatMap((c) => {\n      let extra = [];\n      try {\n        extra = c.frame.contentWindow?.__hubViolations ?? [];\n      } catch {}\n      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\n    });\n    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\n  } catch (error) {\n    check('harness ran', false, String(error?.stack || error));\n  } finally {\n    report.pass = checks.length > 0 && checks.every((c) => c.pass);\n    report.done = true;\n    document.body.dataset.complete = 'true';\n    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\n  }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"cat > index.template.html <<'HTML'\n<\"'!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<script>/*__HUB_CLIENT__*/</script>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#12282f\">\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"shared-world\">\n<meta name=\"hub:session-goal\" content=\"Flip pests, kick them out, and beat King Clog together.\">\n<meta name=\"hub:session-howto\" content=\"Move: stick/AD. Jump: Cross/Space. Dash: Square/X. Bell: Triangle/E.\">\n<meta name=\"hub:session-minutes\" content=\"6\">\n<title>Flip Bros — The Night Shift</title>\n<style>\n:root{--ink:#101e27;--paper:#f7edce;--muted:#a9c3bd;--teal:#6dd8be;--orange:#ff9d50;--gold:#ffda70;--scale:1;font-family:'\"'Trebuchet MS',Verdana,sans-serif;color:var(--paper);background:var(--ink);font-synthesis:none;color-scheme:dark}\n*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden;overscroll-behavior:none}body{user-select:none;-webkit-user-select:none}button,input{font:inherit}button{touch-action:manipulation;cursor:pointer}button:disabled{opacity:.42;cursor:default}canvas{display:block;width:100%;height:100%}#viewport{position:fixed;inset:0}#viewport canvas{outline:none}.grain{position:fixed;inset:0;pointer-events:none;opacity:.035;background-image:url(\\\"data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Cpath filter='url(%23n)' opacity='.8' d='M0 0h180v180H0z'/%3E%3C/svg%3E\\\");z-index:3}#vignette{position:fixed;inset:0;box-shadow:inset 0 0 13vw #07192299;pointer-events:none;z-index:2}\n#ui{position:fixed;inset:0;z-index:5;pointer-events:none}#ui>*{pointer-events:auto}.hidden{display:none\"'!important}#screen{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#081b26a6;backdrop-filter:blur(6px)}#screen.title{justify-content:flex-start;background:linear-gradient(90deg,#10242dfc 0%,#10242df4 26%,#10242d9c 47%,transparent 70%);backdrop-filter:none}#screen.clear{background:transparent;backdrop-filter:none;pointer-events:none}.panel{width:min(760px,90vw);max-height:88vh;overflow:auto;padding:clamp(22px,3.1vw,56px);border:3px solid #536b6a;border-radius:12px;background:#142c34f5;box-shadow:10px 12px 0 #081820a0;scrollbar-width:thin;scrollbar-color:var(--teal) var(--ink)}.panel.wide{width:min(1040px,93vw)}.title .panel{width:min(630px,46vw);margin-left:5.5vw;background:none;border:0;box-shadow:none;padding:0;overflow:visible}.eyebrow{text-transform:uppercase;font-weight:bold;letter-spacing:.22em;font-size:clamp(12px,1.1vw,19px);color:var(--teal);margin:0 0 16px}.logo{font-family:'\"'Arial Black',Impact,sans-serif;font-weight:1000;font-style:italic;font-size:clamp(68px,8.5vw,154px);line-height:.82;letter-spacing:-.055em;margin:0 0 20px;filter:drop-shadow(5px 7px 0 #0008);text-shadow:2px 2px 0 var(--ink)}.logo span{display:block;color:var(--orange);margin-left:25px}.title-tag{font-size:clamp(17px,1.65vw,28px);font-weight:700;line-height:1.5;margin:0 0 30px}.title-tag small{font-size:.65em;color:var(--muted);font-weight:400}.menu{display:grid;gap:9px}.menu.two{grid-template-columns:1fr 1fr}.btn{width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;border:2px solid #526e70;color:var(--paper);background:#1d3b43;padding:14px 21px;min-height:54px;border-radius:5px;font-size:clamp(16px,1.25vw,23px);font-weight:700;text-align:left;transition:background .12s,border-color .12s,transform .12s;position:relative}.btn small{color:#adc7c2;font-size:.66em;font-weight:400}.btn:hover,.btn:focus-visible,.btn.focused{outline:none;border-color:var(--gold);color:var(--ink);background:var(--gold);transform:translateX(5px);box-shadow:-5px 0 var(--orange)}.btn:hover small,.btn.focused small{color:#3a4b4d}.btn.primary{background:var(--orange);color:var(--ink);border-color:var(--orange)}.btn.primary.focused,.btn.primary:hover{background:var(--gold);border-color:var(--paper)}.btn.subtle{background:transparent}.btn.danger{color:#ffad9b}.btn.danger.focused{color:var(--ink)}h1,h2,h3{margin:0 0 20px}h2{font-family:'Arial Black',sans-serif;font-size:clamp(27px,3.4vw,52px);letter-spacing:-.04em;line-height:1.05}h3{color:var(--gold);font-size:clamp(20px,1.7vw,28px)}p{line-height:1.5}.fine{color:var(--muted);font-size:clamp(13px,1.02vw,18px);line-height:1.5}.back{margin-top:23px}.brandline{display:flex;gap:12px;align-items:center;font-size:14px;color:var(--muted);margin-top:22px}.dot{width:8px;height:8px;background:var(--teal);border-radius:50%;display:inline-block}.glyph{display:inline-flex;align-items:center;justify-content:center;min-width:1.65em;height:1.65em;padding:0 .32em;border:1.5px solid currentColor;border-radius:5px;font-weight:700;font-size:.8em;vertical-align:middle;line-height:1}.glyph.pad{border-radius:50%;color:var(--teal);font-size:1em;min-width:1.6em}.control-pair{white-space:nowrap}.control-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:24px 0}.control-card{padding:20px;border:2px solid #496366;border-radius:6px;background:#1d3b43}.control-card b{font-size:22px;display:block;color:var(--gold);margin-bottom:8px}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.step{border-top:4px solid var(--teal);padding-top:14px}.step strong{font-size:26px;color:var(--gold)}.step p{font-size:18px;margin:9px 0}.step .number{font-size:14px;color:var(--teal);font-weight:bold;letter-spacing:.18em}.setting-row{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:16px 8px;border-bottom:1px solid #416166;font-size:21px;min-height:60px}.setting-row.focused{background:#385755;border-radius:5px;outline:2px solid var(--gold)}.setting-row label{flex:1}.setting-row output{min-width:54px;text-align:right;color:var(--gold);font-weight:bold}.setting-row input[type=range]{accent-color:var(--teal);width:38%;height:24px;cursor:pointer}.setting-row button{width:auto;min-width:120px;padding:9px 16px;min-height:42px}.toggle-value{color:var(--gold)}.dev-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.dev-grid .btn{font-size:18px}.settings-note{padding:14px;border-left:4px solid var(--orange);color:var(--muted);font-size:16px}.credits dl{display:grid;grid-template-columns:130px 1fr;gap:10px;font-size:16px;line-height:1.5}.credits dt{color:var(--teal)}.credits dd{margin:0}.credits h3{margin-top:28px}.credits li{font-size:15px;line-height:1.6;margin-bottom:9px}.credits a{color:var(--teal)}\n#hud{position:absolute;top:3.8vh;left:4vw;right:4vw;display:flex;align-items:flex-start;justify-content:space-between;gap:20px;pointer-events:none}#hud .hudblock{background:#112931e8;border:2px solid #5d7a77;box-shadow:4px 4px #08192080;border-radius:7px;padding:13px 21px;min-width:195px}.hudlabel{font-size:12px;letter-spacing:.17em;color:var(--teal);font-weight:bold;margin-bottom:4px}.hudvalue{font-size:32px;font-weight:1000;line-height:1.05;font-variant-numeric:tabular-nums}.hudvalue small{font-size:16px;color:var(--orange)}.hearts{color:var(--orange);letter-spacing:.1em;font-size:18px;margin-top:6px}.hudstage{text-align:center}.hudstage .hudvalue{font-size:24px}.hudstage .fine{font-size:13px;margin-top:5px}.hudright{text-align:right;display:flex;align-items:center;gap:15px}.hudright button{pointer-events:auto;width:48px;height:48px;border:2px solid #70938d;background:#17343c;color:var(--paper);border-radius:6px;font-size:24px}.bellcharges{color:var(--gold);font-size:19px;letter-spacing:.05em}#bottom{position:absolute;bottom:3vh;left:4vw;right:4vw;display:flex;justify-content:space-between;align-items:end;gap:20px;pointer-events:none}#hint{font-size:clamp(14px,1.25vw,21px);background:#102b33e8;border-left:4px solid var(--teal);padding:10px 17px;max-width:70%;line-height:1.5}#controls{font-size:clamp(12px,1.1vw,18px);display:flex;gap:20px;align-items:center;color:var(--paper)}#toast{position:absolute;top:20%;left:50%;transform:translateX(-50%);background:var(--gold);color:var(--ink);padding:12px 28px;font-weight:bold;letter-spacing:.07em;border:3px solid var(--ink);box-shadow:5px 5px #0004;font-size:clamp(18px,2vw,30px);white-space:nowrap;pointer-events:none}#combo{position:absolute;left:5%;top:26%;font-family:'Arial Black',sans-serif;font-style:italic;color:var(--gold);font-size:clamp(25px,4vw,62px);text-shadow:3px 3px var(--ink);pointer-events:none}#attract{position:absolute;inset:0;pointer-events:none;border:10px solid #ffcf6377}#attract .banner{position:absolute;left:50%;bottom:7%;transform:translateX(-50%);background:#122c35ed;border:2px solid var(--gold);padding:14px 28px;text-align:center;min-width:360px}#attract b{font-size:26px;color:var(--gold);letter-spacing:.1em}#attract p{font-size:17px;margin:5px}#loading{position:fixed;z-index:20;inset:0;display:flex;align-items:center;justify-content:center;background:#102630}.loader-inner{text-align:center;max-width:540px;padding:30px}.loader-inner h1{font-family:'Arial Black';font-style:italic;font-size:68px;margin-bottom:15px;color:var(--orange)}.spinner{width:48px;height:48px;border-radius:50%;border:5px solid #345458;border-top-color:var(--gold);margin:25px auto;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}#load-msg{font-size:18px;line-height:1.6;color:var(--muted)}#floaters{position:absolute;inset:0;pointer-events:none;overflow:hidden}.floater{position:absolute;font-family:'Arial Black',sans-serif;font-size:25px;white-space:nowrap;color:var(--gold);text-shadow:2px 2px var(--ink);transform:translate(-50%,-50%);pointer-events:none}.poptext{font-size:35px;font-style:italic;color:var(--paper)}.result-score{font-family:'Arial Black',sans-serif;color:var(--gold);font-size:64px;line-height:1.2;margin:16px 0}.stats{display:flex;justify-content:space-between;gap:15px;padding:20px 0;border-top:2px solid #466365;border-bottom:2px solid #466365;margin-bottom:20px}.stats span{font-size:25px;color:var(--teal);font-weight:bold;display:block}.stats small{font-size:14px;color:var(--muted)}.roomcode{font-size:42px;letter-spacing:.2em;color:var(--gold);padding:20px;background:#0f252c;text-align:center;border:2px dashed #547879;border-radius:6px}.room-input{background:#0c242c;border:2px solid #638480;color:var(--gold);font-size:26px;letter-spacing:.15em;width:100%;padding:18px;border-radius:5px;text-align:center;margin:12px 0;user-select:text;text-transform:uppercase}.roster{font-size:21px;line-height:1.8;color:var(--teal);margin:20px 0}.network-badge{color:var(--teal);font-size:13px}.touch-menu{display:none}.touch-action{display:none;position:absolute;bottom:8%;right:7%;width:80px;height:80px;border-radius:50%;border:2px solid #f8edce66;background:#2c665870;color:var(--paper);font-size:17px;font-weight:bold;opacity:.72;pointer-events:auto}.touch-action.pulse{background:#ffd16e99;border-color:var(--gold);color:var(--ink)}#touch-stick{position:absolute;width:100px;height:100px;border:2px solid #ffda7044;border-radius:50%;pointer-events:none;background:#162d3d55;display:none}#touch-stick i{position:absolute;width:35px;height:35px;left:31px;top:31px;border:2px solid #ffe9ae99;background:#ffe9ae33;border-radius:50%}\n@media (max-height:760px) and (min-width:850px){.title .panel{max-width:490px}.logo{font-size:clamp(65px,10vw,110px);margin-bottom:12px}.eyebrow{margin-bottom:10px}.title-tag{font-size:21px;margin-bottom:17px}.title .btn{padding:10px 18px;min-height:43px;font-size:18px}.brandline{margin-top:13px}.panel{max-height:92vh;padding:27px}.setting-row{font-size:18px;padding:9px;min-height:47px}h2{font-size:38px}#hud .hudblock{padding:9px 16px}.hudvalue{font-size:26px}}\n@media (pointer:coarse){#controls{display:none}#hint{font-size:14px;max-width:70%}.touch-action.active{display:block}#hud .hudblock{min-width:auto;padding:8px 13px}.hudvalue{font-size:24px}.hudstage .hudvalue{font-size:18px}.hudlabel{font-size:10px}.hearts{font-size:14px}.hudstage .fine{font-size:11px}#bottom{bottom:3%}.btn{min-height:50px}.fine{font-size:14px}}\n@media (max-width:700px){.title .panel{width:84vw;margin-left:8vw}.title{background:linear-gradient(90deg,#10242de8,#10242dbb)\"'!important}.logo{font-size:88px}.title-tag{font-size:20px;margin-bottom:22px}.title .eyebrow{font-size:12px}.title .btn{font-size:17px;padding:12px 18px}.title .menu{gap:7px}.brandline{font-size:11px}.panel{padding:25px}.steps{grid-template-columns:1fr;gap:12px}.step p{font-size:16px;margin:6px 0}.step strong{font-size:22px}.control-grid{gap:8px}.control-card{padding:10px;font-size:14px}.control-card b{font-size:18px}.setting-row{font-size:16px;gap:10px;padding:11px 3px}.setting-row input[type=range]{width:34%}.setting-row button{min-width:90px;font-size:15px}.dev-grid .btn{font-size:14px;padding:13px}.credits dl{grid-template-columns:90px 1fr;font-size:13px}.credits li{font-size:13px}#hud{left:3%;right:3%;top:2%;gap:6px}.hudright{gap:6px}#hud .hudblock{padding:7px 9px}.hudstage .fine{display:none}.hudvalue{font-size:20px}.hudstage .hudvalue{font-size:15px}.bellcharges{font-size:14px}.hudright button{width:36px;height:36px;font-size:20px}#toast{top:16%;font-size:15px;padding:9px 15px}#hint{max-width:86%;font-size:13px}#combo{top:22%}.touch-action{bottom:16%;width:68px;height:68px}.menu.two{grid-template-columns:1fr}.roomcode{font-size:28px}#attract .banner{min-width:280px}#attract b{font-size:21px}.result-score{font-size:48px}}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js\",\"rapier\":\"https://cdn.jsdelivr.net/npm/@dimforge/rapier2d-compat@0.19.3/rapier.mjs\"}}</script>\n</head>\n<body>\n<div id=\"viewport\"></div><div id=\"vignette\"></div><div class=\"grain\"></div>\n<div id=\"loading\"><div class=\"loader-inner\"><h1>FLIP BROS</h1><div class=\"spinner\"></div><div id=\"load-msg\">Warming the pipes…<br>Building your night shift.</div></div></div>\n<div id=\"ui\">\n <div id=\"hud\" class=\"hidden\"><div class=\"hudblock\"><div class=\"hudlabel\">UNION SCORE <span id=\"net-badge\"></span></div><div class=\"hudvalue\" id=\"score\">000000</div><div class=\"hearts\" id=\"lives\"></div></div><div class=\"hudblock hudstage\"><div class=\"hudlabel\" id=\"shift-label\">SHIFT 01 / 04</div><div class=\"hudvalue\" id=\"shift-name\">PIPE DREAMS</div><div class=\"fine\" id=\"goal\">Flip 6 pests</div></div><div class=\"hudright\"><div class=\"hudblock\"><div class=\"hudlabel\">RATTLE BELL</div><div class=\"bellcharges\" id=\"charges\">◆ ◆ ◆</div></div><button id=\"pause-btn\" aria-label=\"Pause\">Ⅱ</button></div></div>\n <div id=\"bottom\" class=\"hidden\"><div id=\"hint\"></div><div id=\"controls\"></div></div><div id=\"toast\" class=\"hidden\"></div><div id=\"combo\" class=\"hidden\"></div>\n <div id=\"screen\" class=\"hidden\"></div><div id=\"floaters\"></div><div id=\"attract\" class=\"hidden\"><div class=\"banner\"><b>ON THE NIGHT SHIFT</b><p>Demo playing · Any input to take over</p></div></div>\n <button id=\"touch-action\" class=\"touch-action\" aria-label=\"Ring bell\">BELL</button><div id=\"touch-stick\"><i></i></div>\n</div>\n<script type=\"module\">\n/*__GAME__*/\n</script>\n</body></html>\nHTML\ncat > build.mjs <<'\"'JS'\nimport {readFileSync,writeFileSync} from 'node:fs';\nconst stem='Flip-Bros-Mario-Bros-1983-gpt-6.1-sol-max-20261105-200642';\nlet html=readFileSync('index.template.html','utf8').replace('/*__HUB_CLIENT__*/',()=>readFileSync('hub-session.js','utf8')).replace('/*__GAME__*/',()=>['audio.js','world.js','game.js','ui.js','network.js','app.js'].map(f=>readFileSync(f,'utf8')).join('\\\\n'));\nwriteFileSync('../'+stem+'.html',html);\nwriteFileSync('index.html',html);\nJS\nmv ../build-location.json build-location.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"cat > index.template.html <<'HTML'\n<\"'!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<script>/*__HUB_CLIENT__*/</script>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#12282f\">\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"shared-world\">\n<meta name=\"hub:session-goal\" content=\"Flip pests, kick them out, and beat King Clog together.\">\n<meta name=\"hub:session-howto\" content=\"Move: stick/AD. Jump: Cross/Space. Dash: Square/X. Bell: Triangle/E.\">\n<meta name=\"hub:session-minutes\" content=\"6\">\n<title>Flip Bros — The Night Shift</title>\n<style>\n:root{--ink:#101e27;--paper:#f7edce;--muted:#a9c3bd;--teal:#6dd8be;--orange:#ff9d50;--gold:#ffda70;--scale:1;font-family:'\"'Trebuchet MS',Verdana,sans-serif;color:var(--paper);background:var(--ink);font-synthesis:none;color-scheme:dark}\n*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden;overscroll-behavior:none}body{user-select:none;-webkit-user-select:none}button,input{font:inherit}button{touch-action:manipulation;cursor:pointer}button:disabled{opacity:.42;cursor:default}canvas{display:block;width:100%;height:100%}#viewport{position:fixed;inset:0}#viewport canvas{outline:none}.grain{position:fixed;inset:0;pointer-events:none;opacity:.035;background-image:url(\\\"data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Cpath filter='url(%23n)' opacity='.8' d='M0 0h180v180H0z'/%3E%3C/svg%3E\\\");z-index:3}#vignette{position:fixed;inset:0;box-shadow:inset 0 0 13vw #07192299;pointer-events:none;z-index:2}\n#ui{position:fixed;inset:0;z-index:5;pointer-events:none}#ui>*{pointer-events:auto}.hidden{display:none\"'!important}#screen{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#081b26a6;backdrop-filter:blur(6px)}#screen.title{justify-content:flex-start;background:linear-gradient(90deg,#10242dfc 0%,#10242df4 26%,#10242d9c 47%,transparent 70%);backdrop-filter:none}#screen.clear{background:transparent;backdrop-filter:none;pointer-events:none}.panel{width:min(760px,90vw);max-height:88vh;overflow:auto;padding:clamp(22px,3.1vw,56px);border:3px solid #536b6a;border-radius:12px;background:#142c34f5;box-shadow:10px 12px 0 #081820a0;scrollbar-width:thin;scrollbar-color:var(--teal) var(--ink)}.panel.wide{width:min(1040px,93vw)}.title .panel{width:min(630px,46vw);margin-left:5.5vw;background:none;border:0;box-shadow:none;padding:0;overflow:visible}.eyebrow{text-transform:uppercase;font-weight:bold;letter-spacing:.22em;font-size:clamp(12px,1.1vw,19px);color:var(--teal);margin:0 0 16px}.logo{font-family:'\"'Arial Black',Impact,sans-serif;font-weight:1000;font-style:italic;font-size:clamp(68px,8.5vw,154px);line-height:.82;letter-spacing:-.055em;margin:0 0 20px;filter:drop-shadow(5px 7px 0 #0008);text-shadow:2px 2px 0 var(--ink)}.logo span{display:block;color:var(--orange);margin-left:25px}.title-tag{font-size:clamp(17px,1.65vw,28px);font-weight:700;line-height:1.5;margin:0 0 30px}.title-tag small{font-size:.65em;color:var(--muted);font-weight:400}.menu{display:grid;gap:9px}.menu.two{grid-template-columns:1fr 1fr}.btn{width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;border:2px solid #526e70;color:var(--paper);background:#1d3b43;padding:14px 21px;min-height:54px;border-radius:5px;font-size:clamp(16px,1.25vw,23px);font-weight:700;text-align:left;transition:background .12s,border-color .12s,transform .12s;position:relative}.btn small{color:#adc7c2;font-size:.66em;font-weight:400}.btn:hover,.btn:focus-visible,.btn.focused{outline:none;border-color:var(--gold);color:var(--ink);background:var(--gold);transform:translateX(5px);box-shadow:-5px 0 var(--orange)}.btn:hover small,.btn.focused small{color:#3a4b4d}.btn.primary{background:var(--orange);color:var(--ink);border-color:var(--orange)}.btn.primary.focused,.btn.primary:hover{background:var(--gold);border-color:var(--paper)}.btn.subtle{background:transparent}.btn.danger{color:#ffad9b}.btn.danger.focused{color:var(--ink)}h1,h2,h3{margin:0 0 20px}h2{font-family:'Arial Black',sans-serif;font-size:clamp(27px,3.4vw,52px);letter-spacing:-.04em;line-height:1.05}h3{color:var(--gold);font-size:clamp(20px,1.7vw,28px)}p{line-height:1.5}.fine{color:var(--muted);font-size:clamp(13px,1.02vw,18px);line-height:1.5}.back{margin-top:23px}.brandline{display:flex;gap:12px;align-items:center;font-size:14px;color:var(--muted);margin-top:22px}.dot{width:8px;height:8px;background:var(--teal);border-radius:50%;display:inline-block}.glyph{display:inline-flex;align-items:center;justify-content:center;min-width:1.65em;height:1.65em;padding:0 .32em;border:1.5px solid currentColor;border-radius:5px;font-weight:700;font-size:.8em;vertical-align:middle;line-height:1}.glyph.pad{border-radius:50%;color:var(--teal);font-size:1em;min-width:1.6em}.control-pair{white-space:nowrap}.control-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:24px 0}.control-card{padding:20px;border:2px solid #496366;border-radius:6px;background:#1d3b43}.control-card b{font-size:22px;display:block;color:var(--gold);margin-bottom:8px}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.step{border-top:4px solid var(--teal);padding-top:14px}.step strong{font-size:26px;color:var(--gold)}.step p{font-size:18px;margin:9px 0}.step .number{font-size:14px;color:var(--teal);font-weight:bold;letter-spacing:.18em}.setting-row{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:16px 8px;border-bottom:1px solid #416166;font-size:21px;min-height:60px}.setting-row.focused{background:#385755;border-radius:5px;outline:2px solid var(--gold)}.setting-row label{flex:1}.setting-row output{min-width:54px;text-align:right;color:var(--gold);font-weight:bold}.setting-row input[type=range]{accent-color:var(--teal);width:38%;height:24px;cursor:pointer}.setting-row button{width:auto;min-width:120px;padding:9px 16px;min-height:42px}.toggle-value{color:var(--gold)}.dev-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.dev-grid .btn{font-size:18px}.settings-note{padding:14px;border-left:4px solid var(--orange);color:var(--muted);font-size:16px}.credits dl{display:grid;grid-template-columns:130px 1fr;gap:10px;font-size:16px;line-height:1.5}.credits dt{color:var(--teal)}.credits dd{margin:0}.credits h3{margin-top:28px}.credits li{font-size:15px;line-height:1.6;margin-bottom:9px}.credits a{color:var(--teal)}\n#hud{position:absolute;top:3.8vh;left:4vw;right:4vw;display:flex;align-items:flex-start;justify-content:space-between;gap:20px;pointer-events:none}#hud .hudblock{background:#112931e8;border:2px solid #5d7a77;box-shadow:4px 4px #08192080;border-radius:7px;padding:13px 21px;min-width:195px}.hudlabel{font-size:12px;letter-spacing:.17em;color:var(--teal);font-weight:bold;margin-bottom:4px}.hudvalue{font-size:32px;font-weight:1000;line-height:1.05;font-variant-numeric:tabular-nums}.hudvalue small{font-size:16px;color:var(--orange)}.hearts{color:var(--orange);letter-spacing:.1em;font-size:18px;margin-top:6px}.hudstage{text-align:center}.hudstage .hudvalue{font-size:24px}.hudstage .fine{font-size:13px;margin-top:5px}.hudright{text-align:right;display:flex;align-items:center;gap:15px}.hudright button{pointer-events:auto;width:48px;height:48px;border:2px solid #70938d;background:#17343c;color:var(--paper);border-radius:6px;font-size:24px}.bellcharges{color:var(--gold);font-size:19px;letter-spacing:.05em}#bottom{position:absolute;bottom:3vh;left:4vw;right:4vw;display:flex;justify-content:space-between;align-items:end;gap:20px;pointer-events:none}#hint{font-size:clamp(14px,1.25vw,21px);background:#102b33e8;border-left:4px solid var(--teal);padding:10px 17px;max-width:70%;line-height:1.5}#controls{font-size:clamp(12px,1.1vw,18px);display:flex;gap:20px;align-items:center;color:var(--paper)}#toast{position:absolute;top:20%;left:50%;transform:translateX(-50%);background:var(--gold);color:var(--ink);padding:12px 28px;font-weight:bold;letter-spacing:.07em;border:3px solid var(--ink);box-shadow:5px 5px #0004;font-size:clamp(18px,2vw,30px);white-space:nowrap;pointer-events:none}#combo{position:absolute;left:5%;top:26%;font-family:'Arial Black',sans-serif;font-style:italic;color:var(--gold);font-size:clamp(25px,4vw,62px);text-shadow:3px 3px var(--ink);pointer-events:none}#attract{position:absolute;inset:0;pointer-events:none;border:10px solid #ffcf6377}#attract .banner{position:absolute;left:50%;bottom:7%;transform:translateX(-50%);background:#122c35ed;border:2px solid var(--gold);padding:14px 28px;text-align:center;min-width:360px}#attract b{font-size:26px;color:var(--gold);letter-spacing:.1em}#attract p{font-size:17px;margin:5px}#loading{position:fixed;z-index:20;inset:0;display:flex;align-items:center;justify-content:center;background:#102630}.loader-inner{text-align:center;max-width:540px;padding:30px}.loader-inner h1{font-family:'Arial Black';font-style:italic;font-size:68px;margin-bottom:15px;color:var(--orange)}.spinner{width:48px;height:48px;border-radius:50%;border:5px solid #345458;border-top-color:var(--gold);margin:25px auto;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}#load-msg{font-size:18px;line-height:1.6;color:var(--muted)}#floaters{position:absolute;inset:0;pointer-events:none;overflow:hidden}.floater{position:absolute;font-family:'Arial Black',sans-serif;font-size:25px;white-space:nowrap;color:var(--gold);text-shadow:2px 2px var(--ink);transform:translate(-50%,-50%);pointer-events:none}.poptext{font-size:35px;font-style:italic;color:var(--paper)}.result-score{font-family:'Arial Black',sans-serif;color:var(--gold);font-size:64px;line-height:1.2;margin:16px 0}.stats{display:flex;justify-content:space-between;gap:15px;padding:20px 0;border-top:2px solid #466365;border-bottom:2px solid #466365;margin-bottom:20px}.stats span{font-size:25px;color:var(--teal);font-weight:bold;display:block}.stats small{font-size:14px;color:var(--muted)}.roomcode{font-size:42px;letter-spacing:.2em;color:var(--gold);padding:20px;background:#0f252c;text-align:center;border:2px dashed #547879;border-radius:6px}.room-input{background:#0c242c;border:2px solid #638480;color:var(--gold);font-size:26px;letter-spacing:.15em;width:100%;padding:18px;border-radius:5px;text-align:center;margin:12px 0;user-select:text;text-transform:uppercase}.roster{font-size:21px;line-height:1.8;color:var(--teal);margin:20px 0}.network-badge{color:var(--teal);font-size:13px}.touch-menu{display:none}.touch-action{display:none;position:absolute;bottom:8%;right:7%;width:80px;height:80px;border-radius:50%;border:2px solid #f8edce66;background:#2c665870;color:var(--paper);font-size:17px;font-weight:bold;opacity:.72;pointer-events:auto}.touch-action.pulse{background:#ffd16e99;border-color:var(--gold);color:var(--ink)}#touch-stick{position:absolute;width:100px;height:100px;border:2px solid #ffda7044;border-radius:50%;pointer-events:none;background:#162d3d55;display:none}#touch-stick i{position:absolute;width:35px;height:35px;left:31px;top:31px;border:2px solid #ffe9ae99;background:#ffe9ae33;border-radius:50%}\n@media (max-height:760px) and (min-width:850px){.title .panel{max-width:490px}.logo{font-size:clamp(65px,10vw,110px);margin-bottom:12px}.eyebrow{margin-bottom:10px}.title-tag{font-size:21px;margin-bottom:17px}.title .btn{padding:10px 18px;min-height:43px;font-size:18px}.brandline{margin-top:13px}.panel{max-height:92vh;padding:27px}.setting-row{font-size:18px;padding:9px;min-height:47px}h2{font-size:38px}#hud .hudblock{padding:9px 16px}.hudvalue{font-size:26px}}\n@media (pointer:coarse){#controls{display:none}#hint{font-size:14px;max-width:70%}.touch-action.active{display:block}#hud .hudblock{min-width:auto;padding:8px 13px}.hudvalue{font-size:24px}.hudstage .hudvalue{font-size:18px}.hudlabel{font-size:10px}.hearts{font-size:14px}.hudstage .fine{font-size:11px}#bottom{bottom:3%}.btn{min-height:50px}.fine{font-size:14px}}\n@media (max-width:700px){.title .panel{width:84vw;margin-left:8vw}.title{background:linear-gradient(90deg,#10242de8,#10242dbb)\"'!important}.logo{font-size:88px}.title-tag{font-size:20px;margin-bottom:22px}.title .eyebrow{font-size:12px}.title .btn{font-size:17px;padding:12px 18px}.title .menu{gap:7px}.brandline{font-size:11px}.panel{padding:25px}.steps{grid-template-columns:1fr;gap:12px}.step p{font-size:16px;margin:6px 0}.step strong{font-size:22px}.control-grid{gap:8px}.control-card{padding:10px;font-size:14px}.control-card b{font-size:18px}.setting-row{font-size:16px;gap:10px;padding:11px 3px}.setting-row input[type=range]{width:34%}.setting-row button{min-width:90px;font-size:15px}.dev-grid .btn{font-size:14px;padding:13px}.credits dl{grid-template-columns:90px 1fr;font-size:13px}.credits li{font-size:13px}#hud{left:3%;right:3%;top:2%;gap:6px}.hudright{gap:6px}#hud .hudblock{padding:7px 9px}.hudstage .fine{display:none}.hudvalue{font-size:20px}.hudstage .hudvalue{font-size:15px}.bellcharges{font-size:14px}.hudright button{width:36px;height:36px;font-size:20px}#toast{top:16%;font-size:15px;padding:9px 15px}#hint{max-width:86%;font-size:13px}#combo{top:22%}.touch-action{bottom:16%;width:68px;height:68px}.menu.two{grid-template-columns:1fr}.roomcode{font-size:28px}#attract .banner{min-width:280px}#attract b{font-size:21px}.result-score{font-size:48px}}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js\",\"rapier\":\"https://cdn.jsdelivr.net/npm/@dimforge/rapier2d-compat@0.19.3/rapier.mjs\"}}</script>\n</head>\n<body>\n<div id=\"viewport\"></div><div id=\"vignette\"></div><div class=\"grain\"></div>\n<div id=\"loading\"><div class=\"loader-inner\"><h1>FLIP BROS</h1><div class=\"spinner\"></div><div id=\"load-msg\">Warming the pipes…<br>Building your night shift.</div></div></div>\n<div id=\"ui\">\n <div id=\"hud\" class=\"hidden\"><div class=\"hudblock\"><div class=\"hudlabel\">UNION SCORE <span id=\"net-badge\"></span></div><div class=\"hudvalue\" id=\"score\">000000</div><div class=\"hearts\" id=\"lives\"></div></div><div class=\"hudblock hudstage\"><div class=\"hudlabel\" id=\"shift-label\">SHIFT 01 / 04</div><div class=\"hudvalue\" id=\"shift-name\">PIPE DREAMS</div><div class=\"fine\" id=\"goal\">Flip 6 pests</div></div><div class=\"hudright\"><div class=\"hudblock\"><div class=\"hudlabel\">RATTLE BELL</div><div class=\"bellcharges\" id=\"charges\">◆ ◆ ◆</div></div><button id=\"pause-btn\" aria-label=\"Pause\">Ⅱ</button></div></div>\n <div id=\"bottom\" class=\"hidden\"><div id=\"hint\"></div><div id=\"controls\"></div></div><div id=\"toast\" class=\"hidden\"></div><div id=\"combo\" class=\"hidden\"></div>\n <div id=\"screen\" class=\"hidden\"></div><div id=\"floaters\"></div><div id=\"attract\" class=\"hidden\"><div class=\"banner\"><b>ON THE NIGHT SHIFT</b><p>Demo playing · Any input to take over</p></div></div>\n <button id=\"touch-action\" class=\"touch-action\" aria-label=\"Ring bell\">BELL</button><div id=\"touch-stick\"><i></i></div>\n</div>\n<script type=\"module\">\n/*__GAME__*/\n</script>\n</body></html>\nHTML\ncat > build.mjs <<'\"'JS'\nimport {readFileSync,writeFileSync} from 'node:fs';\nconst stem='Flip-Bros-Mario-Bros-1983-gpt-6.1-sol-max-20261105-200642';\nlet html=readFileSync('index.template.html','utf8').replace('/*__HUB_CLIENT__*/',()=>readFileSync('hub-session.js','utf8')).replace('/*__GAME__*/',()=>['audio.js','world.js','game.js','ui.js','network.js','app.js'].map(f=>readFileSync(f,'utf8')).join('\\\\n'));\nwriteFileSync('../'+stem+'.html',html);\nwriteFileSync('index.html',html);\nJS\nmv ../build-location.json build-location.json\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"cat > audio.js <<'JS'\nconst \"'$=id=>document.getElementById(id);\nconst clamp=(n,a,b)=>Math.max(a,Math.min(b,n));\nconst lerp=(a,b,t)=>a+(b-a)*t;\nlet THREE,RAPIER;\ntry{[THREE,RAPIER]=await Promise.all([import('\"'three'),import('rapier')]);await RAPIER.init();}\ncatch(e){\"'$('\"'load-msg').textContent='The engine could not load. Connect to the internet, then reload. '+e.message;throw e;}\nconst preferences={music:0.1,sound:0.65,shake:0.65,glyphs:'ps',assist:true};\ntry{Object.assign(preferences,JSON.parse(localStorage.getItem('flipbros-settings')||'{}'));}catch{}\nfunction savePrefs(){try{localStorage.setItem('flipbros-settings',JSON.stringify(preferences));}catch{}}\nclass AudioEngine{\n constructor(ctx=null){this.ctx=ctx;this.musicVolume=preferences.music;this.soundVolume=preferences.sound;this.next=0;this.beat=0;this.playing=false;this.events=0;this.ended=false;if(ctx)this.setup();}\n setup(){const c=this.ctx;this.master=c.createGain();this.master.gain.value=.75;this.master.connect(c.destination);this.music=c.createGain();this.music.gain.value=this.musicVolume;this.music.connect(this.master);this.effects=c.createGain();this.effects.gain.value=this.soundVolume;this.effects.connect(this.master);this.analyser=c.createAnalyser();this.analyser.fftSize=256;this.master.connect(this.analyser);this.noise=c.createBuffer(1,c.sampleRate*.3,c.sampleRate);const b=this.noise.getChannelData(0);let n=1;for(let i=0;i<b.length;i++){n=(n*16807)%2147483647;b[i]=(n/1073741824-1);}}\n async unlock(){if(this.ended)return;if(\"'!this.ctx){this.ctx=new(window.AudioContext||window.webkitAudioContext)();this.setup();this.next=this.ctx.currentTime+.05;}if(this.ctx.state==='\"'suspended')await this.ctx.resume();}\n volumes(){if(\"'!this.ctx)return;this.music.gain.setTargetAtTime(preferences.music,this.ctx.currentTime,.04);this.effects.gain.setTargetAtTime(preferences.sound,this.ctx.currentTime,.04);}\n note(freq,t,dur=.15,type='\"'square',vol=.1,dest=this.effects,slide=0){if(\"'!this.ctx||this.ended)return;const c=this.ctx,o=c.createOscillator(),g=c.createGain();o.type=type;o.frequency.setValueAtTime(Math.max(25,freq),t);if(slide)o.frequency.exponentialRampToValueAtTime(Math.max(25,slide),t+dur);g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(vol,t+.006);g.gain.exponentialRampToValueAtTime(.0001,t+dur);o.connect(g);g.connect(dest);o.start(t);o.stop(t+dur+.02);this.events++;}\n drum(t,vol=.1,dur=.06){if(!this.ctx||this.ended)return;const s=this.ctx.createBufferSource(),g=this.ctx.createGain(),f=this.ctx.createBiquadFilter();s.buffer=this.noise;f.type='\"'highpass';f.frequency.value=5500;g.gain.setValueAtTime(vol,t);g.gain.exponentialRampToValueAtTime(.0001,t+dur);s.connect(f);f.connect(g);g.connect(this.music);s.start(t);s.stop(t+dur);}\n voice(mood='hello',when=0){if(\"'!this.ctx||this.ended)return;const now=this.ctx.currentTime+when,syllables=mood==='\"'win'?6:3;for(let i=0;i<syllables;i++){const t=now+i*.075,o=this.ctx.createOscillator(),f=this.ctx.createBiquadFilter(),g=this.ctx.createGain();o.type='sawtooth';o.frequency.setValueAtTime(220+(i%3)*65+(mood==='win'?100:0),t);o.frequency.linearRampToValueAtTime(170+(i%2)*160,t+.07);f.type='bandpass';f.frequency.value=[900,1500,700,2100][i%4];f.Q.value=3;g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(.15,t+.015);g.gain.exponentialRampToValueAtTime(.0001,t+.07);o.connect(f);f.connect(g);g.connect(this.effects);o.start(t);o.stop(t+.08);this.events++;}}\n sfx(type){if(\"'!this.ctx||this.ended)return;const t=this.ctx.currentTime;const n=(f,dt,d,ty,v,s)=>this.note(f,t+dt,d,ty,v,this.effects,s);switch(type){case'\"'jump':n(230,0,.15,'square',.1,630);break;case'bump':n(95,0,.13,'triangle',.45,48);n(320,.025,.08,'square',.07);break;case'flip':n(350,0,.12,'triangle',.28,700);n(530,.06,.13,'square',.07,1000);break;case'kick':n(100,0,.15,'sawtooth',.16,35);n(800,.02,.15,'triangle',.2,140);break;case'coin':[660,880,1320].forEach((f,i)=>n(f,i*.045,.11,'sine',.18));break;case'hurt':n(340,0,.22,'sawtooth',.15,65);n(120,.15,.22,'triangle',.25,35);break;case'dash':n(180,0,.14,'sawtooth',.07,900);break;case'bell':[440,660,880,1100].forEach((f,i)=>n(f,0,.65,'sine',.13/(i+1)));break;case'clear':[60,64,67,72,76,79].forEach((f,i)=>n(440*2**((f-69)/12),i*.09,.25,'square',.09));this.voice('win',.55);break;case'lose':[67,63,60,55].forEach((f,i)=>n(440*2**((f-69)/12),i*.17,.3,'triangle',.2));break;case'menu':n(500,0,.05,'triangle',.13);break;}}\n tick(active,phase){if(\"'!this.ctx||this.ended)return;this.volumes();if(!active){this.next=this.ctx.currentTime+.08;return;}const c=this.ctx;let count=0;while(this.next<c.currentTime+.17&&count++<12){const i=this.beat%32,t=this.next,root=[48,48,53,55][Math.floor(i/8)];const melody=[0,7,12,7,3,7,10,7,0,7,12,15,12,7,3,7,5,12,17,12,8,12,15,12,7,14,19,17,14,10,7,3];if(i%2===0)this.note(440*2**((root-12-69)/12),t,.18,'\"'triangle',.35,this.music);if(i%4\"'!==3){const m=root+melody[i]+(phase===4?0:12);this.note(440*2**((m-69)/12),t,.105,'\"'square',.105,this.music);}this.drum(t,i%4===2?.17:.07,i%4===2?.085:.035);if(i%8===0)this.note(95,t,.12,'sine',.35,this.music,35);this.next+=60/(phase===4?144:128)/2;this.beat++;}}\n stop(){this.ended=true;if(this.master)this.master.gain.value=0;}\n}\nconst audio=new AudioEngine();\nJS\ncat > world.js <<'JS'\nconst C={ink:0x101e27,paper:0xffebc2,teal:0x67ceb2,copper:0xd78149,gold:0xffd16b,navy:0x173b45,red:0xf27a66,ice:0x92dcec};\nconst scene=new THREE.Scene();scene.background=new THREE.Color(0x122c35);scene.fog=new THREE.Fog(0x122c35,45,90);\nconst camera=new THREE.OrthographicCamera(-16,16,9,-9,.1,120);camera.position.set(0,12.5,38);camera.lookAt(0,7,0);\nconst viewport=\"'$('\"'viewport');\nconst renderer=new THREE.WebGPURenderer({antialias:true,powerPreference:'high-performance'});\nrenderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.15;\ntry{await renderer.init();}catch(e){\"'$('\"'load-msg').textContent='This browser cannot create a graphics context. Try a current Chrome, Edge, or Safari.';throw e;}\nviewport.appendChild(renderer.domElement);\nconst graphicsBackend=renderer.backend.isWebGPUBackend?'WebGPU':'WebGL2 fallback';\nscene.add(new THREE.AmbientLight(0xb3d8d2,1.25));const sun=new THREE.DirectionalLight(0xffe5b6,3.4);sun.position.set(-8,19,16);scene.add(sun);const rim=new THREE.DirectionalLight(0x5bd6df,1.8);rim.position.set(12,10,-9);scene.add(rim);\nconst materials=new Map();function mat(color,flat=true){const key=color+':'+flat;if(\"'!materials.has(key)){materials.set(key,new THREE.MeshToonMaterial({color,flatShading:flat}));}return materials.get(key);}\nconst black=new THREE.MeshBasicMaterial({color:C.ink,side:THREE.BackSide});\nconst geom={box:new THREE.BoxGeometry(1,1,1),sphere:new THREE.SphereGeometry(1,14,10),cylinder:new THREE.CylinderGeometry(1,1,1,14),torus:new THREE.TorusGeometry(1,.16,6,20)};\nfunction mesh(parent,kind,color,pos=[0,0,0],scale=[1,1,1],outline=true){const m=new THREE.Mesh(geom[kind]||kind,mat(color));m.position.set(...pos);m.scale.set(...scale);parent.add(m);if(outline){const ink=new THREE.Mesh(m.geometry,black);ink.scale.setScalar(1.045);m.add(ink);}return m;}\nfunction box(p,c,pos,size,outline=true){return mesh(p,'\"'box',c,pos,size,outline);}function ball(p,c,pos,size,outline=true){return mesh(p,'sphere',c,pos,size,outline);}\nfunction cylinder(p,c,pos,size,axis='y',outline=true){const m=mesh(p,'cylinder',c,pos,size,outline);if(axis==='x')m.rotation.z=Math.PI/2;if(axis==='z')m.rotation.x=Math.PI/2;return m;}\nfunction ring(p,c,pos,r,t=.13){const m=new THREE.Mesh(new THREE.TorusGeometry(r,t,7,24),mat(c));m.position.set(...pos);p.add(m);return m;}\nfunction textPlane(parent,text,x,y,z,size,color='#f7edce',bg=null,w=512,h=128){const cvs=document.createElement('canvas');cvs.width=w;cvs.height=h;const ctx=cvs.getContext('2d');if(bg){ctx.fillStyle=bg;ctx.fillRect(0,0,w,h);}ctx.fillStyle=color;ctx.font=\"'`900 ${h*.67}px \"Arial Black\",sans-serif`;ctx.textAlign='\"'center';ctx.textBaseline='middle';ctx.fillText(text,w/2,h*.52,w*.94);const tex=new THREE.CanvasTexture(cvs);tex.colorSpace=THREE.SRGBColorSpace;const m=new THREE.Mesh(new THREE.PlaneGeometry(size*w/h,size),new THREE.MeshBasicMaterial({map:tex,transparent:true,depthWrite:false}));m.position.set(x,y,z);parent.add(m);return m;}\nconst architecture=new THREE.Group();scene.add(architecture);const stageVisual=new THREE.Group();scene.add(stageVisual);const actors=new THREE.Group();scene.add(actors);const effectsGroup=new THREE.Group();scene.add(effectsGroup);\nbox(architecture,0x193a43,[0,7.3,-4.4],[33,19,1]);\n// Large masonry, scratched with a restrained ink hatch.\nfor(let row=0;row<10;row++)for(let col=0;col<12;col++){const x=-17+col*3.1+(row%2)*1.55,y=row*1.8;box(architecture,0x264851,[x,y,-3.83],[3.02,1.7,.07],false);if((row+col)%5===0){const slash=box(architecture,0x35565b,[x+.7,y-.3,-3.77],[.7,.035,.015],false);slash.rotation.z=.3;}}\nfor(const x of [-10.1,0,10.1]){box(architecture,0x0c252e,[x,7.7,-3.66],[5.7,12.8,.2]);const arch=new THREE.Mesh(new THREE.TorusGeometry(2.85,.26,7,24,Math.PI),mat(0x3b5c60));arch.position.set(x,13.6,-3.5);architecture.add(arch);for(const side of [-1,1])box(architecture,0x37585e,[x+side*2.85,7.5,-3.5],[.35,12,.2]);}\n// Copper supply pipes, collars, valves, and numbered service signs.\nfor(const x of [-14.4,14.4]){cylinder(architecture,C.teal,[x,7.7,-1.8],[.6,17,.6]);for(let y=1;y<16;y+=2.6){cylinder(architecture,0x478e82,[x,y,-1.8],[.8,.23,.8]);for(const dx of [-.51,.51])ball(architecture,C.gold,[x+dx,y,-1.28],[.075,.075,.05],false);}cylinder(architecture,C.teal,[x-Math.sign(x)*1.3,12.35,-1.8],[.6,2.6,.6],'x');cylinder(architecture,0x0c2429,[x-Math.sign(x)*2.6,12.35,-1.8],[.44,.025,.44],'x');cylinder(architecture,C.teal,[x-Math.sign(x)*2.55,12.35,-1.8],[.82,.3,.82],'x');cylinder(architecture,C.teal,[x-Math.sign(x)*1.1,.8,-1.7],[.58,2,.58],'x');}\nfor(const x of [-5.1,5.1]){cylinder(architecture,C.copper,[x,8,-3],[.14,15,.14]);for(const y of [2,5,8,11,14])cylinder(architecture,0xf0b772,[x,y,-3],[.24,.16,.24]);}\ncylinder(architecture,0x48656a,[0,14.35,-3.1],[1.8,.3,1.8],'z');cylinder(architecture,C.ink,[0,14.35,-2.88],[1.59,.1,1.59],'z');cylinder(architecture,C.paper,[0,14.35,-2.78],[1.42,.08,1.42],'z');\nconst gaugeNeedle=box(architecture,C.red,[0,14.35,-2.65],[.08,1.15,.07]);gaugeNeedle.geometry.translate(0,.2,0);gaugeNeedle.rotation.z=-.8;textPlane(architecture,'PRESSURE',0,13.52,-2.55,.23,'#1b3038');for(let i=0;i<9;i++){const a=-Math.PI*.75+i*Math.PI*1.5/8;const tick=box(architecture,C.ink,[Math.sin(a)*1.18,14.35+Math.cos(a)*1.18,-2.68],[.045,.18,.04],false);tick.rotation.z=-a;}\nconst fans=[];for(const x of [-9.7,9.7]){cylinder(architecture,0x516b6c,[x,9.1,-3.24],[1.8,.16,1.8],'z');cylinder(architecture,0x0d2630,[x,9.1,-3.1],[1.58,.1,1.58],'z');const f=new THREE.Group();f.position.set(x,9.1,-2.95);architecture.add(f);fans.push(f);for(let i=0;i<4;i++){const blade=box(f,0x355b62,[0,0,0],[.55,2.5,.08]);blade.rotation.z=i*Math.PI/2+.3;}ball(f,C.copper,[0,0,.12],[.3,.3,.14]);for(const dx of [-1.3,-.65,0,.65,1.3])box(architecture,0x70918c,[x+dx,9.1,-2.65],[.045,2.8,.05],false);}\ntextPlane(architecture,'NIGHT SHIFT',0,16.3,-2.9,.55,'#9ac5b8');textPlane(architecture,'07',-10.2,14.8,-2.8,.5,'#6c9c98');textPlane(architecture,'09',10.2,14.8,-2.8,.5,'#6c9c98');\nbox(architecture,0x0c272e,[0,-.45,0],[33,1,7]);box(architecture,0x37716d,[0,-.12,1.9],[33,.18,.45]);for(let i=0;i<36;i++)box(architecture,0x173b43,[-16+i*.92,-.1,2.05],[.12,.23,.5],false);\nconst water=new THREE.Mesh(new THREE.PlaneGeometry(36,5),new THREE.MeshBasicMaterial({color:0x1f8580,transparent:true,opacity:.45}));water.rotation.x=-Math.PI/2;water.position.set(0,-.26,5.2);architecture.add(water);\nconst planks=[{x:0,w:29,y:.45},{x:-8.5,w:12,y:4.05},{x:8.5,w:12,y:4.05},{x:0,w:20.2,y:7.65},{x:-8.5,w:12,y:11.25},{x:8.5,w:12,y:11.25}];\nconst platforms=[];\nfor(const [i,p]of planks.entries()){const g=new THREE.Group();stageVisual.add(g);box(g,C.ink,[p.x,p.y-.28,0],[p.w,.56,2.1],false);box(g,i===0?0x446e70:C.teal,[p.x,p.y-.18,.02],[p.w-.07,.31,2]);box(g,i===0?0x7a9f92:0xb3e3be,[p.x,p.y-.025,.02],[p.w,.1,2.1]);for(let x=p.x-p.w/2+.5;x<p.x+p.w/2;x+=1.1){ball(g,C.ink,[x,p.y-.27,1.04],[.055,.055,.03],false);if(i\"'!==0){const hatch=box(g,0x24554f,[x,p.y-.24,1.03],[.38,.07,.025],false);hatch.rotation.z=.5;}}if(i>0)for(const x of [p.x-p.w*.35,p.x+p.w*.35]){box(architecture,0x345859,[x,p.y-.8,-.8],[.18,1.1,1]);const strut=box(architecture,0x345859,[x+.35,p.y-.65,-.8],[.18,1.05,.6]);strut.rotation.z=-.7;}const mix=new THREE.AnimationMixer(g);const clip=new THREE.AnimationClip('\"'bump',.32,[new THREE.NumberKeyframeTrack('.position[y]',[0,.07,.16,.32],[0,.32,-.04,0])]);const action=mix.clipAction(clip);action.setLoop(THREE.LoopOnce,1);action.clampWhenFinished=true;platforms.push({...p,index:i,group:g,mixer:mix,action});}\nconst bellVisual=new THREE.Group();bellVisual.position.set(0,2.15,.1);stageVisual.add(bellVisual);box(bellVisual,C.ink,[0,0,0],[1.66,1.24,1.5],false);box(bellVisual,C.gold,[0,0,.03],[1.5,1.08,1.47]);textPlane(bellVisual,'BELL',0,.04,.8,.38,'#172e35');for(const x of [-.57,.57])for(const y of [-.34,.34])ball(bellVisual,C.ink,[x,y,.81],[.055,.055,.03],false);\nconst bellMixer=new THREE.AnimationMixer(bellVisual);const bellAction=bellMixer.clipAction(new THREE.AnimationClip('ring',.5,[new THREE.NumberKeyframeTrack('.rotation[z]',[0,.07,.14,.24,.35,.5],[0,-.18,.15,-.1,.06,0])]));bellAction.setLoop(THREE.LoopOnce,1);bellAction.clampWhenFinished=true;\nfunction limb(parent,name,x,y,color,length=.5){const pivot=new THREE.Group();pivot.name=name;pivot.position.set(x,y,0);parent.add(pivot);cylinder(pivot,color,[0,-length/2,0],[.14,length,.14]);ball(pivot,C.ink,[0,-length,0.08],[.21,.14,.28]);return pivot;}\nfunction heroModel(id){const root=new THREE.Group(),rig=new THREE.Group();root.add(rig);const cap=[C.copper,C.teal,C.gold,C.red][id%4],suit=[0x287a84,0x8173a4,0x4a9682,0x577eae][id%4];box(rig,suit,[0,.62,0],[.64,.57,.43]);ball(rig,C.paper,[0,1.1,.02],[.42,.38,.33]);ball(rig,0x9c7051,[0,1.05,.31],[.34,.16,.12]);ball(rig,C.ink,[.04,1.06,.43],[.105,.085,.07]);for(const x of [-.17,.17]){ball(rig,C.paper,[x,1.18,.29],[.13,.16,.08]);ball(rig,C.ink,[x+.025,1.18,.37],[.057,.08,.035]);ball(rig,cap,[x*1.8,1.31,-.03],[.13,.16,.13]);}ball(rig,cap,[0,1.38,-.015],[.44,.18,.35]);box(rig,cap,[0,1.34,.3],[.84,.08,.31]);box(rig,C.paper,[0,.77,.245],[.22,.15,.03]);textPlane(rig,String(id+1),0,.78,.27,.13,'#17313b',null,128,128);for(const x of [-.22,.22])ball(rig,C.gold,[x,.8,.24],[.045,.045,.03],false);const armL=limb(rig,'armL',-.43,.85,cap,.39),armR=limb(rig,'armR',.43,.85,cap,.39);for(const arm of [armL,armR])ball(arm,C.paper,[0,-.36,.04],[.17,.18,.17]);limb(rig,'legL',-.18,.36,suit,.27);limb(rig,'legR',.18,.36,suit,.27);const tail=new THREE.Group();tail.position.set(.25,.5,-.2);tail.rotation.z=-.65;rig.add(tail);for(let i=0;i<4;i++)ball(tail,i%2?C.ink:C.paper,[.05,-i*.12,-.12-i*.08],[.14,.14,.16]);const pack=box(rig,0x785740,[0,.66,-.33],[.46,.44,.23]);cylinder(pack,C.gold,[.35,.1,0],[.06,.64,.06]);\n const mixer=new THREE.AnimationMixer(rig);const walk=new THREE.AnimationClip('walk',.5,[new THREE.NumberKeyframeTrack('armL.rotation[z]',[0,.125,.25,.375,.5],[-.55,0,.55,0,-.55]),new THREE.NumberKeyframeTrack('armR.rotation[z]',[0,.125,.25,.375,.5],[.55,0,-.55,0,.55]),new THREE.NumberKeyframeTrack('legL.rotation[z]',[0,.125,.25,.375,.5],[.65,0,-.65,0,.65]),new THREE.NumberKeyframeTrack('legR.rotation[z]',[0,.125,.25,.375,.5],[-.65,0,.65,0,-.65]),new THREE.NumberKeyframeTrack('.position[y]',[0,.125,.25,.375,.5],[0,.05,0,.05,0])]);const idle=new THREE.AnimationClip('idle',1.8,[new THREE.NumberKeyframeTrack('.scale[y]',[0,.9,1.8],[1,1.035,1])]);const jump=new THREE.AnimationClip('jump',.8,[new THREE.NumberKeyframeTrack('armL.rotation[z]',[0,.15,.6,.8],[.25,1.4,1.4,.25]),new THREE.NumberKeyframeTrack('armR.rotation[z]',[0,.15,.6,.8],[-.25,-1.4,-1.4,-.25]),new THREE.NumberKeyframeTrack('legL.rotation[z]',[0,.4,.8],[.1,.4,.1]),new THREE.NumberKeyframeTrack('legR.rotation[z]',[0,.4,.8],[-.1,-.4,-.1])]);const actions={walk:mixer.clipAction(walk),idle:mixer.clipAction(idle),jump:mixer.clipAction(jump)};actions.idle.play();root.userData={rig,mixer,actions,current:'idle'};return root;}\nfunction enemyModel(type){const root=new THREE.Group(),rig=new THREE.Group();root.add(rig);const colors={crab:C.teal,armored:C.copper,hopper:C.red,frost:C.ice,boss:C.copper};const color=colors[type]||C.teal;const boss=type==='boss',s=boss?1.9:1;rig.scale.setScalar(s);ball(rig,color,[0,.37,0],[.65,.37,.45]);ball(rig,type==='armored'?0xeeb861:color,[0,.58,-.03],[.61,.28,.43]);box(rig,C.paper,[0,.5,.38],[.7,.12,.08]);for(const x of [-.32,.32]){cylinder(rig,color,[x,.75,.14],[.065,.4,.065]);ball(rig,C.paper,[x,.95,.16],[.17,.2,.14]);ball(rig,C.ink,[x+.04,.96,.29],[.075,.1,.04]);const leg=new THREE.Group();leg.name=x<0?'clawL':'clawR';leg.position.set(x*2,.32,.12);rig.add(leg);ball(leg,color,[x<0?-.17:.17,.12,0],[.28,.2,.22]);const notch=box(leg,C.ink,[x<0?-.32:.32,.2,.21],[.1,.14,.04],false);for(let j=0;j<3;j++){const l=box(rig,C.ink,[x*1.6,.12,-.25+j*.23],[.42,.12,.13]);l.rotation.z=x<0?.35:-.35;}}if(type==='hopper'){for(const x of [-.55,.55]){const wing=ball(rig,C.paper,[x,.67,-.22],[.38,.16,.08]);wing.rotation.z=x;}ring(rig,C.gold,[0,.68,.42],.25,.06);}if(type==='frost'){for(let i=0;i<4;i++){const crystal=mesh(rig,new THREE.ConeGeometry(.16,.42,4),0xcaf4f5,[-.4+i*.27,.86,-.12],[1,1,1]);crystal.rotation.z=(i-1.5)*.18;}}if(type==='armored'){box(rig,C.ink,[0,.81,-.06],[1.05,.12,.51]);box(rig,C.gold,[0,.87,-.03],[.2,.14,.6]);}if(boss){cylinder(rig,0xd09257,[0,.93,-.14],[.48,.62,.38]);cylinder(rig,C.gold,[0,1.26,-.14],[.58,.12,.46]);const valve=ring(rig,C.red,[0,1.43,-.1],.33,.07);box(rig,C.red,[0,1.43,-.1],[.5,.055,.06]);box(rig,C.red,[0,1.43,-.1],[.055,.5,.06]);textPlane(rig,'CLOG',0,.57,.48,.19,'#17313b');}const mixer=new THREE.AnimationMixer(rig),clip=new THREE.AnimationClip('scuttle',.55,[new THREE.NumberKeyframeTrack('clawL.rotation[z]',[0,.275,.55],[-.2,.3,-.2]),new THREE.NumberKeyframeTrack('clawR.rotation[z]',[0,.275,.55],[.2,-.3,.2]),new THREE.NumberKeyframeTrack('.position[y]',[0,.275,.55],[0,.055,0])]);mixer.clipAction(clip).play();root.userData={rig,mixer};return root;}\nconst coinGeo=new THREE.CylinderGeometry(.25,.25,.09,10);const coinMat=mat(C.gold);\nfunction coinModel(){const m=new THREE.Mesh(coinGeo,coinMat);m.rotation.x=Math.PI/2;const ink=new THREE.Mesh(coinGeo,black);ink.scale.setScalar(1.09);m.add(ink);return m;}\nconst shadowMat=new THREE.MeshBasicMaterial({color:0x081e27,transparent:true,opacity:.3,depthWrite:false});\nfunction shadow(){const m=new THREE.Mesh(new THREE.CircleGeometry(.6,16),shadowMat);m.rotation.x=-Math.PI/2;actors.add(m);return m;}\nfunction floorAt(x,y){let best=null;for(const p of platforms)if(x>p.x-p.w/2-.1&&x<p.x+p.w/2+.1&&p.y<y+.12&&(\"'!best||p.y>best.y))best=p;return best;}\nconst particles=[],floaters=[];let shake=0;\nfunction burst(x,y,color,count=12,force=4){for(let i=0;i<count;i++){const m=mesh(effectsGroup,i%3===0?'\"'box':'sphere',color,[x,y,.4+Math.random()*.6],[.06+Math.random()*.09,.06+Math.random()*.09,.07],false);particles.push({m,x,y,vx:(Math.random()-.5)*force,vy:1+Math.random()*force,z:m.position.z,t:.4+Math.random()*.4,max:1});}}\nfunction floatText(text,x,y,color='#ffda70',pop=false){const el=document.createElement('div');el.className='floater'+(pop?' poptext':'');el.textContent=text;el.style.color=color;\"'$('\"'floaters').appendChild(el);floaters.push({el,x,y,t:1.1});}\nfunction updateEffects(dt){for(let i=particles.length-1;i>=0;i--){const p=particles[i];p.t-=dt;p.vy-=dt*10;p.x+=p.vx*dt;p.y+=p.vy*dt;p.m.position.set(p.x,p.y,p.z);p.m.rotation.z+=dt*5;p.m.scale.multiplyScalar(1-dt*.5);if(p.t<=0){effectsGroup.remove(p.m);particles.splice(i,1);}}for(let i=floaters.length-1;i>=0;i--){const f=floaters[i];f.t-=dt;f.y+=dt*.8;const v=new THREE.Vector3(f.x,f.y,1).project(camera);f.el.style.left=(v.x*.5+.5)*innerWidth+'px';f.el.style.top=(-v.y*.5+.5)*innerHeight+'px';f.el.style.opacity=Math.min(1,f.t*3);if(f.t<=0){f.el.remove();floaters.splice(i,1);}}for(const p of platforms)p.mixer.update(dt);bellMixer.update(dt);for(const f of fans)f.rotation.z+=dt*.5;gaugeNeedle.rotation.z=-.8+Math.sin(performance.now()*.0004)*.22;}\nfunction resize(){const a=innerWidth/innerHeight;let h=18.9,w=h*a;if(w<32.4){w=32.4;h=w/a;}camera.left=-w/2;camera.right=w/2;camera.top=h/2;camera.bottom=-h/2;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);}\naddEventListener('resize',resize);resize();\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"cat > audio.js <<'JS'\nconst \"'$=id=>document.getElementById(id);\nconst clamp=(n,a,b)=>Math.max(a,Math.min(b,n));\nconst lerp=(a,b,t)=>a+(b-a)*t;\nlet THREE,RAPIER;\ntry{[THREE,RAPIER]=await Promise.all([import('\"'three'),import('rapier')]);await RAPIER.init();}\ncatch(e){\"'$('\"'load-msg').textContent='The engine could not load. Connect to the internet, then reload. '+e.message;throw e;}\nconst preferences={music:0.1,sound:0.65,shake:0.65,glyphs:'ps',assist:true};\ntry{Object.assign(preferences,JSON.parse(localStorage.getItem('flipbros-settings')||'{}'));}catch{}\nfunction savePrefs(){try{localStorage.setItem('flipbros-settings',JSON.stringify(preferences));}catch{}}\nclass AudioEngine{\n constructor(ctx=null){this.ctx=ctx;this.musicVolume=preferences.music;this.soundVolume=preferences.sound;this.next=0;this.beat=0;this.playing=false;this.events=0;this.ended=false;if(ctx)this.setup();}\n setup(){const c=this.ctx;this.master=c.createGain();this.master.gain.value=.75;this.master.connect(c.destination);this.music=c.createGain();this.music.gain.value=this.musicVolume;this.music.connect(this.master);this.effects=c.createGain();this.effects.gain.value=this.soundVolume;this.effects.connect(this.master);this.analyser=c.createAnalyser();this.analyser.fftSize=256;this.master.connect(this.analyser);this.noise=c.createBuffer(1,c.sampleRate*.3,c.sampleRate);const b=this.noise.getChannelData(0);let n=1;for(let i=0;i<b.length;i++){n=(n*16807)%2147483647;b[i]=(n/1073741824-1);}}\n async unlock(){if(this.ended)return;if(\"'!this.ctx){this.ctx=new(window.AudioContext||window.webkitAudioContext)();this.setup();this.next=this.ctx.currentTime+.05;}if(this.ctx.state==='\"'suspended')await this.ctx.resume();}\n volumes(){if(\"'!this.ctx)return;this.music.gain.setTargetAtTime(preferences.music,this.ctx.currentTime,.04);this.effects.gain.setTargetAtTime(preferences.sound,this.ctx.currentTime,.04);}\n note(freq,t,dur=.15,type='\"'square',vol=.1,dest=this.effects,slide=0){if(\"'!this.ctx||this.ended)return;const c=this.ctx,o=c.createOscillator(),g=c.createGain();o.type=type;o.frequency.setValueAtTime(Math.max(25,freq),t);if(slide)o.frequency.exponentialRampToValueAtTime(Math.max(25,slide),t+dur);g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(vol,t+.006);g.gain.exponentialRampToValueAtTime(.0001,t+dur);o.connect(g);g.connect(dest);o.start(t);o.stop(t+dur+.02);this.events++;}\n drum(t,vol=.1,dur=.06){if(!this.ctx||this.ended)return;const s=this.ctx.createBufferSource(),g=this.ctx.createGain(),f=this.ctx.createBiquadFilter();s.buffer=this.noise;f.type='\"'highpass';f.frequency.value=5500;g.gain.setValueAtTime(vol,t);g.gain.exponentialRampToValueAtTime(.0001,t+dur);s.connect(f);f.connect(g);g.connect(this.music);s.start(t);s.stop(t+dur);}\n voice(mood='hello',when=0){if(\"'!this.ctx||this.ended)return;const now=this.ctx.currentTime+when,syllables=mood==='\"'win'?6:3;for(let i=0;i<syllables;i++){const t=now+i*.075,o=this.ctx.createOscillator(),f=this.ctx.createBiquadFilter(),g=this.ctx.createGain();o.type='sawtooth';o.frequency.setValueAtTime(220+(i%3)*65+(mood==='win'?100:0),t);o.frequency.linearRampToValueAtTime(170+(i%2)*160,t+.07);f.type='bandpass';f.frequency.value=[900,1500,700,2100][i%4];f.Q.value=3;g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(.15,t+.015);g.gain.exponentialRampToValueAtTime(.0001,t+.07);o.connect(f);f.connect(g);g.connect(this.effects);o.start(t);o.stop(t+.08);this.events++;}}\n sfx(type){if(\"'!this.ctx||this.ended)return;const t=this.ctx.currentTime;const n=(f,dt,d,ty,v,s)=>this.note(f,t+dt,d,ty,v,this.effects,s);switch(type){case'\"'jump':n(230,0,.15,'square',.1,630);break;case'bump':n(95,0,.13,'triangle',.45,48);n(320,.025,.08,'square',.07);break;case'flip':n(350,0,.12,'triangle',.28,700);n(530,.06,.13,'square',.07,1000);break;case'kick':n(100,0,.15,'sawtooth',.16,35);n(800,.02,.15,'triangle',.2,140);break;case'coin':[660,880,1320].forEach((f,i)=>n(f,i*.045,.11,'sine',.18));break;case'hurt':n(340,0,.22,'sawtooth',.15,65);n(120,.15,.22,'triangle',.25,35);break;case'dash':n(180,0,.14,'sawtooth',.07,900);break;case'bell':[440,660,880,1100].forEach((f,i)=>n(f,0,.65,'sine',.13/(i+1)));break;case'clear':[60,64,67,72,76,79].forEach((f,i)=>n(440*2**((f-69)/12),i*.09,.25,'square',.09));this.voice('win',.55);break;case'lose':[67,63,60,55].forEach((f,i)=>n(440*2**((f-69)/12),i*.17,.3,'triangle',.2));break;case'menu':n(500,0,.05,'triangle',.13);break;}}\n tick(active,phase){if(\"'!this.ctx||this.ended)return;this.volumes();if(!active){this.next=this.ctx.currentTime+.08;return;}const c=this.ctx;let count=0;while(this.next<c.currentTime+.17&&count++<12){const i=this.beat%32,t=this.next,root=[48,48,53,55][Math.floor(i/8)];const melody=[0,7,12,7,3,7,10,7,0,7,12,15,12,7,3,7,5,12,17,12,8,12,15,12,7,14,19,17,14,10,7,3];if(i%2===0)this.note(440*2**((root-12-69)/12),t,.18,'\"'triangle',.35,this.music);if(i%4\"'!==3){const m=root+melody[i]+(phase===4?0:12);this.note(440*2**((m-69)/12),t,.105,'\"'square',.105,this.music);}this.drum(t,i%4===2?.17:.07,i%4===2?.085:.035);if(i%8===0)this.note(95,t,.12,'sine',.35,this.music,35);this.next+=60/(phase===4?144:128)/2;this.beat++;}}\n stop(){this.ended=true;if(this.master)this.master.gain.value=0;}\n}\nconst audio=new AudioEngine();\nJS\ncat > world.js <<'JS'\nconst C={ink:0x101e27,paper:0xffebc2,teal:0x67ceb2,copper:0xd78149,gold:0xffd16b,navy:0x173b45,red:0xf27a66,ice:0x92dcec};\nconst scene=new THREE.Scene();scene.background=new THREE.Color(0x122c35);scene.fog=new THREE.Fog(0x122c35,45,90);\nconst camera=new THREE.OrthographicCamera(-16,16,9,-9,.1,120);camera.position.set(0,12.5,38);camera.lookAt(0,7,0);\nconst viewport=\"'$('\"'viewport');\nconst renderer=new THREE.WebGPURenderer({antialias:true,powerPreference:'high-performance'});\nrenderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.15;\ntry{await renderer.init();}catch(e){\"'$('\"'load-msg').textContent='This browser cannot create a graphics context. Try a current Chrome, Edge, or Safari.';throw e;}\nviewport.appendChild(renderer.domElement);\nconst graphicsBackend=renderer.backend.isWebGPUBackend?'WebGPU':'WebGL2 fallback';\nscene.add(new THREE.AmbientLight(0xb3d8d2,1.25));const sun=new THREE.DirectionalLight(0xffe5b6,3.4);sun.position.set(-8,19,16);scene.add(sun);const rim=new THREE.DirectionalLight(0x5bd6df,1.8);rim.position.set(12,10,-9);scene.add(rim);\nconst materials=new Map();function mat(color,flat=true){const key=color+':'+flat;if(\"'!materials.has(key)){materials.set(key,new THREE.MeshToonMaterial({color,flatShading:flat}));}return materials.get(key);}\nconst black=new THREE.MeshBasicMaterial({color:C.ink,side:THREE.BackSide});\nconst geom={box:new THREE.BoxGeometry(1,1,1),sphere:new THREE.SphereGeometry(1,14,10),cylinder:new THREE.CylinderGeometry(1,1,1,14),torus:new THREE.TorusGeometry(1,.16,6,20)};\nfunction mesh(parent,kind,color,pos=[0,0,0],scale=[1,1,1],outline=true){const m=new THREE.Mesh(geom[kind]||kind,mat(color));m.position.set(...pos);m.scale.set(...scale);parent.add(m);if(outline){const ink=new THREE.Mesh(m.geometry,black);ink.scale.setScalar(1.045);m.add(ink);}return m;}\nfunction box(p,c,pos,size,outline=true){return mesh(p,'\"'box',c,pos,size,outline);}function ball(p,c,pos,size,outline=true){return mesh(p,'sphere',c,pos,size,outline);}\nfunction cylinder(p,c,pos,size,axis='y',outline=true){const m=mesh(p,'cylinder',c,pos,size,outline);if(axis==='x')m.rotation.z=Math.PI/2;if(axis==='z')m.rotation.x=Math.PI/2;return m;}\nfunction ring(p,c,pos,r,t=.13){const m=new THREE.Mesh(new THREE.TorusGeometry(r,t,7,24),mat(c));m.position.set(...pos);p.add(m);return m;}\nfunction textPlane(parent,text,x,y,z,size,color='#f7edce',bg=null,w=512,h=128){const cvs=document.createElement('canvas');cvs.width=w;cvs.height=h;const ctx=cvs.getContext('2d');if(bg){ctx.fillStyle=bg;ctx.fillRect(0,0,w,h);}ctx.fillStyle=color;ctx.font=\"'`900 ${h*.67}px \"Arial Black\",sans-serif`;ctx.textAlign='\"'center';ctx.textBaseline='middle';ctx.fillText(text,w/2,h*.52,w*.94);const tex=new THREE.CanvasTexture(cvs);tex.colorSpace=THREE.SRGBColorSpace;const m=new THREE.Mesh(new THREE.PlaneGeometry(size*w/h,size),new THREE.MeshBasicMaterial({map:tex,transparent:true,depthWrite:false}));m.position.set(x,y,z);parent.add(m);return m;}\nconst architecture=new THREE.Group();scene.add(architecture);const stageVisual=new THREE.Group();scene.add(stageVisual);const actors=new THREE.Group();scene.add(actors);const effectsGroup=new THREE.Group();scene.add(effectsGroup);\nbox(architecture,0x193a43,[0,7.3,-4.4],[33,19,1]);\n// Large masonry, scratched with a restrained ink hatch.\nfor(let row=0;row<10;row++)for(let col=0;col<12;col++){const x=-17+col*3.1+(row%2)*1.55,y=row*1.8;box(architecture,0x264851,[x,y,-3.83],[3.02,1.7,.07],false);if((row+col)%5===0){const slash=box(architecture,0x35565b,[x+.7,y-.3,-3.77],[.7,.035,.015],false);slash.rotation.z=.3;}}\nfor(const x of [-10.1,0,10.1]){box(architecture,0x0c252e,[x,7.7,-3.66],[5.7,12.8,.2]);const arch=new THREE.Mesh(new THREE.TorusGeometry(2.85,.26,7,24,Math.PI),mat(0x3b5c60));arch.position.set(x,13.6,-3.5);architecture.add(arch);for(const side of [-1,1])box(architecture,0x37585e,[x+side*2.85,7.5,-3.5],[.35,12,.2]);}\n// Copper supply pipes, collars, valves, and numbered service signs.\nfor(const x of [-14.4,14.4]){cylinder(architecture,C.teal,[x,7.7,-1.8],[.6,17,.6]);for(let y=1;y<16;y+=2.6){cylinder(architecture,0x478e82,[x,y,-1.8],[.8,.23,.8]);for(const dx of [-.51,.51])ball(architecture,C.gold,[x+dx,y,-1.28],[.075,.075,.05],false);}cylinder(architecture,C.teal,[x-Math.sign(x)*1.3,12.35,-1.8],[.6,2.6,.6],'x');cylinder(architecture,0x0c2429,[x-Math.sign(x)*2.6,12.35,-1.8],[.44,.025,.44],'x');cylinder(architecture,C.teal,[x-Math.sign(x)*2.55,12.35,-1.8],[.82,.3,.82],'x');cylinder(architecture,C.teal,[x-Math.sign(x)*1.1,.8,-1.7],[.58,2,.58],'x');}\nfor(const x of [-5.1,5.1]){cylinder(architecture,C.copper,[x,8,-3],[.14,15,.14]);for(const y of [2,5,8,11,14])cylinder(architecture,0xf0b772,[x,y,-3],[.24,.16,.24]);}\ncylinder(architecture,0x48656a,[0,14.35,-3.1],[1.8,.3,1.8],'z');cylinder(architecture,C.ink,[0,14.35,-2.88],[1.59,.1,1.59],'z');cylinder(architecture,C.paper,[0,14.35,-2.78],[1.42,.08,1.42],'z');\nconst gaugeNeedle=box(architecture,C.red,[0,14.35,-2.65],[.08,1.15,.07]);gaugeNeedle.geometry.translate(0,.2,0);gaugeNeedle.rotation.z=-.8;textPlane(architecture,'PRESSURE',0,13.52,-2.55,.23,'#1b3038');for(let i=0;i<9;i++){const a=-Math.PI*.75+i*Math.PI*1.5/8;const tick=box(architecture,C.ink,[Math.sin(a)*1.18,14.35+Math.cos(a)*1.18,-2.68],[.045,.18,.04],false);tick.rotation.z=-a;}\nconst fans=[];for(const x of [-9.7,9.7]){cylinder(architecture,0x516b6c,[x,9.1,-3.24],[1.8,.16,1.8],'z');cylinder(architecture,0x0d2630,[x,9.1,-3.1],[1.58,.1,1.58],'z');const f=new THREE.Group();f.position.set(x,9.1,-2.95);architecture.add(f);fans.push(f);for(let i=0;i<4;i++){const blade=box(f,0x355b62,[0,0,0],[.55,2.5,.08]);blade.rotation.z=i*Math.PI/2+.3;}ball(f,C.copper,[0,0,.12],[.3,.3,.14]);for(const dx of [-1.3,-.65,0,.65,1.3])box(architecture,0x70918c,[x+dx,9.1,-2.65],[.045,2.8,.05],false);}\ntextPlane(architecture,'NIGHT SHIFT',0,16.3,-2.9,.55,'#9ac5b8');textPlane(architecture,'07',-10.2,14.8,-2.8,.5,'#6c9c98');textPlane(architecture,'09',10.2,14.8,-2.8,.5,'#6c9c98');\nbox(architecture,0x0c272e,[0,-.45,0],[33,1,7]);box(architecture,0x37716d,[0,-.12,1.9],[33,.18,.45]);for(let i=0;i<36;i++)box(architecture,0x173b43,[-16+i*.92,-.1,2.05],[.12,.23,.5],false);\nconst water=new THREE.Mesh(new THREE.PlaneGeometry(36,5),new THREE.MeshBasicMaterial({color:0x1f8580,transparent:true,opacity:.45}));water.rotation.x=-Math.PI/2;water.position.set(0,-.26,5.2);architecture.add(water);\nconst planks=[{x:0,w:29,y:.45},{x:-8.5,w:12,y:4.05},{x:8.5,w:12,y:4.05},{x:0,w:20.2,y:7.65},{x:-8.5,w:12,y:11.25},{x:8.5,w:12,y:11.25}];\nconst platforms=[];\nfor(const [i,p]of planks.entries()){const g=new THREE.Group();stageVisual.add(g);box(g,C.ink,[p.x,p.y-.28,0],[p.w,.56,2.1],false);box(g,i===0?0x446e70:C.teal,[p.x,p.y-.18,.02],[p.w-.07,.31,2]);box(g,i===0?0x7a9f92:0xb3e3be,[p.x,p.y-.025,.02],[p.w,.1,2.1]);for(let x=p.x-p.w/2+.5;x<p.x+p.w/2;x+=1.1){ball(g,C.ink,[x,p.y-.27,1.04],[.055,.055,.03],false);if(i\"'!==0){const hatch=box(g,0x24554f,[x,p.y-.24,1.03],[.38,.07,.025],false);hatch.rotation.z=.5;}}if(i>0)for(const x of [p.x-p.w*.35,p.x+p.w*.35]){box(architecture,0x345859,[x,p.y-.8,-.8],[.18,1.1,1]);const strut=box(architecture,0x345859,[x+.35,p.y-.65,-.8],[.18,1.05,.6]);strut.rotation.z=-.7;}const mix=new THREE.AnimationMixer(g);const clip=new THREE.AnimationClip('\"'bump',.32,[new THREE.NumberKeyframeTrack('.position[y]',[0,.07,.16,.32],[0,.32,-.04,0])]);const action=mix.clipAction(clip);action.setLoop(THREE.LoopOnce,1);action.clampWhenFinished=true;platforms.push({...p,index:i,group:g,mixer:mix,action});}\nconst bellVisual=new THREE.Group();bellVisual.position.set(0,2.15,.1);stageVisual.add(bellVisual);box(bellVisual,C.ink,[0,0,0],[1.66,1.24,1.5],false);box(bellVisual,C.gold,[0,0,.03],[1.5,1.08,1.47]);textPlane(bellVisual,'BELL',0,.04,.8,.38,'#172e35');for(const x of [-.57,.57])for(const y of [-.34,.34])ball(bellVisual,C.ink,[x,y,.81],[.055,.055,.03],false);\nconst bellMixer=new THREE.AnimationMixer(bellVisual);const bellAction=bellMixer.clipAction(new THREE.AnimationClip('ring',.5,[new THREE.NumberKeyframeTrack('.rotation[z]',[0,.07,.14,.24,.35,.5],[0,-.18,.15,-.1,.06,0])]));bellAction.setLoop(THREE.LoopOnce,1);bellAction.clampWhenFinished=true;\nfunction limb(parent,name,x,y,color,length=.5){const pivot=new THREE.Group();pivot.name=name;pivot.position.set(x,y,0);parent.add(pivot);cylinder(pivot,color,[0,-length/2,0],[.14,length,.14]);ball(pivot,C.ink,[0,-length,0.08],[.21,.14,.28]);return pivot;}\nfunction heroModel(id){const root=new THREE.Group(),rig=new THREE.Group();root.add(rig);const cap=[C.copper,C.teal,C.gold,C.red][id%4],suit=[0x287a84,0x8173a4,0x4a9682,0x577eae][id%4];box(rig,suit,[0,.62,0],[.64,.57,.43]);ball(rig,C.paper,[0,1.1,.02],[.42,.38,.33]);ball(rig,0x9c7051,[0,1.05,.31],[.34,.16,.12]);ball(rig,C.ink,[.04,1.06,.43],[.105,.085,.07]);for(const x of [-.17,.17]){ball(rig,C.paper,[x,1.18,.29],[.13,.16,.08]);ball(rig,C.ink,[x+.025,1.18,.37],[.057,.08,.035]);ball(rig,cap,[x*1.8,1.31,-.03],[.13,.16,.13]);}ball(rig,cap,[0,1.38,-.015],[.44,.18,.35]);box(rig,cap,[0,1.34,.3],[.84,.08,.31]);box(rig,C.paper,[0,.77,.245],[.22,.15,.03]);textPlane(rig,String(id+1),0,.78,.27,.13,'#17313b',null,128,128);for(const x of [-.22,.22])ball(rig,C.gold,[x,.8,.24],[.045,.045,.03],false);const armL=limb(rig,'armL',-.43,.85,cap,.39),armR=limb(rig,'armR',.43,.85,cap,.39);for(const arm of [armL,armR])ball(arm,C.paper,[0,-.36,.04],[.17,.18,.17]);limb(rig,'legL',-.18,.36,suit,.27);limb(rig,'legR',.18,.36,suit,.27);const tail=new THREE.Group();tail.position.set(.25,.5,-.2);tail.rotation.z=-.65;rig.add(tail);for(let i=0;i<4;i++)ball(tail,i%2?C.ink:C.paper,[.05,-i*.12,-.12-i*.08],[.14,.14,.16]);const pack=box(rig,0x785740,[0,.66,-.33],[.46,.44,.23]);cylinder(pack,C.gold,[.35,.1,0],[.06,.64,.06]);\n const mixer=new THREE.AnimationMixer(rig);const walk=new THREE.AnimationClip('walk',.5,[new THREE.NumberKeyframeTrack('armL.rotation[z]',[0,.125,.25,.375,.5],[-.55,0,.55,0,-.55]),new THREE.NumberKeyframeTrack('armR.rotation[z]',[0,.125,.25,.375,.5],[.55,0,-.55,0,.55]),new THREE.NumberKeyframeTrack('legL.rotation[z]',[0,.125,.25,.375,.5],[.65,0,-.65,0,.65]),new THREE.NumberKeyframeTrack('legR.rotation[z]',[0,.125,.25,.375,.5],[-.65,0,.65,0,-.65]),new THREE.NumberKeyframeTrack('.position[y]',[0,.125,.25,.375,.5],[0,.05,0,.05,0])]);const idle=new THREE.AnimationClip('idle',1.8,[new THREE.NumberKeyframeTrack('.scale[y]',[0,.9,1.8],[1,1.035,1])]);const jump=new THREE.AnimationClip('jump',.8,[new THREE.NumberKeyframeTrack('armL.rotation[z]',[0,.15,.6,.8],[.25,1.4,1.4,.25]),new THREE.NumberKeyframeTrack('armR.rotation[z]',[0,.15,.6,.8],[-.25,-1.4,-1.4,-.25]),new THREE.NumberKeyframeTrack('legL.rotation[z]',[0,.4,.8],[.1,.4,.1]),new THREE.NumberKeyframeTrack('legR.rotation[z]',[0,.4,.8],[-.1,-.4,-.1])]);const actions={walk:mixer.clipAction(walk),idle:mixer.clipAction(idle),jump:mixer.clipAction(jump)};actions.idle.play();root.userData={rig,mixer,actions,current:'idle'};return root;}\nfunction enemyModel(type){const root=new THREE.Group(),rig=new THREE.Group();root.add(rig);const colors={crab:C.teal,armored:C.copper,hopper:C.red,frost:C.ice,boss:C.copper};const color=colors[type]||C.teal;const boss=type==='boss',s=boss?1.9:1;rig.scale.setScalar(s);ball(rig,color,[0,.37,0],[.65,.37,.45]);ball(rig,type==='armored'?0xeeb861:color,[0,.58,-.03],[.61,.28,.43]);box(rig,C.paper,[0,.5,.38],[.7,.12,.08]);for(const x of [-.32,.32]){cylinder(rig,color,[x,.75,.14],[.065,.4,.065]);ball(rig,C.paper,[x,.95,.16],[.17,.2,.14]);ball(rig,C.ink,[x+.04,.96,.29],[.075,.1,.04]);const leg=new THREE.Group();leg.name=x<0?'clawL':'clawR';leg.position.set(x*2,.32,.12);rig.add(leg);ball(leg,color,[x<0?-.17:.17,.12,0],[.28,.2,.22]);const notch=box(leg,C.ink,[x<0?-.32:.32,.2,.21],[.1,.14,.04],false);for(let j=0;j<3;j++){const l=box(rig,C.ink,[x*1.6,.12,-.25+j*.23],[.42,.12,.13]);l.rotation.z=x<0?.35:-.35;}}if(type==='hopper'){for(const x of [-.55,.55]){const wing=ball(rig,C.paper,[x,.67,-.22],[.38,.16,.08]);wing.rotation.z=x;}ring(rig,C.gold,[0,.68,.42],.25,.06);}if(type==='frost'){for(let i=0;i<4;i++){const crystal=mesh(rig,new THREE.ConeGeometry(.16,.42,4),0xcaf4f5,[-.4+i*.27,.86,-.12],[1,1,1]);crystal.rotation.z=(i-1.5)*.18;}}if(type==='armored'){box(rig,C.ink,[0,.81,-.06],[1.05,.12,.51]);box(rig,C.gold,[0,.87,-.03],[.2,.14,.6]);}if(boss){cylinder(rig,0xd09257,[0,.93,-.14],[.48,.62,.38]);cylinder(rig,C.gold,[0,1.26,-.14],[.58,.12,.46]);const valve=ring(rig,C.red,[0,1.43,-.1],.33,.07);box(rig,C.red,[0,1.43,-.1],[.5,.055,.06]);box(rig,C.red,[0,1.43,-.1],[.055,.5,.06]);textPlane(rig,'CLOG',0,.57,.48,.19,'#17313b');}const mixer=new THREE.AnimationMixer(rig),clip=new THREE.AnimationClip('scuttle',.55,[new THREE.NumberKeyframeTrack('clawL.rotation[z]',[0,.275,.55],[-.2,.3,-.2]),new THREE.NumberKeyframeTrack('clawR.rotation[z]',[0,.275,.55],[.2,-.3,.2]),new THREE.NumberKeyframeTrack('.position[y]',[0,.275,.55],[0,.055,0])]);mixer.clipAction(clip).play();root.userData={rig,mixer};return root;}\nconst coinGeo=new THREE.CylinderGeometry(.25,.25,.09,10);const coinMat=mat(C.gold);\nfunction coinModel(){const m=new THREE.Mesh(coinGeo,coinMat);m.rotation.x=Math.PI/2;const ink=new THREE.Mesh(coinGeo,black);ink.scale.setScalar(1.09);m.add(ink);return m;}\nconst shadowMat=new THREE.MeshBasicMaterial({color:0x081e27,transparent:true,opacity:.3,depthWrite:false});\nfunction shadow(){const m=new THREE.Mesh(new THREE.CircleGeometry(.6,16),shadowMat);m.rotation.x=-Math.PI/2;actors.add(m);return m;}\nfunction floorAt(x,y){let best=null;for(const p of platforms)if(x>p.x-p.w/2-.1&&x<p.x+p.w/2+.1&&p.y<y+.12&&(\"'!best||p.y>best.y))best=p;return best;}\nconst particles=[],floaters=[];let shake=0;\nfunction burst(x,y,color,count=12,force=4){for(let i=0;i<count;i++){const m=mesh(effectsGroup,i%3===0?'\"'box':'sphere',color,[x,y,.4+Math.random()*.6],[.06+Math.random()*.09,.06+Math.random()*.09,.07],false);particles.push({m,x,y,vx:(Math.random()-.5)*force,vy:1+Math.random()*force,z:m.position.z,t:.4+Math.random()*.4,max:1});}}\nfunction floatText(text,x,y,color='#ffda70',pop=false){const el=document.createElement('div');el.className='floater'+(pop?' poptext':'');el.textContent=text;el.style.color=color;\"'$('\"'floaters').appendChild(el);floaters.push({el,x,y,t:1.1});}\nfunction updateEffects(dt){for(let i=particles.length-1;i>=0;i--){const p=particles[i];p.t-=dt;p.vy-=dt*10;p.x+=p.vx*dt;p.y+=p.vy*dt;p.m.position.set(p.x,p.y,p.z);p.m.rotation.z+=dt*5;p.m.scale.multiplyScalar(1-dt*.5);if(p.t<=0){effectsGroup.remove(p.m);particles.splice(i,1);}}for(let i=floaters.length-1;i>=0;i--){const f=floaters[i];f.t-=dt;f.y+=dt*.8;const v=new THREE.Vector3(f.x,f.y,1).project(camera);f.el.style.left=(v.x*.5+.5)*innerWidth+'px';f.el.style.top=(-v.y*.5+.5)*innerHeight+'px';f.el.style.opacity=Math.min(1,f.t*3);if(f.t<=0){f.el.remove();floaters.splice(i,1);}}for(const p of platforms)p.mixer.update(dt);bellMixer.update(dt);for(const f of fans)f.rotation.z+=dt*.5;gaugeNeedle.rotation.z=-.8+Math.sin(performance.now()*.0004)*.22;}\nfunction resize(){const a=innerWidth/innerHeight;let h=18.9,w=h*a;if(w<32.4){w=32.4;h=w/a;}camera.left=-w/2;camera.right=w/2;camera.top=h/2;camera.bottom=-h/2;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);}\naddEventListener('resize',resize);resize();\nJS\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"agent_message","text":"The stage and character rigs are in place, with Three.js animation clips for idle, running, jumping, scuttling, and platform bumps. I’m now connecting the Rapier physics to the flip-and-kick rules, enemy types, bonus round, and boss. The music, effects, and gibberish voices are all synthesized in code.\n"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"cat > game.js <<'JS'\nconst DEFAULTS={speed:7.6,jump:16,gravity:32,enemyPace:1,stunTime:7,spawnInterval:2.8,timeScale:1,invincible:false,autoplay:false};\nconst balance={...DEFAULTS};\nconst SHIFTS=[null,{name:'PIPE DREAMS',subtitle:'Bump below. Kick above.',types:['crab','crab','crab','crab','crab','crab'],color:C.teal},{name:'DOUBLE TROUBLE',subtitle:'Hard hats take two bumps. Hoppers have spring\"'!'\"',types:['hopper','armored','crab','hopper','armored','crab','hopper','armored'],color:C.copper},{name:'COLD FEET',subtitle:'Ice is slippery. Watch the travelling sparks\"'!'\"',types:['frost','crab','frost','hopper','armored','frost','hopper','crab','armored','frost'],color:C.ice},{name:'KING CLOG',subtitle:'Three flip-and-kicks will blow his lid\"'!'\"',types:['boss','armored','frost','hopper','crab','armored','hopper'],color:C.red}];\nconst EMPTY_INPUT=()=>({x:0,jump:false,dash:false,bell:false});\nlet uid=1;\nclass Game{\n constructor(){this.world=null;this.players=[];this.enemies=[];this.coins=[];this.ice=[];this.sparks=[];this.phase=1;this.status='idle';this.score=0;this.combo=0;this.comboTime=0;this.bestCombo=0;this.time=0;this.stageTime=0;this.lives=6;this.charges=3;this.attract=false;this.clearTime=0;this.left=[];this.network=false;this.usedDev=false;this.metrics={bumps:0,flips:0,kicks:0,coins:0,hurts:0,bells:0};}\n reset(records=[{id:0,name:'Axle'}],attract=false){if(this.world)this.world.free();for(const a of [...this.players,...this.enemies,...this.coins])this.removeVisual(a);for(const i of this.ice)actors.remove(i.mesh);for(const s of this.sparks)actors.remove(s.mesh);this.players=[];this.enemies=[];this.coins=[];this.ice=[];this.sparks=[];this.world=new RAPIER.World({x:0,y:-balance.gravity});this.world.timestep=1/60;this.platformColliders=platforms.map(p=>this.world.createCollider(RAPIER.ColliderDesc.cuboid(p.w/2,.28).setTranslation(p.x,p.y-.28).setCollisionGroups(0x00010002).setFriction(0)));this.bellCollider=this.world.createCollider(RAPIER.ColliderDesc.cuboid(.78,.54).setTranslation(0,2.65).setCollisionGroups(0x00010002).setFriction(0));bellVisual.position.y=2.65;\n this.score=0;this.time=0;this.stageTime=0;this.phase=1;this.lives=6+Math.max(0,records.length-1)*2;this.charges=3;this.combo=0;this.comboTime=0;this.bestCombo=0;this.clearTime=0;this.attract=attract;this.usedDev=false;this.left=[];this.metrics={bumps:0,flips:0,kicks:0,coins:0,hurts:0,bells:0};for(const [i,r]of records.entries())this.addPlayer(r.id,r.name,(i-(records.length-1)/2)*2.1-3.3);this.status='playing';this.startShift(1,false);}\n body(x,y,half=.3,radius=.33){const b=this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x,y).lockRotations().setCcdEnabled(true).setLinearDamping(0));const c=this.world.createCollider(RAPIER.ColliderDesc.capsule(half,radius).setCollisionGroups(0x00020001).setFriction(0).setRestitution(0),b);return {body:b,collider:c};}\n addPlayer(id,name='Repair crew',x=-4){if(this.players.some(p=>p.id===id))return;const m=heroModel(id);actors.add(m);const p={id,name,...this.body(x,1.12),m,shadow:shadow(),half:.63,x,y:1.12,dir:1,grounded:true,coyote:.12,buffer:0,prevJump:false,prevBell:false,prevDash:false,inv:1.5,dash:0,dashCD:0,bumpCD:0,points:0,botTimer:0,botStep:0};this.players.push(p);return p;}\n removeVisual(e){if(e.m){e.m.userData.mixer?.stopAllAction();actors.remove(e.m);}if(e.shadow)actors.remove(e.shadow);}\n removeActor(e,list){this.removeVisual(e);if(e.body&&this.world.getRigidBody(e.body.handle))this.world.removeRigidBody(e.body);const i=list.indexOf(e);if(i>=0)list.splice(i,1);}\n removePlayer(id){const p=this.players.find(p=>p.id===id);if(p){this.left.push({id,points:p.points});this.removeActor(p,this.players);}}\n startShift(n,announce=true){this.phase=n;this.stageTime=0;this.status='playing';this.charges=3;this.bellCD=0;this.spawnClock=.7;this.queue=[...SHIFTS[n].types];this.total=this.queue.length;for(const e of [...this.enemies])this.removeActor(e,this.enemies);for(const c of [...this.coins])this.removeActor(c,this.coins);for(const i of this.ice)actors.remove(i.mesh);for(const s of this.sparks)actors.remove(s.mesh);this.ice=[];this.sparks=[];this.bonus=false;this.clearTime=0;for(const [i,p]of this.players.entries()){p.body.setTranslation({x:-4+i*2,y:1.12},true);p.body.setLinvel({x:0,y:0},true);p.inv=2;}if(announce){notify('SHIFT '+String(n).padStart(2,'0')+' · '+SHIFTS[n].name,2.6);audio.voice('hello');}updateHUD();}\n spawnEnemy(type='crab',x=null,y=null){const boss=type==='boss';const dir=Math.random()<.5?1:-1;if(x===null)x=boss?0:-dir*11.5;if(y===null)y=boss?8.76:12.05;const e={id:uid++,type,...this.body(x,y,boss?.35:.15,boss?.78:.42),x,y,half:boss?1.13:.57,dir,stun:0,armor:type==='armored'?1:0,hp:boss?3:1,immune:0,speed:type==='hopper'?2.3:type==='boss'?1.8:1.7,hop:1.5+Math.random()*2,iceClock:1.5,m:enemyModel(type),shadow:shadow(),grounded:false};actors.add(e.m);this.enemies.push(e);burst(x,y,C.teal,10,2);return e;}\n coin(x,y,vx=0,bonus=false){const c={id:uid++,x,y,bonus,life:bonus?25:13,m:coinModel()};if(\"'!bonus){Object.assign(c,this.body(x,y,0,.24));c.body.setLinvel({x:vx,y:5.5},true);c.collider.setRestitution(.45);}actors.add(c.m);const mix=new THREE.AnimationMixer(c.m);mix.clipAction(new THREE.AnimationClip('\"'coin-spin',1,[new THREE.NumberKeyframeTrack('.rotation[z]',[0,.5,1],[0,Math.PI,Math.PI*2])])).play();c.m.userData.mixer=mix;this.coins.push(c);return c;}\n bump(platform,x,by){this.metrics.bumps++;platform.action.reset().play();audio.sfx('bump');shake=Math.max(shake,.07);burst(x,platform.y,C.paper,8,2.5);let count=0;for(const e of this.enemies){const f=floorAt(e.x,e.y-e.half+.15);if(f?.index===platform.index&&Math.abs(e.x-x)<(e.type==='boss'?2.8:2.2)&&e.y-e.half-platform.y<1.1){if(this.flip(e,by))count++;}}if(count)floatText(count>1?'DOUBLE FLIP\"'!'\"':'FLIP\"'!'\"',x,platform.y+1.1,'#b5f2c8',true);}\n flip(e,by){if(e.immune>0)return false;if(e.stun>0){e.stun=0;e.dir*=-1;e.immune=.7;floatText('BACK UP\"'!'\"',e.x,e.y+1,'#ffb77f');return false;}if(e.armor>0){e.armor--;e.immune=.35;burst(e.x,e.y,C.gold,18,5);audio.sfx('bump');floatText('CRACK\"'!'\"',e.x,e.y+1,'#ffda70',true);return false;}e.stun=balance.stunTime;e.body.setLinvel({x:0,y:3.7},true);e.by=by?.id??0;this.metrics.flips++;audio.sfx('flip');burst(e.x,e.y,C.gold,9,3);return true;}\n ring(p){if(this.charges<=0||this.bellCD>0)return false;this.charges--;this.bellCD=1.2;this.metrics.bells++;bellAction.reset().play();audio.sfx('bell');shake=.24;for(const e of this.enemies)if(\"'!e.stun)this.flip(e,p);for(let i=0;i<35;i++){const a=i/35*Math.PI*2;burst(Math.cos(a)*3,2.65+Math.sin(a)*1.3,C.gold,1,5);}floatText('\"'RRRING\"'!'\"',0,3.5,'#ffda70',true);updateHUD();return true;}\n kick(e,p){if(e.stun<=0)return false;this.combo=this.comboTime>0?Math.min(this.combo+1,8):1;this.comboTime=4;this.bestCombo=Math.max(this.bestCombo,this.combo);const pts=(e.type==='boss'?750:200)*this.combo;this.score+=pts;p.points+=pts;this.metrics.kicks++;audio.sfx('kick');shake=.12;floatText('+'+pts,e.x,e.y+1);burst(e.x,e.y,e.type==='frost'?C.ice:C.gold,22,7);this.coin(e.x,e.y+.5,-1.3);this.coin(e.x,e.y+.5,1.3);if(e.type==='boss'&&e.hp>1){e.hp--;e.stun=0;e.immune=2.3;e.dir=-e.dir;e.body.setLinvel({x:0,y:5},true);floatText(e.hp+' LIDS LEFT\"'!'\"',e.x,e.y+2,'#ffad7c',true);}else{const dead=enemyModel(e.type);dead.position.set(e.x,e.y,.1);effectsGroup.add(dead);const thrown={m:dead,x:e.x,y:e.y,z:0,vx:p.dir*9,vy:12,t:1.4,max:1.4};particles.push(thrown);this.removeActor(e,this.enemies);}if(this.combo>=2)audio.voice('hello');updateHUD();return true;}\n hurt(p,sourceX){if(p.inv>0||p.dash>0||balance.invincible||this.attract)return;p.inv=2.3;this.lives--;this.metrics.hurts++;this.combo=0;this.comboTime=0;p.body.setLinvel({x:(p.x<sourceX?-1:1)*7,y:8.5},true);burst(p.x,p.y,C.red,20,6);audio.sfx('hurt');shake=.24;floatText('OUCH\"'!'\"',p.x,p.y+1,'#ff9e8b',true);if(this.lives<=0)this.finish(false);updateHUD();}\n bonusRound(){this.phase=2;this.bonus=true;this.status='playing';this.bonusLeft=22;this.stageTime=0;this.queue=[];for(const e of [...this.enemies])this.removeActor(e,this.enemies);for(const c of [...this.coins])this.removeActor(c,this.coins);for(let i=0;i<6;i++)this.coin(-11+i*4.4,1.45,0,true);for(const x of [-11,-7,-3.7,3.7,7,11])this.coin(x,5.05,0,true);for(const x of [-7,-2.3,2.3,7])this.coin(x,8.7,0,true);for(const x of [-11,-6,6,11])this.coin(x,12.25,0,true);this.bonusTotal=this.coins.length;notify('PAYDAY\"'! · Grab every coin!'\"',3);audio.sfx('clear');updateHUD();}\n finish(won){if(this.status==='won'||this.status==='lost')return;this.status=won?'won':'lost';this.won=won;if(won){this.score+=this.lives*250;audio.sfx('clear');audio.voice('win',.6);}else audio.sfx('lose');if(\"'!this.attract){try{if(!AIHub.active&&this.score>Number(localStorage.getItem('\"'flipbros-best')||0))localStorage.setItem('flipbros-best',String(this.score));}catch{}finishOnline(won);if(\"'!AIHub.active)showResult(won);}updateHUD();}\n autopilot(p,dt){p.botTimer-=dt;let target=this.enemies.find(e=>e.stun>0)||this.enemies[0];if(this.bonus){const c=this.coins[0];if(c){if(p.botTimer<=0){p.body.setTranslation({x:c.x-.65,y:c.y},true);p.body.setLinvel({x:0,y:0},true);p.botTimer=.5;}return {x:1,jump:false,dash:false,bell:false};}return EMPTY_INPUT();}if(!target)return {x:Math.sin(this.time)>.5?1:-1,jump:this.time%2<.5,dash:false,bell:false};if(p.botTimer<=0){if(target.stun){p.body.setTranslation({x:target.x-1.5,y:target.y+.12},true);p.body.setLinvel({x:0,y:0},true);p.botTimer=1;}else{const f=floorAt(target.x,target.y-target.half+.2);if(f&&f.index>0){p.body.setTranslation({x:target.x,y:f.y-1.5},true);p.body.setLinvel({x:0,y:balance.jump},true);p.botTimer=.7;}else{if(this.charges<=0)this.charges=3;this.bellCD=0;this.ring(p);p.botTimer=.5;}}}return {x:target.stun?Math.sign(target.x-p.x):0,jump:false,dash:false,bell:false};}\n step(dt,inputs={}){if(!this.world||!['\"'playing','clear'].includes(this.status))return;this.time+=dt;this.stageTime+=dt;this.comboTime=Math.max(0,this.comboTime-dt);if(this.comboTime===0)this.combo=0;this.bellCD=Math.max(0,(this.bellCD||0)-dt);this.world.gravity.y=-balance.gravity;this.world.timestep=dt;\n if(this.status==='clear'){this.clearTime-=dt;if(this.clearTime<=0){if(this.phase===2&&\"'!this.bonus)this.bonusRound();else this.startShift(this.phase+1);}return;}\n if(this.bonus){this.bonusLeft-=dt;if(this.bonusLeft<=0||this.coins.length===0){const perfect=this.coins.length===0;if(perfect){this.score+=1500;this.lives=Math.min(12,this.lives+1);notify('\"'PERFECT PAYDAY\"'! +1500 · +1 LIFE'\"',3);}this.startShift(3,false);audio.sfx('clear');return;}}\n else{this.spawnClock-=dt;if(this.queue.length&&this.spawnClock<=0){this.spawnEnemy(this.queue.shift());this.spawnClock=balance.spawnInterval;}if(this.phase>=3&&this.stageTime>12&&this.sparks.length===0)this.makeSparks();}\n for(const p of this.players){const pos=p.body.translation(),vel=p.body.linvel();p.x=pos.x;p.y=pos.y;p.inv=Math.max(0,p.inv-dt);p.dashCD=Math.max(0,p.dashCD-dt);p.dash=Math.max(0,p.dash-dt);p.bumpCD=Math.max(0,p.bumpCD-dt);const f=floorAt(p.x,p.y-p.half+.12);p.grounded=\"'!!f&&Math.abs(p.y-p.half-f.y)<.14&&vel.y<1.2;p.coyote=p.grounded?.12:Math.max(0,p.coyote-dt);\n const inp=(this.attract||balance.autoplay)?this.autopilot(p,dt):(inputs[p.id]||EMPTY_INPUT());const axis=clamp(Number(inp.x)||0,-1,1);if(Math.abs(axis)>.1)p.dir=Math.sign(axis);if(inp.jump&&!p.prevJump)p.buffer=.14;else p.buffer=Math.max(0,p.buffer-dt);if(inp.bell&&!p.prevBell)this.ring(p);if(inp.dash&&!p.prevDash&&p.dashCD<=0){p.dash=.2;p.dashCD=.95;audio.sfx('\"'dash');burst(p.x,p.y,C.paper,5,3);}p.prevJump=\"'!!inp.jump;p.prevBell=!!inp.bell;p.prevDash=!!inp.dash;\n let vy=vel.y;if(p.buffer>0&&p.coyote>0){vy=balance.jump;p.buffer=0;p.coyote=0;p.grounded=false;audio.sfx('\"'jump');}if(\"'!inp.jump&&p.prevHeldJump&&vy>6&&!this.attract&&!balance.autoplay)vy*=.65;p.prevHeldJump=!!inp.jump;\n const icy=this.ice.some(i=>Math.abs(i.x-p.x)<1.25&&Math.abs(i.y-(p.y-p.half))<.3);const accel=icy?2.5:p.grounded?26:13;let vx=p.dash>0?p.dir*balance.speed*2.25:lerp(vel.x,axis*balance.speed,Math.min(1,dt*accel));if(p.inv>1.8&&Math.abs(vel.x)>balance.speed)vx=vel.x*.98;\n p.preY=p.body.translation().y;p.preVy=vy;p.body.setLinvel({x:vx,y:vy},true);\n }\n for(const e of this.enemies){e.x=e.body.translation().x;e.y=e.body.translation().y;e.immune=Math.max(0,e.immune-dt);const v=e.body.linvel();const f=floorAt(e.x,e.y-e.half+.15);e.grounded=!!f&&Math.abs(e.y-e.half-f.y)<.18&&Math.abs(v.y)<1.2;e.stun=Math.max(0,e.stun-dt);let vy=v.y;e.hop-=dt;e.iceClock-=dt;if(e.type==='\"'hopper'&&e.grounded&&e.hop<=0&&\"'!e.stun){vy=6.4;e.hop=1.8;}if(e.type==='\"'boss'&&Math.abs(e.x)>8.4)e.dir=-Math.sign(e.x);if(e.type==='frost'&&e.grounded&&\"'!e.stun&&e.iceClock<=0){this.addIce(e.x,f.y);e.iceClock=1.6;}e.body.setLinvel({x:e.stun?0:e.dir*e.speed*balance.enemyPace*(e.type==='\"'boss'?1+(3-e.hp)*.22:1),y:vy},true);}\n this.world.step();\n for(const p of this.players){const pos=p.body.translation(),v=p.body.linvel();p.x=pos.x;p.y=pos.y;if(Math.abs(p.x)>15.2){p.x=-Math.sign(p.x)*14.8;p.body.setTranslation({x:p.x,y:p.y},true);burst(p.x,p.y,C.teal,6,2);}if(p.y<-.5){p.body.setTranslation({x:-4,y:1.15},true);p.body.setLinvel({x:0,y:0},true);this.hurt(p,0);}if(p.preVy>1&&v.y<1&&p.bumpCD<=0){const head=p.y+p.half;if(Math.abs(head-2.11)<.22&&Math.abs(p.x)<1.1){this.ring(p);p.bumpCD=.28;}else{for(const f of platforms){const underside=f.y-.56;if(f.index>0&&p.x>f.x-f.w/2-.25&&p.x<f.x+f.w/2+.25&&Math.abs(head-underside)<.25){this.bump(f,p.x,p);p.bumpCD=.28;break;}}}}\n for(const e of [...this.enemies]){if(Math.abs(e.x-p.x)<(e.type==='boss'?1.37:.94)&&Math.abs(e.y-p.y)<(e.type==='boss'?1.35:.9)){if(e.stun>0)this.kick(e,p);else if(e.immune<1.5)this.hurt(p,e.x);}}\n for(const c of [...this.coins])if(Math.hypot(c.x-p.x,c.y-p.y)<1.05){const pts=c.bonus?100:50;this.score+=pts;p.points+=pts;this.metrics.coins++;audio.sfx('coin');burst(c.x,c.y,C.gold,6,2);this.removeActor(c,this.coins);}\n for(const s of this.sparks)if(Math.hypot(s.x-p.x,s.y-p.y)<.95)this.hurt(p,s.x);\n }\n for(const e of this.enemies){e.x=e.body.translation().x;e.y=e.body.translation().y;if(e.y<1.2&&Math.abs(e.x)>13.1){const x=Math.sign(e.x)*11.6;e.body.setTranslation({x,y:12.2},true);e.body.setLinvel({x:-Math.sign(x)*e.speed,y:0},true);e.dir=-Math.sign(x);e.speed=Math.min(3.4,e.speed*1.08);burst(x,12,C.teal,8,3);}else if(Math.abs(e.x)>15.1){e.body.setTranslation({x:-Math.sign(e.x)*14.8,y:e.y},true);}if(e.y<-.5){e.body.setTranslation({x:11,y:12.3},true);}}\n for(const c of [...this.coins]){c.life-=dt;if(c.body){c.x=c.body.translation().x;c.y=c.body.translation().y;}if(c.life<=0||c.y<-2)this.removeActor(c,this.coins);}\n for(let i=this.ice.length-1;i>=0;i--){this.ice[i].life-=dt;this.ice[i].mesh.scale.x=Math.min(1,this.ice[i].life);if(this.ice[i].life<=0){actors.remove(this.ice[i].mesh);this.ice.splice(i,1);}}\n for(const [i,s]of this.sparks.entries()){s.x=Math.sin(this.stageTime*.45+i*Math.PI)*13.5;s.y=2.05+i*3.6+Math.sin(this.stageTime*2)*.12;s.mesh.position.set(s.x,s.y,.4);s.mesh.rotation.z+=dt*4;}\n if(\"'!this.bonus&&this.queue.length===0&&this.enemies.length===0&&this.status==='\"'playing'){if(this.phase===4)this.finish(true);else{this.status='clear';this.clearTime=3;this.score+=500;notify('SHIFT CLEAR\"'! · +500'\"',2.6);audio.sfx('clear');}}updateHUD();\n }\n addIce(x,y){const m=box(actors,0xb0f1ef,[x,y+.03,.15],[2.3,.09,1.6]);this.ice.push({x,y,life:7.5,mesh:m});}\n makeSparks(){for(let i=0;i<(this.phase===4?2:1);i++){const m=new THREE.Group();ball(m,C.gold,[0,0,0],[.38,.38,.3]);for(let j=0;j<8;j++){const a=j*Math.PI/4,ray=box(m,C.copper,[Math.cos(a)*.5,Math.sin(a)*.5,0],[.38,.1,.1]);ray.rotation.z=a;}actors.add(m);this.sparks.push({x:0,y:2.05+i*3.6,mesh:m});}notify('HOT STUFF\"'! Watch the sparks.'\"',2.5);}\n draw(dt){for(const p of this.players){const pos=p.body.translation(),v=p.body.linvel(),ud=p.m.userData;const target=new THREE.Vector3(pos.x,pos.y-p.half,.25+p.id*.04);p.m.position.lerp(target,Math.min(1,dt*25));p.m.rotation.y=lerp(p.m.rotation.y,p.dir*.4,Math.min(1,dt*12));p.m.rotation.z=lerp(p.m.rotation.z,p.dash>0?-p.dir*.2:0,Math.min(1,dt*14));p.m.visible=p.inv<=0||Math.sin(this.time*35)>.0;let anim=Math.abs(v.y)>1.5?'jump':Math.abs(v.x)>.7?'walk':'idle';if(anim\"'!==ud.current){ud.actions[ud.current].fadeOut(.1);ud.actions[anim].reset().fadeIn(.1).play();ud.current=anim;}ud.mixer.timeScale=anim==='\"'walk'?Math.max(.6,Math.abs(v.x)/5):1;ud.mixer.update(dt);const f=floorAt(pos.x,pos.y-p.half+.1);p.shadow.visible=\"'!!f;p.shadow.position.set(pos.x,(f?.y||.45)+.035,.1);p.shadow.scale.setScalar(Math.max(.4,1-(pos.y-p.half-(f?.y||.45))*.1));}\n for(const e of this.enemies){const pos=e.body.translation();e.m.position.lerp(new THREE.Vector3(pos.x,pos.y-e.half+(e.stun?e.half*1.8:0),.1),Math.min(1,dt*20));e.m.rotation.z=lerp(e.m.rotation.z,e.stun?Math.PI:0,Math.min(1,dt*16));e.m.rotation.y=lerp(e.m.rotation.y,e.dir*.2,dt*6);e.m.userData.mixer.timeScale=e.stun?.12:balance.enemyPace;e.m.userData.mixer.update(dt);if(e.stun>0&&e.stun<2)e.m.visible=Math.sin(this.time*20)>.0;else e.m.visible=true;const f=floorAt(pos.x,pos.y-e.half+.15);e.shadow.visible=!!f;e.shadow.position.set(pos.x,(f?.y||.45)+.02,.1);e.shadow.scale.setScalar(e.type==='\"'boss'?1.8:1);}\n for(const c of this.coins){c.m.position.set(c.x,c.y+(c.bonus?Math.sin(this.time*3+c.x)*.12:0),.55);c.m.userData.mixer?.update(dt);}bellVisual.children[1].material=mat(this.charges>0?C.gold:0x67746a);}\n snapshot(){return {t:'world',phase:this.phase,status:this.status,won:\"'!!this.won,score:this.score,lives:this.lives,charges:this.charges,combo:this.combo,bestCombo:this.bestCombo,time:this.time,stageTime:this.stageTime,bonus:!!this.bonus,bonusLeft:this.bonusLeft||0,remaining:this.queue?.length||0,metrics:this.metrics,players:this.players.map(p=>{const a=p.body.translation(),v=p.body.linvel();return {id:p.id,name:p.name,x:a.x,y:a.y,vx:v.x,vy:v.y,dir:p.dir,inv:p.inv,dash:p.dash,points:p.points};}),enemies:this.enemies.map(e=>{const a=e.body.translation();return {id:e.id,type:e.type,x:a.x,y:a.y,dir:e.dir,stun:e.stun,armor:e.armor,hp:e.hp};}),coins:this.coins.map(c=>({id:c.id,x:c.x,y:c.y,bonus:c.bonus})),ice:this.ice.map(i=>({x:i.x,y:i.y,life:i.life})),sparks:this.sparks.map(s=>({x:s.x,y:s.y}))};}\n receive(s){if(!this.world)this.reset(s.players);this.phase=s.phase;this.status=s.status;this.won=s.won;this.score=s.score;this.lives=s.lives;this.charges=s.charges;this.combo=s.combo;this.bestCombo=s.bestCombo;this.time=s.time;this.stageTime=s.stageTime;this.bonus=s.bonus;this.bonusLeft=s.bonusLeft;this.queue=Array(s.remaining).fill('\"'crab');this.metrics=s.metrics;\n for(const p of [...this.players])if(\"'!s.players.some(x=>x.id===p.id))this.removeActor(p,this.players);for(const a of s.players){let p=this.players.find(p=>p.id===a.id)||this.addPlayer(a.id,a.name,a.x);Object.assign(p,a);p.body.setTranslation({x:a.x,y:a.y},true);p.body.setLinvel({x:a.vx,y:a.vy},true);}\n for(const e of [...this.enemies])if(!s.enemies.some(x=>x.id===e.id))this.removeActor(e,this.enemies);for(const a of s.enemies){let e=this.enemies.find(e=>e.id===a.id);if(!e){e=this.spawnEnemy(a.type,a.x,a.y);e.id=a.id;}Object.assign(e,a);e.body.setTranslation({x:a.x,y:a.y},true);}\n for(const c of [...this.coins])if(!s.coins.some(x=>x.id===c.id))this.removeActor(c,this.coins);for(const a of s.coins){let c=this.coins.find(c=>c.id===a.id);if(!c){c=this.coin(a.x,a.y,0,true);c.id=a.id;}Object.assign(c,a);}\n for(const i of this.ice)actors.remove(i.mesh);this.ice=[];for(const i of s.ice){this.addIce(i.x,i.y);this.ice.at(-1).life=i.life;}\n while(this.sparks.length>s.sparks.length)actors.remove(this.sparks.pop().mesh);if(this.sparks.length<s.sparks.length){this.makeSparks();while(this.sparks.length>s.sparks.length)actors.remove(this.sparks.pop().mesh);}s.sparks.forEach((a,i)=>{Object.assign(this.sparks[i],a);this.sparks[i].mesh.position.set(a.x,a.y,.4);});updateHUD();}\n}\nconst game=new Game();\nJS'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"cat > game.js <<'JS'\nconst DEFAULTS={speed:7.6,jump:16,gravity:32,enemyPace:1,stunTime:7,spawnInterval:2.8,timeScale:1,invincible:false,autoplay:false};\nconst balance={...DEFAULTS};\nconst SHIFTS=[null,{name:'PIPE DREAMS',subtitle:'Bump below. Kick above.',types:['crab','crab','crab','crab','crab','crab'],color:C.teal},{name:'DOUBLE TROUBLE',subtitle:'Hard hats take two bumps. Hoppers have spring\"'!'\"',types:['hopper','armored','crab','hopper','armored','crab','hopper','armored'],color:C.copper},{name:'COLD FEET',subtitle:'Ice is slippery. Watch the travelling sparks\"'!'\"',types:['frost','crab','frost','hopper','armored','frost','hopper','crab','armored','frost'],color:C.ice},{name:'KING CLOG',subtitle:'Three flip-and-kicks will blow his lid\"'!'\"',types:['boss','armored','frost','hopper','crab','armored','hopper'],color:C.red}];\nconst EMPTY_INPUT=()=>({x:0,jump:false,dash:false,bell:false});\nlet uid=1;\nclass Game{\n constructor(){this.world=null;this.players=[];this.enemies=[];this.coins=[];this.ice=[];this.sparks=[];this.phase=1;this.status='idle';this.score=0;this.combo=0;this.comboTime=0;this.bestCombo=0;this.time=0;this.stageTime=0;this.lives=6;this.charges=3;this.attract=false;this.clearTime=0;this.left=[];this.network=false;this.usedDev=false;this.metrics={bumps:0,flips:0,kicks:0,coins:0,hurts:0,bells:0};}\n reset(records=[{id:0,name:'Axle'}],attract=false){if(this.world)this.world.free();for(const a of [...this.players,...this.enemies,...this.coins])this.removeVisual(a);for(const i of this.ice)actors.remove(i.mesh);for(const s of this.sparks)actors.remove(s.mesh);this.players=[];this.enemies=[];this.coins=[];this.ice=[];this.sparks=[];this.world=new RAPIER.World({x:0,y:-balance.gravity});this.world.timestep=1/60;this.platformColliders=platforms.map(p=>this.world.createCollider(RAPIER.ColliderDesc.cuboid(p.w/2,.28).setTranslation(p.x,p.y-.28).setCollisionGroups(0x00010002).setFriction(0)));this.bellCollider=this.world.createCollider(RAPIER.ColliderDesc.cuboid(.78,.54).setTranslation(0,2.65).setCollisionGroups(0x00010002).setFriction(0));bellVisual.position.y=2.65;\n this.score=0;this.time=0;this.stageTime=0;this.phase=1;this.lives=6+Math.max(0,records.length-1)*2;this.charges=3;this.combo=0;this.comboTime=0;this.bestCombo=0;this.clearTime=0;this.attract=attract;this.usedDev=false;this.left=[];this.metrics={bumps:0,flips:0,kicks:0,coins:0,hurts:0,bells:0};for(const [i,r]of records.entries())this.addPlayer(r.id,r.name,(i-(records.length-1)/2)*2.1-3.3);this.status='playing';this.startShift(1,false);}\n body(x,y,half=.3,radius=.33){const b=this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x,y).lockRotations().setCcdEnabled(true).setLinearDamping(0));const c=this.world.createCollider(RAPIER.ColliderDesc.capsule(half,radius).setCollisionGroups(0x00020001).setFriction(0).setRestitution(0),b);return {body:b,collider:c};}\n addPlayer(id,name='Repair crew',x=-4){if(this.players.some(p=>p.id===id))return;const m=heroModel(id);actors.add(m);const p={id,name,...this.body(x,1.12),m,shadow:shadow(),half:.63,x,y:1.12,dir:1,grounded:true,coyote:.12,buffer:0,prevJump:false,prevBell:false,prevDash:false,inv:1.5,dash:0,dashCD:0,bumpCD:0,points:0,botTimer:0,botStep:0};this.players.push(p);return p;}\n removeVisual(e){if(e.m){e.m.userData.mixer?.stopAllAction();actors.remove(e.m);}if(e.shadow)actors.remove(e.shadow);}\n removeActor(e,list){this.removeVisual(e);if(e.body&&this.world.getRigidBody(e.body.handle))this.world.removeRigidBody(e.body);const i=list.indexOf(e);if(i>=0)list.splice(i,1);}\n removePlayer(id){const p=this.players.find(p=>p.id===id);if(p){this.left.push({id,points:p.points});this.removeActor(p,this.players);}}\n startShift(n,announce=true){this.phase=n;this.stageTime=0;this.status='playing';this.charges=3;this.bellCD=0;this.spawnClock=.7;this.queue=[...SHIFTS[n].types];this.total=this.queue.length;for(const e of [...this.enemies])this.removeActor(e,this.enemies);for(const c of [...this.coins])this.removeActor(c,this.coins);for(const i of this.ice)actors.remove(i.mesh);for(const s of this.sparks)actors.remove(s.mesh);this.ice=[];this.sparks=[];this.bonus=false;this.clearTime=0;for(const [i,p]of this.players.entries()){p.body.setTranslation({x:-4+i*2,y:1.12},true);p.body.setLinvel({x:0,y:0},true);p.inv=2;}if(announce){notify('SHIFT '+String(n).padStart(2,'0')+' · '+SHIFTS[n].name,2.6);audio.voice('hello');}updateHUD();}\n spawnEnemy(type='crab',x=null,y=null){const boss=type==='boss';const dir=Math.random()<.5?1:-1;if(x===null)x=boss?0:-dir*11.5;if(y===null)y=boss?8.76:12.05;const e={id:uid++,type,...this.body(x,y,boss?.35:.15,boss?.78:.42),x,y,half:boss?1.13:.57,dir,stun:0,armor:type==='armored'?1:0,hp:boss?3:1,immune:0,speed:type==='hopper'?2.3:type==='boss'?1.8:1.7,hop:1.5+Math.random()*2,iceClock:1.5,m:enemyModel(type),shadow:shadow(),grounded:false};actors.add(e.m);this.enemies.push(e);burst(x,y,C.teal,10,2);return e;}\n coin(x,y,vx=0,bonus=false){const c={id:uid++,x,y,bonus,life:bonus?25:13,m:coinModel()};if(\"'!bonus){Object.assign(c,this.body(x,y,0,.24));c.body.setLinvel({x:vx,y:5.5},true);c.collider.setRestitution(.45);}actors.add(c.m);const mix=new THREE.AnimationMixer(c.m);mix.clipAction(new THREE.AnimationClip('\"'coin-spin',1,[new THREE.NumberKeyframeTrack('.rotation[z]',[0,.5,1],[0,Math.PI,Math.PI*2])])).play();c.m.userData.mixer=mix;this.coins.push(c);return c;}\n bump(platform,x,by){this.metrics.bumps++;platform.action.reset().play();audio.sfx('bump');shake=Math.max(shake,.07);burst(x,platform.y,C.paper,8,2.5);let count=0;for(const e of this.enemies){const f=floorAt(e.x,e.y-e.half+.15);if(f?.index===platform.index&&Math.abs(e.x-x)<(e.type==='boss'?2.8:2.2)&&e.y-e.half-platform.y<1.1){if(this.flip(e,by))count++;}}if(count)floatText(count>1?'DOUBLE FLIP\"'!'\"':'FLIP\"'!'\"',x,platform.y+1.1,'#b5f2c8',true);}\n flip(e,by){if(e.immune>0)return false;if(e.stun>0){e.stun=0;e.dir*=-1;e.immune=.7;floatText('BACK UP\"'!'\"',e.x,e.y+1,'#ffb77f');return false;}if(e.armor>0){e.armor--;e.immune=.35;burst(e.x,e.y,C.gold,18,5);audio.sfx('bump');floatText('CRACK\"'!'\"',e.x,e.y+1,'#ffda70',true);return false;}e.stun=balance.stunTime;e.body.setLinvel({x:0,y:3.7},true);e.by=by?.id??0;this.metrics.flips++;audio.sfx('flip');burst(e.x,e.y,C.gold,9,3);return true;}\n ring(p){if(this.charges<=0||this.bellCD>0)return false;this.charges--;this.bellCD=1.2;this.metrics.bells++;bellAction.reset().play();audio.sfx('bell');shake=.24;for(const e of this.enemies)if(\"'!e.stun)this.flip(e,p);for(let i=0;i<35;i++){const a=i/35*Math.PI*2;burst(Math.cos(a)*3,2.65+Math.sin(a)*1.3,C.gold,1,5);}floatText('\"'RRRING\"'!'\"',0,3.5,'#ffda70',true);updateHUD();return true;}\n kick(e,p){if(e.stun<=0)return false;this.combo=this.comboTime>0?Math.min(this.combo+1,8):1;this.comboTime=4;this.bestCombo=Math.max(this.bestCombo,this.combo);const pts=(e.type==='boss'?750:200)*this.combo;this.score+=pts;p.points+=pts;this.metrics.kicks++;audio.sfx('kick');shake=.12;floatText('+'+pts,e.x,e.y+1);burst(e.x,e.y,e.type==='frost'?C.ice:C.gold,22,7);this.coin(e.x,e.y+.5,-1.3);this.coin(e.x,e.y+.5,1.3);if(e.type==='boss'&&e.hp>1){e.hp--;e.stun=0;e.immune=2.3;e.dir=-e.dir;e.body.setLinvel({x:0,y:5},true);floatText(e.hp+' LIDS LEFT\"'!'\"',e.x,e.y+2,'#ffad7c',true);}else{const dead=enemyModel(e.type);dead.position.set(e.x,e.y,.1);effectsGroup.add(dead);const thrown={m:dead,x:e.x,y:e.y,z:0,vx:p.dir*9,vy:12,t:1.4,max:1.4};particles.push(thrown);this.removeActor(e,this.enemies);}if(this.combo>=2)audio.voice('hello');updateHUD();return true;}\n hurt(p,sourceX){if(p.inv>0||p.dash>0||balance.invincible||this.attract)return;p.inv=2.3;this.lives--;this.metrics.hurts++;this.combo=0;this.comboTime=0;p.body.setLinvel({x:(p.x<sourceX?-1:1)*7,y:8.5},true);burst(p.x,p.y,C.red,20,6);audio.sfx('hurt');shake=.24;floatText('OUCH\"'!'\"',p.x,p.y+1,'#ff9e8b',true);if(this.lives<=0)this.finish(false);updateHUD();}\n bonusRound(){this.phase=2;this.bonus=true;this.status='playing';this.bonusLeft=22;this.stageTime=0;this.queue=[];for(const e of [...this.enemies])this.removeActor(e,this.enemies);for(const c of [...this.coins])this.removeActor(c,this.coins);for(let i=0;i<6;i++)this.coin(-11+i*4.4,1.45,0,true);for(const x of [-11,-7,-3.7,3.7,7,11])this.coin(x,5.05,0,true);for(const x of [-7,-2.3,2.3,7])this.coin(x,8.7,0,true);for(const x of [-11,-6,6,11])this.coin(x,12.25,0,true);this.bonusTotal=this.coins.length;notify('PAYDAY\"'! · Grab every coin!'\"',3);audio.sfx('clear');updateHUD();}\n finish(won){if(this.status==='won'||this.status==='lost')return;this.status=won?'won':'lost';this.won=won;if(won){this.score+=this.lives*250;audio.sfx('clear');audio.voice('win',.6);}else audio.sfx('lose');if(\"'!this.attract){try{if(!AIHub.active&&this.score>Number(localStorage.getItem('\"'flipbros-best')||0))localStorage.setItem('flipbros-best',String(this.score));}catch{}finishOnline(won);if(\"'!AIHub.active)showResult(won);}updateHUD();}\n autopilot(p,dt){p.botTimer-=dt;let target=this.enemies.find(e=>e.stun>0)||this.enemies[0];if(this.bonus){const c=this.coins[0];if(c){if(p.botTimer<=0){p.body.setTranslation({x:c.x-.65,y:c.y},true);p.body.setLinvel({x:0,y:0},true);p.botTimer=.5;}return {x:1,jump:false,dash:false,bell:false};}return EMPTY_INPUT();}if(!target)return {x:Math.sin(this.time)>.5?1:-1,jump:this.time%2<.5,dash:false,bell:false};if(p.botTimer<=0){if(target.stun){p.body.setTranslation({x:target.x-1.5,y:target.y+.12},true);p.body.setLinvel({x:0,y:0},true);p.botTimer=1;}else{const f=floorAt(target.x,target.y-target.half+.2);if(f&&f.index>0){p.body.setTranslation({x:target.x,y:f.y-1.5},true);p.body.setLinvel({x:0,y:balance.jump},true);p.botTimer=.7;}else{if(this.charges<=0)this.charges=3;this.bellCD=0;this.ring(p);p.botTimer=.5;}}}return {x:target.stun?Math.sign(target.x-p.x):0,jump:false,dash:false,bell:false};}\n step(dt,inputs={}){if(!this.world||!['\"'playing','clear'].includes(this.status))return;this.time+=dt;this.stageTime+=dt;this.comboTime=Math.max(0,this.comboTime-dt);if(this.comboTime===0)this.combo=0;this.bellCD=Math.max(0,(this.bellCD||0)-dt);this.world.gravity.y=-balance.gravity;this.world.timestep=dt;\n if(this.status==='clear'){this.clearTime-=dt;if(this.clearTime<=0){if(this.phase===2&&\"'!this.bonus)this.bonusRound();else this.startShift(this.phase+1);}return;}\n if(this.bonus){this.bonusLeft-=dt;if(this.bonusLeft<=0||this.coins.length===0){const perfect=this.coins.length===0;if(perfect){this.score+=1500;this.lives=Math.min(12,this.lives+1);notify('\"'PERFECT PAYDAY\"'! +1500 · +1 LIFE'\"',3);}this.startShift(3,false);audio.sfx('clear');return;}}\n else{this.spawnClock-=dt;if(this.queue.length&&this.spawnClock<=0){this.spawnEnemy(this.queue.shift());this.spawnClock=balance.spawnInterval;}if(this.phase>=3&&this.stageTime>12&&this.sparks.length===0)this.makeSparks();}\n for(const p of this.players){const pos=p.body.translation(),vel=p.body.linvel();p.x=pos.x;p.y=pos.y;p.inv=Math.max(0,p.inv-dt);p.dashCD=Math.max(0,p.dashCD-dt);p.dash=Math.max(0,p.dash-dt);p.bumpCD=Math.max(0,p.bumpCD-dt);const f=floorAt(p.x,p.y-p.half+.12);p.grounded=\"'!!f&&Math.abs(p.y-p.half-f.y)<.14&&vel.y<1.2;p.coyote=p.grounded?.12:Math.max(0,p.coyote-dt);\n const inp=(this.attract||balance.autoplay)?this.autopilot(p,dt):(inputs[p.id]||EMPTY_INPUT());const axis=clamp(Number(inp.x)||0,-1,1);if(Math.abs(axis)>.1)p.dir=Math.sign(axis);if(inp.jump&&!p.prevJump)p.buffer=.14;else p.buffer=Math.max(0,p.buffer-dt);if(inp.bell&&!p.prevBell)this.ring(p);if(inp.dash&&!p.prevDash&&p.dashCD<=0){p.dash=.2;p.dashCD=.95;audio.sfx('\"'dash');burst(p.x,p.y,C.paper,5,3);}p.prevJump=\"'!!inp.jump;p.prevBell=!!inp.bell;p.prevDash=!!inp.dash;\n let vy=vel.y;if(p.buffer>0&&p.coyote>0){vy=balance.jump;p.buffer=0;p.coyote=0;p.grounded=false;audio.sfx('\"'jump');}if(\"'!inp.jump&&p.prevHeldJump&&vy>6&&!this.attract&&!balance.autoplay)vy*=.65;p.prev