{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GnV57MnQH63bQWHUEnkBCz","type":"tool_result","content":"/**\n * bridge.js — the hub's end of one game frame in a session.\n *\n * A game speaks the AI Hub Session Protocol over postMessage (lib/hub/README.md).\n * The bridge checks every message, enforces the limits, and routes it: control\n * messages (hello, ready, result, finish, error) to whoever coordinates the\n * round (lib/hub/round.js), game traffic straight to the other players, and a\n * game's answers on its own card to the page that holds it. What\n * comes back from the network is checked again before it reaches the game,\n * and anything from another round is dropped, so a slow packet can never land\n * in the next game.\n *\n * The network is anything with `send(toKey, envelope, {reliable})`: the\n * simulated one below (harness, tests), a BroadcastChannel between tabs, or a\n * WebRTC mesh. Envelopes:\n *   {k:'c', r, m}       to the coordinator: a message from this game\n *   {k:'h', r, m}       from the coordinator: welcome, start, leave, time-up, end\n *   {k:'g', r, f, d}    game traffic from player id f\n *   {k:'p', r, f, d}    player id f's progress, {score, label}, for the scoreboard\n */\n\nexport const LIMITS = Object.freeze({\n  maxBytes: 16_384,\n  ratePerS: 20,\n  burst: 40,\n  queueMessages: 64,\n  queueBytes: 262_144,\n  /**\n   * progress() reaches the hub about once a second. Two closer than this are a\n   * report delivered late (a long task in the game) or a client misbehaving:\n   * the later is dropped, and the next report, a second on, has the newest score.\n   */\n  progressMs: 250,\n  label: 24,\n});\n\nconst FROM_GAME = new Set(['hello', 'ready', 'send', 'result', 'finish', 'error', 'progress', 'fullscreen', 'answer']);\n\n/** A progress report, checked: a finite score and an optional short label. Null when it is not one. */\nexport function cleanProgress(p) {\n  if (!p || typeof p !== 'object') return null;\n  // A number, or text that is one: never null, '', true or [], which Number() would make 0 or 1.\n  const score = typeof p.score === 'number' || (typeof p.score === 'string' && p.score.trim() !== '') ? Number(p.score) : NaN;\n  if (!Number.isFinite(score)) return null;\n  const label = typeof p.label === 'string' ? p.label.trim().slice(0, LIMITS.label) : '';\n  return label ? { score, label } : { score };\n}\n\n/**\n * @param {object} o\n * @param {string} o.key              this player's key in the session\n * @param {number} o.round\n * @param {string} o.coordinator      key of whoever runs round.js\n * @param {(msg:object) => void} o.post            to the game frame\n * @param {{send:Function}} o.net\n * @param {{now:()=>number}} [o.clock]             the coordinator's time, as seen here\n * @param {(issue:{key:string, problem:string}) => void} [o.onIssue]\n * @param {(id:number, progress:{score:number, label?:string}) => void} [o.onProgress]   a player's\n *        progress, this one's included, for the hub's scoreboard; it never reaches the games\n * @param {(on:boolean) => void} [o.onFullscreen]   the game asked for fullscreen (or out of it): the\n *        hub's page takes it, so the hub's own cards stay over the game\n * @param {(what:'ready'|'more') => void} [o.onAnswer]   this player answered on the game's own card\n */\nexport function createBridge({ key, round, coordinator, post, net, clock = Date, onIssue = () => {}, onProgress = () => {}, onFullscreen = () => {}, onAnswer = () => {} }) {\n  let welcomed = false;\n  let ended = false;\n  let started = false;\n  let helloSent = false;\n  let ownsCard = false;\n  let readySent = false;\n  let me = null;\n  let keys = [];\n  const gone = new Set();\n  const queue = [];\n  let queuedBytes = 0;\n  let tokens = LIMITS.burst;\n  let refilled = clock.now();\n  let progressAt = -Infinity;\n  const issues = [];\n  const stats = { sent: 0, received: 0, bytesSent: 0, dropped: 0 };\n...\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/bridge.js:22:export const LIMITS = Object.freeze({\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/bridge.js:40:export function cleanProgress(p) {\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/bridge.js:64:export function createBridge({ key, round, coordinator, post, net, clock = Date, onIssue = () => {}, onProgress = () => {}, onFullscreen = () => {}, onAnswer = () => {} }) {\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/bridge.js:265:export function attachFrame(frame, onMessage) {\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/bridge.js:276:export const postTo = (frame) => (msg) => frame.contentWindow?.postMessage(msg, '*');\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/bridge.js:283:export function createLocalNetwork({ latency = 0, jitter = 0, loss = 0, random = Math.random, clock = globalThis } = {}) {\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:15:export const TIMINGS = Object.freeze({\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:27:export const SLOT_COLORS = Object.freeze(['#e8443a', '#3b82f6', '#22c55e', '#f5b700']);\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:29:export const MODES = Object.freeze(['parallel', 'ghost', 'shared-world']);\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:32:export const MODE_NAMES = Object.freeze({ parallel: 'Parallel', ghost: 'Ghost', 'shared-world': 'Shared world' });\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:38:export function modeOf(word) {\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:44:export const SELF_REPORTED = Object.freeze(['parallel', 'ghost']);\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:52:export const seedsRandom = (tag) => ['parallel', 'ghost'].includes(String(tag ?? '').trim().toLowerCase());\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:61:export function limitFor(minutes, { maxRoundMs = TIMINGS.maxRoundMs } = {}) {\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:72:export function rankResults(results, ids) {\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:99:export const HIGHLIGHTS = Object.freeze({ stats: 6, statName: 16, statText: 16, awards: 3, title: 24, detail: 40 });\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:102:export function cleanStats(stats) {\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:118:export function cleanAwards(awards, ids, self = null) {\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:138:export function checkStandings(standings, presentIds, allIds) {\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:179:export function createRound({\n/**\n * round.js — one round of an AI Hub session, run by the hub that coordinates\n * it (the harness page, or the session host's tab).\n *\n * It never touches the network or a frame itself: every message for a game\n * goes out through `deliver(key, msg)`, and everything the games report comes\n * in through `receive(key, msg)` and `leave(key, reason)`. The clock is\n * injected, so `scripts/hub.test.mjs` can walk a round through every timeout\n * without waiting for one.\n *\n * Players are known by `key` (whatever the session calls them); games see\n * contiguous ids 0..N-1 in slot order.\n */\n\nexport const TIMINGS = Object.freeze({\n  helloMs: 10_000,\n  readyMs: 45_000,\n  /** Gated rounds: a game still loading when the hub releases the round gets this long more. */\n  loadGraceMs: 20_000,\n  countdownMs: 3_000,\n  graceMs: 5_000,\n  hiddenMs: 20_000,\n  maxRoundMs: 15 * 60_000,\n});\n\n/** P1 red, P2 blue, P3 green, P4 yellow: the colour follows the seat. */\nexport const SLOT_COLORS = Object.freeze(['#e8443a', '#3b82f6', '#22c55e', '#f5b700']);\n\nexport const MODES = Object.freeze(['parallel', 'ghost', 'shared-world']);\n\n/** Each mode's name on screen. */\nexport const MODE_NAMES = Object.freeze({ parallel: 'Parallel', ghost: 'Ghost', 'shared-world': 'Shared world' });\n\n/** Older tags, still played: race as ghost, co-op and versus as a shared world. */\nconst MODE_ALIASES = Object.freeze({ race: 'ghost', 'co-op': 'shared-world', versus: 'shared-world' });\n\n/** The mode a tag or a hello names, older tags included; null for anything else. */\nexport function modeOf(word) {\n  const w = String(word ?? '').trim().toLowerCase();\n  return MODES.includes(w) ? w : (MODE_ALIASES[w] ?? null);\n}\n\n/** Modes where every copy runs its own world: each reports its own result, and nothing depends on a host. */\nexport const SELF_REPORTED = Object.freeze(['parallel', 'ghost']);\n\n/**\n * Whether a game's round carries the seed in its address, so the client seeds\n * Math.random and every copy starts the same: read from the game's own tag,\n * parallel or ghost. A game still tagged race was built for an unseeded start\n * (ids it makes from Math.random must differ between its copies), so it keeps one.\n */\nexport const seedsRandom = (tag) => ['parallel', 'ghost'].includes(String(tag ?? '').trim().toLowerCase());\n\nconst REAL_CLOCK = {\n  now: () => Date.now(),\n  setTimeout: (fn, ms) => setTimeout(fn, ms),\n  clearTimeout: (handle) => clearTimeout(handle),\n};\n\n/** A round's hard cap: half again its declared length, never past 15 minutes; the longest when it declares none. */\n\n# AI Hub\n\nAn arcade wall for games built by AI models. Games can be single HTML pages\nor project folders with their own code and assets; the hub finds them, dresses\nthem, and gets out of the way. Shared engines live in `lib/`.\n\n**Live:** <https://crosato-arcade.vercel.app> — public, no sign-in. This repo\nstays private; only the built site is reachable.\n\n---\n\n## Adding a game\n\nPut the `.html` file in `games/`. That is the whole procedure.\n\n```\ngames/Whatever_You_Called_It.html\n```\n\nReload the wall on `pnpm dev` and it is there; the public site gets it with\nthe next deploy. No code to touch, no list to edit, no naming rules to\nremember — mixed case, spaces, underscores and hyphens are all\nfine.\n\n```bash\ngit add games/ && git commit -m \"Add Whatever You Called It\" && git push\n```\n\n### Where the game's details come from\n\nNothing is typed in by hand. On every build, `scripts/scan.mjs` reads just the\n`<head>` of each file for catalogue metadata (the audio inventory also reads source text and asset paths):\n\n| From the game | Becomes |\n|---|---|\n| `<title>Undertow — Seven Guardians Below</title>` | Name **Undertow**, tagline **Seven Guardians Below** |\n| `<meta name=\"description\">` | The blurb in the drawer |\n| `<meta name=\"theme-color\">` | That cabinet's marquee colour and the light it throws |\n| `<link rel=\"icon\" href=\"data:…\">` | The emblem on its screen (a relative path works in a project folder) |\n| `<meta property=\"og:image\">` | Its cover art, in a project folder that ships the image |\n| file size, the date first added to the hub | The File size rail, the Newest sort |\n\nA game with none of these still works — it gets its filename as a name and a\ncolour derived from its slug.\n\n### Names on the wall\n\nNo two entries show the same name. When names collide (case and accents\nignored), the oldest entry, the first added to the hub, keeps the plain name\nand later ones are numbered in the order they were added: **Ashbound**,\n**Ashbound (2)**, **Ashbound (3)**. The scan does it on every build, so a\nduplicate needs no manual work, and nothing in the game file or the catalogue\nchanges. Search still finds each by its plain name, and attempts at one\noriginal still stack under it. `pnpm test` fails if two entries ever show the\nsame name. See [the 28 Oct curation](docs/curation-2026-10-28.md).\n\n### Several builds of one game\n\nTwo ways, whichever suits the moment:\n\n```\ngames/Void-Explorer-v0.4.html      ← same folder, version in the name\ngames/Void-Explorer-v0.5.html         v0.5 becomes current, v0.4 moves to history\n\ngames/void-explorer/v0.4.html      ← or a folder per game, files named as versions\ngames/void-explorer/v0.5.html\n```\n\nOne tile either way, showing the newest build, with the older ones a click away\nin its drawer.\n\nA version is only recognised when it is unmistakable: `-v2`, `-v0.4`, `-1.2`.\nA bare trailing number is left alone, so `snake-2.html` stays its own game\nrather than quietly becoming build 2 of `snake`. Hiding a game by accident is\nworse than showing one tile too many.\n\n### The library's naming convention\n\nAny name works, but the library names its files by source, so `games/` sorts\ninto families:\n\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:196:in the Couch, with its own screenshots and URL for comparison. Its genre and\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:242:pnpm test         # parsers, layout rules, zip reading, search and filters, Couch and Catalogue logic\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:267:If a game misbehaves in a frame, *Open on its own page* in its Details drawer\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:315:(**Wall · Friends · Couch · Catalogue · Atlas · Timeline · Deck**) leads to six more, built over the same games\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:326:record), on the Couch's hero and game page, and on the Deck's card. Each of\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:344:  ghosts* (ghost), *Same start, side by side* (parallel) — and *Couch co-op*,\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:353:  computer*, and *Practise alone* in the hub's player. A couch co-op game has\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:356:### The Couch — `/couch`\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:364:model that made three or more, *Originals*, *Couch co-op* (several players on\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:386:While a game runs the Couch claims nothing, keys and buttons alike. With no\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:422:record, **F** favourites, **O** opens a game on its own page, **/** writes a\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:518:each with a player leaving, then the game on its own. `--record` writes the\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:564:  on its own compared with the original.\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:800:couch/            the Couch: a page of its own, over the same library\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:821:  couch/          rails, pad and keys, the game page, search (logic tested)\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:903:ordinary wall, Couch and Catalogue search. Audio formats include voice and sound\n// The Couch's logic is plain ES modules with no DOM: the rails on its home\n// screen, today's spotlight, the controller and keyboard mappings, where an\n// arrow press lands, and how a game's controls become keycaps. Pinned here.\nimport { test } from 'node:test';\nimport assert from 'node:assert/strict';\n\nimport { normalize } from '../assets/js/manifest.js';\nimport { buildRails, spotlightOf, genreTitle, weave, dayKey, CAP } from '../assets/js/couch/rails.js';\nimport { readInput, padStep, chordStep, mergeInputs, REPEAT, CHORD_MS } from '../assets/js/couch/pad.js';\nimport { keyAction, createRepeatGate, typed } from '../assets/js/couch/input.js';\nimport { nearest } from '../assets/js/couch/nav.js';\nimport { parseControls, keysSummary, proseParts } from '../assets/js/couch/howto.js';\nimport { ago, heroChips, pageFacts, eyebrow } from '../assets/js/couch/facts.js';\nimport { scan } from './scan.mjs';\n\nconst DAY = 24 * 60 * 60 * 1000;\nconst NOW = Date.parse('2026-10-06T12:00:00');\nconst game = (slug, patch = {}) => normalize({ slug, name: slug, added: '2026-09-01', tags: [], ...patch });\nconst slugs = (list) => list.map((g) => g.slug);\nconst quiet = { isFave: () => false, lastPlayed: () => 0 };\nconst keys = (parts) => parts.map((p) => (p.key ? `[${p.key}]` : p.text)).join(' ');\n\n/* --- rails ---------------------------------------------------------------- */\n\nconst added = (i) => new Date(Date.parse('2026-09-01') + i * DAY).toISOString();\n\n/** A small library shaped like the real one: genres of different sizes, a\n *  series or two, a model, multiplayer games, and the other shelf. */\nfunction library() {\n  const games = [];\n  const add = (slug, patch) => games.push(game(slug, { added: added(games.length), ...patch }));\n  for (let i = 0; i < 45; i++) add(`rpg-${i}`, { genre: 'RPG', ...(i < 6 && { source: 'Dragon Quest IV', series: 'Dragon Quest' }) });\n  for (let i = 0; i < 9; i++) add(`shooter-${i}`, { genre: 'Shooter', ...(i < 4 && { source: 'Star Fox' }) });\n  for (let i = 0; i < 6; i++) add(`racing-${i}`, { genre: 'Racing', ...(i < 3 && { model: 'GPT-6' }), ...(i < 2 && { players: '1–2' }) });\n  for (let i = 0; i < 4; i++) add(`life-${i}`, { genre: 'Life Sim' });\n  for (let i = 0; i < 2; i++) add(`fight-${i}`, { genre: 'Fighting', source: 'Street Fighter II' });\n  for (let i = 0; i < 5; i++) add(`demo-${i}`, { genre: 'Tech Demo', type: 'Tech demo' });\n  add('tool-0', { type: 'Tool' });\n  return games;\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"33b9a197-b2fe-42e5-9a43-b32ae2dde858","uuid":"474e949d-ec2a-4dcd-83f0-c941925155d7","timestamp":"2026-11-05T04:25:37.712Z","tool_use_result":{"stdout":"/**\n * bridge.js — the hub's end of one game frame in a session.\n *\n * A game speaks the AI Hub Session Protocol over postMessage (lib/hub/README.md).\n * The bridge checks every message, enforces the limits, and routes it: control\n * messages (hello, ready, result, finish, error) to whoever coordinates the\n * round (lib/hub/round.js), game traffic straight to the other players, and a\n * game's answers on its own card to the page that holds it. What\n * comes back from the network is checked again before it reaches the game,\n * and anything from another round is dropped, so a slow packet can never land\n * in the next game.\n *\n * The network is anything with `send(toKey, envelope, {reliable})`: the\n * simulated one below (harness, tests), a BroadcastChannel between tabs, or a\n * WebRTC mesh. Envelopes:\n *   {k:'c', r, m}       to the coordinator: a message from this game\n *   {k:'h', r, m}       from the coordinator: welcome, start, leave, time-up, end\n *   {k:'g', r, f, d}    game traffic from player id f\n *   {k:'p', r, f, d}    player id f's progress, {score, label}, for the scoreboard\n */\n\nexport const LIMITS = Object.freeze({\n  maxBytes: 16_384,\n  ratePerS: 20,\n  burst: 40,\n  queueMessages: 64,\n  queueBytes: 262_144,\n  /**\n   * progress() reaches the hub about once a second. Two closer than this are a\n   * report delivered late (a long task in the game) or a client misbehaving:\n   * the later is dropped, and the next report, a second on, has the newest score.\n   */\n  progressMs: 250,\n  label: 24,\n});\n\nconst FROM_GAME = new Set(['hello', 'ready', 'send', 'result', 'finish', 'error', 'progress', 'fullscreen', 'answer']);\n\n/** A progress report, checked: a finite score and an optional short label. Null when it is not one. */\nexport function cleanProgress(p) {\n  if (!p || typeof p !== 'object') return null;\n  // A number, or text that is one: never null, '', true or [], which Number() would make 0 or 1.\n  const score = typeof p.score === 'number' || (typeof p.score === 'string' && p.score.trim() !== '') ? Number(p.score) : NaN;\n  if (!Number.isFinite(score)) return null;\n  const label = typeof p.label === 'string' ? p.label.trim().slice(0, LIMITS.label) : '';\n  return label ? { score, label } : { score };\n}\n\n/**\n * @param {object} o\n * @param {string} o.key              this player's key in the session\n * @param {number} o.round\n * @param {string} o.coordinator      key of whoever runs round.js\n * @param {(msg:object) => void} o.post            to the game frame\n * @param {{send:Function}} o.net\n * @param {{now:()=>number}} [o.clock]             the coordinator's time, as seen here\n * @param {(issue:{key:string, problem:string}) => void} [o.onIssue]\n * @param {(id:number, progress:{score:number, label?:string}) => void} [o.onProgress]   a player's\n *        progress, this one's included, for the hub's scoreboard; it never reaches the games\n * @param {(on:boolean) => void} [o.onFullscreen]   the game asked for fullscreen (or out of it): the\n *        hub's page takes it, so the hub's own cards stay over the game\n * @param {(what:'ready'|'more') => void} [o.onAnswer]   this player answered on the game's own card\n */\nexport function createBridge({ key, round, coordinator, post, net, clock = Date, onIssue = () => {}, onProgress = () => {}, onFullscreen = () => {}, onAnswer = () => {} }) {\n  let welcomed = false;\n  let ended = false;\n  let started = false;\n  let helloSent = false;\n  let ownsCard = false;\n  let readySent = false;\n  let me = null;\n  let keys = [];\n  const gone = new Set();\n  const queue = [];\n  let queuedBytes = 0;\n  let tokens = LIMITS.burst;\n  let refilled = clock.now();\n  let progressAt = -Infinity;\n  const issues = [];\n  const stats = { sent: 0, received: 0, bytesSent: 0, dropped: 0 };\n...\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/bridge.js:22:export const LIMITS = Object.freeze({\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/bridge.js:40:export function cleanProgress(p) {\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/bridge.js:64:export function createBridge({ key, round, coordinator, post, net, clock = Date, onIssue = () => {}, onProgress = () => {}, onFullscreen = () => {}, onAnswer = () => {} }) {\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/bridge.js:265:export function attachFrame(frame, onMessage) {\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/bridge.js:276:export const postTo = (frame) => (msg) => frame.contentWindow?.postMessage(msg, '*');\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/bridge.js:283:export function createLocalNetwork({ latency = 0, jitter = 0, loss = 0, random = Math.random, clock = globalThis } = {}) {\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:15:export const TIMINGS = Object.freeze({\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:27:export const SLOT_COLORS = Object.freeze(['#e8443a', '#3b82f6', '#22c55e', '#f5b700']);\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:29:export const MODES = Object.freeze(['parallel', 'ghost', 'shared-world']);\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:32:export const MODE_NAMES = Object.freeze({ parallel: 'Parallel', ghost: 'Ghost', 'shared-world': 'Shared world' });\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:38:export function modeOf(word) {\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:44:export const SELF_REPORTED = Object.freeze(['parallel', 'ghost']);\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:52:export const seedsRandom = (tag) => ['parallel', 'ghost'].includes(String(tag ?? '').trim().toLowerCase());\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:61:export function limitFor(minutes, { maxRoundMs = TIMINGS.maxRoundMs } = {}) {\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:72:export function rankResults(results, ids) {\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:99:export const HIGHLIGHTS = Object.freeze({ stats: 6, statName: 16, statText: 16, awards: 3, title: 24, detail: 40 });\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:102:export function cleanStats(stats) {\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:118:export function cleanAwards(awards, ids, self = null) {\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:138:export function checkStandings(standings, presentIds, allIds) {\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/lib/hub/round.js:179:export function createRound({\n/**\n * round.js — one round of an AI Hub session, run by the hub that coordinates\n * it (the harness page, or the session host's tab).\n *\n * It never touches the network or a frame itself: every message for a game\n * goes out through `deliver(key, msg)`, and everything the games report comes\n * in through `receive(key, msg)` and `leave(key, reason)`. The clock is\n * injected, so `scripts/hub.test.mjs` can walk a round through every timeout\n * without waiting for one.\n *\n * Players are known by `key` (whatever the session calls them); games see\n * contiguous ids 0..N-1 in slot order.\n */\n\nexport const TIMINGS = Object.freeze({\n  helloMs: 10_000,\n  readyMs: 45_000,\n  /** Gated rounds: a game still loading when the hub releases the round gets this long more. */\n  loadGraceMs: 20_000,\n  countdownMs: 3_000,\n  graceMs: 5_000,\n  hiddenMs: 20_000,\n  maxRoundMs: 15 * 60_000,\n});\n\n/** P1 red, P2 blue, P3 green, P4 yellow: the colour follows the seat. */\nexport const SLOT_COLORS = Object.freeze(['#e8443a', '#3b82f6', '#22c55e', '#f5b700']);\n\nexport const MODES = Object.freeze(['parallel', 'ghost', 'shared-world']);\n\n/** Each mode's name on screen. */\nexport const MODE_NAMES = Object.freeze({ parallel: 'Parallel', ghost: 'Ghost', 'shared-world': 'Shared world' });\n\n/** Older tags, still played: race as ghost, co-op and versus as a shared world. */\nconst MODE_ALIASES = Object.freeze({ race: 'ghost', 'co-op': 'shared-world', versus: 'shared-world' });\n\n/** The mode a tag or a hello names, older tags included; null for anything else. */\nexport function modeOf(word) {\n  const w = String(word ?? '').trim().toLowerCase();\n  return MODES.includes(w) ? w : (MODE_ALIASES[w] ?? null);\n}\n\n/** Modes where every copy runs its own world: each reports its own result, and nothing depends on a host. */\nexport const SELF_REPORTED = Object.freeze(['parallel', 'ghost']);\n\n/**\n * Whether a game's round carries the seed in its address, so the client seeds\n * Math.random and every copy starts the same: read from the game's own tag,\n * parallel or ghost. A game still tagged race was built for an unseeded start\n * (ids it makes from Math.random must differ between its copies), so it keeps one.\n */\nexport const seedsRandom = (tag) => ['parallel', 'ghost'].includes(String(tag ?? '').trim().toLowerCase());\n\nconst REAL_CLOCK = {\n  now: () => Date.now(),\n  setTimeout: (fn, ms) => setTimeout(fn, ms),\n  clearTimeout: (handle) => clearTimeout(handle),\n};\n\n/** A round's hard cap: half again its declared length, never past 15 minutes; the longest when it declares none. */\n\n# AI Hub\n\nAn arcade wall for games built by AI models. Games can be single HTML pages\nor project folders with their own code and assets; the hub finds them, dresses\nthem, and gets out of the way. Shared engines live in `lib/`.\n\n**Live:** <https://crosato-arcade.vercel.app> — public, no sign-in. This repo\nstays private; only the built site is reachable.\n\n---\n\n## Adding a game\n\nPut the `.html` file in `games/`. That is the whole procedure.\n\n```\ngames/Whatever_You_Called_It.html\n```\n\nReload the wall on `pnpm dev` and it is there; the public site gets it with\nthe next deploy. No code to touch, no list to edit, no naming rules to\nremember — mixed case, spaces, underscores and hyphens are all\nfine.\n\n```bash\ngit add games/ && git commit -m \"Add Whatever You Called It\" && git push\n```\n\n### Where the game's details come from\n\nNothing is typed in by hand. On every build, `scripts/scan.mjs` reads just the\n`<head>` of each file for catalogue metadata (the audio inventory also reads source text and asset paths):\n\n| From the game | Becomes |\n|---|---|\n| `<title>Undertow — Seven Guardians Below</title>` | Name **Undertow**, tagline **Seven Guardians Below** |\n| `<meta name=\"description\">` | The blurb in the drawer |\n| `<meta name=\"theme-color\">` | That cabinet's marquee colour and the light it throws |\n| `<link rel=\"icon\" href=\"data:…\">` | The emblem on its screen (a relative path works in a project folder) |\n| `<meta property=\"og:image\">` | Its cover art, in a project folder that ships the image |\n| file size, the date first added to the hub | The File size rail, the Newest sort |\n\nA game with none of these still works — it gets its filename as a name and a\ncolour derived from its slug.\n\n### Names on the wall\n\nNo two entries show the same name. When names collide (case and accents\nignored), the oldest entry, the first added to the hub, keeps the plain name\nand later ones are numbered in the order they were added: **Ashbound**,\n**Ashbound (2)**, **Ashbound (3)**. The scan does it on every build, so a\nduplicate needs no manual work, and nothing in the game file or the catalogue\nchanges. Search still finds each by its plain name, and attempts at one\noriginal still stack under it. `pnpm test` fails if two entries ever show the\nsame name. See [the 28 Oct curation](docs/curation-2026-10-28.md).\n\n### Several builds of one game\n\nTwo ways, whichever suits the moment:\n\n```\ngames/Void-Explorer-v0.4.html      ← same folder, version in the name\ngames/Void-Explorer-v0.5.html         v0.5 becomes current, v0.4 moves to history\n\ngames/void-explorer/v0.4.html      ← or a folder per game, files named as versions\ngames/void-explorer/v0.5.html\n```\n\nOne tile either way, showing the newest build, with the older ones a click away\nin its drawer.\n\nA version is only recognised when it is unmistakable: `-v2`, `-v0.4`, `-1.2`.\nA bare trailing number is left alone, so `snake-2.html` stays its own game\nrather than quietly becoming build 2 of `snake`. Hiding a game by accident is\nworse than showing one tile too many.\n\n### The library's naming convention\n\nAny name works, but the library names its files by source, so `games/` sorts\ninto families:\n\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:196:in the Couch, with its own screenshots and URL for comparison. Its genre and\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:242:pnpm test         # parsers, layout rules, zip reading, search and filters, Couch and Catalogue logic\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:267:If a game misbehaves in a frame, *Open on its own page* in its Details drawer\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:315:(**Wall · Friends · Couch · Catalogue · Atlas · Timeline · Deck**) leads to six more, built over the same games\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:326:record), on the Couch's hero and game page, and on the Deck's card. Each of\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:344:  ghosts* (ghost), *Same start, side by side* (parallel) — and *Couch co-op*,\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:353:  computer*, and *Practise alone* in the hub's player. A couch co-op game has\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:356:### The Couch — `/couch`\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:364:model that made three or more, *Originals*, *Couch co-op* (several players on\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:386:While a game runs the Couch claims nothing, keys and buttons alike. With no\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:422:record, **F** favourites, **O** opens a game on its own page, **/** writes a\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:518:each with a player leaving, then the game on its own. `--record` writes the\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:564:  on its own compared with the original.\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:800:couch/            the Couch: a page of its own, over the same library\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:821:  couch/          rails, pad and keys, the game page, search (logic tested)\n/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211941__xf7be7f/work/.scout/ai-hub/README.md:903:ordinary wall, Couch and Catalogue search. Audio formats include voice and sound\n// The Couch's logic is plain ES modules with no DOM: the rails on its home\n// screen, today's spotlight, the controller and keyboard mappings, where an\n// arrow press lands, and how a game's controls become keycaps. Pinned here.\nimport { test } from 'node:test';\nimport assert from 'node:assert/strict';\n\nimport { normalize } from '../assets/js/manifest.js';\nimport { buildRails, spotlightOf, genreTitle, weave, dayKey, CAP } from '../assets/js/couch/rails.js';\nimport { readInput, padStep, chordStep, mergeInputs, REPEAT, CHORD_MS } from '../assets/js/couch/pad.js';\nimport { keyAction, createRepeatGate, typed } from '../assets/js/couch/input.js';\nimport { nearest } from '../assets/js/couch/nav.js';\nimport { parseControls, keysSummary, proseParts } from '../assets/js/couch/howto.js';\nimport { ago, heroChips, pageFacts, eyebrow } from '../assets/js/couch/facts.js';\nimport { scan } from './scan.mjs';\n\nconst DAY = 24 * 60 * 60 * 1000;\nconst NOW = Date.parse('2026-10-06T12:00:00');\nconst game = (slug, patch = {}) => normalize({ slug, name: slug, added: '2026-09-01', tags: [], ...patch });\nconst slugs = (list) => list.map((g) => g.slug);\nconst quiet = { isFave: () => false, lastPlayed: () => 0 };\nconst keys = (parts) => parts.map((p) => (p.key ? `[${p.key}]` : p.text)).join(' ');\n\n/* --- rails ---------------------------------------------------------------- */\n\nconst added = (i) => new Date(Date.parse('2026-09-01') + i * DAY).toISOString();\n\n/** A small library shaped like the real one: genres of different sizes, a\n *  series or two, a model, multiplayer games, and the other shelf. */\nfunction library() {\n  const games = [];\n  const add = (slug, patch) => games.push(game(slug, { added: added(games.length), ...patch }));\n  for (let i = 0; i < 45; i++) add(`rpg-${i}`, { genre: 'RPG', ...(i < 6 && { source: 'Dragon Quest IV', series: 'Dragon Quest' }) });\n  for (let i = 0; i < 9; i++) add(`shooter-${i}`, { genre: 'Shooter', ...(i < 4 && { source: 'Star Fox' }) });\n  for (let i = 0; i < 6; i++) add(`racing-${i}`, { genre: 'Racing', ...(i < 3 && { model: 'GPT-6' }), ...(i < 2 && { players: '1–2' }) });\n  for (let i = 0; i < 4; i++) add(`life-${i}`, { genre: 'Life Sim' });\n  for (let i = 0; i < 2; i++) add(`fight-${i}`, { genre: 'Fighting', source: 'Street Fighter II' });\n  for (let i = 0; i < 5; i++) add(`demo-${i}`, { genre: 'Tech Demo', type: 'Tech demo' });\n  add('tool-0', { type: 'Tool' });\n  return games;\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01GnV57MnQH63bQWHUEnkBCz","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
