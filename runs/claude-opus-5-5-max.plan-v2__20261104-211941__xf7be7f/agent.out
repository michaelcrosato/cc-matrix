{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Jr3hPcfLuUcgBRutU6Yasu","type":"tool_result","content":"   Compiling egui-wgpu v0.36.2\n   Compiling tobj v4.0.3\n//! Shardfall, the showcase hack-and-slash (docs/GAME.md). The game lives inside the\n//! simulation (`SimState::game`), so snapshots, rewind, replays, agent tools and the live bridge\n//! all work on it. Each tick: `game_pre` turns input and monster brains into movement and skill\n//! use before characters move; `game_post` lands hits, moves projectiles, ticks ailments and\n//! hands out rewards after physics.\n\npub mod boss;\npub mod bot;\npub mod brain;\npub mod cmd;\npub mod combat;\npub mod data;\npub mod genome;\npub mod hall;\npub mod hero;\npub mod items;\npub mod levelgen;\npub mod loot;\npub mod mechanics;\npub mod powers;\npub mod scene;\npub mod skills;\npub mod stats;\npub mod tree;\npub mod world;\n\npub use cmd::{GameCmd, Place, Spot, SpotKind};\n\nuse std::collections::BTreeMap;\nuse std::sync::Arc;\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse crate::entity::EntityId;\nuse crate::frame::SimEvent;\nuse crate::input::{InputFrame, buttons};\nuse crate::params::{ParamVisitor, Tunable};\nuse crate::sim::Sim;\nuse brain::{AGGRO_RANGE, Brain, PACK_RANGE, SkillOption};\nuse combat::*;\nuse data::{Behavior, data};\nuse hero::Hero;\nuse stats::{Base, Mods, Sheet};\n\n/// Difficulty multipliers for play-testing (pause menu, `difficulty.*` parameters).\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct Difficulty {\n    pub player_damage: f32,\n    pub player_life: f32,\n    pub enemy_damage: f32,\n    pub enemy_life: f32,\n    pub enemy_speed: f32,\n    /// Feel: hit-stop and screen shake strength.\n    pub hitstop: f32,\n    pub shake: f32,\n}\n\nimpl Default for Difficulty {\n    fn default() -> Self {\n        Self {\n            player_damage: 1.0,\n            player_life: 1.0,\n            enemy_damage: 1.0,\n            enemy_life: 1.0,\n            enemy_speed: 1.0,\n            hitstop: 1.0,\n            shake: 1.0,\n        }\n    }\n}\n\nimpl Tunable for Difficulty {\n    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n        v.float(\"player_damage\", &mut self.player_damage, 0.1, 10.0, \"Damage the hero deals (x)\");\n        v.float(\"player_life\", &mut self.player_life, 0.1, 10.0, \"Hero life (x)\");\n        v.float(\"enemy_damage\", &mut self.enemy_damage, 0.0, 10.0, \"Damage monsters deal (x)\");\n        v.float(\"enemy_life\", &mut self.enemy_life, 0.1, 10.0, \"Monster life (x, new spawns)\");\n        v.float(\"enemy_speed\", &mut self.enemy_speed, 0.3, 3.0, \"Monster movement and attack speed (x)\");\n        v.float(\"hitstop\", &mut self.hitstop, 0.0, 3.0, \"Hit-stop strength (feel)\");\n        v.float(\"shake\", &mut self.shake, 0.0, 3.0, \"Screen shake strength (feel)\");\n    }\n}\n\n/// Dodge: speed (m/s), duration (s) and recovery (s).\npub const DODGE_SPEED: f32 = 17.0;\npub const DODGE_TIME: f32 = 0.26;\npub const DODGE_RECOVERY: f32 = 0.75;\n/// Hero base movement speed comes from `movement.speed`; monsters move at this share of it.\npub const MONSTER_PACE: f32 = 0.78;\n/// Seconds a dead monster lies before it clears; one with a captured fall lies that long once\n/// down, sinking for `CORPSE_SINK` of them.\npub const CORPSE_TIME: f32 = 1.7;\npub const CORPSE_SINK: f32 = 0.4;\n\n/// How long a dead monster's body stays: 1.7 s, or a captured fall's time to the ground and a\n/// moment to sink.\nfn corpse_time(sim: &Sim, id: EntityId) -> f32 {\n    let def = sim.state.entities.get(id).and_then(|e| e.character.as_ref()).and_then(|c| c.puppet.as_deref());\n    match def.filter(|p| p.body == crate::puppet::BodyPlan::Biped).and_then(crate::clips::death_clip) {\n        Some((_, _, land)) => (land + CORPSE_SINK + 0.1).max(CORPSE_TIME),\n        None => CORPSE_TIME,\n    }\n}\n\n/// Captured falls the hero dies with, in turn (anim/*.json, from open motion libraries).\npub const HERO_DEATHS: &[&str] =\n    &[\"QUATERNIUS/Death01\", \"MESH2MOTION/Death_D\", \"MESH2MOTION/Death_C\", \"CMU/Fall_On_Face\", \"MESH2MOTION/Death_A\"];\n/// Captured gestures for the hero's big moments (upper body, so they never stop the hero).\npub const HERO_LEVEL_UP: &str = \"MESH2MOTION/Cheer_One_arm\";\npub const HERO_BOSS_DOWN: &str = \"MESH2MOTION/Cheering_Two_Hands\";\n\n/// The wave arena (G1 test ground; later the Proving Grounds in town).\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct ArenaState {\n    pub wave: u32,\n    pub next_in: f32,\n    pub center: Vec3,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Game {\n    pub hero: Hero,\n    pub hero_id: Option<EntityId>,\n    pub actors: BTreeMap<EntityId, Actor>,\n    pub shots: Vec<Shot>,\n    pub effects: Vec<Effect>,\n    pub floaters: Vec<Floater>,\n    /// Hit-stop (seconds of near-frozen time left) and screen shake (decaying strength).\n    pub hitstop: f32,\n    pub shake: f32,\n    /// Banner message and seconds left.\n    pub message: Option<(String, f32)>,\n    pub arena: Option<ArenaState>,\n    /// Hero is down: seconds until respawning at `spawn`.\n    pub respawn: f32,\n    pub spawn: Vec3,\n    pub next_pack: u32,\n    pub time: f32,\n6:use pav_core::games::{GAMES, Outcome};\n14:pub fn t_play(s: &mut Session, a: &Args) -> Result<Output> {\n16:    let Some(key) = s.sim.play().map(|g| g.key()) else {\n39:                not_won.push(json!({ \"seed\": seed, \"status\": sim.play().map(|g| g.status(&sim)) }));\n57:    let g = s.sim.play().expect(\"the game is still running\");\n# Playable characters: who you can be, how each looks and moves, and what a new hero of theirs\n# starts with. They stand on pedestals in Emberwatch's Hall of Heroes (south side of the square),\n# each performing a showreel; use a pedestal to play as them. Every character is a hero of their\n# own (level, gear, passives, waypoints) and waits in the hall while another is played; the stash\n# is shared. Check with `turntable character=KEY`, `animsheet character=KEY skill=slash swing=2`,\n# `hero character=KEY` and `game_reload`.\n#\n# Fields:\n#   name, title, about   \"Kestrel\", \"the Brawler\", a line for the hall's card\n#   order                hall order (the first is who a new game starts as)\n#   weapon, gear         starting weapon and other worn items (game/items.toml base keys; worn\n#                        items colour the look, so leave out what the look should show itself)\n#   bar                  the six skills of a new hero's bar (left, right, Q, E, R, F)\n#   deaths               captured falls they die with, in turn (anim/*.json clips)\n#   level_up, triumph    upper-body gestures for a level gained and a boss felled\n#   showreel             what they perform on their pedestal, in turn: skill keys (every swing\n#                        of the combo, as they strike it), move names (anim/moves.toml) or clips\n#   [KEY.look]           puppet settings over the default biped (any `turntable def=` field); no\n#                        look = the scene's own puppet. The animation kit lives here:\n#     idle_clip, walk_clip, run_clip   captured standing, walking and running (bipeds)\n#     attack_clips       skill -> captured attack, or a list: one per swing of its combo\n#     attack_moves       skill -> a move of anim/moves.toml in place of the skill's own, or a list\n#     dodge_clip         a captured dodge in place of the procedural tumble\n\n# ---------------------------------------------------------------------------------- Wanderer\n# The original hero: the engine's procedural animation (every swing an arc around the\n# shoulders, legs that stride the way the body travels, a tumbling dodge roll).\n[wanderer]\nname = \"Wanderer\"\ntitle = \"the Sellsword\"\nabout = \"A sword for hire who learned a little of everything: blade, fire and frost. Moves with the engine's own procedural animation.\"\norder = 1\nweapon = \"rusted_sword\"\nbar = [\"slash\", \"fireball\", \"cleave\", \"leap_slam\", \"frost_nova\", \"blade_dash\"]\ndeaths = [\"QUATERNIUS/Death01\", \"MESH2MOTION/Death_D\", \"MESH2MOTION/Death_C\", \"CMU/Fall_On_Face\", \"MESH2MOTION/Death_A\"]\nlevel_up = \"MESH2MOTION/Cheer_One_arm\"\ntriumph = \"MESH2MOTION/Cheering_Two_Hands\"\nshowreel = [\"slash\", \"cleave\", \"leap_slam\", \"fireball\", \"whirlwind\", \"earthsplitter\"]\n\n# ----------------------------------------------------------------------------------- Kestrel\n# Fists and feet in captured boxing and karate: a boxer's guard (CMU), a swaggering strut\n# (100STYLE), a sprint, a jab-cross-roundhouse combo, a two-handed chi blast, a ground pound; the\n# procedural fist and kick moves for the rest (leg sweep, axe kick, flying kick, uppercut,\n# haymaker); a captured shoulder roll for a dodge.\n[kestrel]\nname = \"Kestrel\"\ntitle = \"the Brawler\"\nabout = \"A pit fighter from the river docks who never needed a blade: wrapped fists, iron hooks for the mean nights, and a mohawk you can see across the square.\"\norder = 2\nweapon = \"hooks\"\nbar = [\"slash\", \"cleave\", \"leap_slam\", \"blade_dash\", \"war_cry\", \"earthsplitter\"]\ndeaths = [\"CMU/Fall_On_Face\", \"MESH2MOTION/Death_B\", \"QUATERNIUS/Death01\"]\nlevel_up = \"MESH2MOTION/Victory Fist Pump\"\ntriumph = \"MESH2MOTION/Victory\"\nshowreel = [\"slash\", \"cleave\", \"blade_dash\", \"fireball\", \"leap_slam\", \"CMU/Jump_Kick\", \"earthsplitter\", \"war_cry\", \"MESH2MOTION/Backflip\"]\n\n[kestrel.look]\nscale = 0.96\nhead_radius = 0.2\ntorso_length = 0.4\n# Shardfall skills. Hero skills and monster attacks share one format, so any monster can be\n# given any skill (procedural monsters cast Fireball too).\n#\n# behavior   melee | slam | leap | dash | projectile | nova | charge | channel | wave | buff |\n#            meteor | field | blink | rain\n# anim       slash | overhead | thrust | spin | cast | throw | roar | leap | lunge\n# tags       attack / spell, melee, projectile, area, movement, + an element; damage bonuses\n#            apply by tag (\"increased Melee Damage\", \"increased Spell Damage\", ...)\n# time       seconds per use (attacks: at 1 attack per second; faster weapons and attack speed\n#            shorten it; spells: cast speed)\n# hit        when the hit lands, as a fraction of `time`\n# effect     attacks: damage as a multiple of weapon (or monster) damage; spells: the\n#            multiple a monster casting it deals (the hero's spells use `base`)\n# base       spells: damage range at hero level 1 (grows with level)\n# element    physical | fire | cold | lightning | poison\n# range      melee reach / dash or leap distance / projectile range / AI trigger distance (m)\n# angle      melee arc (degrees); radius: area (m); speed: projectile speed (m/s)\n# ailment    base chance of the element's ailment (bleed, ignite, freeze, shock, poison)\n# telegraph  monsters show a warning on the ground while winding up\n# mana_gain  mana gained per enemy hit (basic attacks)\n# duration   fields, buffs, monster channels (s); interval: channel pulse (s)\n# chain      projectiles: extra enemies to chain to; count: projectiles / wave segments / drops\n# delay      meteor fall time (s); scatter: rain area (m); buff: stats while a war cry lasts\n\n# ------------------------------------------------------------------------------ hero\n[slash]\nname = \"Slash\"\nabout = \"Quick three-swing combo. The third swing reaches wider and knocks enemies back. Restores mana on hit.\"\ntags = [\"attack\", \"melee\", \"area\"]\nbehavior = \"melee\"\nanim = \"slash\"\nunlock = 1\ntime = 0.55\nhit = 0.42\neffect = 1.0\nrange = 2.6\nangle = 150\ncombo = 3\nknockback = 1.4\nmana_gain = 3\nhitstop = 0.03\ncolor = \"#e8eef5\"\n\n[cleave]\nname = \"Cleave\"\nabout = \"A heavy two-handed sweep through everything in front of you.\"\ntags = [\"attack\", \"melee\", \"area\"]\nbehavior = \"melee\"\nanim = \"slash\"\nunlock = 1\ncost = 8\ntime = 0.8\nhit = 0.5\neffect = 1.9\nrange = 3.4\nangle = 210\nknockback = 3.0\nhitstop = 0.07\nshake = 0.25\ncolor = \"#ffd27a\"","is_error":false}]},"parent_tool_use_id":null,"session_id":"33b9a197-b2fe-42e5-9a43-b32ae2dde858","uuid":"cdd48467-e329-45e8-a0cd-c35641f278f1","timestamp":"2026-11-05T04:22:51.599Z","tool_use_result":{"stdout":"   Compiling egui-wgpu v0.36.2\n   Compiling tobj v4.0.3\n//! Shardfall, the showcase hack-and-slash (docs/GAME.md). The game lives inside the\n//! simulation (`SimState::game`), so snapshots, rewind, replays, agent tools and the live bridge\n//! all work on it. Each tick: `game_pre` turns input and monster brains into movement and skill\n//! use before characters move; `game_post` lands hits, moves projectiles, ticks ailments and\n//! hands out rewards after physics.\n\npub mod boss;\npub mod bot;\npub mod brain;\npub mod cmd;\npub mod combat;\npub mod data;\npub mod genome;\npub mod hall;\npub mod hero;\npub mod items;\npub mod levelgen;\npub mod loot;\npub mod mechanics;\npub mod powers;\npub mod scene;\npub mod skills;\npub mod stats;\npub mod tree;\npub mod world;\n\npub use cmd::{GameCmd, Place, Spot, SpotKind};\n\nuse std::collections::BTreeMap;\nuse std::sync::Arc;\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse crate::entity::EntityId;\nuse crate::frame::SimEvent;\nuse crate::input::{InputFrame, buttons};\nuse crate::params::{ParamVisitor, Tunable};\nuse crate::sim::Sim;\nuse brain::{AGGRO_RANGE, Brain, PACK_RANGE, SkillOption};\nuse combat::*;\nuse data::{Behavior, data};\nuse hero::Hero;\nuse stats::{Base, Mods, Sheet};\n\n/// Difficulty multipliers for play-testing (pause menu, `difficulty.*` parameters).\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct Difficulty {\n    pub player_damage: f32,\n    pub player_life: f32,\n    pub enemy_damage: f32,\n    pub enemy_life: f32,\n    pub enemy_speed: f32,\n    /// Feel: hit-stop and screen shake strength.\n    pub hitstop: f32,\n    pub shake: f32,\n}\n\nimpl Default for Difficulty {\n    fn default() -> Self {\n        Self {\n            player_damage: 1.0,\n            player_life: 1.0,\n            enemy_damage: 1.0,\n            enemy_life: 1.0,\n            enemy_speed: 1.0,\n            hitstop: 1.0,\n            shake: 1.0,\n        }\n    }\n}\n\nimpl Tunable for Difficulty {\n    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n        v.float(\"player_damage\", &mut self.player_damage, 0.1, 10.0, \"Damage the hero deals (x)\");\n        v.float(\"player_life\", &mut self.player_life, 0.1, 10.0, \"Hero life (x)\");\n        v.float(\"enemy_damage\", &mut self.enemy_damage, 0.0, 10.0, \"Damage monsters deal (x)\");\n        v.float(\"enemy_life\", &mut self.enemy_life, 0.1, 10.0, \"Monster life (x, new spawns)\");\n        v.float(\"enemy_speed\", &mut self.enemy_speed, 0.3, 3.0, \"Monster movement and attack speed (x)\");\n        v.float(\"hitstop\", &mut self.hitstop, 0.0, 3.0, \"Hit-stop strength (feel)\");\n        v.float(\"shake\", &mut self.shake, 0.0, 3.0, \"Screen shake strength (feel)\");\n    }\n}\n\n/// Dodge: speed (m/s), duration (s) and recovery (s).\npub const DODGE_SPEED: f32 = 17.0;\npub const DODGE_TIME: f32 = 0.26;\npub const DODGE_RECOVERY: f32 = 0.75;\n/// Hero base movement speed comes from `movement.speed`; monsters move at this share of it.\npub const MONSTER_PACE: f32 = 0.78;\n/// Seconds a dead monster lies before it clears; one with a captured fall lies that long once\n/// down, sinking for `CORPSE_SINK` of them.\npub const CORPSE_TIME: f32 = 1.7;\npub const CORPSE_SINK: f32 = 0.4;\n\n/// How long a dead monster's body stays: 1.7 s, or a captured fall's time to the ground and a\n/// moment to sink.\nfn corpse_time(sim: &Sim, id: EntityId) -> f32 {\n    let def = sim.state.entities.get(id).and_then(|e| e.character.as_ref()).and_then(|c| c.puppet.as_deref());\n    match def.filter(|p| p.body == crate::puppet::BodyPlan::Biped).and_then(crate::clips::death_clip) {\n        Some((_, _, land)) => (land + CORPSE_SINK + 0.1).max(CORPSE_TIME),\n        None => CORPSE_TIME,\n    }\n}\n\n/// Captured falls the hero dies with, in turn (anim/*.json, from open motion libraries).\npub const HERO_DEATHS: &[&str] =\n    &[\"QUATERNIUS/Death01\", \"MESH2MOTION/Death_D\", \"MESH2MOTION/Death_C\", \"CMU/Fall_On_Face\", \"MESH2MOTION/Death_A\"];\n/// Captured gestures for the hero's big moments (upper body, so they never stop the hero).\npub const HERO_LEVEL_UP: &str = \"MESH2MOTION/Cheer_One_arm\";\npub const HERO_BOSS_DOWN: &str = \"MESH2MOTION/Cheering_Two_Hands\";\n\n/// The wave arena (G1 test ground; later the Proving Grounds in town).\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct ArenaState {\n    pub wave: u32,\n    pub next_in: f32,\n    pub center: Vec3,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Game {\n    pub hero: Hero,\n    pub hero_id: Option<EntityId>,\n    pub actors: BTreeMap<EntityId, Actor>,\n    pub shots: Vec<Shot>,\n    pub effects: Vec<Effect>,\n    pub floaters: Vec<Floater>,\n    /// Hit-stop (seconds of near-frozen time left) and screen shake (decaying strength).\n    pub hitstop: f32,\n    pub shake: f32,\n    /// Banner message and seconds left.\n    pub message: Option<(String, f32)>,\n    pub arena: Option<ArenaState>,\n    /// Hero is down: seconds until respawning at `spawn`.\n    pub respawn: f32,\n    pub spawn: Vec3,\n    pub next_pack: u32,\n    pub time: f32,\n6:use pav_core::games::{GAMES, Outcome};\n14:pub fn t_play(s: &mut Session, a: &Args) -> Result<Output> {\n16:    let Some(key) = s.sim.play().map(|g| g.key()) else {\n39:                not_won.push(json!({ \"seed\": seed, \"status\": sim.play().map(|g| g.status(&sim)) }));\n57:    let g = s.sim.play().expect(\"the game is still running\");\n# Playable characters: who you can be, how each looks and moves, and what a new hero of theirs\n# starts with. They stand on pedestals in Emberwatch's Hall of Heroes (south side of the square),\n# each performing a showreel; use a pedestal to play as them. Every character is a hero of their\n# own (level, gear, passives, waypoints) and waits in the hall while another is played; the stash\n# is shared. Check with `turntable character=KEY`, `animsheet character=KEY skill=slash swing=2`,\n# `hero character=KEY` and `game_reload`.\n#\n# Fields:\n#   name, title, about   \"Kestrel\", \"the Brawler\", a line for the hall's card\n#   order                hall order (the first is who a new game starts as)\n#   weapon, gear         starting weapon and other worn items (game/items.toml base keys; worn\n#                        items colour the look, so leave out what the look should show itself)\n#   bar                  the six skills of a new hero's bar (left, right, Q, E, R, F)\n#   deaths               captured falls they die with, in turn (anim/*.json clips)\n#   level_up, triumph    upper-body gestures for a level gained and a boss felled\n#   showreel             what they perform on their pedestal, in turn: skill keys (every swing\n#                        of the combo, as they strike it), move names (anim/moves.toml) or clips\n#   [KEY.look]           puppet settings over the default biped (any `turntable def=` field); no\n#                        look = the scene's own puppet. The animation kit lives here:\n#     idle_clip, walk_clip, run_clip   captured standing, walking and running (bipeds)\n#     attack_clips       skill -> captured attack, or a list: one per swing of its combo\n#     attack_moves       skill -> a move of anim/moves.toml in place of the skill's own, or a list\n#     dodge_clip         a captured dodge in place of the procedural tumble\n\n# ---------------------------------------------------------------------------------- Wanderer\n# The original hero: the engine's procedural animation (every swing an arc around the\n# shoulders, legs that stride the way the body travels, a tumbling dodge roll).\n[wanderer]\nname = \"Wanderer\"\ntitle = \"the Sellsword\"\nabout = \"A sword for hire who learned a little of everything: blade, fire and frost. Moves with the engine's own procedural animation.\"\norder = 1\nweapon = \"rusted_sword\"\nbar = [\"slash\", \"fireball\", \"cleave\", \"leap_slam\", \"frost_nova\", \"blade_dash\"]\ndeaths = [\"QUATERNIUS/Death01\", \"MESH2MOTION/Death_D\", \"MESH2MOTION/Death_C\", \"CMU/Fall_On_Face\", \"MESH2MOTION/Death_A\"]\nlevel_up = \"MESH2MOTION/Cheer_One_arm\"\ntriumph = \"MESH2MOTION/Cheering_Two_Hands\"\nshowreel = [\"slash\", \"cleave\", \"leap_slam\", \"fireball\", \"whirlwind\", \"earthsplitter\"]\n\n# ----------------------------------------------------------------------------------- Kestrel\n# Fists and feet in captured boxing and karate: a boxer's guard (CMU), a swaggering strut\n# (100STYLE), a sprint, a jab-cross-roundhouse combo, a two-handed chi blast, a ground pound; the\n# procedural fist and kick moves for the rest (leg sweep, axe kick, flying kick, uppercut,\n# haymaker); a captured shoulder roll for a dodge.\n[kestrel]\nname = \"Kestrel\"\ntitle = \"the Brawler\"\nabout = \"A pit fighter from the river docks who never needed a blade: wrapped fists, iron hooks for the mean nights, and a mohawk you can see across the square.\"\norder = 2\nweapon = \"hooks\"\nbar = [\"slash\", \"cleave\", \"leap_slam\", \"blade_dash\", \"war_cry\", \"earthsplitter\"]\ndeaths = [\"CMU/Fall_On_Face\", \"MESH2MOTION/Death_B\", \"QUATERNIUS/Death01\"]\nlevel_up = \"MESH2MOTION/Victory Fist Pump\"\ntriumph = \"MESH2MOTION/Victory\"\nshowreel = [\"slash\", \"cleave\", \"blade_dash\", \"fireball\", \"leap_slam\", \"CMU/Jump_Kick\", \"earthsplitter\", \"war_cry\", \"MESH2MOTION/Backflip\"]\n\n[kestrel.look]\nscale = 0.96\nhead_radius = 0.2\ntorso_length = 0.4\n# Shardfall skills. Hero skills and monster attacks share one format, so any monster can be\n# given any skill (procedural monsters cast Fireball too).\n#\n# behavior   melee | slam | leap | dash | projectile | nova | charge | channel | wave | buff |\n#            meteor | field | blink | rain\n# anim       slash | overhead | thrust | spin | cast | throw | roar | leap | lunge\n# tags       attack / spell, melee, projectile, area, movement, + an element; damage bonuses\n#            apply by tag (\"increased Melee Damage\", \"increased Spell Damage\", ...)\n# time       seconds per use (attacks: at 1 attack per second; faster weapons and attack speed\n#            shorten it; spells: cast speed)\n# hit        when the hit lands, as a fraction of `time`\n# effect     attacks: damage as a multiple of weapon (or monster) damage; spells: the\n#            multiple a monster casting it deals (the hero's spells use `base`)\n# base       spells: damage range at hero level 1 (grows with level)\n# element    physical | fire | cold | lightning | poison\n# range      melee reach / dash or leap distance / projectile range / AI trigger distance (m)\n# angle      melee arc (degrees); radius: area (m); speed: projectile speed (m/s)\n# ailment    base chance of the element's ailment (bleed, ignite, freeze, shock, poison)\n# telegraph  monsters show a warning on the ground while winding up\n# mana_gain  mana gained per enemy hit (basic attacks)\n# duration   fields, buffs, monster channels (s); interval: channel pulse (s)\n# chain      projectiles: extra enemies to chain to; count: projectiles / wave segments / drops\n# delay      meteor fall time (s); scatter: rain area (m); buff: stats while a war cry lasts\n\n# ------------------------------------------------------------------------------ hero\n[slash]\nname = \"Slash\"\nabout = \"Quick three-swing combo. The third swing reaches wider and knocks enemies back. Restores mana on hit.\"\ntags = [\"attack\", \"melee\", \"area\"]\nbehavior = \"melee\"\nanim = \"slash\"\nunlock = 1\ntime = 0.55\nhit = 0.42\neffect = 1.0\nrange = 2.6\nangle = 150\ncombo = 3\nknockback = 1.4\nmana_gain = 3\nhitstop = 0.03\ncolor = \"#e8eef5\"\n\n[cleave]\nname = \"Cleave\"\nabout = \"A heavy two-handed sweep through everything in front of you.\"\ntags = [\"attack\", \"melee\", \"area\"]\nbehavior = \"melee\"\nanim = \"slash\"\nunlock = 1\ncost = 8\ntime = 0.8\nhit = 0.5\neffect = 1.9\nrange = 3.4\nangle = 210\nknockback = 3.0\nhitstop = 0.07\nshake = 0.25\ncolor = \"#ffd27a\"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Jr3hPcfLuUcgBRutU6Yasu","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
