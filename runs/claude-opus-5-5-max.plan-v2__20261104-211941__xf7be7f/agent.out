s = 25 } }, { name = \"Cold Snap\", tweaks = { cooldown = 30 } }, { name = \"Shatter\", tweaks = { damage = 40 } }]\n//! Powers: rule-bending effects carried by unique items (and later passive keystones and\n//! monster affixes). Any actor can have them, so a monster wearing \"corpse burst\" works the\n//! same as the hero. Each power is a kind and two numbers `a` and `b` (see game/uniques.toml\n//! for what they mean); the hooks below are called from combat at the moments they act.\n\nuse glam::Vec3;\nuse serde::{Deserialize, Serialize};\n\nuse super::combat::*;\nuse super::data::{Behavior, SkillDef, data};\nuse super::stats::{Mods, Stat};\nuse super::{Game, feet_of, flat};\nuse crate::entity::EntityId;\nuse crate::frame::SimEvent;\nuse crate::sim::Sim;\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum PowerKind {\n    #[default]\n    CorpseBurst,\n    FrostCrits,\n    BloodMagic,\n    Execute,\n    FireTrail,\n    OrbitBlades,\n    EchoStrike,\n    DodgeReset,\n    StormCall,\n    BlockNova,\n    IgniteAura,\n    StandFirm,\n    MeteorSlam,\n    Frenzy,\n    ManaShield,\n    Quickening,\n    /// All damage becomes element `a` (1 fire, 2 cold, 3 lightning, 4 poison).\n    Convert,\n    /// On death: bursts for a% of its life (radius b m) after a short warning.\n    DeathBurst,\n    /// Calls a brood of a creatures every b seconds while fighting.\n    Summon,\n    /// Below a% life: b% more damage and faster attacks.\n    Enrage,\n}\n# Shardfall unique items: a fixed name and base, fixed stat ranges (scaled to the item level\n# like everything else) and often a power - a rule-bending effect. Powers are shared with the\n# passive tree's keystones and monster affixes: one set of effects, many sources.\n#\n# base      an item base from items.toml (slot and look come from it)\n# level     the lowest item level it can drop at\n# mods      stat = [min, max] (flat stats grow with item level; percentages do not)\n# power     kind and its two numbers `a` and `b` (see the list below)\n# lore      flavour text\n#\n# Powers:\n#   corpse_burst    a% chance on kill: the corpse explodes for b% of its life as fire (3 m)\n#   frost_crits     critical strikes always freeze; a% more crit damage against frozen enemies\n#   blood_magic     skills cost life instead of mana; a% of mana is added as life\n#   execute         hits finish off non-boss enemies below a% life\n#   fire_trail      dodging leaves burning ground for a s that burns for b% of weapon damage/s\n#   orbit_blades    a spectral blades circle you, each hit deals b% of weapon damage\n#   echo_strike     melee skills strike again a moment later for a% damage\n#   dodge_reset     kills have a% chance to reset the dodge\n#   storm_call      spells call lightning on a enemies near the target for b% of the spell\n#   block_nova      blocking releases a frost nova (radius a m) for b% of weapon damage\n#   ignite_aura     enemies within a m burn for b% of your maximum life per second\n#   stand_firm      cannot be knocked back or stunned; a% less damage taken while casting\n#   meteor_slam     slams and leaps call a meteor onto the impact for a% damage\n#   frenzy          kills grant a% attack and movement speed for 4 s (stacks 3 times)\n#   mana_shield     a% of damage taken is paid from mana first\n#   quickening      kills take a s off every skill cooldown\n\n[corpsefire_grips]\nname = \"Corpsefire Grips\"","is_error":false}]},"parent_tool_use_id":null,"session_id":"33b9a197-b2fe-42e5-9a43-b32ae2dde858","uuid":"ced0c101-71d5-4429-a31f-0566e4d446f2","timestamp":"2026-11-05T04:38:31.209Z","tool_use_result":{"stdout":"pav_core/src/arpg/boss.rs            lines=  399 hero_id=  0 g.hero=  0 player=  0\npav_core/src/arpg/bot.rs             lines=  499 hero_id=  1 g.hero= 20 player=  0\npav_core/src/arpg/brain.rs           lines=  156 hero_id=  0 g.hero=  0 player=  0\npav_core/src/arpg/cmd.rs