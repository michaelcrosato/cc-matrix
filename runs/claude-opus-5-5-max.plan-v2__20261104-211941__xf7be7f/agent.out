{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D2cyqXkAseANRE3XriukRy","type":"tool_result","content":"234:struct Clock {\n235-    next: Instant,\n236-    window_start: Instant,\n237-    window_ticks: u32,\n238-    busy: Duration,\n239-    rewound: bool,\n240-    studio_mode: pav_core::prop_preview::StudioMode,\n241-}\n242-\n243-impl Clock {\n244-    fn new() -> Self {\n245-        Self {\n246-            next: Instant::now(),\n247-            window_start: Instant::now(),\n248-            window_ticks: 0,\n249-            busy: Duration::ZERO,\n250-            rewound: false,\n251-            studio_mode: pav_core::prop_preview::StudioMode::World,\n252-        }\n253-    }\n254-\n255-    /// Runs whatever is due now; returns how long until the next tick.\n256-    fn advance(&mut self, sim: &mut Sim, sh: &Shared) -> Duration {\n257-        let previewing = sim.studio_active();\n258-        let mode = sim.studio_mode();\n259-        if self.studio_mode != mode {\n260-            self.studio_mode = mode;\n261-            self.next = Instant::now();\n262-        }\n263-        let ctl = *sh.control.lock().unwrap();\n264-        // The animation stage has its own play, pause and speed controls. The world's time\n265-        // controls stay untouched, including a paused or rewound game behind the stage.\n266-        let tick_wall = if previewing { sim.dt() } else { sim.dt() / ctl.speed.clamp(0.01, 16.0) };\n267-        let (busy, window_ticks) = (&mut self.busy, &mut self.window_ticks);\n268-        let mut tick_once = |sim: &mut Sim, at: Instant| {\n269-            let input = if previewing {\n270-                InputFrame::default()\n271-            } else {\n272-                let mut i = sh.input.lock().unwrap();\n273-                let mut frame = *i;\n274-                i.pressed = 0;\n//! Graphics quality: how much of the screen's resolution the scene is drawn at and which costly\n//! effects run. Auto is High on a desktop (everything, as the game always drew) and Medium on a\n//! phone or tablet, where the resolution also follows the frame rate (dynamic resolution) and\n//! materials draw their first layer only (plan D7).\n\nuse pav_view::materials::MaterialDetail;\nuse serde::{Deserialize, Serialize};\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum Quality {\n    #[default]\n    Auto,\n    Low,\n    Medium,\n    High,\n}\n\nimpl Quality {\n    pub const ALL: [Quality; 4] = [Quality::Auto, Quality::Low, Quality::Medium, Quality::High];\n\n    pub fn name(self) -> &'static str {\n        match self {\n            Quality::Auto => \"Auto\",\n            Quality::Low => \"Low\",\n            Quality::Medium => \"Medium\",\n            Quality::High => \"High\",\n        }\n    }\n\n    /// What Auto means on this device.\n    fn resolve(self, touch: bool) -> Quality {\n        match self {\n            Quality::Auto if touch => Quality::Medium,\n            Quality::Auto => Quality::High,\n            q => q,\n        }\n    }\n\n    /// Turns off what this quality cannot afford (on top of the scene's and the look's own\n    /// settings).\n    pub fn trim(self, touch: bool, v: &mut pav_view::ViewSettings) {\n        match self.resolve(touch) {\n            Quality::High | Quality::Auto => {}\n            Quality::Medium => {\n                v.gi = 0.0;\n                v.shafts = 0.0;\n                v.material_detail = v.material_detail.min(MaterialDetail::FirstLayer);\n            }\n            Quality::Low => {\n                v.material_detail = v.material_detail.min(MaterialDetail::FirstLayer);\n                v.gi = 0.0;\n                v.shafts = 0.0;\n                v.haze = 0.0;\n                v.halos = 0.0;\n                v.bloom = 0.0;\n                v.distortion = false;\n            }\n        }\n    }\n}\n27:    fn default() -> Self {\n33:    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n60:    pub fn lerp(&self, o: &Came