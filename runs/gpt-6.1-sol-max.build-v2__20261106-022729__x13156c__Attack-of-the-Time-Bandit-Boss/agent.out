{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"head -12 vendor/engine/my-3d2dge.js && tail -8 vendor/engine/my-3d2dge.js && sed -n '3045,3083p' vendor/engine/my-3d2dge.js && sed -n '9695,9725p' vendor/engine/my-3d2dge.js && sed -n '7750,7810p' vendor/engine/my-3d2dge.js\"","aggregated_output":"/*!\n * my-3D2dge v0.89.1  (My \"3D\" 2D Game Engine)\n * Procedural pixel-puppet engine for every 2D perspective.\n * https://github.com/michaelcrosato/my-3d2dge  (MIT License)\n *\n * READ THIS FIRST (humans and AI models extending a my-3D2dge game)\n * -----------------------------------------------------------------------------\n * 0. EVERY GAME STARTS WITH  const E = My3D2dge;  and then uses E.Game, E.px, ...\n * 1. WORLD SPACE IS 3D. x = east, y = south, z = up. One floor tile = 16 units.\n *    Game logic never thinks about screen pixels.\n * 2. A VIEW turns world points into screen pixels. Swap the view and the whole game\n *    re-renders from another angle: E.VIEWS.iso, .threequarter, .topdown,\n      const base = up ? P.t : rim ? P.e : P.c, l = up === 1 ? 24 : 0;\n      D[o] = Math.max(0, Math.min(255, base[0] + n + l)); D[o + 1] = Math.max(0, Math.min(255, base[1] + n + l)); D[o + 2] = Math.max(0, Math.min(255, base[2] + n * .7 + l)); D[o + 3] = 255;\n    }\n    g.putImageData(img, 0, 0); return cv;\n  }\n}\nE.Terrain = Terrain;\n})(typeof My3D2dge !== 'undefined' ? My3D2dge : undefined);\nconst STANDARD_SETTINGS = {\n  fullscreen: { group: 'Display', label: 'Full screen', type: 'fullscreen', value: null },   // the player's choice: true, false (turned it off), null (never chose)\n  zoom: { group: 'Display', label: 'Camera zoom', type: 'slider', value: 1, min: ZOOM_PLAYER[0], max: ZOOM_PLAYER[1], step: .05, unit: '×', help: 'Closer or farther than the game frames it. In play: the mouse wheel, - and =, or a pinch', apply: g => g._zoomApply(false, true) },\n  frameRate: { group: 'Display', label: 'Frame rate', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['60', '60'], ['full', 'Full']], help: 'Auto: every refresh while the game keeps up, every other one, evenly, when it can\\'t. 60: every other refresh on a 120 Hz screen. Full: every refresh' },\n  showFps: { group: 'Display', label: 'Show frame rate', type: 'toggle', value: false, help: 'At the top of the screen: frames drawn a second, the screen\\'s refresh and a frame\\'s cost' },\n  scale: { group: 'Display', label: 'Pixel scaling', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['sharp', 'Sharp'], ['fill', 'Fill']], help: 'Sharp: every pixel the same size. Fill: the whole screen', apply: (g, v) => g.screen.setScale(v) },\n  filter: { group: 'Display', label: 'Screen filter', type: 'select', value: 'clean', options: [['clean', 'Clean'], ['scanlines', 'Scanlines'], ['crt', 'CRT']], help: 'Scanlines: the dark lines between a TV\\'s rows. CRT: those, its colored stripes and its darker corners', apply: (g, v) => { g.screen.filter = v; } },\n  sound: { group: 'Sound', label: 'Sound', type: 'toggle', value: true, apply: (g, v) => g.audio.mute(!v) },\n  volume: { group: 'Sound', label: 'Volume', type: 'slider', value: .7, apply: (g, v) => g.audio.setVolume(v) },\n  music: { group: 'Sound', label: 'Music', type: 'slider', value: .5, apply: (g, v) => { g.audio.musicVolume = v; g.audio.applyVolume(); } },\n  effects: { group: 'Sound', label: 'Effects', type: 'slider', value: 1, apply: (g, v) => { g.audio.sfxVolume = v; g.audio.applyVolume(); } },\n  background: { group: 'Sound', label: 'Sound in the background', type: 'toggle', value: false, help: 'Keep playing sound while the page is hidden' },\n  audioOffset: { group: 'Sound', label: 'Audio offset', type: 'slider', value: 0, min: -100, max: 300, step: 5, unit: ' ms', calibrate: true, help: 'The music this much earlier, for speakers or headphones that lag (wireless ones: 150 to 250). Calibrate: tap on the clicks you hear', apply: (g, v) => { g.audio.offset = v / 1000; } },\n  motion: { group: 'Comfort', label: 'Reduce motion', type: 'toggle', value: g => !!g.reduceMotion, help: 'No screen shake, shorter flashes, still menus', apply: (g, v) => { g.reduceMotion = !!v; } },\n  shake: { group: 'Comfort', label: 'Screen shake', type: 'slider', value: 1 },\n  flashes: { group: 'Comfort', label: 'Screen flashes', type: 'slider', value: 1 },\n  bindings: { group: 'Controls', type: 'bindings', value: () => ({}), apply: (g, v) => { g.input.bindings = v; } },\n  deadzone: { group: 'Controller', label: 'Stick dead zone', type: 'slider', value: .18, min: .05, max: .5, step: .01, apply: (g, v) => { for (const q of g._players || [g.input]) q.deadzone = v; } },\n  invertY: { group: 'Controller', label: 'Invert aim up and down', type: 'toggle', value: false, apply: (g, v) => { for (const q of g._players || [g.input]) q.invertAimY = !!v; } },\n  invertMoveX: { group: 'Controller', label: 'Invert move left and right', type: 'toggle', value: false, apply: (g, v) => { for (const q of g._players || [g.input]) q.invertMoveX = !!v; } },\n  invertMoveY: { group: 'Controller', label: 'Invert move up and down', type: 'toggle', value: false, apply: (g, v) => { for (const q of g._players || [g.input]) q.invertMoveY = !!v; } },\n  glyphs: { group: 'Controller', label: 'Button symbols', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['xbox', 'Xbox'], ['playstation', 'PlayStation'], ['nintendo', 'Nintendo'], ['generic', 'Positions']], apply: (g, v) => { for (const q of g._players || [g.input]) q.glyphs = v; } },\n  rumble: { group: 'Controller', label: 'Vibration', type: 'slider', value: .6, apply: (g, v) => { for (const q of g._players || [g.input]) q.rumbleScale = v; } },\n  touch: { group: 'Touch', label: 'Touch buttons', type: 'select', value: 'auto', options: [['auto', 'Automatic'], ['on', 'Always'], ['off', 'Hidden']], apply: g => g.input._touchSync() },\n  hand: { group: 'Touch', label: 'Buttons on', type: 'select', value: 'right', options: [['right', 'Right'], ['left', 'Left']], apply: g => g.input._touchSync() },\n  touchSize: { group: 'Touch', label: 'Button size', type: 'slider', value: 62, min: 44, max: 88, step: 2, unit: ' px', apply: g => g.input._touchSync() },\n  touchOpacity: { group: 'Touch', label: 'Button opacity', type: 'slider', value: .8, min: .3, max: 1, step: .05, apply: g => g.input._touchSync() }\n};\n/** a value for a setting, checked: the value kept, or undefined when it can't be one */\nfunction settingValue(sp, v) {\n  if (sp.type === 'toggle') return typeof v === 'boolean' ? v : undefined;\n  if (sp.type === 'fullscreen') return v === true || v === false || v === null ? v : undefined;\n  if (sp.type === 'slider') return typeof v === 'number' && isFinite(v) ? clamp(v, sp.min === undefined ? 0 : sp.min, sp.max === undefined ? 1 : sp.max) : undefined;\n  if (sp.type === 'select') return (sp.options || []).some(o => (Array.isArray(o) ? o[0] : o) === v) ? v : undefined;\n  if (sp.type === 'bindings') {\n    if (!v || typeof v !== 'object' || Array.isArray(v)) return undefined;\n    const out = {};\n    for (const a in v) { const b = v[a]; if (!b || typeof b !== 'object') continue; const o = {}; for (const k of ['keys', 'pad']) if (Array.isArray(b[k])) o[k] = b[k].filter(c => typeof c === 'string' && BINDABLE.test(c) && padCode(c) === (k === 'pad')).slice(0, 4); out[a] = o; }\n    return out;\n    return e;\n  }\n  /** the audio offset's calibration screen: clicks on the beat, a Tap button (or Space) on each one heard; after eight\n   *  the offset found, kept with Keep it */\n  _calibrate(key) {\n    const K = this._game.audio.calibrate(), close = () => { K.stop(); this.back(); };\n    this.show('calibrate', { kicker: 'Sound', title: 'Audio offset', back: close,\n      text: () => K.done ? 'Your sound comes ' + K.result + ' ms after the beat. Keep it, or tap on to measure again.' : 'Tap on each click you hear, in time with it, not before (' + K.taps + ' of 8). The higher click starts each bar.',\n      actions: () => [{ label: 'Tap', primary: true, down: t => { K.tap(t); this.show('calibrate', {}); } }, { label: 'Keep it', disabled: !K.done, fn: () => { this._game.settings.set(key, K.result); close(); } }, ['Cancel', close]] });\n  }\n  /** build the open screen */\n  _render() {\n    if (!this.root) return;\n    const scr = this._els.scr, top = this._stack[this._stack.length - 1];\n    if (!top) { scr.replaceChildren(); return; }\n    for (const k of ['hb', 'obj', 'vit', 'place', 'tip', 'pr', 'keys', 'mini']) { this._els[k].hidden = true; this._last[k] = null; }   // the HUD hides under a screen (a paused game calls no hud())\n    const { name, s } = top, v = x => typeof x === 'function' ? x() : x, title = name === 'title';\n    const sh = this._el('div', 'esh-sh' + (title ? ' esh-ttl' : '')), box = this._el('div', title ? '' : 'esh-pan esh-mod' + (name === 'map' ? ' esh-wide' : ''));\n    sh.appendChild(box); sh.setAttribute('role', 'dialog'); sh.setAttribute('aria-label', v(s.title || s.name) || name);\n    const add = (...c) => box.append(...c.filter(Boolean));\n    add(s.emblem && this._el('div', 'esh-emb', s.emblem), s.kicker && this._el('div', 'esh-k', v(s.kicker)));\n    if (title) add(this._el('h1', '', v(s.name || s.title)), s.subtitle && this._el('div', 'esh-sub', v(s.subtitle)));\n    else add(this._el('h2', '', v(s.title) || { pause: this._game._players && this._game._players.length > 1 && this._game.pausedBy ? 'Paused by P' + this._game.pausedBy : 'Paused', settings: 'Settings', controls: 'Controls', help: 'Help', map: 'Map' }[name] || ''));   // (several players: who paused)\n    add(v(s.text) && this._el('p', title ? '' : 'esh-m', v(s.text)));\n    for (const key of v(s.rows) || []) add(key[0] === '#' ? this._el('div', 'esh-k esh-sec', key.slice(1)) : this._row(key));   // (setting rows on a screen of the game's own: '#' a heading)\n    if (name === 'settings') this._settingsRows(add);\n    if (name === 'controls') this._controls(add);\n    if (s.keys) { const g = this._el('div', 'esh-grid'); for (const [k, w] of v(s.keys)) g.append(this._el('kbd', '', k), this._el('span', '', w)); add(g); }\n    for (const [h, t] of v(s.sections) || []) add(this._el('div', 'esh-k esh-sec', h), this._el('p', 'esh-m', t));\n    if (s.stats) { const g = this._el('div', 'esh-stats'); for (const [val, lab] of v(s.stats)) { const c = this._el('div'); c.append(this._el('b', '', val), this._el('small', '', lab)); g.appendChild(c); } add(g); }\n    if (s.medals) { const g = this._el('div'); for (const [lab, got] of v(s.medals)) g.appendChild(this._el('span', 'esh-med' + (got ? '' : ' off'), (got ? '✓ ' : '') + lab)); add(g); }\n     *  is heard against the game's clock at the last frame (seconds: the sound follows the clock, so it stays near 0);\n     *  anchors: how many times the sound was moved to meet the clock */\n    this.offset = 0; this.drift = 0; this.anchors = 0; this._ats = []; this._beats = []; this._fading = []; this._stings = []; this._fr = null; this._timer = null;\n    // sound draws its own random numbers (noise, pitch variation): whether sound is on, muted or not yet unlocked by a tap\n    // never shifts the game's Math.random, so the same seed and inputs play the same game with or without it\n    this._rnd = rng(0x51A7E);\n  }\n  _init() {\n    if (this.ctx || this.failed) return this.ctx;\n    try {\n      const AC = window.AudioContext || window.webkitAudioContext; if (!AC) throw new Error('Web Audio is not available');\n      const c = this.ctx = new AC();\n      this._master = c.createGain(); this._master.connect(c.destination);\n      this._sfxBus = c.createGain(); this._sfxBus.connect(this._master);\n      this._musBus = c.createGain(); this._musBus.connect(this._master);\n      this._voiceBus = c.createGain(); this._voiceBus.connect(this._master);   // (bus('voice'): a game's babble or speech)\n      this.applyVolume();\n      const nb = c.createBuffer(1, c.sampleRate, c.sampleRate), d = nb.getChannelData(0); for (let i = 0; i < d.length; i++) d[i] = this._rnd() * 2 - 1;\n      this._noise = nb;\n      const resume = () => { if (c.state !== 'running') c.resume().catch(() => {}); };\n      for (const ev of ['pointerdown', 'keydown', 'touchstart']) addEventListener(ev, resume, { capture: true, signal: this._signal });\n      resume();\n    } catch (e) { this.failed = e.message || String(e); warn('audio', 'sound is off: ' + this.failed); }\n    return this.ctx;\n  }\n  /** true once the browser lets the game make sound */\n  get ready() { return !!this.ctx && this.ctx.state === 'running'; }\n  /** apply volume, musicVolume, sfxVolume and mute after setting them directly (setVolume and mute call it) */\n  applyVolume() { if (!this.ctx) return; this._master.gain.value = this.muted ? 0 : this.volume; this._sfxBus.gain.value = this.sfxVolume; this._musBus.gain.value = this.musicVolume * (this._ducked || this.ducked ? .35 : 1); this._voiceBus.gain.value = this.voiceVolume; }\n  /** a bus for a sound of the game's own (Web Audio nodes it makes on audio.ctx: a babble voice, a loop, an instrument)\n   *  to connect to, so it follows the volume, the mute and the player's settings: 'sfx', 'music', 'voice' (its level is\n   *  voiceVolume) or 'master'. Returns a GainNode, or null where there is no sound (headless, no Web Audio) */\n  bus(name = 'sfx') {\n    if (!['sfx', 'music', 'voice', 'master'].includes(name)) warn('bus:' + name, 'audio.bus(\"' + name + '\"): no such bus (sfx, music, voice, master): the sfx bus');\n    if (this._game.headless || !this._init()) return null;\n    return name === 'master' ? this._master : name === 'music' ? this._musBus : name === 'voice' ? this._voiceBus : this._sfxBus;\n  }\n  /** set the master volume, 0..1 */\n  setVolume(v) { this.volume = clamp(v, 0, 1); this.applyVolume(); }\n  /** toggle (or set) mute; returns the new state */\n  mute(on = !this.muted) { this.muted = on; this.applyVolume(); return on; }\n  /** the page is hidden (sleep true) or back: the sound sleeps with it unless the player keeps it on (settings.background) */\n  _background(sleep) { const c = this.ctx; if (!c) return; try { if (sleep && c.state === 'running') { this._slept = true; c.suspend().catch(() => {}); } else if (!sleep && this._slept) { this._slept = false; c.resume().catch(() => {}); } } catch (e) { /* closed */ } }\n  /** quiet the music (to 35%) while on: under a game's own pause, map or dialog screen. The engine also ducks it while game.paused */\n  duck(on = true) { on = !!on; if (this.ducked === on) return; this.ducked = on; this.applyVolume(); }\n  _duck(on) { if (this._ducked === on) return; this._ducked = on; this.applyVolume(); }   // (the engine's own: game.paused)\n  _pulse(duty) {\n    if (this._waves[duty]) return this._waves[duty];\n    const N = 40, re = new Float32Array(N), im = new Float32Array(N);\n    for (let n = 1; n < N; n++) { const a = 2 / (n * Math.PI) * Math.sin(n * Math.PI * duty); re[n] = a * Math.cos(n * Math.PI * duty); im[n] = a * Math.sin(n * Math.PI * duty); }\n    return (this._waves[duty] = this.ctx.createPeriodicWave(re, im));\n  }\n  // one voice at t0 into bus: its sources (a looped one sounds on, at its volume, until they are stopped)\n  _voice(p, bus, t0, mul = 1, loop = false) {\n    const c = this.ctx, wave = p.wave || 'square', dur = Math.max(.012, p.dur || .15), vol = p.vol === undefined ? .3 : p.vol, att = p.attack === undefined ? .004 : p.attack;\n    const t = t0 + (p.delay || 0), end = t + dur, f0 = Math.max(20, noteFreq(p.freq || 440) * mul), to = p.to ? Math.max(20, noteFreq(p.to) * mul) : 0;\n    const ins = this._ins && this._ins[wave]; if (ins) { ins(c, bus, t, f0, dur, vol); return []; }   // (an instrument of the game's own)\n    const g = c.createGain(); g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(vol, t + att);\n    if (loop) g.gain.setValueAtTime(vol, t + att);   // (held at its volume until stopped)\n    else if (p.hold) { g.gain.setValueAtTime(vol, Math.max(t + att, end - .03)); g.gain.linearRampToValueAtTime(0, end); }\n    else g.gain.exponentialRampToValueAtTime(.0005, end);\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_29","type":"agent_message","text":"The engine and Hub revisions are vendored, and the Hub protocol is confirmed. I’m now building the simulation, campaign data, and renderer separately so solo, hosted play, attract mode, and tests can all use the same game rules."}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"cat > package.json <<'EOF'\n{\\\"name\\\":\\\"time-bandit-boss\\\",\\\"version\\\":\\\"1.0.0\\\",\\\"private\\\":true,\\\"type\\\":\\\"module\\\",\\\"scripts\\\":{\\\"build\\\":\\\"node tools/build.mjs\\\",\\\"test\\\":\\\"node tools/test.mjs\\\"}}\nEOF\ncat > src/content/campaign.js <<'EOF'\nexport const TITLE = 'Attack of the Time Bandit Boss';\nexport const ARENA = Object.freeze({ w:640, h:360, left:38, right:602, lane:304 });\nexport const DEFAULTS = Object.freeze({ playerSpeed:220, fireInterval:.13, missileSpeed:76, mineTurn:1.05, rollerSpeed:64, prediction:.72, enemyInterval:2.5, brakeDuration:1.6, slowFactor:.35, chargeGain:1, shotSpeed:760 });\nexport const TUNING = [\n ['playerSpeed','Machine speed',120,360,10,' u/s'], ['fireInterval','Cannon rearm',.07,.4,.01,' s'],\n ['missileSpeed','Dart speed',35,150,5,' u/s'], ['mineTurn','Seeker turn',.25,2.5,.05,' rad/s'],\n ['rollerSpeed','Ground sweep speed',25,110,5,' u/s'], ['prediction','Hunter prediction',.2,1.4,.05,' s'],\n ['enemyInterval','Attack interval',1,5,.1,' s'], ['brakeDuration','Brake duration',.8,3,.1,' s'],\n ['slowFactor','Hostile time factor',.2,.7,.05,' ×'], ['chargeGain','Charge multiplier',.5,2,.1,' ×']\n];\nexport const WEAPONS = Object.freeze({ dart:{score:2,charge:10,r:5,color:'#e9f5ff',name:'Falling dart'}, mine:{score:4,charge:15,r:8,color:'#ff647e',name:'Antimatter seeker'}, roller:{score:8,charge:20,r:8,color:'#b6ff72',name:'Annihilator'}, hunter:{score:16,charge:24,r:8,color:'#ffd674',name:'Time Killer'} });\nexport const ROUTES = [\n [[320,65],[455,98],[532,151],[405,202],[212,176],[118,112],[242,109]],\n [[320,65],[182,97],[103,151],[229,203],[420,177],[520,112],[400,109]],\n [[320,62],[470,90],[495,180],[325,216],[149,161],[177,91],[300,131]]\n];\n// Declarative authored waves. Spawn times, routes, composition, tells and narration live here.\nexport const WAVES = [\n { name:'Borrowed seconds', ships:18, hp:2, routes:[0], speed:29, interval:1.5, mix:['dart'], cue:'SLIDE. HOLD FIRE. SHOOT THE DARTS.', line:'Your century is overdue. I have come to collect\"'!'\"', color:'#66e5f2', hints:[ [12,'Intercept weapons to charge the time brake.'] ] },\n { name:'Interest in red', ships:20, hp:2, routes:[1,0], speed:32, interval:1.38, mix:['dart','mine','dart'], cue:'SEEKERS TURN SLOWLY. BAIT THE CURVE.', line:'I ordered obedient mines. Apparently they take suggestions.', color:'#ff7c99', hints:[ [16,'A full meter buys a moment. Press BRAKE when ready.'] ] },\n { name:'Cross purposes', ships:22, hp:2, routes:[2,1], speed:34, interval:1.28, mix:['dart','mine','roller','dart'], cue:'BREAK THE CROSS BEFORE IT LANDS.', line:'Mind the floor. It is now aggressively rented.', color:'#b6ff72', hints:[ [8,'Grounded crosses cannot be shot. Escape their marked sweep.'],[24,'Time brake slows weapons. Your cannon stays quick.'] ] },\n { name:'Bad predictions', ships:24, hp:2, routes:[0,1], speed:36, interval:1.2, mix:['dart','hunter','mine','roller','dart'], cue:'DIAMOND MARKS YOUR FUTURE. CHANGE IT.', line:'My diamonds predict everything. Except insubordination.', color:'#ffd674', hints:[ [12,'The diamond commits after its aim mark. Change direction.'] ] },\n { name:'Compound chaos', ships:26, hp:3, routes:[1,0,2], speed:38, interval:1.14, mix:['mine','dart','hunter','dart','roller','mine'], cue:'MAKE A GAP. THEN TAKE THE SHOT.', line:'You are a very expensive rounding error.', color:'#ac99ff', hints:[] },\n { name:'The floor is late', ships:28, hp:3, routes:[2,1,0], speed:39, interval:1.08, mix:['roller','dart','dart','mine','hunter','dart'], cue:'READ THE SWEEP. KEEP AN EXIT.', line:'Stop moving\"'! My accountant cannot aim.'\"', color:'#b6ff72', hints:[] },\n { name:'Split second', ships:30, hp:3, routes:[0,1,2], speed:41, interval:1.03, mix:['hunter','mine','dart','roller','dart','mine'], cue:'COVER THE SKY. SHARE THE BRAKE.', line:'One timeline. Several pests. Entirely unfair.', color:'#ffb47b', hints:[] },\n { name:'The final invoice', ships:32, hp:3, routes:[2,0,1], speed:43, interval:1, mix:['dart','mine','hunter','roller','mine','dart','hunter'], cue:'EVERY SECOND YOU STOLE IS YOURS.', line:'Fine\"'! I shall handle this disgrace personally!'\"', color:'#69e7f5', hints:[] }\n].map((w,i)=>Object.freeze({...w,index:i, firstAttack:4.8, spacing:.18, warning:.72, groupSize:8}));\nexport const BOSS_PHASES = [\n { name:'The collector', hp:34, open:5, closed:2.6, interval:1.35, mix:['dart','mine','dart'], color:'#69e7f5', line:'Behold my flawless face\"'! Kindly miss it.'\"' },\n { name:'Hostile takeover', hp:42, open:4.5, closed:2.8, interval:1.15, mix:['roller','mine','hunter','dart'], color:'#ff7b9a', line:'That was my good side. Both sides are my good side\"'!'\"' },\n { name:'Overtime', hp:48, open:4, closed:2.5, interval:1, mix:['hunter','dart','mine','roller','dart'], color:'#ffd674', line:'I demand a second opinion\"'! And all your seconds!'\"' }\n];\nexport const QUIPS = { intercept:['That missile was nonrefundable\"'!'\"','Stop editing my perfectly good future.','A lucky shot. Repeatedly.'], brake:['You cannot put a tyrant on hold\"'!'\"','Why is everything taking so loooong?'], hurt:['A small deduction from your existence\"'!'\"','Ah\"'! A punctual explosion.'\"'], clear:['My fleet was on a break. Clearly.','An unacceptable display of competence.','You have my reluctant, temporary respect.'], victory:'You win this time. I shall appeal yesterday\"'!'\"', defeat:'Your time is up. Mine is billable.' };\nexport function validateContent() {\n const errors=[];\n if(WAVES.length\"'!==8||BOSS_PHASES.length!==3)errors.push('\"'Campaign requires eight waves and three finale phases');\n for(const [i,w] of WAVES.entries()){\n  if(w.index\"'!==i||w.ships<1||!w.mix.length||!w.routes.every(r=>ROUTES[r]))errors.push('\"'Invalid wave '+i);\n  if(\"'!w.mix.every(k=>WEAPONS[k]))errors.push('\"'Unknown weapon '+i);\n }\n for(const path of ROUTES)if(path.length<4||\"'!path.every(p=>p.length===2&&p.every(Number.isFinite)))errors.push('\"'Invalid route');\n for(const [k,v]of Object.entries(DEFAULTS))if(\"'!Number.isFinite(v)||v<=0)errors.push('\"'Invalid default '+k);\n return errors;\n}\nEOF\ncat > src/game/simulation.js <<'EOF'\nimport { ARENA, DEFAULTS, WEAPONS, WAVES, BOSS_PHASES, ROUTES, QUIPS } from '../content/campaign.js';\nexport const FIXED_DT=1/120;\nexport const bound=(n,a,b)=>Math.max(a,Math.min(b,n));\nconst qround=n=>Math.round(n*10)/10;\nconst pathCache=new Map();\nfunction pathFor(route){if(\"'!pathCache.has(route))pathCache.set(route,new globalThis.My3D2dge.Path(ROUTES[route],{smooth:'\"'catmull'}));return pathCache.get(route);}\nexport function randomWorld(w){let a=w.rng=(w.rng+0x6d2b79f5)>>>0;a=Math.imul(a\"'^(a>>>15),a|1);a''^=a+Math.imul(a''^(a>>>7),a|61);return((a''^(a>>>14))>>>0)/4294967296;}\nexport function emit(w,type,data={}){const ev={id:++w.eventId,tick:w.tick,type,...data};w.events.push(ev);if(w.events.length>48)w.events.shift();return ev;}\nexport function createWorld({seed=1982,seats=[{id:0,name:'\"'PILOT 1'}],tuning={},assists={},demo=false}={}){\n const tune={...DEFAULTS,...tuning};\n const w={v:1,seed:seed>>>0,rng:seed>>>0,tick:0,time:0,hostileTime:0,phase:'countdown',phaseTime:0,wave:0,bossPhase:0,boss:null,players:seats.slice(0,4).map((p,i)=>({id:p.id,name:String(p.name||'PILOT '+(i+1)).slice(0,32),seat:i,x:170+i*95,y:ARENA.lane,vx:0,hp:3,inv:0,recoil:0,cool:0,connected:true,kills:0,intercepts:0,hitCount:0,brakeSeq:-1,lastSeq:-1,inputAt:-999,action:{move:0,target:null,fire:false,brake:0}})),enemies:[],threats:[],shots:[],nextId:1,eventId:0,events:[],score:0,brake:0,brakeLeft:0,brakeCooldown:0,attackClock:4.8,attackIndex:0,targetIndex:0,hintIndex:0,seen:[],clears:[],outcome:null,tuning:tune,assists:{autoFire:false,slow:false,emergency:false,...assists},modified:demo||Object.keys(DEFAULTS).some(k=>tune[k]\"'!==DEFAULTS[k]),demo,stats:{ships:0,intercepts:0,hits:0,brakes:0,bonus:0},finishCount:0};\n emit(w,'\"'begin');return w;\n}\nexport function acceptAction(w,from,packet){\n const p=w.players.find(p=>p.id===from&&p.connected);\n if(\"'!p||!packet||packet.k!=='\"'a'||\"'!Number.isSafeInteger(packet.n)||packet.n<0||packet.n<=p.lastSeq||!Number.isFinite(packet.m)||Math.abs(packet.m)>1||!(packet.x===null||(Number.isFinite(packet.x)&&packet.x>=ARENA.left&&packet.x<=ARENA.right))||typeof packet.f!=='\"'boolean'||\"'!Number.isSafeInteger(packet.b)||packet.b<0||packet.b>1e9)return false;\n p.lastSeq=packet.n;p.inputAt=w.time;p.action={move:packet.m,target:packet.x,fire:packet.f,brake:packet.b};return true;\n}\nexport function leaveWorld(w,id){const p=w.players.find(p=>p.id===id);if(p){p.connected=false;p.action={move:0,target:null,fire:false,brake:0};w.shots=w.shots.filter(s=>s.owner!==id);emit(w,'\"'leave',{owner:id});checkTeam(w);}}\nfunction checkTeam(w){if(\"'!w.outcome&&w.players.filter(p=>p.connected).every(p=>p.hp<=0))finishWorld(w,false);}\nexport function finishWorld(w,won,reason=won?'\"'rift-sealed':'machines-lost'){\n if(w.outcome)return false;w.outcome={won,reason,score:w.score,tick:w.tick};w.finishCount++;w.threats=[];w.shots=[];w.phase=won?'ending':'results';w.phaseTime=0;emit(w,won?'victory':'defeat',{line:won?QUIPS.victory:QUIPS.defeat});return true;\n}\nexport function startEncounter(w,wave=w.wave,bossPhase=null){\n w.enemies=[];w.threats=[];w.shots=[];w.phaseTime=0;w.attackIndex=0;w.attackClock=4.8;w.hintIndex=0;w.boss=null;\n if(bossPhase\"'!==null||wave>=8){\n  w.wave=8;w.bossPhase=bossPhase??0;const b=BOSS_PHASES[w.bossPhase];w.phase='\"'finale';w.boss={id:w.nextId++,x:320,y:116,hp:b.hp,max:b.hp,clock:0,open:false,r:24};w.attackClock=1.7;emit(w,'boss',{line:b.line,phase:w.bossPhase});\n }else{\n  w.wave=wave;w.phase='playing';const c=WAVES[wave];\n  for(let i=0;i<c.ships;i++){\n   const group=Math.floor(i/c.groupSize),route=c.routes[group%c.routes.length],slot=i%c.groupSize;\n   w.enemies.push({id:w.nextId++,i,group,route,d:-(group*1.15+slot*c.spacing)*125,x:320,y:65,px:320,py:65,hp:c.hp,max:c.hp,kind:(group+wave)%3,a:0,r:12,formed:false,hit:0});\n  }\n  emit(w,'wave',{wave,line:c.line,cue:c.cue});\n }\n if(\"'!w.seen.includes(w.wave===8?'\"'boss'+w.bossPhase:'wave'+w.wave))w.seen.push(w.wave===8?'boss'+w.bossPhase:'wave'+w.wave);\n}\nfunction waveClear(w){\n w.clears.push(w.wave);const bonus=w.players.filter(p=>p.connected).reduce((a,p)=>a+p.hp*12,0)+Math.min(40,w.stats.intercepts*2);w.stats.bonus+=bonus;w.score+=bonus;\n w.phase='intermission';w.phaseTime=0;w.threats=[];w.shots=[];\n for(const p of w.players)if(p.connected){if(p.hp===0)p.hp=1;else p.hp=Math.min(3,p.hp+1);p.inv=2;}\n emit(w,'clear',{bonus,line:QUIPS.clear[w.wave%QUIPS.clear.length]});\n}\nexport function activateBrake(w,owner){if(w.outcome||w.brake<100-1e-6||w.brakeLeft>0||w.brakeCooldown>0)return false;w.brake=0;w.brakeLeft=w.tuning.brakeDuration;w.brakeCooldown=2;w.stats.brakes++;emit(w,'brake',{owner,line:QUIPS.brake[w.stats.brakes%2]});return true;}\nfunction chargeWorld(w,amount){const before=w.brake;w.brake=bound(w.brake+amount*w.tuning.chargeGain,0,100);if(before<100&&w.brake===100)emit(w,'charged');}\nfunction targetWorld(w){const ps=w.players.filter(p=>p.connected&&p.hp>0).sort((a,b)=>a.id-b.id);return ps.length?ps[w.targetIndex++%ps.length]:null;}\nexport function spawnThreat(w,kind,options={}){\n if(\"'!WEAPONS[kind]||w.threats.length>=14||w.outcome)return null;\n const p=targetWorld(w);if(!p)return null;\n const e=w.enemies.filter(f=>f.d>=0)[Math.floor(randomWorld(w)*Math.max(1,w.enemies.filter(f=>f.d>=0).length))];\n const x=options.x??(e?e.x:320+(randomWorld(w)-.5)*300),y=options.y??(e?e.y+10:140);\n const t={id:w.nextId++,kind,x:bound(x,48,592),y,px:x,py:y,vx:0,vy:0,age:0,warn:options.warn??(kind==='\"'hunter'?1.1:.65),state:'warn',target:p.id,tx:p.x,ty:p.y,r:WEAPONS[kind].r,life:14,ground:false,from:0,to:0,safe:0};\n if(kind==='dart'){t.vx=bound((p.x-t.x)*.1,-12,12);t.vy=w.tuning.missileSpeed*(1+w.wave*.035);}\n if(kind==='mine'){t.vx=0;t.vy=52+w.wave*1.6;t.life=9;}\n if(kind==='hunter'){t.tx=bound(p.x+p.vx*w.tuning.prediction,44,596);t.ty=ARENA.lane;}\n if(kind==='roller'){\n  // Bound one sweep to a short segment. Its opposite half remains an explicit refuge.\n  if(w.threats.some(t=>t.kind==='roller'))return null;\n  t.x=bound(p.x+(randomWorld(w)>.5?55:-55),115,525);t.px=t.x;t.vy=61;\n  const direction=t.x<320?1:-1;t.from=t.x;t.to=bound(t.x+direction*110,92,548);t.safe=direction>0?t.from-38:t.from+38;\n  if(w.players.some(q=>q.connected&&q.hp>0&&Math.min(Math.abs(q.x-(Math.min(t.from,t.to)-25)),Math.abs(q.x-(Math.max(t.from,t.to)+25)))>w.tuning.playerSpeed*(Math.max(1,(ARENA.lane-t.y)/61)+.65)))return null;\n }\n // Never place another lower-lane aim mark inside an active roller's nearest refuge.\n const roller=w.threats.find(t=>t.kind==='roller');\n if(roller&&kind\"'!=='\"'roller'&&Math.abs((kind==='hunter'?t.tx:t.x)-roller.safe)<52)return null;\n if(kind==='hunter'&&roller&&t.tx>Math.min(roller.from,roller.to)-45&&t.tx<Math.max(roller.from,roller.to)+45)t.tx=bound(roller.safe+(roller.safe<320?-75:75),44,596);\n w.threats.push(t);emit(w,'launch',{kind,x:t.x,y:t.y});if(\"'!w.seen.includes(kind))w.seen.push(kind);return t;\n}\nfunction stepThreat(w,t,hdt){\n t.px=t.x;t.py=t.y;t.age+=hdt;t.life-=hdt;\n if(t.state==='\"'warn'){\n  t.warn-=hdt;if(t.warn>0)return;t.state='air';\n  if(t.kind==='hunter'){const dx=t.tx-t.x,dy=t.ty-t.y,s=125+w.wave*2,d=Math.hypot(dx,dy);t.vx=dx/d*s;t.vy=dy/d*s;emit(w,'commit',{id:t.id});}\n }\n if(t.kind==='mine'){\n  const p=w.players.find(p=>p.id===t.target&&p.connected&&p.hp>0);const speed=56+w.wave*1.6;\n  const want=Math.atan2(ARENA.lane-t.y,(p?p.x:t.tx)-t.x),angle=Math.atan2(t.vy,t.vx);const diff=Math.atan2(Math.sin(want-angle),Math.cos(want-angle));const a=angle+bound(diff,-w.tuning.mineTurn*hdt,w.tuning.mineTurn*hdt);\n  t.vx=Math.cos(a)*speed;t.vy=Math.max(21,Math.sin(a)*speed);\n }\n if(t.kind==='roller'&&t.ground){t.vx=Math.sign(t.to-t.from)*w.tuning.rollerSpeed;t.vy=0;if((t.to-t.x)*t.vx<=0)t.life=0;}\n t.x+=t.vx*hdt;t.y+=t.vy*hdt;\n if(t.kind==='roller'&&\"'!t.ground&&t.y>=ARENA.lane){t.y=ARENA.lane;t.x=t.from;t.ground=true;t.state='\"'ground';t.life=Math.min(t.life,Math.abs(t.to-t.from)/w.tuning.rollerSpeed+.1);emit(w,'land',{x:t.x,y:t.y});}\n if(t.y>334||t.x<20||t.x>620)t.life=0;\n}\n// Relative segment-circle test, continuous for both fast shots and moving targets.\nexport function sweptHit(a,b,r){const x=a.px-b.px,y=a.py-b.py,dx=(a.x-a.px)-(b.x-b.px),dy=(a.y-a.py)-(b.y-b.py);const den=dx*dx+dy*dy;const t=den?bound(-(x*dx+y*dy)/den,0,1):0;return(x+dx*t)**2+(y+dy*t)**2<=r*r;}\nfunction hitPlayer(w,p,t){\n if(p.inv>0||p.hp<=0||\"'!p.connected)return;\n p.hp--;p.hitCount++;w.stats.hits++;p.inv=2.2;p.x=bound(p.x+(p.x<t.x?-12:12),ARENA.left,ARENA.right);p.vx=0;\n // One damage event, then dissolve all overlapping dangers. No chain damage this tick.\n for(const q of w.threats)if(Math.hypot(q.x-p.x,q.y-p.y)<54)q.life=0;\n emit(w,'\"'hit',{owner:p.id,x:p.x,y:p.y,line:QUIPS.hurt[w.stats.hits%2]});checkTeam(w);\n}\nexport function stepWorld(w,dt=FIXED_DT){\n if(w.outcome){if(w.phase==='ending'){w.phaseTime+=dt;if(w.phaseTime>6){w.phase='results';emit(w,'results');}}return;}\n w.tick++;w.time+=dt;w.phaseTime+=dt;\n for(const p of w.players){p.inv=Math.max(0,p.inv-dt);p.recoil=Math.max(0,p.recoil-dt*7);}\n if(w.phase==='countdown'){if(w.phaseTime>=2)startEncounter(w,0);return;}\n if(w.phase==='intermission'){if(w.phaseTime>=3.2)startEncounter(w,w.wave+1);return;}\n if(\"'!['\"'playing','finale'].includes(w.phase))return;\n w.brakeCooldown=Math.max(0,w.brakeCooldown-dt);\n for(const p of w.players){\n  if(\"'!p.connected||p.hp<=0)continue;\n  const active=w.time-p.inputAt<.48,a=active?p.action:{move:0,target:null,fire:false,brake:p.brakeSeq};\n  if(a.brake>p.brakeSeq){p.brakeSeq=a.brake;if(a.brake>0)activateBrake(w,p.id);}\n  p.px=p.x;p.py=p.y;let move=a.move;\n  if(Math.abs(move)<.08&&a.target!==null)move=bound((a.target-p.x)/(w.tuning.playerSpeed*dt),-1,1);\n  p.vx=move*w.tuning.playerSpeed;p.x=bound(p.x+p.vx*dt,ARENA.left,ARENA.right);p.cool-=dt;\n  if((a.fire||w.assists.autoFire)&&p.cool<=0&&!w.shots.some(s=>s.owner===p.id)){\n   w.shots.push({id:w.nextId++,owner:p.id,x:p.x,y:p.y-14,px:p.x,py:p.y-14,r:3,hit:false});p.cool=w.tuning.fireInterval;p.recoil=1;emit(w,'\"'shot',{owner:p.id,x:p.x,y:p.y-14});\n  }\n  if(w.assists.emergency&&w.brake>=100&&w.threats.some(t=>Math.hypot(t.x-p.x,t.y-p.y)<65&&t.state\"'!=='\"'warn'))activateBrake(w,p.id);\n }\n const hdt=dt*(w.brakeLeft>0?w.tuning.slowFactor:1)*(w.assists.slow?.72:1);\n if(w.brakeLeft>0){w.brakeLeft=Math.max(0,w.brakeLeft-dt);if(w.brakeLeft===0)emit(w,'release');}\n w.hostileTime+=hdt;\n const c=WAVES[w.wave];\n for(const f of w.enemies){\n  f.px=f.x;f.py=f.y;f.hit=Math.max(0,f.hit-dt);f.d+=125*hdt;const path=pathFor(f.route);\n  if(f.d<0)continue;\n  if(f.d<path.length){const p=path.at(f.d);f.x=bound(p.x,42,598);f.y=p.y;f.a=p.angle;}\n  else{\n   f.formed=true;const phase=w.hostileTime*c.speed/110+f.group*1.7;\n   f.x=bound(320+Math.sin(phase)*195+(f.i%8-3.5)*19,48,592);\n   f.y=101+f.group*26+Math.cos(phase*1.6+f.i*.5)*15;f.a=Math.cos(phase)*.3;\n  }\n }\n if(w.boss){const b=w.boss,bc=BOSS_PHASES[w.bossPhase];b.px=b.x;b.py=b.y;b.clock+=hdt;b.x=320+Math.sin(w.hostileTime*.55)*175;b.y=116+Math.sin(w.hostileTime*.8)*12;const before=b.open;b.open=b.clock%(bc.open+bc.closed)>bc.closed;if(before\"'!==b.open)emit(w,b.open?'\"'weakpoint':'shield');}\n w.attackClock-=hdt;\n if(w.attackClock<=0){\n  const mix=w.boss?BOSS_PHASES[w.bossPhase].mix:c.mix;const kind=mix[w.attackIndex++%mix.length];spawnThreat(w,kind);\n  const interval=w.boss?BOSS_PHASES[w.bossPhase].interval:c.interval;w.attackClock=interval*w.tuning.enemyInterval/DEFAULTS.enemyInterval*(w.players.filter(p=>p.connected).length>1?.85:1);\n }\n if(c&&w.hintIndex<c.hints.length&&w.phaseTime>=c.hints[w.hintIndex][0]){emit(w,'hint',{line:c.hints[w.hintIndex++][1]});}\n for(const t of w.threats)stepThreat(w,t,hdt);\n for(const s of w.shots){\n  s.px=s.x;s.py=s.y;s.y-=w.tuning.shotSpeed*dt;\n  // Nearest eligible collision along the swept ray; interceptions precede hull damage.\n  const targets=[...w.threats.filter(t=>\"'!t.ground&&t.life>0&&t.state!=='\"'warn'),...w.enemies.filter(f=>f.d>=0&&f.hp>0),...(w.boss?[w.boss]:[])].filter(t=>sweptHit(s,t,s.r+t.r)).sort((a,b)=>b.y-a.y||a.id-b.id);\n  const t=targets[0];if(\"'!t)continue;s.hit=true;const owner=w.players.find(p=>p.id===s.owner);\n  if(t.kind&&WEAPONS[t.kind]){\n   t.life=0;w.score+=WEAPONS[t.kind].score;w.stats.intercepts++;if(owner)owner.intercepts++;chargeWorld(w,WEAPONS[t.kind].charge);emit(w,'\"'intercept',{kind:t.kind,x:t.x,y:t.y,owner:s.owner,points:WEAPONS[t.kind].score});\n  }else if(t===w.boss){\n   if(t.open){t.hp--;w.score+=3;chargeWorld(w,1);emit(w,'bossHit',{x:t.x,y:t.y});}else emit(w,'blocked',{x:t.x,y:t.y});\n  }else{\n   t.hp--;t.hit=.12;if(t.hp<=0){w.score+=5;w.stats.ships++;if(owner)owner.kills++;chargeWorld(w,2);emit(w,'kill',{x:t.x,y:t.y,owner:s.owner,points:5});}else emit(w,'hullHit',{x:t.x,y:t.y});\n  }\n }\n w.shots=w.shots.filter(s=>\"'!s.hit&&s.y>-10);w.enemies=w.enemies.filter(f=>f.hp>0);w.threats=w.threats.filter(t=>t.life>0);\n for(const t of w.threats){if(t.state==='\"'warn')continue;for(const p of w.players){if(p.hp>0&&p.connected&&p.inv<=0&&sweptHit(t,{...p,px:p.px??p.x,py:p.y},t.r+6)){hitPlayer(w,p,t);break;}}if(w.outcome)return;}\n w.threats=w.threats.filter(t=>t.life>0);\n if(w.boss&&w.boss.hp<=0){\n  w.threats=[];w.shots=[];emit(w,'phaseBreak',{x:w.boss.x,y:w.boss.y});\n  if(w.bossPhase===2){w.score+=300;finishWorld(w,true);}else{w.bossPhase++;const next=w.bossPhase;for(const p of w.players)if(p.connected){p.hp=Math.min(3,p.hp+1);p.inv=2;}startEncounter(w,8,next);w.brake=Math.max(w.brake,65);}\n }else if(\"'!w.boss&&!w.enemies.length)waveClear(w);\n}\nexport function botAction(w,p){\n // Ordinary action planner: aim at predicted hulls, intercept hazards and choose reachable safe positions.\n const incoming=w.threats.filter(t=>t.state!=='\"'warn'&&\"'!t.ground&&t.life>0&&t.y>160).sort((a,b)=>b.y-a.y);\n let tx=p.x;\n const danger=incoming.find(t=>Math.abs(t.x-p.x)<55)||incoming[0];\n if(danger){const time=(p.y-14-danger.y)/(w.tuning.shotSpeed+Math.max(0,danger.vy));tx=bound(danger.x+danger.vx*Math.max(0,time),42,598);}\n else if(w.boss){const b=w.boss,flight=(p.y-b.y)/w.tuning.shotSpeed;tx=320+Math.sin((w.hostileTime+flight)*.55)*175;}\n else{\n  const foes=w.enemies.filter(f=>f.d>=0);\n  const f=foes.reduce((best,f)=>!best||Math.abs(f.x-p.x)+((f.y<75)?120:0)<Math.abs(best.x-p.x)+((best.y<75)?120:0)?f:best,null);\n  if(f){const flight=(p.y-f.y)/w.tuning.shotSpeed;tx=f.formed?bound(320+Math.sin((w.hostileTime+flight)*WAVES[w.wave].speed/110+f.group*1.7)*195+(f.i%8-3.5)*19,48,592):f.x;}\n }\n const rollers=w.threats.filter(t=>t.ground||t.kind==='\"'roller'&&t.y>230);\n for(const r of rollers){const lo=Math.min(r.from,r.to)-24,hi=Math.max(r.from,r.to)+24;if(tx>lo&&tx<hi||p.x>lo&&p.x<hi)tx=Math.abs(p.x-lo)<Math.abs(p.x-hi)?lo-5:hi+5;}\n // Evade committed diamonds below the muzzle; point shots cannot save a cannon then.\n for(const t of incoming)if(t.y>270&&Math.abs(t.x-p.x)<30)tx=p.x+(p.x<t.x?-70:70);\n return{move:0,target:bound(tx,ARENA.left,ARENA.right),fire:true,brake:w.brake>=100&&incoming.length>=2?1:0};\n}\nexport function worldPacket(w){\n // Quantized complete revisions fit one reliable Hub message; no decorative traffic.\n return{k:'w',n:w.tick,t:qround(w.time),s:w.seed,r:w.rng,p:w.phase,pt:qround(w.phaseTime),w:w.wave,bp:w.bossPhase,sc:w.score,b:[qround(w.brake),qround(w.brakeLeft),qround(w.hostileTime)],\n ps:w.players.map(p=>[p.id,p.seat,qround(p.x),p.hp,qround(p.inv),qround(p.vx),p.connected?1:0,qround(p.recoil),p.kills,p.intercepts]),\n es:w.enemies.map(f=>[f.id,qround(f.x),qround(f.y),f.hp,f.kind,f.d<0?0:1,qround(f.a),f.max]),\n ts:w.threats.map(t=>[t.id,Object.keys(WEAPONS).indexOf(t.kind),qround(t.x),qround(t.y),t.state==='warn'?0:t.ground?2:1,qround(t.warn),qround(t.tx),qround(t.vx),qround(t.vy),qround(t.from),qround(t.to),qround(t.safe)]),\n ss:w.shots.map(s=>[s.id,s.owner,qround(s.x),qround(s.y)]),bs:w.boss?[w.boss.id,qround(w.boss.x),qround(w.boss.y),w.boss.hp,w.boss.max,w.boss.open?1:0]:null,\n ev:w.events.slice(-8).map(e=>[e.id,e.type,e.x??null,e.y??null,e.kind??null,e.line??null,e.owner??null,e.points??null]),o:w.outcome,st:w.stats,mod:w.modified,as:w.assists};\n}\nexport function applyWorldPacket(old,p,roster=[]){\n if(\"'!p||p.k!=='\"'w'||\"'!Number.isSafeInteger(p.n)||old&&p.n<old.tick||!Array.isArray(p.ps)||p.ps.length>4||!Array.isArray(p.es)||p.es.length>64||!Array.isArray(p.ts)||p.ts.length>16||!Array.isArray(p.ss)||p.ss.length>4||!Number.isFinite(p.sc))return null;\n // Sender is authenticated by each transport. Reject malformed/nonfinite graphs before any renderer sees them.\n const nums=[p.n,p.t,p.w,p.bp,p.sc,...p.b,...p.ps.flat(),...p.es.flat(),...p.ts.flat(),...p.ss.flat(),...(p.bs||[])];if(!nums.every(Number.isFinite))return null;\n return{v:1,seed:p.s,rng:p.r,tick:p.n,time:p.t,hostileTime:p.b[2],phase:p.p,phaseTime:p.pt,wave:p.w,bossPhase:p.bp,score:p.sc,brake:p.b[0],brakeLeft:p.b[1],modified:p.mod,assists:p.as,stats:p.st,outcome:p.o,demo:false,\n players:p.ps.map(a=>({id:a[0],seat:a[1],name:roster.find(r=>r.id===a[0])?.name||'\"'PILOT '+(a[1]+1),x:a[2],y:ARENA.lane,hp:a[3],inv:a[4],vx:a[5],connected:\"'!!a[6],recoil:a[7],kills:a[8],intercepts:a[9]})),\n enemies:p.es.map(a=>({id:a[0],x:a[1],y:a[2],hp:a[3],kind:a[4],d:a[5]?1:-1,a:a[6],max:a[7]})),\n threats:p.ts.map(a=>({id:a[0],kind:Object.keys(WEAPONS)[a[1]],x:a[2],y:a[3],state:a[4]===0?'\"'warn':a[4]===2?'ground':'air',ground:a[4]===2,warn:a[5],tx:a[6],vx:a[7],vy:a[8],from:a[9],to:a[10],safe:a[11],r:8})),\n shots:p.ss.map(a=>({id:a[0],owner:a[1],x:a[2],y:a[3]})),boss:p.bs?{id:p.bs[0],x:p.bs[1],y:p.bs[2],hp:p.bs[3],max:p.bs[4],open:\"'!!p.bs[5],r:24}:null,\n events:p.ev.map(a=>({id:a[0],type:a[1],x:a[2],y:a[3],kind:a[4],line:a[5],owner:a[6],points:a[7]}))};\n}\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('vendor/engine/my-3d2dge.js');s=p.read_text();s=s.replace('const saved = settingValue(s, this._raw[s.key]);','const saved = s.persist === false ? undefined : settingValue(s, this._raw[s.key]);');s=s.replace(\\\"this.saved = store.set(this._key, { v: SETTINGS_VERSION, values: this._saved });\\\",\\\"this.saved = store.set(this._key, { v: SETTINGS_VERSION, values: Object.fromEntries(Object.entries(this._saved).filter(([k]) => this._specs[k]?.persist \"'!== false)) });\");p.write_text(s)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"cat > package.json <<'EOF'\n{\\\"name\\\":\\\"time-bandit-boss\\\",\\\"version\\\":\\\"1.0.0\\\",\\\"private\\\":true,\\\"type\\\":\\\"module\\\",\\\"scripts\\\":{\\\"build\\\":\\\"node tools/build.mjs\\\",\\\"test\\\":\\\"node tools/test.mjs\\\"}}\nEOF\ncat > src/content/campaign.js <<'EOF'\nexport const TITLE = 'Attack of the Time Bandit Boss';\nexport const ARENA = Object.freeze({ w:640, h:360, left:38, right:602, lane:304 });\nexport const DEFAULTS = Object.freeze({ playerSpeed:220, fireInterval:.13, missileSpeed:76, mineTurn:1.05, rollerSpeed:64, prediction:.72, enemyInterval:2.5, brakeDuration:1.6, slowFactor:.35, chargeGain:1, shotSpeed:760 });\nexport const TUNING = [\n ['playerSpeed','Machine speed',120,360,10,' u/s'], ['fireInterval','Cannon rearm',.07,.4,.01,' s'],\n ['missileSpeed','Dart speed',35,150,5,' u/s'], ['mineTurn','Seeker turn',.25,2.5,.05,' rad/s'],\n ['rollerSpeed','Ground sweep speed',25,110,5,' u/s'], ['prediction','Hunter prediction',.2,1.4,.05,' s'],\n ['enemyInterval','Attack interval',1,5,.1,' s'], ['brakeDuration','Brake duration',.8,3,.1,' s'],\n ['slowFactor','Hostile time factor',.2,.7,.05,' ×'], ['chargeGain','Charge multiplier',.5,2,.1,' ×']\n];\nexport const WEAPONS = Object.freeze({ dart:{score:2,charge:10,r:5,color:'#e9f5ff',name:'Falling dart'}, mine:{score:4,charge:15,r:8,color:'#ff647e',name:'Antimatter seeker'}, roller:{score:8,charge:20,r:8,color:'#b6ff72',name:'Annihilator'}, hunter:{score:16,charge:24,r:8,color:'#ffd674',name:'Time Killer'} });\nexport const ROUTES = [\n [[320,65],[455,98],[532,151],[405,202],[212,176],[118,112],[242,109]],\n [[320,65],[182,97],[103,151],[229,203],[420,177],[520,112],[400,109]],\n [[320,62],[470,90],[495,180],[325,216],[149,161],[177,91],[300,131]]\n];\n// Declarative authored waves. Spawn times, routes, composition, tells and narration live here.\nexport const WAVES = [\n { name:'Borrowed seconds', ships:18, hp:2, routes:[0], speed:29, interval:1.5, mix:['dart'], cue:'SLIDE. HOLD FIRE. SHOOT THE DARTS.', line:'Your century is overdue. I have come to collect\"'!'\"', color:'#66e5f2', hints:[ [12,'Intercept weapons to charge the time brake.'] ] },\n { name:'Interest in red', ships:20, hp:2, routes:[1,0], speed:32, interval:1.38, mix:['dart','mine','dart'], cue:'SEEKERS TURN SLOWLY. BAIT THE CURVE.', line:'I ordered obedient mines. Apparently they take suggestions.', color:'#ff7c99', hints:[ [16,'A full meter buys a moment. Press BRAKE when ready.'] ] },\n { name:'Cross purposes', ships:22, hp:2, routes:[2,1], speed:34, interval:1.28, mix:['dart','mine','roller','dart'], cue:'BREAK THE CROSS BEFORE IT LANDS.', line:'Mind the floor. It is now aggressively rented.', color:'#b6ff72', hints:[ [8,'Grounded crosses cannot be shot. Escape their marked sweep.'],[24,'Time brake slows weapons. Your cannon stays quick.'] ] },\n { name:'Bad predictions', ships:24, hp:2, routes:[0,1], speed:36, interval:1.2, mix:['dart','hunter','mine','roller','dart'], cue:'DIAMOND MARKS YOUR FUTURE. CHANGE IT.', line:'My diamonds predict everything. Except insubordination.', color:'#ffd674', hints:[ [12,'The diamond commits after its aim mark. Change direction.'] ] },\n { name:'Compound chaos', ships:26, hp:3, routes:[1,0,2], speed:38, interval:1.14, mix:['mine','dart','hunter','dart','roller','mine'], cue:'MAKE A GAP. THEN TAKE THE SHOT.', line:'You are a very expensive rounding error.', color:'#ac99ff', hints:[] },\n { name:'The floor is late', ships:28, hp:3, routes:[2,1,0], speed:39, interval:1.08, mix:['roller','dart','dart','mine','hunter','dart'], cue:'READ THE SWEEP. KEEP AN EXIT.', line:'Stop moving\"'! My accountant cannot aim.'\"', color:'#b6ff72', hints:[] },\n { name:'Split second', ships:30, hp:3, routes:[0,1,2], speed:41, interval:1.03, mix:['hunter','mine','dart','roller','dart','mine'], cue:'COVER THE SKY. SHARE THE BRAKE.', line:'One timeline. Several pests. Entirely unfair.', color:'#ffb47b', hints:[] },\n { name:'The final invoice', ships:32, hp:3, routes:[2,0,1], speed:43, interval:1, mix:['dart','mine','hunter','roller','mine','dart','hunter'], cue:'EVERY SECOND YOU STOLE IS YOURS.', line:'Fine\"'! I shall handle this disgrace personally!'\"', color:'#69e7f5', hints:[] }\n].map((w,i)=>Object.freeze({...w,index:i, firstAttack:4.8, spacing:.18, warning:.72, groupSize:8}));\nexport const BOSS_PHASES = [\n { name:'The collector', hp:34, open:5, closed:2.6, interval:1.35, mix:['dart','mine','dart'], color:'#69e7f5', line:'Behold my flawless face\"'! Kindly miss it.'\"' },\n { name:'Hostile takeover', hp:42, open:4.5, closed:2.8, interval:1.15, mix:['roller','mine','hunter','dart'], color:'#ff7b9a', line:'That was my good side. Both sides are my good side\"'!'\"' },\n { name:'Overtime', hp:48, open:4, closed:2.5, interval:1, mix:['hunter','dart','mine','roller','dart'], color:'#ffd674', line:'I demand a second opinion\"'! And all your seconds!'\"' }\n];\nexport const QUIPS = { intercept:['That missile was nonrefundable\"'!'\"','Stop editing my perfectly good future.','A lucky shot. Repeatedly.'], brake:['You cannot put a tyrant on hold\"'!'\"','Why is everything taking so loooong?'], hurt:['A small deduction from your existence\"'!'\"','Ah\"'! A punctual explosion.'\"'], clear:['My fleet was on a break. Clearly.','An unacceptable display of competence.','You have my reluctant, temporary respect.'], victory:'You win this time. I shall appeal yesterday\"'!'\"', defeat:'Your time is up. Mine is billable.' };\nexport function validateContent() {\n const errors=[];\n if(WAVES.length\"'!==8||BOSS_PHASES.length!==3)errors.push('\"'Campaign requires eight waves and three finale phases');\n for(const [i,w] of WAVES.entries()){\n  if(w.index\"'!==i||w.ships<1||!w.mix.length||!w.routes.every(r=>ROUTES[r]))errors.push('\"'Invalid wave '+i);\n  if(\"'!w.mix.every(k=>WEAPONS[k]))errors.push('\"'Unknown weapon '+i);\n }\n for(const path of ROUTES)if(path.length<4||\"'!path.every(p=>p.length===2&&p.every(Number.isFinite)))errors.push('\"'Invalid route');\n for(const [k,v]of Object.entries(DEFAULTS))if(\"'!Number.isFinite(v)||v<=0)errors.push('\"'Invalid default '+k);\n return errors;\n}\nEOF\ncat > src/game/simulation.js <<'EOF'\nimport { ARENA, DEFAULTS, WEAPONS, WAVES, BOSS_PHASES, ROUTES, QUIPS } from '../content/campaign.js';\nexport const FIXED_DT=1/120;\nexport const bound=(n,a,b)=>Math.max(a,Math.min(b,n));\nconst qround=n=>Math.round(n*10)/10;\nconst pathCache=new Map();\nfunction pathFor(route){if(\"'!pathCache.has(route))pathCache.set(route,new globalThis.My3D2dge.Path(ROUTES[route],{smooth:'\"'catmull'}));return pathCache.get(route);}\nexport function randomWorld(w){let a=w.rng=(w.rng+0x6d2b79f5)>>>0;a=Math.imul(a\"'^(a>>>15),a|1);a''^=a+Math.imul(a''^(a>>>7),a|61);return((a''^(a>>>14))>>>0)/4294967296;}\nexport function emit(w,type,data={}){const ev={id:++w.eventId,tick:w.tick,type,...data};w.events.push(ev);if(w.events.length>48)w.events.shift();return ev;}\nexport function createWorld({seed=1982,seats=[{id:0,name:'\"'PILOT 1'}],tuning={},assists={},demo=false}={}){\n const tune={...DEFAULTS,...tuning};\n const w={v:1,seed:seed>>>0,rng:seed>>>0,tick:0,time:0,hostileTime:0,phase:'countdown',phaseTime:0,wave:0,bossPhase:0,boss:null,players:seats.slice(0,4).map((p,i)=>({id:p.id,name:String(p.name||'PILOT '+(i+1)).slice(0,32),seat:i,x:170+i*95,y:ARENA.lane,vx:0,hp:3,inv:0,recoil:0,cool:0,connected:true,kills:0,intercepts:0,hitCount:0,brakeSeq:-1,lastSeq:-1,inputAt:-999,action:{move:0,target:null,fire:false,brake:0}})),enemies:[],threats:[],shots:[],nextId:1,eventId:0,events:[],score:0,brake:0,brakeLeft:0,brakeCooldown:0,attackClock:4.8,attackIndex:0,targetIndex:0,hintIndex:0,seen:[],clears:[],outcome:null,tuning:tune,assists:{autoFire:false,slow:false,emergency:false,...assists},modified:demo||Object.keys(DEFAULTS).some(k=>tune[k]\"'!==DEFAULTS[k]),demo,stats:{ships:0,intercepts:0,hits:0,brakes:0,bonus:0},finishCount:0};\n emit(w,'\"'begin');return w;\n}\nexport function acceptAction(w,from,packet){\n const p=w.players.find(p=>p.id===from&&p.connected);\n if(\"'!p||!packet||packet.k!=='\"'a'||\"'!Number.isSafeInteger(packet.n)||packet.n<0||packet.n<=p.lastSeq||!Number.isFinite(packet.m)||Math.abs(packet.m)>1||!(packet.x===null||(Number.isFinite(packet.x)&&packet.x>=ARENA.left&&packet.x<=ARENA.right))||typeof packet.f!=='\"'boolean'||\"'!Number.isSafeInteger(packet.b)||packet.b<0||packet.b>1e9)return false;\n p.lastSeq=packet.n;p.inputAt=w.time;p.action={move:packet.m,target:packet.x,fire:packet.f,brake:packet.b};return true;\n}\nexport function leaveWorld(w,id){const p=w.players.find(p=>p.id===id);if(p){p.connected=false;p.action={move:0,target:null,fire:false,brake:0};w.shots=w.shots.filter(s=>s.owner!==id);emit(w,'\"'leave',{owner:id});checkTeam(w);}}\nfunction checkTeam(w){if(\"'!w.outcome&&w.players.filter(p=>p.connected).every(p=>p.hp<=0))finishWorld(w,false);}\nexport function finishWorld(w,won,reason=won?'\"'rift-sealed':'machines-lost'){\n if(w.outcome)return false;w.outcome={won,reason,score:w.score,tick:w.tick};w.finishCount++;w.threats=[];w.shots=[];w.phase=won?'ending':'results';w.phaseTime=0;emit(w,won?'victory':'defeat',{line:won?QUIPS.victory:QUIPS.defeat});return true;\n}\nexport function startEncounter(w,wave=w.wave,bossPhase=null){\n w.enemies=[];w.threats=[];w.shots=[];w.phaseTime=0;w.attackIndex=0;w.attackClock=4.8;w.hintIndex=0;w.boss=null;\n if(bossPhase\"'!==null||wave>=8){\n  w.wave=8;w.bossPhase=bossPhase??0;const b=BOSS_PHASES[w.bossPhase];w.phase='\"'finale';w.boss={id:w.nextId++,x:320,y:116,hp:b.hp,max:b.hp,clock:0,open:false,r:24};w.attackClock=1.7;emit(w,'boss',{line:b.line,phase:w.bossPhase});\n }else{\n  w.wave=wave;w.phase='playing';const c=WAVES[wave];\n  for(let i=0;i<c.ships;i++){\n   const group=Math.floor(i/c.groupSize),route=c.routes[group%c.routes.length],slot=i%c.groupSize;\n   w.enemies.push({id:w.nextId++,i,group,route,d:-(group*1.15+slot*c.spacing)*125,x:320,y:65,px:320,py:65,hp:c.hp,max:c.hp,kind:(group+wave)%3,a:0,r:12,formed:false,hit:0});\n  }\n  emit(w,'wave',{wave,line:c.line,cue:c.cue});\n }\n if(\"'!w.seen.includes(w.wave===8?'\"'boss'+w.bossPhase:'wave'+w.wave))w.seen.push(w.wave===8?'boss'+w.bossPhase:'wave'+w.wave);\n}\nfunction waveClear(w){\n w.clears.push(w.wave);const bonus=w.players.filter(p=>p.connected).reduce((a,p)=>a+p.hp*12,0)+Math.min(40,w.stats.intercepts*2);w.stats.bonus+=bonus;w.score+=bonus;\n w.phase='intermission';w.phaseTime=0;w.threats=[];w.shots=[];\n for(const p of w.players)if(p.connected){if(p.hp===0)p.hp=1;else p.hp=Math.min(3,p.hp+1);p.inv=2;}\n emit(w,'clear',{bonus,line:QUIPS.clear[w.wave%QUIPS.clear.length]});\n}\nexport function activateBrake(w,owner){if(w.outcome||w.brake<100-1e-6||w.brakeLeft>0||w.brakeCooldown>0)return false;w.brake=0;w.brakeLeft=w.tuning.brakeDuration;w.brakeCooldown=2;w.stats.brakes++;emit(w,'brake',{owner,line:QUIPS.brake[w.stats.brakes%2]});return true;}\nfunction chargeWorld(w,amount){const before=w.brake;w.brake=bound(w.brake+amount*w.tuning.chargeGain,0,100);if(before<100&&w.brake===100)emit(w,'charged');}\nfunction targetWorld(w){const ps=w.players.filter(p=>p.connected&&p.hp>0).sort((a,b)=>a.id-b.id);return ps.length?ps[w.targetIndex++%ps.length]:null;}\nexport function spawnThreat(w,kind,options={}){\n if(\"'!WEAPONS[kind]||w.threats.length>=14||w.outcome)return null;\n const p=targetWorld(w);if(!p)return null;\n const e=w.enemies.filter(f=>f.d>=0)[Math.floor(randomWorld(w)*Math.max(1,w.enemies.filter(f=>f.d>=0).length))];\n const x=options.x??(e?e.x:320+(randomWorld(w)-.5)*300),y=options.y??(e?e.y+10:140);\n const t={id:w.nextId++,kind,x:bound(x,48,592),y,px:x,py:y,vx:0,vy:0,age:0,warn:options.warn??(kind==='\"'hunter'?1.1:.65),state:'warn',target:p.id,tx:p.x,ty:p.y,r:WEAPONS[kind].r,life:14,ground:false,from:0,to:0,safe:0};\n if(kind==='dart'){t.vx=bound((p.x-t.x)*.1,-12,12);t.vy=w.tuning.missileSpeed*(1+w.wave*.035);}\n if(kind==='mine'){t.vx=0;t.vy=52+w.wave*1.6;t.life=9;}\n if(kind==='hunter'){t.tx=bound(p.x+p.vx*w.tuning.prediction,44,596);t.ty=ARENA.lane;}\n if(kind==='roller'){\n  // Bound one sweep to a short segment. Its opposite half remains an explicit refuge.\n  if(w.threats.some(t=>t.kind==='roller'))return null;\n  t.x=bound(p.x+(randomWorld(w)>.5?55:-55),115,525);t.px=t.x;t.vy=61;\n  const direction=t.x<320?1:-1;t.from=t.x;t.to=bound(t.x+direction*110,92,548);t.safe=direction>0?t.from-38:t.from+38;\n  if(w.players.some(q=>q.connected&&q.hp>0&&Math.min(Math.abs(q.x-(Math.min(t.from,t.to)-25)),Math.abs(q.x-(Math.max(t.from,t.to)+25)))>w.tuning.playerSpeed*(Math.max(1,(ARENA.lane-t.y)/61)+.65)))return null;\n }\n // Never place another lower-lane aim mark inside an active roller's nearest refuge.\n const roller=w.threats.find(t=>t.kind==='roller');\n if(roller&&kind\"'!=='\"'roller'&&Math.abs((kind==='hunter'?t.tx:t.x)-roller.safe)<52)return null;\n if(kind==='hunter'&&roller&&t.tx>Math.min(roller.from,roller.to)-45&&t.tx<Math.max(roller.from,roller.to)+45)t.tx=bound(roller.safe+(roller.safe<320?-75:75),44,596);\n w.threats.push(t);emit(w,'launch',{kind,x:t.x,y:t.y});if(\"'!w.seen.includes(kind))w.seen.push(kind);return t;\n}\nfunction stepThreat(w,t,hdt){\n t.px=t.x;t.py=t.y;t.age+=hdt;t.life-=hdt;\n if(t.state==='\"'warn'){\n  t.warn-=hdt;if(t.warn>0)return;t.state='air';\n  if(t.kind==='hunter'){const dx=t.tx-t.x,dy=t.ty-t.y,s=125+w.wave*2,d=Math.hypot(dx,dy);t.vx=dx/d*s;t.vy=dy/d*s;emit(w,'commit',{id:t.id});}\n }\n if(t.kind==='mine'){\n  const p=w.players.find(p=>p.id===t.target&&p.connected&&p.hp>0);const speed=56+w.wave*1.6;\n  const want=Math.atan2(ARENA.lane-t.y,(p?p.x:t.tx)-t.x),angle=Math.atan2(t.vy,t.vx);const diff=Math.atan2(Math.sin(want-angle),Math.cos(want-angle));const a=angle+bound(diff,-w.tuning.mineTurn*hdt,w.tuning.mineTurn*hdt);\n  t.vx=Math.cos(a)*speed;t.vy=Math.max(21,Math.sin(a)*speed);\n }\n if(t.kind==='roller'&&t.ground){t.vx=Math.sign(t.to-t.from)*w.tuning.rollerSpeed;t.vy=0;if((t.to-t.x)*t.vx<=0)t.life=0;}\n t.x+=t.vx*hdt;t.y+=t.vy*hdt;\n if(t.kind==='roller'&&\"'!t.ground&&t.y>=ARENA.lane){t.y=ARENA.lane;t.x=t.from;t.ground=true;t.state='\"'ground';t.life=Math.min(t.life,Math.abs(t.to-t.from)/w.tuning.rollerSpeed+.1);emit(w,'land',{x:t.x,y:t.y});}\n if(t.y>334||t.x<20||t.x>620)t.life=0;\n}\n// Relative segment-circle test, continuous for both fast shots and moving targets.\nexport function sweptHit(a,b,r){const x=a.px-b.px,y=a.py-b.py,dx=(a.x-a.px)-(b.x-b.px),dy=(a.y-a.py)-(b.y-b.py);const den=dx*dx+dy*dy;const t=den?bound(-(x*dx+y*dy)/den,0,1):0;return(x+dx*t)**2+(y+dy*t)**2<=r*r;}\nfunction hitPlayer(w,p,t){\n if(p.inv>0||p.hp<=0||\"'!p.connected)return;\n p.hp--;p.hitCount++;w.stats.hits++;p.inv=2.2;p.x=bound(p.x+(p.x<t.x?-12:12),ARENA.left,ARENA.right);p.vx=0;\n // One damage event, then dissolve all overlapping dangers. No chain damage this tick.\n for(const q of w.threats)if(Math.hypot(q.x-p.x,q.y-p.y)<54)q.life=0;\n emit(w,'\"'hit',{owner:p.id,x:p.x,y:p.y,line:QUIPS.hurt[w.stats.hits%2]});checkTeam(w);\n}\nexport function stepWorld(w,dt=FIXED_DT){\n if(w.outcome){if(w.phase==='ending'){w.phaseTime+=dt;if(w.phaseTime>6){w.phase='results';emit(w,'results');}}return;}\n w.tick++;w.time+=dt;w.phaseTime+=dt;\n for(const p of w.players){p.inv=Math.max(0,p.inv-dt);p.recoil=Math.max(0,p.recoil-dt*7);}\n if(w.phase==='countdown'){if(w.phaseTime>=2)startEncounter(w,0);return;}\n if(w.phase==='intermission'){if(w.phaseTime>=3.2)startEncounter(w,w.wave+1);return;}\n if(\"'!['\"'playing','finale'].includes(w.phase))return;\n w.brakeCooldown=Math.max(0,w.brakeCooldown-dt);\n for(const p of w.players){\n  if(\"'!p.connected||p.hp<=0)continue;\n  const active=w.time-p.inputAt<.48,a=active?p.action:{move:0,target:null,fire:false,brake:p.brakeSeq};\n  if(a.brake>p.brakeSeq){p.brakeSeq=a.brake;if(a.brake>0)activateBrake(w,p.id);}\n  p.px=p.x;p.py=p.y;let move=a.move;\n  if(Math.abs(move)<.08&&a.target!==null)move=bound((a.target-p.x)/(w.tuning.playerSpeed*dt),-1,1);\n  p.vx=move*w.tuning.playerSpeed;p.x=bound(p.x+p.vx*dt,ARENA.left,ARENA.right);p.cool-=dt;\n  if((a.fire||w.assists.autoFire)&&p.cool<=0&&!w.shots.some(s=>s.owner===p.id)){\n   w.shots.push({id:w.nextId++,owner:p.id,x:p.x,y:p.y-14,px:p.x,py:p.y-14,r:3,hit:false});p.cool=w.tuning.fireInterval;p.recoil=1;emit(w,'\"'shot',{owner:p.id,x:p.x,y:p.y-14});\n  }\n  if(w.assists.emergency&&w.brake>=100&&w.threats.some(t=>Math.hypot(t.x-p.x,t.y-p.y)<65&&t.state\"'!=='\"'warn'))activateBrake(w,p.id);\n }\n const hdt=dt*(w.brakeLeft>0?w.tuning.slowFactor:1)*(w.assists.slow?.72:1);\n if(w.brakeLeft>0){w.brakeLeft=Math.max(0,w.brakeLeft-dt);if(w.brakeLeft===0)emit(w,'release');}\n w.hostileTime+=hdt;\n const c=WAVES[w.wave];\n for(const f of w.enemies){\n  f.px=f.x;f.py=f.y;f.hit=Math.max(0,f.hit-dt);f.d+=125*hdt;const path=pathFor(f.route);\n  if(f.d<0)continue;\n  if(f.d<path.length){const p=path.at(f.d);f.x=bound(p.x,42,598);f.y=p.y;f.a=p.angle;}\n  else{\n   f.formed=true;const phase=w.hostileTime*c.speed/110+f.group*1.7;\n   f.x=bound(320+Math.sin(phase)*195+(f.i%8-3.5)*19,48,592);\n   f.y=101+f.group*26+Math.cos(phase*1.6+f.i*.5)*15;f.a=Math.cos(phase)*.3;\n  }\n }\n if(w.boss){const b=w.boss,bc=BOSS_PHASES[w.bossPhase];b.px=b.x;b.py=b.y;b.clock+=hdt;b.x=320+Math.sin(w.hostileTime*.55)*175;b.y=116+Math.sin(w.hostileTime*.8)*12;const before=b.open;b.open=b.clock%(bc.open+bc.closed)>bc.closed;if(before\"'!==b.open)emit(w,b.open?'\"'weakpoint':'shield');}\n w.attackClock-=hdt;\n if(w.attackClock<=0){\n  const mix=w.boss?BOSS_PHASES[w.bossPhase].mix:c.mix;const kind=mix[w.attackIndex++%mix.length];spawnThreat(w,kind);\n  const interval=w.boss?BOSS_PHASES[w.bossPhase].interval:c.interval;w.attackClock=interval*w.tuning.enemyInterval/DEFAULTS.enemyInterval*(w.players.filter(p=>p.connected).length>1?.85:1);\n }\n if(c&&w.hintIndex<c.hints.length&&w.phaseTime>=c.hints[w.hintIndex][0]){emit(w,'hint',{line:c.hints[w.hintIndex++][1]});}\n for(const t of w.threats)stepThreat(w,t,hdt);\n for(const s of w.shots){\n  s.px=s.x;s.py=s.y;s.y-=w.tuning.shotSpeed*dt;\n  // Nearest eligible collision along the swept ray; interceptions precede hull damage.\n  const targets=[...w.threats.filter(t=>\"'!t.ground&&t.life>0&&t.state!=='\"'warn'),...w.enemies.filter(f=>f.d>=0&&f.hp>0),...(w.boss?[w.boss]:[])].filter(t=>sweptHit(s,t,s.r+t.r)).sort((a,b)=>b.y-a.y||a.id-b.id);\n  const t=targets[0];if(\"'!t)continue;s.hit=true;const owner=w.players.find(p=>p.id===s.owner);\n  if(t.kind&&WEAPONS[t.kind]){\n   t.life=0;w.score+=WEAPONS[t.kind].score;w.stats.intercepts++;if(owner)owner.intercepts++;chargeWorld(w,WEAPONS[t.kind].charge);emit(w,'\"'intercept',{kind:t.kind,x:t.x,y:t.y,owner:s.owner,points:WEAPONS[t.kind].score});\n  }else if(t===w.boss){\n   if(t.open){t.hp--;w.score+=3;chargeWorld(w,1);emit(w,'bossHit',{x:t.x,y:t.y});}else emit(w,'blocked',{x:t.x,y:t.y});\n  }else{\n   t.hp--;t.hit=.12;if(t.hp<=0){w.score+=5;w.stats.ships++;if(owner)owner.kills++;chargeWorld(w,2);emit(w,'kill',{x:t.x,y:t.y,owner:s.owner,points:5});}else emit(w,'hullHit',{x:t.x,y:t.y});\n  }\n }\n w.shots=w.shots.filter(s=>\"'!s.hit&&s.y>-10);w.enemies=w.enemies.filter(f=>f.hp>0);w.threats=w.threats.filter(t=>t.life>0);\n for(const t of w.threats){if(t.state==='\"'warn')continue;for(const p of w.players){if(p.hp>0&&p.connected&&p.inv<=0&&sweptHit(t,{...p,px:p.px??p.x,py:p.y},t.r+6)){hitPlayer(w,p,t);break;}}if(w.outcome)return;}\n w.threats=w.threats.filter(t=>t.life>0);\n if(w.boss&&w.boss.hp<=0){\n  w.threats=[];w.shots=[];emit(w,'phaseBreak',{x:w.boss.x,y:w.boss.y});\n  if(w.bossPhase===2){w.score+=300;finishWorld(w,true);}else{w.bossPhase++;const next=w.bossPhase;for(const p of w.players)if(p.connected){p.hp=Math.min(3,p.hp+1);p.inv=2;}startEncounter(w,8,next);w.brake=Math.max(w.brake,65);}\n }else if(\"'!w.boss&&!w.enemies.length)waveClear(w);\n}\nexport function botAction(w,p){\n // Ordinary action planner: aim at predicted hulls, intercept hazards and choose reachable safe positions.\n const incoming=w.threats.filter(t=>t.state!=='\"'warn'&&\"'!t.ground&&t.life>0&&t.y>160).sort((a,b)=>b.y-a.y);\n let tx=p.x;\n const danger=incoming.find(t=>Math.abs(t.x-p.x)<55)||incoming[0];\n if(danger){const time=(p.y-14-danger.y)/(w.tuning.shotSpeed+Math.max(0,danger.vy));tx=bound(danger.x+danger.vx*Math.max(0,time),42,598);}\n else if(w.boss){const b=w.boss,flight=(p.y-b.y)/w.tuning.shotSpeed;tx=320+Math.sin((w.hostileTime+flight)*.55)*175;}\n else{\n  const foes=w.enemies.filter(f=>f.d>=0);\n  const f=foes.reduce((best,f)=>!best||Math.abs(f.x-p.x)+((f.y<75)?120:0)<Math.abs(best.x-p.x)+((best.y<75)?120:0)?f:best,null);\n  if(f){const flight=(p.y-f.y)/w.tuning.shotSpeed;tx=f.formed?bound(320+Math.sin((w.hostileTime+flight)*WAVES[w.wave].speed/110+f.group*1.7)*195+(f.i%8-3.5)*19,48,592):f.x;}\n }\n const rollers=w.threats.filter(t=>t.ground||t.kind==='\"'roller'&&t.y>230);\n for(const r of rollers){const lo=Math.min(r.from,r.to)-24,hi=Math.max(r.from,r.to)+24;if(tx>lo&&tx<hi||p.x>lo&&p.x<hi)tx=Math.abs(p.x-lo)<Math.abs(p.x-hi)?lo-5:hi+5;}\n // Evade committed diamonds below the muzzle; point shots cannot save a cannon then.\n for(const t of incoming)if(t.y>270&&Math.abs(t.x-p.x)<30)tx=p.x+(p.x<t.x?-70:70);\n return{move:0,target:bound(tx,ARENA.left,ARENA.right),fire:true,brake:w.brake>=100&&incoming.length>=2?1:0};\n}\nexport function worldPacket(w){\n // Quantized complete revisions fit one reliable Hub message; no decorative traffic.\n return{k:'w',n:w.tick,t:qround(w.time),s:w.seed,r:w.rng,p:w.phase,pt:qround(w.phaseTime),w:w.wave,bp:w.bossPhase,sc:w.score,b:[qround(w.brake),qround(w.brakeLeft),qround(w.hostileTime)],\n ps:w.players.map(p=>[p.id,p.seat,qround(p.x),p.hp,qround(p.inv),qround(p.vx),p.connected?1:0,qround(p.recoil),p.kills,p.intercepts]),\n es:w.enemies.map(f=>[f.id,qround(f.x),qround(f.y),f.hp,f.kind,f.d<0?0:1,qround(f.a),f.max]),\n ts:w.threats.map(t=>[t.id,Object.keys(WEAPONS).indexOf(t.kind),qround(t.x),qround(t.y),t.state==='warn'?0:t.ground?2:1,qround(t.warn),qround(t.tx),qround(t.vx),qround(t.vy),qround(t.from),qround(t.to),qround(t.safe)]),\n ss:w.shots.map(s=>[s.id,s.owner,qround(s.x),qround(s.y)]),bs:w.boss?[w.boss.id,qround(w.boss.x),qround(w.boss.y),w.boss.hp,w.boss.max,w.boss.open?1:0]:null,\n ev:w.events.slice(-8).map(e=>[e.id,e.type,e.x??null,e.y??null,e.kind??null,e.line??null,e.owner??null,e.points??null]),o:w.outcome,st:w.stats,mod:w.modified,as:w.assists};\n}\nexport function applyWorldPacket(old,p,roster=[]){\n if(\"'!p||p.k!=='\"'w'||\"'!Number.isSafeInteger(p.n)||old&&p.n<old.tick||!Array.isArray(p.ps)||p.ps.length>4||!Array.isArray(p.es)||p.es.length>64||!Array.isArray(p.ts)||p.ts.length>16||!Array.isArray(p.ss)||p.ss.length>4||!Number.isFinite(p.sc))return null;\n // Sender is authenticated by each transport. Reject malformed/nonfinite graphs before any renderer sees them.\n const nums=[p.n,p.t,p.w,p.bp,p.sc,...p.b,...p.ps.flat(),...p.es.flat(),...p.ts.flat(),...p.ss.flat(),...(p.bs||[])];if(!nums.every(Number.isFinite))return null;\n return{v:1,seed:p.s,rng:p.r,tick:p.n,time:p.t,hostileTime:p.b[2],phase:p.p,phaseTime:p.pt,wave:p.w,bossPhase:p.bp,score:p.sc,brake:p.b[0],brakeLeft:p.b[1],modified:p.mod,assists:p.as,stats:p.st,outcome:p.o,demo:false,\n players:p.ps.map(a=>({id:a[0],seat:a[1],name:roster.find(r=>r.id===a[0])?.name||'\"'PILOT '+(a[1]+1),x:a[2],y:ARENA.lane,hp:a[3],inv:a[4],vx:a[5],connected:\"'!!a[6],recoil:a[7],kills:a[8],intercepts:a[9]})),\n enemies:p.es.map(a=>({id:a[0],x:a[1],y:a[2],hp:a[3],kind:a[4],d:a[5]?1:-1,a:a[6],max:a[7]})),\n threats:p.ts.map(a=>({id:a[0],kind:Object.keys(WEAPONS)[a[1]],x:a[2],y:a[3],state:a[4]===0?'\"'warn':a[4]===2?'ground':'air',ground:a[4]===2,warn:a[5],tx:a[6],vx:a[7],vy:a[8],from:a[9],to:a[10],safe:a[11],r:8})),\n shots:p.ss.map(a=>({id:a[0],owner:a[1],x:a[2],y:a[3]})),boss:p.bs?{id:p.bs[0],x:p.bs[1],y:p.bs[2],hp:p.bs[3],max:p.bs[4],open:\"'!!p.bs[5],r:24}:null,\n events:p.ev.map(a=>({id:a[0],type:a[1],x:a[2],y:a[3],kind:a[4],line:a[5],owner:a[6],points:a[7]}))};\n}\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('vendor/engine/my-3d2dge.js');s=p.read_text();s=s.replace('const saved = settingValue(s, this._raw[s.key]);','const saved = s.persist === false ? undefined : settingValue(s, this._raw[s.key]);');s=s.replace(\\\"this.saved = store.set(this._key, { v: SETTINGS_VERSION, values: this._saved });\\\",\\\"this.saved = store.set(this._key, { v: SETTINGS_VERSION, values: Object.fromEntries(Object.entries(this._saved).filter(([k]) => this._specs[k]?.persist \"'!== false)) });\");p.write_text(s)\nPY'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module <<'JS'\nimport './vendor/engine/my-3d2dge.js';\nimport {createWorld,stepWorld,botAction,acceptAction} from './src/game/simulation.js';\nconsole.log('engine',globalThis.My3D2dge?.version);\nlet w=createWorld({seed:1982});let n=0,b=0,last=0;\nfor(let i=0;i<120*1200&&\"'!w.outcome;i++){\n if(i%8===0)for(const p of w.players){const a=botAction(w,p);if(a.brake)b++;acceptAction(w,p.id,{k:'\"'a',n:n++,m:a.move,x:a.target,f:a.fire,b});}\n stepWorld(w);\n if(w.wave\"'!==last){console.log('\"'wave',w.wave,w.time.toFixed(1),w.players[0].hp,w.stats);last=w.wave;}\n}\nconsole.log('end',w.phase,w.time,w.outcome,w.players.map(p=>p.hp),w.seen);\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module <<'JS'\nimport './vendor/engine/my-3d2dge.js';\nimport {createWorld,stepWorld,botAction,acceptAction} from './src/game/simulation.js';\nconsole.log('engine',globalThis.My3D2dge?.version);\nlet w=createWorld({seed:1982});let n=0,b=0,last=0;\nfor(let i=0;i<120*1200&&\"'!w.outcome;i++){\n if(i%8===0)for(const p of w.players){const a=botAction(w,p);if(a.brake)b++;acceptAction(w,p.id,{k:'\"'a',n:n++,m:a.move,x:a.target,f:a.fire,b});}\n stepWorld(w);\n if(w.wave\"'!==last){console.log('\"'wave',w.wave,w.time.toFixed(1),w.players[0].hp,w.stats);last=w.wave;}\n}\nconsole.log('end',w.phase,w.time,w.outcome,w.players.map(p=>p.hp),w.seen);\nJS\"","aggregated_output":"engine 0.89.1\nwave 1 21.3 3 { ships: 18, intercepts: 6, hits: 0, brakes: 0, bonus: 48 }\nwave 2 46.4 3 { ships: 38, intercepts: 16, hits: 0, brakes: 1, bonus: 116 }\nwave 3 66.6 3 { ships: 60, intercepts: 24, hits: 0, brakes: 1, bonus: 192 }\nwave 4 98.0 3 { ships: 84, intercepts: 35, hits: 0, brakes: 2, bonus: 268 }\nwave 5 129.1 3 { ships: 110, intercepts: 51, hits: 0, brakes: 3, bonus: 344 }\nwave 6 160.9 3 { ships: 138, intercepts: 68, hits: 0, brakes: 4, bonus: 420 }\nwave 7 209.7 3 { ships: 168, intercepts: 95, hits: 1, brakes: 7, bonus: 484 }\nwave 8 246.9 3 { ships: 200, intercepts: 116, hits: 1, brakes: 10, bonus: 560 }\nend ending 381.07499999981775 { won: true, reason: 'rift-sealed', score: 3430, tick: 45729 } [ 3 ] [\n  'wave0', 'dart',   'wave1',\n  'mine',  'wave2',  'roller',\n  'wave3', 'hunter', 'wave4',\n  'wave5', 'wave6',  'wave7',\n  'boss0', 'boss1',  'boss2'\n]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('PROGRESS.md');p.write_text(p.read_text()+'\\\\n## Simulation implemented\\\\n- Vendored my-3D2dge v0.89.1 at required commit and Hub client 1.4.0 at 35a1047f2067b2af3de3943f0fe452f39105d869 (unmodified).\\\\n- Implemented serializable 120 Hz authoritative world, seeded RNG, eight authored waves, three boss phases, integrity/recovery, all four threats, bounded ground sweeps, swept interception collision order, shared time brake and packet codec.\\\\n- Engine focused change: Settings \"'`persist:false` for session-only developer tuning.'\"\\\\n- Current work: native assets/renderer, shell menus/input/audio, transports, tests. No deliverable built yet.\\\\n')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
