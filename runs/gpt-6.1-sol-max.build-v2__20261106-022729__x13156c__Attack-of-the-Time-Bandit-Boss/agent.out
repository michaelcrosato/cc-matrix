{"type":"item.started","item":{"id":"item_77","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('tests/state.mjs');s=p.read_text();pos=s.index('  return { results, campaign: campaignResult };')\ns=s[:pos]+'''  test(\\\"all ten live balance values change their intended gameplay behavior\\\",()=>{\n    const make=(key,value)=>{const w=createWorld({tuning:{[key]:value}});startEncounter(w,0);return w;};\n    const displacement=(speed)=>{const w=make('playerSpeed',speed);acceptAction(w,0,{k:'a',n:1,m:1,x:null,f:false,b:0});run(w,.3);return w.players[0].x;};\n    assert(displacement(300)>displacement(120)+40);\n    const fall=(speed)=>{const w=make('missileSpeed',speed),t=spawnThreat(w,'dart',{x:550,y:120,warn:0});run(w,.4);return t.y;};\n    assert(fall(130)>fall(40)+25);\n    const turn=(rate)=>{const w=make('mineTurn',rate),t=spawnThreat(w,'mine',{x:500,y:100,warn:0});run(w,.4);return t.vx;};\n    assert(turn(2)<turn(.3)-15);\n    const sweep=(speed)=>{const w=make('rollerSpeed',speed),t=spawnThreat(w,'roller',{y:200,warn:0});w.players[0].x=38;t.ground=true;t.state='ground';t.y=304;t.x=t.from=250;t.to=360;t.life=3;run(w,.3);return t.x;};\n    assert(sweep(100)>sweep(30)+15);\n    const mark=(horizon)=>{const w=make('prediction',horizon);w.players[0].vx=100;return spawnThreat(w,'hunter',{x:500,y:100}).tx;};\n    assert(mark(1.2)>mark(.2)+80);\n    const shots=(interval)=>{const w=make('fireInterval',interval);startEncounter(w,8,0);w.boss.clock=3;let count=0;for(let i=0;i<300;i++){const a=botAction(w,w.players[0]);acceptAction(w,0,{k:'a',n:i,m:a.move,x:a.target,f:true,b:0});const before=w.eventId;stepWorld(w);count+=w.events.filter(e=>e.id>before&&e.type==='shot').length;}return count;};\n    assert(shots(.07)>shots(.4));\n    const attacks=(interval)=>{const w=make('enemyInterval',interval);w.attackClock=0;w.players[0].inv=99;let count=0;for(let i=0;i<900;i++){const before=w.eventId;stepWorld(w);count+=w.events.filter(e=>e.id>before&&e.type==='launch').length;}return count;};\n    assert(attacks(1)>attacks(5));\n    const duration=(seconds)=>{const w=make('brakeDuration',seconds);w.brake=100;activateBrake(w,0);run(w,1.1);return w.brakeLeft;};\n    assert(duration(.8)===0&&duration(2.5)>1);\n    const slowedFall=(factor)=>{const w=make('slowFactor',factor);w.brake=100;activateBrake(w,0);const t=spawnThreat(w,'dart',{x:550,y:150,warn:0});run(w,.4);return t.y;};\n    assert(slowedFall(.7)>slowedFall(.2)+10);\n    const charge=(gain)=>{const w=make('chargeGain',gain),p=w.players[0],t=spawnThreat(w,'dart',{x:p.x,y:280,warn:0});t.state='air';t.vy=0;w.shots=[{id:999,owner:0,x:p.x,y:302,px:p.x,py:302,r:3}];run(w,.05);return w.brake;};\n    assert(charge(2)>charge(.5));\n  });\n  test(\\\"four-pilot legitimate action campaign shares one outcome\\\",()=>{\n    const w=createWorld({seed:1982,seats:[{id:0},{id:1},{id:2},{id:3}]});let n=0,b=0;\n    for(let i=0;i<120*1000&&\"'!w.outcome;i++){\n      if(i%8===0)for(const p of w.players){const a=botAction(w,p);if(a.brake)b++;acceptAction(w,p.id,{k:'\"'a',n:++n,m:a.move,x:a.target,f:a.fire,b});}\n      stepWorld(w);\n    }\n    assert(w.outcome?.won);assert.equal(w.finishCount,1);assert.equal(w.clears.length,8);assert.equal(w.stats.ships,200);assert(\"'!w.modified);assert(w.players.every(p=>p.connected));\n  });\n'\"''' +s[pos:];p.write_text(s)\nPY\nbiome check --write --javascript-linter-enabled=false --css-linter-enabled=false --assist-enabled=false --javascript-formatter-indent-style=space --javascript-formatter-indent-width=2 tests/state.mjs\nnode tools/test.mjs state\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
