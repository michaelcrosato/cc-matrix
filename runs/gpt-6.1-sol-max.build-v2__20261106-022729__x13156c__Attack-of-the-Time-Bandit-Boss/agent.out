{"type":"item.completed","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -lc \"sed -n '429,460p' src/main.js && sed -n '1058,1148p' src/main.js && sed -n '20,58p' src/presentation/renderer.js && sed -n '70,104p' src/audio/sound.js && sed -n '145,165p' tests/browser.py && sed -n '595,615p' src/main.js\"","aggregated_output":"function playSetup() {\n  returnScreen = \"title\";\n  ui.show(\"setup\", {\n    kicker: \"YOUR CENTURY NEEDS YOU\",\n    title: \"Choose your timeline\",\n    text: \"Slide along the defense rail. Shoot the fleet and its weapons. Eight waves lead to the Bandit Boss.\",\n    actions: [\n      { label: \"Standard campaign\", primary: true, fn: () => startSolo(false) },\n      [\"Gentle timeline\", () => startSolo(true)],\n      [\"Back\", () => ui.back()],\n    ],\n    sections: [\n      [\n        \"STANDARD\",\n        \"Three integrity pips. One shot at a time. Earn the shared time brake by intercepting weapons.\",\n      ],\n      [\n        \"GENTLE TIMELINE\",\n        \"Automatic fire, slower hostile weapons and automatic emergency brake. Records are marked assisted.\",\n      ],\n    ],\n  });\n}\nfunction startSolo(gentle = false) {\n  if (hosted) return;\n  transport?.close();\n  transport = null;\n  game.live = false;\n  game.o.autoPause = true;\n  if (gentle) {\n    game.settings.set(\"assistance\", true);\n  }\n      ],\n    ],\n    actions: transport\n      ? [\n          ...(transport.isHost\n            ? [[\"Return to room / Replay\", () => transport.lobby()]]\n            : []),\n          [\"Leave room\", leaveRoom],\n        ]\n      : [\n          [\n            \"Retry campaign\",\n            () => {\n              startRun(seedValue(), [{ id: 0, name: \"PILOT 1\" }], false);\n            },\n          ],\n          [\"Save six-letter record\", saveRecord],\n          [\"High scores\", showScores],\n          [\n            \"Reset tuning & retry\",\n            () => {\n              resetTuning();\n              startSolo(false);\n            },\n          ],\n          [\"Title\", title],\n        ],\n  });\n}\nfunction recordMode() {\n  return world.modified\n    ? \"modified\"\n    : world.assisted || Object.values(world.assists || {}).some(Boolean)\n      ? \"assisted\"\n      : world.players.length > 1\n        ? \"coop\"\n        : \"solo\";\n}\nfunction getRecords() {\n  const value = E.store.get(\"tbb:records:v1\", []);\n  return Array.isArray(value)\n    ? value\n        .filter(\n          (r) =>\n            r &&\n            typeof r.name === \"string\" &&\n            r.name.length === 6 &&\n            Number.isFinite(r.score),\n        )\n        .slice(0, 30)\n    : [];\n}\nfunction saveRecord() {\n  if (\n    !world ||\n    world.modified ||\n    world.demo ||\n    scoreSaved ||\n    transport ||\n    hosted\n  ) {\n    ui.toast(\n      \"Record unavailable\",\n      scoreSaved\n        ? \"This record is already saved.\"\n        : \"Developer and demonstration runs do not enter the table.\",\n    );\n    return;\n  }\n  characterPicker(\n    \"Your six-letter callsign\",\n    \"PILOTX\",\n    6,\n    \"ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\",\n    (name) => {\n      const rows = getRecords();\n      rows.push({ name, score: world.score, mode: recordMode() });\n      rows.sort((a, b) => b.score - a.score);\n      E.store.set(\"tbb:records:v1\", rows.slice(0, 30));\n      scoreSaved = true;\n      ui.toast(\"Record saved\", name + \" · \" + world.score);\n      showScores();\n    },\n  );\n}\nfunction showScores() {\n  const rows = getRecords();\n  ui.show(\"records\", {\n    kicker: \"LOCAL FLIGHT RECORDS\",\n    title: \"Seconds to remember\",\n    text: rows.length\n      \".......aaaa.......\",\n      \".....aaAHHaaa.....\",\n      \"....aAHHHHHAaa....\",\n      \"..aaAALLLLLAAaaa..\",\n      \".bBBBBBBBBBBBBBbb.\",\n      \"bBLLLLLLLLLLLLLBbb\",\n      \"..BBdddddddddBB...\",\n      \"....cc.c.c.cc.....\",\n      \".....c...c.......\",\n    ];\n    this.hulls = [\"#718bff\", \"#f5a95f\", \"#a696f5\"].map((c) => {\n      const t = E.tones(c);\n      const palette = {\n        a: t.sh,\n        A: t.base,\n        H: t.hi,\n        L: t.lt,\n        b: t.deep,\n        B: t.base,\n        d: \"#10273d\",\n        c: \"#91f8e4\",\n      };\n      return E.anim(\n        [\n          E.sprite(dome, palette),\n          E.sprite(\n            dome.map((row, i) => (i === 7 ? row.replaceAll(\"c\", \"L\") : row)),\n            palette,\n          ),\n        ],\n        5,\n        { pingpong: true },\n      );\n    });\n    this.pilotSprites = PILOT_COLORS.map((c, i) => {\n      const t = E.tones(c);\n      let body = [\n        \"........W........\",\n        \"........W........\",\n    this.enabled = false;\n    this.stopped = false;\n    const A = game.audio;\n    const sounds = {\n      shot: { wave: \"triangle\", freq: 900, to: 220, dur: 0.075, vol: 0.14 },\n      dart: { wave: \"sine\", freq: 560, to: 290, dur: 0.15, vol: 0.16 },\n      mine: { wave: \"pulse\", freq: 260, to: 150, dur: 0.25, vol: 0.13 },\n      roller: { wave: \"triangle\", freq: 100, to: 260, dur: 0.25, vol: 0.25 },\n      hunter: { wave: \"sine\", freq: 900, to: 1450, dur: 0.3, vol: 0.11 },\n      intercept: { wave: \"noise\", freq: 1300, to: 180, dur: 0.12, vol: 0.13 },\n      kill: { wave: \"noise\", freq: 800, to: 100, dur: 0.24, vol: 0.17 },\n      hit: { wave: \"saw\", freq: 180, to: 40, dur: 0.4, vol: 0.24 },\n      land: { wave: \"noise\", freq: 300, to: 80, dur: 0.2, vol: 0.23 },\n      brake: { wave: \"sine\", freq: 900, to: 65, dur: 0.7, vol: 0.21 },\n      release: { wave: \"sine\", freq: 90, to: 540, dur: 0.3, vol: 0.15 },\n      charged: {\n        wave: \"triangle\",\n        freq: 660,\n        arp: [0, 4, 7, 12],\n        step: 0.05,\n        dur: 0.3,\n        vol: 0.16,\n      },\n      weakpoint: { wave: \"triangle\", freq: 400, to: 800, dur: 0.2, vol: 0.16 },\n      shield: { wave: \"sine\", freq: 420, to: 190, dur: 0.16, vol: 0.13 },\n      phaseBreak: { wave: \"noise\", freq: 750, to: 100, dur: 0.7, vol: 0.25 },\n      hullHit: { wave: \"triangle\", freq: 550, to: 350, dur: 0.055, vol: 0.1 },\n      bossHit: { wave: \"pulse\", freq: 290, to: 420, dur: 0.09, vol: 0.12 },\n      blocked: { wave: \"sine\", freq: 170, dur: 0.09, vol: 0.12 },\n      clear: {\n        wave: \"triangle\",\n        freq: 400,\n        arp: [0, 4, 7],\n        step: 0.09,\n        dur: 0.4,\n\n    def pad_play():\n        page.evaluate(\"window.__pad.axes[0]=.85\")\n        advance(page, 0.2)\n        x = page.evaluate(\"TimeBandit.world.players[0].x\")\n        expect(page.evaluate(\"game.input.lastDevice==='gamepad'\"))\n        page.evaluate(\n            \"window.__pad.axes[0]=0;window.__pad.buttons[0]={pressed:true,value:1}\"\n        )\n        advance(page, 0.1)\n        page.evaluate(\"window.__pad.buttons[0]={pressed:false,value:0}\")\n        advance(page, 0.02)\n        page.evaluate(\n            \"TimeBandit.world.brake=100;window.__pad.buttons[2]={pressed:true,value:1}\"\n        )\n        advance(page, 0.03)\n        page.evaluate(\"window.__pad.buttons[2]={pressed:false,value:0}\")\n        advance(page, 0.025)\n        expect(page.evaluate(\"TimeBandit.world.stats.brakes===1\"))\n        capture(page, \"brake.png\")\n        key(page, \"a\", 0.1)\n  } else {\n    const action = inputAction();\n    netInput += dt;\n    if (netInput >= 1 / 12) {\n      netInput %= 1 / 12;\n      transport.sendAction(action);\n    }\n  }\n  const fresh = art.ingest(world);\n  sound.events(fresh);\n  if (world.phase === \"finale\") sound.music(\"boss\");\n  else if (world.phase === \"ending\") sound.music(\"victory\");\n  else if (world.phase === \"results\")\n    sound.music(world.outcome?.won ? \"victory\" : \"failure\");\n  else sound.music(world.wave >= 4 ? \"escalation\" : \"combat\");\n  if (world.outcome && hosted && transport.isHost) transport.finish(world);\n  if (world.phase === \"results\" && !ui.screen && !hosted) showResults();\n  setPrompt();\n}\nfunction drawWorld(r) {\n  let state = world;\n","exit_code":0,"status":"completed"}}
