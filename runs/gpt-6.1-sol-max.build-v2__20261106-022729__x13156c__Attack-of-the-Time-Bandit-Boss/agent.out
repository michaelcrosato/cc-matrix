{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"cat > tests/smoke.py <<'EOF'\nimport json\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nroot=Path(__file__).resolve().parents[1]\nconfig=json.loads((root.parent/'build-config.json').read_text())\nurl=(root.parent/(config['base']+'.html')).as_uri()+'?test=1'\nwith sync_playwright() as p:\n browser=p.chromium.launch(headless=True,args=['--autoplay-policy=no-user-gesture-required'])\n page=browser.new_page(viewport={'width':1920,'height':1080})\n errors=[]\n page.on('pageerror',lambda e:errors.append(str(e)))\n page.goto(url)\n page.wait_for_function(\\\"document.body.dataset.booted === 'true'\\\")\n print('boot',page.evaluate('TimeBandit.snapshot()'))\n page.screenshot(path=str(root/'artifacts/title.png'))\n page.get_by_role('button',name='Play campaign',exact=True).click()\n page.get_by_role('button',name='Standard campaign',exact=True).click()\n page.wait_for_timeout(300)\n page.evaluate('game.stop(); game.advance(6)')\n print('play',page.evaluate('TimeBandit.snapshot()'))\n page.screenshot(path=str(root/'artifacts/combat.png'))\n print('errors',errors)\n browser.close()\nEOF\n/home/micha/.local/share/pipx/venvs/playwright/bin/python tests/smoke.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"cat > tests/smoke.py <<'EOF'\nimport json\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nroot=Path(__file__).resolve().parents[1]\nconfig=json.loads((root.parent/'build-config.json').read_text())\nurl=(root.parent/(config['base']+'.html')).as_uri()+'?test=1'\nwith sync_playwright() as p:\n browser=p.chromium.launch(headless=True,args=['--autoplay-policy=no-user-gesture-required'])\n page=browser.new_page(viewport={'width':1920,'height':1080})\n errors=[]\n page.on('pageerror',lambda e:errors.append(str(e)))\n page.goto(url)\n page.wait_for_function(\\\"document.body.dataset.booted === 'true'\\\")\n print('boot',page.evaluate('TimeBandit.snapshot()'))\n page.screenshot(path=str(root/'artifacts/title.png'))\n page.get_by_role('button',name='Play campaign',exact=True).click()\n page.get_by_role('button',name='Standard campaign',exact=True).click()\n page.wait_for_timeout(300)\n page.evaluate('game.stop(); game.advance(6)')\n print('play',page.evaluate('TimeBandit.snapshot()'))\n page.screenshot(path=str(root/'artifacts/combat.png'))\n print('errors',errors)\n browser.close()\nEOF\n/home/micha/.local/share/pipx/venvs/playwright/bin/python tests/smoke.py\"","aggregated_output":"boot {'title': 'Attack of the Time Bandit Boss', 'scene': 'title', 'screen': 'title', 'paused': False, 'demo': False, 'hosted': False, 'server': False, 'terminated': False, 'seed': None, 'tick': None, 'phase': None, 'wave': None, 'bossPhase': None, 'score': None, 'players': None, 'enemies': None, 'threats': None, 'brake': None, 'seen': None, 'modified': None, 'music': 0.1, 'input': 'keyboard', 'packets': None, 'errors': []}\nplay {'title': 'Attack of the Time Bandit Boss', 'scene': 'play', 'screen': None, 'paused': False, 'demo': False, 'hosted': False, 'server': False, 'terminated': False, 'seed': 58335896, 'tick': 764, 'phase': 'playing', 'wave': 0, 'bossPhase': 0, 'score': 0, 'players': [{'id': 0, 'x': 170, 'hp': 3, 'connected': True}], 'enemies': 18, 'threats': [], 'brake': 0, 'seen': ['wave0'], 'modified': False, 'music': 0.1, 'input': 'keyboard', 'packets': None, 'errors': []}\nerrors []\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"sed -n '2840,2879p' vendor/engine/my-3d2dge.js && rg -n 'void|pause\\\\(|return.*time' vendor/hub/session.js | tail -15\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"sed -n '2840,2879p' vendor/engine/my-3d2dge.js && rg -n 'void|pause\\\\(|return.*time' vendor/hub/session.js | tail -15\"","aggregated_output":"   * that catches what a player would see break). Returns the updates run\n   */\n  advance(seconds = this.o.step, o = {}) {\n    if (!this.scene && !this._next) throw new Error('game.advance() needs a started game: game.start({ update, draw }) first');\n    this._acc += Math.max(0, seconds);\n    const n = this._steps(); this.stats.steps = n;\n    if (this.r && (this.headless ? this.o.draw : o.draw)) try { this._frame(); } catch (e) { this.fail('draw', e); }\n    return n;\n  }\n  /**\n   * the clock: an exact fixed step. Real time (at most 50 ms a frame, so a stall can't run away) fills an accumulator;\n   * each whole o.step of it (1/120 s) runs one update of o.step * timeScale game seconds (split in two or more when\n   * timeScale > 1, so no step is longer than o.step), and the remainder waits for the next frame (game.alpha = its\n   * fraction of a step). 60 Hz runs two steps a frame, 120 Hz one, 144 Hz one on most frames: the same steps at any rate.\n   * Slow motion makes steps shorter, never fewer. Paused or at timeScale 0 the steps still run (dt 0), so input ticks.\n   * The first frame always updates (with dt 0 when its time is short of a step), so draw never comes before update.\n   * Returns the updates run\n   */\n  _run(real) { this._acc += Math.min(.05, real); return this._steps(); }\n  /** run the whole steps the accumulator holds (see _run) */\n  _steps() {\n    const step = this.o.step; let n = 0;\n    try {\n      while (this._acc > step - 1e-9) {   // (the tolerance absorbs the rounding in frame times: 1/60 s is two steps)\n        this._acc -= step; this._wall += step;   // (_wall: seconds stepped through, unscaled: slow motion or a stop doesn't hold up the player's zoom)\n        const k = this.timeScale > 1 ? Math.ceil(this.timeScale - 1e-9) : 1, h = step * Math.max(0, this.timeScale) / k;\n        for (let i = 0; i < k; i++, n++) this._step(h);\n      }\n      if (!n && !this._stepped) { n++; this._step(0); }   // the first frame updates before it draws, even when its time is short\n    } catch (e) { this._acc %= step; this.fail('update', e); }   // an error drops the frame's other steps, as before\n    if (n) this._stepped = true;\n    if (this._acc < 0) this._acc = 0;\n    this.alpha = this._acc / step;\n    return n;\n  }\n  /**\n   * switch scene: game.go('play', { level: 2 }). It fades through black (dithered) unless opts.fade is 0 (a cut) or another\n   * number of seconds; opts.fade can name a transition instead: 'black', 'white', 'wipe', 'iris', 'mosaic', 'swirl' or\n   * 'dissolve', each way taking opts.seconds (.4), round opts.at (iris and swirl: a world point { x, y, z }, which each\n   * scene's camera places, or [x, y] on the screen; its centre by default). With reduce motion each is a plain fade\n432:    if (!own(fields, 'time') && !own(fields, 'score')) return warn('result needs a finite time or score');\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"cat >> src/style.css <<'EOF'\n.esh .esh-ttl{padding:18px 28px}.esh .esh-ttl>div{max-width:460px;max-height:100%;overflow:auto;padding-right:5px;scrollbar-width:thin}.esh .esh-ttl h1{font-size:42px;max-width:460px;line-height:1.01}.esh .esh-ttl p{display:none}.esh .esh-ttl .esh-sub{margin:9px 0;font-size:15px}.esh .esh-ttl .esh-btns{margin-top:13px;gap:6px}.esh .esh-ttl button{padding:8px 14px;min-height:38px}.esh .esh-ttl .esh-tags{margin-top:13px}.esh .esh-ttl>div>.esh-m{margin-top:10px;font-size:7px}#device-prompt{left:4%;transform:none;bottom:9px;padding:2px 6px;background:transparent;font-size:clamp(10px,1vw,16px)}\n@media(max-width:600px){.esh .esh-ttl h1{font-size:36px;max-width:360px}.esh .esh-ttl{padding:20px}.esh .esh-ttl .esh-btns{max-width:330px}.esh .esh-ttl .esh-tags{font-size:8px;gap:8px}.esh .esh-ttl>div>.esh-m{max-width:290px}}\n@media(max-height:500px){.esh .esh-ttl h1{font-size:30px;max-width:430px}.esh .esh-ttl button{min-height:32px;padding:6px 12px}.esh .esh-ttl .esh-sub{font-size:12px;margin:5px 0}.esh .esh-ttl .esh-btns{gap:4px;margin-top:8px}.esh .esh-ttl .esh-tags{margin-top:9px;font-size:8px}}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('src/main.js');s=p.read_text().replace(\\\"I.label('fire')+' FIRE   '+I.label('bomb')+' BRAKE   OPTIONS MENU'\\\",\\\"I.label('fire')+' FIRE · STICK MOVE'\\\").replace(\\\"'A D / ← → MOVE   SPACE FIRE   SHIFT BRAKE   ESC MENU'\\\",\\\"'A D / ← → MOVE · '+I.label('fire')+' FIRE'\\\");p.write_text(s)\nPY\ncat > tests/state.mjs <<'EOF'\nimport assert from 'node:assert/strict';\nimport '../vendor/engine/my-3d2dge.js';\nimport {DEFAULTS,WEAPONS,WAVES,BOSS_PHASES,validateContent,ARENA} from '../src/content/campaign.js';\nimport {createWorld,stepWorld,startEncounter,spawnThreat,acceptAction,activateBrake,leaveWorld,finishWorld,sweptHit,botAction,worldPacket,applyWorldPacket} from '../src/game/simulation.js';\nexport function stateTests(){const results=[];const test=(name,fn)=>{try{fn();results.push({name,pass:true});}catch(e){results.push({name,pass:false,error:e.stack});}};\nconst run=(w,seconds)=>{for(let i=0;i<seconds*120;i++)stepWorld(w);};\nconst play=()=>{const w=createWorld();startEncounter(w,0);return w;};\ntest('authored campaign and immutable baseline',()=>{assert.deepEqual(validateContent(),[]);assert.equal(WAVES.length,8);assert.equal(BOSS_PHASES.length,3);assert(Object.isFrozen(DEFAULTS));});\ntest('action ownership, finite ranges and sequence validation',()=>{const w=play();assert(\"'!acceptAction(w,7,{k:'\"'a',n:0,m:0,x:null,f:true,b:0}));for(const bad of [{m:NaN},{x:999},{f:1},{b:Infinity},{n:-1}])assert(\"'!acceptAction(w,0,{k:'\"'a',n:0,m:0,x:null,f:false,b:0,...bad}));assert(acceptAction(w,0,{k:'a',n:1,m:1,x:null,f:true,b:0}));assert(\"'!acceptAction(w,0,{k:'\"'a',n:1,m:0,x:null,f:false,b:0}));});\ntest('stale movement and fire expire',()=>{const w=play();acceptAction(w,0,{k:'a',n:0,m:1,x:null,f:true,b:0});run(w,.5);const x=w.players[0].x;run(w,1);assert.equal(w.players[0].x,x);assert.equal(w.players[0].vx,0);});\ntest('one live normal shot per player and no friendly fire',()=>{const w=createWorld({seats:[{id:0},{id:1}]});startEncounter(w,0);for(let i=0;i<120;i++){for(const p of w.players)acceptAction(w,p.id,{k:'a',n:i,m:0,x:320,f:true,b:0});stepWorld(w);assert(w.shots.filter(s=>s.owner===0).length<=1);assert(w.shots.filter(s=>s.owner===1).length<=1);}assert(w.players.every(p=>p.hp===3));});\ntest('fast shot swept test catches a thin moving target',()=>{assert(sweptHit({px:100,py:310,x:100,y:250},{px:100,py:280,x:102,y:281},6));assert(\"'!sweptHit({px:10,py:310,x:10,y:250},{px:100,py:280,x:102,y:281},6));});\ntest('\"'intercept removals precede hostile damage',()=>{const w=play();w.enemies=[{id:1,x:320,y:80,px:320,py:80,d:-900,hp:2}];const p=w.players[0];p.x=170;const t=spawnThreat(w,'dart',{x:p.x,y:p.y-11,warn:0});t.state='air';t.vy=0;w.shots=[{id:10,owner:0,x:p.x,y:p.y-2,px:p.x,py:p.y-2,r:3}];stepWorld(w);assert.equal(p.hp,3);assert.equal(w.stats.intercepts,1);assert.equal(w.score,2);assert.equal(w.threats.length,0);});\ntest('one overlap produces one hit and recovery interval',()=>{const w=play();const p=w.players[0];for(let i=0;i<5;i++){const t=spawnThreat(w,'dart',{x:p.x,y:p.y,warn:0});t.state='air';t.vy=0;}stepWorld(w);assert.equal(p.hp,2);assert.equal(w.stats.hits,1);assert.equal(w.events.filter(e=>e.type==='hit').length,1);assert(p.inv>2);});\ntest('solo loss and terminal state are idempotent',()=>{const w=play();w.players[0].hp=1;const p=w.players[0],t=spawnThreat(w,'dart',{x:p.x,y:p.y,warn:0});t.state='air';t.vy=0;stepWorld(w);assert.equal(w.phase,'results');assert.equal(w.outcome.won,false);const tick=w.tick;run(w,1);assert.equal(w.tick,tick);assert(\"'!finishWorld(w,true));assert.equal(w.finishCount,1);});\ntest('\"'partial co-op disable recovers at clear',()=>{const w=createWorld({seats:[{id:0},{id:1}]});startEncounter(w,0);w.players[0].hp=0;w.enemies=[];stepWorld(w);assert.equal(w.phase,'intermission');assert.equal(w.players[0].hp,1);assert(\"'!w.outcome);assert.equal(w.threats.length,0);});\ntest('\"'departed pilot cannot keep team alive',()=>{const w=createWorld({seats:[{id:0},{id:1}]});startEncounter(w,0);w.players[0].hp=0;leaveWorld(w,1);assert(w.outcome);assert.equal(w.finishCount,1);});\ntest('simultaneous brake requests activate once',()=>{const w=createWorld({seats:[{id:0},{id:1}]});startEncounter(w,0);w.brake=100;for(const p of w.players)acceptAction(w,p.id,{k:'a',n:1,m:0,x:null,f:false,b:1});stepWorld(w);assert.equal(w.stats.brakes,1);assert.equal(w.events.filter(e=>e.type==='brake').length,1);w.brake=100;run(w,3);assert.equal(w.stats.brakes,1);});\ntest('brake affects hostile motion but not player or shots',()=>{const a=play(),b=play();a.brake=100;activateBrake(a,0);for(const w of [a,b]){const t=spawnThreat(w,'dart',{x:600,y:160,warn:0});t.state='air';acceptAction(w,0,{k:'a',n:0,m:1,x:null,f:true,b:0});}run(a,.3);run(b,.3);assert.equal(a.players[0].x,b.players[0].x);assert.equal(a.shots[0]?.y,b.shots[0]?.y);assert(Math.abs((a.threats[0].y-160)/(b.threats[0].y-160)-DEFAULTS.slowFactor)<.02);});\ntest('brake ends without catch-up attacks',()=>{const w=play();w.brake=100;activateBrake(w,0);w.attackClock=1;run(w,1.7);assert.equal(w.brakeLeft,0);assert(w.attackClock>0);assert.equal(w.threats.length,0);});\ntest('dart falls with limited lateral drift',()=>{const w=play();const t=spawnThreat(w,'dart',{x:400,y:100,warn:0});run(w,.5);assert(t.y>130);assert(Math.abs(t.x-400)<7);});\ntest('mine turns toward host-selected target at bounded rate',()=>{const w=play();const t=spawnThreat(w,'mine',{x:400,y:150,warn:0});run(w,.3);assert(t.vx<0);assert(t.vy>0);assert(Math.abs(Math.atan2(t.vy,t.vx)-Math.PI/2)<=DEFAULTS.mineTurn*.31);});\ntest('hunter predicts once, warns and then commits',()=>{const w=play(),p=w.players[0];p.vx=100;const t=spawnThreat(w,'hunter',{x:320,y:100,warn:.6});const mark=t.tx;p.x=500;p.vx=-200;run(w,.4);assert.equal(t.tx,mark);assert.equal(t.state,'warn');run(w,.3);assert.equal(t.state,'air');assert(t.vx<0);const vx=t.vx;p.x=100;run(w,.3);assert.equal(t.vx,vx);});\ntest('roller lands, remains unshootable and has bounded expiry',()=>{const w=play();const t=spawnThreat(w,'roller',{y:250,warn:0});assert(t);w.players[0].x=590;run(w,1.1);assert(t.ground);assert.equal(t.state,'ground');assert(Math.abs(t.to-t.from)<=111);run(w,2.5);assert(\"'!w.threats.includes(t));});\ntest('\"'roller sweep leaves a reachable escape and reserves its refuge',()=>{for(const x of [38,100,300,500,602]){const w=play();w.players[0].x=x;const r=spawnThreat(w,'roller',{y:160,warn:.7});assert(r);const lo=Math.min(r.from,r.to)-24,hi=Math.max(r.from,r.to)+24;assert(lo>ARENA.left||hi<ARENA.right);const escape=Math.min(Math.abs(x-lo),Math.abs(x-hi));assert(escape<DEFAULTS.playerSpeed*((304-160)/61+.7));assert.equal(spawnThreat(w,'dart',{x:r.safe,y:280}),null);}});\ntest('wave clear cancels every threat before intermission',()=>{const w=play();spawnThreat(w,'hunter');spawnThreat(w,'mine');w.enemies=[];stepWorld(w);assert.equal(w.phase,'intermission');assert.equal(w.threats.length,0);assert.equal(w.shots.length,0);run(w,3.3);assert.equal(w.wave,1);});\ntest('boss armored and open states have distinct damage rules',()=>{const w=play();startEncounter(w,8,0);w.boss.clock=0;w.boss.x=320;w.shots=[{id:1,owner:0,x:320,y:125,px:320,py:125,r:3}];const hp=w.boss.hp;stepWorld(w);assert.equal(w.boss.hp,hp);w.boss.clock=4;w.shots=[{id:2,owner:0,x:w.boss.x,y:w.boss.y+8,px:w.boss.x,py:w.boss.y+8,r:3}];stepWorld(w);assert.equal(w.boss.hp,hp-1);});\ntest('inherited nonstandard tuning is marked and resettable',()=>{const w=createWorld({tuning:{playerSpeed:DEFAULTS.playerSpeed+10}});assert(w.modified);assert(\"'!createWorld().modified);assert.equal(DEFAULTS.playerSpeed,220);});\ntest('\"'compact snapshot roundtrip preserves shared gameplay',()=>{const w=createWorld({seats:[{id:0},{id:1},{id:2},{id:3}]});startEncounter(w,7);run(w,8);const packet=worldPacket(w),out=applyWorldPacket(null,packet,w.players);assert(out);assert.equal(out.tick,w.tick);assert.equal(out.enemies.length,w.enemies.length);assert.equal(out.score,w.score);assert.equal(out.players.length,4);assert(Buffer.byteLength(JSON.stringify(packet))<16384);assert(\"'!applyWorldPacket(out,{...packet,n:-1},w.players));});\ntest('\"'malformed and nonfinite authoritative packet rejected',()=>{const p=worldPacket(play());assert(\"'!applyWorldPacket(null,{...p,ps:[[0,0,NaN,3,0,0,1,0,0,0]]}));assert(!applyWorldPacket(null,{...p,es:new Array(65).fill([])}));});\ntest('\"'render-independent seed replay is deterministic',()=>{const a=play(),b=play();for(let i=0;i<120*10;i++){for(const w of [a,b]){if(i%8===0){const bot=botAction(w,w.players[0]);acceptAction(w,0,{k:'a',n:i,m:bot.move,x:bot.target,f:true,b:0});}stepWorld(w);}}assert.deepEqual(a,b);});\nlet campaignResult;\ntest('legitimate whole campaign clears eight waves and three boss phases',()=>{const w=createWorld({seed:1982});let seq=0,brake=0,maxBytes=0;for(let i=0;i<120*1200&&\"'!w.outcome;i++){if(i%8===0)for(const p of w.players){const a=botAction(w,p);if(a.brake)brake++;acceptAction(w,p.id,{k:'\"'a',n:++seq,m:a.move,x:a.target,f:a.fire,b:brake});}stepWorld(w);if(i%120===0)maxBytes=Math.max(maxBytes,Buffer.byteLength(JSON.stringify(worldPacket(w))));}assert(w.outcome?.won);assert.equal(w.finishCount,1);assert.equal(w.clears.length,8);for(let i=0;i<3;i++)assert(w.seen.includes('boss'+i));for(const k of Object.keys(WEAPONS))assert(w.seen.includes(k));assert(\"'!w.modified);assert.equal(w.assists.autoFire,false);assert.equal(w.stats.ships,200);assert(w.stats.brakes>0);assert(w.stats.intercepts>0);assert(maxBytes<16384);run(w,6.1);assert.equal(w.phase,'\"'results');campaignResult={seconds:w.time,score:w.score,stats:w.stats,seen:w.seen,maxSnapshotBytes:maxBytes,seed:w.seed,health:w.players.map(p=>p.hp)};});\ntest('native game.advance drives canonical 120 Hz simulation',()=>{const E=globalThis.My3D2dge,g=new E.Game({headless:true,res:[640,360],view:'overhead',menu:false}),w=createWorld();g.start({update:dt=>stepWorld(w,dt),draw(){}});g.advance(2);assert.equal(w.tick,240);assert.equal(w.phase,'playing');assert.deepEqual(g.errors,[]);g.dispose();});\nreturn{results,campaign:campaignResult};}\nEOF\ncat > tools/test.mjs <<'EOF'\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport {fileURLToPath} from 'node:url';\nimport {spawnSync} from 'node:child_process';\nimport {stateTests} from '../tests/state.mjs';\nconst root=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'..');\nlet results=[];\nconst requested=process.argv.slice(2);const all=\"'!requested.length;\nif(all||requested.includes('\"'state')){const state=stateTests();results.push(...state.results);fs.writeFileSync(path.join(root,'artifacts/state-results.json'),JSON.stringify(state,null,2));}\nfor(const target of ['browser','network'])if(all||requested.includes(target)){\n const run=spawnSync('/home/micha/.local/share/pipx/venvs/playwright/bin/python',[path.join(root,'tests',target+'.py')],{cwd:root,encoding:'utf8',timeout:240000});\n fs.writeFileSync(path.join(root,'artifacts',target+'-runner.log'),run.stdout+'\\\\n'+run.stderr);\n let report;try{report=JSON.parse(run.stdout.trim());}catch{report={results:[{name:target+' runner',pass:false,error:run.stderr||run.stdout||'Runner did not return a report'}]};}\n results.push(...report.results);fs.writeFileSync(path.join(root,'artifacts',target+'-results.json'),JSON.stringify(report,null,2));\n}\nfor(const r of results)if(\"'!r.pass)console.log('\"'FAIL '+r.name+'\\\\n'+r.error);\nconst failed=results.filter(r=>\"'!r.pass).length;console.log(`${results.length-failed}/${results.length} checks passed; ${failed} failures.`);process.exitCode=failed?1:0;\nEOF\nnode tools/build.mjs --quiet\nnode tools/test.mjs state'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"cat >> src/style.css <<'EOF'\n.esh .esh-ttl{padding:18px 28px}.esh .esh-ttl>div{max-width:460px;max-height:100%;overflow:auto;padding-right:5px;scrollbar-width:thin}.esh .esh-ttl h1{font-size:42px;max-width:460px;line-height:1.01}.esh .esh-ttl p{display:none}.esh .esh-ttl .esh-sub{margin:9px 0;font-size:15px}.esh .esh-ttl .esh-btns{margin-top:13px;gap:6px}.esh .esh-ttl button{padding:8px 14px;min-height:38px}.esh .esh-ttl .esh-tags{margin-top:13px}.esh .esh-ttl>div>.esh-m{margin-top:10px;font-size:7px}#device-prompt{left:4%;transform:none;bottom:9px;padding:2px 6px;background:transparent;font-size:clamp(10px,1vw,16px)}\n@media(max-width:600px){.esh .esh-ttl h1{font-size:36px;max-width:360px}.esh .esh-ttl{padding:20px}.esh .esh-ttl .esh-btns{max-width:330px}.esh .esh-ttl .esh-tags{font-size:8px;gap:8px}.esh .esh-ttl>div>.esh-m{max-width:290px}}\n@media(max-height:500px){.esh .esh-ttl h1{font-size:30px;max-width:430px}.esh .esh-ttl button{min-height:32px;padding:6px 12px}.esh .esh-ttl .esh-sub{font-size:12px;margin:5px 0}.esh .esh-ttl .esh-btns{gap:4px;margin-top:8px}.esh .esh-ttl .esh-tags{margin-top:9px;font-size:8px}}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('src/main.js');s=p.read_text().replace(\\\"I.label('fire')+' FIRE   '+I.label('bomb')+' BRAKE   OPTIONS MENU'\\\",\\\"I.label('fire')+' FIRE · STICK MOVE'\\\").replace(\\\"'A D / ← → MOVE   SPACE FIRE   SHIFT BRAKE   ESC MENU'\\\",\\\"'A D / ← → MOVE · '+I.label('fire')+' FIRE'\\\");p.write_text(s)\nPY\ncat > tests/state.mjs <<'EOF'\nimport assert from 'node:assert/strict';\nimport '../vendor/engine/my-3d2dge.js';\nimport {DEFAULTS,WEAPONS,WAVES,BOSS_PHASES,validateContent,ARENA} from '../src/content/campaign.js';\nimport {createWorld,stepWorld,startEncounter,spawnThreat,acceptAction,activateBrake,leaveWorld,finishWorld,sweptHit,botAction,worldPacket,applyWorldPacket} from '../src/game/simulation.js';\nexport function stateTests(){const results=[];const test=(name,fn)=>{try{fn();results.push({name,pass:true});}catch(e){results.push({name,pass:false,error:e.stack});}};\nconst run=(w,seconds)=>{for(let i=0;i<seconds*120;i++)stepWorld(w);};\nconst play=()=>{const w=createWorld();startEncounter(w,0);return w;};\ntest('authored campaign and immutable baseline',()=>{assert.deepEqual(validateContent(),[]);assert.equal(WAVES.length,8);assert.equal(BOSS_PHASES.length,3);assert(Object.isFrozen(DEFAULTS));});\ntest('action ownership, finite ranges and sequence validation',()=>{const w=play();assert(\"'!acceptAction(w,7,{k:'\"'a',n:0,m:0,x:null,f:true,b:0}));for(const bad of [{m:NaN},{x:999},{f:1},{b:Infinity},{n:-1}])assert(\"'!acceptAction(w,0,{k:'\"'a',n:0,m:0,x:null,f:false,b:0,...bad}));assert(acceptAction(w,0,{k:'a',n:1,m:1,x:null,f:true,b:0}));assert(\"'!acceptAction(w,0,{k:'\"'a',n:1,m:0,x:null,f:false,b:0}));});\ntest('stale movement and fire expire',()=>{const w=play();acceptAction(w,0,{k:'a',n:0,m:1,x:null,f:true,b:0});run(w,.5);const x=w.players[0].x;run(w,1);assert.equal(w.players[0].x,x);assert.equal(w.players[0].vx,0);});\ntest('one live normal shot per player and no friendly fire',()=>{const w=createWorld({seats:[{id:0},{id:1}]});startEncounter(w,0);for(let i=0;i<120;i++){for(const p of w.players)acceptAction(w,p.id,{k:'a',n:i,m:0,x:320,f:true,b:0});stepWorld(w);assert(w.shots.filter(s=>s.owner===0).length<=1);assert(w.shots.filter(s=>s.owner===1).length<=1);}assert(w.players.every(p=>p.hp===3));});\ntest('fast shot swept test catches a thin moving target',()=>{assert(sweptHit({px:100,py:310,x:100,y:250},{px:100,py:280,x:102,y:281},6));assert(\"'!sweptHit({px:10,py:310,x:10,y:250},{px:100,py:280,x:102,y:281},6));});\ntest('\"'intercept removals precede hostile damage',()=>{const w=play();w.enemies=[{id:1,x:320,y:80,px:320,py:80,d:-900,hp:2}];const p=w.players[0];p.x=170;const t=spawnThreat(w,'dart',{x:p.x,y:p.y-11,warn:0});t.state='air';t.vy=0;w.shots=[{id:10,owner:0,x:p.x,y:p.y-2,px:p.x,py:p.y-2,r:3}];stepWorld(w);assert.equal(p.hp,3);assert.equal(w.stats.intercepts,1);assert.equal(w.score,2);assert.equal(w.threats.length,0);});\ntest('one overlap produces one hit and recovery interval',()=>{const w=play();const p=w.players[0];for(let i=0;i<5;i++){const t=spawnThreat(w,'dart',{x:p.x,y:p.y,warn:0});t.state='air';t.vy=0;}stepWorld(w);assert.equal(p.hp,2);assert.equal(w.stats.hits,1);assert.equal(w.events.filter(e=>e.type==='hit').length,1);assert(p.inv>2);});\ntest('solo loss and terminal state are idempotent',()=>{const w=play();w.players[0].hp=1;const p=w.players[0],t=spawnThreat(w,'dart',{x:p.x,y:p.y,warn:0});t.state='air';t.vy=0;stepWorld(w);assert.equal(w.phase,'results');assert.equal(w.outcome.won,false);const tick=w.tick;run(w,1);assert.equal(w.tick,tick);assert(\"'!finishWorld(w,true));assert.equal(w.finishCount,1);});\ntest('\"'partial co-op disable recovers at clear',()=>{const w=createWorld({seats:[{id:0},{id:1}]});startEncounter(w,0);w.players[0].hp=0;w.enemies=[];stepWorld(w);assert.equal(w.phase,'intermission');assert.equal(w.players[0].hp,1);assert(\"'!w.outcome);assert.equal(w.threats.length,0);});\ntest('\"'departed pilot cannot keep team alive',()=>{const w=createWorld({seats:[{id:0},{id:1}]});startEncounter(w,0);w.players[0].hp=0;leaveWorld(w,1);assert(w.outcome);assert.equal(w.finishCount,1);});\ntest('simultaneous brake requests activate once',()=>{const w=createWorld({seats:[{id:0},{id:1}]});startEncounter(w,0);w.brake=100;for(const p of w.players)acceptAction(w,p.id,{k:'a',n:1,m:0,x:null,f:false,b:1});stepWorld(w);assert.equal(w.stats.brakes,1);assert.equal(w.events.filter(e=>e.type==='brake').length,1);w.brake=100;run(w,3);assert.equal(w.stats.brakes,1);});\ntest('brake affects hostile motion but not player or shots',()=>{const a=play(),b=play();a.brake=100;activateBrake(a,0);for(const w of [a,b]){const t=spawnThreat(w,'dart',{x:600,y:160,warn:0});t.state='air';acceptAction(w,0,{k:'a',n:0,m:1,x:null,f:true,b:0});}run(a,.3);run(b,.3);assert.equal(a.players[0].x,b.players[0].x);assert.equal(a.shots[0]?.y,b.shots[0]?.y);assert(Math.abs((a.threats[0].y-160)/(b.threats[0].y-160)-DEFAULTS.slowFactor)<.02);});\ntest('brake ends without catch-up attacks',()=>{const w=play();w.brake=100;activateBrake(w,0);w.attackClock=1;run(w,1.7);assert.equal(w.brakeLeft,0);assert(w.attackClock>0);assert.equal(w.threats.length,0);});\ntest('dart falls with limited lateral drift',()=>{const w=play();const t=spawnThreat(w,'dart',{x:400,y:100,warn:0});run(w,.5);assert(t.y>130);assert(Math.abs(t.x-400)<7);});\ntest('mine turns toward host-selected target at bounded rate',()=>{const w=play();const t=spawnThreat(w,'mine',{x:400,y:150,warn:0});run(w,.3);assert(t.vx<0);assert(t.vy>0);assert(Math.abs(Math.atan2(t.vy,t.vx)-Math.PI/2)<=DEFAULTS.mineTurn*.31);});\ntest('hunter predicts once, warns and then commits',()=>{const w=play(),p=w.players[0];p.vx=100;const t=spawnThreat(w,'hunter',{x:320,y:100,warn:.6});const mark=t.tx;p.x=500;p.vx=-200;run(w,.4);assert.equal(t.tx,mark);assert.equal(t.state,'warn');run(w,.3);assert.equal(t.state,'air');assert(t.vx<0);const vx=t.vx;p.x=100;run(w,.3);assert.equal(t.vx,vx);});\ntest('roller lands, remains unshootable and has bounded expiry',()=>{const w=play();const t=spawnThreat(w,'roller',{y:250,warn:0});assert(t);w.players[0].x=590;run(w,1.1);assert(t.ground);assert.equal(t.state,'ground');assert(Math.abs(t.to-t.from)<=111);run(w,2.5);assert(\"'!w.threats.includes(t));});\ntest('\"'roller sweep leaves a reachable escape and reserves its refuge',()=>{for(const x of [38,100,300,500,602]){const w=play();w.players[0].x=x;const r=spawnThreat(w,'roller',{y:160,warn:.7});assert(r);const lo=Math.min(r.from,r.to)-24,hi=Math.max(r.from,r.to)+24;assert(lo>ARENA.left||hi<ARENA.right);const escape=Math.min(Math.abs(x-lo),Math.abs(x-hi));assert(escape<DEFAULTS.playerSpeed*((304-160)/61+.7));assert.equal(spawnThreat(w,'dart',{x:r.safe,y:280}),null);}});\ntest('wave clear cancels every threat before intermission',()=>{const w=play();spawnThreat(w,'hunter');spawnThreat(w,'mine');w.enemies=[];stepWorld(w);assert.equal(w.phase,'intermission');assert.equal(w.threats.length,0);assert.equal(w.shots.length,0);run(w,3.3);assert.equal(w.wave,1);});\ntest('boss armored and open states have distinct damage rules',()=>{const w=play();startEncounter(w,8,0);w.boss.clock=0;w.boss.x=320;w.shots=[{id:1,owner:0,x:320,y:125,px:320,py:125,r:3}];const hp=w.boss.hp;stepWorld(w);assert.equal(w.boss.hp,hp);w.boss.clock=4;w.shots=[{id:2,owner:0,x:w.boss.x,y:w.boss.y+8,px:w.boss.x,py:w.boss.y+8,r:3}];stepWorld(w);assert.equal(w.boss.hp,hp-1);});\ntest('inherited nonstandard tuning is marked and resettable',()=>{const w=createWorld({tuning:{playerSpeed:DEFAULTS.playerSpeed+10}});assert(w.modified);assert(\"'!createWorld().modified);assert.equal(DEFAULTS.playerSpeed,220);});\ntest('\"'compact snapshot roundtrip preserves shared gameplay',()=>{const w=createWorld({seats:[{id:0},{id:1},{id:2},{id:3}]});startEncounter(w,7);run(w,8);const packet=worldPacket(w),out=applyWorldPacket(null,packet,w.players);assert(out);assert.equal(out.tick,w.tick);assert.equal(out.enemies.length,w.enemies.length);assert.equal(out.score,w.score);assert.equal(out.players.length,4);assert(Buffer.byteLength(JSON.stringify(packet))<16384);assert(\"'!applyWorldPacket(out,{...packet,n:-1},w.players));});\ntest('\"'malformed and nonfinite authoritative packet rejected',()=>{const p=worldPacket(play());assert(\"'!applyWorldPacket(null,{...p,ps:[[0,0,NaN,3,0,0,1,0,0,0]]}));assert(!applyWorldPacket(null,{...p,es:new Array(65).fill([])}));});\ntest('\"'render-independent seed replay is deterministic',()=>{const a=play(),b=play();for(let i=0;i<120*10;i++){for(const w of [a,b]){if(i%8===0){const bot=botAction(w,w.players[0]);acceptAction(w,0,{k:'a',n:i,m:bot.move,x:bot.target,f:true,b:0});}stepWorld(w);}}assert.deepEqual(a,b);});\nlet campaignResult;\ntest('legitimate whole campaign clears eight waves and three boss phases',()=>{const w=createWorld({seed:1982});let seq=0,brake=0,maxBytes=0;for(let i=0;i<120*1200&&\"'!w.outcome;i++){if(i%8===0)for(const p of w.players){const a=botAction(w,p);if(a.brake)brake++;acceptAction(w,p.id,{k:'\"'a',n:++seq,m:a.move,x:a.target,f:a.fire,b:brake});}stepWorld(w);if(i%120===0)maxBytes=Math.max(maxBytes,Buffer.byteLength(JSON.stringify(worldPacket(w))));}assert(w.outcome?.won);assert.equal(w.finishCount,1);assert.equal(w.clears.length,8);for(let i=0;i<3;i++)assert(w.seen.includes('boss'+i));for(const k of Object.keys(WEAPONS))assert(w.seen.includes(k));assert(\"'!w.modified);assert.equal(w.assists.autoFire,false);assert.equal(w.stats.ships,200);assert(w.stats.brakes>0);assert(w.stats.intercepts>0);assert(maxBytes<16384);run(w,6.1);assert.equal(w.phase,'\"'results');campaignResult={seconds:w.time,score:w.score,stats:w.stats,seen:w.seen,maxSnapshotBytes:maxBytes,seed:w.seed,health:w.players.map(p=>p.hp)};});\ntest('native game.advance drives canonical 120 Hz simulation',()=>{const E=globalThis.My3D2dge,g=new E.Game({headless:true,res:[640,360],view:'overhead',menu:false}),w=createWorld();g.start({update:dt=>stepWorld(w,dt),draw(){}});g.advance(2);assert.equal(w.tick,240);assert.equal(w.phase,'playing');assert.deepEqual(g.errors,[]);g.dispose();});\nreturn{results,campaign:campaignResult};}\nEOF\ncat > tools/test.mjs <<'EOF'\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport {fileURLToPath} from 'node:url';\nimport {spawnSync} from 'node:child_process';\nimport {stateTests} from '../tests/state.mjs';\nconst root=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'..');\nlet results=[];\nconst requested=process.argv.slice(2);const all=\"'!requested.length;\nif(all||requested.includes('\"'state')){const state=stateTests();results.push(...state.results);fs.writeFileSync(path.join(root,'artifacts/state-results.json'),JSON.stringify(state,null,2));}\nfor(const target of ['browser','network'])if(all|