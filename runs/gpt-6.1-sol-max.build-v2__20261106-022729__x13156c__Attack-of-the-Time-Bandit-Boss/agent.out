{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,pathlib,urllib.request,concurrent.futures\nc=json.loads(pathlib.Path('build-config.json').read_text());d=pathlib.Path(c['base']);hub='35a1047f2067b2af3de3943f0fe452f39105d869'\nc['hubCommit']=hub;pathlib.Path('build-config.json').write_text(json.dumps(c,indent=2))\njobs=[]\nfor f in ['README.md','API.md','API-INDEX.md','docs/ASSETS.md','kits/arcade.js','kits/shooter.js','my-3d2dge.js']:\n jobs.append(('https://raw.githubusercontent.com/michaelcrosato/my-3d2dge/'+c['engineCommit']+'/dist/handoff/'+f,d/'vendor/engine'/f))\nfor f in ['README.md','session.js','examples/arena.html','harness.html']:\n jobs.append(('https://raw.githubusercontent.com/michaelcrosato/ai-hub/'+hub+'/lib/hub/'+f,d/'vendor/hub'/f))\nfor url,name in [('https://odyssey2.info/i/screens/time-scr.gif','source-screen.gif'),('https://odyssey2.info/i/boxes/us_attack-of-the-timelord-f.webp','source-box.webp')]:jobs.append((url,d/'docs'/name))\ndef get(job):\n url,path=job;path.parent.mkdir(parents=True,exist_ok=True)\n try:path.write_bytes(urllib.request.urlopen(url).read());return str(path)+': '+str(path.stat().st_size)\n except Exception as e:return str(path)+': '+str(e)\nwith concurrent.futures.ThreadPoolExecutor(max_workers=6) as ex:\n for out in ex.map(get,jobs):print(out)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
