{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"cat > src/presentation/renderer.js <<'EOF'\nimport { TITLE, ARENA, WAVES, WEAPONS, BOSS_PHASES } from '../content/campaign.js';\nexport const PILOT_COLORS=['#77e8f2','#ff9baa','#b9ef85','#bca0ff'];\nexport class Presentation {\n constructor(game){\n  this.game=game;this.E=globalThis.My3D2dge;this.fx=[];this.lastEvent=0;this.subtitle='';this.subtitleUntil=0;this.speaking=0;\n  const E=this.E;\n  const dome=['.......aaaa.......','.....aaAHHaaa.....','....aAHHHHHAaa....','..aaAALLLLLAAaaa..','.bBBBBBBBBBBBBBbb.','bBLLLLLLLLLLLLLBbb','..BBdddddddddBB...','....cc.c.c.cc.....','.....c...c.......'];\n  this.hulls=['#718bff','#f5a95f','#a696f5'].map(c=>{const t=E.tones(c);const palette={a:t.sh,A:t.base,H:t.hi,L:t.lt,b:t.deep,B:t.base,d:'#10273d',c:'#91f8e4'};return E.anim([E.sprite(dome,palette),E.sprite(dome.map((row,i)=>i===7?row.replaceAll('c','L'):row),palette)],5,{pingpong:true});});\n  this.pilotSprites=PILOT_COLORS.map((c,i)=>{\n   const t=E.tones(c);let body=[\n    '........W........','........W........','.......WWW.......','.......WHW.......','......WHAHW......','......WHHHW......','.....bWWWWWb.....','...bbBCCHCCBbb...','..bBBCCCHCCCBBb..','.bBBBCCCHCCCBBBb.','bBBHBBCCCCCBBHBBb','bBHHHBBBBBBBHHHBb','bBBBBBDDDDDBBBBBb','..bbB.D...D.Bbb..','....d.D...D.d....'];\n   if(i===1)body=body.map((r,j)=>j===4?'.....WWHAHWW.....':r);\n   if(i===2)body=body.map((r,j)=>j===9?'bbBBBCCCHCCCBBBbb':r);\n   if(i===3)body=body.map((r,j)=>j===11?'bBH.HBBBBBBBH.HBb':r);\n   return E.sprite(body,{W:'#f0faff',H:t.hi,A:'#ffd674',b:t.deep,B:t.sh,C:t.base,D:'#182743',d:'#ffb96a'},1.7);\n  });\n  const rnd=E.rng(906);this.stars=Array.from({length:420},()=>({x:rnd()*640,y:rnd()*360,z:rnd(),phase:rnd()*6.28}));\n  E.SHAPES['tb:relic']={about:'broken temporal relay',tags:'original sci-fi debris',mats:{m:{color:'#526a88',pattern:'metal'},g:{color:'#55d8d7',glow:1}},parts:[['cyl','m',[0,0,0],6,7,{seg:6}],['box','m',[0,0,7],[5,5,12]],['ball','g',[0,0,20],3]]};\n }\n reset(){this.fx=[];this.lastEvent=0;this.subtitle='';}\n ingest(w){if(\"'!w)return[];const fresh=w.events.filter(e=>e.id>this.lastEvent);for(const e of fresh){this.lastEvent=Math.max(this.lastEvent,e.id);if(e.line){this.subtitle=e.line;this.subtitleUntil=this.game.real+4.6;this.speaking=this.game.real+1.4;}\n  if(['\"'kill','intercept','hit','phaseBreak','clear','brake','bossHit','hullHit'].includes(e.type)){\n   let color=e.kind?WEAPONS[e.kind]?.color:'#8eefff';if(e.type==='hit')color='#ff6b86';if(e.type==='phaseBreak')color='#ffd674';\n   this.fx.push({x:e.x??320,y:e.y??180,born:this.game.real,type:e.type,color,points:e.points});\n   if(e.x\"'!=null){const P=this.game.particles;P.sparks(e.x,e.y,0,e.type==='\"'kill'?10:5);P.bits(e.x,e.y,0,6,[color,'#fff4d2','#607494']);if(e.type==='kill'||e.type==='phaseBreak')P.explosion(e.x,e.y,0,e.type==='kill'?.45:1.6,{freeze:false,shake:0,sound:false,flash:false});}\n   if(e.type==='hit'&&\"'!this.game.reduceMotion)this.game.shake(2);\n  }\n }this.fx=this.fx.filter(f=>this.game.real-f.born<1.1);return fresh;}\n ring(g,cx,cy,rx,ry,color,start=0,end=Math.PI*2,step=.025){const px=this.E.px;let prev=null;for(let a=start;a<=end;a+=step){const p=[cx+Math.cos(a)*rx,cy+Math.sin(a)*ry];if(prev)px.line(g,...prev,...p,color);prev=p;}}\n portal(g,x,y,size,t,active=true){\n  const {px}=this.E,colors=['\"'#27364b','#2c485c','#23616f','#398c99','#63bdc0','#bdcf91','#ffcf7d','#ea8175','#9e719b','#59709e'];\n  for(let k=20;k>0;k--){const radius=size*k/20;px.ell(g,x,y,radius,radius*.49,k%3===0?'#111a30':k%3===1?'#121d33':'#16223a');}\n  for(let j=0;j<8;j++){\n   const rx=size*(.65+j*.055),ry=rx*.49;\n   for(let k=0;k<12;k++){const a=k*Math.PI/6+t*(j%2?.08:-.08)+j*.12;this.ring(g,x,y,rx,ry,colors[(k+j)%colors.length],a,a+.35,.025);}\n  }\n  for(let i=0;i<26;i++){const a=i*2.4+t*.13,r=size*(.6+(i%5)*.075),p=[x+Math.cos(a)*r,y+Math.sin(a)*r*.49];px.line(g,p[0],p[1],p[0]+Math.cos(a)*7,p[1]+Math.sin(a)*3,'#334d65');}\n  px.ell(g,x,y,size*.48,size*.22,'#090e22');\n  for(let i=0;i<38;i++){const a=i*2.4-t*.22,r=(i%11)*size/29;px.dot(g,x+Math.cos(a)*r,y+Math.sin(a)*r*.42,i%4===0?'#567085':'#263650');}\n  if(active){px.blend(g,.10,'add',()=>px.ell(g,x,y,size*.86,size*.4,'#5eaaaa'));}\n }\n face(g,x,y,s,t,mood='gloat',bright=false){\n  const {px}=this.E;const S=(v)=>v*s;const poly=(pts,c)=>px.poly(g,pts.map(p=>[x+S(p[0]),y+S(p[1])]),c);const rect=(a,b,w,h,c)=>px.rect(g,x+S(a),y+S(b),S(w),S(h),c);\n  const ramp=bright?['#152d40','#264959','#3e6c75','#648d85','#a1b7a0','#f6d390']:['#101d31','#20394b','#315464','#477780','#7aaca2','#b7d4ba'];\n  // A carved mechanical mask with a broken crown and layered angular cheek plates.\n  poly([[-51,-43],[-44,-62],[-31,-50],[-15,-72],[0,-55],[19,-69],[29,-48],[47,-57],[52,-38],[39,-33],[-41,-33]],'#1b2a43');\n  poly([[-44,-44],[-38,-56],[-28,-44],[-14,-62],[0,-48],[17,-59],[28,-41],[43,-48],[44,-35],[-43,-35]],'#d3ac71');\n  rect(-31,-42,61,5,'#fce2a1');rect(-30,-36,58,7,ramp[2]);\n  poly([[-40,-33],[-23,-43],[24,-43],[42,-30],[48,-4],[35,39],[16,58],[-15,58],[-37,35],[-48,-6]],ramp[0]);\n  poly([[-35,-29],[-21,-37],[21,-37],[36,-28],[41,-2],[29,32],[13,49],[-12,49],[-31,30],[-41,-3]],ramp[2]);\n  poly([[-31,-25],[-20,-33],[18,-33],[31,-24],[34,-2],[24,24],[12,42],[-9,42],[-26,22],[-34,-1]],ramp[3]);\n  poly([[-32,-23],[-15,-18],[-16,2],[-30,11],[-38,-1]],ramp[1]);poly([[32,-23],[15,-18],[16,2],[30,11],[38,-1]],ramp[1]);\n  poly([[-33,6],[-21,9],[-16,27],[-10,39],[-24,27],[-32,23]],ramp[4]);poly([[33,6],[21,9],[16,27],[10,39],[24,27],[32,23]],ramp[2]);\n  poly([[0,-23],[-10,7],[0,16],[11,7]],ramp[1]);poly([[-2,-18],[-5,6],[0,11],[3,7],[1,-19]],ramp[5]);\n  const angry=mood==='angry'||mood==='defeat',blink=Math.sin(t*.85)> .996;\n  for(const side of [-1,1]){\n   const ex=side*22;rect(ex-10,-14,19,11,'#081320');\n   if(\"'!blink){rect(ex-7,-11,14,5,bright?'\"'#fff4be':'#9ef4da');rect(ex-2,-12,4,7,'#ffce7b');rect(ex,-12,2,3,'#fff9e2');}\n   poly([[ex-12,-18+(angry?side*2:0)],[ex+10,-22-(angry?side*2:0)],[ex+10,-18],[ex-11,-14]],'#13273b');\n  }\n  const mouth=mood==='speak'?3+Math.abs(Math.sin(t*23))*8:mood==='defeat'?10:angry?4:2;\n  poly([[-16,26],[-10,21],[11,21],[17,26],[11,26+mouth],[-10,26+mouth]],'#0b1426');\n  if(mood\"'!=='\"'defeat'){rect(-11,23,22,2,'#e2d1a2');if(mood==='speak')rect(-7,27+mouth,14,2,'#cf8e7e');}\n  for(let i=0;i<4;i++){rect(-5+i*3,38,1,7,ramp[1]);}\n  // Fine geometric engraving, deliberately crisp at the native pixel scale.\n  for(let side of [-1,1])for(let i=0;i<3;i++){const xx=side*(28+i*4);px.line(g,x+S(xx),y+S(-26),x+S(xx+side*3),y+S(-8),ramp[4]);}\n  rect(-2,-33,4,8,'#ffd980');rect(-2,-29,4,1,'#fff7d7');\n }\n backdrop(r,w,title=false){\n  const {px}=this.E,t=this.game.reduceMotion?0:this.game.real;r.sky(['#080d1a','#101a2d','#080d1b']);\n  r.decal(g=>{\n   // Striated nebula bands and distant layered arcs, not a filter over sample art.\n   for(let i=0;i<65;i++){const xx=(i*83)%640,yy=55+(i*19)%204;px.ell(g,xx,yy,16+i%37,4+i%9,i%3===0?'#121b32':'#11192c');}\n   for(const s of this.stars){const y=(s.y+t*(1+s.z*5))%360;px.dot(g,s.x,y,s.z>.88?'#a7b8bf':s.z>.5?'#465f79':'#26364e');if(s.z>.98){px.line(g,s.x-2,y,s.x+2,y,'#7594a1');px.line(g,s.x,y-2,s.x,y+2,'#7594a1');}}\n   const center=title?477:320,cy=title?166:116,size=title?155:133;\n   for(let k=0;k<3;k++)this.ring(g,center,cy,size+40+k*24,(size+40+k*24)*.48,['#1b2b44','#20344a','#263747'][k],t*.04+k,t*.04+k+4.9);\n   this.portal(g,center,cy,size,t);\n   if(title){this.face(g,477,174,1.25,t,this.game.real<this.speaking?'speak':'gloat',true);}\n   else if(\"'!w?.boss){px.blend(g,.35,'\"'normal',()=>this.face(g,320,108,.5,t,this.game.real<this.speaking?'speak':w?.wave>4?'angry':'gloat'));}\n   // Relic frames echo a clock dial around a clear common collision plane.\n   for(let side of [-1,1])for(let j=0;j<8;j++){\n    const x=side<0?9+j%2*5:626-j%2*5,y=50+j*31;\n    px.poly(g,[[x,y],[x+side*6,y+4],[x+side*6,y+13],[x,y+19]],'#253650');px.line(g,x,y+2,x,y+12,j%3===0?'#7e9b9c':'#40536b');\n   }\n   if(\"'!title){px.rect(g,28,302,584,17,'\"'#0a1525');px.line(g,28,301,612,301,'#26445a');px.line(g,30,319,610,319,'#172c40');for(let i=0;i<29;i++){px.rect(g,37+i*20,314,10,1,'#2a4557');if(i%5===0)px.rect(g,37+i*20,313,2,4,'#77b0a2');}}\n  });\n  if(\"'!title){for(let i=0;i<4;i++)r.shape('\"'tb:relic',i<2?17:623,90+(i%2)*140,0,{scale:.6,facing:.1*i});}\n  this.game.lights.add(title?477:320,title?160:108,0,190,.55,{color:'#6488ad'});\n }\n draw(r,w,options={}){\n  const title=\"'!w;this.backdrop(r,w,title);if(title){this.titleFleet(r);return;}\n  const {px}=this.E,now=this.game.real,ht=w.hostileTime;\n  for(const f of w.enemies){if(f.d<0)continue;\n   r.sprite(f.x,f.y,0,this.hulls[f.kind%3],{t:ht+f.id,anchor:'\"'center',scale:1.8,rot:(f.a||0)*.35,flash:f.hit>0?'#ffffff':undefined});\n   if(f.hp<f.max)r.overlay(g=>{px.rect(g,f.x-8,f.y+10,16,2,'#29384e');px.rect(g,f.x-8,f.y+10,16*f.hp/f.max,2,'#ffc57b');});\n  }\n  if(w.boss){const b=w.boss;this.game.lights.add(b.x,b.y,0,110,.6,{color:BOSS_PHASES[w.bossPhase].color});\n   r.actor(b.x,b.y,0,(g,x,y)=>{\n    for(let side of [-1,1]){const dx=side*(58+Math.sin(ht)*3);px.poly(g,[[x+dx,y-36],[x+dx+side*24,y-15],[x+dx+side*20,y+25],[x+dx,y+36],[x+dx-side*7,y]],'#26374f');px.line(g,x+dx,y-26,x+dx,y+25,b.open?'#76f3d7':'#e1a887',3);}\n    this.face(g,x,y,.8,now,this.game.real<this.speaking?'speak':w.bossPhase>0?'angry':'gloat',b.open);\n    const col=b.open?'#fff4bc':'#4a6a86';px.poly(g,[[x,y-10],[x+15,y+2],[x,y+17],[x-15,y+2]],'#122638');px.poly(g,[[x,y-6],[x+10,y+2],[x,y+12],[x-10,y+2]],col);\n    if(\"'!b.open){for(let k=0;k<3;k++)px.line(g,x-20,y-6+k*8,x+20,y-6+k*8,'\"'#425b74');}\n   },{emissive:true});\n   r.overlay(g=>{px.rect(g,221,37,198,3,'#24384c');px.rect(g,221,37,198*b.hp/b.max,3,BOSS_PHASES[w.bossPhase].color);this.E.font.text(g,(b.open?'CORE EXPOSED':'CORE ARMORED')+'  /  '+(w.bossPhase+1)+' OF 3',320,43,b.open?'#ffe2a0':'#92a9bd',{align:'center',outline:false});});\n  }\n  for(const t of w.threats){const col=WEAPONS[t.kind]?.color||'#fff',warn=t.state==='warn';\n   if(t.kind==='roller')r.decal(g=>{\n    px.line(g,t.from,299,t.to,299,t.ground?'#9dc679':'#45643c',2);for(const x of [t.from,t.to]){px.line(g,x,295,x,303,'#b6ff72');}\n    for(let x=Math.min(t.from,t.to);x<Math.max(t.from,t.to);x+=12)px.line(g,x,298,x+4,294,'#405a39');\n    px.poly(g,[[t.safe-4,302],[t.safe,296],[t.safe+4,302]],'#c9f3ac');\n   });\n   if(t.kind==='hunter'&&warn)r.decal(g=>{for(let yy=t.y+15;yy<294;yy+=13){const u=(yy-t.y)/(ARENA.lane-t.y);px.dot(g,t.x+(t.tx-t.x)*u,yy,'#746241');}const x=t.tx;px.line(g,x-16,288,x-16,299,'#ffd674');px.line(g,x+16,288,x+16,299,'#ffd674');px.line(g,x-16,294,x+16,294,'#ad8454');this.E.font.text(g,'AIM',x,278,'#e9be7c',{align:'center',font:'tiny',outline:false});});\n   r.actor(t.x,t.y,0,(g,x,y)=>{\n    if(warn){const radius=12+Math.sin(now*14)*2;this.ring(g,x,y,radius,radius*.5,col,0,Math.PI*1.8,.2);}\n    if(t.kind==='dart'){\n     px.line(g,x,y-14,x,y-3,'#638da0',2);px.poly(g,[[x-5,y-7],[x-4,y+2],[x,y+7],[x+4,y+2],[x+5,y-7],[x,y-3]],'#769aaf');px.poly(g,[[x-2,y-7],[x,y+4],[x+3,y-7],[x,y-2]],'#f3f7e9');\n    }else if(t.kind==='mine'){\n     px.disc(g,x,y,8,'#521c3e');px.disc(g,x-1,y-1,6,'#b93463');px.disc(g,x-2,y-2,3,'#ff6b88');px.dot(g,x-2,y-3,'#ffe6c5');for(let i=0;i<3;i++){const a=ht*2.5+i*2.094;px.rect(g,x+Math.cos(a)*11-1,y+Math.sin(a)*6-1,3,3,'#ff987f');}\n    }else if(t.kind==='roller'){\n     const a=t.ground?ht*7:ht*2;for(let i=0;i<4;i++){const aa=a+i*Math.PI/2;px.line(g,x,y,x+Math.cos(aa)*9,y+Math.sin(aa)*9,'#365941',5);px.line(g,x,y,x+Math.cos(aa)*8,y+Math.sin(aa)*8,'#b6ff72',2);}px.disc(g,x,y,3,'#e6ffd0');if(t.ground){px.line(g,x-10,y+4,x+10,y+4,'#7da964');px.rect(g,x-3,y-2,6,4,'#e6f5a9');}\n    }else{\n     px.poly(g,[[x,y-12],[x+9,y],[x,y+12],[x-9,y]],'#7b4e55');px.poly(g,[[x,y-9],[x+6,y],[x,y+9],[x-6,y]],'#ffd674');px.line(g,x,y-8,x,y+8,'#fff3cf');px.dot(g,x-2,y-3,'#fff');\n    }\n   },{emissive:true});\n  }\n  for(const s of w.shots){const p=w.players.find(p=>p.id===s.owner);r.actor(s.x,s.y,0,(g,x,y)=>{px.rect(g,x-1,y-7,3,13,PILOT_COLORS[p?.seat||0]);px.rect(g,x,y-8,1,8,'#ffffff');},{emissive:true});}\n  for(const p of w.players){if(\"'!p.connected)continue;const c=PILOT_COLORS[p.seat];\n   this.game.lights.add(p.x,p.y,0,38,p.hp>0?.7:.15,{color:c});\n   r.sprite(p.x,p.y-2+(p.recoil||0)*2,0,this.pilotSprites[p.seat],{anchor:'\"'center',rot:(p.vx||0)*.00015,flash:p.inv>0&&Math.floor(now*9)%2?'#a3ffff':undefined,alpha:p.hp<=0?.3:1});\n   r.overlay(g=>{\n    if(p.hp>0){for(let i=0;i<3;i++){const x=p.x-10+i*10,y=322;px.poly(g,[[x,y-3],[x+3,y],[x,y+3],[x-3,y]],i<p.hp?c:'#2d3b4c');}}\n    else this.E.font.text(g,'REBOOT NEXT WAVE',p.x,321,c,{align:'center',font:'tiny',outline:false});\n    if(w.players.length>1)this.E.font.text(g,'P'+(p.seat+1),p.x,335,c,{align:'center',font:'tiny',outline:false});\n    if(p.inv>0&&p.hp>0)this.ring(g,p.x,p.y-2,20,18,c,now,now+Math.PI*1.5,.15);\n   });\n  }\n  r.overlay(g=>{\n   for(const f of this.fx){const age=now-f.born,rad=4+age*(f.type==='phaseBreak'?160:28);if(age<.55)this.ring(g,f.x,f.y,rad,rad*.7,f.color,age*2,age*2+4,.12);if(f.points)this.E.font.text(g,'+'+f.points,f.x,f.y-age*25-12,f.color,{align:'center',outline:false});}\n   if(w.brakeLeft>0){px.blend(g,.055,'screen',()=>px.rect(g,25,30,590,290,'#73dcf4'));for(let i=0;i<6;i++)px.line(g,28+i*4,288,28+i*4,280-i*7,'#72dbe4');this.E.font.text(g,'TIME BRAKE',320,268,'#a8f3ee',{align:'center',scale:2,outline:false});}\n   this.hud(g,w,options);\n  });\n  if(options.hitboxes||options.trajectories)r.overlay(g=>{\n   if(options.hitboxes){for(const o of [...w.players,...w.enemies,...w.threats])this.ring(g,o.x,o.y,o.r||6,o.r||6,'#ffffff',0,Math.PI*2,.3);}\n   if(options.trajectories)for(const t of w.threats){px.line(g,t.x,t.y,t.x+t.vx*.5,t.y+t.vy*.5,'#ffe880');this.E.font.text(g,String(t.target??''),t.x+9,t.y,'#fff',{font:'tiny'});}\n  });\n }\n titleFleet(r){const t=this.game.reduceMotion?0:this.game.real;for(let i=0;i<12;i++){const a=t*.22+i*.38,x=472+Math.cos(a)*151,y=174+Math.sin(a)*85;r.sprite(x,y,0,this.hulls[i%3],{t:t+i,anchor:'center',scale:1.2+(Math.sin(a)+1)*.32,rot:Math.cos(a)*.2});}}\n hud(g,w,o){\n  const E=this.E,{px}=E;\n  E.font.text(g,String(w.score).padStart(6,'0'),29,12,'#f5e6c9',{scale:2,outline:false,shadow:'#030a15'});E.font.text(g,'TEAM SCORE',30,30,'#7b9ba8',{font:'tiny',outline:false});\n  E.font.text(g,w.wave<8?'WAVE '+String(w.wave+1).padStart(2,'0')+' / 08':'THE BANDIT BOSS',609,12,'#c5d7df',{scale:w.wave<8?2:1,align:'right',outline:false});\n  const label=w.wave<8?WAVES[w.wave].name:BOSS_PHASES[w.bossPhase].name;E.font.text(g,label.toUpperCase(),610,31,'#98b6c3',{align:'right',font:'tiny',outline:false});\n  px.rect(g,228,340,184,6,'#1f3348');px.rect(g,228,340,184*w.brake/100,6,w.brake>=100?'#d4f7c9':'#6ac8cb');\n  for(let i=1;i<8;i++)px.rect(g,228+i*23,340,1,6,'#112032');\n  const prompt=w.brake>=100?(o.brakeLabel||'SHIFT')+'  TIME BRAKE':'INTERCEPT TO CHARGE  '+Math.floor(w.brake)+'%';E.font.text(g,prompt,320,350,w.brake>=100?'#efffcb':'#8baebb',{align:'center',font:'tiny',outline:false});\n  if(w.modified&&\"'!w.demo)E.font.text(g,'\"'DEV / MODIFIED',32,347,'#ffca85',{font:'tiny',outline:false});else if(w.assists?.autoFire||w.assists?.slow||w.assists?.emergency)E.font.text(g,'ASSISTED',32,347,'#acd2a5',{font:'tiny',outline:false});\n  if(o.network)E.font.text(g,o.network,608,348,'#91b9bf',{align:'right',font:'tiny',outline:false});\n  if(this.subtitleUntil>this.game.real&&this.subtitle){\n   const lines=E.font.wrap(this.subtitle,350,{});for(let i=0;i<lines.length;i++)E.font.text(g,lines[i],320,61+i*10,'#e3d6b9',{align:'center',outline:false,shadow:'#020811'});\n  }\n  if(w.phase==='countdown'||w.phase==='intermission'||w.phase==='playing'&&w.phaseTime<3.5){\n   const clear=w.phase==='intermission';const heading=clear?'FLEET BROKEN':w.phase==='countdown'?'DEFEND YOUR CENTURY':'WAVE '+(w.wave+1);const detail=clear?'Ordnance dissolved. Integrity restored.':WAVES[w.wave]?.cue||'READ THE CORE. BREAK THE CLOCK.';\n   E.font.text(g,heading,320,227,'#f6dfac',{align:'center',scale:2,outline:false,shadow:'#080d1a'});E.font.text(g,detail,320,247,'#a7c1c9',{align:'center',outline:false});\n  }\n  if(w.phase==='ending'){const t=w.phaseTime;E.font.text(g,'YOUR TIME IS YOUR OWN.',320,224,'#f8e7ae',{align:'center',scale:2,outline:false});E.font.text(g,t<3?'The rift closes. The invoice goes unanswered.':'Somewhere, the Boss is still filing a complaint.',320,246,'#a7c7c8',{align:'center',outline:false});}\n  if(w.demo){px.rect(g,185,8,270,18,'#122a39');E.font.text(g,'DEMONSTRATION / ANY INPUT TO RETURN',320,13,'#d9ebbd',{align:'center',outline:false});}\n }\n}\nEOF\ncat > src/audio/sound.js <<'EOF'\nexport function codeTone(ctx,bus,when,freq,dur=.15,volume=.1,wave='triangle',to=null){\n const osc=ctx.createOscillator(),gain=ctx.createGain();osc.type=wave;osc.frequency.setValueAtTime(freq,when);if(to)osc.frequency.exponentialRampToValueAtTime(Math.max(20,to),when+dur);gain.gain.setValueAtTime(0,when);gain.gain.linearRampToValueAtTime(volume,when+.006);gain.gain.exponentialRampToValueAtTime(.0001,when+dur);osc.connect(gain);gain.connect(bus);osc.start(when);osc.stop(when+dur+.01);return osc;\n}\nexport function gibberish(ctx,bus,when,line,emotion='gloat'){\n const nodes=[],count=Math.min(13,5+Math.floor(line.length/8));\n for(let i=0;i<count;i++){\n  const t=when+i*.092,dur=.065+(i%3)*.018,base=(emotion==='angry'?122:94)+(i*31%57),o=ctx.createOscillator(),v=ctx.createGain(),f=ctx.createBiquadFilter();\n  o.type='sawtooth';o.frequency.setValueAtTime(base,t);o.frequency.exponentialRampToValueAtTime(base*(i%2?1.5:.72),t+dur);f.type='bandpass';f.frequency.setValueAtTime([680,1200,1750,900,1450][i%5],t);f.Q.value=3;\n  v.gain.setValueAtTime(0,t);v.gain.linearRampToValueAtTime(.19,t+.009);v.gain.exponentialRampToValueAtTime(.0001,t+dur);o.connect(f);f.connect(v);v.connect(bus);o.start(t);o.stop(t+dur+.01);nodes.push(o);\n }\n return nodes;\n}\nconst MELODIES={title:'D5 . A4 C5 | F5 - E5 . | D5 . A4 . | C5 - A4 .',combat:'D5 . . A4 | C5 . F5 . | E5 . C5 . | A4 . . .',escalation:'D5 A4 F5 . | E5 C5 G5 . | F5 E5 D5 C5 | A4 . C5 .',boss:'D4 D5 . Eb5 | A4 . F5 E5 | D5 . C5 A4 | Bb4 A4 G4 .',victory:'D5 F5 A5 - | G5 E5 C5 - | D5 - - - | . . . .',failure:'D5 C5 A4 . | F4 E4 D4 - | . . . . | . . . .'};\nexport class Soundtrack{\n constructor(game){this.game=game;this.kind=null;this.nodes=[];this.enabled=false;this.stopped=false;const A=game.audio;\n const sounds={shot:{wave:'triangle',freq:900,to:220,dur:.075,vol:.14},dart:{wave:'sine',freq:560,to:290,dur:.15,vol:.16},mine:{wave:'pulse',freq:260,to:150,dur:.25,vol:.13},roller:{wave:'triangle',freq:100,to:260,dur:.25,vol:.25},hunter:{wave:'sine',freq:900,to:1450,dur:.3,vol:.11},intercept:{wave:'noise',freq:1300,to:180,dur:.12,vol:.13},kill:{wave:'noise',freq:800,to:100,dur:.24,vol:.17},hit:{wave:'saw',freq:180,to:40,dur:.4,vol:.24},land:{wave:'noise',freq:300,to:80,dur:.2,vol:.23},brake:{wave:'sine',freq:900,to:65,dur:.7,vol:.21},release:{wave:'sine',freq:90,to:540,dur:.3,vol:.15},charged:{wave:'triangle',freq:660,arp:[0,4,7,12],step:.05,dur:.3,vol:.16},weakpoint:{wave:'triangle',freq:400,to:800,dur:.2,vol:.16},shield:{wave:'sine',freq:420,to:190,dur:.16,vol:.13},phaseBreak:{wave:'noise',freq:750,to:100,dur:.7,vol:.25},hullHit:{wave:'triangle',freq:550,to:350,dur:.055,vol:.1},bossHit:{wave:'pulse',freq:290,to:420,dur:.09,vol:.12},blocked:{wave:'sine',freq:170,dur:.09,vol:.12},clear:{wave:'triangle',freq:400,arp:[0,4,7],step:.09,dur:.4,vol:.2}};\n for(const [name,spec]of Object.entries(sounds))A.define('tb:'+name,spec);\n }\n unlock(){this.enabled=true;this.stopped=false;const ctx=this.game.audio._init();if(ctx?.state==='suspended')ctx.resume().catch(()=>{});}\n music(kind){if(kind===this.kind||this.stopped)return;this.kind=kind;const boss=kind==='boss';this.game.audio.music({bpm:boss?132:kind==='title'?92:112,steps:4,tracks:[{name:'lead',wave:'triangle',vol:.18,notes:MELODIES[kind]||MELODIES.combat},{name:'bass',wave:'sine',vol:.2,notes:'D3 . D3 . | Bb2 . Bb2 . | C3 . C3 . | A2 . A2 .'},{name:'pulse',wave:'pulse12',vol:.065,notes:'A4 . D5 . | F4 . Bb4 . | G4 . C5 . | E4 . A4 .'},{name:'drums',wave:'drums',vol:.09,notes:'k . h . | s . h h | k . h . | s h . h'}]},{sync:true});}\n events(events){if(\"'!this.enabled||this.stopped||this.game.paused)return;for(const e of events){if(e.line&&!['\"'hint'].includes(e.type)){this.stopVoice();const ctx=this.game.audio.ctx;if(ctx)this.nodes=gibberish(ctx,this.game.audio.bus('voice'),ctx.currentTime+.005,e.line,e.type==='hit'?'angry':'gloat');}\n const name=e.type==='launch'?e.kind:e.type==='intercept'?'intercept':e.type;if(this.game.audio._defs?.['tb:'+name]||['shot','dart','mine','roller','hunter','intercept','kill','hit','land','brake','release','charged','weakpoint','shield','phaseBreak','hullHit','bossHit','blocked','clear'].includes(name))this.game.audio.sfx('tb:'+name,{pan:e.x==null?0:(e.x-320)/400});}}\n stopVoice(){for(const n of this.nodes)try{n.stop();}catch{}this.nodes=[];}\n pause(){this.stopVoice();}\n end(){this.stopped=true;this.kind=null;this.stopVoice();this.game.audio.music(null);const c=this.game.audio.ctx;if(c?.state==='running')c.suspend().catch(()=>{});}\n reset(){this.stopVoice();this.kind=null;this.stopped=false;}\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"cat > src/presentation/renderer.js <<'EOF'\nimport { TITLE, ARENA, WAVES, WEAPONS, BOSS_PHASES } from '../content/campaign.js';\nexport const PILOT_COLORS=['#77e8f2','#ff9baa','#b9ef85','#bca0ff'];\nexport class Presentation {\n constructor(game){\n  this.game=game;this.E=globalThis.My3D2dge;this.fx=[];this.lastEvent=0;this.subtitle='';this.subtitleUntil=0;this.speaking=0;\n  const E=this.E;\n  const dome=['.......aaaa.......','.....aaAHHaaa.....','....aAHHHHHAaa....','..aaAALLLLLAAaaa..','.bBBBBBBBBBBBBBbb.','bBLLLLLLLLLLLLLBbb','..BBdddddddddBB...','....cc.c.c.cc.....','.....c...c.......'];\n  this.hulls=['#718bff','#f5a95f','#a696f5'].map(c=>{const t=E.tones(c);const palette={a:t.sh,A:t.base,H:t.hi,L:t.lt,b:t.deep,B:t.base,d:'#10273d',c:'#91f8e4'};return E.anim([E.sprite(dome,palette),E.sprite(dome.map((row,i)=>i===7?row.replaceAll('c','L'):row),palette)],5,{pingpong:true});});\n  this.pilotSprites=PILOT_COLORS.map((c,i)=>{\n   const t=E.tones(c);let body=[\n    '........W........','........W........','.......WWW.......','.......WHW.......','......WHAHW......','......WHHHW......','.....bWWWWWb.....','...bbBCCHCCBbb...','..bBBCCCHCCCBBb..','.bBBBCCCHCCCBBBb.','bBBHBBCCCCCBBHBBb','bBHHHBBBBBBBHHHBb','bBBBBBDDDDDBBBBBb','..bbB.D...D.Bbb..','....d.D...D.d....'];\n   if(i===1)body=body.map((r,j)=>j===4?'.....WWHAHWW.....':r);\n   if(i===2)body=body.map((r,j)=>j===9?'bbBBBCCCHCCCBBBbb':r);\n   if(i===3)body=body.map((r,j)=>j===11?'bBH.HBBBBBBBH.HBb':r);\n   return E.sprite(body,{W:'#f0faff',H:t.hi,A:'#ffd674',b:t.deep,B:t.sh,C:t.base,D:'#182743',d:'#ffb96a'},1.7);\n  });\n  const rnd=E.rng(906);this.stars=Array.from({length:420},()=>({x:rnd()*640,y:rnd()*360,z:rnd(),phase:rnd()*6.28}));\n  E.SHAPES['tb:relic']={about:'broken temporal relay',tags:'original sci-fi debris',mats:{m:{color:'#526a88',pattern:'metal'},g:{color:'#55d8d7',glow:1}},parts:[['cyl','m',[0,0,0],6,7,{seg:6}],['box','m',[0,0,7],[5,5,12]],['ball','g',[0,0,20],3]]};\n }\n reset(){this.fx=[];this.lastEvent=0;this.subtitle='';}\n ingest(w){if(\"'!w)return[];const fresh=w.events.filter(e=>e.id>this.lastEvent);for(const e of fresh){this.lastEvent=Math.max(this.lastEvent,e.id);if(e.line){this.subtitle=e.line;this.subtitleUntil=this.game.real+4.6;this.speaking=this.game.real+1.4;}\n  if(['\"'kill','intercept','hit','phaseBreak','clear','brake','bossHit','hullHit'].includes(e.type)){\n   let color=e.kind?WEAPONS[e.kind]?.color:'#8eefff';if(e.type==='hit')color='#ff6b86';if(e.type==='phaseBreak')color='#ffd674';\n   this.fx.push({x:e.x??320,y:e.y??180,born:this.game.real,type:e.type,color,points:e.points});\n   if(e.x\"'!=null){const P=this.game.particles;P.sparks(e.x,e.y,0,e.type==='\"'kill'?10:5);P.bits(e.x,e.y,0,6,[color,'#fff4d2','#607494']);if(e.type==='kill'||e.type==='phaseBreak')P.explosion(e.x,e.y,0,e.type==='kill'?.45:1.6,{freeze:false,shake:0,sound:false,flash:false});}\n   if(e.type==='hit'&&\"'!this.game.reduceMotion)this.game.shake(2);\n  }\n }this.fx=this.fx.filter(f=>this.game.real-f.born<1.1);return fresh;}\n ring(g,cx,cy,rx,ry,color,start=0,end=Math.PI*2,step=.025){const px=this.E.px;let prev=null;for(let a=start;a<=end;a+=step){const p=[cx+Math.cos(a)*rx,cy+Math.sin(a)*ry];if(prev)px.line(g,...prev,...p,color);prev=p;}}\n portal(g,x,y,size,t,active=true){\n  const {px}=this.E,colors=['\"'#27364b','#2c485c','#23616f','#398c99','#63bdc0','#bdcf91','#ffcf7d','#ea8175','#9e719b','#59709e'];\n  for(let k=20;k>0;k--){const radius=size*k/20;px.ell(g,x,y,radius,radius*.49,k%3===0?'#111a30':k%3===1?'#121d33':'#16223a');}\n  for(let j=0;j<8;j++){\n   const rx=size*(.65+j*.055),ry=rx*.49;\n   for(let k=0;k<12;k++){const a=k*Math.PI/6+t*(j%2?.08:-.08)+j*.12;this.ring(g,x,y,rx,ry,colors[(k+j)%colors.length],a,a+.35,.025);}\n  }\n  for(let i=0;i<26;i++){const a=i*2.4+t*.13,r=size*(.6+(i%5)*.075),p=[x+Math.cos(a)*r,y+Math.sin(a)*r*.49];px.line(g,p[0],p[1],p[0]+Math.cos(a)*7,p[1]+Math.sin(a)*3,'#334d65');}\n  px.ell(g,x,y,size*.48,size*.22,'#090e22');\n  for(let i=0;i<38;i++){const a=i*2.4-t*.22,r=(i%11)*size/29;px.dot(g,x+Math.cos(a)*r,y+Math.sin(a)*r*.42,i%4===0?'#567085':'#263650');}\n  if(active){px.blend(g,.10,'add',()=>px.ell(g,x,y,size*.86,size*.4,'#5eaaaa'));}\n }\n face(g,x,y,s,t,mood='gloat',bright=false){\n  const {px}=this.E;const S=(v)=>v*s;const poly=(pts,c)=>px.poly(g,pts.map(p=>[x+S(p[0]),y+S(p[1])]),c);const rect=(a,b,w,h,c)=>px.rect(g,x+S(a),y+S(b),S(w),S(h),c);\n  const ramp=bright?['#152d40','#264959','#3e6c75','#648d85','#a1b7a0','#f6d390']:['#101d31','#20394b','#315464','#477780','#7aaca2','#b7d4ba'];\n  // A carved mechanical mask with a broken crown and layered angular cheek plates.\n  poly([[-51,-43],[-44,-62],[-31,-50],[-15,-72],[0,-55],[19,-69],[29,-48],[47,-57],[52,-38],[39,-33],[-41,-33]],'#1b2a43');\n  poly([[-44,-44],[-38,-56],[-28,-44],[-14,-62],[0,-48],[17,-59],[28,-41],[43,-48],[44,-35],[-43,-35]],'#d3ac71');\n  rect(-31,-42,61,5,'#fce2a1');rect(-30,-36,58,7,ramp[2]);\n  poly([[-40,-33],[-23,-43],[24,-43],[42,-30],[48,-4],[35,39],[16,58],[-15,58],[-37,35],[-48,-6]],ramp[0]);\n  poly([[-35,-29],[-21,-37],[21,-37],[36,-28],[41,-2],[29,32],[13,49],[-12,49],[-31,30],[-41,-3]],ramp[2]);\n  poly([[-31,-25],[-20,-33],[18,-33],[31,-24],[34,-2],[24,24],[12,42],[-9,42],[-26,22],[-34,-1]],ramp[3]);\n  poly([[-32,-23],[-15,-18],[-16,2],[-30,11],[-38,-1]],ramp[1]);poly([[32,-23],[15,-18],[16,2],[30,11],[38,-1]],ramp[1]);\n  poly([[-33,6],[-21,9],[-16,27],[-10,39],[-24,27],[-32,23]],ramp[4]);poly([[33,6],[21,9],[16,27],[10,39],[24,27],[32,23]],ramp[2]);\n  poly([[0,-23],[-10,7],[0,16],[11,7]],ramp[1]);poly([[-2,-18],[-5,6],[0,11],[3,7],[1,-19]],ramp[5]);\n  const angry=mood==='angry'||mood==='defeat',blink=Math.sin(t*.85)> .996;\n  for(const side of [-1,1]){\n   const ex=side*22;rect(ex-10,-14,19,11,'#081320');\n   if(\"'!blink){rect(ex-7,-11,14,5,bright?'\"'#fff4be':'#9ef4da');rect(ex-2,-12,4,7,'#ffce7b');rect(ex,-12,2,3,'#fff9e2');}\n   poly([[ex-12,-18+(angry?side*2:0)],[ex+10,-22-(angry?side*2:0)],[ex+10,-18],[ex-11,-14]],'#13273b');\n  }\n  const mouth=mood==='speak'?3+Math.abs(Math.sin(t*23))*8:mood==='defeat'?10:angry?4:2;\n  poly([[-16,26],[-10,21],[11,21],[17,26],[11,26+mouth],[-10,26+mouth]],'#0b1426');\n  if(mood\"'!=='\"'defeat'){rect(-11,23,22,2,'#e2d1a2');if(mood==='speak')rect(-7,27+mouth,14,2,'#cf8e7e');}\n  for(let i=0;i<4;i++){rect(-5+i*3,38,1,7,ramp[1]);}\n  // Fine geometric engraving, deliberately crisp at the native pixel scale.\n  for(let side of [-1,1])for(let i=0;i<3;i++){const xx=side*(28+i*4);px.line(g,x+S(xx),y+S(-26),x+S(xx+side*3),y+S(-8),ramp[4]);}\n  rect(-2,-33,4,8,'#ffd980');rect(-2,-29,4,1,'#fff7d7');\n }\n backdrop(r,w,title=false){\n  const {px}=this.E,t=this.game.reduceMotion?0:this.game.real;r.sky(['#080d1a','#101a2d','#080d1b']);\n  r.decal(g=>{\n   // Striated nebula bands and distant layered arcs, not a filter over sample art.\n   for(let i=0;i<65;i++){const xx=(i*83)%640,yy=55+(i*19)%204;px.ell(g,xx,yy,16+i%37,4+i%9,i%3===0?'#121b32':'#11192c');}\n   for(const s of this.stars){const y=(s.y+t*(1+s.z*5))%360;px.dot(g,s.x,y,s.z>.88?'#a7b8bf':s.z>.5?'#465f79':'#26364e');if(s.z>.98){px.line(g,s.x-2,y,s.x+2,y,'#7594a1');px.line(g,s.x,y-2,s.x,y+2,'#7594a1');}}\n   const center=title?477:320,cy=title?166:116,size=title?155:133;\n   for(let k=0;k<3;k++)this.ring(g,center,cy,size+40+k*24,(size+40+k*24)*.48,['#1b2b44','#20344a','#263747'][k],t*.04+k,t*.04+k+4.9);\n   this.portal(g,center,cy,size,t);\n   if(title){this.face(g,477,174,1.25,t,this.game.real<this.speaking?'speak':'gloat',true);}\n   else if(\"'!w?.boss){px.blend(g,.35,'\"'normal',()=>this.face(g,320,108,.5,t,this.game.real<this.speaking?'speak':w?.wave>4?'angry':'gloat'));}\n   // Relic frames echo a clock dial around a clear common collision plane.\n   for(let side of [-1,1])for(let j=0;j<8;j++){\n    const x=side<0?9+j%2*5:626-j%2*5,y=50+j*31;\n    px.poly(g,[[x,y],[x+side*6,y+4],[x+side*6,y+13],[x,y+19]],'#253650');px.line(g,x,y+2,x,y+12,j%3===0?'#7e9b9c':'#40536b');\n   }\n   if(\"'!title){px.rect(g,28,302,584,17,'\"'#0a1525');px.line(g,28,301,612,301,'#26445a');px.line(g,30,319,610,319,'#172c40');for(let i=0;i<29;i++){px.rect(g,37+i*20,314,10,1,'#2a4557');if(i%5===0)px.rect(g,37+i*20,313,2,4,'#77b0a2');}}\n  });\n  if(\"'!title){for(let i=0;i<4;i++)r.shape('\"'tb:relic',i<2?17:623,90+(i%2)*140,0,{scale:.6,facing:.1*i});}\n  this.game.lights.add(title?477:320,title?160:108,0,190,.55,{color:'#6488ad'});\n }\n draw(r,w,options={}){\n  const title=\"'!w;this.backdrop(r,w,title);if(title){this.titleFleet(r);return;}\n  const {px}=this.E,now=this.game.real,ht=w.hostileTime;\n  for(const f of w.enemies){if(f.d<0)continue;\n   r.sprite(f.x,f.y,0,this.hulls[f.kind%3],{t:ht+f.id,anchor:'\"'center',scale:1.8,rot:(f.a||0)*.35,flash:f.hit>0?'#ffffff':undefined});\n   if(f.hp<f.max)r.overlay(g=>{px.rect(g,f.x-8,f.y+10,16,2,'#29384e');px.rect(g,f.x-8,f.y+10,16*f.hp/f.max,2,'#ffc57b');});\n  }\n  if(w.boss){const b=w.boss;this.game.lights.add(b.x,b.y,0,110,.6,{color:BOSS_PHASES[w.bossPhase].color});\n   r.actor(b.x,b.y,0,(g,x,y)=>{\n    for(let side of [-1,1]){const dx=side*(58+Math.sin(ht)*3);px.poly(g,[[x+dx,y-36],[x+dx+side*24,y-15],[x+dx+side*20,y+25],[x+dx,y+36],[x+dx-side*7,y]],'#26374f');px.line(g,x+dx,y-26,x+dx,y+25,b.open?'#76f3d7':'#e1a887',3);}\n    this.face(g,x,y,.8,now,this.game.real<this.speaking?'speak':w.bossPhase>0?'angry':'gloat',b.open);\n    const col=b.open?'#fff4bc':'#4a6a86';px.poly(g,[[x,y-10],[x+15,y+2],[x,y+17],[x-15,y+2]],'#122638');px.poly(g,[[x,y-6],[x+10,y+2],[x,y+12],[x-10,y+2]],col);\n    if(\"'!b.open){for(let k=0;k<3;k++)px.line(g,x-20,y-6+k*8,x+20,y-6+k*8,'\"'#425b74');}\n   },{emissive:true});\n   r.overlay(g=>{px.rect(g,221,37,198,3,'#24384c');px.rect(g,221,37,198*b.hp/b.max,3,BOSS_PHASES[w.bossPhase].color);this.E.font.text(g,(b.open?'CORE EXPOSED':'CORE ARMORED')+'  /  '+(w.bossPhase+1)+' OF 3',320,43,b.open?'#ffe2a0':'#92a9bd',{align:'center',outline:false});});\n  }\n  for(const t of w.threats){const col=WEAPONS[t.kind]?.color||'#fff',warn=t.state==='warn';\n   if(t.kind==='roller')r.decal(g=>{\n    px.line(g,t.from,299,t.to,299,t.ground?'#9dc679':'#45643c',2);for(const x of [t.from,t.to]){px.line(g,x,295,x,303,'#b6ff72');}\n    for(let x=Math.min(t.from,t.to);x<Math.max(t.from,t.to);x+=12)px.line(g,x,298,x+4,294,'#405a39');\n    px.poly(g,[[t.safe-4,302],[t.safe,296],[t.safe+4,302]],'#c9f3ac');\n   });\n   if(t.kind==='hunter'&&warn)r.decal(g=>{for(let yy=t.y+15;yy<294;yy+=13){const u=(yy-t.y)/(ARENA.lane-t.y);px.dot(g,t.x+(t.tx-t.x)*u,yy,'#746241');}const x=t.tx;px.line(g,x-16,288,x-16,299,'#ffd674');px.line(g,x+16,288,x+16,299,'#ffd674');px.line(g,x-16,294,x+16,294,'#ad8454');this.E.font.text(g,'AIM',x,278,'#e9be7c',{align:'center',font:'tiny',outline:false});});\n   r.actor(t.x,t.y,0,(g,x,y)=>{\n    if(warn){const radius=12+Math.sin(now*14)*2;this.ring(g,x,y,radius,radius*.5,col,0,Math.PI*1.8,.2);}\n    if(t.kind==='dart'){\n     px.line(g,x,y-14,x,y-3,'#638da0',2);px.poly(g,[[x-5,y-7],[x-4,y+2],[x,y+7],[x+4,y+2],[x+5,y-7],[x,y-3]],'#769aaf');px.poly(g,[[x-2,y-7],[x,y+4],[x+3,y-7],[x,y-2]],'#f3f7e9');\n    }else if(t.kind==='mine'){\n     px.disc(g,x,y,8,'#521c3e');px.disc(g,x-1,y-1,6,'#b93463');px.disc(g,x-2,y-2,3,'#ff6b88');px.dot(g,x-2,y-3,'#ffe6c5');for(let i=0;i<3;i++){const a=ht*2.5+i*2.094;px.rect(g,x+Math.cos(a)*11-1,y+Math.sin(a)*6-1,3,3,'#ff987f');}\n    }else if(t.kind==='roller'){\n     const a=t.ground?ht*7:ht*2;for(let i=0;i<4;i++){const aa=a+i*Math.PI/2;px.line(g,x,y,x+Math.cos(aa)*9,y+Math.sin(aa)*9,'#365941',5);px.line(g,x,y,x+Math.cos(aa)*8,y+Math.sin(aa)*8,'#b6ff72',2);}px.disc(g,x,y,3,'#e6ffd0');if(t.ground){px.line(g,x-10,y+4,x+10,y+4,'#7da964');px.rect(g,x-3,y-2,6,4,'#e6f5a9');}\n    }else{\n     px.poly(g,[[x,y-12],[x+9,y],[x,y+12],[x-9,y]],'#7b4e55');px.poly(g,[[x,y-9],[x+6,y],[x,y+9],[x-6,y]],'#ffd674');px.line(g,x,y-8,x,y+8,'#fff3cf');px.dot(g,x-2,y-3,'#fff');\n    }\n   },{emissive:true});\n  }\n  for(const s of w.shots){const p=w.players.find(p=>p.id===s.owner);r.actor(s.x,s.y,0,(g,x,y)=>{px.rect(g,x-1,y-7,3,13,PILOT_COLORS[p?.seat||0]);px.rect(g,x,y-8,1,8,'#ffffff');},{emissive:true});}\n  for(const p of w.players){if(\"'!p.connected)continue;const c=PILOT_COLORS[p.seat];\n   this.game.lights.add(p.x,p.y,0,38,p.hp>0?.7:.15,{color:c});\n   r.sprite(p.x,p.y-2+(p.recoil||0)*2,0,this.pilotSprites[p.seat],{anchor:'\"'center',rot:(p.vx||0)*.00015,flash:p.inv>0&&Math.floor(now*9)%2?'#a3ffff':undefined,alpha:p.hp<=0?.3:1});\n   r.overlay(g=>{\n    if(p.hp>0){for(let i=0;i<3;i++){const x=p.x-10+i*10,y=322;px.poly(g,[[x,y-3],[x+3,y],[x,y+3],[x-3,y]],i<p.hp?c:'#2d3b4c');}}\n    else this.E.font.text(g,'REBOOT NEXT WAVE',p.x,321,c,{align:'center',font:'tiny',outline:false});\n    if(w.players.length>1)this.E.font.text(g,'P'+(p.seat+1),p.x,335,c,{align:'center',font:'tiny',outline:false});\n    if(p.inv>0&&p.hp>0)this.ring(g,p.x,p.y-2,20,18,c,now,now+Math.PI*1.5,.15);\n   });\n  }\n  r.overlay(g=>{\n   for(const f of this.fx){const age=now-f.born,rad=4+age*(f.type==='phaseBreak'?160:28);if(age<.55)this.ring(g,f.x,f.y,rad,rad*.7,f.color,age*2,age*2+4,.12);if(f.points)this.E.font.text(g,'+'+f.points,f.x,f.y-age*25-12,f.color,{align:'center',outline:false});}\n   if(w.brakeLeft>0){px.blend(g,.055,'screen',()=>px.rect(g,25,30,590,290,'#73dcf4'));for(let i=0;i<6;i++)px.line(g,28+i*4,288,28+i*4,280-i*7,'#72dbe4');this.E.font.text(g,'TIME BRAKE',320,268,'#a8f3ee',{align:'center',scale:2,outline:false});}\n   this.hud(g,w,options);\n  });\n  if(options.hitboxes||options.trajectories)r.overlay(g=>{\n   if(options.hitboxes){for(const o of [...w.players,...w.enemies,...w.threats])this.ring(g,o.x,o.y,o.r||6,o.r||6,'#ffffff',0,Math.PI*2,.3);}\n   if(options.trajectories)for(const t of w.threats){px.line(g,t.x,t.y,t.x+t.vx*.5,t.y+t.vy*.5,'#ffe880');this.E.font.text(g,String(t.target??''),t.x+9,t.y,'#fff',{font:'tiny'});}\n  });\n }\n titleFleet(r){const t=this.game.reduceMotion?0:this.game.real;for(let i=0;i<12;i++){const a=t*.22+i*.38,x=472+Math.cos(a)*151,y=174+Math.sin(a)*85;r.sprite(x,y,0,this.hulls[i%3],{t:t+i,anchor:'center',scale:1.2+(Math.sin(a)+1)*.32,rot:Math.cos(a)*.2});}}\n hud(g,w,o){\n  const E=this.E,{px}=E;\n  E.font.text(g,String(w.score).padStart(6,'0'),29,12,'#f5e6c9',{scale:2,outline:false,shadow:'#030a15'});E.font.text(g,'TEAM SCORE',30,30,'#7b9ba8',{font:'tiny',outline:false});\n  E.font.text(g,w.wave<8?'WAVE '+String(w.wave+1).padStart(2,'0')+' / 08':'THE BANDIT BOSS',609,12,'#c5d7df',{scale:w.wave<8?2:1,align:'right',outline:false});\n  const label=w.wave<8?WAVES[w.wave].name:BOSS_PHASES[w.bossPhase].name;E.font.text(g,label.toUpperCase(),610,31,'#98b6c3',{align:'right',font:'tiny',outline:false});\n  px.rect(g,228,340,184,6,'#1f3348');px.rect(g,228,340,184*w.brake/100,6,w.brake>=100?'#d4f7c9':'#6ac8cb');\n  for(let i=1;i<8;i++)px.rect(g,228+i*23,340,1,6,'#112032');\n  const prompt=w.brake>=100?(o.brakeLabel||'SHIFT')+'  TIME BRAKE':'INTERCEPT TO CHARGE  '+Math.floor(w.brake)+'%';E.font.text(g,prompt,320,350,w.brake>=100?'#efffcb':'#8baebb',{align:'center',font:'tiny',outline:false});\n  if(w.modified&&\"'!w.demo)E.font.text(g,'\"'DEV / MODIFIED',32,347,'#ffca85',{font:'tiny',outline:false});else if(w.assists?.autoFire||w.assists?.slow||w.assists?.emergency)E.font.text(g,'ASSISTED',32,347,'#acd2a5',{font:'tiny',outline:false});\n  if(o.network)E.font.text(g,o.network,608,348,'#91b9bf',{align:'right',font:'tiny',outline:false});\n  if(this.subtitleUntil>this.game.real&&this.subtitle){\n   const lines=E.font.wrap(this.subtitle,350,{});for(let i=0;i<lines.length;i++)E.font.text(g,lines[i],320,61+i*10,'#e3d6b9',{align:'center',outline:false,shadow:'#020811'});\n  }\n  if(w.phase==='countdown'||w.phase==='intermission'||w.phase==='playing'&&w.phaseTime<3.5){\n   const clear=w.phase==='intermission';const heading=clear?'FLEET BROKEN':w.phase==='countdown'?'DEFEND YOUR CENTURY':'WAVE '+(w.wave+1);const detail=clear?'Ordnance dissolved. Integrity restored.':WAVES[w.wave]?.cue||'READ THE CORE. BREAK THE CLOCK.';\n   E.font.text(g,heading,320,227,'#f6dfac',{align:'center',scale:2,outline:false,shadow:'#080d1a'});E.font.text(g,detail,320,247,'#a7c1c9',{align:'center',outline:false});\n  }\n  if(w.phase==='ending'){const t=w.phaseTime;E.font.text(g,'YOUR TIME IS YOUR OWN.',320,224,'#f8e7ae',{align:'center',scale:2,outline:false});E.font.text(g,t<3?'The rift closes. The invoice goes unanswered.':'Somewhere, the Boss is still filing a complaint.',320,246,'#a7c7c8',{align:'center',outline:false});}\n  if(w.demo){px.rect(g,185,8,270,18,'#122a39');E.font.text(g,'DEMONSTRATION / ANY INPUT TO RETURN',320,13,'#d9ebbd',{align:'center',outline:false});}\n }\n}\nEOF\ncat > src/audio/sound.js <<'EOF'\nexport function codeTone(ctx,bus,when,freq,dur=.15,volume=.1,wave='triangle',to=null){\n const osc=ctx.createOscillator(),gain=ctx.createGain();osc.type=wave;osc.frequency.setValueAtTime(freq,when);if(to)osc.frequency.exponentialRampToValueAtTime(Math.max(20,to),when+dur);gain.gain.setValueAtTime(0,when);gain.gain.linearRampToValueAtTime(volume,when+.006);gain.gain.exponentialRampToValueAtTime(.0001,when+dur);osc.connect(gain);gain.connect(bus);osc.start(when);osc.stop(when+dur+.01);return osc;\n}\nexport function gibberish(ctx,bus,when,line,emotion='gloat'){\n const nodes=[],count=Math.min(13,5+Math.floor(line.length/8));\n for(let i=0;i<count;i++){\n  const t=when+i*.092,dur=.065+(i%3)*.018,base=(emotion==='angry'?122:94)+(i*31%57),o=ctx.createOscillator(),v=ctx.createGain(),f=ctx.createBiquadFilter();\n  o.type='sawtooth';o.frequency.setValueAtTime(base,t);o.frequency.exponentialRampToValueAtTime(base*(i%2?1.5:.72),t+dur);f.type='bandpass';f.frequency.setValueAtTime([680,1200,1750,900,1450][i%5],t);f.Q.value=3;\n  v.gain.setValueAtTime(0,t);v.gain.linearRampToValueAtTime(.19,t+.009);v.gain.exponentialRampToValueAtTime(.0001,t+dur);o.connect(f);f.connect(v);v.connect(bus);o.start(t);o.stop(t+dur+.01);nodes.push(o);\n }\n return nodes;\n}\nconst MELODIES={title:'D5 . A4 C5 | F5 - E5 . | D5 . A4 . | C5 - A4 .',combat:'D5 . . A4 | C5 . F5 . | E5 . C5 . | A4 . . .',escalation:'D5 A4 F5 . | E5 C5 G5 . | F5 E5 D5 C5 | A4 . C5 .',boss:'D4 D5 . Eb5 | A4 . F5 E5 | D5 . C5 A4 | Bb4 A4 G4 .',victory:'D5 F5 A5 - | G5 E5 C5 - | D5 - - - | . . . .',failure:'D5 C5 A4 . | F4 E4 D4 - | . . . . | . . . .'};\nexport class Soundtrack{\n constructor(game){this.game=game;this.kind=null;this.nodes=[];this.enabled=false;this.stopped=false;const A=game.audio;\n const sounds={shot:{wave:'triangle',freq:900,to:220,dur:.075,vol:.14},dart:{wave:'sine',freq:560,to:290,dur:.15,vol:.16},mine:{wave:'pulse',freq:260,to:150,dur:.25,vol:.13},roller:{wave:'triangle',freq:100,to:260,dur:.25,vol:.25},hunter:{wave:'sine',freq:900,to:1450,dur:.3,vol:.11},intercept:{wave:'noise',freq:1300,to:180,dur:.12,vol:.13},kill:{wave:'noise',freq:800,to:100,dur:.24,vol:.17},hit:{wave:'saw',freq:180,to:40,dur:.4,vol:.24},land:{wave:'noise',freq:300,to:80,dur:.2,vol:.23},brake:{wave:'sine',freq:900,to:65,dur:.7,vol:.21},release:{wave:'sine',freq:90,to:540,dur:.3,vol:.15},charged:{wave:'triangle',freq:660,arp:[0,4,7,12],step:.05,dur:.3,vol:.16},weakpoint:{wave:'triangle',freq:400,to:800,dur:.2,vol:.16},shield:{wave:'sine',freq:420,to:190,dur:.16,vol:.13},phaseBreak:{wave:'noise',freq:750,to:100,dur:.7,vol:.25},hullHit:{wave:'triangle',freq:550,to:350,dur:.055,vol:.1},bossHit:{wave:'pulse',freq:290,to:420,dur:.09,vol:.12},blocked:{wave:'sine',freq:170,dur:.09,vol:.12},clear:{wave:'triangle',freq:400,arp:[0,4,7],step:.09,dur:.4,vol:.2}};\n for(const [name,spec]of Object.entries(sounds))A.define('tb:'+name,spec);\n }\n unlock(){this.enabled=true;this.stopped=false;const ctx=this.game.audio._init();if(ctx?.state==='suspended')ctx.resume().catch(()=>{});}\n music(kind){if(kind===this.kind||this.stopped)return;this.kind=kind;const boss=kind==='boss';this.game.audio.music({bpm:boss?132:kind==='title'?92:112,steps:4,tracks:[{name:'lead',wave:'triangle',vol:.18,notes:MELODIES[kind]||MELODIES.combat},{name:'bass',wave:'sine',vol:.2,notes:'D3 . D3 . | Bb2 . Bb2 . | C3 . C3 . | A2 . A2 .'},{name:'pulse',wave:'pulse12',vol:.065,notes:'A4 . D5 . | F4 . Bb4 . | G4 . C5 . | E4 . A4 .'},{name:'drums',wave:'drums',vol:.09,notes:'k . h . | s . h h | k . h . | s h . h'}]},{sync:true});}\n events(events){if(\"'!this.enabled||this.stopped||this.game.paused)return;for(const e of events){if(e.line&&!['\"'hint'].includes(e.type)){this.stopVoice();const ctx=this.game.audio.ctx;if(ctx)this.nodes=gibberish(ctx,this.game.audio.bus('voice'),ctx.currentTime+.005,e.line,e.type==='hit'?'angry':'gloat');}\n const name=e.type==='launch'?e.kind:e.type==='intercept'?'intercept':e.type;if(this.game.audio._defs?.['tb:'+name]||['shot','dart','mine','roller','hunter','intercept','kill','hit','land','brake','release','charged','weakpoint','shield','phaseBreak','hullHit','bossHit','blocked','clear'].includes(name))this.game.audio.sfx('tb:'+name,{pan:e.x==null?0:(e.x-320)/400});}}\n stopVoice(){for(const n of this.nodes)try{n.stop();}catch{}this.nodes=[];}\n pause(){this.stopVoice();}\n end(){this.stopped=true;this.kind=null;this.stopVoice();this.game.audio.music(null);const c=this.game.audio.ctx;if(c?.state==='running')c.suspend().catch(()=>{});}\n reset(){this.stopVoice();this.kind=null;this.stopped=false;}\n}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport urllib.request\nfor file,url in [('peerjs-1.5.5.min.js','https://unpkg.com/peerjs@1.5.5/dist/peerjs.min.js'),('peerjs-LICENSE','https://raw.githubusercontent.com/peers/peerjs/v1.5.5/LICENSE')]:\n try:Path('vendor/'+file).write_bytes(urllib.request.urlopen(url).read())\n except Exception as e:print(file,str(e))\nPY\ncat > src/network/transports.js <<'EOF'\nexport class PacketMeter {\n constructor(){this.sent=0;this.bytes=0;this.maxBytes=0;this.maxSecond=0;this.bucket=[];this.rejected=0;}\n record(data){const bytes=new TextEncoder().encode(JSON.stringify(data)).length;if(bytes>16384){this.rejected++;return false;}const now=performance.now();this.bucket=this.bucket.filter(t=>now-t<1000);this.bucket.push(now);this.sent++;this.bytes+=bytes;this.maxBytes=Math.max(bytes,this.maxBytes);this.maxSecond=Math.max(this.maxSecond,this.bucket.length);return true;}\n snapshot(){return{sent:this.sent,bytes:this.bytes,maxBytes:this.maxBytes,maxSecond:this.maxSecond,rejected:this.rejected};}\n}\nexport class HubTransport {\n constructor(hub,info,hooks){this.hub=hub;this.info=info;this.hooks=hooks;this.kind='hub';this.isHost=info.isHost;this.me=info.server?null:info.me;this.server=\"'!!info.server;this.roster=info.players.map(p=>({...p,ready:true}));this.meter=new PacketMeter();this.ended=false;this.finished=false;this.off=[];\n  this.off.push(hub.on('\"'message',(data,from)=>{if(this.ended)return;if(this.isHost){if(data?.k==='a'&&this.roster.some(p=>p.id===from))hooks.action(from,data);}else if(from===hub.host&&data?.k==='w')hooks.world(data);}));\n  this.off.push(hub.on('leave',({id})=>{this.roster=this.roster.filter(p=>p.id\"'!==id);hooks.leave(id);}));\n  this.off.push(hub.on('\"'time-up',()=>{if(this.isHost&&\"'!this.ended)hooks.timeUp();}));\n  this.off.push(hub.on('\"'end',({reason})=>{if(this.ended)return;this.ended=true;hooks.end(reason);}));\n }\n sendAction(data){if(\"'!this.ended&&!this.isHost&&this.meter.record(data))this.hub.send(data,{to:this.hub.host,reliable:false});}\n sendWorld(data){if(!this.ended&&this.isHost&&this.meter.record(data))this.hub.send(data,{reliable:true});}\n finish(world){if(this.finished||this.ended||!this.isHost)return;this.finished=true;const ids=this.roster.map(p=>p.id);this.hub.finish({standings:[ids],scores:Object.fromEntries(ids.map(id=>[id,world?.score||0])),won:!!world?.outcome?.won,stats:Object.fromEntries(ids.map(id=>[id,{Interceptions:world?.players.find(p=>p.id===id)?.intercepts||0,Wave:Math.min(9,(world?.wave||0)+1)}]))});}\n close(){for(const off of this.off)off();this.ended=true;}\n}\nexport class RoomTransport {\n constructor(hooks){this.hooks=hooks;this.kind='\"'peer';this.me=null;this.isHost=false;this.server=false;this.peer=null;this.links=new Map();this.roster=[];this.code='';this.running=false;this.closed=false;this.run=0;this.meter=new PacketMeter();this.timers=new Set();this.lastInput=new Map();}\n timer(fn,ms){const id=setTimeout(()=>{this.timers.delete(id);fn();},ms);this.timers.add(id);return id;}\n cancelTimer(id){clearTimeout(id);this.timers.delete(id);}\n async load(){\n  if(globalThis.AIHub?.active)throw new Error('Independent transport is unavailable during a Hub round.');\n  if(\"'!globalThis.Peer){await new Promise((resolve,reject)=>{const blob=new Blob([PEER_SOURCE],{type:'\"'text/javascript'}),url=URL.createObjectURL(blob),script=document.createElement('script');script.src=url;script.onload=()=>{URL.revokeObjectURL(url);resolve();};script.onerror=()=>{URL.revokeObjectURL(url);reject(new Error('The bundled online client could not load.'));};document.head.append(script);});}\n }\n status(text){if(\"'!this.closed)this.hooks.status(text);}\n async create(){\n  this.isHost=true;this.me=0;this.code=this.randomCode();this.roster=[{id:0,name:'\"'PILOT 1',ready:true}];await this.openPeer('TBB-'+this.code);if(this.closed)return;this.status('ROOM OPEN · Share the code with up to three pilots.');this.hooks.roster();\n }\n randomCode(){const a=new Uint8Array(8);crypto.getRandomValues(a);return Array.from(a,v=>'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'[v%32]).join('');}\n async openPeer(id){await this.load();if(this.closed)throw new Error('Connection cancelled.');\n  await new Promise((resolve,reject)=>{\n   const peer=this.peer=new globalThis.Peer(id,{debug:0});let opened=false;const timeout=this.timer(()=>{reject(new Error('Signaling timed out. Check your connection, retry, or play solo.'));peer.destroy();},18000);\n   peer.on('open',()=>{opened=true;this.cancelTimer(timeout);resolve();});\n   peer.on('error',err=>{this.cancelTimer(timeout);const message=err.type==='peer-unavailable'?'No room with that code. Check the code and try again.':err.type==='unavailable-id'?'That room code is busy. Create a new room.':'Online link failed: '+String(err.type||err.message)+'. Retry or return to solo.';this.status(message);if(\"'!opened)reject(new Error(message));});\n   peer.on('\"'disconnected',()=>{if(\"'!this.closed)this.status('\"'Signaling disconnected. Existing links may continue. Leave and retry if needed.');});\n   peer.on('connection',conn=>this.incoming(conn));\n  });\n }\n async join(code){\n  this.code=code.toUpperCase().replace(/[\"'^A-Z2-9]/g,'\"'');if(this.code.length\"'!==8)throw new Error('\"'Enter the eight-character room code.');\n  this.isHost=false;await this.openPeer(undefined);if(this.closed)return;\n  return new Promise((resolve,reject)=>{\n   const conn=this.peer.connect('TBB-'+this.code,{reliable:true,serialization:'json',metadata:{game:'time-bandit-boss',v:1}});this.hostLink=conn;\n   const timeout=this.timer(()=>{conn.close();reject(new Error('The data link timed out. A firewall or NAT may block this room. Retry or play solo.'));},18000);\n   conn.on('open',()=>conn.send({k:'hello',v:1}));\n   conn.on('data',data=>{\n    if(this.closed)return;\n    if(data?.k==='welcome'&&Number.isInteger(data.id)&&Array.isArray(data.roster)){this.cancelTimer(timeout);this.me=data.id;this.roster=data.roster;this.status('CONNECTED · Ready when you are.');this.hooks.roster();resolve();}\n    else if(data?.k==='reject'){this.cancelTimer(timeout);conn.close();reject(new Error(data.reason));}\n    else this.receiveHost(data);\n   });\n   conn.on('close',()=>{if(\"'!this.closed)this.hooks.end('\"'The host left the room. Your run has ended.');});conn.on('error',()=>{this.cancelTimer(timeout);reject(new Error('The data link failed. Retry or play solo.'));});\n  });\n }\n incoming(conn){\n  if(\"'!this.isHost||this.closed){conn.close();return;}\n  let seat=null,handshake=false;const timeout=this.timer(()=>{if(!handshake)conn.close();},8000);\n  conn.on('\"'data',data=>{\n   if(this.closed||\"'!data||JSON.stringify(data).length>16384)return;\n   if(!handshake){\n    if(data.k!=='\"'hello'||data.v\"'!==1){conn.close();return;}\n    if(this.running||this.roster.length>=4){conn.send({k:'\"'reject',reason:this.running?'This run is underway. Join when the host returns to the room.':'This room already has four pilots.'});this.timer(()=>conn.close(),300);return;}\n    seat=[1,2,3].find(id=>\"'!this.roster.some(p=>p.id===id));if(seat===undefined){conn.close();return;}\n    handshake=true;this.cancelTimer(timeout);this.links.set(seat,conn);this.roster.push({id:seat,name:'\"'PILOT '+(seat+1),ready:false});conn.send({k:'welcome',id:seat,roster:this.roster});this.broadcast({k:'roster',roster:this.roster});this.hooks.roster();\n   }else if(data.k==='ready'&&\"'!this.running&&typeof data.value==='\"'boolean'){\n    this.roster.find(p=>p.id===seat).ready=data.value;this.broadcast({k:'roster',roster:this.roster});this.hooks.roster();\n   }else if(data.k==='a'&&this.running){\n    const now=performance.now(),last=this.lastInput.get(seat)||[];const recent=last.filter(t=>now-t<1000);if(recent.length>=20)return;recent.push(now);this.lastInput.set(seat,recent);this.hooks.action(seat,data);\n   }\n  });\n  conn.on('close',()=>{this.cancelTimer(timeout);if(seat\"'!==null&&this.links.get(seat)===conn){this.links.delete(seat);this.roster=this.roster.filter(p=>p.id!==seat);this.hooks.leave(seat);this.broadcast({k:'\"'roster',roster:this.roster});this.hooks.roster();}});\n  conn.on('error',()=>conn.close());\n }\n receiveHost(data){if(\"'!data||this.closed)return;\n  if(data.k==='\"'roster'&&Array.isArray(data.roster)){this.roster=data.roster;this.hooks.roster();}\n  else if(data.k==='begin'&&Number.isInteger(data.run)&&data.run>this.run){this.run=data.run;this.running=true;this.roster=data.roster;this.hooks.begin(data.seed);}\n  else if(data.k==='w'&&this.running)this.hooks.world(data);\n  else if(data.k==='lobby'){this.running=false;this.roster=data.roster;this.hooks.lobby();}\n }\n broadcast(data){if(this.closed||\"'!this.meter.record(data))return;for(const conn of this.links.values())if(conn.open)conn.send(data);}\n sendWorld(data){if(this.isHost&&this.running)this.broadcast(data);}\n sendAction(data){if(!this.isHost&&!this.closed&&this.hostLink?.open&&this.meter.record(data))this.hostLink.send(data);}\n ready(){const p=this.roster.find(p=>p.id===this.me);if(this.isHost||!p)return;this.hostLink?.send({k:'\"'ready',value:\"'!p.ready});}\n start(seed){if(!this.isHost||this.closed||this.running||!this.roster.every(p=>p.ready))return false;this.running=true;this.run++;this.broadcast({k:'\"'begin',run:this.run,seed,roster:this.roster});this.hooks.begin(seed);return true;}\n lobby(){if(\"'!this.isHost)return;this.running=false;for(const p of this.roster)p.ready=p.id===0;this.broadcast({k:'\"'lobby',roster:this.roster});this.hooks.lobby();}\n close(){if(this.closed)return;this.closed=true;for(const id of this.timers)clearTimeout(id);this.timers.clear();for(const conn of this.links.values())conn.close();this.links.clear();this.hostLink?.close();this.peer?.destroy();}\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
