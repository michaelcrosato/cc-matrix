{"type":"item.completed","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -lc \"sed -n '835,893p' src/main.js && tail -35 tests/state.mjs && head -42 tools/test.mjs && sed -n '303,340p' tests/browser.py\"","aggregated_output":"        }))\n        .concat([\n          [\n            \"Keep \" + letters.map((n) => alphabet[n]).join(\"\"),\n            () => {\n              const v = letters.map((n) => alphabet[n]).join(\"\");\n              ui.back();\n              done(v);\n            },\n          ],\n          [\"Back\", () => ui.back()],\n        ]),\n    });\n    const buttons = [...ui.root.querySelectorAll(\".esh-btns button\")];\n    buttons.slice(0, length).forEach((b, i) => {\n      b._cycle = (d) => {\n        letters[i] = (letters[i] + d + alphabet.length) % alphabet.length;\n        redraw();\n      };\n    });\n  };\n  redraw();\n}\nfunction makeHooks() {\n  return {\n    action: (id, a) => {\n      if (world && transport?.isHost && !terminated) acceptAction(world, id, a);\n    },\n    world: (p) => {\n      if (terminated || transport?.isHost) return;\n      const next = applyWorldPacket(world, p, transport.roster);\n      if (next) {\n        previousPacket = world;\n        world = next;\n        latestPacket = p;\n        packetAt = performance.now();\n      }\n    },\n    leave: (id) => {\n      if (world && transport?.isHost) leaveWorld(world, id);\n    },\n    timeUp: () => {\n      if (world && !world.outcome) finishWorld(world, false, \"time-limit\");\n      transport?.finish(world);\n    },\n    end: (reason) => {\n      terminated = true;\n      consume();\n      sound.end();\n      if (hosted) {\n        world && (world.phase = \"terminated\");\n        game.stop();\n      } else {\n        ui.hide();\n        ui.show(\"disconnected\", {\n          title: \"Timeline disconnected\",\n          text: reason,\n          actions: [\n            [\n    assert.equal(w.assists.autoFire, false);\n    assert.equal(w.stats.ships, 200);\n    assert(w.stats.brakes > 0);\n    assert(w.stats.intercepts > 0);\n    assert(maxBytes < 16384);\n    run(w, 6.1);\n    assert.equal(w.phase, \"results\");\n    campaignResult = {\n      seconds: w.time,\n      score: w.score,\n      stats: w.stats,\n      seen: w.seen,\n      maxSnapshotBytes: maxBytes,\n      seed: w.seed,\n      health: w.players.map((p) => p.hp),\n    };\n  });\n  test(\"native game.advance drives canonical 120 Hz simulation\", () => {\n    const E = globalThis.My3D2dge,\n      g = new E.Game({\n        headless: true,\n        res: [640, 360],\n        view: \"overhead\",\n        menu: false,\n      }),\n      w = createWorld();\n    g.start({ update: (dt) => stepWorld(w, dt), draw() {} });\n    g.advance(2.01);\n    assert.equal(w.tick, 241);\n    assert.equal(w.phase, \"playing\");\n    assert.deepEqual(g.errors, []);\n    g.dispose();\n  });\n  return { results, campaign: campaignResult };\n}\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { spawnSync } from \"node:child_process\";\nimport { stateTests } from \"../tests/state.mjs\";\nconst root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nlet results = [];\nconst requested = process.argv.slice(2);\nconst all = !requested.length;\nif (all || requested.includes(\"state\")) {\n  const state = stateTests();\n  results.push(...state.results);\n  fs.writeFileSync(\n    path.join(root, \"artifacts/state-results.json\"),\n    JSON.stringify(state, null, 2),\n  );\n}\nfor (const target of [\"browser\", \"network\"])\n  if (all || requested.includes(target)) {\n    const run = spawnSync(\n      \"/home/micha/.local/share/pipx/venvs/playwright/bin/python\",\n      [path.join(root, \"tests\", target + \".py\")],\n      { cwd: root, encoding: \"utf8\", timeout: 240000 },\n    );\n    fs.writeFileSync(\n      path.join(root, \"artifacts\", target + \"-runner.log\"),\n      run.stdout + \"\\n\" + run.stderr,\n    );\n    let report;\n    try {\n      report = JSON.parse(run.stdout.trim());\n    } catch {\n      report = {\n        results: [\n          {\n            name: target + \" runner\",\n            pass: false,\n            error: run.stderr || run.stdout || \"Runner did not return a report\",\n          },\n        ],\n      };\n    }\n        advance(page, 9.8)\n        expect(not page.evaluate(\"TimeBandit.snapshot().demo\"))\n        advance(page, 0.3)\n        expect(page.evaluate(\"TimeBandit.snapshot().demo\"))\n        advance(page, 76, False)\n        seen = page.evaluate(\"TimeBandit.world.seen\")\n        expect(\n            all(x in seen for x in [\"dart\", \"mine\", \"roller\", \"hunter\", \"boss2\"]),\n            str(seen),\n        )\n        expect(page.evaluate(\"JSON.stringify(TimeBandit.getRecords())\") == before)\n        key(page, \"Enter\")\n        expect(\n            page.evaluate(\"TimeBandit.ui.screen==='title' && TimeBandit.world===null\"),\n            \"wake was not consumed\",\n        )\n        for device in [\"mouse\", \"pad\"]:\n            page.evaluate(\"TimeBandit.startAttract()\")\n            advance(page, 0.03)\n            if device == \"mouse\":\n                page.mouse.move(250, 300)\n            else:\n                page.evaluate(\"window.__pad.axes[0]=.8\")\n                advance(page, 0.025)\n                page.evaluate(\"window.__pad.axes[0]=0\")\n            advance(page, 0.025)\n            expect(\n                page.evaluate(\n                    \"TimeBandit.ui.screen==='title' && !TimeBandit.snapshot().demo\"\n                )\n            )\n\n    check(\n        \"10-second attract, all threat showcase, wake consumption, saved-state isolation\",\n        attract,\n    )\n\n    def focus_disconnect():\n","exit_code":0,"status":"completed"}}
