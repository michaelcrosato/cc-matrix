{"type":"item.started","item":{"id":"item_87","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport json\np=Path('src/main.js');s=p.read_text();old='  world.assisted = Object.values(world.assists).some(Boolean);';new='''  if(\"'!isNetwork && (devSpeed!==1 || ['\"'invulnerable','ai','hitboxes','trajectories'].some(key=>game.settings['dev_'+key])))world.modified=true;\n  world.assisted = Object.values(world.assists).some(Boolean);''';assert old in s;s=s.replace(old,new,1);p.write_text(s)\np=Path('tests/browser.py');s=p.read_text();pos=s.index('    def full_campaign():');s=s[:pos]+'''    def inherited_developer_flags():\n        for flag in ['invulnerable','ai','hitboxes','trajectories']:\n            page.evaluate(\\\"(flag)=>{TimeBandit.resetTuning();TimeBandit.startSolo(false);game.settings.set('dev_'+flag,true);TimeBandit.startSolo(false);}\\\",flag)\n            expect(page.evaluate('TimeBandit.world.modified'),'inherited '+flag+' allowed a normal record')\n        page.evaluate('TimeBandit.resetTuning();TimeBandit.startSolo(false);TimeBandit.openDev()')\n        page.get_by_role('button',name='Simulation speed:',exact=False).click()\n        page.evaluate('TimeBandit.startSolo(false)')\n        expect(page.evaluate('TimeBandit.world.modified'),'inherited simulation speed allowed a normal record')\n        page.evaluate('TimeBandit.resetTuning();TimeBandit.startSolo(false)')\n        expect(page.evaluate('\"'!TimeBandit.world.modified'\"'),'reset failed to restore standard eligibility')\n    check('inherited developer assists and speed cannot submit normal records',inherited_developer_flags)\n\n''' +s[pos:];p.write_text(s)\np=Path('../exit-interview.json');x=json.loads(p.read_text());x['testingFeedback'][0]='10 distinct defects found and fixed; the issue ledger records each. Test-fixture errors and duplicate failures are excluded.';x['testingFeedback'][1]='2 critical issues: narrow low-density screens could crop the defense lane, and a retry could inherit developer invulnerability/AI/speed while remaining eligible for a normal record. Both are fixed.';p.write_text(json.dumps(x,indent=2,ensure_ascii=False)+'\\\\n')\np=Path('docs/build-notes.md');s=p.read_text();s=s.replace('Test-fixture corrections (not counted as game defects):','''| 10 | Final score-isolation browser probe and inherited-flags regression | Critical score integrity | Retry compared numeric tuning but not inherited invulnerability, AI, overlays or simulation speed. New solo runs now inspect every effective developer modifier; resetting restores standard eligibility. |\n\nTest-fixture corrections (not counted as game defects):''');p.write_text(s)\nPY\nbiome check --write --javascript-linter-enabled=false --css-linter-enabled=false --assist-enabled=false --javascript-formatter-indent-style=space --javascript-formatter-indent-width=2 src tools tests/state.mjs tests/packaging.mjs\nruff check --fix --ignore BLE001,B023,S110 tests\nruff format tests\nnode tools/build.mjs --quiet\nnode tools/test.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
