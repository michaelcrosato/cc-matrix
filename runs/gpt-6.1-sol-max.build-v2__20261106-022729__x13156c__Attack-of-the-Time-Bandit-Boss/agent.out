{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"sed -n '2930,2966p' vendor/engine/my-3d2dge.js && sed -n '1152,1198p' vendor/engine/my-3d2dge.js && sed -n '9610,9635p' vendor/engine/my-3d2dge.js && sed -n '9650,9660p' vendor/engine/my-3d2dge.js\"","aggregated_output":"    if (this.onError) try { this.onError(e, where); } catch (e2) { /* ignore */ }\n  }\n  _step(dt) {\n    if (this._next) { const nx = this._next; this._next = null; this._enter(nx.name, nx.data); }\n    this.real += dt; this._shakeAmt *= Math.exp(-dt * 9); this.input.tick(dt); if (this._players) for (let i = 1; i < this._players.length; i++) this._players[i].tick(dt);   // (the other players: section 10j)\n    this.audio._tick(false);   // (the music clock: a song on game.real plays on through a pause)\n    for (const f of HOOKS.input) f(this, dt);\n    this._ownRun('input', dt);\n    if (this.input.padLost) { this._autoPause('controller'); if (this.shell) this.shell.toast('Controller disconnected', 'Press a button on a controller to use it, or play on.'); else this.note('CONTROLLER DISCONNECTED', 2.5); }\n    if (this.shell) this.shell._step();   // its screens move the focus with this step's input, and hold it back from the game\n    if (this._flash) this._flash.t += dt / Math.max(.05, this.timeScale);   // real time: slow motion does not stretch a flash\n    if (this._fade) { const out = this._fade.out; this._fadeStep(dt); if (out) return; }   // the old scene freezes while it fades out\n    const s = this.scene;\n    if (s && s.pausable && this.input.pressed('pause')) { this.paused = !this.paused; this.pauseReason = this.paused ? 'player' : null; this.audio.sfx('pause'); }\n    if (!this.paused) { this.pauseReason = null; this._goOn = false; }\n    this.audio._duck(this.paused);\n    // the player's zoom: the wheel, - and = and a pinch ask for it while a scene that allows it plays (input.zoom())\n    const I = this.input, zr = !this.paused && !(this.shell && this.shell.screen) && !!this.zoomRange();\n    I._zoomOn = zr; I._wheelOn = zr && (this._camera() || {}).wheel !== false;\n    if (this._zoomTo && !I._pinching && this._wall - this._zoomAt > .25) this._zoomApply();   // they stopped: the new zoom, drawn crisp\n    if (this.paused && !this.live && !this._goOn) return;   // (live: the world steps on under the menu)\n    if (!this.paused) { this._zoomFit(); const zk = I.zoom(); if (zk !== 1) this.zoomBy(zk); }\n    if (this.hitstop > 0) { this.hitstop -= dt; return; }\n    this.time += dt;\n    this.audio._tick(true);   // (a synced song: on game.time, it waits with the game)\n    const T = this._timers;\n    if (T.length) {\n      for (let i = 0; i < T.length; i++) { const t = T[i]; if (t.dead || this.time < t.at) continue; if (t.every) t.at += t.every; else t.dead = true; t.fn(); }\n      prune(T, t => t.dead);\n    }\n    for (const f of HOOKS.step) f(this, dt);\n    this._ownRun('step', dt);\n    if (s && s.update) s.update(dt);\n    const f = this._follow;\n    if (f && f.target) {\n      const t = f.target, sp = Math.hypot(t.vx || 0, t.vy || 0), dir = typeof t.facing === 'number' && Math.abs(t.facing) === 1 && !t.vy ? [t.facing, 0] : sp > 1 ? [(t.vx || 0) / sp, (t.vy || 0) / sp] : [0, 0];\n      this.focus(t.x + dir[0] * f.lead, (t.y || 0) + dir[1] * f.lead, (t.z || 0) + f.z);\n    if (g.mode === 'box' && this._gBox) this._gBox.done = true;\n    else if (!g.moved) {\n      const L = this._lastTap;\n      if (L && this.clock - L.t < .35 && Math.hypot(x - L.x, y - L.y) < 8) { this._gTap2 = [x, y]; this._lastTap = null; }\n      else this._lastTap = { x, y, t: this.clock };\n    }\n  }\n  /** browser client coords -> screen pixels [x, y] (the HUD's space, with no camera), or null without a canvas */\n  screenPoint(cx, cy) {\n    const S = this.screen; if (!S.canvas) return null;\n    const rc = S.canvas.getBoundingClientRect(); return [((cx - rc.left) * S.dpr - S.OX) / S.S, ((cy - rc.top) * S.dpr - S.OY) / S.S];\n  }\n  /** advance input by one step: read the gamepad and turn presses since the last step into this step's pressed() and\n   *  released() (the engine calls it every step) */\n  tick(dt) {\n    this._suppressed.clear();\n    this.clock += dt;\n    let pads = [];\n    try { pads = navigator.getGamepads ? navigator.getGamepads() : []; } catch (e) { /* gamepads blocked */ }\n    const C = this._claimed, ok = p => p && p.connected !== false && (this.pad === 'any' ? !(C && C.has(p.index)) : p.index === this.pad);   // (its own pad, or any another player hasn't)\n    const p = this.pad === null ? null : Array.from(pads || []).find(p => ok(p) && p.index === this.padIndex) || Array.from(pads || []).find(ok);\n    this.padLost = false;\n    if (!p || p.index !== this.padIndex || p.id !== this.padId) {\n      if (!p && this.padIndex !== null) { this.padLost = this.lastDevice === 'gamepad'; this.stopRumble(); }   // unplugged while in use\n      if (this.padIndex !== null) { this.padPrev.forEach((on, i) => { if (on) this.release('Pad' + i); }); for (const c of ['PadAxisUp', 'PadAxisDown', 'PadAxisLeft', 'PadAxisRight', 'PadRAxisUp', 'PadRAxisDown', 'PadRAxisLeft', 'PadRAxisRight']) this.release(c); }   // (a pad gone or changed lets go once; with none, a script's pad codes stay held)\n      this.padPrev = []; this.padMove = [0, 0]; this.padAim = null; this.padAxes = []; this.padValues = [];\n      this.padIndex = p ? p.index : null; this.padId = p ? p.id : '';\n      if (this.aimSource === 'pad') this.aimSource = 'move';\n    }\n    if (p) {\n      const dz = (x, y) => { const l = Math.hypot(x, y), d = clamp(this.deadzone, 0, .8); return l <= d ? [0, 0] : [x / l * Math.min(1, (l - d) / (1 - d)), y / l * Math.min(1, (l - d) / (1 - d))]; };\n      this.padAxes = Array.from(p.axes);\n      this.padMove = dz(p.axes[0] || 0, p.axes[1] || 0); if (this.invertMoveX) this.padMove[0] *= -1; if (this.invertMoveY) this.padMove[1] *= -1;   // (the Controller settings: a stick worn the wrong way)\n      const aim = dz(p.axes[2] || 0, p.axes[3] || 0);\n      this.padAim = Math.hypot(...aim) > 0 ? [aim[0], aim[1] * (this.invertAimY ? -1 : 1)] : null;\n      this.padValues = p.buttons.map(b => b.value || (b.pressed ? 1 : 0));\n      const ra = this.padAim || [0, 0], rd = [ra[1] < -.5, ra[1] > .5, ra[0] < -.5, ra[0] > .5];\n      ['PadRAxisUp', 'PadRAxisDown', 'PadRAxisLeft', 'PadRAxisRight'].forEach((c, i) => rd[i] ? this.press(c) : this.release(c));   // (the right stick past halfway: codes to bind)\n      if (this.padAim || Math.hypot(...this.padMove) > 0) { this.aimSource = 'pad'; this.lastDevice = 'gamepad'; }\n      p.buttons.forEach((b, i) => { const on = b.pressed; if (on && !this.padPrev[i]) this.press('Pad' + i); if (!on && this.padPrev[i]) this.release('Pad' + i); this.padPrev[i] = on; });\n      const dirs = [this.padMove[1] < -.5, this.padMove[1] > .5, this.padMove[0] < -.5, this.padMove[0] > .5];\n      ['PadAxisUp', 'PadAxisDown', 'PadAxisLeft', 'PadAxisRight'].forEach((c, i) => dirs[i] ? this.press(c) : this.release(c));\n    }\n    // a tap is held for the one step after it (its release comes the step after that)\n    for (const c of this._tapsDue) if (!this._holds.has(c)) this.release(c);\n    const due = this._tapsDue; due.clear(); this._tapsDue = this._taps; this._taps = due;\n    // presses since the last step become this step's pressed()/released()\n    help(sp.help);\n    if (sp.type === 'slider') {\n      const box = this._el('span', 'esh-ctl'), r = this._el('input'), out = this._el('output'), lo = sp.min === undefined ? 0 : sp.min, hi = sp.max === undefined ? 1 : sp.max;\n      const fmt = v => hi <= 1 && lo >= 0 ? Math.round(v * 100) + '%' : Math.round(v * 100) / 100 + (sp.unit || '');\n      Object.assign(r, { type: 'range', min: lo, max: hi, step: sp.step || (hi - lo) / 20, value: S[key] }); r.setAttribute('aria-label', sp.label || key); out.textContent = fmt(S[key]);\n      r.oninput = () => { out.textContent = fmt(this._set(key, +r.value)); };\n      box.append(r, out);\n      if (sp.calibrate) { const b = this._el('button', 'esh-sel', 'Calibrate'); b.onclick = () => this._calibrate(key); box.appendChild(b); }\n      row.appendChild(box); return row;\n    }\n    if (sp.type === 'select') {\n      const opts = (sp.options || []).map(o => Array.isArray(o) ? o : [o, String(o)]), b = this._el('button', 'esh-sel');\n      const show = () => { const o = opts.find(o => o[0] === S[key]) || opts[0]; b.textContent = '‹ ' + (o ? o[1] : '') + ' ›'; b.setAttribute('aria-label', (sp.label || key) + ': ' + (o ? o[1] : '')); };\n      b._cycle = d => { const i = opts.findIndex(o => o[0] === S[key]); this._set(key, opts[((i < 0 ? 0 : i) + d + opts.length) % opts.length][0]); show(); };\n      b.onclick = () => b._cycle(1); show(); row.appendChild(b); return row;\n    }\n    if (sp.type !== 'toggle') return null;\n    const b = this._el('button', '', S[key] ? 'On' : 'Off'); b.setAttribute('role', 'switch'); b.setAttribute('aria-checked', String(!!S[key]));\n    b.onclick = () => { const v = this._set(key, !S[key]); b.textContent = v ? 'On' : 'Off'; b.setAttribute('aria-checked', String(!!v)); };\n    row.appendChild(b); return row;\n  }\n  /** the settings screen's rows: Display, Sound and Comfort, then the game's own (standard: false, the game's items only) */\n  _settingsRows(add) {\n    const S = this._game.settings, own = this._items().map(i => i.key);\n    if (!this._std) { for (const k of own) add(this._row(k)); return; }\n    const groups = SHELL_GROUPS.concat([...new Set(S.keys().map(k => S.spec(k).group))].filter(g => !SHELL_GROUPS.includes(g) && !['Controls', 'Controller', 'Touch'].includes(g)));\n      P.forEach((q, k) => { const b = this._el('button', k === (this._pl || 0) ? 'pri' : '', 'Player ' + (k + 1) + (q.device === 'gamepad' ? ' (controller)' : q.half ? ' (' + q.half + ' keys)' : '')); b.onclick = () => { this._pl = k; this._capEnd(''); this._render(); }; row.appendChild(b); });\n      add(row);\n    }\n    add(this._el('p', 'esh-m', 'Choose a key or button, then press the new one. The arrow keys, the d-pad, Enter and Escape always work in menus.'), st);\n    const S = this._game.settings, coarse = window.matchMedia && matchMedia('(any-pointer: coarse)').matches, touch = I._touchArgs && (coarse || I._touched || S.touch === 'on');\n    const touchRows = () => { add(this._el('div', 'esh-k esh-sec', 'Touch')); for (const k of S.keys('Touch')) add(this._row(k)); }, first = touch && I.lastDevice === 'touch';\n    if (first) touchRows();   // (a phone in hand: its buttons first)\n    const grid = this._el('div', 'esh-bind'); grid.append(this._el('span'), this._el('small', '', 'Keyboard'), this._el('small', '', 'Controller'));\n    for (const a of Object.keys(I.map).filter(a => I.rebindable(a))) {\n      const name = typeof names[a] === 'string' ? names[a] : actionName(a); grid.appendChild(this._el('span', '', name));\n      for (const d of ['keys', 'pad']) {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"cat > src/main.js <<'EOF'\nimport { TITLE, ARENA, DEFAULTS, TUNING, WAVES, BOSS_PHASES, WEAPONS } from './content/campaign.js';\nimport { FIXED_DT, bound, createWorld, stepWorld, acceptAction, botAction, worldPacket, applyWorldPacket, spawnThreat, startEncounter, finishWorld, leaveWorld } from './game/simulation.js';\nimport { Presentation } from './presentation/renderer.js';\nimport { Soundtrack } from './audio/sound.js';\nimport { HubTransport, RoomTransport } from './network/transports.js';\nconst E=globalThis.My3D2dge;\nconst TEST_MODE=new URLSearchParams(location.search).has('test');\nlet world=null,transport=null,hosted=false,terminated=false,seq=0,brakeEdge=0,netInput=0,netWorld=0,latestPacket=null,previousPacket=null,packetAt=0;\nlet lastHuman=0,demo=false,demoClock=0,demoStage=-1,scoreSaved=false,returnScreen='title',onlineStatus='',joinCode='',devSpeed=1,devAccumulator=0,automation=null;\nlet pointerTarget=null,pointerAnchor=null,lastDevice='keyboard',deviceStamp=0,pausedBefore=false,pausedAt=0,lastPrompt='',displayState=null;\nlet creditsPage=0;\nconst inputMap={...E.Input.SHMUP,fire:['Space','KeyZ','KeyJ','Mouse0','Pad0','Pad7'],bomb:['ShiftLeft','ShiftRight','Mouse2','Pad2','Pad6']};\nconst ownSettings=[{key:'music',value:.1},{key:'glyphs',value:'playstation'},\n {key:'voice',label:'Tyrant voice',group:'Sound',type:'slider',value:.8,apply:(g,v)=>{g.audio.voiceVolume=v;g.audio.applyVolume();}},\n {key:'assistance',label:'Gentle timeline',group:'Game',value:false,help:'Auto fire, slower weapons and emergency brake.',apply:(g,v)=>{if(\"'!g.settings)return;for(const k of ['\"'autoFire','slowHostiles','emergencyBrake'])if(g.settings.spec(k))g.settings.set(k,v);}},\n {key:'autoFire',label:'Automatic fire',group:'Game',value:false}, {key:'slowHostiles',label:'Slower hostile weapons',group:'Game',value:false}, {key:'emergencyBrake',label:'Emergency time brake',group:'Game',value:false},\n ...TUNING.map(([key,label,min,max,step,unit])=>({key:'dev_'+key,label,group:'Dev tuning',value:DEFAULTS[key],min,max,step,unit,persist:false,help:'Default '+DEFAULTS[key]+unit})),\n ...[['invulnerable','Invulnerability'],['hitboxes','Hitboxes'],['trajectories','Target & trajectory overlays'],['ai','AI control']].map(([key,label])=>({key:'dev_'+key,label,group:'Dev tools',value:false,persist:false}))\n];\nconst game=new E.Game({id:'time-bandit-boss-v1',canvas:'screen',res:[ARENA.w,ARENA.h],expand:false,view:'overhead',views:['overhead'],input:inputMap,fullscreen:'button',autoPause:true,camera:false,menu:{quit:false,controls:{fire:'Fire cannon',bomb:'Time brake'},settings:ownSettings,items:()=>hosted?[]:[['Dev Mode',openDev],['How to play',showHelp],['About / Credits',()=>showCredits(0)],['Leave run',()=>{if(transport)leaveRoom();else title();}]]}});\ngame.fadeTime=0;game.cam.smooth=0;game.lights.enabled=true;game.lights.ambient=.77;game.input.touchButtons([]);game.input.steer='drag';\nconst art=new Presentation(game),sound=new Soundtrack(game),arcade=new E.Arcade(game,{id:'time-bandit-boss',idle:10,demo:90,scores:6});\nconst ui=new E.Shell(game,{theme:{accent:'#f2cc87',ink:'#f5efdb',muted:'#a2b7c6',paper:'rgba(10,22,37,.96)',line:'#39516a',font:'system-ui, sans-serif',titleFont:'Impact, Haettenschweiler, \\\"Arial Narrow Bold\\\", sans-serif',scale:()=>Math.max(.82,Math.min(2,innerHeight/540,innerWidth/820))},screens:{pause:{title:()=>hosted?'Local options':game.pauseReason==='focus'?'Focus lost':game.pauseReason==='controller'?'Controller disconnected':'Timeline paused',text:()=>hosted?'The shared timeline continues. Your machine is waiting for input.':game.pauseReason==='focus'?'Your machine is safe. Resume when you are ready.':game.pauseReason==='controller'?'Reconnect a controller, or continue with keyboard and mouse.':'Take a second. The universe can wait.'},help:{}}});\nconst touchBrake=document.getElementById('touch-brake'),devicePrompt=document.getElementById('device-prompt'),touchNote=document.getElementById('touch-note');\nfunction touchMode(){return game.input.lastDevice==='touch'||matchMedia('(pointer:coarse)').matches;}\nfunction markModified(){if(world)world.modified=true;}\nfunction effectiveTuning(){return Object.fromEntries(Object.keys(DEFAULTS).map(k=>[k,game.settings.spec('dev_'+k)?game.settings['dev_'+k]:DEFAULTS[k]]));}\nfunction currentAssists(){return{autoFire:\"'!!game.settings.autoFire||touchMode(),slow:!!game.settings.slowHostiles,emergency:!!game.settings.emergencyBrake||touchMode()};}\nconst previousSettingsChange=game.settings.onChange;\ngame.settings.onChange=(key,value)=>{\n if(previousSettingsChange)previousSettingsChange(key,value);\n if(key.startsWith('\"'dev_')&&world){if(hosted||transport){return;}markModified();if(key==='dev_invulnerable'&&value)for(const p of world.players)p.inv=10000;else if(key==='dev_invulnerable')for(const p of world.players)p.inv=0;else world.tuning=effectiveTuning();}\n if(['autoFire','slowHostiles','emergencyBrake','assistance'].includes(key)&&world&&\"'!transport){world.assists=currentAssists();if(Object.values(world.assists).some(Boolean))world.assisted=true;}\n};\nfunction seedValue(){const a=new Uint32Array(1);crypto.getRandomValues(a);return a[0];}\nfunction consume(){game.input.clear();pointerTarget=null;pointerAnchor=game.input.pointer()?.slice()||null;}\nfunction activity(event){\n const type=event?.type||'\"'gamepad';\n if(type==='pointermove'&&event.pointerType==='mouse'&&Math.hypot(event.movementX||0,event.movementY||0)<2)return;\n lastHuman=game.real;arcade.wake();sound.unlock();\n if(demo){demo=false;world=null;consume();title();event?.preventDefault?.();event?.stopImmediatePropagation?.();return true;}\n return false;\n}\nfor(const type of ['keydown','pointerdown','pointermove','touchstart'])addEventListener(type,e=>activity(e),{capture:true,passive:false,signal:game._abort.signal});\n// Shell keeps native stack/focus navigation. Hover gets the same visible focus as a pad.\nui.root.addEventListener('pointerover',e=>{const b=e.target.closest('button,input');if(b&&\"'!b.disabled){b.focus({preventScroll:true});}});\nui.root.addEventListener('\"'click',()=>{lastHuman=game.real;sound.unlock();if(sound.enabled)game.audio.sfx('confirm',{vol:.4});});\nui.root.addEventListener('focusin',e=>{if(e.target.matches('button,input')&&sound.enabled)game.audio.sfx('select',{vol:.25});});\naddEventListener('blur',()=>{consume();sound.pause();if(transport&&world&&\"'!terminated){sendIdle();ui.toast('\"'Local input paused','The shared timeline continues.');}},{signal:game._abort.signal});\naddEventListener('gamepaddisconnected',()=>{consume();if(transport)sendIdle();},{signal:game._abort.signal});\naddEventListener('contextmenu',e=>{if(e.target.id==='screen')e.preventDefault();},{signal:game._abort.signal});\ntouchBrake.addEventListener('pointerdown',e=>{e.preventDefault();e.stopPropagation();brakeEdge++;lastHuman=game.real;sound.unlock();});\nfunction setPrompt(){\n const I=game.input,device=I.lastDevice;\n // Native polling ignores drift; meaningful controls alone change the prompt.\n if(device\"'!==lastDevice){lastDevice=device;deviceStamp=game.real;}\n const s=I.lastDevice==='\"'gamepad'?I.label('fire')+' FIRE   '+I.label('bomb')+' BRAKE   OPTIONS MENU':I.lastDevice==='touch'?'DRAG TO SLIDE · AUTO FIRE · TAP BRAKE WHEN READY':'A D / ← → MOVE   SPACE FIRE   SHIFT BRAKE   ESC MENU';\n if(s\"'!==lastPrompt){devicePrompt.textContent=s;lastPrompt=s;}\n devicePrompt.hidden=!!ui.screen||demo||terminated||!world||touchMode();\n touchNote.hidden=!touchMode()||!!ui.screen||demo||terminated||!world;\n touchNote.textContent='\"'DRAG TO SLIDE · AUTO FIRE · EMERGENCY BRAKE ASSIST';\n touchBrake.hidden=\"'!touchMode()||!!ui.screen||demo||terminated||!world||world.brake<100||!!world.outcome;\n document.body.dataset.screen=ui.screen||world?.phase||'\"'boot';\n}\nfunction title(){\n if(hosted)return;terminated=false;demo=false;world=null;displayState=null;automation=null;devSpeed=1;game.live=false;game.o.autoPause=true;game.resume();consume();art.reset();sound.reset();sound.music('title');ui.hide();game.go('title');showTitle();lastHuman=game.real;arcade.wake();\n}\nfunction showTitle(){\n ui.show('title',{name:TITLE,kicker:'A TEMPORAL ARCADE DEFENSE',subtitle:'Steal back your seconds.',text:'A tyrant. Four wicked weapons. One century worth saving.',\n  actions:[['Play campaign',playSetup],['Online co-op',onlineMenu],['How to play',showHelp],['Settings',()=>ui.show('settings')],['About / Credits',()=>showCredits(0)]],\n  meta:['1–4 PILOTS','8 WAVES + FINALE','CODE. PIXELS. CHAOS.'],footer:'INSPIRED BY ATTACK OF THE TIMELORD\"'! (1982) · DEMO AFTER 10 IDLE SECONDS'\"',back:()=>{}});\n}\nfunction playSetup(){returnScreen='title';ui.show('setup',{kicker:'YOUR CENTURY NEEDS YOU',title:'Choose your timeline',text:'Slide along the defense rail. Shoot the fleet and its weapons. Eight waves lead to the Bandit Boss.',actions:[{label:'Standard campaign',primary:true,fn:()=>startSolo(false)},['Gentle timeline',()=>startSolo(true)],['Back',()=>ui.back()]],sections:[['STANDARD','Three integrity pips. One shot at a time. Earn the shared time brake by intercepting weapons.'],['GENTLE TIMELINE','Automatic fire, slower hostile weapons and automatic emergency brake. Records are marked assisted.']]});}\nfunction startSolo(gentle=false){\n if(hosted)return;transport?.close();transport=null;game.live=false;game.o.autoPause=true;\n if(gentle){game.settings.set('assistance',true);}\n startRun(seedValue(),[{id:0,name:'PILOT 1'}],false);\n}\nfunction startRun(seed,seats,isNetwork){\n terminated=false;demo=false;scoreSaved=false;seq=0;brakeEdge=0;netInput=0;netWorld=0;latestPacket=null;previousPacket=null;devAccumulator=0;automation=null;consume();game.resume();ui.hide();art.reset();sound.reset();\n world=createWorld({seed,seats,tuning:isNetwork?DEFAULTS:effectiveTuning(),assists:isNetwork?{}:currentAssists()});world.assisted=Object.values(world.assists).some(Boolean);game.live=isNetwork;game.o.autoPause=\"'!isNetwork;game.go('\"'play');\n sound.music('combat');\n}\nfunction inputAction(){\n const I=game.input,m=I.move()[0];const pointer=I.pointer();\n if(Math.abs(m)>.08){pointerTarget=null;pointerAnchor=pointer?.slice()||null;}\n else if(I.lastDevice==='touch'){\n  const drag=I.drag();const p=world?.players.find(p=>p.id===(transport?.me??0));if(drag&&p){pointerTarget=bound((pointerTarget??p.x)+drag[0]*1.4,ARENA.left,ARENA.right);}\n }else if(pointer&&I.lastDevice\"'!=='\"'gamepad'){\n  const moved=pointerAnchor?Math.hypot(pointer[0]-pointerAnchor[0],pointer[1]-pointerAnchor[1]):0;\n  if(moved>7||I.down('fire')&&I.lastDevice==='mouse'){pointerTarget=bound(pointer[0],ARENA.left,ARENA.right);pointerAnchor=pointer.slice();}\n }\n if(I.pressed('bomb'))brakeEdge++;\n const blocked=\"'!!ui.screen||game.paused||terminated;\n return{k:'\"'a',n:++seq,m:blocked?0:m,x:blocked?null:pointerTarget,f:\"'!blocked&&(I.down('\"'fire')||touchMode()),b:brakeEdge};\n}\nfunction sendIdle(){if(\"'!transport||transport.me===null)return;const action={k:'\"'a',n:++seq,m:0,x:null,f:false,b:brakeEdge};if(transport.isHost&&world)acceptAction(world,transport.me,action);else transport.sendAction(action);}\nfunction updatePlay(dt){\n game.focus(320,180,0);\n if(terminated||\"'!world){setPrompt();return;}\n if(hosted&&AIHub.time()<0){setPrompt();return;}\n const authority=!transport||transport.isHost;\n if(authority){\n  const action=automation?automation(world,world.players.find(p=>p.id===(transport?.me??0))):inputAction();\n  if(transport?.me!==null){if(automation){if(action.brake)brakeEdge++;acceptAction(world,transport?.me??0,{k:'\"'a',n:++seq,m:action.move,x:action.target,f:action.fire,b:brakeEdge});}else acceptAction(world,transport?.me??0,action);}\n  const ai=\"'!transport&&game.settings.dev_ai;\n  if(ai){for(const p of world.players){const a=botAction(world,p);if(a.brake)brakeEdge++;acceptAction(world,p.id,{k:'\"'a',n:++seq,m:a.move,x:a.target,f:a.fire,b:brakeEdge});}}\n  if(\"'!transport&&game.settings.dev_invulnerable)for(const p of world.players)p.inv=9999;\n  devAccumulator+=dt*(transport?1:devSpeed);while(devAccumulator>=FIXED_DT){stepWorld(world,FIXED_DT);devAccumulator-=FIXED_DT;}\n  if(transport){netWorld+=dt;if(netWorld>=.1){netWorld%=.1;transport.sendWorld(worldPacket(world));}}\n }else{\n  netInput+=dt;if(netInput>=1/12){netInput%=1/12;transport.sendAction(inputAction());}\n }\n const fresh=art.ingest(world);sound.events(fresh);\n if(world.phase==='\"'finale')sound.music('boss');else if(world.phase==='ending')sound.music('victory');else if(world.phase==='results')sound.music(world.outcome?.won?'victory':'failure');else sound.music(world.wave>=4?'escalation':'combat');\n if(world.outcome&&hosted&&transport.isHost)transport.finish(world);\n if(world.phase==='results'&&\"'!ui.screen&&!hosted)showResults();\n setPrompt();\n}\nfunction drawWorld(r){\n let state=world;\n if(transport&&!transport.isHost&&world&&previousPacket){\n  const alpha=bound((performance.now()-packetAt)/100,0,1);state={...world};\n  for(const key of ['\"'players','enemies','threats','shots'])state[key]=world[key].map(p=>{const prev=previousPacket[key].find(o=>o.id===p.id);return prev?{...p,x:prev.x+(p.x-prev.x)*alpha,y:prev.y+(p.y-prev.y)*alpha}:p;});\n  // Local prediction is presentation only; host integrity, hits, score and phases stay authoritative.\n  const local=state.players.find(p=>p.id===transport.me);if(local&&\"'!ui.screen&&!terminated){const m=game.input.move()[0];local.x=bound(local.x+m*DEFAULTS.playerSpeed*Math.min(.1,(performance.now()-packetAt)/1000),ARENA.left,ARENA.right);}\n }\n displayState=state;art.draw(r,state,{hitboxes:!hosted&&game.settings.dev_hitboxes,trajectories:!hosted&&game.settings.dev_trajectories,brakeLabel:game.input.label('\"'bomb'),network:transport?(hosted?'HUB · ':'ROOM · ')+world?.players.filter(p=>p.connected).length+' PILOTS':''});\n}\nfunction updateTitle(dt){game.focus(320,180);if(hosted||transport||ui.screen\"'!=='\"'title')return;if(game.real-lastHuman>=10){startAttract();}}\nfunction startAttract(){\n if(hosted||transport||demo)return;demo=true;demoClock=0;demoStage=-1;ui.hide();consume();art.reset();world=createWorld({seed:0xa771ac7,seats:[{id:0,name:'DEMO'},{id:1,name:'DEMO'}],demo:true});game.go('attract');\n}\nfunction updateAttract(dt){\n if(\"'!demo)return;game.focus(320,180);demoClock+=dt;\n const stage=Math.floor(demoClock/15)%6;\n if(stage!==demoStage){demoStage=stage;const wave=[0,1,2,3,7,8][stage];if(wave===8)startEncounter(world,8,2);else startEncounter(world,wave);world.brake=100;world.phaseTime=4;}\n for(const p of world.players){p.hp=3;p.inv=999;const a=botAction(world,p);if(a.brake||demoClock%10<dt)brakeEdge++;acceptAction(world,p.id,{k:'\"'a',n:++seq,m:a.move,x:a.target,f:true,b:brakeEdge});}\n stepWorld(world,dt);if(world.outcome){world.outcome=null;startEncounter(world,7);}\n art.ingest(world);setPrompt();\n}\nfunction showHelp(){ui.show('help',{kicker:'DEFEND THE DEFENSE RAIL',title:'Steal back your seconds',text:'Clear every fleet. Survive the Boss. Aim straight up: choose what to intercept, then move.',keys:[[game.input.lastDevice==='gamepad'?'STICK / D-PAD':'A D / ← →','Slide along the rail'],[game.input.label('fire'),'Hold to fire one fast shot at a time'],[game.input.label('bomb'),'Time brake: spend a full shared meter'],['OPTIONS / ESC','Pause, settings, and developer tools']],sections:[['FOUR WAYS TO GET IN TROUBLE','White darts fall. Red orbs steer toward you. Green crosses land and sweep their marked segment; shoot them in the air or escape the sweep. Diamonds mark a predicted destination, then commit.'],['MAKE TIME','Intercept weapons for charge. Time brake slows hostile movement and attacks for 1.6 seconds. Your machine and shots keep full speed.'],['THREE CHANCES','A hit costs one integrity pip, clears nearby danger and gives a visible recovery shield. Clear a wave to recover a pip. In co-op, disabled machines reboot on a clear.'],['CO-OP / TOUCH','One to four pilots share a score and brake. Teammates can overlap safely. Touch: drag horizontally, automatic fire and emergency brake are enabled.']]});}\nfunction onlineMenu(){if(hosted)return;ui.show('online',{kicker:'ONE TIMELINE. UP TO FOUR PILOTS.',title:'Online co-op',text:'Create a room, or join using its eight-character code. The host runs the campaign. Public signaling finds the room; browsers share the world over WebRTC.',actions:[['Create room',()=>connectRoom(true)],['Join room',()=>showJoin()],['Back',()=>ui.back()]],sections:[['CONNECTIONS','Some firewalls and NATs block direct links. A failed connection always has a route back to solo. No account or server credentials needed.']]});}\nfunction showJoin(){\n ui.show('join',{kicker:'EIGHT-CHARACTER ROOM CODE',title:'Join a timeline',text:'Type or paste a code, or use the character wheel below.',actions:[['Connect',()=>connectRoom(false,joinCode)],['Edit with controller',()=>characterPicker('Room code',joinCode,8,'ABCDEFGHJKLMNPQRSTUVWXYZ23456789',value=>{joinCode=value;showJoin();})],['Back',()=>ui.back()]]});\n const box=ui.root.querySelector('.esh-mod'),input=document.createElement('input');input.type='text';input.className='room-code';input.maxLength=8;input.autocomplete='off';input.spellcheck=false;input.value=joinCode;input.placeholder='ABCD2345';input.setAttribute('aria-label','Room code');input.addEventListener('input',()=>{joinCode=input.value.toUpperCase().replace(/[\"'^A-Z2-9]/g,'\"'').slice(0,8);input.value=joinCode;lastHuman=game.real;});input.addEventListener('keydown',e=>{e.stopPropagation();if(e.key==='Enter')connectRoom(false,joinCode);if(e.key==='Escape')ui.back();});box.querySelector('p').after(input);\n}\nfunction characterPicker(label,initial,length,alphabet,done){\n const letters=Array.from({length},(_,i)=>Math.max(0,alphabet.indexOf(initial[i]||alphabet[0])));\n const redraw=()=>{ui.show('picker',{kicker:'UP / DOWN SELECT · LEFT / RIGHT CHANGE',title:label,text:letters.map(n=>alphabet[n]).join(' '),actions:letters.map((n,i)=>({label:'Character '+(i+1)+'  ‹ '+alphabet[n]+' ›',fn:()=>{letters[i]=(letters[i]+1)%alphabet.length;redraw();}})).concat([['Keep '+letters.map(n=>alphabet[n]).join(''),()=>{const v=letters.map(n=>alphabet[n]).join('');ui.back();done(v);} ],['Back',()=>ui.back()]])});\n const buttons=[...ui.root.querySelectorAll('.esh-btns button')];buttons.slice(0,length).forEach((b,i)=>{b._cycle=d=>{letters[i]=(letters[i]+d+alphabet.length)%alphabet.length;redraw();};});};redraw();\n}\nfunction makeHooks(){return{\n action:(id,a)=>{if(world&&transport?.isHost&&\"'!terminated)acceptAction(world,id,a);},\n world:p=>{if(terminated||transport?.isHost)return;const next=applyWorldPacket(world,p,transport.roster);if(next){previousPacket=world;world=next;latestPacket=p;packetAt=performance.now();}},\n leave:id=>{if(world&&transport?.isHost)leaveWorld(world,id);},\n timeUp:()=>{if(world&&!world.outcome)finishWorld(world,false,'\"'time-limit');transport?.finish(world);},\n end:reason=>{terminated=true;consume();sound.end();if(hosted){world&&(world.phase='terminated');game.stop();}else{ui.hide();ui.show('disconnected',{title:'Timeline disconnected',text:reason,actions:[['Return to solo',()=>{leaveRoom();}],['Online menu',()=>{leaveRoom();onlineMenu();}]]});}},\n status:text=>{onlineStatus=text;if(ui.screen==='room')roomScreen();},\n roster:()=>{if(ui.screen==='room')roomScreen();},\n begin:seed=>{startRun(seed,transport.roster,true);},\n lobby:()=>{world=null;game.live=false;game.resume();ui.hide();roomScreen();}\n};}\nasync function connectRoom(create,code){\n if(hosted)return;transport?.close();transport=new RoomTransport(makeHooks());onlineStatus=create?'Opening signaling connection…':'Connecting to the room…';roomScreen();\n try{if(create)await transport.create();else await transport.join(code);roomScreen();}catch(error){if(transport?.closed)return;onlineStatus=error.message;roomScreen();}\n}\nfunction roomScreen(){\n if(hosted||\"'!transport)return;const room=transport;\n ui.show('\"'room',{kicker:room.isHost?'HOSTED TIMELINE':'SHARED TIMELINE',title:room.code?room.code.match(/.{1,4}/g).join(' '):'Connecting',text:onlineStatus,sections:[['PILOTS',room.roster.length?room.roster.map(p=>'P'+(p.id+1)+' · '+p.name+' · '+(p.ready?'READY':'WAITING')).join('\\\\n'):'Waiting for the signaling service…']],actions:[\n  ...(room.isHost?[{label:'Start campaign',primary:true,disabled:\"'!room.peer?.open||!room.roster.every(p=>p.ready),fn:()=>room.start(seedValue())},['\"'Copy room code',()=>copyCode(room.code)]]:[{label:'Ready / Not ready',disabled:room.me===null,fn:()=>room.ready()}]),\n  ['Retry connection',()=>connectRoom(room.isHost,room.code)],['Leave room / Solo',leaveRoom]\n ],back:leaveRoom});\n}\nasync function copyCode(code){try{await navigator.clipboard.writeText(code);onlineStatus='CODE COPIED · '+code;}catch{onlineStatus='COPY UNAVAILABLE · Select the code below, or read it aloud: '+code;}roomScreen();const box=ui.root.querySelector('.esh-mod'),field=document.createElement('input');field.className='room-code';field.readOnly=true;field.value=code;field.setAttribute('aria-label','Shareable room code');box.querySelector('p').after(field);field.focus();field.select();}\nfunction leaveRoom(){if(hosted)return;transport?.close();transport=null;terminated=false;world=null;title();}\nfunction showResults(){\n const w=world;if(\"'!w)return;consume();\n ui.show('\"'results',{kicker:w.outcome?.won?'THE RIFT IS SEALED':'A CENTURY WORTH ANOTHER TRY',title:w.outcome?.won?'Time well stolen.':'Out of seconds.',text:w.outcome?.won?'The Boss sends a strongly worded letter to yesterday. Your century declines to reply.':'Your last machine has gone quiet. The Boss is insufferable. You can fix that.',\n stats:[[String(w.score).padStart(6,'0'),'TEAM SCORE'],[w.stats.intercepts,'INTERCEPTIONS'],[w.stats.ships,'HULLS BROKEN'],[w.stats.brakes,'TIME BRAKES']],\n sections:[['FLIGHT RECORD',Math.floor(w.time/60)+':'+String(Math.floor(w.time%60)).padStart(2,'0')+' · '+w.stats.hits+' hits · '+w.stats.bonus+' wave bonus · '+(w.modified?'DEV / MODIFIED — no record':w.assisted||Object.values(w.assists||{}).some(Boolean)?'ASSISTED RECORD':w.players.length>1?'CO-OP RECORD':'STANDARD SOLO RECORD')]],\n actions:transport?[...(transport.isHost?[['Return to room / Replay',()=>transport.lobby()]]:[]),['Leave room',leaveRoom]]:[['Retry campaign',()=>{startRun(seedValue(),[{id:0,name:'PILOT 1'}],false);}],['Save six-letter record',saveRecord],['High scores',showScores],['Reset tuning & retry',()=>{resetTuning();startSolo(false);}],['Title',title]]});\n}\nfunction recordMode(){return world.modified?'modified':world.assisted||Object.values(world.assists||{}).some(Boolean)?'assisted':world.players.length>1?'coop':'solo';}\nfunction getRecords(){const value=E.store.get('tbb:records:v1',[]);return Array.isArray(value)?value.filter(r=>r&&typeof r.name==='string'&&r.name.length===6&&Number.isFinite(r.score)).slice(0,30):[];}\nfunction saveRecord(){if(\"'!world||world.modified||world.demo||scoreSaved||transport||hosted){ui.toast('\"'Record unavailable',scoreSaved?'This record is already saved.':'Developer and demonstration runs do not enter the table.');return;}\n characterPicker('Your six-letter callsign','PILOTX',6,'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789',name=>{const rows=getRecords();rows.push({name,score:world.score,mode:recordMode()});rows.sort((a,b)=>b.score-a.score);E.store.set('tbb:records:v1',rows.slice(0,30));scoreSaved=true;ui.toast('Record saved',name+' · '+world.score);showScores();});\n}\nfunction showScores(){const rows=getRecords();ui.show('records',{kicker:'LOCAL FLIGHT RECORDS',title:'Seconds to remember',text:rows.length?rows.slice(0,12).map((r,i)=>String(i+1).padStart(2,'0')+'  '+r.name+'  '+String(r.score).padStart(6,'0')+'  '+r.mode.toUpperCase()).join('\\\\n'):'No records yet. Your century is waiting.',actions:[['Back',()=>ui.back()]]});}\nfunction resetTuning(){game.settings.reset('Dev tuning');game.settings.reset('Dev tools');devSpeed=1;if(world)world.tuning=effectiveTuning();}\nfunction openDev(){\n if(transport||hosted){ui.show('inspect',{kicker:'SHARED WORLD',title:'Session inspection',text:()=>JSON.stringify({seed:world?.seed,tick:world?.tick,phase:world?.phase,score:world?.score}),actions:[['Back',()=>ui.back()]]});return;}\n markModified();ui.show('dev',{kicker:'RUN MARKED MODIFIED · SESSION ONLY',title:'Dev Mode',text:()=>\"'`Seed ${world?.seed} · tick ${world?.tick} · ${world?.phase} · ${world?.enemies.length||0} hulls · ${world?.threats.length||0} threats`,rows:['\"'dev_invulnerable','dev_hitboxes','dev_trajectories','dev_ai'],actions:[['Jump to encounter',devJumpMenu],['Restart encounter',()=>{if(world)startEncounter(world,world.wave,world.wave===8?world.bossPhase:null);ui.back();}],['Step one tick',()=>{if(world)stepWorld(world,FIXED_DT);art.ingest(world);openDev();}],['Simulation speed: '+devSpeed+'×',()=>{devSpeed=devSpeed===1?.5:devSpeed===.5?2:1;openDev();}],['Refill integrity & brake',()=>{for(const p of world.players){p.hp=3;p.inv=2;}world.brake=100;ui.toast('Restored','Three pips. Full charge.');}],['Spawn a threat',devSpawnMenu],['Live tuning sliders',()=>ui.show('tuning',{title:'Balance the timeline',kicker:'LIVE VALUES · DEFAULTS SHOWN BELOW EACH SLIDER',rows:TUNING.map(([k])=>'dev_'+k),actions:[['Reset tuning to defaults',()=>{resetTuning();ui.show('tuning');}],['Back',()=>ui.back()]]})],['Reset all developer defaults',()=>{resetTuning();openDev();}],['Return to play',()=>{ui.hide();game.resume();consume();}]]});\n}\nfunction devJumpMenu(){ui.show('jump',{title:'Choose an encounter',actions:[...WAVES.map((w,i)=>[String(i+1).padStart(2,'0')+' · '+w.name,()=>{startEncounter(world,i);world.outcome=null;ui.hide();game.resume();}]),...BOSS_PHASES.map((b,i)=>['Boss '+(i+1)+' · '+b.name,()=>{world.outcome=null;startEncounter(world,8,i);ui.hide();game.resume();}]),['Back',()=>ui.back()]]});}\nfunction devSpawnMenu(){ui.show('spawn',{title:'Spawn a weapon',actions:Object.entries(WEAPONS).map(([k,v])=>[v.name,()=>{spawnThreat(world,k,{x:world.players[0].x,y:160});ui.hide();game.resume();}]).concat([['Back',()=>ui.back()]])});}\nfunction showCredits(page=0){creditsPage=page;\n const info=BUILD_INFO;\n const pages=[\n ['About / Credits', [['AN ORIGINAL TEMPORAL ARCADE','Design, procedural art, original music, sound and gibberish voice by OpenAI gpt-6.1-sol, built for Michael Crosato. Based on Attack of the Timelord\"'! (Odyssey², 1982). New campaign, time brake and simultaneous co-op are adaptation choices.'\"'],['CREDITS & LICENSES','my-3D2dge v0.89.1 · Michael Crosato · MIT. AI Hub session client 1.4.0, unmodified; repository license unknown. PeerJS 1.5.5 · PeerJS contributors · MIT. No audio files, borrowed game art, browser TTS or television franchise lore.'],['RESEARCH','North American manual, William Cassidy’s hands-on review, gameplay still and box illustration at odyssey2.info were inspected. No gameplay video was viewed. Original steering equations, timings and continuous musical score are unknown.']]],\n ['Source Information',Object.entries(info.sourceInformation).map(([k,v])=>[k.replace(/([A-Z])/g,' \"'$1'\"').toUpperCase(),v])],\n ['Testing Feedback',info.testingFeedback.map((v,i)=>[['ISSUES CAUGHT','CRITICAL ISSUES','MOST HELPFUL TEST','LEAST HELPFUL TEST'][i],v])],\n ['Engine Feedback',info.engineFeedback.map((v,i)=>[['LIKED MOST','STUCK / WRONG GUESSES','BUILT OURSELVES','HARDEST PART','ENGINE CHANGES','ONE SUGGESTION'][i],v])],\n ['Prompt Feedback',info.promptFeedback.map((v,i)=>[['LIKED MOST','CONFUSING','HARDEST TASK','SUGGESTED CHANGE'][i],v])],\n ['Source & dependency links',[['MANUAL','https://odyssey2.info/library/manuals/us_timelord/Attack%20of%20the%20Timelord%20(USA).pdf'],['REVIEW','https://odyssey2.info/reviews/attack-of-the-timelord-6'],['ENGINE','https://github.com/michaelcrosato/my-3d2dge'],['AI HUB','https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub'],['PEERJS','https://peerjs.com/client/getting-started'],['ONLINE LIMITS','Public signaling and direct WebRTC links depend on network availability. Some NAT configurations require TURN. Automated signal checks cannot establish subjective audio quality. Physical pads and iOS hardware are unavailable here.']]]\n ];\n const [heading,sections]=pages[page];ui.show('credits',{kicker:'ABOUT · '+(page+1)+' / '+pages.length,title:heading,sections,actions:[['Next page',()=>showCredits((page+1)%pages.length)],['Previous page',()=>showCredits((page+pages.length-1)%pages.length)],['Back',()=>ui.back()]]});\n}\n// Called before shell input suppression, including while paused.\ngame.hook('input',dt=>{\n const I=game.input;\n if(terminated){I.consumeAll();return;}\n if(I.anyPressed()||Math.hypot(...I.padMove)>.2){if(demo){activity();I.consumeAll();return;}lastHuman=game.real;arcade.wake();if(I.lastDevice==='gamepad')sound.unlock();}\n if(hosted&&I.held.has('Pad8'))I.suppress('pause');\n if(game.paused&&\"'!pausedBefore){pausedAt=game.real;sound.pause();consume();}pausedBefore=game.paused;\n if(ui.screen==='\"'dev'&&world){const t=ui.root.querySelector('p');if(t)t.textContent=\"'`Seed ${world.seed} · tick ${world.tick} · ${world.phase} · ${world.enemies.length} hulls · ${world.threats.length} threats`;}\n setPrompt();\n});\ngame.debug={snapshot:()=>({title:TITLE,scene:game.sceneName,screen:ui.screen,paused:game.paused,demo,hosted,server:transport?.server||false,terminated,seed:world?.seed,tick:world?.tick,phase:world?.phase,wave:world?.wave,bossPhase:world?.bossPhase,score:world?.score,players:world?.players.map(p=>({id:p.id,x:p.x,hp:p.hp,connected:p.connected})),enemies:world?.enemies.length,threats:world?.threats.map(t=>({kind:t.kind,state:t.state,x:t.x,y:t.y})),brake:world?.brake,seen:world?.seen,modified:world?.modified,music:game.settings.music,input:game.input.lastDevice,packets:transport?.meter.snapshot(),errors:game.errors})};\nglobalThis.game=game;\nglobalThis.TimeBandit={game,ui,art,sound,get world(){return world;},get transport(){return transport;},snapshot:game.debug.snapshot};\nif(TEST_MODE)Object.assign(globalThis.TimeBandit,{startSolo,startRun,title,startAttract,showResults,showHelp,showJoin,showCredits,openDev,resetTuning,roomScreen,connectRoom,leaveRoom,showScores,getRecords,saveRecord,codeTone:null,get demo(){return demo;},setAutomation:fn=>{automation=fn;},setWorld:w=>{world=w;},step:n=>{for(let i=0;i<n;i++)stepWorld(world,FIXED_DT);art.ingest(world);},advance:s=>game.advance(s),action:(a,id=0)=>acceptAction(world,id,a),packet:()=>worldPacket(world)});\nconst scenes={title:{enter(){showTitle();},update:updateTitle,draw:r=>art.draw(r,null)},play:{pausable:true,camera:false,update:updatePlay,draw:drawWorld},attract:{pausable:false,camera:false,update:updateAttract,draw:drawWorld}};\ngame.start({scene:'\"'title',scenes});\nasync function boot(){\n const info=await AIHub.connect({mode:'shared-world',seats:[1,4]});\n if(\"'!info){hosted=false;title();const invite=new URLSearchParams(location.search).get('\"'room');if(invite){joinCode=invite;onlineMenu();showJoin();}document.body.dataset.booted='true';return;}\n hosted=true;terminated=false;ui.hide();transport=new HubTransport(AIHub,info,makeHooks());game.o.autoPause=false;game.live=true;game.o.menu.items=()=>[['Session inspection',openDev]];ui._o.screens.pause.title='Local options';\n startRun(info.seed,info.players,true);document.body.dataset.booted='true';AIHub.ready();\n}\nboot().catch(error=>{game.fail('boot',error);if(AIHub.active)AIHub.fail(error.message);else title();});\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"cat > src/main.js <<'EOF'\nimport { TITLE, ARENA, DEFAULTS, TUNING, WAVES, BOSS_PHASES, WEAPONS } from './content/campaign.js';\nimport { FIXED_DT, bound, createWorld, stepWorld, acceptAction, botAction, worldPacket, applyWorldPacket, spawnThreat, startEncounter, finishWorld, leaveWorld } from './game/simulation.js';\nimport { Presentation } from './presentation/renderer.js';\nimport { Soundtrack } from './audio/sound.js';\nimport { HubTransport, RoomTransport } from './network/transports.js';\nconst E=globalThis.My3D2dge;\nconst TEST_MODE=new URLSearchParams(location.search).has('test');\nlet world=null,transport=null,hosted=false,terminated=false,seq=0,brakeEdge=0,netInput=0,netWorld=0,latestPacket=null,previousPacket=null,packetAt=0;\nlet lastHuman=0,demo=false,demoClock=0,demoStage=-1,scoreSaved=false,returnScreen='title',onlineStatus='',joinCode='',devSpeed=1,devAccumulator=0,automation=null;\nlet pointerTarget=null,pointerAnchor=null,lastDevice='keyboard',deviceStamp=0,pausedBefore=false,pausedAt=0,lastPrompt='',displayState=null;\nlet creditsPage=0;\nconst inputMap={...E.Input.SHMUP,fire:['Space','KeyZ','KeyJ','Mouse0','Pad0','Pad7'],bomb:['ShiftLeft','ShiftRight','Mouse2','Pad2','Pad6']};\nconst ownSettings=[{key:'music',value:.1},{key:'glyphs',value:'playstation'},\n {key:'voice',label:'Tyrant voice',group:'Sound',type:'slider',value:.8,apply:(g,v)=>{g.audio.voiceVolume=v;g.audio.applyVolume();}},\n {key:'assistance',label:'Gentle timeline',group:'Game',value:false,help:'Auto fire, slower weapons and emergency brake.',apply:(g,v)=>{if(\"'!g.settings)return;for(const k of ['\"'autoFire','slowHostiles','emergencyBrake'])if(g.settings.spec(k))g.settings.set(k,v);}},\n {key:'autoFire',label:'Automatic fire',group:'Game',value:false}, {key:'slowHostiles',label:'Slower hostile weapons',group:'Game',value:false}, {key:'emergencyBrake',label:'Emergency time brake',group:'Game',value:false},\n ...TUNING.map(([key,label,min,max,step,unit])=>({key:'dev_'+key,label,group:'Dev tuning',value:DEFAULTS[key],min,max,step,unit,persist:false,help:'Default '+DEFAULTS[key]+unit})),\n ...[['invulnerable','Invulnerability'],['hitboxes','Hitboxes'],['trajectories','Target & trajectory overlays'],['ai','AI control']].map(([key,label])=>({key:'dev_'+key,label,group:'Dev tools',value:false,persist:false}))\n];\nconst game=new E.Game({id:'time-bandit-boss-v1',canvas:'screen',res:[ARENA.w,ARENA.h],expand:false,view:'overhead',views:['overhead'],input:inputMap,fullscreen:'button',autoPause:true,camera:false,menu:{quit:false,controls:{fire:'Fire cannon',bomb:'Time brake'},settings:ownSettings,items:()=>hosted?[]:[['Dev Mode',openDev],['How to play',showHelp],['About / Credits',()=>showCredits(0)],['Leave run',()=>{if(transport)leaveRoom();else title();}]]}});\ngame.fadeTime=0;game.cam.smooth=0;game.lights.enabled=true;game.lights.ambient=.77;game.input.touchButtons([]);game.input.steer='drag';\nconst art=new Presentation(game),sound=new Soundtrack(game),arcade=new E.Arcade(game,{id:'time-bandit-boss',idle:10,demo:90,scores:6});\nconst ui=new E.Shell(game,{theme:{accent:'#f2cc87',ink:'#f5efdb',muted:'#a2b7c6',paper:'rgba(10,22,37,.96)',line:'#39516a',font:'system-ui, sans-serif',titleFont:'Impact, Haettenschweiler, \\\"Arial Narrow Bold\\\", sans-serif',scale:()=>Math.max(.82,Math.min(2,innerHeight/540,innerWidth/820))},screens:{pause:{title:()=>hosted?'Local options':game.pauseReason==='focus'?'Focus lost':game.pauseReason==='controller'?'Controller disconnected':'Timeline paused',text:()=>hosted?'The shared timeline continues. Your machine is waiting for input.':game.pauseReason==='focus'?'Your machine is safe. Resume when you are ready.':game.pauseReason==='controller'?'Reconnect a controller, or continue with keyboard and mouse.':'Take a second. The universe can wait.'},help:{}}});\nconst touchBrake=document.getElementById('touch-brake'),devicePrompt=document.getElementById('device-prompt'),touchNote=document.getElementById('touch-note');\nfunction touchMode(){return game.input.lastDevice==='touch'||matchMedia('(pointer:coarse)').matches;}\nfunction markModified(){if(world)world.modified=true;}\nfunction effectiveTuning(){return Object.fromEntries(Object.keys(DEFAULTS).map(k=>[k,game.settings.spec('dev_'+k)?game.settings['dev_'+k]:DEFAULTS[k]]));}\nfunction currentAssists(){return{autoFire:\"'!!game.settings.autoFire||touchMode(),slow:!!game.settings.slowHostiles,emergency:!!game.settings.emergencyBrake||touchMode()};}\nconst previousSettingsChange=game.settings.onChange;\ngame.settings.onChange=(key,value)=>{\n if(previousSettingsChange)previousSettingsChange(key,value);\n if(key.startsWith('\"'dev_')&&world){if(hosted||transport){return;}markModified();if(key==='dev_invulnerable'&&value)for(const p of world.players)p.inv=10000;else if(key==='dev_invulnerable')for(const p of world.players)p.inv=0;else world.tuning=effectiveTuning();}\n if(['autoFire','slowHostiles','emergencyBrake','assistance'].includes(key)&&world&&\"'!transport){world.assists=currentAssists();if(Object.values(world.assists).some(Boolean))world.assisted=true;}\n};\nfunction seedValue(){const a=new Uint32Array(1);crypto.getRandomValues(a);return a[0];}\nfunction consume(){game.input.clear();pointerTarget=null;pointerAnchor=game.input.pointer()?.slice()||null;}\nfunction activity(event){\n const type=event?.type||'\"'gamepad';\n if(type==='pointermove'&&event.pointerType==='mouse'&&Math.hypot(event.movementX||0,event.movementY||0)<2)return;\n lastHuman=game.real;arcade.wake();sound.unlock();\n if(demo){demo=false;world=null;consume();title();event?.preventDefault?.();event?.stopImmediatePropagation?.();return true;}\n return false;\n}\nfor(const type of ['keydown','pointerdown','pointermove','touchstart'])addEventListener(type,e=>activity(e),{capture:true,passive:false,signal:game._abort.signal});\n// Shell keeps native stack/focus navigation. Hover gets the same visible focus as a pad.\nui.root.addEventListener('pointerover',e=>{const b=e.target.closest('button,input');if(b&&\"'!b.disabled){b.focus({preventScroll:true});}});\nui.root.addEventListener('\"'click',()=>{lastHuman=game.real;sound.unlock();if(sound.enabled)game.audio.sfx('confirm',{vol:.4});});\nui.root.addEventListener('focusin',e=>{if(e.target.matches('button,input')&&sound.enabled)game.audio.sfx('select',{vol:.25});});\naddEventListener('blur',()=>{consume();sound.pause();if(transport&&world&&\"'!terminated){sendIdle();ui.toast('\"'Local input paused','The shared timeline continues.');}},{signal:game._abort.signal});\naddEventListener('gamepaddisconnected',()=>{consume();if(transport)sendIdle();},{signal:game._abort.signal});\naddEventListener('contextmenu',e=>{if(e.target.id==='screen')e.preventDefault();},{signal:game._abort.signal});\ntouchBrake.addEventListener('pointerdown',e=>{e.preventDefault();e.stopPropagation();brakeEdge++;lastHuman=game.real;sound.unlock();});\nfunction setPrompt(){\n const I=game.input,device=I.lastDevice;\n // Native polling ignores drift; meaningful controls alone change the prompt.\n if(device\"'!==lastDevice){lastDevice=device;deviceStamp=game.real;}\n const s=I.lastDevice==='\"'gamepad'?I.label('fire')+' FIRE   '+I.label('bomb')+' BRAKE   OPTIONS MENU':I.lastDevice==='touch'?'DRAG TO SLIDE · AUTO FIRE · TAP BRAKE WHEN READY':'A D / ← → MOVE   SPACE FIRE   SHIFT BRAKE   ESC MENU';\n if(s\"'!==lastPrompt){devicePrompt.textContent=s;lastPrompt=s;}\n devicePrompt.hidden=!!ui.screen||demo||terminated||!world||touchMode();\n touchNote.hidden=!touchMode()||!!ui.screen||demo||terminated||!world;\n touchNote.textContent='\"'DRAG TO SLIDE · AUTO FIRE · EMERGENCY BRAKE ASSIST';\n touchBrake.hidden=\"'!touchMode()||!!ui.screen||demo||terminated||!world||world.brake<100||!!world.outcome;\n document.body.dataset.screen=ui.screen||world?.phase||'\"'boot';\n}\nfunction title(){\n if(hosted)return;terminated=false;demo=false;world=null;displayState=null;automation=null;devSpeed=1;game.live=false;game.o.autoPause=true;game.resume();consume();art.reset();sound.reset();sound.music('title');ui.hide();game.go('title');showTitle();lastHuman=game.real;arcade.wake();\n}\nfunction showTitle(){\n ui.show('title',{name:TITLE,kicker:'A TEMPORAL ARCADE DEFENSE',subtitle:'Steal back your seconds.',text:'A tyrant. Four wicked weapons. One century worth saving.',\n  actions:[['Play campaign',playSetup],['Online co-op',onlineMenu],['How to play',showHelp],['Settings',()=>ui.show('settings')],['About / Credits',()=>showCredits(0)]],\n  meta:['1–4 PILOTS','8 WAVES + FINALE','CODE. PIXELS. CHAOS.'],footer:'INSPIRED BY ATTACK OF THE TIMELORD\"'! (1982) · DEMO AFTER 10 IDLE SECONDS'\"',back:()=>{}});\n}\nfunction playSetup(){returnScreen='title';ui.show('setup',{kicker:'YOUR CENTURY NEEDS YOU',title:'Choose your timeline',text:'Slide along the defense rail. Shoot the fleet and its weapons. Eight waves lead to the Bandit Boss.',actions:[{label:'Standard campaign',primary:true,fn:()=>startSolo(false)},['Gentle timeline',()=>startSolo(true)],['Back',()=>ui.back()]],sections:[['STANDARD','Three integrity pips. One shot at a time. Earn the shared time brake by intercepting weapons.'],['GENTLE TIMELINE','Automatic fire, slower hostile weapons and automatic emergency brake. Records are marked assisted.']]});}\nfunction startSolo(gentle=false){\n if(hosted)return;transport?.close();transport=null;game.live=false;game.o.autoPause=true;\n if(gentle){game.settings.set('assistance',true);}\n startRun(seedValue(),[{id:0,name:'PILOT 1'}],false);\n}\nfunction startRun(seed,seats,isNetwork){\n terminated=false;demo=false;scoreSaved=false;seq=0;brakeEdge=0;netInput=0;netWorld=0;latestPacket=null;previousPacket=null;devAccumulator=0;automation=null;consume();game.resume();ui.hide();art.reset();sound.reset();\n world=createWorld({seed,seats,tuning:isNetwork?DEFAULTS:effectiveTuning(),assists:isNetwork?{}:currentAssists()});world.assisted=Object.values(world.assists).some(Boolean);game.live=isNetwork;game.o.autoPause=\"'!isNetwork;game.go('\"'play');\n sound.music('combat');\n}\nfunction inputAction(){\n const I=game.input,m=I.move()[0];const pointer=I.pointer();\n if(Math.abs(m)>.08){pointerTarget=null;pointerAnchor=pointer?.slice()||null;}\n else if(I.lastDevice==='touch'){\n  const drag=I.drag();const p=world?.players.find(p=>p.id===(transport?.me??0));if(drag&&p){pointerTarget=bound((pointerTarget??p.x)+drag[0]*1.4,ARENA.left,ARENA.right);}\n }else if(pointer&&I.lastDevice\"'!=='\"'gamepad'){\n  const moved=pointerAnchor?Math.hypot(pointer[0]-pointerAnchor[0],pointer[1]-pointerAnchor[1]):0;\n  if(moved>7||I.down('fire')&&I.lastDevice==='mouse'){pointerTarget=bound(pointer[0],ARENA.left,ARENA.right);pointerAnchor=pointer.slice();}\n }\n if(I.pressed('bomb'))brakeEdge++;\n const blocked=\"'!!ui.screen||game.paused||terminated;\n return{k:'\"'a',n:++seq,m:blocked?0:m,x:blocked?null:pointerTarget,f:\"'!blocked&&(I.down('\"'fire')||touchMode()),b:brakeEdge};\n}\nfunction sendIdle(){if(\"'!transport||transport.me===null)return;const action={k:'\"'a',n:++seq,m:0,x:null,f:false,b:brakeEdge};if(transport.isHost&&world)acceptAction(world,transport.me,action);else transport.sendAction(action);}\nfunction updatePlay(dt){\n game.focus(320,180,0);\n if(terminated||\"'!world){setPrompt();return;}\n if(hosted&&AIHub.time()<0){setPrompt();return;}\n const authority=!transport||transport.isHost;\n if(authority){\n  const action=automation?automation(world,world.players.find(p=>p.id===(transport?.me??0))):inputAction();\n  if(transport?.me!==null){if(automation){if(action.brake)brakeEdge++;acceptAction(world,transport?.me??0,{k:'\"'a',n:++seq,m:action.move,x:action.target,f:action.fire,b:brakeEdge});}else acceptAction(world,transport?.me??0,action);}\n  const ai=\"'!transport&&game.settings.dev_ai;\n  if(ai){for(const p of world.players){const a=botAction(world,p);if(a.brake)brakeEdge++;acceptAction(world,p.id,{k:'\"'a',n:++seq,m:a.move,x:a.target,f:a.fire,b:brakeEdge});}}\n  if(\"'!transport&&game.settings.dev_invulnerable)for(const p of world.players)p.inv=9999;\n  devAccumulator+=dt*(transport?1:devSpeed);while(devAccumulator>=FIXED_DT){stepWorld(world,FIXED_DT);devAccumulator-=FIXED_DT;}\n  if(transport){netWorld+=dt;if(netWorld>=.1){netWorld%=.1;transport.sendWorld(worldPacket(world));}}\n }else{\n  netInput+=dt;if(netInput>=1/12){netInput%=1/12;transport.sendAction(inputAction());}\n }\n const fresh=art.ingest(world);sound.events(fresh);\n if(world.phase==='\"'finale')sound.music('boss');else if(world.phase==='ending')sound.music('victory');else if(world.phase==='results')sound.music(world.outcome?.won?'victory':'failure');else sound.music(world.wave>=4?'escalation':'combat');\n if(world.outcome&&hosted&&transport.isHost)transport.finish(world);\n if(world.phase==='results'&&\"'!ui.screen&&!hosted)showResults();\n setPrompt();\n}\nfunction drawWorld(r){\n let state=world;\n if(transport&&!transport.isHost&&world&&previousPacket){\n  const alpha=bound((performance.now()-packetAt)/100,0,1);state={...world};\n  for(const key of ['\"'players','enemies','threats','shots'])state[key]=world[key].map(p=>{const prev=previousPacket[key].find(o=>o.id===p.id);return prev?{...p,x:prev.x+(p.x-prev.x)*alpha,y:prev.y+(p.y-prev.y)*alpha}:p;});\n  // Local prediction is presentation only; host integrity, hits, score and phases stay authoritative.\n  const local=state.players.find(p=>p.id===transport.me);if(local&&\"'!ui.screen&&!terminated){const m=game.input.move()[0];local.x=bound(local.x+m*DEFAULTS.playerSpeed*Math.min(.1,(performance.now()-packetAt)/1000),ARENA.left,ARENA.right);}\n }\n displayState=state;art.draw(r,state,{hitboxes:!hosted&&game.settings.dev_hitboxes,trajectories:!hosted&&game.settings.dev_trajectories,brakeLabel:game.input.label('\"'bomb'),network:transport?(hosted?'HUB · ':'ROOM · ')+world?.players.filter(p=>p.connected).length+' PILOTS':''});\n}\nfunction updateTitle(dt){game.focus(320,180);if(hosted||transport||ui.screen\"'!=='\"'title')return;if(game.real-lastHuman>=10){startAttract();}}\nfunction startAttract(){\n if(hosted||transport||demo)return;demo=true;demoClock=0;demoStage=-1;ui.hide();consume();art.reset();world=createWorld({seed:0xa771ac7,seats:[{id:0,name:'DEMO'},{id:1,name:'DEMO'}],demo:true});game.go('attract');\n}\nfunction updateAttract(dt){\n if(\"'!demo)return;game.focus(320,180);demoClock+=dt;\n const stage=Math.floor(demoClock/15)%6;\n if(stage!==demoStage){demoStage=stage;const wave=[0,1,2,3,7,8][stage];if(wave===8)startEncounter(world,8,2);else startEncounter(world,wave);world.brake=100;world.phaseTime=4;}\n for(const p of world.players){p.hp=3;p.inv=999;const a=botAction(world,p);if(a.brake||demoClock%10<dt)brakeEdge++;acceptAction(world,p.id,{k:'\"'a',n:++seq,m:a.move,x:a.target,f:true,b:brakeEdge});}\n stepWorld(world,dt);if(world.outcome){world.outcome=null;startEncounter(world,7);}\n art.ingest(world);setPrompt();\n}\nfunction showHelp(){ui.show('help',{kicker:'DEFEND THE DEFENSE RAIL',title:'Steal back your seconds',text:'Clear every fleet. Survive the Boss. Aim straight up: choose what to intercept, then move.',keys:[[game.input.lastDevice==='gamepad'?'STICK / D-PAD':'A D / ← →','Slide along the rail'],[game.input.label('fire'),'Hold to fire one fast shot at a time'],[game.input.label('bomb'),'Time brake: spend a full shared meter'],['OPTIONS / ESC','Pause, settings, and developer tools']],sections:[['FOUR WAYS TO GET IN TROUBLE','White darts fall. Red orbs steer toward you. Green crosses land and sweep their marked segment; shoot them in the air or escape the sweep. Diamonds mark a predicted destination, then commit.'],['MAKE TIME','Intercept weapons for charge. Time brake slows hostile movement and attacks for 1.6 seconds. Your machine and shots keep full speed.'],['THREE CHANCES','A hit costs one integrity pip, clears nearby danger and gives a visible recovery shield. Clear a wave to recover a pip. In co-op, disabled machines reboot on a clear.'],['CO-OP / TOUCH','One to four pilots share a score and brake. Teammates can overlap safely. Touch: drag horizontally, automatic fire and emergency brake are enabled.']]});}\nfunction onlineMenu(){if(hosted)return;ui.show('online',{kicker:'ONE TIMELINE. UP TO FOUR PILOTS.',title:'Online co-op',text:'Create a room, or join using its eight-character code. The host runs the campaign. Public signaling finds the room; browsers share the world over WebRTC.',actions:[['Create room',()=>connectRoom(true)],['Join room',()=>showJoin()],['Back',()=>ui.back()]],sections:[['CONNECTIONS','Some firewalls and NATs block direct links. A failed connection always has a route back to solo. No account or server credentials needed.']]});}\nfunction showJoin(){\n ui.show('join',{kicker:'EIGHT-CHARACTER ROOM CODE',title:'Join a timeline',text:'Type or paste a code, or use the character wheel below.',actions:[['Connect',()=>connectRoom(false,joinCode)],['Edit with controller',()=>characterPicker('Room code',joinCode,8,'ABCDEFGHJKLMNPQRSTUVWXYZ23456789',value=>{joinCode=value;showJoin();})],['Back',()=>ui.back()]]});\n const box=ui.root.querySelector('.esh-mod'),input=document.createElement('input');input.type='text';input.className='room-code';input.maxLength=8;input.autocomplete='off';input.spellcheck=false;input.value=joinCode;input.placeholder='ABCD2345';input.setAttribute('aria-label','Room code');input.addEventListener('input',()=>{joinCode=input.value.toUpperCase().replace(/[\"'^A-Z2-9]/g,'\"'').slice(0,8);input.value=joinCode;lastHuman=game.real;});input.addEventListener('keydown',e=>{e.stopPropagation();if(e.key==='Enter')connectRoom(false,joinCode);if(e.key==='Escape')ui.back();});box.querySelector('p').after(input);\n}\nfunction characterPicker(label,initial,length,alphabet,done){\n const letters=Array.from({length},(_,i)=>Math.max(0,alphabet.indexOf(initial[i]||alphabet[0])));\n const redraw=()=>{ui.show('picker',{kicker:'UP / DOWN SELECT · LEFT / RIGHT CHANGE',title:label,text:letters.map(n=>alphabet[n]).join(' '),actions:letters.map((n,i)=>({label:'Character '+(i+1)+'  ‹ '+alphabet[n]+' ›',fn:()=>{letters[i]=(letters[i]+1)%alphabet.length;redraw();}})).concat([['Keep '+letters.map(n=>alphabet[n]).join(''),()=>{const v=letters.map(n=>alphabet[n]).join('');ui.back();done(v);} ],['Back',()=>ui.back()]])});\n const buttons=[...ui.root.querySelectorAll('.esh-btns button')];buttons.slice(0,length).forEach((b,i)=>{b._cycle=d=>{letters[i]=(letters[i]+d+alphabet.length)%alphabet.length;redraw();};});};redraw();\n}\nfunction makeHooks(){return{\n action:(id,a)=>{if(world&&transport?.isHost&&\"'!terminated)acceptAction(world,id,a);},\n world:p=>{if(terminated||transport?.isHost)return;const next=applyWorldPacket(world,p,transport.roster);if(next){previousPacket=world;world=next;latestPacket=p;packetAt=performance.now();}},\n leave:id=>{if(world&&transport?.isHost)leaveWorld(world,id);},\n timeUp:()=>{if(world&&!world.outcome)finishWorld(world,false,'\"'time-limit');transport?.finish(world);},\n end:reason=>{terminated=true;consume();sound.end();if(hosted){world&&(world.phase='terminated');game.stop();}else{ui.hide();ui.show('disconnected',{title:'Timeline disconnected',text:reason,actions:[['Return to solo',()=>{leaveRoom();}],['Online menu',()=>{leaveRoom();onlineMenu();}]]});}},\n status:text=>{onlineStatus=text;if(ui.screen==='room')roomScreen();},\n roster:()=>{if(ui.screen==='room')roomScreen();},\n begin:seed=>{startRun(seed,transport.roster,true);},\n lobby:()=>{world=null;game.live=false;game.resume();ui.hide();roomScreen();}\n};}\nasync function connectRoom(create,code){\n if(hosted)return;transport?.close();transport=new RoomTransport(makeHooks());onlineStatus=create?'Opening signaling connection…':'Connecting to the room…';roomScreen();\n try{if(create)await transport.create();else await transport.join(code);roomScreen();}catch(error){if(transport?.closed)return;onlineStatus=error.message;roomScreen();}\n}\nfunction roomScreen(){\n if(hosted||\"'!transport)return;const room=transport;\n ui.show('\"'room',{kicker:room.isHost?'HOSTED TIMELINE':'SHARED TIMELINE',title:room.code?room.code.match(/.{1,4}/g).join(' '):'Connecting',text:onlineStatus,sections:[['PILOTS',room.roster.length?room.roster.map(p=>'P'+(p.id+1)+' · '+p.name+' · '+(p.ready?'READY':'WAITING')).join('\\\\n'):'Waiting for the signaling service…']],actions:[\n  ...(room.isHost?[{label:'Start campaign',primary:true,disabled:\"'!room.peer?.open||!room.roster.every(p=>p.ready),fn:()=>room.start(seedValue())},['\"'Copy room code',()=>copyCode(room.code)]]:[{label:'Ready / Not ready',disabled:room.me===null,fn:()=>room.ready()}]),\n  ['Retry connection',()=>connectRoom(room.isHost,room.code)],['Leave room / Solo',leaveRoom]\n ],back:leaveRoom});\n}\nasync function copyCode(code){try{await navigator.clipboard.writeText(code);onlineStatus='CODE COPIED · '+code;}catch{onlineStatus='COPY UNAVAILABLE · Select the code below, or read it aloud: '+code;}roomScreen();const box=ui.root.querySelector('.esh-mod'),field=document.createElement('input');field.className='room-code';field.readOnly=true;field.value=code;field.setAttribute('aria-label','Shareable room code');box.querySelector('p').after(field);field.focus();field.select();}\nfunction leaveRoom(){if(hosted)return;transport?.close();transport=null;terminated=false;world=null;title();}\nfunction showResults(){\n const w=world;if(\"'!w)return;consume();\n ui.show('\"'results',{kicker:w.outcome?.won?'THE RIFT IS SEALED':'A CENTURY WORTH ANOTHER TRY',title:w.outcome?.won?'Time well stolen.':'Out of seconds.',text:w.outcome?.won?'The Boss sends a strongly worded letter to yesterday. Your century declines to reply.':'Your last machine has gone quiet. The Boss is insufferable. You can fix that.',\n stats:[[String(w.score).padStart(6,'0'),'TEAM SCORE'],[w.stats.intercepts,'INTERCEPTIONS'],[w.stats.ships,'HULLS BROKEN'],[w.stats.brakes,'TIME BRAKES']],\n sections:[['FLIGHT RECORD',Math.floor(w.time/60)+':'+String(Math.floor(w.time%60)).padStart(2,'0')+' · '+w.stats.hits+' hits · '+w.stats.bonus+' wave bonus · '+(w.modified?'DEV / MODIFIED — no record':w.assisted||Object.values(w.assists||{}).some(Boolean)?'ASSISTED RECORD':w.players.length>1?'CO-OP RECORD':'STANDARD SOLO RECORD')]],\n actions:transport?[...(transport.isHost?[['Return to room / Replay',()=>transport.lobby()]]:[]),['Leave room',leaveRoom]]:[['Retry campaign',()=>{startRun(seedValue(),[{id:0,name:'PILOT 1'}],false);}],['Save six-letter record',saveRecord],['High scores',showScores],['Reset tuning & retry',()=>{resetTuning();startSolo(false);}],['Title',title]]});\n}\nfunction recordMode(){return world.modified?'modified':world.assisted||Object.values(world.assists||{}).some(Boolean)?'assisted':world.players.length>1?'coop':'solo';}\nfunction getRecords(){const value=E.store.get('tbb:records:v1',[]);return Array.isArray(value)?value.filter(r=>r&&typeof r.name==='string'&&r.name.length===6&&Number.isFinite(r.score)).slice(0,30):[];}\nfunction saveRecord(){if(\"'!world||world.modified||world.demo||scoreSaved||transport||hosted){ui.toast('\"'Record unavailable',scoreSaved?'This record is already saved.':'Developer and demonstration runs do not enter the table.');return;}\n characterPicker('Your six-letter callsign','PILOTX',6,'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789',name=>{const rows=getRecords();rows.push({name,score:world.score,mode:recordMode()});rows.sort((a,b)=>b.score-a.score);E.store.set('tbb:records:v1',rows.slice(0,30));scoreSaved=true;ui.toast('Record saved',name+' · '+world.score);showScores();});\n}\nfunction showScores(){const rows=getRecords();ui.show('records',{kicker:'LOCAL FLIGHT RECORDS',title:'Seconds to remember',text:rows.length?rows.slice(0,12).map((r,i)=>String(i+1).padStart(2,'0')+'  '+r.name+'  '+String(r.score).padStart(6,'0')+'  '+r.mode.toUpperCase()).join('\\\\n'):'No records yet. Your century is waiting.',actions:[['Back',()=>ui.back()]]});}\nfunction resetTuning(){game.settings.reset('Dev tuning');game.settings.reset('Dev tools');devSpeed=1;if(world)world.tuning=effectiveTuning();}\nfunction openDev(){\n if(transport||hosted){ui.show('inspect',{kicker:'SHARED WORLD',title:'Session inspection',text:()=>JSON.stringify({seed:world?.seed,tick:world?.tick,phase:world?.phase,score:world?.score}),actions:[['Back',()=>ui.back()]]});return;}\n markModified();ui.show('dev',{kicker:'RUN MARKED MODIFIED · SESSION ONLY',title:'Dev Mode',text:()=>\"'`Seed ${world?.seed} · tick ${world?.tick} · ${world?.phase} · ${world?.enemies.length||0} hulls · ${world?.threats.length||0} threats`,rows:['\"'dev_invulnerable','dev_hitboxes','dev_trajectories','dev_ai'],actions:[['Jump to encounter',devJumpMenu],['Restart encounter',()=>{if(world)startEncounter(world,world.wave,world.wave===8?world.bossPhase:null);ui.back();}],['Step one tick',()=>{if(world)stepWorld(world,FIXED_DT);art.ingest(world);openDev();}],['Simulation speed: '+devSpeed+'×',()=>{devSpeed=devSpeed===1?.5:devSpeed===.5?2:1;openDev();}],['Refill integrity & brake',()=>{for(const p of world.players){p.hp=3;p.inv=2;}world.brake=100;ui.toast('Restored','Three pips. Full charge.');}],['Spawn a threat',devSpawnMenu],['Live tuning sliders',()=>ui.show('tuning',{title:'Balance the timeline',kicker:'LIVE VALUES · DEFAULTS SHOWN BELOW EACH SLIDER',rows:TUNING.map(([k])=>'dev_'+k),actions:[['Reset tuning to defaults',()=>{resetTuning();ui.show('tuning');}],['Back',()=>ui.back()]]})],['Reset all developer defaults',()=>{resetTuning();openDev();}],['Return to play',()=>{ui.hide();game.resume();consume();}]]});\n}\nfunction devJumpMenu(){ui.show('jump',{title:'Choose an encounter',actions:[...WAVES.map((w,i)=>[String(i+1).padStart(2,'0')+' · '+w.name,()=>{startEncounter(world,i);world.outcome=null;ui.hide();game.resume();}]),...BOSS_PHASES.map((b,i)=>['Boss '+(i+1)+' · '+b.name,()=>{world.outcome=null;startEncounter(world,8,i);ui.hide();game.resume();}]),['Back',()=>ui.back()]]});}\nfunction devSpawnMenu(){ui.show('spawn',{title:'Spawn a weapon',actions:Object.entries(WEAPONS).map(([k,v])=>[v.name,()=>{spawnThreat(world,k,{x:world.players[0].x,y:160});ui.hide();game.resume();}]).concat([['Back',()=>ui.back()]])});}\nfunction showCredits(page=0){creditsPage=page;\n const info=BUILD_INFO;\n const pages=[\n ['About / Credits', [['AN ORIGINAL TEMPORAL ARCADE','Design, procedural art, original music, sound and gibberish voice by OpenAI gpt-6.1-sol, built for Michael Crosato. Based on Attack of the Timelord\"'! (Odyssey², 1982). New campaign, time brake and simultaneous co-op are adaptation choices.'\"'],['CREDITS & LICENSES','my-3D2dge v0.89.1 · Michael Crosato · MIT. AI Hub session client 1.4.0, unmodified; repository license unknown. PeerJS 1.5.5 · PeerJS contributors · MIT. No audio files, borrowed game art, browser TTS or television franchise lore.'],['RESEARCH','North American manual, William Cassidy’s hands-on review, gameplay still and box illustration at odyssey2.info were inspected. No gameplay video was viewed. Original steering equations, timings and continuous musical score are unknown.']]],\n ['Source Information',Object.entries(info.sourceInformation).map(([k,v])=>[k.replace(/([A-Z])/g,' \"'$1'\"').toUpperCase(),v])],\n ['Testing Feedback',info.testingFeedback.map((v,i)=>[['ISSUES CAUGHT','CRITICAL ISSUES','MOST HELPFUL TEST','LEAST HELPFUL TEST'][i],v])],\n ['Engine Feedback',info.engineFeedback.map((v,i)=>[['LIKED MOST','STUCK / WRONG GUESSES','BUILT OURSELVES','HARDEST PART','ENGINE CHANGES','ONE SUGGESTION'][i],v])],\n ['Prompt Feedback',info.promptFeedback.map((v,i)=>[['LIKED MOST','CONFUSING','HARDEST TASK','SUGGESTED CHANGE'][i],v])],\n ['Source & dependency links',[['MANUAL','https://odyssey2.info/library/manuals/us_timelord/Attack%20of%20the%20Timelord%20(USA).pdf'],['REVIEW','https://odyssey2.info/reviews/attack-of-the-timelord-6'],['ENGINE','https://github.com/michaelcrosato/my-3d2dge'],['AI HUB','https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub'],['PEERJS','https://peerjs.com/client/getting-started'],['ONLINE LIMITS','Public signaling and direct WebRTC links depend on network availability. Some NAT configurations require TURN. Automated signal checks cannot establish subjective audio quality. Physical pads and iOS hardware are unavailable here.']]]\n ];\n const [heading,sections]=pages[page];ui.show('credits',{kicker:'ABOUT · '+(page+1)+' / '+pages.length,title:heading,sections,actions:[['Next page',()=>showCredits((page+1)%pages.length)],['Previous page',()=>showCredits((page+pages.length-1)%pages.length)],['Back',()=>ui.back()]]});\n}\n// Called before shell input suppression, including while paused.\ngame.hook('input',dt=>{\n const I=game.input;\n if(terminated){I.consumeAll();return;}\n if(I.anyPressed()||Math.hypot(...I.padMove)>.2){if(demo){activity();I.consumeAll();return;}lastHuman=game.real;arcade.wake();if(I.lastDevice==='gamepad')sound.unlock();}\n if(hosted&&I.held.has('Pad8'))I.suppress('pause');\n if(game.paused&&\"'!pausedBefore){pausedAt=game.real;sound.pause();consume();}pausedBefore=game.paused;\n if(ui.screen==='\"'dev'&&world){const t=ui.root.querySelector('p');if(t)t.textContent=\"'`Seed ${world.seed} · tick ${world.tick} · ${world.phase} · ${world.enemies.length} hulls · ${world.threats.length} threats`;}\n setPrompt();\n});\ngame.debug={snapshot:()=>({title:TITLE,scene:game.sceneName,screen:ui.screen,paused:game.paused,demo,hosted,server:transport?.server||false,terminated,seed:world?.seed,tick:world?.tick,phase:world?.phase,wave:world?.wave,bossPhase:world?.bossPhase,score:world?.score,players:world?.players.map(p=>({id:p.id,x:p.x,hp:p.hp,connected:p.connected})),enemies:world?.enemies.length,threats:world?.threats.map(t=>({kind:t.kind,state:t.state,x:t.x,y:t.y})),brake:world?.brake,seen:world?.seen,modified:world?.modified,music:game.settings.music,input:game.input.lastDevice,packets:transport?.meter.snapshot(),errors:game.errors})};\nglobalThis.game=game;\nglobalThis.TimeBandit={game,ui,art,sound,get world(){return world;},get transport(){return transport;},snapshot:game.debug.snapshot};\nif(TEST_MODE)Object.assign(globalThis.TimeBandit,{startSolo,startRun,title,startAttract,showResults,showHelp,showJoin,showCredits,openDev,resetTuning,roomScreen,connectRoom,leaveRoom,showScores,getRecords,saveRecord,codeTone:null,get demo(){return demo;},setAutomation:fn=>{automation=fn;},setWorld:w=>{world=w;},step:n=>{for(let i=0;i<n;i++)stepWorld(world,FIXED_DT);art.ingest(world);},advance:s=>game.advance(s),action:(a,id=0)=>acceptAction(world,id,a),packet:()=>worldPacket(world)});\nconst scenes={title:{enter(){showTitle();},update:updateTitle,draw:r=>art.draw(r,null)},play:{pausable:true,camera:false,update:updatePlay,draw:drawWorld},attract:{pausable:false,camera:false,update:updateAttract,draw:drawWorld}};\ngame.start({scene:'\"'title',scenes});\nasync function boot(){\n const info=await AIHub.connect({mode:'shared-world',seats:[1,4]});\n if(\"'!info){hosted=false;title();const invite=new URLSearchParams(location.search).get('\"'room');if(invite){joinCode=invite;onlineMenu();showJoin();}document.body.dataset.booted='true';return;}\n hosted=true;terminated=false;ui.hide();transport=new HubTransport(AIHub,info,makeHooks());game.o.autoPause=false;game.live=true;game.o.menu.items=()=>[['Session inspection',openDev]];ui._o.screens.pause.title='Local options';\n startRun(info.seed,info.players,true);document.body.dataset.booted='true';AIHub.ready();\n}\nboot().catch(error=>{game.fail('boot',error);if(AIHub.active)AIHub.fail(error.message);else title();});\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_39","type":"agent_message","text":"The campaign, four machine designs, fleet hulls, animated tyrant, procedural score, and gibberish voice are implemented. The online room flow now uses PeerJS/WebRTC. Next I’ll test the bundled HTML, Hub harness, and input paths, including the developer controls and attract mode."}}
{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"cat > src/style.css <<'EOF'\n:root{color-scheme:dark}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#060b15;color:#f4e8cc}body{font-family:system-ui,sans-serif}#screen{position:fixed;inset:0;width:100%;height:100%;display:block;image-rendering:pixelated;touch-action:none}.esh .esh-ttl{background:linear-gradient(90deg,#080e1af5 2%,#080e1ac9 39%,#080e1a30 64%,transparent);padding:28px 32px}.esh .esh-ttl>div{padding-left:2vw;max-width:430px}.esh .esh-ttl h1{font-size:clamp(37px,6.3vw,64px);letter-spacing:.025em;line-height:.97;text-transform:uppercase;color:#f9e3af;text-shadow:3px 3px #3d5265,5px 5px #101a2b;margin-top:12px;max-width:420px}.esh .esh-sub{font:500 16px system-ui,sans-serif;letter-spacing:.07em;color:#83d5d7;margin:15px 0 10px}.esh .esh-ttl p{font-size:13px;line-height:1.55;color:#b4c7cb;max-width:310px}.esh .esh-btns{gap:7px;margin-top:16px}.esh .esh-ttl .esh-btns{max-width:305px}.esh button{border-radius:0;min-height:39px;letter-spacing:.07em;font-size:12px;border-color:#41556a;padding:10px 14px;transition:background .12s,color .12s}.esh button:focus{outline:2px solid #f4d38f;outline-offset:2px;background:#36515a;color:#fff0c8}.esh button.pri{background:#efd093;border-color:#ffe4b1;color:#172536}.esh button.pri:focus{background:#fff0c0;color:#0d1d2c;box-shadow:0 0 20px #c7b57924}.esh .esh-tags{font-size:9px;letter-spacing:.08em;gap:12px;color:#91a9b7;margin-top:17px}.esh .esh-ttl>div>.esh-m{font-size:8px;line-height:1.5;max-width:330px;margin-top:12px;letter-spacing:.1em}.esh .esh-mod{border-radius:0;border-width:1px;border-top:3px solid #d3bb89;width:min(600px,100%);padding:23px 26px;scrollbar-color:#b9b58d #162436}.esh .esh-mod h2{font:500 32px Impact,Haettenschweiler,sans-serif;text-transform:uppercase;letter-spacing:.04em;line-height:1.06;margin:5px 0 12px}.esh .esh-mod .esh-m{font-size:13px;line-height:1.55;overflow-wrap:anywhere}.esh .esh-mod .esh-k{font-size:10px;color:#e7c88f}.esh .esh-grid kbd{white-space:nowrap}.esh .esh-row{padding:9px 0}.esh .esh-row>span{font-size:13px}.esh .esh-sec{margin-top:18px}.esh .esh-stats small{font-size:9px}.esh .esh-stats b{font:500 28px Impact,sans-serif;color:#ffe3ae}.esh .esh-row small{font-size:10px}.esh input[type=range]{width:130px}.esh .esh-pan{box-shadow:0 14px 80px #010510bd}.esh .esh-sh{background:#050a13c9}.esh .esh-ttl{background:linear-gradient(90deg,#080e1af7,#080e1abf 39%,#080e1a26 64%,transparent)}.esh .room-code{width:100%;font:700 25px monospace;letter-spacing:.18em;padding:12px 10px;margin:12px 0;background:#132a3d;border:1px solid #6d9ba5;color:#ffe3a6;text-transform:uppercase}.esh .esh-nav{border-radius:0}#device-prompt{position:fixed;left:50%;bottom:5px;transform:translateX(-50%);font:600 clamp(10px,1vw,16px) system-ui,sans-serif;letter-spacing:.08em;color:#9bb8c2;pointer-events:none;background:#080e1dbb;padding:4px 12px;white-space:nowrap}#touch-brake{position:fixed;bottom:calc(18px + env(safe-area-inset-bottom));right:18px;min-width:90px;min-height:56px;border:2px solid #c8f5c4;background:#173b43ec;color:#ebffc9;font:700 14px system-ui;letter-spacing:.1em;border-radius:12px;z-index:19;touch-action:none}#touch-note{position:fixed;bottom:8vh;width:100%;padding:0 18px;text-align:center;font:600 11px system-ui;color:#8fb5bd;pointer-events:none}#e3-corner button{border-radius:0\"'!important;background:#112237c9!important}.esh .esh-sh input:not([type=range]){min-height:44px}.esh .esh-btns button:disabled{opacity:.35}#boot-label{position:fixed;bottom:15px;left:15px;color:#9dbbc4;font:14px monospace;pointer-events:none}body[data-booted=true] #boot-label{display:none}[hidden]{display:none!important}\n@media(max-width:600px){.esh .esh-ttl{background:linear-gradient(90deg,#080e1aef,#080e1ab7);padding:18px}.esh .esh-ttl>div{max-width:98%;padding-left:0}.esh .esh-ttl h1{font-size:43px;max-width:330px}.esh .esh-ttl p{max-width:290px}.esh .esh-mod{padding:18px 18px}.esh .esh-sh{padding-left:12px;padding-right:12px}.esh .esh-grid{gap:7px}.esh .esh-mod h2{font-size:28px}.esh .esh-grid kbd{font-size:10px}.esh .esh-ttl .esh-btns{max-width:340px}.esh .esh-ttl>div>.esh-m{font-size:8px}.esh .esh-row>span{flex-basis:140px}}\n@media(max-height:500px){.esh .esh-ttl h1{font-size:39px;max-width:330px}.esh .esh-ttl{padding-top:14px}.esh .esh-ttl .esh-btns{gap:5px}.esh .esh-ttl .esh-sub{margin:8px 0}.esh .esh-ttl p{display:none}.esh .esh-ttl button{padding:7px 12px;min-height:34px}.esh .esh-ttl .esh-tags{margin-top:10px}.esh .esh-ttl>div>.esh-m{display:none}.esh .esh-mod{max-height:100%}#touch-note{bottom:6px;font-size:9px}}\n@media(pointer:coarse) and (orientation:landscape){#touch-note{display:none!important}#touch-brake{bottom:10px;right:10px;min-height:44px;min-width:78px;font-size:12px}}\nEOF\ncat > tools/build.mjs <<'\"'EOF'\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport {fileURLToPath} from 'node:url';\nconst root=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'..');\nconst work=path.dirname(root),config=JSON.parse(fs.readFileSync(path.join(work,'build-config.json'),'utf8'));\nconst read=f=>fs.readFileSync(path.join(root,f),'utf8');\nconst escapeScript=s=>s.replace(/<\\\\/script/gi,'<\\\\\\\\/script');\nconst files=['src/content/campaign.js','src/game/simulation.js','src/presentation/renderer.js','src/audio/sound.js','src/network/transports.js','src/main.js'];\nconst source=files.map(f=>'\\\\n// '+f+'\\\\n'+read(f).replace(/\"'^import .*?;'\"\\\\s*\"'$/gm,'\"'').replace(/\"'^export /gm,'\"'')).join('\\\\n');\nconst info=JSON.parse(fs.readFileSync(path.join(work,'exit-interview.json'),'utf8'));\nconst custom='(()=>{\\\\n\\\"use strict\\\";\\\\nconst PEER_SOURCE='+JSON.stringify(read('vendor/peerjs-1.5.5.min.js'))+';\\\\nconst BUILD_INFO='+JSON.stringify(info)+';\\\\n'+source+'\\\\n})();';\nconst html='<\"'!doctype html>'\"\\\\n<html lang=\\\"en\\\"><head><meta 