>{try{fn();results.push({name,pass:true});}catch(e){results.push({name,pass:false,error:e.stack});}};\n const work=path.dirname(root),config=JSON.parse(fs.readFileSync(path.join(work,'build-config.json'),'utf8')),artifact=path.join(work,config.base+'.html'),html=fs.readFileSync(artifact,'utf8'),interview=JSON.parse(fs.readFileSync(path.join(work,'exit-interview.json'),'utf8'));\n test('complete exit interview shape, ordered feedback and matching catalogue',()=>{\n assert.deepEqual(Object.keys(interview),['sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub']);\n assert.equal(Object.keys(interview.sourceInformation).length,15);assert(Object.values(interview.sourceInformation).every(v=>typeof v==='string'&&v.length>0));assert.equal(interview.sourceInformation.usage,'added on import');\n assert.equal(interview.testingFeedback.length,4);assert.equal(interview.engineFeedback.length,6);assert.equal(interview.promptFeedback.length,4);assert.equal(interview.aiHub.name,config.title);assert.equal(interview.aiHub.players,'1–4');assert(interview.aiHub.tags.length>=3&&interview.aiHub.tags.length<=6);\n });\n test('fifty-candidate real RNG title selection and required delivery name',()=>{const selected=JSON.parse(fs.readFileSync(path.join(root,'docs/title-selection.json'),'utf8'));assert.equal(selected.candidates.length,50);assert.equal(new Set(selected.candidates).size,50);assert.equal(selected.candidates[selected.selectedIndex],config.title);assert(config.base.endsWith('Attack-of-the-Timelord-1982-gpt-6.1-sol-max-20261106-022729'));assert(html.includes('<title>'+config.title+'</title>'));});\n test('unmodified Hub client is first script immediately after charset',()=>{const client=fs.readFileSync(path.join(root,'vendor/hub/session.js'),'utf8');const first=html.match(/<meta charset=\\\"utf-8\\\">\\\\s*<script>([\\\\s\\\\S]*?)<\\\\/script>/);assert(first);assert.equal(first[1],client.replace(/<\\\\/script/gi,'<\\\\\\\\/script'));for(const tag of ['hub:session','hub:session-players','hub:session-mode','hub:session-goal','hub:session-howto'])assert(html.includes('name=\\\"'+tag+'\\\"'));});\n test('single-file scripts parse, dependencies inline, no accidental local source paths',()=>{const scripts=[...html.matchAll(/<script>([\\\\s\\\\S]*?)<\\\\/script>/g)];assert.equal(scripts.length,3);for(const [,script]of scripts)new Function(script);assert(\"'!/<script[''^>]+src=/.test(html));assert(!/type=\"module\"/.test(html));assert(!/(src|href)=\"(?:'\"\\\\.\\\\/)?(?:src|vendor)\\\\//.test(html));});\n return{results,sha256:crypto.createHash('sha256').update(html).digest('hex'),bytes:Buffer.byteLength(html)};\n}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('tools/test.mjs');s=p.read_text().replace('import { stateTests } from \\\"../tests/state.mjs\\\";','import { stateTests } from \\\"../tests/state.mjs\\\";\\\\nimport {packagingTests} from \\\"../tests/packaging.mjs\\\";')\ns=s.replace('for (const target of [\\\"browser\\\", \\\"network\\\"])','if(all||requested.includes(\\\"packaging\\\")){const report=packagingTests(root);results.push(...report.results);fs.writeFileSync(path.join(root,\\\"artifacts/packaging-results.json\\\"),JSON.stringify(report,null,2));}\\\\nfor (const target of [\\\"browser\\\", \\\"network\\\"])')\ns=s.replace('process.exitCode = failed ? 1 : 0;', '''fs.writeFileSync(path.join(root,\\\"artifacts/last-test.json\\\"),JSON.stringify({checks:results.length,passed:results.length-failed,failed,groups:all?[\\\"state\\\",\\\"packaging\\\",\\\"browser\\\",\\\"network\\\"]:requested},null,2));\nprocess.exitCode = failed ? 1 : 0;''')\np.write_text(s)\nPY\nbiome check --write --javascript-linter-enabled=false --css-linter-enabled=false --assist-enabled=false --javascript-formatter-indent-style=space --javascript-formatter-indent-width=2 src tools tests/state.mjs tests/packaging.mjs\nruff check --fix --ignore BLE001,B023,S110 tests\nruff format tests\nnode tools/build.mjs --quiet\nnode tools/test.mj