{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"gh api repos/michaelcrosato/my-3d2dge/git/trees/8ecc2f62353761187bdfe226f327b7ea5d2eb691?recursive=1 --jq '.tree[] | select(.path | startswith(\\\"dist/handoff/\\\")) | [.path,.size] | @tsv'\"","aggregated_output":"dist/handoff/AI_GUIDE.md\t114712\ndist/handoff/API-INDEX.md\t200618\ndist/handoff/API.md\t68162\ndist/handoff/README.md\t8139\ndist/handoff/docs\t\ndist/handoff/docs/ASSETS.md\t11643\ndist/handoff/game\t\ndist/handoff/game/game.js\t9243\ndist/handoff/game/index.html\t1397\ndist/handoff/game/test.mjs\t2609\ndist/handoff/index.html\t6981\ndist/handoff/kits\t\ndist/handoff/kits/README.md\t6980\ndist/handoff/kits/adventure.html\t1457\ndist/handoff/kits/adventure.js\t71809\ndist/handoff/kits/animlab.html\t1461\ndist/handoff/kits/animlab.js\t54246\ndist/handoff/kits/arcade.html\t1392\ndist/handoff/kits/arcade.js\t74410\ndist/handoff/kits/artillery.html\t1401\ndist/handoff/kits/artillery.js\t53238\ndist/handoff/kits/brawler.html\t1449\ndist/handoff/kits/brawler.js\t78902\ndist/handoff/kits/fighting.html\t1398\ndist/handoff/kits/fighting.js\t36909\ndist/handoff/kits/kart.html\t1386\ndist/handoff/kits/kart.js\t35762\ndist/handoff/kits/metroidvania.html\t1410\ndist/handoff/kits/metroidvania.js\t86459\ndist/handoff/kits/pinball.html\t1395\ndist/handoff/kits/pinball.js\t51523\ndist/handoff/kits/platformer.html\t1461\ndist/handoff/kits/platformer.js\t79504\ndist/handoff/kits/pointclick.html\t1414\ndist/handoff/kits/pointclick.js\t66846\ndist/handoff/kits/puzzle.html\t1392\ndist/handoff/kits/puzzle.js\t45272\ndist/handoff/kits/rhythm.html\t1392\ndist/handoff/kits/rhythm.js\t36633\ndist/handoff/kits/road.html\t1386\ndist/handoff/kits/road.js\t34669\ndist/handoff/kits/roguelike.html\t1401\ndist/handoff/kits/roguelike.js\t40240\ndist/handoff/kits/rpg.html\t1433\ndist/handoff/kits/rpg.js\t141060\ndist/handoff/kits/rts.html\t1383\ndist/handoff/kits/rts.js\t48382\ndist/handoff/kits/shooter.html\t1449\ndist/handoff/kits/shooter.js\t110383\ndist/handoff/kits/sim.html\t1383\ndist/handoff/kits/sim.js\t53008\ndist/handoff/kits/sports.html\t1392\ndist/handoff/kits/sports.js\t50211\ndist/handoff/kits/stealth.html\t1449\ndist/handoff/kits/stealth.js\t37126\ndist/handoff/kits/tactics.html\t1395\ndist/handoff/kits/tactics.js\t61120\ndist/handoff/kits/test.mjs\t3011\ndist/handoff/modules\t\ndist/handoff/modules/arcade.js\t16273\ndist/handoff/modules/click.js\t33195\ndist/handoff/modules/drive.js\t19197\ndist/handoff/modules/fight.js\t44576\ndist/handoff/modules/gen.js\t13450\ndist/handoff/modules/grid.js\t30487\ndist/handoff/modules/mode7.js\t16722\ndist/handoff/modules/physics.js\t31868\ndist/handoff/modules/rhythm.js\t15431\ndist/handoff/modules/road.js\t13052\ndist/handoff/modules/rooms.js\t15209\ndist/handoff/modules/rpg.js\t25133\ndist/handoff/modules/songs.js\t15749\ndist/handoff/modules/story.js\t13969\ndist/handoff/modules/strategy.js\t35521\ndist/handoff/modules/terrain.js\t14361\ndist/handoff/my-3d2dge-agent.js\t300564\ndist/handoff/my-3d2dge.js\t1266871\ndist/handoff/package.json\t375\ndist/handoff/src\t\ndist/handoff/src/assets\t\ndist/handoff/src/assets/README.md\t3735\ndist/handoff/src/assets/catalogs\t\ndist/handoff/src/assets/catalogs/ambientcg.json\t60929\ndist/handoff/src/assets/catalogs/kaykit-dungeon-remastered.json\t14061\ndist/handoff/src/assets/catalogs/kaykit-furniture-bits.json\t5006\ndist/handoff/src/assets/catalogs/kaykit-halloween-bits.json\t3082\ndist/handoff/src/assets/catalogs/kaykit-restaurant-bits.json\t11164\ndist/handoff/src/assets/catalogs/kenney-fantasy-town.json\t10154\ndist/handoff/src/assets/catalogs/kenney-food.json\t9710\ndist/handoff/src/assets/catalogs/kenney-furniture.json\t7288\ndist/handoff/src/assets/catalogs/kenney-graveyard.json\t7929\ndist/handoff/src/assets/catalogs/kenney-holiday.json\t5908\ndist/handoff/src/assets/catalogs/kenney-mini-dungeon.json\t2476\ndist/handoff/src/assets/catalogs/kenney