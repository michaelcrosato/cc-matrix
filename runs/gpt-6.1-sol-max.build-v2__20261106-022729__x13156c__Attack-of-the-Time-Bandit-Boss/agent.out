{"type":"item.started","item":{"id":"item_82","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/main.js');s=p.read_text().replace('heading === \\\"Source Information\\\"\\\\n        ? 3','heading === \\\"Source Information\\\"\\\\n        ? 2');p.write_text(s)\np=Path('tests/network.py');s=p.read_text();pos=s.index('    # Real standalone rooms:')\ns=s[:pos]+'''    page=browser.new_page(viewport={'width':1280,'height':900})\n    def stressed_gameplay():\n        query=urllib.parse.urlencode({'game':'/'+config['base']+'.html?test=1','players':4,'auto':1,'play':20000,'latency':150,'jitter':50,'loss':5})\n        page.goto(base+'/'+urllib.parse.quote(config['base'])+'/vendor/hub/harness.html?'+query)\n        page.wait_for_function(\\\"document.querySelectorAll('iframe').length>=3 && Array.from(document.querySelectorAll('iframe')).every(f=>f.contentWindow.TimeBandit?.snapshot().tick>280)\\\",timeout=25000)\n        frames=[f for f in page.frames[1:] if f.evaluate('\"'!!window.TimeBandit'\"')]\n        authority=next(f for f in frames if f.evaluate('AIHub.isHost'))\n        guest_frame=next(f for f in frames if not f.evaluate('AIHub.isHost'))\n        guest_id=guest_frame.evaluate('AIHub.me')\n        authority.evaluate('(id)=>{const w=TimeBandit.world;w.players.find(p=>p.id===id).hp=0;w.enemies=[];}',guest_id)\n        authority.wait_for_function(\\\"TimeBandit.world.phase==='intermission'\\\")\n        score=authority.evaluate('TimeBandit.world.score')\n        for frame in frames:\n            frame.wait_for_function(\\\"([id,score])=>TimeBandit.world.phase==='intermission' && TimeBandit.world.players.find(p=>p.id===id).hp===1 && TimeBandit.world.threats.length===0 && TimeBandit.world.score===score\\\",arg=[guest_id,score],timeout=3000)\n        authority.evaluate('TimeBandit.world.brake=100;TimeBandit.world.brakeCooldown=0')\n        guest_frame.wait_for_function('TimeBandit.world.brake===100',timeout=3000)\n        guest_frame.evaluate(\\\"dispatchEvent(new KeyboardEvent('keydown',{code:'ShiftLeft',key:'Shift',bubbles:true}))\\\")\n        page.wait_for_timeout(100)\n        guest_frame.evaluate(\\\"dispatchEvent(new KeyboardEvent('keyup',{code:'ShiftLeft',key:'Shift',bubbles:true}))\\\")\n        # Brake edges survive the intermission and are applied on the first eligible play tick.\n        for frame in frames:\n            frame.wait_for_function('TimeBandit.world.wave===1 && TimeBandit.world.stats.brakes===1',timeout=6500)\n        # A collision fixture tests reliable terminal convergence separately from legitimate campaign tests.\n        authority.evaluate(\\\"(()=>{const w=TimeBandit.world;for(const p of w.players.filter(p=>p.connected)){p.x=100+p.id*170;p.hp=1;p.inv=0;w.threats.push({id:99900+p.id,kind:'dart',x:p.x,y:p.y,px:p.x,py:p.y,vx:0,vy:0,age:0,warn:0,state:'air',target:p.id,tx:p.x,ty:p.y,r:5,life:1,ground:false});}})()\\\")\n        page.wait_for_function(\\\"document.body.dataset.complete==='true'\\\",timeout=15000)\n        expect(page.evaluate('__hubCheck.pass'))\n        states=[frame.evaluate('TimeBandit.snapshot()') for frame in frames]\n        expect(all(s['terminated'] and s['score']==states[0]['score'] for s in states))\n        details['stressedGameplay']={'latency':150,'jitter':50,'loss':5,'states':states,'result':page.evaluate('__hubCheck')}\n    check('stressed Hub wave-clear recovery, guest brake edge and terminal convergence',stressed_gameplay)\n    page.close()\n''' +s[pos:];p.write_text(s)\nPY\nbiome check --write --javascript-linter-enabled=false --css-linter-enabled=false --assist-enabled=false --javascript-formatter-indent-style=space --javascript-formatter-indent-width=2 src tools tests/state.mjs tests/packaging.mjs\nruff check --fix --ignore BLE001,B023,S110 tests\nruff format tests\nnode tools/build.mjs --quiet\nnode tools/test.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
