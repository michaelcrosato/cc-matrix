{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"cat > tests/network.py <<'EOF'\nimport functools,json,threading,traceback,urllib.parse,urllib.request,time\nfrom pathlib import Path\nfrom http.server import ThreadingHTTPServer,SimpleHTTPRequestHandler\nfrom playwright.sync_api import sync_playwright\nroot=Path(__file__).resolve().parents[1]\nconfig=json.loads((root.parent/'build-config.json').read_text())\nclass QuietHandler(SimpleHTTPRequestHandler):\n def log_message(self,*args):pass\nserver=ThreadingHTTPServer(('127.0.0.1',0),functools.partial(QuietHandler,directory=str(root.parent)))\nthread=threading.Thread(target=server.serve_forever,daemon=True);thread.start()\nbase='http://127.0.0.1:'+str(server.server_port)\ngame_url=base+'/'+urllib.parse.quote(config['base']+'.html')\nassert config['title'] in urllib.request.urlopen(game_url).read().decode()\nresults=[];details={'hubRevision':config['hubCommit'],'peerjs':'1.5.5','harness':[],'standalone':{}}\ndef check(name,fn):\n try:fn();results.append({'name':name,'pass':True})\n except Exception:results.append({'name':name,'pass':False,'error':traceback.format_exc()})\ndef expect(value,message='assertion failed'):\n if not value:raise AssertionError(message)\nwith sync_playwright() as pw:\n browser=pw.chromium.launch(headless=True,args=['--autoplay-policy=no-user-gesture-required'])\n for params in [{'players':2},{'players':4,'latency':150,'jitter':50,'loss':5},{'players':4,'latency':150,'jitter':50,'loss':5,'scenario':'host-leave'},{'players':2,'scenario':'server'}]:\n  page=browser.new_page(viewport={'width':1280,'height':900})\n  label='Hub conformance '+json.dumps(params)\n  def harness_case():\n   query=urllib.parse.urlencode({'game':'/'+config['base']+'.html','auto':1,**params})\n   url=base+'/'+urllib.parse.quote(config['base'])+'/vendor/hub/harness.html?'+query\n   page.goto(url);page.wait_for_function(\\\"document.body.dataset.complete==='true'\\\",timeout=70000)\n   report=page.evaluate('window.__hubCheck');details['harness'].append({'params':params,'report':report})\n   expect(report['pass'],json.dumps([c for c in report['checks'] if not c['pass']]))\n   states=[]\n   for frame in page.frames[1:]:\n    try:states.append(frame.evaluate('TimeBandit.snapshot()'))\n    except:pass\n   details['harness'][-1]['states']=states\n   expect(all(s['terminated'] for s in states),'a remaining peer did not stop')\n   expect(all(s['errors']==[] for s in states),'engine errors')\n   expect(all(not frame.evaluate('\"'!!window.Peer'\"') for frame in page.frames[1:]),'PeerJS initialized in Hub')\n   for s in states:\n    if s['packets']:\n     expect(s['packets']['maxBytes']<=16384,'Hub packet too big')\n     expect(s['packets']['maxSecond']<=20,'Hub message rate too high')\n   if params.get('scenario')=='server':\n    host=next(s for s in states if s['server']);expect(len(host['players'])==2,'server phantom seat')\n  check(label,harness_case);page.close()\n # Additional gameplay-state agreement in a hosted session before time-up.\n page=browser.new_page(viewport={'width':1280,'height':900})\n def shared_actions():\n  query=urllib.parse.urlencode({'game':'/'+config['base']+'.html?test=1','players':2,'limit':60})\n  # Use harness automatic flow to release its normal card; inspect traffic mid-run before it ends.\n  query=urllib.parse.urlencode({'game':'/'+config['base']+'.html?test=1','players':2,'auto':1,'play':12})\n  page.goto(base+'/'+urllib.parse.quote(config['base'])+'/vendor/hub/harness.html?'+query)\n  page.wait_for_function(\\\"document.querySelectorAll('iframe').length>=2 && Array.from(document.querySelectorAll('iframe')).every(f=>f.contentWindow.TimeBandit?.snapshot().tick>260)\\\",timeout=25000)\n  frames=[f for f in page.frames[1:] if f.evaluate('\"'!!window.TimeBandit'\"')]\n  host=next(f for f in frames if f.evaluate('AIHub.isHost'))\n  guest=next(f for f in frames if not f.evaluate('AIHub.isHost'))\n  before=host.evaluate('TimeBandit.world.players.find(p=>p.id\"'!==AIHub.me).x'\"')\n  guest.evaluate(\\\"dispatchEvent(new KeyboardEvent('keydown',{code:'ArrowRight',key:'ArrowRight',bubbles:true}))\\\")\n  page.wait_for_timeout(260)\n  guest.evaluate(\\\"dispatchEvent(new KeyboardEvent('keyup',{code:'ArrowRight',key:'ArrowRight',bubbles:true}))\\\")\n  page.wait_for_timeout(200)\n  after=host.evaluate('TimeBandit.world.players.find(p=>p.id\"'!==AIHub.me).x'\"')\n  expect(after>before+10,'remote movement did not reach host')\n  guest.evaluate(\\\"dispatchEvent(new KeyboardEvent('keydown',{code:'Space',key:' ',bubbles:true}))\\\")\n  page.wait_for_timeout(250)\n  expect(host.evaluate(\\\"TimeBandit.world.events.some(e=>e.type==='shot' && e.owner\"'!==AIHub.me)\"),'\"'remote shot absent')\n  guest.evaluate(\\\"dispatchEvent(new KeyboardEvent('keyup',{code:'Space',key:' ',bubbles:true}))\\\")\n  page.wait_for_timeout(200)\n  hs=host.evaluate('TimeBandit.snapshot()');gs=guest.evaluate('TimeBandit.snapshot()');expect(hs['phase']==gs['phase']);expect(hs['score']==gs['score']);expect(len(hs['players'])==len(gs['players']))\n  # An input packet claiming another seat cannot set integrity or score.\n  host_before=host.evaluate('TimeBandit.world.score');guest.evaluate(\\\"AIHub.send({k:'a',n:900000,m:Infinity,x:99999,f:true,b:1,score:999999},{to:AIHub.host,reliable:true})\\\");page.wait_for_timeout(150);expect(host.evaluate('TimeBandit.world.score')==host_before)\n  details['hostedGameplay']={'beforeX':before,'afterX':after,'host':hs,'guest':gs}\n check('Hub remote actions affect the authoritative game and peers converge',shared_actions);page.close()\n # Real standalone rooms: two independent contexts, default public PeerServer, actual RTCDataChannels.\n c1=browser.new_context(viewport={'width':1280,'height':720});c2=browser.new_context(viewport={'width':1280,'height':720})\n host=c1.new_page();guest=c2.new_page();host.set_default_timeout(6000);guest.set_default_timeout(6000)\n for p in [host,guest]:p.goto(game_url+'?test=1');p.wait_for_function(\\\"document.body.dataset.booted==='true'\\\")\n linked=False\n def room_connect():\n  global linked\n  host.get_by_role('button',name='Online co-op',exact=True).click();host.get_by_role('button',name='Create room',exact=True).click()\n  host.wait_for_function('TimeBandit.transport?.peer?.open===true',timeout=23000)\n  code=host.evaluate('TimeBandit.transport.code');details['standalone']['code']=code\n  guest.get_by_role('button',name='Online co-op',exact=True).click();guest.get_by_role('button',name='Join room',exact=True).click();guest.get_by_role('textbox',name='Room code',exact=True).fill(code);guest.get_by_role('button',name='Connect',exact=True).click()\n  guest.wait_for_function('TimeBandit.transport?.me===1 && TimeBandit.transport?.hostLink?.open',timeout=23000)\n  expect(host.evaluate('TimeBandit.transport.roster.length')==2)\n  rtc=guest.evaluate('TimeBandit.transport.hostLink.peerConnection.connectionState');expect(rtc=='connected',rtc)\n  details['standalone']['rtcState']=rtc;linked=True\n check('standalone Create/Join uses real PeerJS/WebRTC data handshake',room_connect)\n if linked:\n  def room_play():\n   guest.get_by_role('button',name='Ready / Not ready',exact=True).click();host.wait_for_function('TimeBandit.transport.roster.every(p=>p.ready)')\n   host.get_by_role('button',name='Start campaign',exact=True).click();guest.wait_for_function(\\\"TimeBandit.world?.phase==='playing'\\\")\n   before=host.evaluate('TimeBandit.world.players[1].x');guest.keyboard.down('ArrowRight');guest.wait_for_timeout(300);guest.keyboard.up('ArrowRight');guest.wait_for_timeout(200);expect(host.evaluate('TimeBandit.world.players[1].x')>before+10)\n   guest.keyboard.down('Space');guest.wait_for_timeout(250);guest.keyboard.up('Space');expect(host.evaluate(\\\"TimeBandit.world.events.some(e=>e.type==='shot'&&e.owner===1)\\\"))\n   host_state=host.evaluate('TimeBandit.snapshot()');guest.wait_for_timeout(200);guest_state=guest.evaluate('TimeBandit.snapshot()');expect(host_state['phase']==guest_state['phase']);expect(host_state['players'][1]['hp']==guest_state['players'][1]['hp'])\n   details['standalone']['play']={'host':host_state,'guest':guest_state}\n  check('standalone ready/start, remote movement/fire and shared integrity',room_play)\n  def room_results_replay():\n   # Trigger loss through actual hostile collisions; test tools may set encounter fixtures.\n   host.evaluate(\\\"(()=>{const w=TimeBandit.world;for(const p of w.players){p.hp=1;p.inv=0;w.threats.push({id:90000+p.id,kind:'dart',x:p.x,y:p.y,px:p.x,py:p.y,vx:0,vy:0,age:0,warn:0,state:'air',target:p.id,tx:p.x,ty:p.y,r:5,life:1,ground:false});}})()\\\")\n   host.wait_for_function(\\\"TimeBandit.world.phase==='results'\\\");guest.wait_for_function(\\\"TimeBandit.world.phase==='results'\\\");expect(host.evaluate('TimeBandit.world.score')==guest.evaluate('TimeBandit.world.score'))\n   host.get_by_role('button',name='Return to room / Replay',exact=True).click();guest.wait_for_function(\\\"TimeBandit.ui.screen==='room'\\\")\n   guest.get_by_role('button',name='Ready / Not ready',exact=True).click();host.wait_for_function('TimeBandit.transport.roster.every(p=>p.ready)');host.get_by_role('button',name='Start campaign',exact=True).click();guest.wait_for_function('TimeBandit.transport.run===2 && TimeBandit.world.tick>0')\n   expect(host.evaluate('TimeBandit.world.players.every(p=>p.hp===3)'))\n  check('standalone shared loss, results and replay with same roster',room_results_replay)\n  def guest_leave():\n   guest.evaluate('TimeBandit.leaveRoom()');host.wait_for_function('TimeBandit.transport.roster.length===1');expect(host.evaluate('TimeBandit.world.players[1].connected===false'))\n  check('standalone guest departure removes its active cannon',guest_leave)\n  def host_leave():\n   # Rejoin in the lobby and then close the host link.\n   host.evaluate('TimeBandit.transport.lobby()');guest.evaluate(\\\"TimeBandit.connectRoom(false,'\\\"+details['standalone']['code']+\\\"')\\\");guest.wait_for_function('TimeBandit.transport?.me===1',timeout=23000);host.evaluate('TimeBandit.leaveRoom()');guest.wait_for_function('TimeBandit.snapshot().terminated===true');expect(guest.get_by_role('button',name='Return to solo',exact=True).is_visible());guest.get_by_role('button',name='Return to solo',exact=True).click();expect(guest.evaluate(\\\"TimeBandit.ui.screen==='title'\\\"))\n  check('standalone host departure ends run and offers solo fallback',host_leave)\n else:\n  details['standalone']['externalLimitation']=host.locator('.esh-mod').inner_text() if host.locator('.esh-mod').count() else 'Public signaling unavailable.'\n def failed_join():\n  guest.evaluate('TimeBandit.leaveRoom()');guest.evaluate(\\\"TimeBandit.connectRoom(false,'ZZZZZZZZ')\\\");guest.wait_for_function(\\\"document.body.textContent.includes('No room with that code') || document.body.textContent.includes('timed out') || document.body.textContent.includes('failed')\\\",timeout=25000)\n  expect(not guest.evaluate('TimeBandit.transport?.hostLink?.open===true'));expect(guest.get_by_role('button',name='Leave room / Solo',exact=True).is_visible())\n  guest.get_by_role('button',name='Leave room / Solo',exact=True).click();expect(guest.evaluate(\\\"TimeBandit.ui.screen==='title'\\\"))\n check('failed standalone join reports error and returns to solo',failed_join)\n c1.close();c2.close();browser.close()\nserver.shutdown();server.server_close()\nprint(json.dumps({'results':results,'details':details}))\nEOF\nnode tools/test.mjs network\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
