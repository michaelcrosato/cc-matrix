{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"cat > tests/browser.py <<'EOF'\nimport json,traceback\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nroot=Path(__file__).resolve().parents[1]\nconfig=json.loads((root.parent/'build-config.json').read_text())\nartifact=root.parent/(config['base']+'.html')\nresults=[];details={};captures=[]\ndef check(name,fn):\n try:\n  value=fn();results.append({'name':name,'pass':True});return value\n except Exception:\n  results.append({'name':name,'pass':False,'error':traceback.format_exc()});return None\ndef expect(value,message='assertion failed'):\n if not value:raise AssertionError(message)\ndef advance(p,s=.025,draw=True):return p.evaluate('([s,d])=>game.advance(s,{draw:d})',[s,draw])\ndef key(p,k,s=.025):\n p.keyboard.down(k);advance(p,s);p.keyboard.up(k);advance(p,.025)\ndef capture(p,name):\n p.evaluate('game.advance(0,{draw:true})');p.screenshot(path=str(root/'artifacts'/name));captures.append(name)\npad_script=\\\"\\\"\\\"window.__pad={id:'DualSense Wireless Controller',index:0,connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0})),timestamp:1};Object.defineProperty(navigator,'getGamepads',{value:()=>window.__pad?[window.__pad]:[]});\\\"\\\"\\\"\nwith sync_playwright() as pw:\n browser=pw.chromium.launch(headless=True,args=['--autoplay-policy=no-user-gesture-required'])\n context=browser.new_context(viewport={'width':1920,'height':1080})\n context.add_init_script(pad_script)\n page=context.new_page();errors=[];requests=[]\n page.on('pageerror',lambda e:errors.append(str(e)))\n page.on('request',lambda r:requests.append(r.url))\n page.goto(artifact.as_uri()+'?test=1');page.wait_for_function(\\\"document.body.dataset.booted==='true'\\\");page.evaluate('game.stop()')\n check('packaged file boot, inline dependencies, 10% music',lambda:(expect(page.evaluate('game.errors.length===0 && game.W===640 && game.H===360 && game.settings.music===.1')),expect(not any('/src/' in u or '/vendor/' in u for u in requests))))\n def title_fit():\n  capture(page,'title.png')\n  boxes=page.locator('.esh-ttl .esh-btns button').evaluate_all('(es)=>es.map(e=>{const b=e.getBoundingClientRect();return [b.top,b.bottom]})')\n  expect(len(boxes)==5);expect(all(0<=top<bottom<=1080 for top,bottom in boxes),'title actions clipped '+str(boxes))\n check('TV title shows every action and selected focus',title_fit)\n def keyboard_start():\n  key(page,'Enter');expect(page.evaluate(\\\"TimeBandit.ui.screen==='setup'\\\"));key(page,'Enter');expect(page.evaluate(\\\"TimeBandit.snapshot().scene==='play'\\\"));advance(page,7);expect(page.evaluate('TimeBandit.world.enemies.length===18 && TimeBandit.world.phase===\\\\'playing\\\\''));capture(page,'early-combat.png')\n check('keyboard starts actual campaign and curved fleet arrives',keyboard_start)\n def movement_fire():\n  before=page.evaluate('TimeBandit.world.players[0].x');key(page,'d',.25);after=page.evaluate('TimeBandit.world.players[0].x');expect(after>before+40)\n  key(page,'Space',.1);expect(page.evaluate(\\\"TimeBandit.world.events.some(e=>e.type==='shot'&&e.owner===0)\\\"));expect(page.evaluate('TimeBandit.world.shots.length<=1'))\n check('keyboard horizontal movement and held fire',movement_fire)\n def pointer_control():\n  page.mouse.move(1500,850);advance(page,.3);target=page.evaluate('TimeBandit.world.players[0].x');expect(target>230)\n  key(page,'a',.2);x=page.evaluate('TimeBandit.world.players[0].x');advance(page,.15);expect(abs(page.evaluate('TimeBandit.world.players[0].x')-x)<1,'old pointer stole control')\n  page.mouse.move(1502,850);advance(page,.1);expect(abs(page.evaluate('TimeBandit.world.players[0].x')-x)<1,'mouse jitter stole control')\n  page.mouse.move(1710,850);advance(page,.2);expect(page.evaluate('TimeBandit.world.players[0].x')>x+25)\n  page.mouse.down();advance(page,.1);page.mouse.up();expect(page.evaluate(\\\"TimeBandit.world.events.some(e=>e.type==='shot')\\\"))\n check('mouse targets cannon x, keyboard overrides, jitter ignored',pointer_control)\n def pad_play():\n  page.evaluate('window.__pad.axes[0]=.85');advance(page,.2);x=page.evaluate('TimeBandit.world.players[0].x');expect(page.evaluate(\\\"game.input.lastDevice==='gamepad'\\\"))\n  page.evaluate('window.__pad.axes[0]=0;window.__pad.buttons[0]={pressed:true,value:1}');advance(page,.1);page.evaluate('window.__pad.buttons[0]={pressed:false,value:0}');advance(page,.02)\n  page.evaluate('TimeBandit.world.brake=100;window.__pad.buttons[2]={pressed:true,value:1}');advance(page,.03);page.evaluate('window.__pad.buttons[2]={pressed:false,value:0}');advance(page,.025);expect(page.evaluate('TimeBandit.world.stats.brakes===1'))\n  capture(page,'brake.png')\n  key(page,'a',.1);expect(page.evaluate(\\\"game.input.lastDevice==='keyboard'\\\"));advance(page,.05);expect(page.evaluate(\\\"game.input.lastDevice==='keyboard'\\\"),'idle pad stole prompts')\n check('standard gamepad movement, fire, brake and modality',pad_play)\n def pause_dev():\n  key(page,'Escape');expect(page.evaluate('game.paused && TimeBandit.ui.screen===\\\\'pause\\\\''));tick=page.evaluate('TimeBandit.world.tick');advance(page,.2);expect(page.evaluate('TimeBandit.world.tick')==tick)\n  page.get_by_role('button',name='Dev Mode',exact=True).click();expect(page.evaluate('TimeBandit.world.modified'))\n  before=page.evaluate('TimeBandit.world.tick');page.get_by_role('button',name='Step one tick',exact=True).click();expect(page.evaluate('TimeBandit.world.tick')==before+1);expect(page.evaluate('game.paused'))\n  page.get_by_role('button',name='Live tuning sliders',exact=True).click();slider=page.get_by_role('slider',name='Machine speed',exact=True);slider.fill('300');slider.dispatch_event('input');expect(page.evaluate('TimeBandit.world.tuning.playerSpeed===300'))\n  persisted=page.evaluate(\\\"My3D2dge.store.get(game.settings._key,{}).values||{}\\\")\n  expect(not any(k.startswith('dev_') for k in persisted),'dev tuning leaked into saved settings')\n  page.get_by_role('button',name='Reset tuning to defaults',exact=True).click();expect(page.evaluate('TimeBandit.world.tuning.playerSpeed===220'))\n  page.get_by_role('button',name='Back',exact=True).click();page.get_by_role('button',name='Jump to encounter',exact=True).click();page.get_by_role('button',name='08 · The final invoice',exact=True).click();advance(page,8);expect(page.evaluate('TimeBandit.world.wave===7'))\n  capture(page,'all-threat-combat.png')\n check('native pause, dev tick, live sliders, persistence, reset and wave jump',pause_dev)\n def pad_menus():\n  key(page,'Escape');page.get_by_role('button',name='Settings',exact=True).click();page.get_by_role('button',name='Controls',exact=True).click()\n  b=page.get_by_role('button',name='Button symbols:',exact=False);b.focus();page.evaluate(\\\"game.settings.set('glyphs','xbox');game.shell.show('controls')\\\")\n  expect(page.evaluate(\\\"game.input.label('fire','gamepad')==='A'\\\"))\n  page.evaluate(\\\"game.settings.set('glyphs','playstation')\\\");expect(page.evaluate(\\\"game.input.label('fire','gamepad')==='✕'\\\"))\n  # Use native controller focus/confirm/back rather than DOM click.\n  initial=page.evaluate('document.activeElement.textContent');page.evaluate('window.__pad.buttons[13]={pressed:true,value:1}');advance(page,.025);page.evaluate('window.__pad.buttons[13]={pressed:false,value:0}');advance(page,.025);expect(page.evaluate('document.activeElement.textContent')\"'!=initial)\n  page.evaluate('\"'window.__pad.buttons[1]={pressed:true,value:1}');advance(page,.025);page.evaluate('window.__pad.buttons[1]={pressed:false,value:0}');advance(page,.025);expect(page.evaluate(\\\"TimeBandit.ui.screen==='settings'\\\"))\n  page.evaluate('game.shell.hide();game.resume()');advance(page,.025)\n check('gamepad focus, back and PlayStation/Xbox glyphs',pad_menus)\n def boss_results():\n  page.evaluate('TimeBandit.openDev()');page.get_by_role('button',name='Jump to encounter',exact=True).click();page.get_by_role('button',name='Boss 3 · Overtime',exact=True).click();advance(page,3);capture(page,'boss.png')\n  # A separate natural loss uses damage; it is not the whole-campaign success test.\n  page.evaluate('TimeBandit.startSolo(false)');advance(page,3)\n  for i in range(3):\n   page.evaluate(\\\"(()=>{const w=TimeBandit.world,p=w.players[0];p.inv=0;w.threats.push({id:9000+w.tick,kind:'dart',x:p.x,y:p.y,px:p.x,py:p.y,vx:0,vy:0,age:0,warn:0,state:'air',target:p.id,tx:p.x,ty:p.y,r:5,life:1,ground:false});})()\\\");advance(page,.025)\n  expect(page.evaluate(\\\"TimeBandit.world.outcome && \"'!TimeBandit.world.outcome.won && TimeBandit.ui.screen==='\"'results'\\\"));capture(page,'failure.png');page.get_by_role('button',name='Retry campaign',exact=True).click();advance(page,.025);expect(page.evaluate('TimeBandit.world.players[0].hp===3 && \"'!TimeBandit.world.outcome'\"'))\n check('boss screen, actual damage loss and immediate retry',boss_results)\n def records():\n  page.evaluate('TimeBandit.world.score=120;TimeBandit.world.phase=\\\"results\\\";TimeBandit.world.outcome={won:true};TimeBandit.showResults()');page.get_by_role('button',name='Save six-letter record',exact=True).click();expect(page.locator('.esh-btns button').count()==8);page.get_by_role('button',name='Keep PILOTX',exact=True).click();expect(page.evaluate('TimeBandit.getRecords()[0].name===\\\\'PILOTX\\\\''));expect(page.evaluate('TimeBandit.getRecords()[0].mode===\\\\'solo\\\\''));page.evaluate('TimeBandit.showResults()');capture(page,'results.png')\n check('six-character controller picker saves labeled local record',records)\n def about():\n  page.evaluate('TimeBandit.showCredits(1)');expect(page.get_by_text('added on import',exact=True).is_visible());capture(page,'credits.png')\n  for title in ['Testing Feedback','Engine Feedback','Prompt Feedback']:\n   page.get_by_role('button',name='Next page',exact=True).click();expect(page.get_by_role('heading',name=title,exact=True).is_visible())\n check('all four required information groups accessible in credits',about)\n def attract():\n  before=page.evaluate('JSON.stringify(TimeBandit.getRecords())');page.evaluate('TimeBandit.title()');advance(page,9.8);expect(not page.evaluate('TimeBandit.snapshot().demo'));advance(page,.3);expect(page.evaluate('TimeBandit.snapshot().demo'))\n  advance(page,76,False);seen=page.evaluate('TimeBandit.world.seen');expect(all(x in seen for x in ['dart','mine','roller','hunter','boss2']),str(seen));expect(page.evaluate('JSON.stringify(TimeBandit.getRecords())')==before)\n  key(page,'Enter');expect(page.evaluate(\\\"TimeBandit.ui.screen==='title' && TimeBandit.world===null\\\"),'wake was not consumed')\n  for device in ['mouse','pad']:\n   page.evaluate('TimeBandit.startAttract()');advance(page,.03)\n   if device=='mouse':page.mouse.move(250,300)\n   else:page.evaluate('window.__pad.axes[0]=.8');advance(page,.025);page.evaluate('window.__pad.axes[0]=0')\n   advance(page,.025);expect(page.evaluate(\\\"TimeBandit.ui.screen==='title' && \"'!TimeBandit.snapshot().demo\"))\n check('\"'10-second attract, all threat showcase, wake consumption, saved-state isolation',attract)\n def focus_disconnect():\n  page.evaluate('TimeBandit.startSolo(false)');advance(page,2.1);page.evaluate(\\\"window.dispatchEvent(new Event('blur'))\\\");advance(page,.025);expect(page.evaluate('game.paused && game.pauseReason===\\\\'focus\\\\''));page.evaluate('game.shell.hide();game.resume();window.__pad.axes[0]=.8');advance(page,.03);page.evaluate('window.__pad=null');advance(page,.03);expect(page.evaluate('game.paused'))\n check('solo focus loss and controller disconnect pause safely',focus_disconnect)\n def audio():\n  page.evaluate('TimeBandit.sound.unlock()');signal=page.evaluate('TimeBandit.audioSignalCheck()');details['audio']=signal;expect(signal['finite'] and .001<signal['peak']<1 and signal['rms']>.001)\n  expect(page.evaluate('game.settings.music===.1'));page.evaluate(\\\"game.settings.set('voice',0);game.settings.set('effects',0);game.settings.set('music',0);game.settings.set('sound',false)\\\");expect(page.evaluate(\\\"game.audio.bus('voice').gain.value===0 && game.audio.bus('sfx').gain.value===0 && game.audio.bus('music').gain.value===0 && game.audio.bus('master').gain.value===0\\\"));page.evaluate('TimeBandit.sound.end()');expect(page.evaluate('TimeBandit.sound.nodes.length===0 && \"'!game.audio.song'\"'))\n check('offline audio signal, 10% default, independent buses and terminal silence',audio)\n check('no Chromium runtime exceptions',lambda:expect(not errors,str(errors)))\n context.close()\n # Corrupt storage is isolated in a fresh page.\n c=browser.new_context();c.add_init_script(\\\"Object.defineProperty(window,'localStorage',{get(){throw new Error('blocked storage')}})\\\")\n p=c.new_page();p.goto(artifact.as_uri()+'?test=1');p.wait_for_function(\\\"document.body.dataset.booted==='true'\\\");check('unavailable storage survives boot and settings',lambda:expect(p.evaluate('game.errors.length===0 && game.settings.music===.1')));c.close()\n # Touch profile: canonical arena, simultaneous drag and context brake, pointercancel.\n touch=browser.new_context(**pw.devices['iPhone 13']);p=touch.new_page();p.goto(artifact.as_uri()+'?test=1');p.wait_for_function(\\\"document.body.dataset.booted==='true'\\\");p.evaluate('game.stop();TimeBandit.startSolo(false);game.advance(2.1,{draw:true})')\n def touch_play():\n  expect(p.evaluate('TimeBandit.world.assists.autoFire && game.W===640 && game.H===360'))\n  p.evaluate(\\\"(()=>{const c=document.getElementById('screen'),r=c.getBoundingClientRect();for(const [type,x] of [['pointerdown',100],['pointermove',160]])c.dispatchEvent(new PointerEvent(type,{pointerId:7,pointerType:'touch',clientX:x,clientY:420,bubbles:true}));})()\\\")\n  advance(p,.1);p.evaluate('TimeBandit.world.brake=100');advance(p,.025);expect(p.locator('#touch-brake').is_visible());p.locator('#touch-brake').dispatch_event('pointerdown',{'pointerType':'touch','pointerId':8});advance(p,.025);expect(p.evaluate('TimeBandit.world.stats.brakes===1'))\n  p.evaluate(\\\"document.getElementById('screen').dispatchEvent(new PointerEvent('pointercancel',{pointerId:7,pointerType:'touch',clientX:160,clientY:420,bubbles:true}))\\\");advance(p,.025)\n  capture(p,'touch-portrait.png');p.set_viewport_size({'width':844,'height':390});advance(p,.025);expect(p.evaluate('game.W===640 && game.H===360'));capture(p,'touch-landscape.png')\n check('touch assisted play, simultaneous brake, cancel, portrait and landscape',touch_play)\n def touch_wake():\n  p.evaluate('TimeBandit.title();TimeBandit.startAttract()');advance(p,.025);p.touchscreen.tap(300,180);advance(p,.025);expect(p.evaluate(\\\"\"'!TimeBandit.snapshot().demo && TimeBandit.ui.screen==='\"'title'\\\"))\n check('touch wakes and consumes attract tap',touch_wake);touch.close();browser.close()\n for name in ['webkit','firefox']:\n  engine=getattr(pw,name)\n  try:\n   b=engine.launch(headless=True);p=b.new_page(viewport={'width':1280,'height':720});err=[];p.on('pageerror',lambda e:err.append(str(e)));p.goto(artifact.as_uri()+'?test=1');p.wait_for_function(\\\"document.body.dataset.booted==='true'\\\",timeout=15000);p.evaluate('game.stop();TimeBandit.startSolo(false);game.advance(7,{draw:true})');check(name+' packaged boot, Canvas renderer and keyboard',lambda:expect(p.evaluate('game.errors.length===0 && TimeBandit.world.wave===0 && game.W===640') and not err,str(err)));key(p,'d',.1);expect(p.evaluate('TimeBandit.world.players[0].x')>170);b.close()\n  except Exception:results.append({'name':name+' packaged browser','pass':False,'error':traceback.format_exc()})\nreport={'results':results,'details':details,'captures':captures}\nprint(json.dumps(report))\nEOF\nnode tools/test.mjs browser\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
