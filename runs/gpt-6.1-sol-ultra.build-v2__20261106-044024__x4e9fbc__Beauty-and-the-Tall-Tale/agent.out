n this._clickAt; }\n  /** how far the touch stick's finger moved since the last step, in screen pixels [dx, dy] (the HUD's space), or null while\n   *  no finger holds it: to steer one to one (a shooter's ship follows the thumb) instead of by the stick's direction */\n  drag() { return this._drag || null; }\n  /** the camera zoom the player asked for since the last step, as a factor (1.1: 10% closer, .9: farther; 1: none): the\n   *  wheel, - and = and a pinch, where the scene lets them zoom. The game applies it (game.zoomBy) */\n  zoom() { return this._zoomNow; }\n  /** the mouse pointer in screen pixels [x, y] (the HUD's space), or null before it has moved over the canvas */\n  pointer() { return this._fedAt || (this.mouse.active ? this.screenPoint(this.mouse.cx, this.mouse.cy) : null); }\n  /** the pointer's gestures, read each step in screen pixels (the HUD's space), from a mouse or one finger:\n   *  box() -> { x0, y0, x1, y1, from, to, done } while a box is drawn (a mouse's left button dragged; on a touch screen a long\n   *  press, then a drag), done the step it is let go; else null */\n  box() { return this._boxAt; }\n  /** [x, y] the step a press held still has been held .45 s (a long press), else null */\n  longPress() { return this._longAt; }\n  /** [x, y] the step a second tap or click lands within .35 s and 8 pixels of the first (a double tap), else null */\n  doubleTap() { return this._tap2At; }\n  /** [dx, dy] how far a drag moved this step: one finger on open ground (not a box), or a mouse's middle or right button;\n[\n  {\n    \"name\": \"file: build identity / no runtime downloads\",\n    \"pass\": true,\n    \"detail\": \"\"\n  },\n  {\n    \"name\": \"file: native Canvas image is nonblank\",\n    \"pass\": true,\n    \"detail\": \"1072 sampled colors\"\n  },\n  {\n    \"name\": \"how-to: real title action opens instructions\",\n    \"pass\": true,\n    \"detail\": \"\"\n  },\n  {\n    \"name\": \"play: title confirm does not also jump\",\n    \"p