ot(page)[\"sim\"][\"tick\"] > tick + 1,\n            )\n            page.keyboard.press(\"Escape\")\n            advance(page, 0.03)\n            page.get_by_role(\"button\", name=\"Settings\", exact=True).click()\n            check(\n                \"settings: native sound, comfort and gameplay controls\",\n                \"Music\" in page.locator(\".esh-sh\").inner_text()\n                and \"High-contrast hazard outlines\"\n                in page.locator(\".esh-sh\").inner_text(),\n            )\n            page.evaluate(\n270:                \"TallTale.Audio.diagnostic(window.OfflineAudioContext || window.webkitOfflineAudioContext)\"\n273:                \"audio: offline synthesis has finite nonzero samples and mute\",\n","exit_code":0,"status":"completed"}}
