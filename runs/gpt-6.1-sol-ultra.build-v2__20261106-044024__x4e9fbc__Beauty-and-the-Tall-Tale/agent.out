{"type":"item.started","item":{"id":"item_112","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('tools/check-browser.py');s=p.read_text();old=\\\"const i={};for(const p of s.actors)i[p.id]=s.botIntent(p.id);s.step(1/120,i);}a.visual.update(.08,s);a.game.advance(.01,{draw:true});\\\";new=\\\"const i=s.botIntent(1),p=a.game.input;for(const [key,v]of Object.entries({left:i.x<-.1,right:i.x>.1,up:i.up,down:i.down,jump:i.jump}))p.hold(key,v);if(i.jumpPressed)p.tap('jump');a.game.advance(1/120,{draw:false});}a.game.input.clear();a.game.advance(.01,{draw:true});\\\";assert old in s;s=s.replace(old,new);p.write_text(s)\nPY\nruff format tools/check-browser.py\n/home/micha/.local/share/pipx/venvs/playwright/bin/python tools/check-browser.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
