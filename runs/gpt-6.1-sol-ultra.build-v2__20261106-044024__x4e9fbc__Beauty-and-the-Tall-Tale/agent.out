{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"/home/micha/.local/share/pipx/venvs/playwright/bin/python - <<'PY'\nfrom playwright.sync_api import sync_playwright\nfrom pathlib import Path\nimport json\nroot=Path.cwd();url=(root.parent/(json.loads((root/'build-identity.json').read_text())['basename']+'.html')).as_uri()\nwith sync_playwright() as p:\n b=p.chromium.launch(headless=True);page=b.new_page();page.goto(url);page.wait_for_function('window.TallTaleApp?.state.ready&&\"'!TallTaleApp.game._booting'\"');page.evaluate('TallTaleApp.game.stop()');page.get_by_role('button',name='Climb solo',exact=False).click();page.get_by_role('button',name='Let’s climb',exact=False).click();print(page.evaluate('''()=>{const a=TallTaleApp,g=a.game;g.advance(.3,{draw:false});let out=[];for(let k=0;k<1500;k++){const s=a.state.sim,i=s.botIntent(1),p=g.input;for(const [act,v]of Object.entries({left:i.x<-.1,right:i.x>.1,up:i.up,down:i.down,jump:i.jump}))p.hold(act,v);if(i.jumpPressed)p.tap('jump');g.advance(1/120,{draw:false});if(k%120===0)out.push({k,i,body:[s.actors[0].body.x,s.actors[0].body.z],tr:s.actors[0].traversal,w:s.windows[0],mode:a.state.mode,screen:a.ui.screen,inp:[p.down('up'),p.down('right')]});}return out}'''));b.close()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
