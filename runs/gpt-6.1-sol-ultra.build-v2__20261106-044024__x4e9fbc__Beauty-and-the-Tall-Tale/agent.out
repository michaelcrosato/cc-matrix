.scene;\n    if (s && s.pausable && this.input.pressed('pause')) { this.paused = !this.paused; this.pauseReason = this.paused ? 'player' : null; this.audio.sfx('pause'); }\n    if (!this.paused) { this.pauseReason = null; this._goOn = false; }\n    this.audio._duck(this.paused);\n    // the player's zoom: the wheel, - and = and a pinch ask for it while a scene that allows it plays (input.zoom())\n    const I = this.input, zr = !this.paused && !(this.shell && this.shell.screen) && !!this.zoomRange();\n    I._zoomOn = zr; I._wheelOn = zr && (this._camera() || {}).wheel !== false;\n    if (this._zoomTo && !I._pinching && this._wall - this._zoomAt > .25) this._zoomApply();   // they stopped: the new zoom, drawn crisp\n    if (this.paused && !this.live && !this._goOn) return;   // (live: the world steps on under the menu)\n    if (!this.paused) { this._zoomFit(); const zk = I.zoom(); if (zk !== 1) this.zoomBy(zk); }\n    if (this.hitstop > 0) { this.hitstop -= dt; return; }\n    this.time += dt;\n    this.audio._tick(true);   // (a synced song: on game.time, it waits with the game)\n    const T = this._timers;\n    if (T.length) {\n      for (let i = 0; i < T.length; i++) { const t = T[i]; if (t.dead || this.time < t.at) continue; if (t.every) t.at += t.every; else t.dead = true; t.fn(); }\n      prune(T, t => t.dead);\n    }\n    for (const f of HOOKS.step) f(this, dt);\n    this._ownRun('step', dt);\n    if (s && s.update) s.update(dt);\n    const f = this._follow;\n    if (f && f.target) {\n30:game.start({ update(dt) { hero.vx = game.input.move()[0] * 80; if (game.input.pressed('jump')) hero.jump(210); hero.update(dt); }, draw() {} });\n97:- 1512 Module mode7: a perspective floor drawn a row at a time, a sky that turns with it, everything on it scaled by its distance (engine/modules/mode7.js); E.Mode7: mode7\n106:- 1744 Module terrain: destructible ground in the side plane: carved and added, walked on, drawn in chunks (engine/modules/terrain.js); E.Terrain: terrain\n121:- `E.HEIGHTS: eye, chest, level, step`: the numbers of THE HEIGHT RULES, which collision, standing, sight, reach, navigation and drawing all read (API.md, \"Heights\", and the API index's head give the  [... omitted end of long line]\n170:- `E.mkCanvas(w, h)`: a new canvas of w x h pixels (scratch images and sprite sheets). With no document (Node: a headless game) a stand-in whose drawing does nothing, so sprites and other images made  [... omitted end of long line]\n198:- `px.blend(g, a, mode, fn)`: draw fn() at alpha a (stepped, like PS1 hardware) with a blend mode: 'normal', 'add', 'multiply', 'screen' (E.style.trans = 'dither' dithers instead)\n209:- `px.reset(g)`: forget the color cache (after drawing on g with the canvas API directly)\n210:- `px.sprite(g, spr, x, y, flip = false)`: draw a sprite with its top-left corner at buffer pixel (x, y). flip mirrors it left-right; or o: { flip, rot (radians, turned about its center: E.rotSprite), [... omitted end of long line]\n211:- `E.sprite(rows, colors = {}, scale = 1)`: Pixel sprite written as strings. Each character is one pixel; colors maps a character to a hex color; '.' and ' ' are transparent. scale (whole number) enla [... omitted end of long line]\n216:- `E.anim(frames, fps = 8, o = {})` †: frames to play: anim([spr1, spr2, spr3], fps = 8, { loop: true, pingpong: false }), or anim(sheet, 8, { frames: 4 }) for several frames side by side in one sprit [... omitted end of long line]\n218:- `E.rotSprite(spr, a, steps = 16)` †: the sprite turned by angle a (radians; the way the world's angles turn, so a ship drawn facing east turns to its facing): nearest-neighbour, whole pixels, about  [... omitted end of long line]\n222:- `E.VIEWS: iso, threequarter, topdown, brawler, side, overhead`: the ready-made views: iso (yaw 45, pitch 30), threequarter (pitch 55), topdown (80), brawler (25), side (0) and overhead (90, scale 1: [... omitted end of long line]\n223:- `E.VIEW_ORDER: iso, threequarter, topdown, brawler, side`: the order game.nextView() cycles through when a game doesn't set game.views ('overhead' is left out)\n245:- `E.charView(view)`: the view a rig in `view` is drawn from (the sprite-like angle above; the view itself outside pitch 40-89)\n250:- `game.screen.clear` †: true when the game's bg is null (or 'transparent'): the buffer and the canvas are cleared instead of filled, so a picture under the canvas shows through the game's (a 3D world [... omitted end of long line]\n258:- `game.screen.buf`: the low-resolution buffer the game draws into (W + 2 by H + 2 pixels; null when headless, a stand-in when a headless game draws: o.draw)\n262:- `game.screen.filter = 'clean'` †: 'clean' | 'scanlines' | 'crt', drawn over the picture as it is presented, never on the buffer, and not under a test harness (navigator.webdriver). game.settings.fil [... omitted end of long line]\n280:- `input.box()` †: the pointer's gestures, read each step in screen pixels (the HUD's space), from a mouse or one finger: box() -> { x0, y0, x1, y1, from, to, done } while a box is drawn (a mouse's le [... omitted end of long line]\n291:- `input.history` †: the last second of input, oldest first: [{ t (input.clock), dir (numpad 1-9 for a fighter facing right: 5 neutral), pressed: the actions pressed then, directions aside }], one ent [... omitted end of long line]\n322:- `input.value(a)` †: how far action a is pressed, 0 to 1: a gamepad button by its travel (the triggers, even short of a press), a stick's direction (PadAxisUp ..., or up / down / left / right on the  [... omitted end of long line]\n\"\"\"Extra packaged controls proof: actual DOM mouse and CDP touch contacts.\"\"\"\n\nimport json\nfrom pathlib import Path\n\nfrom playwright.sync_api import sync_playwright\n\nROOT = Path(__file__).resolve().parents[1]\nID = json.loads((ROOT / \"build-identity.json\").read_text())\nURL = (ROOT.parent / (ID[\"basename\"] + \".html\")).as_uri()\nRESULTS = []\n\n\ndef check(name, condition, detail=\"\"):\n    RESULTS.append({\"name\": name, \"pass\": bool(condition), \"detail\": str(detail)})\n\n\ndef step(page, n=0.1):\n    page.evaluate(\"(n)=>TallTaleApp.game.advance(n,{draw:true})\", n)\n\n\ndef open_page(browser, device=None, init=None):\n    ctx = browser.new_context(\n        **(device or {\"viewport\": {\"width\": 1280, \"height\": 720}})\n    )\n    ctx.route(\n        \"**/*\",\n        lambda r: r.continue_() if r.request.url.startswith(\"file:\") else r.abort(),\n    )\n    page = ctx.new_page()\n    errors = []\n    page.on(\"pageerror\", lambda e: errors.append(str(e)))\n    if init:\n        page.add_init_script(init)\n    page.goto(URL)\n    page.wait_for_function(\"window.TallTaleApp?.state.ready\")\n    page.evaluate(\"TallTaleApp.game.stop()\")\n    return ctx, page, errors\n\n\n","exit_code":0,"status":"completed"}}
