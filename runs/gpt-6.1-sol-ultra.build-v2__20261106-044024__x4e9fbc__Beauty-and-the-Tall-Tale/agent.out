{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"sed -n '2770,2825p' vendor/engine-repo/dist/handoff/my-3d2dge.js && sed -n '1,120p' content/tower.js && ls src\"","aggregated_output":"        // the player's Frame rate (Settings, Display): Full draws every refresh, 60 every other one at 100 Hz and up (a\n        // game made with pace: false draws every refresh unless the player picked 60)\n        let e = this.drawEvery; const fr = this.settings.frameRate;\n        if (fr === 'full' || (this.o.pace === false && fr !== '60') || per > 1 / 85) e = 1;\n        else if (fr === '60') e = per < 1 / 95 ? 2 : 1;\n        else if (cost > per * .8) e = 2;\n        else if (miss > .2) { if (now - full > 1e4) back = 3; e = 2; miss = 0; hold = now + back * 1000; back = Math.min(60, back * 2); }\n        else if (cost < per * .55 && now >= hold) e = 1;\n        if (e < this.drawEvery) full = now;\n        this.drawEvery = e;\n      }\n      acc += raw; if (acc > .5) { this.fps = Math.round(n / acc); this.hz = Math.round(1 / per); acc = 0; n = 0; }   // real time: a slow device reads slow\n    };\n    this._raf = requestAnimationFrame(frame);\n    return this;\n  }\n  /** run the boot (section 10c), then start: the system's checks on the screen, the game's steps one a frame (or all at\n   *  once, headless or with loop: false), waiting for a step's promise, then the loop under the screen until it has drawn */\n  _boot(hooks) {\n    const o = hooks.boot || {}, h = Object.assign({}, hooks); delete h.boot;\n    this._booting = true; this._bootOpt = o;\n    const live = !this.headless && this.o.loop !== false && hooks.boot !== false && typeof document !== 'undefined';\n    const steps = (Array.isArray(o.steps) ? o.steps : []).filter(Boolean).map(x => Array.isArray(x) ? x : [x.label || 'Getting ready', x.run]);\n    if (hooks.boot === false) { BOOT.played = true; const el = typeof document !== 'undefined' && document.getElementById('e3-boot'); if (el) { el.hidden = true; el.style.display = 'none'; } BOOT.el = null; return this.start(h); }\n    let res; this.booted = new Promise(r => { res = r; });\n    if (live) { BOOT._open(this, o); BOOT._checks(this); }\n    const now = () => typeof performance !== 'undefined' ? performance.now() : 0, t0 = now(), n = steps.length;   // (no clock in a bare Node context)\n    let i = 0;\n    const fail = (label, e) => { this._booting = false; this.bootError = e; this.fail('boot step \"' + label + '\"', e); BOOT.fail('boot step \"' + label + '\"', e); res(this); };\n    const next = () => {\n      if (this.disposed) return;\n      while (i < n) {\n        const [label, fn] = steps[i++], s0 = now();\n        if (live) BOOT._step(i, n, label);\n        let r; try { r = typeof fn === 'function' ? fn(this) : null; } catch (e) { fail(label, e); return; }\n        const ok = () => { if (live) BOOT._line('  ' + (i + '. ').padEnd(4), label + ' · ' + Math.round(now() - s0) + ' ms'); };\n        if (r && typeof r.then === 'function') { r.then(() => { ok(); live ? requestAnimationFrame(next) : next(); }, e => fail(label, e)); return; }\n        ok(); if (live) { requestAnimationFrame(next); return; }   // one step a frame: the screen shows each\n      }\n      if (live && o.min && now() - t0 < o.min * 1000) { requestAnimationFrame(next); return; }\n      if (live) BOOT._step(n + 1, n + 1, 'Warming up');\n      this._booting = false; const bg = this._bootGo; this._bootGo = null;\n      if (bg && h.scenes && h.scenes[bg.name]) Object.assign(h, { scene: bg.name, data: bg.data }); else if (bg) warn('go:' + bg.name, 'game.go(\"' + bg.name + '\") in a boot step: no such scene. Scenes: ' + Object.keys(h.scenes || {}).join(', '));\n      this.start(h); res(this);\n    };\n    next();\n    return this;\n  }\n  /** stop the loop; the game keeps its state, and start() resumes it */\n  stop() { this._running = false; if (this._raf != null && typeof cancelAnimationFrame === 'function') cancelAnimationFrame(this._raf); this._raf = null; return this; }\n  /**\n   * end the game for good: stop the loop and remove everything the engine added to the page (its listeners on the window,\n   * the document, the canvas and the buttons, the touch controls, the GPU lighting's canvas) and close the sound. Tests and\n   * tools that make many games call it; the canvas stays\n   */\n  dispose() {\n/* Original authored content for Beauty and the Tall Tale. */\n(() => {\n  const TT = (globalThis.TallTale = globalThis.TallTale || globalThis.TT || {});\n  globalThis.TT = TT;\n  TT.DEFAULTS = Object.freeze({\n    run: 95, jump: 200, gravity: 1000, climbTime: 0.72,\n    windowOpen: 6.2, windowWarning: 1.1, hazardCadence: 1,\n    hazardSpeed: 1, heartDuration: 6,\n  });\n  const W = (prefix, floor, xs, delay = 0) => xs.map((x, order) => ({\n    id: `${prefix}-window-${floor}-${order}`, floor, x,\n    z: 16 + floor * 48, toZ: 64 + floor * 48, order, delay,\n  }));\n  const H = (id, type, floor, after, side = 1, extra = {}) => ({\n    id, type, floor, after, side, telegraph: 1.15, repeat: 16,\n    speed: type === \"rat\" ? 32 : type === \"bird\" ? 58 : type === \"bat\" ? 46 : 40,\n    ...extra,\n  });\n  const Heart = (id, floor, x, after = 1.2, extra = {}) => ({\n    id, floor, x, after, repeat: 18, life: 12, ...extra,\n  });\n  TT.CONTENT = {\n    version: 1, width: 320, floorHeight: 48, baseZ: 16, chanceCap: 5,\n    score: { heart: 50, smash: 50, section: 100, rescue: 500, clean: 25, team: 25 },\n    sections: [\n      {\n        id: \"street\", name: \"The Mutton Building\", subtitle: \"A SMALL FELLOW. A VERY TALL PROBLEM.\",\n        inset: 0, floors: 4, exitX: 248, startX: 48,\n        palette: { brick: \"#b76e5b\", shadow: \"#74434e\", trim: \"#ead7a4\", sky: \"#365a70\" },\n        banner: \"SMALL FELLA. BIG AMBITION.\", line: \"Hank: I eat stairs for breakfast!\",\n        windows: [...W(\"street\", 0, [88, 232], 0), ...W(\"street\", 1, [244, 88], 1.8),\n          ...W(\"street\", 2, [92, 228], 3.2), ...W(\"street\", 3, [232, 88], 5.1)],\n        bumpers: [{ id: \"street-bumper\", x: 290, floor: 3, mode: \"reverse\" }],\n        spawns: [H(\"first-stone\", \"boulder\", 0, 5.5, 1, { speed: 32, repeat: 20 }),\n          H(\"first-rat\", \"rat\", 1, 0.3, -1), H(\"rush-stone\", \"boulder\", 1, 3.0, 1),\n          H(\"street-stone\", \"boulder\", 2, 1, 1), H(\"street-rat\", \"rat\", 3, 0.5, -1),\n          H(\"street-high-stone\", \"boulder\", 3, 5, 1)],\n        hearts: [Heart(\"first-heart\", 1, 150, 0.4), Heart(\"street-high-heart\", 3, 154, 2.5)],\n      },\n      {\n        id: \"awning\", name: \"The Awning District\", subtitle: \"MIND THE BOUNCE. MIND THE DROP.\",\n        inset: 16, floors: 4, exitX: 88, startX: 64,\n        palette: { brick: \"#a17371\", shadow: \"#55465f\", trim: \"#d9cfa9\", sky: \"#3e506b\" },\n        banner: \"THAT BIG LUG IS RUNNING OUT OF UP!\", line: \"Mabel: His hat is full of gravel!\",\n        windows: [...W(\"awning\", 0, [232, 88], 0.3), ...W(\"awning\", 1, [88, 232], 2.6),\n          ...W(\"awning\", 2, [224, 96], 4.1), ...W(\"awning\", 3, [96, 224], 6.8)],\n        bumpers: [{ id: \"bounce-a\", x: 116, floor: 0, mode: \"reverse\", next: \"drop-a\" },\n          { id: \"drop-a\", x: 270, floor: 0, mode: \"drop\" },\n          { id: \"crack-a\", x: 160, floor: 1, mode: \"split\" }],\n        spawns: [H(\"bumper-lesson\", \"bumper\", 0, 0.3, 1, { bumper: \"bounce-a\", speed: 54, repeat: 18 }),\n          H(\"split-lesson\", \"split\", 1, 0.4, -1, { bumper: \"crack-a\", speed: 48 }),\n          H(\"bird-lesson\", \"bird\", 2, 0.6, 1, { repeat: 13 }),\n          H(\"awning-rat\", \"rat\", 3, 0.2, 1), H(\"awning-bird\", \"bird\", 3, 5, -1)],\n        hearts: [Heart(\"awning-heart\", 0, 170, 1.2), Heart(\"awning-high-heart\", 2, 154, 2.5)],\n      },\n      {\n        id: \"twilight\", name: \"The Last Few Ledges\", subtitle: \"EVEN THE BATS HAVE HEARD ABOUT YOU.\",\n        inset: 32, floors: 4, exitX: 232, startX: 80,\n        palette: { brick: \"#64758a\", shadow: \"#394658\", trim: \"#c4c5b3\", sky: \"#253749\" },\n        banner: \"HE'S TALL. YOU'RE TALLER IN SPIRIT.\", line: \"Hank: Who ordered all these elbows?!\",\n        windows: [...W(\"twilight\", 0, [96, 224], 1.1), ...W(\"twilight\", 1, [224, 96], 3.2),\n          ...W(\"twilight\", 2, [104, 216], 5.1), ...W(\"twilight\", 3, [216, 104], 7.2)],\n        bumpers: [{ id: \"upper-crack\", x: 160, floor: 2, mode: \"split\" },\n          { id: \"upper-bounce\", x: 112, floor: 3, mode: \"reverse\", next: \"upper-drop\" },\n          { id: \"upper-drop\", x: 256, floor: 3, mode: \"drop\" }],\n        spawns: [H(\"bat-lesson\", \"bat\", 0, 0.3, 1, { repeat: 13 }),\n          H(\"upper-bird\", \"bird\", 1, 0.4, -1), H(\"upper-rat\", \"rat\", 1, 5.5, 1),\n          H(\"upper-split\", \"split\", 2, 0.4, 1, { bumper: \"upper-crack\" }),\n          H(\"upper-bat\", \"bat\", 2, 4.5, -1),\n          H(\"upper-bumper\", \"bumper\", 3, 0.5, 1, { bumper: \"upper-bounce\", speed: 48 })],\n        hearts: [Heart(\"upper-heart\", 0, 158, 0.5), Heart(\"upper-high-heart\", 2, 156, 2.5)],\n      },\n      {\n        id: \"roof\", name: \"Hank's Last Stand\", subtitle: \"THREE MORE LEDGES. ONE VERY SMALL EGO.\",\n        inset: 40, floors: 3, exitX: 232, startX: 80,\n        palette: { brick: \"#536b7a\", shadow: \"#293e53\", trim: \"#d2caab\", sky: \"#1d3046\" },\n        banner: \"LOVE: ONE. HOT BUTTERED BRICKS: ZERO.\", line: \"Mabel: Catch! His goose is cooked!\",\n        windows: [...W(\"roof\", 0, [224, 104], 0.6), ...W(\"roof\", 1, [104, 216], 2.3),\n          ...W(\"roof\", 2, [216, 104], 4.2)],\n        bumpers: [{ id: \"roof-crack\", x: 160, floor: 2, mode: \"split\" },\n          { id: \"roof-bounce\", x: 112, floor: 0, mode: \"reverse\", next: \"roof-drop\" },\n          { id: \"roof-drop\", x: 248, floor: 0, mode: \"drop\" }],\n        spawns: [H(\"roof-roll\", \"boulder\", 0, 0.2, 1),\n          H(\"roof-bounce\", \"bumper\", 0, 5, 1, { bumper: \"roof-bounce\" }),\n          H(\"roof-bird\", \"bird\", 1, 0.2, 1, { repeat: 12 }),\n          H(\"roof-bat\", \"bat\", 1, 4.5, -1, { repeat: 14 }),\n          H(\"roof-split\", \"split\", 2, 0.4, 1, { bumper: \"roof-crack\", repeat: 11 }),\n          H(\"roof-final-rat\", \"rat\", 2, 4.2, -1, { repeat: 12 })],\n        hearts: [Heart(\"roof-help\", 0, 160, 1), Heart(\"final-heart\", 2, 172, 0.1, { repeat: 7, life: 10 }),\n          Heart(\"final-backup\", 3, 168, 0.1, { repeat: 7, life: 10 })],\n        finale: { beats: [64, 112, 160], rescueX: 232, rescueTolerance: 21, needsHeart: true, departure: 9 },\n      },\n    ],\n    hard: { windowOrder: [1, 0], windowOffset: 2.4, hazardCadence: 0.82,\n      combinations: [H(\"hard-rat\", \"rat\", 1, 3.8, 1), H(\"hard-bat\", \"bat\", 3, 7, -1)] },\n  };\n  TT.validateContent = (content = TT.CONTENT) => {\n    const failures = [], ids = new Set();\n    const unique = (id) => { if (!id || ids.has(id)) failures.push(`Missing or duplicate ID: ${id}`); ids.add(id); };\n    if (content.sections.length !== 4) failures.push(\"A tower needs three sections and a roof\");\n    for (const s of content.sections) {\n      unique(s.id);\n      if (s.startX < s.inset || s.startX > content.width - s.inset) failures.push(`${s.id}: start is outside ledge`);\n      for (let f = 0; f < s.floors; f++) {\n        const ws = s.windows.filter((w) => w.floor === f);\n        if (ws.length < 1) failures.push(`${s.id} floor ${f}: no reachable upward route`);\n        for (const w of ws) {\n          unique(w.id);\n          if (w.x < s.inset + 8 || w.x > content.width - s.inset - 8) failures.push(`${w.id}: window outside ledge`);\n          if (w.z !== content.baseZ + f * content.floorHeight || w.toZ !== w.z + content.floorHeight || w.delay < 0) failures.push(`${w.id}: invalid endpoints or timing`);\n        }\n      }\n      const bumps = new Set(s.bumpers.map((b) => b.id));\n      // A fixture can intentionally share the ID of the encounter it belongs to.\n      for (const b of s.bumpers) if (b.next && !bumps.has(b.next)) failures.push(`${b.id}: broken bumper link`);\n      for (const h of s.spawns) {\n        unique(`${s.id}:spawn:${h.id}`);\n        if (h.bumper && !bumps.has(h.bumper)) failures.push(`${h.id}: missing bumper`);\n        if (![\"boulder\", \"bumper\", \"split\", \"rat\", \"bird\", \"bat\"].includes(h.type)) failures.push(`${h.id}: unknown hazard`);\n        if (!(h.after >= 0 && h.repeat > h.telegraph && h.floor >= 0 && h.floor < s.floors)) failures.push(`${h.id}: invalid encounter timing/floor`);\naudio.js\nbootstrap.js\nnetwork.js\npresentation.js\nsimulation.js\nstyle.css\n","exit_code":0,"status":"completed"}}
