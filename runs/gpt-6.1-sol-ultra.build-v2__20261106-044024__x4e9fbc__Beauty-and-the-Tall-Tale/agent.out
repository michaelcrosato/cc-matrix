{"type":"item.completed","item":{"id":"item_115","type":"command_execution","command":"/bin/bash -lc \"sed -n '1375,1433p' src/presentation.js && sed -n '1298,1376p' src/presentation.js && sed -n '18,88p' tools/check-hub-rescue.py && sed -n '88,130p' tools/check-hub-rescue.py\"","aggregated_output":"\t\t\t\t\t\tg,\n\t\t\t\t\t\t[\n\t\t\t\t\t\t\t[ox - 28 * s, oy - 5 * s],\n\t\t\t\t\t\t\t[ox + 18 * s, oy - 5 * s],\n\t\t\t\t\t\t\t[ox + 25 * s, oy + 1 * s],\n\t\t\t\t\t\t\t[ox + 19 * s, oy + 6 * s],\n\t\t\t\t\t\t\t[ox - 20 * s, oy + 4 * s],\n\t\t\t\t\t\t],\n\t\t\t\t\t\t\"#df8b61\",\n\t\t\t\t\t);\n\t\t\t\t\tq(-20, -4, 37, 2, \"#ffd19c\");\n\t\t\t\t\tq(-28, -12, 9, 9, \"#b76d59\");\n\t\t\t\t\tq(-25, -11, 2, 8, \"#efbd8d\");\n\t\t\t\t\tq(-12, -10, 25, 4, \"#f5c581\");\n\t\t\t\t\tq(-15, 6, 29, 4, \"#ae5a50\");\n\t\t\t\t\tq(-9, -7, 2, 13, \"#564f56\");\n\t\t\t\t\tq(9, -7, 2, 13, \"#564f56\");\n\t\t\t\t\tq(20, -7, 3, 14, \"#605762\");\n\t\t\t\t\tconst flap = Math.sin(t * 45);\n\t\t\t\t\tpx.line(\n\t\t\t\t\t\tg,\n\t\t\t\t\t\tox + 24 * s,\n\t\t\t\t\t\toy - 11 * s * flap,\n\t\t\t\t\t\tox + 24 * s,\n\t\t\t\t\t\toy + 11 * s * flap,\n\t\t\t\t\t\t\"#e7d8b4\",\n\t\t\t\t\t\tMath.max(1, s),\n\t\t\t\t\t);\n\t\t\t\t\tpx.disc(g, ox - 8 * s, oy + 12 * s, 3 * s, \"#303e4d\");\n\t\t\t\t\tpx.disc(g, ox + 10 * s, oy + 12 * s, 3 * s, \"#303e4d\");\n\t\t\t\t\tpx.disc(g, ox - 8 * s, oy + 12 * s, 1 * s, \"#9b9e92\");\n\t\t\t\t\tq(-6, -9, 10, 5, \"#334e60\");\n\t\t\t\t\tq(-5, -11, 3, 3, \"#f1c59a\");\n\t\t\t\t},\n\t\t\t\t{ outline: true, bias: 100 },\n\t\t\t);\n\t\t}\n\t\tdrawEnding(r, sim) {\n\t\t\tconst d = sim.departureTime || 0,\n\t\t\t\tE = this.E;\n\t\t\tlet x, z;\n\t\t\tif (d < 3.8) {\n\t\t\t\tx = -60 + d * 50;\n\t\t\t\tz = 225 - Math.sin(((d / 3.8) * Math.PI) / 2) * 18;\n\t\t\t} else {\n\t\t\t\tx = 130 + Math.max(0, d - 4) ** 1.4 * 30;\n\t\t\t\tz = 207 + Math.max(0, d - 4) ** 1.25 * 12;\n\t\t\t}\n\t\t\tthis.drawPlane(\n\t\t\t\tr,\n\t\t\t\tx,\n\t\t\t\tz,\n\t\t\t\t1.5,\n\t\t\t\td > 4 ? \"NEXT STOP: SOMEWHERE SHORTER.\" : \"YOUR CHARIOT, DARLINGS!\",\n\t\t\t);\n\t\t\tif (d > 4) {\n\t\t\t\tr.actor(\n\t\t\t\t\tx - 5,\n\t\t\t\t\t0,\n\t\t\t\t\t\te.type === \"heart\" || e.type === \"rescue\"\n\t\t\t\t\t\t\t? \"#ffd0ab\"\n\t\t\t\t\t\t\t: e.type === \"hit\"\n\t\t\t\t\t\t\t\t? \"#f6b081\"\n\t\t\t\t\t\t\t\t: \"#d2c9ae\";\n\t\t\t\tr.actor(\n\t\t\t\t\te.x,\n\t\t\t\t\t0,\n\t\t\t\t\te.z,\n\t\t\t\t\t(g, x, y) => {\n\t\t\t\t\t\tpx.blend(g, 1 - u, \"normal\", () => {\n\t\t\t\t\t\t\tfor (let i = 0; i < n; i++) {\n\t\t\t\t\t\t\t\tconst a = (i / n) * Math.PI * 2 + e.seed,\n\t\t\t\t\t\t\t\t\trr = (5 + u * 19) * s,\n\t\t\t\t\t\t\t\t\txx = x + Math.cos(a) * rr,\n\t\t\t\t\t\t\t\t\tyy = y - 9 * s + Math.sin(a) * rr + u * u * 15 * s;\n\t\t\t\t\t\t\t\tpx.rect(\n\t\t\t\t\t\t\t\t\tg,\n\t\t\t\t\t\t\t\t\txx,\n\t\t\t\t\t\t\t\t\tyy,\n\t\t\t\t\t\t\t\t\tMath.max(1, (2 - u) * s),\n\t\t\t\t\t\t\t\t\tMath.max(1, (2 - u) * s),\n\t\t\t\t\t\t\t\t\ti % 3 ? c : \"#fff1c1\",\n\t\t\t\t\t\t\t\t);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif ([\"smash\", \"heart\", \"checkpoint\", \"rescue\"].includes(e.type)) {\n\t\t\t\t\t\t\t\tconst txt =\n\t\t\t\t\t\t\t\t\te.type === \"heart\"\n\t\t\t\t\t\t\t\t\t\t? \"HEART RUSH!\"\n\t\t\t\t\t\t\t\t\t\t: e.type === \"rescue\"\n\t\t\t\t\t\t\t\t\t\t\t? \"LOVE WINS!\"\n\t\t\t\t\t\t\t\t\t\t\t: e.type === \"checkpoint\"\n\t\t\t\t\t\t\t\t\t\t\t\t? \"ONWARD!\"\n\t\t\t\t\t\t\t\t\t\t\t\t: \"+50\";\n\t\t\t\t\t\t\t\tE.font.text(g, txt, x, y - (23 + u * 15) * s, c, {\n\t\t\t\t\t\t\t\t\talign: \"center\",\n\t\t\t\t\t\t\t\t\toutline: true,\n\t\t\t\t\t\t\t\t});\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t});\n\t\t\t\t\t},\n\t\t\t\t\t{ outline: false, rim: false, emissive: true, bias: 40 },\n\t\t\t\t);\n\t\t\t}\n\t\t}\n\t\tdrawPlane(r, x, z, scale = 1, banner = \"\") {\n\t\t\tconst E = this.E,\n\t\t\t\tpx = E.px,\n\t\t\t\ts = (r.view.scale || 1) * scale,\n\t\t\t\tt = this.time;\n\t\t\tr.actor(\n\t\t\t\tx,\n\t\t\t\t0,\n\t\t\t\tz,\n\t\t\t\t(g, ox, oy) => {\n\t\t\t\t\tconst q = (x, y, w, h, c) =>\n\t\t\t\t\t\tpx.rect(g, ox + x * s, oy + y * s, w * s, h * s, c);\n\t\t\t\t\tif (banner) {\n\t\t\t\t\t\tconst w = Math.min(184, banner.length * 4 + 12);\n\t\t\t\t\t\tpx.line(g, ox - 20 * s, oy, ox - 32 * s, oy + 2 * s, \"#c2b698\");\n\t\t\t\t\t\tq(-32 - w, -5, w, 13, \"#e9d6ae\");\n\t\t\t\t\t\tq(-32 - w, -5, w, 1, \"#fff0c9\");\n\t\t\t\t\t\tE.font.text(\n\t\t\t\t\t\t\tg,\n\t\t\t\t\t\t\tbanner,\n\t\t\t\t\t\t\tox - (32 + w / 2) * s,\n\t\t\t\t\t\t\toy - 2 * s,\n\t\t\t\t\t\t\t\"#485662\",\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\talign: \"center\",\n\t\t\t\t\t\t\t\toutline: false,\n\t\t\t\t\t\t\t\tfont: \"tiny\",\n\t\t\t\t\t\t\t\tscale: Math.max(1, Math.round(s * 0.7)),\n\t\t\t\t\t\t\t},\n\t\t\t\t\t\t);\n\t\t\t\t\t}\n\t\t\t\t\tpx.poly(\n\t\t\t\t\t\tg,\n\t\t\t\t\t\t[\n\nfrom playwright.sync_api import sync_playwright\n\nDEV = pathlib.Path(__file__).resolve().parents[1]\nIDENTITY = json.loads((DEV / \"build-identity.json\").read_text())\n\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *_args):\n        pass\n\n\nINSTALL_DRIVER = \"\"\"options => {\n  const copies = [...document.querySelectorAll('iframe')].map(f => f.contentWindow).filter(w => w.TallTaleApp);\n  const authority = copies.find(w => w.TallTaleApp.state.network?.info?.isHost);\n  if (!authority || copies.some(w => !w.TallTaleApp.state.network?.info || w.TallTaleApp.game._booting)) return false;\n  for (const w of copies) {\n    const app = w.TallTaleApp, net = app.state.network;\n    app.game.stop();\n    let heldUntil = 0;\n    net.options.getIntent = () => {\n      w.__rescueInputReads = (w.__rescueInputReads || 0) + 1;\n      const sim = authority.TallTaleApp.state.sim;\n      const delayed = !net.info.isHost || net.server;\n      const command = sim.botIntent(net.info.me, { latency: delayed ? (options.latency + options.jitter) / 1000 + 1 / 12 : 1 / 12 });\n      if (command.jumpPressed) heldUntil = Math.max(heldUntil, w.performance.now() + 200);\n      if (w.performance.now() < heldUntil) command.jump = true;\n      return command;\n    };\n    w.__rescueDriver = w.setInterval(() => app.game.advance(1 / 120, {draw:false}), 1000 / 120);\n  }\n  return true;\n}\"\"\"\n\nREAD_COPIES = \"\"\"() => [...document.querySelectorAll('iframe')].map(f => {\n  const w = f.contentWindow, a = w.TallTaleApp, n = a?.state.network;\n  if (!a || !n) return null;\n  return {title:w.document.title,host:n.info?.isHost,server:n.server,diag:n.diagnostics(),tick:a.state.sim.tick,inputReads:w.__rescueInputReads || 0,\n    outcome:a.state.sim.outcome(),simTime:a.state.sim.time,ledger:Object.keys(a.state.sim.ledger).sort(),\n    coverage:a.state.sim.coverage,events:a.state.sim.eventSerial,invulnerable:a.state.sim.invulnerable,\n    unranked:a.state.sim.unranked,audio:a.sound.stats(),errors:a.game.errors};\n}).filter(Boolean)\"\"\"\n\n\ndef run_one_rescue(browser, base, name, options):\n    page = browser.new_page(viewport={\"width\": 1280, \"height\": 720})\n    errors = []\n    page.on(\"pageerror\", lambda e: errors.append(str(e)))\n    copies = []\n    left = False\n    try:\n        # Repeatable simulated network jitter/loss; world randomness still comes\n        # exclusively from the retained AIHub.rng stream in production code.\n        page.add_init_script(\"\"\"if (window === window.parent) {\n          let seed=19;\n          Math.random=()=>{ seed=(seed+0x6d2b79f5)>>>0; let t=Math.imul(seed^(seed>>>15),1|seed); t^=t+Math.imul(t^(t>>>7),t|61); return ((t^(t>>>14))>>>0)/4294967296; };\n        }\"\"\")\n        page.clock.install()\n        query = urllib.parse.urlencode(\n            {\n                \"game\": \"/\" + IDENTITY[\"basename\"] + \".html?test=1\",\n                \"players\": \"2\",\n                \"latency\": str(options[\"latency\"]),\n                \"jitter\": str(options[\"jitter\"]),\n                \"loss\": str(options[\"loss\"]),\n                \"seed\": \"1982\",\n                \"limit\": \"720\",\n                **({\"scenario\": \"server\"} if options.get(\"server\") else {}),\n            }\n        )\n        page.goto(base + f\"/{DEV.name}/vendor/ai-hub/harness.html?{query}\")\n        page.goto(base + f\"/{DEV.name}/vendor/ai-hub/harness.html?{query}\")\n        installed = False\n        for _ in range(100):\n            page.clock.run_for(100)\n            if page.evaluate(INSTALL_DRIVER, options):\n                installed = True\n                break\n        if not installed:\n            raise AssertionError(\"packaged copies did not initialize\")\n        page.locator(\"#release\").click()\n        for _ in range(720):\n            page.clock.run_for(1000)\n            copies = page.evaluate(READ_COPIES)\n            host = next(c for c in copies if c[\"host\"])\n            if (\n                options.get(\"helperLeave\")\n                and not left\n                and host[\"outcome\"][\"section\"] >= 1\n            ):\n                page.locator(\"#who\").select_option(\"p1\")\n                page.locator(\"#remove\").click()\n                left = True\n            if host[\"diag\"][\"finished\"] or host[\"diag\"][\"ended\"]:\n                page.clock.run_for(2000)\n                copies = page.evaluate(READ_COPIES)\n                break\n        before_end = copies\n        page.clock.run_for(2000)\n        copies = page.evaluate(READ_COPIES)\n        for old, fresh in zip(before_end, copies, strict=True):\n            if old[\"diag\"][\"sent\"] != fresh[\"diag\"][\"sent\"]:\n                errors.append(\"traffic continued after Hub end\")\n            if old[\"tick\"] != fresh[\"tick\"]:\n                errors.append(\"simulation continued after Hub end\")\n            if old[\"inputReads\"] != fresh[\"inputReads\"]:\n                errors.append(\"gameplay input continued after Hub end\")\n            if not fresh[\"audio\"][\"stopped\"]:\n                errors.append(\"audio was not stopped at Hub end\")\n        if len(copies) != 2:\n            errors.append(f\"expected two remaining copies, got {len(copies)}\")\n        if options.get(\"helperLeave\") and not left:\n            errors.append(\"helper departure was not exercised\")\n        host = next(c for c in copies if c[\"host\"])\n","exit_code":0,"status":"completed"}}
