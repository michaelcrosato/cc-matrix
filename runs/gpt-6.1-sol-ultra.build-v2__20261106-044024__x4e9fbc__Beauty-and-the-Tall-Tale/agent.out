     \"smash:0:street-stone\"\n      ],\n      \"coverage\": {\n        \"windows\": 7,\n        \"jumps\": 16,\n        \"hearts\": 4,\n        \"hits\": 3,\n        \"reversals\": 0,\n        \"drops\": 0,\n        \"splits\": 0,\n        \"sections\": 0,\n        \"rescue\": 0,\n        \"seen\": {\n          \"rat\": 4,\n          \"boulder\": 8\n        },\n        \"dodged\": {},\n        \"smashed\": {\n          \"boulder\": 3\n        }\n      },\n      \"events\": 126,\n      \"invulnerable\": false,\n      \"unranked\": false,\n      \"audio\": {\n        \"activated\": false,\n        \"silent\": false,\n        \"stopped\": true,\n        \"mode\": null,\n        \"musicGain\": 0.1,\n        \"master\": 0.7,\n        \"muted\": false,\n        \"eventCount\": 0,\n        \"voiceCount\": 0,\n        \"liveVoices\": 0,\n        \"peak\": 0,\n        \"rms\": 0,\n        \"finite\": true,\n        \"ready\": false\n      },\n      \"errors\": []\n    },\n    {\n      \"title\": \"Beauty and the Tall Tale\",\n      \"host\": false,\n      \"server\": false,\n      \"diag\": {\n        \"active\": true,\n        \"started\": true,\n        \"ended\": true,\n        \"finished\": false,\n        \"server\": false,\n        \"assignedId\": 1,\n        \"members\": [\n          0,\n          1\n        ],\n        \"pendingEdges\": 0,\n        \"history\": 0,\n        \"sent\": 430,\n        \"received\": 379,\n        \"stale\": 31,\n        \"rejected\": 0,\n        \"bytes\": 20390,\n        \"maxBytes\": 74,\n        \"maxRoutineBytes\": 48,\n        \"appliedEdges\": 0,\n        \"postEndSends\": 0\n      },\n      \"tick\": 4499,\n      \"inputReads\": 4520,\n      \"outcome\": {\n        \"phase\": \"failed\",\n        \"rescued\": false,\n        \"score\": 300,\n        \"chances\": 0,\n        \"section\": 0,\n        \"continued\": false\n      },\n      \"simTime\": 37.49,\n      \"ledger\": [\n        \"heart:first-heart\",\n        \"heart:street-