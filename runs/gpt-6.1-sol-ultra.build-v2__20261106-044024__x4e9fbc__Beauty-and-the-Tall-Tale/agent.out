length - 1 - index : index;\n          w.usable = false; w.aperture = 0; w.phase = \"closed\";\n          w.remaining = t < 0 ? -t : (slot - u) + (((i - active + ws.length) % ws.length) || ws.length) * slot;\n          if (t >= 0 && i === active) {\n            if (u < opening) { w.phase = \"opening\"; w.aperture = u / opening; w.remaining = opening - u; }\n            else if (u < opening + open) { w.phase = \"open\"; w.aperture = 1; w.remaining = opening + open - u; w.usable = true; }\n            else if (u < opening + open + warning) { w.phase = \"warning\"; w.aperture = 1; w.remaining = opening + open + warning - u; w.usable = true; }\n            else if (u < opening + open + warning + closing) { w.phase = \"closing\"; w.aperture = 1 - (u - opening - open - warning) / closing; w.remaining = opening + open + warning + closing - u; }\n\t\t},\n\t});\n\tif (hubMode) game.live = true;\n\tconfigSpecs.forEach(([key, label, min, max, step]) =>\n\t\tgame.settings.define({\n\t\t\tkey: \"dev_\" + key,\n\t\t\tlabel,\n\t\t\ttype: \"slider\",\n\t\t\tmin,\n\t\t\tmax,\n\t\t\tstep,\n\t\t\tvalue: TT.DEFAULTS[key],\n\t\t\tgroup: \"Developer\",\n\t\t\tapply: (_g, value) => {\n\t\t\t\tif (state.mode === \"play\" && state.sim && !hubMode)\n\t\t\t\t\tstate.sim.setConfig(key, value);\n\t\t\t},\n\t\t}),\n\t\t\t});\n\t\t}\n\t}\n\tfunction intent(input, actor) {\n\t\tconst none = {\n\t\t\tx: 0,\n\t\t\tup: false,\n\t\t\tdown: false,\n\t\t\tjump: false,\n\t\t\tjumpPressed: false,\n\t\t};\n\t\tif (!input || ui.screen || game.real < state.ignoreUntil || state.ended)\n\t\t\treturn none;\n\t\tconst m = input.move();\n\t\tconst out = {\n\t\t\tx: m[0],\n\t\t\tup: input.down(\"up\") || m[1] < -0.5 || state.climbHeld,\n\t\t\tdown: input.down(\"down\") || m[1] > 0.5,\n\t\t\tjump: input.down(\"jump\"),\n\t\t\tjumpPressed: input.pressed(\"jump\"),\n\t\t};\n\t\tif (state.inputTarget && actor) {\n\t\t\tconst d = state.inputTarget.x - actor.body.x;\n\t\t\tif (Math.abs(d) > 8) out.x = Math.sign(d) * 0.5