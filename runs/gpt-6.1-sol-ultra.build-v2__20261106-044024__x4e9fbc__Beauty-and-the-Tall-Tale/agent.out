ud-score\").textContent = String(sim.score).padStart(\n\t\t\t6,\n\t\t\t\"0\",\n\t\t);\n\t\tconst chances = Math.max(0, sim.chances);\n\t\thud.querySelector(\".hud-chances\").innerHTML =\n\t\t\t\"<small>SPARES</small>\" +\n\t\t\tArray.from(\n\t\t\t\t{ length: Math.max(3, chances) },\n\t\t\t\t(_, i) => '<span class=\"' + (i < chances ? \"\" : \"off\") + '\">♟</span>',\n\t\t\t).join(\"\");\n\t\tconst power = Math.max(0, ...sim.actors.map((a) => Number(a.power) || 0));\n\t\tconst rush = hud.querySelector(\".hud-rush\");\n\t\trush.hidden = power <= 0;\n\t\trush.firstElementChild.style.width =\n\t\t\tMath.min(1, power / (sim.config?.heartDuration || 6)) * 100 + \"%\";\n\t\tconst climb = game.input.label(\"up\"),\n\t\t\tjump = game.input.label(\"jump\");\n\t\tprompt.textContent =\n\t\t\tpower > 0\n\t\t\t\t? `♥ HEART RUSH · ${Math.ceil(power)}s · Smash hazards. Open windows still matter.`\n\t\t\t\t: sim.phase === \"transition\"\n\t\t\t\t\t? \"A floor closer. A bully less sure of himself.\"\n\t\t\t\t\t: sim.phase === \"departure\"\n            point = window_point(page)\n            page.mouse.click(point[\"x\"], point[\"y\"])\n            step(page, 1.3)\n            check(\n                \"real mouse context action: approaches and climbs without teleport\",\n                page.evaluate(\n                    \"TallTaleApp.state.sim.coverage.windows===1&&Math.abs(TallTaleApp.state.sim.actors[0].z-64)<.1&&!TallTaleApp.state.inputTarget\"\n                ),\n            )\n            page.keyboard.press(\"Escape\")\n            step(page, 0.03)\n            page.get_by_role(\"button\", name=\"About & credits\", exact=True).click()\n            panel = page.locator(\".esh-mod\")\n            check(\n                \"credits initially show metadata from the top\",\n                panel.evaluate(\"e=>e.scrollTop\") < 1,\n            )\n            page.keyboard.press(\"PageDown\")\n            check(\n                \"credits: PageDown scrolls long source information\",\n                    )\n                )\n            finally:\n                ctx.close()\n        browser.close()\n        for engine in [\"webkit\", \"firefox\"]:\n            browser = getattr(pw, engine).launch(headless=True)\n            ctx, page, errs, _reqs = open_game(\n                browser,\n                viewport={\"width\": 1280, \"height\": 720},\n                **({\"has_touch\": True} if engine == \"webkit\" else {}),\n            )\n            try:\n                page.get_by_role(\"button\", name=\"Climb solo\", exact=False).click()\n                page.get_by_role(\"button\", name=\"Let’s climb\", exact=False).click()\n                advance(page, 0.2)\n                page.keyboard.down(\"KeyD\")\n                advance(page, 0.4)\n                page.keyboard.up(\"KeyD\")\n                advance(page, 0.1, True)\n                check(\n                    engine + \": packaged startup / native input / Canvas\",\n                    snapshot(page)[\"mode\"] == \"play\"\n                    and snapshot(page)[\"sim\"][\"actors\"][0][\"body\"][\"x\"] > 65\n                    and not errs,\n                    errs,\n                )\n                page.keyboard.press(\"Escape\")\n                advance(page, 0.03)\n                page.get_by_role(\"button\", name=\"Settings\", exact=True).click()\n                check(\n                    engine + \": settings reachable\",\n                    \"Music\" in page.locator(\".esh-sh\").inner_text(),\n                )\n            finally:\n                ctx.close()\n                browser.close()\n    (ROOT / \"artifacts/browser-checks.json\").write_text(json.dumps(RESULTS, indent=2))\n    return RESULTS\n\n\nif __name__ == \"__main__\":\n    try:\n        run_browser_checks()\n    except Exception as exc:  # noqa: BLE001 -- Aggregate runner must record browser failures.\n        check(\"browser runner\", False, repr(exc))\n        (ROOT / \"artifacts/browser-checks.json\").