{"type":"item.started","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -lc \"head -45 tests/presentation.cjs && tail -12 tests/presentation.cjs && sed -n '145,203p' tools/check-hub-rescue.py && ls tools && cat artifacts/hub-rescue.json | head -15\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -lc \"head -45 tests/presentation.cjs && tail -12 tests/presentation.cjs && sed -n '145,203p' tools/check-hub-rescue.py && ls tools && cat artifacts/hub-rescue.json | head -15\"","aggregated_output":"\"use strict\";\nconst assert = require(\"node:assert/strict\");\nrequire(\"../vendor/engine-repo/dist/handoff/my-3d2dge.js\");\nrequire(\"../content/tower.js\");\nrequire(\"../src/simulation.js\");\nrequire(\"../src/presentation.js\");\nrequire(\"../src/audio.js\");\nconst E = globalThis.My3D2dge,\n\tT = globalThis.TallTale;\nmodule.exports = async function () {\n\tconst out = [];\n\tconst test = (name, fn) => {\n\t\ttry {\n\t\t\tfn();\n\t\t\tout.push({ name, pass: true });\n\t\t} catch (e) {\n\t\t\tout.push({ name, pass: false, detail: e.stack });\n\t\t}\n\t};\n\ttest(\"Renderer pixels per unit agree with projection at six zooms\", () => {\n\t\tconst g = new E.Game({\n\t\t\theadless: true,\n\t\t\tdraw: true,\n\t\t\tview: \"side\",\n\t\t\tres: [640, 480],\n\t\t\tmenu: false,\n\t\t});\n\t\tg.start({ update() {}, draw() {} });\n\t\tfor (const z of [0.5, 0.65, 0.8, 1, 1.5, 2]) {\n\t\t\tg.setZoom(z);\n\t\t\tg.advance(1 / 120, { draw: true });\n\t\t\tconst unit = Math.abs(g.r.w(1, 0, 0)[0] - g.r.w(0, 0, 0)[0]);\n\t\t\tassert.ok(Math.abs(unit - g.r.ppu) < 1e-8, `${z}: ${unit} vs ${g.r.ppu}`);\n\t\t}\n\t\tg.dispose();\n\t});\n\ttest(\"Every facade, overview and departure draws through native renderer\", () => {\n\t\tconst g = new E.Game({\n\t\t\theadless: true,\n\t\t\tdraw: true,\n\t\t\tview: \"side\",\n\t\t\tres: [640, 480],\n\t\t\tmenu: false,\n\t\t});\n\t\tconst s = new T.Simulation(E, { players: [1, 2] }),\n\t\t}\n\t});\n\treturn out;\n};\nif (require.main === module)\n\tmodule.exports().then((out) => {\n\t\tfor (const r of out) if (!r.pass) console.error(r.name + \"\\n\" + r.detail);\n\t\tconsole.log(\n\t\t\t`${out.filter((r) => r.pass).length}/${out.length} presentation/audio checks passed`,\n\t\t);\n\t\tprocess.exitCode = out.some((r) => !r.pass) ? 1 : 0;\n\t});\n                errors.append(\"incorrect packaged game identity\")\n            if not c[\"outcome\"][\"rescued\"]:\n                errors.append(f\"rescue incomplete: {c['outcome']}\")\n            if c[\"host\"] and c[\"outcome\"][\"phase\"] != \"results\":\n                errors.append(\"host finished before the plane departure\")\n            if c[\"invulnerable\"] or c[\"unranked\"]:\n                errors.append(\"route used a cheat or nondefault balance\")\n            for key in [\"score\", \"chances\", \"section\", \"rescued\"]:\n                if c[\"outcome\"][key] != host[\"outcome\"][key]:\n                    errors.append(f\"authoritative {key} differs across copies\")\n            if c[\"ledger\"] != host[\"ledger\"]:\n                errors.append(\"award ledger differs across copies\")\n            if c[\"errors\"]:\n                errors.append(str(c[\"errors\"]))\n            if not c[\"diag\"][\"ended\"]:\n                errors.append(\"copy missed Hub end cleanup\")\n            if c[\"diag\"][\"maxRoutineBytes\"] > 1200:\n                errors.append(\"unreliable snapshot exceeded 1200 bytes\")\n            if c[\"server\"] and (\n                c[\"inputReads\"] or not c[\"audio\"][\"silent\"] or c[\"audio\"][\"activated\"]\n            ):\n                errors.append(\n                    \"non-playing server consumed local input or created audio\"\n                )\n        return {\n            \"name\": name,\n            \"pass\": not errors,\n            \"errors\": errors,\n            \"options\": options,\n            \"copies\": copies,\n            \"helperLeft\": left,\n            \"round\": page.locator(\"#round\").inner_text(),\n            \"log\": page.locator(\"#log\").inner_text(),\n        }\n    except Exception as error:  # noqa: BLE001 - record each failed route and close its page\n        return {\n            \"name\": name,\n            \"pass\": False,\n            \"errors\": [str(error)],\n            \"copies\": page.evaluate(READ_COPIES),\n            \"options\": options,\n        }\n    finally:\n        page.close()\n\n\ndef run_browser_rescue():\n    results = []\n    handler = functools.partial(QuietHandler, directory=str(DEV.parent))\n    server = http.server.ThreadingHTTPServer((\"127.0.0.1\", 0), handler)\n    thread = threading.Thread(target=server.serve_forever, daemon=True)\n    thread.start()\n    try:\n        with sync_playwright() as p:\n            browser = p.chromium.launch(headless=True)\n            try:\n                base = f\"http://127.0.0.1:{server.server_port}\"\n                for name, options in [\n                    (\n__pycache__\nbuild.mjs\ncheck-audio.py\ncheck-browser.py\ncheck-hub-rescue.py\ncheck-hub.py\nverify.mjs\n[\n  {\n    \"name\": \"packaged two-client normal-intention rescue\",\n    \"pass\": true,\n    \"errors\": [],\n    \"copies\": [\n      {\n        \"title\": \"Beauty and the Tall Tale\",\n        \"host\": true,\n        \"server\": false,\n        \"diag\": {\n          \"active\": true,\n          \"started\": true,\n          \"ended\": true,\n          \"finished\": true,\n","exit_code":0,"status":"completed"}}
