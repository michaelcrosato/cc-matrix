{"type":"item.started","item":{"id":"item_96","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport json\np=Path('biome.json');x=json.loads(p.read_text());x['linter']['rules']['suspicious']['noAssignInExpressions']='off';x['overrides']=[{'includes':['src/presentation.js'],'linter':{'rules':{'suspicious':{'noControlCharactersInRegex':'off'}}}}];p.write_text(json.dumps(x,indent=2)+'\\\\n')\nPY\nbiome format --write biome.json\npython3 - <<'PY'\nfrom pathlib import Path\nimport json\nfor f in ['rules-report.json','browser-checks.json','audio-checks.json','controls-checks.json','hub-checks.json','hub-rescue.json']:\n p=Path('artifacts')/f\n data=json.loads(p.read_text())\n if isinstance(data,list): print(f,sum(bool(x.get('pass'))for x in data),'/',len(data))\n else: print(f,data.get('count'),data.get('failures'))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
