{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -lc \"head -14 vendor/engine-repo/dist/handoff/my-3d2dge.js && head -35 tests/rules.mjs && tail -30 tests/rules.mjs && rg -n 'validate|runRules|failures|full' tests/rules.mjs\"","aggregated_output":"/*!\n * my-3D2dge v0.89.1  (My \"3D\" 2D Game Engine)\n * Procedural pixel-puppet engine for every 2D perspective.\n * https://github.com/michaelcrosato/my-3d2dge  (MIT License)\n *\n * READ THIS FIRST (humans and AI models extending a my-3D2dge game)\n * -----------------------------------------------------------------------------\n * 0. EVERY GAME STARTS WITH  const E = My3D2dge;  and then uses E.Game, E.px, ...\n * 1. WORLD SPACE IS 3D. x = east, y = south, z = up. One floor tile = 16 units.\n *    Game logic never thinks about screen pixels.\n * 2. A VIEW turns world points into screen pixels. Swap the view and the whole game\n *    re-renders from another angle: E.VIEWS.iso, .threequarter, .topdown,\n *    .brawler, .side  (or build your own: new E.View(id, label, yaw, pitch, scale, zBoost)).\n * 3. CHARACTERS ARE RIGS, NOT SPRITES. E.Humanoid and E.Blob recompute their\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { createRequire } from \"node:module\";\nimport { fileURLToPath } from \"node:url\";\n\nconst require = createRequire(import.meta.url);\nconst root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nrequire(path.join(root, \"vendor/engine-repo/dist/handoff/my-3d2dge.js\"));\nrequire(path.join(root, \"content/tower.js\"));\nrequire(path.join(root, \"src/simulation.js\"));\nconst E = globalThis.My3D2dge;\nconst TT = globalThis.TallTale;\nconst DT = 1 / 120;\nconst N = () => TT.neutralIntent();\n\nfunction fixture(players) {\n  const s = new TT.Simulation(E, { players });\n  for (const a of s.actors) a.recovery = 0;\n  return s;\n}\nfunction climbFixture() {\n  const s = fixture(), a = s.actors[0];\n  s.advance(0.6); a.body.x = 88; a.body.z = 16; a.body.vx = a.body.vz = 0; a.body.onGround = true; a.recovery = 0;\n  s.step(DT, { 1: { up: true } });\n  return { s, a };\n}\nfunction addContact(s, type, a = s.actors[0]) {\n  s.spawnHazard(type, 0); const h = s.hazards.at(-1);\n  Object.assign(h, { x: a.x, z: a.z, vx: 0, vz: 0, age: type === \"bird\" ? 3.15 : type === \"bat\" ? 2.15 : 2,\n    startZ: a.z, state: type === \"bird\" ? \"cross\" : type === \"bat\" ? \"swoop\" : type === \"rat\" ? \"scurry\" : \"roll\", bumper: null, bounced: true });\n  return h;\n}\nfunction route(options = {}, limit = 700, script) {\n  const s = new TT.Simulation(E, options), trace = [];\n  });\n  test(\"full two-climber route shares objectives and reaches the same ending without cheats\", () => {\n    const { s, trace } = route({ players: [{ id: 0, seat: 1 }, { id: 1, seat: 2 }] });\n    fs.writeFileSync(path.join(root, \"artifacts/coop-route.json\"), JSON.stringify({ outcome: s.outcome(), elapsed: s.time, coverage: s.coverage, trace }, null, 2));\n    assert.equal(s.phase, \"results\", `Co-op ended ${s.phase} section ${s.section}`); assert(s.rescued); assert(s.actors.every((a) => a.finished));\n    assert(s.actors.every((a) => a.stats.climbs > 0)); assert(s.coverage.hits > 0, \"Route should include a recoverable mistake\");\n    return { seconds: s.time, score: s.score, chances: s.chances };\n  });\n  test(\"a checkpoint retry and helper leaving on the roof still permit a complete solo rescue\", () => {\n    let retried = false, left = false, retries = 0;\n    const s = new TT.Simulation(E, { players: [{ id: 0, seat: 1 }, { id: 1, seat: 2 }] });\n    for (let k = 0; k < 120 * 700; k++) {\n      if (!retried && s.section === 1) { s.retryCheckpoint(); retried = true; }\n      if (!left && s.section === 3) { s.removePlayer(1); left = true; }\n      const intents = {}; for (const a of s.actors) intents[a.id] = s.botIntent(a.id); s.step(DT, intents);\n      if (s.phase === \"failed\" && retries < 2) { s.retryCheckpoint(); retries++; }\n      if (s.phase === \"results\") break;\n    }\n    assert(retried && left); assert.equal(s.phase, \"results\"); assert.equal(s.recordCategory(), \"continued\"); assert.equal(s.actors.length, 1);\n    return { seconds: s.time, score: s.score, retries };\n  });\n  fs.mkdirSync(path.join(root, \"artifacts\"), { recursive: true });\n  fs.writeFileSync(path.join(root, \"artifacts/rules-report.json\"), JSON.stringify({ count, failures, details }, null, 2));\n  return { count, failures };\n}\n\nif (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {\n  const r = await runRules(); for (const f of r.failures) console.log(`FAIL ${f}`);\n  console.log(`${r.count - r.failures.length}/${r.count} rule checks passed`); process.exitCode = r.failures.length ? 1 : 0;\n}\n49:export async function runRules() {\n50:  const failures = [], details = []; let count = 0;\n54:    catch (e) { failures.push(`${name}: ${e.message}`); details.push({ name, pass: false, error: e.stack }); }\n56:  test(\"authored content has unique IDs, valid fixtures, window timing and a route on every floor\", () => assert.deepEqual(TT.validateContent(), []));\n59:    assert(TT.validateContent(c).some((e) => e.includes(\"no reachable\")));\n63:    assert(TT.validateContent(c).some((e) => e.includes(\"broken bumper\")));\n74:    const full = jump(true, false), short = jump(false, false), run = jump(true, true);\n75:    assert(full.z > short.z + 5); assert(run.x > full.x + 30);\n243:  test(\"full uncheated solo normal-input route exercises every family through rescue and plane departure\", () => {\n253:  test(\"full two-climber route shares objectives and reaches the same ending without cheats\", () => {\n274:  fs.writeFileSync(path.join(root, \"artifacts/rules-report.json\"), JSON.stringify({ count, failures, details }, null, 2));\n275:  return { count, failures };\n279:  const r = await runRules(); for (const f of r.failures) console.log(`FAIL ${f}`);\n280:  console.log(`${r.count - r.failures.length}/${r.count} rule checks passed`); process.exitCode = r.failures.length ? 1 : 0;\n","exit_code":0,"status":"completed"}}
