{"type":"item.completed","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -lc \"rg -n 'pristine|aihub|AI Hub Session' tools/verify.mjs && sed -n '243,256p' tests/rules.mjs && sed -n '35,49p' tests/rules.mjs && cat artifacts/network-routes.json | head -60\"","aggregated_output":"45:\tconst pristine = fs.readFileSync(\"vendor/ai-hub/session.js\", \"utf8\");\n47:\t\t\"one pristine Hub client first after charset\",\n48:\t\tscripts[0] === pristine && html.match(/aihub-session 1.4.0/g)?.length === 1,\n  test(\"full uncheated solo normal-input route exercises every family through rescue and plane departure\", () => {\n    const { s, trace } = route();\n    fs.writeFileSync(path.join(root, \"artifacts/solo-route.json\"), JSON.stringify({ outcome: s.outcome(), elapsed: s.time, coverage: s.coverage, trace }, null, 2));\n    assert.equal(s.phase, \"results\", `Solo route ended ${s.phase} at section ${s.section}`); assert(s.rescued); assert(s.departureTime >= 9);\n    assert.equal(s.invulnerable, false); assert.equal(s.unranked, false); assert(s.coverage.windows >= 15); assert(s.coverage.jumps > 0); assert(s.coverage.hearts > 0);\n    for (const kind of [\"boulder\", \"bumper\", \"split\", \"rat\", \"bird\", \"bat\"]) { assert(s.coverage.seen[kind], `${kind} not exercised`); assert(s.coverage.smashed[kind], `${kind} never cleared under heart rush`); }\n    assert(s.coverage.reversals && s.coverage.drops && s.coverage.splits); assert.equal(s.coverage.sections, 3); assert.equal(s.coverage.rescue, 1);\n    assert.equal(Object.keys(s.ledger).filter((k) => k === \"objective:rescue\").length, 1);\n    return { seconds: s.time, score: s.score, coverage: s.coverage };\n  });\n  test(\"full two-climber route shares objectives and reaches the same ending without cheats\", () => {\n    const { s, trace } = route({ players: [{ id: 0, seat: 1 }, { id: 1, seat: 2 }] });\n    fs.writeFileSync(path.join(root, \"artifacts/coop-route.json\"), JSON.stringify({ outcome: s.outcome(), elapsed: s.time, coverage: s.coverage, trace }, null, 2));\n    assert.equal(s.phase, \"results\", `Co-op ended ${s.phase} section ${s.section}`); assert(s.rescued); assert(s.actors.every((a) => a.finished));\n  const s = new TT.Simulation(E, options), trace = [];\n  for (let k = 0; k < limit * 120; k++) {\n    const intents = {};\n    for (const a of s.actors) intents[a.id] = s.botIntent(a.id);\n    if (script) script(s, intents, k);\n    if (k % 120 === 0) trace.push({ t: +s.time.toFixed(2), section: s.section, phase: s.phase, chances: s.chances,\n      actors: s.actors.map((a) => [a.id, +a.x.toFixed(2), +a.z.toFixed(2)]) });\n    s.step(DT, intents);\n    for (const a of s.actors) for (const n of [a.x, a.z, a.vx, a.vz]) assert(Number.isFinite(n), \"Route produced a non-finite actor\");\n    if ([\"results\", \"failed\"].includes(s.phase)) break;\n  }\n  return { s, trace };\n}\n\nexport async function runRules() {\n[\n  {\n    \"name\": \"two-client normal-intention rescue\",\n    \"pass\": false,\n    \"error\": \"AssertionError [ERR_ASSERTION]: {\\\"seconds\\\":130.99166666666667,\\\"outcome\\\":{\\\"phase\\\":\\\"failed\\\",\\\"rescued\\\":false,\\\"score\\\":925,\\\"chances\\\":0,\\\"section\\\":2,\\\"continued\\\":false},\\\"coverage\\\":{\\\"windows\\\":30,\\\"jumps\\\":38,\\\"hearts\\\":10,\\\"hits\\\":5,\\\"reversals\\\":0,\\\"drops\\\":0,\\\"splits\\\":4,\\\"sections\\\":2,\\\"rescue\\\":0,\\\"seen\\\":{\\\"rat\\\":7,\\\"boulder\\\":8,\\\"bumper\\\":4,\\\"split\\\":5,\\\"bird\\\":7,\\\"bat\\\":6},\\\"dodged\\\":{\\\"rat\\\":1,\\\"fragment\\\":3,\\\"bumper\\\":1},\\\"smashed\\\":{\\\"boulder\\\":2,\\\"rat\\\":1,\\\"bumper\\\":3,\\\"split\\\":1,\\\"bird\\\":3,\\\"fragment\\\":1}},\\\"finish\\\":[{\\\"standings\\\":[[0,1]],\\\"scores\\\":{\\\"0\\\":925,\\\"1\\\":925},\\\"won\\\":false,\\\"stats\\\":{\\\"0\\\":{\\\"Tower floors\\\":8,\\\"Team score\\\":925,\\\"Rescued\\\":\\\"Still climbing\\\",\\\"Finish\\\":\\\"failed\\\"},\\\"1\\\":{\\\"Tower floors\\\":8,\\\"Team score\\\":925,\\\"Rescued\\\":\\\"Still climbing\\\",\\\"Finish\\\":\\\"failed\\\"}}}],\\\"departed\\\":false,\\\"actors\\\":[{\\\"id\\\":0,\\\"x\\\":211.80208333333232,\\\"z\\\":160,\\\"hurt\\\":0,\\\"power\\\":0},{\\\"id\\\":1,\\\"x\\\":214.93680555555483,\\\"z\\\":81.70833333333333,\\\"hurt\\\":0.75,\\\"power\\\":0}],\\\"diagnostics\\\":[{\\\"id\\\":0,\\\"active\\\":true,\\\"started\\\":true,\\\"ended\\\":false,\\\"finished\\\":true,\\\"server\\\":false,\\\"assignedId\\\":0,\\\"members\\\":[0,1],\\\"pendingEdges\\\":0,\\\"history\\\":0,\\\"sent\\\":1481,\\\"received\\\":1480,\\\"stale\\\":0,\\\"rejected\\\":0,\\\"bytes\\\":1458932,\\\"maxBytes\\\":1492,\\\"maxRoutineBytes\\\":1200,\\\"appliedEdges\\\":67,\\\"postEndSends\\\":0},{\\\"id\\\":1,\\\"active\\\":true,\\\"started\\\":true,\\\"ended\\\":false,\\\"finished\\\":false,\\\"server\\\":false,\\\"assignedId\\\":1,\\\"members\\\":[0,1],\\\"pendingEdges\\\":0,\\\"history\\\":0,\\\"sent\\\":1480,\\\"received\\\":1481,\\\"stale\\\":0,\\\"rejected\\\":0,\\\"bytes\\\":68312,\\\"maxBytes\\\":62,\\\"maxRoutineBytes\\\":50,\\\"appliedEdges\\\":0,\\\"postEndSends\\\":0}],\\\"route\\\":{\\\"latency\\\":0,\\\"jitter\\\":0,\\\"loss\\\":0,\\\"server\\\":false,\\\"helperLeave\\\":false}}\\n+ actual - expected\\n\\n+ 'failed'\\n- 'results'\\n\\n    at normalRoute (/home/micha/dev/cc-matrix/runs/gpt-6.1-sol-ultra.build-v2__20261106-044024__x4e9fbc/work/Beauty-and-the-Tall-Tale-Beauty-and-the-Beast-gpt-6.1-sol-ultra-20261106-044024/tests/network-route.cjs:178:9)\\n    at async runNetworkRoutes (/home/micha/dev/cc-matrix/runs/gpt-6.1-sol-ultra.build-v2__20261106-044024__x4e9fbc/work/Beauty-and-the-Tall-Tale-Beauty-and-the-Beast-gpt-6.1-sol-ultra-20261106-044024/tests/network-route.cjs:218:45)\"\n  },\n  {\n    \"name\": \"two-client degraded rescue\",\n    \"pass\": false,\n    \"error\": \"AssertionError [ERR_ASSERTION]: {\\\"seconds\\\":78.825,\\\"outcome\\\":{\\\"phase\\\":\\\"failed\\\",\\\"rescued\\\":false