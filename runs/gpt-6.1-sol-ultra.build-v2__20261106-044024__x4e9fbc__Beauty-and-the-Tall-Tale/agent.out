{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,135p' src/simulation.js && rg -n 'players|actors|power|window|phase|fromZ|hearts|departure' src/simulation.js | tail -35 && rg -n 'diagnostic|stats\\\\(|stop\\\\(' src/audio.js && sed -n '288,311p' src/network.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,135p' src/simulation.js && rg -n 'players|actors|power|window|phase|fromZ|hearts|departure' src/simulation.js | tail -35 && rg -n 'diagnostic|stats\\\\(|stop\\\\(' src/audio.js && sed -n '288,311p' src/network.js\"","aggregated_output":"/* Shared deterministic rules. No DOM, renderer, wall clock, storage or audio. */\n(() => {\n  \"use strict\";\n  const TT = (globalThis.TallTale = globalThis.TallTale || globalThis.TT || {});\n  globalThis.TT = TT;\n  const clamp = (x, a, b) => Math.max(a, Math.min(b, x));\n  const clone = (o) => JSON.parse(JSON.stringify(o));\n  const PHASES = [\"playing\", \"transition\", \"rooftop\", \"departure\", \"results\", \"failed\"];\n  const TYPES = [\"boulder\", \"bumper\", \"split\", \"rat\", \"bird\", \"bat\", \"fragment\"];\n  const STATES = [\"telegraph\", \"roll\", \"drop\", \"scurry\", \"approach\", \"cross\", \"swoop\", \"spent\"];\n  const round = (v) => Math.round(v * 100) / 100;\n  const neutral = () => ({ x: 0, up: false, down: false, jump: false, jumpPressed: false });\n  TT.neutralIntent = neutral;\n\n  function installWindowAction(E) {\n    if (E.ACTIONS.tallTaleWindow) return;\n    E.ACTIONS.tallTaleWindow = {\n      beats: [[\"climb\", 0.72]], hold: true,\n      setup(A) { A.beats = [[\"climb\", A.o.duration || 0.72]]; },\n      at(A, beat, u) {\n        const k = Math.min(1, u * 5), w = k * k * (3 - 2 * k);\n        return { x: A.start.x + (A.o.targetX - A.start.x) * w, y: 0,\n          z: A.o.fromZ + (A.o.toZ - A.o.fromZ) * u,\n          state: { climb: true, air: false, pose: \"tall-window\", expr: \"smile\" } };\n      },\n    };\n  }\n\n  // Relative swept AABB: the native overlap test handles static contact; the\n  // segment/slab check covers fast stones and two bodies crossing in one step.\n  function swept(E, a, b, pa, pb) {\n    if (E.overlapBox(a, b)) return true;\n    const dx = (a.x - pa.x) - (b.x - pb.x), dz = (a.z - pa.z) - (b.z - pb.z);\n    const ox = pa.x - pb.x, oz = pa.z - pb.z;\n    const xr = (a.w + b.w) / 2;\n    const low = -a.h, high = b.h;\n    let enter = 0, exit = 1;\n    for (const [p, d, lo, hi] of [[ox, dx, -xr, xr], [oz, dz, low, high]]) {\n      if (Math.abs(d) < 1e-9) { if (p <= lo || p >= hi) return false; }\n      else {\n        let a0 = (lo - p) / d, a1 = (hi - p) / d;\n        if (a0 > a1) [a0, a1] = [a1, a0];\n        enter = Math.max(enter, a0); exit = Math.min(exit, a1);\n        if (enter >= exit) return false;\n      }\n    }\n    return exit > 0 && enter < 1;\n  }\n  TT.sweptContact = swept;\n\n  class Simulation {\n    constructor(E, options = {}) {\n      this.E = E; installWindowAction(E);\n      this.seed = Number.isFinite(options.seed) ? options.seed : 1982;\n      this.rng = options.rng || E.rng(this.seed);\n      this.hard = !!options.hard; this.attract = !!options.attract;\n      this.config = { ...TT.DEFAULTS, ...options.config };\n      this.unranked = Object.keys(TT.DEFAULTS).some((k) => this.config[k] !== TT.DEFAULTS[k]);\n      this.invulnerable = false; this.tick = 0; this.time = 0; this.sectionTime = 0;\n      this.section = 0; this.phase = \"playing\"; this.score = 0; this.chances = 3;\n      this.continued = false; this.rescued = false; this.departureTime = 0;\n      this.transitionTime = 0; this.regroup = 0; this.roofBeat = 0;\n      this.ledger = {}; this.events = []; this.eventSerial = 0;\n      this.coverage = { windows: 0, jumps: 0, hearts: 0, hits: 0, reversals: 0, drops: 0,\n        splits: 0, sections: 0, rescue: 0, seen: {}, dodged: {}, smashed: {} };\n      const ps = options.players || [{ id: 1, seat: 1 }];\n      this.actors = ps.map((p, i) => this.makeActor(typeof p === \"number\" ? { id: p, seat: i + 1 } : { seat: i + 1, ...p }));\n      this.players = this.actors;\n      this._enterSection(0);\n    }\n    makeActor(p) {\n      const a = { id: p.id ?? p.seat ?? 1, seat: p.seat || 1, name: p.name || \"\",\n        body: new this.E.Platformer({ x: 48, z: 16, w: 9, h: 22, run: this.config.run,\n          jump: this.config.jump, gravity: this.config.gravity, fallGravity: this.config.gravity * 1.1 }),\n        traversal: null, action: null, power: 0, recovery: 0, hurt: 0,\n        finished: false, pose: null, jumpBuffer: 0, lastIntent: neutral(), windowCooldown: 0,\n        stats: { climbs: 0, jumps: 0, hearts: 0, clears: 0, hits: 0 },\n      };\n      for (const k of [\"x\", \"z\", \"vx\", \"vz\", \"facing\", \"onGround\", \"climbing\"]) Object.defineProperty(a, k, { get() { return this.body[k]; }, set(v) { this.body[k] = v; }, enumerable: false });\n      return a;\n    }\n    currentSection() { return TT.CONTENT.sections[this.section]; }\n    emit(type, data = {}) {\n      const event = { id: ++this.eventSerial, type, tick: this.tick, ...data };\n      this.events.push(event); if (this.events.length > 48) this.events.shift();\n      return event;\n    }\n    award(id, value, reason) {\n      if (Object.hasOwn(this.ledger, id)) return false;\n      this.ledger[id] = { value, reason }; this.score += value;\n      this.emit(\"score\", { award: id, value, reason }); return true;\n    }\n    _map(s) {\n      const rows = Array.from({ length: 17 }, () => Array(20).fill(\" \"));\n      const edge = Math.ceil(s.inset / 16);\n      for (let f = 0; f <= s.floors; f++) {\n        const cz = f * 3;\n        for (let x = edge; x < 20 - edge; x++) rows[16 - cz][x] = f ? \"=\" : \"#\";\n      }\n      return new this.E.PlatformMap({ rows: rows.map((r) => r.join(\"\")), legend: { \"#\": 1, \"=\": 2 },\n        types: { 1: { kind: \"solid\", style: \"brick\", side: s.palette.brick, top: s.palette.trim },\n          2: { kind: \"oneway\", style: \"stone\", side: s.palette.shadow, top: s.palette.trim } }, edges: \"open\" });\n    }\n    _enterSection(section, { checkpoint = true } = {}) {\n      this.section = clamp(section, 0, 3); const s = this.currentSection();\n      this.level = this._map(s); this.sectionTime = 0;\n      this.phase = this.section === 3 ? \"rooftop\" : \"playing\";\n      this.transitionTime = 0; this.regroup = 0; this.roofBeat = 0;\n      this.windows = s.windows.map((w) => ({ ...w, phase: \"closed\", remaining: 0, aperture: 0, usable: false }));\n      this.hazards = []; this.hearts = []; this.floorSeen = { 0: 0 }; this.spawned = {};\n      this.heartSpawned = {}; this.sectionHits = 0;\n      this.encounters = [...s.spawns, ...(this.hard ? TT.CONTENT.hard.combinations.filter((h) => h.floor < s.floors).map((h) => ({ ...h, id: `${s.id}-${h.id}` })) : [])];\n      for (const a of this.actors) {\n        const b = a.body;\n        b.x = s.startX + (a.seat - 1) * 18; b.z = 16; b.vx = b.vz = 0;\n        b.onGround = true; b.air = false; b.climbing = false; b.stun = b.drop = 0;\n        b._coy = b.coyote; b._cut = true;\n        a.traversal = a.action = null; a.hurt = a.power = 0; a.recovery = 1.5;\n        a.finished = false; a.jumpBuffer = 0; a.windowCooldown = 0; a.lastIntent = neutral();\n      }\n      this._updateWindows();\n      if (checkpoint) this.checkpoint = this.checkpointData();\n    }\n    checkpointData() {\n      return { v: 1, section: this.section, score: this.score, ledger: clone(this.ledger),\n        hard: this.hard, seed: this.seed, chances: Math.max(3, this.chances), time: this.time };\n    }\n    loadCheckpoint(cp) {\n      if (!cp || cp.v !== 1 || !Number.isInteger(cp.section) || cp.section < 0 || cp.section > 3 || !Number.isFinite(cp.score) || cp.score < 0 || cp.score > 100000 || typeof cp.ledger !== \"object\" || Array.isArray(cp.ledger)) return false;\n      let total = 0;\n      for (const v of Object.values(cp.ledger)) {\n        if (!v || !Number.isFinite(v.value) || v.value < 0 || v.value > 1000 || typeof v.reason !== \"string\") return false;\n        total += v.value;\n      }\n      if (total !== cp.score) return false;\n457:      this._schedule(); this._hearts(dt); this._hazards(dt); this._objectives(dt);\n464:      const a = this.actors.find((p) => p.id === id); if (!a || a.hurt || a.finished) return neutral();\n469:      const heart = this.hearts.filter((h) => !h.collected && h.floor === floor && h.age > 1.6 && h.age < h.life - 0.5)\n471:      if (heart && a.power < 1 && (Math.abs(heart.x - b.x) < 90 || this.section === 3 && floor >= 2)) goal = heart.targetX;\n473:        const ws = this.windows.filter((w) => w.floor === floor);\n474:        const usable = ws.find((w) => w.usable && (w.phase === \"open\" ? w.remaining + this.config.windowWarning : w.remaining) > Math.abs(w.x - b.x) / this.config.run + this.config.climbTime + 0.15);\n475:        const opening = ws.find((w) => w.phase === \"opening\");\n489:      if (danger && a.power <= 0 && b.onGround && !i.up) { i.jump = true; i.jumpPressed = true; }\n492:      if (airDanger && a.power <= 0 && !i.up) {\n501:        section: this.section, sectionTime: this.sectionTime, phase: this.phase, score: this.score, chances: this.chances,\n502:        continued: this.continued, rescued: this.rescued, departureTime: this.departureTime, transitionTime: this.transitionTime,\n504:        actors: this.actors.map((a) => ({ id: a.id, seat: a.seat, name: a.name, body: { ...a.body }, traversal: a.traversal,\n505:          power: a.power, recovery: a.recovery, hurt: a.hurt, finished: a.finished, pose: a.pose,\n506:          jumpBuffer: a.jumpBuffer, lastIntent: a.lastIntent, windowCooldown: a.windowCooldown, stats: a.stats })),\n507:        hazards: this.hazards, hearts: this.hearts, windows: this.windows, floorSeen: this.floorSeen, spawned: this.spawned,\n516:      for (const [k, v] of Object.entries(s)) if (![\"v\", \"actors\", \"windows\"].includes(k)) this[k] = v;\n517:      this.windows = s.windows;\n518:      this.actors = s.actors.map((data) => {\n520:        if (a.traversal) this._createAction(a, this.windows.find((w) => w.id === a.traversal.windowId));\n523:      this.players = this.actors; return this;\n527:        p: PHASES.indexOf(this.phase), sc: this.score, c: this.chances, r: +this.rescued, rb: this.roofBeat,\n528:        tr: round(this.transitionTime), d: round(this.departureTime), rg: round(this.regroup),\n529:        a: this.actors.map((a) => [a.id, a.seat, round(a.x), round(a.z), round(a.vx), round(a.vz),\n530:          a.traversal ? this.windows.findIndex((w) => w.id === a.traversal.windowId) : -1,\n531:          round(a.traversal?.progress || 0), round(a.power), round(a.recovery), round(a.hurt), +a.finished, a.body.facing]),\n533:        ht: this.hearts.filter((h) => !h.collected).map((h) => [h.id, round(h.x), round(h.z), round(h.age), h.floor, h.targetX, h.targetZ]),\n540:      this.tick = s.t; this.time = s.tm; this.sectionTime = s.st; this.phase = PHASES[s.p];\n542:      this.transitionTime = s.tr; this.departureTime = s.d; this.regroup = s.rg;\n544:      const old = new Map(this.actors.map((a) => [a.id, a]));\n545:      this.actors = s.a.map((v) => {\n548:        a.traversal = v[6] >= 0 ? { windowId: this.windows[v[6]].id, progress: v[7], from: this.windows[v[6]].z, to: this.windows[v[6]].toZ, startX: v[2] } : null;\n549:        a.power = v[8]; a.recovery = v[9]; a.hurt = v[10]; a.finished = !!v[11]; return a;\n550:      }); this.players = this.actors;\n552:      this.hearts = s.ht.map((v) => ({ id: v[0], x: v[1], z: v[2], age: v[3], floor: v[4], targetX: v[5], targetZ: v[6], collected: false, life: 12 }));\n557:    outcome() { return { phase: this.phase, rescued: this.rescued, score: this.score, chances: this.chances, section: this.section, continued: this.continued }; }\n349:\t\t\t\tosc.stop(t + d + 0.01);\n363:\t\t\t\t\ts.stop();\n368:\t\tstop() {\n372:\t\t\tfor (const h of this.handles) h.stop(0);\n388:\t\tstats() {\n420:\t\t\tthis.stop();\n423:\t\tstatic async diagnostic(Offline) {\n442:\t\t\t\to.stop(t + 0.1);\n\t\t\t\tthis.history.slice(),\n\t\t\t\tthis.pending.slice(),\n\t\t\t);\n\t\t\tthis.options.onSnapshot?.(m.w);\n\t\t}\n\n\t\tupdate(dt, now