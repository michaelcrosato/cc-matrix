{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('tools/check-browser.py');s=p.read_text().replace('a.state.sim.actors[0].body.z<60','a.state.sim.coverage.windows<1').replace('TallTaleApp.showTitle()','TallTaleApp.game.go(\\\\'title\\\\',null,{fade:0});TallTaleApp.game.advance(.02,{draw:false})')\ns=s.replace('ctx, page, errs, reqs = open_game(browser, viewport={\\\"width\\\":1280,\\\"height\\\":720}', 'ctx, page, errs, _reqs = open_game(browser, viewport={\\\"width\\\":1280,\\\"height\\\":720}')\ns=s.replace('except Exception as exc:', 'except Exception as exc:  # noqa: BLE001 -- Aggregate runner must record browser failures.')\np.write_text(s)\nPY\nruff check --fix tools/check-browser.py && ruff format tools/check-browser.py\nbiome check --write src/bootstrap.js src/style.css tools/build.mjs tools/verify.mjs package.json biome.json --max-diagnostics=15\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
