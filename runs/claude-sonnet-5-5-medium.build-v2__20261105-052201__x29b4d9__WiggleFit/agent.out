is.r() * 0.6) / T.sneezes);\n    for (const l of this.lanes) { if (l.kind === 'ghost') continue; l.calm = 0; l.peak = 0; l.inZ = 0; l.n = 0; l.warn = 0; l.fixedAnim = true; l.sn = 0; l.stifled = 0; l.pad = disc(1.1, 0.12, '#4DB760', l.x, 0.0, 0); this.group.add(l.pad); l.rings = []; l.rig.play('sit', 0); l.creatures = this.makeCreatures(l); l.stats = { calm: 0 }; }\n    this.camSnap = true;\n  }\n  makeCreatures(l) { const g = new THREE.Group(); g.position.x = l.x; this.group.add(g); const mk = (o) => { o.visible = false; g.add(o); return o; };\n    const fly = new THREE.Group(); fly.add(ball(0.04, '#3B82F6'), box(0.3, 0.01, 0.1, '#BFEAFF')); const frog = ball(0.14, '#6BCB5B'); const koi = ball(0.2, '#FF8A1F'); koi.scale.set(1.8, 0.5, 0.8); const turtle = ball(0.35, '#7A6A3A'); turtle.scale.y = 0.5;\n    return [mk(fly), mk(frog), mk(koi), mk(turtle)]; }\n  botIntent(lane, dt, it) { const [wx, wz] = lane.bot.steer(0, 0, lane.bal.cobX, lane.bal.cobZ, dt, true); it.wx = wx; it.wz = wz; it.flailEdge = lane.warn > 0 && lane.warn < 1.2 - lane.bot.skill.lag && !lane.flailed; if (it.flailEdge) lane.flailed = true; }\n  laneFixed(lane, it, dt) {\n    if (this.phase !== 'play') return; const b = lane.bal, T = this.T; const k = this.t / this.duration; b.sway = T.sw[0] + (T.sw[1] - T.sw[0]) * k; b.tremor = 0.05;\n    const d = Math.hypot(b.cobX, b.cobZ); const inz = d < T.r / 0.5 * 0.5 + 0.0 && d < T.r * 1.9; lane.n++; if (inz) { lane.inZ++; lane.calm = Math.min(1, lane.calm + dt / 30); } else lane.calm = Math.max(0, lane.calm - dt / 8); lane.peak = Math.max(lane.peak, lane.calm);\n    if (lane.sn < this.sneezeAt.length && this.t >= this.sneezeAt[lane.sn] && lane.warn <= 0) { lane.warn = 1.2; lane.flailed = false; lane.sn++; this.word('Ah... ah...', lane.x, 2.2); this.game.audio.sfx('gasp'); this.game.bark('stillwater', 'sneeze'); }\n    if (lane.warn > 0) { if (it.flailEdge) { lane.warn = 0; lane.stifled++; this.word('Hmph.', lane.x, 2.2); lane.flailed = true; } else { lane.warn -= dt; if (lane.warn <= 0) { b.shove(2.2 * (this.r() < 0.5 ? -1 : 1), 0, 0.3); this.word('ACHOO!', lane.x, 2.2); this.game.audio.sfx('whoosh'); } } }\n    const move = Math.hypot(b.leanX - (lane.pl ?? 0), b.leanZ - (lane.pz ?? 0)); lane.pl = b.leanX; lane.pz = b.leanZ; lane.ripple = (lane.ripple || 0) + move * 60;\n    lane.form = 100 * 0.5 * (lane.inZ / Math.max(1, lane.n) + lane.calm); lane.score = lane.form; lane.stats.calm = Math.round(lane.calm * 100);\n  }\n  step() { if (this.t >= this.duration) { for (const l of this.lanes) if (l.bal) l.form = 100 * 0.5 * (l.inZ / Math.max(1, l.n) + l.calm); this.finish(); } }\n  frameExtra() { for (const l of this.lanes) { if (!l.creatures) continue; const c = l.calm; l.creatures.forEach((m, i) => { m.visible = c > 0.2 * (i + 1) - 0.0 && (i < 3 || c > 0.6); }); const [fly, frog, koi, turtle] = l.creatures; fly.position.set(Math.sin(this.time * 2) * 0.3, 2.2 + Math.sin(this.time * 5) * 0.1, 0.3); frog.position.set(0, 2.0, 0); koi.position.set(Math.cos(this.time * 0.8) * 2.2, 0.1, Math.sin(this.time * 0.8) * 1.6); turtle.position.set(2.4, 0.15, 1.2); if (l.calm > 0.99) { this.heron.root.visible = true; this.heron.root.position.x = Math.min(l.x - 1.4, this.heron.root.position.x + 0.02); }\n      if ((l.ripple || 0) > 1 && l.rings.length < 8) { l.ripple = 0; const r = new THREE.Mesh(new THREE.TorusGeometry(1, 0.03, 4, 28), this.game.mat('#E8FBFF')); r.rotation.x = Math.PI / 2; r.position.set(l.x, 0.08, 0); r.userData.t = 0; this.group.add(r); l.rings.push(r); } for (let i = l.rings.length - 1; i >= 0; i--) { const r = l.rings[i]; r.userData.t += 1 / 60; r.scale.setScalar(1 + r.userData.t * 3); if (r.userData.t > 1.6) { r.removeFromParent(); l.rings.splice(i, 1); } } } }\n  discInfo(lane) { return { zone: { x: 0, z: 0, r: this.T.r * 1.9, good: true } }; }\n  hudInfo(lane) { return { score: lane.form, left: Math.max(0, this.duration - this.t), widgets: [{ id: 'c', html: `Calm <span class=\"meter\"><i style=\"width:${Math.round(lane.calm * 100)}%;background:#22C55E\"></i></span>` }, ...(lane.warn > 0 ? [{ id: 's', html: 'Ah... press Flail!' }] : [])] }; }\n  prompts() { return StillWater.intro.prompts; }\n}\nE\ncat > src/events/plank.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { GameEvent } from './base.js';\nimport { box, cyl, ball } from '../art/props.js';\nimport { createWalrus, createGull } from '../art/chars.js';\n\nconst TIERS = [{ dur: 30, every: 5, push: [0.2, 0.4], par: 85 }, { dur: 45, every: 4.5, push: [0.2, 0.4], par: 65 }, { dur: 60, every: 4, push: [0.25, 0.45], par: 58 }];\nexport class Plank extends GameEvent {\n  static id = 'plank'; static title = 'Plank & Perch'; static discipline = 'Strength'; static instructor = 'bolster'; static couch = false; static session = false; static music = 'strength'; static palette = 'noon';\n  static intro = { line: 'Hold a plank on a low beam. Gary and friends land on you and push the dot. Counter them with your weight.', can: 'You can flail to shake every gull off, for a small penalty.', cant: \"You can't stay out of the zone for long: two seconds outside is a belly flop.\", prompts: [['move', 'Counter'], ['flail', 'Shake off']] };\n  constructor(game, o) {\n    super(game, o); const T = this.T = TIERS[this.tier]; this.duration = o.duration || T.dur; this.paletteName = 'noon'; this.music = 'strength'; this.laneGap = 3.6;\n    this.makeGround(2.8, 4, '#E8D49A'); for (let i = 0; i < this.lanes.length; i++) this.group.add(box(2.6, 0.5, 0.7, '#B98A52', this.laneX(i), 0.25, 0));\n    this.coach = createWalrus(); this.coach.root.position.set(-3.6, 0, 0.4); this.coach.root.rotation.y = 0.5; this.group.add(this.coach.root); this.cam = { pos: [0, 2.2, 8], look: [0, 0.8, 0], fov: 38 };\n    this.addDolls({ margin: 0.8, ankleMax: 6 });\n    for (const l of this.lanes) { if (l.kind === 'ghost') continue; l.gulls = []; l.next = 3; l.out = 0; l.inZ = 0; l.n = 0; l.lastSide = 1; l.flop = 0; l.penalty = 0; l.fixedAnim = true; l.stats = { gulls: 0 }; l.rig.play('plank', 0); l.bal.sway = 0.1; l.bal.tremor = 0.04; }\n    this.camSnap = true;\n  }\n  botIntent(lane, dt, it) { const px = lane.gulls.reduce((a, g) => a + g.px, 0), pz = lane.gulls.reduce((a, g) => a + g.pz, 0); const [wx, wz] = lane.bot.steer(-px * 1.4, -pz * 1.4, lane.bal.cobX, lane.bal.cobZ, dt, true); it.wx = wx; it.wz = wz; lane.bt = (Math.hypot(lane.bal.cobX, lane.bal.cobZ) > 0.3 / 0.5 * 0.5 ? (lane.bt || 0) + dt : 0); it.flailEdge = lane.bt > 1.2 && lane.bal.leanDeg > 8; }\n  laneFixed(lane, it, dt) {\n    if (this.phase !== 'play') return; const b = lane.bal, T = this.T;\n    if (lane.flop > 0) { lane.flop -= dt; if (lane.flop <= 0) { lane.rig.play('plank', 0.2, { force: true }); b.wx = b.wz = 0; } return; }\n    if (this.t >= lane.next && lane.gulls.length < 6) { lane.next += T.every; const side = this.r() < 0.7 ? lane.lastSide : -lane.lastSide; lane.lastSide = side; const m = T.push[0] + (T.push[1] - T.push[0]) * this.r(); const g = createGull(); const idx = lane.gulls.length; g.root.position.set(lane.x, 0.2, 0); lane.doll.root.add(g.root); g.root.position.set((idx % 3 - 1) * 0.35, 1.0 + (idx % 2) * 0.2, 0.05); g.root.scale.setScalar(0.7); lane.gulls.push({ g, px: side * m * 0.5, pz: (this.r() - 0.5) * m * 0.4 }); this.game.audio.sfx('squawk'); this.word('SQUAWK', lane.x, 1.8); this.game.bark('bolster', 'gull'); }\n    b.pushX = lane.gulls.reduce((a, g) => a + g.px * 2, 0); b.pushZ = lane.gulls.reduce((a, g) => a + g.pz * 2, 0);\n    if (it.flailEdge) { for (const g of lane.gulls) g.g.root.removeFromParent(); lane.gulls = []; lane.penalty += 3; this.game.bark('bolster', 'plank'); }\n    const d = Math.hypot(b.cobX, b.cobZ); lane.n++; if (d < 0.56) { lane.inZ++; lane.out = 0; } else { lane.out += dt; if (lane.out > 2) { lane.flop = 1.6; lane.out = 0; lane.rig.play('flop', 0.1, { force: true }); this.word('SPLAT', lane.x, 1, 1); this.game.audio.sfx('fall'); for (const g of lane.gulls) g.g.root.removeFromParent(); lane.gulls = []; lane.floorEx++; } }\n    lane.stats.gulls = lane.gulls.length; const share = lane.inZ / Math.max(1, lane.n); lane.form = Math.max(0, Math.min(100, 100 * (share + 0.03 * lane.gulls.length) * 0.9 / (T.par / 100) * 0.9 - lane.penalty));\n  }\n  step() { if (this.t >= this.duration) this.finish(); }\n  afterRig(lane) { if (lane.bal && lane.rig.curName === 'plank') lane.doll.J.hips.rotation.z -= lane.bal.leanX * 0.8; }\n  discInfo() { return { zone: { x: 0, z: 0, r: 0.56, good: true } }; }\n  hudInfo(lane) { return { score: lane.form, left: Math.max(0, this.duration - this.t), widgets: [{ id: 'g', html: `Gulls <b>${lane.gulls ? lane.gulls.length : 0}</b>` }] }; }\n  prompts() { return Plank.intro.prompts; }\n}\nE\necho ok"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":514,"cache_read_input_tokens":487778,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":514},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cc2a51a5-f08a-42e7-afc4-8d441845bc15","uuid":"6d48f672-652f-46a0-95db-d69180e7e479","timestamp":"2026-11-05T13:29:49.435Z","request_id":"req_011Cgjrt935J2k6aqMRzQHFD","wire_tool_inputs":{"toolu_015b7SLAmgHMRJVKbiPj8i96":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-052201__x29b4d9/work/WiggleFit-WiiFit-claude-sonnet-5-5-medium-20261105-052201 && cat > src/events/stillWater.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { GameEvent } from './base.js';\nimport { box, cyl, disc, ball, cone } from '../art/props.js';\nimport { createHeron } from '../art/chars.js';\n\nconst TIERS = [{ r: 0.15, sw: [0.07, 0.18], sneezes: 2 }, { r: 0.12, sw: [0.1, 0.22], sneezes: 3 }, { r: 0.10, sw: [0.12, 0.26], sneezes: 4 }];\nexport class StillWater e