['quickLean', 'oneFoot', 'standStill'], classes: ['springboard', 'stillWater', 'islandLoop'], palette: 'noon', teach: 'Air control. Group Class invitation' },\n  { n: 5, name: 'Level Day', checks: ['best3'], classes: ['raft', 'tug', 'grandHold'], palette: 'golden', teach: 'The ending' },\n];\nexport const MAINT_POOL = ['poses', 'fruitHat', 'logReps', 'stepClass', 'cairn', 'roomService', 'plates', 'springboard', 'raft'];\nexport const CHECK_NAMES = { standStill: 'Stand Still', leanMatch: 'Lean Match', stepTime: 'Step Time', quickLean: 'Quick Lean', oneFoot: 'One-Foot Hold' };\nE\ncat > src/data/unlocks.js <<'E'\nexport const UNLOCKS = [\n  { at: 6, kind: 'hat', id: 1, name: 'Visor' }, { at: 14, kind: 'paint', id: 4, name: 'Plum paint' }, { at: 24, kind: 'hat', id: 2, name: 'Beret' },\n  { at: 36, kind: 'hat', id: 3, name: 'Bucket hat' }, { at: 50, kind: 'hat', id: 5, name: 'Wizard hat' }, { at: 60, kind: 'hat', id: 6, name: 'Tiny crown' },\n];\nexport const PAINT_UNLOCKS = { 4: 14, 5: 20, 6: 30, 7: 44, 8: 55, 9: 62 };\nexport const hatLocked = (id, marbles) => { const u = UNLOCKS.find((x) => x.kind === 'hat' && x.id === id); return u ? marbles < u.at : false; };\nexport const paintLocked = (id, marbles) => (id >= 4 ? marbles < (PAINT_UNLOCKS[id] || 14) : false);\nE\ncat > src/data/names.js <<'E'\nexport const FIRST = ['Gentle', 'Quiet', 'Brave', 'Sleepy', 'Dapper', 'Cheerful', 'Humble', 'Plucky', 'Gracious', 'Wobbly', 'Earnest', 'Tidy', 'Sunny', 'Mild', 'Spry'];\nexport const LAST = ['Margaret', 'Percival', 'Dorothea', 'Bartholomew', 'Winifred', 'Humphrey', 'Philippa', 'Cornelius', 'Beatrix', 'Reginald', 'Marigold', 'Ignatius', 'Tabitha', 'Lawrence', 'Ottoline'];\nexport function genName(r) { return FIRST[Math.floor(r() * FIRST.length)] + ' ' + LAST[Math.floor(r() * LAST.length)]; }\nE\ncat > src/data/poses.js <<'E'\nexport const POSES = [\n  { name: 'The Contented Heron', x: -0.35, z: 0 }, { name: 'The Apologetic Pine', x: 0, z: 0.4 }, { name: 'Half-Folded Deck Chair', x: 0, z: -0.35 }, { name: 'The Lighthouse Keeper', x: 0.4, z: 0 },\n  { name: 'Startled Flamingo', x: 0.35, z: 0.2 }, { name: 'The Long Goodbye', x: -0.2, z: 0.45 }, { name: \"Someone Else's Umbrella\", x: 0.45, z: -0.1 }, { name: 'The Quiet Regret', x: -0.4, z: -0.2 },\n];\nE\ncat > src/data/charts.js <<'E'\n// bars of 8 cells: L R B feet, < > ^ v lean, . rest\nexport const PATTERNS = ['L...R...', 'L.R.L.R.', 'L.R.B...', 'L.L.R.R.', '<...>...', 'L.R.<...', '^...v...', 'LRL.RLR.', 'B.B.LRB.', 'L.R.LRLR'];\nconst E = '........';\nfunction form(pats, leanOnly) { const [a, b, c, d] = pats; const bars = []; const add = (n, p) => { for (let i = 0; i < n; i++) bars.push(p[i % p.length]); };\n  add(4, [E]); add(8, [a, b]); add(8, [b, c, a, d]); add(8, [a, c, b, d]); add(4, leanOnly); add(8, [d, c, b, a]); add(4, [E]); return bars; }\nexport const CHARTS = [\n  { bpm: 104, bars: form([PATTERNS[0], PATTERNS[1], PATTERNS[2], PATTERNS[4]], [PATTERNS[4]]) },\n  { bpm: 116, bars: form([PATTERNS[3], PATTERNS[5], PATTERNS[6], PATTERNS[2]], [PATTERNS[4], PATTERNS[6]]) },\n  { bpm: 124, bars: form([PATTERNS[7], PATTERNS[8], PATTERNS[9], PATTERNS[5]], [PATTERNS[4], PATTERNS[6]]) },\n];\n// Session version: 24 bars at 116 with a 4-bar lean break\nexport const SESSION_CHART = { bpm: 116, bars: [E, E, PATTERNS[0], PATTERNS[1], PATTERNS[2], PATTERNS[1], PATTERNS[3], PATTERNS[2], PATTERNS[4], PATTERNS[6], PATTERNS[4], PATTERNS[6], PATTERNS[1], PATTERNS[5], PATTERNS[2], PATTERNS[3], PATTERNS[0], PATTERNS[1], PATTERNS[3], PATTERNS[2], PATTERNS[1], PATTERNS[0], E, E] };\nE\necho ok"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6537,"cache_read_input_tokens":208430,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6537},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cc2a51a5-f08a-42e7-afc4-8d441845bc15","uuid":"9dcbef72-9d37-45cd-b4b2-8a2de1a107f1","timestamp":"2026-11-05T12:37:38.845Z","request_id":"req_011CgjnwW2kjJEo9Df8YJxbt","wire_tool_inputs":{"toolu_01HYd5CgAVzhJu1aUY5QN7Ym":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-052201__x29b4d9/work/WiggleFit-WiiFit-claude-sonnet-5-5-medium-20261105-052201 && cat >> PROGRESS.md <<'E'\n- [x] input.js, glyphs.js, audio/* (instruments, tracks, sfx, voice, engine), anim/clips+rig, ragdoll, art/chars, events/base.js, events/fruitHat.js (balanced roughly: sharp ~22 raw, par set to ~26/32/36), ui/ui.css, ui/dom.js, test/headless.mjs (stub game for node runs)\n- DECISION: cut Still Water, Plank & Perch, Tug of Peace, Island Loop if short on budget (plan section 18 cut order). Must be honest in About.\n- Next: data tables (dialogue, programme, unlocks, names), game/game.js shell, screens, island, then events (poses, cairn, logReps, stepClass, plates, roomService, springboard, raft, grandHold), checkin, jar, hub session, attract, dev, group, tests, exit interview.\nE\ncat > src/data/events.js <<'E'\n// Registry: a designer adds an event by adding a line here and a file in src/events.\nimport { FruitHat } from '../events/fruitHat.js';\nexport const REGISTRY = [FruitHat];\nexport const byId = (id) => REGISTRY.find((e) => e.id === id);\nE\ncat > src/data/programme.js <<'E'\n// Day table: ids that are missing from the registry are skipped, so a cut event leaves a working programme.\nexport const DAYS = [\n  { n: 1, name: 'Arrival', checks: ['standStill', 'leanMatch', 'stepTime'], classes: ['poses', 'fruitHat'], palette: 'dawn', teach: 'Lean, flail, breath, the jar' },\n  { n: 2, name: 'The Second Day, Which Is Harder', checks: ['standStill', 'leanMatch', 'quickLean'], classes: ['logReps', 'stepClass', 'cairn'], palette: 'noon', teach: 'Feet, rhythm, stacking' },\n  { n: 3, name: 'Service With a Wobble', checks: ['oneFoot', 'leanMatch', 'stepTime'], classes: ['roomService', 'plates', 'plank'], palette: 'golden', teach: 'Stepping, stick circles. The Mirror opens' },\n  { n: 4, name: 'A Little Damp', checks: ['quickLean', 'oneFoot', 'standStill'], classes: ['springboard', 'stillWater', 'islandLoop'], palette: 'noon', teach: 'Air control. Group Class invitation' },\n  { n: 5, name: 'Level Day', checks: ['best3'], classes: ['raft', 'tug', 'grandHold'], palette: 'golden', teach: 'The ending' },\n];\nexport const MAINT_POOL = ['poses', 'fruitHat', 'logReps', 'stepClass', 'cairn', 'roomService', 'plates', 'springboard', 'raft'];\nexport const CHECK_NAMES = { standStill: 'Stand Still', leanMatch: 'Lean Match', stepTime: 'Step Time', quickLean: 'Quick Lean', oneFoot: 'One-Foot Hold' };\nE\ncat > src/data/unlocks.js <<'E'\nexport const UNLOCKS = [\n  { at: 6, kind: 'hat', id: 1, name: 'Visor' }, { at: 14, kind: 'paint', id: 4, name: 'Plum paint' }, { at: 24, kind: 'hat', id: 2, name: 'Beret' },\n  { at: 36, kind: 'hat', id: 3, name: 'Bucket hat' }, { at: 50, kind: 'hat', id: 5, name: 'Wizard hat' }, { at: 60, kind: 'hat', id: 6, name: 'Tiny crown' },\n];\nexport const PAINT_UNLOCKS = { 4: 14, 5: 20, 6: 30, 7: 44, 8: 55, 9: 62 };\nexport const hatLocked = (id, marbles) => { const u = UNLOCKS.find((x) => x.kind === 'hat' && x.id === id); return u ? marbles < u.at : false; };\nexport const paintLocked = (id, marbles) => (id >= 4 ? marbles < (PAINT_UNLOCKS[id] || 14) : false);\nE\ncat > src/data/names.js <<'E'\nexport const FIRST = ['Gentle', 'Quiet', 'Brave', 'Sleepy', 'Dapper', 'Cheerful', 'Humble', 'Plucky', 'Gracious', 'Wobbly', 'Earnest', 'Tidy', 'Sunny', 'Mild', 'Spry'];\nexport const LAST = ['Margaret', 'Percival', 'Dorothea', 'Bartholomew', 'Winifred', 'Humphrey', 'Philippa', 'Cornelius', 'Beatrix', 'Reginald', 'Marigold', 'Ignatius', 'Tabitha', 'Lawrence', 'Ottoline'];\nexport function genName(r) { return FIRST[Math.floor(r() * FIRST.length)] + ' ' + LAST[Math.floor(r() * LAST.length)]; }\nE\ncat > src/data/poses.js <<'E'\nexport const POSES = [\n  { name: 'The Contented Heron', x: -0.35, z: 0 }, { name: 'The Apologetic Pine', x: 0, z: 0.4 }, { name: 'Half-Folded Deck Chair', x: 0, z: -0.35 }, { name: 'The Lighthouse Keeper', x: 0.4, z: 0 },\n  { name: 'Startled Flamingo', x: 0.35, z: 0.2 }, { name: 'The Long Goodbye', x: -0.2, z: 0.45 }, { name: \"Someone Else's Umbrella\", x: 0.45, z: -0.1 }, { name: 'The Quiet Regret', x: -0.4, z: -0.2 },\n];\nE\ncat > src/data/charts.js <<'E'\n// bars of 8 cells: L R B feet, < > ^ v lean, . rest\nexport const PATTERNS = ['L...R...', 'L.R.L.R.', 'L.R.B...', 'L.L.R.R.', '<...>...', 'L.R.<...', '^...v...', 'LRL.RLR.', 'B.B.LRB.', 'L.R.LRLR'];\nconst E = '........';\nfunction form(pats, leanOnly) { const [a, b, c, d] = pats; const bars = []; const add = (n, p) => { for (let i = 0; i < n; i++) bars.push(p[i % p.length]); };\n  add(4, [E]); add(8, [a, b]); add(8, [b, c, a, d]); add(8, [a, c, b, d]); add(4, leanOnly); add(8, [d, c, b, a]); add(4, [E]); return bars; }\nexport const CHARTS = [\n  { bpm: 104, bars: form([PATTERNS[0], PATTERNS[1], PATTERNS[2], PATTERNS[4]], [PATTERNS[4]]) },\n  { bpm: 116, bars: form([PATTERNS[3], PATTERNS[5], PATTERNS[6], PATTERNS[2]], [PATTERNS[4], PATTERNS[6]]) },\n  { bpm: 124, bars: form([PATTERNS[7], PATTERNS[8], PATTERNS[9], PATTERNS[5]], [PATTERNS[4], PATTERNS[6]]) },\n];\n// Session version: 24 bars at 116 with a 4-bar lean break\nexport const SESSION_CHART = { bpm: 116, bars: [E, E, PATTERNS[0], PATTERNS[1], PATTERNS[2], PATTERNS[1], PATTERNS[3], PATTERNS[2], PATTERNS[4], PATTERNS[6], PATTERNS[4], PATTERNS[6], PATTERNS[1], PATTERNS[5], PATTERNS[2], PATTERNS[3], PATTERNS[0], PATTERNS[1], PATTERNS[3], PATTERNS[2], PATTERNS[1], PATTERNS[0], E, E] };\nE\necho ok"}},"wire_ingest_context":{"toolu_01HYd5CgAVzhJu1aUY5QN7Ym":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-052201__x29b4d9/work/WiggleFit-WiiFit-claude-sonnet-5-5-medium-20261105-052201"}}}
