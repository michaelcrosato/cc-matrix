.ask;\n    else if (['A', 'B', 'X', 'Y'].includes(k)) { const x = XB[{ A: 'ok', B: 'back', X: 'flail', Y: 'ask' }[k]]; inner = circ(x[1], `<text x=\"20\" y=\"27\" text-anchor=\"middle\" font-size=\"20\" font-weight=\"700\" fill=\"${INKC}\" font-family=\"Fredoka,sans-serif\">${k}</text>`); }\n    else if (k === 'stick') inner = stick('L'); else if (k === 'rstick') inner = stick('R'); else if (k === 'dpad') inner = dpad;\n    else if (k.includes(' ')) inner = k.split(' ').map((t) => pill(t)).join(''); else inner = pill(k);\n    return tag(inner, id);\n  }\n  const m = { move: cap('WASD'), look: mouse('R'), nav: cap('Arrows'), both: mouse('LR'), feetL: mouse('L') + cap('Q'), feetR: mouse('R') + cap('E'), feet: mouse('LR') + cap('Q') + cap('E'), flail: cap('F') + mouse('M'), hop: cap('Space') };\n  if (m[action]) return tag(m[action], 'kbm:' + action);\n  return tag(cap(KEY[action] || action), 'kbm:' + (KEY[action] || action));\n}\nexport function promptBar(items, device, set) {\n  return items.map(([a, label]) => `<span class=\"pr\">${glyph(a, device, set)}<span class=\"pl\">${label}</span></span>`).join('');\n}\nE\necho ok"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1091,"cache_read_input_tokens":138175,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1091},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cc2a51a5-f08a-42e7-afc4-8d441845bc15","uuid":"ea03bb1c-590a-4dd6-a046-4b66cd3e987f","timestamp":"2026-11-05T12:29:23.088Z","request_id":"req_011CgjnKKh9aVMPnxcWVW2dJ","wire_tool_inputs":{"toolu_01V8yZk8srKvs98xyKPxQK7Z":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261105-052201__x29b4d9/work/WiggleFit-WiiFit-claude-sonnet-5-5-medium-20