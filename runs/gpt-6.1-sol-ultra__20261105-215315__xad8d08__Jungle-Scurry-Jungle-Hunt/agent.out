{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' network-smoke.py && sed -n '1,160p' tests/hub-test.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' network-smoke.py && sed -n '1,160p' tests/hub-test.py\"","aggregated_output":"\"\"\"Transport-only checks; run via project's unified test command when integrated.\"\"\"\nimport os\nfrom playwright.sync_api import sync_playwright\n\nbase = os.environ.get('GAME_TEST_ORIGIN', 'http://127.0.0.1:42199')\nerrors = []\nchecks = 0\n\ndef check(condition, name):\n    global checks\n    checks += 1\n    if not condition:\n        errors.append(name)\n\nwith sync_playwright() as p:\n    browser = p.chromium.launch(headless=True)\n    context = browser.new_context()\n    host = context.new_page()\n    guest = context.new_page()\n    try:\n        for page in [host, guest]:\n            page.goto(base + '/network.js')\n            page.evaluate(\"\"\"async () => {\n              const {ExpeditionNet} = await import('./network.js');\n              window.events = {starts:0, inputs:[], states:[], leaves:[], finish:null};\n              window.net = new ExpeditionNet({\n                onStart: () => events.starts++,\n                onInput: (input,id) => events.inputs.push({input,id}),\n                onState: state => events.states.push(state),\n                onLeave: leave => events.leaves.push(leave),\n                onFinish: result => events.finish = result\n              });\n            }\"\"\")\n        check(host.evaluate('net.mode === \"solo\" && net.isHost'), 'Initial solo transport')\n        offer = host.evaluate('net.createOffer({iceServers:[]})')\n        answer = guest.evaluate('(offer) => net.acceptOffer(offer,{iceServers:[]})', offer)\n        host.evaluate('(answer) => net.acceptAnswer(answer)', answer)\n        host.wait_for_function('net.connected', timeout=15000)\n        guest.wait_for_function('net.connected', timeout=15000)\n        check(host.evaluate('net.players.length===2') and guest.evaluate('net.me===1 && !net.isHost'), 'Direct handshake and seats')\n        host.evaluate('net.begin({seed:27})')\n        guest.wait_for_function('events.starts===1')\n        check(guest.evaluate('net.canPlay'), 'Direct start lifecycle')\n        host.evaluate('net.sendState({stage:3,x:56},true)')\n        guest.evaluate('net.sendInput({x:1,jump:true},true)')\n        guest.wait_for_function('events.states.length>0')\n        host.wait_for_function('events.inputs.length>0')\n        check(guest.evaluate('events.states[0].stage===3'), 'Host snapshots reach guest')\n        check(host.evaluate('events.inputs[0].id===1 && events.inputs[0].input.jump'), 'Guest inputs reach host')\n        host.evaluate('net.finish({scores:{0:50,1:70},won:true})')\n        guest.wait_for_function('events.finish !== null')\n        check(guest.evaluate('events.finish.won && events.finish.standings[0].length===2'), 'Direct team finish')\n        guest.evaluate('net.leave()')\n        host.wait_for_function('!net.connected')\n        check(host.evaluate('events.leaves.length===1'), 'Direct disconnect lifecycle')\n    except Exception as exc:\n        errors.append(str(exc))\n    finally:\n        browser.close()\nfor error in errors:\n    print('FAIL ' + error)\nprint(f'{checks-len(errors)}/{checks} direct network checks passed')\nraise SystemExit(bool(errors))\n\"\"\"Official AI Hub protocol conformance, reusable by the unified test runner.\n\nAPI: failures, test_count = test_hub(browser, base_url, game_filename)\nThe caller owns browser/server lifetime. One page/context runs at a time.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nfrom pathlib import Path\nfrom urllib.parse import urlencode\n\nPROJECT = Path(__file__).resolve().parents[1]\nDEFAULT_GAME = PROJECT.name + '.html'\n\n\ndef test_hub(browser, base_url, game_filename=DEFAULT_GAME, scenarios=None):\n    \"\"\"Run the unmodified official harness and return (failures, count).\"\"\"\n    if scenarios is None:\n        scenarios = (\n            ('standard', {'players': 2}),\n            ('adverse-network', {'players': 2, 'latency': 150, 'jitter': 50, 'loss': 5}),\n            ('server', {'players': 2, 'scenario': 'server'}),\n            ('host-leave', {'players': 2, 'scenario': 'host-leave'}),\n        )\n    failures = []\n    test_count = 0\n    reports = []\n    for name, config in scenarios:\n        context = browser.new_context(viewport={'width': 1440, 'height': 900})\n        page = context.new_page()\n        page_errors = []\n        page.on('pageerror', lambda error: page_errors.append(str(error)))\n        parameters = {\n            'game': '../' + game_filename.lstrip('/'),\n            'auto': 1,\n            'play': 4000,\n            'limit': 120,\n            **config,\n        }\n        url = base_url.rstrip('/') + '/' + PROJECT.name + '/harness.html?' + urlencode(parameters)\n        try:\n            page.goto(url, wait_until='domcontentloaded', timeout=30000)\n            page.wait_for_function(\n                \"document.body.dataset.complete === 'true' && window.__hubCheck?.done\",\n                timeout=120000,\n            )\n            report = page.evaluate('window.__hubCheck')\n            reports.append({'scenario': name, **report})\n            for result in report.get('checks', []):\n                test_count += 1\n                if not result.get('pass'):\n                    detail = result.get('detail', '')\n                    failures.append(f\"Hub {name}: {result['name']}\" + (f' — {detail}' if detail else ''))\n            test_count += 1\n            if not report.get('pass'):\n                failures.append(f'Hub {name}: overall official harness result failed')\n            test_count += 1\n            if page_errors:\n                failures.append(f'Hub {name}: browser errors — ' + '; '.join(page_errors[:5]))\n        except Exception as error:\n            test_count += 1\n            detail = str(error).split('\\n')[0]\n            try:\n                report = page.evaluate('window.__hubCheck || null')\n                if report:\n                    reports.append({'scenario': name, **report})\n                    failed = [r for r in report.get('checks', []) if not r.get('pass')]\n                    if failed:\n                        detail += '; ' + '; '.join(r['name'] + ': ' + r.get('detail', '') for r in failed)\n                    detail += '; ' + '; '.join(report.get('log', [])[-4:])\n            except Exception:\n                pass\n            failures.append(f'Hub {name}: {detail}')\n        finally:\n            context.close()\n    (PROJECT / 'tests' / 'hub-results.json').write_text(json.dumps(reports, indent=2))\n    return failures, test_count\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('base_url', help='Root workspace HTTP origin, e.g. http://127.0.0.1:43210')\n    parser.add_argument('game_filename', nargs='?', default=DEFAULT_GAME)\n    parser.add_argument('--scenario', choices=['standard', 'server', 'host-leave', 'adverse-network'])\n    args = parser.parse_args()\n    from playwright.sync_api import sync_playwright\n\n    scenarios = None\n    if args.scenario:\n        config = {'players': 2}\n        if args.scenario in ('server', 'host-leave'):\n            config['scenario'] = args.scenario\n        elif args.scenario == 'adverse-network':\n            config.update(latency=150, jitter=50, loss=5)\n        scenarios = [(args.scenario, config)]\n    with sync_playwright() as playwright:\n        browser = playwright.chromium.launch(headless=True, args=[\n            '--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-webgpu-adapter=swiftshader',\n        ])\n        try:\n            failures, count = test_hub(browser, args.base_url, args.game_filename, scenarios)\n        finally:\n            browser.close()\n    for failure in failures:\n        print('FAIL ' + failure)\n    print(f'{count - len(failures)}/{count} Hub checks passed')\n    return bool(failures)\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
