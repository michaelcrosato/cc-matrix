ores: Object.fromEntries(this.players.map(p => [p.id, Number(scores[p.id] || 0)])), won: !!won };\n    if (stats && typeof stats === 'object') {\n      const perPlayer = this.players.some(p => stats[p.id] && typeof stats[p.id] === 'object');\n      result.stats = Object.fromEntries(this.players.map(p => [p.id, clone(perPlayer ? (stats[p.id] || {}) : stats)]));\n    }\n    if (awards) result.awards = awards;\n    if (this.mode === 'hub') globalThis.AIHub.finish(result);\n    else this._send({ t: 'finish', result });\n    return true;\n  }\n\n  /** Nearby tabs on the same origin. No backend, accounts, chat, or public room directory. */\n  hostRoom(code = '') {\n    this._assertStandalone();\n    this.leave();\n    if (typeof BroadcastChannel !== 'function') throw new Error('Nearby play is unavailable in this browser. Use a direct connection code.');\n    this.mode = 'room';\n    this.isHost = true;\n    this.me = 0;\n    this.room = normalizeRoom(code) || Math.random().toString(36).slice(2, 8).toUpperCase();\n    this._hostIdentity = this._identity;\n    this._channel = new BroadcastChannel(`${GAME}:${this.room}`);\n    this._channel.onmessage = (event) => this._receive(event.data);\n    this._status(`Camp ${this.room} · waiting for Scout Two`);\n    this._timers.push(setInterval(() => {\n      this._send({ t: 'ping' });\n      if (this.connected && now() - this._lastPeerAt > 7000) this._peerLeft('Connection lost');\n    }, 1500));\n    return this.room;\n  }\n\n  joinRoom(code) {\n    this._assertStandalone();\n    const room = normalizeRoom(code);\n    if (!room) throw new Error('Enter the host’s camp code first.');\n    this.leave();\n    if (typeof BroadcastChannel !== 'function') throw new Error('Nearby play is unavailable in this browser. Use a direct connection code.');\n    this.mode = 'room';\n    this.isHost = false;\n    this.me = 1;\n    this.room = room;\n    this.players = [{ id: 1, name: 'Scout Two', color: COLORS[1] }];\n    this._channel = new BroadcastChannel(`${GAME}:${room}`);\n    this._channel.onmessage = (event) => this._receive(event.data);\n    this._status(`Finding camp ${room}…`);\n    this._send({ t: 'hello' });\n    this._timers.push(setInterval(() => {\n      if (!this.connected) this._send({ t: 'hello' });\n      else if (now() - this._lastPeerAt > 7000) this._peerLeft('Host connection lost');\n    }, 1000));\n    return room;\n  }\n\n  _assertStandalone() {\n\t\t\t\t\tworld.player.getObjectByName(name),\n\t\t\t\t\t`missing native animation target ${name}`,\n\t\t\t\t);\n\t\t});\n\t}\n\tcheck(\"stale actors and collected fruit are removed\", () => {\n\t\tworld.setStage(1);\n\t\tworld.update(0.016, {\n\t\t\tstage: 1,\n\t\t\ttime: 3,\n\t\t\tplayer: { x: 4, y: 5, swinging: -1 },\n\t\t\tenemies: [],\n\t\t\tpickups: [],\n\t\t\tghost: null,\n\t\t});\n\t\tassert.equal(world.ghost.visible, false);\n\t\tassert.ok(\n\t\t\tworld.root.children[2].children.every(\n\t\t\t\t(o) => o === world.player || o === world.ghost,\n\t\t\t),\n\t\t);\n\t});\n}\nconsole.log(`${checks - failures}/${checks} world checks passed`);\nif (failures) process.exitCode = 1;\n","exit_code":0,"status":"completed"}}
