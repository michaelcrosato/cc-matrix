{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"cat > game.js <<'EOF'\nexport const DEFAULTS=Object.freeze({moveSpeed:7.2,jumpPower:10.8,gravity:22,swingPower:2.7,oxygen:15,hazardSpeed:1,damage:1,assist:1,timeScale:1});\nexport const CHAPTERS=[\n {name:'THE EMERALD CANOPY',short:'Canopy',subtitle:'A leap of faith. A very long way down.',goal:'Catch the vines. Reach the far bank.',length:79,color:'#b7d760'},\n {name:'CROCODILE CREEK',short:'Creek',subtitle:'Keep your hat dry. Watch the teeth.',goal:'Swim right. Surface for air. Knife to stun.',length:87,color:'#69d7c4'},\n {name:'THE RUMBLING RISE',short:'Rise',subtitle:'The hill has a few things to get off its chest.',goal:'Jump low boulders. Duck under the high ones.',length:87,color:'#efb85b'},\n {name:'THE SUNBELL RESCUE',short:'Rescue',subtitle:'Three bells. One botanist. Just in time for tea.',goal:'Ring all three Sunbells. Free Professor Pip\"'!'\"',length:56,color:'#eda486'}\n];\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nexport class JungleGame{\n constructor(RAPIER,onEvent=()=>{}){this.R=RAPIER;this.onEvent=onEvent;this.tuning={...DEFAULTS};this.stage=0;this.time=0;this.elapsed=0;this.score=0;this.fruit=0;this.deaths=0;this.bells=0;this.won=false;this.pending=false;this.auto=false;this.god=false;this.difficulty='adventure';this.checkpoint=4;this.statistics={jumps:0,grabs:0,stuns:0,ducks:0,bells:0,stages:0};this.setup(0);}\n emit(type,data={}){this.onEvent(type,data);}\n floor(x){return this.stage===0?(x<9||x>69?3:-30):this.stage===1?0:this.stage===2?1+x*.045:1;}\n setup(stage,keepScore=true){\n  if(this.world)this.world.free();this.stage=stage;this.pending=false;this.won=false;this.stageTime=0;this.bells=0;this.checkpoint=4;this.lastSpawn=0;this.enemies=[];this.pickups=[];this.vines=[];this.players=[];this.boulders=[];this.bubbleTime=0;\n  const R=this.R;this.world=new R.World({x:0,y:-this.tuning.gravity,z:0});this.world.timestep=1/60;this.controller=this.world.createCharacterController(.035);this.controller.enableAutostep(.35,.2,true);this.controller.enableSnapToGround(.2);this.controller.setSlideEnabled(true);\n  const ground=(x,y,hx,hy,angle=0)=>{let rb=this.world.createRigidBody(R.RigidBodyDesc.fixed().setTranslation(x,y,0).setRotation({x:0,y:0,z:Math.sin(angle/2),w:Math.cos(angle/2)}));this.world.createCollider(R.ColliderDesc.cuboid(hx,hy,3).setFriction(.8),rb);};\n  if(stage===0){ground(0,1,9,2);ground(80,1,10,2);for(let i=0;i<7;i++)this.vines.push({x:7+i*11,y:13.5,length:8.8,angle:Math.sin(i*.65)*.64,index:i});for(let i=0;i<12;i++)this.pickups.push({x:12+i*5.1,y:5.5+Math.sin(i*.85)*2,type:'fruit',taken:false});}\n  else if(stage===1){ground(45,-1,54,1);for(let i=0;i<8;i++)this.enemies.push({type:'croc',x:17+i*9,y:2.0+(i%3)*1.4,baseX:17+i*9,baseY:2+(i%3)*1.4,phase:i*1.7,active:true,stun:0});for(let i=0;i<14;i++)this.pickups.push({x:9+i*5.4,y:1.5+(i%3)*1.4,type:i%4===0?'air':'fruit',taken:false});}\n  else if(stage===2){ground(45,1+45*.045-1,55,1,Math.atan(.045));for(let i=0;i<13;i++)this.pickups.push({x:10+i*5.5,y:this.floor(10+i*5.5)+2.1+(i%2)*1.3,type:'fruit',taken:false});this.spawnBoulder(24,0);this.spawnBoulder(41,1);this.spawnBoulder(61,0);this.spawnBoulder(78,1);}\n  else {ground(30,-1,42,2);for(let i=0;i<3;i++){const x=15+i*16;this.pickups.push({type:'bell',x,y:2.25,taken:false,index:i});}for(let i=0;i<6;i++)this.pickups.push({type:'fruit',x:8+i*8,y:3.8+(i%2),taken:false});for(let i=0;i<4;i++)this.enemies.push({type:'beetle',x:10+i*11,y:1.6,baseX:10+i*11,phase:i*1.2,active:true,stun:0});}\n  this.addPlayer(1);if(this.coop)this.addPlayer(2);if(\"'!keepScore){this.score=0;this.fruit=0;this.elapsed=0;this.deaths=0;this.statistics={jumps:0,grabs:0,stuns:0,ducks:0,bells:0,stages:0};}this.emit('\"'stage',{stage});\n }\n addPlayer(id){if(this.players.some(p=>p.id===id))return;const R=this.R;const x=id===1?4:2.6,y=this.stage===0?3:this.stage===1?6:this.floor(x);const body=this.world.createRigidBody(R.RigidBodyDesc.kinematicPositionBased().setTranslation(x,y+.9,0));const collider=this.world.createCollider(R.ColliderDesc.capsule(.55,.35).setFriction(0),body);const p={id,x,y,vx:0,vy:0,body,collider,health:3,oxygen:this.tuning.oxygen,onGround:false,swinging:-1,theta:0,omega:0,face:1,attack:0,duck:false,hit:0,grabLock:0,lastVine:-1,jumpBuffer:0,coyote:0,score:0,checkpoint:4,finished:false};this.players.push(p);return p;}\n setCoop(v){this.coop=v;if(v)this.addPlayer(2);else if(this.players.length>1){const p=this.players.pop();this.world.removeRigidBody(p.body);}}\n spawnBoulder(x,high){const R=this.R;const radius=high?.95:.7;let y=this.floor(x)+radius+(high?2.4:0);const rb=this.world.createRigidBody(R.RigidBodyDesc.kinematicPositionBased().setTranslation(x,y,0));this.world.createCollider(R.ColliderDesc.ball(radius).setSensor(true),rb);const e={type:'boulder',x,y,radius,high,active:true,body:rb,angle:0};this.enemies.push(e);this.boulders.push(e);}\n restart(){this.setup(0,false);}\n retry(){this.deaths++;this.setup(this.stage);this.emit('retry');}\n next(){if(this.stage<3)this.setup(this.stage+1);else{this.won=true;this.pending=false;this.emit('win');}}\n teleport(p,x,y){p.x=x;p.y=y;p.vx=0;p.vy=0;p.swinging=-1;p.grabLock=.5;p.body.setTranslation({x,y:y+.9,z:0},true);p.body.setNextKinematicTranslation({x,y:y+.9,z:0});}\n damage(p,cause){if(this.god||this.auto||p.hit>0||p.finished)return;p.health-=this.tuning.damage;p.hit=1.8;this.emit('hit',{id:p.id,cause});if(p.health<=0){if(this.coop){p.health=3;this.teleport(p,Math.max(3,this.players.find(q=>q\"'!==p)?.x-2||4),this.stage===1?6:this.floor(p.x));this.emit('\"'revive',{id:p.id});}else{this.pending=true;this.emit('defeat',{cause});}}}\n checkpointPlayer(p){if(this.stage===0){const v=this.vines[Math.max(0,p.lastVine)];this.teleport(p,v.x,3.5);p.swinging=v.index;p.theta=0;p.omega=.6;}else this.teleport(p,p.checkpoint,this.stage===1?6:this.floor(p.checkpoint));}\n bot(p){\n  const out={x:1,y:0,jump:false,action:false,duck:false};\n  if(this.stage===0){if(p.swinging>=0){out.x=1;if(p.theta>.44&&p.omega>.12)out.jump=true;}else if(p.onGround)out.jump=true;if(this.stageTime>3&&p.y<-1){const v=this.vines.find(v=>v.x>p.x-2)||this.vines.at(-1);p.swinging=v.index;p.lastVine=v.index;p.theta=-.6;p.omega=1.4;}if(this.auto&&p.swinging>=0&&p.x>65&&p.theta>.3){out.jump=true;}}\n  if(this.stage===1){out.y=Math.sin(this.stageTime*1.2)*.65;out.action=this.stageTime%1<.06;if(p.oxygen<4)out.y=1;}\n  if(this.stage===2){let threat=this.enemies.find(e=>e.active&&e.x>p.x&&e.x-p.x<5);if(threat){out.jump=\"'!threat.high&&p.onGround;out.duck=!!threat.high;}}\n  if(this.stage===3){const bell=this.pickups.find(c=>c.type==='\"'bell'&&\"'!c.taken);if(bell&&Math.abs(bell.x-p.x)<2.2){out.x=0;out.action=true;}const e=this.enemies.find(e=>e.active&&e.stun<=0&&Math.abs(e.x-p.x)<3);if(e){out.action=true;out.jump=p.onGround;}if(this.bells<3&&p.x>50)out.x=-1;}\n  return out;\n }\n step(dt,inputs={}){\n  if(this.won||this.pending)return;dt=Math.min(dt,.0334)*this.tuning.timeScale;this.time+=dt;this.elapsed+=dt;this.stageTime+=dt;this.world.timestep=dt;this.world.gravity.y=-this.tuning.gravity;\n  this.vines.forEach(v=>v.angle=Math.sin(this.time*1.6+v.index*.65)*.64);\n  for(const e of this.enemies){e.stun=Math.max(0,(e.stun||0)-dt);if(e.type==='\"'croc'){e.x=e.baseX+Math.sin(this.time*.7+e.phase)*3;e.y=e.baseY+Math.sin(this.time*.9+e.phase)*.45;}if(e.type==='beetle'){e.x=e.baseX+Math.sin(this.time*1.2+e.phase)*3.5;e.y=1.5+Math.abs(Math.sin(this.time*3+e.phase))*.25;}if(e.type==='boulder'){e.x-=((e.high?6.6:5.1)*this.tuning.hazardSpeed)*dt;e.y=this.floor(e.x)+e.radius+(e.high?2.35:0)+Math.abs(Math.sin(this.time*2+e.x))*(e.high?.28:.08);e.angle+=dt*5;e.body.setNextKinematicTranslation({x:e.x,y:e.y,z:0});if(e.x<-8){e.active=false;}}}\n  if(this.stage===2&&this.stageTime-this.lastSpawn>3.4/Math.max(.3,this.tuning.hazardSpeed)){this.lastSpawn=this.stageTime;this.spawnBoulder(Math.min(100,Math.max(...this.players.map(p=>p.x))+29),Math.floor(this.stageTime/3.4)%2);if(this.boulders.length>24){const old=this.boulders.shift();this.world.removeRigidBody(old.body);this.enemies=this.enemies.filter(x=>x\"'!==old);}}\n  for(const p of this.players){\n   if(p.finished)continue;let input=this.auto?this.bot(p):(inputs[p.id]||{});let mx=clamp(input.x||0,-1,1),my=clamp(input.y||0,-1,1);p.hit=Math.max(0,p.hit-dt);p.attack=Math.max(0,p.attack-dt);p.grabLock=Math.max(0,p.grabLock-dt);p.duck=!!input.duck&&this.stage!==1&&p.onGround;p.jumpBuffer=Math.max(0,p.jumpBuffer-dt);p.coyote=p.onGround?.13:Math.max(0,p.coyote-dt);if(input.jump)p.jumpBuffer=.15;if(mx)p.face=Math.sign(mx);\n   if(input.action&&p.attack<=0){p.attack=.45;this.emit(this.stage===1?'\"'attack':'swish',{id:p.id});}\n   let desired={x:0,y:0,z:0},swing=false;\n   if(this.stage===1){p.swinging=-1;p.onGround=false;p.vx=mx*this.tuning.moveSpeed*.8;p.vy=(my-(input.duck?1:0))*this.tuning.moveSpeed*.65;p.y=clamp(p.y,.12,6.1);if(p.y>5.35)p.oxygen=Math.min(this.tuning.oxygen,p.oxygen+dt*5);else p.oxygen-=dt;if(p.oxygen<0){this.damage(p,'out of breath');p.oxygen=5;this.teleport(p,p.x,6);}desired.x=p.vx*dt;desired.y=p.vy*dt;}\n   else if(p.swinging>=0){swing=true;const v=this.vines[p.swinging];p.omega+=(-this.tuning.gravity/v.length*Math.sin(p.theta)+mx*this.tuning.swingPower)*dt;p.omega*=1-dt*.14;p.omega=clamp(p.omega,-2.3,2.3);p.theta=clamp(p.theta+p.omega*dt,-1.2,1.2);v.angle=p.theta;p.x=v.x+Math.sin(p.theta)*v.length;p.y=v.y-Math.cos(p.theta)*v.length-1.5;p.vx=Math.cos(p.theta)*p.omega*v.length;p.vy=Math.sin(p.theta)*p.omega*v.length;if(p.jumpBuffer>0){p.swinging=-1;p.jumpBuffer=0;p.grabLock=.36;p.vx+=mx*2.5;p.vy=Math.max(2.3,p.vy+2.8);this.statistics.jumps++;this.emit('release',{id:p.id});swing=false;}}\n   else{const target=mx*this.tuning.moveSpeed*(p.duck?.4:1);p.vx+=(target-p.vx)*Math.min(1,dt*(p.onGround?16:3.4));p.vy-=this.tuning.gravity*dt;if(p.jumpBuffer>0&&p.coyote>0&&\"'!p.duck){p.vy=this.tuning.jumpPower;p.jumpBuffer=0;p.coyote=0;p.onGround=false;this.statistics.jumps++;this.emit('\"'jump',{id:p.id});}desired.x=p.vx*dt;desired.y=p.vy*dt;}\n   if(\"'!swing){if(this.stage===0&&p.grabLock<=0){let best=null,dist=2.6*this.tuning.assist+.6;for(const v of this.vines){if(v.index===p.lastVine&&p.x>v.x+2)continue;const endX=v.x+Math.sin(v.angle)*v.length,endY=v.y-Math.cos(v.angle)*v.length;const d=Math.hypot(p.x-endX,p.y+1.5-endY);if(d<dist&&p.y+1.5<v.y-1.8){dist=d;best=v;}}if(best){p.swinging=best.index;p.lastVine=best.index;p.theta=Math.atan2(p.x-best.x,best.y-p.y-1.5);p.omega=clamp((p.vx*Math.cos(p.theta)+p.vy*Math.sin(p.theta))/best.length,-1.6,1.6);if(Math.abs(p.omega)<.2)p.omega=.5;this.statistics.grabs++;this.emit('\"'grab',{id:p.id});}}\n    this.controller.computeColliderMovement(p.collider,desired,undefined,undefined,(collider)=>collider.parent()?.handle\"'!==p.body.handle&&!this.players.some(q=>q.collider.handle===collider.handle));let movement=this.controller.computedMovement();p.x+=movement.x;p.y+=movement.y;const grounded=this.controller.computedGrounded();if(grounded&&!p.onGround&&p.vy<-2)this.emit('\"'land',{id:p.id});p.onGround=grounded;if(grounded)p.vy=0;\n   }\n   if(this.stage===0&&p.y<-5){this.damage(p,'a missed vine');if(\"'!this.pending)this.checkpointPlayer(p);}\n   if(this.auto&&this.stage===0&&this.stageTime>30&&p.x<70){p.x=72;p.y=5;p.swinging=-1;p.grabLock=2;}\n   if(this.stage===1){p.y=clamp(p.y,.1,6.1);}p.x=clamp(p.x,-2,CHAPTERS[this.stage].length+2);p.body.setNextKinematicTranslation({x:p.x,y:p.y+.9,z:0});\n   if(p.x>p.checkpoint+17){p.checkpoint=p.x;this.checkpoint=p.x;this.emit('\"'checkpoint',{x:p.x,id:p.id});}\n   if(p.duck&&\"'!p.wasDuck){this.statistics.ducks++;}p.wasDuck=p.duck;\n   for(const e of this.enemies){if(!e.active||e.stun>0)continue;const d=Math.hypot(p.x-e.x,p.y+(p.duck?.4:.85)-e.y);if(p.attack>.15&&Math.abs(p.x-e.x)<3.5&&Math.abs(p.y+.9-e.y)<2&&e.type!=='\"'boulder'){e.stun=4;this.statistics.stuns++;this.score+=75;this.emit('stun',{id:p.id,x:e.x,y:e.y});continue;}const radius=e.type==='boulder'?e.radius+.5:e.type==='croc'?1.45:1;if(d<radius&&\"'!(p.duck&&e.high)){this.damage(p,e.type==='\"'croc'?'a crocodile nip':e.type==='boulder'?'a rolling rock':'a seedling scuffle');if(e.type==='boulder')e.active=false;}}\n   for(const c of this.pickups){if(c.taken)continue;const d=Math.hypot(p.x-c.x,p.y+1-c.y);if(c.type==='bell'){if(d<3.1&&input.action){c.taken=true;this.bells++;this.statistics.bells++;this.score+=500;this.emit('bell',{index:c.index,x:c.x,y:c.y});}}else if(d<1.6){c.taken=true;if(c.type==='air'){p.oxygen=this.tuning.oxygen;this.emit('bubble',{id:p.id});}else{this.fruit++;this.score+=100;p.score+=100;this.emit('pickup',{x:c.x,y:c.y,id:p.id});}}}\n   if(p.x>=CHAPTERS[this.stage].length-.5&&(this.stage\"'!==3||this.bells===3)){p.finished=true;this.score+=1000+Math.max(0,Math.round(600-this.stageTime*5));this.statistics.stages++;this.pending=true;this.emit('\"'stageClear',{stage:this.stage});}\n  }\n  this.world.step();\n }\n snapshot(){return{stage:this.stage,time:this.time,stageTime:this.stageTime,elapsed:this.elapsed,score:this.score,fruit:this.fruit,bells:this.bells,won:this.won,pending:this.pending,statistics:{...this.statistics},players:this.players.map(({body,collider,...p})=>({...p})),enemies:this.enemies.filter(e=>e.active).map(({body,...e})=>({...e})),pickups:this.pickups.map(x=>({...x})),vines:this.vines.map(x=>({...x}))};}\n applySnapshot(s){if(\"'!s||!Array.isArray(s.players))return;if(s.stage!==this.stage)this.setup(s.stage);for(const k of ['\"'time','stageTime','elapsed','score','fruit','bells','won','pending','statistics'])if(s[k]\"'!==undefined)this[k]=s[k];this.remoteSnapshot=s;for(const data of s.players){let p=this.players.find(p=>p.id===data.id)||this.addPlayer(data.id);Object.assign(p,data);p.body.setTranslation({x:p.x,y:p.y+.9,z:0},true);}this.enemies=s.enemies;this.pickups=s.pickups;this.vines=s.vines;}\n visual(){return{stage:this.stage,time:this.time,player:this.players[0],ghost:this.players[1],enemies:this.enemies,pickups:this.pickups,vines:this.vines,bells:this.bells,won:this.won};}\n}\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"cat > game.js <<'EOF'\nexport const DEFAULTS=Object.freeze({moveSpeed:7.2,jumpPower:10.8,gravity:22,swingPower:2.7,oxygen:15,hazardSpeed:1,damage:1,assist:1,timeScale:1});\nexport const CHAPTERS=[\n {name:'THE EMERALD CANOPY',short:'Canopy',subtitle:'A leap of faith. A very long way down.',goal:'Catch the vines. Reach the far bank.',length:79,color:'#b7d760'},\n {name:'CROCODILE CREEK',short:'Creek',subtitle:'Keep your hat dry. Watch the teeth.',goal:'Swim right. Surface for air. Knife to stun.',length:87,color:'#69d7c4'},\n {name:'THE RUMBLING RISE',short:'Rise',subtitle:'The hill has a few things to get off its chest.',goal:'Jump low boulders. Duck under the high ones.',length:87,color:'#efb85b'},\n {name:'THE SUNBELL RESCUE',short:'Rescue',subtitle:'Three bells. One botanist. Just in time for tea.',goal:'Ring all three Sunbells. Free Professor Pip\"'!'\"',length:56,color:'#eda486'}\n];\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nexport class JungleGame{\n constructor(RAPIER,onEvent=()=>{}){this.R=RAPIER;this.onEvent=onEvent;this.tuning={...DEFAULTS};this.stage=0;this.time=0;this.elapsed=0;this.score=0;this.fruit=0;this.deaths=0;this.bells=0;this.won=false;this.pending=false;this.auto=false;this.god=false;this.difficulty='adventure';this.checkpoint=4;this.statistics={jumps:0,grabs:0,stuns:0,ducks:0,bells:0,stages:0};this.setup(0);}\n emit(type,data={}){this.onEvent(type,data);}\n floor(x){return this.stage===0?(x<9||x>69?3:-30):this.stage===1?0:this.stage===2?1+x*.045:1;}\n setup(stage,keepScore=true){\n  if(this.world)this.world.free();this.stage=stage;this.pending=false;this.won=false;this.stageTime=0;this.bells=0;this.checkpoint=4;this.lastSpawn=0;this.enemies=[];this.pickups=[];this.vines=[];this.players=[];this.boulders=[];this.bubbleTime=0;\n  const R=this.R;this.world=new R.World({x:0,y:-this.tuning.gravity,z:0});this.world.timestep=1/60;this.controller=this.world.createCharacterController(.035);this.controller.enableAutostep(.35,.2,true);this.controller.enableSnapToGround(.2);this.controller.setSlideEnabled(true);\n  const ground=(x,y,hx,hy,angle=0)=>{let rb=this.world.createRigidBody(R.RigidBodyDesc.fixed().setTranslation(x,y,0).setRotation({x:0,y:0,z:Math.sin(angle/2),w:Math.cos(angle/2)}));this.world.createCollider(R.ColliderDesc.cuboid(hx,hy,3).setFriction(.8),rb);};\n  if(stage===0){ground(0,1,9,2);ground(80,1,10,2);for(let i=0;i<7;i++)this.vines.push({x:7+i*11,y:13.5,length:8.8,angle:Math.sin(i*.65)*.64,index:i});for(let i=0;i<12;i++)this.pickups.push({x:12+i*5.1,y:5.5+Math.sin(i*.85)*2,type:'fruit',taken:false});}\n  else if(stage===1){ground(45,-1,54,1);for(let i=0;i<8;i++)this.enemies.push({type:'croc',x:17+i*9,y:2.0+(i%3)*1.4,baseX:17+i*9,baseY:2+(i%3)*1.4,phase:i*1.7,active:true,stun:0});for(let i=0;i<14;i++)this.pickups.push({x:9+i*5.4,y:1.5+(i%3)*1.4,type:i%4===0?'air':'fruit',taken:false});}\n  else if(stage===2){ground(45,1+45*.045-1,55,1,Math.atan(.045));for(let i=0;i<13;i++)this.pickups.push({x:10+i*5.5,y:this.floor(10+i*5.5)+2.1+(i%2)*1.3,type:'fruit',taken:false});this.spawnBoulder(24,0);this.spawnBoulder(41,1);this.spawnBoulder(61,0);this.spawnBoulder(78,1);}\n  else {ground(30,-1,42,2);for(let i=0;i<3;i++){const x=15+i*16;this.pickups.push({type:'bell',x,y:2.25,taken:false,index:i});}for(let i=0;i<6;i++)this.pickups.push({type:'fruit',x:8+i*8,y:3.8+(i%2),taken:false});for(let i=0;i<4;i++)this.enemies.push({type:'beetle',x:10+i*11,y:1.6,baseX:10+i*11,phase:i*1.2,active:true,stun:0});}\n  this.addPlayer(1);if(this.coop)this.addPlayer(2);if(\"'!keepScore){this.score=0;this.fruit=0;this.elapsed=0;this.deaths=0;this.statistics={jumps:0,grabs:0,stuns:0,ducks:0,bells:0,stages:0};}this.emit('\"'stage',{stage});\n }\n addPlayer(id){if(this.players.some(p=>p.id===id))return;const R=this.R;const x=id===1?4:2.6,y=this.stage===0?3:this.stage===1?6:this.floor(x);const body=this.world.createRigidBody(R.RigidBodyDesc.kinematicPositionBased().setTranslation(x,y+.9,0));const collider=this.world.createCollider(R.ColliderDesc.capsule(.55,.35).setFriction(0),body);const p={id,x,y,vx:0,vy:0,body,collider,health:3,oxygen:this.tuning.oxygen,onGround:false,swinging:-1,theta:0,omega:0,face:1,attack:0,duck:false,hit:0,grabLock:0,lastVine:-1,jumpBuffer:0,coyote:0,score:0,checkpoint:4,finished:false};this.players.push(p);return p;}\n setCoop(v){this.coop=v;if(v)this.addPlayer(2);else if(this.players.length>1){const p=this.players.pop();this.world.removeRigidBody(p.body);}}\n spawnBoulder(x,high){const R=this.R;const radius=high?.95:.7;let y=this.floor(x)+radius+(high?2.4:0);const rb=this.world.createRigidBody(R.RigidBodyDesc.kinematicPositionBased().setTranslation(x,y,0));this.world.createCollider(R.ColliderDesc.ball(radius).setSensor(true),rb);const e={type:'boulder',x,y,radius,high,active:true,body:rb,angle:0};this.enemies.push(e);this.boulders.push(e);}\n restart(){this.setup(0,false);}\n retry(){this.deaths++;this.setup(this.stage);this.emit('retry');}\n next(){if(this.stage<3)this.setup(this.stage+1);else{this.won=true;this.pending=false;this.emit('win');}}\n teleport(p,x,y){p.x=x;p.y=y;p.vx=0;p.vy=0;p.swinging=-1;p.grabLock=.5;p.body.setTranslation({x,y:y+.9,z:0},true);p.body.setNextKinematicTranslation({x,y:y+.9,z:0});}\n damage(p,cause){if(this.god||this.auto||p.hit>0||p.finished)return;p.health-=this.tuning.damage;p.hit=1.8;this.emit('hit',{id:p.id,cause});if(p.health<=0){if(this.coop){p.health=3;this.teleport(p,Math.max(3,this.players.find(q=>q\"'!==p)?.x-2||4),this.stage===1?6:this.floor(p.x));this.emit('\"'revive',{id:p.id});}else{this.pending=true;this.emit('defeat',{cause});}}}\n checkpointPlayer(p){if(this.stage===0){const v=this.vines[Math.max(0,p.lastVine)];this.teleport(p,v.x,3.5);p.swinging=v.index;p.theta=0;p.omega=.6;}else this.teleport(p,p.checkpoint,this.stage===1?6:this.floor(p.checkpoint));}\n bot(p){\n  const out={x:1,y:0,jump:false,action:false,duck:false};\n  if(this.stage===0){if(p.swinging>=0){out.x=1;if(p.theta>.44&&p.omega>.12)out.jump=true;}else if(p.onGround)out.jump=true;if(this.stageTime>3&&p.y<-1){const v=this.vines.find(v=>v.x>p.x-2)||this.vines.at(-1);p.swinging=v.index;p.lastVine=v.index;p.theta=-.6;p.omega=1.4;}if(this.auto&&p.swinging>=0&&p.x>65&&p.theta>.3){out.jump=true;}}\n  if(this.stage===1){out.y=Math.sin(this.stageTime*1.2)*.65;out.action=this.stageTime%1<.06;if(p.oxygen<4)out.y=1;}\n  if(this.stage===2){let threat=this.enemies.find(e=>e.active&&e.x>p.x&&e.x-p.x<5);if(threat){out.jump=\"'!threat.high&&p.onGround;out.duck=!!threat.high;}}\n  if(this.stage===3){const bell=this.pickups.find(c=>c.type==='\"'bell'&&\"'!c.taken);if(bell&&Math.abs(bell.x-p.x)<2.2){out.x=0;out.action=true;}const e=this.enemies.find(e=>e.active&&e.stun<=0&&Math.abs(e.x-p.x)<3);if(e){out.action=true;out.jump=p.onGround;}if(this.bells<3&&p.x>50)out.x=-1;}\n  return out;\n }\n step(dt,inputs={}){\n  if(this.won||this.pending)return;dt=Math.min(dt,.0334)*this.tuning.timeScale;this.time+=dt;this.elapsed+=dt;this.stageTime+=dt;this.world.timestep=dt;this.world.gravity.y=-this.tuning.gravity;\n  this.vines.forEach(v=>v.angle=Math.sin(this.time*1.6+v.index*.65)*.64);\n  for(const e of this.enemies){e.stun=Math.max(0,(e.stun||0)-dt);if(e.type==='\"'croc'){e.x=e.baseX+Math.sin(this.time*.7+e.phase)*3;e.y=e.baseY+Math.sin(this.time*.9+e.phase)*.45;}if(e.type==='beetle'){e.x=e.baseX+Math.sin(this.time*1.2+e.phase)*3.5;e.y=1.5+Math.abs(Math.sin(this.time*3+e.phase))*.25;}if(e.type==='boulder'){e.x-=((e.high?6.6:5.1)*this.tuning.hazardSpeed)*dt;e.y=this.floor(e.x)+e.radius+(e.high?2.35:0)+Math.abs(Math.sin(this.time*2+e.x))*(e.high?.28:.08);e.angle+=dt*5;e.body.setNextKinematicTranslation({x:e.x,y:e.y,z:0});if(e.x<-8){e.active=false;}}}\n  if(this.stage===2&&this.stageTime-this.lastSpawn>3.4/Math.max(.3,this.tuning.hazardSpeed)){this.lastSpawn=this.stageTime;this.spawnBoulder(Math.min(100,Math.max(...this.players.map(p=>p.x))+29),Math.floor(this.stageTime/3.4)%2);if(this.boulders.length>24){const old=this.boulders.shift();this.world.removeRigidBody(old.body);this.enemies=this.enemies.filter(x=>x\"'!==old);}}\n  for(const p of this.players){\n   if(p.finished)continue;let input=this.auto?this.bot(p):(inputs[p.id]||{});let mx=clamp(input.x||0,-1,1),my=clamp(input.y||0,-1,1);p.hit=Math.max(0,p.hit-dt);p.attack=Math.max(0,p.attack-dt);p.grabLock=Math.max(0,p.grabLock-dt);p.duck=!!input.duck&&this.stage!==1&&p.onGround;p.jumpBuffer=Math.max(0,p.jumpBuffer-dt);p.coyote=p.onGround?.13:Math.max(0,p.coyote-dt);if(input.jump)p.jumpBuffer=.15;if(mx)p.face=Math.sign(mx);\n   if(input.action&&p.attack<=0){p.attack=.45;this.emit(this.stage===1?'\"'attack':'swish',{id:p.id});}\n   let desired={x:0,y:0,z:0},swing=false;\n   if(this.stage===1){p.swinging=-1;p.onGround=false;p.vx=mx*this.tuning.moveSpeed*.8;p.vy=(my-(input.duck?1:0))*this.tuning.moveSpeed*.65;p.y=clamp(p.y,.12,6.1);if(p.y>5.35)p.oxygen=Math.min(this.tuning.oxygen,p.oxygen+dt*5);else p.oxygen-=dt;if(p.oxygen<0){this.damage(p,'out of breath');p.oxygen=5;this.teleport(p,p.x,6);}desired.x=p.vx*dt;desired.y=p.vy*dt;}\n   else if(p.swinging>=0){swing=true;const v=this.vines[p.swinging];p.omega+=(-this.tuning.gravity/v.length*Math.sin(p.theta)+mx*this.tuning.swingPower)*dt;p.omega*=1-dt*.14;p.omega=clamp(p.omega,-2.3,2.3);p.theta=clamp(p.theta+p.omega*dt,-1.2,1.2);v.angle=p.theta;p.x=v.x+Math.sin(p.theta)*v.length;p.y=v.y-Math.cos(p.theta)*v.length-1.5;p.vx=Math.cos(p.theta)*p.omega*v.length;p.vy=Math.sin(p.theta)*p.omega*v.length;if(p.jumpBuffer>0){p.swinging=-1;p.jumpBuffer=0;p.grabLock=.36;p.vx+=mx*2.5;p.vy=Math.max(2.3,p.vy+2.8);this.statistics.jumps++;this.emit('release',{id:p.id});swing=false;}}\n   else{const target=mx*this.tuning.moveSpeed*(p.duck?.4:1);p.vx+=(target-p.vx)*Math.min(1,dt*(p.onGround?16:3.4));p.vy-=this.tuning.gravity*dt;if(p.jumpBuffer>0&&p.coyote>0&&\"'!p.duck){p.vy=this.tuning.jumpPower;p.jumpBuffer=0;p.coyote=0;p.onGround=false;this.statistics.jumps++;this.emit('\"'jump',{id:p.id});}desired.x=p.vx*dt;desired.y=p.vy*dt;}\n   if(\"'!swing){if(this.stage===0&&p.grabLock<=0){let best=null,dist=2.6*this.tuning.assist+.6;for(const v of this.vines){if(v.index===p.lastVine&&p.x>v.x+2)continue;const endX=v.x+Math.sin(v.angle)*v.length,endY=v.y-Math.cos(v.angle)*v.length;const d=Math.hypot(p.x-endX,p.y+1.5-endY);if(d<dist&&p.y+1.5<v.y-1.8){dist=d;best=v;}}if(best){p.swinging=best.index;p.lastVine=best.index;p.theta=Math.atan2(p.x-best.x,best.y-p.y-1.5);p.omega=clamp((p.vx*Math.cos(p.theta)+p.vy*Math.sin(p.theta))/best.length,-1.6,1.6);if(Math.abs(p.omega)<.2)p.omega=.5;this.statistics.grabs++;this.emit('\"'grab',{id:p.id});}}\n    this.controller.computeColliderMovement(p.collider,desired,undefined,undefined,(collider)=>collider.parent()?.handle\"'!==p.body.handle&&!this.players.some(q=>q.collider.handle===collider.handle));let movement=this.controller.computedMovement();p.x+=movement.x;p.y+=movement.y;const grounded=this.controller.computedGrounded();if(grounded&&!p.onGround&&p.vy<-2)this.emit('\"'land',{id:p.id});p.onGround=grounded;if(grounded)p.vy=0;\n   }\n   if(this.stage===0&&p.y<-5){this.damage(p,'a missed vine');if(\"'!this.pending)this.checkpointPlayer(p);}\n   if(this.auto&&this.stage===0&&this.stageTime>30&&p.x<70){p.x=72;p.y=5;p.swinging=-1;p.grabLock=2;}\n   if(this.stage===1){p.y=clamp(p.y,.1,6.1);}p.x=clamp(p.x,-2,CHAPTERS[this.stage].length+2);p.body.setNextKinematicTranslation({x:p.x,y:p.y+.9,z:0});\n   if(p.x>p.checkpoint+17){p.checkpoint=p.x;this.checkpoint=p.x;this.emit('\"'checkpoint',{x:p.x,id:p.id});}\n   if(p.duck&&\"'!p.wasDuck){this.statistics.ducks++;}p.wasDuck=p.duck;\n   for(const e of this.enemies){if(!e.active||e.stun>0)continue;const d=Math.hypot(p.x-e.x,p.y+(p.duck?.4:.85)-e.y);if(p.attack>.15&&Math.abs(p.x-e.x)<3.5&&Math.abs(p.y+.9-e.y)<2&&e.type!=='\"'boulder'){e.stun=4;this.statistics.stuns++;this.score+=75;this.emit('stun',{id:p.id,x:e.x,y:e.y});continue;}const radius=e.type==='boulder'?e.radius+.5:e.type==='croc'?1.45:1;if(d<radius&&\"'!(p.duck&&e.high)){this.damage(p,e.type==='\"'croc'?'a crocodile nip':e.type==='boulder'?'a rolling rock':'a seedling scuffle');if(e.type==='boulder')e.active=false;}}\n   for(const c of this.pickups){if(c.taken)continue;const d=Math.hypot(p.x-c.x,p.y+1-c.y);if(c.type==='bell'){if(d<3.1&&input.action){c.taken=true;this.bells++;this.statistics.bells++;this.score+=500;this.emit('bell',{index:c.index,x:c.x,y:c.y});}}else if(d<1.6){c.taken=true;if(c.type==='air'){p.oxygen=this.tuning.oxygen;this.emit('bubble',{id:p.id});}else{this.fruit++;this.score+=100;p.score+=100;this.emit('pickup',{x:c.x,y:c.y,id:p.id});}}}\n   if(p.x>=CHAPTERS[this.stage].length-.5&&(this.stage\"'!==3||this.bells===3)){p.finished=true;this.score+=1000+Math.max(0,Math.round(600-this.stageTime*5));this.statistics.stages++;this.pending=true;this.emit('\"'stageClear',{stage:this.stage});}\n  }\n  this.world.step();\n }\n snapshot(){return{stage:this.stage,time:this.time,stageTime:this.stageTime,elapsed:this.elapsed,score:this.score,fruit:this.fruit,bells:this.bells,won:this.won,pending:this.pending,statistics:{...this.statistics},players:this.players.map(({body,collider,...p})=>({...p})),enemies:this.enemies.filter(e=>e.active).map(({body,...e})=>({...e})),pickups:this.pickups.map(x=>({...x})),vines:this.vines.map(x=>({...x}))};}\n applySnapshot(s){if(\"'!s||!Array.isArray(s.players))return;if(s.stage!==this.stage)this.setup(s.stage);for(const k of ['\"'time','stageTime','elapsed','score','fruit','bells','won','pending','statistics'])if(s[k]\"'!==undefined)this[k]=s[k];this.remoteSnapshot=s;for(const data of s.players){let p=this.players.find(p=>p.id===data.id)||this.addPlayer(data.id);Object.assign(p,data);p.body.setTranslation({x:p.x,y:p.y+.9,z:0},true);}this.enemies=s.enemies;this.pickups=s.pickups;this.vines=s.vines;}\n visual(){return{stage:this.stage,time:this.time,player:this.players[0],ghost:this.players[1],enemies:this.enemies,pickups:this.pickups,vines:this.vines,bells:this.bells,won:this.won};}\n}\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' network.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' network.js\"","aggregated_output":"/** Jungle Scurry transports. AI Hub uses only the official session client. */\nconst GAME = 'jungle-scurry-20261105';\nconst COLORS = ['#f5b747', '#65d5ef'];\nconst noop = () => {};\nconst now = () => performance.now();\nconst uid = () => globalThis.crypto?.randomUUID?.() || `${Date.now()}-${Math.random().toString(36).slice(2)}`;\nconst clone = (value) => JSON.parse(JSON.stringify(value));\nconst normalizeRoom = (value) => String(value || '').trim().toUpperCase().replace(/[^A-Z0-9-]/g, '').slice(0, 24);\nconst pack = (value) => btoa(Array.from(new TextEncoder().encode(JSON.stringify(value)), c => String.fromCharCode(c)).join(''));\nconst unpack = (text) => {\n  const value = String(text || '').trim();\n  try { return JSON.parse(value.startsWith('{') ? value : new TextDecoder().decode(Uint8Array.from(atob(value), c => c.charCodeAt(0)))); }\n  catch { throw new Error('That connection code is incomplete. Copy the whole code and try again.'); }\n};\n\nexport class ExpeditionNet {\n  constructor(callbacks = {}) {\n    for (const event of ['Status', 'State', 'Input', 'Start', 'End', 'TimeUp', 'Leave', 'Join', 'Finish']) this[`on${event}`] = callbacks[`on${event}`] || noop;\n    this.mode = 'solo';\n    this.isHost = true;\n    this.connected = false;\n    this.players = [{ id: 0, name: 'Scout One', color: COLORS[0] }];\n    this.me = 0;\n    this.server = false;\n    this.started = false;\n    this.ended = false;\n    this.status = 'Solo expedition';\n    this.room = '';\n    this._identity = uid();\n    this._hostIdentity = null;\n    this._peerIdentity = null;\n    this._channel = null;\n    this._pc = null;\n    this._dc = null;\n    this._timers = [];\n    this._off = [];\n    this._lastInputAt = -Infinity;\n    this._lastStateAt = -Infinity;\n    this._lastState = null;\n    this._startPayload = null;\n    this._startedAt = Infinity;\n    this._lastPeerAt = now();\n    this._finished = false;\n    this.stats = { sent: 0, received: 0, inputs: 0, states: 0 };\n  }\n\n  get active() { return this.mode === 'hub' || this.connected; }\n  get hubActive() { return this.mode === 'hub'; }\n  get time() { return this.mode === 'hub' ? globalThis.AIHub.time() : now() - this._startedAt; }\n  get canPlay() { return this.started && !this.ended && this.time >= 0; }\n\n  _status(text) { this.status = text; this.onStatus(text, this); }\n\n  async init() {\n    const hub = globalThis.AIHub;\n    if (!hub?.active) return null;\n    const info = await hub.connect({ mode: 'shared-world', seats: [1, 2] });\n    if (!info) return null;\n    this.mode = 'hub';\n    this.isHost = info.isHost;\n    this.connected = true;\n    this.players = info.players.map(p => ({ ...p }));\n    this.me = info.me;\n    this.server = !!info.server;\n    this._status(this.server ? 'AI Hub expedition server' : `AI Hub · ${this.players.length} scout${this.players.length === 1 ? '' : 's'}`);\n    this._off.push(hub.on('start', (event) => {\n      this.started = true;\n      this.ended = false;\n      this._finished = false;\n      this.onStart({ ...event, players: this.players, server: this.server, hub: true });\n    }));\n    this._off.push(hub.on('message', (data, from) => {\n      if (this.ended || !data || data.game !== GAME) return;\n      this.stats.received++;\n      if (data.t === 'input' && this.isHost && this.players.some(p => p.id === from)) {\n        this.stats.inputs++;\n        this.onInput(data.input, from);\n      } else if (data.t === 'state' && !this.isHost && from === hub.host) {\n        this.stats.states++;\n        this.onState(data.state);\n      }\n    }));\n    this._off.push(hub.on('time-up', (event) => { if (!this.ended) this.onTimeUp(event); }));\n    this._off.push(hub.on('leave', (event) => {\n      this.players = this.players.filter(p => p.id !== event.id);\n      this.onLeave(event);\n    }));\n    this._off.push(hub.on('end', (event) => {\n      this.ended = true;\n      this.started = false;\n      this.connected = false;\n      this._status('AI Hub round complete');\n      this.onEnd(event);\n    }));\n    return info;\n  }\n\n  ready() { if (this.mode === 'hub') globalThis.AIHub.ready(); }\n\n  fail(message) {\n    if (this.mode === 'hub' || globalThis.AIHub?.active) globalThis.AIHub.fail(String(message));\n    this._status(String(message));\n  }\n\n  /** The caller owns starting the actual simulation. In Hub only the hub can start it. */\n  begin(payload = {}) {\n    if (this.mode === 'hub' || !this.isHost) return false;\n    this.started = true;\n    this.ended = false;\n    this._finished = false;\n    this._startedAt = now();\n    this._startPayload = clone(payload);\n    this._send({ t: 'start', payload: this._startPayload, players: this.players });\n    this.onStart({ payload: this._startPayload, players: this.players, hub: false, in: 0 });\n    return true;\n  }\n\n  sendInput(input, force = false) {\n    if (this.ended || this.server) return false;\n    if (this.isHost) {\n      this.onInput(input, this.me);\n      return true;\n    }\n    if (!this.connected || (!force && now() - this._lastInputAt < 65)) return false;\n    this._lastInputAt = now();\n    this.stats.inputs++;\n    if (this.mode === 'hub') return this._hubSend({ game: GAME, t: 'input', input }, globalThis.AIHub.host);\n    return this._send({ t: 'input', input });\n  }\n\n  sendState(snapshot, force = false) {\n    if (!this.isHost || this.ended) return false;\n    this._lastState = snapshot;\n    if (!this.connected || (!force && now() - this._lastStateAt < 68)) return false;\n    this._lastStateAt = now();\n    this.stats.states++;\n    if (this.mode === 'hub') return this._hubSend({ game: GAME, t: 'state', state: snapshot });\n    return this._send({ t: 'state', state: snapshot });\n  }\n\n  _hubSend(data, to) {\n    if (this.ended) return false;\n    const sent = globalThis.AIHub.send(data, to == null ? { reliable: false } : { to, reliable: false });\n    if (sent) this.stats.sent++;\n    return sent;\n  }\n\n  /** Shared-world team finish: all remaining players tie and receive the team result. */\n  finish({ scores = {}, won = true, stats, awards } = {}) {\n    if (!this.isHost || this._finished || this.ended) return false;\n    this._finished = true;\n    const result = { standings: [this.players.map(p => p.id)], scores: Object.fromEntries(this.players.map(p => [p.id, Number(scores[p.id] || 0)])), won: !!won };\n    if (stats) result.stats = stats;\n    if (awards) result.awards = awards;\n    if (this.mode === 'hub') globalThis.AIHub.finish(result);\n    else this._send({ t: 'finish', result });\n    return true;\n  }\n\n  /** Nearby tabs on the same origin. No backend, accounts, chat, or public room directory. */\n  hostRoom(code = '') {\n    this._assertStandalone();\n    this.leave();\n    if (typeof BroadcastChannel !== 'function') throw new Error('Nearby play is unavailable in this browser. Use a direct connection code.');\n    this.mode = 'room';\n    this.isHost = true;\n    this.me = 0;\n    this.room = normalizeRoom(code) || Math.random().toString(36).slice(2, 8).toUpperCase();\n    this._hostIdentity = this._identity;\n    this._channel = new BroadcastChannel(`${GAME}:${this.room}`);\n    this._channel.onmessage = (event) => this._receive(event.data);\n    this._status(`Camp ${this.room} · waiting for Scout Two`);\n    this._timers.push(setInterval(() => {\n      this._send({ t: 'ping' });\n      if (this.connected && now() - this._lastPeerAt > 7000) this._peerLeft('Connection lost');\n    }, 1500));\n    return this.room;\n  }\n\n  joinRoom(code) {\n    this._assertStandalone();\n    const room = normalizeRoom(code);\n    if (!room) throw new Error('Enter the host’s camp code first.');\n    this.leave();\n    if (typeof BroadcastChannel !== 'function') throw new Error('Nearby play is unavailable in this browser. Use a direct connection code.');\n    this.mode = 'room';\n    this.isHost = false;\n    this.me = 1;\n    this.room = room;\n    this.players = [{ id: 1, name: 'Scout Two', color: COLORS[1] }];\n    this._channel = new BroadcastChannel(`${GAME}:${room}`);\n    this._channel.onmessage = (event) => this._receive(event.data);\n    this._status(`Finding camp ${room}…`);\n    this._send({ t: 'hello' });\n    this._timers.push(setInterval(() => {\n      if (!this.connected) this._send({ t: 'hello' });\n      else if (now() - this._lastPeerAt > 7000) this._peerLeft('Host connection lost');\n    }, 1000));\n    return room;\n  }\n\n  _assertStandalone() {\n    if (this.mode === 'hub' || globalThis.AIHub?.active) throw new Error('AI Hub manages the expedition connection.');\n  }\n\n  _send(data, to = null) {\n    if (this.ended) return false;\n    const packet = { ...data, game: GAME, from: this._identity, to };\n    if (this._channel) {\n      this._channel.postMessage(packet);\n      this.stats.sent++;\n      return true;\n    }\n    if (this._dc?.readyState === 'open' && this._dc.bufferedAmount < 512 * 1024) {\n      this._dc.send(JSON.stringify(packet));\n      this.stats.sent++;\n      return true;\n    }\n    return false;\n  }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,120p' world.js && tail -110 world.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,120p' world.js && tail -110 world.js\"","aggregated_output":"// Procedural stagecraft for Jungle Scurry. All surfaces and animation are generated in code.\nexport function createWorld(THREE, scene) {\n  const root = new THREE.Group(); root.name = 'JungleScurryWorld'; scene.add(root);\n  const backdrop = new THREE.Group(), stageRoot = new THREE.Group(), actorRoot = new THREE.Group(), fxRoot = new THREE.Group();\n  root.add(backdrop, stageRoot, actorRoot, fxRoot);\n  const C={ink:0x102c28,bark:0x3b5541,barkLit:0x7b8b53,leaf:0x268965,lime:0x8cbd59,mint:0x67a87b,darkLeaf:0x155646,jade:0x318f77,cream:0xffe8ab,gold:0xffcb5d,orange:0xe47138,red:0xc55036,river:0x278f98,stone:0x72917b,deep:0x103e39};\n  const materials = new Map();\n  function mat(color, opts={}) { const key = color+'|'+(opts.opacity??1)+'|'+(opts.fog!==false); if (!materials.has(key)) materials.set(key,new THREE.MeshBasicMaterial({color,vertexColors:true,fog:opts.fog!==false,transparent:(opts.opacity??1)<1,opacity:opts.opacity??1,depthWrite:(opts.opacity??1)===1}));return materials.get(key); }\n  const ink=new THREE.MeshBasicMaterial({color:C.ink,side:THREE.BackSide});\n  // Quantized vertex lighting produces a three-tone cel ramp, also on the WebGPU path.\n  function celGeometry(g) {const n=g.attributes.normal;const cols=new Float32Array(n.count*3); for(let i=0;i<n.count;i++){const d=n.getX(i)*-.35+n.getY(i)*.78+n.getZ(i)*.55;const v=d>.4?1:d>-.25?.78:.53;cols[i*3]=v;cols[i*3+1]=v;cols[i*3+2]=v;}g.setAttribute('color',new THREE.BufferAttribute(cols,3));return g;}\n  const G={box:celGeometry(new THREE.BoxGeometry(1,1,1)),sphere:celGeometry(new THREE.SphereGeometry(1,12,8)),ico:celGeometry(new THREE.IcosahedronGeometry(1,0)),rock:celGeometry(new THREE.DodecahedronGeometry(1,0)),cylinder:celGeometry(new THREE.CylinderGeometry(1,1,1,10)),cone:celGeometry(new THREE.ConeGeometry(1,1,8)),ring:celGeometry(new THREE.TorusGeometry(1,.1,4,20))};\n  const v0=new THREE.Vector3(),v1=new THREE.Vector3(),up=new THREE.Vector3(0,1,0);\n  function mesh(group,shape,color,x=0,y=0,z=0,sx=1,sy=sx,sz=sx,outline=true,opts={}) {const m=new THREE.Mesh(G[shape]||shape,mat(color,opts));m.position.set(x,y,z);m.scale.set(sx,sy,sz);group.add(m);if(outline){const hull=new THREE.Mesh(m.geometry,ink);hull.scale.set(1.035,1.035,1.035);m.add(hull);}return m;}\n  function bar(group,a,b,r,color,outline=true) {v0.set(...a);v1.set(...b);const len=v0.distanceTo(v1);const m=mesh(group,'cylinder',color,(a[0]+b[0])/2,(a[1]+b[1])/2,(a[2]+b[2])/2,r,len,r,outline);m.quaternion.setFromUnitVectors(up,v1.sub(v0).normalize());return m;}\n  function random(seed) {let x=seed|0;return()=>{x=(Math.imul(x,1664525)+1013904223)|0;return(x>>>0)/4294967296;};}let rnd=random(9486);\n  const leaves=[];const birds=[];const pollen=[];const waterfalls=[];const flowers=[];const motes=[];\n  function leaf(group,x,y,z,s=1,angle=0,color=C.leaf) {const m=mesh(group,'sphere',color,x,y,z,.27*s,.83*s,.09*s,true);m.rotation.z=angle;return m;}\n  function frond(group,x,y,z,s=1,angle=0,color=C.leaf) {const g=new THREE.Group();g.position.set(x,y,z);g.rotation.z=angle;group.add(g);bar(g,[0,0,0],[0,2.2*s,0],.035*s,C.lime,false);for(let j=0;j<5;j++){const t=(j+1)*.37*s;leaf(g,-(.45+.05*j)*s,t,0,.5*s,-.95,color);leaf(g,(.45+.05*j)*s,t,0,.5*s,.95,color);}return g;}\n  function bush(group,x,y,z,s=1,color=C.leaf){for(let j=0;j<5;j++){const a=j/4*Math.PI;leaf(group,x+Math.cos(a)*s*.5,y+Math.sin(a)*s*.5,z,.65*s,(j-2)*-.55,color);}}\n  function flower(group,x,y,z,s=1){const g=new THREE.Group();g.position.set(x,y,z);group.add(g);bar(g,[0,0,0],[0,.7*s,0],.025*s,C.lime,false);for(let j=0;j<5;j++){let a=j/5*Math.PI*2;mesh(g,'sphere',j%2?C.orange:C.gold,Math.cos(a)*.2*s,.7*s+Math.sin(a)*.2*s,.04,.17*s,.17*s,.06*s,false);}mesh(g,'sphere',C.cream,0,.7*s,.1,.1*s,.1*s,.05*s,false);flowers.push(g);}\n  function tree(group,x,y,z,s=1,canopy=true){const g=new THREE.Group();g.position.set(x,y,z);group.add(g);bar(g,[-.3*s,0,0],[0,12*s,0],.52*s,C.bark);bar(g,[0,7*s,0],[-2.9*s,10*s,0],.26*s,C.bark);bar(g,[0,9*s,0],[3.2*s,11.7*s,0],.23*s,C.bark);bar(g,[-.3*s,2*s,0],[-1.8*s,0,1*s],.23*s,C.bark);for(let j=0;j<7;j++)bar(g,[-.43*s,(j*1.45+.6)*s,.41*s],[.17*s,(j*1.45+.85)*s,.48*s],.035*s,C.barkLit,false);if(canopy){for(let j=0;j<7;j++){const a=j/7*Math.PI*2;mesh(g,'ico',j%2?C.leaf:C.darkLeaf,Math.cos(a)*2.3*s,(12+Math.sin(a)*1.1)*s,Math.sin(a)*1.5*s,3.1*s,1.7*s,2*s,true);}for(let j=0;j<4;j++)frond(g,(j-1.5)*1.8*s,11.3*s,1*s,.8*s,(j-1.5)*.6,C.lime);}return g;}\n  function palm(group,x,y,z,s=1){const g=new THREE.Group();g.position.set(x,y,z);group.add(g);bar(g,[0,0,0],[.7*s,6.5*s,0],.2*s,C.barkLit);for(let j=0;j<7;j++)bar(g,[j*.1*s,.9*j*s,.18*s],[.23*s+j*.1*s,.9*j*s+.06*s,.18*s],.025*s,C.bark,false);for(let j=0;j<7;j++){let a=(j/6-.5)*2.9;frond(g,.7*s,6.5*s,.05*j*s,.85*s,a,C.leaf);}return g;}\n  function ground(x,width,y=1,z=0,depth=7,color=C.barkLit){mesh(stageRoot,'box',C.bark,x,y-2.3,z,width,4.6,depth);mesh(stageRoot,'box',color,x,y-.12,z,width,.25,depth+.15);for(let k=0;k<Math.ceil(width/1.5);k++){const px=x-width/2+k*1.5+.5;mesh(stageRoot,'rock',C.bark,px,y-2.2,depth/2,.6,.7,.2,false);if(k%3===0)bush(stageRoot,px,y,depth/2-.5,.7,C.lime);}}\n  function flag(x,y,z,labelColor=C.orange){bar(stageRoot,[x,y,z],[x,y+3.6,z],.055,C.cream);const s=new THREE.Shape();s.moveTo(0,0);s.lineTo(1.4,-.1);s.lineTo(.85,-.65);s.lineTo(0,-.6);s.closePath();let geo=celGeometry(new THREE.ShapeGeometry(s));let f=mesh(stageRoot,geo,labelColor,x,y+3.5,z,1,1,1,false);f.material.side=THREE.DoubleSide;return f;}\n  // The distant landscape is continuous so the journey reads like a travelling illustrated diorama.\n  mesh(backdrop,'sphere',0xffdc91,5,16,-32,5.8,5.8,.2,false,{fog:false});\n  for(let layer=0;layer<3;layer++){for(let j=-3;j<16;j++){let h=8+Math.sin(j*1.81+layer)*4;let m=mesh(backdrop,'cone',[0x87b69a,0x589e84,0x357d69][layer],j*13+layer*3,h/2+2,-35+layer*5,12,h,4,false);m.rotation.y=.3;}}\n  for(let j=-2;j<24;j++){const x=j*7;tree(backdrop,x,0,-15,.6+(j%3)*.12,true);}\n  // A striped expedition balloon quietly marks the rescue destination in the title panorama.\n  const balloon=new THREE.Group();balloon.position.set(19,14,-21);backdrop.add(balloon);\n  mesh(balloon,'sphere',C.orange,0,2.1,0,2.2,2.7,1.6,true);for(let j=-1;j<=1;j++)mesh(balloon,'sphere',C.cream,j*.65,2.2,1.27,.24,2.2,.25,false);\n  mesh(balloon,'box',C.barkLit,0,-1.35,0,1.3,.7,1,true);for(let i of[-1,1])bar(balloon,[i*.55,-1,0],[i*1.05,.1,0],.045,C.cream,false);mesh(balloon,'cone',C.gold,0,-.1,0,.3,.55,.3,false);\n  for(let j=0;j<16;j++){const g=new THREE.Group();g.position.set(rnd()*150-20,8+rnd()*14,-18-rnd()*8);backdrop.add(g);bar(g,[-.5,0,0],[0,.2,0],.035,0x315d51,false);bar(g,[0,.2,0],[.5,0,0],.035,0x315d51,false);birds.push({g,seed:rnd()*10});}\n  // Permanently reusable fireflies and drifting pollen.\n  for(let i=0;i<60;i++){const m=mesh(fxRoot,'sphere',i%4===0?C.cream:C.gold,rnd()*40-15,rnd()*18,-7+rnd()*11,.025+rnd()*.03,undefined,undefined,false,{opacity:.65});pollen.push({m,x:m.position.x,y:m.position.y,z:m.position.z,speed:.12+rnd()*.23,phase:rnd()*7});}\n  function hero(color=C.leaf,ghost=false){\n    const g=new THREE.Group();g.name=ghost?'ghostHero':'hero';actorRoot.add(g);\n    const body=new THREE.Group();body.name='body';g.add(body);\n    const jacket=color,skin=ghost?0x9be4dd:0xe8af75,boots=ghost?0x285976:0x35433a;\n    mesh(body,'box',C.bark,.05,1.3,-.27,.65,.85,.4,true);mesh(body,'sphere',jacket,0,1.26,0,.48,.59,.29,true);\n    mesh(body,'box',C.bark,0,1.03,.08,.86,.12,.52,true);mesh(body,'box',C.gold,.05,1.04,.36,.18,.16,.055,false);\n    const strap=mesh(body,'box',C.cream,.03,1.4,.285,.12,.85,.04,false);strap.rotation.z=-.45;\n    mesh(body,'box',C.orange,-.28,1.45,.305,.18,.2,.05,true);mesh(body,'sphere',C.gold,.28,1.46,.31,.08,.08,.03,false);\n    mesh(body,'sphere',skin,0,1.99,.04,.38,.43,.32,true);mesh(body,'sphere',skin,.24,1.94,.29,.13,.11,.11,false);\n    mesh(body,'sphere',skin,-.37,1.98,.015,.09,.13,.11,false);mesh(body,'sphere',skin,.37,1.98,.015,.09,.13,.11,false);\n    for(let x of[-.13,.16]){mesh(body,'sphere',0x173a32,x,2.05,.337,.044,.063,.03,false);const b=mesh(body,'box',C.bark,x,2.15,.334,.1,.035,.03,false);b.rotation.z=x<0?.15:-.15;}\n    const smile=mesh(body,'ring',C.bark,.07,1.85,.34,.13,.07,.018,false);smile.rotation.z=.05;\n    mesh(body,'cylinder',C.cream,0,2.27,.01,.65,.09,.5,true);mesh(body,'sphere',C.cream,0,2.4,-.015,.43,.29,.36,true);mesh(body,'cylinder',C.barkLit,0,2.32,-.01,.436,.1,.36,false);\n    mesh(body,'sphere',C.orange,.07,1.7,.05,.38,.13,.33,true);const scarf=mesh(body,'cone',C.orange,-.49,1.56,-.04,.18,.65,.07,true);scarf.rotation.z=-1.03;scarf.name='scarf';\n    const armL=new THREE.Group(),armR=new THREE.Group();armL.name='armL';armR.name='armR';armL.position.set(-.46,1.59,0);armR.position.set(.46,1.59,0);body.add(armL,armR);\n    for(let a of[armL,armR]){mesh(a,'sphere',jacket,0,-.19,0,.19,.29,.19,true);mesh(a,'sphere',skin,0,-.51,.02,.13,.24,.12,true);mesh(a,'sphere',skin,0,-.75,.04,.15,.17,.14,true);}\n    const legL=new THREE.Group(),legR=new THREE.Group();legL.name='legL';legR.name='legR';legL.position.set(-.24,.92,0);legR.position.set(.24,.92,0);body.add(legL,legR);\n    for(let l of[legL,legR]){mesh(l,'sphere',0xd5ba80,0,-.27,0,.22,.39,.22,true);mesh(l,'sphere',boots,.06,-.66,.06,.24,.22,.28,true);mesh(l,'box',C.cream,.05,-.51,.04,.39,.07,.35,false);}\n    const mixer=new THREE.AnimationMixer(g),actions={};\n    function clip(name,duration,tracks){const c=new THREE.AnimationClip(name,duration,tracks.map(([path,ts,vals])=>new THREE.NumberKeyframeTrack(path,ts,vals)));actions[name]=mixer.clipAction(c);}\n    const t=[0,.2,.4,.6,.8];\n    clip('walk',.8,[['legL.rotation[z]',t,[.65,0,-.65,0,.65]],['legR.rotation[z]',t,[-.65,0,.65,0,-.65]],['armL.rotation[z]',t,[-.65,0,.65,0,-.65]],['armR.rotation[z]',t,[.65,0,-.65,0,.65]],['body.