{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"command -v biome && biome format --write main.js game.js audio.js network.js build.mjs > tests/format-report.txt && tail -2 tests/format-report.txt && sed -n '1170,1340p' main.js\"","aggregated_output":"/home/micha/.local/bin/biome\nFormatted 5 files in 24ms. Fixed 5 files.\n\t\tscene = new THREE.Scene();\n\t\tscene.background = new THREE.Color(0xa4c9a5);\n\t\tscene.fog = new THREE.Fog(0xa4c9a5, 42, 125);\n\t\tcamera = new THREE.OrthographicCamera(-18, 18, 10, -10, 0.1, 180);\n\t\tconst params = new URLSearchParams(location.search);\n\t\trenderer = dedicated\n\t\t\t? {\n\t\t\t\t\tbackend: { isWebGPUBackend: false },\n\t\t\t\t\tisHeadlessServer: true,\n\t\t\t\t\tsetSize() {},\n\t\t\t\t\tsetPixelRatio() {},\n\t\t\t\t\tinit: async () => {},\n\t\t\t\t\tcompileAsync: async () => {},\n\t\t\t\t\trender() {},\n\t\t\t\t\tsetAnimationLoop(fn) {\n\t\t\t\t\t\tfunction tick(t) {\n\t\t\t\t\t\t\tfn(t);\n\t\t\t\t\t\t\trequestAnimationFrame(tick);\n\t\t\t\t\t\t}\n\t\t\t\t\t\trequestAnimationFrame(tick);\n\t\t\t\t\t},\n\t\t\t\t}\n\t\t\t: new THREE.WebGPURenderer({\n\t\t\t\t\tcanvas: $(\"#view\"),\n\t\t\t\t\tantialias: true,\n\t\t\t\t\tforceWebGL: params.get(\"renderer\") === \"webgl\",\n\t\t\t\t});\n\t\trenderer.setPixelRatio(Math.min(devicePixelRatio, 2));\n\t\trenderer.outputColorSpace = THREE.SRGBColorSpace;\n\t\trenderer.toneMapping = THREE.ACESFilmicToneMapping;\n\t\trenderer.toneMappingExposure = 1.15;\n\t\tawait renderer.init();\n\t\t$(\"#load-text\").textContent = \"Finding the Professor…\";\n\t\tgame = new JungleGame(RAPIER, onGameEvent);\n\t\tworld = dedicated\n\t\t\t? { setStage() {}, update() {} }\n\t\t\t: createWorld(THREE, scene);\n\t\tresize();\n\t\twindow.addEventListener(\"resize\", resize);\n\t\tsetMode(hubInfo ? \"hub-wait\" : \"title\");\n\t\tupdateCamera(1);\n\t\tawait renderer.compileAsync(scene, camera);\n\t\trenderer.render(scene, camera);\n\t\tframeCount++;\n\t\t$(\"#loading\").hidden = true;\n\t\tbooted = true;\n\t\tglobalThis.__JUNGLE = {\n\t\t\tready: true,\n\t\t\tgame,\n\t\t\taudio,\n\t\t\tnet,\n\t\t\tworld,\n\t\t\trenderer,\n\t\t\tsettings,\n\t\t\tchapters: CHAPTERS,\n\t\t\tstate: () => ({\n\t\t\t\tmode,\n\t\t\t\tstage: game.stage,\n\t\t\t\twon: game.won,\n\t\t\t\tpending: game.pending,\n\t\t\t\telapsed: game.elapsed,\n\t\t\t\tscore: game.score,\n\t\t\t\tfruit: game.fruit,\n\t\t\t\tbells: game.bells,\n\t\t\t\tstatistics: { ...game.statistics },\n\t\t\t\tplayers: game.snapshot().players,\n\t\t\t\tbackend: renderer.isHeadlessServer\n\t\t\t\t\t? \"Dedicated server\"\n\t\t\t\t\t: renderer.backend.isWebGPUBackend\n\t\t\t\t\t\t? \"WebGPU\"\n\t\t\t\t\t\t: \"WebGL2\",\n\t\t\t\tframeCount,\n\t\t\t\tlastInput,\n\t\t\t\tattractCycles,\n\t\t\t\tnetwork: net.mode,\n\t\t\t\tnetworkStats: net.stats,\n\t\t\t\tmusic: settings.music,\n\t\t\t}),\n\t\t\tstart: (coop = false) => startGame(coop),\n\t\t\tpause,\n\t\t\tgoTitle,\n\t\t\tattract: startAttract,\n\t\t\tsetMode,\n\t\t\taction: doAction,\n\t\t\tstep: (frames = 1, input = {}) => {\n\t\t\t\tfor (let i = 0; i < frames; i++) {\n\t\t\t\t\tgame.step(1 / 60, { 1: input });\n\t\t\t\t\tif (game.pending) {\n\t\t\t\t\t\tgame.next();\n\t\t\t\t\t\tif (game.won) break;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t},\n\t\t\trender: () => {\n\t\t\t\tworld.update(0, game.visual());\n\t\t\t\trenderer.render(scene, camera);\n\t\t\t},\n\t\t\tofflineAudio: () => JungleAudio.renderOfflineTest(),\n\t\t};\n\t\tif (hubInfo) {\n\t\t\tgame.setCoop(net.players.length > 1);\n\t\t\tsetMode(\"hub-wait\");\n\t\t\tnet.ready();\n\t\t}\n\t\trenderer.setAnimationLoop((now) => {\n\t\t\tif (!booted) return;\n\t\t\tconst dt = Math.min(0.05, (now - (lastNow || now - 16.667)) / 1000);\n\t\t\tlastNow = now;\n\t\t\ttry {\n\t\t\t\tupdate(dt, now);\n\t\t\t\trenderer.render(scene, camera);\n\t\t\t\tframeCount++;\n\t\t\t} catch (err) {\n\t\t\t\tconsole.error(\"Game loop:\", err);\n\t\t\t\tglobalThis.__JUNGLE.lastError = err.message;\n\t\t\t}\n\t\t});\n\t} catch (err) {\n\t\tconsole.error(err);\n\t\t$(\"#load-text\").textContent =\n\t\t\t\"The expedition could not open: \" + err.message;\n\t\t$(\"#loading .loading-line\")?.remove();\n\t\tconst btn = document.createElement(\"button\");\n\t\tbtn.className = \"btn primary\";\n\t\tbtn.textContent = \"Try again\";\n\t\tbtn.onclick = () => location.reload();\n\t\t$(\"#loading>div\").append(btn);\n\t\tglobalThis.__JUNGLE = { ready: false, error: err.message };\n\t\tglobalThis.AIHub?.active && globalThis.AIHub.fail(err.message);\n\t}\n}\nwindow.addEventListener(\"keydown\", (e) => {\n\tif (net?.hubActive && net.ended) return;\n\tif (e.target.matches(\"input,textarea\")) {\n\t\tactivity(\"keyboard\");\n\t\tif (e.code === \"Escape\") {\n\t\t\te.target.blur();\n\t\t\tback();\n\t\t}\n\t\treturn;\n\t}\n\tconst exited = activity(\"keyboard\");\n\tunlock();\n\tif (exited) {\n\t\te.preventDefault();\n\t\treturn;\n\t}\n\tif (!keys.has(e.code)) edges.add(e.code);\n\tkeys.add(e.code);\n\tif (\n\t\t[\n\t\t\t\"Space\",\n\t\t\t\"ArrowUp\",\n\t\t\t\"ArrowDown\",\n\t\t\t\"ArrowLeft\",\n\t\t\t\"ArrowRight\",\n\t\t\t\"Tab\",\n\t\t].includes(e.code)\n\t)\n\t\te.preventDefault();\n\tif (!booted) return;\n\tif (e.code === \"Escape\" || e.code === \"KeyP\") {\n\t\tpause();\n\t\tif (mode !== \"pause\" && mode !== \"playing\") back();\n\t\treturn;\n\t}\n\tif (![\"playing\", \"attract\", \"transition\"].includes(mode)) {\n\t\tif (e.code === \"ArrowDown\" || e.code === \"KeyS\" || e.code === \"Tab\")\n\t\t\tmenuMove(e.shiftKey ? -1 : 1);\n\t\telse if (e.code === \"ArrowUp\" || e.code === \"KeyW\") menuMove(-1);\n\t\telse if (e.code === \"ArrowLeft\" || e.code === \"KeyA\") menuAdjust(-1);\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='main.js';s=open(p).read();at=s.index('async function boot()')\nnew='''let recoveringGraphics = false;\nfunction renderFrame(now) {\n if (\"'!booted || recoveringGraphics) return;\n const dt=Math.min(.05,(now-(lastNow||now-16.667))/1000);lastNow=now;\n try {update(dt,now);renderer.render(scene,camera);frameCount++;}\n catch(err){if(renderer.backend.isWebGPUBackend&&/device|Instance|GPU/i.test(err.message)){recoverGraphics();return;}console.error('\"'Game loop:',err);globalThis.__JUNGLE.lastError=err.message;}\n}\nfunction configureRenderer(){renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.15;}\nasync function compileScene(){const current=renderer;const lost=current.backend.device?.lost;if(lost){await Promise.race([current.compileAsync(scene,camera),lost.then(()=>{throw new Error('Graphics device lost during initialization');})]);}else await current.compileAsync(scene,camera);}\nfunction watchGraphicsDevice(){const current=renderer;if(current.backend.isWebGPUBackend&&current.backend.device?.lost)current.backend.device.lost.then(()=>{if(renderer===current)recoverGraphics();}).catch(()=>{});}\nasync function recoverGraphics(){\n if(recoveringGraphics||renderer.isHeadlessServer||\"'!renderer.backend.isWebGPUBackend)return;\n recoveringGraphics=true;\n try {\n  const old=renderer;try{old.setAnimationLoop(null);}catch{}\n  const canvas=document.createElement('\"'canvas');canvas.id='view';canvas.setAttribute('aria-label','Jungle Scurry game world');\"'$('\"'#view').replaceWith(canvas);\n  renderer=new THREE.WebGPURenderer({canvas,antialias:true,forceWebGL:true});configureRenderer();await renderer.init();resize();await renderer.compileAsync(scene,camera);renderer.render(scene,camera);\n  if(globalThis.__JUNGLE)globalThis.__JUNGLE.renderer=renderer;\n  try{old.dispose();}catch{}\n  if(booted)renderer.setAnimationLoop(renderFrame);\n } catch(error){console.error('Graphics recovery:',error);if(globalThis.__JUNGLE)globalThis.__JUNGLE.lastError=error.message;}\n finally{recoveringGraphics=false;}\n}\n'''\ns=s[:at]+new+s[at:]\nstart=s.index('\\\\t\\\\trenderer.setPixelRatio(',s.index('async function boot()'))\nend=s.index('\\\\t\\\\t\"'$(\"#load-text\").textContent = \"Finding the Professor…\";'\"',start)\ns=s[:start]+'''\\\\t\\\\tconfigureRenderer();\n        try{await renderer.init();}catch(error){if(renderer.backend.isWebGPUBackend)await recoverGraphics();else throw error;}\n'''+s[end:]\ns=s.replace('await renderer.compileAsync(scene, camera);\\\\n\\\\t\\\\trenderer.render(scene, camera);','try{await compileScene();}catch(error){if(renderer.backend.isWebGPUBackend)await recoverGraphics();else throw error;}\\\\n\\\\t\\\\trenderer.render(scene, camera);',1)\nstart=s.index('\\\\t\\\\trenderer.setAnimationLoop((now) => {',s.index('async function boot()'))\nend=s.index('\\\\n\\\\t} catch (err) {',start)\ns=s[:start]+'\\\\t\\\\twatchGraphicsDevice();\\\\n\\\\t\\\\trenderer.setAnimationLoop(renderFrame);'+s[end:]\ns=s.replace('\"'$(\"#loading>div\").append(btn);'\"','if(\"'!net?.hubActive)$(\"#loading>div\").append(btn);'\"')\nopen(p,'w').write(s)\nPY\nbiome format --write main.js > tests/format-report.txt\nnode --check main.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
