{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"cat > shell.html <<'EOF'\n<\"'!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<!-- HUB_SESSION -->\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#153e33\">\n<title>Jungle Scurry — A little trouble. A grand adventure.</title>\n<style>\n:root{--ink:#122f2a;--cream:#fff0cb;--gold:#ffc75f;--orange:#ef8a45;--jade:#315e46;--dim:#d1d9b8;--focus:#ffd675;font-family:Trebuchet MS,Arial,sans-serif;color:var(--cream);font-synthesis:none}\n*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden;background:#173f35}body{user-select:none;-webkit-user-select:none;touch-action:none}button,input,textarea{font:inherit}button{color:inherit;cursor:pointer;border:0}button:focus-visible,input:focus-visible,textarea:focus-visible{outline:4px solid var(--focus);outline-offset:4px}button:disabled{opacity:.4;cursor:default}button:hover{color:var(--gold)}[hidden]{display:none!important}#view{position:fixed;inset:0;width:100%;height:100%;display:block}.veil{position:fixed;inset:0;pointer-events:none;background:linear-gradient(90deg,#082f2bc9 0%,#082f2b60 30%,transparent 67%),linear-gradient(0deg,#092c308c,transparent 24%,transparent 75%,#0b353a44);transition:opacity .6s}body.playing .veil{opacity:0}#ui{position:fixed;inset:0;pointer-events:none}#ui button,#ui input,#ui textarea,#ui .scroll{pointer-events:auto}.screen{position:absolute;inset:0;display:flex;align-items:center;padding:5vh 6vw}.screen-center{justify-content:center;background:#0b292cc2;backdrop-filter:blur(9px)}.brand{width:min(610px,52vw);position:relative}.eyebrow{font-size:clamp(13px,1.1vw,20px);letter-spacing:.21em;font-weight:800;text-transform:uppercase;color:var(--gold);display:flex;align-items:center;gap:12px}.eyebrow:before{content:'\"'';width:30px;height:2px;background:currentColor}.title{font-family:Georgia,serif;font-size:clamp(68px,7.8vw,150px);font-weight:900;line-height:.83;letter-spacing:-.065em;margin:28px 0 22px;text-shadow:4px 5px 0 #102f2a;-webkit-text-stroke:1px #153c2f;transform:rotate(-3deg)}.title span{color:var(--gold);display:block;margin-left:18px}.subtitle{font-size:clamp(16px,1.4vw,24px);font-weight:600;color:#e0e8c9;line-height:1.4;margin:0 0 30px;max-width:480px}.menu{display:flex;flex-direction:column;gap:10px;align-items:stretch;width:365px;max-width:100%}.btn{position:relative;border:2px solid #b5d0a650;background:#163c32e8;border-radius:3px;min-height:51px;padding:12px 23px;text-align:left;font-size:clamp(17px,1.35vw,23px);font-weight:800;box-shadow:3px 4px 0 #102d2680;transition:transform .12s,background .12s,color .12s}.btn.primary{background:var(--gold);border-color:var(--gold);color:var(--ink);box-shadow:4px 5px 0 #12382e}.btn.focused,.btn:hover{background:#406d4c;border-color:var(--cream);transform:translateX(5px);color:var(--cream)}.btn.primary.focused,.btn.primary:hover{background:#ffde8a;color:var(--ink);border-color:var(--cream)}.btn .arrow{float:right;opacity:.65}.btn small{display:block;font-weight:400;font-size:14px;margin-top:4px;color:var(--dim)}.btn.primary small{color:var(--jade)}.title-note{margin-top:20px;font-size:12px;font-weight:bold;letter-spacing:.14em;line-height:1.7;color:#a9c6a2}.edition{position:absolute;right:4vw;top:5vh;display:flex;align-items:center;gap:13px;letter-spacing:.16em;font-size:12px;font-weight:800}.seal{height:53px;width:53px;border:2px solid #f9e9bb9c;border-radius:50%;display:grid;place-items:center;font-size:28px;transform:rotate(15deg);color:var(--gold)}.edition div{line-height:1.6}.route-ribbon{position:absolute;right:4vw;bottom:5vh;display:flex;gap:22px;color:var(--cream);font-size:13px;font-weight:bold;letter-spacing:.08em}.route-ribbon span:before{content:'◇';color:var(--gold);margin-right:8px}.panel{width:min(760px,88vw);max-height:88vh;padding:36px 42px;background:#173e34f5;border:2px solid #94b58b;border-radius:4px;box-shadow:8px 10px 0 #082c29;position:relative}.panel.wide{width:min(1040px,90vw)}.panel h1{font-family:Georgia,serif;font-size:clamp(32px,3.1vw,51px);line-height:1.05;margin:6px 0 12px;letter-spacing:-.04em}.panel p{font-size:clamp(17px,1.4vw,23px);line-height:1.45;margin:12px 0 24px;color:#d8e4c6}.panel .menu{width:100%}.panel .menu.grid{display:grid;grid-template-columns:1fr 1fr}.back{position:absolute;right:18px;top:15px;background:transparent;font-size:25px;color:var(--cream);padding:5px 10px}.mini{font-size:14px\"'!important;line-height:1.5!important;color:#b7cdaa!important}.row{display:flex;align-items:center;gap:20px;justify-content:space-between;margin:15px 0;font-size:20px}.row label{flex:1}.row output{width:55px;font-variant-numeric:tabular-nums;color:var(--gold);text-align:right}.row input[type=range]{width:43%;accent-color:var(--gold);height:28px;cursor:pointer}.toggle{background:#285a43;border:1px solid #739b70;border-radius:2px;font-weight:bold;padding:10px 18px;font-size:18px;min-width:130px}.toggle.focused{outline:3px solid var(--gold);color:var(--gold)}.scroll{overflow:auto;max-height:57vh;overscroll-behavior:contain;scrollbar-color:#97ac73 #183e33;padding-right:10px}.tabs{display:flex;gap:7px;margin:20px 0}.tabs button{flex:1;background:#28543f;border-bottom:3px solid transparent;padding:10px 5px;font-size:16px}.tabs button.active,.tabs button.focused{border-color:var(--gold);color:var(--gold)}.credit-row{display:grid;grid-template-columns:155px 1fr;gap:20px;padding:9px 0;border-bottom:1px solid #8aa47a2b;font-size:17px;line-height:1.4}.credit-row b{color:var(--gold);font-size:15px}.feedback-q{font-size:18px;margin:20px 0 5px;color:var(--gold)}.feedback-a{font-size:17px;line-height:1.5;color:#d7e4c6}.guide-card{display:grid;grid-template-columns:70px 1fr;gap:18px;padding:13px 0;border-bottom:1px solid #8aa47a3a}.guide-num{font-family:Georgia,serif;font-size:46px;color:var(--gold)}.guide-card h2{margin:1px 