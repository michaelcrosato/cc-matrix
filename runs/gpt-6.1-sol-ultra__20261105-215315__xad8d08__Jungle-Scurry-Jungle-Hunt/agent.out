UNGLE.renderer=renderer;\n  try{old.dispose();}catch{}\n  if(booted)renderer.setAnimationLoop(renderFrame);\n } catch(error){console.error('Graphics recovery:',error);if(globalThis.__JUNGLE)globalThis.__JUNGLE.lastError=error.message;}\n finally{recoveringGraphics=false;}\n}\n'''\ns=s[:at]+new+s[at:]\nstart=s.index('\\\\t\\\\trenderer.setPixelRatio(',s.index('async function boot()'))\nend=s.index('\\\\t\\\\t\"'$(\"#load-text\").textContent = \"Finding the Professor…\";'\"',start)\ns=s[:start]+'''\\\\t\\\\tconfigureRenderer();\n        try{await renderer.init();}catch(error){if(renderer.backend.isWebGPUBackend)await recoverGraphics();else throw error;}\n'''+s[end:]\ns=s.replace('await renderer.compileAsync(scene, camera);\\\\n\\\\t\\\\trenderer.render(scene, camera);','try{await compileScene();}catch(error){if(renderer.backend.isWebGPUBackend)await recoverGraphics();else throw error;}\\\\n\\\\t\\\\trenderer.render(scene, camera);',1)\nstart=s.index('\\\\t\\\\trenderer.setAnimationLoop((now) => {',s.index('async function boot()'))\nend=s.index('\\\\n\\\\t} catch (err) {',start)\ns=s[:start]+'\\\\t\\\\twatchGraphicsDevice();\\\\n\\\\t\\\\trenderer.setAnimationLoop(renderFrame);'+s[end:]\ns=s.replace('\"'$(\"#loading>div\").append(btn);'\"','if(\"'!net?.hubActive)$(\"#loading>div\").append(btn);'\"')\nopen(p,'w').write(s)\nPY\nbiome format --write main.js > tests/format-report.txt\nnode --check main.js\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"cat > tests/test_game.py <<'PY'\n\\\"\\\"\\\"Single-command verification: build, simulation, input/audio, and Hub conformance.\\\"\\\"\\\"\nfrom __future__ import annotations\nimport functools\nimport importlib.util\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport subprocess\nimport sys\nimport threading\nfrom http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer\n\nPROJECT=Path(__file__).resolve().parents[1]\nROOT=PROJECT.parent\nSTEM=PROJECT.name\nFLAGS=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader']\nfailures=[]\ncount=0\n\ndef command(args, label, env=None):\n    global count\n    result=subprocess.run(args,cwd=PROJECT,env=env,text=True,capture_output=True)\n    output=result.stdout+'\\\\n'+result.stderr\n    matches=re.findall(r'(\\\\d+)/(\\\\d+) .*checks passed',output)\n    simulation=re.search(r'Simulation: (\\\\d+) checks, (\\\\d+) failures',output)\n    count+=int(matches[-1][1]) if matches else int(simulation[1]) if simulation else 1\n    if result.returncode:\n        lines=[s for s in output.splitlines() if s.startswith('FAIL')]\n        failures.extend(lines or [f'FAIL {label}: {output.strip()[-1600:]}'])\n\n\ndef module(name,filename):\n    spec=importlib.util.spec_from_file_location(name,PROJECT/'tests'/filename)\n    mod=importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(mod)\n    return mod\n\n\nclass QuietHandler(SimpleHTTPRequestHandler):\n    def log_message(self,*args):\n        pass\n\n\ndef main():\n    global count\n    command(['node','build.mjs'],'bundle')\n    command(['node','tests/simulation.mjs'],'physics')\n    command(['node','tests/check-world.mjs'],'world')\n    try:\n        meta=json.loads((ROOT/'exit-interview.json').read_text())\n        assert set(meta)=={'sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub'}\n        assert len(meta['testingFeedback'])==4 and len(meta['engineFeedback'])==6 and len(meta['promptFeedback'])==4\n        assert meta['sourceInformation']['usage']=='added on import'\n        assert all(str(v).strip() for v in meta['sourceInformation'].values())\n        assert meta['aiHub']['name']=='Jungle Scurry' and len(meta['aiHub']['tags']) in range(3,7)\n        html=(ROOT/(STEM+'.html')).read_text()\n        assert '<meta name=\\\"hub:session\\\" content=\\\"1\\\">' in html\n        assert 'aihub-session' in html\n        assert '<script src=' not in html and 'type=\\\"importmap\\\"' not in html\n        count+=1\n    except Exception as error:\n        count+=1;failures.append('FAIL deliverable metadata: '+str(error))\n    server=ThreadingHTTPServer(('127.0.0.1',0),functools.partial(QuietHandler,directory=str(ROOT)))\n    thread=threading.Thread(target=server.serve_forever,daemon=True);thread.start()\n    origin=f'http://127.0.0.1:{server.server_port}'\n    try:\n        command([sys.executable,'network-smoke.py'],'direct transport',env={**os.environ,'GAME_TEST_ORIGIN':origin+'/'+STEM})\n        from playwright.sync_api import sync_playwright\n        with sync_playwright() as p:\n            browser=p.chromium.launch(headless=True,args=FLAGS)\n            try:\n                f,n=module('jungle_browser_checks','browser-checks.py').run_browser_checks(browser,origin,STEM+'.html')\n                failures.extend('FAIL '+x for x in f);count+=n\n            except Exception as error:\n                count+=1;failures.append('FAIL browser suite: '+str(error).split('\\\\n')[0])\n            finally:\n                browser.close()\n            f,n=module('jungle_hub_checks','hub-test.py').test_hub(lambda:p.chromium.launch(headless=True,args=FLAGS),origin,STEM+'.html')\n            failures.extend('FAIL '+x for x in f);count+=n\n    except Exception as error:\n        count+=1;failures.append('FAIL test runner: '+str(error).split('\\\\n')[0])\n    finally:\n        server.shutdown();server.server_close();thread.join()\n    report={'checks':count,'failures':failures,'passed':count-len(failures),'parameters':{'renderer':'Chromium SwiftShader WebGPU; device-loss WebGL2 fallback','gamepad':'standard mapping stub','touch':'phone profile','multiplayer':'real local BroadcastChannel, WebRTC data channel, official Hub standard/adverse/server/host-leave','audio':'OfflineAudioContext plus live analyser','simulation':'real Rapier WASM complete expedition'}}\n    (PROJECT/'tests'/'results.json').write_text(json.dumps(report,indent=2)+'\\\\n')\n    for failure in failures:print(failure)\n    print(f'{count-len(failures)}/{count} checks passed; {len(failures)} failures.')\n    return bool(failures)\n\n\nif __name__=='__main__':raise SystemExit(main())\nPY\ncat > README.md <<'EOF'\n# Jungle Scurry\n\n**A little trouble. A grand adventure.**\n\nOpen the HTML file in the parent folder in a modern browser. All engine code, physics WASM, art and sound generation are embedded; it needs no asset server or CDN. WebGPU is the default. Three.js uses its WebGL2 backend if WebGPU is unavailable, and the game recovers to that backend after a lost graphics device.\n\n## Controls\n\n| Action | Keyboard / mouse | Standard controller |\n|---|---|---|\n| Move / swim / pump vine | WASD or arrows | Left stick / D-pad |\n| Jump / release vine | Space | Cross / A |\n| Knife / ring bell | E, F or left click | Square / X |\n| Duck / dive | S or Down | Circle / B |\n| Pause | Escape or P | Options / Menu |\n| Menus | Arrows + Enter, mouse | D-pad / stick + Cross |\n| Long credits / guide | Wheel, Page Up / Down | Right stick |\n\nCouch scout two uses IJKL, Right Shift, and O, or a second controller. On touch devices drag anywhere to move, tap to jump, and use the contextual knife / bell / release button. River combat and low-air surfacing have touch assistance.\n\nVines catch automatically. Pump right and release on the upswing. In the creek, surface or collect air bubbles to refill oxygen; the knife stuns crocodiles. Jump small boulders and duck beneath large ones. Ring three Sunbells to lower Professor Pip's basket and reach the final flag.\n\nThe pause menu opens **Dev camp** with live physics and difficulty sliders, invincibility, autopilot, chapter selection, telemetry and default reset. Leaving the title untouched for ten seconds starts an AI expedition; any input returns to the title.\n\n## Co-op\n\n- **Couch expedition:** two controllers or a shared keyboard.\n- **Nearby camp:** host and join the same code in two tabs on the same origin/device.\n- **Direct connection:** the host makes an invitation, the friend pastes it and returns the reply, and the host connects the reply. This uses a real WebRTC data channel with public STUN discovery; restrictive NATs can prevent a direct connection.\n- **AI Hub:** the embedded unmodified session client implements the official shared-world protocol. The host owns physics and sends snapshots; clients send input. The dedicated host has no graphics device or local scout. The Hub owns round start, finish and timeout.\n\n## Development and verification\n\nFrom this directory:\n\n\"'```sh\nnpm run build --silent\nnpm test --silent\n```\n\nThe build emits the single distributable HTML into the parent folder and embeds the adjacent `exit-interview.json` into About. The test command builds, checks real Rapier mechanics and the complete route, inspects native geometry/animation, drives the game with keyboard/mouse/gamepad/touch, measures synthesized audio, tests real peer transports and runs the unmodified AI Hub harness in four scenarios. It starts its own loopback server on an OS-selected port and closes every browser and server. Only failures and one summary count are printed. Detailed reports are in `tests/`.\n\nTo see the official harness separately, serve the parent directory and open this folder'\"'s \"'`harness.html?game=../Jungle-Scurry-Jungle-Hunt-gpt-6.1-sol-ultra-20261105-215315.html&players=2&auto=1`.\n\nSource inspiration: Jungle Hunt (1983). No internet research was used for source, art, mechanics or narrative. Only the explicitly requested AI Hub integration code was consulted. Original models, animations, writing, music, effects and gibberish voices are generated in code.\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\nPath('../selection.json').unlink(missing_ok=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"cat > tests/test_game.py <<'PY'\n\\\"\\\"\\\"Single-command verification: build, simulation, input/audio, and Hub conformance.\\\"\\\"\\\"\nfrom __future__ import annotations\nimport functools\nimport importlib.util\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport subprocess\nimport sys\nimport threading\nfrom http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer\n\nPROJECT=Path(__file__).resolve().parents[1]\nROOT=PROJECT.parent\nSTEM=PROJECT.name\nFLAGS=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader']\nfailures=[]\ncount=0\n\ndef command(args, label, env=None):\n    global count\n    result=subprocess.run(args,cwd=PROJECT,env=env,text=True,capture_output=True)\n    output=result.stdout+'\\\\n'+result.stderr\n    matches=re.findall(r'(\\\\d+)/(\\\\d+) .*checks passed',output)\n    simulation=re.search(r'Simulation: (\\\\d+) checks, (\\\\d+) failures',output)\n    count+=int(matches[-1][1]) if matches else int(simulation[1]) if simulation else 1\n    if result.returncode:\n        lines=[s for s in output.splitlines() if s.startswith('FAIL')]\n        failures.extend(lines or [f'FAIL {label}: {output.strip()[-1600:]}'])\n\n\ndef module(name,filename):\n    spec=importlib.util.spec_from_file_location(name,PROJECT/'tests'/filename)\n    mod=importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(mod)\n    return mod\n\n\nclass QuietHandler(SimpleHTTPRequestHandler):\n    def log_message(self,*args):\n        pass\n\n\ndef main():\n    global count\n    command(['node','build.mjs'],'bundle')\n    command(['node','tests/simulation.mjs'],'physics')\n    command(['node','tests/check-world.mjs'],'world')\n    try:\n        meta=json.loads((ROOT/'exit-interview.json').read_text())\n        assert set(meta)=={'sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub'}\n        assert len(meta['testingFeedback'])==4 and len(meta['engineFeedback'])==6 and len(meta['promptFeedback'])==4\n        assert meta['sourceInformation']['usage']=='added on import'\n        assert all(str(v).strip() for v in meta['sourceInformation'].values())\n        assert meta['aiHub']['name']=='Jungle Scurry' and len(meta['aiHub']['tags']) in range(3,7)\n        html=(ROOT/(STEM+'.html')).read_text()\n        assert '<meta name=\\\"hub:session\\\" content=\\\"1\\\">' in html\n        assert 'aihub-session' in html\n        assert '<script src=' not in html and 'type=\\\"importmap\\\"' not in html\n        count+=1\n    except Exception as error:\n        count+=1;failures.append('FAIL deliverable metadata: '+str(error))\n    server=ThreadingHTTPServer(('127.0.0.1',0),functools.partial(QuietHandler,directory=str(ROOT)))\n    thread=threading.Thread(target=server.serve_forever,daemon=True);thread.start()\n    origin=f'http://127.0.0.1:{server.server_port}'\n    try:\n        command([sys.executable,'network-smoke.py'],'direct transport',env={**os.environ,'GAME_TEST_ORIGIN':origin+'/'+STEM})\n        from playwright.sync_api import sync_playwright\n        with sync_playwright() as p:\n            browser=p.chromium.launch(headless=True,args=FLAGS)\n            try:\n                f,n=module('jungle_browser_checks','browser-checks.py').run_browser_checks(browser,origin,STEM+'.html')\n                failures.extend('FAIL '+x for x in f);count+=n\n            except Exception as error:\n                count+=1;failures.append('FAIL browser suite: '+str(error).split('\\\\n')[0])\n            finally:\n                browser.close()\n            f,n=module('jungle_hub_checks','hub-test.py').test_hub(lambda:p.chromium.launch(headless=True,args=FLAGS),origin,STEM+'.html')\n            failures.extend('FAIL '+x for x in f);count+=n\n    except Exception as error:\n        count+=1;failures.append('FAIL test runner: '+str(error).split('\\\\n')[0])\n    finally:\n        server.shutdown();server.server_close();thread.join()\n    report={'checks':count,'failures':failures,'passed':count-len(failures),'parameters':{'renderer':'Chromium SwiftShader WebGPU; device-loss WebGL2 fallback','gamepad':'standard mapping stub','touch':'phone profile','multiplayer':'real local BroadcastChannel, WebRTC data channel, official Hub standard/adverse/server/host-leave','audio':'OfflineAudioContext plus live analyser','simulation':'real Rapier WASM complete expedition'}}\n    (PROJECT/'tests'/'results.json').write_text(json.dumps(report,indent=2)+'\\\\n')\n    for failure in failures:print(failure)\n    print(f'{count-len(failures)}/{count} checks passed; {len(failures)} failures.')\n    return bool(failures)\n\n\nif __name__=='__main__':raise SystemExit(main())\nPY\ncat > README.md <<'EOF'\n# Jungle Scurry\n\n**A little trouble. A grand adventure.**\n\nOpen the HTML file in the parent folder in a modern browser. All engine code, physics WASM, art and sound generation are embedded; it needs no asset server or CDN. WebGPU is the default. Three.js uses its WebGL2 backend if WebGPU is unavailable, and the game recovers to that backend after a lost graphics device.\n\n## Controls\n\n| Action | Keyboard / mouse | Standard controller |\n|---|---|---|\n| Move / swim / pump vine | WASD or arrows | Left stick / D-pad |\n| Jump / release vine | Space | Cross / A |\n| Knife / ring bell | E, F or left click | Square / X |\n| Duck / dive | S or Down | Circle / B |\n| Pause | Escape or P | Options / Menu |\n| Menus | Arrows + Enter, mouse | D-pad / stick + Cross |\n| Long credits / guide | Wheel, Page Up / Down | Right stick |\n\nCouch scout two uses IJKL, Right Shift, and O, or a second controller. On touch devices drag anywhere to move, tap to jump, and use the contextual knife / bell / release button. River combat and low-air surfacing have touch assistance.\n\nVines catch automatically. Pump right and release on the upswing. In the creek, surface or collect air bubbles to refill oxygen; the knife stuns crocodiles. Jump small boulders and duck beneath large ones. Ring three Sunbells to lower Professor Pip's basket and reach the final flag.\n\nThe pause menu opens **Dev camp** with live physics and difficulty sliders, invincibility, autopilot, chapter selection, telemetry and default reset. Leaving the title untouched for ten seconds starts an AI expedition; any input returns to the title.\n\n## Co-op\n\n- **Couch expedition:** two controllers or a shared keyboard.\n- **Nearby camp:** host and join the same code in two tabs on the same origin/device.\n- **Direct connection:** the host makes an invitation, the friend pastes it and returns the reply, and the host connects the reply. This uses a real WebRTC data channel with public STUN discovery; restrictive NATs can prevent a direct connection.\n- **AI Hub:** the embedded unmodified session client implements the official shared-world protocol. The host owns physics and sends snapshots; clients send input. The dedicated host has no graphics device or local scout. The Hub owns round start, finish and timeout.\n\n## Development and verification\n\nFrom this directory:\n\n\"'```sh\nnpm run build --silent\nnpm test --silent\n```\n\nThe build emits the single distributable HTML into the parent folder and embeds the adjacent `exit-interview.json` into About. The test command builds, checks real Rapier mechanics and the complete route, inspects native geometry/animation, drives the game with keyboard/mouse/gamepad/touch, measures synthesized audio, tests real peer transports and runs the unmodified AI Hub harness in four scenarios. It starts its own loopback server on an OS-selected port and closes every browser and server. Only failures and one summary count are printed. Detailed reports are in `tests/`.\n\nTo see the official harness separately, serve the parent directory and open this folder'\"'s \"'`harness.html?game=../Jungle-Scurry-Jungle-Hunt-gpt-6.1-sol-ultra-20261105-215315.html&players=2&auto=1`.\n\nSource inspiration: Jungle Hunt (1983). No internet research was used for source, art, mechanics or narrative. Only the explicitly requested AI Hub integration code was consulted. Original models, animations, writing, music, effects and gibberish voices are generated in code.\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\nPath('../selection.json').unlink(missing_ok=True)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_41","type":"agent_message","text":"Keyboard, controller, touch, audio, the full rescue route, and live two-player camp play have passed browser checks. I’m finishing regression tests for remote jump presses, either player pausing co-op, and recovery after a graphics device is lost.\n"}}
