nsform:rotate(375deg)}}@keyframes loading{50%{transform:translateX(150%)}}@keyframes banner-in{from{opacity:0;margin-top:15px}to{opacity:1;margin-top:0}}\n@media(max-width:760px){.route-ribbon{gap:10px;font-size:9px}.edition{font-size:9px;right:3vw}.seal{width:40px;height:40px;font-size:23px}.brand{width:63vw}.subtitle{font-size:15px}.menu{width:290px}.btn{min-height:43px;padding:9px 18px;font-size:16px}.title{font-size:clamp(65px,11vw,100px);margin-top:22px}.panel{padding:27px}.route-progress{display:none}.panel .menu.grid{grid-template-columns:1fr 1fr}.hud-right{gap:15px}.score{font-size:23px}.hint{font-size:13px}.key{font-size:11px;min-height:21px;line-height:18px;padding:0 4px;margin:0 3px}.credit-row{grid-template-columns:110px 1fr;font-size:14px;gap:12px}.credit-row b{font-size:13px}.row{font-size:17px;gap:10px}.row output{font-size:15px}.toggle{font-size:15px;min-width:105px}.tabs button{font-size:13px}.hud{padding:3vh 4vw}.chapter-name{font-size:19px}.dev-grid{gap:0 18px}.dev-grid .row{font-size:14px}.scroll{max-height:55vh}.guide-card{padding:10px 0;grid-template-columns:43px 1fr}.guide-num{font-size:35px}.guide-card h2{font-size:18px}.guide-card p{font-size:14px}.panel h1{font-size:33px}.panel p{font-size:17px}}\n@media(max-height:650px){.screen{padding-top:3vh;padding-bottom:3vh}.title{font-size:clamp(62px,13vh,100px);margin:15px 0 17px}.subtitle{margin-bottom:16px}.btn{min-height:41px;padding:8px 19px}.menu{gap:7px}.title-note{margin-top:12px;font-size:10px}.panel{padding:22px 30px}.panel h1{font-size:32px}.panel p{margin:9px 0 15px}.row{margin:8px 0}.scroll{max-height:53vh}.eyebrow{font-size:11px}.stats{margin:14px 0}.edition{top:4vh}.guide-card{padding:8px 0}.guide-card p{font-size:14px}.guide-controls{font-size:12px}.dev-grid .row{margin:4px 0}}\n@media(prefers-reduced-motion:reduce){*{animation:none\"'!important;scroll-behavior:auto!important}.btn{transition:none}}\n</style>\n</head>\n<body>\n<canvas id=\"view\" aria-label=\"Jungle Scurry game world\"></canvas>\n<div class=\"veil\"></div><div id=\"ui\"></div>\n<div id=\"loading\" class=\"loading\"><div><div class=\"seal\">✦</div><h1>Jungle Scurry</h1><p id=\"load-text\">Packing a very small suitcase…</p><div class=\"loading-line\"></div><p class=\"mini\">A LITTLE TROUBLE. A GRAND ADVENTURE.</p></div></div>\n<!-- GAME_SCRIPT -->\n</body></html>\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='game.js'\ns=open(p).read().replace('(high?2.4:0)','(high?.75:0)').replace('(e.high?2.35:0)','(e.high?.75:0)').replace('if(p.x>=CHAPTERS[this.stage].length-.5','if(\"'!this.pending&&p.x>=CHAPTERS[this.stage].length-.5'\"')\nopen(p,'w').write(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='game.js'\ns=open(p).read().replace('(high?2.4:0)','(high?.75:0)').replace('(e.high?2.35:0)','(e.high?.75:0)').replace('if(p.x>=CHAPTERS[this.stage].length-.5','if(\"'!this.pending&&p.x>=CHAPTERS[this.stage].length-.5'\"')\nopen(p,'w').write(s)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"cat > main.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport RAPIER from '@dimforge/rapier3d-compat';\nimport {createWorld} from './world.js';\nimport {JungleGame,CHAPTERS,DEFAULTS} from './game.js';\nimport {JungleAudio} from './audio.js';\nimport {ExpeditionNet} from './network.js';\nconst \"'$=s=>document.querySelector(s), ui=$('\"'#ui');\nconst esc=s=>String(s??'').replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nlet mode='loading',returnMode='title',lastInput='keyboard',lastActivity=performance.now(),focusIndex=0,game,world,renderer,scene,camera,net,frameCount=0,transitionTimer=0,bannerUntil=0,toastUntil=0,toastText='',cameraX=13,shake=0,booted=false,accumulator=0,lastNow=0,uiTick=0,localCoop=false,aboutTab=0,debugOverlay=false,guidePage=0,attractCycles=0,pairOutput='',routeTime=0,networkPaused=false;\nconst settings={music:.1,sfx:.65,glyphs:'PlayStation',shake:true,assist:true};\ntry{const saved=JSON.parse(localStorage.getItem('jungle-scurry-settings'));if(saved)Object.assign(settings,saved);}catch{}\nconst audio=new JungleAudio();audio.setMusicVolume(settings.music);audio.setSfxVolume(settings.sfx);\nconst keys=new Set(),edges=new Set(),padPrevious=new Map(),padInputs=new Map(),remoteInputs={},touches=new Map();let touchAxis={x:0,y:0},touchJump=false,touchAction=false,touchDuck=false,menuRepeat=0,lastPointerMove=0;\nconst isTouch=matchMedia('(pointer:coarse)').matches||navigator.maxTouchPoints>0;\nif(isTouch){document.body.classList.add('body-touch');lastInput='touch';}\nconst prompts={keyboard:{move:'A D',jump:'Space',action:'E',duck:'S',pause:'Esc'},pad:{move:'L',jump:'×',action:'□',duck:'○',pause:'Options'},touch:{move:'drag',jump:'tap',action:'tap',duck:'drag ↓',pause:'Ⅱ'}};\nfunction glyph(name){if(lastInput==='pad'&&settings.glyphs==='Xbox')return({move:'L',jump:'A',action:'X',duck:'B',pause:'Menu'})[name];return(prompts[lastInput]||prompts.keyboard)[name];}\nfunction key(name){return \"'`<span class=\"key\">${glyph(name)}</span>`;}\nfunction saveSettings(){try{localStorage.setItem('\"'jungle-scurry-settings',JSON.stringify(settings));}catch{}}\nfunction activity(type='keyboard'){lastActivity=performance.now();if(type)lastInput=type;if(mode==='attract'){attractCycles++;goTitle();return true;}return false;}\nfunction unlock(){audio.unlock().catch(()=>{});}\nfunction button(label,action,cls='',extra=''){return \"'`<button class=\"btn ${cls}\" data-action=\"${action}\" ${extra}>${label}<span class=\"arrow\">↗</span></button>`;}\nfunction panel(title,content,{wide=false,back=true,kicker='\"'FIELD NOTES',id=''}={}){return \"'`<section class=\"screen screen-center\" ${id?`id=\"${id}\"`:'\"''}><div class=\\\"panel \"'${wide?'\"'wide':''}\\\">\"'${back?'\"'<button class=\\\"back\\\" data-action=\\\"back\\\" aria-label=\\\"Back\\\">×</button>':''}<div class=\\\"eyebrow\\\">\"'${kicker}</div><h1>${title}</h1>${content}</div></section>`;}\nfunction setMode(next){mode=next;document.body.classList.toggle('\"'playing',['playing','attract','transition','victory'].includes(mode));audio.setPaused(['pause','settings','dev','about','guide','defeat'].includes(mode));focusIndex=0;renderUI();}\nfunction goTitle(){if(net?.mode==='hub')return;game.auto=false;game.setCoop(false);localCoop=false;game.restart();net?.leave();lastActivity=performance.now();setMode('title');cameraX=13;audio.setStage(0);}\nfunction startGame(coop=false,{network=false}={}){localCoop=coop&&\"'!network;game.setCoop(coop);game.auto=false;game.god=false;game.restart();game.tuning.assist=settings.assist?1:.45;remoteInputs[2]={};networkPaused=false;routeTime=0;cameraX=11;setMode('\"'playing');showBanner();audio.voice('hello');}\nfunction showBanner(){bannerUntil=performance.now()+4200;}\nfunction toast(text){toastText=text;toastUntil=performance.now()+2300;}\nfunction startAttract(){game.setCoop(false);game.restart();game.auto=true;game.god=true;cameraX=11;setMode('attract');bannerUntil=0;}\nfunction pause(){if(mode==='playing'){returnMode='playing';if(net.active){networkPaused=true;toast('Camp break · expedition paused');}setMode('pause');}else if(mode==='pause'){networkPaused=false;setMode('playing');}}\nfunction getHint(){const p=game.players[0];if(game.stage===0)return p.swinging>=0?\"'`${key('\"'move')} Pump the swing \"'${key('\"'jump')} Let go on the upswing\"'`:`${key('\"'move')} Move \"'${key('\"'jump')} Jump · Vines catch automatically\"'`;\n if(game.stage===1)return `${key('\"'move')} Swim · Up for air \"'${key('\"'action')} Knife · Stun crocodiles\"'`;\n if(game.stage===2)return `${key('\"'jump')} Jump low rocks \"'${key('\"'duck')} Duck under high rocks\"'`;\n const near=game.pickups.some(c=>c.type==='\"'bell'&&\"'!c.taken&&Math.abs(c.x-p.x)<3);return near?`${key('\"'action')} Ring the Sunbell\"'!`:`${key('\"'move')} Move \"'${key('\"'jump')} Jump \"'${key('\"'action')} Tool · Ring three bells\"'`;}\nfunction renderHUD(){const p=game.players[0],c=CHAPTERS[game.stage];return `<div class=\"hud\"><div class=\"hud-top\"><div class=\"chapter-box\"><div class=\"chapter-tag\">CHAPTER 0${game.stage+1} / 04</div><div class=\"chapter-name\">${c.name}</div><div class=\"life-row\">${[0,1,2].map(i=>`<i class=\"life ${i>=p.health?'\"'empty':''}\\\"></i>\"'`).join('\"'')}\"'${game.players.length>1?'\"'<span style=\\\"margin-left:10px;font-size:13px;color:#86d6da\\\">SCOUT TWO ON TRAIL</span>':''}</div></div><div class=\\\"route-progress\\\">\"'${CHAPTERS.map((_,i)=>`${i?'\"'<em></em>':''}<i class=\\\"\"'${i<game.stage?'\"'done':i===game.stage?'current':''}\\\"></i>\"'`).join('\"'')}</div><div class=\\\"hud-right\\\"><div class=\\\"score\\\"><span id=\\\"score-text\\\">\"'${String(game.score).padStart(6,'\"'0')}</span><small>EXPEDITION SCORE</small></div><button class=\\\"pause-button\\\" data-action=\\\"pause\\\" aria-label=\\\"Pause\\\">Ⅱ</button></div></div><div class=\\\"hud-bottom\\\"><div class=\\\"hint\\\" id=\\\"hint\\\">\"'${getHint()}</div>${game.stage===1?`<div class=\"oxygen\"><span>AIR SUPPLY</span><div class=\"oxygen-track\"><div class=\"oxygen-fill\" id=\"oxygen\" style=\"width:${100*p.oxygen/game.tuning.oxygen}%\"></div></div></div>`:game.stage===3?`<div class=\"bell-count\" id=\"bell-count\">♧ ${game.bells} / 3</div>`:'\"''}</div></div>\"'${mode==='\"'attract'?'<div class=\\\"attract-label\\\">POSTCARDS FROM THE TRAIL<small>DEMONSTRATION · ANY INPUT TO RETURN</small></div>':''}\"'${isTouch&&mode==='\"'playing'?'<button id=\\\"touch-action\\\" class=\\\"touch-action\\\" data-action=\\\"touch\\\">JUMP</button>':''}\"'${debugOverlay?'\"'<div class=\\\"fps\\\" id=\\\"debug-state\\\"></div>':''}\"'`;}\nfunction renderUI(){\n if(!game)return;\n if(mode==='\"'title')ui.innerHTML=\"'`<section class=\"screen\"><div class=\"brand\"><div class=\"eyebrow\">An expedition in four acts</div><h1 class=\"title\">Jungle<span>Scurry</span></h1><p class=\"subtitle\">A little trouble.<br>A grand adventure.</p><nav class=\"menu\" aria-label=\"Main menu\">${button('\"'Begin expedition','start','primary')}\"'${button('\"'Bring a friend','coop')}\"'${button('\"'Field guide','guide')}\"'${button('\"'Settings','settings')}\"'${button('\"'About the expedition','about')}</nav><div class=\\\"title-note\\\">INSPIRED BY THE ARCADE ADVENTURES OF 1983<br>MOVE WITH \"'${lastInput==='\"'pad'?'THE LEFT STICK':lastInput==='touch'?'A DRAG':'WASD OR ARROW KEYS'} · \"'${glyph('\"'jump')} TO LEAP INTO TROUBLE</div></div><div class=\\\"edition\\\"><div class=\\\"seal\\\">✦</div><div>THE SUNBELL<br>EXPEDITION · 83</div></div><div class=\\\"route-ribbon\\\"><span>SWING</span><span>SWIM</span><span>SCRAMBLE</span><span>RESCUE</span></div></section>\"'`;\n else if(['\"'playing','attract'].includes(mode))ui.innerHTML=renderHUD();\n else if(mode==='pause')ui.innerHTML=panel('A moment to catch your breath.',\"'`<p>Professor Pip can wait a tick. Probably.</p><nav class=\"menu grid\">${button('\"'Back to the trail','resume','primary')}\"'${button('\"'Field guide','guide')}\"'${button('\"'Settings','settings')}\"'${button('\"'Dev camp','dev')}\"'${button('\"'Retry this chapter','retry')}\"'${net.mode!=='\"'hub'?button('Return to title','title'):button('Round status','hub-status')}</nav>\"'`,{back:false,kicker:'\"'CAMP BREAK'});\n else if(mode==='settings')ui.innerHTML=panel('Make yourself at home.',\"'`<div class=\"row\"><label for=\"music\">Music</label><input id=\"music\" data-setting=\"music\" type=\"range\" min=\"0\" max=\"1\" step=\".01\" value=\"${settings.music}\" aria-label=\"Music volume\"><output>${Math.round(settings.music*100)}%</output></div><div class=\"row\"><label for=\"sfx\">Effects & voices</label><input id=\"sfx\" data-setting=\"sfx\" type=\"range\" min=\"0\" max=\"1\" step=\".01\" value=\"${settings.sfx}\" aria-label=\"Effects volume\"><output>${Math.round(settings.sfx*100)}%</output></div><div class=\"row\"><label>Controller symbols</label><button class=\"toggle\" data-action=\"glyphs\">${settings.glyphs}</button></div><div class=\"row\"><label>Camera shake</label><button class=\"toggle\" data-action=\"shake\">${settings.shake?'\"'On':'Off'}</button></div><div class=\\\"row\\\"><label>Vine catch assistance</label><button class=\\\"toggle\\\" data-action=\\\"assist\\\">\"'${settings.assist?'\"'Generous':'Precise'}</button></div><p class=\\\"mini\\\">Music starts at 10%. Settings are saved on this device.</p><div class=\\\"menu\\\">\"'${button('\"'Back','back','primary')}</div>\"'`,{kicker:'\"'TRAIL PREFERENCES'});\n else if(mode==='guide')ui.innerHTML=panel('A pocket guide to peril.',\"'`<div class=\"scroll\">${[\n ['\"'The Emerald Canopy','Walk to the branch tip and jump. Vines catch you automatically. Pump right, then release as the vine swings upward to reach the next one.',\"'`${key('\"'move')} Move & pump \"'${key('\"'jump')} Jump / release\"'`],\n ['\"'Crocodile Creek','Swim in any direction. Your air lasts 15 seconds underwater. Surface, or find a pearly air bubble. The field knife stuns crocodiles for four seconds.',\"'`${lastInput==='\"'pad'?'Left stick':lastInput==='touch'?'Drag':'WASD / arrows'} Swim \"'${key('\"'action')} Knife\"'`],\n ['\"'The Rumbling Rise','Small rocks roll along the ground. Jump them\"'! Large rocks bounce at head height. Duck below those. Watch their shadows and plan the gap.'\"',\"'`${key('\"'jump')} Jump \"'${key('\"'duck')} Duck\"'`],\n ['\"'The Sunbell Rescue','Professor Pip is tangled in an old vine lift. Find and ring three golden bells to lower the basket. Stun the beetles, then meet Pip at the far flag.',\"'`${key('\"'action')} Ring / stun \"'${key('\"'jump')} Jump\"'`]\n ].map((c,i)=>`<div class=\"guide-card\"><div class=\"guide-num\">0${i+1}</div><div><h2>${c[0]}</h2><p>${c[1]}</p><div class=\"guide-controls\">${c[2]}</div></div></div>`).join('\"'')}<p class=\\\"mini\\\">Three leaf hearts per chapter. Falling returns you to the last vine. Fruit earns 100 points. Checkpoints never cost a life. In co-op, either scout can lead; a fallen friend rejoins the expedition. Couch Scout Two: IJKL, Right Shift to jump, O for tool. Touch: drag anywhere to move, tap to jump, use the contextual button for knife and bells.</p></div><div class=\\\"button-row\\\">\"'${button('\"'Back to it','back','primary')}</div>\"'`,{wide:true,kicker:'\"'FOUR WAYS TO GET INTO TROUBLE'});\n else if(mode==='coop')ui.innerHTML=panel('Better with company.',\"'`<p>Two scouts. One very eventful expedition.</p><nav class=\"menu grid\">${button('\"'Couch expedition','couch','primary')}\"'${button('\"'Nearby camp','nearby')}\"'${button('\"'Direct connection','direct')}\"'${button('\"'Back','back')}</nav><p class=\\\"mini\\\">Couch: two controllers, or share a keyboard. Nearby camp: two tabs on the same device. Direct connection: exchange two codes for an internet expedition. AI Hub connects scouts automatically.</p>\"'`,{kicker:'\"'BRING A FRIEND'});\n else if(mode==='nearby')ui.innerHTML=panel('Meet at camp.',\"'`<p>Open this game in another tab on this device. Share a camp code and set off together.</p><input class=\"input code\" id=\"room-code\" maxlength=\"24\" placeholder=\"CAMP CODE\" aria-label=\"Camp code\" value=\"${esc(net.room)}\"><div class=\"button-row\">${button('\"'Host camp','host-room','primary')}\"'${button('\"'Join camp','join-room')}</div><div class=\\\"connection-status\\\" id=\\\"net-status\\\">\"'${esc(net.status)}</div><div class=\"menu\">${button('\"'Set off together','network-start','primary',net.connected&&net.isHost?'':'disabled')}</div><p class=\\\"mini\\\">The host starts the expedition when both scouts have arrived.</p>\"'`,{kicker:'\"'NEARBY EXPEDITION'});\n else if(mode==='direct')ui.innerHTML=panel('A message across the jungle.',\"'`<p class=\"mini\">Host: create an invitation and send it to your friend. Friend: paste it below and answer. Host: paste the reply and connect.</p><div class=\"button-row\">${button('\"'1 · Create invite','offer','primary')}\"'${button('\"'2 · Answer invite','answer')}\"'${button('\"'3 · Connect reply','accept')}</div><textarea class=\\\"input pair-code\\\" id=\\\"pair-input\\\" placeholder=\\\"Paste your friend’s connection code here\\\" aria-label=\\\"Received connection code\\\"></textarea><textarea class=\\\"input pair-code\\\" id=\\\"pair-output\\\" readonly placeholder=\\\"Your code will appear here\\\" aria-label=\\\"Your connection code\\\">\"'${esc(pairOutput)}</textarea><div class=\"button-row\">${button('\"'Copy my code','copy')}\"'${button('\"'Set off together','network-start','primary',net.connected&&net.isHost?'':'disabled')}</div><div class=\\\"connection-status\\\" id=\\\"net-status\\\">\"'${esc(net.status)}</div><p class=\"mini\">Direct peer connection; no account required. Some restrictive networks block direct connections.</p>`,{wide:true,kicker:'\"'DIRECT EXPEDITION'});\n else if(mode==='about')renderAbout();\n else if(mode==='dev')renderDev();\n else if(mode==='defeat')ui.innerHTML=panel('A narrow escape\"'!'\"',\"'`<p>The jungle won that round. Your next cup of tea is still waiting at the Sunbells.</p><div class=\"rank\">CHAPTER 0${game.stage+1} · ${CHAPTERS[game.stage].short.toUpperCase()}</div><nav class=\"menu\" style=\"margin-top:24px\">${button('\"'Try this chapter again','retry','primary')}\"'${button('\"'Dev camp','dev')}\"'${button('\"'Return to title','title')}</nav>\"'`,{back:false,kicker:'\"'DUST OFF YOUR HAT'});\n else if(mode==='victory')ui.innerHTML=panel('Home in time for tea.',\"'`<p>Three bells ring out over the jungle. Pip is safe, the kettle is on, and your hat has almost survived.</p><div class=\"rank\">${game.auto?'\"'FIELD DEMONSTRATION':game.god?'DEV EXPEDITION':game.score>10500?'GOLDEN COMPASS CLUB':'SUNBELL EXPEDITION COMPLETE'}</div><div class=\\\"stats\\\"><div class=\\\"stat\\\"><strong>\"'${game.score.toLocaleString()}</strong><span>POINTS</span></div><div class=\"stat\"><strong>${formatTime(game.elapsed)}</strong><span>TRAIL TIME</span></div><div class=\"stat\"><strong>${game.fruit}</strong><span>FRUIT FOUND</span></div></div><nav class=\"menu grid\">${net.mode==='\"'hub'?button('Expedition complete','hub-status','primary'):button('One more adventure','replay','primary')}\"'${button('\"'About the expedition','about')}\"'${net.mode!=='\"'hub'?button('Return to title','title'):''}</nav>\"'`,{back:false,kicker:'\"'PROFESSOR PIP SENDS HIS THANKS'});\n else if(mode==='transition')ui.innerHTML=\"'`<div class=\"chapter-transition\"><div><div class=\"eyebrow\" style=\"justify-content:center\">TRAIL COMPLETE</div><div class=\"large-number\">0${game.stage+1}</div><h1>${CHAPTERS[game.stage].short} crossed!</h1><p>${game.stage===3?'\"'Three bells. One very grateful botanist.':\"'`Up next: ${CHAPTERS[game.stage+1].name}`}</p></div></div>`;\n else if(mode==='\"'hub-wait')ui.innerHTML=panel('Your expedition is ready.',\"'`<p>${esc(net.status)}<br>Waiting for AI Hub to sound the starting bell.</p><div class=\"loading-line\"></div><p class=\"mini\">${net.server?'\"'Dedicated expedition server':'Both scouts share the same trail. Your controller steers your own scout.'}</p>\"'`,{back:false,kicker:'\"'AI HUB'});\n if(['playing','attract'].includes(mode)&&toastUntil>performance.now())ui.insertAdjacentHTML('beforeend',\"'`<div class=\"toast\">${esc(toastText)}</div>`);\n bindUI();setFocus(0);\n}\nconst feedbackQuestions={testing:['\"'How many issues did testing catch?','How many were critical or game breaking?','Most helpful test','Least helpful test'],engine:['What did you like most about the engine?','Did you get stuck or guess wrong?','Most important thing built by hand','Hardest part of using the engine','Engine changes','One thing to change'],prompt:['What did you like most?','What was confusing?','Hardest thing to do','What would you change?']};\nfunction renderAbout(){const meta=globalThis.JUNGLE_CREDITS||{};const tabs=['Source','Testing','Engine','Prompt'];let content='';if(aboutTab===0){const s=meta.sourceInformation||{};content=Object.entries(s).map(([k,v])=>\"'`<div class=\"credit-row\"><b>${esc(k.replace(/([A-Z])/g,'\"' \"'$1'\"').replace(/\"'^./,c=>c.toUpperCase()))}</b><span>${esc(v)}</span></div>`).join('\"'');content+='<div class=\\\"credit-row\\\"><b>Created for</b><span>Michael Crosato · Original code, procedural art and synthesized sound. Jungle Hunt is the 1983 source inspiration; this is an original homage.</span></div>';}else{const group=['','testing','engine','prompt'][aboutTab],answers=meta[group+'Feedback']||[];content=feedbackQuestions[group].map((q,i)=>\"'`<div class=\"feedback-q\">${q}</div><div class=\"feedback-a\">${esc(answers[i]||'\"'unknown')}</div>\"'`).join('\"'');}ui.innerHTML=panel('The expedition log.',\"'`<div class=\"tabs\">${tabs.map((t,i)=>`<button class=\"${i===aboutTab?'\"'active':''}\\\" data-action=\\\"about-tab\\\" data-tab=\\\"\"'${i}\">${t}</button>`).join('\"'')}</div><div class=\\\"scroll\\\" tabindex=\\\"0\\\">\"'${content}</div><div class=\"button-row\">${button('\"'Back','back','primary')}</div>\"'`,{wide:true,kicker:'\"'ABOUT & CREDITS'});}\nconst sliders=[['moveSpeed','Move speed',3,14,.2],['jumpPower','Jump strength',6,17,.2],['gravity','Gravity',10,36,.5],['swingPower','Swing power',.5,5,.1],['oxygen','Air seconds',5,40,1],['hazardSpeed','Hazard speed',.2,2.5,.1],['damage','Hit damage',0,3,.5],['assist','Catch assistance',0,1.5,.05],['timeScale','Time scale',.25,2,.05]];\nfunction renderDev(){ui.innerHTML=panel('Welcome to dev camp.',\"'`<div class=\"scroll\"><div class=\"dev-grid\">${sliders.map(([k,l,min,max,step])=>`<div class=\"row\"><label for=\"tune-${k}\">${l}</label><input type=\"range\" id=\"tune-${k}\" data-tuning=\"${k}\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${game.tuning[k]}\"><output>${Number(game.tuning[k]).toFixed(step<1?2:0)}</output></div>`).join('\"'')}</div><div class=\\\"row\\\"><label>Invincible scout</label><button class=\\\"toggle\\\" data-action=\\\"god\\\">\"'${game.god?'\"'On':'Off'}</button></div><div class=\\\"row\\\"><label>Autopilot</label><button class=\\\"toggle\\\" data-action=\\\"auto\\\">\"'${game.auto?'\"'On':'Off'}</button></div><div class=\\\"row\\\"><label>Telemetry</label><button class=\\\"toggle\\\" data-action=\\\"telemetry\\\">\"'${debugOverlay?'\"'On':'Off'}</button></div><div class=\\\"dev-stats\\\">\"'${renderer?.backend?.isWebGPUBackend?'\"'WebGPU':'WebGL2 fallback'} · Three r180 · Rapier 0.19.3<br>Chapter \"'${game.stage+1} · x ${game.players[0].x.toFixed(2)} · y ${game.players[0].y.toFixed(2)} · ${frameCount} rendered frames</div></div><div class=\"button-row\">${button('\"'Next chapter','next-stage')}\"'${button('\"'Restore defaults','reset-tuning')}\"'${button('\"'Back to trail','resume','primary')}</div>\"'`,{wide:true,kicker:'\"'LIVE TUNING · CHANGES APPLY IMMEDIATELY'});}\nfunction bindUI(){for(const el of ui.querySelectorAll('button')){el.addEventListener('click',e=>{e.stopPropagation();activity(lastInput);unlock();doAction(el.dataset.action,el);});el.addEventListener('pointerenter',()=>{const list=focusable();const idx=list.indexOf(el);if(idx>=0)setFocus(idx);});}for(const el of ui.querySelectorAll('input[type=range]'))el.addEventListener('input',()=>{activity(lastInput);let v=+el.value;if(el.dataset.setting){settings[el.dataset.setting]=v;audio.setMusicVolume(settings.music);audio.setSfxVolume(settings.sfx);saveSettings();el.nextElementSibling.textContent=Math.round(v*100)+'%';}else{game.tuning[el.dataset.tuning]=v;el.nextElementSibling.textContent=v.toFixed(+el.step<1?2:0);}});for(const el of ui.querySelectorAll('input,textarea'))el.addEventListener('pointerdown',e=>e.stopPropagation());const touchBtn=\"'$('\"'#touch-action');if(touchBtn){touchBtn.addEventListener('pointerdown',e=>{e.preventDefault();e.stopPropagation();activity('touch');unlock();if(game.stage===1||game.stage===3&&nearBell())touchAction=true;else touchJump=true;});}}\nfunction focusable(){return [...ui.querySelectorAll('button:not(:disabled),input[type=range],input:not([type=range]),textarea')].filter(e=>e.offsetParent\"'!==null);}\nfunction setFocus(i){const list=focusable();if(!list.length)return;focusIndex=(i+list.length)%list.length;for(const e of ui.querySelectorAll('\"'.focused'))e.classList.remove('focused');list[focusIndex].classList.add('focused');}\nfunction menuMove(dir){const list=focusable();if(\"'!list.length)return;setFocus(focusIndex+dir);list[focusIndex].scrollIntoView({block:'\"'nearest'});audio.sfx('menu');}\nfunction menuAdjust(dir){const el=focusable()[focusIndex];if(el?.type==='range'){el.value=clamp(+el.value+dir*(+el.step||1),+el.min,+el.max);el.dispatchEvent(new Event('input'));}else if(mode==='about'){aboutTab=(aboutTab+dir+4)%4;renderUI();}else menuMove(dir);}\nfunction activateFocus(){focusable()[focusIndex]?.click();}\nfunction back(){if(mode==='pause')return pause();if(mode==='dev'){setMode('pause');return;}if(['settings','guide','about'].includes(mode)){setMode(returnMode);return;}if(mode==='nearby'||mode==='direct'){net.leave();setMode('coop');return;}if(mode==='coop'){setMode('title');return;}if(mode==='playing')pause();}\nasync function doAction(action,el){audio.sfx('menu');try{switch(action){case'start':startGame();break;case'couch':startGame(true);break;case'coop':returnMode='title';setMode('coop');break;case'guide':case'settings':case'about':returnMode=mode==='victory'?'victory':mode==='pause'?'pause':mode==='playing'?'pause':'title';setMode(action);break;case'back':back();break;case'pause':pause();break;case'resume':networkPaused=false;game.pending=false;setMode('playing');break;case'title':goTitle();break;case'retry':game.retry();setMode('playing');showBanner();break;case'replay':if(net.active&&net.isHost)net.begin();else startGame(localCoop);break;case'glyphs':settings.glyphs=settings.glyphs==='PlayStation'?'Xbox':'PlayStation';saveSettings();renderUI();break;case'shake':settings.shake=\"'!settings.shake;saveSettings();renderUI();break;case'\"'assist':settings.assist=\"'!settings.assist;game.tuning.assist=settings.assist?1:.45;saveSettings();renderUI();break;case'\"'dev':setMode('dev');break;case'god':game.god=\"'!game.god;renderUI();break;case'\"'auto':game.auto=\"'!game.auto;renderUI();break;case'\"'telemetry':debugOverlay=\"'!debugOverlay;renderUI();break;case'\"'reset-tuning':Object.assign(game.tuning,DEFAULTS);game.god=false;game.auto=false;renderUI();break;case'next-stage':game.setup((game.stage+1)%4);setMode('dev');break;case'about-tab':aboutTab=+el.dataset.tab;renderUI();break;case'nearby':case'direct':setMode(action);break;case'host-room':{const code=net.hostRoom(\"'$('\"'#room-code').value);\"'$('\"'#room-code').value=code;renderUI();break;}case'join-room':net.joinRoom(\"'$('\"'#room-code').value);break;case'network-start':if(net.connected&&net.isHost)net.begin();break;case'offer':el.disabled=true;pairOutput=await net.createOffer();renderUI();break;case'answer':pairOutput=await net.acceptOffer(\"'$('\"'#pair-input').value);renderUI();break;case'accept':await net.acceptAnswer(\"'$('\"'#pair-input').value);renderUI();break;case'copy':{try{await navigator.clipboard.writeText(\"'$('\"'#pair-output').value);toast('Connection code copied.');}catch{\"'$('\"'#pair-output').select();document.execCommand('copy');toast('Connection code selected.');}break;}case'hub-status':toast(net.status);break;case'touch':break;}}catch(err){toast(err.message);const status=\"'$('\"'#net-status');if(status)status.textContent=err.message;else console.error(err);}}\nfunction formatTime(t){return Math.floor(t/60)+':'+String(Math.floor(t%60)).padStart(2,'0');}\nfunction nearBell(){return game?.stage===3&&game.pickups.some(c=>c.type==='bell'&&\"'!c.taken&&Math.abs(c.x-game.players[0].x)<3.1);}\nfunction pollPads(now){padInputs.clear();let menuSignal=false;for(const pad of navigator.getGamepads?.()||[]){if(!pad)continue;const prev=padPrevious.get(pad.index)||[];const pressed=n=>!!pad.buttons[n]?.pressed;const edge=n=>pressed(n)&&!prev[n];const ax=v=>Math.abs(v||0)>.18?v:0;const x=ax(pad.axes[0])+(pressed(15)?1:0)-(pressed(14)?1:0),y=-ax(pad.axes[1])+(pressed(12)?1:0)-(pressed(13)?1:0);const any=x||y||pad.buttons.some((b,i)=>b.pressed&&!prev[i]);if(any){if(lastInput!=='\"'pad'&&mode==='title'){lastInput='pad';renderUI();}const exited=activity('pad');unlock();if(exited){padPrevious.set(pad.index,pad.buttons.map(b=>b.pressed));continue;}}\n const input={x:clamp(x,-1,1),y:clamp(y,-1,1),jump:edge(0),action:edge(2),duck:pressed(1)};padInputs.set(pad.index,input);if(edge(9)){pause();menuSignal=true;}else if(\"'!['\"'playing','attract','transition','victory'].includes(mode)){if(edge(0))activateFocus();if(edge(1))back();if(now>menuRepeat&&(Math.abs(x)>.5||Math.abs(y)>.5)){if(Math.abs(y)>Math.abs(x))menuMove(y>0?-1:1);else menuAdjust(x>0?1:-1);menuRepeat=now+220;}}else if(mode==='victory'){if(edge(0))activateFocus();if(edge(1))back();}padPrevious.set(pad.index,pad.buttons.map(b=>b.pressed));}return menuSignal;}\nfunction readInput(id){const pad=padInputs.get(id-1);if(id===1){const input={x:(keys.has('KeyD')||keys.has('ArrowRight')?1:0)-(keys.has('KeyA')||keys.has('ArrowLeft')?1:0),y:(keys.has('KeyW')||keys.has('ArrowUp')?1:0)-(keys.has('KeyS')||keys.has('ArrowDown')?1:0),jump:edges.has('Space'),action:edges.has('KeyE')||edges.has('KeyF')||edges.has('Mouse0'),duck:keys.has('KeyS')||keys.has('ArrowDown')};if(pad&&lastInput==='pad')Object.assign(input,pad);if(isTouch&&lastInput==='touch'){input.x=touchAxis.x;input.y=touchAxis.y;input.jump=touchJump;input.action=touchAction;input.duck=touchAxis.y<-.65;if(game.stage===1){input.action=input.action||game.enemies.some(e=>e.active&&e.stun<=0&&Math.abs(e.x-game.players[0].x)<3.2);if(game.players[0].oxygen<2.5)input.y=Math.max(input.y,.65);}}return input;}\n const input={x:(keys.has('KeyL')?1:0)-(keys.has('KeyJ')?1:0),y:(keys.has('KeyI')?1:0)-(keys.has('KeyK')?1:0),jump:edges.has('ShiftRight'),action:edges.has('KeyO'),duck:keys.has('KeyK')};if(pad)Object.assign(input,pad);return input;}\nfunction clearEdges(){edges.clear();touchJump=false;touchAction=false;for(const p of padInputs.values()){p.jump=false;p.action=false;}}\nfunction onGameEvent(type,data){\n const sounds={jump:'jump',grab:'grab',release:'release',land:'land',attack:'attack',swish:'attack',hit:'hit',pickup:'pickup',bubble:'bubble',stun:'attack',checkpoint:'checkpoint',bell:'win'};if(sounds[type])audio.sfx(sounds[type]);\n if(type==='stage'){audio.setStage(game?.stage??data.stage);world?.setStage(data.stage);}\n if(type==='hit'){shake=settings.shake?.3:0;audio.voice('hurt');}\n if(type==='checkpoint'&&mode\"'!=='\"'attract')toast('Trail marker reached');\n if(type==='bell'){toast(['First bell\"'! The vines begin to loosen.'\"','Second bell\"'! Pip can almost smell the tea.'\"','Three bells\"'! Meet Pip at the far flag.'\"'][data.index]||'A Sunbell rings\"'!'\"');audio.voice('happy');}\n if(type==='revive')toast('Your friend is back on the trail.');\n if(type==='defeat'){if(net?.hubActive){game.pending=false;game.players[0].health=3;game.checkpointPlayer(game.players[0]);}else setMode('defeat');}\n if(type==='stageClear'){transitionTimer=1.9;if(mode\"'!=='\"'attract')setMode('transition');}\n if(type==='win'){audio.sfx('win');audio.voice('win');if(mode==='attract'){transitionTimer=5;return;}setMode('victory');if(net?.active&&net.isHost)net.finish({scores:Object.fromEntries(net.players.map(p=>[p.id,game.score])),won:true,stats:game.statistics});try{localStorage.setItem('jungle-scurry-best',String(Math.max(game.score,+(localStorage.getItem('jungle-scurry-best')||0))));}catch{}}\n}\nfunction networkSeat(){if(\"'!net.active||net.mode!=='\"'hub')return net.isHost?1:2;const i=net.players.findIndex(p=>p.id===net.me);return i<0?0:i+1;}\nfunction updateNetworkStatus(){const status=\"'$('\"'#net-status');if(status)status.textContent=net.status;const btn=\"'$('\"'[data-action=\\\"network-start\\\"]');if(btn)btn.disabled=\"'!(net.connected&&net.isHost);}\nfunction networkSnapshot(){return{...game.snapshot(),screen:mode,transitionTimer,networkPaused};}\nfunction networkState(s){if(net.isHost)return;const old=game.stage;game.applySnapshot(s);if(old!==game.stage){world.setStage(game.stage);audio.setStage(game.stage);showBanner();}const screen=['\"'playing','transition','victory','defeat'].includes(s.screen)?s.screen:'playing';if(mode\"'!==screen)setMode(screen);transitionTimer=s.transitionTimer||0;networkPaused=!!s.networkPaused;}\nfunction setupNet(){net=new ExpeditionNet({onStatus:updateNetworkStatus,onInput:(input,id)=>{const seat=net.mode==='\"'hub'?net.players.findIndex(p=>p.id===id)+1:id+1;if(seat>0){const prev=remoteInputs[seat]||{};remoteInputs[seat]={...input,jump:\"'!!input.jump||!!prev.jump,action:!!input.action||!!prev.action};}},onState:networkState,onStart:()=>{startGame(net.players.length>1,{network:true});if(net.hubActive&&!net.canPlay)setMode('\"'hub-wait');},onTimeUp:()=>{if(net.isHost)net.finish({scores:Object.fromEntries(net.players.map(p=>[p.id,game.score])),won:game.won,stats:game.statistics});},onEnd:()=>{audio.setPaused(true);setMode('victory');audio.setPaused(true);},onLeave:()=>{toast('Your friend left the trail. Carry on, scout\"'!'\"');if(net.isHost){game.setCoop(false);}},onFinish:()=>{setMode('victory');}});}\nfunction showDynamicHUD(now){if(\"'!['\"'playing','attract'].includes(mode))return;\"'$('\"'#score-text')?.replaceChildren(String(game.score).padStart(6,'0'));const hint=\"'$('\"'#hint');if(hint)hint.innerHTML=getHint();const oxy=\"'$('\"'#oxygen');if(oxy){oxy.style.width=clamp(100*game.players[0].oxygen/game.tuning.oxygen,0,100)+'%';oxy.style.background=game.players[0].oxygen<4?'#ee9b63':'#8edac6';}const bell=\"'$('\"'#bell-count');if(bell)bell.textContent='♧ '+game.bells+' / 3';const lives=ui.querySelectorAll('.life');lives.forEach((el,i)=>el.classList.toggle('empty',i>=game.players[0].health));const tb=\"'$('\"'#touch-action');if(tb)tb.textContent=game.stage===1?'KNIFE':nearBell()?'RING':game.players[0].swinging>=0?'RELEASE':'JUMP';let banner=\"'$('\"'#stage-banner');if(now<bannerUntil&&mode==='playing'){if(\"'!banner){banner=document.createElement('\"'div');banner.id='stage-banner';banner.className='banner';ui.append(banner);}const c=CHAPTERS[game.stage];banner.innerHTML=\"'`<div class=\"banner-top\">THE SUNBELL EXPEDITION · 0${game.stage+1}</div><h2>${c.name}</h2><p>${c.goal}</p>`;}else banner?.remove();let toastEl=ui.querySelector('\"'.toast');if(now<toastUntil){if(\"'!toastEl){toastEl=document.createElement('\"'div');toastEl.className='toast';ui.append(toastEl);}toastEl.textContent=toastText;}else toastEl?.remove();const d=\"'$('\"'#debug-state');if(d)d.textContent=\"'`${renderer.backend.isWebGPUBackend?'\"'WebGPU':'WebGL2'} · \"'${frameCount} frames · bodies ${game.world.bodies.len()} · x ${game.players[0].x.toFixed(1)} y ${game.players[0].y.toFixed(1)}`;}\nfunction resize(){const w=innerWidth,h=innerHeight;renderer.setSize(w,h);const span=w/h<1.1?25:20;camera.left=-span*w/h/2;camera.right=span*w/h/2;camera.top=span/2;camera.bottom=-span/2;camera.updateProjectionMatrix();}\nfunction updateCamera(dt){let target=mode==='\"'title'?15.5:game.players[0].x+7;if(game.players.length>1)target=(Math.min(...game.players.map(p=>p.x))+Math.max(...game.players.map(p=>p.x)))/2+5;target=clamp(target,10,CHAPTERS[game.stage].length-8);cameraX+=(target-cameraX)*Math.min(1,dt*3.5);const cy=game.stage===0?8.1:game.stage===1?6:game.stage===2?6.5+Math.max(0,cameraX-12)*.035:7;shake=Math.max(0,shake-dt);const jitter=settings.shake?shake*.35:0;camera.position.set(cameraX+(Math.random()-.5)*jitter,cy+7,36);camera.lookAt(cameraX,cy,0);}\nfunction update(dt,now){pollPads(now);if(mode==='title'&&now-lastActivity>=10000&&\"'!net.active)startAttract();if(mode==='\"'hub-wait'&&net.canPlay){setMode('playing');showBanner();}\n const active=['playing','attract','transition'].includes(mode);if(active){const local=readInput(1);if(net.active&&mode\"'!=='\"'attract'){const seat=networkSeat();if(seat){const input=seat===1?local:local;net.sendInput(input);}if(net.isHost){if(mode==='playing'&&\"'!networkPaused&&(!net.hubActive||net.canPlay)){const inputs={1:{},2:{}};for(const p of game.players){const inp=remoteInputs[p.id]||{};inputs[p.id]={...inp};remoteInputs[p.id]={...inp,jump:false,action:false};}game.step(dt,inputs);}if(mode==='\"'transition'){transitionTimer-=dt;if(transitionTimer<=0){game.next();if(\"'!game.won){setMode('\"'playing');showBanner();}}}net.sendState(networkSnapshot());}}else{if(mode==='playing'||mode==='attract')game.step(dt,{1:local,2:readInput(2)});if(game.pending&&transitionTimer>0){transitionTimer-=dt;if(transitionTimer<=0){game.next();if(\"'!game.won&&mode!=='\"'attract'){setMode('playing');showBanner();}}}if(mode==='attract'&&game.won){transitionTimer-=dt;if(transitionTimer<=0){game.restart();game.auto=true;game.god=true;attractCycles++;}}}}\n else if(net.active&&net.isHost&&mode==='pause')net.sendState(networkSnapshot());\n clearEdges();const visual=game.visual();visual.time=active?game.time:game.time+now*.00015;visual.won=mode==='victory';if(mode==='title'){visual.time=now*.001;visual.player={...game.players[0],x:6,y:3,vx:0,onGround:true,swinging:-1};}if(visual.ghost)visual.ghost={...visual.ghost,stage:game.stage};world.update(dt,visual);updateCamera(dt);audio.update(dt,{stage:game.stage,mode,playing:active&&\"'!networkPaused});if(now-uiTick>100){showDynamicHUD(now);uiTick=now;}}\nasync function boot(){try{\n $('\"'#load-text').textContent='Unrolling the jungle…';await RAPIER.init();scene=new THREE.Scene();scene.background=new THREE.Color(0xa4c9a5);scene.fog=new THREE.Fog(0xa4c9a5,42,125);camera=new THREE.OrthographicCamera(-18,18,10,-10,.1,180);const params=new URLSearchParams(location.search);renderer=new THREE.WebGPURenderer({canvas:\"'$('\"'#view'),antialias:true,forceWebGL:params.get('renderer')==='webgl'});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.15;await renderer.init();\"'$('\"'#load-text').textContent='Finding the Professor…';game=new JungleGame(RAPIER,onGameEvent);world=createWorld(THREE,scene);setupNet();resize();window.addEventListener('resize',resize);setMode('title');updateCamera(1);await renderer.compileAsync(scene,camera);renderer.render(scene,camera);frameCount++;\"'$('\"'#loading').hidden=true;booted=true;\n globalThis.__JUNGLE={ready:true,game,audio,net,world,renderer,settings,chapters:CHAPTERS,state:()=>({mode,stage:game.stage,won:game.won,pending:game.pending,elapsed:game.elapsed,score:game.score,fruit:game.fruit,bells:game.bells,statistics:{...game.statistics},players:game.snapshot().players,backend:renderer.backend.isWebGPUBackend?'WebGPU':'WebGL2',frameCount,lastInput,attractCycles,network:net.mode,networkStats:net.stats,music:settings.music}),start:(coop=false)=>startGame(coop),pause,goTitle,attract:startAttract,setMode,action:doAction,step:(frames=1,input={})=>{for(let i=0;i<frames;i++){game.step(1/60,{1:input});if(game.pending){game.next();if(game.won)break;}}},render:()=>{world.update(0,game.visual());renderer.render(scene,camera);},offlineAudio:()=>JungleAudio.renderOfflineTest()};\n net.init().then(info=>{if(info){game.setCoop(net.players.length>1);setMode('hub-wait');net.ready();}}).catch(err=>{net.fail(err.message);toast(err.message);});\n renderer.setAnimationLoop(now=>{if(\"'!booted)return;const dt=Math.min(.05,(now-(lastNow||now-16.667))/1000);lastNow=now;try{update(dt,now);renderer.render(scene,camera);frameCount++;}catch(err){console.error('\"'Game loop:',err);globalThis.__JUNGLE.lastError=err.message;}});\n }catch(err){console.error(err);\"'$('\"'#load-text').textContent='The expedition could not open: '+err.message;\"'$('\"'#loading .loading-line')?.remove();const btn=document.createElement('button');btn.className='btn primary';btn.textContent='Try again';btn.onclick=()=>location.reload();\"'$('\"'#loading>div').append(btn);globalThis.__JUNGLE={ready:false,error:err.message};globalThis.AIHub?.active&&globalThis.AIHub.fail(err.message);}}\nwindow.addEventListener('keydown',e=>{if(e.target.matches('input,textarea')){activity('keyboard');if(e.code==='Escape'){e.target.blur();back();}return;}const exited=activity('keyboard');unlock();if(exited){e.preventDefault();return;}if(\"'!keys.has(e.code))edges.add(e.code);keys.add(e.code);if(['\"'Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Tab'].includes(e.code))e.preventDefault();if(\"'!booted)return;if(e.code==='\"'Escape'||e.code==='KeyP'){pause();if(mode\"'!=='\"'pause'&&mode\"'!=='\"'playing')back();return;}if(\"'!['\"'playing','attract','transition'].includes(mode)){if(e.code==='ArrowDown'||e.code==='KeyS'||e.code==='Tab')menuMove(e.shiftKey?-1:1);else if(e.code==='ArrowUp'||e.code==='KeyW')menuMove(-1);else if(e.code==='ArrowLeft'||e.code==='KeyA')menuAdjust(-1);else if(e.code==='ArrowRight'||e.code==='KeyD')menuAdjust(1);else if((e.code==='Enter'||e.code==='Space')&&\"'!e.repeat)activateFocus();else if(e.code==='\"'Backspace')back();}});\nwindow.addEventListener('keyup',e=>keys.delete(e.code));window.addEventListener('blur',()=>{keys.clear();edges.clear();});\nwindow.addEventListener('pointermove',e=>{if(e.pointerType==='touch')return;if(Math.abs(e.movementX)+Math.abs(e.movementY)>2){const now=performance.now();if(now-lastPointerMove>200){activity('keyboard');lastPointerMove=now;}}});\nwindow.addEventListener('pointerdown',e=>{const type=e.pointerType==='touch'?'touch':'keyboard';if(activity(type))return;unlock();if(e.target.closest('button,input,textarea,.scroll'))return;if(mode\"'!=='\"'playing')return;if(type==='touch'){touches.set(e.pointerId,{x:e.clientX,y:e.clientY,t:performance.now(),lastX:e.clientX,lastY:e.clientY});}else if(e.button===0)edges.add('Mouse0');});\nwindow.addEventListener('pointermove',e=>{if(e.pointerType\"'!=='\"'touch')return;const touch=touches.get(e.pointerId);if(\"'!touch)return;touch.lastX=e.clientX;touch.lastY=e.clientY;touchAxis={x:clamp((e.clientX-touch.x)/65,-1,1),y:clamp((touch.y-e.clientY)/65,-1,1)};});\nfunction endTouch(e){const touch=touches.get(e.pointerId);if(!touch)return;if(performance.now()-touch.t<250&&Math.hypot(touch.lastX-touch.x,touch.lastY-touch.y)<18)touchJump=true;touches.delete(e.pointerId);if(!touches.size)touchAxis={x:0,y:0};}\nwindow.addEventListener('\"'pointerup',endTouch);window.addEventListener('pointercancel',endTouch);window.addEventListener('contextmenu',e=>e.preventDefault());\nboot();\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"cat > main.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport RAPIER from '@dimforge/rapier3d-compat';\nimport {createWorld} from './world.js';\nimport {JungleGame,CHAPTERS,DEFAULTS} from './game.js';\nimport {JungleAudio} from './audio.js';\nimport {ExpeditionNet} from './network.js';\nconst \"'$=s=>document.querySelector(s), ui=$('\"'#ui');\nconst esc=s=>String(s??'').replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nlet mode='loading',returnMode='title',lastInput='keyboard',lastActivity=performance.now(),focusIndex=0,game,world,renderer,scene,camera,net,frameCount=0,transitionTimer=0,bannerUntil=0,toastUntil=0,toastText='',cameraX=13,shake=0,booted=false,accumulator=0,lastNow=0,uiTick=0,localCoop=false,aboutTab=0,debugOverlay=false,guidePage=0,attractCycles=0,pairOutput='',routeTime=0,networkPaused=false;\nconst settings={music:.1,sfx:.65,glyphs:'PlayStation',shake:true,assist:true};\ntry{const saved=JSON.parse(localStorage.getItem('jungle-scurry-settings'));if(saved)Object.assign(settings,saved);}catch{}\nconst audio=new JungleAudio();audio.setMusicVolume(settings.music);audio.setSfxVolume(settings.sfx);\nconst keys=new Set(),edges=new Set(),padPrevious=new Map(),padInputs=new Map(),remoteInputs={},touches=new Map();let touchAxis={x:0,y:0},touchJump=false,touchAction=false,touchDuck=false,menuRepeat=0,lastPointerMove=0;\nconst isTouch=matchMedia('(pointer:coarse)').matches||navigator.maxTouchPoints>0;\nif(isTouch){document.body.classList.add('body-touch');lastInput='touch';}\nconst prompts={keyboard:{move:'A D',jump:'Space',action:'E',duck:'S',pause:'Esc'},pad:{move:'L',jump:'×',action:'□',duck:'○',pause:'Options'},touch:{move:'drag',jump:'tap',action:'tap',duck:'drag ↓',pause:'Ⅱ'}};\nfunction glyph(name){if(lastInput==='pad'&&settings.glyphs==='Xbox')return({move:'L',jump:'A',action:'X',duck:'B',pause:'Menu'})[name];return(prompts[lastInput]||prompts.keyboard)[name];}\nfunction key(name){return \"'`<span class=\"key\">${glyph(name)}</span>`;}\nfunction saveSettings(){try{localStorage.setItem('\"'jungle-scurry-settings',JSON.stringify(settings));}catch{}}\nfunction activity(type='keyboard'){lastActivity=performance.now();if(type)lastInput=type;if(mode==='attract'){attractCycles++;goTitle();return true;}return false;}\nfunction unlock(){audio.unlock().catch(()=>{});}\nfunction button(label,action,cls='',extra=''){return \"'`<button class=\"btn ${cls}\" data-action=\"${action}\" ${extra}>${label}<span class=\"arrow\">↗</span></button>`;}\nfunction panel(title,content,{wide=false,back=true,kicker='\"'FIELD NOTES',id=''}={}){return \"'`<section class=\"screen screen-center\" ${id?`id=\"${id}\"`:'\"''}><div class=\\\"panel \"'${wide?'\"'wide':''}\\\">\"'${back?'\"'<button class=\\\"back\\\" data-action=\\\"back\\\" aria-label=\\\"Back\\\">×</button>':''}<div class=\\\"eyebrow\\\">\"'${kicker}</div><h1>${title}</h1>${content}</div></section>`;}\nfunction setMode(next){mode=next;document.body.classList.toggle('\"'playing',['playing','attract','transition','victory'].includes(mode));audio.setPaused(['pause','settings','dev','about','guide','defeat'].includes(mode));focusIndex=0;renderUI();}\nfunction goTitle(){if(net?.mode==='hub')return;game.auto=false;game.setCoop(false);localCoop=false;game.restart();net?.leave();lastActivity=performance.now();setMode('title');cameraX=13;audio.setStage(0);}\nfunction startGame(coop=false,{network=false}={}){localCoop=coop&&\"'!network;game.setCoop(coop);game.auto=false;game.god=false;game.restart();game.tuning.assist=settings.assist?1:.45;remoteInputs[2]={};networkPaused=false;routeTime=0;cameraX=11;setMode('\"'playing');showBanner();audio.voice('hello');}\nfunction showBanner(){bannerUntil=performance.now()+4200;}\nfunction toast(text){toastText=text;toastUntil=performance.now()+2300;}\nfunction startAttract(){game.setCoop(false);game.restart();game.auto=true;game.god=true;cameraX=11;setMode('attract');bannerUntil=0;}\nfunction pause(){if(mode==='playing'){returnMode='playing';if(net.active){networkPaused=true;toast('Camp break · expedition paused');}setMode('pause');}else if(mode==='pause'){networkPaused=false;setMode('playing');}}\nfunction getHint(){const p=game.players[0];if(game.stage===0)return p.swinging>=0?\"'`${key('\"'move')} Pump the swing \"'${key('\"'jump')} Let go on the upswing\"'`:`${key('\"'move')} Move \"'${key('\"'jump')} Jump · Vines catch automatically\"'`;\n if(game.stage===1)return `${key('\"'move')} Swim · Up for air \"'${key('\"'action')} Knife · Stun crocodiles\"'`;\n if(game.stage===2)return `${key('\"'jump')} Jump low rocks \"'${key('\"'duck')} Duck under high rocks\"'`;\n const near=game.pickups.some(c=>c.type==='\"'bell'&&\"'!c.taken&&Math.abs(c.x-p.x)<3);return near?`${key('\"'action')} Ring the Sunbell\"'!`:`${key('\"'move')} Move \"'${key('\"'jump')} Jump \"'${key('\"'action')} Tool · Ring three bells\"'`;}\nfunction renderHUD(){const p=game.players[0],c=CHAPTERS[game.stage];return `<div class=\"hud\"><div class=\"hud-top\"><div class=\"chapter-box\"><div class=\"chapter-tag\">CHAPTER 0${game.stage+1} / 04</div><div class=\"chapter-name\">${c.name}</div><div class=\"life-row\">${[0,1,2].map(i=>`<i class=\"life ${i>=p.health?'\"'empty':''}\\\"></i>\"'`).join('\"'')}\"'${game.players.length>1?'\"'<span style=\\\"margin-left:10px;font-size:13px;color:#86d6da\\\">SCOUT TWO ON TRAIL</span>':''}</div></div><div class=\\\"route-progress\\\">\"'${CHAPTERS.map((_,i)=>`${i?'\"'<em></em>':''}<i class=\\\"\"'${i<game.stage?'\"'done':i===game.stage?'current':''}\\\"></i>\"'`).join('\"'')}</div><div class=\\\"hud-right\\\"><div class=\\\"score\\\"><span id=\\\"score-text\\\">\"'${String(game.score).padStart(6,'\"'0')}</span><small>EXPEDITION SCORE</small></div><button class=\\\"pause-button\\\" data-action=\\\"pause\\\" aria-label=\\\"Pause\\\">Ⅱ</button></div></div><div class=\\\"hud-bottom\\\"><div class=\\\"hint\\\" id=\\\"hint\\\">\"'${getHint()}</div>${game.stage===1?`<div class=\"oxygen\"><span>AIR SUPPLY</span><div class=\"oxygen-track\"><div class=\"oxygen-fill\" id=\"oxygen\" style=\"width:${100*p.oxygen/game.tuning.oxygen}%\"></div></div></div>`:game.stage===3?`<div class=\"bell-count\" id=\"bell-count\">♧ ${game.bells} / 3</div>`:'\"''}</div></div>\"'${mode==='\"'attract'?'<div class=\\\"attract-label\\\">POSTCARDS FROM THE TRAIL<small>DEMONSTRATION · ANY INPUT TO RETURN</small></div>':''}\"'${isTouch&&mode==='\"'playing'?'<button id=\\\"touch-action\\\" class=\\\"touch-action\\\" data-action=\\\"touch\\\">JUMP</button>':''}\"'${debugOverlay?'\"'<div class=\\\"fps\\\" id=\\\"debug-state\\\"></div>':''}\"'`;}\nfunction renderUI(){\n if(!game)return;\n if(mode==='\"'title')ui.innerHTML=\"'`<section class=\"screen\"><div class=\"brand\"><div class=\"eyebrow\">An expedition in four acts</div><h1 class=\"title\">Jungle<span>Scurry</span></h1><p class=\"subtitle\">A little trouble.<br>A grand adventure.</p><nav class=\"menu\" aria-label=\"Main menu\">${button('\"'Begin expedition','start','primary')}\"'${button('\"'Bring a friend','coop')}\"'${button('\"'Field guide','guide')}\"'${button('\"'Settings','settings')}\"'${button('\"'About the expedition','about')}</nav><div class=\\\"title-note\\\">INSPIRED BY THE ARCADE ADVENTURES OF 1983<br>MOVE WITH \"'${lastInput==='\"'pad'?'THE LEFT STICK':lastInput==='touch'?'A DRAG':'WASD OR ARROW KEYS'} · \"'${glyph('\"'jump')} TO LEAP INTO TROUBLE</div></div><div class=\\\"edition\\\"><div class=\\\"seal\\\">✦</div><div>THE SUNBELL<br>EXPEDITION · 83</div></div><div class=\\\"route-ribbon\\\"><span>SWING</span><span>SWIM</span><span>SCRAMBLE</span><span>RESCUE</span></div></section>\"'`;\n else if(['\"'playing','attract'].includes(mode))ui.innerHTML=renderHUD();\n else if(mode==='pause')ui.innerHTML=panel('A moment to catch your breath.',\"'`<p>Professor Pip can wait a tick. Probably.</p><nav class=\"menu grid\">${button('\"'Back to the trail','resume','primary')}\"'${button('\"'Field guide','guide')}\"'${button('\"'Settings','settings')}\"'${button('\"'Dev camp','dev')}\"'${button('\"'Retry this chapter','retry')}\"'${net.mode!=='\"'hub'?button('Return to title','title'):button('Round status','hub-status')}</nav>\"'`,{back:false,kicker:'\"'CAMP BREAK'});\n else if(mode==='settings')ui.innerHTML=panel('Make yourself at home.',\"'`<div class=\"row\"><label for=\"music\">Music</label><input id=\"music\" data-setting=\"music\" type=\"range\" min=\"0\" max=\"1\" step=\".01\" value=\"${settings.music}\" aria-label=\"Music volume\"><output>${Math.round(settings.music*100)}%</output></div><div class=\"row\"><label for=\"sfx\">Effects & voices</label><input id=\"sfx\" data-setting=\"sfx\" type=\"range\" min=\"0\" max=\"1\" step=\".01\" value=\"${settings.sfx}\" aria-label=\"Effects volume\"><output>${Math.round(settings.sfx*100)}%</output></div><div class=\"row\"><label>Controller symbols</label><button class=\"toggle\" data-action=\"glyphs\">${settings.glyphs}</button></div><div class=\"row\"><label>Camera shake</label><button class=\"toggle\" data-action=\"shake\">${settings.shake?'\"'On':'Off'}</button></div><div class=\\\"row\\\"><label>Vine catch assistance</label><button class=\\\"toggle\\\" data-action=\\\"assist\\\">\"'${settings.assist?'\"'Generous':'Precise'}</button></div><p class=\\\"mini\\\">Music starts at 10%. Settings are saved on this device.</p><div class=\\\"menu\\\">\"'${button('\"'Back','back','primary')}</div>\"'`,{kicker:'\"'TRAIL PREFERENCES'});\n else if(mode==='guide')ui.innerHTML=panel('A pocket guide to peril.',\"'`<div class=\"scroll\">${[\n ['\"'The Emerald Canopy','Walk to the branch tip and jump. Vines catch you automatically. Pump right, then release as the vine swings upward to reach the next one.',\"'`${key('\"'move')} Move & pump \"'${key('\"'jump')} Jump / release\"'`],\n ['\"'Crocodile Creek','Swim in any direction. Your air lasts 15 seconds underwater. Surface, or find a pearly air bubble. The field knife stuns crocodiles for four seconds.',\"'`${lastInput==='\"'pad'?'Left stick':lastInput==='touch'?'Drag':'WASD / arrows'} Swim \"'${key('\"'action')} Knife\"'`],\n ['\"'The Rumbling Rise','Small rocks roll along the ground. Jump them\"'! Large rocks bounce at head height. Duck below those. Watch their shadows and plan the gap.'\"',\"'`${key('\"'jump')} Jump \"'${key('\"'duck')} Duck\"'`],\n ['\"'The Sunbell Rescue','Professor Pip is tangled in an old vine lift. Find and ring three golden bells to lower the basket. Stun the beetles, then meet Pip at the far flag.',\"'`${key('\"'action')} Ring / stun \"'${key('\"'jump')} Jump\"'`]\n ].map((c,i)=>`<div class=\"guide-card\"><div class=\"guide-num\">0${i+1}</div><div><h2>${c[0]}</h2><p>${c[1]}</p><div class=\"guide-controls\">${c[2]}</div></div></div>`).join('\"'')}<p class=\\\"mini\\\">Three leaf hearts per chapter. Falling returns you to the last vine. Fruit earns 100 points. Checkpoints never cost a life. In co-op, either scout can lead; a fallen friend rejoins the expedition. Couch Scout Two: IJKL, Right Shift to jump, O for tool. Touch: drag anywhere to move, tap to jump, use the contextual button for knife and bells.</p></div><div class=\\\"button-row\\\">\"'${button('\"'Back to it','back','primary')}</div>\"'`,{wide:true,kicker:'\"'FOUR WAYS TO GET INTO TROUBLE'});\n else if(mode==='coop')ui.innerHTML=panel('Better with company.',\"'`<p>Two scouts. One very eventful expedition.</p><nav class=\"menu grid\">${button('\"'Couch expedition','couch','primary')}\"'${button('\"'Nearby camp','nearby')}\"'${button('\"'Direct connection','direct')}\"'${button('\"'Back','back')}</nav><p class=\\\"mini\\\">Couch: two controllers, or share a keyboard. Nearby camp: two tabs on the same device. Direct connection: exchange two codes for an internet expedition. AI Hub connects scouts automatically.</p>\"'`,{kicker:'\"'BRING A FRIEND'});\n else if(mode==='nearby')ui.innerHTML=panel('Meet at camp.',\"'`<p>Open this game in another tab on this device. Share a camp code and set off together.</p><input class=\"input code\" id=\"room-code\" maxlength=\"24\" placeholder=\"CAMP CODE\" aria-label=\"Camp code\" value=\"${esc(net.room)}\"><div class=\"button-row\">${button('\"'Host camp','host-room','primary')}\"'${button('\"'Join camp','join-room')}</div><div class=\\\"connection-status\\\" id=\\\"net-status\\\">\"'${esc(net.status)}</div><div class=\"menu\">${button('\"'Set off together','network-start','primary',net.connected&&net.isHost?'':'disabled')}</div><p class=\\\"mini\\\">The host starts the expedition when both scouts have arrived.</p>\"'`,{kicker:'\"'NEARBY EXPEDITION'});\n else if(mode==='direct')ui.innerHTML=panel('A message across the jungle.',\"'`<p class=\"mini\">Host: create an invitation and send it to your friend. Friend: paste it below and answer. Host: paste the reply and connect.</p><div class=\"button-row\">${button('\"'1 · Create invite','offer','primary')}\"'${button('\"'2 · Answer invite','answer')}\"'${button('\"'3 · Connect reply','accept')}</div><textarea class=\\\"input pair-code\\\" id=\\\"pair-input\\\" placeholder=\\\"Paste your friend’s connection code here\\\" aria-label=\\\"Received connection code\\\"></textarea><textarea class=\\\"input pair-code\\\" id=\\\"pair-output\\\" readonly placeholder=\\\"Your code will appear here\\\" aria-label=\\\"Your connection code\\\">\"'${esc(pairOutput)}</textarea><div class=\"button-row\">${button('\"'Copy my code','copy')}\"'${button('\"'Set off together','network-start','primary',net.connected&&net.isHost?'':'disabled')}</div><div class=\\\"connection-status\\\" id=\\\"net-status\\\">\"'${esc(net.status)}</div><p class=\"mini\">Direct peer connection; no account required. Some restrictive networks block direct connections.</p>`,{wide:true,kicker:'\"'DIRECT EXPEDITION'});\n else if(mode==='about')renderAbout();\n else if(mode==='dev')renderDev();\n else if(mode==='defeat')ui.innerHTML=panel('A narrow escape\"'!'\"',\"'`<p>The jungle won that round. Your next cup of tea is still waiting at the Sunbells.</p><div class=\"rank\">CHAPTER 0${game.stage+1} · ${CHAPTERS[game.stage].short.toUpperCase()}</div><nav class=\"menu\" style=\"margin-top:24px\">${button('\"'Try this chapter again','retry','primary')}\"'${button('\"'Dev camp','dev')}\"'${button('\"'Return to title','title')}</nav>\"'`,{back:false,kicker:'\"'DUST OFF YOUR HAT'});\n else if(mode==='victory')ui.innerHTML=panel('Home in time for tea.',\"'`<p>Three bells ring out over the jungle. Pip is safe, the kettle is on, and your hat has almost survived.</p><div class=\"rank\">${game.auto?'\"'FIELD DEMONSTRATION':game.god?'DEV EXPEDITION':game.score>10500?'GOLDEN COMPASS CLUB':'SUNBELL EXPEDITION COMPLETE'}</div><div class=\\\"stats\\\"><div class=\\\"stat\\\"><strong>\"'${game.score.toLocaleString()}</strong><span>POINTS</span></div><div class=\"stat\"><strong>${formatTime(game.elapsed)}</strong><span>TRAIL TIME</span></div><div class=\"stat\"><strong>${game.fruit}</strong><span>FRUIT FOUND</span></div></div><nav class=\"menu grid\">${net.mode==='\"'hub'?button('Expedition complete','hub-status','primary'):button('One more adventure','replay','primary')}\"'${button('\"'About the expedition','about')}\"'${net.mode!=='\"'hub'?button('Return to title','title'):''}</nav>\"'`,{back:false,kicker:'\"'PROFESSOR PIP SENDS HIS THANKS'});\n else if(mode==='transition')ui.innerHTML=\"'`<div class=\"chapter-transition\"><div><div class=\"eyebrow\" style=\"justify-content:center\">TRAIL COMPLETE</div><div class=\"large-number\">0${game.stage+1}</div><h1>${CHAPTERS[game.stage].short} crossed!</h1><p>${game.stage===3?'\"'Three bells. One very grateful botanist.':\"'`Up next: ${CHAPTERS[game.stage+1].name}`}</p></div></div>`;\n else if(mode==='\"'hub-wait')ui.innerHTML=panel('Your expedition is ready.',\"'`<p>${esc(net.status)}<br>Waiting for AI Hub to sound the starting bell.</p><div class=\"loading-line\"></div><p class=\"mini\">${net.server?'\"'Dedicated expedition server':'Both scouts share the same trail. Your controller steers your own scout.'}</p>\"'`,{back:false,kicker:'\"'AI HUB'});\n if(['playing','attract'].includes(mode)&&toastUntil>performance.now())ui.insertAdjacentHTML('beforeend',\"'`<div class=\"toast\">${esc(toastText)}</div>`);\n bindUI();setFocus(0);\n}\nconst feedbackQuestions={testing:['\"'How many issues did testing catch?','How many were critical or game breaking?','Most helpful test','Least helpful test'],engine:['What did you like most about the engine?','Did you get stuck or guess wrong?','Most important thing built by hand','Hardest part of using the engine','Engine changes','One thing to change'],prompt:['What did you like most?','What was confusing?','Hardest thing to do','What would you change?']};\nfunction renderAbout(){const meta=globalThis.JUNGLE_CREDITS||{};const tabs=['Source','Testing','Engine','Prompt'];let content='';if(aboutTab===0){const s=meta.sourceInformation||{};content=Object.entries(s).map(([k,v])=>\"'`<div class=\"credit-row\"><b>${esc(k.replace(/([A-Z])/g,'\"' \"'$1'\"').replace(/\"'^./,c=>c.toUpperCase()))}</b><span>${esc(v)}</span></div>`).join('\"'');content+='<div class=\\\"credit-row\\\"><b>Created for</b><span>Michael Crosato · Original code, procedural art and synthesized sound. Jungle Hunt is the 1983 source inspiration; this is an original homage.</span></div>';}else{const group=['','testing','engine','prompt'][aboutTab],answers=meta[group+'Feedback']||[];content=feedbackQuestions[group].map((q,i)=>\"'`<div class=\"feedback-q\">${q}</div><div class=\"feedback-a\">${esc(answers[i]||'\"'unknown')}</div>\"'`).join('\"'');}ui.innerHTML=panel('The expedition log.',\"'`<div class=\"tabs\">${tabs.map((t,i)=>`<button class=\"${i===aboutTab?'\"'active':''}\\\" data-action=\\\"about-tab\\\" data-tab=\\\"\"'${i}\">${t}</button>`).join('\"'')}</div><div class=\\\"scroll\\\" tabindex=\\\"0\\\">\"'${content}</div><div class=\"button-row\">${button('\"'Back','back','primary')}</div>\"'`,{wide:true,kicker:'\"'ABOUT & CREDITS'});}\nconst sliders=[['moveSpeed','Move speed',3,14,.2],['jumpPower','Jump strength',6,17,.2],['gravity','Gravity',10,36,.5],['swingPower','Swing power',.5,5,.1],['oxygen','Air seconds',5,40,1],['hazardSpeed','Hazard speed',.2,2.5,.1],['damage','Hit damage',0,3,.5],['assist','Catch assistance',0,1.5,.05],['timeScale','Time scale',.25,2,.05]];\nfunction renderDev(){ui.innerHTML=panel('Welcome to dev camp.',\"'`<div class=\"scroll\"><div class=\"dev-grid\">${sliders.map(([k,l,min,max,step])=>`<div class=\"row\"><label for=\"tune-${k}\">${l}</label><input type=\"range\" id=\"tune-${k}\" data-tuning=\"${k}\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${game.tuning[k]}\"><output>${Number(game.tuning[k]).toFixed(step<1?2:0)}</output></div>`).join('\"'')}</div><div class=\\\"row\\\"><label>Invincible scout</label><button class=\\\"toggle\\\" data-action=\\\"god\\\">\"'${game.god?'\"'On':'Off'}</button></div><div class=\\\"row\\\"><label>Autopilot</label><button class=\\\"toggle\\\" data-action=\\\"auto\\\">\"'${game.auto?'\"'On':'Off'}</button></div><div class=\\\"row\\\"><label>Telemetry</label><button class=\\\"toggle\\\" data-action=\\\"telemetry\\\">\"'${debugOverlay?'\"'On':'Off'}</button></div><div class=\\\"dev-stats\\\">\"'${renderer?.backend?.isWebGPUBackend?'\"'WebGPU':'WebGL2 fallback'} · Three r180 · Rapier 0.19.3<br>Chapter \"'${game.stage+1} · x ${game.players[0].x.toFixed(2)} · y ${game.players[0].y.toFixed(2)} · ${frameCount} rendered frames</div></div><div class=\"button-row\">${button('\"'Next chapter','next-stage')}\"'${button('\"'Restore defaults','reset-tuning')}\"'${button('\"'Back to trail','resume','primary')}</div>\"'`,{wide:true,kicker:'\"'LIVE TUNING · CHANGES APPLY IMMEDIATELY'});}\nfunction bindUI(){for(const el of ui.querySelectorAll('button')){el.addEventListener('click',e=>{e.stopPropagation();activity(lastInput);unlock();doAction(el.dataset.action,el);});el.addEventListener('pointerenter',()=>{const list=focusable();const idx=list.indexOf(el);if(idx>=0)setFocus(idx);});}for(const el of ui.querySelectorAll('input[type=range]'))el.addEventListener('input',()=>{activity(lastInput);let v=+el.value;if(el.dataset.setting){settings[el.dataset.setting]=v;audio.setMusicVolume(settings.music);audio.setSfxVolume(settings.sfx);saveSettings();el.nextElementSibling.textContent=Math.round(v*100)+'%';}else{game.tuning[el.dataset.tuning]=v;el.nextElementSibling.textContent=v.toFixed(+el.step<1?2:0);}});for(const el of ui.querySelectorAll('input,textarea'))el.addEventListener('pointerdown',e=>e.stopPropagation());const touchBtn=\"'$('\"'#touch-action');if(touchBtn){touchBtn.addEventListener('pointerdown',e=>{e.preventDefault();e.stopPropagation();activity('touch');unlock();if(game.stage===1||game.stage===3&&nearBell())touchAction=true;else touchJump=true;});}}\nfunction focusable(){return [...ui.querySelectorAll('button:not(:disabled),input[type=range],input:not([type=range]),textarea')].filter(e=>e.offsetParent\"'!==null);}\nfunction setFocus(i){const list=focusable();if(!list.length)return;focusIndex=(i+list.length)%list.length;for(const e of ui.querySelectorAll('\"'.focused'))e.classList.remove('focused');list[focusIndex].classList.add('focused');}\nfunction menuMove(dir){const list=focusable();if(\"'!list.length)return;setFocus(focusIndex+dir);list[focusIndex].scrollIntoView({block:'\"'nearest'});audio.sfx('menu');}\nfunction menuAdjust(dir){const el=focusable()[focusIndex];if(el?.type==='range'){el.value=clamp(+el.value+dir*(+el.step||1),+el.min,+el.max);el.dispatchEvent(new Event('input'));}else if(mode==='about'){aboutTab=(aboutTab+dir+4)%4;renderUI();}else menuMove(dir);}\nfunction activateFocus(){focusable()[focusIndex]?.click();}\nfunction back(){if(mode==='pause')return pause();if(mode==='dev'){setMode('pause');return;}if(['settings','guide','about'].includes(mode)){setMode(returnMode);return;}if(mode==='nearby'||mode==='direct'){net.leave();setMode('coop');return;}if(mode==='coop'){setMode('title');return;}if(mode==='playing')pause();}\nasync function doAction(action,el){audio.sfx('menu');try{switch(action){case'start':startGame();break;case'couch':startGame(true);break;case'coop':returnMode='title';setMode('coop');break;case'guide':case'settings':case'about':returnMode=mode==='victory'?'victory':mode==='pause'?'pause':mode==='playing'?'pause':'title';setMode(action);break;case'back':back();break;case'pause':pause();break;case'resume':networkPaused=false;game.pending=false;setMode('playing');break;case'title':goTitle();break;case'retry':game.retry();setMode('playing');showBanner();break;case'replay':if(net.active&&net.isHost)net.begin();else startGame(localCoop);break;case'glyphs':settings.glyphs=settings.glyphs==='PlayStation'?'Xbox':'PlayStation';saveSettings();renderUI();break;case'shake':settings.shake=\"'!settings.shake;saveSettings();renderUI();break;case'\"'assist':settings.assist=\"'!settings.assist;game.tuning.assist=settings.assist?1:.45;saveSettings();renderUI();break;case'\"'dev':setMode('dev');break;case'god':game.god=\"'!game.god;renderUI();break;case'\"'auto':game.auto=\"'!game.auto;renderUI();break;case'\"'telemetry':debugOverlay=\"'!debugOverlay;renderUI();break;case'\"'reset-tuning':Object.assign(game.tuning,DEFAULTS);game.god=false;game.auto=false;renderUI();break;case'next-stage':game.setup((game.stage+1)%4);setMode('dev');break;case'about-tab':aboutTab=+el.dataset.tab;renderUI();break;case'nearby':case'direct':setMode(action);break;case'host-room':{const code=net.hostRoom(\"'$('\"'#room-code').value);\"'$('\"'#room-code').value=code;renderUI();break;}case'join-room':net.joinRoom(\"'$('\"'#room-code').value);break;case'network-start':if(net.connected&&net.isHost)net.begin();break;case'offer':el.disabled=true;pairOutput=await net.createOffer();renderUI();break;case'answer':pairOutput=await net.acceptOffer(\"'$('\"'#pair-input').value);renderUI();break;case'accept':await net.acceptAnswer(\"'$('\"'#pair-input').value);renderUI();break;case'copy':{try{await navigator.clipboard.writeText(\"'$('\"'#pair-output').value);toast('Connection code copied.');}catch{\"'$('\"'#pair-output').select();document.execCommand('copy');toast('Connection code selected.');}break;}case'hub-status':toast(net.status);break;case'touch':break;}}catch(err){toast(err.message);const status=\"'$('\"'#net-status');if(status)status.textContent=err.message;else console.error(err);}}\nfunction formatTime(t){return Math.floor(t/60)+':'+String(Math.floor(t%60)).padStart(2,'0');}\nfunction nearBell(){return game?.stage===3&&game.pickups.some(c=>c.type==='bell'&&\"'!c.taken&&Math.abs(c.x-game.players[0].x)<3.1);}\nfunction pollPads(now){padInputs.clear();let menuSignal=false;for(const pad of navigator.getGamepads?.()||[]){if(!pad)continue;const prev=padPrevious.get(pad.index)||[];const pressed=n=>!!pad.buttons[n]?.pressed;const edge=n=>pressed(n)&&!prev[n];const ax=v=>Math.abs(v||0)>.18?v:0;const x=ax(pad.axes[0])+(pressed(15)?1:0)-(pressed(14)?1:0),y=-ax(pad.axes[1])+(pressed(12)?1:0)-(pressed(13)?1:0);const any=x||y||pad.buttons.some((b,i)=>b.pressed&&!prev[i]);if(any){if(lastInput!=='\"'pad'&&mode==='title'){lastInput='pad';renderUI();}const exited=activity('pad');unlock();if(exited){padPrevious.set(pad.index,pad.buttons.map(b=>b.pressed));continue;}}\n const input={x:clamp(x,-1,1),y:clamp(y,-1,1),jump:edge(0),action:edge(2),duck:pressed(1)};padInputs.set(pad.index,input);if(edge(9)){pause();menuSignal=true;}else if(\"'!['\"'playing','attract','transition','victory'].includes(mode)){if(edge(0))activateFocus();if(edge(1))back();if(now>menuRepeat&&(Math.abs(x)>.5||Math.abs(y)>.5)){if(Math.abs(y)>Math.abs(x))menuMove(y>0?-1:1);else menuAdjust(x>0?1:-1);menuRepeat=now+220;}}else if(mode==='victory'){if(edge(0))activateFocus();if(edge(1))back();}padPrevious.set(pad.index,pad.buttons.map(b=>b.pressed));}return menuSignal;}\nfunction readInput(id){const pad=padInputs.get(id-1);if(id===1){const input={x:(keys.has('KeyD')||keys.has('ArrowRight')?1:0)-(keys.has('KeyA')||keys.has('ArrowLeft')?1:0),y:(keys.has('KeyW')||keys.has('ArrowUp')?1:0)-(keys.has('KeyS')||keys.has('ArrowDown')?1:0),jump:edges.has('Space'),action:edges.has('KeyE')||edges.has('KeyF')||edges.has('Mouse0'),duck:keys.has('KeyS')||keys.has('ArrowDown')};if(pad&&lastInput==='pad')Object.assign(input,pad);if(isTouch&&lastInput==='touch'){input.x=touchAxis.x;input.y=touchAxis.y;input.jump=touchJump;input.action=touchAction;input.duck=touchAxis.y<-.65;if(game.stage===1){input.action=input.action||game.enemies.some(e=>e.active&&e.stun<=0&&Math.abs(e.x-game.players[0].x)<3.2);if(game.players[0].oxygen<2.5)input.y=Math.max(input.y,.65);}}return input;}\n const input={x:(keys.has('KeyL')?1:0)-(keys.has('KeyJ')?1:0),y:(keys.has('KeyI')?1:0)-(keys.has('KeyK')?1:0),jump:edges.has('ShiftRight'),action:edges.has('KeyO'),duck:keys.has('KeyK')};if(pad)Object.assign(input,pad);return input;}\nfunction clearEdges(){edges.clear();touchJump=false;touchAction=false;for(const p of padInputs.values()){p.jump=false;p.action=false;}}\nfunction onGameEvent(type,data){\n const sounds={jump:'jump',grab:'grab',release:'release',land:'land',attack:'attack',swish:'attack',hit:'hit',pickup:'pickup',bubble:'bubble',stun:'attack',checkpoint:'checkpoint',bell:'win'};if(sounds[type])audio.sfx(sounds[type]);\n if(type==='stage'){audio.setStage(game?.stage??data.stage);world?.setStage(data.stage);}\n if(type==='hit'){shake=settings.shake?.3:0;audio.voice('hurt');}\n if(type==='checkpoint'&&mode\"'!=='\"'attract')toast('Trail marker reached');\n if(type==='bell'){toast(['First bell\"'! The vines begin to loosen.'\"','Second bell\"'! Pip can almost smell the tea.'\"','Three bells\"'! Meet Pip at the far flag.'\"'][data.index]||'A Sunbell rings\"'!'\"');audio.voice('happy');}\n if(type==='revive')toast('Your friend is back on the trail.');\n if(type==='defeat'){if(net?.hubActive){game.pending=false;game.players[0].health=3;game.checkpointPlayer(game.players[0]);}else setMode('defeat');}\n if(type==='stageClear'){transitionTimer=1.9;if(mode\"'!=='\"'attract')setMode('transition');}\n if(type==='win'){audio.sfx('win');audio.voice('win');if(mode==='attract'){transitionTimer=5;return;}setMode('victory');if(net?.active&&net.isHost)net.finish({scores:Object.fromEntries(net.players.map(p=>[p.id,game.score])),won:true,stats:game.statistics});try{localStorage.setItem('jungle-scurry-best',String(Math.max(game.score,+(localStorage.getItem('jungle-scurry-best')||0))));}catch{}}\n}\nfunction networkSeat(){if(\"'!net.active||net.mode!=='\"'hub')return net.isHost?1:2;const i=net.players.findIndex(p=>p.id===net.me);return i<0?0:i+1;}\nfunction updateNetworkStatus(){const status=\"'$('\"'#net-status');if(status)status.textContent=net.status;const btn=\"'$('\"'[data-action=\\\"network-start\\\"]');if(btn)btn.disabled=\"'!(net.connected&&net.isHost);}\nfunction networkSnapshot(){return{...game.snapshot(),screen:mode,transitionTimer,networkPaused};}\nfunction networkState(s){if(net.isHost)return;const old=game.stage;game.applySnapshot(s);if(old!==game.stage){world.setStage(game.stage);audio.setStage(game.stage);showBanner();}const screen=['\"'playing','transition','victory','defeat'].includes(s.screen)?s.screen:'playing';if(mode\"'!==screen)setMode(screen);transitionTimer=s.transitionTimer||0;networkPaused=!!s.networkPaused;}\nfunction setupNet(){net=new ExpeditionNet({onStatus:updateNetworkStatus,onInput:(input,id)=>{const seat=net.mode==='\"'hub'?net.players.findIndex(p=>p.id===id)+1:id+1;if(seat>0){const prev=remoteInputs[seat]||{};remoteInputs[seat]={...input,jump:\"'!!input.jump||!!prev.jump,action:!!input.action||!!prev.action};}},onState:networkState,onStart:()=>{startGame(net.players.length>1,{network:true});if(net.hubActive&&!net.canPlay)setMode('\"'hub-wait');},onTimeUp:()=>{if(net.isHost)net.finish({scores:Object.fromEntries(net.players.map(p=>[p.id,game.score])),won:game.won,stats:game.statistics});},onEnd:()=>{audio.setPaused(true);setMode('victory');audio.setPaused(true);},onLeave:()=>{toast('Your friend left the trail. Carry on, scout\"'!'\"');if(net.isHost){game.setCoop(false);}},onFinish:()=>{setMode('victory');}});}\nfunction showDynamicHUD(now){if(\"'!['\"'playing','attract'].includes(mode))return;\"'$('\"'#score-text')?.replaceChildren(String(game.score).padStart(6,'0'));const hint=\"'$('\"'#hint');if(hint)hint.innerHTML=getHint();const oxy=\"'$('\"'#oxygen');if(oxy){oxy.style.width=clamp(100*game.players[0].oxygen/game.tuning.oxygen,0,100)+'%';oxy.style.background=game.players[0].oxygen<4?'#ee9b63':'#8edac6';}const bell=\"'$('\"'#bell-count');if(bell)bell.textContent='♧ '+game.bells+' / 3';const lives=ui.querySelectorAll('.life');lives.forEach((el,i)=>el.classList.toggle('empty',i>=game.players[0].health));const tb=\"'$('\"'#touch-action');if(tb)tb.textContent=game.stage===1?'KNIFE':nearBell()?'RING':game.players[0].swinging>=0?'RELEASE':'JUMP';let banner=\"'$('\"'#stage-banner');if(now<bannerUntil&&mode==='playing'){if(\"'!banner){banner=document.createElement('\"'div');banner.id='stage-banner';banner.className='banner';ui.append(banner);}const c=CHAPTERS[game.stage];banner.innerHTML=\"'`<div class=\"banner-top\">THE SUNBELL EXPEDITION · 0${game.stage+1}</div><h2>${c.name}</h2><p>${c.goal}</p>`;}else banner?.remove();let toastEl=ui.querySelector('\"'.toast');if(now<toastUntil){if(\"'!toastEl){toastEl=document.createElement('\"'div');toastEl.className='toast';ui.append(toastEl);}toastEl.textContent=toastText;}else toastEl?.remove();const d=\"'$('\"'#debug-state');if(d)d.textContent=\"'`${renderer.backend.isWebGPUBackend?'\"'WebGPU':'WebGL2'} · \"'${frameCount} frames · bodies ${game.world.bodies.len()} · x ${game.players[0].x.toFixed(1)} y ${game.players[0].y.toFixed(1)}`;}\nfunction resize(){const w=innerWidth,h=innerHeight;renderer.setSize(w,h);const span=w/h<1.1?25:20;camera.left=-span*w/h/2;camera.right=span*w/h/2;camera.top=span/2;camera.bottom=-span/2;camera.updateProjectionMatrix();}\nfunction updateCamera(dt){let target=mode==='\"'title'?15.5:game.players[0].x+7;if(game.players.length>1)target=(Math.min(...game.players.map(p=>p.x))+Math.max(...game.players.map(p=>p.x)))/2+5;target=clamp(target,10,CHAPTERS[game.stage].length-8);cameraX+=(target-cameraX)*Math.min(1,dt*3.5);const cy=game.stage===0?8.1:game.stage===1?6:game.stage===2?6.5+Math.max(0,cameraX-12)*.035:7;shake=Math.max(0,shake-dt);const jitter=settings.shake?shake*.35:0;camera.position.set(cameraX+(Math.random()-.5)*jitter,cy+7,36);camera.lookAt(cameraX,cy,0);}\nfunction update(dt,now){pollPads(now);if(mode==='title'&&now-lastActivity>=10000&&\"'!net.active)startAttract();if(mode==='\"'hub-wait'&&net.canPlay){setMode('playing');showBanner();}\n const active=['playing','attract','transition'].includes(mode);if(active){const local=readInput(1);if(net.active&&mode\"'!=='\"'attract'){const seat=networkSeat();if(seat){const input=seat===1?local:local;net.sendInput(input);}if(net.isHost){if(mode==='playing'&&\"'!networkPaused&&(!net.hubActive||net.canPlay)){const inputs={1:{},2:{}};for(const p of game.players){const inp=remoteInputs[p.id]||{};inputs[p.id]={...inp};remoteInputs[p.id]={...inp,jump:false,action:false};}game.step(dt,inputs);}if(mode==='\"'transition'){transitionTimer-=dt;if(transitionTimer<=0){game.next();if(\"'!game.won){setMode('\"'playing');showBanner();}}}net.sendState(networkSnapshot());}}else{if(mode==='playing'||mode==='attract')game.step(dt,{1:local,2:readInput(2)});if(game.pending&&transitionTimer>0){transitionTimer-=dt;if(transitionTimer<=0){game.next();if(\"'!game.won&&mode!=='\"'attract'){setMode('playing');showBanner();}}}if(mode==='attract'&&game.won){transitionTimer-=dt;if(transitionTimer<=0){game.restart();game.auto=true;game.god=true;attractCycles++;}}}}\n else if(net.active&&net.isHost&&mode==='pause')net.sendState(networkSnapshot());\n clearEdges();const visual=game.visual();visual.time=active?game.time:game.time+now*.00015;visual.won=mode==='victory';if(mode==='title'){visual.time=now*.001;visual.player={...game.players[0],x:6,y:3,vx:0,onGround:true,swinging:-1};}if(visual.ghost)visual.ghost={...visual.ghost,stage:game.stage};world.update(dt,visual);updateCamera(dt);audio.update(dt,{stage:game.stage,mode,playing:active&&\"'!networkPaused});if(now-uiTick>100){showDynamicHUD(now);uiTick=now;}}\nasync function boot(){try{\n $('\"'#load-text').textContent='Unrolling the jungle…';await RAPIER.init();scene=new THREE.Scene();scene.background=new THREE.Color(0xa4c9a5);scene.fog=new THREE.Fog(0xa4c9a5,42,125);camera=new THREE.OrthographicCamera(-18,18,10,-10,.1,180);const params=new URLSearchParams(location.search);renderer=new THREE.WebGPURenderer({canvas:\"'$('\"'#view'),antialias:true,forceWebGL:params.get('renderer')==='webgl'});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.15;await renderer.init();\"'$('\"'#load-text').textContent='Finding the Professor…';game=new JungleGame(RAPIER,onGameEvent);world=createWorld(THREE,scene);setupNet();resize();window.addEventListener('resize',resize);setMode('title');updateCamera(1);await renderer.compileAsync(scene,camera);renderer.render(scene,camera);frameCount++;\"'$('\"'#loading').hidden=true;booted=true;\n globalThis.__JUNGLE={ready:true,game,audio,net,world,renderer,settings,chapters:CHAPTERS,state:()=>({mode,stage:game.stage,won:game.won,pending:game.pending,elapsed:game.elapsed,score:game.score,fruit:game.fruit,bells:game.bells,statistics:{...game.statistics},players:game.snapshot().players,backend:renderer.backend.isWebGPUBackend?'WebGPU':'WebGL2',frameCount,lastInput,attractCycles,network:net.mode,networkStats:net.stats,music:settings.music}),start:(coop=false)=>startGame(coop),pause,goTitle,attract:startAttract,setMode,action:doAction,step:(frames=1,input={})=>{for(let i=0;i<frames;i++){game.step(1/60,{1:input});if(game.pending){game.next();if(game.won)break;}}},render:()=>{world.update(0,game.visual());renderer.render(scene,camera);},offlineAudio:()=>JungleAudio.renderOfflineTest()};\n net.init().then(info=>{if(info){game.setCoop(net.players.length>1);setMode('hub-wait');net.ready();}}).catch(err=>{net.fail(err.message);toast(err.message);});\n renderer.setAnimationLoop(now=>{if(\"'!booted)return;const dt=Math.min(.05,(now-(lastNow||now-16.667))/1000);lastNow=now;try{update(dt,now);renderer.render(scene,camera);frameCount++;}catch(err){console.error('\"'Game loop:',err);globalThis.__JUNGLE.lastError=err.message;}});\n }catch(err){console.error(err);\"'$('\"'#load-text').textContent='The expedition could not open: '+err.message;\"'$('\"'#loading .loading-line')?.remove();const btn=document.createElement('button');btn.className='btn primary';btn.textContent='Try again';btn.onclick=()=>location.reload();\"'$('\"'#loading>div').append(btn);globalThis.__JUNGLE={ready:false,error:err.message};globalThis.AIHub?.active&&globalThis.AIHub.fail(err.message);}}\nwindow.addEventListener('keydown',e=>{if(e.target.matches('input,textarea')){activity('keyboard');if(e.code==='Escape'){e.target.blur();back();}return;}const exited=activity('keyboard');unlock();if(exited){e.preventDefault();return;}if(\"'!keys.has(e.code))edges.add(e.code);keys.add(e.code);if(['\"'Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Tab'].includes(e.code))e.preventDefault();if(\"'!booted)return;if(e.code==='\"'Escape'||e.code==='KeyP'){pause();if(mode\"'!=='\"'pause'&&mode\"'!=='\"'playing')back();return;}if(\"'!['\"'playing','attract','transition'].includes(mode)){if(e.code==='ArrowDown'||e.code==='KeyS'||e.code==='Tab')menuMove(e.shiftKey?-1:1);else if(e.code==='ArrowUp'||e.code==='KeyW')menuMove(-1);else if(e.code==='ArrowLeft'||e.code==='KeyA')menuAdjust(-1);else if(e.code==='ArrowRight'||e.code==='KeyD')menuAdjust(1);else if((e.code==='Enter'||e.code==='Space')&&\"'!e.repeat)activateFocus();else if(e.code==='\"'Backspace')back();}});\nwindow.addEventListener('keyup',e=>keys.delete(e.code));window.addEventListener('blur',()=>{keys.clear();edges.clear();});\nwindow.addEventListener('pointermove',e=>{if(e.pointerType==='touch')return;if(Math.abs(e.movementX)+Math.abs(e.movementY)>2){const now=performance.now();if(now-lastPointerMove>200){activity('keyboard');lastPointerMove=now;}}});\nwindow.addEventListener('pointerdown',e=>{const type=e.pointerType==='touch'?'touch':'keyboard';if(activity(type))return;unlock();if(e.target.closest('button,input,textarea,.scroll'))return;if(mode\"'!=='\"'playing')return;if(type==='touch'){touches.set(e.pointerId,{x:e.clientX,y:e.clientY,t:performance.now(),lastX:e.clientX,lastY:e.clientY});}else if(e.button===0)edges.add('Mouse0');});\nwindow.addEventListener('pointermove',e=>{if(e.pointerType\"'!=='\"'touch')return;const touch=touches.get(e.pointerId);if(\"'!touch)return;touch.lastX=e.clientX;touch.lastY=e.clientY;touchAxis={x:clamp((e.clientX-touch.x)/65,-1,1),y:clamp((touch.y-e.clientY)/65,-1,1)};});\nfunction endTouch(e){const touch=touches.get(e.pointerId);if(!touch)return;if(performance.now()-touch.t<250&&Math.hypot(touch.lastX-touch.x,touch.lastY-touch.y)<18)touchJump=true;touches.delete(e.pointerId);if(!touches.size)touchAxis={x:0,y:0};}\nwindow.addEventListener('\"'pointerup',endTouch);window.addEventListener('pointercancel',endTouch);window.addEventListener('contextmenu',e=>e.preventDefault());\nboot();\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_18","type":"agent_message","text":"The four chapters are implemented, including co-op state, synthesized audio, controller menus, and live tuning. Simulation tests caught two bugs: high boulders were too easy to clear, and two scouts could trigger the same chapter finish twice. Both are fixed; I’m moving on to browser and AI Hub checks.\n"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"cat > build.mjs <<'EOF'\nimport {build} from 'esbuild';\nimport fs from 'node:fs/promises';\nconst stem='Jungle-Scurry-Jungle-Hunt-gpt-6.1-sol-ultra-20261105-215315';\nconst result=await build({entryPoints:['main.js'],bundle:true,minify:true,format:'iife',target:'es2022',write:false,legalComments:'none',logLevel:'silent'});\nconst js=result.outputFiles[0].text.replace(/<\\\\/script/gi,'<\\\\\\\\/script');\nconst shell=await fs.readFile('shell.html','utf8');\nconst session=await fs.readFile('hub-session.js','utf8');\nconst credits=JSON.parse(await fs.readFile('../exit-interview.json','utf8'));\nconst html=shell.replace('<\"'!-- HUB_SESSION -->'\"',\"'`<script>${session}</script>`).replace('\"'<\"'!-- GAME_SCRIPT -->'\"',\"'`<script>globalThis.JUNGLE_CREDITS=${JSON.stringify(credits).replace(/</g,'\"'\\\\\\\\u003c')};</script>\\\\n<script>\"'${js}</script>`);\nawait fs.writeFile(`../${stem}.html`,html);\nconsole.log(`Built ${stem}.html (${(Buffer.byteLength(html)/1024/1024).toFixed(2)} MB, all dependencies embedded).`);\nEOF\npython3 - <<'\"'PY'\nimport json\nobj={'sourceInformation':{'date':'2026-11-05 21:53:15','source':'Jungle Hunt (1983)','plan':'none','genre':'Arcade action platformer / adventure','perspective':'2.5D side-scrolling, orthographic camera','tech':'Three.js r180 WebGPURenderer (WebGPU, WebGL2 fallback); Rapier 0.19.3; Gamepad API; Web Audio API; embedded JavaScript and WASM','artDirection':'Procedural three-band cel shading, dark ink outlines, lush illustrated jungle dioramas','animation':'Three.js AnimationMixer and original keyframe clips for idle, run, jump, swing, swim, tool use and celebration','audio':'Code-generated four-chapter marimba/flute/percussion score, 13 synthesized effects, formant gibberish voices; music defaults to 10%','online':'AI Hub shared-world co-op; standalone couch co-op, same-origin camp rooms via BroadcastChannel, direct WebRTC invitation/reply; 1–2 players','testing':'Headless Chromium WebGPU and WebGL2; real Rapier simulation; scripted complete expedition; emulated gamepad; touch profiles; offline audio; official AI Hub harness and peer transport tests','research':'none for source/design; only the user-specified AI Hub integration files were read','environment':'Codex CLI (headless); Linux','model':'OpenAI, gpt-6.1-sol, reasoning effort ultra','usage':'added on import'},'testingFeedback':['2 confirmed issues so far; final browser results pending.','0 confirmed game-breaking issues so far; final browser results pending.','Real Rapier simulation of the complete expedition plus specific collision and co-op assertions.','unknown'],'engineFeedback':['Three.js native keyframe animation and procedural geometry made a cohesive original visual style possible.','The high boulder collision height and duplicate co-op chapter completion needed corrections.','The four-chapter gameplay, controller focus system, procedural art/audio, and shared-world co-op.','Coordinating rendering, physics, controller input, and authoritative network snapshots.','none','A built-in controller-first game shell with shared simulation/transport lifecycle would reduce integration work.'],'promptFeedback':['The four distinct source mechanics and clear controller-first and attract-mode requirements.','The no-research rule alongside the required external integration reference; treated source research as prohibited and read only the named integration code.','Making four different arcade mechanics feel like one polished expedition across input methods and co-op.','Separate required source research from permitted integration-documentation access.'],'aiHub':{'name':'Jungle Scurry','tagline':'A little trouble. A grand adventure.','description':'Swing across the canopy, dive past crocodiles, dodge a rumbling hillside and ring three Sunbells to rescue Professor Pip. A lush ink-and-cel arcade expedition for one or two scouts.','type':'Game','genre':'Platformer','source':'Jungle Hunt (1983)','series':'','players':'1–2','controls':'WASD/arrows or left stick to move; Space/Cross to jump or release; E/Square to use tool or ring; S/Circle to duck; Esc/Options to pause. Touch drag and contextual tap.','tags':['3d','arcade','co-op','side-scrolling','retro','adventure']}}\nopen('../exit-interview.json','w').write(json.dumps(obj,indent=2,ensure_ascii=False)+'\\\\n')\nPY\nnode build.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
