{"type":"item.completed","item":{"id":"item_75","type":"command_execution","command":"/bin/bash -lc \"sed -n '8,18p' src/network.js && sed -n '1,22p' build.mjs\"","aggregated_output":" join(code){this.close();this.mode='room';this.isHost=false;this.me=-1;this.room=code.toUpperCase().replace(/[^A-Z0-9]/g,'').slice(0,6);this.players=[];this.startChannel();this.status='Looking for your friends…';this.cb.status?.();this.helloTimer=setInterval(()=>{if(this.me<0)this.send({type:'hello'});},600);this.timeoutTimer=setTimeout(()=>{if(this.me<0){this.status='No answer yet. Check the code and that the host is still here. Same-browser rooms also work offline.';this.cb.status?.();}},13000);this.send({type:'hello'});try{this.peer=new Peer(undefined,{debug:0});this.peer.on('open',()=>this.attach(this.peer.connect('extra-trusting-'+this.room,{reliable:true})));this.peer.on('error',()=>{if(this.me<0){this.status='Still looking locally. Online signaling could not be reached.';this.cb.status?.();}});}catch{}}\n startChannel(){this.heartbeat=setInterval(()=>{if(this.mode!=='room')return;this.send({type:'ping'});if(this.isHost){for(const [token,id] of this.memberTokens){if(Date.now()-(this.lastSeen.get(token)||Date.now())>15000){this.memberTokens.delete(token);this.lastSeen.delete(token);this.players=this.players.filter(p=>p.id!==id);this.cb.leave?.(id);this.send({type:'roster',players:this.players});this.cb.status?.();}}}else if(this.me>=0&&this.hostToken&&Date.now()-(this.lastSeen.get(this.hostToken)||Date.now())>15000){this.cb.disconnected?.();}},1500);if('BroadcastChannel'in window){this.channel=new BroadcastChannel('extra-trusting-'+this.room);this.channel.onmessage=e=>this.receive(e.data);}}\n attach(conn){conn.on('open',()=>{this.connections.set(conn.peer,conn);if(!this.isHost)this.send({type:'hello'});});conn.on('data',data=>this.receive(data));conn.on('close',()=>{this.connections.delete(conn.peer);});conn.on('error',()=>{});}\n send(data,target=null){if(this.mode==='hub'){if(!this.ended)this.hub.send(data,{to:this.isHost?undefined:this.hub.host,reliable:data.type!=='state'});return;}if(this.mode!=='room')return;const packet={...data,_from:this.token,_target:target,_id:this.token+':'+(++this.packet)};this.channel?.postMessage(packet);for(const c of this.connections.values())if(c.open)c.send(packet);}\n receive(data){if(!data||data._from===this.token||(data._target&&data._target!==this.token)||this.received.has(data._id))return;this.received.add(data._id);this.lastSeen.set(data._from,Date.now());if(this.received.size>2000)this.received.delete(this.received.values().next().value);\n if(this.isHost&&data.type==='hello'){\n let id=this.memberTokens.get(data._from);if(id===undefined){if(this.players.length>=4){this.send({type:'full'},data._from);return;}id=[0,1,2,3].find(n=>!this.players.some(p=>p.id===n));this.memberTokens.set(data._from,id);const player={id,name:['June','Mara','Kit','Sam'][id],color:['#ff9b72','#9ed4e0','#c6d77c','#d6b1e6'][id]};this.players.push(player);this.cb.join?.(player);}\n this.send({type:'welcome',me:id,players:this.players,started:this.started},data._from);this.send({type:'roster',players:this.players});this.status=this.players.length+' friends in the room.';this.cb.status?.();\n }else if(!this.isHost&&data.type==='welcome'){clearInterval(this.helloTimer);clearTimeout(this.timeoutTimer);this.me=data.me;this.hostToken=data._from;this.players=data.players;this.status='You’re together. '+(data.started?'The night is already underway.':'Waiting for June to start the night.');this.cb.joined?.();this.cb.status?.();if(data.started&&!this.started){this.started=true;this.cb.start?.();}}\n else if(data.type==='roster'&&!this.isHost){this.players=data.players;this.cb.status?.();}\n else if(data.type==='begin'&&!this.isHost&&!this.started){this.started=true;this.cb.start?.();}\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { spawnSync } from 'node:child_process';\nimport { resolve } from 'node:path';\nconst {stem}=JSON.parse(readFileSync('selection.json','utf8'));\nconst result=spawnSync('bun',['build','src/main.js','--target','browser','--minify','--outfile','bundle.js'],{encoding:'utf8'});\nif(result.status!==0) { console.error(result.stderr);process.exit(1); }\nconst js=readFileSync('bundle.js','utf8').replaceAll('</script','<\\\\/script');\nconst session=readFileSync('vendor/session.js','utf8');\nlet page=readFileSync('src/page.html','utf8').replace('<!--HUB_CLIENT-->',()=>`<script>${session}</script>`).replace('/*INLINE_CSS*/',()=>readFileSync('src/style.css','utf8')).replace('<!--GAME_SCRIPT-->',()=>`<script type=\"module\">${js}</script>`);\npage=page.replace('<!--LIBRARY_LICENSES-->',()=>'<script type=\"text/plain\" id=\"third-party-licenses\">'+readFileSync('LICENSES.txt','utf8').replaceAll('</script','<\\\\/script')+'</script>');\nconst credits=JSON.parse(readFileSync('credits.json','utf8'));page=page.replace('/*CREDITS_DATA*/',()=>JSON.stringify(credits));\nwriteFileSync(resolve('..',stem+'.html'),page);writeFileSync('game.html',page);\nconsole.log('Built '+stem+'.html');\n","exit_code":0,"status":"completed"}}
