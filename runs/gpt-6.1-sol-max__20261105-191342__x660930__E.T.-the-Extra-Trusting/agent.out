{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport os\nroot=str(Path.cwd())\nrows={}\nfor entry in Path('/proc').iterdir():\n if not entry.name.isdigit():continue\n try:\n  raw=(entry/'stat').read_text();end=raw.rfind(')');parts=raw[end+2:].split();ppid=int(parts[1]);cmd=(entry/'cmdline').read_bytes().replace(b'\\\\0',b' ').decode(errors='replace');rows[int(entry.name)]=(ppid,cmd,entry)\n except (OSError,ValueError):pass\nroots=[]\nfor pid,(ppid,cmd,p) in rows.items():\n try:\n  if os.readlink(p/'cwd')==root and 'python tests/probe.py' in cmd and 'bash' not in cmd:roots.append(pid)\n except OSError:pass\nfor pid in roots:\n print('probe',pid)\n ids={pid}\n for _ in range(6):ids.update(n for n,r in rows.items() if r[0] in ids)\n for n in sorted(ids):\n  ppid,cmd,p=rows[n]\n  print(n,ppid,cmd[:210])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
