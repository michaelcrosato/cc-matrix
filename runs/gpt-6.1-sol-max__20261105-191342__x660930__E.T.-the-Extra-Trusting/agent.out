{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"rg -n '__hubCheck|limit=|scenario|setTimeout|data-complete|test' vendor/harness.html | tail -45\"","aggregated_output":"73:const scenario = params.get('scenario') || 'standard';\n74:/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\n75:const serverMode = scenario === 'server';\n124:  if (url.origin !== location.origin || !/^https?:$/.test(url.protocol)) return null;\n379: * page's origin). Results land in window.__hubCheck, and body[data-complete]\n383:const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\n384:async function until(test, ms) {\n387:    if (test()) return true;\n390:  return test();\n400:  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\n411:  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n412:  window.__hubCheck = report;\n477:    if (scenario === 'host-leave') removeCell(state.cells[0]);\n505:    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n","exit_code":0,"status":"completed"}}
