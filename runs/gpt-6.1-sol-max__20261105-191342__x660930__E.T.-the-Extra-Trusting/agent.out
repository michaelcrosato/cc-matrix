{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"cat > src/style.css <<'EOF'\n:root{--cream:#f6edce;--muted:#bbc6be;--ink:#102330;--gold:#e8bf72;--mint:#b7f4cd;--coral:#ff9e82;--panel:rgba(10,25,35,.94);font-family:'Trebuchet MS','Segoe UI',sans-serif;color:var(--cream);color-scheme:dark;font-synthesis:none}*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden;background:#111d2b;touch-action:none;overscroll-behavior:none}button,input,select{font:inherit}button{cursor:pointer;border:0;color:var(--cream);background:transparent;text-align:left;-webkit-tap-highlight-color:transparent;transition:background .18s,color .18s,transform .18s}button:focus-visible,input:focus-visible,.focused{outline:2px solid var(--gold)\"'!important;outline-offset:5px;background-color:rgba(232,191,114,.13)!important}button:hover{color:var(--gold)}button:disabled{opacity:.35;cursor:default}input[type=range]{width:220px;accent-color:var(--mint);cursor:pointer}input[type=text]{font-size:26px;padding:16px;width:100%;background:#19303a;border:1px solid #627571;border-radius:4px;color:var(--cream);text-transform:uppercase;letter-spacing:.16em}a{color:var(--mint)}.hidden{display:none!important}#world{position:absolute;inset:0;width:100%;height:100%;display:block;outline:none}#grain{position:absolute;inset:0;pointer-events:none;opacity:.035;background-image:url(\"data:image/svg+xml,%3Csvg viewBox='\"'0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Cpath fill='%23ffffff' filter='url(%23n)' opacity='.8' d='M0 0h180v180H0z'/%3E%3C/svg%3E\\\");z-index:3}#vignette{position:absolute;inset:0;box-shadow:inset 0 0 18vw 3vw rgba(3,13,25,.52);pointer-events:none;z-index:2}#flash{position:absolute;inset:0;background:#d5ffe3;opacity:0;pointer-events:none;z-index:6;transition:opacity .3s}.screen{position:absolute;inset:0;z-index:7}.eyebrow{font-size:13px;letter-spacing:.23em;font-weight:700;line-height:1.6;color:var(--gold)}.tiny-star{font-size:18px;margin-right:10px}.title-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(7,21,32,.94),rgba(7,21,32,.67) 30%,rgba(7,21,32,0) 68%),linear-gradient(0deg,rgba(7,21,32,.8),transparent 20%);pointer-events:none}.title-top{position:absolute;top:5%;left:5%;right:5%;display:flex;justify-content:space-between;align-items:center;font-size:12px;letter-spacing:.16em;color:var(--muted)}.brand{font-weight:700}.brand i{font-family:Georgia,serif;color:var(--gold);margin-left:14px;letter-spacing:0}.edition{font-size:10px}.title-content{position:absolute;top:18%;left:7%;width:45%;max-width:620px}.game-title{margin:10px 0 22px;font-weight:400;line-height:.83;text-shadow:0 3px 0 #06121b}.game-title>span{display:block;font-family:Georgia,'Times New Roman',serif;font-style:italic;font-size:clamp(92px,10.4vw,174px);letter-spacing:-.055em;color:var(--cream);margin-left:-8px}.game-title small{display:block;font-family:Georgia,serif;font-style:italic;font-size:clamp(25px,3.1vw,54px);font-weight:400;line-height:1.2;margin-top:12px;color:var(--gold);white-space:nowrap}.tagline{font-family:Georgia,serif;font-size:clamp(20px,1.8vw,30px);line-height:1.35;color:#c6d3ca;margin:20px 0 26px}.menu-stack{display:flex;flex-direction:column;align-items:stretch;width:290px;gap:5px}.menu-stack button{font-size:18px;padding:10px 16px 10px 0;min-height:42px}.menu-stack button.primary{padding:15px 18px;background:var(--cream);color:#152936;border-radius:3px;margin-bottom:6px}.primary{background:var(--cream);color:var(--ink);border-radius:3px;padding:16px 24px;font-weight:700}.primary:hover{background:var(--gold);color:var(--ink)}button span:only-child{float:right}.menu-stack button>span{float:right;font-size:24px}.menu-stack button em{font-size:11px;letter-spacing:.13em;margin-left:10px;font-style:normal;border:1px solid #607267;border-radius:12px;