e, input) { this.entry = { score, mode, name: [0, 0, 0], i: 0, done, t: 0, input: input || null }; (input || this.game.input).consumeAll(); } // MASH TV PATCH P3\");\nrep('P3b', \"const I = this.game.input, e = this.entry, tap = clicked(I);\\n    if (e) {\", \"const e = this.entry, I = (e && e.input) || this.game.input, tap = clicked(I);\\n    if (e) { // MASH TV PATCH P3b\");\nrep('P3c', \"const yes = I.pressed('start') || I.pressed('confirm') || !!tap, paid\",\n  \"const yes = (this.game.players || [I]).some(q => q.pressed('start') || q.pressed('confirm')) || !!tap, paid /* MASH TV PATCH P3c */\");\n// P4: audio bus getter\nrep('P4', \"  /** true once the browser lets the game make sound */\\n  get ready()\", \"  get bus() { this._init(); return this._sfxBus; } // MASH TV PATCH P4\\n  /** true once the browser lets the game make sound */\\n  get ready()\");\nwriteFileSync(F, s); console.log(log.join(', '));\nEOF\nnode tools/patch-engine.mjs && cat > engine/PATCHES.md <<'EOF'\n# MASH TV engine patches (applied by tools/patch-engine.mjs to the handoff's my-3d2dge.js v0.85.2)\n\n| # | Patch | Why |\n|---|---|---|\n| P1 | `E.HOOKS = HOOKS` | The game switches every player's input preset each step (arrows aim in play, navigate in menus) before the Shell reads navigation. |\n| P2 | The standard `glyphs` setting defaults to `playstation`, offers PlayStation or Xbox, and sets `glyphs` on every `game.players` input | TASK.md wants PlayStation glyphs by default with an Xbox option; the stock default is `auto` and updates only P1. |\n| P3 | `E.Arcade.enter(score, mode, done, input)` reads the given input; `continue()` takes a press from any player's input | In co-op each player enters their own initials and anyone may continue. |\n| P4 | `get bus()` on the audio object returns the effects bus | Babble voices must pass through the effects bus to obey volume and mute. |\nEOF\ngrep -n \"E.HOOKS\" engine/my-3d2dge.js | head -3"},"caller":{"type":"direct"}}],"container":null,"sto