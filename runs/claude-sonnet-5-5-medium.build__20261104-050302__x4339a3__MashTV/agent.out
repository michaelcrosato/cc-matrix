 if (e.alive && !e.hidden) { this.hurtEnemy(e, 25, { slot: c.slot }, { quiet: true, ang: MT.angTo(c, e) }); if (e.alive) e.stun = Math.max(e.stun || 0, 1); }\\n  if (this.boss) this.boss.hitAll(this, 30, c.slot); this.fShots.clear(); this.lobs.length = 0; this.addRating(8); }\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"if (this.mode !== 'client') { for (const e\" src/11-step.js | head -2; grep -n \"this.event('bomb'\" src/11-step.js"}},"wire_ingest_context":{"toolu_01WXuo4G6S9ZPajzWNv2Es1p":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build__20261104-050302__x4339a3/work/MashTV-SmashTV-claude-sonnet-5-5-medium-20261104-050302"}}}
