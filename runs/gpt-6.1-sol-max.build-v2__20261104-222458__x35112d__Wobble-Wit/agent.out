{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('engine/crates/pav_audio/src/music.rs');s=p.read_text().replace('let mut voice=|m:i32','let voice=|out:&mut Vec<Patch>,m:i32').replace('voice(', 'voice(&mut out,');p.write_text(s)\np=Path('engine/crates/pav_core/src/games/fit/mod.rs');s=p.read_text().replace('        if self.demo&&any {','        if matches\"'!(raw.ui,Some(UiEvent::Click(500))) {self.demo=false;self.return_to=Screen::Title;self.change(Screen::Settings);}'\"\\\\n        if self.demo&&any {').replace('        if matches\"'!(raw.ui,Some(UiEvent::Click(500))) {self.return_to=self.screen;self.change(Screen::Settings);}'\"\\\\n','');p.write_text(s)\nPY\ncat > tools/make-page.py <<'PY'\nfrom pathlib import Path\nimport json\nroot=Path(__file__).resolve().parents[1]\nclient=(root/'hub/session.js').read_text()\nabout=json.loads((root.parent/'exit-interview.json').read_text())\nhead='''<\"'!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n<script>'\"'''+client+'''</script>\n<meta name=\\\"hub:session\\\" content=\\\"1\\\">\n<meta name=\\\"hub:session-players\\\" content=\\\"1-4\\\">\n<meta name=\\\"hub:session-mode\\\" content=\\\"ghost\\\">\n<meta name=\\\"hub:session-minutes\\\" content=\\\"3\\\">\n<meta name=\\\"hub:session-goal\\\" content=\\\"Highest total across three balance events wins\\\">\n<meta name=\\\"hub:session-howto\\\" content=\\\"Lean: stick, WASD or mouse. Act: Cross, Space or click. Steps: Q/E or shoulders.\\\">\n<meta name=\\\"hub:webgpu\\\" content=\\\"required\\\">\n<script id=\\\"about-data\\\" type=\\\"application/json\\\">'''+json.dumps(about,ensure_ascii=False).replace('</','<\\\\\\\\/')+'''</script>\n<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1,viewport-fit=cover\\\">\n<title>Wobble Wit — A little less wobble</title>\n<meta name=\\\"description\\\" content=\\\"A five-day wellness holiday staffed by talking gym equipment. Lean, breathe, splash, and learn to do a little less.\\\">\n<meta name=\\\"theme-color\\\" content=\\\"#8fdde0\\\">\n<link rel=\\\"manifest\\\" href=\\\"manifest.webmanifest\\\">\n<link rel=\\\"icon\\\" href=\\\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='20' fill='%238fdde0'/%3E%3Ccircle cx='32' cy='32' r='22' fill='%23fbfaf6'/%3E%3Ccircle cx='32' cy='32' r='12' fill='none' stroke='%2378dcaa' stroke-width='4'/%3E%3Ccircle cx='36' cy='28' r='6' fill='%23ff786e'/%3E%3C/svg%3E\\\">\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;overscroll-behavior:none;touch-action:none;background:#d6eef6;color:#263e54;font-family:ui-rounded,'Trebuchet MS',system-ui,sans-serif;user-select:none;-webkit-user-select:none}canvas{display:block;width:100vw\"'!important;height:100vh!important;height:100dvh!important;outline:none;touch-action:none}button{font:inherit;cursor:pointer;border:0;border-radius:18px;padding:15px 25px;background:#329fa9;color:#fff;font-weight:700;min-height:48px}button:focus-visible,input:focus-visible{outline:4px solid #ff786e;outline-offset:4px}#msg{position:fixed;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:24px;font-size:clamp(20px,3vw,34px);gap:14px;background:radial-gradient(ellipse at 50% 110%,#8fdde0 0 38%,transparent 39%),#f8f6ed;z-index:2;pointer-events:none}#msg small{max-width:700px;line-height:1.6;font-size:.65em;color:#668085}#touch-card{display:none;position:fixed;inset:0;align-items:center;justify-content:center;padding:20px;background:#263e542b;z-index:4}#touch-card .card,#touch-settings{width:min(560px,100%);padding:32px;border-radius:32px;background:#fbfaf6;box-shadow:0 16px 80px #263e5426;text-align:center}#touch-card h1{font-size:clamp(27px,6vw,40px);line-height:1.15;margin:15px 0}#touch-card p{font-size:18px;line-height:1.5;color: