elf.rig.params.distance=11.;}\n        self.rig.update(focus, dt);'\"''',1);p.write_text(s)\np=Path('engine/crates/pav_tools/src/session.rs');s=p.read_text().replace('        let focus = frame.focus;','''        if let Some(yaw)=frame.hud.camera_yaw{self.camera.params.yaw=yaw;}\n        if frame.hud.fit.as_ref().is_some_and(|f|f.event==6&&matches\"'!(f.screen.as_str(),\"Event\"|\"Countdown\"|\"Card\"|\"Result\")){self.camera.params.tilt=22.;self.camera.params.distance=11.;}\n        let focus = frame.focus;'\"''');p.write_text(s)\nPY\ncat >> notes/feedback.md <<'EOF'\n- Native capture review: Step Party lanes obscured the player; moved them to a separate screen lane.\n- Native capture review: Morning Lap used the small exercise deck's surrounding water; moved the route onto the actual hub island with its chase camera.\n- Native capture review: smoothies obscured the carrier's head; scaled/separated the glasses and put the tray ahead of the walker.\nEOF\ncd engine\ncargo fmt --all\nCARGO_BUILD_JOBS=4 cargo build --locked -p pav_tools --bin pav > ../build-native.log 2>&1\"","aggregated_output":"","exit_code":0,"status":"completed"}}
