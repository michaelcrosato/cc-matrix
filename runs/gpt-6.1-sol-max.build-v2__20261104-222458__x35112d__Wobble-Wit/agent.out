{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"cat > engine/crates/pav_ui/src/fit_ui.rs <<'EOF'\n//\"'! Painter-only, ten-foot UI. The sim owns every menu and focus value.\nuse egui::{Align2,Color32 as C,FontId,FontFamily,Pos2,Vec2,Rect,Stroke,StrokeKind,CornerRadius};\nuse pav_core::games::fit::ui_model::UiFrame;\nuse pav_core::input::UiEvent;\nconst INK:C=C::from_rgb(38,62,84);const TEAL:C=C::from_rgb(45,158,168);const MINT:C=C::from_rgb(120,220,170);const CORAL:C=C::from_rgb(255,120,110);const CREAM:C=C::from_rgb(250,248,239);const MUTED:C=C::from_rgb(102,128,133);\n#[derive(Clone,Debug,Default)]pub struct Response {pub event:Option<UiEvent>,pub items:Vec<(u16,[f32;4])>}\npub fn install_fonts(ctx:&egui::Context){let mut f=egui::FontDefinitions::default();f.font_data.insert(\"Fredoka\".into(),std::sync::Arc::new(egui::FontData::from_static(include_bytes!(\"../fonts/Fredoka_600SemiBold.ttf\"))));f.font_data.insert(\"Nunito\".into(),std::sync::Arc::new(egui::FontData::from_static(include_bytes!(\"../fonts/Nunito_700Bold.ttf\"))));f.families.insert(FontFamily::Name(\"title\".into()),vec![\"Fredoka\".into()]);f.families.insert(FontFamily::Name(\"body\".into()),vec![\"Nunito\".into()]);ctx.set_fonts(f);}\nstruct Canvas{p:egui::Painter,s:f32,o:Vec2}\nimpl Canvas {\n fn at(&self,x:f32,y:f32)->Pos2{Pos2::new(self.o.x+x*self.s,self.o.y+y*self.s)}\n fn rect(&self,x:f32,y:f32,w:f32,h:f32)->Rect{Rect::from_min_size(self.at(x,y),Vec2::new(w,h)*self.s)}\n fn panel(&self,x:f32,y:f32,w:f32,h:f32,r:f32,c:C){self.p.rect_filled(self.rect(x,y,w,h),CornerRadius::same((r*self.s).max(1.)as u8),c);}\n fn border(&self,x:f32,y:f32,w:f32,h:f32,r:f32,c:C,weight:f32){self.p.rect_stroke(self.rect(x,y,w,h),CornerRadius::same((r*self.s).max(1.)as u8),Stroke::new(weight*self.s,c),StrokeKind::Inside);}\n fn text(&self,x:f32,y:f32,t:&str,size:f32,c:C,title:bool){self.p.text(self.at(x,y),Align2::LEFT_TOP,t,FontId::new(size*self.s,FontFamily::Name(if title{\"title\"}else{\"body\"}.into())),c);}\n fn center(&self,x:f32,y:f32,t:&str,size:f32,c:C,title:bool){self.p.text(self.at(x,y),Align2::CENTER_CENTER,t,FontId::new(size*self.s,FontFamily::Name(if title{\"title\"}else{\"body\"}.into())),c);}\n fn wrap(&self,x:f32,y:f32,t:&str,size:f32,w:f32,c:C,title:bool)->f32{let galley=self.p.layout(t.into(),FontId::new(size*self.s,FontFamily::Name(if title{\"title\"}else{\"body\"}.into())),c,w*self.s);let h=galley.size().y/self.s;self.p.galley(self.at(x,y),galley,c);h}\n fn line(&self,a:(f32,f32),b:(f32,f32),c:C,w:f32){self.p.line_segment([self.at(a.0,a.1),self.at(b.0,b.1)],Stroke::new(w*self.s,c));}\n fn dot(&self,x:f32,y:f32,r:f32,c:C){self.p.circle_filled(self.at(x,y),r*self.s,c);}\n}\nfn star(c:&Canvas,x:f32,y:f32,r:f32,on:bool){let mut points=vec![];for n in 0..10 {let a=n as f32*std::f32::consts::PI/5.-std::f32::consts::FRAC_PI_2;let rad=if n%2==0{r}else{r*.47};points.push(c.at(x+a.cos()*rad,y+a.sin()*rad));}c.p.add(egui::Shape::convex_polygon(points,if on{C::from_rgb(245,193,85)}else{C::from_rgb(221,226,215)},Stroke::NONE));}\nfn lotus(c:&Canvas,x:f32,y:f32,k:f32){for n in [-2,-1,0,1,2]{let a=n as f32*.48;let center=c.at(x+a.sin()*15.*k,y-a.cos()*10.*k);c.p.add(egui::Shape::ellipse_filled(center,Vec2::new(8.,19.)*k*c.s,if n%2==0{MINT}else{TEAL}));}c.line((x-33.*k,y+12.*k),(x+33.*k,y+12.*k),TEAL,2.);}\nfn puck(c:&Canvas,u:&UiFrame){\n let x=1570.;let y=765.;let r=155.;\n c.dot(x+3.,y+9.,r+12.,C::from_black_alpha(16));c.dot(x,y,r+12.,C::from_rgba_premultiplied(255,255,250,245));\n for n in 0..36{let a=n as f32*std::f32::consts::TAU/36.;let len=if n%3==0{10.}else{5.};c.line((x+a.cos()*(r-3.),y+a.sin()*(r-3.)),(x+a.cos()*(r-len-3.),y+a.sin()*(r-len-3.)),C::from_rgb(204,221,212),2.);}\n let target=c.at(x+u.target.x*r,y-u.target.y*r);c.p.circle_filled(target,u.radius*r*c.s,C::from_rgba_premultiplied(120,220,170,34));c.p.circle_stroke(target,u.radius*r*c.s,Stroke::new(4.*c.s,MINT));\n if u.trace.len()>1{for a in u.trace.windows(2){c.line((x+a[0].x*r,y-a[0].y*r),(x+a[1].x*r,y-a[1].y*r),C::from_rgba_premultiplied(45,158,168,65),2.);}}\n c.dot(x+u.dot.x*r+2.,y-u.dot.y*r+3.,14.,C::from_black_alpha(15));c.dot(x+u.dot.x*r,y-u.dot.y*r,13.,CORAL);c.dot(x+u.dot.x*r-3.,y-u.dot.y*r-4.,4.,C::from_rgb(255,206,186));\n c.center(x,y+r+44.,\"YOUR BALANCE\",34.,TEAL,false);\n}\nfn control_hint(c:&Canvas,u:&UiFrame){c.panel(96.,988.,1728.,58.,24.,C::from_rgba_premultiplied(251,250,246,225));c.text(126.,997.,&u.prompt,34.,INK,false);c.text(1545.,1003.,\"BREATHE EASY.\",24.,MUTED,false);}\npub fn draw(ctx:&egui::Context,u:&UiFrame)->Response {\n let screen=ctx.input(|i|i.content_rect());let s=(screen.width()/1920.).min(screen.height()/1080.);let o=screen.center().to_vec2()-Vec2::new(1920.,1080.)*s*.5;let c=Canvas{p:ctx.layer_painter(egui::LayerId::new(egui::Order::Foreground,egui::Id::new(\"fit\"))),s,o};\n let mut out=Response::default();let pointer=ctx.input(|i|i.pointer.hover_pos());let moved=ctx.input(|i|i.pointer.delta().length_sq()>0.);let clicked=ctx.input(|i|i.pointer.primary_clicked());let down=ctx.input(|i|i.pointer.primary_down());\n let title=u.screen==\"Title\";let gameplay=u.screen==\"Event\";let hub=u.screen==\"Hub\";\n let still=gameplay&&u.event==11&&u.phase==4;\n if title {\n  // A quiet paper edge leaves the resort itself in view.\n  c.panel(-10.,-10.,770.,1100.,0.,C::from_rgba_premultiplied(250,248,239,248));\n  for n in 0..8{c.panel(760.+n as f32*12.,-10.,12.,1100.,0.,C::from_rgba_premultiplied(250,248,239,((8-n)*25)as u8));}\n  lotus(&c,151.,106.,.8);c.text(204.,88.,\"TIPPY CAY\",36.,TEAL,false);c.text(120.,162.,\"A COMPLIMENTARY STAY\",25.,MUTED,false);\n  c.text(112.,218.,\"Wobble\",144.,INK,true);c.text(116.,357.,\"Wit\",150.,INK,true);c.dot(353.,461.,15.,CORAL);\n  c.wrap(121.,527.,&u.subtitle,36.,550.,MUTED,false);\n  c.panel(1465.,90.,335.,68.,34.,C::from_rgba_premultiplied(251,250,246,230));c.center(1632.,124.,\"NO RUSH. EVER.\",30.,TEAL,false);\n  c.text(121.,1017.,\"A FIVE-DAY HOLIDAY IN STANDING STILL\",23.,MUTED,false);\n }else if hub {\n  c.panel(82.,64.,430.,126.,32.,CREAM);c.text(112.,82.,&u.kicker,29.,TEAL,false);c.text(111.,125.,&format!(\"{} / {} resort minutes\",u.minutes,u.minute_goal),34.,INK,false);\n  c.panel(1558.,64.,280.,126.,32.,CREAM);c.text(1587.,82.,\"BALANCE AGE\",25.,TEAL,false);c.text(1585.,111.,&u.age.to_string(),64.,INK,true);\n  c.panel(96.,840.,1215.,120.,32.,C::from_rgba_premultiplied(251,250,246,235));c.text(126.,854.,&u.label,42.,INK,true);c.wrap(126.,910.,&u.subtitle,29.,1130.,MUTED,false);\n  c.panel(1430.,844.,382.,114.,32.,C::from_rgba_premultiplied(251,250,246,235));c.text(1460.,859.,\"Tippy Cay\",43.,TEAL,true);c.text(1460.,915.,\"YOUR TIME IS YOURS.\",24.,MUTED,false);\n }else if gameplay||u.screen==\"Countdown\" {\n  if !still {\n   c.panel(82.,64.,650.,127.,32.,C::from_rgba_premultiplied(251,250,246,235));c.text(112.,79.,&u.kicker,27.,TEAL,false);c.text(111.,119.,&u.heading,47.,INK,true);\n   c.panel(1500.,64.,338.,127.,32.,CREAM);c.text(1530.,81.,\"A SMALL SCORE\",25.,TEAL,false);c.text(1527.,115.,&format!(\"{:04}\",u.score),56.,INK,true);\n   let remain=(u.duration-u.time).max(0.);c.center(960.,95.,&format!(\"{}:{:02}\",(remain as u32)/60,(remain as u32)%60),48.,INK,true);\n   c.panel(790.,145.,340.,9.,4.,C::from_rgb(222,232,219));c.panel(790.,145.,340.*(u.time/u.duration).clamp(0.,1.),9.,4.,TEAL);\n   c.panel(96.,857.,1235.,103.,32.,C::from_rgba_premultiplied(251,250,246,235));c.wrap(127.,883.,&u.label,36.,1170.,INK,false);\n  }\n  if u.blind{c.panel(-10.,-10.,1940.,1100.,0.,C::from_rgba_premultiplied(16,32,46,249));c.center(960.,480.,\"Eyes closed.\",64.,CREAM,true);c.center(960.,585.,\"Listen for your centre.\",36.,MINT,false);}\n  else if u.show_puck {puck(&c,u);}\n  if !still&&!u.blind {\n   match u.event {\n    0|2=>{let x=158.;let y=385.;c.panel(x,y,70.,340.,35.,C::from_rgba_premultiplied(255,255,250,230));c.panel(x+10.,y+10.+(1.-u.lungs)*320.,50.,u.lungs*320.,25.,MINT);c.line((x-14.,y+10.+(1.-u.guide)*320.),(x+84.,y+10.+(1.-u.guide)*320.),CORAL,7.);c.text(110.,744.,if u.event==0{\"BREATH\"}else{\"DEPTH\"},27.,TEAL,false);},\n    4=>{let base=780.;for lane in 0..2{let x=735.+lane as f32*230.;c.panel(x-77.,290.,154.,530.,65.,C::from_rgba_premultiplied(251,250,246,190));c.dot(x,base,58.,C::from_rgb(227,238,223));c.p.circle_stroke(c.at(x,base),58.*s,Stroke::new(5.*s,TEAL));c.center(x,base,if lane==0{\"L\"}else{\"R\"},44.,TEAL,true);for(t,l,judged)in &u.notes{let d=t-u.time;if !judged&&*l==lane&&(-.15..2.2).contains(&d){let y=base-d*210.;c.panel(x-53.,y-23.,106.,46.,20.,if lane==0{CORAL}else{TEAL});}}}},\n    _=>{}\n   }\n  }\n  if still{c.center(960.,925.,if u.time>127.{\"Press to skip\"}else{\"\"},36.,C::from_rgba_premultiplied(38,62,84,135),false);}\n  if u.screen==\"Countdown\"{c.dot(960.,470.,135.,CREAM);c.center(960.,470.,&u.countdown.to_string(),148.,TEAL,true);}\n }else if u.screen==\"Intro\" {\n  c.panel(130.,742.,1660.,224.,36.,CREAM);c.text(170.,763.,&u.coach,28.,TEAL,false);let text:u32=u.dialogue.chars().count()as u32;let line:String=u.dialogue.chars().take(u.revealed).collect();c.wrap(170.,810.,&line,42.,1510.,INK,false);c.text(170.,917.,if u.revealed>=text as usize{\"SPACE / ×  Continue\"}else{\"SPACE / ×  Complete line\"},27.,MUTED,false);\n }else {\n  let wide=matches!(u.screen.as_str(),\"Calendar\"|\"About\"|\"How\"|\"Ending\"|\"Credits\"|\"Podium\");\n  c.panel(-10.,-10.,if wide{1940.}else{1135.},1100.,0.,C::from_rgba_premultiplied(250,248,239,if wide{240}else{247}));\n  c.text(104.,75.,&u.kicker,29.,TEAL,false);\n  let heading_size=if u.heading.len()>32{64.}else{76.};c.wrap(101.,131.,&u.heading,heading_size,if wide{1690.}else{960.},INK,true);\n  if !u.subtitle.is_empty(){c.wrap(107.,240.,&u.subtitle,34.,if wide{1620.}else{940.},MUTED,false);}\n  if matches!(u.screen.as_str(),\"Result\"|\"Report\"){\n   if u.screen==\"Report\"{c.text(111.,334.,&u.age.to_string(),206.,INK,true);c.text(121.,565.,\"BALANCE AGE\",32.,TEAL,false);for(n,age)in u.ages.iter().take(5).enumerate(){let x=132.+n as f32*150.;c.dot(x,685.,32.,if n==u.ages.len()-1{TEAL}else{C::from_rgb(192,220,205)});c.center(x,685.,&age.to_string(),30.,CREAM,true);if n>0{c.line((x-113.,685.),(x-38.,685.),C::from_rgb(192,220,205),4.);}}}\n   else{c.text(111.,339.,&format!(\"{:04}\",u.score),170.,INK,true);for n in 0..3{star(&c,167.+n as f32*112.,570.,40.,n<u.stars as i32);}c.text(120.,647.,&format!(\"+{} MINUTES IN THE CLAM\",u.banked),34.,TEAL,false);for(n,line)in u.lines.iter().enumerate(){c.wrap(120.,710.+n as f32*48.,line,29.,850.,MUTED,false);}}\n  }\n  if u.screen==\"Calendar\"{for n in 0..5{let x=135.+n as f32*339.;c.panel(x,405.,294.,290.,35.,C::WHITE);c.center(x+147.,464.,&format!(\"DAY {}\",n+1),34.,TEAL,false);c.center(x+147.,559.,&format!(\"{}\",n+1),100.,INK,true);if n<(u.stamps as i32){c.p.circle_stroke(c.at(x+147.,571.),96.*s,Stroke::new(8.*s,CORAL));c.center(x+147.,642.,\"PRESENT\",29.,CORAL,false);}}}\n  if matches!(u.screen.as_str(),\"About\"|\"How\"|\"Ending\"|\"Credits\"|\"Podium\") {let mut y=369.;for line in &u.lines{let h=c.wrap(110.,y,line,if u.screen==\"Podium\"{46.}else{34.},1660.,INK,false);y+=h+30.;}if u.pages>1{c.text(109.,817.,&format!(\"PAGE {} / {}\",u.page+1,u.pages),27.,TEAL,false);}}\n  if matches!(u.screen.as_str(),\"Card\"|\"Pass\"|\"Look\"|\"Wardrobe\") {c.panel(1270.,195.,500.,74.,36.,C::from_rgba_premultiplied(251,250,246,230));c.center(1520.,232.,if u.screen==\"Look\"{\"YOU LOOK VERY HERE.\"}else{\"SMALL MOVEMENTS. BIG FEELINGS.\"},24.,TEAL,false);}\n }\n // Menu cards: focus and navigation have identical geometry on every device.\n if !u.items.is_empty(){\n  let result=matches!(u.screen.as_str(),\"Result\"|\"Report\");let lower=matches!(u.screen.as_str(),\"Card\"|\"How\"|\"About\"|\"Calendar\"|\"Ending\"|\"Credits\"|\"Podium\");\n  let first=(u.focus/6)*6;let visible:Vec<_>=u.items.iter().enumerate().skip(first).take(6).collect();let n=visible.len();\n  let y0=if title {634.-if u.items.len()>4{30.}else{0.}}else if result {836.}else if lower {850.}else if u.screen==\"Pass\"{530.}else{348.};\n  let height=if title{70.}else if lower||result{81.}else{86.};let gap=if title{14.}else{13.};\n  for (visible_index,(index,it))in visible.iter().enumerate(){let focused=*index==u.focus;let x=if title{119.}else{106.};let y=y0+visible_index as f32*(height+gap);let w=if title{514.}else if lower||result{790.}else{914.};\n   // Wide informational pages use two horizontal buttons.\n   let (x,y,w)=if (lower||result)&&n<=2 {(x+visible_index as f32*850.,y0,790.)}else{(x,y,w)};\n   let r=c.rect(x,y,w,height);c.panel(x+2.,y+6.,w,height,22.,C::from_black_alpha(10));c.panel(x,y,w,height,22.,if focused{C::from_rgb(232,245,233)}else{C::from_rgba_premultiplied(255,255,253,237)});\n   if focused{c.border(x,y,w,height,22.,TEAL,4.);c.dot(x+30.,y+height*.5,6.,TEAL);}\n   let tint=if it.enabled{INK}else{MUTED};let font=if title{35.}else if it.text.len()>38{32.}else{35.};\n   if it.detail.is_empty()||title{c.text(x+if focused{54.}else{30.},y+(height-font)*.45,&it.text,font,tint,false);}else{c.text(x+if focused{54.}else{30.},y+6.,&it.text,font,tint,false);c.text(x+if focused{54.}else{30.},y+50.,&it.detail,25.,if it.enabled{MUTED}else{C::from_rgb(156,164,153)},false);}\n   if let Some((value,lo,hi))=it.value{let bx=x+w-280.;let by=y+height*.5;c.panel(bx,by-5.,228.,10.,5.,C::from_rgb(211,226,212));let f=(value-lo)/(hi-lo).max(.001);c.panel(bx,by-5.,228.*f,10.,5.,TEAL);c.dot(bx+228.*f,by,13.,CORAL);\n    let slider_rect=c.rect(bx-15.,y,265.,height);if down&&pointer.is_some_and(|p|slider_rect.contains(p)){let px=(pointer.unwrap().x-c.at(bx,0.).x)/(228.*s);out.event=Some(UiEvent::Slider(it.id,lo+(hi-lo)*px.clamp(0.,1.)));}}\n   else if it.enabled {c.center(x+w-39.,y+height*.5,\"›\",42.,if focused{TEAL}else{MUTED},true);}\n   out.items.push((it.id,[r.min.x,r.min.y,r.max.x,r.max.y]));if out.event.is_none()&&pointer.is_some_and(|p|r.contains(p)){if clicked&&it.enabled {out.event=Some(UiEvent::Click(it.id));}else if moved&&*index!=u.focus{out.event=Some(UiEvent::Hover(it.id));}}\n  }\n  if u.items.len()>6 {c.text(106.,955.,&format!(\"{} / {}     ↑ ↓  MORE POSSIBILITIES\",u.focus+1,u.items.len()),25.,TEAL,false);}\n }\n if !title&&!still&&u.screen!=\"Intro\" {control_hint(&c,u);}\n if u.demo {c.panel(800.,228.,320.,65.,30.,INK);c.center(960.,260.,\"A LITTLE DEMO\",30.,CREAM,false);c.panel(660.,988.,600.,60.,26.,CREAM);c.center(960.,1018.,\"PRESS ANY BUTTON TO CHECK IN\",29.,TEAL,false);}\n if u.debug{c.text(1260.,315.,&format!(\"LEAN  {:+.2}  {:+.2}\",u.dot.x,u.dot.y),34.,INK,false);}\n out\n}\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('engine/crates/pav_ui/src/lib.rs');s=p.read_text().replace('pub mod touch;','pub mod touch;\\\\npub mod fit_ui;');s=s.replace('    if h.lines.is_empty() {','    if let Some(f)=&h.fit { fit_ui::draw(ctx,f); return; }\\\\n    if h.lines.is_empty() {',1);p.write_text(s)\np=Path('engine/crates/pav_ui/src/headless.rs');s=p.read_text().replace('        let ctx = egui::Context::default();','        let ctx = egui::Context::default();\\\\n        crate::fit_ui::install_fonts(&ctx);',1);p.write_text(s)\nPY\ncat check-core.log | tail -110\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"cat > engine/crates/pav_ui/src/fit_ui.rs <<'EOF'\n//\"'! Painter-only, ten-foot UI. The sim owns every menu and focus value.\nuse egui::{Align2,Color32 as C,FontId,FontFamily,Pos2,Vec2,Rect,Stroke,StrokeKind,CornerRadius};\nuse pav_core::games::fit::ui_model::UiFrame;\nuse pav_core::input::UiEvent;\nconst INK:C=C::from_rgb(38,62,84);const TEAL:C=C::from_rgb(45,158,168);const MINT:C=C::from_rgb(120,220,170);const CORAL:C=C::from_rgb(255,120,110);const CREAM:C=C::from_rgb(250,248,239);const MUTED:C=C::from_rgb(102,128,133);\n#[derive(Clone,Debug,Default)]pub struct Response {pub event:Option<UiEvent>,pub items:Vec<(u16,[f32;4])>}\npub fn install_fonts(ctx:&egui::Context){let mut f=egui::FontDefinitions::default();f.font_data.insert(\"Fredoka\".into(),std::sync::Arc::new(egui::FontData::from_static(include_bytes!(\"../fonts/Fredoka_600SemiBold.ttf\"))));f.font_data.insert(\"Nunito\".into(),std::sync::Arc::new(egui::FontData::from_static(include_bytes!(\"../fonts/Nunito_700Bold.ttf\"))));f.families.insert(FontFamily::Name(\"title\".into()),vec![\"Fredoka\".into()]);f.families.insert(FontFamily::Name(\"body\".into()),vec![\"Nunito\".into()]);ctx.set_fonts(f);}\nstruct Canvas{p:egui::Painter,s:f32,o:Vec2}\nimpl Canvas {\n fn at(&self,x:f32,y:f32)->Pos2{Pos2::new(self.o.x+x*self.s,self.o.y+y*self.s)}\n fn rect(&self,x:f32,y:f32,w:f32,h:f32)->Rect{Rect::from_min_size(self.at(x,y),Vec2::new(w,h)*self.s)}\n fn panel(&self,x:f32,y:f32,w:f32,h:f32,r:f32,c:C){self.p.rect_filled(self.rect(x,y,w,h),CornerRadius::same((r*self.s).max(1.)as u8),c);}\n fn border(&self,x:f32,y:f32,w:f32,h:f32,r:f32,c:C,weight:f32){self.p.rect_stroke(self.rect(x,y,w,h),CornerRadius::same((r*self.s).max(1.)as u8),Stroke::new(weight*self.s,c),StrokeKind::Inside);}\n fn text(&self,x:f32,y:f32,t:&str,size:f32,c:C,title:bool){self.p.text(self.at(x,y),Align2::LEFT_TOP,t,FontId::new(size*self.s,FontFamily::Name(if title{\"title\"}else{\"body\"}.into())),c);}\n fn center(&self,x:f32,y:f32,t:&str,size:f32,c:C,title:bool){self.p.text(self.at(x,y),Align2::CENTER_CENTER,t,FontId::new(size*self.s,FontFamily::Name(if title{\"title\"}else{\"body\"}.into())),c);}\n fn wrap(&self,x:f32,y:f32,t:&str,size:f32,w:f32,c:C,title:bool)->f32{let galley=self.p.layout(t.into(),FontId::new(size*self.s,FontFamily::Name(if title{\"title\"}else{\"body\"}.into())),c,w*self.s);let h=galley.size().y/self.s;self.p.galley(self.at(x,y),galley,c);h}\n fn line(&self,a:(f32,f32),b:(f32,f32),c:C,w:f32){self.p.line_segment([self.at(a.0,a.1),self.at(b.0,b.1)],Stroke::new(w*self.s,c));}\n fn dot(&self,x:f32,y:f32,r:f32,c:C){self.p.circle_filled(self.at(x,y),r*self.s,c);}\n}\nfn star(c:&Canvas,x:f32,y:f32,r:f32,on:bool){let mut points=vec![];for n in 0..10 {let a=n as f32*std::f32::consts::PI/5.-std::f32::consts::FRAC_PI_2;let rad=if n%2==0{r}else{r*.47};points.push(c.at(x+a.cos()*rad,y+a.sin()*rad));}c.p.add(egui::Shape::convex_polygon(points,if on{C::from_rgb(245,193,85)}else{C::from_rgb(221,226,215)},Stroke::NONE));}\nfn lotus(c:&Canvas,x:f32,y:f32,k:f32){for n in [-2,-1,0,1,2]{let a=n as f32*.48;let center=c.at(x+a.sin()*15.*k,y-a.cos()*10.*k);c.p.add(egui::Shape::ellipse_filled(center,Vec2::new(8.,19.)*k*c.s,if n%2==0{MINT}else{TEAL}));}c.line((x-33.*k,y+12.*k),(x+33.*k,y+12.*k),TEAL,2.);}\nfn puck(c:&Canvas,u:&UiFrame){\n let x=1570.;let y=765.;let r=155.;\n c.dot(x+3.,y+9.,r+12.,C::from_black_alpha(16));c.dot(x,y,r+12.,C::from_rgba_premultiplied(255,255,250,245));\n for n in 0..36{let a=n as f32*std::f32::consts::TAU/36.;let len=if n%3==0{10.}else{5.};c.line((x+a.cos()*(r-3.),y+a.sin()*(r-3.)),(x+a.cos()*(r-len-3.),y+a.sin()*(r-len-3.)),C::from_rgb(204,221,212),2.);}\n let target=c.at(x+u.target.x*r,y-u.target.y*r);c.p.circle_filled(target,u.radius*r*c.s,C::from_rgba_premultiplied(120,220,170,34));c.p.circle_stroke(target,u.radius*r*c.s,Stroke::new(4.*c.s,MINT));\n if u.trace.len()>1{for a in u.trace.windows(2){c.line((x+a[0].x*r,y-a[0].y*r),(x+a[1].x*r,y-a[1].y*r),C::from_rgba_premultiplied(45,158,168,65),2.);}}\n c.dot(x+u.dot.x*r+2.,y-u.dot.y*r+3.,14.,C::from_black_alpha(15));c.dot(x+u.dot.x*r,y-u.dot.y*r,13.,CORAL);c.dot(x+u.dot.x*r-3.,y-u.dot.y*r-4.,4.,C::from_rgb(255,206,186));\n c.center(x,y+r+44.,\"YOUR BALANCE\",34.,TEAL,false);\n}\nfn control_hint(c:&Canvas,u:&UiFrame){c.panel(96.,988.,1728.,58.,24.,C::from_rgba_premultiplied(251,250,246,225));c.text(126.,997.,&u.prompt,34.,INK,false);c.text(1545.,1003.,\"BREATHE EASY.\",24.,MUTED,false);}\npub fn draw(ctx:&egui::Context,u:&UiFrame)->Response {\n let screen=ctx.input(|i|i.content_rect());let s=(screen.width()/1920.).min(screen.height()/1080.);let o=screen.center().to_vec2()-Vec2::new(1920.,1080.)*s*.5;let c=Canvas{p:ctx.layer_painter(egui::LayerId::new(egui::Order::Foreground,egui::Id::new(\"fit\"))),s,o};\n let mut out=Response::default();let pointer=ctx.input(|i|i.pointer.hover_pos());let moved=ctx.input(|i|i.pointer.delta().length_sq()>0.);let clicked=ctx.input(|i|i.pointer.primary_clicked());let down=ctx.input(|i|i.pointer.primary_down());\n let title=u.screen==\"Title\";let gameplay=u.screen==\"Event\";let hub=u.screen==\"Hub\";\n let still=gameplay&&u.event==11&&u.phase==4;\n if title {\n  // A quiet paper edge leaves the resort itself in view.\n  c.panel(-10.,-10.,770.,1100.,0.,C::from_rgba_premultiplied(250,248,239,248));\n  for n in 0..8{c.panel(760.+n as f32*12.,-10.,12.,1100.,0.,C::from_rgba_premultiplied(250,248,239,((8-n)*25)as u8));}\n  lotus(&c,151.,106.,.8);c.text(204.,88.,\"TIPPY CAY\",36.,TEAL,false);c.text(120.,162.,\"A COMPLIMENTARY STAY\",25.,MUTED,false);\n  c.text(112.,218.,\"Wobble\",144.,INK,true);c.text(116.,357.,\"Wit\",150.,INK,true);c.dot(353.,461.,15.,CORAL);\n  c.wrap(121.,527.,&u.subtitle,36.,550.,MUTED,false);\n  c.panel(1465.,90.,335.,68.,34.,C::from_rgba_premultiplied(251,250,246,230));c.center(1632.,124.,\"NO RUSH. EVER.\",30.,TEAL,false);\n  c.text(121.,1017.,\"A FIVE-DAY HOLIDAY IN STANDING STILL\",23.,MUTED,false);\n }else if hub {\n  c.panel(82.,64.,430.,126.,32.,CREAM);c.text(112.,82.,&u.kicker,29.,TEAL,false);c.text(111.,125.,&format!(\"{} / {} resort minutes\",u.minutes,u.minute_goal),34.,INK,false);\n  c.panel(1558.,64.,280.,126.,32.,CREAM);c.text(1587.,82.,\"BALANCE AGE\",25.,TEAL,false);c.text(1585.,111.,&u.age.to_string(),64.,INK,true);\n  c.panel(96.,840.,1215.,120.,32.,C::from_rgba_premultiplied(251,250,246,235));c.text(126.,854.,&u.label,42.,INK,true);c.wrap(126.,910.,&u.subtitle,29.,1130.,MUTED,false);\n  c.panel(1430.,844.,382.,114.,32.,C::from_rgba_premultiplied(251,250,246,235));c.text(1460.,859.,\"Tippy Cay\",43.,TEAL,true);c.text(1460.,915.,\"YOUR TIME IS YOURS.\",24.,MUTED,false);\n }else if gameplay||u.screen==\"Countdown\" {\n  if !still {\n   c.panel(82.,64.,650.,127.,32.,C::from_rgba_premultiplied(251,250,246,235));c.text(112.,79.,&u.kicker,27.,TEAL,false);c.text(111.,119.,&u.heading,47.,INK,true);\n   c.panel(1500.,64.,338.,127.,32.,CREAM);c.text(1530.,81.,\"A SMALL SCORE\",25.,TEAL,false);c.text(1527.,115.,&format!(\"{:04}\",u.score),56.,INK,true);\n   let remain=(u.duration-u.time).max(0.);c.center(960.,95.,&format!(\"{}:{:02}\",(remain as u32)/60,(remain as u32)%60),48.,INK,true);\n   c.panel(790.,145.,340.,9.,4.,C::from_rgb(222,232,219));c.panel(790.,145.,340.*(u.time/u.duration).clamp(0.,1.),9.,4.,TEAL);\n   c.panel(96.,857.,1235.,103.,32.,C::from_rgba_premultiplied(251,250,246,235));c.wrap(127.,883.,&u.label,36.,1170.,INK,false);\n  }\n  if u.blind{c.panel(-10.,-10.,1940.,1100.,0.,C::from_rgba_premultiplied(16,32,46,249));c.center(960.,480.,\"Eyes closed.\",64.,CREAM,true);c.center(960.,585.,\"Listen for your centre.\",36.,MINT,false);}\n  else if u.show_puck {puck(&c,u);}\n  if !still&&!u.blind {\n   match u.event {\n    0|2=>{let x=158.;let y=385.;c.panel(x,y,70.,340.,35.,C::from_rgba_premultiplied(255,255,250,230));c.panel(x+10.,y+10.+(1.-u.lungs)*320.,50.,u.lungs*320.,25.,MINT);c.line((x-14.,y+10.+(1.-u.guide)*320.),(x+84.,y+10.+(1.-u.guide)*320.),CORAL,7.);c.text(110.,744.,if u.event==0{\"BREATH\"}else{\"DEPTH\"},27.,TEAL,false);},\n    4=>{let base=780.;for lane in 0..2{let x=735.+lane as f32*230.;c.panel(x-77.,290.,154.,530.,65.,C::from_rgba_premultiplied(251,250,246,190));c.dot(x,base,58.,C::from_rgb(227,238,223));c.p.circle_stroke(c.at(x,base),58.*s,Stroke::new(5.*s,TEAL));c.center(x,base,if lane==0{\"L\"}else{\"R\"},44.,TEAL,true);for(t,l,judged)in &u.notes{let d=t-u.time;if !judged&&*l==lane&&(-.15..2.2).contains(&d){let y=base-d*210.;c.panel(x-53.,y-23.,106.,46.,20.,if lane==0{CORAL}else{TEAL});}}}},\n    _=>{}\n   }\n  }\n  if still{c.center(960.,925.,if u.time>127.{\"Press to skip\"}else{\"\"},36.,C::from_rgba_premultiplied(38,62,84,135),false);}\n  if u.screen==\"Countdown\"{c.dot(960.,470.,135.,CREAM);c.center(960.,470.,&u.countdown.to_string(),148.,TEAL,true);}\n }else if u.screen==\"Intro\" {\n  c.panel(130.,742.,1660.,224.,36.,CREAM);c.text(170.,763.,&u.coach,28.,TEAL,false);let text:u32=u.dialogue.chars().count()as u32;let line:String=u.dialogue.chars().take(u.revealed).collect();c.wrap(170.,810.,&line,42.,1510.,INK,false);c.text(170.,917.,if u.revealed>=text as usize{\"SPACE / ×  Continue\"}else{\"SPACE / ×  Complete line\"},27.,MUTED,false);\n }else {\n  let wide=matches!(u.screen.as_str(),\"Calendar\"|\"About\"|\"How\"|\"Ending\"|\"Credits\"|\"Podium\");\n  c.panel(-10.,-10.,if wide{1940.}else{1135.},1100.,0.,C::from_rgba_premultiplied(250,248,239,if wide{240}else{247}));\n  c.text(104.,75.,&u.kicker,29.,TEAL,false);\n  let heading_size=if u.heading.len()>32{64.}else{76.};c.wrap(101.,131.,&u.heading,heading_size,if wide{1690.}else{960.},INK,true);\n  if !u.subtitle.is_empty(){c.wrap(107.,240.,&u.subtitle,34.,if wide{1620.}else{940.},MUTED,false);}\n  if matches!(u.screen.as_str(),\"Result\"|\"Report\"){\n   if u.screen==\"Report\"{c.text(111.,334.,&u.age.to_string(),206.,INK,true);c.text(121.,565.,\"BALANCE AGE\",32.,TEAL,false);for(n,age)in u.ages.iter().take(5).enumerate(){let x=132.+n as f32*150.;c.dot(x,685.,32.,if n==u.ages.len()-1{TEAL}else{C::from_rgb(192,220,205)});c.center(x,685.,&age.to_string(),30.,CREAM,true);if n>0{c.line((x-113.,685.),(x-38.,685.),C::from_rgb(192,220,205),4.);}}}\n   else{c.text(111.,339.,&format!(\"{:04}\",u.score),170.,INK,true);for n in 0..3{star(&c,167.+n as f32*112.,570.,40.,n<u.stars as i32);}c.text(120.,647.,&format!(\"+{} MINUTES IN THE CLAM\",u.banked),34.,TEAL,false);for(n,line)in u.lines.iter().enumerate(){c.wrap(120.,710.+n as f32*48.,line,29.,850.,MUTED,false);}}\n  }\n  if u.screen==\"Calendar\"{for n in 0..5{let x=135.+n as f32*339.;c.panel(x,405.,294.,290.,35.,C::WHITE);c.center(x+147.,464.,&format!(\"DAY {}\",n+1),34.,TEAL,false);c.center(x+147.,559.,&format!(\"{}\",n+1),100.,INK,true);if n<(u.stamps as i32){c.p.circle_stroke(c.at(x+147.,571.),96.*s,Stroke::new(8.*s,CORAL));c.center(x+147.,642.,\"PRESENT\",29.,CORAL,false);}}}\n  if matches!(u.screen.as_str(),\"About\"|\"How\"|\"Ending\"|\"Credits\"|\"Podium\") {let mut y=369.;for line in &u.lines{let h=c.wrap(110.,y,line,if u.screen==\"Podium\"{46.}else{34.},1660.,INK,false);y+=h+30.;}if u.pages>1{c.text(109.,817.,&format!(\"PAGE {} / {}\",u.page+1,u.pages),27.,TEAL,false);}}\n  if matches!(u.screen.as_str(),\"Card\"|\"Pass\"|\"Look\"|\"Wardrobe\") {c.panel(1270.,195.,500.,74.,36.,C::from_rgba_premultiplied(251,250,246,230));c.center(1520.,232.,if u.screen==\"Look\"{\"YOU LOOK VERY HERE.\"}else{\"SMALL MOVEMENTS. BIG FEELINGS.\"},24.,TEAL,false);}\n }\n // Menu cards: focus and navigation have identical geometry on every device.\n if !u.items.is_empty(){\n  let result=matches!(u.screen.as_str(),\"Result\"|\"Report\");let lower=matches!(u.screen.as_str(),\"Card\"|\"How\"|\"About\"|\"Calendar\"|\"Ending\"|\"Credits\"|\"Podium\");\n  let first=(u.focus/6)*6;let visible:Vec<_>=u.items.iter().enumerate().skip(first).take(6).collect();let n=visible.len();\n  let y0=if title {634.-if u.items.len()>4{30.}else{0.}}else if result {836.}else if lower {850.}else if u.screen==\"Pass\"{530.}else{348.};\n  let height=if title{70.}else if lower||result{81.}else{86.};let gap=if title{14.}else{13.};\n  for (visible_index,(index,it))in visible.iter().enumerate(){let focused=*index==u.focus;let x=if title{119.}else{106.};let y=y0+visible_index as f32*(height+gap);let w=if title{514.}else if lower||result{790.}else{914.};\n   // Wide informational pages use two horizontal buttons.\n   let (x,y,w)=if (lower||result)&&n<=2 {(x+visible_index as f32*850.,y0,790.)}else{(x,y,w)};\n   let r=c.rect(x,y,w,height);c.panel(x+2.,y+6.,w,height,22.,C::from_black_alpha(10));c.panel(x,y,w,height,22.,if focused{C::from_rgb(232,245,233)}else{C::from_rgba_premultiplied(255,255,253,237)});\n   if focused{c.border(x,y,w,height,22.,TEAL,4.);c.dot(x+30.,y+height*.5,6.,TEAL);}\n   let tint=if it.enabled{INK}else{MUTED};let font=if title{35.}else if it.text.len()>38{32.}else{35.};\n   if it.detail.is_empty()||title{c.text(x+if focused{54.}else{30.},y+(height-font)*.45,&it.text,font,tint,false);}else{c.text(x+if focused{54.}else{30.},y+6.,&it.text,font,tint,false);c.text(x+if focused{54.}else{30.},y+50.,&it.detail,25.,if it.enabled{MUTED}else{C::from_rgb(156,164,153)},false);}\n   if let Some((value,lo,hi))=it.value{let bx=x+w-280.;let by=y+height*.5;c.panel(bx,by-5.,228.,10.,5.,C::from_rgb(211,226,212));let f=(value-lo)/(hi-lo).max(.001);c.panel(bx,by-5.,228.*f,10.,5.,TEAL);c.dot(bx+228.*f,by,13.,CORAL);\n    let slider_rect=c.rect(bx-15.,y,265.,height);if down&&pointer.is_some_and(|p|slider_rect.contains(p)){let px=(pointer.unwrap().x-c.at(bx,0.).x)/(228.*s);out.event=Some(UiEvent::Slider(it.id,lo+(hi-lo)*px.clamp(0.,1.)));}}\n   else if it.enabled {c.center(x+w-39.,y+height*.5,\"›\",42.,if focused{TEAL}else{MUTED},true);}\n   out.items.push((it.id,[r.min.x,r.min.y,r.max.x,r.max.y]));if out.event.is_none()&&pointer.is_some_and(|p|r.contains(p)){if clicked&&it.enabled {out.event=Some(UiEvent::Click(it.id));}else if moved&&*index!=u.focus{out.event=Some(UiEvent::Hover(it.id));}}\n  }\n  if u.items.len()>6 {c.text(106.,955.,&format!(\"{} / {}     ↑ ↓  MORE POSSIBILITIES\",u.focus+1,u.items.len()),25.,TEAL,false);}\n }\n if !title&&!still&&u.screen!=\"Intro\" {control_hint(&c,u);}\n if u.demo {c.panel(800.,228.,320.,65.,30.,INK);c.center(960.,260.,\"A LITTLE DEMO\",30.,CREAM,false);c.panel(660.,988.,600.,60.,26.,CREAM);c.center(960.,1018.,\"PRESS ANY BUTTON TO CHECK IN\",29.,TEAL,false);}\n if u.debug{c.text(1260.,315.,&format!(\"LEAN  {:+.2}  {:+.2}\",u.dot.x,u.dot.y),34.,INK,false);}\n out\n}\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('engine/crates/pav_ui/src/lib.rs');s=p.read_text().replace('pub mod touch;','pub mod touch;\\\\npub mod fit_ui;');s=s.replace('    if h.lines.is_empty() {','    if let Some(f)=&h.fit { fit_ui::draw(ctx,f); return; }\\\\n    if h.lines.is_empty() {',1);p.write_text(s)\np=Path('engine/crates/pav_ui/src/headless.rs');s=p.read_text().replace('        let ctx = egui::Context::default();','        let ctx = egui::Context::default();\\\\n        crate::fit_ui::install_fonts(&ctx);',1);p.write_text(s)\nPY\ncat check-core.log | tail -110\"","aggregated_output":"54 |     for npc in sim.state.entities.iter_mut(){if npc.name==\"Posey\"{if let Some(ch)=npc.character.as_mut(){ch.anim.play_clip(crate::clips::find_cached(if k==Kind::Pose{[\"FIT/Tree\",\"FIT/Warrior\",\"FIT/Lighthouse\"][(t/20.)as usize%3]}else{\"FIT/Breath\"}),0,0.000001);ch.anim.clip_t=if k==Kind::Breath{e.lungs}else{t%2.};ch.anim.clip_w=1.;}}if npc.name==\"Bounce\"{if let Some(ch)=npc.character.as_mut(){ch.anim.lift=(t*std::f32::consts::TAU*1.6).sin().max(0.)*0.35;}}}\n   |                                                                                                                                                                                                                                                                                                         