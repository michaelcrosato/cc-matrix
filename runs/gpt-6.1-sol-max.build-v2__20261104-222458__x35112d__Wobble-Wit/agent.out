{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -lc \"cat > tests/browser.py <<'PY'\nfrom pathlib import Path\nimport json,traceback\nfrom playwright.sync_api import sync_playwright\nROOT=Path(__file__).resolve().parents[2];PAGE=ROOT/'Wobble-Wit-Wii-Fit-gpt-6.1-sol-max-20261104-222458.html';passed=0;failed=0\nPAD=\\\"\\\"\\\"(()=>{const b=()=>({pressed:false,touched:false,value:0});const p={id:'DualSense Wireless Controller (STANDARD GAMEPAD)',index:0,connected:true,mapping:'standard',timestamp:1,axes:[0,0,0,0],buttons:Array.from({length:17},b)};navigator.getGamepads=()=>[p,null,null,null];window.__setPad=(axes,on)=>{p.axes=axes;p.timestamp++;p.buttons.forEach((b,i)=>{b.pressed=on.includes(i);b.touched=b.pressed;b.value=b.pressed?1:0;});};window.__audioProbe={count:0,peak:0};if(window.AudioBufferSourceNode){const old=AudioBufferSourceNode.prototype.start;AudioBufferSourceNode.prototype.start=function(...args){if(this.buffer){const a=this.buffer.getChannelData(0);let peak=0;for(let i=0;i<a.length;i++)peak=Math.max(peak,Math.abs(a[i]));__audioProbe.peak=Math.max(__audioProbe.peak,peak);__audioProbe.count++;}return old.apply(this,args);};}})();\\\"\\\"\\\"\ndef check(ok,label):\n global passed,failed\n if ok:passed+=1\n else:failed+=1;print('FAIL '+label)\ndef status(p):return p.evaluate('JSON.parse(window.__gameStatus)')\ndef wait_screen(p,name):p.wait_for_function('(name)=>JSON.parse(window.__gameStatus||\\\"null\\\")?.screen===name',arg=name,timeout=45000)\ndef click_item(p,id):\n rect=p.evaluate('(id)=>JSON.parse(window.__gameUi).find(x=>x[0]===id)?.[1]',id);assert rect,f'UI item {id} missing';p.mouse.click((rect[0]+rect[2])/2,(rect[1]+rect[3])/2)\nwith sync_playwright()as pw:\n browser=pw.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-vulkan=swiftshader','--use-angle=swiftshader','--autoplay-policy=no-user-gesture-required'])\n try:\n  p=browser.new_page(viewport={'width':320,'height':180},device_scale_factor=1);errors=[];p.on('pageerror',lambda e:errors.append(str(e)));p.add_init_script(PAD);p.goto(PAGE.as_uri());p.wait_for_function('window.__gameStatus',timeout=120000);wait_screen(p,'Title');check(status(p)['title']=='Wobble Wit','boots correct title');tick=status(p)['tick'];p.wait_for_timeout(400);check(status(p)['tick']>tick,'render loop advances');check(not errors,'no boot page errors')\n  p.keyboard.press('ArrowDown');p.wait_for_function('JSON.parse(__gameStatus).focus===1',timeout=15000);check(True,'keyboard moves focus');p.keyboard.press('ArrowUp');p.wait_for_timeout(150)\n  p.evaluate('__setPad([0,0,0,0],[13])');p.wait_for_timeout(200);p.evaluate('__setPad([0,0,0,0],[])');p.wait_for_function('JSON.parse(__gameStatus).device===1',timeout=15000);check(status(p)['focus']==1,'pad dpad moves focus')\n  p.evaluate('__setPad([0,0,0,0],[0])');p.wait_for_timeout(200);p.evaluate('__setPad([0,0,0,0],[])');wait_screen(p,'Pass');check(True,'pad confirms Play Together');p.keyboard.press('Escape');wait_screen(p,'Title')\n  click_item(p,2);wait_screen(p,'Settings');check(status(p)['settings']['music']==.1,'music starts at ten percent');p.keyboard.press('ArrowDown');p.keyboard.press('ArrowDown');p.keyboard.press('ArrowDown');p.keyboard.press('Enter');p.wait_for_function('JSON.parse(__gameStatus).settings.xbox===true',timeout=15000);check(True,'Xbox glyph option changes');p.keyboard.press('Escape');wait_screen(p,'Title')\n  # Mouse hover and click are the same sim-owned choices as keyboard and pad.\n  rect=p.evaluate('JSON.parse(__gameUi).find(x=>x[0]===0)[1]');p.mouse.move((rect[0]+rect[2])/2,(rect[1]+rect[3])/2);p.wait_for_function('JSON.parse(__gameStatus).focus===0',timeout=15000);check(True,'mouse hover focuses');click_item(p,0);wait_screen(p,'Guest');check(status(p)['device']==2,'mouse click activates and changes prompts');p.keyboard.press('Enter');wait_screen(p,'Name');p.keyboard.press('Enter');wait_screen(p,'Look');click_item(p,2);wait_screen(p,'Intro');check(True,'new guest reaches reception dialogue')\n  for _ in range(7):p.keyboard.press('Space');p.wait_for_timeout(120)\n  wait_screen(p,'Card');check(status(p)['event']=='wobble-check','new stay opens morning check');p.keyboard.press('Enter');wait_screen(p,'Countdown');check(True,'activity countdown starts');p.keyboard.press('Escape');wait_screen(p,'Pause');t=status(p)['eventTime'];p.wait_for_timeout(300);check(status(p)['eventTime']==t,'pause freezes activity');p.keyboard.press('F1');p.wait_for_timeout(100);check(status(p)['screen']=='Pause','engine F1 is disabled');check(p.evaluate('__audioProbe.count>0&&__audioProbe.peak>0'),'synth produces audible buffers');p.close()\n  # Attract timing is tested in simulation ticks, with real browser input used to exit.\n  p=browser.new_page(viewport={'width':320,'height':180},device_scale_factor=1);p.goto(PAGE.as_uri());p.wait_for_function('window.__gameStatus',timeout=120000);p.wait_for_function('JSON.parse(__gameStatus).demo',timeout=45000);check(True,'attract starts after menu idling');p.keyboard.press('Enter');wait_screen(p,'Title');check(not status(p)['demo'],'any key exits attract');p.close()\n  for device in ['Pixel 10','Galaxy Tab S9']:\n   opts={k:v for k,v in pw.devices[device].items()if k\"'!='\"'default_browser_type'};opts['device_scale_factor']=1;opts['viewport']={'width':400,'height':600};ctx=browser.new_context(**opts);p=ctx.new_page();p.goto(PAGE.as_uri());p.wait_for_function('window.__gameStatus',timeout=120000);p.locator('#touch-card').wait_for(state='visible',timeout=30000);check('Controller or keyboard required' in p.locator('#touch-card').inner_text(),device+' touch requirement');check(status(p)['demo'],device+' attract running');p.locator('#touch-open').tap();p.locator('#touch-settings').wait_for(state='visible');wait_screen(p,'Settings');check(True,device+' Settings tap');p.locator('#touch-music').evaluate('(e)=>{e.value=\\\"25\\\";e.dispatchEvent(new Event(\\\"input\\\",{bubbles:true}));}');p.wait_for_function('Math.abs(JSON.parse(__gameStatus).settings.music-.25)<.01',timeout=20000);check(True,device+' live volume slider');check(p.evaluate('document.documentElement.scrollWidth<=innerWidth+1'),device+' no horizontal overflow');ctx.close()\n finally:browser.close()\n webkit=pw.webkit.launch(headless=True)\n try:\n  ctx=webkit.new_context(**{k:v for k,v in pw.devices['iPhone SE (3rd gen)'].items()if k\"'!='\"'default_browser_type'});p=ctx.new_page();p.goto(PAGE.as_uri());p.wait_for_timeout(700);text=p.locator('#msg').inner_text();check('Controller or keyboard required' in text and 'WebGPU' in text,'WebKit iPhone fallback states both requirements');p.locator('#fallback-settings').tap();check(p.locator('#touch-settings').is_visible(),'fallback Settings opens');check(p.evaluate('document.documentElement.scrollWidth<=innerWidth+1'),'WebKit phone no overflow');ctx.close()\n finally:webkit.close()\nprint(f'{passed} passed, {failed} failed')\nraise SystemExit(bool(failed))\nPY\ncat > tests/hub.py <<'PY'\nfrom pathlib import Path\nimport subprocess,re,shutil,json\nfrom playwright.sync_api import sync_playwright\nDEV=Path(__file__).resolve().parents[1];PAGE=DEV.parent/'Wobble-Wit-Wii-Fit-gpt-6.1-sol-max-20261104-222458.html';stage=DEV/'hub-test';stage.mkdir(exist_ok=True)\nfor f in ['harness.html','bridge.js','round.js']:shutil.copy2(DEV/'hub'/f,stage/f)\nshutil.copy2(PAGE,stage/'game.html');page_text=PAGE.read_text();client=(DEV/'hub/session.js').read_text();passed=0;failed=0\nif '<script>'+client+'</script>' in page_text:passed+=1\nelse:print('FAIL Hub client byte comparison');failed+=1\nserver=subprocess.Popen(['python3','-u','-m','http.server','0','--bind','127.0.0.1','--directory',str(stage)],stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,text=True)\ntry:\n line=server.stdout.readline();port=int(re.search(r'port (\\\\d+)',line)[1]);base=f'http://127.0.0.1:{port}'\n with sync_playwright()as pw:\n  b=pw.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-vulkan=swiftshader','--use-angle=swiftshader'])\n  try:\n   for n,extra in [(2,''),(3,'&latency=150&jitter=50&loss=5'),(4,'&latency=150&jitter=50&loss=5'),(3,'&scenario=host-leave')]:\n    p=b.new_page(viewport={'width':640,'height':420},device_scale_factor=1);errors=[];p.on('pageerror',lambda e:errors.append(str(e)));p.goto(base+f'/harness.html?game=game.html&players={n}&auto=1'+extra);p.wait_for_function('document.body.dataset.complete===\\\"true\\\"',timeout=240000);result=p.evaluate('window.__hubCheck');(DEV/'notes'/f'hub-{n}{\\\"-leave\\\" if extra.endswith(\\\"host-leave\\\") else \\\"\\\"}.json').write_text(json.dumps(result,indent=2));\n    if result.get('pass')and not errors:passed+=1\n    else:failed+=1;print(f'FAIL Hub {n} players {extra}: {json.dumps(result)} errors {errors}')\n    p.close()\n   p=b.new_page(viewport={'width':320,'height':180});p.goto(base+'/game.html');p.wait_for_function('window.__gameStatus',timeout=120000);p.keyboard.press('Enter');p.keyboard.press('Space');p.wait_for_timeout(300)\n   if p.evaluate('AIHub.active===false&&AIHub.seeded===false'):passed+=1\n   else:failed+=1;print('FAIL solo Hub isolation')\n   p.close()\n  finally:b.close()\nfinally:server.terminate();server.wait(timeout=15)\nprint(f'{passed} passed, {failed} failed');raise SystemExit(bool(failed))\nPY\ncat > README.md <<'EOF'\n# Wobble Wit\n\nA five-day wellness comedy at Tippy Cay. Open the HTML in the parent folder in a WebGPU-capable browser. Everything needed to play is embedded; no server or downloads are needed. A controller or keyboard is required. Touch-only devices show the demonstration and Settings.\n\n- Lean / walk: left stick, WASD, arrows, or mouse. Shift makes keyboard lean finer.\n- Action: Cross / A, Space, Enter, or left click.\n- Left / right steps: shoulders or triggers, Q / E, or left / right mouse buttons. Hold both to brace.\n- Schedule: Triangle / Y or Tab. Pause: Options / Menu or Esc. F11: fullscreen.\n- Menus: D-pad / stick / arrows / WASD; hover and click also work. Q / E change dev tabs.\n\nBegin a New Stay, choose one of four guest cards, a preset name and a look. Pip's morning check gives your Balance Age. Visit activity mats or fast-travel through the Schedule. Bank enough resort minutes, then end the day at your cabana. New pavilions open each day. The day-five Big Stand ends with thirty seconds of doing nothing. Both endings unlock Free Play.\n\nPlay Together supports 2–4 guests taking turns on one pad through the three-event lagoon medley. AI Hub ghost sessions use its unmodified 1.4.0 client and the same activity code. The session host handles the card, clock and results.\n\n## Build and verify\n\n\"'`tools/build.sh` creates the exact single-file deliverable in the parent folder and imports `../exit-interview.json` into its editable plain-text About data.\n\n`tests/run.sh [core|browser|hub|all]` reports failures and one count. Core tests cover the complete five-day bot run on three seeds, every activity against idle/careless input on five seeds, input/spring behavior, saves/snapshots/replay, pause, dev tuning, attract and a four-guest medley. Browser checks use keyboard/mouse, a standard pad stub, generated audio buffers and touch profiles. Hub tests use one local server on an OS-selected loopback port, shut down by PID when done. WebKit checks the unsupported-WebGPU message; it is not real iOS Safari.\n\nThe dev menu is in Pause. It includes activity/day/finale jumps, bot/no-tip cheats, minutes/unlocks, time controls, live difficulty sliders and diagnostics. It is disabled in online sessions.\n\n## Extend the resort\n\n- Rules are `engine/crates/pav_core/src/games/fit/rules.toml`. They hot-load in native tools.\n- Activities live in `events/mod.rs`, enumerated once in `ROSTER`. Add a Kind, rules, bot, goal and scene index to add an event.\n- Native set files are `fit/sets/*.toml`, placed in one Sim, 200 metres apart. Add the file to `world::SETS` to add a set.\n- Original named-part props are `engine/assets/props/lib/core/fit_*.json`; `tools/make-art.py` records their readable construction and set layouts.\n- Motion poses are `engine/anim/fit.json`. `tools/make-text-motion.py` records the authored source keys.\n- Coach dialogue and award titles are `fit/script.toml`. Rhythm notes are `fit/charts.toml`.\n- Add music arrangements to `pav_audio/src/music.rs`. Tracks use the synth'\"'s sample clock and independent music/SFX/voice gains. Gibberish voices and the 32-effect bank are in \"'`voice.rs`.\n- `pav_ui/src/fit_ui.rs` is the same pure painter in native captures and the browser. FitGame owns every menu and focus value.\n\nArt and original FIT clips are CC0. Font and motion-library credits are in the About screen and the engine'\"'s \"'`store/CREDITS.md`. Source inspiration: Wii Fit; all resort characters, props, writing and arrangements are original.\nEOF\ncat >> ../PROGRESS.md <<'\"'EOF'\n\n## Checkpoint: presentation and tests\n- Native egui UI, embedded Fredoka/Nunito fonts, procedural sample-clock music, 32 SFX and formant gibberish voices implemented.\n- Browser seams added for typed input, status/UI rectangles, one-time boot/save load, Hub ghost rendering and touch-device Settings.\n- tests/run.sh core/browser/hub/all written. First core run exposed invalid prop category (critical scene-load issue) and idle scoring in squat/tray; fixes applied, rerun underway.\n- Single-page build tool and catalogue/exit-interview created; feedback test counts remain unknown until final verification.\n- Native app check, native core tests are currently queued/running. No final HTML yet; run tools/build.sh after compile issues are resolved.\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
