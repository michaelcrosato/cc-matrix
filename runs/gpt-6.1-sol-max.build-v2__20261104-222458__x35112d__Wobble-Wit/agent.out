{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"rg -n 'pub fn (load|resolve)|pub fn.*prop|pub fn.*asset' crates/pav_core/src/props/mod.rs crates/pav_core/src/prop_instance.rs; rg -n 'pub fn (id|find)|pub fn table' crates/pav_core/src/clips.rs; sed -n '1,92p' crates/pav_core/tests/games.rs; sed -n '122,195p' crates/pav_audio/src/lib.rs; sed -n '445,480p' crates/pav_view/src/fx.rs; sed -n '716,775p' crates/pav_view/src/build.rs; rg -n 'struct GearLook' crates/pav_core/src/puppet.rs\"","aggregated_output":"crates/pav_core/src/prop_instance.rs:96:    pub fn new(asset: &str, definition: Arc<PropDef>, scale: f32, collide: bool) -> Result<Self, String> {\ncrates/pav_core/src/prop_instance.rs:128:    pub fn with_params(mut self, params: &props::Params) -> Result<Self, String> {\ncrates/pav_core/src/prop_instance.rs:235:    pub fn rebuild_prop_defs(&mut self) {\ncrates/pav_core/src/prop_instance.rs:254:    pub fn spawn_prop(\ncrates/pav_core/src/prop_instance.rs:269:    pub fn place_prop(\ncrates/pav_core/src/prop_instance.rs:283:    pub fn restyle_prop(\ncrates/pav_core/src/prop_instance.rs:308:    pub fn update_prop_instance(&mut self, id: EntityId, pos: Vec3, rot: Quat, scale: f32, collide: bool) -> Result<(), String> {\ncrates/pav_core/src/prop_instance.rs:326:    pub fn refresh_prop_instances(&mut self, name: &str, definition: Arc<PropDef>) -> usize {\ncrates/pav_core/src/prop_instance.rs:386:    pub fn invalidate_prop_navigation(&mut self) {\ncrates/pav_core/src/props/mod.rs:461:    pub fn from_v1(asset: Arc<PropAsset>) -> Result<Self, Vec<Issue>> {\ncrates/pav_core/src/props/mod.rs:683:pub fn resolve_ref(name: &str) -> Result<Arc<PropDef>, String> {\ncrates/pav_core/src/props/mod.rs:690:pub fn resolve_in(root: &std::path::Path, name: &str) -> Result<Option<Arc<PropDef>>, String> {\ncrates/pav_core/src/props/mod.rs:737:pub fn unknown_asset(name: &str) -> String {\n846:    pub fn find(&self, name: &str) -> Option<u32> {\n967:pub fn find(name: &str) -> Option<u32> {\n974:pub fn find_cached(name: &str) -> u32 {\n//! Games built on the engine (`pav_core::games`): the starter's bot wins on many seeds, the\n//! starter can be lost, and a game's state survives snapshot files, rewind and replays like\n//! the rest of the simulation. Copy these tests for a new game.\n\nuse pav_core::games::{GAMES, Outcome};\nuse pav_core::{InputFrame, Sim, SimState};\n\n#[test]\nfn the_starter_bot_wins_on_ten_seeds() {\n    for seed in 1..=10 {\n        let mut sim = Sim::new(\"starter\", seed).unwrap();\n        let (outcome, ticks) = sim.run_bot(60 * 60);\n        let status = sim.play().unwrap().status(&sim);\n        assert_eq!(outcome, Outcome::Won, \"seed {seed}, {ticks} ticks: {status}\");\n    }\n}\n\n#[test]\nfn standing_still_gets_caught() {\n    let mut sim = Sim::new(\"starter\", 1).unwrap();\n    assert_eq!(sim.frame().hud.lines, [\"Shards 0/5\", \"Lives 3\"]);\n    for _ in 0..60 * 60 {\n        sim.step(&InputFrame::default());\n    }\n    assert_eq!(sim.outcome(), Outcome::Lost);\n    assert_eq!(sim.frame().hud.lines, [\"Shards 0/5\", \"Lives 0\", \"Game over\"]);\n}\n\n#[test]\nfn snapshots_rewind_and_replays_are_exact() {\n    let mut sim = Sim::new(\"starter\", 3).unwrap();\n    for _ in 0..240 {\n        let f = sim.bot_input();\n        sim.step(&f);\n    }\n    // A snapshot file (CBOR) restores the game, and both copies then play on the same.\n    let mut bytes = Vec::new();\n    ciborium::into_writer(&sim.snapshot(), &mut bytes).unwrap();\n    let state: SimState = ciborium::from_reader(bytes.as_slice()).unwrap();\n    let mut copy = Sim::new(\"starter\", 3).unwrap();\n    copy.restore(state);\n    assert_eq!(copy.state_hash(), sim.state_hash());\n    for _ in 0..240 {\n        let (a, b) = (sim.bot_input(), copy.bot_input());\n        sim.step(&a);\n        copy.step(&b);\n    }\n    assert_eq!(copy.state_hash(), sim.state_hash());\n\n    let (tick, hash) = (sim.state.tick, sim.state_hash());\n    assert!(sim.rewind_to(tick - 90));\n    assert!(sim.rewind_to(tick));\n    assert_eq!(sim.state_hash(), hash);\n\n    let mut again = Sim::new(\"starter\", 3).unwrap();\n    for f in sim.recording.iter() {\n        again.step(f);\n    }\n    assert_eq!(again.state_hash(), hash);\n}\n\n#[test]\nfn game_keys_name_one_scene_each() {\n    let names = pav_core::scenes::names();\n    for g in GAMES {\n        assert_eq!(names.iter().filter(|n| *n == g.key).count(), 1, \"'{}' is also a scene or room key\", g.key);\n        assert!(!g.key.contains('/'), \"'{}': `<key>/<rest>` passes the rest to the game\", g.key);\n        assert!(Sim::new(g.key, 1).unwrap().play().is_some_and(|p| p.key() == g.key));\n    }\n}\n                self.noise ^= self.noise << 5;\n                (self.noise as f32 / u32::MAX as f32) * 2.0 - 1.0\n            }\n        };\n        let cutoff = p.cutoff * (p.cutoff_end / p.cutoff.max(1.0)).powf((self.t / p.length().max(1e-3)).min(1.0));\n        let a = 1.0 - (-std::f32::consts::TAU * cutoff * dt).exp();\n        self.lp += (raw - self.lp) * a;\n        let s = self.lp * self.env() * p.volume;\n        self.t += dt;\n        s\n    }\n}\n\n/// Mixes voices into interleaved stereo.\npub struct Mixer {\n    voices: Vec<Voice>,\n    pub sample_rate: f32,\n    pub master: f32,\n    seed: u32,\n}\n\nconst MAX_VOICES: usize = 64;\n\nimpl Mixer {\n    pub fn new(sample_rate: f32) -> Self {\n        Self { voices: Vec::new(), sample_rate, master: 0.8, seed: 0x9e37_79b9 }\n    }\n\n    /// pan -1 (left) .. 1 (right); delay in seconds.\n    pub fn play(&mut self, p: Patch, pan: f32, gain: f32, delay: f32) {\n        if self.voices.len() >= MAX_VOICES {\n            // Drop the oldest.\n            self.voices.remove(0);\n        }\n        self.seed = self.seed.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);\n        let pan = pan.clamp(-1.0, 1.0);\n        let a = (pan + 1.0) * std::f32::consts::FRAC_PI_4;\n        self.voices.push(Voice {\n            p,\n            t: 0.0,\n            delay,\n            phase: 0.0,\n            lp: 0.0,\n            noise: self.seed | 1,\n            gain_l: a.cos() * gain,\n            gain_r: a.sin() * gain,\n        });\n    }\n\n    /// Renders into an interleaved stereo buffer (overwrites).\n    pub fn render(&mut self, out: &mut [f32]) {\n        let dt = 1.0 / self.sample_rate;\n        for frame in out.chunks_mut(2) {\n            let (mut l, mut r) = (0.0, 0.0);\n            for v in &mut self.voices {\n                let s = v.next(dt);\n                l += s * v.gain_l;\n                r += s * v.gain_r;\n            }\n            // Soft clip.\n            let m = self.master;\n            frame[0] = (l * m).tanh();\n            if frame.len() > 1 {\n                frame[1] = (r * m).tanh();\n            }\n        }\n        self.voices.retain(|v| !v.done());\n    }\n\n    pub fn active(&self) -> usize {\n        self.voices.len()\n    }\n}\n\n        E::Break { pos } => out.push(with(\"dust\", *pos, 24, &|_| {})),\n        E::Respawn { pos } => out.push(with(\"magic\", *pos + Vec3::Y * 0.6, 50, &|b| {\n            b.area = Vec3::new(0.3, 0.8, 0.3);\n        })),\n        E::Bounce { pos } => out.push(with(\"dust\", *pos, 10, &|b| b.spread = 2.0)),\n        E::Shot { pos } => out.push(with(\"sparks\", *pos, 3, &|b| {\n            b.spread = 1.0;\n            b.vel = Vec3::ZERO;\n            b.life = (0.05, 0.12);\n            b.color0 = Vec4::new(1.5, 3.0, 4.0, 1.0);\n            b.floor = None;\n        })),\n        E::Damage { pos } => out.push(with(\"sparks\", *pos, 6, &|b| {\n            b.spread = 3.0;\n            b.vel = Vec3::ZERO;\n            b.life = (0.1, 0.3);\n            b.floor = None;\n        })),\n        E::Destroyed { pos, size } => {\n            let s = size.max(0.3);\n            out.push(with(\"sparks\", *pos, (40.0 * s).min(160.0) as u32, &|b| {\n                b.spread = 6.0 * s.sqrt();\n                b.vel = Vec3::ZERO;\n                b.floor = None;\n            }));\n            out.push(with(\"fire\", *pos, (30.0 * s).min(120.0) as u32, &|b| {\n                b.area = Vec3::splat(s * 0.5);\n                b.spread = 2.0 * s;\n                b.size = (0.3 * s.max(0.6), 0.05);\n                b.life = (0.25, 0.6);\n            }));\n        }\n        E::Land { pos, speed } if *speed > 8.0 => out.push(with(\"dust\", *pos, 12, &|b| b.spread = 2.0)),\n        _ => {}\n    }\n}\n    pub fn materials(&mut self) -> MutexGuard<'_, MaterialTable> {\n        lock(&self.materials)\n    }\n\n    /// Turns simulation events into visual effects (explosions, dust).\n    pub fn add_events(&mut self, events: &[SimEvent]) {\n        for e in events {\n            crate::fx::event_bursts(e, &mut self.pending_particles);\n            if let SimEvent::Explosion { pos, radius } = e {\n                self.shocks.push((*pos, radius * 3.5, self.last_time.unwrap_or(0.0)));\n                self.water_dents.push((*pos, radius * 1.2, 0.22));\n            }\n            if let SimEvent::Splash { pos } = e {\n                self.water_dents.push((*pos, 0.7, 0.12));\n            }\n            if let SimEvent::Destroyed { pos, size } = e {\n                self.shocks.push((*pos, size.max(0.5) * 5.0, self.last_time.unwrap_or(0.0)));\n            }\n            match e {\n                SimEvent::Slam { pos, radius } => self.shocks.push((*pos, radius * 2.5, self.last_time.unwrap_or(0.0))),\n                SimEvent::Blast { pos, .. } => self.shocks.push((*pos, 4.0, self.last_time.unwrap_or(0.0))),\n                _ => {}\n            }\n            match e {\n                SimEvent::Explosion { pos, radius } => {\n                    self.effects.push(Effect { kind: EffectKind::Explosion { radius: *radius }, pos: *pos, start: self.now })\n                }\n                SimEvent::Land { pos, speed } if *speed > 6.0 => {\n                    self.effects.push(Effect { kind: EffectKind::Dust, pos: *pos, start: self.now })\n                }\n                SimEvent::Hit { pos, .. } => self.effects.push(Effect {\n                    kind: EffectKind::Burst { color: [1.0, 0.35, 0.2], up: 0.5 },\n                    pos: *pos,\n                    start: self.now,\n                }),\n                SimEvent::Splash { pos } => self.effects.push(Effect {\n                    kind: EffectKind::Burst { color: [0.75, 0.88, 1.0], up: 2.5 },\n                    pos: *pos + Vec3::Y * 0.3,\n                    start: self.now,\n                }),\n                SimEvent::Break { pos } => self.effects.push(Effect {\n                    kind: EffectKind::Burst { color: [0.85, 0.82, 0.75], up: 1.0 },\n                    pos: *pos,\n                    start: self.now,\n                }),\n                SimEvent::Bounce { pos } => self.effects.push(Effect {\n                    kind: EffectKind::Burst { color: [1.0, 0.6, 0.75], up: 0.5 },\n                    pos: *pos + Vec3::Y * 0.1,\n                    start: self.now,\n                }),\n                SimEvent::Respawn { pos } => self.effects.push(Effect {\n                    kind: EffectKind::Burst { color: [1.0, 1.0, 1.0], up: 1.5 },\n                    pos: *pos + Vec3::Y * 0.4,\n                    start: self.now,\n                }),\n                _ => {}\n            }\n        }\n    }\n\n99:pub struct GearLook {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"sed -n '251,283p' engine/crates/pav_core/src/prop_instance.rs; sed -n '99,136p' engine/crates/pav_core/src/puppet.rs; sed -n '1,75p' engine/crates/pav_core/src/puppet.rs; sed -n '123,143p' engine/crates/pav_core/src/puppet.rs; sed -n '115,132p' engine/crates/pav_core/src/room.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"sed -n '251,283p' engine/crates/pav_core/src/prop_instance.rs; sed -n '99,136p' engine/crates/pav_core/src/puppet.rs; sed -n '1,75p' engine/crates/pav_core/src/puppet.rs; sed -n '123,143p' engine/crates/pav_core/src/puppet.rs; sed -n '115,132p' engine/crates/pav_core/src/room.rs\"","aggregated_output":"}\n\nimpl Sim {\n    pub fn spawn_prop(\n        &mut self,\n        asset: &str,\n        pos: Vec3,\n        rot: Quat,\n        scale: f32,\n        collide: bool,\n        region: Option<RegionKey>,\n    ) -> Result<EntityId, String> {\n        // `NAME:preset` places a family's preset.\n        let (name, definition, params) = props::resolve_placed(asset, &props::Params::new())?;\n        self.place_prop(PropInstance::new(&name, definition, scale, collide)?.with_params(&params)?, pos, rot, region)\n    }\n\n    /// Place a prepared copy (its seed and palette set).\n    pub fn place_prop(\n        &mut self,\n        instance: PropInstance,\n        pos: Vec3,\n        rot: Quat,\n        region: Option<RegionKey>,\n    ) -> Result<EntityId, String> {\n        validate_pose(pos, rot)?;\n        let mut spawn = Spawn::new(&instance.definition.doc.name, pos).rot(rot).prop(instance);\n        spawn.region = region;\n        Ok(self.spawn(spawn))\n    }\n\n    /// A copy's variant, palette and knob values: its parts and collision follow them.\n    pub fn restyle_prop(\npub struct GearLook {\n    pub helm: HelmKind,\n    pub helm_color: String,\n    /// Shoulder plates (0 = none, 1 = full size) and their colour.\n    pub pauldrons: f32,\n    pub armor_color: String,\n    /// Cape (0 = none) and its colour.\n    pub cape: f32,\n    pub cape_color: String,\n    /// Glove and belt colours (\"\" = none).\n    pub gloves: String,\n    pub belt: String,\n    /// Enchanted shine on the helmet.\n    pub glow: f32,\n}\n\nimpl Default for GearLook {\n    fn default() -> Self {\n        Self {\n            helm: HelmKind::None,\n            helm_color: \"#8a8f99\".into(),\n            pauldrons: 0.0,\n            armor_color: \"#8a8f99\".into(),\n            cape: 0.0,\n            cape_color: \"#3a2f4a\".into(),\n            gloves: String::new(),\n            belt: String::new(),\n            glow: 0.0,\n        }\n    }\n}\n\nfn smooth(a: f32, b: f32, x: f32) -> f32 {\n    let t = ((x - a) / (b - a).max(1e-4)).clamp(0.0, 1.0);\n    t * t * (3.0 - 2.0 * t)\n}\n\nchoice_enum! {\n//! Character puppet v1: an invisible skeleton driven by procedural animation, with sphere /\n//! rounded-cone parts attached. The simulation advances a small `PuppetState` every tick; the\n//! view turns (interpolated) state into parts with `pose()`, so any camera and style works.\n\nuse glam::{Quat, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse crate::choice_enum;\nuse crate::color::Color;\nuse crate::params::{ChoiceParam, ParamVisitor, Tunable};\nuse crate::rig::RigView;\nuse crate::shape::Look;\n\nchoice_enum! {\n    /// What a character holds (Shardfall weapons).\n    #[derive(Default)]\n    pub enum WeaponKind {\n        #[default]\n        None => \"none\",\n        Sword => \"sword\",\n        Axe => \"axe\",\n        Mace => \"mace\",\n        Dagger => \"dagger\",\n        Spear => \"spear\",\n        Staff => \"staff\",\n        Greatsword => \"greatsword\",\n        Maul => \"maul\",\n        Wand => \"wand\",\n        Claw => \"claw\",\n    }\n}\n\nchoice_enum! {\n    /// What the off hand holds.\n    #[derive(Default)]\n    pub enum OffhandKind {\n        #[default]\n        None => \"none\",\n        Shield => \"shield\",\n        Focus => \"focus\",\n    }\n}\n\n/// A held weapon's look: drawn from the hand along the arm, swinging with attacks.\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct WeaponLook {\n    pub kind: WeaponKind,\n    /// Blade / head colour and grip / haft colour.\n    pub color: String,\n    pub grip: String,\n    /// Glow of the blade (enchanted and unique weapons).\n    pub glow: f32,\n    /// Length multiplier.\n    pub size: f32,\n    pub offhand: OffhandKind,\n    pub offhand_color: String,\n    /// A library prop drawn in place of the weapon (`LIB/core/mage_staff`), held by its `grip`\n    /// socket with the socket's +y along the weapon; `kind` still sets the reach and the swings.\n    #[serde(skip_serializing_if = \"String::is_empty\")]\n    pub asset: String,\n}\n\nimpl Default for WeaponLook {\n    fn default() -> Self {\n        Self {\n            kind: WeaponKind::None,\n            color: \"#c9ced8\".into(),\n            grip: \"#5a3b26\".into(),\n            glow: 0.0,\n            size: 1.0,\n            offhand: OffhandKind::None,\n            offhand_color: \"#8a6a3a\".into(),\n            asset: String::new(),\n        }\n            cape_color: \"#3a2f4a\".into(),\n            gloves: String::new(),\n            belt: String::new(),\n            glow: 0.0,\n        }\n    }\n}\n\nfn smooth(a: f32, b: f32, x: f32) -> f32 {\n    let t = ((x - a) / (b - a).max(1e-4)).clamp(0.0, 1.0);\n    t * t * (3.0 - 2.0 * t)\n}\n\nchoice_enum! {\n    /// Body plan: the skeleton the puppet is built on.\n    #[derive(Default)]\n    pub enum BodyPlan {\n        #[default]\n        Biped => \"biped\",\n        Spider => \"spider\",\n        Lizard => \"lizard\",\n    pub sway: crate::shape::Sway,\n}\n\nimpl ObjectDef {\n    /// Rotation in the room's own frame.\n    pub fn local_rot(&self) -> glam::Quat {\n        glam::Quat::from_euler(glam::EulerRot::YXZ, self.yaw.to_radians(), self.pitch.to_radians(), self.roll.to_radians())\n    }\n\n    /// A prop's library name, its definition with `patch` applied, and its knob values. Errors:\n    /// not a prop, an asset this build lacks, bad knob values or a patch that does not apply.\n    pub fn placed(&self) -> Result<(String, std::sync::Arc<crate::props::PropDef>, crate::props::Params), String> {\n        let asset = self.asset.as_deref().ok_or_else(|| format!(\"object '{}' places no asset\", self.name))?;\n        let (name, definition, params) = crate::props::resolve_placed(asset, &self.params)?;\n        let definition = crate::props::patched(&definition, &self.patch).map_err(|e| format!(\"object '{}': {e}\", self.name))?;\n        Ok((name, definition, params))\n    }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"cat > tools/make-art.py <<'PY'\nfrom pathlib import Path\nimport json,math\nroot=Path(__file__).resolve().parents[1]/'engine'\nasset=root/'assets/props/lib/core'\nC={'deck':'#fbfaf6','teal':'#46bec8','coral':'#ff887c','mint':'#78dcaa','sand':'#f6e7c8','wood':'#c99872','ink':'#263e54','yellow':'#ffd166','leaf':'#98c99b','pink':'#eba5bd'}\ndef part(t,color,pos=(0,0,0),**kw):return {'type':t,'color':C.get(color,color),'pos':list(pos),**kw}\ndef box(size,pos,color='deck',r=0.07):return part('rounded_box',color,pos,size=size,radius=r)\ndef ell(size,pos,color):return part('ellipsoid',color,pos,size=size)\ndef cyl(rad,h,pos,color):return part('cylinder',color,pos,radius=rad,height=h)\ndef tor(rad,minor,pos,color):return part('torus',color,pos,radius=rad,minor_radius=minor)\ndef save(name,parts,tags=['resort','wellness']):\n d={'format':2,'name':'fit_'+name,'unit':'m','description':f'Tippy Cay {name.replace(\\\"_\\\",\\\" \\\")}.','category':'scenery','tags':tags,'parts':parts,'lineage':{'method':'authored','origin':'agent','parents':[],'license':'CC0-1.0','credit':'Original Wobble Wit resort art.'}}\n (asset/f'fit_{name}.json').write_text(json.dumps(d,indent=2))\nsave('palm',{'trunk':part('cone','wood',(0,2.15,0),radius=.22,radius_end=.12,height=4.3,roll=-9),'crown':ell([.65,.45,.65],(.3,4.2,0),'leaf'),**{f'frond{i}':{**ell([.65,.17,2.8],(.3+math.sin(i*math.tau/7)*.9,4.15,math.cos(i*math.tau/7)*.9),'leaf'),'yaw':i*360/7,'pitch':-14,'sway':'leaves'}for i in range(7)}})\nsave('mat',{'body':box([1.25,.07,2.25],(0,.05,0),'teal',.025),'trim':box([1.1,.015,.12],(0,.095,.95),'mint',.007)})\nsave('step',{'top':box([1.7,.2,.7],(0,.26,0),'teal'),'leg':box([.25,.2,.5],(.55,.1,0),'ink',.03),'leg2':box([.25,.2,.5],(-.55,.1,0),'ink',.03)})\nsave('paddleboard',{'hull':ell([1.25,.23,3.5],(0,.06,0),'deck'),'stripe':box([.6,.02,2.4],(0,.19,0),'teal',.008),'stripe2':box([.2,.02,2.5],(.39,.19,0),'coral',.008)})\nsave('buoy',{'base':ell([.65,.6,.65],(0,.25,0),'coral'),'stripe':cyl(.32,.15,(0,.28,0),'deck'),'post':cyl(.04,1.4,(0,.9,0),'ink'),'flag':box([.5,.3,.04],(.25,1.5,0),'yellow',.015)})\nsave('raft',{'deck':box([6.,.22,6.],(0,.1,0),'wood'),'rim':box([6.,.16,.14],(0,.3,2.9),'deck'),'rim2':box([6.,.16,.14],(0,.3,-2.9),'deck'),'rim3':box([.14,.16,6.],(2.9,.3,0),'deck'),'rim4':box([.14,.16,6.],(-2.9,.3,0),'deck')})\nsave('pool',{'rim':tor(.43,.09,(0,.035,0),'teal'),'water':cyl(.38,.025,(0,.025,0),'#8fdde0')})\nsave('shell',{'shell':ell([.43,.33,.38],(0,.18,0),'coral'),'spiral':tor(.11,.04,(.04,.32,.02),'deck'),'feet':ell([.55,.08,.4],(0,.045,0),'yellow'),'eye':part('sphere','ink',(.1,.29,.18),radius=.035),'eye2':part('sphere','ink',(-.1,.29,.18),radius=.035)})\nsave('tray',{'tray':box([1.5,.07,.85],(0,.04,0),'wood'),'rim':box([1.5,.1,.05],(0,.1,.4),'coral')})\nsave('smoothie',{'glass':part('cone','deck',(0,.2,0),radius=.1,radius_end=.15,height=.4),'drink':cyl(.135,.05,(0,.4,0),'pink'),'straw':part('cylinder','yellow',(.05,.55,0),radius=.018,height=.3,roll=15),'umbrella':part('cone','coral',(-.03,.7,0),radius=.16,radius_end=0.,height=.12)})\nsave('floatie',{'ring':tor(.65,.16,(0,.18,0),'coral'),'stripe':tor(.65,.045,(0,.31,0),'yellow')})\nsave('lounge',{'seat':box([.8,.13,1.5],(0,.45,.2),'deck'),'back':{**box([.8,.12,.9],(0,.8,-.7),'teal'),'pitch':-50},'leg1':box([.12,.5,1.1],(-.3,.23,.2),'wood'),'leg2':box([.12,.5,1.1],(.3,.23,.2),'wood')})\nsave('umbrella',{'pole':cyl(.045,3.,(0,1.5,0),'wood'),'canopy':part('cone','coral',(0,3.,0),radius=1.65,radius_end=0.,height=.55),'cap':part('sphere','deck',(0,3.3,0),radius=.09)})\nsave('cabana',{'floor':box([4.,.2,3.],(0,.1,0),'deck'),'roof':part('wedge','sand',(0,2.9,0),size=[4.5,1.,3.5],peak=0),'post1':cyl(.08,2.4,(-1.8,1.4,-1.3),'wood'),'post2':cyl(.08,2.4,(1.8,1.4,-1.3),'wood'),'post3':cyl(.08,2.4,(-1.8,1.4,1.3),'wood'),'post4':cyl(.08,2.4,(1.8,1.4,1.3),'wood'),'bed':box([1.5,.45,2.2],(0,.5,0),'teal'),'pillow':ell([1.1,.3,.5],(0,.85,-.65),'deck')})\nsave('desk',{'front':box([3.,1.,.85],(0,.5,0),'wood'),'counter':box([3.3,.15,1.1],(0,1.05,0),'deck'),'stripe':box([2.8,.16,.025],(0,.63,.44),'teal'),'bell':part('sphere','yellow',(.8,1.2,0),radius=.14)})\nsave('pavilion',{'base':cyl(4.,.16,(0,.08,0),'deck'),'roof':part('cone','teal',(0,3.5,0),radius=4.2,radius_end=.35,height=1.0),**{f'post{i}':cyl(.1,3.,(math.sin(i*math.tau/6)*3.5,1.6,math.cos(i*math.tau/6)*3.5),'deck')for i in range(6)}})\nsave('calendar',{'board':box([3.2,2.2,.18],(0,1.5,0),'deck'),'post1':box([.13,2.5,.13],(-1.3,1.25,0),'wood'),'post2':box([.13,2.5,.13],(1.3,1.25,0),'wood'),**{f'day{i}':box([.43,.55,.06],((i-2)*.53,1.45,.13),'teal',.025)for i in range(5)}})\nsave('clam',{'bottom':ell([2.6,.75,1.7],(0,.45,0),'pink'),'inside':ell([2.4,.2,1.5],(0,.72,0),'coral'),'top':{**ell([2.6,.3,1.7],(0,1.,-.4),'pink'),'pitch':-38},'pearl':part('sphere','deck',(0,.86,.1),radius=.29)})\nsave('flipflop',{'sole':ell([.27,.065,.55],(0,.04,0),'yellow'),'strap1':{**box([.04,.1,.3],(.06,.09,0),'coral',.015),'roll':-35},'strap2':{**box([.04,.1,.3],(-.06,.09,0),'coral',.015),'roll':35}})\nsave('gull',{'body':ell([.6,.42,.8],(0,.32,0),'deck'),'head':part('sphere','deck',(0,.6,.29),radius=.22),'beak':part('cone','yellow',(0,.58,.55),radius=.09,radius_end=0.,height=.24,pitch=90),'eyes':part('sphere','ink',(.15,.64,.4),radius=.035),'eyes2':part('sphere','ink',(-.15,.64,.4),radius=.035),'wing':ell([1.25,.09,.4],(0,.43,0),'deck'),'cap':cyl(.22,.12,(0,.82,.28),'ink')})\nsave('scorecard',{'card':box([.65,.8,.05],(0,1.,0),'deck'),'handle':cyl(.035,.7,(0,.35,0),'wood')})\nsave('lotus',{'lily':ell([1.1,.03,.95],(0,.02,0),'leaf'),**{f'petal{i}':{**ell([.2,.18,.58],(math.sin(i*math.tau/7)*.2,.15,math.cos(i*math.tau/7)*.2),'pink'),'yaw':i*360/7}for i in range(7)},'heart':part('sphere','yellow',(0,.22,0),radius=.11)})\nsave('towels',{'towel1':box([.8,.17,.5],(0,.1,0),'deck'),'towel2':box([.8,.17,.5],(.04,.27,0),'teal'),'towel3':box([.8,.17,.5],(-.02,.44,0),'deck')})\nsave('kettle',{'body':part('sphere','ink',(0,.7,0),radius=.7),'handle':{**tor(.5,.12,(0,1.45,0),'ink'),'pitch':90},'eye1':part('sphere','deck',(.21,.85,.63),radius=.065),'eye2':part('sphere','deck',(-.21,.85,.63),radius=.065)})\nsave('tower',{'deck':box([3.,.25,2.4],(0,4.,0),'deck'),'leg1':box([.22,4.,.22],(-1.2,2.,-.9),'wood'),'leg2':box([.22,4.,.22],(1.2,2.,-.9),'wood'),'leg3':box([.22,4.,.22],(-1.2,2.,.9),'wood'),'leg4':box([.22,4.,.22],(1.2,2.,.9),'wood'),'ladder':box([.65,4.,.1],(1.4,2.,0),'teal'),'board':box([3.4,.11,.65],(2.2,4.2,0),'coral')})\nsave('diving_board',{'base':box([.8,.4,.7],(-1.1,.2,0),'teal'),'spring':tor(.25,.07,(-.8,.6,0),'ink'),'board':box([3.2,.13,.7],(0,.85,0),'coral')})\nsave('small_raft',{'logs':{**cyl(.18,3.,(0,.15,0),'wood'),'pitch':90,'array':{'count':5,'step':[.38,0,0]}},'flagpole':cyl(.03,2.,(.6,1.,-.8),'wood'),'flag':box([.5,.4,.025],(.84,1.8,-.8),'coral',.01)})\nsave('crab',{'body':ell([.55,.2,.35],(0,.18,0),'coral'),'legs':{**box([.65,.04,.05],(0,.08,0),'coral',.015),'array':{'count':3,'step':[0,0,.15]}},'claw1':part('sphere','coral',(.38,.23,.15),radius=.12),'claw2':part('sphere','coral',(-.38,.23,.15),radius=.12)})\nsave('ribbon',{'ring':{**tor(.32,.06,(0,1.,0),'yellow'),'pitch':90},'tail':box([.15,.45,.04],(-.15,.6,0),'coral',.015),'tail2':box([.15,.45,.04],(.15,.6,0),'coral',.015)})\nsave('pip',{'cushion':ell([1.4,.48,1.4],(0,.28,0),'#8ccbdc'),'ring':tor(.58,.06,(0,.48,0),'deck'),'eye1':part('sphere','ink',(.18,.42,.61),radius=.055),'eye2':part('sphere','ink',(-.18,.42,.61),radius=.055),'valve':cyl(.07,.15,(.7,.25,0),'teal')})\n# Island and every activity are separate native rooms, with the same palette.\nsets=['hub','studio','gazebo','boardwalk','tide','channel','pier','tower','bay']\nfor n,name in enumerate(sets):\n yaw,tilt,dist,fov=[(10,38,32,42),(0,12,10,38),(-22,18,11,38),(0,20,12,40),(0,62,13,42),(180,22,11,42),(180,19,11,40),(90,6,15,42),(0,18,12,40)][n]\n text=f'''name = \\\"{name.title()} · Tippy Cay\\\"\nabout = \\\"A small place to stand.\\\"\nentrance = {{ at = [16, 18], facing = \\\"south\\\" }}\n[camera]\nyaw = {float(yaw)}\ntilt = {float(tilt)}\ndistance = {float(dist)}\nfov = {float(fov)}\n[view]\nsky = \\\"{'#eddbd5' if n==8 else '#d6eef6'}\\\"\nexposure = 1.0\nsaturation = 0.95\nbloom = 0.15\nbloom_threshold = 1.3\noutlines_on = \\\"objects\\\"\noutline_px = 1.0\noutline_darken = 0.45\nrim = 0.3\nfog = true\nfog_start = 32.0\nfog_end = 125.0\nwind = 0.5\n\\\"light.sun_elevation\\\" = {24.0 if n in [2,8] else 52.0}\n\\\"light.sun_azimuth\\\" = 160.0\n\\\"light.sun_intensity\\\" = 0.62\n\\\"light.ambient\\\" = 1.15\n\\\"cutaway.height_cut\\\" = false\n\\\"cutaway.front_cut\\\" = false\n\\\"cutaway.fade\\\" = false\n[layout]\norigin = [{n*200-16}.0, 0.0, -12.0]\n[[layout.layer]]\ny = 0\nmap = \\\"\\\"\\\"\n'''\n for z in range(24):text+=''.join('P' if (x,z)==(16,12) else '.' for x in range(32))+'\\\\n'\n text+='\\\"\\\"\\\"\\\\n[layout.legend.\\\\'.\\\\']\\\\n[layout.legend.\\\\'P\\\\']\\\\nmarker = \\\"player\\\"\\\\n'\n def obj(key,pos,shape=None,color=None,assetname=None,scale=None,yaw=None):\n  nonlocal_dummy=None\n  s=f'\\\\n[[object]]\\\\nname = \\\"{key}\\\"\\\\npos = {json.dumps(pos)}\\\\n'\n  if assetname:s+=f'asset = \\\"LIB/core/{assetname}\\\"\\\\n'\n  if shape:s+='shape = '+shape+'\\\\n'\n  if color:s+=f'color = \\\"{color}\\\"\\\\nlook = \\\"cel\\\"\\\\n'\n  if scale:s+=f'scale = {scale}\\\\n'\n  if yaw is not None:s+=f'yaw = {float(yaw)}\\\\n'\n  s+='body = \\\"fixed\\\"\\\\n';return s\n def P(x,y,z):return [x+16,y,z+12]\n text+=obj('sea',P(0,-.2,0),'{ type = \\\"cylinder\\\", half_height = 0.05, radius = 130.0 }','#8fdde0')\n # Floor extends below the water so routed activities never enter swimming posture.\n text+=obj('support',P(0,-.21,-40),'{ type = \\\"box\\\", half = [42.0, 0.15, 100.0] }','#8fdde0')\n if n==0:\n  text+=obj('sand',P(0,-.05,0),'{ type = \\\"cylinder\\\", half_height = 0.2, radius = 25.0 }','#f6e7c8')\n  text+=obj('grass',P(0,.12,0),'{ type = \\\"cylinder\\\", half_height = 0.04, radius = 22.7 }','#bfe6b0')\n  text+=obj('reception_deck',P(0,.19,0),'{ type = \\\"cylinder\\\", half_height = 0.08, radius = 7.0 }','#fbfaf6')\n  text+=obj('path1',P(0,.18,0),'{ type = \\\"box\\\", half = [2.2, 0.04, 20.0] }','#f6e7c8')\n  text+=obj('path2',P(0,.18,0),'{ type = \\\"box\\\", half = [21.0, 0.04, 1.8] }','#f6e7c8')\n  for i,(x,z)in enumerate([(-13,-8),(13,-8),(-13,8),(13,8)]):\n   text+=obj('pavilion'+str(i),P(x,.2,z),assetname='fit_pavilion',scale=.9)\n   text+=obj('mat'+str(i),P(x,.35,z+1.5),assetname='fit_mat')\n  for i,(key,x,z)in enumerate([('fit_desk',0,-2),('fit_clam',3,1),('fit_calendar',-4,-3),('fit_cabana',-6,16),('fit_cabana',0,17),('fit_cabana',6,16),('fit_towels',-2,0)]):text+=obj(key+str(i),P(x,.22,z),assetname=key)\n  for i in range(18):\n   a=i*math.tau/18;text+=obj('palm'+str(i),P(math.sin(a)*22.5,.18,math.cos(a)*22.5),assetname='fit_palm',scale=.7+(i%3)*.15,yaw=i*67)\n  for i,(x,z)in enumerate([(-19,-4),(19,2),(-18,12),(18,-12)]):\n   text+=obj('umbrella'+str(i),P(x,.18,z),assetname='fit_umbrella',scale=.8)\n   text+=obj('lounge'+str(i),P(x+1,.18,z+1),assetname='fit_lounge',scale=.9,yaw=-25)\n  text+=obj('pier',P(15,.22,14),'{ type = \\\"box\\\", half = [2.0, 0.15, 9.0] }','#c99872')\n  text+=obj('rowboat',P(19,0,18),assetname='rowboat')\n else:\n  if n in [1,2,3]:\n   text+=obj('deck',P(0,.03,0),'{ type = \\\"cylinder\\\", half_height = 0.1, radius = 7.2 }','#fbfaf6')\n   text+=obj('edge',P(0,-.03,0),'{ type = \\\"cylinder\\\", half_height = 0.1, radius = 7.45 }','#c99872')\n   for i in range(5):text+=obj('lily'+str(i),P((i-2)*2.4,0.,-8.-(i%2)*1.5),assetname='fit_lotus')\n   for i in [-1,1]:\n    text+=obj('palm'+str(i),P(i*9,0,-4),assetname='fit_palm')\n    text+=obj('lounge'+str(i),P(i*5,.12,-3),assetname='fit_lounge',yaw=-i*35)\n   text+=obj('mat',P(0,.15,0),assetname='fit_mat')\n   if n==2:text+=obj('kettle',P(3,.12,0),assetname='fit_kettle',scale=1.2)\n   if n==3:text+=obj('step',P(0,.15,.1),assetname='fit_step')\n  elif n==4:text+=obj('raft',P(0,.03,0),assetname='fit_raft')\n  elif n==5:\n   for j in range(11):\n    x=math.sin(j*1.7)*2.4\n    for side in [-1,1]:text+=obj(f'buoy{j}_{side}',P(x+side*1.5,0,-j*8.),assetname='fit_buoy')\n  elif n==6:\n   text+=obj('long_pier',P(0,.1,-30),'{ type = \\\"box\\\", half = [2.0, 0.15, 40.0] }','#c99872')\n   for j in range(20):text+=obj('plank'+str(j),P(0,.26,-j*3.5),'{ type = \\\"box\\\", half = [2.0, 0.01, 0.015] }','#f6e7c8')\n  elif n==7:\n   text+=obj('platform',P(-1,-.1,0),'{ type = \\\"box\\\", half = [3.5, 0.2, 3.0] }','#fbfaf6')\n   text+=obj('board',P(0,.05,0),assetname='fit_diving_board')\n   text+=obj('tower',P(-5,0,-3),assetname='fit_tower')\n   for j in range(3):text+=obj('judge'+str(j),P(4,0,(j-1)*2.),assetname='fit_gull',yaw=-90)\n  elif n==8:\n   text+=obj('post',P(0,-.35,0),'{ type = \\\"cylinder\\\", half_height = 0.6, radius = 0.65 }','#c99872')\n   for j in range(9):\n    a=(j+1)*math.tau/10;text+=obj('raft'+str(j),P(math.sin(a)*7.,0,math.cos(a)*7.-2.),assetname='fit_small_raft',yaw=j*36)\n  for j in range(4):text+=obj('distant_palm'+str(j),P((j-1.5)*9,-.3,-22),assetname='fit_palm',scale=.7)\n # Every set has quiet company.\n for i,(x,z)in enumerate([(-4,-2),(4,-3),(-5,2)] if n else [(-2,5),(4,5),(7,1),(-9,14)]):\n  text+=f'\\\\n[[npc]]\\\\nname = \\\"guest_{n}_{i}\\\"\\\\nkind = \\\"biped\\\"\\\\npos = {P(x,.3,z)}\\\\nlook = {{ skin = \\\"#cf946e\\\", shirt = \\\"#faf8ee\\\", pants = \\\"#faf8ee\\\", shoes = \\\"#c99872\\\", scale = 0.9, gear = {{ helm = \\\"hood\\\", helm_color = \\\"#fbfaf6\\\" }} }}\\\\n'\n if n==1:text+='\\\\n[[npc]]\\\\nname = \\\"Posey\\\"\\\\nkind = \\\"biped\\\"\\\\npos = [19.0,0.2,12.0]\\\\nlook = { skin = \\\"#d8b184\\\", shirt = \\\"#d8b184\\\", pants = \\\"#c79f6e\\\", shoes = \\\"#c79f6e\\\", eyes = \\\"#d8b184\\\", scale = 1.05 }\\\\n'\n if n in [0,3]:text+=f'\\\\n[[npc]]\\\\nname = \\\"Bounce\\\"\\\\nkind = \\\"blob\\\"\\\\npos = {P(3,.2,-1)}\\\\nlook = {{ skin = \\\"#eba5bd\\\", shirt = \\\"#eba5bd\\\", scale = 1.2 }}\\\\n'\n (root/'crates/pav_core/src/games/fit/sets'/f'{name}.toml').write_text(text)\nPY\npython3 tools/make-art.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"cat > tools/make-art.py <<'PY'\nfrom pathlib import Path\nimport json,math\nroot=Path(__file__).resolve().parents[1]/'engine'\nasset=root/'assets/props/lib/core'\nC={'deck':'#fbfaf6','teal':'#46bec8','coral':'#ff887c','mint':'#78dcaa','sand':'#f6e7c8','wood':'#c99872','ink':'#263e54','yellow':'#ffd166','leaf':'#98c99b','pink':'#eba5bd'}\ndef part(t,color,pos=(0,0,0),**kw):return {'type':t,'color':C.get(color,color),'pos':list(pos),**kw}\ndef box(size,pos,color='deck',r=0.07):return part('rounded_box',color,pos,size=size,radius=r)\ndef ell(size,pos,color):return part('ellipsoid',color,pos,size=size)\ndef cyl(rad,h,pos,color):return part('cylinder',color,pos,radius=rad,height=h)\ndef tor(rad,minor,pos,color):return part('torus',color,pos,radius=rad,minor_radius=minor)\ndef save(name,parts,tags=['resort','wellness']):\n d={'format':2,'name':'fit_'+name,'unit':'m','description':f'Tippy Cay {name.replace(\\\"_\\\",\\\" \\\")}.','category':'scenery','tags':tags,'parts':parts,'lineage':{'method':'authored','origin':'agent','parents':[],'license':'CC0-1.0','credit':'Original Wobble Wit resort art.'}}\n (asset/f'fit_{name}.json').write_text(json.dumps(d,indent=2))\nsave('palm',{'trunk':part('cone','wood',(0,2.15,0),radius=.22,radius_end=.12,height=4.3,roll=-9),'crown':ell([.65,.45,.65],(.3,4.2,0),'leaf'),**{f'frond{i}':{**ell([.65,.17,2.8],(.3+math.sin(i*math.tau/7)*.9,4.15,math.cos(i*math.tau/7)*.9),'leaf'),'yaw':i*360/7,'pitch':-14,'sway':'leaves'}for i in range(7)}})\nsave('mat',{'body':box([1.25,.07,2.25],(0,.05,0),'teal',.025),'trim':box([1.1,.015,.12],(0,.095,.95),'mint',.007)})\nsave('step',{'top':box([1.7,.2,.7],(0,.26,0),'teal'),'leg':box([.25,.2,.5],(.55,.1,0),'ink',.03),'leg2':box([.25,.2,.5],(-.55,.1,0),'ink',.03)})\nsave('paddleboard',{'hull':ell([1.25,.23,3.5],(0,.06,0),'deck'),'stripe':box([.6,.02,2.4],(0,.19,0),'teal',.008),'stripe2':box([.2,.02,2.5],(.39,.19,0),'coral',.008)})\nsave('buoy',{'base':ell([.65,.6,.65],(0,.25,0),'coral'),'stripe':cyl(.32,.15,(0,.28,0),'deck'),'post':cyl(.04,1.4,(0,.9,0),'ink'),'flag':box([.5,.3,.04],(.25,1.5,0),'yellow',.015)})\nsave('raft',{'deck':box([6.,.22,6.],(0,.1,0),'wood'),'rim':box([6.,.16,.14],(0,.3,2.9),'deck'),'rim2':box([6.,.16,.14],(0,.3,-2.9),'deck'),'rim3':box([.14,.16,6.],(2.9,.3,0),'deck'),'rim4':box([.14,.16,6.],(-2.9,.3,0),'deck')})\nsave('pool',{'rim':tor(.43,.09,(0,.035,0),'teal'),'water':cyl(.38,.025,(0,.025,0),'#8fdde0')})\nsave('shell',{'shell':ell([.43,.33,.38],(0,.18,0),'coral'),'spiral':tor(.11,.04,(.04,.32,.02),'deck'),'feet':ell([.55,.08,.4],(0,.045,0),'yellow'),'eye':part('sphere','ink',(.1,.29,.18),radius=.035),'eye2':part('sphere','ink',(-.1,.29,.18),radius=.035)})\nsave('tray',{'tray':box([1.5,.07,.85],(0,.04,0),'wood'),'rim':box([1.5,.1,.05],(0,.1,.4),'coral')})\nsave('smoothie',{'glass':part('cone','deck',(0,.2,0),radius=.1,radius_end=.15,height=.4),'drink':cyl(.135,.05,(0,.4,0),'pink'),'straw':part('cylinder','yellow',(.05,.55,0),radius=.018,height=.3,roll=15),'umbrella':part('cone','coral',(-.03,.7,0),radius=.16,radius_end=0.,height=.12)})\nsave('floatie',{'ring':tor(.65,.16,(0,.18,0),'coral'),'stripe':tor(.65,.045,(0,.31,0),'yellow')})\nsave('lounge',{'seat':box([.8,.13,1.5],(0,.45,.2),'deck'),'back':{**box([.8,.12,.9],(0,.8,-.7),'teal'),'pitch':-50},'leg1':box([.12,.5,1.1],(-.3,.23,.2),'wood'),'leg2':box([.12,.5,1.1],(.3,.23,.2),'wood')})\nsave('umbrella',{'pole':cyl(.045,3.,(0,1.5,0),'wood'),'canopy':part('cone','coral',(0,3.,0),radius=1.65,radius_end=0.,height=.55),'cap':part('sphere','deck',(0,3.3,0),radius=.09)})\nsave('cabana',{'floor':box([4.,.2,3.],(0,.1,0),'deck'),'roof':part('wedge','sand',(0,2.9,0),size=[4.5,1.,3.5],peak=0),'post1':cyl(.08,2.4,(-1.8,1.4,-1.3),'wood'),'post2':cyl(.08,2.4,(1.8,1.4,-1.3),'wood'),'post3':cyl(.08,2.4,(-1.8,1.4,1.3),'wood'),'post4':cyl(.08,2.4,(1.8,1.4,1.3),'wood'),'bed':box([1.5,.45,2.2],(0,.5,0),'teal'),'pillow':ell([1.1,.3,.5],(0,.85,-.65),'deck')})\nsave('desk',{'front':box([3.,1.,.85],(0,.5,0),'wood'),'counter':box([3.3,.15,1.1],(0,1.05,0),'deck'),'stripe':box([2.8,.16,.025],(0,.63,.44),'teal'),'bell':part('sphere','yellow',(.8,1.2,0),radius=.14)})\nsave('pavilion',{'base':cyl(4.,.16,(0,.08,0),'deck'),'roof':part('cone','teal',(0,3.5,0),radius=4.2,radius_end=.35,height=1.0),**{f'post{i}':cyl(.1,3.,(math.sin(i*math.tau/6)*3.5,1.6,math.cos(i*math.tau/6)*3.5),'deck')for i in range(6)}})\nsave('calendar',{'board':box([3.2,2.2,.18],(0,1.5,0),'deck'),'post1':box([.13,2.5,.13],(-1.3,1.25,0),'wood'),'post2':box([.13,2.5,.13],(1.3,1.25,0),'wood'),**{f'day{i}':box([.43,.55,.06],((i-2)*.53,1.45,.13),'teal',.025)for i in range(5)}})\nsave('clam',{'bottom':ell([2.6,.75,1.7],(0,.45,0),'pink'),'inside':ell([2.4,.2,1.5],(0,.72,0),'coral'),'top':{**ell([2.6,.3,1.7],(0,1.,-.4),'pink'),'pitch':-38},'pearl':part('sphere','deck',(0,.86,.1),radius=.29)})\nsave('flipflop',{'sole':ell([.27,.065,.55],(0,.04,0),'yellow'),'strap1':{**box([.04,.1,.3],(.06,.09,0),'coral',.015),'roll':-35},'strap2':{**box([.04,.1,.3],(-.06,.09,0),'coral',.015),'roll':35}})\nsave('gull',{'body':ell([.6,.42,.8],(0,.32,0),'deck'),'head':part('sphere','deck',(0,.6,.29),radius=.22),'beak':part('cone','yellow',(0,.58,.55),radius=.09,radius_end=0.,height=.24,pitch=90),'eyes':part('sphere','ink',(.15,.64,.4),radius=.035),'eyes2':part('sphere','ink',(-.15,.64,.4),radius=.035),'wing':ell([1.25,.09,.4],(0,.43,0),'deck'),'cap':cyl(.22,.12,(0,.82,.28),'ink')})\nsave('scorecard',{'card':box([.65,.8,.05],(0,1.,0),'deck'),'handle':cyl(.035,.7,(0,.35,0),'wood')})\nsave('lotus',{'lily':ell([1.1,.03,.95],(0,.02,0),'leaf'),**{f'petal{i}':{**ell([.2,.18,.58],(math.sin(i*math.tau/7)*.2,.15,math.cos(i*math.tau/7)*.2),'pink'),'yaw':i*360/7}for i in range(7)},'heart':part('sphere','yellow',(0,.22,0),radius=.11)})\nsave('towels',{'towel1':box([.8,.17,.5],(0,.1,0),'deck'),'towel2':box([.8,.17,.5],(.04,.27,0),'teal'),'towel3':box([.8,.17,.5],(-.02,.44,0),'deck')})\nsave('kettle',{'body':part('sphere','ink',(0,.7,0),radius=.7),'handle':{**tor(.5,.12,(0,1.45,0),'ink'),'pitch':90},'eye1':part('sphere','deck',(.21,.85,.63),radius=.065),'eye2':part('sphere','deck',(-.21,.85,.63),radius=.065)})\nsave('tower',{'deck':box([3.,.25,2.4],(0,4.,0),'deck'),'leg1':box([.22,4.,.22],(-1.2,2.,-.9),'wood'),'leg2':box([.22,4.,.22],(1.2,2.,-.9),'wood'),'leg3':box([.22,4.,.22],(-1.2,2.,.9),'wood'),'leg4':box([.22,4.,.22],(1.2,2.,.9),'wood'),'ladder':box([.65,4.,.1],(1.4,2.,0),'teal'),'board':box([3.4,.11,.65],(2.2,4.2,0),'coral')})\nsave('diving_board',{'base':box([.8,.4,.7],(-1.1,.2,0),'teal'),'spring':tor(.25,.07,(-.8,.6,0),'ink'),'board':box([3.2,.13,.7],(0,.85,0),'coral')})\nsave('small_raft',{'logs':{**cyl(.18,3.,(0,.15,0),'wood'),'pitch':90,'array':{'count':5,'step':[.38,0,0]}},'flagpole':cyl(.03,2.,(.6,1.,-.8),'wood'),'flag':box([.5,.4,.025],(.84,1.8,-.8),'coral',.01)})\nsave('crab',{'body':ell([.55,.2,.35],(0,.18,0),'coral'),'legs':{**box([.65,.04,.05],(0,.08,0),'coral',.015),'array':{'count':3,'step':[0,0,.15]}},'claw1':part('sphere','coral',(.38,.23,.15),radius=.12),'claw2':part('sphere','coral',(-.38,.23,.15),radius=.12)})\nsave('ribbon',{'ring':{**tor(.32,.06,(0,1.,0),'yellow'),'pitch':90},'tail':box([.15,.45,.04],(-.15,.6,0),'coral',.015),'tail2':box([.15,.45,.04],(.15,.6,0),'coral',.015)})\nsave('pip',{'cushion':ell([1.4,.48,1.4],(0,.28,0),'#8ccbdc'),'ring':tor(.58,.06,(0,.48,0),'deck'),'eye1':part('sphere','ink',(.18,.42,.61),radius=.055),'eye2':part('sphere','ink',(-.18,.42,.61),radius=.055),'valve':cyl(.07,.15,(.7,.25,0),'teal')})\n# Island and every activity are separate native rooms, with the same palette.\nsets=['hub','studio','gazebo','boardwalk','tide','channel','pier','tower','bay']\nfor n,name in enumerate(sets):\n yaw,tilt,dist,fov=[(10,38,32,42),(0,12,10,38),(-22,18,11,38),(0,20,12,40),(0,62,13,42),(180,22,11,42),(180,19,11,40),(90,6,15,42),(0,18,12,40)][n]\n text=f'''name = \\\"{name.title()} · Tippy Cay\\\"\nabout = \\\"A small place to stand.\\\"\nentrance = {{ at = [16, 18], facing = \\\"south\\\" }}\n[camera]\nyaw = {float(yaw)}\ntilt = {float(tilt)}\ndistance = {float(dist)}\nfov = {float(fov)}\n[view]\nsky = \\\"{'#eddbd5' if n==8 else '#d6eef6'}\\\"\nexposure = 1.0\nsaturation = 0.95\nbloom = 0.15\nbloom_threshold = 1.3\noutlines_on = \\\"objects\\\"\noutline_px = 1.0\noutline_darken = 0.45\nrim = 0.3\nfog = true\nfog_start = 32.0\nfog_end = 125.0\nwind = 0.5\n\\\"light.sun_elevation\\\" = {24.0 if n in [2,8] else 52.0}\n\\\"light.sun_azimuth\\\" = 160.0\n\\\"light.sun_intensity\\\" = 0.62\n\\\"light.ambient\\\" = 1.15\n\\\"cutaway.height_cut\\\" = false\n\\\"cutaway.front_cut\\\" = false\n\\\"cutaway.fade\\\" = false\n[layout]\norigin = [{n*200-16}.0, 0.0, -12.0]\n[[layout.layer]]\ny = 0\nmap = \\\"\\\"\\\"\n'''\n for z in range(24):text+=''.join('P' if (x,z)==(16,12) else '.' for x in range(32))+'\\\\n'\n text+='\\\"\\\"\\\"\\\\n[layout.legend.\\\\'.\\\\']\\\\n[layout.legend.\\\\'P\\\\']\\\\nmarker = \\\"player\\\"\\\\n'\n def obj(key,pos,shape=None,color=None,assetname=None,scale=None,yaw=None):\n  nonlocal_dummy=None\n  s=f'\\\\n[[object]]\\\\nname = \\\"{key}\\\"\\\\npos = {json.dumps(pos)}\\\\n'\n  if assetname:s+=f'asset = \\\"LIB/core/{assetname}\\\"\\\\n'\n  if shape:s+='shape = '+shape+'\\\\n'\n  if color:s+=f'color = \\\"{color}\\\"\\\\nlook = \\\"cel\\\"\\\\n'\n  if scale:s+=f'scale = {scale}\\\\n'\n  if yaw is not None:s+=f'yaw = {float(yaw)}\\\\n'\n  s+='body = \\\"fixed\\\"\\\\n';return s\n def P(x,y,z):return [x+16,y,z+12]\n text+=obj('sea',P(0,-.2,0),'{ type = \\\"cylinder\\\", half_height = 0.05, radius = 130.0 }','#8fdde0')\n # Floor extends below the water so routed activities never enter swimming posture.\n text+=obj('support',P(0,-.21,-40),'{ type = \\\"box\\\", half = [42.0, 0.15, 100.0] }','#8fdde0')\n if n==0:\n  text+=obj('sand',P(0,-.05,0),'{ type = \\\"cylinder\\\", half_height = 0.2, radius = 25.0 }','#f6e7c8')\n  text+=obj('grass',P(0,.12,0),'{ type = \\\"cylinder\\\", half_height = 0.04, radius = 22.7 }','#bfe6b0')\n  text+=obj('reception_deck',P(0,.19,0),'{ type = \\\"cylinder\\\", half_height = 0.08, radius = 7.0 }','#fbfaf6')\n  text+=obj('path1',P(0,.18,0),'{ type = \\\"box\\\", half = [2.2, 0.04, 20.0] }','#f6e7c8')\n  text+=obj('path2',P(0,.18,0),'{ type = \\\"box\\\", half = [21.0, 0.04, 1.8] }','#f6e7c8')\n  for i,(x,z)in enumerate([(-13,-8),(13,-8),(-13,8),(13,8)]):\n   text+=obj('pavilion'+str(i),P(x,.2,z),assetname='fit_pavilion',scale=.9)\n   text+=obj('mat'+str(i),P(x,.35,z+1.5),assetname='fit_mat')\n  for i,(key,x,z)in enumerate([('fit_desk',0,-2),('fit_clam',3,1),('fit_calendar',-4,-3),('fit_cabana',-6,16),('fit_cabana',0,17),('fit_cabana',6,16),('fit_towels',-2,0)]):text+=obj(key+str(i),P(x,.22,z),assetname=key)\n  for i in range(18):\n   a=i*math.tau/18;text+=obj('palm'+str(i),P(math.sin(a)*22.5,.18,math.cos(a)*22.5),assetname='fit_palm',scale=.7+(i%3)*.15,yaw=i*67)\n  for i,(x,z)in enumerate([(-19,-4),(19,2),(-18,12),(18,-12)]):\n   text+=obj('umbrella'+str(i),P(x,.18,z),assetname='fit_umbrella',scale=.8)\n   text+=obj('lounge'+str(i),P(x+1,.18,z+1),assetname='fit_lounge',scale=.9,yaw=-25)\n  text+=obj('pier',P(15,.22,14),'{ type = \\\"box\\\", half = [2.0, 0.15, 9.0] }','#c99872')\n  text+=obj('rowboat',P(19,0,18),assetname='rowboat')\n else:\n  if n in [1,2,3]:\n   text+=obj('deck',P(0,.03,0),'{ type = \\\"cylinder\\\", half_height = 0.1, radius = 7.2 }','#fbfaf6')\n   text+=obj('edge',P(0,-.03,0),'{ type = \\\"cylinder\\\", half_height = 0.1, radius = 7.45 }','#c99872')\n   for i in range(5):text+=obj('lily'+str(i),P((i-2)*2.4,0.,-8.-(i%2)*1.5),assetname='fit_lotus')\n   for i in [-1,1]:\n    text+=obj('palm'+str(i),P(i*9,0,-4),assetname='fit_palm')\n    text+=obj('lounge'+str(i),P(i*5,.12,-3),assetname='fit_lounge',yaw=-i*35)\n   text+=obj('mat',P(0,.15,0),assetname='fit_mat')\n   if n==2:text+=obj('kettle',P(3,.12,0),assetname='fit_kettle',scale=1.2)\n   if n==3:text+=obj('step',P(0,.15,.1),assetname='fit_step')\n  elif n==4:text+=obj('raft',P(0,.03,0),assetname='fit_raft')\n  elif n==5:\n   for j in range(11):\n    x=math.sin(j*1.7)*2.4\n    for side in [-1,1]:text+=obj(f'buoy{j}_{side}',P(x+side*1.5,0,-j*8.),assetname='fit_buoy')\n  elif n==6:\n   text+=obj('long_pier',P(0,.1,-30),'{ type = \\\"box\\\", half = [2.0, 0.15, 40.0] }','#c99872')\n   for j in range(20):text+=obj('plank'+str(j),P(0,.26,-j*3.5),'{ type = \\\"box\\\", half = [2.0, 0.01, 0.015] }','#f6e7c8')\n  elif n==7:\n   text+=obj('platform',P(-1,-.1,0),'{ type = \\\"box\\\", half = [3.5, 0.2, 3.0] }','#fbfaf6')\n   text+=obj('board',P(0,.05,0),assetname='fit_diving_board')\n   text+=obj('tower',P(-5,0,-3),assetname='fit_tower')\n   for j in range(3):text+=obj('judge'+str(j),P(4,0,(j-1)*2.),assetname='fit_gull',yaw=-90)\n  elif n==8:\n   text+=obj('post',P(0,-.35,0),'{ type = \\\"cylinder\\\", half_height = 0.6, radius = 0.65 }','#c99872')\n   for j in range(9):\n    a=(j+1)*math.tau/10;text+=obj('raft'+str(j),P(math.sin(a)*7.,0,math.cos(a)*7.-2.),assetname='fit_small_raft',yaw=j*36)\n  for j in range(4):text+=obj('distant_palm'+str(j),P((j-1.5)*9,-.3,-22),assetname='fit_palm',scale=.7)\n # Every set has quiet company.\n for i,(x,z)in enumerate([(-4,-2),(4,-3),(-5,2)] if n else [(-2,5),(4,5),(7,1),(-9,14)]):\n  text+=f'\\\\n[[npc]]\\\\nname = \\\"guest_{n}_{i}\\\"\\\\nkind = \\\"biped\\\"\\\\npos = {P(x,.3,z)}\\\\nlook = {{ skin = \\\"#cf946e\\\", shirt = \\\"#faf8ee\\\", pants = \\\"#faf8ee\\\", shoes = \\\"#c99872\\\", scale = 0.9, gear = {{ helm = \\\"hood\\\", helm_color = \\\"#fbfaf6\\\" }} }}\\\\n'\n if n==1:text+='\\\\n[[npc]]\\\\nname = \\\"Posey\\\"\\\\nkind = \\\"biped\\\"\\\\npos = [19.0,0.2,12.0]\\\\nlook = { skin = \\\"#d8b184\\\", shirt = \\\"#d8b184\\\", pants = \\\"#c79f6e\\\", shoes = \\\"#c79f6e\\\", eyes = \\\"#d8b184\\\", scale = 1.05 }\\\\n'\n if n in [0,3]:text+=f'\\\\n[[npc]]\\\\nname = \\\"Bounce\\\"\\\\nkind = \\\"blob\\\"\\\\npos = {P(3,.2,-1)}\\\\nlook = {{ skin = \\\"#eba5bd\\\", shirt = \\\"#eba5bd\\\", scale = 1.2 }}\\\\n'\n (root/'crates/pav_core/src/games/fit/sets'/f'{name}.toml').write_text(text)\nPY\npython3 tools/make-art.py\"","aggregated_output":"","exit_code":0,"status":"completed"}}
