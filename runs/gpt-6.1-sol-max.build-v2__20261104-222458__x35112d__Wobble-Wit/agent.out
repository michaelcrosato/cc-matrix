p=\"comma list of Playwright device names to use instead of the built-in matrix\")\n196:    ap.add_argument(\"--full-page\", action=\"store_true\", help=\"capture the whole scrollable page, not just the viewport\")\n197:    ap.add_argument(\"--dpr1\", action=\"store_true\", help=\"force device pixel ratio 1 (smaller PNGs)\")\n198:    ap.add_argument(\"--wait\", type=int, default=800, help=\"extra ms to wait after load for animations (default 800)\")\n199:    ap.add_argument(\"--timeout\", type=int, default=45, help=\"navigation timeout in seconds (default 45)\")\n200:    ap.add_argument(\"--headed\", action=\"store_true\", help=\"show the browser windows\")\n210:    slot = wait_for_slot()  # noqa: F841 -- the lock is held while this file object stays open\n227:        browsers = {e: await getattr(pw, e).launch(headless=not args.headed) for e in needed}\npub struct CameraRig {\n    /// Target parameters (what the panel edits).\n    pub params: CameraParams,\n    /// Smoothed focus point.\n    pub target: Vec3,\n    initialized: bool,\n    /// Blending from earlier parameters: (from, elapsed, duration).\n    blend: Option<(CameraParams, f32, f32)>,\n}\n\nimpl Default for CameraRig {\n    fn default() -> Self {\n        Self::new(CameraParams::default())\n    }\n}\n\nimpl CameraRig {\n    pub fn new(params: CameraParams) -> Self {\n        Self { params, target: Vec3::ZERO, initialized: false, blend: None }\n    }\n\n    /// Parameters in effect right now (blended while a transition runs).\n    pub fn current(&self) -> CameraParams {\n        match &self.blend {\n            Some((from, e, d)) => {\n                let t = (e / d.max(1e-3)).clamp(0.0, 1.0);\n                from.lerp(&self.params, t * t * (3.0 - 2.0 * t))\n            }\n            None => self.params.clone(),\n        }\n    }\n\n    /// Call before changing `params` to glide there over `seconds` instead of cutting.\n    pub fn blend_from_current(&mut self, seconds: f32) {\n        self.blend = Some((self.current(), 0.0, seconds));\n    }\n\n    /// Follows `focus` with exponential smoothing.\n    pub fn update(&mut self, focus: Vec3, dt: f32) {\n        if let Some(b) = &mut self.blend {\n9:- STYLE100 (embedded): CC-BY-4.0. Credit: 100STYLE, Mason, Starke and Komura.\n10:- STYLE100_BACK … STYLE100_SIDERUN (6 sets, on disk): CC-BY-4.0. Credit: 100STYLE, Mason, Starke and Komura.\n11:- MESH2MOTION (embedded): CC0-1.0. Credit: Mesh2Motion's human animations (mesh2motion.org, CC0 1.0): Quaternius' Universal Animation Library clips as Mesh2Motion re-exported them, clips its contributors animated, and its own motion captures. Each clip's src names which, and orig the Quaternius clip a re-export was made from.\n12:- QUATERNIUS (embedded): CC0-1.0. Credit: Universal Animation Library 1 and 2 by Quaternius (quaternius.com), CC0 1.0 (public domain).\n13:- CMU_01 … CMU_94 (113 sets, on disk): LicenseRef-CMU. Credit: CMU Graphics Lab Motion Capture Database (mocap.cs.cmu.edu), free for all uses; created with funding from NSF EIA-0196217. Terms: CMU Graphics Lab Motion Capture Database (mocap.cs.cmu.edu): free to use, copy, modify and redistribute; the data may not be resold, even in converted form (reviewed 2026-10-15, §14 Q4).\n14:- CMU (embedded): LicenseRef-CMU. Credit: CMU motion capture (free for all uses (may be copied, modified, or redistributed without permission)). Terms: CMU Graphics Lab Motion Capture Database (mocap.cs.cmu.edu): free to use, copy, modify and redistribute; the data may not be resold, even in converted form (reviewed 2026-10-15, §14 Q4).\n20:- LIB/quaternius_medieval_village (on disk): CC0-1.0. Credit: Quaternius (quaternius.com).\n","exit_code":0,"status":"completed"}}
