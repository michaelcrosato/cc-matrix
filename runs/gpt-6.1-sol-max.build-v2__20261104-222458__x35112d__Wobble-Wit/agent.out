{"type":"item.started","item":{"id":"item_70","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('engine/crates/pav_core/src/games/fit/events/mod.rs');s=p.read_text().replace('    pub last_signal:i32,','    pub song_anchor:Option<f32>,pub song_last:f32,\\\\n    pub last_signal:i32,').replace('last_signal:-1,ready_target:','song_anchor:None,song_last:0.,last_signal:-1,ready_target:');s=s.replace('let rhythm_t=if self.kind==Kind::Finale{t}else{i.song_pos.unwrap_or(t)};','''let rhythm_t=if self.kind==Kind::Finale{t}else if let Some(pos)=i.song_pos{if self.song_anchor.is_none()||pos<self.song_last{self.song_anchor=Some(pos-t);}self.song_last=pos;pos-self.song_anchor.unwrap_or(0.)}else{t};''');p.write_text(s)\np=Path('engine/crates/pav_core/src/games/fit/mod.rs');s=p.read_text();s=s.replace('pub show_trace:bool,pub trace:','pub show_trace:bool,pub ghost_lanes:bool,pub free_camera:bool,pub engine_stats:bool,pub trace:');s=s.replace('show_trace:false,trace:','show_trace:false,ghost_lanes:true,free_camera:false,engine_stats:false,trace:')\ns=s.replace('        self.countdown=3.;self.set=kind.set();','''        if self.hub.active && self.hub.seat>0 {let idx=(self.hub.seat as usize-1)*3+self.hub.round as usize;if let Some(run)=self.hub.runs.get(idx){self.event.best_ghost=run.clone();}}\n        self.countdown=3.;self.set=kind.set();''')\ns=s.replace('let unlocked=n==0||self.profile.total_minutes>=n as u32*4||n==7&&self.profile.flipflops.len()==5;','let unlocked=if n==7{self.profile.flipflops.len()==5}else{n==0||self.profile.total_minutes>=n as u32*4};')\ns=s.replace('for it in &mut a{it.detail=if self.show_trace{\\\"On\\\"}else{\\\"Off\\\"}.into();}','for(n,it)in a.iter_mut().enumerate(){it.detail=if [self.show_trace,self.ghost_lanes,self.free_camera,self.engine_stats][n]{\\\"On\\\"}else{\\\"Off\\\"}.into();}')\ns=s.replace('_=>{self.show_trace=\"'!self.show_trace;}'\"','_=>{match id{0=>self.show_trace=\"'!self.show_trace,1=>self.ghost_lanes=!self.ghost_lanes,2=>self.free_camera=!self.free_camera,3=>self.engine_stats=!self.engine_stats,_=>{}}}'\"')\ns=s.replace('\\\"timeScale\\\":self.time_scale,','\\\"timeScale\\\":self.time_scale,\\\"ghostLanes\\\":self.ghost_lanes,')\ns=s.replace('pub fn ui(&self,_sim:&Sim)->UiFrame','pub fn ui(&self,sim:&Sim)->UiFrame').replace('debug:self.show_trace,player_name:','debug:self.show_trace,free_camera:self.free_camera,stats:self.engine_stats,entities:sim.state.entities.iter().count()as u32,tick:sim.state.tick,key_rate:self.rules.key_rate,key_return:self.rules.key_return,stick_curve:self.rules.stick_curve,rhythm_offset:self.save.settings.rhythm,player_name:')\ns=s.replace('                world::animate(sim,&self.event,&mut self.props,self.set,dt*self.time_scale);','''                world::animate(sim,&self.event,&mut self.props,self.set,dt*self.time_scale);\n                if \"'!self.ghost_lanes {if let Some(id)=self.props.ghost{sim.set_position(id,world::origin(self.set)-Vec3::Y*35.);}}'\"''')\n# Copy loaded profiles defensively; all save slots remain schema-versioned.\ns=s.replace('self.profile=p;}self.look_skin','self.profile=p;self.profile.day=self.profile.day.clamp(1,5);self.profile.skin=self.profile.skin.min(5);self.profile.outfit=self.profile.outfit.min(7);self.profile.bests.resize(13,meta::Best::default());}self.look_skin')\np.write_text(s)\np=Path('engine/crates/pav_core/src/games/fit/ui_model.rs');s=p.read_text().replace('pub struct UiFrame {','pub struct UiFrame {\\\\n    pub free_camera:bool,pub stats:bool,pub entities:u32,pub tick:u64,pub key_rate:f32,pub key_return:f32,pub stick_curve:f32,pub rhythm_offset:f32,');p.write_text(s)\np=Path('engine/crates/pav_app/src/input.rs');s=p.read_text().replace('pub fn fit_frame(&mut self,dt:f32,size:Vec2)','pub fn fit_frame(&mut self,dt:f32,size:Vec2,rates:(f32,f32,f32))').replace('false,1.6,1.2);','false,rates.0,rates.1);').replace('is(ShiftLeft)||is(ShiftRight),1.6,1.2);','is(ShiftLeft)||is(ShiftRight),rates.0,rates.1);').replace('1=>self.pad.left,2=>','1=>self.pad.left.normalize_or_zero()*self.pad.left.length().powf(rates.2/1.5),2=>');p.write_text(s)\np=Path('engine/crates/pav_app/src/app.rs');s=p.read_text().replace('Some(self.input.fit_frame(dt,size))','Some(self.input.fit_frame(dt,size,curr.hud.fit.as_ref().map(|f|(f.key_rate,f.key_return,f.stick_curve)).unwrap_or((1.6,1.2,1.5))))').replace('i.song_pos=Some(pav_audio::song_position(audio.sample_rate as f32));','i.song_pos=Some(pav_audio::song_position(audio.sample_rate as f32)-curr.hud.fit.as_ref().map(|f|f.rhythm_offset).unwrap_or(0.1));');s=s.replace('        self.rig.update(focus, dt);','''        if curr.hud.fit.as_ref().is_some_and(|f|f.free_camera) {let r=self.input.pad.right;self.rig.params.yaw+=r.x*90.*dt;self.rig.params.tilt=(self.rig.params.tilt-r.y*60.*dt).clamp(0.,85.);}\n        self.rig.update(focus, dt);''',1)\np.write_text(s)\np=Path('engine/crates/pav_ui/src/fit_ui.rs');s=p.read_text().replace(' if u.debug{c.text',' if u.stats{c.text(1260.,365.,&format\"'!(\"{} OBJECTS · TICK {}\",u.entities,u.tick),34.,INK,false);}'\"\\\\n if u.free_camera{c.text(1260.,415.,\\\"FREE CAMERA · RIGHT STICK\\\",29.,TEAL,false);}\\\\n if u.debug{c.text');p.write_text(s)\nPY\ncat >> engine/crates/pav_audio/src/lib.rs <<'EOF'\n\n#[cfg(test)]mod fit_tests {\n use super::*;\n fn rms(a:&[f32])->f32{(a.iter().map(|x|x*x).sum::<f32>()/a.len()as f32).sqrt()}\n #[test]fn every_resort_sound_and_speaker_is_non_silent(){for id in 0..32{let mut m=Mixer::new(48000.);for(p,d)in voice::sfx(id,1.,1.){m.play(p,0.,1.,d);}let mut out=vec\"'![0.;48000];m.render(&mut out);assert!(rms(&out)>0.0001,\"SFX {id}\");}let mut signature=vec![];for speaker in 0..5{let mut m=Mixer::new(48000.);m.play(voice::syllable(speaker,0,1.),0.,1.,0.);let mut out=vec![0.;12000];m.render(&mut out);let level=rms(&out);assert!(level>0.0001);signature.push(level);}assert!(signature.windows(2).all(|v|(v[0]-v[1]).abs()>0.00001));}\n #[test]fn arrangements_sound_and_music_bus_is_ten_percent(){for song in 1..=7{let mut m=Mixer::new(48000.);m.music.set(song);let mut a=vec![0.;96000];m.render(&mut a);assert!(rms(&a)>0.0001,\"song {song}\");}let mut quiet=Mixer::new(48000.);let mut full=Mixer::new(48000.);quiet.music.set(1);full.music.set(1);full.gains[1]=1.;let mut a=vec![0.;48000];let mut b=vec![0.;48000];quiet.render(&mut a);full.render(&mut b);let ratio=rms(&a)/rms(&b);assert!((ratio-0.1).abs()<0.005,\"ratio {ratio}\");}\n}\nEOF\ncat >> notes/decisions.md <<'\"'EOF'\n- Every prop's rounded radius is clamped to its thinnest half extent; native asset schema validation caught invalid radii before packaging.\n- Squat rest periods only earn points after an actual descent; Tray Trek has a readable slow tray drift that requires counterbalance. Both now distinguish active play from idle.\n- Rhythm input anchors to the synthesizer's sample position, rebasing after a track restarts so pausing cannot desynchronise notes.\nEOF\ncat >> ../PROGRESS.md <<'EOF'\n- Core app compiles. Every activity passes the 5-seed bot/idle/careless score test after squat/tray tuning.\n- Runtime prop schema checks caught excessive rounded radii after category fix; all generated radii clamped, next full core run underway.\n- First wasm distribution build is compiling dependencies. Browser and Hub suites and README are written.\n- Added sample-clock rhythm anchoring, actual dev view toggles, live input tuning, defensive save load and previous-seat medley ghosts.\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
