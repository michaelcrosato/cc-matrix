.)as i32),0.5);}')\ns=s.replace('        if self.kind==Kind::Finale {\\\\n            let phase=', '''        if self.kind==Kind::Lap {self.score=self.score.saturating_sub(self.misses*12);}\n        if self.kind==Kind::Paddle {self.score=((72.-(self.time+self.misses as f32*2.+self.core.tips as f32*2.))/36.*1000.).clamp(0.,1000.)as u32;}\n        if self.kind==Kind::Finale {\n            let phase=''')\np.write_text(s)\np=Path('engine/crates/pav_core/src/games/fit/mod.rs');s=p.read_text().replace('self.event=Event::new(kind,phases);if self.profile.day>=3','self.event=Event::new(kind,phases);if kind==Kind::Pose&&self.profile.day>1{self.event.phase=3;}if self.profile.day>=3').replace('Some((-self.event.progress*360.).rem_euclid(360.))','Some((self.event.progress*360.-90.).rem_euclid(360.))');p.write_text(s)\np=Path('engine/crates/pav_core/src/games/fit/world.rs');s=p.read_text().replace('[\\\"FIT/Tree\\\",\\\"FIT/Warrior\\\",\\\"FIT/Lighthouse\\\"][(t/20.)as usize%3]','[\\\"FIT/Tree\\\",\\\"FIT/Warrior\\\",\\\"FIT/Lighthouse\\\",\\\"FIT/DeckChair\\\",\\\"FIT/Bridge\\\",\\\"FIT/Seated\\\"][((t/20.)as usize+if e.kind==Kind::Pose{e.phase as usize}else{0})%6]');s=s.replace('let ph=angle+(n as f32+1.)*0.23;sim.set_position(*id,o+Vec3::new(ph.sin()*14.,0.2,ph.cos()*14.));','let ph=(n as f32+0.5)*std::f32::consts::TAU/6.;let radius=14.+(n as f32*1.6+e.core.phase[0]).sin()*0.8;sim.set_position(*id,o+Vec3::new(ph.sin()*radius,0.2,ph.cos()*radius));');s=s.replace('let ph=angle+(n as f32+1.)*0.35;sim.set_position(*id,o+Vec3::new(ph.sin()*14.7,0.25,ph.cos()*14.7));','let fraction=(n as f32+0.25)/6.;let ph=fraction*std::f32::consts::TAU;let radius=14.+(fraction*90.*0.38).sin()*0.85;sim.set_position(*id,o+Vec3::new(ph.sin()*radius,0.25,ph.cos()*radius));');p.write_text(s)\nfor name in ['channel','pier']:\n p=Path(f'engine/crates/pav_core/src/games/fit/sets/{name}.toml');s=p.read_text().replace('yaw = 180.0','yaw = 0.0',1);p.write_text(s)\np=Path('engine/crates/pav_ui/src/fit_ui.rs')