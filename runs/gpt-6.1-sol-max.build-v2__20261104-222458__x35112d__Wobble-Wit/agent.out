{"type":"item.started","item":{"id":"item_91","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('tests/browser.py');s=p.read_text().replace(\\\"p.wait_for_function('JSON.parse(__gameStatus).focus===1',timeout=15000)\\\",\\\"p.wait_for_function('JSON.parse(__gameStatus).focus===1',timeout=30000)\\\")\ns=s.replace(\\\"p.evaluate('__setPad([0,0,0,0],[13])');p.wait_for_timeout(200);p.evaluate('__setPad([0,0,0,0],[])');p.wait_for_function('JSON.parse(__gameStatus).device===1',timeout=15000);\\\", \\\"p.evaluate('__setPad([0,0,0,0],[13])');p.wait_for_function('JSON.parse(__gameStatus).device===1&&JSON.parse(__gameStatus).focus===1',timeout=45000);p.evaluate('__setPad([0,0,0,0],[])');\\\")\ns=s.replace(\\\"p.evaluate('__setPad([0,0,0,0],[0])');p.wait_for_timeout(200);p.evaluate('__setPad([0,0,0,0],[])');wait_screen(p,'Pass');\\\", \\\"p.evaluate('__setPad([0,0,0,0],[0])');wait_screen(p,'Pass');p.evaluate('__setPad([0,0,0,0],[])');\\\")\ns=s.replace(\\\"p.keyboard.press('ArrowUp');p.wait_for_timeout(150)\\\",\\\"p.keyboard.press('ArrowUp');p.wait_for_function('JSON.parse(__gameStatus).focus===0',timeout=30000)\\\")\ns=s.replace(\\\"for _ in range(7):p.keyboard.press('Space');p.wait_for_timeout(120)\\\",\\\"for _ in range(7):\\\\n   before=status(p)['tick'];p.keyboard.press('Space');p.wait_for_function('(n)=>JSON.parse(__gameStatus).tick>n',arg=before,timeout=30000)\\\")\ns=s.replace(\\\"timeout=45000);check(True,'attract starts\\\", \\\"timeout=120000);check(True,'attract starts\\\")\np.write_text(s)\np=Path('engine/crates/pav_app/src/app.rs');s=p.read_text().replace('self.gfx.as_ref().unwrap().window.set_cursor_visible(self.input.fit_device\"'!=1);'\"','self.gfx.as_ref().unwrap().window.set_cursor_visible(curr.hud.fit.as_ref().is_none_or(|f|f.device\"'!=1));'\"');needle='fi.held&=\"'!(pav_core::input::buttons::CONFIRM|pav_core::input::buttons::STEP_L);'\"';s=s.replace(needle,needle+'if fi.just(pav_core::input::buttons::STEP_R){fi.pressed|=pav_core::input::buttons::BACK;}');p.write_text(s)\n# A compact, visible checkout shot uses the resort's actual rowboat.\np=Path('engine/crates/pav_core/src/games/fit/mod.rs');s=p.read_text().replace('self.save_change();self.change(Screen::Ending);','self.save_change();self.set=0;world::checkout(sim,self.profile.age<=40);self.change(Screen::Ending);',1)\nold='fn start_demo(&mut self,sim:&mut Sim){self.demo=true;self.demo_index=0;self.demo_time=0.;self.start_event(Kind::Dive,sim);self.change(Screen::Event);}'\nnew='fn start_demo(&mut self,sim:&mut Sim){self.demo=true;self.demo_index=0;self.demo_time=0.;self.to_hub(sim);}'\nassert old in s;s=s.replace(old,new)\nold='''if self.demo {self.demo_time+=dt;let order=[Kind::Dive,Kind::Paddle,Kind::Step,Kind::Pose,Kind::Tide,Kind::Spin,Kind::Tray,Kind::Plank,Kind::Lap,Kind::Finale];if self.demo_time>15.{self.demo_time=0.;self.demo_index=(self.demo_index+1)%order.len();self.start_event(order[self.demo_index],sim);if order[self.demo_index]==Kind::Finale{self.event.time=92.;}self.change(Screen::Event);}}'''\nnew='''if self.demo {self.demo_time+=dt;let order=[Kind::Dive,Kind::Paddle,Kind::Step,Kind::Pose,Kind::Tide,Kind::Spin,Kind::Tray,Kind::Plank,Kind::Lap,Kind::Finale];let length=if self.demo_index==0{8.}else if self.demo_index==11{5.}else{15.};if self.demo_time>length{self.demo_time=0.;self.demo_index=(self.demo_index+1)%12;if self.demo_index==0{self.to_hub(sim);}else if self.demo_index==11{self.set=0;world::set(sim,0);self.change(Screen::Title);}else{let kind=order[self.demo_index-1];self.start_event(kind,sim);if kind==Kind::Finale{self.event.time=92.;}self.change(Screen::Event);}}}'''\nassert old in s;s=s.replace(old,new);p.write_text(s)\np=Path('engine/crates/pav_core/src/games/fit/world.rs');s=p.read_text();s+='''\npub fn checkout(sim:&mut Sim,won:bool){set(sim,0);if let Some(pid)=sim.state.player{sim.set_position(pid,if won{Vec3::new(19.,0.7,18.)}else{Vec3::new(-6.,0.4,16.)});}let mut set=BTreeMap::new();set.insert(\\\"yaw\\\".into(),ParamValue::Float(25.));set.insert(\\\"tilt\\\".into(),ParamValue::Float(22.));set.insert(\\\"distance\\\".into(),ParamValue::Float(10.));sim.state.courses.sticky_cue=Some(Arc::new(CameraCue{set,sweep:vec\"'![],flip_ortho:0.}));sim.state.courses.cue_serial+=1;}\n'\"''';s=s.replace('use std::sync::Arc;','use std::{sync::Arc,collections::BTreeMap};').replace('entity::EntityId,','entity::EntityId,params::ParamValue,zones::CameraCue,');p.write_text(s)\n# Bake the tray-arm layer into native Balance_Walk keys, preserving its credit.\nimport json,copy\np=Path('engine/anim/fit.json');d=json.loads(p.read_text());style=json.loads(Path('engine/anim/style100.json').read_text());clip=copy.deepcopy(style['clips']['Balance_Walk']);clip['clip']='TrayWalk';clip['desc']='Balance walk carrying the smoothie tray.'\nfor k in clip['keys']:k['armL']=[60,20,-50,80,0];k['armR']=[60,20,-50,80,0]\nd['clips']['TrayWalk']=clip;d['credit']+=' TrayWalk adapted from 100STYLE, Mason, Starke and Komura (CC-BY-4.0).';p.write_text(json.dumps(d,indent=2))\np=Path('engine/crates/pav_core/src/games/fit/world.rs');s=p.read_text().replace('Kind::Tray=>\\\"STYLE100/Balance_Walk\\\"','Kind::Tray=>\\\"FIT/TrayWalk\\\"').replace('Kind::Dive=>e.dive_tuck,_=>t%2.','Kind::Dive=>e.dive_tuck,Kind::Tray=>t%2.2,_=>t%2.');p.write_text(s)\nPY\ncat >> ../PROGRESS.md <<'EOF'\n- First 1080p native title and Pose Parade captures inspected: cohesive pastel island, legible large UI, clear puppet pose and balance Puck.\n- Native CLI bot also reaches credits in 1122.48 sim-seconds (1/1 win); the core suite previously passed 18 checks.\n- Browser pad test exposed software-rendering stalls that swallowed fixed 200 ms simulated holds. Direct standard Gamepad polling is in place; tests now wait for acknowledged input before release.\n- Added actual checkout rowboat/cabana framing, the full island/event/title attract loop, live dev input rates, and a native tray-walk composite with 100STYLE attribution.\nEOF\n./tools/build.sh > build-web.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
