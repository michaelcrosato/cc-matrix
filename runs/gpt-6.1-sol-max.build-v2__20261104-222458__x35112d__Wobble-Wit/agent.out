e(name) => {\ncrates/pav_app/src/app.rs:2045:                if self.hud.current.is_some() {\ncrates/pav_app/src/app.rs:2061:                self.hud.show_card();\ncrates/pav_app/src/app.rs:2099:    fn resume_audio(&mut self) {\ncrates/pav_app/src/app.rs:2163:                self.resume_audio();\ncrates/pav_app/src/app.rs:2201:                self.resume_audio();\ncrates/pav_app/src/app.rs:2225:                    self.input.last_device = Device::KeyboardMouse;\ncrates/pav_app/src/settings.rs:14:    /// Scene to start in (empty = Shardfall's town; `world` = the pavilion). Command line:\ncrates/pav_app/src/settings.rs:16:    pub scene: String,\ncrates/pav_app/src/settings.rs:43:            scene: String::new(),\n","exit_code":0,"status":"completed"}}
