,55], \"Monk_Walk\": [12,64], \"Morris_Walk\": [14,195], \"Neutral_Walk\": [7,64], \"Old_Walk\": [8,37], \"OnHeels_Walk\": [15,98], \"OnPhoneLeft_Walk\": [12,98], \"OnPhoneRight_Walk\": [12,90], \"OnToesBentForward_Walk\": [7,48], \"OnToesCrouched_Walk\": [9,31], \"PendulumHands_Walk\": [8,33], \"Penguin_Walk\": [14,72], \"PigeonToed_Walk\": [7,39], \"Proud_Walk\": [8,63], \"Punch_Walk\": [10,73], \"Quail_Walk\": [7,27], \"RaisedLeftArm_Walk\": [7,72], \"RaisedRightArm_Walk\": [8,63], \"RightHop_Walk\": [10,48], \"Roadrunner_Walk\": [12,124], \"Robot_Walk\": [6,24], \"Rocket_Walk\": [10,60], \"Rushed_Walk\": [34,171], \"ShieldedLeft_Walk\": [10,58], \"ShieldedRight_Walk\": [10,81], \"Skip_Walk\": [14,124], \"SlideFeet_Walk\": [7,37], \"Star_Walk\": [9,40], \"StartStop_Walk\": [9,37], \"Stiff_Walk\": [8,44], \"Strutting_Walk\": [8,67], \"Superman_Walk\": [9,42], \"Swat_Walk\": [9,67], \"Sweep_Walk\": [13,59], \"Swimming_Walk\": [18,110], \"SwingArmsRound_Walk\": [40,395], \"SwingShoulders_Walk\": [10,51], \"Teapot_Walk\": [12,82], \"Tiptoe_Walk\": [6,74], \"TogetherStep_Walk\": [8,50], \"TwoFootJump_Walk\": [11,49], \"WalkingStickLeft_Walk\": [10,79], \"WalkingStickRight_Walk\": [10,83], \"Waving_Walk\": [14,130], \"WhirlArms_Walk\": [11,75], \"WideLegs_Walk\": [21,157], \"WiggleHips_Walk\": [28,158], \"WildArms_Walk\": [9,72], \"WildLegs_Walk\": [71,546], \"Zombie_Walk\": [8,48]},\nengine/anim/style100.json:516:\"Balance_Walk\": {\"clip\": \"Balance_Walk\", \"src\": \"100STYLE\", \"take\": \"Balance_FW 18.93-21.12\", \"dur\": 2.2, \"loop\": true, \"speed\": 36, \"tags\": [\"walk\",\"style\"], \"desc\": \"Arms out to side for balance - tilting side to side\", \"keys\": [\nengine/anim/catalogs/100style.json:18:  \"Balance_Walk\": [\"Balance_FW\", null, null, 0.8],\n19:        None => \"none\",\n38:        None => \"none\",\n82:    pub enum HelmKind {\n84:        None => \"none\",\n85:        Cap => \"cap\",\n88:        Crown => \"crown\",\n90:        Halo => \"halo\",\n92:        Hood => \"hood\",\n1329:            HelmKind::Cap => push(head + hu * hr * 0.3, head + hu * hr * 0.3, hr * 0.9, hr * 0.9, hc),\n1330:            HelmKind::Hood => {\n1335:            HelmKind::Crown => {\n1503:        WeaponKind::None => 0.0,\n1531:        WeaponKind::None => {}\n1580:        OffhandKind::None => {}\n11:pub enum ParamValue {\n    sim.state.focus = Vec3::new(0.0, 0.0, 1.0);\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"cat > engine/crates/pav_core/src/games/fit/world.rs <<'EOF'\nuse std::{sync::Arc,collections::BTreeMap};\nuse anyhow::{Result,anyhow};use glam::{Vec2,Vec3,Quat};use serde::{Serialize,Deserialize};\nuse crate::{sim::Sim,room::RoomDef,world::{RoomSlot,World},level::Placement,entity::EntityId,puppet::{PuppetDef,BodyPlan,HelmKind},params::ParamValue,zones::CameraCue,input::{InputFrame,buttons as b},frame::SimEvent};\nuse super::{FitGame,Screen,events::{Event,Kind},meta::{Guest,SKINS,OUTFITS}};\nconst SETS:[(&str,&str);9]=[(\\\"hub\\\",include_str\"'!(\"sets/hub.toml\")),(\"studio\",include_str!(\"sets/studio.toml\")),(\"gazebo\",include_str!(\"sets/gazebo.toml\")),(\"boardwalk\",include_str!(\"sets/boardwalk.toml\")),(\"tide\",include_str!(\"sets/tide.toml\")),(\"channel\",include_str!(\"sets/channel.toml\")),(\"pier\",include_str!(\"sets/pier.toml\")),(\"tower\",include_str!(\"sets/tower.toml\")),(\"bay\",include_str!(\"sets/bay.toml\"))];\npub const INTERACTIONS:[(&str,f32,f32);13]=[(\"Pip · morning check\",0.,-1.),(\"Minute Clam\",3.,1.),(\"Stillness Studio\",-13.,-8.),(\"Iron Gazebo\",13.,-8.),(\"Boardwalk\",-13.,8.),(\"Lagoon\",13.,8.),(\"Your cabana · end day\",-6.,16.),(\"Marjorie\",-2.,5.),(\"Two-Towel Tom\",4.,5.),(\"The Twins\",7.,1.),(\"Calendar\",-4.,-3.),(\"Wardrobe\",-2.,0.),(\"Rowboat · checkout\",19.,18.)];\npub const FLOPS:[(f32,f32);5]=[(-21.,-3.),(19.,-12.),(-17.,14.),(10.,18.),(1.,-21.)];\n#[derive(Clone,Debug,Default,Serialize,Deserialize)]\npub struct Actors {pub rings:Vec<EntityId>,pub shells:Vec<EntityId>,pub pools:Vec<EntityId>,pub glasses:Vec<EntityId>,pub paddle:Option<EntityId>,pub tray:Option<EntityId>,pub gull:Option<EntityId>,pub pip:Option<EntityId>,pub ghost:Option<EntityId>,pub flops:Vec<EntityId>,pub obstacle:Vec<EntityId>,pub ribbons:Vec<EntityId>}\npub fn origin(set:usize)->Vec3{Vec3::new(set as f32*200.,0.,0.)}\nfn prop(sim:&mut Sim,name:&str,at:Vec3,scale:f32)->Result<EntityId>{sim.spawn_prop(&format!(\"LIB/core/fit_{name}\"),at,Quat::IDENTITY,scale,false,None).map_err(|e|anyhow!(e))}\npub fn build(sim:&mut Sim)->Result<Actors>{\n    let mut rooms=vec![];for(i,(name,text))in SETS.iter().enumerate(){let def=RoomDef::parse(&super::super::level_text(&format!(\"fit/sets/{name}\"),text)).map_err(|e|anyhow!(\"{name}: {e}\"))?;let place=Placement::new(def.layout.origin,0);let(cols,rows)=def.layout.extent();let(min,max)=place.aabb(Vec3::new(0.,-1.,0.),Vec3::new(cols as f32,10.,rows as f32));rooms.push(RoomSlot{id:i as u16,key:format!(\"fit/{name}\"),inside:origin(i),outside:origin(i),inward:Vec3::Z,built:false,min,max,place,def:Arc::new(def)});}\n    sim.state.world=World{enabled:false,rooms,current_room:Some(0),..Default::default()};for i in 0..9{sim.build_room(i);}\n    sim.state.spawn=Vec3::new(0.,.3,4.);sim.spawn_player();\n    sim.config.movement.speed=4.2;\n    let mut a=Actors::default();let hidden=Vec3::new(0.,-30.,0.);\n    for _ in 0..7 {a.rings.push(prop(sim,\"floatie\",hidden,1.)?);a.shells.push(prop(sim,\"shell\",hidden,1.)?);}\n    for _ in 0..3 {a.pools.push(prop(sim,\"pool\",hidden,1.)?);}\n    for _ in 0..5 {a.glasses.push(prop(sim,\"smoothie\",hidden,1.)?);}\n    a.paddle=Some(prop(sim,\"paddleboard\",hidden,1.)?);a.tray=Some(prop(sim,\"tray\",hidden,1.)?);a.gull=Some(prop(sim,\"gull\",hidden,0.7)?);a.pip=Some(prop(sim,\"pip\",Vec3::new(0.,.3,-.6),1.)?);\n    for(x,z)in FLOPS{a.flops.push(prop(sim,\"flipflop\",Vec3::new(x,.23,z),1.4)?);}\n    for _ in 0..6{a.obstacle.push(prop(sim,\"crab\",hidden,1.3)?);a.ribbons.push(prop(sim,\"ribbon\",hidden,1.)?);}\n    let mut look=PuppetDef::preset(BodyPlan::Biped);look.skin=\"#8ccbdc\".into();look.shirt=\"#8ccbdc\".into();look.pants=\"#a4d6c9\".into();look.shoes=\"#78bcbd\".into();look.scale=.98;\n    a.ghost=Some(sim.spawn_npc(\"Yesterday You\",hidden,0.,look,None,None));\n    guest_look(sim,&Guest::default());set(sim,0);Ok(a)\n}\npub fn set(sim:&mut Sim,n:usize){sim.state.world.current_room=Some(n as u16);if let Some(pid)=sim.state.player{sim.set_position(pid,origin(n)+if n==0{Vec3::new(0.,.3,4.)}else{Vec3::new(0.,.3,0.)});}sim.state.courses.sticky_cue=None;sim.state.courses.cue_serial+=1;}\npub fn guest_look(sim:&mut Sim,g:&Guest){if let Some(pid)=sim.state.player{if let Some(ch)=sim.state.entities.get_mut(pid).and_then(|e|e.character.as_mut()){\n    let mut look=PuppetDef::default();look.skin=SKINS[(g.skin as usize).min(5)].into();look.shirt=OUTFITS[(g.outfit as usize).min(7)].1.into();look.pants=\"#f6eee0\".into();look.shoes=if g.flipflops.len()==5||g.gear==7{\"#ffd166\"}else{\"#d0aa87\"}.into();look.eyes=\"#263e54\".into();look.scale=1.05;\n    look.gear.helm=match g.gear {1=>HelmKind::Cap,2=>HelmKind::Hood,3=>HelmKind::Crown,4=>HelmKind::Halo,_=>HelmKind::None};look.gear.helm_color=if g.gear==2{\"#fbfaf6\"}else{\"#ffd166\"}.into();if g.gear==5{look.gear.gloves=\"#ff887c\".into();}if g.gear==6{look.gear.pauldrons=0.8;look.gear.armor_color=\"#ff887c\".into();}ch.puppet=Some(Arc::new(look));\n}}}\nfn move_obj(sim:&mut Sim,id:Option<EntityId>,p:Vec3){if let Some(id)=id{sim.set_position(id,p);}}\npub fn animate(sim:&mut Sim,e:&Event,a:&mut Actors,set:usize,_dt:f32){\n    let o=origin(set);let t=e.time;let k=e.effective().0;let mut at=o+Vec3::new(0.,.22,0.);let hidden=o-Vec3::Y*35.;\n    if k==Kind::Paddle{at+=Vec3::new(e.side,0.,-e.progress*72.);move_obj(sim,a.paddle,at-Vec3::Y*.08);}\n    else {move_obj(sim,a.paddle,hidden);}\n    if k==Kind::Tray{at.z-=e.progress*60.;move_obj(sim,a.tray,at+Vec3::new(0.,1.2,.5));for(n,id)in a.glasses.iter().enumerate(){let p=e.glasses[n].0;sim.set_position(*id,if p.length()<1.{at+Vec3::new(p.x,1.3,.5+p.y)}else{hidden});}}\n    else {move_obj(sim,a.tray,hidden);for id in &a.glasses{sim.set_position(*id,hidden);}}\n    if k==Kind::Dive {at+=Vec3::new(if e.dive_presses>=4{(t-e.phase_start).min(3.)*0.6}else{0.},.8+e.dive_y.max(-.7),0.);}\n    if k==Kind::Tide{at=o+Vec3::new(0.,.38,0.);for(n,id)in a.shells.iter().enumerate(){let p=e.shells.get(n).filter(|s|!s.potted).map(|s|o+Vec3::new(s.p.x,.25,s.p.y)).unwrap_or(hidden);sim.set_position(*id,p);}for(n,id)in a.pools.iter().enumerate(){let p=e.pools[n];sim.set_position(*id,o+Vec3::new(p.x,.24,p.y));}}\n    else{for id in a.shells.iter().chain(&a.pools){sim.set_position(*id,hidden);}}\n    for(n,id)in a.rings.iter().enumerate(){sim.set_position(*id,if k==Kind::Spin&&n<e.rings as usize{at+Vec3::Y*(.65+n as f32*.15)}else{hidden});}\n    move_obj(sim,a.gull,if k==Kind::Pose&&(32.0..37.0).contains(&t){at+Vec3::Y*1.8}else{hidden});\n    if k==Kind::Lap{let angle=e.progress*std::f32::consts::TAU;at=o+Vec3::new(angle.sin()*(14.+e.side),.23,angle.cos()*(14.+e.side));for(n,id)in a.obstacle.iter().enumerate(){let ph=angle+(n as f32+1.)*.23;sim.set_position(*id,o+Vec3::new(ph.sin()*14.,.2,ph.cos()*14.));}for(n,id)in a.ribbons.iter().enumerate(){let ph=angle+(n as f32+1.)*.35;sim.set_position(*id,o+Vec3::new(ph.sin()*14.7,.25,ph.cos()*14.7));}}\n    else{for id in a.obstacle.iter().chain(&a.ribbons){sim.set_position(*id,hidden);}}\n    if let Some(pid)=sim.state.player{sim.set_position(pid,at);if let Some(ch)=sim.state.entities.get_mut(pid).and_then(|e|e.character.as_mut()){\n        ch.anim.tilt_side=e.core.cob.x*14.0_f32.to_radians();ch.anim.tilt_fwd=-e.core.cob.y*14.0_f32.to_radians();\n        ch.facing=if matches!(k,Kind::Paddle|Kind::Tray){std::f32::consts::PI}else if k==Kind::Lap{e.progress*std::f32::consts::TAU+std::f32::consts::FRAC_PI_2}else{0.};ch.anim.facing=ch.facing;\n        let clip=match k {Kind::Breath=>\"FIT/Breath\",Kind::Pose=>[\"FIT/Tree\",\"FIT/Warrior\",\"FIT/Lighthouse\"][(t/20.)as usize%3],Kind::Squat=>\"FIT/Squat\",Kind::Plank=>if e.collapsed{\"FIT/Flop\"}else{\"FIT/Plank\"},Kind::Spin=>\"FIT/HipCircle\",Kind::Step=>if(t*3.2)as u32%2==0{\"FIT/StepL\"}else{\"FIT/StepR\"},Kind::Lap=>\"MESH2MOTION/Jog\",Kind::Tray=>\"STYLE100/Balance_Walk\",Kind::Dive=>if e.dive_presses>=4{\"FIT/Tuck\"}else{\"FIT/Squat\"},_=>\"FIT/Breath\"};\n        ch.anim.play_clip(crate::clips::find_cached(clip),0,0.000001);ch.anim.clip_t=match k{Kind::Breath=>e.lungs,Kind::Squat=>e.lungs,Kind::Dive=>e.dive_tuck,_=>t%2.};ch.anim.clip_w=1.;\n    }}\n    if let Some(id)=a.ghost{if let Some(p)=e.best_ghost.iter().find(|p|p.t>=t){sim.set_position(id,o+p.pos+Vec3::X*3.);if let Some(ch)=sim.state.entities.get_mut(id).and_then(|e|e.character.as_mut()){ch.anim.tilt_side=p.lean.x*.24;ch.anim.tilt_fwd=-p.lean.y*.24;ch.anim.play_clip(p.clip,0,0.000001);ch.anim.clip_t=p.clip_t;ch.anim.clip_w=1.;}}else{sim.set_position(id,hidden);}}\n    for npc in sim.state.entities.iter_mut(){if npc.name==\"Posey\"{if let Some(ch)=npc.character.as_mut(){ch.anim.play_clip(crate::clips::find_cached(if k==Kind::Pose{[\"FIT/Tree\",\"FIT/Warrior\",\"FIT/Lighthouse\"][(t/20.)as usize%3]}else{\"FIT/Breath\"}),0,0.000001);ch.anim.clip_t=if k==Kind::Breath{e.lungs}else{t%2.};ch.anim.clip_w=1.;}}if npc.name==\"Bounce\"{if let Some(ch)=npc.character.as_mut(){ch.anim.lift=(t*std::f32::consts::TAU*1.6).sin().max(0.)*.35;}}}\n}\nimpl FitGame {\n    pub(super) fn hub_input(&mut self,sim:&mut Sim,i:&InputFrame,_dt:f32,events:&mut Vec<SimEvent>){\n        let Some(p)=sim.state.player.and_then(|id|sim.feet(id))else{return;};\n        self.nearest=INTERACTIONS.iter().enumerate().filter(|(_,(_,x,z))|Vec2::new(*x-p.x,*z-p.z).length()<3.).min_by(|(_,(_,ax,az)),(_,(_,bx,bz))|Vec2::new(*ax-p.x,*az-p.z).length_squared().total_cmp(&Vec2::new(*bx-p.x,*bz-p.z).length_squared())).map(|(n,_)|n);\n        if i.move_dir.length()>0.1{self.way_to=None;self.interact_goal=None;}\n        if i.device==2&&i.just(b::CONFIRM){if let Some(aim)=i.aim{let mut target=aim;target.y=.25;target.x=target.x.clamp(-22.,22.);target.z=target.z.clamp(-22.,22.);self.interact_goal=INTERACTIONS.iter().enumerate().find(|(_,(_,x,z))|Vec2::new(*x-aim.x,*z-aim.z).length()<1.8).map(|(n,_)|n);self.way_to=Some(target);}}\n        else if i.just(b::CONFIRM){if let Some(n)=self.nearest{self.interact(n,sim,events);}}\n        if i.just(b::WAVE){if let Some(pid)=sim.state.player{if let Some(ch)=sim.state.entities.get_mut(pid).and_then(|e|e.character.as_mut()){ch.anim.replay_clip(crate::clips::find_cached(\"CMU/Wave_Hello\"),crate::clips::ONCE,1.);}}self.toast(\"Pip has acknowledged your acknowledgement.\");}\n        for(n,(x,z))in FLOPS.iter().enumerate(){if !self.profile.flipflops.contains(&(n as u8))&&Vec2::new(*x-p.x,*z-p.z).length()<1.{self.profile.flipflops.push(n as u8);if let Some(id)=self.props.flops.get(n){sim.set_position(*id,Vec3::new(*x,-30.,*z));}self.toast(if self.profile.flipflops.len()==5{\"All five flip-flops. Tom has some questions about the odd one.\"}else{\"A lost flip-flop. A small sole rescued.\"});events.push(SimEvent::Sfx{id:20,gain:.7,pitch:1.3});self.save_change();}}\n        if p.x*p.x+p.z*p.z>24.*24.{if let Some(pid)=sim.state.player{sim.set_position(pid,Vec3::new(0.,.3,4.));}self.toast(\"The sea has politely returned you.\");}\n    }\n    pub(super) fn interact(&mut self,n:usize,sim:&mut Sim,events:&mut Vec<SimEvent>){match n {\n        0=>if !self.profile.check_done{self.start_day(sim)}else{self.talk(\"PIP\",vec![super::dialogue::pip(self.profile.day,self.profile.age,self.time as usize)],Screen::Hub)},\n        1=>{events.push(SimEvent::Sfx{id:4,gain:.8,pitch:.6});self.talk(\"PIP\",vec![format!(\"{} minutes in the clam. Our minutes are longer. It is a wellness thing.\",self.profile.total_minutes),\"He enjoys a full schedule. And the occasional receipt.\".into()],Screen::Hub)},\n        2..=5=>{self.change(Screen::Schedule);let day=n-1;self.focus=super::events::ROSTER.iter().position(|k|k.day()as usize==day).unwrap_or(0);},\n        6=>self.end_day(sim,events),7=>self.talk(\"MARJORIE\",vec![\"Day five? Oh, I'\"'m on day five as well. Eleven years now.\\\".into(),\\\"The secret is to stop hurrying. Also, the rowboat needs a number.\\\".into()],Screen::Hub),\n        8=>self.talk(\\\"TWO-TOWEL TOM\\\",vec\"'![if self.profile.flipflops.len()==5{\"All five! I have two feet. This is excellent service.\".into()}else{format!(\"I have misplaced five flip-flops. You'\"'ve found {}. Please don't ask about the fifth.\\\",self.profile.flipflops.len())}],Screen::Hub),\n        9=>self.talk(\\\"THE TWINS\\\",vec\"'![\"We find this island very…\".into(),\"…balanced.\".into(),\"We practised that. For three days.\".into()],Screen::Hub),10=>self.change(Screen::Calendar),11=>if self.profile.day>=2||self.profile.free_play{self.change(Screen::Wardrobe)}else{self.toast(\"The towel cupboard opens tomorrow. It is composing itself.\")},\n        12=>if self.profile.free_play{self.change(Screen::Ending)}else{self.talk(\"PIP\",vec![\"The rowboat leaves after the Big Stand. It has a very small timetable.\".into()],Screen::Hub)},_=>{}}\n    }\n}\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('engine/crates/pav_core/src/games/fit/mod.rs');s=p.read_text();s=s.replace('toml::from_str(include_str\"'!(\"rules.toml\")).expect(\"rules defaults\")'\"','''Self{stiffness:40.,damping:8.5,reach:0.92,wobble:0.12,tip_time:0.35,stick_curve:1.5,key_rate:1.6,key_return:1.2,pose_radius:0.30,breath_tolerance:0.35,squat_band:0.25,plank_radius:0.40,rhythm_perfect:0.055,rhythm_good:0.120,spin_band_scale:1.3,lap_zone:0.4,shell_friction:2.6,gust_strength:1.,tray_friction:4.,bounce_gain:1.,finale_gusts:1.5}''');p.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"cat > engine/crates/pav_core/src/games/fit/world.rs <<'EOF'\nuse std::{sync::Arc,collections::BTreeMap};\nuse anyhow::{Result,anyhow};use glam::{Vec2,Vec3,Quat};use serde::{Serialize,Deserialize};\nuse crate::{sim::Sim,room::RoomDef,world::{RoomSlot,World},level::Placement,entity::EntityId,puppet::{PuppetDef,BodyPlan,HelmKind},params::ParamValue,zones::CameraCue,input::{InputFrame,buttons as b},frame::SimEvent};\nuse super::{FitGame,Screen,events::{Event,Kind},meta::{Guest,SKINS,OUTFITS}};\nconst SETS:[(&str,&str);9]=[(\\\"hub\\\",include_str\"'!(\"sets/hub.toml\")),(\"studio\",include_str!(\"sets/studio.toml\")),(\"gazebo\",include_str!(\"sets/gazebo.toml\")),(\"boardwalk\",include_str!(\"sets/boardwalk.toml\")),(\"tide\",include_str!(\"sets/tide.toml\")),(\"channel\",include_str!(\"sets/channel.toml\")),(\"pier\",include_str!(\"sets/pier.toml\")),(\"tower\",include_str!(\"sets/tower.toml\")),(\"bay\",include_str!(\"sets/bay.toml\"))];\npub const INTERACTIONS:[(&str,f32,f32);13]=[(\"Pip · morning check\",0.,-1.),(\"Minute Clam\",3.,1.),(\"Stillness Studio\",-13.,-8.),(\"Iron Gazebo\",13.,-8.),(\"Boardwalk\",-13.,8.),(\"Lagoon\",13.,8.),(\"Your cabana · end day\",-6.,16.),(\"Marjorie\",-2.,5.),(\"Two-Towel Tom\",4.,5.),(\"The Twins\",7.,1.),(\"Calendar\",-4.,-3.),(\"Wardrobe\",-2.,0.),(\"Rowboat · checkout\",19.,18.)];\npub const FLOPS:[(f32,f32);5]=[(-21.,-3.),(19.,-12.),(-17.,14.),(10.,18.),(1.,-21.)];\n#[derive(Clone,Debug,Default,Serialize,Deserialize)]\npub struct Actors {pub rings:Vec<EntityId>,pub shells:Vec<EntityId>,pub pools:Vec<EntityId>,pub glasses:Vec<EntityId>,pub paddle:Option<EntityId>,pub tray:Option<EntityId>,pub gull:Option<EntityId>,pub pip:Option<EntityId>,pub ghost:Option<EntityId>,pub flops:Vec<EntityId>,pub obstacle:Vec<EntityId>,pub ribbons:Vec<EntityId>}\npub fn origin(set:usize)->Vec3{Vec3::new(set as f32*200.,0.,0.)}\nfn prop(sim:&mut Sim,name:&str,at:Vec3,scale:f32)->Result<EntityId>{sim.spawn_prop(&format!(\"LIB/core/fit_{name}\"),at,Quat::IDENTITY,scale,false,None).map_err(|e|anyhow!(e))}\npub fn build(sim:&mut Sim)->Result<Actors>{\n    let mut rooms=vec![];for(i,(name,text))in SETS.iter().enumerate(){let def=RoomDef::parse(&super::super::level_text(&format!(\"fit/sets/{name}\"),text)).map_err(|e|anyhow!(\"{name}: {e}\"))?;let place=Placement::new(def.layout.origin,0);let(cols,rows)=def.layout.extent();let(min,max)=place.aabb(Vec3::new(0.,-1.,0.),Vec3::new(cols as f32,10.,rows as f32));rooms.push(RoomSlot{id:i as u16,key:format!(\"fit/{name}\"),inside:origin(i),outside:origin(i),inward:Vec3::Z,built:false,min,max,place,def:Arc::new(def)});}\n    sim.state.world=World{enabled:false,rooms,current_room:Some(0),..Default::default()};for i in 0..9{sim.build_room(i);}\n    sim.state.spawn=Vec3::new(0.,.3,4.);sim.spawn_player();\n    sim.config.movement.speed=4.2;\n    let mut a=Actors::default();let hidden=Vec3::new(0.,-30.,0.);\n    for _ in 0..7 {a.rings.push(prop(sim,\"floatie\",hidden,1.)?);a.shells.push(prop(sim,\"shell\",hidden,1.)?);}\n    for _ in 0..3 {a.pools.push(prop(sim,\"pool\",hidden,1.)?);}\n    for _ in 0..5 {a.glasses.push(prop(sim,\"smoothie\",hidden,1.)?);}\n    a.paddle=Some(prop(sim,\"paddleboard\",hidden,1.)?);a.tray=Some(prop(sim,\"tray\",hidden,1.)?);a.gull=Some(prop(sim,\"gull\",hidden,0.7)?);a.pip=Some(prop(sim,\"pip\",Vec3::new(0.,.3,-.6),1.)?);\n    for(x,z)in FLOPS{a.flops.push(prop(sim,\"flipflop\",Vec3::new(x,.23,z),1.4)?);}\n    for _ in 0..6{a.obstacle.push(prop(sim,\"crab\",hidden,1.3)?);a.ribbons.push(prop(sim,\"ribbon\",hidden,1.)?);}\n    let mut look=PuppetDef::preset(BodyPlan::Biped);look.skin=\"#8ccbdc\".into();look.shirt=\"#8ccbdc\".into();look.pants=\"#a4d6c9\".into();look.shoes=\"#78bcbd\".into();look.scale=.98;\n    a.ghost=Some(sim.spawn_npc(\"Yesterday You\",hidden,0.,look,None,None));\n    guest_look(sim,&Guest::default());set(sim,0);Ok(a)\n}\npub fn set(sim:&mut Sim,n:usize){sim.state.world.current_room=Some(n as u16);if let Some(pid)=sim.state.player{sim.set_position(pid,origin(n)+if n==0{Vec3::new(0.,.3,4.)}else{Vec3::new(0.,.3,0.)});}sim.state.courses.sticky_cue=None;sim.state.courses.cue_serial+=1;}\npub fn guest_look(sim:&mut Sim,g:&Guest){if let Some(pid)=sim.state.player{if let Some(ch)=sim.state.entities.get_mut(pid).and_then(|e|e.character.as_mut()){\n    let mut look=PuppetDef::default();look.skin=SKINS[(g.skin as usize).min(5)].into();look.shirt=OUTFITS[(g.outfit as usize).min(7)].1.into();look.pants=\"#f6eee0\".into();look.shoes=if g.flipflops.len()==5||g.gear==7{\"#ffd166\"}else{\"#d0aa87\"}.into();look.eyes=\"#263e54\".into();look.scale=1.05;\n    look.gear.helm=match g.gear {1=>HelmKind::Cap,2=>HelmKind::Hood,3=>HelmKind::Crown,4=>HelmKind::Halo,_=>HelmKind::None};look.gear.helm_color=if g.gear==2{\"#fbfaf6\"}else{\"#ffd166\"}.into();if g.gear==5{look.gear.gloves=\"#ff887c\".into();}if g.gear==6{look.gear.pauldrons=0.8;look.gear.armor_color=\"#ff887c\".into();}ch.puppet=Some(Arc::new(look));\n}}}\nfn move_obj(sim:&mut Sim,id:Option<EntityId>,p:Vec3){if let Some(id)=id{sim.set_position(id,p);}}\npub fn animate(sim:&mut Sim,e:&Event,a:&mut Actors,set:usize,_dt:f32){\n    let o=origin(set);let t=e.time;let k=e.effective().0;let mut at=o+Vec3::new(0.,.22,0.);let hidden=o-Vec3::Y*35.;\n    if k==Kind::Paddle{at+=Vec3::new(e.side,0.,-e.progress*72.);move_obj(sim,a.paddle,at-Vec3::Y*.08);}\n    else {move_obj(sim,a.paddle,hidden);}\n    if k==Kind::Tray{at.z-=e.progress*60.;move_obj(sim,a.tray,at+Vec3::new(0.,1.2,.5));for(n,id)in a.glasses.iter().enumerate(){let p=e.glasses[n].0;sim.set_position(*id,if p.length()<1.{at+Vec3::new(p.x,1.3,.5+p.y)}else{hidden});}}\n    else {move_obj(sim,a.tray,hidden);for id in &a.glasses{sim.set_position(*id,hidden);}}\n    if k==Kind::Dive {at+=Vec3::new(if e.dive_presses>=4{(t-e.phase_start).min(3.)*0.6}else{0.},.8+e.dive_y.max(-.7),0.);}\n    if k==Kind::Tide{at=o+Vec3::new(0.,.38,0.);for(n,id)in a.shells.iter().enumerate(){let p=e.shells.get(n).filter(|s|!s.potted).map(|s|o+Vec3::new(s.p.x,.25,s.p.y)).unwrap_or(hidden);sim.set_position(*id,p);}for(n,id)in a.pools.iter().enumerate(){let p=e.pools[n];sim.set_position(*id,o+Vec3::new(p.x,.24,p.y));}}\n    else{for id in a.shells.iter().chain(&a.pools){sim.set_position(*id,hidden);}}\n    for(n,id)in a.rings.iter().enumerate(){sim.set_position(*id,if k==Kind::Spin&&n<e.rings as usize{at+Vec3::Y*(.65+n as f32*.15)}else{hidden});}\n    move_obj(sim,a.gull,if k==Kind::Pose&&(32.0..37.0).contains(&t){at+Vec3::Y*1.8}else{hidden});\n    if k==Kind::Lap{let angle=e.progress*std::f32::consts::TAU;at=o+Vec3::new(angle.sin()*(14.+e.side),.23,angle.cos()*(14.+e.side));for(n,id)in a.obstacle.iter().enumerate(){let ph=angle+(n as f32+1.)*.23;sim.set_position(*id,o+Vec3::new(ph.sin()*14.,.2,ph.cos()*14.));}for(n,id)in a.ribbons.iter().enumerate(){let ph=angle+(n as f32+1.)*.35;sim.set_position(*id,o+Vec3::new(ph.sin()*14.7,.25,ph.cos()*14.7));}}\n    else{for id in a.obstacle.iter().chain(&a.ribbons){sim.set_position(*id,hidden);}}\n    if let Some(pid)=sim.state.player{sim.set_position(pid,at);if let Some(ch)=sim.state.entities.get_mut(pid).and_then(|e|e.character.as_mut()){\n        ch.anim.tilt_side=e.core.cob.x*14.0_f32.to_radians();ch.anim.tilt_fwd=-e.core.cob.y*14.0_f32.to_radians();\n        ch.facing=if matches!(k,Kind::Paddle|Kind::Tray){std::f32::consts::PI}else if k==Kind::Lap{e.progress*std::f32::consts::TAU+std::f32::consts::FRAC_PI_2}else{0.};ch.anim.facing=ch.facing;\n        let clip=match k {Kind::Breath=>\"FIT/Breath\",Kind::Pose=>[\"FIT/Tree\",\"FIT/Warrior\",\"FIT/Lighthouse\"][(t/20.)as usize%3],Kind::Squat=>\"FIT/Squat\",Kind::Plank=>if e.collapsed{\"FIT/Flop\"}else{\"FIT/Plank\"},Kind::Spin=>\"FIT/HipCircle\",Kind::Step=>if(t*3.2)as u32%2==0{\"FIT/StepL\"}else{\"FIT/StepR\"},Kind::Lap=>\"MESH2MOTION/Jog\",Kind::Tray=>\"STYLE100/Balance_Walk\",Kind::Dive=>if e.dive_presses>=4{\"FIT/Tuck\"}else{\"FIT/Squat\"},_=>\"FIT/Breath\"};\n        ch.anim.play_clip(crate::clips::find_cached(clip),0,0.000001);ch.anim.clip_t=match k{Kind::Breath=>e.lungs,Kind::Squat=>e.lungs,Kind::Dive=>e.dive_tuck,_=>t%2.};ch.anim.clip_w=1.;\n    }}\n    if let Some(id)=a.ghost{if let Some(p)=e.best_ghost.iter().find(|p|p.t>=t){sim.set_position(id,o+p.pos+Vec3::X*3.);if let Some(ch)=sim.state.entities.get_mut(id).and_then(|e|e.character.as_mut()){ch.anim.tilt_side=p.lean.x*.24;ch.anim.tilt_fwd=-p.lean.y*.24;ch.anim.play_clip(p.clip,0,0.000001);ch.anim.clip_t=p.clip_t;ch.anim.clip_w=1.;}}else{sim.set_position(id,hidden);}}\n    for npc in sim.state.entities.iter_mut(){if npc.name==\"Posey\"{if let Some(ch)=npc.character.as_mut(){ch.anim.play_clip(crate::clips::find_cached(if k==Kind::Pose{[\"FIT/Tree\",\"FIT/Warrior\",\"FIT/Lighthouse\"][(t/20.)as usize%3]}else{\"FIT/Breath\"}),0,0.000001);ch.anim.clip_t=if k==Kind::Breath{e.lungs}else{t%2.};ch.anim.clip_w=1.;}}if npc.name==\"Bounce\"{if let Some(ch)=npc.character.as_mut(){ch.anim.lift=(t*std::f32::consts::TAU*1.6).sin().max(0.)*.35;}}}\n}\nimpl FitGame {\n    pub(super) fn hub_input(&mut self,sim:&mut Sim,i:&InputFrame,_dt:f32,events:&mut Vec<SimEvent>){\n        let Some(p)=sim.state.player.and_then(|id|sim.feet(id))else{return;};\n        self.nearest=INTERACTIONS.iter().enumerate().filter(|(_,(_,x,z))|Vec2::new(*x-p.x,*z-p.z).length()<3.).min_by(|(_,(_,ax,az)),(_,(_,bx,bz))|Vec2::new(*ax-p.x,*az-p.z).length_squared().total_cmp(&Vec2::new(*bx-p.x,*bz-p.z).length_squared())).map(|(n,_)|n);\n        if i.move_dir.length()>0.1{self.way_to=None;self.interact_goal=None;}\n        if i.device==2&&i.just(b::CONFIRM){if let Some(aim)=i.aim{let mut target=aim;target.y=.25;target.x=target.x.clamp(-22.,22.);target.z=target.z.clamp(-22.,22.);self.interact_goal=INTERACTIONS.iter().enumerate().find(|(_,(_,x,z))|Vec2::new(*x-aim.x,*z-aim.z).length()<1.8).map(|(n,_)|n);self.way_to=Some(target);}}\n        else if i.just(b::CONFIRM){if let Some(n)=self.nearest{self.interact(n,sim,events);}}\n        if i.just(b::WAVE){if let Some(pid)=sim.state.player{if let Some(ch)=sim.state.entities.get_mut(pid).and_then(|e|e.character.as_mut()){ch.anim.replay_clip(crate::clips::find_cached(\"CMU/Wave_Hello\"),crate::clips::ONCE,1.);}}self.toast(\"Pip has acknowledged your acknowledgement.\");}\n        for(n,(x,z))in FLOPS.iter().enumerate(){if !self.profile.flipflops.contains(&(n as u8))&&Vec2::new(*x-p.x,*z-p.z).length()<1.{self.profile.flipflops.push(n as u8);if let Some(id)=self.props.flops.get(n){sim.set_position(*id,Vec3::new(*x,-30.,*z));}self.toast(if self.profile.flipflops.len()==5{\"All five flip-flops. Tom has some questions about the odd one.\"}else{\"A lost flip-flop. A small sole rescued.\"});events.push(SimEvent::Sfx{id:20,gain:.7,pitch:1.3});self.save_change();}}\n        if p.x*p.x+p.z*p.z>24.*24.{if let Some(pid)=sim.state.player{sim.set_position(pid,Vec3::new(0.,.3,4.));}self.toast(\"The sea has politely returned you.\");}\n    }\n    pub(super) fn interact(&mut self,n:usize,sim:&mut Sim,events:&mut Vec<SimEvent>){match n {\n        0=>if !self.profile.check_done{self.start_day(sim)}else{self.talk(\"PIP\",vec![super::dialogue::pip(self.profile.day,self.profile.age,self.time as usize)],Screen::Hub)},\n        1=>{events.push(SimEvent::Sfx{id:4,gain:.8,pitch:.6});self.talk(\"PIP\",vec![format!(\"{} minutes in the clam. Our minutes are longer. It is a wellness thing.\",self.profile.total_minutes),\"He enjoys a full schedule. And the occasional receipt.\".into()],Screen::Hub)},\n        2..=5=>{self.change(Screen::Schedule);let day=n-1;self.focus=super::events::ROSTER.iter().position(|k|k.day()as usize==day).unwrap_or(0);},\n        6=>self.end_day(sim,events),7=>self.talk(\"MARJORIE\",vec![\"Day five? Oh, I'\"'m on day five as well. Eleven years now.\\\".into(),\\\"The secret is to stop hurrying. Also, the rowboat needs a number.\\\".into()],Screen::Hub),\n        8=>self.talk(\\\"TWO-TOWEL TOM\\\",vec\"'![if self.profile.flipflops.len()==5{\"All five! I have two feet. This is excellent service.\".into()}else{format!(\"I have misplaced five flip-flops. You'\"'ve found {}. Please don't ask about the fifth.\\\",self.profile.flipflops.len())}],Screen::Hub),\n        9=>self.talk(\\\"THE TWINS\\\",vec\"'![\"We find this island very…\".into(),\"…balanced.\".into(),\"We practised that. For three days.\".into()],Screen::Hub),10=>self.change(Screen::Calendar),11=>if self.profile.day>=2||self.profile.free_play{self.change(Screen::Wardrobe)}else{self.toast(\"The towel cupboard opens tomorrow. It is composing itself.\")},\n        12=>if self.profile.free_play{self.change(Screen::Ending)}else{self.talk(\"PIP\",vec![\"The rowboat leaves after the Big Stand. It has a very small timetable.\".into()],Screen::Hub)},_=>{}}\n    }\n}\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('engine/crates/pav_core/src/games/fit/mod.rs');s=p.read_text();s=s.replace('toml::from_str(include_str\"'!(\"rules.toml\")).expect(\"rules defaults\")'\"','''Self{stiffness:40.,damping:8.5,reach:0.92,wobble:0.12,tip_time:0.35,stick_curve:1.5,key_rate:1.6,key_return:1.2,pose_radius:0.30,breath_tolerance:0.35,squat_band:0.25,plank_radius:0.40,rhythm_perfect:0.055,rhythm_good:0.120,spin_band_scale:1.3,lap_zone:0.4,shell_friction:2.6,gust_strength:1.,tray_friction:4.,bounce_gain:1.,finale_gusts:1.5}''');p.write_text(s)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"cat > tools/make-text-motion.py <<'PY'\nfrom pathlib import Path\nimport json,copy\nroot=Path(__file__).resolve().parents[1]/'engine';game=root/'crates/pav_core/src/games/fit'\nbanks={\n'pip':[\n'Welcome. Your towel has been expecting you.','You did not enter the competition. Nobody enters.','Please stand on me. Gently. I remember everything.','That is a number. Numbers cannot hurt you. This one is trying.','Your right side has asked to be included.','Your best attempt so far. I have updated my expectations.','Forty-one wobbles. I stopped counting at forty, out of respect.','Pausing is not an exercise. I checked.','Our minutes are longer. It is a wellness thing.','The clam has accepted your time. It has no change.','Every day is a fresh start. The records are permanent.','You have arrived. That is already a difficult thing to improve upon.','Please enjoy your complimentary sense of obligation.','Checkout is at forty. The boat is quite literal.','Nobody has asked to leave yet. Not in writing.','There is no rush. There is a schedule.','We believe in small steps. We measure all of them.','Your centre is a little to the left of your confidence.','I have prepared a graph. Emotionally.','A very dignified recovery. I almost looked away.','Stillness is a skill. So is finding your cabana.','Today your balance has an interesting accent.','The bird is not staff. It has a key anyway.','Your towel is reserved. Your number is provisional.','The tide has no opinion about you. I have several.','A gentle reminder to relax. This is reminder seven.','The sea is calm. We would like you to meet its standard.','You are doing enough. I have done the arithmetic.','An encouraging improvement of exactly some amount.','The clam does not judge. It categorises.','We keep your records in a very soft folder.','Your feet are on the same team. Please tell them.','Day two. Yesterday has become useful data.','Big Kettle is very supportive. Structurally, too.','The towel cupboard is open. Try not to become powerful.','The gazebo has been polished for your effort.','Your rest has been professionally observed.','A full minute. According to our special clocks.','Your new cap is a recognised achievement.','Please breathe. The resort does not supply spare air.','Day three. Someone familiar is on the next mat.','That is Yesterday You. I am not comparing you.','Yesterday You has excellent attendance.','The boardwalk is open. It has been rehearsing.','Bounce is very excited. That is his whole biography.','The rhythm is steady. Please negotiate with it.','You have found a flip-flop. A small mystery has become smaller.','Tom has five missing shoes and a complicated story.','The twins would like to congratulate you in unison.','I have filed that wave as a social activity.','Day four. The lagoon has agreed to participate.','The gull has a captain’s hat. We have not asked for references.','Your splash has reached reception.','The smoothies appreciate your caution.','That shell is not late. It is considering.','A slow approach. The pool respects that.','The pier has been checked. Some of it has passed.','Tomorrow is the Big Stand. Today is an adequate rehearsal.','The post is small to encourage commitment.','The guests are whispering. That counts as quiet.','Day five. A surprisingly round number of days.','Your Balance Age has been printed on the boat ticket.','Please accept the sunset. It is nonrefundable.','Thirty seconds. The invitation to do less is now official.','I have nothing to add. I am trying very hard.','…Oh. You’re still here. Good.','That was Inner Peace. We do not sell it in the shop.','The rowboat has been given permission to drift.','Your checkout is approved. The towel needs a moment.','An extended stay. A fresh chance to practise arriving.','Marjorie recommends another eleven years.','All the mats are yours now. Metaphorically.','The calendar can continue. It enjoys a routine.','There is no final number. Just today’s.','We hope you feel a little more here.','The clam has cancelled its afternoon plans.','You returned. I kept a very small light on.','A little less wobble. A little more you.','Your absence was noticed by the furniture.','Welcome back. The island has barely moved.'\n],\n'posey':[\n'Breathe in the sea. Not literally.','Be the heron. The heron does not check the score.','There is a bird on you. Accept the bird.','Stillness leaves room for everything else.','A little movement can be a whole conversation.','Let your shoulders stop submitting reports.','The horizon is not in a hurry.','Be a lighthouse. The boats can wait.','Hold the pose as though it were a small warm cup.','The deck chair folds. It does not apologise.','Your next breath has already been approved.','An inhale is a very small beginning.','An exhale does not need a reason.','The lotus has noticed. It will say nothing.','Let the ring come to you. Then go to the ring.','We are all briefly herons.','Your balance is looking for a place to sit.','The lunge is reluctant. It will cooperate.','The bridge has no destination.','Seated disappointment is still a seat.','Your arms may be at peace independently.','The wood creaks. This is not feedback.','I have no eyes. This has not been discussed.','Gently. The floor is already holding you.','You are allowed to begin again.'\n],\n'kettle':[\n'Lift with your legs. I cannot. I have none. Lift for both of us.','Ten. Also eleven.','A fine plank. I could build a small deck from that.','Down slowly. The ground is fully booked.','Up again. A surprising plot twist.','Hold both. We are committed now.','The tremble means the pose has developed an opinion.','I am laughing with you. Mostly at my joke.','I have a handle on things. Literally one.','Your effort is strong. My compliments are cast iron.','We rest between the numbers.','That bell is the bottom. Say hello.','A graceful descent. I wrote that before you started.','Solid work. I know solid.','Please rise at your own prescribed pace.','Your balance is doing some extra shifts.','The ring is getting smaller. I have submitted a complaint.','A minute is a long shape.','Breathe while bracing. It is an advanced convenience.','I support you. From this very specific position.','The gazebo believes in you. It has six legs.','Your tenth rep has brought a guest.','A floor greeting. Very courteous.','No need to be made of iron. We have enough.','Take a rest. I will hold the atmosphere.'\n],\n'bounce':[\n'Keep going keep going keep— is that your heartbeat? Mine is just air\"'!'\"','Left right left right lovely feet','The beat is not leaving without us','Circle like you have nowhere urgent to be','Switch\"'! A whole new direction to be optimistic about'\"','Catch left\"'! A gift for your hips'\"','Catch right\"'! It came with no receipt'\"','That ring thinks you are doing wonderfully','Lovely pace mind the crab','The crab has right of way emotionally','Not too fast we are on holiday','Breathe through the stitch it is only visiting','A ribbon\"'! Something else to carry home'\"','The step is very excited to meet your feet','Both feet together a small reunion','You found the zone I knew it was here somewhere','I am mostly air and entirely supportive','The guests are clapping on purpose','Morning air afternoon enthusiasm','Your feet make very good points','A double note twice the opportunity','The boardwalk is our very long dance floor','We are getting somewhere approximately here','A little slower is still going','I cannot stop smiling it is how I was inflated'\n],\n'gull':[\n'That was a dive. I am legally required to say so.','We are not here for form. We are here for splash.','The judges have been fed. Their opinions remain hungry.','Six point five. Seven. See me.','The shell must enter slowly. It has paperwork.','A gate is a suggestion with a penalty.','Stand on the board. It has been informed.','The wind is not an official participant.','Your smoothie has requested shore leave.','An acceptable amount of ocean has moved.','Tuck. The sea recognises a compact application.','The fourth bounce is the departure desk.','A very wet argument. Sustained.','The buoy has observed your absence.','There are no snacks on the course. Officially.','My hat is the source of my authority.','A shell in a pool is a closed case.','The tide will be rising. It has seniority.','Please avoid becoming a second raft.','I award that splash an administrative seven.','The tray has five opportunities for disappointment.','Marjorie is waiting. She has considerable practice.','A no-spill delivery. The sea is filing an appeal.','The channel is long. Your attention should match.','Please return all borrowed water.'\n]}\ntitles=['Human Soup','Acceptable Human','Certified Lean-To','Wobble Enthusiast','Seasoned Tilter','Stillness Intern','Professional Standing Person','Alarmingly Balanced','Licensed Sway Inspector','Assistant Heron','Heron, Acting','Head of Remaining Upright','Deputy Cushion Friend','Senior Breath Holder','Respectable Deck Chair','Recipient of a Small Nod','Tide Pool Associate','Quietly Improving','Almost a Lighthouse','Certified Towel Guest','Junior Gravity Negotiator','Wellness Adjacent','Cautiously Buoyant','Official Ring Bearer','Keeper of Five Smoothies','A Sensible Crab','Guest of the Minute','Unexpectedly Serene','Chair of Standing','Fully Present, Mostly','Mildly Remarkable','Director of Not Falling','Balance, With Distinction','Supremely Unhurried','Lotus Whisperer','A Small Local Legend']\ns=''\nfor name,lines in banks.items():s+=f'[{name}]\\\\nlines = '+json.dumps(lines,ensure_ascii=False)+'\\\\n\\\\n'\ns+='[awards]\\\\ntitles = '+json.dumps(titles)+'\\\\n';(game/'script.toml').write_text(s)\n# Hand-authored native key poses; the renderer keeps its procedural puppet and clip blending.\nneutral={'hips':[0,0,100],'body':[0,0,0],'chest':[0,0,0],'head':[0,0,0],'armL':[10,10,-95,10,0],'armR':[10,10,-95,10,0],'legL':[0,6,-100,0,0],'legR':[0,6,-100,0,0]}\ndef pose(**kw):return {**copy.deepcopy(neutral),**kw}\nposes={\n'Breath':[pose(),pose(chest=[0,-4,0],armL=[10,18,-90,14,0],armR=[10,18,-90,14,0])],\n'Squat':[pose(),pose(hips=[-22,0,58],body=[0,28,0],head=[0,-22,0],armL=[100,4,10,0,0],armR=[100,4,10,0,0],legL=[55,10,-60,95,0],legR=[55,10,-60,95,0],footL=[-12,0,0],footR=[-12,0,0])],\n'Tree':[pose(armL=[0,40,70,50,0],armR=[0,40,70,50,0],legL=[0,6,-100,0,0],legR=[10,75,-30,110,0],hips=[0,-9,100])]*2,\n'Warrior':[pose(hips=[0,0,72],body=[35,0,0],chest=[-35,-4,0],head=[-30,0,0],armL=[0,100,0,0,0],armR=[0,100,0,0,0],legL=[70,0,-55,95,0],legR=[-85,20,-60,0,0],footR=[10,40,0])]*2,\n'Lighthouse':[pose(hips=[0,0,100],armL=[0,0,100,4,0],armR=[0,60,70,8,0],legR=[-20,0,-95,25,0])]*2,\n'DeckChair':[pose(hips=[-20,0,60],body=[0,60,0],armL=[90,0,0,0,0],armR=[90,0,0,0,0],legL=[70,0,-70,80,0],legR=[70,0,-70,80,0])]*2,\n'Bridge':[pose(hips=[0,0,45],body=[0,-50,0],armL=[-40,30,-70,15,0],armR=[-40,30,-70,15,0],legL=[60,0,-60,80,0],legR=[60,0,-60,80,0])]*2,\n'Seated':[pose(hips=[0,0,26],legL=[90,60,0,90,0],legR=[90,60,0,90,0],head=[0,15,0])]*2,\n'ArmFlail':[pose(armL=[20,90,50,30,0],armR=[50,70,0,45,0]),pose(armL=[60,70,0,45,0],armR=[20,90,50,30,0])],\n'Stumble':[pose(hips=[8,0,80],body=[0,30,18],armL=[80,50,30,20,0],legR=[40,0,-80,40,0]),pose()],\n'StepL':[pose(hips=[0,-8,100],legL=[40,0,-65,50,0],armR=[30,10,-90,45,0]),pose()],\n'StepR':[pose(hips=[0,8,100],legR=[40,0,-65,50,0],armL=[30,10,-90,45,0]),pose()],\n'HipCircle':[pose(hips=[6,-10,94],body=[0,0,10],armL=[0,65,-50,70,0],armR=[0,65,-50,70,0]),pose(hips=[-6,10,94],body=[0,0,-10],armL=[0,65,-50,70,0],armR=[0,65,-50,70,0])],\n'CarryTray':[pose(armL=[60,20,-50,80,0],armR=[60,20,-50,80,0])]*2,\n'Tuck':[pose(hips=[0,0,70],body=[0,35,0],head=[0,15,0],armL=[70,20,-40,95,0],armR=[70,20,-40,95,0],legL=[95,10,-15,130,0],legR=[95,10,-15,130,0])]*2,\n'DiveEntry':[pose(body=[0,180,0],armL=[0,0,100,0,0],armR=[0,0,100,0,0])]*2,\n'Flop':[pose(),pose(hips=[0,0,8],body=[0,90,0],armL=[0,100,0,0,0],armR=[0,100,0,0,0])],\n'Bow':[pose(),pose(body=[0,45,0],head=[0,15,0])],\n'Sleep':[pose(hips=[0,0,25],body=[0,90,0],armL=[0,20,-90,90,0],armR=[0,20,-90,90,0])]*2,\n'Wake':[pose(armL=[0,35,85,10,0],armR=[0,35,85,10,0]),pose()],\n'Sigh':[pose(chest=[0,8,0],head=[0,12,0]),pose()]\n}\nmesh=json.loads((root/'anim/mesh2motion.json').read_text());plank=copy.deepcopy(mesh['clips']['Pushup']['keys'][0]);plank.pop('t',None);poses['Plank']=[plank,plank]\nclips={}\nfor name,keys in poses.items():\n keys=[dict(k,t=float(i))for i,k in enumerate(keys)];clips[name]={'clip':name,'dur':1.0,'loop':name not in ['Squat','Breath','Stumble','Flop','Bow','Wake','Sigh'],'tags':['exercise'],'desc':f'Tippy Cay {name} pose.','keys':keys}\n(root/'anim/fit.json').write_text(json.dumps({'set':'FIT','title':'Tippy Cay moves','format':1,'credit':'Original hand-keyed Wobble Wit clips (CC0); Plank adapted from Mesh2Motion Pushup (CC0).','legend':[],'fps':30,'sources':{},'clips':clips},indent=2))\nPY\npython3 tools/make-text-motion.py\ncat > engine/crates/pav_core/src/games/fit/dialogue.rs <<'EOF'\nuse super::events::Kind;\n#[derive(serde::Deserialize)]struct Bank{pip:Lines,posey:Lines,kettle:Lines,bounce:Lines,gull:Lines,awards:Awards}\n#[derive(serde::Deserialize)]struct Lines{lines:Vec<String>}\n#[derive(serde::Deserialize)]struct Awards{titles:Vec<String>}\nfn bank()->&'static Bank{static DATA:std::sync::OnceLock<Bank>=std::sync::OnceLock::new();DATA.get_or_init(||toml::from_str(include_str\"'!(\"script.toml\")).expect(\"authored resort dialogue\"))}\npub fn pip(day:u8,age:u8,n:usize)->String{if age<=40{format!(\"Balance Age {age}. The rowboat has begun to respect you.\")}else if n%3==0{format!(\"Balance Age {age}. A number with room for improvement.\")}else{let b=&bank().pip.lines;b[((day as usize-1)*16+n%16)%b.len()].clone()}}\npub fn coach(k:Kind,day:u8,n:usize)->String {let b=bank();let lines=match k.coach(){\"POSEY\"=>&b.posey.lines,\"BIG KETTLE\"=>&b.kettle.lines,\"BOUNCE\"=>&b.bounce.lines,\"COMMODORE GULL\"=>&b.gull.lines,_=>&b.pip.lines};lines[(n+day as usize*3)%lines.len()].clone()}\npub fn title(score:u32,variant:usize)->String{let a=&bank().awards.titles;let group=(score/170).min(5)as usize;a[(group*6+variant)%a.len()].clone()}\nEOF\nCARGO_BUILD_JOBS=4 cargo check --locked -p pav_core > ../check-core.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
