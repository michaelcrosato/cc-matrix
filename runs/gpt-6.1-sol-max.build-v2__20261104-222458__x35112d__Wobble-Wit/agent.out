STEP_L;}\n        if self.mouse_taps.contains(&MouseButton::Right){presses|=b::STEP_R;}\n        if (self.cursor-self.fit_cursor).length()>6. {self.fit_cursor=self.cursor;self.fit_any=true;self.fit_device=2;}\n        let axis=Vec2::new((is(KeyD)||is(ArrowRight))as u8 as f32-(is(KeyA)||is(ArrowLeft))as u8 as f32,(is(KeyW)||is(ArrowUp))as u8 as f32-(is(KeyS)||is(ArrowDown))as u8 as f32);\n        self.fit_ramp=pav_core::games::fit::core::keys(self.fit_ramp,axis,dt,is(ShiftLeft)||is(ShiftRight),1.6,1.2);\n        let lean=match self.fit_device{1=>self.pad.left,2=>Vec2::new(self.cursor.x-size.x*0.5,size.y*0.5-self.cursor.y)/(size.y*0.38).max(1.),_=>self.fit_ramp}.clamp_length_max(1.);\n        let mut nav=0;if self.fit_device==1 {if self.pad.left.y>0.5{nav|=b::MENU_UP;}if self.pad.left.y< -0.5{nav|=b::MENU_DOWN;}if self.pad.left.x>0.5{nav|=b::MENU_RIGHT;}if self.pad.left.x< -0.5{nav|=b::MENU_LEFT;}}\n        self.fit_repeat-=dt;if nav!=0&&self.fit_repeat<=0.{presses|=nav;self.fit_repeat=0.19;}if nav==0{self.fit_repeat=0.;}\n        presses|=held&!self.fit_prev;self.fit_prev=held;\n        let any=self.fit_any||presses!=0;self.fit_any=false;\n        InputFrame{lean,held,pressed:presses,any,device:self.fit_device,..Default::default()}\n    }\n\n'\"'''+s[pos:];p.write_text(s)\np=Path('engine/crates/pav_app/src/app.rs');s=p.read_text().replace('    input: Input,','    input: Input,\\\\n    fit_booted:bool,',1).replace('            input: Input::new(),','            input: Input::new(),\\\\n            fit_booted:false,',1).replace('            egui_ctx: egui::Context::default(),','            egui_ctx: {let ctx=egui::Context::default();pav_ui::fit_ui::install_fonts(&ctx);ctx},',1)\ns=s.replace('        let Some(g) = &self.gfx else { return };\\\\n        let ppp', '''        if self.input.fit {if let(Some(st),Some(g))=(&mut self.egui_state,&self.gfx){st.on_window_event(&g.window,event);}return;}\n        let Some(g) = &self.gfx else { return };\n        let ppp''',1)\ns=s.replace('    fn handle_key(&mut self, code: KeyCode) {','    fn handle_key(&mut self, code: KeyCode) {\\\\n        if self.input.fit && code\"'!=KeyCode::F11 {return;}'\"',1)\ns=s.replace('        self.pad_menus(dt);','        if \"'!self.input.fit {self.pad_menus(dt);}'\"',1).replace('let rewinding = game_input &&','let rewinding = \"'!self.input.fit && game_input &&'\"',1)\ns=s.replace('        let (prev, curr, curr_at, tick_wall) = host.frames();','''        let (prev, curr, curr_at, tick_wall) = host.frames();\n        self.input.fit=curr.hud.fit.is_some();\n        if self.input.fit && \"'!self.fit_booted {crate::weblink::boot(host);self.fit_booted=true;self.show_boot=false;self.app_settings.show_stats=false;self.app_settings.show_guide=false;}\n        if self.input.fit {crate::weblink::publish(curr.hud.status.as_deref());}\n        let (prev,curr)=crate::weblink::ghosts(prev,curr);\n        if let Some(yaw)=curr.hud.camera_yaw{self.rig.params.yaw=yaw;}\n        if self.input.fit {self.gfx.as_ref().unwrap().window.set_cursor_visible(self.input.fit_device!=1);}'\"''',1)\ns=s.replace('                self.input.bindings = b;','                self.input.bindings = if self.input.fit{crate::input::Bindings::default()}else{b};',1)\ns=s.replace('        let over_ui = self.egui_ctx.egui_wants_pointer_input();','''        let mut fit_input=if self.input.fit{Some(self.input.fit_frame(dt,size))}else{None};\n        if let Some(i)=&mut fit_input{crate::weblink::input(i);i.aim=self.rig.ground_point(self.input.cursor,size,feet.y);if let Some(audio)=&self.audio{i.song_pos=Some(pav_audio::song_position(audio.sample_rate as f32));}}\n        let over_ui = self.egui_ctx.egui_wants_pointer_input();''',1)\ns=s.replace('        if left_tap && \"'!self.editor.on && game_input {'\"','        if left_tap && \"'!self.input.fit && !self.editor.on && game_input {'\"',1)\ns=s.replace('            if game_input {\\\\n                let axis', '''            if let Some(mut fi)=fit_input {\n                fi.move_dir=self.rig.relative_move(self.input.move_axis());\n                if fi.down(pav_core::input::buttons::SPRINT){fi.move_dir*=1.5;}\n                fi.pressed|=i.pressed;\n                fi.ui=fi.ui.or(i.ui);\n                *i=fi;\n            }else if game_input {\n                let axis''',1)\n# Bypass every engine overlay and draw the game's pure view, returning hit rectangles for tools.\ns=s.replace('        let out = self.egui_ctx.run_ui(raw, |ui| {','''        let mut fit_response=None;\n        let out = self.egui_ctx.run_ui(raw, |ui| {''',1)\ns=s.replace('            let ctx = ui.ctx().clone();\\\\n            if let Some(c) = &info.crash {','''            let ctx = ui.ctx().clone();\n            if let Some(fit)=&curr.hud.fit {fit_response=Some(pav_ui::fit_ui::draw(&ctx,fit));return;}\n            if let Some(c) = &info.crash {''',1)\ns=s.replace('        if prefs \"'!= self.prefs {'\"','''        if let Some(response)=fit_response {\n            crate::weblink::ui(&response);\n            if let Some(event)=response.event{let mut inp=host.shared.input.lock().unwrap();inp.ui=Some(event);if matches\"'!(event,pav_core::input::UiEvent::Click(_)|pav_core::input::UiEvent::Slider(_,_)){inp.pressed&=!pav_core::input::buttons::PRIMARY;inp.held&=!pav_core::input::buttons::PRIMARY;}}\n        }\n        if prefs != self.prefs {'\"''',1)\n# The right mouse button remains an activity input. Use middle drag for native camera orbit.\ns=s.replace('let turn = if self.input.game &&','let turn = if self.input.fit || self.input.game &&',1)\ns=s.replace('        if self.input.pad.start_pressed {','        if self.input.pad.start_pressed && \"'!self.input.fit {'\"',1)\np.write_text(s)\np=Path('engine/crates/pav_app/src/simhost.rs');s=p.read_text().replace('                i.pressed = 0;','                i.pressed = 0;\\\\n                i.ui=None;i.any=false;',1);p.write_text(s)\np=Path('engine/crates/pav_app/src/main.rs');s=p.read_text().replace('mod settings;','mod settings;\\\\nmod weblink;');p.write_text(s)\np=Path('engine/crates/pav_app/src/settings.rs');s=p.read_text().replace('        if (s.animation_studio || s.asset_studio || s.creature_studio) && s.scene.is_empty() {','''        if let Some((scene,seed))=crate::weblink::boot_scene(){s.scene=scene;s.seed=seed;}\n        if (s.animation_studio || s.asset_studio || s.creature_studio) && s.scene.is_empty() {''',1);p.write_text(s)\np=Path('engine/crates/pav_tools/src/session.rs');s=p.read_text().replace('frame.game.is_some() || \"'!frame.hud.lines.is_empty()'\"','frame.game.is_some() || frame.hud.fit.is_some() || \"'!frame.hud.lines.is_empty()'\"');p.write_text(s)\nPY\npython3 tools/patch-app.py\ncat > engine/crates/pav_app/src/weblink.rs <<'EOF'\n//\"'! Narrow browser link. No per-frame simulation exec/query calls.\nuse std::sync::Arc;\nuse pav_core::{InputFrame,RenderFrame};\nuse pav_ui::fit_ui::Response;\nuse crate::simhost::SimHost;\n#[cfg(target_arch=\"wasm32\")]\nuse web_sys::{js_sys::{Reflect,Array},wasm_bindgen::{JsValue,JsCast}};\n#[cfg(target_arch=\"wasm32\")]\nfn get(v:&JsValue,key:&str)->JsValue{Reflect::get(v,&JsValue::from_str(key)).unwrap_or(JsValue::UNDEFINED)}\n#[cfg(target_arch=\"wasm32\")]\nfn win()->JsValue{web_sys::window().unwrap().into()}\n#[cfg(target_arch=\"wasm32\")]\npub fn boot_scene()->Option<(String,u64)>{let b=get(&win(),\"__gameBoot\");let scene=get(&b,\"scene\").as_string()?;Some((scene,get(&b,\"seed\").as_f64().unwrap_or(1.)as u64))}\n#[cfg(target_arch=\"wasm32\")]\npub fn boot(host:&SimHost){let b=get(&win(),\"__gameBoot\");let save=get(&b,\"save\").as_string().unwrap_or_default();let today=get(&b,\"today\").as_f64().unwrap_or(0.)as u32;let about=get(&b,\"about\").as_string().unwrap_or_default();host.exec(move|sim|{let Some(mut play)=sim.state.play.take()else{return;};if let Some(g)=play.get_mut::<pav_core::games::fit::FitGame>(){g.load_save(&save,today);if let Ok(v)=serde_json::from_str(&about){g.set_about(v);}}sim.state.play=Some(play);});}\n#[cfg(target_arch=\"wasm32\")]\npub fn publish(status:Option<&str>){if let Some(s)=status{let _=Reflect::set(&win(),&JsValue::from_str(\"__gameStatus\"),&JsValue::from_str(s));}}\n#[cfg(target_arch=\"wasm32\")]\npub fn input(i:&mut InputFrame){let w=win();let hub=get(&w,\"__hub\");if get(&hub,\"go\").as_bool().unwrap_or(false){i.held|=pav_core::input::buttons::HUB_GO;}i.hub_end=get(&hub,\"ended\").as_bool().unwrap_or(false);let value=get(&w,\"__fitExternalUi\");if Array::is_array(&value){let queue:Array=value.unchecked_into();let cmd=queue.shift();if !cmd.is_undefined(){let id=get(&cmd,\"id\").as_f64().unwrap_or(0.)as u16;let kind=get(&cmd,\"kind\").as_string().unwrap_or_default();i.device=3;i.any=true;if kind==\"settings\"{i.pressed|=pav_core::input::buttons::PAUSE;i.ui=Some(pav_core::input::UiEvent::Click(4));}else if kind==\"slider\"{i.ui=Some(pav_core::input::UiEvent::Slider(id,get(&cmd,\"value\").as_f64().unwrap_or(0.)as f32));}else{i.ui=Some(pav_core::input::UiEvent::Click(id));}}}}\n#[cfg(target_arch=\"wasm32\")]\npub fn ui(r:&Response){if let Ok(s)=serde_json::to_string(&r.items){let _=Reflect::set(&win(),&JsValue::from_str(\"__gameUi\"),&JsValue::from_str(&s));}}\n#[cfg(target_arch=\"wasm32\")]\npub fn ghosts(prev:Arc<RenderFrame>,curr:Arc<RenderFrame>)->(Arc<RenderFrame>,Arc<RenderFrame>){\n let h=get(&win(),\"__hub\");let ghosts=get(&h,\"ghosts\");if ghosts.is_undefined()||ghosts.is_null(){return(prev,curr);}\n let text=web_sys::js_sys::JSON::stringify(&ghosts).ok().and_then(|v|v.as_string()).unwrap_or_default();let Ok(v)=serde_json::from_str::<serde_json::Value>(&text)else{return(prev,curr);};let Some(map)=v.as_object()else{return(prev,curr);};\n let status=curr.hud.status.as_deref().and_then(|s|serde_json::from_str::<serde_json::Value>(s).ok()).unwrap_or_default();let area=status[\"hub\"][\"ghost\"][\"area\"].as_u64().unwrap_or(255);\n let Some(player)=curr.player.and_then(|id|curr.objects.iter().find(|o|o.id==id))else{return(prev,curr);};let mut extra=vec![];\n for(seat,g)in map {if g[\"area\"].as_u64()!=Some(area){continue;}let Some(p)=g[\"position\"].as_array()else{continue;};if p.len()!=3{continue;}let n=seat.parse::<u32>().unwrap_or(0);let mut obj=player.clone();obj.id=pav_core::entity::EntityId(100000+n);obj.pos=glam::Vec3::new(p[0].as_f64().unwrap_or(0.)as f32+(n as f32+1.)*2.6,p[1].as_f64().unwrap_or(0.)as f32+obj.puppet.as_ref().map(|pp|pp.feet_offset).unwrap_or(0.),p[2].as_f64().unwrap_or(0.)as f32);if let Some(pp)=&mut obj.puppet{pp.tint=Some(([[0.9,0.25,0.2],[0.2,0.5,1.],[0.2,0.8,0.4],[1.,0.7,0.2]][n as usize%4],0.65));if let Some(lean)=g[\"lean\"].as_array(){pp.state.tilt_side=lean.first().and_then(|x|x.as_f64()).unwrap_or(0.)as f32*0.24;}}extra.push(obj);}\n if extra.is_empty(){return(prev,curr);}let mut a=(*prev).clone();let mut b=(*curr).clone();a.objects.extend(extra.clone());b.objects.extend(extra);(Arc::new(a),Arc::new(b))\n}\n#[cfg(not(target_arch=\"wasm32\"))]pub fn boot_scene()->Option<(String,u64)>{None}\n#[cfg(not(target_arch=\"wasm32\"))]pub fn boot(_host:&SimHost){}\n#[cfg(not(target_arch=\"wasm32\"))]pub fn publish(_status:Option<&str>){}\n#[cfg(not(target_arch=\"wasm32\"))]pub fn input(_i:&mut InputFrame){}\n#[cfg(not(target_arch=\"wasm32\"))]pub fn ui(_r:&Response){}\n#[cfg(not(target_arch=\"wasm32\"))]pub fn ghosts(a:Arc<RenderFrame>,b:Arc<RenderFrame>)->(Arc<RenderFrame>,Arc<RenderFrame>){(a,b)}\nEOF\nCARGO_BUILD_JOBS=4 cargo check --locked -p pav_app > ../check-app.log 2>&1'","aggregated_output":"","exit_code":101,"status":"failed"}}
{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' engine/scripts/pack_single_html.py; sed -n '252,280p' engine/crates/pav_app/src/simhost.rs; rg -n 'fn t_input|\\\"input\\\"|hold.*press' engine/crates/pav_tools/src/tools.rs | head -12; tail -10 check.log; du -sh engine/target\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' engine/scripts/pack_single_html.py; sed -n '252,280p' engine/crates/pav_app/src/simhost.rs; rg -n 'fn t_input|\\\"input\\\"|hold.*press' engine/crates/pav_tools/src/tools.rs | head -12; tail -10 check.log; du -sh engine/target\"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Packs the browser build into one self-contained HTML page: no other files, no network loads.\n\nusage: python3 -I scripts/pack_single_html.py BINDGEN_DIR [--title T] [--description D]\n           [--theme-color C] [--scene NAME] [--out PATH]\n\nBINDGEN_DIR is wasm-bindgen's output (shardfall.js, shardfall_bg.wasm); scripts/build-web.sh\n--single-file makes it and runs this. The page is web/index.html with the options written into\nits <title>, <meta name=description> and <meta name=theme-color> (left as they are when not\ngiven), the manifest link dropped, and, before </body>, the gzipped wasm as base64 text, a\nloader that sets window.loadGame (index.html's script calls it when set) and the JS glue as an\ninline module script. The loader shows a progress line, bakes in --scene (used when the address\nnames no room or scene) and unpacks with the browser's DecompressionStream. No blob: or data:\nURLs are needed. Out: target/web/<title>.html.\n\"\"\"\nimport argparse\nimport base64\nimport gzip\nimport html\nimport json\nimport pathlib\nimport re\nimport sys\n\nROOT = pathlib.Path(__file__).resolve().parent.parent\nPAGE = ROOT / \"web\" / \"index.html\"\n\n# Runs while the page parses, before index.html's module script.\nLOADER = \"\"\"\n(() => {\n  const msg = document.getElementById('msg');\n  // The start scene baked in at build time, unless the address names a room or a scene.\n  const scene = __SCENE__, query = new URLSearchParams(location.search);\n  if (scene && !query.get('room') && !query.get('scene')) {\n    query.set('scene', scene);\n    try { history.replaceState(history.state, '', '?' + query + location.hash); }\n    catch (error) { console.warn('Could not put the start scene in the address:', error); }\n  }\n  const line = document.createElement('div');\n  line.style.cssText = 'font-size: 14px; opacity: 0.7; font-variant-numeric: tabular-nums';\n  msg.style.flexDirection = 'column';\n  msg.style.gap = '8px';\n  msg.replaceChildren(`Loading ${document.title}…`, line);\n  const paint = () => new Promise((resolve) => setTimeout(resolve, 20));\n  // The JS glue is the module script at the end of the page: it hands over its init function.\n  const glue = new Promise((resolve) => { window.gameGlue = resolve; });\n  window.loadGame = async () => {\n    line.textContent = 'Unpacking…';\n    await paint();\n    // The gzipped wasm's base64 block leaves the page once read, to free its text.\n    const block = document.getElementById('game-wasm'), size = +block.dataset.size, text = block.textContent;\n    block.remove();\n    let packed;\n    if (Uint8Array.fromBase64) packed = Uint8Array.fromBase64(text);\n    else {\n      const bin = atob(text);\n      packed = new Uint8Array(bin.length);\n      for (let i = 0; i < bin.length; i++) packed[i] = bin.charCodeAt(i);\n    }\n    const wasm = new Uint8Array(size);\n    const reader = new Blob([packed]).stream().pipeThrough(new DecompressionStream('gzip')).getReader();\n    let n = 0;\n    for (let r = await reader.read(); !r.done; r = await reader.read()) {\n      wasm.set(r.value, n);\n      n += r.value.length;\n      line.textContent = `Unpacking ${Math.floor((100 * n) / size)}%`;\n    }\n    if (n !== size) throw new Error(`the packed game is damaged (${n} of ${size} bytes)`);\n    line.textContent = 'Starting…';\n    await paint();\n    const init = await glue;\n    await init({ module_or_path: wasm });\n  };\n})();\n\"\"\"\n\n\ndef fail(text):\n    sys.exit(f\"pack_single_html: {text}\")\n\n\ndef replace_one(page, pattern, make, what):\n    \"\"\"Replaces the one match of `pattern` in the page; anything else means index.html changed.\"\"\"\n    page, n = re.subn(pattern, make, page)\n    if n != 1:\n        fail(f\"expected one {what} in {PAGE.relative_to(ROOT)}, found {n}: update this script\")\n    return page\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__.split(\"\\n\")[0])\n    ap.add_argument(\"bindgen_dir\", type=pathlib.Path, help=\"wasm-bindgen output (shardfall.js, shardfall_bg.wasm)\")\n    ap.add_argument(\"--title\", help=\"<title> (default: index.html's)\")\n    ap.add_argument(\"--description\", help=\"<meta name=description> (default: index.html's)\")\n    ap.add_argument(\"--theme-color\", help=\"<meta name=theme-color> (default: index.html's)\")\n    ap.add_argument(\"--scene\", help=\"start scene when the address names no room or scene (default: the game's)\")\n    ap.add_argument(\"--out\", type=pathlib.Path, help=\"output file (default: target/web/<title>.html)\")\n    a = ap.parse_args()\n\n    js, wasm_path = a.bindgen_dir / \"shardfall.js\", a.bindgen_dir / \"shardfall_bg.wasm\"\n    for p in (js, wasm_path):\n        if not p.is_file():\n            fail(f\"{p} is missing: run wasm-bindgen --target web --out-name shardfall first\")\n    # The glue goes in the page as an inline module script, so it can't import other files\n    # (wasm-bindgen snippets) or hold text that would end the script element early.\n    glue = js.read_text(encoding=\"utf-8\")\n    if (a.bindgen_dir / \"snippets\").exists() or re.search(r\"^import\\b\", glue, re.M):\n        fail(\"the JS glue imports other files (wasm-bindgen snippets); inline them before packing\")\n    if re.search(r\"(?i)</script|<script|<!--\", glue):\n        fail(\"the JS glue contains <script, </script or <!--, which can't sit inside an inline script\")\n    init = re.search(r\"^export \\{[^}]*?\\b([\\w$]+) as default\\b\", glue, re.M)\n    if not init:\n        fail(\"can't find the JS glue's default export (its init function)\")\n\n    page = PAGE.read_text(encoding=\"utf-8\")\n    if a.title is not None:\n        page = replace_one(page, r\"<title>[^<]*</title>\", lambda m: f\"<title>{html.escape(a.title)}</title>\", \"<title>\")\n    for name, value in ((\"description\", a.description), (\"theme-color\", a.theme_color)):\n        if value is not None:\n            page = replace_one(\n                page,\n                rf'<meta name=\"{name}\" content=\"[^\"]*\">',\n                lambda m, name=name, value=value: f'<meta name=\"{name}\" content=\"{html.escape(value)}\">',\n                f\"<meta name={name}>\",\n            )\n    # A manifest is another file to load: the single page goes without one.\n    page = replace_one(page, r'[ \\t]*<link rel=\"manifest\"[^>]*>\\n', lambda m: \"\", \"manifest link\")\n\n    wasm = wasm_path.read_bytes()\n    packed = gzip.compress(wasm, compresslevel=9, mtime=0)\n    # JSON is valid JS; escaping \"<\" keeps a scene name from closing the script element.\n    loader = LOADER.replace(\"__SCENE__\", json.dumps(a.scene or None).replace(\"<\", \"\\\\u003c\"))\n    tail = (\n        f'<script id=\"game-wasm\" type=\"application/octet-stream\" data-size=\"{len(wasm)}\">'\n        f\"{base64.b64encode(packed).decode()}</script>\\n\"\n        f\"<script>{loader}</script>\\n\"\n        f'<script type=\"module\">\\n{glue}\\nwindow.gameGlue({init[1]});\\n</script>\\n'\n    )\n    page = replace_one(page, r\"</body>\", lambda m: tail + \"</body>\", \"</body>\")\n\n    title = a.title if a.title is not None else html.unescape(re.search(r\"<title>([^<]*)</title>\", page)[1])\n    out = a.out or ROOT / \"target\" / \"web\" / f\"{re.sub(r'[^a-z0-9]+', '-', title.lower()).strip('-') or 'game'}.html\"\n    out.parent.mkdir(parents=True, exist_ok=True)\n    out.write_text(page, encoding=\"utf-8\")\n    mb = lambda n: f\"{n / 1e6:.1f} MB\"  # noqa: E731\n    print(f\"{out}: {mb(out.stat().st_size)} (wasm {mb(len(wasm))}, gzipped {mb(len(packed))}; JS glue {mb(len(glue))})\")\n\n\nif __name__ == \"__main__\":\n    main()\n        }\n    }\n\n    /// Runs whatever is due now; returns how long until the next tick.\n    fn advance(&mut self, sim: &mut Sim, sh: &Shared) -> Duration {\n        let previewing = sim.studio_active();\n        let mode = sim.studio_mode();\n        if self.studio_mode != mode {\n            self.studio_mode = mode;\n            self.next = Instant::now();\n        }\n        let ctl = *sh.control.lock().unwrap();\n        // The animation stage has its own play, pause and speed controls. The world's time\n        // controls stay untouched, including a paused or rewound game behind the stage.\n        let tick_wall = if previewing { sim.dt() } else { sim.dt() / ctl.speed.clamp(0.01, 16.0) };\n        let (busy, window_ticks) = (&mut self.busy, &mut self.window_ticks);\n        let mut tick_once = |sim: &mut Sim, at: Instant| {\n            let input = if previewing {\n                InputFrame::default()\n            } else {\n                let mut i = sh.input.lock().unwrap();\n                let mut frame = *i;\n                i.pressed = 0;\n                i.ui=None;i.any=false;\n                frame.cmd = sh.cmds.lock().unwrap().pop_front();\n                frame\n            };\n            let stamp = if previewing { None } else { sh.input_stamp.lock().unwrap().take() };\n            let t = Instant::now();\n108:        name: \"input\",\n109:        help: \"Drive the player: hold a move direction/buttons for N ticks (press = only on the first tick).\",\n1358:fn t_input(s: &mut Session, a: &Args) -> Result<Output> {\n    |       |\n    |       expected due to the type of this binding\n    |\n    = note: expected struct `std::string::String`\n                found tuple `(&str, f32, f32)`\n\nSome errors have detailed explanations: E0061, E0277, E0308.\nFor more information about an error, try `rustc --explain E0061`.\nwarning: `pav_core` (lib) generated 2 warnings\nerror: could not compile `pav_core` (lib) due to 8 previous errors; 2 warnings emitted\n1.5G\tengine/target\n","exit_code":0,"status":"completed"}}
