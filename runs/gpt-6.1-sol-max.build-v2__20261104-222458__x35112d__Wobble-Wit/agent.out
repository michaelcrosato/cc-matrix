{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport json\nfor p in Path('engine/assets/props/lib/core').glob('fit_*.json'):\n d=json.loads(p.read_text())\n def fix(parts):\n  for part in parts.values():\n   if 'parts'in part:fix(part['parts'])\n   if part.get('type')=='rounded_box'and'size'in part:part['radius']=min(part.get('radius',0),min(part['size'])*.49)\n fix(d['parts']);p.write_text(json.dumps(d,indent=2))\np=Path('tools/make-art.py');s=p.read_text().replace(\\\"radius=r)\\\",\\\"radius=min(r,min(size)*.49))\\\");p.write_text(s)\np=Path('engine/crates/pav_core/src/games/fit/events/mod.rs');s=p.read_text();s=s.replace('Kind::Plank if self.kind==Kind::Finale=>self.gust(t,r)*r.finale_gusts','Kind::Plank|Kind::Pose if self.kind==Kind::Finale=>self.gust(t,r)*r.finale_gusts*(0.3+t/20.)');s=s.replace('        if self.time>=self.duration {self.finished=true;}','''        if self.kind==Kind::Finale {\n            let phase=self.phase as usize;\n            if phase<4 {let q=match phase{0=>((1.-(self.lungs-self.guide).abs()/r.breath_tolerance).clamp(0.,1.)*0.7+0.3*(dist<0.35)as u8 as f32)*if action||self.lungs>0.02{1.}else{0.15},1=>(cob.distance(self.target)<self.radius)as u8 as f32,3=>(brace&&dist<self.radius)as u8 as f32,_=>0.};\n                if phase==2 {let total=self.notes.iter().filter(|n|n.t<40.).count()as f32;self.metrics[2]=self.notes.iter().filter(|n|n.t<40.).map(|n|n.quality).sum::<f32>()/total.max(1.);}else{self.metrics[phase]=(self.metrics[phase]+q*dt/[32.,20.,40.,20.][phase]).min(1.);}}\n            let peace=if self.peace{((self.time-112.)/30.).clamp(0.,1.)}else{0.};\n            self.score=((self.metrics.iter().sum::<f32>()+peace)*200.-self.core.tips as f32*15.).clamp(0.,1000.)as u32;\n        }\n        if self.time>=self.duration {self.finished=true;}''');p.write_text(s)\np=Path('engine/crates/pav_ui/src/fit_ui.rs');s=p.read_text().replace('if u.heading.len()>32{64.}','if u.heading.len()>25{64.}');p.write_text(s)\nPY\n./tests/run.sh core > notes/core-result.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
