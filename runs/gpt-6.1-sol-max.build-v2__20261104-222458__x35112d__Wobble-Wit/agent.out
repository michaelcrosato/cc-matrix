';if(navigator.gpu)__fitExternalUi.push({kind:'settings'});};\n document.getElementById('touch-open').onclick=showSettings;document.getElementById('fallback-settings').onclick=showSettings;\n document.getElementById('touch-close').onclick=()=>{open=false;settings.style.display='none';__fitExternalUi.push({kind:'click',id:10});};\n for(const [key,id]of[['music',0],['sfx',1],['voice',2],['assist',5]])document.getElementById('touch-'+key).addEventListener('input',e=>{const v=Number(e.target.value)/100;__fitExternalUi.push({kind:'slider',id,value:v});if(key==='music')document.getElementById('music-val').textContent=e.target.value+'%';});\n const normal=()=>{window.__touchOnly=false;card.style.display='none';};addEventListener('keydown',normal);addEventListener('gamepadconnected',normal);\n addEventListener('contextmenu',e=>e.preventDefault());\n setInterval(()=>{const pads=navigator.getGamepads?.()||[];if([...pads].some(p=>p?.buttons.some(b=>b.pressed)||p?.axes.some(a=>Math.abs(a)>.3)))normal();if(__touchOnly&&navigator.gpu&&\"'!open)card.style.display='\"'flex';\n  let s;try{s=JSON.parse(window.__gameStatus||'null');}catch{}if(\"'!s)return;window.__gameReady=true;document.body.dataset.screen=s.screen;\n  if(s.serial>0&&s.serial!==serial&&!AIHub.active){serial=s.serial;try{localStorage.setItem('\"'wobble-wit-v1',JSON.stringify(s.save));}catch{}}\n },100);\n})();\n</script>\n<script type=\\\"module\\\">\n const name='Wobble Wit',msg=document.getElementById('msg');\n if(\"'!navigator.gpu){msg.replaceChildren();const brand=document.createElement('\"'span');brand.className='brand';brand.textContent='TIPPY CAY · WELLNESS RESORT';const h=document.createElement('strong');h.textContent=window.__touchOnly?'Controller or keyboard required':'A small browser adjustment.';const detail=document.createElement('small');detail.textContent='Wobble Wit needs WebGPU. Open this file in a browser with WebGPU and hardware acceleration enabled. A controller or keyboard is required to play.';msg.append(brand,h,detail);document.getElementById('fallback-settings').style.display='block';}\n else{\n  new MutationObserver((_,obs)=>{const c=document.querySelector('canvas');if(c){c.setAttribute('aria-label',name+' game');msg.remove();c.focus();obs.disconnect();}}).observe(document.body,{childList:true});\n  try{if(window.loadGame)await window.loadGame();else await(await import('./shardfall.js')).default();}catch(error){console.error(name+' failed to load:',error);msg.textContent='Your towel is not quite ready. Reload to try again.';document.body.append(msg);}\n }\n</script></body></html>\n'''\n(root/'engine/web/index.html').write_text(head)\nPY\npython3 - <<'PY'\nimport json,pathlib\ninfo={'date':'2026-11-04 22:24:58','source':'Wii Fit','plan':'PLAN.md','genre':'Sports','perspective':'Third person; island follow, mirror exercises, chase, high three-quarter and side views','tech':'Pavilion engine 0.1.0; Rust 1.98.1; WebAssembly; wgpu 30; egui 0.36; rapier 0.36; cpal 0.18','artDirection':'High-key pastel cel-shaded native primitive resort with original beach and exercise props','animation':'Pavilion procedural puppets and original FIT key-pose clips; native motion libraries','audio':'Original procedural lounge, ambient, waltz, rhythm, mallet and finale arrangements; synthesised effects and gibberish formant voices; music defaults to 10%','online':'AI Hub Session Protocol 1, client 1.4.0; ghost medley for 1–4 players; local hot-seat medley','testing':'Headless deterministic scripts, full bot playthroughs, browser controller/touch/audio stand-ins, Hub simulated network and viewport checks allowed; no physical controller, TV or iOS device','research':'Read PLAN.md, TASK.md, Pavilion START_HERE.md and MAKE_A_GAME.md, relevant engine API and asset documentation, and AI Hub README/client/harness from their public GitHub repositories','environment':'Codex CLI (headless); Linux','model':'OpenAI, gpt-6.1-sol, reasoning effort max','usage':'added on import'}\nd={'sourceInformation':info,'testingFeedback':['unknown','unknown','unknown','unknown'],'engineFeedback':['Deterministic simulation, headless tools and native primitive art share one build.','Integration required reading engine input, frame, audio and app internals.','A shared balance spring, full resort flow, activity rules and controller-first UI.','Connecting a custom game UI and browser inputs across several engine crates.','Added game input fields, frozen-world hook, fit HUD, figure tilt, procedural music/voices and splash effects.','A first-class custom-game shell with menus, saves, controller mapping and browser hooks.'],'promptFeedback':['The concrete daily ritual, event rules and deadpan cast gave the game a clear identity.','The enormous build scope and verification claims still needed local revalidation.','Finishing the full anthology, shell and multiplayer as one deterministic game.','Provide the engine seams as a reusable starting package, then spend more of the brief on play tuning.'],'aiHub':{'name':'Wobble Wit','tagline':'A little less wobble. A little more you.','description':'Win a five-day holiday at a wellness resort staffed by talking gym equipment. Lean, breathe, step and splash through eleven activities, then try doing absolutely nothing.','type':'Game','genre':'Sports','source':'Wii Fit','series':'Wii Fit','players':'1–4','controls':'Left stick/WASD/mouse lean; Cross/Space/click action; shoulders/Q/E steps; Triangle/Tab schedule; Options/Esc pause.','tags':['3d','third-person','comedy','sports','versus','low-poly']}}\npathlib.Path('../exit-interview.json').write_text(json.dumps(d,indent=2,ensure_ascii=False))\nPY\npython3 tools/make-page.py\ncat > tools/build.sh <<'EOF'\n#\"'!/usr/bin/env bash\nset -euo pipefail\ncd \"$(dirname \"$0\")/..\"\npython3 tools/make-page.py\ncd engine\nCARGO_BUILD_JOBS=4 scripts/build-web.sh --single-file --scene fit --title \"Wobble Wit — A little less wobble\" --description \"A five-day wellness holiday staffed by talking gym equipment. Eleven activities. One very patient clam.\" --theme-color '\"'#8fdde0' --out ../../Wobble-Wit-Wii-Fit-gpt-6.1-sol-max-20261104-222458.html\nEOF\nchmod +x tools/build.sh\n# Shell scripts create temporary bindgen output inside this workspace.\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('engine/scripts/build-web.sh');s=p.read_text().replace('bindgen=\"'$(mktemp -d)'\"','bindgen=\"'$(mktemp -d \"$PWD/target/bindgen.XXXXXX\")'\"');p.write_text(s)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
