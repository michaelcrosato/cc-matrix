{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,120p' /home/micha/.local/bin/viewport-matrix\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,120p' /home/micha/.local/bin/viewport-matrix\"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Screenshot a URL across phone / foldable / tablet / desktop viewports in Chromium, WebKit and Firefox.\n\nWrites one PNG per (device, engine) plus index.html (contact sheet drawn to relative scale) and\nreport.json, and flags horizontal overflow, console errors, page errors and failed requests.\n\nBy default each device runs on the engine it really ships with (iPhone/iPad -> WebKit,\nAndroid -> Chromium) and desktop sizes run on all three engines.\n\n  viewport-matrix http://localhost:5173\n  viewport-matrix http://localhost:5173/play -o /tmp/shots --full-page\n  viewport-matrix URL --engines firefox              # everything in Firefox\n  viewport-matrix URL --all-engines                  # every device x every engine\n  viewport-matrix URL --only phone,foldable --dpr1   # small files, mobile only\n\"\"\"\nimport argparse\nimport asyncio\nimport fcntl\nimport html\nimport json\nimport os\nimport re\nimport sys\nimport time\nfrom pathlib import Path\n\nfrom playwright.async_api import async_playwright\n\nENGINES = [\"chromium\", \"webkit\", \"firefox\"]\n\n# (label, Playwright device name or (width, height), category, engines it really ships with)\nMATRIX = [\n    (\"iPhone SE\", \"iPhone SE (3rd gen)\", \"phone\", [\"webkit\"]),\n    (\"iPhone 17 Pro\", \"iPhone 17 Pro\", \"phone\", [\"webkit\"]),\n    (\"iPhone 17 Pro Max\", \"iPhone 17 Pro Max\", \"phone\", [\"webkit\"]),\n    (\"iPhone 17 Pro landscape\", \"iPhone 17 Pro landscape\", \"phone\", [\"webkit\"]),\n    (\"Pixel 10\", \"Pixel 10\", \"phone\", [\"chromium\"]),\n    (\"Galaxy Z Fold 7 (open)\", \"Galaxy Z Fold 7\", \"foldable\", [\"chromium\"]),\n    (\"iPad Mini\", \"iPad Mini\", \"tablet\", [\"webkit\"]),\n    (\"iPad Pro 11 landscape\", \"iPad Pro 11 landscape\", \"tablet\", [\"webkit\"]),\n    (\"Galaxy Tab S9\", \"Galaxy Tab S9\", \"tablet\", [\"chromium\"]),\n    (\"4:3 1024x768\", (1024, 768), \"desktop\", ENGINES),\n    (\"Laptop 1366x768\", (1366, 768), \"desktop\", ENGINES),\n    (\"16:10 1440x900\", (1440, 900), \"desktop\", ENGINES),\n    (\"16:9 1920x1080\", (1920, 1080), \"desktop\", ENGINES),\n    (\"21:9 2560x1080\", (2560, 1080), \"desktop\", ENGINES),\n]\n\n# Elements sticking out past the right edge of the viewport (the usual cause of sideways scrolling).\nOVERFLOW_JS = \"\"\"() => {\n  const vw = document.documentElement.clientWidth;\n  const sw = document.documentElement.scrollWidth;\n  if (sw <= vw + 1) return null;\n  const culprits = [];\n  for (const el of document.body ? document.body.querySelectorAll('*') : []) {\n    const r = el.getBoundingClientRect();\n    if (r.right > vw + 1 && r.width > 0 && !el.closest('[aria-hidden=\"true\"]')) {\n      const parent = el.parentElement && el.parentElement.getBoundingClientRect();\n      if (parent && parent.right > vw + 1) continue;  // report the outermost offender only\n      let d = el.tagName.toLowerCase();\n      if (el.id) d += '#' + el.id;\n      else if (typeof el.className === 'string' && el.className.trim()) d += '.' + el.className.trim().split(/\\\\s+/).slice(0, 2).join('.');\n      culprits.push(d + ` (right=${Math.round(r.right)}px)`);\n      if (culprits.length >= 3) break;\n    }\n  }\n  return { viewport: vw, scrollWidth: sw, culprits };\n}\"\"\"\n\n\ndef slug(s):\n    return re.sub(r\"[^a-z0-9]+\", \"-\", s.lower()).strip(\"-\")\n\n\ndef aspect(w, h):\n    r = max(w, h) / min(w, h)\n    return f\"{r:.2f}:1 {'portrait' if h > w else 'landscape'}\"\n\n\nasync def shoot(browsers, pw, url, label, spec, category, engine, args, out, sem):\n    async with sem:\n        if isinstance(spec, tuple):\n            opts = {\"viewport\": {\"width\": spec[0], \"height\": spec[1]}, \"device_scale_factor\": 1}\n        else:\n            opts = {k: v for k, v in pw.devices[spec].items() if k != \"default_browser_type\"}\n            if engine == \"firefox\":\n                opts.pop(\"is_mobile\", None)  # Firefox has no mobile mode in Playwright\n        if args.dpr1:\n            opts[\"device_scale_factor\"] = 1\n        vp = opts[\"viewport\"]\n        rec = {\"label\": label, \"category\": category, \"engine\": engine, \"width\": vp[\"width\"],\n               \"height\": vp[\"height\"], \"dpr\": opts.get(\"device_scale_factor\", 1),\n               \"console_errors\": [], \"page_errors\": [], \"failed_requests\": [], \"overflow\": None}\n        ctx = await browsers[engine].new_context(**opts)\n        page = await ctx.new_page()\n        page.on(\"console\", lambda m: m.type == \"error\" and rec[\"console_errors\"].append(m.text[:300]))\n        page.on(\"pageerror\", lambda e: rec[\"page_errors\"].append(str(e)[:300]))\n        page.on(\"requestfailed\", lambda r: rec[\"failed_requests\"].append(f\"{r.url[:150]} ({r.failure})\"))\n        try:\n            resp = await page.goto(url, wait_until=\"load\", timeout=args.timeout * 1000)\n            rec[\"status\"] = resp.status if resp else None\n            try:\n                await page.wait_for_load_state(\"networkidle\", timeout=5000)\n            except Exception:\n                pass  # apps with live sockets / audio streams never go idle\n            await page.evaluate(\"document.fonts ? document.fonts.ready.then(() => 0) : 0\")\n            await page.wait_for_timeout(args.wait)\n            rec[\"overflow\"] = await page.evaluate(OVERFLOW_JS)\n            fname = f\"{slug(label)}__{engine}.png\"\n            await page.screenshot(path=str(out / fname), full_page=args.full_page)\n            rec[\"file\"] = fname\n        except Exception as e:\n            rec[\"error\"] = str(e).splitlines()[0][:300]\n        finally:\n            await ctx.close()\n        issues = issue_list(rec)\n        mark = \"FAIL\" if rec.get(\"error\") else (\"WARN\" if issues else \" ok \")\n        print(f\"[{mark}] {label:26} {engine:8} {vp['width']:>4}x{vp['height']:<4}  {'; '.join(issues)}\", flush=True)\n        return rec\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc 'cat START_HERE.md docs/MAKE_A_GAME.md crates/pav_core/src/games/starter.rs'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc 'cat START_HERE.md docs/MAKE_A_GAME.md crates/pav_core/src/games/starter.rs'","aggregated_output":"# Shardfall and the Pavilion engine: start here\n\nA Rust game engine built for AI agents (Pavilion), the hack-and-slash built on it (Shardfall)\nand a pavilion of demo rooms. This page is for an agent receiving the source, from a clone of\nhttps://github.com/michaelcrosato/shardfall or from a handoff archive (no Git history, build\ncaches, saved heroes or executables; `git init` if you want to track your changes).\n\n## Which route\n- **Make a new game on the engine:** read `docs/MAKE_A_GAME.md` whole. It is the only page\n  you need to start; it begins from the starter game (`crates/pav_core/src/games/`).\n- **Work on the engine or on Shardfall:** read `docs/DOCTRINE.md`, `AGENTS.md` and\n  `docs/PROGRESS.md` (Claude Code loads them through `CLAUDE.md`); `docs/DESIGN.md` and\n  `docs/GAME.md` when the work touches the design.\n\nPrompts to give the receiving agent:\n\n> Make a game: read START_HERE.md and docs/MAKE_A_GAME.md, install the Linux packages and\n> build the `pav` CLI. Then make *(your idea, e.g. \"a top-down maze where you collect five\n> keys and escape while ghosts patrol\")* on the engine, starting from the starter game. Give\n> it a bot that wins and the tests from the guide, check it with the capture tools, tell me\n> how to play it, and end with the engine feedback the guide asks for.\n\n> Work on the engine: read START_HERE.md, then follow AGENTS.md. *(the task)*\n\nAgents in auto modes may refuse to unpack an archive or run its scripts unless the prompt\nsays to; say so in the prompt when you hand over an archive.\n\n## Linux setup\nUse a Linux machine with Rust installed through rustup. `rust-toolchain.toml` selects\nRust 1.98.1 automatically. The first build needs network access to download the\ntoolchain and dependencies; `Cargo.lock` pins the dependency versions.\n\nOn Debian / Ubuntu, install the native build and runtime dependencies below. If\nalready running as root, omit `sudo`. On a managed machine, ask its administrator\nto install missing packages.\n\n```sh\nsudo apt-get update\nsudo apt-get install -y build-essential pkg-config libasound2-dev libudev-dev \\\n  mesa-vulkan-drivers vulkan-tools xvfb libxkbcommon-x11-0 libx11-xcb1 \\\n  libxcursor1 libxrandr2 libxi6\n```\n\nSimulation tools need no display or GPU. Screenshot tools use Vulkan and can use\nMesa lavapipe (software rendering) on a machine without a GPU. Keep builds on disk\nand limit parallel jobs on machines with little RAM.\n\n## Build and inspect headlessly\n\n```sh\nCARGO_BUILD_JOBS=4 cargo build --locked -p pav_tools --bin pav\n./target/debug/pav help\n./target/debug/pav play scene=starter bot=true seeds=5\n./target/debug/pav capture scene=world ticks=60 width=640 height=360 out=out/pavilion.png\n```\n\n`starter` is the starter game; `world` is the pavilion of demo rooms; `town` is Shardfall's\ntown; `arena` is the wave arena; `lab` is the Menagerie; `level/1` starts the descent. A room\nkey such as `drift` loads that demo by itself. `pav repl` keeps a session across commands:\n\n```sh\nprintf 'load scene=world\\ngoto room=drift\\ncapture width=640 height=360 out=out/drift.png\\n' | ./target/debug/pav repl\n./target/debug/pav levelmap depth=7 nav=true out=out/level7.png\n./target/debug/pav campaign scene=town from=1 to=3 wall=60\ncargo test --locked -p pav_core\n```\n\nInspect the generated images with the agent's image viewer. `docs/REFERENCE.md` describes\nevery tool. `.mcp.json` exposes the same CLI as the `shardfall` MCP server; run the `cargo\nbuild` above before starting an MCP client, because a first build takes longer than clients\nwait for a server.\n\n## Run the game window\n\n```sh\nCARGO_BUILD_JOBS=4 cargo build --locked -p pav_app\n./target/debug/shardfall --scene starter # the starter game\n./target/debug/shardfall --scene world   # tech demo\n./target/debug/shardfall --scene town    # Shardfall\n```\n\nWithout a graphical desktop, use `xvfb-run -a` around the game command, or use the\nheadless capture tools above. The demo's F2 menu jumps between rooms. Startup\nsettings and hero saves are written next to the game executable.\n\nFor Windows cross-compilation and Wine checks, `scripts/setup-linux.sh` installs the\nadditional tools and `scripts/build-windows.sh` builds the executables.\n\n## The studios (live editing in the window)\n- **Objects:** `scripts/asset-studio.sh`, with `.mcp.studio.json` for the LLM: `assets`,\n  `asset_edit`, `asset_preview`, `asset_spawn` (`docs/ASSET_STUDIO.md`,\n  `docs/ASSET_STUDIO_LIVE.md`).\n- **Animation:** `scripts/animation-studio.sh`, with `.mcp.animation-studio.json` (or `pav\n  live` in a second terminal): `anim_edit`, `anim_preview` (`docs/ANIMATION_STUDIO.md`).\n- **Creatures:** Node 22.18 or newer, then `scripts/creature-studio.sh`; `creature_edit`\n  returns a job to follow with `creature_status` (`docs/CREATURE_STUDIO.md`).\n\nEdits save to readable files and show in the window without a rebuild. `.mcp.json` runs a\nseparate headless session; the studio configurations control the visible window.\n\n## Make another handoff archive\nFrom a Git checkout, `scripts/package-agent.sh` packages the tracked files (with local edits)\ninto `out/agent/shardfall-linux-agent.tar.gz` and a SHA-256 checksum; add new files to Git\nfirst. It leaves out `pavilion-lite/` (an older engine, frozen). `scripts/check-handoff.sh`\nunpacks a fresh archive elsewhere, builds it and plays the starter, as a receiving agent\nwould: run it after changing what the archive carries or this page.\n# Make a game on Pavilion\n\nFor an agent asked to build a game on this engine. Read this page whole (about 3k tokens); it\nis the only one you need to start. Search the others when a step points to them. The engine\nwas made for agents: everything runs, renders and checks headless, and every tool is a CLI\ncommand, a REPL line and an MCP tool.\n\n## What you get\n- **A simulation** on the CPU at 60 ticks a second (`pav_core`): characters that walk, jump,\n  climb and swim, rapier physics, pathfinding, projectiles, zones, procedural animation,\n  props from a library. The same inputs and seed always play the same: snapshots, rewind\n  and replays are exact.\n- **A WebGPU renderer** (`pav_render`, `pav_view`): lighting, shadows, bloom, styles and\n  filters (cel, pixel, painterly...), set per level as data.\n- **Synthesized sound** (`pav_audio`): it plays the simulation's events, no audio files.\n- **Tools** (`pav`): capture a frame, step time, drive the player, run your game's bot over\n  many seeds, record and replay. Images come back as PNGs you can look at.\n- **Three builds** from one source: a window on Linux and Windows, and the browser (also as\n  one self-contained HTML file).\n\nShardfall, the hack-and-slash in `crates/pav_core/src/arpg/`, and the pavilion of demo rooms\nare built on the same engine. They are examples, not starting points: start from the\n**starter game**.\n\n## Read this, skip that\n- **Use:** this page; `crates/pav_core/src/games/` (the hook and the starter, about 600\n  lines); `rooms/_template.toml` (the level format: search it for a field); `docs/REFERENCE.md`\n  \"Tools\" (search for a tool); `pav help`.\n- **`AGENTS.md`** is the rulebook for agents working on the engine and Shardfall. Its\n  \"Key rules\" apply to your game too (below). Its workflow does not: `docs/HISTORY.md`,\n  `docs/PROGRESS.md`, pull requests, escalations and the asset-store plans are the\n  maintainers'. Follow your own task's instructions for commits and delivery.\n- **Skip:** `docs/HISTORY.md`, `docs/ASSET_SYSTEM_PLAN.md`, `docs/AGENT_ASSET_STORE.md`,\n  Shardfall's code and data (`arpg/`, `game/`), `pavilion-lite/` (an older, frozen engine).\n  If you need to read engine source to use the engine, say so in your feedback (below).\n\n## Quick start\n```sh\ncargo build -p pav_tools --bin pav                     # first build: a few minutes\nalias pav=./target/debug/pav\npav play scene=starter bot=true seeds=10               # the starter's bot wins 10/10\npav capture scene=starter ticks=120 width=640 height=360 out=out/starter.png\nprintf 'load scene=starter\\ninput move=[1,0] ticks=60\\nplay\\ncapture out=out/a.png\\n' | pav repl\ncargo test -p pav_core --test games                    # the starter's tests\ncargo run -p pav_app -- --scene starter                # the window (WASD; needs a display)\n```\n`START_HERE.md` has the Linux packages to install. Look at captures with your image tool;\nsmall sizes are cheaper. With MCP (`.mcp.json`), the same tools are `mcp__shardfall__*`.\n\n**The edit loop.** Running from the repository's root, `pav` reads your level file at every\n`load` (and `play seeds=`), so changes to the map and to its `[game]` numbers need no rebuild.\nA change to Rust code rebuilds `pav` (about 2 minutes on 4 cores) and a test binary (as long\nagain): batch code edits, and put balance numbers in `[game]`.\n\n## Your game in six steps\n1. **Copy the starter.** `crates/pav_core/src/games/starter.rs` and `starter.toml` to\n   `<key>.rs` and `<key>.toml` in the same folder. Rename the struct; set `const KEY` to your\n   key (lowercase, no `/`); point `include_str!` at your level.\n2. **Register it.** In `games/mod.rs`: `pub mod <key>;` and one line in `GAMES`:\n   `entry::<mykey::MyGame>(\"One sentence about it.\", mykey::build)`. Now `load scene=<key>`\n   works in the tools, the window (`--scene <key>`) and the browser (`?scene=<key>`).\n3. **Draw the level** in `<key>.toml` (next section), with your rules' numbers in its `[game]`\n   table (the starter's `Rules`). `pav room_check path=<file>` checks it.\n4. **Write the rules** in your `Game` impl (the hook, below).\n5. **Teach the bot** every rule you add (`Game::bot`): it is how you, the tests and the next\n   agent find out whether the game can be won.\n6. **Copy the tests** in `crates/pav_core/tests/games.rs` to `tests/<key>.rs`: the bot wins on\n   ten seeds, a careless player loses, and snapshots, rewind and replays are exact.\n\n## The level: a room file\nA level is a room file (`rooms/_template.toml` documents every field; the pavilion's\n`rooms/*.toml` are working examples). Rooms built this way stand alone, with no wing or\ncorridor. In a room file:\n- `[layout]`: an ASCII map per floor (`[[layout.layer]]`, 1 cell = 1 m; column = x east,\n  row = z south) and a `legend` per character: floor and wall `blocks` (heights, colours,\n  `destructible`, `crumble`, `ghost`), ladders, `prop`s, `label`s, `grass`, trigger `zone`s\n  (`kill`, `water`, `checkpoint`, `conveyor`, `bounce`, `pad`, `camera`, course\n  `start`/`gate`/`finish`) and `marker = \"<name>\"`.\n- **Markers** are your own pieces: `crate::scenes::markers(sim, \"shard\")` lists every\n  marked cell (world positions, map order). `marker = \"player\"` is the start.\n- `[[npc]]`: characters (`kind = biped | spider | lizard | beetle | blob | quadruped`, `look` colours and\n  proportions, `ai = idle | wander | patrol | circle | follow | guard`). Your game can drive\n  them instead (the starter's slimes).\n- `[[object]]`: library props (`asset = \"LIB/core/<name>\"`; `pav assets find=barrel` searches\n  the store, `assets shelf=prop` lists the best), physics objects, `[[joint]]`s and `[[chain]]`s.\n- `[camera]` (`tilt`, `distance`, `yaw`, `ortho`), `[view]` (light, sky, fog, bloom, styles,\n  filters: `pav params prefix=view` lists them), `[params]` (movement and physics while in\n  the level: `pav params`).\n\n- `[game]`: your rules' numbers, free-form; your `build` reads them (`def.game`).\n- `entrance` is required by the format; with a `player` marker a level doesn't use it.\n\nRead the level with `games::level_text(KEY, include_str!(...))`: the file on disk when running\nfrom the repository, else the copy built in (tests, the browser, an executable). The camera\nfollows the player; to see a whole level from above, `camera preset=top` then\n`set path=camera.distance value=30` (raise it for bigger levels) and `capture`.\n\n## The hook: `pav_core::games::Game`\n```rust\n#[derive(Clone, Serialize, Deserialize)]\npub struct MyGame { /* the rules' state: score, timers, entity ids, outcome */ }\n\nimpl Game for MyGame {\n    const KEY: &'static str = \"mygame\";\n    fn pre(&mut self, sim: &mut Sim, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>)\n        -> BTreeMap<EntityId, InputFrame>;          // before movement: inputs for characters you drive\n    fn post(&mut self, sim: &mut Sim, dt: f32, events: &mut Vec<SimEvent>); // after physics: rules\n    fn hud(&self, sim: &Sim) -> Vec<String>;        // text lines, top left; `play` returns them\n    fn status(&self, sim: &Sim) -> serde_json::Value; // your state for tools and tests\n    fn outcome(&self) -> Outcome;                   // Playing | Won | Lost\n    fn bot(&self, sim: &Sim) -> InputFrame;         // what a good player would press now\n}\npub fn build(sim: &mut Sim, rest: Option<&str>) -> Result<()>; // the scene; sets sim.state.play\n```\nEvery method has a default. `build` gets the rest of a scene name `mygame/<rest>` (a level\nnumber, say). Each tick runs: behaviours, your `pre`, characters move (your inputs replace\ntheir own), physics, shots move and hit, your `post`. While `pre`/`post` run, your game is out\nof `sim.state.play`: use `self` for your state and `sim` for the world. In `post`, `events`\nalready holds this tick's events: read them to react (`Hit { target, .. }` names the\ncharacter a shot struck: it is stunned, knocked back and safe from shots for 0.6 s), and push\nyour own. From outside, `sim.play()?.get::<MyGame>()` reads your game; in a test,\n`sim.state.play.as_mut().unwrap().get_mut::<MyGame>().unwrap()` changes it.\n\n## Building blocks\n| You need | Use |\n|---|---|\n| The player | `sim.state.player`; it walks by the keys' `InputFrame` (`move_dir`, `buttons::JUMP`, `PRIMARY`...); `sim.feet(id)` is where a character stands (`pos` is its centre) |\n| Characters | `[[npc]]` in the level, or `sim.spawn_npc(name, feet, facing, PuppetDef::preset(BodyPlan::Blob), None, None)`; drive them from `pre` |\n| Pickups, hazards, scenery | `sim.spawn(Spawn::new(\"name\", pos).visual(Visual::new(shape, Color::hex(\"#7fe3ff\"))).behavior(Behavior::Spin { speed }))`; `sim.despawn(id)`; `sim.set_position(id, feet)` |\n| Moving platforms, emitters, spinners | `Behavior::Move`, `Rotate`, `Emitter`, `Spawner` (`entity.rs`), or `[[object]]` in the level |\n| Shots | `sim.state.projectiles.spawn(Projectile { pos, vel, radius, life, color, knockback, gravity, owner, team, damage })`: plain structs, stopped by walls; `Team::Enemy` shots hit characters (a `Hit` event), `Team::Player` shots hit things with `health` |\n| Pathfinding | `nav::NavGrid::for_room(sim)` (the level's walkable grid); `grid.path(from, to)`; `grid.flow(goal, reach)` steers many chasers at once; `grid.walkable(p)` |\n| Randomness | `sim.state.rng` only (`range`, `below`, `f32`): seeded, so a seed always plays the same |\n| Messages | `sim.say(\"text\")`: centre top for a few seconds |\n| Sound and effects | push `SimEvent`s from `pre`/`post`: `Coin`, `Pickup`, `Hit`, `Explosion`, `Shot`, `Jump`, `Land`... The renderer and the synth play them |\n| Tuning | your numbers: the level's `[game]`; the engine's: `pav params`, `pav set path=movement.speed value=4.5` (movement, physics, camera, view), and a level's `[params]` set them while in it |\n| Looks | the level's `[view]`; `pav look` lists looks and filters; `rooms/mix_match.toml` mixes styles per part |\n| Animation | characters animate procedurally; motion clips: `pav assets shelf=clip`, then `clips = [\"SET/Clip\"]` on an `[[npc]]` |\n\n## Rules that keep it working\n- **Same inputs and seed, same game.** Random numbers come from `sim.state.rng`; never read the\n  clock; never let `HashMap`/`HashSet` iteration order reach game state (`BTreeMap`, or sort).\n- **All game state lives in your struct or in entities**, and your struct is `Clone` + serde\n  (snapshots are clones; files and the replay hash are its CBOR). A cache that follows from\n  the level (a nav grid) is `#[serde(skip)]` and rebuilt when missing.\n- **`pav_core` has no window, GPU or audio code**, and game code must run in the browser: no\n  threads, blocking calls or file access (embed data with `include_str!`).\n- **Check with the tools, not by reading engine code.** If a tool or error message didn't tell\n  you what you needed, that is engine feedback.\n\n## Check your work (no screen needed)\n| Question | Command (`pav <tool>` or a `pav repl` line) |\n|---|---|\n| Can it be won? Lost? | `play bot=true seeds=10` (wins, seconds, the state of every run not won) |\n| What's on screen? | `capture width=640 height=360 out=out/a.png`; `filmstrip` for motion in one image; to watch the bot, repeat `play bot=true ticks=30` and `capture` in a `pav repl` |\n| Does a rule fire? | `input move=[1,0] ticks=30`, then `play` (HUD, outcome, `status`) |\n| Where is everything? | `entities`, `player`, `status` (with the state hash) |\n| Same every time? | `record_save path=out/r.json`, then `replay path=out/r.json` (checks the hash); `rewind`, `snapshot_save`/`snapshot_load` |\n| Is the level valid? | `room_check path=crates/pav_core/src/games/<key>.toml` |\n| Does it run fast? | `bench scene=<key> ticks=1200` |\n| Does it still pass? | `cargo test -p pav_core --test <key>`, `cargo clippy -p pav_core --all-targets -- -D warnings`, `cargo fmt --all` |\n\n## Ship it\n- **Window:** `cargo run -p pav_app -- --scene <key>` (Linux; `xvfb-run -a` without a display).\n  F5 restarts the game (Esc opens the menu).\n- **Windows `.exe`:** `scripts/build-windows.sh` (after `scripts/setup-linux.sh`).\n- **Browser, one file:** `scripts/build-web.sh --single-file --scene <key> --title \"My Game\"\n  --out out/mygame.html`: about 10 MB, runs from `file://` in Chrome or Edge (WebGPU).\n\n## Limits today\n- HUD: text lines only (captures draw them; `ui` reads them). Panels, bars or menus mean egui\n  code in `pav_ui` (draw it from `headless.rs` too, so the tools see it).\n- Drawing from game state without an entity (`pav_view::assets::emit_asset`) and new sounds\n  (`pav_audio`, a closed list) mean code outside `pav_core`.\n- Your game compiles into the engine crate (`pav_core/src/games/`), beside Shardfall.\n- The camera follows the player with the level's `[camera]` settings; there is no\n  per-game camera code. Keep levels about 20 m across, or raise `[camera] distance`.\n- The window's controls card lists the engine demo's keys (bombs, vehicles), not your game's.\n\n## Report back\nWhen you hand the game back, add a short **engine feedback** section, written for an engine\nagent who has never seen your work: what you used, the engine source you had to read and\nwhy, what you wrote that the engine should have had (with the file), wrong or missing docs,\nand the one change that would have helped most. The maintainers log it in\n`docs/FEEDBACK.md`, and what keeps coming back becomes engine work.\n//! The starter game, and the template for a new one: collect every shard while slimes chase\n//! you round the walls. Three lives; a slime's touch sends everyone back to the start.\n//!\n//! To start a game of your own, copy this file and `starter.toml` to `<key>.rs` and\n//! `<key>.toml`, change `KEY`, add its line to `GAMES` in `mod.rs`, then change the rules.\n//! `docs/MAKE_A_GAME.md` walks through it.\n\nuse std::collections::BTreeMap;\nuse std::sync::Arc;\n\nuse anyhow::{Result, anyhow};\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\nuse serde_json::json;\n\nuse super::{Game, GameBox, Outcome};\nuse crate::color::Color;\nuse crate::entity::{Behavior, EntityId, Spawn};\nuse crate::frame::SimEvent;\nuse crate::input::InputFrame;\nuse crate::nav::NavGrid;\nuse crate::room::RoomDef;\nuse crate::shape::{Shape, Visual};\nuse crate::sim::Sim;\n\n/// The level, a room file, built in (the browser has no files). Running from the repository,\n/// `level_text` reads the file on disk instead, so an edit shows at the next `load`.\nconst LEVEL: &str = include_str!(\"starter.toml\");\n\n/// The rules' numbers: the level's `[game]` table, each with a default, so balancing is an\n/// edit to the level and a `load` (no rebuild).\n#[derive(Clone, Serialize, Deserialize)]\n#[serde(default, deny_unknown_fields)]\npub struct Rules {\n    pub lives: u32,\n    /// Slime speed as a fraction of a walker's top speed (each slime gets ±15%, from the seed).\n    pub slime_speed: f32,\n    /// Slimes chase a player within this walking distance (m).\n    pub slime_sight: f32,\n    /// Feet closer than this (m) catch the player.\n    pub catch: f32,\n    /// Feet closer than this (m) to a shard pick it up.\n    pub pick: f32,\n    /// Seconds the player is safe at the start and after a catch.\n    pub grace: f32,\n}\n\nimpl Default for Rules {\n    fn default() -> Self {\n        Self { lives: 3, slime_speed: 0.5, slime_sight: 9.0, catch: 0.8, pick: 0.9, grace: 2.0 }\n    }\n}\n\n#[derive(Clone, Serialize, Deserialize)]\npub struct Starter {\n    pub rules: Rules,\n    /// Shards still on the floor.\n    pub shards: Vec<EntityId>,\n    pub total: usize,\n    pub slimes: Vec<EntityId>,\n    /// Each slime's start (feet) and speed.\n    pub homes: Vec<Vec3>,\n    pub speeds: Vec<f32>,\n    pub lives: u32,\n    /// Seconds the player is still safe from slimes.\n    pub grace: f32,\n    pub time: f32,\n    pub outcome: Outcome,\n    /// The walkable grid. It follows from the level alone, so it isn't saved: rebuilt when\n    /// missing (after a snapshot load).\n    #[serde(skip)]\n    nav: Option<Arc<NavGrid>>,\n}\n\n/// Builds the level, places the shards on its `shard` markers and starts the game.\npub fn build(sim: &mut Sim, _rest: Option<&str>) -> Result<()> {\n    let def = RoomDef::parse(&super::level_text(Starter::KEY, LEVEL)).map_err(|e| anyhow!(\"starter.toml: {e}\"))?;\n    let rules: Rules = toml::Value::Table(def.game.clone()).try_into().map_err(|e| anyhow!(\"starter.toml [game]: {e}\"))?;\n    crate::scenes::build_standalone_room(sim, Starter::KEY, def);\n    let mut shards = Vec::new();\n    for at in crate::scenes::markers(sim, \"shard\") {\n        let mut look = Visual::new(Shape::Box { half: Vec3::splat(0.2) }, Color::hex(\"#7fe3ff\"));\n        look.emissive = 0.8;\n        let shard = Spawn::new(\"shard\", at + Vec3::Y * 0.7).visual(look).behavior(Behavior::Spin { speed: 2.5 });\n        shards.push(sim.spawn(shard));\n    }\n    // Slimes come from the level's [[npc]] entries; the game drives them.\n    let slimes: Vec<EntityId> = sim.state.entities.iter().filter(|e| e.name == \"slime\").map(|e| e.id).collect();\n    let homes = slimes.iter().filter_map(|&id| sim.feet(id)).collect();\n    // Randomness comes from the sim's seeded generator, so a seed always plays the same.\n    let speeds = slimes.iter().map(|_| rules.slime_speed * sim.state.rng.range(0.85, 1.15)).collect();\n    let game = Starter {\n        total: shards.len(),\n        shards,\n        slimes,\n        homes,\n        speeds,\n        lives: rules.lives,\n        grace: rules.grace,\n        rules,\n        time: 0.0,\n        outcome: Outcome::Playing,\n        nav: None,\n    };\n    sim.state.play = Some(GameBox::new(game));\n    Ok(())\n}\n\nimpl Game for Starter {\n    const KEY: &'static str = \"starter\";\n\n    fn pre(\n        &mut self,\n        sim: &mut Sim,\n        _input: &InputFrame,\n        _dt: f32,\n        _events: &mut Vec<SimEvent>,\n    ) -> BTreeMap<EntityId, InputFrame> {\n        let mut out = BTreeMap::new();\n        if self.outcome != Outcome::Playing {\n            // Decided: everyone stands still.\n            for &id in sim.state.player.iter().chain(&self.slimes) {\n                out.insert(id, InputFrame::default());\n            }\n            return out;\n        }\n        if self.nav.is_none() {\n            self.nav = NavGrid::for_room(sim).map(Arc::new);\n        }\n        let Some(nav) = self.nav.clone() else { return out };\n        // One flow field toward the player steers every slime round the walls.\n        let player = sim.state.player.and_then(|id| sim.feet(id));\n        let field = player.filter(|_| self.grace <= 0.0).and_then(|p| nav.flow(p, self.rules.slime_sight));\n        for (&id, &speed) in self.slimes.iter().zip(&self.speeds) {\n            let mut input = InputFrame::default();\n            if let (Some(field), Some(at)) = (&field, sim.feet(id))\n                && let Some(d) = field.dir(&nav, at)\n            {\n                input.move_dir = Vec2::new(d.x, d.z) * speed;\n            }\n            out.insert(id, input);\n        }\n        out\n    }\n\n    fn post(&mut self, sim: &mut Sim, dt: f32, events: &mut Vec<SimEvent>) {\n        if self.outcome != Outcome::Playing {\n            return;\n        }\n        self.time += dt;\n        self.grace = (self.grace - dt).max(0.0);\n        let Some(pid) = sim.state.player else { return };\n        let Some(p) = sim.feet(pid) else { return };\n\n        // Shards: walk over one to pick it up.\n        let near: Vec<(EntityId, Vec3)> = self\n            .shards\n            .iter()\n            .filter_map(|&id| sim.state.entities.get(id).map(|e| (id, e.pos)))\n            .filter(|(_, at)| flat(*at - p) < self.rules.pick)\n            .collect();\n        for (id, at) in near {\n            self.shards.retain(|&s| s != id);\n            sim.despawn(id);\n            events.push(SimEvent::Coin { pos: at });\n            let left = self.shards.len();\n            sim.say(if left == 1 { \"1 shard to go\".to_string() } else { format!(\"{left} shards to go\") });\n        }\n        if self.shards.is_empty() {\n            self.outcome = Outcome::Won;\n            sim.say(format!(\"All shards in {:.1} s!\", self.time));\n            return;\n        }\n\n        // Slimes: a touch costs a life and sends everyone back to the start.\n        let catch = self.rules.catch;\n        let caught = self.grace <= 0.0 && self.slimes.iter().any(|&id| sim.feet(id).is_some_and(|s| flat(s - p) < catch));\n        if caught {\n            self.lives -= 1;\n            events.push(SimEvent::Hit { pos: p + Vec3::Y, strength: 1.0, target: Some(pid) });\n            if self.lives == 0 {\n                self.outcome = Outcome::Lost;\n                sim.say(\"Caught! Game over\");\n                return;\n            }\n            sim.say(format!(\"Caught! {} lives left\", self.lives));\n            let spawn = sim.state.spawn;\n            sim.set_position(pid, spawn);\n            for (&id, &home) in self.slimes.iter().zip(&self.homes) {\n                sim.set_position(id, home);\n            }\n            self.grace = self.rules.grace;\n        }\n    }\n\n    fn hud(&self, _sim: &Sim) -> Vec<String> {\n        let mut lines =\n            vec![format!(\"Shards {}/{}\", self.total - self.shards.len(), self.total), format!(\"Lives {}\", self.lives)];\n        match self.outcome {\n            Outcome::Won => lines.push(format!(\"You win! {:.1} s\", self.time)),\n            Outcome::Lost => lines.push(\"Game over\".into()),\n            Outcome::Playing => {}\n        }\n        lines\n    }\n\n    fn status(&self, sim: &Sim) -> serde_json::Value {\n        let xz = |id: EntityId| sim.feet(id).map(|f| [round(f.x), round(f.z)]);\n        json!({\n            \"outcome\": self.outcome,\n            \"time\": round(self.time),\n            \"shards_left\": self.shards.len(),\n            \"total\": self.total,\n            \"lives\": self.lives,\n            \"grace\": round(self.grace),\n            \"player\": sim.state.player.and_then(xz),\n            \"shards\": self.shards.iter().filter_map(|&id| sim.state.entities.get(id).map(|e| [round(e.pos.x), round(e.pos.z)])).collect::<Vec<_>>(),\n            \"slimes\": self.slimes.iter().filter_map(|&id| xz(id)).collect::<Vec<_>>(),\n        })\n    }\n\n    fn outcome(&self) -> Outcome {\n        self.outcome\n    }\n\n    /// Takes the shortest walk to a shard that keeps clear of slimes (cells near them count\n    /// as walls); with every shard cut off, makes for the reachable spot farthest from them.\n    fn bot(&self, sim: &Sim) -> InputFrame {\n        let mut input = InputFrame::default();\n        let Some(p) = sim.state.player.and_then(|id| sim.feet(id)) else { return input };\n        let Some(mut grid) = self.nav.as_deref().cloned().or_else(|| NavGrid::for_room(sim)) else { return input };\n        let slimes: Vec<Vec3> = self.slimes.iter().filter_map(|&id| sim.feet(id)).collect();\n        if self.grace < 0.5 {\n            for i in 0..grid.blocked.len() {\n                if slimes.iter().any(|&s| flat(grid.center(i) - s) < 1.8) {\n                    grid.blocked[i] = true;\n                }\n            }\n        }\n        let paths = self.shards.iter().filter_map(|&id| sim.state.entities.get(id)).filter_map(|e| grid.path(p, e.pos));\n        let path = paths.min_by(|a, b| length(p, a).total_cmp(&length(p, b))).or_else(|| {\n            let clearance = |i: usize| slimes.iter().map(|&s| flat(grid.center(i) - s)).fold(f32::MAX, f32::min);\n            let reach = grid.flow(p, 6.0)?;\n            let safest = (0..grid.blocked.len())\n                .filter(|&i| reach.dist[i].is_finite())\n                .max_by(|&a, &b| clearance(a).total_cmp(&clearance(b)))?;\n            grid.path(p, grid.center(safest))\n        });\n        input.move_dir = path.map(|path| flat_dir(path[0] - p)).unwrap_or_default();\n        input\n    }\n}\n\nfn flat(v: Vec3) -> f32 {\n    Vec2::new(v.x, v.z).length()\n}\n\nfn flat_dir(v: Vec3) -> Vec2 {\n    Vec2::new(v.x, v.z).normalize_or_zero()\n}\n\n/// Walking length of a path from `p`.\nfn length(p: Vec3, path: &[Vec3]) -> f32 {\n    let (mut at, mut sum) = (p, 0.0);\n    for &q in path {\n        sum += flat(q - at);\n        at = q;\n    }\n    sum\n}\n\nfn round(x: f32) -> f64 {\n    (x as f64 * 100.0).round() / 100.0\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc 'for name in session.js harness.html bridge.js round.js; do curl -fsSL \"https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/$name\" -o \"Wobble-Wit-Wii-Fit-gpt-6.1-sol-max-20261104-222458/hub/$name\"; done; du -sh Wobble-Wit-Wii-Fit-gpt-6.1-sol-max-20261104-222458/engine; rustup show'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc 'for name in session.js harness.html bridge.js round.js; do curl -fsSL \"https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/$name\" -o \"Wobble-Wit-Wii-Fit-gpt-6.1-sol-max-20261104-222458/hub/$name\"; done; du -sh Wobble-Wit-Wii-Fit-gpt-6.1-sol-max-20261104-222458/engine; rustup show'","aggregated_output":"107M\tWobble-Wit-Wii-Fit-gpt-6.1-sol-max-20261104-222458/engine\nDefault host: x86_64-unknown-linux-gnu\nrustup home:  /home/micha/.rustup\n\ninstalled toolchains\n--------------------\nstable-x86_64-unknown-linux-gnu (active, default)\n1.96.0-x86_64-unknown-linux-gnu\n1.98.1-x86_64-unknown-linux-gnu\n\nactive toolchain\n----------------\nname: stable-x86_64-unknown-linux-gnu\nactive because: it's the default toolchain\ninstalled targets:\n  x86_64-unknown-linux-gnu\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"cat AGENTS.md crates/pav_core/src/games/mod.rs crates/pav_core/src/input.rs; sed -n '1,180p' crates/pav_core/src/frame.rs; cat scripts/build-web.sh\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"cat AGENTS.md crates/pav_core/src/games/mod.rs crates/pav_core/src/input.rs; sed -n '1,180p' crates/pav_core/src/frame.rs; cat scripts/build-web.sh\"","aggregated_output":"# AGENTS.md — rulebook for coding agents\n\nMaking a new game on the engine? Read `docs/MAKE_A_GAME.md`: the \"Key rules\" below apply to\nyour game, the maintainers' workflow (HISTORY, PROGRESS, PRs, escalations) doesn't.\n\nShardfall is a procedural hack-and-slash game built on the Pavilion engine, written in Rust. The\nprinciples are in `docs/DOCTRINE.md`, which outranks everything else here. The current state is\n`docs/PROGRESS.md` (one page). Read both before starting; Claude Code loads them, with this file,\nthrough `CLAUDE.md`. The design is in `docs/DESIGN.md` (engine) and `docs/GAME.md` (Shardfall):\nread them when your work touches the design. `docs/REFERENCE.md` holds the full code map, every\ntool family with examples, the controls and what each test suite covers: open the section you\nneed. The journal and past decisions are in `docs/HISTORY.md`, newest first: search it, don't\nread it whole. For a standalone Linux source handoff, `START_HERE.md` covers setup and headless\nCLI examples.\n\n## How the doctrine applies here\nAdopted 2026-10-09, partway through development. Code from before then isn't rewritten to fit;\nfix a mismatch when it gets in the way.\n- **Platform (5, 10):** the development platform is Linux, where agents build and test. The\n  user's Windows `.exe` and the browser build count as part of the target too: a problem the user\n  can see gets fixed now. Replays are promised to match only on the machine that recorded them; to\n  chase something the user saw, start from a snapshot taken just before it.\n- **Renderer (6):** wgpu is the WebGPU implementation: Vulkan on Linux and Windows (DX12 as a\n  Windows option), the browser's own WebGPU on the web, lavapipe where there's no GPU. GPU compute\n  stays cosmetic. The game UI is egui.\n- **API and internals (7, 8):** the game (`pav_core/src/arpg/`) still lives inside the engine\n  crate, so the compiler doesn't enforce the line. The engine modules the game uses are its API:\n  `sim`, `entity`, `frame`, `rng`, `input`, `params`, `statics`, `nav`, `zones`, `character`,\n  `projectile`, `puppet`, `parts`, `moves`, `clips`, `shape`, `color`, `fxdef`, and `games` (the\n  hook a new game implements: `docs/MAKE_A_GAME.md`). Everything else\n  (renderer, physics wiring, synth, importers) is internals. If game work means reading\n  internals, fix the API or the error message.\n- **Versions (9):** current pins stay (Rust 1.98.1, wgpu 30, rapier 0.36, egui 0.36, glam 0.33,\n  cpal 0.18). The rule applies to new dependencies and to upgrades.\n- **Assets (4):** no image, model, texture or audio files; fonts are allowed. Animation and\n  objects are readable text: key poses (`anim/*.json`, the format `clips.rs` documents, made with\n  `clip_import`) and props made of named primitive parts (`assets/props`, `docs/ASSET_STUDIO.md`).\n  Raw downloads (.glb, .gltf, .obj, .fbx, .bvh, .amc) go to `.cache/` (git-ignored); never commit\n  them, or images. Keep each source's credit and licence. Libraries whose licences forbid sharing\n  what is made from them (Bandai Namco, LaFAN1, Mixamo) are translated only into the git-ignored\n  local tiers (`anim/local`, `assets/props/local`).\n- **Escalation:** ask in chat and log it in `docs/ESCALATIONS.md`. If you can schedule a check-in\n  (e.g. `send_later`), set one for 15 minutes and carry on with other work; if not, make the call,\n  log it and continue.\n- **Pavilion Lite** (`pavilion-lite/`) is frozen: its renderer runs on the CPU, not WebGPU (6),\n  so it isn't developed further (`docs/ESCALATIONS.md`).\n\n## Working rules\nUnder the doctrine, in priority order:\n1. **Gameplay first, then robustness.**\n2. **Use tools.** If a tool does a job faster, more accurately or cheaper over time, use or build one.\n3. **It must still run well on a modern PC** (the user's RTX 3060 Ti and 4070 Super). Other\n   optimization and compatibility wait (10).\n4. **Approximations are fine if they feel right.** Feel beats physical accuracy.\n5. **Check selectively.** Verify what often breaks or is expensive to debug; skip routine checks\n   of things that almost never break. \"If it's broken, the user will say so\" is valid.\n6. **Cost over speed.** Prefer the CLI/capture tools over reading lots of code.\n\n## Testing budget (prototype stage)\nEvery engine here is a prototype with one user: spend on finding what clearly helps, not on\nmeasuring exactly how much. Completion comes first: a test decides how something is built and is\nrecorded; it never stops, skips or reverts planned work.\n- **Test only to change a decision.** Before a test, name the choice it decides and its cost in\n  US$ as Claude Code bills it, subagents included. If no choice rides on it, or a wrong choice\n  would cost less than the test, skip it. Afterwards, report what it cost.\n- **Size the test to the gap.** Agent runs (benchmarks, judges, eval agents) start small: 3-5 per\n  arm. A clear gap decides it: 2:1 or better in wins, or 25% or more in cost, model calls or\n  errors.\n- **Near 50/50, make the call.** If the first batch is within 60/40 (or 10%), stop: the options\n  are about equally good, so the choice matters little (Fredkin's paradox). Take the simpler,\n  cheaper or more reversible option, log the call and why, and move on. Between clear and close:\n  at most one more small batch, then decide.\n- **Close calls belong to tool tests.** Checks with no model calls (cargo tests, `pav` checks and\n  captures, scripted counts) cost almost nothing per run and repeat exactly, so they may scale up\n  to settle narrow margins. Even then, don't chase gains under 5%; timing differences under 10%\n  are noise.\n- Looks and feel are the expensive, noisy kind: prefer objective proxies; use agent judges only for\n  large, obvious differences, few of them, several items per call; leave fine visual judgement to\n  the user on a quick comparison page.\n- Explore broadly: test distinct hypotheses, not variations of one. Don't add or keep code without\n  a verified benefit.\n- Count cost end to end, in US$, not one tool's traffic: every model call re-reads the agent's\n  whole context.\n- Assets made through the documented loop (a brief, `check` to zero findings, a 4-view sheet at\n  the game camera, at most two fix rounds, `publish` with a review) need no human review: the user\n  accepted 28 of 28 (2026-10-12). Show the user only edge cases, or complex ones you are unsure of.\n- Per PR (from 2026-10-16):\n  - Run the full checks (tests of the touched crates, clippy, fmt, the wasm check when the app\n    builds the change) once, on the head you merge.\n  - After a rebase or a small fix, run only the tests of what changed. A docs-only PR needs none.\n  - Merge as soon as the checks pass; don't wait for a review (Codex has posted none since #45 on\n    2026-10-12). A review that arrives later: fix its real findings in a follow-up PR.\n  - Nothing deploys: there is no hosted site. After a merge that can change the game, build the\n    single-file HTML and send it to the user (`CLAUDE.md`, \"Builds for playing and testing\").\n\n## Architecture\nCrates (the full map, module by module: `docs/REFERENCE.md`, \"Code map\"):\n- `pav_core`: the simulation, with no window, GPU or audio dependencies: `Sim`, entities, physics\n  (rapier3d), the world, rooms and terrain, characters and puppets, moves and clips, AI and nav,\n  props and materials; the game lives in `src/arpg/`.\n- `pav_render`: the wgpu renderer: shadows, bloom and post effects, the filter stack, procedural\n  meshes and materials, offscreen capture to PNG.\n- `pav_view`: sim frame -> render scene: the camera rig, looks and filters, water, `emit_asset`.\n- `pav_audio`: synthesized sound: cpal output, offline .wav rendering.\n- `pav_tools`: the agent layer: the tool registry, the `pav` CLI and REPL, the MCP server, the\n  live bridge client, and the motion and asset importers.\n- `pav_ui`: Shardfall's egui UI (HUD, inventory, passive tree, touch controls), drawn by the\n  window and, headless, by the tools (`ui`, captures).\n- `pav_app`: the game (`shardfall` binary): window, input, sim thread, live bridge server, the\n  pavilion's egui UI; native and wasm32.\n\nData: `anim/` (moves and motion clips), `rooms/` (room files, embedded in the exe and hot-reloaded;\n`_template.toml` documents every field), `game/` (Shardfall's data), `assets/` (props, materials,\nmodel catalogs), `store/` (the asset store's tables).\nData flow: `Sim::step(InputFrame)` (fixed tick, own thread) -> `Sim::frame()` -> `RenderFrame`\n-> `pav_view::ViewBuilder::build` (interpolates prev/curr) -> `pav_render::Scene` -> `Renderer`.\n\nKey rules:\n- `pav_core` must never depend on graphics, windowing or audio crates.\n- Everything that changes during play lives in `SimState` (cloning it = snapshot). Keep it `Clone`.\n- Same inputs and seed, same state (doctrine 5): randomness comes from `rng`, seeded (the sim's\n  `Rng`, or its hash for seed-derived content), never from the clock; don't let\n  `HashMap`/`HashSet` iteration order reach game state (use a `BTreeMap` or sort).\n- Gameplay code reads plain struct fields; expose tunables via `impl Tunable` (see `params.rs`).\n  Tunables are automatically in the tuning panel, the `params`/`set` tools and preset files.\n- Colors in data are sRGB hex (`Color::hex(\"#e8704a\")`); internally linear.\n- Physics precision switch: in `crates/pav_core/Cargo.toml` change `package = \"rapier3d\"` to\n  `\"rapier3d-f64\"`.\n\n## Build, run, test\n```sh\nscripts/setup-linux.sh             # once per machine (apt packages, lavapipe, mingw, wine)\ncargo build                        # everything (Linux)\ncargo test                         # every crate's tests (`-p pav_core` for one crate)\ncargo fmt --all --check            # formatting\ncargo clippy -p pav_core --all-targets -- -D warnings  # lints, for each crate you touched\ncargo run -p pav_app               # the game (needs a display; Xvfb works with lavapipe)\nscripts/build-windows.sh           # -> target/x86_64-pc-windows-gnu/dist/shardfall.exe\nscripts/smoke-windows.sh 25        # run the .exe under Wine+lavapipe, screenshot + log in out/smoke/\nscripts/smoke-linux.sh 10          # same for the native Linux build\nscripts/build-web.sh               # browser build -> target/web/ (serve over HTTP; Chrome/Edge)\nscripts/build-web.sh --single-file # -> target/web/shardfall.html: one ~10 MB page, runs from file://\nscripts/check-wgsl.sh              # after any WGSL change: Chromium's Tint compiles every module\n```\n`--single-file` packs web/index.html, the JS glue and the gzipped wasm into one page with no\nother loads (`scripts/pack_single_html.py`; `--title --description --theme-color --scene NAME --out PATH`).\nBrowser build: `cfg(target_arch = \"wasm32\")` code lives in `pav_app` (no threads, async GPU\nsetup); other crates only skip disk access there (the browser has no files) or pick its GPU\nbackend. Check it with `cargo clippy -p pav_app --target wasm32-unknown-unknown`. Headless\nChromium runs it only with the right flags (WebGPU on SwiftShader); those and phone emulation are\nin `docs/REFERENCE.md`, \"Browser and phones\".\nDisk: cloud containers have a fixed allowance. Dev builds use line-table debug info and no\nincremental cache; if the disk fills up anyway, delete stale binaries in `target/debug/deps`\n(or run `cargo clean`).\n\n## Agent CLI (`pav`) and MCP\nEvery tool works headless (captures use lavapipe when there is no GPU). The same tools are an\nMCP server: `.mcp.json` registers `pav mcp` (stdio), so Claude Code agents in this repo get\nthem as `mcp__shardfall__*` tools (captures come back as images). `pav help` lists every tool\nand its arguments; `docs/REFERENCE.md` (\"Tools\") shows each family with examples.\n```sh\ncargo run -q -p pav_tools --bin pav -- help\npav bench ticks=1200                          # ticks/sec\npav capture scene=test ticks=300 out=out/a.png\nprintf 'step ticks=200\\ncamera preset=top\\ncapture out=out/b.png\\n' | pav repl\nprintf 'input move=[1,0] ticks=30\\ninput press=jump move=[0,1] ticks=40\\nplayer\\n' | pav repl\n```\n- One-shot calls accept `scene=`, `seed=` and `ticks=` to set up the session first. `pav repl`\n  keeps one session across lines (`tool key=value ...` or JSON lines\n  `{\"tool\":\"name\",\"args\":{...}}`; `#` = comment).\n- `input` drives the player: `move=[x,z]` world direction (x = east, z = south), `hold=`/`press=`\n  buttons (jump, crouch, crawl, use, focus, interact, primary), `aim=[x,y,z]`, `ticks=N`.\n- Look at captures with your image-reading tool; prefer small sizes (e.g. `width=640 height=360`).\n  `filmstrip` tiles N frames into one PNG: the cheapest way to check motion and animation.\n- `record_save` + `replay` reproduce a session exactly (same machine/build) and check the hash:\n  use them for bug reports.\n- Live bridge: start the game with `--bridge` (or `bridge = \"127.0.0.1:7878\"` in shardfall.toml),\n  then `pav live` is a REPL into the running game and `pav mcp --live` an MCP server for it. Same\n  tools; they act on what is on screen (captures render the game's camera on a second device).\n- Studios edit on the live bridge, each with its own doc: Animation (`shardfall\n  --animation-studio`, `.mcp.animation-studio.json`, `docs/ANIMATION_STUDIO.md`), Object\n  (`--asset-studio`, `.mcp.studio.json`, `docs/ASSET_STUDIO.md` and `docs/ASSET_STUDIO_LIVE.md`;\n  materials `docs/MATERIALS.md`) and Creature (`--creature-studio`, `.mcp.studio.json`,\n  `docs/CREATURE_STUDIO.md`); `scripts/animation-studio.sh`, `asset-studio.sh` and\n  `creature-studio.sh` build and open each. Pass the last reply's `revision` as `if_revision`,\n  and copy a source clip or asset before changing it.\n- Game data and rooms may name only assets every build carries: embedded (BUILTIN, LIB/core) or a\n  shipped pack's (`props::store::SHIPPED`: the KayKit figures). Game code draws library assets\n  from its own state with `pav_view::assets::emit_asset` (`docs/ASSET_STUDIO.md`, \"Library\n  assets in game code\").\n- `tools/creature-compiler` vendors the exact SpawnForge pin: keep the pin and source hashes\n  intact; don't resolve against a moving upstream checkout.\n- Shardfall content: game data lives in `game/*.toml` (`game_reload` re-reads it live). Check a\n  change with the tools: `see` (a screenshot with numbered marks and a legend), `levelmap`,\n  `turntable`, `animsheet`, and `campaign from=1 to=12 wall=300` (the bot plays down through the\n  levels and reports each; run it after data changes).\n\nAsset store (`docs/AGENT_ASSET_STORE.md`): before making a prop or clip, `assets shelf=prop` (or `shelf=clip`) lists the best entries and `assets find=words` (`kind=clip` for motion) searches; a miss gives `none` and a route.\nIn the Workshop wing, `library_hall` shows every standard object (generated: after publishing to core, rebuild and run `pav assets reindex=store` and `pav assets reindex=hall`), `limits` what the checks catch and miss, `catalogue` pages through every store row, `store_showcase` shows the materials; the animation wing's `clip_browser` plays every clip.\n\nTools: `scenes load step status entities npcs params set camera capture bench gpu player input\nspawn despawn teleport rewind snapshot_save snapshot_load record_save replay rooms room goto\nroom_reset room_check room_reload stream signal filmstrip camera_bench course feel audio_capture`;\nlooks `look`; teaching `guide`; games on the hook `play`; Shardfall `game hero monster autoplay skills game_reload\nloot_roll give inventory game_cmd ui tree tree_map genome bestiary boss turntable animsheet level\nlevelmap go goto_feature see campaign theme_swatch`; animation `clips clip_import mocap\nanim_reload anim_edit anim_preview`; objects `assets asset_edit asset_preview asset_spawn\nasset_import studio_status`; creatures `creature_catalog creature_edit creature_preview\ncreature_status`.\n\n### Adding a tool\n1. Write `fn t_name(s: &mut Session, a: &Args) -> Result<Output>` in the tool family's module\n   (`asset_tools.rs`, `game_tools.rs`, ...); it rejects unknown arguments, naming the nearest.\n2. Add a `Tool { .. }` entry to `TOOLS` in `tools.rs` (help ≤ 50 tokens, each argument ≤ 12\n   words). It is then in the CLI, REPL and MCP.\n3. Put enums and op shapes in `schema()`; a new asset kind is a `KIND_ROUTES` row, not a new tool.\n4. Add actions that change what the live studio shows to `live_feedback::changes_studio`.\n5. Add a clause to the `mcp.rs` instructions if agents should find the tool first.\n6. Test it on `Session::new(\"empty\", 1)`.\n\n### Adding a room (preferred: data only, no rebuild)\nCopy `rooms/_template.toml` to `rooms/<key>.toml` and edit; the template documents every field\n(`rooms/feel_lab.toml` and `crates/pav_core/tests/physics_room.toml` are full examples). The room\nis placed on its wing's corridor automatically. Every room is a station of the world demo and\nteaches: give it a `[learn]` block and a `note` on every pad that changes something\n(`pav_view/tests/learn.rs` checks them; `rooms/bloom.toml` is the model). Check it with\n`pav room_check path=rooms/<key>.toml`; look at it with `pav capture scene=<key>` (the room alone,\nfast) or `printf 'load scene=world\\ngoto room=<key>\\ncapture\\n' | pav repl`. The running game\nhot-reloads room files. New *mechanics* are Rust (character.rs / sim.rs behaviours / entity\nfields); keep rooms as data wherever possible.\n\n### Scenes\n`world` (pavilion + rooms + streaming wilderness), `world/<room>` (start in a room),\n`<room key>` (that room alone, no terrain), `test`, `empty`, and Shardfall's `town` (the game\nstarts here by default; the saved hero is loaded into any game scene), `arena`, `lab` (the\nMenagerie of creatures) and `level/<n>` (depth n: 1-12 designed, then the endless Depths).\nGames built on the hook (`pav_core::games::GAMES`) are scenes by their key: `starter` today.\nCode scenes live in `scenes.rs` (Shardfall places in `arpg/scene.rs`).\n\n## Tests\n`cargo test` runs every suite; `cargo test -p <crate> --test <suite>` runs one. Suites live in\n`crates/*/tests/`, named for what they cover (`docs/REFERENCE.md`, \"Tests\", describes each).\n`pav_core/tests/gameplay.rs` and `movement.rs` are the cheapest way to catch feel regressions:\nextend them when you add movement features. `pav_view/tests/material_parity.rs` needs a GPU (or\nlavapipe); `pav_tools/tests/import_khronos.rs` is opt-in (`-- --ignored`).\n\n## Conventions\n- Rust stable pinned in `rust-toolchain.toml`; `Cargo.lock` committed; edition 2024.\n- Finished work gets a dated entry at the top of `docs/HISTORY.md` (what changed, how it works,\n  the decisions); then update `docs/PROGRESS.md`, which stays one page of current state.\n- Decide anything that isn't genuinely the user's call; record the decision with its entry in\n  `docs/HISTORY.md`. Escalate what the doctrine says to escalate, and log it in\n  `docs/ESCALATIONS.md`.\n- Finishing a task or milestone: commit, push, open a PR into `main`, merge it and delete the\n  branch. This is standard procedure (the user's standing instruction, which counts as asking for\n  the PR); don't ask first.\n- The user plays the Windows build; the log file `shardfall.log` and `shardfall.toml` (startup\n  settings, e.g. `backend = \"dx12\"`) sit next to the `.exe`.\n- Keep this file short: under 32 KiB (Codex reads no further; `docs_limits.rs` checks it) and\n  about 250 lines. Detail goes to `docs/REFERENCE.md` or a topic doc, with a pointer here.\n\n## Code Review Rules\nFor reviewers (Codex when it runs, or `/code-review`). Flag a change that:\n- breaks one of the \"Key rules\" under Architecture: a graphics, windowing or audio dependency in\n  `pav_core`, play state outside a `Clone` `SimState`, results that can differ between runs on one\n  machine (unseeded randomness, the clock, `HashMap`/`HashSet` iteration order);\n- commits a binary asset other than a font, or content a licence keeps in the local tiers;\n- makes threads, blocking calls or file access reachable on `wasm32`.\nLeave style, wording and test coverage of routine code alone: this is a one-user prototype\n(\"Working rules\" 5, \"Testing budget\").\n//! Games built on the engine: the hook a new game implements, and the list of games.\n//!\n//! A game is a struct holding its rules' state (`Clone` and serde, like everything in\n//! `SimState`) that implements [`Game`], plus a `build` function that makes its scene. One\n//! line in [`GAMES`] and `load scene=<key>` starts it in the tools, the window\n//! (`shardfall --scene <key>`) and the browser (`?scene=<key>`). `starter.rs` is the template\n//! to copy; `docs/MAKE_A_GAME.md` is the guide. Shardfall (`crate::arpg`) predates this hook and\n//! keeps its own.\n\nuse std::any::Any;\nuse std::collections::BTreeMap;\n\nuse anyhow::Result;\nuse serde::de::{DeserializeOwned, Error as _};\nuse serde::{Deserialize, Deserializer, Serialize, Serializer};\n\nuse crate::entity::EntityId;\nuse crate::frame::SimEvent;\nuse crate::input::InputFrame;\nuse crate::sim::Sim;\n\npub mod starter;\n\n/// Every game the engine knows. `load scene=<key>` (or `<key>/<rest>`) builds it.\npub static GAMES: &[Entry] =\n    &[entry::<starter::Starter>(\"Starter: collect every shard while slimes chase you (the template to copy).\", starter::build)];\n\n/// Still playing, won or lost.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum Outcome {\n    #[default]\n    Playing,\n    Won,\n    Lost,\n}\n\n/// A game's rules. Every method has a default, so a game implements only what it uses.\n///\n/// The engine calls `pre` and `post` once per tick (60 a second) from `Sim::step`; everything\n/// else is read-only. While `pre` or `post` runs, the game is out of `sim.state.play`, so use\n/// `self` for the game's own state and `sim` for the world.\npub trait Game: Clone + Serialize + DeserializeOwned + Send + Sync + 'static {\n    /// The scene key that starts the game: `load scene=<KEY>`, `--scene <KEY>`, `?scene=<KEY>`.\n    const KEY: &'static str;\n\n    /// Before characters move: read the player's input and decide what the characters the\n    /// game drives do this tick. A returned input replaces that character's own (its `ai`\n    /// brain, or the player's keys for the player).\n    fn pre(\n        &mut self,\n        _sim: &mut Sim,\n        _input: &InputFrame,\n        _dt: f32,\n        _events: &mut Vec<SimEvent>,\n    ) -> BTreeMap<EntityId, InputFrame> {\n        BTreeMap::new()\n    }\n\n    /// After physics: the rules (pickups, damage, score, win and loss). Push `SimEvent`s for\n    /// sounds and effects (`Coin`, `Pickup`, `Hit`, `Explosion`...).\n    fn post(&mut self, _sim: &mut Sim, _dt: f32, _events: &mut Vec<SimEvent>) {}\n\n    /// HUD lines: drawn at the top left of the window, returned by the `play` tool.\n    fn hud(&self, _sim: &Sim) -> Vec<String> {\n        Vec::new()\n    }\n\n    /// The game's state for tools and tests (`play`), as JSON.\n    fn status(&self, _sim: &Sim) -> serde_json::Value {\n        serde_json::Value::Null\n    }\n\n    fn outcome(&self) -> Outcome {\n        Outcome::Playing\n    }\n\n    /// The input a good player would give this tick. `play bot=true` and the tests drive the\n    /// player with it; teach it every new rule, and keep a test that it wins.\n    fn bot(&self, _sim: &Sim) -> InputFrame {\n        InputFrame::default()\n    }\n}\n\n/// One line of [`GAMES`]: made with [`entry`].\npub struct Entry {\n    pub key: &'static str,\n    pub about: &'static str,\n    /// Builds the scene and sets `sim.state.play`. The `&str` is the rest of the scene name\n    /// after `<key>/` (a level number, say), if any.\n    pub build: fn(&mut Sim, Option<&str>) -> Result<()>,\n    load: fn(ciborium::Value) -> Result<GameBox, String>,\n}\n\n/// A [`GAMES`] line for the game type `G`.\npub const fn entry<G: Game>(about: &'static str, build: fn(&mut Sim, Option<&str>) -> Result<()>) -> Entry {\n    Entry { key: G::KEY, about, build, load: load_as::<G> }\n}\n\nfn load_as<G: Game>(v: ciborium::Value) -> Result<GameBox, String> {\n    v.deserialized::<G>().map(GameBox::new).map_err(|e| e.to_string())\n}\n\n/// A game's level text: `crates/pav_core/src/games/<key>.toml` read from disk when the program\n/// runs from the repository's root (`pav`, `cargo run`), so an edit shows at the next `load`\n/// with no rebuild; else `built_in`, the copy embedded with `include_str!` (tests, the browser,\n/// a shipped executable).\npub fn level_text(key: &str, built_in: &'static str) -> std::borrow::Cow<'static, str> {\n    #[cfg(not(target_arch = \"wasm32\"))]\n    if let Ok(text) = std::fs::read_to_string(format!(\"crates/pav_core/src/games/{key}.toml\")) {\n        return text.into();\n    }\n    #[cfg(target_arch = \"wasm32\")]\n    let _ = key; // the browser has no files\n    built_in.into()\n}\n\n/// The game registered under `key`.\npub fn find(key: &str) -> Option<&'static Entry> {\n    GAMES.iter().find(|g| g.key == key)\n}\n\n/// A running game in `SimState::play`: clones (rewind, snapshots) and serializes (snapshot\n/// files, the state hash) through the game's own derives.\npub struct GameBox(Box<dyn DynGame>);\n\nimpl GameBox {\n    pub fn new<G: Game>(game: G) -> Self {\n        Self(Box::new(game))\n    }\n\n    pub fn key(&self) -> &'static str {\n        self.0.key()\n    }\n\n    /// The game as its own type (None for another game).\n    pub fn get<G: Game>(&self) -> Option<&G> {\n        self.0.as_any().downcast_ref()\n    }\n\n    pub fn get_mut<G: Game>(&mut self) -> Option<&mut G> {\n        self.0.as_any_mut().downcast_mut()\n    }\n\n    pub fn hud(&self, sim: &Sim) -> Vec<String> {\n        self.0.hud(sim)\n    }\n\n    pub fn status(&self, sim: &Sim) -> serde_json::Value {\n        self.0.status(sim)\n    }\n\n    pub fn outcome(&self) -> Outcome {\n        self.0.outcome()\n    }\n\n    pub fn bot(&self, sim: &Sim) -> InputFrame {\n        self.0.bot(sim)\n    }\n}\n\nimpl Clone for GameBox {\n    fn clone(&self) -> Self {\n        Self(self.0.clone_box())\n    }\n}\n\n#[derive(Serialize, Deserialize)]\nstruct Saved {\n    key: String,\n    state: ciborium::Value,\n}\n\nimpl Serialize for GameBox {\n    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {\n        let state = self.0.save().map_err(serde::ser::Error::custom)?;\n        Saved { key: self.key().to_string(), state }.serialize(s)\n    }\n}\n\nimpl<'de> Deserialize<'de> for GameBox {\n    fn deserialize<D: Deserializer<'de>>(d: D) -> Result<Self, D::Error> {\n        let saved = Saved::deserialize(d)?;\n        let Some(entry) = find(&saved.key) else {\n            let known: Vec<&str> = GAMES.iter().map(|g| g.key).collect();\n            return Err(D::Error::custom(format!(\"unknown game '{}' (known: {})\", saved.key, known.join(\", \"))));\n        };\n        (entry.load)(saved.state).map_err(D::Error::custom)\n    }\n}\n\n/// [`Game`] as an object (the trait itself isn't one: `Clone` and serde).\ntrait DynGame: Send + Sync {\n    fn key(&self) -> &'static str;\n    fn clone_box(&self) -> Box<dyn DynGame>;\n    fn save(&self) -> Result<ciborium::Value, String>;\n    fn pre(&mut self, sim: &mut Sim, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) -> BTreeMap<EntityId, InputFrame>;\n    fn post(&mut self, sim: &mut Sim, dt: f32, events: &mut Vec<SimEvent>);\n    fn hud(&self, sim: &Sim) -> Vec<String>;\n    fn status(&self, sim: &Sim) -> serde_json::Value;\n    fn outcome(&self) -> Outcome;\n    fn bot(&self, sim: &Sim) -> InputFrame;\n    fn as_any(&self) -> &dyn Any;\n    fn as_any_mut(&mut self) -> &mut dyn Any;\n}\n\nimpl<G: Game> DynGame for G {\n    fn key(&self) -> &'static str {\n        G::KEY\n    }\n    fn clone_box(&self) -> Box<dyn DynGame> {\n        Box::new(self.clone())\n    }\n    fn save(&self) -> Result<ciborium::Value, String> {\n        ciborium::Value::serialized(self).map_err(|e| e.to_string())\n    }\n    fn pre(&mut self, sim: &mut Sim, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) -> BTreeMap<EntityId, InputFrame> {\n        Game::pre(self, sim, input, dt, events)\n    }\n    fn post(&mut self, sim: &mut Sim, dt: f32, events: &mut Vec<SimEvent>) {\n        Game::post(self, sim, dt, events)\n    }\n    fn hud(&self, sim: &Sim) -> Vec<String> {\n        Game::hud(self, sim)\n    }\n    fn status(&self, sim: &Sim) -> serde_json::Value {\n        Game::status(self, sim)\n    }\n    fn outcome(&self) -> Outcome {\n        Game::outcome(self)\n    }\n    fn bot(&self, sim: &Sim) -> InputFrame {\n        Game::bot(self, sim)\n    }\n    fn as_any(&self) -> &dyn Any {\n        self\n    }\n    fn as_any_mut(&mut self) -> &mut dyn Any {\n        self\n    }\n}\n\nimpl Sim {\n    /// The running game from [`GAMES`], if this scene is one.\n    pub fn play(&self) -> Option<&GameBox> {\n        self.state.play.as_ref()\n    }\n\n    /// The running game's outcome (`Playing` when there is none).\n    pub fn outcome(&self) -> Outcome {\n        self.play().map(|g| g.outcome()).unwrap_or_default()\n    }\n\n    /// The running game's bot input (none without a game).\n    pub fn bot_input(&self) -> InputFrame {\n        self.play().map(|g| g.bot(self)).unwrap_or_default()\n    }\n\n    pub(crate) fn play_pre(&mut self, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) -> BTreeMap<EntityId, InputFrame> {\n        let Some(mut g) = self.state.play.take() else { return BTreeMap::new() };\n        let out = g.0.pre(self, input, dt, events);\n        self.state.play = Some(g);\n        out\n    }\n\n    pub(crate) fn play_post(&mut self, dt: f32, events: &mut Vec<SimEvent>) {\n        let Some(mut g) = self.state.play.take() else { return };\n        g.0.post(self, dt, events);\n        self.state.play = Some(g);\n    }\n\n    pub(crate) fn play_hud(&self) -> Vec<String> {\n        self.play().map(|g| g.hud(self)).unwrap_or_default()\n    }\n\n    /// Plays the running game with its bot until it is won or lost, or `ticks` pass.\n    /// Returns the outcome and the ticks played.\n    pub fn run_bot(&mut self, ticks: u64) -> (Outcome, u64) {\n        for t in 0..ticks {\n            let o = self.outcome();\n            if o != Outcome::Playing {\n                return (o, t);\n            }\n            let input = self.bot_input();\n            self.step(&input);\n        }\n        (self.outcome(), ticks)\n    }\n}\n//! Device-independent input for one simulation tick. The host (window, agent, replay) fills\n//! it; the simulation never sees devices. Directions are already in world space.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\npub mod buttons {\n    pub const JUMP: u32 = 1 << 0;\n    pub const CROUCH: u32 = 1 << 1;\n    pub const INTERACT: u32 = 1 << 2;\n    pub const USE: u32 = 1 << 3;\n    pub const FOCUS: u32 = 1 << 4;\n    pub const SPRINT: u32 = 1 << 5;\n    pub const PRIMARY: u32 = 1 << 6;\n    pub const SECONDARY: u32 = 1 << 7;\n    pub const CRAWL: u32 = 1 << 8;\n    /// Shardfall: skill slots 3-6 (slots 1-2 are PRIMARY / SECONDARY), dodge and potion.\n    pub const SKILL3: u32 = 1 << 9;\n    pub const SKILL4: u32 = 1 << 10;\n    pub const SKILL5: u32 = 1 << 11;\n    pub const SKILL6: u32 = 1 << 12;\n    pub const DODGE: u32 = 1 << 13;\n    pub const POTION: u32 = 1 << 14;\n\n    pub const NAMES: &[(&str, u32)] = &[\n        (\"jump\", JUMP),\n        (\"crouch\", CROUCH),\n        (\"interact\", INTERACT),\n        (\"use\", USE),\n        (\"focus\", FOCUS),\n        (\"sprint\", SPRINT),\n        (\"primary\", PRIMARY),\n        (\"secondary\", SECONDARY),\n        (\"crawl\", CRAWL),\n        (\"skill3\", SKILL3),\n        (\"skill4\", SKILL4),\n        (\"skill5\", SKILL5),\n        (\"skill6\", SKILL6),\n        (\"dodge\", DODGE),\n        (\"potion\", POTION),\n    ];\n\n    pub fn from_name(n: &str) -> Option<u32> {\n        NAMES.iter().find(|(k, _)| k.eq_ignore_ascii_case(n)).map(|(_, v)| *v)\n    }\n}\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct InputFrame {\n    /// Desired movement on the ground plane: x = world +X, y = world +Z. Length <= 1.\n    pub move_dir: Vec2,\n    /// Vertical intent for climbing/flying/swimming (-1..1).\n    #[serde(default)]\n    pub vertical: f32,\n    /// World-space aim point (mouse on the ground plane, or stick projection).\n    #[serde(default)]\n    pub aim: Option<Vec3>,\n    /// Buttons held this tick.\n    #[serde(default)]\n    pub held: u32,\n    /// Buttons that went down since the previous tick (never lost, even for short taps).\n    #[serde(default)]\n    pub pressed: u32,\n    /// A menu action this tick (Shardfall: equip, sell, travel...), queued one per tick.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub cmd: Option<crate::arpg::GameCmd>,\n}\n\nimpl InputFrame {\n    pub fn down(&self, b: u32) -> bool {\n        self.held & b != 0\n    }\n    pub fn just(&self, b: u32) -> bool {\n        self.pressed & b != 0\n    }\n}\n//! What the simulation publishes for rendering each tick. Cheap to clone (static geometry is\n//! shared through `Arc`s).\n\nuse glam::{Quat, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse crate::entity::EntityId;\nuse crate::puppet::{PuppetDef, PuppetState};\nuse crate::shape::Visual;\nuse crate::statics::StaticWorld;\n\n/// Animation state of a character, drawn as a puppet.\n#[derive(Clone, Debug)]\npub struct PuppetFrame {\n    pub state: PuppetState,\n    /// Distance from the entity position (capsule centre) down to the feet.\n    pub feet_offset: f32,\n    /// Own look (NPCs); None = `RenderFrame::puppet_def`.\n    pub def: Option<std::sync::Arc<PuppetDef>>,\n    /// Creature feet and swinging chains.\n    pub rig: Option<crate::rig::RigView>,\n    /// Colour wash (hit flash, frozen, burning...) and its strength.\n    pub tint: Option<([f32; 3], f32)>,\n}\n\n#[derive(Clone, Debug)]\npub struct RenderObject {\n    pub id: EntityId,\n    pub pos: Vec3,\n    pub rot: Quat,\n    pub visual: Visual,\n    /// Immutable parts belonging to this one object ID.\n    pub prop: Option<crate::prop_instance::PropFrame>,\n    pub puppet: Option<PuppetFrame>,\n    /// Blink/highlight driver: bomb fuse seconds left, or < 0 for none.\n    pub pulse: f32,\n    /// Deformable body: particle positions and how to draw them.\n    pub soft: Option<SoftView>,\n    /// Car / helicopter parts (wheels, rotors).\n    pub vehicle: Option<crate::vehicle::VehicleView>,\n    /// A guard's vision cone.\n    pub cone: Option<crate::stealth::ConeView>,\n    /// Fixed scenery (no character, never moves, not a game actor): view filters treat it\n    /// as part of the environment rather than the characters and objects.\n    pub scenery: bool,\n}\n\n#[derive(Clone, Debug)]\npub struct SoftView {\n    pub points: Vec<Vec3>,\n    /// Surface triangles (cubes, balls, cloth); empty for ropes.\n    pub surface: std::sync::Arc<Vec<[u32; 3]>>,\n    /// Rope segments.\n    pub segments: std::sync::Arc<Vec<[u32; 2]>>,\n    /// Rope thickness.\n    pub radius: f32,\n    /// Sheets are seen from both sides.\n    pub two_sided: bool,\n}\n\n/// Things that happened during a tick, for sound and effects.\n#[derive(Clone, Debug, Serialize, Deserialize, PartialEq)]\n#[serde(tag = \"type\", rename_all = \"snake_case\")]\npub enum SimEvent {\n    Spawned {\n        id: EntityId,\n        pos: Vec3,\n    },\n    Impact {\n        pos: Vec3,\n        strength: f32,\n    },\n    Jump {\n        pos: Vec3,\n    },\n    Land {\n        pos: Vec3,\n        speed: f32,\n    },\n    Explosion {\n        pos: Vec3,\n        radius: f32,\n    },\n    Step {\n        pos: Vec3,\n    },\n    Throw {\n        pos: Vec3,\n    },\n    EnterRoom {\n        room: u16,\n    },\n    ExitRoom {\n        room: u16,\n    },\n    Hit {\n        pos: Vec3,\n        strength: f32,\n        /// The character struck, when it is one.\n        #[serde(default)]\n        target: Option<EntityId>,\n    },\n    Respawn {\n        pos: Vec3,\n    },\n    CourseStart {\n        pos: Vec3,\n    },\n    CourseFinish {\n        pos: Vec3,\n        time: f32,\n        new_best: bool,\n    },\n    Gate {\n        pos: Vec3,\n        ok: bool,\n    },\n    Checkpoint {\n        pos: Vec3,\n    },\n    Splash {\n        pos: Vec3,\n    },\n    Pad {\n        pos: Vec3,\n    },\n    /// A blaster shot, an enemy hit, an enemy destroyed.\n    Shot {\n        pos: Vec3,\n    },\n    Damage {\n        pos: Vec3,\n    },\n    Destroyed {\n        pos: Vec3,\n        size: f32,\n    },\n    /// A guard raised the alarm.\n    Spotted {\n        pos: Vec3,\n    },\n    Grab {\n        pos: Vec3,\n    },\n    Roll {\n        pos: Vec3,\n    },\n    /// A tile starts crumbling / breaks.\n    Crack {\n        pos: Vec3,\n    },\n    Break {\n        pos: Vec3,\n    },\n    Bounce {\n        pos: Vec3,\n    },\n    /// Shardfall: a weapon swing, a hit landing (power = damage, element index), a kill, a\n    /// slam, a spell cast, an explosion, gold, a potion, a block, a level-up.\n    Swing {\n        pos: Vec3,\n        heavy: bool,\n    },\n    Strike {\n        pos: Vec3,\n        power: f32,\n        element: u8,\n        crit: bool,\n    },\n    Slain {\n        pos: Vec3,\n        size: f32,\n    },\n    Slam {\n        pos: Vec3,\n        radius: f32,\n    },\n    Spell {\n        pos: Vec3,\n        element: u8,\n#!/usr/bin/env bash\n# Builds the browser version (WebAssembly + WebGPU). Output: target/web/{index.html,manifest.webmanifest,shardfall.js,shardfall_bg.wasm}\n# Serve that folder over HTTP (e.g. `python3 -m http.server -d target/web`) and open it in Chrome or Edge.\n# --single-file writes only target/web/<title>.html (shardfall.html): one page with the glue and gzipped wasm inside\n#   that runs from file:// or any host (scripts/pack_single_html.py; also --title, --description, --theme-color,\n#   --scene NAME for the start scene when the address names none, --out PATH).\n# Needs: rustup target add wasm32-unknown-unknown\n#        cargo install wasm-bindgen-cli --version <the wasm-bindgen version in Cargo.lock>\nset -euo pipefail\ncaller=$PWD\ncd \"$(dirname \"$0\")/..\"\nsingle=false\npack=()\nwhile (($#)); do\n\tcase $1 in\n\t--single-file) single=true ;;\n\t--title | --description | --theme-color | --scene | --out)\n\t\t(($# > 1)) || { echo \"build-web.sh: $1 needs a value\" >&2; exit 2; }\n\t\tvalue=$2\n\t\t[[ $1 == --out && $value != /* ]] && value=$caller/$value\n\t\tpack+=(\"$1\" \"$value\")\n\t\tshift\n\t\t;;\n\t*) echo \"build-web.sh: unknown option $1 (options are listed at the top of $0)\" >&2; exit 2 ;;\n\tesac\n\tshift\ndone\nif ((${#pack[@]})) && ! $single; then\n\techo \"build-web.sh: ${pack[0]} needs --single-file\" >&2\n\texit 2\nfi\ncargo build --locked --profile dist --target wasm32-unknown-unknown -p pav_app\nwasm=${CARGO_TARGET_DIR:-target}/wasm32-unknown-unknown/dist/shardfall.wasm\nout=target/web\nif $single; then\n\tbindgen=$(mktemp -d)\n\ttrap 'rm -rf \"$bindgen\"' EXIT\n\twasm-bindgen --target web --no-typescript --out-dir \"$bindgen\" --out-name shardfall \"$wasm\"\n\tpython3 -I scripts/pack_single_html.py \"$bindgen\" \"${pack[@]}\"\n\texit\nfi\nrm -rf \"$out\"\nmkdir -p \"$out\"\nwasm-bindgen --target web --no-typescript --out-dir \"$out\" --out-name shardfall \"$wasm\"\ncp web/index.html web/manifest.webmanifest \"$out/\"\nls -la \"$out\"\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"rg -n 'fn (frame|handle_key|on_touch)|boot_panel|stats_panel|guide_panel|hint_bar|run_ui|poll_gamepad|InputFrame|set_menu|current_room|pub struct Bindings|pub fn ' crates/pav_app/src/app.rs crates/pav_app/src/input.rs crates/pav_ui/src/lib.rs crates/pav_ui/src/headless.rs; rg -n 'step_inner|play_pre|hud:|HudFrame|fn frame|pub fn new|tilt|body_motion' crates/pav_core/src/sim.rs crates/pav_core/src/puppet.rs; cat crates/pav_core/src/games/starter.toml; cat web/index.html\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"rg -n 'fn (frame|handle_key|on_touch)|boot_panel|stats_panel|guide_panel|hint_bar|run_ui|poll_gamepad|InputFrame|set_menu|current_room|pub struct Bindings|pub fn ' crates/pav_app/src/app.rs crates/pav_app/src/input.rs crates/pav_ui/src/lib.rs crates/pav_ui/src/headless.rs; rg -n 'step_inner|play_pre|hud:|HudFrame|fn frame|pub fn new|tilt|body_motion' crates/pav_core/src/sim.rs crates/pav_core/src/puppet.rs; cat crates/pav_core/src/games/starter.toml; cat web/index.html\"","aggregated_output":"crates/pav_ui/src/headless.rs:111:    pub fn set_open(&mut self, name: &str, open: bool) -> bool {\ncrates/pav_ui/src/headless.rs:117:    pub fn frame(\ncrates/pav_ui/src/headless.rs:167:            let out = ctx.run_ui(raw, |ui| {\ncrates/pav_ui/src/headless.rs:323:    pub fn new(device: &wgpu::Device, format: wgpu::TextureFormat) -> Self {\ncrates/pav_ui/src/headless.rs:327:    pub fn format(&self) -> wgpu::TextureFormat {\ncrates/pav_ui/src/headless.rs:333:    pub fn paint(\ncrates/pav_ui/src/lib.rs:24:pub fn touch_style(ctx: &egui::Context, on: bool) {\ncrates/pav_ui/src/lib.rs:51:pub fn game_lines(ctx: &egui::Context, h: &pav_core::frame::HudFrame) {\ncrates/pav_app/src/app.rs:11:use pav_core::{InputFrame, Sim, SimConfig};\ncrates/pav_app/src/app.rs:34:pub fn run(settings: Settings) -> Result<()> {\ncrates/pav_app/src/app.rs:47:pub fn run(settings: Settings) -> Result<()> {\ncrates/pav_app/src/app.rs:305:    fn on_touch(&mut self, t: &winit::event::Touch, event: &WindowEvent) {\ncrates/pav_app/src/app.rs:334:            self.set_menu(false);\ncrates/pav_app/src/app.rs:587:                self.set_menu(false);\ncrates/pav_app/src/app.rs:764:    fn set_menu(&mut self, open: bool) {\ncrates/pav_app/src/app.rs:778:    fn handle_key(&mut self, code: KeyCode) {\ncrates/pav_app/src/app.rs:875:                self.set_menu(open);\ncrates/pav_app/src/app.rs:947:    fn frame(&mut self) {\ncrates/pav_app/src/app.rs:974:        self.input.poll_gamepad();\ncrates/pav_app/src/app.rs:977:            self.set_menu(open);\ncrates/pav_app/src/app.rs:1212:                *i = InputFrame::default();\ncrates/pav_app/src/app.rs:1409:        let out = self.egui_ctx.run_ui(raw, |ui| {\ncrates/pav_app/src/app.rs:1416:            ui::boot_panel(&ctx, &mut show_boot);\ncrates/pav_app/src/app.rs:1418:                ui::stats_panel(&ctx, &info, free, touch_ui);\ncrates/pav_app/src/app.rs:1421:                ui::guide_panel(&ctx, device, game_frame.is_some());\ncrates/pav_app/src/app.rs:1538:                ui::hint_bar(\ncrates/pav_app/src/app.rs:1777:                    self.set_menu(open);\ncrates/pav_app/src/app.rs:1955:        self.set_menu(false);\ncrates/pav_app/src/app.rs:2008:            MenuAction::Resume => self.set_menu(false),\ncrates/pav_app/src/app.rs:2013:                self.set_menu(false);\ncrates/pav_app/src/app.rs:2017:                self.set_menu(false);\ncrates/pav_app/src/app.rs:2021:                self.set_menu(false);\ncrates/pav_app/src/app.rs:2036:                self.set_menu(false);\ncrates/pav_app/src/app.rs:2040:                self.set_menu(false);\ncrates/pav_app/src/app.rs:2044:                self.set_menu(false);\ncrates/pav_app/src/app.rs:2052:                self.set_menu(false);\ncrates/pav_app/src/app.rs:2056:                self.set_menu(false);\ncrates/pav_app/src/app.rs:2060:                self.set_menu(false);\ncrates/pav_app/src/app.rs:2064:                self.set_menu(false);\ncrates/pav_app/src/app.rs:2068:                self.set_menu(false);\ncrates/pav_app/src/app.rs:2073:                self.set_menu(false);\ncrates/pav_app/src/app.rs:2082:                self.set_menu(false);\ncrates/pav_app/src/input.rs:38:pub fn key_from_name(n: &str) -> Option<KeyCode> {\ncrates/pav_app/src/input.rs:81:pub struct Bindings {\ncrates/pav_app/src/input.rs:104:    pub fn game() -> Self {\ncrates/pav_app/src/input.rs:125:    pub fn with_overrides(map: &std::collections::BTreeMap<String, Vec<String>>) -> (Self, Vec<String>) {\ncrates/pav_app/src/input.rs:158:pub fn game_guide(device: Device) -> &'static [(&'static str, &'static str)] {\ncrates/pav_app/src/input.rs:200:pub fn guide(device: Device) -> &'static [(&'static str, &'static str)] {\ncrates/pav_app/src/input.rs:315:    pub fn parse(text: &str) -> Result<PadScript, String> {\ncrates/pav_app/src/input.rs:381:    pub fn new() -> Self {\ncrates/pav_app/src/input.rs:411:    pub fn key(&mut self, code: KeyCode, state: ElementState) {\ncrates/pav_app/src/input.rs:424:    pub fn mouse_button(&mut self, b: MouseButton, state: ElementState) {\ncrates/pav_app/src/input.rs:438:    pub fn clear(&mut self) {\ncrates/pav_app/src/input.rs:444:    pub fn poll_gamepad(&mut self) {\ncrates/pav_app/src/input.rs:558:    pub fn move_axis(&self) -> Vec2 {\ncrates/pav_app/src/input.rs:567:    pub fn held(&self) -> u32 {\ncrates/pav_app/src/input.rs:584:    pub fn buttons(&mut self) -> (u32, u32) {\ncrates/pav_app/src/input.rs:606:    pub fn take_mouse_tap(&mut self, b: MouseButton) -> bool {\ncrates/pav_app/src/input.rs:610:    pub fn rewind_held(&self) -> bool {\ncrates/pav_core/src/puppet.rs:923:    let (q, shift) = body_motion(def, st);\ncrates/pav_core/src/puppet.rs:933:pub fn body_motion(def: &PuppetDef, st: &PuppetState) -> (Quat, Vec3) {\ncrates/pav_core/src/sim.rs:222:    pub fn new(scene: &str, seed: u64) -> Result<Self> {\ncrates/pav_core/src/sim.rs:518:        self.step_inner(input);\ncrates/pav_core/src/sim.rs:521:    fn step_inner(&mut self, input: &InputFrame) {\ncrates/pav_core/src/sim.rs:539:        game_inputs.extend(self.play_pre(input, dt, &mut events));\ncrates/pav_core/src/sim.rs:852:            self.step_inner(&input);\ncrates/pav_core/src/sim.rs:941:    pub fn frame(&mut self) -> RenderFrame {\ncrates/pav_core/src/sim.rs:972:        let hud = crate::frame::HudFrame {\n# The starter game's level: a room file (every field: rooms/_template.toml). Column = x (east),\n# row = z (south), 1 cell = 1 m. `o` cells are shards and `P` is the start (legend markers,\n# read by starter.rs with `scenes::markers`); the slimes are [[npc]] entries the game drives.\n# Check it with `pav room_check path=crates/pav_core/src/games/starter.toml`.\n\nname = \"Starter\"\nabout = \"Collect every shard while slimes chase you.\"\nentrance = { at = [8, 12], facing = \"south\" }   # required by the format; the `P` marker is the start\n\n# The rules' numbers (starter.rs `Rules`). Running from the repository, `pav` reads this file at\n# each `load`: edit, then `load scene=starter` or `play bot=true seeds=10`, no rebuild.\n[game]\nlives = 3\nslime_speed = 0.5\nslime_sight = 9.0\ncatch = 0.8\npick = 0.9\ngrace = 2.0\n\n[camera]\ntilt = 58.0\ndistance = 17.0\n\n[layout]\norigin = [-9.0, 0.0, -6.5]\n\n[[layout.layer]]\ny = 0\nmap = '''\n##################\n#o......#.......o#\n#.......#........#\n#..##.......##...#\n#..#.........#...#\n#.......o........#\n#....#.....#.....#\n#.......P........#\n#..#.........#...#\n#..##.......##...#\n#.......#........#\n#o......#.......o#\n##################\n'''\n\n[layout.legend.'.']\nblocks = [{ y0 = -0.5, y1 = 0, color = \"#3b4a5c\" }]\n\n[layout.legend.'#']\nblocks = [{ y0 = -0.5, y1 = 0, color = \"#3b4a5c\" }, { y0 = 0, y1 = 1.2, color = \"#8a6f9e\", rounded = true }]\n\n[layout.legend.'o']\nblocks = [{ y0 = -0.5, y1 = 0, color = \"#3b4a5c\" }]\nmarker = \"shard\"\n\n[layout.legend.'P']\nblocks = [{ y0 = -0.5, y1 = 0, color = \"#3b4a5c\" }]\nmarker = \"player\"\n\n[[npc]]\nname = \"slime\"\nkind = \"blob\"\npos = [12.5, 0, 2.5]\nlook = { skin = \"#6cd66c\" }\n\n[[npc]]\nname = \"slime\"\nkind = \"blob\"\npos = [5.5, 0, 10.5]\nlook = { skin = \"#6cd66c\" }\n\n[[npc]]\nname = \"slime\"\nkind = \"blob\"\npos = [15.5, 0, 7.5]\nlook = { skin = \"#6cd66c\" }\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n<title>Shardfall</title>\n<meta name=\"description\" content=\"Play Shardfall, a procedural hack-and-slash adventure with an interactive tech demo pavilion.\">\n<meta name=\"theme-color\" content=\"#15171c\">\n<meta name=\"mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n<link rel=\"manifest\" href=\"manifest.webmanifest\">\n<link rel=\"icon\" href=\"data:,\">\n<style>\n  /* The page is the game: no scrolling, zooming, text selection, callouts or tap flashes. */\n  html, body { margin: 0; height: 100%; overflow: hidden; background: #15171c; overscroll-behavior: none;\n               touch-action: none; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none;\n               -webkit-tap-highlight-color: transparent; }\n  /* winit appends the game canvas to <body>; it fills the page and the game follows its size.\n     dvh: the height that is visible while a phone's browser bars come and go. */\n  canvas { display: block; width: 100vw !important; height: 100vh !important; height: 100dvh !important;\n           outline: none; touch-action: none; }\n  #msg { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center;\n         font: 18px system-ui, sans-serif; color: #c9ccd4; text-align: center; padding: 24px; pointer-events: none; }\n  /* Phones held upright: a hint to turn sideways that fades by itself. */\n  #turn { display: none; position: fixed; left: 50%; top: 12px; transform: translateX(-50%); padding: 8px 14px;\n          border-radius: 18px; background: rgba(0, 0, 0, 0.6); color: #ffd690; font: 14px system-ui, sans-serif;\n          pointer-events: none; animation: fade 1s 5s forwards; }\n  @media (orientation: portrait) and (pointer: coarse) { #turn { display: block; } }\n  @keyframes fade { to { opacity: 0; } }\n</style>\n</head>\n<body>\n<div id=\"msg\" role=\"status\" aria-live=\"polite\">Loading Shardfall…</div>\n<div id=\"turn\">Turn your phone sideways for the best view</div>\n<script type=\"module\">\n  // Start in a demo room with ?room=NAME, or the pavilion with ?scene=world.\n  // Messages name the game by the page title (a single-file build may retitle it).\n  const name = document.title;\n  const msg = document.getElementById('msg');\n  if (!navigator.gpu) {\n    msg.replaceChildren(`${name} needs WebGPU.`, document.createElement('br'),\n      'Use a recent Chrome, Edge or Safari (iOS 26 or later) with hardware acceleration enabled.');\n  } else {\n    // The game hides this message once its canvas exists, and takes keyboard focus.\n    new MutationObserver((_, obs) => {\n      const c = document.querySelector('canvas');\n      if (c) { c.setAttribute('aria-label', `${name} game`); msg.remove(); c.focus(); obs.disconnect(); }\n    }).observe(document.body, { childList: true });\n    // Phones and tablets: the first tap goes full screen and turns sideways, where the browser\n    // allows it (Android; an iPhone keeps its bars, or plays full screen from the home screen).\n    if (matchMedia('(pointer: coarse)').matches) {\n      addEventListener('pointerup', () => {\n        const el = document.documentElement;\n        if (!document.fullscreenElement && el.requestFullscreen) {\n          el.requestFullscreen({ navigationUI: 'hide' })\n            .then(() => screen.orientation && screen.orientation.lock && screen.orientation.lock('landscape'))\n            .catch(() => {});\n        }\n      }, { once: true, capture: true });\n    }\n    try {\n      // The game is shardfall.js and its .wasm beside this page. A single-file build\n      // (scripts/pack_single_html.py) carries both inside the page and sets window.loadGame.\n      if (window.loadGame) await window.loadGame();\n      else await (await import('./shardfall.js')).default();\n    } catch (error) {\n      console.error(`${name} failed to load:`, error);\n      msg.textContent = `${name} could not load. Please reload the page. If it still fails, check that WebGPU and hardware acceleration are enabled.`;\n      document.body.append(msg);\n    }\n  }\n</script>\n</body>\n</html>\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"sed -n '80,158p' crates/pav_app/src/input.rs; sed -n '350,625p' crates/pav_app/src/input.rs; sed -n '270,339p' crates/pav_app/src/app.rs; sed -n '768,805p' crates/pav_app/src/app.rs; sed -n '947,1040p' crates/pav_app/src/app.rs; sed -n '1170,1235p' crates/pav_app/src/app.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"sed -n '80,158p' crates/pav_app/src/input.rs; sed -n '350,625p' crates/pav_app/src/input.rs; sed -n '270,339p' crates/pav_app/src/app.rs; sed -n '768,805p' crates/pav_app/src/app.rs; sed -n '947,1040p' crates/pav_app/src/app.rs; sed -n '1170,1235p' crates/pav_app/src/app.rs\"","aggregated_output":"#[derive(Clone)]\npub struct Bindings {\n    pub up: Vec<KeyCode>,\n    pub down: Vec<KeyCode>,\n    pub left: Vec<KeyCode>,\n    pub right: Vec<KeyCode>,\n    pub buttons: Vec<(u32, Vec<KeyCode>)>,\n}\n\nimpl Default for Bindings {\n    fn default() -> Self {\n        Self {\n            up: KEYS.up.to_vec(),\n            down: KEYS.down.to_vec(),\n            left: KEYS.left.to_vec(),\n            right: KEYS.right.to_vec(),\n            buttons: KEYS.buttons.iter().map(|(b, k)| (*b, k.to_vec())).collect(),\n        }\n    }\n}\n\nimpl Bindings {\n    /// Shardfall: WASD to move, mouse buttons and Q E R F for the six skill slots, Space to\n    /// dodge, 1 for a potion, Shift to attack in place.\n    pub fn game() -> Self {\n        use KeyCode::*;\n        Self {\n            up: vec![KeyW, ArrowUp],\n            down: vec![KeyS, ArrowDown],\n            left: vec![KeyA, ArrowLeft],\n            right: vec![KeyD, ArrowRight],\n            buttons: vec![\n                (buttons::SKILL3, vec![KeyQ]),\n                (buttons::SKILL4, vec![KeyE]),\n                (buttons::SKILL5, vec![KeyR]),\n                (buttons::SKILL6, vec![KeyF]),\n                (buttons::DODGE, vec![Space]),\n                (buttons::POTION, vec![Digit1]),\n                (buttons::FOCUS, vec![ShiftLeft]),\n                (buttons::INTERACT, vec![KeyG]),\n            ],\n        }\n    }\n\n    /// Defaults with a room's `[keys]` overrides applied. Returns problems found.\n    pub fn with_overrides(map: &std::collections::BTreeMap<String, Vec<String>>) -> (Self, Vec<String>) {\n        let mut b = Self::default();\n        let mut errs = Vec::new();\n        for (action, names) in map {\n            let keys: Vec<KeyCode> = names\n                .iter()\n                .filter_map(|n| {\n                    let k = key_from_name(n);\n                    if k.is_none() {\n                        errs.push(format!(\"unknown key '{n}'\"));\n                    }\n                    k\n                })\n                .collect();\n            match action.as_str() {\n                \"move_up\" => b.up = keys,\n                \"move_down\" => b.down = keys,\n                \"move_left\" => b.left = keys,\n                \"move_right\" => b.right = keys,\n                other => match pav_core::input::buttons::from_name(other) {\n                    Some(bit) => match b.buttons.iter_mut().find(|(x, _)| *x == bit) {\n                        Some(e) => e.1 = keys,\n                        None => b.buttons.push((bit, keys)),\n                    },\n                    None => errs.push(format!(\"unknown action '{other}'\")),\n                },\n            }\n        }\n        (b, errs)\n    }\n}\n\n/// Shardfall's controls.\npub fn game_guide(device: Device) -> &'static [(&'static str, &'static str)] {\n                    \"left\" => st.left = vec(v)?,\n                    \"right\" => st.right = vec(v)?,\n                    \"hold\" => st.hold = v.split(',').map(button).collect::<Result<_, _>>()?,\n                    \"tap\" => st.tap = v.split(',').map(button).collect::<Result<_, _>>()?,\n                    o => return Err(format!(\"line {}: unknown '{o}'\", n + 1)),\n                }\n            }\n            steps.push(st);\n        }\n        Ok(PadScript { steps, at: 0, frame: 0 })\n    }\n\n    /// This frame's step (and whether it's the step's first frame); None when done.\n    fn next(&mut self) -> Option<(PadStep, bool)> {\n        let st = self.steps.get(self.at)?.clone();\n        let first = self.frame == 0;\n        self.frame += 1;\n        if self.frame >= st.frames.max(1) {\n            self.at += 1;\n            self.frame = 0;\n        }\n        Some((st, first))\n    }\n}\n\nfn deadzone(v: Vec2, dz: f32) -> Vec2 {\n    let l = v.length();\n    if l < dz { Vec2::ZERO } else { v / l * ((l - dz) / (1.0 - dz)).min(1.0) }\n}\n\nimpl Input {\n    pub fn new() -> Self {\n        let gilrs = match gilrs::Gilrs::new() {\n            Ok(g) => {\n                for (_, gp) in g.gamepads() {\n                    log::info!(\"gamepad: {} ({:?})\", gp.name(), gp.power_info());\n                }\n                Some(g)\n            }\n            Err(e) => {\n                log::warn!(\"gamepads unavailable: {e}\");\n                None\n            }\n        };\n        Self {\n            keys: HashSet::new(),\n            mouse: HashSet::new(),\n            cursor: Vec2::ZERO,\n            mouse_active: false,\n            gilrs,\n            pad_script: None,\n            pad: Pad::default(),\n            last_device: Device::KeyboardMouse,\n            prev_held: 0,\n            key_taps: HashSet::new(),\n            mouse_taps: HashSet::new(),\n            bindings: Bindings::default(),\n            game: false,\n        }\n    }\n\n    pub fn key(&mut self, code: KeyCode, state: ElementState) {\n        self.last_device = Device::KeyboardMouse;\n        match state {\n            ElementState::Pressed => {\n                self.keys.insert(code);\n                self.key_taps.insert(code);\n            }\n            ElementState::Released => {\n                self.keys.remove(&code);\n            }\n        }\n    }\n\n    pub fn mouse_button(&mut self, b: MouseButton, state: ElementState) {\n        self.last_device = Device::KeyboardMouse;\n        self.mouse_active = true;\n        match state {\n            ElementState::Pressed => {\n                self.mouse.insert(b);\n                self.mouse_taps.insert(b);\n            }\n            ElementState::Released => {\n                self.mouse.remove(&b);\n            }\n        }\n    }\n\n    pub fn clear(&mut self) {\n        self.keys.clear();\n        self.mouse.clear();\n    }\n\n    /// Reads gamepad events and state (first connected pad).\n    pub fn poll_gamepad(&mut self) {\n        use gilrs::{Axis, Button};\n        let mut activity = false;\n        let mut taps = Vec::new();\n        // One pad state from the first connected pad, or from the pad script while it runs.\n        let mut state: Option<PadState> = None;\n        if let Some(g) = &mut self.gilrs {\n            while let Some(ev) = g.next_event() {\n                match ev.event {\n                    gilrs::EventType::ButtonPressed(b, _) => {\n                        taps.push(b);\n                        activity = true;\n                    }\n                    gilrs::EventType::AxisChanged(_, v, _) if v.abs() > 0.4 => activity = true,\n                    gilrs::EventType::Connected => log::info!(\"gamepad connected\"),\n                    gilrs::EventType::Disconnected => log::info!(\"gamepad disconnected\"),\n                    _ => {}\n                }\n            }\n            if let Some((_, gp)) = g.gamepads().next() {\n                const ALL: [Button; 15] = [\n                    Button::South,\n                    Button::East,\n                    Button::North,\n                    Button::West,\n                    Button::LeftTrigger,\n                    Button::RightTrigger,\n                    Button::Select,\n                    Button::Start,\n                    Button::DPadUp,\n                    Button::DPadDown,\n                    Button::DPadLeft,\n                    Button::DPadRight,\n                    Button::LeftThumb,\n                    Button::RightThumb,\n                    Button::Mode,\n                ];\n                let trig = |b: Button| gp.button_data(b).map(|d| d.value()).unwrap_or(0.0) > 0.35;\n                state = Some(PadState {\n                    left: Vec2::new(gp.value(Axis::LeftStickX), gp.value(Axis::LeftStickY)),\n                    right: Vec2::new(gp.value(Axis::RightStickX), gp.value(Axis::RightStickY)),\n                    held: ALL.into_iter().filter(|b| gp.is_pressed(*b)).collect(),\n                    lt2: trig(Button::LeftTrigger2),\n                    rt2: trig(Button::RightTrigger2),\n                });\n            }\n        }\n        if let Some(script) = &mut self.pad_script {\n            if let Some((st, first)) = script.next() {\n                if first {\n                    taps.extend(st.tap.iter().copied());\n                }\n                activity = true;\n                state = Some(PadState { left: st.left, right: st.right, held: st.hold.clone(), lt2: false, rt2: false });\n            }\n        }\n        let start = taps.contains(&Button::Start);\n        let map = taps.contains(&Button::DPadLeft);\n        let mut pad = Pad { start_pressed: start, map_pressed: map, taps, any_activity: activity, ..Default::default() };\n        if let Some(st) = state {\n            let is = |b: Button| st.held.contains(&b);\n            pad.left = deadzone(st.left, 0.18);\n            pad.right = deadzone(st.right, 0.25);\n            let mut held = 0;\n            let layout: &[(Button, u32)] = if self.game {\n                &[\n                    (Button::West, buttons::PRIMARY),\n                    (Button::North, buttons::SECONDARY),\n                    (Button::East, buttons::SKILL3),\n                    (Button::RightTrigger, buttons::SKILL4),\n                    (Button::LeftTrigger, buttons::SKILL5),\n                    (Button::South, buttons::DODGE),\n                    (Button::DPadUp, buttons::POTION),\n                    (Button::DPadRight, buttons::INTERACT),\n                ]\n            } else {\n                &[\n                    (Button::South, buttons::JUMP),\n                    (Button::East, buttons::CROUCH),\n                    (Button::North, buttons::CRAWL),\n                    (Button::West, buttons::USE),\n                    (Button::DPadRight, buttons::INTERACT),\n                ]\n            };\n            for (btn, action) in layout {\n                if is(*btn) {\n                    held |= action;\n                }\n            }\n            if st.rt2 {\n                held |= if self.game { buttons::SKILL6 } else { buttons::USE };\n            }\n            if st.lt2 {\n                held |= buttons::FOCUS;\n            }\n            pad.held = held;\n            pad.rotate = if self.game { 0.0 } else { (is(Button::RightTrigger) as i32 - is(Button::LeftTrigger) as i32) as f32 };\n            // In the game the D-pad is potion / use / map / panels, not zoom.\n            pad.zoom = if self.game { 0.0 } else { (is(Button::DPadDown) as i32 - is(Button::DPadUp) as i32) as f32 };\n            pad.a_held = is(Button::South);\n            pad.x_held = is(Button::West);\n            pad.y_held = is(Button::North);\n            pad.back_held = is(Button::Select);\n            if pad.left.length() > 0.3 || pad.right.length() > 0.3 || held != 0 {\n                pad.any_activity = true;\n            }\n        }\n        if pad.any_activity {\n            self.last_device = Device::Gamepad;\n        }\n        self.pad = pad;\n    }\n\n    /// Screen-space movement (x right, y up) from keys and stick, length <= 1.\n    pub fn move_axis(&self) -> Vec2 {\n        let k = |codes: &[KeyCode]| codes.iter().any(|c| self.keys.contains(c)) as i32 as f32;\n        let b = &self.bindings;\n        let kb = Vec2::new(k(&b.right) - k(&b.left), k(&b.up) - k(&b.down));\n        let v = if kb != Vec2::ZERO { kb.normalize() } else { self.pad.left };\n        v.clamp_length_max(1.0)\n    }\n\n    /// Held game buttons from all devices.\n    pub fn held(&self) -> u32 {\n        let mut b = self.pad.held;\n        for (bit, codes) in &self.bindings.buttons {\n            if codes.iter().any(|c| self.keys.contains(c)) {\n                b |= bit;\n            }\n        }\n        if self.mouse.contains(&MouseButton::Left) {\n            b |= buttons::PRIMARY;\n        }\n        if self.game && self.mouse.contains(&MouseButton::Right) {\n            b |= buttons::SECONDARY;\n        }\n        b\n    }\n\n    /// Returns (held, newly pressed since the last call).\n    pub fn buttons(&mut self) -> (u32, u32) {\n        let held = self.held();\n        let mut pressed = held & !self.prev_held;\n        for (bit, codes) in &self.bindings.buttons {\n            if codes.iter().any(|c| self.key_taps.contains(c)) {\n                pressed |= bit;\n            }\n        }\n        if self.mouse_taps.contains(&MouseButton::Left) {\n            pressed |= buttons::PRIMARY;\n        }\n        if self.game && self.mouse_taps.contains(&MouseButton::Right) {\n            pressed |= buttons::SECONDARY;\n        }\n        self.key_taps.clear();\n        self.mouse_taps.clear();\n        self.prev_held = held;\n        // A tap shorter than a frame still counts as held for that frame.\n        (held | pressed, pressed)\n    }\n\n    /// True if `b` was pressed since the last call (consumes the tap).\n    pub fn take_mouse_tap(&mut self, b: MouseButton) -> bool {\n        self.mouse_taps.remove(&b)\n    }\n\n    pub fn rewind_held(&self) -> bool {\n        self.keys.contains(&KeyCode::Backspace) || self.pad.back_held\n    }\n}\n\n#[cfg(test)]\nmod pad_script_tests {\n    use super::*;\n\n    #[test]\n    fn pad_scripts_parse_and_play() {\n        let mut p = PadScript::parse(\"# open the bag\\n2\\n1 tap=DPadDown\\n3 left=0.5,-1 hold=A,Y\\n\").unwrap();\n        assert_eq!(p.steps.len(), 3);\n        let frames: Vec<(PadStep, bool)> = std::iter::from_fn(|| p.next()).collect();\n        assert_eq!(frames.len(), 6);\n        assert!(frames[2].1 && frames[2].0.tap == vec![gilrs::Button::DPadDown]);\n            arrival: None,\n            game_ui: Default::default(),\n            last_save: Instant::now(),\n            pad_cursor: None,\n            pad_events: Vec::new(),\n            pad_buttons: (false, false, false),\n            game_frame: None,\n            game_place: None,\n            touch: Default::default(),\n            touch_screen,\n            touch_styled: false,\n            next_draw: Instant::now(),\n            prefs: crate::save::load_prefs(),\n            scaler: Default::default(),\n            #[cfg(not(target_arch = \"wasm32\"))]\n            bridge: None,\n            #[cfg(target_arch = \"wasm32\")]\n            pending_gfx: None,\n            #[cfg(target_arch = \"wasm32\")]\n            audio_resumed: false,\n            init_started: false,\n            fatal: None,\n            settings,\n        };\n        if touch_screen {\n            // Phones: touch controls from the start, none of the desktop's diagnostics.\n            app.input.last_device = Device::Touch;\n            app.show_boot = false;\n            app.app_settings.show_stats = false;\n        }\n        app\n    }\n\n    /// A finger on the screen: the touch layer decides whether it is the stick, a control, a\n    /// swipe or egui's (and then egui gets the event).\n    fn on_touch(&mut self, t: &winit::event::Touch, event: &WindowEvent) {\n        #[cfg(target_arch = \"wasm32\")]\n        self.resume_audio();\n        let Some(g) = &self.gfx else { return };\n        let ppp = self.egui_ctx.zoom_factor() * g.window.scale_factor() as f32;\n        let pos = egui::pos2(t.location.x as f32 / ppp, t.location.y as f32 / ppp);\n        self.input.last_device = Device::Touch;\n        self.touch_screen = true;\n        use winit::event::TouchPhase as P;\n        let to_egui = match t.phase {\n            P::Started => {\n                // (The root layer is everywhere; only windows and labels over the game count.)\n                let under = self.egui_ctx.layer_id_at(pos).filter(|l| *l != egui::LayerId::background()).map(|l| l.order);\n                self.touch.down(t.id, pos, under)\n            }\n            P::Moved => self.touch.moved(t.id, pos),\n            P::Ended => self.touch.up(t.id, pos, false),\n            P::Cancelled => self.touch.up(t.id, pos, true),\n        };\n        if to_egui {\n            if let (Some(st), Some(g)) = (&mut self.egui_state, &self.gfx) {\n                st.on_window_event(&g.window, event);\n            }\n        }\n    }\n\n    /// A tap on the open game closes what is open over it, one thing at a time.\n    fn close_on_tap(&mut self) {\n        if self.menu_open {\n            self.set_menu(false);\n        } else if self.game_ui.any_open() {\n            self.game_ui.close_all();\n        } else if self.game_ui.map {\n            self.game_ui.map = false;\n        } else if self.look_ui.open {\n            host.set_control(|c| c.paused = true);\n        } else if !open && self.menu_open {\n            let p = self.paused_before_menu;\n            host.set_control(|c| c.paused = p);\n        }\n        self.menu_open = open;\n        self.input.clear();\n    }\n\n    /// The fixed system layer: never rebinds, works in every room.\n    fn handle_key(&mut self, code: KeyCode) {\n        let Some(host) = &self.host else { return };\n        if self.studio_mode == StudioMode::Animation {\n            if let Some(p) = host.frames().1.animation_preview.as_ref() {\n                let args = match code {\n                    KeyCode::F6 => Some(serde_json::json!({\"playing\": !p.playing})),\n                    KeyCode::F7 => Some(serde_json::json!({\"step\": 1})),\n                    KeyCode::F8 => Some(serde_json::json!({\"speed\": (p.speed * 0.5).max(0.05)})),\n                    KeyCode::F9 => Some(serde_json::json!({\"speed\": (p.speed * 2.0).min(8.0)})),\n                    _ => None,\n                };\n                if let Some(args) = args {\n                    self.studio_command(crate::animation_ui::Command {\n                        tool: \"anim_preview\",\n                        args: args.as_object().unwrap().clone(),\n                    });\n                    return;\n                }\n            }\n        }\n        if self.studio_mode == StudioMode::Prop {\n            if let Some(p) = host.frames().1.prop_preview.as_ref() {\n                let args = match code {\n                    KeyCode::F6 => Some(serde_json::json!({\"playing\": !p.playing})),\n                    KeyCode::F7 => Some(serde_json::json!({\"playing\": false, \"time\": p.time + 1.0 / 60.0})),\n                    KeyCode::F8 => Some(serde_json::json!({\"speed\": (p.speed * 0.5).max(0.05)})),\n                    KeyCode::F9 => Some(serde_json::json!({\"speed\": (p.speed * 2.0).min(8.0)})),\n                    _ => None,\n    fn frame(&mut self) {\n        if self.gfx.is_none() || self.host.is_none() {\n            return;\n        }\n        // Touch screens draw at most 60 frames a second (a phone with a faster screen would\n        // spend battery and heat on the rest).\n        if self.touch_screen {\n            let now = Instant::now();\n            let step = std::time::Duration::from_micros(16_667);\n            if now + std::time::Duration::from_micros(2_500) < self.next_draw {\n                return;\n            }\n            self.next_draw = if now > self.next_draw + step { now + step } else { self.next_draw + step };\n        }\n        let now = Instant::now();\n        let dt = (now - self.last).as_secs_f32().min(0.1);\n        self.last = now;\n        self.fps.frames += 1;\n        let since = self.fps.since.elapsed().as_secs_f32();\n        if since >= 0.5 {\n            self.fps.fps = self.fps.frames as f32 / since;\n            self.fps.frame_ms = since * 1000.0 / self.fps.frames as f32;\n            self.fps.frames = 0;\n            self.fps.since = now;\n        }\n\n        // Devices.\n        self.input.poll_gamepad();\n        if self.input.pad.start_pressed {\n            let open = !self.menu_open;\n            self.set_menu(open);\n        }\n        if self.input.pad.map_pressed {\n            self.game_ui.map = !self.game_ui.map;\n        }\n        self.pad_menus(dt);\n        let pad = self.input.last_device == Device::Gamepad;\n        self.game_ui.pad = pad;\n        self.game_ui.tree.pad = pad;\n        self.rig.params.yaw = (self.rig.params.yaw + self.input.pad.rotate * 90.0 * dt + 540.0).rem_euclid(360.0) - 180.0;\n        self.rig.params.distance = (self.rig.params.distance * (1.0 + self.input.pad.zoom * dt)).clamp(2.0, 120.0);\n\n        let host = self.host.as_ref().unwrap();\n        host.pump();\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if let Some(b) = &self.bridge {\n            // Agent tools run on the simulation thread and can change the camera, view and look.\n            if let Some(l) = b.poll(host, &mut self.rig, &mut self.view, self.look_ui.look()) {\n                self.look_ui.set_look(l);\n            }\n        }\n        let ui_wants_keys = self.egui_ctx.egui_wants_keyboard_input();\n        let game_input = !self.menu_open && !ui_wants_keys;\n        let rewinding = game_input && self.studio_mode == StudioMode::World && self.input.rewind_held();\n        host.set_control(|c| c.rewinding = rewinding);\n\n        let (prev, curr, curr_at, tick_wall) = host.frames();\n        let studio_mode = curr.studio_mode();\n        let studio_active = curr.studio_active();\n        self.studio_navigation |= studio_active;\n        let snap_camera = studio_mode != self.studio_mode\n            || prev.studio_mode() != studio_mode\n            || prev.live_edit_ticket != curr.live_edit_ticket;\n        let game_input = game_input && !studio_active;\n        if studio_mode != self.studio_mode {\n            let keep_object_redo = studio_mode == StudioMode::World && self.asset_ui.open && self.asset_ui.creation_removed();\n            let keep_creature_redo =\n                studio_mode == StudioMode::World && self.creature_ui.open && self.creature_ui.creation_removed();\n            self.builder = ViewBuilder::new();\n            if let Some(gfx) = &mut self.gfx {\n                gfx.renderer.clear_particles();\n            }\n            self.studio_mode = studio_mode;\n            self.animation_ui.open = studio_mode == StudioMode::Animation;\n            self.asset_ui.open = studio_mode == StudioMode::Prop || keep_object_redo;\n            self.creature_ui.open = studio_mode == StudioMode::Creature || keep_creature_redo;\n        }\n        if !studio_active {\n            let room_before = self.hud.current.as_ref().map(|r| (r.id, std::sync::Arc::as_ptr(&r.def)));\n            let quarters = curr.room.as_ref().map(|r| r.quarters).unwrap_or(0);\n            self.director.update(&curr.hud, quarters, &mut self.rig);\n            let room_id_before = self.hud.current.as_ref().map(|r| r.id);\n            self.hud.update(&curr.room, &mut self.rig);\n            // Rooms and pads can change view settings (night lighting, bloom, filters).\n            let key = (curr.room.as_ref().map(|r| r.id), curr.hud.view_serial);\n            if key != self.view_key {\n                self.view_key = key;\n                if let Some(b) = self.view_base.take() {\n                    self.view = b;\n                }\n                let q = curr.room.as_ref().map(|r| r.quarters).unwrap_or(0);\n                let room = curr.room.as_ref().map(|r| pav_view::build::room_view_map(&r.def.view, q)).unwrap_or_default();\n                let pads = pav_view::build::room_view_map(&curr.hud.view, q);\n                if !room.is_empty() || !pads.is_empty() {\n        if pressed != 0 && self.input.last_device == Device::Gamepad {\n            // Gamepad presses are timed from when they were polled (gilrs queues them).\n            self.latency.press();\n        }\n        let room_id = self.hud.current.as_ref().map(|r| r.id);\n        let left = self.input.mouse.contains(&MouseButton::Left) && !over_ui;\n        if left_tap && !self.editor.on && game_input {\n            pressed |= pav_core::input::buttons::PRIMARY;\n        }\n        if !studio_active && self.editor.update(host, &self.rig, self.input.cursor, size, left, left_tap, room_id) {\n            held &= !pav_core::input::buttons::PRIMARY;\n            pressed &= !pav_core::input::buttons::PRIMARY;\n        }\n        let aim = match self.input.last_device {\n            Device::KeyboardMouse => self.rig.ground_point(self.input.cursor, size, feet.y),\n            Device::Gamepad => {\n                let r = self.input.pad.right;\n                if r.length() > 0.2 {\n                    let d = self.rig.relative_move(r);\n                    Some(feet + Vec3::new(d.x, 0.0, d.y) * self.sim_config.bombs.throw_range * r.length().min(1.0))\n                } else {\n                    Some(feet + Vec3::new(facing.sin(), 0.0, facing.cos()) * 4.0)\n                }\n            }\n            Device::Touch => intent.aim.or(Some(feet + Vec3::new(facing.sin(), 0.0, facing.cos()) * 4.0)),\n        };\n        {\n            let mut i = host.shared.input.lock().unwrap();\n            if game_input {\n                let axis = (self.input.move_axis() + intent.move_axis).clamp_length_max(1.0);\n                i.move_dir = match intent.move_world {\n                    // Auto-attack stepping in to a foe (only while the stick is still).\n                    Some(m) if axis == Vec2::ZERO => m,\n                    _ => self.rig.relative_move(axis),\n                };\n                i.held = held;\n                i.pressed |= pressed;\n                i.aim = aim;\n                if let Some(t) = self.latency.pending.take() {\n                    host.shared.input_stamp.lock().unwrap().get_or_insert(t);\n                }\n            } else {\n                *i = InputFrame::default();\n            }\n        }\n\n        self.rig.update(focus, dt);\n        self.builder.now = self.started.elapsed().as_secs_f64();\n        let events: Vec<_> = std::mem::take(&mut *host.shared.events.lock().unwrap());\n        let events = if studio_active { Vec::new() } else { events };\n        self.builder.add_events(&events);\n        // Save the hero on every arrival somewhere, and once a minute while playing.\n        let travelled = events.iter().any(|e| matches!(e, pav_core::SimEvent::Travel { .. }));\n        if curr.game.is_some() && (travelled || self.last_save.elapsed().as_secs() >= 60) {\n            self.last_save = Instant::now();\n            host.exec(|sim| crate::save::save_from(sim));\n        }\n        if let Some(a) = &self.audio {\n            let (_, right) = self.rig.ground_axes();\n            let l = pav_audio::Listener { pos: self.rig.target, right };\n            for e in &events {\n                if matches!(e, pav_core::SimEvent::Step { .. }) && !self.audio_settings.footsteps {\n                    continue;\n                }\n                a.play_event(e, &l, self.audio_settings.sfx);\n            }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"cat crates/pav_core/src/games/mod.rs; sed -n '200,275p' crates/pav_core/src/frame.rs; sed -n '510,555p' crates/pav_core/src/sim.rs; sed -n '941,1030p' crates/pav_core/src/sim.rs; sed -n '330,440p' crates/pav_core/src/puppet.rs; sed -n '930,955p' crates/pav_core/src/puppet.rs; sed -n '1,105p' crates/pav_ui/src/lib.rs; sed -n '117,193p' crates/pav_ui/src/headless.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"cat crates/pav_core/src/games/mod.rs; sed -n '200,275p' crates/pav_core/src/frame.rs; sed -n '510,555p' crates/pav_core/src/sim.rs; sed -n '941,1030p' crates/pav_core/src/sim.rs; sed -n '330,440p' crates/pav_core/src/puppet.rs; sed -n '930,955p' crates/pav_core/src/puppet.rs; sed -n '1,105p' crates/pav_ui/src/lib.rs; sed -n '117,193p' crates/pav_ui/src/headless.rs\"","aggregated_output":"//! Games built on the engine: the hook a new game implements, and the list of games.\n//!\n//! A game is a struct holding its rules' state (`Clone` and serde, like everything in\n//! `SimState`) that implements [`Game`], plus a `build` function that makes its scene. One\n//! line in [`GAMES`] and `load scene=<key>` starts it in the tools, the window\n//! (`shardfall --scene <key>`) and the browser (`?scene=<key>`). `starter.rs` is the template\n//! to copy; `docs/MAKE_A_GAME.md` is the guide. Shardfall (`crate::arpg`) predates this hook and\n//! keeps its own.\n\nuse std::any::Any;\nuse std::collections::BTreeMap;\n\nuse anyhow::Result;\nuse serde::de::{DeserializeOwned, Error as _};\nuse serde::{Deserialize, Deserializer, Serialize, Serializer};\n\nuse crate::entity::EntityId;\nuse crate::frame::SimEvent;\nuse crate::input::InputFrame;\nuse crate::sim::Sim;\n\npub mod starter;\n\n/// Every game the engine knows. `load scene=<key>` (or `<key>/<rest>`) builds it.\npub static GAMES: &[Entry] =\n    &[entry::<starter::Starter>(\"Starter: collect every shard while slimes chase you (the template to copy).\", starter::build)];\n\n/// Still playing, won or lost.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum Outcome {\n    #[default]\n    Playing,\n    Won,\n    Lost,\n}\n\n/// A game's rules. Every method has a default, so a game implements only what it uses.\n///\n/// The engine calls `pre` and `post` once per tick (60 a second) from `Sim::step`; everything\n/// else is read-only. While `pre` or `post` runs, the game is out of `sim.state.play`, so use\n/// `self` for the game's own state and `sim` for the world.\npub trait Game: Clone + Serialize + DeserializeOwned + Send + Sync + 'static {\n    /// The scene key that starts the game: `load scene=<KEY>`, `--scene <KEY>`, `?scene=<KEY>`.\n    const KEY: &'static str;\n\n    /// Before characters move: read the player's input and decide what the characters the\n    /// game drives do this tick. A returned input replaces that character's own (its `ai`\n    /// brain, or the player's keys for the player).\n    fn pre(\n        &mut self,\n        _sim: &mut Sim,\n        _input: &InputFrame,\n        _dt: f32,\n        _events: &mut Vec<SimEvent>,\n    ) -> BTreeMap<EntityId, InputFrame> {\n        BTreeMap::new()\n    }\n\n    /// After physics: the rules (pickups, damage, score, win and loss). Push `SimEvent`s for\n    /// sounds and effects (`Coin`, `Pickup`, `Hit`, `Explosion`...).\n    fn post(&mut self, _sim: &mut Sim, _dt: f32, _events: &mut Vec<SimEvent>) {}\n\n    /// HUD lines: drawn at the top left of the window, returned by the `play` tool.\n    fn hud(&self, _sim: &Sim) -> Vec<String> {\n        Vec::new()\n    }\n\n    /// The game's state for tools and tests (`play`), as JSON.\n    fn status(&self, _sim: &Sim) -> serde_json::Value {\n        serde_json::Value::Null\n    }\n\n    fn outcome(&self) -> Outcome {\n        Outcome::Playing\n    }\n\n    /// The input a good player would give this tick. `play bot=true` and the tests drive the\n    /// player with it; teach it every new rule, and keep a test that it wins.\n    fn bot(&self, _sim: &Sim) -> InputFrame {\n        InputFrame::default()\n    }\n}\n\n/// One line of [`GAMES`]: made with [`entry`].\npub struct Entry {\n    pub key: &'static str,\n    pub about: &'static str,\n    /// Builds the scene and sets `sim.state.play`. The `&str` is the rest of the scene name\n    /// after `<key>/` (a level number, say), if any.\n    pub build: fn(&mut Sim, Option<&str>) -> Result<()>,\n    load: fn(ciborium::Value) -> Result<GameBox, String>,\n}\n\n/// A [`GAMES`] line for the game type `G`.\npub const fn entry<G: Game>(about: &'static str, build: fn(&mut Sim, Option<&str>) -> Result<()>) -> Entry {\n    Entry { key: G::KEY, about, build, load: load_as::<G> }\n}\n\nfn load_as<G: Game>(v: ciborium::Value) -> Result<GameBox, String> {\n    v.deserialized::<G>().map(GameBox::new).map_err(|e| e.to_string())\n}\n\n/// A game's level text: `crates/pav_core/src/games/<key>.toml` read from disk when the program\n/// runs from the repository's root (`pav`, `cargo run`), so an edit shows at the next `load`\n/// with no rebuild; else `built_in`, the copy embedded with `include_str!` (tests, the browser,\n/// a shipped executable).\npub fn level_text(key: &str, built_in: &'static str) -> std::borrow::Cow<'static, str> {\n    #[cfg(not(target_arch = \"wasm32\"))]\n    if let Ok(text) = std::fs::read_to_string(format!(\"crates/pav_core/src/games/{key}.toml\")) {\n        return text.into();\n    }\n    #[cfg(target_arch = \"wasm32\")]\n    let _ = key; // the browser has no files\n    built_in.into()\n}\n\n/// The game registered under `key`.\npub fn find(key: &str) -> Option<&'static Entry> {\n    GAMES.iter().find(|g| g.key == key)\n}\n\n/// A running game in `SimState::play`: clones (rewind, snapshots) and serializes (snapshot\n/// files, the state hash) through the game's own derives.\npub struct GameBox(Box<dyn DynGame>);\n\nimpl GameBox {\n    pub fn new<G: Game>(game: G) -> Self {\n        Self(Box::new(game))\n    }\n\n    pub fn key(&self) -> &'static str {\n        self.0.key()\n    }\n\n    /// The game as its own type (None for another game).\n    pub fn get<G: Game>(&self) -> Option<&G> {\n        self.0.as_any().downcast_ref()\n    }\n\n    pub fn get_mut<G: Game>(&mut self) -> Option<&mut G> {\n        self.0.as_any_mut().downcast_mut()\n    }\n\n    pub fn hud(&self, sim: &Sim) -> Vec<String> {\n        self.0.hud(sim)\n    }\n\n    pub fn status(&self, sim: &Sim) -> serde_json::Value {\n        self.0.status(sim)\n    }\n\n    pub fn outcome(&self) -> Outcome {\n        self.0.outcome()\n    }\n\n    pub fn bot(&self, sim: &Sim) -> InputFrame {\n        self.0.bot(sim)\n    }\n}\n\nimpl Clone for GameBox {\n    fn clone(&self) -> Self {\n        Self(self.0.clone_box())\n    }\n}\n\n#[derive(Serialize, Deserialize)]\nstruct Saved {\n    key: String,\n    state: ciborium::Value,\n}\n\nimpl Serialize for GameBox {\n    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {\n        let state = self.0.save().map_err(serde::ser::Error::custom)?;\n        Saved { key: self.key().to_string(), state }.serialize(s)\n    }\n}\n\nimpl<'de> Deserialize<'de> for GameBox {\n    fn deserialize<D: Deserializer<'de>>(d: D) -> Result<Self, D::Error> {\n        let saved = Saved::deserialize(d)?;\n        let Some(entry) = find(&saved.key) else {\n            let known: Vec<&str> = GAMES.iter().map(|g| g.key).collect();\n            return Err(D::Error::custom(format!(\"unknown game '{}' (known: {})\", saved.key, known.join(\", \"))));\n        };\n        (entry.load)(saved.state).map_err(D::Error::custom)\n    }\n}\n\n/// [`Game`] as an object (the trait itself isn't one: `Clone` and serde).\ntrait DynGame: Send + Sync {\n    fn key(&self) -> &'static str;\n    fn clone_box(&self) -> Box<dyn DynGame>;\n    fn save(&self) -> Result<ciborium::Value, String>;\n    fn pre(&mut self, sim: &mut Sim, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) -> BTreeMap<EntityId, InputFrame>;\n    fn post(&mut self, sim: &mut Sim, dt: f32, events: &mut Vec<SimEvent>);\n    fn hud(&self, sim: &Sim) -> Vec<String>;\n    fn status(&self, sim: &Sim) -> serde_json::Value;\n    fn outcome(&self) -> Outcome;\n    fn bot(&self, sim: &Sim) -> InputFrame;\n    fn as_any(&self) -> &dyn Any;\n    fn as_any_mut(&mut self) -> &mut dyn Any;\n}\n\nimpl<G: Game> DynGame for G {\n    fn key(&self) -> &'static str {\n        G::KEY\n    }\n    fn clone_box(&self) -> Box<dyn DynGame> {\n        Box::new(self.clone())\n    }\n    fn save(&self) -> Result<ciborium::Value, String> {\n        ciborium::Value::serialized(self).map_err(|e| e.to_string())\n    }\n    fn pre(&mut self, sim: &mut Sim, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) -> BTreeMap<EntityId, InputFrame> {\n        Game::pre(self, sim, input, dt, events)\n    }\n    fn post(&mut self, sim: &mut Sim, dt: f32, events: &mut Vec<SimEvent>) {\n        Game::post(self, sim, dt, events)\n    }\n    fn hud(&self, sim: &Sim) -> Vec<String> {\n        Game::hud(self, sim)\n    }\n    fn status(&self, sim: &Sim) -> serde_json::Value {\n        Game::status(self, sim)\n    }\n    fn outcome(&self) -> Outcome {\n        Game::outcome(self)\n    }\n    fn bot(&self, sim: &Sim) -> InputFrame {\n        Game::bot(self, sim)\n    }\n    fn as_any(&self) -> &dyn Any {\n        self\n    }\n    fn as_any_mut(&mut self) -> &mut dyn Any {\n        self\n    }\n}\n\nimpl Sim {\n    /// The running game from [`GAMES`], if this scene is one.\n    pub fn play(&self) -> Option<&GameBox> {\n        self.state.play.as_ref()\n    }\n\n    /// The running game's outcome (`Playing` when there is none).\n    pub fn outcome(&self) -> Outcome {\n        self.play().map(|g| g.outcome()).unwrap_or_default()\n    }\n\n    /// The running game's bot input (none without a game).\n    pub fn bot_input(&self) -> InputFrame {\n        self.play().map(|g| g.bot(self)).unwrap_or_default()\n    }\n\n    pub(crate) fn play_pre(&mut self, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) -> BTreeMap<EntityId, InputFrame> {\n        let Some(mut g) = self.state.play.take() else { return BTreeMap::new() };\n        let out = g.0.pre(self, input, dt, events);\n        self.state.play = Some(g);\n        out\n    }\n\n    pub(crate) fn play_post(&mut self, dt: f32, events: &mut Vec<SimEvent>) {\n        let Some(mut g) = self.state.play.take() else { return };\n        g.0.post(self, dt, events);\n        self.state.play = Some(g);\n    }\n\n    pub(crate) fn play_hud(&self) -> Vec<String> {\n        self.play().map(|g| g.hud(self)).unwrap_or_default()\n    }\n\n    /// Plays the running game with its bot until it is won or lost, or `ticks` pass.\n    /// Returns the outcome and the ticks played.\n    pub fn run_bot(&mut self, ticks: u64) -> (Outcome, u64) {\n        for t in 0..ticks {\n            let o = self.outcome();\n            if o != Outcome::Playing {\n                return (o, t);\n            }\n            let input = self.bot_input();\n            self.step(&input);\n        }\n        (self.outcome(), ticks)\n    }\n}\n        pos: Vec3,\n        rarity: u8,\n    },\n    Pickup {\n        pos: Vec3,\n        rarity: u8,\n    },\n    /// Arrived somewhere else (Shardfall place code).\n    Travel {\n        place: u32,\n    },\n}\n\n/// The room the player is in, for the HUD (info card, control guide, camera defaults).\n#[derive(Clone, Debug)]\npub struct RoomInfo {\n    pub id: u16,\n    pub key: String,\n    pub def: std::sync::Arc<crate::room::RoomDef>,\n    /// Quarter turns (clockwise from above) the room was rotated by when placed.\n    pub quarters: u8,\n}\n\n/// A projectile as drawn (velocity lets the view interpolate).\n#[derive(Clone, Copy, Debug)]\npub struct ProjectileView {\n    pub pos: Vec3,\n    pub vel: Vec3,\n    pub radius: f32,\n    pub color: crate::color::Color,\n}\n\n/// Game state the HUD shows.\n#[derive(Clone, Debug, Default)]\npub struct HudFrame {\n    pub course: Option<crate::course::CourseHud>,\n    pub last_result: Option<crate::course::CourseResult>,\n    /// Short message and the tick it was posted.\n    pub message: Option<(String, u64)>,\n    pub feel: crate::feel::FeelReport,\n    /// Camera cue from pads / camera zones, and a counter that changes with it.\n    pub cue: Option<std::sync::Arc<crate::zones::CameraCue>>,\n    pub cue_serial: u64,\n    /// Player hit flash (seconds of invulnerability left).\n    pub invuln: f32,\n    pub model: String,\n    pub physics: PhysicsStats,\n    /// View settings from pads (applied on top of the room's), and a counter that changes.\n    pub view: std::collections::BTreeMap<String, crate::params::ParamValue>,\n    pub view_serial: u64,\n    /// Boss health bar: name and remaining fraction.\n    pub boss: Option<(String, f32)>,\n    /// The last pad with a note the player stepped on: label, note, tick.\n    pub pad_note: Option<(String, String, u64)>,\n    /// A `games` game's HUD lines (`Game::hud`).\n    pub lines: Vec<String>,\n}\n\n/// Physics counters for the stats overlay.\n#[derive(Clone, Copy, Debug, Default)]\npub struct PhysicsStats {\n    pub dynamic: usize,\n    pub sleeping: usize,\n    pub colliders: usize,\n    pub joints: usize,\n    pub soft_bodies: usize,\n    pub particles: usize,\n    pub contacts: usize,\n    pub projectiles: usize,\n}\n\n#[derive(Clone, Debug)]\npub struct RenderFrame {\n    pub tick: u64,\n    pub time: f64,\n    pub dt: f32,\n        }\n        if self.history.enabled && self.config.history_seconds > 0.0 {\n            self.history.window = (self.config.history_seconds * self.config.tick_rate.hz() as f32) as u64;\n            self.history.record(&self.state, input);\n        }\n        if self.recording.ticks() < MAX_RECORDING_TICKS {\n            self.recording.push(input);\n        }\n        self.step_inner(input);\n    }\n\n    fn step_inner(&mut self, input: &InputFrame) {\n        // Hit-stop slows the whole world for a moment.\n        let raw_dt = self.dt();\n        let dt = raw_dt * self.game_time_scale();\n        self.state.physics.params.dt = dt as Real;\n        self.state.physics.gravity = Vector::new(0.0, -self.config.gravity as Real, 0.0);\n\n        // Behaviours set this tick's velocities of moving objects; characters then move\n        // (rapier's controller carries them with kinematic platforms) and the physics step\n        // advances everything together.\n        self.run_behaviors(dt);\n\n        // Getting in and out of vehicles.\n        self.vehicle_interact(input);\n\n        // The game decides what the hero and its monsters do this tick.\n        let mut events = Vec::new();\n        let mut game_inputs = self.game_pre(input, dt, &mut events);\n        game_inputs.extend(self.play_pre(input, dt, &mut events));\n\n        // Characters.\n        let ids: Vec<EntityId> = self.state.entities.iter().filter(|e| e.character.is_some()).map(|e| e.id).collect();\n        let mut actions = Vec::new();\n        let idle = InputFrame::default();\n        let player_feet = self.player().and_then(|p| Some(p.pos - Vec3::Y * p.character.as_ref()?.height() * 0.5));\n        let all_feet: Vec<Vec3> =\n            self.state.entities.iter().filter_map(|e| Some(e.pos - Vec3::Y * e.character.as_ref()?.height() * 0.5)).collect();\n        let mut fallen = Vec::new();\n        for id in ids {\n            let npc_input: InputFrame;\n            let inp = if let Some(gi) = game_inputs.get(&id) {\n                gi\n            } else if Some(id) == self.state.player {\n                input\n            } else {\n    pub fn frame(&mut self) -> RenderFrame {\n        if *self.config_arc != self.config {\n            self.config_arc = std::sync::Arc::new(self.config.clone());\n        }\n        match self.studio_mode() {\n            crate::prop_preview::StudioMode::Animation => {\n                if let Some(preview) = &self.state.animation_preview {\n                    return preview.frame(self.config_arc.clone(), self.dt(), self.live_edit_ticket);\n                }\n            }\n            crate::prop_preview::StudioMode::Prop => {\n                if let Some(preview) = &self.state.prop_preview {\n                    return preview.frame(self.config_arc.clone(), self.dt(), self.live_edit_ticket);\n                }\n            }\n            crate::prop_preview::StudioMode::Creature => {\n                return match &self.state.creature_preview {\n                    Some(preview) => preview.frame(self.config_arc.clone(), self.dt(), self.live_edit_ticket),\n                    None => crate::creature_preview::empty_frame(self.config_arc.clone(), self.dt(), self.live_edit_ticket),\n                };\n            }\n            crate::prop_preview::StudioMode::World => {}\n        }\n        let room = self\n            .state\n            .world\n            .current_room\n            .and_then(|i| self.state.world.rooms.get(i as usize))\n            .map(|r| crate::frame::RoomInfo { id: r.id, key: r.key.clone(), def: r.def.clone(), quarters: r.place.quarters });\n        let c = &self.state.courses;\n        let invuln = self.player().and_then(|p| p.character.as_ref()).map(|c| c.invuln).unwrap_or(0.0);\n        let hud = crate::frame::HudFrame {\n            course: c.hud(self.state.tick, self.dt()),\n            last_result: c.last.clone(),\n            message: c.message.clone(),\n            feel: self.state.feel.report,\n            cue: c.cue(),\n            cue_serial: c.cue_serial,\n            invuln,\n            model: crate::params::ChoiceParam::name(self.config.movement.model).to_string(),\n            physics: self.physics_stats(),\n            view: c.view.clone(),\n            view_serial: c.view_serial,\n            boss: self.boss_bar(),\n            pad_note: c.pad_note.clone(),\n            lines: self.play_hud(),\n        };\n        RenderFrame {\n            tick: self.state.tick,\n            time: self.time(),\n            dt: self.dt(),\n            live_edit_ticket: self.live_edit_ticket,\n            objects: self\n                .state\n                .entities\n                .iter()\n                .filter_map(|e| {\n                    let puppet = e.character.as_ref().filter(|c| c.riding.is_none()).map(|c| PuppetFrame {\n                        state: c.anim,\n                        feet_offset: c.height() * 0.5,\n                        def: c.puppet.clone(),\n                        rig: c.rig.as_ref().map(|r| r.view()),\n                        tint: self.state.game.as_ref().and_then(|g| g.tint(e.id)),\n                    });\n                    if e.visual.is_none() && puppet.is_none() {\n                        return None;\n                    }\n                    let mut visual = e.visual.clone().unwrap_or(Visual::new(Shape::Sphere { radius: 0.0 }, Color::WHITE));\n                    if e.health.as_ref().is_some_and(|h| h.flash > 0.0) {\n                        // Hit flash.\n                        visual.color = Color::WHITE;\n                        visual.emissive = visual.emissive.max(0.45);\n                    }\n                    let pulse = e.bomb.as_ref().map(|b| b.fuse).unwrap_or(-1.0);\n                    let soft = e.soft.as_ref().and_then(|s| {\n                        let h = s.handle?;\n                        let radius = match &s.def.shape {\n                            crate::softbody::SoftShape::Rope { radius, .. } => *radius,\n                            _ => 0.0,\n                        };\n                        Some(crate::frame::SoftView {\n                            points: self.state.physics.soft_positions(h),\n                            surface: s.surface.clone(),\n                            segments: s.segments.clone(),\n                            radius,\n                            two_sided: matches!(s.def.shape, crate::softbody::SoftShape::Cloth { .. }),\n                        })\n                    });\n                    let vehicle = e.vehicle.as_ref().map(|v| v.view());\n                    let cone = self.guard_cone(e);\n        }\n    }\n}\n\nimpl PuppetDef {\n    /// Whether `key` is a look setting: a field of the serialized puppet `table`, or one the\n    /// serialization leaves out while empty (`figure`, so looks without one keep their bytes).\n    pub fn is_look_setting(table: &toml::Table, key: &str) -> bool {\n        table.contains_key(key) || key == \"figure\"\n    }\n\n    /// Sensible proportions and colours for a body plan.\n    pub fn preset(plan: BodyPlan) -> Self {\n        let d = Self::default();\n        match plan {\n            BodyPlan::Biped => d,\n            BodyPlan::Spider => Self {\n                body: plan,\n                legs: 4,\n                leg_length: 0.8,\n                torso_radius: 0.2,\n                head_radius: 0.12,\n                limb_radius: 0.035,\n                skin: \"#3b3540\".into(),\n                shirt: \"#4a4252\".into(),\n                accent: \"#c0563b\".into(),\n                eyes: \"#f2e6c9\".into(),\n                step_time: 0.12,\n                ..d\n            },\n            BodyPlan::Lizard => Self {\n                body: plan,\n                legs: 2,\n                leg_length: 0.42,\n                torso_radius: 0.15,\n                head_radius: 0.14,\n                limb_radius: 0.05,\n                body_length: 0.9,\n                tail_length: 1.0,\n                skin: \"#6fae5a\".into(),\n                shirt: \"#5d9a4c\".into(),\n                accent: \"#e8c547\".into(),\n                step_time: 0.14,\n                ..d\n            },\n            BodyPlan::Beetle => Self {\n                body: plan,\n                legs: 3,\n                leg_length: 0.5,\n                torso_radius: 0.24,\n                head_radius: 0.13,\n                limb_radius: 0.035,\n                body_length: 0.75,\n                antenna_length: 0.45,\n                skin: \"#26303b\".into(),\n                shirt: \"#2e6f8e\".into(),\n                accent: \"#9fd3e6\".into(),\n                step_time: 0.1,\n                ..d\n            },\n            BodyPlan::Quadruped => Self {\n                body: plan,\n                legs: 2,\n                leg_length: 0.5,\n                torso_radius: 0.17,\n                head_radius: 0.13,\n                limb_radius: 0.045,\n                body_length: 0.75,\n                tail_length: 0.45,\n                skin: \"#8a6a4a\".into(),\n                shirt: \"#9a7650\".into(),\n                accent: \"#e8d2b0\".into(),\n                eyes: \"#2a1e14\".into(),\n                step_time: 0.13,\n                wobble: 1.2,\n                ..d\n            },\n            BodyPlan::Blob => Self {\n                body: plan,\n                torso_radius: 0.42,\n                head_radius: 0.0,\n                skin: \"#7fd6a4\".into(),\n                shirt: \"#7fd6a4\".into(),\n                squash: 1.6,\n                stride: 1.4,\n                ..d\n            },\n        }\n    }\n\n    /// Leg pairs actually used.\n    pub fn leg_pairs(&self) -> usize {\n        let n = match self.body {\n            BodyPlan::Biped | BodyPlan::Blob => return 0,\n            BodyPlan::Spider => 4,\n            BodyPlan::Lizard => 2,\n            BodyPlan::Beetle => 3,\n            BodyPlan::Quadruped => 2,\n        };\n        if self.legs > 0 { self.legs.clamp(1, 6) as usize } else { n }\n    }\n}\n\nimpl Tunable for PuppetDef {\n    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n        v.float(\"scale\", &mut self.scale, 0.3, 3.0, \"Overall size\");\n        v.float(\"head_radius\", &mut self.head_radius, 0.0, 0.5, \"Head size (m)\");\n        v.float(\"torso_length\", &mut self.torso_length, 0.15, 0.9, \"Torso length (m)\");\n        v.float(\"torso_radius\", &mut self.torso_radius, 0.08, 0.45, \"Torso thickness (m)\");\n        v.float(\"hip_width\", &mut self.hip_width, 0.04, 0.3, \"Half distance between hips (m)\");\n        v.float(\"shoulder_width\", &mut self.shoulder_width, 0.08, 0.45, \"Half distance between shoulders (m)\");\n\n/// The whole-body motion of `motion` as one rigid move about the feet: a point `x` goes to\n/// `feet + q · (x − feet) + shift`.\npub fn body_motion(def: &PuppetDef, st: &PuppetState) -> (Quat, Vec3) {\n    let k = def.scale;\n    let fwd = Quat::from_rotation_y(st.facing) * Vec3::Z;\n    let right = Quat::from_rotation_y(st.facing) * Vec3::X;\n    let mut shift = Vec3::Y * st.lift;\n    if def.body != BodyPlan::Biped && st.act_kind != 0 {\n        // A creature's \"lunge\" springs the whole body forward (other moves lunge through the rig).\n        let table = crate::moves::table();\n        if table.get(st.act_kind).is_some_and(|m| m.name == \"lunge\") {\n            if let Some(f) = crate::moves::frame(&table, st.act_kind, st.act, st.act_hit, st.act_side) {\n                shift += fwd * (f.lunge / 0.25).clamp(-0.4, 1.0) * 0.45 * k;\n            }\n        }\n    }\n    let spin = (st.spin.abs() > 1e-4).then(|| Quat::from_rotation_y(st.spin));\n    let down = st.down.clamp(0.0, 1.0);\n    // A clip (a death fall) lays the body down itself; the procedural topple gives way to it.\n    // The sink comes after either (a body that lies where it fell, the hero's, stays at half).\n    let topple = (down > 0.0).then(|| Quat::from_axis_angle(right, -1.45 * smooth(0.0, 0.45, down) * (1.0 - st.clip_w)));\n    let sink = Vec3::Y * (-1.2 * k * smooth(0.55, 1.0, down));\n    (topple.unwrap_or(Quat::IDENTITY) * spin.unwrap_or(Quat::IDENTITY), shift + sink)\n}\n\n//! Shardfall's game UI, drawn with egui: the HUD (`arpg_ui`), the inventory, shop, stash and\n//! character windows (`arpg_items`), the passive tree (`arpg_tree`) and the touch controls\n//! (`touch`). The window (`pav_app`) draws it over the game; the tools draw the same code on a\n//! headless context (`headless`): a text reading of what is on screen, and the UI over captures.\n\npub mod arpg_items;\npub mod arpg_tree;\npub mod arpg_ui;\npub mod headless;\npub mod touch;\n\n/// The input device the player is on: hints and the HUD follow it.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\npub enum Device {\n    #[default]\n    KeyboardMouse,\n    Gamepad,\n    /// A phone or tablet (touch.rs).\n    Touch,\n}\n\n/// Touch screens: bigger targets, a little bigger text, thicker scroll bars, and dragging\n/// scrolls. `on = false` puts the desktop sizes back.\npub fn touch_style(ctx: &egui::Context, on: bool) {\n    use egui::{FontId, TextStyle};\n    ctx.all_styles_mut(|s| {\n        s.spacing = egui::style::Spacing::default();\n        s.text_styles = egui::style::default_text_styles();\n        if on {\n            let sp = &mut s.spacing;\n            sp.interact_size = egui::vec2(44.0, 34.0);\n            sp.button_padding = egui::vec2(12.0, 7.0);\n            sp.item_spacing = egui::vec2(10.0, 8.0);\n            sp.slider_width = 170.0;\n            sp.icon_width = 20.0;\n            sp.icon_width_inner = 12.0;\n            sp.combo_height = 320.0;\n            sp.scroll = egui::style::ScrollStyle::solid();\n            sp.scroll.bar_width = 8.0;\n            for (style, size) in\n                [(TextStyle::Body, 15.0), (TextStyle::Button, 15.0), (TextStyle::Small, 12.0), (TextStyle::Heading, 20.0)]\n            {\n                s.text_styles.insert(style, FontId::proportional(size));\n            }\n            s.interaction.tooltip_delay = 0.35;\n        }\n    });\n}\n\n/// A `pav_core::games` game's HUD lines (`Game::hud`), top left.\npub fn game_lines(ctx: &egui::Context, h: &pav_core::frame::HudFrame) {\n    if h.lines.is_empty() {\n        return;\n    }\n    egui::Area::new(egui::Id::new(\"game_lines\")).anchor(egui::Align2::LEFT_TOP, [16.0, 60.0]).show(ctx, |ui| {\n        egui::Frame::popup(ui.style()).show(ui, |ui| {\n            for line in &h.lines {\n                ui.label(egui::RichText::new(line).monospace().size(18.0).strong());\n            }\n        });\n    });\n}\n    pub fn frame(\n        &mut self,\n        game: Option<&GameFrame>,\n        hud_lines: &HudFrame,\n        vp: Mat4,\n        width: u32,\n        height: u32,\n        input: Input,\n    ) -> Drawn {\n        let ctx = egui::Context::default();\n        let touch = self.device == Device::Touch;\n        crate::touch_style(&ctx, touch);\n        ctx.all_styles_mut(|s| {\n            s.animation_time = 0.0;\n            s.interaction.tooltip_delay = 0.0;\n        });\n        self.game.touch = touch;\n        self.game.tree.touch = touch;\n        self.game.pad = self.device == Device::Gamepad;\n        self.game.tree.pad = self.game.pad;\n        let screen = Rect::from_min_size(Pos2::ZERO, egui::vec2(width as f32, height as f32));\n        let mut textures = egui::TexturesDelta::default();\n        let mut commands = Vec::new();\n        let mut output = None;\n        let mut layers = Vec::new();\n        for pass in 0..PASSES + input.click.is_some() as usize {\n            let mut events = Vec::new();\n            if let Some(p) = input.click.or(input.hover) {\n                events.push(egui::Event::PointerMoved(p));\n            }\n            // The click lands in the last pass, once the windows are laid out.\n            if let Some(p) = input.click.filter(|_| pass == PASSES) {\n                for pressed in [true, false] {\n                    events.push(egui::Event::PointerButton {\n                        pos: p,\n                        button: egui::PointerButton::Primary,\n                        pressed,\n                        modifiers: Default::default(),\n                    });\n                }\n            }\n            let raw = egui::RawInput {\n                screen_rect: Some(screen),\n                time: Some(pass as f64 / 60.0),\n                predicted_dt: 1.0 / 60.0,\n                events,\n                ..Default::default()\n            };\n            self.touch.swipes.begin_frame();\n            let last = pass + 1 == PASSES + input.click.is_some() as usize;\n            let out = ctx.run_ui(raw, |ui| {\n                let root = ui.layer_id();\n                let ctx = ui.ctx().clone();\n                if let Some(g) = game {\n                    let proj = Projector { vp, size: screen.size() };\n                    hud(&ctx, g, &proj, self.device, self.game.map, &mut self.touch.swipes);\n                    let given = self.game.ui(&ctx, g, &proj);\n                    if pass == PASSES {\n                        commands = given;\n                    }\n                }\n                crate::game_lines(&ctx, hud_lines);\n                if touch && game.is_some() {\n                    let map_hidden = self.touch.swipes.is_gone(egui::Id::new(\"minimap\"), 0);\n                    let points = game.and_then(|g| g.inv.as_ref()).map(|i| i.points).unwrap_or(0);\n                    let covered = self.game.any_open();\n                    self.touch.draw(&ctx, &View { game, auto_attack: true, map_hidden, points, covered });\n                }\n                if last {\n                    layers = window_layers(&ctx, root, screen);\n                }\n            });\n            let mut out = out;\n            textures.append(std::mem::take(&mut out.textures_delta));\n            output = Some(out);\n        }\n        let output = output.unwrap();\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"ls crates/pav_audio/src; cat crates/pav_audio/src/lib.rs; sed -n '1,140p' crates/pav_audio/src/mixer.rs; sed -n '1370,1445p' crates/pav_app/src/app.rs; sed -n '1445,1565p' crates/pav_app/src/app.rs; rg -n 'fn new|bindings =|Scene|scene:|resume_audio|device|hud\\\\.' crates/pav_app/src/settings.rs crates/pav_app/src/app.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"ls crates/pav_audio/src; cat crates/pav_audio/src/lib.rs; sed -n '1,140p' crates/pav_audio/src/mixer.rs; sed -n '1370,1445p' crates/pav_app/src/app.rs; sed -n '1445,1565p' crates/pav_app/src/app.rs; rg -n 'fn new|bindings =|Scene|scene:|resume_audio|device|hud\\\\.' crates/pav_app/src/settings.rs crates/pav_app/src/app.rs\"","aggregated_output":"lib.rs\n//! Synthesized sound: every sound is built from oscillators, noise, envelopes, pitch sweeps\n//! and a filter. The mixer runs in the audio callback (cpal) or offline (to .wav). The game\n//! runs fine without a sound device.\n\nuse std::sync::mpsc::{Receiver, Sender, channel};\n\nuse glam::Vec3;\nuse pav_core::SimEvent;\n\n#[derive(Clone, Copy, Debug, PartialEq)]\npub enum Wave {\n    Sine,\n    Square,\n    Saw,\n    Triangle,\n    Noise,\n}\n\n/// One synthesized sound.\n#[derive(Clone, Copy, Debug)]\npub struct Patch {\n    pub wave: Wave,\n    /// Start / end frequency (Hz) and the glide time between them (s, exponential).\n    pub freq: f32,\n    pub freq_end: f32,\n    pub glide: f32,\n    pub attack: f32,\n    pub decay: f32,\n    pub sustain: f32,\n    pub hold: f32,\n    pub release: f32,\n    pub volume: f32,\n    /// One-pole low-pass cutoff (Hz) at start and end of the sound.\n    pub cutoff: f32,\n    pub cutoff_end: f32,\n    /// Square-wave duty cycle.\n    pub duty: f32,\n}\n\nimpl Patch {\n    pub const fn new(wave: Wave, freq: f32) -> Self {\n        Self {\n            wave,\n            freq,\n            freq_end: freq,\n            glide: 0.1,\n            attack: 0.002,\n            decay: 0.1,\n            sustain: 0.0,\n            hold: 0.0,\n            release: 0.05,\n            volume: 0.3,\n            cutoff: 12000.0,\n            cutoff_end: 12000.0,\n            duty: 0.5,\n        }\n    }\n    pub fn length(&self) -> f32 {\n        self.attack + self.decay + self.hold + self.release\n    }\n}\n\nstruct Voice {\n    p: Patch,\n    t: f32,\n    delay: f32,\n    phase: f32,\n    lp: f32,\n    noise: u32,\n    gain_l: f32,\n    gain_r: f32,\n}\n\nimpl Voice {\n    fn env(&self) -> f32 {\n        let p = &self.p;\n        let t = self.t;\n        if t < p.attack {\n            return t / p.attack.max(1e-5);\n        }\n        let t = t - p.attack;\n        if t < p.decay {\n            return 1.0 + (p.sustain - 1.0) * (t / p.decay.max(1e-5));\n        }\n        let t = t - p.decay;\n        if t < p.hold {\n            return p.sustain;\n        }\n        let t = t - p.hold;\n        let start = if p.decay > 0.0 || p.hold > 0.0 { p.sustain } else { 1.0 };\n        (start * (1.0 - t / p.release.max(1e-5))).max(0.0)\n    }\n\n    fn done(&self) -> bool {\n        self.t > self.p.length() + 0.01\n    }\n\n    fn next(&mut self, dt: f32) -> f32 {\n        if self.delay > 0.0 {\n            self.delay -= dt;\n            return 0.0;\n        }\n        let p = self.p;\n        let k = (self.t / p.glide.max(1e-4)).min(1.0);\n        let freq = p.freq * (p.freq_end / p.freq.max(1.0)).powf(k);\n        self.phase = (self.phase + freq * dt).fract();\n        let ph = self.phase;\n        let raw = match p.wave {\n            Wave::Sine => (ph * std::f32::consts::TAU).sin(),\n            Wave::Square => {\n                if ph < p.duty {\n                    1.0\n                } else {\n                    -1.0\n                }\n            }\n            Wave::Saw => ph * 2.0 - 1.0,\n            Wave::Triangle => 1.0 - 4.0 * (ph - 0.5).abs(),\n            Wave::Noise => {\n                self.noise ^= self.noise << 13;\n                self.noise ^= self.noise >> 17;\n                self.noise ^= self.noise << 5;\n                (self.noise as f32 / u32::MAX as f32) * 2.0 - 1.0\n            }\n        };\n        let cutoff = p.cutoff * (p.cutoff_end / p.cutoff.max(1.0)).powf((self.t / p.length().max(1e-3)).min(1.0));\n        let a = 1.0 - (-std::f32::consts::TAU * cutoff * dt).exp();\n        self.lp += (raw - self.lp) * a;\n        let s = self.lp * self.env() * p.volume;\n        self.t += dt;\n        s\n    }\n}\n\n/// Mixes voices into interleaved stereo.\npub struct Mixer {\n    voices: Vec<Voice>,\n    pub sample_rate: f32,\n    pub master: f32,\n    seed: u32,\n}\n\nconst MAX_VOICES: usize = 64;\n\nimpl Mixer {\n    pub fn new(sample_rate: f32) -> Self {\n        Self { voices: Vec::new(), sample_rate, master: 0.8, seed: 0x9e37_79b9 }\n    }\n\n    /// pan -1 (left) .. 1 (right); delay in seconds.\n    pub fn play(&mut self, p: Patch, pan: f32, gain: f32, delay: f32) {\n        if self.voices.len() >= MAX_VOICES {\n            // Drop the oldest.\n            self.voices.remove(0);\n        }\n        self.seed = self.seed.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);\n        let pan = pan.clamp(-1.0, 1.0);\n        let a = (pan + 1.0) * std::f32::consts::FRAC_PI_4;\n        self.voices.push(Voice {\n            p,\n            t: 0.0,\n            delay,\n            phase: 0.0,\n            lp: 0.0,\n            noise: self.seed | 1,\n            gain_l: a.cos() * gain,\n            gain_r: a.sin() * gain,\n        });\n    }\n\n    /// Renders into an interleaved stereo buffer (overwrites).\n    pub fn render(&mut self, out: &mut [f32]) {\n        let dt = 1.0 / self.sample_rate;\n        for frame in out.chunks_mut(2) {\n            let (mut l, mut r) = (0.0, 0.0);\n            for v in &mut self.voices {\n                let s = v.next(dt);\n                l += s * v.gain_l;\n                r += s * v.gain_r;\n            }\n            // Soft clip.\n            let m = self.master;\n            frame[0] = (l * m).tanh();\n            if frame.len() > 1 {\n                frame[1] = (r * m).tanh();\n            }\n        }\n        self.voices.retain(|v| !v.done());\n    }\n\n    pub fn active(&self) -> usize {\n        self.voices.len()\n    }\n}\n\n/// Where the ears are: position and the camera's right vector (for panning).\n#[derive(Clone, Copy, Debug)]\npub struct Listener {\n    pub pos: Vec3,\n    pub right: Vec3,\n}\n\nimpl Default for Listener {\n    fn default() -> Self {\n        Self { pos: Vec3::ZERO, right: Vec3::X }\n    }\n}\n\n/// The sound bank: which patches play for a simulation event.\npub fn sounds_for(ev: &SimEvent) -> Vec<(Patch, f32)> {\n    use Wave::*;\n    match ev {\n        SimEvent::Jump { .. } => vec![(\n            Patch {\n                freq_end: 640.0,\n                glide: 0.11,\n                decay: 0.12,\n                volume: 0.18,\n                cutoff: 3500.0,\n                cutoff_end: 2500.0,\n                duty: 0.3,\n                ..Patch::new(Square, 280.0)\n            },\n            0.0,\n        )],\n        SimEvent::Land { speed, .. } => {\n            let v = (speed / 14.0).clamp(0.15, 1.0);\n            vec![\n                (Patch { decay: 0.12, volume: 0.35 * v, cutoff: 1100.0, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) }, 0.0),\n                (Patch { freq_end: 45.0, glide: 0.1, decay: 0.14, volume: 0.45 * v, ..Patch::new(Sine, 110.0) }, 0.0),\n            ]\n        }\n        SimEvent::Step { .. } => {\n            vec![(Patch { decay: 0.045, volume: 0.07, cutoff: 1800.0, cutoff_end: 500.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n        }\n        SimEvent::Throw { .. } => vec![(\n            Patch { attack: 0.03, decay: 0.16, volume: 0.1, cutoff: 900.0, cutoff_end: 4500.0, ..Patch::new(Noise, 1.0) },\n            0.0,\n        )],\n        SimEvent::Explosion { radius, .. } => {\n            let v = (radius / 1.35).clamp(0.5, 2.0);\n            vec![\n                (\n                    Patch {\n                        attack: 0.004,\n                        decay: 0.25,\n                        sustain: 0.35,\n                        hold: 0.1,\n                        release: 0.6,\n                        volume: 0.6 * v,\n                        cutoff: 4000.0,\n                        cutoff_end: 120.0,\n                        ..Patch::new(Noise, 1.0)\n                    },\n                    0.0,\n                ),\n                (Patch { freq_end: 28.0, glide: 0.5, decay: 0.7, volume: 0.7 * v, ..Patch::new(Sine, 85.0) }, 0.0),\n            ]\n        }\n        SimEvent::EnterRoom { .. } => vec![\n            (Patch { decay: 0.25, volume: 0.12, ..Patch::new(Triangle, 659.3) }, 0.0),\n            (Patch { decay: 0.35, volume: 0.12, ..Patch::new(Triangle, 987.8) }, 0.09),\n        ],\n        SimEvent::Hit { strength, .. } => {\n            let v = (strength / 8.0).clamp(0.4, 1.2);\n            vec![\n                (Patch { decay: 0.09, volume: 0.3 * v, cutoff: 2500.0, cutoff_end: 300.0, ..Patch::new(Noise, 1.0) }, 0.0),\n                (\n                    Patch { freq_end: 90.0, glide: 0.12, decay: 0.16, volume: 0.3 * v, duty: 0.4, ..Patch::new(Square, 220.0) },\n                    0.0,\n                ),\n            ]\n        }\n        // Shardfall.\n        SimEvent::Swing { heavy, .. } => {\n            let h = if *heavy { 1.4 } else { 1.0 };\n            vec![(\n                Patch {\n                    attack: 0.02,\n                    decay: 0.12 * h,\n                    volume: 0.16 * h,\n                    cutoff: 1800.0,\n                    cutoff_end: 5200.0,\n                    ..Patch::new(Noise, 1.0)\n                },\n                0.0,\n            )]\n        }\n        SimEvent::Strike { power, element, crit, .. } => {\n            let v = (power.sqrt() / 4.0).clamp(0.35, 1.2) * if *crit { 1.3 } else { 1.0 };\n            let tone = [150.0, 120.0, 520.0, 900.0, 260.0][(*element as usize).min(4)];\n            let mut out = vec![\n                (Patch { decay: 0.07, volume: 0.24 * v, cutoff: 3200.0, cutoff_end: 400.0, ..Patch::new(Noise, 1.0) }, 0.0),\n                (\n                    Patch {\n                        freq_end: tone * 0.5,\n                        glide: 0.08,\n                        decay: 0.1,\n                        volume: 0.2 * v,\n                        duty: 0.35,\n                        ..Patch::new(Square, tone)\n                    },\n                    0.0,\n                ),\n            ];\n            if *crit {\n                out.push((Patch { decay: 0.18, volume: 0.12, ..Patch::new(Triangle, 1760.0) }, 0.01));\n            }\n            out\n        }\n        SimEvent::Slain { size, .. } => {\n            let k = size.clamp(0.3, 1.5);\n            vec![\n                (\n                    Patch {\n                        freq_end: 60.0,\n                        glide: 0.3,\n                        decay: 0.3,\n                        volume: 0.22 * k,\n                        duty: 0.5,\n                        ..Patch::new(Square, 180.0 / k)\n                    },\n                    0.0,\n                ),\n                (Patch { decay: 0.25, volume: 0.15, cutoff: 1500.0, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) }, 0.02),\n            ]\n        }\n        SimEvent::Slam { radius, .. } => {\n            let k = (radius / 2.5).clamp(0.6, 1.5);\n            vec![\n                (Patch { freq_end: 40.0, glide: 0.35, decay: 0.4, volume: 0.45 * k, ..Patch::new(Sine, 110.0) }, 0.0),\n                (Patch { decay: 0.3, volume: 0.3 * k, cutoff: 2200.0, cutoff_end: 150.0, ..Patch::new(Noise, 1.0) }, 0.0),\n            ]\n        }\n        SimEvent::Blast { element, .. } => {\n            let cut = [2500.0, 3500.0, 6000.0, 8000.0, 2000.0][(*element as usize).min(4)];\n            vec![\n                (\n                    Patch { attack: 0.003, decay: 0.3, volume: 0.35, cutoff: cut, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) },\n                    0.0,\n                ),\n                (Patch { freq_end: 50.0, glide: 0.25, decay: 0.3, volume: 0.25, ..Patch::new(Sine, 140.0) }, 0.0),\n            ]\n        }\n        SimEvent::Spell { element, .. } => {\n            let f = [300.0, 260.0, 900.0, 1400.0, 420.0][(*element as usize).min(4)];\n            vec![(\n                Patch {\n                    freq_end: f * 1.8,\n                    glide: 0.15,\n                    attack: 0.02,\n                    decay: 0.18,\n                    volume: 0.12,\n                    duty: 0.25,\n                    ..Patch::new(Saw, f)\n                },\n                0.0,\n            )]\n        }\n        SimEvent::Coin { .. } => vec![\n            (Patch { decay: 0.08, volume: 0.1, ..Patch::new(Triangle, 1980.0) }, 0.0),\n            (Patch { decay: 0.12, volume: 0.09, ..Patch::new(Triangle, 2640.0) }, 0.05),\n        ],\n        // Drops chime by rarity: rares ring, uniques ring a chord.\n        SimEvent::Loot { rarity, .. } => match rarity {\n            0 => vec![(Patch { decay: 0.05, volume: 0.05, cutoff: 2500.0, ..Patch::new(Triangle, 880.0) }, 0.0)],\n            1 => vec![(Patch { decay: 0.12, volume: 0.08, ..Patch::new(Triangle, 1320.0) }, 0.0)],\n            2 => vec![\n                (Patch { decay: 0.25, volume: 0.12, ..Patch::new(Triangle, 1568.0) }, 0.0),\n                (Patch { decay: 0.35, volume: 0.1, ..Patch::new(Sine, 2093.0) }, 0.08),\n            ],\n            _ => vec![\n                (Patch { decay: 0.5, volume: 0.14, ..Patch::new(Triangle, 784.0) }, 0.0),\n                (Patch { decay: 0.5, volume: 0.13, ..Patch::new(Triangle, 988.0) }, 0.06),\n                (Patch { decay: 0.6, volume: 0.13, ..Patch::new(Triangle, 1175.0) }, 0.12),\n                (Patch { decay: 0.9, volume: 0.12, ..Patch::new(Sine, 1568.0) }, 0.2),\n            ],\n        },\n        SimEvent::Pickup { .. } => {\n            vec![(Patch { freq_end: 1400.0, glide: 0.06, decay: 0.07, volume: 0.08, ..Patch::new(Triangle, 700.0) }, 0.0)]\n        }\n        SimEvent::Travel { .. } => vec![\n            (Patch { freq_end: 1200.0, glide: 0.5, decay: 0.6, volume: 0.12, ..Patch::new(Sine, 200.0) }, 0.0),\n            (Patch { freq_end: 2400.0, glide: 0.4, decay: 0.5, volume: 0.06, ..Patch::new(Triangle, 600.0) }, 0.1),\n        ],\n        SimEvent::Potion { .. } => {\n            vec![(Patch { freq_end: 700.0, glide: 0.3, decay: 0.3, volume: 0.14, ..Patch::new(Sine, 300.0) }, 0.0)]\n        }\n        SimEvent::Block { .. } => {\n            vec![(Patch { decay: 0.2, volume: 0.2, cutoff: 6000.0, cutoff_end: 3000.0, ..Patch::new(Square, 1200.0) }, 0.0)]\n        }\n        SimEvent::LevelUp { .. } => vec![\n            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 523.0) }, 0.0),\n            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 659.0) }, 0.1),\n            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 784.0) }, 0.2),\n            (Patch { decay: 0.5, volume: 0.18, ..Patch::new(Triangle, 1047.0) }, 0.3),\n        ],\n        SimEvent::Respawn { .. } => vec![\n            (Patch { freq_end: 880.0, glide: 0.18, decay: 0.2, volume: 0.12, ..Patch::new(Sine, 220.0) }, 0.0),\n            (Patch { decay: 0.15, volume: 0.08, ..Patch::new(Triangle, 1320.0) }, 0.16),\n        ],\n        SimEvent::CourseStart { .. } => vec![(Patch { decay: 0.12, volume: 0.14, ..Patch::new(Square, 880.0) }, 0.0)],\n        SimEvent::Gate { ok, .. } => {\n            if *ok {\n                vec![(Patch { decay: 0.1, volume: 0.12, ..Patch::new(Triangle, 1046.5) }, 0.0)]\n            } else {\n                vec![(\n                    Patch { freq_end: 160.0, glide: 0.2, decay: 0.25, volume: 0.14, duty: 0.3, ..Patch::new(Square, 330.0) },\n                    0.0,\n                )]\n            }\n        }\n        SimEvent::CourseFinish { new_best, .. } => {\n            let mut v = vec![\n                (Patch { decay: 0.18, volume: 0.13, ..Patch::new(Triangle, 523.3) }, 0.0),\n                (Patch { decay: 0.18, volume: 0.13, ..Patch::new(Triangle, 659.3) }, 0.1),\n                (Patch { decay: 0.4, volume: 0.14, ..Patch::new(Triangle, 784.0) }, 0.2),\n            ];\n            if *new_best {\n                v.push((Patch { decay: 0.5, volume: 0.13, ..Patch::new(Triangle, 1046.5) }, 0.34));\n            }\n            v\n        }\n        SimEvent::Checkpoint { .. } => vec![\n            (Patch { decay: 0.12, volume: 0.1, ..Patch::new(Sine, 1174.7) }, 0.0),\n            (Patch { decay: 0.2, volume: 0.1, ..Patch::new(Sine, 1568.0) }, 0.07),\n        ],\n        SimEvent::Splash { .. } => vec![(\n            Patch { attack: 0.01, decay: 0.35, volume: 0.25, cutoff: 3000.0, cutoff_end: 400.0, ..Patch::new(Noise, 1.0) },\n            0.0,\n        )],\n        SimEvent::Pad { .. } => {\n            vec![(Patch { freq_end: 1200.0, glide: 0.08, decay: 0.12, volume: 0.1, ..Patch::new(Sine, 600.0) }, 0.0)]\n        }\n        SimEvent::Grab { .. } => {\n            vec![(Patch { decay: 0.05, volume: 0.12, cutoff: 1500.0, cutoff_end: 600.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n        }\n        SimEvent::Break { .. } => vec![\n            (Patch { decay: 0.18, volume: 0.3, cutoff: 6000.0, cutoff_end: 900.0, ..Patch::new(Noise, 1.0) }, 0.0),\n            (Patch { freq_end: 70.0, glide: 0.15, decay: 0.2, volume: 0.25, ..Patch::new(Sine, 160.0) }, 0.0),\n        ],\n        SimEvent::Crack { .. } => {\n            vec![(Patch { decay: 0.04, volume: 0.12, cutoff: 5000.0, cutoff_end: 2000.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n        }\n        SimEvent::Bounce { .. } => {\n            vec![(Patch { freq_end: 900.0, glide: 0.18, decay: 0.22, volume: 0.16, ..Patch::new(Sine, 180.0) }, 0.0)]\n        }\n        SimEvent::Roll { .. } => vec![(\n            Patch { attack: 0.02, decay: 0.2, volume: 0.1, cutoff: 600.0, cutoff_end: 2400.0, ..Patch::new(Noise, 1.0) },\n            0.0,\n        )],\n        SimEvent::Spotted { .. } => vec![\n            (Patch { decay: 0.18, volume: 0.16, ..Patch::new(Square, 990.0) }, 0.0),\n            (Patch { decay: 0.25, volume: 0.16, ..Patch::new(Square, 660.0) }, 0.16),\n        ],\n        SimEvent::Shot { .. } => {\n            vec![(Patch { freq_end: 420.0, glide: 0.06, decay: 0.06, volume: 0.05, ..Patch::new(Square, 1500.0) }, 0.0)]\n        }\n        SimEvent::Damage { .. } => {\n            vec![(Patch { decay: 0.03, volume: 0.08, cutoff: 3500.0, cutoff_end: 1200.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n        }\n        SimEvent::Destroyed { size, .. } => {\n            let v = size.clamp(0.4, 2.0);\n            vec![\n                (\n                    Patch {\n                        attack: 0.003,\n                        decay: 0.3,\n                        volume: 0.35 * v,\n                        cutoff: 5000.0,\n                        cutoff_end: 200.0,\n                        ..Patch::new(Noise, 1.0)\n                    },\n                    0.0,\n                ),\n                (Patch { freq_end: 40.0, glide: 0.35, decay: 0.4, volume: 0.4 * v, ..Patch::new(Sine, 140.0) }, 0.0),\n            ]\n        }\n        _ => Vec::new(),\n    }\n}\n\n/// Position of an event (None = not spatial).\npub fn event_pos(ev: &SimEvent) -> Option<Vec3> {\n    match ev {\n        SimEvent::Jump { pos }\n        | SimEvent::Land { pos, .. }\n        | SimEvent::Step { pos }\n        | SimEvent::Throw { pos }\n        | SimEvent::Explosion { pos, .. }\n        | SimEvent::Impact { pos, .. }\n        | SimEvent::Hit { pos, .. }\n        | SimEvent::Splash { pos }\n        | SimEvent::Grab { pos }\n        | SimEvent::Roll { pos }\n        | SimEvent::Break { pos }\n        | SimEvent::Crack { pos }\n        | SimEvent::Bounce { pos }\n        | SimEvent::Shot { pos }\n        | SimEvent::Damage { pos }\n        | SimEvent::Destroyed { pos, .. }\n        | SimEvent::Swing { pos, .. }\n        | SimEvent::Strike { pos, .. }\n        | SimEvent::Slain { pos, .. }\n        | SimEvent::Slam { pos, .. }\n        | SimEvent::Blast { pos, .. }\n        | SimEvent::Spell { pos, .. }\n        | SimEvent::Coin { pos }\n        | SimEvent::Loot { pos, .. }\n        | SimEvent::Pickup { pos, .. }\n        | SimEvent::Block { pos } => Some(*pos),\n        _ => None,\n    }\n}\n\n/// Plays an event's sounds with distance attenuation and panning.\npub fn play_event(mixer: &mut Mixer, ev: &SimEvent, l: &Listener, sfx: f32) {\n    let (pan, gain) = match event_pos(ev) {\n        Some(p) => {\n            let d = p - l.pos;\n            let dist = d.length();\n            ((d.dot(l.right) / 12.0).clamp(-0.85, 0.85), 1.0 / (1.0 + dist / 14.0))\n        }\n        None => (0.0, 1.0),\n    };\n    for (patch, delay) in sounds_for(ev) {\n        mixer.play(patch, pan, gain * sfx, delay);\n    }\n}\n\n/// Renders timed events offline: (time in seconds, event). Returns interleaved stereo.\npub fn render_events(events: &[(f32, SimEvent)], duration: f32, sample_rate: f32, l: &Listener) -> Vec<f32> {\n    let mut mixer = Mixer::new(sample_rate);\n    let total = (duration * sample_rate) as usize;\n    let mut out = vec![0.0f32; total * 2];\n    let block = 256;\n    let mut i = 0;\n    let mut ev = events.iter().peekable();\n    while i < total {\n        let t = i as f32 / sample_rate;\n        while let Some((et, e)) = ev.peek() {\n            if *et > t {\n                break;\n            }\n            play_event(&mut mixer, e, l, 1.0);\n            ev.next();\n        }\n        let n = block.min(total - i);\n        mixer.render(&mut out[i * 2..(i + n) * 2]);\n        i += n;\n    }\n    out\n}\n\n/// Writes interleaved stereo f32 samples as a 16-bit PCM WAV file.\npub fn write_wav(path: &std::path::Path, samples: &[f32], sample_rate: u32) -> std::io::Result<()> {\n    let data_len = (samples.len() * 2) as u32;\n    let mut b = Vec::with_capacity(44 + data_len as usize);\n    b.extend_from_slice(b\"RIFF\");\n    b.extend_from_slice(&(36 + data_len).to_le_bytes());\n    b.extend_from_slice(b\"WAVEfmt \");\n    b.extend_from_slice(&16u32.to_le_bytes());\n    b.extend_from_slice(&1u16.to_le_bytes()); // PCM\n    b.extend_from_slice(&2u16.to_le_bytes()); // stereo\n    b.extend_from_slice(&sample_rate.to_le_bytes());\n    b.extend_from_slice(&(sample_rate * 4).to_le_bytes());\n    b.extend_from_slice(&4u16.to_le_bytes());\n    b.extend_from_slice(&16u16.to_le_bytes());\n    b.extend_from_slice(b\"data\");\n    b.extend_from_slice(&data_len.to_le_bytes());\n    for s in samples {\n        b.extend_from_slice(&((s.clamp(-1.0, 1.0) * 32767.0) as i16).to_le_bytes());\n    }\n    if let Some(d) = path.parent().filter(|d| !d.as_os_str().is_empty()) {\n        std::fs::create_dir_all(d)?;\n    }\n    std::fs::write(path, b)\n}\n\nenum Cmd {\n    Play(Patch, f32, f32, f32),\n    Master(f32),\n}\n\n/// Live output through the default sound device.\npub struct AudioOut {\n    _stream: cpal::Stream,\n    tx: Sender<Cmd>,\n    pub sample_rate: u32,\n    pub device: String,\n}\n\nimpl AudioOut {\n    pub fn start() -> anyhow::Result<Self> {\n        use cpal::traits::{DeviceTrait, HostTrait, StreamTrait};\n        let host = cpal::default_host();\n        let device = host.default_output_device().ok_or_else(|| anyhow::anyhow!(\"no sound output device\"))?;\n        let name = device.description().map(|d| d.to_string()).unwrap_or_else(|_| \"default\".into());\n        let supported = device.default_output_config()?;\n        let format = supported.sample_format();\n        let config: cpal::StreamConfig = supported.config();\n        let rate = config.sample_rate as u32;\n        let channels = config.channels as usize;\n        let (tx, rx) = channel::<Cmd>();\n        let stream = match format {\n            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels)?,\n            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels)?,\n            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels)?,\n            other => anyhow::bail!(\"unsupported sample format {other:?}\"),\n        };\n        stream.play()?;\n        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name })\n    }\n\n    pub fn play_event(&self, ev: &SimEvent, l: &Listener, sfx: f32) {\n        let (pan, gain) = match event_pos(ev) {\n            Some(p) => {\n                let d = p - l.pos;\n                ((d.dot(l.right) / 12.0).clamp(-0.85, 0.85), 1.0 / (1.0 + d.length() / 14.0))\n            }\n            None => (0.0, 1.0),\n        };\n        for (patch, delay) in sounds_for(ev) {\n            let _ = self.tx.send(Cmd::Play(patch, pan, gain * sfx, delay));\n        }\n    }\n\n    pub fn set_master(&self, v: f32) {\n        let _ = self.tx.send(Cmd::Master(v));\n    }\n\n    /// Starts output again. Browsers keep sound off until the page gets a click or key press,\n    /// so the browser build calls this on the first input.\n    pub fn resume(&self) {\n        use cpal::traits::StreamTrait;\n        let _ = self._stream.play();\n    }\n}\n\nfn build<T>(device: &cpal::Device, config: cpal::StreamConfig, rx: Receiver<Cmd>, channels: usize) -> anyhow::Result<cpal::Stream>\nwhere\n    T: cpal::SizedSample + cpal::FromSample<f32>,\n{\n    use cpal::traits::DeviceTrait;\n    let mut mixer = Mixer::new(config.sample_rate as f32);\n    let mut buf: Vec<f32> = Vec::new();\n    let stream = device.build_output_stream::<T, _, _>(\n        config,\n        move |data: &mut [T], _| {\n            while let Ok(c) = rx.try_recv() {\n                match c {\n                    Cmd::Play(p, pan, gain, delay) => mixer.play(p, pan, gain, delay),\n                    Cmd::Master(v) => mixer.master = v,\n                }\n            }\n            let frames = data.len() / channels.max(1);\n            buf.resize(frames * 2, 0.0);\n            mixer.render(&mut buf);\n            for (i, frame) in data.chunks_mut(channels.max(1)).enumerate() {\n                for (c, s) in frame.iter_mut().enumerate() {\n                    *s = T::from_sample(buf[i * 2 + c.min(1)]);\n                }\n            }\n        },\n        |e| log::warn!(\"audio stream error: {e}\"),\n        None,\n    )?;\n    Ok(stream)\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn explosion_is_loud_then_silent() {\n        let ev = SimEvent::Explosion { pos: Vec3::ZERO, radius: 1.35 };\n        let out = render_events(&[(0.0, ev)], 2.0, 22050.0, &Listener::default());\n        let peak_early = out[..22050].iter().fold(0.0f32, |m, s| m.max(s.abs()));\n        let peak_late = out[out.len() - 2000..].iter().fold(0.0f32, |m, s| m.max(s.abs()));\n        assert!(peak_early > 0.1, \"audible: {peak_early}\");\n        assert!(peak_late < 1e-3, \"decays: {peak_late}\");\n    }\n}\nsed: can't read crates/pav_audio/src/mixer.rs: No such file or directory\n        let panel = &mut self.panel;\n        let master_before = self.audio_settings.master;\n        let view_proj = self.rig.view_proj(w as f32 / h.max(1) as f32);\n        let mut root = Root {\n            sim: &mut self.sim_config,\n            camera: &mut self.rig.params,\n            view: &mut self.view,\n            app: &mut self.app_settings,\n            audio: &mut self.audio_settings,\n        };\n        let show_stats = root.app.show_stats;\n        let feel = &mut self.feel;\n        let physics = &mut self.physics;\n        let latency = &self.latency;\n        let hud_ctx = HudCtx { hud: &curr.hud, tick: curr.tick, dt: curr.dt };\n        let game_frame = curr.game.clone();\n        let game_ui = &mut self.game_ui;\n        let look_ui = &mut self.look_ui;\n        let animation_ui = &mut self.animation_ui;\n        let asset_ui = &mut self.asset_ui;\n        let creature_ui = &mut self.creature_ui;\n        let studio_navigation = self.studio_navigation;\n        let mut creature_commands = Vec::new();\n        let mut animation_commands = Vec::new();\n        let mut asset_commands = Vec::new();\n        let mut studio_target = None;\n        #[cfg(not(target_arch = \"wasm32\"))]\n        let animation_bridge = self.bridge.as_ref().map(|b| b.