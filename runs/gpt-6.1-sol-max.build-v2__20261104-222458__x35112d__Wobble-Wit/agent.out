{"type":"item.completed","item":{"id":"item_123","type":"command_execution","command":"/bin/bash -lc \"sed -n '132,150p' engine/crates/pav_core/src/games/fit/world.rs; sed -n '96,128p' engine/crates/pav_core/src/games/fit/events/mod.rs; sed -n '294,327p' engine/crates/pav_tools/src/session.rs; sed -n '1298,1315p' engine/crates/pav_app/src/app.rs\"","aggregated_output":"pub fn set(sim: &mut Sim, n: usize) {\n    sim.state.world.current_room = Some(n as u16);\n    if let Some(pid) = sim.state.player {\n        sim.set_position(pid, origin(n) + if n == 0 { Vec3::new(0., 0.3, 4.) } else { Vec3::new(0., 0.3, 0.) });\n    }\n    sim.state.courses.sticky_cue = None;\n    sim.state.courses.cue_serial += 1;\n}\npub fn guest_look(sim: &mut Sim, g: &Guest) {\n    if let Some(pid) = sim.state.player {\n        if let Some(ch) = sim.state.entities.get_mut(pid).and_then(|e| e.character.as_mut()) {\n            let mut look = PuppetDef::default();\n            look.skin = SKINS[(g.skin as usize).min(5)].into();\n            look.shirt = OUTFITS[(g.outfit as usize).min(7)].1.into();\n            look.pants = \"#f6eee0\".into();\n            look.shoes = if g.flipflops.len() == 5 || g.gear == 7 { \"#ffd166\" } else { \"#d0aa87\" }.into();\n            look.eyes = \"#263e54\".into();\n            look.scale = 1.05;\n            look.gear.helm = match g.gear {\n        }\n    }\n    pub fn set(self) -> usize {\n        match self {\n            Self::Breath | Self::Pose | Self::Check => 1,\n            Self::Squat | Self::Plank => 2,\n            Self::Step | Self::Spin | Self::Lap => 3,\n            Self::Tide => 4,\n            Self::Paddle => 5,\n            Self::Tray => 6,\n            Self::Dive => 7,\n            Self::Finale => 8,\n        }\n    }\n    pub fn coach(self) -> &'static str {\n        match self {\n            Self::Breath | Self::Pose => \"POSEY\",\n            Self::Squat | Self::Plank => \"BIG KETTLE\",\n            Self::Step | Self::Spin | Self::Lap => \"BOUNCE\",\n            Self::Finale | Self::Check => \"PIP\",\n            _ => \"COMMODORE GULL\",\n        }\n    }\n    pub fn duration(self) -> f32 {\n        [45., 60., 50., 60., 64., 50., 120., 60., 75., 50., 40., 142., 65.][self as usize]\n    }\n    pub fn from_key(key: &str) -> Option<Self> {\n        ROSTER.into_iter().chain([Self::Finale, Self::Check]).find(|k| k.key() == key)\n    }\n    pub fn song(self) -> u8 {\n        match self.set() {\n            1 => 2,\n            2 => 3,\n        let serial = self.sim.state.courses.view_serial;\n        if now == self.view_room && serial == self.view_serial {\n            return;\n        }\n        if let Some(base) = self.view_base.take() {\n            self.view = base;\n        }\n        self.view_room = now;\n        self.view_serial = serial;\n        let q = now.and_then(|i| w.rooms.get(i as usize)).map(|r| r.place.quarters).unwrap_or(0);\n        let room =\n            now.and_then(|i| w.rooms.get(i as usize)).map(|r| pav_view::build::room_view_map(&r.def.view, q)).unwrap_or_default();\n        let pads = pav_view::build::room_view_map(&self.sim.state.courses.view, q);\n        if room.is_empty() && pads.is_empty() {\n            return;\n        }\n        self.view_base = Some(self.view.clone());\n        self.view.apply(&room);\n        self.view.apply(&pads);\n    }\n\n    /// The view settings captures use: the session's, the game place's look, then the look\n    /// layer.\n    pub fn view_for(&self, frame: &pav_core::RenderFrame) -> ViewSettings {\n        let mut view = self.view.clone();\n        if let Some(g) = &frame.game {\n            pav_view::arpg::place_look(g, &mut view);\n        }\n        self.look.apply(&mut view);\n        view\n    }\n\n    /// Renders the current state to RGBA8 pixels.\n    pub fn render(&mut self, width: u32, height: u32) -> Result<Vec<u8>> {\n                    host.shared.input_stamp.lock().unwrap().get_or_insert(t);\n                }\n            } else {\n                *i = InputFrame::default();\n            }\n        }\n\n        if curr.hud.fit.as_ref().is_some_and(|f| f.free_camera || f.screen == \"Hub\") {\n            let r = (self.input.pad.right + crate::weblink::camera_axis()).clamp_length_max(1.);\n            self.rig.params.yaw += r.x * 90. * dt;\n            self.rig.params.tilt = (self.rig.params.tilt - r.y * 60. * dt).clamp(0., 85.);\n        }\n        self.rig.update(focus, dt);\n        self.builder.now = self.started.elapsed().as_secs_f64();\n        let events: Vec<_> = std::mem::take(&mut *host.shared.events.lock().unwrap());\n        let events = if studio_active { Vec::new() } else { events };\n        self.builder.add_events(&events);\n        // Save the hero on every arrival somewhere, and once a minute while playing.\n","exit_code":0,"status":"completed"}}
