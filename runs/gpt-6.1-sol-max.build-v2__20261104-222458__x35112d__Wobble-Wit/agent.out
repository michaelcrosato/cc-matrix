{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"mkdir -p engine/crates/pav_core/src/games/fit/events engine/crates/pav_core/src/games/fit/sets\ncat > engine/crates/pav_core/src/games/fit/core.rs <<'EOF'\n//\"'! The one balance spring shared by all activities. Coordinates are screen-space.\nuse glam::Vec2;\nuse serde::{Deserialize,Serialize};\nuse super::Rules;\n#[derive(Clone,Debug,Default,Serialize,Deserialize)]\npub struct BalanceCore { pub cob:Vec2, pub vel:Vec2, pub outside:f32, pub tips:u32, pub phase:[f32;4], pub kick_at:f32, pub kick:Vec2 }\nimpl BalanceCore {\n    pub fn new(phases:[f32;4])->Self {Self{phase:phases,kick_at:1.5,..Default::default()}}\n    pub fn wobble(&self,t:f32,amp:f32)->Vec2 {\n        let f=|a:f32,b:f32| amp*(0.7*(std::f32::consts::TAU*1.3*t+a).sin()+0.3*(std::f32::consts::TAU*2.9*t+b).sin());\n        Vec2::new(f(self.phase[0],self.phase[1]),f(self.phase[2],self.phase[3]))\n    }\n    pub fn step(&mut self,lean:Vec2,t:f32,dt:f32,amp:f32,gust:Vec2,r:&Rules)->bool {\n        let target=lean.clamp_length_max(1.)*r.reach+self.wobble(t,amp*r.wobble);\n        self.vel+=((target-self.cob)*r.stiffness-self.vel*r.damping+gust)*dt;\n        self.cob+=self.vel*dt;\n        if self.cob.length()>1. {self.outside+=dt;} else {self.outside=0.;}\n        if self.outside>=r.tip_time {self.tips+=1;self.cob*=0.35;self.vel*=0.1;self.outside=0.;true} else {false}\n    }\n    pub fn steer(&self,target:Vec2,t:f32,amp:f32,r:&Rules)->Vec2 {\n        ((target-self.wobble(t,amp*r.wobble)+self.vel*0.12)/r.reach).clamp_length_max(1.)\n    }\n}\npub fn stick(v:Vec2,curve:f32)->Vec2 {let n=v.length();if n<=0.12 {Vec2::ZERO}else{v/n*((n-0.12)/0.88).clamp(0.,1.).powf(curve)}}\npub fn keys(current:Vec2,axis:Vec2,dt:f32,fine:bool,rate:f32,back:f32)->Vec2 {\n    if axis.length()>0. { (current+axis.normalize()*dt*rate*if fine{0.5}else{1.}).clamp_length_max(1.) }\n    else {current.normalize_or_zero()*(current.length()-back*dt).max(0.)}\n}\nEOF\ncat > engine/crates/pav_core/src/games/fit/rules.toml <<'\"'EOF'\nstiffness = 40.0\ndamping = 8.5\nreach = 0.92\nwobble = 0.12\ntip_time = 0.35\nstick_curve = 1.5\nkey_rate = 1.6\nkey_return = 1.2\npose_radius = 0.30\nbreath_tolerance = 0.35\nsquat_band = 0.25\nplank_radius = 0.40\nrhythm_perfect = 0.055\nrhythm_good = 0.120\nspin_band_scale = 1.3\nlap_zone = 0.4\nshell_friction = 2.6\ngust_strength = 1.0\ntray_friction = 4.0\nbounce_gain = 1.0\nfinale_gusts = 1.5\nEOF\ncat > engine/crates/pav_core/src/games/fit/events/mod.rs <<'EOF'\nuse glam::{Vec2,Vec3};\nuse serde::{Serialize,Deserialize};\nuse crate::input::{InputFrame,buttons as b};\nuse crate::frame::SimEvent;\nuse super::{Rules,core::BalanceCore};\nuse std::f32::consts::TAU;\n#[derive(Clone,Copy,Debug,PartialEq,Eq,Serialize,Deserialize)]\n#[repr(u8)]\npub enum Kind {Breath,Pose,Squat,Plank,Step,Spin,Lap,Tide,Paddle,Tray,Dive,Finale,Check}\npub const ROSTER:[Kind;11]=[Kind::Breath,Kind::Pose,Kind::Squat,Kind::Plank,Kind::Step,Kind::Spin,Kind::Lap,Kind::Tide,Kind::Paddle,Kind::Tray,Kind::Dive];\nimpl Kind {\n    pub fn key(self)->&'static str { [\\\"breath-bloom\\\",\\\"pose-parade\\\",\\\"tempo-squats\\\",\\\"plank-standoff\\\",\\\"step-party\\\",\\\"floatie-spin\\\",\\\"morning-lap\\\",\\\"tide-table\\\",\\\"paddle-slalom\\\",\\\"tray-trek\\\",\\\"cannonball-cup\\\",\\\"big-stand\\\",\\\"wobble-check\\\"][self as usize] }\n    pub fn name(self)->&'static str {[\\\"Breath Bloom\\\",\\\"Pose Parade\\\",\\\"Tempo Squats\\\",\\\"Plank Standoff\\\",\\\"Step Party\\\",\\\"Floatie Spin\\\",\\\"Morning Lap\\\",\\\"Tide Table\\\",\\\"Paddle Slalom\\\",\\\"Tray Trek\\\",\\\"Cannonball Cup\\\",\\\"The Big Stand\\\",\\\"Morning Wobble Check\\\"][self as usize]}\n    pub fn goal(self)->&'static str {[\n        \\\"Follow the breath. Keep your balance dot in the green ring.\\\",\n        \\\"Lean gently to hold the moving ring. Accept the bird.\\\",\n        \\\"Hold to squat. Release to rise. Follow the tempo.\\\",\n        \\\"Hold both step buttons. Keep the dot in the shrinking ring.\\\",\n        \\\"Step left and right as the notes reach the footprints.\\\",\n        \\\"Circle your lean. Catch rings with the matching step.\\\",\n        \\\"Alternate steps. Lean to collect ribbons and dodge crabs.\\\",\n        \\\"Tilt the raft. Roll slow shells into the tide pools.\\\",\n        \\\"Lean through the buoy gates. Forward speeds up; back brakes.\\\",\n        \\\"Keep the tray level. Deliver five extremely optimistic smoothies.\\\",\n        \\\"Press at the bottom of each bounce. Tuck in the air. Make a splash.\\\",\n        \\\"A little of everything. Then thirty seconds of absolutely nothing.\\\",\n        \\\"Four small tests. One unnecessarily large number.\\\"\n    ][self as usize]}\n    pub fn day(self)->u8 {match self {Self::Breath|Self::Pose|Self::Check=>1,Self::Squat|Self::Plank=>2,Self::Step|Self::Spin|Self::Lap=>3,Self::Finale=>5,_=>4}}\n    pub fn set(self)->usize {match self {Self::Breath|Self::Pose|Self::Check=>1,Self::Squat|Self::Plank=>2,Self::Step|Self::Spin|Self::Lap=>3,Self::Tide=>4,Self::Paddle=>5,Self::Tray=>6,Self::Dive=>7,Self::Finale=>8}}\n    pub fn coach(self)->&'static str {match self {Self::Breath|Self::Pose=>\\\"POSEY\\\",Self::Squat|Self::Plank=>\\\"BIG KETTLE\\\",Self::Step|Self::Spin|Self::Lap=>\\\"BOUNCE\\\",Self::Finale|Self::Check=>\\\"PIP\\\",_=>\\\"COMMODORE GULL\\\"}}\n    pub fn duration(self)->f32 {[45.,60.,50.,60.,64.,50.,90.,60.,45.,50.,40.,142.,65.][self as usize]}\n    pub fn from_key(key:&str)->Option<Self> {ROSTER.into_iter().chain([Self::Finale,Self::Check]).find(|k|k.key()==key)}\n    pub fn song(self)->u8 {match self.set(){1=>2,2=>3,3=>4,8=>6,_=>5}}\n}\n#[derive(Clone,Debug,Serialize,Deserialize)]\npub struct Note {pub t:f32,pub lane:u8,pub judged:bool,pub quality:f32}\n#[derive(Clone,Debug,Serialize,Deserialize)]\npub struct Shell {pub p:Vec2,pub v:Vec2,pub potted:bool}\n#[derive(Clone,Debug,Serialize,Deserialize)]\npub struct GhostPoint {pub t:f32,pub pos:Vec3,pub lean:Vec2,pub facing:f32,pub clip:u32,pub clip_t:f32,pub score:u32}\n#[derive(Clone,Debug,Serialize,Deserialize)]\npub struct Event {\n    pub kind:Kind,pub time:f32,pub duration:f32,pub core:BalanceCore,pub target:Vec2,pub radius:f32,\n    pub tally:f32,pub possible:f32,pub score:u32,pub metrics:[f32;4],pub weights:[f32;4],\n    pub lungs:f32,pub guide:f32,pub streak:f32,pub hits:u32,pub misses:u32,pub last_step:i8,pub last_step_t:f32,\n    pub pace:f32,pub progress:f32,pub side:f32,pub rings:u8,pub spin:f32,pub angle:f32,pub next_catch:f32,\n    pub shells:Vec<Shell>,pub pools:Vec<Vec2>,pub glasses:Vec<(Vec2,Vec2)>,pub notes:Vec<Note>,\n    pub phase:u8,pub sub_phase:u8,pub penalty:f32,pub collapsed:bool,pub peace:bool,pub finished:bool,\n    pub label:String,pub ghost:Vec<GhostPoint>,pub best_ghost:Vec<GhostPoint>,pub record_at:f32,\n    pub dive_power:f32,pub dive_y:f32,pub dive_v:f32,pub dive_rotate:f32,pub dive_tuck:f32,pub dive_presses:u8,pub dives:u8,\n    pub last_signal:i32,pub ready_target:bool,pub phase_start:f32,pub last_input:Vec2,\n}\nimpl Event {\n    pub fn new(kind:Kind,phases:[f32;4])->Self {\n        let mut s=Self{kind,time:0.,duration:kind.duration(),core:BalanceCore::new(phases),target:Vec2::ZERO,radius:0.35,tally:0.,possible:0.,score:0,metrics:[0.;4],weights:[0.;4],lungs:0.,guide:0.,streak:0.,hits:0,misses:0,last_step:-1,last_step_t:-1.,pace:0.,progress:0.,side:0.,rings:1,spin:0.,angle:0.,next_catch:5.,shells:vec\"'![],pools:vec![],glasses:(0..5).map(|i|(Vec2::new((i as f32-2.)*0.12,0.),Vec2::ZERO)).collect(),notes:vec![],phase:0,sub_phase:0,penalty:0.,collapsed:false,peace:true,finished:false,label:String::new(),ghost:vec![],best_ghost:vec![],record_at:0.,dive_power:0.,dive_y:0.,dive_v:0.,dive_rotate:0.,dive_tuck:0.,dive_presses:0,dives:0,last_signal:-1,ready_target:false,phase_start:0.,last_input:Vec2::ZERO};\n        s.notes=super::charts::notes();s.setup_board();s\n    }\n    pub fn setup_board(&mut self) {\n        let n=3+self.phase as usize*2;\n        self.shells=(0..n).map(|i|{let a=i as f32*TAU/n as f32;Shell{p:Vec2::new(a.cos(),a.sin())*1.4,v:Vec2::ZERO,potted:false}}).collect();\n        self.pools=vec![Vec2::new(-1.9,-1.65),Vec2::new(1.9,1.65),Vec2::new(-1.8,1.7)];\n    }\n    pub fn effective(&self)->(Kind,f32) {\n        if self.kind!=Kind::Finale{return(self.kind,self.time);}\n        if self.time<32.{(Kind::Breath,self.time)}else if self.time<52.{(Kind::Pose,self.time-32.)}else if self.time<92.{(Kind::Step,self.time-52.)}else if self.time<112.{(Kind::Plank,self.time-92.)}else{(Kind::Finale,self.time-112.)}\n    }\n    pub fn target_at(&self,t:f32)->Vec2 { Vec2::new((TAU*0.12*t).sin()*0.35,(TAU*0.075*t+0.6).sin()*0.26) }\n    pub fn gust(&self,t:f32,r:&Rules)->Vec2 {Vec2::new((t*0.7).sin()*1.4+(t*1.9).sin()*0.6,(t*0.5).cos()*0.6)*r.gust_strength}\n    pub fn step(&mut self,i:&InputFrame,dt:f32,r:&Rules,events:&mut Vec<SimEvent>,origin:Vec3) {\n        if self.finished{return;} let before=self.time; self.time+=dt;\n        let(kind,t)=self.effective();let action=i.down(b::CONFIRM); let brace=i.down(b::STEP_L)&&i.down(b::STEP_R);\n        self.target=Vec2::ZERO;self.radius=0.35;\n        let amp=match kind{Kind::Pose=>if (32.0..37.0).contains(&t){1.6}else{1.},Kind::Squat=>1.+(t/5.).floor()*0.08,Kind::Plank=>1.+t/45.,Kind::Finale=>0.2,_=>1.};\n        let gust=match kind {Kind::Paddle|Kind::Tray=>self.gust(t,r),Kind::Plank if self.kind==Kind::Finale=>self.gust(t,r)*r.finale_gusts,_=>Vec2::ZERO};\n        let tip=self.core.step(i.lean,t,dt,amp,gust,r);\n        if tip {self.penalty+=35.;self.streak=0.;events.push(SimEvent::Sfx{id:10,gain:0.7,pitch:1.});if matches!(kind,Kind::Paddle|Kind::Tide|Kind::Finale){events.push(SimEvent::Splash{pos:origin});}}\n        let cob=self.core.cob;let dist=cob.length();\n        self.label.clear();\n        match kind {\n            Kind::Breath=>{\n                self.guide=0.5-0.5*(TAU*t/8.).cos(); self.lungs=(self.lungs+dt*if action{0.25}else{-0.25}).clamp(0.,1.);\n                let good=(1.-(self.lungs-self.guide).abs()/r.breath_tolerance).clamp(0.,1.);\n                self.add((0.7*good+0.3*(dist<0.35) as u8 as f32)*if action||self.lungs>0.02{1.}else{0.15},dt);\n                self.label=if (t%8.)<4.{\"Breathe in\"}else{\"Breathe out\"}.into();\n                let cycle=(t/8.)as i32;if cycle!=self.last_signal {self.last_signal=cycle;events.push(SimEvent::Sfx{id:20,gain:0.45,pitch:1.+cycle as f32*0.12});}\n            },\n            Kind::Pose=>{\n                self.target=self.target_at(t);self.radius=(r.pose_radius-t%20.*0.006).max(0.18);\n                let in_ring=cob.distance(self.target)<self.radius;\n                self.streak=if in_ring{self.streak+dt}else{0.};let mult=1.+(self.streak/2.).floor().min(3.);\n                self.add(if in_ring{(0.65+mult*0.0875).min(1.)}else{0.},dt);\n                self.label=if (32.0..37.0).contains(&t){\"There is a bird on you. Accept the bird.\"}else{[\"The Patient Heron\",\"The Apologetic Lunge\",\"The Tired Lighthouse\"][(t/20.)as usize%3]}.into();\n            },\n            Kind::Squat=>{\n                let cycle=t%5.;self.guide=if cycle<2.{cycle/2.}else if cycle<3.{3.-cycle}else{0.};\n                self.lungs=(self.lungs+dt*if action{0.5}else{-1.}).clamp(0.,1.);\n                let timing=(1.-(self.lungs-self.guide).abs()/0.4).clamp(0.,1.);\n                self.add((0.7*timing+0.3*(cob.x.abs()<r.squat_band)as u8 as f32)*if action||cycle>=2.{1.}else{0.},dt);\n                let rep=(t/5.)as i32;if rep!=self.last_signal {self.last_signal=rep;events.push(SimEvent::Sfx{id:16,gain:0.6,pitch:0.8});}\n                self.label=if cycle<2.{\"Hold · lower slowly\"}else if cycle<3.{\"Release · rise\"}else{\"Rest. An official exercise.\"}.into();\n            },\n            Kind::Plank=>{\n                self.radius=(r.plank_radius-t/300.).max(0.2);\n                if !brace||dist>self.radius {self.penalty+=dt;}else{self.penalty=(self.penalty-dt*0.5).max(0.);}\n                if brace&&dist<self.radius {self.add(1.,dt);}else{self.add(0.,dt);}\n                if self.penalty>1.&&!self.collapsed {self.collapsed=true;self.label=\"A very horizontal decision.\".into();}\n                if self.collapsed&&self.kind==Kind::Plank {self.finished=true;self.score=(t/60.*1000.).min(1000.)as u32;}\n                else {self.label=if t>45.{\"Kettle is laughing. Brace for the joke.\"}else if t>30.{\"A small tremble. Very professional.\"}else{\"Hold both. Be a dignified plank.\"}.into();}\n            },\n            Kind::Step=>{\n                let rhythm_t=if self.kind==Kind::Finale{t}else{i.song_pos.unwrap_or(t)};\n                for lane in 0..2u8 {let bit=if lane==0{b::STEP_L}else{b::STEP_R};if i.just(bit){\n                    let nearest=self.notes.iter().enumerate().filter(|(_,n)|!n.judged&&n.lane==lane).min_by(|(_,a),(_,b)|(a.t-rhythm_t).abs().total_cmp(&(b.t-rhythm_t).abs()));\n                    if let Some((idx,n))=nearest {let diff=(n.t-rhythm_t).abs();if diff<=r.rhythm_good {let q=if diff<=r.rhythm_perfect{1.}else{0.7};self.notes[idx].judged=true;self.notes[idx].quality=q;self.tally+=q;self.hits+=1;self.streak+=1.;self.label=if q>0.9{\"Perfect\"}else{\"Good\"}.into();events.push(SimEvent::Sfx{id:6,gain:0.7,pitch:1.+lane as f32*0.2});}else{self.streak=0.;}}\n                }}\n                for n in &mut self.notes {if !n.judged&&n.t<rhythm_t-r.rhythm_good{n.judged=true;self.misses+=1;self.streak=0.;}}\n                self.possible=self.notes.iter().filter(|n|n.t<if self.kind==Kind::Finale{40.}else{64.}).count()as f32;\n                if self.label.is_empty(){self.label=\"Left. Right. Excessively cheerful.\".into();}\n            },\n            Kind::Spin=>{\n                let a=i.lean.y.atan2(i.lean.x);let d=(a-self.angle+std::f32::consts::PI).rem_euclid(TAU)-std::f32::consts::PI;self.angle=a;\n                self.spin+=(d/dt-self.spin)*0.15;let dir=if (t/15.)as u32%2==0{1.}else{-1.};\n                let band=if i.device==0{r.spin_band_scale}else{1.};let good=i.lean.length()>0.4&&self.spin*dir>6./band&&self.spin*dir<9.*band;\n                self.add(if good{0.6+0.4*self.rings as f32/7.}else{0.},dt);\n                if t>=self.next_catch-0.25&&t<=self.next_catch+0.25 {let side=if (self.next_catch/5.)as u32%2==0{b::STEP_R}else{b::STEP_L};self.label=if side==b::STEP_R{\"Catch right!\"}else{\"Catch left!\"}.into();if i.just(side){self.rings=(self.rings+1).min(7);self.next_catch+=5.;events.push(SimEvent::Sfx{id:17,gain:0.7,pitch:1.});}}\n                else if t>self.next_catch+0.25{self.next_catch+=5.;}\n                if !good {self.penalty+=dt;}else{self.penalty=0.;}if self.penalty>3.{self.rings=self.rings.saturating_sub(1).max(1);self.penalty=0.;}\n                if self.label.is_empty(){self.label=if dir>0.{\"Circle anticlockwise\"}else{\"Switch! Circle clockwise\"}.into();}\n            },\n            Kind::Lap=>{\n                self.steps(i,t,events);\n                let gap=t-self.last_step_t;let in_zone=self.pace>=1.6&&self.pace<=2.4&&gap<0.9;\n                self.side=cob.x*1.2;let ribbon=(t*0.38).sin()*0.85;\n                self.progress=(t/90.).min(1.);self.target.x=ribbon/1.2;self.radius=0.22;\n                self.add(if in_zone {0.72+0.28*(self.side-ribbon).abs().lt(&0.35)as u8 as f32}else{0.},dt);\n                if self.pace>2.8 {self.penalty+=dt*3.;}self.label=if self.pace>2.8{\"A stitch. Your enthusiasm has been noted.\"}else if in_zone{\"Lovely pace. Mind the crab.\"}else{\"Alternate left and right · find your pace\"}.into();\n            },\n            Kind::Tide=>{\n                let board=(t/20.).min(2.)as u8;if board!=self.phase{self.phase=board;self.setup_board();}\n                if self.phase>0 {self.pools[1]=Vec2::new(1.65,(t*0.6).sin()*1.5);}\n                for sh in &mut self.shells {if sh.potted{continue;}sh.v+=(Vec2::new(cob.x,-cob.y)*5.-sh.v*r.shell_friction)*dt;sh.p+=sh.v*dt;\n                    for axis in 0..2{if sh.p[axis].abs()>2.65{sh.p[axis]=sh.p[axis].clamp(-2.65,2.65);sh.v[axis]*=-0.5;}}\n                    if self.phase==2&&sh.p.length()<0.45{sh.v+=sh.p.normalize_or_zero()*1.5;}\n                    if self.pools.iter().any(|p|p.distance(sh.p)<0.42)&&sh.v.length()<1.5{sh.potted=true;self.hits+=1;events.push(SimEvent::Sfx{id:19,gain:0.7,pitch:1.+self.hits as f32*0.03});}\n                }\n                self.score=(self.hits as f32/15.*1000.).min(1000.)as u32;self.label=format!(\"Raft {} · slow shells stay in pools\",self.phase+1);\n            },\n            Kind::Paddle=>{\n                self.progress=(t/45.).min(1.);let gate=(self.progress*9.).floor()as i32;let centre=Self::gate(gate);\n                self.target=Vec2::new(centre,0.5);self.radius=0.24;self.side+=(cob.x*4.-self.side)*dt*2.5;\n                let good=(self.side/4.-centre).abs()<0.22;self.add(if good&&cob.y>0.1{1.}else{0.},dt);\n                if gate!=self.last_signal {if self.last_signal>=0 {if good{self.hits+=1;events.push(SimEvent::Sfx{id:20,gain:0.5,pitch:1.2});}else{self.misses+=1;}}self.last_signal=gate;}\n                self.label=\"Lean toward the next gate · forward for speed\".into();\n                if (t*8.)as i32!=(before*8.)as i32 {events.push(SimEvent::Wake{pos:origin+Vec3::new(self.side,0.,-self.progress*72.)});}\n            },\n            Kind::Tray=>{\n                self.target=-self.gust(t,r)/r.stiffness;self.radius=0.2;\n                let tray=cob+Vec2::new((t*0.9).sin()*0.04,(t*1.3).cos()*0.04);\n                for (p,v) in &mut self.glasses {if p.length()>3.{continue;}*v+=(tray*2.2-*v*r.tray_friction)*dt;*p+=*v*dt;if p.length()>0.65{*p=Vec2::splat(10.);self.misses+=1;events.push(SimEvent::Sfx{id:21,gain:0.7,pitch:1.});}}\n                self.progress=t/50.;self.score=(self.glasses.iter().filter(|(p,_)|p.length()<1.).count()*200)as u32;\n                self.add((1.-tray.length()/0.18).clamp(0.,1.),dt);self.label=\"Counter the waves. The glasses are trusting you.\".into();\n            },\n            Kind::Dive=>{\n                let local=t-self.phase_start;let cycle=local%1.2;self.guide=0.5-0.5*(TAU*cycle/1.2).cos();\n                if self.dive_presses<4 {self.dive_y=0.15*(TAU*cycle/1.2).sin();self.label=format!(\"Bounce {} of 4 · press at the lowest point\",self.dive_presses+1);\n                    if i.just(b::CONFIRM){let q=(1.-(cycle-0.9).abs()/0.32).clamp(0.,1.);self.dive_power+=q*r.bounce_gain;self.dive_presses+=1;events.push(SimEvent::Sfx{id:7,gain:0.5,pitch:0.8+q*0.4});if self.dive_presses==4{self.dive_v=5.+self.dive_power*1.5;self.dive_y=2.;}}\n                    if local>7.&&self.dive_presses<4 {self.dive_presses=4;self.dive_v=4.;self.dive_y=2.;}\n                } else if self.sub_phase==0 {\n                    self.dive_v-=7.*dt;self.dive_y+=self.dive_v*dt;self.dive_rotate+=cob.x*dt*3.;self.dive_tuck=if action{(self.dive_tuck+dt*2.).min(1.)}else{(self.dive_tuck-dt*3.).max(0.)};\n                    self.label=\"Hold to tuck! Lean for a little unnecessary rotation.\".into();\n                    if self.dive_y<0.{let quality=(self.dive_power/4.).min(1.)*(0.4+0.6*self.dive_tuck);self.tally+=quality;self.dives+=1;self.sub_phase=1;self.phase_start=t;events.push(SimEvent::BigSplash{pos:origin+Vec3::new(2.,0.,0.),size:3.+quality*7.});self.label=\"6.5       7       See me\".into();}\n                } else {self.label=\"6.5       7       See me\".into();if local>1.8{if self.dives>=3{self.finished=true;}else{self.dive_presses=0;self.dive_power=0.;self.sub_phase=0;self.phase_start=t;}}}\n                self.score=(self.tally/3.*1000.)as u32;\n            },\n            Kind::Finale=>{\n                self.radius=0.35;self.label=if t>15.{\"Press to skip\"}else{\"The Long Stillness\"}.into();\n                if i.any||i.held!=0||i.lean.length()>0.1 {self.peace=false;}\n                self.add(if self.peace{1.}else{0.},dt);\n            },\n            Kind::Check=>{\n                let stage=if t<12.{0}else if t<33.{1}else if t<43.{2}else{3};self.phase=stage;\n                let good=match stage {\n                    0=>{self.label=\"Stand still. This is the whole test.\".into();if t>5.&&before<=5.{self.core.vel.x+=0.4;}(1.-dist/0.4).clamp(0.,1.)},\n                    1=>{let n=((t-12.)/7.)as usize;self.target=Vec2::new([-0.7,0.55,-0.35][n.min(2)],0.);self.radius=0.1;self.label=format!(\"Lean to {}% {}\",(self.target.x.abs()*100.)as u32,if self.target.x<0.{\"left\"}else{\"right\"});(1.-cob.distance(self.target)/0.3).clamp(0.,1.)},\n                    2=>{self.label=\"Eyes closed. Listen to the tone. Trust less.\".into();if (t*8.)as u32!=(before*8.)as u32{events.push(SimEvent::Sfx{id:29,gain:0.2,pitch:0.5+dist*3.});}(1.-dist/0.35).clamp(0.,1.)},\n                    _=>{self.label=\"Eight alternating steps · follow the bell\".into();let beat=((t-43.)/0.6)as i32;if beat!=self.last_signal&&beat<8{self.last_signal=beat;events.push(SimEvent::Sfx{id:16,gain:0.6,pitch:1.});}let prev=self.hits;self.steps(i,t,events);if self.hits>prev{let error=((t-43.)/0.6).fract().min(1.-((t-43.)/0.6).fract())*0.6;self.metrics[3]+=(1.-error/0.25).clamp(0.,1.);self.weights[3]+=1.;}0.}\n                };\n                if stage<3 {self.metrics[stage as usize]+=good*dt;self.weights[stage as usize]+=dt;}\n            }\n        }\n        self.last_input=i.lean;\n        if !matches!(self.kind,Kind::Tide|Kind::Tray|Kind::Dive|Kind::Check)&&!self.collapsed {self.score=((self.tally/self.possible.max(0.001)*1000.-self.core.tips as f32*25.).clamp(0.,1000.))as u32;}\n        if self.kind==Kind::Finale {self.phase=if self.time<32.{0}else if self.time<52.{1}else if self.time<92.{2}else if self.time<112.{3}else{4};}\n        if self.time>=self.duration {self.finished=true;}\n    }\n    fn add(&mut self,q:f32,dt:f32){self.tally+=q*dt;self.possible+=dt;}\n    fn steps(&mut self,i:&InputFrame,t:f32,events:&mut Vec<SimEvent>){\n        for lane in 0..2 {let bit=if lane==0{b::STEP_L}else{b::STEP_R};if i.just(bit){if self.last_step!=lane {if self.last_step_t>=0.{let gap=t-self.last_step_t;self.pace=1./gap.max(0.1);}self.last_step=lane;self.last_step_t=t;self.hits+=1;events.push(SimEvent::Sfx{id:6,gain:0.55,pitch:1.});}else{self.misses+=1;}}}\n    }\n    pub fn gate(n:i32)->f32 {(n as f32*1.7).sin()*0.6}\n    pub fn skill(&self)->[f32;4] {let mut out=[0.;4];for(n,v)in out.iter_mut().enumerate(){*v=(self.metrics[n]/self.weights[n].max(if n==3{8.}else{0.001})).clamp(0.,1.);}out}\n    pub fn bot(&self,r:&Rules,dt:f32)->InputFrame {\n        let mut i=InputFrame::default();let(k,t)=self.effective();let mut target=Vec2::ZERO;\n        match k {\n            Kind::Breath=>{if t%8.<4.{i.held|=b::CONFIRM;}},\n            Kind::Pose=>target=self.target_at(t+0.17),\n            Kind::Squat=>{if t%5.<2.{i.held|=b::CONFIRM;}},\n            Kind::Plank=>i.held=b::STEP_L|b::STEP_R,\n            Kind::Step=>{for n in &self.notes{if !n.judged&&n.t>=t-dt*0.5&&n.t<t+dt*0.6{i.pressed|=if n.lane==0{b::STEP_L}else{b::STEP_R};i.held=i.pressed;}}},\n            Kind::Spin=>{let dir=if(t/15.)as u32%2==0{1.}else{-1.};let a=if dir>0.{t*7.5}else{-(t-15.)*7.5+112.5};i.lean=Vec2::new(a.cos(),a.sin())*0.7;let bit=if(self.next_catch/5.)as u32%2==0{b::STEP_R}else{b::STEP_L};if(self.next_catch-t).abs()<dt{i.pressed|=bit;i.held=i.pressed;}return i;},\n            Kind::Lap=>{target.x=(t*0.38).sin()*0.85/1.2;let n=(t/0.5).floor()as i32;let prev=((t-dt).max(0.)/0.5).floor()as i32;if n!=prev||t<dt{let bit=if n%2==0{b::STEP_L}else{b::STEP_R};i.pressed|=bit;i.held=i.pressed;}},\n            Kind::Paddle=>{target=Vec2::new(Self::gate(((t/45.)*9.).floor()as i32),0.5);},\n            Kind::Tide=>{\n                if let Some(sh)=self.shells.iter().filter(|s|!s.potted).next(){let pool=self.pools.iter().min_by(|a,b|a.distance_squared(sh.p).total_cmp(&b.distance_squared(sh.p))).unwrap();let desired=(*pool-sh.p)*2.-sh.v*1.5;target=Vec2::new(desired.x,-desired.y).clamp_length_max(0.85);}\n            },\n            Kind::Tray=>target=-self.gust(t,r)/r.stiffness-Vec2::new((t*0.9).sin()*0.04,(t*1.3).cos()*0.04),\n            Kind::Dive=>{let cycle=(t-self.phase_start)%1.2;if self.dive_presses<4&&(cycle-0.9).abs()<dt*0.6{i.pressed=b::CONFIRM;i.held=b::CONFIRM;}if self.dive_presses>=4{i.held=b::CONFIRM;target.x=0.18;}},\n            Kind::Finale=>return i,\n            Kind::Check=>{if(12.0..33.0).contains(&t){target.x=[-0.7,0.55,-0.35][(((t-12.)/7.)as usize).min(2)];}if(43.0..47.8).contains(&t){let n=((t-43.)/0.6).round()as i32;if(t-43.-n as f32*0.6).abs()<dt*0.6 {let bit=if n%2==0{b::STEP_L}else{b::STEP_R};i.held=bit;i.pressed=bit;}}}\n        }\n        i.lean=self.core.steer(target,t,1.,r);i\n    }\n}\nEOF\ncat > engine/crates/pav_core/src/games/fit/charts.rs <<'\"'EOF'\nuse super::events::Note;\n#[derive(serde::Deserialize)]struct Chart{note:Vec<Entry>}\n#[derive(serde::Deserialize)]struct Entry{t:f32,lane:u8}\npub fn notes()->Vec<Note>{let data=super::super::level_text(\\\"fit/charts\\\",include_str\"'!(\"charts.toml\"));let chart:Chart=toml::from_str(&data).expect(\"authored step chart\");chart.note.into_iter().map(|n|Note{t:n.t,lane:n.lane,judged:false,quality:0.}).collect()}\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('engine/crates/pav_core/src/games/fit/charts.toml');s='# 96 BPM, 64 seconds. Hand-authored quarter, eighth and double progression.\\\\n'\nfor beat in range(4,100):\n t=beat*0.625\n for lane in ([0,1] if beat%12==0 else [beat%2]):s+=f'[[note]]\\\\nt = {t:.4f}\\\\nlane = {lane}\\\\n'\n if beat>60 and beat%3==0:s+=f'[[note]]\\\\nt = {t+0.3125:.4f}\\\\nlane = {(beat+1)%2}\\\\n'\np.write_text(s)\np=Path('engine/crates/pav_core/src/puppet.rs');s=p.read_text().replace('    pub lean_side: f32,','    pub lean_side: f32,\\\\n    #[serde(default)]\\\\n    pub tilt_side: f32,\\\\n    #[serde(default)]\\\\n    pub tilt_fwd: f32,',1).replace('            lean_side: l(self.lean_side, o.lean_side),','            lean_side: l(self.lean_side, o.lean_side),\\\\n            tilt_side: l(self.tilt_side, o.tilt_side),\\\\n            tilt_fwd: l(self.tilt_fwd, o.tilt_fwd),');s=s.replace('(topple.unwrap_or(Quat::IDENTITY) * spin.unwrap_or(Quat::IDENTITY), shift + sink)','(Quat::from_rotation_z(-st.tilt_side) * Quat::from_rotation_x(st.tilt_fwd) * topple.unwrap_or(Quat::IDENTITY) * spin.unwrap_or(Quat::IDENTITY), shift + sink)');p.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"mkdir -p engine/crates/pav_core/src/games/fit/events engine/crates/pav_core/src/games/fit/sets\ncat > engine/crates/pav_core/src/games/fit/core.rs <<'EOF'\n//\"'! The one balance spring shared by all activities. Coordinates are screen-space.\nuse glam::Vec2;\nuse serde::{Deserialize,Serialize};\nuse super::Rules;\n#[derive(Clone,Debug,Default,Serialize,Deserialize)]\npub struct BalanceCore { pub cob:Vec2, pub vel:Vec2, pub outside:f32, pub tips:u32, pub phase:[f32;4], pub kick_at:f32, pub kick:Vec2 }\nimpl BalanceCore {\n    pub fn new(phases:[f32;4])->Self {Self{phase:phases,kick_at:1.5,..Default::default()}}\n    pub fn wobble(&self,t:f32,amp:f32)->Vec2 {\n        let f=|a:f32,b:f32| amp*(0.7*(std::f32::consts::TAU*1.3*t+a).sin()+0.3*(std::f32::consts::TAU*2.9*t+b).sin());\n        Vec2::new(f(self.phase[0],self.phase[1]),f(self.phase[2],self.phase[3]))\n    }\n    pub fn step(&mut self,lean:Vec2,t:f32,dt:f32,amp:f32,gust:Vec2,r:&Rules)->bool {\n        let target=lean.clamp_length_max(1.)*r.reach+self.wobble(t,amp*r.wobble);\n        self.vel+=((target-self.cob)*r.stiffness-self.vel*r.damping+gust)*dt;\n        self.cob+=self.vel*dt;\n        if self.cob.length()>1. {self.outside+=dt;} else {self.outside=0.;}\n        if self.outside>=r.tip_time {self.tips+=1;self.cob*=0.35;self.vel*=0.1;self.outside=0.;true} else {false}\n    }\n    pub fn steer(&self,target:Vec2,t:f32,amp:f32,r:&Rules)->Vec2 {\n        ((target-self.wobble(t,amp*r.wobble)+self.vel*0.12)/r.reach).clamp_length_max(1.)\n    }\n}\npub fn stick(v:Vec2,curve:f32)->Vec2 {let n=v.length();if n<=0.12 {Vec2::ZERO}else{v/n*((n-0.12)/0.88).clamp(0.,1.).powf(curve)}}\npub fn keys(current:Vec2,axis:Vec2,dt:f32,fine:bool,rate:f32,back:f32)->Vec2 {\n    if axis.length()>0. { (current+axis.normalize()*dt*rate*if fine{0.5}else{1.}).clamp_length_max(1.) }\n    else {current.normalize_or_zero()*(current.length()-back*dt).max(0.)}\n}\nEOF\ncat > engine/crates/pav_core/src/games/fit/rules.toml <<'\"'EOF'\nstiffness = 40.0\ndamping = 8.5\nreach = 0.92\nwobble = 0.12\ntip_time = 0.35\nstick_curve = 1.5\nkey_rate = 1.6\nkey_return = 1.2\npose_radius = 0.30\nbreath_tolerance = 0.35\nsquat_band = 0.25\nplank_radius = 0.40\nrhythm_perfect = 0.055\nrhythm_good = 0.120\nspin_band_scale = 1.3\nlap_zone = 0.4\nshell_friction = 2.6\ngust_strength = 1.0\ntray_friction = 4.0\nbounce_gain = 1.0\nfinale_gusts = 1.5\nEOF\ncat > engine/crates/pav_core/src/games/fit/events/mod.rs <<'EOF'\nuse glam::{Vec2,Vec3};\nuse serde::{Serialize,Deserialize};\nuse crate::input::{InputFrame,buttons as b};\nuse crate::frame::SimEvent;\nuse super::{Rules,core::BalanceCore};\nuse std::f32::consts::TAU;\n#[derive(Clone,Copy,Debug,PartialEq,Eq,Serialize,Deserialize)]\n#[repr(u8)]\npub enum Kind {Breath,Pose,Squat,Plank,Step,Spin,Lap,Tide,Paddle,Tray,Dive,Finale,Check}\npub const ROSTER:[Kind;11]=[Kind::Breath,Kind::Pose,Kind::Squat,Kind::Plank,Kind::Step,Kind::Spin,Kind::Lap,Kind::Tide,Kind::Paddle,Kind::Tray,Kind::Dive];\nimpl Kind {\n    pub fn key(self)->&'static str { [\\\"breath-bloom\\\",\\\"pose-parade\\\",\\\"tempo-squats\\\",\\\"plank-standoff\\\",\\\"step-party\\\",\\\"floatie-spin\\\",\\\"morning-lap\\\",\\\"tide-table\\\",\\\"paddle-slalom\\\",\\\"tray-trek\\\",\\\"cannonball-cup\\\",\\\"big-stand\\\",\\\"wobble-check\\\"][self as usize] }\n    pub fn name(self)->&'static str {[\\\"Breath Bloom\\\",\\\"Pose Parade\\\",\\\"Tempo Squats\\\",\\\"Plank Standoff\\\",\\\"Step Party\\\",\\\"Floatie Spin\\\",\\\"Morning Lap\\\",\\\"Tide Table\\\",\\\"Paddle Slalom\\\",\\\"Tray Trek\\\",\\\"Cannonball Cup\\\",\\\"The Big Stand\\\",\\\"Morning Wobble Check\\\"][self as usize]}\n    pub fn goal(self)->&'static str {[\n        \\\"Follow the breath. Keep your balance dot in the green ring.\\\",\n        \\\"Lean gently to hold the moving ring. Accept the bird.\\\",\n        \\\"Hold to squat. Release to rise. Follow the tempo.\\\",\n        \\\"Hold both step buttons. Keep the dot in the shrinking ring.\\\",\n        \\\"Step left and right as the notes reach the footprints.\\\",\n        \\\"Circle your lean. Catch rings with the matching step.\\\",\n        \\\"Alternate steps. Lean to collect ribbons and dodge crabs.\\\",\n        \\\"Tilt the raft. Roll slow shells into the tide pools.\\\",\n        \\\"Lean through the buoy gates. Forward speeds up; back brakes.\\\",\n        \\\"Keep the tray level. Deliver five extremely optimistic smoothies.\\\",\n        \\\"Press at the bottom of each bounce. Tuck in the air. Make a splash.\\\",\n        \\\"A little of everything. Then thirty seconds of absolutely nothing.\\\",\n        \\\"Four small tests. One unnecessarily large number.\\\"\n    ][self as usize]}\n    pub fn day(self)->u8 {match self {Self::Breath|Self::Pose|Self::Check=>1,Self::Squat|Self::Plank=>2,Self::Step|Self::Spin|Self::Lap=>3,Self::Finale=>5,_=>4}}\n    pub fn set(self)->usize {match self {Self::Breath|Self::Pose|Self::Check=>1,Self::Squat|Self::Plank=>2,Self::Step|Self::Spin|Self::Lap=>3,Self::Tide=>4,Self::Paddle=>5,Self::Tray=>6,Self::Dive=>7,Self::Finale=>8}}\n    pub fn coach(self)->&'static str {match self {Self::Breath|Self::Pose=>\\\"POSEY\\\",Self::Squat|Self::Plank=>\\\"BIG KETTLE\\\",Self::Step|Self::Spin|Self::Lap=>\\\"BOUNCE\\\",Self::Finale|Self::Check=>\\\"PIP\\\",_=>\\\"COMMODORE GULL\\\"}}\n    pub fn duration(self)->f32 {[45.,60.,50.,60.,64.,50.,90.,60.,45.,50.,40.,142.,65.][self as usize]}\n    pub fn from_key(key:&str)->Option<Self> {ROSTER.into_iter().chain([Self::Finale,Self::Check]).find(|k|k.key()==key)}\n    pub fn song(self)->u8 {match self.set(){1=>2,2=>3,3=>4,8=>6,_=>5}}\n}\n#[derive(Clone,Debug,Serialize,Deserialize)]\npub struct Note {pub t:f32,pub lane:u8,pub judged:bool,pub quality:f32}\n#[derive(Clone,Debug,Serialize,Deserialize)]\npub struct Shell {pub p:Vec2,pub v:Vec2,pub potted:bool}\n#[derive(Clone,Debug,Serialize,Deserialize)]\npub struct GhostPoint {pub t:f32,pub pos:Vec3,pub lean:Vec2,pub facing:f32,pub clip:u32,pub clip_t:f32,pub score:u32}\n#[derive(Clone,Debug,Serialize,Deserialize)]\npub struct Event {\n    pub kind:Kind,pub time:f32,pub duration:f32,pub core:BalanceCore,pub target:Vec2,pub radius:f32,\n    pub tally:f32,pub possible:f32,pub score:u32,pub metrics:[f32;4],pub weights:[f32;4],\n    pub lungs:f32,pub guide:f32,pub streak:f32,pub hits:u32,pub misses:u32,pub last_step:i8,pub last_step_t:f32,\n    pub pace:f32,pub progress:f32,pub side:f32,pub rings:u8,pub spin:f32,pub angle:f32,pub next_catch:f32,\n    pub shells:Vec<Shell>,pub pools:Vec<Vec2>,pub glasses:Vec<(Vec2,Vec2)>,pub notes:Vec<Note>,\n    pub phase:u8,pub sub_phase:u8,pub penalty:f32,pub collapsed:bool,pub peace:bool,pub finished:bool,\n    pub label:String,pub ghost:Vec<GhostPoint>,pub best_ghost:Vec<GhostPoint>,pub record_at:f32,\n    pub dive_power:f32,pub dive_y:f32,pub dive_v:f32,pub dive_rotate:f32,pub dive_tuck:f32,pub dive_presses:u8,pub dives:u8,\n    pub last_signal:i32,pub ready_target:bool,pub phase_start:f32,pub last_input:Vec2,\n}\nimpl Event {\n    pub fn new(kind:Kind,phases:[f32;4])->Self {\n        let mut s=Self{kind,time:0.,duration:kind.duration(),core:BalanceCore::new(phases),target:Vec2::ZERO,radius:0.35,tally:0.,possible:0.,score:0,metrics:[0.;4],weights:[0.;4],lungs:0.,guide:0.,streak:0.,hits:0,misses:0,last_step:-1,last_step_t:-1.,pace:0.,progress:0.,side:0.,rings:1,spin:0.,angle:0.,next_catch:5.,shells:vec\"'![],pools:vec![],glasses:(0..5).map(|i|(Vec2::new((i as f32-2.)*0.12,0.),Vec2::ZERO)).collect(),notes:vec![],phase:0,sub_phase:0,penalty:0.,collapsed:false,peace:true,finished:false,label:String::new(),ghost:vec![],best_ghost:vec![],record_at:0.,dive_power:0.,dive_y:0.,dive_v:0.,dive_rotate:0.,dive_tuck:0.,dive_presses:0,dives:0,last_signal:-1,ready_target:false,phase_start:0.,last_input:Vec2::ZERO};\n        s.notes=super::charts::notes();s.setup_board();s\n    }\n    pub fn setup_board(&mut self) {\n        let n=3+self.phase as usize*2;\n        self.shells=(0..n).map(|i|{let a=i as f32*TAU/n as f32;Shell{p:Vec2::new(a.cos(),a.sin())*1.4,v:Vec2::ZERO,potted:false}}).collect();\n        self.pools=vec![Vec2::new(-1.9,-1.65),Vec2::new(1.9,1.65),Vec2::new(-1.8,1.7)];\n    }\n    pub fn effective(&self)->(Kind,f32) {\n        if self.kind!=Kind::Finale{return(self.kind,self.time);}\n        if self.time<32.{(Kind::Breath,self.time)}else if self.time<52.{(Kind::Pose,self.time-32.)}else if self.time<92.{(Kind::Step,self.time-52.)}else if self.time<112.{(Kind::Plank,self.time-92.)}else{(Kind::Finale,self.time-112.)}\n    }\n    pub fn target_at(&self,t:f32)->Vec2 { Vec2::new((TAU*0.12*t).sin()*0.35,(TAU*0.075*t+0.6).sin()*0.26) }\n    pub fn gust(&self,t:f32,r:&Rules)->Vec2 {Vec2::new((t*0.7).sin()*1.4+(t*1.9).sin()*0.6,(t*0.5).cos()*0.6)*r.gust_strength}\n    pub fn step(&mut self,i:&InputFrame,dt:f32,r:&Rules,events:&mut Vec<SimEvent>,origin:Vec3) {\n        if self.finished{return;} let before=self.time; self.time+=dt;\n        let(kind,t)=self.effective();let action=i.down(b::CONFIRM); let brace=i.down(b::STEP_L)&&i.down(b::STEP_R);\n        self.target=Vec2::ZERO;self.radius=0.35;\n        let amp=match kind{Kind::Pose=>if (32.0..37.0).contains(&t){1.6}else{1.},Kind::Squat=>1.+(t/5.).floor()*0.08,Kind::Plank=>1.+t/45.,Kind::Finale=>0.2,_=>1.};\n        let gust=match kind {Kind::Paddle|Kind::Tray=>self.gust(t,r),Kind::Plank if self.kind==Kind::Finale=>self.gust(t,r)*r.finale_gusts,_=>Vec2::ZERO};\n        let tip=self.core.step(i.lean,t,dt,amp,gust,r);\n        if tip {self.penalty+=35.;self.streak=0.;events.push(SimEvent::Sfx{id:10,gain:0.7,pitch:1.});if matches!(kind,Kind::Paddle|Kind::Tide|Kind::Finale){events.push(SimEvent::Splash{pos:origin});}}\n        let cob=self.core.cob;let dist=cob.length();\n        self.label.clear();\n        match kind {\n            Kind::Breath=>{\n                self.guide=0.5-0.5*(TAU*t/8.).cos(); self.lungs=(self.lungs+dt*if action{0.25}else{-0.25}).clamp(0.,1.);\n                let good=(1.-(self.lungs-self.guide).abs()/r.breath_tolerance).clamp(0.,1.);\n                self.add((0.7*good+0.3*(dist<0.35) as u8 as f32)*if action||self.lungs>0.02{1.}else{0.15},dt);\n                self.label=if (t%8.)<4.{\"Breathe in\"}else{\"Breathe out\"}.into();\n                let cycle=(t/8.)as i32;if cycle!=self.last_signal {self.last_signal=cycle;events.push(SimEvent::Sfx{id:20,gain:0.45,pitch:1.+cycle as f32*0.12});}\n            },\n            Kind::Pose=>{\n                self.target=self.target_at(t);self.radius=(r.pose_radius-t%20.*0.006).max(0.18);\n                let in_ring=cob.distance(self.target)<self.radius;\n                self.streak=if in_ring{self.streak+dt}else{0.};let mult=1.+(self.streak/2.).floor().min(3.);\n                self.add(if in_ring{(0.65+mult*0.0875).min(1.)}else{0.},dt);\n                self.label=if (32.0..37.0).contains(&t){\"There is a bird on you. Accept the bird.\"}else{[\"The Patient Heron\",\"The Apologetic Lunge\",\"The Tired Lighthouse\"][(t/20.)as usize%3]}.into();\n            },\n            Kind::Squat=>{\n                let cycle=t%5.;self.guide=if cycle<2.{cycle/2.}else if cycle<3.{3.-cycle}else{0.};\n                self.lungs=(self.lungs+dt*if action{0.5}else{-1.}).clamp(0.,1.);\n                let timing=(1.-(self.lungs-self.guide).abs()/0.4).clamp(0.,1.);\n                self.add((0.7*timing+0.3*(cob.x.abs()<r.squat_band)as u8 as f32)*if action||cycle>=2.{1.}else{0.},dt);\n                let rep=(t/5.)as i32;if rep!=self.last_signal {self.last_signal=rep;events.push(SimEvent::Sfx{id:16,gain:0.6,pitch:0.8});}\n                self.label=if cycle<2.{\"Hold · lower slowly\"}else if cycle<3.{\"Release · rise\"}else{\"Rest. An official exercise.\"}.into();\n            },\n            Kind::Plank=>{\n                self.radius=(r.plank_radius-t/300.).max(0.2);\n                if !brace||dist>self.radius {self.penalty+=dt;}else{self.penalty=(self.penalty-dt*0.5).max(0.);}\n                if brace&&dist<self.radius {self.add(1.,dt);}else{self.add(0.,dt);}\n                if self.penalty>1.&&!self.collapsed {self.collapsed=true;self.label=\"A very horizontal decision.\".into();}\n                if self.collapsed&&self.kind==Kind::Plank {self.finished=true;self.score=(t/60.*1000.).min(1000.)as u32;}\n                else {self.label=if t>45.{\"Kettle is laughing. Brace for the joke.\"}else if t>30.{\"A small tremble. Very professional.\"}else{\"Hold both. Be a dignified plank.\"}.into();}\n            },\n            Kind::Step=>{\n                let rhythm_t=if self.kind==Kind::Finale{t}else{i.song_pos.unwrap_or(t)};\n                for lane in 0..2u8 {let bit=if lane==0{b::STEP_L}else{b::STEP_R};if i.just(bit){\n                    let nearest=self.notes.iter().enumerate().filter(|(_,n)|!n.judged&&n.lane==lane).min_by(|(_,a),(_,b)|(a.t-rhythm_t).abs().total_cmp(&(b.t-rhythm_t).abs()));\n                    if let Some((idx,n))=nearest {let diff=(n.t-rhythm_t).abs();if diff<=r.rhythm_good {let q=if diff<=r.rhythm_perfect{1.}else{0.7};self.notes[idx].judged=true;self.notes[idx].quality=q;self.tally+=q;self.hits+=1;self.streak+=1.;self.label=if q>0.9{\"Perfect\"}else{\"Good\"}.into();events.push(SimEvent::Sfx{id:6,gain:0.7,pitch:1.+lane as f32*0.2});}else{self.streak=0.;}}\n                }}\n                for n in &mut self.notes {if !n.judged&&n.t<rhythm_t-r.rhythm_good{n.judged=true;self.misses+=1;self.streak=0.;}}\n                self.possible=self.notes.iter().filter(|n|n.t<if self.kind==Kind::Finale{40.}else{64.}).count()as f32;\n                if self.label.is_empty(){self.label=\"Left. Right. Excessively cheerful.\".into();}\n            },\n            Kind::Spin=>{\n                let a=i.lean.y.atan2(i.lean.x);let d=(a-self.angle+std::f32::consts::PI).rem_euclid(TAU)-std::f32::consts::PI;self.angle=a;\n                self.spin+=(d/dt-self.spin)*0.15;let dir=if (t/15.)as u32%2==0{1.}else{-1.};\n                let band=if i.device==0{r.spin_band_scale}else{1.};let good=i.lean.length()>0.4&&self.spin*dir>6./band&&self.spin*dir<9.*band;\n                self.add(if good{0.6+0.4*self.rings as f32/7.}else{0.},dt);\n                if t>=self.next_catch-0.25&&t<=self.next_catch+0.25 {let side=if (self.next_catch/5.)as u32%2==0{b::STEP_R}else{b::STEP_L};self.label=if side==b::STEP_R{\"Catch right!\"}else{\"Catch left!\"}.into();if i.just(side){self.rings=(self.rings+1).min(7);self.next_catch+=5.;events.push(SimEvent::Sfx{id:17,gain:0.7,pitch:1.});}}\n                else if t>self.next_catch+0.25{self.next_catch+=5.;}\n                if !good {self.penalty+=dt;}else{self.penalty=0.;}if self.penalty>3.{self.rings=self.rings.saturating_sub(1).max(1);self.penalty=0.;}\n                if self.label.is_empty(){self.label=if dir>0.{\"Circle anticlockwise\"}else{\"Switch! Circle clockwise\"}.into();}\n            },\n            Kind::Lap=>{\n                self.steps(i,t,events);\n                let gap=t-self.last_step_t;let in_zone=self.pace>=1.6&&self.pace<=2.4&&gap<0.9;\n                self.side=cob.x*1.2;let ribbon=(t*0.38).sin()*0.85;\n                self.progress=(t/90.).min(1.);self.target.x=ribbon/1.2;self.radius=0.22;\n                self.add(if in_zone {0.72+0.28*(self.side-ribbon).abs().lt(&0.35)as u8 as f32}else{0.},dt);\n                if self.pace>2.8 {self.penalty+=dt*3.;}self.label=if self.pace>2.8{\"A stitch. Your enthusiasm has been noted.\"}else if in_zone{\"Lovely pace. Mind the crab.\"}else{\"Alternate left and right · find your pace\"}.into();\n            },\n            Kind::Tide=>{\n                let board=(t/20.).min(2.)as u8;if board!=self.phase{self.phase=board;self.setup_board();}\n                if self.phase>0 {self.pools[1]=Vec2::new(1.65,(t*0.6).sin()*1.5);}\n                for sh in &mut self.shells {if sh.potted{continue;}sh.v+=(Vec2::new(cob.x,-cob.y)*5.-sh.v*r.shell_friction)*dt;sh.p+=sh.v*dt;\n                    for axis in 0..2{if sh.p[axis].abs()>2.65{sh.p[axis]=sh.p[axis].clamp(-2.65,2.65);sh.v[axis]*=-0.5;}}\n                    if self.phase==2&&sh.p.length()<0.45{sh.v+=sh.p.normalize_or_zero()*1.5;}\n                    if self.pools.iter().any(|p|p.distance(sh.p)<0.42)&&sh.v.length()<1.5{sh.potted=true;self.hits+=1;events.push(SimEvent::Sfx{id:19,gain:0.7,pitch:1.+self.hits as f32*0.03});}\n                }\n                self.score=(self.hits as f32/15.*1000.).min(1000.)as u32;self.label=format!(\"Raft {} · slow shells stay in pools\",self.phase+1);\n            },\n            Kind::Paddle=>{\n                self.progress=(t/45.).min(1.);let gate=(self.progress*9.).floor()as i32;let centre=Self::gate(gate);\n                self.target=Vec2::new(centre,0.5);self.radius=0.24;self.side+=(cob.x*4.-self.side)*dt*2.5;\n                let good=(self.side/4.-centre).abs()<0.22;self.add(if good&&cob.y>0.1{1.}else{0.},dt);\n                if gate!=self.last_signal {if self.last_signal>=0 {if good{self.hits+=1;events.push(SimEvent::Sfx{id:20,gain:0.5,pitch:1.2});}else{self.misses+=1;}}self.last_signal=gate;}\n                self.label=\"Lean toward the next gate · forward for speed\".into();\n                if (t*8.)as i32!=(before*8.)as i32 {events.push(SimEvent::Wake{pos:origin+Vec3::new(self.side,0.,-self.progress*72.)});}\n            },\n            Kind::Tray=>{\n                self.target=-self.gust(t,r)/r.stiffness;self.radius=0.2;\n                let tray=cob+Vec2::new((t*0.9).sin()*0.04,(t*1.3).cos()*0.04);\n                for (p,v) in &mut self.glasses {if p.length()>3.{continue;}*v+=(tray*2.2-*v*r.tray_friction)*dt;*p+=*v*dt;if p.length()>0.65{*p=Vec2::splat(10.);self.misses+=1;events.push(SimEvent::Sfx{id:21,gain:0.7,pitch:1.});}}\n                self.progress=t/50.;self.score=(self.glasses.iter().filter(|(p,_)|p.length()<1.).count()*200)as u32;\n                self.add((1.-tray.length()/0.18).clamp(0.,1.),dt);self.label=\"Counter the waves. The glasses are trusting you.\".into();\n            },\n            Kind::Dive=>{\n                let local=t-self.phase_start;let cycle=local%1.2;self.guide=0.5-0.5*(TAU*cycle/1.2).cos();\n                if self.dive_presses<4 {self.dive_y=0.15*(TAU*cycle/1.2).sin();self.label=format!(\"Bounce {} of 4 · press at the lowest point\",self.dive_presses+1);\n                    if i.just(b::CONFIRM){let q=(1.-(cycle-0.9).abs()/0.32).clamp(0.,1.);self.dive_power+=q*r.bounce_gain;self.dive_presses+=1;events.push(SimEvent::Sfx{id:7,gain:0.5,pitch:0.8+q*0.4});if self.dive_presses==4{self.dive_v=5.+self.dive_power*1.5;self.dive_y=2.;}}\n                    if local>7.&&self.dive_presses<4 {self.dive_presses=4;self.dive_v=4.;self.dive_y=2.;}\n                } else if self.sub_phase==0 {\n                    self.dive_v-=7.*dt;self.dive_y+=self.dive_v*dt;self.dive_rotate+=cob.x*dt*3.;self.dive_tuck=if action{(self.dive_tuck+dt*2.).min(1.)}else{(self.dive_tuck-dt*3.).max(0.)};\n                    self.label=\"Hold to tuck! Lean for a little unnecessary rotation.\".into();\n                    if self.dive_y<0.{let quality=(self.dive_power/4.).min(1.)*(0.4+0.6*self.dive_tuck);self.tally+=quality;self.dives+=1;self.sub_phase=1;self.phase_start=t;events.push(SimEvent::BigSplash{pos:origin+Vec3::new(2.,0.,0.),size:3.+quality*7.});self.label=\"6.5       7       See me\".into();}\n                } else {self.label=\"6.5       7       See me\".into();if local>1.8{if self.dives>=3{self.finished=true;}else{self.dive_presses=0;self.dive_power=0.;self.sub_phase=0;self.phase_start=t;}}}\n                self.score=(self.tally/3.*1000.)as u32;\n            },\n            Kind::Finale=>{\n                self.radius=0.35;self.label=if t>15.{\"Press to skip\"}else{\"The Long Stillness\"}.into();\n                if i.any||i.held!=0||i.lean.length()>0.1 {self.peace=false;}\n                self.add(if self.peace{1.}else{0.},dt);\n            },\n            Kind::Check=>{\n                let stage=if t<12.{0}else if t<33.{1}else if t<43.{2}else{3};self.phase=stage;\n                let good=match stage {\n                    0=>{self.label=\"Stand still. This is the whole test.\".into();if t>5.&&before<=5.{self.core.vel.x+=0.4;}(1.-dist/0.4).clamp(0.,1.)},\n                    1=>{let n=((t-12.)/7.)as usize;self.target=Vec2::new([-0.7,0.55,-0.35][n.min(2)],0.);self.radius=0.1;self.label=format!(\"Lean to {}% {}\",(self.target.x.abs()*100.)as u32,if self.target.x<0.{\"left\"}else{\"right\"});(1.-cob.distance(self.target)/0.3).clamp(0.,1.)},\n                    2=>{self.label=\"Eyes closed. Listen to the tone. Trust less.\".into();if (t*8.)as u32!=(before*8.)as u32{events.push(SimEvent::Sfx{id:29,gain:0.2,pitch:0.5+dist*3.});}(1.-dist/0.35).clamp(0.,1.)},\n                    _=>{self.label=\"Eight alternating steps · follow the bell\".into();let beat=((t-43.)/0.6)as i32;if beat!=self.last_signal&&beat<8{self.last_signal=beat;events.push(SimEvent::Sfx{id:16,gain:0.6,pitch:1.});}let prev=self.hits;self.steps(i,t,events);if self.hits>prev{let error=((t-43.)/0.6).fract().min(1.-((t-43.)/0.6).fract())*0.6;self.metrics[3]+=(1.-error/0.25).clamp(0.,1.);self.weights[3]+=1.;}0.}\n                };\n                if stage<3 {self.metrics[stage as usize]+=good*dt;self.weights[stage as usize]+=dt;}\n            }\n        }\n        self.last_input=i.lean;\n        if !matches!(self.kind,Kind::Tide|Kind::Tray|Kind::Dive|Kind::Check)&&!self.collapsed {self.score=((self.tally/self.possible.max(0.001)*1000.-self.core.tips as f32*25.).clamp(0.,1000.))as u32;}\n        if self.kind==Kind::Finale {self.phase=if self.time<32.{0}else if self.time<52.{1}else if self.time<92.{2}else if self.time<112.{3}else{4};}\n        if self.time>=self.duration {self.finished=true;}\n    }\n    fn add(&mut self,q:f32,dt:f32){self.tally+=q*dt;self.possible+=dt;}\n    fn steps(&mut self,i:&InputFrame,t:f32,events:&mut Vec<SimEvent>){\n        for lane in 0..2 {let bit=if lane==0{b::STEP_L}else{b::STEP_R};if i.just(bit){if self.last_step!=lane {if self.last_step_t>=0.{let gap=t-self.last_step_t;self.pace=1./gap.max(0.1);}self.last_step=lane;self.last_step_t=t;self.hits+=1;events.push(SimEvent::Sfx{id:6,gain:0.55,pitch:1.});}else{self.misses+=1;}}}\n    }\n    pub fn gate(n:i32)->f32 {(n as f32*1.7).sin()*0.6}\n    pub fn skill(&self)->[f32;4] {let mut out=[0.;4];for(n,v)in out.iter_mut().enumerate(){*v=(self.metrics[n]/self.weights[n].max(if n==3{8.}else{0.001})).clamp(0.,1.);}out}\n    pub fn bot(&self,r:&Rules,dt:f32)->InputFrame {\n        let mut i=InputFrame::default();let(k,t)=self.effective();let mut target=Vec2::ZERO;\n        match k {\n            Kind::Breath=>{if t%8.<4.{i.held|=b::CONFIRM;}},\n            Kind::Pose=>target=self.target_at(t+0.17),\n            Kind::Squat=>{if t%5.<2.{i.held|=b::CONFIRM;}},\n            Kind::Plank=>i.held=b::STEP_L|b::STEP_R,\n            Kind::Step=>{for n in &self.notes{if !n.judged&&n.t>=t-dt*0.5&&n.t<t+dt*0.6{i.pressed|=if n.lane==0{b::STEP_L}else{b::STEP_R};i.held=i.pressed;}}},\n            Kind::Spin=>{let dir=if(t/15.)as u32%2==0{1.}else{-1.};let a=if dir>0.{t*7.5}else{-(t-15.)*7.5+112.5};i.lean=Vec2::new(a.cos(),a.sin())*0.7;let bit=if(self.next_catch/5.)as u32%2==0{b::STEP_R}else{b::STEP_L};if(self.next_catch-t).abs()<dt{i.pressed|=bit;i.held=i.pressed;}return i;},\n            Kind::Lap=>{target.x=(t*0.38).sin()*0.85/1.2;let n=(t/0.5).floor()as i32;let prev=((t-dt).max(0.)/0.5).floor()as i32;if n!=prev||t<dt{let bit=if n%2==0{b::STEP_L}else{b::STEP_R};i.pressed|=bit;i.held=i.pressed;}},\n            Kind::Paddle=>{target=Vec2::new(Self::gate(((t/45.)*9.).floor()as i32),0.5);},\n            Kind::Tide=>{\n                if let Some(sh)=self.shells.iter().filter(|s|!s.potted).next(){let pool=self.pools.iter().min_by(|a,b|a.distance_squared(sh.p).total_cmp(&b.distance_squared(sh.p))).unwrap();let desired=(*pool-sh.p)*2.-sh.v*1.5;target=Vec2::new(desired.x,-desired.y).clamp_length_max(0.85);}\n            },\n            Kind::Tray=>target=-self.gust(t,r)/r.stiffness-Vec2::new((t*0.9).sin()*0.04,(t*1.3).cos()*0.04),\n            Kind::Dive=>{let cycle=(t-self.phase_start)%1.2;if self.dive_presses<4&&(cycle-0.9).abs()<dt*0.6{i.pressed=b::CONFIRM;i.held=b::CONFIRM;}if self.dive_presses>=4{i.held=b::CONFIRM;target.x=0.18;}},\n            Kind::Finale=>return i,\n            Kind::Check=>{if(12.0..33.0).contains(&t){target.x=[-0.7,0.55,-0.35][(((t-12.)/7.)as usize).min(2)];}if(43.0..47.8).contains(&t){let n=((t-43.)/0.6).round()as i32;if(t-43.-n as f32*0.6).abs()<dt*0.6 {let bit=if n%2==0{b::STEP_L}else{b::STEP_R};i.held=bit;i.pressed=bit;}}}\n        }\n        i.lean=self.core.steer(target,t,1.,r);i\n    }\n}\nEOF\ncat > engine/crates/pav_core/src/games/fit/charts.rs <<'\"'EOF'\nuse super::events::Note;\n#[derive(serde::Deserialize)]struct Chart{note:Vec<Entry>}\n#[derive(serde::Deserialize)]struct Entry{t:f32,lane:u8}\npub fn notes()->Vec<Note>{let data=super::super::level_text(\\\"fit/charts\\\",include_str\"'!(\"charts.toml\"));let chart:Chart=toml::from_str(&data).expect(\"authored step chart\");chart.note.into_iter().map(|n|Note{t:n.t,lane:n.lane,judged:false,quality:0.}).collect()}\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('engine/crates/pav_core/src/games/fit/charts.toml');s='# 96 BPM, 64 seconds. Hand-authored quarter, eighth and double progression.\\\\n'\nfor beat in range(4,100):\n t=beat*0.625\n for lane in ([0,1] if beat%12==0 else [beat%2]):s+=f'[[note]]\\\\nt = {t:.4f}\\\\nlane = {lane}\\\\n'\n if beat>60 and beat%3==0:s+=f'[[note]]\\\\nt = {t+0.3125:.4f}\\\\nlane = {(beat+1)%2}\\\\n'\np.write_text(s)\np=Path('engine/crates/pav_core/src/puppet.rs');s=p.read_text().replace('    pub lean_side: f32,','    pub lean_side: f32,\\\\n    #[serde(default)]\\\\n    pub tilt_side: f32,\\\\n    #[serde(default)]\\\\n    pub tilt_fwd: f32,',1).replace('            lean_side: l(self.lean_side, o.lean_side),','            lean_side: l(self.lean_side, o.lean_side),\\\\n            tilt_side: l(self.tilt_side, o.tilt_side),\\\\n            tilt_fwd: l(self.tilt_fwd, o.tilt_fwd),');s=s.replace('(topple.unwrap_or(Quat::IDENTITY) * spin.unwrap_or(Quat::IDENTITY), shift + sink)','(Quat::from_rotation_z(-st.tilt_side) * Quat::from_rotation_x(st.tilt_fwd) * topple.unwrap_or(Quat::IDENTITY) * spin.unwrap_or(Quat::IDENTITY), shift + sink)');p.write_text(s)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"cat > engine/crates/pav_core/src/games/fit/meta.rs <<'EOF'\nuse serde::{Deserialize,Serialize};\nuse super::events::GhostPoint;\n#[derive(Clone,Debug,Serialize,Deserialize)]\n#[serde(default)]\npub struct Settings {pub music:f32,pub sfx:f32,pub voice:f32,pub xbox:bool,pub sensitivity:f32,pub assist:f32,pub rhythm:f32,pub text_speed:f32}\nimpl Default for Settings {fn default()->Self{Self{music:0.10,sfx:0.8,voice:0.8,xbox:false,sensitivity:1.,assist:0.,rhythm:0.10,text_speed:45.}}}\n#[derive(Clone,Debug,Default,Serialize,Deserialize)]\npub struct Best {pub score:u32,pub stars:u8,pub ghost:Vec<GhostPoint>}\n#[derive(Clone,Debug,Serialize,Deserialize)]\n#[serde(default)]\npub struct Guest {pub name:String,pub skin:u8,pub outfit:u8,pub gear:u8,pub day:u8,pub minutes:u32,pub total_minutes:u32,pub stars:u32,pub stamps:u8,pub ages:Vec<u8>,pub age:u8,pub today:u32,pub clears:Vec<u8>,pub bests:Vec<Best>,pub flipflops:Vec<u8>,pub free_play:bool,pub check_done:bool,pub titles:Vec<String>}\nimpl Default for Guest {fn default()->Self{Self{name:\\\"Sunny Sideup\\\".into(),skin:2,outfit:0,gear:0,day:1,minutes:0,total_minutes:0,stars:0,stamps:0,ages:vec\"'![],age:61,today:0,clears:vec![],bests:vec![Best::default();13],flipflops:vec![],free_play:false,check_done:false,titles:vec![]}}}\n#[derive(Clone,Debug,Serialize,Deserialize)]\n#[serde(default)]\npub struct Save {pub version:u32,pub active:usize,pub guests:Vec<Option<Guest>>,pub settings:Settings}\nimpl Default for Save {fn default()->Self{Self{version:1,active:0,guests:vec![None;4],settings:Settings::default()}}}\npub const NAMES:[&str;40]=[\"Sunny Sideup\",\"Pat Balance\",\"Olive Still\",\"Robin Wobbles\",\"Sandy Knees\",\"Bea Present\",\"Lou Sway\",\"Finn Floating\",\"Penny Loafer\",\"Art Standing\",\"Kit Nap\",\"Terry Towels\",\"Al Fresco\",\"Dee Breeze\",\"Sal T. Air\",\"Joy Stick\",\"Gail Force\",\"Sid Down\",\"Anita Rest\",\"Mo Mentum\",\"Ray O'\"'Sun\\\",\\\"Cora Reef\\\",\\\"Bo Breathe\\\",\\\"Nora Rush\\\",\\\"Mel Low\\\",\\\"Ari Relax\\\",\\\"Lee N. Left\\\",\\\"Will Sway\\\",\\\"Dot Centre\\\",\\\"Tina Tiptoe\\\",\\\"Stu D. O\\\",\\\"May B. Later\\\",\\\"Cam Down\\\",\\\"Rae D. O\\\",\\\"Aqua Velva\\\",\\\"Drew A. Breath\\\",\\\"Clam Chowder\\\",\\\"Pearl Diver\\\",\\\"Wade Ashore\\\",\\\"Ira Gently\\\"];\npub const SKINS:[&str;6]=[\\\"#f3d5bc\\\",\\\"#e4b58e\\\",\\\"#cf946e\\\",\\\"#ac765a\\\",\\\"#86583e\\\",\\\"#5d3c30\\\"];\npub const OUTFITS:[(&str,&str);8]=[(\\\"Lagoon club\\\",\\\"#46bec8\\\"),(\\\"Coral society\\\",\\\"#ff8b7f\\\"),(\\\"Lemon lounge\\\",\\\"#edca69\\\"),(\\\"Palm reader\\\",\\\"#92bc80\\\"),(\\\"Lilac hour\\\",\\\"#b9a9d8\\\"),(\\\"Cloud guest\\\",\\\"#faf6ec\\\"),(\\\"Deep sea\\\",\\\"#4d7998\\\"),(\\\"Sunset stay\\\",\\\"#ce997d\\\")];\npub fn age(skill:[f32;4],days:u8,stars:u32)->u8 {let s=skill[0]*0.30+skill[1]*0.25+skill[2]*0.25+skill[3]*0.20;(24.+56.*(1.-s.clamp(0.,1.)).powf(1.1)-2.*days as f32-(stars as f32/3.).min(8.)).round().clamp(18.,99.)as u8}\npub fn stars(score:u32)->u8 {if score>=850{3}else if score>=650{2}else if score>=400{1}else{0}}\npub fn goal(day:u8)->u32 {[3,5,7,9,0][(day.saturating_sub(1)as usize).min(4)]}\nEOF\ncat > engine/crates/pav_core/src/games/fit/ui_model.rs <<'EOF'\nuse glam::Vec2;\n#[derive(Clone,Debug,Default)]\npub struct Item {pub id:u16,pub text:String,pub detail:String,pub enabled:bool,pub value:Option<(f32,f32,f32)>}\n#[derive(Clone,Debug,Default)]\npub struct UiFrame {\n    pub screen:String,pub heading:String,pub kicker:String,pub subtitle:String,pub lines:Vec<String>,pub items:Vec<Item>,pub focus:usize,\n    pub day:u8,pub minutes:u32,pub minute_goal:u32,pub age:u8,pub stamps:u8,pub ages:Vec<u8>,pub score:u32,pub stars:u8,pub best:u32,pub banked:u32,\n    pub time:f32,pub duration:f32,pub dot:Vec2,pub target:Vec2,pub radius:f32,pub guide:f32,pub lungs:f32,pub phase:u8,pub event:u8,\n    pub notes:Vec<(f32,u8,bool)>,pub label:String,pub coach:String,pub dialogue:String,pub revealed:usize,pub countdown:i32,\n    pub device:u8,pub xbox:bool,pub demo:bool,pub touch:bool,pub peace:bool,pub show_puck:bool,pub blind:bool,pub trace:Vec<Vec2>,\n    pub debug:bool,pub player_name:String,pub prompt:String,pub version:String,pub hub:bool,pub page:usize,pub pages:usize,\n}\nEOF\ncat > engine/crates/pav_core/src/games/fit/mod.rs <<'EOF'\n//\"'! Wobble Wit'\"'s deterministic resort, menus and activity dispatcher.\npub mod core;pub mod events;pub mod meta;pub mod ui_model;mod charts;mod world;mod dialogue;\nuse std::{collections::BTreeMap,sync::Arc};\nuse anyhow::Result;\nuse glam::{Vec2,Vec3};\nuse serde::{Serialize,Deserialize};\nuse serde_json::json;\nuse crate::{sim::Sim,input::{InputFrame,UiEvent,buttons as b},frame::SimEvent,entity::EntityId};\nuse super::{Game,GameBox,Outcome};\nuse events::{Kind,Event,ROSTER};use meta::{Guest,Save};use ui_model::{UiFrame,Item};\npub const TITLE:&str=\\\"Wobble Wit\\\";\npub const TAGLINE:&str=\\\"A little less wobble. A little more you.\\\";\n#[derive(Clone,Debug,Serialize,Deserialize)]\n#[serde(default)]\npub struct Rules {\n    pub stiffness:f32,pub damping:f32,pub reach:f32,pub wobble:f32,pub tip_time:f32,pub stick_curve:f32,pub key_rate:f32,pub key_return:f32,\n    pub pose_radius:f32,pub breath_tolerance:f32,pub squat_band:f32,pub plank_radius:f32,pub rhythm_perfect:f32,pub rhythm_good:f32,\n    pub spin_band_scale:f32,pub lap_zone:f32,pub shell_friction:f32,pub gust_strength:f32,pub tray_friction:f32,pub bounce_gain:f32,pub finale_gusts:f32,\n}\nimpl Default for Rules {fn default()->Self {toml::from_str(include_str\"'!(\"rules.toml\")).expect(\"rules defaults\")}}\n#[derive(Clone,Copy,Debug,Default,PartialEq,Eq,Serialize,Deserialize)]\npub enum Screen {#[default]Title,Guest,Name,Look,Intro,Hub,Card,Countdown,Event,Result,Report,Schedule,Calendar,Pause,Settings,Wardrobe,How,About,Dev,Pass,Podium,Ending,Credits,Reset}\n#[derive(Clone,Debug,Default,Serialize,Deserialize)]\npub struct Medley {pub active:bool,pub players:u8,pub seat:u8,pub round:u8,pub scores:Vec<u32>,pub names:Vec<String>,pub runs:Vec<Vec<events::GhostPoint>>,pub total:u32,pub hub:bool,pub go:bool,pub ended:bool}\n#[derive(Clone,Serialize,Deserialize)]\npub struct FitGame {\n    pub rules:Rules,pub screen:Screen,pub return_to:Screen,pub focus:usize,pub page:usize,pub time:f32,pub screen_time:f32,pub idle:f32,\n    pub profile:Guest,pub save:Save,pub serial:u32,pub today:u32,pub event:Event,pub countdown:f32,pub direct:bool,pub outcome:Outcome,\n    pub dialogue:Vec<String>,pub dialog_index:usize,pub revealed:f32,pub speaker:String,pub message:String,pub message_time:f32,\n    pub result_title:String,pub banked:u32,pub previous_best:u32,pub demo:bool,pub demo_index:usize,pub demo_time:f32,pub device:u8,\n    pub hub:Medley,pub together_count:u8,pub dev_tab:usize,pub autoplay:bool,pub no_tips:bool,pub time_scale:f32,pub show_trace:bool,pub trace:Vec<Vec2>,\n    pub way_to:Option<Vec3>,pub interact_goal:Option<usize>,pub nearest:Option<usize>,pub props:world::Actors,pub set:usize,pub last_gain:[f32;3],\n    pub about:serde_json::Value,pub look_skin:u8,pub look_outfit:u8,pub about_pages:Vec<(String,Vec<String>)>,pub last_music:u8,\n}\npub fn build(sim:&mut Sim,rest:Option<&str>)->Result<()> {\n    let props=world::build(sim)?;\n    let rules:Rules=toml::from_str(&super::level_text(\"fit/rules\",include_str!(\"rules.toml\")))?;\n    let phases=[sim.state.rng.range(0.,6.28),sim.state.rng.range(0.,6.28),sim.state.rng.range(0.,6.28),sim.state.rng.range(0.,6.28)];\n    let mut g=FitGame{rules,screen:Screen::Title,return_to:Screen::Hub,focus:0,page:0,time:0.,screen_time:0.,idle:0.,profile:Guest::default(),save:Save::default(),serial:0,today:0,event:Event::new(Kind::Pose,phases),countdown:3.,direct:false,outcome:Outcome::Playing,dialogue:vec![],dialog_index:0,revealed:0.,speaker:\"PIP\".into(),message:String::new(),message_time:0.,result_title:String::new(),banked:0,previous_best:0,demo:false,demo_index:0,demo_time:0.,device:0,hub:Medley::default(),together_count:2,dev_tab:0,autoplay:false,no_tips:false,time_scale:1.,show_trace:false,trace:vec![],way_to:None,interact_goal:None,nearest:None,props,set:0,last_gain:[-1.;3],about:json!({}),look_skin:2,look_outfit:0,about_pages:vec![],last_music:255};\n    if let Some(rest)=rest {if let Some(key)=rest.strip_prefix(\"event/\"){if let Some(kind)=Kind::from_key(key){g.direct=true;g.start_event(kind,sim);g.screen=Screen::Event;}}\n        else if rest==\"medley\"{g.start_medley(1,true,sim);g.hub.go=false;}\n        else if rest==\"hub\"{g.screen=Screen::Hub;g.profile.free_play=true;g.profile.day=5;g.profile.check_done=true;}\n        else if rest==\"attract\"{g.start_demo(sim);}}\n    sim.state.play=Some(GameBox::new(g));Ok(())\n}\nimpl FitGame {\n    pub fn load_save(&mut self,text:&str,today:u32){self.today=today;if let Ok(s)=serde_json::from_str::<Save>(text){if s.version==1&&s.guests.len()==4&&s.active<4{self.save=s;if let Some(p)=self.save.guests[self.save.active].clone(){self.profile=p;}self.look_skin=self.profile.skin;self.look_outfit=self.profile.outfit;}}}\n    pub fn set_about(&mut self,v:serde_json::Value){\n        self.about=v.clone();self.about_pages.clear();\n        if let Some(info)=v.get(\"sourceInformation\").and_then(|v|v.as_object()) {let mut lines=vec![];for key in [\"date\",\"source\",\"plan\",\"genre\",\"perspective\",\"tech\",\"artDirection\",\"animation\",\"audio\",\"online\",\"testing\",\"research\",\"environment\",\"model\",\"usage\"]{if let Some(value)=info.get(key).and_then(|v|v.as_str()){lines.push(format!(\"{}: {}\",key,value));}}\n            for chunk in lines.chunks(4){self.about_pages.push((\"Source Information\".into(),chunk.to_vec()));}}\n        for (key,title)in[(\"testingFeedback\",\"Testing Feedback\"),(\"engineFeedback\",\"Engine Feedback\"),(\"promptFeedback\",\"Prompt Feedback\")] {if let Some(a)=v.get(key).and_then(|v|v.as_array()){for chunk in a.chunks(2){self.about_pages.push((title.into(),chunk.iter().filter_map(|s|s.as_str().map(String::from)).collect()));}}}\n        self.about_pages.push((\"Made with a little wobble\".into(),vec![\"Pavilion engine · Michael Crosato · original resort art and FIT motion clips.\".into(),\"Fredoka by Milena Brandão; Nunito by Vernon Adams and contributors · SIL Open Font License.\".into(),\"Motion libraries: CMU (research motion data), Mesh2Motion and Quaternius (CC0), STYLE100 (see source credit). Full notices in source engine/store/CREDITS.md.\".into()]));\n    }\n    pub fn change(&mut self,s:Screen){self.screen=s;self.focus=0;self.page=0;self.screen_time=0.;}\n    fn save_change(&mut self){if self.demo||self.hub.active{return;}self.profile.today=self.today;self.save.guests[self.save.active]=Some(self.profile.clone());self.serial+=1;}\n    fn toast(&mut self,line:impl Into<String>){self.message=line.into();self.message_time=5.;}\n    fn talk(&mut self,speaker:&str,lines:Vec<String>,next:Screen){self.speaker=speaker.into();self.dialogue=lines;self.dialog_index=0;self.revealed=0.;self.return_to=next;self.change(Screen::Intro);}\n    pub fn start_event(&mut self,kind:Kind,sim:&mut Sim){\n        let phases=[sim.state.rng.range(0.,6.28),sim.state.rng.range(0.,6.28),sim.state.rng.range(0.,6.28),sim.state.rng.range(0.,6.28)];\n        self.event=Event::new(kind,phases);if self.profile.day>=3 {self.event.best_ghost=self.profile.bests.get(kind as usize).map(|b|b.ghost.clone()).unwrap_or_default();}\n        self.countdown=3.;self.set=kind.set();self.trace.clear();self.way_to=None;self.nearest=None;world::set(sim,self.set);self.change(Screen::Card);\n    }\n    fn to_hub(&mut self,sim:&mut Sim){self.set=0;world::set(sim,0);self.change(Screen::Hub);self.way_to=None;}\n    fn start_day(&mut self,sim:&mut Sim){self.start_event(Kind::Check,sim);}\n    fn start_medley(&mut self,n:u8,online:bool,sim:&mut Sim){self.hub=Medley{active:true,players:n,hub:online,scores:vec![],names:(0..n).map(|i|if i==0{self.profile.name.clone()}else{meta::NAMES[(i as usize*7)%40].into()}).collect(),go:!online,..Default::default()};self.hub.runs=vec![];self.start_event(Kind::Paddle,sim);if online {self.change(Screen::Event);}else{self.change(Screen::Pass);}}\n    fn start_demo(&mut self,sim:&mut Sim){self.demo=true;self.demo_index=0;self.demo_time=0.;self.start_event(Kind::Dive,sim);self.change(Screen::Event);}\n    fn end_demo(&mut self,sim:&mut Sim){self.demo=false;self.idle=0.;self.set=0;world::set(sim,0);self.change(Screen::Title);self.last_music=255;}\n    fn finish_event(&mut self,sim:&mut Sim,events:&mut Vec<SimEvent>){\n        if self.event.kind==Kind::Check {\n            self.profile.age=meta::age(self.event.skill(),self.profile.day-1,self.profile.stars);self.profile.ages.push(self.profile.age);self.profile.check_done=true;self.save_change();self.change(Screen::Report);events.push(SimEvent::Sfx{id:4,gain:0.8,pitch:1.});return;\n        }\n        let score=self.event.score.min(1000);let stars=meta::stars(score);self.previous_best=self.profile.bests[self.event.kind as usize].score;\n        self.banked=if self.profile.clears.contains(&(self.event.kind as u8)){1}else{1+stars as u32};\n        self.result_title=dialogue::title(score,(self.time as usize)%6);\n        if !self.hub.active {\n            self.profile.minutes+=self.banked;self.profile.total_minutes+=self.banked;self.profile.stars+=stars as u32;\n            if !self.profile.clears.contains(&(self.event.kind as u8)){self.profile.clears.push(self.event.kind as u8);}\n            if score>=self.previous_best {self.profile.bests[self.event.kind as usize]=meta::Best{score,stars,ghost:self.event.ghost.clone()};}\n            if !self.profile.titles.contains(&self.result_title){self.profile.titles.push(self.result_title.clone());}\n            if self.event.kind==Kind::Finale {self.profile.age=self.profile.age.saturating_sub((score/100)as u8).max(18);}\n            self.save_change();\n        } else {self.hub.total+=score;self.hub.runs.push(self.event.ghost.clone());}\n        self.change(Screen::Result);events.push(SimEvent::Sfx{id:22,gain:0.75,pitch:1.});\n        if self.direct {self.outcome=Outcome::Won;}\n    }\n    fn medley_next(&mut self,sim:&mut Sim){\n        self.hub.round+=1;if self.hub.round<3 {let k=[Kind::Paddle,Kind::Tide,Kind::Dive][self.hub.round as usize];self.start_event(k,sim);if self.hub.hub{self.change(Screen::Event);}return;}\n        self.hub.scores.push(self.hub.total);self.hub.seat+=1;self.hub.round=0;self.hub.total=0;\n        if self.hub.seat>=self.hub.players {self.change(Screen::Podium);self.hub.ended=true;}\n        else {self.start_event(Kind::Paddle,sim);self.change(Screen::Pass);}\n    }\n    fn end_day(&mut self,sim:&mut Sim,events:&mut Vec<SimEvent>){\n        if self.profile.minutes<meta::goal(self.profile.day)&&!self.profile.free_play{self.toast(\"The clam is still expecting minutes. It has cleared its afternoon.\");return;}\n        self.profile.stamps=self.profile.stamps.max(self.profile.day);events.push(SimEvent::Sfx{id:3,gain:0.8,pitch:1.});\n        self.change(Screen::Calendar);self.save_change();let _=sim;\n    }\n    fn items(&self)->Vec<Item>{\n        let item=|id:u16,text:String,detail:String|Item{id,text,detail,enabled:true,value:None};let simple=|a:&[&str]|a.iter().enumerate().map(|(i,t)|item(i as u16,(*t).into(),String::new())).collect::<Vec<_>>();\n        match self.screen {\n            Screen::Title=>{let mut a=vec![];if self.save.guests.iter().any(|s|s.is_some()){a.push(item(10,\"Continue your stay\".into(),format!(\"{} · day {}\",self.profile.name,self.profile.day)));}for(id,t)in[(0,\"New Stay\"),(1,\"Play Together\"),(2,\"Settings\"),(3,\"About this little island\")]{a.push(item(id,t.into(),String::new()));}a},\n            Screen::Guest=>(0..4).map(|n|item(n,format!(\"Guest {}\",n+1),self.save.guests[n as usize].as_ref().map(|g|format!(\"{} · day {}\",g.name,g.day)).unwrap_or(\"A fresh towel awaits\".into()))).collect(),\n            Screen::Name=>meta::NAMES.iter().enumerate().map(|(n,s)|item(n as u16,(*s).into(),String::new())).collect(),\n            Screen::Look=>vec![item(0,format!(\"Skin tone  {} / 6\",self.look_skin+1),\"Choose what feels like you\".into()),item(1,format!(\"Outfit  ·  {}\",meta::OUTFITS[self.look_outfit as usize].0),\"Eight very relaxed options\".into()),item(2,\"Check in\".into(),\"Your towel is ready\".into())],\n            Screen::Card=>simple(&[\"Let'\"'s try it\\\",\\\"Back to the island\\\"]),\n            Screen::Result=>simple(&[if self.hub.active{\\\"Next event\\\"}else if self.event.kind==Kind::Finale{\\\"Checkout time\\\"}else{\\\"Back to the island\\\"},\\\"Try again\\\"]),\n            Screen::Report=>simple(&[if self.profile.day==5&&\"'!self.profile.free_play{\"The Big Stand awaits\"}else{\"A day on the island\"}]),\n            Screen::Pause=>if self.hub.hub{simple(&[\"Resume\",\"Settings\"])}else{simple(&[\"Resume\",\"Schedule\",\"Calendar\",\"Wardrobe\",\"Settings\",\"How to play\",\"About & credits\",\"Dev mode\",\"Quit to title\"])},\n            Screen::Schedule=>{\n                let mut out:Vec<_>=ROSTER.iter().map(|&k|{let open=self.profile.free_play||k.day()<=self.profile.day;Item{id:100+k as u16,text:k.name().into(),detail:if open{format!(\"{}  ·  {}\",[\"Stillness Studio\",\"Iron Gazebo\",\"Boardwalk\",\"Lagoon\"][(k.day()-1)as usize],if self.profile.clears.contains(&(k as u8)){\"visited today\"}else{\"a mat is waiting\"})}else{format!(\"Opens on day {}\",k.day())},enabled:open,value:None}}).collect();\n                if self.profile.day==5||self.profile.free_play{out.push(item(111,\"The Big Stand\".into(),\"A very small post. A very big occasion.\".into()));}\n                out.push(item(120,if self.profile.free_play{\"Stamp today'\"'s calendar\\\"}else{\\\"End day at your cabana\\\"}.into(),format\"'!(\"{} / {} resort minutes\",self.profile.minutes,meta::goal(self.profile.day))));out\n            },\n            Screen::Settings=>{\n                let s=&self.save.settings;\n                let rows=[(\"Music\",s.music,0.,1.),(\"Sound effects\",s.sfx,0.,1.),(\"Equipment voices\",s.voice,0.,1.),(\"Controller glyphs\",s.xbox as u8 as f32,0.,1.),(\"Lean sensitivity\",s.sensitivity,0.5,1.5),(\"Wobble assist\",s.assist,0.,0.8),(\"Rhythm offset\",s.rhythm,-0.25,0.25),(\"Text speed\",s.text_speed,15.,90.)];\n                let mut out:Vec<_>=rows.iter().enumerate().map(|(n,(name,v,min,max))|Item{id:n as u16,text:(*name).into(),detail:if n==3{if s.xbox{\"Xbox · A B X Y\"}else{\"PlayStation · × ○ □ △\"}.into()}else if n==6{format!(\"{:+.0} ms\",v*1000.)}else if n==7{format!(\"{:.0} letters / second\",v)}else{format!(\"{:.0}%\",v*100.)},enabled:true,value:Some((*v,*min,*max))}).collect();\n                out.push(item(8,\"Fullscreen\".into(),\"F11 also works\".into()));out.push(item(9,\"Reset saved stays\".into(),\"Opens a confirmation\".into()));out.push(item(10,\"Back\".into(),String::new()));out\n            },\n            Screen::Wardrobe=>{\n                let labels=[\"Resort issue\",\"Sun cap\",\"Towel turban\",\"Crown of effort\",\"Personal halo\",\"Sweatbands\",\"Arm floaties\",\"Golden flip-flops\"];\n                labels.iter().enumerate().map(|(n,s)|{let unlocked=n==0||self.profile.total_minutes>=n as u32*4||n==7&&self.profile.flipflops.len()==5;Item{id:n as u16,text:(*s).into(),detail:if n==7{format!(\"{} / 5 lost flip-flops\",self.profile.flipflops.len())}else{format!(\"{} banked minutes\",n*4)},enabled:unlocked,value:None}}).collect()\n            },\n            Screen::Dev=>{let mut a=vec![];match self.dev_tab {\n                0=>{for n in 1..=5{a.push(item(n,format!(\"Jump to day {n}\"),String::new()));}for k in ROSTER.into_iter().chain([Kind::Finale,Kind::Check]){a.push(item(100+k as u16,k.name().into(),\"Jump directly into play\".into()));}for p in 0..5{a.push(item(130+p,format!(\"Finale phase {}\",p+1),String::new()));}a.push(item(150,\"Attract mode\".into(),String::new()));a.push(item(151,\"Local Medley\".into(),String::new()));},\n                1=>{a=simple(&[\"Autoplay with the bot\",\"No tips\",\"Give 10 minutes\",\"Unlock all activities\",\"Award all stars\",\"Skip dialogue\",\"Win activity now\",\"Lose activity now\",\"Reset this guest\"]);for(n,it)in a.iter_mut().enumerate(){if n<2{it.detail=if (n==0&&self.autoplay)||(n==1&&self.no_tips){\"On\"}else{\"Off\"}.into();}}},\n                2=>{a=vec![Item{id:0,text:\"Simulation speed\".into(),detail:format!(\"{:.2}×\",self.time_scale),enabled:true,value:Some((self.time_scale,0.25,4.))},item(1,\"Single activity tick\".into(),\"Advance 1/60 second\".into()),item(2,\"Resume activity\".into(),String::new())];},\n                3=>{a=self.tunables().into_iter().enumerate().map(|(n,(text,v,min,max))|Item{id:n as u16,text:text.into(),detail:format!(\"{v:.3}\"),enabled:true,value:Some((v,min,max))}).collect();a.push(item(99,\"Reset all tuning to defaults\".into(),String::new()));},\n                _=>{a=simple(&[\"Dot trace & input viewer\",\"Ghost lanes\",\"Free camera\",\"Engine statistics\"]);for it in &mut a{it.detail=if self.show_trace{\"On\"}else{\"Off\"}.into();}}\n            }a},\n            Screen::Pass=>simple(&[\"I'\"'m ready\\\"]),Screen::Podium=>if self.hub.hub{vec\"'![]}else{simple(&[\"Back to the resort\"] )},\n            Screen::Ending=>simple(&[\"A small round of credits\"]),Screen::Credits=>simple(&[\"Free Play · stay a little longer\"]),\n            Screen::How|Screen::About=>simple(&[\"Next page\",\"Back\"]),Screen::Reset=>simple(&[\"Keep my stays\",\"Reset all four guests\"]),\n            Screen::Calendar=>simple(&[if self.profile.free_play{\"Back to the island\"}else if self.profile.stamps>=self.profile.day{\"Sleep. Do it all gently tomorrow.\"}else{\"Back to the island\"}]),_=>vec![]\n        }\n    }\n    fn activate(&mut self,id:u16,sim:&mut Sim,events:&mut Vec<SimEvent>){\n        events.push(SimEvent::Sfx{id:1,gain:0.5,pitch:1.});\n        match self.screen {\n            Screen::Title=>match id {0=>self.change(Screen::Guest),1=>{self.together_count=2;self.page=0;self.change(Screen::Pass);self.hub=Medley::default();},2=>{self.return_to=Screen::Title;self.change(Screen::Settings)},3=>{self.return_to=Screen::Title;self.change(Screen::About)},10=>{let absent=self.today.saturating_sub(self.profile.today);if self.profile.free_play||self.profile.check_done{self.to_hub(sim);}else{self.start_day(sim);}if absent>0{self.toast(format!(\"You were away for {absent} days. I did not count them. There were {absent}.\"));}},_=>{}},\n            Screen::Guest=>{self.save.active=id as usize;self.profile=Guest::default();self.change(Screen::Name);},\n            Screen::Name=>{self.profile.name=meta::NAMES[id as usize].into();self.change(Screen::Look)},\n            Screen::Look=>match id {0=>self.look_skin=(self.look_skin+1)%6,1=>self.look_outfit=(self.look_outfit+1)%8,_=>{self.profile.skin=self.look_skin;self.profile.outfit=self.look_outfit;world::guest_look(sim,&self.profile);self.save_change();self.talk(\"PIP\",vec![\"Welcome to Tippy Cay. You have won a complimentary stay. You did not enter.\".into(),\"Five days. Four pavilions. One very patient clam.\".into(),\"Checkout requires a Balance Age of 40 or better. Nobody has asked to leave yet.\".into()],Screen::Card);self.event=Event::new(Kind::Check,self.event.core.phase);}},\n            Screen::Card=>if id==0{self.countdown=3.;self.change(Screen::Countdown)}else{self.to_hub(sim)},\n            Screen::Result=>if id==1&&!self.hub.hub{let k=self.event.kind;self.start_event(k,sim);}else if self.hub.active {self.medley_next(sim)}else if self.event.kind==Kind::Finale{self.profile.stamps=5;self.profile.free_play=true;self.save_change();self.change(Screen::Ending);}else{self.to_hub(sim)},\n            Screen::Report=>if self.profile.day==5&&!self.profile.free_play {self.start_event(Kind::Finale,sim);}else{self.to_hub(sim);self.toast(dialogue::pip(self.profile.day,self.profile.age,self.time as usize));},\n            Screen::Pause=>if self.hub.hub {if id==0{self.change(Screen::Event)}else{self.return_to=Screen::Event;self.change(Screen::Settings)}}else{match id {0=>self.change(self.return_to),1=>self.change(Screen::Schedule),2=>self.change(Screen::Calendar),3=>self.change(Screen::Wardrobe),4=>self.change(Screen::Settings),5=>self.change(Screen::How),6=>self.change(Screen::About),7=>{self.dev_tab=0;self.change(Screen::Dev)},8=>{self.save_change();self.change(Screen::Title)},_=>{}}},\n            Screen::Schedule=>if id>=100&&id<113{let n=(id-100)as usize;let k=ROSTER.get(n).copied().unwrap_or(Kind::Finale);if self.profile.free_play||k.day()<=self.profile.day{self.start_event(k,sim);}}else if id==120{self.end_day(sim,events);},\n            Screen::Calendar=>if self.profile.free_play{self.to_hub(sim);self.save_change();}else if self.profile.stamps>=self.profile.day&&self.profile.day<5{self.profile.day+=1;self.profile.minutes=0;self.profile.clears.clear();self.profile.check_done=false;self.save_change();self.start_day(sim);}else{self.to_hub(sim)},\n            Screen::Settings=>if id==3{self.save.settings.xbox=!self.save.settings.xbox;self.serial+=1;}else if id==9{self.change(Screen::Reset)}else if id==10{self.change(self.return_to)}else if id<8{self.adjust(id,1.)},\n            Screen::Wardrobe=>{self.profile.gear=id as u8;world::guest_look(sim,&self.profile);self.save_change();self.toast(\"Your effort has a new accessory.\");},\n            Screen::How|Screen::About=>if id==0{self.page=(self.page+1)%if self.screen==Screen::How{4}else{self.about_pages.len().max(1)}}else{self.change(self.return_to)},\n            Screen::Dev=>self.dev_action(id,sim,events),\n            Screen::Pass=>if self.hub.active{self.start_event(Kind::Paddle,sim);}else{self.start_medley(self.together_count,false,sim);self.start_event(Kind::Paddle,sim);},\n            Screen::Podium=>{self.hub=Medley::default();self.to_hub(sim)},\n            Screen::Ending=>{self.change(Screen::Credits);self.outcome=Outcome::Won;},\n            Screen::Credits=>{self.outcome=Outcome::Playing;self.to_hub(sim);self.toast(\"Every mat is yours. The clam has cancelled its plans.\");},\n            Screen::Reset=>{if id==1{self.save=Save::default();self.profile=Guest::default();self.serial+=1;}self.change(Screen::Settings)},_=>{}\n        }\n    }\n    fn back(&mut self,sim:&mut Sim){match self.screen {Screen::Title=>{},Screen::Intro=>{self.revealed=10000.;},Screen::Event|Screen::Countdown=>{self.return_to=Screen::Event;self.change(Screen::Pause)},Screen::Settings|Screen::How|Screen::About=>self.change(self.return_to),Screen::Pause=>self.change(self.return_to),Screen::Guest|Screen::Pass if !self.hub.active=>self.change(Screen::Title),Screen::Name=>self.change(Screen::Guest),Screen::Look=>self.change(Screen::Name),Screen::Dev=>self.change(Screen::Pause),_=>self.to_hub(sim)}}\n    fn adjust(&mut self,id:u16,dir:f32){\n        if self.screen==Screen::Look{if id==0{self.look_skin=(self.look_skin as i32+if dir>0.{1}else{5})as u8%6;}else if id==1{self.look_outfit=(self.look_outfit as i32+if dir>0.{1}else{7})as u8%8;}return;}\n        if self.screen==Screen::Pass&&!self.hub.active{self.together_count=(self.together_count as i32+dir.signum()as i32).clamp(2,4)as u8;return;}\n        if self.screen==Screen::Dev {if self.dev_tab==2{self.time_scale=(self.time_scale+dir*0.25).clamp(0.25,4.);}else if self.dev_tab==3{let list=self.tunables();if let Some((_,v,min,max))=list.get(id as usize){self.set_tune(id,(*v+dir*(*max-*min)*0.025).clamp(*min,*max));}}return;}\n        if self.screen!=Screen::Settings{return;}let s=&mut self.save.settings;match id {0=>s.music=(s.music+dir*0.05).clamp(0.,1.),1=>s.sfx=(s.sfx+dir*0.05).clamp(0.,1.),2=>s.voice=(s.voice+dir*0.05).clamp(0.,1.),3=>s.xbox=!s.xbox,4=>s.sensitivity=(s.sensitivity+dir*0.05).clamp(0.5,1.5),5=>s.assist=(s.assist+dir*0.05).clamp(0.,0.8),6=>s.rhythm=(s.rhythm+dir*0.005).clamp(-0.25,0.25),7=>s.text_speed=(s.text_speed+dir*5.).clamp(15.,90.),_=>{}}self.serial+=1;\n    }\n    fn slider(&mut self,id:u16,v:f32){if self.screen==Screen::Settings{let items=self.items();if let Some((_,lo,hi))=items.iter().find(|a|a.id==id).and_then(|it|it.value){let x=v.clamp(lo,hi);let s=&mut self.save.settings;match id{0=>s.music=x,1=>s.sfx=x,2=>s.voice=x,3=>s.xbox=x>0.5,4=>s.sensitivity=x,5=>s.assist=x,6=>s.rhythm=x,7=>s.text_speed=x,_=>{}}self.serial+=1;}}else if self.screen==Screen::Dev{if self.dev_tab==3{self.set_tune(id,v)}else if self.dev_tab==2{self.time_scale=v.clamp(0.25,4.)}}}\n    fn dev_action(&mut self,id:u16,sim:&mut Sim,events:&mut Vec<SimEvent>){match self.dev_tab {\n        0=>{if(1..=5).contains(&id){self.profile.day=id as u8;self.profile.minutes=0;self.profile.clears.clear();self.start_day(sim);}else if(100..113).contains(&id){let k=if id<111{ROSTER[(id-100)as usize]}else if id==111{Kind::Finale}else{Kind::Check};self.start_event(k,sim);self.change(Screen::Event);}else if(130..135).contains(&id){self.start_event(Kind::Finale,sim);self.event.time=[0.,32.,52.,92.,112.][(id-130)as usize];self.change(Screen::Event);}else if id==150{self.start_demo(sim)}else if id==151{self.start_medley(2,false,sim)}},\n        1=>match id {0=>self.autoplay=!self.autoplay,1=>self.no_tips=!self.no_tips,2=>{self.profile.minutes+=10;self.profile.total_minutes+=10;self.save_change()},3=>{self.profile.free_play=true;self.save_change()},4=>{self.profile.stars=99;self.save_change()},5=>self.change(self.return_to),6|7=>{self.event.score=if id==6{1000}else{0};self.event.finished=true;self.finish_event(sim,events)},8=>{self.profile=Guest::default();self.save_change();self.to_hub(sim)},_=>{}},\n        2=>if id==0{self.adjust(0,1.)}else if id==1{let inp=self.event.bot(&self.rules,1./60.);self.event.step(&inp,1./60.,&self.rules,events,world::origin(self.set));}else{self.change(Screen::Event)},\n        3=>if id==99{self.rules=Rules::default()}else{self.adjust(id,1.)},_=>{self.show_trace=!self.show_trace;}\n    }}\n    pub fn tunables(&self)->Vec<(&'\"'static str,f32,f32,f32)> {let r=&self.rules;vec\"'![(\"Core · stiffness\",r.stiffness,10.,80.),(\"Core · damping\",r.damping,2.,20.),(\"Core · reach\",r.reach,0.6,1.2),(\"Core · wobble\",r.wobble,0.,0.4),(\"Core · tip time\",r.tip_time,0.1,1.),(\"Stick response curve\",r.stick_curve,1.,3.),(\"Keyboard lean rate\",r.key_rate,0.5,3.),(\"Keyboard return rate\",r.key_return,0.5,3.),(\"Pose target radius\",r.pose_radius,0.18,0.5),(\"Breath tolerance\",r.breath_tolerance,0.1,0.6),(\"Squat balance band\",r.squat_band,0.1,0.5),(\"Plank ring radius\",r.plank_radius,0.2,0.6),(\"Rhythm perfect window\",r.rhythm_perfect,0.025,0.15),(\"Rhythm good window\",r.rhythm_good,0.07,0.25),(\"Keyboard spin band\",r.spin_band_scale,1.,2.),(\"Jogging pace zone\",r.lap_zone,0.2,0.8),(\"Shell friction\",r.shell_friction,1.,5.),(\"Lagoon gust strength\",r.gust_strength,0.,3.),(\"Tray friction\",r.tray_friction,1.,8.),(\"Dive bounce gain\",r.bounce_gain,0.5,2.),(\"Big Stand gusts\",r.finale_gusts,0.,3.)]}\n    fn set_tune(&mut self,id:u16,v:f32){let list=self.tunables();let Some((_,_,lo,hi))=list.get(id as usize)else{return;};let v=v.clamp(*lo,*hi);let r=&mut self.rules;match id {0=>r.stiffness=v,1=>r.damping=v,2=>r.reach=v,3=>r.wobble=v,4=>r.tip_time=v,5=>r.stick_curve=v,6=>r.key_rate=v,7=>r.key_return=v,8=>r.pose_radius=v,9=>r.breath_tolerance=v,10=>r.squat_band=v,11=>r.plank_radius=v,12=>r.rhythm_perfect=v,13=>r.rhythm_good=v,14=>r.spin_band_scale=v,15=>r.lap_zone=v,16=>r.shell_friction=v,17=>r.gust_strength=v,18=>r.tray_friction=v,19=>r.bounce_gain=v,20=>r.finale_gusts=v,_=>{}}}\n    pub fn camera_yaw(&self)->Option<f32>{if self.screen==Screen::Event&&self.event.kind==Kind::Lap{Some((-self.event.progress*360.).rem_euclid(360.))}else{None}}\n    pub fn status_json(&self,sim:&Sim)->serde_json::Value{\n        let pos=sim.state.player.and_then(|p|sim.feet(p)).unwrap_or_default();\n        json!({\"title\":TITLE,\"screen\":format!(\"{:?}\",self.screen),\"tick\":sim.state.tick,\"focus\":self.focus,\"day\":self.profile.day,\"stamps\":self.profile.stamps,\"age\":self.profile.age,\"minutes\":self.profile.minutes,\"totalMinutes\":self.profile.total_minutes,\"stars\":self.profile.stars,\"event\":self.event.kind.key(),\"eventTime\":self.event.time,\"duration\":self.event.duration,\"score\":self.event.score,\"dot\":self.event.core.cob,\"tips\":self.event.core.tips,\"demo\":self.demo,\"device\":self.device,\"serial\":self.serial,\"save\":self.save,\"settings\":self.save.settings,\"rules\":self.rules,\"timeScale\":self.time_scale,\"aboutPage\":self.page,\"outcome\":self.outcome,\"hub\":{\"score\":self.hub.total+self.event.score,\"done\":self.hub.ended,\"label\":self.event.kind.name(),\"stats\":{\"tips\":self.event.core.tips,\"stars\":meta::stars(self.event.score)},\"ghost\":{\"area\":self.event.kind as u8,\"position\":[pos.x,pos.y,pos.z],\"lean\":self.event.core.cob,\"facing\":0.,\"score\":self.event.score,\"clip\":0,\"clipTime\":self.event.time}}})\n    }\n    pub fn ui(&self,_sim:&Sim)->UiFrame {\n        let mut u=UiFrame{screen:format!(\"{:?}\",self.screen),focus:self.focus,items:self.items(),day:self.profile.day,minutes:self.profile.minutes,minute_goal:meta::goal(self.profile.day),age:self.profile.age,stamps:self.profile.stamps,ages:self.profile.ages.clone(),score:self.event.score,stars:meta::stars(self.event.score),best:self.previous_best,banked:self.banked,time:self.event.time,duration:self.event.duration,dot:self.event.core.cob,target:self.event.target,radius:self.event.radius,guide:self.event.guide,lungs:self.event.lungs,phase:self.event.phase,event:self.event.kind as u8,notes:self.event.notes.iter().map(|n|(n.t,n.lane,n.judged)).collect(),label:self.event.label.clone(),coach:self.event.kind.coach().into(),device:self.device,xbox:self.save.settings.xbox,demo:self.demo,peace:self.event.peace,show_puck:true,blind:self.event.kind==Kind::Check&&self.event.phase==2,trace:if self.show_trace{self.trace.clone()}else{vec![]},debug:self.show_trace,player_name:self.profile.name.clone(),hub:self.hub.hub,page:self.page,pages:1,version:\"PAVILION / TIPPY CAY / 01\".into(),..Default::default()};\n        u.prompt=if self.device==1{if self.save.settings.xbox{\"A  Select     B  Back     ☰  Pause\"}else{\"×  Select     ○  Back     OPTIONS  Pause\"}}else{\"ENTER  Select     ESC  Back     TAB  Schedule\"}.into();\n        match self.screen {\n            Screen::Title=>{u.heading=TITLE.into();u.kicker=\"TIPPY CAY · WELLNESS RESORT\".into();u.subtitle=TAGLINE.into();},\n            Screen::Guest=>{u.heading=\"A towel with your name on it.\".into();u.kicker=\"NEW STAY\".into();u.subtitle=\"Choose a guest card.\".into()},\n            Screen::Name=>{u.heading=\"Who might you be?\".into();u.kicker=\"GUEST REGISTRATION\".into();u.subtitle=\"Our names are pre-relaxed for your convenience.\".into()},\n            Screen::Look=>{u.heading=format!(\"Hello, {}.\",self.profile.name);u.kicker=\"MAKE YOURSELF COMFORTABLE\".into();u.subtitle=\"Arrive exactly as you are. Or in lilac.\".into()},\n            Screen::Hub=>{u.heading=\"Tippy Cay\".into();u.kicker=if self.profile.free_play{\"FREE PLAY\".into()}else{format!(\"DAY {} OF 5\",self.profile.day)};u.subtitle=if self.message_time>0.{self.message.clone()}else{\"A small island. A surprisingly thorough schedule.\".into()};u.label=self.nearest.map(|n|world::INTERACTIONS[n].0.to_string()).unwrap_or(\"Walk · discover · wobble gently\".into());},\n            Screen::Intro=>{u.coach=self.speaker.clone();u.dialogue=self.dialogue.get(self.dialog_index).cloned().unwrap_or_default();u.revealed=self.revealed as usize;},\n            Screen::Card|Screen::Countdown|Screen::Event=>{u.heading=self.event.kind.name().into();u.kicker=if self.event.kind==Kind::Check{\"YOUR DAILY RITUAL\"}else{[\"\",\"STILLNESS STUDIO\",\"IRON GAZEBO\",\"BOARDWALK\",\"LAGOON\",\"LAGOON\",\"LAGOON\",\"LAGOON\",\"THE BAY\"][self.set]}.into();u.subtitle=self.event.kind.goal().into();u.countdown=self.countdown.ceil()as i32;u.lines=vec![dialogue::coach(self.event.kind,self.profile.day,self.event.time as usize)];if self.screen==Screen::Event{u.prompt=self.event_prompt();}},\n            Screen::Result=>{u.heading=self.result_title.clone();u.kicker=\"A SMALL ACHIEVEMENT\".into();u.subtitle=if self.event.kind==Kind::Squat{\"Ten. Also eleven.\".into()}else{dialogue::coach(self.event.kind,self.profile.day,self.event.score as usize)};u.lines=vec![self.event.kind.name().into(),if self.event.score>self.previous_best{\"A personal best. Please remain calm.\".into()}else{format!(\"Yesterday You: {:+}\",self.event.score as i32-self.previous_best as i32)}];},\n            Screen::Report=>{u.heading=\"Your Balance Age\".into();u.kicker=\"MORNING WOBBLE CHECK\".into();u.subtitle=dialogue::pip(self.profile.day,self.profile.age,self.profile.age as usize);},\n            Screen::Schedule=>{u.heading=\"Absolutely no rush.\".into();u.kicker=\"TODAY'\"'S POSSIBILITIES\\\".into();u.subtitle=\\\"Pick a mat. We'll take you there.\\\".into()},\n            Screen::Pause=>{u.heading=\\\"A moment, please.\\\".into();u.kicker=\\\"PAUSED\\\".into();u.subtitle=if self.hub.hub{\\\"The medley clock keeps running.\\\"}else{\\\"Pausing is not an exercise. Pip checked.\\\"}.into()},\n            Screen::Calendar=>{u.heading=\\\"You showed up.\\\".into();u.kicker=\\\"YOUR FIVE LITTLE DAYS\\\".into();u.subtitle=\\\"That counts. The stamp is quite firm about it.\\\".into()},\n            Screen::Settings=>{u.heading=\\\"A little adjustment.\\\".into();u.kicker=\\\"SETTINGS\\\".into();u.subtitle=\\\"Left / right to change. Everything in moderation.\\\".into()},\n            Screen::Wardrobe=>{u.heading=\\\"Effort, accessorised.\\\".into();u.kicker=\\\"THE TOWEL CUPBOARD\\\".into();u.subtitle=\\\"Bank minutes. Acquire increasingly formal headwear.\\\".into()},\n            Screen::How=>{let pages=[(\\\"Small movements. Big consequences.\\\",vec\"'![\"Lean with the left stick, WASD or the mouse. Hold Shift for a finer nudge.\".into(),\"Your coral dot is your balance. Keep it in the mint target. Less is often plenty.\".into()]),(\"A very pleasant routine.\",vec![\"Start with Pip'\"'s Morning Wobble Check. Then visit the mats or open the Schedule.\\\".into(),\\\"First clears bank 1 + stars in resort minutes. Meet your daily goal, then sleep.\\\".into()]),(\\\"Bring all your feet.\\\",vec\"'![\"Cross / Space / click is Action. Shoulder buttons / Q and E are left and right steps.\".into(),\"Hold both steps to brace. Triangle / Tab opens Schedule. Options / Esc pauses.\".into()]),(\"Some things are better shared.\",vec![\"Play Together passes one pad between 2–4 guests. Three lagoon events decide the medley.\".into(),\"From day 3, Yesterday You practises beside you. At checkout: Balance Age 40 or better.\".into()])];let (h,l)=&pages[self.page%4];u.heading=(*h).into();u.kicker=\"HOW TO WOBBLE\".into();u.lines=l.clone();u.pages=4;},\n            Screen::About=>{if let Some((h,l))=self.about_pages.get(self.page%self.about_pages.len().max(1)){u.heading=h.clone();u.lines=l.clone();}else{u.heading=\"Made with a little wobble.\".into();u.lines=vec![\"Source: Wii Fit · Plan: PLAN.md · Sports · third person\".into(),\"Original Tippy Cay resort. Pavilion / Rust / WebAssembly / WebGPU / egui.\".into(),\"All music, effects and equipment voices are synthesised in code.\".into()];}u.kicker=\"ABOUT & CREDITS\".into();u.pages=self.about_pages.len().max(1);},\n            Screen::Dev=>{u.heading=[\"Jump anywhere\",\"A small unfair advantage\",\"Time, loosely speaking\",\"Find the sweet spot\",\"Look a little closer\"][self.dev_tab].into();u.kicker=format!(\"DEV MODE · {} / 5 · Q / E TABS\",self.dev_tab+1);u.subtitle=\"Changes apply live. Reset tuning restores the authored rules.\".into()},\n            Screen::Pass=>{u.heading=if self.hub.active{format!(\"Your turn, {}.\",self.hub.names.get(self.hub.seat as usize).unwrap_or(&self.profile.name))}else{format!(\"{} guests. One very patient pad.\",self.together_count)};u.kicker=\"INTER-RESORT MEDLEY\".into();u.subtitle=if self.hub.active{\"Pass the controller. The lagoon is waiting.\"}else{\"Left / right to choose 2–4 guests. Paddle · tide pools · cannonball.\"}.into()},\n            Screen::Podium=>{u.heading=\"Everyone stood for something.\".into();u.kicker=\"MEDLEY COMPLETE\".into();let mut results:Vec<_>=self.hub.scores.iter().enumerate().collect();results.sort_by_key(|(_,s)|std::cmp::Reverse(**s));u.lines=results.iter().enumerate().map(|(place,(seat,score))|format!(\"{}. {}    {}\",place+1,self.hub.names.get(*seat).unwrap_or(&self.profile.name),score)).collect();u.subtitle=\"A tasteful amount of applause.\".into()},\n            Screen::Ending=>{u.heading=if self.profile.age<=40{\"Permission to drift.\"}else{\"An extended opportunity.\"}.into();u.kicker=if self.profile.age<=40{\"CHECKOUT APPROVED\"}else{\"EXTENDED STAY\"}.into();u.subtitle=if self.profile.age<=40{\"Your rowboat is ready. Your towel is emotionally unavailable.\"}else{\"The resort would love you to stay. It has already moved your suitcase back.\"}.into();u.lines=vec![if self.event.peace{\"Inner Peace bonus · you accepted absolutely nothing.\"}else{\"Pip has filed your skip request under '\"'interesting'.\\\"}.into(),\\\"…Oh. You're still here. Good.\\\".into()];},\n            Screen::Credits=>{u.heading=\\\"Thank you for being here.\\\".into();u.kicker=TITLE.to_uppercase();u.subtitle=\\\"Every activity is now open. Your towel remains reserved.\\\".into();u.lines=vec\"'![\"Tippy Cay staff: Pip · Posey · Big Kettle · Bounce · Commodore Gull\".into(),\"With Marjorie, Two-Towel Tom, the Twins, and one entirely uninvited bird.\".into(),\"Engine, sources and production feedback: Pause → About & credits.\".into()];},\n            Screen::Reset=>{u.heading=\"Unstamp everything?\".into();u.kicker=\"RESET SAVED STAYS\".into();u.subtitle=\"This clears all four guest cards and their progress.\".into()},\n        }\n        u\n    }\n    fn event_prompt(&self)->String {let act=if self.device==1{if self.save.settings.xbox{\"A\"}else{\"×\"}}else if self.device==2{\"LMB\"}else{\"SPACE\"};let steps=if self.device==1{if self.save.settings.xbox{\"LB / RB\"}else{\"L1 / R1\"}}else if self.device==2{\"LMB / RMB\"}else{\"Q / E\"};match self.event.effective().0{Kind::Breath=>format!(\"{act}  Hold to inhale · release to exhale\"),Kind::Squat=>format!(\"{act}  Hold to lower · release to rise\"),Kind::Plank=>format!(\"{steps}  Hold both to brace\"),Kind::Step|Kind::Lap=>format!(\"{steps}  Left / right steps\"),Kind::Dive=>format!(\"{act}  Bounce · hold to tuck\"),Kind::Spin=>format!(\"Circle your lean     {steps}  Catch\"),Kind::Finale=>\"Thirty seconds. Just you.\".into(),_=>if self.device==1{\"LEFT STICK  Lean gently\"}else{\"WASD / MOUSE  Lean gently\"}.into()}}\n}\nimpl Game for FitGame {\n    const KEY:&'\"'static str=\\\"fit\\\";\n    fn frozen(&self)->bool{if self.hub.hub&&self.hub.go{return false;}\"'!matches!(self.screen,Screen::Hub|Screen::Event|Screen::Countdown)}\n    fn pre(&mut self,sim:&mut Sim,raw:&InputFrame,dt:f32,events:&mut Vec<SimEvent>)->BTreeMap<EntityId,InputFrame>{\n        self.time+=dt;self.screen_time+=dt;self.message_time=(self.message_time-dt).max(0.);\n        if raw.any||raw.pressed!=0||raw.ui.is_some(){self.device=raw.device;}\n        if raw.hub_end{self.hub.ended=true;}if raw.down(b::HUB_GO){self.hub.go=true;}\n        let gains=[self.save.settings.music,self.save.settings.sfx,self.save.settings.voice];if gains!=self.last_gain{events.push(SimEvent::AudioGains{music:gains[0],sfx:gains[1],voice:gains[2]});self.last_gain=gains;}\n        let song=if self.screen==Screen::Event||self.screen==Screen::Countdown||self.screen==Screen::Card{if self.event.kind==Kind::Finale&&self.event.time>=112.{0}else{self.event.kind.song()}}else{1};\n        let song=if self.hub.ended {0}else{song};if song!=self.last_music{events.push(SimEvent::Music{song});self.last_music=song;}\n        let any=raw.any||raw.pressed!=0||raw.lean.length()>0.3||matches!(raw.ui,Some(UiEvent::Click(_)));\n        if self.demo&&any {self.end_demo(sim);return sim.state.player.map(|id|(id,InputFrame::default())).into_iter().collect();}\n        if matches!(self.screen,Screen::Title|Screen::Guest|Screen::Name|Screen::Look|Screen::Pass|Screen::About|Screen::How|Screen::Settings)&&!self.hub.active{\n            self.idle=if any{0.}else{self.idle+dt};if self.idle>=10.&&!self.demo{self.start_demo(sim);}}\n        if self.demo {self.demo_time+=dt;let order=[Kind::Dive,Kind::Paddle,Kind::Step,Kind::Pose,Kind::Tide,Kind::Spin,Kind::Tray,Kind::Plank,Kind::Lap,Kind::Finale];if self.demo_time>15.{self.demo_time=0.;self.demo_index=(self.demo_index+1)%order.len();self.start_event(order[self.demo_index],sim);if order[self.demo_index]==Kind::Finale{self.event.time=92.;}self.change(Screen::Event);}}\n        let mut input=if (self.demo||self.autoplay)&&self.screen==Screen::Event{self.event.bot(&self.rules,dt*self.time_scale)}else{*raw};\n        input.lean*=self.save.settings.sensitivity;input.lean=input.lean.clamp_length_max(1.);\n        if self.hub.hub&&(!self.hub.go||self.hub.ended){return sim.state.player.map(|id|(id,InputFrame::default())).into_iter().collect();}\n        if input.just(b::PAUSE)&&!self.demo{if self.screen==Screen::Pause{self.change(self.return_to);}else{self.return_to=self.screen;self.change(Screen::Pause)}}\n        else if input.just(b::SCHEDULE)&&!self.hub.hub&&!self.demo{if self.screen==Screen::Hub{self.change(Screen::Schedule);}else if self.screen==Screen::Schedule{self.to_hub(sim);}}\n        else if input.just(b::BACK)&&!self.demo {self.back(sim);}\n        else if self.screen==Screen::Intro {\n            let line=self.dialogue.get(self.dialog_index).cloned().unwrap_or_default();let old=self.revealed as usize;self.revealed+=dt*self.save.settings.text_speed;\n            if self.revealed as usize/3>old/3&&(old<line.chars().count()){let letter=line.chars().nth(old).unwrap_or('\"'a');let vowel=\\\"aeiou\\\".find(letter.to_ascii_lowercase()).unwrap_or(old%5)as u8;let speaker=match self.speaker.as_str(){\\\"POSEY\\\"=>1,\\\"BIG KETTLE\\\"=>2,\\\"BOUNCE\\\"=>3,\\\"COMMODORE GULL\\\"=>4,_=>0};events.push(SimEvent::Syllable{speaker,vowel,pitch:if letter=='?'{1.2}else if letter=='.'{0.8}else{1.}});}\n            if input.just(b::CONFIRM)||matches\"'!(input.ui,Some(UiEvent::Click(_))){if self.revealed<line.chars().count()as f32{self.revealed=10000.;}else{self.dialog_index+=1;self.revealed=0.;if self.dialog_index>=self.dialogue.len(){if self.return_to==Screen::Card{self.start_day(sim);}else{self.change(self.return_to);}}}}\n        }else if self.screen==Screen::Countdown {self.countdown-=dt;if self.countdown<=0.{self.change(Screen::Event);self.last_music=255;}}\n        else if self.screen==Screen::Event||(self.hub.hub&&matches!(self.screen,Screen::Pause|Screen::Settings)){\n            if self.hub.hub&&self.event.finished {if self.screen_time>1.{self.medley_next(sim);}}\n            else {\n                let mut rules=self.rules.clone();rules.wobble*=1.-self.save.settings.assist;\n                if self.no_tips{self.event.core.outside=0.;}\n                self.event.step(&input,dt*self.time_scale,&rules,events,world::origin(self.set));\n                world::animate(sim,&self.event,&mut self.props,self.set,dt*self.time_scale);\n                if self.show_trace{self.trace.push(self.event.core.cob);if self.trace.len()>180{self.trace.remove(0);}}\n                if self.event.time>=self.event.record_at{self.event.record_at+=0.1;if let Some(pid)=sim.state.player {if let Some(p)=sim.feet(pid){let a=sim.state.entities.get(pid).and_then(|e|e.character.as_ref()).map(|c|c.anim).unwrap_or_default();self.event.ghost.push(events::GhostPoint{t:self.event.time,pos:p-world::origin(self.set),lean:self.event.core.cob,facing:a.facing,clip:a.clip,clip_t:a.clip_t,score:self.event.score});}}}\n                if self.event.finished&&!self.demo{if self.hub.hub{self.hub.total+=self.event.score;self.medley_next(sim);}else{self.finish_event(sim,events);}}\n            }\n        }else if self.screen==Screen::Hub {self.hub_input(sim,&input,dt,events);}\n        else if !self.demo {\n            let items=self.items();if !items.is_empty(){\n                let prev=self.focus;\n                if input.just(b::MENU_UP){self.focus=self.focus.checked_sub(1).unwrap_or(items.len()-1);}\n                if input.just(b::MENU_DOWN){self.focus=(self.focus+1)%items.len();}\n                if self.screen==Screen::Dev&&(input.just(b::TAB_L)||input.just(b::TAB_R)){self.dev_tab=(self.dev_tab+if input.just(b::TAB_R){1}else{4})%5;self.focus=0;}\n                if input.just(b::MENU_LEFT)||input.just(b::MENU_RIGHT){let dir=if input.just(b::MENU_RIGHT){1.}else{-1.};if matches!(self.screen,Screen::How|Screen::About){self.page=(self.page+if dir>0.{1}else{self.about_pages.len().max(1)-1})%if self.screen==Screen::How{4}else{self.about_pages.len().max(1)};}else{self.adjust(items[self.focus.min(items.len()-1)].id,dir);}}\n                if let Some(ui)=input.ui {match ui {UiEvent::Hover(id)=>{if let Some(n)=items.iter().position(|it|it.id==id){self.focus=n;}},UiEvent::Click(id)=>{if items.iter().any(|it|it.id==id&&it.enabled){self.activate(id,sim,events)}},UiEvent::Slider(id,v)=>self.slider(id,v)}}\n                else if input.just(b::CONFIRM){let it=&items[self.focus.min(items.len()-1)];if it.enabled{self.activate(it.id,sim,events);}}\n                if prev!=self.focus{events.push(SimEvent::Sfx{id:0,gain:0.35,pitch:1.});}\n            }\n        }\n        if matches!(self.screen,Screen::Look|Screen::Wardrobe){let mut p=self.profile.clone();p.skin=self.look_skin;p.outfit=self.look_outfit;world::guest_look(sim,&p);}\n        let mut out=BTreeMap::new();if let Some(pid)=sim.state.player{let mut movement=InputFrame::default();if self.screen==Screen::Hub {if let Some(goal)=self.way_to {if let Some(p)=sim.feet(pid){let d=Vec2::new(goal.x-p.x,goal.z-p.z);movement.move_dir=d.normalize_or_zero()*if d.length()<0.4{0.}else{1.};if d.length()<0.5{self.way_to=None;if let Some(n)=self.interact_goal.take(){self.interact(n,sim,events);}}}}else{movement.move_dir=input.move_dir;}}out.insert(pid,movement);}\n        out\n    }\n    fn outcome(&self)->Outcome{self.outcome}\n    fn status(&self,sim:&Sim)->serde_json::Value{self.status_json(sim)}\n    fn bot(&self,_sim:&Sim)->InputFrame {\n        if self.screen==Screen::Event{return self.event.bot(&self.rules,1./60.*self.time_scale);}\n        if self.screen==Screen::Countdown{return InputFrame::default();}\n        let mut i=InputFrame::default();i.pressed=b::CONFIRM;i.held=b::CONFIRM;\n        if self.screen==Screen::Hub{\n            let wanted=ROSTER.iter().find(|&&k|k.day()==self.profile.day&&!self.profile.clears.contains(&(k as u8)));\n            if wanted.is_some(){i.pressed=b::SCHEDULE;i.held=b::SCHEDULE;}else{i.ui=Some(UiEvent::Click(120));i.pressed=b::SCHEDULE;}\n        }else if self.screen==Screen::Schedule{let wanted=ROSTER.iter().find(|&&k|k.day()==self.profile.day&&!self.profile.clears.contains(&(k as u8)));i.ui=Some(UiEvent::Click(wanted.map(|k|100+*k as u16).unwrap_or(120)));}\n        else if self.screen==Screen::Title{i.ui=Some(UiEvent::Click(0));}\n        else if self.screen==Screen::Look{i.ui=Some(UiEvent::Click(2));}\n        i\n    }\n}\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"cat > engine/crates/pav_core/src/games/fit/meta.rs <<'EOF'\nuse serde::{Deserialize,Serialize};\nuse super::events::GhostPoint;\n#[derive(Clone,Debug,Serialize,Deserialize)]\n#[serde(default)]\npub struct Settings {pub music:f32,pub sfx:f32,pub voice:f32,pub xbox:bool,pub sensitivity:f32,pub assist:f32,pub rhythm:f32,pub text_speed:f32}\nimpl Default for Settings {fn default()->Self{Self{music:0.10,sfx:0.8,voice:0.8,xbox:false,sensitivity:1.,assist:0.,rhythm:0.10,text_speed:45.}}}\n#[derive(Clone,Debug,Default,Serialize,Deserialize)]\npub struct Best {pub score:u32,pub stars:u8,pub ghost:Vec<GhostPoint>}\n#[derive(Clone,Debug,Serialize,Deserialize)]\n#[serde(default)]\npub struct Guest {pub name:String,pub skin:u8,pub outfit:u8,pub gear:u8,pub day:u8,pub minutes:u32,pub total_minutes:u32,pub stars:u32,pub stamps:u8,pub ages:Vec<u8>,pub age:u8,pub today:u32,pub clears:Vec<u8>,pub bests:Vec<Best>,pub flipflops:Vec<u8>,pub free_play:bool,pub check_done:bool,pub titles:Vec<String>}\nimpl Default for Guest {fn default()->Self{Self{name:\\\"Sunny Sideup\\\".into(),skin:2,outfit:0,gear:0,day:1,minutes:0,total_minutes:0,stars:0,stamps:0,ages:vec\"'![],age:61,today:0,clears:vec![],bests:vec![Best::default();13],flipflops:vec![],free_play:false,check_done:false,titles:vec![]}}}\n#[derive(Clone,Debug,Serialize,Deserialize)]\n#[serde(default)]\npub struct Save {pub version:u32,pub active:usize,pub guests:Vec<Option<Guest>>,pub settings:Settings}\nimpl Default for Save {fn default()->Self{Self{version:1,active:0,guests:vec![None;4],settings:Settings::default()}}}\npub const NAMES:[&str;40]=[\"Sunny Sideup\",\"Pat Balance\",\"Olive Still\",\"Robin Wobbles\",\"Sandy Knees\",\"Bea Present\",\"Lou Sway\",\"Finn Floating\",\"Penny Loafer\",\"Art Standing\",\"Kit Nap\",\"Terry Towels\",\"Al Fresco\",\"Dee Breeze\",\"Sal T. Air\",\"Joy Stick\",\"Gail Force\",\"Sid Down\",\"Anita Rest\",\"Mo Mentum\",\"Ray O'\"'Sun\\\",\\\"Cora Reef\\\",\\\"Bo Breathe\\\",\\\"Nora Rush\\\",\\\"Mel Low\\\",\\\"Ari Relax\\\",\\\"Lee N. Left\\\",\\\"Will Sway\\\",\\\"Dot Centre\\\",\\\"Tina Tiptoe\\\",\\\"Stu D. O\\\",\\\"May B. Later\\\",\\\"Cam Down\\\",\\\"Rae D. O\\\",\\\"Aqua Velva\\\",\\\"Drew A. Breath\\\",\\\"Clam Chowder\\\",\\\"Pearl Diver\\\",\\\"Wade Ashore\\\",\\\"Ira Gently\\\"];\npub const SKINS:[&str;6]=[\\\"#f3d5bc\\\",\\\"#e4b58e\\\",\\\"#cf946e\\\",\\\"#ac765a\\\",\\\"#86583e\\\",\\\"#5d3c30\\\"];\npub const OUTFITS:[(&str,&str);8]=[(\\\"Lagoon club\\\",\\\"#46bec8\\\"),(\\\"Coral society\\\",\\\"#ff8b7f\\\"),(\\\"Lemon lounge\\\",\\\"#edca69\\\"),(\\\"Palm reader\\\",\\\"#92bc80\\\"),(\\\"Lilac hour\\\",\\\"#b9a9d8\\\"),(\\\"Cloud guest\\\",\\\"#faf6ec\\\"),(\\\"Deep sea\\\",\\\"#4d7998\\\"),(\\\"Sunset stay\\\",\\\"#ce997d\\\")];\npub fn age(skill:[f32;4],days:u8,stars:u32)->u8 {let s=skill[0]*0.30+skill[1]*0.25+skill[2]*0.25+skill[3]*0.20;(24.+56.*(1.-s.clamp(0.,1.)).powf(1.1)-2.*days as f32-(stars as f32/3.).min(8.)).round().clamp(18.,99.)as u8}\npub fn stars(score:u32)->u8 {if score>=850{3}else if score>=650{2}else if score>=400{1}else{0}}\npub fn goal(day:u8)->u32 {[3,5,7,9,0][(day.saturating_sub(1)as usize).min(4)]}\nEOF\ncat > engine/crates/pav_core/src/games/fit/ui_model.rs <<'EOF'\nuse glam::Vec2;\n#[derive(Clone,Debug,Default)]\npub struct Item {pub id:u16,pub text:String,pub detail:String,pub enabled:bool,pub value:Option<(f32,f32,f32)>}\n#[derive(Clone,Debug,Default)]\npub struct UiFrame {\n    pub screen:String,pub heading:String,pub kicker:String,pub subtitle:String,pub lines:Vec<String>,pub items:Vec<Item>,pub focus:usize,\n    pub day:u8,pub minutes:u32,pub minute_goal:u32,pub age:u8,pub stamps:u8,pub ages:Vec<u8>,pub score:u32,pub stars:u8,pub best:u32,pub banked:u32,\n    pub time:f32,pub duration:f32,pub dot:Vec2,pub target:Vec2,pub radius:f32,pub guide:f32,pub lungs:f32,pub phase:u8,pub event:u8,\n    pub notes:Vec<(f32,u8,bool)>,pub label:String,pub coach:String,pub dialogue:String,pub revealed:usize,pub countdown:i32,\n    pub device:u8,pub xbox:bool,pub demo:bool,pub touch:bool,pub peace:bool,pub show_puck:bool,pub blind:bool,pub trace:Vec<Vec2>,\n    pub debug:bool,pub player_name:String,pub prompt:String,pub version:String,pub hub:bool,pub page:usize,pub pages:usize,\n}\nEOF\ncat > engine/crates/pav_core/src/games/fit/mod.rs <<'EOF'\n//\"'! Wobble Wit'\"'s deterministic resort, menus and activity dispatcher.\npub mod core;pub mod events;pub mod meta;pub mod ui_model;mod charts;mod world;mod dialogue;\nuse std::{collections::BTreeMap,sync::Arc};\nuse anyhow::Result;\nuse glam::{Vec2,Vec3};\nuse serde::{Serialize,Deserialize};\nuse serde_json::json;\nuse crate::{sim::Sim,input::{InputFrame,UiEvent,buttons as b},frame::SimEvent,entity::EntityId};\nuse super::{Game,GameBox,Outcome};\nuse events::{Kind,Event,ROSTER};use meta::{Guest,Save};use ui_model::{UiFrame,Item};\npub const TITLE:&str=\\\"Wobble Wit\\\";\npub const TAGLINE:&str=\\\"A little less wobble. A little more you.\\\";\n#[derive(Clone,Debug,Serialize,Deserialize)]\n#[serde(default)]\npub struct Rules {\n    pub stiffness:f32,pub damping:f32,pub reach:f32,pub wobble:f32,pub tip_time:f32,pub stick_curve:f32,pub key_rate:f32,pub key_return:f32,\n    pub pose_radius:f32,pub breath_tolerance:f32,pub squat_band:f32,pub plank_radius:f32,pub rhythm_perfect:f32,pub rhythm_good:f32,\n    pub spin_band_scale:f32,pub lap_zone:f32,pub shell_friction:f32,pub gust_strength:f32,pub tray_friction:f32,pub bounce_gain:f32,pub finale_gusts:f32,\n}\nimpl Default for Rules {fn default()->Self {toml::from_str(include_str\"'!(\"rules.toml\")).expect(\"rules defaults\")}}\n#[derive(Clone,Copy,Debug,Default,PartialEq,Eq,Serialize,Deserialize)]\npub enum Screen {#[default]Title,Guest,Name,Look,Intro,Hub,Card,Countdown,Event,Result,Report,Schedule,Calendar,Pause,Settings,Wardrobe,How,About,Dev,Pass,Podium,Ending,Credits,Reset}\n#[derive(Clone,Debug,Default,Serialize,Deserialize)]\npub struct Medley {pub active:bool,pub players:u8,pub seat:u8,pub round:u8,pub scores:Vec<u32>,pub names:Vec<String>,pub runs:Vec<Vec<events::GhostPoint>>,pub total:u32,pub hub:bool,pub go:bool,pub ended:bool}\n#[derive(Clone,Serialize,Deserialize)]\npub struct FitGame {\n    pub rules:Rules,pub screen:Screen,pub return_to:Screen,pub focus:usize,pub page:usize,pub time:f32,pub screen_time:f32,pub idle:f32,\n    pub profile:Guest,pub save:Save,pub serial:u32,pub today:u32,pub event:Event,pub countdown:f32,pub direct:bool,pub outcome:Outcome,\n    pub dialogue:Vec<String>,pub dialog_index:usize,pub revealed:f32,pub speaker:String,pub message:String,pub message_time:f32,\n    pub result_title:String,pub banked:u32,pub previous_best:u32,pub demo:bool,pub demo_index:usize,pub demo_time:f32,pub device:u8,\n    pub hub:Medley,pub together_count:u8,pub dev_tab:usize,pub autoplay:bool,pub no_tips:bool,pub time_scale:f32,pub show_trace:bool,pub trace:Vec<Vec2>,\n    pub way_to:Option<Vec3>,pub interact_goal:Option<usize>,pub nearest:Option<usize>,pub props:world::Actors,pub set:usize,pub last_gain:[f32;3],\n    pub about:serde_json::Value,pub look_skin:u8,pub look_outfit:u8,pub about_pages:Vec<(String,Vec<String>)>,pub last_music:u8,\n}\npub fn build(sim:&mut Sim,rest:Option<&str>)->Result<()> {\n    let props=world::build(sim)?;\n    let rules:Rules=toml::from_str(&super::level_text(\"fit/rules\",include_str!(\"rules.toml\")))?;\n    let phases=[sim.state.rng.range(0.,6.28),sim.state.rng.range(0.,6.28),sim.state.rng.range(0.,6.28),sim.state.rng.range(0.,6.28)];\n    let mut g=FitGame{rules,screen:Screen::Title,return_to:Screen::Hub,focus:0,page:0,time:0.,screen_time:0.,idle:0.,profile:Guest::default(),save:Save::default(),serial:0,today:0,event:Event::new(Kind::Pose,phases),countdown:3.,direct:false,outcome:Outcome::Playing,dialogue:vec![],dialog_index:0,revealed:0.,speaker:\"PIP\".into(),message:String::new(),message_time:0.,result_title:String::new(),banked:0,previous_best:0,demo:false,demo_index:0,demo_time:0.,device:0,hub:Medley::default(),together_count:2,dev_tab:0,autoplay:false,no_tips:false,time_scale:1.,show_trace:false,trace:vec![],way_to:None,interact_goal:None,nearest:None,props,set:0,last_gain:[-1.;3],about:json!({}),look_skin:2,look_outfit:0,about_pages:vec![],last_music:255};\n    if let Some(rest)=rest {if let Some(key)=rest.strip_prefix(\"event/\"){if let Some(kind)=Kind::from_key(key){g.direct=true;g.start_event(kind,sim);g.screen=Screen::Event;}}\n        else if rest==\"medley\"{g.start_medley(1,true,sim);g.hub.go=false;}\n        else if rest==\"hub\"{g.screen=Screen::Hub;g.profile.free_play=true;g.profile.day=5;g.profile.check_done=true;}\n        else if rest==\"attract\"{g.start_demo(sim);}}\n    sim.state.play=Some(GameBox::new(g));Ok(())\n}\nimpl FitGame {\n    pub fn load_save(&mut self,text:&str,today:u32){self.today=today;if let Ok(s)=serde_json::from_str::<Save>(text){if s.version==1&&s.guests.len()==4&&s.active<4{self.save=s;if let Some(p)=self.save.guests[self.save.active].clone(){self.profile=p;}self.look_skin=self.profile.skin;self.look_outfit=self.profile.outfit;}}}\n    pub fn set_about(&mut self,v:serde_json::Value){\n        self.about=v.clone();self.about_pages.clear();\n        if let Some(info)=v.get(\"sourceInformation\").and_then(|v|v.as_object()) {let mut lines=vec![];for key in [\"date\",\"source\",\"plan\",\"genre\",\"perspective\",\"tech\",\"artDirection\",\"animation\",\"audio\",\"online\",\"testing\",\"research\",\"environment\",\"model\",\"usage\"]{if let Some(value)=info.get(key).and_then(|v|v.as_str()){lines.push(format!(\"{}: {}\",key,value));}}\n            for chunk in lines.chunks(4){self.about_pages.push((\"Source Information\".into(),chunk.to_vec()));}}\n        for (key,title)in[(\"testingFeedback\",\"Testing Feedback\"),(\"engineFeedback\",\"Engine Feedback\"),(\"promptFeedback\",\"Prompt Feedback\")] {if let Some(a)=v.get(key).and_then(|v|v.as_array()){for chunk in a.chunks(2){self.about_pages.push((title.into(),chunk.iter().filter_map(|s|s.as_str().map(String::from)).collect()));}}}\n        self.about_pages.push((\"Made with a little wobble\".into(),vec![\"Pavilion engine · Michael Crosato · original resort art and FIT motion clips.\".into(),\"Fredoka by Milena Brandão; Nunito by Vernon Adams and contributors · SIL Open Font License.\".into(),\"Motion libraries: CMU (research motion data), Mesh2Motion and Quaternius (CC0), STYLE100 (see source credit). Full notices in source engine/store/CREDITS.md.\".into()]));\n    }\n    pub fn change(&mut self,s:Screen){self.screen=s;self.focus=0;self.page=0;self.screen_time=0.;}\n    fn save_change(&mut self){if self.demo||self.hub.active{return;}self.profile.today=self.today;self.save.guests[self.save.active]=Some(self.profile.clone());self.serial+=1;}\n    fn toast(&mut self,line:impl Into<String>){self.message=line.into();self.message_time=5.;}\n    fn talk(&mut self,speaker:&str,lines:Vec<String>,next:Screen){self.speaker=speaker.into();self.dialogue=lines;self.dialog_index=0;self.revealed=0.;self.return_to=next;self.change(Screen::Intro);}\n    pub fn start_event(&mut self,kind:Kind,sim:&mut Sim){\n        let phases=[sim.state.rng.range(0.,6.28),sim.state.rng.range(0.,6.28),sim.state.rng.range(0.,6.28),sim.state.rng.range(0.,6.28)];\n        self.event=Event::new(kind,phases);if self.profile.day>=3 {self.event.best_ghost=self.profile.bests.get(kind as usize).map(|b|b.ghost.clone()).unwrap_or_default();}\n        self.countdown=3.;self.set=kind.set();self.trace.clear();self.way_to=None;self.nearest=None;world::set(sim,self.set);self.change(Screen::Card);\n    }\n    fn to_hub(&mut self,sim:&mut Sim){self.set=0;world::set(sim,0);self.change(Screen::Hub);self.way_to=None;}\n    fn start_day(&mut self,sim:&mut Sim){self.start_event(Kind::Check,sim);}\n    fn start_medley(&mut self,n:u8,online:bool,sim:&mut Sim){self.hub=Medley{active:true,players:n,hub:online,scores:vec![],names:(0..n).map(|i|if i==0{self.profile.name.clone()}else{meta::NAMES[(i as usize*7)%40].into()}).collect(),go:!online,..Default::default()};self.hub.runs=vec![];self.start_event(Kind::Paddle,sim);if online {self.change(Screen::Event);}else{self.change(Screen::Pass);}}\n    fn start_demo(&mut self,sim:&mut Sim){self.demo=true;self.demo_index=0;self.demo_time=0.;self.start_event(Kind::Dive,sim);self.change(Screen::Event);}\n    fn end_demo(&mut self,sim:&mut Sim){self.demo=false;self.idle=0.;self.set=0;world::set(sim,0);self.change(Screen::Title);self.last_music=255;}\n    fn finish_event(&mut self,sim:&mut Sim,events:&mut Vec<SimEvent>){\n        if self.event.kind==Kind::Check {\n            self.profile.age=meta::age(self.event.skill(),self.profile.day-1,self.profile.stars);self.profile.ages.push(self.profile.age);self.profile.check_done=true;self.save_change();self.change(Screen::Report);events.push(SimEvent::Sfx{id:4,gain:0.8,pitch:1.});return;\n        }\n        let score=self.event.score.min(1000);let stars=meta::stars(score);self.previous_best=self.profile.bests[self.event.kind as usize].score;\n        self.banked=if self.profile.clears.contains(&(self.event.kind as u8)){1}else{1+stars as u32};\n        self.result_title=dialogue::title(score,(self.time as usize)%6);\n        if !self.hub.active {\n            self.profile.minutes+=self.banked;self.profile.total_minutes+=self.banked;self.profile.stars+=stars as u32;\n            if !self.profile.clears.contains(&(self.event.kind as u8)){self.profile.clears.push(self.event.kind as u8);}\n            if score>=self.previous_best {self.profile.bests[self.event.kind as usize]=meta::Best{score,stars,ghost:self.event.ghost.clone()};}\n            if !self.profile.titles.contains(&self.result_title){self.profile.titles.push(self.result_title.clone());}\n            if self.event.kind==Kind::Finale {self.profile.age=self.profile.age.saturating_sub((score/100)as u8).max(18);}\n            self.save_change();\n        } else {self.hub.total+=score;self.hub.runs.push(self.event.ghost.clone());}\n        self.change(Screen::Result);events.push(SimEvent::Sfx{id:22,gain:0.75,pitch:1.});\n        if self.direct {self.outcome=Outcome::Won;}\n    }\n    fn medley_next(&mut self,sim:&mut Sim){\n        self.hub.round+=1;if self.hub.round<3 {let k=[Kind::Paddle,Kind::Tide,Kind::Dive][self.hub.round as usize];self.start_event(k,sim);if self.hub.hub{self.change(Screen::Event);}return;}\n        self.hub.scores.push(self.hub.total);self.hub.seat+=1;self.hub.round=0;self.hub.total=0;\n        if self.hub.seat>=self.hub.players {self.change(Screen::Podium);self.hub.ended=true;}\n        else {self.start_event(Kind::Paddle,sim);self.change(Screen::Pass);}\n    }\n    fn end_day(&mut self,sim:&mut Sim,events:&mut Vec<SimEvent>){\n        if self.profile.minutes<meta::goal(self.profile.day)&&!self.profile.free_play{self.toast(\"The clam is still expecting minutes. It has cleared its afternoon.\");return;}\n        self.profile.stamps=self.profile.stamps.max(self.profile.day);events.push(SimEvent::Sfx{id:3,gain:0.8,pitch:1.});\n        self.change(Screen::Calendar);self.save_change();let _=sim;\n    }\n    fn items(&self)->Vec<Item>{\n        let item=|id:u16,text:String,detail:String|Item{id,text,detail,enabled:true,value:None};let simple=|a:&[&str]|a.iter().enumerate().map(|(i,t)|item(i as u16,(*t).into(),String::new())).collect::<Vec<_>>();\n        match self.screen {\n            Screen::Title=>{let mut a=vec![];if self.save.guests.iter().any(|s|s.is_some()){a.push(item(10,\"Continue your stay\".into(),format!(\"{} · day {}\",self.profile.name,self.profile.day)));}for(id,t)in[(0,\"New Stay\"),(1,\"Play Together\"),(2,\"Settings\"),(3,\"About this little island\")]{a.push(item(id,t.into(),String::new()));}a},\n            Screen::Guest=>(0..4).map(|n|item(n,format!(\"Guest {}\",n+1),self.save.guests[n as usize].as_ref().map(|g|format!(\"{} · day {}\",g.name,g.day)).unwrap_or(\"A fresh towel awaits\".into()))).collect(),\n            Screen::Name=>meta::NAMES.iter().enumerate().map(|(n,s)|item(n as u16,(*s).into(),String::new())).collect(),\n            Screen::Look=>vec![item(0,format!(\"Skin tone  {} / 6\",self.look_skin+1),\"Choose what feels like you\".into()),item(1,format!(\"Outfit  ·  {}\",meta::OUTFITS[self.look_outfit as usize].0),\"Eight very relaxed options\".into()),item(2,\"Check in\".into(),\"Your towel is ready\".into())],\n            Screen::Card=>simple(&[\"Let'\"'s try it\\\",\\\"Back to the island\\\"]),\n            Screen::Result=>simple(&[if self.hub.active{\\\"Next event\\\"}else if self.event.kind==Kind::Finale{\\\"Checkout time\\\"}else{\\\"Back to the island\\\"},\\\"Try again\\\"]),\n            Screen::Report=>simple(&[if self.profile.day==5&&\"'!self.profile.free_play{\"The Big Stand awaits\"}else{\"A day on the island\"}]),\n            Screen::Pause=>if self.hub.hub{simple(&[\"Resume\",\"Settings\"])}else{simple(&[\"Resume\",\"Schedule\",\"Calendar\",\"Wardrobe\",\"Settings\",\"How to play\",\"About & credits\",\"Dev mode\",\"Quit to title\"])},\n            Screen::Schedule=>{\n                let mut out:Vec<_>=ROSTER.iter().map(|&k|{let open=self.profile.free_play||k.day()<=self.profile.day;Item{id:100+k as u16,text:k.name().into(),detail:if open{format!(\"{}  ·  {}\",[\"Stillness Studio\",\"Iron Gazebo\",\"Boardwalk\",\"Lagoon\"][(k.day()-1)as usize],if self.profile.clears.contains(&(k as u8)){\"visited today\"}else{\"a mat is waiting\"})}else{format!(\"Opens on day {}\",k.day())},enabled:open,value:None}}).collect();\n                if self.profile.day==5||self.profile.free_play{out.push(item(111,\"The Big Stand\".into(),\"A very small post. A very big occasion.\".into()));}\n                out.push(item(120,if self.profile.free_play{\"Stamp today'\"'s calendar\\\"}else{\\\"End day at your cabana\\\"}.into(),format\"'!(\"{} / {} resort minutes\",self.profile.minutes,meta::goal(self.profile.day))));out\n            },\n            Screen::Settings=>{\n                let s=&self.save.settings;\n                let rows=[(\"Music\",s.music,0.,1.),(\"Sound effects\",s.sfx,0.,1.),(\"Equipment voices\",s.voice,0.,1.),(\"Controller glyphs\",s.xbox as u8 as f32,0.,1.),(\"Lean sensitivity\",s.sensitivity,0.5,1.5),(\"Wobble assist\",s.assist,0.,0.8),(\"Rhythm offset\",s.rhythm,-0.25,0.25),(\"Text speed\",s.text_speed,15.,90.)];\n                let mut out:Vec<_>=rows.iter().enumerate().map(|(n,(name,v,min,max))|Item{id:n as u16,text:(*name).into(),detail:if n==3{if s.xbox{\"Xbox · A B X Y\"}else{\"PlayStation · × ○ □ △\"}.into()}else if n==6{format!(\"{:+.0} ms\",v*1000.)}else if n==7{format!(\"{:.0} letters / second\",v)}else{format!(\"{:.0}%\",v*100.)},enabled:true,value:Some((*v,*min,*max))}).collect();\n                out.push(item(8,\"Fullscreen\".into(),\"F11 also works\".into()));out.push(item(9,\"Reset saved stays\".into(),\"Opens a confirmation\".into()));out.push(item(10,\"Back\".into(),String::new()));out\n            },\n            Screen::Wardrobe=>{\n                let labels=[\"Resort issue\",\"Sun cap\",\"Towel turban\",\"Crown of effort\",\"Personal halo\",\"Sweatbands\",\"Arm floaties\",\"Golden flip-flops\"];\n                labels.iter().enumerate().map(|(n,s)|{let unlocked=n==0||self.profile.total_minutes>=n as u32*4||n==7&&self.profile.flipflops.len()==5;Item{id:n as u16,text:(*s).into(),detail:if n==7{format!(\"{} / 5 lost flip-flops\",self.profile.flipflops.len())}else{format!(\"{} banked minutes\",n*4)},enabled:unlocked,value:None}}).collect()\n            },\n            Screen::Dev=>{let mut a=vec![];match self.dev_tab {\n                0=>{for n in 1..=5{a.push(item(n,format!(\"Jump to day {n}\"),String::new()));}for k in ROSTER.into_iter().chain([Kind::Finale,Kind::Check]){a.push(item(100+k as u16,k.name().into(),\"Jump directly into play\".into()));}for p in 0..5{a.push(item(130+p,format!(\"Finale phase {}\",p+1),String::new()));}a.push(item(150,\"Attract mode\".into(),String::new()));a.push(item(151,\"Local Medley\".into(),String::new()));},\n                1=>{a=simple(&[\"Autoplay with the bot\",\"No tips\",\"Give 10 minutes\",\"Unlock all activities\",\"Award all stars\",\"Skip dialogue\",\"Win activity now\",\"Lose activity now\",\"Reset this guest\"]);for(n,it)in a.iter_mut().enumerate(){if n<2{it.detail=if (n==0&&self.autoplay)||(n==1&&self.no_tips){\"On\"}else{\"Off\"}.into();}}},\n                2=>{a=vec![Item{id:0,text:\"Simulation speed\".into(),detail:format!(\"{:.2}×\",self.time_scale),enabled:true,value:Some((self.time_scale,0.25,4.))},item(1,\"Single activity tick\".into(),\"Advance 1/60 second\".into()),item(2,\"Resume activity\".into(),String::new())];},\n                3=>{a=self.tunables().into_iter().enumerate().map(|(n,(text,v,min,max))|Item{id:n as u16,text:text.into(),detail:format!(\"{v:.3}\"),enabled:true,value:Some((v,min,max))}).collect();a.push(item(99,\"Reset all tuning to defaults\".into(),String::new()));},\n                _=>{a=simple(&[\"Dot trace & input viewer\",\"Ghost lanes\",\"Free camera\",\"Engine statistics\"]);for it in &mut a{it.detail=if self.show_trace{\"On\"}else{\"Off\"}.into();}}\n            }a},\n            Screen::Pass=>simple(&[\"I'\"'m ready\\\"]),Screen::Podium=>if self.hub.hub{vec\"'![]}else{simple(&[\"Back to the resort\"] )},\n            Screen::Ending=>simple(&[\"A small round of credits\"]),Screen::Credits=>simple(&[\"Free Play · stay a little longer\"]),\n            Screen::How|Screen::About=>simple(&[\"Next page\",\"Back\"]),Screen::Reset=>simple(&[\"Keep my stays\",\"Reset all four guests\"]),\n            Screen::Calendar=>simple(&[if self.profile.free_play{\"Back to the island\"}else if self.profile.stamps>=self.profile.day{\"Sleep. Do it all gently tomorrow.\"}else{\"Back to the island\"}]),_=>vec![]\n        }\n    }\n    fn activate(&mut self,id:u16,sim:&mut Sim,events:&mut Vec<SimEvent>){\n        events.push(SimEvent::Sfx{id:1,gain:0.5,pitch:1.});\n        match self.screen {\n            Screen::Title=>match id {0=>self.change(Screen::Guest),1=>{self.together_count=2;self.page=0;self.change(Screen::Pass);self.hub=Medley::default();},2=>{self.return_to=Screen::Title;self.change(Screen::Settings)},3=>{self.return_to=Screen::Title;self.change(Screen::About)},10=>{let absent=self.today.saturating_sub(self.profile.today);if self.profile.free_play||self.profile.check_done{self.to_hub(sim);}else{self.start_day(sim);}if absent>0{self.toast(format!(\"You were away for {absent} days. I did not count them. There were {absent}.\"));}},_=>{}},\n            Screen::Guest=>{self.save.active=id as usize;self.profile=Guest::default();self.change(Screen::Name);},\n            Screen::Name=>{self.profile.name=meta::NAMES[id as usize].into();self.change(Screen::Look)},\n            Screen::Look=>match id {0=>self.look_skin=(self.look_skin+1)%6,1=>self.look_outfit=(self.look_outfit+1)%8,_=>{self.profile.skin=self.look_skin;self.profile.outfit=self.look_outfit;world::guest_look(sim,&self.profile);self.save_change();self.talk(\"PIP\",vec![\"Welcome to Tippy Cay. You have won a complimentary stay. You did not enter.\".into(),\"Five days. Four pavilions. One very patient clam.\".into(),\"Checkout requires a Balance Age of 40 or better. Nobody has asked to leave yet.\".into()],Screen::Card);self.event=Event::new(Kind::Check,self.event.core.phase);}},\n            Screen::Card=>if id==0{self.countdown=3.;self.change(Screen::Countdown)}else{self.to_hub(sim)},\n            Screen::Result=>if id==1&&!self.hub.hub{let k=self.event.kind;self.start_event(k,sim);}else if self.hub.active {self.medley_next(sim)}else if self.event.kind==Kind::Finale{self.profile.stamps=5;self.profile.free_play=true;self.save_change();self.change(Screen::Ending);}else{self.to_hub(sim)},\n            Screen::Report=>if self.profile.day==5&&!self.profile.free_play {self.start_event(Kind::Finale,sim);}else{self.to_hub(sim);self.toast(dialogue::pip(self.profile.day,self.profile.age,self.time as usize));},\n            Screen::Pause=>if self.hub.hub {if id==0{self.change(Screen::Event)}else{self.return_to=Screen::Event;self.change(Screen::Settings)}}else{match id {0=>self.change(self.return_to),1=>self.change(Screen::Schedule),2=>self.change(Screen::Calendar),3=>self.change(Screen::Wardrobe),4=>self.change(Screen::Settings),5=>self.change(Screen::How),6=>self.change(Screen::About),7=>{self.dev_tab=0;self.change(Screen::Dev)},8=>{self.save_change();self.change(Screen::Title)},_=>{}}},\n            Screen::Schedule=>if id>=100&&id<113{let n=(id-100)as usize;let k=ROSTER.get(n).copied().unwrap_or(Kind::Finale);if self.profile.free_play||k.day()<=self.profile.day{self.start_event(k,sim);}}else if id==120{self.end_day(sim,events);},\n            Screen::Calendar=>if self.profile.free_play{self.to_hub(sim);self.save_change();}else if self.profile.stamps>=self.profile.day&&self.profile.day<5{self.profile.day+=1;self.profile.minutes=0;self.profile.clears.clear();self.profile.check_done=false;self.save_change();self.start_day(sim);}else{self.to_hub(sim)},\n            Screen::Settings=>if id==3{self.save.settings.xbox=!self.save.settings.xbox;self.serial+=1;}else if id==9{self.change(Screen::Reset)}else if id==10{self.change(self.return_to)}else if id<8{self.adjust(id,1.)},\n            Screen::Wardrobe=>{self.profile.gear=id as u8;world::guest_look(sim,&self.profile);self.save_change();self.toast(\"Your effort has a new accessory.\");},\n            Screen::How|Screen::About=>if id==0{self.page=(self.page+1)%if self.screen==Screen::How{4}else{self.about_pages.len().max(1)}}else{self.change(self.return_to)},\n            Screen::Dev=>self.dev_action(id,sim,events),\n            Screen::Pass=>if self.hub.active{self.start_event(Kind::Paddle,sim);}else{self.start_medley(self.together_count,false,sim);self.start_event(Kind::Paddle,sim);},\n            Screen::Podium=>{self.hub=Medley::default();self.to_hub(sim)},\n            Screen::Ending=>{self.change(Screen::Credits);self.outcome=Outcome::Won;},\n            Screen::Credits=>{self.outcome=Outcome::Playing;self.to_hub(sim);self.toast(\"Every mat is yours. The clam has cancelled its plans.\");},\n            Screen::Reset=>{if id==1{self.save=Save::default();self.profile=Guest::default();self.serial+=1;}self.change(Screen::Settings)},_=>{}\n        }\n    }\n    fn back(&mut self,sim:&mut Sim){match self.screen {Screen::Title=>{},Screen::Intro=>{self.revealed=10000.;},Screen::Event|Screen::Countdown=>{self.return_to=Screen::Event;self.change(Screen::Pause)},Screen::Settings|Screen::How|Screen::About=>self.change(self.return_to),Screen::Pause=>self.change(self.return_to),Screen::Guest|Screen::Pass if !self.hub.active=>self.change(Screen::Title),Screen::Name=>self.change(Screen::Guest),Screen::Look=>self.change(Screen::Name),Screen::Dev=>self.change(Screen::Pause),_=>self.to_hub(sim)}}\n    fn adjust(&mut self,id:u16,dir:f32){\n        if self.screen==Screen::Look{if id==0{self.look_skin=(self.look_skin as i32+if dir>0.{1}else{5})as u8%6;}else if id==1{self.look_outfit=(self.look_outfit as i32+if dir>0.{1}else{7})as u8%8;}return;}\n        if self.screen==Screen::Pass&&!self.hub.active{self.together_count=(self.together_count as i32+dir.signum()as i32).clamp(2,4)as u8;return;}\n        if self.screen==Screen::Dev {if self.dev_tab==2{self.time_scale=(self.time_scale+dir*0.25).clamp(0.25,4.);}else if self.dev_tab==3{let list=self.tunables();if let Some((_,v,min,max))=list.get(id as usize){self.set_tune(id,(*v+dir*(*max-*min)*0.025).clamp(*min,*max));}}return;}\n        if self.screen!=Screen::Settings{return;}let s=&mut self.save.settings;match id {0=>s.music=(s.music+dir*0.05).clamp(0.,1.),1=>s.sfx=(s.sfx+dir*0.05).clamp(0.,1.),2=>s.voice=(s.voice+dir*0.05).clamp(0.,1.),3=>s.xbox=!s.xbox,4=>s.sensitivity=(s.sensitivity+dir*0.05).clamp(0.5,1.5),5=>s.assist=(s.assist+dir*0.05).clamp(0.,0.8),6=>s.rhythm=(s.rhythm+dir*0.005).clamp(-0.25,0.25),7=>s.text_speed=(s.text_speed+dir*5.).clamp(15.,90.),_=>{}}self.serial+=1;\n    }\n    fn slider(&mut self,id:u16,v:f32){if self.screen==Screen::Settings{let items=self.items();if let Some((_,lo,hi))=items.iter().find(|a|a.id==id).and_then(|it|it.value){let x=v.clamp(lo,hi);let s=&mut self.save.settings;match id{0=>s.music=x,1=>s.sfx=x,2=>s.voice=x,3=>s.xbox=x>0.5,4=>s.sensitivity=x,5=>s.assist=x,6=>s.rhythm=x,7=>s.text_speed=x,_=>{}}self.serial+=1;}}else if self.screen==Screen::Dev{if self.dev_tab==3{self.set_tune(id,v)}else if self.dev_tab==2{self.time_scale=v.clamp(0.25,4.)}}}\n    fn dev_action(&mut self,id:u16,sim:&mut Sim,events:&mut Vec<SimEvent>){match self.dev_tab {\n        0=>{if(1..=5).contains(&id){self.profile.day=id as u8;self.profile.minutes=0;self.profile.clears.clear();self.start_day(sim);}else if(100..113).contains(&id){let k=if id<111{ROSTER[(id-100)as usize]}else if id==111{Kind::Finale}else{Kind::Check};self.start_event(k,sim);self.change(Screen::Event);}else if(130..135).contains(&id){self.start_event(Kind::Finale,sim);self.event.time=[0.,32.,52.,92.,112.][(id-130)as usize];self.change(Screen::Event);}else if id==150{self.start_demo(sim)}else if id==151{self.start_medley(2,false,sim)}},\n        1=>match id {0=>self.autoplay=!self.autoplay,1=>self.no_tips=!self.no_tips,2=>{self.profile.minutes+=10;self.profile.total_minutes+=10;self.save_change()},3=>{self.profile.free_play=true;self.save_change()},4=>{self.profile.stars=99;self.save_change()},5=>self.change(self.return_to),6|7=>{self.event.score=if id==6{1000}else{0};self.event.finished=true;self.finish_event(sim,events)},8=>{self.profile=Guest::default();self.save_change();self.to_hub(sim)},_=>{}},\n        2=>if id==0{self.adjust(0,1.)}else if id==1{let inp=self.event.bot(&self.rules,1./60.);self.event.step(&inp,1./60.,&self.rules,events,world::origin(self.set));}else{self.change(Screen::Event)},\n        3=>if id==99{self.rules=Rules::default()}else{self.adjust(id,1.)},_=>{self.show_trace=!self.show_trace;}\n    }}\n    pub fn tunables(&self)->Vec<(&'\"'static str,f32,f32,f32)> {let r=&self.rules;vec\"'![(\"Core · stiffness\",r.stiffness,10.,80.),(\"Core · damping\",r.damping,2.,20.),(\"Core · reach\",r.reach,0.6,1.2),(\"Core · wobble\",r.wobble,0.,0.4),(\"Core · tip time\",r.tip_time,0.1,1.),(\"Stick response curve\",r.stick_curve,1.,3.),(\"Keyboard lean rate\",r.key_rate,0.5,3.),(\"Keyboard return rate\",r.key_return,0.5,3.),(\"Pose target radius\",r.pose_radius,0.18,0.5),(\"Breath tolerance\",r.breath_tolerance,0.1,0.6),(\"Squat balance band\",r.squat_band,0.1,0.5),(\"Plank ring radius\",r.plank_radius,0.2,0.6),(\"Rhythm perfect window\",r.rhythm_perfect,0.025,0.15),(\"Rhythm good window\",r.rhythm_good,0.07,0.25),(\"Keyboard spin band\",r.spin_band_scale,1.,2.),(\"Jogging pace zone\",r.lap_zone,0.2,0.8),(\"Shell friction\",r.shell_friction,1.,5.),(\"Lagoon gust strength\",r.gust_strength,0.,3.),(\"Tray friction\",r.tray_friction,1.,8.),(\"Dive bounce gain\",r.bounce_gain,0.5,2.),(\"Big Stand gusts\",r.finale_gusts,0.,3.)]}\n    fn set_tune(&mut self,id:u16,v:f32){let list=self.tunables();let Some((_,_,lo,hi))=list.get(id as usize)else{return;};let v=v.clamp(*lo,*hi);let r=&mut self.rules;match id {0=>r.stiffness=v,1=>r.damping=v,2=>r.reach=v,3=>r.wobble=v,4=>r.tip_time=v,5=>r.stick_curve=v,6=>r.key_rate=v,7=>r.key_return=v,8=>r.pose_radius=v,9=>r.breath_tolerance=v,10=>r.squat_band=v,11=>r.plank_radius=v,12=>r.rhythm_perfect=v,13=>r.rhythm_good=v,14=>r.spin_band_scale=v,15=>r.lap_zone=v,16=>r.shell_friction=v,17=>r.gust_strength=v,18=>r.tray_friction=v,19=>r.bounce_gain=v,20=>r.finale_gusts=v,_=>{}}}\n    pub fn camera_yaw(&self)->Option<f32>{if self.screen==Screen::Event&&self.event.kind==Kind::Lap{Some((-self.event.progress*360.).rem_euclid(360.))}else{None}}\n    pub fn status_json(&self,sim:&Sim)->serde_json::Value{\n        let pos=sim.state.player.and_then(|p|sim.feet(p)).unwrap_or_default();\n        json!({\"title\":TITLE,\"screen\":format!(\"{:?}\",self.screen),\"tick\":sim.state.tick,\"focus\":self.focus,\"day\":self.profile.day,\"stamps\":self.profile.stamps,\"age\":self.profile.age,\"minutes\":self.profile.minutes,\"totalMinutes\":self.profile.total_minutes,\"stars\":self.profile.stars,\"event\":self.event.kind.key(),\"eventTime\":self.event.time,\"duration\":self.event.duration,\"score\":self.event.score,\"dot\":self.event.core.cob,\"tips\":self.event.core.tips,\"demo\":self.demo,\"device\":self.device,\"serial\":self.serial,\"save\":self.save,\"settings\":self.save.settings,\"rules\":self.rules,\"timeScale\":self.time_scale,\"aboutPage\":self.page,\"outcome\":self.outcome,\"hub\":{\"score\":self.hub.total+self.event.score,\"done\":self.hub.ended,\"label\":self.event.kind.name(),\"stats\":{\"tips\":self.event.core.tips,\"stars\":meta::stars(self.event.score)},\"ghost\":{\"area\":self.event.kind as u8,\"position\":[pos.x,pos.y,pos.z],\"lean\":self.event.core.cob,\"facing\":0.,\"score\":self.event.score,\"clip\":0,\"clipTime\":self.event.time}}})\n    }\n    pub fn ui(&self,_sim:&Sim)->UiFrame {\n        let mut u=UiFrame{screen:format!(\"{:?}\",self.screen),focus:self.focus,items:self.items(),day:self.profile.day,minutes:self.profile.minutes,minute_goal:meta::goal(self.profile.day),age:self.profile.age,stamps:self.profile.stamps,ages:self.profile.ages.clone(),score:self.event.score,stars:meta::stars(self.event.score),best:self.previous_best,banked:self.banked,time:self.event.time,duration:self.event.duration,dot:self.event.core.cob,target:self.event.target,radius:self.event.radius,guide:self.event.guide,lungs:self.event.lungs,phase:self.event.phase,event:self.event.kind as u8,notes:self.event.notes.iter().map(|n|(n.t,n.lane,n.judged)).collect(),label:self.event.label.clone(),coach:self.event.kind.coach().into(),device:self.device,xbox:self.save.settings.xbox,demo:self.demo,peace:self.event.peace,show_puck:true,blind:self.event.kind==Kind::Check&&self.event.phase==2,trace:if self.show_trace{self.trace.clone()}else{vec![]},debug:self.show_trace,player_name:self.profile.name.clone(),hub:self.hub.hub,page:self.page,pages:1,version:\"PAVILION / TIPPY CAY / 01\".into(),..Default::default()};\n        u.prompt=if self.device==1{if self.save.settings.xbox{\"A  Select     B  Back     ☰  Pause\"}else{\"×  Select     ○  Back     OPTIONS  Pause\"}}else{\"ENTER  Select     ESC  Back     TAB  Schedule\"}.into();\n        match self.screen {\n            Screen::Title=>{u.heading=TITLE.into();u.kicker=\"TIPPY CAY · WELLNESS RESORT\".into();u.subtitle=TAGLINE.into();},\n            Screen::Guest=>{u.heading=\"A towel with your name on it.\".into();u.kicker=\"NEW STAY\".into();u.subtitle=\"Choose a guest card.\".into()},\n            Screen::Name=>{u.heading=\"Who might you be?\".into();u.kicker=\"GUEST REGISTRATION\".into();u.subtitle=\"Our names are pre-relaxed for your convenience.\".into()},\n            Screen::Look=>{u.heading=format!(\"Hello, {}.\",self.profile.name);u.kicker=\"MAKE YOURSELF COMFORTABLE\".into();u.subtitle=\"Arrive exactly as you are. Or in lilac.\".into()},\n            Screen::Hub=>{u.heading=\"Tippy Cay\".into();u.kicker=if self.profile.free_play{\"FREE PLAY\".into()}else{format!(\"DAY {} OF 5\",self.profile.day)};u.subtitle=if self.message_time>0.{self.message.clone()}else{\"A small island. A surprisingly thorough schedule.\".into()};u.label=self.nearest.map(|n|world::INTERACTIONS[n].0.to_string()).unwrap_or(\"Walk · discover · wobble gently\".into());},\n            Screen::Intro=>{u.coach=self.speaker.clone();u.dialogue=self.dialogue.get(self.dialog_index).cloned().unwrap_or_default();u.revealed=self.revealed as usize;},\n            Screen::Card|Screen::Countdown|Screen::Event=>{u.heading=self.event.kind.name().into();u.kicker=if self.event.kind==Kind::Check{\"YOUR DAILY RITUAL\"}else{[\"\",\"STILLNESS STUDIO\",\"IRON GAZEBO\",\"BOARDWALK\",\"LAGOON\",\"LAGOON\",\"LAGOON\",\"LAGOON\",\"THE BAY\"][self.set]}.into();u.subtitle=self.event.kind.goal().into();u.countdown=self.countdown.ceil()as i32;u.lines=vec![dialogue::coach(self.event.kind,self.profile.day,self.event.time as usize)];if self.screen==Screen::Event{u.prompt=self.event_prompt();}},\n            Screen::Result=>{u.heading=self.result_title.clone();u.kicker=\"A SMALL ACHIEVEMENT\".into();u.subtitle=if self.event.kind==Kind::Squat{\"Ten. Also eleven.\".into()}else{dialogue::coach(self.event.kind,self.profile.day,self.event.score as usize)};u.lines=vec![self.event.kind.name().into(),if self.event.score>self.previous_best{\"A personal best. Please remain calm.\".into()}else{format!(\"Yesterday You: {:+}\",self.event.score as i32-self.previous_best as i32)}];},\n            Screen::Report=>{u.heading=\"Your Balance Age\".into();u.kicker=\"MORNING WOBBLE CHECK\".into();u.subtitle=dialogue::pip(self.profile.day,self.profile.age,self.profile.age as usize);},\n            Screen::Schedule=>{u.heading=\"Absolutely no rush.\".into();u.kicker=\"TODAY'\"'S POSSIBILITIES\\\".into();u.subtitle=\\\"Pick a mat. We'll take you there.\\\".into()},\n            Screen::Pause=>{u.heading=\\\"A moment, please.\\\".into();u.kicker=\\\"PAUSED\\\".into();u.subtitle=if self.hub.hub{\\\"The medley clock keeps running.\\\"}else{\\\"Pausing is not an exercise. Pip checked.\\\"}.into()},\n            Screen::Calendar=>{u.heading=\\\"You showed up.\\\".into();u.kicker=\\\"YOUR FIVE LITTLE DAYS\\\".into();u.subtitle=\\\"That counts. The stamp is quite firm about it.\\\".into()},\n            Screen::Settings=>{u.heading=\\\"A little adjustment.\\\".into();u.kicker=\\\"SETTINGS\\\".into();u.subtitle=\\\"Left / right to change. Everything in moderation.\\\".into()},\n            Screen::Wardrobe=>{u.heading=\\\"Effort, accessorised.\\\".into();u.kicker=\\\"THE TOWEL CUPBOARD\\\".into();u.subtitle=\\\"Bank minutes. Acquire increasingly formal headwear.\\\".into()},\n            Screen::How=>{let pages=[(\\\"Small movements. Big consequences.\\\",vec\"'![\"Lean with the left stick, WASD or the mouse. Hold Shift for a finer nudge.\".into(),\"Your coral dot is your balance. Keep it in the mint target. Less is often plenty.\".into()]),(\"A very pleasant routine.\",vec![\"Start with Pip'\"'s Morning Wobble Check. Then visit the mats or open the Schedule.\\\".into(),\\\"First clears bank 1 + stars in resort minutes. Meet your daily goal, then sleep.\\\".into()]),(\\\"Bring all your feet.\\\",vec\"'![\"Cross / Space / click is Action. Shoulder buttons / Q and E are left and right steps.\".into(),\"Hold both steps to brace. Triangle / Tab opens Schedule. Options / Esc pauses.\".into()]),(\"Some things are better shared.\",vec![\"Play Together passes one pad between 2–4 guests. Three lagoon events decide the medley.\".into(),\"From day 3, Yesterday You practises beside you. At checkout: Balance Age 40 or better.\".into()])];let (h,l)=&pages[self.page%4];u.heading=(*h).into();u.kicker=\"HOW TO WOBBLE\".into();u.lines=l.clone();u.pages=4;},\n            Screen::About=>{if let Some((h,l))=self.about_pages.get(self.page%self.about_pages.len().max(1)){u.heading=h.clone();u.lines=l.clone();}else{u.heading=\"Made with a little wobble.\".into();u.lines=vec![\"Source: Wii Fit · Plan: PLAN.md · Sports · third person\".into(),\"Original Tippy Cay resort. Pavilion / Rust / WebAssembly / WebGPU / egui.\".into(),\"All music, effects and equipment voices are synthesised in code.\".into()];}u.kicker=\"ABOUT & CREDITS\".into();u.pages=self.about_pages.len().max(1);},\n            Screen::Dev=>{u.heading=[\"Jump anywhere\",\"A small unfair advantage\",\"Time, loosely speaking\",\"Find the sweet spot\",\"Look a little closer\"][self.dev_tab].into();u.kicker=format!(\"DEV MODE · {} / 5 · Q / E TABS\",self.dev_tab+1);u.subtitle=\"Changes apply live. Reset tuning restores the authored rules.\".into()},\n            Screen::Pass=>{u.heading=if self.hub.active{format!(\"Your turn, {}.\",self.hub.names.get(self.hub.seat as usize).unwrap_or(&self.profile.name))}else{format!(\"{} guests. One very patient pad.\",self.together_count)};u.kicker=\"INTER-RESORT MEDLEY\".into();u.subtitle=if self.hub.active{\"Pass the controller. The lagoon is waiting.\"}else{\"Left / right to choose 2–4 guests. Paddle · tide pools · cannonball.\"}.into()},\n            Screen::Podium=>{u.heading=\"Everyone stood for something.\".into();u.kicker=\"MEDLEY COMPLETE\".into();let mut results:Vec<_>=self.hub.scores.iter().enumerate().collect();results.sort_by_key(|(_,s)|std::cmp::Reverse(**s));u.lines=results.iter().enumerate().map(|(place,(seat,score))|format!(\"{}. {}    {}\",place+1,self.hub.names.get(*seat).unwrap_or(&self.profile.name),score)).collect();u.subtitle=\"A tasteful amount of applause.\".into()},\n            Screen::Ending=>{u.heading=if self.profile.age<=40{\"Permission to drift.\"}else{\"An extended opportunity.\"}.into();u.kicker=if self.profile.age<=40{\"CHECKOUT APPROVED\"}else{\"EXTENDED STAY\"}.into();u.subtitle=if self.profile.age<=40{\"Your rowboat is ready. Your towel is emotionally unavailable.\"}else{\"The resort would love you to stay. It has already moved your suitcase back.\"}.into();u.lines=vec![if self.event.peace{\"Inner Peace bonus · you accepted absolutely nothing.\"}else{\"Pip has filed your skip request under '\"'interesting'.\\\"}.into(),\\\"…Oh. You're still here. Good.\\\".into()];},\n            Screen::Credits=>{u.heading=\\\"Thank you for being here.\\\".into();u.kicker=TITLE.to_uppercase();u.subtitle=\\\"Every activity is now open. Your towel remains reserved.\\\".into();u.lines=vec\"'![\"Tippy Cay staff: Pip · Posey · Big Kettle · Bounce · Commodore Gull\".into(),\"With Marjorie, Two-Towel Tom, the Twins, and one entirely uninvited bird.\".into(),\"Engine, sources and production feedback: Pause → About & credits.\".into()];},\n            Screen::Reset=>{u.heading=\"Unstamp everything?\".into();u.kicker=\"RESET SAVED STAYS\".into();u.subtitle=\"This clears all four guest cards and their progress.\".into()},\n        }\n        u\n    }\n    fn event_prompt(&self)->String {let act=if self.device==1{if self.save.settings.xbox{\"A\"}else{\"×\"}}else if self.device==2{\"LMB\"}else{\"SPACE\"};let steps=if self.device==1{if self.save.settings.xbox{\"LB / RB\"}else{\"L1 / R1\"}}else if self.device==2{\"LMB / RMB\"}else{\"Q / E\"};match self.event.effective().0{Kind::Breath=>format!(\"{act}  Hold to inhale · release to exhale\"),Kind::Squat=>format!(\"{act}  Hold to lower · release to rise\"),Kind::Plank=>format!(\"{steps}  Hold both to brace\"),Kind::Step|Kind::Lap=>format!(\"{steps}  Left / right steps\"),Kind::Dive=>format!(\"{act}  Bounce · hold to tuck\"),Kind::Spin=>format!(\"Circle your lean     {steps}  Catch\"),Kind::Finale=>\"Thirty seconds. Just you.\".into(),_=>if self.device==1{\"LEFT STICK  Lean gently\"}else{\"WASD / MOUSE  Lean gently\"}.into()}}\n}\nimpl Game for FitGame {\n    const KEY:&'\"'static str=\\\"fit\\\";\n    fn frozen(&self)->bool{if self.hub.hub&&self.hub.go{return false;}\"'!matches!(self.screen,Screen::Hub|Screen::Event|Screen::Countdown)}\n    fn pre(&mut self,sim:&mut Sim,raw:&InputFrame,dt:f32,events:&mut Vec<SimEvent>)->BTreeMap<EntityId,InputFrame>{\n        self.time+=dt;self.screen_time+=dt;self.message_time=(self.message_time-dt).max(0.);\n        if raw.any||raw.pressed!=0||raw.ui.is_some(){self.device=raw.device;}\n        if raw.hub_end{self.hub.ended=true;}if raw.down(b::HUB_GO){self.hub.go=true;}\n        let gains=[self.save.settings.music,self.save.settings.sfx,self.save.settings.voice];if gains!=self.last_gain{events.push(SimEvent::AudioGains{music:gains[0],sfx:gains[1],voice:gains[2]});self.last_gain=gains;}\n        let song=if self.screen==Screen::Event||self.screen==Screen::Countdown||self.screen==Screen::Card{if self.event.kind==Kind::Finale&&self.event.time>=112.{0}else{self.event.kind.song()}}else{1};\n        let song=if self.hub.ended {0}else{song};if song!=self.last_music{events.push(SimEvent::Music{song});self.last_music=song;}\n        let any=raw.any||raw.pressed!=0||raw.lean.length()>0.3||matches!(raw.ui,Some(UiEvent::Click(_)));\n        if self.demo&&any {self.end_demo(sim);return sim.state.player.map(|id|(id,InputFrame::default())).into_iter().collect();}\n        if matches!(self.screen,Screen::Title|Screen::Guest|Screen::Name|Screen::Look|Screen::Pass|Screen::About|Screen::How|Screen::Settings)&&!self.hub.active{\n            self.idle=if any{0.}else{self.idle+dt};if self.idle>=10.&&!self.demo{self.start_demo(sim);}}\n        if self.demo {self.demo_time+=dt;let order=[Kind::Dive,Kind::Paddle,Kind::Step,Kind::Pose,Kind::Tide,Kind::Spin,Kind::Tray,Kind::Plank,Kind::Lap,Kind::Finale];if self.demo_time>15.{self.demo_time=0.;self.demo_index=(self.demo_index+1)%order.len();self.start_event(order[self.demo_index],sim);if order[self.demo_index]==Kind::Finale{self.event.time=92.;}self.change(Screen::Event);}}\n        let mut input=if (self.demo||self.autoplay)&&self.screen==Screen::Event{self.event.bot(&self.rules,dt*self.time_scale)}else{*raw};\n        input.lean*=self.save.settings.sensitivity;input.lean=input.lean.clamp_length_max(1.);\n        if self.hub.hub&&(!self.hub.go||self.hub.ended){return sim.state.player.map(|id|(id,InputFrame::default())).into_iter().collect();}\n        if input.just(b::PAUSE)&&!self.demo{if self.screen==Screen::Pause{self.change(self.return_to);}else{self.return_to=self.screen;self.change(Screen::Pause)}}\n        else if input.just(b::SCHEDULE)&&!self.hub.hub&&!self.demo{if self.screen==Screen::Hub{self.change(Screen::Schedule);}else if self.screen==Screen::Schedule{self.to_hub(sim);}}\n        else if input.just(b::BACK)&&!self.demo {self.back(sim);}\n        else if self.screen==Screen::Intro {\n            let line=self.dialogue.get(self.dialog_index).cloned().unwrap_or_default();let old=self.revealed as usize;self.revealed+=dt*self.save.settings.text_speed;\n            if self.revealed as usize/3>old/3&&(old<line.chars().count()){let letter=line.chars().nth(old).unwrap_or('\"'a');let vowel=\\\"aeiou\\\".find(letter.to_ascii_lowercase()).unwrap_or(old%5)as u8;let speaker=match self.speaker.as_str(){\\\"POSEY\\\"=>1,\\\"BIG KETTLE\\\"=>2,\\\"BOUNCE\\\"=>3,\\\"COMMODORE GULL\\\"=>4,_=>0};events.push(SimEvent::Syllable{speaker,vowel,pitch:if letter=='?'{1.2}else if letter=='.'{0.8}else{1.}});}\n            if input.just(b::CONFIRM)||matches\"'!(input.ui,Some(UiEvent::Click(_))){if self.revealed<line.chars().count()as f32{self.revealed=10000.;}else{self.dialog_index+=1;self.revealed=0.;if self.dialog_index>=self.dialogue.len(){if self.return_to==Screen::Card{self.start_day(sim);}else{self.change(self.return_to);}}}}\n        }else if self.screen==Screen::Countdown {self.countdown-=dt;if self.countdown<=0.{self.change(Screen::Event);self.last_music=255;}}\n        else if self.screen==Screen::Event||(self.hub.hub&&matches!(self.screen,Screen::Pause|Screen::Settings)){\n            if self.hub.hub&&self.event.finished {if self.screen_time>1.{self.medley_next(sim);}}\n            else {\n                let mut rules=self.rules.clone();rules.wobble*=1.-self.save.settings.assist;\n                if self.no_tips{self.event.core.outside=0.;}\n                self.event.step(&input,dt*self.time_scale,&rules,events,world::origin(self.set));\n                world::animate(sim,&self.event,&mut self.props,self.set,dt*self.time_scale);\n                if self.show_trace{self.trace.push(self.event.core.cob);if self.trace.len()>180{self.trace.remove(0);}}\n                if self.event.time>=self.event.record_at{self.event.record_at+=0.1;if let Some(pid)=sim.state.player {if let Some(p)=sim.feet(pid){let a=sim.state.entities.get(pid).and_then(|e|e.character.as_ref()).map(|c|c.anim).unwrap_or_default();self.event.ghost.push(events::GhostPoint{t:self.event.time,pos:p-world::origin(self.set),lean:self.event.core.cob,facing:a.facing,clip:a.clip,clip_t:a.clip_t,score:self.event.score});}}}\n                if self.event.finished&&!self.demo{if self.hub.hub{self.hub.total+=self.event.score;self.medley_next(sim);}else{self.finish_event(sim,events);}}\n            }\n        }else if self.screen==Screen::Hub {self.hub_input(sim,&input,dt,events);}\n        else if !self.demo {\n            let items=self.items();if !items.is_empty(){\n                let prev=self.focus;\n                if input.just(b::MENU_UP){self.focus=self.focus.checked_sub(1).unwrap_or(items.len()-1);}\n                if input.just(b::MENU_DOWN){self.focus=(self.focus+1)%items.len();}\n                if self.screen==Screen::Dev&&(input.just(b::TAB_L)||input.just(b::TAB_R)){self.dev_tab=(self.dev_tab+if input.just(b::TAB_R){1}else{4})%5;self.focus=0;}\n                if input.just(b::MENU_LEFT)||input.just(b::MENU_RIGHT){let dir=if input.just(b::MENU_RIGHT){1.}else{-1.};if matches!(self.screen,Screen::How|Screen::About){self.page=(self.page+if dir>0.{1}else{self.about_pages.len().max(1)-1})%if self.screen==Screen::How{4}else{self.about_pages.len().max(1)};}else{self.adjust(items[self.focus.min(items.len()-1)].id,dir);}}\n                if let Some(ui)=input.ui {match ui {UiEvent::Hover(id)=>{if let Some(n)=items.iter().position(|it|it.id==id){self.focus=n;}},UiEvent::Click(id)=>{if items.iter().any(|it|it.id==id&&it.enabled){self.activate(id,sim,events)}},UiEvent::Slider(id,v)=>self.slider(id,v)}}\n                else if input.just(b::CONFIRM){let it=&items[self.focus.min(items.len()-1)];if it.enabled{self.activate(it.id,sim,events);}}\n                if prev!=self.focus{events.push(SimEvent::Sfx{id:0,gain:0.35,pitch:1.});}\n            }\n        }\n        if matches!(self.screen,Screen::Look|Screen::Wardrobe){let mut p=self.profile.clone();p.skin=self.look_skin;p.outfit=self.look_outfit;world::guest_look(sim,&p);}\n        let mut out=BTreeMap::new();if let Some(pid)=sim.state.player{let mut movement=InputFrame::default();if self.screen==Screen::Hub {if let Some(goal)=self.way_to {if let Some(p)=sim.feet(pid){let d=Vec2::new(goal.x-p.x,goal.z-p.z);movement.move_dir=d.normalize_or_zero()*if d.length()<0.4{0.}else{1.};if d.length()<0.5{self.way_to=None;if let Some(n)=self.interact_goal.take(){self.interact(n,sim,events);}}}}else{movement.move_dir=input.move_dir;}}out.insert(pid,movement);}\n        out\n    }\n    fn outcome(&self)->Outcome{self.outcome}\n    fn status(&self,sim:&Sim)->serde_json::Value{self.status_json(sim)}\n    fn bot(&self,_sim:&Sim)->InputFrame {\n        if self.screen==Screen::Event{return self.event.bot(&self.rules,1./60.*self.time_scale);}\n        if self.screen==Screen::Countdown{return InputFrame::default();}\n        let mut i=InputFrame::default();i.pressed=b::CONFIRM;i.held=b::CONFIRM;\n        if self.screen==Screen::Hub{\n            let wanted=ROSTER.iter().find(|&&k|k.day()==self.profile.day&&!self.profile.clears.contains(&(k as u8)));\n            if wanted.is_some(){i.pressed=b::SCHEDULE;i.held=b::SCHEDULE;}else{i.ui=Some(UiEvent::Click(120));i.pressed=b::SCHEDULE;}\n        }else if self.screen==Screen::Schedule{let wanted=ROSTER.iter().find(|&&k|k.day()==self.profile.day&&!self.profile.clears.contains(&(k as u8)));i.ui=Some(UiEvent::Click(wanted.map(|k|100+*k as u16).unwrap_or(120)));}\n        else if self.screen==Screen::Title{i.ui=Some(UiEvent::Click(0));}\n        else if self.screen==Screen::Look{i.ui=Some(UiEvent::Click(2));}\n        i\n    }\n}\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_31","type":"agent_message","text":"The five-day flow and activity logic are in place, including the morning check, minute banking, unlocks, medley, and finale. I’m now adding the island, exercise animations, and UI, then I’ll use bot playthroughs to find scoring and progression problems.\n"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"cat crates/pav_core/src/prop_instance.rs | head -125; sed -n '381,413p' crates/pav_core/src/sim.rs; rg -n 'pub fn|pub struct' crates/pav_core/src/clips.rs | head -25; sed -n '300,335p' crates/pav_core/src/character.rs; cat crates/pav_core/src/entity.rs | head -40; sed -n '194,250p' crates/pav_audio/src/lib.rs; sed -n '250,326p' crates/pav_audio/src/lib.rs; tail -10 ../build-native.log; rg -n 'BigSplash|Splash' crates/pav_view/src/fx.rs crates/pav_view/src/build.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"cat crates/pav_core/src/prop_instance.rs | head -125; sed -n '381,413p' crates/pav_core/src/sim.rs; rg -n 'pub fn|pub struct' crates/pav_core/src/clips.rs | head -25; sed -n '300,335p' crates/pav_core/src/character.rs; cat crates/pav_core/src/entity.rs | head -40; sed -n '194,250p' crates/pav_audio/src/lib.rs; sed -n '250,326p' crates/pav_audio/src/lib.rs; tail -10 ../build-native.log; rg -n 'BigSplash|Splash' crates/pav_view/src/fx.rs crates/pav_view/src/build.rs\"","aggregated_output":"//! One placed prop is one entity. Its immutable definition travels with snapshots, so a\n//! restored world does not silently acquire a newer asset from the process-wide library.\n\nuse std::collections::BTreeMap;\nuse std::sync::Arc;\n\nuse glam::{Quat, Vec3};\nuse rapier::prelude::*;\nuse serde::{Deserialize, Serialize};\n\nuse crate::entity::{BodyKind, EntityId, Spawn};\nuse crate::issue;\nuse crate::physics::entity_tag;\nuse crate::props::geom::{self, Primitive};\nuse crate::props::{self, Bounds, CompiledProp, PropDef, PropDefTable, ResolvedPart};\nuse crate::shape::{Shape, Visual};\nuse crate::statics::RegionKey;\nuse crate::{Color, Sim, SimState};\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct PropInstance {\n    pub asset: String,\n    /// Snapshots name it by key in `SimState::prop_defs`.\n    #[serde(with = \"props::table::by_key\")]\n    pub definition: Arc<PropDef>,\n    pub scale: f32,\n    /// When true, only the definition's solid parts contribute to one fixed collider.\n    pub collide: bool,\n    /// The variant drawn and collided: chance, jitter and pick resolve with it (0: as\n    /// authored).\n    #[serde(default, skip_serializing_if = \"is_zero\")]\n    pub seed: u32,\n    /// Colours for the theme roles its parts name (`$wall` → `#rrggbb`); other roles take\n    /// `props::DEFAULT_ROLES`.\n    #[serde(default, skip_serializing_if = \"BTreeMap::is_empty\")]\n    pub roles: BTreeMap<String, String>,\n    /// A family's knob values (format-2 `params`), defaults left out.\n    #[serde(default, skip_serializing_if = \"BTreeMap::is_empty\")]\n    pub params: props::Params,\n    /// The patch ops its definition was made with (room objects' `patch`), kept so a saved room\n    /// writes them back.\n    #[serde(default, skip_serializing_if = \"Vec::is_empty\")]\n    pub patch: Vec<serde_json::Value>,\n}\n\nfn is_zero(seed: &u32) -> bool {\n    *seed == 0\n}\n\n#[derive(Clone, Debug)]\npub struct PropFrame {\n    /// The owner of its inline materials: the library name it was placed as (`WORKSHOP/bench`),\n    /// with its patch's hash for a patched copy (`BUILTIN/box~3f…`), so copies patched to\n    /// different materials under one key draw their own.\n    pub owner: String,\n    pub definition: Arc<PropDef>,\n    /// The parts of the instance's variant.\n    pub parts: Arc<CompiledProp>,\n    pub scale: f32,\n    pub roles: BTreeMap<String, String>,\n}\n\n/// A palette: each key one of `props::doc::ROLES`, each colour `#rrggbb`.\npub fn validate_roles(roles: &BTreeMap<String, String>) -> Result<(), String> {\n    for (role, color) in roles {\n        if !props::doc::ROLES.contains(&role.as_str()) {\n            let fix =\n                issue::suggestion(role, props::doc::ROLES.iter().copied()).map(|fix| format!(\" — {fix}\")).unwrap_or_default();\n            return Err(format!(\"roles: unknown role \\\"{role}\\\" (expected {}){fix}\", props::doc::ROLES.join(\", \")));\n        }\n        if !(color.len() == 7 && color.starts_with('#') && color[1..].bytes().all(|b| b.is_ascii_hexdigit())) {\n            return Err(format!(\"roles.{role}: \\\"{color}\\\" is not a #rrggbb colour\"));\n        }\n    }\n    Ok(())\n}\n\npub fn validate_scale(scale: f32) -> Result<(), String> {\n    if !scale.is_finite() || !(0.01..=100.0).contains(&scale) {\n        return Err(\"scale must be a finite number from 0.01 to 100\".into());\n    }\n    Ok(())\n}\n\npub fn validate_pose(pos: Vec3, rot: Quat) -> Result<(), String> {\n    if !pos.is_finite() || pos.abs().max_element() > 1_000_000.0 {\n        return Err(\"pos must contain finite world coordinates from -1000000 to 1000000\".into());\n    }\n    if !rot.is_finite() || (rot.length_squared() - 1.0).abs() > 0.001 {\n        return Err(\"rotation must be a finite unit quaternion\".into());\n    }\n    Ok(())\n}\n\nimpl PropInstance {\n    pub fn new(asset: &str, definition: Arc<PropDef>, scale: f32, collide: bool) -> Result<Self, String> {\n        let asset = props::canonical(asset)?;\n        validate_scale(scale)?;\n        if props::leaf(&asset) != definition.doc.name {\n            return Err(\"asset reference does not match its embedded definition\".into());\n        }\n        Ok(Self {\n            asset,\n            definition,\n            scale,\n            collide,\n            seed: 0,\n            roles: BTreeMap::new(),\n            params: props::Params::new(),\n            patch: Vec::new(),\n        })\n    }\n\n    /// This copy's variant: chance, jitter and pick resolve with `seed`.\n    pub fn with_seed(mut self, seed: u32) -> Self {\n        self.seed = seed;\n        self\n    }\n\n    /// Colours for the theme roles its parts name, e.g. `{\"$wall\":\"#5a6b7c\"}`.\n    pub fn with_roles(mut self, roles: BTreeMap<String, String>) -> Result<Self, String> {\n        validate_roles(&roles)?;\n        self.roles = roles;\n        Ok(self)\n    }\n    pub fn spawn_npc(\n        &mut self,\n        name: &str,\n        feet: Vec3,\n        facing: f32,\n        def: PuppetDef,\n        ai: Option<crate::ai::Ai>,\n        region: Option<crate::statics::RegionKey>,\n    ) -> EntityId {\n        let id = self.spawn_character(name, feet);\n        if let Some(e) = self.state.entities.get_mut(id) {\n            e.region = region;\n            e.ai = ai.map(Box::new);\n            if let Some(ch) = &mut e.character {\n                ch.facing = facing;\n                ch.anim.facing = facing;\n                ch.puppet = Some(std::sync::Arc::new(def));\n            }\n        }\n        id\n    }\n\n    /// A character's kinematic capsule (when it is created or wakes up).\n    pub(crate) fn character_body(&mut self, id: EntityId, center: Vec3, posture: character::Posture) -> RigidBodyHandle {\n        let body = RigidBodyBuilder::kinematic_position_based().translation(center);\n        let collider =\n            ColliderBuilder::capsule_y(posture.half_height() as Real, RADIUS as Real).friction(0.0).user_data(entity_tag(id.0));\n        self.state.physics.insert(body, collider).0\n    }\n\n    /// Spawns the player at the scene's spawn point and makes the camera follow it.\n    pub fn spawn_player(&mut self) -> EntityId {\n        let id = self.spawn_character(\"player\", self.state.spawn);\n49:pub struct AnimParams {\n80:pub struct Key {\n127:pub struct Clip {\n156:pub struct ClipSet {\n182:    pub fn parse(text: &str) -> Result<Self, String> {\n226:    pub fn text(&self) -> String {\n257:    pub fn text(&self) -> String {\n287:    pub fn to_text(&self) -> String {\n323:    pub fn key_at(&self, t: f32) -> Key {\n330:    pub fn key_at_clamped(&self, t: f32) -> Key {\n350:    pub fn travels(&self) -> bool {\n364:pub fn lerp_key(a: &Key, b: &Key, u: f32) -> Key {\n385:pub fn mirror(k: &Key) -> Key {\n412:pub fn euler(a: [f32; 3]) -> Quat {\n473:pub fn hip_height(def: &PuppetDef) -> f32 {\n480:pub fn walk_rate(def: &PuppetDef, id: u32, ground_speed: f32) -> f32 {\n486:pub fn pace(def: &PuppetDef, id: u32) -> Option<f32> {\n491:pub fn walk_pace(def: &PuppetDef) -> Option<f32> {\n503:pub fn run_over_walk(def: &PuppetDef, walk: u32, run: u32, ground_speed: f32, running: bool) -> bool {\n515:pub fn strike_time(id: u32) -> Option<f32> {\n557:pub fn attack_clip(def: &PuppetDef, skill: &str, combo: u32) -> Option<(u32, f32)> {\n567:pub fn is_attack(def: &PuppetDef, id: u32) -> bool {\n574:pub fn death_clip(def: &PuppetDef) -> Option<(u32, f32, f32)> {\n585:pub fn missing(def: &PuppetDef) -> Vec<String> {\n591:pub fn skel(def: &PuppetDef, k: &Key, travel: bool) -> Skel {\npub struct Character {\n    pub vel: Vec3,\n    pub grounded: bool,\n    pub air_time: f32,\n    pub since_jump_press: f32,\n    pub jumping: bool,\n    pub posture: Posture,\n    pub crawl_toggle: bool,\n    pub climbing: Option<Ladder>,\n    /// Yaw in radians (0 = facing +Z).\n    pub facing: f32,\n    pub anim: PuppetState,\n    pub bomb_cooldown: f32,\n    /// Knockback applied on the next tick (explosions, hits).\n    pub impulse: Vec3,\n    #[serde(default)]\n    pub hang: Option<Hang>,\n    /// Seconds without ledge grabbing (after letting go).\n    #[serde(default)]\n    pub hang_cooldown: f32,\n    /// Committed model: dodge roll time left and direction.\n    #[serde(default)]\n    pub roll: f32,\n    #[serde(default)]\n    pub roll_dir: Vec3,\n    /// Grid model: tile centre being walked to, and ticks spent blocked.\n    #[serde(default)]\n    pub grid_target: Option<Vec3>,\n    #[serde(default)]\n    pub grid_blocked: u32,\n    /// Grid: pace of the current step (how far the stick was pushed when it began).\n    #[serde(default)]\n    pub grid_pace: f32,\n    /// Water depth at the feet (0 = dry) and whether swimming.\n    #[serde(default)]\n    pub water_depth: f32,\n//! Game objects. An entity is one \"fat\" struct with optional parts, which keeps it cloneable\n//! (for snapshots), serializable (for agents) and easy to extend: add a field.\n\nuse std::collections::{BTreeMap, VecDeque};\n\nuse glam::{Quat, Vec3};\nuse rapier::prelude::*;\nuse serde::{Deserialize, Serialize};\n\nuse crate::character::Character;\nuse crate::shape::Visual;\nuse crate::statics::RegionKey;\n\n/// Physical surface properties (kept so sleeping entities can be recreated).\n#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]\npub struct Material {\n    pub density: f32,\n    pub friction: f32,\n    pub restitution: f32,\n    /// Linear and angular damping (air drag): calms chains and bridges.\n    #[serde(default)]\n    pub damping: f32,\n}\n\nimpl Default for Material {\n    fn default() -> Self {\n        Self { density: 1.0, friction: 0.5, restitution: 0.0, damping: 0.0 }\n    }\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord, Serialize, Deserialize)]\npub struct EntityId(pub u32);\n\n/// Simple scripted behaviours usable from scenes and room files.\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\n#[serde(tag = \"type\", rename_all = \"snake_case\")]\npub enum Behavior {\n    #[default]\n    None,\n    /// Drops random props over an area, keeping at most `max` alive.\n}\n\n/// Where the ears are: position and the camera's right vector (for panning).\n#[derive(Clone, Copy, Debug)]\npub struct Listener {\n    pub pos: Vec3,\n    pub right: Vec3,\n}\n\nimpl Default for Listener {\n    fn default() -> Self {\n        Self { pos: Vec3::ZERO, right: Vec3::X }\n    }\n}\n\n/// The sound bank: which patches play for a simulation event.\npub fn sounds_for(ev: &SimEvent) -> Vec<(Patch, f32)> {\n    use Wave::*;\n    match ev {\n        SimEvent::Jump { .. } => vec![(\n            Patch {\n                freq_end: 640.0,\n                glide: 0.11,\n                decay: 0.12,\n                volume: 0.18,\n                cutoff: 3500.0,\n                cutoff_end: 2500.0,\n                duty: 0.3,\n                ..Patch::new(Square, 280.0)\n            },\n            0.0,\n        )],\n        SimEvent::Land { speed, .. } => {\n            let v = (speed / 14.0).clamp(0.15, 1.0);\n            vec![\n                (Patch { decay: 0.12, volume: 0.35 * v, cutoff: 1100.0, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) }, 0.0),\n                (Patch { freq_end: 45.0, glide: 0.1, decay: 0.14, volume: 0.45 * v, ..Patch::new(Sine, 110.0) }, 0.0),\n            ]\n        }\n        SimEvent::Step { .. } => {\n            vec![(Patch { decay: 0.045, volume: 0.07, cutoff: 1800.0, cutoff_end: 500.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n        }\n        SimEvent::Throw { .. } => vec![(\n            Patch { attack: 0.03, decay: 0.16, volume: 0.1, cutoff: 900.0, cutoff_end: 4500.0, ..Patch::new(Noise, 1.0) },\n            0.0,\n        )],\n        SimEvent::Explosion { radius, .. } => {\n            let v = (radius / 1.35).clamp(0.5, 2.0);\n            vec![\n                (\n                    Patch {\n                        attack: 0.004,\n                        decay: 0.25,\n                        sustain: 0.35,\n                        hold: 0.1,\n                        release: 0.6,\n                        volume: 0.6 * v,\n                        volume: 0.6 * v,\n                        cutoff: 4000.0,\n                        cutoff_end: 120.0,\n                        ..Patch::new(Noise, 1.0)\n                    },\n                    0.0,\n                ),\n                (Patch { freq_end: 28.0, glide: 0.5, decay: 0.7, volume: 0.7 * v, ..Patch::new(Sine, 85.0) }, 0.0),\n            ]\n        }\n        SimEvent::EnterRoom { .. } => vec![\n            (Patch { decay: 0.25, volume: 0.12, ..Patch::new(Triangle, 659.3) }, 0.0),\n            (Patch { decay: 0.35, volume: 0.12, ..Patch::new(Triangle, 987.8) }, 0.09),\n        ],\n        SimEvent::Hit { strength, .. } => {\n            let v = (strength / 8.0).clamp(0.4, 1.2);\n            vec![\n                (Patch { decay: 0.09, volume: 0.3 * v, cutoff: 2500.0, cutoff_end: 300.0, ..Patch::new(Noise, 1.0) }, 0.0),\n                (\n                    Patch { freq_end: 90.0, glide: 0.12, decay: 0.16, volume: 0.3 * v, duty: 0.4, ..Patch::new(Square, 220.0) },\n                    0.0,\n                ),\n            ]\n        }\n        // Shardfall.\n        SimEvent::Swing { heavy, .. } => {\n            let h = if *heavy { 1.4 } else { 1.0 };\n            vec![(\n                Patch {\n                    attack: 0.02,\n                    decay: 0.12 * h,\n                    volume: 0.16 * h,\n                    cutoff: 1800.0,\n                    cutoff_end: 5200.0,\n                    ..Patch::new(Noise, 1.0)\n                },\n                0.0,\n            )]\n        }\n        SimEvent::Strike { power, element, crit, .. } => {\n            let v = (power.sqrt() / 4.0).clamp(0.35, 1.2) * if *crit { 1.3 } else { 1.0 };\n            let tone = [150.0, 120.0, 520.0, 900.0, 260.0][(*element as usize).min(4)];\n            let mut out = vec![\n                (Patch { decay: 0.07, volume: 0.24 * v, cutoff: 3200.0, cutoff_end: 400.0, ..Patch::new(Noise, 1.0) }, 0.0),\n                (\n                    Patch {\n                        freq_end: tone * 0.5,\n                        glide: 0.08,\n                        decay: 0.1,\n                        volume: 0.2 * v,\n                        duty: 0.35,\n                        ..Patch::new(Square, tone)\n                    },\n                    0.0,\n                ),\n            ];\n            if *crit {\n                out.push((Patch { decay: 0.18, volume: 0.12, ..Patch::new(Triangle, 1760.0) }, 0.01));\n            }\n            out\n        }\n        SimEvent::Slain { size, .. } => {\n            let k = size.clamp(0.3, 1.5);\n            vec![\n                (\n                    Patch {\n                        freq_end: 60.0,\n                        glide: 0.3,\n                        decay: 0.3,\n                        volume: 0.22 * k,\n                        duty: 0.5,\n                        ..Patch::new(Square, 180.0 / k)\n                    },\n                    0.0,\n                ),\n                (Patch { decay: 0.25, volume: 0.15, cutoff: 1500.0, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) }, 0.02),\n            ]\n   Compiling web-time v1.1.0\n   Compiling egui-wgpu v0.36.2\n   Compiling egui v0.36.2\n   Compiling pav_render v0.1.0 (/home/mich