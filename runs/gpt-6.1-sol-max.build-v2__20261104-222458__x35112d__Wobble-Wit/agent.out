,\n   5=>{if slot%2==0{voice(&mut out,root+12+degrees[((n*3+bar)%8)as usize],Wave::Triangle,0.15,0.13);}if slot%4==0{voice(&mut out,root-12,Wave::Sine,0.14,0.15);}},\n   6=>{if slot%4==0{voice(&mut out,root+12+degrees[((n/4)%6)as usize],Wave::Square,0.06,0.24);voice(&mut out,root-12,Wave::Triangle,0.14,0.2);}if slot%2==1{let mut p=Patch::new(Wave::Noise,1.);p.bus=1;p.volume=0.07;p.decay=0.075;p.cutoff=2200.;out.push(p);}},\n-rw-r--r-- 1 micha micha    0 Nov  4 22:54 notes/core-result.log\n-rw-r--r-- 1 micha micha 1.3K Nov  4 22:54 notes/test-audio-ui.log\n-rw-r--r-- 1 micha micha 3.9K Nov  4 22:53 notes/test-core.log\n","exit_code":0,"status":"completed"}}
