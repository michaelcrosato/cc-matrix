           focus_is_player:','            focus: fit_game.map(|g|g.camera_focus(self,self.state.focus)).unwrap_or(self.state.focus),\\\\n            focus_is_player:',1);p.write_text(s)\np=Path('engine/crates/pav_ui/src/fit_ui.rs');s=p.read_text().replace('  if matches\"'!(u.screen.as_str(),\"Card\"|\"Pass\"|\"Look\"|\"Wardrobe\") {'\"','''  if u.screen==\\\"Card\\\"{c.text(109.,386.,&u.coach,29.,TEAL,false);if let Some(line)=u.lines.first(){c.wrap(108.,437.,line,42.,900.,INK,true);}c.wrap(109.,618.,&u.prompt,34.,900.,MUTED,false);}\n  if matches\"'!(u.screen.as_str(),\"Card\"|\"Pass\"|\"Look\"|\"Wardrobe\") {'\"''');p.write_text(s)\np=Path('engine/crates/pav_core/src/games/fit/sets/hub.toml');s=p.read_text()+'''\\\\n[[npc]]\nname = \\\"guest_0_twin\\\"\nkind = \\\"biped\\\"\npos = [24.3,0.3,13.0]\nlook = { skin = \\\"#cf946e\\\", shirt = \\\"#faf8ee\\\", pants = \\\"#faf8ee\\\", shoes = \\\"#c99872\\\", scale = 0.9, gear = { helm = \\\"hood\\\", helm_color = \\\"#fbfaf6\\\" } }\n''';p.write_text(s)\n# Move each buoy pair to the end of its steering segment.\np=Path('engine/crates/pav_core/src/games/fit/sets/channel.toml');s=p.read_text();import re,json\nlines=s.splitlines();in_buoy=False\nfor n,line in enumerate(lines):\n if line.startswith('name = '):in_buoy='buoy' in line\n if in_buoy and line.startswith('pos = '):coords=json.loads(line[6:]);coords[2]-=8;lines[n]='pos = '+json.dumps(coords)\np.write_text('\\\\n'.join(lines)+'\\\\n')\np=Path('tools/make-art.py');s=p.read_text().replace(\\\"('fit_buoy'\\\", \\\"('fit_buoy'\\\") # source changes below preserve generated layout\ns=s.replace(\\\"P(x+side*1.5,0,-j*8.)\\\",\\\"P(x+side*1.5,0,-(j+1)*8.)\\\").replace(\\\"[(-2,5),(4,5),(7,1),(-9,14)]\\\",\\\"[(-2,5),(4,5),(7,1),(8.3,1),(-9,14)]\\\");p.write_text(s)\nPY\ncat >> notes/feedback.md <<'EOF'\n- Speed-dependent paddle testing found gate penalties were checking the newly selected gate instead of the one just passed. Corrected the boundary check and aligned buoy pai