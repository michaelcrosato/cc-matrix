{"type":"item.started","item":{"id":"item_92","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('engine/crates/pav_core/src/games/fit/events/mod.rs');s=p.read_text();s=s.replace('90.,60.,45.,50.,40.,142.,65.','120.,60.,75.,50.,40.,142.,65.')\ns=s.replace('[\\\"The Patient Heron\\\",\\\"The Apologetic Lunge\\\",\\\"The Tired Lighthouse\\\"][(t/20.)as usize%3]','[\\\"The Patient Heron\\\",\\\"The Apologetic Lunge\\\",\\\"The Tired Lighthouse\\\",\\\"The Folded Deck Chair\\\",\\\"The Reluctant Bridge\\\",\\\"Seated Disappointment\\\"][((t/20.)as usize+if self.kind==Kind::Pose{self.phase as usize}else{0})%6]')\ns=s.replace('self.progress=(t/90.).min(1.);self.target.x=ribbon/1.2;self.radius=0.22;','''let previous=self.progress;self.progress=(self.progress+dt/90.*(self.pace/2.).clamp(0.25,1.3)).min(1.);self.target.x=ribbon/1.2;self.radius=0.22;\n                for n in 0..6{let crab=(n as f32+0.5)/6.;let side=(n as f32*1.6+self.core.phase[0]).sin()*0.8;if previous<crab&&self.progress>=crab&&(self.side-side).abs()<0.45{self.misses+=1;events.push(SimEvent::Sfx{id:10,gain:0.55,pitch:1.4});}let ribbon=(n as f32+0.25)/6.;let side=(ribbon*90.*0.38).sin()*0.85;if previous<ribbon&&self.progress>=ribbon&&(self.side-side).abs()<0.4{self.metrics[0]+=1.;events.push(SimEvent::Sfx{id:20,gain:0.5,pitch:1.2});}}\n                if self.progress>=1.{self.finished=true;}''')\ns=s.replace('self.progress=(t/45.).min(1.);let gate=(self.progress*9.).floor()as i32;','self.progress=(self.progress+dt/45.*(0.55+cob.y).clamp(0.2,1.5)).min(1.);if self.progress>=1.{self.finished=true;}let gate=(self.progress*9.).floor().min(8.)as i32;')\ns=s.replace('let cycle=local%1.2;self.guide=0.5-0.5*(TAU*cycle/1.2).cos();','let cycle=local%1.2;self.guide=0.5+0.5*(TAU*cycle/1.2).sin();')\ns=s.replace('Kind::Paddle=>{target=Vec2::new(Self::gate(((t/45.)*9.).floor()as i32),0.5);}','Kind::Paddle=>{target=Vec2::new(Self::gate((self.progress*9.).floor().min(8.)