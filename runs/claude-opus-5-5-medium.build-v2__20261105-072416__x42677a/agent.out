mut self, key: &str, v: f32) -> bool {\n                match key { $(stringify!($field) => { self.$field = v; true })* _ => false }\n            }\n        }\n    };\n}\n\ntune! {\n    drain: \"Vitals drain ×\", 0.0, 3.0, 1.0;\n    timer: \"Timer ×\", 0.25, 3.0, 1.0;\n    tool_power: \"Tool power ×\", 0.25, 3.0, 1.0;\n    iv_heal: \"IV heal ×\", 0.0, 3.0, 1.0;\n    strain_speed: \"Strain speed ×\", 0.25, 2.5, 1.0;\n    strain_tough: \"Strain toughness ×\", 0.25, 3.0, 1.0;\n    coupling: \"Heart coupling\", 0.0, 2.0, 1.0;\n    beat_ms: \"On-beat window (ms)\", 20.0, 300.0, 110.0;\n    cursor_speed: \"Cursor speed ×\", 0.3, 2.5, 1.0;\n    aim_assist: \"Aim assist\", 0.0, 1.0, 1.0;\n    gift_gain: \"Gift gain ×\", 0.0, 4.0, 1.0;\n    gift_dur: \"Gift duration ×\", 0.25, 3.0, 1.0;\n    hush_scale: \"Hush time scale\", 0.1, 1.0, 0.3;\n    echo_secs: \"Echo duration (s)\", 2.0, 30.0, 10.0;\n    chain_window: \"Chain window (s)\", 2.0, 30.0, 9.0;\n    strictness: \"Rating strictness ×\", 0.25, 3.0, 1.0;\n    wrong_penalty: \"Wrong-tool penalty\", 0.0, 10.0, 0.0;\n    code_window: \"Code window (s)\", 1.0, 15.0, 5.0;\n    score: \"Score ×\", 0.25, 4.0, 1.0;\n}\n\n/// Case difficulty: multipliers on drains, timer and strain speed, plus the Codes allowed.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum Difficulty {\n    Resident,\n    #[default]\n    Attending,\n    Chief,\n}\n\nimpl Difficulty {\n    pub const ALL: [Difficulty; 3] = [Difficulty::Resident, Difficulty::Attending, Difficulty::Chief];\n    pub fn name(self) -> &'static str {\n        match self {\n            Difficulty::Resident => \"Resident\",\n            Difficulty::Attending => \"Attending\",\n            Difficulty::Chief => \"Chief\",\n        }\n    }\n    pub fn from_name(n: &str) -> Option<Self> {\n        Self::ALL.into_iter().find(|d| d.name().eq_ignore_ascii_case(n))\n    }\n    pub fn drain(self) -> f32 {\n        match self {\n            Difficulty::Resident => 0.75,\n            Difficulty::Attending => 1.0,\n            Difficulty::Chief => 1.3,\n        }\n    }\n    pub fn timer(self) -> f32 {\n        match self {\n            Difficulty::Resident => 1.3,\n            Difficulty::Attending => 1.0,\n            Difficulty::Chief => 0.85,\n        }\n    }\n    pub fn strain(self) -> f32 {\n        match self {\n            Difficulty::Resident => 0.85,\n            Difficulty::Attending => 1.0,\n            Difficulty::Chief => 1.15,\n        }\n    }\n    pub fn codes(self) -> u8 {\n        match self {\n            Difficulty::Resident => 2,\n            Difficulty::Attending => 1,\n            Difficulty::Chief => 0,\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01BvR5nmz77U95fM1fxgDaV9","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjwNwmgi429FYzHCN1NT","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013htKXWmcaYatsNczChu97w","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery/content.rs","content":"//! The game's text data: cases, story, plates, rigs and sets. Native builds read the file on\n//! disk when running from the repository (edits show at the next load, or `reload`); every\n//! build also embeds a copy (the browser has no files). A broken file names itself and its line.\n\nuse std::collections::BTreeMap;\nuse std::sync::{Arc, OnceLock, RwLock};\n\nuse anyhow::{Result, anyhow, bail};\nuse serde::Deserialize;\n\nconst DIR: &str = \"crates/pav_core/src/games/surgery/content\";\n\nmacro_rules! files {\n    ($($p:literal),* $(,)?) => { &[$(($p, include_str!(concat!(\"content/\", $p)))),*] };\n}\n\n/// Every content file, embedded. A test checks this list against the folder on disk.\npub const FILES: &[(&str, &str)] = files![\n    \"callouts.toml\",\n    \"cases/case0.toml\",\n    \"cases/case1.toml\",\n    \"cases/case2.toml\",\n    \"cases/case3.toml\",\n    \"cases/case4.toml\",\n    \"cases/case5.toml\",\n    \"cases/case6.toml\",\n    \"cases/case7.toml\",\n    \"cases/codeblue.toml\",\n    \"plates/abdomen.toml\",\n    \"plates/bowel.toml\",\n    \"plates/chest.toml\",\n    \"plates/femur.toml\",\n    \"plates/forearm.toml\",\n    \"plates/heart.toml\",\n    \"plates/liver.toml\",\n    \"plates/lung.toml\",\n    \"plates/pericardium.toml\",\n    \"plates/torso.toml\",\n    \"rigs/_face.toml\",\n    \"rigs/bashir.toml\",\n    \"rigs/mara.toml\",\n    \"rigs/pet.toml\",\n    \"rigs/teddy.toml\",\n    \"rigs/vane.toml\",\n    \"rigs/voss.toml\",\n    \"sets/atrium.toml\",\n    \"sets/cabin.toml\",\n    \"sets/corridor.toml\",\n    \"sets/depot.toml\",\n    \"sets/nightward.toml\",\n    \"sets/office.toml\",\n    \"sets/recovery.toml\",\n    \"sets/scrub.toml\",\n    \"story/case0.toml\",\n    \"story/case1.toml\",\n    \"story/case2.toml\",\n    \"story/case3.toml\",\n    \"story/case4.toml\",\n    \"story/case5.toml\",\n    \"story/case6.toml\",\n    \"story/case7.toml\",\n];\n\n/// A content file's text: the copy on disk when there is one, else the embedded one.\npub fn content_text(path: &str, built_in: &'static str) -> std::borrow::Cow<'static, str> {\n    #[cfg(not(target_arch = \"wasm32\"))]\n    if let Ok(text) = std::fs::read_to_string(format!(\"{DIR}/{path}\")) {\n        return text.into();\n    }\n    let _ = (path, DIR);\n    built_in.into()\n}\n\n// ------------------------------------------------------------------------------------------\n// Cases\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct SpawnSpec {\n    pub kind: String,\n    pub a: Option<[f32; 2]>,\n    pub b: Option<[f32; 2]>,\n    pub c: Option<[f32; 2]>,\n    pub r: Option<f32>,\n    pub ang: Option<f32>,\n    pub hidden: bool,\n    pub sub: u8,\n    pub drain: Option<f32>,\n    /// Not needed to clear the phase (it still drains until dealt with).\n    pub optional: bool,\n    pub stage: u8,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Say {\n    pub who: String,\n    pub text: String,\n    /// Seconds after the phase starts.\n    pub at: f32,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Trigger {\n    pub at_time: Option<f32>,\n    pub vitals_below: Option<f32>,\n    /// Fires once the phase's blocking hazards are gone, and holds the phase open for its spawns.\n    pub on_clear: bool,\n    /// The n-th heartbeat of this phase.\n    pub on_beat: Option<u32>,\n    pub spawn: Vec<SpawnSpec>,\n    pub say: Vec<Say>,\n    pub cue: Option<String>,\n    pub banner: Option<String>,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Phase {\n    pub name: String,\n    /// The HUD's NOW line.\n    pub now: String,\n    /// Highlight the targets on the field and let Bashir teach.\n    pub guide: bool,\n    pub checkpoint: bool,\n    pub spawn: Vec<SpawnSpec>,\n    pub say: Vec<Say>,\n    pub trigger: Vec<Trigger>,\n    pub strain: Option<String>,\n    /// Strain numbers: `waves`, `count`, `mini`, `meter`...\n    pub params: BTreeMap<String, f32>,\n    /// The ECG's meter while this phase runs (beats to a bar).\n    pub meter: Option<u8>,\n    pub reveal_plate: Option<String>,\n    /// The heart stops on purpose: this many shocks, which don't use up the case's Codes.\n    pub code_shocks: u8,\n    /// Seconds to hold before the next phase (a beat of drama after clearing).\n    pub linger: f32,\n    pub banner: Option<String>,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Case {\n    pub name: String,\n    pub surgeon: String,\n    pub plate: String,\n    /// The instrument on each of the 8 ring directions, clockwise from up.\n    pub ring: Vec<String>,\n    pub timer: f32,\n    pub par: f32,\n    pub vitals: f32,\n    pub patient: String,\n    pub life: String,\n    pub diagnosis: String,\n    pub fate: String,\n    pub before: Option<String>,\n    pub after: Option<String>,\n    /// none | hush | echo | duet\n    pub gift: String,\n    /// The gift wakes during the case (it has no meter until then).\n    pub gift_locked: bool,\n    pub music: String,\n    pub phase: Vec<Phase>,\n}\n\n// ------------------------------------------------------------------------------------------\n// Story\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Line {\n    pub who: Option<String>,\n    pub expr: Option<String>,\n    pub text: Option<String>,\n    pub set: Option<String>,\n    /// Bring a rig on stage: `enter = \"mara\"`, at `x`.\n    pub enter: Option<String>,\n    pub x: Option<f32>,\n    pub exit: Option<String>,\n    pub music: Option<String>,\n    pub cue: Option<String>,\n    /// `paper` or `or_wide`.\n    pub camera: Option<String>,\n    pub flash: Option<f32>,\n    pub shake: Option<f32>,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Scene {\n    pub id: String,\n    pub line: Vec<Line>,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct StoryFile {\n    pub scene: Vec<Scene>,\n}\n\n// ------------------------------------------------------------------------------------------\n// Plates\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Lobe {\n    pub x: f32,\n    pub z: f32,\n    pub a: f32,\n    pub b: f32,\n    pub h: f32,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Vessel {\n    pub points: Vec<[f32; 2]>,\n    pub w: f32,\n    pub h: f32,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Plate {\n    pub name: String,\n    pub lobes: Vec<Lobe>,\n    pub vessels: Vec<Vessel>,\n    pub bed: String,\n    pub flesh: String,\n    pub top: String,\n    pub vein: String,\n    pub pulse: f32,\n    pub noise: f32,\n    /// Vein amount (0..1).\n    pub veins: f32,\n    /// A hard band like bone (a long lobe's top, ivory colour).\n    pub bone: bool,\n}\n\n// ------------------------------------------------------------------------------------------\n// Rigs\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct RigPart {\n    pub name: String,\n    pub z: f32,\n    /// A colour name from `[colors]`, or \"#rrggbb\".\n    pub color: String,\n    pub chaikin: u8,\n    pub points: Vec<[f32; 2]>,\n    /// Also draw a copy mirrored across x = 0.\n    pub mirror: bool,\n    /// Which animation moves it: \"\" (body), head, eyes, brow, hair, lid\n    pub layer: String,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Expr {\n    pub brow_y: f32,\n    pub brow_rot: f32,\n    /// How open the eyes are (1 = neutral).\n    pub eye: f32,\n    /// Pupil size (1 = neutral).\n    pub pupil: f32,\n    /// closed | smile | frown | flat | open\n    pub mouth: String,\n    pub tilt: f32,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Voice {\n    pub base: f32,\n    /// sine | triangle | square | saw\n    pub wave: String,\n    pub speed: f32,\n    pub jitter: f32,\n    pub bright: f32,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Rig {\n    pub id: String,\n    pub name: String,\n    pub colors: BTreeMap<String, String>,\n    pub part: Vec<RigPart>,\n    pub expr: BTreeMap<String, Expr>,\n    pub voice: Voice,\n    pub scale: f32,\n}\n\n// ------------------------------------------------------------------------------------------\n// Sets\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Card {\n    pub z: f32,\n    pub color: String,\n    pub points: Vec<[f32; 2]>,\n    /// A rectangle `[x0, y0, x1, y1]` instead of points.\n    pub rect: Option<[f32; 4]>,\n    pub emissive: f32,\n    pub chaikin: u8,\n    /// Blinks (monitors).\n    pub blink: f32,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Set {\n    pub id: String,\n    pub name: String,\n    pub back: String,\n    pub rain: f32,\n    pub lamp: String,\n    pub card: Vec<Card>,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Callout {\n    pub who: String,\n    pub text: Vec<String>,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(default)]\npub struct Callouts {\n    pub callout: BTreeMap<String, Callout>,\n}\n\n// ------------------------------------------------------------------------------------------\n\n/// Everything loaded. Read-only during play; game state holds indices into it.\n#[derive(Debug, Default)]\npub struct Content {\n    /// Cases 0..=7 in order, then Code Blue.\n    pub cases: Vec<Case>,\n    pub scenes: Vec<Scene>,\n    pub plates: BTreeMap<String, Plate>,\n    pub plate_order: Vec<String>,\n    pub rigs: BTreeMap<String, Rig>,\n    pub rig_order: Vec<String>,\n    pub sets: BTreeMap<String, Set>,\n    pub set_order: Vec<String>,\n    pub callouts: BTreeMap<String, Callout>,\n    /// Shared face parts of every rig (`rigs/_face.toml`).\n    pub face: Rig,\n}\n\n/// The case index of Code Blue.\npub const CODE_BLUE: usize = 8;\n\npub const MUSIC: &[&str] =\n    &[\"none\", \"title\", \"tender\", \"tense\", \"or\", \"introit\", \"lacrimosa\", \"dies\", \"libera\", \"codeblue\", \"results\"];\n\npub fn music_id(name: &str) -> u8 {\n    MUSIC.iter().position(|m| *m == name).unwrap_or(0) as u8\n}\n\nfn parse<T: serde::de::DeserializeOwned>(path: &str, text: &str) -> Result<T> {\n    toml::from_str(text).map_err(|e| {\n        let line = e.span().map(|s| text[..s.start.min(text.len())].lines().count().max(1));\n        anyhow!(\"{path}{}: {}\", line.map(|l| format!(\" line {l}\")).unwrap_or_default(), e.message())\n    })\n}\n\n/// Loads every file (disk first, embedded otherwise).\npub fn load() -> Result<Content> {\n    let mut c = Content::default();\n    let mut cases: BTreeMap<String, Case> = BTreeMap::new();\n    for (path, built_in) in FILES {\n        let text = content_text(path, built_in);\n        let (dir, file) = path.split_once('/').unwrap_or((\"\", path));\n        let stem = file.trim_end_matches(\".toml\").to_string();\n        match dir {\n            \"cases\" => {\n                cases.insert(stem, parse(path, &text)?);\n            }\n            \"story\" => {\n                let s: StoryFile = parse(path, &text)?;\n                c.scenes.extend(s.scene);\n            }\n            \"plates\" => {\n                let p: Plate = parse(path, &text)?;\n                c.plate_order.push(stem.clone());\n                c.plates.insert(stem, p);\n            }\n            \"rigs\" => {\n                let mut r: Rig = parse(path, &text)?;\n                r.id = stem.clone();\n                if stem == \"_face\" {\n                    c.face = r;\n                } else {\n                    c.rig_order.push(stem.clone());\n                    c.rigs.insert(stem, r);\n                }\n            }\n            \"sets\" => {\n                let mut s: Set = parse(path, &text)?;\n                s.id = stem.clone();\n                c.set_order.push(stem.clone());\n                c.sets.insert(stem, s);\n            }\n            \"\" => {\n                let cs: Callouts = parse(path, &text)?;\n                c.callouts = cs.callout;\n            }\n            other => bail!(\"{path}: unknown content folder '{other}'\"),\n        }\n    }\n    for k in 0..8 {\n        let name = format!(\"case{k}\");\n        c.cases.push(cases.remove(&name).ok_or_else(|| anyhow!(\"cases/{name}.toml is missing\"))?);\n    }\n    c.cases.push(cases.remove(\"codeblue\").ok_or_else(|| anyhow!(\"cases/codeblue.toml is missing\"))?);\n    Ok(c)\n}\n\nstatic CONTENT: OnceLock<RwLock<Arc<Content>>> = OnceLock::new();\n\n/// The loaded content (loads on first use; a broken embedded file is a programming error).\npub fn content() -> Arc<Content> {\n    let lock = CONTENT.get_or_init(|| RwLock::new(Arc::new(load().unwrap_or_else(|e| panic!(\"surgery content: {e:#}\")))));\n    lock.read().unwrap().clone()\n}\n\n/// Reads the files again (the dev panel's \"reload content\", native only). Keeps the old content\n/// and returns the error when a file is broken.\npub fn reload() -> Result<()> {\n    let fresh = load()?;\n    lint(&fresh).map_err(|e| anyhow!(e.join(\"\\n\")))?;\n    let _ = content();\n    *CONTENT.get().unwrap().write().unwrap() = Arc::new(fresh);\n    Ok(())\n}\n\npub const SPAWN_KINDS: &[&str] = &[\n    \"incision\", \"lacer\", \"pool\", \"bleeder\", \"object\", \"polyp\", \"tumor\", \"patch\", \"burn\", \"bone\", \"closure\",\n];\n\npub const TOOLS: &[&str] = &[\"scalpel\", \"forceps\", \"suture\", \"suction\", \"laser\", \"gel\", \"scanner\", \"iv\", \"cryo\", \"dressing\", \"defib\"];\n\npub const STRAINS: &[&str] = &[\"introit\", \"lacrimosa\", \"dies\", \"soloist\", \"tendril\", \"director\"];\n\n/// Every reference and required field in the content; empty when clean.\npub fn lint(c: &Content) -> Result<(), Vec<String>> {\n    let mut e = Vec::new();\n    let speaker = |who: &str| c.rigs.contains_key(who);\n    for (i, case) in c.cases.iter().enumerate() {\n        let tag = format!(\"case {i} ({})\", case.name);\n        if !c.plates.contains_key(&case.plate) {\n            e.push(format!(\"{tag}: unknown plate '{}'\", case.plate));\n        }\n        if !speaker(&case.surgeon) {\n            e.push(format!(\"{tag}: unknown surgeon '{}'\", case.surgeon));\n        }\n        if !case.ring.is_empty() && case.ring.len() != 8 {\n            e.push(format!(\"{tag}: the ring needs 8 instruments\"));\n        }\n        for t in &case.ring {\n            if !TOOLS.contains(&t.as_str()) {\n                e.push(format!(\"{tag}: unknown instrument '{t}'\"));\n            }\n        }\n        if case.phase.is_empty() {\n            e.push(format!(\"{tag}: no phases\"));\n        }\n        for (name, kind) in [(&case.before, \"before\"), (&case.after, \"after\")] {\n            if let Some(n) = name {\n                if !c.scenes.iter().any(|s| s.id == *n) {\n                    e.push(format!(\"{tag}: {kind} names unknown scene '{n}'\"));\n                }\n            }\n        }\n        if !MUSIC.contains(&case.music.as_str()) {\n            e.push(format!(\"{tag}: unknown music '{}'\", case.music));\n        }\n        if ![\"none\", \"hush\", \"echo\", \"duet\"].contains(&case.gift.as_str()) {\n            e.push(format!(\"{tag}: unknown gift '{}'\", case.gift));\n        }\n        for p in &case.phase {\n            let ptag = format!(\"{tag} phase '{}'\", p.name);\n            let says = p.say.iter().chain(p.trigger.iter().flat_map(|t| t.say.iter()));\n            for s in says {\n                if !speaker(&s.who) {\n                    e.push(format!(\"{ptag}: unknown speaker '{}'\", s.who));\n                }\n                if s.text.trim().is_empty() {\n                    e.push(format!(\"{ptag}: empty line\"));\n                }\n            }\n            for s in p.spawn.iter().chain(p.trigger.iter().flat_map(|t| t.spawn.iter())) {\n                if !SPAWN_KINDS.contains(&s.kind.as_str()) {\n                    e.push(format!(\"{ptag}: unknown hazard '{}'\", s.kind));\n                }\n            }\n            if let Some(r) = &p.reveal_plate {\n                if !c.plates.contains_key(r) {\n                    e.push(format!(\"{ptag}: unknown plate '{r}'\"));\n                }\n            }\n            if let Some(s) = &p.strain {\n                if !STRAINS.contains(&s.as_str()) {\n                    e.push(format!(\"{ptag}: unknown strain '{s}'\"));\n                }\n            }\n            for t in &p.trigger {\n                if let Some(cue) = &t.cue {\n                    if super::cue::id(cue).is_none() {\n                        e.push(format!(\"{ptag}: unknown cue '{cue}'\"));\n                    }\n                }\n            }\n        }\n    }\n    for s in &c.scenes {\n        for (n, l) in s.line.iter().enumerate() {\n            let tag = format!(\"scene '{}' line {}\", s.id, n + 1);\n            if let Some(who) = &l.who {\n                match c.rigs.get(who) {\n                    None if who != \"narrator\" => e.push(format!(\"{tag}: unknown speaker '{who}'\")),\n                    Some(r) => {\n                        if let Some(x) = &l.expr {\n                            if !r.expr.contains_key(x) {\n                                e.push(format!(\"{tag}: {who} has no expression '{x}'\"));\n                            }\n                        }\n                    }\n                    _ => {}\n                }\n                if l.text.as_deref().unwrap_or(\"\").trim().is_empty() {\n                    e.push(format!(\"{tag}: empty text\"));\n                }\n            }\n            if let Some(t) = &l.text {\n                if t.contains(\"TODO\") {\n                    e.push(format!(\"{tag}: leftover TODO\"));\n                }\n            }\n            if let Some(x) = &l.set {\n                if !c.sets.contains_key(x) {\n                    e.push(format!(\"{tag}: unknown set '{x}'\"));\n                }\n            }\n            for r in [&l.enter, &l.exit].into_iter().flatten() {\n                if !c.rigs.contains_key(r) {\n                    e.push(format!(\"{tag}: unknown rig '{r}'\"));\n                }\n            }\n            if let Some(m) = &l.music {\n                if !MUSIC.contains(&m.as_str()) {\n                    e.push(format!(\"{tag}: unknown music '{m}'\"));\n                }\n            }\n            if let Some(cue) = &l.cue {\n                if super::cue::id(cue).is_none() {\n                    e.push(format!(\"{tag}: unknown cue '{cue}'\"));\n                }\n            }\n        }\n    }\n    for (id, r) in &c.rigs {\n        for need in [\"neutral\", \"alarmed\", \"stern\", \"soft\"] {\n            if !r.expr.contains_key(need) {\n                e.push(format!(\"rig '{id}': missing expression '{need}'\"));\n            }\n        }\n        for p in &r.part {\n            if !p.color.starts_with('#') && !r.colors.contains_key(&p.color) {\n                e.push(format!(\"rig '{id}': part '{}' has unknown colour '{}'\", p.name, p.color));\n            }\n        }\n        for p in &c.face.part {\n            if !p.color.starts_with('#') && !r.colors.contains_key(&p.color) {\n                e.push(format!(\"rig '{id}': face part '{}' needs colour '{}'\", p.name, p.color));\n            }\n        }\n    }\n    for (_, callout) in c.callouts.iter() {\n        if !speaker(&callout.who) {\n            e.push(format!(\"callout: unknown speaker '{}'\", callout.who));\n        }\n    }\n    if e.is_empty() { Ok(()) } else { Err(e) }\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":18212,"cache_read_input_tokens":213461,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18212},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"968e647e-8a2e-47bd-a498-f00ee82d7401","timestamp":"2026-11-05T14:31:26.999Z","request_id":"req_011CgjwNwVomANWJh9TjfHix","wire_tool_inputs":{"toolu_013htKXWmcaYatsNczChu97w":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery/content.rs","content":"//! The game's text data: cases, story, plates, rigs and sets. Native builds read the file on\n//! disk when running from the repository (edits show at the next load, or `reload`); every\n//! build also embeds a copy (the browser has no files). A broken file names itself and its line.\n\nuse std::collections::BTreeMap;\nuse std::sync::{Arc, OnceLock, RwLock};\n\nuse anyhow::{Result, anyhow, bail};\nuse serde::Deserialize;\n\nconst DIR: &str = \"crates/pav_core/src/games/surgery/content\";\n\nmacro_rules! files {\n    ($($p:literal),* $(,)?) => { &[$(($p, include_str!(concat!(\"content/\", $p)))),*] };\n}\n\n/// Every content file, embedded. A test checks this list against the folder on disk.\npub const FILES: &[(&str, &str)] = files![\n    \"callouts.toml\",\n    \"cases/case0.toml\",\n    \"cases/case1.toml\",\n    \"cases/case2.toml\",\n    \"cases/case3.toml\",\n    \"cases/case4.toml\",\n    \"cases/case5.toml\",\n    \"cases/case6.toml\",\n    \"cases/case7.toml\",\n    \"cases/codeblue.toml\",\n    \"plates/abdomen.toml\",\n    \"plates/bowel.toml\",\n    \"plates/chest.toml\",\n    \"plates/femur.toml\",\n    \"plates/forearm.toml\",\n    \"plates/heart.toml\",\n    \"plates/liver.toml\",\n    \"plates/lung.toml\",\n    \"plates/pericardium.toml\",\n    \"plates/torso.toml\",\n    \"rigs/_face.toml\",\n    \"rigs/bashir.toml\",\n    \"rigs/mara.toml\",\n    \"rigs/pet.toml\",\n    \"rigs/teddy.toml\",\n    \"rigs/vane.toml\",\n    \"rigs/voss.toml\",\n    \"sets/atrium.toml\",\n    \"sets/cabin.toml\",\n    \"sets/corridor.toml\",\n    \"sets/depot.toml\",\n    \"sets/nightward.toml\",\n    \"sets/office.toml\",\n    \"sets/recovery.toml\",\n    \"sets/scrub.toml\",\n    \"story/case0.toml\",\n    \"story/case1.toml\",\n    \"story/case2.toml\",\n    \"story/case3.toml\",\n    \"story/case4.toml\",\n    \"story/case5.toml\",\n    \"story/case6.toml\",\n    \"story/case7.toml\",\n];\n\n/// A content file's text: the copy on disk when there is one, else the embedded one.\npub fn content_text(path: &str, built_in: &'static str) -> std::borrow::Cow<'static, str> {\n    #[cfg(not(target_arch = \"wasm32\"))]\n    if let Ok(text) = std::fs::read_to_string(format!(\"{DIR}/{path}\")) {\n        return text.into();\n    }\n    let _ = (path, DIR);\n    built_in.into()\n}\n\n// ------------------------------------------------------------------------------------------\n// Cases\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct SpawnSpec {\n    pub kind: String,\n    pub a: Option<[f32; 2]>,\n    pub b: Option<[f32; 2]>,\n    pub c: Option<[f32; 2]>,\n    pub r: Option<f32>,\n    pub ang: Option<f32>,\n    pub hidden: bool,\n    pub sub: u8,\n    pub drain: Option<f32>,\n    /// Not needed to clear the phase (it still drains until dealt with).\n    pub optional: bool,\n    pub stage: u8,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Say {\n    pub who: String,\n    pub text: String,\n    /// Seconds after the phase starts.\n    pub at: f32,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Trigger {\n    pub at_time: Option<f32>,\n    pub vitals_below: Option<f32>,\n    /// Fires once the phase's blocking hazards are gone, and holds the phase open for its spawns.\n    pub on_clear: bool,\n    /// The n-th heartbeat of this phase.\n    pub on_beat: Option<u32>,\n    pub spawn: Vec<SpawnSpec>,\n    pub say: Vec<Say>,\n    pub cue: Option<String>,\n    pub banner: Option<String>,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Phase {\n    pub name: String,\n    /// The HUD's NOW line.\n    pub now: String,\n    /// Highlight the targets on the field and let Bashir teach.\n    pub guide: bool,\n    pub checkpoint: bool,\n    pub spawn: Vec<SpawnSpec>,\n    pub say: Vec<Say>,\n    pub trigger: Vec<Trigger>,\n    pub strain: Option<String>,\n    /// Strain numbers: `waves`, `count`, `mini`, `meter`...\n    pub params: BTreeMap<String, f32>,\n    /// The ECG's meter while this phase runs (beats to a bar).\n    pub meter: Option<u8>,\n    pub reveal_plate: Option<String>,\n    /// The heart stops on purpose: this many shocks, which don't use up the case's Codes.\n    pub code_shocks: u8,\n    /// Seconds to hold before the next phase (a beat of drama after clearing).\n    pub linger: f32,\n    pub banner: Option<String>,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Case {\n    pub name: String,\n    pub surgeon: String,\n    pub plate: String,\n    /// The instrument on each of the 8 ring directions, clockwise from up.\n    pub ring: Vec<String>,\n    pub timer: f32,\n    pub par: f32,\n    pub vitals: f32,\n    pub patient: String,\n    pub life: String,\n    pub diagnosis: String,\n    pub fate: String,\n    pub before: Option<String>,\n    pub after: Option<String>,\n    /// none | hush | echo | duet\n    pub gift: String,\n    /// The gift wakes during the case (it has no meter until then).\n    pub gift_locked: bool,\n    pub music: String,\n    pub phase: Vec<Phase>,\n}\n\n// ------------------------------------------------------------------------------------------\n// Story\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Line {\n    pub who: Option<String>,\n    pub expr: Option<String>,\n    pub text: Option<String>,\n    pub set: Option<String>,\n    /// Bring a rig on stage: `enter = \"mara\"`, at `x`.\n    pub enter: Option<String>,\n    pub x: Option<f32>,\n    pub exit: Option<String>,\n    pub music: Option<String>,\n    pub cue: Option<String>,\n    /// `paper` or `or_wide`.\n    pub camera: Option<String>,\n    pub flash: Option<f32>,\n    pub shake: Option<f32>,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Scene {\n    pub id: String,\n    pub line: Vec<Line>,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct StoryFile {\n    pub scene: Vec<Scene>,\n}\n\n// ------------------------------------------------------------------------------------------\n// Plates\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Lobe {\n    pub x: f32,\n    pub z: f32,\n    pub a: f32,\n    pub b: f32,\n    pub h: f32,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Vessel {\n    pub points: Vec<[f32; 2]>,\n    pub w: f32,\n    pub h: f32,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Plate {\n    pub name: String,\n    pub lobes: Vec<Lobe>,\n    pub vessels: Vec<Vessel>,\n    pub bed: String,\n    pub flesh: String,\n    pub top: String,\n    pub vein: String,\n    pub pulse: f32,\n    pub noise: f32,\n    /// Vein amount (0..1).\n    pub veins: f32,\n    /// A hard band like bone (a long lobe's top, ivory colour).\n    pub bone: bool,\n}\n\n// ------------------------------------------------------------------------------------------\n// Rigs\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct RigPart {\n    pub name: String,\n    pub z: f32,\n    /// A colour name from `[colors]`, or \"#rrggbb\".\n    pub color: String,\n    pub chaikin: u8,\n    pub points: Vec<[f32; 2]>,\n    /// Also draw a copy mirrored across x = 0.\n    pub mirror: bool,\n    /// Which animation moves it: \"\" (body), head, eyes, brow, hair, lid\n    pub layer: String,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Expr {\n    pub brow_y: f32,\n    pub brow_rot: f32,\n    /// How open the eyes are (1 = neutral).\n    pub eye: f32,\n    /// Pupil size (1 = neutral).\n    pub pupil: f32,\n    /// closed | smile | frown | flat | open\n    pub mouth: String,\n    pub tilt: f32,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Voice {\n    pub base: f32,\n    /// sine | triangle | square | saw\n    pub wave: String,\n    pub speed: f32,\n    pub jitter: f32,\n    pub bright: f32,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Rig {\n    pub id: String,\n    pub name: String,\n    pub colors: BTreeMap<String, String>,\n    pub part: Vec<RigPart>,\n    pub expr: BTreeMap<String, Expr>,\n    pub voice: Voice,\n    pub scale: f32,\n}\n\n// ------------------------------------------------------------------------------------------\n// Sets\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Card {\n    pub z: f32,\n    pub color: String,\n    pub points: Vec<[f32; 2]>,\n    /// A rectangle `[x0, y0, x1, y1]` instead of points.\n    pub rect: Option<[f32; 4]>,\n    pub emissive: f32,\n    pub chaikin: u8,\n    /// Blinks (monitors).\n    pub blink: f32,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Set {\n    pub id: String,\n    pub name: String,\n    pub back: String,\n    pub rain: f32,\n    pub lamp: String,\n    pub card: Vec<Card>,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Callout {\n    pub who: String,\n    pub text: Vec<String>,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(default)]\npub struct Callouts {\n    pub callout: BTreeMap<String, Callout>,\n}\n\n// ------------------------------------------------------------------------------------------\n\n/// Everything loaded. Read-only during play; game state holds indices into it.\n#[derive(Debug, Default)]\npub struct Content {\n    /// Cases 0..=7 in order, then Code Blue.\n    pub cases: Vec<Case>,\n    pub scenes: Vec<Scene>,\n    pub plates: BTreeMap<String, Plate>,\n    pub plate_order: Vec<String>,\n    pub rigs: BTreeMap<String, Rig>,\n    pub rig_order: Vec<String>,\n    pub sets: BTreeMap<String, Set>,\n    pub set_order: Vec<String>,\n    pub callouts: BTreeMap<String, Callout>,\n    /// Shared face parts of every rig (`rigs/_face.toml`).\n    pub face: Rig,\n}\n\n/// The case index of Code Blue.\npub const CODE_BLUE: usize = 8;\n\npub const MUSIC: &[&str] =\n    &[\"none\", \"title\", \"tender\", \"tense\", \"or\", \"introit\", \"lacrimosa\", \"dies\", \"libera\", \"codeblue\", \"results\"];\n\npub fn music_id(name: &str) -> u8 {\n    MUSIC.iter().position(|m| *m == name).unwrap_or(0) as u8\n}\n\nfn parse<T: serde::de::DeserializeOwned>(path: &str, text: &str) -> Result<T> {\n    toml::from_str(text).map_err(|e| {\n        let line = e.span().map(|s| text[..s.start.min(text.len())].lines().count().max(1));\n        anyhow!(\"{path}{}: {}\", line.map(|l| format!(\" line {l}\")).unwrap_or_default(), e.message())\n    })\n}\n\n/// Loads every file (disk first, embedded otherwise).\npub fn load() -> Result<Content> {\n    let mut c = Content::default();\n    let mut cases: BTreeMap<String, Case> = BTreeMap::new();\n    for (path, built_in) in FILES {\n        let text = content_text(path, built_in);\n        let (dir, file) = path.split_once('/').unwrap_or((\"\", path));\n        let stem = file.trim_end_matches(\".toml\").to_string();\n        match dir {\n            \"cases\" => {\n                cases.insert(stem, parse(path, &text)?);\n            }\n            \"story\" => {\n                let s: StoryFile = parse(path, &text)?;\n                c.scenes.extend(s.scene);\n            }\n            \"plates\" => {\n                let p: Plate = parse(path, &text)?;\n                c.plate_order.push(stem.clone());\n                c.plates.insert(stem, p);\n            }\n            \"rigs\" => {\n                let mut r: Rig = parse(path, &text)?;\n                r.id = stem.clone();\n                if stem == \"_face\" {\n                    c.face = r;\n                } else {\n                    c.rig_order.push(stem.clone());\n                    c.rigs.insert(stem, r);\n                }\n            }\n            \"sets\" => {\n                let mut s: Set = parse(path, &text)?;\n                s.id = stem.clone();\n                c.set_order.push(stem.clone());\n                c.sets.insert(stem, s);\n            }\n            \"\" => {\n                let cs: Callouts = parse(path, &text)?;\n                c.callouts = cs.callout;\n            }\n            other => bail!(\"{path}: unknown content folder '{other}'\"),\n        }\n    }\n    for k in 0..8 {\n        let name = format!(\"case{k}\");\n        c.cases.push(cases.remove(&name).ok_or_else(|| anyhow!(\"cases/{name}.toml is missing\"))?);\n    }\n    c.cases.push(cases.remove(\"codeblue\").ok_or_else(|| anyhow!(\"cases/codeblue.toml is missing\"))?);\n    Ok(c)\n}\n\nstatic CONTENT: OnceLock<RwLock<Arc<Content>>> = OnceLock::new();\n\n/// The loaded content (loads on first use; a broken embedded file is a programming error).\npub fn content() -> Arc<Content> {\n    let lock = CONTENT.get_or_init(|| RwLock::new(Arc::new(load().unwrap_or_else(|e| panic!(\"surgery content: {e:#}\")))));\n    lock.read().unwrap().clone()\n}\n\n/// Reads the files again (the dev panel's \"reload content\", native only). Keeps the old content\n/// and returns the error when a file is broken.\npub fn reload() -> Result<()> {\n    let fresh = load()?;\n    lint(&fresh).map_err(|e| anyhow!(e.join(\"\\n\")))?;\n    let _ = content();\n    *CONTENT.get().unwrap().write().unwrap() = Arc::new(fresh);\n    Ok(())\n}\n\npub const SPAWN_KINDS: &[&str] = &[\n    \"incision\", \"lacer\", \"pool\", \"bleeder\", \"object\", \"polyp\", \"tumor\", \"patch\", \"burn\", \"bone\", \"closure\",\n];\n\npub const TOOLS: &[&str] = &[\"scalpel\", \"forceps\", \"suture\", \"suction\", \"laser\", \"gel\", \"scanner\", \"iv\", \"cryo\", \"dressing\", \"defib\"];\n\npub const STRAINS: &[&str] = &[\"introit\", \"lacrimosa\", \"dies\", \"soloist\", \"tendril\", \"director\"];\n\n/// Every reference and required field in the content; empty when clean.\npub fn lint(c: &Content) -> Result<(), Vec<String>> {\n    let mut e = Vec::new();\n    let speaker = |who: &str| c.rigs.contains_key(who);\n    for (i, case) in c.cases.iter().enumerate() {\n        let tag = format!(\"case {i} ({})\", case.name);\n        if !c.plates.contains_key(&case.plate) {\n            e.push(format!(\"{tag}: unknown plate '{}'\", case.plate));\n        }\n        if !speaker(&case.surgeon) {\n            e.push(format!(\"{tag}: unknown surgeon '{}'\", case.surgeon));\n        }\n        if !case.ring.is_empty() && case.ring.len() != 8 {\n            e.push(format!(\"{tag}: the ring needs 8 instruments\"));\n        }\n        for t in &case.ring {\n            if !TOOLS.contains(&t.as_str()) {\n                e.push(format!(\"{tag}: unknown instrument '{t}'\"));\n            }\n        }\n        if case.phase.is_empty() {\n            e.push(format!(\"{tag}: no phases\"));\n        }\n        for (name, kind) in [(&case.before, \"before\"), (&case.after, \"after\")] {\n            if let Some(n) = name {\n                if !c.scenes.iter().any(|s| s.id == *n) {\n                    e.push(format!(\"{tag}: {kind} names unknown scene '{n}'\"));\n                }\n            }\n        }\n        if !MUSIC.contains(&case.music.as_str()) {\n            e.push(format!(\"{tag}: unknown music '{}'\", case.music));\n        }\n        if ![\"none\", \"hush\", \"echo\", \"duet\"].contains(&case.gift.as_str()) {\n            e.push(format!(\"{tag}: unknown gift '{}'\", case.gift));\n        }\n        for p in &case.phase {\n            let ptag = format!(\"{tag} phase '{}'\", p.name);\n            let says = p.say.iter().chain(p.trigger.iter().flat_map(|t| t.say.iter()));\n            for s in says {\n                if !speaker(&s.who) {\n                    e.push(format!(\"{ptag}: unknown speaker '{}'\", s.who));\n                }\n                if s.text.trim().is_empty() {\n                    e.push(format!(\"{ptag}: empty line\"));\n                }\n            }\n            for s in p.spawn.iter().chain(p.trigger.iter().flat_map(|t| t.spawn.iter())) {\n                if !SPAWN_KINDS.contains(&s.kind.as_str()) {\n                    e.push(format!(\"{ptag}: unknown hazard '{}'\", s.kind));\n                }\n            }\n            if let Some(r) = &p.reveal_plate {\n                if !c.plates.contains_key(r) {\n                    e.push(format!(\"{ptag}: unknown plate '{r}'\"));\n                }\n            }\n            if let Some(s) = &p.strain {\n                if !STRAINS.contains(&s.as_str()) {\n                    e.push(format!(\"{ptag}: unknown strain '{s}'\"));\n                }\n            }\n            for t in &p.trigger {\n                if let Some(cue) = &t.cue {\n                    if super::cue::id(cue).is_none() {\n                        e.push(format!(\"{ptag}: unknown cue '{cue}'\"));\n                    }\n                }\n            }\n        }\n    }\n    for s in &c.scenes {\n        for (n, l) in s.line.iter().enumerate() {\n            let tag = format!(\"scene '{}' line {}\", s.id, n + 1);\n            if let Some(who) = &l.who {\n                match c.rigs.get(who) {\n                    None if who != \"narrator\" => e.push(format!(\"{tag}: unknown speaker '{who}'\")),\n                    Some(r) => {\n                        if let Some(x) = &l.expr {\n                            if !r.expr.contains_key(x) {\n                                e.push(format!(\"{tag}: {who} has no expression '{x}'\"));\n                            }\n                        }\n                    }\n                    _ => {}\n                }\n                if l.text.as_deref().unwrap_or(\"\").trim().is_empty() {\n                    e.push(format!(\"{tag}: empty text\"));\n                }\n            }\n            if let Some(t) = &l.text {\n                if t.contains(\"TODO\") {\n                    e.push(format!(\"{tag}: leftover TODO\"));\n                }\n            }\n            if let Some(x) = &l.set {\n                if !c.sets.contains_key(x) {\n                    e.push(format!(\"{tag}: unknown set '{x}'\"));\n                }\n            }\n            for r in [&l.enter, &l.exit].into_iter().flatten() {\n                if !c.rigs.contains_key(r) {\n                    e.push(format!(\"{tag}: unknown rig '{r}'\"));\n                }\n            }\n            if let Some(m) = &l.music {\n                if !MUSIC.contains(&m.as_str()) {\n                    e.push(format!(\"{tag}: unknown music '{m}'\"));\n                }\n            }\n            if let Some(cue) = &l.cue {\n                if super::cue::id(cue).is_none() {\n                    e.push(format!(\"{tag}: unknown cue '{cue}'\"));\n                }\n            }\n        }\n    }\n    for (id, r) in &c.rigs {\n        for need in [\"neutral\", \"alarmed\", \"stern\", \"soft\"] {\n            if !r.expr.contains_key(need) {\n                e.push(format!(\"rig '{id}': missing expression '{need}'\"));\n            }\n        }\n        for p in &r.part {\n            if !p.color.starts_with('#') && !r.colors.contains_key(&p.color) {\n                e.push(format!(\"rig '{id}': part '{}' has unknown colour '{}'\", p.name, p.color));\n            }\n        }\n        for p in &c.face.part {\n            if !p.color.starts_with('#') && !r.colors.contains_key(&p.color) {\n                e.push(format!(\"rig '{id}': face part '{}' needs colour '{}'\", p.name, p.color));\n            }\n        }\n    }\n    for (_, callout) in c.callouts.iter() {\n        if !speaker(&callout.who) {\n            e.push(format!(\"callout: unknown speaker '{}'\", callout.who));\n        }\n    }\n    if e.is_empty() { Ok(()) } else { Err(e) }\n}\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013htKXWmcaYatsNczChu97w","type":"tool_result","content":"File created successfully at: /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery/content.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"4687d903-a44d-473e-8567-dba7b7097775","timestamp":"2026-11-05T14:31:27.037Z","tool_use_result":{"type":"create","filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery/content.rs","content":"//! The game's text data: cases, story, plates, rigs and sets. Native builds read the file on\n//! disk when running from the repository (edits show at the next load, or `reload`); every\n//! build also embeds a copy (the browser has no files). A broken file names itself and its line.\n\nuse std::collections::BTreeMap;\nuse std::sync::{Arc, OnceLock, RwLock};\n\nuse anyhow::{Result, anyhow, bail};\nuse serde::Deserialize;\n\nconst DIR: &str = \"crates/pav_core/src/games/surgery/content\";\n\nmacro_rules! files {\n    ($($p:literal),* $(,)?) => { &[$(($p, include_str!(concat!(\"content/\", $p)))),*] };\n}\n\n/// Every content file, embedded. A test checks this list against the folder on disk.\npub const FILES: &[(&str, &str)] = files![\n    \"callouts.toml\",\n    \"cases/case0.toml\",\n    \"cases/case1.toml\",\n    \"cases/case2.toml\",\n    \"cases/case3.toml\",\n    \"cases/case4.toml\",\n    \"cases/case5.toml\",\n    \"cases/case6.toml\",\n    \"cases/case7.toml\",\n    \"cases/codeblue.toml\",\n    \"plates/abdomen.toml\",\n    \"plates/bowel.toml\",\n    \"plates/chest.toml\",\n    \"plates/femur.toml\",\n    \"plates/forearm.toml\",\n    \"plates/heart.toml\",\n    \"plates/liver.toml\",\n    \"plates/lung.toml\",\n    \"plates/pericardium.toml\",\n    \"plates/torso.toml\",\n    \"rigs/_face.toml\",\n    \"rigs/bashir.toml\",\n    \"rigs/mara.toml\",\n    \"rigs/pet.toml\",\n    \"rigs/teddy.toml\",\n    \"rigs/vane.toml\",\n    \"rigs/voss.toml\",\n    \"sets/atrium.toml\",\n    \"sets/cabin.toml\",\n    \"sets/corridor.toml\",\n    \"sets/depot.toml\",\n    \"sets/nightward.toml\",\n    \"sets/office.toml\",\n    \"sets/recovery.toml\",\n    \"sets/scrub.toml\",\n    \"story/case0.toml\",\n    \"story/case1.toml\",\n    \"story/case2.toml\",\n    \"story/case3.toml\",\n    \"story/case4.toml\",\n    \"story/case5.toml\",\n    \"story/case6.toml\",\n    \"story/case7.toml\",\n];\n\n/// A content file's text: the copy on disk when there is one, else the embedded one.\npub fn content_text(path: &str, built_in: &'static str) -> std::borrow::Cow<'static, str> {\n    #[cfg(not(target_arch = \"wasm32\"))]\n    if let Ok(text) = std::fs::read_to_string(format!(\"{DIR}/{path}\")) {\n        return text.into();\n    }\n    let _ = (path, DIR);\n    built_in.into()\n}\n\n// ------------------------------------------------------------------------------------------\n// Cases\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct SpawnSpec {\n    pub kind: String,\n    pub a: Option<[f32; 2]>,\n    pub b: Option<[f32; 2]>,\n    pub c: Option<[f32; 2]>,\n    pub r: Option<f32>,\n    pub ang: Option<f32>,\n    pub hidden: bool,\n    pub sub: u8,\n    pub drain: Option<f32>,\n    /// Not needed to clear the phase (it still drains until dealt with).\n    pub optional: bool,\n    pub stage: u8,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Say {\n    pub who: String,\n    pub text: String,\n    /// Seconds after the phase starts.\n    pub at: f32,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Trigger {\n    pub at_time: Option<f32>,\n    pub vitals_below: Option<f32>,\n    /// Fires once the phase's blocking hazards are gone, and holds the phase open for its spawns.\n    pub on_clear: bool,\n    /// The n-th heartbeat of this phase.\n    pub on_beat: Option<u32>,\n    pub spawn: Vec<SpawnSpec>,\n    pub say: Vec<Say>,\n    pub cue: Option<String>,\n    pub banner: Option<String>,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Phase {\n    pub name: String,\n    /// The HUD's NOW line.\n    pub now: String,\n    /// Highlight the targets on the field and let Bashir teach.\n    pub guide: bool,\n    pub checkpoint: bool,\n    pub spawn: Vec<SpawnSpec>,\n    pub say: Vec<Say>,\n    pub trigger: Vec<Trigger>,\n    pub strain: Option<String>,\n    /// Strain numbers: `waves`, `count`, `mini`, `meter`...\n    pub params: BTreeMap<String, f32>,\n    /// The ECG's meter while this phase runs (beats to a bar).\n    pub meter: Option<u8>,\n    pub reveal_plate: Option<String>,\n    /// The heart stops on purpose: this many shocks, which don't use up the case's Codes.\n    pub code_shocks: u8,\n    /// Seconds to hold before the next phase (a beat of drama after clearing).\n    pub linger: f32,\n    pub banner: Option<String>,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Case {\n    pub name: String,\n    pub surgeon: String,\n    pub plate: String,\n    /// The instrument on each of the 8 ring directions, clockwise from up.\n    pub ring: Vec<String>,\n    pub timer: f32,\n    pub par: f32,\n    pub vitals: f32,\n    pub patient: String,\n    pub life: String,\n    pub diagnosis: String,\n    pub fate: String,\n    pub before: Option<String>,\n    pub after: Option<String>,\n    /// none | hush | echo | duet\n    pub gift: String,\n    /// The gift wakes during the case (it has no meter until then).\n    pub gift_locked: bool,\n    pub music: String,\n    pub phase: Vec<Phase>,\n}\n\n// ------------------------------------------------------------------------------------------\n// Story\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Line {\n    pub who: Option<String>,\n    pub expr: Option<String>,\n    pub text: Option<String>,\n    pub set: Option<String>,\n    /// Bring a rig on stage: `enter = \"mara\"`, at `x`.\n    pub enter: Option<String>,\n    pub x: Option<f32>,\n    pub exit: Option<String>,\n    pub music: Option<String>,\n    pub cue: Option<String>,\n    /// `paper` or `or_wide`.\n    pub camera: Option<String>,\n    pub flash: Option<f32>,\n    pub shake: Option<f32>,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Scene {\n    pub id: String,\n    pub line: Vec<Line>,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct StoryFile {\n    pub scene: Vec<Scene>,\n}\n\n// ------------------------------------------------------------------------------------------\n// Plates\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Lobe {\n    pub x: f32,\n    pub z: f32,\n    pub a: f32,\n    pub b: f32,\n    pub h: f32,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Vessel {\n    pub points: Vec<[f32; 2]>,\n    pub w: f32,\n    pub h: f32,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Plate {\n    pub name: String,\n    pub lobes: Vec<Lobe>,\n    pub vessels: Vec<Vessel>,\n    pub bed: String,\n    pub flesh: String,\n    pub top: String,\n    pub vein: String,\n    pub pulse: f32,\n    pub noise: f32,\n    /// Vein amount (0..1).\n    pub veins: f32,\n    /// A hard band like bone (a long lobe's top, ivory colour).\n    pub bone: bool,\n}\n\n// ------------------------------------------------------------------------------------------\n// Rigs\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct RigPart {\n    pub name: String,\n    pub z: f32,\n    /// A colour name from `[colors]`, or \"#rrggbb\".\n    pub color: String,\n    pub chaikin: u8,\n    pub points: Vec<[f32; 2]>,\n    /// Also draw a copy mirrored across x = 0.\n    pub mirror: bool,\n    /// Which animation moves it: \"\" (body), head, eyes, brow, hair, lid\n    pub layer: String,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Expr {\n    pub brow_y: f32,\n    pub brow_rot: f32,\n    /// How open the eyes are (1 = neutral).\n    pub eye: f32,\n    /// Pupil size (1 = neutral).\n    pub pupil: f32,\n    /// closed | smile | frown | flat | open\n    pub mouth: String,\n    pub tilt: f32,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Voice {\n    pub base: f32,\n    /// sine | triangle | square | saw\n    pub wave: String,\n    pub speed: f32,\n    pub jitter: f32,\n    pub bright: f32,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Rig {\n    pub id: String,\n    pub name: String,\n    pub colors: BTreeMap<String, String>,\n    pub part: Vec<RigPart>,\n    pub expr: BTreeMap<String, Expr>,\n    pub voice: Voice,\n    pub scale: f32,\n}\n\n// ------------------------------------------------------------------------------------------\n// Sets\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Card {\n    pub z: f32,\n    pub color: String,\n    pub points: Vec<[f32; 2]>,\n    /// A rectangle `[x0, y0, x1, y1]` instead of points.\n    pub rect: Option<[f32; 4]>,\n    pub emissive: f32,\n    pub chaikin: u8,\n    /// Blinks (monitors).\n    pub blink: f32,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Set {\n    pub id: String,\n    pub name: String,\n    pub back: String,\n    pub rain: f32,\n    pub lamp: String,\n    pub card: Vec<Card>,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Callout {\n    pub who: String,\n    pub text: Vec<String>,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(default)]\npub struct Callouts {\n    pub callout: BTreeMap<String, Callout>,\n}\n\n// ------------------------------------------------------------------------------------------\n\n/// Everything loaded. Read-only during play; game state holds indices into it.\n#[derive(Debug, Default)]\npub struct Content {\n    /// Cases 0..=7 in order, then Code Blue.\n    pub cases: Vec<Case>,\n    pub scenes: Vec<Scene>,\n    pub plates: BTreeMap<String, Plate>,\n    pub plate_order: Vec<String>,\n    pub rigs: BTreeMap<String, Rig>,\n    pub rig_order: Vec<String>,\n    pub sets: BTreeMap<String, Set>,\n    pub set_order: Vec<String>,\n    pub callouts: BTreeMap<String, Callout>,\n    /// Shared face parts of every rig (`rigs/_face.toml`).\n    pub face: Rig,\n}\n\n/// The case index of Code Blue.\npub const CODE_BLUE: usize = 8;\n\npub const MUSIC: &[&str] =\n    &[\"none\", \"title\", \"tender\", \"tense\", \"or\", \"introit\", \"lacrimosa\", \"dies\", \"libera\", \"codeblue\", \"results\"];\n\npub fn music_id(name: &str) -> u8 {\n    MUSIC.iter().position(|m| *m == name).unwrap_or(0) as u8\n}\n\nfn parse<T: serde::de::DeserializeOwned>(path: &str, text: &str) -> Result<T> {\n    toml::from_str(text).map_err(|e| {\n        let line = e.span().map(|s| text[..s.start.min(text.len())].lines().count().max(1));\n        anyhow!(\"{path}{}: {}\", line.map(|l| format!(\" line {l}\")).unwrap_or_default(), e.message())\n    })\n}\n\n/// Loads every file (disk first, embedded otherwise).\npub fn load() -> Result<Content> {\n    let mut c = Content::default();\n    let mut cases: BTreeMap<String, Case> = BTreeMap::new();\n    for (path, built_in) in FILES {\n        let text = content_text(path, built_in);\n        let (dir, file) = path.split_once('/').unwrap_or((\"\", path));\n        let stem = file.trim_end_matches(\".toml\").to_string();\n        match dir {\n            \"cases\" => {\n                cases.insert(stem, parse(path, &text)?);\n            }\n            \"story\" => {\n                let s: StoryFile = parse(path, &text)?;\n                c.scenes.extend(s.scene);\n            }\n            \"plates\" => {\n                let p: Plate = parse(path, &text)?;\n                c.plate_order.push(stem.clone());\n                c.plates.insert(stem, p);\n            }\n            \"rigs\" => {\n                let mut r: Rig = parse(path, &text)?;\n                r.id = stem.clone();\n                if stem == \"_face\" {\n                    c.face = r;\n                } else {\n                    c.rig_order.push(stem.clone());\n                    c.rigs.insert(stem, r);\n                }\n            }\n            \"sets\" => {\n                let mut s: Set = parse(path, &text)?;\n                s.id = stem.clone();\n                c.set_order.push(stem.clone());\n                c.sets.insert(stem, s);\n            }\n            \"\" => {\n                let cs: Callouts = parse(path, &text)?;\n                c.callouts = cs.callout;\n            }\n            other => bail!(\"{path}: unknown content folder '{other}'\"),\n        }\n    }\n    for k in 0..8 {\n        let name = format!(\"case{k}\");\n        c.cases.push(cases.remove(&name).ok_or_else(|| anyhow!(\"cases/{name}.toml is missing\"))?);\n    }\n    c.cases.push(cases.remove(\"codeblue\").ok_or_else(|| anyhow!(\"cases/codeblue.toml is missing\"))?);\n    Ok(c)\n}\n\nstatic CONTENT: OnceLock<RwLock<Arc<Content>>> = OnceLock::new();\n\n/// The loaded content (loads on first use; a broken embedded file is a programming error).\npub fn content() -> Arc<Content> {\n    let lock = CONTENT.get_or_init(|| RwLock::new(Arc::new(load().unwrap_or_else(|e| panic!(\"surgery content: {e:#}\")))));\n    lock.read().unwrap().clone()\n}\n\n/// Reads the files again (the dev panel's \"reload content\", native only). Keeps the old content\n/// and returns the error when a file is broken.\npub fn reload() -> Result<()> {\n    let fresh = load()?;\n    lint(&fresh).map_err(|e| anyhow!(e.join(\"\\n\")))?;\n    let _ = content();\n    *CONTENT.get().unwrap().write().unwrap() = Arc::new(fresh);\n    Ok(())\n}\n\npub const SPAWN_KINDS: &[&str] = &[\n    \"incision\", \"lacer\", \"pool\", \"bleeder\", \"object\", \"polyp\", \"tumor\", \"patch\", \"burn\", \"bone\", \"closure\",\n];\n\npub const TOOLS: &[&str] = &[\"scalpel\", \"forceps\", \"suture\", \"suction\", \"laser\", \"gel\", \"scanner\", \"iv\", \"cryo\", \"dressing\", \"defib\"];\n\npub const STRAINS: &[&str] = &[\"introit\", \"lacrimosa\", \"dies\", \"soloist\", \"tendril\", \"director\"];\n\n/// Every reference and required field in the content; empty when clean.\npub fn lint(c: &Content) -> Result<(), Vec<String>> {\n    let mut e = Vec::new();\n    let speaker = |who: &str| c.rigs.contains_key(who);\n    for (i, case) in c.cases.iter().enumerate() {\n        let tag = format!(\"case {i} ({})\", case.name);\n        if !c.plates.contains_key(&case.plate) {\n            e.push(format!(\"{tag}: unknown plate '{}'\", case.plate));\n        }\n        if !speaker(&case.surgeon) {\n            e.push(format!(\"{tag}: unknown surgeon '{}'\", case.surgeon));\n        }\n        if !case.ring.is_empty() && case.ring.len() != 8 {\n            e.push(format!(\"{tag}: the ring needs 8 instruments\"));\n        }\n        for t in &case.ring {\n            if !TOOLS.contains(&t.as_str()) {\n                e.push(format!(\"{tag}: unknown instrument '{t}'\"));\n            }\n        }\n        if case.phase.is_empty() {\n            e.push(format!(\"{tag}: no phases\"));\n        }\n        for (name, kind) in [(&case.before, \"before\"), (&case.after, \"after\")] {\n            if let Some(n) = name {\n                if !c.scenes.iter().any(|s| s.id == *n) {\n                    e.push(format!(\"{tag}: {kind} names unknown scene '{n}'\"));\n                }\n            }\n        }\n        if !MUSIC.contains(&case.music.as_str()) {\n            e.push(format!(\"{tag}: unknown music '{}'\", case.music));\n        }\n        if ![\"none\", \"hush\", \"echo\", \"duet\"].contains(&case.gift.as_str()) {\n            e.push(format!(\"{tag}: unknown gift '{}'\", case.gift));\n        }\n        for p in &case.phase {\n            let ptag = format!(\"{tag} phase '{}'\", p.name);\n            let says = p.say.iter().chain(p.trigger.iter().flat_map(|t| t.say.iter()));\n            for s in says {\n                if !speaker(&s.who) {\n                    e.push(format!(\"{ptag}: unknown speaker '{}'\", s.who));\n                }\n                if s.text.trim().is_empty() {\n                    e.push(format!(\"{ptag}: empty line\"));\n                }\n            }\n            for s in p.spawn.iter().chain(p.trigger.iter().flat_map(|t| t.spawn.iter())) {\n                if !SPAWN_KINDS.contains(&s.kind.as_str()) {\n                    e.push(format!(\"{ptag}: unknown hazard '{}'\", s.kind));\n                }\n            }\n            if let Some(r) = &p.reveal_plate {\n                if !c.plates.contains_key(r) {\n                    e.push(format!(\"{ptag}: unknown plate '{r}'\"));\n                }\n            }\n            if let Some(s) = &p.strain {\n                if !STRAINS.contains(&s.as_str()) {\n                    e.push(format!(\"{ptag}: unknown strain '{s}'\"));\n                }\n            }\n            for t in &p.trigger {\n                if let Some(cue) = &t.cue {\n                    if super::cue::id(cue).is_none() {\n                        e.push(format!(\"{ptag}: unknown cue '{cue}'\"));\n                    }\n                }\n            }\n        }\n    }\n    for s in &c.scenes {\n        for (n, l) in s.line.iter().enumerate() {\n            let tag = format!(\"scene '{}' line {}\", s.id, n + 1);\n            if let Some(who) = &l.who {\n                match c.rigs.get(who) {\n                    None if who != \"narrator\" => e.push(format!(\"{tag}: unknown speaker '{who}'\")),\n                    Some(r) => {\n                        if let Some(x) = &l.expr {\n                            if !r.expr.contains_key(x) {\n                                e.push(format!(\"{tag}: {who} has no expression '{x}'\"));\n                            }\n                        }\n                    }\n                    _ => {}\n                }\n                if l.text.as_deref().unwrap_or(\"\").trim().is_empty() {\n                    e.push(format!(\"{tag}: empty text\"));\n                }\n            }\n            if let Some(t) = &l.text {\n                if t.contains(\"TODO\") {\n                    e.push(format!(\"{tag}: leftover TODO\"));\n                }\n            }\n            if let Some(x) = &l.set {\n                if !c.sets.contains_key(x) {\n                    e.push(format!(\"{tag}: unknown set '{x}'\"));\n                }\n            }\n            for r in [&l.enter, &l.exit].into_iter().flatten() {\n                if !c.rigs.contains_key(r) {\n                    e.push(format!(\"{tag}: unknown rig '{r}'\"));\n                }\n            }\n            if let Some(m) = &l.music {\n                if !MUSIC.contains(&m.as_str()) {\n                    e.push(format!(\"{tag}: unknown music '{m}'\"));\n                }\n            }\n            if let Some(cue) = &l.cue {\n                if super::cue::id(cue).is_none() {\n                    e.push(format!(\"{tag}: unknown cue '{cue}'\"));\n                }\n            }\n        }\n    }\n    for (id, r) in &c.rigs {\n        for need in [\"neutral\", \"alarmed\", \"stern\", \"soft\"] {\n            if !r.expr.contains_key(need) {\n                e.push(format!(\"rig '{id}': missing expression '{need}'\"));\n            }\n        }\n        for p in &r.part {\n            if !p.color.starts_with('#') && !r.colors.contains_key(&p.color) {\n                e.push(format!(\"rig '{id}': part '{}' has unknown colour '{}'\", p.name, p.color));\n            }\n        }\n        for p in &c.face.part {\n            if !p.color.starts_with('#') && !r.colors.contains_key(&p.color) {\n                e.push(format!(\"rig '{id}': face part '{}' needs colour '{}'\", p.name, p.color));\n            }\n        }\n    }\n    for (_, callout) in c.callouts.iter() {\n        if !speaker(&callout.who) {\n            e.push(format!(\"callout: unknown speaker '{}'\", callout.who));\n        }\n    }\n    if e.is_empty() { Ok(()) } else { Err(e) }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_013htKXWmcaYatsNczChu97w","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
