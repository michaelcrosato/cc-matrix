e_text.replace(\"</head>\", \"<script>window.__lite = true;</script>\\\\n</head>\", 1), encoding=\"utf-8\")''')\nopen(p,'w').write(s)\np='../tests/browser/web_tests.py'; s=open(p).read()\ns=s.replace('''def boots(b):\n    p = Page(b, init=[TAP])''','''def renders(b):\n    # The real thing, once, small: a frame of 3D arrives and has pixels in it.\n    p = Page(b, query=\"?scene=surgery/case/3\", viewport=(480, 270))\n    p.wait(lambda s: s[\"frames\"] >= 2, timeout=200, what=\"a real frame\")\n    shot = p.page.screenshot()\n    import zlib\n    assert len(shot) > 8000, len(shot)\n    assert not [e for e in p.errors if \"favicon\" not in e], p.errors\n    p.close()\n\ndef boots(b):\n    p = Page(b, query=\"?lite=1\", init=[TAP])''')\ns=s.replace('assert st[\"bus\"][\"music\"] == 0.1, st[\"bus\"]','assert abs(st[\"bus\"][\"music\"] - 0.1) < 1e-4, st[\"bus\"]')\ns=s.replace('assert st[\"bus\"][\"music\"] == 0.1\\n','assert abs(st[\"bus\"][\"music\"] - 0.1) < 1e-4\\n')\ns=s.replace('p = Page(b)\\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\"','p = Page(b, query=\"?lite=1\")\\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\"')\ns=s.replace('p = Page(b, query=\"?scene=surgery/case/2\")','p = Page(b, query=\"?scene=surgery/case/2&lite=1\")')\ns=s.replace('p = Page(b, init=[PAD])','p = Page(b, query=\"?lite=1\", init=[PAD])')\ns=s.replace('ctx_page = Page(b, init=[PAD])','ctx_page = Page(b, query=\"?lite=1\", init=[PAD])')\ns=s.replace('p = Page(b, init=[TAP])\\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\" and s[\"frames\"] > 3, what=\"title\")\\n    p.key(\"Enter\")  # a gesture','p = Page(b, query=\"?lite=1\", init=[TAP])\\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\" and s[\"frames\"] > 3, what=\"title\")\\n    p.key(\"Enter\")  # a gesture')\ns=s.replace('p = Page(b, query=\"?scene=surgery/case/3\")\\n    p.wait(lambda s: s[\"sim\"] and s[\"sim\"][\"stage\"] == \"Op\" and s[\"frames\"] > 3, what=\"op\")\\n    p.key(\"Escape\")','p = Page(b, query=\"?scene=surgery/case/3&lite=1\")\\n    p.wait(lambda s: s[\"sim\"] and s[\"sim\"][\"stage\"] == \"Op\" and s[\"frames\"] > 3, what=\"op\")\\n    p.key(\"Escape\")')\ns=s.replace('''def whole_campaign(b):\n    p = Page(b)''','''def whole_campaign(b):\n    p = Page(b, query=\"?lite=1\")''')\ns=s.replace('p = Page(b, viewport=(device[\"viewport\"][\"height\"], device[\"viewport\"][\"width\"]), **ctx)','p = Page(b, query=\"?lite=1\", viewport=(device[\"viewport\"][\"height\"], device[\"viewport\"][\"width\"]), **ctx)')\ns=s.replace('''        (\"boots with no errors and no engine overlays\", boots),''','''        (\"a real 3D frame arrives\", renders),\n        (\"boots with no errors and no engine overlays\", boots),''')\nopen(p,'w').write(s)\nEOF\nJOBS=4 ../tools/cb.sh build -p pav_tools --bin pav 2>&1 | grep -E \"^error|-->\" -A5 | head -20; (nohup ../tools/build_web.sh > ../build_web.log 2>&1 &); ./target/debug/pav balance seeds=4 skills=1.0,0.7,0.4 2>&1 | python3 -c \"\nimport json,sys\nd=json.load(sys.stdin)\nfor c in d:\n    print(c['case'],c['suggested_par'],' | '.join(f\\\"{r['skill']}:{r['wins']} {r['secs']}s v{r['vitals']} {r['score']}\\\" for r in c['rows']))\n\"","description":"Fix tendril, add lite test mode, rebuild and rebalance","timeout":590000}}}
