{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjx9RYzxva8u4SsGgHj9","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":52768,"cache_read_input_tokens":256726,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":52768},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"0a15da8e-e3fc-4d1b-8ef3-de3b573b40f7","timestamp":"2026-11-05T14:38:50.894Z","request_id":"req_011Cgjx9RJ83GeZuUGTbtm8o","thinking_duration_ms":50239,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjx9RYzxva8u4SsGgHj9","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Q7gcyLWMJveCboxvW4WvVv","name":"Bash","input":{"command":"cd crates/pav_core/src/games/surgery\nsed -i 's|let dt = 1.0 / 60.0;|let dt = self.time_scale / 60.0;|' strain.rs\npython3 - <<'EOF'\np='field.rs'; s=open(p).read()\ns=s.replace('''            s.held = inp.held;\n            s.pressed = inp.pressed | (inp.held & !s.held & 0);\n''','''            s.pressed = inp.pressed | (inp.held & !s.held);\n            s.held = inp.held;\n''')\ns=s.replace('''            if !held {\n                self.hazards[k].prog = 0.0;\n                self.release(i);\n                return;\n            }\n            let h = &self.hazards[k];\n            if h.kind == Kind::Tendril {''','''            if !held {\n                if self.hazards[k].kind != Kind::Tendril {\n                    self.hazards[k].prog = 0.0;\n                }\n                self.release(i);\n                return;\n            }\n            let h = &self.hazards[k];\n            if h.kind == Kind::Tendril {''')\ns=s.replace(\"h.prog = (h.prog + along * 0.085 * rules\",\"h.prog = (h.prog + along * 0.055 * rules\")\nopen(p,'w').write(s)\nEOF\ncat > cue.rs <<'EOF'\n//! The cue table: every sound the game's simulation asks for, by id. `pav_audio` holds each\n//! cue's synthesis, `pav_view` its particles; story and case files name them.\n\nmacro_rules! cues {\n    ($($name:ident = $n:literal, $key:literal;)*) => {\n        $(pub const $name: u16 = $n;)*\n        pub const NAMES: &[&str] = &[$($key),*];\n    };\n}\n\ncues! {\n    TOOL_PICK = 0, \"tool_pick\";\n    SLICE = 1, \"slice\";\n    SQUISH = 2, \"squish\";\n    FORCEPS = 3, \"forceps\";\n    PULL_POP = 4, \"pull_pop\";\n    SUTURE = 5, \"suture\";\n    GURGLE = 6, \"gurgle\";\n    LASER = 7, \"laser\";\n    SIZZLE = 8, \"sizzle\";\n    GEL = 9, \"gel\";\n    IV = 10, \"iv\";\n    SONAR = 11, \"sonar\";\n    DEFIB_WHINE = 12, \"defib_whine\";\n    DEFIB_THUMP = 13, \"defib_thump\";\n    LUB = 14, \"lub\";\n    MONITOR = 15, \"monitor\";\n    ALARM = 16, \"alarm\";\n    RATE_SLOPPY = 17, \"rate_sloppy\";\n    RATE_GOOD = 18, \"rate_good\";\n    RATE_CLEAN = 19, \"rate_clean\";\n    RATE_IMMACULATE = 20, \"rate_immaculate\";\n    CHAIN_UP = 21, \"chain_up\";\n    ON_BEAT = 22, \"on_beat\";\n    STING = 23, \"sting\";\n    BURST = 24, \"burst\";\n    UI_NAV = 25, \"ui_nav\";\n    UI_CONFIRM = 26, \"ui_confirm\";\n    UI_BACK = 27, \"ui_back\";\n    BANNER = 28, \"banner\";\n    FLATLINE = 29, \"flatline\";\n    CLINK = 30, \"clink\";\n    FROST = 31, \"frost\";\n    CRACK = 32, \"crack\";\n    SNAP = 33, \"snap\";\n    LIFT_OFF = 34, \"lift_off\";\n    RING = 35, \"ring\";\n    HUSH = 36, \"hush\";\n    ECHO = 37, \"echo\";\n    DUET = 38, \"duet\";\n    STAMP = 39, \"stamp\";\n    THUNDER = 40, \"thunder\";\n    TEAR = 41, \"tear\";\n    GIFT_ARM = 42, \"gift_arm\";\n    GASP = 43, \"gasp\";\n    LIFT = 44, \"lift\";\n    PHONE = 45, \"phone\";\n    GLASS = 46, \"glass\";\n}\n\npub fn id(name: &str) -> Option<u16> {\n    NAMES.iter().position(|n| *n == name).map(|p| p as u16)\n}\nEOF\ncat > cover.rs <<'EOF'\n//! Coverage counters: what a playthrough actually did. A test proves the campaign exercises\n//! every instrument, hazard, strain phase, gift and the Code.\n\n/// Every name a counter can have; unknown names are ignored (phases past the list, say).\npub const NAMES: &[&str] = &[\n    \"tool:scalpel\", \"tool:forceps\", \"tool:suture\", \"tool:suction\", \"tool:laser\", \"tool:gel\", \"tool:scanner\", \"tool:iv\",\n    \"tool:cryo\", \"tool:dressing\", \"tool:defib\",\n    \"rated:scalpel\", \"rated:forceps\", \"rated:suture\", \"rated:suction\", \"rated:laser\", \"rated:gel\", \"rated:iv\", \"rated:cryo\",\n    \"rated:dressing\", \"rated:defib\",\n    \"hazard:incision\", \"hazard:lacer\", \"hazard:pool\", \"hazard:bleeder\", \"hazard:object\", \"hazard:polyp\", \"hazard:tumor\",\n    \"hazard:patch\", \"hazard:bone\", \"hazard:closure\", \"hazard:nodule\", \"hazard:sac\", \"hazard:eye\", \"hazard:ember\",\n    \"hazard:furnace\", \"hazard:tendril\",\n    \"done:incision\", \"done:lacer\", \"done:pool\", \"done:bleeder\", \"done:object\", \"done:polyp\", \"done:tumor\", \"done:patch\",\n    \"done:bone\", \"done:closure\", \"done:nodule\", \"done:sac\", \"done:eye\", \"done:ember\", \"done:furnace\", \"done:tendril\",\n    \"strain:introit\", \"strain:lacrimosa\", \"strain:dies\", \"strain:soloist\", \"strain:tendril\", \"strain:director\",\n    \"lacrimosa:wave1\", \"lacrimosa:wave2\", \"lacrimosa:wave3\", \"lacrimosa:burst\", \"dies:countin\", \"dies:ring\", \"dies:merge\",\n    \"dies:crack\", \"furnace:0\", \"furnace:1\", \"furnace:2\", \"furnace:3\", \"furnace:4\", \"duet:window\", \"hush:woke\", \"director:strain\",\n    \"gift:hush\", \"gift:echo\", \"gift:duet\", \"echo:repeat\", \"code\", \"code:scripted\", \"on_beat\", \"chain\", \"wrong_tool\", \"scorch\",\n    \"mistake:lacerate\", \"mistake:burn\", \"mistake:overdose\", \"death:time\", \"death:vitals\", \"death:code\",\n    \"rating:immaculate\", \"rating:clean\", \"rating:good\", \"rating:sloppy\",\n];\n\npub fn mark(cov: &mut [u32], name: &str) {\n    if let Some(k) = NAMES.iter().position(|n| *n == name) {\n        if let Some(c) = cov.get_mut(k) {\n            *c += 1;\n        }\n    }\n}\n\npub fn merge(into: &mut Vec<u32>, from: &[u32]) {\n    into.resize(NAMES.len(), 0);\n    for (a, b) in into.iter_mut().zip(from) {\n        *a += *b;\n    }\n}\n\npub fn get(cov: &[u32], name: &str) -> u32 {\n    NAMES.iter().position(|n| *n == name).and_then(|k| cov.get(k).copied()).unwrap_or(0)\n}\nEOF\ncat > frame.rs <<'EOF'\n//! `SurgeryFrame`: the single source of everything drawn and heard. Built from the sim on the\n//! host; decoded from the network on a client (`net`). The view and HUD read nothing else.\n\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\n\nuse super::field::{Callout, Code, Flight, Float, Hazard, Stain, Thread, Tool};\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum Stage {\n    /// The softly beating plate behind the title and menus.\n    #[default]\n    Title,\n    Story,\n    Chart,\n    Op,\n    /// OPERATION COMPLETE.\n    Complete,\n    Results,\n    Dead,\n    Done,\n    /// The hub's pre-op board.\n    Card,\n}\n\n/// Where the camera should be. Applied to `CameraRig` in the app and the tools.\n#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]\npub struct CameraShot {\n    pub target: [f32; 3],\n    pub tilt: f32,\n    pub yaw: f32,\n    pub distance: f32,\n    pub fov: f32,\n    /// Seconds to glide there when this shot changes.\n    pub blend: f32,\n}\n\nimpl Default for CameraShot {\n    fn default() -> Self {\n        Self::field()\n    }\n}\n\nimpl CameraShot {\n    /// The surgeon's-eye view of the field.\n    pub fn field() -> Self {\n        Self { target: [0.0, 0.0, 0.2], tilt: 73.0, yaw: 0.0, distance: 19.9, fov: 36.0, blend: 0.0 }\n    }\n    /// The paper theatre, straight on.\n    pub fn paper() -> Self {\n        Self { target: [0.0, 0.0, 0.0], tilt: 0.0, yaw: 0.0, distance: 14.0, fov: 26.0, blend: 0.0 }\n    }\n    /// The 3D wide shot of the OR set, far from the field.\n    pub fn or_wide() -> Self {\n        Self { target: [97.0, 1.0, -2.0], tilt: 28.0, yaw: -24.0, distance: 13.5, fov: 34.0, blend: 0.0 }\n    }\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct SlotView {\n    pub active: bool,\n    pub bot: bool,\n    pub cursor: Vec2,\n    /// The instrument in hand.\n    pub tool: u8,\n    /// Its ring position.\n    pub ring_pos: u8,\n    pub using: bool,\n    pub pressure: f32,\n    /// 0 none, 1 cut, 2 pull, 3 stitch, 4 suck, 5 heat, 6 paint, 7 scan, 8 IV, 9 dress, 10 bone.\n    pub eng: u8,\n    /// Heat, dose...: the gesture's meter (0..1.3).\n    pub meter: f32,\n    pub score: i64,\n    pub chain: u32,\n    pub gift: f32,\n    pub gift_kind: u8,\n    pub arming: bool,\n    pub recoil: f32,\n    pub clink: f32,\n    pub hover: u32,\n    pub flow: f32,\n    pub charge: f32,\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct ActorView {\n    pub rig: String,\n    pub x: f32,\n    pub expr: String,\n    /// Seconds since it entered (slide-in with overshoot).\n    pub age: f32,\n    pub talking: bool,\n    pub leaving: f32,\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct StoryView {\n    pub scene: u16,\n    pub line: u16,\n    pub typed: f32,\n    pub who: String,\n    pub text: String,\n    pub expr: String,\n    pub actors: Vec<ActorView>,\n    pub set: String,\n    pub camera: u8,\n    pub flash: f32,\n    pub shake: f32,\n    pub auto: bool,\n    /// How long skip has been held (0..1).\n    pub skip: f32,\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct ResultsView {\n    pub case: u8,\n    pub title: String,\n    pub patient: String,\n    pub fate: String,\n    pub lines: Vec<(String, i64)>,\n    pub total: i64,\n    pub par: f32,\n    pub rank: String,\n    /// Seconds on screen: lines appear one at a time, then the stamp slams.\n    pub t: f32,\n    pub won: bool,\n    pub scores: Vec<i64>,\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct SurgeryFrame {\n    pub stage: Stage,\n    pub stage_t: f32,\n    pub time: f32,\n    pub tick: u64,\n    pub case: u8,\n    pub case_name: String,\n    pub patient: String,\n    pub life: String,\n    pub diagnosis: String,\n    pub surgeon: String,\n    pub phase: u16,\n    pub now: String,\n    pub guide: bool,\n    pub plate: u8,\n    pub plate_prev: u8,\n    pub reveal: f32,\n    pub reveal_at: Vec2,\n    pub vitals: f32,\n    pub bpm: f32,\n    pub beat: f32,\n    pub beats: u32,\n    pub meter: u8,\n    pub bar: u8,\n    pub stopped: bool,\n    pub timer: f32,\n    pub timer_max: f32,\n    pub fever: Option<f32>,\n    pub heat_ring: Option<f32>,\n    pub ring_warn: f32,\n    pub hush: f32,\n    pub echo: f32,\n    pub duet: bool,\n    pub gift_locked: bool,\n    pub time_scale: f32,\n    pub hazards: Vec<Hazard>,\n    pub stains: Vec<Stain>,\n    pub threads: Vec<Thread>,\n    pub floats: Vec<Float>,\n    pub flights: Vec<Flight>,\n    pub slots: Vec<SlotView>,\n    pub ring: [u8; 8],\n    pub callout: Option<Callout>,\n    pub banner: String,\n    pub banner_t: f32,\n    pub code: Option<Code>,\n    pub codes_left: u8,\n    pub iv_cd: f32,\n    pub ghost: Vec2,\n    pub ghost_t: f32,\n    pub ripple: f32,\n    pub shake: f32,\n    pub flash: f32,\n    pub push: f32,\n    pub camera: CameraShot,\n    pub story: Option<StoryView>,\n    pub results: Option<ResultsView>,\n    pub music: u8,\n    pub crisis: f32,\n    pub demo: bool,\n    pub death_time: String,\n    pub can_retry: bool,\n    /// Full-screen panel the sim wants: 0 none.\n    pub mirror: bool,\n}\n\nimpl SurgeryFrame {\n    pub fn ring_tool(&self, pos: usize) -> Tool {\n        Tool::from_u8(self.ring[pos.min(7)])\n    }\n}\nEOF\ncat > bot.rs <<'EOF'\n//! The bot: a task planner that picks the most urgent valid task, selects the instrument, moves\n//! at a human cursor speed and performs the gesture, with noise scaled by skill. It is a pure\n//! function of the state, so it drives tests, the balance tool, attract, and the Case 7 partner.\n\nuse glam::Vec2;\n\nuse super::field::{Eng, Hazard, Kind, Op, Rules, Tool, angle_diff, iv_port, wound_frame};\nuse crate::input::{SurgeonInput, surgeon_buttons as btn};\nuse crate::rng::hash_f32;\n\nconst DT: f32 = 1.0 / 60.0;\n\nfn noise(tick: u64, slot: usize, salt: i32) -> f32 {\n    hash_f32(0x5eed, (tick / 18) as i32, slot as i32, salt) * 2.0 - 1.0\n}\n\nfn step_to(from: Vec2, to: Vec2, speed: f32) -> Vec2 {\n    let d = to - from;\n    let m = speed * DT;\n    if d.length() <= m { to } else { from + d / d.length() * m }\n}\n\nimpl Op {\n    fn ring_pos(&self, tool: Tool) -> Option<u8> {\n        self.ring.iter().position(|t| *t == tool).map(|p| p as u8)\n    }\n\n    fn urgency(&self, h: &Hazard, i: usize, p: Vec2) -> f32 {\n        let base = match h.kind {\n            Kind::Bleeder => 10.0,\n            Kind::Incision if h.deadline > 0.0 => 12.0,\n            Kind::Sac => 6.0 + h.prog * 8.0,\n            Kind::Nodule => {\n                if h.stage == 1 {\n                    14.0\n                } else {\n                    7.5\n                }\n            }\n            Kind::Tendril | Kind::Furnace => 8.0,\n            Kind::Lacer => 6.0,\n            Kind::Pool => {\n                if h.blocking || h.r > 0.9 {\n                    5.0\n                } else {\n                    3.5\n                }\n            }\n            Kind::Object => 6.5,\n            _ => 5.0,\n        };\n        let shared = if (h.id as usize + i) % 2 == 0 { 0.0 } else { 0.8 };\n        base - h.a.distance(p) * 0.18 - shared\n    }\n\n    /// What a surgeon of `rules.bot_skill` would do this tick.\n    pub fn bot_input(&self, i: usize, r: &Rules) -> SurgeonInput {\n        let skill = r.bot_skill.clamp(0.0, 1.0);\n        let s = &self.slots[i];\n        let mut inp = SurgeonInput { active: true, abs: true, aim: s.aim, ..Default::default() };\n        if skill <= 0.0 {\n            return inp;\n        }\n        let speed = 15.0 * (0.25 + 0.75 * skill);\n        let sloppy = 1.0 - skill;\n        let n = |salt: i32| noise(r.tick, i, salt);\n\n        if let Some(c) = &self.code {\n            let ready = s.charge >= 1.0;\n            let centred = (c.ghost - 0.5).abs() * 0.9 < 0.05 + sloppy * 0.3;\n            let release = ready && centred;\n            if !release {\n                inp.held |= btn::DEFIB;\n            }\n            return inp;\n        }\n\n        // The gift: hold, then let go on the heartbeat.\n        let shared = self.slots[0].gift_kind == 3;\n        let meter = if shared { 0 } else { i };\n        if !self.gifts.locked\n            && s.gift_kind != 0\n            && self.slots[meter].gift >= 100.0\n            && self.gifts.hush <= 0.0\n            && self.gifts.echo <= 0.0\n            && skill > 0.5\n            && self.hazards.iter().filter(|h| h.blocking).count() >= 2\n        {\n            let about_to_beat = self.heart.phase > 0.97 || self.heart.phase < 0.05;\n            if !(s.arming && about_to_beat) {\n                inp.held |= btn::GIFT;\n            }\n        }\n\n        // Let go before a heat ring reaches the hand.\n        if let Some(radius) = self.heat_ring {\n            let d = s.cursor.length();\n            if radius < d + 1.3 && radius > d - 0.9 {\n                return inp;\n            }\n        }\n\n        // Finish what the hand is doing.\n        if let Some(out) = self.bot_engaged(i, r, inp, speed, sloppy) {\n            return out;\n        }\n\n        // A breath between actions, longer for the less skilled.\n        if s.since_action < sloppy * 1.1 {\n            return inp;\n        }\n\n        // Top up the patient when it's needed.\n        let want_iv = self.vitals < 52.0 + skill * 8.0;\n        if want_iv && self.iv_cd <= 0.0 && self.ring_pos(Tool::Iv).is_some() {\n            let pos = self.ring_pos(Tool::Iv).unwrap();\n            if s.tool != pos {\n                inp.tool = pos + 1;\n            }\n            inp.aim = step_to(s.aim, iv_port(), speed);\n            if s.tool == pos {\n                inp.held |= btn::USE;\n            }\n            return inp;\n        }\n\n        // Anything hidden, the Scanner finds.\n        let hidden = self.hazards.iter().filter(|h| !h.visible()).min_by(|a, b| {\n            a.a.distance(s.cursor).total_cmp(&b.a.distance(s.cursor))\n        });\n        let tool_ctx = self.tool_of(i);\n        if tool_ctx == Tool::Dressing {\n            if let Some(h) = self.hazards.iter().find(|h| h.kind == Kind::Closure) {\n                let spot = h.spot();\n                inp.aim = step_to(s.aim, spot, speed);\n                if s.aim.distance(spot) < 0.25 {\n                    inp.held |= btn::USE;\n                }\n                return inp;\n            }\n        }\n        let mut best: Option<(f32, usize, Tool)> = None;\n        for (k, h) in self.hazards.iter().enumerate() {\n            if !h.visible() || self.held_by_other(h.id, i) {\n                continue;\n            }\n            let tool = match h.takes() {\n                Some(t) => t,\n                None => continue,\n            };\n            if self.ring_pos(tool).is_none() {\n                continue;\n            }\n            if self.covered(h) {\n                continue;\n            }\n            let u = self.urgency(h, i, s.cursor);\n            if best.is_none_or(|(b, _, _)| u > b) {\n                best = Some((u, k, tool));\n            }\n        }\n        if let Some(h) = hidden.filter(|_| best.is_none_or(|(u, _, _)| u < 7.0)) {\n            if let Some(pos) = self.ring_pos(Tool::Scanner) {\n                if s.tool != pos {\n                    inp.tool = pos + 1;\n                    return inp;\n                }\n                inp.aim = step_to(s.aim, h.a, speed * 0.7);\n                inp.held |= btn::USE;\n                return inp;\n            }\n        }\n        let Some((_, k, tool)) = best else {\n            return inp;\n        };\n        let h = &self.hazards[k];\n        let pos = self.ring_pos(tool).unwrap();\n        if s.tool != pos {\n            inp.tool = pos + 1;\n            return inp;\n        }\n        let spot = h.spot();\n        // A target that is about to step isn't worth starting on.\n        if h.kind == Kind::Nodule && h.stage == 0 && h.telegraph && h.fill < 0.3 {\n            inp.aim = step_to(s.aim, spot, speed * 0.5);\n            return inp;\n        }\n        let aim = if h.kind == Kind::Patch || h.kind == Kind::Pool {\n            h.a + Vec2::new((r.time * 9.0).sin(), (r.time * 7.0).cos()) * (h.r * 0.25)\n        } else {\n            spot\n        };\n        inp.aim = step_to(s.aim, aim, speed);\n        let close = s.aim.distance(aim) < match tool {\n            Tool::Suction | Tool::Gel => (h.r * 0.8).max(0.25),\n            _ => 0.18,\n        };\n        if close {\n            inp.held |= btn::USE;\n            inp.pressure = 1.0;\n        }\n        inp\n    }\n\n    fn bot_engaged(&self, i: usize, r: &Rules, mut inp: SurgeonInput, speed: f32, sloppy: f32) -> Option<SurgeonInput> {\n        let s = &self.slots[i];\n        let n = |salt: i32| noise(r.tick, i, salt);\n        match s.eng {\n            Eng::Cut | Eng::Dress => {\n                let h = &self.hazards[self.find(s.eng_id)?];\n                let len = h.path_len().max(0.5);\n                let t = (h.prog + (5.5 + 3.0 * (1.0 - sloppy)) * DT / len + 0.02).min(1.0);\n                let along = h.path(t);\n                let d = (h.path((t + 0.02).min(1.0)) - h.path((t - 0.02).max(0.0))).normalize_or_zero();\n                let wander = d.perp() * n(1) * sloppy * 1.05;\n                inp.aim = step_to(s.aim, along + wander, speed.max(8.0));\n                inp.held |= btn::USE;\n                Some(inp)\n            }\n            Eng::Pull => {\n                let h = &self.hazards[self.find(s.eng_id)?];\n                let axis = Vec2::from_angle(h.ang);\n                inp.held |= btn::USE;\n                if h.kind == Kind::Tendril {\n                    let v = 4.2;\n                    inp.aim = s.aim + axis * if self.heart.systole() { -v * DT * 1.8 } else { v * DT };\n                    return Some(inp);\n                }\n                let err = n(2) * sloppy * 0.95;\n                let dir = Vec2::from_angle(h.ang + err);\n                inp.aim = step_to(s.aim, s.eng_start + dir * 1.25, 3.6);\n                Some(inp)\n            }\n            Eng::Stitch => {\n                let h = &self.hazards[self.find(s.eng_id)?];\n                let (ax, _, _) = wound_frame(h, s.aim);\n                let len = h.a.distance(h.b).max(0.1);\n                let needle = len * (h.n as f32 + 0.5) / h.need.max(1) as f32;\n                let across = Vec2::new(ax.y, -ax.x);\n                let want = -(s.side as f32) * 0.32;\n                let off = n(3) * sloppy * 1.0;\n                inp.aim = step_to(s.aim, h.a + ax * (needle + off) + across * want, (speed * 0.8).max(5.0));\n                inp.held |= btn::USE;\n                Some(inp)\n            }\n            Eng::Heat => {\n                let h = &self.hazards[self.find(s.eng_id)?];\n                let target = 0.965 + n(4) * sloppy * 0.32;\n                if h.fill < target {\n                    inp.held |= btn::USE;\n                    inp.aim = step_to(s.aim, h.spot(), speed);\n                }\n                Some(inp)\n            }\n            Eng::Iv => {\n                let target = 0.97 + n(5) * sloppy * 0.4;\n                if s.eng_a < target {\n                    inp.held |= btn::USE;\n                }\n                Some(inp)\n            }\n            Eng::Bone => {\n                let h = &self.hazards[self.find(s.eng_id)?];\n                inp.aim = step_to(s.aim, h.b, (speed * 0.6).max(4.0));\n                let d = angle_diff(h.ang, 0.0);\n                if d.abs() > 0.08 {\n                    inp.held |= if d > 0.0 { btn::ROT_L } else { btn::ROT_R };\n                }\n                inp.held |= btn::USE;\n                Some(inp)\n            }\n            _ => None,\n        }\n    }\n}\nEOF\ngrep -c \"\" field.rs strain.rs bot.rs","description":"Write cue table, coverage, frame types and the bot"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":52768,"cache_read_input_tokens":256726,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":52768},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"9c93ed93-ce77-4d6a-ab9d-987d63f78196","timestamp":"2026-11-05T14:39:57.874Z","request_id":"req_011Cgjx9RJ83GeZuUGTbtm8o","wire_tool_inputs":{"toolu_01Q7gcyLWMJveCboxvW4WvVv":{"command":"cd crates/pav_core/src/games/surgery\nsed -i 's|let dt = 1.0 / 60.0;|let dt = self.time_scale / 60.0;|' strain.rs\npython3 - <<'EOF'\np='field.rs'; s=open(p).read()\ns=s.replace('''            s.held = inp.held;\n            s.pressed = inp.pressed | (inp.held & !s.held & 0);\n''','''            s.pressed = inp.pressed | (inp.held & !s.held);\n            s.held = inp.held;\n''')\ns=s.replace('''            if !held {\n                self.hazards[k].prog = 0.0;\n                self.release(i);\n                return;\n            }\n            let h = &self.hazards[k];\n            if h.kind == Kind::Tendril {''','''            if !held {\n                if self.hazards[k].kind != Kind::Tendril {\n                    self.hazards[k].prog = 0.0;\n                }\n                self.release(i);\n                return;\n            }\n            let h = &self.hazards[k];\n            if h.kind == Kind::Tendril {''')\ns=s.replace(\"h.prog = (h.prog + along * 0.085 * rules\",\"h.prog = (h.prog + along * 0.055 * rules\")\nopen(p,'w').write(s)\nEOF\ncat > cue.rs <<'EOF'\n//! The cue table: every sound the game's simulation asks for, by id. `pav_audio` holds each\n//! cue's synthesis, `pav_view` its particles; story and case files name them.\n\nmacro_rules! cues {\n    ($($name:ident = $n:literal, $key:literal;)*) => {\n        $(pub const $name: u16 = $n;)*\n        pub const NAMES: &[&str] = &[$($key),*];\n    };\n}\n\ncues! {\n    TOOL_PICK = 0, \"tool_pick\";\n    SLICE = 1, \"slice\";\n    SQUISH = 2, \"squish\";\n    FORCEPS = 3, \"forceps\";\n    PULL_POP = 4, \"pull_pop\";\n    SUTURE = 5, \"suture\";\n    GURGLE = 6, \"gurgle\";\n    LASER = 7, \"laser\";\n    SIZZLE = 8, \"sizzle\";\n    GEL = 9, \"gel\";\n    IV = 10, \"iv\";\n    SONAR = 11, \"sonar\";\n    DEFIB_WHINE = 12, \"defib_whine\";\n    DEFIB_THUMP = 13, \"defib_thump\";\n    LUB = 14, \"lub\";\n    MONITOR = 15, \"monitor\";\n    ALARM = 16, \"alarm\";\n    RATE_SLOPPY = 17, \"rate_sloppy\";\n    RATE_GOOD = 18, \"rate_good\";\n    RATE_CLEAN = 19, \"rate_clean\";\n    RATE_IMMACULATE = 20, \"rate_immaculate\";\n    CHAIN_UP = 21, \"chain_up\";\n    ON_BEAT = 22, \"on_beat\";\n    STING = 23, \"sting\";\n    BURST = 24, \"burst\";\n    UI_NAV = 25, \"ui_nav\";\n    UI_CONFIRM = 26, \"ui_confirm\";\n    UI_BACK = 27, \"ui_back\";\n    BANNER = 28, \"banner\";\n    FLATLINE = 29, \"flatline\";\n    CLINK = 30, \"clink\";\n    FROST = 31, \"frost\";\n    CRACK = 32, \"crack\";\n    SNAP = 33, \"snap\";\n    LIFT_OFF = 34, \"lift_off\";\n    RING = 35, \"ring\";\n    HUSH = 36, \"hush\";\n    ECHO = 37, \"echo\";\n    DUET = 38, \"duet\";\n    STAMP = 39, \"stamp\";\n    THUNDER = 40, \"thunder\";\n    TEAR = 41, \"tear\";\n    GIFT_ARM = 42, \"gift_arm\";\n    GASP = 43, \"gasp\";\n    LIFT = 44, \"lift\";\n    PHONE = 45, \"phone\";\n    GLASS = 46, \"glass\";\n}\n\npub fn id(name: &str) -> Option<u16> {\n    NAMES.iter().position(|n| *n == name).map(|p| p as u16)\n}\nEOF\ncat > cover.rs <<'EOF'\n//! Coverage counters: what a playthrough actually did. A test proves the campaign exercises\n//! every instrument, hazard, strain phase, gift and the Code.\n\n/// Every name a counter can have; unknown names are ignored (phases past the list, say).\npub const NAMES: &[&str] = &[\n    \"tool:scalpel\", \"tool:forceps\", \"tool:suture\", \"tool:suction\", \"tool:laser\", \"tool:gel\", \"tool:scanner\", \"tool:iv\",\n    \"tool:cryo\", \"tool:dressing\", \"tool:defib\",\n    \"rated:scalpel\", \"rated:forceps\", \"rated:suture\", \"rated:suction\", \"rated:laser\", \"rated:gel\", \"rated:iv\", \"rated:cryo\",\n    \"rated:dressing\", \"rated:defib\",\n    \"hazard:incision\", \"hazard:lacer\", \"hazard:pool\", \"hazard:bleeder\", \"hazard:object\", \"hazard:polyp\", \"hazard:tumor\",\n    \"hazard:patch\", \"hazard:bone\", \"hazard:closure\", \"hazard:nodule\", \"hazard:sac\", \"hazard:eye\", \"hazard:ember\",\n    \"hazard:furnace\", \"hazard:tendril\",\n    \"done:incision\", \"done:lacer\", \"done:pool\", \"done:bleeder\", \"done:object\", \"done:polyp\", \"done:tumor\", \"done:patch\",\n    \"done:bone\", \"done:closure\", \"done:nodule\", \"done:sac\", \"done:eye\", \"done:ember\", \"done:furnace\", \"done:tendril\",\n    \"strain:introit\", \"strain:lacrimosa\", \"strain:dies\", \"strain:soloist\", \"strain:tendril\", \"strain:director\",\n    \"lacrimosa:wave1\", \"lacrimosa:wave2\", \"lacrimosa:wave3\", \"lacrimosa:burst\", \"dies:countin\", \"dies:ring\", \"dies:merge\",\n    \"dies:crack\", \"furnace:0\", \"furnace:1\", \"furnace:2\", \"furnace:3\", \"furnace:4\", \"duet:window\", \"hush:woke\", \"director:strain\",\n    \"gift:hush\", \"gift:echo\", \"gift:duet\", \"echo:repeat\", \"code\", \"code:scripted\", \"on_beat\", \"chain\", \"wrong_tool\", \"scorch\",\n    \"mistake:lacerate\", \"mistake:burn\", \"mistake:overdose\", \"death:time\", \"death:vitals\", \"death:code\",\n    \"rating:immaculate\", \"rating:clean\", \"rating:good\", \"rating:sloppy\",\n];\n\npub fn mark(cov: &mut [u32], name: &str) {\n    if let Some(k) = NAMES.iter().position(|n| *n == name) {\n        if let Some(c) = cov.get_mut(k) {\n            *c += 1;\n        }\n    }\n}\n\npub fn merge(into: &mut Vec<u32>, from: &[u32]) {\n    into.resize(NAMES.len(), 0);\n    for (a, b) in into.iter_mut().zip(from) {\n        *a += *b;\n    }\n}\n\npub fn get(cov: &[u32], name: &str) -> u32 {\n    NAMES.iter().position(|n| *n == name).and_then(|k| cov.get(k).copied()).unwrap_or(0)\n}\nEOF\ncat > frame.rs <<'EOF'\n//! `SurgeryFrame`: the single source of everything drawn and heard. Built from the sim on the\n//! host; decoded from the network on a client (`net`). The view and HUD read nothing else.\n\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\n\nuse super::field::{Callout, Code, Flight, Float, Hazard, Stain, Thread, Tool};\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum Stage {\n    /// The softly beating plate behind the title and menus.\n    #[default]\n    Title,\n    Story,\n    Chart,\n    Op,\n    /// OPERATION COMPLETE.\n    Complete,\n    Results,\n    Dead,\n    Done,\n    /// The hub's pre-op board.\n    Card,\n}\n\n/// Where the camera should be. Applied to `CameraRig` in the app and the tools.\n#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]\npub struct CameraShot {\n    pub target: [f32; 3],\n    pub tilt: f32,\n    pub yaw: f32,\n    pub distance: f32,\n    pub fov: f32,\n    /// Seconds to glide there when this shot changes.\n    pub blend: f32,\n}\n\nimpl Default for CameraShot {\n    fn default() -> Self {\n        Self::field()\n    }\n}\n\nimpl CameraShot {\n    /// The surgeon's-eye view of the field.\n    pub fn field() -> Self {\n        Self { target: [0.0, 0.0, 0.2], tilt: 73.0, yaw: 0.0, distance: 19.9, fov: 36.0, blend: 0.0 }\n    }\n    /// The paper theatre, straight on.\n    pub fn paper() -> Self {\n        Self { target: [0.0, 0.0, 0.0], tilt: 0.0, yaw: 0.0, distance: 14.0, fov: 26.0, blend: 0.0 }\n    }\n    /// The 3D wide shot of the OR set, far from the field.\n    pub fn or_wide() -> Self {\n        Self { target: [97.0, 1.0, -2.0], tilt: 28.0, yaw: -24.0, distance: 13.5, fov: 34.0, blend: 0.0 }\n    }\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct SlotView {\n    pub active: bool,\n    pub bot: bool,\n    pub cursor: Vec2,\n    /// The instrument in hand.\n    pub tool: u8,\n    /// Its ring position.\n    pub ring_pos: u8,\n    pub using: bool,\n    pub pressure: f32,\n    /// 0 none, 1 cut, 2 pull, 3 stitch, 4 suck, 5 heat, 6 paint, 7 scan, 8 IV, 9 dress, 10 bone.\n    pub eng: u8,\n    /// Heat, dose...: the gesture's meter (0..1.3).\n    pub meter: f32,\n    pub score: i64,\n    pub chain: u32,\n    pub gift: f32,\n    pub gift_kind: u8,\n    pub arming: bool,\n    pub recoil: f32,\n    pub clink: f32,\n    pub hover: u32,\n    pub flow: f32,\n    pub charge: f32,\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct ActorView {\n    pub rig: String,\n    pub x: f32,\n    pub expr: String,\n    /// Seconds since it entered (slide-in with overshoot).\n    pub age: f32,\n    pub talking: bool,\n    pub leaving: f32,\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct StoryView {\n    pub scene: u16,\n    pub line: u16,\n    pub typed: f32,\n    pub who: String,\n    pub text: String,\n    pub expr: String,\n    pub actors: Vec<ActorView>,\n    pub set: String,\n    pub camera: u8,\n    pub flash: f32,\n    pub shake: f32,\n    pub auto: bool,\n    /// How long skip has been held (0..1).\n    pub skip: f32,\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct ResultsView {\n    pub case: u8,\n    pub title: String,\n    pub patient: String,\n    pub fate: String,\n    pub lines: Vec<(String, i64)>,\n    pub total: i64,\n    pub par: f32,\n    pub rank: String,\n    /// Seconds on screen: lines appear one at a time, then the stamp slams.\n    pub t: f32,\n    pub won: bool,\n    pub scores: Vec<i64>,\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct SurgeryFrame {\n    pub stage: Stage,\n    pub stage_t: f32,\n    pub time: f32,\n    pub tick: u64,\n    pub case: u8,\n    pub case_name: String,\n    pub patient: String,\n    pub life: String,\n    pub diagnosis: String,\n    pub surgeon: String,\n    pub phase: u16,\n    pub now: String,\n    pub guide: bool,\n    pub plate: u8,\n    pub plate_prev: u8,\n    pub reveal: f32,\n    pub reveal_at: Vec2,\n    pub vitals: f32,\n    pub bpm: f32,\n    pub beat: f32,\n    pub beats: u32,\n    pub meter: u8,\n    pub bar: u8,\n    pub stopped: bool,\n    pub timer: f32,\n    pub timer_max: f32,\n    pub fever: Option<f32>,\n    pub heat_ring: Option<f32>,\n    pub ring_warn: f32,\n    pub hush: f32,\n    pub echo: f32,\n    pub duet: bool,\n    pub gift_locked: bool,\n    pub time_scale: f32,\n    pub hazards: Vec<Hazard>,\n    pub stains: Vec<Stain>,\n    pub threads: Vec<Thread>,\n    pub floats: Vec<Float>,\n    pub flights: Vec<Flight>,\n    pub slots: Vec<SlotView>,\n    pub ring: [u8; 8],\n    pub callout: Option<Callout>,\n    pub banner: String,\n    pub banner_t: f32,\n    pub code: Option<Code>,\n    pub codes_left: u8,\n    pub iv_cd: f32,\n    pub ghost: Vec2,\n    pub ghost_t: f32,\n    pub ripple: f32,\n    pub shake: f32,\n    pub flash: f32,\n    pub push: f32,\n    pub camera: CameraShot,\n    pub story: Option<StoryView>,\n    pub results: Option<ResultsView>,\n    pub music: u8,\n    pub crisis: f32,\n    pub demo: bool,\n    pub death_time: String,\n    pub can_retry: bool,\n    /// Full-screen panel the sim wants: 0 none.\n    pub mirror: bool,\n}\n\nimpl SurgeryFrame {\n    pub fn ring_tool(&self, pos: usize) -> Tool {\n        Tool::from_u8(self.ring[pos.min(7)])\n    }\n}\nEOF\ncat > bot.rs <<'EOF'\n//! The bot: a task planner that picks the most urgent valid task, selects the instrument, moves\n//! at a human cursor speed and performs the gesture, with noise scaled by skill. It is a pure\n//! function of the state, so it drives tests, the balance tool, attract, and the Case 7 partner.\n\nuse glam::Vec2;\n\nuse super::field::{Eng, Hazard, Kind, Op, Rules, Tool, angle_diff, iv_port, wound_frame};\nuse crate::input::{SurgeonInput, surgeon_buttons as btn};\nuse crate::rng::hash_f32;\n\nconst DT: f32 = 1.0 / 60.0;\n\nfn noise(tick: u64, slot: usize, salt: i32) -> f32 {\n    hash_f32(0x5eed, (tick / 18) as i32, slot as i32, salt) * 2.0 - 1.0\n}\n\nfn step_to(from: Vec2, to: Vec2, speed: f32) -> Vec2 {\n    let d = to - from;\n    let m = speed * DT;\n    if d.length() <= m { to } else { from + d / d.length() * m }\n}\n\nimpl Op {\n    fn ring_pos(&self, tool: Tool) -> Option<u8> {\n        self.ring.iter().position(|t| *t == tool).map(|p| p as u8)\n    }\n\n    fn urgency(&self, h: &Hazard, i: usize, p: Vec2) -> f32 {\n        let base = match h.kind {\n            Kind::Bleeder => 10.0,\n            Kind::Incision if h.deadline > 0.0 => 12.0,\n            Kind::Sac => 6.0 + h.prog * 8.0,\n            Kind::Nodule => {\n                if h.stage == 1 {\n                    14.0\n                } else {\n                    7.5\n                }\n            }\n            Kind::Tendril | Kind::Furnace => 8.0,\n            Kind::Lacer => 6.0,\n            Kind::Pool => {\n                if h.blocking || h.r > 0.9 {\n                    5.0\n                } else {\n                    3.5\n                }\n            }\n            Kind::Object => 6.5,\n            _ => 5.0,\n        };\n        let shared = if (h.id as usize + i) % 2 == 0 { 0.0 } else { 0.8 };\n        base - h.a.distance(p) * 0.18 - shared\n    }\n\n    /// What a surgeon of `rules.bot_skill` would do this tick.\n    pub fn bot_input(&self, i: usize, r: &Rules) -> SurgeonInput {\n        let skill = r.bot_skill.clamp(0.0, 1.0);\n        let s = &self.slots[i];\n        let mut inp = SurgeonInput { active: true, abs: true, aim: s.aim, ..Default::default() };\n        if skill <= 0.0 {\n            return inp;\n        }\n        let speed = 15.0 * (0.25 + 0.75 * skill);\n        let sloppy = 1.0 - skill;\n        let n = |salt: i32| noise(r.tick, i, salt);\n\n        if let Some(c) = &self.code {\n            let ready = s.charge >= 1.0;\n            let centred = (c.ghost - 0.5).abs() * 0.9 < 0.05 + sloppy * 0.3;\n            let release = ready && centred;\n            if !release {\n                inp.held |= btn::DEFIB;\n            }\n            return inp;\n        }\n\n        // The gift: hold, then let go on the heartbeat.\n        let shared = self.slots[0].gift_kind == 3;\n        let meter = if shared { 0 } else { i };\n        if !self.gifts.locked\n            && s.gift_kind != 0\n            && self.slots[meter].gift >= 100.0\n            && self.gifts.hush <= 0.0\n            && self.gifts.echo <= 0.0\n            && skill > 0.5\n            && self.hazards.iter().filter(|h| h.blocking).count() >= 2\n        {\n            let about_to_beat = self.heart.phase > 0.97 || self.heart.phase < 0.05;\n            if !(s.arming && about_to_beat) {\n                inp.held |= btn::GIFT;\n            }\n        }\n\n        // Let go before a heat ring reaches the hand.\n        if let Some(radius) = self.heat_ring {\n            let d = s.cursor.length();\n            if radius < d + 1.3 && radius > d - 0.9 {\n                return inp;\n            }\n        }\n\n        // Finish what the hand is doing.\n        if let Some(out) = self.bot_engaged(i, r, inp, speed, sloppy) {\n            return out;\n        }\n\n        // A breath between actions, longer for the less skilled.\n        if s.since_action < sloppy * 1.1 {\n            return inp;\n        }\n\n        // Top up the patient when it's needed.\n        let want_iv = self.vitals < 52.0 + skill * 8.0;\n        if want_iv && self.iv_cd <= 0.0 && self.ring_pos(Tool::Iv).is_some() {\n            let pos = self.ring_pos(Tool::Iv).unwrap();\n            if s.tool != pos {\n                inp.tool = pos + 1;\n            }\n            inp.aim = step_to(s.aim, iv_port(), speed);\n            if s.tool == pos {\n                inp.held |= btn::USE;\n            }\n            return inp;\n        }\n\n        // Anything hidden, the Scanner finds.\n        let hidden = self.hazards.iter().filter(|h| !h.visible()).min_by(|a, b| {\n            a.a.distance(s.cursor).total_cmp(&b.a.distance(s.cursor))\n        });\n        let tool_ctx = self.tool_of(i);\n        if tool_ctx == Tool::Dressing {\n            if let Some(h) = self.hazards.iter().find(|h| h.kind == Kind::Closure) {\n                let spot = h.spot();\n                inp.aim = step_to(s.aim, spot, speed);\n                if s.aim.distance(spot) < 0.25 {\n                    inp.held |= btn::USE;\n                }\n                return inp;\n            }\n        }\n        let mut best: Option<(f32, usize, Tool)> = None;\n        for (k, h) in self.hazards.iter().enumerate() {\n            if !h.visible() || self.held_by_other(h.id, i) {\n                continue;\n            }\n            let tool = match h.takes() {\n                Some(t) => t,\n                None => continue,\n            };\n            if self.ring_pos(tool).is_none() {\n                continue;\n            }\n            if self.covered(h) {\n                continue;\n            }\n            let u = self.urgency(h, i, s.cursor);\n            if best.is_none_or(|(b, _, _)| u > b) {\n                best = Some((u, k, tool));\n            }\n        }\n        if let Some(h) = hidden.filter(|_| best.is_none_or(|(u, _, _)| u < 7.0)) {\n            if let Some(pos) = self.ring_pos(Tool::Scanner) {\n                if s.tool != pos {\n                    inp.tool = pos + 1;\n                    return inp;\n                }\n                inp.aim = step_to(s.aim, h.a, speed * 0.7);\n                inp.held |= btn::USE;\n                return inp;\n            }\n        }\n        let Some((_, k, tool)) = best else {\n            return inp;\n        };\n        let h = &self.hazards[k];\n        let pos = self.ring_pos(tool).unwrap();\n        if s.tool != pos {\n            inp.tool = pos + 1;\n            return inp;\n        }\n        let spot = h.spot();\n        // A target that is about to step isn't worth starting on.\n        if h.kind == Kind::Nodule && h.stage == 0 && h.telegraph && h.fill < 0.3 {\n            inp.aim = step_to(s.aim, spot, speed * 0.5);\n            return inp;\n        }\n        let aim = if h.kind == Kind::Patch || h.kind == Kind::Pool {\n            h.a + Vec2::new((r.time * 9.0).sin(), (r.time * 7.0).cos()) * (h.r * 0.25)\n        } else {\n            spot\n        };\n        inp.aim = step_to(s.aim, aim, speed);\n        let close = s.aim.distance(aim) < match tool {\n            Tool::Suction | Tool::Gel => (h.r * 0.8).max(0.25),\n            _ => 0.18,\n        };\n        if close {\n            inp.held |= btn::USE;\n            inp.pressure = 1.0;\n        }\n        inp\n    }\n\n    fn bot_engaged(&self, i: usize, r: &Rules, mut inp: SurgeonInput, speed: f32, sloppy: f32) -> Option<SurgeonInput> {\n        let s = &self.slots[i];\n        let n = |salt: i32| noise(r.tick, i, salt);\n        match s.eng {\n            Eng::Cut | Eng::Dress => {\n                let h = &self.hazards[self.find(s.eng_id)?];\n                let len = h.path_len().max(0.5);\n                let t = (h.prog + (5.5 + 3.0 * (1.0 - sloppy)) * DT / len + 0.02).min(1.0);\n                let along = h.path(t);\n                let d = (h.path((t + 0.02).min(1.0)) - h.path((t - 0.02).max(0.0))).normalize_or_zero();\n                let wander = d.perp() * n(1) * sloppy * 1.05;\n                inp.aim = step_to(s.aim, along + wander, speed.max(8.0));\n                inp.held |= btn::USE;\n                Some(inp)\n            }\n            Eng::Pull => {\n                let h = &self.hazards[self.find(s.eng_id)?];\n                let axis = Vec2::from_angle(h.ang);\n                inp.held |= btn::USE;\n                if h.kind == Kind::Tendril {\n                    let v = 4.2;\n                    inp.aim = s.aim + axis * if self.heart.systole() { -v * DT * 1.8 } else { v * DT };\n                    return Some(inp);\n                }\n                let err = n(2) * sloppy * 0.95;\n                let dir = Vec2::from_angle(h.ang + err);\n                inp.aim = step_to(s.aim, s.eng_start + dir * 1.25, 3.6);\n                Some(inp)\n            }\n            Eng::Stitch => {\n                let h = &self.hazards[self.find(s.eng_id)?];\n                let (ax, _, _) = wound_frame(h, s.aim);\n                let len = h.a.distance(h.b).max(0.1);\n                let needle = len * (h.n as f32 + 0.5) / h.need.max(1) as f32;\n                let across = Vec2::new(ax.y, -ax.x);\n                let want = -(s.side as f32) * 0.32;\n                let off = n(3) * sloppy * 1.0;\n                inp.aim = step_to(s.aim, h.a + ax * (needle + off) + across * want, (speed * 0.8).max(5.0));\n                inp.held |= btn::USE;\n                Some(inp)\n            }\n            Eng::Heat => {\n                let h = &self.hazards[self.find(s.eng_id)?];\n                let target = 0.965 + n(4) * sloppy * 0.32;\n                if h.fill < target {\n                    inp.held |= btn::USE;\n                    inp.aim = step_to(s.aim, h.spot(), speed);\n                }\n                Some(inp)\n            }\n            Eng::Iv => {\n                let target = 0.97 + n(5) * sloppy * 0.4;\n                if s.eng_a < target {\n                    inp.held |= btn::USE;\n                }\n                Some(inp)\n            }\n            Eng::Bone => {\n                let h = &self.hazards[self.find(s.eng_id)?];\n                inp.aim = step_to(s.aim, h.b, (speed * 0.6).max(4.0));\n                let d = angle_diff(h.ang, 0.0);\n                if d.abs() > 0.08 {\n                    inp.held |= if d > 0.0 { btn::ROT_L } else { btn::ROT_R };\n                }\n                inp.held |= btn::USE;\n                Some(inp)\n            }\n            _ => None,\n        }\n    }\n}\nEOF\ngrep -c \"\" field.rs strain.rs bot.rs","description":"Write cue table, coverage, frame types and the bot"}}}
