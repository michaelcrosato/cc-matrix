{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjweVWZjpvb11KV2j8Go","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01CaFnoAfiR5d96tu8q4Gatd","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery/field.rs","content":"//! An operation: the field's hazards, the surgeon slots and their instruments, vitals and the\n//! heart, ratings and chains, the Code and the gifts. Deterministic; all logic is 2D in the\n//! field plane (x, z), held in `Vec2`.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::content::{Content, SpawnSpec, content};\nuse super::cue;\nuse super::tune::{Difficulty, Tune};\nuse crate::frame::SimEvent;\nuse crate::input::{SurgeonInput, surgeon_buttons as btn};\nuse crate::rng::Rng;\n\n// ---------------------------------------------------------------------------------------------\n// Instruments\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]\n#[repr(u8)]\npub enum Tool {\n    #[default]\n    Scalpel = 0,\n    Forceps = 1,\n    Suture = 2,\n    Suction = 3,\n    Laser = 4,\n    Gel = 5,\n    Scanner = 6,\n    Iv = 7,\n    Cryo = 8,\n    Dressing = 9,\n    Defib = 10,\n}\n\nimpl Tool {\n    pub const ALL: [Tool; 11] = [\n        Tool::Scalpel,\n        Tool::Forceps,\n        Tool::Suture,\n        Tool::Suction,\n        Tool::Laser,\n        Tool::Gel,\n        Tool::Scanner,\n        Tool::Iv,\n        Tool::Cryo,\n        Tool::Dressing,\n        Tool::Defib,\n    ];\n    pub const DEFAULT_RING: [Tool; 8] =\n        [Tool::Scalpel, Tool::Forceps, Tool::Suture, Tool::Suction, Tool::Laser, Tool::Gel, Tool::Scanner, Tool::Iv];\n\n    pub fn key(self) -> &'static str {\n        super::content::TOOLS[self as usize]\n    }\n    pub fn name(self) -> &'static str {\n        match self {\n            Tool::Scalpel => \"Scalpel\",\n            Tool::Forceps => \"Forceps\",\n            Tool::Suture => \"Suture\",\n            Tool::Suction => \"Suction\",\n            Tool::Laser => \"Laser\",\n            Tool::Gel => \"Gel\",\n            Tool::Scanner => \"Scanner\",\n            Tool::Iv => \"IV Push\",\n            Tool::Cryo => \"Cryoprobe\",\n            Tool::Dressing => \"Dressing\",\n            Tool::Defib => \"Defibrillator\",\n        }\n    }\n    pub fn from_key(k: &str) -> Option<Tool> {\n        Tool::ALL.into_iter().find(|t| t.key() == k)\n    }\n    pub fn from_u8(v: u8) -> Tool {\n        Tool::ALL[(v as usize).min(10)]\n    }\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[repr(u8)]\npub enum Rating {\n    Sloppy = 0,\n    Good = 1,\n    Clean = 2,\n    Immaculate = 3,\n}\n\nimpl Rating {\n    pub fn name(self) -> &'static str {\n        match self {\n            Rating::Sloppy => \"SLOPPY\",\n            Rating::Good => \"GOOD\",\n            Rating::Clean => \"CLEAN\",\n            Rating::Immaculate => \"IMMACULATE\",\n        }\n    }\n    pub fn points(self) -> i64 {\n        match self {\n            Rating::Sloppy => 10,\n            Rating::Good => 120,\n            Rating::Clean => 250,\n            Rating::Immaculate => 400,\n        }\n    }\n    pub fn from_u8(v: u8) -> Rating {\n        match v {\n            3 => Rating::Immaculate,\n            2 => Rating::Clean,\n            1 => Rating::Good,\n            _ => Rating::Sloppy,\n        }\n    }\n    /// Lower is better: `value` (scaled by strictness) against three thresholds.\n    fn grade(value: f32, strict: f32, a: f32, b: f32, c: f32) -> Rating {\n        let v = value * strict;\n        if v <= a {\n            Rating::Immaculate\n        } else if v <= b {\n            Rating::Clean\n        } else if v <= c {\n            Rating::Good\n        } else {\n            Rating::Sloppy\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------------------------\n// Hazards\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]\n#[repr(u8)]\npub enum Kind {\n    #[default]\n    Incision = 0,\n    Lacer = 1,\n    Pool = 2,\n    Bleeder = 3,\n    Object = 4,\n    Polyp = 5,\n    Tumor = 6,\n    Patch = 7,\n    Bone = 8,\n    Closure = 9,\n    Nodule = 10,\n    Sac = 11,\n    Eye = 12,\n    Ember = 13,\n    Furnace = 14,\n    Tendril = 15,\n}\n\nimpl Kind {\n    pub const ALL: [Kind; 16] = [\n        Kind::Incision,\n        Kind::Lacer,\n        Kind::Pool,\n        Kind::Bleeder,\n        Kind::Object,\n        Kind::Polyp,\n        Kind::Tumor,\n        Kind::Patch,\n        Kind::Bone,\n        Kind::Closure,\n        Kind::Nodule,\n        Kind::Sac,\n        Kind::Eye,\n        Kind::Ember,\n        Kind::Furnace,\n        Kind::Tendril,\n    ];\n    pub fn from_u8(v: u8) -> Kind {\n        Kind::ALL[(v as usize).min(15)]\n    }\n    pub fn key(self) -> &'static str {\n        match self {\n            Kind::Incision => \"incision\",\n            Kind::Lacer => \"lacer\",\n            Kind::Pool => \"pool\",\n            Kind::Bleeder => \"bleeder\",\n            Kind::Object => \"object\",\n            Kind::Polyp => \"polyp\",\n            Kind::Tumor => \"tumor\",\n            Kind::Patch => \"patch\",\n            Kind::Bone => \"bone\",\n            Kind::Closure => \"closure\",\n            Kind::Nodule => \"nodule\",\n            Kind::Sac => \"sac\",\n            Kind::Eye => \"eye\",\n            Kind::Ember => \"ember\",\n            Kind::Furnace => \"furnace\",\n            Kind::Tendril => \"tendril\",\n        }\n    }\n}\n\n/// `Hazard::sub` for objects.\npub mod sub {\n    pub const HOOK: u8 = 0;\n    pub const SHARD: u8 = 1;\n    pub const SPLINTER: u8 = 2;\n    /// A piece of a cracked ember: pulling it cools the Fever.\n    pub const COAL: u8 = 3;\n    /// `Patch`: 0 inflammation, 1 burn.\n    pub const BURN: u8 = 1;\n    /// `Pool`: burning fluid from a sac.\n    pub const CAUSTIC: u8 = 1;\n    /// `Nodule`: small and quick, or the Amen.\n    pub const SMALL: u8 = 1;\n    pub const AMEN: u8 = 2;\n    /// `Ember`: two merged, roaming.\n    pub const ROAMING: u8 = 1;\n    /// `Incision`: a stroke across the eye or a Soloist stroke.\n    pub const STROKE: u8 = 1;\n    /// `Incision`: a tether holding the Amen.\n    pub const TETHER: u8 = 2;\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct Hazard {\n    pub id: u32,\n    pub kind: Kind,\n    /// Position; a path's start.\n    pub a: Vec2,\n    /// A path's end; a sac's stem root; a bone's target.\n    pub b: Vec2,\n    /// A path's control point; a grabbed thing's displacement.\n    pub c: Vec2,\n    pub r: f32,\n    /// Progress 0..1 of whatever this hazard is doing or having done.\n    pub prog: f32,\n    pub stage: u8,\n    pub sub: u8,\n    pub ang: f32,\n    pub hidden: bool,\n    /// Seconds left of a Scanner's reveal.\n    pub seen: f32,\n    pub age: f32,\n    /// Seconds left before it does something by itself (0 = none).\n    pub deadline: f32,\n    pub drain: f32,\n    /// Stitches done and needed.\n    pub n: u16,\n    pub need: u16,\n    /// Blocks the phase until it is dealt with.\n    pub blocking: bool,\n    /// Heat or frost held in it (0..1.3).\n    pub fill: f32,\n    /// Seconds a full heat takes (0 = the default).\n    pub fill_time: f32,\n    /// Beats counted toward its next step (fractional: strains clamp their speed-up).\n    pub beats: f32,\n    pub telegraph: bool,\n}\n\nimpl Hazard {\n    pub fn visible(&self) -> bool {\n        !self.hidden || self.seen > 0.0\n    }\n\n    /// A point along this hazard's path, t in 0..1 (incisions and closures: a curve; a tumor\n    /// ring: a circle).\n    pub fn path(&self, t: f32) -> Vec2 {\n        match self.kind {\n            Kind::Tumor => {\n                let a = t * std::f32::consts::TAU - std::f32::consts::FRAC_PI_2;\n                self.a + Vec2::new(a.cos(), a.sin()) * self.r\n            }\n            _ => {\n                let u = 1.0 - t;\n                self.a * (u * u) + self.c * (2.0 * u * t) + self.b * (t * t)\n            }\n        }\n    }\n\n    pub fn has_path(&self) -> bool {\n        matches!(self.kind, Kind::Incision | Kind::Closure) || (self.kind == Kind::Tumor && self.stage == 0)\n    }\n\n    pub fn path_len(&self) -> f32 {\n        let mut l = 0.0;\n        let mut p = self.path(0.0);\n        for k in 1..=16 {\n            let q = self.path(k as f32 / 16.0);\n            l += p.distance(q);\n            p = q;\n        }\n        l\n    }\n\n    /// The instrument this hazard takes now.\n    pub fn takes(&self) -> Option<Tool> {\n        Some(match (self.kind, self.stage) {\n            (Kind::Incision, _) => Tool::Scalpel,\n            (Kind::Lacer | Kind::Bleeder, _) => Tool::Suture,\n            (Kind::Pool, _) => Tool::Suction,\n            (Kind::Object, _) => Tool::Forceps,\n            (Kind::Polyp, _) => Tool::Laser,\n            (Kind::Tumor, 0) => Tool::Scalpel,\n            (Kind::Tumor, 1) => Tool::Forceps,\n            (Kind::Tumor, _) => Tool::Gel,\n            (Kind::Patch, _) => Tool::Gel,\n            (Kind::Bone, 0) => Tool::Forceps,\n            (Kind::Bone, _) => Tool::Suture,\n            (Kind::Closure, _) => Tool::Dressing,\n            (Kind::Nodule, 0) => Tool::Laser,\n            (Kind::Nodule, 1) => Tool::Forceps,\n            (Kind::Nodule, _) => return None, // held by tethers\n            (Kind::Sac, _) => Tool::Laser,\n            (Kind::Eye, 1) => Tool::Forceps,\n            (Kind::Eye, _) => return None,\n            (Kind::Ember, 0) => Tool::Cryo,\n            (Kind::Ember, _) => Tool::Scalpel,\n            (Kind::Furnace, 0) => Tool::Cryo,\n            (Kind::Furnace, 1) => Tool::Scalpel,\n            (Kind::Furnace, 2) => Tool::Forceps,\n            (Kind::Furnace, 3) => Tool::Laser,\n            (Kind::Furnace, 4) => Tool::Suction,\n            (Kind::Furnace, _) => Tool::Gel,\n            (Kind::Tendril, _) => Tool::Forceps,\n        })\n    }\n\n    /// The spot an instrument aims at.\n    pub fn spot(&self) -> Vec2 {\n        match self.kind {\n            Kind::Sac => self.a.lerp(self.b, 0.55),\n            Kind::Lacer | Kind::Bleeder => self.a.lerp(self.b, self.prog.clamp(0.0, 1.0)),\n            Kind::Incision | Kind::Closure => self.path(self.prog),\n            Kind::Tumor if self.stage == 0 => self.path(self.prog),\n            Kind::Bone if self.stage == 1 => self.b,\n            _ => self.a,\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------------------------\n// The heart\n\n#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize)]\npub struct Heart {\n    /// 0..1 through the beat; the R wave is at 0.\n    pub phase: f32,\n    pub bpm: f32,\n    pub beats: u32,\n    /// Beats to a bar of the ECG's meter, and where in the bar this beat is.\n    pub meter: u8,\n    pub bar: u8,\n    /// The R wave happened this tick.\n    pub r_wave: bool,\n    pub stopped: bool,\n}\n\nimpl Heart {\n    pub fn period(&self) -> f32 {\n        60.0 / self.bpm.max(20.0)\n    }\n    /// Seconds from the nearest R wave.\n    pub fn from_r(&self) -> f32 {\n        let p = self.period();\n        (self.phase * p).min((1.0 - self.phase) * p)\n    }\n    /// Systole: the part of the beat when the heart squeezes.\n    pub fn systole(&self) -> bool {\n        self.phase < 0.35\n    }\n}\n\n// ---------------------------------------------------------------------------------------------\n// Surgeons\n\n/// What a slot is engaged with.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum Eng {\n    #[default]\n    None,\n    Cut,\n    Pull,\n    Stitch,\n    Suck,\n    Heat,\n    Paint,\n    Scan,\n    Iv,\n    Dress,\n    Bone,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Slot {\n    pub active: bool,\n    /// Played by the bot (the Case 7 partner, attract).\n    pub bot: bool,\n    /// The cursor the player steers.\n    pub aim: Vec2,\n    /// Where the instrument really is (with a tremor).\n    pub cursor: Vec2,\n    pub held: u8,\n    pub pressed: u8,\n    pub pressure: f32,\n    /// Ring position.\n    pub tool: u8,\n    pub eng: Eng,\n    pub eng_id: u32,\n    pub eng_t: f32,\n    pub eng_a: f32,\n    pub eng_b: f32,\n    pub eng_start: Vec2,\n    /// Which side of the wound the needle was last on.\n    pub side: i8,\n    pub score: i64,\n    pub chain: u32,\n    pub best_chain: u32,\n    pub chain_t: f32,\n    pub gift: f32,\n    /// 0 none, 1 Hush, 2 Echo, 3 Duet.\n    pub gift_kind: u8,\n    pub arming: bool,\n    pub tally: [u32; 4],\n    pub on_beats: u32,\n    pub since_action: f32,\n    /// Gel flow left (0..1).\n    pub flow: f32,\n    pub ping_t: f32,\n    /// Instrument motion for the view: last action's recoil.\n    pub recoil: f32,\n    /// A wrong-instrument flash.\n    pub clink: f32,\n    pub hover: u32,\n    pub charge: f32,\n}\n\n// ---------------------------------------------------------------------------------------------\n// Things left on the field\n\n#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize, PartialEq)]\npub struct Stain {\n    pub at: Vec2,\n    pub r: f32,\n    /// 0 blood, 1 scorch, 2 gel.\n    pub kind: u8,\n}\n\n#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize, PartialEq)]\npub struct Thread {\n    pub a: Vec2,\n    pub b: Vec2,\n    pub n: u16,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize, PartialEq)]\npub struct Float {\n    pub at: Vec2,\n    pub text: String,\n    /// Rating (0..3), 4 = plain.\n    pub rating: u8,\n    pub on_beat: bool,\n    pub slot: u8,\n    pub age: f32,\n}\n\n/// An extracted thing flying to the tray.\n#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize, PartialEq)]\npub struct Flight {\n    pub from: Vec2,\n    pub sub: u8,\n    pub kind: Kind,\n    pub t: f32,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize, PartialEq)]\npub struct Callout {\n    pub who: String,\n    pub text: String,\n    pub age: f32,\n}\n\n#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize, PartialEq)]\npub struct Code {\n    /// Seconds to defibrillate.\n    pub left: f32,\n    pub window: f32,\n    /// 0..1 ghost beat position; it crosses the centre at 0.5.\n    pub ghost: f32,\n    /// A scripted stop's shocks still to land (0 = an ordinary Code).\n    pub shocks: u8,\n    pub scripted: bool,\n    pub last_good: f32,\n}\n\n#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize, PartialEq)]\npub struct Gifts {\n    /// Heartbeats of Hush left.\n    pub hush: f32,\n    /// Seconds of Echo left.\n    pub echo: f32,\n    /// Hush and Echo together.\n    pub duet: bool,\n    pub locked: bool,\n    /// The ghost hands: where they are and how far through an action.\n    pub ghost: Vec2,\n    pub ghost_t: f32,\n    pub ripple: f32,\n}\n\n/// Numbers that come from outside an operation.\n#[derive(Clone, Copy, Debug)]\npub struct Rules {\n    pub tune: Tune,\n    pub diff: Difficulty,\n    pub immortal: bool,\n    pub freeze_timer: bool,\n    pub full_gift: bool,\n    pub one_hit: bool,\n    pub tremor: bool,\n    pub bot_skill: f32,\n    /// The tick, for the bots' noise.\n    pub tick: u64,\n    /// The sim's simulated seconds.\n    pub time: f32,\n}\n\n// ---------------------------------------------------------------------------------------------\n// The operation\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Op {\n    pub case: u8,\n    pub phase: u16,\n    pub phase_t: f32,\n    pub phase_beats: u32,\n    pub timer: f32,\n    pub timer_max: f32,\n    pub elapsed: f32,\n    pub vitals: f32,\n    pub heart: Heart,\n    pub hazards: Vec<Hazard>,\n    pub next_id: u32,\n    pub slots: [Slot; 4],\n    pub ring: [Tool; 8],\n    pub plate: u8,\n    pub plate_prev: u8,\n    pub reveal: f32,\n    pub reveal_at: Vec2,\n    pub stains: Vec<Stain>,\n    pub threads: Vec<Thread>,\n    pub floats: Vec<Float>,\n    pub flights: Vec<Flight>,\n    pub callout: Option<Callout>,\n    pub say_done: u32,\n    pub trig_done: u32,\n    pub banner: String,\n    pub banner_t: f32,\n    pub mistakes: u32,\n    pub codes_left: u8,\n    pub code: Option<Code>,\n    pub gifts: Gifts,\n    pub strain: Option<super::strain::Strain>,\n    pub fever: Option<f32>,\n    /// A heat ring's radius while it sweeps; seconds until the next one when counting in.\n    pub heat_ring: Option<f32>,\n    pub ring_warn: f32,\n    pub linger: f32,\n    pub lingering: bool,\n    pub iv_cd: f32,\n    pub rng: Rng,\n    pub won: bool,\n    pub dead: bool,\n    pub shake: f32,\n    pub flash: f32,\n    /// The camera leans in for a moment.\n    pub push: f32,\n    pub crit_called: bool,\n    pub callout_cd: f32,\n    pub time_scale: f32,\n    #[serde(skip)]\n    pub ev: Vec<SimEvent>,\n    pub cov: Vec<u32>,\n    pub checkpoint: Option<Box<Op>>,\n    /// Attract: the bot wins nothing, it only shows.\n    pub showing: bool,\n}\n\npub fn v3(p: Vec2) -> Vec3 {\n    Vec3::new(p.x, 0.3, p.y)\n}\n\nimpl Op {\n    pub fn new(case: usize, rules: &Rules, seed: u64) -> Op {\n        let c = content();\n        let data = &c.cases[case];\n        let mut ring = Tool::DEFAULT_RING;\n        if data.ring.len() == 8 {\n            for (k, t) in data.ring.iter().enumerate() {\n                if let Some(t) = Tool::from_key(t) {\n                    ring[k] = t;\n                }\n            }\n        }\n        let plate = plate_id(&c, &data.plate);\n        let timer = data.timer * rules.tune.timer * rules.diff.timer();\n        let mut slots: [Slot; 4] = Default::default();\n        let (gift0, locked) = match data.gift.as_str() {\n            \"hush\" => (1, data.gift_locked),\n            \"echo\" => (2, data.gift_locked),\n            \"duet\" => (3, false),\n            _ => (0, false),\n        };\n        for (i, s) in slots.iter_mut().enumerate() {\n            s.flow = 1.0;\n            s.aim = Vec2::new(-1.0 + i as f32 * 0.8, 0.5);\n            s.cursor = s.aim;\n            s.gift_kind = if case == super::content::CODE_BLUE { (i % 2 + 1) as u8 } else { gift0 };\n        }\n        slots[0].active = true;\n        let mut op = Op {\n            case: case as u8,\n            phase: 0,\n            phase_t: 0.0,\n            phase_beats: 0,\n            timer,\n            timer_max: timer,\n            elapsed: 0.0,\n            vitals: if data.vitals > 0.0 { data.vitals } else { 100.0 },\n            heart: Heart { phase: 0.0, bpm: 72.0, beats: 0, meter: 4, bar: 0, r_wave: false, stopped: false },\n            hazards: Vec::new(),\n            next_id: 1,\n            slots,\n            ring,\n            plate,\n            plate_prev: plate,\n            reveal: 1.0,\n            reveal_at: Vec2::ZERO,\n            stains: Vec::new(),\n            threads: Vec::new(),\n            floats: Vec::new(),\n            flights: Vec::new(),\n            callout: None,\n            say_done: 0,\n            trig_done: 0,\n            banner: String::new(),\n            banner_t: 0.0,\n            mistakes: 0,\n            codes_left: rules.diff.codes(),\n            code: None,\n            gifts: Gifts { locked, ghost: Vec2::new(0.0, -2.0), ..Default::default() },\n            strain: None,\n            fever: None,\n            heat_ring: None,\n            ring_warn: 0.0,\n            linger: 0.0,\n            lingering: false,\n            iv_cd: 0.0,\n            rng: Rng::new(seed ^ 0x51_72_47),\n            won: false,\n            dead: false,\n            shake: 0.0,\n            flash: 0.0,\n            push: 0.0,\n            crit_called: false,\n            callout_cd: 0.0,\n            time_scale: 1.0,\n            ev: Vec::new(),\n            cov: vec![0; super::cover::NAMES.len()],\n            checkpoint: None,\n            showing: false,\n        };\n        op.enter_phase(0, rules);\n        op\n    }\n\n    pub fn cue(&mut self, id: u16, at: Vec2, gain: f32, pitch: f32) {\n        self.ev.push(SimEvent::Cue { id, pos: v3(at), gain, pitch });\n    }\n\n    pub fn mark(&mut self, name: &str) {\n        super::cover::mark(&mut self.cov, name);\n    }\n\n    pub fn say(&mut self, who: &str, text: &str) {\n        self.callout = Some(Callout { who: who.to_string(), text: text.to_string(), age: 0.0 });\n    }\n\n    /// A callout from the table (`callouts.toml`), not too often.\n    pub fn call(&mut self, key: &str) {\n        if self.callout_cd > 0.0 {\n            return;\n        }\n        let c = content();\n        if let Some(entry) = c.callouts.get(key) {\n            if !entry.text.is_empty() {\n                let k = self.rng.below(entry.text.len() as u32) as usize;\n                let (who, text) = (entry.who.clone(), entry.text[k].clone());\n                // With the scrub nurse on the table, the anaesthesiologist calls it.\n                let who = if self.case == 7 && who == \"bashir\" { \"teddy\".to_string() } else { who };\n                self.say(&who, &text);\n                self.callout_cd = 3.0;\n            }\n        }\n    }\n\n    pub fn set_banner(&mut self, text: &str) {\n        self.banner = text.to_string();\n        self.banner_t = 0.0;\n        self.cue(cue::BANNER, Vec2::ZERO, 1.0, 1.0);\n    }\n\n    // -----------------------------------------------------------------------------------------\n    // Spawning\n\n    pub fn add(&mut self, mut h: Hazard) -> u32 {\n        h.id = self.next_id;\n        self.next_id += 1;\n        let id = h.id;\n        self.mark(&format!(\"hazard:{}\", h.kind.key()));\n        self.hazards.push(h);\n        id\n    }\n\n    pub fn spawn_spec(&mut self, s: &SpawnSpec) {\n        let a = s.a.map(|p| Vec2::new(p[0], p[1])).unwrap_or(Vec2::ZERO);\n        let b = s.b.map(|p| Vec2::new(p[0], p[1])).unwrap_or(a + Vec2::new(2.0, 0.0));\n        let mut h = Hazard {\n            a,\n            b,\n            c: s.c.map(|p| Vec2::new(p[0], p[1])).unwrap_or((a + b) * 0.5),\n            r: s.r.unwrap_or(1.0),\n            ang: s.ang.unwrap_or(0.0).to_radians(),\n            hidden: s.hidden,\n            sub: s.sub,\n            stage: s.stage,\n            blocking: !s.optional,\n            ..Default::default()\n        };\n        match s.kind.as_str() {\n            \"incision\" => {\n                h.kind = Kind::Incision;\n            }\n            \"closure\" => {\n                h.kind = Kind::Closure;\n            }\n            \"lacer\" => {\n                h.kind = Kind::Lacer;\n                h.drain = 0.6;\n                h.need = stitches_for(a.distance(b));\n            }\n            \"bleeder\" => {\n                h.kind = Kind::Bleeder;\n                h.drain = 3.0;\n                h.need = 3;\n                let d = Vec2::from_angle(h.ang) * 0.7;\n                h.b = a + d;\n                h.a = a - d;\n            }\n            \"pool\" => {\n                h.kind = Kind::Pool;\n            }\n            \"object\" => {\n                h.kind = Kind::Object;\n                h.drain = 0.2;\n                h.r = s.r.unwrap_or(0.45);\n            }\n            \"polyp\" => {\n                h.kind = Kind::Polyp;\n                h.drain = 0.1;\n                h.r = s.r.unwrap_or(0.5);\n            }\n            \"tumor\" => {\n                h.kind = Kind::Tumor;\n                h.drain = 0.4;\n                h.r = s.r.unwrap_or(1.3);\n            }\n            \"patch\" => {\n                h.kind = Kind::Patch;\n                h.drain = 0.2;\n            }\n            \"burn\" => {\n                h.kind = Kind::Patch;\n                h.sub = sub::BURN;\n                h.drain = 0.2;\n            }\n            \"bone\" => {\n                h.kind = Kind::Bone;\n                h.r = s.r.unwrap_or(0.9);\n                h.need = 2;\n            }\n            _ => return,\n        }\n        if let Some(d) = s.drain {\n            h.drain = d;\n        }\n        self.add(h);\n    }\n\n    pub fn find(&self, id: u32) -> Option<usize> {\n        self.hazards.iter().position(|h| h.id == id)\n    }\n\n    fn remove(&mut self, id: u32) -> Option<Hazard> {\n        self.find(id).map(|i| self.hazards.remove(i))\n    }\n\n    // -----------------------------------------------------------------------------------------\n    // The phase machine\n\n    pub fn enter_phase(&mut self, k: usize, rules: &Rules) {\n        let c = content();\n        let case = &c.cases[self.case as usize];\n        let Some(p) = case.phase.get(k) else {\n            self.won = true;\n            return;\n        };\n        self.phase = k as u16;\n        self.phase_t = 0.0;\n        self.phase_beats = 0;\n        self.say_done = 0;\n        self.trig_done = 0;\n        self.lingering = false;\n        self.linger = 0.0;\n        if let Some(m) = p.meter {\n            self.heart.meter = m;\n            self.heart.bar = 0;\n        }\n        if let Some(r) = &p.reveal_plate {\n            self.plate_prev = self.plate;\n            self.plate = plate_id(&c, r);\n            self.reveal = 0.0;\n            self.push = 1.0;\n            self.stains.clear();\n            self.threads.clear();\n            self.cue(cue::SQUISH, self.reveal_at, 1.0, 0.7);\n        }\n        if let Some(b) = &p.banner {\n            let b = b.clone();\n            self.set_banner(&b);\n        }\n        if p.checkpoint {\n            let mut copy = self.clone();\n            copy.checkpoint = None;\n            copy.ev = Vec::new();\n            self.checkpoint = Some(Box::new(copy));\n        }\n        for s in &p.spawn {\n            self.spawn_spec(s);\n        }\n        if let Some(name) = &p.strain {\n            self.strain = Some(super::strain::Strain::start(name, &p.params));\n            self.start_strain(rules);\n            self.mark(&format!(\"strain:{name}\"));\n        }\n        if p.code_shocks > 0 {\n            self.start_code(p.code_shocks, rules);\n        }\n        self.mark(&format!(\"phase:{}:{}\", self.case, k.min(15)));\n    }\n\n    /// Restores the last checkpoint (or the case's start, when there is none). Under 2 seconds:\n    /// it is instant.\n    pub fn retry_checkpoint(&mut self, rules: &Rules) -> bool {\n        if let Some(cp) = self.checkpoint.take() {\n            let cov = std::mem::take(&mut self.cov);\n            let mut op = (*cp).clone();\n            op.checkpoint = Some(cp);\n            op.cov = cov;\n            op.dead = false;\n            op.banner.clear();\n            *self = op;\n            let _ = rules;\n            true\n        } else {\n            false\n        }\n    }\n\n    /// The hazards still holding the phase open.\n    pub fn blockers(&self) -> usize {\n        self.hazards.iter().filter(|h| h.blocking).count()\n    }\n\n    fn phase_tick(&mut self, dt: f32, rules: &Rules) {\n        let c = content();\n        let case = &c.cases[self.case as usize];\n        let Some(p) = case.phase.get(self.phase as usize) else { return };\n        self.phase_t += dt;\n        for (k, s) in p.say.iter().enumerate() {\n            if self.say_done & (1 << k) == 0 && self.phase_t >= s.at {\n                self.say_done |= 1 << k;\n                self.say(&s.who, &s.text);\n            }\n        }\n        let mut hold = false;\n        for (k, t) in p.trigger.iter().enumerate() {\n            if self.trig_done & (1 << k) != 0 {\n                continue;\n            }\n            let strain_done = self.strain.is_none();\n            let fire = t.at_time.is_some_and(|x| self.phase_t >= x)\n                || t.vitals_below.is_some_and(|x| self.vitals < x)\n                || t.on_beat.is_some_and(|x| self.phase_beats >= x)\n                || (t.on_clear && self.blockers() == 0 && strain_done && self.code.is_none());\n            if fire {\n                self.trig_done |= 1 << k;\n                for s in &t.spawn {\n                    self.spawn_spec(s);\n                }\n                for s in &t.say {\n                    self.say(&s.who, &s.text);\n                }\n                if let Some(id) = t.cue.as_deref().and_then(cue::id) {\n                    self.cue(id, Vec2::ZERO, 1.0, 1.0);\n                }\n                if let Some(b) = &t.banner {\n                    self.set_banner(b);\n                }\n                if t.on_clear {\n                    hold = true;\n                }\n            }\n        }\n        if hold || self.code.is_some() || self.strain.is_some() || self.blockers() > 0 {\n            return;\n        }\n        // Clear: a moment of drama, then the next phase.\n        if !self.lingering {\n            self.lingering = true;\n            self.linger = p.linger.max(0.35);\n        }\n        self.linger -= dt;\n        if self.linger <= 0.0 {\n            if let Some(h) = self.hazards.iter().rev().find(|h| h.has_path()) {\n                self.reveal_at = h.b;\n            }\n            let next = self.phase as usize + 1;\n            if next >= case.phase.len() {\n                self.won = true;\n            } else {\n                self.enter_phase(next, rules);\n            }\n        }\n    }\n\n    // -----------------------------------------------------------------------------------------\n    // One tick\n\n    pub fn tick(&mut self, inputs: &[SurgeonInput; 4], rules: &Rules, dt: f32) {\n        // The world slows inside a Hush; hands never do.\n        let hushed = self.gifts.hush > 0.0;\n        let scale = if hushed { rules.tune.hush_scale.clamp(0.05, 1.0) } else { 1.0 };\n        self.time_scale = scale;\n        let world = dt * scale;\n        self.elapsed += dt;\n        self.banner_t += dt;\n        self.callout_cd = (self.callout_cd - dt).max(0.0);\n        self.shake = (self.shake - dt * 2.5).max(0.0);\n        self.flash = (self.flash - dt * 3.0).max(0.0);\n        self.push = (self.push - dt * 0.8).max(0.0);\n        self.reveal = (self.reveal + dt / 0.8).min(1.0);\n        self.iv_cd = (self.iv_cd - world).max(0.0);\n        self.gifts.ripple = (self.gifts.ripple - dt * 1.5).max(0.0);\n        if let Some(c) = &mut self.callout {\n            c.age += dt;\n            if c.age > 4.5 {\n                self.callout = None;\n            }\n        }\n        for f in &mut self.floats {\n            f.age += dt;\n        }\n        self.floats.retain(|f| f.age < 1.5);\n        for f in &mut self.flights {\n            f.t += dt * 1.6;\n        }\n        self.flights.retain(|f| f.t < 1.0);\n\n        self.apply_inputs(inputs, rules, dt);\n        self.heart_tick(rules, dt, scale);\n        self.gift_tick(rules, dt);\n\n        if !self.heart.stopped || self.code.is_none() {\n            if !rules.freeze_timer {\n                self.timer -= world;\n            }\n            if self.timer <= 0.0 && !self.showing {\n                if self.is_director_case() {\n                    // Code Blue: the team held on.\n                    self.won = true;\n                    return;\n                }\n                if !rules.immortal {\n                    self.timer = 0.0;\n                    self.dead = true;\n                    self.mark(\"death:time\");\n                    return;\n                }\n                self.timer = self.timer_max;\n            }\n        }\n\n        // Tools run for each surgeon, in seat order.\n        for i in 0..4 {\n            if self.slots[i].active {\n                self.tool_tick(i, rules, dt, world);\n            }\n        }\n        self.ghost_tick(rules, dt);\n        if self.code.is_none() {\n            self.hazards_tick(world, rules);\n            self.strain_tick(world, rules);\n            self.drain_tick(world, rules);\n        }\n        self.code_tick(rules, dt);\n        if self.code.is_none() {\n            self.phase_tick(dt, rules);\n        }\n        self.fx_limits();\n    }\n\n    pub fn is_director_case(&self) -> bool {\n        self.case as usize == super::content::CODE_BLUE\n    }\n\n    fn fx_limits(&mut self) {\n        let n = self.stains.len();\n        if n > 40 {\n            self.stains.drain(..n - 40);\n        }\n        let n = self.threads.len();\n        if n > 24 {\n            self.threads.drain(..n - 24);\n        }\n    }\n\n    fn apply_inputs(&mut self, inputs: &[SurgeonInput; 4], rules: &Rules, dt: f32) {\n        let time = rules.time;\n        for i in 0..4 {\n            let inp = inputs[i];\n            let s = &mut self.slots[i];\n            if !inp.active && !s.bot && i > 0 {\n                s.held = 0;\n                s.pressed = 0;\n                continue;\n            }\n            if inp.active {\n                s.active = true;\n            }\n            s.held = inp.held;\n            s.pressed = inp.pressed | (inp.held & !s.held & 0);\n            s.pressure = if inp.pressure > 0.0 { inp.pressure } else if inp.held & btn::USE != 0 { 1.0 } else { 0.0 };\n            if inp.tool > 0 && inp.tool <= 8 {\n                self.select(i, inp.tool - 1);\n            }\n            if inp.cycle != 0 {\n                let t = (self.slots[i].tool as i32 + inp.cycle as i32).rem_euclid(8) as u8;\n                self.select(i, t);\n            }\n            if inp.abs {\n                self.slots[i].aim = inp.aim;\n            } else if inp.aim != Vec2::ZERO {\n                self.stick_move(i, inp.aim, rules, dt);\n            }\n            let s = &mut self.slots[i];\n            s.aim = s.aim.clamp(Vec2::new(-10.6, -5.6), Vec2::new(10.6, 5.9));\n            // Pet's tremor: a slow wander, gone in Precision and during the Echo.\n            let tremor = s.gift_kind == 2\n                && rules.tremor\n                && s.held & btn::PRECISION == 0\n                && self.gifts.echo <= 0.0\n                && self.is_pet_case();\n            let wander = if tremor {\n                Vec2::new((time * 3.1 + i as f32).sin() + (time * 7.3).sin() * 0.5, (time * 4.3).cos() + (time * 5.9).sin() * 0.5)\n                    * 0.08\n            } else {\n                Vec2::ZERO\n            };\n            s.cursor = s.aim + wander;\n            s.recoil = (s.recoil - dt * 4.0).max(0.0);\n            s.clink = (s.clink - dt * 3.0).max(0.0);\n            s.since_action += dt;\n            if s.chain > 0 {\n                s.chain_t += dt;\n                if s.chain_t > rules.tune.chain_window {\n                    s.chain = 0;\n                }\n            }\n            s.hover = 0;\n        }\n        for i in 0..4 {\n            if self.slots[i].active {\n                let tool = self.tool_of(i);\n                let p = self.slots[i].cursor;\n                self.slots[i].hover = self.target_near(tool, p, 1.0, i).map(|k| self.hazards[k].id).unwrap_or(0);\n            }\n        }\n    }\n\n    pub fn is_pet_case(&self) -> bool {\n        let c = content();\n        c.cases[self.case as usize].surgeon == \"pet\"\n    }\n\n    pub fn select(&mut self, i: usize, ring_pos: u8) {\n        if self.slots[i].tool != ring_pos {\n            self.release(i);\n            self.slots[i].tool = ring_pos;\n            let p = self.slots[i].cursor;\n            self.cue(cue::TOOL_PICK, p, 0.8, 1.0 + ring_pos as f32 * 0.04);\n        }\n    }\n\n    /// Drops what the hand holds.\n    fn release(&mut self, i: usize) {\n        let s = &mut self.slots[i];\n        let id = s.eng_id;\n        s.eng = Eng::None;\n        s.eng_id = 0;\n        s.eng_a = 0.0;\n        s.eng_b = 0.0;\n        if let Some(k) = self.find(id) {\n            let h = &mut self.hazards[k];\n            if h.kind != Kind::Bone && h.kind != Kind::Tendril {\n                h.c = if h.has_path() { h.c } else { Vec2::ZERO };\n            }\n        }\n    }\n\n    /// Stick steering: speed curve, Precision, and aim assist (slowdown and pull near a valid\n    /// target, a rail along a cut, the needle's creep along a wound).\n    fn stick_move(&mut self, i: usize, stick: Vec2, rules: &Rules, dt: f32) {\n        let s = &self.slots[i];\n        let (aim, eng, eng_id, tool, held) = (s.aim, s.eng, s.eng_id, self.tool_of(i), s.held);\n        let mag = stick.length().min(1.0);\n        let dir = stick.normalize_or_zero();\n        let mut speed = 15.0 * mag.powf(2.2) * rules.tune.cursor_speed;\n        if held & btn::PRECISION != 0 {\n            speed *= 0.35;\n        }\n        let assist = rules.tune.aim_assist;\n        let mut pull = Vec2::ZERO;\n        if assist > 0.0 {\n            if let Some(k) = self.target_near(tool, aim, 1.2, i) {\n                let spot = self.hazards[k].spot();\n                let d = spot.distance(aim);\n                let t = 1.0 - (d / 1.2).clamp(0.0, 1.0);\n                speed *= 1.0 - 0.5 * assist * t;\n                pull = (spot - aim).normalize_or_zero() * (3.0 * assist * t) * dt;\n            }\n        }\n        let mut next = aim + dir * speed * dt + pull;\n        if assist > 0.0 {\n            if let Some(h) = self.find(eng_id).map(|k| &self.hazards[k]) {\n                match eng {\n                    Eng::Cut | Eng::Dress => {\n                        // Rail: sideways error is damped.\n                        let (near, _) = nearest_on_path(h, h.prog, 0.3, next);\n                        next += (near - next) * (0.25 * assist);\n                    }\n                    Eng::Stitch => {\n                        // The needle creeps along by itself, so the stick only flicks across it.\n                        let (ax, along, _) = wound_frame(h, next);\n                        let want = h.a.distance(h.b) * h.prog + 0.1;\n                        next += ax * (want - along).clamp(-1.0, 1.0) * (8.0 * assist * dt);\n                    }\n                    _ => {}\n                }\n            }\n        }\n        self.slots[i].aim = next;\n    }\n\n    fn heart_tick(&mut self, rules: &Rules, dt: f32, scale: f32) {\n        let coupling = rules.tune.coupling;\n        let want = 72.0 + (148.0 - 72.0) * (1.0 - self.vitals / 100.0).clamp(0.0, 1.0) * coupling;\n        let h = &mut self.heart;\n        h.bpm += (want.clamp(40.0, 200.0) - h.bpm) * (1.0 - (-dt * 1.5).exp());\n        h.r_wave = false;\n        if h.stopped {\n            return;\n        }\n        // Inside a Hush the heart slows, but less than the world: it is what the player counts.\n        let rate = if scale < 1.0 { 0.5 } else { 1.0 };\n        h.phase += dt * rate / h.period();\n        if h.phase >= 1.0 {\n            h.phase -= 1.0;\n            h.beats += 1;\n            h.r_wave = true;\n            h.bar = (h.bar + 1) % h.meter.max(1);\n            self.phase_beats += 1;\n            let accent = if h.bar == 0 { 1.0 } else { 0.7 };\n            self.cue(cue::LUB, Vec2::ZERO, accent, 1.0);\n            self.cue(cue::MONITOR, Vec2::ZERO, 0.5, if self.heart.bar == 0 { 1.2 } else { 1.0 });\n            if self.gifts.hush > 0.0 {\n                self.gifts.hush -= 1.0 / rules.tune.gift_dur.max(0.1);\n                if self.gifts.hush <= 0.0 {\n                    self.gifts.duet = self.gifts.echo > 0.0;\n                }\n            }\n        }\n    }\n\n    fn drain_tick(&mut self, world: f32, rules: &Rules) {\n        let mut d = 0.0;\n        for h in &self.hazards {\n            d += match h.kind {\n                Kind::Pool => (0.2 + h.drain) * std::f32::consts::PI * h.r * h.r,\n                _ => h.drain,\n            };\n        }\n        if let Some(f) = self.fever {\n            if f > 100.0 {\n                d += 6.0;\n            }\n        }\n        let before = self.vitals;\n        self.vitals -= d * world * rules.tune.drain * rules.diff.drain();\n        if before >= 40.0 && self.vitals < 40.0 {\n            self.call(\"vitals_low\");\n            if !self.crit_called {\n                self.crit_called = true;\n                self.set_banner(\"VITALS CRITICAL\");\n                self.cue(cue::ALARM, Vec2::ZERO, 1.0, 1.0);\n            }\n        }\n        if self.vitals > 55.0 {\n            self.crit_called = false;\n        }\n        if self.vitals <= 0.0 {\n            self.vitals = 0.0;\n            if rules.immortal {\n                self.vitals = 60.0;\n            } else if self.codes_left > 0 {\n                self.codes_left -= 1;\n                self.start_code(0, rules);\n            } else {\n                self.dead = true;\n                self.mark(\"death:vitals\");\n            }\n        }\n    }\n\n    pub fn start_code(&mut self, shocks: u8, rules: &Rules) {\n        let window = rules.tune.code_window;\n        self.code = Some(Code { left: window, window, ghost: 0.0, shocks, scripted: shocks > 0, last_good: 0.0 });\n        self.heart.stopped = true;\n        self.mark(\"code\");\n        if shocks > 0 {\n            self.mark(\"code:scripted\");\n        }\n        self.set_banner(\"CODE\");\n        self.cue(cue::FLATLINE, Vec2::ZERO, 1.0, 1.0);\n        self.shake = 0.6;\n        self.push = 1.0;\n        for s in &mut self.slots {\n            s.eng = Eng::None;\n            s.eng_id = 0;\n        }\n    }\n\n    fn code_tick(&mut self, rules: &Rules, dt: f32) {\n        let Some(mut c) = self.code else { return };\n        c.left -= dt;\n        c.ghost = (c.ghost + dt / 0.9).fract();\n        c.last_good = (c.last_good - dt).max(0.0);\n        let mut landed = false;\n        let mut missed = false;\n        for i in 0..4 {\n            if !self.slots[i].active {\n                continue;\n            }\n            let s = &mut self.slots[i];\n            let holding = s.held & btn::DEFIB != 0;\n            if holding {\n                let before = s.charge;\n                s.charge = (s.charge + dt / 1.2).min(1.0);\n                if before == 0.0 {\n                    self.ev.push(SimEvent::Cue { id: cue::DEFIB_WHINE, pos: Vec3::ZERO, gain: 1.0, pitch: 1.0 });\n                }\n            } else if s.charge > 0.0 {\n                // Let go: on the ghost beat, or nothing.\n                let good = s.charge >= 1.0 && (c.ghost - 0.5).abs() * 0.9 <= 0.2;\n                s.charge = 0.0;\n                if good {\n                    landed = true;\n                } else {\n                    missed = true;\n                }\n            }\n        }\n        if missed {\n            self.cue(cue::CLINK, Vec2::ZERO, 1.0, 0.7);\n        }\n        if landed {\n            self.cue(cue::DEFIB_THUMP, Vec2::ZERO, 1.0, 1.0);\n            self.shake = 1.0;\n            self.flash = 1.0;\n            self.mark(\"tool:defib\");\n            self.award(0, Vec2::ZERO, Tool::Defib, Rating::Clean, rules);\n            if c.shocks > 1 {\n                c.shocks -= 1;\n                c.left = c.window;\n                c.last_good = 1.0;\n                self.code = Some(c);\n                self.say(\"teddy\", \"Again! Charge it again!\");\n                return;\n            }\n            self.code = None;\n            self.heart.stopped = false;\n            self.heart.phase = 0.0;\n            if !c.scripted {\n                self.vitals = 30.0;\n            } else {\n                self.vitals = self.vitals.max(45.0);\n            }\n            self.cue(cue::LUB, Vec2::ZERO, 1.0, 1.0);\n            return;\n        }\n        if c.left <= 0.0 {\n            if rules.immortal {\n                self.code = None;\n                self.heart.stopped = false;\n                self.vitals = 60.0;\n                return;\n            }\n            self.dead = true;\n            self.code = None;\n            self.mark(\"death:code\");\n            return;\n        }\n        self.code = Some(c);\n    }\n\n    // -----------------------------------------------------------------------------------------\n    // Hazard behaviour\n\n    fn hazards_tick(&mut self, world: f32, _rules: &Rules) {\n        let mut feed = 0.0;\n        for h in &mut self.hazards {\n            h.age += world;\n            if h.seen > 0.0 {\n                h.seen -= world;\n            }\n            match h.kind {\n                Kind::Lacer | Kind::Bleeder => feed += h.drain * world,\n                Kind::Patch | Kind::Polyp | Kind::Nodule | Kind::Sac | Kind::Ember | Kind::Furnace => {}\n                _ => {}\n            }\n            // Heat that nobody is holding fades.\n            if h.fill > 0.0 && !matches!(h.kind, Kind::Bone) {\n                h.fill = (h.fill - world * 0.25).max(0.0);\n            }\n        }\n        // Open wounds feed pools.\n        if feed > 0.0 {\n            let wound = self\n                .hazards\n                .iter()\n                .filter(|h| matches!(h.kind, Kind::Lacer | Kind::Bleeder))\n                .map(|h| h.a.lerp(h.b, 0.5))\n                .next();\n            if let Some(at) = wound {\n                let near = self.hazards.iter().position(|h| h.kind == Kind::Pool && h.a.distance(at) < h.r + 1.0);\n                match near {\n                    Some(k) => {\n                        let p = &mut self.hazards[k];\n                        p.r = (p.r + feed * 0.03).min(1.7);\n                    }\n                    None => {\n                        if self.pool_count() < 4 && self.rng.f32() < feed * 0.06 {\n                            let offset = Vec2::new(self.rng.range(-0.5, 0.5), self.rng.range(-0.4, 0.4));\n                            self.add(Hazard { kind: Kind::Pool, a: at + offset, r: 0.42, blocking: false, ..Default::default() });\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    fn pool_count(&self) -> usize {\n        self.hazards.iter().filter(|h| h.kind == Kind::Pool).count()\n    }\n\n    pub fn covered(&self, h: &Hazard) -> bool {\n        h.kind != Kind::Pool\n            && !matches!(h.kind, Kind::Incision | Kind::Closure | Kind::Sac | Kind::Eye)\n            && self.hazards.iter().any(|p| p.kind == Kind::Pool && p.a.distance(h.spot()) < p.r * 0.85)\n    }\n\n    /// Can `tool` act on this hazard now?\n    pub fn valid(&self, h: &Hazard, tool: Tool) -> bool {\n        if !h.visible() || self.covered(h) {\n            return false;\n        }\n        if h.kind == Kind::Sac {\n            return tool == Tool::Laser || tool == Tool::Suction;\n        }\n        h.takes() == Some(tool)\n    }\n\n    /// The nearest hazard `tool` can act on within `reach` of `p`, not held by another surgeon.\n    pub fn target_near(&self, tool: Tool, p: Vec2, reach: f32, me: usize) -> Option<usize> {\n        let mut best: Option<(usize, f32)> = None;\n        for (k, h) in self.hazards.iter().enumerate() {\n            if !self.valid(h, tool) || self.held_by_other(h.id, me) {\n                continue;\n            }\n            let d = self.dist_to(h, tool, p);\n            if d <= reach + hit_slop(h) && best.is_none_or(|(_, b)| d < b) {\n                best = Some((k, d));\n            }\n        }\n        best.map(|(k, _)| k)\n    }\n\n    pub fn held_by_other(&self, id: u32, me: usize) -> bool {\n        self.slots.iter().enumerate().any(|(i, s)| i != me && s.active && s.eng_id == id && s.eng != Eng::None)\n    }\n\n    pub fn dist_to(&self, h: &Hazard, tool: Tool, p: Vec2) -> f32 {\n        match h.kind {\n            Kind::Lacer | Kind::Bleeder => dist_segment(p, h.a, h.b),\n            Kind::Sac if tool == Tool::Suction => (p.distance(h.a) - h.r).max(0.0),\n            Kind::Bone if h.stage == 1 => p.distance(h.b),\n            Kind::Pool | Kind::Patch => (p.distance(h.a) - h.r).max(0.0),\n            _ if h.has_path() => p.distance(h.spot()),\n            _ => p.distance(h.spot()),\n        }\n    }\n\n    pub fn tool_of(&self, i: usize) -> Tool {\n        if self.code.is_some() {\n            return Tool::Defib;\n        }\n        // The closing dressing comes to hand by itself when it is all that's left.\n        if self.hazards.iter().any(|h| h.kind == Kind::Closure)\n            && !self.hazards.iter().any(|h| h.kind != Kind::Closure && h.blocking)\n        {\n            return Tool::Dressing;\n        }\n        self.ring[(self.slots[i].tool as usize).min(7)]\n    }\n\n    // -----------------------------------------------------------------------------------------\n    // Instruments\n\n    fn wrong_tool(&mut self, i: usize, rules: &Rules) {\n        let s = &mut self.slots[i];\n        if s.clink > 0.2 {\n            return;\n        }\n        s.chain = 0;\n        s.clink = 1.0;\n        let p = s.cursor;\n        self.cue(cue::CLINK, p, 1.0, 1.0);\n        self.call(\"wrong_tool\");\n        self.vitals -= rules.tune.wrong_penalty;\n        self.mark(\"wrong_tool\");\n    }\n\n    /// A slip: a small laceration here.\n    fn lacerate(&mut self, at: Vec2, ang: f32, rules: &Rules) {\n        let d = Vec2::from_angle(ang) * 0.6;\n        let h = Hazard {\n            kind: Kind::Lacer,\n            a: at - d,\n            b: at + d,\n            drain: 0.6,\n            need: 3,\n            blocking: false,\n            ..Default::default()\n        };\n        self.add(h);\n        self.mistakes += 1;\n        self.vitals -= 2.0 * rules.diff.drain();\n        self.shake = self.shake.max(0.3);\n        self.cue(cue::TEAR, at, 1.0, 1.0);\n        self.mark(\"mistake:lacerate\");\n    }\n\n    fn burn_at(&mut self, at: Vec2) {\n        let h = Hazard { kind: Kind::Patch, sub: sub::BURN, a: at, r: 0.7, drain: 0.25, blocking: false, ..Default::default() };\n        self.add(h);\n        self.mistakes += 1;\n        self.cue(cue::SIZZLE, at, 1.0, 0.8);\n        self.mark(\"mistake:burn\");\n    }\n\n    fn tool_tick(&mut self, i: usize, rules: &Rules, dt: f32, world: f32) {\n        if self.code.is_some() {\n            return;\n        }\n        let tool = self.tool_of(i);\n        let s = &self.slots[i];\n        let held = s.held & btn::USE != 0;\n        let pressed = s.pressed & btn::USE != 0 || (held && s.eng == Eng::None && tool_is_continuous(tool));\n        let p = s.cursor;\n        let cancel = s.held & btn::CANCEL != 0;\n        if cancel {\n            self.release(i);\n            return;\n        }\n        // The gel's flow refills whenever the trigger is up.\n        if tool != Tool::Gel || !held {\n            let s = &mut self.slots[i];\n            s.flow = (s.flow + dt / 2.0).min(1.0);\n        }\n        // Heat rings scorch a hand that stays down.\n        if held {\n            if let Some(radius) = self.heat_ring {\n                let d = p.length();\n                if (d - radius).abs() < 0.55 {\n                    self.scorch(i, rules);\n                    return;\n                }\n            }\n        }\n        self.slots[i].eng_t += dt;\n        match tool {\n            Tool::Scalpel | Tool::Dressing => self.cut_tick(i, tool, held, pressed, rules),\n            Tool::Forceps => self.forceps_tick(i, held, pressed, rules, dt),\n            Tool::Suture => self.suture_tick(i, held, pressed, rules),\n            Tool::Suction => self.suction_tick(i, held, rules, world.max(dt * 0.6)),\n            Tool::Laser | Tool::Cryo => self.heat_tick(i, tool, held, rules, dt),\n            Tool::Gel => self.gel_tick(i, held, rules, dt),\n            Tool::Scanner => self.scanner_tick(i, held, dt),\n            Tool::Iv => self.iv_tick(i, held, rules, dt),\n            Tool::Defib => {}\n        }\n    }\n\n    fn scorch(&mut self, i: usize, rules: &Rules) {\n        let p = self.slots[i].cursor;\n        if self.slots[i].clink > 0.0 {\n            return;\n        }\n        self.release(i);\n        let s = &mut self.slots[i];\n        s.chain = 0;\n        s.clink = 1.0;\n        self.vitals -= 2.0 * rules.diff.drain();\n        self.burn_at(p);\n        self.call(\"lift_off\");\n        self.mark(\"scorch\");\n    }\n\n    fn cut_tick(&mut self, i: usize, tool: Tool, held: bool, pressed: bool, rules: &Rules) {\n        let s = &self.slots[i];\n        let (p, eng, eng_id) = (s.cursor, s.eng, s.eng_id);\n        let want = if tool == Tool::Dressing { Eng::Dress } else { Eng::Cut };\n        if eng == want {\n            let Some(k) = self.find(eng_id) else {\n                self.release(i);\n                return;\n            };\n            if !held {\n                // Let go mid-stroke: the cut stays, the rating suffers.\n                self.hazards[k].fill += 1.0;\n                self.release(i);\n                return;\n            }\n            let h = &self.hazards[k];\n            let (near, t) = nearest_on_path(h, h.prog, 0.28, p);\n            let d = near.distance(p);\n            if d > 1.15 && tool == Tool::Scalpel {\n                let ang = (p - near).to_angle();\n                self.release(i);\n                self.call(\"healthy\");\n                self.lacerate(p, ang, rules);\n                return;\n            }\n            let adv = (t - h.prog).max(0.0);\n            let s = &mut self.slots[i];\n            if adv > 0.0 {\n                s.eng_a += d * adv;\n                s.eng_b += adv;\n            }\n            let h = &mut self.hazards[k];\n            h.prog = h.prog.max(t);\n            if adv > 0.002 && self.slots[i].eng_t > 0.12 {\n                self.slots[i].eng_t = 0.0;\n                let tool_cue = if tool == Tool::Scalpel { cue::SLICE } else { cue::GEL };\n                self.cue(tool_cue, near, 0.6, 1.0);\n            }\n            let h = &self.hazards[k];\n            if h.prog >= 0.975 {\n                let breaks = h.fill.floor();\n                let s = &self.slots[i];\n                let mean = s.eng_a / s.eng_b.max(0.2);\n                let rating = Rating::grade(mean + breaks * 0.18, rules.tune.strictness, 0.25, 0.42, 0.7);\n                let at = h.b;\n                let id = h.id;\n                self.release(i);\n                self.complete(i, id, tool, rating, at, rules);\n            }\n            return;\n        }\n        if !pressed {\n            return;\n        }\n        if let Some(k) = self.target_near(tool, p, 0.75, i) {\n            let id = self.hazards[k].id;\n            match (self.hazards[k].kind, self.hazards[k].stage) {\n                // A brittle ember takes one stroke through it.\n                (Kind::Ember, _) | (Kind::Furnace, _) => {\n                    let at = self.hazards[k].a;\n                    self.cue(cue::CRACK, at, 1.0, 1.0);\n                    let rating = if self.hazards[k].fill > 0.0 { Rating::Clean } else { Rating::Immaculate };\n                    self.complete(i, id, tool, rating, at, rules);\n                }\n                _ => {\n                    let s = &mut self.slots[i];\n                    s.eng = want;\n                    s.eng_id = id;\n                    s.eng_a = 0.0;\n                    s.eng_b = 0.0;\n                    s.eng_t = 0.0;\n                    self.mark(&format!(\"tool:{}\", tool.key()));\n                }\n            }\n        } else if tool == Tool::Scalpel {\n            if self.wrong_tool_here(i, tool, p, rules) {\n                return;\n            }\n            // Cutting what was never meant to be cut.\n            self.slots[i].eng_start = p;\n            self.call(\"healthy\");\n            self.lacerate(p, 0.7, rules);\n        }\n    }\n\n    /// A press on a hazard this instrument can't touch: true when it was one.\n    fn wrong_tool_here(&mut self, i: usize, tool: Tool, p: Vec2, rules: &Rules) -> bool {\n        let hit = self.hazards.iter().any(|h| {\n            h.visible()\n                && h.takes().is_some()\n                && h.takes() != Some(tool)\n                && !matches!(h.kind, Kind::Pool)\n                && self.dist_to(h, tool, p) < 0.6\n        });\n        if hit {\n            self.wrong_tool(i, rules);\n        }\n        hit\n    }\n\n    fn forceps_tick(&mut self, i: usize, held: bool, pressed: bool, rules: &Rules, dt: f32) {\n        let s = &self.slots[i];\n        let (p, eng, eng_id, start) = (s.cursor, s.eng, s.eng_id, s.eng_start);\n        if eng == Eng::Pull {\n            let Some(k) = self.find(eng_id) else {\n                self.release(i);\n                return;\n            };\n            if !held {\n                self.hazards[k].prog = 0.0;\n                self.release(i);\n                return;\n            }\n            let h = &self.hazards[k];\n            if h.kind == Kind::Tendril {\n                self.tendril_pull(i, k, rules, dt);\n                return;\n            }\n            let disp = p - start;\n            let axis = Vec2::from_angle(h.ang);\n            let along = disp.dot(axis);\n            let m = disp.length();\n            let err = if m > 0.05 { axis.angle_to(disp).abs().to_degrees() } else { 0.0 };\n            let need = 1.0;\n            let at = h.a;\n            let id = h.id;\n            let hazard = &mut self.hazards[k];\n            hazard.c = disp;\n            hazard.prog = (along / need).clamp(0.0, 1.0);\n            if m > 0.55 && err > 60.0 {\n                // Yanked off the axis: it tears.\n                self.hazards[k].c = Vec2::ZERO;\n                self.hazards[k].prog = 0.0;\n                self.release(i);\n                self.call(\"off_axis\");\n                self.lacerate(at, axis.to_angle(), rules);\n                return;\n            }\n            if along >= need {\n                let rating = Rating::grade(err, rules.tune.strictness, 12.0, 24.0, 40.0);\n                self.release(i);\n                self.cue(cue::PULL_POP, at, 1.0, 1.0);\n                self.complete(i, id, Tool::Forceps, rating, at, rules);\n            }\n            return;\n        }\n        if eng == Eng::Bone {\n            let Some(k) = self.find(eng_id) else {\n                self.release(i);\n                return;\n            };\n            let s = &self.slots[i];\n            let (rot_l, rot_r) = (s.held & btn::ROT_L != 0, s.held & btn::ROT_R != 0);\n            let spin = (rot_r as i32 - rot_l as i32) as f32;\n            let h = &mut self.hazards[k];\n            h.a = p;\n            h.ang += spin * 2.2 * dt;\n            let err = angle_diff(h.ang, 0.0).abs().to_degrees();\n            let d = h.a.distance(h.b);\n            if d < 0.35 && err < 12.0 {\n                h.a = h.b;\n                h.ang = 0.0;\n                let id = h.id;\n                let at = h.b;\n                let t = self.slots[i].eng_a;\n                let rating = Rating::grade(t, rules.tune.strictness, 3.0, 6.0, 12.0);\n                self.release(i);\n                self.cue(cue::SNAP, at, 1.0, 1.0);\n                self.complete(i, id, Tool::Forceps, rating, at, rules);\n                return;\n            }\n            self.slots[i].eng_a += dt;\n            if !held {\n                self.release(i);\n            }\n            return;\n        }\n        if !pressed {\n            return;\n        }\n        if let Some(k) = self.target_near(Tool::Forceps, p, 0.7, i) {\n            let id = self.hazards[k].id;\n            let kind = self.hazards[k].kind;\n            let s = &mut self.slots[i];\n            s.eng = if kind == Kind::Bone { Eng::Bone } else { Eng::Pull };\n            s.eng_id = id;\n            s.eng_start = p;\n            s.eng_a = 0.0;\n            s.eng_t = 0.0;\n            self.mark(\"tool:forceps\");\n            self.cue(cue::FORCEPS, p, 1.0, 1.0);\n        } else {\n            self.wrong_tool_here(i, Tool::Forceps, p, rules);\n        }\n    }\n\n    fn tendril_pull(&mut self, i: usize, k: usize, rules: &Rules, dt: f32) {\n        let s = &self.slots[i];\n        let p = s.cursor;\n        let moved = p - s.eng_start;\n        let h = &self.hazards[k];\n        let axis = Vec2::from_angle(h.ang);\n        let along = moved.dot(axis);\n        self.slots[i].eng_start = p;\n        let (at, id) = (h.a, h.id);\n        if along > 0.001 {\n            if self.heart.systole() {\n                // Pulling against the squeeze: it snaps back.\n                let h = &mut self.hazards[k];\n                h.prog = (h.prog - 0.12).max(0.0);\n                h.fill += 1.0;\n                self.slots[i].chain = 0;\n                self.cue(cue::TEAR, at, 0.7, 1.2);\n                self.vitals -= 1.0 * rules.diff.drain();\n                self.call(\"tendril_systole\");\n                self.release(i);\n                return;\n            }\n            let h = &mut self.hazards[k];\n            h.prog = (h.prog + along * 0.085 * rules.tune.tool_power / rules.tune.strain_tough.max(0.2)).min(1.0);\n            h.c = axis * h.prog * 1.6;\n        }\n        let _ = dt;\n        if self.hazards[k].prog >= 1.0 {\n            let breaks = self.hazards[k].fill;\n            let rating = Rating::grade(breaks, rules.tune.strictness, 0.5, 2.0, 4.0);\n            self.release(i);\n            self.cue(cue::PULL_POP, at, 1.0, 0.7);\n            self.complete(i, id, Tool::Forceps, rating, at, rules);\n        }\n    }\n\n    fn suture_tick(&mut self, i: usize, held: bool, pressed: bool, rules: &Rules) {\n        let s = &self.slots[i];\n        let (p, eng, eng_id) = (s.cursor, s.eng, s.eng_id);\n        if eng == Eng::Stitch {\n            let Some(k) = self.find(eng_id) else {\n                self.release(i);\n                return;\n            };\n            if !held {\n                self.release(i);\n                return;\n            }\n            let h = &self.hazards[k];\n            let (_, along, perp) = wound_frame(h, p);\n            let side = if perp > 0.07 {\n                1\n            } else if perp < -0.07 {\n                -1\n            } else {\n                0\n            };\n            let last = self.slots[i].side;\n            if side != 0 {\n                self.slots[i].side = side;\n            }\n            if side != 0 && last != 0 && side != last {\n                // A crossing: near the needle it is a stitch.\n                let len = h.a.distance(h.b).max(0.1);\n                let need = h.need.max(1) as f32;\n                let needle = len * (h.n as f32 + 0.5) / need;\n                let off = (along - needle).abs();\n                if off < 1.2 {\n                    let at = h.a.lerp(h.b, (h.n as f32 + 0.5) / need);\n                    let h = &mut self.hazards[k];\n                    h.n += 1;\n                    h.prog = (h.n as f32 / need).min(1.0);\n                    let done = h.n >= h.need;\n                    let id = h.id;\n                    let s = &mut self.slots[i];\n                    s.eng_a += off;\n                    s.eng_b += 1.0;\n                    s.eng_t = 0.0;\n                    self.cue(cue::SUTURE, at, 0.8, 0.9 + (self.hazards[k].n as f32) * 0.03);\n                    if done {\n                        let s = &self.slots[i];\n                        let mean = s.eng_a / s.eng_b.max(1.0);\n                        let rating = Rating::grade(mean, rules.tune.strictness, 0.32, 0.55, 0.85);\n                        self.release(i);\n                        self.complete(i, id, Tool::Suture, rating, at, rules);\n                    }\n                }\n            }\n            return;\n        }\n        if !pressed {\n            return;\n        }\n        if let Some(k) = self.target_near(Tool::Suture, p, 0.85, i) {\n            let id = self.hazards[k].id;\n            let (_, _, perp) = wound_frame(&self.hazards[k], p);\n            let s = &mut self.slots[i];\n            s.eng = Eng::Stitch;\n            s.eng_id = id;\n            s.side = if perp >= 0.0 { 1 } else { -1 };\n            s.eng_a = 0.0;\n            s.eng_b = 0.0;\n            s.eng_t = 0.0;\n            self.mark(\"tool:suture\");\n        } else {\n            self.wrong_tool_here(i, Tool::Suture, p, rules);\n        }\n    }\n\n    fn suction_tick(&mut self, i: usize, held: bool, rules: &Rules, dt: f32) {\n        if !held {\n            self.slots[i].eng = Eng::None;\n            self.slots[i].eng_id = 0;\n            return;\n        }\n        let s = &self.slots[i];\n        let (p, pressure) = (s.cursor, s.pressure.clamp(0.2, 1.0));\n        let Some(k) = self.target_near(Tool::Suction, p, 0.4, i) else {\n            self.slots[i].eng = Eng::None;\n            self.slots[i].eng_id = 0;\n            return;\n        };\n        let power = rules.tune.tool_power * pressure;\n        let id = self.hazards[k].id;\n        self.slots[i].eng = Eng::Suck;\n        self.slots[i].eng_id = id;\n        self.mark(\"tool:suction\");\n        if self.slots[i].eng_t > 0.18 {\n            self.slots[i].eng_t = 0.0;\n            self.cue(cue::GURGLE, p, 0.35 + pressure * 0.6, 0.8 + self.rng.f32() * 0.4);\n        }\n        let h = &mut self.hazards[k];\n        let at = h.a;\n        if h.kind == Kind::Sac {\n            // Draining a sac whole: slow, and it never rates better than Good.\n            h.fill = (h.fill + dt / 2.4 * power).min(1.0);\n            h.r = (0.8 * (1.0 - h.fill) + 0.1) * (0.5 + 0.5 * h.prog);\n            if h.fill >= 1.0 {\n                self.release(i);\n                self.complete(i, id, Tool::Suction, Rating::Good, at, rules);\n            }\n        } else if matches!(h.kind, Kind::Furnace) {\n            h.fill = (h.fill + dt / 1.0 * power).min(1.0);\n            if h.fill >= 1.0 {\n                h.fill = 0.0;\n                self.release(i);\n                self.complete(i, id, Tool::Suction, Rating::Good, at, rules);\n            }\n        } else {\n            h.r -= dt * 1.1 * power;\n            if h.r <= 0.14 {\n                let r = 0.5;\n                self.stains.push(Stain { at, r, kind: 0 });\n                self.release(i);\n                self.complete(i, id, Tool::Suction, Rating::Good, at, rules);\n            }\n        }\n    }\n\n    fn heat_tick(&mut self, i: usize, tool: Tool, held: bool, rules: &Rules, dt: f32) {\n        let s = &self.slots[i];\n        let (p, eng, eng_id) = (s.cursor, s.eng, s.eng_id);\n        let engaged = eng == Eng::Heat;\n        if engaged && !held {\n            // The release decides everything.\n            let k = self.find(eng_id);\n            self.release(i);\n            if let Some(k) = k {\n                let h = &self.hazards[k];\n                let (fill, at, id) = (h.fill, h.spot(), h.id);\n                if fill >= 0.8 {\n                    let off = if fill <= 1.0 { 1.0 - fill } else { fill - 1.0 + 0.05 };\n                    let rating = Rating::grade(off, rules.tune.strictness, 0.07, 0.13, 0.22);\n                    self.hazards[k].fill = 0.0;\n                    self.complete(i, id, tool, rating, at, rules);\n                }\n            }\n            return;\n        }\n        if !held {\n            return;\n        }\n        let target = self.target_near(tool, p, 0.55, i);\n        match target {\n            Some(k) => {\n                let id = self.hazards[k].id;\n                if eng_id != id {\n                    let s = &mut self.slots[i];\n                    s.eng = Eng::Heat;\n                    s.eng_id = id;\n                    self.mark(&format!(\"tool:{}\", tool.key()));\n                }\n                let time = {\n                    let h = &self.hazards[k];\n                    let base = if h.fill_time > 0.0 {\n                        h.fill_time\n                    } else if tool == Tool::Cryo {\n                        1.0\n                    } else {\n                        1.2\n                    };\n                    let tough = if matches!(h.kind, Kind::Nodule | Kind::Sac | Kind::Ember | Kind::Furnace) {\n                        rules.tune.strain_tough\n                    } else {\n                        1.0\n                    };\n                    base * tough / rules.tune.tool_power.max(0.1)\n                };\n                let h = &mut self.hazards[k];\n                h.fill += dt / time.max(0.05) + dt * 0.25;\n                let (fill, at) = (h.fill, h.spot());\n                if self.slots[i].eng_t > 0.2 {\n                    self.slots[i].eng_t = 0.0;\n                    let id = if tool == Tool::Laser { cue::LASER } else { cue::FROST };\n                    self.cue(id, at, 0.5, 0.7 + fill * 0.6);\n                }\n                if fill > 1.28 {\n                    self.hazards[k].fill = 0.0;\n                    self.release(i);\n                    if tool == Tool::Laser {\n                        self.call(\"overheat\");\n                    } else {\n                        self.call(\"frostbite\");\n                    }\n                    self.burn_at(at);\n                    self.slots[i].chain = 0;\n                }\n            }\n            None => {\n                let s = &mut self.slots[i];\n                s.eng = Eng::None;\n                s.eng_id = 0;\n                // Holding a beam on healthy tissue: it burns, eventually.\n                s.eng_a += dt;\n                if s.eng_a > 1.6 {\n                    s.eng_a = 0.0;\n                    if !self.wrong_tool_here(i, tool, p, rules) {\n                        self.burn_at(p);\n                    }\n                }\n            }\n        }\n    }\n\n    fn gel_tick(&mut self, i: usize, held: bool, rules: &Rules, dt: f32) {\n        if !held {\n            self.slots[i].eng = Eng::None;\n            self.slots[i].eng_id = 0;\n            return;\n        }\n        let s = &mut self.slots[i];\n        let p = s.cursor;\n        s.flow -= dt / 2.4;\n        if s.flow <= 0.0 {\n            s.flow = 0.0;\n            return;\n        }\n        if s.eng_t > 0.16 {\n            s.eng_t = 0.0;\n            self.cue(cue::GEL, p, 0.5, 1.0 + self.rng.f32() * 0.2);\n        }\n        let Some(k) = self.target_near(Tool::Gel, p, 0.2, i) else {\n            self.slots[i].eng_b += dt;\n            return;\n        };\n        let id = self.hazards[k].id;\n        let s = &mut self.slots[i];\n        if s.eng_id != id {\n            s.eng = Eng::Paint;\n            s.eng_id = id;\n            self.mark(\"tool:gel\");\n        }\n        let h = &mut self.hazards[k];\n        let area = (h.r * h.r).max(0.5);\n        h.prog += dt * 1.25 * rules.tune.tool_power / area;\n        let at = h.a;\n        if h.prog >= 1.0 {\n            h.prog = 0.0;\n            let over = self.slots[i].eng_b;\n            let rating = Rating::grade(over, rules.tune.strictness, 0.25, 0.6, 1.1);\n            self.slots[i].eng_b = 0.0;\n            self.slots[i].eng_id = 0;\n            self.stains.push(Stain { at, r: 0.6, kind: 2 });\n            self.complete(i, id, Tool::Gel, rating, at, rules);\n        }\n    }\n\n    fn scanner_tick(&mut self, i: usize, held: bool, dt: f32) {\n        if !held {\n            self.slots[i].eng = Eng::None;\n            return;\n        }\n        let s = &mut self.slots[i];\n        s.eng = Eng::Scan;\n        s.ping_t -= dt;\n        let p = s.cursor;\n        if s.ping_t <= 0.0 {\n            s.ping_t = 0.45;\n            self.mark(\"tool:scanner\");\n            self.cue(cue::SONAR, p, 0.7, 1.0);\n        }\n        let mut found = Vec::new();\n        for h in &mut self.hazards {\n            if h.hidden && h.a.distance(p) < 2.2 {\n                if h.seen <= 0.0 {\n                    found.push(h.a);\n                }\n                h.seen = 8.0;\n            }\n        }\n        for at in found {\n            self.cue(cue::SONAR, at, 1.0, 1.5);\n            let floats = Float { at, text: \"FOUND\".into(), rating: 4, on_beat: false, slot: i as u8, age: 0.0 };\n            self.floats.push(floats);\n        }\n    }\n\n    fn iv_tick(&mut self, i: usize, held: bool, rules: &Rules, dt: f32) {\n        let s = &self.slots[i];\n        let (engaged, dose) = (s.eng == Eng::Iv, s.eng_a);\n        if engaged && !held {\n            self.release(i);\n            self.iv_cd = 4.0;\n            if dose >= 0.25 {\n                let off = if dose <= 1.0 { 1.0 - dose } else { dose - 1.0 + 0.04 };\n                let rating = Rating::grade(off, rules.tune.strictness, 0.08, 0.18, 0.5);\n                let at = iv_port();\n                self.award(i, at, Tool::Iv, rating, rules);\n            }\n            return;\n        }\n        if !held {\n            return;\n        }\n        if !engaged {\n            if self.iv_cd > 0.0 {\n                return;\n            }\n            let s = &mut self.slots[i];\n            s.eng = Eng::Iv;\n            s.eng_a = 0.0;\n            s.eng_id = 0;\n            self.mark(\"tool:iv\");\n            self.cue(cue::IV, iv_port(), 1.0, 1.0);\n        }\n        let step = dt / 1.2;\n        let s = &mut self.slots[i];\n        s.eng_a += step;\n        let dose = s.eng_a;\n        if dose <= 1.0 {\n            self.vitals = (self.vitals + 18.0 * rules.tune.iv_heal * step).min(100.0);\n        }\n        if dose > 1.3 {\n            // Overdose: a spike, then the fall.\n            self.release(i);\n            self.iv_cd = 4.0;\n            self.vitals = (self.vitals - 8.0).max(1.0);\n            self.mistakes += 1;\n            self.shake = self.shake.max(0.4);\n            self.call(\"overdose\");\n            self.cue(cue::ALARM, iv_port(), 0.7, 1.3);\n            self.mark(\"mistake:overdose\");\n        }\n    }\n\n    // -----------------------------------------------------------------------------------------\n    // Finishing things\n\n    /// Scores a rated action: chain, on-beat, gift charge, the big text.\n    pub fn award(&mut self, i: usize, at: Vec2, tool: Tool, rating: Rating, rules: &Rules) {\n        let beat_window = rules.tune.beat_ms / 1000.0;\n        let on_beat = !self.heart.stopped && self.heart.from_r() <= beat_window;\n        let chain_up = rating as u8 >= Rating::Clean as u8;\n        let s = &mut self.slots[i];\n        s.tally[rating as usize] += 1;\n        s.since_action = 0.0;\n        s.recoil = 1.0;\n        if chain_up {\n            s.chain += 1;\n            s.chain_t = 0.0;\n            s.best_chain = s.best_chain.max(s.chain);\n        } else if rating == Rating::Sloppy {\n            s.chain = 0;\n        }\n        let mult = match s.chain {\n            0..=4 => 1.0,\n            5..=9 => 1.25,\n            10..=19 => 1.5,\n            _ => 2.0,\n        };\n        let beat = if on_beat { 1.25 } else { 1.0 };\n        let pts = rating.points() as f32 * mult * beat * rules.tune.score;\n        s.score += pts as i64;\n        if on_beat {\n            s.on_beats += 1;\n        }\n        let charge = match rating {\n            Rating::Immaculate => 8.0,\n            Rating::Clean => 4.0,\n            Rating::Good => 1.0,\n            Rating::Sloppy => 0.0,\n        } + if on_beat { 2.0 } else { 0.0 };\n        let shared = self.slots[0].gift_kind == 3;\n        let meter = if shared { 0 } else { i };\n        if !self.gifts.locked {\n            let m = &mut self.slots[meter];\n            m.gift = (m.gift + charge * rules.tune.gift_gain).min(100.0);\n        }\n        // Inside a Hush each on-beat action adds a heartbeat.\n        if on_beat && self.gifts.hush > 0.0 {\n            self.gifts.hush += 1.0;\n        }\n        let chain = self.slots[i].chain;\n        let cue_id = [cue::RATE_SLOPPY, cue::RATE_GOOD, cue::RATE_CLEAN, cue::RATE_IMMACULATE][rating as usize];\n        self.cue(cue_id, at, 1.0, 1.0);\n        if on_beat {\n            self.cue(cue::ON_BEAT, at, 1.0, 1.0);\n            self.mark(\"on_beat\");\n        }\n        if chain_up && matches!(chain, 5 | 10 | 20) {\n            self.cue(cue::CHAIN_UP, at, 1.0, 1.0);\n            self.mark(\"chain\");\n        }\n        self.mark(&format!(\"rating:{}\", rating.name().to_lowercase()));\n        self.mark(&format!(\"rated:{}\", tool.key()));\n        self.floats.push(Float { at, text: rating.name().into(), rating: rating as u8, on_beat, slot: i as u8, age: 0.0 });\n        if self.floats.len() > 8 {\n            self.floats.remove(0);\n        }\n        // The Echo copies each action onto the next target.\n        if self.gifts.echo > 0.0 && i != 3 && tool != Tool::Iv && tool != Tool::Defib {\n            self.echo_action(tool, rating, rules);\n        }\n    }\n\n    /// Finishes a stage of a hazard with a rating: points and what it does to the hazard.\n    pub fn complete(&mut self, i: usize, id: u32, tool: Tool, rating: Rating, at: Vec2, rules: &Rules) {\n        self.award(i, at, tool, rating, rules);\n        self.apply_done(id, rating, rules);\n    }\n\n    /// The effect of a finished action on its hazard. The Echo and dev tools use it too.\n    pub fn apply_done(&mut self, id: u32, rating: Rating, rules: &Rules) {\n        let Some(k) = self.find(id) else { return };\n        let (kind, stage, a) = {\n            let h = &self.hazards[k];\n            (h.kind, h.stage, h.a)\n        };\n        self.mark(&format!(\"done:{}\", kind.key()));\n        match kind {\n            Kind::Incision | Kind::Closure => {\n                let h = self.remove(id).unwrap();\n                self.reveal_at = h.b;\n                if h.sub == sub::TETHER || h.sub == sub::STROKE {\n                    self.strain_stroke_done(rules);\n                }\n            }\n            Kind::Lacer | Kind::Bleeder => {\n                let h = self.remove(id).unwrap();\n                self.threads.push(Thread { a: h.a, b: h.b, n: h.need });\n                if rating == Rating::Sloppy {\n                    // Sloppy spacing leaves a slow bleed.\n                    self.add(Hazard { kind: Kind::Pool, a: h.a.lerp(h.b, 0.5), r: 0.5, blocking: false, ..Default::default() });\n                }\n            }\n            Kind::Pool => {\n                self.remove(id);\n            }\n            Kind::Object => {\n                let h = self.remove(id).unwrap();\n                self.flights.push(Flight { from: a, sub: h.sub, kind, t: 0.0 });\n                if h.sub == sub::COAL {\n                    if let Some(f) = &mut self.fever {\n                        *f = (*f - 8.0).max(0.0);\n                    }\n                }\n            }\n            Kind::Polyp => {\n                self.remove(id);\n                self.stains.push(Stain { at: a, r: 0.45, kind: 1 });\n                self.cue(cue::SIZZLE, a, 1.0, 1.0);\n            }\n            Kind::Tumor => {\n                if stage >= 2 {\n                    self.remove(id);\n                } else {\n                    let h = &mut self.hazards[k];\n                    h.stage += 1;\n                    h.prog = 0.0;\n                    h.c = Vec2::ZERO;\n                    if stage == 1 {\n                        self.flights.push(Flight { from: a, sub: 4, kind, t: 0.0 });\n                        self.hazards[k].drain = 0.3;\n                    }\n                }\n            }\n            Kind::Patch => {\n                self.remove(id);\n            }\n            Kind::Bone => {\n                if stage >= 1 {\n                    let h = self.remove(id).unwrap();\n                    self.stains.push(Stain { at: h.b, r: 0.4, kind: 2 });\n                } else {\n                    let h = &mut self.hazards[k];\n                    h.stage = 1;\n                    h.n = 0;\n                    h.prog = 0.0;\n                    // The wire crosses the seat of the fragment.\n                    let d = Vec2::new(0.9, 0.0);\n                    let at = h.b;\n                    h.c = at;\n                    h.a = at;\n                    let _ = d;\n                }\n            }\n            Kind::Nodule | Kind::Sac | Kind::Eye | Kind::Ember | Kind::Furnace | Kind::Tendril => {\n                self.strain_done(id, kind, stage, rating, rules);\n            }\n        }\n    }\n\n    /// A rating as the bot or dev sees it: nothing left to do with this hazard now.\n    pub fn resolve_now(&mut self, id: u32, rules: &Rules) {\n        self.apply_done(id, Rating::Clean, rules);\n    }\n\n    fn gift_tick(&mut self, rules: &Rules, dt: f32) {\n        if rules.full_gift && !self.gifts.locked {\n            for s in &mut self.slots {\n                s.gift = 100.0;\n            }\n        }\n        self.gifts.echo = (self.gifts.echo - dt).max(0.0);\n        if self.gifts.hush <= 0.0 {\n            self.gifts.hush = 0.0;\n        }\n        if self.gifts.echo <= 0.0 && self.gifts.hush <= 0.0 {\n            self.gifts.duet = false;\n        }\n        for i in 0..4 {\n            if !self.slots[i].active {\n                continue;\n            }\n            let shared = self.slots[0].gift_kind == 3;\n            let meter = if shared { 0 } else { i };\n            let ready = self.slots[meter].gift >= 100.0 && self.slots[i].gift_kind != 0 && !self.gifts.locked;\n            let held = self.slots[i].held & btn::GIFT != 0;\n            let was = self.slots[i].arming;\n            if held && ready && self.gifts.hush <= 0.0 && self.gifts.echo <= 0.0 {\n                self.slots[i].arming = true;\n                if !was {\n                    self.cue(cue::GIFT_ARM, Vec2::ZERO, 1.0, 1.0);\n                }\n            } else if !held && was {\n                self.slots[i].arming = false;\n                // Let go on the heartbeat, or it was only a held breath.\n                if self.heart.from_r() <= 0.18 {\n                    let kind = self.slots[i].gift_kind;\n                    self.fire_gift(i, meter, kind, rules);\n                } else {\n                    self.cue(cue::CLINK, Vec2::ZERO, 0.5, 0.6);\n                }\n            } else if !held {\n                self.slots[i].arming = false;\n            }\n        }\n    }\n\n    pub fn fire_gift(&mut self, i: usize, meter: usize, kind: u8, rules: &Rules) {\n        self.slots[meter].gift = 0.0;\n        self.gifts.ripple = 1.0;\n        self.flash = 0.5;\n        let beats = 6.0;\n        let echo = rules.tune.echo_secs * rules.tune.gift_dur;\n        match kind {\n            1 => {\n                self.gifts.hush = beats;\n                self.mark(\"gift:hush\");\n                self.cue(cue::HUSH, Vec2::ZERO, 1.0, 1.0);\n                self.set_banner(\"THE HUSH\");\n            }\n            2 => {\n                self.gifts.echo = echo;\n                self.gifts.ghost = self.slots[i].cursor;\n                self.mark(\"gift:echo\");\n                self.cue(cue::ECHO, Vec2::ZERO, 1.0, 1.0);\n                self.set_banner(\"THE ECHO\");\n                self.say(\"pet\", \"There you are. Thirty years late, and steady as a bell.\");\n            }\n            _ => {\n                self.gifts.hush = beats;\n                self.gifts.echo = echo;\n                self.gifts.duet = true;\n                self.mark(\"gift:duet\");\n                self.mark(\"gift:hush\");\n                self.mark(\"gift:echo\");\n                self.cue(cue::DUET, Vec2::ZERO, 1.0, 1.0);\n                self.set_banner(\"THE DUET\");\n            }\n        }\n    }\n\n    fn echo_action(&mut self, tool: Tool, rating: Rating, rules: &Rules) {\n        // The next valid target for that instrument, nearest the ghost hands.\n        let from = self.gifts.ghost;\n        let target = self.target_near(tool, from, 40.0, 3);\n        let Some(k) = target else { return };\n        let id = self.hazards[k].id;\n        let at = self.hazards[k].spot();\n        self.gifts.ghost = at;\n        self.gifts.ghost_t = 1.0;\n        self.cue(cue::ECHO, at, 0.5, 1.4);\n        self.mark(\"echo:repeat\");\n        // Score goes to the player whose hands they are.\n        let chain_kept = self.gifts.echo;\n        self.gifts.echo = 0.0; // don't echo the echo\n        self.complete(0, id, tool, rating, at, rules);\n        self.gifts.echo = chain_kept;\n    }\n\n    fn ghost_tick(&mut self, _rules: &Rules, dt: f32) {\n        self.gifts.ghost_t = (self.gifts.ghost_t - dt * 2.0).max(0.0);\n        if self.gifts.echo > 0.0 && self.gifts.ghost_t <= 0.0 {\n            // The hands drift back toward where they'd be useful.\n            let want = self.slots[0].cursor + Vec2::new(1.2, -0.8);\n            let g = &mut self.gifts.ghost;\n            *g += (want - *g) * (1.0 - (-dt * 3.0).exp());\n        }\n    }\n\n    /// Reads strain data the view wants.\n    pub fn content(&self) -> std::sync::Arc<Content> {\n        content()\n    }\n}\n\npub fn plate_id(c: &Content, name: &str) -> u8 {\n    c.plate_order.iter().position(|p| p == name).unwrap_or(0) as u8\n}\n\npub fn stitches_for(len: f32) -> u16 {\n    ((len / 0.5).round() as u16).max(2)\n}\n\n/// Where the IV port is on the field.\npub fn iv_port() -> Vec2 {\n    Vec2::new(-8.9, 3.3)\n}\n\n/// The tools that start by holding the trigger over a target, without a fresh press.\nfn tool_is_continuous(t: Tool) -> bool {\n    matches!(t, Tool::Suction | Tool::Laser | Tool::Gel | Tool::Scanner | Tool::Iv | Tool::Cryo)\n}\n\nfn hit_slop(h: &Hazard) -> f32 {\n    match h.kind {\n        Kind::Nodule | Kind::Ember | Kind::Tumor => 0.25,\n        _ => 0.0,\n    }\n}\n\npub fn dist_segment(p: Vec2, a: Vec2, b: Vec2) -> f32 {\n    let ab = b - a;\n    let t = ((p - a).dot(ab) / ab.length_squared().max(1e-5)).clamp(0.0, 1.0);\n    p.distance(a + ab * t)\n}\n\n/// A wound's axis, and a point's along-wound and across-wound coordinates.\npub fn wound_frame(h: &Hazard, p: Vec2) -> (Vec2, f32, f32) {\n    let ax = (h.b - h.a).normalize_or_zero();\n    let d = p - h.a;\n    (ax, d.dot(ax), d.perp_dot(ax))\n}\n\n/// The nearest point on a path within `[from, from + window]`, and its parameter.\npub fn nearest_on_path(h: &Hazard, from: f32, window: f32, p: Vec2) -> (Vec2, f32) {\n    let mut best = (h.path(from), from, f32::MAX);\n    for k in 0..=14 {\n        let t = (from + window * k as f32 / 14.0).min(1.0);\n        let q = h.path(t);\n        let d = q.distance_squared(p);\n        if d < best.2 {\n            best = (q, t, d);\n        }\n    }\n    (best.0, best.1)\n}\n\npub fn angle_diff(a: f32, b: f32) -> f32 {\n    let mut d = (a - b) % std::f32::consts::TAU;\n    if d > std::f32::consts::PI {\n        d -= std::f32::consts::TAU;\n    }\n    if d < -std::f32::consts::PI {\n        d += std::f32::consts::TAU;\n    }\n    d\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":25053,"cache_read_input_tokens":231673,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":25053},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"687c3c76-5167-40df-80fb-a64b0d6f941b","timestamp":"2026-11-05T14:36:24.062Z","request_id":"req_011CgjweUzKaH4XZrGxLWT26","wire_tool_inputs":{"toolu_01CaFnoAfiR5d96tu8q4Gatd":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery/field.rs","content":"//! An operation: the field's hazards, the surgeon slots and their instruments, vitals and the\n//! heart, ratings and chains, the Code and the gifts. Deterministic; all logic is 2D in the\n//! field plane (x, z), held in `Vec2`.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::content::{Content, SpawnSpec, content};\nuse super::cue;\nuse super::tune::{Difficulty, Tune};\nuse crate::frame::SimEvent;\nuse crate::input::{SurgeonInput, surgeon_buttons as btn};\nuse crate::rng::Rng;\n\n// ---------------------------------------------------------------------------------------------\n// Instruments\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]\n#[repr(u8)]\npub enum Tool {\n    #[default]\n    Scalpel = 0,\n    Forceps = 1,\n    Suture = 2,\n    Suction = 3,\n    Laser = 4,\n    Gel = 5,\n    Scanner = 6,\n    Iv = 7,\n    Cryo = 8,\n    Dressing = 9,\n    Defib = 10,\n}\n\nimpl Tool {\n    pub const ALL: [Tool; 11] = [\n        Tool::Scalpel,\n        Tool::Forceps,\n        Tool::Suture,\n        Tool::Suction,\n        Tool::Laser,\n        Tool::Gel,\n        Tool::Scanner,\n        Tool::Iv,\n        Tool::Cryo,\n        Tool::Dressing,\n        Tool::Defib,\n    ];\n    pub const DEFAULT_RING: [Tool; 8] =\n        [Tool::Scalpel, Tool::Forceps, Tool::Suture, Tool::Suction, Tool::Laser, Tool::Gel, Tool::Scanner, Tool::Iv];\n\n    pub fn key(self) -> &'static str {\n        super::content::TOOLS[self as usize]\n    }\n    pub fn name(self) -> &'static str {\n        match self {\n            Tool::Scalpel => \"Scalpel\",\n            Tool::Forceps => \"Forceps\",\n            Tool::Suture => \"Suture\",\n            Tool::Suction => \"Suction\",\n            Tool::Laser => \"Laser\",\n            Tool::Gel => \"Gel\",\n            Tool::Scanner => \"Scanner\",\n            Tool::Iv => \"IV Push\",\n            Tool::Cryo => \"Cryoprobe\",\n            Tool::Dressing => \"Dressing\",\n            Tool::Defib => \"Defibrillator\",\n        }\n    }\n    pub fn from_key(k: &str) -> Option<Tool> {\n        Tool::ALL.into_iter().find(|t| t.key() == k)\n    }\n    pub fn from_u8(v: u8) -> Tool {\n        Tool::ALL[(v as usize).min(10)]\n    }\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[repr(u8)]\npub enum Rating {\n    Sloppy = 0,\n    Good = 1,\n    Clean = 2,\n    Immaculate = 3,\n}\n\nimpl Rating {\n    pub fn name(self) -> &'static str {\n        match self {\n            Rating::Sloppy => \"SLOPPY\",\n            Rating::Good => \"GOOD\",\n            Rating::Clean => \"CLEAN\",\n            Rating::Immaculate => \"IMMACULATE\",\n        }\n    }\n    pub fn points(self) -> i64 {\n        match self {\n            Rating::Sloppy => 10,\n            Rating::Good => 120,\n            Rating::Clean => 250,\n            Rating::Immaculate => 400,\n        }\n    }\n    pub fn from_u8(v: u8) -> Rating {\n        match v {\n            3 => Rating::Immaculate,\n            2 => Rating::Clean,\n            1 => Rating::Good,\n            _ => Rating::Sloppy,\n        }\n    }\n    /// Lower is better: `value` (scaled by strictness) against three thresholds.\n    fn grade(value: f32, strict: f32, a: f32, b: f32, c: f32) -> Rating {\n        let v = value * strict;\n        if v <= a {\n            Rating::Immaculate\n        } else if v <= b {\n            Rating::Clean\n        } else if v <= c {\n            Rating::Good\n        } else {\n            Rating::Sloppy\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------------------------\n// Hazards\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]\n#[repr(u8)]\npub enum Kind {\n    #[default]\n    Incision = 0,\n    Lacer = 1,\n    Pool = 2,\n    Bleeder = 3,\n    Object = 4,\n    Polyp = 5,\n    Tumor = 6,\n    Patch = 7,\n    Bone = 8,\n    Closure = 9,\n    Nodule = 10,\n    Sac = 11,\n    Eye = 12,\n    Ember = 13,\n    Furnace = 14,\n    Tendril = 15,\n}\n\nimpl Kind {\n    pub const ALL: [Kind; 16] = [\n        Kind::Incision,\n        Kind::Lacer,\n        Kind::Pool,\n        Kind::Bleeder,\n        Kind::Object,\n        Kind::Polyp,\n        Kind::Tumor,\n        Kind::Patch,\n        Kind::Bone,\n        Kind::Closure,\n        Kind::Nodule,\n        Kind::Sac,\n        Kind::Eye,\n        Kind::Ember,\n        Kind::Furnace,\n        Kind::Tendril,\n    ];\n    pub fn from_u8(v: u8) -> Kind {\n        Kind::ALL[(v as usize).min(15)]\n    }\n    pub fn key(self) -> &'static str {\n        match self {\n            Kind::Incision => \"incision\",\n            Kind::Lacer => \"lacer\",\n            Kind::Pool => \"pool\",\n            Kind::Bleeder => \"bleeder\",\n            Kind::Object => \"object\",\n            Kind::Polyp => \"polyp\",\n            Kind::Tumor => \"tumor\",\n            Kind::Patch => \"patch\",\n            Kind::Bone => \"bone\",\n            Kind::Closure => \"closure\",\n            Kind::Nodule => \"nodule\",\n            Kind::Sac => \"sac\",\n            Kind::Eye => \"eye\",\n            Kind::Ember => \"ember\",\n            Kind::Furnace => \"furnace\",\n            Kind::Tendril => \"tendril\",\n        }\n    }\n}\n\n/// `Hazard::sub` for objects.\npub mod sub {\n    pub const HOOK: u8 = 0;\n    pub const SHARD: u8 = 1;\n    pub const SPLINTER: u8 = 2;\n    /// A piece of a cracked ember: pulling it cools the Fever.\n    pub const COAL: u8 = 3;\n    /// `Patch`: 0 inflammation, 1 burn.\n    pub const BURN: u8 = 1;\n    /// `Pool`: burning fluid from a sac.\n    pub const CAUSTIC: u8 = 1;\n    /// `Nodule`: small and quick, or the Amen.\n    pub const SMALL: u8 = 1;\n    pub const AMEN: u8 = 2;\n    /// `Ember`: two merged, roaming.\n    pub const ROAMING: u8 = 1;\n    /// `Incision`: a stroke across the eye or a Soloist stroke.\n    pub const STROKE: u8 = 1;\n    /// `Incision`: a tether holding the Amen.\n    pub const TETHER: u8 = 2;\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct Hazard {\n    pub id: u32,\n    pub kind: Kind,\n    /// Position; a path's start.\n    pub a: Vec2,\n    /// A path's end; a sac's stem root; a bone's target.\n    pub b: Vec2,\n    /// A path's control point; a grabbed thing's displacement.\n    pub c: Vec2,\n    pub r: f32,\n    /// Progress 0..1 of whatever this hazard is doing or having done.\n    pub prog: f32,\n    pub stage: u8,\n    pub sub: u8,\n    pub ang: f32,\n    pub hidden: bool,\n    /// Seconds left of a Scanner's reveal.\n    pub seen: f32,\n    pub age: f32,\n    /// Seconds left before it does something by itself (0 = none).\n    pub deadline: f32,\n    pub drain: f32,\n    /// Stitches done and needed.\n    pub n: u16,\n    pub need: u16,\n    /// Blocks the phase until it is dealt with.\n    pub blocking: bool,\n    /// Heat or frost held in it (0..1.3).\n    pub fill: f32,\n    /// Seconds a full heat takes (0 = the default).\n    pub fill_time: f32,\n    /// Beats counted toward its next step (fractional: strains clamp their speed-up).\n    pub beats: f32,\n    pub telegraph: bool,\n}\n\nimpl Hazard {\n    pub fn visible(&self) -> bool {\n        !self.hidden || self.seen > 0.0\n    }\n\n    /// A point along this hazard's path, t in 0..1 (incisions and closures: a curve; a tumor\n    /// ring: a circle).\n    pub fn path(&self, t: f32) -> Vec2 {\n        match self.kind {\n            Kind::Tumor => {\n                let a = t * std::f32::consts::TAU - std::f32::consts::FRAC_PI_2;\n                self.a + Vec2::new(a.cos(), a.sin()) * self.r\n            }\n            _ => {\n                let u = 1.0 - t;\n                self.a * (u * u) + self.c * (2.0 * u * t) + self.b * (t * t)\n            }\n        }\n    }\n\n    pub fn has_path(&self) -> bool {\n        matches!(self.kind, Kind::Incision | Kind::Closure) || (self.kind == Kind::Tumor && self.stage == 0)\n    }\n\n    pub fn path_len(&self) -> f32 {\n        let mut l = 0.0;\n        let mut p = self.path(0.0);\n        for k in 1..=16 {\n            let q = self.path(k as f32 / 16.0);\n            l += p.distance(q);\n            p = q;\n        }\n        l\n    }\n\n    /// The instrument this hazard takes now.\n    pub fn takes(&self) -> Option<Tool> {\n        Some(match (self.kind, self.stage) {\n            (Kind::Incision, _) => Tool::Scalpel,\n            (Kind::Lacer | Kind::Bleeder, _) => Tool::Suture,\n            (Kind::Pool, _) => Tool::Suction,\n            (Kind::Object, _) => Tool::Forceps,\n            (Kind::Polyp, _) => Tool::Laser,\n            (Kind::Tumor, 0) => Tool::Scalpel,\n            (Kind::Tumor, 1) => Tool::Forceps,\n            (Kind::Tumor, _) => Tool::Gel,\n            (Kind::Patch, _) => Tool::Gel,\n            (Kind::Bone, 0) => Tool::Forceps,\n            (Kind::Bone, _) => Tool::Suture,\n            (Kind::Closure, _) => Tool::Dressing,\n            (Kind::Nodule, 0) => Tool::Laser,\n            (Kind::Nodule, 1) => Tool::Forceps,\n            (Kind::Nodule, _) => return None, // held by tethers\n            (Kind::Sac, _) => Tool::Laser,\n            (Kind::Eye, 1) => Tool::Forceps,\n            (Kind::Eye, _) => return None,\n            (Kind::Ember, 0) => Tool::Cryo,\n            (Kind::Ember, _) => Tool::Scalpel,\n            (Kind::Furnace, 0) => Tool::Cryo,\n            (Kind::Furnace, 1) => Tool::Scalpel,\n            (Kind::Furnace, 2) => Tool::Forceps,\n            (Kind::Furnace, 3) => Tool::Laser,\n            (Kind::Furnace, 4) => Tool::Suction,\n            (Kind::Furnace, _) => Tool::Gel,\n            (Kind::Tendril, _) => Tool::Forceps,\n        })\n    }\n\n    /// The spot an instrument aims at.\n    pub fn spot(&self) -> Vec2 {\n        match self.kind {\n            Kind::Sac => self.a.lerp(self.b, 0.55),\n            Kind::Lacer | Kind::Bleeder => self.a.lerp(self.b, self.prog.clamp(0.0, 1.0)),\n            Kind::Incision | Kind::Closure => self.path(self.prog),\n            Kind::Tumor if self.stage == 0 => self.path(self.prog),\n            Kind::Bone if self.stage == 1 => self.b,\n            _ => self.a,\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------------------------\n// The heart\n\n#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize)]\npub struct Heart {\n    /// 0..1 through the beat; the R wave is at 0.\n    pub phase: f32,\n    pub bpm: f32,\n    pub beats: u32,\n    /// Beats to a bar of the ECG's meter, and where in the bar this beat is.\n    pub meter: u8,\n    pub bar: u8,\n    /// The R wave happened this tick.\n    pub r_wave: bool,\n    pub stopped: bool,\n}\n\nimpl Heart {\n    pub fn period(&self) -> f32 {\n        60.0 / self.bpm.max(20.0)\n    }\n    /// Seconds from the nearest R wave.\n    pub fn from_r(&self) -> f32 {\n        let p = self.period();\n        (self.phase * p).min((1.0 - self.phase) * p)\n    }\n    /// Systole: the part of the beat when the heart squeezes.\n    pub fn systole(&self) -> bool {\n        self.phase < 0.35\n    }\n}\n\n// ---------------------------------------------------------------------------------------------\n// Surgeons\n\n/// What a slot is engaged with.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum Eng {\n    #[default]\n    None,\n    Cut,\n    Pull,\n    Stitch,\n    Suck,\n    Heat,\n    Paint,\n    Scan,\n    Iv,\n    Dress,\n    Bone,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Slot {\n    pub active: bool,\n    /// Played by the bot (the Case 7 partner, attract).\n    pub bot: bool,\n    /// The cursor the player steers.\n    pub aim: Vec2,\n    /// Where the instrument really is (with a tremor).\n    pub cursor: Vec2,\n    pub held: u8,\n    pub pressed: u8,\n    pub pressure: f32,\n    /// Ring position.\n    pub tool: u8,\n    pub eng: Eng,\n    pub eng_id: u32,\n    pub eng_t: f32,\n    pub eng_a: f32,\n    pub eng_b: f32,\n    pub eng_start: Vec2,\n    /// Which side of the wound the needle was last on.\n    pub side: i8,\n    pub score: i64,\n    pub chain: u32,\n    pub best_chain: u32,\n    pub chain_t: f32,\n    pub gift: f32,\n    /// 0 none, 1 Hush, 2 Echo, 3 Duet.\n    pub gift_kind: u8,\n    pub arming: bool,\n    pub tally: [u32; 4],\n    pub on_beats: u32,\n    pub since_action: f32,\n    /// Gel flow left (0..1).\n    pub flow: f32,\n    pub ping_t: f32,\n    /// Instrument motion for the view: last action's recoil.\n    pub recoil: f32,\n    /// A wrong-instrument flash.\n    pub clink: f32,\n    pub hover: u32,\n    pub charge: f32,\n}\n\n// ---------------------------------------------------------------------------------------------\n// Things left on the field\n\n#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize, PartialEq)]\npub struct Stain {\n    pub at: Vec2,\n    pub r: f32,\n    /// 0 blood, 1 scorch, 2 gel.\n    pub kind: u8,\n}\n\n#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize, PartialEq)]\npub struct Thread {\n    pub a: Vec2,\n    pub b: Vec2,\n    pub n: u16,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize, PartialEq)]\npub struct Float {\n    pub at: Vec2,\n    pub text: String,\n    /// Rating (0..3), 4 = plain.\n    pub rating: u8,\n    pub on_beat: bool,\n    pub slot: u8,\n    pub age: f32,\n}\n\n/// An extracted thing flying to the tray.\n#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize, PartialEq)]\npub struct Flight {\n    pub from: Vec2,\n    pub sub: u8,\n    pub kind: Kind,\n    pub t: f32,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize, PartialEq)]\npub struct Callout {\n    pub who: String,\n    pub text: String,\n    pub age: f32,\n}\n\n#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize, PartialEq)]\npub struct Code {\n    /// Seconds to defibrillate.\n    pub left: f32,\n    pub window: f32,\n    /// 0..1 ghost beat position; it crosses the centre at 0.5.\n    pub ghost: f32,\n    /// A scripted stop's shocks still to land (0 = an ordinary Code).\n    pub shocks: u8,\n    pub scripted: bool,\n    pub last_good: f32,\n}\n\n#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize, PartialEq)]\npub struct Gifts {\n    /// Heartbeats of Hush left.\n    pub hush: f32,\n    /// Seconds of Echo left.\n    pub echo: f32,\n    /// Hush and Echo together.\n    pub duet: bool,\n    pub locked: bool,\n    /// The ghost hands: where they are and how far through an action.\n    pub ghost: Vec2,\n    pub ghost_t: f32,\n    pub ripple: f32,\n}\n\n/// Numbers that come from outside an operation.\n#[derive(Clone, Copy, Debug)]\npub struct Rules {\n    pub tune: Tune,\n    pub diff: Difficulty,\n    pub immortal: bool,\n    pub freeze_timer: bool,\n    pub full_gift: bool,\n    pub one_hit: bool,\n    pub tremor: bool,\n    pub bot_skill: f32,\n    /// The tick, for the bots' noise.\n    pub tick: u64,\n    /// The sim's simulated seconds.\n    pub time: f32,\n}\n\n// ---------------------------------------------------------------------------------------------\n// The operation\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Op {\n    pub case: u8,\n    pub phase: u16,\n    pub phase_t: f32,\n    pub phase_beats: u32,\n    pub timer: f32,\n    pub timer_max: f32,\n    pub elapsed: f32,\n    pub vitals: f32,\n    pub heart: Heart,\n    pub hazards: Vec<Hazard>,\n    pub next_id: u32,\n    pub slots: [Slot; 4],\n    pub ring: [Tool; 8],\n    pub plate: u8,\n    pub plate_prev: u8,\n    pub reveal: f32,\n    pub reveal_at: Vec2,\n    pub stains: Vec<Stain>,\n    pub threads: Vec<Thread>,\n    pub floats: Vec<Float>,\n    pub flights: Vec<Flight>,\n    pub callout: Option<Callout>,\n    pub say_done: u32,\n    pub trig_done: u32,\n    pub banner: String,\n    pub banner_t: f32,\n    pub mistakes: u32,\n    pub codes_left: u8,\n    pub code: Option<Code>,\n    pub gifts: Gifts,\n    pub strain: Option<super::strain::Strain>,\n    pub fever: Option<f32>,\n    /// A heat ring's radius while it sweeps; seconds until the next one when counting in.\n    pub heat_ring: Option<f32>,\n    pub ring_warn: f32,\n    pub linger: f32,\n    pub lingering: bool,\n    pub iv_cd: f32,\n    pub rng: Rng,\n    pub won: bool,\n    pub dead: bool,\n    pub shake: f32,\n    pub flash: f32,\n    /// The camera leans in for a moment.\n    pub push: f32,\n    pub crit_called: bool,\n    pub callout_cd: f32,\n    pub time_scale: f32,\n    #[serde(skip)]\n    pub ev: Vec<SimEvent>,\n    pub cov: Vec<u32>,\n    pub checkpoint: Option<Box<Op>>,\n    /// Attract: the bot wins nothing, it only shows.\n    pub showing: bool,\n}\n\npub fn v3(p: Vec2) -> Vec3 {\n    Vec3::new(p.x, 0.3, p.y)\n}\n\nimpl Op {\n    pub fn new(case: usize, rules: &Rules, seed: u64) -> Op {\n        let c = content();\n        let data = &c.cases[case];\n        let mut ring = Tool::DEFAULT_RING;\n        if data.ring.len() == 8 {\n            for (k, t) in data.ring.iter().enumerate() {\n                if let Some(t) = Tool::from_key(t) {\n                    ring[k] = t;\n                }\n            }\n        }\n        let plate = plate_id(&c, &data.plate);\n        let timer = data.timer * rules.tune.timer * rules.diff.timer();\n        let mut slots: [Slot; 4] = Default::default();\n        let (gift0, locked) = match data.gift.as_str() {\n            \"hush\" => (1, data.gift_locked),\n            \"echo\" => (2, data.gift_locked),\n            \"duet\" => (3, false),\n            _ => (0, false),\n        };\n        for (i, s) in slots.iter_mut().enumerate() {\n            s.flow = 1.0;\n            s.aim = Vec2::new(-1.0 + i as f32 * 0.8, 0.5);\n            s.cursor = s.aim;\n            s.gift_kind = if case == super::content::CODE_BLUE { (i % 2 + 1) as u8 } else { gift0 };\n        }\n        slots[0].active = true;\n        let mut op = Op {\n            case: case as u8,\n            phase: 0,\n            phase_t: 0.0,\n            phase_beats: 0,\n            timer,\n            timer_max: timer,\n            elapsed: 0.0,\n            vitals: if data.vitals > 0.0 { data.vitals } else { 100.0 },\n            heart: Heart { phase: 0.0, bpm: 72.0, beats: 0, meter: 4, bar: 0, r_wave: false, stopped: false },\n            hazards: Vec::new(),\n            next_id: 1,\n            slots,\n            ring,\n            plate,\n            plate_prev: plate,\n            reveal: 1.0,\n            reveal_at: Vec2::ZERO,\n            stains: Vec::new(),\n            threads: Vec::new(),\n            floats: Vec::new(),\n            flights: Vec::new(),\n            callout: None,\n            say_done: 0,\n            trig_done: 0,\n            banner: String::new(),\n            banner_t: 0.0,\n            mistakes: 0,\n            codes_left: rules.diff.codes(),\n            code: None,\n            gifts: Gifts { locked, ghost: Vec2::new(0.0, -2.0), ..Default::default() },\n            strain: None,\n            fever: None,\n            heat_ring: None,\n            ring_warn: 0.0,\n            linger: 0.0,\n            lingering: false,\n            iv_cd: 0.0,\n            rng: Rng::new(seed ^ 0x51_72_47),\n            won: false,\n            dead: false,\n            shake: 0.0,\n            flash: 0.0,\n            push: 0.0,\n            crit_called: false,\n            callout_cd: 0.0,\n            time_scale: 1.0,\n            ev: Vec::new(),\n            cov: vec![0; super::cover::NAMES.len()],\n            checkpoint: None,\n            showing: false,\n        };\n        op.enter_phase(0, rules);\n        op\n    }\n\n    pub fn cue(&mut self, id: u16, at: Vec2, gain: f32, pitch: f32) {\n        self.ev.push(SimEvent::Cue { id, pos: v3(at), gain, pitch });\n    }\n\n    pub fn mark(&mut self, name: &str) {\n        super::cover::mark(&mut self.cov, name);\n    }\n\n    pub fn say(&mut self, who: &str, text: &str) {\n        self.callout = Some(Callout { who: who.to_string(), text: text.to_string(), age: 0.0 });\n    }\n\n    /// A callout from the table (`callouts.toml`), not too often.\n    pub fn call(&mut self, key: &str) {\n        if self.callout_cd > 0.0 {\n            return;\n        }\n        let c = content();\n        if let Some(entry) = c.callouts.get(key) {\n            if !entry.text.is_empty() {\n                let k = self.rng.below(entry.text.len() as u32) as usize;\n                let (who, text) = (entry.who.clone(), entry.text[k].clone());\n                // With the scrub nurse on the table, the anaesthesiologist calls it.\n                let who = if self.case == 7 && who == \"bashir\" { \"teddy\".to_string() } else { who };\n                self.say(&who, &text);\n                self.callout_cd = 3.0;\n            }\n        }\n    }\n\n    pub fn set_banner(&mut self, text: &str) {\n        self.banner = text.to_string();\n        self.banner_t = 0.0;\n        self.cue(cue::BANNER, Vec2::ZERO, 1.0, 1.0);\n    }\n\n    // -----------------------------------------------------------------------------------------\n    // Spawning\n\n    pub fn add(&mut self, mut h: Hazard) -> u32 {\n        h.id = self.next_id;\n        self.next_id += 1;\n        let id = h.id;\n        self.mark(&format!(\"hazard:{}\", h.kind.key()));\n        self.hazards.push(h);\n        id\n    }\n\n    pub fn spawn_spec(&mut self, s: &SpawnSpec) {\n        let a = s.a.map(|p| Vec2::new(p[0], p[1])).unwrap_or(Vec2::ZERO);\n        let b = s.b.map(|p| Vec2::new(p[0], p[1])).unwrap_or(a + Vec2::new(2.0, 0.0));\n        let mut h = Hazard {\n            a,\n            b,\n            c: s.c.map(|p| Vec2::new(p[0], p[1])).unwrap_or((a + b) * 0.5),\n            r: s.r.unwrap_or(1.0),\n            ang: s.ang.unwrap_or(0.0).to_radians(),\n            hidden: s.hidden,\n            sub: s.sub,\n            stage: s.stage,\n            blocking: !s.optional,\n            ..Default::default()\n        };\n        match s.kind.as_str() {\n            \"incision\" => {\n                h.kind = Kind::Incision;\n            }\n            \"closure\" => {\n                h.kind = Kind::Closure;\n            }\n            \"lacer\" => {\n                h.kind = Kind::Lacer;\n                h.drain = 0.6;\n                h.need = stitches_for(a.distance(b));\n            }\n            \"bleeder\" => {\n                h.kind = Kind::Bleeder;\n                h.drain = 3.0;\n                h.need = 3;\n                let d = Vec2::from_angle(h.ang) * 0.7;\n                h.b = a + d;\n                h.a = a - d;\n            }\n            \"pool\" => {\n                h.kind = Kind::Pool;\n            }\n            \"object\" => {\n                h.kind = Kind::Object;\n                h.drain = 0.2;\n                h.r = s.r.unwrap_or(0.45);\n            }\n            \"polyp\" => {\n                h.kind = Kind::Polyp;\n                h.drain = 0.1;\n                h.r = s.r.unwrap_or(0.5);\n            }\n            \"tumor\" => {\n                h.kind = Kind::Tumor;\n                h.drain = 0.4;\n                h.r = s.r.unwrap_or(1.3);\n            }\n            \"patch\" => {\n                h.kind = Kind::Patch;\n                h.drain = 0.2;\n            }\n            \"burn\" => {\n                h.kind = Kind::Patch;\n                h.sub = sub::BURN;\n                h.drain = 0.2;\n            }\n            \"bone\" => {\n                h.kind = Kind::Bone;\n                h.r = s.r.unwrap_or(0.9);\n                h.need = 2;\n            }\n            _ => return,\n        }\n        if let Some(d) = s.drain {\n            h.drain = d;\n        }\n        self.add(h);\n    }\n\n    pub fn find(&self, id: u32) -> Option<usize> {\n        self.hazards.iter().position(|h| h.id == id)\n    }\n\n    fn remove(&mut self, id: u32) -> Option<Hazard> {\n        self.find(id).map(|i| self.hazards.remove(i))\n    }\n\n    // -----------------------------------------------------------------------------------------\n    // The phase machine\n\n    pub fn enter_phase(&mut self, k: usize, rules: &Rules) {\n        let c = content();\n        let case = &c.cases[self.case as usize];\n        let Some(p) = case.phase.get(k) else {\n            self.won = true;\n            return;\n        };\n        self.phase = k as u16;\n        self.phase_t = 0.0;\n        self.phase_beats = 0;\n        self.say_done = 0;\n        self.trig_done = 0;\n        self.lingering = false;\n        self.linger = 0.0;\n        if let Some(m) = p.meter {\n            self.heart.meter = m;\n            self.heart.bar = 0;\n        }\n        if let Some(r) = &p.reveal_plate {\n            self.plate_prev = self.plate;\n            self.plate = plate_id(&c, r);\n            self.reveal = 0.0;\n            self.push = 1.0;\n            self.stains.clear();\n            self.threads.clear();\n            self.cue(cue::SQUISH, self.reveal_at, 1.0, 0.7);\n        }\n        if let Some(b) = &p.banner {\n            let b = b.clone();\n            self.set_banner(&b);\n        }\n        if p.checkpoint {\n            let mut copy = self.clone();\n            copy.checkpoint = None;\n            copy.ev = Vec::new();\n            self.checkpoint = Some(Box::new(copy));\n        }\n        for s in &p.spawn {\n            self.spawn_spec(s);\n        }\n        if let Some(name) = &p.strain {\n            self.strain = Some(super::strain::Strain::start(name, &p.params));\n            self.start_strain(rules);\n            self.mark(&format!(\"strain:{name}\"));\n        }\n        if p.code_shocks > 0 {\n            self.start_code(p.code_shocks, rules);\n        }\n        self.mark(&format!(\"phase:{}:{}\", self.case, k.min(15)));\n    }\n\n    /// Restores the last checkpoint (or the case's start, when there is none). Under 2 seconds:\n    /// it is instant.\n    pub fn retry_checkpoint(&mut self, rules: &Rules) -> bool {\n        if let Some(cp) = self.checkpoint.take() {\n            let cov = std::mem::take(&mut self.cov);\n            let mut op = (*cp).clone();\n            op.checkpoint = Some(cp);\n            op.cov = cov;\n            op.dead = false;\n            op.banner.clear();\n            *self = op;\n            let _ = rules;\n            true\n        } else {\n            false\n        }\n    }\n\n    /// The hazards still holding the phase open.\n    pub fn blockers(&self) -> usize {\n        self.hazards.iter().filter(|h| h.blocking).count()\n    }\n\n    fn phase_tick(&mut self, dt: f32, rules: &Rules) {\n        let c = content();\n        let case = &c.cases[self.case as usize];\n        let Some(p) = case.phase.get(self.phase as usize) else { return };\n        self.phase_t += dt;\n        for (k, s) in p.say.iter().enumerate() {\n            if self.say_done & (1 << k) == 0 && self.phase_t >= s.at {\n                self.say_done |= 1 << k;\n                self.say(&s.who, &s.text);\n            }\n        }\n        let mut hold = false;\n        for (k, t) in p.trigger.iter().enumerate() {\n            if self.trig_done & (1 << k) != 0 {\n                continue;\n            }\n            let strain_done = self.strain.is_none();\n            let fire = t.at_time.is_some_and(|x| self.phase_t >= x)\n                || t.vitals_below.is_some_and(|x| self.vitals < x)\n                || t.on_beat.is_some_and(|x| self.phase_beats >= x)\n                || (t.on_clear && self.blockers() == 0 && strain_done && self.code.is_none());\n            if fire {\n                self.trig_done |= 1 << k;\n                for s in &t.spawn {\n                    self.spawn_spec(s);\n                }\n                for s in &t.say {\n                    self.say(&s.who, &s.text);\n                }\n                if let Some(id) = t.cue.as_deref().and_then(cue::id) {\n                    self.cue(id, Vec2::ZERO, 1.0, 1.0);\n                }\n                if let Some(b) = &t.banner {\n                    self.set_banner(b);\n                }\n                if t.on_clear {\n                    hold = true;\n                }\n            }\n        }\n        if hold || self.code.is_some() || self.strain.is_some() || self.blockers() > 0 {\n            return;\n        }\n        // Clear: a moment of drama, then the next phase.\n        if !self.lingering {\n            self.lingering = true;\n            self.linger = p.linger.max(0.35);\n        }\n        self.linger -= dt;\n        if self.linger <= 0.0 {\n            if let Some(h) = self.hazards.iter().rev().find(|h| h.has_path()) {\n                self.reveal_at = h.b;\n            }\n            let next = self.phase as usize + 1;\n            if next >= case.phase.len() {\n                self.won = true;\n            } else {\n                self.enter_phase(next, rules);\n            }\n        }\n    }\n\n    // -----------------------------------------------------------------------------------------\n    // One tick\n\n    pub fn tick(&mut self, inputs: &[SurgeonInput; 4], rules: &Rules, dt: f32) {\n        // The world slows inside a Hush; hands never do.\n        let hushed = self.gifts.hush > 0.0;\n        let scale = if hushed { rules.tune.hush_scale.clamp(0.05, 1.0) } else { 1.0 };\n        self.time_scale = scale;\n        let world = dt * scale;\n        self.elapsed += dt;\n        self.banner_t += dt;\n        self.callout_cd = (self.callout_cd - dt).max(0.0);\n        self.shake = (self.shake - dt * 2.5).max(0.0);\n        self.flash = (self.flash - dt * 3.0).max(0.0);\n        self.push = (self.push - dt * 0.8).max(0.0);\n        self.reveal = (self.reveal + dt / 0.8).min(1.0);\n        self.iv_cd = (self.iv_cd - world).max(0.0);\n        self.gifts.ripple = (self.gifts.ripple - dt * 1.5).max(0.0);\n        if let Some(c) = &mut self.callout {\n            c.age += dt;\n            if c.age > 4.5 {\n                self.callout = None;\n            }\n        }\n        for f in &mut self.floats {\n            f.age += dt;\n        }\n        self.floats.retain(|f| f.age < 1.5);\n        for f in &mut self.flights {\n            f.t += dt * 1.6;\n        }\n        self.flights.retain(|f| f.t < 1.0);\n\n        self.apply_inputs(inputs, rules, dt);\n        self.heart_tick(rules, dt, scale);\n        self.gift_tick(rules, dt);\n\n        if !self.heart.stopped || self.code.is_none() {\n            if !rules.freeze_timer {\n                self.timer -= world;\n            }\n            if self.timer <= 0.0 && !self.showing {\n                if self.is_director_case() {\n                    // Code Blue: the team held on.\n                    self.won = true;\n                    return;\n                }\n                if !rules.immortal {\n                    self.timer = 0.0;\n                    self.dead = true;\n                    self.mark(\"death:time\");\n                    return;\n                }\n                self.timer = self.timer_max;\n            }\n        }\n\n        // Tools run for each surgeon, in seat order.\n        for i in 0..4 {\n            if self.slots[i].active {\n                self.tool_tick(i, rules, dt, world);\n            }\n        }\n        self.ghost_tick(rules, dt);\n        if self.code.is_none() {\n            self.hazards_tick(world, rules);\n            self.strain_tick(world, rules);\n            self.drain_tick(world, rules);\n        }\n        self.code_tick(rules, dt);\n        if self.code.is_none() {\n            self.phase_tick(dt, rules);\n        }\n        self.fx_limits();\n    }\n\n    pub fn is_director_case(&self) -> bool {\n        self.case as usize == super::content::CODE_BLUE\n    }\n\n    fn fx_limits(&mut self) {\n        let n = self.stains.len();\n        if n > 40 {\n            self.stains.drain(..n - 40);\n        }\n        let n = self.threads.len();\n        if n > 24 {\n            self.threads.drain(..n - 24);\n        }\n    }\n\n    fn apply_inputs(&mut self, inputs: &[SurgeonInput; 4], rules: &Rules, dt: f32) {\n        let time = rules.time;\n        for i in 0..4 {\n            let inp = inputs[i];\n            let s = &mut self.slots[i];\n            if !inp.active && !s.bot && i > 0 {\n                s.held = 0;\n                s.pressed = 0;\n                continue;\n            }\n            if inp.active {\n                s.active = true;\n            }\n            s.held = inp.held;\n            s.pressed = inp.pressed | (inp.held & !s.held & 0);\n            s.pressure = if inp.pressure > 0.0 { inp.pressure } else if inp.held & btn::USE != 0 { 1.0 } else { 0.0 };\n            if inp.tool > 0 && inp.tool <= 8 {\n                self.select(i, inp.tool - 1);\n            }\n            if inp.cycle != 0 {\n                let t = (self.slots[i].tool as i32 + inp.cycle as i32).rem_euclid(8) as u8;\n                self.select(i, t);\n            }\n            if inp.abs {\n                self.slots[i].aim = inp.aim;\n            } else if inp.aim != Vec2::ZERO {\n                self.stick_move(i, inp.aim, rules, dt);\n            }\n            let s = &mut self.slots[i];\n            s.aim = s.aim.clamp(Vec2::new(-10.6, -5.6), Vec2::new(10.6, 5.9));\n            // Pet's tremor: a slow wander, gone in Precision and during the Echo.\n            let tremor = s.gift_kind == 2\n                && rules.tremor\n                && s.held & btn::PRECISION == 0\n                && self.gifts.echo <= 0.0\n                && self.is_pet_case();\n            let wander = if tremor {\n                Vec2::new((time * 3.1 + i as f32).sin() + (time * 7.3).sin() * 0.5, (time * 4.3).cos() + (time * 5.9).sin() * 0.5)\n                    * 0.08\n            } else {\n                Vec2::ZERO\n            };\n            s.cursor = s.aim + wander;\n            s.recoil = (s.recoil - dt * 4.0).max(0.0);\n            s.clink = (s.clink - dt * 3.0).max(0.0);\n            s.since_action += dt;\n            if s.chain > 0 {\n                s.chain_t += dt;\n                if s.chain_t > rules.tune.chain_window {\n                    s.chain = 0;\n                }\n            }\n            s.hover = 0;\n        }\n        for i in 0..4 {\n            if self.slots[i].active {\n                let tool = self.tool_of(i);\n                let p = self.slots[i].cursor;\n                self.slots[i].hover = self.target_near(tool, p, 1.0, i).map(|k| self.hazards[k].id).unwrap_or(0);\n            }\n        }\n    }\n\n    pub fn is_pet_case(&self) -> bool {\n        let c = content();\n        c.cases[self.case as usize].surgeon == \"pet\"\n    }\n\n    pub fn select(&mut self, i: usize, ring_pos: u8) {\n        if self.slots[i].tool != ring_pos {\n            self.release(i);\n            self.slots[i].tool = ring_pos;\n            let p = self.slots[i].cursor;\n            self.cue(cue::TOOL_PICK, p, 0.8, 1.0 + ring_pos as f32 * 0.04);\n        }\n    }\n\n    /// Drops what the hand holds.\n    fn release(&mut self, i: usize) {\n        let s = &mut self.slots[i];\n        let id = s.eng_id;\n        s.eng = Eng::None;\n        s.eng_id = 0;\n        s.eng_a = 0.0;\n        s.eng_b = 0.0;\n        if let Some(k) = self.find(id) {\n            let h = &mut self.hazards[k];\n            if h.kind != Kind::Bone && h.kind != Kind::Tendril {\n                h.c = if h.has_path() { h.c } else { Vec2::ZERO };\n            }\n        }\n    }\n\n    /// Stick steering: speed curve, Precision, and aim assist (slowdown and pull near a valid\n    /// target, a rail along a cut, the needle's creep along a wound).\n    fn stick_move(&mut self, i: usize, stick: Vec2, rules: &Rules, dt: f32) {\n        let s = &self.slots[i];\n        let (aim, eng, eng_id, tool, held) = (s.aim, s.eng, s.eng_id, self.tool_of(i), s.held);\n        let mag = stick.length().min(1.0);\n        let dir = stick.normalize_or_zero();\n        let mut speed = 15.0 * mag.powf(2.2) * rules.tune.cursor_speed;\n        if held & btn::PRECISION != 0 {\n            speed *= 0.35;\n        }\n        let assist = rules.tune.aim_assist;\n        let mut pull = Vec2::ZERO;\n        if assist > 0.0 {\n            if let Some(k) = self.target_near(tool, aim, 1.2, i) {\n                let spot = self.hazards[k].spot();\n                let d = spot.distance(aim);\n                let t = 1.0 - (d / 1.2).clamp(0.0, 1.0);\n                speed *= 1.0 - 0.5 * assist * t;\n                pull = (spot - aim).normalize_or_zero() * (3.0 * assist * t) * dt;\n            }\n        }\n        let mut next = aim + dir * speed * dt + pull;\n        if assist > 0.0 {\n            if let Some(h) = self.find(eng_id).map(|k| &self.hazards[k]) {\n                match eng {\n                    Eng::Cut | Eng::Dress => {\n                        // Rail: sideways error is damped.\n                        let (near, _) = nearest_on_path(h, h.prog, 0.3, next);\n                        next += (near - next) * (0.25 * assist);\n                    }\n                    Eng::Stitch => {\n                        // The needle creeps along by itself, so the stick only flicks across it.\n                        let (ax, along, _) = wound_frame(h, next);\n                        let want = h.a.distance(h.b) * h.prog + 0.1;\n                        next += ax * (want - along).clamp(-1.0, 1.0) * (8.0 * assist * dt);\n                    }\n                    _ => {}\n                }\n            }\n        }\n        self.slots[i].aim = next;\n    }\n\n    fn heart_tick(&mut self, rules: &Rules, dt: f32, scale: f32) {\n        let coupling = rules.tune.coupling;\n        let want = 72.0 + (148.0 - 72.0) * (1.0 - self.vitals / 100.0).clamp(0.0, 1.0) * coupling;\n        let h = &mut self.heart;\n        h.bpm += (want.clamp(40.0, 200.0) - h.bpm) * (1.0 - (-dt * 1.5).exp());\n        h.r_wave = false;\n        if h.stopped {\n            return;\n        }\n        // Inside a Hush the heart slows, but less than the world: it is what the player counts.\n        let rate = if scale < 1.0 { 0.5 } else { 1.0 };\n        h.phase += dt * rate / h.period();\n        if h.phase >= 1.0 {\n            h.phase -= 1.0;\n            h.beats += 1;\n            h.r_wave = true;\n            h.bar = (h.bar + 1) % h.meter.max(1);\n            self.phase_beats += 1;\n            let accent = if h.bar == 0 { 1.0 } else { 0.7 };\n            self.cue(cue::LUB, Vec2::ZERO, accent, 1.0);\n            self.cue(cue::MONITOR, Vec2::ZERO, 0.5, if self.heart.bar == 0 { 1.2 } else { 1.0 });\n            if self.gifts.hush > 0.0 {\n                self.gifts.hush -= 1.0 / rules.tune.gift_dur.max(0.1);\n                if self.gifts.hush <= 0.0 {\n                    self.gifts.duet = self.gifts.echo > 0.0;\n                }\n            }\n        }\n    }\n\n    fn drain_tick(&mut self, world: f32, rules: &Rules) {\n        let mut d = 0.0;\n        for h in &self.hazards {\n            d += match h.kind {\n                Kind::Pool => (0.2 + h.drain) * std::f32::consts::PI * h.r * h.r,\n                _ => h.drain,\n            };\n        }\n        if let Some(f) = self.fever {\n            if f > 100.0 {\n                d += 6.0;\n            }\n        }\n        let before = self.vitals;\n        self.vitals -= d * world * rules.tune.drain * rules.diff.drain();\n        if before >= 40.0 && self.vitals < 40.0 {\n            self.call(\"vitals_low\");\n            if !self.crit_called {\n                self.crit_called = true;\n                self.set_banner(\"VITALS CRITICAL\");\n                self.cue(cue::ALARM, Vec2::ZERO, 1.0, 1.0);\n            }\n        }\n        if self.vitals > 55.0 {\n            self.crit_called = false;\n        }\n        if self.vitals <= 0.0 {\n            self.vitals = 0.0;\n            if rules.immortal {\n                self.vitals = 60.0;\n            } else if self.codes_left > 0 {\n                self.codes_left -= 1;\n                self.start_code(0, rules);\n            } else {\n                self.dead = true;\n                self.mark(\"death:vitals\");\n            }\n        }\n    }\n\n    pub fn start_code(&mut self, shocks: u8, rules: &Rules) {\n        let window = rules.tune.code_window;\n        self.code = Some(Code { left: window, window, ghost: 0.0, shocks, scripted: shocks > 0, last_good: 0.0 });\n        self.heart.stopped = true;\n        self.mark(\"code\");\n        if shocks > 0 {\n            self.mark(\"code:scripted\");\n        }\n        self.set_banner(\"CODE\");\n        self.cue(cue::FLATLINE, Vec2::ZERO, 1.0, 1.0);\n        self.shake = 0.6;\n        self.push = 1.0;\n        for s in &mut self.slots {\n            s.eng = Eng::None;\n            s.eng_id = 0;\n        }\n    }\n\n    fn code_tick(&mut self, rules: &Rules, dt: f32) {\n        let Some(mut c) = self.code else { return };\n        c.left -= dt;\n        c.ghost = (c.ghost + dt / 0.9).fract();\n        c.last_good = (c.last_good - dt).max(0.0);\n        let mut landed = false;\n        let mut missed = false;\n        for i in 0..4 {\n            if !self.slots[i].active {\n                continue;\n            }\n            let s = &mut self.slots[i];\n            let holding = s.held & btn::DEFIB != 0;\n            if holding {\n                let before = s.charge;\n                s.charge = (s.charge + dt / 1.2).min(1.0);\n                if before == 0.0 {\n                    self.ev.push(SimEvent::Cue { id: cue::DEFIB_WHINE, pos: Vec3::ZERO, gain: 1.0, pitch: 1.0 });\n                }\n            } else if s.charge > 0.0 {\n                // Let go: on the ghost beat, or nothing.\n                let good = s.charge >= 1.0 && (c.ghost - 0.5).abs() * 0.9 <= 0.2;\n                s.charge = 0.0;\n                if good {\n                    landed = true;\n                } else {\n                    missed = true;\n                }\n            }\n        }\n        if missed {\n            self.cue(cue::CLINK, Vec2::ZERO, 1.0, 0.7);\n        }\n        if landed {\n            self.cue(cue::DEFIB_THUMP, Vec2::ZERO, 1.0, 1.0);\n            self.shake = 1.0;\n            self.flash = 1.0;\n            self.mark(\"tool:defib\");\n            self.award(0, Vec2::ZERO, Tool::Defib, Rating::Clean, rules);\n            if c.shocks > 1 {\n                c.shocks -= 1;\n                c.left = c.window;\n                c.last_good = 1.0;\n                self.code = Some(c);\n                self.say(\"teddy\", \"Again! Charge it again!\");\n                return;\n            }\n            self.code = None;\n            self.heart.stopped = false;\n            self.heart.phase = 0.0;\n            if !c.scripted {\n                self.vitals = 30.0;\n            } else {\n                self.vitals = self.vitals.max(45.0);\n            }\n            self.cue(cue::LUB, Vec2::ZERO, 1.0, 1.0);\n            return;\n        }\n        if c.left <= 0.0 {\n            if rules.immortal {\n                self.code = None;\n                self.heart.stopped = false;\n                self.vitals = 60.0;\n                return;\n            }\n            self.dead = true;\n            self.code = None;\n            self.mark(\"death:code\");\n            return;\n        }\n        self.code = Some(c);\n    }\n\n    // -----------------------------------------------------------------------------------------\n    // Hazard behaviour\n\n    fn hazards_tick(&mut self, world: f32, _rules: &Rules) {\n        let mut feed = 0.0;\n        for h in &mut self.hazards {\n            h.age += world;\n            if h.seen > 0.0 {\n                h.seen -= world;\n            }\n            match h.kind {\n                Kind::Lacer | Kind::Bleeder => feed += h.drain * world,\n                Kind::Patch | Kind::Polyp | Kind::Nodule | Kind::Sac | Kind::Ember | Kind::Furnace => {}\n                _ => {}\n            }\n            // Heat that nobody is holding fades.\n            if h.fill > 0.0 && !matches!(h.kind, Kind::Bone) {\n                h.fill = (h.fill - world * 0.25).max(0.0);\n            }\n        }\n        // Open wounds feed pools.\n        if feed > 0.0 {\n            let wound = self\n                .hazards\n                .iter()\n                .filter(|h| matches!(h.kind, Kind::Lacer | Kind::Bleeder))\n                .map(|h| h.a.lerp(h.b, 0.5))\n                .next();\n            if let Some(at) = wound {\n                let near = self.hazards.iter().position(|h| h.kind == Kind::Pool && h.a.distance(at) < h.r + 1.0);\n                match near {\n                    Some(k) => {\n                        let p = &mut self.hazards[k];\n                        p.r = (p.r + feed * 0.03).min(1.7);\n                    }\n                    None => {\n                        if self.pool_count() < 4 && self.rng.f32() < feed * 0.06 {\n                            let offset = Vec2::new(self.rng.range(-0.5, 0.5), self.rng.range(-0.4, 0.4));\n                            self.add(Hazard { kind: Kind::Pool, a: at + offset, r: 0.42, blocking: false, ..Default::default() });\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    fn pool_count(&self) -> usize {\n        self.hazards.iter().filter(|h| h.kind == Kind::Pool).count()\n    }\n\n    pub fn covered(&self, h: &Hazard) -> bool {\n        h.kind != Kind::Pool\n            && !matches!(h.kind, Kind::Incision | Kind::Closure | Kind::Sac | Kind::Eye)\n            && self.hazards.iter().any(|p| p.kind == Kind::Pool && p.a.distance(h.spot()) < p.r * 0.85)\n    }\n\n    /// Can `tool` act on this hazard now?\n    pub fn valid(&self, h: &Hazard, tool: Tool) -> bool {\n        if !h.visible() || self.covered(h) {\n            return false;\n        }\n        if h.kind == Kind::Sac {\n            return tool == Tool::Laser || tool == Tool::Suction;\n        }\n        h.takes() == Some(tool)\n    }\n\n    /// The nearest hazard `tool` can act on within `reach` of `p`, not held by another surgeon.\n    pub fn target_near(&self, tool: Tool, p: Vec2, reach: f32, me: usize) -> Option<usize> {\n        let mut best: Option<(usize, f32)> = None;\n        for (k, h) in self.hazards.iter().enumerate() {\n            if !self.valid(h, tool) || self.held_by_other(h.id, me) {\n                continue;\n            }\n            let d = self.dist_to(h, tool, p);\n            if d <= reach + hit_slop(h) && best.is_none_or(|(_, b)| d < b) {\n                best = Some((k, d));\n            }\n        }\n        best.map(|(k, _)| k)\n    }\n\n    pub fn held_by_other(&self, id: u32, me: usize) -> bool {\n        self.slots.iter().enumerate().any(|(i, s)| i != me && s.active && s.eng_id == id && s.eng != Eng::None)\n    }\n\n    pub fn dist_to(&self, h: &Hazard, tool: Tool, p: Vec2) -> f32 {\n        match h.kind {\n            Kind::Lacer | Kind::Bleeder => dist_segment(p, h.a, h.b),\n            Kind::Sac if tool == Tool::Suction => (p.distance(h.a) - h.r).max(0.0),\n            Kind::Bone if h.stage == 1 => p.distance(h.b),\n            Kind::Pool | Kind::Patch => (p.distance(h.a) - h.r).max(0.0),\n            _ if h.has_path() => p.distance(h.spot()),\n            _ => p.distance(h.spot()),\n        }\n    }\n\n    pub fn tool_of(&self, i: usize) -> Tool {\n        if self.code.is_some() {\n            return Tool::Defib;\n        }\n        // The closing dressing comes to hand by itself when it is all that's left.\n        if self.hazards.iter().any(|h| h.kind == Kind::Closure)\n            && !self.hazards.iter().any(|h| h.kind != Kind::Closure && h.blocking)\n        {\n            return Tool::Dressing;\n        }\n        self.ring[(self.slots[i].tool as usize).min(7)]\n    }\n\n    // -----------------------------------------------------------------------------------------\n    // Instruments\n\n    fn wrong_tool(&mut self, i: usize, rules: &Rules) {\n        let s = &mut self.slots[i];\n        if s.clink > 0.2 {\n            return;\n        }\n        s.chain = 0;\n        s.clink = 1.0;\n        let p = s.cursor;\n        self.cue(cue::CLINK, p, 1.0, 1.0);\n        self.call(\"wrong_tool\");\n        self.vitals -= rules.tune.wrong_penalty;\n        self.mark(\"wrong_tool\");\n    }\n\n    /// A slip: a small laceration here.\n    fn lacerate(&mut self, at: Vec2, ang: f32, rules: &Rules) {\n        let d = Vec2::from_angle(ang) * 0.6;\n        let h = Hazard {\n            kind: Kind::Lacer,\n            a: at - d,\n            b: at + d,\n            drain: 0.6,\n            need: 3,\n            blocking: false,\n            ..Default::default()\n        };\n        self.add(h);\n        self.mistakes += 1;\n        self.vitals -= 2.0 * rules.diff.drain();\n        self.shake = self.shake.max(0.3);\n        self.cue(cue::TEAR, at, 1.0, 1.0);\n        self.mark(\"mistake:lacerate\");\n    }\n\n    fn burn_at(&mut self, at: Vec2) {\n        let h = Hazard { kind: Kind::Patch, sub: sub::BURN, a: at, r: 0.7, drain: 0.25, blocking: false, ..Default::default() };\n        self.add(h);\n        self.mistakes += 1;\n        self.cue(cue::SIZZLE, at, 1.0, 0.8);\n        self.mark(\"mistake:burn\");\n    }\n\n    fn tool_tick(&mut self, i: usize, rules: &Rules, dt: f32, world: f32) {\n        if self.code.is_some() {\n            return;\n        }\n        let tool = self.tool_of(i);\n        let s = &self.slots[i];\n        let held = s.held & btn::USE != 0;\n        let pressed = s.pressed & btn::USE != 0 || (held && s.eng == Eng::None && tool_is_continuous(tool));\n        let p = s.cursor;\n        let cancel = s.held & btn::CANCEL != 0;\n        if cancel {\n            self.release(i);\n            return;\n        }\n        // The gel's flow refills whenever the trigger is up.\n        if tool != Tool::Gel || !held {\n            let s = &mut self.slots[i];\n            s.flow = (s.flow + dt / 2.0).min(1.0);\n        }\n        // Heat rings scorch a hand that stays down.\n        if held {\n            if let Some(radius) = self.heat_ring {\n                let d = p.length();\n                if (d - radius).abs() < 0.55 {\n                    self.scorch(i, rules);\n                    return;\n                }\n            }\n        }\n        self.slots[i].eng_t += dt;\n        match tool {\n            Tool::Scalpel | Tool::Dressing => self.cut_tick(i, tool, held, pressed, rules),\n            Tool::Forceps => self.forceps_tick(i, held, pressed, rules, dt),\n            Tool::Suture => self.suture_tick(i, held, pressed, rules),\n            Tool::Suction => self.suction_tick(i, held, rules, world.max(dt * 0.6)),\n            Tool::Laser | Tool::Cryo => self.heat_tick(i, tool, held, rules, dt),\n            Tool::Gel => self.gel_tick(i, held, rules, dt),\n            Tool::Scanner => self.scanner_tick(i, held, dt),\n            Tool::Iv => self.iv_tick(i, held, rules, dt),\n            Tool::Defib => {}\n        }\n    }\n\n    fn scorch(&mut self, i: usize, rules: &Rules) {\n        let p = self.slots[i].cursor;\n        if self.slots[i].clink > 0.0 {\n            return;\n        }\n        self.release(i);\n        let s = &mut self.slots[i];\n        s.chain = 0;\n        s.clink = 1.0;\n        self.vitals -= 2.0 * rules.diff.drain();\n        self.burn_at(p);\n        self.call(\"lift_off\");\n        self.mark(\"scorch\");\n    }\n\n    fn cut_tick(&mut self, i: usize, tool: Tool, held: bool, pressed: bool, rules: &Rules) {\n        let s = &self.slots[i];\n        let (p, eng, eng_id) = (s.cursor, s.eng, s.eng_id);\n        let want = if tool == Tool::Dressing { Eng::Dress } else { Eng::Cut };\n        if eng == want {\n            let Some(k) = self.find(eng_id) else {\n                self.release(i);\n                return;\n            };\n            if !held {\n                // Let go mid-stroke: the cut stays, the rating suffers.\n                self.hazards[k].fill += 1.0;\n                self.release(i);\n                return;\n            }\n            let h = &self.hazards[k];\n            let (near, t) = nearest_on_path(h, h.prog, 0.28, p);\n            let d = near.distance(p);\n            if d > 1.15 && tool == Tool::Scalpel {\n                let ang = (p - near).to_angle();\n                self.release(i);\n                self.call(\"healthy\");\n                self.lacerate(p, ang, rules);\n                return;\n            }\n            let adv = (t - h.prog).max(0.0);\n            let s = &mut self.slots[i];\n            if adv > 0.0 {\n                s.eng_a += d * adv;\n                s.eng_b += adv;\n            }\n            let h = &mut self.hazards[k];\n            h.prog = h.prog.max(t);\n            if adv > 0.002 && self.slots[i].eng_t > 0.12 {\n                self.slots[i].eng_t = 0.0;\n                let tool_cue = if tool == Tool::Scalpel { cue::SLICE } else { cue::GEL };\n                self.cue(tool_cue, near, 0.6, 1.0);\n            }\n            let h = &self.hazards[k];\n            if h.prog >= 0.975 {\n                let breaks = h.fill.floor();\n                let s = &self.slots[i];\n                let mean = s.eng_a / s.eng_b.max(0.2);\n                let rating = Rating::grade(mean + breaks * 0.18, rules.tune.strictness, 0.25, 0.42, 0.7);\n                let at = h.b;\n                let id = h.id;\n                self.release(i);\n                self.complete(i, id, tool, rating, at, rules);\n            }\n            return;\n        }\n        if !pressed {\n            return;\n        }\n        if let Some(k) = self.target_near(tool, p, 0.75, i) {\n            let id = self.hazards[k].id;\n            match (self.hazards[k].kind, self.hazards[k].stage) {\n                // A brittle ember takes one stroke through it.\n                (Kind::Ember, _) | (Kind::Furnace, _) => {\n                    let at = self.hazards[k].a;\n                    self.cue(cue::CRACK, at, 1.0, 1.0);\n                    let rating = if self.hazards[k].fill > 0.0 { Rating::Clean } else { Rating::Immaculate };\n                    self.complete(i, id, tool, rating, at, rules);\n                }\n                _ => {\n                    let s = &mut self.slots[i];\n                    s.eng = want;\n                    s.eng_id = id;\n                    s.eng_a = 0.0;\n                    s.eng_b = 0.0;\n                    s.eng_t = 0.0;\n                    self.mark(&format!(\"tool:{}\", tool.key()));\n                }\n            }\n        } else if tool == Tool::Scalpel {\n            if self.wrong_tool_here(i, tool, p, rules) {\n                return;\n            }\n            // Cutting what was never meant to be cut.\n            self.slots[i].eng_start = p;\n            self.call(\"healthy\");\n            self.lacerate(p, 0.7, rules);\n        }\n    }\n\n    /// A press on a hazard this instrument can't touch: true when it was one.\n    fn wrong_tool_here(&mut self, i: usize, tool: Tool, p: Vec2, rules: &Rules) -> bool {\n        let hit = self.hazards.iter().any(|h| {\n            h.visible()\n                && h.takes().is_some()\n                && h.takes() != Some(tool)\n                && !matches!(h.kind, Kind::Pool)\n                && self.dist_to(h, tool, p) < 0.6\n        });\n        if hit {\n            self.wrong_tool(i, rules);\n        }\n        hit\n    }\n\n    fn forceps_tick(&mut self, i: usize, held: bool, pressed: bool, rules: &Rules, dt: f32) {\n        let s = &self.slots[i];\n        let (p, eng, eng_id, start) = (s.cursor, s.eng, s.eng_id, s.eng_start);\n        if eng == Eng::Pull {\n            let Some(k) = self.find(eng_id) else {\n                self.release(i);\n                return;\n            };\n            if !held {\n                self.hazards[k].prog = 0.0;\n                self.release(i);\n                return;\n            }\n            let h = &self.hazards[k];\n            if h.kind == Kind::Tendril {\n                self.tendril_pull(i, k, rules, dt);\n                return;\n            }\n            let disp = p - start;\n            let axis = Vec2::from_angle(h.ang);\n            let along = disp.dot(axis);\n            let m = disp.length();\n            let err = if m > 0.05 { axis.angle_to(disp).abs().to_degrees() } else { 0.0 };\n            let need = 1.0;\n            let at = h.a;\n            let id = h.id;\n            let hazard = &mut self.hazards[k];\n            hazard.c = disp;\n            hazard.prog = (along / need).clamp(0.0, 1.0);\n            if m > 0.55 && err > 60.0 {\n                // Yanked off the axis: it tears.\n                self.hazards[k].c = Vec2::ZERO;\n                self.hazards[k].prog = 0.0;\n                self.release(i);\n                self.call(\"off_axis\");\n                self.lacerate(at, axis.to_angle(), rules);\n                return;\n            }\n            if along >= need {\n                let rating = Rating::grade(err, rules.tune.strictness, 12.0, 24.0, 40.0);\n                self.release(i);\n                self.cue(cue::PULL_POP, at, 1.0, 1.0);\n                self.complete(i, id, Tool::Forceps, rating, at, rules);\n            }\n            return;\n        }\n        if eng == Eng::Bone {\n            let Some(k) = self.find(eng_id) else {\n                self.release(i);\n                return;\n            };\n            let s = &self.slots[i];\n            let (rot_l, rot_r) = (s.held & btn::ROT_L != 0, s.held & btn::ROT_R != 0);\n            let spin = (rot_r as i32 - rot_l as i32) as f32;\n            let h = &mut self.hazards[k];\n            h.a = p;\n            h.ang += spin * 2.2 * dt;\n            let err = angle_diff(h.ang, 0.0).abs().to_degrees();\n            let d = h.a.distance(h.b);\n            if d < 0.35 && err < 12.0 {\n                h.a = h.b;\n                h.ang = 0.0;\n                let id = h.id;\n                let at = h.b;\n                let t = self.slots[i].eng_a;\n                let rating = Rating::grade(t, rules.tune.strictness, 3.0, 6.0, 12.0);\n                self.release(i);\n                self.cue(cue::SNAP, at, 1.0, 1.0);\n                self.complete(i, id, Tool::Forceps, rating, at, rules);\n                return;\n            }\n            self.slots[i].eng_a += dt;\n            if !held {\n                self.release(i);\n            }\n            return;\n        }\n        if !pressed {\n            return;\n        }\n        if let Some(k) = self.target_near(Tool::Forceps, p, 0.7, i) {\n            let id = self.hazards[k].id;\n            let kind = self.hazards[k].kind;\n            let s = &mut self.slots[i];\n            s.eng = if kind == Kind::Bone { Eng::Bone } else { Eng::Pull };\n            s.eng_id = id;\n            s.eng_start = p;\n            s.eng_a = 0.0;\n            s.eng_t = 0.0;\n            self.mark(\"tool:forceps\");\n            self.cue(cue::FORCEPS, p, 1.0, 1.0);\n        } else {\n            self.wrong_tool_here(i, Tool::Forceps, p, rules);\n        }\n    }\n\n    fn tendril_pull(&mut self, i: usize, k: usize, rules: &Rules, dt: f32) {\n        let s = &self.slots[i];\n        let p = s.cursor;\n        let moved = p - s.eng_start;\n        let h = &self.hazards[k];\n        let axis = Vec2::from_angle(h.ang);\n        let along = moved.dot(axis);\n        self.slots[i].eng_start = p;\n        let (at, id) = (h.a, h.id);\n        if along > 0.001 {\n            if self.heart.systole() {\n                // Pulling against the squeeze: it snaps back.\n                let h = &mut self.hazards[k];\n                h.prog = (h.prog - 0.12).max(0.0);\n                h.fill += 1.0;\n                self.slots[i].chain = 0;\n                self.cue(cue::TEAR, at, 0.7, 1.2);\n                self.vitals -= 1.0 * rules.diff.drain();\n                self.call(\"tendril_systole\");\n                self.release(i);\n                return;\n            }\n            let h = &mut self.hazards[k];\n            h.prog = (h.prog + along * 0.085 * rules.tune.tool_power / rules.tune.strain_tough.max(0.2)).min(1.0);\n            h.c = axis * h.prog * 1.6;\n        }\n        let _ = dt;\n        if self.hazards[k].prog >= 1.0 {\n            let breaks = self.hazards[k].fill;\n            let rating = Rating::grade(breaks, rules.tune.strictness, 0.5, 2.0, 4.0);\n            self.release(i);\n            self.cue(cue::PULL_POP, at, 1.0, 0.7);\n            self.complete(i, id, Tool::Forceps, rating, at, rules);\n        }\n    }\n\n    fn suture_tick(&mut self, i: usize, held: bool, pressed: bool, rules: &Rules) {\n        let s = &self.slots[i];\n        let (p, eng, eng_id) = (s.cursor, s.eng, s.eng_id);\n        if eng == Eng::Stitch {\n            let Some(k) = self.find(eng_id) else {\n                self.release(i);\n                return;\n            };\n            if !held {\n                self.release(i);\n                return;\n            }\n            let h = &self.hazards[k];\n            let (_, along, perp) = wound_frame(h, p);\n            let side = if perp > 0.07 {\n                1\n            } else if perp < -0.07 {\n                -1\n            } else {\n                0\n            };\n            let last = self.slots[i].side;\n            if side != 0 {\n                self.slots[i].side = side;\n            }\n            if side != 0 && last != 0 && side != last {\n                // A crossing: near the needle it is a stitch.\n                let len = h.a.distance(h.b).max(0.1);\n                let need = h.need.max(1) as f32;\n                let needle = len * (h.n as f32 + 0.5) / need;\n                let off = (along - needle).abs();\n                if off < 1.2 {\n                    let at = h.a.lerp(h.b, (h.n as f32 + 0.5) / need);\n                    let h = &mut self.hazards[k];\n                    h.n += 1;\n                    h.prog = (h.n as f32 / need).min(1.0);\n                    let done = h.n >= h.need;\n                    let id = h.id;\n                    let s = &mut self.slots[i];\n                    s.eng_a += off;\n                    s.eng_b += 1.0;\n                    s.eng_t = 0.0;\n                    self.cue(cue::SUTURE, at, 0.8, 0.9 + (self.hazards[k].n as f32) * 0.03);\n                    if done {\n                        let s = &self.slots[i];\n                        let mean = s.eng_a / s.eng_b.max(1.0);\n                        let rating = Rating::grade(mean, rules.tune.strictness, 0.32, 0.55, 0.85);\n                        self.release(i);\n                        self.complete(i, id, Tool::Suture, rating, at, rules);\n                    }\n                }\n            }\n            return;\n        }\n        if !pressed {\n            return;\n        }\n        if let Some(k) = self.target_near(Tool::Suture, p, 0.85, i) {\n            let id = self.hazards[k].id;\n            let (_, _, perp) = wound_frame(&self.hazards[k], p);\n            let s = &mut self.slots[i];\n            s.eng = Eng::Stitch;\n            s.eng_id = id;\n            s.side = if perp >= 0.0 { 1 } else { -1 };\n            s.eng_a = 0.0;\n            s.eng_b = 0.0;\n            s.eng_t = 0.0;\n            self.mark(\"tool:suture\");\n        } else {\n            self.wrong_tool_here(i, Tool::Suture, p, rules);\n        }\n    }\n\n    fn suction_tick(&mut self, i: usize, held: bool, rules: &Rules, dt: f32) {\n        if !held {\n            self.slots[i].eng = Eng::None;\n            self.slots[i].eng_id = 0;\n            return;\n        }\n        let s = &self.slots[i];\n        let (p, pressure) = (s.cursor, s.pressure.clamp(0.2, 1.0));\n        let Some(k) = self.target_near(Tool::Suction, p, 0.4, i) else {\n            self.slots[i].eng = Eng::None;\n            self.slots[i].eng_id = 0;\n            return;\n        };\n        let power = rules.tune.tool_power * pressure;\n        let id = self.hazards[k].id;\n        self.slots[i].eng = Eng::Suck;\n        self.slots[i].eng_id = id;\n        self.mark(\"tool:suction\");\n        if self.slots[i].eng_t > 0.18 {\n            self.slots[i].eng_t = 0.0;\n            self.cue(cue::GURGLE, p, 0.35 + pressure * 0.6, 0.8 + self.rng.f32() * 0.4);\n        }\n        let h = &mut self.hazards[k];\n        let at = h.a;\n        if h.kind == Kind::Sac {\n            // Draining a sac whole: slow, and it never rates better than Good.\n            h.fill = (h.fill + dt / 2.4 * power).min(1.0);\n            h.r = (0.8 * (1.0 - h.fill) + 0.1) * (0.5 + 0.5 * h.prog);\n            if h.fill >= 1.0 {\n                self.release(i);\n                self.complete(i, id, Tool::Suction, Rating::Good, at, rules);\n            }\n        } else if matches!(h.kind, Kind::Furnace) {\n            h.fill = (h.fill + dt / 1.0 * power).min(1.0);\n            if h.fill >= 1.0 {\n                h.fill = 0.0;\n                self.release(i);\n                self.complete(i, id, Tool::Suction, Rating::Good, at, rules);\n            }\n        } else {\n            h.r -= dt * 1.1 * power;\n            if h.r <= 0.14 {\n                let r = 0.5;\n                self.stains.push(Stain { at, r, kind: 0 });\n                self.release(i);\n                self.complete(i, id, Tool::Suction, Rating::Good, at, rules);\n            }\n        }\n    }\n\n    fn heat_tick(&mut self, i: usize, tool: Tool, held: bool, rules: &Rules, dt: f32) {\n        let s = &self.slots[i];\n        let (p, eng, eng_id) = (s.cursor, s.eng, s.eng_id);\n        let engaged = eng == Eng::Heat;\n        if engaged && !held {\n            // The release decides everything.\n            let k = self.find(eng_id);\n            self.release(i);\n            if let Some(k) = k {\n                let h = &self.hazards[k];\n                let (fill, at, id) = (h.fill, h.spot(), h.id);\n                if fill >= 0.8 {\n                    let off = if fill <= 1.0 { 1.0 - fill } else { fill - 1.0 + 0.05 };\n                    let rating = Rating::grade(off, rules.tune.strictness, 0.07, 0.13, 0.22);\n                    self.hazards[k].fill = 0.0;\n                    self.complete(i, id, tool, rating, at, rules);\n                }\n            }\n            return;\n        }\n        if !held {\n            return;\n        }\n        let target = self.target_near(tool, p, 0.55, i);\n        match target {\n            Some(k) => {\n                let id = self.hazards[k].id;\n                if eng_id != id {\n                    let s = &mut self.slots[i];\n                    s.eng = Eng::Heat;\n                    s.eng_id = id;\n                    self.mark(&format!(\"tool:{}\", tool.key()));\n                }\n                let time = {\n                    let h = &self.hazards[k];\n                    let base = if h.fill_time > 0.0 {\n                        h.fill_time\n                    } else if tool == Tool::Cryo {\n                        1.0\n                    } else {\n                        1.2\n                    };\n                    let tough = if matches!(h.kind, Kind::Nodule | Kind::Sac | Kind::Ember | Kind::Furnace) {\n                        rules.tune.strain_tough\n                    } else {\n                        1.0\n                    };\n                    base * tough / rules.tune.tool_power.max(0.1)\n                };\n                let h = &mut self.hazards[k];\n                h.fill += dt / time.max(0.05) + dt * 0.25;\n                let (fill, at) = (h.fill, h.spot());\n                if self.slots[i].eng_t > 0.2 {\n                    self.slots[i].eng_t = 0.0;\n                    let id = if tool == Tool::Laser { cue::LASER } else { cue::FROST };\n                    self.cue(id, at, 0.5, 0.7 + fill * 0.6);\n                }\n                if fill > 1.28 {\n                    self.hazards[k].fill = 0.0;\n                    self.release(i);\n                    if tool == Tool::Laser {\n                        self.call(\"overheat\");\n                    } else {\n                        self.call(\"frostbite\");\n                    }\n                    self.burn_at(at);\n                    self.slots[i].chain = 0;\n                }\n            }\n            None => {\n                let s = &mut self.slots[i];\n                s.eng = Eng::None;\n                s.eng_id = 0;\n                // Holding a beam on healthy tissue: it burns, eventually.\n                s.eng_a += dt;\n                if s.eng_a > 1.6 {\n                    s.eng_a = 0.0;\n                    if !self.wrong_tool_here(i, tool, p, rules) {\n                        self.burn_at(p);\n                    }\n                }\n            }\n        }\n    }\n\n    fn gel_tick(&mut self, i: usize, held: bool, rules: &Rules, dt: f32) {\n        if !held {\n            self.slots[i].eng = Eng::None;\n            self.slots[i].eng_id = 0;\n            return;\n        }\n        let s = &mut self.slots[i];\n        let p = s.cursor;\n        s.flow -= dt / 2.4;\n        if s.flow <= 0.0 {\n            s.flow = 0.0;\n            return;\n        }\n        if s.eng_t > 0.16 {\n            s.eng_t = 0.0;\n            self.cue(cue::GEL, p, 0.5, 1.0 + self.rng.f32() * 0.2);\n        }\n        let Some(k) = self.target_near(Tool::Gel, p, 0.2, i) else {\n            self.slots[i].eng_b += dt;\n            return;\n        };\n        let id = self.hazards[k].id;\n        let s = &mut self.slots[i];\n        if s.eng_id != id {\n            s.eng = Eng::Paint;\n            s.eng_id = id;\n            self.mark(\"tool:gel\");\n        }\n        let h = &mut self.hazards[k];\n        let area = (h.r * h.r).max(0.5);\n        h.prog += dt * 1.25 * rules.tune.tool_power / area;\n        let at = h.a;\n        if h.prog >= 1.0 {\n            h.prog = 0.0;\n            let over = self.slots[i].eng_b;\n            let rating = Rating::grade(over, rules.tune.strictness, 0.25, 0.6, 1.1);\n            self.slots[i].eng_b = 0.0;\n            self.slots[i].eng_id = 0;\n            self.stains.push(Stain { at, r: 0.6, kind: 2 });\n            self.complete(i, id, Tool::Gel, rating, at, rules);\n        }\n    }\n\n    fn scanner_tick(&mut self, i: usize, held: bool, dt: f32) {\n        if !held {\n            self.slots[i].eng = Eng::None;\n            return;\n        }\n        let s = &mut self.slots[i];\n        s.eng = Eng::Scan;\n        s.ping_t -= dt;\n        let p = s.cursor;\n        if s.ping_t <= 0.0 {\n            s.ping_t = 0.45;\n            self.mark(\"tool:scanner\");\n            self.cue(cue::SONAR, p, 0.7, 1.0);\n        }\n        let mut found = Vec::new();\n        for h in &mut self.hazards {\n            if h.hidden && h.a.distance(p) < 2.2 {\n                if h.seen <= 0.0 {\n                    found.push(h.a);\n                }\n                h.seen = 8.0;\n            }\n        }\n        for at in found {\n            self.cue(cue::SONAR, at, 1.0, 1.5);\n            let floats = Float { at, text: \"FOUND\".into(), rating: 4, on_beat: false, slot: i as u8, age: 0.0 };\n            self.floats.push(floats);\n        }\n    }\n\n    fn iv_tick(&mut self, i: usize, held: bool, rules: &Rules, dt: f32) {\n        let s = &self.slots[i];\n        let (engaged, dose) = (s.eng == Eng::Iv, s.eng_a);\n        if engaged && !held {\n            self.release(i);\n            self.iv_cd = 4.0;\n            if dose >= 0.25 {\n                let off = if dose <= 1.0 { 1.0 - dose } else { dose - 1.0 + 0.04 };\n                let rating = Rating::grade(off, rules.tune.strictness, 0.08, 0.18, 0.5);\n                let at = iv_port();\n                self.award(i, at, Tool::Iv, rating, rules);\n            }\n            return;\n        }\n        if !held {\n            return;\n        }\n        if !engaged {\n            if self.iv_cd > 0.0 {\n                return;\n            }\n            let s = &mut self.slots[i];\n            s.eng = Eng::Iv;\n            s.eng_a = 0.0;\n            s.eng_id = 0;\n            self.mark(\"tool:iv\");\n            self.cue(cue::IV, iv_port(), 1.0, 1.0);\n        }\n        let step = dt / 1.2;\n        let s = &mut self.slots[i];\n        s.eng_a += step;\n        let dose = s.eng_a;\n        if dose <= 1.0 {\n            self.vitals = (self.vitals + 18.0 * rules.tune.iv_heal * step).min(100.0);\n        }\n        if dose > 1.3 {\n            // Overdose: a spike, then the fall.\n            self.release(i);\n            self.iv_cd = 4.0;\n            self.vitals = (self.vitals - 8.0).max(1.0);\n            self.mistakes += 1;\n            self.shake = self.shake.max(0.4);\n            self.call(\"overdose\");\n            self.cue(cue::ALARM, iv_port(), 0.7, 1.3);\n            self.mark(\"mistake:overdose\");\n        }\n    }\n\n    // -----------------------------------------------------------------------------------------\n    // Finishing things\n\n    /// Scores a rated action: chain, on-beat, gift charge, the big text.\n    pub fn award(&mut self, i: usize, at: Vec2, tool: Tool, rating: Rating, rules: &Rules) {\n        let beat_window = rules.tune.beat_ms / 1000.0;\n        let on_beat = !self.heart.stopped && self.heart.from_r() <= beat_window;\n        let chain_up = rating as u8 >= Rating::Clean as u8;\n        let s = &mut self.slots[i];\n        s.tally[rating as usize] += 1;\n        s.since_action = 0.0;\n        s.recoil = 1.0;\n        if chain_up {\n            s.chain += 1;\n            s.chain_t = 0.0;\n            s.best_chain = s.best_chain.max(s.chain);\n        } else if rating == Rating::Sloppy {\n            s.chain = 0;\n        }\n        let mult = match s.chain {\n            0..=4 => 1.0,\n            5..=9 => 1.25,\n            10..=19 => 1.5,\n            _ => 2.0,\n        };\n        let beat = if on_beat { 1.25 } else { 1.0 };\n        let pts = rating.points() as f32 * mult * beat * rules.tune.score;\n        s.score += pts as i64;\n        if on_beat {\n            s.on_beats += 1;\n        }\n        let charge = match rating {\n            Rating::Immaculate => 8.0,\n            Rating::Clean => 4.0,\n            Rating::Good => 1.0,\n            Rating::Sloppy => 0.0,\n        } + if on_beat { 2.0 } else { 0.0 };\n        let shared = self.slots[0].gift_kind == 3;\n        let meter = if shared { 0 } else { i };\n        if !self.gifts.locked {\n            let m = &mut self.slots[meter];\n            m.gift = (m.gift + charge * rules.tune.gift_gain).min(100.0);\n        }\n        // Inside a Hush each on-beat action adds a heartbeat.\n        if on_beat && self.gifts.hush > 0.0 {\n            self.gifts.hush += 1.0;\n        }\n        let chain = self.slots[i].chain;\n        let cue_id = [cue::RATE_SLOPPY, cue::RATE_GOOD, cue::RATE_CLEAN, cue::RATE_IMMACULATE][rating as usize];\n        self.cue(cue_id, at, 1.0, 1.0);\n        if on_beat {\n            self.cue(cue::ON_BEAT, at, 1.0, 1.0);\n            self.mark(\"on_beat\");\n        }\n        if chain_up && matches!(chain, 5 | 10 | 20) {\n            self.cue(cue::CHAIN_UP, at, 1.0, 1.0);\n            self.mark(\"chain\");\n        }\n        self.mark(&format!(\"rating:{}\", rating.name().to_lowercase()));\n        self.mark(&format!(\"rated:{}\", tool.key()));\n        self.floats.push(Float { at, text: rating.name().into(), rating: rating as u8, on_beat, slot: i as u8, age: 0.0 });\n        if self.floats.len() > 8 {\n            self.floats.remove(0);\n        }\n        // The Echo copies each action onto the next target.\n        if self.gifts.echo > 0.0 && i != 3 && tool != Tool::Iv && tool != Tool::Defib {\n            self.echo_action(tool, rating, rules);\n        }\n    }\n\n    /// Finishes a stage of a hazard with a rating: points and what it does to the hazard.\n    pub fn complete(&mut self, i: usize, id: u32, tool: Tool, rating: Rating, at: Vec2, rules: &Rules) {\n        self.award(i, at, tool, rating, rules);\n        self.apply_done(id, rating, rules);\n    }\n\n    /// The effect of a finished action on its hazard. The Echo and dev tools use it too.\n    pub fn apply_done(&mut self, id: u32, rating: Rating, rules: &Rules) {\n        let Some(k) = self.find(id) else { return };\n        let (kind, stage, a) = {\n            let h = &self.hazards[k];\n            (h.kind, h.stage, h.a)\n        };\n        self.mark(&format!(\"done:{}\", kind.key()));\n        match kind {\n            Kind::Incision | Kind::Closure => {\n                let h = self.remove(id).unwrap();\n                self.reveal_at = h.b;\n                if h.sub == sub::TETHER || h.sub == sub::STROKE {\n                    self.strain_stroke_done(rules);\n                }\n            }\n            Kind::Lacer | Kind::Bleeder => {\n                let h = self.remove(id).unwrap();\n                self.threads.push(Thread { a: h.a, b: h.b, n: h.need });\n                if rating == Rating::Sloppy {\n                    // Sloppy spacing leaves a slow bleed.\n                    self.add(Hazard { kind: Kind::Pool, a: h.a.lerp(h.b, 0.5), r: 0.5, blocking: false, ..Default::default() });\n                }\n            }\n            Kind::Pool => {\n                self.remove(id);\n            }\n            Kind::Object => {\n                let h = self.remove(id).unwrap();\n                self.flights.push(Flight { from: a, sub: h.sub, kind, t: 0.0 });\n                if h.sub == sub::COAL {\n                    if let Some(f) = &mut self.fever {\n                        *f = (*f - 8.0).max(0.0);\n                    }\n                }\n            }\n            Kind::Polyp => {\n                self.remove(id);\n                self.stains.push(Stain { at: a, r: 0.45, kind: 1 });\n                self.cue(cue::SIZZLE, a, 1.0, 1.0);\n            }\n            Kind::Tumor => {\n                if stage >= 2 {\n                    self.remove(id);\n                } else {\n                    let h = &mut self.hazards[k];\n                    h.stage += 1;\n                    h.prog = 0.0;\n                    h.c = Vec2::ZERO;\n                    if stage == 1 {\n                        self.flights.push(Flight { from: a, sub: 4, kind, t: 0.0 });\n                        self.hazards[k].drain = 0.3;\n                    }\n                }\n            }\n            Kind::Patch => {\n                self.remove(id);\n            }\n            Kind::Bone => {\n                if stage >= 1 {\n                    let h = self.remove(id).unwrap();\n                    self.stains.push(Stain { at: h.b, r: 0.4, kind: 2 });\n                } else {\n                    let h = &mut self.hazards[k];\n                    h.stage = 1;\n                    h.n = 0;\n                    h.prog = 0.0;\n                    // The wire crosses the seat of the fragment.\n                    let d = Vec2::new(0.9, 0.0);\n                    let at = h.b;\n                    h.c = at;\n                    h.a = at;\n                    let _ = d;\n                }\n            }\n            Kind::Nodule | Kind::Sac | Kind::Eye | Kind::Ember | Kind::Furnace | Kind::Tendril => {\n                self.strain_done(id, kind, stage, rating, rules);\n            }\n        }\n    }\n\n    /// A rating as the bot or dev sees it: nothing left to do with this hazard now.\n    pub fn resolve_now(&mut self, id: u32, rules: &Rules) {\n        self.apply_done(id, Rating::Clean, rules);\n    }\n\n    fn gift_tick(&mut self, rules: &Rules, dt: f32) {\n        if rules.full_gift && !self.gifts.locked {\n            for s in &mut self.slots {\n                s.gift = 100.0;\n            }\n        }\n        self.gifts.echo = (self.gifts.echo - dt).max(0.0);\n        if self.gifts.hush <= 0.0 {\n            self.gifts.hush = 0.0;\n        }\n        if self.gifts.echo <= 0.0 && self.gifts.hush <= 0.0 {\n            self.gifts.duet = false;\n        }\n        for i in 0..4 {\n            if !self.slots[i].active {\n                continue;\n            }\n            let shared = self.slots[0].gift_kind == 3;\n            let meter = if shared { 0 } else { i };\n            let ready = self.slots[meter].gift >= 100.0 && self.slots[i].gift_kind != 0 && !self.gifts.locked;\n            let held = self.slots[i].held & btn::GIFT != 0;\n            let was = self.slots[i].arming;\n            if held && ready && self.gifts.hush <= 0.0 && self.gifts.echo <= 0.0 {\n                self.slots[i].arming = true;\n                if !was {\n                    self.cue(cue::GIFT_ARM, Vec2::ZERO, 1.0, 1.0);\n                }\n            } else if !held && was {\n                self.slots[i].arming = false;\n                // Let go on the heartbeat, or it was only a held breath.\n                if self.heart.from_r() <= 0.18 {\n                    let kind = self.slots[i].gift_kind;\n                    self.fire_gift(i, meter, kind, rules);\n                } else {\n                    self.cue(cue::CLINK, Vec2::ZERO, 0.5, 0.6);\n                }\n            } else if !held {\n                self.slots[i].arming = false;\n            }\n        }\n    }\n\n    pub fn fire_gift(&mut self, i: usize, meter: usize, kind: u8, rules: &Rules) {\n        self.slots[meter].gift = 0.0;\n        self.gifts.ripple = 1.0;\n        self.flash = 0.5;\n        let beats = 6.0;\n        let echo = rules.tune.echo_secs * rules.tune.gift_dur;\n        match kind {\n            1 => {\n                self.gifts.hush = beats;\n                self.mark(\"gift:hush\");\n                self.cue(cue::HUSH, Vec2::ZERO, 1.0, 1.0);\n                self.set_banner(\"THE HUSH\");\n            }\n            2 => {\n                self.gifts.echo = echo;\n                self.gifts.ghost = self.slots[i].cursor;\n                self.mark(\"gift:echo\");\n                self.cue(cue::ECHO, Vec2::ZERO, 1.0, 1.0);\n                self.set_banner(\"THE ECHO\");\n                self.say(\"pet\", \"There you are. Thirty years late, and steady as a bell.\");\n            }\n            _ => {\n                self.gifts.hush = beats;\n                self.gifts.echo = echo;\n                self.gifts.duet = true;\n                self.mark(\"gift:duet\");\n                self.mark(\"gift:hush\");\n                self.mark(\"gift:echo\");\n                self.cue(cue::DUET, Vec2::ZERO, 1.0, 1.0);\n                self.set_banner(\"THE DUET\");\n            }\n        }\n    }\n\n    fn echo_action(&mut self, tool: Tool, rating: Rating, rules: &Rules) {\n        // The next valid target for that instrument, nearest the ghost hands.\n        let from = self.gifts.ghost;\n        let target = self.target_near(tool, from, 40.0, 3);\n        let Some(k) = target else { return };\n        let id = self.hazards[k].id;\n        let at = self.hazards[k].spot();\n        self.gifts.ghost = at;\n        self.gifts.ghost_t = 1.0;\n        self.cue(cue::ECHO, at, 0.5, 1.4);\n        self.mark(\"echo:repeat\");\n        // Score goes to the player whose hands they are.\n        let chain_kept = self.gifts.echo;\n        self.gifts.echo = 0.0; // don't echo the echo\n        self.complete(0, id, tool, rating, at, rules);\n        self.gifts.echo = chain_kept;\n    }\n\n    fn ghost_tick(&mut self, _rules: &Rules, dt: f32) {\n        self.gifts.ghost_t = (self.gifts.ghost_t - dt * 2.0).max(0.0);\n        if self.gifts.echo > 0.0 && self.gifts.ghost_t <= 0.0 {\n            // The hands drift back toward where they'd be useful.\n            let want = self.slots[0].cursor + Vec2::new(1.2, -0.8);\n            let g = &mut self.gifts.ghost;\n            *g += (want - *g) * (1.0 - (-dt * 3.0).exp());\n        }\n    }\n\n    /// Reads strain data the view wants.\n    pub fn content(&self) -> std::sync::Arc<Content> {\n        content()\n    }\n}\n\npub fn plate_id(c: &Content, name: &str) -> u8 {\n    c.plate_order.iter().position(|p| p == name).unwrap_or(0) as u8\n}\n\npub fn stitches_for(len: f32) -> u16 {\n    ((len / 0.5).round() as u16).max(2)\n}\n\n/// Where the IV port is on the field.\npub fn iv_port() -> Vec2 {\n    Vec2::new(-8.9, 3.3)\n}\n\n/// The tools that start by holding the trigger over a target, without a fresh press.\nfn tool_is_continuous(t: Tool) -> bool {\n    matches!(t, Tool::Suction | Tool::Laser | Tool::Gel | Tool::Scanner | Tool::Iv | Tool::Cryo)\n}\n\nfn hit_slop(h: &Hazard) -> f32 {\n    match h.kind {\n        Kind::Nodule | Kind::Ember | Kind::Tumor => 0.25,\n        _ => 0.0,\n    }\n}\n\npub fn dist_segment(p: Vec2, a: Vec2, b: Vec2) -> f32 {\n    let ab = b - a;\n    let t = ((p - a).dot(ab) / ab.length_squared().max(1e-5)).clamp(0.0, 1.0);\n    p.distance(a + ab * t)\n}\n\n/// A wound's axis, and a point's along-wound and across-wound coordinates.\npub fn wound_frame(h: &Hazard, p: Vec2) -> (Vec2, f32, f32) {\n    let ax = (h.b - h.a).normalize_or_zero();\n    let d = p - h.a;\n    (ax, d.dot(ax), d.perp_dot(ax))\n}\n\n/// The nearest point on a path within `[from, from + window]`, and its parameter.\npub fn nearest_on_path(h: &Hazard, from: f32, window: f32, p: Vec2) -> (Vec2, f32) {\n    let mut best = (h.path(from), from, f32::MAX);\n    for k in 0..=14 {\n        let t = (from + window * k as f32 / 14.0).min(1.0);\n        let q = h.path(t);\n        let d = q.distance_squared(p);\n        if d < best.2 {\n            best = (q, t, d);\n        }\n    }\n    (best.0, best.1)\n}\n\npub fn angle_diff(a: f32, b: f32) -> f32 {\n    let mut d = (a - b) % std::f32::consts::TAU;\n    if d > std::f32::consts::PI {\n        d -= std::f32::consts::TAU;\n    }\n    if d < -std::f32::consts::PI {\n        d += std::f32::consts::TAU;\n    }\n    d\n}\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CaFnoAfiR5d96tu8q4Gatd","type":"tool_result","content":"File created successfully at: /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery/field.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"2387f350-4106-48dd-ad58-13e60f157c2b","timestamp":"2026-11-05T14:36:24.110Z","tool_use_result":{"type":"create","filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery/field.rs","content":"//! An operation: the field's hazards, the surgeon slots and their instruments, vitals and the\n//! heart, ratings and chains, the Code and the gifts. Deterministic; all logic is 2D in the\n//! field plane (x, z), held in `Vec2`.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse super::content::{Content, SpawnSpec, content};\nuse super::cue;\nuse super::tune::{Difficulty, Tune};\nuse crate::frame::SimEvent;\nuse crate::input::{SurgeonInput, surgeon_buttons as btn};\nuse crate::rng::Rng;\n\n// ---------------------------------------------------------------------------------------------\n// Instruments\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]\n#[repr(u8)]\npub enum Tool {\n    #[default]\n    Scalpel = 0,\n    Forceps = 1,\n    Suture = 2,\n    Suction = 3,\n    Laser = 4,\n    Gel = 5,\n    Scanner = 6,\n    Iv = 7,\n    Cryo = 8,\n    Dressing = 9,\n    Defib = 10,\n}\n\nimpl Tool {\n    pub const ALL: [Tool; 11] = [\n        Tool::Scalpel,\n        Tool::Forceps,\n        Tool::Suture,\n        Tool::Suction,\n        Tool::Laser,\n        Tool::Gel,\n        Tool::Scanner,\n        Tool::Iv,\n        Tool::Cryo,\n        Tool::Dressing,\n        Tool::Defib,\n    ];\n    pub const DEFAULT_RING: [Tool; 8] =\n        [Tool::Scalpel, Tool::Forceps, Tool::Suture, Tool::Suction, Tool::Laser, Tool::Gel, Tool::Scanner, Tool::Iv];\n\n    pub fn key(self) -> &'static str {\n        super::content::TOOLS[self as usize]\n    }\n    pub fn name(self) -> &'static str {\n        match self {\n            Tool::Scalpel => \"Scalpel\",\n            Tool::Forceps => \"Forceps\",\n            Tool::Suture => \"Suture\",\n            Tool::Suction => \"Suction\",\n            Tool::Laser => \"Laser\",\n            Tool::Gel => \"Gel\",\n            Tool::Scanner => \"Scanner\",\n            Tool::Iv => \"IV Push\",\n            Tool::Cryo => \"Cryoprobe\",\n            Tool::Dressing => \"Dressing\",\n            Tool::Defib => \"Defibrillator\",\n        }\n    }\n    pub fn from_key(k: &str) -> Option<Tool> {\n        Tool::ALL.into_iter().find(|t| t.key() == k)\n    }\n    pub fn from_u8(v: u8) -> Tool {\n        Tool::ALL[(v as usize).min(10)]\n    }\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[repr(u8)]\npub enum Rating {\n    Sloppy = 0,\n    Good = 1,\n    Clean = 2,\n    Immaculate = 3,\n}\n\nimpl Rating {\n    pub fn name(self) -> &'static str {\n        match self {\n            Rating::Sloppy => \"SLOPPY\",\n            Rating::Good => \"GOOD\",\n            Rating::Clean => \"CLEAN\",\n            Rating::Immaculate => \"IMMACULATE\",\n        }\n    }\n    pub fn points(self) -> i64 {\n        match self {\n            Rating::Sloppy => 10,\n            Rating::Good => 120,\n            Rating::Clean => 250,\n            Rating::Immaculate => 400,\n        }\n    }\n    pub fn from_u8(v: u8) -> Rating {\n        match v {\n            3 => Rating::Immaculate,\n            2 => Rating::Clean,\n            1 => Rating::Good,\n            _ => Rating::Sloppy,\n        }\n    }\n    /// Lower is better: `value` (scaled by strictness) against three thresholds.\n    fn grade(value: f32, strict: f32, a: f32, b: f32, c: f32) -> Rating {\n        let v = value * strict;\n        if v <= a {\n            Rating::Immaculate\n        } else if v <= b {\n            Rating::Clean\n        } else if v <= c {\n            Rating::Good\n        } else {\n            Rating::Sloppy\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------------------------\n// Hazards\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]\n#[repr(u8)]\npub enum Kind {\n    #[default]\n    Incision = 0,\n    Lacer = 1,\n    Pool = 2,\n    Bleeder = 3,\n    Object = 4,\n    Polyp = 5,\n    Tumor = 6,\n    Patch = 7,\n    Bone = 8,\n    Closure = 9,\n    Nodule = 10,\n    Sac = 11,\n    Eye = 12,\n    Ember = 13,\n    Furnace = 14,\n    Tendril = 15,\n}\n\nimpl Kind {\n    pub const ALL: [Kind; 16] = [\n        Kind::Incision,\n        Kind::Lacer,\n        Kind::Pool,\n        Kind::Bleeder,\n        Kind::Object,\n        Kind::Polyp,\n        Kind::Tumor,\n        Kind::Patch,\n        Kind::Bone,\n        Kind::Closure,\n        Kind::Nodule,\n        Kind::Sac,\n        Kind::Eye,\n        Kind::Ember,\n        Kind::Furnace,\n        Kind::Tendril,\n    ];\n    pub fn from_u8(v: u8) -> Kind {\n        Kind::ALL[(v as usize).min(15)]\n    }\n    pub fn key(self) -> &'static str {\n        match self {\n            Kind::Incision => \"incision\",\n            Kind::Lacer => \"lacer\",\n            Kind::Pool => \"pool\",\n            Kind::Bleeder => \"bleeder\",\n            Kind::Object => \"object\",\n            Kind::Polyp => \"polyp\",\n            Kind::Tumor => \"tumor\",\n            Kind::Patch => \"patch\",\n            Kind::Bone => \"bone\",\n            Kind::Closure => \"closure\",\n            Kind::Nodule => \"nodule\",\n            Kind::Sac => \"sac\",\n            Kind::Eye => \"eye\",\n            Kind::Ember => \"ember\",\n            Kind::Furnace => \"furnace\",\n            Kind::Tendril => \"tendril\",\n        }\n    }\n}\n\n/// `Hazard::sub` for objects.\npub mod sub {\n    pub const HOOK: u8 = 0;\n    pub const SHARD: u8 = 1;\n    pub const SPLINTER: u8 = 2;\n    /// A piece of a cracked ember: pulling it cools the Fever.\n    pub const COAL: u8 = 3;\n    /// `Patch`: 0 inflammation, 1 burn.\n    pub const BURN: u8 = 1;\n    /// `Pool`: burning fluid from a sac.\n    pub const CAUSTIC: u8 = 1;\n    /// `Nodule`: small and quick, or the Amen.\n    pub const SMALL: u8 = 1;\n    pub const AMEN: u8 = 2;\n    /// `Ember`: two merged, roaming.\n    pub const ROAMING: u8 = 1;\n    /// `Incision`: a stroke across the eye or a Soloist stroke.\n    pub const STROKE: u8 = 1;\n    /// `Incision`: a tether holding the Amen.\n    pub const TETHER: u8 = 2;\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct Hazard {\n    pub id: u32,\n    pub kind: Kind,\n    /// Position; a path's start.\n    pub a: Vec2,\n    /// A path's end; a sac's stem root; a bone's target.\n    pub b: Vec2,\n    /// A path's control point; a grabbed thing's displacement.\n    pub c: Vec2,\n    pub r: f32,\n    /// Progress 0..1 of whatever this hazard is doing or having done.\n    pub prog: f32,\n    pub stage: u8,\n    pub sub: u8,\n    pub ang: f32,\n    pub hidden: bool,\n    /// Seconds left of a Scanner's reveal.\n    pub seen: f32,\n    pub age: f32,\n    /// Seconds left before it does something by itself (0 = none).\n    pub deadline: f32,\n    pub drain: f32,\n    /// Stitches done and needed.\n    pub n: u16,\n    pub need: u16,\n    /// Blocks the phase until it is dealt with.\n    pub blocking: bool,\n    /// Heat or frost held in it (0..1.3).\n    pub fill: f32,\n    /// Seconds a full heat takes (0 = the default).\n    pub fill_time: f32,\n    /// Beats counted toward its next step (fractional: strains clamp their speed-up).\n    pub beats: f32,\n    pub telegraph: bool,\n}\n\nimpl Hazard {\n    pub fn visible(&self) -> bool {\n        !self.hidden || self.seen > 0.0\n    }\n\n    /// A point along this hazard's path, t in 0..1 (incisions and closures: a curve; a tumor\n    /// ring: a circle).\n    pub fn path(&self, t: f32) -> Vec2 {\n        match self.kind {\n            Kind::Tumor => {\n                let a = t * std::f32::consts::TAU - std::f32::consts::FRAC_PI_2;\n                self.a + Vec2::new(a.cos(), a.sin()) * self.r\n            }\n            _ => {\n                let u = 1.0 - t;\n                self.a * (u * u) + self.c * (2.0 * u * t) + self.b * (t * t)\n            }\n        }\n    }\n\n    pub fn has_path(&self) -> bool {\n        matches!(self.kind, Kind::Incision | Kind::Closure) || (self.kind == Kind::Tumor && self.stage == 0)\n    }\n\n    pub fn path_len(&self) -> f32 {\n        let mut l = 0.0;\n        let mut p = self.path(0.0);\n        for k in 1..=16 {\n            let q = self.path(k as f32 / 16.0);\n            l += p.distance(q);\n            p = q;\n        }\n        l\n    }\n\n    /// The instrument this hazard takes now.\n    pub fn takes(&self) -> Option<Tool> {\n        Some(match (self.kind, self.stage) {\n            (Kind::Incision, _) => Tool::Scalpel,\n            (Kind::Lacer | Kind::Bleeder, _) => Tool::Suture,\n            (Kind::Pool, _) => Tool::Suction,\n            (Kind::Object, _) => Tool::Forceps,\n            (Kind::Polyp, _) => Tool::Laser,\n            (Kind::Tumor, 0) => Tool::Scalpel,\n            (Kind::Tumor, 1) => Tool::Forceps,\n            (Kind::Tumor, _) => Tool::Gel,\n            (Kind::Patch, _) => Tool::Gel,\n            (Kind::Bone, 0) => Tool::Forceps,\n            (Kind::Bone, _) => Tool::Suture,\n            (Kind::Closure, _) => Tool::Dressing,\n            (Kind::Nodule, 0) => Tool::Laser,\n            (Kind::Nodule, 1) => Tool::Forceps,\n            (Kind::Nodule, _) => return None, // held by tethers\n            (Kind::Sac, _) => Tool::Laser,\n            (Kind::Eye, 1) => Tool::Forceps,\n            (Kind::Eye, _) => return None,\n            (Kind::Ember, 0) => Tool::Cryo,\n            (Kind::Ember, _) => Tool::Scalpel,\n            (Kind::Furnace, 0) => Tool::Cryo,\n            (Kind::Furnace, 1) => Tool::Scalpel,\n            (Kind::Furnace, 2) => Tool::Forceps,\n            (Kind::Furnace, 3) => Tool::Laser,\n            (Kind::Furnace, 4) => Tool::Suction,\n            (Kind::Furnace, _) => Tool::Gel,\n            (Kind::Tendril, _) => Tool::Forceps,\n        })\n    }\n\n    /// The spot an instrument aims at.\n    pub fn spot(&self) -> Vec2 {\n        match self.kind {\n            Kind::Sac => self.a.lerp(self.b, 0.55),\n            Kind::Lacer | Kind::Bleeder => self.a.lerp(self.b, self.prog.clamp(0.0, 1.0)),\n            Kind::Incision | Kind::Closure => self.path(self.prog),\n            Kind::Tumor if self.stage == 0 => self.path(self.prog),\n            Kind::Bone if self.stage == 1 => self.b,\n            _ => self.a,\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------------------------\n// The heart\n\n#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize)]\npub struct Heart {\n    /// 0..1 through the beat; the R wave is at 0.\n    pub phase: f32,\n    pub bpm: f32,\n    pub beats: u32,\n    /// Beats to a bar of the ECG's meter, and where in the bar this beat is.\n    pub meter: u8,\n    pub bar: u8,\n    /// The R wave happened this tick.\n    pub r_wave: bool,\n    pub stopped: bool,\n}\n\nimpl Heart {\n    pub fn period(&self) -> f32 {\n        60.0 / self.bpm.max(20.0)\n    }\n    /// Seconds from the nearest R wave.\n    pub fn from_r(&self) -> f32 {\n        let p = self.period();\n        (self.phase * p).min((1.0 - self.phase) * p)\n    }\n    /// Systole: the part of the beat when the heart squeezes.\n    pub fn systole(&self) -> bool {\n        self.phase < 0.35\n    }\n}\n\n// ---------------------------------------------------------------------------------------------\n// Surgeons\n\n/// What a slot is engaged with.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum Eng {\n    #[default]\n    None,\n    Cut,\n    Pull,\n    Stitch,\n    Suck,\n    Heat,\n    Paint,\n    Scan,\n    Iv,\n    Dress,\n    Bone,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Slot {\n    pub active: bool,\n    /// Played by the bot (the Case 7 partner, attract).\n    pub bot: bool,\n    /// The cursor the player steers.\n    pub aim: Vec2,\n    /// Where the instrument really is (with a tremor).\n    pub cursor: Vec2,\n    pub held: u8,\n    pub pressed: u8,\n    pub pressure: f32,\n    /// Ring position.\n    pub tool: u8,\n    pub eng: Eng,\n    pub eng_id: u32,\n    pub eng_t: f32,\n    pub eng_a: f32,\n    pub eng_b: f32,\n    pub eng_start: Vec2,\n    /// Which side of the wound the needle was last on.\n    pub side: i8,\n    pub score: i64,\n    pub chain: u32,\n    pub best_chain: u32,\n    pub chain_t: f32,\n    pub gift: f32,\n    /// 0 none, 1 Hush, 2 Echo, 3 Duet.\n    pub gift_kind: u8,\n    pub arming: bool,\n    pub tally: [u32; 4],\n    pub on_beats: u32,\n    pub since_action: f32,\n    /// Gel flow left (0..1).\n    pub flow: f32,\n    pub ping_t: f32,\n    /// Instrument motion for the view: last action's recoil.\n    pub recoil: f32,\n    /// A wrong-instrument flash.\n    pub clink: f32,\n    pub hover: u32,\n    pub charge: f32,\n}\n\n// ---------------------------------------------------------------------------------------------\n// Things left on the field\n\n#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize, PartialEq)]\npub struct Stain {\n    pub at: Vec2,\n    pub r: f32,\n    /// 0 blood, 1 scorch, 2 gel.\n    pub kind: u8,\n}\n\n#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize, PartialEq)]\npub struct Thread {\n    pub a: Vec2,\n    pub b: Vec2,\n    pub n: u16,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize, PartialEq)]\npub struct Float {\n    pub at: Vec2,\n    pub text: String,\n    /// Rating (0..3), 4 = plain.\n    pub rating: u8,\n    pub on_beat: bool,\n    pub slot: u8,\n    pub age: f32,\n}\n\n/// An extracted thing flying to the tray.\n#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize, PartialEq)]\npub struct Flight {\n    pub from: Vec2,\n    pub sub: u8,\n    pub kind: Kind,\n    pub t: f32,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize, PartialEq)]\npub struct Callout {\n    pub who: String,\n    pub text: String,\n    pub age: f32,\n}\n\n#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize, PartialEq)]\npub struct Code {\n    /// Seconds to defibrillate.\n    pub left: f32,\n    pub window: f32,\n    /// 0..1 ghost beat position; it crosses the centre at 0.5.\n    pub ghost: f32,\n    /// A scripted stop's shocks still to land (0 = an ordinary Code).\n    pub shocks: u8,\n    pub scripted: bool,\n    pub last_good: f32,\n}\n\n#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize, PartialEq)]\npub struct Gifts {\n    /// Heartbeats of Hush left.\n    pub hush: f32,\n    /// Seconds of Echo left.\n    pub echo: f32,\n    /// Hush and Echo together.\n    pub duet: bool,\n    pub locked: bool,\n    /// The ghost hands: where they are and how far through an action.\n    pub ghost: Vec2,\n    pub ghost_t: f32,\n    pub ripple: f32,\n}\n\n/// Numbers that come from outside an operation.\n#[derive(Clone, Copy, Debug)]\npub struct Rules {\n    pub tune: Tune,\n    pub diff: Difficulty,\n    pub immortal: bool,\n    pub freeze_timer: bool,\n    pub full_gift: bool,\n    pub one_hit: bool,\n    pub tremor: bool,\n    pub bot_skill: f32,\n    /// The tick, for the bots' noise.\n    pub tick: u64,\n    /// The sim's simulated seconds.\n    pub time: f32,\n}\n\n// ---------------------------------------------------------------------------------------------\n// The operation\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\npub struct Op {\n    pub case: u8,\n    pub phase: u16,\n    pub phase_t: f32,\n    pub phase_beats: u32,\n    pub timer: f32,\n    pub timer_max: f32,\n    pub elapsed: f32,\n    pub vitals: f32,\n    pub heart: Heart,\n    pub hazards: Vec<Hazard>,\n    pub next_id: u32,\n    pub slots: [Slot; 4],\n    pub ring: [Tool; 8],\n    pub plate: u8,\n    pub plate_prev: u8,\n    pub reveal: f32,\n    pub reveal_at: Vec2,\n    pub stains: Vec<Stain>,\n    pub threads: Vec<Thread>,\n    pub floats: Vec<Float>,\n    pub flights: Vec<Flight>,\n    pub callout: Option<Callout>,\n    pub say_done: u32,\n    pub trig_done: u32,\n    pub banner: String,\n    pub banner_t: f32,\n    pub mistakes: u32,\n    pub codes_left: u8,\n    pub code: Option<Code>,\n    pub gifts: Gifts,\n    pub strain: Option<super::strain::Strain>,\n    pub fever: Option<f32>,\n    /// A heat ring's radius while it sweeps; seconds until the next one when counting in.\n    pub heat_ring: Option<f32>,\n    pub ring_warn: f32,\n    pub linger: f32,\n    pub lingering: bool,\n    pub iv_cd: f32,\n    pub rng: Rng,\n    pub won: bool,\n    pub dead: bool,\n    pub shake: f32,\n    pub flash: f32,\n    /// The camera leans in for a moment.\n    pub push: f32,\n    pub crit_called: bool,\n    pub callout_cd: f32,\n    pub time_scale: f32,\n    #[serde(skip)]\n    pub ev: Vec<SimEvent>,\n    pub cov: Vec<u32>,\n    pub checkpoint: Option<Box<Op>>,\n    /// Attract: the bot wins nothing, it only shows.\n    pub showing: bool,\n}\n\npub fn v3(p: Vec2) -> Vec3 {\n    Vec3::new(p.x, 0.3, p.y)\n}\n\nimpl Op {\n    pub fn new(case: usize, rules: &Rules, seed: u64) -> Op {\n        let c = content();\n        let data = &c.cases[case];\n        let mut ring = Tool::DEFAULT_RING;\n        if data.ring.len() == 8 {\n            for (k, t) in data.ring.iter().enumerate() {\n                if let Some(t) = Tool::from_key(t) {\n                    ring[k] = t;\n                }\n            }\n        }\n        let plate = plate_id(&c, &data.plate);\n        let timer = data.timer * rules.tune.timer * rules.diff.timer();\n        let mut slots: [Slot; 4] = Default::default();\n        let (gift0, locked) = match data.gift.as_str() {\n            \"hush\" => (1, data.gift_locked),\n            \"echo\" => (2, data.gift_locked),\n            \"duet\" => (3, false),\n            _ => (0, false),\n        };\n        for (i, s) in slots.iter_mut().enumerate() {\n            s.flow = 1.0;\n            s.aim = Vec2::new(-1.0 + i as f32 * 0.8, 0.5);\n            s.cursor = s.aim;\n            s.gift_kind = if case == super::content::CODE_BLUE { (i % 2 + 1) as u8 } else { gift0 };\n        }\n        slots[0].active = true;\n        let mut op = Op {\n            case: case as u8,\n            phase: 0,\n            phase_t: 0.0,\n            phase_beats: 0,\n            timer,\n            timer_max: timer,\n            elapsed: 0.0,\n            vitals: if data.vitals > 0.0 { data.vitals } else { 100.0 },\n            heart: Heart { phase: 0.0, bpm: 72.0, beats: 0, meter: 4, bar: 0, r_wave: false, stopped: false },\n            hazards: Vec::new(),\n            next_id: 1,\n            slots,\n            ring,\n            plate,\n            plate_prev: plate,\n            reveal: 1.0,\n            reveal_at: Vec2::ZERO,\n            stains: Vec::new(),\n            threads: Vec::new(),\n            floats: Vec::new(),\n            flights: Vec::new(),\n            callout: None,\n            say_done: 0,\n            trig_done: 0,\n            banner: String::new(),\n            banner_t: 0.0,\n            mistakes: 0,\n            codes_left: rules.diff.codes(),\n            code: None,\n            gifts: Gifts { locked, ghost: Vec2::new(0.0, -2.0), ..Default::default() },\n            strain: None,\n            fever: None,\n            heat_ring: None,\n            ring_warn: 0.0,\n            linger: 0.0,\n            lingering: false,\n            iv_cd: 0.0,\n            rng: Rng::new(seed ^ 0x51_72_47),\n            won: false,\n            dead: false,\n            shake: 0.0,\n            flash: 0.0,\n            push: 0.0,\n            crit_called: false,\n            callout_cd: 0.0,\n            time_scale: 1.0,\n            ev: Vec::new(),\n            cov: vec![0; super::cover::NAMES.len()],\n            checkpoint: None,\n            showing: false,\n        };\n        op.enter_phase(0, rules);\n        op\n    }\n\n    pub fn cue(&mut self, id: u16, at: Vec2, gain: f32, pitch: f32) {\n        self.ev.push(SimEvent::Cue { id, pos: v3(at), gain, pitch });\n    }\n\n    pub fn mark(&mut self, name: &str) {\n        super::cover::mark(&mut self.cov, name);\n    }\n\n    pub fn say(&mut self, who: &str, text: &str) {\n        self.callout = Some(Callout { who: who.to_string(), text: text.to_string(), age: 0.0 });\n    }\n\n    /// A callout from the table (`callouts.toml`), not too often.\n    pub fn call(&mut self, key: &str) {\n        if self.callout_cd > 0.0 {\n            return;\n        }\n        let c = content();\n        if let Some(entry) = c.callouts.get(key) {\n            if !entry.text.is_empty() {\n                let k = self.rng.below(entry.text.len() as u32) as usize;\n                let (who, text) = (entry.who.clone(), entry.text[k].clone());\n                // With the scrub nurse on the table, the anaesthesiologist calls it.\n                let who = if self.case == 7 && who == \"bashir\" { \"teddy\".to_string() } else { who };\n                self.say(&who, &text);\n                self.callout_cd = 3.0;\n            }\n        }\n    }\n\n    pub fn set_banner(&mut self, text: &str) {\n        self.banner = text.to_string();\n        self.banner_t = 0.0;\n        self.cue(cue::BANNER, Vec2::ZERO, 1.0, 1.0);\n    }\n\n    // -----------------------------------------------------------------------------------------\n    // Spawning\n\n    pub fn add(&mut self, mut h: Hazard) -> u32 {\n        h.id = self.next_id;\n        self.next_id += 1;\n        let id = h.id;\n        self.mark(&format!(\"hazard:{}\", h.kind.key()));\n        self.hazards.push(h);\n        id\n    }\n\n    pub fn spawn_spec(&mut self, s: &SpawnSpec) {\n        let a = s.a.map(|p| Vec2::new(p[0], p[1])).unwrap_or(Vec2::ZERO);\n        let b = s.b.map(|p| Vec2::new(p[0], p[1])).unwrap_or(a + Vec2::new(2.0, 0.0));\n        let mut h = Hazard {\n            a,\n            b,\n            c: s.c.map(|p| Vec2::new(p[0], p[1])).unwrap_or((a + b) * 0.5),\n            r: s.r.unwrap_or(1.0),\n            ang: s.ang.unwrap_or(0.0).to_radians(),\n            hidden: s.hidden,\n            sub: s.sub,\n            stage: s.stage,\n            blocking: !s.optional,\n            ..Default::default()\n        };\n        match s.kind.as_str() {\n            \"incision\" => {\n                h.kind = Kind::Incision;\n            }\n            \"closure\" => {\n                h.kind = Kind::Closure;\n            }\n            \"lacer\" => {\n                h.kind = Kind::Lacer;\n                h.drain = 0.6;\n                h.need = stitches_for(a.distance(b));\n            }\n            \"bleeder\" => {\n                h.kind = Kind::Bleeder;\n                h.drain = 3.0;\n                h.need = 3;\n                let d = Vec2::from_angle(h.ang) * 0.7;\n                h.b = a + d;\n                h.a = a - d;\n            }\n            \"pool\" => {\n                h.kind = Kind::Pool;\n            }\n            \"object\" => {\n                h.kind = Kind::Object;\n                h.drain = 0.2;\n                h.r = s.r.unwrap_or(0.45);\n            }\n            \"polyp\" => {\n                h.kind = Kind::Polyp;\n                h.drain = 0.1;\n                h.r = s.r.unwrap_or(0.5);\n            }\n            \"tumor\" => {\n                h.kind = Kind::Tumor;\n                h.drain = 0.4;\n                h.r = s.r.unwrap_or(1.3);\n            }\n            \"patch\" => {\n                h.kind = Kind::Patch;\n                h.drain = 0.2;\n            }\n            \"burn\" => {\n                h.kind = Kind::Patch;\n                h.sub = sub::BURN;\n                h.drain = 0.2;\n            }\n            \"bone\" => {\n                h.kind = Kind::Bone;\n                h.r = s.r.unwrap_or(0.9);\n                h.need = 2;\n            }\n            _ => return,\n        }\n        if let Some(d) = s.drain {\n            h.drain = d;\n        }\n        self.add(h);\n    }\n\n    pub fn find(&self, id: u32) -> Option<usize> {\n        self.hazards.iter().position(|h| h.id == id)\n    }\n\n    fn remove(&mut self, id: u32) -> Option<Hazard> {\n        self.find(id).map(|i| self.hazards.remove(i))\n    }\n\n    // -----------------------------------------------------------------------------------------\n    // The phase machine\n\n    pub fn enter_phase(&mut self, k: usize, rules: &Rules) {\n        let c = content();\n        let case = &c.cases[self.case as usize];\n        let Some(p) = case.phase.get(k) else {\n            self.won = true;\n            return;\n        };\n        self.phase = k as u16;\n        self.phase_t = 0.0;\n        self.phase_beats = 0;\n        self.say_done = 0;\n        self.trig_done = 0;\n        self.lingering = false;\n        self.linger = 0.0;\n        if let Some(m) = p.meter {\n            self.heart.meter = m;\n            self.heart.bar = 0;\n        }\n        if let Some(r) = &p.reveal_plate {\n            self.plate_prev = self.plate;\n            self.plate = plate_id(&c, r);\n            self.reveal = 0.0;\n            self.push = 1.0;\n            self.stains.clear();\n            self.threads.clear();\n            self.cue(cue::SQUISH, self.reveal_at, 1.0, 0.7);\n        }\n        if let Some(b) = &p.banner {\n            let b = b.clone();\n            self.set_banner(&b);\n        }\n        if p.checkpoint {\n            let mut copy = self.clone();\n            copy.checkpoint = None;\n            copy.ev = Vec::new();\n            self.checkpoint = Some(Box::new(copy));\n        }\n        for s in &p.spawn {\n            self.spawn_spec(s);\n        }\n        if let Some(name) = &p.strain {\n            self.strain = Some(super::strain::Strain::start(name, &p.params));\n            self.start_strain(rules);\n            self.mark(&format!(\"strain:{name}\"));\n        }\n        if p.code_shocks > 0 {\n            self.start_code(p.code_shocks, rules);\n        }\n        self.mark(&format!(\"phase:{}:{}\", self.case, k.min(15)));\n    }\n\n    /// Restores the last checkpoint (or the case's start, when there is none). Under 2 seconds:\n    /// it is instant.\n    pub fn retry_checkpoint(&mut self, rules: &Rules) -> bool {\n        if let Some(cp) = self.checkpoint.take() {\n            let cov = std::mem::take(&mut self.cov);\n            let mut op = (*cp).clone();\n            op.checkpoint = Some(cp);\n            op.cov = cov;\n            op.dead = false;\n            op.banner.clear();\n            *self = op;\n            let _ = rules;\n            true\n        } else {\n            false\n        }\n    }\n\n    /// The hazards still holding the phase open.\n    pub fn blockers(&self) -> usize {\n        self.hazards.iter().filter(|h| h.blocking).count()\n    }\n\n    fn phase_tick(&mut self, dt: f32, rules: &Rules) {\n        let c = content();\n        let case = &c.cases[self.case as usize];\n        let Some(p) = case.phase.get(self.phase as usize) else { return };\n        self.phase_t += dt;\n        for (k, s) in p.say.iter().enumerate() {\n            if self.say_done & (1 << k) == 0 && self.phase_t >= s.at {\n                self.say_done |= 1 << k;\n                self.say(&s.who, &s.text);\n            }\n        }\n        let mut hold = false;\n        for (k, t) in p.trigger.iter().enumerate() {\n            if self.trig_done & (1 << k) != 0 {\n                continue;\n            }\n            let strain_done = self.strain.is_none();\n            let fire = t.at_time.is_some_and(|x| self.phase_t >= x)\n                || t.vitals_below.is_some_and(|x| self.vitals < x)\n                || t.on_beat.is_some_and(|x| self.phase_beats >= x)\n                || (t.on_clear && self.blockers() == 0 && strain_done && self.code.is_none());\n            if fire {\n                self.trig_done |= 1 << k;\n                for s in &t.spawn {\n                    self.spawn_spec(s);\n                }\n                for s in &t.say {\n                    self.say(&s.who, &s.text);\n                }\n                if let Some(id) = t.cue.as_deref().and_then(cue::id) {\n                    self.cue(id, Vec2::ZERO, 1.0, 1.0);\n                }\n                if let Some(b) = &t.banner {\n                    self.set_banner(b);\n                }\n                if t.on_clear {\n                    hold = true;\n                }\n            }\n        }\n        if hold || self.code.is_some() || self.strain.is_some() || self.blockers() > 0 {\n            return;\n        }\n        // Clear: a moment of drama, then the next phase.\n        if !self.lingering {\n            self.lingering = true;\n            self.linger = p.linger.max(0.35);\n        }\n        self.linger -= dt;\n        if self.linger <= 0.0 {\n            if let Some(h) = self.hazards.iter().rev().find(|h| h.has_path()) {\n                self.reveal_at = h.b;\n            }\n            let next = self.phase as usize + 1;\n            if next >= case.phase.len() {\n                self.won = true;\n            } else {\n                self.enter_phase(next, rules);\n            }\n        }\n    }\n\n    // -----------------------------------------------------------------------------------------\n    // One tick\n\n    pub fn tick(&mut self, inputs: &[SurgeonInput; 4], rules: &Rules, dt: f32) {\n        // The world slows inside a Hush; hands never do.\n        let hushed = self.gifts.hush > 0.0;\n        let scale = if hushed { rules.tune.hush_scale.clamp(0.05, 1.0) } else { 1.0 };\n        self.time_scale = scale;\n        let world = dt * scale;\n        self.elapsed += dt;\n        self.banner_t += dt;\n        self.callout_cd = (self.callout_cd - dt).max(0.0);\n        self.shake = (self.shake - dt * 2.5).max(0.0);\n        self.flash = (self.flash - dt * 3.0).max(0.0);\n        self.push = (self.push - dt * 0.8).max(0.0);\n        self.reveal = (self.reveal + dt / 0.8).min(1.0);\n        self.iv_cd = (self.iv_cd - world).max(0.0);\n        self.gifts.ripple = (self.gifts.ripple - dt * 1.5).max(0.0);\n        if let Some(c) = &mut self.callout {\n            c.age += dt;\n            if c.age > 4.5 {\n                self.callout = None;\n            }\n        }\n        for f in &mut self.floats {\n            f.age += dt;\n        }\n        self.floats.retain(|f| f.age < 1.5);\n        for f in &mut self.flights {\n            f.t += dt * 1.6;\n        }\n        self.flights.retain(|f| f.t < 1.0);\n\n        self.apply_inputs(inputs, rules, dt);\n        self.heart_tick(rules, dt, scale);\n        self.gift_tick(rules, dt);\n\n        if !self.heart.stopped || self.code.is_none() {\n            if !rules.freeze_timer {\n                self.timer -= world;\n            }\n            if self.timer <= 0.0 && !self.showing {\n                if self.is_director_case() {\n                    // Code Blue: the team held on.\n                    self.won = true;\n                    return;\n                }\n                if !rules.immortal {\n                    self.timer = 0.0;\n                    self.dead = true;\n                    self.mark(\"death:time\");\n                    return;\n                }\n                self.timer = self.timer_max;\n            }\n        }\n\n        // Tools run for each surgeon, in seat order.\n        for i in 0..4 {\n            if self.slots[i].active {\n                self.tool_tick(i, rules, dt, world);\n            }\n        }\n        self.ghost_tick(rules, dt);\n        if self.code.is_none() {\n            self.hazards_tick(world, rules);\n            self.strain_tick(world, rules);\n            self.drain_tick(world, rules);\n        }\n        self.code_tick(rules, dt);\n        if self.code.is_none() {\n            self.phase_tick(dt, rules);\n        }\n        self.fx_limits();\n    }\n\n    pub fn is_director_case(&self) -> bool {\n        self.case as usize == super::content::CODE_BLUE\n    }\n\n    fn fx_limits(&mut self) {\n        let n = self.stains.len();\n        if n > 40 {\n            self.stains.drain(..n - 40);\n        }\n        let n = self.threads.len();\n        if n > 24 {\n            self.threads.drain(..n - 24);\n        }\n    }\n\n    fn apply_inputs(&mut self, inputs: &[SurgeonInput; 4], rules: &Rules, dt: f32) {\n        let time = rules.time;\n        for i in 0..4 {\n            let inp = inputs[i];\n            let s = &mut self.slots[i];\n            if !inp.active && !s.bot && i > 0 {\n                s.held = 0;\n                s.pressed = 0;\n                continue;\n            }\n            if inp.active {\n                s.active = true;\n            }\n            s.held = inp.held;\n            s.pressed = inp.pressed | (inp.held & !s.held & 0);\n            s.pressure = if inp.pressure > 0.0 { inp.pressure } else if inp.held & btn::USE != 0 { 1.0 } else { 0.0 };\n            if inp.tool > 0 && inp.tool <= 8 {\n                self.select(i, inp.tool - 1);\n            }\n            if inp.cycle != 0 {\n                let t = (self.slots[i].tool as i32 + inp.cycle as i32).rem_euclid(8) as u8;\n                self.select(i, t);\n            }\n            if inp.abs {\n                self.slots[i].aim = inp.aim;\n            } else if inp.aim != Vec2::ZERO {\n                self.stick_move(i, inp.aim, rules, dt);\n            }\n            let s = &mut self.slots[i];\n            s.aim = s.aim.clamp(Vec2::new(-10.6, -5.6), Vec2::new(10.6, 5.9));\n            // Pet's tremor: a slow wander, gone in Precision and during the Echo.\n            let tremor = s.gift_kind == 2\n                && rules.tremor\n                && s.held & btn::PRECISION == 0\n                && self.gifts.echo <= 0.0\n                && self.is_pet_case();\n            let wander = if tremor {\n                Vec2::new((time * 3.1 + i as f32).sin() + (time * 7.3).sin() * 0.5, (time * 4.3).cos() + (time * 5.9).sin() * 0.5)\n                    * 0.08\n            } else {\n                Vec2::ZERO\n            };\n            s.cursor = s.aim + wander;\n            s.recoil = (s.recoil - dt * 4.0).max(0.0);\n            s.clink = (s.clink - dt * 3.0).max(0.0);\n            s.since_action += dt;\n            if s.chain > 0 {\n                s.chain_t += dt;\n                if s.chain_t > rules.tune.chain_window {\n                    s.chain = 0;\n                }\n            }\n            s.hover = 0;\n        }\n        for i in 0..4 {\n            if self.slots[i].active {\n                let tool = self.tool_of(i);\n                let p = self.slots[i].cursor;\n                self.slots[i].hover = self.target_near(tool, p, 1.0, i).map(|k| self.hazards[k].id).unwrap_or(0);\n            }\n        }\n    }\n\n    pub fn is_pet_case(&self) -> bool {\n        let c = content();\n        c.cases[self.case as usize].surgeon == \"pet\"\n    }\n\n    pub fn select(&mut self, i: usize, ring_pos: u8) {\n        if self.slots[i].tool != ring_pos {\n            self.release(i);\n            self.slots[i].tool = ring_pos;\n            let p = self.slots[i].cursor;\n            self.cue(cue::TOOL_PICK, p, 0.8, 1.0 + ring_pos as f32 * 0.04);\n        }\n    }\n\n    /// Drops what the hand holds.\n    fn release(&mut self, i: usize) {\n        let s = &mut self.slots[i];\n        let id = s.eng_id;\n        s.eng = Eng::None;\n        s.eng_id = 0;\n        s.eng_a = 0.0;\n        s.eng_b = 0.0;\n        if let Some(k) = self.find(id) {\n            let h = &mut self.hazards[k];\n            if h.kind != Kind::Bone && h.kind != Kind::Tendril {\n                h.c = if h.has_path() { h.c } else { Vec2::ZERO };\n            }\n        }\n    }\n\n    /// Stick steering: speed curve, Precision, and aim assist (slowdown and pull near a valid\n    /// target, a rail along a cut, the needle's creep along a wound).\n    fn stick_move(&mut self, i: usize, stick: Vec2, rules: &Rules, dt: f32) {\n        let s = &self.slots[i];\n        let (aim, eng, eng_id, tool, held) = (s.aim, s.eng, s.eng_id, self.tool_of(i), s.held);\n        let mag = stick.length().min(1.0);\n        let dir = stick.normalize_or_zero();\n        let mut speed = 15.0 * mag.powf(2.2) * rules.tune.cursor_speed;\n        if held & btn::PRECISION != 0 {\n            speed *= 0.35;\n        }\n        let assist = rules.tune.aim_assist;\n        let mut pull = Vec2::ZERO;\n        if assist > 0.0 {\n            if let Some(k) = self.target_near(tool, aim, 1.2, i) {\n                let spot = self.hazards[k].spot();\n                let d = spot.distance(aim);\n                let t = 1.0 - (d / 1.2).clamp(0.0, 1.0);\n                speed *= 1.0 - 0.5 * assist * t;\n                pull = (spot - aim).normalize_or_zero() * (3.0 * assist * t) * dt;\n            }\n        }\n        let mut next = aim + dir * speed * dt + pull;\n        if assist > 0.0 {\n            if let Some(h) = self.find(eng_id).map(|k| &self.hazards[k]) {\n                match eng {\n                    Eng::Cut | Eng::Dress => {\n                        // Rail: sideways error is damped.\n                        let (near, _) = nearest_on_path(h, h.prog, 0.3, next);\n                        next += (near - next) * (0.25 * assist);\n                    }\n                    Eng::Stitch => {\n                        // The needle creeps along by itself, so the stick only flicks across it.\n                        let (ax, along, _) = wound_frame(h, next);\n                        let want = h.a.distance(h.b) * h.prog + 0.1;\n                        next += ax * (want - along).clamp(-1.0, 1.0) * (8.0 * assist * dt);\n                    }\n                    _ => {}\n                }\n            }\n        }\n        self.slots[i].aim = next;\n    }\n\n    fn heart_tick(&mut self, rules: &Rules, dt: f32, scale: f32) {\n        let coupling = rules.tune.coupling;\n        let want = 72.0 + (148.0 - 72.0) * (1.0 - self.vitals / 100.0).clamp(0.0, 1.0) * coupling;\n        let h = &mut self.heart;\n        h.bpm += (want.clamp(40.0, 200.0) - h.bpm) * (1.0 - (-dt * 1.5).exp());\n        h.r_wave = false;\n        if h.stopped {\n            return;\n        }\n        // Inside a Hush the heart slows, but less than the world: it is what the player counts.\n        let rate = if scale < 1.0 { 0.5 } else { 1.0 };\n        h.phase += dt * rate / h.period();\n        if h.phase >= 1.0 {\n            h.phase -= 1.0;\n            h.beats += 1;\n            h.r_wave = true;\n            h.bar = (h.bar + 1) % h.meter.max(1);\n            self.phase_beats += 1;\n            let accent = if h.bar == 0 { 1.0 } else { 0.7 };\n            self.cue(cue::LUB, Vec2::ZERO, accent, 1.0);\n            self.cue(cue::MONITOR, Vec2::ZERO, 0.5, if self.heart.bar == 0 { 1.2 } else { 1.0 });\n            if self.gifts.hush > 0.0 {\n                self.gifts.hush -= 1.0 / rules.tune.gift_dur.max(0.1);\n                if self.gifts.hush <= 0.0 {\n                    self.gifts.duet = self.gifts.echo > 0.0;\n                }\n            }\n        }\n    }\n\n    fn drain_tick(&mut self, world: f32, rules: &Rules) {\n        let mut d = 0.0;\n        for h in &self.hazards {\n            d += match h.kind {\n                Kind::Pool => (0.2 + h.drain) * std::f32::consts::PI * h.r * h.r,\n                _ => h.drain,\n            };\n        }\n        if let Some(f) = self.fever {\n            if f > 100.0 {\n                d += 6.0;\n            }\n        }\n        let before = self.vitals;\n        self.vitals -= d * world * rules.tune.drain * rules.diff.drain();\n        if before >= 40.0 && self.vitals < 40.0 {\n            self.call(\"vitals_low\");\n            if !self.crit_called {\n                self.crit_called = true;\n                self.set_banner(\"VITALS CRITICAL\");\n                self.cue(cue::ALARM, Vec2::ZERO, 1.0, 1.0);\n            }\n        }\n        if self.vitals > 55.0 {\n            self.crit_called = false;\n        }\n        if self.vitals <= 0.0 {\n            self.vitals = 0.0;\n            if rules.immortal {\n                self.vitals = 60.0;\n            } else if self.codes_left > 0 {\n                self.codes_left -= 1;\n                self.start_code(0, rules);\n            } else {\n                self.dead = true;\n                self.mark(\"death:vitals\");\n            }\n        }\n    }\n\n    pub fn start_code(&mut self, shocks: u8, rules: &Rules) {\n        let window = rules.tune.code_window;\n        self.code = Some(Code { left: window, window, ghost: 0.0, shocks, scripted: shocks > 0, last_good: 0.0 });\n        self.heart.stopped = true;\n        self.mark(\"code\");\n        if shocks > 0 {\n            self.mark(\"code:scripted\");\n        }\n        self.set_banner(\"CODE\");\n        self.cue(cue::FLATLINE, Vec2::ZERO, 1.0, 1.0);\n        self.shake = 0.6;\n        self.push = 1.0;\n        for s in &mut self.slots {\n            s.eng = Eng::None;\n            s.eng_id = 0;\n        }\n    }\n\n    fn code_tick(&mut self, rules: &Rules, dt: f32) {\n        let Some(mut c) = self.code else { return };\n        c.left -= dt;\n        c.ghost = (c.ghost + dt / 0.9).fract();\n        c.last_good = (c.last_good - dt).max(0.0);\n        let mut landed = false;\n        let mut missed = false;\n        for i in 0..4 {\n            if !self.slots[i].active {\n                continue;\n            }\n            let s = &mut self.slots[i];\n            let holding = s.held & btn::DEFIB != 0;\n            if holding {\n                let before = s.charge;\n                s.charge = (s.charge + dt / 1.2).min(1.0);\n                if before == 0.0 {\n                    self.ev.push(SimEvent::Cue { id: cue::DEFIB_WHINE, pos: Vec3::ZERO, gain: 1.0, pitch: 1.0 });\n                }\n            } else if s.charge > 0.0 {\n                // Let go: on the ghost beat, or nothing.\n                let good = s.charge >= 1.0 && (c.ghost - 0.5).abs() * 0.9 <= 0.2;\n                s.charge = 0.0;\n                if good {\n                    landed = true;\n                } else {\n                    missed = true;\n                }\n            }\n        }\n        if missed {\n            self.cue(cue::CLINK, Vec2::ZERO, 1.0, 0.7);\n        }\n        if landed {\n            self.cue(cue::DEFIB_THUMP, Vec2::ZERO, 1.0, 1.0);\n            self.shake = 1.0;\n            self.flash = 1.0;\n            self.mark(\"tool:defib\");\n            self.award(0, Vec2::ZERO, Tool::Defib, Rating::Clean, rules);\n            if c.shocks > 1 {\n                c.shocks -= 1;\n                c.left = c.window;\n                c.last_good = 1.0;\n                self.code = Some(c);\n                self.say(\"teddy\", \"Again! Charge it again!\");\n                return;\n            }\n            self.code = None;\n            self.heart.stopped = false;\n            self.heart.phase = 0.0;\n            if !c.scripted {\n                self.vitals = 30.0;\n            } else {\n                self.vitals = self.vitals.max(45.0);\n            }\n            self.cue(cue::LUB, Vec2::ZERO, 1.0, 1.0);\n            return;\n        }\n        if c.left <= 0.0 {\n            if rules.immortal {\n                self.code = None;\n                self.heart.stopped = false;\n                self.vitals = 60.0;\n                return;\n            }\n            self.dead = true;\n            self.code = None;\n            self.mark(\"death:code\");\n            return;\n        }\n        self.code = Some(c);\n    }\n\n    // -----------------------------------------------------------------------------------------\n    // Hazard behaviour\n\n    fn hazards_tick(&mut self, world: f32, _rules: &Rules) {\n        let mut feed = 0.0;\n        for h in &mut self.hazards {\n            h.age += world;\n            if h.seen > 0.0 {\n                h.seen -= world;\n            }\n            match h.kind {\n                Kind::Lacer | Kind::Bleeder => feed += h.drain * world,\n                Kind::Patch | Kind::Polyp | Kind::Nodule | Kind::Sac | Kind::Ember | Kind::Furnace => {}\n                _ => {}\n            }\n            // Heat that nobody is holding fades.\n            if h.fill > 0.0 && !matches!(h.kind, Kind::Bone) {\n                h.fill = (h.fill - world * 0.25).max(0.0);\n            }\n        }\n        // Open wounds feed pools.\n        if feed > 0.0 {\n            let wound = self\n                .hazards\n                .iter()\n                .filter(|h| matches!(h.kind, Kind::Lacer | Kind::Bleeder))\n                .map(|h| h.a.lerp(h.b, 0.5))\n                .next();\n            if let Some(at) = wound {\n                let near = self.hazards.iter().position(|h| h.kind == Kind::Pool && h.a.distance(at) < h.r + 1.0);\n                match near {\n                    Some(k) => {\n                        let p = &mut self.hazards[k];\n                        p.r = (p.r + feed * 0.03).min(1.7);\n                    }\n                    None => {\n                        if self.pool_count() < 4 && self.rng.f32() < feed * 0.06 {\n                            let offset = Vec2::new(self.rng.range(-0.5, 0.5), self.rng.range(-0.4, 0.4));\n                            self.add(Hazard { kind: Kind::Pool, a: at + offset, r: 0.42, blocking: false, ..Default::default() });\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    fn pool_count(&self) -> usize {\n        self.hazards.iter().filter(|h| h.kind == Kind::Pool).count()\n    }\n\n    pub fn covered(&self, h: &Hazard) -> bool {\n        h.kind != Kind::Pool\n            && !matches!(h.kind, Kind::Incision | Kind::Closure | Kind::Sac | Kind::Eye)\n            && self.hazards.iter().any(|p| p.kind == Kind::Pool && p.a.distance(h.spot()) < p.r * 0.85)\n    }\n\n    /// Can `tool` act on this hazard now?\n    pub fn valid(&self, h: &Hazard, tool: Tool) -> bool {\n        if !h.visible() || self.covered(h) {\n            return false;\n        }\n        if h.kind == Kind::Sac {\n            return tool == Tool::Laser || tool == Tool::Suction;\n        }\n        h.takes() == Some(tool)\n    }\n\n    /// The nearest hazard `tool` can act on within `reach` of `p`, not held by another surgeon.\n    pub fn target_near(&self, tool: Tool, p: Vec2, reach: f32, me: usize) -> Option<usize> {\n        let mut best: Option<(usize, f32)> = None;\n        for (k, h) in self.hazards.iter().enumerate() {\n            if !self.valid(h, tool) || self.held_by_other(h.id, me) {\n                continue;\n            }\n            let d = self.dist_to(h, tool, p);\n            if d <= reach + hit_slop(h) && best.is_none_or(|(_, b)| d < b) {\n                best = Some((k, d));\n            }\n        }\n        best.map(|(k, _)| k)\n    }\n\n    pub fn held_by_other(&self, id: u32, me: usize) -> bool {\n        self.slots.iter().enumerate().any(|(i, s)| i != me && s.active && s.eng_id == id && s.eng != Eng::None)\n    }\n\n    pub fn dist_to(&self, h: &Hazard, tool: Tool, p: Vec2) -> f32 {\n        match h.kind {\n            Kind::Lacer | Kind::Bleeder => dist_segment(p, h.a, h.b),\n            Kind::Sac if tool == Tool::Suction => (p.distance(h.a) - h.r).max(0.0),\n            Kind::Bone if h.stage == 1 => p.distance(h.b),\n            Kind::Pool | Kind::Patch => (p.distance(h.a) - h.r).max(0.0),\n            _ if h.has_path() => p.distance(h.spot()),\n            _ => p.distance(h.spot()),\n        }\n    }\n\n    pub fn tool_of(&self, i: usize) -> Tool {\n        if self.code.is_some() {\n            return Tool::Defib;\n        }\n        // The closing dressing comes to hand by itself when it is all that's left.\n        if self.hazards.iter().any(|h| h.kind == Kind::Closure)\n            && !self.hazards.iter().any(|h| h.kind != Kind::Closure && h.blocking)\n        {\n            return Tool::Dressing;\n        }\n        self.ring[(self.slots[i].tool as usize).min(7)]\n    }\n\n    // -----------------------------------------------------------------------------------------\n    // Instruments\n\n    fn wrong_tool(&mut self, i: usize, rules: &Rules) {\n        let s = &mut self.slots[i];\n        if s.clink > 0.2 {\n            return;\n        }\n        s.chain = 0;\n        s.clink = 1.0;\n        let p = s.cursor;\n        self.cue(cue::CLINK, p, 1.0, 1.0);\n        self.call(\"wrong_tool\");\n        self.vitals -= rules.tune.wrong_penalty;\n        self.mark(\"wrong_tool\");\n    }\n\n    /// A slip: a small laceration here.\n    fn lacerate(&mut self, at: Vec2, ang: f32, rules: &Rules) {\n        let d = Vec2::from_angle(ang) * 0.6;\n        let h = Hazard {\n            kind: Kind::Lacer,\n            a: at - d,\n            b: at + d,\n            drain: 0.6,\n            need: 3,\n            blocking: false,\n            ..Default::default()\n        };\n        self.add(h);\n        self.mistakes += 1;\n        self.vitals -= 2.0 * rules.diff.drain();\n        self.shake = self.shake.max(0.3);\n        self.cue(cue::TEAR, at, 1.0, 1.0);\n        self.mark(\"mistake:lacerate\");\n    }\n\n    fn burn_at(&mut self, at: Vec2) {\n        let h = Hazard { kind: Kind::Patch, sub: sub::BURN, a: at, r: 0.7, drain: 0.25, blocking: false, ..Default::default() };\n        self.add(h);\n        self.mistakes += 1;\n        self.cue(cue::SIZZLE, at, 1.0, 0.8);\n        self.mark(\"mistake:burn\");\n    }\n\n    fn tool_tick(&mut self, i: usize, rules: &Rules, dt: f32, world: f32) {\n        if self.code.is_some() {\n            return;\n        }\n        let tool = self.tool_of(i);\n        let s = &self.slots[i];\n        let held = s.held & btn::USE != 0;\n        let pressed = s.pressed & btn::USE != 0 || (held && s.eng == Eng::None && tool_is_continuous(tool));\n        let p = s.cursor;\n        let cancel = s.held & btn::CANCEL != 0;\n        if cancel {\n            self.release(i);\n            return;\n        }\n        // The gel's flow refills whenever the trigger is up.\n        if tool != Tool::Gel || !held {\n            let s = &mut self.slots[i];\n            s.flow = (s.flow + dt / 2.0).min(1.0);\n        }\n        // Heat rings scorch a hand that stays down.\n        if held {\n            if let Some(radius) = self.heat_ring {\n                let d = p.length();\n                if (d - radius).abs() < 0.55 {\n                    self.scorch(i, rules);\n                    return;\n                }\n            }\n        }\n        self.slots[i].eng_t += dt;\n        match tool {\n            Tool::Scalpel | Tool::Dressing => self.cut_tick(i, tool, held, pressed, rules),\n            Tool::Forceps => self.forceps_tick(i, held, pressed, rules, dt),\n            Tool::Suture => self.suture_tick(i, held, pressed, rules),\n            Tool::Suction => self.suction_tick(i, held, rules, world.max(dt * 0.6)),\n            Tool::Laser | Tool::Cryo => self.heat_tick(i, tool, held, rules, dt),\n            Tool::Gel => self.gel_tick(i, held, rules, dt),\n            Tool::Scanner => self.scanner_tick(i, held, dt),\n            Tool::Iv => self.iv_tick(i, held, rules, dt),\n            Tool::Defib => {}\n        }\n    }\n\n    fn scorch(&mut self, i: usize, rules: &Rules) {\n        let p = self.slots[i].cursor;\n        if self.slots[i].clink > 0.0 {\n            return;\n        }\n        self.release(i);\n        let s = &mut self.slots[i];\n        s.chain = 0;\n        s.clink = 1.0;\n        self.vitals -= 2.0 * rules.diff.drain();\n        self.burn_at(p);\n        self.call(\"lift_off\");\n        self.mark(\"scorch\");\n    }\n\n    fn cut_tick(&mut self, i: usize, tool: Tool, held: bool, pressed: bool, rules: &Rules) {\n        let s = &self.slots[i];\n        let (p, eng, eng_id) = (s.cursor, s.eng, s.eng_id);\n        let want = if tool == Tool::Dressing { Eng::Dress } else { Eng::Cut };\n        if eng == want {\n            let Some(k) = self.find(eng_id) else {\n                self.release(i);\n                return;\n            };\n            if !held {\n                // Let go mid-stroke: the cut stays, the rating suffers.\n                self.hazards[k].fill += 1.0;\n                self.release(i);\n                return;\n            }\n            let h = &self.hazards[k];\n            let (near, t) = nearest_on_path(h, h.prog, 0.28, p);\n            let d = near.distance(p);\n            if d > 1.15 && tool == Tool::Scalpel {\n                let ang = (p - near).to_angle();\n                self.release(i);\n                self.call(\"healthy\");\n                self.lacerate(p, ang, rules);\n                return;\n            }\n            let adv = (t - h.prog).max(0.0);\n            let s = &mut self.slots[i];\n            if adv > 0.0 {\n                s.eng_a += d * adv;\n                s.eng_b += adv;\n            }\n            let h = &mut self.hazards[k];\n            h.prog = h.prog.max(t);\n            if adv > 0.002 && self.slots[i].eng_t > 0.12 {\n                self.slots[i].eng_t = 0.0;\n                let tool_cue = if tool == Tool::Scalpel { cue::SLICE } else { cue::GEL };\n                self.cue(tool_cue, near, 0.6, 1.0);\n            }\n            let h = &self.hazards[k];\n            if h.prog >= 0.975 {\n                let breaks = h.fill.floor();\n                let s = &self.slots[i];\n                let mean = s.eng_a / s.eng_b.max(0.2);\n                let rating = Rating::grade(mean + breaks * 0.18, rules.tune.strictness, 0.25, 0.42, 0.7);\n                let at = h.b;\n                let id = h.id;\n                self.release(i);\n                self.complete(i, id, tool, rating, at, rules);\n            }\n            return;\n        }\n        if !pressed {\n            return;\n        }\n        if let Some(k) = self.target_near(tool, p, 0.75, i) {\n            let id = self.hazards[k].id;\n            match (self.hazards[k].kind, self.hazards[k].stage) {\n                // A brittle ember takes one stroke through it.\n                (Kind::Ember, _) | (Kind::Furnace, _) => {\n                    let at = self.hazards[k].a;\n                    self.cue(cue::CRACK, at, 1.0, 1.0);\n                    let rating = if self.hazards[k].fill > 0.0 { Rating::Clean } else { Rating::Immaculate };\n                    self.complete(i, id, tool, rating, at, rules);\n                }\n                _ => {\n                    let s = &mut self.slots[i];\n                    s.eng = want;\n                    s.eng_id = id;\n                    s.eng_a = 0.0;\n                    s.eng_b = 0.0;\n                    s.eng_t = 0.0;\n                    self.mark(&format!(\"tool:{}\", tool.key()));\n                }\n            }\n        } else if tool == Tool::Scalpel {\n            if self.wrong_tool_here(i, tool, p, rules) {\n                return;\n            }\n            // Cutting what was never meant to be cut.\n            self.slots[i].eng_start = p;\n            self.call(\"healthy\");\n            self.lacerate(p, 0.7, rules);\n        }\n    }\n\n    /// A press on a hazard this instrument can't touch: true when it was one.\n    fn wrong_tool_here(&mut self, i: usize, tool: Tool, p: Vec2, rules: &Rules) -> bool {\n        let hit = self.hazards.iter().any(|h| {\n            h.visible()\n                && h.takes().is_some()\n                && h.takes() != Some(tool)\n                && !matches!(h.kind, Kind::Pool)\n                && self.dist_to(h, tool, p) < 0.6\n        });\n        if hit {\n            self.wrong_tool(i, rules);\n        }\n        hit\n    }\n\n    fn forceps_tick(&mut self, i: usize, held: bool, pressed: bool, rules: &Rules, dt: f32) {\n        let s = &self.slots[i];\n        let (p, eng, eng_id, start) = (s.cursor, s.eng, s.eng_id, s.eng_start);\n        if eng == Eng::Pull {\n            let Some(k) = self.find(eng_id) else {\n                self.release(i);\n                return;\n            };\n            if !held {\n                self.hazards[k].prog = 0.0;\n                self.release(i);\n                return;\n            }\n            let h = &self.hazards[k];\n            if h.kind == Kind::Tendril {\n                self.tendril_pull(i, k, rules, dt);\n                return;\n            }\n            let disp = p - start;\n            let axis = Vec2::from_angle(h.ang);\n            let along = disp.dot(axis);\n            let m = disp.length();\n            let err = if m > 0.05 { axis.angle_to(disp).abs().to_degrees() } else { 0.0 };\n            let need = 1.0;\n            let at = h.a;\n            let id = h.id;\n            let hazard = &mut self.hazards[k];\n            hazard.c = disp;\n            hazard.prog = (along / need).clamp(0.0, 1.0);\n            if m > 0.55 && err > 60.0 {\n                // Yanked off the axis: it tears.\n                self.hazards[k].c = Vec2::ZERO;\n                self.hazards[k].prog = 0.0;\n                self.release(i);\n                self.call(\"off_axis\");\n                self.lacerate(at, axis.to_angle(), rules);\n                return;\n            }\n            if along >= need {\n                let rating = Rating::grade(err, rules.tune.strictness, 12.0, 24.0, 40.0);\n                self.release(i);\n                self.cue(cue::PULL_POP, at, 1.0, 1.0);\n                self.complete(i, id, Tool::Forceps, rating, at, rules);\n            }\n            return;\n        }\n        if eng == Eng::Bone {\n            let Some(k) = self.find(eng_id) else {\n                self.release(i);\n                return;\n            };\n            let s = &self.slots[i];\n            let (rot_l, rot_r) = (s.held & btn::ROT_L != 0, s.held & btn::ROT_R != 0);\n            let spin = (rot_r as i32 - rot_l as i32) as f32;\n            let h = &mut self.hazards[k];\n            h.a = p;\n            h.ang += spin * 2.2 * dt;\n            let err = angle_diff(h.ang, 0.0).abs().to_degrees();\n            let d = h.a.distance(h.b);\n            if d < 0.35 && err < 12.0 {\n                h.a = h.b;\n                h.ang = 0.0;\n                let id = h.id;\n                let at = h.b;\n                let t = self.slots[i].eng_a;\n                let rating = Rating::grade(t, rules.tune.strictness, 3.0, 6.0, 12.0);\n                self.release(i);\n                self.cue(cue::SNAP, at, 1.0, 1.0);\n                self.complete(i, id, Tool::Forceps, rating, at, rules);\n                return;\n            }\n            self.slots[i].eng_a += dt;\n            if !held {\n                self.release(i);\n            }\n            return;\n        }\n        if !pressed {\n            return;\n        }\n        if let Some(k) = self.target_near(Tool::Forceps, p, 0.7, i) {\n            let id = self.hazards[k].id;\n            let kind = self.hazards[k].kind;\n            let s = &mut self.slots[i];\n            s.eng = if kind == Kind::Bone { Eng::Bone } else { Eng::Pull };\n            s.eng_id = id;\n            s.eng_start = p;\n            s.eng_a = 0.0;\n            s.eng_t = 0.0;\n            self.mark(\"tool:forceps\");\n            self.cue(cue::FORCEPS, p, 1.0, 1.0);\n        } else {\n            self.wrong_tool_here(i, Tool::Forceps, p, rules);\n        }\n    }\n\n    fn tendril_pull(&mut self, i: usize, k: usize, rules: &Rules, dt: f32) {\n        let s = &self.slots[i];\n        let p = s.cursor;\n        let moved = p - s.eng_start;\n        let h = &self.hazards[k];\n        let axis = Vec2::from_angle(h.ang);\n        let along = moved.dot(axis);\n        self.slots[i].eng_start = p;\n        let (at, id) = (h.a, h.id);\n        if along > 0.001 {\n            if self.heart.systole() {\n                // Pulling against the squeeze: it snaps back.\n                let h = &mut self.hazards[k];\n                h.prog = (h.prog - 0.12).max(0.0);\n                h.fill += 1.0;\n                self.slots[i].chain = 0;\n                self.cue(cue::TEAR, at, 0.7, 1.2);\n                self.vitals -= 1.0 * rules.diff.drain();\n                self.call(\"tendril_systole\");\n                self.release(i);\n                return;\n            }\n            let h = &mut self.hazards[k];\n            h.prog = (h.prog + along * 0.085 * rules.tune.tool_power / rules.tune.strain_tough.max(0.2)).min(1.0);\n            h.c = axis * h.prog * 1.6;\n        }\n        let _ = dt;\n        if self.hazards[k].prog >= 1.0 {\n            let breaks = self.hazards[k].fill;\n            let rating = Rating::grade(breaks, rules.tune.strictness, 0.5, 2.0, 4.0);\n            self.release(i);\n            self.cue(cue::PULL_POP, at, 1.0, 0.7);\n            self.complete(i, id, Tool::Forceps, rating, at, rules);\n        }\n    }\n\n    fn suture_tick(&mut self, i: usize, held: bool, pressed: bool, rules: &Rules) {\n        let s = &self.slots[i];\n        let (p, eng, eng_id) = (s.cursor, s.eng, s.eng_id);\n        if eng == Eng::Stitch {\n            let Some(k) = self.find(eng_id) else {\n                self.release(i);\n                return;\n            };\n            if !held {\n                self.release(i);\n                return;\n            }\n            let h = &self.hazards[k];\n            let (_, along, perp) = wound_frame(h, p);\n            let side = if perp > 0.07 {\n                1\n            } else if perp < -0.07 {\n                -1\n            } else {\n                0\n            };\n            let last = self.slots[i].side;\n            if side != 0 {\n                self.slots[i].side = side;\n            }\n            if side != 0 && last != 0 && side != last {\n                // A crossing: near the needle it is a stitch.\n                let len = h.a.distance(h.b).max(0.1);\n                let need = h.need.max(1) as f32;\n                let needle = len * (h.n as f32 + 0.5) / need;\n                let off = (along - needle).abs();\n                if off < 1.2 {\n                    let at = h.a.lerp(h.b, (h.n as f32 + 0.5) / need);\n                    let h = &mut self.hazards[k];\n                    h.n += 1;\n                    h.prog = (h.n as f32 / need).min(1.0);\n                    let done = h.n >= h.need;\n                    let id = h.id;\n                    let s = &mut self.slots[i];\n                    s.eng_a += off;\n                    s.eng_b += 1.0;\n                    s.eng_t = 0.0;\n                    self.cue(cue::SUTURE, at, 0.8, 0.9 + (self.hazards[k].n as f32) * 0.03);\n                    if done {\n                        let s = &self.slots[i];\n                        let mean = s.eng_a / s.eng_b.max(1.0);\n                        let rating = Rating::grade(mean, rules.tune.strictness, 0.32, 0.55, 0.85);\n                        self.release(i);\n                        self.complete(i, id, Tool::Suture, rating, at, rules);\n                    }\n                }\n            }\n            return;\n        }\n        if !pressed {\n            return;\n        }\n        if let Some(k) = self.target_near(Tool::Suture, p, 0.85, i) {\n            let id = self.hazards[k].id;\n            let (_, _, perp) = wound_frame(&self.hazards[k], p);\n            let s = &mut self.slots[i];\n            s.eng = Eng::Stitch;\n            s.eng_id = id;\n            s.side = if perp >= 0.0 { 1 } else { -1 };\n            s.eng_a = 0.0;\n            s.eng_b = 0.0;\n            s.eng_t = 0.0;\n            self.mark(\"tool:suture\");\n        } else {\n            self.wrong_tool_here(i, Tool::Suture, p, rules);\n        }\n    }\n\n    fn suction_tick(&mut self, i: usize, held: bool, rules: &Rules, dt: f32) {\n        if !held {\n            self.slots[i].eng = Eng::None;\n            self.slots[i].eng_id = 0;\n            return;\n        }\n        let s = &self.slots[i];\n        let (p, pressure) = (s.cursor, s.pressure.clamp(0.2, 1.0));\n        let Some(k) = self.target_near(Tool::Suction, p, 0.4, i) else {\n            self.slots[i].eng = Eng::None;\n            self.slots[i].eng_id = 0;\n            return;\n        };\n        let power = rules.tune.tool_power * pressure;\n        let id = self.hazards[k].id;\n        self.slots[i].eng = Eng::Suck;\n        self.slots[i].eng_id = id;\n        self.mark(\"tool:suction\");\n        if self.slots[i].eng_t > 0.18 {\n            self.slots[i].eng_t = 0.0;\n            self.cue(cue::GURGLE, p, 0.35 + pressure * 0.6, 0.8 + self.rng.f32() * 0.4);\n        }\n        let h = &mut self.hazards[k];\n        let at = h.a;\n        if h.kind == Kind::Sac {\n            // Draining a sac whole: slow, and it never rates better than Good.\n            h.fill = (h.fill + dt / 2.4 * power).min(1.0);\n            h.r = (0.8 * (1.0 - h.fill) + 0.1) * (0.5 + 0.5 * h.prog);\n            if h.fill >= 1.0 {\n                self.release(i);\n                self.complete(i, id, Tool::Suction, Rating::Good, at, rules);\n            }\n        } else if matches!(h.kind, Kind::Furnace) {\n            h.fill = (h.fill + dt / 1.0 * power).min(1.0);\n            if h.fill >= 1.0 {\n                h.fill = 0.0;\n                self.release(i);\n                self.complete(i, id, Tool::Suction, Rating::Good, at, rules);\n            }\n        } else {\n            h.r -= dt * 1.1 * power;\n            if h.r <= 0.14 {\n                let r = 0.5;\n                self.stains.push(Stain { at, r, kind: 0 });\n                self.release(i);\n                self.complete(i, id, Tool::Suction, Rating::Good, at, rules);\n            }\n        }\n    }\n\n    fn heat_tick(&mut self, i: usize, tool: Tool, held: bool, rules: &Rules, dt: f32) {\n        let s = &self.slots[i];\n        let (p, eng, eng_id) = (s.cursor, s.eng, s.eng_id);\n        let engaged = eng == Eng::Heat;\n        if engaged && !held {\n            // The release decides everything.\n            let k = self.find(eng_id);\n            self.release(i);\n            if let Some(k) = k {\n                let h = &self.hazards[k];\n                let (fill, at, id) = (h.fill, h.spot(), h.id);\n                if fill >= 0.8 {\n                    let off = if fill <= 1.0 { 1.0 - fill } else { fill - 1.0 + 0.05 };\n                    let rating = Rating::grade(off, rules.tune.strictness, 0.07, 0.13, 0.22);\n                    self.hazards[k].fill = 0.0;\n                    self.complete(i, id, tool, rating, at, rules);\n                }\n            }\n            return;\n        }\n        if !held {\n            return;\n        }\n        let target = self.target_near(tool, p, 0.55, i);\n        match target {\n            Some(k) => {\n                let id = self.hazards[k].id;\n                if eng_id != id {\n                    let s = &mut self.slots[i];\n                    s.eng = Eng::Heat;\n                    s.eng_id = id;\n                    self.mark(&format!(\"tool:{}\", tool.key()));\n                }\n                let time = {\n                    let h = &self.hazards[k];\n                    let base = if h.fill_time > 0.0 {\n                        h.fill_time\n                    } else if tool == Tool::Cryo {\n                        1.0\n                    } else {\n                        1.2\n                    };\n                    let tough = if matches!(h.kind, Kind::Nodule | Kind::Sac | Kind::Ember | Kind::Furnace) {\n                        rules.tune.strain_tough\n                    } else {\n                        1.0\n                    };\n                    base * tough / rules.tune.tool_power.max(0.1)\n                };\n                let h = &mut self.hazards[k];\n                h.fill += dt / time.max(0.05) + dt * 0.25;\n                let (fill, at) = (h.fill, h.spot());\n                if self.slots[i].eng_t > 0.2 {\n                    self.slots[i].eng_t = 0.0;\n                    let id = if tool == Tool::Laser { cue::LASER } else { cue::FROST };\n                    self.cue(id, at, 0.5, 0.7 + fill * 0.6);\n                }\n                if fill > 1.28 {\n                    self.hazards[k].fill = 0.0;\n                    self.release(i);\n                    if tool == Tool::Laser {\n                        self.call(\"overheat\");\n                    } else {\n                        self.call(\"frostbite\");\n                    }\n                    self.burn_at(at);\n                    self.slots[i].chain = 0;\n                }\n            }\n            None => {\n                let s = &mut self.slots[i];\n                s.eng = Eng::None;\n                s.eng_id = 0;\n                // Holding a beam on healthy tissue: it burns, eventually.\n                s.eng_a += dt;\n                if s.eng_a > 1.6 {\n                    s.eng_a = 0.0;\n                    if !self.wrong_tool_here(i, tool, p, rules) {\n                        self.burn_at(p);\n                    }\n                }\n            }\n        }\n    }\n\n    fn gel_tick(&mut self, i: usize, held: bool, rules: &Rules, dt: f32) {\n        if !held {\n            self.slots[i].eng = Eng::None;\n            self.slots[i].eng_id = 0;\n            return;\n        }\n        let s = &mut self.slots[i];\n        let p = s.cursor;\n        s.flow -= dt / 2.4;\n        if s.flow <= 0.0 {\n            s.flow = 0.0;\n            return;\n        }\n        if s.eng_t > 0.16 {\n            s.eng_t = 0.0;\n            self.cue(cue::GEL, p, 0.5, 1.0 + self.rng.f32() * 0.2);\n        }\n        let Some(k) = self.target_near(Tool::Gel, p, 0.2, i) else {\n            self.slots[i].eng_b += dt;\n            return;\n        };\n        let id = self.hazards[k].id;\n        let s = &mut self.slots[i];\n        if s.eng_id != id {\n            s.eng = Eng::Paint;\n            s.eng_id = id;\n            self.mark(\"tool:gel\");\n        }\n        let h = &mut self.hazards[k];\n        let area = (h.r * h.r).max(0.5);\n        h.prog += dt * 1.25 * rules.tune.tool_power / area;\n        let at = h.a;\n        if h.prog >= 1.0 {\n            h.prog = 0.0;\n            let over = self.slots[i].eng_b;\n            let rating = Rating::grade(over, rules.tune.strictness, 0.25, 0.6, 1.1);\n            self.slots[i].eng_b = 0.0;\n            self.slots[i].eng_id = 0;\n            self.stains.push(Stain { at, r: 0.6, kind: 2 });\n            self.complete(i, id, Tool::Gel, rating, at, rules);\n        }\n    }\n\n    fn scanner_tick(&mut self, i: usize, held: bool, dt: f32) {\n        if !held {\n            self.slots[i].eng = Eng::None;\n            return;\n        }\n        let s = &mut self.slots[i];\n        s.eng = Eng::Scan;\n        s.ping_t -= dt;\n        let p = s.cursor;\n        if s.ping_t <= 0.0 {\n            s.ping_t = 0.45;\n            self.mark(\"tool:scanner\");\n            self.cue(cue::SONAR, p, 0.7, 1.0);\n        }\n        let mut found = Vec::new();\n        for h in &mut self.hazards {\n            if h.hidden && h.a.distance(p) < 2.2 {\n                if h.seen <= 0.0 {\n                    found.push(h.a);\n                }\n                h.seen = 8.0;\n            }\n        }\n        for at in found {\n            self.cue(cue::SONAR, at, 1.0, 1.5);\n            let floats = Float { at, text: \"FOUND\".into(), rating: 4, on_beat: false, slot: i as u8, age: 0.0 };\n            self.floats.push(floats);\n        }\n    }\n\n    fn iv_tick(&mut self, i: usize, held: bool, rules: &Rules, dt: f32) {\n        let s = &self.slots[i];\n        let (engaged, dose) = (s.eng == Eng::Iv, s.eng_a);\n        if engaged && !held {\n            self.release(i);\n            self.iv_cd = 4.0;\n            if dose >= 0.25 {\n                let off = if dose <= 1.0 { 1.0 - dose } else { dose - 1.0 + 0.04 };\n                let rating = Rating::grade(off, rules.tune.strictness, 0.08, 0.18, 0.5);\n                let at = iv_port();\n                self.award(i, at, Tool::Iv, rating, rules);\n            }\n            return;\n        }\n        if !held {\n            return;\n        }\n        if !engaged {\n            if self.iv_cd > 0.0 {\n                return;\n            }\n            let s = &mut self.slots[i];\n            s.eng = Eng::Iv;\n            s.eng_a = 0.0;\n            s.eng_id = 0;\n            self.mark(\"tool:iv\");\n            self.cue(cue::IV, iv_port(), 1.0, 1.0);\n        }\n        let step = dt / 1.2;\n        let s = &mut self.slots[i];\n        s.eng_a += step;\n        let dose = s.eng_a;\n        if dose <= 1.0 {\n            self.vitals = (self.vitals + 18.0 * rules.tune.iv_heal * step).min(100.0);\n        }\n        if dose > 1.3 {\n            // Overdose: a spike, then the fall.\n            self.release(i);\n            self.iv_cd = 4.0;\n            self.vitals = (self.vitals - 8.0).max(1.0);\n            self.mistakes += 1;\n            self.shake = self.shake.max(0.4);\n            self.call(\"overdose\");\n            self.cue(cue::ALARM, iv_port(), 0.7, 1.3);\n            self.mark(\"mistake:overdose\");\n        }\n    }\n\n    // -----------------------------------------------------------------------------------------\n    // Finishing things\n\n    /// Scores a rated action: chain, on-beat, gift charge, the big text.\n    pub fn award(&mut self, i: usize, at: Vec2, tool: Tool, rating: Rating, rules: &Rules) {\n        let beat_window = rules.tune.beat_ms / 1000.0;\n        let on_beat = !self.heart.stopped && self.heart.from_r() <= beat_window;\n        let chain_up = rating as u8 >= Rating::Clean as u8;\n        let s = &mut self.slots[i];\n        s.tally[rating as usize] += 1;\n        s.since_action = 0.0;\n        s.recoil = 1.0;\n        if chain_up {\n            s.chain += 1;\n            s.chain_t = 0.0;\n            s.best_chain = s.best_chain.max(s.chain);\n        } else if rating == Rating::Sloppy {\n            s.chain = 0;\n        }\n        let mult = match s.chain {\n            0..=4 => 1.0,\n            5..=9 => 1.25,\n            10..=19 => 1.5,\n            _ => 2.0,\n        };\n        let beat = if on_beat { 1.25 } else { 1.0 };\n        let pts = rating.points() as f32 * mult * beat * rules.tune.score;\n        s.score += pts as i64;\n        if on_beat {\n            s.on_beats += 1;\n        }\n        let charge = match rating {\n            Rating::Immaculate => 8.0,\n            Rating::Clean => 4.0,\n            Rating::Good => 1.0,\n            Rating::Sloppy => 0.0,\n        } + if on_beat { 2.0 } else { 0.0 };\n        let shared = self.slots[0].gift_kind == 3;\n        let meter = if shared { 0 } else { i };\n        if !self.gifts.locked {\n            let m = &mut self.slots[meter];\n            m.gift = (m.gift + charge * rules.tune.gift_gain).min(100.0);\n        }\n        // Inside a Hush each on-beat action adds a heartbeat.\n        if on_beat && self.gifts.hush > 0.0 {\n            self.gifts.hush += 1.0;\n        }\n        let chain = self.slots[i].chain;\n        let cue_id = [cue::RATE_SLOPPY, cue::RATE_GOOD, cue::RATE_CLEAN, cue::RATE_IMMACULATE][rating as usize];\n        self.cue(cue_id, at, 1.0, 1.0);\n        if on_beat {\n            self.cue(cue::ON_BEAT, at, 1.0, 1.0);\n            self.mark(\"on_beat\");\n        }\n        if chain_up && matches!(chain, 5 | 10 | 20) {\n            self.cue(cue::CHAIN_UP, at, 1.0, 1.0);\n            self.mark(\"chain\");\n        }\n        self.mark(&format!(\"rating:{}\", rating.name().to_lowercase()));\n        self.mark(&format!(\"rated:{}\", tool.key()));\n        self.floats.push(Float { at, text: rating.name().into(), rating: rating as u8, on_beat, slot: i as u8, age: 0.0 });\n        if self.floats.len() > 8 {\n            self.floats.remove(0);\n        }\n        // The Echo copies each action onto the next target.\n        if self.gifts.echo > 0.0 && i != 3 && tool != Tool::Iv && tool != Tool::Defib {\n            self.echo_action(tool, rating, rules);\n        }\n    }\n\n    /// Finishes a stage of a hazard with a rating: points and what it does to the hazard.\n    pub fn complete(&mut self, i: usize, id: u32, tool: Tool, rating: Rating, at: Vec2, rules: &Rules) {\n        self.award(i, at, tool, rating, rules);\n        self.apply_done(id, rating, rules);\n    }\n\n    /// The effect of a finished action on its hazard. The Echo and dev tools use it too.\n    pub fn apply_done(&mut self, id: u32, rating: Rating, rules: &Rules) {\n        let Some(k) = self.find(id) else { return };\n        let (kind, stage, a) = {\n            let h = &self.hazards[k];\n            (h.kind, h.stage, h.a)\n        };\n        self.mark(&format!(\"done:{}\", kind.key()));\n        match kind {\n            Kind::Incision | Kind::Closure => {\n                let h = self.remove(id).unwrap();\n                self.reveal_at = h.b;\n                if h.sub == sub::TETHER || h.sub == sub::STROKE {\n                    self.strain_stroke_done(rules);\n                }\n            }\n            Kind::Lacer | Kind::Bleeder => {\n                let h = self.remove(id).unwrap();\n                self.threads.push(Thread { a: h.a, b: h.b, n: h.need });\n                if rating == Rating::Sloppy {\n                    // Sloppy spacing leaves a slow bleed.\n                    self.add(Hazard { kind: Kind::Pool, a: h.a.lerp(h.b, 0.5), r: 0.5, blocking: false, ..Default::default() });\n                }\n            }\n            Kind::Pool => {\n                self.remove(id);\n            }\n            Kind::Object => {\n                let h = self.remove(id).unwrap();\n                self.flights.push(Flight { from: a, sub: h.sub, kind, t: 0.0 });\n                if h.sub == sub::COAL {\n                    if let Some(f) = &mut self.fever {\n                        *f = (*f - 8.0).max(0.0);\n                    }\n                }\n            }\n            Kind::Polyp => {\n                self.remove(id);\n                self.stains.push(Stain { at: a, r: 0.45, kind: 1 });\n                self.cue(cue::SIZZLE, a, 1.0, 1.0);\n            }\n            Kind::Tumor => {\n                if stage >= 2 {\n                    self.remove(id);\n                } else {\n                    let h = &mut self.hazards[k];\n                    h.stage += 1;\n                    h.prog = 0.0;\n                    h.c = Vec2::ZERO;\n                    if stage == 1 {\n                        self.flights.push(Flight { from: a, sub: 4, kind, t: 0.0 });\n                        self.hazards[k].drain = 0.3;\n                    }\n                }\n            }\n            Kind::Patch => {\n                self.remove(id);\n            }\n            Kind::Bone => {\n                if stage >= 1 {\n                    let h = self.remove(id).unwrap();\n                    self.stains.push(Stain { at: h.b, r: 0.4, kind: 2 });\n                } else {\n                    let h = &mut self.hazards[k];\n                    h.stage = 1;\n                    h.n = 0;\n                    h.prog = 0.0;\n                    // The wire crosses the seat of the fragment.\n                    let d = Vec2::new(0.9, 0.0);\n                    let at = h.b;\n                    h.c = at;\n                    h.a = at;\n                    let _ = d;\n                }\n            }\n            Kind::Nodule | Kind::Sac | Kind::Eye | Kind::Ember | Kind::Furnace | Kind::Tendril => {\n                self.strain_done(id, kind, stage, rating, rules);\n            }\n        }\n    }\n\n    /// A rating as the bot or dev sees it: nothing left to do with this hazard now.\n    pub fn resolve_now(&mut self, id: u32, rules: &Rules) {\n        self.apply_done(id, Rating::Clean, rules);\n    }\n\n    fn gift_tick(&mut self, rules: &Rules, dt: f32) {\n        if rules.full_gift && !self.gifts.locked {\n            for s in &mut self.slots {\n                s.gift = 100.0;\n            }\n        }\n        self.gifts.echo = (self.gifts.echo - dt).max(0.0);\n        if self.gifts.hush <= 0.0 {\n            self.gifts.hush = 0.0;\n        }\n        if self.gifts.echo <= 0.0 && self.gifts.hush <= 0.0 {\n            self.gifts.duet = false;\n        }\n        for i in 0..4 {\n            if !self.slots[i].active {\n                continue;\n            }\n            let shared = self.slots[0].gift_kind == 3;\n            let meter = if shared { 0 } else { i };\n            let ready = self.slots[meter].gift >= 100.0 && self.slots[i].gift_kind != 0 && !self.gifts.locked;\n            let held = self.slots[i].held & btn::GIFT != 0;\n            let was = self.slots[i].arming;\n            if held && ready && self.gifts.hush <= 0.0 && self.gifts.echo <= 0.0 {\n                self.slots[i].arming = true;\n                if !was {\n                    self.cue(cue::GIFT_ARM, Vec2::ZERO, 1.0, 1.0);\n                }\n            } else if !held && was {\n                self.slots[i].arming = false;\n                // Let go on the heartbeat, or it was only a held breath.\n                if self.heart.from_r() <= 0.18 {\n                    let kind = self.slots[i].gift_kind;\n                    self.fire_gift(i, meter, kind, rules);\n                } else {\n                    self.cue(cue::CLINK, Vec2::ZERO, 0.5, 0.6);\n                }\n            } else if !held {\n                self.slots[i].arming = false;\n            }\n        }\n    }\n\n    pub fn fire_gift(&mut self, i: usize, meter: usize, kind: u8, rules: &Rules) {\n        self.slots[meter].gift = 0.0;\n        self.gifts.ripple = 1.0;\n        self.flash = 0.5;\n        let beats = 6.0;\n        let echo = rules.tune.echo_secs * rules.tune.gift_dur;\n        match kind {\n            1 => {\n                self.gifts.hush = beats;\n                self.mark(\"gift:hush\");\n                self.cue(cue::HUSH, Vec2::ZERO, 1.0, 1.0);\n                self.set_banner(\"THE HUSH\");\n            }\n            2 => {\n                self.gifts.echo = echo;\n                self.gifts.ghost = self.slots[i].cursor;\n                self.mark(\"gift:echo\");\n                self.cue(cue::ECHO, Vec2::ZERO, 1.0, 1.0);\n                self.set_banner(\"THE ECHO\");\n                self.say(\"pet\", \"There you are. Thirty years late, and steady as a bell.\");\n            }\n            _ => {\n                self.gifts.hush = beats;\n                self.gifts.echo = echo;\n                self.gifts.duet = true;\n                self.mark(\"gift:duet\");\n                self.mark(\"gift:hush\");\n                self.mark(\"gift:echo\");\n                self.cue(cue::DUET, Vec2::ZERO, 1.0, 1.0);\n                self.set_banner(\"THE DUET\");\n            }\n        }\n    }\n\n    fn echo_action(&mut self, tool: Tool, rating: Rating, rules: &Rules) {\n        // The next valid target for that instrument, nearest the ghost hands.\n        let from = self.gifts.ghost;\n        let target = self.target_near(tool, from, 40.0, 3);\n        let Some(k) = target else { return };\n        let id = self.hazards[k].id;\n        let at = self.hazards[k].spot();\n        self.gifts.ghost = at;\n        self.gifts.ghost_t = 1.0;\n        self.cue(cue::ECHO, at, 0.5, 1.4);\n        self.mark(\"echo:repeat\");\n        // Score goes to the player whose hands they are.\n        let chain_kept = self.gifts.echo;\n        self.gifts.echo = 0.0; // don't echo the echo\n        self.complete(0, id, tool, rating, at, rules);\n        self.gifts.echo = chain_kept;\n    }\n\n    fn ghost_tick(&mut self, _rules: &Rules, dt: f32) {\n        self.gifts.ghost_t = (self.gifts.ghost_t - dt * 2.0).max(0.0);\n        if self.gifts.echo > 0.0 && self.gifts.ghost_t <= 0.0 {\n            // The hands drift back toward where they'd be useful.\n            let want = self.slots[0].cursor + Vec2::new(1.2, -0.8);\n            let g = &mut self.gifts.ghost;\n            *g += (want - *g) * (1.0 - (-dt * 3.0).exp());\n        }\n    }\n\n    /// Reads strain data the view wants.\n    pub fn content(&self) -> std::sync::Arc<Content> {\n        content()\n    }\n}\n\npub fn plate_id(c: &Content, name: &str) -> u8 {\n    c.plate_order.iter().position(|p| p == name).unwrap_or(0) as u8\n}\n\npub fn stitches_for(len: f32) -> u16 {\n    ((len / 0.5).round() as u16).max(2)\n}\n\n/// Where the IV port is on the field.\npub fn iv_port() -> Vec2 {\n    Vec2::new(-8.9, 3.3)\n}\n\n/// The tools that start by holding the trigger over a target, without a fresh press.\nfn tool_is_continuous(t: Tool) -> bool {\n    matches!(t, Tool::Suction | Tool::Laser | Tool::Gel | Tool::Scanner | Tool::Iv | Tool::Cryo)\n}\n\nfn hit_slop(h: &Hazard) -> f32 {\n    match h.kind {\n        Kind::Nodule | Kind::Ember | Kind::Tumor => 0.25,\n        _ => 0.0,\n    }\n}\n\npub fn dist_segment(p: Vec2, a: Vec2, b: Vec2) -> f32 {\n    let ab = b - a;\n    let t = ((p - a).dot(ab) / ab.length_squared().max(1e-5)).clamp(0.0, 1.0);\n    p.distance(a + ab * t)\n}\n\n/// A wound's axis, and a point's along-wound and across-wound coordinates.\npub fn wound_frame(h: &Hazard, p: Vec2) -> (Vec2, f32, f32) {\n    let ax = (h.b - h.a).normalize_or_zero();\n    let d = p - h.a;\n    (ax, d.dot(ax), d.perp_dot(ax))\n}\n\n/// The nearest point on a path within `[from, from + window]`, and its parameter.\npub fn nearest_on_path(h: &Hazard, from: f32, window: f32, p: Vec2) -> (Vec2, f32) {\n    let mut best = (h.path(from), from, f32::MAX);\n    for k in 0..=14 {\n        let t = (from + window * k as f32 / 14.0).min(1.0);\n        let q = h.path(t);\n        let d = q.distance_squared(p);\n        if d < best.2 {\n            best = (q, t, d);\n        }\n    }\n    (best.0, best.1)\n}\n\npub fn angle_diff(a: f32, b: f32) -> f32 {\n    let mut d = (a - b) % std::f32::consts::TAU;\n    if d > std::f32::consts::PI {\n        d -= std::f32::consts::TAU;\n    }\n    if d < -std::f32::consts::PI {\n        d += std::f32::consts::TAU;\n    }\n    d\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01CaFnoAfiR5d96tu8q4Gatd","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjweVWZjpvb11KV2j8Go","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NXXaaRvY7AYSbJmiLLPkaN","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery/strain.rs","content":"//! The strains of R.E.Q.U.I.E.M., each a state machine that keeps time on the heart, plus the\n//! Soloist, the long tendril and the Code Blue director. Numbers come from the phase's `params`.\n\nuse std::collections::BTreeMap;\n\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\n\nuse super::cue;\nuse super::field::{Hazard, Kind, Op, Rating, Rules, stitches_for, sub};\n\n#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum StrainKind {\n    #[default]\n    Introit,\n    Lacrimosa,\n    Dies,\n    Soloist,\n    Tendril,\n    Director,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Strain {\n    pub kind: StrainKind,\n    pub step: u8,\n    pub wave: u8,\n    pub waves: u8,\n    pub mini: bool,\n    pub count: u8,\n    /// Spare counters: beats since, strokes done, spawn budget...\n    pub beats: f32,\n    pub done: u16,\n    pub need: u16,\n    pub t: f32,\n    pub budget: f32,\n    pub interval: f32,\n    pub eye: u32,\n    /// Introit: the Hush woke.\n    pub woke: bool,\n    pub merged: bool,\n    pub hazard_id: u32,\n}\n\nimpl Strain {\n    pub fn start(name: &str, params: &BTreeMap<String, f32>) -> Strain {\n        let num = |k: &str, d: f32| params.get(k).copied().unwrap_or(d);\n        let kind = match name {\n            \"lacrimosa\" => StrainKind::Lacrimosa,\n            \"dies\" => StrainKind::Dies,\n            \"soloist\" => StrainKind::Soloist,\n            \"tendril\" => StrainKind::Tendril,\n            \"director\" => StrainKind::Director,\n            _ => StrainKind::Introit,\n        };\n        Strain {\n            kind,\n            waves: num(\"waves\", 3.0) as u8,\n            mini: num(\"mini\", 0.0) > 0.0,\n            count: num(\"count\", 0.0) as u8,\n            need: num(\"need\", 0.0) as u16,\n            budget: num(\"budget\", 1.0),\n            interval: num(\"interval\", 7.0),\n            ..Default::default()\n        }\n    }\n}\n\n/// How many beats of a strain's clock a heartbeat is worth: its speed-up stops at ×1.4 however\n/// fast the heart runs, so failure doesn't spiral unfairly.\nfn beat_worth(op: &Op, rules: &Rules) -> f32 {\n    let over = (op.heart.bpm / 72.0).max(1.0);\n    (1.4 / over).min(1.0) * rules.tune.strain_speed * rules.diff.strain()\n}\n\nfn beat_secs(op: &Op) -> f32 {\n    op.heart.period()\n}\n\nimpl Op {\n    pub(super) fn start_strain(&mut self, rules: &Rules) {\n        let Some(mut s) = self.strain.take() else { return };\n        self.cue(cue::STING, Vec2::ZERO, 1.0, 1.0);\n        match s.kind {\n            StrainKind::Introit => {\n                if s.mini {\n                    let n = s.count.max(2);\n                    for k in 0..n {\n                        let at = Vec2::new(-3.0 + k as f32 * 3.0, -1.0 + (k % 2) as f32 * 2.0);\n                        self.add(nodule(at, 0, false, 0.7));\n                    }\n                    s.step = 2;\n                } else {\n                    self.add(nodule(Vec2::new(0.5, 0.2), 0, true, 1.2));\n                }\n            }\n            StrainKind::Lacrimosa => {\n                s.eye = self.add(Hazard { kind: Kind::Eye, a: Vec2::new(0.0, -0.2), r: 0.9, blocking: true, ..Default::default() });\n                self.spawn_sacs(&s, rules);\n            }\n            StrainKind::Dies => {\n                self.fever = Some(self.fever.unwrap_or(20.0));\n                let n = if s.count > 0 { s.count } else { 5 };\n                let spots = [(-4.6, -1.8), (4.4, -2.0), (-3.2, 2.2), (3.4, 2.4), (0.2, -2.8)];\n                for (x, z) in spots.iter().take(n as usize) {\n                    self.add(ember(Vec2::new(*x, *z), 0));\n                }\n            }\n            StrainKind::Soloist => {\n                s.need = if s.need > 0 { s.need } else { 8 };\n                s.beats = 2.0;\n                self.set_banner(\"THE SOLOIST\");\n            }\n            StrainKind::Tendril => {\n                s.hazard_id = self.add(Hazard {\n                    kind: Kind::Tendril,\n                    a: Vec2::new(-0.6, 0.0),\n                    b: Vec2::new(-4.8, -2.0),\n                    ang: (Vec2::new(-4.8, -2.0) - Vec2::new(-0.6, 0.0)).to_angle(),\n                    r: 0.5,\n                    blocking: true,\n                    drain: 0.6,\n                    ..Default::default()\n                });\n            }\n            StrainKind::Director => {\n                s.t = 0.0;\n                s.beats = 0.0;\n            }\n        }\n        self.strain = Some(s);\n    }\n\n    fn spawn_sacs(&mut self, s: &Strain, _rules: &Rules) {\n        let crown = Vec2::new(0.0, -0.2);\n        let n = if s.count > 0 { s.count } else { 6 };\n        for k in 0..n {\n            let a = k as f32 / n as f32 * std::f32::consts::TAU + s.wave as f32 * 0.5;\n            let at = crown + Vec2::new(a.cos() * 4.1, a.sin() * 2.7);\n            self.add(Hazard {\n                kind: Kind::Sac,\n                a: at,\n                b: crown,\n                r: 0.35,\n                prog: 0.05 + self.rng.f32() * 0.1,\n                beats: 0.0,\n                fill_time: 0.6,\n                drain: 0.15,\n                blocking: true,\n                // Each sac swells over 8 to 12 beats, sooner in later waves.\n                deadline: (8.0 + self.rng.f32() * 4.0) * (1.0 - s.wave as f32 * 0.16),\n                ..Default::default()\n            });\n        }\n    }\n\n    /// Runs once per tick with world time.\n    pub(super) fn strain_tick(&mut self, world: f32, rules: &Rules) {\n        let r_wave = self.heart.r_wave;\n        let worth = beat_worth(self, rules);\n        // Fever rises while a Dies Irae burns.\n        if let Some(f) = self.fever {\n            let burning = self.hazards.iter().any(|h| matches!(h.kind, Kind::Ember | Kind::Furnace));\n            if burning {\n                let embers = self.hazards.iter().filter(|h| h.kind == Kind::Ember).count() as f32;\n                self.fever = Some(f + world * (0.22 + embers * 0.11) * rules.tune.strain_speed * rules.diff.strain());\n            } else {\n                self.fever = Some((f - world * 6.0).max(0.0));\n            }\n        }\n        self.heat_ring_tick(world, r_wave);\n\n        let Some(kind) = self.strain.as_ref().map(|s| s.kind.clone()) else { return };\n        match kind {\n            StrainKind::Introit => self.introit_tick(r_wave, worth, rules),\n            StrainKind::Lacrimosa => self.lacrimosa_tick(r_wave, worth, rules),\n            StrainKind::Dies => self.dies_tick(r_wave, worth, rules),\n            StrainKind::Soloist => self.soloist_tick(r_wave, worth, rules),\n            StrainKind::Tendril => self.tendril_tick(world),\n            StrainKind::Director => self.director_tick(world, r_wave, rules),\n        }\n    }\n\n    fn heat_ring_tick(&mut self, world: f32, _r_wave: bool) {\n        if let Some(r) = self.heat_ring {\n            let next = r + world * 15.0;\n            self.heat_ring = if next > 13.0 { None } else { Some(next) };\n        }\n        self.ring_warn = (self.ring_warn - world).max(0.0);\n    }\n\n    fn step_nodules(&mut self, r_wave: bool, worth: f32) {\n        if !r_wave {\n            return;\n        }\n        let mut moved = Vec::new();\n        for h in &mut self.hazards {\n            if h.kind != Kind::Nodule || h.stage == 2 {\n                continue;\n            }\n            h.beats += worth;\n            let step = if h.sub == sub::SMALL { 2.0 } else { 3.0 };\n            h.telegraph = h.beats >= step - 1.0;\n            if h.stage == 1 {\n                // Popped: pull it within 2 beats or the shell grows back.\n                if h.beats >= 2.0 {\n                    h.stage = 0;\n                    h.fill = 0.0;\n                    h.beats = 0.0;\n                    h.telegraph = false;\n                }\n                continue;\n            }\n            if h.beats >= step {\n                h.beats = 0.0;\n                h.telegraph = false;\n                moved.push(h.id);\n            }\n        }\n        for id in moved {\n            self.step_nodule(id);\n        }\n    }\n\n    fn step_nodule(&mut self, id: u32) {\n        let Some(k) = self.find(id) else { return };\n        let from = self.hazards[k].a;\n        let a = self.rng.f32() * std::f32::consts::TAU;\n        let d = self.rng.range(2.0, 3.6);\n        let to = (from + Vec2::from_angle(a) * d).clamp(Vec2::new(-6.5, -3.2), Vec2::new(6.5, 3.4));\n        let h = &mut self.hazards[k];\n        h.a = to;\n        h.fill = 0.0;\n        self.cue(cue::SQUISH, to, 0.8, 0.8);\n        // It leaves a wound behind, sometimes.\n        let residue = self.hazards.iter().filter(|h| matches!(h.kind, Kind::Lacer | Kind::Pool) && !h.blocking).count();\n        if residue < 5 {\n            if self.rng.f32() < 0.5 {\n                let dir = (to - from).normalize_or_zero();\n                let len = 1.3;\n                self.add(Hazard {\n                    kind: Kind::Lacer,\n                    a: from - dir * len * 0.5,\n                    b: from + dir * len * 0.5,\n                    drain: 0.6,\n                    need: stitches_for(len),\n                    blocking: false,\n                    ..Default::default()\n                });\n            } else {\n                self.add(Hazard { kind: Kind::Pool, a: from, r: 0.6, blocking: false, ..Default::default() });\n            }\n        }\n    }\n\n    fn introit_tick(&mut self, r_wave: bool, worth: f32, rules: &Rules) {\n        self.step_nodules(r_wave, worth);\n        let Some(mut s) = self.strain.take() else { return };\n        // The Hush wakes under pressure, or at the second split.\n        if !s.woke && self.gifts.locked && (self.vitals < 35.0 || s.step >= 2) {\n            s.woke = true;\n            self.gifts.locked = false;\n            for slot in &mut self.slots {\n                slot.gift = 100.0;\n            }\n            self.say(\"bashir\", \"Doctor... your hands.\");\n            self.cue(cue::HUSH, Vec2::ZERO, 0.6, 1.4);\n            self.mark(\"hush:woke\");\n        }\n        let left = self.hazards.iter().filter(|h| h.kind == Kind::Nodule).count();\n        if left == 0 {\n            match s.step {\n                0 => {\n                    // First kill: it splits in two.\n                    self.say(\"mara\", \"It split. Bashir, it split!\");\n                    self.cue(cue::STING, Vec2::ZERO, 1.0, 1.1);\n                    self.add(nodule(Vec2::new(-3.4, -1.4), 0, false, 0.72));\n                    self.add(nodule(Vec2::new(3.2, 1.2), 0, false, 0.72));\n                    s.step = 1;\n                }\n                1 => {\n                    self.say(\"teddy\", \"That's four. Four little waltzers. I'd like it noted I hate this.\");\n                    self.cue(cue::STING, Vec2::ZERO, 1.0, 1.2);\n                    let spots = [(-4.5, 1.8), (-1.5, -2.4), (1.8, 2.4), (4.6, -1.6)];\n                    for (x, z) in spots {\n                        let mut n = nodule(Vec2::new(x, z), sub::SMALL, false, 0.55);\n                        n.r = 0.32;\n                        self.add(n);\n                    }\n                    s.step = 2;\n                }\n                2 if s.mini => {\n                    self.strain = None;\n                    return;\n                }\n                2 => {\n                    // Amen: they merge, held by three tethers.\n                    self.say(\"bashir\", \"They're merging. Cut the tethers. Then the laser, then pull.\");\n                    self.set_banner(\"AMEN\");\n                    self.cue(cue::STING, Vec2::ZERO, 1.2, 0.7);\n                    let centre = Vec2::new(0.0, 0.0);\n                    let mut big = nodule(centre, sub::AMEN, false, 1.2);\n                    big.r = 0.95;\n                    big.stage = 2;\n                    self.add(big);\n                    for k in 0..3 {\n                        let a = k as f32 / 3.0 * std::f32::consts::TAU + 0.5;\n                        let out = centre + Vec2::new(a.cos() * 4.0, a.sin() * 2.7);\n                        let inner = centre + Vec2::new(a.cos() * 1.1, a.sin() * 0.9);\n                        self.add(Hazard {\n                            kind: Kind::Incision,\n                            sub: sub::TETHER,\n                            a: out,\n                            b: inner,\n                            c: (out + inner) * 0.5 + Vec2::new(0.25, -0.2),\n                            blocking: true,\n                            ..Default::default()\n                        });\n                    }\n                    s.step = 3;\n                }\n                _ => {\n                    self.say(\"bashir\", \"...Clean, Doctor.\");\n                    self.strain = None;\n                    let _ = rules;\n                    return;\n                }\n            }\n        }\n        self.strain = Some(s);\n    }\n\n    /// A tether or a Soloist/eye stroke was finished.\n    pub(super) fn strain_stroke_done(&mut self, rules: &Rules) {\n        let _ = rules;\n        let Some(s) = &mut self.strain else { return };\n        s.done += 1;\n        if s.kind == StrainKind::Introit {\n            let tethers = self.hazards.iter().any(|h| h.kind == Kind::Incision && h.sub == sub::TETHER);\n            if !tethers {\n                if let Some(h) = self.hazards.iter_mut().find(|h| h.kind == Kind::Nodule && h.stage == 2) {\n                    h.stage = 0;\n                    h.fill_time = 1.2;\n                }\n            }\n        }\n    }\n\n    fn lacrimosa_tick(&mut self, r_wave: bool, worth: f32, rules: &Rules) {\n        let Some(mut s) = self.strain.take() else { return };\n        if r_wave {\n            let mut burst = Vec::new();\n            for h in &mut self.hazards {\n                if h.kind == Kind::Sac {\n                    h.beats += worth;\n                    h.prog = (h.beats / h.deadline.max(1.0)).clamp(0.05, 1.0);\n                    if h.fill <= 0.0 {\n                        h.r = 0.35 + h.prog * 0.5;\n                    }\n                    if h.prog >= 1.0 {\n                        burst.push(h.id);\n                    }\n                }\n            }\n            for id in burst {\n                if let Some(k) = self.find(id) {\n                    let h = self.hazards.remove(k);\n                    self.mark(\"lacrimosa:burst\");\n                    self.cue(cue::BURST, h.a, 1.0, 1.0);\n                    self.shake = self.shake.max(0.4);\n                    self.add(Hazard { kind: Kind::Pool, sub: sub::CAUSTIC, a: h.a, r: 1.15, drain: 0.45, blocking: false, ..Default::default() });\n                    let patch_at = h.a * 0.8;\n                    self.add(Hazard { kind: Kind::Patch, sub: sub::BURN, a: patch_at, r: 0.7, drain: 0.25, blocking: false, ..Default::default() });\n                    self.call(\"sac_burst\");\n                }\n            }\n        }\n        let sacs = self.hazards.iter().filter(|h| h.kind == Kind::Sac).count();\n        let strokes = self.hazards.iter().filter(|h| h.kind == Kind::Incision && h.sub == sub::STROKE).count();\n        match s.step {\n            0 if sacs == 0 => {\n                // The crown's eye opens for 4 beats: two strokes across it.\n                let beats = 6.0 * beat_secs(self).max(0.55) + 1.2;\n                for dz in [-0.45f32, 0.45] {\n                    let a = Vec2::new(-1.7, -0.2 + dz);\n                    let b = Vec2::new(1.7, -0.2 + dz * 0.6);\n                    self.add(Hazard {\n                        kind: Kind::Incision,\n                        sub: sub::STROKE,\n                        a,\n                        b,\n                        c: (a + b) * 0.5,\n                        blocking: true,\n                        deadline: beats,\n                        ..Default::default()\n                    });\n                }\n                if let Some(k) = self.find(s.eye) {\n                    self.hazards[k].prog = 1.0;\n                }\n                self.cue(cue::STING, Vec2::ZERO, 1.0, 1.3);\n                self.say(\"teddy\", \"The eye! It's open! Doctor, it's looking at me!\");\n                s.step = 1;\n                s.t = 0.0;\n                s.done = 0;\n            }\n            1 => {\n                // Time runs out: the eye closes, and another wave comes.\n                let mut expired = false;\n                let dt = 1.0 / 60.0;\n                for h in &mut self.hazards {\n                    if h.kind == Kind::Incision && h.sub == sub::STROKE && h.deadline > 0.0 {\n                        h.deadline -= dt;\n                        if h.deadline <= 0.0 {\n                            expired = true;\n                        }\n                    }\n                }\n                if expired {\n                    self.hazards.retain(|h| !(h.kind == Kind::Incision && h.sub == sub::STROKE));\n                    if let Some(k) = self.find(s.eye) {\n                        self.hazards[k].prog = 0.0;\n                    }\n                    self.call(\"eye_closed\");\n                    // A smaller wave of the same.\n                    let mut smaller = s.clone();\n                    smaller.count = 3;\n                    self.spawn_sacs(&smaller, rules);\n                    s.step = 0;\n                } else if strokes == 0 {\n                    if let Some(k) = self.find(s.eye) {\n                        self.hazards[k].prog = 0.0;\n                    }\n                    s.wave += 1;\n                    self.mark(&format!(\"lacrimosa:wave{}\", s.wave.min(3)));\n                    if s.wave >= s.waves {\n                        if s.waves == 1 && s.mini {\n                            // Case 7: the sacs alone; the eye goes with them.\n                            if let Some(k) = self.find(s.eye) {\n                                self.hazards.remove(k);\n                            }\n                            self.strain = None;\n                            return;\n                        }\n                        // Last: tear out the eye.\n                        if let Some(k) = self.find(s.eye) {\n                            self.hazards[k].stage = 1;\n                            self.hazards[k].ang = -std::f32::consts::FRAC_PI_2;\n                        }\n                        self.say(\"bashir\", \"The eye, Doctor. Forceps. All the way out.\");\n                        s.step = 2;\n                    } else {\n                        // The flood comes with each wave.\n                        for (x, z) in [(-5.0, 2.0), (5.0, -2.2)] {\n                            self.add(Hazard { kind: Kind::Pool, a: Vec2::new(x, z), r: 0.9, blocking: false, ..Default::default() });\n                        }\n                        self.spawn_sacs(&s, rules);\n                        s.step = 0;\n                    }\n                }\n            }\n            2 => {\n                let eye = self.find(s.eye).is_some();\n                if !eye {\n                    // Gel the bed.\n                    self.add(Hazard { kind: Kind::Patch, sub: sub::BURN, a: Vec2::new(0.0, -0.2), r: 1.1, blocking: true, ..Default::default() });\n                    s.step = 3;\n                }\n            }\n            _ => {\n                if !self.hazards.iter().any(|h| h.kind == Kind::Patch && h.blocking) {\n                    self.strain = None;\n                    return;\n                }\n            }\n        }\n        self.strain = Some(s);\n    }\n\n    fn dies_tick(&mut self, r_wave: bool, worth: f32, rules: &Rules) {\n        let Some(mut s) = self.strain.take() else { return };\n        if r_wave {\n            // Each bar's last beat sends a heat ring out; the beat before it counts in.\n            let meter = self.heart.meter.max(2);\n            let bar = self.heart.bar;\n            if bar == meter - 1 {\n                self.ring_warn = beat_secs(self);\n                self.cue(cue::LIFT_OFF, Vec2::ZERO, 1.0, 1.0);\n                self.call(\"lift_off\");\n                self.mark(\"dies:countin\");\n            }\n            if bar == 0 && s.beats > 0.0 {\n                self.heat_ring = Some(0.2);\n                self.cue(cue::RING, Vec2::ZERO, 1.0, 1.0);\n                self.mark(\"dies:ring\");\n            }\n            s.beats += 1.0;\n            // The roaming ember moves with the beat.\n            let roam: Vec<u32> = self\n                .hazards\n                .iter()\n                .filter(|h| h.kind == Kind::Ember && h.sub == sub::ROAMING && h.stage == 0)\n                .map(|h| h.id)\n                .collect();\n            for id in roam {\n                if let Some(k) = self.find(id) {\n                    let h = &mut self.hazards[k];\n                    h.beats += worth;\n                    if h.beats >= 3.0 {\n                        h.beats = 0.0;\n                        h.fill = 0.0;\n                        let a = (s.beats * 1.7).sin() * std::f32::consts::TAU;\n                        let to = (h.a + Vec2::from_angle(a) * 2.4).clamp(Vec2::new(-6.0, -3.0), Vec2::new(6.0, 3.2));\n                        h.a = to;\n                    }\n                }\n            }\n        }\n        let embers: Vec<u32> = self.hazards.iter().filter(|h| h.kind == Kind::Ember).map(|h| h.id).collect();\n        let coals = self.hazards.iter().any(|h| h.kind == Kind::Object && h.sub == sub::COAL);\n        match s.step {\n            0 => {\n                // Midway two embers merge and roam.\n                if !s.merged && embers.len() == 3 && s.count == 0 {\n                    s.merged = true;\n                    let (a, b) = (embers[0], embers[1]);\n                    let mid = {\n                        let pa = self.find(a).map(|k| self.hazards[k].a).unwrap_or_default();\n                        let pb = self.find(b).map(|k| self.hazards[k].a).unwrap_or_default();\n                        (pa + pb) * 0.5\n                    };\n                    self.hazards.retain(|h| h.id != a && h.id != b);\n                    self.add(ember(mid, sub::ROAMING));\n                    self.mark(\"dies:merge\");\n                    self.cue(cue::STING, mid, 1.0, 0.8);\n                    self.say(\"teddy\", \"Two of them just became one and it's walking. Pet, it's walking!\");\n                }\n                if embers.is_empty() && !coals {\n                    if s.mini {\n                        self.fever = None;\n                        self.strain = None;\n                        return;\n                    }\n                    // An incision reveals the furnace beneath.\n                    let a = Vec2::new(-3.0, 1.2);\n                    let b = Vec2::new(3.0, -1.0);\n                    self.add(Hazard { kind: Kind::Incision, a, b, c: Vec2::new(0.0, 1.0), blocking: true, ..Default::default() });\n                    self.say(\"pet\", \"There it is. Under the sac. The whole furnace. Open her up.\");\n                    s.step = 1;\n                }\n            }\n            1 => {\n                if !self.hazards.iter().any(|h| h.kind == Kind::Incision) {\n                    s.hazard_id = self.add(Hazard {\n                        kind: Kind::Furnace,\n                        a: Vec2::new(0.0, 0.0),\n                        r: 1.3,\n                        ang: -1.2,\n                        drain: 0.5,\n                        blocking: true,\n                        fill_time: 0.9,\n                        ..Default::default()\n                    });\n                    self.set_banner(\"THE FURNACE\");\n                    self.cue(cue::STING, Vec2::ZERO, 1.2, 0.6);\n                    s.step = 2;\n                }\n            }\n            _ => {\n                if !self.hazards.iter().any(|h| h.kind == Kind::Furnace) {\n                    self.fever = Some(self.fever.unwrap_or(0.0).min(40.0));\n                    self.strain = None;\n                    let _ = rules;\n                    return;\n                }\n            }\n        }\n        self.strain = Some(s);\n    }\n\n    fn soloist_tick(&mut self, r_wave: bool, worth: f32, _rules: &Rules) {\n        let Some(mut s) = self.strain.take() else { return };\n        let dt = 1.0 / 60.0;\n        let mut missed = 0;\n        self.hazards.retain_mut(|h| {\n            if h.kind == Kind::Incision && h.sub == sub::STROKE && h.deadline > 0.0 {\n                h.deadline -= dt;\n                if h.deadline <= 0.0 {\n                    missed += 1;\n                    return false;\n                }\n            }\n            true\n        });\n        if missed > 0 {\n            self.vitals -= 3.0 * missed as f32;\n            for slot in &mut self.slots {\n                slot.chain = 0;\n            }\n            self.call(\"stroke_missed\");\n        }\n        if r_wave {\n            s.beats -= worth;\n            let live = self.hazards.iter().filter(|h| h.kind == Kind::Incision && h.sub == sub::STROKE).count() as u16;\n            if s.beats <= 0.0 && s.done + live < s.need {\n                s.beats = 2.0;\n                // A stroke on the beat, somewhere on the muscle.\n                let a = self.rng.f32() * std::f32::consts::TAU;\n                let centre = Vec2::new(self.rng.range(-3.2, 3.2), self.rng.range(-1.6, 1.8));\n                let d = Vec2::from_angle(a) * 1.5;\n                let (p, q) = (centre - d, centre + d);\n                self.add(Hazard {\n                    kind: Kind::Incision,\n                    sub: sub::STROKE,\n                    a: p,\n                    b: q,\n                    c: (p + q) * 0.5,\n                    blocking: true,\n                    deadline: (5.0 * beat_secs(self)).max(3.2),\n                    ..Default::default()\n                });\n                self.cue(cue::STING, centre, 0.5, 1.5);\n            }\n            // The Duet window opens at the half.\n            if s.done >= s.need / 2 && !s.woke {\n                s.woke = true;\n                self.slots[0].gift = 100.0;\n                self.say(\"pet\", \"Now, girl. Both of us. On the beat.\");\n                self.mark(\"duet:window\");\n            }\n        }\n        if s.done >= s.need && self.hazards.iter().all(|h| h.sub != sub::STROKE || h.kind != Kind::Incision) {\n            self.strain = None;\n            return;\n        }\n        self.strain = Some(s);\n    }\n\n    fn tendril_tick(&mut self, _world: f32) {\n        let Some(s) = self.strain.take() else { return };\n        if self.find(s.hazard_id).is_none() {\n            self.strain = None;\n            return;\n        }\n        self.strain = Some(s);\n    }\n\n    /// Code Blue: waves from the hazard set; a budget for the team's size; rising tempo every 30\n    /// seconds; a small strain encounter at the end.\n    fn director_tick(&mut self, world: f32, _r_wave: bool, rules: &Rules) {\n        let Some(mut s) = self.strain.take() else { return };\n        s.t += world;\n        s.beats -= world;\n        let n = self.slots.iter().filter(|x| x.active).count().max(1) as f32;\n        let budget = s.budget * (0.6 + 0.4 * n);\n        let tempo = 1.0 + (s.t / 30.0).floor() * 0.11;\n        let left = self.timer;\n        if s.beats <= 0.0 {\n            s.beats = s.interval / (tempo * budget);\n            let hazards_now = self.hazards.iter().filter(|h| h.kind != Kind::Pool).count();\n            if hazards_now < (6.0 + n * 3.0) as usize {\n                self.director_spawn(&s, tempo);\n            }\n        }\n        // The last 35 seconds: Introit, in small.\n        if left < 35.0 && s.step == 0 {\n            s.step = 1;\n            self.say(\"bashir\", \"It's waltzing. In this patient too. Everyone, scanner up.\");\n            self.set_banner(\"SOMETHING MOVED\");\n            self.cue(cue::STING, Vec2::ZERO, 1.0, 1.0);\n            self.heart.meter = 3;\n            for k in 0..(1 + n as usize) {\n                let at = Vec2::new(-3.5 + k as f32 * 2.2, -1.0 + (k % 2) as f32 * 2.2);\n                self.add(nodule(at, sub::SMALL, false, 0.6));\n                self.mark(\"director:strain\");\n            }\n        }\n        let worth = beat_worth(self, rules);\n        self.step_nodules(self.heart.r_wave, worth);\n        self.strain = Some(s);\n    }\n\n    fn director_spawn(&mut self, s: &Strain, tempo: f32) {\n        let at = Vec2::new(self.rng.range(-7.0, 7.0), self.rng.range(-3.5, 3.6));\n        let ang = self.rng.f32() * std::f32::consts::TAU;\n        let roll = self.rng.below(if tempo > 1.3 { 8 } else { 6 });\n        let dir = Vec2::from_angle(ang);\n        let _ = s;\n        match roll {\n            0 => {\n                let len = self.rng.range(1.4, 2.6);\n                self.add(Hazard {\n                    kind: Kind::Lacer,\n                    a: at - dir * len * 0.5,\n                    b: at + dir * len * 0.5,\n                    drain: 0.5,\n                    need: stitches_for(len),\n                    ..Default::default()\n                });\n            }\n            1 => {\n                self.add(Hazard { kind: Kind::Pool, a: at, r: self.rng.range(0.6, 1.1), ..Default::default() });\n            }\n            2 => {\n                let sub_ = self.rng.below(3) as u8;\n                self.add(Hazard { kind: Kind::Object, a: at, ang, r: 0.45, sub: sub_, drain: 0.15, ..Default::default() });\n            }\n            3 => {\n                self.add(Hazard { kind: Kind::Polyp, a: at, r: 0.5, drain: 0.1, ..Default::default() });\n            }\n            4 => {\n                self.add(Hazard { kind: Kind::Patch, a: at, r: 0.9, drain: 0.15, ..Default::default() });\n            }\n            5 => {\n                let d = Vec2::from_angle(ang) * 0.7;\n                self.add(Hazard { kind: Kind::Bleeder, a: at - d, b: at + d, drain: 1.5, need: 3, ..Default::default() });\n            }\n            6 => {\n                let (p, q) = (at - dir * 1.5, at + dir * 1.5);\n                self.add(Hazard { kind: Kind::Incision, a: p, b: q, c: (p + q) * 0.5 + dir.perp() * 0.5, ..Default::default() });\n            }\n            _ => {\n                self.add(Hazard { kind: Kind::Object, a: at, ang, r: 0.45, hidden: true, sub: 1, drain: 0.2, ..Default::default() });\n            }\n        }\n    }\n\n    /// A strain part finished a stage.\n    pub(super) fn strain_done(&mut self, id: u32, kind: Kind, stage: u8, _rating: Rating, rules: &Rules) {\n        let Some(k) = self.find(id) else { return };\n        let at = self.hazards[k].a;\n        match kind {\n            Kind::Nodule => {\n                if stage == 0 {\n                    let h = &mut self.hazards[k];\n                    h.stage = 1;\n                    h.beats = 0.0;\n                    h.telegraph = false;\n                    h.fill = 0.0;\n                    self.cue(cue::CRACK, at, 1.0, 1.1);\n                    self.call(\"shell_popped\");\n                    if rules.one_hit {\n                        self.hazards.remove(k);\n                    }\n                } else {\n                    self.hazards.remove(k);\n                    self.cue(cue::BURST, at, 0.7, 1.4);\n                    self.stains.push(super::field::Stain { at, r: 0.55, kind: 0 });\n                }\n            }\n            Kind::Sac => {\n                self.hazards.remove(k);\n                self.flights.push(super::field::Flight { from: at, sub: 5, kind, t: 0.0 });\n                self.cue(cue::SQUISH, at, 1.0, 1.2);\n            }\n            Kind::Eye => {\n                self.hazards.remove(k);\n                self.flights.push(super::field::Flight { from: at, sub: 6, kind, t: 0.0 });\n                self.cue(cue::BURST, at, 1.0, 0.7);\n            }\n            Kind::Ember => {\n                if stage == 0 {\n                    let h = &mut self.hazards[k];\n                    h.stage = 1;\n                    h.fill = 0.0;\n                    self.cue(cue::FROST, at, 1.0, 1.4);\n                } else {\n                    // Cracked: three pieces to pull. Each one cools the Fever.\n                    let (big, base) = (self.hazards[k].sub == sub::ROAMING, self.hazards[k].a);\n                    self.hazards.remove(k);\n                    let pieces = if big { 5 } else { 3 };\n                    for p in 0..pieces {\n                        let a = p as f32 / pieces as f32 * std::f32::consts::TAU;\n                        self.add(Hazard {\n                            kind: Kind::Object,\n                            sub: sub::COAL,\n                            a: base + Vec2::from_angle(a) * 0.75,\n                            ang: a,\n                            r: 0.32,\n                            blocking: true,\n                            ..Default::default()\n                        });\n                    }\n                    self.mark(\"dies:crack\");\n                }\n            }\n            Kind::Furnace => {\n                let h = &mut self.hazards[k];\n                h.prog = 0.0;\n                h.fill = 0.0;\n                h.c = Vec2::ZERO;\n                if stage >= 5 {\n                    self.hazards.remove(k);\n                    self.cue(cue::BURST, at, 1.2, 0.6);\n                    self.shake = 0.8;\n                } else {\n                    h.stage += 1;\n                    self.mark(&format!(\"furnace:{stage}\"));\n                    self.cue(cue::STING, at, 0.6, 1.0 + stage as f32 * 0.1);\n                }\n            }\n            Kind::Tendril => {\n                self.hazards.remove(k);\n                self.flights.push(super::field::Flight { from: at, sub: 7, kind, t: 0.0 });\n                self.shake = 1.0;\n            }\n            _ => {}\n        }\n    }\n}\n\nfn nodule(at: Vec2, sub_: u8, hidden: bool, fill: f32) -> Hazard {\n    Hazard { kind: Kind::Nodule, sub: sub_, a: at, r: 0.55, hidden, fill_time: fill, ang: 0.6, drain: 0.35, blocking: true, ..Default::default() }\n}\n\nfn ember(at: Vec2, sub_: u8) -> Hazard {\n    Hazard { kind: Kind::Ember, sub: sub_, a: at, r: if sub_ == sub::ROAMING { 0.75 } else { 0.55 }, drain: 0.2, blocking: true, ..Default::default() }\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":25053,"cache_read_input_tokens":231673,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":25053},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"7c52980d-4ffd-425a-9a37-60fc27d5a3db","timestamp":"2026-11-05T14:37:59.502Z","request_id":"req_011CgjweUzKaH4XZrGxLWT26","wire_tool_inputs":{"toolu_01NXXaaRvY7AYSbJmiLLPkaN":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery/strain.rs","content":"//! The strains of R.E.Q.U.I.E.M., each a state machine that keeps time on the heart, plus the\n//! Soloist, the long tendril and the Code Blue director. Numbers come from the phase's `params`.\n\nuse std::collections::BTreeMap;\n\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\n\nuse super::cue;\nuse super::field::{Hazard, Kind, Op, Rating, Rules, stitches_for, sub};\n\n#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum StrainKind {\n    #[default]\n    Introit,\n    Lacrimosa,\n    Dies,\n    Soloist,\n    Tendril,\n    Director,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Strain {\n    pub kind: StrainKind,\n    pub step: u8,\n    pub wave: u8,\n    pub waves: u8,\n    pub mini: bool,\n    pub count: u8,\n    /// Spare counters: beats since, strokes done, spawn budget...\n    pub beats: f32,\n    pub done: u16,\n    pub need: u16,\n    pub t: f32,\n    pub budget: f32,\n    pub interval: f32,\n    pub eye: u32,\n    /// Introit: the Hush woke.\n    pub woke: bool,\n    pub merged: bool,\n    pub hazard_id: u32,\n}\n\nimpl Strain {\n    pub fn start(name: &str, params: &BTreeMap<String, f32>) -> Strain {\n        let num = |k: &str, d: f32| params.get(k).copied().unwrap_or(d);\n        let kind = match name {\n            \"lacrimosa\" => StrainKind::Lacrimosa,\n            \"dies\" => StrainKind::Dies,\n            \"soloist\" => StrainKind::Soloist,\n            \"tendril\" => StrainKind::Tendril,\n            \"director\" => StrainKind::Director,\n            _ => StrainKind::Introit,\n        };\n        Strain {\n            kind,\n            waves: num(\"waves\", 3.0) as u8,\n            mini: num(\"mini\", 0.0) > 0.0,\n            count: num(\"count\", 0.0) as u8,\n            need: num(\"need\", 0.0) as u16,\n            budget: num(\"budget\", 1.0),\n            interval: num(\"interval\", 7.0),\n            ..Default::default()\n        }\n    }\n}\n\n/// How many beats of a strain's clock a heartbeat is worth: its speed-up stops at ×1.4 however\n/// fast the heart runs, so failure doesn't spiral unfairly.\nfn beat_worth(op: &Op, rules: &Rules) -> f32 {\n    let over = (op.heart.bpm / 72.0).max(1.0);\n    (1.4 / over).min(1.0) * rules.tune.strain_speed * rules.diff.strain()\n}\n\nfn beat_secs(op: &Op) -> f32 {\n    op.heart.period()\n}\n\nimpl Op {\n    pub(super) fn start_strain(&mut self, rules: &Rules) {\n        let Some(mut s) = self.strain.take() else { return };\n        self.cue(cue::STING, Vec2::ZERO, 1.0, 1.0);\n        match s.kind {\n            StrainKind::Introit => {\n                if s.mini {\n                    let n = s.count.max(2);\n                    for k in 0..n {\n                        let at = Vec2::new(-3.0 + k as f32 * 3.0, -1.0 + (k % 2) as f32 * 2.0);\n                        self.add(nodule(at, 0, false, 0.7));\n                    }\n                    s.step = 2;\n                } else {\n                    self.add(nodule(Vec2::new(0.5, 0.2), 0, true, 1.2));\n                }\n            }\n            StrainKind::Lacrimosa => {\n                s.eye = self.add(Hazard { kind: Kind::Eye, a: Vec2::new(0.0, -0.2), r: 0.9, blocking: true, ..Default::default() });\n                self.spawn_sacs(&s, rules);\n            }\n            StrainKind::Dies => {\n                self.fever = Some(self.fever.unwrap_or(20.0));\n                let n = if s.count > 0 { s.count } else { 5 };\n                let spots = [(-4.6, -1.8), (4.4, -2.0), (-3.2, 2.2), (3.4, 2.4), (0.2, -2.8)];\n                for (x, z) in spots.iter().take(n as usize) {\n                    self.add(ember(Vec2::new(*x, *z), 0));\n                }\n            }\n            StrainKind::Soloist => {\n                s.need = if s.need > 0 { s.need } else { 8 };\n                s.beats = 2.0;\n                self.set_banner(\"THE SOLOIST\");\n            }\n            StrainKind::Tendril => {\n                s.hazard_id = self.add(Hazard {\n                    kind: Kind::Tendril,\n                    a: Vec2::new(-0.6, 0.0),\n                    b: Vec2::new(-4.8, -2.0),\n                    ang: (Vec2::new(-4.8, -2.0) - Vec2::new(-0.6, 0.0)).to_angle(),\n                    r: 0.5,\n                    blocking: true,\n                    drain: 0.6,\n                    ..Default::default()\n                });\n            }\n            StrainKind::Director => {\n                s.t = 0.0;\n                s.beats = 0.0;\n            }\n        }\n        self.strain = Some(s);\n    }\n\n    fn spawn_sacs(&mut self, s: &Strain, _rules: &Rules) {\n        let crown = Vec2::new(0.0, -0.2);\n        let n = if s.count > 0 { s.count } else { 6 };\n        for k in 0..n {\n            let a = k as f32 / n as f32 * std::f32::consts::TAU + s.wave as f32 * 0.5;\n            let at = crown + Vec2::new(a.cos() * 4.1, a.sin() * 2.7);\n            self.add(Hazard {\n                kind: Kind::Sac,\n                a: at,\n                b: crown,\n                r: 0.35,\n                prog: 0.05 + self.rng.f32() * 0.1,\n                beats: 0.0,\n                fill_time: 0.6,\n                drain: 0.15,\n                blocking: true,\n                // Each sac swells over 8 to 12 beats, sooner in later waves.\n                deadline: (8.0 + self.rng.f32() * 4.0) * (1.0 - s.wave as f32 * 0.16),\n                ..Default::default()\n            });\n        }\n    }\n\n    /// Runs once per tick with world time.\n    pub(super) fn strain_tick(&mut self, world: f32, rules: &Rules) {\n        let r_wave = self.heart.r_wave;\n        let worth = beat_worth(self, rules);\n        // Fever rises while a Dies Irae burns.\n        if let Some(f) = self.fever {\n            let burning = self.hazards.iter().any(|h| matches!(h.kind, Kind::Ember | Kind::Furnace));\n            if burning {\n                let embers = self.hazards.iter().filter(|h| h.kind == Kind::Ember).count() as f32;\n                self.fever = Some(f + world * (0.22 + embers * 0.11) * rules.tune.strain_speed * rules.diff.strain());\n            } else {\n                self.fever = Some((f - world * 6.0).max(0.0));\n            }\n        }\n        self.heat_ring_tick(world, r_wave);\n\n        let Some(kind) = self.strain.as_ref().map(|s| s.kind.clone()) else { return };\n        match kind {\n            StrainKind::Introit => self.introit_tick(r_wave, worth, rules),\n            StrainKind::Lacrimosa => self.lacrimosa_tick(r_wave, worth, rules),\n            StrainKind::Dies => self.dies_tick(r_wave, worth, rules),\n            StrainKind::Soloist => self.soloist_tick(r_wave, worth, rules),\n            StrainKind::Tendril => self.tendril_tick(world),\n            StrainKind::Director => self.director_tick(world, r_wave, rules),\n        }\n    }\n\n    fn heat_ring_tick(&mut self, world: f32, _r_wave: bool) {\n        if let Some(r) = self.heat_ring {\n            let next = r + world * 15.0;\n            self.heat_ring = if next > 13.0 { None } else { Some(next) };\n        }\n        self.ring_warn = (self.ring_warn - world).max(0.0);\n    }\n\n    fn step_nodules(&mut self, r_wave: bool, worth: f32) {\n        if !r_wave {\n            return;\n        }\n        let mut moved = Vec::new();\n        for h in &mut self.hazards {\n            if h.kind != Kind::Nodule || h.stage == 2 {\n                continue;\n            }\n            h.beats += worth;\n            let step = if h.sub == sub::SMALL { 2.0 } else { 3.0 };\n            h.telegraph = h.beats >= step - 1.0;\n            if h.stage == 1 {\n                // Popped: pull it within 2 beats or the shell grows back.\n                if h.beats >= 2.0 {\n                    h.stage = 0;\n                    h.fill = 0.0;\n                    h.beats = 0.0;\n                    h.telegraph = false;\n                }\n                continue;\n            }\n            if h.beats >= step {\n                h.beats = 0.0;\n                h.telegraph = false;\n                moved.push(h.id);\n            }\n        }\n        for id in moved {\n            self.step_nodule(id);\n        }\n    }\n\n    fn step_nodule(&mut self, id: u32) {\n        let Some(k) = self.find(id) else { return };\n        let from = self.hazards[k].a;\n        let a = self.rng.f32() * std::f32::consts::TAU;\n        let d = self.rng.range(2.0, 3.6);\n        let to = (from + Vec2::from_angle(a) * d).clamp(Vec2::new(-6.5, -3.2), Vec2::new(6.5, 3.4));\n        let h = &mut self.hazards[k];\n        h.a = to;\n        h.fill = 0.0;\n        self.cue(cue::SQUISH, to, 0.8, 0.8);\n        // It leaves a wound behind, sometimes.\n        let residue = self.hazards.iter().filter(|h| matches!(h.kind, Kind::Lacer | Kind::Pool) && !h.blocking).count();\n        if residue < 5 {\n            if self.rng.f32() < 0.5 {\n                let dir = (to - from).normalize_or_zero();\n                let len = 1.3;\n                self.add(Hazard {\n                    kind: Kind::Lacer,\n                    a: from - dir * len * 0.5,\n                    b: from + dir * len * 0.5,\n                    drain: 0.6,\n                    need: stitches_for(len),\n                    blocking: false,\n                    ..Default::default()\n                });\n            } else {\n                self.add(Hazard { kind: Kind::Pool, a: from, r: 0.6, blocking: false, ..Default::default() });\n            }\n        }\n    }\n\n    fn introit_tick(&mut self, r_wave: bool, worth: f32, rules: &Rules) {\n        self.step_nodules(r_wave, worth);\n        let Some(mut s) = self.strain.take() else { return };\n        // The Hush wakes under pressure, or at the second split.\n        if !s.woke && self.gifts.locked && (self.vitals < 35.0 || s.step >= 2) {\n            s.woke = true;\n            self.gifts.locked = false;\n            for slot in &mut self.slots {\n                slot.gift = 100.0;\n            }\n            self.say(\"bashir\", \"Doctor... your hands.\");\n            self.cue(cue::HUSH, Vec2::ZERO, 0.6, 1.4);\n            self.mark(\"hush:woke\");\n        }\n        let left = self.hazards.iter().filter(|h| h.kind == Kind::Nodule).count();\n        if left == 0 {\n            match s.step {\n                0 => {\n                    // First kill: it splits in two.\n                    self.say(\"mara\", \"It split. Bashir, it split!\");\n                    self.cue(cue::STING, Vec2::ZERO, 1.0, 1.1);\n                    self.add(nodule(Vec2::new(-3.4, -1.4), 0, false, 0.72));\n                    self.add(nodule(Vec2::new(3.2, 1.2), 0, false, 0.72));\n                    s.step = 1;\n                }\n                1 => {\n                    self.say(\"teddy\", \"That's four. Four little waltzers. I'd like it noted I hate this.\");\n                    self.cue(cue::STING, Vec2::ZERO, 1.0, 1.2);\n                    let spots = [(-4.5, 1.8), (-1.5, -2.4), (1.8, 2.4), (4.6, -1.6)];\n                    for (x, z) in spots {\n                        let mut n = nodule(Vec2::new(x, z), sub::SMALL, false, 0.55);\n                        n.r = 0.32;\n                        self.add(n);\n                    }\n                    s.step = 2;\n                }\n                2 if s.mini => {\n                    self.strain = None;\n                    return;\n                }\n                2 => {\n                    // Amen: they merge, held by three tethers.\n                    self.say(\"bashir\", \"They're merging. Cut the tethers. Then the laser, then pull.\");\n                    self.set_banner(\"AMEN\");\n                    self.cue(cue::STING, Vec2::ZERO, 1.2, 0.7);\n                    let centre = Vec2::new(0.0, 0.0);\n                    let mut big = nodule(centre, sub::AMEN, false, 1.2);\n                    big.r = 0.95;\n                    big.stage = 2;\n                    self.add(big);\n                    for k in 0..3 {\n                        let a = k as f32 / 3.0 * std::f32::consts::TAU + 0.5;\n                        let out = centre + Vec2::new(a.cos() * 4.0, a.sin() * 2.7);\n                        let inner = centre + Vec2::new(a.cos() * 1.1, a.sin() * 0.9);\n                        self.add(Hazard {\n                            kind: Kind::Incision,\n                            sub: sub::TETHER,\n                            a: out,\n                            b: inner,\n                            c: (out + inner) * 0.5 + Vec2::new(0.25, -0.2),\n                            blocking: true,\n                            ..Default::default()\n                        });\n                    }\n                    s.step = 3;\n                }\n                _ => {\n                    self.say(\"bashir\", \"...Clean, Doctor.\");\n                    self.strain = None;\n                    let _ = rules;\n                    return;\n                }\n            }\n        }\n        self.strain = Some(s);\n    }\n\n    /// A tether or a Soloist/eye stroke was finished.\n    pub(super) fn strain_stroke_done(&mut self, rules: &Rules) {\n        let _ = rules;\n        let Some(s) = &mut self.strain else { return };\n        s.done += 1;\n        if s.kind == StrainKind::Introit {\n            let tethers = self.hazards.iter().any(|h| h.kind == Kind::Incision && h.sub == sub::TETHER);\n            if !tethers {\n                if let Some(h) = self.hazards.iter_mut().find(|h| h.kind == Kind::Nodule && h.stage == 2) {\n                    h.stage = 0;\n                    h.fill_time = 1.2;\n                }\n            }\n        }\n    }\n\n    fn lacrimosa_tick(&mut self, r_wave: bool, worth: f32, rules: &Rules) {\n        let Some(mut s) = self.strain.take() else { return };\n        if r_wave {\n            let mut burst = Vec::new();\n            for h in &mut self.hazards {\n                if h.kind == Kind::Sac {\n                    h.beats += worth;\n                    h.prog = (h.beats / h.deadline.max(1.0)).clamp(0.05, 1.0);\n                    if h.fill <= 0.0 {\n                        h.r = 0.35 + h.prog * 0.5;\n                    }\n                    if h.prog >= 1.0 {\n                        burst.push(h.id);\n                    }\n                }\n            }\n            for id in burst {\n                if let Some(k) = self.find(id) {\n                    let h = self.hazards.remove(k);\n                    self.mark(\"lacrimosa:burst\");\n                    self.cue(cue::BURST, h.a, 1.0, 1.0);\n                    self.shake = self.shake.max(0.4);\n                    self.add(Hazard { kind: Kind::Pool, sub: sub::CAUSTIC, a: h.a, r: 1.15, drain: 0.45, blocking: false, ..Default::default() });\n                    let patch_at = h.a * 0.8;\n                    self.add(Hazard { kind: Kind::Patch, sub: sub::BURN, a: patch_at, r: 0.7, drain: 0.25, blocking: false, ..Default::default() });\n                    self.call(\"sac_burst\");\n                }\n            }\n        }\n        let sacs = self.hazards.iter().filter(|h| h.kind == Kind::Sac).count();\n        let strokes = self.hazards.iter().filter(|h| h.kind == Kind::Incision && h.sub == sub::STROKE).count();\n        match s.step {\n            0 if sacs == 0 => {\n                // The crown's eye opens for 4 beats: two strokes across it.\n                let beats = 6.0 * beat_secs(self).max(0.55) + 1.2;\n                for dz in [-0.45f32, 0.45] {\n                    let a = Vec2::new(-1.7, -0.2 + dz);\n                    let b = Vec2::new(1.7, -0.2 + dz * 0.6);\n                    self.add(Hazard {\n                        kind: Kind::Incision,\n                        sub: sub::STROKE,\n                        a,\n                        b,\n                        c: (a + b) * 0.5,\n                        blocking: true,\n                        deadline: beats,\n                        ..Default::default()\n                    });\n                }\n                if let Some(k) = self.find(s.eye) {\n                    self.hazards[k].prog = 1.0;\n                }\n                self.cue(cue::STING, Vec2::ZERO, 1.0, 1.3);\n                self.say(\"teddy\", \"The eye! It's open! Doctor, it's looking at me!\");\n                s.step = 1;\n                s.t = 0.0;\n                s.done = 0;\n            }\n            1 => {\n                // Time runs out: the eye closes, and another wave comes.\n                let mut expired = false;\n                let dt = 1.0 / 60.0;\n                for h in &mut self.hazards {\n                    if h.kind == Kind::Incision && h.sub == sub::STROKE && h.deadline > 0.0 {\n                        h.deadline -= dt;\n                        if h.deadline <= 0.0 {\n                            expired = true;\n                        }\n                    }\n                }\n                if expired {\n                    self.hazards.retain(|h| !(h.kind == Kind::Incision && h.sub == sub::STROKE));\n                    if let Some(k) = self.find(s.eye) {\n                        self.hazards[k].prog = 0.0;\n                    }\n                    self.call(\"eye_closed\");\n                    // A smaller wave of the same.\n                    let mut smaller = s.clone();\n                    smaller.count = 3;\n                    self.spawn_sacs(&smaller, rules);\n                    s.step = 0;\n                } else if strokes == 0 {\n                    if let Some(k) = self.find(s.eye) {\n                        self.hazards[k].prog = 0.0;\n                    }\n                    s.wave += 1;\n                    self.mark(&format!(\"lacrimosa:wave{}\", s.wave.min(3)));\n                    if s.wave >= s.waves {\n                        if s.waves == 1 && s.mini {\n                            // Case 7: the sacs alone; the eye goes with them.\n                            if let Some(k) = self.find(s.eye) {\n                                self.hazards.remove(k);\n                            }\n                            self.strain = None;\n                            return;\n                        }\n                        // Last: tear out the eye.\n                        if let Some(k) = self.find(s.eye) {\n                            self.hazards[k].stage = 1;\n                            self.hazards[k].ang = -std::f32::consts::FRAC_PI_2;\n                        }\n                        self.say(\"bashir\", \"The eye, Doctor. Forceps. All the way out.\");\n                        s.step = 2;\n                    } else {\n                        // The flood comes with each wave.\n                        for (x, z) in [(-5.0, 2.0), (5.0, -2.2)] {\n                            self.add(Hazard { kind: Kind::Pool, a: Vec2::new(x, z), r: 0.9, blocking: false, ..Default::default() });\n                        }\n                        self.spawn_sacs(&s, rules);\n                        s.step = 0;\n                    }\n                }\n            }\n            2 => {\n                let eye = self.find(s.eye).is_some();\n                if !eye {\n                    // Gel the bed.\n                    self.add(Hazard { kind: Kind::Patch, sub: sub::BURN, a: Vec2::new(0.0, -0.2), r: 1.1, blocking: true, ..Default::default() });\n                    s.step = 3;\n                }\n            }\n            _ => {\n                if !self.hazards.iter().any(|h| h.kind == Kind::Patch && h.blocking) {\n                    self.strain = None;\n                    return;\n                }\n            }\n        }\n        self.strain = Some(s);\n    }\n\n    fn dies_tick(&mut self, r_wave: bool, worth: f32, rules: &Rules) {\n        let Some(mut s) = self.strain.take() else { return };\n        if r_wave {\n            // Each bar's last beat sends a heat ring out; the beat before it counts in.\n            let meter = self.heart.meter.max(2);\n            let bar = self.heart.bar;\n            if bar == meter - 1 {\n                self.ring_warn = beat_secs(self);\n                self.cue(cue::LIFT_OFF, Vec2::ZERO, 1.0, 1.0);\n                self.call(\"lift_off\");\n                self.mark(\"dies:countin\");\n            }\n            if bar == 0 && s.beats > 0.0 {\n                self.heat_ring = Some(0.2);\n                self.cue(cue::RING, Vec2::ZERO, 1.0, 1.0);\n                self.mark(\"dies:ring\");\n            }\n            s.beats += 1.0;\n            // The roaming ember moves with the beat.\n            let roam: Vec<u32> = self\n                .hazards\n                .iter()\n                .filter(|h| h.kind == Kind::Ember && h.sub == sub::ROAMING && h.stage == 0)\n                .map(|h| h.id)\n                .collect();\n            for id in roam {\n                if let Some(k) = self.find(id) {\n                    let h = &mut self.hazards[k];\n                    h.beats += worth;\n                    if h.beats >= 3.0 {\n                        h.beats = 0.0;\n                        h.fill = 0.0;\n                        let a = (s.beats * 1.7).sin() * std::f32::consts::TAU;\n                        let to = (h.a + Vec2::from_angle(a) * 2.4).clamp(Vec2::new(-6.0, -3.0), Vec2::new(6.0, 3.2));\n                        h.a = to;\n                    }\n                }\n            }\n        }\n        let embers: Vec<u32> = self.hazards.iter().filter(|h| h.kind == Kind::Ember).map(|h| h.id).collect();\n        let coals = self.hazards.iter().any(|h| h.kind == Kind::Object && h.sub == sub::COAL);\n        match s.step {\n            0 => {\n                // Midway two embers merge and roam.\n                if !s.merged && embers.len() == 3 && s.count == 0 {\n                    s.merged = true;\n                    let (a, b) = (embers[0], embers[1]);\n                    let mid = {\n                        let pa = self.find(a).map(|k| self.hazards[k].a).unwrap_or_default();\n                        let pb = self.find(b).map(|k| self.hazards[k].a).unwrap_or_default();\n                        (pa + pb) * 0.5\n                    };\n                    self.hazards.retain(|h| h.id != a && h.id != b);\n                    self.add(ember(mid, sub::ROAMING));\n                    self.mark(\"dies:merge\");\n                    self.cue(cue::STING, mid, 1.0, 0.8);\n                    self.say(\"teddy\", \"Two of them just became one and it's walking. Pet, it's walking!\");\n                }\n                if embers.is_empty() && !coals {\n                    if s.mini {\n                        self.fever = None;\n                        self.strain = None;\n                        return;\n                    }\n                    // An incision reveals the furnace beneath.\n                    let a = Vec2::new(-3.0, 1.2);\n                    let b = Vec2::new(3.0, -1.0);\n                    self.add(Hazard { kind: Kind::Incision, a, b, c: Vec2::new(0.0, 1.0), blocking: true, ..Default::default() });\n                    self.say(\"pet\", \"There it is. Under the sac. The whole furnace. Open her up.\");\n                    s.step = 1;\n                }\n            }\n            1 => {\n                if !self.hazards.iter().any(|h| h.kind == Kind::Incision) {\n                    s.hazard_id = self.add(Hazard {\n                        kind: Kind::Furnace,\n                        a: Vec2::new(0.0, 0.0),\n                        r: 1.3,\n                        ang: -1.2,\n                        drain: 0.5,\n                        blocking: true,\n                        fill_time: 0.9,\n                        ..Default::default()\n                    });\n                    self.set_banner(\"THE FURNACE\");\n                    self.cue(cue::STING, Vec2::ZERO, 1.2, 0.6);\n                    s.step = 2;\n                }\n            }\n            _ => {\n                if !self.hazards.iter().any(|h| h.kind == Kind::Furnace) {\n                    self.fever = Some(self.fever.unwrap_or(0.0).min(40.0));\n                    self.strain = None;\n                    let _ = rules;\n                    return;\n                }\n            }\n        }\n        self.strain = Some(s);\n    }\n\n    fn soloist_tick(&mut self, r_wave: bool, worth: f32, _rules: &Rules) {\n        let Some(mut s) = self.strain.take() else { return };\n        let dt = 1.0 / 60.0;\n        let mut missed = 0;\n        self.hazards.retain_mut(|h| {\n            if h.kind == Kind::Incision && h.sub == sub::STROKE && h.deadline > 0.0 {\n                h.deadline -= dt;\n                if h.deadline <= 0.0 {\n                    missed += 1;\n                    return false;\n                }\n            }\n            true\n        });\n        if missed > 0 {\n            self.vitals -= 3.0 * missed as f32;\n            for slot in &mut self.slots {\n                slot.chain = 0;\n            }\n            self.call(\"stroke_missed\");\n        }\n        if r_wave {\n            s.beats -= worth;\n            let live = self.hazards.iter().filter(|h| h.kind == Kind::Incision && h.sub == sub::STROKE).count() as u16;\n            if s.beats <= 0.0 && s.done + live < s.need {\n                s.beats = 2.0;\n                // A stroke on the beat, somewhere on the muscle.\n                let a = self.rng.f32() * std::f32::consts::TAU;\n                let centre = Vec2::new(self.rng.range(-3.2, 3.2), self.rng.range(-1.6, 1.8));\n                let d = Vec2::from_angle(a) * 1.5;\n                let (p, q) = (centre - d, centre + d);\n                self.add(Hazard {\n                    kind: Kind::Incision,\n                    sub: sub::STROKE,\n                    a: p,\n                    b: q,\n                    c: (p + q) * 0.5,\n                    blocking: true,\n                    deadline: (5.0 * beat_secs(self)).max(3.2),\n                    ..Default::default()\n                });\n                self.cue(cue::STING, centre, 0.5, 1.5);\n            }\n            // The Duet window opens at the half.\n            if s.done >= s.need / 2 && !s.woke {\n                s.woke = true;\n                self.slots[0].gift = 100.0;\n                self.say(\"pet\", \"Now, girl. Both of us. On the beat.\");\n                self.mark(\"duet:window\");\n            }\n        }\n        if s.done >= s.need && self.hazards.iter().all(|h| h.sub != sub::STROKE || h.kind != Kind::Incision) {\n            self.strain = None;\n            return;\n        }\n        self.strain = Some(s);\n    }\n\n    fn tendril_tick(&mut self, _world: f32) {\n        let Some(s) = self.strain.take() else { return };\n        if self.find(s.hazard_id).is_none() {\n            self.strain = None;\n            return;\n        }\n        self.strain = Some(s);\n    }\n\n    /// Code Blue: waves from the hazard set; a budget for the team's size; rising tempo every 30\n    /// seconds; a small strain encounter at the end.\n    fn director_tick(&mut self, world: f32, _r_wave: bool, rules: &Rules) {\n        let Some(mut s) = self.strain.take() else { return };\n        s.t += world;\n        s.beats -= world;\n        let n = self.slots.iter().filter(|x| x.active).count().max(1) as f32;\n        let budget = s.budget * (0.6 + 0.4 * n);\n        let tempo = 1.0 + (s.t / 30.0).floor() * 0.11;\n        let left = self.timer;\n        if s.beats <= 0.0 {\n            s.beats = s.interval / (tempo * budget);\n            let hazards_now = self.hazards.iter().filter(|h| h.kind != Kind::Pool).count();\n            if hazards_now < (6.0 + n * 3.0) as usize {\n                self.director_spawn(&s, tempo);\n            }\n        }\n        // The last 35 seconds: Introit, in small.\n        if left < 35.0 && s.step == 0 {\n            s.step = 1;\n            self.say(\"bashir\", \"It's waltzing. In this patient too. Everyone, scanner up.\");\n            self.set_banner(\"SOMETHING MOVED\");\n            self.cue(cue::STING, Vec2::ZERO, 1.0, 1.0);\n            self.heart.meter = 3;\n            for k in 0..(1 + n as usize) {\n                let at = Vec2::new(-3.5 + k as f32 * 2.2, -1.0 + (k % 2) as f32 * 2.2);\n                self.add(nodule(at, sub::SMALL, false, 0.6));\n                self.mark(\"director:strain\");\n            }\n        }\n        let worth = beat_worth(self, rules);\n        self.step_nodules(self.heart.r_wave, worth);\n        self.strain = Some(s);\n    }\n\n    fn director_spawn(&mut self, s: &Strain, tempo: f32) {\n        let at = Vec2::new(self.rng.range(-7.0, 7.0), self.rng.range(-3.5, 3.6));\n        let ang = self.rng.f32() * std::f32::consts::TAU;\n        let roll = self.rng.below(if tempo > 1.3 { 8 } else { 6 });\n        let dir = Vec2::from_angle(ang);\n        let _ = s;\n        match roll {\n            0 => {\n                let len = self.rng.range(1.4, 2.6);\n                self.add(Hazard {\n                    kind: Kind::Lacer,\n                    a: at - dir * len * 0.5,\n                    b: at + dir * len * 0.5,\n                    drain: 0.5,\n                    need: stitches_for(len),\n                    ..Default::default()\n                });\n            }\n            1 => {\n                self.add(Hazard { kind: Kind::Pool, a: at, r: self.rng.range(0.6, 1.1), ..Default::default() });\n            }\n            2 => {\n                let sub_ = self.rng.below(3) as u8;\n                self.add(Hazard { kind: Kind::Object, a: at, ang, r: 0.45, sub: sub_, drain: 0.15, ..Default::default() });\n            }\n            3 => {\n                self.add(Hazard { kind: Kind::Polyp, a: at, r: 0.5, drain: 0.1, ..Default::default() });\n            }\n            4 => {\n                self.add(Hazard { kind: Kind::Patch, a: at, r: 0.9, drain: 0.15, ..Default::default() });\n            }\n            5 => {\n                let d = Vec2::from_angle(ang) * 0.7;\n                self.add(Hazard { kind: Kind::Bleeder, a: at - d, b: at + d, drain: 1.5, need: 3, ..Default::default() });\n            }\n            6 => {\n                let (p, q) = (at - dir * 1.5, at + dir * 1.5);\n                self.add(Hazard { kind: Kind::Incision, a: p, b: q, c: (p + q) * 0.5 + dir.perp() * 0.5, ..Default::default() });\n            }\n            _ => {\n                self.add(Hazard { kind: Kind::Object, a: at, ang, r: 0.45, hidden: true, sub: 1, drain: 0.2, ..Default::default() });\n            }\n        }\n    }\n\n    /// A strain part finished a stage.\n    pub(super) fn strain_done(&mut self, id: u32, kind: Kind, stage: u8, _rating: Rating, rules: &Rules) {\n        let Some(k) = self.find(id) else { return };\n        let at = self.hazards[k].a;\n        match kind {\n            Kind::Nodule => {\n                if stage == 0 {\n                    let h = &mut self.hazards[k];\n                    h.stage = 1;\n                    h.beats = 0.0;\n                    h.telegraph = false;\n                    h.fill = 0.0;\n                    self.cue(cue::CRACK, at, 1.0, 1.1);\n                    self.call(\"shell_popped\");\n                    if rules.one_hit {\n                        self.hazards.remove(k);\n                    }\n                } else {\n                    self.hazards.remove(k);\n                    self.cue(cue::BURST, at, 0.7, 1.4);\n                    self.stains.push(super::field::Stain { at, r: 0.55, kind: 0 });\n                }\n            }\n            Kind::Sac => {\n                self.hazards.remove(k);\n                self.flights.push(super::field::Flight { from: at, sub: 5, kind, t: 0.0 });\n                self.cue(cue::SQUISH, at, 1.0, 1.2);\n            }\n            Kind::Eye => {\n                self.hazards.remove(k);\n                self.flights.push(super::field::Flight { from: at, sub: 6, kind, t: 0.0 });\n                self.cue(cue::BURST, at, 1.0, 0.7);\n            }\n            Kind::Ember => {\n                if stage == 0 {\n                    let h = &mut self.hazards[k];\n                    h.stage = 1;\n                    h.fill = 0.0;\n                    self.cue(cue::FROST, at, 1.0, 1.4);\n                } else {\n                    // Cracked: three pieces to pull. Each one cools the Fever.\n                    let (big, base) = (self.hazards[k].sub == sub::ROAMING, self.hazards[k].a);\n                    self.hazards.remove(k);\n                    let pieces = if big { 5 } else { 3 };\n                    for p in 0..pieces {\n                        let a = p as f32 / pieces as f32 * std::f32::consts::TAU;\n                        self.add(Hazard {\n                            kind: Kind::Object,\n                            sub: sub::COAL,\n                            a: base + Vec2::from_angle(a) * 0.75,\n                            ang: a,\n                            r: 0.32,\n                            blocking: true,\n                            ..Default::default()\n                        });\n                    }\n                    self.mark(\"dies:crack\");\n                }\n            }\n            Kind::Furnace => {\n                let h = &mut self.hazards[k];\n                h.prog = 0.0;\n                h.fill = 0.0;\n                h.c = Vec2::ZERO;\n                if stage >= 5 {\n                    self.hazards.remove(k);\n                    self.cue(cue::BURST, at, 1.2, 0.6);\n                    self.shake = 0.8;\n                } else {\n                    h.stage += 1;\n                    self.mark(&format!(\"furnace:{stage}\"));\n                    self.cue(cue::STING, at, 0.6, 1.0 + stage as f32 * 0.1);\n                }\n            }\n            Kind::Tendril => {\n                self.hazards.remove(k);\n                self.flights.push(super::field::Flight { from: at, sub: 7, kind, t: 0.0 });\n                self.shake = 1.0;\n            }\n            _ => {}\n        }\n    }\n}\n\nfn nodule(at: Vec2, sub_: u8, hidden: bool, fill: f32) -> Hazard {\n    Hazard { kind: Kind::Nodule, sub: sub_, a: at, r: 0.55, hidden, fill_time: fill, ang: 0.6, drain: 0.35, blocking: true, ..Default::default() }\n}\n\nfn ember(at: Vec2, sub_: u8) -> Hazard {\n    Hazard { kind: Kind::Ember, sub: sub_, a: at, r: if sub_ == sub::ROAMING { 0.75 } else { 0.55 }, drain: 0.2, blocking: true, ..Default::default() }\n}\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NXXaaRvY7AYSbJmiLLPkaN","type":"tool_result","content":"File created successfully at: /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery/strain.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"dba0535b-8c7b-4d71-aa4d-cb180caf3960","timestamp":"2026-11-05T14:37:59.557Z","tool_use_result":{"type":"create","filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery/strain.rs","content":"//! The strains of R.E.Q.U.I.E.M., each a state machine that keeps time on the heart, plus the\n//! Soloist, the long tendril and the Code Blue director. Numbers come from the phase's `params`.\n\nuse std::collections::BTreeMap;\n\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\n\nuse super::cue;\nuse super::field::{Hazard, Kind, Op, Rating, Rules, stitches_for, sub};\n\n#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum StrainKind {\n    #[default]\n    Introit,\n    Lacrimosa,\n    Dies,\n    Soloist,\n    Tendril,\n    Director,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Strain {\n    pub kind: StrainKind,\n    pub step: u8,\n    pub wave: u8,\n    pub waves: u8,\n    pub mini: bool,\n    pub count: u8,\n    /// Spare counters: beats since, strokes done, spawn budget...\n    pub beats: f32,\n    pub done: u16,\n    pub need: u16,\n    pub t: f32,\n    pub budget: f32,\n    pub interval: f32,\n    pub eye: u32,\n    /// Introit: the Hush woke.\n    pub woke: bool,\n    pub merged: bool,\n    pub hazard_id: u32,\n}\n\nimpl Strain {\n    pub fn start(name: &str, params: &BTreeMap<String, f32>) -> Strain {\n        let num = |k: &str, d: f32| params.get(k).copied().unwrap_or(d);\n        let kind = match name {\n            \"lacrimosa\" => StrainKind::Lacrimosa,\n            \"dies\" => StrainKind::Dies,\n            \"soloist\" => StrainKind::Soloist,\n            \"tendril\" => StrainKind::Tendril,\n            \"director\" => StrainKind::Director,\n            _ => StrainKind::Introit,\n        };\n        Strain {\n            kind,\n            waves: num(\"waves\", 3.0) as u8,\n            mini: num(\"mini\", 0.0) > 0.0,\n            count: num(\"count\", 0.0) as u8,\n            need: num(\"need\", 0.0) as u16,\n            budget: num(\"budget\", 1.0),\n            interval: num(\"interval\", 7.0),\n            ..Default::default()\n        }\n    }\n}\n\n/// How many beats of a strain's clock a heartbeat is worth: its speed-up stops at ×1.4 however\n/// fast the heart runs, so failure doesn't spiral unfairly.\nfn beat_worth(op: &Op, rules: &Rules) -> f32 {\n    let over = (op.heart.bpm / 72.0).max(1.0);\n    (1.4 / over).min(1.0) * rules.tune.strain_speed * rules.diff.strain()\n}\n\nfn beat_secs(op: &Op) -> f32 {\n    op.heart.period()\n}\n\nimpl Op {\n    pub(super) fn start_strain(&mut self, rules: &Rules) {\n        let Some(mut s) = self.strain.take() else { return };\n        self.cue(cue::STING, Vec2::ZERO, 1.0, 1.0);\n        match s.kind {\n            StrainKind::Introit => {\n                if s.mini {\n                    let n = s.count.max(2);\n                    for k in 0..n {\n                        let at = Vec2::new(-3.0 + k as f32 * 3.0, -1.0 + (k % 2) as f32 * 2.0);\n                        self.add(nodule(at, 0, false, 0.7));\n                    }\n                    s.step = 2;\n                } else {\n                    self.add(nodule(Vec2::new(0.5, 0.2), 0, true, 1.2));\n                }\n            }\n            StrainKind::Lacrimosa => {\n                s.eye = self.add(Hazard { kind: Kind::Eye, a: Vec2::new(0.0, -0.2), r: 0.9, blocking: true, ..Default::default() });\n                self.spawn_sacs(&s, rules);\n            }\n            StrainKind::Dies => {\n                self.fever = Some(self.fever.unwrap_or(20.0));\n                let n = if s.count > 0 { s.count } else { 5 };\n                let spots = [(-4.6, -1.8), (4.4, -2.0), (-3.2, 2.2), (3.4, 2.4), (0.2, -2.8)];\n                for (x, z) in spots.iter().take(n as usize) {\n                    self.add(ember(Vec2::new(*x, *z), 0));\n                }\n            }\n            StrainKind::Soloist => {\n                s.need = if s.need > 0 { s.need } else { 8 };\n                s.beats = 2.0;\n                self.set_banner(\"THE SOLOIST\");\n            }\n            StrainKind::Tendril => {\n                s.hazard_id = self.add(Hazard {\n                    kind: Kind::Tendril,\n                    a: Vec2::new(-0.6, 0.0),\n                    b: Vec2::new(-4.8, -2.0),\n                    ang: (Vec2::new(-4.8, -2.0) - Vec2::new(-0.6, 0.0)).to_angle(),\n                    r: 0.5,\n                    blocking: true,\n                    drain: 0.6,\n                    ..Default::default()\n                });\n            }\n            StrainKind::Director => {\n                s.t = 0.0;\n                s.beats = 0.0;\n            }\n        }\n        self.strain = Some(s);\n    }\n\n    fn spawn_sacs(&mut self, s: &Strain, _rules: &Rules) {\n        let crown = Vec2::new(0.0, -0.2);\n        let n = if s.count > 0 { s.count } else { 6 };\n        for k in 0..n {\n            let a = k as f32 / n as f32 * std::f32::consts::TAU + s.wave as f32 * 0.5;\n            let at = crown + Vec2::new(a.cos() * 4.1, a.sin() * 2.7);\n            self.add(Hazard {\n                kind: Kind::Sac,\n                a: at,\n                b: crown,\n                r: 0.35,\n                prog: 0.05 + self.rng.f32() * 0.1,\n                beats: 0.0,\n                fill_time: 0.6,\n                drain: 0.15,\n                blocking: true,\n                // Each sac swells over 8 to 12 beats, sooner in later waves.\n                deadline: (8.0 + self.rng.f32() * 4.0) * (1.0 - s.wave as f32 * 0.16),\n                ..Default::default()\n            });\n        }\n    }\n\n    /// Runs once per tick with world time.\n    pub(super) fn strain_tick(&mut self, world: f32, rules: &Rules) {\n        let r_wave = self.heart.r_wave;\n        let worth = beat_worth(self, rules);\n        // Fever rises while a Dies Irae burns.\n        if let Some(f) = self.fever {\n            let burning = self.hazards.iter().any(|h| matches!(h.kind, Kind::Ember | Kind::Furnace));\n            if burning {\n                let embers = self.hazards.iter().filter(|h| h.kind == Kind::Ember).count() as f32;\n                self.fever = Some(f + world * (0.22 + embers * 0.11) * rules.tune.strain_speed * rules.diff.strain());\n            } else {\n                self.fever = Some((f - world * 6.0).max(0.0));\n            }\n        }\n        self.heat_ring_tick(world, r_wave);\n\n        let Some(kind) = self.strain.as_ref().map(|s| s.kind.clone()) else { return };\n        match kind {\n            StrainKind::Introit => self.introit_tick(r_wave, worth, rules),\n            StrainKind::Lacrimosa => self.lacrimosa_tick(r_wave, worth, rules),\n            StrainKind::Dies => self.dies_tick(r_wave, worth, rules),\n            StrainKind::Soloist => self.soloist_tick(r_wave, worth, rules),\n            StrainKind::Tendril => self.tendril_tick(world),\n            StrainKind::Director => self.director_tick(world, r_wave, rules),\n        }\n    }\n\n    fn heat_ring_tick(&mut self, world: f32, _r_wave: bool) {\n        if let Some(r) = self.heat_ring {\n            let next = r + world * 15.0;\n            self.heat_ring = if next > 13.0 { None } else { Some(next) };\n        }\n        self.ring_warn = (self.ring_warn - world).max(0.0);\n    }\n\n    fn step_nodules(&mut self, r_wave: bool, worth: f32) {\n        if !r_wave {\n            return;\n        }\n        let mut moved = Vec::new();\n        for h in &mut self.hazards {\n            if h.kind != Kind::Nodule || h.stage == 2 {\n                continue;\n            }\n            h.beats += worth;\n            let step = if h.sub == sub::SMALL { 2.0 } else { 3.0 };\n            h.telegraph = h.beats >= step - 1.0;\n            if h.stage == 1 {\n                // Popped: pull it within 2 beats or the shell grows back.\n                if h.beats >= 2.0 {\n                    h.stage = 0;\n                    h.fill = 0.0;\n                    h.beats = 0.0;\n                    h.telegraph = false;\n                }\n                continue;\n            }\n            if h.beats >= step {\n                h.beats = 0.0;\n                h.telegraph = false;\n                moved.push(h.id);\n            }\n        }\n        for id in moved {\n            self.step_nodule(id);\n        }\n    }\n\n    fn step_nodule(&mut self, id: u32) {\n        let Some(k) = self.find(id) else { return };\n        let from = self.hazards[k].a;\n        let a = self.rng.f32() * std::f32::consts::TAU;\n        let d = self.rng.range(2.0, 3.6);\n        let to = (from + Vec2::from_angle(a) * d).clamp(Vec2::new(-6.5, -3.2), Vec2::new(6.5, 3.4));\n        let h = &mut self.hazards[k];\n        h.a = to;\n        h.fill = 0.0;\n        self.cue(cue::SQUISH, to, 0.8, 0.8);\n        // It leaves a wound behind, sometimes.\n        let residue = self.hazards.iter().filter(|h| matches!(h.kind, Kind::Lacer | Kind::Pool) && !h.blocking).count();\n        if residue < 5 {\n            if self.rng.f32() < 0.5 {\n                let dir = (to - from).normalize_or_zero();\n                let len = 1.3;\n                self.add(Hazard {\n                    kind: Kind::Lacer,\n                    a: from - dir * len * 0.5,\n                    b: from + dir * len * 0.5,\n                    drain: 0.6,\n                    need: stitches_for(len),\n                    blocking: false,\n                    ..Default::default()\n                });\n            } else {\n                self.add(Hazard { kind: Kind::Pool, a: from, r: 0.6, blocking: false, ..Default::default() });\n            }\n        }\n    }\n\n    fn introit_tick(&mut self, r_wave: bool, worth: f32, rules: &Rules) {\n        self.step_nodules(r_wave, worth);\n        let Some(mut s) = self.strain.take() else { return };\n        // The Hush wakes under pressure, or at the second split.\n        if !s.woke && self.gifts.locked && (self.vitals < 35.0 || s.step >= 2) {\n            s.woke = true;\n            self.gifts.locked = false;\n            for slot in &mut self.slots {\n                slot.gift = 100.0;\n            }\n            self.say(\"bashir\", \"Doctor... your hands.\");\n            self.cue(cue::HUSH, Vec2::ZERO, 0.6, 1.4);\n            self.mark(\"hush:woke\");\n        }\n        let left = self.hazards.iter().filter(|h| h.kind == Kind::Nodule).count();\n        if left == 0 {\n            match s.step {\n                0 => {\n                    // First kill: it splits in two.\n                    self.say(\"mara\", \"It split. Bashir, it split!\");\n                    self.cue(cue::STING, Vec2::ZERO, 1.0, 1.1);\n                    self.add(nodule(Vec2::new(-3.4, -1.4), 0, false, 0.72));\n                    self.add(nodule(Vec2::new(3.2, 1.2), 0, false, 0.72));\n                    s.step = 1;\n                }\n                1 => {\n                    self.say(\"teddy\", \"That's four. Four little waltzers. I'd like it noted I hate this.\");\n                    self.cue(cue::STING, Vec2::ZERO, 1.0, 1.2);\n                    let spots = [(-4.5, 1.8), (-1.5, -2.4), (1.8, 2.4), (4.6, -1.6)];\n                    for (x, z) in spots {\n                        let mut n = nodule(Vec2::new(x, z), sub::SMALL, false, 0.55);\n                        n.r = 0.32;\n                        self.add(n);\n                    }\n                    s.step = 2;\n                }\n                2 if s.mini => {\n                    self.strain = None;\n                    return;\n                }\n                2 => {\n                    // Amen: they merge, held by three tethers.\n                    self.say(\"bashir\", \"They're merging. Cut the tethers. Then the laser, then pull.\");\n                    self.set_banner(\"AMEN\");\n                    self.cue(cue::STING, Vec2::ZERO, 1.2, 0.7);\n                    let centre = Vec2::new(0.0, 0.0);\n                    let mut big = nodule(centre, sub::AMEN, false, 1.2);\n                    big.r = 0.95;\n                    big.stage = 2;\n                    self.add(big);\n                    for k in 0..3 {\n                        let a = k as f32 / 3.0 * std::f32::consts::TAU + 0.5;\n                        let out = centre + Vec2::new(a.cos() * 4.0, a.sin() * 2.7);\n                        let inner = centre + Vec2::new(a.cos() * 1.1, a.sin() * 0.9);\n                        self.add(Hazard {\n                            kind: Kind::Incision,\n                            sub: sub::TETHER,\n                            a: out,\n                            b: inner,\n                            c: (out + inner) * 0.5 + Vec2::new(0.25, -0.2),\n                            blocking: true,\n                            ..Default::default()\n                        });\n                    }\n                    s.step = 3;\n                }\n                _ => {\n                    self.say(\"bashir\", \"...Clean, Doctor.\");\n                    self.strain = None;\n                    let _ = rules;\n                    return;\n                }\n            }\n        }\n        self.strain = Some(s);\n    }\n\n    /// A tether or a Soloist/eye stroke was finished.\n    pub(super) fn strain_stroke_done(&mut self, rules: &Rules) {\n        let _ = rules;\n        let Some(s) = &mut self.strain else { return };\n        s.done += 1;\n        if s.kind == StrainKind::Introit {\n            let tethers = self.hazards.iter().any(|h| h.kind == Kind::Incision && h.sub == sub::TETHER);\n            if !tethers {\n                if let Some(h) = self.hazards.iter_mut().find(|h| h.kind == Kind::Nodule && h.stage == 2) {\n                    h.stage = 0;\n                    h.fill_time = 1.2;\n                }\n            }\n        }\n    }\n\n    fn lacrimosa_tick(&mut self, r_wave: bool, worth: f32, rules: &Rules) {\n        let Some(mut s) = self.strain.take() else { return };\n        if r_wave {\n            let mut burst = Vec::new();\n            for h in &mut self.hazards {\n                if h.kind == Kind::Sac {\n                    h.beats += worth;\n                    h.prog = (h.beats / h.deadline.max(1.0)).clamp(0.05, 1.0);\n                    if h.fill <= 0.0 {\n                        h.r = 0.35 + h.prog * 0.5;\n                    }\n                    if h.prog >= 1.0 {\n                        burst.push(h.id);\n                    }\n                }\n            }\n            for id in burst {\n                if let Some(k) = self.find(id) {\n                    let h = self.hazards.remove(k);\n                    self.mark(\"lacrimosa:burst\");\n                    self.cue(cue::BURST, h.a, 1.0, 1.0);\n                    self.shake = self.shake.max(0.4);\n                    self.add(Hazard { kind: Kind::Pool, sub: sub::CAUSTIC, a: h.a, r: 1.15, drain: 0.45, blocking: false, ..Default::default() });\n                    let patch_at = h.a * 0.8;\n                    self.add(Hazard { kind: Kind::Patch, sub: sub::BURN, a: patch_at, r: 0.7, drain: 0.25, blocking: false, ..Default::default() });\n                    self.call(\"sac_burst\");\n                }\n            }\n        }\n        let sacs = self.hazards.iter().filter(|h| h.kind == Kind::Sac).count();\n        let strokes = self.hazards.iter().filter(|h| h.kind == Kind::Incision && h.sub == sub::STROKE).count();\n        match s.step {\n            0 if sacs == 0 => {\n                // The crown's eye opens for 4 beats: two strokes across it.\n                let beats = 6.0 * beat_secs(self).max(0.55) + 1.2;\n                for dz in [-0.45f32, 0.45] {\n                    let a = Vec2::new(-1.7, -0.2 + dz);\n                    let b = Vec2::new(1.7, -0.2 + dz * 0.6);\n                    self.add(Hazard {\n                        kind: Kind::Incision,\n                        sub: sub::STROKE,\n                        a,\n                        b,\n                        c: (a + b) * 0.5,\n                        blocking: true,\n                        deadline: beats,\n                        ..Default::default()\n                    });\n                }\n                if let Some(k) = self.find(s.eye) {\n                    self.hazards[k].prog = 1.0;\n                }\n                self.cue(cue::STING, Vec2::ZERO, 1.0, 1.3);\n                self.say(\"teddy\", \"The eye! It's open! Doctor, it's looking at me!\");\n                s.step = 1;\n                s.t = 0.0;\n                s.done = 0;\n            }\n            1 => {\n                // Time runs out: the eye closes, and another wave comes.\n                let mut expired = false;\n                let dt = 1.0 / 60.0;\n                for h in &mut self.hazards {\n                    if h.kind == Kind::Incision && h.sub == sub::STROKE && h.deadline > 0.0 {\n                        h.deadline -= dt;\n                        if h.deadline <= 0.0 {\n                            expired = true;\n                        }\n                    }\n                }\n                if expired {\n                    self.hazards.retain(|h| !(h.kind == Kind::Incision && h.sub == sub::STROKE));\n                    if let Some(k) = self.find(s.eye) {\n                        self.hazards[k].prog = 0.0;\n                    }\n                    self.call(\"eye_closed\");\n                    // A smaller wave of the same.\n                    let mut smaller = s.clone();\n                    smaller.count = 3;\n                    self.spawn_sacs(&smaller, rules);\n                    s.step = 0;\n                } else if strokes == 0 {\n                    if let Some(k) = self.find(s.eye) {\n                        self.hazards[k].prog = 0.0;\n                    }\n                    s.wave += 1;\n                    self.mark(&format!(\"lacrimosa:wave{}\", s.wave.min(3)));\n                    if s.wave >= s.waves {\n                        if s.waves == 1 && s.mini {\n                            // Case 7: the sacs alone; the eye goes with them.\n                            if let Some(k) = self.find(s.eye) {\n                                self.hazards.remove(k);\n                            }\n                            self.strain = None;\n                            return;\n                        }\n                        // Last: tear out the eye.\n                        if let Some(k) = self.find(s.eye) {\n                            self.hazards[k].stage = 1;\n                            self.hazards[k].ang = -std::f32::consts::FRAC_PI_2;\n                        }\n                        self.say(\"bashir\", \"The eye, Doctor. Forceps. All the way out.\");\n                        s.step = 2;\n                    } else {\n                        // The flood comes with each wave.\n                        for (x, z) in [(-5.0, 2.0), (5.0, -2.2)] {\n                            self.add(Hazard { kind: Kind::Pool, a: Vec2::new(x, z), r: 0.9, blocking: false, ..Default::default() });\n                        }\n                        self.spawn_sacs(&s, rules);\n                        s.step = 0;\n                    }\n                }\n            }\n            2 => {\n                let eye = self.find(s.eye).is_some();\n                if !eye {\n                    // Gel the bed.\n                    self.add(Hazard { kind: Kind::Patch, sub: sub::BURN, a: Vec2::new(0.0, -0.2), r: 1.1, blocking: true, ..Default::default() });\n                    s.step = 3;\n                }\n            }\n            _ => {\n                if !self.hazards.iter().any(|h| h.kind == Kind::Patch && h.blocking) {\n                    self.strain = None;\n                    return;\n                }\n            }\n        }\n        self.strain = Some(s);\n    }\n\n    fn dies_tick(&mut self, r_wave: bool, worth: f32, rules: &Rules) {\n        let Some(mut s) = self.strain.take() else { return };\n        if r_wave {\n            // Each bar's last beat sends a heat ring out; the beat before it counts in.\n            let meter = self.heart.meter.max(2);\n            let bar = self.heart.bar;\n            if bar == meter - 1 {\n                self.ring_warn = beat_secs(self);\n                self.cue(cue::LIFT_OFF, Vec2::ZERO, 1.0, 1.0);\n                self.call(\"lift_off\");\n                self.mark(\"dies:countin\");\n            }\n            if bar == 0 && s.beats > 0.0 {\n                self.heat_ring = Some(0.2);\n                self.cue(cue::RING, Vec2::ZERO, 1.0, 1.0);\n                self.mark(\"dies:ring\");\n            }\n            s.beats += 1.0;\n            // The roaming ember moves with the beat.\n            let roam: Vec<u32> = self\n                .hazards\n                .iter()\n                .filter(|h| h.kind == Kind::Ember && h.sub == sub::ROAMING && h.stage == 0)\n                .map(|h| h.id)\n                .collect();\n            for id in roam {\n                if let Some(k) = self.find(id) {\n                    let h = &mut self.hazards[k];\n                    h.beats += worth;\n                    if h.beats >= 3.0 {\n                        h.beats = 0.0;\n                        h.fill = 0.0;\n                        let a = (s.beats * 1.7).sin() * std::f32::consts::TAU;\n                        let to = (h.a + Vec2::from_angle(a) * 2.4).clamp(Vec2::new(-6.0, -3.0), Vec2::new(6.0, 3.2));\n                        h.a = to;\n                    }\n                }\n            }\n        }\n        let embers: Vec<u32> = self.hazards.iter().filter(|h| h.kind == Kind::Ember).map(|h| h.id).collect();\n        let coals = self.hazards.iter().any(|h| h.kind == Kind::Object && h.sub == sub::COAL);\n        match s.step {\n            0 => {\n                // Midway two embers merge and roam.\n                if !s.merged && embers.len() == 3 && s.count == 0 {\n                    s.merged = true;\n                    let (a, b) = (embers[0], embers[1]);\n                    let mid = {\n                        let pa = self.find(a).map(|k| self.hazards[k].a).unwrap_or_default();\n                        let pb = self.find(b).map(|k| self.hazards[k].a).unwrap_or_default();\n                        (pa + pb) * 0.5\n                    };\n                    self.hazards.retain(|h| h.id != a && h.id != b);\n                    self.add(ember(mid, sub::ROAMING));\n                    self.mark(\"dies:merge\");\n                    self.cue(cue::STING, mid, 1.0, 0.8);\n                    self.say(\"teddy\", \"Two of them just became one and it's walking. Pet, it's walking!\");\n                }\n                if embers.is_empty() && !coals {\n                    if s.mini {\n                        self.fever = None;\n                        self.strain = None;\n                        return;\n                    }\n                    // An incision reveals the furnace beneath.\n                    let a = Vec2::new(-3.0, 1.2);\n                    let b = Vec2::new(3.0, -1.0);\n                    self.add(Hazard { kind: Kind::Incision, a, b, c: Vec2::new(0.0, 1.0), blocking: true, ..Default::default() });\n                    self.say(\"pet\", \"There it is. Under the sac. The whole furnace. Open her up.\");\n                    s.step = 1;\n                }\n            }\n            1 => {\n                if !self.hazards.iter().any(|h| h.kind == Kind::Incision) {\n                    s.hazard_id = self.add(Hazard {\n                        kind: Kind::Furnace,\n                        a: Vec2::new(0.0, 0.0),\n                        r: 1.3,\n                        ang: -1.2,\n                        drain: 0.5,\n                        blocking: true,\n                        fill_time: 0.9,\n                        ..Default::default()\n                    });\n                    self.set_banner(\"THE FURNACE\");\n                    self.cue(cue::STING, Vec2::ZERO, 1.2, 0.6);\n                    s.step = 2;\n                }\n            }\n            _ => {\n                if !self.hazards.iter().any(|h| h.kind == Kind::Furnace) {\n                    self.fever = Some(self.fever.unwrap_or(0.0).min(40.0));\n                    self.strain = None;\n                    let _ = rules;\n                    return;\n                }\n            }\n        }\n        self.strain = Some(s);\n    }\n\n    fn soloist_tick(&mut self, r_wave: bool, worth: f32, _rules: &Rules) {\n        let Some(mut s) = self.strain.take() else { return };\n        let dt = 1.0 / 60.0;\n        let mut missed = 0;\n        self.hazards.retain_mut(|h| {\n            if h.kind == Kind::Incision && h.sub == sub::STROKE && h.deadline > 0.0 {\n                h.deadline -= dt;\n                if h.deadline <= 0.0 {\n                    missed += 1;\n                    return false;\n                }\n            }\n            true\n        });\n        if missed > 0 {\n            self.vitals -= 3.0 * missed as f32;\n            for slot in &mut self.slots {\n                slot.chain = 0;\n            }\n            self.call(\"stroke_missed\");\n        }\n        if r_wave {\n            s.beats -= worth;\n            let live = self.hazards.iter().filter(|h| h.kind == Kind::Incision && h.sub == sub::STROKE).count() as u16;\n            if s.beats <= 0.0 && s.done + live < s.need {\n                s.beats = 2.0;\n                // A stroke on the beat, somewhere on the muscle.\n                let a = self.rng.f32() * std::f32::consts::TAU;\n                let centre = Vec2::new(self.rng.range(-3.2, 3.2), self.rng.range(-1.6, 1.8));\n                let d = Vec2::from_angle(a) * 1.5;\n                let (p, q) = (centre - d, centre + d);\n                self.add(Hazard {\n                    kind: Kind::Incision,\n                    sub: sub::STROKE,\n                    a: p,\n                    b: q,\n                    c: (p + q) * 0.5,\n                    blocking: true,\n                    deadline: (5.0 * beat_secs(self)).max(3.2),\n                    ..Default::default()\n                });\n                self.cue(cue::STING, centre, 0.5, 1.5);\n            }\n            // The Duet window opens at the half.\n            if s.done >= s.need / 2 && !s.woke {\n                s.woke = true;\n                self.slots[0].gift = 100.0;\n                self.say(\"pet\", \"Now, girl. Both of us. On the beat.\");\n                self.mark(\"duet:window\");\n            }\n        }\n        if s.done >= s.need && self.hazards.iter().all(|h| h.sub != sub::STROKE || h.kind != Kind::Incision) {\n            self.strain = None;\n            return;\n        }\n        self.strain = Some(s);\n    }\n\n    fn tendril_tick(&mut self, _world: f32) {\n        let Some(s) = self.strain.take() else { return };\n        if self.find(s.hazard_id).is_none() {\n            self.strain = None;\n            return;\n        }\n        self.strain = Some(s);\n    }\n\n    /// Code Blue: waves from the hazard set; a budget for the team's size; rising tempo every 30\n    /// seconds; a small strain encounter at the end.\n    fn director_tick(&mut self, world: f32, _r_wave: bool, rules: &Rules) {\n        let Some(mut s) = self.strain.take() else { return };\n        s.t += world;\n        s.beats -= world;\n        let n = self.slots.iter().filter(|x| x.active).count().max(1) as f32;\n        let budget = s.budget * (0.6 + 0.4 * n);\n        let tempo = 1.0 + (s.t / 30.0).floor() * 0.11;\n        let left = self.timer;\n        if s.beats <= 0.0 {\n            s.beats = s.interval / (tempo * budget);\n            let hazards_now = self.hazards.iter().filter(|h| h.kind != Kind::Pool).count();\n            if hazards_now < (6.0 + n * 3.0) as usize {\n                self.director_spawn(&s, tempo);\n            }\n        }\n        // The last 35 seconds: Introit, in small.\n        if left < 35.0 && s.step == 0 {\n            s.step = 1;\n            self.say(\"bashir\", \"It's waltzing. In this patient too. Everyone, scanner up.\");\n            self.set_banner(\"SOMETHING MOVED\");\n            self.cue(cue::STING, Vec2::ZERO, 1.0, 1.0);\n            self.heart.meter = 3;\n            for k in 0..(1 + n as usize) {\n                let at = Vec2::new(-3.5 + k as f32 * 2.2, -1.0 + (k % 2) as f32 * 2.2);\n                self.add(nodule(at, sub::SMALL, false, 0.6));\n                self.mark(\"director:strain\");\n            }\n        }\n        let worth = beat_worth(self, rules);\n        self.step_nodules(self.heart.r_wave, worth);\n        self.strain = Some(s);\n    }\n\n    fn director_spawn(&mut self, s: &Strain, tempo: f32) {\n        let at = Vec2::new(self.rng.range(-7.0, 7.0), self.rng.range(-3.5, 3.6));\n        let ang = self.rng.f32() * std::f32::consts::TAU;\n        let roll = self.rng.below(if tempo > 1.3 { 8 } else { 6 });\n        let dir = Vec2::from_angle(ang);\n        let _ = s;\n        match roll {\n            0 => {\n                let len = self.rng.range(1.4, 2.6);\n                self.add(Hazard {\n                    kind: Kind::Lacer,\n                    a: at - dir * len * 0.5,\n                    b: at + dir * len * 0.5,\n                    drain: 0.5,\n                    need: stitches_for(len),\n                    ..Default::default()\n                });\n            }\n            1 => {\n                self.add(Hazard { kind: Kind::Pool, a: at, r: self.rng.range(0.6, 1.1), ..Default::default() });\n            }\n            2 => {\n                let sub_ = self.rng.below(3) as u8;\n                self.add(Hazard { kind: Kind::Object, a: at, ang, r: 0.45, sub: sub_, drain: 0.15, ..Default::default() });\n            }\n            3 => {\n                self.add(Hazard { kind: Kind::Polyp, a: at, r: 0.5, drain: 0.1, ..Default::default() });\n            }\n            4 => {\n                self.add(Hazard { kind: Kind::Patch, a: at, r: 0.9, drain: 0.15, ..Default::default() });\n            }\n            5 => {\n                let d = Vec2::from_angle(ang) * 0.7;\n                self.add(Hazard { kind: Kind::Bleeder, a: at - d, b: at + d, drain: 1.5, need: 3, ..Default::default() });\n            }\n            6 => {\n                let (p, q) = (at - dir * 1.5, at + dir * 1.5);\n                self.add(Hazard { kind: Kind::Incision, a: p, b: q, c: (p + q) * 0.5 + dir.perp() * 0.5, ..Default::default() });\n            }\n            _ => {\n                self.add(Hazard { kind: Kind::Object, a: at, ang, r: 0.45, hidden: true, sub: 1, drain: 0.2, ..Default::default() });\n            }\n        }\n    }\n\n    /// A strain part finished a stage.\n    pub(super) fn strain_done(&mut self, id: u32, kind: Kind, stage: u8, _rating: Rating, rules: &Rules) {\n        let Some(k) = self.find(id) else { return };\n        let at = self.hazards[k].a;\n        match kind {\n            Kind::Nodule => {\n                if stage == 0 {\n                    let h = &mut self.hazards[k];\n                    h.stage = 1;\n                    h.beats = 0.0;\n                    h.telegraph = false;\n                    h.fill = 0.0;\n                    self.cue(cue::CRACK, at, 1.0, 1.1);\n                    self.call(\"shell_popped\");\n                    if rules.one_hit {\n                        self.hazards.remove(k);\n                    }\n                } else {\n                    self.hazards.remove(k);\n                    self.cue(cue::BURST, at, 0.7, 1.4);\n                    self.stains.push(super::field::Stain { at, r: 0.55, kind: 0 });\n                }\n            }\n            Kind::Sac => {\n                self.hazards.remove(k);\n                self.flights.push(super::field::Flight { from: at, sub: 5, kind, t: 0.0 });\n                self.cue(cue::SQUISH, at, 1.0, 1.2);\n            }\n            Kind::Eye => {\n                self.hazards.remove(k);\n                self.flights.push(super::field::Flight { from: at, sub: 6, kind, t: 0.0 });\n                self.cue(cue::BURST, at, 1.0, 0.7);\n            }\n            Kind::Ember => {\n                if stage == 0 {\n                    let h = &mut self.hazards[k];\n                    h.stage = 1;\n                    h.fill = 0.0;\n                    self.cue(cue::FROST, at, 1.0, 1.4);\n                } else {\n                    // Cracked: three pieces to pull. Each one cools the Fever.\n                    let (big, base) = (self.hazards[k].sub == sub::ROAMING, self.hazards[k].a);\n                    self.hazards.remove(k);\n                    let pieces = if big { 5 } else { 3 };\n                    for p in 0..pieces {\n                        let a = p as f32 / pieces as f32 * std::f32::consts::TAU;\n                        self.add(Hazard {\n                            kind: Kind::Object,\n                            sub: sub::COAL,\n                            a: base + Vec2::from_angle(a) * 0.75,\n                            ang: a,\n                            r: 0.32,\n                            blocking: true,\n                            ..Default::default()\n                        });\n                    }\n                    self.mark(\"dies:crack\");\n                }\n            }\n            Kind::Furnace => {\n                let h = &mut self.hazards[k];\n                h.prog = 0.0;\n                h.fill = 0.0;\n                h.c = Vec2::ZERO;\n                if stage >= 5 {\n                    self.hazards.remove(k);\n                    self.cue(cue::BURST, at, 1.2, 0.6);\n                    self.shake = 0.8;\n                } else {\n                    h.stage += 1;\n                    self.mark(&format!(\"furnace:{stage}\"));\n                    self.cue(cue::STING, at, 0.6, 1.0 + stage as f32 * 0.1);\n                }\n            }\n            Kind::Tendril => {\n                self.hazards.remove(k);\n                self.flights.push(super::field::Flight { from: at, sub: 7, kind, t: 0.0 });\n                self.shake = 1.0;\n            }\n            _ => {}\n        }\n    }\n}\n\nfn nodule(at: Vec2, sub_: u8, hidden: bool, fill: f32) -> Hazard {\n    Hazard { kind: Kind::Nodule, sub: sub_, a: at, r: 0.55, hidden, fill_time: fill, ang: 0.6, drain: 0.35, blocking: true, ..Default::default() }\n}\n\nfn ember(at: Vec2, sub_: u8) -> Hazard {\n    Hazard { kind: Kind::Ember, sub: sub_, a: at, r: if sub_ == sub::ROAMING { 0.75 } else { 0.55 }, drain: 0.2, blocking: true, ..Default::default() }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01NXXaaRvY7AYSbJmiLLPkaN","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
