s/pav_tools/src/game_tools.rs\n   1517 crates/pav_tools/src/game_tools.rs\n    226 crates/pav_tools/src/hall.rs\n    226 crates/pav_tools/src/hall.rs\n     31 crates/pav_tools/src/lib.rs\n     31 crates/pav_tools/src/lib.rs\n    197 crates/pav_tools/src/live_feedback.rs\n    197 crates/pav_tools/src/live_feedback.rs\n    921 crates/pav_tools/src/material_tools.rs\n    921 crates/pav_tools/src/material_tools.rs\n    133 crates/pav_tools/src/mcp.rs\n    133 crates/pav_tools/src/mcp.rs\n     70 crates/pav_tools/src/play_tools.rs\n     70 crates/pav_tools/src/play_tools.rs\n    302 crates/pav_tools/src/preview_tools.rs\n    302 crates/pav_tools/src/preview_tools.rs\n     64 crates/pav_tools/src/reply.rs\n     64 crates/pav_tools/src/reply.rs\n    436 crates/pav_tools/src/session.rs\n    436 crates/pav_tools/src/session.rs\n   1861 crates/pav_tools/src/tools.rs\n   1861 crates/pav_tools/src/tools.rs\n     17 crates/pav_ui/Cargo.toml\n   1228 crates/pav_ui/src/arpg_items.rs\n   1228 crates/pav_ui/src/arpg_items.rs\n    430 crates/pav_ui/src/arpg_tree.rs\n    430 crates/pav_ui/src/arpg_tree.rs\n    768 crates/pav_ui/src/arpg_ui.rs\n    768 crates/pav_ui/src/arpg_ui.rs\n    369 crates/pav_ui/src/headless.rs\n    369 crates/pav_ui/src/headless.rs\n     62 crates/pav_ui/src/lib.rs\n     62 crates/pav_ui/src/lib.rs\n   1004 crates/pav_ui/src/touch.rs\n   1004 crates/pav_ui/src/touch.rs\n     18 crates/pav_view/Cargo.toml\n    583 crates/pav_view/src/arpg.rs\n    583 crates/pav_view/src/arpg.rs\n    513 crates/pav_view/src/assets.rs\n    513 crates/pav_view/src/assets.rs\n   2405 crates/pav_view/src/build.rs\n   2405 crates/pav_view/src/build.rs\n    216 crates/pav_view/src/camera.rs\n    216 crates/pav_view/src/camera.rs\n    135 crates/pav_view/src/creatures.rs\n    135 crates/pav_view/src/creatures.rs\n    480 crates/pav_view/src/fx.rs\n    480 crates/pav_view/src/fx.rs\n     15 crates/pav_view/src/lib.rs\n     15 crates/pav_view/src/lib.rs\n    353 crates/pav_view/src/look.rs\n    353 crates/pav_view/src/look.rs\n    736 crates/pav_view/src/looks.toml\n    415 crates/pav_view/src/materials.rs\n    415 crates/pav_view/src/materials.rs\n    201 crates/pav_view/src/vehicles.rs\n    201 crates/pav_view/src/vehicles.rs\n    300 crates/pav_view/src/water.rs\n    300 crates/pav_view/src/water.rs\n      7 scripts/animation-studio.ps1\n      6 scripts/animation-studio.sh\n      7 scripts/asset-studio.ps1\n      6 scripts/asset-studio.sh\n     46 scripts/build-web.sh\n      6 scripts/build-windows.sh\n    182 scripts/check-creature-templates.py\n     34 scripts/check-handoff.sh\n     89 scripts/check-wgsl.sh\n     10 scripts/creature-studio.ps1\n      8 scripts/creature-studio.sh\n    150 scripts/pack_single_html.py\n     38 scripts/package-agent.sh\n     94 scripts/package-animation-studio.py\n    182 scripts/package-studio.py\n    318 scripts/review_page.py\n     11 scripts/setup-linux.sh\n    232 scripts/smoke-animation-studio.py\n    285 scripts/smoke-asset-studio.py\n    305 scripts/smoke-creature-studio.py\n     20 scripts/smoke-linux.sh\n     23 scripts/smoke-windows.sh\n  97932 total\n     75 web/index.html\n     10 web/manifest.webmanifest\n//! Games built on the engine: the hook a new game implements, and the list of games.\n//!\n//! A game is a struct holding its rules' state (`Clone` and serde, like everything in\n//! `SimState`) that implements [`Game`], plus a `build` function that makes its scene. One\n//! line in [`GAMES`] and `load scene=<key>` starts it in the tools, the window\n//! (`shardfall --scene <key>`) and the browser (`?scene=<key>`). `starter.rs` is the template\n//! to copy; `docs/MAKE_A_GAME.md` is the guide. Shardfall (`crate::arpg`) predates this hook and\n//! keeps its own.\n\nuse std::any::Any;\nuse std::collections::BTreeMap;\n\nuse anyhow::Result;\nuse serde::de::{DeserializeOwned, Error as _};\nuse serde::{Deserialize, Deserializer, Serialize, Serializer};\n\nuse crate::entity::EntityId;\nuse crate::frame::SimEvent;\nuse crate::input::InputFrame;\nuse crate::sim::Sim;\n\npub mod starter;\n\n/// Every game the engine knows. `load scene=<key>` (or `<key>/<rest>`) builds it.\npub static GAMES: &[Entry] =\n    &[entry::<starter::Starter>(\"Starter: collect every shard while slimes chase you (the template to copy).\", starter::build)];\n\n/// Still playing, won or lost.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum Outcome {\n    #[default]\n    Playing,\n    Won,\n    Lost,\n}\n\n/// A game's rules. Every method has a default, so a game implements only what it uses.\n///\n/// The engine calls `pre` and `post` once per tick (60 a second) from `Sim::step`; everything\n/// else is read-only. While `pre` or `post` runs, the game is out of `sim.state.play`, so use\n/// `self` for the game's own state and `sim` for the world.\npub trait Game: Clone + Serialize + DeserializeOwned + Send + Sync + 'static {\n    /// The scene key that starts the game: `load scene=<KEY>`, `--scene <KEY>`, `?scene=<KEY>`.\n    const KEY: &'static str;\n\n    /// Before characters move: read the player's input and decide what the characters the\n    /// game drives do this tick. A returned input replaces that character's own (its `ai`\n    /// brain, or the player's keys for the player).\n    fn pre(\n        &mut self,\n        _sim: &mut Sim,\n        _input: &InputFrame,\n        _dt: f32,\n        _events: &mut Vec<SimEvent>,\n    ) -> BTreeMap<EntityId, InputFrame> {\n        BTreeMap::new()\n    }\n\n    /// After physics: the rules (pickups, damage, score, win and loss). Push `SimEvent`s for\n    /// sounds and effects (`Coin`, `Pickup`, `Hit`, `Explosion`...).\n    fn post(&mut self, _sim: &mut Sim, _dt: f32, _events: &mut Vec<SimEvent>) {}\n\n    /// HUD lines: drawn at the top left of the window, returned by the `play` tool.\n    fn hud(&self, _sim: &Sim) -> Vec<String> {\n        Vec::new()\n    }\n\n    /// The game's state for tools and tests (`play`), as JSON.\n    fn status(&self, _sim: &Sim) -> serde_json::Value {\n        serde_json::Value::Null\n    }\n\n    fn outcome(&self) -> Outcome {\n        Outcome::Playing\n    }\n\n    /// The input a good player would give this tick. `play bot=true` and the tests drive the\n    /// player with it; teach it every new rule, and keep a test that it wins.\n    fn bot(&self, _sim: &Sim) -> InputFrame {\n        InputFrame::default()\n    }\n}\n\n/// One line of [`GAMES`]: made with [`entry`].\npub struct Entry {\n    pub key: &'static str,\n    pub about: &'static str,\n    /// Builds the scene and sets `sim.state.play`. The `&str` is the rest of the scene name\n    /// after `<key>/` (a level number, say), if any.\n    pub build: fn(&mut Sim, Option<&str>) -> Result<()>,\n    load: fn(ciborium::Value) -> Result<GameBox, String>,\n}\n\n/// A [`GAMES`] line for the game type `G`.\npub const fn entry<G: Game>(about: &'static str, build: fn(&mut Sim, Option<&str>) -> Result<()>) -> Entry {\n    Entry { key: G::KEY, about, build, load: load_as::<G> }\n}\n\nfn load_as<G: Game>(v: ciborium::Value) -> Result<GameBox, String> {\n    v.deserialized::<G>().map(GameBox::new).map_err(|e| e.to_string())\n}\n\n/// A game's level text: `crates/pav_core/src/games/<key>.toml` read from disk when the program\n/// runs from the repository's root (`pav`, `cargo run`), so an edit shows at the next `load`\n/// with no rebuild; else `built_in`, the copy embedded with `include_str!` (tests, the browser,\n/// a shipped executable).\npub fn level_text(key: &str, built_in: &'static str) -> std::borrow::Cow<'static, str> {\n    #[cfg(not(target_arch = \"wasm32\"))]\n    if let Ok(text) = std::fs::read_to_string(format!(\"crates/pav_core/src/games/{key}.toml\")) {\n        return text.into();\n    }\n    #[cfg(target_arch = \"wasm32\")]\n    let _ = key; // the browser has no files\n    built_in.into()\n}\n\n/// The game registered under `key`.\npub fn find(key: &str) -> Option<&'static Entry> {\n    GAMES.iter().find(|g| g.key == key)\n}\n\n/// A running game in `SimState::play`: clones (rewind, snapshots) and serializes (snapshot\n/// files, the state hash) through the game's own derives.\npub struct GameBox(Box<dyn DynGame>);\n\nimpl GameBox {\n    pub fn new<G: Game>(game: G) -> Self {\n        Self(Box::new(game))\n    }\n\n    pub fn key(&self) -> &'static str {\n        self.0.key()\n    }\n\n    /// The game as its own type (None for another game).\n    pub fn get<G: Game>(&self) -> Option<&G> {\n        self.0.as_any().downcast_ref()\n    }\n\n    pub fn get_mut<G: Game>(&mut self) -> Option<&mut G> {\n        self.0.as_any_mut().downcast_mut()\n    }\n\n    pub fn hud(&self, sim: &Sim) -> Vec<String> {\n        self.0.hud(sim)\n    }\n\n    pub fn status(&self, sim: &Sim) -> serde_json::Value {\n        self.0.status(sim)\n    }\n\n    pub fn outcome(&self) -> Outcome {\n        self.0.outcome()\n    }\n\n    pub fn bot(&self, sim: &Sim) -> InputFrame {\n        self.0.bot(sim)\n    }\n}\n\nimpl Clone for GameBox {\n    fn clone(&self) -> Self {\n        Self(self.0.clone_box())\n    }\n}\n\n#[derive(Serialize, Deserialize)]\nstruct Saved {\n    key: String,\n    state: ciborium::Value,\n}\n\nimpl Serialize for GameBox {\n    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {\n        let state = self.0.save().map_err(serde::ser::Error::custom)?;\n        Saved { key: self.key().to_string(), state }.serialize(s)\n    }\n}\n\nimpl<'de> Deserialize<'de> for GameBox {\n    fn deserialize<D: Deserializer<'de>>(d: D) -> Result<Self, D::Error> {\n        let saved = Saved::deserialize(d)?;\n        let Some(entry) = find(&saved.key) else {\n            let known: Vec<&str> = GAMES.iter().map(|g| g.key).collect();\n            return Err(D::Error::custom(format!(\"unknown game '{}' (known: {})\", saved.key, known.join(\", \"))));\n        };\n        (entry.load)(saved.state).map_err(D::Error::custom)\n    }\n}\n\n/// [`Game`] as an object (the trait itself isn't one: `Clone` and serde).\ntrait DynGame: Send + Sync {\n    fn key(&self) -> &'static str;\n    fn clone_box(&self) -> Box<dyn DynGame>;\n    fn save(&self) -> Result<ciborium::Value, String>;\n    fn pre(&mut self, sim: &mut Sim, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) -> BTreeMap<EntityId, InputFrame>;\n    fn post(&mut self, sim: &mut Sim, dt: f32, events: &mut Vec<SimEvent>);\n    fn hud(&self, sim: &Sim) -> Vec<String>;\n    fn status(&self, sim: &Sim) -> serde_json::Value;\n    fn outcome(&self) -> Outcome;\n    fn bot(&self, sim: &Sim) -> InputFrame;\n    fn as_any(&self) -> &dyn Any;\n    fn as_any_mut(&mut self) -> &mut dyn Any;\n}\n\nimpl<G: Game> DynGame for G {\n    fn key(&self) -> &'static str {\n        G::KEY\n    }\n    fn clone_box(&self) -> Box<dyn DynGame> {\n        Box::new(self.clone())\n    }\n    fn save(&self) -> Result<ciborium::Value, String> {\n        ciborium::Value::serialized(self).map_err(|e| e.to_string())\n    }\n    fn pre(&mut self, sim: &mut Sim, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) -> BTreeMap<EntityId, InputFrame> {\n        Game::pre(self, sim, input, dt, events)\n    }\n    fn post(&mut self, sim: &mut Sim, dt: f32, events: &mut Vec<SimEvent>) {\n        Game::post(self, sim, dt, events)\n    }\n    fn hud(&self, sim: &Sim) -> Vec<String> {\n        Game::hud(self, sim)\n    }\n    fn status(&self, sim: &Sim) -> serde_json::Value {\n        Game::status(self, sim)\n    }\n    fn outcome(&self) -> Outcome {\n        Game::outcome(self)\n    }\n    fn bot(&self, sim: &Sim) -> InputFrame {\n        Game::bot(self, sim)\n    }\n    fn as_any(&self) -> &dyn Any {\n        self\n    }\n    fn as_any_mut(&mut self) -> &mut dyn Any {\n        self\n    }\n}\n\nimpl Sim {\n    /// The running game from [`GAMES`], if this scene is one.\n    pub fn play(&self) -> Option<&GameBox> {\n        self.state.play.as_ref()\n    }\n\n    /// The running game's outcome (`Playing` when there is none).\n    pub fn outcome(&self) -> Outcome {\n        self.play().map(|g| g.outcome()).unwrap_or_default()\n    }\n\n    /// The running game's bot input (none without a game).\n    pub fn bot_input(&self) -> InputFrame {\n        self.play().map(|g| g.bot(self)).unwrap_or_default()\n    }\n\n    pub(crate) fn play_pre(&mut self, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) -> BTreeMap<EntityId, InputFrame> {\n        let Some(mut g) = self.state.play.take() else { return BTreeMap::new() };\n        let out = g.0.pre(self, input, dt, events);\n        self.state.play = Some(g);\n        out\n    }\n\n    pub(crate) fn play_post(&mut self, dt: f32, events: &mut Vec<SimEvent>) {\n        let Some(mut g) = self.state.play.take() else { return };\n        g.0.post(self, dt, events);\n        self.state.play = Some(g);\n    }\n\n    pub(crate) fn play_hud(&self) -> Vec<String> {\n        self.play().map(|g| g.hud(self)).unwrap_or_default()\n    }\n\n    /// Plays the running game with its bot until it is won or lost, or `ticks` pass.\n    /// Returns the outcome and the ticks played.\n    pub fn run_bot(&mut self, ticks: u64) -> (Outcome, u64) {\n        for t in 0..ticks {\n            let o = self.outcome();\n            if o != Outcome::Playing {\n                return (o, t);\n            }\n            let input = self.bot_input();\n            self.step(&input);\n        }\n        (self.outcome(), ticks)\n    }\n}\n//! Device-independent input for one simulation tick. The host (window, agent, replay) fills\n//! it; the simulation never sees devices. Directions are already in world space.\n\nuse glam::{Vec2, Vec3};\nuse serde::{Deserialize, Serialize};\n\npub mod buttons {\n    pub const JUMP: u32 = 1 << 0;\n    pub const CROUCH: u32 = 1 << 1;\n    pub const INTERACT: u32 = 1 << 2;\n    pub const USE: u32 = 1 << 3;\n    pub const FOCUS: u32 = 1 << 4;\n    pub const SPRINT: u32 = 1 << 5;\n    pub const PRIMARY: u32 = 1 << 6;\n    pub const SECONDARY: u32 = 1 << 7;\n    pub const CRAWL: u32 = 1 << 8;\n    /// Shardfall: skill slots 3-6 (slots 1-2 are PRIMARY / SECONDARY), dodge and potion.\n    pub const SKILL3: u32 = 1 << 9;\n    pub const SKILL4: u32 = 1 << 10;\n    pub const SKILL5: u32 = 1 << 11;\n    pub const SKILL6: u32 = 1 << 12;\n    pub const DODGE: u32 = 1 << 13;\n    pub const POTION: u32 = 1 << 14;\n\n    pub const NAMES: &[(&str, u32)] = &[\n        (\"jump\", JUMP),\n        (\"crouch\", CROUCH),\n        (\"interact\", INTERACT),\n        (\"use\", USE),\n        (\"focus\", FOCUS),\n        (\"sprint\", SPRINT),\n        (\"primary\", PRIMARY),\n        (\"secondary\", SECONDARY),\n        (\"crawl\", CRAWL),\n        (\"skill3\", SKILL3),\n        (\"skill4\", SKILL4),\n        (\"skill5\", SKILL5),\n        (\"skill6\", SKILL6),\n        (\"dodge\", DODGE),\n        (\"potion\", POTION),\n    ];\n\n    pub fn from_name(n: &str) -> Option<u32> {\n        NAMES.iter().find(|(k, _)| k.eq_ignore_ascii_case(n)).map(|(_, v)| *v)\n    }\n}\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct InputFrame {\n    /// Desired movement on the ground plane: x = world +X, y = world +Z. Length <= 1.\n    pub move_dir: Vec2,\n    /// Vertical intent for climbing/flying/swimming (-1..1).\n    #[serde(default)]\n    pub vertical: f32,\n    /// World-space aim point (mouse on the ground plane, or stick projection).\n    #[serde(default)]\n    pub aim: Option<Vec3>,\n    /// Buttons held this tick.\n    #[serde(default)]\n    pub held: u32,\n    /// Buttons that went down since the previous tick (never lost, even for short taps).\n    #[serde(default)]\n    pub pressed: u32,\n    /// A menu action this tick (Shardfall: equip, sell, travel...), queued one per tick.\n    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    pub cmd: Option<crate::arpg::GameCmd>,\n}\n\nimpl InputFrame {\n    pub fn down(&self, b: u32) -> bool {\n        self.held & b != 0\n    }\n    pub fn just(&self, b: u32) -> bool {\n        self.pressed & b != 0\n    }\n}\n//! What the simulation publishes for rendering each tick. Cheap to clone (static geometry is\n//! shared through `Arc`s).\n\nuse glam::{Quat, Vec3};\nuse serde::{Deserialize, Serialize};\n\nuse crate::entity::EntityId;\nuse crate::puppet::{PuppetDef, PuppetState};\nuse crate::shape::Visual;\nuse crate::statics::StaticWorld;\n\n/// Animation state of a character, drawn as a puppet.\n#[derive(Clone, Debug)]\npub struct PuppetFrame {\n    pub state: PuppetState,\n    /// Distance from the entity position (capsule centre) down to the feet.\n    pub feet_offset: f32,\n    /// Own look (NPCs); None = `RenderFrame::puppet_def`.\n    pub def: Option<std::sync::Arc<PuppetDef>>,\n    /// Creature feet and swinging chains.\n    pub rig: Option<crate::rig::RigView>,\n    /// Colour wash (hit flash, frozen, burning...) and its strength.\n    pub tint: Option<([f32; 3], f32)>,\n}\n\n#[derive(Clone, Debug)]\npub struct RenderObject {\n    pub id: EntityId,\n    pub pos: Vec3,\n    pub rot: Quat,\n    pub visual: Visual,\n    /// Immutable parts belonging to this one object ID.\n    pub prop: Option<crate::prop_instance::PropFrame>,\n    pub puppet: Option<PuppetFrame>,\n    /// Blink/highlight driver: bomb fuse seconds left, or < 0 for none.\n    pub pulse: f32,\n    /// Deformable body: particle positions and how to draw them.\n    pub soft: Option<SoftView>,\n    /// Car / helicopter parts (wheels, rotors).\n    pub vehicle: Option<crate::vehicle::VehicleView>,\n    /// A guard's vision cone.\n    pub cone: Option<crate::stealth::ConeView>,\n    /// Fixed scenery (no character, never moves, not a game actor): view filters treat it\n    /// as part of the environment rather than the characters and objects.\n    pub scenery: bool,\n}\n\n#[derive(Clone, Debug)]\npub struct SoftView {\n    pub points: Vec<Vec3>,\n    /// Surface triangles (cubes, balls, cloth); empty for ropes.\n    pub surface: std::sync::Arc<Vec<[u32; 3]>>,\n    /// Rope segments.\n    pub segments: std::sync::Arc<Vec<[u32; 2]>>,\n    /// Rope thickness.\n    pub radius: f32,\n    /// Sheets are seen from both sides.\n    pub two_sided: bool,\n}\n\n/// Things that happened during a tick, for sound and effects.\n#[derive(Clone, Debug, Serialize, Deserialize, PartialEq)]\n#[serde(tag = \"type\", rename_all = \"snake_case\")]\npub enum SimEvent {\n    Spawned {\n        id: EntityId,\n        pos: Vec3,\n    },\n    Impact {\n        pos: Vec3,\n        strength: f32,\n    },\n    Jump {\n        pos: Vec3,\n    },\n    Land {\n        pos: Vec3,\n        speed: f32,\n    },\n    Explosion {\n        pos: Vec3,\n        radius: f32,\n    },\n    Step {\n        pos: Vec3,\n    },\n    Throw {\n        pos: Vec3,\n    },\n    EnterRoom {\n        room: u16,\n    },\n    ExitRoom {\n        room: u16,\n    },\n    Hit {\n        pos: Vec3,\n        strength: f32,\n        /// The character struck, when it is one.\n        #[serde(default)]\n        target: Option<EntityId>,\n    },\n    Respawn {\n        pos: Vec3,\n    },\n    CourseStart {\n        pos: Vec3,\n    },\n    CourseFinish {\n        pos: Vec3,\n        time: f32,\n        new_best: bool,\n    },\n    Gate {\n        pos: Vec3,\n        ok: bool,\n    },\n    Checkpoint {\n        pos: Vec3,\n    },\n    Splash {\n        pos: Vec3,\n    },\n    Pad {\n        pos: Vec3,\n    },\n    /// A blaster shot, an enemy hit, an enemy destroyed.\n    Shot {\n        pos: Vec3,\n    },\n    Damage {\n        pos: Vec3,\n    },\n    Destroyed {\n        pos: Vec3,\n        size: f32,\n    },\n    /// A guard raised the alarm.\n    Spotted {\n        pos: Vec3,\n    },\n    Grab {\n        pos: Vec3,\n    },\n    Roll {\n        pos: Vec3,\n    },\n    /// A tile starts crumbling / breaks.\n    Crack {\n        pos: Vec3,\n    },\n    Break {\n        pos: Vec3,\n    },\n    Bounce {\n        pos: Vec3,\n    },\n    /// Shardfall: a weapon swing, a hit landing (power = damage, element index), a kill, a\n    /// slam, a spell cast, an explosion, gold, a potion, a block, a level-up.\n    Swing {\n        pos: Vec3,\n        heavy: bool,\n    },\n    Strike {\n        pos: Vec3,\n        power: f32,\n        element: u8,\n        crit: bool,\n    },\n    Slain {\n        pos: Vec3,\n        size: f32,\n    },\n    Slam {\n        pos: Vec3,\n        radius: f32,\n    },\n    Spell {\n        pos: Vec3,\n        element: u8,\n    },\n    Blast {\n        pos: Vec3,\n        element: u8,\n    },\n    Coin {\n        pos: Vec3,\n    },\n    Potion {\n        pos: Vec3,\n    },\n    Block {\n        pos: Vec3,\n    },\n    LevelUp {\n        pos: Vec3,\n    },\n    /// An item dropped (rarity 0 normal .. 3 unique) or was picked up.\n    Loot {\n        pos: Vec3,\n        rarity: u8,\n    },\n    Pickup {\n        pos: Vec3,\n        rarity: u8,\n    },\n    /// Arrived somewhere else (Shardfall place code).\n    Travel {\n        place: u32,\n    },\n}\n\n/// The room the player is in, for the HUD (info card, control guide, camera defaults).\n#[derive(Clone, Debug)]\npub struct RoomInfo {\n    pub id: u16,\n    pub key: String,\n    pub def: std::sync::Arc<crate::room::RoomDef>,\n    /// Quarter turns (clockwise from above) the room was rotated by when placed.\n    pub quarters: u8,\n}\n\n/// A projectile as drawn (velocity lets the view interpolate).\n#[derive(Clone, Copy, Debug)]\npub struct ProjectileView {\n    pub pos: Vec3,\n    pub vel: Vec3,\n    pub radius: f32,\n    pub color: crate::color::Color,\n}\n\n/// Game state the HUD shows.\n#[derive(Clone, Debug, Default)]\npub struct HudFrame {\n    pub course: Option<crate::course::CourseHud>,\n    pub last_result: Option<crate::course::CourseResult>,\n    /// Short message and the tick it was posted.\n    pub message: Option<(String, u64)>,\n    pub feel: crate::feel::FeelReport,\n    /// Camera cue from pads / camera zones, and a counter that changes with it.\n    pub cue: Option<std::sync::Arc<crate::zones::CameraCue>>,\n    pub cue_serial: u64,\n    /// Player hit flash (seconds of invulnerability left).\n    pub invuln: f32,\n    pub model: String,\n    pub physics: PhysicsStats,\n    /// View settings from pads (applied on top of the room's), and a counter that changes.\n    pub view: std::collections::BTreeMap<String, crate::params::ParamValue>,\n    pub view_serial: u64,\n    /// Boss health bar: name and remaining fraction.\n    pub boss: Option<(String, f32)>,\n    /// The last pad with a note the player stepped on: label, note, tick.\n    pub pad_note: Option<(String, String, u64)>,\n    /// A `games` game's HUD lines (`Game::hud`).\n    pub lines: Vec<String>,\n}\n\n/// Physics counters for the stats overlay.\n#[derive(Clone, Copy, Debug, Default)]\npub struct PhysicsStats {\n    pub dynamic: usize,\n    pub sleeping: usize,\n    pub colliders: usize,\n    pub joints: usize,\n    pub soft_bodies: usize,\n    pub particles: usize,\n    pub contacts: usize,\n    pub projectiles: usize,\n}\n\n#[derive(Clone, Debug)]\npub struct RenderFrame {\n    pub tick: u64,\n    pub time: f64,\n    pub dt: f32,\n    /// Last accepted live edit included in this frame. View interpolation must not mix it\n    /// with an older revision before the application acknowledges drawing the ticket.\n    pub live_edit_ticket: u64,\n    pub objects: Vec<RenderObject>,\n    pub statics: StaticWorld,\n    /// Suggested camera focus (the player, or the scene centre).\n    pub focus: Vec3,\n    /// True when `focus` is a player character (enables cutaway/fade helpers).\n    pub focus_is_player: bool,\n    pub player: Option<EntityId>,\n    pub puppet_def: PuppetDef,\n    pub room: Option<RoomInfo>,\n    /// The simulation's configuration (shared; changes when rooms override parameters).\n    pub config: std::sync::Arc<crate::sim::SimConfig>,\n    pub events: Vec<SimEvent>,\n    pub projectiles: Vec<ProjectileView>,\n    pub hud: HudFrame,\n    /// Shardfall state for the view and HUD (None outside the game).\n    pub game: Option<std::sync::Arc<crate::arpg::GameFrame>>,\n    /// Agent-readable playback controls for the animation stage.\n    pub animation_preview: Option<crate::animation_preview::PreviewInfo>,\n    pub studio_mode: crate::prop_preview::StudioMode,\n    pub prop_preview: Option<crate::prop_preview::PropPreviewInfo>,\n    pub creature_preview: Option<crate::creature_preview::CreaturePreviewInfo>,\n    /// The generated native stage subject, separate from simulation entity geometry.\n    pub creature: Option<crate::creature_preview::CreatureFrame>,\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"1da0a618-e344-4f8e-9881-101e1009d34d","timestamp":"2026-11-05T14:24:43.326Z","tool_use_result":{"stdout":"     42 crates/pav_app/Cargo.toml\n    387 crates/pav_app/src/animation_ui.rs\n    387 crates/pav_app/src/animation_ui.rs\n    169 crates/pav_app/src/animation_watch.rs\n    169 crates/pav_app/src/animation_watch.rs\n   2266 crates/pav_app/src/app.rs\n   2266 crates/pav_app/src/app.rs\n    728 crates/pav_app/src/asset_ui.rs\n    728 crates/pav_app/src/asset_ui.rs\n    299 crates/pav_app/src/asset_watch.rs\n    299 crates/pav_app/src/asset_watch.rs\n    187 crates/pav_app/src/boot.rs\n    187 crates/pav_app/src/boot.rs\n    289 crates/pav_app/src/bridge.rs\n    289 crates/pav_app/src/bridge.rs\n    741 crates/pav_app/src/creature_ui.rs\n    741 crates/pav_app/src/creature_ui.rs\n    143 crates/pav_app/src/creature_watch.rs\n    143 crates/pav_app/src/creature_watch.rs\n    337 crates/pav_app/src/edit.rs\n    337 crates/pav_app/src/edit.rs\n    217 crates/pav_app/src/gfx.rs\n    217 crates/pav_app/src/gfx.rs\n    328 crates/pav_app/src/guide_ui.rs\n    328 crates/pav_app/src/guide_ui.rs\n    426 crates/pav_app/src/hud.rs\n    426 crates/pav_app/src/hud.rs\n    631 crates/pav_app/sr