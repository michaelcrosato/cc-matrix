rate::arpg::GameCmd>,\n    /// `games::surgery`: the surgeon seats.\n    #[serde(default, skip_serializing_if = \"no_surgeons\")]\n    pub surgeons: [SurgeonInput; 4],\n}\n\nfn no_surgeons(s: &[SurgeonInput; 4]) -> bool {\n    s.iter().all(|i| *i == SurgeonInput::default())\n}''')\nopen(p,'w').write(s)\n\np='crates/pav_core/src/frame.rs'; s=open(p).read()\ns=s.replace('''    /// Arrived somewhere else (Shardfall place code).\n    Travel {\n        place: u32,\n    },\n''','''    /// Arrived somewhere else (Shardfall place code).\n    Travel {\n        place: u32,\n    },\n    /// A named sound and effect of a game (`games::surgery::cue`): the table is the game's.\n    Cue {\n        id: u16,\n        pos: Vec3,\n        gain: f32,\n        pitch: f32,\n    },\n''')\ns=s.replace('''    pub game: Option<std::sync::Arc<crate::arpg::GameFrame>>,\n    /// Agent-readable''','''    pub game: Option<std::sync::Arc<crate::arpg::GameFrame>>,\n    /// The surgery game's state for the view and HUD: everything it draws.\n    pub surgery: Option<std::sync::Arc<crate::games::surgery::frame::SurgeryFrame>>,\n    /// Agent-readable''')\nopen(p,'w').write(s)\n\nfor p in ['crates/pav_core/src/prop_preview.rs','crates/pav_core/src/creature_preview.rs','crates/pav_core/src/animation_preview.rs']:\n    s=open(p).read(); s=re.sub(r'(\\n\\s*)game: None,', r'\\1game: None,\\1surgery: None,', s); open(p,'w').write(s)\np='crates/pav_core/src/sim.rs'; s=open(p).read()\ns=s.replace('''            game: self.state.game.as_ref().map(|g| std::sync::Arc::new(g.frame(self))),\n            animation_preview: None,''','''            game: self.state.game.as_ref().map(|g| std::sync::Arc::new(g.frame(self))),\n            surgery: crate::games::surgery::frame_of(self),\n            animation_preview: None,''')\nopen(p,'w').write(s)\np='crates/pav_core/src/games/mod.rs'; s=open(p).read()\ns=s.replace('''pub mod starter;\n''','''pub mod starter;\npub mod surgery;\n''')\ns=s.replace('''pub static GAMES: &[Entry] =\n    &[entry::<starter::Starter>(\"Starter: collect every shard while slimes chase you (the template to copy).\", starter::build)];''','''pub static GAMES: &[Entry] = &[\n    entry::<starter::Starter>(\"Starter: collect every shard while slimes chase you (the template to copy).\", starter::build),\n    entry::<surgery::Surgery>(\"A surgical-action melodrama: the patient's pulse keeps time for everything.\", surgery::build),\n];''')\nopen(p,'w').write(s)\np='crates/pav_tools/src/tools.rs'; s=open(p).read()\ns=s.replace('''            pressed: if i == 0 { press } else { 0 },\n            cmd: None,\n        };\n        s.sim.step(&f);''','''            pressed: if i == 0 { press } else { 0 },\n            cmd: None,\n            surgeons: Default::default(),\n        };\n        s.sim.step(&f);''')\nopen(p,'w').write(s)\nEOF\ngrep -rn \"cmd: None\\|InputFrame {\" crates --include=*.rs | grep -v \"^crates/pav_core/src/input.rs\\|default()\" | head; cat crates/pav_core/src/rng.rs | sed -n 1,52p; mkdir -p crates/pav_core/src/games/surgery/content/{cases,story,plates,rigs,sets}","description":"Open input, frame and game-registry seams; inspect RNG"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":18212,"cache_read_input_tokens":213461,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18212},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"f30085e9-cdd2-473d-a45a-584a07275984","timestamp":"2026-11-05T14:30:12.409Z","request_id":"req_011CgjwNwVomANWJh9TjfHix","wire_tool_inputs":{"toolu_01Ry6saN7ARDfnhLRTuqw25z":{"command":"cat >> ../../PROGRESS.md <<'EOF' 2>/dev/null || true\nEOF\ncd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-me