w').write(s)\np='crates/pav_app/src/product.rs'; s=open(p).read()\ns=s.replace('''    more_key: bool,\n    ready_tap: bool,\n}\n\nimpl Product {''','''    more_key: bool,\n    ready_tap: bool,\n    /// Tests on a software renderer: skip the 3D (a frame there takes seconds).\n    lite: bool,\n}\n\nimpl Product {''')\ns=s.replace('''            more_key: false,\n            ready_tap: false,\n        };''','''            more_key: false,\n            ready_tap: false,\n            lite: hub::lite(),\n        };''')\ns=s.replace('''            self.builder.surgery.looks = pav_view::surgery::Looks { clinical: s.clinical, reduce_flashes: s.reduce_flashes, no_shake: !s.shake, headless: server };''','''            self.builder.surgery.looks = pav_view::surgery::Looks { clinical: s.clinical, reduce_flashes: s.reduce_flashes, no_shake: !s.shake, headless: server || pr.lite };''')\ns=s.replace('''        if server {\n            scene.dynamic.clear();''','''        if server || pr.lite {\n            scene.post.gi = 0.0;\n            scene.post.bloom = 0.0;\n            scene.sun.shadows = false;\n            scene.point_lights.clear();\n            scene.dynamic.clear();''')\nopen(p,'w').write(s)\np='crates/pav_app/src/hub.rs'; s=open(p).read()\ns=s.replace('''const SAVE_KEY: &str''','''/// Tests' switch: `?lite=1` or `window.__lite` draws only the UI.\npub fn lite() -> bool {\n    #[cfg(target_arch = \"wasm32\")]\n    {\n        let Some(w) = web_sys::window() else { return false };\n        let by_var = js::get(&w, \"__lite\").and_then(|v| v.as_bool()).unwrap_or(false);\n        by_var || w.location().search().unwrap_or_default().contains(\"lite=1\")\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    false\n}\n\nconst SAVE_KEY: &str''')\nopen(p,'w').write(s)\np='../tests/browser/hub_tests.py'; s=open(p).read()\ns=s.replace('''shutil.copy(GAME, HUB / \"game.html\")''','''# Software rendering takes seconds a frame on this machine: the harness runs a copy that draws only UI.\npage_text = pathlib.Path(GAME).read_text(encoding=\"utf-8\")\n(HUB / \"game.html\").write_text(page_text.replace(\"</head>\", \"<script>window.__lite = true;</script>\\\\n</head>\", 1), encoding=\"utf-8\")''')\nopen(p,'w').write(s)\np='../tests/browser/web_tests.py'; s=open(p).read()\ns=s.replace('''def boots(b):\n    p = Page(b, init=[TAP])''','''def renders(b):\n    # The real thing, once, small: a frame of 3D arrives and has pixels in it.\n    p = Page(b, query=\"?scene=surgery/case/3\", viewport=(480, 270))\n    p.wait(lambda s: s[\"frames\"] >= 2, timeout=200, what=\"a real frame\")\n    shot = p.page.screenshot()\n    import zlib\n    assert len(shot) > 8000, len(shot)\n    assert not [e for e in p.errors if \"favicon\" not in e], p.errors\n    p.close()\n\ndef boots(b):\n    p = Page(b, query=\"?lite=1\", init=[TAP])''')\ns=s.replace('assert st[\"bus\"][\"music\"] == 0.1, st[\"bus\"]','assert abs(st[\"bus\"][\"music\"] - 0.1) < 1e-4, st[\"bus\"]')\ns=s.replace('assert st[\"bus\"][\"music\"] == 0.1\\n','assert abs(st[\"bus\"][\"music\"] - 0.1) < 1e-4\\n')\ns=s.replace('p = Page(b)\\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\"','p = Page(b, query=\"?lite=1\")\\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\"')\ns=s.replace('p = Page(b, query=\"?scene=surgery/case/2\")','p = Page(b, query=\"?scene=surgery/case/2&lite=1\")')\ns=s.replace('p = Page(b, init=[PAD])','p = Page(b, query=\"?lite=1\", init=[PAD])')\ns=s.replace('ctx_page = Page(b, init=[PAD])','ctx_page = Page(b, query=\"?lite=1\", init=[PAD])')\ns=s.replace('p = Page(b, init=[TAP])\\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\" and s[\"frames\"] > 3, what=\"title\")\\n    p.key(\"Enter\")  # a gesture','p = Page(b, query=\"?lite=1\", init=[TAP])\\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\" and s[\"frames\"] > 3, what=\"title\")\\n    p.key(\"Enter\")  # a gesture')\ns=s.replace('p = Page(b, query=\"?scene=surgery/case/3\")\\n    p.wait(lambda s: s[\"sim\"] and s[\"sim\"][\"stage\"] == \"Op\" and s[\"frames\"] > 3, what=\"op\")\\n    p.key(\"Escape\")','p = Page(b, query=\"?scene=surgery/case/3&lite=1\")\\n    p.wait(lambda s: s[\"sim\"] and s[\"sim\"][\"stage\"] == \"Op\" and s[\"frames\"] > 3, what=\"op\")\\n    p.key(\"Escape\")')\ns=s.replace('''def whole_campaign(b):\n    p = Page(b)''','''def whole_campaign(b):\n    p = Page(b, query=\"?lite=1\")''')\ns=s.replace('p = Page(b, viewport=(device[\"viewport\"][\"height\"], device[\"viewport\"][\"width\"]), **ctx)','p = Page(b, query=\"?lite=1\", viewport=(device[\"viewport\"][\"height\"], device[\"viewport\"][\"width\"]), **ctx)')\ns=s.replace('''        (\"boots with no errors and no engine overlays\", boots),''','''        (\"a real 3D frame arrives\", renders),\n        (\"boots with no errors and no engine overlays\", boots),''')\nopen(p,'w').write(s)\nEOF\nJOBS=4 ../tools/cb.sh build -p pav_tools --bin pav 2>&1 | grep -E \"^error|-->\" -A5 | head -20; (nohup ../tools/build_web.sh > ../build_web.log 2>&1 &); ./target/debug/pav balance seeds=4 skills=1.0,0.7,0.4 2>&1 | python3 -c \"\nimport json,sys\nd=json.load(sys.stdin)\nfor c in d:\n    print(c['case'],c['suggested_par'],' | '.join(f\\\"{r['skill']}:{r['wins']} {r['secs']}s v{r['vitals']} {r['score']}\\\" for r in c['rows']))\n\"","description":"Fix tendril, add lite test mode, rebuild and rebalance","timeout":590000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2327,"cache_read_input_tokens":639945,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2327},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"8052ef2b-616c-4c4f-b14b-4ae0a0eac1d8","timestamp":"2026-11