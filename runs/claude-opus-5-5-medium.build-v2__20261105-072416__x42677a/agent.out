        c::CLINK => vec![\n            (Patch { decay: 0.11, volume: 0.17, ..Patch::new(Square, 2900.0 * k) }, 0.0),\n            (Patch { decay: 0.16, volume: 0.12, ..Patch::new(Triangle, 4100.0 * k) }, 0.01),\n        ],\n        c::FROST => vec![\n            (Patch { attack: 0.02, decay: 0.3, volume: 0.14, cutoff: 12000.0, cutoff_end: 5000.0, ..noise }, 0.0),\n            (Patch { decay: 0.3, volume: 0.07, ..Patch::new(Sine, 3200.0 * k) }, 0.03),\n        ],\n        c::CRACK => vec![\n            (Patch { decay: 0.04, volume: 0.42, cutoff: 9000.0, cutoff_end: 2000.0, ..noise }, 0.0),\n            (Patch { decay: 0.12, volume: 0.2, cutoff: 3000.0, cutoff_end: 800.0, ..noise }, 0.03),\n        ],\n        c::SNAP => vec![\n            (Patch { decay: 0.03, volume: 0.42, cutoff: 7000.0, cutoff_end: 2000.0, ..noise }, 0.0),\n            (Patch { freq_end: 110.0, glide: 0.07, decay: 0.1, volume: 0.3, ..Patch::new(Square, 280.0) }, 0.0),\n        ],\n        c::LIFT_OFF => vec![\n            (Patch { decay: 0.08, volume: 0.17, duty: 0.3, ..Patch::new(Square, 1320.0) }, 0.0),\n            (Patch { decay: 0.08, volume: 0.17, duty: 0.3, ..Patch::new(Square, 1320.0) }, 0.14),\n        ],\n        c::RING => vec![\n            (Patch { attack: 0.01, decay: 0.6, volume: 0.3, cutoff: 700.0, cutoff_end: 7000.0, ..noise }, 0.0),\n            (Patch { freq_end: 880.0, glide: 0.5, decay: 0.55, volume: 0.1, ..Patch::new(Saw, 180.0) }, 0.0),\n        ],\n        c::HUSH => vec![\n            (Patch { freq_end: 110.0, glide: 0.5, attack: 0.01, decay: 0.7, volume: 0.3, ..Patch::new(Sine, 440.0 * k) }, 0.0),\n            (Patch { attack: 0.3, decay: 1.2, volume: 0.1, ..Patch::new(Sine, 880.0 * k) }, 0.1),\n        ],\n        c::ECHO => vec![\n            (Patch { decay: 0.3, volume: 0.14, ..Patch::new(Triangle, 1046.0 * k) }, 0.0),\n            (Patch { decay: 0.3, volume: 0.1, ..Patch::new(Triangle, 1046.0 * k) }, 0.14),\n            (Patch { decay: 0.3, volume: 0.06, ..Patch::new(Triangle, 1046.0 * k) }, 0.28),\n        ],\n        c::DUET => vec![\n            (Patch { attack: 0.03, decay: 1.2, volume: 0.15, ..Patch::new(Triangle, 440.0) }, 0.0),\n            (Patch { attack: 0.03, decay: 1.2, volume: 0.15, ..Patch::new(Triangle, 660.0) }, 0.05),\n            (Patch { attack: 0.03, decay: 1.2, volume: 0.15, ..Patch::new(Triangle, 880.0) }, 0.1),\n            (Patch { attack: 0.03, decay: 1.4, volume: 0.13, ..Patch::new(Sine, 1320.0) }, 0.15),\n        ],\n        c::STAMP => vec![\n            (Patch { freq_end: 40.0, glide: 0.1, decay: 0.2, volume: 0.65, ..Patch::new(Sine, 150.0) }, 0.0),\n            (Patch { decay: 0.1, volume: 0.35, cutoff: 3200.0, cutoff_end: 500.0, ..noise }, 0.0),\n        ],\n        c::THUNDER => vec![\n            (Patch { attack: 0.03, decay: 1.6, volume: 0.55, cutoff: 900.0, cutoff_end: 70.0, ..noise }, 0.0),\n            (Patch { freq_end: 28.0, glide: 1.0, decay: 1.2, volume: 0.45, ..Patch::new(Sine, 60.0) }, 0.05),\n        ],\n        c::TEAR => vec![\n            (Patch { attack: 0.005, decay: 0.2, volume: 0.32, cutoff: 2600.0 * k, cutoff_end: 500.0, ..noise }, 0.0),\n            (Patch { freq_end: 90.0, glide: 0.14, decay: 0.16, volume: 0.2, duty: 0.3, ..Patch::new(Square, 240.0) }, 0.0),\n        ],\n        c::GIFT_ARM => vec![(Patch { attack: 0.2, decay: 0.8, volume: 0.1, ..Patch::new(Sine, 1760.0) }, 0.0)],\n        c::GASP => vec![(Patch { attack: 0.08, decay: 0.3, volume: 0.2, cutoff: 1200.0, cutoff_end: 3600.0, ..noise }, 0.0)],\n        c::LIFT => vec![\n            (Patch { decay: 0.3, volume: 0.13, ..Patch::new(Sine, 880.0) }, 0.0),\n            (Patch { attack: 0.4, decay: 0.9, volume: 0.13, cutoff: 500.0, ..Patch::new(Saw, 58.0) }, 0.0),\n        ],\n        c::PHONE => vec![\n            (Patch { decay: 0.26, sustain: 0.7, hold: 0.14, volume: 0.1, ..Patch::new(Sine, 440.0) }, 0.0),\n            (Patch { decay: 0.26, sustain: 0.7, hold: 0.14, volume: 0.1, ..Patch::new(Sine, 480.0) }, 0.0),\n        ],\n        c::GLASS => vec![\n            (Patch { decay: 0.12, volume: 0.28, cutoff: 12000.0, cutoff_end: 5000.0, ..noise }, 0.0),\n            (Patch { decay: 0.2, volume: 0.1, ..Patch::new(Triangle, 3400.0) }, 0.02),\n        ],\n        _ => Vec::new(),\n    }\n}\nEOF\ncat > crates/pav_audio/src/voice.rs <<'EOF'\n//! Animalese-style voices: each syllable of the text is a short pitched blip through two resonant\n//! formant filters chosen from the vowel. Per-character base pitch, waveform and speed; falling\n//! pitch at full stops, rising at question marks. Gibberish: no word is ever spoken.\n\nuse pav_core::games::surgery::content::Voice;\n\nuse crate::{BUS_VOICES, Patch, Sink, Wave};\n\nfn formants(ch: char) -> [f32; 2] {\n    match ch.to_ascii_lowercase() {\n        'a' => [800.0, 1200.0],\n        'e' => [500.0, 1900.0],\n        'i' | 'y' => [300.0, 2300.0],\n        'o' => [500.0, 850.0],\n        'u' => [330.0, 800.0],\n        _ => [420.0, 1500.0],\n    }\n}\n\nfn is_vowel(c: char) -> bool {\n    matches!(c.to_ascii_lowercase(), 'a' | 'e' | 'i' | 'o' | 'u' | 'y')\n}\n\nfn wave_of(name: &str) -> Wave {\n    match name {\n        \"sine\" => Wave::Sine,\n        \"square\" => Wave::Square,\n        \"saw\" => Wave::Saw,\n        _ => Wave::Triangle,\n    }\n}\n\n/// The blip for one syllable.\npub fn blip(v: &Voice, vowel: char, bend: f32, salt: u32) -> Patch {\n    let wobble = 1.0 + ((salt.wrapping_mul(2_654_435_761) >> 20) as f32 / 4096.0 - 0.5) * (0.08 + v.jitter);\n    let f = v.base.max(60.0) * bend * wobble;\n    let formant = formants(vowel);\n    let bright = v.bright.max(0.2);\n    Patch {\n        freq_end: f * 0.94,\n        glide: 0.07,\n        attack: 0.006,\n        decay: 0.058 / v.speed.max(0.4),\n        sustain: 0.25,\n        hold: 0.01,\n        release: 0.02,\n        volume: 0.52,\n        cutoff: 5200.0 * bright,\n        cutoff_end: 3000.0 * bright,\n        formant: [formant[0] * (0.85 + bright * 0.2), formant[1] * (0.85 + bright * 0.2)],\n        reso: 5.0,\n        duty: 0.4,\n        ..Patch::new(wave_of(&v.wave), f)\n    }\n}\n\n/// Speaks the syllables of `text` between char indexes `from..to`, at this voice. A syllable starts\n/// where a vowel follows a non-vowel. Returns how many it played.\npub fn speak(sink: &mut dyn Sink, v: &Voice, text: &str, from: usize, to: usize, gain: f32) -> u32 {\n    let chars: Vec<char> = text.chars().collect();\n    let mut played = 0;\n    for i in from..to.min(chars.len()) {\n        let c = chars[i];\n        if !is_vowel(c) || (i > 0 && is_vowel(chars[i - 1])) {\n            continue;\n        }\n        // The sentence's end colours its last syllables.\n        let next_stop = chars[i..].iter().take(14).position(|x| matches!(x, '.' | '?' | '!'));\n        let bend = match next_stop.map(|n| (n, chars[i + n])) {\n            Some((n, '.')) => 1.0 - (14 - n) as f32 * 0.016,\n            Some((n, '?')) => 1.0 + (14 - n) as f32 * 0.024,\n            Some((n, '!')) => 1.08 + (14 - n) as f32 * 0.006,\n            _ => 1.0,\n        };\n        sink.send(BUS_VOICES, blip(v, c, bend, i as u32 * 31 + c as u32), 0.0, gain, 0.0);\n        played += 1;\n    }\n    played\n}\nEOF\ncat > crates/pav_audio/src/music.rs <<'EOF'\n//! The music: a small note-event sequencer on the render thread that schedules ahead with the\n//! mixer's `delay`, so tempo can follow the heart. Every melody here is written for this game.\n//! Notes are text: `A4:2` is the A above middle C for two beats, `.:1` a rest, `C4+E4+G4:3` a chord.\n\nuse crate::{BUS_MUSIC, Patch, Sink, Wave};\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Instr {\n    Piano,\n    Pad,\n    Bass,\n    Pluck,\n    Bell,\n    Strings,\n    Pulse,\n}\n\n#[derive(Clone, Copy, Debug)]\npub struct Note {\n    pub at: f32,\n    pub midi: u8,\n    pub len: f32,\n    pub vel: f32,\n    pub instr: Instr,\n}\n\nfn midi_of(name: &str) -> Option<u8> {\n    let b = name.as_bytes();\n    let base = match b.first()? {\n        b'C' => 0,\n        b'D' => 2,\n        b'E' => 4,\n        b'F' => 5,\n        b'G' => 7,\n        b'A' => 9,\n        b'B' => 11,\n        _ => return None,\n    };\n    let mut i = 1;\n    let mut acc = 0i32;\n    if b.get(1) == Some(&b'#') {\n        acc = 1;\n        i = 2;\n    } else if b.get(1) == Some(&b'b') {\n        acc = -1;\n        i = 2;\n    }\n    let octave: i32 = name[i..].parse().ok()?;\n    Some(((octave + 1) * 12 + base + acc) as u8)\n}\n\n/// Parses a line of notes into events, from beat 0.\npub fn line(text: &str, instr: Instr, vel: f32) -> Vec<Note> {\n    let mut at = 0.0;\n    let mut out = Vec::new();\n    for tok in text.split_whitespace() {\n        let (names, len) = tok.split_once(':').unwrap_or((tok, \"1\"));\n        let len: f32 = len.parse().unwrap_or(1.0);\n        if names != \".\" {\n            for n in names.split('+') {\n                if let Some(midi) = midi_of(n) {\n                    out.push(Note { at, midi, len, vel, instr });\n                }\n            }\n        }\n        at += len;\n    }\n    out\n}\n\n/// A track: its loop length in beats, notes, and how it keeps time.\n#[derive(Clone, Debug)]\npub struct Track {\n    pub bar: u8,\n    pub length: f32,\n    pub notes: Vec<Note>,\n    /// Beats per minute for tracks that don't follow the heart (0 = follow it).\n    pub tempo: f32,\n    /// A layer that fades in with the crisis.\n    pub crisis: Vec<Note>,\n    /// Plays once, then silence.\n    pub once: bool,\n}\n\nfn join(parts: Vec<Vec<Note>>) -> Vec<Note> {\n    parts.into_iter().flatten().collect()\n}\n\n/// The track table, by `content::MUSIC` id.\npub fn track(id: u8) -> Option<Track> {\n    use Instr::*;\n    Some(match id {\n        // Title: slow, minor, a piano in an empty ward; in three, because it knows.\n        1 => Track {\n            bar: 3,\n            length: 48.0,\n            tempo: 54.0,\n            once: false,\n            crisis: Vec::new(),\n            notes: join(vec![\n                line(\n                    \"A4:1 C5:1 E5:1 | D5:2 C5:1 B4:2 G4:1 A4:3 | E4:1 A4:1 C5:1 F5:2 E5:1 D5:1 C5:1 B4:1 C5:3\",\n                    Piano,\n                    0.75,\n                ),\n                shift(line(\"A5:2 G5:1 F5:2 E5:1 D5:1 F5:1 A5:1 G5:3 E5:1 C5:1 D5:1 E5:2 C5:1 B4:1 A4:1 G#4:1 A4:3 .:3\", Piano, 0.7), 24.0),\n                line(\n                    \"A2+E3:3 A2+E3:3 F2+C3:3 F2+C3:3 D3+A3:3 D3+A3:3 E2+B2:3 A2+E3:3 F2+C3:3 C3+G3:3 D3+A3:3 E2+B2:3 F2+C3:3 D3+A3:3 E2+B2:3 A2+E3:3\",\n                    Piano,\n                    0.32,\n                ),\n            ]),\n        },\n        // Tender: story's quiet scenes, a rocking major-with-doubts.\n        2 => Track {\n            bar: 4,\n            length: 32.0,\n            tempo: 66.0,\n            once: false,\n            crisis: Vec::new(),\n            notes: join(vec![\n                line(\"E5:2 D5:1 C5:1 G4:3 .:1 A4:1 C5:1 F5:2 E5:3 .:1 D5:1 E5:1 F5:1 A5:1 G5:2 E5:1 C5:1 D5:2 B4:2 C5:3 .:1\", Piano, 0.55),\n                line(\"C3+G3+E4:4 A2+E3+C4:4 F2+C3+A3:4 C3+G3+E4:4 D3+A3+F4:4 G2+D3+B3:4 A2+E3+C4:2 F2+C3+A3:2 G2+D3+B3:2 C3+G3+E4:2\", Pad, 0.32),\n            ]),\n        },\n        // Tense: story's dark scenes; a pedal and a falling cello line.\n        3 => Track {\n            bar: 4,\n            length: 16.0,\n            tempo: 72.0,\n            once: false,\n            crisis: Vec::new(),\n            notes: join(vec![\n                line(\"D2:1 .:1 D2:1 .:1 D2:1 .:1 D2:1 .:1 Bb1:1 .:1 Bb1:1 .:1 A1:1 .:1 A1:1 .:1\", Bass, 0.8),\n                line(\"A4:3 G4:1 F4:3 E4:1 D4:3 F4:1 E4:4\", Strings, 0.42),\n                line(\".:8 D5:2 C#5:2 D5:1 F5:1 E5:2\", Bell, 0.2),\n            ]),\n        },\n        // The OR loop: its bass lands on the actual heartbeat.\n        4 => Track {\n            bar: 4,\n            length: 16.0,\n            tempo: 0.0,\n            once: false,\n            crisis: join(vec![\n                line(\"A5:1 C6:1 A5:1 G5:1 F5:1 A5:1 F5:1 E5:1 D5:1 F5:1 D5:1 C5:1 B4:1 D5:1 E5:2\", Pluck, 0.5),\n                line(\"A2:0.5 A2:0.5 A2:0.5 A2:0.5 A2:0.5 A2:0.5 A2:0.5 A2:0.5 F2:0.5 F2:0.5 F2:0.5 F2:0.5 F2:0.5 F2:0.5 F2:0.5 F2:0.5 D2:0.5 D2:0.5 D2:0.5 D2:0.5 D2:0.5 D2:0.5 D2:0.5 D2:0.5 E2:0.5 E2:0.5 E2:0.5 E2:0.5 E2:0.5 E2:0.5 E2:0.5 E2:0.5\", Pulse, 0.42),\n            ]),\n            notes: join(vec![\n                line(\"A1:1 A1:1 A1:1 A1:1 F1:1 F1:1 F1:1 F1:1 D2:1 D2:1 D2:1 D2:1 E1:1 E1:1 E1:1 E1:1\", Bass, 0.9),\n                line(\"A3+C4+E4:4 F3+A3+C4:4 D3+F3+A3:4 E3+G#3+B3:4\", Pad, 0.3),\n                line(\".:2 E5:1 .:1 .:2 C5:1 .:1 .:2 A4:1 .:1 .:2 B4:1 .:1\", Pluck, 0.3),\n            ]),\n        },\n        // Introit: a waltz nobody asked for, 3/4.\n        5 => Track {\n            bar: 3,\n            length: 24.0,\n            tempo: 0.0,\n            once: false,\n            crisis: line(\"E6:0.5 D#6:0.5 E6:0.5 B5:0.5 D6:0.5 C6:0.5 A5:1.5 .:1.5\", Bell, 0.3),\n            notes: join(vec![\n                line(\"D5:2 F5:1 A5:2 G5:1 F5:1 E5:1 D5:1 C#5:3 D5:2 E5:1 F5:2 A5:1 G5:1 E5:1 C#5:1 D5:3\", Strings, 0.5),\n                line(\"D2:1 A3+F4:1 A3+F4:1 D2:1 A3+F4:1 A3+F4:1 A1:1 G3+E4:1 G3+E4:1 A1:1 G3+E4:1 G3+E4:1 D2:1 A3+F4:1 A3+F4:1 Bb1:1 G3+D4:1 G3+D4:1 A1:1 G3+E4:1 G3+E4:1 D2:1 A3+F4:1 A3+F4:1\", Piano, 0.4),\n            ]),\n        },\n        // Lacrimosa: a weeping 6/8.\n        6 => Track {\n            bar: 6,\n            length: 24.0,\n            tempo: 0.0,\n            once: false,\n            crisis: line(\"G5:1 Bb5:1 D6:1 C6:1 Bb5:1 A5:1\", Bell, 0.25),\n            notes: join(vec![\n                line(\"D5:3 C5:1 Bb4:1 A4:1 Bb4:2 G4:1 F#4:3 G4:1 A4:1 Bb4:1 D5:1 C5:1 Bb4:1 A4:6\", Strings, 0.5),\n                line(\"G2:1 D3:1 G3:1 Bb3:1 G3:1 D3:1 D2:1 A2:1 D3:1 F#3:1 D3:1 A2:1 Eb2:1 Bb2:1 Eb3:1 G3:1 Eb3:1 Bb2:1 D2:1 A2:1 D3:1 F#3:1 D3:1 A2:1\", Pluck, 0.42),\n            ]),\n        },\n        // Dies Irae: a furious 5/4, built on the count.\n        7 => Track {\n            bar: 5,\n            length: 20.0,\n            tempo: 0.0,\n            once: false,\n            crisis: line(\"F5:0.5 E5:0.5 F5:0.5 G5:0.5 Ab5:1 G5:1 F5:1\", Strings, 0.4),\n            notes: join(vec![\n                line(\"F2:1 F2:1 C3:1 F2:1 Ab2:1 Eb2:1 Eb2:1 Bb2:1 Eb2:1 G2:1 Db2:1 Db2:1 Ab2:1 Db2:1 F2:1 C2:1 C2:1 G2:1 C2:1 E2:1\", Bass, 0.85),\n                line(\"C5:2 Db5:1 C5:1 Ab4:1 Bb4:2 C5:1 Bb4:1 G4:1 Ab4:2 Bb4:1 Ab4:1 F4:1 G4:3 .:2\", Strings, 0.48),\n                line(\".:4 F4+Ab4+C5:1 .:4 Eb4+G4+Bb4:1 .:4 Db4+F4+Ab4:1 .:4 C4+E4+G4:1\", Pulse, 0.5),\n            ]),\n        },\n        // Libera Me: everything, shifting; here in a restless 7/8.\n        8 => Track {\n            bar: 7,\n            length: 28.0,\n            tempo: 0.0,\n            once: false,\n            crisis: line(\"A5:1 G5:1 A5:1 C6:1 B5:1 A5:1 E5:1\", Bell, 0.28),\n            notes: join(vec![\n                line(\"A1:1 E2:1 A2:1 E2:1 A1:1 E2:1 A2:1 F1:1 C2:1 F2:1 C2:1 F1:1 C2:1 F2:1 D2:1 A2:1 D3:1 A2:1 D2:1 A2:1 D3:1 E1:1 B1:1 E2:1 B1:1 E1:1 G#1:1 B1:1\", Bass, 0.8),\n                line(\"A4:3 C5:2 E5:2 F5:3 E5:2 C5:2 D5:3 F5:2 A5:2 G#5:3 E5:2 B4:2\", Strings, 0.5),\n            ]),\n        },\n        // Code Blue: the drive.\n        9 => Track {\n            bar: 4,\n            length: 16.0,\n            tempo: 0.0,\n            once: false,\n            crisis: line(\"D6:0.5 C6:0.5 A5:0.5 G5:0.5 A5:1 .:1\", Bell, 0.3),\n            notes: join(vec![\n                line(\"D2:0.5 D2:0.5 D3:0.5 D2:0.5 D2:0.5 D2:0.5 C3:0.5 D2:0.5 Bb1:0.5 Bb1:0.5 Bb2:0.5 Bb1:0.5 F2:0.5 F2:0.5 F3:0.5 F2:0.5 G1:0.5 G1:0.5 G2:0.5 G1:0.5 G1:0.5 G1:0.5 F2:0.5 G1:0.5 A1:0.5 A1:0.5 A2:0.5 A1:0.5 A1:0.5 C#2:0.5 E2:0.5 A2:0.5\", Pulse, 0.5),\n                line(\"D5:1 F5:1 A5:2 Bb4:1 D5:1 F5:2 G4:1 Bb4:1 D5:2 A4:1 C#5:1 E5:2\", Strings, 0.42),\n            ]),\n        },\n        // Results: a small fanfare that won't quite believe it.\n        10 => Track {\n            bar: 4,\n            length: 12.0,\n            tempo: 92.0,\n            once: true,\n            crisis: Vec::new(),\n            notes: join(vec![\n                line(\"C5:0.5 E5:0.5 G5:1 C6:2 B5:0.5 A5:0.5 G5:1 E5:2 F5:1 A5:1 G5:1 E5:1\", Bell, 0.42),\n                line(\"C3+G3+E4:4 F3+C4+A4:2 G3+D4+B4:2 C3+G3+E4:4\", Pad, 0.36),\n            ]),\n        },\n        _ => return None,\n    })\n}\n\nfn shift(mut v: Vec<Note>, by: f32) -> Vec<Note> {\n    for n in &mut v {\n        n.at += by;\n    }\n    v\n}\n\nfn hz(midi: u8) -> f32 {\n    440.0 * 2f32.powf((midi as f32 - 69.0) / 12.0)\n}\n\n/// The sound of a note. `secs` is its length in seconds; `dark` low-passes it (the Hush).\npub fn voice_of(n: &Note, secs: f32, dark: f32) -> Vec<(Patch, f32)> {\n    let f = hz(n.midi);\n    let v = n.vel;\n    let mut out = match n.instr {\n        Instr::Piano => vec![\n            (Patch { attack: 0.004, decay: secs.max(0.5) * 1.2, volume: 0.42 * v, cutoff: 3800.0, cutoff_end: 800.0, ..Patch::new(Wave::Triangle, f) }, 0.0),\n            (Patch { attack: 0.002, decay: 0.3, volume: 0.13 * v, ..Patch::new(Wave::Sine, f * 2.0) }, 0.0),\n            (Patch { attack: 0.001, decay: 0.05, volume: 0.05 * v, cutoff: 5000.0, ..Patch::new(Wave::Saw, f * 3.0) }, 0.0),\n        ],\n        Instr::Pad => vec![\n            (Patch { attack: 0.25, decay: 0.3, sustain: 0.75, hold: (secs - 0.5).max(0.1), release: 0.35, volume: 0.22 * v, cutoff: 1100.0, cutoff_end: 700.0, ..Patch::new(Wave::Saw, f) }, 0.0),\n            (Patch { attack: 0.3, decay: 0.3, sustain: 0.75, hold: (secs - 0.5).max(0.1), release: 0.35, volume: 0.16 * v, ..Patch::new(Wave::Sine, f * 1.003) }, 0.0),\n        ],\n        Instr::Bass => vec![\n            (Patch { attack: 0.006, decay: secs.min(0.6), sustain: 0.1, release: 0.06, volume: 0.62 * v, cutoff: 500.0, cutoff_end: 200.0, ..Patch::new(Wave::Triangle, f) }, 0.0),\n            (Patch { attack: 0.004, decay: 0.09, volume: 0.32 * v, ..Patch::new(Wave::Sine, f * 2.0) }, 0.0),\n        ],\n        Instr::Pluck => vec![(Patch { attack: 0.002, decay: 0.26, volume: 0.32 * v, cutoff: 3000.0, cutoff_end: 500.0, duty: 0.3, ..Patch::new(Wave::Square, f) }, 0.0)],\n        Instr::Bell => vec![\n            (Patch { attack: 0.002, decay: 0.8, volume: 0.27 * v, ..Patch::new(Wave::Sine, f) }, 0.0),\n            (Patch { attack: 0.002, decay: 0.4, volume: 0.11 * v, ..Patch::new(Wave::Sine, f * 2.76) }, 0.0),\n        ],\n        Instr::Strings => vec![\n            (Patch { attack: 0.09, decay: 0.2, sustain: 0.8, hold: (secs - 0.25).max(0.05), release: 0.18, volume: 0.26 * v, cutoff: 2200.0, cutoff_end: 1600.0, ..Patch::new(Wave::Saw, f) }, 0.0),\n            (Patch { attack: 0.09, decay: 0.2, sustain: 0.8, hold: (secs - 0.25).max(0.05), release: 0.18, volume: 0.18 * v, cutoff: 2200.0, ..Patch::new(Wave::Saw, f * 1.006) }, 0.0),\n        ],\n        Instr::Pulse => vec![(Patch { attack: 0.003, decay: secs.min(0.2), volume: 0.34 * v, cutoff: 1500.0, cutoff_end: 500.0, duty: 0.25, ..Patch::new(Wave::Square, f) }, 0.0)],\n    };\n    if dark > 0.0 {\n        for (p, _) in &mut out {\n            p.cutoff = p.cutoff.min(4000.0 - 3500.0 * dark);\n            p.cutoff_end = p.cutoff_end.min(4000.0 - 3500.0 * dark);\n        }\n    }\n    out\n}\n\n/// What the music follows, per frame.\n#[derive(Clone, Copy, Debug, Default)]\npub struct Follow {\n    pub track: u8,\n    /// Which beat the heart is on, with its phase: the sequencer's clock in an operation.\n    pub beat_pos: f64,\n    pub bpm: f32,\n    pub stopped: bool,\n    pub crisis: f32,\n    pub hush: f32,\n}\n\n#[derive(Default)]\npub struct Sequencer {\n    current: u8,\n    data: Option<Track>,\n    /// Musical position: beats since the track started.\n    pos: f64,\n    origin: f64,\n    /// Everything before this has been scheduled.\n    done_until: f64,\n    hush_t: f32,\n    pub notes_played: u64,\n}\n\nconst LOOK_AHEAD: f64 = 0.28;\n\nimpl Sequencer {\n    /// Advances the clock and schedules what comes due. Call once a render frame.\n    pub fn update(&mut self, sink: &mut dyn Sink, f: Follow, dt: f32) {\n        if f.track != self.current || self.data.is_none() && f.track != 0 {\n            self.current = f.track;\n            self.data = track(f.track);\n            self.pos = 0.0;\n            self.origin = f.beat_pos;\n            self.done_until = 0.0;\n        }\n        // The Hush: everything low, one held note.\n        if f.hush > 0.0 {\n            self.hush_t -= dt;\n            if self.hush_t <= 0.0 {\n                self.hush_t = 2.8;\n                let n = Note { at: 0.0, midi: 69, len: 3.0, vel: 0.9, instr: Instr::Pad };\n                for (p, d) in voice_of(&n, 3.0, 0.3) {\n                    sink.send(BUS_MUSIC, p, 0.0, 1.0, d);\n                }\n            }\n        } else {\n            self.hush_t = 0.0;\n        }\n        let Some(data) = self.data.clone() else { return };\n        if f.stopped {\n            return;\n        }\n        let bpm = if data.tempo > 0.0 { data.tempo } else { f.bpm.clamp(40.0, 200.0) };\n        if data.tempo > 0.0 {\n            self.pos += dt as f64 * bpm as f64 / 60.0;\n        } else {\n            // Heart time: the bass lands on the actual beat.\n            let p = f.beat_pos - self.origin;\n            if p < self.pos - 8.0 {\n                self.origin = f.beat_pos;\n                self.done_until = 0.0;\n            }\n            self.pos = (f.beat_pos - self.origin).max(self.pos);\n        }\n        let ahead = self.pos + LOOK_AHEAD * bpm as f64 / 60.0;\n        let (from, to) = (self.done_until.max(self.pos - 0.01), ahead);\n        if to <= from {\n            return;\n        }\n        let quiet = f.hush > 0.0;\n        self.schedule(sink, &data.notes, data.length, data.once, from, to, bpm, if quiet { 0.25 } else { 1.0 }, f.hush);\n        if f.crisis > 0.02 && !quiet {\n            let n = data.crisis.iter().map(|c| c.at + c.len).fold(0.0f32, f32::max).max(1.0);\n            let length = (data.length / n).round().max(1.0) * n;\n            self.schedule(sink, &data.crisis, length, data.once, from, to, bpm, f.crisis, 0.0);\n        }\n        self.done_until = to;\n    }\n\n    #[allow(clippy::too_many_arguments)]\n    fn schedule(&mut self, sink: &mut dyn Sink, notes: &[Note], length: f32, once: bool, from: f64, to: f64, bpm: f32, gain: f32, dark: f32) {\n        let length = length as f64;\n        let first_loop = (from / length).floor() as i64;\n        let last_loop = (to / length).floor() as i64;\n        for lp in first_loop..=last_loop {\n            if once && lp > 0 {\n                break;\n            }\n            for n in notes {\n                let t = lp as f64 * length + n.at as f64;\n                if t >= from && t < to {\n                    let delay = ((t - self.pos) * 60.0 / bpm as f64).max(0.0) as f32;\n                    let secs = n.len * 60.0 / bpm;\n                    for (p, d) in voice_of(n, secs, dark) {\n                        sink.send(BUS_MUSIC, p, 0.0, gain, delay + d);\n                    }\n                    self.notes_played += 1;\n                }\n            }\n        }\n    }\n}\nEOF\ncat > crates/pav_audio/src/director.rs <<'EOF'\n//! Runs the game's sound from its frames: music tempo from the heart, gibberish voices as text\n//! types out, on any `Sink`.\n\nuse pav_core::games::surgery::content::content;\nuse pav_core::games::surgery::frame::{Stage, SurgeryFrame};\n\nuse crate::Sink;\nuse crate::music::{Follow, Sequencer};\nuse crate::voice;\n\n#[derive(Default)]\npub struct Director {\n    pub seq: Sequencer,\n    voiced: (u16, u16, usize),\n    callout: (String, usize),\n    /// Blips played: tests read it.\n    pub blips: u64,\n}\n\nimpl Director {\n    pub fn update(&mut self, sink: &mut dyn Sink, f: &SurgeryFrame, dt: f32) {\n        let c = content();\n        let track = match f.stage {\n            Stage::Dead | Stage::Done => 0,\n            _ => f.music,\n        };\n        let follow = Follow {\n            track,\n            beat_pos: f.beats as f64 + f.beat as f64,\n            bpm: f.bpm,\n            stopped: f.stopped,\n            crisis: f.crisis,\n            hush: f.hush,\n        };\n        self.seq.update(sink, follow, dt);\n\n        // A story line types out, syllable by syllable.\n        if let Some(st) = &f.story {\n            let key = (st.scene, st.line);\n            if (self.voiced.0, self.voiced.1) != key {\n                self.voiced = (key.0, key.1, 0);\n            }\n            let typed = (st.typed as usize).min(st.text.chars().count());\n            if typed > self.voiced.2 {\n                if let Some(rig) = c.rigs.get(&st.who) {\n                    self.blips += voice::speak(sink, &rig.voice, &st.text, self.voiced.2, typed, 1.0) as u64;\n                }\n                self.voiced.2 = typed;\n            }\n        }\n        // A callout in the operation, likewise.\n        if let Some(cl) = &f.callout {\n            if self.callout.0 != cl.text {\n                self.callout = (cl.text.clone(), 0);\n            }\n            let typed = ((cl.age * 38.0) as usize).min(cl.text.chars().count());\n            if typed > self.callout.1 {\n                if let Some(rig) = c.rigs.get(&cl.who) {\n                    self.blips += voice::speak(sink, &rig.voice, &cl.text, self.callout.1, typed, 0.9) as u64;\n                }\n                self.callout.1 = typed;\n            }\n        } else {\n            self.callout.0.clear();\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use crate::music::{self, Follow, Sequencer};\n    use crate::{BUS_MUSIC, BUS_VOICES, Mixer, Sink};\n    use pav_core::games::surgery::content::MUSIC;\n    use pav_core::games::surgery::cue;\n\n    fn peak(buf: &[f32]) -> f32 {\n        buf.iter().fold(0.0f32, |m, s| m.max(s.abs()))\n    }\n\n    #[test]\n    fn every_cue_renders_non_silent() {\n        for (id, name) in cue::NAMES.iter().enumerate() {\n            let mut m = Mixer::new(22050.0);\n            for (p, d) in crate::cues::sounds(id as u16, 1.0, 1.0) {\n                m.play(p, 0.0, 1.0, d);\n            }\n            let mut out = vec![0.0; 22050];\n            m.render(&mut out);\n            assert!(peak(&out) > 0.01, \"cue {name} is silent: {}\", peak(&out));\n        }\n    }\n\n    #[test]\n    fn every_track_renders_and_really_is_music() {\n        for (id, name) in MUSIC.iter().enumerate().skip(1) {\n            let t = music::track(id as u8).unwrap_or_else(|| panic!(\"track {name}\"));\n            assert!(t.notes.len() > 8, \"{name} has a real score\");\n            let mut pitches: Vec<u8> = t.notes.iter().map(|n| n.midi).collect();\n            pitches.sort();\n            pitches.dedup();\n            assert!(pitches.len() >= 6, \"{name} has a melody: {} pitches\", pitches.len());\n            let mut m = Mixer::new(22050.0);\n            let mut seq = Sequencer::default();\n            let mut out = vec![0.0; 2048 * 2];\n            let mut loudest = 0.0f32;\n            let mut beat = 0.0f64;\n            for _ in 0..60 {\n                let dt = 2048.0 / 22050.0;\n                beat += dt as f64 * 80.0 / 60.0;\n                seq.update(&mut m, Follow { track: id as u8, beat_pos: beat, bpm: 80.0, ..Default::default() }, dt);\n                m.render(&mut out);\n                loudest = loudest.max(peak(&out));\n            }\n            assert!(loudest > 0.02, \"track {name} is silent ({loudest})\");\n            assert!(seq.notes_played > 3, \"{name}\");\n        }\n    }\n\n    #[test]\n    fn the_bass_lands_on_the_heartbeat_and_follows_the_tempo() {\n        struct Log(Vec<f32>);\n        impl Sink for Log {\n            fn send(&mut self, _: u8, _: crate::Patch, _: f32, _: f32, delay: f32) {\n                self.0.push(delay);\n            }\n        }\n        let mut seq = Sequencer::default();\n        let mut log = Log(Vec::new());\n        // Just before a beat, at 120 bpm: the bass note is due in about 0.05 s.\n        seq.update(&mut log, Follow { track: 4, beat_pos: 3.0, bpm: 120.0, ..Default::default() }, 0.0);\n        log.0.clear();\n        seq.update(&mut log, Follow { track: 4, beat_pos: 3.9, bpm: 120.0, ..Default::default() }, 0.016);\n        assert!(log.0.iter().any(|d| (*d - 0.05).abs() < 0.02), \"{:?}\", log.0);\n    }\n\n    #[test]\n    fn voices_are_pitched_per_character_and_silent_only_when_they_should_be() {\n        let c = content();\n        for (id, rig) in &c.rigs {\n            let mut m = Mixer::new(22050.0);\n            let n = voice::speak(&mut m, &rig.voice, \"Doctor, the mass moved.\", 0, 23, 1.0);\n            assert!(n >= 5, \"{id}: {n} syllables\");\n            let mut out = vec![0.0; 22050];\n            m.render(&mut out);\n            assert!(peak(&out) > 0.02, \"{id} is silent: {}\", peak(&out));\n            assert!(m.peak[BUS_VOICES as usize] > 0.0);\n            assert_eq!(m.peak[BUS_MUSIC as usize], 0.0);\n        }\n        // Mara is higher than Pet, by design.\n        assert!(c.rigs[\"mara\"].voice.base > c.rigs[\"pet\"].voice.base * 1.5);\n    }\n\n    #[test]\n    fn a_bus_gain_scales_only_its_bus() {\n        let mut m = Mixer::new(22050.0);\n        m.bus = [1.0, 0.1, 1.0];\n        let n = music::Note { at: 0.0, midi: 69, len: 1.0, vel: 1.0, instr: music::Instr::Bell };\n        for (p, d) in music::voice_of(&n, 1.0, 0.0) {\n            m.play_on(BUS_MUSIC, p, 0.0, 1.0, d);\n        }\n        let mut quiet = vec![0.0; 8192];\n        m.render(&mut quiet);\n        let mut m = Mixer::new(22050.0);\n        m.bus = [1.0, 1.0, 1.0];\n        for (p, d) in music::voice_of(&n, 1.0, 0.0) {\n            m.play_on(BUS_MUSIC, p, 0.0, 1.0, d);\n        }\n        let mut loud = vec![0.0; 8192];\n        m.render(&mut loud);\n        assert!(peak(&loud) > peak(&quiet) * 5.0);\n    }\n}\nEOF\nsed -i 's/ | D5:2 C5:1/ D5:2 C5:1/' crates/pav_audio/src/music.rs\n../tools/cb.sh test --locked -p pav_audio 2>&1 | grep -E \"^error|^test |test result|panicked|-->\" | head -40","description":"Add mixer buses, cue table, voices, music sequencer and director","timeout":500000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1348,"cache_read_input_tokens":465077,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1348},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"a1a8a45d-2d73-4a48-8888-e1369b428cb3","timestamp":"2026-11-05T15:04:53.507Z","request_id":"req_011Cgjyx26HamHGZUYmNRmYF","wire_tool_inputs":{"toolu_015dDrxBRR3QGE2nc2ymYV8E":{"command":"cat > /tmp/$$.py <<'EOF'\nEOF\nrm -f /tmp/$$.py\npython3 - <<'EOF'\np='crates/pav_audio/src/lib.rs'; s=open(p).read()\ns=s.replace('''use glam::Vec3;\nuse pav_core::SimEvent;\n''','''use glam::Vec3;\nuse pav_core::SimEvent;\n\npub mod cues;\npub mod director;\npub mod music;\npub mod voice;\n\n/// The mixer's buses: each voice plays on one, each has its own gain.\npub const BUS_EFFECTS: u8 = 0;\npub const BUS_MUSIC: u8 = 1;\npub const BUS_VOICES: u8 = 2;\n''')\ns=s.replace('''    /// Square-wave duty cycle.\n    pub duty: f32,\n}\n''','''    /// Square-wave duty cycle.\n    pub duty: f32,\n    /// Two resonant band-pass filters (0 = off), for vowels: centres in Hz, and their sharpness.\n    pub formant: [f32; 2],\n    pub reso: f32,\n}\n''')\ns=s.replace('''            duty: 0.5,\n        }\n    }\n    pub fn length''','''            duty: 0.5,\n            formant: [0.0, 0.0],\n            reso: 8.0,\n        }\n    }\n    pub fn length''')\ns=s.replace('''    gain_l: f32,\n    gain_r: f32,\n}\n\nimpl Voice {''','''    gain_l: f32,\n    gain_r: f32,\n    bus: u8,\n    /// State-variable filter state per formant: (low, band).\n    svf: [(f32, f32); 2],\n}\n\nimpl Voice {''')\ns=s.replace('''        self.lp += (raw - self.lp) * a;\n        let s = self.lp * self.env() * p.volume;''','''        self.lp += (raw - self.lp) * a;\n        let mut shaped = self.lp;\n        if p.formant[0] > 0.0 {\n            let q = 1.0 / p.reso.max(0.5);\n            let mut sum = 0.0;\n            for (k, st) in self.svf.iter_mut().enumerate() {\n                let f = (std::f32::consts::PI * p.formant[k] * dt).sin() * 2.0;\n                let high = self.lp - st.0 - q * st.1;\n                st.1 += f * high;\n                st.0 += f * st.1;\n                sum += st.1 * if k == 0 { 1.0 } else { 0.7 };\n            }\n            shaped = sum;\n        }\n        let s = shaped * self.env() * p.volume;''')\ns=s.replace('''    pub master: f32,\n    seed: u32,\n}\n\nconst MAX_VOICES: usize = 64;\n''','''    pub master: f32,\n    /// Gain per bus (effects, music, voices).\n    pub bus: [f32; 3],\n    /// The loudest sample each bus made lately (read by tests and the game's status).\n    pub peak: [f32; 3],\n    seed: u32,\n}\n\nconst MAX_VOICES: usize = 256;\n''')\ns=s.replace('''        Self { voices: Vec::new(), sample_rate, master: 0.8, seed: 0x9e37_79b9 }''','''        Self { voices: Vec::new(), sample_rate, master: 0.8, bus: [1.0, 1.0, 1.0], peak: [0.0; 3], seed: 0x9e37_79b9 }''')\ns=s.replace('''    pub fn play(&mut self, p: Patch, pan: f32, gain: f32, delay: f32) {\n        if self.voices.len() >= MAX_VOICES {''','''    pub fn play(&mut self, p: Patch, pan: f32, gain: f32, delay: f32) {\n        self.play_on(BUS_EFFECTS, p, pan, gain, delay);\n    }\n\n    /// `play` on a bus.\n    pub fn play_on(&mut self, bus: u8, p: Patch, pan: f32, gain: f32, delay: f32) {\n        if self.voices.len() >= MAX_VOICES {''')\ns=s.replace('''            gain_l: a.cos() * gain,\n            gain_r: a.sin() * gain,\n        });''','''            gain_l: a.cos() * gain,\n            gain_r: a.sin() * gain,\n            bus: bus.min(2),\n            svf: [(0.0, 0.0); 2],\n        });''')\ns=s.replace('''            for v in &mut self.voices {\n                let s = v.next(dt);\n                l += s * v.gain_l;\n                r += s * v.gain_r;\n            }''','''            for v in &mut self.voices {\n                let s = v.next(dt);\n                let g = self.bus[v.bus as usize];\n                l += s * v.gain_l * g;\n                r += s * v.gain_r * g;\n                let m = (s * g).abs();\n                if m > self.peak[v.bus as usize] {\n                    self.peak[v.bus as usize] = m;\n                }\n            }''')\ns=s.replace('''        SimEvent::Destroyed { size, .. } => {\n            let v = size.clamp(0.4, 2.0);''','''        SimEvent::Cue { id, gain, pitch, .. } => cues::sounds(*id, *gain, *pitch),\n        SimEvent::Destroyed { size, .. } => {\n            let v = size.clamp(0.4, 2.0);''')\ns=s.replace('''        | SimEvent::Block { pos } => Some(*pos),''','''        | SimEvent::Cue { pos, .. }\n        | SimEvent::Block { pos } => Some(*pos),''')\ns=s.replace('''enum Cmd {\n    Play(Patch, f32, f32, f32),\n    Master(f32),\n}\n''','''enum Cmd {\n    Play(u8, Patch, f32, f32, f32),\n    Master(f32),\n    Bus(u8, f32),\n}\n\n/// Where a game's sounds go: the live output, or a mixer offline (tests).\npub trait Sink {\n    fn send(&mut self, bus: u8, p: Patch, pan: f32, gain: f32, delay: f32);\n}\n\nimpl Sink for Mixer {\n    fn send(&mut self, bus: u8, p: Patch, pan: f32, gain: f32, delay: f32) {\n        self.play_on(bus, p, pan, gain, delay);\n    }\n}\n\nimpl Sink for AudioOut {\n    fn send(&mut self, bus: u8, p: Patch, pan: f32, gain: f32, delay: f32) {\n        let _ = self.tx.send(Cmd::Play(bus, p, pan, gain, delay));\n    }\n}\n''')\ns=s.replace('''    tx: Sender<Cmd>,\n    pub sample_rate: u32,\n    pub device: String,\n}\n''','''    tx: Sender<Cmd>,\n    pub sample_rate: u32,\n    pub device: String,\n    /// The buses' loudest samples lately, as bits of f32 (the audio callback writes them).\n    pub peaks: std::sync::Arc<[std::sync::atomic::AtomicU32; 3]>,\n}\n''')\ns=s.replace('''        let (tx, rx) = channel::<Cmd>();\n        let stream = match format {\n            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels)?,\n            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels)?,\n            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels)?,''','''        let (tx, rx) = channel::<Cmd>();\n        let peaks = std::sync::Arc::new([\n            std::sync::atomic::AtomicU32::new(0),\n            std::sync::atomic::AtomicU32::new(0),\n            std::sync::atomic::AtomicU32::new(0),\n        ]);\n        let shared = peaks.clone();\n        let stream = match format {\n            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels, shared)?,\n            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels, shared)?,\n            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels, shared)?,''')\ns=s.replace('''        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name })''','''        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name, peaks })''')\ns=s.replace('''            let _ = self.tx.send(Cmd::Play(patch, pan, gain * sfx, delay));''','''            let _ = self.tx.send(Cmd::Play(BUS_EFFECTS, patch, pan, gain * sfx, delay));''')\ns=s.replace('''    pub fn set_master(&self, v: f32) {''','''    /// A bus's gain.\n    pub fn set_bus(&self, bus: u8, v: f32) {\n        let _ = self.tx.send(Cmd::Bus(bus, v));\n    }\n\n    /// Reads and clears the buses' peaks.\n    pub fn take_peaks(&self) -> [f32; 3] {\n        use std::sync::atomic::Ordering::Relaxed;\n        std::array::from_fn(|k| f32::from_bits(self.peaks[k].swap(0, Relaxed)))\n    }\n\n    pub fn set_master(&self, v: f32) {''')\ns=s.replace('''fn build<T>(device: &cpal::Device, config: cpal::StreamConfig, rx: Receiver<Cmd>, channels: usize) -> anyhow::Result<cpal::Stream>''','''fn build<T>(\n    device: &cpal::Device,\n    config: cpal::StreamConfig,\n    rx: Receiver<Cmd>,\n    channels: usize,\n    peaks: std::sync::Arc<[std::sync::atomic::AtomicU32; 3]>,\n) -> anyhow::Result<cpal::Stream>''')\ns=s.replace('''                    Cmd::Play(p, pan, gain, delay) => mixer.play(p, pan, gain, delay),\n                    Cmd::Master(v) => mixer.master = v,''','''                    Cmd::Play(bus, p, pan, gain, delay) => mixer.play_on(bus, p, pan, gain, delay),\n                    Cmd::Master(v) => mixer.master = v,\n                    Cmd::Bus(b, v) => mixer.bus[(b as usize).min(2)] = v,''')\ns=s.replace('''            mixer.render(&mut buf);\n            for (i, frame)''','''            mixer.render(&mut buf);\n            for k in 0..3 {\n                use std::sync::atomic::Ordering::Relaxed;\n                let now = f32::from_bits(peaks[k].load(Relaxed));\n                if mixer.peak[k] > now {\n                    peaks[k].store(mixer.peak[k].to_bits(), Relaxed);\n                }\n                mixer.peak[k] = 0.0;\n            }\n            for (i, frame)''')\nopen(p,'w').write(s)\nEOF\ncat > crates/pav_audio/src/cues.rs <<'EOF'\n//! The surgery game's sound table: one recipe per cue (`pav_core::games::surgery::cue`).\n\nuse pav_core::games::surgery::cue as c;\n\nuse crate::Patch;\nuse crate::Wave::*;\n\n/// What a cue plays: patches and their delays, at this gain and pitch.\npub fn sounds(id: u16, gain: f32, pitch: f32) -> Vec<(Patch, f32)> {\n    let mut v = recipe(id, pitch.max(0.1));\n    for (p, _) in &mut v {\n        p.volume *= gain;\n    }\n    v\n}\n\nfn recipe(id: u16, k: f32) -> Vec<(Patch, f32)> {\n    let noise = Patch::new(Noise, 1.0);\n    match id {\n        c::TOOL_PICK => vec![\n            (Patch { decay: 0.03, volume: 0.22, cutoff: 9000.0, cutoff_end: 4000.0, ..noise }, 0.0),\n            (Patch { decay: 0.1, volume: 0.14, ..Patch::new(Triangle, 2100.0 * k) }, 0.0),\n            (Patch { decay: 0.08, volume: 0.1, ..Patch::new(Triangle, 3150.0 * k) }, 0.03),\n        ],\n        c::SLICE => vec![(Patch { attack: 0.01, decay: 0.09, volume: 0.13, cutoff: 3000.0, cutoff_end: 9000.0, ..noise }, 0.0)],\n        c::SQUISH => vec![\n            (Patch { attack: 0.01, decay: 0.16, volume: 0.28, cutoff: 900.0 * k, cutoff_end: 200.0, ..noise }, 0.0),\n            (Patch { freq_end: 70.0 * k, glide: 0.12, decay: 0.14, volume: 0.2, ..Patch::new(Sine, 170.0 * k) }, 0.0),\n        ],\n        c::FORCEPS => vec![\n            (Patch { decay: 0.015, volume: 0.26, cutoff: 11000.0, ..noise }, 0.0),\n            (Patch { decay: 0.05, volume: 0.1, ..Patch::new(Square, 2600.0) }, 0.0),\n        ],\n        c::PULL_POP => vec![\n            (Patch { freq_end: 720.0 * k, glide: 0.07, decay: 0.08, volume: 0.28, ..Patch::new(Sine, 220.0 * k) }, 0.0),\n            (Patch { decay: 0.05, volume: 0.15, cutoff: 3000.0, cutoff_end: 800.0, ..noise }, 0.03),\n        ],\n        c::SUTURE => vec![\n            (Patch { attack: 0.005, decay: 0.05, volume: 0.17, cutoff: 3000.0, cutoff_end: 9000.0, ..noise }, 0.0),\n            (Patch { freq_end: 1300.0 * k, glide: 0.05, decay: 0.06, volume: 0.08, ..Patch::new(Saw, 600.0 * k) }, 0.0),\n        ],\n        c::GURGLE => vec![\n            (Patch { freq_end: 340.0 * k, glide: 0.09, attack: 0.01, decay: 0.12, volume: 0.22, cutoff: 900.0, ..Patch::new(Square, 120.0 * k) }, 0.0),\n            (Patch { attack: 0.02, decay: 0.14, volume: 0.16, cutoff: 700.0, cutoff_end: 1500.0, ..noise }, 0.0),\n        ],\n        c::LASER => vec![\n            (Patch { attack: 0.02, decay: 0.2, volume: 0.1, cutoff: 3500.0, ..Patch::new(Saw, 560.0 * k) }, 0.0),\n            (Patch { attack: 0.02, decay: 0.2, volume: 0.1, ..Patch::new(Sine, 1120.0 * k) }, 0.0),\n        ],\n        c::SIZZLE => vec![(Patch { attack: 0.01, decay: 0.35, volume: 0.24, cutoff: 9000.0 * k, cutoff_end: 3000.0, ..noise }, 0.0)],\n        c::GEL => vec![\n            (Patch { attack: 0.005, decay: 0.1, volume: 0.14, cutoff: 1800.0 * k, cutoff_end: 500.0, ..noise }, 0.0),\n            (Patch { freq_end: 260.0 * k, glide: 0.08, decay: 0.08, volume: 0.1, ..Patch::new(Sine, 520.0 * k) }, 0.0),\n        ],\n        c::IV => vec![(Patch { attack: 0.08, decay: 0.3, sustain: 0.4, hold: 0.4, release: 0.2, volume: 0.13, cutoff: 7000.0, cutoff_end: 3000.0, ..noise }, 0.0)],\n        c::SONAR => vec![\n            (Patch { freq_end: 1800.0 * k, glide: 0.04, decay: 0.3, volume: 0.17, ..Patch::new(Sine, 1500.0 * k) }, 0.0),\n            (Patch { decay: 0.4, volume: 0.07, ..Patch::new(Sine, 2400.0 * k) }, 0.06),\n        ],\n        c::DEFIB_WHINE => vec![(Patch { freq_end: 3800.0, glide: 1.2, attack: 0.05, decay: 1.15, sustain: 0.8, hold: 0.0, release: 0.1, volume: 0.1, ..Patch::new(Saw, 700.0) }, 0.0)],\n        c::DEFIB_THUMP => vec![\n            (Patch { freq_end: 34.0, glide: 0.2, decay: 0.45, volume: 0.9, ..Patch::new(Sine, 120.0) }, 0.0),\n            (Patch { decay: 0.2, volume: 0.45, cutoff: 7000.0, cutoff_end: 300.0, ..noise }, 0.0),\n        ],\n        c::LUB => vec![\n            (Patch { freq_end: 46.0, glide: 0.09, attack: 0.006, decay: 0.13, volume: 0.62, cutoff: 500.0, ..Patch::new(Sine, 74.0) }, 0.0),\n            (Patch { freq_end: 62.0, glide: 0.07, attack: 0.006, decay: 0.1, volume: 0.42, cutoff: 500.0, ..Patch::new(Sine, 96.0) }, 0.16),\n        ],\n        c::MONITOR => vec![(Patch { decay: 0.1, volume: 0.05, ..Patch::new(Sine, 1050.0 * k) }, 0.0)],\n        c::ALARM => vec![\n            (Patch { decay: 0.14, volume: 0.15, duty: 0.4, ..Patch::new(Square, 960.0 * k) }, 0.0),\n            (Patch { decay: 0.14, volume: 0.15, duty: 0.4, ..Patch::new(Square, 760.0 * k) }, 0.18),\n            (Patch { decay: 0.14, volume: 0.15, duty: 0.4, ..Patch::new(Square, 960.0 * k) }, 0.36),\n        ],\n        c::RATE_SLOPPY => vec![(Patch { freq_end: 150.0, glide: 0.2, decay: 0.24, volume: 0.13, duty: 0.3, ..Patch::new(Square, 240.0) }, 0.0)],\n        c::RATE_GOOD => vec![(Patch { decay: 0.16, volume: 0.15, ..Patch::new(Triangle, 660.0 * k) }, 0.0)],\n        c::RATE_CLEAN => vec![\n            (Patch { decay: 0.16, volume: 0.16, ..Patch::new(Triangle, 784.0 * k) }, 0.0),\n            (Patch { decay: 0.22, volume: 0.15, ..Patch::new(Triangle, 1175.0 * k) }, 0.07),\n        ],\n        c::RATE_IMMACULATE => vec![\n            (Patch { decay: 0.2, volume: 0.17, ..Patch::new(Triangle, 880.0 * k) }, 0.0),\n            (Patch { decay: 0.2, volume: 0.17, ..Patch::new(Triangle, 1318.0 * k) }, 0.06),\n            (Patch { decay: 0.45, volume: 0.17, ..Patch::new(Sine, 1760.0 * k) }, 0.12),\n        ],\n        c::CHAIN_UP => vec![\n            (Patch { freq_end: 1800.0, glide: 0.14, decay: 0.2, volume: 0.13, ..Patch::new(Triangle, 800.0) }, 0.0),\n            (Patch { decay: 0.3, volume: 0.1, ..Patch::new(Sine, 2100.0) }, 0.12),\n        ],\n        c::ON_BEAT => vec![(Patch { decay: 0.07, volume: 0.2, ..Patch::new(Sine, 2640.0) }, 0.0)],\n        c::STING => vec![\n            (Patch { attack: 0.01, decay: 0.6, volume: 0.2, cutoff: 2500.0, cutoff_end: 500.0, ..Patch::new(Saw, 92.5 * k) }, 0.0),\n            (Patch { attack: 0.01, decay: 0.6, volume: 0.16, cutoff: 2500.0, cutoff_end: 500.0, ..Patch::new(Saw, 130.8 * k) }, 0.0),\n            (Patch { attack: 0.02, decay: 0.7, volume: 0.14, ..Patch::new(Triangle, 1046.5 * k) }, 0.04),\n        ],\n        c::BURST => vec![\n            (Patch { decay: 0.3, volume: 0.42, cutoff: 3400.0 * k, cutoff_end: 200.0, ..noise }, 0.0),\n            (Patch { freq_end: 44.0, glide: 0.2, decay: 0.3, volume: 0.4, ..Patch::new(Sine, 150.0 * k) }, 0.0),\n        ],\n        c::UI_NAV => vec![(Patch { decay: 0.05, volume: 0.13, ..Patch::new(Triangle, 1240.0 * k) }, 0.0)],\n        c::UI_CONFIRM => vec![\n            (Patch { decay: 0.08, volume: 0.15, ..Patch::new(Triangle, 880.0) }, 0.0),\n            (Patch { decay: 0.14, volume: 0.15, ..Patch::new(Triangle, 1318.0) }, 0.05),\n        ],\n        c::UI_BACK => vec![(Patch { freq_end: 480.0, glide: 0.08, decay: 0.1, volume: 0.14, ..Patch::new(Triangle, 820.0) }, 0.0)],\n        c::BANNER => vec![\n            (Patch { freq_end: 40.0, glide: 0.2, decay: 0.3, volume: 0.32, ..Patch::new(Sine, 110.0) }, 0.0),\n            (Patch { decay: 0.25, volume: 0.11, cutoff: 4000.0, cutoff_end: 900.0, ..noise }, 0.0),\n        ],\n        c::FLATLINE => vec![(Patch { attack: 0.01, decay: 0.2, sustain: 0.85, hold: 2.6, release: 0.4, volume: 0.15, ..Patch::new(Sine, 1050.0) }, 0.0)],\n        c::CLINK => vec![\n            (Patch { decay: 0.11, volume: 0.17, ..Patch::new(Square, 2900.0 * k) }, 0.0),\n            (Patch { decay: 0.16, volume: 0.12, ..Patch::new(Triangle, 4100.0 * k) }, 0.01),\n        ],\n        c::FROST => vec![\n            (Patch { attack: 0.02, decay: 0.3, volume: 0.14, cutoff: 12000.0, cutoff_end: 5000.0, ..noise }, 0.0),\n            (Patch { decay: 0.3, volume: 0.07, ..Patch::new(Sine, 3200.0 * k) }, 0.03),\n        ],\n        c::CRACK => vec![\n            (Patch { decay: 0.04, volume: 0.42, cutoff: 9000.0, cutoff_end: 2000.0, ..noise }, 0.0),\n            (Patch { decay: 0.12, volume: 0.2, cutoff: 3000.0, cutoff_end: 800.0, ..noise }, 0.03),\n        ],\n        c::SNAP => vec![\n            (Patch { decay: 0.03, volume: 0.42, cutoff: 7000.0, cutoff_end: 2000.0, ..noise }, 0.0),\n            (Patch { freq_end: 110.0, glide: 0.07, decay: 0.1, volume: 0.3, ..Patch::new(Square, 280.0) }, 0.0),\n        ],\n        c::LIFT_OFF => vec![\n            (Patch { decay: 0.08, volume: 0.17, duty: 0.3, ..Patch::new(Square, 1320.0) }, 0.0),\n            (Patch { decay: 0.08, volume: 0.17, duty: 0.3, ..Patch::new(Square, 1320.0) }, 0.14),\n        ],\n        c::RING => vec![\n            (Patch { attack: 0.01, decay: 0.6, volume: 0.3, cutoff: 700.0, cutoff_end: 7000.0, ..noise }, 0.0),\n            (Patch { freq_end: 880.0, glide: 0.5, decay: 0.55, volume: 0.1, ..Patch::new(Saw, 180.0) }, 0.0),\n        ],\n        c::HUSH => vec![\n            (Patch { freq_end: 110.0, glide: 0.5, attack: 0.01, decay: 0.7, volume: 0.3, ..Patch::new(Sine, 440.0 * k) }, 0.0),\n            (Patch { attack: 0.3, decay: 1.2, volume: 0.1, ..Patch::new(Sine, 880.0 * k) }, 0.1),\n        ],\n        c::ECHO => vec![\n            (Patch { decay: 0.3, volume: 0.14, ..Patch::new(Triangle, 1046.0 * k) }, 0.0),\n            (Patch { decay: 0.3, volume: 0.1, ..Patch::new(Triangle, 1046.0 * k) }, 0.14),\n            (Patch { decay: 0.3, volume: 0.06, ..Patch::new(Triangle, 1046.0 * k) }, 0.28),\n        ],\n        c::DUET => vec![\n            (Patch { attack: 0.03, decay: 1.2, volume: 0.15, ..Patch::new(Triangle, 440.0) }, 0.0),\n            (Patch { attack: 0.03, decay: 1.2, volume: 0.15, ..Patch::new(Triangle, 660.0) }, 0.05),\n            (Patch { attack: 0.03, decay: 1.2, volume: 0.15, ..Patch::new(Triangle, 880.0) }, 0.1),\n            (Patch { attack: 0.03, decay: 1.4, volume: 0.13, ..Patch::new(Sine, 1320.0) }, 0.15),\n        ],\n        c::STAMP => vec![\n            (Patch { freq_end: 40.0, glide: 0.1, decay: 0.2, volume: 0.65, ..Patch::new(Sine, 150.0) }, 0.0),\n            (Patch { decay: 0.1, volume: 0.35, cutoff: 3200.0, cutoff_end: 500.0, ..noise }, 0.0),\n        ],\n        c::THUNDER => vec![\n            (Patch { attack: 0.03, decay: 1.6, volume: 0.55, cutoff: 900.0, cutoff_end: 70.0, ..noise }, 0.0),\n            (Patch { freq_end: 28.0, glide: 1.0, decay: 1.2, volume: 0.45, ..Patch::new(Sine, 60.0) }, 0.05),\n        ],\n        c::TEAR => vec![\n            (Patch { attack: 0.005, decay: 0.2, volume: 0.32, cutoff: 2600.0 * k, cutoff_end: 500.0, ..noise }, 0.0),\n            (Patch { freq_end: 90.0, glide: 0.14, decay: 0.16, volume: 0.2, duty: 0.3, ..Patch::new(Square, 240.0) }, 0.0),\n        ],\n        c::GIFT_ARM => vec![(Patch { attack: 0.2, decay: 0.8, volume: 0.1, ..Patch::new(Sine, 1760.0) }, 0.0)],\n        c::GASP => vec![(Patch { attack: 0.08, decay: 0.3, volume: 0.2, cutoff: 1200.0, cutoff_end: 3600.0, ..noise }, 0.0)],\n        c::LIFT => vec![\n            (Patch { decay: 0.3, volume: 0.13, ..Patch::new(Sine, 880.0) }, 0.0),\n            (Patch { attack: 0.4, decay: 0.9, volume: 0.13, cutoff: 500.0, ..Patch::new(Saw, 58.0) }, 0.0),\n        ],\n        c::PHONE => vec![\n            (Patch { decay: 0.26, sustain: 0.7, hold: 0.14, volume: 0.1, ..Patch::new(Sine, 440.0) }, 0.0),\n            (Patch { decay: 0.26, sustain: 0.7, hold: 0.14, volume: 0.1, ..Patch::new(Sine, 480.0) }, 0.0),\n        ],\n        c::GLASS => vec![\n            (Patch { decay: 0.12, volume: 0.28, cutoff: 12000.0, cutoff_end: 5000.0, ..noise }, 0.0),\n            (Patch { decay: 0.2, volume: 0.1, ..Patch::new(Triangle, 3400.0) }, 0.02),\n        ],\n        _ => Vec::new(),\n    }\n}\nEOF\ncat > crates/pav_audio/src/voice.rs <<'EOF'\n//! Animalese-style voices: each syllable of the text is a short pitched blip through two resonant\n//! formant filters chosen from the vowel. Per-character base pitch, waveform and speed; falling\n//! pitch at full stops, rising at question marks. Gibberish: no word is ever spoken.\n\nuse pav_core::games::surgery::content::Voice;\n\nuse crate::{BUS_VOICES, Patch, Sink, Wave};\n\nfn formants(ch: char) -> [f32; 2] {\n    match ch.to_ascii_lowercase() {\n        'a' => [800.0, 1200.0],\n        'e' => [500.0, 1900.0],\n        'i' | 'y' => [300.0, 2300.0],\n        'o' => [500.0, 850.0],\n        'u' => [330.0, 800.0],\n        _ => [420.0, 1500.0],\n    }\n}\n\nfn is_vowel(c: char) -> bool {\n    matches!(c.to_ascii_lowercase(), 'a' | 'e' | 'i' | 'o' | 'u' | 'y')\n}\n\nfn wave_of(name: &str) -> Wave {\n    match name {\n        \"sine\" => Wave::Sine,\n        \"square\" => Wave::Square,\n        \"saw\" => Wave::Saw,\n        _ => Wave::Triangle,\n    }\n}\n\n/// The blip for one syllable.\npub fn blip(v: &Voice, vowel: char, bend: f32, salt: u32) -> Patch {\n    let wobble = 1.0 + ((salt.wrapping_mul(2_654_435_761) >> 20) as f32 / 4096.0 - 0.5) * (0.08 + v.jitter);\n    let f = v.base.max(60.0) * bend * wobble;\n    let formant = formants(vowel);\n    let bright = v.bright.max(0.2);\n    Patch {\n        freq_end: f * 0.94,\n        glide: 0.07,\n        attack: 0.006,\n        decay: 0.058 / v.speed.max(0.4),\n        sustain: 0.25,\n        hold: 0.01,\n        release: 0.02,\n        volume: 0.52,\n        cutoff: 5200.0 * bright,\n        cutoff_end: 3000.0 * bright,\n        formant: [formant[0] * (0.85 + bright * 0.2), formant[1] * (0.85 + bright * 0.2)],\n        reso: 5.0,\n        duty: 0.4,\n        ..Patch::new(wave_of(&v.wave), f)\n    }\n}\n\n/// Speaks the syllables of `text` between char indexes `from..to`, at this voice. A syllable starts\n/// where a vowel follows a non-vowel. Returns how many it played.\npub fn speak(sink: &mut dyn Sink, v: &Voice, text: &str, from: usize, to: usize, gain: f32) -> u32 {\n    let chars: Vec<char> = text.chars().collect();\n    let mut played = 0;\n    for i in from..to.min(chars.len()) {\n        let c = chars[i];\n        if !is_vowel(c) || (i > 0 && is_vowel(chars[i - 1])) {\n            continue;\n        }\n        // The sentence's end colours its last syllables.\n        let next_stop = chars[i..].iter().take(14).position(|x| matches!(x, '.' | '?' | '!'));\n        let bend = match next_stop.map(|n| (n, chars[i + n])) {\n            Some((n, '.')) => 1.0 - (14 - n) as f32 * 0.016,\n            Some((n, '?')) => 1.0 + (14 - n) as f32 * 0.024,\n            Some((n, '!')) => 1.08 + (14 - n) as f32 * 0.006,\n            _ => 1.0,\n        };\n        sink.send(BUS_VOICES, blip(v, c, bend, i as u32 * 31 + c as u32), 0.0, gain, 0.0);\n        played += 1;\n    }\n    played\n}\nEOF\ncat > crates/pav_audio/src/music.rs <<'EOF'\n//! The music: a small note-event sequencer on the render thread that schedules ahead with the\n//! mixer's `delay`, so tempo can follow the heart. Every melody here is written for this game.\n//! Notes are text: `A4:2` is the A above middle C for two beats, `.:1` a rest, `C4+E4+G4:3` a chord.\n\nuse crate::{BUS_MUSIC, Patch, Sink, Wave};\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Instr {\n    Piano,\n    Pad,\n    Bass,\n    Pluck,\n    Bell,\n    Strings,\n    Pulse,\n}\n\n#[derive(Clone, Copy, Debug)]\npub struct Note {\n    pub at: f32,\n    pub midi: u8,\n    pub len: f32,\n    pub vel: f32,\n    pub instr: Instr,\n}\n\nfn midi_of(name: &str) -> Option<u8> {\n    let b = name.as_bytes();\n    let base = match b.first()? {\n        b'C' => 0,\n        b'D' => 2,\n        b'E' => 4,\n        b'F' => 5,\n        b'G' => 7,\n        b'A' => 9,\n        b'B' => 11,\n        _ => return None,\n    };\n    let mut i = 1;\n    let mut acc = 0i32;\n    if b.get(1) == Some(&b'#') {\n        acc = 1;\n        i = 2;\n    } else if b.get(1) == Some(&b'b') {\n        acc = -1;\n        i = 2;\n    }\n    let octave: i32 = name[i..].parse().ok()?;\n    Some(((octave + 1) * 12 + base + acc) as u8)\n}\n\n/// Parses a line of notes into events, from beat 0.\npub fn line(text: &str, instr: Instr, vel: f32) -> Vec<Note> {\n    let mut at = 0.0;\n    let mut out = Vec::new();\n    for tok in text.split_whitespace() {\n        let (names, len) = tok.split_once(':').unwrap_or((tok, \"1\"));\n        let len: f32 = len.parse().unwrap_or(1.0);\n        if names != \".\" {\n            for n in names.split('+') {\n                if let Some(midi) = midi_of(n) {\n                    out.push(Note { at, midi, len, vel, instr });\n                }\n            }\n        }\n        at += len;\n    }\n    out\n}\n\n/// A track: its loop length in beats, notes, and how it keeps time.\n#[derive(Clone, Debug)]\npub struct Track {\n    pub bar: u8,\n    pub length: f32,\n    pub notes: Vec<Note>,\n    /// Beats per minute for tracks that don't follow the heart (0 = follow it).\n    pub tempo: f32,\n    /// A layer that fades in with the crisis.\n    pub crisis: Vec<Note>,\n    /// Plays once, then silence.\n    pub once: bool,\n}\n\nfn join(parts: Vec<Vec<Note>>) -> Vec<Note> {\n    parts.into_iter().flatten().collect()\n}\n\n/// The track table, by `content::MUSIC` id.\npub fn track(id: u8) -> Option<Track> {\n    use Instr::*;\n    Some(match id {\n        // Title: slow, minor, a piano in an empty ward; in three, because it knows.\n        1 => Track {\n            bar: 3,\n            length: 48.0,\n            tempo: 54.0,\n            once: false,\n            crisis: Vec::new(),\n            notes: join(vec![\n                line(\n                    \"A4:1 C5:1 E5:1 | D5:2 C5:1 B4:2 G4:1 A4:3 | E4:1 A4:1 C5:1 F5:2 E5:1 D5:1 C5:1 B4:1 C5:3\",\n                    Piano,\n                    0.75,\n                ),\n                shift(line(\"A5:2 G5:1 F5:2 E5:1 D5:1 F5:1 A5:1 G5:3 E5:1 C5:1 D5:1 E5:2 C5:1 B4:1 A4:1 G#4:1 A4:3 .:3\", Piano, 0.7), 24.0),\n                line(\n                    \"A2+E3:3 A2+E3:3 F2+C3:3 F2+C3:3 D3+A3:3 D3+A3:3 E2+B2:3 A2+E3:3 F2+C3:3 C3+G3:3 D3+A3:3 E2+B2:3 F2+C3:3 D3+A3:3 E2+B2:3 A2+E3:3\",\n                    Piano,\n                    0.32,\n                ),\n            ]),\n        },\n        // Tender: story's quiet scenes, a rocking major-with-doubts.\n        2 => Track {\n            bar: 4,\n            length: 32.0,\n            tempo: 66.0,\n            once: false,\n            crisis: Vec::new(),\n            notes: join(vec![\n                line(\"E5:2 D5:1 C5:1 G4:3 .:1 A4:1 C5:1 F5:2 E5:3 .:1 D5:1 E5:1 F5:1 A5:1 G5:2 E5:1 C5:1 D5:2 B4:2 C5:3 .:1\", Piano, 0.55),\n                line(\"C3+G3+E4:4 A2+E3+C4:4 F2+C3+A3:4 C3+G3+E4:4 D3+A3+F4:4 G2+D3+B3:4 A2+E3+C4:2 F2+C3+A3:2 G2+D3+B3:2 C3+G3+E4:2\", Pad, 0.32),\n            ]),\n        },\n        // Tense: story's dark scenes; a pedal and a falling cello line.\n        3 => Track {\n            bar: 4,\n            length: 16.0,\n            tempo: 72.0,\n            once: false,\n            crisis: Vec::new(),\n            notes: join(vec![\n                line(\"D2:1 .:1 D2:1 .:1 D2:1 .:1 D2:1 .:1 Bb1:1 .:1 Bb1:1 .:1 A1:1 .:1 A1:1 .:1\", Bass, 0.8),\n                line(\"A4:3 G4:1 F4:3 E4:1 D4:3 F4:1 E4:4\", Strings, 0.42),\n                line(\".:8 D5:2 C#5:2 D5:1 F5:1 E5:2\", Bell, 0.2),\n            ]),\n        },\n        // The OR loop: its bass lands on the actual heartbeat.\n        4 => Track {\n            bar: 4,\n            length: 16.0,\n            tempo: 0.0,\n            once: false,\n            crisis: join(vec![\n                line(\"A5:1 C6:1 A5:1 G5:1 F5:1 A5:1 F5:1 E5:1 D5:1 F5:1 D5:1 C5:1 B4:1 D5:1 E5:2\", Pluck, 0.5),\n                line(\"A2:0.5 A2:0.5 A2:0.5 A2:0.5 A2:0.5 A2:0.5 A2:0.5 A2:0.5 F2:0.5 F2:0.5 F2:0.5 F2:0.5 F2:0.5 F2:0.5 F2:0.5 F2:0.5 D2:0.5 D2:0.5 D2:0.5 D2:0.5 D2:0.5 D2:0.5 D2:0.5 D2:0.5 E2:0.5 E2:0.5 E2:0.5 E2:0.5 E2:0.5 E2:0.5 E2:0.5 E2:0.5\", Pulse, 0.42),\n            ]),\n            notes: join(vec![\n                line(\"A1:1 A1:1 A1:1 A1:1 F1:1 F1:1 F1:1 F1:1 D2:1 D2:1 D2:1 D2:1 E1:1 E1:1 E1:1 E1:1\", Bass, 0.9),\n                line(\"A3+C4+E4:4 F3+A3+C4:4 D3+F3+A3:4 E3+G#3+B3:4\", Pad, 0.3),\n                line(\".:2 E5:1 .:1 .:2 C5:1 .:1 .:2 A4:1 .:1 .:2 B4:1 .:1\", Pluck, 0.3),\n            ]),\n        },\n        // Introit: a waltz nobody asked for, 3/4.\n        5 => Track {\n            bar: 3,\n            length: 24.0,\n            tempo: 0.0,\n            once: false,\n            crisis: line(\"E6:0.5 D#6:0.5 E6:0.5 B5:0.5 D6:0.5 C6:0.5 A5:1.5 .:1.5\", Bell, 0.3),\n            notes: join(vec![\n                line(\"D5:2 F5:1 A5:2 G5:1 F5:1 E5:1 D5:1 C#5:3 D5:2 E5:1 F5:2 A5:1 G5:1 E5:1 C#5:1 D5:3\", Strings, 0.5),\n                line(\"D2:1 A3+F4:1 A3+F4:1 D2:1 A3+F4:1 A3+F4:1 A1:1 G3+E4:1 G3+E4:1 A1:1 G3+E4:1 G3+E4:1 D2:1 A3+F4:1 A3+F4:1 Bb1:1 G3+D4:1 G3+D4:1 A1:1 G3+E4:1 G3+E4:1 D2:1 A3+F4:1 A3+F4:1\", Piano, 0.4),\n            ]),\n        },\n        // Lacrimosa: a weeping 6/8.\n        6 => Track {\n            bar: 6,\n            length: 24.0,\n            tempo: 0.0,\n            once: false,\n            crisis: line(\"G5:1 Bb5:1 D6:1 C6:1 Bb5:1 A5:1\", Bell, 0.25),\n            notes: join(vec![\n                line(\"D5:3 C5:1 Bb4:1 A4:1 Bb4:2 G4:1 F#4:3 G4:1 A4:1 Bb4:1 D5:1 C5:1 Bb4:1 A4:6\", Strings, 0.5),\n                line(\"G2:1 D3:1 G3:1 Bb3:1 G3:1 D3:1 D2:1 A2:1 D3:1 F#3:1 D3:1 A2:1 Eb2:1 Bb2:1 Eb3:1 G3:1 Eb3:1 Bb2:1 D2:1 A2:1 D3:1 F#3:1 D3:1 A2:1\", Pluck, 0.42),\n            ]),\n        },\n        // Dies Irae: a furious 5/4, built on the count.\n        7 => Track {\n            bar: 5,\n            length: 20.0,\n            tempo: 0.0,\n            once: false,\n            crisis: line(\"F5:0.5 E5:0.5 F5:0.5 G5:0.5 Ab5:1 G5:1 F5:1\", Strings, 0.4),\n            notes: join(vec![\n                line(\"F2:1 F2:1 C3:1 F2:1 Ab2:1 Eb2:1 Eb2:1 Bb2:1 Eb2:1 G2:1 Db2:1 Db2:1 Ab2:1 Db2:1 F2:1 C2:1 C2:1 G2:1 C2:1 E2:1\", Bass, 0.85),\n                line(\"C5:2 Db5:1 C5:1 Ab4:1 Bb4:2 C5:1 Bb4:1 G4:1 Ab4:2 Bb4:1 Ab4:1 F4:1 G4:3 .:2\", Strings, 0.48),\n                line(\".:4 F4+Ab4+C5:1 .:4 Eb4+G4+Bb4:1 .:4 Db4+F4+Ab4:1 .:4 C4+E4+G4:1\", Pulse, 0.5),\n            ]),\n        },\n        // Libera Me: everything, shifting; here in a restless 7/8.\n        8 => Track {\n            bar: 7,\n            length: 28.0,\n            tempo: 0.0,\n            once: false,\n            crisis: line(\"A5:1 G5:1 A5:1 C6:1 B5:1 A5:1 E5:1\", Bell, 0.28),\n            notes: join(vec![\n                line(\"A1:1 E2:1 A2:1 E2:1 A1:1 E2:1 A2:1 F1:1 C2:1 F2:1 C2:1 F1:1 C2:1 F2:1 D2:1 A2:1 D3:1 A2:1 D2:1 A2:1 D3:1 E1:1 B1:1 E2:1 B1:1 E1:1 G#1:1 B1:1\", Bass, 0.8),\n                line(\"A4:3 C5:2 E5:2 F5:3 E5:2 C5:2 D5:3 F5:2 A5:2 G#5:3 E5:2 B4:2\", Strings, 0.5),\n            ]),\n        },\n        // Code Blue: the drive.\n        9 => Track {\n            bar: 4,\n            length: 16.0,\n            tempo: 0.0,\n            once: false,\n            crisis: line(\"D6:0.5 C6:0.5 A5:0.5 G5:0.5 A5:1 .:1\", Bell, 0.3),\n            notes: join(vec![\n                line(\"D2:0.5 D2:0.5 D3:0.5 D2:0.5 D2:0.5 D2:0.5 C3:0.5 D2:0.5 Bb1:0.5 Bb1:0.5 Bb2:0.5 Bb1:0.5 F2:0.5 F2:0.5 F3:0.5 F2:0.5 G1:0.5 G1:0.5 G2:0.5 G1:0.5 G1:0.5 G1:0.5 F2:0.5 G1:0.5 A1:0.5 A1:0.5 A2:0.5 A1:0.5 A1:0.5 C#2:0.5 E2:0.5 A2:0.5\", Pulse, 0.5),\n                line(\"D5:1 F5:1 A5:2 Bb4:1 D5:1 F5:2 G4:1 Bb4:1 D5:2 A4:1 C#5:1 E5:2\", Strings, 0.42),\n            ]),\n        },\n        // Results: a small fanfare that won't quite believe it.\n        10 => Track {\n            bar: 4,\n            length: 12.0,\n            tempo: 92.0,\n            once: true,\n            crisis: Vec::new(),\n            notes: join(vec![\n                line(\"C5:0.5 E5:0.5 G5:1 C6:2 B5:0.5 A5:0.5 G5:1 E5:2 F5:1 A5:1 G5:1 E5:1\", Bell, 0.42),\n                line(\"C3+G3+E4:4 F3+C4+A4:2 G3+D4+B4:2 C3+G3+E4:4\", Pad, 0.36),\n            ]),\n        },\n        _ => return None,\n    })\n}\n\nfn shift(mut v: Vec<Note>, by: f32) -> Vec<Note> {\n    for n in &mut v {\n        n.at += by;\n    }\n    v\n}\n\nfn hz(midi: u8) -> f32 {\n    440.0 * 2f32.powf((midi as f32 - 69.0) / 12.0)\n}\n\n/// The sound of a note. `secs` is its length in seconds; `dark` low-passes it (the Hush).\npub fn voice_of(n: &Note, secs: f32, dark: f32) -> Vec<(Patch, f32)> {\n    let f = hz(n.midi);\n    let v = n.vel;\n    let mut out = match n.instr {\n        Instr::Piano => vec![\n            (Patch { attack: 0.004, decay: secs.max(0.5) * 1.2, volume: 0.42 * v, cutoff: 3800.0, cutoff_end: 800.0, ..Patch::new(Wave::Triangle, f) }, 0.0),\n            (Patch { attack: 0.002, decay: 0.3, volume: 0.13 * v, ..Patch::new(Wave::Sine, f * 2.0) }, 0.0),\n            (Patch { attack: 0.001, decay: 0.05, volume: 0.05 * v, cutoff: 5000.0, ..Patch::new(Wave::Saw, f * 3.0) }, 0.0),\n        ],\n        Instr::Pad => vec![\n            (Patch { attack: 0.25, decay: 0.3, sustain: 0.75, hold: (secs - 0.5).max(0.1), release: 0.35, volume: 0.22 * v, cutoff: 1100.0, cutoff_end: 700.0, ..Patch::new(Wave::Saw, f) }, 0.0),\n            (Patch { attack: 0.3, decay: 0.3, sustain: 0.75, hold: (secs - 0.5).max(0.1), release: 0.35, volume: 0.16 * v, ..Patch::new(Wave::Sine, f * 1.003) }, 0.0),\n        ],\n        Instr::Bass => vec![\n            (Patch { attack: 0.006, decay: secs.min(0.6), sustain: 0.1, release: 0.06, volume: 0.62 * v, cutoff: 500.0, cutoff_end: 200.0, ..Patch::new(Wave::Triangle, f) }, 0.0),\n            (Patch { attack: 0.004, decay: 0.09, volume: 0.32 * v, ..Patch::new(Wave::Sine, f * 2.0) }, 0.0),\n        ],\n        Instr::Pluck => vec![(Patch { attack: 0.002, decay: 0.26, volume: 0.32 * v, cutoff: 3000.0, cutoff_end: 500.0, duty: 0.3, ..Patch::new(Wave::Square, f) }, 0.0)],\n        Instr::Bell => vec![\n            (Patch { attack: 0.002, decay: 0.8, volume: 0.27 * v, ..Patch::new(Wave::Sine, f) }, 0.0),\n            (Patch { attack: 0.002, decay: 0.4, volume: 0.11 * v, ..Patch::new(Wave::Sine, f * 2.76) }, 0.0),\n        ],\n        Instr::Strings => vec![\n            (Patch { attack: 0.09, decay: 0.2, sustain: 0.8, hold: (secs - 0.25).max(0.05), release: 0.18, volume: 0.26 * v, cutoff: 2200.0, cutoff_end: 1600.0, ..Patch::new(Wave::Saw, f) }, 0.0),\n            (Patch { attack: 0.09, decay: 0.2, sustain: 0.8, hold: (secs - 0.25).max(0.05), release: 0.18, volume: 0.18 * v, cutoff: 2200.0, ..Patch::new(Wave::Saw, f * 1.006) }, 0.0),\n        ],\n        Instr::Pulse => vec![(Patch { attack: 0.003, decay: secs.min(0.2), volume: 0.34 * v, cutoff: 1500.0, cutoff_end: 500.0, duty: 0.25, ..Patch::new(Wave::Square, f) }, 0.0)],\n    };\n    if dark > 0.0 {\n        for (p, _) in &mut out {\n            p.cutoff = p.cutoff.min(4000.0 - 3500.0 * dark);\n            p.cutoff_end = p.cutoff_end.min(4000.0 - 3500.0 * dark);\n        }\n    }\n    out\n}\n\n/// What the music follows, per frame.\n#[derive(Clone, Copy, Debug, Default)]\npub struct Follow {\n    pub track: u8,\n    /// Which beat the heart is on, with its phase: the sequencer's clock in an operation.\n    pub beat_pos: f64,\n    pub bpm: f32,\n    pub stopped: bool,\n    pub crisis: f32,\n    pub hush: f32,\n}\n\n#[derive(Default)]\npub struct Sequencer {\n    current: u8,\n    data: Option<Track>,\n    /// Musical position: beats since the track started.\n    pos: f64,\n    origin: f64,\n    /// Everything before this has been scheduled.\n    done_until: f64,\n    hush_t: f32,\n    pub notes_played: u64,\n}\n\nconst LOOK_AHEAD: f64 = 0.28;\n\nimpl Sequencer {\n    /// Advances the clock and schedules what comes due. Call once a render frame.\n    pub fn update(&mut self, sink: &mut dyn Sink, f: Follow, dt: f32) {\n        if f.track != self.current || self.data.is_none() && f.track != 0 {\n            self.current = f.track;\n            self.data = track(f.track);\n            self.pos = 0.0;\n            self.origin = f.beat_pos;\n            self.done_until = 0.0;\n        }\n        // The Hush: everything low, one held note.\n        if f.hush > 0.0 {\n            self.hush_t -= dt;\n            if self.hush_t <= 0.0 {\n                self.hush_t = 2.8;\n                let n = Note { at: 0.0, midi: 69, len: 3.0, vel: 0.9, instr: Instr::Pad };\n                for (p, d) in voice_of(&n, 3.0, 0.3) {\n                    sink.send(BUS_MUSIC, p, 0.0, 1.0, d);\n                }\n            }\n        } else {\n            self.hush_t = 0.0;\n        }\n        let Some(data) = self.data.clone() else { return };\n        if f.stopped {\n            return;\n        }\n        let bpm = if data.tempo > 0.0 { data.tempo } else { f.bpm.clamp(40.0, 200.0) };\n        if data.tempo > 0.0 {\n            self.pos += dt as f64 * bpm as f64 / 60.0;\n        } else {\n            // Heart time: the bass lands on the actual beat.\n            let p = f.beat_pos - self.origin;\n            if p < self.pos - 8.0 {\n                self.origin = f.beat_pos;\n                self.done_until = 0.0;\n            }\n            self.pos = (f.beat_pos - self.origin).max(self.pos);\n        }\n        let ahead = self.pos + LOOK_AHEAD * bpm as f64 / 60.0;\n        let (from, to) = (self.done_until.max(self.pos - 0.01), ahead);\n        if to <= from {\n            return;\n        }\n        let quiet = f.hush > 0.0;\n        self.schedule(sink, &data.notes, data.length, data.once, from, to, bpm, if quiet { 0.25 } else { 1.0 }, f.hush);\n        if f.crisis > 0.02 && !quiet {\n            let n = data.crisis.iter().map(|c| c.at + c.len).fold(0.0f32, f32::max).max(1.0);\n            let length = (data.length / n).round().max(1.0) * n;\n            self.schedule(sink, &data.crisis, length, data.once, from, to, bpm, f.crisis, 0.0);\n        }\n        self.done_until = to;\n    }\n\n    #[allow(clippy::too_many_arguments)]\n    fn schedule(&mut self, sink: &mut dyn Sink, notes: &[Note], length: f32, once: bool, from: f64, to: f64, bpm: f32, gain: f32, dark: f32) {\n        let length = length as f64;\n        let first_loop = (from / length).floor() as i64;\n        let last_loop = (to / length).floor() as i64;\n        for lp in first_loop..=last_loop {\n            if once && lp > 0 {\n                break;\n            }\n            for n in notes {\n                let t = lp as f64 * length + n.at as f64;\n                if t >= from && t < to {\n                    let delay = ((t - self.pos) * 60.0 / bpm as f64).max(0.0) as f32;\n                    let secs = n.len * 60.0 / bpm;\n                    for (p, d) in voice_of(n, secs, dark) {\n                        sink.send(BUS_MUSIC, p, 0.0, gain, delay + d);\n                    }\n                    self.notes_played += 1;\n                }\n            }\n        }\n    }\n}\nEOF\ncat > crates/pav_audio/src/director.rs <<'EOF'\n//! Runs the game's sound from its frames: music tempo from the heart, gibberish voices as text\n//! types out, on any `Sink`.\n\nuse pav_core::games::surgery::content::content;\nuse pav_core::games::surgery::frame::{Stage, SurgeryFrame};\n\nuse crate::Sink;\nuse crate::music::{Follow, Sequencer};\nuse crate::voice;\n\n#[derive(Default)]\npub struct Director {\n    pub seq: Sequencer,\n    voiced: (u16, u16, usize),\n    callout: (String, usize),\n    /// Blips played: tests read it.\n    pub blips: u64,\n}\n\nimpl Director {\n    pub fn update(&mut self, sink: &mut dyn Sink, f: &SurgeryFrame, dt: f32) {\n        let c = content();\n        let track = match f.stage {\n            Stage::Dead | Stage::Done => 0,\n            _ => f.music,\n        };\n        let follow = Follow {\n            track,\n            beat_pos: f.beats as f64 + f.beat as f64,\n            bpm: f.bpm,\n            stopped: f.stopped,\n            crisis: f.crisis,\n            hush: f.hush,\n        };\n        self.seq.update(sink, follow, dt);\n\n        // A story line types out, syllable by syllable.\n        if let Some(st) = &f.story {\n            let key = (st.scene, st.line);\n            if (self.voiced.0, self.voiced.1) != key {\n                self.voiced = (key.0, key.1, 0);\n            }\n            let typed = (st.typed as usize).min(st.text.chars().count());\n            if typed > self.voiced.2 {\n                if let Some(rig) = c.rigs.get(&st.who) {\n                    self.blips += voice::speak(sink, &rig.voice, &st.text, self.voiced.2, typed, 1.0) as u64;\n                }\n                self.voiced.2 = typed;\n            }\n        }\n        // A callout in the operation, likewise.\n        if let Some(cl) = &f.callout {\n            if self.callout.0 != cl.text {\n                self.callout = (cl.text.clone(), 0);\n            }\n            let typed = ((cl.age * 38.0) as usize).min(cl.text.chars().count());\n            if typed > self.callout.1 {\n                if let Some(rig) = c.rigs.get(&cl.who) {\n                    self.blips += voice::speak(sink, &rig.voice, &cl.text, self.callout.1, typed, 0.9) as u64;\n                }\n                self.callout.1 = typed;\n            }\n        } else {\n            self.callout.0.clear();\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use crate::music::{self, Follow, Sequencer};\n    use crate::{BUS_MUSIC, BUS_VOICES, Mixer, Sink};\n    use pav_core::games::surgery::content::MUSIC;\n    use pav_core::games::surgery::cue;\n\n    fn peak(buf: &[f32]) -> f32 {\n        buf.iter().fold(0.0f32, |m, s| m.max(s.abs()))\n    }\n\n    #[test]\n    fn every_cue_renders_non_silent() {\n        for (id, name) in cue::NAMES.iter().enumerate() {\n            let mut m = Mixer::new(22050.0);\n            for (p, d) in crate::cues::sounds(id as u16, 1.0, 1.0) {\n                m.play(p, 0.0, 1.0, d);\n            }\n            let mut out = vec![0.0; 22050];\n            m.render(&mut out);\n            assert!(peak(&out) > 0.01, \"cue {name} is silent: {}\", peak(&out));\n        }\n    }\n\n    #[test]\n    fn every_track_renders_and_really_is_music() {\n        for (id, name) in MUSIC.iter().enumerate().skip(1) {\n            let t = music::track(id as u8).unwrap_or_else(|| panic!(\"track {name}\"));\n            assert!(t.notes.len() > 8, \"{name} has a real score\");\n            let mut pitches: Vec<u8> = t.notes.iter().map(|n| n.midi).collect();\n            pitches.sort();\n            pitches.dedup();\n            assert!(pitches.len() >= 6, \"{name} has a melody: {} pitches\", pitches.len());\n            let mut m = Mixer::new(22050.0);\n            let mut seq = Sequencer::default();\n            let mut out = vec![0.0; 2048 * 2];\n            let mut loudest = 0.0f32;\n            let mut beat = 0.0f64;\n            for _ in 0..60 {\n                let dt = 2048.0 / 22050.0;\n                beat += dt as f64 * 80.0 / 60.0;\n                seq.update(&mut m, Follow { track: id as u8, beat_pos: beat, bpm: 80.0, ..Default::default() }, dt);\n                m.render(&mut out);\n                loudest = loudest.max(peak(&out));\n            }\n            assert!(loudest > 0.02, \"track {name} is silent ({loudest})\");\n            assert!(seq.notes_played > 3, \"{name}\");\n        }\n    }\n\n    #[test]\n    fn the_bass_lands_on_the_heartbeat_and_follows_the_tempo() {\n        struct Log(Vec<f32>);\n        impl Sink for Log {\n            fn send(&mut self, _: u8, _: crate::Patch, _: f32, _: f32, delay: f32) {\n                self.0.push(delay);\n            }\n        }\n        let mut seq = Sequencer::default();\n        let mut log = Log(Vec::new());\n        // Just before a beat, at 120 bpm: the bass note is due in about 0.05 s.\n        seq.update(&mut log, Follow { track: 4, beat_pos: 3.0, bpm: 120.0, ..Default::default() }, 0.0);\n        log.0.clear();\n        seq.update(&mut log, Follow { track: 4, beat_pos: 3.9, bpm: 120.0, ..Default::default() }, 0.016);\n        assert!(log.0.iter().any(|d| (*d - 0.05).abs() < 0.02), \"{:?}\", log.0);\n    }\n\n    #[test]\n    fn voices_are_pitched_per_character_and_silent_only_when_they_should_be() {\n        let c = content();\n        for (id, rig) in &c.rigs {\n            let mut m = Mixer::new(22050.0);\n            let n = voice::speak(&mut m, &rig.voice, \"Doctor, the mass moved.\", 0, 23, 1.0);\n            assert!(n >= 5, \"{id}: {n} syllables\");\n            let mut out = vec![0.0; 22050];\n            m.render(&mut out);\n            assert!(peak(&out) > 0.02, \"{id} is silent: {}\", peak(&out));\n            assert!(m.peak[BUS_VOICES as usize] > 0.0);\n            assert_eq!(m.peak[BUS_MUSIC as usize], 0.0);\n        }\n        // Mara is higher than Pet, by design.\n        assert!(c.rigs[\"mara\"].voice.base > c.rigs[\"pet\"].voice.base * 1.5);\n    }\n\n    #[test]\n    fn a_bus_gain_scales_only_its_bus() {\n        let mut m = Mixer::new(22050.0);\n        m.bus = [1.0, 0.1, 1.0];\n        let n = music::Note { at: 0.0, midi: 69, len: 1.0, vel: 1.0, instr: music::Instr::Bell };\n        for (p, d) in music::voice_of(&n, 1.0, 0.0) {\n            m.play_on(BUS_MUSIC, p, 0.0, 1.0, d);\n        }\n        let mut quiet = vec![0.0; 8192];\n        m.render(&mut quiet);\n        let mut m = Mixer::new(22050.0);\n        m.bus = [1.0, 1.0, 1.0];\n        for (p, d) in music::voice_of(&n, 1.0, 0.0) {\n            m.play_on(BUS_MUSIC, p, 0.0, 1.0, d);\n        }\n        let mut loud = vec![0.0; 8192];\n        m.render(&mut loud);\n        assert!(peak(&loud) > peak(&quiet) * 5.0);\n    }\n}\nEOF\nsed -i 's/ | D5:2 C5:1/ D5:2 C5:1/' crates/pav_audio/src/music.rs\n../tools/cb.sh test --locked -p pav_audio 2>&1 | grep -E \"^error|^test |test result|panicked|-->\" | head -40","description":"Add mixer buses, cue table, voices, music sequencer and director","timeout":500000}}}
