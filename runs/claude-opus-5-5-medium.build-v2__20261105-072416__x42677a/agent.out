{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjxJAc6Cp7RbW1iDDDep","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14457,"cache_read_input_tokens":309494,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14457},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"ff18be4c-2af0-4d1d-a8d8-e2e6a0d928b2","timestamp":"2026-11-05T14:40:00.874Z","request_id":"req_011CgjxJAKUSukQo2sSdrwXU","thinking_duration_ms":1204,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjxJAc6Cp7RbW1iDDDep","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01ESPdhdiBwQkSGj85c1tkfQ","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery/mod.rs","content":"//! The surgical-action melodrama: cases and story as one deterministic phase machine.\n//!\n//! Scenes: `surgery/title`, `surgery/campaign` (or `surgery/campaign/<from>`), `surgery/case/<n>`\n//! (or `surgery/case/<n>/<phase>`), `surgery/codeblue`, `surgery/attract`, `surgery/card`,\n//! `surgery/mirror`. The bot presses through story and plays operations, so `surgery/campaign`\n//! is the scripted playthrough of the whole game. `content/README.md` is the designer guide.\n\npub mod bot;\npub mod content;\npub mod cover;\npub mod cue;\npub mod field;\npub mod frame;\npub mod net;\npub mod strain;\npub mod tune;\n\nuse std::collections::BTreeMap;\nuse std::sync::Arc;\n\nuse anyhow::{Result, anyhow, bail};\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\nuse serde_json::json;\n\nuse self::content::{CODE_BLUE, content, music_id};\nuse self::field::{Eng, Kind, Op, Rules, Tool};\nuse self::frame::{ActorView, CameraShot, ResultsView, SlotView, Stage, StoryView, SurgeryFrame};\nuse self::tune::{Difficulty, Tune};\nuse super::{Game, GameBox, Outcome};\nuse crate::entity::EntityId;\nuse crate::frame::SimEvent;\nuse crate::input::{InputFrame, SurgeonInput, surgeon_buttons as btn};\nuse crate::room::RoomDef;\nuse crate::sim::Sim;\n\n/// The OR wide-shot set, a room file far from the field.\nconst LEVEL: &str = include_str!(\"surgery.toml\");\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum Mode {\n    #[default]\n    Title,\n    Campaign,\n    /// One case by itself.\n    Case,\n    CodeBlue,\n    Attract,\n    Card,\n    Mirror,\n}\n\n/// Dev switches (the panel's Tools page).\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct Dev {\n    pub immortal: bool,\n    pub freeze_timer: bool,\n    pub full_gift: bool,\n    pub one_hit: bool,\n    /// The bot plays the human's seat too.\n    pub bot_plays: bool,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Story {\n    pub scene: u16,\n    pub line: u16,\n    pub typed: f32,\n    pub hold: f32,\n    pub actors: Vec<ActorView>,\n    pub set: String,\n    pub camera: u8,\n    pub flash: f32,\n    pub shake: f32,\n    pub who: String,\n    pub text: String,\n    pub expr: String,\n    /// Waiting on a line (false while running stage commands).\n    pub line_age: f32,\n}\n\n#[derive(Clone, Serialize, Deserialize)]\npub struct Surgery {\n    pub mode: Mode,\n    pub stage: Stage,\n    pub stage_t: f32,\n    pub case: u8,\n    pub story: Option<Story>,\n    pub op: Option<Box<Op>>,\n    pub results: Option<ResultsView>,\n    pub outcome: Outcome,\n    pub tune: Tune,\n    pub diff: Difficulty,\n    pub dev: Dev,\n    pub tremor: bool,\n    pub bot_skill: f32,\n    pub tick: u64,\n    pub time: f32,\n    pub cov: Vec<u32>,\n    pub music: u8,\n    pub text_speed: f32,\n    pub auto_advance: bool,\n    pub seed: u64,\n    /// Seconds of attract spent on this segment, and which.\n    pub demo_seg: u8,\n    pub demo_t: f32,\n    /// Slot 0 isn't played from this copy (a hub server, a client).\n    pub no_local: bool,\n    pub death_time: String,\n    /// The last result, for the shell to save.\n    pub last_rank: Option<(u8, String, i64)>,\n    pub cases_won: u8,\n    #[serde(skip)]\n    pub mirror_frame: Option<Arc<SurgeryFrame>>,\n}\n\n/// The scene's game state, for tools.\npub fn get(sim: &Sim) -> Option<&Surgery> {\n    sim.play()?.get::<Surgery>()\n}\n\npub fn get_mut(sim: &mut Sim) -> Option<&mut Surgery> {\n    sim.state.play.as_mut()?.get_mut::<Surgery>()\n}\n\n/// What `RenderFrame::surgery` holds.\npub fn frame_of(sim: &Sim) -> Option<Arc<SurgeryFrame>> {\n    let g = get(sim)?;\n    if let Some(m) = &g.mirror_frame {\n        return Some(m.clone());\n    }\n    Some(Arc::new(g.frame()))\n}\n\n/// Builds the scene: `surgery/<what>`.\npub fn build(sim: &mut Sim, rest: Option<&str>) -> Result<()> {\n    let def = RoomDef::parse(&super::level_text(\"surgery/surgery\", LEVEL)).map_err(|e| anyhow!(\"surgery.toml: {e}\"))?;\n    crate::scenes::build_standalone_room(sim, \"surgery\", def);\n    if let Some(p) = sim.state.player {\n        sim.despawn(p);\n    }\n    sim.state.focus = glam::Vec3::new(0.0, 0.0, 0.2);\n    let seed = sim.state.rng.next_u32() as u64;\n    let mut g = Surgery::new(seed);\n    let parts: Vec<&str> = rest.unwrap_or(\"title\").split('/').collect();\n    match parts[0] {\n        \"title\" => g.mode = Mode::Title,\n        \"card\" => g.mode = Mode::Card,\n        \"mirror\" => g.mode = Mode::Mirror,\n        \"campaign\" => {\n            g.mode = Mode::Campaign;\n            let from: usize = parts.get(1).and_then(|p| p.parse().ok()).unwrap_or(0);\n            g.begin_case(from.min(7));\n        }\n        \"case\" => {\n            g.mode = Mode::Case;\n            let n: usize = parts.get(1).ok_or_else(|| anyhow!(\"surgery/case/<n>: which case?\"))?.parse()?;\n            if n >= CODE_BLUE {\n                bail!(\"surgery/case/{n}: cases are 0 to 7\");\n            }\n            let phase: Option<usize> = parts.get(2).and_then(|p| p.parse().ok());\n            g.begin_op(n);\n            if let Some(p) = phase {\n                g.jump_phase(p);\n            }\n            g.stage = Stage::Op;\n        }\n        \"codeblue\" => {\n            g.mode = Mode::CodeBlue;\n            g.begin_op(CODE_BLUE);\n            g.stage = Stage::Op;\n        }\n        \"attract\" => {\n            g.mode = Mode::Attract;\n            g.dev.immortal = true;\n            g.dev.full_gift = true;\n            g.demo_seg = 0;\n            g.begin_demo_segment();\n        }\n        other => bail!(\"unknown surgery scene '{other}' (title, campaign, case/<n>, codeblue, attract, card, mirror)\"),\n    }\n    sim.state.play = Some(GameBox::new(g));\n    Ok(())\n}\n\nimpl Surgery {\n    pub fn new(seed: u64) -> Self {\n        let bot_skill = 1.0;\n        Surgery {\n            mode: Mode::Title,\n            stage: Stage::Title,\n            stage_t: 0.0,\n            case: 0,\n            story: None,\n            op: None,\n            results: None,\n            outcome: Outcome::Playing,\n            tune: Tune::default(),\n            diff: Difficulty::default(),\n            dev: Dev::default(),\n            tremor: true,\n            bot_skill,\n            tick: 0,\n            time: 0.0,\n            cov: vec![0; cover::NAMES.len()],\n            music: music_id(\"title\"),\n            text_speed: 1.0,\n            auto_advance: false,\n            seed,\n            demo_seg: 0,\n            demo_t: 0.0,\n            no_local: false,\n            death_time: String::new(),\n            last_rank: None,\n            cases_won: 0,\n            mirror_frame: None,\n        }\n    }\n\n    pub fn rules(&self) -> Rules {\n        Rules {\n            tune: self.tune,\n            diff: self.diff,\n            immortal: self.dev.immortal,\n            freeze_timer: self.dev.freeze_timer,\n            full_gift: self.dev.full_gift,\n            one_hit: self.dev.one_hit,\n            tremor: self.tremor,\n            bot_skill: self.bot_skill,\n            tick: self.tick,\n            time: self.time,\n        }\n    }\n\n    // ---------------------------------------------------------------------------------------\n    // Flow\n\n    /// A campaign's case begins: its story, then the chart.\n    pub fn begin_case(&mut self, k: usize) {\n        self.case = k as u8;\n        self.op = None;\n        self.results = None;\n        let c = content();\n        match c.cases[k].before.clone() {\n            Some(id) => self.begin_story(&id),\n            None => self.begin_chart(k),\n        }\n    }\n\n    pub fn begin_story(&mut self, id: &str) {\n        let c = content();\n        let Some(scene) = c.scenes.iter().position(|s| s.id == id) else {\n            log::error!(\"unknown story scene '{id}'\");\n            return;\n        };\n        self.stage = Stage::Story;\n        self.stage_t = 0.0;\n        self.story = Some(Story {\n            scene: scene as u16,\n            line: 0,\n            set: \"corridor\".into(),\n            ..Default::default()\n        });\n        self.run_stage_commands();\n    }\n\n    fn begin_chart(&mut self, k: usize) {\n        self.case = k as u8;\n        self.story = None;\n        self.stage = Stage::Chart;\n        self.stage_t = 0.0;\n        self.begin_op(k);\n        self.stage = Stage::Chart;\n        let c = content();\n        self.music = music_id(if c.cases[k].music.is_empty() { \"or\" } else { &c.cases[k].music });\n    }\n\n    /// Prepares the operation (its clock does not run in `Chart`).\n    pub fn begin_op(&mut self, k: usize) {\n        self.case = k as u8;\n        let rules = self.rules();\n        self.seed = self.seed.wrapping_mul(0x9E37_79B9).wrapping_add(k as u64 + 1);\n        let mut op = Op::new(k, &rules, self.seed);\n        let c = content();\n        // Case 7: the partner is a surgeon of her own, until someone takes her seat.\n        if c.cases[k].gift == \"duet\" {\n            op.slots[1].active = true;\n            op.slots[1].bot = true;\n            op.slots[1].gift_kind = 2;\n        }\n        if self.mode == Mode::Attract {\n            op.showing = true;\n            for s in op.slots.iter_mut() {\n                s.bot = s.active;\n            }\n            if k == CODE_BLUE {\n                for s in op.slots.iter_mut() {\n                    s.active = true;\n                    s.bot = true;\n                }\n            }\n        }\n        if self.no_local {\n            op.slots[0].active = false;\n        }\n        op.set_banner(\"OPERATION START\");\n        self.music = music_id(if c.cases[k].music.is_empty() { \"or\" } else { &c.cases[k].music });\n        self.op = Some(Box::new(op));\n        self.stage = Stage::Op;\n        self.stage_t = 0.0;\n    }\n\n    fn after_case(&mut self) {\n        let k = self.case as usize;\n        let c = content();\n        if self.mode == Mode::Campaign {\n            self.cases_won = self.cases_won.max(k as u8 + 1);\n            match c.cases[k].after.clone() {\n                Some(id) => {\n                    self.begin_story(&id);\n                    return;\n                }\n                None => self.after_story(),\n            }\n            return;\n        }\n        self.finish();\n    }\n\n    fn after_story(&mut self) {\n        let k = self.case as usize;\n        let c = content();\n        match self.mode {\n            Mode::Campaign => {\n                // A story scene ends either a case's \"before\" (go on to the chart) or its \"after\".\n                let before = self.op.is_none() && self.results.is_none();\n                if before {\n                    self.begin_chart(k);\n                } else if k + 1 < 8 {\n                    self.begin_case(k + 1);\n                } else {\n                    self.finish();\n                }\n                let _ = c;\n            }\n            Mode::Attract => self.next_demo_segment(),\n            _ => self.finish(),\n        }\n    }\n\n    fn finish(&mut self) {\n        self.stage = Stage::Done;\n        self.stage_t = 0.0;\n        self.story = None;\n        self.outcome = Outcome::Won;\n    }\n\n    fn enter_results(&mut self) {\n        let Some(op) = &self.op else { return };\n        let c = content();\n        let case = &c.cases[op.case as usize];\n        let score: i64 = op.slots.iter().map(|s| s.score).sum();\n        let tally: u32 = op.slots.iter().map(|s| s.tally[2] + s.tally[3]).sum();\n        let vitals = (op.vitals * 20.0) as i64;\n        let time = (op.timer.max(0.0) * 5.0) as i64;\n        let mistakes = -(op.mistakes as i64) * 100;\n        let total = (score + vitals + time + mistakes).max(0);\n        let ratio = total as f32 / case.par.max(1.0);\n        let rank = if ratio >= 1.15 {\n            \"ENCORE\"\n        } else if ratio >= 1.0 {\n            \"S\"\n        } else if ratio >= 0.85 {\n            \"A\"\n        } else if ratio >= 0.7 {\n            \"B\"\n        } else if ratio >= 0.5 {\n            \"C\"\n        } else {\n            \"D\"\n        };\n        let lines = vec![\n            (\"Technique\".to_string(), score),\n            (\"Vitals remaining\".to_string(), vitals),\n            (\"Time remaining\".to_string(), time),\n            (format!(\"Clean work: {tally}, mistakes: {}\", op.mistakes), mistakes),\n        ];\n        let results = ResultsView {\n            case: op.case,\n            title: case.name.clone(),\n            patient: case.patient.clone(),\n            fate: case.fate.clone(),\n            lines,\n            total,\n            par: case.par,\n            rank: rank.to_string(),\n            t: 0.0,\n            won: true,\n            scores: op.slots.iter().filter(|s| s.active).map(|s| s.score).collect(),\n        };\n        self.last_rank = Some((op.case, rank.to_string(), total));\n        self.results = Some(results);\n        self.stage = Stage::Results;\n        self.stage_t = 0.0;\n        self.music = music_id(\"results\");\n        cover::merge(&mut self.cov, &op.cov.clone());\n        if let Some(op) = &mut self.op {\n            op.cov = vec![0; cover::NAMES.len()];\n        }\n    }\n\n    /// Retries the operation from the last checkpoint: instant.\n    pub fn retry_checkpoint(&mut self) {\n        let rules = self.rules();\n        if let Some(op) = &mut self.op {\n            if op.retry_checkpoint(&rules) {\n                self.stage = Stage::Op;\n                self.stage_t = 0.0;\n                self.outcome = Outcome::Playing;\n                return;\n            }\n        }\n        self.retry_start();\n    }\n\n    /// Retries the operation from its start.\n    pub fn retry_start(&mut self) {\n        let cov = self.op.as_ref().map(|o| o.cov.clone());\n        let k = self.case as usize;\n        self.begin_op(k);\n        if let (Some(op), Some(cov)) = (&mut self.op, cov) {\n            op.cov = cov;\n        }\n        self.stage = Stage::Op;\n        self.stage_t = 0.0;\n        self.outcome = Outcome::Playing;\n    }\n\n    // ---------------------------------------------------------------------------------------\n    // Dev tools (called from the shell through the host)\n\n    pub fn jump_phase(&mut self, p: usize) {\n        let rules = self.rules();\n        if let Some(op) = &mut self.op {\n            op.hazards.clear();\n            op.strain = None;\n            op.code = None;\n            op.heart.stopped = false;\n            op.fever = None;\n            let c = content();\n            // The plate as of that phase.\n            let case = &c.cases[op.case as usize];\n            let mut plate = case.plate.clone();\n            for ph in case.phase.iter().take(p + 1) {\n                if let Some(r) = &ph.reveal_plate {\n                    plate = r.clone();\n                }\n            }\n            op.plate = field::plate_id(&c, &plate);\n            op.plate_prev = op.plate;\n            op.reveal = 1.0;\n            if case.gift_locked && p > 0 {\n                op.gifts.locked = false;\n            }\n            op.enter_phase(p.min(case.phase.len().saturating_sub(1)), &rules);\n        }\n    }\n\n    pub fn skip_phase(&mut self) {\n        let next = self.op.as_ref().map(|o| o.phase as usize + 1).unwrap_or(0);\n        let last = self.op.as_ref().map(|o| content().cases[o.case as usize].phase.len()).unwrap_or(0);\n        if next >= last {\n            self.win_case();\n        } else {\n            self.jump_phase(next);\n        }\n    }\n\n    pub fn win_case(&mut self) {\n        if let Some(op) = &mut self.op {\n            op.hazards.clear();\n            op.strain = None;\n            op.code = None;\n            op.won = true;\n        }\n    }\n\n    pub fn force_code(&mut self) {\n        let rules = self.rules();\n        if let Some(op) = &mut self.op {\n            op.start_code(0, &rules);\n        }\n    }\n\n    pub fn kill_patient(&mut self) {\n        if let Some(op) = &mut self.op {\n            op.vitals = 0.0;\n            op.codes_left = 0;\n            op.code = None;\n            op.dead = true;\n        }\n    }\n\n    /// Spawns a hazard of a kind at the cursor.\n    pub fn spawn_hazard(&mut self, kind: &str) {\n        let rules = self.rules();\n        let Some(op) = &mut self.op else { return };\n        let at = op.slots[0].cursor;\n        let spec = content::SpawnSpec {\n            kind: kind.to_string(),\n            a: Some([at.x - 1.0, at.y]),\n            b: Some([at.x + 1.0, at.y]),\n            optional: true,\n            ..Default::default()\n        };\n        op.spawn_spec(&spec);\n        let _ = rules;\n    }\n\n    pub fn set_tune(&mut self, key: &str, v: f32) -> bool {\n        self.tune.set(key, v)\n    }\n\n    // ---------------------------------------------------------------------------------------\n    // Story\n\n    /// Runs lines with no text at once (stage commands), and stops on the next spoken line.\n    fn run_stage_commands(&mut self) {\n        let c = content();\n        let Some(st) = &mut self.story else { return };\n        let scene = &c.scenes[st.scene as usize];\n        loop {\n            let Some(line) = scene.line.get(st.line as usize) else {\n                self.story.as_mut().unwrap().text.clear();\n                self.story_over();\n                return;\n            };\n            if let Some(s) = &line.set {\n                st.set = s.clone();\n                st.actors.clear();\n            }\n            if let Some(r) = &line.enter {\n                st.actors.retain(|a| a.rig != *r);\n                st.actors.push(ActorView {\n                    rig: r.clone(),\n                    x: line.x.unwrap_or(0.0),\n                    expr: line.expr.clone().unwrap_or_else(|| \"neutral\".into()),\n                    age: 0.0,\n                    talking: false,\n                    leaving: 0.0,\n                });\n            }\n            if let Some(r) = &line.exit {\n                st.actors.retain(|a| a.rig != *r);\n            }\n            if let Some(m) = &line.music {\n                self.music = music_id(m);\n            }\n            if let Some(f) = line.flash {\n                st.flash = f;\n            }\n            if let Some(f) = line.shake {\n                st.shake = f;\n            }\n            if let Some(cam) = &line.camera {\n                st.camera = if cam == \"or_wide\" { 1 } else { 0 };\n            }\n            if let Some(text) = &line.text {\n                st.who = line.who.clone().unwrap_or_default();\n                st.text = text.clone();\n                st.expr = line.expr.clone().unwrap_or_default();\n                st.typed = 0.0;\n                st.line_age = 0.0;\n                if let (Some(who), Some(x)) = (&line.who, &line.expr) {\n                    if let Some(a) = st.actors.iter_mut().find(|a| a.rig == *who) {\n                        a.expr = x.clone();\n                    }\n                }\n                return;\n            }\n            st.line += 1;\n        }\n    }\n\n    fn story_over(&mut self) {\n        self.story = None;\n        self.after_story();\n    }\n\n    fn story_tick(&mut self, input: &SurgeonInput, dt: f32, events: &mut Vec<SimEvent>) {\n        let (auto, speed) = (self.auto_advance || self.mode == Mode::Attract, self.text_speed);\n        let mut next = false;\n        {\n            let Some(st) = &mut self.story else { return };\n            st.typed += dt * 34.0 * speed;\n            st.line_age += dt;\n            st.flash = (st.flash - dt * 2.0).max(0.0);\n            st.shake = (st.shake - dt * 2.0).max(0.0);\n            for a in &mut st.actors {\n                a.age += dt;\n                a.talking = a.rig == st.who && (st.typed as usize) < st.text.chars().count();\n            }\n            let len = st.text.chars().count() as f32;\n            let done = st.typed >= len;\n            if input.held & btn::ADVANCE != 0 {\n                st.hold += dt;\n            } else {\n                st.hold = 0.0;\n            }\n            // Advance; hold to skip the whole scene.\n            if st.hold > 0.8 {\n                st.line = u16::MAX;\n                next = true;\n            } else if input.pressed & btn::ADVANCE != 0 {\n                if done {\n                    next = true;\n                } else {\n                    st.typed = len;\n                }\n            } else if auto && done && st.line_age > (len / 26.0).max(0.9) + 0.6 {\n                next = true;\n            }\n        }\n        if next {\n            let c = content();\n            let st = self.story.as_mut().unwrap();\n            let scene = &c.scenes[st.scene as usize];\n            if st.line == u16::MAX {\n                // Skip: play what's left silently for its music and exits.\n                st.line = scene.line.len() as u16;\n                st.text.clear();\n                self.story_over();\n                return;\n            }\n            st.line += 1;\n            self.run_stage_commands();\n            events.push(SimEvent::Cue { id: cue::UI_NAV, pos: glam::Vec3::ZERO, gain: 0.3, pitch: 1.0 });\n        }\n    }\n\n    // ---------------------------------------------------------------------------------------\n    // Attract: a loop of about 25 s segments\n\n    fn begin_demo_segment(&mut self) {\n        self.demo_t = 0.0;\n        self.story = None;\n        match self.demo_seg % 6 {\n            0 => {\n                self.begin_op(3);\n                self.jump_phase(demo_strain_phase(3));\n                self.stage = Stage::Op;\n            }\n            1 => {\n                self.begin_op(4);\n                self.jump_phase(demo_strain_phase(4));\n                self.stage = Stage::Op;\n            }\n            2 => {\n                self.begin_op(5);\n                self.stage = Stage::Op;\n            }\n            3 => {\n                self.begin_op(7);\n                self.jump_phase(demo_strain_phase(7));\n                self.stage = Stage::Op;\n            }\n            4 => {\n                self.begin_op(CODE_BLUE);\n                self.stage = Stage::Op;\n            }\n            _ => {\n                self.op = None;\n                self.begin_story(\"case3_before\");\n            }\n        }\n    }\n\n    fn next_demo_segment(&mut self) {\n        self.demo_seg = (self.demo_seg + 1) % 6;\n        self.begin_demo_segment();\n    }\n\n    // ---------------------------------------------------------------------------------------\n    // The frame\n\n    pub fn frame(&self) -> SurgeryFrame {\n        let c = content();\n        let mut f = SurgeryFrame {\n            stage: self.stage,\n            stage_t: self.stage_t,\n            time: self.time,\n            tick: self.tick,\n            case: self.case,\n            music: self.music,\n            demo: self.mode == Mode::Attract,\n            death_time: self.death_time.clone(),\n            results: self.results.clone(),\n            camera: CameraShot::field(),\n            can_retry: true,\n            ..Default::default()\n        };\n        if let Some(case) = c.cases.get(self.case as usize) {\n            f.case_name = case.name.clone();\n            f.patient = case.patient.clone();\n            f.life = case.life.clone();\n            f.diagnosis = case.diagnosis.clone();\n            f.surgeon = case.surgeon.clone();\n        }\n        // The plate behind the title breathes by itself.\n        f.vitals = 100.0;\n        f.bpm = 62.0;\n        f.beat = (self.time * 62.0 / 60.0).fract();\n        f.meter = 4;\n        f.reveal = 1.0;\n        f.time_scale = 1.0;\n        if self.stage == Stage::Title || self.stage == Stage::Card {\n            f.plate = field::plate_id(&c, \"heart\");\n            f.plate_prev = f.plate;\n        }\n        if let Some(op) = &self.op {\n            self.fill_op(&mut f, op, &c);\n        }\n        if let Some(st) = &self.story {\n            f.story = Some(StoryView {\n                scene: st.scene,\n                line: st.line,\n                typed: st.typed,\n                who: st.who.clone(),\n                text: st.text.clone(),\n                expr: st.expr.clone(),\n                actors: st.actors.clone(),\n                set: st.set.clone(),\n                camera: st.camera,\n                flash: st.flash,\n                shake: st.shake,\n                auto: self.auto_advance,\n                skip: (st.hold / 0.8).clamp(0.0, 1.0),\n            });\n            f.camera = if st.camera == 1 { CameraShot::or_wide() } else { CameraShot::paper() };\n        }\n        if self.stage == Stage::Results || self.stage == Stage::Chart {\n            f.camera = CameraShot { distance: 21.5, ..CameraShot::field() };\n        }\n        if let Some(r) = &mut f.results {\n            r.t = self.stage_t;\n        }\n        f\n    }\n\n    fn fill_op(&self, f: &mut SurgeryFrame, op: &Op, c: &content::Content) {\n        let case = &c.cases[op.case as usize];\n        let phase = case.phase.get(op.phase as usize);\n        f.case = op.case;\n        f.phase = op.phase;\n        f.now = phase.map(|p| p.now.clone()).unwrap_or_default();\n        f.guide = phase.is_some_and(|p| p.guide);\n        f.plate = op.plate;\n        f.plate_prev = op.plate_prev;\n        f.reveal = op.reveal;\n        f.reveal_at = op.reveal_at;\n        f.vitals = op.vitals;\n        f.bpm = op.heart.bpm;\n        f.beat = op.heart.phase;\n        f.beats = op.heart.beats;\n        f.meter = op.heart.meter;\n        f.bar = op.heart.bar;\n        f.stopped = op.heart.stopped;\n        f.timer = op.timer;\n        f.timer_max = op.timer_max;\n        f.fever = op.fever;\n        f.heat_ring = op.heat_ring;\n        f.ring_warn = op.ring_warn;\n        f.hush = (op.gifts.hush / 6.0).clamp(0.0, 1.0);\n        f.echo = op.gifts.echo;\n        f.duet = op.gifts.duet;\n        f.gift_locked = op.gifts.locked;\n        f.time_scale = op.time_scale;\n        f.hazards = op.hazards.clone();\n        f.stains = op.stains.clone();\n        f.threads = op.threads.clone();\n        f.floats = op.floats.clone();\n        f.flights = op.flights.clone();\n        f.callout = op.callout.clone();\n        f.banner = op.banner.clone();\n        f.banner_t = op.banner_t;\n        f.code = op.code;\n        f.codes_left = op.codes_left;\n        f.iv_cd = op.iv_cd;\n        f.ghost = op.gifts.ghost;\n        f.ghost_t = op.gifts.ghost_t;\n        f.ripple = op.gifts.ripple;\n        f.shake = op.shake;\n        f.flash = op.flash;\n        f.push = op.push;\n        f.crisis = ((55.0 - op.vitals) / 45.0).clamp(0.0, 1.0);\n        f.ring = std::array::from_fn(|k| op.ring[k] as u8);\n        f.slots = op\n            .slots\n            .iter()\n            .enumerate()\n            .map(|(i, s)| SlotView {\n                active: s.active,\n                bot: s.bot,\n                cursor: s.cursor,\n                tool: op.tool_of(i) as u8,\n                ring_pos: s.tool,\n                using: s.held & btn::USE != 0,\n                pressure: s.pressure,\n                eng: eng_code(s.eng),\n                meter: match s.eng {\n                    Eng::Heat => op.find(s.eng_id).map(|k| op.hazards[k].fill).unwrap_or(0.0),\n                    Eng::Iv => s.eng_a,\n                    _ => 0.0,\n                },\n                score: s.score,\n                chain: s.chain,\n                gift: if op.slots[0].gift_kind == 3 { op.slots[0].gift } else { s.gift },\n                gift_kind: s.gift_kind,\n                arming: s.arming,\n                recoil: s.recoil,\n                clink: s.clink,\n                hover: s.hover,\n                flow: s.flow,\n                charge: s.charge,\n            })\n            .collect();\n        // The camera leans in for a moment of drama.\n        let mut shot = CameraShot::field();\n        let push = op.push * op.push * (3.0 - 2.0 * op.push);\n        shot.distance -= 2.2 * push;\n        let aim = op.reveal_at * 0.2 * push;\n        shot.target[0] += aim.x;\n        shot.target[2] += aim.y;\n        f.camera = shot;\n    }\n}\n\nfn eng_code(e: Eng) -> u8 {\n    match e {\n        Eng::None => 0,\n        Eng::Cut => 1,\n        Eng::Pull => 2,\n        Eng::Stitch => 3,\n        Eng::Suck => 4,\n        Eng::Heat => 5,\n        Eng::Paint => 6,\n        Eng::Scan => 7,\n        Eng::Iv => 8,\n        Eng::Dress => 9,\n        Eng::Bone => 10,\n    }\n}\n\n/// The phase attract jumps to in a case: its first strain.\nfn demo_strain_phase(case: usize) -> usize {\n    let c = content();\n    if case == 7 {\n        return c.cases[7].phase.iter().position(|p| p.strain.as_deref() == Some(\"soloist\")).unwrap_or(0);\n    }\n    c.cases[case].phase.iter().position(|p| p.strain.is_some()).unwrap_or(0)\n}\n\nimpl Game for Surgery {\n    const KEY: &'static str = \"surgery\";\n\n    fn pre(\n        &mut self,\n        _sim: &mut Sim,\n        input: &InputFrame,\n        dt: f32,\n        events: &mut Vec<SimEvent>,\n    ) -> BTreeMap<EntityId, InputFrame> {\n        self.tick += 1;\n        self.time += dt;\n        self.stage_t += dt;\n        let first = input.surgeons[0];\n        match self.stage {\n            Stage::Story => self.story_tick(&first, dt, events),\n            Stage::Chart => {\n                if first.pressed & btn::ADVANCE != 0 || self.stage_t > 7.0 {\n                    self.stage = Stage::Op;\n                    self.stage_t = 0.0;\n                    if let Some(op) = &mut self.op {\n                        op.set_banner(\"OPERATION START\");\n                    }\n                }\n            }\n            Stage::Op => self.op_tick(input, dt, events),\n            Stage::Complete => {\n                if self.stage_t > 1.6 {\n                    self.enter_results();\n                }\n            }\n            Stage::Results => {\n                if self.stage_t > 1.0 && first.pressed & btn::ADVANCE != 0 {\n                    if self.stage_t < 2.8 {\n                        self.stage_t = 2.8; // show it all first\n                    } else {\n                        self.after_case();\n                    }\n                }\n                if self.stage_t > 2.2 && self.stage_t - dt <= 2.2 {\n                    events.push(SimEvent::Cue { id: cue::STAMP, pos: glam::Vec3::ZERO, gain: 1.0, pitch: 1.0 });\n                }\n            }\n            Stage::Dead => {\n                if first.pressed & btn::ADVANCE != 0 {\n                    self.retry_checkpoint();\n                } else if first.pressed & btn::CANCEL != 0 {\n                    self.retry_start();\n                }\n            }\n            Stage::Title | Stage::Done | Stage::Card => {}\n        }\n        if self.mode == Mode::Attract {\n            self.demo_t += dt;\n            if self.demo_t > 25.0 || self.stage == Stage::Results || self.stage == Stage::Complete || self.stage == Stage::Done {\n                self.next_demo_segment();\n            }\n        }\n        BTreeMap::new()\n    }\n\n    fn hud(&self, _sim: &Sim) -> Vec<String> {\n        Vec::new() // the shell and HUD draw everything\n    }\n\n    fn status(&self, _sim: &Sim) -> serde_json::Value {\n        let op = self.op.as_ref();\n        json!({\n            \"outcome\": self.outcome,\n            \"mode\": format!(\"{:?}\", self.mode),\n            \"stage\": format!(\"{:?}\", self.stage),\n            \"case\": self.case,\n            \"phase\": op.map(|o| o.phase),\n            \"vitals\": op.map(|o| o.vitals),\n            \"timer\": op.map(|o| o.timer),\n            \"bpm\": op.map(|o| o.heart.bpm),\n            \"hazards\": op.map(|o| o.hazards.iter().map(|h| format!(\"{}:{}\", h.kind.key(), h.stage)).collect::<Vec<_>>()),\n            \"cursor\": op.map(|o| [o.slots[0].cursor.x, o.slots[0].cursor.y]),\n            \"tool\": op.map(|o| o.tool_of(0).key()),\n            \"gift\": op.map(|o| o.slots[0].gift),\n            \"scores\": op.map(|o| o.slots.iter().map(|s| s.score).collect::<Vec<_>>()),\n            \"actives\": op.map(|o| o.slots.iter().map(|s| s.active).collect::<Vec<_>>()),\n            \"rank\": self.results.as_ref().map(|r| r.rank.clone()),\n            \"total\": self.results.as_ref().map(|r| r.total),\n            \"story\": self.story.as_ref().map(|s| json!({\"line\": s.line, \"who\": s.who, \"set\": s.set})),\n            \"demo_seg\": self.demo_seg,\n            \"music\": self.music,\n            \"tick\": self.tick,\n        })\n    }\n\n    fn outcome(&self) -> Outcome {\n        self.outcome\n    }\n\n    fn bot(&self, _sim: &Sim) -> InputFrame {\n        let mut f = InputFrame::default();\n        match self.stage {\n            Stage::Op => {\n                if let Some(op) = &self.op {\n                    let rules = self.rules();\n                    if !self.no_local && op.slots[0].active && !op.slots[0].bot {\n                        f.surgeons[0] = op.bot_input(0, &rules);\n                    }\n                }\n            }\n            Stage::Dead | Stage::Done | Stage::Title | Stage::Card => {}\n            // Story, chart and results: press on, every few ticks.\n            _ => {\n                f.surgeons[0].active = true;\n                if self.tick.is_multiple_of(3) {\n                    f.surgeons[0].pressed = btn::ADVANCE;\n                    f.surgeons[0].held = btn::ADVANCE;\n                }\n            }\n        }\n        f\n    }\n}\n\nimpl Surgery {\n    fn op_tick(&mut self, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) {\n        let rules = self.rules();\n        let Some(op) = &mut self.op else { return };\n        let mut inputs = input.surgeons;\n        // A human on a seat takes it from the bot.\n        for i in 0..4 {\n            if inputs[i].active && op.slots[i].bot && self.mode != Mode::Attract {\n                op.slots[i].bot = false;\n            }\n            if op.slots[i].bot || (self.dev.bot_plays && i == 0) {\n                inputs[i] = op.bot_input(i, &rules);\n            }\n        }\n        op.tick(&inputs, &rules, dt);\n        events.append(&mut op.ev);\n        let (won, dead) = (op.won, op.dead);\n        if won {\n            op.set_banner(\"OPERATION COMPLETE\");\n            events.append(&mut op.ev);\n            self.stage = Stage::Complete;\n            self.stage_t = 0.0;\n            events.push(SimEvent::Cue { id: cue::RATE_IMMACULATE, pos: glam::Vec3::ZERO, gain: 1.0, pitch: 0.8 });\n            return;\n        }\n        if dead {\n            let elapsed = op.elapsed as i32;\n            self.death_time = format!(\"Time of death: 03:{:02}.\", (42 + elapsed) % 60);\n            cover::merge(&mut self.cov, &op.cov.clone());\n            op.cov = vec![0; cover::NAMES.len()];\n            op.dead = false;\n            self.stage = Stage::Dead;\n            self.stage_t = 0.0;\n            self.outcome = Outcome::Lost;\n            events.push(SimEvent::Cue { id: cue::FLATLINE, pos: glam::Vec3::ZERO, gain: 1.0, pitch: 1.0 });\n        }\n    }\n}\n\n/// The hazard kinds the dev panel can spawn at the cursor.\npub const SPAWNABLE: &[&str] = &[\"lacer\", \"pool\", \"bleeder\", \"object\", \"polyp\", \"tumor\", \"patch\", \"burn\", \"incision\"];\n\n/// Names of every instrument, in tool order (for tools and tests).\npub fn tool_names() -> Vec<&'static str> {\n    Tool::ALL.iter().map(|t| t.key()).collect()\n}\n\n/// A hazard kind by key, for tests.\npub fn kind_of(key: &str) -> Option<Kind> {\n    Kind::ALL.into_iter().find(|k| k.key() == key)\n}\n\n/// Field position helper for hosts.\npub fn clamp_field(p: Vec2) -> Vec2 {\n    p.clamp(Vec2::new(-10.6, -5.6), Vec2::new(10.6, 5.9))\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14457,"cache_read_input_tokens":309494,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14457},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"05b69802-fea6-4e42-b03a-4c7fe9c0d7e3","timestamp":"2026-11-05T14:41:39.214Z","request_id":"req_011CgjxJAKUSukQo2sSdrwXU","wire_tool_inputs":{"toolu_01ESPdhdiBwQkSGj85c1tkfQ":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery/mod.rs","content":"//! The surgical-action melodrama: cases and story as one deterministic phase machine.\n//!\n//! Scenes: `surgery/title`, `surgery/campaign` (or `surgery/campaign/<from>`), `surgery/case/<n>`\n//! (or `surgery/case/<n>/<phase>`), `surgery/codeblue`, `surgery/attract`, `surgery/card`,\n//! `surgery/mirror`. The bot presses through story and plays operations, so `surgery/campaign`\n//! is the scripted playthrough of the whole game. `content/README.md` is the designer guide.\n\npub mod bot;\npub mod content;\npub mod cover;\npub mod cue;\npub mod field;\npub mod frame;\npub mod net;\npub mod strain;\npub mod tune;\n\nuse std::collections::BTreeMap;\nuse std::sync::Arc;\n\nuse anyhow::{Result, anyhow, bail};\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\nuse serde_json::json;\n\nuse self::content::{CODE_BLUE, content, music_id};\nuse self::field::{Eng, Kind, Op, Rules, Tool};\nuse self::frame::{ActorView, CameraShot, ResultsView, SlotView, Stage, StoryView, SurgeryFrame};\nuse self::tune::{Difficulty, Tune};\nuse super::{Game, GameBox, Outcome};\nuse crate::entity::EntityId;\nuse crate::frame::SimEvent;\nuse crate::input::{InputFrame, SurgeonInput, surgeon_buttons as btn};\nuse crate::room::RoomDef;\nuse crate::sim::Sim;\n\n/// The OR wide-shot set, a room file far from the field.\nconst LEVEL: &str = include_str!(\"surgery.toml\");\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum Mode {\n    #[default]\n    Title,\n    Campaign,\n    /// One case by itself.\n    Case,\n    CodeBlue,\n    Attract,\n    Card,\n    Mirror,\n}\n\n/// Dev switches (the panel's Tools page).\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct Dev {\n    pub immortal: bool,\n    pub freeze_timer: bool,\n    pub full_gift: bool,\n    pub one_hit: bool,\n    /// The bot plays the human's seat too.\n    pub bot_plays: bool,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Story {\n    pub scene: u16,\n    pub line: u16,\n    pub typed: f32,\n    pub hold: f32,\n    pub actors: Vec<ActorView>,\n    pub set: String,\n    pub camera: u8,\n    pub flash: f32,\n    pub shake: f32,\n    pub who: String,\n    pub text: String,\n    pub expr: String,\n    /// Waiting on a line (false while running stage commands).\n    pub line_age: f32,\n}\n\n#[derive(Clone, Serialize, Deserialize)]\npub struct Surgery {\n    pub mode: Mode,\n    pub stage: Stage,\n    pub stage_t: f32,\n    pub case: u8,\n    pub story: Option<Story>,\n    pub op: Option<Box<Op>>,\n    pub results: Option<ResultsView>,\n    pub outcome: Outcome,\n    pub tune: Tune,\n    pub diff: Difficulty,\n    pub dev: Dev,\n    pub tremor: bool,\n    pub bot_skill: f32,\n    pub tick: u64,\n    pub time: f32,\n    pub cov: Vec<u32>,\n    pub music: u8,\n    pub text_speed: f32,\n    pub auto_advance: bool,\n    pub seed: u64,\n    /// Seconds of attract spent on this segment, and which.\n    pub demo_seg: u8,\n    pub demo_t: f32,\n    /// Slot 0 isn't played from this copy (a hub server, a client).\n    pub no_local: bool,\n    pub death_time: String,\n    /// The last result, for the shell to save.\n    pub last_rank: Option<(u8, String, i64)>,\n    pub cases_won: u8,\n    #[serde(skip)]\n    pub mirror_frame: Option<Arc<SurgeryFrame>>,\n}\n\n/// The scene's game state, for tools.\npub fn get(sim: &Sim) -> Option<&Surgery> {\n    sim.play()?.get::<Surgery>()\n}\n\npub fn get_mut(sim: &mut Sim) -> Option<&mut Surgery> {\n    sim.state.play.as_mut()?.get_mut::<Surgery>()\n}\n\n/// What `RenderFrame::surgery` holds.\npub fn frame_of(sim: &Sim) -> Option<Arc<SurgeryFrame>> {\n    let g = get(sim)?;\n    if let Some(m) = &g.mirror_frame {\n        return Some(m.clone());\n    }\n    Some(Arc::new(g.frame()))\n}\n\n/// Builds the scene: `surgery/<what>`.\npub fn build(sim: &mut Sim, rest: Option<&str>) -> Result<()> {\n    let def = RoomDef::parse(&super::level_text(\"surgery/surgery\", LEVEL)).map_err(|e| anyhow!(\"surgery.toml: {e}\"))?;\n    crate::scenes::build_standalone_room(sim, \"surgery\", def);\n    if let Some(p) = sim.state.player {\n        sim.despawn(p);\n    }\n    sim.state.focus = glam::Vec3::new(0.0, 0.0, 0.2);\n    let seed = sim.state.rng.next_u32() as u64;\n    let mut g = Surgery::new(seed);\n    let parts: Vec<&str> = rest.unwrap_or(\"title\").split('/').collect();\n    match parts[0] {\n        \"title\" => g.mode = Mode::Title,\n        \"card\" => g.mode = Mode::Card,\n        \"mirror\" => g.mode = Mode::Mirror,\n        \"campaign\" => {\n            g.mode = Mode::Campaign;\n            let from: usize = parts.get(1).and_then(|p| p.parse().ok()).unwrap_or(0);\n            g.begin_case(from.min(7));\n        }\n        \"case\" => {\n            g.mode = Mode::Case;\n            let n: usize = parts.get(1).ok_or_else(|| anyhow!(\"surgery/case/<n>: which case?\"))?.parse()?;\n            if n >= CODE_BLUE {\n                bail!(\"surgery/case/{n}: cases are 0 to 7\");\n            }\n            let phase: Option<usize> = parts.get(2).and_then(|p| p.parse().ok());\n            g.begin_op(n);\n            if let Some(p) = phase {\n                g.jump_phase(p);\n            }\n            g.stage = Stage::Op;\n        }\n        \"codeblue\" => {\n            g.mode = Mode::CodeBlue;\n            g.begin_op(CODE_BLUE);\n            g.stage = Stage::Op;\n        }\n        \"attract\" => {\n            g.mode = Mode::Attract;\n            g.dev.immortal = true;\n            g.dev.full_gift = true;\n            g.demo_seg = 0;\n            g.begin_demo_segment();\n        }\n        other => bail!(\"unknown surgery scene '{other}' (title, campaign, case/<n>, codeblue, attract, card, mirror)\"),\n    }\n    sim.state.play = Some(GameBox::new(g));\n    Ok(())\n}\n\nimpl Surgery {\n    pub fn new(seed: u64) -> Self {\n        let bot_skill = 1.0;\n        Surgery {\n            mode: Mode::Title,\n            stage: Stage::Title,\n            stage_t: 0.0,\n            case: 0,\n            story: None,\n            op: None,\n            results: None,\n            outcome: Outcome::Playing,\n            tune: Tune::default(),\n            diff: Difficulty::default(),\n            dev: Dev::default(),\n            tremor: true,\n            bot_skill,\n            tick: 0,\n            time: 0.0,\n            cov: vec![0; cover::NAMES.len()],\n            music: music_id(\"title\"),\n            text_speed: 1.0,\n            auto_advance: false,\n            seed,\n            demo_seg: 0,\n            demo_t: 0.0,\n            no_local: false,\n            death_time: String::new(),\n            last_rank: None,\n            cases_won: 0,\n            mirror_frame: None,\n        }\n    }\n\n    pub fn rules(&self) -> Rules {\n        Rules {\n            tune: self.tune,\n            diff: self.diff,\n            immortal: self.dev.immortal,\n            freeze_timer: self.dev.freeze_timer,\n            full_gift: self.dev.full_gift,\n            one_hit: self.dev.one_hit,\n            tremor: self.tremor,\n            bot_skill: self.bot_skill,\n            tick: self.tick,\n            time: self.time,\n        }\n    }\n\n    // ---------------------------------------------------------------------------------------\n    // Flow\n\n    /// A campaign's case begins: its story, then the chart.\n    pub fn begin_case(&mut self, k: usize) {\n        self.case = k as u8;\n        self.op = None;\n        self.results = None;\n        let c = content();\n        match c.cases[k].before.clone() {\n            Some(id) => self.begin_story(&id),\n            None => self.begin_chart(k),\n        }\n    }\n\n    pub fn begin_story(&mut self, id: &str) {\n        let c = content();\n        let Some(scene) = c.scenes.iter().position(|s| s.id == id) else {\n            log::error!(\"unknown story scene '{id}'\");\n            return;\n        };\n        self.stage = Stage::Story;\n        self.stage_t = 0.0;\n        self.story = Some(Story {\n            scene: scene as u16,\n            line: 0,\n            set: \"corridor\".into(),\n            ..Default::default()\n        });\n        self.run_stage_commands();\n    }\n\n    fn begin_chart(&mut self, k: usize) {\n        self.case = k as u8;\n        self.story = None;\n        self.stage = Stage::Chart;\n        self.stage_t = 0.0;\n        self.begin_op(k);\n        self.stage = Stage::Chart;\n        let c = content();\n        self.music = music_id(if c.cases[k].music.is_empty() { \"or\" } else { &c.cases[k].music });\n    }\n\n    /// Prepares the operation (its clock does not run in `Chart`).\n    pub fn begin_op(&mut self, k: usize) {\n        self.case = k as u8;\n        let rules = self.rules();\n        self.seed = self.seed.wrapping_mul(0x9E37_79B9).wrapping_add(k as u64 + 1);\n        let mut op = Op::new(k, &rules, self.seed);\n        let c = content();\n        // Case 7: the partner is a surgeon of her own, until someone takes her seat.\n        if c.cases[k].gift == \"duet\" {\n            op.slots[1].active = true;\n            op.slots[1].bot = true;\n            op.slots[1].gift_kind = 2;\n        }\n        if self.mode == Mode::Attract {\n            op.showing = true;\n            for s in op.slots.iter_mut() {\n                s.bot = s.active;\n            }\n            if k == CODE_BLUE {\n                for s in op.slots.iter_mut() {\n                    s.active = true;\n                    s.bot = true;\n                }\n            }\n        }\n        if self.no_local {\n            op.slots[0].active = false;\n        }\n        op.set_banner(\"OPERATION START\");\n        self.music = music_id(if c.cases[k].music.is_empty() { \"or\" } else { &c.cases[k].music });\n        self.op = Some(Box::new(op));\n        self.stage = Stage::Op;\n        self.stage_t = 0.0;\n    }\n\n    fn after_case(&mut self) {\n        let k = self.case as usize;\n        let c = content();\n        if self.mode == Mode::Campaign {\n            self.cases_won = self.cases_won.max(k as u8 + 1);\n            match c.cases[k].after.clone() {\n                Some(id) => {\n                    self.begin_story(&id);\n                    return;\n                }\n                None => self.after_story(),\n            }\n            return;\n        }\n        self.finish();\n    }\n\n    fn after_story(&mut self) {\n        let k = self.case as usize;\n        let c = content();\n        match self.mode {\n            Mode::Campaign => {\n                // A story scene ends either a case's \"before\" (go on to the chart) or its \"after\".\n                let before = self.op.is_none() && self.results.is_none();\n                if before {\n                    self.begin_chart(k);\n                } else if k + 1 < 8 {\n                    self.begin_case(k + 1);\n                } else {\n                    self.finish();\n                }\n                let _ = c;\n            }\n            Mode::Attract => self.next_demo_segment(),\n            _ => self.finish(),\n        }\n    }\n\n    fn finish(&mut self) {\n        self.stage = Stage::Done;\n        self.stage_t = 0.0;\n        self.story = None;\n        self.outcome = Outcome::Won;\n    }\n\n    fn enter_results(&mut self) {\n        let Some(op) = &self.op else { return };\n        let c = content();\n        let case = &c.cases[op.case as usize];\n        let score: i64 = op.slots.iter().map(|s| s.score).sum();\n        let tally: u32 = op.slots.iter().map(|s| s.tally[2] + s.tally[3]).sum();\n        let vitals = (op.vitals * 20.0) as i64;\n        let time = (op.timer.max(0.0) * 5.0) as i64;\n        let mistakes = -(op.mistakes as i64) * 100;\n        let total = (score + vitals + time + mistakes).max(0);\n        let ratio = total as f32 / case.par.max(1.0);\n        let rank = if ratio >= 1.15 {\n            \"ENCORE\"\n        } else if ratio >= 1.0 {\n            \"S\"\n        } else if ratio >= 0.85 {\n            \"A\"\n        } else if ratio >= 0.7 {\n            \"B\"\n        } else if ratio >= 0.5 {\n            \"C\"\n        } else {\n            \"D\"\n        };\n        let lines = vec![\n            (\"Technique\".to_string(), score),\n            (\"Vitals remaining\".to_string(), vitals),\n            (\"Time remaining\".to_string(), time),\n            (format!(\"Clean work: {tally}, mistakes: {}\", op.mistakes), mistakes),\n        ];\n        let results = ResultsView {\n            case: op.case,\n            title: case.name.clone(),\n            patient: case.patient.clone(),\n            fate: case.fate.clone(),\n            lines,\n            total,\n            par: case.par,\n            rank: rank.to_string(),\n            t: 0.0,\n            won: true,\n            scores: op.slots.iter().filter(|s| s.active).map(|s| s.score).collect(),\n        };\n        self.last_rank = Some((op.case, rank.to_string(), total));\n        self.results = Some(results);\n        self.stage = Stage::Results;\n        self.stage_t = 0.0;\n        self.music = music_id(\"results\");\n        cover::merge(&mut self.cov, &op.cov.clone());\n        if let Some(op) = &mut self.op {\n            op.cov = vec![0; cover::NAMES.len()];\n        }\n    }\n\n    /// Retries the operation from the last checkpoint: instant.\n    pub fn retry_checkpoint(&mut self) {\n        let rules = self.rules();\n        if let Some(op) = &mut self.op {\n            if op.retry_checkpoint(&rules) {\n                self.stage = Stage::Op;\n                self.stage_t = 0.0;\n                self.outcome = Outcome::Playing;\n                return;\n            }\n        }\n        self.retry_start();\n    }\n\n    /// Retries the operation from its start.\n    pub fn retry_start(&mut self) {\n        let cov = self.op.as_ref().map(|o| o.cov.clone());\n        let k = self.case as usize;\n        self.begin_op(k);\n        if let (Some(op), Some(cov)) = (&mut self.op, cov) {\n            op.cov = cov;\n        }\n        self.stage = Stage::Op;\n        self.stage_t = 0.0;\n        self.outcome = Outcome::Playing;\n    }\n\n    // ---------------------------------------------------------------------------------------\n    // Dev tools (called from the shell through the host)\n\n    pub fn jump_phase(&mut self, p: usize) {\n        let rules = self.rules();\n        if let Some(op) = &mut self.op {\n            op.hazards.clear();\n            op.strain = None;\n            op.code = None;\n            op.heart.stopped = false;\n            op.fever = None;\n            let c = content();\n            // The plate as of that phase.\n            let case = &c.cases[op.case as usize];\n            let mut plate = case.plate.clone();\n            for ph in case.phase.iter().take(p + 1) {\n                if let Some(r) = &ph.reveal_plate {\n                    plate = r.clone();\n                }\n            }\n            op.plate = field::plate_id(&c, &plate);\n            op.plate_prev = op.plate;\n            op.reveal = 1.0;\n            if case.gift_locked && p > 0 {\n                op.gifts.locked = false;\n            }\n            op.enter_phase(p.min(case.phase.len().saturating_sub(1)), &rules);\n        }\n    }\n\n    pub fn skip_phase(&mut self) {\n        let next = self.op.as_ref().map(|o| o.phase as usize + 1).unwrap_or(0);\n        let last = self.op.as_ref().map(|o| content().cases[o.case as usize].phase.len()).unwrap_or(0);\n        if next >= last {\n            self.win_case();\n        } else {\n            self.jump_phase(next);\n        }\n    }\n\n    pub fn win_case(&mut self) {\n        if let Some(op) = &mut self.op {\n            op.hazards.clear();\n            op.strain = None;\n            op.code = None;\n            op.won = true;\n        }\n    }\n\n    pub fn force_code(&mut self) {\n        let rules = self.rules();\n        if let Some(op) = &mut self.op {\n            op.start_code(0, &rules);\n        }\n    }\n\n    pub fn kill_patient(&mut self) {\n        if let Some(op) = &mut self.op {\n            op.vitals = 0.0;\n            op.codes_left = 0;\n            op.code = None;\n            op.dead = true;\n        }\n    }\n\n    /// Spawns a hazard of a kind at the cursor.\n    pub fn spawn_hazard(&mut self, kind: &str) {\n        let rules = self.rules();\n        let Some(op) = &mut self.op else { return };\n        let at = op.slots[0].cursor;\n        let spec = content::SpawnSpec {\n            kind: kind.to_string(),\n            a: Some([at.x - 1.0, at.y]),\n            b: Some([at.x + 1.0, at.y]),\n            optional: true,\n            ..Default::default()\n        };\n        op.spawn_spec(&spec);\n        let _ = rules;\n    }\n\n    pub fn set_tune(&mut self, key: &str, v: f32) -> bool {\n        self.tune.set(key, v)\n    }\n\n    // ---------------------------------------------------------------------------------------\n    // Story\n\n    /// Runs lines with no text at once (stage commands), and stops on the next spoken line.\n    fn run_stage_commands(&mut self) {\n        let c = content();\n        let Some(st) = &mut self.story else { return };\n        let scene = &c.scenes[st.scene as usize];\n        loop {\n            let Some(line) = scene.line.get(st.line as usize) else {\n                self.story.as_mut().unwrap().text.clear();\n                self.story_over();\n                return;\n            };\n            if let Some(s) = &line.set {\n                st.set = s.clone();\n                st.actors.clear();\n            }\n            if let Some(r) = &line.enter {\n                st.actors.retain(|a| a.rig != *r);\n                st.actors.push(ActorView {\n                    rig: r.clone(),\n                    x: line.x.unwrap_or(0.0),\n                    expr: line.expr.clone().unwrap_or_else(|| \"neutral\".into()),\n                    age: 0.0,\n                    talking: false,\n                    leaving: 0.0,\n                });\n            }\n            if let Some(r) = &line.exit {\n                st.actors.retain(|a| a.rig != *r);\n            }\n            if let Some(m) = &line.music {\n                self.music = music_id(m);\n            }\n            if let Some(f) = line.flash {\n                st.flash = f;\n            }\n            if let Some(f) = line.shake {\n                st.shake = f;\n            }\n            if let Some(cam) = &line.camera {\n                st.camera = if cam == \"or_wide\" { 1 } else { 0 };\n            }\n            if let Some(text) = &line.text {\n                st.who = line.who.clone().unwrap_or_default();\n                st.text = text.clone();\n                st.expr = line.expr.clone().unwrap_or_default();\n                st.typed = 0.0;\n                st.line_age = 0.0;\n                if let (Some(who), Some(x)) = (&line.who, &line.expr) {\n                    if let Some(a) = st.actors.iter_mut().find(|a| a.rig == *who) {\n                        a.expr = x.clone();\n                    }\n                }\n                return;\n            }\n            st.line += 1;\n        }\n    }\n\n    fn story_over(&mut self) {\n        self.story = None;\n        self.after_story();\n    }\n\n    fn story_tick(&mut self, input: &SurgeonInput, dt: f32, events: &mut Vec<SimEvent>) {\n        let (auto, speed) = (self.auto_advance || self.mode == Mode::Attract, self.text_speed);\n        let mut next = false;\n        {\n            let Some(st) = &mut self.story else { return };\n            st.typed += dt * 34.0 * speed;\n            st.line_age += dt;\n            st.flash = (st.flash - dt * 2.0).max(0.0);\n            st.shake = (st.shake - dt * 2.0).max(0.0);\n            for a in &mut st.actors {\n                a.age += dt;\n                a.talking = a.rig == st.who && (st.typed as usize) < st.text.chars().count();\n            }\n            let len = st.text.chars().count() as f32;\n            let done = st.typed >= len;\n            if input.held & btn::ADVANCE != 0 {\n                st.hold += dt;\n            } else {\n                st.hold = 0.0;\n            }\n            // Advance; hold to skip the whole scene.\n            if st.hold > 0.8 {\n                st.line = u16::MAX;\n                next = true;\n            } else if input.pressed & btn::ADVANCE != 0 {\n                if done {\n                    next = true;\n                } else {\n                    st.typed = len;\n                }\n            } else if auto && done && st.line_age > (len / 26.0).max(0.9) + 0.6 {\n                next = true;\n            }\n        }\n        if next {\n            let c = content();\n            let st = self.story.as_mut().unwrap();\n            let scene = &c.scenes[st.scene as usize];\n            if st.line == u16::MAX {\n                // Skip: play what's left silently for its music and exits.\n                st.line = scene.line.len() as u16;\n                st.text.clear();\n                self.story_over();\n                return;\n            }\n            st.line += 1;\n            self.run_stage_commands();\n            events.push(SimEvent::Cue { id: cue::UI_NAV, pos: glam::Vec3::ZERO, gain: 0.3, pitch: 1.0 });\n        }\n    }\n\n    // ---------------------------------------------------------------------------------------\n    // Attract: a loop of about 25 s segments\n\n    fn begin_demo_segment(&mut self) {\n        self.demo_t = 0.0;\n        self.story = None;\n        match self.demo_seg % 6 {\n            0 => {\n                self.begin_op(3);\n                self.jump_phase(demo_strain_phase(3));\n                self.stage = Stage::Op;\n            }\n            1 => {\n                self.begin_op(4);\n                self.jump_phase(demo_strain_phase(4));\n                self.stage = Stage::Op;\n            }\n            2 => {\n                self.begin_op(5);\n                self.stage = Stage::Op;\n            }\n            3 => {\n                self.begin_op(7);\n                self.jump_phase(demo_strain_phase(7));\n                self.stage = Stage::Op;\n            }\n            4 => {\n                self.begin_op(CODE_BLUE);\n                self.stage = Stage::Op;\n            }\n            _ => {\n                self.op = None;\n                self.begin_story(\"case3_before\");\n            }\n        }\n    }\n\n    fn next_demo_segment(&mut self) {\n        self.demo_seg = (self.demo_seg + 1) % 6;\n        self.begin_demo_segment();\n    }\n\n    // ---------------------------------------------------------------------------------------\n    // The frame\n\n    pub fn frame(&self) -> SurgeryFrame {\n        let c = content();\n        let mut f = SurgeryFrame {\n            stage: self.stage,\n            stage_t: self.stage_t,\n            time: self.time,\n            tick: self.tick,\n            case: self.case,\n            music: self.music,\n            demo: self.mode == Mode::Attract,\n            death_time: self.death_time.clone(),\n            results: self.results.clone(),\n            camera: CameraShot::field(),\n            can_retry: true,\n            ..Default::default()\n        };\n        if let Some(case) = c.cases.get(self.case as usize) {\n            f.case_name = case.name.clone();\n            f.patient = case.patient.clone();\n            f.life = case.life.clone();\n            f.diagnosis = case.diagnosis.clone();\n            f.surgeon = case.surgeon.clone();\n        }\n        // The plate behind the title breathes by itself.\n        f.vitals = 100.0;\n        f.bpm = 62.0;\n        f.beat = (self.time * 62.0 / 60.0).fract();\n        f.meter = 4;\n        f.reveal = 1.0;\n        f.time_scale = 1.0;\n        if self.stage == Stage::Title || self.stage == Stage::Card {\n            f.plate = field::plate_id(&c, \"heart\");\n            f.plate_prev = f.plate;\n        }\n        if let Some(op) = &self.op {\n            self.fill_op(&mut f, op, &c);\n        }\n        if let Some(st) = &self.story {\n            f.story = Some(StoryView {\n                scene: st.scene,\n                line: st.line,\n                typed: st.typed,\n                who: st.who.clone(),\n                text: st.text.clone(),\n                expr: st.expr.clone(),\n                actors: st.actors.clone(),\n                set: st.set.clone(),\n                camera: st.camera,\n                flash: st.flash,\n                shake: st.shake,\n                auto: self.auto_advance,\n                skip: (st.hold / 0.8).clamp(0.0, 1.0),\n            });\n            f.camera = if st.camera == 1 { CameraShot::or_wide() } else { CameraShot::paper() };\n        }\n        if self.stage == Stage::Results || self.stage == Stage::Chart {\n            f.camera = CameraShot { distance: 21.5, ..CameraShot::field() };\n        }\n        if let Some(r) = &mut f.results {\n            r.t = self.stage_t;\n        }\n        f\n    }\n\n    fn fill_op(&self, f: &mut SurgeryFrame, op: &Op, c: &content::Content) {\n        let case = &c.cases[op.case as usize];\n        let phase = case.phase.get(op.phase as usize);\n        f.case = op.case;\n        f.phase = op.phase;\n        f.now = phase.map(|p| p.now.clone()).unwrap_or_default();\n        f.guide = phase.is_some_and(|p| p.guide);\n        f.plate = op.plate;\n        f.plate_prev = op.plate_prev;\n        f.reveal = op.reveal;\n        f.reveal_at = op.reveal_at;\n        f.vitals = op.vitals;\n        f.bpm = op.heart.bpm;\n        f.beat = op.heart.phase;\n        f.beats = op.heart.beats;\n        f.meter = op.heart.meter;\n        f.bar = op.heart.bar;\n        f.stopped = op.heart.stopped;\n        f.timer = op.timer;\n        f.timer_max = op.timer_max;\n        f.fever = op.fever;\n        f.heat_ring = op.heat_ring;\n        f.ring_warn = op.ring_warn;\n        f.hush = (op.gifts.hush / 6.0).clamp(0.0, 1.0);\n        f.echo = op.gifts.echo;\n        f.duet = op.gifts.duet;\n        f.gift_locked = op.gifts.locked;\n        f.time_scale = op.time_scale;\n        f.hazards = op.hazards.clone();\n        f.stains = op.stains.clone();\n        f.threads = op.threads.clone();\n        f.floats = op.floats.clone();\n        f.flights = op.flights.clone();\n        f.callout = op.callout.clone();\n        f.banner = op.banner.clone();\n        f.banner_t = op.banner_t;\n        f.code = op.code;\n        f.codes_left = op.codes_left;\n        f.iv_cd = op.iv_cd;\n        f.ghost = op.gifts.ghost;\n        f.ghost_t = op.gifts.ghost_t;\n        f.ripple = op.gifts.ripple;\n        f.shake = op.shake;\n        f.flash = op.flash;\n        f.push = op.push;\n        f.crisis = ((55.0 - op.vitals) / 45.0).clamp(0.0, 1.0);\n        f.ring = std::array::from_fn(|k| op.ring[k] as u8);\n        f.slots = op\n            .slots\n            .iter()\n            .enumerate()\n            .map(|(i, s)| SlotView {\n                active: s.active,\n                bot: s.bot,\n                cursor: s.cursor,\n                tool: op.tool_of(i) as u8,\n                ring_pos: s.tool,\n                using: s.held & btn::USE != 0,\n                pressure: s.pressure,\n                eng: eng_code(s.eng),\n                meter: match s.eng {\n                    Eng::Heat => op.find(s.eng_id).map(|k| op.hazards[k].fill).unwrap_or(0.0),\n                    Eng::Iv => s.eng_a,\n                    _ => 0.0,\n                },\n                score: s.score,\n                chain: s.chain,\n                gift: if op.slots[0].gift_kind == 3 { op.slots[0].gift } else { s.gift },\n                gift_kind: s.gift_kind,\n                arming: s.arming,\n                recoil: s.recoil,\n                clink: s.clink,\n                hover: s.hover,\n                flow: s.flow,\n                charge: s.charge,\n            })\n            .collect();\n        // The camera leans in for a moment of drama.\n        let mut shot = CameraShot::field();\n        let push = op.push * op.push * (3.0 - 2.0 * op.push);\n        shot.distance -= 2.2 * push;\n        let aim = op.reveal_at * 0.2 * push;\n        shot.target[0] += aim.x;\n        shot.target[2] += aim.y;\n        f.camera = shot;\n    }\n}\n\nfn eng_code(e: Eng) -> u8 {\n    match e {\n        Eng::None => 0,\n        Eng::Cut => 1,\n        Eng::Pull => 2,\n        Eng::Stitch => 3,\n        Eng::Suck => 4,\n        Eng::Heat => 5,\n        Eng::Paint => 6,\n        Eng::Scan => 7,\n        Eng::Iv => 8,\n        Eng::Dress => 9,\n        Eng::Bone => 10,\n    }\n}\n\n/// The phase attract jumps to in a case: its first strain.\nfn demo_strain_phase(case: usize) -> usize {\n    let c = content();\n    if case == 7 {\n        return c.cases[7].phase.iter().position(|p| p.strain.as_deref() == Some(\"soloist\")).unwrap_or(0);\n    }\n    c.cases[case].phase.iter().position(|p| p.strain.is_some()).unwrap_or(0)\n}\n\nimpl Game for Surgery {\n    const KEY: &'static str = \"surgery\";\n\n    fn pre(\n        &mut self,\n        _sim: &mut Sim,\n        input: &InputFrame,\n        dt: f32,\n        events: &mut Vec<SimEvent>,\n    ) -> BTreeMap<EntityId, InputFrame> {\n        self.tick += 1;\n        self.time += dt;\n        self.stage_t += dt;\n        let first = input.surgeons[0];\n        match self.stage {\n            Stage::Story => self.story_tick(&first, dt, events),\n            Stage::Chart => {\n                if first.pressed & btn::ADVANCE != 0 || self.stage_t > 7.0 {\n                    self.stage = Stage::Op;\n                    self.stage_t = 0.0;\n                    if let Some(op) = &mut self.op {\n                        op.set_banner(\"OPERATION START\");\n                    }\n                }\n            }\n            Stage::Op => self.op_tick(input, dt, events),\n            Stage::Complete => {\n                if self.stage_t > 1.6 {\n                    self.enter_results();\n                }\n            }\n            Stage::Results => {\n                if self.stage_t > 1.0 && first.pressed & btn::ADVANCE != 0 {\n                    if self.stage_t < 2.8 {\n                        self.stage_t = 2.8; // show it all first\n                    } else {\n                        self.after_case();\n                    }\n                }\n                if self.stage_t > 2.2 && self.stage_t - dt <= 2.2 {\n                    events.push(SimEvent::Cue { id: cue::STAMP, pos: glam::Vec3::ZERO, gain: 1.0, pitch: 1.0 });\n                }\n            }\n            Stage::Dead => {\n                if first.pressed & btn::ADVANCE != 0 {\n                    self.retry_checkpoint();\n                } else if first.pressed & btn::CANCEL != 0 {\n                    self.retry_start();\n                }\n            }\n            Stage::Title | Stage::Done | Stage::Card => {}\n        }\n        if self.mode == Mode::Attract {\n            self.demo_t += dt;\n            if self.demo_t > 25.0 || self.stage == Stage::Results || self.stage == Stage::Complete || self.stage == Stage::Done {\n                self.next_demo_segment();\n            }\n        }\n        BTreeMap::new()\n    }\n\n    fn hud(&self, _sim: &Sim) -> Vec<String> {\n        Vec::new() // the shell and HUD draw everything\n    }\n\n    fn status(&self, _sim: &Sim) -> serde_json::Value {\n        let op = self.op.as_ref();\n        json!({\n            \"outcome\": self.outcome,\n            \"mode\": format!(\"{:?}\", self.mode),\n            \"stage\": format!(\"{:?}\", self.stage),\n            \"case\": self.case,\n            \"phase\": op.map(|o| o.phase),\n            \"vitals\": op.map(|o| o.vitals),\n            \"timer\": op.map(|o| o.timer),\n            \"bpm\": op.map(|o| o.heart.bpm),\n            \"hazards\": op.map(|o| o.hazards.iter().map(|h| format!(\"{}:{}\", h.kind.key(), h.stage)).collect::<Vec<_>>()),\n            \"cursor\": op.map(|o| [o.slots[0].cursor.x, o.slots[0].cursor.y]),\n            \"tool\": op.map(|o| o.tool_of(0).key()),\n            \"gift\": op.map(|o| o.slots[0].gift),\n            \"scores\": op.map(|o| o.slots.iter().map(|s| s.score).collect::<Vec<_>>()),\n            \"actives\": op.map(|o| o.slots.iter().map(|s| s.active).collect::<Vec<_>>()),\n            \"rank\": self.results.as_ref().map(|r| r.rank.clone()),\n            \"total\": self.results.as_ref().map(|r| r.total),\n            \"story\": self.story.as_ref().map(|s| json!({\"line\": s.line, \"who\": s.who, \"set\": s.set})),\n            \"demo_seg\": self.demo_seg,\n            \"music\": self.music,\n            \"tick\": self.tick,\n        })\n    }\n\n    fn outcome(&self) -> Outcome {\n        self.outcome\n    }\n\n    fn bot(&self, _sim: &Sim) -> InputFrame {\n        let mut f = InputFrame::default();\n        match self.stage {\n            Stage::Op => {\n                if let Some(op) = &self.op {\n                    let rules = self.rules();\n                    if !self.no_local && op.slots[0].active && !op.slots[0].bot {\n                        f.surgeons[0] = op.bot_input(0, &rules);\n                    }\n                }\n            }\n            Stage::Dead | Stage::Done | Stage::Title | Stage::Card => {}\n            // Story, chart and results: press on, every few ticks.\n            _ => {\n                f.surgeons[0].active = true;\n                if self.tick.is_multiple_of(3) {\n                    f.surgeons[0].pressed = btn::ADVANCE;\n                    f.surgeons[0].held = btn::ADVANCE;\n                }\n            }\n        }\n        f\n    }\n}\n\nimpl Surgery {\n    fn op_tick(&mut self, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) {\n        let rules = self.rules();\n        let Some(op) = &mut self.op else { return };\n        let mut inputs = input.surgeons;\n        // A human on a seat takes it from the bot.\n        for i in 0..4 {\n            if inputs[i].active && op.slots[i].bot && self.mode != Mode::Attract {\n                op.slots[i].bot = false;\n            }\n            if op.slots[i].bot || (self.dev.bot_plays && i == 0) {\n                inputs[i] = op.bot_input(i, &rules);\n            }\n        }\n        op.tick(&inputs, &rules, dt);\n        events.append(&mut op.ev);\n        let (won, dead) = (op.won, op.dead);\n        if won {\n            op.set_banner(\"OPERATION COMPLETE\");\n            events.append(&mut op.ev);\n            self.stage = Stage::Complete;\n            self.stage_t = 0.0;\n            events.push(SimEvent::Cue { id: cue::RATE_IMMACULATE, pos: glam::Vec3::ZERO, gain: 1.0, pitch: 0.8 });\n            return;\n        }\n        if dead {\n            let elapsed = op.elapsed as i32;\n            self.death_time = format!(\"Time of death: 03:{:02}.\", (42 + elapsed) % 60);\n            cover::merge(&mut self.cov, &op.cov.clone());\n            op.cov = vec![0; cover::NAMES.len()];\n            op.dead = false;\n            self.stage = Stage::Dead;\n            self.stage_t = 0.0;\n            self.outcome = Outcome::Lost;\n            events.push(SimEvent::Cue { id: cue::FLATLINE, pos: glam::Vec3::ZERO, gain: 1.0, pitch: 1.0 });\n        }\n    }\n}\n\n/// The hazard kinds the dev panel can spawn at the cursor.\npub const SPAWNABLE: &[&str] = &[\"lacer\", \"pool\", \"bleeder\", \"object\", \"polyp\", \"tumor\", \"patch\", \"burn\", \"incision\"];\n\n/// Names of every instrument, in tool order (for tools and tests).\npub fn tool_names() -> Vec<&'static str> {\n    Tool::ALL.iter().map(|t| t.key()).collect()\n}\n\n/// A hazard kind by key, for tests.\npub fn kind_of(key: &str) -> Option<Kind> {\n    Kind::ALL.into_iter().find(|k| k.key() == key)\n}\n\n/// Field position helper for hosts.\npub fn clamp_field(p: Vec2) -> Vec2 {\n    p.clamp(Vec2::new(-10.6, -5.6), Vec2::new(10.6, 5.9))\n}\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ESPdhdiBwQkSGj85c1tkfQ","type":"tool_result","content":"File created successfully at: /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery/mod.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"ed929131-9730-461a-926f-1305ceb27b00","timestamp":"2026-11-05T14:41:39.238Z","tool_use_result":{"type":"create","filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery/mod.rs","content":"//! The surgical-action melodrama: cases and story as one deterministic phase machine.\n//!\n//! Scenes: `surgery/title`, `surgery/campaign` (or `surgery/campaign/<from>`), `surgery/case/<n>`\n//! (or `surgery/case/<n>/<phase>`), `surgery/codeblue`, `surgery/attract`, `surgery/card`,\n//! `surgery/mirror`. The bot presses through story and plays operations, so `surgery/campaign`\n//! is the scripted playthrough of the whole game. `content/README.md` is the designer guide.\n\npub mod bot;\npub mod content;\npub mod cover;\npub mod cue;\npub mod field;\npub mod frame;\npub mod net;\npub mod strain;\npub mod tune;\n\nuse std::collections::BTreeMap;\nuse std::sync::Arc;\n\nuse anyhow::{Result, anyhow, bail};\nuse glam::Vec2;\nuse serde::{Deserialize, Serialize};\nuse serde_json::json;\n\nuse self::content::{CODE_BLUE, content, music_id};\nuse self::field::{Eng, Kind, Op, Rules, Tool};\nuse self::frame::{ActorView, CameraShot, ResultsView, SlotView, Stage, StoryView, SurgeryFrame};\nuse self::tune::{Difficulty, Tune};\nuse super::{Game, GameBox, Outcome};\nuse crate::entity::EntityId;\nuse crate::frame::SimEvent;\nuse crate::input::{InputFrame, SurgeonInput, surgeon_buttons as btn};\nuse crate::room::RoomDef;\nuse crate::sim::Sim;\n\n/// The OR wide-shot set, a room file far from the field.\nconst LEVEL: &str = include_str!(\"surgery.toml\");\n\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub enum Mode {\n    #[default]\n    Title,\n    Campaign,\n    /// One case by itself.\n    Case,\n    CodeBlue,\n    Attract,\n    Card,\n    Mirror,\n}\n\n/// Dev switches (the panel's Tools page).\n#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]\npub struct Dev {\n    pub immortal: bool,\n    pub freeze_timer: bool,\n    pub full_gift: bool,\n    pub one_hit: bool,\n    /// The bot plays the human's seat too.\n    pub bot_plays: bool,\n}\n\n#[derive(Clone, Debug, Default, Serialize, Deserialize)]\npub struct Story {\n    pub scene: u16,\n    pub line: u16,\n    pub typed: f32,\n    pub hold: f32,\n    pub actors: Vec<ActorView>,\n    pub set: String,\n    pub camera: u8,\n    pub flash: f32,\n    pub shake: f32,\n    pub who: String,\n    pub text: String,\n    pub expr: String,\n    /// Waiting on a line (false while running stage commands).\n    pub line_age: f32,\n}\n\n#[derive(Clone, Serialize, Deserialize)]\npub struct Surgery {\n    pub mode: Mode,\n    pub stage: Stage,\n    pub stage_t: f32,\n    pub case: u8,\n    pub story: Option<Story>,\n    pub op: Option<Box<Op>>,\n    pub results: Option<ResultsView>,\n    pub outcome: Outcome,\n    pub tune: Tune,\n    pub diff: Difficulty,\n    pub dev: Dev,\n    pub tremor: bool,\n    pub bot_skill: f32,\n    pub tick: u64,\n    pub time: f32,\n    pub cov: Vec<u32>,\n    pub music: u8,\n    pub text_speed: f32,\n    pub auto_advance: bool,\n    pub seed: u64,\n    /// Seconds of attract spent on this segment, and which.\n    pub demo_seg: u8,\n    pub demo_t: f32,\n    /// Slot 0 isn't played from this copy (a hub server, a client).\n    pub no_local: bool,\n    pub death_time: String,\n    /// The last result, for the shell to save.\n    pub last_rank: Option<(u8, String, i64)>,\n    pub cases_won: u8,\n    #[serde(skip)]\n    pub mirror_frame: Option<Arc<SurgeryFrame>>,\n}\n\n/// The scene's game state, for tools.\npub fn get(sim: &Sim) -> Option<&Surgery> {\n    sim.play()?.get::<Surgery>()\n}\n\npub fn get_mut(sim: &mut Sim) -> Option<&mut Surgery> {\n    sim.state.play.as_mut()?.get_mut::<Surgery>()\n}\n\n/// What `RenderFrame::surgery` holds.\npub fn frame_of(sim: &Sim) -> Option<Arc<SurgeryFrame>> {\n    let g = get(sim)?;\n    if let Some(m) = &g.mirror_frame {\n        return Some(m.clone());\n    }\n    Some(Arc::new(g.frame()))\n}\n\n/// Builds the scene: `surgery/<what>`.\npub fn build(sim: &mut Sim, rest: Option<&str>) -> Result<()> {\n    let def = RoomDef::parse(&super::level_text(\"surgery/surgery\", LEVEL)).map_err(|e| anyhow!(\"surgery.toml: {e}\"))?;\n    crate::scenes::build_standalone_room(sim, \"surgery\", def);\n    if let Some(p) = sim.state.player {\n        sim.despawn(p);\n    }\n    sim.state.focus = glam::Vec3::new(0.0, 0.0, 0.2);\n    let seed = sim.state.rng.next_u32() as u64;\n    let mut g = Surgery::new(seed);\n    let parts: Vec<&str> = rest.unwrap_or(\"title\").split('/').collect();\n    match parts[0] {\n        \"title\" => g.mode = Mode::Title,\n        \"card\" => g.mode = Mode::Card,\n        \"mirror\" => g.mode = Mode::Mirror,\n        \"campaign\" => {\n            g.mode = Mode::Campaign;\n            let from: usize = parts.get(1).and_then(|p| p.parse().ok()).unwrap_or(0);\n            g.begin_case(from.min(7));\n        }\n        \"case\" => {\n            g.mode = Mode::Case;\n            let n: usize = parts.get(1).ok_or_else(|| anyhow!(\"surgery/case/<n>: which case?\"))?.parse()?;\n            if n >= CODE_BLUE {\n                bail!(\"surgery/case/{n}: cases are 0 to 7\");\n            }\n            let phase: Option<usize> = parts.get(2).and_then(|p| p.parse().ok());\n            g.begin_op(n);\n            if let Some(p) = phase {\n                g.jump_phase(p);\n            }\n            g.stage = Stage::Op;\n        }\n        \"codeblue\" => {\n            g.mode = Mode::CodeBlue;\n            g.begin_op(CODE_BLUE);\n            g.stage = Stage::Op;\n        }\n        \"attract\" => {\n            g.mode = Mode::Attract;\n            g.dev.immortal = true;\n            g.dev.full_gift = true;\n            g.demo_seg = 0;\n            g.begin_demo_segment();\n        }\n        other => bail!(\"unknown surgery scene '{other}' (title, campaign, case/<n>, codeblue, attract, card, mirror)\"),\n    }\n    sim.state.play = Some(GameBox::new(g));\n    Ok(())\n}\n\nimpl Surgery {\n    pub fn new(seed: u64) -> Self {\n        let bot_skill = 1.0;\n        Surgery {\n            mode: Mode::Title,\n            stage: Stage::Title,\n            stage_t: 0.0,\n            case: 0,\n            story: None,\n            op: None,\n            results: None,\n            outcome: Outcome::Playing,\n            tune: Tune::default(),\n            diff: Difficulty::default(),\n            dev: Dev::default(),\n            tremor: true,\n            bot_skill,\n            tick: 0,\n            time: 0.0,\n            cov: vec![0; cover::NAMES.len()],\n            music: music_id(\"title\"),\n            text_speed: 1.0,\n            auto_advance: false,\n            seed,\n            demo_seg: 0,\n            demo_t: 0.0,\n            no_local: false,\n            death_time: String::new(),\n            last_rank: None,\n            cases_won: 0,\n            mirror_frame: None,\n        }\n    }\n\n    pub fn rules(&self) -> Rules {\n        Rules {\n            tune: self.tune,\n            diff: self.diff,\n            immortal: self.dev.immortal,\n            freeze_timer: self.dev.freeze_timer,\n            full_gift: self.dev.full_gift,\n            one_hit: self.dev.one_hit,\n            tremor: self.tremor,\n            bot_skill: self.bot_skill,\n            tick: self.tick,\n            time: self.time,\n        }\n    }\n\n    // ---------------------------------------------------------------------------------------\n    // Flow\n\n    /// A campaign's case begins: its story, then the chart.\n    pub fn begin_case(&mut self, k: usize) {\n        self.case = k as u8;\n        self.op = None;\n        self.results = None;\n        let c = content();\n        match c.cases[k].before.clone() {\n            Some(id) => self.begin_story(&id),\n            None => self.begin_chart(k),\n        }\n    }\n\n    pub fn begin_story(&mut self, id: &str) {\n        let c = content();\n        let Some(scene) = c.scenes.iter().position(|s| s.id == id) else {\n            log::error!(\"unknown story scene '{id}'\");\n            return;\n        };\n        self.stage = Stage::Story;\n        self.stage_t = 0.0;\n        self.story = Some(Story {\n            scene: scene as u16,\n            line: 0,\n            set: \"corridor\".into(),\n            ..Default::default()\n        });\n        self.run_stage_commands();\n    }\n\n    fn begin_chart(&mut self, k: usize) {\n        self.case = k as u8;\n        self.story = None;\n        self.stage = Stage::Chart;\n        self.stage_t = 0.0;\n        self.begin_op(k);\n        self.stage = Stage::Chart;\n        let c = content();\n        self.music = music_id(if c.cases[k].music.is_empty() { \"or\" } else { &c.cases[k].music });\n    }\n\n    /// Prepares the operation (its clock does not run in `Chart`).\n    pub fn begin_op(&mut self, k: usize) {\n        self.case = k as u8;\n        let rules = self.rules();\n        self.seed = self.seed.wrapping_mul(0x9E37_79B9).wrapping_add(k as u64 + 1);\n        let mut op = Op::new(k, &rules, self.seed);\n        let c = content();\n        // Case 7: the partner is a surgeon of her own, until someone takes her seat.\n        if c.cases[k].gift == \"duet\" {\n            op.slots[1].active = true;\n            op.slots[1].bot = true;\n            op.slots[1].gift_kind = 2;\n        }\n        if self.mode == Mode::Attract {\n            op.showing = true;\n            for s in op.slots.iter_mut() {\n                s.bot = s.active;\n            }\n            if k == CODE_BLUE {\n                for s in op.slots.iter_mut() {\n                    s.active = true;\n                    s.bot = true;\n                }\n            }\n        }\n        if self.no_local {\n            op.slots[0].active = false;\n        }\n        op.set_banner(\"OPERATION START\");\n        self.music = music_id(if c.cases[k].music.is_empty() { \"or\" } else { &c.cases[k].music });\n        self.op = Some(Box::new(op));\n        self.stage = Stage::Op;\n        self.stage_t = 0.0;\n    }\n\n    fn after_case(&mut self) {\n        let k = self.case as usize;\n        let c = content();\n        if self.mode == Mode::Campaign {\n            self.cases_won = self.cases_won.max(k as u8 + 1);\n            match c.cases[k].after.clone() {\n                Some(id) => {\n                    self.begin_story(&id);\n                    return;\n                }\n                None => self.after_story(),\n            }\n            return;\n        }\n        self.finish();\n    }\n\n    fn after_story(&mut self) {\n        let k = self.case as usize;\n        let c = content();\n        match self.mode {\n            Mode::Campaign => {\n                // A story scene ends either a case's \"before\" (go on to the chart) or its \"after\".\n                let before = self.op.is_none() && self.results.is_none();\n                if before {\n                    self.begin_chart(k);\n                } else if k + 1 < 8 {\n                    self.begin_case(k + 1);\n                } else {\n                    self.finish();\n                }\n                let _ = c;\n            }\n            Mode::Attract => self.next_demo_segment(),\n            _ => self.finish(),\n        }\n    }\n\n    fn finish(&mut self) {\n        self.stage = Stage::Done;\n        self.stage_t = 0.0;\n        self.story = None;\n        self.outcome = Outcome::Won;\n    }\n\n    fn enter_results(&mut self) {\n        let Some(op) = &self.op else { return };\n        let c = content();\n        let case = &c.cases[op.case as usize];\n        let score: i64 = op.slots.iter().map(|s| s.score).sum();\n        let tally: u32 = op.slots.iter().map(|s| s.tally[2] + s.tally[3]).sum();\n        let vitals = (op.vitals * 20.0) as i64;\n        let time = (op.timer.max(0.0) * 5.0) as i64;\n        let mistakes = -(op.mistakes as i64) * 100;\n        let total = (score + vitals + time + mistakes).max(0);\n        let ratio = total as f32 / case.par.max(1.0);\n        let rank = if ratio >= 1.15 {\n            \"ENCORE\"\n        } else if ratio >= 1.0 {\n            \"S\"\n        } else if ratio >= 0.85 {\n            \"A\"\n        } else if ratio >= 0.7 {\n            \"B\"\n        } else if ratio >= 0.5 {\n            \"C\"\n        } else {\n            \"D\"\n        };\n        let lines = vec![\n            (\"Technique\".to_string(), score),\n            (\"Vitals remaining\".to_string(), vitals),\n            (\"Time remaining\".to_string(), time),\n            (format!(\"Clean work: {tally}, mistakes: {}\", op.mistakes), mistakes),\n        ];\n        let results = ResultsView {\n            case: op.case,\n            title: case.name.clone(),\n            patient: case.patient.clone(),\n            fate: case.fate.clone(),\n            lines,\n            total,\n            par: case.par,\n            rank: rank.to_string(),\n            t: 0.0,\n            won: true,\n            scores: op.slots.iter().filter(|s| s.active).map(|s| s.score).collect(),\n        };\n        self.last_rank = Some((op.case, rank.to_string(), total));\n        self.results = Some(results);\n        self.stage = Stage::Results;\n        self.stage_t = 0.0;\n        self.music = music_id(\"results\");\n        cover::merge(&mut self.cov, &op.cov.clone());\n        if let Some(op) = &mut self.op {\n            op.cov = vec![0; cover::NAMES.len()];\n        }\n    }\n\n    /// Retries the operation from the last checkpoint: instant.\n    pub fn retry_checkpoint(&mut self) {\n        let rules = self.rules();\n        if let Some(op) = &mut self.op {\n            if op.retry_checkpoint(&rules) {\n                self.stage = Stage::Op;\n                self.stage_t = 0.0;\n                self.outcome = Outcome::Playing;\n                return;\n            }\n        }\n        self.retry_start();\n    }\n\n    /// Retries the operation from its start.\n    pub fn retry_start(&mut self) {\n        let cov = self.op.as_ref().map(|o| o.cov.clone());\n        let k = self.case as usize;\n        self.begin_op(k);\n        if let (Some(op), Some(cov)) = (&mut self.op, cov) {\n            op.cov = cov;\n        }\n        self.stage = Stage::Op;\n        self.stage_t = 0.0;\n        self.outcome = Outcome::Playing;\n    }\n\n    // ---------------------------------------------------------------------------------------\n    // Dev tools (called from the shell through the host)\n\n    pub fn jump_phase(&mut self, p: usize) {\n        let rules = self.rules();\n        if let Some(op) = &mut self.op {\n            op.hazards.clear();\n            op.strain = None;\n            op.code = None;\n            op.heart.stopped = false;\n            op.fever = None;\n            let c = content();\n            // The plate as of that phase.\n            let case = &c.cases[op.case as usize];\n            let mut plate = case.plate.clone();\n            for ph in case.phase.iter().take(p + 1) {\n                if let Some(r) = &ph.reveal_plate {\n                    plate = r.clone();\n                }\n            }\n            op.plate = field::plate_id(&c, &plate);\n            op.plate_prev = op.plate;\n            op.reveal = 1.0;\n            if case.gift_locked && p > 0 {\n                op.gifts.locked = false;\n            }\n            op.enter_phase(p.min(case.phase.len().saturating_sub(1)), &rules);\n        }\n    }\n\n    pub fn skip_phase(&mut self) {\n        let next = self.op.as_ref().map(|o| o.phase as usize + 1).unwrap_or(0);\n        let last = self.op.as_ref().map(|o| content().cases[o.case as usize].phase.len()).unwrap_or(0);\n        if next >= last {\n            self.win_case();\n        } else {\n            self.jump_phase(next);\n        }\n    }\n\n    pub fn win_case(&mut self) {\n        if let Some(op) = &mut self.op {\n            op.hazards.clear();\n            op.strain = None;\n            op.code = None;\n            op.won = true;\n        }\n    }\n\n    pub fn force_code(&mut self) {\n        let rules = self.rules();\n        if let Some(op) = &mut self.op {\n            op.start_code(0, &rules);\n        }\n    }\n\n    pub fn kill_patient(&mut self) {\n        if let Some(op) = &mut self.op {\n            op.vitals = 0.0;\n            op.codes_left = 0;\n            op.code = None;\n            op.dead = true;\n        }\n    }\n\n    /// Spawns a hazard of a kind at the cursor.\n    pub fn spawn_hazard(&mut self, kind: &str) {\n        let rules = self.rules();\n        let Some(op) = &mut self.op else { return };\n        let at = op.slots[0].cursor;\n        let spec = content::SpawnSpec {\n            kind: kind.to_string(),\n            a: Some([at.x - 1.0, at.y]),\n            b: Some([at.x + 1.0, at.y]),\n            optional: true,\n            ..Default::default()\n        };\n        op.spawn_spec(&spec);\n        let _ = rules;\n    }\n\n    pub fn set_tune(&mut self, key: &str, v: f32) -> bool {\n        self.tune.set(key, v)\n    }\n\n    // ---------------------------------------------------------------------------------------\n    // Story\n\n    /// Runs lines with no text at once (stage commands), and stops on the next spoken line.\n    fn run_stage_commands(&mut self) {\n        let c = content();\n        let Some(st) = &mut self.story else { return };\n        let scene = &c.scenes[st.scene as usize];\n        loop {\n            let Some(line) = scene.line.get(st.line as usize) else {\n                self.story.as_mut().unwrap().text.clear();\n                self.story_over();\n                return;\n            };\n            if let Some(s) = &line.set {\n                st.set = s.clone();\n                st.actors.clear();\n            }\n            if let Some(r) = &line.enter {\n                st.actors.retain(|a| a.rig != *r);\n                st.actors.push(ActorView {\n                    rig: r.clone(),\n                    x: line.x.unwrap_or(0.0),\n                    expr: line.expr.clone().unwrap_or_else(|| \"neutral\".into()),\n                    age: 0.0,\n                    talking: false,\n                    leaving: 0.0,\n                });\n            }\n            if let Some(r) = &line.exit {\n                st.actors.retain(|a| a.rig != *r);\n            }\n            if let Some(m) = &line.music {\n                self.music = music_id(m);\n            }\n            if let Some(f) = line.flash {\n                st.flash = f;\n            }\n            if let Some(f) = line.shake {\n                st.shake = f;\n            }\n            if let Some(cam) = &line.camera {\n                st.camera = if cam == \"or_wide\" { 1 } else { 0 };\n            }\n            if let Some(text) = &line.text {\n                st.who = line.who.clone().unwrap_or_default();\n                st.text = text.clone();\n                st.expr = line.expr.clone().unwrap_or_default();\n                st.typed = 0.0;\n                st.line_age = 0.0;\n                if let (Some(who), Some(x)) = (&line.who, &line.expr) {\n                    if let Some(a) = st.actors.iter_mut().find(|a| a.rig == *who) {\n                        a.expr = x.clone();\n                    }\n                }\n                return;\n            }\n            st.line += 1;\n        }\n    }\n\n    fn story_over(&mut self) {\n        self.story = None;\n        self.after_story();\n    }\n\n    fn story_tick(&mut self, input: &SurgeonInput, dt: f32, events: &mut Vec<SimEvent>) {\n        let (auto, speed) = (self.auto_advance || self.mode == Mode::Attract, self.text_speed);\n        let mut next = false;\n        {\n            let Some(st) = &mut self.story else { return };\n            st.typed += dt * 34.0 * speed;\n            st.line_age += dt;\n            st.flash = (st.flash - dt * 2.0).max(0.0);\n            st.shake = (st.shake - dt * 2.0).max(0.0);\n            for a in &mut st.actors {\n                a.age += dt;\n                a.talking = a.rig == st.who && (st.typed as usize) < st.text.chars().count();\n            }\n            let len = st.text.chars().count() as f32;\n            let done = st.typed >= len;\n            if input.held & btn::ADVANCE != 0 {\n                st.hold += dt;\n            } else {\n                st.hold = 0.0;\n            }\n            // Advance; hold to skip the whole scene.\n            if st.hold > 0.8 {\n                st.line = u16::MAX;\n                next = true;\n            } else if input.pressed & btn::ADVANCE != 0 {\n                if done {\n                    next = true;\n                } else {\n                    st.typed = len;\n                }\n            } else if auto && done && st.line_age > (len / 26.0).max(0.9) + 0.6 {\n                next = true;\n            }\n        }\n        if next {\n            let c = content();\n            let st = self.story.as_mut().unwrap();\n            let scene = &c.scenes[st.scene as usize];\n            if st.line == u16::MAX {\n                // Skip: play what's left silently for its music and exits.\n                st.line = scene.line.len() as u16;\n                st.text.clear();\n                self.story_over();\n                return;\n            }\n            st.line += 1;\n            self.run_stage_commands();\n            events.push(SimEvent::Cue { id: cue::UI_NAV, pos: glam::Vec3::ZERO, gain: 0.3, pitch: 1.0 });\n        }\n    }\n\n    // ---------------------------------------------------------------------------------------\n    // Attract: a loop of about 25 s segments\n\n    fn begin_demo_segment(&mut self) {\n        self.demo_t = 0.0;\n        self.story = None;\n        match self.demo_seg % 6 {\n            0 => {\n                self.begin_op(3);\n                self.jump_phase(demo_strain_phase(3));\n                self.stage = Stage::Op;\n            }\n            1 => {\n                self.begin_op(4);\n                self.jump_phase(demo_strain_phase(4));\n                self.stage = Stage::Op;\n            }\n            2 => {\n                self.begin_op(5);\n                self.stage = Stage::Op;\n            }\n            3 => {\n                self.begin_op(7);\n                self.jump_phase(demo_strain_phase(7));\n                self.stage = Stage::Op;\n            }\n            4 => {\n                self.begin_op(CODE_BLUE);\n                self.stage = Stage::Op;\n            }\n            _ => {\n                self.op = None;\n                self.begin_story(\"case3_before\");\n            }\n        }\n    }\n\n    fn next_demo_segment(&mut self) {\n        self.demo_seg = (self.demo_seg + 1) % 6;\n        self.begin_demo_segment();\n    }\n\n    // ---------------------------------------------------------------------------------------\n    // The frame\n\n    pub fn frame(&self) -> SurgeryFrame {\n        let c = content();\n        let mut f = SurgeryFrame {\n            stage: self.stage,\n            stage_t: self.stage_t,\n            time: self.time,\n            tick: self.tick,\n            case: self.case,\n            music: self.music,\n            demo: self.mode == Mode::Attract,\n            death_time: self.death_time.clone(),\n            results: self.results.clone(),\n            camera: CameraShot::field(),\n            can_retry: true,\n            ..Default::default()\n        };\n        if let Some(case) = c.cases.get(self.case as usize) {\n            f.case_name = case.name.clone();\n            f.patient = case.patient.clone();\n            f.life = case.life.clone();\n            f.diagnosis = case.diagnosis.clone();\n            f.surgeon = case.surgeon.clone();\n        }\n        // The plate behind the title breathes by itself.\n        f.vitals = 100.0;\n        f.bpm = 62.0;\n        f.beat = (self.time * 62.0 / 60.0).fract();\n        f.meter = 4;\n        f.reveal = 1.0;\n        f.time_scale = 1.0;\n        if self.stage == Stage::Title || self.stage == Stage::Card {\n            f.plate = field::plate_id(&c, \"heart\");\n            f.plate_prev = f.plate;\n        }\n        if let Some(op) = &self.op {\n            self.fill_op(&mut f, op, &c);\n        }\n        if let Some(st) = &self.story {\n            f.story = Some(StoryView {\n                scene: st.scene,\n                line: st.line,\n                typed: st.typed,\n                who: st.who.clone(),\n                text: st.text.clone(),\n                expr: st.expr.clone(),\n                actors: st.actors.clone(),\n                set: st.set.clone(),\n                camera: st.camera,\n                flash: st.flash,\n                shake: st.shake,\n                auto: self.auto_advance,\n                skip: (st.hold / 0.8).clamp(0.0, 1.0),\n            });\n            f.camera = if st.camera == 1 { CameraShot::or_wide() } else { CameraShot::paper() };\n        }\n        if self.stage == Stage::Results || self.stage == Stage::Chart {\n            f.camera = CameraShot { distance: 21.5, ..CameraShot::field() };\n        }\n        if let Some(r) = &mut f.results {\n            r.t = self.stage_t;\n        }\n        f\n    }\n\n    fn fill_op(&self, f: &mut SurgeryFrame, op: &Op, c: &content::Content) {\n        let case = &c.cases[op.case as usize];\n        let phase = case.phase.get(op.phase as usize);\n        f.case = op.case;\n        f.phase = op.phase;\n        f.now = phase.map(|p| p.now.clone()).unwrap_or_default();\n        f.guide = phase.is_some_and(|p| p.guide);\n        f.plate = op.plate;\n        f.plate_prev = op.plate_prev;\n        f.reveal = op.reveal;\n        f.reveal_at = op.reveal_at;\n        f.vitals = op.vitals;\n        f.bpm = op.heart.bpm;\n        f.beat = op.heart.phase;\n        f.beats = op.heart.beats;\n        f.meter = op.heart.meter;\n        f.bar = op.heart.bar;\n        f.stopped = op.heart.stopped;\n        f.timer = op.timer;\n        f.timer_max = op.timer_max;\n        f.fever = op.fever;\n        f.heat_ring = op.heat_ring;\n        f.ring_warn = op.ring_warn;\n        f.hush = (op.gifts.hush / 6.0).clamp(0.0, 1.0);\n        f.echo = op.gifts.echo;\n        f.duet = op.gifts.duet;\n        f.gift_locked = op.gifts.locked;\n        f.time_scale = op.time_scale;\n        f.hazards = op.hazards.clone();\n        f.stains = op.stains.clone();\n        f.threads = op.threads.clone();\n        f.floats = op.floats.clone();\n        f.flights = op.flights.clone();\n        f.callout = op.callout.clone();\n        f.banner = op.banner.clone();\n        f.banner_t = op.banner_t;\n        f.code = op.code;\n        f.codes_left = op.codes_left;\n        f.iv_cd = op.iv_cd;\n        f.ghost = op.gifts.ghost;\n        f.ghost_t = op.gifts.ghost_t;\n        f.ripple = op.gifts.ripple;\n        f.shake = op.shake;\n        f.flash = op.flash;\n        f.push = op.push;\n        f.crisis = ((55.0 - op.vitals) / 45.0).clamp(0.0, 1.0);\n        f.ring = std::array::from_fn(|k| op.ring[k] as u8);\n        f.slots = op\n            .slots\n            .iter()\n            .enumerate()\n            .map(|(i, s)| SlotView {\n                active: s.active,\n                bot: s.bot,\n                cursor: s.cursor,\n                tool: op.tool_of(i) as u8,\n                ring_pos: s.tool,\n                using: s.held & btn::USE != 0,\n                pressure: s.pressure,\n                eng: eng_code(s.eng),\n                meter: match s.eng {\n                    Eng::Heat => op.find(s.eng_id).map(|k| op.hazards[k].fill).unwrap_or(0.0),\n                    Eng::Iv => s.eng_a,\n                    _ => 0.0,\n                },\n                score: s.score,\n                chain: s.chain,\n                gift: if op.slots[0].gift_kind == 3 { op.slots[0].gift } else { s.gift },\n                gift_kind: s.gift_kind,\n                arming: s.arming,\n                recoil: s.recoil,\n                clink: s.clink,\n                hover: s.hover,\n                flow: s.flow,\n                charge: s.charge,\n            })\n            .collect();\n        // The camera leans in for a moment of drama.\n        let mut shot = CameraShot::field();\n        let push = op.push * op.push * (3.0 - 2.0 * op.push);\n        shot.distance -= 2.2 * push;\n        let aim = op.reveal_at * 0.2 * push;\n        shot.target[0] += aim.x;\n        shot.target[2] += aim.y;\n        f.camera = shot;\n    }\n}\n\nfn eng_code(e: Eng) -> u8 {\n    match e {\n        Eng::None => 0,\n        Eng::Cut => 1,\n        Eng::Pull => 2,\n        Eng::Stitch => 3,\n        Eng::Suck => 4,\n        Eng::Heat => 5,\n        Eng::Paint => 6,\n        Eng::Scan => 7,\n        Eng::Iv => 8,\n        Eng::Dress => 9,\n        Eng::Bone => 10,\n    }\n}\n\n/// The phase attract jumps to in a case: its first strain.\nfn demo_strain_phase(case: usize) -> usize {\n    let c = content();\n    if case == 7 {\n        return c.cases[7].phase.iter().position(|p| p.strain.as_deref() == Some(\"soloist\")).unwrap_or(0);\n    }\n    c.cases[case].phase.iter().position(|p| p.strain.is_some()).unwrap_or(0)\n}\n\nimpl Game for Surgery {\n    const KEY: &'static str = \"surgery\";\n\n    fn pre(\n        &mut self,\n        _sim: &mut Sim,\n        input: &InputFrame,\n        dt: f32,\n        events: &mut Vec<SimEvent>,\n    ) -> BTreeMap<EntityId, InputFrame> {\n        self.tick += 1;\n        self.time += dt;\n        self.stage_t += dt;\n        let first = input.surgeons[0];\n        match self.stage {\n            Stage::Story => self.story_tick(&first, dt, events),\n            Stage::Chart => {\n                if first.pressed & btn::ADVANCE != 0 || self.stage_t > 7.0 {\n                    self.stage = Stage::Op;\n                    self.stage_t = 0.0;\n                    if let Some(op) = &mut self.op {\n                        op.set_banner(\"OPERATION START\");\n                    }\n                }\n            }\n            Stage::Op => self.op_tick(input, dt, events),\n            Stage::Complete => {\n                if self.stage_t > 1.6 {\n                    self.enter_results();\n                }\n            }\n            Stage::Results => {\n                if self.stage_t > 1.0 && first.pressed & btn::ADVANCE != 0 {\n                    if self.stage_t < 2.8 {\n                        self.stage_t = 2.8; // show it all first\n                    } else {\n                        self.after_case();\n                    }\n                }\n                if self.stage_t > 2.2 && self.stage_t - dt <= 2.2 {\n                    events.push(SimEvent::Cue { id: cue::STAMP, pos: glam::Vec3::ZERO, gain: 1.0, pitch: 1.0 });\n                }\n            }\n            Stage::Dead => {\n                if first.pressed & btn::ADVANCE != 0 {\n                    self.retry_checkpoint();\n                } else if first.pressed & btn::CANCEL != 0 {\n                    self.retry_start();\n                }\n            }\n            Stage::Title | Stage::Done | Stage::Card => {}\n        }\n        if self.mode == Mode::Attract {\n            self.demo_t += dt;\n            if self.demo_t > 25.0 || self.stage == Stage::Results || self.stage == Stage::Complete || self.stage == Stage::Done {\n                self.next_demo_segment();\n            }\n        }\n        BTreeMap::new()\n    }\n\n    fn hud(&self, _sim: &Sim) -> Vec<String> {\n        Vec::new() // the shell and HUD draw everything\n    }\n\n    fn status(&self, _sim: &Sim) -> serde_json::Value {\n        let op = self.op.as_ref();\n        json!({\n            \"outcome\": self.outcome,\n            \"mode\": format!(\"{:?}\", self.mode),\n            \"stage\": format!(\"{:?}\", self.stage),\n            \"case\": self.case,\n            \"phase\": op.map(|o| o.phase),\n            \"vitals\": op.map(|o| o.vitals),\n            \"timer\": op.map(|o| o.timer),\n            \"bpm\": op.map(|o| o.heart.bpm),\n            \"hazards\": op.map(|o| o.hazards.iter().map(|h| format!(\"{}:{}\", h.kind.key(), h.stage)).collect::<Vec<_>>()),\n            \"cursor\": op.map(|o| [o.slots[0].cursor.x, o.slots[0].cursor.y]),\n            \"tool\": op.map(|o| o.tool_of(0).key()),\n            \"gift\": op.map(|o| o.slots[0].gift),\n            \"scores\": op.map(|o| o.slots.iter().map(|s| s.score).collect::<Vec<_>>()),\n            \"actives\": op.map(|o| o.slots.iter().map(|s| s.active).collect::<Vec<_>>()),\n            \"rank\": self.results.as_ref().map(|r| r.rank.clone()),\n            \"total\": self.results.as_ref().map(|r| r.total),\n            \"story\": self.story.as_ref().map(|s| json!({\"line\": s.line, \"who\": s.who, \"set\": s.set})),\n            \"demo_seg\": self.demo_seg,\n            \"music\": self.music,\n            \"tick\": self.tick,\n        })\n    }\n\n    fn outcome(&self) -> Outcome {\n        self.outcome\n    }\n\n    fn bot(&self, _sim: &Sim) -> InputFrame {\n        let mut f = InputFrame::default();\n        match self.stage {\n            Stage::Op => {\n                if let Some(op) = &self.op {\n                    let rules = self.rules();\n                    if !self.no_local && op.slots[0].active && !op.slots[0].bot {\n                        f.surgeons[0] = op.bot_input(0, &rules);\n                    }\n                }\n            }\n            Stage::Dead | Stage::Done | Stage::Title | Stage::Card => {}\n            // Story, chart and results: press on, every few ticks.\n            _ => {\n                f.surgeons[0].active = true;\n                if self.tick.is_multiple_of(3) {\n                    f.surgeons[0].pressed = btn::ADVANCE;\n                    f.surgeons[0].held = btn::ADVANCE;\n                }\n            }\n        }\n        f\n    }\n}\n\nimpl Surgery {\n    fn op_tick(&mut self, input: &InputFrame, dt: f32, events: &mut Vec<SimEvent>) {\n        let rules = self.rules();\n        let Some(op) = &mut self.op else { return };\n        let mut inputs = input.surgeons;\n        // A human on a seat takes it from the bot.\n        for i in 0..4 {\n            if inputs[i].active && op.slots[i].bot && self.mode != Mode::Attract {\n                op.slots[i].bot = false;\n            }\n            if op.slots[i].bot || (self.dev.bot_plays && i == 0) {\n                inputs[i] = op.bot_input(i, &rules);\n            }\n        }\n        op.tick(&inputs, &rules, dt);\n        events.append(&mut op.ev);\n        let (won, dead) = (op.won, op.dead);\n        if won {\n            op.set_banner(\"OPERATION COMPLETE\");\n            events.append(&mut op.ev);\n            self.stage = Stage::Complete;\n            self.stage_t = 0.0;\n            events.push(SimEvent::Cue { id: cue::RATE_IMMACULATE, pos: glam::Vec3::ZERO, gain: 1.0, pitch: 0.8 });\n            return;\n        }\n        if dead {\n            let elapsed = op.elapsed as i32;\n            self.death_time = format!(\"Time of death: 03:{:02}.\", (42 + elapsed) % 60);\n            cover::merge(&mut self.cov, &op.cov.clone());\n            op.cov = vec![0; cover::NAMES.len()];\n            op.dead = false;\n            self.stage = Stage::Dead;\n            self.stage_t = 0.0;\n            self.outcome = Outcome::Lost;\n            events.push(SimEvent::Cue { id: cue::FLATLINE, pos: glam::Vec3::ZERO, gain: 1.0, pitch: 1.0 });\n        }\n    }\n}\n\n/// The hazard kinds the dev panel can spawn at the cursor.\npub const SPAWNABLE: &[&str] = &[\"lacer\", \"pool\", \"bleeder\", \"object\", \"polyp\", \"tumor\", \"patch\", \"burn\", \"incision\"];\n\n/// Names of every instrument, in tool order (for tools and tests).\npub fn tool_names() -> Vec<&'static str> {\n    Tool::ALL.iter().map(|t| t.key()).collect()\n}\n\n/// A hazard kind by key, for tests.\npub fn kind_of(key: &str) -> Option<Kind> {\n    Kind::ALL.into_iter().find(|k| k.key() == key)\n}\n\n/// Field position helper for hosts.\npub fn clamp_field(p: Vec2) -> Vec2 {\n    p.clamp(Vec2::new(-10.6, -5.6), Vec2::new(10.6, 5.9))\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01ESPdhdiBwQkSGj85c1tkfQ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjxJAc6Cp7RbW1iDDDep","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01FATDY1z5DSnZCpfn4qreH1","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery/net.rs","content":"//! The hub's network: one compact snapshot from the host's frame, about 15 times a second, and\n//! each client's input back to the host. JSON with quantised numbers; under 1,200 bytes when it\n//! can be. A client decodes a snapshot back into a `SurgeryFrame`, the single source of everything\n//! drawn, so a mirror draws what a host draws.\n\nuse glam::Vec2;\nuse serde_json::{Value, json};\n\nuse super::field::{Callout, Code, Float, Hazard, Kind};\nuse super::frame::{CameraShot, SlotView, Stage, SurgeryFrame};\nuse crate::input::SurgeonInput;\n\nfn q(v: f32) -> i32 {\n    (v * 20.0).round() as i32\n}\n\nfn uq(v: i64) -> f32 {\n    v as f32 / 20.0\n}\n\nfn stage_code(s: Stage) -> u8 {\n    match s {\n        Stage::Title => 0,\n        Stage::Story => 1,\n        Stage::Chart => 2,\n        Stage::Op => 3,\n        Stage::Complete => 4,\n        Stage::Results => 5,\n        Stage::Dead => 6,\n        Stage::Done => 7,\n        Stage::Card => 8,\n    }\n}\n\nfn stage_from(c: u64) -> Stage {\n    match c {\n        1 => Stage::Story,\n        2 => Stage::Chart,\n        3 => Stage::Op,\n        4 => Stage::Complete,\n        5 => Stage::Results,\n        6 => Stage::Dead,\n        7 => Stage::Done,\n        8 => Stage::Card,\n        _ => Stage::Title,\n    }\n}\n\n/// Recent sound and effect cues, with ids so a client plays each once.\n#[derive(Clone, Copy, Debug, Default, PartialEq)]\npub struct NetCue {\n    pub serial: u32,\n    pub id: u16,\n    pub at: Vec2,\n    pub gain: f32,\n    pub pitch: f32,\n}\n\n/// The host's snapshot of a frame.\npub fn encode(f: &SurgeryFrame, cues: &[NetCue]) -> Value {\n    let hz: Vec<Value> = f\n        .hazards\n        .iter()\n        .take(40)\n        .map(|h| {\n            json!([\n                h.id,\n                h.kind as u8,\n                q(h.a.x),\n                q(h.a.y),\n                q(h.b.x),\n                q(h.b.y),\n                q(h.c.x),\n                q(h.c.y),\n                q(h.r),\n                (h.prog * 100.0) as i32,\n                h.stage,\n                h.sub,\n                (h.ang * 100.0) as i32,\n                if h.visible() { 1 } else { 0 },\n                (h.fill * 100.0) as i32,\n                h.n,\n                h.need,\n                u8::from(h.telegraph)\n            ])\n        })\n        .collect();\n    let slots: Vec<Value> = f\n        .slots\n        .iter()\n        .map(|s| {\n            json!([\n                u8::from(s.active),\n                q(s.cursor.x),\n                q(s.cursor.y),\n                s.tool,\n                s.ring_pos,\n                u8::from(s.using),\n                s.eng,\n                (s.meter * 100.0) as i32,\n                s.score,\n                s.chain,\n                s.gift as i32,\n                s.gift_kind,\n                u8::from(s.arming),\n                (s.flow * 10.0) as i32,\n                (s.charge * 100.0) as i32\n            ])\n        })\n        .collect();\n    let floats: Vec<Value> = f.floats.iter().map(|x| json!([q(x.at.x), q(x.at.y), x.rating, u8::from(x.on_beat), x.slot, (x.age * 10.0) as i32])).collect();\n    let cue_list: Vec<Value> =\n        cues.iter().map(|c| json!([c.serial, c.id, q(c.at.x), q(c.at.y), (c.gain * 20.0) as i32, (c.pitch * 20.0) as i32])).collect();\n    let mut o = json!({\n        \"t\": \"s\",\n        \"st\": stage_code(f.stage),\n        \"v\": (f.vitals * 10.0) as i32,\n        \"b\": (f.bpm) as i32,\n        \"p\": (f.beat * 100.0) as i32,\n        \"n\": f.beats,\n        \"m\": f.meter,\n        \"br\": f.bar,\n        \"tm\": f.timer as i32,\n        \"tx\": f.timer_max as i32,\n        \"pl\": f.plate,\n        \"ph\": f.phase,\n        \"h\": hz,\n        \"s\": slots,\n        \"r\": f.ring,\n        \"c\": cue_list,\n        \"f\": floats,\n    });\n    let map = o.as_object_mut().unwrap();\n    if let Some(v) = f.fever {\n        map.insert(\"fv\".into(), json!(v as i32));\n    }\n    if let Some(v) = f.heat_ring {\n        map.insert(\"hr\".into(), json!(q(v)));\n    }\n    if f.stopped {\n        map.insert(\"x\".into(), json!(1));\n    }\n    if let Some(c) = &f.code {\n        map.insert(\"cd\".into(), json!([(c.left * 10.0) as i32, (c.ghost * 100.0) as i32, c.shocks]));\n    }\n    if !f.banner.is_empty() && f.banner_t < 1.5 {\n        map.insert(\"bn\".into(), json!(f.banner));\n    }\n    if let Some(c) = &f.callout {\n        map.insert(\"cl\".into(), json!([c.who, c.text]));\n    }\n    if !f.now.is_empty() {\n        map.insert(\"nw\".into(), json!(f.now));\n    }\n    o\n}\n\nfn arr(v: &Value, k: usize) -> i64 {\n    v.get(k).and_then(|x| x.as_i64()).unwrap_or(0)\n}\n\n/// A client's frame from a host's snapshot. `previous` carries what a snapshot leaves out.\npub fn decode(v: &Value) -> Option<SurgeryFrame> {\n    if v.get(\"t\")?.as_str()? != \"s\" {\n        return None;\n    }\n    let num = |k: &str| v.get(k).and_then(|x| x.as_i64()).unwrap_or(0);\n    let mut f = SurgeryFrame {\n        stage: stage_from(num(\"st\") as u64),\n        vitals: num(\"v\") as f32 / 10.0,\n        bpm: num(\"b\") as f32,\n        beat: num(\"p\") as f32 / 100.0,\n        beats: num(\"n\") as u32,\n        meter: num(\"m\") as u8,\n        bar: num(\"br\") as u8,\n        timer: num(\"tm\") as f32,\n        timer_max: num(\"tx\") as f32,\n        plate: num(\"pl\") as u8,\n        plate_prev: num(\"pl\") as u8,\n        phase: num(\"ph\") as u16,\n        reveal: 1.0,\n        time_scale: 1.0,\n        case: super::content::CODE_BLUE as u8,\n        stopped: v.get(\"x\").is_some(),\n        camera: CameraShot::field(),\n        fever: v.get(\"fv\").and_then(|x| x.as_f64()).map(|x| x as f32),\n        heat_ring: v.get(\"hr\").and_then(|x| x.as_i64()).map(uq),\n        banner: v.get(\"bn\").and_then(|x| x.as_str()).unwrap_or(\"\").to_string(),\n        now: v.get(\"nw\").and_then(|x| x.as_str()).unwrap_or(\"\").to_string(),\n        ..Default::default()\n    };\n    if let Some(list) = v.get(\"h\").and_then(|x| x.as_array()) {\n        f.hazards = list\n            .iter()\n            .map(|h| Hazard {\n                id: arr(h, 0) as u32,\n                kind: Kind::from_u8(arr(h, 1) as u8),\n                a: Vec2::new(uq(arr(h, 2)), uq(arr(h, 3))),\n                b: Vec2::new(uq(arr(h, 4)), uq(arr(h, 5))),\n                c: Vec2::new(uq(arr(h, 6)), uq(arr(h, 7))),\n                r: uq(arr(h, 8)),\n                prog: arr(h, 9) as f32 / 100.0,\n                stage: arr(h, 10) as u8,\n                sub: arr(h, 11) as u8,\n                ang: arr(h, 12) as f32 / 100.0,\n                hidden: arr(h, 13) == 0,\n                fill: arr(h, 14) as f32 / 100.0,\n                n: arr(h, 15) as u16,\n                need: arr(h, 16) as u16,\n                telegraph: arr(h, 17) != 0,\n                ..Default::default()\n            })\n            .collect();\n    }\n    if let Some(list) = v.get(\"s\").and_then(|x| x.as_array()) {\n        f.slots = list\n            .iter()\n            .map(|s| SlotView {\n                active: arr(s, 0) != 0,\n                cursor: Vec2::new(uq(arr(s, 1)), uq(arr(s, 2))),\n                tool: arr(s, 3) as u8,\n                ring_pos: arr(s, 4) as u8,\n                using: arr(s, 5) != 0,\n                eng: arr(s, 6) as u8,\n                meter: arr(s, 7) as f32 / 100.0,\n                score: arr(s, 8),\n                chain: arr(s, 9) as u32,\n                gift: arr(s, 10) as f32,\n                gift_kind: arr(s, 11) as u8,\n                arming: arr(s, 12) != 0,\n                flow: arr(s, 13) as f32 / 10.0,\n                charge: arr(s, 14) as f32 / 100.0,\n                ..Default::default()\n            })\n            .collect();\n    }\n    if let Some(list) = v.get(\"r\").and_then(|x| x.as_array()) {\n        for (k, t) in list.iter().enumerate().take(8) {\n            f.ring[k] = t.as_u64().unwrap_or(0) as u8;\n        }\n    }\n    if let Some(c) = v.get(\"cd\").and_then(|x| x.as_array()) {\n        f.code = Some(Code {\n            left: c.first().and_then(|x| x.as_i64()).unwrap_or(0) as f32 / 10.0,\n            window: 5.0,\n            ghost: c.get(1).and_then(|x| x.as_i64()).unwrap_or(0) as f32 / 100.0,\n            shocks: c.get(2).and_then(|x| x.as_i64()).unwrap_or(0) as u8,\n            ..Default::default()\n        });\n    }\n    if let Some(c) = v.get(\"cl\").and_then(|x| x.as_array()) {\n        f.callout = Some(Callout {\n            who: c.first().and_then(|x| x.as_str()).unwrap_or(\"\").into(),\n            text: c.get(1).and_then(|x| x.as_str()).unwrap_or(\"\").into(),\n            age: 0.0,\n        });\n    }\n    if let Some(list) = v.get(\"f\").and_then(|x| x.as_array()) {\n        f.floats = list\n            .iter()\n            .map(|x| {\n                let rating = arr(x, 2) as u8;\n                Float {\n                    at: Vec2::new(uq(arr(x, 0)), uq(arr(x, 1))),\n                    text: super::field::Rating::from_u8(rating).name().to_string(),\n                    rating,\n                    on_beat: arr(x, 3) != 0,\n                    slot: arr(x, 4) as u8,\n                    age: arr(x, 5) as f32 / 10.0,\n                }\n            })\n            .collect();\n    }\n    Some(f)\n}\n\n/// The cue list of a snapshot.\npub fn decode_cues(v: &Value) -> Vec<NetCue> {\n    v.get(\"c\")\n        .and_then(|x| x.as_array())\n        .map(|list| {\n            list.iter()\n                .map(|c| NetCue {\n                    serial: arr(c, 0) as u32,\n                    id: arr(c, 1) as u16,\n                    at: Vec2::new(uq(arr(c, 2)), uq(arr(c, 3))),\n                    gain: arr(c, 4) as f32 / 20.0,\n                    pitch: arr(c, 5) as f32 / 20.0,\n                })\n                .collect()\n        })\n        .unwrap_or_default()\n}\n\n/// A client's input message. Tool changes and button edges repeat until the host has seen them.\npub fn encode_input(inp: &SurgeonInput) -> Value {\n    json!({\n        \"t\": \"i\",\n        \"a\": [q(inp.aim.x), q(inp.aim.y)],\n        \"r\": u8::from(inp.abs),\n        \"h\": inp.held,\n        \"e\": inp.pressed,\n        \"o\": inp.tool,\n        \"c\": inp.cycle,\n        \"p\": (inp.pressure * 20.0) as i32,\n    })\n}\n\npub fn decode_input(v: &Value) -> Option<SurgeonInput> {\n    if v.get(\"t\")?.as_str()? != \"i\" {\n        return None;\n    }\n    let a = v.get(\"a\")?.as_array()?;\n    let num = |k: &str| v.get(k).and_then(|x| x.as_i64()).unwrap_or(0);\n    Some(SurgeonInput {\n        active: true,\n        abs: num(\"r\") != 0,\n        aim: Vec2::new(uq(a.first()?.as_i64()?), uq(a.get(1)?.as_i64()?)),\n        held: num(\"h\") as u8,\n        pressed: num(\"e\") as u8,\n        tool: num(\"o\") as u8,\n        cycle: num(\"c\") as i8,\n        pressure: num(\"p\") as f32 / 20.0,\n    })\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn snapshots_round_trip_their_numbers() {\n        let mut f = SurgeryFrame { vitals: 73.5, bpm: 96.0, ..Default::default() };\n        f.hazards.push(Hazard { id: 3, kind: Kind::Lacer, a: Vec2::new(1.0, -2.0), r: 0.5, n: 1, need: 4, ..Default::default() });\n        f.slots.push(SlotView { active: true, cursor: Vec2::new(2.5, 1.0), score: 900, ..Default::default() });\n        let v = encode(&f, &[NetCue { serial: 9, id: 3, at: Vec2::ZERO, gain: 1.0, pitch: 1.0 }]);\n        let g = decode(&v).unwrap();\n        assert!((g.vitals - 73.5).abs() < 0.11);\n        assert_eq!(g.hazards[0].kind, Kind::Lacer);\n        assert_eq!(g.hazards[0].need, 4);\n        assert_eq!(g.slots[0].score, 900);\n        assert_eq!(decode_cues(&v)[0].serial, 9);\n        let i = SurgeonInput { active: true, abs: true, aim: Vec2::new(1.0, 2.0), held: 3, pressed: 1, tool: 2, cycle: 0, pressure: 0.5 };\n        assert_eq!(decode_input(&encode_input(&i)).unwrap(), i);\n    }\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14457,"cache_read_input_tokens":309494,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14457},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"cefa31f0-539b-449c-a031-3b196a7c9b80","timestamp":"2026-11-05T14:42:15.967Z","request_id":"req_011CgjxJAKUSukQo2sSdrwXU","wire_tool_inputs":{"toolu_01FATDY1z5DSnZCpfn4qreH1":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery/net.rs","content":"//! The hub's network: one compact snapshot from the host's frame, about 15 times a second, and\n//! each client's input back to the host. JSON with quantised numbers; under 1,200 bytes when it\n//! can be. A client decodes a snapshot back into a `SurgeryFrame`, the single source of everything\n//! drawn, so a mirror draws what a host draws.\n\nuse glam::Vec2;\nuse serde_json::{Value, json};\n\nuse super::field::{Callout, Code, Float, Hazard, Kind};\nuse super::frame::{CameraShot, SlotView, Stage, SurgeryFrame};\nuse crate::input::SurgeonInput;\n\nfn q(v: f32) -> i32 {\n    (v * 20.0).round() as i32\n}\n\nfn uq(v: i64) -> f32 {\n    v as f32 / 20.0\n}\n\nfn stage_code(s: Stage) -> u8 {\n    match s {\n        Stage::Title => 0,\n        Stage::Story => 1,\n        Stage::Chart => 2,\n        Stage::Op => 3,\n        Stage::Complete => 4,\n        Stage::Results => 5,\n        Stage::Dead => 6,\n        Stage::Done => 7,\n        Stage::Card => 8,\n    }\n}\n\nfn stage_from(c: u64) -> Stage {\n    match c {\n        1 => Stage::Story,\n        2 => Stage::Chart,\n        3 => Stage::Op,\n        4 => Stage::Complete,\n        5 => Stage::Results,\n        6 => Stage::Dead,\n        7 => Stage::Done,\n        8 => Stage::Card,\n        _ => Stage::Title,\n    }\n}\n\n/// Recent sound and effect cues, with ids so a client plays each once.\n#[derive(Clone, Copy, Debug, Default, PartialEq)]\npub struct NetCue {\n    pub serial: u32,\n    pub id: u16,\n    pub at: Vec2,\n    pub gain: f32,\n    pub pitch: f32,\n}\n\n/// The host's snapshot of a frame.\npub fn encode(f: &SurgeryFrame, cues: &[NetCue]) -> Value {\n    let hz: Vec<Value> = f\n        .hazards\n        .iter()\n        .take(40)\n        .map(|h| {\n            json!([\n                h.id,\n                h.kind as u8,\n                q(h.a.x),\n                q(h.a.y),\n                q(h.b.x),\n                q(h.b.y),\n                q(h.c.x),\n                q(h.c.y),\n                q(h.r),\n                (h.prog * 100.0) as i32,\n                h.stage,\n                h.sub,\n                (h.ang * 100.0) as i32,\n                if h.visible() { 1 } else { 0 },\n                (h.fill * 100.0) as i32,\n                h.n,\n                h.need,\n                u8::from(h.telegraph)\n            ])\n        })\n        .collect();\n    let slots: Vec<Value> = f\n        .slots\n        .iter()\n        .map(|s| {\n            json!([\n                u8::from(s.active),\n                q(s.cursor.x),\n                q(s.cursor.y),\n                s.tool,\n                s.ring_pos,\n                u8::from(s.using),\n                s.eng,\n                (s.meter * 100.0) as i32,\n                s.score,\n                s.chain,\n                s.gift as i32,\n                s.gift_kind,\n                u8::from(s.arming),\n                (s.flow * 10.0) as i32,\n                (s.charge * 100.0) as i32\n            ])\n        })\n        .collect();\n    let floats: Vec<Value> = f.floats.iter().map(|x| json!([q(x.at.x), q(x.at.y), x.rating, u8::from(x.on_beat), x.slot, (x.age * 10.0) as i32])).collect();\n    let cue_list: Vec<Value> =\n        cues.iter().map(|c| json!([c.serial, c.id, q(c.at.x), q(c.at.y), (c.gain * 20.0) as i32, (c.pitch * 20.0) as i32])).collect();\n    let mut o = json!({\n        \"t\": \"s\",\n        \"st\": stage_code(f.stage),\n        \"v\": (f.vitals * 10.0) as i32,\n        \"b\": (f.bpm) as i32,\n        \"p\": (f.beat * 100.0) as i32,\n        \"n\": f.beats,\n        \"m\": f.meter,\n        \"br\": f.bar,\n        \"tm\": f.timer as i32,\n        \"tx\": f.timer_max as i32,\n        \"pl\": f.plate,\n        \"ph\": f.phase,\n        \"h\": hz,\n        \"s\": slots,\n        \"r\": f.ring,\n        \"c\": cue_list,\n        \"f\": floats,\n    });\n    let map = o.as_object_mut().unwrap();\n    if let Some(v) = f.fever {\n        map.insert(\"fv\".into(), json!(v as i32));\n    }\n    if let Some(v) = f.heat_ring {\n        map.insert(\"hr\".into(), json!(q(v)));\n    }\n    if f.stopped {\n        map.insert(\"x\".into(), json!(1));\n    }\n    if let Some(c) = &f.code {\n        map.insert(\"cd\".into(), json!([(c.left * 10.0) as i32, (c.ghost * 100.0) as i32, c.shocks]));\n    }\n    if !f.banner.is_empty() && f.banner_t < 1.5 {\n        map.insert(\"bn\".into(), json!(f.banner));\n    }\n    if let Some(c) = &f.callout {\n        map.insert(\"cl\".into(), json!([c.who, c.text]));\n    }\n    if !f.now.is_empty() {\n        map.insert(\"nw\".into(), json!(f.now));\n    }\n    o\n}\n\nfn arr(v: &Value, k: usize) -> i64 {\n    v.get(k).and_then(|x| x.as_i64()).unwrap_or(0)\n}\n\n/// A client's frame from a host's snapshot. `previous` carries what a snapshot leaves out.\npub fn decode(v: &Value) -> Option<SurgeryFrame> {\n    if v.get(\"t\")?.as_str()? != \"s\" {\n        return None;\n    }\n    let num = |k: &str| v.get(k).and_then(|x| x.as_i64()).unwrap_or(0);\n    let mut f = SurgeryFrame {\n        stage: stage_from(num(\"st\") as u64),\n        vitals: num(\"v\") as f32 / 10.0,\n        bpm: num(\"b\") as f32,\n        beat: num(\"p\") as f32 / 100.0,\n        beats: num(\"n\") as u32,\n        meter: num(\"m\") as u8,\n        bar: num(\"br\") as u8,\n        timer: num(\"tm\") as f32,\n        timer_max: num(\"tx\") as f32,\n        plate: num(\"pl\") as u8,\n        plate_prev: num(\"pl\") as u8,\n        phase: num(\"ph\") as u16,\n        reveal: 1.0,\n        time_scale: 1.0,\n        case: super::content::CODE_BLUE as u8,\n        stopped: v.get(\"x\").is_some(),\n        camera: CameraShot::field(),\n        fever: v.get(\"fv\").and_then(|x| x.as_f64()).map(|x| x as f32),\n        heat_ring: v.get(\"hr\").and_then(|x| x.as_i64()).map(uq),\n        banner: v.get(\"bn\").and_then(|x| x.as_str()).unwrap_or(\"\").to_string(),\n        now: v.get(\"nw\").and_then(|x| x.as_str()).unwrap_or(\"\").to_string(),\n        ..Default::default()\n    };\n    if let Some(list) = v.get(\"h\").and_then(|x| x.as_array()) {\n        f.hazards = list\n            .iter()\n            .map(|h| Hazard {\n                id: arr(h, 0) as u32,\n                kind: Kind::from_u8(arr(h, 1) as u8),\n                a: Vec2::new(uq(arr(h, 2)), uq(arr(h, 3))),\n                b: Vec2::new(uq(arr(h, 4)), uq(arr(h, 5))),\n                c: Vec2::new(uq(arr(h, 6)), uq(arr(h, 7))),\n                r: uq(arr(h, 8)),\n                prog: arr(h, 9) as f32 / 100.0,\n                stage: arr(h, 10) as u8,\n                sub: arr(h, 11) as u8,\n                ang: arr(h, 12) as f32 / 100.0,\n                hidden: arr(h, 13) == 0,\n                fill: arr(h, 14) as f32 / 100.0,\n                n: arr(h, 15) as u16,\n                need: arr(h, 16) as u16,\n                telegraph: arr(h, 17) != 0,\n                ..Default::default()\n            })\n            .collect();\n    }\n    if let Some(list) = v.get(\"s\").and_then(|x| x.as_array()) {\n        f.slots = list\n            .iter()\n            .map(|s| SlotView {\n                active: arr(s, 0) != 0,\n                cursor: Vec2::new(uq(arr(s, 1)), uq(arr(s, 2))),\n                tool: arr(s, 3) as u8,\n                ring_pos: arr(s, 4) as u8,\n                using: arr(s, 5) != 0,\n                eng: arr(s, 6) as u8,\n                meter: arr(s, 7) as f32 / 100.0,\n                score: arr(s, 8),\n                chain: arr(s, 9) as u32,\n                gift: arr(s, 10) as f32,\n                gift_kind: arr(s, 11) as u8,\n                arming: arr(s, 12) != 0,\n                flow: arr(s, 13) as f32 / 10.0,\n                charge: arr(s, 14) as f32 / 100.0,\n                ..Default::default()\n            })\n            .collect();\n    }\n    if let Some(list) = v.get(\"r\").and_then(|x| x.as_array()) {\n        for (k, t) in list.iter().enumerate().take(8) {\n            f.ring[k] = t.as_u64().unwrap_or(0) as u8;\n        }\n    }\n    if let Some(c) = v.get(\"cd\").and_then(|x| x.as_array()) {\n        f.code = Some(Code {\n            left: c.first().and_then(|x| x.as_i64()).unwrap_or(0) as f32 / 10.0,\n            window: 5.0,\n            ghost: c.get(1).and_then(|x| x.as_i64()).unwrap_or(0) as f32 / 100.0,\n            shocks: c.get(2).and_then(|x| x.as_i64()).unwrap_or(0) as u8,\n            ..Default::default()\n        });\n    }\n    if let Some(c) = v.get(\"cl\").and_then(|x| x.as_array()) {\n        f.callout = Some(Callout {\n            who: c.first().and_then(|x| x.as_str()).unwrap_or(\"\").into(),\n            text: c.get(1).and_then(|x| x.as_str()).unwrap_or(\"\").into(),\n            age: 0.0,\n        });\n    }\n    if let Some(list) = v.get(\"f\").and_then(|x| x.as_array()) {\n        f.floats = list\n            .iter()\n            .map(|x| {\n                let rating = arr(x, 2) as u8;\n                Float {\n                    at: Vec2::new(uq(arr(x, 0)), uq(arr(x, 1))),\n                    text: super::field::Rating::from_u8(rating).name().to_string(),\n                    rating,\n                    on_beat: arr(x, 3) != 0,\n                    slot: arr(x, 4) as u8,\n                    age: arr(x, 5) as f32 / 10.0,\n                }\n            })\n            .collect();\n    }\n    Some(f)\n}\n\n/// The cue list of a snapshot.\npub fn decode_cues(v: &Value) -> Vec<NetCue> {\n    v.get(\"c\")\n        .and_then(|x| x.as_array())\n        .map(|list| {\n            list.iter()\n                .map(|c| NetCue {\n                    serial: arr(c, 0) as u32,\n                    id: arr(c, 1) as u16,\n                    at: Vec2::new(uq(arr(c, 2)), uq(arr(c, 3))),\n                    gain: arr(c, 4) as f32 / 20.0,\n                    pitch: arr(c, 5) as f32 / 20.0,\n                })\n                .collect()\n        })\n        .unwrap_or_default()\n}\n\n/// A client's input message. Tool changes and button edges repeat until the host has seen them.\npub fn encode_input(inp: &SurgeonInput) -> Value {\n    json!({\n        \"t\": \"i\",\n        \"a\": [q(inp.aim.x), q(inp.aim.y)],\n        \"r\": u8::from(inp.abs),\n        \"h\": inp.held,\n        \"e\": inp.pressed,\n        \"o\": inp.tool,\n        \"c\": inp.cycle,\n        \"p\": (inp.pressure * 20.0) as i32,\n    })\n}\n\npub fn decode_input(v: &Value) -> Option<SurgeonInput> {\n    if v.get(\"t\")?.as_str()? != \"i\" {\n        return None;\n    }\n    let a = v.get(\"a\")?.as_array()?;\n    let num = |k: &str| v.get(k).and_then(|x| x.as_i64()).unwrap_or(0);\n    Some(SurgeonInput {\n        active: true,\n        abs: num(\"r\") != 0,\n        aim: Vec2::new(uq(a.first()?.as_i64()?), uq(a.get(1)?.as_i64()?)),\n        held: num(\"h\") as u8,\n        pressed: num(\"e\") as u8,\n        tool: num(\"o\") as u8,\n        cycle: num(\"c\") as i8,\n        pressure: num(\"p\") as f32 / 20.0,\n    })\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn snapshots_round_trip_their_numbers() {\n        let mut f = SurgeryFrame { vitals: 73.5, bpm: 96.0, ..Default::default() };\n        f.hazards.push(Hazard { id: 3, kind: Kind::Lacer, a: Vec2::new(1.0, -2.0), r: 0.5, n: 1, need: 4, ..Default::default() });\n        f.slots.push(SlotView { active: true, cursor: Vec2::new(2.5, 1.0), score: 900, ..Default::default() });\n        let v = encode(&f, &[NetCue { serial: 9, id: 3, at: Vec2::ZERO, gain: 1.0, pitch: 1.0 }]);\n        let g = decode(&v).unwrap();\n        assert!((g.vitals - 73.5).abs() < 0.11);\n        assert_eq!(g.hazards[0].kind, Kind::Lacer);\n        assert_eq!(g.hazards[0].need, 4);\n        assert_eq!(g.slots[0].score, 900);\n        assert_eq!(decode_cues(&v)[0].serial, 9);\n        let i = SurgeonInput { active: true, abs: true, aim: Vec2::new(1.0, 2.0), held: 3, pressed: 1, tool: 2, cycle: 0, pressure: 0.5 };\n        assert_eq!(decode_input(&encode_input(&i)).unwrap(), i);\n    }\n}\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FATDY1z5DSnZCpfn4qreH1","type":"tool_result","content":"File created successfully at: /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery/net.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"cf863e61-2aa4-4b46-9976-9ec5a7822203","timestamp":"2026-11-05T14:42:16.015Z","tool_use_result":{"type":"create","filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery/net.rs","content":"//! The hub's network: one compact snapshot from the host's frame, about 15 times a second, and\n//! each client's input back to the host. JSON with quantised numbers; under 1,200 bytes when it\n//! can be. A client decodes a snapshot back into a `SurgeryFrame`, the single source of everything\n//! drawn, so a mirror draws what a host draws.\n\nuse glam::Vec2;\nuse serde_json::{Value, json};\n\nuse super::field::{Callout, Code, Float, Hazard, Kind};\nuse super::frame::{CameraShot, SlotView, Stage, SurgeryFrame};\nuse crate::input::SurgeonInput;\n\nfn q(v: f32) -> i32 {\n    (v * 20.0).round() as i32\n}\n\nfn uq(v: i64) -> f32 {\n    v as f32 / 20.0\n}\n\nfn stage_code(s: Stage) -> u8 {\n    match s {\n        Stage::Title => 0,\n        Stage::Story => 1,\n        Stage::Chart => 2,\n        Stage::Op => 3,\n        Stage::Complete => 4,\n        Stage::Results => 5,\n        Stage::Dead => 6,\n        Stage::Done => 7,\n        Stage::Card => 8,\n    }\n}\n\nfn stage_from(c: u64) -> Stage {\n    match c {\n        1 => Stage::Story,\n        2 => Stage::Chart,\n        3 => Stage::Op,\n        4 => Stage::Complete,\n        5 => Stage::Results,\n        6 => Stage::Dead,\n        7 => Stage::Done,\n        8 => Stage::Card,\n        _ => Stage::Title,\n    }\n}\n\n/// Recent sound and effect cues, with ids so a client plays each once.\n#[derive(Clone, Copy, Debug, Default, PartialEq)]\npub struct NetCue {\n    pub serial: u32,\n    pub id: u16,\n    pub at: Vec2,\n    pub gain: f32,\n    pub pitch: f32,\n}\n\n/// The host's snapshot of a frame.\npub fn encode(f: &SurgeryFrame, cues: &[NetCue]) -> Value {\n    let hz: Vec<Value> = f\n        .hazards\n        .iter()\n        .take(40)\n        .map(|h| {\n            json!([\n                h.id,\n                h.kind as u8,\n                q(h.a.x),\n                q(h.a.y),\n                q(h.b.x),\n                q(h.b.y),\n                q(h.c.x),\n                q(h.c.y),\n                q(h.r),\n                (h.prog * 100.0) as i32,\n                h.stage,\n                h.sub,\n                (h.ang * 100.0) as i32,\n                if h.visible() { 1 } else { 0 },\n                (h.fill * 100.0) as i32,\n                h.n,\n                h.need,\n                u8::from(h.telegraph)\n            ])\n        })\n        .collect();\n    let slots: Vec<Value> = f\n        .slots\n        .iter()\n        .map(|s| {\n            json!([\n                u8::from(s.active),\n                q(s.cursor.x),\n                q(s.cursor.y),\n                s.tool,\n                s.ring_pos,\n                u8::from(s.using),\n                s.eng,\n                (s.meter * 100.0) as i32,\n                s.score,\n                s.chain,\n                s.gift as i32,\n                s.gift_kind,\n                u8::from(s.arming),\n                (s.flow * 10.0) as i32,\n                (s.charge * 100.0) as i32\n            ])\n        })\n        .collect();\n    let floats: Vec<Value> = f.floats.iter().map(|x| json!([q(x.at.x), q(x.at.y), x.rating, u8::from(x.on_beat), x.slot, (x.age * 10.0) as i32])).collect();\n    let cue_list: Vec<Value> =\n        cues.iter().map(|c| json!([c.serial, c.id, q(c.at.x), q(c.at.y), (c.gain * 20.0) as i32, (c.pitch * 20.0) as i32])).collect();\n    let mut o = json!({\n        \"t\": \"s\",\n        \"st\": stage_code(f.stage),\n        \"v\": (f.vitals * 10.0) as i32,\n        \"b\": (f.bpm) as i32,\n        \"p\": (f.beat * 100.0) as i32,\n        \"n\": f.beats,\n        \"m\": f.meter,\n        \"br\": f.bar,\n        \"tm\": f.timer as i32,\n        \"tx\": f.timer_max as i32,\n        \"pl\": f.plate,\n        \"ph\": f.phase,\n        \"h\": hz,\n        \"s\": slots,\n        \"r\": f.ring,\n        \"c\": cue_list,\n        \"f\": floats,\n    });\n    let map = o.as_object_mut().unwrap();\n    if let Some(v) = f.fever {\n        map.insert(\"fv\".into(), json!(v as i32));\n    }\n    if let Some(v) = f.heat_ring {\n        map.insert(\"hr\".into(), json!(q(v)));\n    }\n    if f.stopped {\n        map.insert(\"x\".into(), json!(1));\n    }\n    if let Some(c) = &f.code {\n        map.insert(\"cd\".into(), json!([(c.left * 10.0) as i32, (c.ghost * 100.0) as i32, c.shocks]));\n    }\n    if !f.banner.is_empty() && f.banner_t < 1.5 {\n        map.insert(\"bn\".into(), json!(f.banner));\n    }\n    if let Some(c) = &f.callout {\n        map.insert(\"cl\".into(), json!([c.who, c.text]));\n    }\n    if !f.now.is_empty() {\n        map.insert(\"nw\".into(), json!(f.now));\n    }\n    o\n}\n\nfn arr(v: &Value, k: usize) -> i64 {\n    v.get(k).and_then(|x| x.as_i64()).unwrap_or(0)\n}\n\n/// A client's frame from a host's snapshot. `previous` carries what a snapshot leaves out.\npub fn decode(v: &Value) -> Option<SurgeryFrame> {\n    if v.get(\"t\")?.as_str()? != \"s\" {\n        return None;\n    }\n    let num = |k: &str| v.get(k).and_then(|x| x.as_i64()).unwrap_or(0);\n    let mut f = SurgeryFrame {\n        stage: stage_from(num(\"st\") as u64),\n        vitals: num(\"v\") as f32 / 10.0,\n        bpm: num(\"b\") as f32,\n        beat: num(\"p\") as f32 / 100.0,\n        beats: num(\"n\") as u32,\n        meter: num(\"m\") as u8,\n        bar: num(\"br\") as u8,\n        timer: num(\"tm\") as f32,\n        timer_max: num(\"tx\") as f32,\n        plate: num(\"pl\") as u8,\n        plate_prev: num(\"pl\") as u8,\n        phase: num(\"ph\") as u16,\n        reveal: 1.0,\n        time_scale: 1.0,\n        case: super::content::CODE_BLUE as u8,\n        stopped: v.get(\"x\").is_some(),\n        camera: CameraShot::field(),\n        fever: v.get(\"fv\").and_then(|x| x.as_f64()).map(|x| x as f32),\n        heat_ring: v.get(\"hr\").and_then(|x| x.as_i64()).map(uq),\n        banner: v.get(\"bn\").and_then(|x| x.as_str()).unwrap_or(\"\").to_string(),\n        now: v.get(\"nw\").and_then(|x| x.as_str()).unwrap_or(\"\").to_string(),\n        ..Default::default()\n    };\n    if let Some(list) = v.get(\"h\").and_then(|x| x.as_array()) {\n        f.hazards = list\n            .iter()\n            .map(|h| Hazard {\n                id: arr(h, 0) as u32,\n                kind: Kind::from_u8(arr(h, 1) as u8),\n                a: Vec2::new(uq(arr(h, 2)), uq(arr(h, 3))),\n                b: Vec2::new(uq(arr(h, 4)), uq(arr(h, 5))),\n                c: Vec2::new(uq(arr(h, 6)), uq(arr(h, 7))),\n                r: uq(arr(h, 8)),\n                prog: arr(h, 9) as f32 / 100.0,\n                stage: arr(h, 10) as u8,\n                sub: arr(h, 11) as u8,\n                ang: arr(h, 12) as f32 / 100.0,\n                hidden: arr(h, 13) == 0,\n                fill: arr(h, 14) as f32 / 100.0,\n                n: arr(h, 15) as u16,\n                need: arr(h, 16) as u16,\n                telegraph: arr(h, 17) != 0,\n                ..Default::default()\n            })\n            .collect();\n    }\n    if let Some(list) = v.get(\"s\").and_then(|x| x.as_array()) {\n        f.slots = list\n            .iter()\n            .map(|s| SlotView {\n                active: arr(s, 0) != 0,\n                cursor: Vec2::new(uq(arr(s, 1)), uq(arr(s, 2))),\n                tool: arr(s, 3) as u8,\n                ring_pos: arr(s, 4) as u8,\n                using: arr(s, 5) != 0,\n                eng: arr(s, 6) as u8,\n                meter: arr(s, 7) as f32 / 100.0,\n                score: arr(s, 8),\n                chain: arr(s, 9) as u32,\n                gift: arr(s, 10) as f32,\n                gift_kind: arr(s, 11) as u8,\n                arming: arr(s, 12) != 0,\n                flow: arr(s, 13) as f32 / 10.0,\n                charge: arr(s, 14) as f32 / 100.0,\n                ..Default::default()\n            })\n            .collect();\n    }\n    if let Some(list) = v.get(\"r\").and_then(|x| x.as_array()) {\n        for (k, t) in list.iter().enumerate().take(8) {\n            f.ring[k] = t.as_u64().unwrap_or(0) as u8;\n        }\n    }\n    if let Some(c) = v.get(\"cd\").and_then(|x| x.as_array()) {\n        f.code = Some(Code {\n            left: c.first().and_then(|x| x.as_i64()).unwrap_or(0) as f32 / 10.0,\n            window: 5.0,\n            ghost: c.get(1).and_then(|x| x.as_i64()).unwrap_or(0) as f32 / 100.0,\n            shocks: c.get(2).and_then(|x| x.as_i64()).unwrap_or(0) as u8,\n            ..Default::default()\n        });\n    }\n    if let Some(c) = v.get(\"cl\").and_then(|x| x.as_array()) {\n        f.callout = Some(Callout {\n            who: c.first().and_then(|x| x.as_str()).unwrap_or(\"\").into(),\n            text: c.get(1).and_then(|x| x.as_str()).unwrap_or(\"\").into(),\n            age: 0.0,\n        });\n    }\n    if let Some(list) = v.get(\"f\").and_then(|x| x.as_array()) {\n        f.floats = list\n            .iter()\n            .map(|x| {\n                let rating = arr(x, 2) as u8;\n                Float {\n                    at: Vec2::new(uq(arr(x, 0)), uq(arr(x, 1))),\n                    text: super::field::Rating::from_u8(rating).name().to_string(),\n                    rating,\n                    on_beat: arr(x, 3) != 0,\n                    slot: arr(x, 4) as u8,\n                    age: arr(x, 5) as f32 / 10.0,\n                }\n            })\n            .collect();\n    }\n    Some(f)\n}\n\n/// The cue list of a snapshot.\npub fn decode_cues(v: &Value) -> Vec<NetCue> {\n    v.get(\"c\")\n        .and_then(|x| x.as_array())\n        .map(|list| {\n            list.iter()\n                .map(|c| NetCue {\n                    serial: arr(c, 0) as u32,\n                    id: arr(c, 1) as u16,\n                    at: Vec2::new(uq(arr(c, 2)), uq(arr(c, 3))),\n                    gain: arr(c, 4) as f32 / 20.0,\n                    pitch: arr(c, 5) as f32 / 20.0,\n                })\n                .collect()\n        })\n        .unwrap_or_default()\n}\n\n/// A client's input message. Tool changes and button edges repeat until the host has seen them.\npub fn encode_input(inp: &SurgeonInput) -> Value {\n    json!({\n        \"t\": \"i\",\n        \"a\": [q(inp.aim.x), q(inp.aim.y)],\n        \"r\": u8::from(inp.abs),\n        \"h\": inp.held,\n        \"e\": inp.pressed,\n        \"o\": inp.tool,\n        \"c\": inp.cycle,\n        \"p\": (inp.pressure * 20.0) as i32,\n    })\n}\n\npub fn decode_input(v: &Value) -> Option<SurgeonInput> {\n    if v.get(\"t\")?.as_str()? != \"i\" {\n        return None;\n    }\n    let a = v.get(\"a\")?.as_array()?;\n    let num = |k: &str| v.get(k).and_then(|x| x.as_i64()).unwrap_or(0);\n    Some(SurgeonInput {\n        active: true,\n        abs: num(\"r\") != 0,\n        aim: Vec2::new(uq(a.first()?.as_i64()?), uq(a.get(1)?.as_i64()?)),\n        held: num(\"h\") as u8,\n        pressed: num(\"e\") as u8,\n        tool: num(\"o\") as u8,\n        cycle: num(\"c\") as i8,\n        pressure: num(\"p\") as f32 / 20.0,\n    })\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn snapshots_round_trip_their_numbers() {\n        let mut f = SurgeryFrame { vitals: 73.5, bpm: 96.0, ..Default::default() };\n        f.hazards.push(Hazard { id: 3, kind: Kind::Lacer, a: Vec2::new(1.0, -2.0), r: 0.5, n: 1, need: 4, ..Default::default() });\n        f.slots.push(SlotView { active: true, cursor: Vec2::new(2.5, 1.0), score: 900, ..Default::default() });\n        let v = encode(&f, &[NetCue { serial: 9, id: 3, at: Vec2::ZERO, gain: 1.0, pitch: 1.0 }]);\n        let g = decode(&v).unwrap();\n        assert!((g.vitals - 73.5).abs() < 0.11);\n        assert_eq!(g.hazards[0].kind, Kind::Lacer);\n        assert_eq!(g.hazards[0].need, 4);\n        assert_eq!(g.slots[0].score, 900);\n        assert_eq!(decode_cues(&v)[0].serial, 9);\n        let i = SurgeonInput { active: true, abs: true, aim: Vec2::new(1.0, 2.0), held: 3, pressed: 1, tool: 2, cycle: 0, pressure: 0.5 };\n        assert_eq!(decode_input(&encode_input(&i)).unwrap(), i);\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01FATDY1z5DSnZCpfn4qreH1","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
