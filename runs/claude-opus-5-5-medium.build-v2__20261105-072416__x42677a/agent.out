{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjzKQaj1SJBW8Jc33kaG","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LaRPvzHBwxuG4PnNTTrvwi","name":"Bash","input":{"command":"mkdir -p crates/pav_ui/src/surgery crates/pav_ui/assets; curl -sSfL -o crates/pav_ui/assets/BarlowCondensed-SemiBold.ttf https://github.com/google/fonts/raw/main/ofl/barlowcondensed/BarlowCondensed-SemiBold.ttf && ls -la crates/pav_ui/assets; file crates/pav_ui/assets/*.ttf | cut -c1-120\nsed -i 's/^web-time.workspace = true$/web-time.workspace = true\\nserde_json.workspace = true/' crates/pav_ui/Cargo.toml\ncat > crates/pav_ui/src/surgery/style.rs <<'EOF'\n//! 10-foot style: one embedded font, big outlined text, and the painter helpers every screen uses.\n\nuse egui::{Align2, Color32, FontData, FontDefinitions, FontFamily, FontId, Painter, Pos2, Rect, Stroke, StrokeKind, Vec2, pos2, vec2};\n\npub const FONT: &[u8] = include_bytes!(\"../../assets/BarlowCondensed-SemiBold.ttf\");\n\npub const INK: Color32 = Color32::from_rgb(8, 14, 18);\npub const PANEL: Color32 = Color32::from_rgba_premultiplied(9, 20, 24, 225);\npub const TEAL: Color32 = Color32::from_rgb(46, 150, 146);\npub const TEAL_L: Color32 = Color32::from_rgb(120, 226, 214);\npub const WHITE: Color32 = Color32::from_rgb(240, 244, 240);\npub const DIM: Color32 = Color32::from_rgb(160, 176, 176);\npub const RED: Color32 = Color32::from_rgb(232, 68, 58);\npub const GOLD: Color32 = Color32::from_rgb(245, 200, 90);\npub const GREEN: Color32 = Color32::from_rgb(110, 230, 150);\n\n/// Puts the game's font in front of egui's.\npub fn install(ctx: &egui::Context) {\n    let mut f = FontDefinitions::default();\n    f.font_data.insert(\"barlow\".to_owned(), FontData::from_static(FONT).into());\n    f.families.entry(FontFamily::Proportional).or_default().insert(0, \"barlow\".to_owned());\n    ctx.set_fonts(f);\n}\n\n/// The virtual canvas: the screen is 1080 points tall, whatever the window.\npub fn zoom_for(height_px: f32, scale_factor: f32) -> f32 {\n    height_px.max(1.0) / 1080.0 / scale_factor.max(0.1)\n}\n\n/// Text with a dark outline, readable at ten feet over anything.\npub fn text(p: &Painter, at: Pos2, align: Align2, s: &str, size: f32, color: Color32) -> Rect {\n    let id = FontId::proportional(size);\n    let o = (size * 0.045).clamp(1.5, 4.0);\n    for d in [vec2(-o, 0.0), vec2(o, 0.0), vec2(0.0, -o), vec2(0.0, o), vec2(-o, -o), vec2(o, -o), vec2(-o, o), vec2(o, o)] {\n        p.text(at + d, align, s, id.clone(), INK.linear_multiply(color.a() as f32 / 255.0));\n    }\n    p.text(at, align, s, id, color)\n}\n\n/// Wrapped text; returns its height.\npub fn wrapped(p: &Painter, at: Pos2, s: &str, size: f32, color: Color32, width: f32) -> f32 {\n    let g = p.layout(s.to_string(), FontId::proportional(size), color, width);\n    let h = g.size().y;\n    p.galley(at, g, color);\n    h\n}\n\npub fn card(p: &Painter, r: Rect, fill: Color32, edge: Color32) {\n    p.rect_filled(r, 14.0, fill);\n    p.rect_stroke(r, 14.0, Stroke::new(3.0, edge), StrokeKind::Inside);\n}\n\n/// A meter: `v` in 0..1.\npub fn bar(p: &Painter, r: Rect, v: f32, fill: Color32) {\n    p.rect_filled(r, r.height() * 0.3, Color32::from_rgba_unmultiplied(0, 0, 0, 170));\n    let w = r.width() * v.clamp(0.0, 1.0);\n    if w > 1.0 {\n        p.rect_filled(Rect::from_min_size(r.min, vec2(w, r.height())), r.height() * 0.3, fill);\n    }\n    p.rect_stroke(r, r.height() * 0.3, Stroke::new(2.0, Color32::from_rgba_unmultiplied(255, 255, 255, 90)), StrokeKind::Outside);\n}\n\npub fn arc(p: &Painter, c: Pos2, r: f32, from: f32, to: f32, stroke: Stroke) {\n    let n = ((to - from).abs() * r / 6.0).ceil().max(3.0) as usize;\n    let pts: Vec<Pos2> = (0..=n)\n        .map(|k| {\n            let a = from + (to - from) * k as f32 / n as f32;\n            c + Vec2::angled(a) * r\n        })\n        .collect();\n    p.add(egui::Shape::line(pts, stroke));\n}\n\npub fn lerp_color(a: Color32, b: Color32, t: f32) -> Color32 {\n    let t = t.clamp(0.0, 1.0);\n    let m = |x: u8, y: u8| (x as f32 + (y as f32 - x as f32) * t) as u8;\n    Color32::from_rgba_unmultiplied(m(a.r(), b.r()), m(a.g(), b.g()), m(a.b(), b.b()), m(a.a(), b.a()))\n}\n\npub fn seat_color(i: usize) -> Color32 {\n    [Color32::from_rgb(0xe8, 0x44, 0x3a), Color32::from_rgb(0x3b, 0x82, 0xf6), Color32::from_rgb(0x22, 0xc5, 0x5e), Color32::from_rgb(0xf5, 0xb7, 0x00)][i % 4]\n}\n\npub fn center(r: Rect) -> Pos2 {\n    r.center()\n}\n\npub fn full(ctx: &egui::Context) -> Rect {\n    let r = ctx.content_rect();\n    Rect::from_min_size(pos2(0.0, 0.0), r.size())\n}\nEOF\ncat > crates/pav_ui/src/surgery/glyphs.rs <<'EOF'\n//! One `prompt(action)` helper draws the glyph for the device used last: PlayStation shapes in their\n//! colours, or Xbox letters if Settings says so, or keycaps and mouse buttons. It flips the moment\n//! the player touches another device.\n\nuse egui::{Align2, Color32, FontId, Painter, Pos2, Rect, Stroke, StrokeKind, pos2, vec2};\n\nuse crate::Device;\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Action {\n    Confirm,\n    Back,\n    Use,\n    Gift,\n    Chart,\n    Precision,\n    Cancel,\n    Pause,\n    Defib,\n    Aim,\n    Pick,\n    Rotate,\n    Nav,\n    Tabs,\n    Skip,\n    Ready,\n    More,\n    Join,\n    /// A ring direction or digit.\n    Ring(u8),\n}\n\n/// What it draws: an identifier for tests (`ps:cross`, `xb:a`, `key:enter`, `mouse:left`).\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Glyph {\n    Cross,\n    Circle,\n    Square,\n    Triangle,\n    Pill(&'static str),\n    Stick(&'static str),\n    Letter(&'static str, Color32),\n    Key(&'static str),\n    Mouse(&'static str),\n    Dir(u8),\n}\n\npub fn glyphs_for(action: Action, device: Device, xbox: bool) -> Vec<Glyph> {\n    use Action as A;\n    use Glyph as G;\n    let (a, b, x, y) = (\n        G::Letter(\"A\", Color32::from_rgb(90, 190, 80)),\n        G::Letter(\"B\", Color32::from_rgb(220, 70, 60)),\n        G::Letter(\"X\", Color32::from_rgb(70, 130, 230)),\n        G::Letter(\"Y\", Color32::from_rgb(235, 190, 60)),\n    );\n    match device {\n        Device::Gamepad | Device::Touch => {\n            let face = |ps: Glyph, xb: Glyph| if xbox { xb } else { ps };\n            let shoulder = |ps: &'static str, xb: &'static str| G::Pill(if xbox { xb } else { ps });\n            match action {\n                A::Confirm | A::Ready | A::Join => vec![face(G::Cross, a)],\n                A::Back | A::Cancel => vec![face(G::Circle, b)],\n                A::Use => vec![shoulder(\"R2\", \"RT\")],\n                A::Gift | A::More => vec![face(G::Triangle, y)],\n                A::Chart => vec![face(G::Square, x)],\n                A::Precision => vec![shoulder(\"L2\", \"LT\")],\n                A::Pause => vec![G::Pill(if xbox { \"MENU\" } else { \"OPTIONS\" })],\n                A::Defib => vec![shoulder(\"L2\", \"LT\"), shoulder(\"R2\", \"RT\")],\n                A::Aim => vec![G::Stick(\"R\")],\n                A::Pick => vec![G::Stick(\"L\")],\n                A::Rotate => vec![shoulder(\"L1\", \"LB\"), shoulder(\"R1\", \"RB\")],\n                A::Nav => vec![G::Stick(\"D\")],\n                A::Tabs => vec![shoulder(\"L1\", \"LB\"), shoulder(\"R1\", \"RB\")],\n                A::Skip => vec![face(G::Cross, a)],\n                A::Ring(k) => vec![G::Dir(k)],\n            }\n        }\n        Device::KeyboardMouse => match action {\n            A::Confirm | A::Skip => vec![G::Key(\"Enter\")],\n            A::Ready => vec![G::Key(\"Enter\")],\n            A::Join => vec![G::Key(\"Enter\")],\n            A::Back => vec![G::Key(\"Esc\")],\n            A::Cancel => vec![G::Mouse(\"right\"), G::Key(\"Q\")],\n            A::Use => vec![G::Mouse(\"left\")],\n            A::Gift => vec![G::Key(\"Space\")],\n            A::More => vec![G::Key(\"M\")],\n            A::Chart => vec![G::Key(\"Tab\")],\n            A::Precision => vec![G::Key(\"Shift\")],\n            A::Pause => vec![G::Key(\"Esc\")],\n            A::Defib => vec![G::Mouse(\"both\")],\n            A::Aim => vec![G::Mouse(\"move\")],\n            A::Pick => vec![G::Key(\"1-8\"), G::Mouse(\"wheel\")],\n            A::Rotate => vec![G::Mouse(\"wheel\")],\n            A::Nav => vec![G::Key(\"Arrows\")],\n            A::Tabs => vec![G::Key(\"Q\"), G::Key(\"E\")],\n            A::Ring(k) => vec![G::Key([\"1\", \"2\", \"3\", \"4\", \"5\", \"6\", \"7\", \"8\"][(k as usize).min(7)])],\n        },\n    }\n}\n\nimpl Glyph {\n    pub fn id(&self, xbox: bool) -> String {\n        match self {\n            Glyph::Cross => \"ps:cross\".into(),\n            Glyph::Circle => \"ps:circle\".into(),\n            Glyph::Square => \"ps:square\".into(),\n            Glyph::Triangle => \"ps:triangle\".into(),\n            Glyph::Pill(s) => format!(\"{}:{}\", if xbox { \"xb\" } else { \"ps\" }, s.to_lowercase()),\n            Glyph::Stick(s) => format!(\"stick:{}\", s.to_lowercase()),\n            Glyph::Letter(s, _) => format!(\"xb:{}\", s.to_lowercase()),\n            Glyph::Key(s) => format!(\"key:{}\", s.to_lowercase()),\n            Glyph::Mouse(s) => format!(\"mouse:{s}\"),\n            Glyph::Dir(k) => format!(\"dir:{k}\"),\n        }\n    }\n\n    pub fn width(&self, h: f32) -> f32 {\n        match self {\n            Glyph::Pill(s) => h * 0.55 * (s.len() as f32).max(1.6) + h * 0.3,\n            Glyph::Key(s) => (h * 0.5 * s.len() as f32 + h * 0.4).max(h),\n            _ => h,\n        }\n    }\n\n    /// Draws the glyph with its left edge at `at`, centred vertically on `at.y`.\n    pub fn draw(&self, p: &Painter, at: Pos2, h: f32) {\n        let r = h * 0.5;\n        let c = at + vec2(r, 0.0);\n        let font = FontId::proportional(h * 0.62);\n        match self {\n            Glyph::Cross | Glyph::Circle | Glyph::Square | Glyph::Triangle => {\n                p.circle_filled(c, r, Color32::from_rgb(20, 24, 30));\n                p.circle_stroke(c, r, Stroke::new(2.0, Color32::from_rgb(120, 130, 140)));\n                let s = r * 0.52;\n                match self {\n                    Glyph::Cross => {\n                        let col = Stroke::new(h * 0.1, Color32::from_rgb(120, 170, 240));\n                        p.line_segment([c + vec2(-s, -s), c + vec2(s, s)], col);\n                        p.line_segment([c + vec2(-s, s), c + vec2(s, -s)], col);\n                    }\n                    Glyph::Circle => {\n                        p.circle_stroke(c, s, Stroke::new(h * 0.09, Color32::from_rgb(240, 100, 110)));\n                    }\n                    Glyph::Square => {\n                        p.rect_stroke(Rect::from_center_size(c, vec2(s * 1.7, s * 1.7)), 1.0, Stroke::new(h * 0.08, Color32::from_rgb(230, 130, 200)), StrokeKind::Middle);\n                    }\n                    _ => {\n                        let col = Stroke::new(h * 0.08, Color32::from_rgb(90, 220, 170));\n                        let (a, b, d) = (c + vec2(0.0, -s), c + vec2(s, s * 0.8), c + vec2(-s, s * 0.8));\n                        p.line_segment([a, b], col);\n                        p.line_segment([b, d], col);\n                        p.line_segment([d, a], col);\n                    }\n                }\n            }\n            Glyph::Letter(s, col) => {\n                p.circle_filled(c, r, *col);\n                p.text(c, Align2::CENTER_CENTER, *s, font, Color32::from_rgb(10, 12, 14));\n            }\n            Glyph::Pill(s) => {\n                let w = self.width(h);\n                let rect = Rect::from_min_size(at + vec2(0.0, -h * 0.42), vec2(w, h * 0.84));\n                p.rect_filled(rect, h * 0.3, Color32::from_rgb(22, 26, 32));\n                p.rect_stroke(rect, h * 0.3, Stroke::new(2.0, Color32::from_rgb(170, 180, 190)), StrokeKind::Inside);\n                p.text(rect.center(), Align2::CENTER_CENTER, *s, FontId::proportional(h * 0.5), Color32::WHITE);\n            }\n            Glyph::Stick(s) => {\n                p.circle_filled(c, r, Color32::from_rgb(24, 28, 34));\n                p.circle_stroke(c, r * 0.72, Stroke::new(2.0, Color32::from_rgb(170, 180, 190)));\n                let tag = if *s == \"D\" { \"✛\" } else { s };\n                p.text(c, Align2::CENTER_CENTER, tag, FontId::proportional(h * 0.5), Color32::WHITE);\n            }\n            Glyph::Key(s) => {\n                let w = self.width(h);\n                let rect = Rect::from_min_size(at + vec2(0.0, -h * 0.45), vec2(w, h * 0.9));\n                p.rect_filled(rect.translate(vec2(0.0, 3.0)), 6.0, Color32::from_rgb(90, 96, 104));\n                p.rect_filled(rect, 6.0, Color32::from_rgb(236, 238, 240));\n                p.text(rect.center(), Align2::CENTER_CENTER, *s, FontId::proportional(h * 0.52), Color32::from_rgb(18, 22, 26));\n            }\n            Glyph::Mouse(which) => {\n                let body = Rect::from_center_size(c, vec2(h * 0.66, h * 0.96));\n                p.rect_filled(body, h * 0.3, Color32::from_rgb(232, 234, 238));\n                let top = |left: bool| Rect::from_min_max(pos2(if left { body.left() } else { body.center().x }, body.top()), pos2(if left { body.center().x } else { body.right() }, body.top() + body.height() * 0.42));\n                let hi = Color32::from_rgb(232, 68, 58);\n                match *which {\n                    \"left\" => {\n                        p.rect_filled(top(true), h * 0.12, hi);\n                    }\n                    \"right\" => {\n                        p.rect_filled(top(false), h * 0.12, hi);\n                    }\n                    \"both\" => {\n                        p.rect_filled(top(true), h * 0.12, hi);\n                        p.rect_filled(top(false), h * 0.12, hi);\n                    }\n                    \"wheel\" => {\n                        p.rect_filled(Rect::from_center_size(body.center() - vec2(0.0, h * 0.22), vec2(h * 0.1, h * 0.24)), 2.0, hi);\n                    }\n                    _ => {\n                        p.circle_stroke(body.center(), h * 0.18, Stroke::new(2.0, hi));\n                    }\n                }\n                p.line_segment([pos2(body.center().x, body.top()), pos2(body.center().x, body.top() + body.height() * 0.42)], Stroke::new(1.5, Color32::from_rgb(60, 66, 72)));\n            }\n            Glyph::Dir(k) => {\n                // A compass of eight with this direction lit.\n                p.circle_filled(c, r, Color32::from_rgb(24, 28, 34));\n                let a = (*k as f32) * std::f32::consts::FRAC_PI_4 - std::f32::consts::FRAC_PI_2;\n                let d = egui::Vec2::angled(a);\n                p.line_segment([c, c + d * r * 0.85], Stroke::new(h * 0.14, Color32::from_rgb(120, 226, 214)));\n                p.circle_stroke(c, r, Stroke::new(1.5, Color32::from_rgb(140, 150, 160)));\n            }\n        }\n    }\n}\n\n/// Draws an action's glyphs at `at`; returns the width used. Records their ids.\npub fn prompt(p: &Painter, at: Pos2, action: Action, device: Device, xbox: bool, h: f32, seen: &mut Vec<String>) -> f32 {\n    let mut x = 0.0;\n    for g in glyphs_for(action, device, xbox) {\n        g.draw(p, at + vec2(x, 0.0), h);\n        x += g.width(h) + h * 0.14;\n        let id = g.id(xbox);\n        if !seen.contains(&id) {\n            seen.push(id);\n        }\n    }\n    x\n}\nEOF\n","description":"Fetch the font; write style and glyph helpers"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":25723,"cache_read_input_tokens":466425,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":25723},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"1d3b0ddf-4aa1-4105-a7a4-d88ff8510453","timestamp":"2026-11-05T15:08:09.686Z","request_id":"req_011CgjzKQHcd5QJGetDMNPui","wire_tool_inputs":{"toolu_01LaRPvzHBwxuG4PnNTTrvwi":{"command":"mkdir -p crates/pav_ui/src/surgery crates/pav_ui/assets; curl -sSfL -o crates/pav_ui/assets/BarlowCondensed-SemiBold.ttf https://github.com/google/fonts/raw/main/ofl/barlowcondensed/BarlowCondensed-SemiBold.ttf && ls -la crates/pav_ui/assets; file crates/pav_ui/assets/*.ttf | cut -c1-120\nsed -i 's/^web-time.workspace = true$/web-time.workspace = true\\nserde_json.workspace = true/' crates/pav_ui/Cargo.toml\ncat > crates/pav_ui/src/surgery/style.rs <<'EOF'\n//! 10-foot style: one embedded font, big outlined text, and the painter helpers every screen uses.\n\nuse egui::{Align2, Color32, FontData, FontDefinitions, FontFamily, FontId, Painter, Pos2, Rect, Stroke, StrokeKind, Vec2, pos2, vec2};\n\npub const FONT: &[u8] = include_bytes!(\"../../assets/BarlowCondensed-SemiBold.ttf\");\n\npub const INK: Color32 = Color32::from_rgb(8, 14, 18);\npub const PANEL: Color32 = Color32::from_rgba_premultiplied(9, 20, 24, 225);\npub const TEAL: Color32 = Color32::from_rgb(46, 150, 146);\npub const TEAL_L: Color32 = Color32::from_rgb(120, 226, 214);\npub const WHITE: Color32 = Color32::from_rgb(240, 244, 240);\npub const DIM: Color32 = Color32::from_rgb(160, 176, 176);\npub const RED: Color32 = Color32::from_rgb(232, 68, 58);\npub const GOLD: Color32 = Color32::from_rgb(245, 200, 90);\npub const GREEN: Color32 = Color32::from_rgb(110, 230, 150);\n\n/// Puts the game's font in front of egui's.\npub fn install(ctx: &egui::Context) {\n    let mut f = FontDefinitions::default();\n    f.font_data.insert(\"barlow\".to_owned(), FontData::from_static(FONT).into());\n    f.families.entry(FontFamily::Proportional).or_default().insert(0, \"barlow\".to_owned());\n    ctx.set_fonts(f);\n}\n\n/// The virtual canvas: the screen is 1080 points tall, whatever the window.\npub fn zoom_for(height_px: f32, scale_factor: f32) -> f32 {\n    height_px.max(1.0) / 1080.0 / scale_factor.max(0.1)\n}\n\n/// Text with a dark outline, readable at ten feet over anything.\npub fn text(p: &Painter, at: Pos2, align: Align2, s: &str, size: f32, color: Color32) -> Rect {\n    let id = FontId::proportional(size);\n    let o = (size * 0.045).clamp(1.5, 4.0);\n    for d in [vec2(-o, 0.0), vec2(o, 0.0), vec2(0.0, -o), vec2(0.0, o), vec2(-o, -o), vec2(o, -o), vec2(-o, o), vec2(o, o)] {\n        p.text(at + d, align, s, id.clone(), INK.linear_multiply(color.a() as f32 / 255.0));\n    }\n    p.text(at, align, s, id, color)\n}\n\n/// Wrapped text; returns its height.\npub fn wrapped(p: &Painter, at: Pos2, s: &str, size: f32, color: Color32, width: f32) -> f32 {\n    let g = p.layout(s.to_string(), FontId::proportional(size), color, width);\n    let h = g.size().y;\n    p.galley(at, g, color);\n    h\n}\n\npub fn card(p: &Painter, r: Rect, fill: Color32, edge: Color32) {\n    p.rect_filled(r, 14.0, fill);\n    p.rect_stroke(r, 14.0, Stroke::new(3.0, edge), StrokeKind::Inside);\n}\n\n/// A meter: `v` in 0..1.\npub fn bar(p: &Painter, r: Rect, v: f32, fill: Color32) {\n    p.rect_filled(r, r.height() * 0.3, Color32::from_rgba_unmultiplied(0, 0, 0, 170));\n    let w = r.width() * v.clamp(0.0, 1.0);\n    if w > 1.0 {\n        p.rect_filled(Rect::from_min_size(r.min, vec2(w, r.height())), r.height() * 0.3, fill);\n    }\n    p.rect_stroke(r, r.height() * 0.3, Stroke::new(2.0, Color32::from_rgba_unmultiplied(255, 255, 255, 90)), StrokeKind::Outside);\n}\n\npub fn arc(p: &Painter, c: Pos2, r: f32, from: f32, to: f32, stroke: Stroke) {\n    let n = ((to - from).abs() * r / 6.0).ceil().max(3.0) as usize;\n    let pts: Vec<Pos2> = (0..=n)\n        .map(|k| {\n            let a = from + (to - from) * k as f32 / n as f32;\n            c + Vec2::angled(a) * r\n        })\n        .collect();\n    p.add(egui::Shape::line(pts, stroke));\n}\n\npub fn lerp_color(a: Color32, b: Color32, t: f32) -> Color32 {\n    let t = t.clamp(0.0, 1.0);\n    let m = |x: u8, y: u8| (x as f32 + (y as f32 - x as f32) * t) as u8;\n    Color32::from_rgba_unmultiplied(m(a.r(), b.r()), m(a.g(), b.g()), m(a.b(), b.b()), m(a.a(), b.a()))\n}\n\npub fn seat_color(i: usize) -> Color32 {\n    [Color32::from_rgb(0xe8, 0x44, 0x3a), Color32::from_rgb(0x3b, 0x82, 0xf6), Color32::from_rgb(0x22, 0xc5, 0x5e), Color32::from_rgb(0xf5, 0xb7, 0x00)][i % 4]\n}\n\npub fn center(r: Rect) -> Pos2 {\n    r.center()\n}\n\npub fn full(ctx: &egui::Context) -> Rect {\n    let r = ctx.content_rect();\n    Rect::from_min_size(pos2(0.0, 0.0), r.size())\n}\nEOF\ncat > crates/pav_ui/src/surgery/glyphs.rs <<'EOF'\n//! One `prompt(action)` helper draws the glyph for the device used last: PlayStation shapes in their\n//! colours, or Xbox letters if Settings says so, or keycaps and mouse buttons. It flips the moment\n//! the player touches another device.\n\nuse egui::{Align2, Color32, FontId, Painter, Pos2, Rect, Stroke, StrokeKind, pos2, vec2};\n\nuse crate::Device;\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Action {\n    Confirm,\n    Back,\n    Use,\n    Gift,\n    Chart,\n    Precision,\n    Cancel,\n    Pause,\n    Defib,\n    Aim,\n    Pick,\n    Rotate,\n    Nav,\n    Tabs,\n    Skip,\n    Ready,\n    More,\n    Join,\n    /// A ring direction or digit.\n    Ring(u8),\n}\n\n/// What it draws: an identifier for tests (`ps:cross`, `xb:a`, `key:enter`, `mouse:left`).\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Glyph {\n    Cross,\n    Circle,\n    Square,\n    Triangle,\n    Pill(&'static str),\n    Stick(&'static str),\n    Letter(&'static str, Color32),\n    Key(&'static str),\n    Mouse(&'static str),\n    Dir(u8),\n}\n\npub fn glyphs_for(action: Action, device: Device, xbox: bool) -> Vec<Glyph> {\n    use Action as A;\n    use Glyph as G;\n    let (a, b, x, y) = (\n        G::Letter(\"A\", Color32::from_rgb(90, 190, 80)),\n        G::Letter(\"B\", Color32::from_rgb(220, 70, 60)),\n        G::Letter(\"X\", Color32::from_rgb(70, 130, 230)),\n        G::Letter(\"Y\", Color32::from_rgb(235, 190, 60)),\n    );\n    match device {\n        Device::Gamepad | Device::Touch => {\n            let face = |ps: Glyph, xb: Glyph| if xbox { xb } else { ps };\n            let shoulder = |ps: &'static str, xb: &'static str| G::Pill(if xbox { xb } else { ps });\n            match action {\n                A::Confirm | A::Ready | A::Join => vec![face(G::Cross, a)],\n                A::Back | A::Cancel => vec![face(G::Circle, b)],\n                A::Use => vec![shoulder(\"R2\", \"RT\")],\n                A::Gift | A::More => vec![face(G::Triangle, y)],\n                A::Chart => vec![face(G::Square, x)],\n                A::Precision => vec![shoulder(\"L2\", \"LT\")],\n                A::Pause => vec![G::Pill(if xbox { \"MENU\" } else { \"OPTIONS\" })],\n                A::Defib => vec![shoulder(\"L2\", \"LT\"), shoulder(\"R2\", \"RT\")],\n                A::Aim => vec![G::Stick(\"R\")],\n                A::Pick => vec![G::Stick(\"L\")],\n                A::Rotate => vec![shoulder(\"L1\", \"LB\"), shoulder(\"R1\", \"RB\")],\n                A::Nav => vec![G::Stick(\"D\")],\n                A::Tabs => vec![shoulder(\"L1\", \"LB\"), shoulder(\"R1\", \"RB\")],\n                A::Skip => vec![face(G::Cross, a)],\n                A::Ring(k) => vec![G::Dir(k)],\n            }\n        }\n        Device::KeyboardMouse => match action {\n            A::Confirm | A::Skip => vec![G::Key(\"Enter\")],\n            A::Ready => vec![G::Key(\"Enter\")],\n            A::Join => vec![G::Key(\"Enter\")],\n            A::Back => vec![G::Key(\"Esc\")],\n            A::Cancel => vec![G::Mouse(\"right\"), G::Key(\"Q\")],\n            A::Use => vec![G::Mouse(\"left\")],\n            A::Gift => vec![G::Key(\"Space\")],\n            A::More => vec![G::Key(\"M\")],\n            A::Chart => vec![G::Key(\"Tab\")],\n            A::Precision => vec![G::Key(\"Shift\")],\n            A::Pause => vec![G::Key(\"Esc\")],\n            A::Defib => vec![G::Mouse(\"both\")],\n            A::Aim => vec![G::Mouse(\"move\")],\n            A::Pick => vec![G::Key(\"1-8\"), G::Mouse(\"wheel\")],\n            A::Rotate => vec![G::Mouse(\"wheel\")],\n            A::Nav => vec![G::Key(\"Arrows\")],\n            A::Tabs => vec![G::Key(\"Q\"), G::Key(\"E\")],\n            A::Ring(k) => vec![G::Key([\"1\", \"2\", \"3\", \"4\", \"5\", \"6\", \"7\", \"8\"][(k as usize).min(7)])],\n        },\n    }\n}\n\nimpl Glyph {\n    pub fn id(&self, xbox: bool) -> String {\n        match self {\n            Glyph::Cross => \"ps:cross\".into(),\n            Glyph::Circle => \"ps:circle\".into(),\n            Glyph::Square => \"ps:square\".into(),\n            Glyph::Triangle => \"ps:triangle\".into(),\n            Glyph::Pill(s) => format!(\"{}:{}\", if xbox { \"xb\" } else { \"ps\" }, s.to_lowercase()),\n            Glyph::Stick(s) => format!(\"stick:{}\", s.to_lowercase()),\n            Glyph::Letter(s, _) => format!(\"xb:{}\", s.to_lowercase()),\n            Glyph::Key(s) => format!(\"key:{}\", s.to_lowercase()),\n            Glyph::Mouse(s) => format!(\"mouse:{s}\"),\n            Glyph::Dir(k) => format!(\"dir:{k}\"),\n        }\n    }\n\n    pub fn width(&self, h: f32) -> f32 {\n        match self {\n            Glyph::Pill(s) => h * 0.55 * (s.len() as f32).max(1.6) + h * 0.3,\n            Glyph::Key(s) => (h * 0.5 * s.len() as f32 + h * 0.4).max(h),\n            _ => h,\n        }\n    }\n\n    /// Draws the glyph with its left edge at `at`, centred vertically on `at.y`.\n    pub fn draw(&self, p: &Painter, at: Pos2, h: f32) {\n        let r = h * 0.5;\n        let c = at + vec2(r, 0.0);\n        let font = FontId::proportional(h * 0.62);\n        match self {\n            Glyph::Cross | Glyph::Circle | Glyph::Square | Glyph::Triangle => {\n                p.circle_filled(c, r, Color32::from_rgb(20, 24, 30));\n                p.circle_stroke(c, r, Stroke::new(2.0, Color32::from_rgb(120, 130, 140)));\n                let s = r * 0.52;\n                match self {\n                    Glyph::Cross => {\n                        let col = Stroke::new(h * 0.1, Color32::from_rgb(120, 170, 240));\n                        p.line_segment([c + vec2(-s, -s), c + vec2(s, s)], col);\n                        p.line_segment([c + vec2(-s, s), c + vec2(s, -s)], col);\n                    }\n                    Glyph::Circle => {\n                        p.circle_stroke(c, s, Stroke::new(h * 0.09, Color32::from_rgb(240, 100, 110)));\n                    }\n                    Glyph::Square => {\n                        p.rect_stroke(Rect::from_center_size(c, vec2(s * 1.7, s * 1.7)), 1.0, Stroke::new(h * 0.08, Color32::from_rgb(230, 130, 200)), StrokeKind::Middle);\n                    }\n                    _ => {\n                        let col = Stroke::new(h * 0.08, Color32::from_rgb(90, 220, 170));\n                        let (a, b, d) = (c + vec2(0.0, -s), c + vec2(s, s * 0.8), c + vec2(-s, s * 0.8));\n                        p.line_segment([a, b], col);\n                        p.line_segment([b, d], col);\n                        p.line_segment([d, a], col);\n                    }\n                }\n            }\n            Glyph::Letter(s, col) => {\n                p.circle_filled(c, r, *col);\n                p.text(c, Align2::CENTER_CENTER, *s, font, Color32::from_rgb(10, 12, 14));\n            }\n            Glyph::Pill(s) => {\n                let w = self.width(h);\n                let rect = Rect::from_min_size(at + vec2(0.0, -h * 0.42), vec2(w, h * 0.84));\n                p.rect_filled(rect, h * 0.3, Color32::from_rgb(22, 26, 32));\n                p.rect_stroke(rect, h * 0.3, Stroke::new(2.0, Color32::from_rgb(170, 180, 190)), StrokeKind::Inside);\n                p.text(rect.center(), Align2::CENTER_CENTER, *s, FontId::proportional(h * 0.5), Color32::WHITE);\n            }\n            Glyph::Stick(s) => {\n                p.circle_filled(c, r, Color32::from_rgb(24, 28, 34));\n                p.circle_stroke(c, r * 0.72, Stroke::new(2.0, Color32::from_rgb(170, 180, 190)));\n                let tag = if *s == \"D\" { \"✛\" } else { s };\n                p.text(c, Align2::CENTER_CENTER, tag, FontId::proportional(h * 0.5), Color32::WHITE);\n            }\n            Glyph::Key(s) => {\n                let w = self.width(h);\n                let rect = Rect::from_min_size(at + vec2(0.0, -h * 0.45), vec2(w, h * 0.9));\n                p.rect_filled(rect.translate(vec2(0.0, 3.0)), 6.0, Color32::from_rgb(90, 96, 104));\n                p.rect_filled(rect, 6.0, Color32::from_rgb(236, 238, 240));\n                p.text(rect.center(), Align2::CENTER_CENTER, *s, FontId::proportional(h * 0.52), Color32::from_rgb(18, 22, 26));\n            }\n            Glyph::Mouse(which) => {\n                let body = Rect::from_center_size(c, vec2(h * 0.66, h * 0.96));\n                p.rect_filled(body, h * 0.3, Color32::from_rgb(232, 234, 238));\n                let top = |left: bool| Rect::from_min_max(pos2(if left { body.left() } else { body.center().x }, body.top()), pos2(if left { body.center().x } else { body.right() }, body.top() + body.height() * 0.42));\n                let hi = Color32::from_rgb(232, 68, 58);\n                match *which {\n                    \"left\" => {\n                        p.rect_filled(top(true), h * 0.12, hi);\n                    }\n                    \"right\" => {\n                        p.rect_filled(top(false), h * 0.12, hi);\n                    }\n                    \"both\" => {\n                        p.rect_filled(top(true), h * 0.12, hi);\n                        p.rect_filled(top(false), h * 0.12, hi);\n                    }\n                    \"wheel\" => {\n                        p.rect_filled(Rect::from_center_size(body.center() - vec2(0.0, h * 0.22), vec2(h * 0.1, h * 0.24)), 2.0, hi);\n                    }\n                    _ => {\n                        p.circle_stroke(body.center(), h * 0.18, Stroke::new(2.0, hi));\n                    }\n                }\n                p.line_segment([pos2(body.center().x, body.top()), pos2(body.center().x, body.top() + body.height() * 0.42)], Stroke::new(1.5, Color32::from_rgb(60, 66, 72)));\n            }\n            Glyph::Dir(k) => {\n                // A compass of eight with this direction lit.\n                p.circle_filled(c, r, Color32::from_rgb(24, 28, 34));\n                let a = (*k as f32) * std::f32::consts::FRAC_PI_4 - std::f32::consts::FRAC_PI_2;\n                let d = egui::Vec2::angled(a);\n                p.line_segment([c, c + d * r * 0.85], Stroke::new(h * 0.14, Color32::from_rgb(120, 226, 214)));\n                p.circle_stroke(c, r, Stroke::new(1.5, Color32::from_rgb(140, 150, 160)));\n            }\n        }\n    }\n}\n\n/// Draws an action's glyphs at `at`; returns the width used. Records their ids.\npub fn prompt(p: &Painter, at: Pos2, action: Action, device: Device, xbox: bool, h: f32, seen: &mut Vec<String>) -> f32 {\n    let mut x = 0.0;\n    for g in glyphs_for(action, device, xbox) {\n        g.draw(p, at + vec2(x, 0.0), h);\n        x += g.width(h) + h * 0.14;\n        let id = g.id(xbox);\n        if !seen.contains(&id) {\n            seen.push(id);\n        }\n    }\n    x\n}\nEOF\n","description":"Fetch the font; write style and glyph helpers"}}}
