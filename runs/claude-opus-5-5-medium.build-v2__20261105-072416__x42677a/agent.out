{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HzyHNx2dcmmAp3z7Z42WH8","type":"tool_result","content":"//! Scene building: interpolates between two simulation frames and emits render instances.\n\nuse std::collections::{BTreeMap, HashMap, HashSet};\nuse std::sync::{Arc, Mutex, MutexGuard};\n\nuse glam::{Mat4, Quat, Vec3};\nuse pav_core::frame::{PuppetFrame, SimEvent};\nuse pav_core::fxdef::{EmitterDef, LightDef};\nuse pav_core::params::{ChoiceParam, ParamVisitor, Tunable, nested};\nuse pav_core::prop_instance::PropFrame;\nuse pav_core::props::geom::{Generated, GeomMesh, Primitive};\nuse pav_core::props::{DEFAULT_ROLES, ResolvedPart};\nuse pav_core::puppet::PuppetDef;\nuse pav_core::shape::Sway;\nuse pav_core::statics::Ladder;\nuse pav_core::statics::{ChunkKey, block_flags};\nuse pav_core::zones::{Label, LabelMode, Zone, ZoneKind};\nuse pav_core::{Color, Look, RenderFrame, RenderObject, Shape, choice_enum};\nuse pav_render::mesh::{MeshData, Vertex};\nuse pav_render::scene::{self as rs, MeshInstance, MeshKey, Scene, SdfInstance, Style, Tonemap};\nuse pav_render::text::{Anchor, Text3d};\nuse serde::{Deserialize, Serialize};\n\nuse crate::camera::CameraRig;\nuse crate::materials::{self, MaterialTable};\nuse pav_core::material::Library;\nuse pav_core::props::doc::MapMode;\n\nchoice_enum! {\n    pub enum StyleOverride { PerObject => \"per object\", Flat => \"flat\", Cel => \"cel\", Lit => \"lit\" }\n}\n\nchoice_enum! {\n    pub enum TonemapChoice { Clamp => \"clamp\", SoftKnee => \"soft knee\", Aces => \"aces\" }\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\n#[serde(default)]\npub struct LightSettings {\n    /// Sun height above the horizon (degrees).\n1468\n        let back = (1.0 - alpha) * curr.dt;\n        for p in &curr.projectiles {\n            let mut sd = SdfInstance::sphere(p.pos - p.vel * back, p.radius, v3(p.color));\n            sd.style = Style::Unlit;\n            sd.emissive = 0.6;\n            sd.flags = rs::flags::NO_SHADOW | rs::flags::NO_CUT;\n            sd.group = 0x7f1;\n            scene.sdfs.push(sd);\n        }\n        self.emit_effects(&mut scene);\n        scenery.sort_unstable();\n        mark_objects(&mut scene, env_end, &scenery);\n        if settings.style == StyleOverride::PerObject {\n            restyle_parts(&mut scene, settings.style_objects, settings.style_environment);\n        }\n        if f.pixel_art > 1.0 {\n            let hero = curr.player.map(|p| p.0 + 2);\n            mark_pixel_art(&mut scene, |g, flags| match f.pixel_target {\n                PixelTarget::All => true,\n                PixelTarget::Characters => puppets.contains(&g),\n                PixelTarget::Hero => Some(g) == hero,\n                PixelTarget::Others => puppets.contains(&g) && Some(g) != hero,\n                PixelTarget::World => !puppets.contains(&g),\n                PixelTarget::Entity => g == f.pixel_entity as u32 + 2,\n                PixelTarget::Objects => flags & rs::flags::OBJECT != 0,\n                PixelTarget::Environment => flags & rs::flags::OBJECT == 0,\n            });\n        }\n        lock(&self.materials).attach(&mut scene);\n        scene\n    }\n                self.shocks.push((*pos, radius * 3.5, self.last_time.unwrap_or(0.0)));\n                self.water_dents.push((*pos, radius * 1.2, 0.22));\n            }\n            if let SimEvent::Splash { pos } = e {\n                self.water_dents.push((*pos, 0.7, 0.12));\n            }\n            if let SimEvent::Destroyed { pos, size } = e {\n                self.shocks.push((*pos, size.max(0.5) * 5.0, self.last_time.unwrap_or(0.0)));\n            }\n            match e {\n                SimEvent::Slam { pos, radius } => self.shocks.push((*pos, radius * 2.5, self.last_time.unwrap_or(0.0))),\n                SimEvent::Blast { pos, .. } => self.shocks.push((*pos, 4.0, self.last_time.unwrap_or(0.0))),\n                _ => {}\n            }\n            match e {\n                SimEvent::Explosion { pos, radius } => {\n                    self.effects.push(Effect { kind: EffectKind::Explosion { radius: *radius }, pos: *pos, start: self.now })\n                }\n                SimEvent::Land { pos, speed } if *speed > 6.0 => {\n                    self.effects.push(Effect { kind: EffectKind::Dust, pos: *pos, start: self.now })\n                }\n                SimEvent::Hit { pos, .. } => self.effects.push(Effect {\n                    kind: EffectKind::Burst { color: [1.0, 0.35, 0.2], up: 0.5 },\n                    pos: *pos,\n                    start: self.now,\n                }),\n                SimEvent::Splash { pos } => self.effects.push(Effect {\n                    kind: EffectKind::Burst { color: [0.75, 0.88, 1.0], up: 2.5 },\n                    pos: *pos + Vec3::Y * 0.3,\n                    start: self.now,\n                }),\n                SimEvent::Break { pos } => self.effects.push(Effect {\n                    kind: EffectKind::Burst { color: [0.85, 0.82, 0.75], up: 1.0 },\n                    pos: *pos,\n                    start: self.now,\n                }),\n//! Visual effects from simulation data: particle presets for object emitters and game events,\n//! object lights (flicker, pulse) and screen distortion sources.\n\nuse glam::{Vec3, Vec4};\nuse pav_core::color::Color;\nuse pav_core::fxdef::{DistortDef, EmitterDef, LightDef};\nuse pav_render::{self as rs, DistortKind, Distortion, ParticleBurst};\n\nfn rgba(c: Vec3, a: f32) -> Vec4 {\n    c.extend(a)\n}\n\n/// A preset's template burst (count 0) and its default rate (particles per second).\npub fn preset(name: &str) -> (ParticleBurst, f32) {\n    let b = ParticleBurst::default();\n    match name {\n        \"smoke\" => (\n            ParticleBurst {\n                area: Vec3::new(0.2, 0.05, 0.2),\n                vel: Vec3::new(0.0, 0.9, 0.0),\n                spread: 0.3,\n                gravity: -0.3,\n                drag: 0.6,\n                life: (2.2, 3.6),\n                size: (0.15, 0.75),\n                color0: Vec4::new(0.22, 0.22, 0.24, 0.55),\n                color1: Vec4::new(0.45, 0.45, 0.48, 0.0),\n                additive: false,\n                turbulence: 1.0,\n                ..b\n            },\n            14.0,\n        ),\n        \"steam\" => (\n            ParticleBurst {\n                area: Vec3::new(0.15, 0.02, 0.15),\n                vel: Vec3::new(0.0, 1.6, 0.0),\n                spread: 0.4,\n                gravity: -0.5,\n                drag: 1.0,\n                life: (1.0, 1.8),\n                size: (0.1, 0.6),\n                color0: Vec4::new(0.9, 0.92, 0.95, 0.45),\n                color1: Vec4::new(1.0, 1.0, 1.0, 0.0),\n                additive: false,\n                turbulence: 1.5,\n                ..b\n            },\n            20.0,\n        ),\n        \"sparks\" => (\n            ParticleBurst {\n                vel: Vec3::new(0.0, 3.5, 0.0),\n                spread: 3.0,\n                gravity: 9.8,\n                drag: 0.3,\n                life: (0.4, 1.0),\n                size: (0.05, 0.015),\n                color0: Vec4::new(6.0, 3.2, 1.0, 1.0),\n                color1: Vec4::new(2.0, 0.4, 0.1, 0.0),\n544:pub fn screen_uv(cam: &rs::CameraData, p: Vec3) -> glam::Vec2 {\n545-    let c = cam.proj * cam.view * p.extend(1.0);\n546-    if c.w.abs() < 1e-6 {\n547-        return glam::Vec2::splat(0.5);\n548-    }\n549-    let ndc = c.truncate() / c.w;\n550-    glam::Vec2::new(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5).clamp(glam::Vec2::splat(-0.5), glam::Vec2::splat(1.5))\n551-}\n552-\n553-/// A transition looping for show: closes over `secs`, stays covered a moment, opens over\n554-/// `secs`, stays open a moment. Returns how covered the screen is (0..1).","is_error":false}]},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"c47cd8f1-94a6-4de4-9c4a-965874ad52d0","timestamp":"2026-11-05T14:55:05.945Z","tool_use_result":{"stdout":"//! Scene building: interpolates between two simulation frames and emits render instances.\n\nuse std::collections::{BTreeMap, HashMap, HashSet};\nuse std::sync::{Arc, Mutex, MutexGuard};\n\nuse glam::{Mat4, Quat, Vec3};\nuse pav_core::frame::{PuppetFrame, SimEvent};\nuse pav_core::fxdef::{EmitterDef, LightDef};\nuse pav_core::params::{ChoiceParam, ParamVisitor, Tunable, nested};\nuse pav_core::prop_instance::PropFrame;\nuse pav_core::props::geom::{Generated, GeomMesh, Primitive};\nuse pav_core::props::{DEFAULT_ROLES, ResolvedPart};\nuse pav_core::puppet::PuppetDef;\nuse pav_core::shape::Sway;\nuse pav_core::statics::Ladder;\nuse pav_core::statics::{ChunkKey, block_flags};\nuse pav_core::zones::{Label, LabelMode, Zone, ZoneKind};\nuse pav_core::{Color, Look, RenderFrame, RenderObject, Shape, choice_enum};\nuse pav_render::mesh::{MeshData, Vertex};\nuse pav_render::scene::{self as rs, MeshInstance, MeshKey, Scene, SdfInstance, Style, Tonemap};\nuse pav_render::text::{Anchor, Text3d};\nuse serde::{Deserialize, Serialize};\n\nuse crate::camera::CameraRig;\nuse crate::materials::{self, MaterialTable};\nuse pav_core::material::Library;\nuse pav_core::props::doc::MapMode;\n\nchoice_enum! {\n    pub enum StyleOverride { PerObject => \"per object\", Flat => \"flat\", Cel => \"cel\", Lit => \"lit\" }\n}\n\nchoice_enum! {\n    pub enum TonemapChoice { Clamp => \"clamp\", SoftKnee => \"soft knee\", Aces => \"aces\" }\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\n#[serde(default)]\npub struct LightSettings {\n    /// Sun height above the horizon (degrees).\n1468\n        let back = (1.0 - alpha) * curr.dt;\n        for p in &curr.projectiles {\n            let mut sd = SdfInstance::sphere(p.pos - p.vel * back, p.radius, v3(p.color));\n            sd.style = Style::Unlit;\n            sd.emissive = 0.6;\n            sd.flags = rs::flags::NO_SHADOW | rs::flags::NO_CUT;\n            sd.group = 0x7f1;\n            scene.sdfs.push(sd);\n        }\n        self.emit_effects(&mut scene);\n        scenery.sort_unstable();\n        mark_objects(&mut scene, env_end, &scenery);\n        if settings.style == StyleOverride::PerObject {\n            restyle_parts(&mut scene, settings.style_objects, settings.style_environment);\n        }\n        if f.pixel_art > 1.0 {\n            let hero = curr.player.map(|p| p.0 + 2);\n            mark_pixel_art(&mut scene, |g, flags| match f.pixel_target {\n                PixelTarget::All => true,\n                PixelTarget::Characters => puppets.contains(&g),\n                PixelTarget::Hero => Some(g) == hero,\n                PixelTarget::Others => puppets.contains(&g) && Some(g) != hero,\n                PixelTarget::World => !puppets.contains(&g),\n                PixelTarget::Entity => g == f.pixel_entity as u32 + 2,\n                PixelTarget::Objects => flags & rs::flags::OBJECT != 0,\n                PixelTarget::Environment => flags & rs::flags::OBJECT == 0,\n            });\n        }\n        lock(&self.materials).attach(&mut scene);\n        scene\n    }\n                self.shocks.push((*pos, radius * 3.5, self.last_time.unwrap_or(0.0)));\n                self.water_dents.push((*pos, radius * 1.2, 0.22));\n            }\n            if let SimEvent::Splash { pos } = e {\n                self.water_dents.push((*pos, 0.7, 0.12));\n            }\n            if let SimEvent::Destroyed { pos, size } = e {\n                self.shocks.push((*pos, size.max(0.5) * 5.0, self.last_time.unwrap_or(0.0)));\n            }\n            match e {\n                SimEvent::Slam { pos, radius } => self.shocks.push((*pos, radius * 2.5, self.last_time.unwrap_or(0.0))),\n                SimEvent::Blast { pos, .. } => self.shocks.push((*pos, 4.0, self.last_time.unwrap_or(0.0))),\n                _ => {}\n            }\n            match e {\n                SimEvent::Explosion { pos, radius } => {\n                    self.effects.push(Effect { kind: EffectKind::Explosion { radius: *radius }, pos: *pos, start: self.now })\n                }\n                SimEvent::Land { pos, speed } if *speed > 6.0 => {\n                    self.effects.push(Effect { kind: EffectKind::Dust, pos: *pos, start: self.now })\n                }\n                SimEvent::Hit { pos, .. } => self.effects.push(Effect {\n                    kind: EffectKind::Burst { color: [1.0, 0.35, 0.2], up: 0.5 },\n                    pos: *pos,\n                    start: self.now,\n                }),\n                SimEvent::Splash { pos } => self.effects.push(Effect {\n                    kind: EffectKind::Burst { color: [0.75, 0.88, 1.0], up: 2.5 },\n                    pos: *pos + Vec3::Y * 0.3,\n                    start: self.now,\n                }),\n                SimEvent::Break { pos } => self.effects.push(Effect {\n                    kind: EffectKind::Burst { color: [0.85, 0.82, 0.75], up: 1.0 },\n                    pos: *pos,\n                    start: self.now,\n                }),\n//! Visual effects from simulation data: particle presets for object emitters and game events,\n//! object lights (flicker, pulse) and screen distortion sources.\n\nuse glam::{Vec3, Vec4};\nuse pav_core::color::Color;\nuse pav_core::fxdef::{DistortDef, EmitterDef, LightDef};\nuse pav_render::{self as rs, DistortKind, Distortion, ParticleBurst};\n\nfn rgba(c: Vec3, a: f32) -> Vec4 {\n    c.extend(a)\n}\n\n/// A preset's template burst (count 0) and its default rate (particles per second).\npub fn preset(name: &str) -> (ParticleBurst, f32) {\n    let b = ParticleBurst::default();\n    match name {\n        \"smoke\" => (\n            ParticleBurst {\n                area: Vec3::new(0.2, 0.05, 0.2),\n                vel: Vec3::new(0.0, 0.9, 0.0),\n                spread: 0.3,\n                gravity: -0.3,\n                drag: 0.6,\n                life: (2.2, 3.6),\n                size: (0.15, 0.75),\n                color0: Vec4::new(0.22, 0.22, 0.24, 0.55),\n                color1: Vec4::new(0.45, 0.45, 0.48, 0.0),\n                additive: false,\n                turbulence: 1.0,\n                ..b\n            },\n            14.0,\n        ),\n        \"steam\" => (\n            ParticleBurst {\n                area: Vec3::new(0.15, 0.02, 0.15),\n                vel: Vec3::new(0.0, 1.6, 0.0),\n                spread: 0.4,\n                gravity: -0.5,\n                drag: 1.0,\n                life: (1.0, 1.8),\n                size: (0.1, 0.6),\n                color0: Vec4::new(0.9, 0.92, 0.95, 0.45),\n                color1: Vec4::new(1.0, 1.0, 1.0, 0.0),\n                additive: false,\n                turbulence: 1.5,\n                ..b\n            },\n            20.0,\n        ),\n        \"sparks\" => (\n            ParticleBurst {\n                vel: Vec3::new(0.0, 3.5, 0.0),\n                spread: 3.0,\n                gravity: 9.8,\n                drag: 0.3,\n                life: (0.4, 1.0),\n                size: (0.05, 0.015),\n                color0: Vec4::new(6.0, 3.2, 1.0, 1.0),\n                color1: Vec4::new(2.0, 0.4, 0.1, 0.0),\n544:pub fn screen_uv(cam: &rs::CameraData, p: Vec3) -> glam::Vec2 {\n545-    let c = cam.proj * cam.view * p.extend(1.0);\n546-    if c.w.abs() < 1e-6 {\n547-        return glam::Vec2::splat(0.5);\n548-    }\n549-    let ndc = c.truncate() / c.w;\n550-    glam::Vec2::new(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5).clamp(glam::Vec2::splat(-0.5), glam::Vec2::splat(1.5))\n551-}\n552-\n553-/// A transition looping for show: closes over `secs`, stays covered a moment, opens over\n554-/// `secs`, stays open a moment. Returns how covered the screen is (0..1).","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01HzyHNx2dcmmAp3z7Z42WH8","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjyP6PprEpnUWiDS87ty","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011xwSaWxqUHTG9r8mHSQ1Ss","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery/paper.rs","content":"//! Paper-theatre geometry: closed outlines rounded by Chaikin corner cutting and ear-clipped into\n//! triangles, and the poses that move a rig's parts. The view extrudes these into lit cards; the\n//! HUD flattens the same rig into its cameo.\n\nuse glam::Vec2;\n\nuse super::content::{Content, Expr, Rig, RigPart};\n\n/// One round of corner cutting per `n`; each edge a→b yields a.lerp(b, .25) and a.lerp(b, .75).\npub fn chaikin(points: &[Vec2], n: u8) -> Vec<Vec2> {\n    let mut p = points.to_vec();\n    for _ in 0..n {\n        let mut out = Vec::with_capacity(p.len() * 2);\n        for i in 0..p.len() {\n            let (a, b) = (p[i], p[(i + 1) % p.len()]);\n            out.push(a.lerp(b, 0.25));\n            out.push(a.lerp(b, 0.75));\n        }\n        p = out;\n    }\n    p\n}\n\nfn signed_area(p: &[Vec2]) -> f32 {\n    let mut a = 0.0;\n    for i in 0..p.len() {\n        let (q, r) = (p[i], p[(i + 1) % p.len()]);\n        a += q.x * r.y - r.x * q.y;\n    }\n    a * 0.5\n}\n\nfn in_tri(p: Vec2, a: Vec2, b: Vec2, c: Vec2) -> bool {\n    let s = |u: Vec2, v: Vec2, w: Vec2| (v - u).perp_dot(w - u);\n    s(a, b, p) >= -1e-5 && s(b, c, p) >= -1e-5 && s(c, a, p) >= -1e-5\n}\n\n/// Ear-clips a counter-clockwise outline (concave hair shapes need it).\npub fn triangulate(p: &[Vec2]) -> Vec<u32> {\n    let mut idx: Vec<u32> = (0..p.len() as u32).collect();\n    let mut out = Vec::with_capacity(p.len() * 3);\n    let mut guard = 0;\n    while idx.len() > 3 && guard < p.len() * p.len() + 16 {\n        guard += 1;\n        let n = idx.len();\n        let mut cut = None;\n        for i in 0..n {\n            let (ia, ib, ic) = (idx[(i + n - 1) % n], idx[i], idx[(i + 1) % n]);\n            let (a, b, c) = (p[ia as usize], p[ib as usize], p[ic as usize]);\n            if (b - a).perp_dot(c - b) <= 1e-6 {\n                continue;\n            }\n            let blocked = idx.iter().any(|&j| {\n                j != ia && j != ib && j != ic && in_tri(p[j as usize], a, b, c)\n            });\n            if !blocked {\n                out.extend_from_slice(&[ia, ib, ic]);\n                cut = Some(i);\n                break;\n            }\n        }\n        match cut {\n            Some(i) => {\n                idx.remove(i);\n            }\n            None => {\n                idx.remove(0);\n            }\n        }\n    }\n    if idx.len() == 3 {\n        out.extend_from_slice(&[idx[0], idx[1], idx[2]]);\n    }\n    out\n}\n\n/// A rounded, triangulated outline, counter-clockwise.\n#[derive(Clone, Debug, Default)]\npub struct Outline {\n    pub points: Vec<Vec2>,\n    pub tris: Vec<u32>,\n}\n\npub fn outline(points: &[Vec2], rounding: u8) -> Outline {\n    let mut p = chaikin(points, rounding);\n    if signed_area(&p) < 0.0 {\n        p.reverse();\n    }\n    let tris = triangulate(&p);\n    Outline { points: p, tris }\n}\n\n/// What animation moves a part.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\npub enum Layer {\n    #[default]\n    Body,\n    Head,\n    Hair,\n    Eyes,\n    Lid,\n    Brow,\n}\n\n/// A part ready to draw.\n#[derive(Clone, Debug)]\npub struct PartGeo {\n    pub name: String,\n    pub z: f32,\n    pub color: [u8; 3],\n    pub layer: Layer,\n    /// -1 or 1: which side's eye or brow, for mirrored parts (0 for others).\n    pub side: f32,\n    pub outline: Outline,\n}\n\nfn hex(s: &str) -> [u8; 3] {\n    let t = s.trim_start_matches('#');\n    let v = u32::from_str_radix(t, 16).unwrap_or(0x808080);\n    [(v >> 16) as u8, (v >> 8) as u8, v as u8]\n}\n\nfn color_of(rig: &Rig, name: &str) -> [u8; 3] {\n    if name.starts_with('#') {\n        hex(name)\n    } else {\n        rig.colors.get(name).map(|c| hex(c)).unwrap_or([128, 128, 128])\n    }\n}\n\nfn part_geo(rig: &Rig, p: &RigPart, out: &mut Vec<PartGeo>) {\n    let layer = match p.layer.as_str() {\n        \"head\" => Layer::Head,\n        \"hair\" => Layer::Hair,\n        \"eyes\" => Layer::Eyes,\n        \"lid\" => Layer::Lid,\n        \"brow\" => Layer::Brow,\n        _ => Layer::Body,\n    };\n    let pts: Vec<Vec2> = p.points.iter().map(|q| Vec2::new(q[0], q[1])).collect();\n    if pts.len() < 3 {\n        return;\n    }\n    let mut add = |pts: &[Vec2], side: f32| {\n        out.push(PartGeo {\n            name: p.name.clone(),\n            z: p.z,\n            color: color_of(rig, &p.color),\n            layer,\n            side,\n            outline: outline(pts, p.chaikin),\n        });\n    };\n    if p.mirror {\n        add(&pts, 1.0);\n        let flipped: Vec<Vec2> = pts.iter().map(|q| Vec2::new(-q.x, q.y)).collect();\n        add(&flipped, -1.0);\n    } else {\n        add(&pts, 0.0);\n    }\n}\n\n/// All of a rig's parts (the shared face and its own), back to front.\npub fn rig_parts(c: &Content, rig: &Rig) -> Vec<PartGeo> {\n    let mut out = Vec::new();\n    for p in c.face.part.iter().chain(rig.part.iter()) {\n        part_geo(rig, p, &mut out);\n    }\n    out.sort_by(|a, b| a.z.total_cmp(&b.z));\n    out\n}\n\n/// The mouth outline for a shape and how open it is right now.\npub fn mouth_points(shape: &str, talking: bool, flap: f32) -> Vec<Vec2> {\n    if talking && flap > 0.0 {\n        let o = 0.05 + 0.1 * flap;\n        return vec![\n            Vec2::new(-0.15, -0.255),\n            Vec2::new(0.0, -0.21),\n            Vec2::new(0.15, -0.255),\n            Vec2::new(0.08, -0.255 - o),\n            Vec2::new(-0.08, -0.255 - o),\n        ];\n    }\n    let v = |x: f32, y: f32| Vec2::new(x, y);\n    match shape {\n        \"smile\" => vec![v(-0.18, -0.235), v(0.0, -0.285), v(0.18, -0.235), v(0.0, -0.33)],\n        \"frown\" => vec![v(-0.16, -0.31), v(0.0, -0.25), v(0.16, -0.31), v(0.0, -0.285)],\n        \"flat\" => vec![v(-0.16, -0.27), v(0.16, -0.27), v(0.16, -0.295), v(-0.16, -0.295)],\n        \"open\" => vec![v(-0.1, -0.24), v(0.0, -0.2), v(0.1, -0.24), v(0.07, -0.38), v(-0.07, -0.38)],\n        _ => vec![v(-0.16, -0.26), v(0.0, -0.235), v(0.16, -0.26), v(0.0, -0.285)],\n    }\n}\n\n/// A character's pose this moment.\n#[derive(Clone, Copy, Debug)]\npub struct Pose {\n    pub head: Vec2,\n    pub tilt: f32,\n    pub eye_open: f32,\n    pub pupil: f32,\n    pub brow_y: f32,\n    pub brow_rot: f32,\n    pub look: Vec2,\n    pub hair: Vec2,\n    pub breathe: f32,\n    pub flap: f32,\n}\n\nfn flap_of(t: f32, seed: f32) -> f32 {\n    let v = (t * 15.0 + seed).sin() * 0.5 + 0.5;\n    if v > 0.28 { v } else { 0.0 }\n}\n\n/// Blink, breathe, sway, head nods on speech, hair on springs (as a function of time: paper rigs\n/// are the view's, not the sim's).\npub fn pose_for(expr: Option<&Expr>, t: f32, seed: f32, talking: bool) -> Pose {\n    let e = expr.cloned().unwrap_or(Expr { eye: 1.0, pupil: 1.0, ..Default::default() });\n    let blink_cycle = (t * 0.31 + seed * 0.37).fract();\n    let blink = if blink_cycle < 0.035 { 0.08 } else { 1.0 };\n    let nod = if talking { ((t * 5.3 + seed).sin() * 0.018).max(-0.01) } else { 0.0 };\n    let sway = (t * 0.8 + seed).sin();\n    Pose {\n        head: Vec2::new(sway * 0.012, nod + (t * 1.4 + seed).sin() * 0.006),\n        tilt: e.tilt + sway * 0.012,\n        eye_open: e.eye.max(0.2) * blink,\n        pupil: e.pupil.max(0.2),\n        brow_y: e.brow_y + if talking { (t * 7.0 + seed).sin().abs() * 0.012 } else { 0.0 },\n        brow_rot: e.brow_rot,\n        look: Vec2::new((t * 0.53 + seed).sin() * 0.018, 0.0),\n        hair: Vec2::new((t * 1.1 + seed).sin() * 0.018 + (t * 2.7 + seed).sin() * 0.006, (t * 1.3).cos() * 0.006),\n        breathe: (t * 1.5 + seed).sin() * 0.012,\n        flap: if talking { flap_of(t, seed) } else { 0.0 },\n    }\n}\n\n/// Where a point of a part goes under a pose.\npub fn posed(part: &PartGeo, pose: &Pose, q: Vec2) -> Vec2 {\n    let head_pivot = Vec2::new(0.0, -0.55);\n    let turn = |p: Vec2, about: Vec2, a: f32| {\n        let (s, c) = a.sin_cos();\n        let d = p - about;\n        about + Vec2::new(d.x * c - d.y * s, d.x * s + d.y * c)\n    };\n    let mut p = q;\n    match part.layer {\n        Layer::Body => {\n            // Shoulders rise and fall.\n            p.y += pose.breathe * (1.0 + q.y * 0.3);\n            return p;\n        }\n        Layer::Hair => {\n            let weight = ((q.y + 1.0) / 3.0).clamp(0.0, 1.0);\n            p += pose.hair * (1.0 - weight * 0.5);\n        }\n        Layer::Lid => {\n            let c = Vec2::new(0.34 * part.side, 0.35);\n            p.y = c.y + (p.y - c.y) * pose.eye_open;\n        }\n        Layer::Eyes => {\n            let c = Vec2::new(0.34 * part.side, 0.34);\n            let scale = if part.name == \"pupil\" { pose.pupil } else { 1.0 };\n            let d = p - c;\n            p = c + Vec2::new(d.x * scale, d.y * scale * pose.eye_open.min(1.05)) + pose.look;\n        }\n        Layer::Brow => {\n            let c = Vec2::new(0.34 * part.side, 0.58);\n            p = turn(p, c, pose.brow_rot * part.side);\n            p.y += pose.brow_y;\n        }\n        Layer::Head => {}\n    }\n    turn(p, head_pivot, pose.tilt) + pose.head\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn a_concave_outline_triangulates_to_its_own_area() {\n        // An L shape, area 3.\n        let l = [Vec2::new(0.0, 0.0), Vec2::new(2.0, 0.0), Vec2::new(2.0, 1.0), Vec2::new(1.0, 1.0), Vec2::new(1.0, 2.0), Vec2::new(0.0, 2.0)];\n        let o = outline(&l, 0);\n        let mut area = 0.0;\n        for t in o.tris.chunks(3) {\n            let (a, b, c) = (o.points[t[0] as usize], o.points[t[1] as usize], o.points[t[2] as usize]);\n            area += (b - a).perp_dot(c - a) * 0.5;\n        }\n        assert!((area - 3.0).abs() < 1e-3, \"{area}\");\n    }\n\n    #[test]\n    fn every_rig_builds_finite_geometry() {\n        let c = super::super::content::content();\n        for (id, rig) in &c.rigs {\n            let parts = rig_parts(&c, rig);\n            assert!(parts.len() > 10, \"{id}\");\n            for p in &parts {\n                assert!(!p.outline.tris.is_empty(), \"{id}: part {} has no triangles\", p.name);\n                assert!(p.outline.points.iter().all(|q| q.is_finite()));\n            }\n        }\n    }\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3305,"cache_read_input_tokens":405489,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3305},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"9e9f5a6b-cd57-44d7-956a-6a56e257bc01","timestamp":"2026-11-05T14:55:42.374Z","request_id":"req_011CgjyP5v4e6DXc17hBUPaP","wire_tool_inputs":{"toolu_011xwSaWxqUHTG9r8mHSQ1Ss":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery/paper.rs","content":"//! Paper-theatre geometry: closed outlines rounded by Chaikin corner cutting and ear-clipped into\n//! triangles, and the poses that move a rig's parts. The view extrudes these into lit cards; the\n//! HUD flattens the same rig into its cameo.\n\nuse glam::Vec2;\n\nuse super::content::{Content, Expr, Rig, RigPart};\n\n/// One round of corner cutting per `n`; each edge a→b yields a.lerp(b, .25) and a.lerp(b, .75).\npub fn chaikin(points: &[Vec2], n: u8) -> Vec<Vec2> {\n    let mut p = points.to_vec();\n    for _ in 0..n {\n        let mut out = Vec::with_capacity(p.len() * 2);\n        for i in 0..p.len() {\n            let (a, b) = (p[i], p[(i + 1) % p.len()]);\n            out.push(a.lerp(b, 0.25));\n            out.push(a.lerp(b, 0.75));\n        }\n        p = out;\n    }\n    p\n}\n\nfn signed_area(p: &[Vec2]) -> f32 {\n    let mut a = 0.0;\n    for i in 0..p.len() {\n        let (q, r) = (p[i], p[(i + 1) % p.len()]);\n        a += q.x * r.y - r.x * q.y;\n    }\n    a * 0.5\n}\n\nfn in_tri(p: Vec2, a: Vec2, b: Vec2, c: Vec2) -> bool {\n    let s = |u: Vec2, v: Vec2, w: Vec2| (v - u).perp_dot(w - u);\n    s(a, b, p) >= -1e-5 && s(b, c, p) >= -1e-5 && s(c, a, p) >= -1e-5\n}\n\n/// Ear-clips a counter-clockwise outline (concave hair shapes need it).\npub fn triangulate(p: &[Vec2]) -> Vec<u32> {\n    let mut idx: Vec<u32> = (0..p.len() as u32).collect();\n    let mut out = Vec::with_capacity(p.len() * 3);\n    let mut guard = 0;\n    while idx.len() > 3 && guard < p.len() * p.len() + 16 {\n        guard += 1;\n        let n = idx.len();\n        let mut cut = None;\n        for i in 0..n {\n            let (ia, ib, ic) = (idx[(i + n - 1) % n], idx[i], idx[(i + 1) % n]);\n            let (a, b, c) = (p[ia as usize], p[ib as usize], p[ic as usize]);\n            if (b - a).perp_dot(c - b) <= 1e-6 {\n                continue;\n            }\n            let blocked = idx.iter().any(|&j| {\n                j != ia && j != ib && j != ic && in_tri(p[j as usize], a, b, c)\n            });\n            if !blocked {\n                out.extend_from_slice(&[ia, ib, ic]);\n                cut = Some(i);\n                break;\n            }\n        }\n        match cut {\n            Some(i) => {\n                idx.remove(i);\n            }\n            None => {\n                idx.remove(0);\n            }\n        }\n    }\n    if idx.len() == 3 {\n        out.extend_from_slice(&[idx[0], idx[1], idx[2]]);\n    }\n    out\n}\n\n/// A rounded, triangulated outline, counter-clockwise.\n#[derive(Clone, Debug, Default)]\npub struct Outline {\n    pub points: Vec<Vec2>,\n    pub tris: Vec<u32>,\n}\n\npub fn outline(points: &[Vec2], rounding: u8) -> Outline {\n    let mut p = chaikin(points, rounding);\n    if signed_area(&p) < 0.0 {\n        p.reverse();\n    }\n    let tris = triangulate(&p);\n    Outline { points: p, tris }\n}\n\n/// What animation moves a part.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\npub enum Layer {\n    #[default]\n    Body,\n    Head,\n    Hair,\n    Eyes,\n    Lid,\n    Brow,\n}\n\n/// A part ready to draw.\n#[derive(Clone, Debug)]\npub struct PartGeo {\n    pub name: String,\n    pub z: f32,\n    pub color: [u8; 3],\n    pub layer: Layer,\n    /// -1 or 1: which side's eye or brow, for mirrored parts (0 for others).\n    pub side: f32,\n    pub outline: Outline,\n}\n\nfn hex(s: &str) -> [u8; 3] {\n    let t = s.trim_start_matches('#');\n    let v = u32::from_str_radix(t, 16).unwrap_or(0x808080);\n    [(v >> 16) as u8, (v >> 8) as u8, v as u8]\n}\n\nfn color_of(rig: &Rig, name: &str) -> [u8; 3] {\n    if name.starts_with('#') {\n        hex(name)\n    } else {\n        rig.colors.get(name).map(|c| hex(c)).unwrap_or([128, 128, 128])\n    }\n}\n\nfn part_geo(rig: &Rig, p: &RigPart, out: &mut Vec<PartGeo>) {\n    let layer = match p.layer.as_str() {\n        \"head\" => Layer::Head,\n        \"hair\" => Layer::Hair,\n        \"eyes\" => Layer::Eyes,\n        \"lid\" => Layer::Lid,\n        \"brow\" => Layer::Brow,\n        _ => Layer::Body,\n    };\n    let pts: Vec<Vec2> = p.points.iter().map(|q| Vec2::new(q[0], q[1])).collect();\n    if pts.len() < 3 {\n        return;\n    }\n    let mut add = |pts: &[Vec2], side: f32| {\n        out.push(PartGeo {\n            name: p.name.clone(),\n            z: p.z,\n            color: color_of(rig, &p.color),\n            layer,\n            side,\n            outline: outline(pts, p.chaikin),\n        });\n    };\n    if p.mirror {\n        add(&pts, 1.0);\n        let flipped: Vec<Vec2> = pts.iter().map(|q| Vec2::new(-q.x, q.y)).collect();\n        add(&flipped, -1.0);\n    } else {\n        add(&pts, 0.0);\n    }\n}\n\n/// All of a rig's parts (the shared face and its own), back to front.\npub fn rig_parts(c: &Content, rig: &Rig) -> Vec<PartGeo> {\n    let mut out = Vec::new();\n    for p in c.face.part.iter().chain(rig.part.iter()) {\n        part_geo(rig, p, &mut out);\n    }\n    out.sort_by(|a, b| a.z.total_cmp(&b.z));\n    out\n}\n\n/// The mouth outline for a shape and how open it is right now.\npub fn mouth_points(shape: &str, talking: bool, flap: f32) -> Vec<Vec2> {\n    if talking && flap > 0.0 {\n        let o = 0.05 + 0.1 * flap;\n        return vec![\n            Vec2::new(-0.15, -0.255),\n            Vec2::new(0.0, -0.21),\n            Vec2::new(0.15, -0.255),\n            Vec2::new(0.08, -0.255 - o),\n            Vec2::new(-0.08, -0.255 - o),\n        ];\n    }\n    let v = |x: f32, y: f32| Vec2::new(x, y);\n    match shape {\n        \"smile\" => vec![v(-0.18, -0.235), v(0.0, -0.285), v(0.18, -0.235), v(0.0, -0.33)],\n        \"frown\" => vec![v(-0.16, -0.31), v(0.0, -0.25), v(0.16, -0.31), v(0.0, -0.285)],\n        \"flat\" => vec![v(-0.16, -0.27), v(0.16, -0.27), v(0.16, -0.295), v(-0.16, -0.295)],\n        \"open\" => vec![v(-0.1, -0.24), v(0.0, -0.2), v(0.1, -0.24), v(0.07, -0.38), v(-0.07, -0.38)],\n        _ => vec![v(-0.16, -0.26), v(0.0, -0.235), v(0.16, -0.26), v(0.0, -0.285)],\n    }\n}\n\n/// A character's pose this moment.\n#[derive(Clone, Copy, Debug)]\npub struct Pose {\n    pub head: Vec2,\n    pub tilt: f32,\n    pub eye_open: f32,\n    pub pupil: f32,\n    pub brow_y: f32,\n    pub brow_rot: f32,\n    pub look: Vec2,\n    pub hair: Vec2,\n    pub breathe: f32,\n    pub flap: f32,\n}\n\nfn flap_of(t: f32, seed: f32) -> f32 {\n    let v = (t * 15.0 + seed).sin() * 0.5 + 0.5;\n    if v > 0.28 { v } else { 0.0 }\n}\n\n/// Blink, breathe, sway, head nods on speech, hair on springs (as a function of time: paper rigs\n/// are the view's, not the sim's).\npub fn pose_for(expr: Option<&Expr>, t: f32, seed: f32, talking: bool) -> Pose {\n    let e = expr.cloned().unwrap_or(Expr { eye: 1.0, pupil: 1.0, ..Default::default() });\n    let blink_cycle = (t * 0.31 + seed * 0.37).fract();\n    let blink = if blink_cycle < 0.035 { 0.08 } else { 1.0 };\n    let nod = if talking { ((t * 5.3 + seed).sin() * 0.018).max(-0.01) } else { 0.0 };\n    let sway = (t * 0.8 + seed).sin();\n    Pose {\n        head: Vec2::new(sway * 0.012, nod + (t * 1.4 + seed).sin() * 0.006),\n        tilt: e.tilt + sway * 0.012,\n        eye_open: e.eye.max(0.2) * blink,\n        pupil: e.pupil.max(0.2),\n        brow_y: e.brow_y + if talking { (t * 7.0 + seed).sin().abs() * 0.012 } else { 0.0 },\n        brow_rot: e.brow_rot,\n        look: Vec2::new((t * 0.53 + seed).sin() * 0.018, 0.0),\n        hair: Vec2::new((t * 1.1 + seed).sin() * 0.018 + (t * 2.7 + seed).sin() * 0.006, (t * 1.3).cos() * 0.006),\n        breathe: (t * 1.5 + seed).sin() * 0.012,\n        flap: if talking { flap_of(t, seed) } else { 0.0 },\n    }\n}\n\n/// Where a point of a part goes under a pose.\npub fn posed(part: &PartGeo, pose: &Pose, q: Vec2) -> Vec2 {\n    let head_pivot = Vec2::new(0.0, -0.55);\n    let turn = |p: Vec2, about: Vec2, a: f32| {\n        let (s, c) = a.sin_cos();\n        let d = p - about;\n        about + Vec2::new(d.x * c - d.y * s, d.x * s + d.y * c)\n    };\n    let mut p = q;\n    match part.layer {\n        Layer::Body => {\n            // Shoulders rise and fall.\n            p.y += pose.breathe * (1.0 + q.y * 0.3);\n            return p;\n        }\n        Layer::Hair => {\n            let weight = ((q.y + 1.0) / 3.0).clamp(0.0, 1.0);\n            p += pose.hair * (1.0 - weight * 0.5);\n        }\n        Layer::Lid => {\n            let c = Vec2::new(0.34 * part.side, 0.35);\n            p.y = c.y + (p.y - c.y) * pose.eye_open;\n        }\n        Layer::Eyes => {\n            let c = Vec2::new(0.34 * part.side, 0.34);\n            let scale = if part.name == \"pupil\" { pose.pupil } else { 1.0 };\n            let d = p - c;\n            p = c + Vec2::new(d.x * scale, d.y * scale * pose.eye_open.min(1.05)) + pose.look;\n        }\n        Layer::Brow => {\n            let c = Vec2::new(0.34 * part.side, 0.58);\n            p = turn(p, c, pose.brow_rot * part.side);\n            p.y += pose.brow_y;\n        }\n        Layer::Head => {}\n    }\n    turn(p, head_pivot, pose.tilt) + pose.head\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn a_concave_outline_triangulates_to_its_own_area() {\n        // An L shape, area 3.\n        let l = [Vec2::new(0.0, 0.0), Vec2::new(2.0, 0.0), Vec2::new(2.0, 1.0), Vec2::new(1.0, 1.0), Vec2::new(1.0, 2.0), Vec2::new(0.0, 2.0)];\n        let o = outline(&l, 0);\n        let mut area = 0.0;\n        for t in o.tris.chunks(3) {\n            let (a, b, c) = (o.points[t[0] as usize], o.points[t[1] as usize], o.points[t[2] as usize]);\n            area += (b - a).perp_dot(c - a) * 0.5;\n        }\n        assert!((area - 3.0).abs() < 1e-3, \"{area}\");\n    }\n\n    #[test]\n    fn every_rig_builds_finite_geometry() {\n        let c = super::super::content::content();\n        for (id, rig) in &c.rigs {\n            let parts = rig_parts(&c, rig);\n            assert!(parts.len() > 10, \"{id}\");\n            for p in &parts {\n                assert!(!p.outline.tris.is_empty(), \"{id}: part {} has no triangles\", p.name);\n                assert!(p.outline.points.iter().all(|q| q.is_finite()));\n            }\n        }\n    }\n}\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011xwSaWxqUHTG9r8mHSQ1Ss","type":"tool_result","content":"File created successfully at: /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery/paper.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"ee1fc186-ceb5-417a-a0bc-a5402d783213","timestamp":"2026-11-05T14:55:42.444Z","tool_use_result":{"type":"create","filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery/paper.rs","content":"//! Paper-theatre geometry: closed outlines rounded by Chaikin corner cutting and ear-clipped into\n//! triangles, and the poses that move a rig's parts. The view extrudes these into lit cards; the\n//! HUD flattens the same rig into its cameo.\n\nuse glam::Vec2;\n\nuse super::content::{Content, Expr, Rig, RigPart};\n\n/// One round of corner cutting per `n`; each edge a→b yields a.lerp(b, .25) and a.lerp(b, .75).\npub fn chaikin(points: &[Vec2], n: u8) -> Vec<Vec2> {\n    let mut p = points.to_vec();\n    for _ in 0..n {\n        let mut out = Vec::with_capacity(p.len() * 2);\n        for i in 0..p.len() {\n            let (a, b) = (p[i], p[(i + 1) % p.len()]);\n            out.push(a.lerp(b, 0.25));\n            out.push(a.lerp(b, 0.75));\n        }\n        p = out;\n    }\n    p\n}\n\nfn signed_area(p: &[Vec2]) -> f32 {\n    let mut a = 0.0;\n    for i in 0..p.len() {\n        let (q, r) = (p[i], p[(i + 1) % p.len()]);\n        a += q.x * r.y - r.x * q.y;\n    }\n    a * 0.5\n}\n\nfn in_tri(p: Vec2, a: Vec2, b: Vec2, c: Vec2) -> bool {\n    let s = |u: Vec2, v: Vec2, w: Vec2| (v - u).perp_dot(w - u);\n    s(a, b, p) >= -1e-5 && s(b, c, p) >= -1e-5 && s(c, a, p) >= -1e-5\n}\n\n/// Ear-clips a counter-clockwise outline (concave hair shapes need it).\npub fn triangulate(p: &[Vec2]) -> Vec<u32> {\n    let mut idx: Vec<u32> = (0..p.len() as u32).collect();\n    let mut out = Vec::with_capacity(p.len() * 3);\n    let mut guard = 0;\n    while idx.len() > 3 && guard < p.len() * p.len() + 16 {\n        guard += 1;\n        let n = idx.len();\n        let mut cut = None;\n        for i in 0..n {\n            let (ia, ib, ic) = (idx[(i + n - 1) % n], idx[i], idx[(i + 1) % n]);\n            let (a, b, c) = (p[ia as usize], p[ib as usize], p[ic as usize]);\n            if (b - a).perp_dot(c - b) <= 1e-6 {\n                continue;\n            }\n            let blocked = idx.iter().any(|&j| {\n                j != ia && j != ib && j != ic && in_tri(p[j as usize], a, b, c)\n            });\n            if !blocked {\n                out.extend_from_slice(&[ia, ib, ic]);\n                cut = Some(i);\n                break;\n            }\n        }\n        match cut {\n            Some(i) => {\n                idx.remove(i);\n            }\n            None => {\n                idx.remove(0);\n            }\n        }\n    }\n    if idx.len() == 3 {\n        out.extend_from_slice(&[idx[0], idx[1], idx[2]]);\n    }\n    out\n}\n\n/// A rounded, triangulated outline, counter-clockwise.\n#[derive(Clone, Debug, Default)]\npub struct Outline {\n    pub points: Vec<Vec2>,\n    pub tris: Vec<u32>,\n}\n\npub fn outline(points: &[Vec2], rounding: u8) -> Outline {\n    let mut p = chaikin(points, rounding);\n    if signed_area(&p) < 0.0 {\n        p.reverse();\n    }\n    let tris = triangulate(&p);\n    Outline { points: p, tris }\n}\n\n/// What animation moves a part.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\npub enum Layer {\n    #[default]\n    Body,\n    Head,\n    Hair,\n    Eyes,\n    Lid,\n    Brow,\n}\n\n/// A part ready to draw.\n#[derive(Clone, Debug)]\npub struct PartGeo {\n    pub name: String,\n    pub z: f32,\n    pub color: [u8; 3],\n    pub layer: Layer,\n    /// -1 or 1: which side's eye or brow, for mirrored parts (0 for others).\n    pub side: f32,\n    pub outline: Outline,\n}\n\nfn hex(s: &str) -> [u8; 3] {\n    let t = s.trim_start_matches('#');\n    let v = u32::from_str_radix(t, 16).unwrap_or(0x808080);\n    [(v >> 16) as u8, (v >> 8) as u8, v as u8]\n}\n\nfn color_of(rig: &Rig, name: &str) -> [u8; 3] {\n    if name.starts_with('#') {\n        hex(name)\n    } else {\n        rig.colors.get(name).map(|c| hex(c)).unwrap_or([128, 128, 128])\n    }\n}\n\nfn part_geo(rig: &Rig, p: &RigPart, out: &mut Vec<PartGeo>) {\n    let layer = match p.layer.as_str() {\n        \"head\" => Layer::Head,\n        \"hair\" => Layer::Hair,\n        \"eyes\" => Layer::Eyes,\n        \"lid\" => Layer::Lid,\n        \"brow\" => Layer::Brow,\n        _ => Layer::Body,\n    };\n    let pts: Vec<Vec2> = p.points.iter().map(|q| Vec2::new(q[0], q[1])).collect();\n    if pts.len() < 3 {\n        return;\n    }\n    let mut add = |pts: &[Vec2], side: f32| {\n        out.push(PartGeo {\n            name: p.name.clone(),\n            z: p.z,\n            color: color_of(rig, &p.color),\n            layer,\n            side,\n            outline: outline(pts, p.chaikin),\n        });\n    };\n    if p.mirror {\n        add(&pts, 1.0);\n        let flipped: Vec<Vec2> = pts.iter().map(|q| Vec2::new(-q.x, q.y)).collect();\n        add(&flipped, -1.0);\n    } else {\n        add(&pts, 0.0);\n    }\n}\n\n/// All of a rig's parts (the shared face and its own), back to front.\npub fn rig_parts(c: &Content, rig: &Rig) -> Vec<PartGeo> {\n    let mut out = Vec::new();\n    for p in c.face.part.iter().chain(rig.part.iter()) {\n        part_geo(rig, p, &mut out);\n    }\n    out.sort_by(|a, b| a.z.total_cmp(&b.z));\n    out\n}\n\n/// The mouth outline for a shape and how open it is right now.\npub fn mouth_points(shape: &str, talking: bool, flap: f32) -> Vec<Vec2> {\n    if talking && flap > 0.0 {\n        let o = 0.05 + 0.1 * flap;\n        return vec![\n            Vec2::new(-0.15, -0.255),\n            Vec2::new(0.0, -0.21),\n            Vec2::new(0.15, -0.255),\n            Vec2::new(0.08, -0.255 - o),\n            Vec2::new(-0.08, -0.255 - o),\n        ];\n    }\n    let v = |x: f32, y: f32| Vec2::new(x, y);\n    match shape {\n        \"smile\" => vec![v(-0.18, -0.235), v(0.0, -0.285), v(0.18, -0.235), v(0.0, -0.33)],\n        \"frown\" => vec![v(-0.16, -0.31), v(0.0, -0.25), v(0.16, -0.31), v(0.0, -0.285)],\n        \"flat\" => vec![v(-0.16, -0.27), v(0.16, -0.27), v(0.16, -0.295), v(-0.16, -0.295)],\n        \"open\" => vec![v(-0.1, -0.24), v(0.0, -0.2), v(0.1, -0.24), v(0.07, -0.38), v(-0.07, -0.38)],\n        _ => vec![v(-0.16, -0.26), v(0.0, -0.235), v(0.16, -0.26), v(0.0, -0.285)],\n    }\n}\n\n/// A character's pose this moment.\n#[derive(Clone, Copy, Debug)]\npub struct Pose {\n    pub head: Vec2,\n    pub tilt: f32,\n    pub eye_open: f32,\n    pub pupil: f32,\n    pub brow_y: f32,\n    pub brow_rot: f32,\n    pub look: Vec2,\n    pub hair: Vec2,\n    pub breathe: f32,\n    pub flap: f32,\n}\n\nfn flap_of(t: f32, seed: f32) -> f32 {\n    let v = (t * 15.0 + seed).sin() * 0.5 + 0.5;\n    if v > 0.28 { v } else { 0.0 }\n}\n\n/// Blink, breathe, sway, head nods on speech, hair on springs (as a function of time: paper rigs\n/// are the view's, not the sim's).\npub fn pose_for(expr: Option<&Expr>, t: f32, seed: f32, talking: bool) -> Pose {\n    let e = expr.cloned().unwrap_or(Expr { eye: 1.0, pupil: 1.0, ..Default::default() });\n    let blink_cycle = (t * 0.31 + seed * 0.37).fract();\n    let blink = if blink_cycle < 0.035 { 0.08 } else { 1.0 };\n    let nod = if talking { ((t * 5.3 + seed).sin() * 0.018).max(-0.01) } else { 0.0 };\n    let sway = (t * 0.8 + seed).sin();\n    Pose {\n        head: Vec2::new(sway * 0.012, nod + (t * 1.4 + seed).sin() * 0.006),\n        tilt: e.tilt + sway * 0.012,\n        eye_open: e.eye.max(0.2) * blink,\n        pupil: e.pupil.max(0.2),\n        brow_y: e.brow_y + if talking { (t * 7.0 + seed).sin().abs() * 0.012 } else { 0.0 },\n        brow_rot: e.brow_rot,\n        look: Vec2::new((t * 0.53 + seed).sin() * 0.018, 0.0),\n        hair: Vec2::new((t * 1.1 + seed).sin() * 0.018 + (t * 2.7 + seed).sin() * 0.006, (t * 1.3).cos() * 0.006),\n        breathe: (t * 1.5 + seed).sin() * 0.012,\n        flap: if talking { flap_of(t, seed) } else { 0.0 },\n    }\n}\n\n/// Where a point of a part goes under a pose.\npub fn posed(part: &PartGeo, pose: &Pose, q: Vec2) -> Vec2 {\n    let head_pivot = Vec2::new(0.0, -0.55);\n    let turn = |p: Vec2, about: Vec2, a: f32| {\n        let (s, c) = a.sin_cos();\n        let d = p - about;\n        about + Vec2::new(d.x * c - d.y * s, d.x * s + d.y * c)\n    };\n    let mut p = q;\n    match part.layer {\n        Layer::Body => {\n            // Shoulders rise and fall.\n            p.y += pose.breathe * (1.0 + q.y * 0.3);\n            return p;\n        }\n        Layer::Hair => {\n            let weight = ((q.y + 1.0) / 3.0).clamp(0.0, 1.0);\n            p += pose.hair * (1.0 - weight * 0.5);\n        }\n        Layer::Lid => {\n            let c = Vec2::new(0.34 * part.side, 0.35);\n            p.y = c.y + (p.y - c.y) * pose.eye_open;\n        }\n        Layer::Eyes => {\n            let c = Vec2::new(0.34 * part.side, 0.34);\n            let scale = if part.name == \"pupil\" { pose.pupil } else { 1.0 };\n            let d = p - c;\n            p = c + Vec2::new(d.x * scale, d.y * scale * pose.eye_open.min(1.05)) + pose.look;\n        }\n        Layer::Brow => {\n            let c = Vec2::new(0.34 * part.side, 0.58);\n            p = turn(p, c, pose.brow_rot * part.side);\n            p.y += pose.brow_y;\n        }\n        Layer::Head => {}\n    }\n    turn(p, head_pivot, pose.tilt) + pose.head\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn a_concave_outline_triangulates_to_its_own_area() {\n        // An L shape, area 3.\n        let l = [Vec2::new(0.0, 0.0), Vec2::new(2.0, 0.0), Vec2::new(2.0, 1.0), Vec2::new(1.0, 1.0), Vec2::new(1.0, 2.0), Vec2::new(0.0, 2.0)];\n        let o = outline(&l, 0);\n        let mut area = 0.0;\n        for t in o.tris.chunks(3) {\n            let (a, b, c) = (o.points[t[0] as usize], o.points[t[1] as usize], o.points[t[2] as usize]);\n            area += (b - a).perp_dot(c - a) * 0.5;\n        }\n        assert!((area - 3.0).abs() < 1e-3, \"{area}\");\n    }\n\n    #[test]\n    fn every_rig_builds_finite_geometry() {\n        let c = super::super::content::content();\n        for (id, rig) in &c.rigs {\n            let parts = rig_parts(&c, rig);\n            assert!(parts.len() > 10, \"{id}\");\n            for p in &parts {\n                assert!(!p.outline.tris.is_empty(), \"{id}: part {} has no triangles\", p.name);\n                assert!(p.outline.points.iter().all(|q| q.is_finite()));\n            }\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_011xwSaWxqUHTG9r8mHSQ1Ss","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
