{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgk2KQ5SYpTEC49bsT98D","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LyVacs5RiByc4b26pX8Ec2","name":"Bash","input":{"command":"mkdir -p ../tests/browser; cat > ../tests/run_all.py <<'EOF'\n#!/usr/bin/env python3\n\"\"\"The one test command. Prints only failures and a one-line count.\nusage: python3 tests/run_all.py [--rust|--web|--hub]\"\"\"\nimport pathlib, re, subprocess, sys\n\nROOT = pathlib.Path(__file__).resolve().parent\nENGINE = ROOT.parent / \"engine\"\nwhich = sys.argv[1] if len(sys.argv) > 1 else \"--all\"\npassed = failed = 0\n\ndef report(name, ok, detail=\"\"):\n    global passed, failed\n    if ok:\n        passed += 1\n    else:\n        failed += 1\n        print(f\"FAIL {name}\\n{detail[-3000:]}\")\n\ndef rust():\n    global passed, failed\n    for pkg, extra in [(\"pav_core\", [\"--test\", \"surgery\"]), (\"pav_core\", [\"--lib\", \"surgery\"]), (\"pav_audio\", []), (\"pav_ui\", [\"--lib\"])]:\n        cmd = [str(ROOT.parent / \"tools\" / \"cb.sh\"), \"test\", \"-p\", pkg, *extra]\n        r = subprocess.run(cmd, cwd=ENGINE, capture_output=True, text=True)\n        out = r.stdout + r.stderr\n        ok_tests = re.findall(r\"^test .* \\.\\.\\. ok$\", out, re.M)\n        bad = re.findall(r\"^test (.*) \\.\\.\\. FAILED$\", out, re.M)\n        passed += len(ok_tests)\n        for b in bad:\n            failed += 1\n            m = re.search(r\"---- \" + re.escape(b) + r\" stdout ----(.*?)(?=\\n---- |\\nfailures:)\", out, re.S)\n            print(f\"FAIL rust {pkg}::{b}\\n{(m.group(1) if m else '').strip()[:1500]}\")\n        if r.returncode != 0 and not bad:\n            report(f\"rust build {pkg} {extra}\", False, out)\n\ndef web(suite):\n    r = subprocess.run([sys.executable, str(ROOT / \"browser\" / suite)], capture_output=True, text=True, cwd=ROOT)\n    global passed, failed\n    for line in r.stdout.splitlines():\n        if line.startswith(\"PASS \"):\n            passed += 1\n        elif line.startswith(\"FAIL \"):\n            failed += 1\n            print(line)\n        elif line.startswith(\"  \"):\n            print(line)\n    if r.returncode != 0:\n        report(f\"{suite} crashed\", False, r.stderr)\n\nif which in (\"--all\", \"--rust\"):\n    rust()\nif which in (\"--all\", \"--web\"):\n    web(\"web_tests.py\")\nif which in (\"--all\", \"--web\", \"--hub\"):\n    web(\"hub_tests.py\")\nprint(f\"{passed} passed, {failed} failed\")\nsys.exit(1 if failed else 0)\nEOF\ncat > ../tests/browser/common.py <<'EOF'\n\"\"\"Shared bits for the browser tests: the built single file, Chromium flags, stand-ins.\"\"\"\nimport glob, json, os, pathlib, time\n\nROOT = pathlib.Path(__file__).resolve().parents[2]\nGAME = sorted(glob.glob(str(ROOT.parent / \"*.html\")))[0]\nARGS = [\"--enable-unsafe-webgpu\", \"--enable-features=Vulkan\", \"--use-webgpu-adapter=swiftshader\", \"--use-vulkan=swiftshader\", \"--use-angle=swiftshader\"]\nOUT = ROOT / \"tests\" / \"out\"\nOUT.mkdir(parents=True, exist_ok=True)\n\nPAD = \"\"\"\n(() => { const buttons = Array.from({length: 17}, () => ({pressed: false, touched: false, value: 0}));\n  const pad = {id: 'DualSense Wireless Controller (STANDARD GAMEPAD)', index: 0, connected: true,\n               mapping: 'standard', timestamp: 0, axes: [0,0,0,0], buttons};\n  window.__pad = pad; navigator.getGamepads = () => [pad, null, null, null]; })();\n\"\"\"\n\nTAP = \"\"\"\n(() => { const real = AudioNode.prototype.connect; window.__an = [];\n  AudioNode.prototype.connect = function (dest, ...rest) { const r = real.call(this, dest, ...rest);\n    if (dest instanceof AudioDestinationNode) { const c = this.context;\n      if (!c.__an) { c.__an = c.createAnalyser(); c.__an.fftSize = 2048; window.__an.push(c.__an); } real.call(this, c.__an); }\n    return r; };\n  window.__peak = () => { let m = 0; for (const a of window.__an) { const b = new Float32Array(a.fftSize);\n    a.getFloatTimeDomainData(b); for (const v of b) m = Math.max(m, Math.abs(v)); } return m; }; })();\n\"\"\"\n\nclass Page:\n    \"\"\"A page of the game with helpers that don't wait on real-time play.\"\"\"\n    def __init__(self, browser, query=\"\", init=(), viewport=(960, 540), url=None, **ctx):\n        self.ctx = browser.new_context(viewport={\"width\": viewport[0], \"height\": viewport[1]}, **ctx)\n        self.page = self.ctx.new_page()\n        self.errors = []\n        self.page.on(\"console\", lambda m: self.errors.append(m.text) if m.type == \"error\" else None)\n        self.page.on(\"pageerror\", lambda e: self.errors.append(str(e)))\n        for s in init:\n            self.page.add_init_script(s)\n        self.page.goto(url or (pathlib.Path(GAME).as_uri() + query))\n\n    def status(self):\n        t = self.page.evaluate(\"window.__game ? __game.status() : ''\")\n        return json.loads(t) if t else {}\n\n    def wait(self, pred, timeout=90, every=0.15, what=\"\"):\n        end = time.time() + timeout\n        last = {}\n        while time.time() < end:\n            last = self.status()\n            try:\n                if last and pred(last):\n                    return last\n            except (KeyError, TypeError, IndexError):\n                pass\n            time.sleep(every)\n        raise TimeoutError(f\"timed out waiting for {what}; last: {json.dumps(last)[:600]}\")\n\n    def frames(self, n=3, timeout=60):\n        \"\"\"Wait until n more frames were drawn, so input has been read and acted on.\"\"\"\n        start = self.status().get(\"frames\", 0)\n        self.wait(lambda s: s.get(\"frames\", 0) >= start + n * 2, timeout=timeout, what=\"frames\")\n\n    def do(self, obj):\n        self.page.evaluate(\"(j) => __game.do(j)\", json.dumps(obj))\n\n    def key(self, k):\n        self.page.keyboard.press(k)\n        self.frames(2)\n\n    def pad(self, js):\n        self.page.evaluate(\"() => {\" + js + \"; __pad.timestamp++; }\")\n\n    def press(self, b):\n        self.pad(f\"__pad.buttons[{b}].pressed=true; __pad.buttons[{b}].value=1\")\n        self.frames(2)\n        self.pad(f\"__pad.buttons[{b}].pressed=false; __pad.buttons[{b}].value=0\")\n        self.frames(2)\n\n    def close(self):\n        self.ctx.close()\n\nclass Results:\n    def __init__(self):\n        self.n = 0\n    def check(self, name, ok, detail=\"\"):\n        print((\"PASS \" if ok else \"FAIL \") + name + (\"\" if ok else f\": {str(detail)[:700]}\"), flush=True)\n    def run(self, name, fn):\n        try:\n            fn()\n            print(\"PASS \" + name, flush=True)\n        except Exception as e:  # a failed step shouldn't stop the rest\n            print(\"FAIL \" + name + \": \" + str(e)[:900].replace(\"\\n\", \" \"), flush=True)\nEOF\ncat > ../tests/browser/web_tests.py <<'EOF'\n#!/usr/bin/env python3\n\"\"\"Browser tests of the built single file, on file://, checked through window.__game.\"\"\"\nimport json, sys, time, pathlib\nsys.path.insert(0, str(pathlib.Path(__file__).parent))\nfrom common import *\nfrom playwright.sync_api import sync_playwright\n\nR = Results()\n\ndef boots(b):\n    p = Page(b, init=[TAP])\n    st = p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\" and s[\"frames\"] > 4, what=\"title\")\n    assert \"Trauma Tempo\" == p.page.title(), p.page.title()\n    assert st[\"title\"] == \"Trauma Tempo\"\n    assert \"Trauma Tempo\" in st[\"shell\"][\"texts\"], st[\"shell\"][\"texts\"]\n    assert not [e for e in p.errors if \"GPU\" not in e and \"favicon\" not in e], p.errors\n    # None of the engine's overlays.\n    for bad in [\"Shardfall\", \"F1 tuning\", \"Esc menu\", \"boot\"]:\n        assert not any(bad in t for t in st[\"shell\"][\"texts\"]), bad\n    assert p.page.evaluate(\"document.querySelector('canvas') != null\")\n    assert st[\"bus\"][\"music\"] == 0.1, st[\"bus\"]\n    p.close()\n\ndef keyboard_and_mouse(b):\n    p = Page(b)\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\" and s[\"frames\"] > 4, what=\"title\")\n    p.key(\"Enter\")\n    st = p.wait(lambda s: s[\"shell\"][\"screen\"] == \"menu\", what=\"menu\")\n    assert any(x.startswith(\"key:\") for x in st[\"shell\"][\"prompts\"]), st[\"shell\"][\"prompts\"]\n    f0 = st[\"shell\"][\"focus\"]\n    p.key(\"ArrowDown\")\n    st = p.wait(lambda s: s[\"shell\"][\"focus\"] != f0, what=\"arrow moved focus\")\n    # Hover moves the focus and a click activates: About is the last of six, at about y=856 of 1080.\n    p.page.mouse.move(480, 856 / 1080 * 540)\n    p.frames(2)\n    p.page.mouse.move(482, 856 / 1080 * 540)\n    st = p.wait(lambda s: s[\"shell\"][\"focus\"] == 5, what=\"hover focus\")\n    p.page.mouse.click(482, 856 / 1080 * 540)\n    st = p.wait(lambda s: s[\"shell\"][\"screen\"] == \"about\", what=\"click about\")\n    texts = st[\"shell\"][\"texts\"]\n    for sec in [\"Credits\", \"Source Information\", \"Testing Feedback\", \"Engine Feedback\", \"Prompt Feedback\"]:\n        assert f\"section:{sec}\" in texts, sec\n    p.key(\"Escape\")\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"menu\", what=\"back\")\n    p.close()\n\ndef tools_by_keys_wheel_tray(b):\n    p = Page(b, query=\"?scene=surgery/case/2\")\n    p.wait(lambda s: s[\"sim\"] and s[\"sim\"][\"stage\"] == \"Op\" and s[\"frames\"] > 3, what=\"op\")\n    p.do({\"paused\": False})\n    p.page.mouse.move(400, 300)\n    p.key(\"3\")\n    p.wait(lambda s: s[\"sim\"][\"ring_pos\"] == 2, what=\"digit tool\")\n    p.page.mouse.wheel(0, 200)\n    p.wait(lambda s: s[\"sim\"][\"ring_pos\"] == 3, what=\"wheel down cycles\")\n    # A click on the tray picks the instrument there: find slot 7's screen position roughly.\n    st = p.status()\n    p.page.mouse.move(480, 500)\n    p.frames(2)\n    p.page.mouse.click(480, 505)\n    p.wait(lambda s: s[\"sim\"][\"ring_pos\"] in (3, 4), what=\"tray click\")\n    # The mouse aims absolutely.\n    p.page.mouse.move(600, 260)\n    st = p.wait(lambda s: s[\"sim\"][\"cursor\"][0] > 0.5, what=\"mouse aim\")\n    p.page.mouse.down()\n    p.wait(lambda s: s[\"sim\"][\"using\"], what=\"left button uses\")\n    p.page.mouse.up()\n    assert any(x.startswith(\"mouse:\") for x in p.status()[\"shell\"][\"prompts\"])\n    p.close()\n\ndef pad_flow(b):\n    p = Page(b, init=[PAD])\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\" and s[\"frames\"] > 3, what=\"title\")\n    p.press(0)\n    st = p.wait(lambda s: s[\"shell\"][\"screen\"] == \"menu\", what=\"pad to menu\")\n    assert st[\"device\"] == \"pad\"\n    assert \"ps:cross\" in st[\"shell\"][\"prompts\"] or \"stick:d\" in st[\"shell\"][\"prompts\"], st[\"shell\"][\"prompts\"]\n    f0 = st[\"shell\"][\"focus\"]\n    p.press(13)  # D-pad down\n    p.wait(lambda s: s[\"shell\"][\"focus\"] != f0, what=\"dpad\")\n    # Into a case with the pad.\n    p.do({\"load\": \"surgery/case/2\"})\n    p.wait(lambda s: s[\"sim\"] and s[\"sim\"][\"stage\"] == \"Op\", what=\"op\")\n    # The right stick moves the cursor.\n    c0 = p.status()[\"sim\"][\"cursor\"]\n    p.pad(\"__pad.axes[2]=1\")\n    p.wait(lambda s: s[\"sim\"][\"cursor\"][0] > c0[0] + 0.5, what=\"right stick\")\n    p.pad(\"__pad.axes[2]=0\")\n    # Flick selects a tool, instantly: right is ring position 2.\n    p.pad(\"__pad.axes[0]=1\")\n    p.wait(lambda s: s[\"sim\"][\"ring_pos\"] == 2, what=\"flick right\")\n    p.pad(\"__pad.axes[0]=0\")\n    p.frames(2)\n    # Analog R2 reaches the sim.\n    p.pad(\"__pad.buttons[7].pressed=true; __pad.buttons[7].value=0.5\")\n    st = p.wait(lambda s: s[\"sim\"][\"using\"] and 0.3 < s[\"sim\"][\"pressure\"] < 0.7, what=\"analog R2\")\n    p.pad(\"__pad.buttons[7].pressed=false; __pad.buttons[7].value=0\")\n    p.frames(2)\n    # Options pauses; Circle resumes.\n    p.press(9)\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"pause\" and s[\"paused\"], what=\"options pauses\")\n    p.press(1)\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"playing\" and not s[\"paused\"], what=\"circle resumes\")\n    # Options is ignored while Create is held.\n    p.pad(\"__pad.buttons[8].pressed=true; __pad.buttons[8].value=1\")\n    p.frames(2)\n    p.press(9)\n    p.frames(2)\n    assert p.status()[\"shell\"][\"screen\"] == \"playing\"\n    p.pad(\"__pad.buttons[8].pressed=false; __pad.buttons[8].value=0\")\n    # Prompts flip the moment another device is touched.\n    p.key(\"Tab\")\n    st = p.wait(lambda s: s[\"device\"] == \"keys\", what=\"flip to keys\")\n    p.frames(2)\n    assert any(x.startswith(\"mouse:\") or x.startswith(\"key:\") for x in p.status()[\"shell\"][\"prompts\"])\n    p.key(\"Tab\")\n    p.close()\n\ndef xbox_setting_persists(b):\n    ctx_page = Page(b, init=[PAD])\n    p = ctx_page\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\" and s[\"frames\"] > 3, what=\"title\")\n    p.do({\"screen\": \"settings\", \"page\": 1})\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"settings\", what=\"settings\")\n    p.press(0)  # focus is Button prompts: Cross toggles it\n    st = p.wait(lambda s: s[\"shell\"][\"settings\"][\"xbox\"], what=\"xbox on\")\n    # Settings persist across a reload.\n    p.page.reload()\n    st = p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\" and s[\"frames\"] > 3, what=\"reload\")\n    assert st[\"shell\"][\"settings\"][\"xbox\"] is True\n    p.press(0)\n    st = p.wait(lambda s: s[\"shell\"][\"screen\"] == \"menu\", what=\"menu\")\n    assert any(x.startswith(\"xb:\") for x in st[\"shell\"][\"prompts\"]), st[\"shell\"][\"prompts\"]\n    p.close()\n\ndef attract(b):\n    p = Page(b, init=[PAD])\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\" and s[\"frames\"] > 3, what=\"title\")\n    t0 = time.time()\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"attract\", timeout=40, what=\"attract at 10 s\")\n    took = time.time() - t0\n    assert 6 < took < 30, took\n    st = p.wait(lambda s: s[\"sim\"] and s[\"sim\"][\"demo\"], what=\"demo running\")\n    assert \"DEMO\" in p.wait(lambda s: \"DEMO\" in s[\"shell\"][\"texts\"], what=\"DEMO text\")[\"shell\"][\"texts\"]\n    p.page.keyboard.press(\"x\")\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\", what=\"key exits\")\n    # Pad exits.\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"attract\", timeout=40, what=\"attract again\")\n    p.press(0)\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\", what=\"pad exits\")\n    # Mouse exits.\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"attract\", timeout=40, what=\"attract a third time\")\n    p.page.mouse.move(100, 100)\n    p.page.mouse.move(200, 200)\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\", what=\"mouse exits\")\n    p.close()\n\ndef touch_only(b, playwright):\n    device = playwright.devices[\"Pixel 7\"]\n    ctx = {k: v for k, v in device.items() if k not in (\"viewport\", \"default_browser_type\")}\n    p = Page(b, viewport=(device[\"viewport\"][\"height\"], device[\"viewport\"][\"width\"]), **ctx)\n    st = p.wait(lambda s: s[\"shell\"][\"touch_only\"] and \"Controller or keyboard required\" in s[\"shell\"][\"texts\"], what=\"message\")\n    # A Settings button a tap can use; no touch controls.\n    vw, vh = device[\"viewport\"][\"height\"], device[\"viewport\"][\"width\"]\n    p.page.touchscreen.tap(vw / 2, vh * 800 / 1080)\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"settings\", what=\"tap settings\")\n    p.page.touchscreen.tap(vw / 2, vh * 940 / 1080)\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\", what=\"tap back\")\n    # Attract still runs.\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"attract\", timeout=40, what=\"touch attract\")\n    assert not any(\"Shardfall\" in t for t in p.status()[\"shell\"][\"texts\"])\n    p.close()\n\ndef webkit_iphone(playwright):\n    device = playwright.devices[\"iPhone 14\"]\n    wb = playwright.webkit.launch()\n    ctx = wb.new_context(**{k: v for k, v in device.items() if k != \"default_browser_type\"})\n    page = ctx.new_page()\n    page.goto(pathlib.Path(GAME).as_uri())\n    page.wait_for_timeout(3000)\n    txt = page.evaluate(\"document.body.innerText\")\n    # No WebGPU here: the page's clear message, or (with WebGPU) the game running.\n    has_gpu = page.evaluate(\"!!navigator.gpu\")\n    assert has_gpu or \"WebGPU\" in txt, txt[:200]\n    wb.close()\n\ndef audio_runs(b):\n    p = Page(b, init=[TAP])\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\" and s[\"frames\"] > 3, what=\"title\")\n    p.key(\"Enter\")  # a gesture\n    st = p.status()\n    assert st[\"bus\"][\"music\"] == 0.1\n    end = time.time() + 30\n    peak = 0\n    while time.time() < end and peak < 0.001:\n        peak = p.page.evaluate(\"window.__peak()\")\n        time.sleep(0.2)\n    assert peak > 0.001, f\"silent: {peak}\"\n    # The music bus really is playing, at its low level.\n    st = p.wait(lambda s: s[\"peaks\"][1] > 0, timeout=30, what=\"music peak\")\n    p.close()\n\ndef dev_mode(b):\n    p = Page(b, query=\"?scene=surgery/case/3\")\n    p.wait(lambda s: s[\"sim\"] and s[\"sim\"][\"stage\"] == \"Op\" and s[\"frames\"] > 3, what=\"op\")\n    p.key(\"Escape\")\n    st = p.wait(lambda s: s[\"shell\"][\"screen\"] == \"pause\", what=\"pause\")\n    for t in [\"Resume\", \"Restart\", \"Controls\", \"Settings\", \"Dev Mode\", \"Quit to Title\"]:\n        assert t in st[\"shell\"][\"texts\"], t\n    # Dev Mode is fifth.\n    for _ in range(4):\n        p.key(\"ArrowDown\")\n    p.key(\"Enter\")\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"dev\", what=\"dev\")\n    # A balance page: slide the first slider, then Reset All.\n    p.do({\"page\": 3})\n    p.frames(2)\n    p.key(\"ArrowRight\")\n    st = p.wait(lambda s: abs(s[\"shell\"][\"tune\"][\"drain\"] - 1.0) > 0.05, what=\"slider moved\")\n    for _ in range(6):\n        p.key(\"ArrowDown\")\n    p.key(\"Enter\")\n    p.wait(lambda s: abs(s[\"shell\"][\"tune\"][\"drain\"] - 1.0) < 0.001, what=\"reset\")\n    p.close()\n\ndef whole_campaign(b):\n    p = Page(b)\n    p.wait(lambda s: s[\"frames\"] > 3, what=\"start\")\n    p.do({\"load\": \"surgery/campaign\", \"bot\": True})\n    p.wait(lambda s: s[\"sim\"] and s[\"sim\"][\"stage\"] == \"Story\", what=\"campaign start\")\n    p.page.evaluate(\"__game.step(300000)\")\n    st = p.wait(lambda s: s[\"outcome\"] in (\"won\", \"lost\") or s[\"shell\"][\"screen\"] == \"menu\", timeout=500, every=1.0, what=\"campaign end\")\n    assert st[\"outcome\"] != \"lost\", json.dumps(st)[:500]\n    p.close()\n\ndef screenshots(b):\n    p = Page(b, viewport=(1920, 1080))\n    p.wait(lambda s: s[\"frames\"] > 2, what=\"start\", timeout=120)\n    time.sleep(1)\n    p.page.screenshot(path=str(OUT / \"title.png\"))\n    p.do({\"load\": \"surgery/case/3/2\", \"bot\": True})\n    p.wait(lambda s: s[\"sim\"] and s[\"sim\"][\"stage\"] == \"Op\", what=\"op\", timeout=120)\n    p.page.evaluate(\"__game.step(420)\")\n    time.sleep(3)\n    p.page.screenshot(path=str(OUT / \"op.png\"))\n    p.do({\"screen\": \"dev\", \"paused\": True})\n    time.sleep(3)\n    p.page.screenshot(path=str(OUT / \"dev.png\"))\n    p.do({\"screen\": \"about\", \"paused\": False})\n    time.sleep(3)\n    p.page.screenshot(path=str(OUT / \"about.png\"))\n    p.close()\n\nwith sync_playwright() as pw:\n    browser = pw.chromium.launch(args=ARGS)\n    for name, fn in [\n        (\"boots with no errors and no engine overlays\", boots),\n        (\"keyboard and mouse menus\", keyboard_and_mouse),\n        (\"tools by digit, wheel and tray; mouse aim\", tools_by_keys_wheel_tray),\n        (\"DualSense flow\", pad_flow),\n        (\"Xbox prompts, and settings persist\", xbox_setting_persists),\n        (\"attract at 10 s, exits on key, pad and mouse\", attract),\n        (\"audio runs, music at 10%\", audio_runs),\n        (\"dev mode: sliders apply and reset\", dev_mode),\n        (\"the whole campaign, stepped with the bot\", whole_campaign),\n    ]:\n        R.run(name, lambda: fn(browser))\n    R.run(\"phone: message, settings, no touch controls, attract\", lambda: touch_only(browser, pw))\n    R.run(\"WebKit iPhone: as far as it goes\", lambda: webkit_iphone(pw))\n    if \"--shots\" in sys.argv:\n        R.run(\"screenshots\", lambda: screenshots(browser))\n    browser.close()\nEOF\ncat > ../tests/browser/hub_tests.py <<'EOF'\n#!/usr/bin/env python3\n\"\"\"The AI Hub harness's own check, per query, then a two-copy test and a look outside a session.\"\"\"\nimport json, os, pathlib, re, shutil, subprocess, sys, time\nsys.path.insert(0, str(pathlib.Path(__file__).parent))\nfrom common import *\nfrom playwright.sync_api import sync_playwright\n\nHUB = ROOT / \"tests\" / \"hub\"\nshutil.copy(GAME, HUB / \"game.html\")\nsrv = subprocess.Popen([sys.executable, \"-u\", \"-m\", \"http.server\", \"0\", \"--bind\", \"127.0.0.1\", \"-d\", str(HUB)], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)\nline = srv.stdout.readline()\nport = int(re.search(r\"port (\\d+)\", line).group(1))\nbase = f\"http://127.0.0.1:{port}\"\nR = Results()\n\ndef harness(b, q, timeout=240):\n    ctx = b.new_context(viewport={\"width\": 1280, \"height\": 720})\n    page = ctx.new_page()\n    page.goto(f\"{base}/harness.html?game=game.html&{q}&limit=20\")\n    page.wait_for_function(\"document.body.dataset.complete === 'true'\", timeout=timeout * 1000)\n    res = page.evaluate(\"JSON.stringify(window.__hubCheck)\")\n    chk = json.loads(res)\n    ctx.close()\n    assert chk.get(\"pass\") is True, res[:1400]\n\ndef two_copies(b):\n    # Bring the harness up by hand for two players, and read each frame's status.\n    ctx = b.new_context(viewport={\"width\": 1280, \"height\": 720})\n    page = ctx.new_page()\n    page.goto(f\"{base}/harness.html?game=game.html&players=2&limit=45\")\n    def statuses():\n        out = []\n        for fr in page.frames:\n            if \"game.html\" in fr.url:\n                t = fr.evaluate(\"window.__game ? __game.status() : ''\")\n                out.append((fr, json.loads(t) if t else {}))\n        return out\n    end = time.time() + 180\n    while time.time() < end:\n        st = statuses()\n        if len(st) == 2 and all(s.get(\"hub\", {}).get(\"info\") is not False and s.get(\"frames\", 0) > 2 for _, s in st):\n            break\n        time.sleep(0.5)\n    # Ready, both.\n    for fr, _ in statuses():\n        fr.evaluate(\"window.dispatchEvent(new KeyboardEvent('keydown', {key: 'Enter'}))\")\n    while time.time() < end:\n        st = statuses()\n        if st and all(s.get(\"hub\", {}).get(\"playing\") for _, s in st):\n            break\n        time.sleep(0.5)\n    st = statuses()\n    assert len(st) == 2 and all(s[\"hub\"][\"playing\"] for _, s in st), json.dumps([s.get(\"hub\") for _, s in st])\n    host = next(x for x in st if x[1][\"hub\"][\"host\"])\n    client = next(x for x in st if not x[1][\"hub\"][\"host\"])\n    # A client's input moves its cursor on the host.\n    me = client[1][\"hub\"][\"me\"]\n    before = host[1][\"sim\"][\"cursors\"][me][1:]\n    end2 = time.time() + 60\n    moved = False\n    client[0].evaluate(\"\"\"() => { const c = document.querySelector('canvas');\n        for (let i = 0; i < 3; i++) c.dispatchEvent(new MouseEvent('mousemove', {clientX: 200 + i * 60, clientY: 200, bubbles: true})); }\"\"\")\n    client[0].evaluate(\"window.dispatchEvent(new KeyboardEvent('keydown', {code: 'KeyD', key: 'd', bubbles: true}))\")\n    client[0].evaluate(\"document.querySelector('canvas').dispatchEvent(new KeyboardEvent('keydown', {code: 'KeyD', key: 'd', bubbles: true}))\")\n    while time.time() < end2 and not moved:\n        h = dict(statuses())\n        for fr, s in statuses():\n            if s[\"hub\"][\"host\"]:\n                now = s[\"sim\"][\"cursors\"][me][1:]\n                moved = abs(now[0] - before[0]) + abs(now[1] - before[1]) > 0.3\n        time.sleep(0.5)\n    assert moved, \"client input didn't reach the host\"\n    # Both see the same vitals.\n    st = statuses()\n    a, b2 = st[0][1][\"sim\"][\"vitals\"], st[1][1][\"sim\"][\"vitals\"]\n    assert abs(a - b2) < 8, (a, b2)\n    assert st[0][1][\"hub\"][\"snapshot\"] < 6000 or st[1][1][\"hub\"][\"snapshot\"] < 6000\n    ctx.close()\n\ndef outside_session(b):\n    p = Page(b, url=f\"{base}/game.html\")\n    st = p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\" and s[\"frames\"] > 3, what=\"title outside a session\")\n    assert st[\"hub\"][\"active\"] is False\n    p.close()\n\ntry:\n    with sync_playwright() as pw:\n        browser = pw.chromium.launch(args=ARGS)\n        for name, q in [\n            (\"hub: 4 players over a bad network\", \"players=4&latency=150&jitter=50&loss=5&auto=1\"),\n            (\"hub: the host leaves\", \"players=4&latency=150&jitter=50&loss=5&auto=1&scenario=host-leave\"),\n            (\"hub: a server with no player\", \"players=2&scenario=server&auto=1\"),\n            (\"hub: one player\", \"players=1&auto=1\"),\n        ]:\n            R.run(name, lambda: harness(browser, q))\n        R.run(\"hub: two copies, input and vitals\", lambda: two_copies(browser))\n        R.run(\"hub: outside a session, unaffected\", lambda: outside_session(browser))\n        browser.close()\nfinally:\n    srv.terminate()\nEOF\nsleep 100; cat ../build_web.log | tail -5; ls -la ../../*.html 2>/dev/null","description":"Write test runner, browser tests and hub tests","timeout":200000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9083,"cache_read_input_tokens":608257,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9083},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"746b295d-c4d7-4dd3-a9e9-721c13e6e53b","timestamp":"2026-11-05T15:34:14.917Z","request_id":"req_011Cgk2KNoYiKfzFTcVvvYtE","wire_tool_inputs":{"toolu_01LyVacs5RiByc4b26pX8Ec2":{"command":"mkdir -p ../tests/browser; cat > ../tests/run_all.py <<'EOF'\n#!/usr/bin/env python3\n\"\"\"The one test command. Prints only failures and a one-line count.\nusage: python3 tests/run_all.py [--rust|--web|--hub]\"\"\"\nimport pathlib, re, subprocess, sys\n\nROOT = pathlib.Path(__file__).resolve().parent\nENGINE = ROOT.parent / \"engine\"\nwhich = sys.argv[1] if len(sys.argv) > 1 else \"--all\"\npassed = failed = 0\n\ndef report(name, ok, detail=\"\"):\n    global passed, failed\n    if ok:\n        passed += 1\n    else:\n        failed += 1\n        print(f\"FAIL {name}\\n{detail[-3000:]}\")\n\ndef rust():\n    global passed, failed\n    for pkg, extra in [(\"pav_core\", [\"--test\", \"surgery\"]), (\"pav_core\", [\"--lib\", \"surgery\"]), (\"pav_audio\", []), (\"pav_ui\", [\"--lib\"])]:\n        cmd = [str(ROOT.parent / \"tools\" / \"cb.sh\"), \"test\", \"-p\", pkg, *extra]\n        r = subprocess.run(cmd, cwd=ENGINE, capture_output=True, text=True)\n        out = r.stdout + r.stderr\n        ok_tests = re.findall(r\"^test .* \\.\\.\\. ok$\", out, re.M)\n        bad = re.findall(r\"^test (.*) \\.\\.\\. FAILED$\", out, re.M)\n        passed += len(ok_tests)\n        for b in bad:\n            failed += 1\n            m = re.search(r\"---- \" + re.escape(b) + r\" stdout ----(.*?)(?=\\n---- |\\nfailures:)\", out, re.S)\n            print(f\"FAIL rust {pkg}::{b}\\n{(m.group(1) if m else '').strip()[:1500]}\")\n        if r.returncode != 0 and not bad:\n            report(f\"rust build {pkg} {extra}\", False, out)\n\ndef web(suite):\n    r = subprocess.run([sys.executable, str(ROOT / \"browser\" / suite)], capture_output=True, text=True, cwd=ROOT)\n    global passed, failed\n    for line in r.stdout.splitlines():\n        if line.startswith(\"PASS \"):\n            passed += 1\n        elif line.startswith(\"FAIL \"):\n            failed += 1\n            print(line)\n        elif line.startswith(\"  \"):\n            print(line)\n    if r.returncode != 0:\n        report(f\"{suite} crashed\", False, r.stderr)\n\nif which in (\"--all\", \"--rust\"):\n    rust()\nif which in (\"--all\", \"--web\"):\n    web(\"web_tests.py\")\nif which in (\"--all\", \"--web\", \"--hub\"):\n    web(\"hub_tests.py\")\nprint(f\"{passed} passed, {failed} failed\")\nsys.exit(1 if failed else 0)\nEOF\ncat > ../tests/browser/common.py <<'EOF'\n\"\"\"Shared bits for the browser tests: the built single file, Chromium flags, stand-ins.\"\"\"\nimport glob, json, os, pathlib, time\n\nROOT = pathlib.Path(__file__).resolve().parents[2]\nGAME = sorted(glob.glob(str(ROOT.parent / \"*.html\")))[0]\nARGS = [\"--enable-unsafe-webgpu\", \"--enable-features=Vulkan\", \"--use-webgpu-adapter=swiftshader\", \"--use-vulkan=swiftshader\", \"--use-angle=swiftshader\"]\nOUT = ROOT / \"tests\" / \"out\"\nOUT.mkdir(parents=True, exist_ok=True)\n\nPAD = \"\"\"\n(() => { const buttons = Array.from({length: 17}, () => ({pressed: false, touched: false, value: 0}));\n  const pad = {id: 'DualSense Wireless Controller (STANDARD GAMEPAD)', index: 0, connected: true,\n               mapping: 'standard', timestamp: 0, axes: [0,0,0,0], buttons};\n  window.__pad = pad; navigator.getGamepads = () => [pad, null, null, null]; })();\n\"\"\"\n\nTAP = \"\"\"\n(() => { const real = AudioNode.prototype.connect; window.__an = [];\n  AudioNode.prototype.connect = function (dest, ...rest) { const r = real.call(this, dest, ...rest);\n    if (dest instanceof AudioDestinationNode) { const c = this.context;\n      if (!c.__an) { c.__an = c.createAnalyser(); c.__an.fftSize = 2048; window.__an.push(c.__an); } real.call(this, c.__an); }\n    return r; };\n  window.__peak = () => { let m = 0; for (const a of window.__an) { const b = new Float32Array(a.fftSize);\n    a.getFloatTimeDomainData(b); for (const v of b) m = Math.max(m, Math.abs(v)); } return m; }; })();\n\"\"\"\n\nclass Page:\n    \"\"\"A page of the game with helpers that don't wait on real-time play.\"\"\"\n    def __init__(self, browser, query=\"\", init=(), viewport=(960, 540), url=None, **ctx):\n        self.ctx = browser.new_context(viewport={\"width\": viewport[0], \"height\": viewport[1]}, **ctx)\n        self.page = self.ctx.new_page()\n        self.errors = []\n        self.page.on(\"console\", lambda m: self.errors.append(m.text) if m.type == \"error\" else None)\n        self.page.on(\"pageerror\", lambda e: self.errors.append(str(e)))\n        for s in init:\n            self.page.add_init_script(s)\n        self.page.goto(url or (pathlib.Path(GAME).as_uri() + query))\n\n    def status(self):\n        t = self.page.evaluate(\"window.__game ? __game.status() : ''\")\n        return json.loads(t) if t else {}\n\n    def wait(self, pred, timeout=90, every=0.15, what=\"\"):\n        end = time.time() + timeout\n        last = {}\n        while time.time() < end:\n            last = self.status()\n            try:\n                if last and pred(last):\n                    return last\n            except (KeyError, TypeError, IndexError):\n                pass\n            time.sleep(every)\n        raise TimeoutError(f\"timed out waiting for {what}; last: {json.dumps(last)[:600]}\")\n\n    def frames(self, n=3, timeout=60):\n        \"\"\"Wait until n more frames were drawn, so input has been read and acted on.\"\"\"\n        start = self.status().get(\"frames\", 0)\n        self.wait(lambda s: s.get(\"frames\", 0) >= start + n * 2, timeout=timeout, what=\"frames\")\n\n    def do(self, obj):\n        self.page.evaluate(\"(j) => __game.do(j)\", json.dumps(obj))\n\n    def key(self, k):\n        self.page.keyboard.press(k)\n        self.frames(2)\n\n    def pad(self, js):\n        self.page.evaluate(\"() => {\" + js + \"; __pad.timestamp++; }\")\n\n    def press(self, b):\n        self.pad(f\"__pad.buttons[{b}].pressed=true; __pad.buttons[{b}].value=1\")\n        self.frames(2)\n        self.pad(f\"__pad.buttons[{b}].pressed=false; __pad.buttons[{b}].value=0\")\n        self.frames(2)\n\n    def close(self):\n        self.ctx.close()\n\nclass Results:\n    def __init__(self):\n        self.n = 0\n    def check(self, name, ok, detail=\"\"):\n        print((\"PASS \" if ok else \"FAIL \") + name + (\"\" if ok else f\": {str(detail)[:700]}\"), flush=True)\n    def run(self, name, fn):\n        try:\n            fn()\n            print(\"PASS \" + name, flush=True)\n        except Exception as e:  # a failed step shouldn't stop the rest\n            print(\"FAIL \" + name + \": \" + str(e)[:900].replace(\"\\n\", \" \"), flush=True)\nEOF\ncat > ../tests/browser/web_tests.py <<'EOF'\n#!/usr/bin/env python3\n\"\"\"Browser tests of the built single file, on file://, checked through window.__game.\"\"\"\nimport json, sys, time, pathlib\nsys.path.insert(0, str(pathlib.Path(__file__).parent))\nfrom common import *\nfrom playwright.sync_api import sync_playwright\n\nR = Results()\n\ndef boots(b):\n    p = Page(b, init=[TAP])\n    st = p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\" and s[\"frames\"] > 4, what=\"title\")\n    assert \"Trauma Tempo\" == p.page.title(), p.page.title()\n    assert st[\"title\"] == \"Trauma Tempo\"\n    assert \"Trauma Tempo\" in st[\"shell\"][\"texts\"], st[\"shell\"][\"texts\"]\n    assert not [e for e in p.errors if \"GPU\" not in e and \"favicon\" not in e], p.errors\n    # None of the engine's overlays.\n    for bad in [\"Shardfall\", \"F1 tuning\", \"Esc menu\", \"boot\"]:\n        assert not any(bad in t for t in st[\"shell\"][\"texts\"]), bad\n    assert p.page.evaluate(\"document.querySelector('canvas') != null\")\n    assert st[\"bus\"][\"music\"] == 0.1, st[\"bus\"]\n    p.close()\n\ndef keyboard_and_mouse(b):\n    p = Page(b)\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\" and s[\"frames\"] > 4, what=\"title\")\n    p.key(\"Enter\")\n    st = p.wait(lambda s: s[\"shell\"][\"screen\"] == \"menu\", what=\"menu\")\n    assert any(x.startswith(\"key:\") for x in st[\"shell\"][\"prompts\"]), st[\"shell\"][\"prompts\"]\n    f0 = st[\"shell\"][\"focus\"]\n    p.key(\"ArrowDown\")\n    st = p.wait(lambda s: s[\"shell\"][\"focus\"] != f0, what=\"arrow moved focus\")\n    # Hover moves the focus and a click activates: About is the last of six, at about y=856 of 1080.\n    p.page.mouse.move(480, 856 / 1080 * 540)\n    p.frames(2)\n    p.page.mouse.move(482, 856 / 1080 * 540)\n    st = p.wait(lambda s: s[\"shell\"][\"focus\"] == 5, what=\"hover focus\")\n    p.page.mouse.click(482, 856 / 1080 * 540)\n    st = p.wait(lambda s: s[\"shell\"][\"screen\"] == \"about\", what=\"click about\")\n    texts = st[\"shell\"][\"texts\"]\n    for sec in [\"Credits\", \"Source Information\", \"Testing Feedback\", \"Engine Feedback\", \"Prompt Feedback\"]:\n        assert f\"section:{sec}\" in texts, sec\n    p.key(\"Escape\")\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"menu\", what=\"back\")\n    p.close()\n\ndef tools_by_keys_wheel_tray(b):\n    p = Page(b, query=\"?scene=surgery/case/2\")\n    p.wait(lambda s: s[\"sim\"] and s[\"sim\"][\"stage\"] == \"Op\" and s[\"frames\"] > 3, what=\"op\")\n    p.do({\"paused\": False})\n    p.page.mouse.move(400, 300)\n    p.key(\"3\")\n    p.wait(lambda s: s[\"sim\"][\"ring_pos\"] == 2, what=\"digit tool\")\n    p.page.mouse.wheel(0, 200)\n    p.wait(lambda s: s[\"sim\"][\"ring_pos\"] == 3, what=\"wheel down cycles\")\n    # A click on the tray picks the instrument there: find slot 7's screen position roughly.\n    st = p.status()\n    p.page.mouse.move(480, 500)\n    p.frames(2)\n    p.page.mouse.click(480, 505)\n    p.wait(lambda s: s[\"sim\"][\"ring_pos\"] in (3, 4), what=\"tray click\")\n    # The mouse aims absolutely.\n    p.page.mouse.move(600, 260)\n    st = p.wait(lambda s: s[\"sim\"][\"cursor\"][0] > 0.5, what=\"mouse aim\")\n    p.page.mouse.down()\n    p.wait(lambda s: s[\"sim\"][\"using\"], what=\"left button uses\")\n    p.page.mouse.up()\n    assert any(x.startswith(\"mouse:\") for x in p.status()[\"shell\"][\"prompts\"])\n    p.close()\n\ndef pad_flow(b):\n    p = Page(b, init=[PAD])\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\" and s[\"frames\"] > 3, what=\"title\")\n    p.press(0)\n    st = p.wait(lambda s: s[\"shell\"][\"screen\"] == \"menu\", what=\"pad to menu\")\n    assert st[\"device\"] == \"pad\"\n    assert \"ps:cross\" in st[\"shell\"][\"prompts\"] or \"stick:d\" in st[\"shell\"][\"prompts\"], st[\"shell\"][\"prompts\"]\n    f0 = st[\"shell\"][\"focus\"]\n    p.press(13)  # D-pad down\n    p.wait(lambda s: s[\"shell\"][\"focus\"] != f0, what=\"dpad\")\n    # Into a case with the pad.\n    p.do({\"load\": \"surgery/case/2\"})\n    p.wait(lambda s: s[\"sim\"] and s[\"sim\"][\"stage\"] == \"Op\", what=\"op\")\n    # The right stick moves the cursor.\n    c0 = p.status()[\"sim\"][\"cursor\"]\n    p.pad(\"__pad.axes[2]=1\")\n    p.wait(lambda s: s[\"sim\"][\"cursor\"][0] > c0[0] + 0.5, what=\"right stick\")\n    p.pad(\"__pad.axes[2]=0\")\n    # Flick selects a tool, instantly: right is ring position 2.\n    p.pad(\"__pad.axes[0]=1\")\n    p.wait(lambda s: s[\"sim\"][\"ring_pos\"] == 2, what=\"flick right\")\n    p.pad(\"__pad.axes[0]=0\")\n    p.frames(2)\n    # Analog R2 reaches the sim.\n    p.pad(\"__pad.buttons[7].pressed=true; __pad.buttons[7].value=0.5\")\n    st = p.wait(lambda s: s[\"sim\"][\"using\"] and 0.3 < s[\"sim\"][\"pressure\"] < 0.7, what=\"analog R2\")\n    p.pad(\"__pad.buttons[7].pressed=false; __pad.buttons[7].value=0\")\n    p.frames(2)\n    # Options pauses; Circle resumes.\n    p.press(9)\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"pause\" and s[\"paused\"], what=\"options pauses\")\n    p.press(1)\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"playing\" and not s[\"paused\"], what=\"circle resumes\")\n    # Options is ignored while Create is held.\n    p.pad(\"__pad.buttons[8].pressed=true; __pad.buttons[8].value=1\")\n    p.frames(2)\n    p.press(9)\n    p.frames(2)\n    assert p.status()[\"shell\"][\"screen\"] == \"playing\"\n    p.pad(\"__pad.buttons[8].pressed=false; __pad.buttons[8].value=0\")\n    # Prompts flip the moment another device is touched.\n    p.key(\"Tab\")\n    st = p.wait(lambda s: s[\"device\"] == \"keys\", what=\"flip to keys\")\n    p.frames(2)\n    assert any(x.startswith(\"mouse:\") or x.startswith(\"key:\") for x in p.status()[\"shell\"][\"prompts\"])\n    p.key(\"Tab\")\n    p.close()\n\ndef xbox_setting_persists(b):\n    ctx_page = Page(b, init=[PAD])\n    p = ctx_page\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\" and s[\"frames\"] > 3, what=\"title\")\n    p.do({\"screen\": \"settings\", \"page\": 1})\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"settings\", what=\"settings\")\n    p.press(0)  # focus is Button prompts: Cross toggles it\n    st = p.wait(lambda s: s[\"shell\"][\"settings\"][\"xbox\"], what=\"xbox on\")\n    # Settings persist across a reload.\n    p.page.reload()\n    st = p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\" and s[\"frames\"] > 3, what=\"reload\")\n    assert st[\"shell\"][\"settings\"][\"xbox\"] is True\n    p.press(0)\n    st = p.wait(lambda s: s[\"shell\"][\"screen\"] == \"menu\", what=\"menu\")\n    assert any(x.startswith(\"xb:\") for x in st[\"shell\"][\"prompts\"]), st[\"shell\"][\"prompts\"]\n    p.close()\n\ndef attract(b):\n    p = Page(b, init=[PAD])\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\" and s[\"frames\"] > 3, what=\"title\")\n    t0 = time.time()\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"attract\", timeout=40, what=\"attract at 10 s\")\n    took = time.time() - t0\n    assert 6 < took < 30, took\n    st = p.wait(lambda s: s[\"sim\"] and s[\"sim\"][\"demo\"], what=\"demo running\")\n    assert \"DEMO\" in p.wait(lambda s: \"DEMO\" in s[\"shell\"][\"texts\"], what=\"DEMO text\")[\"shell\"][\"texts\"]\n    p.page.keyboard.press(\"x\")\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\", what=\"key exits\")\n    # Pad exits.\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"attract\", timeout=40, what=\"attract again\")\n    p.press(0)\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\", what=\"pad exits\")\n    # Mouse exits.\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"attract\", timeout=40, what=\"attract a third time\")\n    p.page.mouse.move(100, 100)\n    p.page.mouse.move(200, 200)\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\", what=\"mouse exits\")\n    p.close()\n\ndef touch_only(b, playwright):\n    device = playwright.devices[\"Pixel 7\"]\n    ctx = {k: v for k, v in device.items() if k not in (\"viewport\", \"default_browser_type\")}\n    p = Page(b, viewport=(device[\"viewport\"][\"height\"], device[\"viewport\"][\"width\"]), **ctx)\n    st = p.wait(lambda s: s[\"shell\"][\"touch_only\"] and \"Controller or keyboard required\" in s[\"shell\"][\"texts\"], what=\"message\")\n    # A Settings button a tap can use; no touch controls.\n    vw, vh = device[\"viewport\"][\"height\"], device[\"viewport\"][\"width\"]\n    p.page.touchscreen.tap(vw / 2, vh * 800 / 1080)\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"settings\", what=\"tap settings\")\n    p.page.touchscreen.tap(vw / 2, vh * 940 / 1080)\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\", what=\"tap back\")\n    # Attract still runs.\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"attract\", timeout=40, what=\"touch attract\")\n    assert not any(\"Shardfall\" in t for t in p.status()[\"shell\"][\"texts\"])\n    p.close()\n\ndef webkit_iphone(playwright):\n    device = playwright.devices[\"iPhone 14\"]\n    wb = playwright.webkit.launch()\n    ctx = wb.new_context(**{k: v for k, v in device.items() if k != \"default_browser_type\"})\n    page = ctx.new_page()\n    page.goto(pathlib.Path(GAME).as_uri())\n    page.wait_for_timeout(3000)\n    txt = page.evaluate(\"document.body.innerText\")\n    # No WebGPU here: the page's clear message, or (with WebGPU) the game running.\n    has_gpu = page.evaluate(\"!!navigator.gpu\")\n    assert has_gpu or \"WebGPU\" in txt, txt[:200]\n    wb.close()\n\ndef audio_runs(b):\n    p = Page(b, init=[TAP])\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\" and s[\"frames\"] > 3, what=\"title\")\n    p.key(\"Enter\")  # a gesture\n    st = p.status()\n    assert st[\"bus\"][\"music\"] == 0.1\n    end = time.time() + 30\n    peak = 0\n    while time.time() < end and peak < 0.001:\n        peak = p.page.evaluate(\"window.__peak()\")\n        time.sleep(0.2)\n    assert peak > 0.001, f\"silent: {peak}\"\n    # The music bus really is playing, at its low level.\n    st = p.wait(lambda s: s[\"peaks\"][1] > 0, timeout=30, what=\"music peak\")\n    p.close()\n\ndef dev_mode(b):\n    p = Page(b, query=\"?scene=surgery/case/3\")\n    p.wait(lambda s: s[\"sim\"] and s[\"sim\"][\"stage\"] == \"Op\" and s[\"frames\"] > 3, what=\"op\")\n    p.key(\"Escape\")\n    st = p.wait(lambda s: s[\"shell\"][\"screen\"] == \"pause\", what=\"pause\")\n    for t in [\"Resume\", \"Restart\", \"Controls\", \"Settings\", \"Dev Mode\", \"Quit to Title\"]:\n        assert t in st[\"shell\"][\"texts\"], t\n    # Dev Mode is fifth.\n    for _ in range(4):\n        p.key(\"ArrowDown\")\n    p.key(\"Enter\")\n    p.wait(lambda s: s[\"shell\"][\"screen\"] == \"dev\", what=\"dev\")\n    # A balance page: slide the first slider, then Reset All.\n    p.do({\"page\": 3})\n    p.frames(2)\n    p.key(\"ArrowRight\")\n    st = p.wait(lambda s: abs(s[\"shell\"][\"tune\"][\"drain\"] - 1.0) > 0.05, what=\"slider moved\")\n    for _ in range(6):\n        p.key(\"ArrowDown\")\n    p.key(\"Enter\")\n    p.wait(lambda s: abs(s[\"shell\"][\"tune\"][\"drain\"] - 1.0) < 0.001, what=\"reset\")\n    p.close()\n\ndef whole_campaign(b):\n    p = Page(b)\n    p.wait(lambda s: s[\"frames\"] > 3, what=\"start\")\n    p.do({\"load\": \"surgery/campaign\", \"bot\": True})\n    p.wait(lambda s: s[\"sim\"] and s[\"sim\"][\"stage\"] == \"Story\", what=\"campaign start\")\n    p.page.evaluate(\"__game.step(300000)\")\n    st = p.wait(lambda s: s[\"outcome\"] in (\"won\", \"lost\") or s[\"shell\"][\"screen\"] == \"menu\", timeout=500, every=1.0, what=\"campaign end\")\n    assert st[\"outcome\"] != \"lost\", json.dumps(st)[:500]\n    p.close()\n\ndef screenshots(b):\n    p = Page(b, viewport=(1920, 1080))\n    p.wait(lambda s: s[\"frames\"] > 2, what=\"start\", timeout=120)\n    time.sleep(1)\n    p.page.screenshot(path=str(OUT / \"title.png\"))\n    p.do({\"load\": \"surgery/case/3/2\", \"bot\": True})\n    p.wait(lambda s: s[\"sim\"] and s[\"sim\"][\"stage\"] == \"Op\", what=\"op\", timeout=120)\n    p.page.evaluate(\"__game.step(420)\")\n    time.sleep(3)\n    p.page.screenshot(path=str(OUT / \"op.png\"))\n    p.do({\"screen\": \"dev\", \"paused\": True})\n    time.sleep(3)\n    p.page.screenshot(path=str(OUT / \"dev.png\"))\n    p.do({\"screen\": \"about\", \"paused\": False})\n    time.sleep(3)\n    p.page.screenshot(path=str(OUT / \"about.png\"))\n    p.close()\n\nwith sync_playwright() as pw:\n    browser = pw.chromium.launch(args=ARGS)\n    for name, fn in [\n        (\"boots with no errors and no engine overlays\", boots),\n        (\"keyboard and mouse menus\", keyboard_and_mouse),\n        (\"tools by digit, wheel and tray; mouse aim\", tools_by_keys_wheel_tray),\n        (\"DualSense flow\", pad_flow),\n        (\"Xbox prompts, and settings persist\", xbox_setting_persists),\n        (\"attract at 10 s, exits on key, pad and mouse\", attract),\n        (\"audio runs, music at 10%\", audio_runs),\n        (\"dev mode: sliders apply and reset\", dev_mode),\n        (\"the whole campaign, stepped with the bot\", whole_campaign),\n    ]:\n        R.run(name, lambda: fn(browser))\n    R.run(\"phone: message, settings, no touch controls, attract\", lambda: touch_only(browser, pw))\n    R.run(\"WebKit iPhone: as far as it goes\", lambda: webkit_iphone(pw))\n    if \"--shots\" in sys.argv:\n        R.run(\"screenshots\", lambda: screenshots(browser))\n    browser.close()\nEOF\ncat > ../tests/browser/hub_tests.py <<'EOF'\n#!/usr/bin/env python3\n\"\"\"The AI Hub harness's own check, per query, then a two-copy test and a look outside a session.\"\"\"\nimport json, os, pathlib, re, shutil, subprocess, sys, time\nsys.path.insert(0, str(pathlib.Path(__file__).parent))\nfrom common import *\nfrom playwright.sync_api import sync_playwright\n\nHUB = ROOT / \"tests\" / \"hub\"\nshutil.copy(GAME, HUB / \"game.html\")\nsrv = subprocess.Popen([sys.executable, \"-u\", \"-m\", \"http.server\", \"0\", \"--bind\", \"127.0.0.1\", \"-d\", str(HUB)], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)\nline = srv.stdout.readline()\nport = int(re.search(r\"port (\\d+)\", line).group(1))\nbase = f\"http://127.0.0.1:{port}\"\nR = Results()\n\ndef harness(b, q, timeout=240):\n    ctx = b.new_context(viewport={\"width\": 1280, \"height\": 720})\n    page = ctx.new_page()\n    page.goto(f\"{base}/harness.html?game=game.html&{q}&limit=20\")\n    page.wait_for_function(\"document.body.dataset.complete === 'true'\", timeout=timeout * 1000)\n    res = page.evaluate(\"JSON.stringify(window.__hubCheck)\")\n    chk = json.loads(res)\n    ctx.close()\n    assert chk.get(\"pass\") is True, res[:1400]\n\ndef two_copies(b):\n    # Bring the harness up by hand for two players, and read each frame's status.\n    ctx = b.new_context(viewport={\"width\": 1280, \"height\": 720})\n    page = ctx.new_page()\n    page.goto(f\"{base}/harness.html?game=game.html&players=2&limit=45\")\n    def statuses():\n        out = []\n        for fr in page.frames:\n            if \"game.html\" in fr.url:\n                t = fr.evaluate(\"window.__game ? __game.status() : ''\")\n                out.append((fr, json.loads(t) if t else {}))\n        return out\n    end = time.time() + 180\n    while time.time() < end:\n        st = statuses()\n        if len(st) == 2 and all(s.get(\"hub\", {}).get(\"info\") is not False and s.get(\"frames\", 0) > 2 for _, s in st):\n            break\n        time.sleep(0.5)\n    # Ready, both.\n    for fr, _ in statuses():\n        fr.evaluate(\"window.dispatchEvent(new KeyboardEvent('keydown', {key: 'Enter'}))\")\n    while time.time() < end:\n        st = statuses()\n        if st and all(s.get(\"hub\", {}).get(\"playing\") for _, s in st):\n            break\n        time.sleep(0.5)\n    st = statuses()\n    assert len(st) == 2 and all(s[\"hub\"][\"playing\"] for _, s in st), json.dumps([s.get(\"hub\") for _, s in st])\n    host = next(x for x in st if x[1][\"hub\"][\"host\"])\n    client = next(x for x in st if not x[1][\"hub\"][\"host\"])\n    # A client's input moves its cursor on the host.\n    me = client[1][\"hub\"][\"me\"]\n    before = host[1][\"sim\"][\"cursors\"][me][1:]\n    end2 = time.time() + 60\n    moved = False\n    client[0].evaluate(\"\"\"() => { const c = document.querySelector('canvas');\n        for (let i = 0; i < 3; i++) c.dispatchEvent(new MouseEvent('mousemove', {clientX: 200 + i * 60, clientY: 200, bubbles: true})); }\"\"\")\n    client[0].evaluate(\"window.dispatchEvent(new KeyboardEvent('keydown', {code: 'KeyD', key: 'd', bubbles: true}))\")\n    client[0].evaluate(\"document.querySelector('canvas').dispatchEvent(new KeyboardEvent('keydown', {code: 'KeyD', key: 'd', bubbles: true}))\")\n    while time.time() < end2 and not moved:\n        h = dict(statuses())\n        for fr, s in statuses():\n            if s[\"hub\"][\"host\"]:\n                now = s[\"sim\"][\"cursors\"][me][1:]\n                moved = abs(now[0] - before[0]) + abs(now[1] - before[1]) > 0.3\n        time.sleep(0.5)\n    assert moved, \"client input didn't reach the host\"\n    # Both see the same vitals.\n    st = statuses()\n    a, b2 = st[0][1][\"sim\"][\"vitals\"], st[1][1][\"sim\"][\"vitals\"]\n    assert abs(a - b2) < 8, (a, b2)\n    assert st[0][1][\"hub\"][\"snapshot\"] < 6000 or st[1][1][\"hub\"][\"snapshot\"] < 6000\n    ctx.close()\n\ndef outside_session(b):\n    p = Page(b, url=f\"{base}/game.html\")\n    st = p.wait(lambda s: s[\"shell\"][\"screen\"] == \"title\" and s[\"frames\"] > 3, what=\"title outside a session\")\n    assert st[\"hub\"][\"active\"] is False\n    p.close()\n\ntry:\n    with sync_playwright() as pw:\n        browser = pw.chromium.launch(args=ARGS)\n        for name, q in [\n            (\"hub: 4 players over a bad network\", \"players=4&latency=150&jitter=50&loss=5&auto=1\"),\n            (\"hub: the host leaves\", \"players=4&latency=150&jitter=50&loss=5&auto=1&scenario=host-leave\"),\n            (\"hub: a server with no player\", \"players=2&scenario=server&auto=1\"),\n            (\"hub: one player\", \"players=1&auto=1\"),\n        ]:\n            R.run(name, lambda: harness(browser, q))\n        R.run(\"hub: two copies, input and vitals\", lambda: two_copies(browser))\n        R.run(\"hub: outside a session, unaffected\", lambda: outside_session(browser))\n        browser.close()\nfinally:\n    srv.terminate()\nEOF\nsleep 100; cat ../build_web.log | tail -5; ls -la ../../*.html 2>/dev/null","description":"Write test runner, browser tests and hub tests","timeout":200000}}}
