elf.rounds_left > 0 && self.blockers() == 0 && self.strain.is_none() && self.code.is_none() {\n            self.rounds_left -= 1;\n            self.round += 1;\n            self.spawn_i = 0;\n            self.spawn_t = 0.6;\n            more = true;\n        }''')\ns=s.replace('''        if hold || self.code.is_some() || self.strain.is_some() || self.blockers() > 0 {\n            return;\n        }''','''        if hold || more || self.rounds_left > 0 || self.code.is_some() || self.strain.is_some() || self.blockers() > 0 {\n            return;\n        }''')\ns=s.replace('''                || (t.on_clear && self.blockers() == 0 && strain_done && self.code.is_none());''','''                || (t.on_clear && !more && self.rounds_left == 0 && self.blockers() == 0 && strain_done && self.code.is_none());''')\nopen(p,'w').write(s)\n\np='crates/pav_core/src/games/surgery/strain.rs'; s=open(p).read()\ns=s.replace('''    pub merged: bool,\n    pub hazard_id: u32,\n}''','''    pub merged: bool,\n    pub hazard_id: u32,\n    /// More rounds after the first; parts still to emerge, one every few beats; how many so far.\n    pub rounds: u8,\n    pub left: u8,\n    pub emerged: u8,\n    pub gap: f32,\n}''')\ns=s.replace('''            interval: num(\"interval\", 7.0),\n''','''            interval: num(\"interval\", 7.0),\n            rounds: num(\"rounds\", 0.0) as u8,\n''')\n# lacrimosa emerge\ns=s.replace('''                s.eye = self.add(Hazard { kind: Kind::Eye, a: Vec2::new(0.0, -0.2), r: 0.9, blocking: true, ..Default::default() });\n                self.spawn_sacs(&s, rules);''','''                s.eye = self.add(Hazard { kind: Kind::Eye, a: Vec2::new(0.0, -0.2), r: 0.9, blocking: true, ..Default::default() });\n                s.left = if s.count > 0 { s.count } else { 6 };\n                s.emerged = 0;''')\na=s.index(\"    fn spawn_sacs(&mut self, s: &Strain, _rules: &Rules) {\"); b=s.index(\"    /// Runs once per tick with world time.\")\ns=s[:a]+'''    /// One sac comes up on its stem.\n    fn emerge_sac(&mut self, s: &mut Strain) {\n        let crown = Vec2::new(0.0, -0.2);\n        let total = s.left as f32 + s.emerged as f32;\n        let a = s.emerged as f32 / total.max(1.0) * std::f32::consts::TAU + s.wave as f32 * 0.5;\n        let at = crown + Vec2::new(a.cos() * 4.1, a.sin() * 2.7);\n        s.emerged += 1;\n        s.left -= 1;\n        let start = 0.05 + self.rng.f32() * 0.1;\n        let beats = (10.0 + self.rng.f32() * 4.0) * (1.0 - (s.wave as f32 * 0.08).min(0.4));\n        self.cue(cue::SQUISH, at, 0.6, 1.3);\n        self.add(Hazard {\n            kind: Kind::Sac,\n            a: at,\n            b: crown,\n            r: 0.35,\n            prog: start,\n            beats: 0.0,\n            fill_time: 0.6,\n            drain: 0.15,\n            blocking: true,\n            // Each sac swells over 10 to 14 beats, sooner in later waves.\n            deadline: beats,\n            ..Default::default()\n        });\n    }\n\n'''+s[b:]\ns=s.replace('''        let Some(mut s) = self.strain.take() else { return };\n        if r_wave {\n            let mut burst = Vec::new();''','''        let Some(mut s) = self.strain.take() else { return };\n        if r_wave && s.left > 0 {\n            s.gap -= worth;\n            if s.gap <= 0.0 {\n                s.gap = 3.0;\n                self.emerge_sac(&mut s);\n            }\n        }\n        if r_wave {\n            let mut burst = Vec::new();''')\ns=s.replace('''            0 if sacs > 0 => {}''','''            0 if sacs > 0 || s.left > 0 => {}''')\ns=s.replace('''                    // A smaller wave of the same.\n                    let mut smaller = s.clone();\n                    smaller.count = 3;\n                    self.spawn_sacs(&smaller, rules);\n                    s.step = 0;''','''                    // A smaller wave of the same.\n                    s.left = 3;\n                    s.emerged = 0;\n                    s.gap = 0.0;\n                    s.step = 0;''')\ns=s.replace('''                        self.spawn_sacs(&s, rules);\n                        s.step = 0;''','''                        s.left = if s.count > 0 { s.count } else { 6 };\n                        s.emerged = 0;\n                        s.gap = 2.0;\n                        s.step = 0;''')\n# introit rounds\ns=s.replace('''                2 if s.mini => {\n                    self.strain = None;\n                    return;\n                }''','''                2 if s.rounds > 0 => {\n                    // Another bar of the same: this time they hide, and step in from the edges.\n                    s.rounds -= 1;\n                    self.say(\"bashir\", \"More. Under the capsule. Scanner, Doctor.\");\n                    self.cue(cue::STING, Vec2::ZERO, 1.0, 1.2);\n                    let spots = [(-5.5, -2.0), (-2.6, 2.6), (2.4, -2.6), (5.4, 2.0)];\n                    for (x, z) in spots {\n                        let mut n = nodule(Vec2::new(x, z), sub::SMALL, !s.mini, 0.6);\n                        n.r = 0.36;\n                        self.add(n);\n                    }\n                }\n                2 if s.mini => {\n                    self.strain = None;\n                    return;\n                }''')\n# dies rounds + emerge\ns=s.replace('''                let n = if s.count > 0 { s.count } else { 5 };\n                let spots = [(-4.6, -1.8), (4.4, -2.0), (-3.2, 2.2), (3.4, 2.2), (0.2, -2.8)];''','''                let n = if s.count > 0 { s.count } else { 5 };\n                let spots = [(-4.6, -1.8), (4.4, -2.0), (-3.2, 2.2), (3.4, 2.2), (0.2, -2.8)];''')\ns=s.replace('''                let spots = [(-4.6, -1.8), (4.4, -2.0), (-3.2, 2.2), (3.4, 2.4), (0.2, -2.8)];\n                for (x, z) in spots.iter().take(n as usize) {\n                    self.add(ember(Vec2::new(*x, *z), 0));\n                }''','''                s.left = n;\n                s.emerged = 0;''')\ns=s.replace('''            // Each bar's last beat sends a heat ring out; the beat before it counts in.\n''','''            // Embers catch one at a time.\n            if s.left > 0 {\n                s.gap -= worth;\n                if s.gap <= 0.0 {\n                    s.gap = 4.0;\n                    let spots = [(-4.6, -1.8), (4.4, -2.0), (-3.2, 2.2), (3.4, 2.4), (0.2, -2.8), (-0.4, 2.8)];\n                    let (x, z) = spots[s.emerged as usize % 6];\n                    s.emerged += 1;\n                    s.left -= 1;\n                    self.add(ember(Vec2::new(x, z), 0));\n                    self.cue(cue::SIZZLE, Vec2::new(x, z), 0.8, 0.7);\n                }\n            }\n            // Each bar's last beat sends a heat ring out; the beat before it counts in.\n''')\ns=s.replace('''                if embers.is_empty() && !coals {\n                    if s.mini {''','''                if embers.is_empty() && !coals && s.left == 0 && s.rounds > 0 {\n                    // It isn't out. It was never out.\n                    s.rounds -= 1;\n                    s.left = if s.count > 0 { s.count } else { 5 };\n                    s.gap = 3.0;\n                    s.merged = false;\n                    self.say(\"pet\", \"It's caught again underneath. Keep your hands up, and your head down.\");\n                    self.cue(cue::STING, Vec2::ZERO, 1.0, 0.9);\n                } else if embers.is_empty() && !coals && s.left == 0 {\n                    if s.mini {''')\nopen(p,'w').write(s)\nEOF\ngrep -n \"spots = \\[(-4.6\" crates/pav_core/src/games/surgery/strain.rs; grep -n \"spawn_sacs\" crates/pav_core/src/games/surgery/strain.rs; sed -n '/StrainKind::Dies => {/,/StrainKind::Soloist => {/p' crates/pav_core/src/games/surgery/strain.rs | head -14","description":"Start rebuild; add staggered spawns, repeats and strain rounds"}}}
