{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KNHXEuECBMKFB2KTdB5sL8","type":"tool_result","content":"1\t        if let Err(error) = pav_tools::creature_tools::initialize_authored() {\n2\t            self.creature_ui.report(Err(format!(\"Could not load saved creatures: {error:#}\")));\n3\t        }\n4\t        let mut sim = stage(\"simulation\", || {\n5\t            let mut sim = Sim::new(&s.scene, s.seed)?;\n6\t            let mut d = format!(\n7\t                \"scene '{}', seed {}, {} entities, {} blocks\",\n8\t                s.scene,\n9\t                s.seed,\n10\t                sim.state.entities.len(),\n11\t                sim.state.statics.block_count()\n12\t            );\n13\t            if let Some(level) = crate::save::restore_into(&mut sim) {\n14\t                d += &format!(\", saved hero (level {level})\");\n15\t            }\n16\t            Ok((sim, d))\n17\t        })?;\n18\t        if s.animation_studio {\n19\t            // Read authored sets before selecting a clip. Keep the embedded library if a\n20\t            // file is invalid, so the studio can still open and report the error.\n21\t            #[cfg(not(target_arch = \"wasm32\"))]\n22\t            {\n23\t                let _ = pav_core::clips::library();\n24\t                if pav_core::anim::disk_dir().is_some() {\n25\t                    if let Err(e) = pav_core::anim::reload(true) {\n26\t                        self.animation_ui.report(Err(e));\n27\t                    }\n28\t                }\n29\t                if let Err(e) = pav_tools::animation_tools::reload_authored() {\n30\t                    self.animation_ui.report(Err(format!(\"{e:#}\")));\n31\t                }\n32\t            }\n33\t            let name = if s.animation_clip.is_empty() { \"QUATERNIUS/Idle_Loop\" } else { &s.animation_clip };\n34\t            let mut session = pav_tools::Session::from_live(sim, self.rig.clone(), self.view.clone(), None);\n35\t            let args = serde_json::json!({\"clip\":name}).as_object().unwrap().clone();\n36\t            pav_tools::preview_tools::t_anim_preview(&mut session, &args)?;\n37\t            let (live, rig, view, _) = session.into_live();\n38\t            sim = live;\n39\t            self.rig = rig;\n40\t            self.view = view;\n41\t            self.show_boot = false;\n42\t            self.app_settings.show_stats = false;\n43\t            self.app_settings.show_guide = false;\n44\t        }\n45\t        if s.asset_studio {\n46\t            let name = if s.asset_name.is_empty() { \"BUILTIN/bench\" } else { &s.asset_name };\n47\t            let mut session = pav_tools::Session::from_live(sim, self.rig.clone(), self.view.clone(), None);\n48\t            let args = serde_json::json!({\"name\":name}).as_object().unwrap().clone();\n49\t            pav_tools::asset_preview_tools::t_asset_preview(&mut session, &args)?;\n50\t            let (live, rig, view, _) = session.into_live();\n51\t            sim = live;\n52\t            self.rig = rig;\n53\t            self.view = view;\n54\t            self.show_boot = false;\n55\t            self.app_settings.show_stats = false;\n56\t            self.app_settings.show_guide = false;\n57\t        }\n58\t        if s.creature_studio {\n59\t            let mut session = pav_tools::Session::from_live(sim, self.rig.clone(), self.view.clone(), None);\n60\t            let mut args = serde_json::json!({\"action\":\"open\"}).as_object().unwrap().clone();\n61\t            if !s.creature_name.is_empty() {\n62\t                args.insert(\"name\".into(), serde_json::json!(s.creature_name));\n63\t            }\n64\t            let result = pav_tools::creature_preview_tools::t_creature_preview(&mut session, &args)\n65\t                .map(|output| match output {\n66\t                    pav_tools::Output::Json(v) => v,\n67\t                    pav_tools::Output::Image { meta, .. } => meta,\n68\t                })\n69\t                .map_err(|error| format!(\"{error:#}\"));\n70\t            self.creature_ui.report(result);\n71\t            let (live, rig, view, _) = session.into_live();\n72\t            sim = live;\n73\t            self.rig = rig;\n74\t            self.view = view;\n75\t            self.show_boot = false;\n76\t            self.app_settings.show_stats = false;\n77\t            self.app_settings.show_guide = false;\n78\t        }\n79\t        self.sim_config = sim.config.clone();\n80\t        self.rig.snap(sim.frame().focus);\n81\t        self.hud.entries = room_entries(&sim);\n82\t        self.hud.errors = sim.state.world.errors.clone();\n83\t        self.watcher = RoomWatcher::start();\n84\t        self.animation_watch_attempted = crate::animation_watch::AnimationWatcher::directory_exists();\n85\t        if self.animation_watch_attempted {\n86\t            self.animation_watcher = crate::animation_watch::AnimationWatcher::start();\n87\t        }\n88\t        #[cfg(not(target_arch = \"wasm32\"))]\n89\t        if !s.pad_script.is_empty() {\n90\t            match std::fs::read_to_string(&s.pad_script)\n91\t                .map_err(|e| e.to_string())\n92\t                .and_then(|t| crate::input::PadScript::parse(&t))\n93\t            {\n94\t                Ok(p) => {\n95\t                    log::info!(\"pad script: {} steps from {}\", p.steps.len(), s.pad_script);\n96\t                    self.input.pad_script = Some(p);\n97\t                }\n98\t                Err(e) => log::error!(\"pad script {}: {e}\", s.pad_script),\n99\t            }\n100\t        }\n101\t        #[cfg(not(target_arch = \"wasm32\"))]\n102\t        if !s.bridge.is_empty() {\n103\t            self.bridge = stage(\"agent bridge\", || match crate::bridge::Bridge::start(&s.bridge) {\n104\t                Ok(b) => {\n105\t                    let d = format!(\"listening on {}\", b.addr);\n106\t                    Ok((Some(b), d))\n107\t                }\n108\t                Err(e) => Ok((None, format!(\"could not listen on {} ({e}); continuing without it\", s.bridge))),\n109\t            })?;\n110\t        }\n111\t        self.host = Some(SimHost::start(sim));\n112\t        self.gfx = Some(gfx);\n113\t        self.egui_state = Some(egui_state);\n114\t        Ok(())\n115\t    }\n116\t\n117\t    /// Whether the gamepad drives a menu cursor now (a game window or the pause menu is open).\n118\t    fn pad_ui_active(&self) -> bool {\n119\t        self.input.last_device == Device::Gamepad\n120\t            && (self.menu_open || self.game_ui.any_open() || self.look_ui.open || self.guide.station || self.guide.field)\n121\t    }\n122\timpl App {\n123\t    /// The browser only allows sound after the first click or key press.\n124\t    #[cfg(target_arch = \"wasm32\")]\n125\t    fn resume_audio(&mut self) {\n126\t        if !self.audio_resumed {\n127\t            self.audio_resumed = true;\n128\t            if let Some(a) = &self.audio {\n129\t                a.resume();\n130\t            }\n131\t        }\n132\t    }\n133\t\n134\t    /// A start-up failure: stop, and show why (the browser has no exit to report it).\n135\t    fn fail(&mut self, el: &ActiveEventLoop, e: anyhow::Error) {\n136\t        let msg = format!(\"{e:#}\");\n137\t        #[cfg(target_arch = \"wasm32\")]\n138\t        crate::platform::error_box(\"Shardfall could not start\", &msg);\n139\t        self.fatal = Some(msg);\n140\t        el.exit();\n141\t    }\n142\t}\n143\t\n144\timpl ApplicationHandler for App {\n145\t    fn resumed(&mut self, el: &ActiveEventLoop) {\n146\t        if self.init_started || self.fatal.is_some() {\n147\t            return;\n148\t        }\n149\t        self.init_started = true;\n150\t        if let Err(e) = self.init(el) {\n151\t            self.fail(el, e);\n152\t        }\n153\t    }\n154\t\n155\t    fn window_event(&mut self, el: &ActiveEventLoop, _id: WindowId, event: WindowEvent) {\n156\t        if let WindowEvent::Touch(t) = &event {\n157\t            self.on_touch(t, &event);\n158\t            return;\n159\t        }\n160\t        let consumed = match (&mut self.egui_state, &self.gfx) {\n161\t            (Some(st), Some(g)) => st.on_window_event(&g.window, &event),\n162\t            _ => false,\n163\t        };\n164\t        match event {\n165\t            WindowEvent::CloseRequested => {\n166\t                if let Some(host) = &self.host {\n167\t                    host.exec(|sim| crate::save::save_from(sim));\n168\t                }\n169\t                self.look_ui.save_if_dirty(true);\n170\t                el.exit()\n171\t            }\n172\t            WindowEvent::Focused(false) => {\n173\t                self.input.clear();\n174\t                self.touch.clear();\n175\t            }\n176\t            WindowEvent::Resized(sz) => {\n177\t                if let Some(g) = &mut self.gfx {\n178\t                    g.resize(sz.width, sz.height);\n179\t                }\n180\t            }\n181\t            WindowEvent::RedrawRequested => {\n182\t                self.frame();\n183\t                if self.quit {\n184\t                    el.exit();\n185\t                }\n186\t            }\n187\t            WindowEvent::KeyboardInput { event, .. } => {\n188\t                #[cfg(target_arch = \"wasm32\")]\n189\t                self.resume_audio();\n190\t                if let PhysicalKey::Code(code) = event.physical_key {\n191\t                    let system = matches!(\n192\t                        code,\n193\t                        KeyCode::Escape\n194\t                            | KeyCode::F1\n195\t                            | KeyCode::F2\n196\t                            | KeyCode::F3\n197\t                            | KeyCode::F4\n198\t                            | KeyCode::F5\n199\t                            | KeyCode::F6\n200\t                            | KeyCode::F7\n201\t                            | KeyCode::F8\n202\t                            | KeyCode::F9\n203\t                            | KeyCode::F10\n204\t                            | KeyCode::F11\n205\t                            | KeyCode::F12\n206\t                    );\n207\t                    if event.state == ElementState::Pressed && !event.repeat && (system || !consumed) {\n208\t                        self.handle_key(code);\n209\t                        if !system && !consumed {\n210\t                            self.latency.press();\n211\t                        }\n212\t                    }\n213\t                    if !consumed || event.state == ElementState::Released {\n214\t                        self.input.key(code, event.state);\n215\t                    }\n216\t                }\n217\t            }\n218\t            WindowEvent::MouseWheel { delta, .. } if !consumed => {\n219\t                let lines = match delta {\n220\t                    MouseScrollDelta::LineDelta(_, y) => y,\n221\t                    MouseScrollDelta::PixelDelta(p) => p.y as f32 / 40.0,\n222\t                };\n223\t                self.rig.params.distance = (self.rig.params.distance * 0.9f32.powf(lines)).clamp(2.0, 120.0);\n224\t            }\n225\t            WindowEvent::MouseInput { state, button, .. } => {\n226\t                #[cfg(target_arch = \"wasm32\")]\n227\t                self.resume_audio();\n228\t                if state == ElementState::Pressed && button == MouseButton::Left && !consumed {\n229\t                    self.latency.press();\n230\t                }\n231\t                // In the game the right button is a skill; the middle button turns the camera.\n232\t                let turn = if self.input.game && self.studio_mode == StudioMode::World {\n233\t                    MouseButton::Middle\n234\t                } else {\n235\t                    MouseButton::Right\n236\t                };\n237\t                if button == turn {\n238\t                    self.mouse.right_down = state == ElementState::Pressed && !consumed;\n239\t                } else if !consumed || state == ElementState::Released {\n240\t                    self.input.mouse_button(button, state);\n241\t                }\n242\t            }\n243\t            WindowEvent::CursorMoved { position, .. } => {\n244\t                let p = Vec2::new(position.x as f32, position.y as f32);\n245\t                if self.mouse.right_down {\n246\t                    let d = p - self.mouse.pos;\n247\t                    self.rig.params.yaw = (self.rig.params.yaw - d.x * 0.3 + 540.0).rem_euclid(360.0) - 180.0;\n248\t                    self.rig.params.tilt = (self.rig.params.tilt + d.y * 0.2).clamp(0.0, 90.0);\n249\t                }\n250\t                if (p - self.mouse.pos).length() > 2.0 {\n251\t                    self.input.last_device = Device::KeyboardMouse;\n252\t                }\n253\t                self.mouse.pos = p;\n254\t                self.input.cursor = p;\n255\t            }\n256\t            _ => {}\n257\t        }\n258\t    }\n259\t\n260\t    fn about_to_wait(&mut self, el: &ActiveEventLoop) {\n261\t        #[cfg(target_arch = \"wasm32\")]\n262\t        if let Some(r) = self.pending_gfx.as_ref().and_then(|slot| slot.borrow_mut().take()) {\n263\t            self.pending_gfx = None;\n264\t            if let Err(e) = r.and_then(|gfx| self.finish_init(gfx)) {\n265\t                self.fail(el, e);\n266\t            }\n267\t        }\n268\t        #[cfg(not(target_arch = \"wasm32\"))]\n269\t        let _ = el;\n270\t        if let Some(g) = &self.gfx {\n271\t            g.window.request_redraw();\n272\t        }\n273\t    }\n274\t}\n275\t\n276\tfn room_entries(sim: &Sim) -> Vec<RoomEntry> {\n277\t//! Window-bound graphics: surface, device, scene renderer and egui renderer.\n278\t\n279\tuse std::sync::Arc;\n280\t\n281\tuse anyhow::{Context, Result, anyhow};\n282\tuse pav_render::gpu::{self, BackendChoice};\n283\tuse pav_render::wgpu;\n284\tuse pav_render::{Renderer, Scene};\n285\tuse winit::window::Window;\n286\t\n287\tuse crate::boot::{stage, stage_async};\n288\t\n289\tpub struct Gfx {\n290\t    pub window: Arc<Window>,\n291\t    pub surface: wgpu::Surface<'static>,\n292\t    pub adapter: wgpu::Adapter,\n293\t    pub device: wgpu::Device,\n294\t    pub queue: wgpu::Queue,\n295\t    pub config: wgpu::SurfaceConfiguration,\n296\t    pub renderer: Renderer,\n297\t    pub egui: egui_wgpu::Renderer,\n298\t    pub vsync: bool,\n299\t    pub adapter_name: String,\n300\t    pub gpu_errors: Arc<std::sync::atomic::AtomicU32>,\n301\t}\n302\t\n303\timpl Gfx {\n304\t    #[cfg(not(target_arch = \"wasm32\"))]\n305\t    pub fn new(window: Arc<Window>, backend: BackendChoice, vsync: bool) -> Result<Self> {\n306\t        pollster_block(Self::create(window, backend, vsync))\n307\t    }\n308\t\n309\t    /// Creates everything; only the adapter and device requests wait (in the browser).\n310\t    pub async fn create(window: Arc<Window>, backend: BackendChoice, vsync: bool) -> Result<Self> {\n311\t        let web = cfg!(target_arch = \"wasm32\");\n312\t        let instance = stage(\"graphics instance\", || {\n313\t            Ok((gpu::create_instance(backend), format!(\"backend: {}\", if web { \"webgpu\" } else { backend.name() })))\n314\t        })?;\n315\t        let surface = stage(\"window surface\", || {\n316\t            let s = instance.create_surface(window.clone()).context(\"could not create a drawing surface for the window\")?;\n317\t            Ok((s, String::new()))\n318\t        })?;\n319\t        let adapter = stage_async(\"graphics adapter\", async {\n320\t            if !web {\n321\t                let all = gpu::list_adapters(&instance, backend);\n322\t                for a in &all {\n323\t                    log::info!(\"  found adapter: {}\", gpu::describe(a));\n324\t                }\n325\t                if all.is_empty() {\n326\t                    return Err(anyhow!(\n327\t                        \"no {} adapter found. Update your graphics driver{}\",\n328\t                        backend.name(),\n329\t                        if backend == BackendChoice::Vulkan { \", or try backend = \\\"dx12\\\" in shardfall.toml\" } else { \"\" }\n330\t                    ));\n331\t                }\n332\t            }\n333\t            let a = gpu::request_adapter_async(&instance, Some(&surface)).await.map_err(|e| {\n334\t                if web { anyhow!(\"{e:#}. This page needs a browser with WebGPU (a recent Chrome or Edge)\") } else { e }\n335\t            })?;\n336\t            let d = gpu::describe(&a.get_info());\n337\t            Ok((a, d))\n338\t        })\n339\t        .await?;\n340\t        let (device, queue) = stage_async(\"graphics device\", async {\n341\t            let (d, q) = gpu::request_device_async(&adapter).await?;\n342\t            Ok(((d, q), String::new()))\n343\t        })\n344\t        .await?;\n345\t        let gpu_errors = Arc::new(std::sync::atomic::AtomicU32::new(0));\n346\t        {\n347\t            let errs = gpu_errors.clone();\n348\t            device.on_uncaptured_error(Arc::new(move |e| {\n349\t                errs.fetch_add(1, std::sync::atomic::Ordering::Relaxed);\n350\t                log::error!(\"GPU error: {e}\");\n351\t            }));\n352\t            device.set_device_lost_callback(|reason, msg| log::error!(\"GPU device lost ({reason:?}): {msg}\"));\n353\t        }\n354\t        let size = window.inner_size();\n355\t        let config = stage(\"surface configure\", || {\n356\t            let caps = surface.get_capabilities(&adapter);\n357\t            let mut c = surface\n358\t                .get_default_config(&adapter, size.width.max(1), size.height.max(1))\n359\t                .context(\"surface not supported by adapter\")?;\n360\t            // Non-sRGB target: the post pass encodes sRGB itself, and egui expects a linear-blend target.\n361\t            c.format = caps.formats.iter().copied().find(|f| !f.is_srgb()).unwrap_or(c.format);\n362\t            c.present_mode = present_mode(&caps, vsync);\n363\t            surface.configure(&device, &c);\n364\t            Ok((c.clone(), format!(\"{:?}, {:?}, {}x{}\", c.format, c.present_mode, c.width, c.height)))\n365\t        })?;\n366\t        let scope = device.push_error_scope(wgpu::ErrorFilter::Validation);\n367\t        let renderer = stage(\"renderer & shaders\", || Ok((Renderer::new(&device, &queue), String::new())))?;\n368\t        if let Some(e) = scope.pop().await {\n369\t            return Err(anyhow!(\"shader/pipeline creation failed: {e}\"));\n370\t        }\n371\t        let egui = stage(\"ui renderer\", || {\n372\t            Ok((egui_wgpu::Renderer::new(&device, config.format, egui_wgpu::RendererOptions::default()), String::new()))\n373\t        })?;\n374\t        let adapter_name = gpu::describe(&adapter.get_info());\n375\t        Ok(Self { window, surface, adapter, device, queue, config, renderer, egui, vsync, adapter_name, gpu_errors })\n376\t    }\n377\t\n378\t    pub fn resize(&mut self, w: u32, h: u32) {\n379\t        if w == 0 || h == 0 {\n380\t            return;\n381\t        }\n382\t        self.config.width = w;\n383\t        self.config.height = h;\n384\t        self.surface.configure(&self.device, &self.config);\n385\t    }\n386\t\n387\t    pub fn set_vsync(&mut self, on: bool) {\n388\t        self.vsync = on;\n389\t        let caps = self.surface.get_capabilities(&self.adapter);\n390\t        self.config.present_mode = present_mode(&caps, on);\n391\t        self.surface.configure(&self.device, &self.config);\n392\t    }\n393\t\n394\t    /// Acquires the next surface texture, reconfiguring when needed. None = skip this frame.\n395\t    pub fn acquire(&mut self) -> Option<wgpu::SurfaceTexture> {\n396\t        match self.surface.get_current_texture() {\n397\t            wgpu::CurrentSurfaceTexture::Success(t) => Some(t),\n398\t            wgpu::CurrentSurfaceTexture::Suboptimal(t) => {\n399\t                // Use this frame, reconfigure for the next one.\n400\t                self.surface.configure(&self.device, &self.config);\n401\t                Some(t)\n402\t            }\n403\t            wgpu::CurrentSurfaceTexture::Outdated | wgpu::CurrentSurfaceTexture::Lost => {\n404\t                self.surface.configure(&self.device, &self.config);\n405\t                None\n406\t            }\n407\t            _ => None,\n408\t        }\n409\t    }\n410\t\n411\t    pub fn size(&self) -> (u32, u32) {\n412\t        (self.config.width, self.config.height)\n413\t    }\n414\t\n415\t    /// Renders the scene plus the egui overlay and presents. Texture updates are always\n416\t    /// applied (and the delta cleared), even when the frame is skipped.\n417\t    pub fn draw(&mut self, scene: &Scene, ui: Option<(&[egui::ClippedPrimitive], &mut egui::TexturesDelta, f32)>) -> bool {\n418\t        let mut ui = ui;\n419\t        if let Some((_, textures, _)) = ui.as_mut() {\n420\t            for (id, deltas) in &textures.set {\n421\t                for delta in deltas {\n422\t                    self.egui.update_texture(&self.device, &self.queue, *id, delta);\n423\t                }\n424\t            }\n425\t        }\n426\t        let frame = self.acquire();\n427\t        let submitted = frame.is_some();\n428\t        if let Some(frame) = frame {\n429\t            let view = frame.texture.create_view(&wgpu::TextureViewDescriptor::default());\n430\t            let mut encoder = self.device.create_command_encoder(&wgpu::CommandEncoderDescriptor { label: Some(\"frame\") });\n431\t            let size = self.size();\n432\t            self.renderer.render(&mut encoder, scene, &view, self.config.format, size);\n433\t            let mut cmds = Vec::new();\n434\t            if let Some((prims, _, ppp)) = ui.as_ref() {\n435\t                let sd = egui_wgpu::ScreenDescriptor { size_in_pixels: [size.0, size.1], pixels_per_point: *ppp };\n436\t                cmds = self.egui.update_buffers(&self.device, &self.queue, &mut encoder, prims, &sd);\n437\t                let pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {\n438\t                    label: Some(\"egui\"),\n439\t                    color_attachments: &[Some(wgpu::RenderPassColorAttachment {\n440\t                        view: &view,\n441\t                        depth_slice: None,\n442\t                        resolve_target: None,\n443\t                        ops: wgpu::Operations { load: wgpu::LoadOp::Load, store: wgpu::StoreOp::Store },\n444\t                    })],\n445\t                    depth_stencil_attachment: None,\n446\t                    timestamp_writes: None,\n447\t                    occlusion_query_set: None,\n448\t                    multiview_mask: None,\n449\t                });\n450\t                self.egui.render(&mut pass.forget_lifetime(), prims, &sd);\n451\t            }\n452\t            self.queue.submit(cmds.into_iter().chain([encoder.finish()]));\n453\t            self.window.pre_present_notify();\n454\t            self.queue.present(frame);\n455\t        }\n456\t        if let Some((_, textures, _)) = ui {\n457\t            for id in &textures.free {\n458\t                self.egui.free_texture(id);\n459\t            }\n460\t            textures.clear();\n461\t        }\n462\t        submitted\n463\t    }\n464\t}\n465\t\n466\tfn present_mode(caps: &wgpu::SurfaceCapabilities, vsync: bool) -> wgpu::PresentMode {\n467\t    let want: &[wgpu::PresentMode] = if vsync {\n468\t        &[wgpu::PresentMode::Fifo]\n469\t    } else {\n470\t        &[wgpu::PresentMode::Mailbox, wgpu::PresentMode::Immediate, wgpu::PresentMode::Fifo]\n471\t    };\n472\t    want.iter().copied().find(|m| caps.present_modes.contains(m)).unwrap_or(caps.present_modes[0])\n473\t}\n474\t\n475\t#[cfg(not(target_arch = \"wasm32\"))]\n476\tfn pollster_block<F: std::future::Future>(f: F) -> F::Output {\n477\t    // Minimal executor (the futures here resolve immediately on native).\n478\t    use std::task::{Context as Cx, Poll, RawWaker, RawWakerVTable, Waker};\n479\t    fn noop(_: *const ()) {}\n480\t    fn clone(p: *const ()) -> RawWaker {\n481\t        RawWaker::new(p, &VTABLE)\n482\t    }\n483\t    static VTABLE: RawWakerVTable = RawWakerVTable::new(clone, noop, noop, noop);\n484\t    let waker = unsafe { Waker::from_raw(RawWaker::new(std::ptr::null(), &VTABLE)) };\n485\t    let mut cx = Cx::from_waker(&waker);\n486\t    let mut f = std::pin::pin!(f);\n487\t    loop {\n488\t        if let Poll::Ready(v) = f.as_mut().poll(&mut cx) {\n489\t            return v;\n490\t        }\n491\t        std::thread::yield_now();\n492\t    }\n493\t}\n494\t//! Runs the simulation at a fixed tick rate: on its own thread natively, and stepped from the\n495\t//! frame loop in the browser (no threads there). The renderer never waits for it: it reads the\n496\t//! two most recent frames and interpolates between them.\n497\t\n498\tuse std::sync::{Arc, Mutex};\n499\tuse std::time::Duration;\n500\t\n501\tuse pav_core::{InputFrame, RenderFrame, Sim, SimEvent};\n502\tuse web_time::Instant;\n503\t\n504\t#[cfg(not(target_arch = \"wasm32\"))]\n505\ttype Job = Box<dyn FnOnce(&mut Sim) + Send>;\n506\t\n507\t#[cfg(not(target_arch = \"wasm32\"))]\n508\tenum Cmd {\n509\t    Run(Job),\n510\t    Quit,\n511\t}\n512\t\n513\t#[derive(Clone, Copy, Debug)]\n514\tpub struct TimeControl {\n515\t    pub paused: bool,\n516\t    /// Simulation speed multiplier (0.05 .. 8).\n517\t    pub speed: f32,\n518\t    /// Ticks to advance while paused.\n519\t    pub step_requests: u32,\n520\t    /// Holding the rewind button.\n521\t    pub rewinding: bool,\n522\t    /// Ticks travelled back per tick while rewinding.\n523\t    pub rewind_speed: u32,\n524\t    /// Jump to this tick (timeline scrubbing), keeping the future until play resumes.\n525\t    pub scrub: Option<u64>,\n526\t}\n527\t\n528\timpl Default for TimeControl {\n529\t    fn default() -> Self {\n530\t        Self { paused: false, speed: 1.0, step_requests: 0, rewinding: false, rewind_speed: 1, scrub: None }\n531\t    }\n532\t}\n533\t\n534\t#[derive(Clone, Copy, Debug, Default)]\n535\tpub struct SimStats {\n536\t    /// Measured ticks per second of wall time.\n537\t    pub tps: f32,\n538\t    /// Average CPU time per tick (ms).\n539\t    pub tick_ms: f32,\n540\t    pub tick: u64,\n541\t    pub entities: usize,\n542\t    /// Rewind range available (ticks).\n543\t    pub oldest: u64,\n544\t    pub newest: u64,\n545\t    pub history_mb: f32,\n546\t    pub rewound: bool,\n547\t}\n548\t\n549\tpub struct FramePair {\n550\t    pub prev: Arc<RenderFrame>,\n551\t    pub curr: Arc<RenderFrame>,\n552\t    /// When `curr` became current (wall clock).\n553\t    pub curr_at: Instant,\n554\t    /// Wall-clock length of one tick at the current speed.\n555\t    pub tick_wall: f32,\n556\t}\n557\t\n558\tpub struct Shared {\n559\t    pub frames: Mutex<FramePair>,\n560\t    pub input: Mutex<InputFrame>,\n561\t    pub control: Mutex<TimeControl>,\n562\t    pub stats: Mutex<SimStats>,\n563\t    pub crashed: Mutex<Option<String>>,\n564\t    /// Events for sound and effects, drained by the render thread.\n565\t    pub events: Mutex<Vec<SimEvent>>,\n566\t    /// When the input that is waiting for the next tick was pressed (latency measurement).\n567\t    pub input_stamp: Mutex<Option<Instant>>,\n568\t    /// (pressed, consumed by a tick, that tick's number) for the latest measured press.\n569\t    pub latency_probe: Mutex<Option<(Instant, Instant, u64)>>,\n570\t    /// Menu commands waiting for a tick (one rides along with each tick's input).\n571\t    pub cmds: Mutex<std::collections::VecDeque<pav_core::arpg::GameCmd>>,\n572\t}\n573\t\n574\timpl Shared {\n575\t    /// Queues a game command for the next free tick.\n576\t    pub fn command(&self, c: pav_core::arpg::GameCmd) {\n577\t        let mut q = self.cmds.lock().unwrap();\n578\t        if q.len() < 64 {\n579\t            q.push_back(c);\n580\t        }\n581\t    }\n582\t}\n583\t\n584\t#[cfg(not(target_arch = \"wasm32\"))]\n585\tpub struct SimHost {\n586\t    tx: std::sync::mpsc::Sender<Cmd>,\n587\t    pub shared: Arc<Shared>,\n588\t    thread: Option<std::thread::JoinHandle<()>>,\n589\t}\n590\t\n591\t/// In the browser the simulation lives on the main thread and `pump` advances it every frame.\n592\t#[cfg(target_arch = \"wasm32\")]\n593\tpub struct SimHost {\n594\t    sim: std::cell::RefCell<Sim>,\n595\t    clock: std::cell::RefCell<Clock>,\n596\t    pub shared: Arc<Shared>,\n597\t}\n598\t\n599\tfn shared_for(sim: &mut Sim) -> Arc<Shared> {\n600\t    let f = Arc::new(sim.frame());\n601\t    Arc::new(Shared {\n602\t        frames: Mutex::new(FramePair { prev: f.clone(), curr: f, curr_at: Instant::now(), tick_wall: sim.dt() }),\n603\t        input: Mutex::new(InputFrame::default()),\n604\t        control: Mutex::new(TimeControl::default()),\n605\t        stats: Mutex::new(SimStats::default()),\n606\t        crashed: Mutex::new(None),\n607\t        events: Mutex::new(Vec::new()),\n608\t        input_stamp: Mutex::new(None),\n609\t        latency_probe: Mutex::new(None),\n610\t        cmds: Mutex::new(Default::default()),\n611\t    })\n612\t}\n613\t\n614\t#[cfg(not(target_arch = \"wasm32\"))]\n615\timpl SimHost {\n616\t    pub fn start(mut sim: Sim) -> Self {\n617\t        let shared = shared_for(&mut sim);\n618\t        let (tx, rx) = std::sync::mpsc::channel();\n619\t        let sh = shared.clone();\n620\t        let thread = std::thread::Builder::new()\n621\t            .name(\"simulation\".into())\n622\t            .spawn(move || {\n623\t                let sh2 = sh.clone();\n624\t                let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(move || run(sim, rx, sh2)));\n625\t                if let Err(e) = r {\n626\t                    let msg = e\n627\t                        .downcast_ref::<&str>()\n628\t                        .map(|s| s.to_string())\n629\t                        .or_else(|| e.downcast_ref::<String>().cloned())\n630\t                        .unwrap_or_else(|| \"unknown panic\".into());\n631\t                    *sh.crashed.lock().unwrap() = Some(msg);\n632\t                }\n633\t            })\n634\t            .expect(\"spawn simulation thread\");\n635\t        Self { tx, shared, thread: Some(thread) }\n636\t    }\n637\t\n638\t    /// Runs `f` on the simulation thread (fire and forget).\n639\t    pub fn exec(&self, f: impl FnOnce(&mut Sim) + Send + 'static) {\n640\t        let _ = self.tx.send(Cmd::Run(Box::new(f)));\n641\t    }\n642\t\n643\t    /// Runs `f` on the simulation thread and waits for its result.\n644\t    pub fn query<R: Send + 'static>(&self, f: impl FnOnce(&mut Sim) -> R + Send + 'static) -> Option<R> {\n645\t        let (rtx, rrx) = std::sync::mpsc::channel();\n646\t        self.exec(move |sim| {\n647\t            let _ = rtx.send(f(sim));\n648\t        });\n649\t        rrx.recv_timeout(Duration::from_secs(5)).ok()\n650\t    }\n651\t\n652\t    /// Advances the simulation (the thread does this by itself natively).\n653\t    pub fn pump(&self) {}\n654\t}\n655\t\n656\t#[cfg(target_arch = \"wasm32\")]\n657\timpl SimHost {\n658\t    pub fn start(mut sim: Sim) -> Self {\n659\t        let shared = shared_for(&mut sim);\n660\t        Self { sim: std::cell::RefCell::new(sim), clock: std::cell::RefCell::new(Clock::new()), shared }\n661\t    }\n662\t\n663\t    pub fn exec(&self, f: impl FnOnce(&mut Sim) + 'static) {\n664\t        let mut sim = self.sim.borrow_mut();\n665\t        f(&mut sim);\n666\t        let dt = sim.dt();\n667\t        publish(&mut sim, &self.shared, dt, Instant::now());\n668\t    }\n669\t\n670\t    pub fn query<R: 'static>(&self, f: impl FnOnce(&mut Sim) -> R + 'static) -> Option<R> {\n671\t        let mut sim = self.sim.borrow_mut();\n672\t        let r = f(&mut sim);\n673\t        let dt = sim.dt();\n674\t        publish(&mut sim, &self.shared, dt, Instant::now());\n675\t        Some(r)\n676\t    }\n677\t\n678\t    /// Runs the ticks that are due (called once per frame).\n679\t    pub fn pump(&self) {\n680\t        self.clock.borrow_mut().advance(&mut self.sim.borrow_mut(), &self.shared);\n681\t    }\n682\t}\n683\t\n684\timpl SimHost {\n685\t    pub fn frames(&self) -> (Arc<RenderFrame>, Arc<RenderFrame>, Instant, f32) {\n686\t        let f = self.shared.frames.lock().unwrap();\n687\t        (f.prev.clone(), f.curr.clone(), f.curr_at, f.tick_wall)\n688\t    }\n689\t\n690\t    pub fn control(&self) -> TimeControl {\n691\t        *self.shared.control.lock().unwrap()\n692\t    }\n693\t\n694\t//! Window events -> egui input. Natively this is egui-winit; in the browser (where egui-winit\n695\t//! does not build) a small adapter covers what the panels use: pointer, wheel, keys and text.\n696\t\n697\tuse winit::event::WindowEvent;\n698\tuse winit::window::Window;\n699\t\n700\t#[cfg(not(target_arch = \"wasm32\"))]\n701\tpub struct UiInput(egui_winit::State);\n702\t\n703\t#[cfg(not(target_arch = \"wasm32\"))]\n704\timpl UiInput {\n705\t    pub fn new(ctx: &egui::Context, window: &Window, max_texture: usize) -> Self {\n706\t        Self(egui_winit::State::new(\n707\t            ctx.clone(),\n708\t            egui::ViewportId::ROOT,\n709\t            window,\n710\t            Some(window.scale_factor() as f32),\n711\t            None,\n712\t            Some(max_texture),\n713\t        ))\n714\t    }\n715\t\n716\t    /// Feeds an event to egui; true when egui used it (the game should ignore it).\n717\t    pub fn on_window_event(&mut self, window: &Window, event: &WindowEvent) -> bool {\n718\t        self.0.on_window_event(window, event).consumed\n719\t    }\n720\t\n721\t    pub fn take(&mut self, window: &Window) -> egui::RawInput {\n722\t        self.0.take_egui_input(window)\n723\t    }\n724\t\n725\t    pub fn platform_output(&mut self, window: &Window, out: egui::PlatformOutput) {\n726\t        self.0.handle_platform_output(window, out);\n727\t    }\n728\t}\n729\t\n730\t#[cfg(target_arch = \"wasm32\")]\n731\tpub struct UiInput {\n732\t    ctx: egui::Context,\n733\t    raw: egui::RawInput,\n734\t    pointer: egui::Pos2,\n735\t    modifiers: egui::Modifiers,\n736\t    start: web_time::Instant,\n737\t    max_texture: usize,\n738\t    cursor: egui::CursorIcon,\n739\t    /// The finger that is egui's pointer (the first one down).\n740\t    touch_pointer: Option<u64>,\n741\t}\n742\t\n743\t#[cfg(target_arch = \"wasm32\")]\n744\timpl UiInput {\n745\t    pub fn new(ctx: &egui::Context, _window: &Window, max_texture: usize) -> Self {\n746\t        Self {\n747\t            ctx: ctx.clone(),\n748\t            raw: egui::RawInput::default(),\n749\t            pointer: egui::Pos2::ZERO,\n750\t            modifiers: egui::Modifiers::default(),\n751\t            start: web_time::Instant::now(),\n752\t            max_texture,\n753\t            cursor: egui::CursorIcon::Default,\n754\t//! Tiny platform helpers: error pop-ups (a message box on Windows, the page in the browser) and\n755\t//! console attachment on Windows.\n756\t\n757\t#[cfg(windows)]\n758\tpub fn error_box(title: &str, message: &str) {\n759\t    use windows_sys::Win32::UI::WindowsAndMessaging::{MB_ICONERROR, MB_OK, MessageBoxW};\n760\t    let wide = |s: &str| s.encode_utf16().chain(std::iter::once(0)).collect::<Vec<u16>>();\n761\t    let (t, m) = (wide(title), wide(message));\n762\t    unsafe {\n763\t        MessageBoxW(std::ptr::null_mut(), m.as_ptr(), t.as_ptr(), MB_OK | MB_ICONERROR);\n764\t    }\n765\t}\n766\t\n767\t#[cfg(all(not(windows), not(target_arch = \"wasm32\")))]\n768\tpub fn error_box(title: &str, message: &str) {\n769\t    eprintln!(\"== {title} ==\\n{message}\");\n770\t}\n771\t\n772\t/// In the browser: replaces the page with the message.\n773\t#[cfg(target_arch = \"wasm32\")]\n774\tpub fn error_box(title: &str, message: &str) {\n775\t    let esc = |s: &str| s.replace('&', \"&amp;\").replace('<', \"&lt;\");\n776\t    if let Some(body) = web_sys::window().and_then(|w| w.document()).and_then(|d| d.body()) {\n777\t        body.set_inner_html(&format!(\n778\t            \"<div style='font:16px sans-serif;color:#eee;padding:32px;max-width:760px'><h2>{}</h2><pre style='white-space:pre-wrap'>{}</pre></div>\",\n779\t            esc(title),\n780\t            esc(message)\n781\t        ));\n782\t    }\n783\t}\n784\t\n785\t/// When started from a terminal, print there (the release .exe has no console of its own).\n786\t#[cfg(windows)]\n787\tpub fn attach_console() {\n788\t    use windows_sys::Win32::System::Console::{ATTACH_PARENT_PROCESS, AttachConsole};\n789\t    unsafe {\n790\t        AttachConsole(ATTACH_PARENT_PROCESS);\n791\t    }\n792\t}\n793\t\n794\t#[cfg(not(windows))]\n795\tpub fn attach_console() {}\n796\t\n797\t/// Whether this is a phone or tablet: the browser says its main pointer is a finger.\n798\t#[cfg(target_arch = \"wasm32\")]\n799\tpub fn touch_screen() -> bool {\n800\t    web_sys::window().and_then(|w| w.match_media(\"(pointer: coarse)\").ok().flatten()).is_some_and(|m| m.matches())\n801\t}\n802\t\n803\t#[cfg(not(target_arch = \"wasm32\"))]\n804\tpub fn touch_screen() -> bool {\n805\t    false\n806\t}\n807\t\n808\t/// Full screen on or off. In the browser the whole page goes full screen (the game's own\n809\t/// overlays stay on top of the canvas).\n810\t#[cfg(target_arch = \"wasm32\")]\n811\tpub fn toggle_fullscreen(_window: &winit::window::Window) {\n812\t    let Some(doc) = web_sys::window().and_then(|w| w.document()) else { return };\n813\t    if doc.fullscreen_element().is_some() {\n814\t        doc.exit_fullscreen();\n815\t    } else if let Some(el) = doc.document_element() {\n816\t        let _ = el.request_fullscreen();\n817\t    }\n818\t}\n819\t\n820\t#[cfg(not(target_arch = \"wasm32\"))]\n821\tpub fn toggle_fullscreen(window: &winit::window::Window) {\n822\t    let on = window.fullscreen().is_some();\n823\t    window.set_fullscreen(if on { None } else { Some(winit::window::Fullscreen::Borderless(None)) });\n824\t}\n825\t[package]\n826\tname = \"pav_app\"\n827\tversion.workspace = true\n828\tedition.workspace = true\n829\tpublish.workspace = true\n830\t\n831\t[[bin]]\n832\tname = \"shardfall\"\n833\tpath = \"src/main.rs\"\n834\t\n835\t[dependencies]\n836\tpav_core.workspace = true\n837\tpav_render.workspace = true\n838\tpav_view.workspace = true\n839\tpav_tools.workspace = true\n840\tpav_ui.workspace = true\n841\tpav_audio.workspace = true\n842\tglam.workspace = true\n843\twinit.workspace = true\n844\tegui.workspace = true\n845\tegui-wgpu = { workspace = true, features = [\"winit\"] }\n846\tgilrs.workspace = true\n847\tserde.workspace = true\n848\tserde_json.workspace = true\n849\tanyhow.workspace = true\n850\tlog.workspace = true\n851\tweb-time.workspace = true\n852\t\n853\t[target.'cfg(not(target_arch = \"wasm32\"))'.dependencies]\n854\tnotify.workspace = true\n855\tegui-winit = { workspace = true, features = [\"clipboard\"] }\n856\t\n857\t[target.'cfg(target_arch = \"wasm32\")'.dependencies]\n858\twasm-bindgen.workspace = true\n859\twasm-bindgen-futures.workspace = true\n860\tweb-sys = { workspace = true, features = [\"Window\", \"Document\", \"Element\", \"HtmlElement\", \"Location\", \"UrlSearchParams\", \"console\", \"Storage\", \"MediaQueryList\"] }\n861\t\n862\t[target.'cfg(windows)'.dependencies]\n863\twindows-sys = { version = \"0.61\", features = [\"Win32_UI_WindowsAndMessaging\", \"Win32_System_Console\", \"Win32_Foundation\"] }\n864\t\n865\t[lints]\n866\tworkspace = true\n867\t//! Shardfall — the game executable.\n868\t#![cfg_attr(all(windows, not(debug_assertions)), windows_subsystem = \"windows\")]\n869\t\n870\tmod animation_ui;\n871\tmod animation_watch;\n872\tmod app;\n873\tmod asset_ui;\n874\tmod asset_watch;\n875\tmod boot;\n876\t#[cfg(not(target_arch = \"wasm32\"))]\n877\tmod bridge;\n878\tmod creature_ui;\n879\tmod creature_watch;\n880\tmod edit;\n881\tmod gfx;\n882\tmod guide_ui;\n883\tmod hud;\n884\tmod input;\n885\tmod look_ui;\n886\tmod panel;\n887\tmod platform;\n888\tmod quality;\n889\tmod rooms;\n890\tmod save;\n891\tmod settings;\n892\tmod simhost;\n893\tmod ui;\n894\tmod uiinput;\n895\t\n896\tuse pav_ui::{arpg_items, arpg_ui, touch};\n897\t\n898\tfn fatal(msg: &str) -> ! {\n899\t    let path = boot::diag().log_path.display().to_string();\n900\t    log::error!(\"fatal: {msg}\");\n901\t    platform::error_box(\"Shardfall could not start\", &format!(\"{msg}\\n\\nThe full log is in:\\n{path}\"));\n902\t    std::process::exit(1);\n903\t}\n904\t\n905\tfn main() {\n906\t    platform::attach_console();\n907\t    let d = boot::init();\n908\t    boot::install_panic_hook();\n909\t    let args: Vec<String> = std::env::args().skip(1).collect();\n910\t    if args.iter().any(|a| a == \"--help\" || a == \"-h\") {\n911\t        println!(\n912\t            \"shardfall [--room NAME | --scene NAME] [--seed N] [--backend vulkan|dx12] [--no-vsync] [--fullscreen] [--bridge [ADDR]]\\n\\\n913\t             --bridge opens the live agent bridge (default 127.0.0.1:7878; drive it with `pav live`).\\n\\\n914\t             --animation-studio [SET/Clip] opens the animation workspace and the live agent bridge.\\n\\\n915\t             --creature-studio [CREATURE/name] opens the creature workspace and the live agent bridge.\\n\\\n916\t             --asset-studio [SET/name] opens the object workspace and the live agent bridge.\\n\\\n917\t             Startup settings live in shardfall.toml next to the executable.\"\n918\t        );\n919\t        return;\n920\t    }\n921\t    log::info!(\n922\t        \"Shardfall {} ({} {}, {} build) — log file: {}\",\n923\t        env!(\"CARGO_PKG_VERSION\"),\n924\t        if cfg!(target_arch = \"wasm32\") { \"browser\" } else { std::env::consts::OS },\n925\t        std::env::consts::ARCH,\n926\t        if cfg!(debug_assertions) { \"debug\" } else { \"release\" },\n927\t        d.log_path.display()\n928\t    );\n929\t    let settings = match boot::stage(\"settings\", || {\n930\t        let (s, note) = settings::Settings::load(&args);\n931\t        Ok((s, note))\n932\t    }) {\n933\t        Ok(s) => s,\n934\t        Err(e) => fatal(&format!(\"{e:#}\")),\n935\t    };\n936\t    // The browser's event loop runs on after `run` returns; errors show on the page.\n937\t    #[cfg(target_arch = \"wasm32\")]\n938\t    if let Err(e) = app::run(settings) {\n939\t        fatal(&format!(\"{e:#}\"));\n940\t    }\n941\t    #[cfg(not(target_arch = \"wasm32\"))]\n942\t    match std::panic::catch_unwind(|| app::run(settings)) {\n943\t        Ok(Ok(())) => log::info!(\"clean exit\"),\n944\t        Ok(Err(e)) => fatal(&format!(\"{e:#}\")),\n945\t        Err(_) => {\n946\t            let msg = boot::LAST_CRASH.lock().ok().and_then(|c| c.clone()).unwrap_or_else(|| \"unknown crash\".into());\n947\t            fatal(&format!(\"Shardfall crashed:\\n{msg}\"));\n948\t        }\n949\t    }\n950\t}\n951\t"}]},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"32df2c22-4cf1-46d4-8ced-ee9dd532d116","timestamp":"2026-11-05T14:24:59.839Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-medium-build-v2--20261105-072416--x42677a-work/189b0832-eeab-4401-af9a-06d1cd0033c9/tool-results/b61yupbw9.txt","content":"        if let Err(error) = pav_tools::creature_tools::initialize_authored() {\n            self.creature_ui.report(Err(format!(\"Could not load saved creatures: {error:#}\")));\n        }\n        let mut sim = stage(\"simulation\", || {\n            let mut sim = Sim::new(&s.scene, s.seed)?;\n            let mut d = format!(\n                \"scene '{}', seed {}, {} entities, {} blocks\",\n                s.scene,\n                s.seed,\n                sim.state.entities.len(),\n                sim.state.statics.block_count()\n            );\n            if let Some(level) = crate::save::restore_into(&mut sim) {\n                d += &format!(\", saved hero (level {level})\");\n            }\n            Ok((sim, d))\n        })?;\n        if s.animation_studio {\n            // Read authored sets before selecting a clip. Keep the embedded library if a\n            // file is invalid, so the studio can still open and report the error.\n            #[cfg(not(target_arch = \"wasm32\"))]\n            {\n                let _ = pav_core::clips::library();\n                if pav_core::anim::disk_dir().is_some() {\n                    if let Err(e) = pav_core::anim::reload(true) {\n                        self.animation_ui.report(Err(e));\n                    }\n                }\n                if let Err(e) = pav_tools::animation_tools::reload_authored() {\n                    self.animation_ui.report(Err(format!(\"{e:#}\")));\n                }\n            }\n            let name = if s.animation_clip.is_empty() { \"QUATERNIUS/Idle_Loop\" } else { &s.animation_clip };\n            let mut session = pav_tools::Session::from_live(sim, self.rig.clone(), self.view.clone(), None);\n            let args = serde_json::json!({\"clip\":name}).as_object().unwrap().clone();\n            pav_tools::preview_tools::t_anim_preview(&mut session, &args)?;\n            let (live, rig, view, _) = session.into_live();\n            sim = live;\n            self.rig = rig;\n            self.view = view;\n            self.show_boot = false;\n            self.app_settings.show_stats = false;\n            self.app_settings.show_guide = false;\n        }\n        if s.asset_studio {\n            let name = if s.asset_name.is_empty() { \"BUILTIN/bench\" } else { &s.asset_name };\n            let mut session = pav_tools::Session::from_live(sim, self.rig.clone(), self.view.clone(), None);\n            let args = serde_json::json!({\"name\":name}).as_object().unwrap().clone();\n            pav_tools::asset_preview_tools::t_asset_preview(&mut session, &args)?;\n            let (live, rig, view, _) = session.into_live();\n            sim = live;\n            self.rig = rig;\n            self.view = view;\n            self.show_boot = false;\n            self.app_settings.show_stats = false;\n            self.app_settings.show_guide = false;\n        }\n        if s.creature_studio {\n            let mut session = pav_tools::Session::from_live(sim, self.rig.clone(), self.view.clone(), None);\n            let mut args = serde_json::json!({\"action\":\"open\"}).as_object().unwrap().clone();\n            if !s.creature_name.is_empty() {\n                args.insert(\"name\".into(), serde_json::json!(s.creature_name));\n            }\n            let result = pav_tools::creature_preview_tools::t_creature_preview(&mut session, &args)\n                .map(|output| match output {\n                    pav_tools::Output::Json(v) => v,\n                    pav_tools::Output::Image { meta, .. } => meta,\n                })\n                .map_err(|error| format!(\"{error:#}\"));\n            self.creature_ui.report(result);\n            let (live, rig, view, _) = session.into_live();\n            sim = live;\n            self.rig = rig;\n            self.view = view;\n            self.show_boot = false;\n            self.app_settings.show_stats = false;\n            self.app_settings.show_guide = false;\n        }\n        self.sim_config = sim.config.clone();\n        self.rig.snap(sim.frame().focus);\n        self.hud.entries = room_entries(&sim);\n        self.hud.errors = sim.state.world.errors.clone();\n        self.watcher = RoomWatcher::start();\n        self.animation_watch_attempted = crate::animation_watch::AnimationWatcher::directory_exists();\n        if self.animation_watch_attempted {\n            self.animation_watcher = crate::animation_watch::AnimationWatcher::start();\n        }\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if !s.pad_script.is_empty() {\n            match std::fs::read_to_string(&s.pad_script)\n                .map_err(|e| e.to_string())\n                .and_then(|t| crate::input::PadScript::parse(&t))\n            {\n                Ok(p) => {\n                    log::info!(\"pad script: {} steps from {}\", p.steps.len(), s.pad_script);\n                    self.input.pad_script = Some(p);\n                }\n                Err(e) => log::error!(\"pad script {}: {e}\", s.pad_script),\n            }\n        }\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if !s.bridge.is_empty() {\n            self.bridge = stage(\"agent bridge\", || match crate::bridge::Bridge::start(&s.bridge) {\n                Ok(b) => {\n                    let d = format!(\"listening on {}\", b.addr);\n                    Ok((Some(b), d))\n                }\n                Err(e) => Ok((None, format!(\"could not listen on {} ({e}); continuing without it\", s.bridge))),\n            })?;\n        }\n        self.host = Some(SimHost::start(sim));\n        self.gfx = Some(gfx);\n        self.egui_state = Some(egui_state);\n        Ok(())\n    }\n\n    /// Whether the gamepad drives a menu cursor now (a game window or the pause menu is open).\n    fn pad_ui_active(&self) -> bool {\n        self.input.last_device == Device::Gamepad\n            && (self.menu_open || self.game_ui.any_open() || self.look_ui.open || self.guide.station || self.guide.field)\n    }\nimpl App {\n    /// The browser only allows sound after the first click or key press.\n    #[cfg(target_arch = \"wasm32\")]\n    fn resume_audio(&mut self) {\n        if !self.audio_resumed {\n            self.audio_resumed = true;\n            if let Some(a) = &self.audio {\n                a.resume();\n            }\n        }\n    }\n\n    /// A start-up failure: stop, and show why (the browser has no exit to report it).\n    fn fail(&mut self, el: &ActiveEventLoop, e: anyhow::Error) {\n        let msg = format!(\"{e:#}\");\n        #[cfg(target_arch = \"wasm32\")]\n        crate::platform::error_box(\"Shardfall could not start\", &msg);\n        self.fatal = Some(msg);\n        el.exit();\n    }\n}\n\nimpl ApplicationHandler for App {\n    fn resumed(&mut self, el: &ActiveEventLoop) {\n        if self.init_started || self.fatal.is_some() {\n            return;\n        }\n        self.init_started = true;\n        if let Err(e) = self.init(el) {\n            self.fail(el, e);\n        }\n    }\n\n    fn window_event(&mut self, el: &ActiveEventLoop, _id: WindowId, event: WindowEvent) {\n        if let WindowEvent::Touch(t) = &event {\n            self.on_touch(t, &event);\n            return;\n        }\n        let consumed = match (&mut self.egui_state, &self.gfx) {\n            (Some(st), Some(g)) => st.on_window_event(&g.window, &event),\n            _ => false,\n        };\n        match event {\n            WindowEvent::CloseRequested => {\n                if let Some(host) = &self.host {\n                    host.exec(|sim| crate::save::save_from(sim));\n                }\n                self.look_ui.save_if_dirty(true);\n                el.exit()\n            }\n            WindowEvent::Focused(false) => {\n                self.input.clear();\n                self.touch.clear();\n            }\n            WindowEvent::Resized(sz) => {\n                if let Some(g) = &mut self.gfx {\n                    g.resize(sz.width, sz.height);\n                }\n            }\n            WindowEvent::RedrawRequested => {\n                self.frame();\n                if self.quit {\n                    el.exit();\n                }\n            }\n            WindowEvent::KeyboardInput { event, .. } => {\n                #[cfg(target_arch = \"wasm32\")]\n                self.resume_audio();\n                if let PhysicalKey::Code(code) = event.physical_key {\n                    let system = matches!(\n                        code,\n                        KeyCode::Escape\n                            | KeyCode::F1\n                            | KeyCode::F2\n                            | KeyCode::F3\n                            | KeyCode::F4\n                            | KeyCode::F5\n                            | KeyCode::F6\n                            | KeyCode::F7\n                            | KeyCode::F8\n                            | KeyCode::F9\n                            | KeyCode::F10\n                            | KeyCode::F11\n                            | KeyCode::F12\n                    );\n                    if event.state == ElementState::Pressed && !event.repeat && (system || !consumed) {\n                        self.handle_key(code);\n                        if !system && !consumed {\n                            self.latency.press();\n                        }\n                    }\n                    if !consumed || event.state == ElementState::Released {\n                        self.input.key(code, event.state);\n                    }\n                }\n            }\n            WindowEvent::MouseWheel { delta, .. } if !consumed => {\n                let lines = match delta {\n                    MouseScrollDelta::LineDelta(_, y) => y,\n                    MouseScrollDelta::PixelDelta(p) => p.y as f32 / 40.0,\n                };\n                self.rig.params.distance = (self.rig.params.distance * 0.9f32.powf(lines)).clamp(2.0, 120.0);\n            }\n            WindowEvent::MouseInput { state, button, .. } => {\n                #[cfg(target_arch = \"wasm32\")]\n                self.resume_audio();\n                if state == ElementState::Pressed && button == MouseButton::Left && !consumed {\n                    self.latency.press();\n                }\n                // In the game the right button is a skill; the middle button turns the camera.\n                let turn = if self.input.game && self.studio_mode == StudioMode::World {\n                    MouseButton::Middle\n                } else {\n                    MouseButton::Right\n                };\n                if button == turn {\n                    self.mouse.right_down = state == ElementState::Pressed && !consumed;\n                } else if !consumed || state == ElementState::Released {\n                    self.input.mouse_button(button, state);\n                }\n            }\n            WindowEvent::CursorMoved { position, .. } => {\n                let p = Vec2::new(position.x as f32, position.y as f32);\n                if self.mouse.right_down {\n                    let d = p - self.mouse.pos;\n                    self.rig.params.yaw = (self.rig.params.yaw - d.x * 0.3 + 540.0).rem_euclid(360.0) - 180.0;\n                    self.rig.params.tilt = (self.rig.params.tilt + d.y * 0.2).clamp(0.0, 90.0);\n                }\n                if (p - self.mouse.pos).length() > 2.0 {\n                    self.input.last_device = Device::KeyboardMouse;\n                }\n                self.mouse.pos = p;\n                self.input.cursor = p;\n            }\n            _ => {}\n        }\n    }\n\n    fn about_to_wait(&mut self, el: &ActiveEventLoop) {\n        #[cfg(target_arch = \"wasm32\")]\n        if let Some(r) = self.pending_gfx.as_ref().and_then(|slot| slot.borrow_mut().take()) {\n            self.pending_gfx = None;\n            if let Err(e) = r.and_then(|gfx| self.finish_init(gfx)) {\n                self.fail(el, e);\n            }\n        }\n        #[cfg(not(target_arch = \"wasm32\"))]\n        let _ = el;\n        if let Some(g) = &self.gfx {\n            g.window.request_redraw();\n        }\n    }\n}\n\nfn room_entries(sim: &Sim) -> Vec<RoomEntry> {\n//! Window-bound graphics: surface, device, scene renderer and egui renderer.\n\nuse std::sync::Arc;\n\nuse anyhow::{Context, Result, anyhow};\nuse pav_render::gpu::{self, BackendChoice};\nuse pav_render::wgpu;\nuse pav_render::{Renderer, Scene};\nuse winit::window::Window;\n\nuse crate::boot::{stage, stage_async};\n\npub struct Gfx {\n    pub window: Arc<Window>,\n    pub surface: wgpu::Surface<'static>,\n    pub adapter: wgpu::Adapter,\n    pub device: wgpu::Device,\n    pub queue: wgpu::Queue,\n    pub config: wgpu::SurfaceConfiguration,\n    pub renderer: Renderer,\n    pub egui: egui_wgpu::Renderer,\n    pub vsync: bool,\n    pub adapter_name: String,\n    pub gpu_errors: Arc<std::sync::atomic::AtomicU32>,\n}\n\nimpl Gfx {\n    #[cfg(not(target_arch = \"wasm32\"))]\n    pub fn new(window: Arc<Window>, backend: BackendChoice, vsync: bool) -> Result<Self> {\n        pollster_block(Self::create(window, backend, vsync))\n    }\n\n    /// Creates everything; only the adapter and device requests wait (in the browser).\n    pub async fn create(window: Arc<Window>, backend: BackendChoice, vsync: bool) -> Result<Self> {\n        let web = cfg!(target_arch = \"wasm32\");\n        let instance = stage(\"graphics instance\", || {\n            Ok((gpu::create_instance(backend), format!(\"backend: {}\", if web { \"webgpu\" } else { backend.name() })))\n        })?;\n        let surface = stage(\"window surface\", || {\n            let s = instance.create_surface(window.clone()).context(\"could not create a drawing surface for the window\")?;\n            Ok((s, String::new()))\n        })?;\n        let adapter = stage_async(\"graphics adapter\", async {\n            if !web {\n                let all = gpu::list_adapters(&instance, backend);\n                for a in &all {\n                    log::info!(\"  found adapter: {}\", gpu::describe(a));\n                }\n                if all.is_empty() {\n                    return Err(anyhow!(\n                        \"no {} adapter found. Update your graphics driver{}\",\n                        backend.name(),\n                        if backend == BackendChoice::Vulkan { \", or try backend = \\\"dx12\\\" in shardfall.toml\" } else { \"\" }\n                    ));\n                }\n            }\n            let a = gpu::request_adapter_async(&instance, Some(&surface)).await.map_err(|e| {\n                if web { anyhow!(\"{e:#}. This page needs a browser with WebGPU (a recent Chrome or Edge)\") } else { e }\n            })?;\n            let d = gpu::describe(&a.get_info());\n            Ok((a, d))\n        })\n        .await?;\n        let (device, queue) = stage_async(\"graphics device\", async {\n            let (d, q) = gpu::request_device_async(&adapter).await?;\n            Ok(((d, q), String::new()))\n        })\n        .await?;\n        let gpu_errors = Arc::new(std::sync::atomic::AtomicU32::new(0));\n        {\n            let errs = gpu_errors.clone();\n            device.on_uncaptured_error(Arc::new(move |e| {\n                errs.fetch_add(1, std::sync::atomic::Ordering::Relaxed);\n                log::error!(\"GPU error: {e}\");\n            }));\n            device.set_device_lost_callback(|reason, msg| log::error!(\"GPU device lost ({reason:?}): {msg}\"));\n        }\n        let size = window.inner_size();\n        let config = stage(\"surface configure\", || {\n            let caps = surface.get_capabilities(&adapter);\n            let mut c = surface\n                .get_default_config(&adapter, size.width.max(1), size.height.max(1))\n                .context(\"surface not supported by adapter\")?;\n            // Non-sRGB target: the post pass encodes sRGB itself, and egui expects a linear-blend target.\n            c.format = caps.formats.iter().copied().find(|f| !f.is_srgb()).unwrap_or(c.format);\n            c.present_mode = present_mode(&caps, vsync);\n            surface.configure(&device, &c);\n            Ok((c.clone(), format!(\"{:?}, {:?}, {}x{}\", c.format, c.present_mode, c.width, c.height)))\n        })?;\n        let scope = device.push_error_scope(wgpu::ErrorFilter::Validation);\n        let renderer = stage(\"renderer & shaders\", || Ok((Renderer::new(&device, &queue), String::new())))?;\n        if let Some(e) = scope.pop().await {\n            return Err(anyhow!(\"shader/pipeline creation failed: {e}\"));\n        }\n        let egui = stage(\"ui renderer\", || {\n            Ok((egui_wgpu::Renderer::new(&device, config.format, egui_wgpu::RendererOptions::default()), String::new()))\n        })?;\n        let adapter_name = gpu::describe(&adapter.get_info());\n        Ok(Self { window, surface, adapter, device, queue, config, renderer, egui, vsync, adapter_name, gpu_errors })\n    }\n\n    pub fn resize(&mut self, w: u32, h: u32) {\n        if w == 0 || h == 0 {\n            return;\n        }\n        self.config.width = w;\n        self.config.height = h;\n        self.surface.configure(&self.device, &self.config);\n    }\n\n    pub fn set_vsync(&mut self, on: bool) {\n        self.vsync = on;\n        let caps = self.surface.get_capabilities(&self.adapter);\n        self.config.present_mode = present_mode(&caps, on);\n        self.surface.configure(&self.device, &self.config);\n    }\n\n    /// Acquires the next surface texture, reconfiguring when needed. None = skip this frame.\n    pub fn acquire(&mut self) -> Option<wgpu::SurfaceTexture> {\n        match self.surface.get_current_texture() {\n            wgpu::CurrentSurfaceTexture::Success(t) => Some(t),\n            wgpu::CurrentSurfaceTexture::Suboptimal(t) => {\n                // Use this frame, reconfigure for the next one.\n                self.surface.configure(&self.device, &self.config);\n                Some(t)\n            }\n            wgpu::CurrentSurfaceTexture::Outdated | wgpu::CurrentSurfaceTexture::Lost => {\n                self.surface.configure(&self.device, &self.config);\n                None\n            }\n            _ => None,\n        }\n    }\n\n    pub fn size(&self) -> (u32, u32) {\n        (self.config.width, self.config.height)\n    }\n\n    /// Renders the scene plus the egui overlay and presents. Texture updates are always\n    /// applied (and the delta cleared), even when the frame is skipped.\n    pub fn draw(&mut self, scene: &Scene, ui: Option<(&[egui::ClippedPrimitive], &mut egui::TexturesDelta, f32)>) -> bool {\n        let mut ui = ui;\n        if let Some((_, textures, _)) = ui.as_mut() {\n            for (id, deltas) in &textures.set {\n                for delta in deltas {\n                    self.egui.update_texture(&self.device, &self.queue, *id, delta);\n                }\n            }\n        }\n        let frame = self.acquire();\n        let submitted = frame.is_some();\n        if let Some(frame) = frame {\n            let view = frame.texture.create_view(&wgpu::TextureViewDescriptor::default());\n            let mut encoder = self.device.create_command_encoder(&wgpu::CommandEncoderDescriptor { label: Some(\"frame\") });\n            let size = self.size();\n            self.renderer.render(&mut encoder, scene, &view, self.config.format, size);\n            let mut cmds = Vec::new();\n            if let Some((prims, _, ppp)) = ui.as_ref() {\n                let sd = egui_wgpu::ScreenDescriptor { size_in_pixels: [size.0, size.1], pixels_per_point: *ppp };\n                cmds = self.egui.update_buffers(&self.device, &self.queue, &mut encoder, prims, &sd);\n                let pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {\n                    label: Some(\"egui\"),\n                    color_attachments: &[Some(wgpu::RenderPassColorAttachment {\n                        view: &view,\n                        depth_slice: None,\n                        resolve_target: None,\n                        ops: wgpu::Operations { load: wgpu::LoadOp::Load, store: wgpu::StoreOp::Store },\n                    })],\n                    depth_stencil_attachment: None,\n                    timestamp_writes: None,\n                    occlusion_query_set: None,\n                    multiview_mask: None,\n                });\n                self.egui.render(&mut pass.forget_lifetime(), prims, &sd);\n            }\n            self.queue.submit(cmds.into_iter().chain([encoder.finish()]));\n            self.window.pre_present_notify();\n            self.queue.present(frame);\n        }\n        if let Some((_, textures, _)) = ui {\n            for id in &textures.free {\n                self.egui.free_texture(id);\n            }\n            textures.clear();\n        }\n        submitted\n    }\n}\n\nfn present_mode(caps: &wgpu::SurfaceCapabilities, vsync: bool) -> wgpu::PresentMode {\n    let want: &[wgpu::PresentMode] = if vsync {\n        &[wgpu::PresentMode::Fifo]\n    } else {\n        &[wgpu::PresentMode::Mailbox, wgpu::PresentMode::Immediate, wgpu::PresentMode::Fifo]\n    };\n    want.iter().copied().find(|m| caps.present_modes.contains(m)).unwrap_or(caps.present_modes[0])\n}\n\n#[cfg(not(target_arch = \"wasm32\"))]\nfn pollster_block<F: std::future::Future>(f: F) -> F::Output {\n    // Minimal executor (the futures here resolve immediately on native).\n    use std::task::{Context as Cx, Poll, RawWaker, RawWakerVTable, Waker};\n    fn noop(_: *const ()) {}\n    fn clone(p: *const ()) -> RawWaker {\n        RawWaker::new(p, &VTABLE)\n    }\n    static VTABLE: RawWakerVTable = RawWakerVTable::new(clone, noop, noop, noop);\n    let waker = unsafe { Waker::from_raw(RawWaker::new(std::ptr::null(), &VTABLE)) };\n    let mut cx = Cx::from_waker(&waker);\n    let mut f = std::pin::pin!(f);\n    loop {\n        if let Poll::Ready(v) = f.as_mut().poll(&mut cx) {\n            return v;\n        }\n        std::thread::yield_now();\n    }\n}\n//! Runs the simulation at a fixed tick rate: on its own thread natively, and stepped from the\n//! frame loop in the browser (no threads there). The renderer never waits for it: it reads the\n//! two most recent frames and interpolates between them.\n\nuse std::sync::{Arc, Mutex};\nuse std::time::Duration;\n\nuse pav_core::{InputFrame, RenderFrame, Sim, SimEvent};\nuse web_time::Instant;\n\n#[cfg(not(target_arch = \"wasm32\"))]\ntype Job = Box<dyn FnOnce(&mut Sim) + Send>;\n\n#[cfg(not(target_arch = \"wasm32\"))]\nenum Cmd {\n    Run(Job),\n    Quit,\n}\n\n#[derive(Clone, Copy, Debug)]\npub struct TimeControl {\n    pub paused: bool,\n    /// Simulation speed multiplier (0.05 .. 8).\n    pub speed: f32,\n    /// Ticks to advance while paused.\n    pub step_requests: u32,\n    /// Holding the rewind button.\n    pub rewinding: bool,\n    /// Ticks travelled back per tick while rewinding.\n    pub rewind_speed: u32,\n    /// Jump to this tick (timeline scrubbing), keeping the future until play resumes.\n    pub scrub: Option<u64>,\n}\n\nimpl Default for TimeControl {\n    fn default() -> Self {\n        Self { paused: false, speed: 1.0, step_requests: 0, rewinding: false, rewind_speed: 1, scrub: None }\n    }\n}\n\n#[derive(Clone, Copy, Debug, Default)]\npub struct SimStats {\n    /// Measured ticks per second of wall time.\n    pub tps: f32,\n    /// Average CPU time per tick (ms).\n    pub tick_ms: f32,\n    pub tick: u64,\n    pub entities: usize,\n    /// Rewind range available (ticks).\n    pub oldest: u64,\n    pub newest: u64,\n    pub history_mb: f32,\n    pub rewound: bool,\n}\n\npub struct FramePair {\n    pub prev: Arc<RenderFrame>,\n    pub curr: Arc<RenderFrame>,\n    /// When `curr` became current (wall clock).\n    pub curr_at: Instant,\n    /// Wall-clock length of one tick at the current speed.\n    pub tick_wall: f32,\n}\n\npub struct Shared {\n    pub frames: Mutex<FramePair>,\n    pub input: Mutex<InputFrame>,\n    pub control: Mutex<TimeControl>,\n    pub stats: Mutex<SimStats>,\n    pub crashed: Mutex<Option<String>>,\n    /// Events for sound and effects, drained by the render thread.\n    pub events: Mutex<Vec<SimEvent>>,\n    /// When the input that is waiting for the next tick was pressed (latency measurement).\n    pub input_stamp: Mutex<Option<Instant>>,\n    /// (pressed, consumed by a tick, that tick's number) for the latest measured press.\n    pub latency_probe: Mutex<Option<(Instant, Instant, u64)>>,\n    /// Menu commands waiting for a tick (one rides along with each tick's input).\n    pub cmds: Mutex<std::collections::VecDeque<pav_core::arpg::GameCmd>>,\n}\n\nimpl Shared {\n    /// Queues a game command for the next free tick.\n    pub fn command(&self, c: pav_core::arpg::GameCmd) {\n        let mut q = self.cmds.lock().unwrap();\n        if q.len() < 64 {\n            q.push_back(c);\n        }\n    }\n}\n\n#[cfg(not(target_arch = \"wasm32\"))]\npub struct SimHost {\n    tx: std::sync::mpsc::Sender<Cmd>,\n    pub shared: Arc<Shared>,\n    thread: Option<std::thread::JoinHandle<()>>,\n}\n\n/// In the browser the simulation lives on the main thread and `pump` advances it every frame.\n#[cfg(target_arch = \"wasm32\")]\npub struct SimHost {\n    sim: std::cell::RefCell<Sim>,\n    clock: std::cell::RefCell<Clock>,\n    pub shared: Arc<Shared>,\n}\n\nfn shared_for(sim: &mut Sim) -> Arc<Shared> {\n    let f = Arc::new(sim.frame());\n    Arc::new(Shared {\n        frames: Mutex::new(FramePair { prev: f.clone(), curr: f, curr_at: Instant::now(), tick_wall: sim.dt() }),\n        input: Mutex::new(InputFrame::default()),\n        control: Mutex::new(TimeControl::default()),\n        stats: Mutex::new(SimStats::default()),\n        crashed: Mutex::new(None),\n        events: Mutex::new(Vec::new()),\n        input_stamp: Mutex::new(None),\n        latency_probe: Mutex::new(None),\n        cmds: Mutex::new(Default::default()),\n    })\n}\n\n#[cfg(not(target_arch = \"wasm32\"))]\nimpl SimHost {\n    pub fn start(mut sim: Sim) -> Self {\n        let shared = shared_for(&mut sim);\n        let (tx, rx) = std::sync::mpsc::channel();\n        let sh = shared.clone();\n        let thread = std::thread::Builder::new()\n            .name(\"simulation\".into())\n            .spawn(move || {\n                let sh2 = sh.clone();\n                let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(move || run(sim, rx, sh2)));\n                if let Err(e) = r {\n                    let msg = e\n                        .downcast_ref::<&str>()\n                        .map(|s| s.to_string())\n                        .or_else(|| e.downcast_ref::<String>().cloned())\n                        .unwrap_or_else(|| \"unknown panic\".into());\n                    *sh.crashed.lock().unwrap() = Some(msg);\n                }\n            })\n            .expect(\"spawn simulation thread\");\n        Self { tx, shared, thread: Some(thread) }\n    }\n\n    /// Runs `f` on the simulation thread (fire and forget).\n    pub fn exec(&self, f: impl FnOnce(&mut Sim) + Send + 'static) {\n        let _ = self.tx.send(Cmd::Run(Box::new(f)));\n    }\n\n    /// Runs `f` on the simulation thread and waits for its result.\n    pub fn query<R: Send + 'static>(&self, f: impl FnOnce(&mut Sim) -> R + Send + 'static) -> Option<R> {\n        let (rtx, rrx) = std::sync::mpsc::channel();\n        self.exec(move |sim| {\n            let _ = rtx.send(f(sim));\n        });\n        rrx.recv_timeout(Duration::from_secs(5)).ok()\n    }\n\n    /// Advances the simulation (the thread does this by itself natively).\n    pub fn pump(&self) {}\n}\n\n#[cfg(target_arch = \"wasm32\")]\nimpl SimHost {\n    pub fn start(mut sim: Sim) -> Self {\n        let shared = shared_for(&mut sim);\n        Self { sim: std::cell::RefCell::new(sim), clock: std::cell::RefCell::new(Clock::new()), shared }\n    }\n\n    pub fn exec(&self, f: impl FnOnce(&mut Sim) + 'static) {\n        let mut sim = self.sim.borrow_mut();\n        f(&mut sim);\n        let dt = sim.dt();\n        publish(&mut sim, &self.shared, dt, Instant::now());\n    }\n\n    pub fn query<R: 'static>(&self, f: impl FnOnce(&mut Sim) -> R + 'static) -> Option<R> {\n        let mut sim = self.sim.borrow_mut();\n        let r = f(&mut sim);\n        let dt = sim.dt();\n        publish(&mut sim, &self.shared, dt, Instant::now());\n        Some(r)\n    }\n\n    /// Runs the ticks that are due (called once per frame).\n    pub fn pump(&self) {\n        self.clock.borrow_mut().advance(&mut self.sim.borrow_mut(), &self.shared);\n    }\n}\n\nimpl SimHost {\n    pub fn frames(&self) -> (Arc<RenderFrame>, Arc<RenderFrame>, Instant, f32) {\n        let f = self.shared.frames.lock().unwrap();\n        (f.prev.clone(), f.curr.clone(), f.curr_at, f.tick_wall)\n    }\n\n    pub fn control(&self) -> TimeControl {\n        *self.shared.control.lock().unwrap()\n    }\n\n//! Window events -> egui input. Natively this is egui-winit; in the browser (where egui-winit\n//! does not build) a small adapter covers what the panels use: pointer, wheel, keys and text.\n\nuse winit::event::WindowEvent;\nuse winit::window::Window;\n\n#[cfg(not(target_arch = \"wasm32\"))]\npub struct UiInput(egui_winit::State);\n\n#[cfg(not(target_arch = \"wasm32\"))]\nimpl UiInput {\n    pub fn new(ctx: &egui::Context, window: &Window, max_texture: usize) -> Self {\n        Self(egui_winit::State::new(\n            ctx.clone(),\n            egui::ViewportId::ROOT,\n            window,\n            Some(window.scale_factor() as f32),\n            None,\n            Some(max_texture),\n        ))\n    }\n\n    /// Feeds an event to egui; true when egui used it (the game should ignore it).\n    pub fn on_window_event(&mut self, window: &Window, event: &WindowEvent) -> bool {\n        self.0.on_window_event(window, event).consumed\n    }\n\n    pub fn take(&mut self, window: &Window) -> egui::RawInput {\n        self.0.take_egui_input(window)\n    }\n\n    pub fn platform_output(&mut self, window: &Window, out: egui::PlatformOutput) {\n        self.0.handle_platform_output(window, out);\n    }\n}\n\n#[cfg(target_arch = \"wasm32\")]\npub struct UiInput {\n    ctx: egui::Context,\n    raw: egui::RawInput,\n    pointer: egui::Pos2,\n    modifiers: egui::Modifiers,\n    start: web_time::Instant,\n    max_texture: usize,\n    cursor: egui::CursorIcon,\n    /// The finger that is egui's pointer (the first one down).\n    touch_pointer: Option<u64>,\n}\n\n#[cfg(target_arch = \"wasm32\")]\nimpl UiInput {\n    pub fn new(ctx: &egui::Context, _window: &Window, max_texture: usize) -> Self {\n        Self {\n            ctx: ctx.clone(),\n            raw: egui::RawInput::default(),\n            pointer: egui::Pos2::ZERO,\n            modifiers: egui::Modifiers::default(),\n            start: web_time::Instant::now(),\n            max_texture,\n            cursor: egui::CursorIcon::Default,\n//! Tiny platform helpers: error pop-ups (a message box on Windows, the page in the browser) and\n//! console attachment on Windows.\n\n#[cfg(windows)]\npub fn error_box(title: &str, message: &str) {\n    use windows_sys::Win32::UI::WindowsAndMessaging::{MB_ICONERROR, MB_OK, MessageBoxW};\n    let wide = |s: &str| s.encode_utf16().chain(std::iter::once(0)).collect::<Vec<u16>>();\n    let (t, m) = (wide(title), wide(message));\n    unsafe {\n        MessageBoxW(std::ptr::null_mut(), m.as_ptr(), t.as_ptr(), MB_OK | MB_ICONERROR);\n    }\n}\n\n#[cfg(all(not(windows), not(target_arch = \"wasm32\")))]\npub fn error_box(title: &str, message: &str) {\n    eprintln!(\"== {title} ==\\n{message}\");\n}\n\n/// In the browser: replaces the page with the message.\n#[cfg(target_arch = \"wasm32\")]\npub fn error_box(title: &str, message: &str) {\n    let esc = |s: &str| s.replace('&', \"&amp;\").replace('<', \"&lt;\");\n    if let Some(body) = web_sys::window().and_then(|w| w.document()).and_then(|d| d.body()) {\n        body.set_inner_html(&format!(\n            \"<div style='font:16px sans-serif;color:#eee;padding:32px;max-width:760px'><h2>{}</h2><pre style='white-space:pre-wrap'>{}</pre></div>\",\n            esc(title),\n            esc(message)\n        ));\n    }\n}\n\n/// When started from a terminal, print there (the release .exe has no console of its own).\n#[cfg(windows)]\npub fn attach_console() {\n    use windows_sys::Win32::System::Console::{ATTACH_PARENT_PROCESS, AttachConsole};\n    unsafe {\n        AttachConsole(ATTACH_PARENT_PROCESS);\n    }\n}\n\n#[cfg(not(windows))]\npub fn attach_console() {}\n\n/// Whether this is a phone or tablet: the browser says its main pointer is a finger.\n#[cfg(target_arch = \"wasm32\")]\npub fn touch_screen() -> bool {\n    web_sys::window().and_then(|w| w.match_media(\"(pointer: coarse)\").ok().flatten()).is_some_and(|m| m.matches())\n}\n\n#[cfg(not(target_arch = \"wasm32\"))]\npub fn touch_screen() -> bool {\n    false\n}\n\n/// Full screen on or off. In the browser the whole page goes full screen (the game's own\n/// overlays stay on top of the canvas).\n#[cfg(target_arch = \"wasm32\")]\npub fn toggle_fullscreen(_window: &winit::window::Window) {\n    let Some(doc) = web_sys::window().and_then(|w| w.document()) else { return };\n    if doc.fullscreen_element().is_some() {\n        doc.exit_fullscreen();\n    } else if let Some(el) = doc.document_element() {\n        let _ = el.request_fullscreen();\n    }\n}\n\n#[cfg(not(target_arch = \"wasm32\"))]\npub fn toggle_fullscreen(window: &winit::window::Window) {\n    let on = window.fullscreen().is_some();\n    window.set_fullscreen(if on { None } else { Some(winit::window::Fullscreen::Borderless(None)) });\n}\n[package]\nname = \"pav_app\"\nversion.workspace = true\nedition.workspace = true\npublish.workspace = true\n\n[[bin]]\nname = \"shardfall\"\npath = \"src/main.rs\"\n\n[dependencies]\npav_core.workspace = true\npav_render.workspace = true\npav_view.workspace = true\npav_tools.workspace = true\npav_ui.workspace = true\npav_audio.workspace = true\nglam.workspace = true\nwinit.workspace = true\negui.workspace = true\negui-wgpu = { workspace = true, features = [\"winit\"] }\ngilrs.workspace = true\nserde.workspace = true\nserde_json.workspace = true\nanyhow.workspace = true\nlog.workspace = true\nweb-time.workspace = true\n\n[target.'cfg(not(target_arch = \"wasm32\"))'.dependencies]\nnotify.workspace = true\negui-winit = { workspace = true, features = [\"clipboard\"] }\n\n[target.'cfg(target_arch = \"wasm32\")'.dependencies]\nwasm-bindgen.workspace = true\nwasm-bindgen-futures.workspace = true\nweb-sys = { workspace = true, features = [\"Window\", \"Document\", \"Element\", \"HtmlElement\", \"Location\", \"UrlSearchParams\", \"console\", \"Storage\", \"MediaQueryList\"] }\n\n[target.'cfg(windows)'.dependencies]\nwindows-sys = { version = \"0.61\", features = [\"Win32_UI_WindowsAndMessaging\", \"Win32_System_Console\", \"Win32_Foundation\"] }\n\n[lints]\nworkspace = true\n//! Shardfall — the game executable.\n#![cfg_attr(all(windows, not(debug_assertions)), windows_subsystem = \"windows\")]\n\nmod animation_ui;\nmod animation_watch;\nmod app;\nmod asset_ui;\nmod asset_watch;\nmod boot;\n#[cfg(not(target_arch = \"wasm32\"))]\nmod bridge;\nmod creature_ui;\nmod creature_watch;\nmod edit;\nmod gfx;\nmod guide_ui;\nmod hud;\nmod input;\nmod look_ui;\nmod panel;\nmod platform;\nmod quality;\nmod rooms;\nmod save;\nmod settings;\nmod simhost;\nmod ui;\nmod uiinput;\n\nuse pav_ui::{arpg_items, arpg_ui, touch};\n\nfn fatal(msg: &str) -> ! {\n    let path = boot::diag().log_path.display().to_string();\n    log::error!(\"fatal: {msg}\");\n    platform::error_box(\"Shardfall could not start\", &format!(\"{msg}\\n\\nThe full log is in:\\n{path}\"));\n    std::process::exit(1);\n}\n\nfn main() {\n    platform::attach_console();\n    let d = boot::init();\n    boot::install_panic_hook();\n    let args: Vec<String> = std::env::args().skip(1).collect();\n    if args.iter().any(|a| a == \"--help\" || a == \"-h\") {\n        println!(\n            \"shardfall [--room NAME | --scene NAME] [--seed N] [--backend vulkan|dx12] [--no-vsync] [--fullscreen] [--bridge [ADDR]]\\n\\\n             --bridge opens the live agent bridge (default 127.0.0.1:7878; drive it with `pav live`).\\n\\\n             --animation-studio [SET/Clip] opens the animation workspace and the live agent bridge.\\n\\\n             --creature-studio [CREATURE/name] opens the creature workspace and the live agent bridge.\\n\\\n             --asset-studio [SET/name] opens the object workspace and the live agent bridge.\\n\\\n             Startup settings live in shardfall.toml next to the executable.\"\n        );\n        return;\n    }\n    log::info!(\n        \"Shardfall {} ({} {}, {} build) — log file: {}\",\n        env!(\"CARGO_PKG_VERSION\"),\n        if cfg!(target_arch = \"wasm32\") { \"browser\" } else { std::env::consts::OS },\n        std::env::consts::ARCH,\n        if cfg!(debug_assertions) { \"debug\" } else { \"release\" },\n        d.log_path.display()\n    );\n    let settings = match boot::stage(\"settings\", || {\n        let (s, note) = settings::Settings::load(&args);\n        Ok((s, note))\n    }) {\n        Ok(s) => s,\n        Err(e) => fatal(&format!(\"{e:#}\")),\n    };\n    // The browser's event loop runs on after `run` returns; errors show on the page.\n    #[cfg(target_arch = \"wasm32\")]\n    if let Err(e) = app::run(settings) {\n        fatal(&format!(\"{e:#}\"));\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    match std::panic::catch_unwind(|| app::run(settings)) {\n        Ok(Ok(())) => log::info!(\"clean exit\"),\n        Ok(Err(e)) => fatal(&format!(\"{e:#}\")),\n        Err(_) => {\n            let msg = boot::LAST_CRASH.lock().ok().and_then(|c| c.clone()).unwrap_or_else(|| \"unknown crash\".into());\n            fatal(&format!(\"Shardfall crashed:\\n{msg}\"));\n        }\n    }\n}\n","numLines":951,"startLine":1,"totalLines":951}},"tool_result_meta":[{"id":"toolu_01KNHXEuECBMKFB2KTdB5sL8","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjw9jZrjYUWSPAUFARdF","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MmbHzBaYDirsfWeZciBfVq","name":"Read","input":{"file_path":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-medium-build-v2--20261105-072416--x42677a-work/189b0832-eeab-4401-af9a-06d1cd0033c9/tool-results/b7yqieonv.txt","allow_large":true},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":17336,"cache_read_input_tokens":92733,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":17336},"output_tokens":45,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"492f3312-f4f0-4c05-9557-75f6cb290342","timestamp":"2026-11-05T14:25:00.923Z","request_id":"req_011Cgjw9j661sAvLE7rJaxDW","wire_tool_inputs":{"toolu_01MmbHzBaYDirsfWeZciBfVq":{"file_path":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-medium-build-v2--20261105-072416--x42677a-work/189b0832-eeab-4401-af9a-06d1cd0033c9/tool-results/b7yqieonv.txt","allow_large":true}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MmbHzBaYDirsfWeZciBfVq","type":"tool_result","content":"1\t//! Plain-data description of one frame. The renderer knows nothing about the simulation;\n2\t//! a view layer turns game state into a `Scene` every frame.\n3\t\n4\tuse glam::{Mat4, Vec3};\n5\t\n6\tpub use crate::mesh::MeshKey;\n7\t\n8\t/// Surface style, per object.\n9\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n10\t#[repr(u32)]\n11\tpub enum Style {\n12\t    /// Albedo only (plus cast shadows as a darker tone): the clean 2D look.\n13\t    Flat = 0,\n14\t    /// Toon bands, rim light.\n15\t    #[default]\n16\t    Cel = 1,\n17\t    /// Smooth lighting with specular.\n18\t    Lit = 2,\n19\t    /// Pure albedo, ignores all lighting and shadows (UI-like markers, emissive signs).\n20\t    Unlit = 3,\n21\t}\n22\t\n23\timpl Style {\n24\t    pub const ALL: [Style; 4] = [Style::Flat, Style::Cel, Style::Lit, Style::Unlit];\n25\t    pub fn name(self) -> &'static str {\n26\t        match self {\n27\t            Style::Flat => \"flat\",\n28\t            Style::Cel => \"cel\",\n29\t            Style::Lit => \"lit\",\n30\t            Style::Unlit => \"unlit\",\n31\t        }\n32\t    }\n33\t}\n34\t\n35\tpub mod flags {\n36\t    /// Never removed by cutaway or occlusion fade (the player, markers).\n37\t    pub const NO_CUT: u32 = 1;\n38\t    /// Does not cast shadows.\n39\t    pub const NO_SHADOW: u32 = 2;\n40\t    /// Does not receive shadows.\n41\t    pub const NO_RECEIVE_SHADOW: u32 = 4;\n42\t    /// Cutaway lowers individual vertices near the player (for big meshes like terrain).\n43\t    pub const CUT_VERTEX: u32 = 8;\n44\t    /// Both sides are real surfaces (cloth), not the inside of a solid.\n45\t    pub const TWO_SIDED: u32 = 16;\n46\t    /// Drawn as pixel art (in blocks of `FilterSettings::pixel_art` pixels) when that is\n47\t    /// above 1; the rest of the screen stays sharp.\n48\t    pub const PIXEL: u32 = 32;\n49\t    /// Part of the characters and objects (not the environment): filters aimed at one part\n50\t    /// of the scene (`Part`) tell the two apart by this flag.\n51\t    pub const OBJECT: u32 = 64;\n52\t    /// Sways in the wind like leaves (canopies, bushes, banners): vertices move more the\n53\t    /// higher they are above the bottom of the instance.\n54\t    pub const SWAY: u32 = 128;\n55\t    /// Bends like grass: far in gusts, and away from the wind's pusher (the player).\n56\t    pub const GRASS: u32 = 256;\n57\t}\n58\t\n59\t/// Wind for swaying foliage and grass (vertex shader).\n60\t#[derive(Clone, Copy, Debug, Default)]\n61\tpub struct Wind {\n62\t    /// Horizontal direction the wind blows toward (x, z).\n63\t    pub direction: glam::Vec2,\n64\t    /// 0 = still air.\n65\t    pub strength: f32,\n66\t    /// How quickly gusts roll across (1 = normal).\n67\t    pub gusts: f32,\n68\t    /// Grass bends away from this point (the player's feet) within `push_radius` (0 = off).\n69\t    pub pusher: Vec3,\n70\t    pub push_radius: f32,\n71\t}\n72\t\n73\t/// Which part of the scene a filter applies to.\n74\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n75\t#[repr(u32)]\n76\tpub enum Part {\n77\t    /// Everything on screen.\n78\t    #[default]\n79\t    All = 0,\n80\t    /// Instances flagged `flags::OBJECT` (characters, props, loot, projectiles, effects).\n81\t    Objects = 1,\n82\t    /// Everything else: level geometry, fixed scenery and the sky.\n83\t    Environment = 2,\n84\t}\n85\t\n86\t/// Painterly and print looks redrawn from the finished picture.\n87\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n88\t#[repr(u32)]\n89\tpub enum Stylize {\n90\t    #[default]\n91\t    Off = 0,\n92\t    /// Oil paint: a generalized Kuwahara filter (flat strokes that keep their edges) on canvas.\n93\t    Paint = 1,\n94\t    /// Print: rotated dot screens (CMYK comics, or black dots for newsprint).\n95\t    Halftone = 2,\n96\t    /// Text mode: each cell becomes a character picked by its brightness.\n97\t    Ascii = 3,\n98\t    /// Pencil on paper: hatching that thickens with darkness, plus contour lines.\n99\t    Sketch = 4,\n100\t}\n101\t\n102\t/// How a screen transition covers the picture.\n103\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n104\t#[repr(u32)]\n105\tpub enum Transition {\n106\t    #[default]\n107\t    Fade = 0,\n108\t    /// A circle closing on `transition_center`.\n109\t    Iris = 1,\n110\t    /// Diamonds growing in a wave across the screen.\n111\t    Diamonds = 2,\n112\t    /// Random blocks.\n113\t    Dissolve = 3,\n114\t    /// Pixels growing into big blocks, then black.\n115\t    Mosaic = 4,\n116\t    /// Horizontal blinds.\n117\t    Blinds = 5,\n118\t}\n119\t\n120\t/// A mesh rebuilt every frame (soft bodies), in world space.\n121\t#[derive(Clone, Debug)]\n122\tpub struct DynamicMesh {\n123\t    pub data: crate::mesh::MeshData,\n124\t    pub color: Vec3,\n125\t    pub emissive: f32,\n126\t    pub style: Style,\n127\t    pub flags: u32,\n128\t    pub group: u32,\n129\t    /// Procedural material: `slot | seed << 12` (see `MeshInstance::material`; its local\n130\t    /// frame is the world's).\n131\t    pub material: u32,\n132\t}\n133\t\n134\t#[derive(Clone, Copy, Debug)]\n135\tpub struct MeshInstance {\n136\t    pub mesh: MeshKey,\n137\t    pub transform: Mat4,\n138\t    /// Linear RGB albedo.\n139\t    pub color: Vec3,\n140\t    /// Emissive strength (0 = none). Adds `color * emissive` on top of lighting.\n141\t    pub emissive: f32,\n142\t    pub style: Style,\n143\t    pub flags: u32,\n144\t    /// Outline group: edges are drawn where the group changes. 0 = background, use 1 for\n145\t    /// static level geometry and unique ids for objects.\n146\t    pub group: u32,\n147\t    /// Procedural material: a row of `Scene::materials` in bits 0-11 (0 = none, the plain\n148\t    /// colour) and a per-instance seed in bits 12-31 (`material_param`). `color` and\n149\t    /// `emissive` are the material's base colour and glow, so one row serves every tint.\n150\t    pub material: u32,\n151\t    /// Half extents of the part in its own frame, for the material's axis map and gradients.\n152\t    /// ZERO derives them from the transform's columns (meshes that fill the unit cube);\n153\t    /// meshes built at their real size, like rounded boxes, set them.\n154\t    pub ext: Vec3,\n155\t}\n156\t\n157\t/// Analytic SDF primitive, ray-traced per pixel: a rounded cone between `a` and `b` with\n158\t/// radii `ra`/`rb`. Equal radii give a capsule; `a == b` gives a sphere.\n159\t#[derive(Clone, Copy, Debug)]\n160\tpub struct SdfInstance {\n161\t    pub a: Vec3,\n162\t    pub b: Vec3,\n163\t    pub ra: f32,\n164\t    pub rb: f32,\n165\t    pub color: Vec3,\n166\t    pub emissive: f32,\n167\t    pub style: Style,\n168\t    pub flags: u32,\n169\t    pub group: u32,\n170\t    /// Procedural material, as `MeshInstance::material`; the local frame runs along a→b.\n171\t    pub material: u32,\n172\t}\n173\t\n174\timpl SdfInstance {\n175\t    pub fn sphere(center: Vec3, r: f32, color: Vec3) -> Self {\n176\t        Self { a: center, b: center, ra: r, rb: r, color, emissive: 0.0, style: Style::Cel, flags: 0, group: 1, material: 0 }\n177\t    }\n178\t    pub fn capsule(a: Vec3, b: Vec3, r: f32, color: Vec3) -> Self {\n179\t        Self { a, b, ra: r, rb: r, color, emissive: 0.0, style: Style::Cel, flags: 0, group: 1, material: 0 }\n180\t    }\n181\t}\n182\t\n183\t/// Material slots per scene (bits 0-11 of an instance's `material`; slot 0 is none).\n184\tpub const MATERIAL_SLOTS: u32 = 4096;\n185\t\n186\t/// An instance's `material` word: the table row `slot` and a per-instance `seed` (20 bits).\n187\tpub fn material_param(slot: u32, seed: u32) -> u32 {\n188\t    (slot & (MATERIAL_SLOTS - 1)) | (seed & 0xfffff) << 12\n189\t}\n190\t\n191\t/// One pattern layer of a material row, laid out as `MatLayer` in `shaders/materials.wgsl`.\n192\t#[repr(C)]\n193\t#[derive(Clone, Copy, Debug, Default, PartialEq, bytemuck::Pod, bytemuck::Zeroable)]\n194\tpub struct GpuLayer {\n195\t    /// x: kernel | variant<<8 | axis<<12 | facing<<16 | mask<<20 | paint<<24 | ncells<<28;\n196\t    /// y: salt.\n197\t    pub head: [u32; 4],\n198\t    /// rgb linear colour (paint 0) or r the linear shade factor (paint 1); a strength.\n199\t    pub paint: [f32; 4],\n200\t    pub a: [f32; 4],\n201\t    pub b: [f32; 4],\n202\t    /// x vary, y cavity, z glow, w bevel.\n203\t    pub c: [f32; 4],\n204\t    /// Up to four sRGB8 cell colours (r in the low byte).\n205\t    pub cells: [u32; 4],\n206\t    /// xyz: unit axis for 1D patterns.\n207\t    pub dir: [f32; 4],\n208\t}\n209\t\n210\t/// One row of the material table (368 bytes), laid out as `Material` in\n211\t/// `shaders/materials.wgsl`. `pav_core::material` packs it; the renderer only uploads it.\n212\t#[repr(C)]\n213\t#[derive(Clone, Copy, Debug, Default, PartialEq, bytemuck::Pod, bytemuck::Zeroable)]\n214\tpub struct GpuMaterial {\n215\t    /// x layer count, y map (0 object, 1 world, 2 axis), z bit 0: turn.\n216\t    pub head: [u32; 4],\n217\t    /// x roughness (< 0 = the legacy shading), y metallic, z 1/scale.\n218\t    pub pbr: [f32; 4],\n219\t    pub layers: [GpuLayer; 3],\n220\t}\n221\t\n222\timpl GpuMaterial {\n223\t    /// u32 words in a row.\n224\t    pub const WORDS: usize = 92;\n225\t\n226\t    /// A row from its words as packed (`pav_core::material::GpuMaterial::words`).\n227\t    pub fn from_words(words: &[u32; Self::WORDS]) -> Self {\n228\t        bytemuck::pod_read_unaligned(bytemuck::cast_slice(words))\n229\t    }\n230\t}\n231\t\n232\tconst _: () = assert!(std::mem::size_of::<GpuMaterial>() == GpuMaterial::WORDS * 4);\n233\t\n234\t#[derive(Clone, Copy, Debug)]\n235\tpub struct CameraData {\n236\t    pub view: Mat4,\n237\t    pub proj: Mat4,\n238\t    pub eye: Vec3,\n239\t    pub forward: Vec3,\n240\t    pub ortho: bool,\n241\t}\n242\t\n243\timpl Default for CameraData {\n244\t    fn default() -> Self {\n245\t        let eye = Vec3::new(0.0, 10.0, 10.0);\n246\t        let forward = (-eye).normalize();\n247\t        Self {\n248\t            view: glam::camera::rh::view::look_to_mat4(eye, forward, Vec3::Y),\n249\t            proj: glam::camera::rh::proj::directx::perspective(45f32.to_radians(), 16.0 / 9.0, 0.1, 500.0),\n250\t            eye,\n251\t            forward,\n252\t            ortho: false,\n253\t        }\n254\t    }\n255\t}\n256\t\n257\t#[derive(Clone, Copy, Debug)]\n258\tpub struct Sun {\n259\t    /// Direction the light travels (from the sun toward the ground).\n260\t    pub direction: Vec3,\n261\t    /// Linear RGB, already multiplied by intensity.\n262\t    pub color: Vec3,\n263\t    pub shadows: bool,\n264\t    /// Shadows are computed in a square region around this point.\n265\t    pub shadow_center: Vec3,\n266\t    pub shadow_radius: f32,\n267\t}\n268\t\n269\timpl Default for Sun {\n270\t    fn default() -> Self {\n271\t        Self {\n272\t            direction: Vec3::new(-0.35, -1.0, -0.55).normalize(),\n273\t            color: Vec3::new(1.0, 0.95, 0.85) * 0.55,\n274\t            shadows: true,\n275\t            shadow_center: Vec3::ZERO,\n276\t            shadow_radius: 30.0,\n277\t        }\n278\t    }\n279\t}\n280\t\n281\t#[derive(Clone, Copy, Debug)]\n282\tpub struct PointLight {\n283\t    pub position: Vec3,\n284\t    /// Linear RGB times intensity.\n285\t    pub color: Vec3,\n286\t    pub radius: f32,\n287\t    /// Casts shadows (the brightest few such lights get shadow maps).\n288\t    pub shadows: bool,\n289\t}\n290\t\n291\t#[derive(Clone, Copy, Debug)]\n292\tpub struct Ambient {\n293\t    pub sky: Vec3,\n294\t    pub ground: Vec3,\n295\t}\n296\t\n297\timpl Default for Ambient {\n298\t    fn default() -> Self {\n299\t        Self { sky: Vec3::new(0.52, 0.56, 0.66), ground: Vec3::new(0.36, 0.33, 0.30) }\n300\t    }\n301\t}\n302\t\n303\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n304\tpub enum Tonemap {\n305\t    Clamp = 0,\n306\t    /// Identity below 0.8, smooth roll-off above: keeps authored colors exact.\n307\t    SoftKnee = 1,\n308\t    Aces = 2,\n309\t}\n310\t\n311\t#[derive(Clone, Copy, Debug)]\n312\tpub struct StyleSettings {\n313\t    /// Brightness of shadowed areas in the flat style (0..1).\n314\t    pub flat_shadow: f32,\n315\t    /// Number of light bands in the cel style.\n316\t    pub cel_bands: f32,\n317\t    pub rim: f32,\n318\t    pub specular: f32,\n319\t}\n320\t\n321\timpl Default for StyleSettings {\n322\t    fn default() -> Self {\n323\t        Self { flat_shadow: 0.62, cel_bands: 2.0, rim: 0.25, specular: 0.35 }\n324\t    }\n325\t}\n326\t\n327\t#[derive(Clone, Copy, Debug)]\n328\tpub struct PostSettings {\n329\t    pub outlines: bool,\n330\t    /// Outline thickness in pixels.\n331\t    pub outline_px: f32,\n332\t    /// Relative depth jump that counts as an edge.\n333\t    pub outline_depth: f32,\n334\t    /// Normal dot product below which a crease counts as an edge.\n335\t    pub outline_normal: f32,\n336\t    /// Outline = pixel color * darken (when `outline_color` is None).\n337\t    pub outline_darken: f32,\n338\t    pub outline_color: Option<Vec3>,\n339\t    pub exposure: f32,\n340\t    pub tonemap: Tonemap,\n341\t    pub saturation: f32,\n342\t    /// Bloom strength (0 = off) and the HDR brightness where glow starts.\n343\t    pub bloom: f32,\n344\t    pub bloom_threshold: f32,\n345\t    /// Screen distortion (shockwaves, haze) on/off.\n346\t    pub distortion: bool,\n347\t    /// Screen-space global illumination: bounce light and ambient occlusion (0 = off).\n348\t    pub gi: f32,\n349\t    /// Which part of the scene gets outlines.\n350\t    pub outline_part: Part,\n351\t    /// Hazy air (volumetric light): density at the haze's base height (0 = off), the height\n352\t    /// (m) over which it thins out and the base height itself; sunlight scattered toward the\n353\t    /// camera where the sun's shadow map lets it through (light shafts), how strongly that\n354\t    /// light scatters forward (0 = evenly .. 0.9 = mostly toward the sun) and lamp halos (point\n355\t    /// lights glowing in the air, 0 = off).\n356\t    pub haze: f32,\n357\t    pub haze_height: f32,\n358\t    pub haze_base: f32,\n359\t    pub shafts: f32,\n360\t    pub shafts_forward: f32,\n361\t    pub halos: f32,\n362\t}\n363\t\n364\timpl Default for PostSettings {\n365\t    fn default() -> Self {\n366\t        Self {\n367\t            outlines: true,\n368\t            outline_px: 1.0,\n369\t            outline_depth: 0.02,\n370\t            outline_normal: 0.6,\n371\t            outline_darken: 0.35,\n372\t            outline_color: None,\n373\t            exposure: 1.0,\n374\t            tonemap: Tonemap::SoftKnee,\n375\t            saturation: 1.0,\n376\t            bloom: 0.35,\n377\t            bloom_threshold: 1.2,\n378\t            distortion: true,\n379\t            gi: 0.0,\n380\t            outline_part: Part::All,\n381\t            haze: 0.0,\n382\t            haze_height: 4.0,\n383\t            haze_base: 0.0,\n384\t            shafts: 1.0,\n385\t            shafts_forward: 0.5,\n386\t            halos: 0.0,\n387\t        }\n388\t    }\n389\t}\n390\t\n391\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n392\tpub enum DistortKind {\n393\t    /// Shockwave ring pushing outward (`progress` 0..1 = ring radius / fade).\n394\t    Ring = 0,\n395\t    /// Heat haze wobble.\n396\t    Haze = 1,\n397\t    /// Magnifying lens (negative strength shrinks).\n398\t    Lens = 2,\n399\t    /// Rings travelling outward.\n400\t    Ripple = 3,\n401\t}\n402\t\n403\t/// A screen distortion source, drawn as a camera-facing disc.\n404\t#[derive(Clone, Copy, Debug)]\n405\tpub struct Distortion {\n406\t    pub pos: Vec3,\n407\t    pub radius: f32,\n408\t    /// Offset as a fraction of the disc's screen radius (0.05-0.3 typical).\n409\t    pub strength: f32,\n410\t    pub kind: DistortKind,\n411\t    pub progress: f32,\n412\t}\n413\t\n414\t/// New particles to emit this frame (they live on the GPU afterwards).\n415\t#[derive(Clone, Copy, Debug)]\n416\tpub struct ParticleBurst {\n417\t    pub count: u32,\n418\t    pub pos: Vec3,\n419\t    /// Spawn inside this box (half extents) around `pos`.\n420\t    pub area: Vec3,\n421\t    pub vel: Vec3,\n422\t    /// Random extra speed in any direction (m/s).\n423\t    pub spread: f32,\n424\t    pub gravity: f32,\n425\t    pub drag: f32,\n426\t    /// Life range (s).\n427\t    pub life: (f32, f32),\n428\t    /// Size at birth and at death (m, radius).\n429\t    pub size: (f32, f32),\n430\t    /// Linear RGB (may exceed 1 for glow) + alpha, at birth and at death.\n431\t    pub color0: glam::Vec4,\n432\t    pub color1: glam::Vec4,\n433\t    /// Adds light instead of covering (fire, sparks, magic).\n434\t    pub additive: bool,\n435\t    /// Streaks along the velocity (sparks, rain).\n436\t    pub stretch: bool,\n437\t    /// Bounce off this height (None = fall forever).\n438\t    pub floor: Option<f32>,\n439\t    pub bounce: f32,\n440\t    /// Swirling noise strength (smoke, fireflies).\n441\t    pub turbulence: f32,\n442\t    /// Born as if emitted over the last `prewarm` seconds (spread-out ages), so a new\n443\t    /// emitter starts in full swing.\n444\t    pub prewarm: f32,\n445\t}\n446\t\n447\timpl Default for ParticleBurst {\n448\t    fn default() -> Self {\n449\t        Self {\n450\t            count: 0,\n451\t            pos: Vec3::ZERO,\n452\t            area: Vec3::ZERO,\n453\t            vel: Vec3::ZERO,\n454\t            spread: 1.0,\n455\t            gravity: 0.0,\n456\t            drag: 0.0,\n457\t            life: (1.0, 1.5),\n458\t            size: (0.1, 0.0),\n459\t            color0: glam::Vec4::ONE,\n460\t            color1: glam::Vec4::new(1.0, 1.0, 1.0, 0.0),\n461\t            additive: true,\n462\t            stretch: false,\n463\t            floor: None,\n464\t            bounce: 0.3,\n465\t            turbulence: 0.0,\n466\t            prewarm: 0.0,\n467\t        }\n468\t    }\n469\t}\n470\t\n471\t/// Screen filters applied after tonemapping (retro looks and grading).\n472\t#[derive(Clone, Copy, Debug)]\n473\tpub struct FilterSettings {\n474\t    /// Pixel block size (1 = off).\n475\t    pub pixelate: f32,\n476\t    /// CRT tube curvature (0 = flat).\n477\t    pub curvature: f32,\n478\t    /// Scanline darkness (0 = off) and period in pixels.\n479\t    pub scanlines: f32,\n480\t    pub scanline_px: f32,\n481\t    /// Ordered dithering amount, colour levels per channel (< 2 = off), palette (0 = none,\n482\t    /// 1 Game Boy, 2 PICO-8, 3 CGA, 4 1-bit, 5 amber).\n483\t    pub dither: f32,\n484\t    pub levels: f32,\n485\t    pub palette: u32,\n486\t    /// Filters only right of this screen fraction (0 = whole screen): side-by-side comparisons.\n487\t    pub split: f32,\n488\t    pub temperature: f32,\n489\t    pub tint: f32,\n490\t    pub contrast: f32,\n491\t    pub brightness: f32,\n492\t    pub vignette: f32,\n493\t    pub grain: f32,\n494\t    /// Chromatic aberration.\n495\t    pub chroma: f32,\n496\t    /// Saturation of the filtered side (1 = unchanged, 0 = grey).\n497\t    pub saturation: f32,\n498\t    /// Pixel-art block size for objects with `flags::PIXEL` (1 = off), their colour levels\n499\t    /// per channel (below 2 = unchanged) and a dark one-block outline around them.\n500\t    pub pixel_art: f32,\n501\t    pub pixel_levels: f32,\n502\t    pub pixel_outline: bool,\n503\t    /// The part of the scene each filter applies to: colour reduction (palette, levels,\n504\t    /// dither), grading (temperature, tint, contrast, brightness, saturation), scanlines,\n505\t    /// grain and chromatic aberration. Curvature, vignette and `pixelate` are whole-screen.\n506\t    pub color_part: Part,\n507\t    pub grade_part: Part,\n508\t    pub scanline_part: Part,\n509\t    pub grain_part: Part,\n510\t    pub chroma_part: Part,\n511\t    /// A painterly or print look over the picture, its size in pixels (brush radius, dot\n512\t    /// cell, character width, hatching spacing), how much of it shows (0..1), how much of the\n513\t    /// scene's colour it keeps (0 = ink only, 1 = full colour) and the part it applies to.\n514\t    pub stylize: Stylize,\n515\t    pub stylize_size: f32,\n516\t    pub stylize_mix: f32,\n517\t    pub stylize_color: f32,\n518\t    pub stylize_part: Part,\n519\t    /// Screen transition: how covered the screen is (0 = clear, 1 = covered), its kind and\n520\t    /// its centre (screen fraction, 0..1 from the top left; the iris closes on it).\n521\t    pub transition: f32,\n522\t    pub transition_kind: Transition,\n523\t    pub transition_center: glam::Vec2,\n524\t}\n525\t\n526\timpl Default for FilterSettings {\n527\t    fn default() -> Self {\n528\t        Self {\n529\t            pixelate: 1.0,\n530\t            curvature: 0.0,\n531\t            scanlines: 0.0,\n532\t            scanline_px: 3.0,\n533\t            dither: 0.0,\n534\t            levels: 0.0,\n535\t            palette: 0,\n536\t            split: 0.0,\n537\t            temperature: 0.0,\n538\t            tint: 0.0,\n539\t            contrast: 1.0,\n540\t            brightness: 1.0,\n541\t            vignette: 0.0,\n542\t            grain: 0.0,\n543\t            chroma: 0.0,\n544\t            saturation: 1.0,\n545\t            pixel_art: 1.0,\n546\t            pixel_levels: 0.0,\n547\t            pixel_outline: true,\n548\t            color_part: Part::All,\n549\t            grade_part: Part::All,\n550\t            scanline_part: Part::All,\n551\t            grain_part: Part::All,\n552\t            chroma_part: Part::All,\n553\t            stylize: Stylize::Off,\n554\t            stylize_size: 4.0,\n555\t            stylize_mix: 1.0,\n556\t            stylize_color: 1.0,\n557\t            stylize_part: Part::All,\n558\t            transition: 0.0,\n559\t            transition_kind: Transition::Fade,\n560\t            transition_center: glam::Vec2::splat(0.5),\n561\t        }\n562\t    }\n563\t}\n564\t\n565\t/// Distance fog around a centre point (usually the camera target), blending into `color`.\n566\t#[derive(Clone, Copy, Debug)]\n567\tpub struct Fog {\n568\t    pub enabled: bool,\n569\t    pub center: Vec3,\n570\t    /// Horizontal distance where fog starts / is complete (m).\n571\t    pub start: f32,\n572\t    pub end: f32,\n573\t    /// Linear RGB (usually the sky colour).\n574\t    pub color: Vec3,\n575\t}\n576\t\n577\timpl Default for Fog {\n578\t    fn default() -> Self {\n579\t        Self { enabled: false, center: Vec3::ZERO, start: 60.0, end: 90.0, color: Vec3::ONE }\n580\t    }\n581\t}\n582\t\n583\t/// Camera helpers that remove geometry hiding the player.\n584\t#[derive(Clone, Copy, Debug, Default)]\n585\tpub struct Cutaway {\n586\t    /// Point of interest (usually the player's head).\n587\t    pub focus: Vec3,\n588\t    /// Remove geometry above `cut_height` within `cut_radius` (horizontal) of the focus.\n589\t    pub height_cut: bool,\n590\t    pub cut_height: f32,\n591\t    pub cut_radius: f32,\n592\t    /// Dither out geometry between the camera and the focus.\n593\t    pub fade: bool,\n594\t    pub fade_radius: f32,\n595\t    /// Remove everything closer to the camera than this distance in front of the focus\n596\t    /// (side views, where walls between camera and player hide everything). 0 = off.\n597\t    pub front_cut: f32,\n598\t}\n599\t\n600\t#[derive(Clone, Debug)]\n601\tpub struct Scene {\n602\t    pub camera: CameraData,\n603\t    pub sun: Sun,\n604\t    pub ambient: Ambient,\n605\t    pub point_lights: Vec<PointLight>,\n606\t    pub meshes: Vec<MeshInstance>,\n607\t    pub sdfs: Vec<SdfInstance>,\n608\t    /// Linear RGB.\n609\t    pub clear_color: Vec3,\n610\t    pub style: StyleSettings,\n611\t    pub post: PostSettings,\n612\t    pub filter: FilterSettings,\n613\t    pub cutaway: Cutaway,\n614\t    pub fog: Fog,\n615\t    /// Data for every `MeshKey::Custom` referenced this frame (uploaded when missing).\n616\t    pub custom_meshes: Vec<(MeshKey, std::sync::Arc<crate::mesh::MeshData>)>,\n617\t    /// Text in the world.\n618\t    pub texts: Vec<crate::text::Text3d>,\n619\t    /// Meshes rebuilt every frame (soft bodies).\n620\t    pub dynamic: Vec<DynamicMesh>,\n621\t    /// Particles born this frame.\n622\t    pub particles: Vec<ParticleBurst>,\n623\t    pub distortions: Vec<Distortion>,\n624\t    pub wind: Wind,\n625\t    pub time: f32,\n626\t    /// The procedural material table: row 0 is none (instances with material 0 draw exactly\n627\t    /// as before materials existed). Uploaded when `materials_version` changes, so keep the\n628\t    /// same `Arc` and version while the rows are unchanged.\n629\t    pub materials: std::sync::Arc<Vec<GpuMaterial>>,\n630\t    pub materials_version: u64,\n631\t}\n632\t\n633\timpl Default for Scene {\n634\t    fn default() -> Self {\n635\t        Self {\n636\t            camera: CameraData::default(),\n637\t            sun: Sun::default(),\n638\t            ambient: Ambient::default(),\n639\t            point_lights: Vec::new(),\n640\t            meshes: Vec::new(),\n641\t            sdfs: Vec::new(),\n642\t            clear_color: srgb(0x8f, 0xb8, 0xd8),\n643\t            style: StyleSettings::default(),\n644\t            post: PostSettings::default(),\n645\t            filter: FilterSettings::default(),\n646\t            cutaway: Cutaway::default(),\n647\t            fog: Fog::default(),\n648\t            custom_meshes: Vec::new(),\n649\t            texts: Vec::new(),\n650\t            dynamic: Vec::new(),\n651\t            particles: Vec::new(),\n652\t            distortions: Vec::new(),\n653\t            wind: Wind::default(),\n654\t            time: 0.0,\n655\t            materials: std::sync::Arc::default(),\n656\t            materials_version: 0,\n657\t        }\n658\t    }\n659\t}\n660\t\n661\t/// Converts an 8-bit sRGB color to linear RGB.\n662\tpub fn srgb(r: u8, g: u8, b: u8) -> Vec3 {\n663\t    Vec3::new(srgb_to_linear(r as f32 / 255.0), srgb_to_linear(g as f32 / 255.0), srgb_to_linear(b as f32 / 255.0))\n664\t}\n665\t\n666\t/// Parses \"#rrggbb\" (or \"rrggbb\") into linear RGB.\n667\tpub fn hex(s: &str) -> Option<Vec3> {\n668\t    let s = s.trim_start_matches('#');\n669\t    if s.len() != 6 {\n670\t        return None;\n671\t    }\n672\t    let v = u32::from_str_radix(s, 16).ok()?;\n673\t    Some(srgb((v >> 16) as u8, (v >> 8) as u8, v as u8))\n674\t}\n675\t\n676\tpub fn srgb_to_linear(c: f32) -> f32 {\n677\t    if c <= 0.04045 { c / 12.92 } else { ((c + 0.055) / 1.055).powf(2.4) }\n678\t}\n679\t\n680\tpub fn linear_to_srgb(c: f32) -> f32 {\n681\t    if c <= 0.0031308 { c * 12.92 } else { 1.055 * c.powf(1.0 / 2.4) - 0.055 }\n682\t}\n683\t//! Pavilion renderer: a stylized 3D renderer on wgpu. Knows nothing about the simulation.\n684\t\n685\tpub mod capture;\n686\tpub(crate) mod fx;\n687\tpub mod gpu;\n688\tpub mod mesh;\n689\tpub mod renderer;\n690\tpub mod scene;\n691\tpub mod shadows;\n692\tpub mod text;\n693\tmod upscale;\n694\t\n695\tpub use mesh::{MeshData, MeshKey};\n696\tpub use renderer::{RenderStats, Renderer};\n697\tpub use scene::*;\n698\tpub use text::{Anchor, Text3d};\n699\tpub use wgpu;\n700\t//! Procedural mesh generation. Every built-in mesh fits the unit cube [-0.5, 0.5]^3\n701\t//! so an instance's scale equals its size. Winding is counter-clockwise when seen from outside.\n702\t\n703\tuse bytemuck::{Pod, Zeroable};\n704\tuse glam::Vec3;\n705\t\n706\t#[repr(C)]\n707\t#[derive(Clone, Copy, Debug, Default, Pod, Zeroable)]\n708\tpub struct Vertex {\n709\t    pub pos: [f32; 3],\n710\t    pub normal: [f32; 3],\n711\t    pub uv: [f32; 2],\n712\t    /// Multiplied with the instance colour (white for built-in meshes).\n713\t    pub color: [f32; 4],\n714\t}\n715\t\n716\t#[derive(Clone, Debug, Default)]\n717\tpub struct MeshData {\n718\t    pub vertices: Vec<Vertex>,\n719\t    pub indices: Vec<u32>,\n720\t}\n721\t\n722\t/// Identifies a mesh. Built-ins and rounded boxes are generated on demand by the renderer;\n723\t/// `Custom` meshes must be uploaded with `Renderer::upsert_mesh` first.\n724\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord)]\n725\tpub enum MeshKey {\n726\t    Cube,\n727\t    Sphere,\n728\t    Cylinder,\n729\t    Cone,\n730\t    Plane,\n731\t    /// A tuft of grass: seven tapered, curving blades in the unit box (two-sided).\n732\t    Tuft,\n733\t    /// Rounded box with absolute half extents and corner radius, in millimetres.\n734\t    RoundedBox {\n735\t        half_mm: [u32; 3],\n736\t        radius_mm: u32,\n737\t    },\n738\t    Custom(u64),\n739\t}\n740\t\n741\timpl MeshKey {\n742\t    pub fn rounded_box(half: Vec3, radius: f32) -> Self {\n743\t        let mm = |v: f32| (v.max(0.0) * 1000.0).round() as u32;\n744\t        MeshKey::RoundedBox { half_mm: [mm(half.x), mm(half.y), mm(half.z)], radius_mm: mm(radius) }\n745\t    }\n746\t\n747\t    pub fn generate(&self) -> Option<MeshData> {\n748\t        Some(match *self {\n749\t            MeshKey::Cube => MeshData::cube(),\n750\t            MeshKey::Sphere => MeshData::sphere(32, 16),\n751\t            MeshKey::Cylinder => MeshData::cylinder(32),\n752\t            MeshKey::Cone => MeshData::cone(32),\n753\t            MeshKey::Plane => MeshData::plane(),\n754\t            MeshKey::Tuft => MeshData::tuft(),\n755\t            MeshKey::RoundedBox { half_mm, radius_mm } => {\n756\t                let h = Vec3::new(half_mm[0] as f32, half_mm[1] as f32, half_mm[2] as f32) / 1000.0;\n757\t                MeshData::rounded_box(h, radius_mm as f32 / 1000.0, 4)\n758\t            }\n759\t            MeshKey::Custom(_) => return None,\n760\t        })\n761\t    }\n762\t}\n763\t\n764\t/// Tangent frame (u, v) for a face with normal n, such that cross(u, v) == n.\n765\tfn face_frame(n: Vec3) -> (Vec3, Vec3) {\n766\t    let v = if n.y.abs() > 0.5 { Vec3::Z * n.y.signum() } else { Vec3::Y };\n767\t    let u = v.cross(n);\n768\t    (u, v)\n769\t}\n770\t\n771\tconst FACES: [Vec3; 6] = [Vec3::X, Vec3::NEG_X, Vec3::Y, Vec3::NEG_Y, Vec3::Z, Vec3::NEG_Z];\n772\t\n773\timpl MeshData {\n774\t    fn push(&mut self, pos: Vec3, normal: Vec3, uv: [f32; 2]) -> u32 {\n775\t        self.vertices.push(Vertex { pos: pos.to_array(), normal: normal.to_array(), uv, color: [1.0; 4] });\n776\t        (self.vertices.len() - 1) as u32\n777\t    }\n778\t\n779\t    /// Adds a quad; corners must be counter-clockwise seen from the side `normal` points to.\n780\t    pub fn push_quad(&mut self, p: [Vec3; 4], normal: Vec3) {\n781\t        let uvs = [[0.0, 1.0], [1.0, 1.0], [1.0, 0.0], [0.0, 0.0]];\n782\t        let i0 = self.push(p[0], normal, uvs[0]);\n783\t        for k in 1..4 {\n784\t            self.push(p[k], normal, uvs[k]);\n785\t        }\n786\t        self.indices.extend_from_slice(&[i0, i0 + 1, i0 + 2, i0, i0 + 2, i0 + 3]);\n787\t    }\n788\t\n789\t    pub fn cube() -> Self {\n790\t        let mut m = MeshData::default();\n791\t        for n in FACES {\n792\t            let (u, v) = face_frame(n);\n793\t            let c = n * 0.5;\n794\t            m.push_quad([c - u * 0.5 - v * 0.5, c + u * 0.5 - v * 0.5, c + u * 0.5 + v * 0.5, c - u * 0.5 + v * 0.5], n);\n795\t        }\n796\t        m\n797\t    }\n798\t\n799\t    /// Unit plane in XZ facing +Y.\n800\t    pub fn plane() -> Self {\n801\t        let mut m = MeshData::default();\n802\t        let (u, v) = face_frame(Vec3::Y);\n803\t        m.push_quad([-u * 0.5 - v * 0.5, u * 0.5 - v * 0.5, u * 0.5 + v * 0.5, -u * 0.5 + v * 0.5], Vec3::Y);\n804\t        m\n805\t    }\n806\t\n807\t    pub fn sphere(segments: u32, rings: u32) -> Self {\n808\t        let mut m = MeshData::default();\n809\t        for i in 0..=rings {\n810\t            let theta = std::f32::consts::PI * i as f32 / rings as f32;\n811\t            for j in 0..=segments {\n812\t                let phi = std::f32::consts::TAU * j as f32 / segments as f32;\n813\t                let n = Vec3::new(theta.sin() * phi.cos(), theta.cos(), theta.sin() * phi.sin());\n814\t                m.push(n * 0.5, n, [j as f32 / segments as f32, i as f32 / rings as f32]);\n815\t            }\n816\t        }\n817\t        let row = segments + 1;\n818\t        for i in 0..rings {\n819\t            for j in 0..segments {\n820\t//! The camera rig: every parameter is live. \"2D top-down\" is just tilt 90 + orthographic.\n821\t\n822\tuse glam::{Mat4, Vec2, Vec3};\n823\tuse pav_core::params::{ParamVisitor, Tunable};\n824\tuse pav_render::CameraData;\n825\tuse serde::{Deserialize, Serialize};\n826\t\n827\t#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n828\t#[serde(default)]\n829\tpub struct CameraParams {\n830\t    /// Degrees above the horizon: 90 = straight down, 0 = side view.\n831\t    pub tilt: f32,\n832\t    /// Degrees; 0 = looking north (-Z).\n833\t    pub yaw: f32,\n834\t    /// Distance from the focus point (metres). In orthographic mode it sets the zoom.\n835\t    pub distance: f32,\n836\t    /// Vertical field of view (degrees). Orthographic uses it to match framing.\n837\t    pub fov: f32,\n838\t    pub ortho: bool,\n839\t    /// Seconds for the camera to catch up with the focus (0 = locked).\n840\t    pub follow_lag: f32,\n841\t    /// Look slightly above the focus point (metres).\n842\t    pub height_offset: f32,\n843\t}\n844\t\n845\timpl Default for CameraParams {\n846\t    fn default() -> Self {\n847\t        Self { tilt: 62.0, yaw: 0.0, distance: 18.0, fov: 40.0, ortho: false, follow_lag: 0.12, height_offset: 0.8 }\n848\t    }\n849\t}\n850\t\n851\timpl Tunable for CameraParams {\n852\t    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n853\t        v.float(\"tilt\", &mut self.tilt, 0.0, 90.0, \"Degrees above the horizon (90 = top-down, 0 = side view)\");\n854\t        v.float(\"yaw\", &mut self.yaw, -180.0, 180.0, \"Camera rotation around the focus (degrees)\");\n855\t        v.float(\"distance\", &mut self.distance, 2.0, 120.0, \"Distance / zoom (m)\");\n856\t        v.float(\"fov\", &mut self.fov, 5.0, 100.0, \"Vertical field of view (degrees)\");\n857\t        v.bool(\"ortho\", &mut self.ortho, \"Orthographic projection (flat 2D look)\");\n858\t        v.float(\"follow_lag\", &mut self.follow_lag, 0.0, 1.0, \"Seconds to catch up with the target\");\n859\t        v.float(\"height_offset\", &mut self.height_offset, -2.0, 4.0, \"Aim above the target (m)\");\n860\t    }\n861\t}\n862\t\n863\timpl CameraParams {\n864\t    pub const PRESETS: &'static [(&'static str, fn() -> CameraParams)] = &[\n865\t        (\"classic 62°\", || CameraParams::default()),\n866\t        (\"top-down 90° ortho\", || CameraParams { tilt: 90.0, ortho: true, distance: 22.0, ..Default::default() }),\n867\t        (\"high 80°\", || CameraParams { tilt: 80.0, ..Default::default() }),\n868\t        (\"70°\", || CameraParams { tilt: 70.0, ..Default::default() }),\n869\t        (\"45°\", || CameraParams { tilt: 45.0, distance: 16.0, ..Default::default() }),\n870\t        (\"isometric\", || CameraParams { tilt: 35.264, yaw: 45.0, ortho: true, distance: 24.0, ..Default::default() }),\n871\t        (\"side view\", || CameraParams { tilt: 0.0, ortho: true, distance: 20.0, height_offset: 2.0, ..Default::default() }),\n872\t        (\"close 3rd person\", || CameraParams { tilt: 25.0, distance: 7.0, fov: 60.0, height_offset: 1.4, ..Default::default() }),\n873\t    ];\n874\t}\n875\t\n876\timpl CameraParams {\n877\t    /// Blend between two camera setups (yaw takes the short way round; projection switches\n878\t    /// halfway).\n879\t    pub fn lerp(&self, o: &CameraParams, t: f32) -> CameraParams {\n880\t        let l = |a: f32, b: f32| a + (b - a) * t;\n881\t        let dyaw = ((o.yaw - self.yaw + 540.0).rem_euclid(360.0)) - 180.0;\n882\t        CameraParams {\n883\t            tilt: l(self.tilt, o.tilt),\n884\t            yaw: ((self.yaw + dyaw * t + 540.0).rem_euclid(360.0)) - 180.0,\n885\t            distance: l(self.distance, o.distance),\n886\t            fov: l(self.fov, o.fov),\n887\t            ortho: if t < 0.5 { self.ortho } else { o.ortho },\n888\t            follow_lag: l(self.follow_lag, o.follow_lag),\n889\t            height_offset: l(self.height_offset, o.height_offset),\n890\t        }\n891\t    }\n892\t}\n893\t\n894\t#[derive(Clone, Debug)]\n895\tpub struct CameraRig {\n896\t    /// Target parameters (what the panel edits).\n897\t    pub params: CameraParams,\n898\t    /// Smoothed focus point.\n899\t    pub target: Vec3,\n900\t    initialized: bool,\n901\t    /// Blending from earlier parameters: (from, elapsed, duration).\n902\t    blend: Option<(CameraParams, f32, f32)>,\n903\t}\n904\t\n905\timpl Default for CameraRig {\n906\t    fn default() -> Self {\n907\t        Self::new(CameraParams::default())\n908\t    }\n909\t}\n910\t\n911\timpl CameraRig {\n912\t    pub fn new(params: CameraParams) -> Self {\n913\t        Self { params, target: Vec3::ZERO, initialized: false, blend: None }\n914\t    }\n915\t\n916\t    /// Parameters in effect right now (blended while a transition runs).\n917\t    pub fn current(&self) -> CameraParams {\n918\t        match &self.blend {\n919\t            Some((from, e, d)) => {\n920\t                let t = (e / d.max(1e-3)).clamp(0.0, 1.0);\n921\t                from.lerp(&self.params, t * t * (3.0 - 2.0 * t))\n922\t            }\n923\t            None => self.params.clone(),\n924\t        }\n925\t    }\n926\t\n927\t    /// Call before changing `params` to glide there over `seconds` instead of cutting.\n928\t    pub fn blend_from_current(&mut self, seconds: f32) {\n929\t        self.blend = Some((self.current(), 0.0, seconds));\n930\t    }\n931\t\n932\t    /// Follows `focus` with exponential smoothing.\n933\t    pub fn update(&mut self, focus: Vec3, dt: f32) {\n934\t        if let Some(b) = &mut self.blend {\n935\t            b.1 += dt;\n936\t            if b.1 >= b.2 {\n937\t                self.blend = None;\n938\t            }\n939\t        }\n940\t        if !self.initialized || self.params.follow_lag <= 0.0 {\n941\t            self.target = focus;\n942\t            self.initialized = true;\n943\t            return;\n944\t        }\n945\t        let k = 1.0 - (-dt / self.current().follow_lag.max(1e-3)).exp();\n946\t        self.target += (focus - self.target) * k;\n947\t    }\n948\t\n949\t    pub fn snap(&mut self, focus: Vec3) {\n950\t        self.target = focus;\n951\t        self.initialized = true;\n952\t    }\n953\t\n954\t    /// Horizontal forward (camera looking direction flattened), and right.\n955\t    pub fn ground_axes(&self) -> (Vec3, Vec3) {\n956\t        let yaw = self.current().yaw.to_radians();\n957\t        let fwd = Vec3::new(yaw.sin(), 0.0, -yaw.cos());\n958\t        let right = Vec3::new(yaw.cos(), 0.0, yaw.sin());\n959\t        (fwd, right)\n960\t    }\n961\t\n962\t    pub fn forward(&self) -> Vec3 {\n963\t        let (fh, _) = self.ground_axes();\n964\t        let t = self.current().tilt.clamp(0.0, 90.0).to_radians();\n965\t        (fh * t.cos() + Vec3::NEG_Y * t.sin()).normalize()\n966\t    }\n967\t\n968\t    pub fn up(&self) -> Vec3 {\n969\t        let (fh, _) = self.ground_axes();\n970\t        let t = self.current().tilt.clamp(0.0, 90.0).to_radians();\n971\t        (fh * t.sin() + Vec3::Y * t.cos()).normalize()\n972\t    }\n973\t\n974\t    pub fn look_at(&self) -> Vec3 {\n975\t        self.target + Vec3::Y * self.current().height_offset\n976\t    }\n977\t\n978\t    pub fn eye(&self) -> Vec3 {\n979\t        self.look_at() - self.forward() * self.current().distance\n980\t    }\n981\t\n982\t    pub fn data(&self, aspect: f32) -> CameraData {\n983\t        let p = &self.current();\n984\t        let fwd = self.forward();\n985\t        let eye = self.eye();\n986\t        let view = glam::camera::rh::view::look_to_mat4(eye, fwd, self.up());\n987\t        let mut fov = p.fov.clamp(1.0, 170.0).to_radians();\n988\t        if aspect < 1.0 && aspect > 0.0 {\n989\t            // Taller than wide (a phone held upright): the field of view is the width's, so the\n990\t            // sides are not cut down to a sliver.\n991\t            fov = (2.0 * ((fov * 0.5).tan() / aspect).atan()).min(150f32.to_radians());\n992\t        }\n993\t        let far = (p.distance * 4.0 + 200.0).max(300.0);\n994\t        let proj = if p.ortho {\n995\t            let half_h = p.distance * (fov * 0.5).tan();\n996\t            let half_w = half_h * aspect;\n997\t            glam::camera::rh::proj::directx::orthographic(-half_w, half_w, -half_h, half_h, 0.05, far)\n998\t        } else {\n999\t            glam::camera::rh::proj::directx::perspective(fov, aspect, 0.1, far)\n1000\t        };\n1001\t        CameraData { view, proj, eye, forward: fwd, ortho: p.ortho }\n1002\t    }\n1003\t\n1004\t    /// World-space ray through a pixel (origin, direction).\n1005\t    pub fn screen_ray(&self, px: Vec2, size: Vec2) -> (Vec3, Vec3) {\n1006\t        let cam = self.data(size.x / size.y.max(1.0));\n1007\t        let inv = (cam.proj * cam.view).inverse();\n1008\t        let ndc = Vec2::new(px.x / size.x * 2.0 - 1.0, 1.0 - px.y / size.y * 2.0);\n1009\t        let near = inv.project_point3(ndc.extend(0.0));\n1010\t        let far = inv.project_point3(ndc.extend(1.0));\n1011\t        (near, (far - near).normalize())\n1012\t    }\n1013\t\n1014\t    /// Where a pixel's ray hits the horizontal plane at `height`.\n1015\t    pub fn ground_point(&self, px: Vec2, size: Vec2, height: f32) -> Option<Vec3> {\n1016\t        let (o, d) = self.screen_ray(px, size);\n1017\t        if d.y.abs() < 1e-5 {\n1018\t            return None;\n1019\t        }\n1020\t        let t = (height - o.y) / d.y;\n1021\t        (t > 0.0).then(|| o + d * t)\n1022\t    }\n1023\t\n1024\t    /// Converts stick/WASD input (x right, y up) into a world direction on the ground plane.\n1025\t    pub fn relative_move(&self, input: Vec2) -> Vec2 {\n1026\t        let (f, r) = self.ground_axes();\n1027\t        let w = r * input.x + f * input.y;\n1028\t        Vec2::new(w.x, w.z)\n1029\t    }\n1030\t\n1031\t    pub fn view_proj(&self, aspect: f32) -> Mat4 {\n1032\t        let d = self.data(aspect);\n1033\t        d.proj * d.view\n1034\t    }\n1035\t}\n1036\t//! Turns simulation frames into render scenes: camera rig, interpolation, style settings.\n1037\t\n1038\tpub mod arpg;\n1039\tpub mod assets;\n1040\tpub mod build;\n1041\tpub mod camera;\n1042\tpub mod creatures;\n1043\tpub mod fx;\n1044\tpub mod look;\n1045\tpub mod materials;\n1046\tpub mod vehicles;\n1047\tpub mod water;\n1048\t\n1049\tpub use build::{ViewBuilder, ViewSettings};\n1050\tpub use camera::{CameraParams, CameraRig};\n1051\t"}]},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"c247d206-23b1-4e5a-b681-64f508ab5bc9","timestamp":"2026-11-05T14:25:01.108Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-medium-build-v2--20261105-072416--x42677a-work/189b0832-eeab-4401-af9a-06d1cd0033c9/tool-results/b7yqieonv.txt","content":"//! Plain-data description of one frame. The renderer knows nothing about the simulation;\n//! a view layer turns game state into a `Scene` every frame.\n\nuse glam::{Mat4, Vec3};\n\npub use crate::mesh::MeshKey;\n\n/// Surface style, per object.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n#[repr(u32)]\npub enum Style {\n    /// Albedo only (plus cast shadows as a darker tone): the clean 2D look.\n    Flat = 0,\n    /// Toon bands, rim light.\n    #[default]\n    Cel = 1,\n    /// Smooth lighting with specular.\n    Lit = 2,\n    /// Pure albedo, ignores all lighting and shadows (UI-like markers, emissive signs).\n    Unlit = 3,\n}\n\nimpl Style {\n    pub const ALL: [Style; 4] = [Style::Flat, Style::Cel, Style::Lit, Style::Unlit];\n    pub fn name(self) -> &'static str {\n        match self {\n            Style::Flat => \"flat\",\n            Style::Cel => \"cel\",\n            Style::Lit => \"lit\",\n            Style::Unlit => \"unlit\",\n        }\n    }\n}\n\npub mod flags {\n    /// Never removed by cutaway or occlusion fade (the player, markers).\n    pub const NO_CUT: u32 = 1;\n    /// Does not cast shadows.\n    pub const NO_SHADOW: u32 = 2;\n    /// Does not receive shadows.\n    pub const NO_RECEIVE_SHADOW: u32 = 4;\n    /// Cutaway lowers individual vertices near the player (for big meshes like terrain).\n    pub const CUT_VERTEX: u32 = 8;\n    /// Both sides are real surfaces (cloth), not the inside of a solid.\n    pub const TWO_SIDED: u32 = 16;\n    /// Drawn as pixel art (in blocks of `FilterSettings::pixel_art` pixels) when that is\n    /// above 1; the rest of the screen stays sharp.\n    pub const PIXEL: u32 = 32;\n    /// Part of the characters and objects (not the environment): filters aimed at one part\n    /// of the scene (`Part`) tell the two apart by this flag.\n    pub const OBJECT: u32 = 64;\n    /// Sways in the wind like leaves (canopies, bushes, banners): vertices move more the\n    /// higher they are above the bottom of the instance.\n    pub const SWAY: u32 = 128;\n    /// Bends like grass: far in gusts, and away from the wind's pusher (the player).\n    pub const GRASS: u32 = 256;\n}\n\n/// Wind for swaying foliage and grass (vertex shader).\n#[derive(Clone, Copy, Debug, Default)]\npub struct Wind {\n    /// Horizontal direction the wind blows toward (x, z).\n    pub direction: glam::Vec2,\n    /// 0 = still air.\n    pub strength: f32,\n    /// How quickly gusts roll across (1 = normal).\n    pub gusts: f32,\n    /// Grass bends away from this point (the player's feet) within `push_radius` (0 = off).\n    pub pusher: Vec3,\n    pub push_radius: f32,\n}\n\n/// Which part of the scene a filter applies to.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n#[repr(u32)]\npub enum Part {\n    /// Everything on screen.\n    #[default]\n    All = 0,\n    /// Instances flagged `flags::OBJECT` (characters, props, loot, projectiles, effects).\n    Objects = 1,\n    /// Everything else: level geometry, fixed scenery and the sky.\n    Environment = 2,\n}\n\n/// Painterly and print looks redrawn from the finished picture.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n#[repr(u32)]\npub enum Stylize {\n    #[default]\n    Off = 0,\n    /// Oil paint: a generalized Kuwahara filter (flat strokes that keep their edges) on canvas.\n    Paint = 1,\n    /// Print: rotated dot screens (CMYK comics, or black dots for newsprint).\n    Halftone = 2,\n    /// Text mode: each cell becomes a character picked by its brightness.\n    Ascii = 3,\n    /// Pencil on paper: hatching that thickens with darkness, plus contour lines.\n    Sketch = 4,\n}\n\n/// How a screen transition covers the picture.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n#[repr(u32)]\npub enum Transition {\n    #[default]\n    Fade = 0,\n    /// A circle closing on `transition_center`.\n    Iris = 1,\n    /// Diamonds growing in a wave across the screen.\n    Diamonds = 2,\n    /// Random blocks.\n    Dissolve = 3,\n    /// Pixels growing into big blocks, then black.\n    Mosaic = 4,\n    /// Horizontal blinds.\n    Blinds = 5,\n}\n\n/// A mesh rebuilt every frame (soft bodies), in world space.\n#[derive(Clone, Debug)]\npub struct DynamicMesh {\n    pub data: crate::mesh::MeshData,\n    pub color: Vec3,\n    pub emissive: f32,\n    pub style: Style,\n    pub flags: u32,\n    pub group: u32,\n    /// Procedural material: `slot | seed << 12` (see `MeshInstance::material`; its local\n    /// frame is the world's).\n    pub material: u32,\n}\n\n#[derive(Clone, Copy, Debug)]\npub struct MeshInstance {\n    pub mesh: MeshKey,\n    pub transform: Mat4,\n    /// Linear RGB albedo.\n    pub color: Vec3,\n    /// Emissive strength (0 = none). Adds `color * emissive` on top of lighting.\n    pub emissive: f32,\n    pub style: Style,\n    pub flags: u32,\n    /// Outline group: edges are drawn where the group changes. 0 = background, use 1 for\n    /// static level geometry and unique ids for objects.\n    pub group: u32,\n    /// Procedural material: a row of `Scene::materials` in bits 0-11 (0 = none, the plain\n    /// colour) and a per-instance seed in bits 12-31 (`material_param`). `color` and\n    /// `emissive` are the material's base colour and glow, so one row serves every tint.\n    pub material: u32,\n    /// Half extents of the part in its own frame, for the material's axis map and gradients.\n    /// ZERO derives them from the transform's columns (meshes that fill the unit cube);\n    /// meshes built at their real size, like rounded boxes, set them.\n    pub ext: Vec3,\n}\n\n/// Analytic SDF primitive, ray-traced per pixel: a rounded cone between `a` and `b` with\n/// radii `ra`/`rb`. Equal radii give a capsule; `a == b` gives a sphere.\n#[derive(Clone, Copy, Debug)]\npub struct SdfInstance {\n    pub a: Vec3,\n    pub b: Vec3,\n    pub ra: f32,\n    pub rb: f32,\n    pub color: Vec3,\n    pub emissive: f32,\n    pub style: Style,\n    pub flags: u32,\n    pub group: u32,\n    /// Procedural material, as `MeshInstance::material`; the local frame runs along a→b.\n    pub material: u32,\n}\n\nimpl SdfInstance {\n    pub fn sphere(center: Vec3, r: f32, color: Vec3) -> Self {\n        Self { a: center, b: center, ra: r, rb: r, color, emissive: 0.0, style: Style::Cel, flags: 0, group: 1, material: 0 }\n    }\n    pub fn capsule(a: Vec3, b: Vec3, r: f32, color: Vec3) -> Self {\n        Self { a, b, ra: r, rb: r, color, emissive: 0.0, style: Style::Cel, flags: 0, group: 1, material: 0 }\n    }\n}\n\n/// Material slots per scene (bits 0-11 of an instance's `material`; slot 0 is none).\npub const MATERIAL_SLOTS: u32 = 4096;\n\n/// An instance's `material` word: the table row `slot` and a per-instance `seed` (20 bits).\npub fn material_param(slot: u32, seed: u32) -> u32 {\n    (slot & (MATERIAL_SLOTS - 1)) | (seed & 0xfffff) << 12\n}\n\n/// One pattern layer of a material row, laid out as `MatLayer` in `shaders/materials.wgsl`.\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default, PartialEq, bytemuck::Pod, bytemuck::Zeroable)]\npub struct GpuLayer {\n    /// x: kernel | variant<<8 | axis<<12 | facing<<16 | mask<<20 | paint<<24 | ncells<<28;\n    /// y: salt.\n    pub head: [u32; 4],\n    /// rgb linear colour (paint 0) or r the linear shade factor (paint 1); a strength.\n    pub paint: [f32; 4],\n    pub a: [f32; 4],\n    pub b: [f32; 4],\n    /// x vary, y cavity, z glow, w bevel.\n    pub c: [f32; 4],\n    /// Up to four sRGB8 cell colours (r in the low byte).\n    pub cells: [u32; 4],\n    /// xyz: unit axis for 1D patterns.\n    pub dir: [f32; 4],\n}\n\n/// One row of the material table (368 bytes), laid out as `Material` in\n/// `shaders/materials.wgsl`. `pav_core::material` packs it; the renderer only uploads it.\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default, PartialEq, bytemuck::Pod, bytemuck::Zeroable)]\npub struct GpuMaterial {\n    /// x layer count, y map (0 object, 1 world, 2 axis), z bit 0: turn.\n    pub head: [u32; 4],\n    /// x roughness (< 0 = the legacy shading), y metallic, z 1/scale.\n    pub pbr: [f32; 4],\n    pub layers: [GpuLayer; 3],\n}\n\nimpl GpuMaterial {\n    /// u32 words in a row.\n    pub const WORDS: usize = 92;\n\n    /// A row from its words as packed (`pav_core::material::GpuMaterial::words`).\n    pub fn from_words(words: &[u32; Self::WORDS]) -> Self {\n        bytemuck::pod_read_unaligned(bytemuck::cast_slice(words))\n    }\n}\n\nconst _: () = assert!(std::mem::size_of::<GpuMaterial>() == GpuMaterial::WORDS * 4);\n\n#[derive(Clone, Copy, Debug)]\npub struct CameraData {\n    pub view: Mat4,\n    pub proj: Mat4,\n    pub eye: Vec3,\n    pub forward: Vec3,\n    pub ortho: bool,\n}\n\nimpl Default for CameraData {\n    fn default() -> Self {\n        let eye = Vec3::new(0.0, 10.0, 10.0);\n        let forward = (-eye).normalize();\n        Self {\n            view: glam::camera::rh::view::look_to_mat4(eye, forward, Vec3::Y),\n            proj: glam::camera::rh::proj::directx::perspective(45f32.to_radians(), 16.0 / 9.0, 0.1, 500.0),\n            eye,\n            forward,\n            ortho: false,\n        }\n    }\n}\n\n#[derive(Clone, Copy, Debug)]\npub struct Sun {\n    /// Direction the light travels (from the sun toward the ground).\n    pub direction: Vec3,\n    /// Linear RGB, already multiplied by intensity.\n    pub color: Vec3,\n    pub shadows: bool,\n    /// Shadows are computed in a square region around this point.\n    pub shadow_center: Vec3,\n    pub shadow_radius: f32,\n}\n\nimpl Default for Sun {\n    fn default() -> Self {\n        Self {\n            direction: Vec3::new(-0.35, -1.0, -0.55).normalize(),\n            color: Vec3::new(1.0, 0.95, 0.85) * 0.55,\n            shadows: true,\n            shadow_center: Vec3::ZERO,\n            shadow_radius: 30.0,\n        }\n    }\n}\n\n#[derive(Clone, Copy, Debug)]\npub struct PointLight {\n    pub position: Vec3,\n    /// Linear RGB times intensity.\n    pub color: Vec3,\n    pub radius: f32,\n    /// Casts shadows (the brightest few such lights get shadow maps).\n    pub shadows: bool,\n}\n\n#[derive(Clone, Copy, Debug)]\npub struct Ambient {\n    pub sky: Vec3,\n    pub ground: Vec3,\n}\n\nimpl Default for Ambient {\n    fn default() -> Self {\n        Self { sky: Vec3::new(0.52, 0.56, 0.66), ground: Vec3::new(0.36, 0.33, 0.30) }\n    }\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Tonemap {\n    Clamp = 0,\n    /// Identity below 0.8, smooth roll-off above: keeps authored colors exact.\n    SoftKnee = 1,\n    Aces = 2,\n}\n\n#[derive(Clone, Copy, Debug)]\npub struct StyleSettings {\n    /// Brightness of shadowed areas in the flat style (0..1).\n    pub flat_shadow: f32,\n    /// Number of light bands in the cel style.\n    pub cel_bands: f32,\n    pub rim: f32,\n    pub specular: f32,\n}\n\nimpl Default for StyleSettings {\n    fn default() -> Self {\n        Self { flat_shadow: 0.62, cel_bands: 2.0, rim: 0.25, specular: 0.35 }\n    }\n}\n\n#[derive(Clone, Copy, Debug)]\npub struct PostSettings {\n    pub outlines: bool,\n    /// Outline thickness in pixels.\n    pub outline_px: f32,\n    /// Relative depth jump that counts as an edge.\n    pub outline_depth: f32,\n    /// Normal dot product below which a crease counts as an edge.\n    pub outline_normal: f32,\n    /// Outline = pixel color * darken (when `outline_color` is None).\n    pub outline_darken: f32,\n    pub outline_color: Option<Vec3>,\n    pub exposure: f32,\n    pub tonemap: Tonemap,\n    pub saturation: f32,\n    /// Bloom strength (0 = off) and the HDR brightness where glow starts.\n    pub bloom: f32,\n    pub bloom_threshold: f32,\n    /// Screen distortion (shockwaves, haze) on/off.\n    pub distortion: bool,\n    /// Screen-space global illumination: bounce light and ambient occlusion (0 = off).\n    pub gi: f32,\n    /// Which part of the scene gets outlines.\n    pub outline_part: Part,\n    /// Hazy air (volumetric light): density at the haze's base height (0 = off), the height\n    /// (m) over which it thins out and the base height itself; sunlight scattered toward the\n    /// camera where the sun's shadow map lets it through (light shafts), how strongly that\n    /// light scatters forward (0 = evenly .. 0.9 = mostly toward the sun) and lamp halos (point\n    /// lights glowing in the air, 0 = off).\n    pub haze: f32,\n    pub haze_height: f32,\n    pub haze_base: f32,\n    pub shafts: f32,\n    pub shafts_forward: f32,\n    pub halos: f32,\n}\n\nimpl Default for PostSettings {\n    fn default() -> Self {\n        Self {\n            outlines: true,\n            outline_px: 1.0,\n            outline_depth: 0.02,\n            outline_normal: 0.6,\n            outline_darken: 0.35,\n            outline_color: None,\n            exposure: 1.0,\n            tonemap: Tonemap::SoftKnee,\n            saturation: 1.0,\n            bloom: 0.35,\n            bloom_threshold: 1.2,\n            distortion: true,\n            gi: 0.0,\n            outline_part: Part::All,\n            haze: 0.0,\n            haze_height: 4.0,\n            haze_base: 0.0,\n            shafts: 1.0,\n            shafts_forward: 0.5,\n            halos: 0.0,\n        }\n    }\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum DistortKind {\n    /// Shockwave ring pushing outward (`progress` 0..1 = ring radius / fade).\n    Ring = 0,\n    /// Heat haze wobble.\n    Haze = 1,\n    /// Magnifying lens (negative strength shrinks).\n    Lens = 2,\n    /// Rings travelling outward.\n    Ripple = 3,\n}\n\n/// A screen distortion source, drawn as a camera-facing disc.\n#[derive(Clone, Copy, Debug)]\npub struct Distortion {\n    pub pos: Vec3,\n    pub radius: f32,\n    /// Offset as a fraction of the disc's screen radius (0.05-0.3 typical).\n    pub strength: f32,\n    pub kind: DistortKind,\n    pub progress: f32,\n}\n\n/// New particles to emit this frame (they live on the GPU afterwards).\n#[derive(Clone, Copy, Debug)]\npub struct ParticleBurst {\n    pub count: u32,\n    pub pos: Vec3,\n    /// Spawn inside this box (half extents) around `pos`.\n    pub area: Vec3,\n    pub vel: Vec3,\n    /// Random extra speed in any direction (m/s).\n    pub spread: f32,\n    pub gravity: f32,\n    pub drag: f32,\n    /// Life range (s).\n    pub life: (f32, f32),\n    /// Size at birth and at death (m, radius).\n    pub size: (f32, f32),\n    /// Linear RGB (may exceed 1 for glow) + alpha, at birth and at death.\n    pub color0: glam::Vec4,\n    pub color1: glam::Vec4,\n    /// Adds light instead of covering (fire, sparks, magic).\n    pub additive: bool,\n    /// Streaks along the velocity (sparks, rain).\n    pub stretch: bool,\n    /// Bounce off this height (None = fall forever).\n    pub floor: Option<f32>,\n    pub bounce: f32,\n    /// Swirling noise strength (smoke, fireflies).\n    pub turbulence: f32,\n    /// Born as if emitted over the last `prewarm` seconds (spread-out ages), so a new\n    /// emitter starts in full swing.\n    pub prewarm: f32,\n}\n\nimpl Default for ParticleBurst {\n    fn default() -> Self {\n        Self {\n            count: 0,\n            pos: Vec3::ZERO,\n            area: Vec3::ZERO,\n            vel: Vec3::ZERO,\n            spread: 1.0,\n            gravity: 0.0,\n            drag: 0.0,\n            life: (1.0, 1.5),\n            size: (0.1, 0.0),\n            color0: glam::Vec4::ONE,\n            color1: glam::Vec4::new(1.0, 1.0, 1.0, 0.0),\n            additive: true,\n            stretch: false,\n            floor: None,\n            bounce: 0.3,\n            turbulence: 0.0,\n            prewarm: 0.0,\n        }\n    }\n}\n\n/// Screen filters applied after tonemapping (retro looks and grading).\n#[derive(Clone, Copy, Debug)]\npub struct FilterSettings {\n    /// Pixel block size (1 = off).\n    pub pixelate: f32,\n    /// CRT tube curvature (0 = flat).\n    pub curvature: f32,\n    /// Scanline darkness (0 = off) and period in pixels.\n    pub scanlines: f32,\n    pub scanline_px: f32,\n    /// Ordered dithering amount, colour levels per channel (< 2 = off), palette (0 = none,\n    /// 1 Game Boy, 2 PICO-8, 3 CGA, 4 1-bit, 5 amber).\n    pub dither: f32,\n    pub levels: f32,\n    pub palette: u32,\n    /// Filters only right of this screen fraction (0 = whole screen): side-by-side comparisons.\n    pub split: f32,\n    pub temperature: f32,\n    pub tint: f32,\n    pub contrast: f32,\n    pub brightness: f32,\n    pub vignette: f32,\n    pub grain: f32,\n    /// Chromatic aberration.\n    pub chroma: f32,\n    /// Saturation of the filtered side (1 = unchanged, 0 = grey).\n    pub saturation: f32,\n    /// Pixel-art block size for objects with `flags::PIXEL` (1 = off), their colour levels\n    /// per channel (below 2 = unchanged) and a dark one-block outline around them.\n    pub pixel_art: f32,\n    pub pixel_levels: f32,\n    pub pixel_outline: bool,\n    /// The part of the scene each filter applies to: colour reduction (palette, levels,\n    /// dither), grading (temperature, tint, contrast, brightness, saturation), scanlines,\n    /// grain and chromatic aberration. Curvature, vignette and `pixelate` are whole-screen.\n    pub color_part: Part,\n    pub grade_part: Part,\n    pub scanline_part: Part,\n    pub grain_part: Part,\n    pub chroma_part: Part,\n    /// A painterly or print look over the picture, its size in pixels (brush radius, dot\n    /// cell, character width, hatching spacing), how much of it shows (0..1), how much of the\n    /// scene's colour it keeps (0 = ink only, 1 = full colour) and the part it applies to.\n    pub stylize: Stylize,\n    pub stylize_size: f32,\n    pub stylize_mix: f32,\n    pub stylize_color: f32,\n    pub stylize_part: Part,\n    /// Screen transition: how covered the screen is (0 = clear, 1 = covered), its kind and\n    /// its centre (screen fraction, 0..1 from the top left; the iris closes on it).\n    pub transition: f32,\n    pub transition_kind: Transition,\n    pub transition_center: glam::Vec2,\n}\n\nimpl Default for FilterSettings {\n    fn default() -> Self {\n        Self {\n            pixelate: 1.0,\n            curvature: 0.0,\n            scanlines: 0.0,\n            scanline_px: 3.0,\n            dither: 0.0,\n            levels: 0.0,\n            palette: 0,\n            split: 0.0,\n            temperature: 0.0,\n            tint: 0.0,\n            contrast: 1.0,\n            brightness: 1.0,\n            vignette: 0.0,\n            grain: 0.0,\n            chroma: 0.0,\n            saturation: 1.0,\n            pixel_art: 1.0,\n            pixel_levels: 0.0,\n            pixel_outline: true,\n            color_part: Part::All,\n            grade_part: Part::All,\n            scanline_part: Part::All,\n            grain_part: Part::All,\n            chroma_part: Part::All,\n            stylize: Stylize::Off,\n            stylize_size: 4.0,\n            stylize_mix: 1.0,\n            stylize_color: 1.0,\n            stylize_part: Part::All,\n            transition: 0.0,\n            transition_kind: Transition::Fade,\n            transition_center: glam::Vec2::splat(0.5),\n        }\n    }\n}\n\n/// Distance fog around a centre point (usually the camera target), blending into `color`.\n#[derive(Clone, Copy, Debug)]\npub struct Fog {\n    pub enabled: bool,\n    pub center: Vec3,\n    /// Horizontal distance where fog starts / is complete (m).\n    pub start: f32,\n    pub end: f32,\n    /// Linear RGB (usually the sky colour).\n    pub color: Vec3,\n}\n\nimpl Default for Fog {\n    fn default() -> Self {\n        Self { enabled: false, center: Vec3::ZERO, start: 60.0, end: 90.0, color: Vec3::ONE }\n    }\n}\n\n/// Camera helpers that remove geometry hiding the player.\n#[derive(Clone, Copy, Debug, Default)]\npub struct Cutaway {\n    /// Point of interest (usually the player's head).\n    pub focus: Vec3,\n    /// Remove geometry above `cut_height` within `cut_radius` (horizontal) of the focus.\n    pub height_cut: bool,\n    pub cut_height: f32,\n    pub cut_radius: f32,\n    /// Dither out geometry between the camera and the focus.\n    pub fade: bool,\n    pub fade_radius: f32,\n    /// Remove everything closer to the camera than this distance in front of the focus\n    /// (side views, where walls between camera and player hide everything). 0 = off.\n    pub front_cut: f32,\n}\n\n#[derive(Clone, Debug)]\npub struct Scene {\n    pub camera: CameraData,\n    pub sun: Sun,\n    pub ambient: Ambient,\n    pub point_lights: Vec<PointLight>,\n    pub meshes: Vec<MeshInstance>,\n    pub sdfs: Vec<SdfInstance>,\n    /// Linear RGB.\n    pub clear_color: Vec3,\n    pub style: StyleSettings,\n    pub post: PostSettings,\n    pub filter: FilterSettings,\n    pub cutaway: Cutaway,\n    pub fog: Fog,\n    /// Data for every `MeshKey::Custom` referenced this frame (uploaded when missing).\n    pub custom_meshes: Vec<(MeshKey, std::sync::Arc<crate::mesh::MeshData>)>,\n    /// Text in the world.\n    pub texts: Vec<crate::text::Text3d>,\n    /// Meshes rebuilt every frame (soft bodies).\n    pub dynamic: Vec<DynamicMesh>,\n    /// Particles born this frame.\n    pub particles: Vec<ParticleBurst>,\n    pub distortions: Vec<Distortion>,\n    pub wind: Wind,\n    pub time: f32,\n    /// The procedural material table: row 0 is none (instances with material 0 draw exactly\n    /// as before materials existed). Uploaded when `materials_version` changes, so keep the\n    /// same `Arc` and version while the rows are unchanged.\n    pub materials: std::sync::Arc<Vec<GpuMaterial>>,\n    pub materials_version: u64,\n}\n\nimpl Default for Scene {\n    fn default() -> Self {\n        Self {\n            camera: CameraData::default(),\n            sun: Sun::default(),\n            ambient: Ambient::default(),\n            point_lights: Vec::new(),\n            meshes: Vec::new(),\n            sdfs: Vec::new(),\n            clear_color: srgb(0x8f, 0xb8, 0xd8),\n            style: StyleSettings::default(),\n            post: PostSettings::default(),\n            filter: FilterSettings::default(),\n            cutaway: Cutaway::default(),\n            fog: Fog::default(),\n            custom_meshes: Vec::new(),\n            texts: Vec::new(),\n            dynamic: Vec::new(),\n            particles: Vec::new(),\n            distortions: Vec::new(),\n            wind: Wind::default(),\n            time: 0.0,\n            materials: std::sync::Arc::default(),\n            materials_version: 0,\n        }\n    }\n}\n\n/// Converts an 8-bit sRGB color to linear RGB.\npub fn srgb(r: u8, g: u8, b: u8) -> Vec3 {\n    Vec3::new(srgb_to_linear(r as f32 / 255.0), srgb_to_linear(g as f32 / 255.0), srgb_to_linear(b as f32 / 255.0))\n}\n\n/// Parses \"#rrggbb\" (or \"rrggbb\") into linear RGB.\npub fn hex(s: &str) -> Option<Vec3> {\n    let s = s.trim_start_matches('#');\n    if s.len() != 6 {\n        return None;\n    }\n    let v = u32::from_str_radix(s, 16).ok()?;\n    Some(srgb((v >> 16) as u8, (v >> 8) as u8, v as u8))\n}\n\npub fn srgb_to_linear(c: f32) -> f32 {\n    if c <= 0.04045 { c / 12.92 } else { ((c + 0.055) / 1.055).powf(2.4) }\n}\n\npub fn linear_to_srgb(c: f32) -> f32 {\n    if c <= 0.0031308 { c * 12.92 } else { 1.055 * c.powf(1.0 / 2.4) - 0.055 }\n}\n//! Pavilion renderer: a stylized 3D renderer on wgpu. Knows nothing about the simulation.\n\npub mod capture;\npub(crate) mod fx;\npub mod gpu;\npub mod mesh;\npub mod renderer;\npub mod scene;\npub mod shadows;\npub mod text;\nmod upscale;\n\npub use mesh::{MeshData, MeshKey};\npub use renderer::{RenderStats, Renderer};\npub use scene::*;\npub use text::{Anchor, Text3d};\npub use wgpu;\n//! Procedural mesh generation. Every built-in mesh fits the unit cube [-0.5, 0.5]^3\n//! so an instance's scale equals its size. Winding is counter-clockwise when seen from outside.\n\nuse bytemuck::{Pod, Zeroable};\nuse glam::Vec3;\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default, Pod, Zeroable)]\npub struct Vertex {\n    pub pos: [f32; 3],\n    pub normal: [f32; 3],\n    pub uv: [f32; 2],\n    /// Multiplied with the instance colour (white for built-in meshes).\n    pub color: [f32; 4],\n}\n\n#[derive(Clone, Debug, Default)]\npub struct MeshData {\n    pub vertices: Vec<Vertex>,\n    pub indices: Vec<u32>,\n}\n\n/// Identifies a mesh. Built-ins and rounded boxes are generated on demand by the renderer;\n/// `Custom` meshes must be uploaded with `Renderer::upsert_mesh` first.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord)]\npub enum MeshKey {\n    Cube,\n    Sphere,\n    Cylinder,\n    Cone,\n    Plane,\n    /// A tuft of grass: seven tapered, curving blades in the unit box (two-sided).\n    Tuft,\n    /// Rounded box with absolute half extents and corner radius, in millimetres.\n    RoundedBox {\n        half_mm: [u32; 3],\n        radius_mm: u32,\n    },\n    Custom(u64),\n}\n\nimpl MeshKey {\n    pub fn rounded_box(half: Vec3, radius: f32) -> Self {\n        let mm = |v: f32| (v.max(0.0) * 1000.0).round() as u32;\n        MeshKey::RoundedBox { half_mm: [mm(half.x), mm(half.y), mm(half.z)], radius_mm: mm(radius) }\n    }\n\n    pub fn generate(&self) -> Option<MeshData> {\n        Some(match *self {\n            MeshKey::Cube => MeshData::cube(),\n            MeshKey::Sphere => MeshData::sphere(32, 16),\n            MeshKey::Cylinder => MeshData::cylinder(32),\n            MeshKey::Cone => MeshData::cone(32),\n            MeshKey::Plane => MeshData::plane(),\n            MeshKey::Tuft => MeshData::tuft(),\n            MeshKey::RoundedBox { half_mm, radius_mm } => {\n                let h = Vec3::new(half_mm[0] as f32, half_mm[1] as f32, half_mm[2] as f32) / 1000.0;\n                MeshData::rounded_box(h, radius_mm as f32 / 1000.0, 4)\n            }\n            MeshKey::Custom(_) => return None,\n        })\n    }\n}\n\n/// Tangent frame (u, v) for a face with normal n, such that cross(u, v) == n.\nfn face_frame(n: Vec3) -> (Vec3, Vec3) {\n    let v = if n.y.abs() > 0.5 { Vec3::Z * n.y.signum() } else { Vec3::Y };\n    let u = v.cross(n);\n    (u, v)\n}\n\nconst FACES: [Vec3; 6] = [Vec3::X, Vec3::NEG_X, Vec3::Y, Vec3::NEG_Y, Vec3::Z, Vec3::NEG_Z];\n\nimpl MeshData {\n    fn push(&mut self, pos: Vec3, normal: Vec3, uv: [f32; 2]) -> u32 {\n        self.vertices.push(Vertex { pos: pos.to_array(), normal: normal.to_array(), uv, color: [1.0; 4] });\n        (self.vertices.len() - 1) as u32\n    }\n\n    /// Adds a quad; corners must be counter-clockwise seen from the side `normal` points to.\n    pub fn push_quad(&mut self, p: [Vec3; 4], normal: Vec3) {\n        let uvs = [[0.0, 1.0], [1.0, 1.0], [1.0, 0.0], [0.0, 0.0]];\n        let i0 = self.push(p[0], normal, uvs[0]);\n        for k in 1..4 {\n            self.push(p[k], normal, uvs[k]);\n        }\n        self.indices.extend_from_slice(&[i0, i0 + 1, i0 + 2, i0, i0 + 2, i0 + 3]);\n    }\n\n    pub fn cube() -> Self {\n        let mut m = MeshData::default();\n        for n in FACES {\n            let (u, v) = face_frame(n);\n            let c = n * 0.5;\n            m.push_quad([c - u * 0.5 - v * 0.5, c + u * 0.5 - v * 0.5, c + u * 0.5 + v * 0.5, c - u * 0.5 + v * 0.5], n);\n        }\n        m\n    }\n\n    /// Unit plane in XZ facing +Y.\n    pub fn plane() -> Self {\n        let mut m = MeshData::default();\n        let (u, v) = face_frame(Vec3::Y);\n        m.push_quad([-u * 0.5 - v * 0.5, u * 0.5 - v * 0.5, u * 0.5 + v * 0.5, -u * 0.5 + v * 0.5], Vec3::Y);\n        m\n    }\n\n    pub fn sphere(segments: u32, rings: u32) -> Self {\n        let mut m = MeshData::default();\n        for i in 0..=rings {\n            let theta = std::f32::consts::PI * i as f32 / rings as f32;\n            for j in 0..=segments {\n                let phi = std::f32::consts::TAU * j as f32 / segments as f32;\n                let n = Vec3::new(theta.sin() * phi.cos(), theta.cos(), theta.sin() * phi.sin());\n                m.push(n * 0.5, n, [j as f32 / segments as f32, i as f32 / rings as f32]);\n            }\n        }\n        let row = segments + 1;\n        for i in 0..rings {\n            for j in 0..segments {\n//! The camera rig: every parameter is live. \"2D top-down\" is just tilt 90 + orthographic.\n\nuse glam::{Mat4, Vec2, Vec3};\nuse pav_core::params::{ParamVisitor, Tunable};\nuse pav_render::CameraData;\nuse serde::{Deserialize, Serialize};\n\n#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]\n#[serde(default)]\npub struct CameraParams {\n    /// Degrees above the horizon: 90 = straight down, 0 = side view.\n    pub tilt: f32,\n    /// Degrees; 0 = looking north (-Z).\n    pub yaw: f32,\n    /// Distance from the focus point (metres). In orthographic mode it sets the zoom.\n    pub distance: f32,\n    /// Vertical field of view (degrees). Orthographic uses it to match framing.\n    pub fov: f32,\n    pub ortho: bool,\n    /// Seconds for the camera to catch up with the focus (0 = locked).\n    pub follow_lag: f32,\n    /// Look slightly above the focus point (metres).\n    pub height_offset: f32,\n}\n\nimpl Default for CameraParams {\n    fn default() -> Self {\n        Self { tilt: 62.0, yaw: 0.0, distance: 18.0, fov: 40.0, ortho: false, follow_lag: 0.12, height_offset: 0.8 }\n    }\n}\n\nimpl Tunable for CameraParams {\n    fn visit(&mut self, v: &mut dyn ParamVisitor) {\n        v.float(\"tilt\", &mut self.tilt, 0.0, 90.0, \"Degrees above the horizon (90 = top-down, 0 = side view)\");\n        v.float(\"yaw\", &mut self.yaw, -180.0, 180.0, \"Camera rotation around the focus (degrees)\");\n        v.float(\"distance\", &mut self.distance, 2.0, 120.0, \"Distance / zoom (m)\");\n        v.float(\"fov\", &mut self.fov, 5.0, 100.0, \"Vertical field of view (degrees)\");\n        v.bool(\"ortho\", &mut self.ortho, \"Orthographic projection (flat 2D look)\");\n        v.float(\"follow_lag\", &mut self.follow_lag, 0.0, 1.0, \"Seconds to catch up with the target\");\n        v.float(\"height_offset\", &mut self.height_offset, -2.0, 4.0, \"Aim above the target (m)\");\n    }\n}\n\nimpl CameraParams {\n    pub const PRESETS: &'static [(&'static str, fn() -> CameraParams)] = &[\n        (\"classic 62°\", || CameraParams::default()),\n        (\"top-down 90° ortho\", || CameraParams { tilt: 90.0, ortho: true, distance: 22.0, ..Default::default() }),\n        (\"high 80°\", || CameraParams { tilt: 80.0, ..Default::default() }),\n        (\"70°\", || CameraParams { tilt: 70.0, ..Default::default() }),\n        (\"45°\", || CameraParams { tilt: 45.0, distance: 16.0, ..Default::default() }),\n        (\"isometric\", || CameraParams { tilt: 35.264, yaw: 45.0, ortho: true, distance: 24.0, ..Default::default() }),\n        (\"side view\", || CameraParams { tilt: 0.0, ortho: true, distance: 20.0, height_offset: 2.0, ..Default::default() }),\n        (\"close 3rd person\", || CameraParams { tilt: 25.0, distance: 7.0, fov: 60.0, height_offset: 1.4, ..Default::default() }),\n    ];\n}\n\nimpl CameraParams {\n    /// Blend between two camera setups (yaw takes the short way round; projection switches\n    /// halfway).\n    pub fn lerp(&self, o: &CameraParams, t: f32) -> CameraParams {\n        let l = |a: f32, b: f32| a + (b - a) * t;\n        let dyaw = ((o.yaw - self.yaw + 540.0).rem_euclid(360.0)) - 180.0;\n        CameraParams {\n            tilt: l(self.tilt, o.tilt),\n            yaw: ((self.yaw + dyaw * t + 540.0).rem_euclid(360.0)) - 180.0,\n            distance: l(self.distance, o.distance),\n            fov: l(self.fov, o.fov),\n            ortho: if t < 0.5 { self.ortho } else { o.ortho },\n            follow_lag: l(self.follow_lag, o.follow_lag),\n            height_offset: l(self.height_offset, o.height_offset),\n        }\n    }\n}\n\n#[derive(Clone, Debug)]\npub struct CameraRig {\n    /// Target parameters (what the panel edits).\n    pub params: CameraParams,\n    /// Smoothed focus point.\n    pub target: Vec3,\n    initialized: bool,\n    /// Blending from earlier parameters: (from, elapsed, duration).\n    blend: Option<(CameraParams, f32, f32)>,\n}\n\nimpl Default for CameraRig {\n    fn default() -> Self {\n        Self::new(CameraParams::default())\n    }\n}\n\nimpl CameraRig {\n    pub fn new(params: CameraParams) -> Self {\n        Self { params, target: Vec3::ZERO, initialized: false, blend: None }\n    }\n\n    /// Parameters in effect right now (blended while a transition runs).\n    pub fn current(&self) -> CameraParams {\n        match &self.blend {\n            Some((from, e, d)) => {\n                let t = (e / d.max(1e-3)).clamp(0.0, 1.0);\n                from.lerp(&self.params, t * t * (3.0 - 2.0 * t))\n            }\n            None => self.params.clone(),\n        }\n    }\n\n    /// Call before changing `params` to glide there over `seconds` instead of cutting.\n    pub fn blend_from_current(&mut self, seconds: f32) {\n        self.blend = Some((self.current(), 0.0, seconds));\n    }\n\n    /// Follows `focus` with exponential smoothing.\n    pub fn update(&mut self, focus: Vec3, dt: f32) {\n        if let Some(b) = &mut self.blend {\n            b.1 += dt;\n            if b.1 >= b.2 {\n                self.blend = None;\n            }\n        }\n        if !self.initialized || self.params.follow_lag <= 0.0 {\n            self.target = focus;\n            self.initialized = true;\n            return;\n        }\n        let k = 1.0 - (-dt / self.current().follow_lag.max(1e-3)).exp();\n        self.target += (focus - self.target) * k;\n    }\n\n    pub fn snap(&mut self, focus: Vec3) {\n        self.target = focus;\n        self.initialized = true;\n    }\n\n    /// Horizontal forward (camera looking direction flattened), and right.\n    pub fn ground_axes(&self) -> (Vec3, Vec3) {\n        let yaw = self.current().yaw.to_radians();\n        let fwd = Vec3::new(yaw.sin(), 0.0, -yaw.cos());\n        let right = Vec3::new(yaw.cos(), 0.0, yaw.sin());\n        (fwd, right)\n    }\n\n    pub fn forward(&self) -> Vec3 {\n        let (fh, _) = self.ground_axes();\n        let t = self.current().tilt.clamp(0.0, 90.0).to_radians();\n        (fh * t.cos() + Vec3::NEG_Y * t.sin()).normalize()\n    }\n\n    pub fn up(&self) -> Vec3 {\n        let (fh, _) = self.ground_axes();\n        let t = self.current().tilt.clamp(0.0, 90.0).to_radians();\n        (fh * t.sin() + Vec3::Y * t.cos()).normalize()\n    }\n\n    pub fn look_at(&self) -> Vec3 {\n        self.target + Vec3::Y * self.current().height_offset\n    }\n\n    pub fn eye(&self) -> Vec3 {\n        self.look_at() - self.forward() * self.current().distance\n    }\n\n    pub fn data(&self, aspect: f32) -> CameraData {\n        let p = &self.current();\n        let fwd = self.forward();\n        let eye = self.eye();\n        let view = glam::camera::rh::view::look_to_mat4(eye, fwd, self.up());\n        let mut fov = p.fov.clamp(1.0, 170.0).to_radians();\n        if aspect < 1.0 && aspect > 0.0 {\n            // Taller than wide (a phone held upright): the field of view is the width's, so the\n            // sides are not cut down to a sliver.\n            fov = (2.0 * ((fov * 0.5).tan() / aspect).atan()).min(150f32.to_radians());\n        }\n        let far = (p.distance * 4.0 + 200.0).max(300.0);\n        let proj = if p.ortho {\n            let half_h = p.distance * (fov * 0.5).tan();\n            let half_w = half_h * aspect;\n            glam::camera::rh::proj::directx::orthographic(-half_w, half_w, -half_h, half_h, 0.05, far)\n        } else {\n            glam::camera::rh::proj::directx::perspective(fov, aspect, 0.1, far)\n        };\n        CameraData { view, proj, eye, forward: fwd, ortho: p.ortho }\n    }\n\n    /// World-space ray through a pixel (origin, direction).\n    pub fn screen_ray(&self, px: Vec2, size: Vec2) -> (Vec3, Vec3) {\n        let cam = self.data(size.x / size.y.max(1.0));\n        let inv = (cam.proj * cam.view).inverse();\n        let ndc = Vec2::new(px.x / size.x * 2.0 - 1.0, 1.0 - px.y / size.y * 2.0);\n        let near = inv.project_point3(ndc.extend(0.0));\n        let far = inv.project_point3(ndc.extend(1.0));\n        (near, (far - near).normalize())\n    }\n\n    /// Where a pixel's ray hits the horizontal plane at `height`.\n    pub fn ground_point(&self, px: Vec2, size: Vec2, height: f32) -> Option<Vec3> {\n        let (o, d) = self.screen_ray(px, size);\n        if d.y.abs() < 1e-5 {\n            return None;\n        }\n        let t = (height - o.y) / d.y;\n        (t > 0.0).then(|| o + d * t)\n    }\n\n    /// Converts stick/WASD input (x right, y up) into a world direction on the ground plane.\n    pub fn relative_move(&self, input: Vec2) -> Vec2 {\n        let (f, r) = self.ground_axes();\n        let w = r * input.x + f * input.y;\n        Vec2::new(w.x, w.z)\n    }\n\n    pub fn view_proj(&self, aspect: f32) -> Mat4 {\n        let d = self.data(aspect);\n        d.proj * d.view\n    }\n}\n//! Turns simulation frames into render scenes: camera rig, interpolation, style settings.\n\npub mod arpg;\npub mod assets;\npub mod build;\npub mod camera;\npub mod creatures;\npub mod fx;\npub mod look;\npub mod materials;\npub mod vehicles;\npub mod water;\n\npub use build::{ViewBuilder, ViewSettings};\npub use camera::{CameraParams, CameraRig};\n","numLines":1051,"startLine":1,"totalLines":1051}},"tool_result_meta":[{"id":"toolu_01MmbHzBaYDirsfWeZciBfVq","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjw9jZrjYUWSPAUFARdF","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XY4Qde1AWPnctsnW2miNHa","name":"Read","input":{"file_path":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-medium-build-v2--20261105-072416--x42677a-work/189b0832-eeab-4401-af9a-06d1cd0033c9/tool-results/befzfj5ly.txt","allow_large":true},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":17336,"cache_read_input_tokens":92733,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":17336},"output_tokens":45,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"b8ec36d2-0735-4f87-8c4a-596b870dbd70","timestamp":"2026-11-05T14:25:02.303Z","request_id":"req_011Cgjw9j661sAvLE7rJaxDW","wire_tool_inputs":{"toolu_01XY4Qde1AWPnctsnW2miNHa":{"file_path":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-medium-build-v2--20261105-072416--x42677a-work/189b0832-eeab-4401-af9a-06d1cd0033c9/tool-results/befzfj5ly.txt","allow_large":true}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XY4Qde1AWPnctsnW2miNHa","type":"tool_result","content":"1\t//! Synthesized sound: every sound is built from oscillators, noise, envelopes, pitch sweeps\n2\t//! and a filter. The mixer runs in the audio callback (cpal) or offline (to .wav). The game\n3\t//! runs fine without a sound device.\n4\t\n5\tuse std::sync::mpsc::{Receiver, Sender, channel};\n6\t\n7\tuse glam::Vec3;\n8\tuse pav_core::SimEvent;\n9\t\n10\t#[derive(Clone, Copy, Debug, PartialEq)]\n11\tpub enum Wave {\n12\t    Sine,\n13\t    Square,\n14\t    Saw,\n15\t    Triangle,\n16\t    Noise,\n17\t}\n18\t\n19\t/// One synthesized sound.\n20\t#[derive(Clone, Copy, Debug)]\n21\tpub struct Patch {\n22\t    pub wave: Wave,\n23\t    /// Start / end frequency (Hz) and the glide time between them (s, exponential).\n24\t    pub freq: f32,\n25\t    pub freq_end: f32,\n26\t    pub glide: f32,\n27\t    pub attack: f32,\n28\t    pub decay: f32,\n29\t    pub sustain: f32,\n30\t    pub hold: f32,\n31\t    pub release: f32,\n32\t    pub volume: f32,\n33\t    /// One-pole low-pass cutoff (Hz) at start and end of the sound.\n34\t    pub cutoff: f32,\n35\t    pub cutoff_end: f32,\n36\t    /// Square-wave duty cycle.\n37\t    pub duty: f32,\n38\t}\n39\t\n40\timpl Patch {\n41\t    pub const fn new(wave: Wave, freq: f32) -> Self {\n42\t        Self {\n43\t            wave,\n44\t            freq,\n45\t            freq_end: freq,\n46\t            glide: 0.1,\n47\t            attack: 0.002,\n48\t            decay: 0.1,\n49\t            sustain: 0.0,\n50\t            hold: 0.0,\n51\t            release: 0.05,\n52\t            volume: 0.3,\n53\t            cutoff: 12000.0,\n54\t            cutoff_end: 12000.0,\n55\t            duty: 0.5,\n56\t        }\n57\t    }\n58\t    pub fn length(&self) -> f32 {\n59\t        self.attack + self.decay + self.hold + self.release\n60\t    }\n61\t}\n62\t\n63\tstruct Voice {\n64\t    p: Patch,\n65\t    t: f32,\n66\t    delay: f32,\n67\t    phase: f32,\n68\t    lp: f32,\n69\t    noise: u32,\n70\t    gain_l: f32,\n71\t    gain_r: f32,\n72\t}\n73\t\n74\timpl Voice {\n75\t    fn env(&self) -> f32 {\n76\t        let p = &self.p;\n77\t        let t = self.t;\n78\t        if t < p.attack {\n79\t            return t / p.attack.max(1e-5);\n80\t        }\n81\t        let t = t - p.attack;\n82\t        if t < p.decay {\n83\t            return 1.0 + (p.sustain - 1.0) * (t / p.decay.max(1e-5));\n84\t        }\n85\t        let t = t - p.decay;\n86\t        if t < p.hold {\n87\t            return p.sustain;\n88\t        }\n89\t        let t = t - p.hold;\n90\t        let start = if p.decay > 0.0 || p.hold > 0.0 { p.sustain } else { 1.0 };\n91\t        (start * (1.0 - t / p.release.max(1e-5))).max(0.0)\n92\t    }\n93\t\n94\t    fn done(&self) -> bool {\n95\t        self.t > self.p.length() + 0.01\n96\t    }\n97\t\n98\t    fn next(&mut self, dt: f32) -> f32 {\n99\t        if self.delay > 0.0 {\n100\t            self.delay -= dt;\n101\t            return 0.0;\n102\t        }\n103\t        let p = self.p;\n104\t        let k = (self.t / p.glide.max(1e-4)).min(1.0);\n105\t        let freq = p.freq * (p.freq_end / p.freq.max(1.0)).powf(k);\n106\t        self.phase = (self.phase + freq * dt).fract();\n107\t        let ph = self.phase;\n108\t        let raw = match p.wave {\n109\t            Wave::Sine => (ph * std::f32::consts::TAU).sin(),\n110\t            Wave::Square => {\n111\t                if ph < p.duty {\n112\t                    1.0\n113\t                } else {\n114\t                    -1.0\n115\t                }\n116\t            }\n117\t            Wave::Saw => ph * 2.0 - 1.0,\n118\t            Wave::Triangle => 1.0 - 4.0 * (ph - 0.5).abs(),\n119\t            Wave::Noise => {\n120\t                self.noise ^= self.noise << 13;\n121\t                self.noise ^= self.noise >> 17;\n122\t                self.noise ^= self.noise << 5;\n123\t                (self.noise as f32 / u32::MAX as f32) * 2.0 - 1.0\n124\t            }\n125\t        };\n126\t        let cutoff = p.cutoff * (p.cutoff_end / p.cutoff.max(1.0)).powf((self.t / p.length().max(1e-3)).min(1.0));\n127\t        let a = 1.0 - (-std::f32::consts::TAU * cutoff * dt).exp();\n128\t        self.lp += (raw - self.lp) * a;\n129\t        let s = self.lp * self.env() * p.volume;\n130\t        self.t += dt;\n131\t        s\n132\t    }\n133\t}\n134\t\n135\t/// Mixes voices into interleaved stereo.\n136\tpub struct Mixer {\n137\t    voices: Vec<Voice>,\n138\t    pub sample_rate: f32,\n139\t    pub master: f32,\n140\t    seed: u32,\n141\t}\n142\t\n143\tconst MAX_VOICES: usize = 64;\n144\t\n145\timpl Mixer {\n146\t    pub fn new(sample_rate: f32) -> Self {\n147\t        Self { voices: Vec::new(), sample_rate, master: 0.8, seed: 0x9e37_79b9 }\n148\t    }\n149\t\n150\t    /// pan -1 (left) .. 1 (right); delay in seconds.\n151\t    pub fn play(&mut self, p: Patch, pan: f32, gain: f32, delay: f32) {\n152\t        if self.voices.len() >= MAX_VOICES {\n153\t            // Drop the oldest.\n154\t            self.voices.remove(0);\n155\t        }\n156\t        self.seed = self.seed.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);\n157\t        let pan = pan.clamp(-1.0, 1.0);\n158\t        let a = (pan + 1.0) * std::f32::consts::FRAC_PI_4;\n159\t        self.voices.push(Voice {\n160\t            p,\n161\t            t: 0.0,\n162\t            delay,\n163\t            phase: 0.0,\n164\t            lp: 0.0,\n165\t            noise: self.seed | 1,\n166\t            gain_l: a.cos() * gain,\n167\t            gain_r: a.sin() * gain,\n168\t        });\n169\t    }\n170\t\n171\t    /// Renders into an interleaved stereo buffer (overwrites).\n172\t    pub fn render(&mut self, out: &mut [f32]) {\n173\t        let dt = 1.0 / self.sample_rate;\n174\t        for frame in out.chunks_mut(2) {\n175\t            let (mut l, mut r) = (0.0, 0.0);\n176\t            for v in &mut self.voices {\n177\t                let s = v.next(dt);\n178\t                l += s * v.gain_l;\n179\t                r += s * v.gain_r;\n180\t            }\n181\t            // Soft clip.\n182\t            let m = self.master;\n183\t            frame[0] = (l * m).tanh();\n184\t            if frame.len() > 1 {\n185\t                frame[1] = (r * m).tanh();\n186\t            }\n187\t        }\n188\t        self.voices.retain(|v| !v.done());\n189\t    }\n190\t\n191\t    pub fn active(&self) -> usize {\n192\t        self.voices.len()\n193\t    }\n194\t}\n195\t\n196\t/// Where the ears are: position and the camera's right vector (for panning).\n197\t#[derive(Clone, Copy, Debug)]\n198\tpub struct Listener {\n199\t    pub pos: Vec3,\n200\t    pub right: Vec3,\n201\t}\n202\t\n203\timpl Default for Listener {\n204\t    fn default() -> Self {\n205\t        Self { pos: Vec3::ZERO, right: Vec3::X }\n206\t    }\n207\t}\n208\t\n209\t/// The sound bank: which patches play for a simulation event.\n210\tpub fn sounds_for(ev: &SimEvent) -> Vec<(Patch, f32)> {\n211\t    use Wave::*;\n212\t    match ev {\n213\t        SimEvent::Jump { .. } => vec![(\n214\t            Patch {\n215\t                freq_end: 640.0,\n216\t                glide: 0.11,\n217\t                decay: 0.12,\n218\t                volume: 0.18,\n219\t                cutoff: 3500.0,\n220\t                cutoff_end: 2500.0,\n221\t                duty: 0.3,\n222\t                ..Patch::new(Square, 280.0)\n223\t            },\n224\t            0.0,\n225\t        )],\n226\t        SimEvent::Land { speed, .. } => {\n227\t            let v = (speed / 14.0).clamp(0.15, 1.0);\n228\t            vec![\n229\t                (Patch { decay: 0.12, volume: 0.35 * v, cutoff: 1100.0, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) }, 0.0),\n230\t                (Patch { freq_end: 45.0, glide: 0.1, decay: 0.14, volume: 0.45 * v, ..Patch::new(Sine, 110.0) }, 0.0),\n231\t            ]\n232\t        }\n233\t        SimEvent::Step { .. } => {\n234\t            vec![(Patch { decay: 0.045, volume: 0.07, cutoff: 1800.0, cutoff_end: 500.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n235\t        }\n236\t        SimEvent::Throw { .. } => vec![(\n237\t            Patch { attack: 0.03, decay: 0.16, volume: 0.1, cutoff: 900.0, cutoff_end: 4500.0, ..Patch::new(Noise, 1.0) },\n238\t            0.0,\n239\t        )],\n240\t        SimEvent::Explosion { radius, .. } => {\n241\t            let v = (radius / 1.35).clamp(0.5, 2.0);\n242\t            vec![\n243\t                (\n244\t                    Patch {\n245\t                        attack: 0.004,\n246\t                        decay: 0.25,\n247\t                        sustain: 0.35,\n248\t                        hold: 0.1,\n249\t                        release: 0.6,\n250\t                        volume: 0.6 * v,\n251\t                        cutoff: 4000.0,\n252\t                        cutoff_end: 120.0,\n253\t                        ..Patch::new(Noise, 1.0)\n254\t                    },\n255\t                    0.0,\n256\t                ),\n257\t                (Patch { freq_end: 28.0, glide: 0.5, decay: 0.7, volume: 0.7 * v, ..Patch::new(Sine, 85.0) }, 0.0),\n258\t            ]\n259\t        }\n260\t        SimEvent::EnterRoom { .. } => vec![\n261\t            (Patch { decay: 0.25, volume: 0.12, ..Patch::new(Triangle, 659.3) }, 0.0),\n262\t            (Patch { decay: 0.35, volume: 0.12, ..Patch::new(Triangle, 987.8) }, 0.09),\n263\t        ],\n264\t        SimEvent::Hit { strength, .. } => {\n265\t            let v = (strength / 8.0).clamp(0.4, 1.2);\n266\t            vec![\n267\t                (Patch { decay: 0.09, volume: 0.3 * v, cutoff: 2500.0, cutoff_end: 300.0, ..Patch::new(Noise, 1.0) }, 0.0),\n268\t                (\n269\t                    Patch { freq_end: 90.0, glide: 0.12, decay: 0.16, volume: 0.3 * v, duty: 0.4, ..Patch::new(Square, 220.0) },\n270\t                    0.0,\n271\t                ),\n272\t            ]\n273\t        }\n274\t        // Shardfall.\n275\t        SimEvent::Swing { heavy, .. } => {\n276\t            let h = if *heavy { 1.4 } else { 1.0 };\n277\t            vec![(\n278\t                Patch {\n279\t                    attack: 0.02,\n280\t                    decay: 0.12 * h,\n281\t                    volume: 0.16 * h,\n282\t                    cutoff: 1800.0,\n283\t                    cutoff_end: 5200.0,\n284\t                    ..Patch::new(Noise, 1.0)\n285\t                },\n286\t                0.0,\n287\t            )]\n288\t        }\n289\t        SimEvent::Strike { power, element, crit, .. } => {\n290\t            let v = (power.sqrt() / 4.0).clamp(0.35, 1.2) * if *crit { 1.3 } else { 1.0 };\n291\t            let tone = [150.0, 120.0, 520.0, 900.0, 260.0][(*element as usize).min(4)];\n292\t            let mut out = vec![\n293\t                (Patch { decay: 0.07, volume: 0.24 * v, cutoff: 3200.0, cutoff_end: 400.0, ..Patch::new(Noise, 1.0) }, 0.0),\n294\t                (\n295\t                    Patch {\n296\t                        freq_end: tone * 0.5,\n297\t                        glide: 0.08,\n298\t                        decay: 0.1,\n299\t                        volume: 0.2 * v,\n300\t                        duty: 0.35,\n301\t                        ..Patch::new(Square, tone)\n302\t                    },\n303\t                    0.0,\n304\t                ),\n305\t            ];\n306\t            if *crit {\n307\t                out.push((Patch { decay: 0.18, volume: 0.12, ..Patch::new(Triangle, 1760.0) }, 0.01));\n308\t            }\n309\t            out\n310\t        }\n311\t        SimEvent::Slain { size, .. } => {\n312\t            let k = size.clamp(0.3, 1.5);\n313\t            vec![\n314\t                (\n315\t                    Patch {\n316\t                        freq_end: 60.0,\n317\t                        glide: 0.3,\n318\t                        decay: 0.3,\n319\t                        volume: 0.22 * k,\n320\t                        duty: 0.5,\n321\t                        ..Patch::new(Square, 180.0 / k)\n322\t                    },\n323\t                    0.0,\n324\t                ),\n325\t                (Patch { decay: 0.25, volume: 0.15, cutoff: 1500.0, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) }, 0.02),\n326\t            ]\n327\t        }\n328\t        SimEvent::Slam { radius, .. } => {\n329\t            let k = (radius / 2.5).clamp(0.6, 1.5);\n330\t            vec![\n331\t                (Patch { freq_end: 40.0, glide: 0.35, decay: 0.4, volume: 0.45 * k, ..Patch::new(Sine, 110.0) }, 0.0),\n332\t                (Patch { decay: 0.3, volume: 0.3 * k, cutoff: 2200.0, cutoff_end: 150.0, ..Patch::new(Noise, 1.0) }, 0.0),\n333\t            ]\n334\t        }\n335\t        SimEvent::Blast { element, .. } => {\n336\t            let cut = [2500.0, 3500.0, 6000.0, 8000.0, 2000.0][(*element as usize).min(4)];\n337\t            vec![\n338\t                (\n339\t                    Patch { attack: 0.003, decay: 0.3, volume: 0.35, cutoff: cut, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) },\n340\t                    0.0,\n341\t                ),\n342\t                (Patch { freq_end: 50.0, glide: 0.25, decay: 0.3, volume: 0.25, ..Patch::new(Sine, 140.0) }, 0.0),\n343\t            ]\n344\t        }\n345\t        SimEvent::Spell { element, .. } => {\n346\t            let f = [300.0, 260.0, 900.0, 1400.0, 420.0][(*element as usize).min(4)];\n347\t            vec![(\n348\t                Patch {\n349\t                    freq_end: f * 1.8,\n350\t                    glide: 0.15,\n351\t                    attack: 0.02,\n352\t                    decay: 0.18,\n353\t                    volume: 0.12,\n354\t                    duty: 0.25,\n355\t                    ..Patch::new(Saw, f)\n356\t                },\n357\t                0.0,\n358\t            )]\n359\t        }\n360\t        SimEvent::Coin { .. } => vec![\n361\t            (Patch { decay: 0.08, volume: 0.1, ..Patch::new(Triangle, 1980.0) }, 0.0),\n362\t            (Patch { decay: 0.12, volume: 0.09, ..Patch::new(Triangle, 2640.0) }, 0.05),\n363\t        ],\n364\t        // Drops chime by rarity: rares ring, uniques ring a chord.\n365\t        SimEvent::Loot { rarity, .. } => match rarity {\n366\t            0 => vec![(Patch { decay: 0.05, volume: 0.05, cutoff: 2500.0, ..Patch::new(Triangle, 880.0) }, 0.0)],\n367\t            1 => vec![(Patch { decay: 0.12, volume: 0.08, ..Patch::new(Triangle, 1320.0) }, 0.0)],\n368\t            2 => vec![\n369\t                (Patch { decay: 0.25, volume: 0.12, ..Patch::new(Triangle, 1568.0) }, 0.0),\n370\t                (Patch { decay: 0.35, volume: 0.1, ..Patch::new(Sine, 2093.0) }, 0.08),\n371\t            ],\n372\t            _ => vec![\n373\t                (Patch { decay: 0.5, volume: 0.14, ..Patch::new(Triangle, 784.0) }, 0.0),\n374\t                (Patch { decay: 0.5, volume: 0.13, ..Patch::new(Triangle, 988.0) }, 0.06),\n375\t                (Patch { decay: 0.6, volume: 0.13, ..Patch::new(Triangle, 1175.0) }, 0.12),\n376\t                (Patch { decay: 0.9, volume: 0.12, ..Patch::new(Sine, 1568.0) }, 0.2),\n377\t            ],\n378\t        },\n379\t        SimEvent::Pickup { .. } => {\n380\t            vec![(Patch { freq_end: 1400.0, glide: 0.06, decay: 0.07, volume: 0.08, ..Patch::new(Triangle, 700.0) }, 0.0)]\n381\t        }\n382\t        SimEvent::Travel { .. } => vec![\n383\t            (Patch { freq_end: 1200.0, glide: 0.5, decay: 0.6, volume: 0.12, ..Patch::new(Sine, 200.0) }, 0.0),\n384\t            (Patch { freq_end: 2400.0, glide: 0.4, decay: 0.5, volume: 0.06, ..Patch::new(Triangle, 600.0) }, 0.1),\n385\t        ],\n386\t        SimEvent::Potion { .. } => {\n387\t            vec![(Patch { freq_end: 700.0, glide: 0.3, decay: 0.3, volume: 0.14, ..Patch::new(Sine, 300.0) }, 0.0)]\n388\t        }\n389\t        SimEvent::Block { .. } => {\n390\t            vec![(Patch { decay: 0.2, volume: 0.2, cutoff: 6000.0, cutoff_end: 3000.0, ..Patch::new(Square, 1200.0) }, 0.0)]\n391\t        }\n392\t        SimEvent::LevelUp { .. } => vec![\n393\t            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 523.0) }, 0.0),\n394\t            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 659.0) }, 0.1),\n395\t            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 784.0) }, 0.2),\n396\t            (Patch { decay: 0.5, volume: 0.18, ..Patch::new(Triangle, 1047.0) }, 0.3),\n397\t        ],\n398\t        SimEvent::Respawn { .. } => vec![\n399\t            (Patch { freq_end: 880.0, glide: 0.18, decay: 0.2, volume: 0.12, ..Patch::new(Sine, 220.0) }, 0.0),\n400\t            (Patch { decay: 0.15, volume: 0.08, ..Patch::new(Triangle, 1320.0) }, 0.16),\n401\t        ],\n402\t        SimEvent::CourseStart { .. } => vec![(Patch { decay: 0.12, volume: 0.14, ..Patch::new(Square, 880.0) }, 0.0)],\n403\t        SimEvent::Gate { ok, .. } => {\n404\t            if *ok {\n405\t                vec![(Patch { decay: 0.1, volume: 0.12, ..Patch::new(Triangle, 1046.5) }, 0.0)]\n406\t            } else {\n407\t                vec![(\n408\t                    Patch { freq_end: 160.0, glide: 0.2, decay: 0.25, volume: 0.14, duty: 0.3, ..Patch::new(Square, 330.0) },\n409\t                    0.0,\n410\t                )]\n411\t            }\n412\t        }\n413\t        SimEvent::CourseFinish { new_best, .. } => {\n414\t            let mut v = vec![\n415\t                (Patch { decay: 0.18, volume: 0.13, ..Patch::new(Triangle, 523.3) }, 0.0),\n416\t                (Patch { decay: 0.18, volume: 0.13, ..Patch::new(Triangle, 659.3) }, 0.1),\n417\t                (Patch { decay: 0.4, volume: 0.14, ..Patch::new(Triangle, 784.0) }, 0.2),\n418\t            ];\n419\t            if *new_best {\n420\t                v.push((Patch { decay: 0.5, volume: 0.13, ..Patch::new(Triangle, 1046.5) }, 0.34));\n421\t            }\n422\t            v\n423\t        }\n424\t        SimEvent::Checkpoint { .. } => vec![\n425\t            (Patch { decay: 0.12, volume: 0.1, ..Patch::new(Sine, 1174.7) }, 0.0),\n426\t            (Patch { decay: 0.2, volume: 0.1, ..Patch::new(Sine, 1568.0) }, 0.07),\n427\t        ],\n428\t        SimEvent::Splash { .. } => vec![(\n429\t            Patch { attack: 0.01, decay: 0.35, volume: 0.25, cutoff: 3000.0, cutoff_end: 400.0, ..Patch::new(Noise, 1.0) },\n430\t            0.0,\n431\t        )],\n432\t        SimEvent::Pad { .. } => {\n433\t            vec![(Patch { freq_end: 1200.0, glide: 0.08, decay: 0.12, volume: 0.1, ..Patch::new(Sine, 600.0) }, 0.0)]\n434\t        }\n435\t        SimEvent::Grab { .. } => {\n436\t            vec![(Patch { decay: 0.05, volume: 0.12, cutoff: 1500.0, cutoff_end: 600.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n437\t        }\n438\t        SimEvent::Break { .. } => vec![\n439\t            (Patch { decay: 0.18, volume: 0.3, cutoff: 6000.0, cutoff_end: 900.0, ..Patch::new(Noise, 1.0) }, 0.0),\n440\t            (Patch { freq_end: 70.0, glide: 0.15, decay: 0.2, volume: 0.25, ..Patch::new(Sine, 160.0) }, 0.0),\n441\t        ],\n442\t        SimEvent::Crack { .. } => {\n443\t            vec![(Patch { decay: 0.04, volume: 0.12, cutoff: 5000.0, cutoff_end: 2000.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n444\t        }\n445\t        SimEvent::Bounce { .. } => {\n446\t            vec![(Patch { freq_end: 900.0, glide: 0.18, decay: 0.22, volume: 0.16, ..Patch::new(Sine, 180.0) }, 0.0)]\n447\t        }\n448\t        SimEvent::Roll { .. } => vec![(\n449\t            Patch { attack: 0.02, decay: 0.2, volume: 0.1, cutoff: 600.0, cutoff_end: 2400.0, ..Patch::new(Noise, 1.0) },\n450\t            0.0,\n451\t        )],\n452\t        SimEvent::Spotted { .. } => vec![\n453\t            (Patch { decay: 0.18, volume: 0.16, ..Patch::new(Square, 990.0) }, 0.0),\n454\t            (Patch { decay: 0.25, volume: 0.16, ..Patch::new(Square, 660.0) }, 0.16),\n455\t        ],\n456\t        SimEvent::Shot { .. } => {\n457\t            vec![(Patch { freq_end: 420.0, glide: 0.06, decay: 0.06, volume: 0.05, ..Patch::new(Square, 1500.0) }, 0.0)]\n458\t        }\n459\t        SimEvent::Damage { .. } => {\n460\t            vec![(Patch { decay: 0.03, volume: 0.08, cutoff: 3500.0, cutoff_end: 1200.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n461\t        }\n462\t        SimEvent::Destroyed { size, .. } => {\n463\t            let v = size.clamp(0.4, 2.0);\n464\t            vec![\n465\t                (\n466\t                    Patch {\n467\t                        attack: 0.003,\n468\t                        decay: 0.3,\n469\t                        volume: 0.35 * v,\n470\t                        cutoff: 5000.0,\n471\t                        cutoff_end: 200.0,\n472\t                        ..Patch::new(Noise, 1.0)\n473\t                    },\n474\t                    0.0,\n475\t                ),\n476\t                (Patch { freq_end: 40.0, glide: 0.35, decay: 0.4, volume: 0.4 * v, ..Patch::new(Sine, 140.0) }, 0.0),\n477\t            ]\n478\t        }\n479\t        _ => Vec::new(),\n480\t    }\n481\t}\n482\t\n483\t/// Position of an event (None = not spatial).\n484\tpub fn event_pos(ev: &SimEvent) -> Option<Vec3> {\n485\t    match ev {\n486\t        SimEvent::Jump { pos }\n487\t        | SimEvent::Land { pos, .. }\n488\t        | SimEvent::Step { pos }\n489\t        | SimEvent::Throw { pos }\n490\t        | SimEvent::Explosion { pos, .. }\n491\t        | SimEvent::Impact { pos, .. }\n492\t        | SimEvent::Hit { pos, .. }\n493\t        | SimEvent::Splash { pos }\n494\t        | SimEvent::Grab { pos }\n495\t        | SimEvent::Roll { pos }\n496\t        | SimEvent::Break { pos }\n497\t        | SimEvent::Crack { pos }\n498\t        | SimEvent::Bounce { pos }\n499\t        | SimEvent::Shot { pos }\n500\t        | SimEvent::Damage { pos }\n501\t        | SimEvent::Destroyed { pos, .. }\n502\t        | SimEvent::Swing { pos, .. }\n503\t        | SimEvent::Strike { pos, .. }\n504\t        | SimEvent::Slain { pos, .. }\n505\t        | SimEvent::Slam { pos, .. }\n506\t        | SimEvent::Blast { pos, .. }\n507\t        | SimEvent::Spell { pos, .. }\n508\t        | SimEvent::Coin { pos }\n509\t        | SimEvent::Loot { pos, .. }\n510\t        | SimEvent::Pickup { pos, .. }\n511\t        | SimEvent::Block { pos } => Some(*pos),\n512\t        _ => None,\n513\t    }\n514\t}\n515\t\n516\t/// Plays an event's sounds with distance attenuation and panning.\n517\tpub fn play_event(mixer: &mut Mixer, ev: &SimEvent, l: &Listener, sfx: f32) {\n518\t    let (pan, gain) = match event_pos(ev) {\n519\t        Some(p) => {\n520\t            let d = p - l.pos;\n521\t            let dist = d.length();\n522\t            ((d.dot(l.right) / 12.0).clamp(-0.85, 0.85), 1.0 / (1.0 + dist / 14.0))\n523\t        }\n524\t        None => (0.0, 1.0),\n525\t    };\n526\t    for (patch, delay) in sounds_for(ev) {\n527\t        mixer.play(patch, pan, gain * sfx, delay);\n528\t    }\n529\t}\n530\t\n531\t/// Renders timed events offline: (time in seconds, event). Returns interleaved stereo.\n532\tpub fn render_events(events: &[(f32, SimEvent)], duration: f32, sample_rate: f32, l: &Listener) -> Vec<f32> {\n533\t    let mut mixer = Mixer::new(sample_rate);\n534\t    let total = (duration * sample_rate) as usize;\n535\t    let mut out = vec![0.0f32; total * 2];\n536\t    let block = 256;\n537\t    let mut i = 0;\n538\t    let mut ev = events.iter().peekable();\n539\t    while i < total {\n540\t        let t = i as f32 / sample_rate;\n541\t        while let Some((et, e)) = ev.peek() {\n542\t            if *et > t {\n543\t                break;\n544\t            }\n545\t            play_event(&mut mixer, e, l, 1.0);\n546\t            ev.next();\n547\t        }\n548\t        let n = block.min(total - i);\n549\t        mixer.render(&mut out[i * 2..(i + n) * 2]);\n550\t        i += n;\n551\t    }\n552\t    out\n553\t}\n554\t\n555\t/// Writes interleaved stereo f32 samples as a 16-bit PCM WAV file.\n556\tpub fn write_wav(path: &std::path::Path, samples: &[f32], sample_rate: u32) -> std::io::Result<()> {\n557\t    let data_len = (samples.len() * 2) as u32;\n558\t    let mut b = Vec::with_capacity(44 + data_len as usize);\n559\t    b.extend_from_slice(b\"RIFF\");\n560\t    b.extend_from_slice(&(36 + data_len).to_le_bytes());\n561\t    b.extend_from_slice(b\"WAVEfmt \");\n562\t    b.extend_from_slice(&16u32.to_le_bytes());\n563\t    b.extend_from_slice(&1u16.to_le_bytes()); // PCM\n564\t    b.extend_from_slice(&2u16.to_le_bytes()); // stereo\n565\t    b.extend_from_slice(&sample_rate.to_le_bytes());\n566\t    b.extend_from_slice(&(sample_rate * 4).to_le_bytes());\n567\t    b.extend_from_slice(&4u16.to_le_bytes());\n568\t    b.extend_from_slice(&16u16.to_le_bytes());\n569\t    b.extend_from_slice(b\"data\");\n570\t    b.extend_from_slice(&data_len.to_le_bytes());\n571\t    for s in samples {\n572\t        b.extend_from_slice(&((s.clamp(-1.0, 1.0) * 32767.0) as i16).to_le_bytes());\n573\t    }\n574\t    if let Some(d) = path.parent().filter(|d| !d.as_os_str().is_empty()) {\n575\t        std::fs::create_dir_all(d)?;\n576\t    }\n577\t    std::fs::write(path, b)\n578\t}\n579\t\n580\tenum Cmd {\n581\t    Play(Patch, f32, f32, f32),\n582\t    Master(f32),\n583\t}\n584\t\n585\t/// Live output through the default sound device.\n586\tpub struct AudioOut {\n587\t    _stream: cpal::Stream,\n588\t    tx: Sender<Cmd>,\n589\t    pub sample_rate: u32,\n590\t    pub device: String,\n591\t}\n592\t\n593\timpl AudioOut {\n594\t    pub fn start() -> anyhow::Result<Self> {\n595\t        use cpal::traits::{DeviceTrait, HostTrait, StreamTrait};\n596\t        let host = cpal::default_host();\n597\t        let device = host.default_output_device().ok_or_else(|| anyhow::anyhow!(\"no sound output device\"))?;\n598\t        let name = device.description().map(|d| d.to_string()).unwrap_or_else(|_| \"default\".into());\n599\t        let supported = device.default_output_config()?;\n600\t        let format = supported.sample_format();\n601\t        let config: cpal::StreamConfig = supported.config();\n602\t        let rate = config.sample_rate as u32;\n603\t        let channels = config.channels as usize;\n604\t        let (tx, rx) = channel::<Cmd>();\n605\t        let stream = match format {\n606\t            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels)?,\n607\t            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels)?,\n608\t            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels)?,\n609\t            other => anyhow::bail!(\"unsupported sample format {other:?}\"),\n610\t        };\n611\t        stream.play()?;\n612\t        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name })\n613\t    }\n614\t\n615\t    pub fn play_event(&self, ev: &SimEvent, l: &Listener, sfx: f32) {\n616\t        let (pan, gain) = match event_pos(ev) {\n617\t            Some(p) => {\n618\t                let d = p - l.pos;\n619\t                ((d.dot(l.right) / 12.0).clamp(-0.85, 0.85), 1.0 / (1.0 + d.length() / 14.0))\n620\t            }\n621\t            None => (0.0, 1.0),\n622\t        };\n623\t        for (patch, delay) in sounds_for(ev) {\n624\t            let _ = self.tx.send(Cmd::Play(patch, pan, gain * sfx, delay));\n625\t        }\n626\t    }\n627\t\n628\t    pub fn set_master(&self, v: f32) {\n629\t        let _ = self.tx.send(Cmd::Master(v));\n630\t    }\n631\t\n632\t    /// Starts output again. Browsers keep sound off until the page gets a click or key press,\n633\t    /// so the browser build calls this on the first input.\n634\t    pub fn resume(&self) {\n635\t        use cpal::traits::StreamTrait;\n636\t        let _ = self._stream.play();\n637\t    }\n638\t}\n639\t\n640\tfn build<T>(device: &cpal::Device, config: cpal::StreamConfig, rx: Receiver<Cmd>, channels: usize) -> anyhow::Result<cpal::Stream>\n641\twhere\n642\t    T: cpal::SizedSample + cpal::FromSample<f32>,\n643\t{\n644\t    use cpal::traits::DeviceTrait;\n645\t    let mut mixer = Mixer::new(config.sample_rate as f32);\n646\t    let mut buf: Vec<f32> = Vec::new();\n647\t    let stream = device.build_output_stream::<T, _, _>(\n648\t        config,\n649\t        move |data: &mut [T], _| {\n650\t            while let Ok(c) = rx.try_recv() {\n651\t                match c {\n652\t                    Cmd::Play(p, pan, gain, delay) => mixer.play(p, pan, gain, delay),\n653\t                    Cmd::Master(v) => mixer.master = v,\n654\t                }\n655\t            }\n656\t            let frames = data.len() / channels.max(1);\n657\t            buf.resize(frames * 2, 0.0);\n658\t            mixer.render(&mut buf);\n659\t            for (i, frame) in data.chunks_mut(channels.max(1)).enumerate() {\n660\t                for (c, s) in frame.iter_mut().enumerate() {\n661\t                    *s = T::from_sample(buf[i * 2 + c.min(1)]);\n662\t                }\n663\t            }\n664\t        },\n665\t        |e| log::warn!(\"audio stream error: {e}\"),\n666\t        None,\n667\t    )?;\n668\t    Ok(stream)\n669\t}\n670\t\n671\t#[cfg(test)]\n672\tmod tests {\n673\t    use super::*;\n674\t\n675\t    #[test]\n676\t    fn explosion_is_loud_then_silent() {\n677\t        let ev = SimEvent::Explosion { pos: Vec3::ZERO, radius: 1.35 };\n678\t        let out = render_events(&[(0.0, ev)], 2.0, 22050.0, &Listener::default());\n679\t        let peak_early = out[..22050].iter().fold(0.0f32, |m, s| m.max(s.abs()));\n680\t        let peak_late = out[out.len() - 2000..].iter().fold(0.0f32, |m, s| m.max(s.abs()));\n681\t        assert!(peak_early > 0.1, \"audible: {peak_early}\");\n682\t        assert!(peak_late < 1e-3, \"decays: {peak_late}\");\n683\t    }\n684\t}\n685\t#!/usr/bin/env bash\n686\t# Builds the browser version (WebAssembly + WebGPU). Output: target/web/{index.html,manifest.webmanifest,shardfall.js,shardfall_bg.wasm}\n687\t# Serve that folder over HTTP (e.g. `python3 -m http.server -d target/web`) and open it in Chrome or Edge.\n688\t# --single-file writes only target/web/<title>.html (shardfall.html): one page with the glue and gzipped wasm inside\n689\t#   that runs from file:// or any host (scripts/pack_single_html.py; also --title, --description, --theme-color,\n690\t#   --scene NAME for the start scene when the address names none, --out PATH).\n691\t# Needs: rustup target add wasm32-unknown-unknown\n692\t#        cargo install wasm-bindgen-cli --version <the wasm-bindgen version in Cargo.lock>\n693\tset -euo pipefail\n694\tcaller=$PWD\n695\tcd \"$(dirname \"$0\")/..\"\n696\tsingle=false\n697\tpack=()\n698\twhile (($#)); do\n699\t\tcase $1 in\n700\t\t--single-file) single=true ;;\n701\t\t--title | --description | --theme-color | --scene | --out)\n702\t\t\t(($# > 1)) || { echo \"build-web.sh: $1 needs a value\" >&2; exit 2; }\n703\t\t\tvalue=$2\n704\t\t\t[[ $1 == --out && $value != /* ]] && value=$caller/$value\n705\t\t\tpack+=(\"$1\" \"$value\")\n706\t\t\tshift\n707\t\t\t;;\n708\t\t*) echo \"build-web.sh: unknown option $1 (options are listed at the top of $0)\" >&2; exit 2 ;;\n709\t\tesac\n710\t\tshift\n711\tdone\n712\tif ((${#pack[@]})) && ! $single; then\n713\t\techo \"build-web.sh: ${pack[0]} needs --single-file\" >&2\n714\t\texit 2\n715\tfi\n716\tcargo build --locked --profile dist --target wasm32-unknown-unknown -p pav_app\n717\twasm=${CARGO_TARGET_DIR:-target}/wasm32-unknown-unknown/dist/shardfall.wasm\n718\tout=target/web\n719\tif $single; then\n720\t\tbindgen=$(mktemp -d)\n721\t\ttrap 'rm -rf \"$bindgen\"' EXIT\n722\t\twasm-bindgen --target web --no-typescript --out-dir \"$bindgen\" --out-name shardfall \"$wasm\"\n723\t\tpython3 -I scripts/pack_single_html.py \"$bindgen\" \"${pack[@]}\"\n724\t\texit\n725\tfi\n726\trm -rf \"$out\"\n727\tmkdir -p \"$out\"\n728\twasm-bindgen --target web --no-typescript --out-dir \"$out\" --out-name shardfall \"$wasm\"\n729\tcp web/index.html web/manifest.webmanifest \"$out/\"\n730\tls -la \"$out\"\n731\t#!/usr/bin/env python3\n732\t\"\"\"Packs the browser build into one self-contained HTML page: no other files, no network loads.\n733\t\n734\tusage: python3 -I scripts/pack_single_html.py BINDGEN_DIR [--title T] [--description D]\n735\t           [--theme-color C] [--scene NAME] [--out PATH]\n736\t\n737\tBINDGEN_DIR is wasm-bindgen's output (shardfall.js, shardfall_bg.wasm); scripts/build-web.sh\n738\t--single-file makes it and runs this. The page is web/index.html with the options written into\n739\tits <title>, <meta name=description> and <meta name=theme-color> (left as they are when not\n740\tgiven), the manifest link dropped, and, before </body>, the gzipped wasm as base64 text, a\n741\tloader that sets window.loadGame (index.html's script calls it when set) and the JS glue as an\n742\tinline module script. The loader shows a progress line, bakes in --scene (used when the address\n743\tnames no room or scene) and unpacks with the browser's DecompressionStream. No blob: or data:\n744\tURLs are needed. Out: target/web/<title>.html.\n745\t\"\"\"\n746\timport argparse\n747\timport base64\n748\timport gzip\n749\timport html\n750\timport json\n751\timport pathlib\n752\timport re\n753\timport sys\n754\t\n755\tROOT = pathlib.Path(__file__).resolve().parent.parent\n756\tPAGE = ROOT / \"web\" / \"index.html\"\n757\t\n758\t# Runs while the page parses, before index.html's module script.\n759\tLOADER = \"\"\"\n760\t(() => {\n761\t  const msg = document.getElementById('msg');\n762\t  // The start scene baked in at build time, unless the address names a room or a scene.\n763\t  const scene = __SCENE__, query = new URLSearchParams(location.search);\n764\t  if (scene && !query.get('room') && !query.get('scene')) {\n765\t    query.set('scene', scene);\n766\t    try { history.replaceState(history.state, '', '?' + query + location.hash); }\n767\t    catch (error) { console.warn('Could not put the start scene in the address:', error); }\n768\t  }\n769\t  const line = document.createElement('div');\n770\t  line.style.cssText = 'font-size: 14px; opacity: 0.7; font-variant-numeric: tabular-nums';\n771\t  msg.style.flexDirection = 'column';\n772\t  msg.style.gap = '8px';\n773\t  msg.replaceChildren(`Loading ${document.title}…`, line);\n774\t  const paint = () => new Promise((resolve) => setTimeout(resolve, 20));\n775\t  // The JS glue is the module script at the end of the page: it hands over its init function.\n776\t  const glue = new Promise((resolve) => { window.gameGlue = resolve; });\n777\t  window.loadGame = async () => {\n778\t    line.textContent = 'Unpacking…';\n779\t    await paint();\n780\t    // The gzipped wasm's base64 block leaves the page once read, to free its text.\n781\t    const block = document.getElementById('game-wasm'), size = +block.dataset.size, text = block.textContent;\n782\t    block.remove();\n783\t    let packed;\n784\t    if (Uint8Array.fromBase64) packed = Uint8Array.fromBase64(text);\n785\t    else {\n786\t      const bin = atob(text);\n787\t      packed = new Uint8Array(bin.length);\n788\t      for (let i = 0; i < bin.length; i++) packed[i] = bin.charCodeAt(i);\n789\t    }\n790\t    const wasm = new Uint8Array(size);\n791\t    const reader = new Blob([packed]).stream().pipeThrough(new DecompressionStream('gzip')).getReader();\n792\t    let n = 0;\n793\t    for (let r = await reader.read(); !r.done; r = await reader.read()) {\n794\t      wasm.set(r.value, n);\n795\t      n += r.value.length;\n796\t      line.textContent = `Unpacking ${Math.floor((100 * n) / size)}%`;\n797\t    }\n798\t    if (n !== size) throw new Error(`the packed game is damaged (${n} of ${size} bytes)`);\n799\t    line.textContent = 'Starting…';\n800\t    await paint();\n801\t    const init = await glue;\n802\t    await init({ module_or_path: wasm });\n803\t  };\n804\t})();\n805\t\"\"\"\n806\t\n807\t\n808\tdef fail(text):\n809\t    sys.exit(f\"pack_single_html: {text}\")\n810\t\n811\t\n812\tdef replace_one(page, pattern, make, what):\n813\t    \"\"\"Replaces the one match of `pattern` in the page; anything else means index.html changed.\"\"\"\n814\t    page, n = re.subn(pattern, make, page)\n815\t    if n != 1:\n816\t        fail(f\"expected one {what} in {PAGE.relative_to(ROOT)}, found {n}: update this script\")\n817\t    return page\n818\t\n819\t\n820\tdef main():\n821\t    ap = argparse.ArgumentParser(description=__doc__.split(\"\\n\")[0])\n822\t    ap.add_argument(\"bindgen_dir\", type=pathlib.Path, help=\"wasm-bindgen output (shardfall.js, shardfall_bg.wasm)\")\n823\t    ap.add_argument(\"--title\", help=\"<title> (default: index.html's)\")\n824\t    ap.add_argument(\"--description\", help=\"<meta name=description> (default: index.html's)\")\n825\t    ap.add_argument(\"--theme-color\", help=\"<meta name=theme-color> (default: index.html's)\")\n826\t    ap.add_argument(\"--scene\", help=\"start scene when the address names no room or scene (default: the game's)\")\n827\t    ap.add_argument(\"--out\", type=pathlib.Path, help=\"output file (default: target/web/<title>.html)\")\n828\t    a = ap.parse_args()\n829\t\n830\t    js, wasm_path = a.bindgen_dir / \"shardfall.js\", a.bindgen_dir / \"shardfall_bg.wasm\"\n831\t    for p in (js, wasm_path):\n832\t        if not p.is_file():\n833\t            fail(f\"{p} is missing: run wasm-bindgen --target web --out-name shardfall first\")\n834\t    # The glue goes in the page as an inline module script, so it can't import other files\n835\t    # (wasm-bindgen snippets) or hold text that would end the script element early.\n836\t    glue = js.read_text(encoding=\"utf-8\")\n837\t    if (a.bindgen_dir / \"snippets\").exists() or re.search(r\"^import\\b\", glue, re.M):\n838\t        fail(\"the JS glue imports other files (wasm-bindgen snippets); inline them before packing\")\n839\t    if re.search(r\"(?i)</script|<script|<!--\", glue):\n840\t        fail(\"the JS glue contains <script, </script or <!--, which can't sit inside an inline script\")\n841\t    init = re.search(r\"^export \\{[^}]*?\\b([\\w$]+) as default\\b\", glue, re.M)\n842\t    if not init:\n843\t        fail(\"can't find the JS glue's default export (its init function)\")\n844\t\n845\t    page = PAGE.read_text(encoding=\"utf-8\")\n846\t    if a.title is not None:\n847\t        page = replace_one(page, r\"<title>[^<]*</title>\", lambda m: f\"<title>{html.escape(a.title)}</title>\", \"<title>\")\n848\t    for name, value in ((\"description\", a.description), (\"theme-color\", a.theme_color)):\n849\t        if value is not None:\n850\t            page = replace_one(\n851\t                page,\n852\t                rf'<meta name=\"{name}\" content=\"[^\"]*\">',\n853\t                lambda m, name=name, value=value: f'<meta name=\"{name}\" content=\"{html.escape(value)}\">',\n854\t                f\"<meta name={name}>\",\n855\t            )\n856\t    # A manifest is another file to load: the single page goes without one.\n857\t    page = replace_one(page, r'[ \\t]*<link rel=\"manifest\"[^>]*>\\n', lambda m: \"\", \"manifest link\")\n858\t\n859\t    wasm = wasm_path.read_bytes()\n860\t    packed = gzip.compress(wasm, compresslevel=9, mtime=0)\n861\t    # JSON is valid JS; escaping \"<\" keeps a scene name from closing the script element.\n862\t    loader = LOADER.replace(\"__SCENE__\", json.dumps(a.scene or None).replace(\"<\", \"\\\\u003c\"))\n863\t    tail = (\n864\t        f'<script id=\"game-wasm\" type=\"application/octet-stream\" data-size=\"{len(wasm)}\">'\n865\t        f\"{base64.b64encode(packed).decode()}</script>\\n\"\n866\t        f\"<script>{loader}</script>\\n\"\n867\t        f'<script type=\"module\">\\n{glue}\\nwindow.gameGlue({init[1]});\\n</script>\\n'\n868\t    )\n869\t    page = replace_one(page, r\"</body>\", lambda m: tail + \"</body>\", \"</body>\")\n870\t\n871\t    title = a.title if a.title is not None else html.unescape(re.search(r\"<title>([^<]*)</title>\", page)[1])\n872\t    out = a.out or ROOT / \"target\" / \"web\" / f\"{re.sub(r'[^a-z0-9]+', '-', title.lower()).strip('-') or 'game'}.html\"\n873\t    out.parent.mkdir(parents=True, exist_ok=True)\n874\t    out.write_text(page, encoding=\"utf-8\")\n875\t    mb = lambda n: f\"{n / 1e6:.1f} MB\"  # noqa: E731\n876\t    print(f\"{out}: {mb(out.stat().st_size)} (wasm {mb(len(wasm))}, gzipped {mb(len(packed))}; JS glue {mb(len(glue))})\")\n877\t\n878\t\n879\tif __name__ == \"__main__\":\n880\t    main()\n881\t<!doctype html>\n882\t<html lang=\"en\">\n883\t<head>\n884\t<meta charset=\"utf-8\">\n885\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n886\t<title>Shardfall</title>\n887\t<meta name=\"description\" content=\"Play Shardfall, a procedural hack-and-slash adventure with an interactive tech demo pavilion.\">\n888\t<meta name=\"theme-color\" content=\"#15171c\">\n889\t<meta name=\"mobile-web-app-capable\" content=\"yes\">\n890\t<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n891\t<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n892\t<link rel=\"manifest\" href=\"manifest.webmanifest\">\n893\t<link rel=\"icon\" href=\"data:,\">\n894\t<style>\n895\t  /* The page is the game: no scrolling, zooming, text selection, callouts or tap flashes. */\n896\t  html, body { margin: 0; height: 100%; overflow: hidden; background: #15171c; overscroll-behavior: none;\n897\t               touch-action: none; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none;\n898\t               -webkit-tap-highlight-color: transparent; }\n899\t  /* winit appends the game canvas to <body>; it fills the page and the game follows its size.\n900\t     dvh: the height that is visible while a phone's browser bars come and go. */\n901\t  canvas { display: block; width: 100vw !important; height: 100vh !important; height: 100dvh !important;\n902\t           outline: none; touch-action: none; }\n903\t  #msg { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center;\n904\t         font: 18px system-ui, sans-serif; color: #c9ccd4; text-align: center; padding: 24px; pointer-events: none; }\n905\t  /* Phones held upright: a hint to turn sideways that fades by itself. */\n906\t  #turn { display: none; position: fixed; left: 50%; top: 12px; transform: translateX(-50%); padding: 8px 14px;\n907\t          border-radius: 18px; background: rgba(0, 0, 0, 0.6); color: #ffd690; font: 14px system-ui, sans-serif;\n908\t          pointer-events: none; animation: fade 1s 5s forwards; }\n909\t  @media (orientation: portrait) and (pointer: coarse) { #turn { display: block; } }\n910\t  @keyframes fade { to { opacity: 0; } }\n911\t</style>\n912\t</head>\n913\t<body>\n914\t<div id=\"msg\" role=\"status\" aria-live=\"polite\">Loading Shardfall…</div>\n915\t<div id=\"turn\">Turn your phone sideways for the best view</div>\n916\t<script type=\"module\">\n917\t  // Start in a demo room with ?room=NAME, or the pavilion with ?scene=world.\n918\t  // Messages name the game by the page title (a single-file build may retitle it).\n919\t  const name = document.title;\n920\t  const msg = document.getElementById('msg');\n921\t  if (!navigator.gpu) {\n922\t    msg.replaceChildren(`${name} needs WebGPU.`, document.createElement('br'),\n923\t      'Use a recent Chrome, Edge or Safari (iOS 26 or later) with hardware acceleration enabled.');\n924\t  } else {\n925\t    // The game hides this message once its canvas exists, and takes keyboard focus.\n926\t    new MutationObserver((_, obs) => {\n927\t      const c = document.querySelector('canvas');\n928\t      if (c) { c.setAttribute('aria-label', `${name} game`); msg.remove(); c.focus(); obs.disconnect(); }\n929\t    }).observe(document.body, { childList: true });\n930\t    // Phones and tablets: the first tap goes full screen and turns sideways, where the browser\n931\t    // allows it (Android; an iPhone keeps its bars, or plays full screen from the home screen).\n932\t    if (matchMedia('(pointer: coarse)').matches) {\n933\t      addEventListener('pointerup', () => {\n934\t        const el = document.documentElement;\n935\t        if (!document.fullscreenElement && el.requestFullscreen) {\n936\t          el.requestFullscreen({ navigationUI: 'hide' })\n937\t            .then(() => screen.orientation && screen.orientation.lock && screen.orientation.lock('landscape'))\n938\t            .catch(() => {});\n939\t        }\n940\t      }, { once: true, capture: true });\n941\t    }\n942\t    try {\n943\t      // The game is shardfall.js and its .wasm beside this page. A single-file build\n944\t      // (scripts/pack_single_html.py) carries both inside the page and sets window.loadGame.\n945\t      if (window.loadGame) await window.loadGame();\n946\t      else await (await import('./shardfall.js')).default();\n947\t    } catch (error) {\n948\t      console.error(`${name} failed to load:`, error);\n949\t      msg.textContent = `${name} could not load. Please reload the page. If it still fails, check that WebGPU and hardware acceleration are enabled.`;\n950\t      document.body.append(msg);\n951\t    }\n952\t  }\n953\t</script>\n954\t</body>\n955\t</html>\n956\t    pub fn clear_view_effects(&mut self) {\n957\t        self.events.clear();\n958\t        let _ = self.sim.drain_events();\n959\t        if let Some(gpu) = &mut self.gpu {\n960\t            gpu.builder = ViewBuilder::new();\n961\t            gpu.renderer.clear_particles();\n962\t            gpu.studio_mode = self.sim.studio_mode();\n963\t        }\n964\t    }\n965\t\n966\t    /// Applies a room's camera defaults when the player enters/leaves it, and level camera\n967\t    /// cues, the way the game does (without blending). Called after every step.\n968\t    pub fn sync_camera(&mut self) {\n969\t        use pav_core::params::{ParamValue, apply_map};\n970\t        if self.live || self.sim.studio_active() {\n971\t            return;\n972\t        }\n973\t        let w = &self.sim.state.world;\n974\t        let now = w.current_room;\n975\t        let rot = |yaw: f64, q: u8| ParamValue::Float((yaw + q as f64 * 90.0 + 540.0).rem_euclid(360.0) - 180.0);\n976\t        let c = &self.sim.state.courses;\n977\t        if c.cue_serial != self.cue_serial {\n978\t            self.cue_serial = c.cue_serial;\n979\t            // Like the game: each cue applies on top of the camera from before the first cue;\n980\t            // sweeps start at their `from` value (captures are single moments).\n981\t            match c.cue() {\n982\t                Some(cue) => {\n983\t                    let q = now.and_then(|i| w.rooms.get(i as usize)).map(|r| r.place.quarters).unwrap_or(0);\n984\t                    let base = self.cue_base.get_or_insert_with(|| self.camera.params.clone()).clone();\n985\t                    let mut set = cue.set.clone();\n986\t                    for sw in &cue.sweep {\n987\t                        set.insert(sw.param.clone(), ParamValue::Float(sw.from as f64));\n988\t                    }\n989\t                    if let Some(y) = set.get(\"yaw\").and_then(|v| v.as_f64()) {\n990\t                        set.insert(\"yaw\".into(), rot(y, q));\n991\t                    }\n992\t                    self.camera.params = base;\n993\t                    apply_map(&mut self.camera.params, &set);\n994\t                }\n995\t                None => {\n996\t                    if let Some(b) = self.cue_base.take() {\n997\t                        self.camera.params = b;\n998\t                    }\n999\t                }\n1000\t            }\n1001\t        }\n1002\t        // Room changes after cues (leaving a room clears its cue first, then restores the camera).\n1003\t        if now != self.room_cam.as_ref().map(|r| r.0) {\n1004\t            if let Some((_, saved)) = self.room_cam.take() {\n1005\t                self.camera.params = saved;\n1006\t            }\n1007\t            if let Some(r) = now.and_then(|i| w.rooms.get(i as usize)).filter(|r| !r.def.camera.is_empty()) {\n1008\t                let saved = self.camera.params.clone();\n1009\t                let mut cam = r.def.camera.clone();\n1010\t                let yaw = cam.get(\"yaw\").and_then(|v| v.as_f64()).unwrap_or(0.0);\n1011\t                cam.insert(\"yaw\".into(), rot(yaw, r.place.quarters));\n1012\t                apply_map(&mut self.camera.params, &cam);\n1013\t                self.room_cam = Some((r.id, saved));\n1014\t            }\n1015\t        }\n1016\t        self.sync_view();\n1017\t    }\n1018\t\n1019\t    /// Takes `params` as the base camera and applies the current room's `[camera]` on top.\n1020\t    pub fn reset_camera(&mut self, params: CameraParams) {\n1021\t        self.camera.params = params;\n1022\t        self.room_cam = None;\n1023\t        self.cue_base = None;\n1024\t        self.sync_camera();\n1025\t    }\n1026\t\n1027\t    /// The camera without the current room's defaults.\n1028\t    pub fn camera_base_or_current(&self) -> CameraParams {\n1029\t        self.room_cam.as_ref().map(|(_, c)| c.clone()).unwrap_or_else(|| self.camera.params.clone())\n1030\t    }\n1031\t\n1032\t    /// The view settings without the current room's / pads' overrides.\n1033\t    pub fn view_base_or_current(&self) -> ViewSettings {\n1034\t        self.view_base.clone().unwrap_or_else(|| self.view.clone())\n1035\t    }\n1036\t\n1037\t    /// Takes `view` as the base settings and applies the current room's `[view]` table on top.\n1038\t    pub fn reset_view(&mut self, view: ViewSettings) {\n1039\t        self.view = view;\n1040\t        self.view_base = None;\n1041\t        self.view_room = None;\n1042\t        self.view_serial = u64::MAX;\n1043\t        self.sync_view();\n1044\t    }\n1045\t\n1046\t    /// Room `[view]` tables and pad `view.*` overrides, like the game applies them.\n1047\t    fn sync_view(&mut self) {\n1048\t        let w = &self.sim.state.world;\n1049\t        let now = w.current_room;\n1050\t        let serial = self.sim.state.courses.view_serial;\n1051\t        if now == self.view_room && serial == self.view_serial {\n1052\t            return;\n1053\t        }\n1054\t        if let Some(base) = self.view_base.take() {\n1055\t            self.view = base;\n1056\t        }\n1057\t        self.view_room = now;\n1058\t        self.view_serial = serial;\n1059\t        let q = now.and_then(|i| w.rooms.get(i as usize)).map(|r| r.place.quarters).unwrap_or(0);\n1060\t        let room =\n1061\t            now.and_then(|i| w.rooms.get(i as usize)).map(|r| pav_view::build::room_view_map(&r.def.view, q)).unwrap_or_default();\n1062\t        let pads = pav_view::build::room_view_map(&self.sim.state.courses.view, q);\n1063\t        if room.is_empty() && pads.is_empty() {\n1064\t            return;\n1065\t        }\n1066\t        self.view_base = Some(self.view.clone());\n1067\t        self.view.apply(&room);\n1068\t        self.view.apply(&pads);\n1069\t    }\n1070\t\n1071\t    /// The view settings captures use: the session's, the game place's look, then the look\n1072\t    /// layer.\n1073\t    pub fn view_for(&self, frame: &pav_core::RenderFrame) -> ViewSettings {\n1074\t        let mut view = self.view.clone();\n1075\t        if let Some(g) = &frame.game {\n1076\t            pav_view::arpg::place_look(g, &mut view);\n1077\t        }\n1078\t        self.look.apply(&mut view);\n1079\t        view\n1080\t    }\n1081\t\n1082\t    /// Renders the current state to RGBA8 pixels.\n1083\t    pub fn render(&mut self, width: u32, height: u32) -> Result<Vec<u8>> {\n1084\t        let frame = self.sim.frame();\n1085\t        let focus = frame.focus;\n1086\t        self.camera.snap(focus);\n1087\t        let camera = self.camera.clone();\n1088\t        let view = self.view_for(&frame);\n1089\t        let events = std::mem::take(&mut self.events);\n1090\t        let gpu = self.gpu()?;\n1091\t        gpu.prepare_frame(&frame);\n1092\t        if !frame.studio_active() {\n1093\t            gpu.builder.add_events(&events);\n1094\t        }\n1095\t        let scene = gpu.builder.build(&frame, &frame, 1.0, &camera, width as f32 / height as f32, &view, focus);\n1096\t        pav_render::capture::render_to_rgba(&mut gpu.renderer, &scene, width, height)\n1097\t    }\n1098\t\n1099\t    /// Renders like `render` with the game UI over it (when a game runs: Shardfall, or a\n1100\t    /// `pav_core::games` game's HUD lines): the pixels, and what the UI drew (`None` without a\n1101\t    /// game). `input` hovers or clicks.\n1102\t    pub fn render_ui(\n1103\t        &mut self,\n1104\t        width: u32,\n1105\t        height: u32,\n1106\t        input: pav_ui::headless::Input,\n1107\t    ) -> Result<(Vec<u8>, Option<pav_ui::headless::Drawn>)> {\n1108\t        let frame = self.sim.frame();\n1109\t        let focus = frame.focus;\n1110\t        self.camera.snap(focus);\n1111\t        let camera = self.camera.clone();\n1112\t        let view = self.view_for(&frame);\n1113\t        let events = std::mem::take(&mut self.events);\n1114\t        let gpu = self.gpu()?;\n1115\t        gpu.prepare_frame(&frame);\n1116\t        if !frame.studio_active() {\n1117\t            gpu.builder.add_events(&events);\n1118\t        }\n1119\t        let scene = gpu.builder.build(&frame, &frame, 1.0, &camera, width as f32 / height as f32, &view, focus);\n1120\t        let vp = scene.camera.proj * scene.camera.view;\n1121\t        let drawn = has_ui(&frame).then(|| self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input));\n1122\t        let gpu = self.gpu.as_mut().unwrap();\n1123\t        let Some(paint) = drawn.as_ref().map(|d| &d.paint) else {\n1124\t            return Ok((pav_render::capture::render_to_rgba(&mut gpu.renderer, &scene, width, height)?, None));\n1125\t        };\n1126\t        let device = gpu.renderer.device().clone();\n1127\t        let overlay =\n1128\t            gpu.overlay.get_or_insert_with(|| pav_ui::headless::Overlay::new(&device, pav_render::capture::CAPTURE_FORMAT));\n1129\t        let rgba = pav_render::capture::render_to_rgba_with(\n1130\t            &mut gpu.renderer,\n1131\t            &scene,\n1132\t            width,\n1133\t            height,\n1134\t            |device, queue, encoder, target| overlay.paint(device, queue, encoder, target, (width, height), paint),\n1135\t        )?;\n1136\t        Ok((rgba, drawn))\n1137\t    }\n1138\t\n1139\t    /// The game UI's reading without rendering (no GPU): what is on screen at `width` x\n1140\t    /// `height` from the session's camera. `None` without a game.\n1141\t    pub fn read_ui(&mut self, width: u32, height: u32, input: pav_ui::headless::Input) -> Option<pav_ui::headless::Drawn> {\n1142\t        let frame = self.sim.frame();\n1143\t        if !has_ui(&frame) {\n1144\t            return None;\n1145\t        }\n1146\t        self.camera.snap(frame.focus);\n1147\t        let vp = self.camera.view_proj(width as f32 / height.max(1) as f32);\n1148\t        Some(self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input))\n1149\t    }\n1150\t\n1151\t    /// Renders `frame`, a stage the simulation does not hold (a material swatch), from the\n1152\t    /// session's camera as it is.\n1153\t    pub fn render_frame(&mut self, frame: &RenderFrame, width: u32, height: u32) -> Result<Vec<u8>> {\n1154\t        let camera = self.camera.clone();\n1155\t        let view = self.view_for(frame);\n1156\t        let gpu = self.gpu()?;\n1157\t        gpu.prepare_frame(frame);\n1158\t        let scene = gpu.builder.build(frame, frame, 1.0, &camera, width as f32 / height as f32, &view, frame.focus);\n1159\t        pav_render::capture::render_to_rgba(&mut gpu.renderer, &scene, width, height)\n1160\t    }\n1161\t\n1162\t    /// Renders like `render` and also returns the camera's view-projection (to place marks).\n1163\t    pub fn render_with_camera(&mut self, width: u32, height: u32) -> Result<(Vec<u8>, glam::Mat4)> {\n1164\t        let frame = self.sim.frame();\n1165\t        let focus = frame.focus;\n1166\t        self.camera.snap(focus);\n1167\t        let camera = self.camera.clone();\n1168\t        let view = self.view_for(&frame);\n1169\t        let events = std::mem::take(&mut self.events);\n1170\t        let gpu = self.gpu()?;\n1171\t        gpu.prepare_frame(&frame);\n1172\t        if !frame.studio_active() {\n1173\t            gpu.builder.add_events(&events);\n1174\t        }\n1175\t        let scene = gpu.builder.build(&frame, &frame, 1.0, &camera, width as f32 / height as f32, &view, focus);\n1176\t        let vp = scene.camera.proj * scene.camera.view;\n1177\t        Ok((pav_render::capture::render_to_rgba(&mut gpu.renderer, &scene, width, height)?, vp))\n1178\t    }\n1179\t\n1180\t    pub fn camera_eye(&self) -> Vec3 {\n1181\t        self.camera.eye()\n1182\t    }\n1183\t\n1184\t    pub fn focus(&self) -> Vec3 {\n1185\t        self.sim.state.focus\n1186\t    }\n1187\t}\n1188\t\n1189\t/// A game's UI is on screen: Shardfall's, or a `pav_core::games` game's HUD lines.\n1190\tpub fn has_ui(frame: &RenderFrame) -> bool {\n1191\t    frame.game.is_some() || !frame.hud.lines.is_empty()\n1192\t}\n1193\t   Compiling bytemuck_derive v1.12.1\n1194\t   Compiling serde_derive v1.0.229\n1195\t   Compiling thiserror-impl v2.0.21\n1196\t"}]},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"310010cf-1696-41cd-abc4-468e0f2e832b","timestamp":"2026-11-05T14:25:02.484Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-medium-build-v2--20261105-072416--x42677a-work/189b0832-eeab-4401-af9a-06d1cd0033c9/tool-results/befzfj5ly.txt","content":"//! Synthesized sound: every sound is built from oscillators, noise, envelopes, pitch sweeps\n//! and a filter. The mixer runs in the audio callback (cpal) or offline (to .wav). The game\n//! runs fine without a sound device.\n\nuse std::sync::mpsc::{Receiver, Sender, channel};\n\nuse glam::Vec3;\nuse pav_core::SimEvent;\n\n#[derive(Clone, Copy, Debug, PartialEq)]\npub enum Wave {\n    Sine,\n    Square,\n    Saw,\n    Triangle,\n    Noise,\n}\n\n/// One synthesized sound.\n#[derive(Clone, Copy, Debug)]\npub struct Patch {\n    pub wave: Wave,\n    /// Start / end frequency (Hz) and the glide time between them (s, exponential).\n    pub freq: f32,\n    pub freq_end: f32,\n    pub glide: f32,\n    pub attack: f32,\n    pub decay: f32,\n    pub sustain: f32,\n    pub hold: f32,\n    pub release: f32,\n    pub volume: f32,\n    /// One-pole low-pass cutoff (Hz) at start and end of the sound.\n    pub cutoff: f32,\n    pub cutoff_end: f32,\n    /// Square-wave duty cycle.\n    pub duty: f32,\n}\n\nimpl Patch {\n    pub const fn new(wave: Wave, freq: f32) -> Self {\n        Self {\n            wave,\n            freq,\n            freq_end: freq,\n            glide: 0.1,\n            attack: 0.002,\n            decay: 0.1,\n            sustain: 0.0,\n            hold: 0.0,\n            release: 0.05,\n            volume: 0.3,\n            cutoff: 12000.0,\n            cutoff_end: 12000.0,\n            duty: 0.5,\n        }\n    }\n    pub fn length(&self) -> f32 {\n        self.attack + self.decay + self.hold + self.release\n    }\n}\n\nstruct Voice {\n    p: Patch,\n    t: f32,\n    delay: f32,\n    phase: f32,\n    lp: f32,\n    noise: u32,\n    gain_l: f32,\n    gain_r: f32,\n}\n\nimpl Voice {\n    fn env(&self) -> f32 {\n        let p = &self.p;\n        let t = self.t;\n        if t < p.attack {\n            return t / p.attack.max(1e-5);\n        }\n        let t = t - p.attack;\n        if t < p.decay {\n            return 1.0 + (p.sustain - 1.0) * (t / p.decay.max(1e-5));\n        }\n        let t = t - p.decay;\n        if t < p.hold {\n            return p.sustain;\n        }\n        let t = t - p.hold;\n        let start = if p.decay > 0.0 || p.hold > 0.0 { p.sustain } else { 1.0 };\n        (start * (1.0 - t / p.release.max(1e-5))).max(0.0)\n    }\n\n    fn done(&self) -> bool {\n        self.t > self.p.length() + 0.01\n    }\n\n    fn next(&mut self, dt: f32) -> f32 {\n        if self.delay > 0.0 {\n            self.delay -= dt;\n            return 0.0;\n        }\n        let p = self.p;\n        let k = (self.t / p.glide.max(1e-4)).min(1.0);\n        let freq = p.freq * (p.freq_end / p.freq.max(1.0)).powf(k);\n        self.phase = (self.phase + freq * dt).fract();\n        let ph = self.phase;\n        let raw = match p.wave {\n            Wave::Sine => (ph * std::f32::consts::TAU).sin(),\n            Wave::Square => {\n                if ph < p.duty {\n                    1.0\n                } else {\n                    -1.0\n                }\n            }\n            Wave::Saw => ph * 2.0 - 1.0,\n            Wave::Triangle => 1.0 - 4.0 * (ph - 0.5).abs(),\n            Wave::Noise => {\n                self.noise ^= self.noise << 13;\n                self.noise ^= self.noise >> 17;\n                self.noise ^= self.noise << 5;\n                (self.noise as f32 / u32::MAX as f32) * 2.0 - 1.0\n            }\n        };\n        let cutoff = p.cutoff * (p.cutoff_end / p.cutoff.max(1.0)).powf((self.t / p.length().max(1e-3)).min(1.0));\n        let a = 1.0 - (-std::f32::consts::TAU * cutoff * dt).exp();\n        self.lp += (raw - self.lp) * a;\n        let s = self.lp * self.env() * p.volume;\n        self.t += dt;\n        s\n    }\n}\n\n/// Mixes voices into interleaved stereo.\npub struct Mixer {\n    voices: Vec<Voice>,\n    pub sample_rate: f32,\n    pub master: f32,\n    seed: u32,\n}\n\nconst MAX_VOICES: usize = 64;\n\nimpl Mixer {\n    pub fn new(sample_rate: f32) -> Self {\n        Self { voices: Vec::new(), sample_rate, master: 0.8, seed: 0x9e37_79b9 }\n    }\n\n    /// pan -1 (left) .. 1 (right); delay in seconds.\n    pub fn play(&mut self, p: Patch, pan: f32, gain: f32, delay: f32) {\n        if self.voices.len() >= MAX_VOICES {\n            // Drop the oldest.\n            self.voices.remove(0);\n        }\n        self.seed = self.seed.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);\n        let pan = pan.clamp(-1.0, 1.0);\n        let a = (pan + 1.0) * std::f32::consts::FRAC_PI_4;\n        self.voices.push(Voice {\n            p,\n            t: 0.0,\n            delay,\n            phase: 0.0,\n            lp: 0.0,\n            noise: self.seed | 1,\n            gain_l: a.cos() * gain,\n            gain_r: a.sin() * gain,\n        });\n    }\n\n    /// Renders into an interleaved stereo buffer (overwrites).\n    pub fn render(&mut self, out: &mut [f32]) {\n        let dt = 1.0 / self.sample_rate;\n        for frame in out.chunks_mut(2) {\n            let (mut l, mut r) = (0.0, 0.0);\n            for v in &mut self.voices {\n                let s = v.next(dt);\n                l += s * v.gain_l;\n                r += s * v.gain_r;\n            }\n            // Soft clip.\n            let m = self.master;\n            frame[0] = (l * m).tanh();\n            if frame.len() > 1 {\n                frame[1] = (r * m).tanh();\n            }\n        }\n        self.voices.retain(|v| !v.done());\n    }\n\n    pub fn active(&self) -> usize {\n        self.voices.len()\n    }\n}\n\n/// Where the ears are: position and the camera's right vector (for panning).\n#[derive(Clone, Copy, Debug)]\npub struct Listener {\n    pub pos: Vec3,\n    pub right: Vec3,\n}\n\nimpl Default for Listener {\n    fn default() -> Self {\n        Self { pos: Vec3::ZERO, right: Vec3::X }\n    }\n}\n\n/// The sound bank: which patches play for a simulation event.\npub fn sounds_for(ev: &SimEvent) -> Vec<(Patch, f32)> {\n    use Wave::*;\n    match ev {\n        SimEvent::Jump { .. } => vec![(\n            Patch {\n                freq_end: 640.0,\n                glide: 0.11,\n                decay: 0.12,\n                volume: 0.18,\n                cutoff: 3500.0,\n                cutoff_end: 2500.0,\n                duty: 0.3,\n                ..Patch::new(Square, 280.0)\n            },\n            0.0,\n        )],\n        SimEvent::Land { speed, .. } => {\n            let v = (speed / 14.0).clamp(0.15, 1.0);\n            vec![\n                (Patch { decay: 0.12, volume: 0.35 * v, cutoff: 1100.0, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) }, 0.0),\n                (Patch { freq_end: 45.0, glide: 0.1, decay: 0.14, volume: 0.45 * v, ..Patch::new(Sine, 110.0) }, 0.0),\n            ]\n        }\n        SimEvent::Step { .. } => {\n            vec![(Patch { decay: 0.045, volume: 0.07, cutoff: 1800.0, cutoff_end: 500.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n        }\n        SimEvent::Throw { .. } => vec![(\n            Patch { attack: 0.03, decay: 0.16, volume: 0.1, cutoff: 900.0, cutoff_end: 4500.0, ..Patch::new(Noise, 1.0) },\n            0.0,\n        )],\n        SimEvent::Explosion { radius, .. } => {\n            let v = (radius / 1.35).clamp(0.5, 2.0);\n            vec![\n                (\n                    Patch {\n                        attack: 0.004,\n                        decay: 0.25,\n                        sustain: 0.35,\n                        hold: 0.1,\n                        release: 0.6,\n                        volume: 0.6 * v,\n                        cutoff: 4000.0,\n                        cutoff_end: 120.0,\n                        ..Patch::new(Noise, 1.0)\n                    },\n                    0.0,\n                ),\n                (Patch { freq_end: 28.0, glide: 0.5, decay: 0.7, volume: 0.7 * v, ..Patch::new(Sine, 85.0) }, 0.0),\n            ]\n        }\n        SimEvent::EnterRoom { .. } => vec![\n            (Patch { decay: 0.25, volume: 0.12, ..Patch::new(Triangle, 659.3) }, 0.0),\n            (Patch { decay: 0.35, volume: 0.12, ..Patch::new(Triangle, 987.8) }, 0.09),\n        ],\n        SimEvent::Hit { strength, .. } => {\n            let v = (strength / 8.0).clamp(0.4, 1.2);\n            vec![\n                (Patch { decay: 0.09, volume: 0.3 * v, cutoff: 2500.0, cutoff_end: 300.0, ..Patch::new(Noise, 1.0) }, 0.0),\n                (\n                    Patch { freq_end: 90.0, glide: 0.12, decay: 0.16, volume: 0.3 * v, duty: 0.4, ..Patch::new(Square, 220.0) },\n                    0.0,\n                ),\n            ]\n        }\n        // Shardfall.\n        SimEvent::Swing { heavy, .. } => {\n            let h = if *heavy { 1.4 } else { 1.0 };\n            vec![(\n                Patch {\n                    attack: 0.02,\n                    decay: 0.12 * h,\n                    volume: 0.16 * h,\n                    cutoff: 1800.0,\n                    cutoff_end: 5200.0,\n                    ..Patch::new(Noise, 1.0)\n                },\n                0.0,\n            )]\n        }\n        SimEvent::Strike { power, element, crit, .. } => {\n            let v = (power.sqrt() / 4.0).clamp(0.35, 1.2) * if *crit { 1.3 } else { 1.0 };\n            let tone = [150.0, 120.0, 520.0, 900.0, 260.0][(*element as usize).min(4)];\n            let mut out = vec![\n                (Patch { decay: 0.07, volume: 0.24 * v, cutoff: 3200.0, cutoff_end: 400.0, ..Patch::new(Noise, 1.0) }, 0.0),\n                (\n                    Patch {\n                        freq_end: tone * 0.5,\n                        glide: 0.08,\n                        decay: 0.1,\n                        volume: 0.2 * v,\n                        duty: 0.35,\n                        ..Patch::new(Square, tone)\n                    },\n                    0.0,\n                ),\n            ];\n            if *crit {\n                out.push((Patch { decay: 0.18, volume: 0.12, ..Patch::new(Triangle, 1760.0) }, 0.01));\n            }\n            out\n        }\n        SimEvent::Slain { size, .. } => {\n            let k = size.clamp(0.3, 1.5);\n            vec![\n                (\n                    Patch {\n                        freq_end: 60.0,\n                        glide: 0.3,\n                        decay: 0.3,\n                        volume: 0.22 * k,\n                        duty: 0.5,\n                        ..Patch::new(Square, 180.0 / k)\n                    },\n                    0.0,\n                ),\n                (Patch { decay: 0.25, volume: 0.15, cutoff: 1500.0, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) }, 0.02),\n            ]\n        }\n        SimEvent::Slam { radius, .. } => {\n            let k = (radius / 2.5).clamp(0.6, 1.5);\n            vec![\n                (Patch { freq_end: 40.0, glide: 0.35, decay: 0.4, volume: 0.45 * k, ..Patch::new(Sine, 110.0) }, 0.0),\n                (Patch { decay: 0.3, volume: 0.3 * k, cutoff: 2200.0, cutoff_end: 150.0, ..Patch::new(Noise, 1.0) }, 0.0),\n            ]\n        }\n        SimEvent::Blast { element, .. } => {\n            let cut = [2500.0, 3500.0, 6000.0, 8000.0, 2000.0][(*element as usize).min(4)];\n            vec![\n                (\n                    Patch { attack: 0.003, decay: 0.3, volume: 0.35, cutoff: cut, cutoff_end: 200.0, ..Patch::new(Noise, 1.0) },\n                    0.0,\n                ),\n                (Patch { freq_end: 50.0, glide: 0.25, decay: 0.3, volume: 0.25, ..Patch::new(Sine, 140.0) }, 0.0),\n            ]\n        }\n        SimEvent::Spell { element, .. } => {\n            let f = [300.0, 260.0, 900.0, 1400.0, 420.0][(*element as usize).min(4)];\n            vec![(\n                Patch {\n                    freq_end: f * 1.8,\n                    glide: 0.15,\n                    attack: 0.02,\n                    decay: 0.18,\n                    volume: 0.12,\n                    duty: 0.25,\n                    ..Patch::new(Saw, f)\n                },\n                0.0,\n            )]\n        }\n        SimEvent::Coin { .. } => vec![\n            (Patch { decay: 0.08, volume: 0.1, ..Patch::new(Triangle, 1980.0) }, 0.0),\n            (Patch { decay: 0.12, volume: 0.09, ..Patch::new(Triangle, 2640.0) }, 0.05),\n        ],\n        // Drops chime by rarity: rares ring, uniques ring a chord.\n        SimEvent::Loot { rarity, .. } => match rarity {\n            0 => vec![(Patch { decay: 0.05, volume: 0.05, cutoff: 2500.0, ..Patch::new(Triangle, 880.0) }, 0.0)],\n            1 => vec![(Patch { decay: 0.12, volume: 0.08, ..Patch::new(Triangle, 1320.0) }, 0.0)],\n            2 => vec![\n                (Patch { decay: 0.25, volume: 0.12, ..Patch::new(Triangle, 1568.0) }, 0.0),\n                (Patch { decay: 0.35, volume: 0.1, ..Patch::new(Sine, 2093.0) }, 0.08),\n            ],\n            _ => vec![\n                (Patch { decay: 0.5, volume: 0.14, ..Patch::new(Triangle, 784.0) }, 0.0),\n                (Patch { decay: 0.5, volume: 0.13, ..Patch::new(Triangle, 988.0) }, 0.06),\n                (Patch { decay: 0.6, volume: 0.13, ..Patch::new(Triangle, 1175.0) }, 0.12),\n                (Patch { decay: 0.9, volume: 0.12, ..Patch::new(Sine, 1568.0) }, 0.2),\n            ],\n        },\n        SimEvent::Pickup { .. } => {\n            vec![(Patch { freq_end: 1400.0, glide: 0.06, decay: 0.07, volume: 0.08, ..Patch::new(Triangle, 700.0) }, 0.0)]\n        }\n        SimEvent::Travel { .. } => vec![\n            (Patch { freq_end: 1200.0, glide: 0.5, decay: 0.6, volume: 0.12, ..Patch::new(Sine, 200.0) }, 0.0),\n            (Patch { freq_end: 2400.0, glide: 0.4, decay: 0.5, volume: 0.06, ..Patch::new(Triangle, 600.0) }, 0.1),\n        ],\n        SimEvent::Potion { .. } => {\n            vec![(Patch { freq_end: 700.0, glide: 0.3, decay: 0.3, volume: 0.14, ..Patch::new(Sine, 300.0) }, 0.0)]\n        }\n        SimEvent::Block { .. } => {\n            vec![(Patch { decay: 0.2, volume: 0.2, cutoff: 6000.0, cutoff_end: 3000.0, ..Patch::new(Square, 1200.0) }, 0.0)]\n        }\n        SimEvent::LevelUp { .. } => vec![\n            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 523.0) }, 0.0),\n            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 659.0) }, 0.1),\n            (Patch { decay: 0.2, volume: 0.16, ..Patch::new(Triangle, 784.0) }, 0.2),\n            (Patch { decay: 0.5, volume: 0.18, ..Patch::new(Triangle, 1047.0) }, 0.3),\n        ],\n        SimEvent::Respawn { .. } => vec![\n            (Patch { freq_end: 880.0, glide: 0.18, decay: 0.2, volume: 0.12, ..Patch::new(Sine, 220.0) }, 0.0),\n            (Patch { decay: 0.15, volume: 0.08, ..Patch::new(Triangle, 1320.0) }, 0.16),\n        ],\n        SimEvent::CourseStart { .. } => vec![(Patch { decay: 0.12, volume: 0.14, ..Patch::new(Square, 880.0) }, 0.0)],\n        SimEvent::Gate { ok, .. } => {\n            if *ok {\n                vec![(Patch { decay: 0.1, volume: 0.12, ..Patch::new(Triangle, 1046.5) }, 0.0)]\n            } else {\n                vec![(\n                    Patch { freq_end: 160.0, glide: 0.2, decay: 0.25, volume: 0.14, duty: 0.3, ..Patch::new(Square, 330.0) },\n                    0.0,\n                )]\n            }\n        }\n        SimEvent::CourseFinish { new_best, .. } => {\n            let mut v = vec![\n                (Patch { decay: 0.18, volume: 0.13, ..Patch::new(Triangle, 523.3) }, 0.0),\n                (Patch { decay: 0.18, volume: 0.13, ..Patch::new(Triangle, 659.3) }, 0.1),\n                (Patch { decay: 0.4, volume: 0.14, ..Patch::new(Triangle, 784.0) }, 0.2),\n            ];\n            if *new_best {\n                v.push((Patch { decay: 0.5, volume: 0.13, ..Patch::new(Triangle, 1046.5) }, 0.34));\n            }\n            v\n        }\n        SimEvent::Checkpoint { .. } => vec![\n            (Patch { decay: 0.12, volume: 0.1, ..Patch::new(Sine, 1174.7) }, 0.0),\n            (Patch { decay: 0.2, volume: 0.1, ..Patch::new(Sine, 1568.0) }, 0.07),\n        ],\n        SimEvent::Splash { .. } => vec![(\n            Patch { attack: 0.01, decay: 0.35, volume: 0.25, cutoff: 3000.0, cutoff_end: 400.0, ..Patch::new(Noise, 1.0) },\n            0.0,\n        )],\n        SimEvent::Pad { .. } => {\n            vec![(Patch { freq_end: 1200.0, glide: 0.08, decay: 0.12, volume: 0.1, ..Patch::new(Sine, 600.0) }, 0.0)]\n        }\n        SimEvent::Grab { .. } => {\n            vec![(Patch { decay: 0.05, volume: 0.12, cutoff: 1500.0, cutoff_end: 600.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n        }\n        SimEvent::Break { .. } => vec![\n            (Patch { decay: 0.18, volume: 0.3, cutoff: 6000.0, cutoff_end: 900.0, ..Patch::new(Noise, 1.0) }, 0.0),\n            (Patch { freq_end: 70.0, glide: 0.15, decay: 0.2, volume: 0.25, ..Patch::new(Sine, 160.0) }, 0.0),\n        ],\n        SimEvent::Crack { .. } => {\n            vec![(Patch { decay: 0.04, volume: 0.12, cutoff: 5000.0, cutoff_end: 2000.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n        }\n        SimEvent::Bounce { .. } => {\n            vec![(Patch { freq_end: 900.0, glide: 0.18, decay: 0.22, volume: 0.16, ..Patch::new(Sine, 180.0) }, 0.0)]\n        }\n        SimEvent::Roll { .. } => vec![(\n            Patch { attack: 0.02, decay: 0.2, volume: 0.1, cutoff: 600.0, cutoff_end: 2400.0, ..Patch::new(Noise, 1.0) },\n            0.0,\n        )],\n        SimEvent::Spotted { .. } => vec![\n            (Patch { decay: 0.18, volume: 0.16, ..Patch::new(Square, 990.0) }, 0.0),\n            (Patch { decay: 0.25, volume: 0.16, ..Patch::new(Square, 660.0) }, 0.16),\n        ],\n        SimEvent::Shot { .. } => {\n            vec![(Patch { freq_end: 420.0, glide: 0.06, decay: 0.06, volume: 0.05, ..Patch::new(Square, 1500.0) }, 0.0)]\n        }\n        SimEvent::Damage { .. } => {\n            vec![(Patch { decay: 0.03, volume: 0.08, cutoff: 3500.0, cutoff_end: 1200.0, ..Patch::new(Noise, 1.0) }, 0.0)]\n        }\n        SimEvent::Destroyed { size, .. } => {\n            let v = size.clamp(0.4, 2.0);\n            vec![\n                (\n                    Patch {\n                        attack: 0.003,\n                        decay: 0.3,\n                        volume: 0.35 * v,\n                        cutoff: 5000.0,\n                        cutoff_end: 200.0,\n                        ..Patch::new(Noise, 1.0)\n                    },\n                    0.0,\n                ),\n                (Patch { freq_end: 40.0, glide: 0.35, decay: 0.4, volume: 0.4 * v, ..Patch::new(Sine, 140.0) }, 0.0),\n            ]\n        }\n        _ => Vec::new(),\n    }\n}\n\n/// Position of an event (None = not spatial).\npub fn event_pos(ev: &SimEvent) -> Option<Vec3> {\n    match ev {\n        SimEvent::Jump { pos }\n        | SimEvent::Land { pos, .. }\n        | SimEvent::Step { pos }\n        | SimEvent::Throw { pos }\n        | SimEvent::Explosion { pos, .. }\n        | SimEvent::Impact { pos, .. }\n        | SimEvent::Hit { pos, .. }\n        | SimEvent::Splash { pos }\n        | SimEvent::Grab { pos }\n        | SimEvent::Roll { pos }\n        | SimEvent::Break { pos }\n        | SimEvent::Crack { pos }\n        | SimEvent::Bounce { pos }\n        | SimEvent::Shot { pos }\n        | SimEvent::Damage { pos }\n        | SimEvent::Destroyed { pos, .. }\n        | SimEvent::Swing { pos, .. }\n        | SimEvent::Strike { pos, .. }\n        | SimEvent::Slain { pos, .. }\n        | SimEvent::Slam { pos, .. }\n        | SimEvent::Blast { pos, .. }\n        | SimEvent::Spell { pos, .. }\n        | SimEvent::Coin { pos }\n        | SimEvent::Loot { pos, .. }\n        | SimEvent::Pickup { pos, .. }\n        | SimEvent::Block { pos } => Some(*pos),\n        _ => None,\n    }\n}\n\n/// Plays an event's sounds with distance attenuation and panning.\npub fn play_event(mixer: &mut Mixer, ev: &SimEvent, l: &Listener, sfx: f32) {\n    let (pan, gain) = match event_pos(ev) {\n        Some(p) => {\n            let d = p - l.pos;\n            let dist = d.length();\n            ((d.dot(l.right) / 12.0).clamp(-0.85, 0.85), 1.0 / (1.0 + dist / 14.0))\n        }\n        None => (0.0, 1.0),\n    };\n    for (patch, delay) in sounds_for(ev) {\n        mixer.play(patch, pan, gain * sfx, delay);\n    }\n}\n\n/// Renders timed events offline: (time in seconds, event). Returns interleaved stereo.\npub fn render_events(events: &[(f32, SimEvent)], duration: f32, sample_rate: f32, l: &Listener) -> Vec<f32> {\n    let mut mixer = Mixer::new(sample_rate);\n    let total = (duration * sample_rate) as usize;\n    let mut out = vec![0.0f32; total * 2];\n    let block = 256;\n    let mut i = 0;\n    let mut ev = events.iter().peekable();\n    while i < total {\n        let t = i as f32 / sample_rate;\n        while let Some((et, e)) = ev.peek() {\n            if *et > t {\n                break;\n            }\n            play_event(&mut mixer, e, l, 1.0);\n            ev.next();\n        }\n        let n = block.min(total - i);\n        mixer.render(&mut out[i * 2..(i + n) * 2]);\n        i += n;\n    }\n    out\n}\n\n/// Writes interleaved stereo f32 samples as a 16-bit PCM WAV file.\npub fn write_wav(path: &std::path::Path, samples: &[f32], sample_rate: u32) -> std::io::Result<()> {\n    let data_len = (samples.len() * 2) as u32;\n    let mut b = Vec::with_capacity(44 + data_len as usize);\n    b.extend_from_slice(b\"RIFF\");\n    b.extend_from_slice(&(36 + data_len).to_le_bytes());\n    b.extend_from_slice(b\"WAVEfmt \");\n    b.extend_from_slice(&16u32.to_le_bytes());\n    b.extend_from_slice(&1u16.to_le_bytes()); // PCM\n    b.extend_from_slice(&2u16.to_le_bytes()); // stereo\n    b.extend_from_slice(&sample_rate.to_le_bytes());\n    b.extend_from_slice(&(sample_rate * 4).to_le_bytes());\n    b.extend_from_slice(&4u16.to_le_bytes());\n    b.extend_from_slice(&16u16.to_le_bytes());\n    b.extend_from_slice(b\"data\");\n    b.extend_from_slice(&data_len.to_le_bytes());\n    for s in samples {\n        b.extend_from_slice(&((s.clamp(-1.0, 1.0) * 32767.0) as i16).to_le_bytes());\n    }\n    if let Some(d) = path.parent().filter(|d| !d.as_os_str().is_empty()) {\n        std::fs::create_dir_all(d)?;\n    }\n    std::fs::write(path, b)\n}\n\nenum Cmd {\n    Play(Patch, f32, f32, f32),\n    Master(f32),\n}\n\n/// Live output through the default sound device.\npub struct AudioOut {\n    _stream: cpal::Stream,\n    tx: Sender<Cmd>,\n    pub sample_rate: u32,\n    pub device: String,\n}\n\nimpl AudioOut {\n    pub fn start() -> anyhow::Result<Self> {\n        use cpal::traits::{DeviceTrait, HostTrait, StreamTrait};\n        let host = cpal::default_host();\n        let device = host.default_output_device().ok_or_else(|| anyhow::anyhow!(\"no sound output device\"))?;\n        let name = device.description().map(|d| d.to_string()).unwrap_or_else(|_| \"default\".into());\n        let supported = device.default_output_config()?;\n        let format = supported.sample_format();\n        let config: cpal::StreamConfig = supported.config();\n        let rate = config.sample_rate as u32;\n        let channels = config.channels as usize;\n        let (tx, rx) = channel::<Cmd>();\n        let stream = match format {\n            cpal::SampleFormat::F32 => build::<f32>(&device, config, rx, channels)?,\n            cpal::SampleFormat::I16 => build::<i16>(&device, config, rx, channels)?,\n            cpal::SampleFormat::U16 => build::<u16>(&device, config, rx, channels)?,\n            other => anyhow::bail!(\"unsupported sample format {other:?}\"),\n        };\n        stream.play()?;\n        Ok(Self { _stream: stream, tx, sample_rate: rate, device: name })\n    }\n\n    pub fn play_event(&self, ev: &SimEvent, l: &Listener, sfx: f32) {\n        let (pan, gain) = match event_pos(ev) {\n            Some(p) => {\n                let d = p - l.pos;\n                ((d.dot(l.right) / 12.0).clamp(-0.85, 0.85), 1.0 / (1.0 + d.length() / 14.0))\n            }\n            None => (0.0, 1.0),\n        };\n        for (patch, delay) in sounds_for(ev) {\n            let _ = self.tx.send(Cmd::Play(patch, pan, gain * sfx, delay));\n        }\n    }\n\n    pub fn set_master(&self, v: f32) {\n        let _ = self.tx.send(Cmd::Master(v));\n    }\n\n    /// Starts output again. Browsers keep sound off until the page gets a click or key press,\n    /// so the browser build calls this on the first input.\n    pub fn resume(&self) {\n        use cpal::traits::StreamTrait;\n        let _ = self._stream.play();\n    }\n}\n\nfn build<T>(device: &cpal::Device, config: cpal::StreamConfig, rx: Receiver<Cmd>, channels: usize) -> anyhow::Result<cpal::Stream>\nwhere\n    T: cpal::SizedSample + cpal::FromSample<f32>,\n{\n    use cpal::traits::DeviceTrait;\n    let mut mixer = Mixer::new(config.sample_rate as f32);\n    let mut buf: Vec<f32> = Vec::new();\n    let stream = device.build_output_stream::<T, _, _>(\n        config,\n        move |data: &mut [T], _| {\n            while let Ok(c) = rx.try_recv() {\n                match c {\n                    Cmd::Play(p, pan, gain, delay) => mixer.play(p, pan, gain, delay),\n                    Cmd::Master(v) => mixer.master = v,\n                }\n            }\n            let frames = data.len() / channels.max(1);\n            buf.resize(frames * 2, 0.0);\n            mixer.render(&mut buf);\n            for (i, frame) in data.chunks_mut(channels.max(1)).enumerate() {\n                for (c, s) in frame.iter_mut().enumerate() {\n                    *s = T::from_sample(buf[i * 2 + c.min(1)]);\n                }\n            }\n        },\n        |e| log::warn!(\"audio stream error: {e}\"),\n        None,\n    )?;\n    Ok(stream)\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn explosion_is_loud_then_silent() {\n        let ev = SimEvent::Explosion { pos: Vec3::ZERO, radius: 1.35 };\n        let out = render_events(&[(0.0, ev)], 2.0, 22050.0, &Listener::default());\n        let peak_early = out[..22050].iter().fold(0.0f32, |m, s| m.max(s.abs()));\n        let peak_late = out[out.len() - 2000..].iter().fold(0.0f32, |m, s| m.max(s.abs()));\n        assert!(peak_early > 0.1, \"audible: {peak_early}\");\n        assert!(peak_late < 1e-3, \"decays: {peak_late}\");\n    }\n}\n#!/usr/bin/env bash\n# Builds the browser version (WebAssembly + WebGPU). Output: target/web/{index.html,manifest.webmanifest,shardfall.js,shardfall_bg.wasm}\n# Serve that folder over HTTP (e.g. `python3 -m http.server -d target/web`) and open it in Chrome or Edge.\n# --single-file writes only target/web/<title>.html (shardfall.html): one page with the glue and gzipped wasm inside\n#   that runs from file:// or any host (scripts/pack_single_html.py; also --title, --description, --theme-color,\n#   --scene NAME for the start scene when the address names none, --out PATH).\n# Needs: rustup target add wasm32-unknown-unknown\n#        cargo install wasm-bindgen-cli --version <the wasm-bindgen version in Cargo.lock>\nset -euo pipefail\ncaller=$PWD\ncd \"$(dirname \"$0\")/..\"\nsingle=false\npack=()\nwhile (($#)); do\n\tcase $1 in\n\t--single-file) single=true ;;\n\t--title | --description | --theme-color | --scene | --out)\n\t\t(($# > 1)) || { echo \"build-web.sh: $1 needs a value\" >&2; exit 2; }\n\t\tvalue=$2\n\t\t[[ $1 == --out && $value != /* ]] && value=$caller/$value\n\t\tpack+=(\"$1\" \"$value\")\n\t\tshift\n\t\t;;\n\t*) echo \"build-web.sh: unknown option $1 (options are listed at the top of $0)\" >&2; exit 2 ;;\n\tesac\n\tshift\ndone\nif ((${#pack[@]})) && ! $single; then\n\techo \"build-web.sh: ${pack[0]} needs --single-file\" >&2\n\texit 2\nfi\ncargo build --locked --profile dist --target wasm32-unknown-unknown -p pav_app\nwasm=${CARGO_TARGET_DIR:-target}/wasm32-unknown-unknown/dist/shardfall.wasm\nout=target/web\nif $single; then\n\tbindgen=$(mktemp -d)\n\ttrap 'rm -rf \"$bindgen\"' EXIT\n\twasm-bindgen --target web --no-typescript --out-dir \"$bindgen\" --out-name shardfall \"$wasm\"\n\tpython3 -I scripts/pack_single_html.py \"$bindgen\" \"${pack[@]}\"\n\texit\nfi\nrm -rf \"$out\"\nmkdir -p \"$out\"\nwasm-bindgen --target web --no-typescript --out-dir \"$out\" --out-name shardfall \"$wasm\"\ncp web/index.html web/manifest.webmanifest \"$out/\"\nls -la \"$out\"\n#!/usr/bin/env python3\n\"\"\"Packs the browser build into one self-contained HTML page: no other files, no network loads.\n\nusage: python3 -I scripts/pack_single_html.py BINDGEN_DIR [--title T] [--description D]\n           [--theme-color C] [--scene NAME] [--out PATH]\n\nBINDGEN_DIR is wasm-bindgen's output (shardfall.js, shardfall_bg.wasm); scripts/build-web.sh\n--single-file makes it and runs this. The page is web/index.html with the options written into\nits <title>, <meta name=description> and <meta name=theme-color> (left as they are when not\ngiven), the manifest link dropped, and, before </body>, the gzipped wasm as base64 text, a\nloader that sets window.loadGame (index.html's script calls it when set) and the JS glue as an\ninline module script. The loader shows a progress line, bakes in --scene (used when the address\nnames no room or scene) and unpacks with the browser's DecompressionStream. No blob: or data:\nURLs are needed. Out: target/web/<title>.html.\n\"\"\"\nimport argparse\nimport base64\nimport gzip\nimport html\nimport json\nimport pathlib\nimport re\nimport sys\n\nROOT = pathlib.Path(__file__).resolve().parent.parent\nPAGE = ROOT / \"web\" / \"index.html\"\n\n# Runs while the page parses, before index.html's module script.\nLOADER = \"\"\"\n(() => {\n  const msg = document.getElementById('msg');\n  // The start scene baked in at build time, unless the address names a room or a scene.\n  const scene = __SCENE__, query = new URLSearchParams(location.search);\n  if (scene && !query.get('room') && !query.get('scene')) {\n    query.set('scene', scene);\n    try { history.replaceState(history.state, '', '?' + query + location.hash); }\n    catch (error) { console.warn('Could not put the start scene in the address:', error); }\n  }\n  const line = document.createElement('div');\n  line.style.cssText = 'font-size: 14px; opacity: 0.7; font-variant-numeric: tabular-nums';\n  msg.style.flexDirection = 'column';\n  msg.style.gap = '8px';\n  msg.replaceChildren(`Loading ${document.title}…`, line);\n  const paint = () => new Promise((resolve) => setTimeout(resolve, 20));\n  // The JS glue is the module script at the end of the page: it hands over its init function.\n  const glue = new Promise((resolve) => { window.gameGlue = resolve; });\n  window.loadGame = async () => {\n    line.textContent = 'Unpacking…';\n    await paint();\n    // The gzipped wasm's base64 block leaves the page once read, to free its text.\n    const block = document.getElementById('game-wasm'), size = +block.dataset.size, text = block.textContent;\n    block.remove();\n    let packed;\n    if (Uint8Array.fromBase64) packed = Uint8Array.fromBase64(text);\n    else {\n      const bin = atob(text);\n      packed = new Uint8Array(bin.length);\n      for (let i = 0; i < bin.length; i++) packed[i] = bin.charCodeAt(i);\n    }\n    const wasm = new Uint8Array(size);\n    const reader = new Blob([packed]).stream().pipeThrough(new DecompressionStream('gzip')).getReader();\n    let n = 0;\n    for (let r = await reader.read(); !r.done; r = await reader.read()) {\n      wasm.set(r.value, n);\n      n += r.value.length;\n      line.textContent = `Unpacking ${Math.floor((100 * n) / size)}%`;\n    }\n    if (n !== size) throw new Error(`the packed game is damaged (${n} of ${size} bytes)`);\n    line.textContent = 'Starting…';\n    await paint();\n    const init = await glue;\n    await init({ module_or_path: wasm });\n  };\n})();\n\"\"\"\n\n\ndef fail(text):\n    sys.exit(f\"pack_single_html: {text}\")\n\n\ndef replace_one(page, pattern, make, what):\n    \"\"\"Replaces the one match of `pattern` in the page; anything else means index.html changed.\"\"\"\n    page, n = re.subn(pattern, make, page)\n    if n != 1:\n        fail(f\"expected one {what} in {PAGE.relative_to(ROOT)}, found {n}: update this script\")\n    return page\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__.split(\"\\n\")[0])\n    ap.add_argument(\"bindgen_dir\", type=pathlib.Path, help=\"wasm-bindgen output (shardfall.js, shardfall_bg.wasm)\")\n    ap.add_argument(\"--title\", help=\"<title> (default: index.html's)\")\n    ap.add_argument(\"--description\", help=\"<meta name=description> (default: index.html's)\")\n    ap.add_argument(\"--theme-color\", help=\"<meta name=theme-color> (default: index.html's)\")\n    ap.add_argument(\"--scene\", help=\"start scene when the address names no room or scene (default: the game's)\")\n    ap.add_argument(\"--out\", type=pathlib.Path, help=\"output file (default: target/web/<title>.html)\")\n    a = ap.parse_args()\n\n    js, wasm_path = a.bindgen_dir / \"shardfall.js\", a.bindgen_dir / \"shardfall_bg.wasm\"\n    for p in (js, wasm_path):\n        if not p.is_file():\n            fail(f\"{p} is missing: run wasm-bindgen --target web --out-name shardfall first\")\n    # The glue goes in the page as an inline module script, so it can't import other files\n    # (wasm-bindgen snippets) or hold text that would end the script element early.\n    glue = js.read_text(encoding=\"utf-8\")\n    if (a.bindgen_dir / \"snippets\").exists() or re.search(r\"^import\\b\", glue, re.M):\n        fail(\"the JS glue imports other files (wasm-bindgen snippets); inline them before packing\")\n    if re.search(r\"(?i)</script|<script|<!--\", glue):\n        fail(\"the JS glue contains <script, </script or <!--, which can't sit inside an inline script\")\n    init = re.search(r\"^export \\{[^}]*?\\b([\\w$]+) as default\\b\", glue, re.M)\n    if not init:\n        fail(\"can't find the JS glue's default export (its init function)\")\n\n    page = PAGE.read_text(encoding=\"utf-8\")\n    if a.title is not None:\n        page = replace_one(page, r\"<title>[^<]*</title>\", lambda m: f\"<title>{html.escape(a.title)}</title>\", \"<title>\")\n    for name, value in ((\"description\", a.description), (\"theme-color\", a.theme_color)):\n        if value is not None:\n            page = replace_one(\n                page,\n                rf'<meta name=\"{name}\" content=\"[^\"]*\">',\n                lambda m, name=name, value=value: f'<meta name=\"{name}\" content=\"{html.escape(value)}\">',\n                f\"<meta name={name}>\",\n            )\n    # A manifest is another file to load: the single page goes without one.\n    page = replace_one(page, r'[ \\t]*<link rel=\"manifest\"[^>]*>\\n', lambda m: \"\", \"manifest link\")\n\n    wasm = wasm_path.read_bytes()\n    packed = gzip.compress(wasm, compresslevel=9, mtime=0)\n    # JSON is valid JS; escaping \"<\" keeps a scene name from closing the script element.\n    loader = LOADER.replace(\"__SCENE__\", json.dumps(a.scene or None).replace(\"<\", \"\\\\u003c\"))\n    tail = (\n        f'<script id=\"game-wasm\" type=\"application/octet-stream\" data-size=\"{len(wasm)}\">'\n        f\"{base64.b64encode(packed).decode()}</script>\\n\"\n        f\"<script>{loader}</script>\\n\"\n        f'<script type=\"module\">\\n{glue}\\nwindow.gameGlue({init[1]});\\n</script>\\n'\n    )\n    page = replace_one(page, r\"</body>\", lambda m: tail + \"</body>\", \"</body>\")\n\n    title = a.title if a.title is not None else html.unescape(re.search(r\"<title>([^<]*)</title>\", page)[1])\n    out = a.out or ROOT / \"target\" / \"web\" / f\"{re.sub(r'[^a-z0-9]+', '-', title.lower()).strip('-') or 'game'}.html\"\n    out.parent.mkdir(parents=True, exist_ok=True)\n    out.write_text(page, encoding=\"utf-8\")\n    mb = lambda n: f\"{n / 1e6:.1f} MB\"  # noqa: E731\n    print(f\"{out}: {mb(out.stat().st_size)} (wasm {mb(len(wasm))}, gzipped {mb(len(packed))}; JS glue {mb(len(glue))})\")\n\n\nif __name__ == \"__main__\":\n    main()\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n<title>Shardfall</title>\n<meta name=\"description\" content=\"Play Shardfall, a procedural hack-and-slash adventure with an interactive tech demo pavilion.\">\n<meta name=\"theme-color\" content=\"#15171c\">\n<meta name=\"mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n<link rel=\"manifest\" href=\"manifest.webmanifest\">\n<link rel=\"icon\" href=\"data:,\">\n<style>\n  /* The page is the game: no scrolling, zooming, text selection, callouts or tap flashes. */\n  html, body { margin: 0; height: 100%; overflow: hidden; background: #15171c; overscroll-behavior: none;\n               touch-action: none; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none;\n               -webkit-tap-highlight-color: transparent; }\n  /* winit appends the game canvas to <body>; it fills the page and the game follows its size.\n     dvh: the height that is visible while a phone's browser bars come and go. */\n  canvas { display: block; width: 100vw !important; height: 100vh !important; height: 100dvh !important;\n           outline: none; touch-action: none; }\n  #msg { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center;\n         font: 18px system-ui, sans-serif; color: #c9ccd4; text-align: center; padding: 24px; pointer-events: none; }\n  /* Phones held upright: a hint to turn sideways that fades by itself. */\n  #turn { display: none; position: fixed; left: 50%; top: 12px; transform: translateX(-50%); padding: 8px 14px;\n          border-radius: 18px; background: rgba(0, 0, 0, 0.6); color: #ffd690; font: 14px system-ui, sans-serif;\n          pointer-events: none; animation: fade 1s 5s forwards; }\n  @media (orientation: portrait) and (pointer: coarse) { #turn { display: block; } }\n  @keyframes fade { to { opacity: 0; } }\n</style>\n</head>\n<body>\n<div id=\"msg\" role=\"status\" aria-live=\"polite\">Loading Shardfall…</div>\n<div id=\"turn\">Turn your phone sideways for the best view</div>\n<script type=\"module\">\n  // Start in a demo room with ?room=NAME, or the pavilion with ?scene=world.\n  // Messages name the game by the page title (a single-file build may retitle it).\n  const name = document.title;\n  const msg = document.getElementById('msg');\n  if (!navigator.gpu) {\n    msg.replaceChildren(`${name} needs WebGPU.`, document.createElement('br'),\n      'Use a recent Chrome, Edge or Safari (iOS 26 or later) with hardware acceleration enabled.');\n  } else {\n    // The game hides this message once its canvas exists, and takes keyboard focus.\n    new MutationObserver((_, obs) => {\n      const c = document.querySelector('canvas');\n      if (c) { c.setAttribute('aria-label', `${name} game`); msg.remove(); c.focus(); obs.disconnect(); }\n    }).observe(document.body, { childList: true });\n    // Phones and tablets: the first tap goes full screen and turns sideways, where the browser\n    // allows it (Android; an iPhone keeps its bars, or plays full screen from the home screen).\n    if (matchMedia('(pointer: coarse)').matches) {\n      addEventListener('pointerup', () => {\n        const el = document.documentElement;\n        if (!document.fullscreenElement && el.requestFullscreen) {\n          el.requestFullscreen({ navigationUI: 'hide' })\n            .then(() => screen.orientation && screen.orientation.lock && screen.orientation.lock('landscape'))\n            .catch(() => {});\n        }\n      }, { once: true, capture: true });\n    }\n    try {\n      // The game is shardfall.js and its .wasm beside this page. A single-file build\n      // (scripts/pack_single_html.py) carries both inside the page and sets window.loadGame.\n      if (window.loadGame) await window.loadGame();\n      else await (await import('./shardfall.js')).default();\n    } catch (error) {\n      console.error(`${name} failed to load:`, error);\n      msg.textContent = `${name} could not load. Please reload the page. If it still fails, check that WebGPU and hardware acceleration are enabled.`;\n      document.body.append(msg);\n    }\n  }\n</script>\n</body>\n</html>\n    pub fn clear_view_effects(&mut self) {\n        self.events.clear();\n        let _ = self.sim.drain_events();\n        if let Some(gpu) = &mut self.gpu {\n            gpu.builder = ViewBuilder::new();\n            gpu.renderer.clear_particles();\n            gpu.studio_mode = self.sim.studio_mode();\n        }\n    }\n\n    /// Applies a room's camera defaults when the player enters/leaves it, and level camera\n    /// cues, the way the game does (without blending). Called after every step.\n    pub fn sync_camera(&mut self) {\n        use pav_core::params::{ParamValue, apply_map};\n        if self.live || self.sim.studio_active() {\n            return;\n        }\n        let w = &self.sim.state.world;\n        let now = w.current_room;\n        let rot = |yaw: f64, q: u8| ParamValue::Float((yaw + q as f64 * 90.0 + 540.0).rem_euclid(360.0) - 180.0);\n        let c = &self.sim.state.courses;\n        if c.cue_serial != self.cue_serial {\n            self.cue_serial = c.cue_serial;\n            // Like the game: each cue applies on top of the camera from before the first cue;\n            // sweeps start at their `from` value (captures are single moments).\n            match c.cue() {\n                Some(cue) => {\n                    let q = now.and_then(|i| w.rooms.get(i as usize)).map(|r| r.place.quarters).unwrap_or(0);\n                    let base = self.cue_base.get_or_insert_with(|| self.camera.params.clone()).clone();\n                    let mut set = cue.set.clone();\n                    for sw in &cue.sweep {\n                        set.insert(sw.param.clone(), ParamValue::Float(sw.from as f64));\n                    }\n                    if let Some(y) = set.get(\"yaw\").and_then(|v| v.as_f64()) {\n                        set.insert(\"yaw\".into(), rot(y, q));\n                    }\n                    self.camera.params = base;\n                    apply_map(&mut self.camera.params, &set);\n                }\n                None => {\n                    if let Some(b) = self.cue_base.take() {\n                        self.camera.params = b;\n                    }\n                }\n            }\n        }\n        // Room changes after cues (leaving a room clears its cue first, then restores the camera).\n        if now != self.room_cam.as_ref().map(|r| r.0) {\n            if let Some((_, saved)) = self.room_cam.take() {\n                self.camera.params = saved;\n            }\n            if let Some(r) = now.and_then(|i| w.rooms.get(i as usize)).filter(|r| !r.def.camera.is_empty()) {\n                let saved = self.camera.params.clone();\n                let mut cam = r.def.camera.clone();\n                let yaw = cam.get(\"yaw\").and_then(|v| v.as_f64()).unwrap_or(0.0);\n                cam.insert(\"yaw\".into(), rot(yaw, r.place.quarters));\n                apply_map(&mut self.camera.params, &cam);\n                self.room_cam = Some((r.id, saved));\n            }\n        }\n        self.sync_view();\n    }\n\n    /// Takes `params` as the base camera and applies the current room's `[camera]` on top.\n    pub fn reset_camera(&mut self, params: CameraParams) {\n        self.camera.params = params;\n        self.room_cam = None;\n        self.cue_base = None;\n        self.sync_camera();\n    }\n\n    /// The camera without the current room's defaults.\n    pub fn camera_base_or_current(&self) -> CameraParams {\n        self.room_cam.as_ref().map(|(_, c)| c.clone()).unwrap_or_else(|| self.camera.params.clone())\n    }\n\n    /// The view settings without the current room's / pads' overrides.\n    pub fn view_base_or_current(&self) -> ViewSettings {\n        self.view_base.clone().unwrap_or_else(|| self.view.clone())\n    }\n\n    /// Takes `view` as the base settings and applies the current room's `[view]` table on top.\n    pub fn reset_view(&mut self, view: ViewSettings) {\n        self.view = view;\n        self.view_base = None;\n        self.view_room = None;\n        self.view_serial = u64::MAX;\n        self.sync_view();\n    }\n\n    /// Room `[view]` tables and pad `view.*` overrides, like the game applies them.\n    fn sync_view(&mut self) {\n        let w = &self.sim.state.world;\n        let now = w.current_room;\n        let serial = self.sim.state.courses.view_serial;\n        if now == self.view_room && serial == self.view_serial {\n            return;\n        }\n        if let Some(base) = self.view_base.take() {\n            self.view = base;\n        }\n        self.view_room = now;\n        self.view_serial = serial;\n        let q = now.and_then(|i| w.rooms.get(i as usize)).map(|r| r.place.quarters).unwrap_or(0);\n        let room =\n            now.and_then(|i| w.rooms.get(i as usize)).map(|r| pav_view::build::room_view_map(&r.def.view, q)).unwrap_or_default();\n        let pads = pav_view::build::room_view_map(&self.sim.state.courses.view, q);\n        if room.is_empty() && pads.is_empty() {\n            return;\n        }\n        self.view_base = Some(self.view.clone());\n        self.view.apply(&room);\n        self.view.apply(&pads);\n    }\n\n    /// The view settings captures use: the session's, the game place's look, then the look\n    /// layer.\n    pub fn view_for(&self, frame: &pav_core::RenderFrame) -> ViewSettings {\n        let mut view = self.view.clone();\n        if let Some(g) = &frame.game {\n            pav_view::arpg::place_look(g, &mut view);\n        }\n        self.look.apply(&mut view);\n        view\n    }\n\n    /// Renders the current state to RGBA8 pixels.\n    pub fn render(&mut self, width: u32, height: u32) -> Result<Vec<u8>> {\n        let frame = self.sim.frame();\n        let focus = frame.focus;\n        self.camera.snap(focus);\n        let camera = self.camera.clone();\n        let view = self.view_for(&frame);\n        let events = std::mem::take(&mut self.events);\n        let gpu = self.gpu()?;\n        gpu.prepare_frame(&frame);\n        if !frame.studio_active() {\n            gpu.builder.add_events(&events);\n        }\n        let scene = gpu.builder.build(&frame, &frame, 1.0, &camera, width as f32 / height as f32, &view, focus);\n        pav_render::capture::render_to_rgba(&mut gpu.renderer, &scene, width, height)\n    }\n\n    /// Renders like `render` with the game UI over it (when a game runs: Shardfall, or a\n    /// `pav_core::games` game's HUD lines): the pixels, and what the UI drew (`None` without a\n    /// game). `input` hovers or clicks.\n    pub fn render_ui(\n        &mut self,\n        width: u32,\n        height: u32,\n        input: pav_ui::headless::Input,\n    ) -> Result<(Vec<u8>, Option<pav_ui::headless::Drawn>)> {\n        let frame = self.sim.frame();\n        let focus = frame.focus;\n        self.camera.snap(focus);\n        let camera = self.camera.clone();\n        let view = self.view_for(&frame);\n        let events = std::mem::take(&mut self.events);\n        let gpu = self.gpu()?;\n        gpu.prepare_frame(&frame);\n        if !frame.studio_active() {\n            gpu.builder.add_events(&events);\n        }\n        let scene = gpu.builder.build(&frame, &frame, 1.0, &camera, width as f32 / height as f32, &view, focus);\n        let vp = scene.camera.proj * scene.camera.view;\n        let drawn = has_ui(&frame).then(|| self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input));\n        let gpu = self.gpu.as_mut().unwrap();\n        let Some(paint) = drawn.as_ref().map(|d| &d.paint) else {\n            return Ok((pav_render::capture::render_to_rgba(&mut gpu.renderer, &scene, width, height)?, None));\n        };\n        let device = gpu.renderer.device().clone();\n        let overlay =\n            gpu.overlay.get_or_insert_with(|| pav_ui::headless::Overlay::new(&device, pav_render::capture::CAPTURE_FORMAT));\n        let rgba = pav_render::capture::render_to_rgba_with(\n            &mut gpu.renderer,\n            &scene,\n            width,\n            height,\n            |device, queue, encoder, target| overlay.paint(device, queue, encoder, target, (width, height), paint),\n        )?;\n        Ok((rgba, drawn))\n    }\n\n    /// The game UI's reading without rendering (no GPU): what is on screen at `width` x\n    /// `height` from the session's camera. `None` without a game.\n    pub fn read_ui(&mut self, width: u32, height: u32, input: pav_ui::headless::Input) -> Option<pav_ui::headless::Drawn> {\n        let frame = self.sim.frame();\n        if !has_ui(&frame) {\n            return None;\n        }\n        self.camera.snap(frame.focus);\n        let vp = self.camera.view_proj(width as f32 / height.max(1) as f32);\n        Some(self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input))\n    }\n\n    /// Renders `frame`, a stage the simulation does not hold (a material swatch), from the\n    /// session's camera as it is.\n    pub fn render_frame(&mut self, frame: &RenderFrame, width: u32, height: u32) -> Result<Vec<u8>> {\n        let camera = self.camera.clone();\n        let view = self.view_for(frame);\n        let gpu = self.gpu()?;\n        gpu.prepare_frame(frame);\n        let scene = gpu.builder.build(frame, frame, 1.0, &camera, width as f32 / height as f32, &view, frame.focus);\n        pav_render::capture::render_to_rgba(&mut gpu.renderer, &scene, width, height)\n    }\n\n    /// Renders like `render` and also returns the camera's view-projection (to place marks).\n    pub fn render_with_camera(&mut self, width: u32, height: u32) -> Result<(Vec<u8>, glam::Mat4)> {\n        let frame = self.sim.frame();\n        let focus = frame.focus;\n        self.camera.snap(focus);\n        let camera = self.camera.clone();\n        let view = self.view_for(&frame);\n        let events = std::mem::take(&mut self.events);\n        let gpu = self.gpu()?;\n        gpu.prepare_frame(&frame);\n        if !frame.studio_active() {\n            gpu.builder.add_events(&events);\n        }\n        let scene = gpu.builder.build(&frame, &frame, 1.0, &camera, width as f32 / height as f32, &view, focus);\n        let vp = scene.camera.proj * scene.camera.view;\n        Ok((pav_render::capture::render_to_rgba(&mut gpu.renderer, &scene, width, height)?, vp))\n    }\n\n    pub fn camera_eye(&self) -> Vec3 {\n        self.camera.eye()\n    }\n\n    pub fn focus(&self) -> Vec3 {\n        self.sim.state.focus\n    }\n}\n\n/// A game's UI is on screen: Shardfall's, or a `pav_core::games` game's HUD lines.\npub fn has_ui(frame: &RenderFrame) -> bool {\n    frame.game.is_some() || !frame.hud.lines.is_empty()\n}\n   Compiling bytemuck_derive v1.12.1\n   Compiling serde_derive v1.0.229\n   Compiling thiserror-impl v2.0.21\n","numLines":1196,"startLine":1,"totalLines":1196}},"tool_result_meta":[{"id":"toolu_01XY4Qde1AWPnctsnW2miNHa","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
