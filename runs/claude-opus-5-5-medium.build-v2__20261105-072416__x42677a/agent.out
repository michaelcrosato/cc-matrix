}\n\n    /// `frame`, with the surgery game's shell and HUD when it runs.\n    #[allow(clippy::too_many_arguments)]\n    pub fn frame_all(\n        &mut self,\n        game: Option<&GameFrame>,\n        surgery: Option<&pav_core::games::surgery::frame::SurgeryFrame>,\n        hud_lines: &HudFrame,\n        vp: Mat4,\n        width: u32,\n        height: u32,\n        input: Input,\n    ) -> Drawn {\n        let ctx = egui::Context::default();\n        if surgery.is_some() {\n            crate::surgery::style::install(&ctx);\n            // The tools draw at one point per pixel; the shell lays out on a 1080-tall canvas.\n            ctx.set_zoom_factor(crate::surgery::style::zoom_for(height as f32, 1.0));\n        }\n        let touch = self.device == Device::Touch;''')\ns=s.replace('''                crate::game_lines(&ctx, hud_lines);\n                if touch && game.is_some() {''','''                crate::game_lines(&ctx, hud_lines);\n                if let Some(f) = surgery {\n                    // Only the last pass advances anything.\n                    let mut si = if last { self.surgery_input } else { crate::surgery::Input::default() };\n                    si.dt = if last { 1.0 / 60.0 } else { 0.0 };\n                    if !last {\n                        si.any = true;\n                    }\n                    self.surgery.ui(&ctx, &si, Some(f), vp);\n                }\n                if touch && game.is_some() {''')\nopen(p,'w').write(s)\nEOF\ngrep -n \"pub struct Input\" crates/pav_ui/src/headless.rs; cat > crates/pav_ui/src/surgery/about.json <<'EOF'\n{\"credits\": [\"Trauma Tempo: an original surgical-action drama.\"], \"sourceInformation\": {}, \"testingFeedback\": [], \"engineFeedback\": [], \"promptFeedback\": []}\nEOF\ncargo update -p pav_ui --offline 2>&1 | tail -1; JOBS=4 ../tools/cb.sh check -p pav_ui 2>&1 | grep -E \"^(error|warning: unused)|-->|^\\s+= note\" | head -40; git diff --stat Cargo.lock | tail -1","description":"Register the U