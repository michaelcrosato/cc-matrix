{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgk12cm6sJWWFdPtfMQt3","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01UCEEteS5JtKE6qccrdXYsD","name":"Bash","input":{"command":"cat > crates/pav_app/src/hub.rs <<'EOF'\n//! The bridge to `window.__hub` (web/hub_shim.js, which owns every AIHub call) and the test hook\n//! `window.__game`. Natively neither exists: everything here does nothing.\n\nuse serde_json::Value;\n\n#[cfg(target_arch = \"wasm32\")]\nmod js {\n    use js_sys::{Function, Reflect};\n    use wasm_bindgen::JsValue;\n\n    pub fn hub() -> Option<JsValue> {\n        let w = web_sys::window()?;\n        let h = Reflect::get(&w, &JsValue::from_str(\"__hub\")).ok()?;\n        if h.is_undefined() || h.is_null() { None } else { Some(h) }\n    }\n\n    pub fn get(obj: &JsValue, key: &str) -> Option<JsValue> {\n        let v = Reflect::get(obj, &JsValue::from_str(key)).ok()?;\n        if v.is_undefined() || v.is_null() { None } else { Some(v) }\n    }\n\n    pub fn call(obj: &JsValue, key: &str, args: &[JsValue]) -> Option<JsValue> {\n        let f: Function = get(obj, key)?.into();\n        let list = js_sys::Array::new();\n        for a in args {\n            list.push(a);\n        }\n        f.apply(obj, &list).ok()\n    }\n}\n\n/// True when the page was opened by the hub.\npub fn active() -> bool {\n    #[cfg(target_arch = \"wasm32\")]\n    {\n        js::hub().and_then(|h| js::get(&h, \"active\")).and_then(|v| v.as_bool()).unwrap_or(false)\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    false\n}\n\n/// `connect()`'s answer, once it came: JSON of `info`.\npub fn info() -> Option<Value> {\n    #[cfg(target_arch = \"wasm32\")]\n    {\n        let h = js::hub()?;\n        let v = js::call(&h, \"infoJson\", &[])?;\n        serde_json::from_str(&v.as_string()?).ok()\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    None\n}\n\n/// The events queued since the last poll: `[name, data, from?]`.\npub fn poll() -> Vec<Value> {\n    #[cfg(target_arch = \"wasm32\")]\n    {\n        let Some(h) = js::hub() else { return Vec::new() };\n        let Some(v) = js::call(&h, \"poll\", &[]) else { return Vec::new() };\n        v.as_string().and_then(|s| serde_json::from_str(&s).ok()).unwrap_or_default()\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    Vec::new()\n}\n\npub fn ready() {\n    #[cfg(target_arch = \"wasm32\")]\n    if let Some(h) = js::hub() {\n        js::call(&h, \"ready\", &[]);\n    }\n}\n\npub fn answer(what: &str) {\n    #[cfg(target_arch = \"wasm32\")]\n    if let Some(h) = js::hub() {\n        js::call(&h, \"answer\", &[what.into()]);\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    let _ = what;\n}\n\n/// The hub's clock (ms since play began; negative in the countdown).\npub fn time() -> f64 {\n    #[cfg(target_arch = \"wasm32\")]\n    {\n        js::hub().and_then(|h| js::call(&h, \"time\", &[])).and_then(|v| v.as_f64()).unwrap_or(f64::NEG_INFINITY)\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    f64::NEG_INFINITY\n}\n\npub fn send(v: &Value) {\n    #[cfg(target_arch = \"wasm32\")]\n    if let Some(h) = js::hub() {\n        js::call(&h, \"send\", &[v.to_string().into()]);\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    let _ = v;\n}\n\npub fn publish(v: &Value) {\n    #[cfg(target_arch = \"wasm32\")]\n    if let Some(h) = js::hub() {\n        js::call(&h, \"publish\", &[v.to_string().into()]);\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    let _ = v;\n}\n\npub fn finish(v: &Value) {\n    #[cfg(target_arch = \"wasm32\")]\n    if let Some(h) = js::hub() {\n        js::call(&h, \"finish\", &[v.to_string().into()]);\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    let _ = v;\n}\n\n/// Rumble on a pad: the page's small helper.\npub fn rumble(pad: usize, ms: f32, weak: f32, strong: f32) {\n    #[cfg(target_arch = \"wasm32\")]\n    if let Some(w) = web_sys::window() {\n        use wasm_bindgen::JsValue;\n        let args = [JsValue::from_f64(pad as f64), JsValue::from_f64(ms as f64), JsValue::from_f64(weak as f64), JsValue::from_f64(strong as f64)];\n        js::call(&w, \"__rumble\", &args);\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    let _ = (pad, ms, weak, strong);\n}\n\n/// The About block the page carries.\npub fn about_text() -> Option<String> {\n    #[cfg(target_arch = \"wasm32\")]\n    {\n        web_sys::window()?.document()?.get_element_by_id(\"about-data\")?.text_content()\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    None\n}\n\n/// Whether a key or a fine pointer can exist here: a phone can do neither.\npub fn touch_only() -> bool {\n    #[cfg(target_arch = \"wasm32\")]\n    {\n        let m = |q: &str| web_sys::window().and_then(|w| w.match_media(q).ok().flatten()).is_some_and(|m| m.matches());\n        !m(\"(any-pointer: fine)\") && m(\"(any-pointer: coarse)\")\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    false\n}\n\nconst SAVE_KEY: &str = \"trauma_tempo_save\";\n\npub fn load_save() -> Option<String> {\n    #[cfg(target_arch = \"wasm32\")]\n    {\n        web_sys::window()?.local_storage().ok()??.get_item(SAVE_KEY).ok()?\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    std::fs::read_to_string(crate::boot::exe_dir().join(format!(\"{SAVE_KEY}.json\"))).ok()\n}\n\npub fn store_save(text: &str) {\n    #[cfg(target_arch = \"wasm32\")]\n    if let Some(s) = web_sys::window().and_then(|w| w.local_storage().ok().flatten()) {\n        let _ = s.set_item(SAVE_KEY, text);\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    let _ = std::fs::write(crate::boot::exe_dir().join(format!(\"{SAVE_KEY}.json\")), text);\n}\n\n// The test hook: `window.__game.status()`, `.step(n)`, `.do(json)`.\n#[cfg(target_arch = \"wasm32\")]\nthread_local! {\n    static STATUS: std::cell::RefCell<String> = const { std::cell::RefCell::new(String::new()) };\n    static STEPS: std::cell::Cell<u32> = const { std::cell::Cell::new(0) };\n    static DOS: std::cell::RefCell<Vec<String>> = const { std::cell::RefCell::new(Vec::new()) };\n}\n\n/// Installs `window.__game`.\npub fn install_hook() {\n    #[cfg(target_arch = \"wasm32\")]\n    {\n        use wasm_bindgen::JsCast;\n        use wasm_bindgen::closure::Closure;\n        let Some(w) = web_sys::window() else { return };\n        let game = js_sys::Object::new();\n        let status = Closure::<dyn Fn() -> String>::new(|| STATUS.with(|s| s.borrow().clone()));\n        let step = Closure::<dyn Fn(u32)>::new(|n: u32| STEPS.with(|s| s.set(s.get() + n)));\n        let run = Closure::<dyn Fn(String)>::new(|j: String| DOS.with(|d| d.borrow_mut().push(j)));\n        let set = |k: &str, f: &js_sys::Function| {\n            let _ = js_sys::Reflect::set(&game, &k.into(), f);\n        };\n        set(\"status\", status.as_ref().unchecked_ref());\n        set(\"step\", step.as_ref().unchecked_ref());\n        set(\"do\", run.as_ref().unchecked_ref());\n        let _ = js_sys::Reflect::set(&w, &\"__game\".into(), &game);\n        status.forget();\n        step.forget();\n        run.forget();\n    }\n}\n\npub fn set_status(v: &Value) {\n    #[cfg(target_arch = \"wasm32\")]\n    STATUS.with(|s| *s.borrow_mut() = v.to_string());\n    #[cfg(not(target_arch = \"wasm32\"))]\n    let _ = v;\n}\n\npub fn take_steps() -> u32 {\n    #[cfg(target_arch = \"wasm32\")]\n    {\n        STEPS.with(|s| s.replace(0))\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    0\n}\n\npub fn take_dos() -> Vec<String> {\n    #[cfg(target_arch = \"wasm32\")]\n    {\n        DOS.with(|d| std::mem::take(&mut *d.borrow_mut()))\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    Vec::new()\n}\nEOF\ncat > crates/pav_app/src/product.rs <<'EOF'\n//! The game's own frame path. `App::frame` is the engine demo's: boot and stats panels, room cards,\n//! hint bars, toasts, a touch layer, F-keys, camera keys, rewind on Backspace and a dense pause menu.\n//! None of that belongs in this game. When the scene is `surgery*`, `frame` and `window_event`\n//! branch here, reusing `Gfx`, `SimHost`, `ViewBuilder` and `CameraRig`.\n\nuse std::collections::{BTreeMap, HashSet};\n\nuse glam::{Mat4, Vec2, Vec3};\nuse pav_audio::director::Director;\nuse pav_audio::{BUS_EFFECTS, BUS_MUSIC, BUS_VOICES, Listener};\nuse pav_core::games::Outcome;\nuse pav_core::games::surgery::field::{TRAY_Z, tray_slot};\nuse pav_core::games::surgery::frame::{Stage, SurgeryFrame};\nuse pav_core::games::surgery::net::{self, NetCue};\nuse pav_core::games::surgery::tune::Difficulty;\nuse pav_core::games::surgery::{self, cue};\nuse pav_core::input::{SurgeonInput, surgeon_buttons as btn};\nuse pav_core::{Sim, SimEvent};\nuse pav_ui::Device;\nuse pav_ui::surgery::style;\nuse pav_ui::surgery::{About, CardInfo, Cmd, Input as ShellInput, Save, Screen, Shell};\nuse pav_view::CameraParams;\nuse serde_json::{Value, json};\nuse web_time::Instant;\nuse winit::event::{ElementState, MouseButton, MouseScrollDelta, WindowEvent};\nuse winit::event_loop::ActiveEventLoop;\nuse winit::keyboard::{KeyCode, PhysicalKey};\n\nuse crate::app::App;\nuse crate::hub;\n\nconst ABOUT: &str = include_str!(\"../../pav_ui/src/surgery/about.json\");\n\n/// Repeats a held direction: a press, a wait, then a steady rate.\n#[derive(Default, Clone, Copy)]\nstruct Repeat {\n    held: f32,\n}\n\nimpl Repeat {\n    fn tick(&mut self, on: bool, dt: f32) -> bool {\n        if !on {\n            self.held = 0.0;\n            return false;\n        }\n        let was = self.held;\n        self.held += dt;\n        if was == 0.0 {\n            return true;\n        }\n        if self.held > 0.4 {\n            let period = 0.11;\n            return ((self.held - 0.4) / period).floor() > ((was - 0.4).max(0.0) / period).floor();\n        }\n        false\n    }\n}\n\n/// One pad's state this frame.\n#[derive(Clone, Debug, Default)]\nstruct PadNow {\n    index: usize,\n    left: Vec2,\n    right: Vec2,\n    l2: f32,\n    r2: f32,\n    held: HashSet<u8>,\n    pressed: HashSet<u8>,\n    /// Which flick direction the left stick is in, if any.\n    flick: Option<u8>,\n    flick_new: bool,\n}\n\n// Our names for a pad's buttons.\nconst CROSS: u8 = 0;\nconst CIRCLE: u8 = 1;\nconst SQUARE: u8 = 2;\nconst TRIANGLE: u8 = 3;\nconst L1: u8 = 4;\nconst R1: u8 = 5;\nconst CREATE: u8 = 8;\nconst OPTIONS: u8 = 9;\nconst UP: u8 = 12;\nconst DOWN: u8 = 13;\nconst LEFT: u8 = 14;\nconst RIGHT: u8 = 15;\n\nfn read_pads(gilrs: &mut gilrs::Gilrs, prev: &mut BTreeMap<usize, PadNow>) -> (Vec<PadNow>, bool) {\n    use gilrs::{Axis, Button};\n    let mut activity = false;\n    while let Some(ev) = gilrs.next_event() {\n        if matches!(ev.event, gilrs::EventType::ButtonPressed(..)) {\n            activity = true;\n        }\n    }\n    const MAP: [(Button, u8); 12] = [\n        (Button::South, CROSS),\n        (Button::East, CIRCLE),\n        (Button::West, SQUARE),\n        (Button::North, TRIANGLE),\n        (Button::LeftTrigger, L1),\n        (Button::RightTrigger, R1),\n        (Button::Select, CREATE),\n        (Button::Start, OPTIONS),\n        (Button::DPadUp, UP),\n        (Button::DPadDown, DOWN),\n        (Button::DPadLeft, LEFT),\n        (Button::DPadRight, RIGHT),\n    ];\n    let mut out = Vec::new();\n    for (index, (id, gp)) in gilrs.gamepads().enumerate().take(4) {\n        let key: usize = id.into();\n        let before = prev.remove(&key).unwrap_or_default();\n        let mut now = PadNow { index, ..Default::default() };\n        let dz = |v: Vec2, d: f32| {\n            let l = v.length();\n            if l < d { Vec2::ZERO } else { v / l * ((l - d) / (1.0 - d)).min(1.0) }\n        };\n        now.left = dz(Vec2::new(gp.value(Axis::LeftStickX), gp.value(Axis::LeftStickY)), 0.18);\n        now.right = dz(Vec2::new(gp.value(Axis::RightStickX), gp.value(Axis::RightStickY)), 0.14);\n        now.l2 = gp.button_data(Button::LeftTrigger2).map(|d| d.value()).unwrap_or(0.0);\n        now.r2 = gp.button_data(Button::RightTrigger2).map(|d| d.value()).unwrap_or(0.0);\n        for (b, n) in MAP {\n            if gp.is_pressed(b) {\n                now.held.insert(n);\n                if !before.held.contains(&n) {\n                    now.pressed.insert(n);\n                }\n            }\n        }\n        // The stick flick: eight directions, instant, no menu. Up is 0, clockwise.\n        let l = now.left.length();\n        if l > 0.6 {\n            let a = now.left.x.atan2(now.left.y); // 0 = up, clockwise positive\n            let k = ((a / std::f32::consts::FRAC_PI_4).round() as i32).rem_euclid(8) as u8;\n            now.flick = Some(k);\n            now.flick_new = before.flick != Some(k);\n        } else if l > 0.42 {\n            now.flick = before.flick;\n        }\n        if !now.pressed.is_empty() || now.left.length() > 0.3 || now.right.length() > 0.3 || now.r2 > 0.1 || now.l2 > 0.1 {\n            activity = true;\n        }\n        prev.insert(key, now.clone());\n        out.push(now);\n    }\n    (out, activity)\n}\n\n#[derive(Default)]\npub struct HubState {\n    pub active: bool,\n    info: Option<Value>,\n    pub me: usize,\n    pub is_host: bool,\n    pub server: bool,\n    ready_sent: bool,\n    started: bool,\n    playing: bool,\n    ended: bool,\n    finished: bool,\n    players: Vec<(usize, String)>,\n    ready_ids: Vec<usize>,\n    remote: [SurgeonInput; 4],\n    send_t: f32,\n    publish_t: f32,\n    pending_cues: Vec<NetCue>,\n    cue_serial: u32,\n    seen_serial: u32,\n    left: Vec<usize>,\n    frames: u32,\n    snapshot_size: usize,\n    /// Latest snapshots seen, for status.\n    received: u32,\n    sent: u32,\n}\n\npub struct Product {\n    pub shell: Shell,\n    director: Director,\n    device: Device,\n    keys: HashSet<KeyCode>,\n    key_taps: HashSet<KeyCode>,\n    mouse: HashSet<MouseButton>,\n    mouse_taps: HashSet<MouseButton>,\n    cursor_px: Vec2,\n    moved_px: f32,\n    wheel: f32,\n    tap: Option<Vec2>,\n    any_event: bool,\n    pads_prev: BTreeMap<usize, PadNow>,\n    pad_slots: BTreeMap<usize, usize>,\n    nav: [Repeat; 4],\n    /// Whether a key or pad has ever been seen (a touch-only device unlocks when one arrives).\n    seen_device: bool,\n    touch_device: bool,\n    keyboard_cursor: bool,\n    rot_t: f32,\n    fps: f32,\n    fps_frames: u32,\n    fps_t: Instant,\n    hub: HubState,\n    audio_seen_gesture: bool,\n    paused: bool,\n    scene: String,\n    snapshot: Option<pav_core::SimState>,\n    cam_distance: f32,\n    last_beat: u32,\n    bot_steps: bool,\n    fonts_done: bool,\n    last_save_text: String,\n    peaks: [f32; 3],\n    seed: u64,\n    frame_count: u64,\n}\n\nimpl Product {\n    pub fn new(scene: &str, seed: u64) -> Self {\n        let save = hub::load_save().map(|t| Save::parse(&t)).unwrap_or_default();\n        let about = About::parse(&hub::about_text().unwrap_or_else(|| ABOUT.to_string()));\n        let shell = Shell::new(save, about);\n        hub::install_hook();\n        let mut pr = Product {\n            shell,\n            director: Director::default(),\n            device: Device::KeyboardMouse,\n            keys: HashSet::new(),\n            key_taps: HashSet::new(),\n            mouse: HashSet::new(),\n            mouse_taps: HashSet::new(),\n            cursor_px: Vec2::ZERO,\n            moved_px: 0.0,\n            wheel: 0.0,\n            tap: None,\n            any_event: false,\n            pads_prev: BTreeMap::new(),\n            pad_slots: BTreeMap::new(),\n            nav: [Repeat::default(); 4],\n            seen_device: false,\n            touch_device: hub::touch_only(),\n            keyboard_cursor: false,\n            rot_t: 0.0,\n            fps: 0.0,\n            fps_frames: 0,\n            fps_t: Instant::now(),\n            hub: HubState { active: hub::active(), ..Default::default() },\n            audio_seen_gesture: false,\n            paused: false,\n            scene: scene.to_string(),\n            snapshot: None,\n            cam_distance: 19.9,\n            last_beat: 0,\n            bot_steps: false,\n            fonts_done: false,\n            last_save_text: String::new(),\n            peaks: [0.0; 3],\n            seed,\n            frame_count: 0,\n        };\n        // A scene named directly (a test, a direct link) goes straight there.\n        pr.shell.screen = if pr.hub.active {\n            Screen::Card\n        } else if scene.contains(\"title\") {\n            Screen::Title\n        } else if scene.contains(\"attract\") {\n            Screen::Attract\n        } else {\n            Screen::Playing\n        };\n        if pr.hub.active {\n            pr.shell.session = true;\n            pr.shell.card = Some(CardInfo::default());\n        }\n        pr\n    }\n\n    fn apply_sim(g: &mut surgery::Surgery, shell: &Shell) {\n        g.tune = shell.tune;\n        g.diff = shell.difficulty();\n        g.tremor = shell.save.settings.tremor;\n        g.text_speed = shell.save.settings.text_speed;\n        g.auto_advance = shell.auto;\n        g.dev.immortal = shell.dev.immortal || g.mode == surgery::Mode::Attract;\n        g.dev.full_gift = shell.dev.full_gift || g.mode == surgery::Mode::Attract;\n        g.dev.freeze_timer = shell.dev.freeze_timer;\n        g.dev.one_hit = shell.dev.one_hit;\n        g.dev.bot_plays = shell.dev.bot_plays;\n    }\n}\n\nimpl App {\n    fn product_load(&mut self, pr: &mut Product, scene: &str) {\n        let Some(host) = &self.host else { return };\n        let name = scene.to_string();\n        let seed = pr.seed;\n        pr.seed = pr.seed.wrapping_add(1);\n        pr.scene = name.clone();\n        let tune_shell = pr.shell.tune;\n        let (diff, tremor, text_speed, auto) = (pr.shell.difficulty(), pr.shell.save.settings.tremor, pr.shell.save.settings.text_speed, pr.shell.auto);\n        let dev = pr.shell.dev.clone();\n        host.exec(move |sim| match Sim::new(&name, seed) {\n            Ok(mut fresh) => {\n                if let Some(g) = surgery::get_mut(&mut fresh) {\n                    g.tune = tune_shell;\n                    g.diff = diff;\n                    g.tremor = tremor;\n                    g.text_speed = text_speed;\n                    g.auto_advance = auto;\n                    g.dev.immortal |= dev.immortal;\n                    g.dev.full_gift |= dev.full_gift;\n                    g.dev.freeze_timer = dev.freeze_timer;\n                    g.dev.one_hit = dev.one_hit;\n                    g.dev.bot_plays = dev.bot_plays;\n                }\n                *sim = fresh;\n            }\n            Err(e) => log::error!(\"could not load scene: {e:#}\"),\n        });\n        if let Some(gfx) = &mut self.gfx {\n            gfx.renderer.clear_particles();\n        }\n        self.builder.clear_particles();\n    }\n\n    fn product_apply_audio(&self, pr: &Product) {\n        if let Some(a) = &self.audio {\n            let s = &pr.shell.save.settings;\n            a.set_master(1.0);\n            let ended = pr.hub.ended;\n            a.set_bus(BUS_MUSIC, if ended { 0.0 } else { s.music });\n            a.set_bus(BUS_EFFECTS, if ended { 0.0 } else { s.effects });\n            a.set_bus(BUS_VOICES, if ended { 0.0 } else { s.voices });\n        }\n    }\n\n    pub(crate) fn product_event(&mut self, el: &ActiveEventLoop, event: WindowEvent) {\n        let Some(mut pr) = self.product.take() else { return };\n        match event {\n            WindowEvent::CloseRequested => el.exit(),\n            WindowEvent::Focused(false) => {\n                pr.keys.clear();\n                pr.mouse.clear();\n            }\n            WindowEvent::Resized(sz) => {\n                if let Some(g) = &mut self.gfx {\n                    g.resize(sz.width, sz.height);\n                }\n            }\n            WindowEvent::RedrawRequested => {\n                self.product = Some(pr);\n                self.frame();\n                return;\n            }\n            WindowEvent::KeyboardInput { event, .. } => {\n                #[cfg(target_arch = \"wasm32\")]\n                self.resume_audio_again();\n                pr.audio_seen_gesture = true;\n                if let PhysicalKey::Code(code) = event.physical_key {\n                    match event.state {\n                        ElementState::Pressed => {\n                            if !event.repeat {\n                                pr.key_taps.insert(code);\n                            }\n                            pr.keys.insert(code);\n                        }\n                        ElementState::Released => {\n                            pr.keys.remove(&code);\n                        }\n                    }\n                    pr.device = Device::KeyboardMouse;\n                    pr.seen_device = true;\n                    pr.any_event = true;\n                }\n            }\n            WindowEvent::MouseInput { state, button, .. } => {\n                #[cfg(target_arch = \"wasm32\")]\n                self.resume_audio_again();\n                pr.audio_seen_gesture = true;\n                match state {\n                    ElementState::Pressed => {\n                        pr.mouse.insert(button);\n                        pr.mouse_taps.insert(button);\n                    }\n                    ElementState::Released => {\n                        pr.mouse.remove(&button);\n                    }\n                }\n                pr.device = Device::KeyboardMouse;\n                pr.any_event = true;\n                pr.keyboard_cursor = false;\n            }\n            WindowEvent::CursorMoved { position, .. } => {\n                let p = Vec2::new(position.x as f32, position.y as f32);\n                let d = (p - pr.cursor_px).length();\n                pr.cursor_px = p;\n                pr.moved_px += d;\n                if d > 2.0 {\n                    pr.device = Device::KeyboardMouse;\n                    pr.keyboard_cursor = false;\n                    pr.any_event = true;\n                }\n            }\n            WindowEvent::MouseWheel { delta, .. } => {\n                let lines = match delta {\n                    MouseScrollDelta::LineDelta(_, y) => y,\n                    MouseScrollDelta::PixelDelta(p) => p.y as f32 / 40.0,\n                };\n                pr.wheel += lines;\n                pr.any_event = true;\n                pr.device = Device::KeyboardMouse;\n            }\n            WindowEvent::Touch(t) => {\n                #[cfg(target_arch = \"wasm32\")]\n                self.resume_audio_again();\n                if matches!(t.phase, winit::event::TouchPhase::Started) {\n                    pr.tap = Some(Vec2::new(t.location.x as f32, t.location.y as f32));\n                    pr.any_event = true;\n                    pr.touch_device = pr.touch_device || !pr.seen_device;\n                }\n            }\n            _ => {}\n        }\n        self.product = Some(pr);\n    }\n\n    #[cfg(target_arch = \"wasm32\")]\n    fn resume_audio_again(&mut self) {\n        if let Some(a) = &self.audio {\n            a.resume();\n        }\n    }\n\n    /// A frame of the game.\n    pub(crate) fn product_frame(&mut self) {\n        let Some(mut pr) = self.product.take() else { return };\n        self.product_frame_inner(&mut pr);\n        self.product = Some(pr);\n    }\n\n    fn product_frame_inner(&mut self, pr: &mut Product) {\n        let now = Instant::now();\n        let dt = (now - self.last).as_secs_f32().min(0.1);\n        self.last = now;\n        pr.frame_count += 1;\n        pr.fps_frames += 1;\n        let since = pr.fps_t.elapsed().as_secs_f32();\n        if since > 0.5 {\n            pr.fps = pr.fps_frames as f32 / since;\n            pr.fps_frames = 0;\n            pr.fps_t = now;\n        }\n        if !pr.fonts_done {\n            pr.fonts_done = true;\n            style::install(&self.egui_ctx);\n            self.product_apply_audio(pr);\n        }\n\n        // Pads.\n        let (pads, pad_active) = match &mut self.input.gilrs {\n            Some(g) => read_pads(g, &mut pr.pads_prev),\n            None => (Vec::new(), false),\n        };\n        if pad_active {\n            pr.device = Device::Gamepad;\n            pr.seen_device = true;\n            pr.any_event = true;\n            if !pr.audio_seen_gesture {\n                #[cfg(target_arch = \"wasm32\")]\n                self.resume_audio_again();\n                // Browsers may not count a pad press as a gesture: say so on the title.\n                pr.shell.sound_note = true;\n            }\n        }\n        if pr.audio_seen_gesture {\n            pr.shell.sound_note = false;\n        }\n\n        let host = self.host.as_ref().unwrap();\n        host.pump();\n        let (prev, curr, curr_at, tick_wall) = host.frames();\n        let sf = curr.surgery.clone();\n        let alpha = ((now - curr_at).as_secs_f32() / tick_wall.max(1e-4)).clamp(0.0, 1.0);\n\n        // The camera.\n        let (w, h) = self.gfx.as_ref().unwrap().size();\n        let shot = sf.as_ref().map(|f| f.camera).unwrap_or_default();\n        let k = 1.0 - (-dt * 7.0).exp();\n        pr.cam_distance += (shot.distance - pr.cam_distance) * k;\n        if (shot.distance - pr.cam_distance).abs() > 8.0 {\n            pr.cam_distance = shot.distance;\n        }\n        self.rig.params = CameraParams {\n            tilt: shot.tilt,\n            yaw: shot.yaw,\n            distance: pr.cam_distance,\n            fov: shot.fov,\n            ortho: false,\n            follow_lag: 0.0,\n            height_offset: 0.0,\n        };\n        let focus = Vec3::from_array(shot.target);\n        self.rig.update(focus, dt);\n        self.rig.snap(focus);\n\n        // Menu input.\n        let scale = self.gfx.as_ref().unwrap().window.scale_factor() as f32;\n        let zoom = style::zoom_for(h as f32, scale);\n        self.egui_ctx.set_zoom_factor(zoom);\n        let ppp = zoom * scale;\n        let to_points = |p: Vec2| egui::pos2(p.x / ppp, p.y / ppp);\n        let tap_of = |k: &HashSet<KeyCode>, c: KeyCode| k.contains(&c);\n        let key_any = |ks: &[KeyCode]| ks.iter().any(|c| tap_of(&pr.key_taps, *c));\n        let pad_any = |b: u8| pads.iter().any(|p| p.pressed.contains(&b));\n        let held_dir = |ks: &[KeyCode], pad_dir: u8, axis: fn(Vec2) -> f32| {\n            ks.iter().any(|c| pr.keys.contains(c)) || pads.iter().any(|p| p.held.contains(&pad_dir) || axis(p.left) > 0.55)\n        };\n        let up = held_dir(&[KeyCode::ArrowUp, KeyCode::KeyW], UP, |v| v.y);\n        let down = held_dir(&[KeyCode::ArrowDown, KeyCode::KeyS], DOWN, |v| -v.y);\n        let left = held_dir(&[KeyCode::ArrowLeft, KeyCode::KeyA], LEFT, |v| -v.x);\n        let right = held_dir(&[KeyCode::ArrowRight, KeyCode::KeyD], RIGHT, |v| v.x);\n        let create_held = pads.iter().any(|p| p.held.contains(&CREATE));\n        let pointer = Some(to_points(pr.cursor_px));\n        let in_session = pr.shell.session;\n        let si = ShellInput {\n            up: pr.nav[0].tick(up, dt),\n            down: pr.nav[1].tick(down, dt),\n            left: pr.nav[2].tick(left, dt),\n            right: pr.nav[3].tick(right, dt),\n            confirm: key_any(&[KeyCode::Enter, KeyCode::Space, KeyCode::NumpadEnter]) || pad_any(CROSS),\n            back: key_any(&[KeyCode::Escape, KeyCode::Backspace]) || pad_any(CIRCLE),\n            tab_l: key_any(&[KeyCode::KeyQ, KeyCode::PageUp]) || pad_any(L1),\n            tab_r: key_any(&[KeyCode::KeyE, KeyCode::PageDown]) || pad_any(R1),\n            // Options is ignored while Create is held: that combination is the hub's.\n            options: !in_session && (key_any(&[KeyCode::Escape]) || (pad_any(OPTIONS) && !create_held)),\n            chart: key_any(&[KeyCode::Tab]) || pad_any(SQUARE),\n            auto_toggle: key_any(&[KeyCode::KeyF]) || pad_any(TRIANGLE),\n            pointer,\n            pointer_moved: pr.moved_px > 2.0,\n            click: pr.mouse_taps.contains(&MouseButton::Left),\n            pointer_down: pr.mouse.contains(&MouseButton::Left),\n            any: pr.any_event,\n            device: pr.device,\n            dt,\n            fps: pr.fps,\n            tps: host.shared.stats.lock().unwrap().tps,\n            touch_only: pr.touch_device && !pr.seen_device,\n            tap: pr.tap.map(to_points),\n        };\n\n        // Game input.\n        let f_opt = sf.as_deref();\n        if let Some(f) = f_opt {\n            let window = self.gfx.as_ref().unwrap().window.clone();\n            let in_op = f.stage == Stage::Op && pr.shell.wants_game_input() && pr.device == Device::KeyboardMouse && !pr.keyboard_cursor;\n            window.set_cursor_visible(!in_op);\n        }\n        let (aim_px, ground) = {\n            let size = Vec2::new(w as f32, h as f32);\n            (self.rig.ground_point(pr.cursor_px, size, 0.6), size)\n        };\n        let _ = ground;\n        let inputs = surgeon_inputs(pr, &pads, f_opt, aim_px.map(|p| Vec2::new(p.x, p.z)), dt);\n        let local_slot = if pr.hub.active { pr.hub.me } else { 0 };\n        pr.shell.local = local_slot.min(3);\n        let local_aim = inputs[local_slot.min(3)].abs.then_some(inputs[local_slot.min(3)].aim);\n        {\n            let mut i = host.shared.input.lock().unwrap();\n            let want = pr.shell.wants_game_input();\n            for k in 0..4 {\n                let mut s = if want { inputs[k] } else { SurgeonInput::default() };\n                if pr.hub.active && pr.hub.is_host && k != pr.hub.me {\n                    s = pr.hub.remote[k];\n                }\n                if pr.hub.active && pr.hub.server {\n                    s = pr.hub.remote[k];\n                }\n                let keep_pressed = i.surgeons[k].pressed;\n                let keep_tool = i.surgeons[k].tool;\n                let keep_cycle = i.surgeons[k].cycle;\n                i.surgeons[k] = s;\n                i.surgeons[k].pressed |= keep_pressed;\n                if s.tool == 0 {\n                    i.surgeons[k].tool = keep_tool;\n                }\n                if s.cycle == 0 {\n                    i.surgeons[k].cycle = keep_cycle;\n                }\n            }\n        }\n        if pr.hub.active {\n            for k in 0..4 {\n                pr.hub.remote[k].pressed = 0;\n                pr.hub.remote[k].tool = 0;\n                pr.hub.remote[k].cycle = 0;\n            }\n        }\n\n        // Test hook: ticks and commands.\n        let steps = hub::take_steps();\n        if steps > 0 {\n            let bot = pr.bot_steps;\n            host.exec(move |sim| {\n                for _ in 0..steps {\n                    let input = if bot { sim.bot_input() } else { Default::default() };\n                    sim.step(&input);\n                    sim.drain_events();\n                }\n            });\n        }\n\n        // Effects and sound.\n        self.builder.now = self.started.elapsed().as_secs_f64();\n        let events: Vec<SimEvent> = std::mem::take(&mut *host.shared.events.lock().unwrap());\n        self.builder.add_events(&events);\n        if let Some(a) = &self.audio {\n            let (_, right) = self.rig.ground_axes();\n            let l = Listener { pos: Vec3::new(0.0, 0.0, 0.0), right };\n            for e in &events {\n                a.play_event(e, &l, 1.0);\n            }\n        }\n        if pr.hub.active && pr.hub.is_host {\n            for e in &events {\n                if let SimEvent::Cue { id, pos, gain, pitch } = e {\n                    // Heartbeats are every client's own to hear from the frame; others travel.\n                    if *id != cue::MONITOR {\n                        pr.hub.cue_serial += 1;\n                        let c = NetCue { serial: pr.hub.cue_serial, id: *id, at: Vec2::new(pos.x, pos.z), gain: *gain, pitch: *pitch };\n                        pr.hub.pending_cues.push(c);\n                    }\n                }\n            }\n            let n = pr.hub.pending_cues.len();\n            if n > 8 {\n                pr.hub.pending_cues.drain(..n - 8);\n            }\n        }\n        if let (Some(f), Some(a)) = (f_opt, self.audio.as_mut()) {\n            if !pr.hub.ended && !pr.paused {\n                pr.director.update(a, f, dt);\n            }\n            let got = a.take_peaks();\n            for k in 0..3 {\n                pr.peaks[k] = (pr.peaks[k] * 0.9).max(got[k]);\n            }\n        }\n        // Rumble: on the beat when vitals are low; on tool contact.\n        if let Some(f) = f_opt {\n            if pr.shell.save.settings.rumble && pr.device == Device::Gamepad && f.stage == Stage::Op && pr.frame_count % 2 == 0 {\n                if f.beats != pr.last_beat {\n                    pr.last_beat = f.beats;\n                    if f.vitals < 45.0 {\n                        hub::rumble(0, 120.0, 0.2, 0.2 + f.crisis * 0.6);\n                    }\n                }\n                if f.slots.first().is_some_and(|s| s.eng != 0) {\n                    hub::rumble(0, 40.0, 0.25, 0.0);\n                }\n            }\n        }\n\n        // The look: hub servers skip all of it.\n        let server = pr.hub.active && pr.hub.server;\n        {\n            let s = &pr.shell.save.settings;\n            self.builder.surgery.looks = pav_view::surgery::Looks { clinical: s.clinical, reduce_flashes: s.reduce_flashes, no_shake: !s.shake, headless: server };\n            self.builder.surgery.local_cursor = local_aim.map(|a| (local_slot.min(3), a));\n        }\n        let view = self.view.clone();\n        let mut scene = self.builder.build(&prev, &curr, alpha, &self.rig, w as f32 / h.max(1) as f32, &view, focus);\n        if let Some(gfx) = &mut self.gfx {\n            gfx.renderer.render_scale = 1.0;\n        }\n\n        // The UI.\n        let vp = Mat4::from(scene.camera.proj * scene.camera.view);\n        let gfx = self.gfx.as_mut().unwrap();\n        let state = self.egui_state.as_mut().unwrap();\n        let raw = state.take(&gfx.window);\n        let shell = &mut pr.shell;\n        let f_ref = sf.as_deref();\n        let out = self.egui_ctx.run_ui(raw, |ui| {\n            shell.ui(ui.ctx(), &si, f_ref, vp);\n        });\n        state.platform_output(&gfx.window, out.platform_output);\n        let pixels = out.pixels_per_point;\n        let prims = self.egui_ctx.tessellate(out.shapes, pixels);\n        let mut textures = out.textures_delta;\n        if server {\n            scene.dynamic.clear();\n            scene.meshes.clear();\n            scene.sdfs.clear();\n        }\n        gfx.draw(&scene, Some((&prims, &mut textures, pixels)));\n\n        // Clear this frame's edges.\n        pr.key_taps.clear();\n        pr.mouse_taps.clear();\n        pr.moved_px = 0.0;\n        pr.wheel = 0.0;\n        pr.tap = None;\n        pr.any_event = false;\n\n        self.product_commands(pr);\n        self.product_hub(pr, f_opt, &pads, &inputs);\n        self.product_hook(pr, &curr);\n        // The first frame: tell the hub we're loaded.\n        if pr.hub.active && !pr.hub.ready_sent && pr.hub.info.is_some() {\n            pr.hub.ready_sent = true;\n            hub::ready();\n        }\n    }\n\n    fn product_commands(&mut self, pr: &mut Product) {\n        let cmds = std::mem::take(&mut pr.shell.cmds);\n        for c in cmds {\n            let Some(host) = &self.host else { return };\n            let surgery_do = |f: Box<dyn FnOnce(&mut surgery::Surgery) + Send>| {\n                host.exec(move |sim| {\n                    if let Some(g) = surgery::get_mut(sim) {\n                        f(g);\n                    }\n                });\n            };\n            match c {\n                Cmd::Load(s) => self.product_load(pr, &s),\n                Cmd::Paused(p) => {\n                    pr.paused = p;\n                    host.set_control(|c| {\n                        c.paused = p;\n                    });\n                }\n                Cmd::Apply => {\n                    self.product_apply_audio(pr);\n                    let (tremor, speed) = (pr.shell.save.settings.tremor, pr.shell.save.settings.text_speed);\n                    surgery_do(Box::new(move |g| {\n                        g.tremor = tremor;\n                        g.text_speed = speed;\n                    }));\n                }\n                Cmd::Save => {\n                    if let Ok(text) = serde_json::to_string(&pr.shell.save) {\n                        if text != pr.last_save_text {\n                            hub::store_save(&text);\n                            pr.last_save_text = text;\n                        }\n                    }\n                }\n                Cmd::Tune(k, v) => surgery_do(Box::new(move |g| {\n                    g.tune.set(k, v);\n                })),\n                Cmd::ResetTune => surgery_do(Box::new(|g| g.tune = Default::default())),\n                Cmd::Flag(k, v) => surgery_do(Box::new(move |g| match k {\n                    \"immortal\" => g.dev.immortal = v,\n                    \"freeze_timer\" => g.dev.freeze_timer = v,\n                    \"full_gift\" => g.dev.full_gift = v,\n                    \"one_hit\" => g.dev.one_hit = v,\n                    \"bot_plays\" => g.dev.bot_plays = v,\n                    _ => {}\n                })),\n                Cmd::Jump(case, phase) => {\n                    let scene = format!(\"surgery/case/{case}/{phase}\");\n                    self.product_load(pr, &scene);\n                }\n                Cmd::SkipPhase => surgery_do(Box::new(|g| g.skip_phase())),\n                Cmd::WinCase => surgery_do(Box::new(|g| g.win_case())),\n                Cmd::ForceCode => surgery_do(Box::new(|g| g.force_code())),\n                Cmd::KillPatient => surgery_do(Box::new(|g| g.kill_patient())),\n                Cmd::Spawn(k) => surgery_do(Box::new(move |g| g.spawn_hazard(k))),\n                Cmd::RetryCheckpoint => surgery_do(Box::new(|g| g.retry_checkpoint())),\n                Cmd::RetryStart => surgery_do(Box::new(|g| g.retry_start())),\n                Cmd::TimeScale(v) => host.set_control(|c| c.speed = v),\n                Cmd::FrameStep => host.set_control(|c| c.step_requests += 1),\n                Cmd::Rewind => host.exec(|sim| {\n                    let t = sim.state.tick.saturating_sub(300);\n                    let oldest = sim.history.oldest_tick().unwrap_or(t);\n                    sim.rewind_to(t.max(oldest));\n                    sim.commit_rewind();\n                }),\n                Cmd::SnapSave => {\n                    pr.snapshot = host.query(|sim| sim.snapshot());\n                }\n                Cmd::SnapLoad => {\n                    if let Some(s) = pr.snapshot.clone() {\n                        host.exec(move |sim| sim.restore(s));\n                    }\n                }\n                Cmd::Reload => {\n                    #[cfg(not(target_arch = \"wasm32\"))]\n                    if let Err(e) = pav_core::games::surgery::content::reload() {\n                        log::error!(\"{e:#}\");\n                        pr.shell.stats_line = format!(\"{e:#}\");\n                    } else {\n                        pr.shell.stats_line = \"content reloaded\".into();\n                    }\n                }\n                Cmd::Difficulty(d) => {\n                    let d = Difficulty::from_name(&d).unwrap_or_default();\n                    surgery_do(Box::new(move |g| g.diff = d));\n                }\n                Cmd::Cue(id) => {\n                    if let Some(a) = &self.audio {\n                        a.play_event(&SimEvent::Cue { id, pos: Vec3::ZERO, gain: 1.0, pitch: 1.0 }, &Listener::default(), 1.0);\n                    }\n                }\n                Cmd::Fullscreen(_) => {\n                    if let Some(g) = &self.gfx {\n                        crate::platform::toggle_fullscreen(&g.window);\n                    }\n                }\n                Cmd::Auto(on) => surgery_do(Box::new(move |g| g.auto_advance = on)),\n                Cmd::Quit => self.quit = true,\n            }\n        }\n    }\n\n    fn product_hook(&mut self, pr: &mut Product, curr: &pav_core::RenderFrame) {\n        for text in hub::take_dos() {\n            let Ok(v) = serde_json::from_str::<Value>(&text) else { continue };\n            let Some(host) = &self.host else { continue };\n            if let Some(s) = v.get(\"load\").and_then(|x| x.as_str()) {\n                let s = s.to_string();\n                self.product_load(pr, &s);\n                pr.shell.screen = if s.contains(\"title\") { Screen::Title } else { Screen::Playing };\n            }\n            if let Some(b) = v.get(\"bot\").and_then(|x| x.as_bool()) {\n                pr.bot_steps = b;\n            }\n            if let Some(n) = v.get(\"screen\").and_then(|x| x.as_str()) {\n                pr.shell.screen = match n {\n                    \"menu\" => Screen::Menu,\n                    \"settings\" => Screen::Settings,\n                    \"about\" => Screen::About,\n                    \"pause\" => Screen::Pause,\n                    \"dev\" => Screen::Dev,\n                    \"playing\" => Screen::Playing,\n                    \"cases\" => Screen::Cases,\n                    \"controls\" => Screen::Controls,\n                    _ => Screen::Title,\n                };\n                pr.shell.focus = 0;\n                pr.shell.page = 0;\n            }\n            if let Some(p) = v.get(\"page\").and_then(|x| x.as_u64()) {\n                pr.shell.page = p as usize;\n            }\n            if let Some(b) = v.get(\"paused\").and_then(|x| x.as_bool()) {\n                pr.paused = b;\n                host.set_control(|c| c.paused = b);\n            }\n            if let Some(b) = v.get(\"dev_live\").and_then(|x| x.as_bool()) {\n                pr.shell.dev.live = b;\n            }\n            if let Some(b) = v.get(\"immortal\").and_then(|x| x.as_bool()) {\n                host.exec(move |sim| {\n                    if let Some(g) = surgery::get_mut(sim) {\n                        g.dev.immortal = b;\n                    }\n                });\n            }\n            if let Some(a) = v.get(\"advance\").and_then(|x| x.as_u64()) {\n                // Hold the game's clock, drive so many ticks of bot.\n                let n = a as u32;\n                host.exec(move |sim| {\n                    for _ in 0..n {\n                        let input = sim.bot_input();\n                        sim.step(&input);\n                        sim.drain_events();\n                    }\n                });\n            }\n        }\n        // What's going on, for tests.\n        if pr.frame_count % 2 == 0 || hub::active() {\n            let sim_status = curr.surgery.as_ref().map(|f| {\n                json!({\n                    \"stage\": format!(\"{:?}\", f.stage),\n                    \"case\": f.case,\n                    \"phase\": f.phase,\n                    \"vitals\": f.vitals,\n                    \"bpm\": f.bpm,\n                    \"timer\": f.timer,\n                    \"hazards\": f.hazards.len(),\n                    \"tool\": f.slots.first().map(|s| s.tool),\n                    \"ring_pos\": f.slots.first().map(|s| s.ring_pos),\n                    \"using\": f.slots.first().map(|s| s.using),\n                    \"pressure\": f.slots.first().map(|s| s.pressure),\n                    \"cursor\": f.slots.first().map(|s| [s.cursor.x, s.cursor.y]),\n                    \"cursors\": f.slots.iter().map(|s| json!([s.active, s.cursor.x, s.cursor.y])).collect::<Vec<_>>(),\n                    \"demo\": f.demo,\n                    \"music\": f.music,\n                    \"tick\": f.tick,\n                    \"beats\": f.beats,\n                })\n            });\n            let s = &pr.shell.save.settings;\n            let status = json!({\n                \"title\": pav_ui::surgery::TITLE,\n                \"scene\": pr.scene,\n                \"device\": match pr.device { Device::Gamepad => \"pad\", Device::Touch => \"touch\", Device::KeyboardMouse => \"keys\" },\n                \"shell\": pr.shell.status(),\n                \"sim\": sim_status,\n                \"bus\": { \"music\": s.music, \"effects\": s.effects, \"voices\": s.voices },\n                \"peaks\": pr.peaks,\n                \"audio_device\": self.audio.is_some(),\n                \"paused\": pr.paused,\n                \"fps\": pr.fps,\n                \"frames\": pr.frame_count,\n                \"outcome\": match curr.surgery.as_ref().map(|f| f.stage) { Some(Stage::Done) => \"won\", Some(Stage::Dead) => \"lost\", _ => \"playing\" },\n                \"hub\": {\n                    \"active\": pr.hub.active,\n                    \"me\": pr.hub.me,\n                    \"host\": pr.hub.is_host,\n                    \"server\": pr.hub.server,\n                    \"playing\": pr.hub.playing,\n                    \"ended\": pr.hub.ended,\n                    \"received\": pr.hub.received,\n                    \"sent\": pr.hub.sent,\n                    \"snapshot\": pr.hub.snapshot_size,\n                },\n            });\n            hub::set_status(&status);\n        }\n    }\n\n    fn product_hub(&mut self, pr: &mut Product, f: Option<&SurgeryFrame>, pads: &[PadNow], inputs: &[SurgeonInput; 4]) {\n        if !pr.hub.active {\n            return;\n        }\n        pr.hub.frames += 1;\n        // Connection.\n        if pr.hub.info.is_none() {\n            match hub::info() {\n                Some(Value::Null) => {\n                    // No hub after all: run as on its own.\n                    pr.hub.active = false;\n                    pr.shell.session = false;\n                    pr.shell.card = None;\n                    pr.shell.screen = Screen::Title;\n                }\n                Some(info) => {\n                    pr.hub.me = info.get(\"me\").and_then(|v| v.as_u64()).unwrap_or(0) as usize;\n                    pr.hub.is_host = info.get(\"isHost\").and_then(|v| v.as_bool()).unwrap_or(false);\n                    pr.hub.server = info.get(\"server\").and_then(|v| v.as_bool()).unwrap_or(false);\n                    pr.seed = info.get(\"seed\").and_then(|v| v.as_u64()).unwrap_or(1);\n                    if let Some(list) = info.get(\"players\").and_then(|v| v.as_array()) {\n                        pr.hub.players = list\n                            .iter()\n                            .map(|p| (p.get(\"id\").and_then(|x| x.as_u64()).unwrap_or(0) as usize, p.get(\"name\").and_then(|x| x.as_str()).unwrap_or(\"\").to_string()))\n                            .collect();\n                        for (id, name) in &pr.hub.players {\n                            if *id < 4 {\n                                pr.shell.names[*id] = name.clone();\n                            }\n                        }\n                    }\n                    let card = pr.shell.card.get_or_insert_with(CardInfo::default);\n                    card.players = pr.hub.players.iter().map(|(_, n)| (n.clone(), false)).collect();\n                    card.me = pr.hub.me;\n                    pr.hub.info = Some(info);\n                    // The card scene: a beating heart behind the board.\n                    self.product_load(pr, \"surgery/card\");\n                }\n                None => {}\n            }\n        }\n        if pr.hub.info.is_none() {\n            return;\n        }\n        // The card's answers.\n        if !pr.hub.started {\n            let card_ready = pads.iter().any(|p| p.pressed.contains(&CROSS));\n            let more = pads.iter().any(|p| p.pressed.contains(&TRIANGLE)) || self.input_taps_more(pr);\n            if card_ready {\n                hub::answer(\"ready\");\n            }\n            if more {\n                hub::answer(\"more\");\n            }\n            if pr.key_taps_touch_ready() {\n                hub::answer(\"ready\");\n            }\n        }\n        // Events.\n        for ev in hub::poll() {\n            let name = ev.get(0).and_then(|v| v.as_str()).unwrap_or(\"\");\n            let data = ev.get(1).cloned().unwrap_or(Value::Null);\n            match name {\n                \"card\" => {\n                    let card = pr.shell.card.get_or_insert_with(CardInfo::default);\n                    card.left = data.get(\"left\").and_then(|v| v.as_f64()).map(|m| m as f32 / 1000.0);\n                    card.paused = data.get(\"paused\").and_then(|v| v.as_bool()).unwrap_or(false);\n                    card.starting = data.get(\"starting\").and_then(|v| v.as_bool()).unwrap_or(false);\n                    card.asked = data.get(\"asked\").and_then(|v| v.as_bool()).unwrap_or(false);\n                    let ready: Vec<usize> = data.get(\"ready\").and_then(|v| v.as_array()).map(|a| a.iter().filter_map(|x| x.as_u64().map(|n| n as usize)).collect()).unwrap_or_default();\n                    pr.hub.ready_ids = ready.clone();\n                    card.players = pr.hub.players.iter().map(|(id, n)| (n.clone(), ready.contains(id))).collect();\n                }\n                \"start\" => {\n                    pr.hub.started = true;\n                    let scene = if pr.hub.is_host { \"surgery/codeblue\" } else { \"surgery/mirror\" };\n                    self.product_load(pr, scene);\n                    if let Some(host) = &self.host {\n                        host.set_control(|c| c.paused = true);\n                        let ids: Vec<usize> = pr.hub.players.iter().map(|(id, _)| *id).collect();\n                        let server = pr.hub.server;\n                        let is_host = pr.hub.is_host;\n                        if is_host {\n                            host.exec(move |sim| {\n                                if let Some(g) = surgery::get_mut(sim) {\n                                    g.no_local = server;\n                                    if let Some(op) = &mut g.op {\n                                        for (i, s) in op.slots.iter_mut().enumerate() {\n                                            s.active = ids.contains(&i);\n                                            s.bot = false;\n                                        }\n                                    }\n                                }\n                            });\n                        }\n                    }\n                    #[cfg(target_arch = \"wasm32\")]\n                    self.resume_audio_again();\n                }\n                \"message\" => {\n                    let from = ev.get(2).and_then(|v| v.as_u64()).unwrap_or(0) as usize;\n                    pr.hub.received += 1;\n                    if pr.hub.is_host {\n                        if let Some(inp) = net::decode_input(&data) {\n                            if from < 4 {\n                                let old = pr.hub.remote[from];\n                                pr.hub.remote[from] = inp;\n                                pr.hub.remote[from].pressed |= old.pressed;\n                            }\n                        }\n                    } else if let Some(frame) = net::decode(&data) {\n                        let cues = net::decode_cues(&data);\n                        let arc = std::sync::Arc::new(frame);\n                        if let Some(host) = &self.host {\n                            host.exec(move |sim| {\n                                if let Some(g) = surgery::get_mut(sim) {\n                                    g.mirror_frame = Some(arc);\n                                }\n                            });\n                        }\n                        if let Some(a) = &self.audio {\n                            let l = Listener::default();\n                            for c in cues {\n                                if c.serial > pr.hub.seen_serial {\n                                    pr.hub.seen_serial = c.serial;\n                                    a.play_event(&SimEvent::Cue { id: c.id, pos: Vec3::new(c.at.x, 0.3, c.at.y), gain: c.gain, pitch: c.pitch }, &l, 1.0);\n                                }\n                            }\n                        }\n                    }\n                }\n                \"leave\" => {\n                    let id = data.get(\"id\").and_then(|v| v.as_u64()).unwrap_or(99) as usize;\n                    pr.hub.left.push(id);\n                    if let Some(c) = &mut pr.shell.card {\n                        c.players.retain(|(n, _)| Some(n) != pr.hub.players.iter().find(|(i, _)| *i == id).map(|(_, n)| n));\n                    }\n                    if pr.hub.is_host {\n                        if let Some(host) = &self.host {\n                            host.exec(move |sim| {\n                                if let Some(g) = surgery::get_mut(sim) {\n                                    if let Some(op) = &mut g.op {\n                                        if id < 4 {\n                                            op.slots[id].active = false;\n                                        }\n                                    }\n                                }\n                            });\n                        }\n                    }\n                }\n                \"end\" => {\n                    pr.hub.ended = true;\n                    self.product_apply_audio(pr);\n                }\n                _ => {}\n            }\n        }\n        // The countdown.\n        if pr.hub.started && !pr.hub.playing {\n            let t = hub::time();\n            if t >= 0.0 {\n                pr.hub.playing = true;\n                pr.shell.screen = Screen::Playing;\n                if let Some(c) = &mut pr.shell.card {\n                    c.playing = true;\n                }\n                if let Some(host) = &self.host {\n                    host.set_control(|c| c.paused = false);\n                }\n            } else if let Some(c) = &mut pr.shell.card {\n                c.countdown = if t.is_finite() { Some((-t / 1000.0) as f32) } else { None };\n            }\n        }\n        if pr.hub.ended || !pr.hub.playing {\n            return;\n        }\n        pr.hub.send_t += 1.0 / pr.fps.max(1.0);\n        let period = 1.0 / 15.0;\n        let dt_now = 0.0;\n        let _ = dt_now;\n        if pr.hub.is_host {\n            let Some(f) = f else { return };\n            if pr.hub.send_t >= period {\n                pr.hub.send_t = 0.0;\n                let v = net::encode(f, &pr.hub.pending_cues);\n                pr.hub.snapshot_size = v.to_string().len();\n                hub::send(&v);\n                pr.hub.sent += 1;\n            }\n            pr.hub.publish_t += 1.0 / pr.fps.max(1.0);\n            let done = matches!(f.stage, Stage::Results | Stage::Done | Stage::Dead);\n            if pr.hub.publish_t > 1.0 || done {\n                pr.hub.publish_t = 0.0;\n                let won = !matches!(f.stage, Stage::Dead);\n                let out = standings(&pr.hub.players, &pr.hub.left, f, won);\n                hub::publish(&out);\n                if done && !pr.hub.finished {\n                    pr.hub.finished = true;\n                    hub::finish(&out);\n                }\n            }\n        } else if pr.hub.send_t >= period {\n            pr.hub.send_t = 0.0;\n            let mine = inputs[pr.hub.me.min(3)];\n            hub::send(&net::encode_input(&mine));\n            pr.hub.sent += 1;\n        }\n    }\n\n    fn input_taps_more(&self, pr: &Product) -> bool {\n        pr.more_key\n    }\n}\n\nimpl Product {\n    fn key_taps_touch_ready(&self) -> bool {\n        self.ready_tap\n    }\n}\n\nfn standings(players: &[(usize, String)], left: &[usize], f: &SurgeryFrame, won: bool) -> Value {\n    let mut order: Vec<(usize, i64, u32)> = players\n        .iter()\n        .filter(|(id, _)| !left.contains(id))\n        .map(|(id, _)| {\n            let s = f.slots.get(*id);\n            (*id, s.map(|x| x.score).unwrap_or(0), s.map(|x| x.chain).unwrap_or(0))\n        })\n        .collect();\n    order.sort_by_key(|(_, score, _)| std::cmp::Reverse(*score));\n    let list: Vec<Value> = order.iter().map(|(id, _, _)| json!([id])).collect();\n    let mut scores = serde_json::Map::new();\n    let mut stats = serde_json::Map::new();\n    for (id, score, chain) in &order {\n        scores.insert(id.to_string(), json!(score));\n        stats.insert(id.to_string(), json!({ \"Chain\": chain, \"Vitals left\": f.vitals as i32 }));\n    }\n    let awards: Vec<Value> = order.first().map(|(id, _, _)| json!({ \"id\": id, \"title\": \"Immaculate Hands\", \"detail\": \"Most points on the table\" })).into_iter().collect();\n    json!({ \"standings\": list, \"scores\": scores, \"won\": won, \"stats\": stats, \"awards\": awards })\n}\n\n/// Builds each seat's input from the devices.\nfn surgeon_inputs(pr: &mut Product, pads: &[PadNow], f: Option<&SurgeryFrame>, mouse_aim: Option<Vec2>, dt: f32) -> [SurgeonInput; 4] {\n    let mut out: [SurgeonInput; 4] = Default::default();\n    let code = f.is_some_and(|x| x.code.is_some());\n    let stage = f.map(|x| x.stage);\n    let in_op = stage == Some(Stage::Op);\n    let holding_bone = |slot: usize| f.and_then(|x| x.slots.get(slot)).is_some_and(|s| s.eng == 10);\n\n    // Pads: the first plays seat 0; any unassigned pad joins with Cross.\n    for p in pads {\n        if !pr.pad_slots.contains_key(&p.index) {\n            if p.index == 0 {\n                pr.pad_slots.insert(0, 0);\n            } else if p.pressed.contains(&CROSS) && in_op {\n                let taken: Vec<usize> = pr.pad_slots.values().copied().collect();\n                if let Some(free) = (1..4).find(|s| !taken.contains(s)) {\n                    pr.pad_slots.insert(p.index, free);\n                }\n            }\n        }\n    }\n    let solo_seat = if pr.hub.active { pr.hub.me.min(3) } else { 0 };\n    for p in pads {\n        let Some(&slot) = pr.pad_slots.get(&p.index) else { continue };\n        let slot = if pr.hub.active { if p.index == 0 { solo_seat } else { continue } } else { slot };\n        // Pad 0 shares seat 0 with the keyboard: it plays when it was used last.\n        if slot == solo_seat && pr.device != Device::Gamepad {\n            continue;\n        }\n        let mut s = SurgeonInput { active: true, abs: false, ..Default::default() };\n        s.aim = Vec2::new(p.right.x, -p.right.y);\n        let cross = p.held.contains(&CROSS);\n        let use_ = p.r2 > 0.08 || cross;\n        if code {\n            if p.l2 > 0.3 && p.r2 > 0.3 {\n                s.held |= btn::DEFIB;\n            }\n        } else if use_ {\n            s.held |= btn::USE;\n            s.pressure = if cross { 1.0 } else { p.r2 };\n        }\n        if p.l2 > 0.3 && !code {\n            s.held |= btn::PRECISION;\n        }\n        if p.held.contains(&CIRCLE) {\n            s.held |= btn::CANCEL;\n        }\n        if p.held.contains(&TRIANGLE) && in_op {\n            s.held |= btn::GIFT;\n        }\n        if p.flick_new {\n            if let Some(k) = p.flick {\n                s.tool = k + 1;\n            }\n        }\n        if holding_bone(slot) {\n            if p.held.contains(&L1) {\n                s.held |= btn::ROT_L;\n            }\n            if p.held.contains(&R1) {\n                s.held |= btn::ROT_R;\n            }\n        } else {\n            if p.pressed.contains(&L1) {\n                s.cycle = -1;\n            }\n            if p.pressed.contains(&R1) {\n                s.cycle = 1;\n            }\n        }\n        // Story, chart, results and retry.\n        if !in_op {\n            if cross {\n                s.held |= btn::ADVANCE;\n            }\n            if p.pressed.contains(&CROSS) {\n                s.pressed |= btn::ADVANCE;\n            }\n            if p.pressed.contains(&CIRCLE) {\n                s.pressed |= btn::CANCEL;\n            }\n        }\n        out[slot] = s;\n    }\n\n    // Keyboard and mouse: seat 0 (or this copy's seat in a session).\n    if pr.device == Device::KeyboardMouse {\n        let k = |c: KeyCode| pr.keys.contains(&c);\n        let mut s = SurgeonInput { active: true, ..Default::default() };\n        let axis = Vec2::new(\n            (k(KeyCode::KeyD) || k(KeyCode::ArrowRight)) as i32 as f32 - (k(KeyCode::KeyA) || k(KeyCode::ArrowLeft)) as i32 as f32,\n            (k(KeyCode::KeyS) || k(KeyCode::ArrowDown)) as i32 as f32 - (k(KeyCode::KeyW) || k(KeyCode::ArrowUp)) as i32 as f32,\n        );\n        if axis != Vec2::ZERO {\n            pr.keyboard_cursor = true;\n        }\n        if pr.keyboard_cursor {\n            s.abs = false;\n            s.aim = axis.normalize_or_zero() * 0.82;\n        } else if let Some(a) = mouse_aim {\n            s.abs = true;\n            s.aim = a;\n        }\n        let left = pr.mouse.contains(&MouseButton::Left);\n        let right = pr.mouse.contains(&MouseButton::Right);\n        let on_tray = mouse_aim.is_some_and(|a| a.y > TRAY_Z) && !pr.keyboard_cursor;\n        // Click an instrument on the tray.\n        if pr.mouse_taps.contains(&MouseButton::Left) && on_tray {\n            if let Some(a) = mouse_aim {\n                let near = (0..8).min_by(|x, y| tray_slot(*x).distance(a).total_cmp(&tray_slot(*y).distance(a)));\n                if let Some(n) = near {\n                    s.tool = n as u8 + 1;\n                }\n            }\n        }\n        let use_key = k(KeyCode::KeyE);\n        if code {\n            if left && right {\n                s.held |= btn::DEFIB;\n            }\n        } else if (left && !on_tray) || use_key {\n            s.held |= btn::USE;\n            s.pressure = 1.0;\n        }\n        if k(KeyCode::ShiftLeft) || k(KeyCode::ShiftRight) {\n            s.held |= btn::PRECISION;\n        }\n        if (right && !code) || k(KeyCode::KeyQ) {\n            s.held |= btn::CANCEL;\n        }\n        if k(KeyCode::Space) && in_op {\n            s.held |= btn::GIFT;\n        }\n        for (i, c) in [KeyCode::Digit1, KeyCode::Digit2, KeyCode::Digit3, KeyCode::Digit4, KeyCode::Digit5, KeyCode::Digit6, KeyCode::Digit7, KeyCode::Digit8].iter().enumerate() {\n            if pr.key_taps.contains(c) {\n                s.tool = i as u8 + 1;\n            }\n        }\n        let slot = solo_seat;\n        pr.rot_t = (pr.rot_t - dt).max(0.0);\n        if pr.wheel != 0.0 {\n            if holding_bone(slot) {\n                pr.rot_t = 0.14;\n                pr.rot_dir = pr.wheel.signum();\n            } else {\n                s.cycle = if pr.wheel > 0.0 { -1 } else { 1 };\n            }\n        }\n        if pr.rot_t > 0.0 {\n            s.held |= if pr.rot_dir > 0.0 { btn::ROT_R } else { btn::ROT_L };\n        }\n        if !in_op {\n            let adv = k(KeyCode::Enter) || k(KeyCode::Space) || k(KeyCode::NumpadEnter) || left;\n            if adv {\n                s.held |= btn::ADVANCE;\n            }\n            if pr.key_taps.contains(&KeyCode::Enter) || pr.key_taps.contains(&KeyCode::Space) || pr.key_taps.contains(&KeyCode::NumpadEnter) || pr.mouse_taps.contains(&MouseButton::Left) {\n                s.pressed |= btn::ADVANCE;\n            }\n            if pr.key_taps.contains(&KeyCode::Backspace) || pr.mouse_taps.contains(&MouseButton::Right) {\n                s.pressed |= btn::CANCEL;\n            }\n        }\n        out[slot] = s;\n    }\n    pr.more_key = pr.key_taps.contains(&KeyCode::KeyM);\n    pr.ready_tap = pr.tap.is_some() || pr.mouse_taps.contains(&MouseButton::Left);\n    out\n}\n\n/// What this app's Outcome means, for logs.\n#[allow(dead_code)]\nfn outcome_name(o: Outcome) -> &'static str {\n    match o {\n        Outcome::Won => \"won\",\n        Outcome::Lost => \"lost\",\n        Outcome::Playing => \"playing\",\n    }\n}\nEOF\npython3 - <<'EOF'\np='crates/pav_app/src/product.rs'; s=open(p).read()\ns=s.replace('''    seed: u64,\n    frame_count: u64,\n}\n\nimpl Product {''','''    seed: u64,\n    frame_count: u64,\n    rot_dir: f32,\n    more_key: bool,\n    ready_tap: bool,\n}\n\nimpl Product {''')\ns=s.replace('''            seed,\n            frame_count: 0,\n        };''','''            seed,\n            frame_count: 0,\n            rot_dir: 1.0,\n            more_key: false,\n            ready_tap: false,\n        };''')\nopen(p,'w').write(s)\np='crates/pav_app/src/main.rs'; s=open(p).read()\ns=s.replace(\"mod hud;\\n\",\"mod hub;\\nmod hud;\\n\").replace(\"mod platform;\\n\",\"mod platform;\\nmod product;\\n\")\nopen(p,'w').write(s)\np='crates/pav_app/src/app.rs'; s=open(p).read()\ns=s.replace('''    init_started: bool,\n    pub fatal: Option<String>,\n}\n\nimpl App {\n    fn new(settings: Settings) -> Self {\n        let scene_name = settings.scene.clone();''','''    init_started: bool,\n    pub fatal: Option<String>,\n    /// The surgery game's own frame path (`product.rs`).\n    pub(crate) product: Option<crate::product::Product>,\n}\n\nimpl App {\n    fn new(settings: Settings) -> Self {\n        let scene_name = settings.scene.clone();\n        let product = settings.scene.starts_with(\"surgery\").then(|| crate::product::Product::new(&settings.scene, settings.seed));''')\ns=s.replace('''            fatal: None,\n            settings,\n        };''','''            fatal: None,\n            product,\n            settings,\n        };''')\ns=s.replace('''            let mut attrs = Window::default_attributes().with_title(\"Shardfall\");''','''            let title = if self.product.is_some() { pav_ui::surgery::TITLE } else { \"Shardfall\" };\n            let mut attrs = Window::default_attributes().with_title(title);''')\ns=s.replace('''    fn frame(&mut self) {\n        if self.gfx.is_none() || self.host.is_none() {\n            return;\n        }\n''','''    fn frame(&mut self) {\n        if self.gfx.is_none() || self.host.is_none() {\n            return;\n        }\n        if self.product.is_some() {\n            self.product_frame();\n            return;\n        }\n''')\ns=s.replace('''    fn window_event(&mut self, el: &ActiveEventLoop, _id: WindowId, event: WindowEvent) {\n        if let WindowEvent::Touch(t) = &event {''','''    fn window_event(&mut self, el: &ActiveEventLoop, _id: WindowId, event: WindowEvent) {\n        if self.product.is_some() {\n            self.product_event(el, event);\n            return;\n        }\n        if let WindowEvent::Touch(t) = &event {''')\ns=s.replace('''        let msg = format!(\"{e:#}\");\n        #[cfg(target_arch = \"wasm32\")]\n        crate::platform::error_box(\"Shardfall could not start\", &msg);''','''        let msg = format!(\"{e:#}\");\n        #[cfg(target_arch = \"wasm32\")]\n        crate::platform::error_box(if self.product.is_some() { \"Trauma Tempo could not start\" } else { \"Shardfall could not start\" }, &msg);''')\ns=s.replace(\"    host: Option<SimHost>,\",\"    pub(crate) host: Option<SimHost>,\").replace(\"    gfx: Option<Gfx>,\",\"    pub(crate) gfx: Option<Gfx>,\").replace(\"    egui_ctx: egui::Context,\",\"    pub(crate) egui_ctx: egui::Context,\").replace(\"    egui_state: Option<UiInput>,\",\"    pub(crate) egui_state: Option<UiInput>,\").replace(\"    rig: CameraRig,\",\"    pub(crate) rig: CameraRig,\").replace(\"    view: ViewSettings,\\n    /// View settings before\",\"    pub(crate) view: ViewSettings,\\n    /// View settings before\").replace(\"    builder: ViewBuilder,\",\"    pub(crate) builder: ViewBuilder,\").replace(\"    input: Input,\\n    panel: Panel,\",\"    pub(crate) input: Input,\\n    panel: Panel,\").replace(\"    started: Instant,\\n    last: Instant,\",\"    pub(crate) started: Instant,\\n    pub(crate) last: Instant,\").replace(\"    audio: Option<pav_audio::AudioOut>,\",\"    pub(crate) audio: Option<pav_audio::AudioOut>,\").replace(\"    quit: bool,\",\"    pub(crate) quit: bool,\")\ns=s.replace(\"    fn frame(&mut self) {\\n        if self.gfx.is_none()\",\"    pub(crate) fn frame(&mut self) {\\n        if self.gfx.is_none()\")\nopen(p,'w').write(s)\np='crates/pav_app/src/simhost.rs'; s=open(p).read()\ns=s.replace('''                let mut frame = *i;\n                i.pressed = 0;''','''                let mut frame = *i;\n                i.pressed = 0;\n                for s in &mut i.surgeons {\n                    s.pressed = 0;\n                    s.tool = 0;\n                    s.cycle = 0;\n                }''')\nopen(p,'w').write(s)\np='crates/pav_app/Cargo.toml'; s=open(p).read()\ns=s.replace('''wasm-bindgen.workspace = true\nwasm-bindgen-futures.workspace = true''','''wasm-bindgen.workspace = true\nwasm-bindgen-futures.workspace = true\njs-sys = \"0.3\"''')\nopen(p,'w').write(s)\np='crates/pav_core/src/games/surgery/mod.rs'; s=open(p).read()\ns=s.replace('''        op.tick(&inputs, &rules, dt);\n        events.append(&mut op.ev);''','''        op.tick(&inputs, &rules, dt);\n        events.append(&mut op.ev);\n        // Each strain plays in its own meter; otherwise the case's own track.\n        let c = content();\n        self.music = match op.strain.as_ref().map(|s| &s.kind) {\n            Some(strain::StrainKind::Introit) if op.is_director_case() => music_id(\"codeblue\"),\n            Some(strain::StrainKind::Introit) => music_id(if op.case == 7 { \"libera\" } else { \"introit\" }),\n            Some(strain::StrainKind::Lacrimosa) => music_id(if op.case == 7 { \"libera\" } else { \"lacrimosa\" }),\n            Some(strain::StrainKind::Dies) => music_id(if op.case == 7 { \"libera\" } else { \"dies\" }),\n            Some(strain::StrainKind::Soloist | strain::StrainKind::Tendril) => music_id(\"libera\"),\n            Some(strain::StrainKind::Director) => music_id(\"codeblue\"),\n            None => music_id(if c.cases[op.case as usize].music == \"tense\" { \"or\" } else { &c.cases[op.case as usize].music }),\n        };''')\nopen(p,'w').write(s)\np='crates/pav_ui/src/surgery/glyphs.rs'; s=open(p).read()\ns=s.replace(\"    Join,\\n    /// A ring\",\"    Join,\\n    Auto,\\n    /// A ring\")\ns=s.replace(\"                A::Gift | A::More => vec![face(G::Triangle, y)],\",\"                A::Gift | A::More | A::Auto => vec![face(G::Triangle, y)],\")\ns=s.replace('''            A::More => vec![G::Key(\"M\")],''','''            A::More => vec![G::Key(\"M\")],\n            A::Auto => vec![G::Key(\"F\")],''')\nopen(p,'w').write(s)\np='crates/pav_ui/src/surgery/hud.rs'; s=open(p).read()\ns=s.replace('''    let used3 = prompt(p, at3, Action::Gift, cx.device''','''    let used3 = prompt(p, at3, Action::Auto, cx.device''')\nopen(p,'w').write(s)\nEOF\nJOBS=4 ../tools/cb.sh check -p pav_app 2>&1 | grep -E \"^error|^warning: unused|-->\" -A4 | head -70","description":"Write hub bridge and product frame path; wire into app","timeout":500000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10707,"cache_read_input_tokens":552037,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10707},"output_tokens":20,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"a22efc7d-3207-4a7c-ac4c-ff66f5d7a8a0","timestamp":"2026-11-05T15:19:01.649Z","request_id":"req_011Cgk12cB7n6y1t63vfk8oa","wire_tool_inputs":{"toolu_01UCEEteS5JtKE6qccrdXYsD":{"command":"cat > crates/pav_app/src/hub.rs <<'EOF'\n//! The bridge to `window.__hub` (web/hub_shim.js, which owns every AIHub call) and the test hook\n//! `window.__game`. Natively neither exists: everything here does nothing.\n\nuse serde_json::Value;\n\n#[cfg(target_arch = \"wasm32\")]\nmod js {\n    use js_sys::{Function, Reflect};\n    use wasm_bindgen::JsValue;\n\n    pub fn hub() -> Option<JsValue> {\n        let w = web_sys::window()?;\n        let h = Reflect::get(&w, &JsValue::from_str(\"__hub\")).ok()?;\n        if h.is_undefined() || h.is_null() { None } else { Some(h) }\n    }\n\n    pub fn get(obj: &JsValue, key: &str) -> Option<JsValue> {\n        let v = Reflect::get(obj, &JsValue::from_str(key)).ok()?;\n        if v.is_undefined() || v.is_null() { None } else { Some(v) }\n    }\n\n    pub fn call(obj: &JsValue, key: &str, args: &[JsValue]) -> Option<JsValue> {\n        let f: Function = get(obj, key)?.into();\n        let list = js_sys::Array::new();\n        for a in args {\n            list.push(a);\n        }\n        f.apply(obj, &list).ok()\n    }\n}\n\n/// True when the page was opened by the hub.\npub fn active() -> bool {\n    #[cfg(target_arch = \"wasm32\")]\n    {\n        js::hub().and_then(|h| js::get(&h, \"active\")).and_then(|v| v.as_bool()).unwrap_or(false)\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    false\n}\n\n/// `connect()`'s answer, once it came: JSON of `info`.\npub fn info() -> Option<Value> {\n    #[cfg(target_arch = \"wasm32\")]\n    {\n        let h = js::hub()?;\n        let v = js::call(&h, \"infoJson\", &[])?;\n        serde_json::from_str(&v.as_string()?).ok()\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    None\n}\n\n/// The events queued since the last poll: `[name, data, from?]`.\npub fn poll() -> Vec<Value> {\n    #[cfg(target_arch = \"wasm32\")]\n    {\n        let Some(h) = js::hub() else { return Vec::new() };\n        let Some(v) = js::call(&h, \"poll\", &[]) else { return Vec::new() };\n        v.as_string().and_then(|s| serde_json::from_str(&s).ok()).unwrap_or_default()\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    Vec::new()\n}\n\npub fn ready() {\n    #[cfg(target_arch = \"wasm32\")]\n    if let Some(h) = js::hub() {\n        js::call(&h, \"ready\", &[]);\n    }\n}\n\npub fn answer(what: &str) {\n    #[cfg(target_arch = \"wasm32\")]\n    if let Some(h) = js::hub() {\n        js::call(&h, \"answer\", &[what.into()]);\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    let _ = what;\n}\n\n/// The hub's clock (ms since play began; negative in the countdown).\npub fn time() -> f64 {\n    #[cfg(target_arch = \"wasm32\")]\n    {\n        js::hub().and_then(|h| js::call(&h, \"time\", &[])).and_then(|v| v.as_f64()).unwrap_or(f64::NEG_INFINITY)\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    f64::NEG_INFINITY\n}\n\npub fn send(v: &Value) {\n    #[cfg(target_arch = \"wasm32\")]\n    if let Some(h) = js::hub() {\n        js::call(&h, \"send\", &[v.to_string().into()]);\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    let _ = v;\n}\n\npub fn publish(v: &Value) {\n    #[cfg(target_arch = \"wasm32\")]\n    if let Some(h) = js::hub() {\n        js::call(&h, \"publish\", &[v.to_string().into()]);\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    let _ = v;\n}\n\npub fn finish(v: &Value) {\n    #[cfg(target_arch = \"wasm32\")]\n    if let Some(h) = js::hub() {\n        js::call(&h, \"finish\", &[v.to_string().into()]);\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    let _ = v;\n}\n\n/// Rumble on a pad: the page's small helper.\npub fn rumble(pad: usize, ms: f32, weak: f32, strong: f32) {\n    #[cfg(target_arch = \"wasm32\")]\n    if let Some(w) = web_sys::window() {\n        use wasm_bindgen::JsValue;\n        let args = [JsValue::from_f64(pad as f64), JsValue::from_f64(ms as f64), JsValue::from_f64(weak as f64), JsValue::from_f64(strong as f64)];\n        js::call(&w, \"__rumble\", &args);\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    let _ = (pad, ms, weak, strong);\n}\n\n/// The About block the page carries.\npub fn about_text() -> Option<String> {\n    #[cfg(target_arch = \"wasm32\")]\n    {\n        web_sys::window()?.document()?.get_element_by_id(\"about-data\")?.text_content()\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    None\n}\n\n/// Whether a key or a fine pointer can exist here: a phone can do neither.\npub fn touch_only() -> bool {\n    #[cfg(target_arch = \"wasm32\")]\n    {\n        let m = |q: &str| web_sys::window().and_then(|w| w.match_media(q).ok().flatten()).is_some_and(|m| m.matches());\n        !m(\"(any-pointer: fine)\") && m(\"(any-pointer: coarse)\")\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    false\n}\n\nconst SAVE_KEY: &str = \"trauma_tempo_save\";\n\npub fn load_save() -> Option<String> {\n    #[cfg(target_arch = \"wasm32\")]\n    {\n        web_sys::window()?.local_storage().ok()??.get_item(SAVE_KEY).ok()?\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    std::fs::read_to_string(crate::boot::exe_dir().join(format!(\"{SAVE_KEY}.json\"))).ok()\n}\n\npub fn store_save(text: &str) {\n    #[cfg(target_arch = \"wasm32\")]\n    if let Some(s) = web_sys::window().and_then(|w| w.local_storage().ok().flatten()) {\n        let _ = s.set_item(SAVE_KEY, text);\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    let _ = std::fs::write(crate::boot::exe_dir().join(format!(\"{SAVE_KEY}.json\")), text);\n}\n\n// The test hook: `window.__game.status()`, `.step(n)`, `.do(json)`.\n#[cfg(target_arch = \"wasm32\")]\nthread_local! {\n    static STATUS: std::cell::RefCell<String> = const { std::cell::RefCell::new(String::new()) };\n    static STEPS: std::cell::Cell<u32> = const { std::cell::Cell::new(0) };\n    static DOS: std::cell::RefCell<Vec<String>> = const { std::cell::RefCell::new(Vec::new()) };\n}\n\n/// Installs `window.__game`.\npub fn install_hook() {\n    #[cfg(target_arch = \"wasm32\")]\n    {\n        use wasm_bindgen::JsCast;\n        use wasm_bindgen::closure::Closure;\n        let Some(w) = web_sys::window() else { return };\n        let game = js_sys::Object::new();\n        let status = Closure::<dyn Fn() -> String>::new(|| STATUS.with(|s| s.borrow().clone()));\n        let step = Closure::<dyn Fn(u32)>::new(|n: u32| STEPS.with(|s| s.set(s.get() + n)));\n        let run = Closure::<dyn Fn(String)>::new(|j: String| DOS.with(|d| d.borrow_mut().push(j)));\n        let set = |k: &str, f: &js_sys::Function| {\n            let _ = js_sys::Reflect::set(&game, &k.into(), f);\n        };\n        set(\"status\", status.as_ref().unchecked_ref());\n        set(\"step\", step.as_ref().unchecked_ref());\n        set(\"do\", run.as_ref().unchecked_ref());\n        let _ = js_sys::Reflect::set(&w, &\"__game\".into(), &game);\n        status.forget();\n        step.forget();\n        run.forget();\n    }\n}\n\npub fn set_status(v: &Value) {\n    #[cfg(target_arch = \"wasm32\")]\n    STATUS.with(|s| *s.borrow_mut() = v.to_string());\n    #[cfg(not(target_arch = \"wasm32\"))]\n    let _ = v;\n}\n\npub fn take_steps() -> u32 {\n    #[cfg(target_arch = \"wasm32\")]\n    {\n        STEPS.with(|s| s.replace(0))\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    0\n}\n\npub fn take_dos() -> Vec<String> {\n    #[cfg(target_arch = \"wasm32\")]\n    {\n        DOS.with(|d| std::mem::take(&mut *d.borrow_mut()))\n    }\n    #[cfg(not(target_arch = \"wasm32\"))]\n    Vec::new()\n}\nEOF\ncat > crates/pav_app/src/product.rs <<'EOF'\n//! The game's own frame path. `App::frame` is the engine demo's: boot and stats panels, room cards,\n//! hint bars, toasts, a touch layer, F-keys, camera keys, rewind on Backspace and a dense pause menu.\n//! None of that belongs in this game. When the scene is `surgery*`, `frame` and `window_event`\n//! branch here, reusing `Gfx`, `SimHost`, `ViewBuilder` and `CameraRig`.\n\nuse std::collections::{BTreeMap, HashSet};\n\nuse glam::{Mat4, Vec2, Vec3};\nuse pav_audio::director::Director;\nuse pav_audio::{BUS_EFFECTS, BUS_MUSIC, BUS_VOICES, Listener};\nuse pav_core::games::Outcome;\nuse pav_core::games::surgery::field::{TRAY_Z, tray_slot};\nuse pav_core::games::surgery::frame::{Stage, SurgeryFrame};\nuse pav_core::games::surgery::net::{self, NetCue};\nuse pav_core::games::surgery::tune::Difficulty;\nuse pav_core::games::surgery::{self, cue};\nuse pav_core::input::{SurgeonInput, surgeon_buttons as btn};\nuse pav_core::{Sim, SimEvent};\nuse pav_ui::Device;\nuse pav_ui::surgery::style;\nuse pav_ui::surgery::{About, CardInfo, Cmd, Input as ShellInput, Save, Screen, Shell};\nuse pav_view::CameraParams;\nuse serde_json::{Value, json};\nuse web_time::Instant;\nuse winit::event::{ElementState, MouseButton, MouseScrollDelta, WindowEvent};\nuse winit::event_loop::ActiveEventLoop;\nuse winit::keyboard::{KeyCode, PhysicalKey};\n\nuse crate::app::App;\nuse crate::hub;\n\nconst ABOUT: &str = include_str!(\"../../pav_ui/src/surgery/about.json\");\n\n/// Repeats a held direction: a press, a wait, then a steady rate.\n#[derive(Default, Clone, Copy)]\nstruct Repeat {\n    held: f32,\n}\n\nimpl Repeat {\n    fn tick(&mut self, on: bool, dt: f32) -> bool {\n        if !on {\n            self.held = 0.0;\n            return false;\n        }\n        let was = self.held;\n        self.held += dt;\n        if was == 0.0 {\n            return true;\n        }\n        if self.held > 0.4 {\n            let period = 0.11;\n            return ((self.held - 0.4) / period).floor() > ((was - 0.4).max(0.0) / period).floor();\n        }\n        false\n    }\n}\n\n/// One pad's state this frame.\n#[derive(Clone, Debug, Default)]\nstruct PadNow {\n    index: usize,\n    left: Vec2,\n    right: Vec2,\n    l2: f32,\n    r2: f32,\n    held: HashSet<u8>,\n    pressed: HashSet<u8>,\n    /// Which flick direction the left stick is in, if any.\n    flick: Option<u8>,\n    flick_new: bool,\n}\n\n// Our names for a pad's buttons.\nconst CROSS: u8 = 0;\nconst CIRCLE: u8 = 1;\nconst SQUARE: u8 = 2;\nconst TRIANGLE: u8 = 3;\nconst L1: u8 = 4;\nconst R1: u8 = 5;\nconst CREATE: u8 = 8;\nconst OPTIONS: u8 = 9;\nconst UP: u8 = 12;\nconst DOWN: u8 = 13;\nconst LEFT: u8 = 14;\nconst RIGHT: u8 = 15;\n\nfn read_pads(gilrs: &mut gilrs::Gilrs, prev: &mut BTreeMap<usize, PadNow>) -> (Vec<PadNow>, bool) {\n    use gilrs::{Axis, Button};\n    let mut activity = false;\n    while let Some(ev) = gilrs.next_event() {\n        if matches!(ev.event, gilrs::EventType::ButtonPressed(..)) {\n            activity = true;\n        }\n    }\n    const MAP: [(Button, u8); 12] = [\n        (Button::South, CROSS),\n        (Button::East, CIRCLE),\n        (Button::West, SQUARE),\n        (Button::North, TRIANGLE),\n        (Button::LeftTrigger, L1),\n        (Button::RightTrigger, R1),\n        (Button::Select, CREATE),\n        (Button::Start, OPTIONS),\n        (Button::DPadUp, UP),\n        (Button::DPadDown, DOWN),\n        (Button::DPadLeft, LEFT),\n        (Button::DPadRight, RIGHT),\n    ];\n    let mut out = Vec::new();\n    for (index, (id, gp)) in gilrs.gamepads().enumerate().take(4) {\n        let key: usize = id.into();\n        let before = prev.remove(&key).unwrap_or_default();\n        let mut now = PadNow { index, ..Default::default() };\n        let dz = |v: Vec2, d: f32| {\n            let l = v.length();\n            if l < d { Vec2::ZERO } else { v / l * ((l - d) / (1.0 - d)).min(1.0) }\n        };\n        now.left = dz(Vec2::new(gp.value(Axis::LeftStickX), gp.value(Axis::LeftStickY)), 0.18);\n        now.right = dz(Vec2::new(gp.value(Axis::RightStickX), gp.value(Axis::RightStickY)), 0.14);\n        now.l2 = gp.button_data(Button::LeftTrigger2).map(|d| d.value()).unwrap_or(0.0);\n        now.r2 = gp.button_data(Button::RightTrigger2).map(|d| d.value()).unwrap_or(0.0);\n        for (b, n) in MAP {\n            if gp.is_pressed(b) {\n                now.held.insert(n);\n                if !before.held.contains(&n) {\n                    now.pressed.insert(n);\n                }\n            }\n        }\n        // The stick flick: eight directions, instant, no menu. Up is 0, clockwise.\n        let l = now.left.length();\n        if l > 0.6 {\n            let a = now.left.x.atan2(now.left.y); // 0 = up, clockwise positive\n            let k = ((a / std::f32::consts::FRAC_PI_4).round() as i32).rem_euclid(8) as u8;\n            now.flick = Some(k);\n            now.flick_new = before.flick != Some(k);\n        } else if l > 0.42 {\n            now.flick = before.flick;\n        }\n        if !now.pressed.is_empty() || now.left.length() > 0.3 || now.right.length() > 0.3 || now.r2 > 0.1 || now.l2 > 0.1 {\n            activity = true;\n        }\n        prev.insert(key, now.clone());\n        out.push(now);\n    }\n    (out, activity)\n}\n\n#[derive(Default)]\npub struct HubState {\n    pub active: bool,\n    info: Option<Value>,\n    pub me: usize,\n    pub is_host: bool,\n    pub server: bool,\n    ready_sent: bool,\n    started: bool,\n    playing: bool,\n    ended: bool,\n    finished: bool,\n    players: Vec<(usize, String)>,\n    ready_ids: Vec<usize>,\n    remote: [SurgeonInput; 4],\n    send_t: f32,\n    publish_t: f32,\n    pending_cues: Vec<NetCue>,\n    cue_serial: u32,\n    seen_serial: u32,\n    left: Vec<usize>,\n    frames: u32,\n    snapshot_size: usize,\n    /// Latest snapshots seen, for status.\n    received: u32,\n    sent: u32,\n}\n\npub struct Product {\n    pub shell: Shell,\n    director: Director,\n    device: Device,\n    keys: HashSet<KeyCode>,\n    key_taps: HashSet<KeyCode>,\n    mouse: HashSet<MouseButton>,\n    mouse_taps: HashSet<MouseButton>,\n    cursor_px: Vec2,\n    moved_px: f32,\n    wheel: f32,\n    tap: Option<Vec2>,\n    any_event: bool,\n    pads_prev: BTreeMap<usize, PadNow>,\n    pad_slots: BTreeMap<usize, usize>,\n    nav: [Repeat; 4],\n    /// Whether a key or pad has ever been seen (a touch-only device unlocks when one arrives).\n    seen_device: bool,\n    touch_device: bool,\n    keyboard_cursor: bool,\n    rot_t: f32,\n    fps: f32,\n    fps_frames: u32,\n    fps_t: Instant,\n    hub: HubState,\n    audio_seen_gesture: bool,\n    paused: bool,\n    scene: String,\n    snapshot: Option<pav_core::SimState>,\n    cam_distance: f32,\n    last_beat: u32,\n    bot_steps: bool,\n    fonts_done: bool,\n    last_save_text: String,\n    peaks: [f32; 3],\n    seed: u64,\n    frame_count: u64,\n}\n\nimpl Product {\n    pub fn new(scene: &str, seed: u64) -> Self {\n        let save = hub::load_save().map(|t| Save::parse(&t)).unwrap_or_default();\n        let about = About::parse(&hub::about_text().unwrap_or_else(|| ABOUT.to_string()));\n        let shell = Shell::new(save, about);\n        hub::install_hook();\n        let mut pr = Product {\n            shell,\n            director: Director::default(),\n            device: Device::KeyboardMouse,\n            keys: HashSet::new(),\n            key_taps: HashSet::new(),\n            mouse: HashSet::new(),\n            mouse_taps: HashSet::new(),\n            cursor_px: Vec2::ZERO,\n            moved_px: 0.0,\n            wheel: 0.0,\n            tap: None,\n            any_event: false,\n            pads_prev: BTreeMap::new(),\n            pad_slots: BTreeMap::new(),\n            nav: [Repeat::default(); 4],\n            seen_device: false,\n            touch_device: hub::touch_only(),\n            keyboard_cursor: false,\n            rot_t: 0.0,\n            fps: 0.0,\n            fps_frames: 0,\n            fps_t: Instant::now(),\n            hub: HubState { active: hub::active(), ..Default::default() },\n            audio_seen_gesture: false,\n            paused: false,\n            scene: scene.to_string(),\n            snapshot: None,\n            cam_distance: 19.9,\n            last_beat: 0,\n            bot_steps: false,\n            fonts_done: false,\n            last_save_text: String::new(),\n            peaks: [0.0; 3],\n            seed,\n            frame_count: 0,\n        };\n        // A scene named directly (a test, a direct link) goes straight there.\n        pr.shell.screen = if pr.hub.active {\n            Screen::Card\n        } else if scene.contains(\"title\") {\n            Screen::Title\n        } else if scene.contains(\"attract\") {\n            Screen::Attract\n        } else {\n            Screen::Playing\n        };\n        if pr.hub.active {\n            pr.shell.session = true;\n            pr.shell.card = Some(CardInfo::default());\n        }\n        pr\n    }\n\n    fn apply_sim(g: &mut surgery::Surgery, shell: &Shell) {\n        g.tune = shell.tune;\n        g.diff = shell.difficulty();\n        g.tremor = shell.save.settings.tremor;\n        g.text_speed = shell.save.settings.text_speed;\n        g.auto_advance = shell.auto;\n        g.dev.immortal = shell.dev.immortal || g.mode == surgery::Mode::Attract;\n        g.dev.full_gift = shell.dev.full_gift || g.mode == surgery::Mode::Attract;\n        g.dev.freeze_timer = shell.dev.freeze_timer;\n        g.dev.one_hit = shell.dev.one_hit;\n        g.dev.bot_plays = shell.dev.bot_plays;\n    }\n}\n\nimpl App {\n    fn product_load(&mut self, pr: &mut Product, scene: &str) {\n        let Some(host) = &self.host else { return };\n        let name = scene.to_string();\n        let seed = pr.seed;\n        pr.seed = pr.seed.wrapping_add(1);\n        pr.scene = name.clone();\n        let tune_shell = pr.shell.tune;\n        let (diff, tremor, text_speed, auto) = (pr.shell.difficulty(), pr.shell.save.settings.tremor, pr.shell.save.settings.text_speed, pr.shell.auto);\n        let dev = pr.shell.dev.clone();\n        host.exec(move |sim| match Sim::new(&name, seed) {\n            Ok(mut fresh) => {\n                if let Some(g) = surgery::get_mut(&mut fresh) {\n                    g.tune = tune_shell;\n                    g.diff = diff;\n                    g.tremor = tremor;\n                    g.text_speed = text_speed;\n                    g.auto_advance = auto;\n                    g.dev.immortal |= dev.immortal;\n                    g.dev.full_gift |= dev.full_gift;\n                    g.dev.freeze_timer = dev.freeze_timer;\n                    g.dev.one_hit = dev.one_hit;\n                    g.dev.bot_plays = dev.bot_plays;\n                }\n                *sim = fresh;\n            }\n            Err(e) => log::error!(\"could not load scene: {e:#}\"),\n        });\n        if let Some(gfx) = &mut self.gfx {\n            gfx.renderer.clear_particles();\n        }\n        self.builder.clear_particles();\n    }\n\n    fn product_apply_audio(&self, pr: &Product) {\n        if let Some(a) = &self.audio {\n            let s = &pr.shell.save.settings;\n            a.set_master(1.0);\n            let ended = pr.hub.ended;\n            a.set_bus(BUS_MUSIC, if ended { 0.0 } else { s.music });\n            a.set_bus(BUS_EFFECTS, if ended { 0.0 } else { s.effects });\n            a.set_bus(BUS_VOICES, if ended { 0.0 } else { s.voices });\n        }\n    }\n\n    pub(crate) fn product_event(&mut self, el: &ActiveEventLoop, event: WindowEvent) {\n        let Some(mut pr) = self.product.take() else { return };\n        match event {\n            WindowEvent::CloseRequested => el.exit(),\n            WindowEvent::Focused(false) => {\n                pr.keys.clear();\n                pr.mouse.clear();\n            }\n            WindowEvent::Resized(sz) => {\n                if let Some(g) = &mut self.gfx {\n                    g.resize(sz.width, sz.height);\n                }\n            }\n            WindowEvent::RedrawRequested => {\n                self.product = Some(pr);\n                self.frame();\n                return;\n            }\n            WindowEvent::KeyboardInput { event, .. } => {\n                #[cfg(target_arch = \"wasm32\")]\n                self.resume_audio_again();\n                pr.audio_seen_gesture = true;\n                if let PhysicalKey::Code(code) = event.physical_key {\n                    match event.state {\n                        ElementState::Pressed => {\n                            if !event.repeat {\n                                pr.key_taps.insert(code);\n                            }\n                            pr.keys.insert(code);\n                        }\n                        ElementState::Released => {\n                            pr.keys.remove(&code);\n                        }\n                    }\n                    pr.device = Device::KeyboardMouse;\n                    pr.seen_device = true;\n                    pr.any_event = true;\n                }\n            }\n            WindowEvent::MouseInput { state, button, .. } => {\n                #[cfg(target_arch = \"wasm32\")]\n                self.resume_audio_again();\n                pr.audio_seen_gesture = true;\n                match state {\n                    ElementState::Pressed => {\n                        pr.mouse.insert(button);\n                        pr.mouse_taps.insert(button);\n                    }\n                    ElementState::Released => {\n                        pr.mouse.remove(&button);\n                    }\n                }\n                pr.device = Device::KeyboardMouse;\n                pr.any_event = true;\n                pr.keyboard_cursor = false;\n            }\n            WindowEvent::CursorMoved { position, .. } => {\n                let p = Vec2::new(position.x as f32, position.y as f32);\n                let d = (p - pr.cursor_px).length();\n                pr.cursor_px = p;\n                pr.moved_px += d;\n                if d > 2.0 {\n                    pr.device = Device::KeyboardMouse;\n                    pr.keyboard_cursor = false;\n                    pr.any_event = true;\n                }\n            }\n            WindowEvent::MouseWheel { delta, .. } => {\n                let lines = match delta {\n                    MouseScrollDelta::LineDelta(_, y) => y,\n                    MouseScrollDelta::PixelDelta(p) => p.y as f32 / 40.0,\n                };\n                pr.wheel += lines;\n                pr.any_event = true;\n                pr.device = Device::KeyboardMouse;\n            }\n            WindowEvent::Touch(t) => {\n                #[cfg(target_arch = \"wasm32\")]\n                self.resume_audio_again();\n                if matches!(t.phase, winit::event::TouchPhase::Started) {\n                    pr.tap = Some(Vec2::new(t.location.x as f32, t.location.y as f32));\n                    pr.any_event = true;\n                    pr.touch_device = pr.touch_device || !pr.seen_device;\n                }\n            }\n            _ => {}\n        }\n        self.product = Some(pr);\n    }\n\n    #[cfg(target_arch = \"wasm32\")]\n    fn resume_audio_again(&mut self) {\n        if let Some(a) = &self.audio {\n            a.resume();\n        }\n    }\n\n    /// A frame of the game.\n    pub(crate) fn product_frame(&mut self) {\n        let Some(mut pr) = self.product.take() else { return };\n        self.product_frame_inner(&mut pr);\n        self.product = Some(pr);\n    }\n\n    fn product_frame_inner(&mut self, pr: &mut Product) {\n        let now = Instant::now();\n        let dt = (now - self.last).as_secs_f32().min(0.1);\n        self.last = now;\n        pr.frame_count += 1;\n        pr.fps_frames += 1;\n        let since = pr.fps_t.elapsed().as_secs_f32();\n        if since > 0.5 {\n            pr.fps = pr.fps_frames as f32 / since;\n            pr.fps_frames = 0;\n            pr.fps_t = now;\n        }\n        if !pr.fonts_done {\n            pr.fonts_done = true;\n            style::install(&self.egui_ctx);\n            self.product_apply_audio(pr);\n        }\n\n        // Pads.\n        let (pads, pad_active) = match &mut self.input.gilrs {\n            Some(g) => read_pads(g, &mut pr.pads_prev),\n            None => (Vec::new(), false),\n        };\n        if pad_active {\n            pr.device = Device::Gamepad;\n            pr.seen_device = true;\n            pr.any_event = true;\n            if !pr.audio_seen_gesture {\n                #[cfg(target_arch = \"wasm32\")]\n                self.resume_audio_again();\n                // Browsers may not count a pad press as a gesture: say so on the title.\n                pr.shell.sound_note = true;\n            }\n        }\n        if pr.audio_seen_gesture {\n            pr.shell.sound_note = false;\n        }\n\n        let host = self.host.as_ref().unwrap();\n        host.pump();\n        let (prev, curr, curr_at, tick_wall) = host.frames();\n        let sf = curr.surgery.clone();\n        let alpha = ((now - curr_at).as_secs_f32() / tick_wall.max(1e-4)).clamp(0.0, 1.0);\n\n        // The camera.\n        let (w, h) = self.gfx.as_ref().unwrap().size();\n        let shot = sf.as_ref().map(|f| f.camera).unwrap_or_default();\n        let k = 1.0 - (-dt * 7.0).exp();\n        pr.cam_distance += (shot.distance - pr.cam_distance) * k;\n        if (shot.distance - pr.cam_distance).abs() > 8.0 {\n            pr.cam_distance = shot.distance;\n        }\n        self.rig.params = CameraParams {\n            tilt: shot.tilt,\n            yaw: shot.yaw,\n            distance: pr.cam_distance,\n            fov: shot.fov,\n            ortho: false,\n            follow_lag: 0.0,\n            height_offset: 0.0,\n        };\n        let focus = Vec3::from_array(shot.target);\n        self.rig.update(focus, dt);\n        self.rig.snap(focus);\n\n        // Menu input.\n        let scale = self.gfx.as_ref().unwrap().window.scale_factor() as f32;\n        let zoom = style::zoom_for(h as f32, scale);\n        self.egui_ctx.set_zoom_factor(zoom);\n        let ppp = zoom * scale;\n        let to_points = |p: Vec2| egui::pos2(p.x / ppp, p.y / ppp);\n        let tap_of = |k: &HashSet<KeyCode>, c: KeyCode| k.contains(&c);\n        let key_any = |ks: &[KeyCode]| ks.iter().any(|c| tap_of(&pr.key_taps, *c));\n        let pad_any = |b: u8| pads.iter().any(|p| p.pressed.contains(&b));\n        let held_dir = |ks: &[KeyCode], pad_dir: u8, axis: fn(Vec2) -> f32| {\n            ks.iter().any(|c| pr.keys.contains(c)) || pads.iter().any(|p| p.held.contains(&pad_dir) || axis(p.left) > 0.55)\n        };\n        let up = held_dir(&[KeyCode::ArrowUp, KeyCode::KeyW], UP, |v| v.y);\n        let down = held_dir(&[KeyCode::ArrowDown, KeyCode::KeyS], DOWN, |v| -v.y);\n        let left = held_dir(&[KeyCode::ArrowLeft, KeyCode::KeyA], LEFT, |v| -v.x);\n        let right = held_dir(&[KeyCode::ArrowRight, KeyCode::KeyD], RIGHT, |v| v.x);\n        let create_held = pads.iter().any(|p| p.held.contains(&CREATE));\n        let pointer = Some(to_points(pr.cursor_px));\n        let in_session = pr.shell.session;\n        let si = ShellInput {\n            up: pr.nav[0].tick(up, dt),\n            down: pr.nav[1].tick(down, dt),\n            left: pr.nav[2].tick(left, dt),\n            right: pr.nav[3].tick(right, dt),\n            confirm: key_any(&[KeyCode::Enter, KeyCode::Space, KeyCode::NumpadEnter]) || pad_any(CROSS),\n            back: key_any(&[KeyCode::Escape, KeyCode::Backspace]) || pad_any(CIRCLE),\n            tab_l: key_any(&[KeyCode::KeyQ, KeyCode::PageUp]) || pad_any(L1),\n            tab_r: key_any(&[KeyCode::KeyE, KeyCode::PageDown]) || pad_any(R1),\n            // Options is ignored while Create is held: that combination is the hub's.\n            options: !in_session && (key_any(&[KeyCode::Escape]) || (pad_any(OPTIONS) && !create_held)),\n            chart: key_any(&[KeyCode::Tab]) || pad_any(SQUARE),\n            auto_toggle: key_any(&[KeyCode::KeyF]) || pad_any(TRIANGLE),\n            pointer,\n            pointer_moved: pr.moved_px > 2.0,\n            click: pr.mouse_taps.contains(&MouseButton::Left),\n            pointer_down: pr.mouse.contains(&MouseButton::Left),\n            any: pr.any_event,\n            device: pr.device,\n            dt,\n            fps: pr.fps,\n            tps: host.shared.stats.lock().unwrap().tps,\n            touch_only: pr.touch_device && !pr.seen_device,\n            tap: pr.tap.map(to_points),\n        };\n\n        // Game input.\n        let f_opt = sf.as_deref();\n        if let Some(f) = f_opt {\n            let window = self.gfx.as_ref().unwrap().window.clone();\n            let in_op = f.stage == Stage::Op && pr.shell.wants_game_input() && pr.device == Device::KeyboardMouse && !pr.keyboard_cursor;\n            window.set_cursor_visible(!in_op);\n        }\n        let (aim_px, ground) = {\n            let size = Vec2::new(w as f32, h as f32);\n            (self.rig.ground_point(pr.cursor_px, size, 0.6), size)\n        };\n        let _ = ground;\n        let inputs = surgeon_inputs(pr, &pads, f_opt, aim_px.map(|p| Vec2::new(p.x, p.z)), dt);\n        let local_slot = if pr.hub.active { pr.hub.me } else { 0 };\n        pr.shell.local = local_slot.min(3);\n        let local_aim = inputs[local_slot.min(3)].abs.then_some(inputs[local_slot.min(3)].aim);\n        {\n            let mut i = host.shared.input.lock().unwrap();\n            let want = pr.shell.wants_game_input();\n            for k in 0..4 {\n                let mut s = if want { inputs[k] } else { SurgeonInput::default() };\n                if pr.hub.active && pr.hub.is_host && k != pr.hub.me {\n                    s = pr.hub.remote[k];\n                }\n                if pr.hub.active && pr.hub.server {\n                    s = pr.hub.remote[k];\n                }\n                let keep_pressed = i.surgeons[k].pressed;\n                let keep_tool = i.surgeons[k].tool;\n                let keep_cycle = i.surgeons[k].cycle;\n                i.surgeons[k] = s;\n                i.surgeons[k].pressed |= keep_pressed;\n                if s.tool == 0 {\n                    i.surgeons[k].tool = keep_tool;\n                }\n                if s.cycle == 0 {\n                    i.surgeons[k].cycle = keep_cycle;\n                }\n            }\n        }\n        if pr.hub.active {\n            for k in 0..4 {\n                pr.hub.remote[k].pressed = 0;\n                pr.hub.remote[k].tool = 0;\n                pr.hub.remote[k].cycle = 0;\n            }\n        }\n\n        // Test hook: ticks and commands.\n        let steps = hub::take_steps();\n        if steps > 0 {\n            let bot = pr.bot_steps;\n            host.exec(move |sim| {\n                for _ in 0..steps {\n                    let input = if bot { sim.bot_input() } else { Default::default() };\n                    sim.step(&input);\n                    sim.drain_events();\n                }\n            });\n        }\n\n        // Effects and sound.\n        self.builder.now = self.started.elapsed().as_secs_f64();\n        let events: Vec<SimEvent> = std::mem::take(&mut *host.shared.events.lock().unwrap());\n        self.builder.add_events(&events);\n        if let Some(a) = &self.audio {\n            let (_, right) = self.rig.ground_axes();\n            let l = Listener { pos: Vec3::new(0.0, 0.0, 0.0), right };\n            for e in &events {\n                a.play_event(e, &l, 1.0);\n            }\n        }\n        if pr.hub.active && pr.hub.is_host {\n            for e in &events {\n                if let SimEvent::Cue { id, pos, gain, pitch } = e {\n                    // Heartbeats are every client's own to hear from the frame; others travel.\n                    if *id != cue::MONITOR {\n                        pr.hub.cue_serial += 1;\n                        let c = NetCue { serial: pr.hub.cue_serial, id: *id, at: Vec2::new(pos.x, pos.z), gain: *gain, pitch: *pitch };\n                        pr.hub.pending_cues.push(c);\n                    }\n                }\n            }\n            let n = pr.hub.pending_cues.len();\n            if n > 8 {\n                pr.hub.pending_cues.drain(..n - 8);\n            }\n        }\n        if let (Some(f), Some(a)) = (f_opt, self.audio.as_mut()) {\n            if !pr.hub.ended && !pr.paused {\n                pr.director.update(a, f, dt);\n            }\n            let got = a.take_peaks();\n            for k in 0..3 {\n                pr.peaks[k] = (pr.peaks[k] * 0.9).max(got[k]);\n            }\n        }\n        // Rumble: on the beat when vitals are low; on tool contact.\n        if let Some(f) = f_opt {\n            if pr.shell.save.settings.rumble && pr.device == Device::Gamepad && f.stage == Stage::Op && pr.frame_count % 2 == 0 {\n                if f.beats != pr.last_beat {\n                    pr.last_beat = f.beats;\n                    if f.vitals < 45.0 {\n                        hub::rumble(0, 120.0, 0.2, 0.2 + f.crisis * 0.6);\n                    }\n                }\n                if f.slots.first().is_some_and(|s| s.eng != 0) {\n                    hub::rumble(0, 40.0, 0.25, 0.0);\n                }\n            }\n        }\n\n        // The look: hub servers skip all of it.\n        let server = pr.hub.active && pr.hub.server;\n        {\n            let s = &pr.shell.save.settings;\n            self.builder.surgery.looks = pav_view::surgery::Looks { clinical: s.clinical, reduce_flashes: s.reduce_flashes, no_shake: !s.shake, headless: server };\n            self.builder.surgery.local_cursor = local_aim.map(|a| (local_slot.min(3), a));\n        }\n        let view = self.view.clone();\n        let mut scene = self.builder.build(&prev, &curr, alpha, &self.rig, w as f32 / h.max(1) as f32, &view, focus);\n        if let Some(gfx) = &mut self.gfx {\n            gfx.renderer.render_scale = 1.0;\n        }\n\n        // The UI.\n        let vp = Mat4::from(scene.camera.proj * scene.camera.view);\n        let gfx = self.gfx.as_mut().unwrap();\n        let state = self.egui_state.as_mut().unwrap();\n        let raw = state.take(&gfx.window);\n        let shell = &mut pr.shell;\n        let f_ref = sf.as_deref();\n        let out = self.egui_ctx.run_ui(raw, |ui| {\n            shell.ui(ui.ctx(), &si, f_ref, vp);\n        });\n        state.platform_output(&gfx.window, out.platform_output);\n        let pixels = out.pixels_per_point;\n        let prims = self.egui_ctx.tessellate(out.shapes, pixels);\n        let mut textures = out.textures_delta;\n        if server {\n            scene.dynamic.clear();\n            scene.meshes.clear();\n            scene.sdfs.clear();\n        }\n        gfx.draw(&scene, Some((&prims, &mut textures, pixels)));\n\n        // Clear this frame's edges.\n        pr.key_taps.clear();\n        pr.mouse_taps.clear();\n        pr.moved_px = 0.0;\n        pr.wheel = 0.0;\n        pr.tap = None;\n        pr.any_event = false;\n\n        self.product_commands(pr);\n        self.product_hub(pr, f_opt, &pads, &inputs);\n        self.product_hook(pr, &curr);\n        // The first frame: tell the hub we're loaded.\n        if pr.hub.active && !pr.hub.ready_sent && pr.hub.info.is_some() {\n            pr.hub.ready_sent = true;\n            hub::ready();\n        }\n    }\n\n    fn product_commands(&mut self, pr: &mut Product) {\n        let cmds = std::mem::take(&mut pr.shell.cmds);\n        for c in cmds {\n            let Some(host) = &self.host else { return };\n            let surgery_do = |f: Box<dyn FnOnce(&mut surgery::Surgery) + Send>| {\n                host.exec(move |sim| {\n                    if let Some(g) = surgery::get_mut(sim) {\n                        f(g);\n                    }\n                });\n            };\n            match c {\n                Cmd::Load(s) => self.product_load(pr, &s),\n                Cmd::Paused(p) => {\n                    pr.paused = p;\n                    host.set_control(|c| {\n                        c.paused = p;\n                    });\n                }\n                Cmd::Apply => {\n                    self.product_apply_audio(pr);\n                    let (tremor, speed) = (pr.shell.save.settings.tremor, pr.shell.save.settings.text_speed);\n                    surgery_do(Box::new(move |g| {\n                        g.tremor = tremor;\n                        g.text_speed = speed;\n                    }));\n                }\n                Cmd::Save => {\n                    if let Ok(text) = serde_json::to_string(&pr.shell.save) {\n                        if text != pr.last_save_text {\n                            hub::store_save(&text);\n                            pr.last_save_text = text;\n                        }\n                    }\n                }\n                Cmd::Tune(k, v) => surgery_do(Box::new(move |g| {\n                    g.tune.set(k, v);\n                })),\n                Cmd::ResetTune => surgery_do(Box::new(|g| g.tune = Default::default())),\n                Cmd::Flag(k, v) => surgery_do(Box::new(move |g| match k {\n                    \"immortal\" => g.dev.immortal = v,\n                    \"freeze_timer\" => g.dev.freeze_timer = v,\n                    \"full_gift\" => g.dev.full_gift = v,\n                    \"one_hit\" => g.dev.one_hit = v,\n                    \"bot_plays\" => g.dev.bot_plays = v,\n                    _ => {}\n                })),\n                Cmd::Jump(case, phase) => {\n                    let scene = format!(\"surgery/case/{case}/{phase}\");\n                    self.product_load(pr, &scene);\n                }\n                Cmd::SkipPhase => surgery_do(Box::new(|g| g.skip_phase())),\n                Cmd::WinCase => surgery_do(Box::new(|g| g.win_case())),\n                Cmd::ForceCode => surgery_do(Box::new(|g| g.force_code())),\n                Cmd::KillPatient => surgery_do(Box::new(|g| g.kill_patient())),\n                Cmd::Spawn(k) => surgery_do(Box::new(move |g| g.spawn_hazard(k))),\n                Cmd::RetryCheckpoint => surgery_do(Box::new(|g| g.retry_checkpoint())),\n                Cmd::RetryStart => surgery_do(Box::new(|g| g.retry_start())),\n                Cmd::TimeScale(v) => host.set_control(|c| c.speed = v),\n                Cmd::FrameStep => host.set_control(|c| c.step_requests += 1),\n                Cmd::Rewind => host.exec(|sim| {\n                    let t = sim.state.tick.saturating_sub(300);\n                    let oldest = sim.history.oldest_tick().unwrap_or(t);\n                    sim.rewind_to(t.max(oldest));\n                    sim.commit_rewind();\n                }),\n                Cmd::SnapSave => {\n                    pr.snapshot = host.query(|sim| sim.snapshot());\n                }\n                Cmd::SnapLoad => {\n                    if let Some(s) = pr.snapshot.clone() {\n                        host.exec(move |sim| sim.restore(s));\n                    }\n                }\n                Cmd::Reload => {\n                    #[cfg(not(target_arch = \"wasm32\"))]\n                    if let Err(e) = pav_core::games::surgery::content::reload() {\n                        log::error!(\"{e:#}\");\n                        pr.shell.stats_line = format!(\"{e:#}\");\n                    } else {\n                        pr.shell.stats_line = \"content reloaded\".into();\n                    }\n                }\n                Cmd::Difficulty(d) => {\n                    let d = Difficulty::from_name(&d).unwrap_or_default();\n                    surgery_do(Box::new(move |g| g.diff = d));\n                }\n                Cmd::Cue(id) => {\n                    if let Some(a) = &self.audio {\n                        a.play_event(&SimEvent::Cue { id, pos: Vec3::ZERO, gain: 1.0, pitch: 1.0 }, &Listener::default(), 1.0);\n                    }\n                }\n                Cmd::Fullscreen(_) => {\n                    if let Some(g) = &self.gfx {\n                        crate::platform::toggle_fullscreen(&g.window);\n                    }\n                }\n                Cmd::Auto(on) => surgery_do(Box::new(move |g| g.auto_advance = on)),\n                Cmd::Quit => self.quit = true,\n            }\n        }\n    }\n\n    fn product_hook(&mut self, pr: &mut Product, curr: &pav_core::RenderFrame) {\n        for text in hub::take_dos() {\n            let Ok(v) = serde_json::from_str::<Value>(&text) else { continue };\n            let Some(host) = &self.host else { continue };\n            if let Some(s) = v.get(\"load\").and_then(|x| x.as_str()) {\n                let s = s.to_string();\n                self.product_load(pr, &s);\n                pr.shell.screen = if s.contains(\"title\") { Screen::Title } else { Screen::Playing };\n            }\n            if let Some(b) = v.get(\"bot\").and_then(|x| x.as_bool()) {\n                pr.bot_steps = b;\n            }\n            if let Some(n) = v.get(\"screen\").and_then(|x| x.as_str()) {\n                pr.shell.screen = match n {\n                    \"menu\" => Screen::Menu,\n                    \"settings\" => Screen::Settings,\n                    \"about\" => Screen::About,\n                    \"pause\" => Screen::Pause,\n                    \"dev\" => Screen::Dev,\n                    \"playing\" => Screen::Playing,\n                    \"cases\" => Screen::Cases,\n                    \"controls\" => Screen::Controls,\n                    _ => Screen::Title,\n                };\n                pr.shell.focus = 0;\n                pr.shell.page = 0;\n            }\n            if let Some(p) = v.get(\"page\").and_then(|x| x.as_u64()) {\n                pr.shell.page = p as usize;\n            }\n            if let Some(b) = v.get(\"paused\").and_then(|x| x.as_bool()) {\n                pr.paused = b;\n                host.set_control(|c| c.paused = b);\n            }\n            if let Some(b) = v.get(\"dev_live\").and_then(|x| x.as_bool()) {\n                pr.shell.dev.live = b;\n            }\n            if let Some(b) = v.get(\"immortal\").and_then(|x| x.as_bool()) {\n                host.exec(move |sim| {\n                    if let Some(g) = surgery::get_mut(sim) {\n                        g.dev.immortal = b;\n                    }\n                });\n            }\n            if let Some(a) = v.get(\"advance\").and_then(|x| x.as_u64()) {\n                // Hold the game's clock, drive so many ticks of bot.\n                let n = a as u32;\n                host.exec(move |sim| {\n                    for _ in 0..n {\n                        let input = sim.bot_input();\n                        sim.step(&input);\n                        sim.drain_events();\n                    }\n                });\n            }\n        }\n        // What's going on, for tests.\n        if pr.frame_count % 2 == 0 || hub::active() {\n            let sim_status = curr.surgery.as_ref().map(|f| {\n                json!({\n                    \"stage\": format!(\"{:?}\", f.stage),\n                    \"case\": f.case,\n                    \"phase\": f.phase,\n                    \"vitals\": f.vitals,\n                    \"bpm\": f.bpm,\n                    \"timer\": f.timer,\n                    \"hazards\": f.hazards.len(),\n                    \"tool\": f.slots.first().map(|s| s.tool),\n                    \"ring_pos\": f.slots.first().map(|s| s.ring_pos),\n                    \"using\": f.slots.first().map(|s| s.using),\n                    \"pressure\": f.slots.first().map(|s| s.pressure),\n                    \"cursor\": f.slots.first().map(|s| [s.cursor.x, s.cursor.y]),\n                    \"cursors\": f.slots.iter().map(|s| json!([s.active, s.cursor.x, s.cursor.y])).collect::<Vec<_>>(),\n                    \"demo\": f.demo,\n                    \"music\": f.music,\n                    \"tick\": f.tick,\n                    \"beats\": f.beats,\n                })\n            });\n            let s = &pr.shell.save.settings;\n            let status = json!({\n                \"title\": pav_ui::surgery::TITLE,\n                \"scene\": pr.scene,\n                \"device\": match pr.device { Device::Gamepad => \"pad\", Device::Touch => \"touch\", Device::KeyboardMouse => \"keys\" },\n                \"shell\": pr.shell.status(),\n                \"sim\": sim_status,\n                \"bus\": { \"music\": s.music, \"effects\": s.effects, \"voices\": s.voices },\n                \"peaks\": pr.peaks,\n                \"audio_device\": self.audio.is_some(),\n                \"paused\": pr.paused,\n                \"fps\": pr.fps,\n                \"frames\": pr.frame_count,\n                \"outcome\": match curr.surgery.as_ref().map(|f| f.stage) { Some(Stage::Done) => \"won\", Some(Stage::Dead) => \"lost\", _ => \"playing\" },\n                \"hub\": {\n                    \"active\": pr.hub.active,\n                    \"me\": pr.hub.me,\n                    \"host\": pr.hub.is_host,\n                    \"server\": pr.hub.server,\n                    \"playing\": pr.hub.playing,\n                    \"ended\": pr.hub.ended,\n                    \"received\": pr.hub.received,\n                    \"sent\": pr.hub.sent,\n                    \"snapshot\": pr.hub.snapshot_size,\n                },\n            });\n            hub::set_status(&status);\n        }\n    }\n\n    fn product_hub(&mut self, pr: &mut Product, f: Option<&SurgeryFrame>, pads: &[PadNow], inputs: &[SurgeonInput; 4]) {\n        if !pr.hub.active {\n            return;\n        }\n        pr.hub.frames += 1;\n        // Connection.\n        if pr.hub.info.is_none() {\n            match hub::info() {\n                Some(Value::Null) => {\n                    // No hub after all: run as on its own.\n                    pr.hub.active = false;\n                    pr.shell.session = false;\n                    pr.shell.card = None;\n                    pr.shell.screen = Screen::Title;\n                }\n                Some(info) => {\n                    pr.hub.me = info.get(\"me\").and_then(|v| v.as_u64()).unwrap_or(0) as usize;\n                    pr.hub.is_host = info.get(\"isHost\").and_then(|v| v.as_bool()).unwrap_or(false);\n                    pr.hub.server = info.get(\"server\").and_then(|v| v.as_bool()).unwrap_or(false);\n                    pr.seed = info.get(\"seed\").and_then(|v| v.as_u64()).unwrap_or(1);\n                    if let Some(list) = info.get(\"players\").and_then(|v| v.as_array()) {\n                        pr.hub.players = list\n                            .iter()\n                            .map(|p| (p.get(\"id\").and_then(|x| x.as_u64()).unwrap_or(0) as usize, p.get(\"name\").and_then(|x| x.as_str()).unwrap_or(\"\").to_string()))\n                            .collect();\n                        for (id, name) in &pr.hub.players {\n                            if *id < 4 {\n                                pr.shell.names[*id] = name.clone();\n                            }\n                        }\n                    }\n                    let card = pr.shell.card.get_or_insert_with(CardInfo::default);\n                    card.players = pr.hub.players.iter().map(|(_, n)| (n.clone(), false)).collect();\n                    card.me = pr.hub.me;\n                    pr.hub.info = Some(info);\n                    // The card scene: a beating heart behind the board.\n                    self.product_load(pr, \"surgery/card\");\n                }\n                None => {}\n            }\n        }\n        if pr.hub.info.is_none() {\n            return;\n        }\n        // The card's answers.\n        if !pr.hub.started {\n            let card_ready = pads.iter().any(|p| p.pressed.contains(&CROSS));\n            let more = pads.iter().any(|p| p.pressed.contains(&TRIANGLE)) || self.input_taps_more(pr);\n            if card_ready {\n                hub::answer(\"ready\");\n            }\n            if more {\n                hub::answer(\"more\");\n            }\n            if pr.key_taps_touch_ready() {\n                hub::answer(\"ready\");\n            }\n        }\n        // Events.\n        for ev in hub::poll() {\n            let name = ev.get(0).and_then(|v| v.as_str()).unwrap_or(\"\");\n            let data = ev.get(1).cloned().unwrap_or(Value::Null);\n            match name {\n                \"card\" => {\n                    let card = pr.shell.card.get_or_insert_with(CardInfo::default);\n                    card.left = data.get(\"left\").and_then(|v| v.as_f64()).map(|m| m as f32 / 1000.0);\n                    card.paused = data.get(\"paused\").and_then(|v| v.as_bool()).unwrap_or(false);\n                    card.starting = data.get(\"starting\").and_then(|v| v.as_bool()).unwrap_or(false);\n                    card.asked = data.get(\"asked\").and_then(|v| v.as_bool()).unwrap_or(false);\n                    let ready: Vec<usize> = data.get(\"ready\").and_then(|v| v.as_array()).map(|a| a.iter().filter_map(|x| x.as_u64().map(|n| n as usize)).collect()).unwrap_or_default();\n                    pr.hub.ready_ids = ready.clone();\n                    card.players = pr.hub.players.iter().map(|(id, n)| (n.clone(), ready.contains(id))).collect();\n                }\n                \"start\" => {\n                    pr.hub.started = true;\n                    let scene = if pr.hub.is_host { \"surgery/codeblue\" } else { \"surgery/mirror\" };\n                    self.product_load(pr, scene);\n                    if let Some(host) = &self.host {\n                        host.set_control(|c| c.paused = true);\n                        let ids: Vec<usize> = pr.hub.players.iter().map(|(id, _)| *id).collect();\n                        let server = pr.hub.server;\n                        let is_host = pr.hub.is_host;\n                        if is_host {\n                            host.exec(move |sim| {\n                                if let Some(g) = surgery::get_mut(sim) {\n                                    g.no_local = server;\n                                    if let Some(op) = &mut g.op {\n                                        for (i, s) in op.slots.iter_mut().enumerate() {\n                                            s.active = ids.contains(&i);\n                                            s.bot = false;\n                                        }\n                                    }\n                                }\n                            });\n                        }\n                    }\n                    #[cfg(target_arch = \"wasm32\")]\n                    self.resume_audio_again();\n                }\n                \"message\" => {\n                    let from = ev.get(2).and_then(|v| v.as_u64()).unwrap_or(0) as usize;\n                    pr.hub.received += 1;\n                    if pr.hub.is_host {\n                        if let Some(inp) = net::decode_input(&data) {\n                            if from < 4 {\n                                let old = pr.hub.remote[from];\n                                pr.hub.remote[from] = inp;\n                                pr.hub.remote[from].pressed |= old.pressed;\n                            }\n                        }\n                    } else if let Some(frame) = net::decode(&data) {\n                        let cues = net::decode_cues(&data);\n                        let arc = std::sync::Arc::new(frame);\n                        if let Some(host) = &self.host {\n                            host.exec(move |sim| {\n                                if let Some(g) = surgery::get_mut(sim) {\n                                    g.mirror_frame = Some(arc);\n                                }\n                            });\n                        }\n                        if let Some(a) = &self.audio {\n                            let l = Listener::default();\n                            for c in cues {\n                                if c.serial > pr.hub.seen_serial {\n                                    pr.hub.seen_serial = c.serial;\n                                    a.play_event(&SimEvent::Cue { id: c.id, pos: Vec3::new(c.at.x, 0.3, c.at.y), gain: c.gain, pitch: c.pitch }, &l, 1.0);\n                                }\n                            }\n                        }\n                    }\n                }\n                \"leave\" => {\n                    let id = data.get(\"id\").and_then(|v| v.as_u64()).unwrap_or(99) as usize;\n                    pr.hub.left.push(id);\n                    if let Some(c) = &mut pr.shell.card {\n                        c.players.retain(|(n, _)| Some(n) != pr.hub.players.iter().find(|(i, _)| *i == id).map(|(_, n)| n));\n                    }\n                    if pr.hub.is_host {\n                        if let Some(host) = &self.host {\n                            host.exec(move |sim| {\n                                if let Some(g) = surgery::get_mut(sim) {\n                                    if let Some(op) = &mut g.op {\n                                        if id < 4 {\n                                            op.slots[id].active = false;\n                                        }\n                                    }\n                                }\n                            });\n                        }\n                    }\n                }\n                \"end\" => {\n                    pr.hub.ended = true;\n                    self.product_apply_audio(pr);\n                }\n                _ => {}\n            }\n        }\n        // The countdown.\n        if pr.hub.started && !pr.hub.playing {\n            let t = hub::time();\n            if t >= 0.0 {\n                pr.hub.playing = true;\n                pr.shell.screen = Screen::Playing;\n                if let Some(c) = &mut pr.shell.card {\n                    c.playing = true;\n                }\n                if let Some(host) = &self.host {\n                    host.set_control(|c| c.paused = false);\n                }\n            } else if let Some(c) = &mut pr.shell.card {\n                c.countdown = if t.is_finite() { Some((-t / 1000.0) as f32) } else { None };\n            }\n        }\n        if pr.hub.ended || !pr.hub.playing {\n            return;\n        }\n        pr.hub.send_t += 1.0 / pr.fps.max(1.0);\n        let period = 1.0 / 15.0;\n        let dt_now = 0.0;\n        let _ = dt_now;\n        if pr.hub.is_host {\n            let Some(f) = f else { return };\n            if pr.hub.send_t >= period {\n                pr.hub.send_t = 0.0;\n                let v = net::encode(f, &pr.hub.pending_cues);\n                pr.hub.snapshot_size = v.to_string().len();\n                hub::send(&v);\n                pr.hub.sent += 1;\n            }\n            pr.hub.publish_t += 1.0 / pr.fps.max(1.0);\n            let done = matches!(f.stage, Stage::Results | Stage::Done | Stage::Dead);\n            if pr.hub.publish_t > 1.0 || done {\n                pr.hub.publish_t = 0.0;\n                let won = !matches!(f.stage, Stage::Dead);\n                let out = standings(&pr.hub.players, &pr.hub.left, f, won);\n                hub::publish(&out);\n                if done && !pr.hub.finished {\n                    pr.hub.finished = true;\n                    hub::finish(&out);\n                }\n            }\n        } else if pr.hub.send_t >= period {\n            pr.hub.send_t = 0.0;\n            let mine = inputs[pr.hub.me.min(3)];\n            hub::send(&net::encode_input(&mine));\n            pr.hub.sent += 1;\n        }\n    }\n\n    fn input_taps_more(&self, pr: &Product) -> bool {\n        pr.more_key\n    }\n}\n\nimpl Product {\n    fn key_taps_touch_ready(&self) -> bool {\n        self.ready_tap\n    }\n}\n\nfn standings(players: &[(usize, String)], left: &[usize], f: &SurgeryFrame, won: bool) -> Value {\n    let mut order: Vec<(usize, i64, u32)> = players\n        .iter()\n        .filter(|(id, _)| !left.contains(id))\n        .map(|(id, _)| {\n            let s = f.slots.get(*id);\n            (*id, s.map(|x| x.score).unwrap_or(0), s.map(|x| x.chain).unwrap_or(0))\n        })\n        .collect();\n    order.sort_by_key(|(_, score, _)| std::cmp::Reverse(*score));\n    let list: Vec<Value> = order.iter().map(|(id, _, _)| json!([id])).collect();\n    let mut scores = serde_json::Map::new();\n    let mut stats = serde_json::Map::new();\n    for (id, score, chain) in &order {\n        scores.insert(id.to_string(), json!(score));\n        stats.insert(id.to_string(), json!({ \"Chain\": chain, \"Vitals left\": f.vitals as i32 }));\n    }\n    let awards: Vec<Value> = order.first().map(|(id, _, _)| json!({ \"id\": id, \"title\": \"Immaculate Hands\", \"detail\": \"Most points on the table\" })).into_iter().collect();\n    json!({ \"standings\": list, \"scores\": scores, \"won\": won, \"stats\": stats, \"awards\": awards })\n}\n\n/// Builds each seat's input from the devices.\nfn surgeon_inputs(pr: &mut Product, pads: &[PadNow], f: Option<&SurgeryFrame>, mouse_aim: Option<Vec2>, dt: f32) -> [SurgeonInput; 4] {\n    let mut out: [SurgeonInput; 4] = Default::default();\n    let code = f.is_some_and(|x| x.code.is_some());\n    let stage = f.map(|x| x.stage);\n    let in_op = stage == Some(Stage::Op);\n    let holding_bone = |slot: usize| f.and_then(|x| x.slots.get(slot)).is_some_and(|s| s.eng == 10);\n\n    // Pads: the first plays seat 0; any unassigned pad joins with Cross.\n    for p in pads {\n        if !pr.pad_slots.contains_key(&p.index) {\n            if p.index == 0 {\n                pr.pad_slots.insert(0, 0);\n            } else if p.pressed.contains(&CROSS) && in_op {\n                let taken: Vec<usize> = pr.pad_slots.values().copied().collect();\n                if let Some(free) = (1..4).find(|s| !taken.contains(s)) {\n                    pr.pad_slots.insert(p.index, free);\n                }\n            }\n        }\n    }\n    let solo_seat = if pr.hub.active { pr.hub.me.min(3) } else { 0 };\n    for p in pads {\n        let Some(&slot) = pr.pad_slots.get(&p.index) else { continue };\n        let slot = if pr.hub.active { if p.index == 0 { solo_seat } else { continue } } else { slot };\n        // Pad 0 shares seat 0 with the keyboard: it plays when it was used last.\n        if slot == solo_seat && pr.device != Device::Gamepad {\n            continue;\n        }\n        let mut s = SurgeonInput { active: true, abs: false, ..Default::default() };\n        s.aim = Vec2::new(p.right.x, -p.right.y);\n        let cross = p.held.contains(&CROSS);\n        let use_ = p.r2 > 0.08 || cross;\n        if code {\n            if p.l2 > 0.3 && p.r2 > 0.3 {\n                s.held |= btn::DEFIB;\n            }\n        } else if use_ {\n            s.held |= btn::USE;\n            s.pressure = if cross { 1.0 } else { p.r2 };\n        }\n        if p.l2 > 0.3 && !code {\n            s.held |= btn::PRECISION;\n        }\n        if p.held.contains(&CIRCLE) {\n            s.held |= btn::CANCEL;\n        }\n        if p.held.contains(&TRIANGLE) && in_op {\n            s.held |= btn::GIFT;\n        }\n        if p.flick_new {\n            if let Some(k) = p.flick {\n                s.tool = k + 1;\n            }\n        }\n        if holding_bone(slot) {\n            if p.held.contains(&L1) {\n                s.held |= btn::ROT_L;\n            }\n            if p.held.contains(&R1) {\n                s.held |= btn::ROT_R;\n            }\n        } else {\n            if p.pressed.contains(&L1) {\n                s.cycle = -1;\n            }\n            if p.pressed.contains(&R1) {\n                s.cycle = 1;\n            }\n        }\n        // Story, chart, results and retry.\n        if !in_op {\n            if cross {\n                s.held |= btn::ADVANCE;\n            }\n            if p.pressed.contains(&CROSS) {\n                s.pressed |= btn::ADVANCE;\n            }\n            if p.pressed.contains(&CIRCLE) {\n                s.pressed |= btn::CANCEL;\n            }\n        }\n        out[slot] = s;\n    }\n\n    // Keyboard and mouse: seat 0 (or this copy's seat in a session).\n    if pr.device == Device::KeyboardMouse {\n        let k = |c: KeyCode| pr.keys.contains(&c);\n        let mut s = SurgeonInput { active: true, ..Default::default() };\n        let axis = Vec2::new(\n            (k(KeyCode::KeyD) || k(KeyCode::ArrowRight)) as i32 as f32 - (k(KeyCode::KeyA) || k(KeyCode::ArrowLeft)) as i32 as f32,\n            (k(KeyCode::KeyS) || k(KeyCode::ArrowDown)) as i32 as f32 - (k(KeyCode::KeyW) || k(KeyCode::ArrowUp)) as i32 as f32,\n        );\n        if axis != Vec2::ZERO {\n            pr.keyboard_cursor = true;\n        }\n        if pr.keyboard_cursor {\n            s.abs = false;\n            s.aim = axis.normalize_or_zero() * 0.82;\n        } else if let Some(a) = mouse_aim {\n            s.abs = true;\n            s.aim = a;\n        }\n        let left = pr.mouse.contains(&MouseButton::Left);\n        let right = pr.mouse.contains(&MouseButton::Right);\n        let on_tray = mouse_aim.is_some_and(|a| a.y > TRAY_Z) && !pr.keyboard_cursor;\n        // Click an instrument on the tray.\n        if pr.mouse_taps.contains(&MouseButton::Left) && on_tray {\n            if let Some(a) = mouse_aim {\n                let near = (0..8).min_by(|x, y| tray_slot(*x).distance(a).total_cmp(&tray_slot(*y).distance(a)));\n                if let Some(n) = near {\n                    s.tool = n as u8 + 1;\n                }\n            }\n        }\n        let use_key = k(KeyCode::KeyE);\n        if code {\n            if left && right {\n                s.held |= btn::DEFIB;\n            }\n        } else if (left && !on_tray) || use_key {\n            s.held |= btn::USE;\n            s.pressure = 1.0;\n        }\n        if k(KeyCode::ShiftLeft) || k(KeyCode::ShiftRight) {\n            s.held |= btn::PRECISION;\n        }\n        if (right && !code) || k(KeyCode::KeyQ) {\n            s.held |= btn::CANCEL;\n        }\n        if k(KeyCode::Space) && in_op {\n            s.held |= btn::GIFT;\n        }\n        for (i, c) in [KeyCode::Digit1, KeyCode::Digit2, KeyCode::Digit3, KeyCode::Digit4, KeyCode::Digit5, KeyCode::Digit6, KeyCode::Digit7, KeyCode::Digit8].iter().enumerate() {\n            if pr.key_taps.contains(c) {\n                s.tool = i as u8 + 1;\n            }\n        }\n        let slot = solo_seat;\n        pr.rot_t = (pr.rot_t - dt).max(0.0);\n        if pr.wheel != 0.0 {\n            if holding_bone(slot) {\n                pr.rot_t = 0.14;\n                pr.rot_dir = pr.wheel.signum();\n            } else {\n                s.cycle = if pr.wheel > 0.0 { -1 } else { 1 };\n            }\n        }\n        if pr.rot_t > 0.0 {\n            s.held |= if pr.rot_dir > 0.0 { btn::ROT_R } else { btn::ROT_L };\n        }\n        if !in_op {\n            let adv = k(KeyCode::Enter) || k(KeyCode::Space) || k(KeyCode::NumpadEnter) || left;\n            if adv {\n                s.held |= btn::ADVANCE;\n            }\n            if pr.key_taps.contains(&KeyCode::Enter) || pr.key_taps.contains(&KeyCode::Space) || pr.key_taps.contains(&KeyCode::NumpadEnter) || pr.mouse_taps.contains(&MouseButton::Left) {\n                s.pressed |= btn::ADVANCE;\n            }\n            if pr.key_taps.contains(&KeyCode::Backspace) || pr.mouse_taps.contains(&MouseButton::Right) {\n                s.pressed |= btn::CANCEL;\n            }\n        }\n        out[slot] = s;\n    }\n    pr.more_key = pr.key_taps.contains(&KeyCode::KeyM);\n    pr.ready_tap = pr.tap.is_some() || pr.mouse_taps.contains(&MouseButton::Left);\n    out\n}\n\n/// What this app's Outcome means, for logs.\n#[allow(dead_code)]\nfn outcome_name(o: Outcome) -> &'static str {\n    match o {\n        Outcome::Won => \"won\",\n        Outcome::Lost => \"lost\",\n        Outcome::Playing => \"playing\",\n    }\n}\nEOF\npython3 - <<'EOF'\np='crates/pav_app/src/product.rs'; s=open(p).read()\ns=s.replace('''    seed: u64,\n    frame_count: u64,\n}\n\nimpl Product {''','''    seed: u64,\n    frame_count: u64,\n    rot_dir: f32,\n    more_key: bool,\n    ready_tap: bool,\n}\n\nimpl Product {''')\ns=s.replace('''            seed,\n            frame_count: 0,\n        };''','''            seed,\n            frame_count: 0,\n            rot_dir: 1.0,\n            more_key: false,\n            ready_tap: false,\n        };''')\nopen(p,'w').write(s)\np='crates/pav_app/src/main.rs'; s=open(p).read()\ns=s.replace(\"mod hud;\\n\",\"mod hub;\\nmod hud;\\n\").replace(\"mod platform;\\n\",\"mod platform;\\nmod product;\\n\")\nopen(p,'w').write(s)\np='crates/pav_app/src/app.rs'; s=open(p).read()\ns=s.replace('''    init_started: bool,\n    pub fatal: Option<String>,\n}\n\nimpl App {\n    fn new(settings: Settings) -> Self {\n        let scene_name = settings.scene.clone();''','''    init_started: bool,\n    pub fatal: Option<String>,\n    /// The surgery game's own frame path (`product.rs`).\n    pub(crate) product: Option<crate::product::Product>,\n}\n\nimpl App {\n    fn new(settings: Settings) -> Self {\n        let scene_name = settings.scene.clone();\n        let product = settings.scene.starts_with(\"surgery\").then(|| crate::product::Product::new(&settings.scene, settings.seed));''')\ns=s.replace('''            fatal: None,\n            settings,\n        };''','''            fatal: None,\n            product,\n            settings,\n        };''')\ns=s.replace('''            let mut attrs = Window::default_attributes().with_title(\"Shardfall\");''','''            let title = if self.product.is_some() { pav_ui::surgery::TITLE } else { \"Shardfall\" };\n            let mut attrs = Window::default_attributes().with_title(title);''')\ns=s.replace('''    fn frame(&mut self) {\n        if self.gfx.is_none() || self.host.is_none() {\n            return;\n        }\n''','''    fn frame(&mut self) {\n        if self.gfx.is_none() || self.host.is_none() {\n            return;\n        }\n        if self.product.is_some() {\n            self.product_frame();\n            return;\n        }\n''')\ns=s.replace('''    fn window_event(&mut self, el: &ActiveEventLoop, _id: WindowId, event: WindowEvent) {\n        if let WindowEvent::Touch(t) = &event {''','''    fn window_event(&mut self, el: &ActiveEventLoop, _id: WindowId, event: WindowEvent) {\n        if self.product.is_some() {\n            self.product_event(el, event);\n            return;\n        }\n        if let WindowEvent::Touch(t) = &event {''')\ns=s.replace('''        let msg = format!(\"{e:#}\");\n        #[cfg(target_arch = \"wasm32\")]\n        crate::platform::error_box(\"Shardfall could not start\", &msg);''','''        let msg = format!(\"{e:#}\");\n        #[cfg(target_arch = \"wasm32\")]\n        crate::platform::error_box(if self.product.is_some() { \"Trauma Tempo could not start\" } else { \"Shardfall could not start\" }, &msg);''')\ns=s.replace(\"    host: Option<SimHost>,\",\"    pub(crate) host: Option<SimHost>,\").replace(\"    gfx: Option<Gfx>,\",\"    pub(crate) gfx: Option<Gfx>,\").replace(\"    egui_ctx: egui::Context,\",\"    pub(crate) egui_ctx: egui::Context,\").replace(\"    egui_state: Option<UiInput>,\",\"    pub(crate) egui_state: Option<UiInput>,\").replace(\"    rig: CameraRig,\",\"    pub(crate) rig: CameraRig,\").replace(\"    view: ViewSettings,\\n    /// View settings before\",\"    pub(crate) view: ViewSettings,\\n    /// View settings before\").replace(\"    builder: ViewBuilder,\",\"    pub(crate) builder: ViewBuilder,\").replace(\"    input: Input,\\n    panel: Panel,\",\"    pub(crate) input: Input,\\n    panel: Panel,\").replace(\"    started: Instant,\\n    last: Instant,\",\"    pub(crate) started: Instant,\\n    pub(crate) last: Instant,\").replace(\"    audio: Option<pav_audio::AudioOut>,\",\"    pub(crate) audio: Option<pav_audio::AudioOut>,\").replace(\"    quit: bool,\",\"    pub(crate) quit: bool,\")\ns=s.replace(\"    fn frame(&mut self) {\\n        if self.gfx.is_none()\",\"    pub(crate) fn frame(&mut self) {\\n        if self.gfx.is_none()\")\nopen(p,'w').write(s)\np='crates/pav_app/src/simhost.rs'; s=open(p).read()\ns=s.replace('''                let mut frame = *i;\n                i.pressed = 0;''','''                let mut frame = *i;\n                i.pressed = 0;\n                for s in &mut i.surgeons {\n                    s.pressed = 0;\n                    s.tool = 0;\n                    s.cycle = 0;\n                }''')\nopen(p,'w').write(s)\np='crates/pav_app/Cargo.toml'; s=open(p).read()\ns=s.replace('''wasm-bindgen.workspace = true\nwasm-bindgen-futures.workspace = true''','''wasm-bindgen.workspace = true\nwasm-bindgen-futures.workspace = true\njs-sys = \"0.3\"''')\nopen(p,'w').write(s)\np='crates/pav_core/src/games/surgery/mod.rs'; s=open(p).read()\ns=s.replace('''        op.tick(&inputs, &rules, dt);\n        events.append(&mut op.ev);''','''        op.tick(&inputs, &rules, dt);\n        events.append(&mut op.ev);\n        // Each strain plays in its own meter; otherwise the case's own track.\n        let c = content();\n        self.music = match op.strain.as_ref().map(|s| &s.kind) {\n            Some(strain::StrainKind::Introit) if op.is_director_case() => music_id(\"codeblue\"),\n            Some(strain::StrainKind::Introit) => music_id(if op.case == 7 { \"libera\" } else { \"introit\" }),\n            Some(strain::StrainKind::Lacrimosa) => music_id(if op.case == 7 { \"libera\" } else { \"lacrimosa\" }),\n            Some(strain::StrainKind::Dies) => music_id(if op.case == 7 { \"libera\" } else { \"dies\" }),\n            Some(strain::StrainKind::Soloist | strain::StrainKind::Tendril) => music_id(\"libera\"),\n            Some(strain::StrainKind::Director) => music_id(\"codeblue\"),\n            None => music_id(if c.cases[op.case as usize].music == \"tense\" { \"or\" } else { &c.cases[op.case as usize].music }),\n        };''')\nopen(p,'w').write(s)\np='crates/pav_ui/src/surgery/glyphs.rs'; s=open(p).read()\ns=s.replace(\"    Join,\\n    /// A ring\",\"    Join,\\n    Auto,\\n    /// A ring\")\ns=s.replace(\"                A::Gift | A::More => vec![face(G::Triangle, y)],\",\"                A::Gift | A::More | A::Auto => vec![face(G::Triangle, y)],\")\ns=s.replace('''            A::More => vec![G::Key(\"M\")],''','''            A::More => vec![G::Key(\"M\")],\n            A::Auto => vec![G::Key(\"F\")],''')\nopen(p,'w').write(s)\np='crates/pav_ui/src/surgery/hud.rs'; s=open(p).read()\ns=s.replace('''    let used3 = prompt(p, at3, Action::Gift, cx.device''','''    let used3 = prompt(p, at3, Action::Auto, cx.device''')\nopen(p,'w').write(s)\nEOF\nJOBS=4 ../tools/cb.sh check -p pav_app 2>&1 | grep -E \"^error|^warning: unused|-->\" -A4 | head -70","description":"Write hub bridge and product frame path; wire into app","timeout":500000}}}
