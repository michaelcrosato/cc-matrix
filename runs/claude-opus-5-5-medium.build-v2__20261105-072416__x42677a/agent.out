{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FUb3iUvY1UzT6ybMtr8XJQ","type":"tool_result","content":"60\t        \"AltRight\" => AltRight,\n61\t        \"ArrowUp\" => ArrowUp,\n62\t        \"ArrowDown\" => ArrowDown,\n63\t        \"ArrowLeft\" => ArrowLeft,\n64\t        \"ArrowRight\" => ArrowRight,\n65\t        \"Comma\" => Comma,\n66\t        \"Period\" => Period,\n67\t        \"Slash\" => Slash,\n68\t        \"Semicolon\" => Semicolon,\n69\t        \"Quote\" => Quote,\n70\t        \"BracketLeft\" => BracketLeft,\n71\t        \"BracketRight\" => BracketRight,\n72\t        \"Minus\" => Minus,\n73\t        \"Equal\" => Equal,\n74\t        \"CapsLock\" => CapsLock,\n75\t        _ => return None,\n76\t    })\n77\t}\n78\t\n79\t/// Current keyboard bindings: defaults, optionally overridden by the room.\n80\t#[derive(Clone)]\n81\tpub struct Bindings {\n82\t    pub up: Vec<KeyCode>,\n83\t    pub down: Vec<KeyCode>,\n84\t    pub left: Vec<KeyCode>,\n85\t    pub right: Vec<KeyCode>,\n86\t    pub buttons: Vec<(u32, Vec<KeyCode>)>,\n87\t}\n88\t\n89\timpl Default for Bindings {\n90\t    fn default() -> Self {\n91\t        Self {\n92\t            up: KEYS.up.to_vec(),\n93\t            down: KEYS.down.to_vec(),\n94\t            left: KEYS.left.to_vec(),\n95\t            right: KEYS.right.to_vec(),\n96\t            buttons: KEYS.buttons.iter().map(|(b, k)| (*b, k.to_vec())).collect(),\n97\t        }\n98\t    }\n99\t}\n100\t\n101\timpl Bindings {\n102\t    /// Shardfall: WASD to move, mouse buttons and Q E R F for the six skill slots, Space to\n103\t    /// dodge, 1 for a potion, Shift to attack in place.\n104\t    pub fn game() -> Self {\n105\t        use KeyCode::*;\n106\t        Self {\n107\t            up: vec![KeyW, ArrowUp],\n108\t            down: vec![KeyS, ArrowDown],\n109\t            left: vec![KeyA, ArrowLeft],\n110\t            right: vec![KeyD, ArrowRight],\n111\t            buttons: vec![\n112\t                (buttons::SKILL3, vec![KeyQ]),\n113\t                (buttons::SKILL4, vec![KeyE]),\n114\t                (buttons::SKILL5, vec![KeyR]),\n115\t                (buttons::SKILL6, vec![KeyF]),\n116\t                (buttons::DODGE, vec![Space]),\n117\t                (buttons::POTION, vec![Digit1]),\n118\t                (buttons::FOCUS, vec![ShiftLeft]),\n119\t                (buttons::INTERACT, vec![KeyG]),\n120\t            ],\n121\t        }\n122\t    }\n123\t\n124\t    /// Defaults with a room's `[keys]` overrides applied. Returns problems found.\n125\t    pub fn with_overrides(map: &std::collections::BTreeMap<String, Vec<String>>) -> (Self, Vec<String>) {\n126\t        let mut b = Self::default();\n127\t        let mut errs = Vec::new();\n128\t        for (action, names) in map {\n129\t            let keys: Vec<KeyCode> = names\n130\t                .iter()\n131\t                .filter_map(|n| {\n132\t                    let k = key_from_name(n);\n133\t                    if k.is_none() {\n134\t                        errs.push(format!(\"unknown key '{n}'\"));\n135\t                    }\n136\t                    k\n137\t                })\n138\t                .collect();\n139\t            match action.as_str() {\n140\t                \"move_up\" => b.up = keys,\n141\t                \"move_down\" => b.down = keys,\n142\t                \"move_left\" => b.left = keys,\n143\t                \"move_right\" => b.right = keys,\n144\t                other => match pav_core::input::buttons::from_name(other) {\n145\t                    Some(bit) => match b.buttons.iter_mut().find(|(x, _)| *x == bit) {\n146\t                        Some(e) => e.1 = keys,\n147\t                        None => b.buttons.push((bit, keys)),\n148\t                    },\n149\t                    None => errs.push(format!(\"unknown action '{other}'\")),\n150\t                },\n151\t            }\n152\t        }\n153\t        (b, errs)\n154\t    }\n155\t}\n156\t\n157\t/// Shardfall's controls.\n158\tpub fn game_guide(device: Device) -> &'static [(&'static str, &'static str)] {\n159\t    match device {\n160\t        Device::KeyboardMouse => &[\n161\t            (\"Move\", \"W A S D\"),\n162\t            (\"Aim\", \"mouse\"),\n163\t            (\"Skills\", \"LMB · RMB · Q · E · R · F (hold to repeat)\"),\n164\t            (\"Dodge roll\", \"Space (cancels any attack)\"),\n165\t            (\"Potion\", \"1\"),\n166\t            (\"Attack in place\", \"hold Shift\"),\n167\t            (\"Use (trade, portal, way down, chests)\", \"G\"),\n168\t            (\"Inventory · passives · character · skills · map\", \"I · P · C · K · M\"),\n169\t            (\"Town portal\", \"T\"),\n170\t            (\"Pick up\", \"walk over it, or click its name\"),\n171\t            (\"Camera\", \"middle-drag rotate · wheel zoom\"),\n172\t            (\"Rewind\", \"hold Backspace\"),\n173\t            (\"Menu / tuning\", \"Esc / F1\"),\n174\t        ],\n175\t        Device::Gamepad => &[\n176\t            (\"Move / aim\", \"left stick / right stick\"),\n177\t            (\"Skills\", \"X · Y · B · RB · LB · RT\"),\n178\t            (\"Dodge roll\", \"A\"),\n179\t            (\"Potion\", \"D-pad up\"),\n180\t            (\"Use (trade, portal, way down, chests)\", \"D-pad right\"),\n181\t            (\"Map\", \"D-pad left\"),\n182\t            (\"Inventory, character, skills, passives\", \"D-pad down, then LB / RB\"),\n183\t            (\"In menus\", \"stick: cursor · A click · X right-click · hold Y: shift · right stick scroll · B close\"),\n184\t            (\"Menu\", \"Start\"),\n185\t        ],\n186\t        Device::Touch => &[\n187\t            (\"Move\", \"put a thumb down anywhere and drag\"),\n188\t            (\"Attack\", \"automatic: the nearest foe in reach\"),\n189\t            (\"Skills\", \"tap: at the nearest foe · drag: aim, let go to cast · hold: keep casting\"),\n190\t            (\"Dodge roll · potion\", \"the big button · the flask\"),\n191\t            (\"Use (trade, portal, way down, chests)\", \"the button that appears\"),\n192\t            (\"Bag, hero, skills, passives\", \"the bag (top right)\"),\n193\t            (\"Messages and the minimap\", \"swipe them away\"),\n194\t            (\"Close a window\", \"tap the game outside it\"),\n195\t        ],\n196\t    }\n197\t}\n198\t\n199\t/// Human-readable control guide per device.\n200\tpub fn guide(device: Device) -> &'static [(&'static str, &'static str)] {\n201\t    match device {\n202\t        Device::KeyboardMouse => &[\n203\t            (\"Move\", \"W A S D\"),\n204\t            (\"Jump\", \"Space (hold = higher)\"),\n205\t            (\"Crouch\", \"C / Ctrl (hold)\"),\n206\t            (\"Crawl\", \"Z (toggle)\"),\n207\t            (\"Throw bomb\", \"F or left click (at the cursor)\"),\n208\t            (\"Walk slowly\", \"Shift (instant model)\"),\n209\t            (\"Climb ladder\", \"walk into it\"),\n210\t            (\"Grab a ledge\", \"jump at it, keep pushing toward it\"),\n211\t            (\"Swim\", \"Space up · C down\"),\n212\t            (\"Dodge roll\", \"C while running (committed model)\"),\n213\t            (\"Camera\", \"right-drag rotate · wheel zoom · 1–8 presets\"),\n214\t            (\"Vehicles\", \"E get in / out\"),\n215\t            (\"Rewind\", \"hold Backspace\"),\n216\t            (\"Rooms\", \"F2 any room · F4 leave · F5 reset\"),\n217\t            (\"Menu / tuning\", \"Esc / F1\"),\n218\t        ],\n219\t        Device::Gamepad => &[\n220\t            (\"Move\", \"left stick\"),\n221\t            (\"Aim\", \"right stick\"),\n222\t            (\"Jump\", \"A (hold = higher)\"),\n223\t            (\"Crouch\", \"B (hold)\"),\n224\t            (\"Crawl\", \"Y (toggle)\"),\n225\t            (\"Throw bomb\", \"X or right trigger\"),\n226\t            (\"Walk slowly\", \"left trigger (instant model)\"),\n227\t            (\"Grab a ledge\", \"jump at it, keep pushing toward it\"),\n228\t            (\"Swim\", \"A up · B down\"),\n229\t            (\"Dodge roll\", \"B while running (committed model)\"),\n230\t            (\"Camera\", \"LB / RB rotate · D-pad zoom\"),\n231\t            (\"Vehicles\", \"D-pad right: get in / out\"),\n232\t            (\"Rewind\", \"hold Back/View\"),\n233\t            (\"Menu\", \"Start\"),\n234\t        ],\n235\t        Device::Touch => &[\n236\t            (\"Move\", \"put a thumb down anywhere and drag\"),\n237\t            (\"Jump · bomb · crouch · use\", \"the buttons in the corner\"),\n238\t            (\"Menu\", \"top right\"),\n239\t        ],\n240\t    }\n241\t}\n242\t\n243\t#[derive(Default)]\n244\tpub struct Pad {\n245\t    pub left: Vec2,\n246\t    pub right: Vec2,\n247\t    pub held: u32,\n248\t    pub rotate: f32,\n249\t    pub zoom: f32,\n250\t    pub start_pressed: bool,\n251\t    /// D-pad left (the game's map).\n252\t    pub map_pressed: bool,\n253\t    /// Buttons pressed since the last poll (menus read these as taps).\n254\t    pub taps: Vec<gilrs::Button>,\n255\t    /// A (south) and X (west) held: the menu cursor's left and right mouse buttons.\n256\t    pub a_held: bool,\n257\t    pub x_held: bool,\n258\t    /// Y (north) held: Shift for the menu cursor (take a whole path in the passive tree).\n259\t    pub y_held: bool,\n260\t    pub back_held: bool,\n261\t    pub any_activity: bool,\n262\t}\n263\t\n264\tpub struct Input {\n265\t    pub keys: HashSet<KeyCode>,\n266\t    pub mouse: HashSet<MouseButton>,\n267\t    pub cursor: Vec2,\n268\t    pub mouse_active: bool,\n269\t    pub gilrs: Option<gilrs::Gilrs>,\n270\t    /// A scripted gamepad (`--pad-script FILE`): tests and agents drive controller flows.\n271\t    pub pad_script: Option<PadScript>,\n272\t    pub pad: Pad,\n273\t    pub last_device: Device,\n274\t    prev_held: u32,\n275\t    /// Keys / mouse buttons pressed since the last `buttons()` call (short taps are never lost).\n276\t    key_taps: HashSet<KeyCode>,\n277\t    pub mouse_taps: HashSet<MouseButton>,\n278\t    pub bindings: Bindings,\n279\t    /// Game mode: the right mouse button is a skill and the gamepad uses the game layout.\n280\t    pub game: bool,\n281\t}\n282\t\n283\t/// A pad's raw state for one frame.\n284\tstruct PadState {\n285\t    left: Vec2,\n286\t    right: Vec2,\n287\t    held: Vec<gilrs::Button>,\n288\t    lt2: bool,\n289\t    rt2: bool,\n290\t}\n291\t\n292\t/// One line of a pad script: hold this for so many frames.\n293\t#[derive(Clone, Debug, Default)]\n294\tpub struct PadStep {\n295\t    pub frames: u32,\n296\t    pub left: Vec2,\n297\t    pub right: Vec2,\n298\t    pub hold: Vec<gilrs::Button>,\n299\t    pub tap: Vec<gilrs::Button>,\n300\t}\n301\t\n302\t/// A scripted gamepad, one step per line:\n303\t/// `<frames> [left=x,y] [right=x,y] [hold=South,North] [tap=DPadDown]` (`#` comments).\n304\t/// Buttons are gilrs names: South (A), East (B), West (X), North (Y), LeftTrigger (LB),\n305\t/// RightTrigger (RB), Start, Select, DPadUp/Down/Left/Right.\n306\t#[derive(Clone, Debug, Default)]\n307\tpub struct PadScript {\n308\t    pub steps: Vec<PadStep>,\n309\t    at: usize,\n310\t    frame: u32,\n311\t}\n312\t\n313\timpl PadScript {\n314\t    #[cfg_attr(target_arch = \"wasm32\", allow(dead_code))]\n315\t    pub fn parse(text: &str) -> Result<PadScript, String> {\n316\t        let button = |n: &str| -> Result<gilrs::Button, String> {\n317\t            use gilrs::Button as B;\n318\t            Ok(match n {\n319\t                \"South\" | \"A\" => B::South,\n320\t                \"East\" | \"B\" => B::East,\n321\t                \"West\" | \"X\" => B::West,\n322\t                \"North\" | \"Y\" => B::North,\n323\t                \"LeftTrigger\" | \"LB\" => B::LeftTrigger,\n324\t                \"RightTrigger\" | \"RB\" => B::RightTrigger,\n325\t                \"Start\" => B::Start,\n326\t                \"Select\" => B::Select,\n327\t                \"DPadUp\" => B::DPadUp,\n328\t                \"DPadDown\" => B::DPadDown,\n329\t                \"DPadLeft\" => B::DPadLeft,\n330\t                \"DPadRight\" => B::DPadRight,\n331\t                o => return Err(format!(\"unknown button '{o}'\")),\n332\t            })\n333\t        };\n334\t        let vec = |v: &str| -> Result<Vec2, String> {\n335\t            let (x, y) = v.split_once(',').ok_or(format!(\"'{v}': want x,y\"))?;\n336\t            Ok(Vec2::new(x.trim().parse().map_err(|_| format!(\"'{v}'\"))?, y.trim().parse().map_err(|_| format!(\"'{v}'\"))?))\n337\t        };\n338\t        let mut steps = Vec::new();\n339\t        for (n, line) in text.lines().enumerate() {\n340\t            let line = line.split('#').next().unwrap_or(\"\").trim();\n341\t            if line.is_empty() {\n342\t                continue;\n343\t            }\n344\t            let mut words = line.split_whitespace();\n345\t            let frames = words.next().and_then(|w| w.parse().ok()).ok_or(format!(\"line {}: starts with a frame count\", n + 1))?;\n346\t            let mut st = PadStep { frames, ..Default::default() };\n347\t            for w in words {\n348\t                let (k, v) = w.split_once('=').ok_or(format!(\"line {}: '{w}'\", n + 1))?;\n349\t                match k {\n350\t                    \"left\" => st.left = vec(v)?,\n351\t                    \"right\" => st.right = vec(v)?,\n352\t                    \"hold\" => st.hold = v.split(',').map(button).collect::<Result<_, _>>()?,\n353\t                    \"tap\" => st.tap = v.split(',').map(button).collect::<Result<_, _>>()?,\n354\t                    o => return Err(format!(\"line {}: unknown '{o}'\", n + 1)),\n355\t                }\n356\t            }\n357\t            steps.push(st);\n358\t        }\n359\t        Ok(PadScript { steps, at: 0, frame: 0 })\n360\t    }\n361\t\n362\t    /// This frame's step (and whether it's the step's first frame); None when done.\n363\t    fn next(&mut self) -> Option<(PadStep, bool)> {\n364\t        let st = self.steps.get(self.at)?.clone();\n365\t        let first = self.frame == 0;\n366\t        self.frame += 1;\n367\t        if self.frame >= st.frames.max(1) {\n368\t            self.at += 1;\n369\t            self.frame = 0;\n370\t        }\n371\t        Some((st, first))\n372\t    }\n373\t}\n374\t\n375\tfn deadzone(v: Vec2, dz: f32) -> Vec2 {\n376\t    let l = v.length();\n377\t    if l < dz { Vec2::ZERO } else { v / l * ((l - dz) / (1.0 - dz)).min(1.0) }\n378\t}\n379\t\n380\timpl Input {\n381\t    pub fn new() -> Self {\n382\t        let gilrs = match gilrs::Gilrs::new() {\n383\t            Ok(g) => {\n384\t                for (_, gp) in g.gamepads() {\n385\t                    log::info!(\"gamepad: {} ({:?})\", gp.name(), gp.power_info());\n386\t                }\n387\t                Some(g)\n388\t            }\n389\t            Err(e) => {\n390\t                log::warn!(\"gamepads unavailable: {e}\");\n391\t                None\n392\t            }\n393\t        };\n394\t        Self {\n395\t            keys: HashSet::new(),\n396\t            mouse: HashSet::new(),\n397\t            cursor: Vec2::ZERO,\n398\t            mouse_active: false,\n399\t            gilrs,\n400\t            pad_script: None,\n401\t            pad: Pad::default(),\n402\t            last_device: Device::KeyboardMouse,\n403\t            prev_held: 0,\n404\t            key_taps: HashSet::new(),\n405\t            mouse_taps: HashSet::new(),\n406\t            bindings: Bindings::default(),\n407\t            game: false,\n408\t        }\n409\t    }\n410\t\n411\t    pub fn key(&mut self, code: KeyCode, state: ElementState) {\n412\t        self.last_device = Device::KeyboardMouse;\n413\t        match state {\n414\t            ElementState::Pressed => {\n415\t                self.keys.insert(code);\n416\t                self.key_taps.insert(code);\n417\t            }\n418\t            ElementState::Released => {\n419\t                self.keys.remove(&code);\n420\t            }\n421\t        }\n422\t    }\n423\t\n424\t    pub fn mouse_button(&mut self, b: MouseButton, state: ElementState) {\n425\t        self.last_device = Device::KeyboardMouse;\n426\t        self.mouse_active = true;\n427\t        match state {\n428\t            ElementState::Pressed => {\n429\t                self.mouse.insert(b);\n430\t                self.mouse_taps.insert(b);\n431\t            }\n432\t            ElementState::Released => {\n433\t                self.mouse.remove(&b);\n434\t            }\n435\t        }\n436\t    }\n437\t\n438\t    pub fn clear(&mut self) {\n439\t        self.keys.clear();\n440\t        self.mouse.clear();\n441\t    }\n442\t\n443\t    /// Reads gamepad events and state (first connected pad).\n444\t    pub fn poll_gamepad(&mut self) {\n445\t        use gilrs::{Axis, Button};\n446\t        let mut activity = false;\n447\t        let mut taps = Vec::new();\n448\t        // One pad state from the first connected pad, or from the pad script while it runs.\n449\t        let mut state: Option<PadState> = None;\n450\t        if let Some(g) = &mut self.gilrs {\n451\t            while let Some(ev) = g.next_event() {\n452\t                match ev.event {\n453\t                    gilrs::EventType::ButtonPressed(b, _) => {\n454\t                        taps.push(b);\n455\t                        activity = true;\n456\t                    }\n457\t                    gilrs::EventType::AxisChanged(_, v, _) if v.abs() > 0.4 => activity = true,\n458\t                    gilrs::EventType::Connected => log::info!(\"gamepad connected\"),\n459\t                    gilrs::EventType::Disconnected => log::info!(\"gamepad disconnected\"),\n460\t                    _ => {}\n461\t                }\n462\t            }\n463\t            if let Some((_, gp)) = g.gamepads().next() {\n464\t                const ALL: [Button; 15] = [\n465\t                    Button::South,\n466\t                    Button::East,\n467\t                    Button::North,\n468\t                    Button::West,\n469\t                    Button::LeftTrigger,\n470\t                    Button::RightTrigger,\n471\t                    Button::Select,\n472\t                    Button::Start,\n473\t                    Button::DPadUp,\n474\t                    Button::DPadDown,\n475\t                    Button::DPadLeft,\n476\t                    Button::DPadRight,\n477\t                    Button::LeftThumb,\n478\t                    Button::RightThumb,\n479\t                    Button::Mode,\n480\t                ];\n481\t                let trig = |b: Button| gp.button_data(b).map(|d| d.value()).unwrap_or(0.0) > 0.35;\n482\t                state = Some(PadState {\n483\t                    left: Vec2::new(gp.value(Axis::LeftStickX), gp.value(Axis::LeftStickY)),\n484\t                    right: Vec2::new(gp.value(Axis::RightStickX), gp.value(Axis::RightStickY)),\n485\t                    held: ALL.into_iter().filter(|b| gp.is_pressed(*b)).collect(),\n486\t                    lt2: trig(Button::LeftTrigger2),\n487\t                    rt2: trig(Button::RightTrigger2),\n488\t                });\n489\t            }\n490\t        }\n491\t        if let Some(script) = &mut self.pad_script {\n492\t            if let Some((st, first)) = script.next() {\n493\t                if first {\n494\t                    taps.extend(st.tap.iter().copied());\n495\t                }\n496\t                activity = true;\n497\t                state = Some(PadState { left: st.left, right: st.right, held: st.hold.clone(), lt2: false, rt2: false });\n498\t            }\n499\t        }\n500\t        let start = taps.contains(&Button::Start);\n501\t        let map = taps.contains(&Button::DPadLeft);\n502\t        let mut pad = Pad { start_pressed: start, map_pressed: map, taps, any_activity: activity, ..Default::default() };\n503\t        if let Some(st) = state {\n504\t            let is = |b: Button| st.held.contains(&b);\n505\t            pad.left = deadzone(st.left, 0.18);\n506\t            pad.right = deadzone(st.right, 0.25);\n507\t            let mut held = 0;\n508\t            let layout: &[(Button, u32)] = if self.game {\n509\t                &[\n510\t                    (Button::West, buttons::PRIMARY),\n511\t                    (Button::North, buttons::SECONDARY),\n512\t                    (Button::East, buttons::SKILL3),\n513\t                    (Button::RightTrigger, buttons::SKILL4),\n514\t                    (Button::LeftTrigger, buttons::SKILL5),\n515\t                    (Button::South, buttons::DODGE),\n516\t                    (Button::DPadUp, buttons::POTION),\n517\t                    (Button::DPadRight, buttons::INTERACT),\n518\t                ]\n519\t            } else {\n520\t                &[\n521\t                    (Button::South, buttons::JUMP),\n522\t                    (Button::East, buttons::CROUCH),\n523\t                    (Button::North, buttons::CRAWL),\n524\t                    (Button::West, buttons::USE),\n525\t                    (Button::DPadRight, buttons::INTERACT),\n526\t                ]\n527\t            };\n528\t            for (btn, action) in layout {\n529\t                if is(*btn) {\n530\t                    held |= action;\n531\t                }\n532\t            }\n533\t            if st.rt2 {\n534\t                held |= if self.game { buttons::SKILL6 } else { buttons::USE };\n535\t            }\n536\t            if st.lt2 {\n537\t                held |= buttons::FOCUS;\n538\t            }\n539\t            pad.held = held;\n540\t            pad.rotate = if self.game { 0.0 } else { (is(Button::RightTrigger) as i32 - is(Button::LeftTrigger) as i32) as f32 };\n541\t            // In the game the D-pad is potion / use / map / panels, not zoom.\n542\t            pad.zoom = if self.game { 0.0 } else { (is(Button::DPadDown) as i32 - is(Button::DPadUp) as i32) as f32 };\n543\t            pad.a_held = is(Button::South);\n544\t            pad.x_held = is(Button::West);\n545\t            pad.y_held = is(Button::North);\n546\t            pad.back_held = is(Button::Select);\n547\t            if pad.left.length() > 0.3 || pad.right.length() > 0.3 || held != 0 {\n548\t                pad.any_activity = true;\n549\t            }\n550\t        }\n551\t        if pad.any_activity {\n552\t            self.last_device = Device::Gamepad;\n553\t        }\n554\t        self.pad = pad;\n555\t    }\n556\t\n557\t    /// Screen-space movement (x right, y up) from keys and stick, length <= 1.\n558\t    pub fn move_axis(&self) -> Vec2 {\n559\t        let k = |codes: &[KeyCode]| codes.iter().any(|c| self.keys.contains(c)) as i32 as f32;\n560\t        let b = &self.bindings;\n561\t        let kb = Vec2::new(k(&b.right) - k(&b.left), k(&b.up) - k(&b.down));\n562\t        let v = if kb != Vec2::ZERO { kb.normalize() } else { self.pad.left };\n563\t        v.clamp_length_max(1.0)\n564\t    }\n565\t\n566\t    /// Held game buttons from all devices.\n567\t    pub fn held(&self) -> u32 {\n568\t        let mut b = self.pad.held;\n569\t        for (bit, codes) in &self.bindings.buttons {\n570\t            if codes.iter().any(|c| self.keys.contains(c)) {\n571\t                b |= bit;\n572\t            }\n573\t        }\n574\t        if self.mouse.contains(&MouseButton::Left) {\n575\t            b |= buttons::PRIMARY;\n576\t        }\n577\t        if self.game && self.mouse.contains(&MouseButton::Right) {\n578\t            b |= buttons::SECONDARY;\n579\t        }\n580\t        b\n581\t    }\n582\t\n583\t    /// Returns (held, newly pressed since the last call).\n584\t    pub fn buttons(&mut self) -> (u32, u32) {\n585\t        let held = self.held();\n586\t        let mut pressed = held & !self.prev_held;\n587\t        for (bit, codes) in &self.bindings.buttons {\n588\t            if codes.iter().any(|c| self.key_taps.contains(c)) {\n589\t                pressed |= bit;\n590\t            }\n591\t        }\n592\t        if self.mouse_taps.contains(&MouseButton::Left) {\n593\t            pressed |= buttons::PRIMARY;\n594\t        }\n595\t        if self.game && self.mouse_taps.contains(&MouseButton::Right) {\n596\t            pressed |= buttons::SECONDARY;\n597\t        }\n598\t        self.key_taps.clear();\n599\t        self.mouse_taps.clear();\n600\t        self.prev_held = held;\n601\t        // A tap shorter than a frame still counts as held for that frame.\n602\t        (held | pressed, pressed)\n603\t    }\n604\t\n605\t    /// True if `b` was pressed since the last call (consumes the tap).\n606\t    pub fn take_mouse_tap(&mut self, b: MouseButton) -> bool {\n607\t        self.mouse_taps.remove(&b)\n608\t    }\n609\t\n610\t    pub fn rewind_held(&self) -> bool {\n611\t        self.keys.contains(&KeyCode::Backspace) || self.pad.back_held\n612\t    }\n613\t}\n614\t\n615\t#[cfg(test)]\n616\tmod pad_script_tests {\n617\t    use super::*;\n618\t\n619\t    #[test]\n620\t    fn pad_scripts_parse_and_play() {\n621\t        let mut p = PadScript::parse(\"# open the bag\\n2\\n1 tap=DPadDown\\n3 left=0.5,-1 hold=A,Y\\n\").unwrap();\n622\t        assert_eq!(p.steps.len(), 3);\n623\t        let frames: Vec<(PadStep, bool)> = std::iter::from_fn(|| p.next()).collect();\n624\t        assert_eq!(frames.len(), 6);\n625\t        assert!(frames[2].1 && frames[2].0.tap == vec![gilrs::Button::DPadDown]);\n626\t        assert_eq!(frames[3].0.hold, vec![gilrs::Button::South, gilrs::Button::North]);\n627\t        assert_eq!(frames[5].0.left, Vec2::new(0.5, -1.0));\n628\t        assert!(PadScript::parse(\"x tap=A\").is_err());\n629\t        assert!(PadScript::parse(\"1 tap=Q\").is_err());\n630\t    }\n631\t}\n632\t\n633\t    pub fn set_control(&self, f: impl FnOnce(&mut TimeControl)) {\n634\t        f(&mut self.shared.control.lock().unwrap());\n635\t    }\n636\t}\n637\t\n638\t#[cfg(not(target_arch = \"wasm32\"))]\n639\timpl Drop for SimHost {\n640\t    fn drop(&mut self) {\n641\t        let _ = self.tx.send(Cmd::Quit);\n642\t        if let Some(t) = self.thread.take() {\n643\t            let _ = t.join();\n644\t        }\n645\t    }\n646\t}\n647\t\n648\tfn publish(sim: &mut Sim, sh: &Shared, tick_wall: f32, at: Instant) {\n649\t    let events = sim.drain_events();\n650\t    if !events.is_empty() {\n651\t        let mut q = sh.events.lock().unwrap();\n652\t        q.extend(events);\n653\t        let n = q.len();\n654\t        if n > 512 {\n655\t            q.drain(..n - 512);\n656\t        }\n657\t    }\n658\t    let frame = Arc::new(sim.frame());\n659\t    let mut f = sh.frames.lock().unwrap();\n660\t    f.prev = std::mem::replace(&mut f.curr, frame);\n661\t    f.curr_at = at;\n662\t    f.tick_wall = tick_wall;\n663\t}\n664\t\n665\t/// Fixed-rate ticking with time controls (pause, single steps, speed, rewind, scrubbing).\n666\tstruct Clock {\n667\t    next: Instant,\n668\t    window_start: Instant,\n669\t    window_ticks: u32,\n670\t    busy: Duration,\n671\t    rewound: bool,\n672\t    studio_mode: pav_core::prop_preview::StudioMode,\n673\t}\n674\t\n675\timpl Clock {\n676\t    fn new() -> Self {\n677\t        Self {\n678\t            next: Instant::now(),\n679\t            window_start: Instant::now(),\n680\t            window_ticks: 0,\n681\t            busy: Duration::ZERO,\n682\t            rewound: false,\n683\t            studio_mode: pav_core::prop_preview::StudioMode::World,\n684\t        }\n685\t    }\n686\t\n687\t    /// Runs whatever is due now; returns how long until the next tick.\n688\t    fn advance(&mut self, sim: &mut Sim, sh: &Shared) -> Duration {\n689\t        let previewing = sim.studio_active();\n690\t        let mode = sim.studio_mode();\n691\t        if self.studio_mode != mode {\n692\t            self.studio_mode = mode;\n693\t            self.next = Instant::now();\n694\t        }\n695\t        let ctl = *sh.control.lock().unwrap();\n696\t        // The animation stage has its own play, pause and speed controls. The world's time\n697\t        // controls stay untouched, including a paused or rewound game behind the stage.\n698\t        let tick_wall = if previewing { sim.dt() } else { sim.dt() / ctl.speed.clamp(0.01, 16.0) };\n699\t        let (busy, window_ticks) = (&mut self.busy, &mut self.window_ticks);\n700\t        let mut tick_once = |sim: &mut Sim, at: Instant| {\n701\t            let input = if previewing {\n702\t                InputFrame::default()\n703\t            } else {\n704\t                let mut i = sh.input.lock().unwrap();\n705\t                let mut frame = *i;\n706\t                i.pressed = 0;\n707\t                frame.cmd = sh.cmds.lock().unwrap().pop_front();\n708\t                frame\n709\t            };\n710\t            let stamp = if previewing { None } else { sh.input_stamp.lock().unwrap().take() };\n711\t            let t = Instant::now();\n712\t            sim.step(&input);\n713\t            *busy += t.elapsed();\n714\t            if let Some(s) = stamp {\n715\t                *sh.latency_probe.lock().unwrap() = Some((s, Instant::now(), sim.state.tick));\n716\t            }\n717\t            *window_ticks += 1;\n718\t            publish(sim, sh, tick_wall, at);\n719\t        };\n720\t\n721\t        let now = Instant::now();\n722\t        if previewing {\n723\t            let mut n = 0;\n724\t            while now >= self.next && n < 8 {\n725\t                self.next += Duration::from_secs_f32(tick_wall);\n726\t                tick_once(sim, self.next);\n727\t                n += 1;\n728\t            }\n729\t            if n == 8 && now > self.next {\n730\t                self.next = now;\n731\t            }\n732\t        } else if ctl.rewinding {\n733\t            if now >= self.next {\n734\t                self.next = now + Duration::from_secs_f32(sim.dt());\n735\t                let oldest = sim.history.oldest_tick().unwrap_or(sim.state.tick);\n736\t                let target = sim.state.tick.saturating_sub(ctl.rewind_speed.max(1) as u64).max(oldest);\n737\t                if target < sim.state.tick && sim.rewind_to(target) {\n738\t                    self.rewound = true;\n739\t                }\n740\t                let dt = sim.dt();\n741\t                publish(sim, sh, dt, now);\n742\t            }\n743\t        } else if let Some(t) = ctl.scrub {\n744\t            sh.control.lock().unwrap().scrub = None;\n745\t            if sim.rewind_to(t) {\n746\t                self.rewound = true;\n747\t            }\n748\t            let dt = sim.dt();\n749\t            publish(sim, sh, dt, now);\n750\t            self.next = now;\n751\t        } else if ctl.paused {\n752\t            if ctl.step_requests > 0 {\n753\t                sh.control.lock().unwrap().step_requests -= 1;\n754\t                if self.rewound {\n755\t                    sim.commit_rewind();\n756\t                    self.rewound = false;\n757\t                }\n758\t                tick_once(sim, now);\n759\t            }\n760\t            self.next = now;\n761\t        } else {\n762\t            if self.rewound {\n763\t                // Acting after a rewind starts a new timeline.\n764\t                sim.commit_rewind();\n765\t                self.rewound = false;\n766\t                self.next = now;\n767\t            }\n768\t            let mut n = 0;\n769\t            while now >= self.next && n < 8 {\n770\t                self.next += Duration::from_secs_f32(tick_wall);\n771\t                tick_once(sim, self.next);\n772\t                n += 1;\n773\t            }\n774\t            if n == 8 && now > self.next {\n775\t                self.next = now; // too far behind: drop time instead of spiralling\n776\t            }\n777\t        }\n778\t\n779\t        let elapsed = self.window_start.elapsed();\n780\t        if elapsed >= Duration::from_millis(500) {\n781\t            let mut s = sh.stats.lock().unwrap();\n782\t            s.tps = self.window_ticks as f32 / elapsed.as_secs_f32();\n783\t            s.tick_ms = if self.window_ticks > 0 { self.busy.as_secs_f32() * 1000.0 / self.window_ticks as f32 } else { 0.0 };\n784\t            s.tick = sim.state.tick;\n785\t            s.entities = sim.state.entities.len();\n786\t            s.oldest = sim.history.oldest_tick().unwrap_or(sim.state.tick);\n787\t            s.newest = sim.history.newest_tick().unwrap_or(sim.state.tick).max(sim.state.tick);\n788\t            s.history_mb = sim.history.approx_bytes() as f32 / 1.0e6;\n789\t            s.rewound = self.rewound;\n790\t            self.window_start = Instant::now();\n791\t            self.window_ticks = 0;\n792\t            self.busy = Duration::ZERO;\n793\t        }\n794\t        if ctl.paused && !previewing { Duration::from_millis(4) } else { self.next.saturating_duration_since(Instant::now()) }\n795\t    }\n796\t}\n797\t\n798\t#[cfg(not(target_arch = \"wasm32\"))]\n799\tfn run(mut sim: Sim, rx: std::sync::mpsc::Receiver<Cmd>, sh: Arc<Shared>) {\n800\t    use std::sync::mpsc::{RecvTimeoutError, TryRecvError};\n801\t    let mut clock = Clock::new();\n802\t    loop {\n803\t        // Commands first.\n804\t        loop {\n805\t            match rx.try_recv() {\n806\t                Ok(Cmd::Run(job)) => {\n807\t                    job(&mut sim);\n808\t                    let dt = sim.dt();\n809\t                    publish(&mut sim, &sh, dt, Instant::now());\n810\t                }\n811\t                Ok(Cmd::Quit) => return,\n812\t                Err(TryRecvError::Empty) => break,\n813\t                Err(TryRecvError::Disconnected) => return,\n814\t            }\n815\t        }\n816\t        let wait = clock.advance(&mut sim, &sh);\n817\t        match rx.recv_timeout(wait) {\n818\t            Ok(Cmd::Run(job)) => {\n819\t                job(&mut sim);\n820\t                let dt = sim.dt();\n821\t                publish(&mut sim, &sh, dt, Instant::now());\n822\t            }\n823\t            Ok(Cmd::Quit) => return,\n824\t            Err(RecvTimeoutError::Timeout) => {}\n825\t            Err(RecvTimeoutError::Disconnected) => return,\n826\t        }\n827\t    }\n828\t}\n829\t\n830\t#[cfg(test)]\n831\tmod tests {\n832\t    use super::*;\n833\t\n834\t    #[test]\n835\t    fn preview_runs_over_a_paused_world_without_changing_its_time_controls() {\n836\t        let mut sim = Sim::empty(1);\n837\t        let shared = shared_for(&mut sim);\n838\t        {\n839\t            let mut control = shared.control.lock().unwrap();\n840\t            control.paused = true;\n841\t            control.speed = 8.0;\n842\t        }\n843\t        let mut clock = Clock::new();\n844\t        clock.rewound = true;\n845\t        sim.preview_open(Some(\"QUATERNIUS/Idle_Loop\"), None).unwrap();\n846\t        clock.advance(&mut sim, &shared);\n847\t        let time = sim.preview_info().unwrap().time;\n848\t        assert!(time >= sim.dt() && time < sim.dt() * 2.0);\n849\t        assert!(clock.rewound, \"opening a preview must not commit the world's rewind\");\n850\t        assert_eq!(sim.state.tick, 0);\n851\t        let control = *shared.control.lock().unwrap();\n852\t        assert!(control.paused);\n853\t        assert_eq!(control.speed, 8.0);\n854\t        sim.preview_close();\n855\t        clock.advance(&mut sim, &shared);\n856\t        assert_eq!(sim.state.tick, 0, \"the paused world stays paused after closing\");\n857\t        assert!(clock.rewound);\n858\t    }\n859\t}\n860\t//! Scenes: the full world, small code-defined test scenes, and single rooms on their own.\n861\t\n862\tuse std::sync::Arc;\n863\t\n864\tuse anyhow::{Result, anyhow, bail};\n865\tuse glam::{Quat, Vec3};\n866\t\n867\tuse crate::color::Color;\n868\tuse crate::entity::{Behavior, BodyKind, Spawn};\n869\tuse crate::level::Placement;\n870\tuse crate::room::{self, RoomDef};\n871\tuse crate::shape::{Look, Shape, Visual};\n872\tuse crate::sim::Sim;\n873\tuse crate::statics::Block;\n874\tuse crate::world::{RoomSlot, World};\n875\t\n876\tpub const SCENES: &[(&str, &str)] = &[\n877\t    (\"world\", \"The pavilion with every room, surrounded by streaming wilderness. 'world/<room>' starts in a room.\"),\n878\t    (\"test\", \"Lit test scene: a small plaza, every primitive and style, props raining onto a pyramid.\"),\n879\t    (\"empty\", \"A single floor slab with a player.\"),\n880\t    (\"arena\", \"Shardfall: the Proving Grounds, a wave arena (combat test ground).\"),\n881\t    (\"town\", \"Shardfall: Emberwatch, the town (smith, stash, portal).\"),\n882\t    (\"lab\", \"Shardfall: the Menagerie, a gallery of designed and generated creatures.\"),\n883\t    (\"level\", \"Shardfall: a level of the descent. 'level/<n>' is depth n (1-12 designed, then the endless Depths).\"),\n884\t];\n885\t\n886\t/// The scenes a menu offers: the built-in ones, then the games (`crate::games::GAMES`).\n887\tpub fn menu() -> Vec<(&'static str, &'static str)> {\n888\t    SCENES.iter().copied().chain(crate::games::GAMES.iter().map(|g| (g.key, g.about))).collect()\n889\t}\n890\t\n891\t/// All scene names, including standalone rooms (any room key builds just that room).\n892\tpub fn names() -> Vec<String> {\n893\t    let mut v: Vec<String> = SCENES.iter().map(|s| s.0.to_string()).collect();\n894\t    v.extend(crate::games::GAMES.iter().map(|g| g.key.to_string()));\n895\t    let (rooms, _) = room::parse_all(&room::load_sources(room::rooms_dir().as_deref()));\n896\t    v.extend(rooms.into_iter().map(|(k, _)| k));\n897\t    v\n898\t}\n899\t\n900\t/// Builds one room on its own at its layout origin (fast; used by tests and agents).\n901\tpub fn build_standalone_room(sim: &mut Sim, key: &str, def: RoomDef) {\n902\t    let place = Placement::new(def.layout.origin, 0);\n903\t    let (cols, rows) = def.layout.extent();\n904\t    let (min, max) = place.aabb(Vec3::new(0.0, -1.0, 0.0), Vec3::new(cols as f32, def.height.max(2.0), rows as f32));\n905\t    let start = def.local_start();\n906\t    let inward = -def.entrance.facing.dir();\n907\t    let def = Arc::new(def);\n908\t    sim.state.world = World {\n909\t        enabled: false,\n910\t        rooms: vec![RoomSlot {\n911\t            id: 0,\n912\t            key: key.to_string(),\n913\t            def: def.clone(),\n914\t            place,\n915\t            min,\n916\t            max,\n917\t            inside: place.point(start),\n918\t            outside: place.point(start) - inward * 4.0,\n919\t            inward,\n920\t            built: false,\n921\t        }],\n922\t        current_room: Some(0),\n923\t        ..Default::default()\n924\t    };\n925\t    sim.build_room(0);\n926\t    // Player at the \"player\" marker if the layout has one, else inside the entrance.\n927\t    let marker = def\n928\t        .layout\n929\t        .layers\n930\t        .iter()\n931\t        .any(|l| def.layout.legend.iter().any(|(k, t)| t.marker.as_deref() == Some(\"player\") && l.map.contains(k.as_str())));\n932\t    sim.state.spawn = if marker { find_marker(&def, &place, \"player\").unwrap_or(place.point(start)) } else { place.point(start) };\n933\t    sim.spawn_player();\n934\t    sim.state.focus = sim.state.spawn;\n935\t    sim.state.world.saved_params = crate::world::enter_overrides(&mut sim.config, &def);\n936\t}\n937\t\n938\tfn find_marker(def: &RoomDef, place: &Placement, name: &str) -> Option<Vec3> {\n939\t    all_markers(def, place, name).into_iter().next()\n940\t}\n941\t\n942\tfn all_markers(def: &RoomDef, place: &Placement, name: &str) -> Vec<Vec3> {\n943\t    let mut out = Vec::new();\n944\t    for l in &def.layout.layers {\n945\t        let lines = crate::level::rows(&l.map);\n946\t        for (r, row) in lines.iter().enumerate() {\n947\t            for (c, ch) in row.chars().enumerate() {\n948\t                if def.layout.legend.get(&ch.to_string()).and_then(|t| t.marker.as_deref()) == Some(name) {\n949\t                    let local = Vec3::new(l.at[0] as f32 + c as f32 + 0.5, l.y, l.at[1] as f32 + r as f32 + 0.5);\n950\t                    out.push(place.point(local));\n951\t                }\n952\t            }\n953\t        }\n954\t    }\n955\t    out\n956\t}\n957\t\n958\t/// Every cell of the current room's layout whose legend says `marker = \"<name>\"`, in map\n959\t/// order (row by row), as world positions on the floor. Games place their pieces this way.\n960\tpub fn markers(sim: &Sim, name: &str) -> Vec<Vec3> {\n961\t    let w = &sim.state.world;\n962\t    match w.current_room.and_then(|i| w.rooms.get(i as usize)) {\n963\t        Some(slot) => all_markers(&slot.def, &slot.place, name),\n964\t        None => Vec::new(),\n965\t    }\n966\t}\n967\t\n968\tpub fn build(sim: &mut Sim, name: &str) -> Result<()> {\n969\t    let (base, start_room) = match name.split_once('/') {\n970\t        Some((b, r)) => (b, Some(r)),\n971\t        None => (name, None),\n972\t    };\n973\t    if let Some(game) = crate::games::find(base) {\n974\t        return (game.build)(sim, start_room);\n975\t    }\n976\t    match base {\n977\t        \"world\" => {\n978\t            let sources = room::load_sources(room::rooms_dir().as_deref());\n979\t            let (defs, errors) = room::parse_all(&sources);\n980\t            for (k, e) in &errors {\n981\t                log::error!(\"room file '{k}': {e}\");\n982\t            }\n983\t            sim.build_world(defs, errors);\n984\t            if let Some(r) = start_room {\n985\t                if !sim.teleport_to_room(r) {\n986\t                    bail!(\n987\t                        \"unknown room '{r}' (known: {})\",\n988\t                        sim.state.world.rooms.iter().map(|r| r.key.as_str()).collect::<Vec<_>>().join(\", \")\n989\t                    );\n990\t                }\n991\t            }\n992\t        }\n993\t        \"test\" => test_scene(sim),\n994\t        \"arena\" => crate::arpg::scene::build_arena(sim),\n995\t        \"town\" => crate::arpg::scene::build_town(sim, None),\n996\t        \"lab\" => crate::arpg::scene::build_lab(sim, None),\n997\t        \"level\" => {\n998\t            let n: u32 = match start_room {\n999\t                Some(r) => r.parse().map_err(|_| anyhow!(\"level/<n>: '{r}' is not a depth\"))?,\n1000\t                None => 1,\n1001\t            };\n1002\t            crate::arpg::world::build_level(sim, n.max(1), None);\n1003\t        }\n1004\t        \"empty\" => {\n1005\t            floor(sim, 20);\n1006\t            sim.state.spawn = Vec3::new(0.5, 0.0, 0.5);\n1007\t            sim.spawn_player();\n1008\t        }\n1009\t        key => {\n1010\t            let sources = room::load_sources(room::rooms_dir().as_deref());\n1011\t            let Some(src) = sources.iter().find(|s| s.key == key) else {\n1012\t                bail!(\n1013\t                    \"unknown scene or room '{key}' (scenes: world, test, empty; games: {}; rooms: {})\",\n1014\t                    crate::games::GAMES.iter().map(|g| g.key).collect::<Vec<_>>().join(\", \"),\n1015\t                    sources.iter().map(|s| s.key.as_str()).collect::<Vec<_>>().join(\", \")\n1016\t                );\n1017\t            };\n1018\t            let def = RoomDef::parse(&src.text).map_err(|e| anyhow!(\"room '{key}': {e}\"))?;\n1019\t            build_standalone_room(sim, key, def);\n1020\t        }\n1021\t    }\n1022\t    Ok(())\n1023\t}\n1024\t\n1025\t/// A checkered floor of 1 m tiles from -half..half.\n1026\tfn floor(sim: &mut Sim, half: i32) {\n1027\t    let a = Color::hex(\"#8fbf7a\");\n1028\t    let b = Color::hex(\"#86b872\");\n1029\t    let st = &mut sim.state;\n1030\t    for x in -half..half {\n1031\t        for z in -half..half {\n1032\t            let c = if (x + z) % 2 == 0 { a } else { b };\n1033\t            st.statics.add(\n1034\t                &mut st.physics,\n1035\t                Block::new(Vec3::new(x as f32, -0.5, z as f32), Vec3::new(x as f32 + 1.0, 0.0, z as f32 + 1.0), c),\n1036\t            );\n1037\t        }\n1038\t    }\n1039\t}\n1040\t\n1041\tfn test_scene(sim: &mut Sim) {\n1042\t    floor(sim, 16);\n1043\t    let st = &mut sim.state;\n1044\t    // Low walls around a plaza and a stepped platform (heights: 0.5, 1.0, 1.5 m).\n1045\t    let wall = Color::hex(\"#d9cbb0\");\n1046\t    for i in -6..6 {\n1047\t        for (x, z) in [(i, -8), (i, 7), (-8, i), (7, i)] {\n1048\t            st.statics.add(\n1049\t                &mut st.physics,\n1050\t                Block::new(Vec3::new(x as f32, 0.0, z as f32), Vec3::new(x as f32 + 1.0, 1.0, z as f32 + 1.0), wall),\n1051\t            );\n1052\t        }\n1053\t    }\n1054\t    let step = Color::hex(\"#c9a27a\");\n1055\t    for (k, h) in [0.5f32, 1.0, 1.5].iter().enumerate() {\n1056\t        let x0 = 3.0 + k as f32 * 1.0;\n1057\t        st.statics.add(&mut st.physics, Block::new(Vec3::new(x0, 0.0, -5.0), Vec3::new(x0 + 1.0, *h, -2.0), step));\n1058\t    }\n1059\t\n1060\t    // Style gallery: the same shapes in flat / cel / lit.\n1061\t    let looks = [Look::Flat, Look::Cel, Look::Lit];\n1062\t    for (i, look) in looks.iter().enumerate() {\n1063\t        let x = -5.5 + i as f32 * 1.6;\n1064\t        let mut v = Visual::new(Shape::Sphere { radius: 0.5 }, Color::hex(\"#f2c14e\"));\n1065\t        v.look = *look;\n1066\t        sim.spawn(Spawn::new(\"gallery_sphere\", Vec3::new(x, 0.5, 4.5)).visual(v.clone()).body(BodyKind::Fixed));\n1067\t        v.shape = Shape::Capsule { half_height: 0.35, radius: 0.3 };\n1068\t        v.color = Color::hex(\"#9b5de5\");\n1069\t        sim.spawn(Spawn::new(\"gallery_capsule\", Vec3::new(x, 0.65, 2.8)).visual(v.clone()).body(BodyKind::Fixed));\n1070\t        v.shape = Shape::RoundedBox { half: Vec3::new(0.5, 0.35, 0.5), radius: 0.12 };\n1071\t        v.color = Color::hex(\"#5b8def\");\n1072\t        sim.spawn(Spawn::new(\"gallery_rbox\", Vec3::new(x, 0.35, 1.1)).visual(v.clone()).body(BodyKind::Fixed));\n1073\t        v.shape = Shape::Cylinder { half_height: 0.6, radius: 0.35 };\n1074\t        v.color = Color::hex(\"#b8b8c8\");\n1075\t        sim.spawn(Spawn::new(\"gallery_cylinder\", Vec3::new(x, 0.6, -0.6)).visual(v).body(BodyKind::Fixed));\n1076\t    }\n1077\t\n1078\t    // Pyramid of crates.\n1079\t    let crate_color = Color::hex(\"#e8704a\");\n1080\t    for layer in 0..4 {\n1081\t        let n = 4 - layer;\n1082\t        for i in 0..n {\n1083\t            for j in 0..n {\n1084\t                let p = Vec3::new(\n1085\t                    1.0 + (i as f32 - (n - 1) as f32 * 0.5) * 0.62,\n1086\t                    0.3 + layer as f32 * 0.6,\n1087\t                    3.0 + (j as f32 - (n - 1) as f32 * 0.5) * 0.62,\n1088\t                );\n1089\t                sim.spawn(\n1090\t                    Spawn::new(\"crate\", p)\n1091\t                        .visual(Visual::new(Shape::Box { half: Vec3::splat(0.3) }, crate_color))\n1092\t                        .body(BodyKind::Dynamic),\n1093\t                );\n1094\t            }\n1095\t        }\n1096\t    }\n1097\t\n1098\t    // A spinning platform (kinematic) and the prop rain above it.\n1099\t    let mut plat = Visual::new(Shape::Cylinder { half_height: 0.15, radius: 2.0 }, Color::hex(\"#6c7a89\"));\n1100\t    plat.look = Look::Cel;\n1101\t    sim.spawn(\n1102\t        Spawn::new(\"spinner\", Vec3::new(1.0, 0.4, 3.0))\n1103\t            .visual(plat)\n1104\t            .body(BodyKind::Kinematic)\n1105\t            .behavior(Behavior::Spin { speed: 0.6 }),\n1106\t    );\n1107\t    sim.spawn(Spawn::new(\"rain\", Vec3::new(1.0, 0.0, 3.0)).behavior(Behavior::Rain {\n1108\t        interval: 20,\n1109\t        max: 40,\n1110\t        area: 2.5,\n1111\t        height: 8.0,\n1112\t        timer: 0,\n1113\t        spawned: Default::default(),\n1114\t    }));\n1115\t\n1116\t    // Glowing marker.\n1117\t    let mut lamp = Visual::new(Shape::Sphere { radius: 0.25 }, Color::hex(\"#ffd27a\"));\n1118\t    lamp.look = Look::Unlit;\n1119\t    lamp.emissive = 1.5;\n1120\t    sim.spawn(Spawn::new(\"lamp\", Vec3::new(-3.0, 2.2, -3.0)).visual(lamp).rot(Quat::IDENTITY));\n1121\t    sim.state.focus = Vec3::new(0.0, 0.0, 1.0);\n1122\t}\n1123\t[package]\n1124\tname = \"pav_core\"\n1125\tversion.workspace = true\n1126\tedition.workspace = true\n1127\tpublish.workspace = true\n1128\t\n1129\t[dependencies]\n1130\tglam.workspace = true\n1131\t# One-line physics precision switch: change package to \"rapier3d-f64\".\n1132\trapier = { package = \"rapier3d\", version = \"0.36\", features = [\"serde-serialize\"] }\n1133\tserde.workspace = true\n1134\tserde_json.workspace = true\n1135\ttoml.workspace = true\n1136\tanyhow.workspace = true\n1137\tciborium.workspace = true\n1138\tlog.workspace = true\n1139\t\n1140\t[lints]\n1141\tworkspace = true\n1142\t[package]\n1143\tname = \"pav_ui\"\n1144\tversion.workspace = true\n1145\tedition.workspace = true\n1146\tpublish.workspace = true\n1147\t\n1148\t[dependencies]\n1149\tpav_core.workspace = true\n1150\tglam.workspace = true\n1151\tegui.workspace = true\n1152\tegui-wgpu.workspace = true\n1153\twgpu.workspace = true\n1154\tserde.workspace = true\n1155\tweb-time.workspace = true\n1156\t\n1157\t[lints]\n1158\tworkspace = true\n1159\t[package]\n1160\tname = \"pav_view\"\n1161\tversion.workspace = true\n1162\tedition.workspace = true\n1163\tpublish.workspace = true\n1164\t\n1165\t[dependencies]\n1166\tpav_core.workspace = true\n1167\tpav_render.workspace = true\n1168\tglam.workspace = true\n1169\tserde.workspace = true\n1170\ttoml.workspace = true\n1171\t\n1172\t[dev-dependencies]\n1173\tserde_json.workspace = true\n1174\t\n1175\t[lints]\n1176\tworkspace = true\n1177\t[package]\n1178\tname = \"pav_audio\"\n1179\tversion.workspace = true\n1180\tedition.workspace = true\n1181\tpublish.workspace = true\n1182\t\n1183\t[dependencies]\n1184\tpav_core.workspace = true\n1185\tglam.workspace = true\n1186\tcpal.workspace = true\n1187\tanyhow.workspace = true\n1188\tlog.workspace = true\n1189\t\n1190\t# Web Audio in the browser build.\n1191\t[target.'cfg(target_arch = \"wasm32\")'.dependencies]\n1192\tcpal = { workspace = true, features = [\"wasm-bindgen\"] }\n1193\t\n1194\t[lints]\n1195\tworkspace = true\n1196\t23:egui = \"0.36.2\"\n1197\t24:egui-wgpu = { version = \"0.36.2\", default-features = false }\n1198\t25:egui-winit = { version = \"0.36.2\", default-features = false, features = [\"links\"] }\n1199\t26:gilrs = \"0.11\"\n1200\t34:toml = \"1\"\n1201\t36:ciborium = \"0.2\"\n1202\t49:web-sys = \"0.3\"\n1203\t631:pub struct ViewBuilder {\n1204\t702:    pub fn new() -> Self {\n1205\t721:    pub fn add_events(&mut self, events: &[SimEvent]) {\n1206\t980:    pub fn build(\n1207\t1435:            self.arpg.emit(&mut scene, curr, g, alpha, time, dt, settings.particles, cam_fwd);\n1208\t   Compiling wgpu-core-deps-windows-linux-android v30.0.1\n1209\t   Compiling unicode-segmentation v1.13.3\n1210\t"}]},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"b2594b07-e2ea-48f0-9b31-c4c54b8b76eb","timestamp":"2026-11-05T14:25:44.708Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-medium-build-v2--20261105-072416--x42677a-work/189b0832-eeab-4401-af9a-06d1cd0033c9/tool-results/b09ehw8mt.txt","content":"        \"AltRight\" => AltRight,\n        \"ArrowUp\" => ArrowUp,\n        \"ArrowDown\" => ArrowDown,\n        \"ArrowLeft\" => ArrowLeft,\n        \"ArrowRight\" => ArrowRight,\n        \"Comma\" => Comma,\n        \"Period\" => Period,\n        \"Slash\" => Slash,\n        \"Semicolon\" => Semicolon,\n        \"Quote\" => Quote,\n        \"BracketLeft\" => BracketLeft,\n        \"BracketRight\" => BracketRight,\n        \"Minus\" => Minus,\n        \"Equal\" => Equal,\n        \"CapsLock\" => CapsLock,\n        _ => return None,\n    })\n}\n\n/// Current keyboard bindings: defaults, optionally overridden by the room.\n#[derive(Clone)]\npub struct Bindings {\n    pub up: Vec<KeyCode>,\n    pub down: Vec<KeyCode>,\n    pub left: Vec<KeyCode>,\n    pub right: Vec<KeyCode>,\n    pub buttons: Vec<(u32, Vec<KeyCode>)>,\n}\n\nimpl Default for Bindings {\n    fn default() -> Self {\n        Self {\n            up: KEYS.up.to_vec(),\n            down: KEYS.down.to_vec(),\n            left: KEYS.left.to_vec(),\n            right: KEYS.right.to_vec(),\n            buttons: KEYS.buttons.iter().map(|(b, k)| (*b, k.to_vec())).collect(),\n        }\n    }\n}\n\nimpl Bindings {\n    /// Shardfall: WASD to move, mouse buttons and Q E R F for the six skill slots, Space to\n    /// dodge, 1 for a potion, Shift to attack in place.\n    pub fn game() -> Self {\n        use KeyCode::*;\n        Self {\n            up: vec![KeyW, ArrowUp],\n            down: vec![KeyS, ArrowDown],\n            left: vec![KeyA, ArrowLeft],\n            right: vec![KeyD, ArrowRight],\n            buttons: vec![\n                (buttons::SKILL3, vec![KeyQ]),\n                (buttons::SKILL4, vec![KeyE]),\n                (buttons::SKILL5, vec![KeyR]),\n                (buttons::SKILL6, vec![KeyF]),\n                (buttons::DODGE, vec![Space]),\n                (buttons::POTION, vec![Digit1]),\n                (buttons::FOCUS, vec![ShiftLeft]),\n                (buttons::INTERACT, vec![KeyG]),\n            ],\n        }\n    }\n\n    /// Defaults with a room's `[keys]` overrides applied. Returns problems found.\n    pub fn with_overrides(map: &std::collections::BTreeMap<String, Vec<String>>) -> (Self, Vec<String>) {\n        let mut b = Self::default();\n        let mut errs = Vec::new();\n        for (action, names) in map {\n            let keys: Vec<KeyCode> = names\n                .iter()\n                .filter_map(|n| {\n                    let k = key_from_name(n);\n                    if k.is_none() {\n                        errs.push(format!(\"unknown key '{n}'\"));\n                    }\n                    k\n                })\n                .collect();\n            match action.as_str() {\n                \"move_up\" => b.up = keys,\n                \"move_down\" => b.down = keys,\n                \"move_left\" => b.left = keys,\n                \"move_right\" => b.right = keys,\n                other => match pav_core::input::buttons::from_name(other) {\n                    Some(bit) => match b.buttons.iter_mut().find(|(x, _)| *x == bit) {\n                        Some(e) => e.1 = keys,\n                        None => b.buttons.push((bit, keys)),\n                    },\n                    None => errs.push(format!(\"unknown action '{other}'\")),\n                },\n            }\n        }\n        (b, errs)\n    }\n}\n\n/// Shardfall's controls.\npub fn game_guide(device: Device) -> &'static [(&'static str, &'static str)] {\n    match device {\n        Device::KeyboardMouse => &[\n            (\"Move\", \"W A S D\"),\n            (\"Aim\", \"mouse\"),\n            (\"Skills\", \"LMB · RMB · Q · E · R · F (hold to repeat)\"),\n            (\"Dodge roll\", \"Space (cancels any attack)\"),\n            (\"Potion\", \"1\"),\n            (\"Attack in place\", \"hold Shift\"),\n            (\"Use (trade, portal, way down, chests)\", \"G\"),\n            (\"Inventory · passives · character · skills · map\", \"I · P · C · K · M\"),\n            (\"Town portal\", \"T\"),\n            (\"Pick up\", \"walk over it, or click its name\"),\n            (\"Camera\", \"middle-drag rotate · wheel zoom\"),\n            (\"Rewind\", \"hold Backspace\"),\n            (\"Menu / tuning\", \"Esc / F1\"),\n        ],\n        Device::Gamepad => &[\n            (\"Move / aim\", \"left stick / right stick\"),\n            (\"Skills\", \"X · Y · B · RB · LB · RT\"),\n            (\"Dodge roll\", \"A\"),\n            (\"Potion\", \"D-pad up\"),\n            (\"Use (trade, portal, way down, chests)\", \"D-pad right\"),\n            (\"Map\", \"D-pad left\"),\n            (\"Inventory, character, skills, passives\", \"D-pad down, then LB / RB\"),\n            (\"In menus\", \"stick: cursor · A click · X right-click · hold Y: shift · right stick scroll · B close\"),\n            (\"Menu\", \"Start\"),\n        ],\n        Device::Touch => &[\n            (\"Move\", \"put a thumb down anywhere and drag\"),\n            (\"Attack\", \"automatic: the nearest foe in reach\"),\n            (\"Skills\", \"tap: at the nearest foe · drag: aim, let go to cast · hold: keep casting\"),\n            (\"Dodge roll · potion\", \"the big button · the flask\"),\n            (\"Use (trade, portal, way down, chests)\", \"the button that appears\"),\n            (\"Bag, hero, skills, passives\", \"the bag (top right)\"),\n            (\"Messages and the minimap\", \"swipe them away\"),\n            (\"Close a window\", \"tap the game outside it\"),\n        ],\n    }\n}\n\n/// Human-readable control guide per device.\npub fn guide(device: Device) -> &'static [(&'static str, &'static str)] {\n    match device {\n        Device::KeyboardMouse => &[\n            (\"Move\", \"W A S D\"),\n            (\"Jump\", \"Space (hold = higher)\"),\n            (\"Crouch\", \"C / Ctrl (hold)\"),\n            (\"Crawl\", \"Z (toggle)\"),\n            (\"Throw bomb\", \"F or left click (at the cursor)\"),\n            (\"Walk slowly\", \"Shift (instant model)\"),\n            (\"Climb ladder\", \"walk into it\"),\n            (\"Grab a ledge\", \"jump at it, keep pushing toward it\"),\n            (\"Swim\", \"Space up · C down\"),\n            (\"Dodge roll\", \"C while running (committed model)\"),\n            (\"Camera\", \"right-drag rotate · wheel zoom · 1–8 presets\"),\n            (\"Vehicles\", \"E get in / out\"),\n            (\"Rewind\", \"hold Backspace\"),\n            (\"Rooms\", \"F2 any room · F4 leave · F5 reset\"),\n            (\"Menu / tuning\", \"Esc / F1\"),\n        ],\n        Device::Gamepad => &[\n            (\"Move\", \"left stick\"),\n            (\"Aim\", \"right stick\"),\n            (\"Jump\", \"A (hold = higher)\"),\n            (\"Crouch\", \"B (hold)\"),\n            (\"Crawl\", \"Y (toggle)\"),\n            (\"Throw bomb\", \"X or right trigger\"),\n            (\"Walk slowly\", \"left trigger (instant model)\"),\n            (\"Grab a ledge\", \"jump at it, keep pushing toward it\"),\n            (\"Swim\", \"A up · B down\"),\n            (\"Dodge roll\", \"B while running (committed model)\"),\n            (\"Camera\", \"LB / RB rotate · D-pad zoom\"),\n            (\"Vehicles\", \"D-pad right: get in / out\"),\n            (\"Rewind\", \"hold Back/View\"),\n            (\"Menu\", \"Start\"),\n        ],\n        Device::Touch => &[\n            (\"Move\", \"put a thumb down anywhere and drag\"),\n            (\"Jump · bomb · crouch · use\", \"the buttons in the corner\"),\n            (\"Menu\", \"top right\"),\n        ],\n    }\n}\n\n#[derive(Default)]\npub struct Pad {\n    pub left: Vec2,\n    pub right: Vec2,\n    pub held: u32,\n    pub rotate: f32,\n    pub zoom: f32,\n    pub start_pressed: bool,\n    /// D-pad left (the game's map).\n    pub map_pressed: bool,\n    /// Buttons pressed since the last poll (menus read these as taps).\n    pub taps: Vec<gilrs::Button>,\n    /// A (south) and X (west) held: the menu cursor's left and right mouse buttons.\n    pub a_held: bool,\n    pub x_held: bool,\n    /// Y (north) held: Shift for the menu cursor (take a whole path in the passive tree).\n    pub y_held: bool,\n    pub back_held: bool,\n    pub any_activity: bool,\n}\n\npub struct Input {\n    pub keys: HashSet<KeyCode>,\n    pub mouse: HashSet<MouseButton>,\n    pub cursor: Vec2,\n    pub mouse_active: bool,\n    pub gilrs: Option<gilrs::Gilrs>,\n    /// A scripted gamepad (`--pad-script FILE`): tests and agents drive controller flows.\n    pub pad_script: Option<PadScript>,\n    pub pad: Pad,\n    pub last_device: Device,\n    prev_held: u32,\n    /// Keys / mouse buttons pressed since the last `buttons()` call (short taps are never lost).\n    key_taps: HashSet<KeyCode>,\n    pub mouse_taps: HashSet<MouseButton>,\n    pub bindings: Bindings,\n    /// Game mode: the right mouse button is a skill and the gamepad uses the game layout.\n    pub game: bool,\n}\n\n/// A pad's raw state for one frame.\nstruct PadState {\n    left: Vec2,\n    right: Vec2,\n    held: Vec<gilrs::Button>,\n    lt2: bool,\n    rt2: bool,\n}\n\n/// One line of a pad script: hold this for so many frames.\n#[derive(Clone, Debug, Default)]\npub struct PadStep {\n    pub frames: u32,\n    pub left: Vec2,\n    pub right: Vec2,\n    pub hold: Vec<gilrs::Button>,\n    pub tap: Vec<gilrs::Button>,\n}\n\n/// A scripted gamepad, one step per line:\n/// `<frames> [left=x,y] [right=x,y] [hold=South,North] [tap=DPadDown]` (`#` comments).\n/// Buttons are gilrs names: South (A), East (B), West (X), North (Y), LeftTrigger (LB),\n/// RightTrigger (RB), Start, Select, DPadUp/Down/Left/Right.\n#[derive(Clone, Debug, Default)]\npub struct PadScript {\n    pub steps: Vec<PadStep>,\n    at: usize,\n    frame: u32,\n}\n\nimpl PadScript {\n    #[cfg_attr(target_arch = \"wasm32\", allow(dead_code))]\n    pub fn parse(text: &str) -> Result<PadScript, String> {\n        let button = |n: &str| -> Result<gilrs::Button, String> {\n            use gilrs::Button as B;\n            Ok(match n {\n                \"South\" | \"A\" => B::South,\n                \"East\" | \"B\" => B::East,\n                \"West\" | \"X\" => B::West,\n                \"North\" | \"Y\" => B::North,\n                \"LeftTrigger\" | \"LB\" => B::LeftTrigger,\n                \"RightTrigger\" | \"RB\" => B::RightTrigger,\n                \"Start\" => B::Start,\n                \"Select\" => B::Select,\n                \"DPadUp\" => B::DPadUp,\n                \"DPadDown\" => B::DPadDown,\n                \"DPadLeft\" => B::DPadLeft,\n                \"DPadRight\" => B::DPadRight,\n                o => return Err(format!(\"unknown button '{o}'\")),\n            })\n        };\n        let vec = |v: &str| -> Result<Vec2, String> {\n            let (x, y) = v.split_once(',').ok_or(format!(\"'{v}': want x,y\"))?;\n            Ok(Vec2::new(x.trim().parse().map_err(|_| format!(\"'{v}'\"))?, y.trim().parse().map_err(|_| format!(\"'{v}'\"))?))\n        };\n        let mut steps = Vec::new();\n        for (n, line) in text.lines().enumerate() {\n            let line = line.split('#').next().unwrap_or(\"\").trim();\n            if line.is_empty() {\n                continue;\n            }\n            let mut words = line.split_whitespace();\n            let frames = words.next().and_then(|w| w.parse().ok()).ok_or(format!(\"line {}: starts with a frame count\", n + 1))?;\n            let mut st = PadStep { frames, ..Default::default() };\n            for w in words {\n                let (k, v) = w.split_once('=').ok_or(format!(\"line {}: '{w}'\", n + 1))?;\n                match k {\n                    \"left\" => st.left = vec(v)?,\n                    \"right\" => st.right = vec(v)?,\n                    \"hold\" => st.hold = v.split(',').map(button).collect::<Result<_, _>>()?,\n                    \"tap\" => st.tap = v.split(',').map(button).collect::<Result<_, _>>()?,\n                    o => return Err(format!(\"line {}: unknown '{o}'\", n + 1)),\n                }\n            }\n            steps.push(st);\n        }\n        Ok(PadScript { steps, at: 0, frame: 0 })\n    }\n\n    /// This frame's step (and whether it's the step's first frame); None when done.\n    fn next(&mut self) -> Option<(PadStep, bool)> {\n        let st = self.steps.get(self.at)?.clone();\n        let first = self.frame == 0;\n        self.frame += 1;\n        if self.frame >= st.frames.max(1) {\n            self.at += 1;\n            self.frame = 0;\n        }\n        Some((st, first))\n    }\n}\n\nfn deadzone(v: Vec2, dz: f32) -> Vec2 {\n    let l = v.length();\n    if l < dz { Vec2::ZERO } else { v / l * ((l - dz) / (1.0 - dz)).min(1.0) }\n}\n\nimpl Input {\n    pub fn new() -> Self {\n        let gilrs = match gilrs::Gilrs::new() {\n            Ok(g) => {\n                for (_, gp) in g.gamepads() {\n                    log::info!(\"gamepad: {} ({:?})\", gp.name(), gp.power_info());\n                }\n                Some(g)\n            }\n            Err(e) => {\n                log::warn!(\"gamepads unavailable: {e}\");\n                None\n            }\n        };\n        Self {\n            keys: HashSet::new(),\n            mouse: HashSet::new(),\n            cursor: Vec2::ZERO,\n            mouse_active: false,\n            gilrs,\n            pad_script: None,\n            pad: Pad::default(),\n            last_device: Device::KeyboardMouse,\n            prev_held: 0,\n            key_taps: HashSet::new(),\n            mouse_taps: HashSet::new(),\n            bindings: Bindings::default(),\n            game: false,\n        }\n    }\n\n    pub fn key(&mut self, code: KeyCode, state: ElementState) {\n        self.last_device = Device::KeyboardMouse;\n        match state {\n            ElementState::Pressed => {\n                self.keys.insert(code);\n                self.key_taps.insert(code);\n            }\n            ElementState::Released => {\n                self.keys.remove(&code);\n            }\n        }\n    }\n\n    pub fn mouse_button(&mut self, b: MouseButton, state: ElementState) {\n        self.last_device = Device::KeyboardMouse;\n        self.mouse_active = true;\n        match state {\n            ElementState::Pressed => {\n                self.mouse.insert(b);\n                self.mouse_taps.insert(b);\n            }\n            ElementState::Released => {\n                self.mouse.remove(&b);\n            }\n        }\n    }\n\n    pub fn clear(&mut self) {\n        self.keys.clear();\n        self.mouse.clear();\n    }\n\n    /// Reads gamepad events and state (first connected pad).\n    pub fn poll_gamepad(&mut self) {\n        use gilrs::{Axis, Button};\n        let mut activity = false;\n        let mut taps = Vec::new();\n        // One pad state from the first connected pad, or from the pad script while it runs.\n        let mut state: Option<PadState> = None;\n        if let Some(g) = &mut self.gilrs {\n            while let Some(ev) = g.next_event() {\n                match ev.event {\n                    gilrs::EventType::ButtonPressed(b, _) => {\n                        taps.push(b);\n                        activity = true;\n                    }\n                    gilrs::EventType::AxisChanged(_, v, _) if v.abs() > 0.4 => activity = true,\n                    gilrs::EventType::Connected => log::info!(\"gamepad connected\"),\n                    gilrs::EventType::Disconnected => log::info!(\"gamepad disconnected\"),\n                    _ => {}\n                }\n            }\n            if let Some((_, gp)) = g.gamepads().next() {\n                const ALL: [Button; 15] = [\n                    Button::South,\n                    Button::East,\n                    Button::North,\n                    Button::West,\n                    Button::LeftTrigger,\n                    Button::RightTrigger,\n                    Button::Select,\n                    Button::Start,\n                    Button::DPadUp,\n                    Button::DPadDown,\n                    Button::DPadLeft,\n                    Button::DPadRight,\n                    Button::LeftThumb,\n                    Button::RightThumb,\n                    Button::Mode,\n                ];\n                let trig = |b: Button| gp.button_data(b).map(|d| d.value()).unwrap_or(0.0) > 0.35;\n                state = Some(PadState {\n                    left: Vec2::new(gp.value(Axis::LeftStickX), gp.value(Axis::LeftStickY)),\n                    right: Vec2::new(gp.value(Axis::RightStickX), gp.value(Axis::RightStickY)),\n                    held: ALL.into_iter().filter(|b| gp.is_pressed(*b)).collect(),\n                    lt2: trig(Button::LeftTrigger2),\n                    rt2: trig(Button::RightTrigger2),\n                });\n            }\n        }\n        if let Some(script) = &mut self.pad_script {\n            if let Some((st, first)) = script.next() {\n                if first {\n                    taps.extend(st.tap.iter().copied());\n                }\n                activity = true;\n                state = Some(PadState { left: st.left, right: st.right, held: st.hold.clone(), lt2: false, rt2: false });\n            }\n        }\n        let start = taps.contains(&Button::Start);\n        let map = taps.contains(&Button::DPadLeft);\n        let mut pad = Pad { start_pressed: start, map_pressed: map, taps, any_activity: activity, ..Default::default() };\n        if let Some(st) = state {\n            let is = |b: Button| st.held.contains(&b);\n            pad.left = deadzone(st.left, 0.18);\n            pad.right = deadzone(st.right, 0.25);\n            let mut held = 0;\n            let layout: &[(Button, u32)] = if self.game {\n                &[\n                    (Button::West, buttons::PRIMARY),\n                    (Button::North, buttons::SECONDARY),\n                    (Button::East, buttons::SKILL3),\n                    (Button::RightTrigger, buttons::SKILL4),\n                    (Button::LeftTrigger, buttons::SKILL5),\n                    (Button::South, buttons::DODGE),\n                    (Button::DPadUp, buttons::POTION),\n                    (Button::DPadRight, buttons::INTERACT),\n                ]\n            } else {\n                &[\n                    (Button::South, buttons::JUMP),\n                    (Button::East, buttons::CROUCH),\n                    (Button::North, buttons::CRAWL),\n                    (Button::West, buttons::USE),\n                    (Button::DPadRight, buttons::INTERACT),\n                ]\n            };\n            for (btn, action) in layout {\n                if is(*btn) {\n                    held |= action;\n                }\n            }\n            if st.rt2 {\n                held |= if self.game { buttons::SKILL6 } else { buttons::USE };\n            }\n            if st.lt2 {\n                held |= buttons::FOCUS;\n            }\n            pad.held = held;\n            pad.rotate = if self.game { 0.0 } else { (is(Button::RightTrigger) as i32 - is(Button::LeftTrigger) as i32) as f32 };\n            // In the game the D-pad is potion / use / map / panels, not zoom.\n            pad.zoom = if self.game { 0.0 } else { (is(Button::DPadDown) as i32 - is(Button::DPadUp) as i32) as f32 };\n            pad.a_held = is(Button::South);\n            pad.x_held = is(Button::West);\n            pad.y_held = is(Button::North);\n            pad.back_held = is(Button::Select);\n            if pad.left.length() > 0.3 || pad.right.length() > 0.3 || held != 0 {\n                pad.any_activity = true;\n            }\n        }\n        if pad.any_activity {\n            self.last_device = Device::Gamepad;\n        }\n        self.pad = pad;\n    }\n\n    /// Screen-space movement (x right, y up) from keys and stick, length <= 1.\n    pub fn move_axis(&self) -> Vec2 {\n        let k = |codes: &[KeyCode]| codes.iter().any(|c| self.keys.contains(c)) as i32 as f32;\n        let b = &self.bindings;\n        let kb = Vec2::new(k(&b.right) - k(&b.left), k(&b.up) - k(&b.down));\n        let v = if kb != Vec2::ZERO { kb.normalize() } else { self.pad.left };\n        v.clamp_length_max(1.0)\n    }\n\n    /// Held game buttons from all devices.\n    pub fn held(&self) -> u32 {\n        let mut b = self.pad.held;\n        for (bit, codes) in &self.bindings.buttons {\n            if codes.iter().any(|c| self.keys.contains(c)) {\n                b |= bit;\n            }\n        }\n        if self.mouse.contains(&MouseButton::Left) {\n            b |= buttons::PRIMARY;\n        }\n        if self.game && self.mouse.contains(&MouseButton::Right) {\n            b |= buttons::SECONDARY;\n        }\n        b\n    }\n\n    /// Returns (held, newly pressed since the last call).\n    pub fn buttons(&mut self) -> (u32, u32) {\n        let held = self.held();\n        let mut pressed = held & !self.prev_held;\n        for (bit, codes) in &self.bindings.buttons {\n            if codes.iter().any(|c| self.key_taps.contains(c)) {\n                pressed |= bit;\n            }\n        }\n        if self.mouse_taps.contains(&MouseButton::Left) {\n            pressed |= buttons::PRIMARY;\n        }\n        if self.game && self.mouse_taps.contains(&MouseButton::Right) {\n            pressed |= buttons::SECONDARY;\n        }\n        self.key_taps.clear();\n        self.mouse_taps.clear();\n        self.prev_held = held;\n        // A tap shorter than a frame still counts as held for that frame.\n        (held | pressed, pressed)\n    }\n\n    /// True if `b` was pressed since the last call (consumes the tap).\n    pub fn take_mouse_tap(&mut self, b: MouseButton) -> bool {\n        self.mouse_taps.remove(&b)\n    }\n\n    pub fn rewind_held(&self) -> bool {\n        self.keys.contains(&KeyCode::Backspace) || self.pad.back_held\n    }\n}\n\n#[cfg(test)]\nmod pad_script_tests {\n    use super::*;\n\n    #[test]\n    fn pad_scripts_parse_and_play() {\n        let mut p = PadScript::parse(\"# open the bag\\n2\\n1 tap=DPadDown\\n3 left=0.5,-1 hold=A,Y\\n\").unwrap();\n        assert_eq!(p.steps.len(), 3);\n        let frames: Vec<(PadStep, bool)> = std::iter::from_fn(|| p.next()).collect();\n        assert_eq!(frames.len(), 6);\n        assert!(frames[2].1 && frames[2].0.tap == vec![gilrs::Button::DPadDown]);\n        assert_eq!(frames[3].0.hold, vec![gilrs::Button::South, gilrs::Button::North]);\n        assert_eq!(frames[5].0.left, Vec2::new(0.5, -1.0));\n        assert!(PadScript::parse(\"x tap=A\").is_err());\n        assert!(PadScript::parse(\"1 tap=Q\").is_err());\n    }\n}\n\n    pub fn set_control(&self, f: impl FnOnce(&mut TimeControl)) {\n        f(&mut self.shared.control.lock().unwrap());\n    }\n}\n\n#[cfg(not(target_arch = \"wasm32\"))]\nimpl Drop for SimHost {\n    fn drop(&mut self) {\n        let _ = self.tx.send(Cmd::Quit);\n        if let Some(t) = self.thread.take() {\n            let _ = t.join();\n        }\n    }\n}\n\nfn publish(sim: &mut Sim, sh: &Shared, tick_wall: f32, at: Instant) {\n    let events = sim.drain_events();\n    if !events.is_empty() {\n        let mut q = sh.events.lock().unwrap();\n        q.extend(events);\n        let n = q.len();\n        if n > 512 {\n            q.drain(..n - 512);\n        }\n    }\n    let frame = Arc::new(sim.frame());\n    let mut f = sh.frames.lock().unwrap();\n    f.prev = std::mem::replace(&mut f.curr, frame);\n    f.curr_at = at;\n    f.tick_wall = tick_wall;\n}\n\n/// Fixed-rate ticking with time controls (pause, single steps, speed, rewind, scrubbing).\nstruct Clock {\n    next: Instant,\n    window_start: Instant,\n    window_ticks: u32,\n    busy: Duration,\n    rewound: bool,\n    studio_mode: pav_core::prop_preview::StudioMode,\n}\n\nimpl Clock {\n    fn new() -> Self {\n        Self {\n            next: Instant::now(),\n            window_start: Instant::now(),\n            window_ticks: 0,\n            busy: Duration::ZERO,\n            rewound: false,\n            studio_mode: pav_core::prop_preview::StudioMode::World,\n        }\n    }\n\n    /// Runs whatever is due now; returns how long until the next tick.\n    fn advance(&mut self, sim: &mut Sim, sh: &Shared) -> Duration {\n        let previewing = sim.studio_active();\n        let mode = sim.studio_mode();\n        if self.studio_mode != mode {\n            self.studio_mode = mode;\n            self.next = Instant::now();\n        }\n        let ctl = *sh.control.lock().unwrap();\n        // The animation stage has its own play, pause and speed controls. The world's time\n        // controls stay untouched, including a paused or rewound game behind the stage.\n        let tick_wall = if previewing { sim.dt() } else { sim.dt() / ctl.speed.clamp(0.01, 16.0) };\n        let (busy, window_ticks) = (&mut self.busy, &mut self.window_ticks);\n        let mut tick_once = |sim: &mut Sim, at: Instant| {\n            let input = if previewing {\n                InputFrame::default()\n            } else {\n                let mut i = sh.input.lock().unwrap();\n                let mut frame = *i;\n                i.pressed = 0;\n                frame.cmd = sh.cmds.lock().unwrap().pop_front();\n                frame\n            };\n            let stamp = if previewing { None } else { sh.input_stamp.lock().unwrap().take() };\n            let t = Instant::now();\n            sim.step(&input);\n            *busy += t.elapsed();\n            if let Some(s) = stamp {\n                *sh.latency_probe.lock().unwrap() = Some((s, Instant::now(), sim.state.tick));\n            }\n            *window_ticks += 1;\n            publish(sim, sh, tick_wall, at);\n        };\n\n        let now = Instant::now();\n        if previewing {\n            let mut n = 0;\n            while now >= self.next && n < 8 {\n                self.next += Duration::from_secs_f32(tick_wall);\n                tick_once(sim, self.next);\n                n += 1;\n            }\n            if n == 8 && now > self.next {\n                self.next = now;\n            }\n        } else if ctl.rewinding {\n            if now >= self.next {\n                self.next = now + Duration::from_secs_f32(sim.dt());\n                let oldest = sim.history.oldest_tick().unwrap_or(sim.state.tick);\n                let target = sim.state.tick.saturating_sub(ctl.rewind_speed.max(1) as u64).max(oldest);\n                if target < sim.state.tick && sim.rewind_to(target) {\n                    self.rewound = true;\n                }\n                let dt = sim.dt();\n                publish(sim, sh, dt, now);\n            }\n        } else if let Some(t) = ctl.scrub {\n            sh.control.lock().unwrap().scrub = None;\n            if sim.rewind_to(t) {\n                self.rewound = true;\n            }\n            let dt = sim.dt();\n            publish(sim, sh, dt, now);\n            self.next = now;\n        } else if ctl.paused {\n            if ctl.step_requests > 0 {\n                sh.control.lock().unwrap().step_requests -= 1;\n                if self.rewound {\n                    sim.commit_rewind();\n                    self.rewound = false;\n                }\n                tick_once(sim, now);\n            }\n            self.next = now;\n        } else {\n            if self.rewound {\n                // Acting after a rewind starts a new timeline.\n                sim.commit_rewind();\n                self.rewound = false;\n                self.next = now;\n            }\n            let mut n = 0;\n            while now >= self.next && n < 8 {\n                self.next += Duration::from_secs_f32(tick_wall);\n                tick_once(sim, self.next);\n                n += 1;\n            }\n            if n == 8 && now > self.next {\n                self.next = now; // too far behind: drop time instead of spiralling\n            }\n        }\n\n        let elapsed = self.window_start.elapsed();\n        if elapsed >= Duration::from_millis(500) {\n            let mut s = sh.stats.lock().unwrap();\n            s.tps = self.window_ticks as f32 / elapsed.as_secs_f32();\n            s.tick_ms = if self.window_ticks > 0 { self.busy.as_secs_f32() * 1000.0 / self.window_ticks as f32 } else { 0.0 };\n            s.tick = sim.state.tick;\n            s.entities = sim.state.entities.len();\n            s.oldest = sim.history.oldest_tick().unwrap_or(sim.state.tick);\n            s.newest = sim.history.newest_tick().unwrap_or(sim.state.tick).max(sim.state.tick);\n            s.history_mb = sim.history.approx_bytes() as f32 / 1.0e6;\n            s.rewound = self.rewound;\n            self.window_start = Instant::now();\n            self.window_ticks = 0;\n            self.busy = Duration::ZERO;\n        }\n        if ctl.paused && !previewing { Duration::from_millis(4) } else { self.next.saturating_duration_since(Instant::now()) }\n    }\n}\n\n#[cfg(not(target_arch = \"wasm32\"))]\nfn run(mut sim: Sim, rx: std::sync::mpsc::Receiver<Cmd>, sh: Arc<Shared>) {\n    use std::sync::mpsc::{RecvTimeoutError, TryRecvError};\n    let mut clock = Clock::new();\n    loop {\n        // Commands first.\n        loop {\n            match rx.try_recv() {\n                Ok(Cmd::Run(job)) => {\n                    job(&mut sim);\n                    let dt = sim.dt();\n                    publish(&mut sim, &sh, dt, Instant::now());\n                }\n                Ok(Cmd::Quit) => return,\n                Err(TryRecvError::Empty) => break,\n                Err(TryRecvError::Disconnected) => return,\n            }\n        }\n        let wait = clock.advance(&mut sim, &sh);\n        match rx.recv_timeout(wait) {\n            Ok(Cmd::Run(job)) => {\n                job(&mut sim);\n                let dt = sim.dt();\n                publish(&mut sim, &sh, dt, Instant::now());\n            }\n            Ok(Cmd::Quit) => return,\n            Err(RecvTimeoutError::Timeout) => {}\n            Err(RecvTimeoutError::Disconnected) => return,\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn preview_runs_over_a_paused_world_without_changing_its_time_controls() {\n        let mut sim = Sim::empty(1);\n        let shared = shared_for(&mut sim);\n        {\n            let mut control = shared.control.lock().unwrap();\n            control.paused = true;\n            control.speed = 8.0;\n        }\n        let mut clock = Clock::new();\n        clock.rewound = true;\n        sim.preview_open(Some(\"QUATERNIUS/Idle_Loop\"), None).unwrap();\n        clock.advance(&mut sim, &shared);\n        let time = sim.preview_info().unwrap().time;\n        assert!(time >= sim.dt() && time < sim.dt() * 2.0);\n        assert!(clock.rewound, \"opening a preview must not commit the world's rewind\");\n        assert_eq!(sim.state.tick, 0);\n        let control = *shared.control.lock().unwrap();\n        assert!(control.paused);\n        assert_eq!(control.speed, 8.0);\n        sim.preview_close();\n        clock.advance(&mut sim, &shared);\n        assert_eq!(sim.state.tick, 0, \"the paused world stays paused after closing\");\n        assert!(clock.rewound);\n    }\n}\n//! Scenes: the full world, small code-defined test scenes, and single rooms on their own.\n\nuse std::sync::Arc;\n\nuse anyhow::{Result, anyhow, bail};\nuse glam::{Quat, Vec3};\n\nuse crate::color::Color;\nuse crate::entity::{Behavior, BodyKind, Spawn};\nuse crate::level::Placement;\nuse crate::room::{self, RoomDef};\nuse crate::shape::{Look, Shape, Visual};\nuse crate::sim::Sim;\nuse crate::statics::Block;\nuse crate::world::{RoomSlot, World};\n\npub const SCENES: &[(&str, &str)] = &[\n    (\"world\", \"The pavilion with every room, surrounded by streaming wilderness. 'world/<room>' starts in a room.\"),\n    (\"test\", \"Lit test scene: a small plaza, every primitive and style, props raining onto a pyramid.\"),\n    (\"empty\", \"A single floor slab with a player.\"),\n    (\"arena\", \"Shardfall: the Proving Grounds, a wave arena (combat test ground).\"),\n    (\"town\", \"Shardfall: Emberwatch, the town (smith, stash, portal).\"),\n    (\"lab\", \"Shardfall: the Menagerie, a gallery of designed and generated creatures.\"),\n    (\"level\", \"Shardfall: a level of the descent. 'level/<n>' is depth n (1-12 designed, then the endless Depths).\"),\n];\n\n/// The scenes a menu offers: the built-in ones, then the games (`crate::games::GAMES`).\npub fn menu() -> Vec<(&'static str, &'static str)> {\n    SCENES.iter().copied().chain(crate::games::GAMES.iter().map(|g| (g.key, g.about))).collect()\n}\n\n/// All scene names, including standalone rooms (any room key builds just that room).\npub fn names() -> Vec<String> {\n    let mut v: Vec<String> = SCENES.iter().map(|s| s.0.to_string()).collect();\n    v.extend(crate::games::GAMES.iter().map(|g| g.key.to_string()));\n    let (rooms, _) = room::parse_all(&room::load_sources(room::rooms_dir().as_deref()));\n    v.extend(rooms.into_iter().map(|(k, _)| k));\n    v\n}\n\n/// Builds one room on its own at its layout origin (fast; used by tests and agents).\npub fn build_standalone_room(sim: &mut Sim, key: &str, def: RoomDef) {\n    let place = Placement::new(def.layout.origin, 0);\n    let (cols, rows) = def.layout.extent();\n    let (min, max) = place.aabb(Vec3::new(0.0, -1.0, 0.0), Vec3::new(cols as f32, def.height.max(2.0), rows as f32));\n    let start = def.local_start();\n    let inward = -def.entrance.facing.dir();\n    let def = Arc::new(def);\n    sim.state.world = World {\n        enabled: false,\n        rooms: vec![RoomSlot {\n            id: 0,\n            key: key.to_string(),\n            def: def.clone(),\n            place,\n            min,\n            max,\n            inside: place.point(start),\n            outside: place.point(start) - inward * 4.0,\n            inward,\n            built: false,\n        }],\n        current_room: Some(0),\n        ..Default::default()\n    };\n    sim.build_room(0);\n    // Player at the \"player\" marker if the layout has one, else inside the entrance.\n    let marker = def\n        .layout\n        .layers\n        .iter()\n        .any(|l| def.layout.legend.iter().any(|(k, t)| t.marker.as_deref() == Some(\"player\") && l.map.contains(k.as_str())));\n    sim.state.spawn = if marker { find_marker(&def, &place, \"player\").unwrap_or(place.point(start)) } else { place.point(start) };\n    sim.spawn_player();\n    sim.state.focus = sim.state.spawn;\n    sim.state.world.saved_params = crate::world::enter_overrides(&mut sim.config, &def);\n}\n\nfn find_marker(def: &RoomDef, place: &Placement, name: &str) -> Option<Vec3> {\n    all_markers(def, place, name).into_iter().next()\n}\n\nfn all_markers(def: &RoomDef, place: &Placement, name: &str) -> Vec<Vec3> {\n    let mut out = Vec::new();\n    for l in &def.layout.layers {\n        let lines = crate::level::rows(&l.map);\n        for (r, row) in lines.iter().enumerate() {\n            for (c, ch) in row.chars().enumerate() {\n                if def.layout.legend.get(&ch.to_string()).and_then(|t| t.marker.as_deref()) == Some(name) {\n                    let local = Vec3::new(l.at[0] as f32 + c as f32 + 0.5, l.y, l.at[1] as f32 + r as f32 + 0.5);\n                    out.push(place.point(local));\n                }\n            }\n        }\n    }\n    out\n}\n\n/// Every cell of the current room's layout whose legend says `marker = \"<name>\"`, in map\n/// order (row by row), as world positions on the floor. Games place their pieces this way.\npub fn markers(sim: &Sim, name: &str) -> Vec<Vec3> {\n    let w = &sim.state.world;\n    match w.current_room.and_then(|i| w.rooms.get(i as usize)) {\n        Some(slot) => all_markers(&slot.def, &slot.place, name),\n        None => Vec::new(),\n    }\n}\n\npub fn build(sim: &mut Sim, name: &str) -> Result<()> {\n    let (base, start_room) = match name.split_once('/') {\n        Some((b, r)) => (b, Some(r)),\n        None => (name, None),\n    };\n    if let Some(game) = crate::games::find(base) {\n        return (game.build)(sim, start_room);\n    }\n    match base {\n        \"world\" => {\n            let sources = room::load_sources(room::rooms_dir().as_deref());\n            let (defs, errors) = room::parse_all(&sources);\n            for (k, e) in &errors {\n                log::error!(\"room file '{k}': {e}\");\n            }\n            sim.build_world(defs, errors);\n            if let Some(r) = start_room {\n                if !sim.teleport_to_room(r) {\n                    bail!(\n                        \"unknown room '{r}' (known: {})\",\n                        sim.state.world.rooms.iter().map(|r| r.key.as_str()).collect::<Vec<_>>().join(\", \")\n                    );\n                }\n            }\n        }\n        \"test\" => test_scene(sim),\n        \"arena\" => crate::arpg::scene::build_arena(sim),\n        \"town\" => crate::arpg::scene::build_town(sim, None),\n        \"lab\" => crate::arpg::scene::build_lab(sim, None),\n        \"level\" => {\n            let n: u32 = match start_room {\n                Some(r) => r.parse().map_err(|_| anyhow!(\"level/<n>: '{r}' is not a depth\"))?,\n                None => 1,\n            };\n            crate::arpg::world::build_level(sim, n.max(1), None);\n        }\n        \"empty\" => {\n            floor(sim, 20);\n            sim.state.spawn = Vec3::new(0.5, 0.0, 0.5);\n            sim.spawn_player();\n        }\n        key => {\n            let sources = room::load_sources(room::rooms_dir().as_deref());\n            let Some(src) = sources.iter().find(|s| s.key == key) else {\n                bail!(\n                    \"unknown scene or room '{key}' (scenes: world, test, empty; games: {}; rooms: {})\",\n                    crate::games::GAMES.iter().map(|g| g.key).collect::<Vec<_>>().join(\", \"),\n                    sources.iter().map(|s| s.key.as_str()).collect::<Vec<_>>().join(\", \")\n                );\n            };\n            let def = RoomDef::parse(&src.text).map_err(|e| anyhow!(\"room '{key}': {e}\"))?;\n            build_standalone_room(sim, key, def);\n        }\n    }\n    Ok(())\n}\n\n/// A checkered floor of 1 m tiles from -half..half.\nfn floor(sim: &mut Sim, half: i32) {\n    let a = Color::hex(\"#8fbf7a\");\n    let b = Color::hex(\"#86b872\");\n    let st = &mut sim.state;\n    for x in -half..half {\n        for z in -half..half {\n            let c = if (x + z) % 2 == 0 { a } else { b };\n            st.statics.add(\n                &mut st.physics,\n                Block::new(Vec3::new(x as f32, -0.5, z as f32), Vec3::new(x as f32 + 1.0, 0.0, z as f32 + 1.0), c),\n            );\n        }\n    }\n}\n\nfn test_scene(sim: &mut Sim) {\n    floor(sim, 16);\n    let st = &mut sim.state;\n    // Low walls around a plaza and a stepped platform (heights: 0.5, 1.0, 1.5 m).\n    let wall = Color::hex(\"#d9cbb0\");\n    for i in -6..6 {\n        for (x, z) in [(i, -8), (i, 7), (-8, i), (7, i)] {\n            st.statics.add(\n                &mut st.physics,\n                Block::new(Vec3::new(x as f32, 0.0, z as f32), Vec3::new(x as f32 + 1.0, 1.0, z as f32 + 1.0), wall),\n            );\n        }\n    }\n    let step = Color::hex(\"#c9a27a\");\n    for (k, h) in [0.5f32, 1.0, 1.5].iter().enumerate() {\n        let x0 = 3.0 + k as f32 * 1.0;\n        st.statics.add(&mut st.physics, Block::new(Vec3::new(x0, 0.0, -5.0), Vec3::new(x0 + 1.0, *h, -2.0), step));\n    }\n\n    // Style gallery: the same shapes in flat / cel / lit.\n    let looks = [Look::Flat, Look::Cel, Look::Lit];\n    for (i, look) in looks.iter().enumerate() {\n        let x = -5.5 + i as f32 * 1.6;\n        let mut v = Visual::new(Shape::Sphere { radius: 0.5 }, Color::hex(\"#f2c14e\"));\n        v.look = *look;\n        sim.spawn(Spawn::new(\"gallery_sphere\", Vec3::new(x, 0.5, 4.5)).visual(v.clone()).body(BodyKind::Fixed));\n        v.shape = Shape::Capsule { half_height: 0.35, radius: 0.3 };\n        v.color = Color::hex(\"#9b5de5\");\n        sim.spawn(Spawn::new(\"gallery_capsule\", Vec3::new(x, 0.65, 2.8)).visual(v.clone()).body(BodyKind::Fixed));\n        v.shape = Shape::RoundedBox { half: Vec3::new(0.5, 0.35, 0.5), radius: 0.12 };\n        v.color = Color::hex(\"#5b8def\");\n        sim.spawn(Spawn::new(\"gallery_rbox\", Vec3::new(x, 0.35, 1.1)).visual(v.clone()).body(BodyKind::Fixed));\n        v.shape = Shape::Cylinder { half_height: 0.6, radius: 0.35 };\n        v.color = Color::hex(\"#b8b8c8\");\n        sim.spawn(Spawn::new(\"gallery_cylinder\", Vec3::new(x, 0.6, -0.6)).visual(v).body(BodyKind::Fixed));\n    }\n\n    // Pyramid of crates.\n    let crate_color = Color::hex(\"#e8704a\");\n    for layer in 0..4 {\n        let n = 4 - layer;\n        for i in 0..n {\n            for j in 0..n {\n                let p = Vec3::new(\n                    1.0 + (i as f32 - (n - 1) as f32 * 0.5) * 0.62,\n                    0.3 + layer as f32 * 0.6,\n                    3.0 + (j as f32 - (n - 1) as f32 * 0.5) * 0.62,\n                );\n                sim.spawn(\n                    Spawn::new(\"crate\", p)\n                        .visual(Visual::new(Shape::Box { half: Vec3::splat(0.3) }, crate_color))\n                        .body(BodyKind::Dynamic),\n                );\n            }\n        }\n    }\n\n    // A spinning platform (kinematic) and the prop rain above it.\n    let mut plat = Visual::new(Shape::Cylinder { half_height: 0.15, radius: 2.0 }, Color::hex(\"#6c7a89\"));\n    plat.look = Look::Cel;\n    sim.spawn(\n        Spawn::new(\"spinner\", Vec3::new(1.0, 0.4, 3.0))\n            .visual(plat)\n            .body(BodyKind::Kinematic)\n            .behavior(Behavior::Spin { speed: 0.6 }),\n    );\n    sim.spawn(Spawn::new(\"rain\", Vec3::new(1.0, 0.0, 3.0)).behavior(Behavior::Rain {\n        interval: 20,\n        max: 40,\n        area: 2.5,\n        height: 8.0,\n        timer: 0,\n        spawned: Default::default(),\n    }));\n\n    // Glowing marker.\n    let mut lamp = Visual::new(Shape::Sphere { radius: 0.25 }, Color::hex(\"#ffd27a\"));\n    lamp.look = Look::Unlit;\n    lamp.emissive = 1.5;\n    sim.spawn(Spawn::new(\"lamp\", Vec3::new(-3.0, 2.2, -3.0)).visual(lamp).rot(Quat::IDENTITY));\n    sim.state.focus = Vec3::new(0.0, 0.0, 1.0);\n}\n[package]\nname = \"pav_core\"\nversion.workspace = true\nedition.workspace = true\npublish.workspace = true\n\n[dependencies]\nglam.workspace = true\n# One-line physics precision switch: change package to \"rapier3d-f64\".\nrapier = { package = \"rapier3d\", version = \"0.36\", features = [\"serde-serialize\"] }\nserde.workspace = true\nserde_json.workspace = true\ntoml.workspace = true\nanyhow.workspace = true\nciborium.workspace = true\nlog.workspace = true\n\n[lints]\nworkspace = true\n[package]\nname = \"pav_ui\"\nversion.workspace = true\nedition.workspace = true\npublish.workspace = true\n\n[dependencies]\npav_core.workspace = true\nglam.workspace = true\negui.workspace = true\negui-wgpu.workspace = true\nwgpu.workspace = true\nserde.workspace = true\nweb-time.workspace = true\n\n[lints]\nworkspace = true\n[package]\nname = \"pav_view\"\nversion.workspace = true\nedition.workspace = true\npublish.workspace = true\n\n[dependencies]\npav_core.workspace = true\npav_render.workspace = true\nglam.workspace = true\nserde.workspace = true\ntoml.workspace = true\n\n[dev-dependencies]\nserde_json.workspace = true\n\n[lints]\nworkspace = true\n[package]\nname = \"pav_audio\"\nversion.workspace = true\nedition.workspace = true\npublish.workspace = true\n\n[dependencies]\npav_core.workspace = true\nglam.workspace = true\ncpal.workspace = true\nanyhow.workspace = true\nlog.workspace = true\n\n# Web Audio in the browser build.\n[target.'cfg(target_arch = \"wasm32\")'.dependencies]\ncpal = { workspace = true, features = [\"wasm-bindgen\"] }\n\n[lints]\nworkspace = true\n23:egui = \"0.36.2\"\n24:egui-wgpu = { version = \"0.36.2\", default-features = false }\n25:egui-winit = { version = \"0.36.2\", default-features = false, features = [\"links\"] }\n26:gilrs = \"0.11\"\n34:toml = \"1\"\n36:ciborium = \"0.2\"\n49:web-sys = \"0.3\"\n631:pub struct ViewBuilder {\n702:    pub fn new() -> Self {\n721:    pub fn add_events(&mut self, events: &[SimEvent]) {\n980:    pub fn build(\n1435:            self.arpg.emit(&mut scene, curr, g, alpha, time, dt, settings.particles, cam_fwd);\n   Compiling wgpu-core-deps-windows-linux-android v30.0.1\n   Compiling unicode-segmentation v1.13.3\n","numLines":1151,"startLine":60,"totalLines":1210}},"tool_result_meta":[{"id":"toolu_01FUb3iUvY1UzT6ybMtr8XJQ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
