{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjyVn3xgK9Z12HMZq3Zc","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01HxWTjJsGXpW9mSgQuJ1jck","name":"Bash","input":{"command":"mkdir -p crates/pav_view/src/surgery; cat > crates/pav_view/src/surgery/plate.rs <<'EOF'\n//! The operative field: one `DynamicMesh` per frame, a grid over 22×12.6 units in `Style::Cel`,\n//! with per-vertex colour doing the painting. A plate's heightfield and veins are cached; hazards\n//! stamp into height and colour each frame. A hard band where `n·h` is high makes it read as wet.\n\nuse std::collections::HashMap;\n\nuse glam::{Vec2, Vec3};\nuse pav_core::games::surgery::content::{Content, Plate};\nuse pav_core::games::surgery::field::{Hazard, Kind, sub};\nuse pav_core::games::surgery::frame::SurgeryFrame;\nuse pav_render::mesh::{MeshData, Vertex};\nuse pav_render::scene::{self as rs, DynamicMesh, Scene, Style};\n\npub const NX: usize = 420;\npub const NZ: usize = 240;\nconst WIDE: f32 = 22.0;\nconst DEEP: f32 = 12.6;\n\npub fn grid_x(i: usize) -> f32 {\n    -WIDE * 0.5 + WIDE * i as f32 / (NX - 1) as f32\n}\npub fn grid_z(j: usize) -> f32 {\n    -DEEP * 0.5 + DEEP * j as f32 / (NZ - 1) as f32\n}\n\nfn hash2(x: i32, z: i32) -> f32 {\n    let mut h = (x as u32).wrapping_mul(374_761_393).wrapping_add((z as u32).wrapping_mul(668_265_263));\n    h = (h ^ (h >> 13)).wrapping_mul(1_274_126_177);\n    ((h ^ (h >> 16)) & 0xffff) as f32 / 65535.0\n}\n\n/// Value noise, 0..1.\npub fn noise(x: f32, z: f32) -> f32 {\n    let (xi, zi) = (x.floor(), z.floor());\n    let (fx, fz) = (x - xi, z - zi);\n    let (u, v) = (fx * fx * (3.0 - 2.0 * fx), fz * fz * (3.0 - 2.0 * fz));\n    let (i, j) = (xi as i32, zi as i32);\n    let a = hash2(i, j) + (hash2(i + 1, j) - hash2(i, j)) * u;\n    let b = hash2(i, j + 1) + (hash2(i + 1, j + 1) - hash2(i, j + 1)) * u;\n    a + (b - a) * v\n}\n\nfn fbm(x: f32, z: f32) -> f32 {\n    noise(x, z) * 0.55 + noise(x * 2.1 + 3.3, z * 2.1 + 1.7) * 0.3 + noise(x * 4.3 + 7.1, z * 4.3 + 5.3) * 0.15\n}\n\nfn smooth(a: f32, b: f32, x: f32) -> f32 {\n    let t = ((x - a) / (b - a)).clamp(0.0, 1.0);\n    t * t * (3.0 - 2.0 * t)\n}\n\nfn hex3(s: &str) -> [f32; 3] {\n    rs::hex(s).unwrap_or(Vec3::splat(0.5)).to_array()\n}\n\nfn mix(a: [f32; 3], b: [f32; 3], t: f32) -> [f32; 3] {\n    let t = t.clamp(0.0, 1.0);\n    [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t]\n}\n\npub fn srgb3(r: u8, g: u8, b: u8) -> [f32; 3] {\n    rs::srgb(r, g, b).to_array()\n}\n\nstruct Base {\n    h: Vec<f32>,\n    vein: Vec<f32>,\n    /// 1 inside the opening, 0 on the drape.\n    open: Vec<f32>,\n    bed: [f32; 3],\n    flesh: [f32; 3],\n    top: [f32; 3],\n    vein_c: [f32; 3],\n    pulse: f32,\n    bone: bool,\n    height_top: f32,\n}\n\nfn seg_dist(p: Vec2, a: Vec2, b: Vec2) -> f32 {\n    let ab = b - a;\n    let t = ((p - a).dot(ab) / ab.length_squared().max(1e-5)).clamp(0.0, 1.0);\n    p.distance(a + ab * t)\n}\n\nfn build_base(p: &Plate) -> Base {\n    let n = NX * NZ;\n    let (mut h, mut vein, mut open) = (vec![0.0; n], vec![0.0; n], vec![0.0; n]);\n    let mut top = 0.3f32;\n    for j in 0..NZ {\n        for i in 0..NX {\n            let (x, z) = (grid_x(i), grid_z(j));\n            let mut v = 0.0f32;\n            for l in &p.lobes {\n                let (dx, dz) = (x - l.x, z - l.z);\n                let e = (1.0 - dx * dx / l.a.max(0.01) - dz * dz / l.b.max(0.01)).max(0.0);\n                if e > 0.0 {\n                    v = v.max(l.h * e.powf(0.55));\n                }\n            }\n            v += (fbm(x * 0.7, z * 0.7) - 0.5) * p.noise * 2.0;\n            let q = Vec2::new(x, z);\n            let mut vessel = 0.0f32;\n            for s in &p.vessels {\n                for w in s.points.windows(2) {\n                    let d = seg_dist(q, Vec2::new(w[0][0], w[0][1]), Vec2::new(w[1][0], w[1][1]));\n                    vessel = vessel.max((1.0 - d / s.w.max(0.01)).max(0.0).sqrt() * s.h / 0.1);\n                    v += (1.0 - d / s.w.max(0.01)).max(0.0).sqrt() * s.h * 0.2;\n                }\n            }\n            // Veins: thin ridges of noise.\n            let ridge = 1.0 - (fbm(x * 1.2 + 9.0, z * 1.2 - 4.0) * 2.0 - 1.0).abs() * 14.0;\n            let veiny = ridge.max(0.0) * p.veins;\n            // The opening in the drape.\n            let (ex, ez) = ((x.abs() - 9.3).max(0.0), (z.abs() - 4.75).max(0.0));\n            let d = (ex * ex + ez * ez).sqrt() + (noise(x * 2.0, z * 2.0) - 0.5) * 0.06;\n            let inside = 1.0 - smooth(0.0, 0.14, d);\n            let idx = j * NX + i;\n            h[idx] = v.max(0.0) * inside + (1.0 - inside) * (0.62 + (fbm(x * 0.8, z * 1.4 + 2.0) - 0.5) * 0.25);\n            vein[idx] = veiny.max(vessel.min(1.0));\n            open[idx] = inside;\n            top = top.max(v);\n        }\n    }\n    Base {\n        h,\n        vein,\n        open,\n        bed: hex3(&p.bed),\n        flesh: hex3(&p.flesh),\n        top: hex3(&p.top),\n        vein_c: hex3(&p.vein),\n        pulse: p.pulse,\n        bone: p.bone,\n        height_top: top,\n    }\n}\n\n#[derive(Default)]\npub struct PlateView {\n    bases: HashMap<String, Base>,\n    /// This frame's height and colour.\n    pub h: Vec<f32>,\n    c: Vec<[f32; 3]>,\n    indices: Vec<u32>,\n}\n\npub struct Paint {\n    pub palette_clinical: bool,\n    pub time: f32,\n}\n\nimpl PlateView {\n    /// The tissue's height at a field point this frame.\n    pub fn height(&self, p: Vec2) -> f32 {\n        if self.h.is_empty() {\n            return 0.0;\n        }\n        let i = (((p.x + WIDE * 0.5) / WIDE) * (NX - 1) as f32).clamp(0.0, (NX - 2) as f32);\n        let j = (((p.y + DEEP * 0.5) / DEEP) * (NZ - 1) as f32).clamp(0.0, (NZ - 2) as f32);\n        let (i0, j0) = (i as usize, j as usize);\n        let (u, v) = (i - i0 as f32, j - j0 as f32);\n        let g = |a: usize, b: usize| self.h[b * NX + a];\n        let top = g(i0, j0) + (g(i0 + 1, j0) - g(i0, j0)) * u;\n        let bot = g(i0, j0 + 1) + (g(i0 + 1, j0 + 1) - g(i0, j0 + 1)) * u;\n        top + (bot - top) * v\n    }\n\n    fn base_for(&mut self, c: &Content, id: u8) {\n        let key = c.plate_order.get(id as usize).cloned().unwrap_or_default();\n        if !self.bases.contains_key(&key) {\n            if let Some(p) = c.plates.get(&key) {\n                self.bases.insert(key, build_base(p));\n            }\n        }\n    }\n\n    fn stamp(&mut self, cx: f32, cz: f32, r: f32, mut f: impl FnMut(&mut f32, &mut [f32; 3], f32, f32, f32)) {\n        let to_i = |x: f32| ((x + WIDE * 0.5) / WIDE * (NX - 1) as f32) as i32;\n        let to_j = |z: f32| ((z + DEEP * 0.5) / DEEP * (NZ - 1) as f32) as i32;\n        let (i0, i1) = (to_i(cx - r).max(0), (to_i(cx + r) + 1).min(NX as i32 - 1));\n        let (j0, j1) = (to_j(cz - r).max(0), (to_j(cz + r) + 1).min(NZ as i32 - 1));\n        for j in j0..=j1 {\n            for i in i0..=i1 {\n                let (x, z) = (grid_x(i as usize), grid_z(j as usize));\n                let d = ((x - cx).powi(2) + (z - cz).powi(2)).sqrt();\n                if d <= r {\n                    let k = j as usize * NX + i as usize;\n                    f(&mut self.h[k], &mut self.c[k], d, x, z);\n                }\n            }\n        }\n    }\n\n    /// A painted line: `f(height, colour, across 0..1)`.\n    fn stroke(&mut self, a: Vec2, b: Vec2, w: f32, mut f: impl FnMut(&mut f32, &mut [f32; 3], f32, f32)) {\n        let (lo, hi) = (a.min(b) - Vec2::splat(w), a.max(b) + Vec2::splat(w));\n        let to_i = |x: f32| ((x + WIDE * 0.5) / WIDE * (NX - 1) as f32) as i32;\n        let to_j = |z: f32| ((z + DEEP * 0.5) / DEEP * (NZ - 1) as f32) as i32;\n        let ab = b - a;\n        let len2 = ab.length_squared().max(1e-5);\n        for j in to_j(lo.y).max(0)..=(to_j(hi.y) + 1).min(NZ as i32 - 1) {\n            for i in to_i(lo.x).max(0)..=(to_i(hi.x) + 1).min(NX as i32 - 1) {\n                let q = Vec2::new(grid_x(i as usize), grid_z(j as usize));\n                let t = ((q - a).dot(ab) / len2).clamp(0.0, 1.0);\n                let d = q.distance(a + ab * t);\n                if d <= w {\n                    let k = j as usize * NX + i as usize;\n                    f(&mut self.h[k], &mut self.c[k], d / w, t);\n                }\n            }\n        }\n    }\n\n    /// Builds the frame's field into the scene.\n    pub fn emit(&mut self, scene: &mut Scene, f: &SurgeryFrame, c: &Content, paint: &Paint) {\n        self.base_for(c, f.plate);\n        self.base_for(c, f.plate_prev);\n        let n = NX * NZ;\n        self.h.resize(n, 0.0);\n        self.c.resize(n, [0.0; 3]);\n        let key = c.plate_order.get(f.plate as usize).cloned().unwrap_or_default();\n        let prev_key = c.plate_order.get(f.plate_prev as usize).cloned().unwrap_or_default();\n        // The tissue pulses on the beat: a sharp systole, a slow fall, plus a breathing swell.\n        let b = f.beat;\n        let systole = if f.stopped { 0.0 } else { (-b * 7.0).exp() * (b * 40.0).min(1.0) + 0.35 * (-((b - 0.28) * 9.0).powi(2)).exp() };\n        let breath = (paint.time * 1.1).sin() * 0.012;\n        let drape = srgb3(34, 112, 116);\n        let drape_dark = srgb3(18, 70, 74);\n        let heat = f.fever.map(|v| (v / 100.0).clamp(0.0, 1.2)).unwrap_or(0.0);\n        let fever_c = srgb3(255, 120, 40);\n        {\n            let Some(base) = self.bases.get(&key) else { return };\n            let prev = self.bases.get(&prev_key).unwrap_or(base);\n            let front = f.reveal.clamp(0.0, 1.0) * 16.0;\n            let blending = f.reveal < 1.0;\n            for j in 0..NZ {\n                for i in 0..NX {\n                    let k = j * NX + i;\n                    let mut pick = base;\n                    let mut blend = 1.0;\n                    if blending {\n                        let d = Vec2::new(grid_x(i), grid_z(j)).distance(f.reveal_at);\n                        blend = smooth(front + 0.8, front - 0.8, d);\n                        if blend < 0.5 {\n                            pick = prev;\n                        }\n                    }\n                    let open = base.open[k];\n                    let top = pick.height_top.max(0.3);\n                    let raw = if blending { prev.h[k] + (base.h[k] - prev.h[k]) * blend } else { base.h[k] };\n                    let amp = (pick.pulse * systole + breath) * open;\n                    let h = raw * (1.0 + amp);\n                    self.h[k] = h;\n                    let t = (raw / top).clamp(0.0, 1.0);\n                    let mut col = if t < 0.45 { mix(pick.bed, pick.flesh, t / 0.45) } else { mix(pick.flesh, pick.top, (t - 0.45) / 0.55) };\n                    col = mix(col, pick.vein_c, pick.vein[k] * 0.85);\n                    if pick.bone && t > 0.72 {\n                        col = mix(col, srgb3(236, 226, 196), smooth(0.72, 0.8, t));\n                    }\n                    if heat > 0.0 {\n                        col = mix(col, fever_c, heat * 0.28 * t);\n                    }\n                    if open < 1.0 {\n                        let cloth = mix(drape_dark, drape, smooth(0.45, 0.8, raw));\n                        col = mix(cloth, col, open);\n                    }\n                    self.c[k] = col;\n                }\n            }\n        }\n        self.stamps(f, paint);\n        if paint.palette_clinical {\n            for col in &mut self.c {\n                let l = col[0] * 0.3 + col[1] * 0.55 + col[2] * 0.15;\n                *col = [l * 0.72, l * 0.86, l * 1.02];\n            }\n        }\n        self.mesh(scene, paint);\n    }\n\n    fn stamps(&mut self, f: &SurgeryFrame, paint: &Paint) {\n        let t = paint.time;\n        let cut = srgb3(44, 8, 14);\n        let pool_c = srgb3(120, 6, 16);\n        let dash = srgb3(255, 236, 150);\n        for s in &f.stains {\n            let col = match s.kind {\n                0 => srgb3(120, 30, 34),\n                1 => srgb3(46, 28, 26),\n                _ => srgb3(150, 216, 196),\n            };\n            let (r, at) = (s.r, s.at);\n            self.stamp(at.x, at.y, r * 1.3, |_, c, d, x, z| {\n                let e = d + (noise(x * 3.0, z * 3.0) - 0.5) * r * 0.5;\n                if e < r {\n                    *c = mix(*c, col, 0.32 * (1.0 - e / r));\n                }\n            });\n        }\n        for h in &f.hazards {\n            self.stamp_hazard(h, f, cut, pool_c, dash, t);\n        }\n        if let Some(radius) = f.heat_ring {\n            let col = srgb3(255, 170, 60);\n            self.stamp(0.0, 0.0, radius + 0.6, |h, c, d, _, _| {\n                let e = (d - radius).abs();\n                if e < 0.5 {\n                    let k = 1.0 - e / 0.5;\n                    *h += k * 0.12;\n                    *c = mix(*c, col, k * 0.95);\n                }\n            });\n        }\n    }\n\n    fn path_stamps(&mut self, h: &Hazard, cut: [f32; 3], dash: [f32; 3], groove: f32, t: f32, white: bool) {\n        let len = h.path_len().max(0.4);\n        let steps = (len / 0.09) as i32;\n        let pulse = 0.8 + 0.2 * (t * 5.0).sin();\n        for k in 0..steps {\n            let s = k as f32 / steps as f32;\n            let p = h.path(s);\n            let q = h.path((k + 1) as f32 / steps as f32);\n            if s < h.prog {\n                if white {\n                    self.stroke(p, q, 0.3, |hh, c, a, _| {\n                        *hh += (1.0 - a * a) * 0.09;\n                        *c = mix(*c, srgb3(238, 240, 232), 1.0 - a * a * 0.5);\n                    });\n                } else {\n                    self.stroke(p, q, 0.13, |hh, c, a, _| {\n                        *hh -= (1.0 - a) * groove;\n                        *c = mix(*c, cut, 1.0 - a * 0.6);\n                    });\n                }\n            } else if k % 6 < 4 {\n                let w = 0.075;\n                let col = dash;\n                self.stroke(p, q, w, |_, c, a, _| {\n                    *c = mix(*c, col, (1.0 - a * a) * pulse);\n                });\n            }\n        }\n    }\n\n    fn stamp_hazard(&mut self, h: &Hazard, f: &SurgeryFrame, cut: [f32; 3], pool_c: [f32; 3], dash: [f32; 3], t: f32) {\n        let a = h.a;\n        match h.kind {\n            Kind::Incision => self.path_stamps(h, cut, dash, 0.2, t, false),\n            Kind::Closure => self.path_stamps(h, cut, srgb3(250, 250, 240), 0.0, t, true),\n            Kind::Lacer | Kind::Bleeder => {\n                let seed = h.id as f32 * 3.7;\n                let steps = 14;\n                let width = if h.kind == Kind::Bleeder { 0.2 } else { 0.17 };\n                let dir = (h.b - h.a).normalize_or_zero().perp();\n                let mut last = h.a;\n                for k in 1..=steps {\n                    let s = k as f32 / steps as f32;\n                    let wiggle = (noise(s * 5.0 + seed, seed) - 0.5) * 0.3 * (s * std::f32::consts::PI).sin();\n                    let p = h.a.lerp(h.b, s) + dir * wiggle;\n                    let closed = s < h.prog;\n                    let taper = (s * std::f32::consts::PI).sin().powf(0.5);\n                    let w = (width * taper).max(0.05) * if closed { 0.45 } else { 1.0 };\n                    let c0 = if closed { srgb3(150, 50, 60) } else { cut };\n                    self.stroke(last, p, w + 0.16, |hh, c, a_, _| {\n                        let inner = w / (w + 0.16);\n                        if a_ < inner {\n                            *hh -= 0.14;\n                            *c = mix(*c, c0, 1.0 - a_ * 0.3);\n                        } else {\n                            *hh += (1.0 - a_) * 0.2;\n                            *c = mix(*c, srgb3(226, 110, 100), (1.0 - a_) * 0.75);\n                        }\n                    });\n                    last = p;\n                }\n            }\n            Kind::Pool => {\n                let caustic = h.sub == sub::CAUSTIC;\n                let col = if caustic { srgb3(150, 170, 40) } else { pool_c };\n                let r = h.r;\n                let seed = h.id as f32;\n                let cx = a.x;\n                let cz = a.y;\n                let film = self.height(a) + 0.05;\n                self.stamp(a.x, a.y, r * 1.4, |hh, c, d, x, z| {\n                    let ang = (z - cz).atan2(x - cx);\n                    let e = d + (noise(ang * 1.5 + seed, seed) - 0.5) * r * 0.45 + (noise(x * 3.0 + seed, z * 3.0) - 0.5) * 0.12;\n                    if e < r {\n                        let k = smooth(r, r - 0.14, e);\n                        *hh = *hh + (film.max(*hh) + 0.02 - *hh) * k;\n                        *c = mix(*c, col, k);\n                    }\n                });\n            }\n            Kind::Patch => {\n                let burn = h.sub == sub::BURN;\n                let r = h.r;\n                let col = if burn { srgb3(40, 24, 22) } else { srgb3(232, 70, 60) };\n                let gel = srgb3(170, 232, 214);\n                let cover = h.prog;\n                let seed = h.id as f32;\n                self.stamp(a.x, a.y, r * 1.2, |hh, c, d, x, z| {\n                    let n = noise(x * 2.6 + seed, z * 2.6);\n                    let e = d + (n - 0.5) * r * 0.5;\n                    if e < r {\n                        let k = smooth(r, r * 0.7, e);\n                        *hh += k * 0.05 * (0.5 + n);\n                        *c = mix(*c, col, k * 0.85);\n                        // The gel covers it from the outside in.\n                        if d > r * (1.0 - cover) {\n                            *c = mix(*c, gel, 0.8);\n                            *hh += 0.03;\n                        }\n                    }\n                });\n            }\n            Kind::Tumor => {\n                let r = h.r;\n                let col = srgb3(96, 52, 88);\n                if h.stage == 0 {\n                    self.stamp(a.x, a.y, r, |hh, c, d, _, _| {\n                        let k = smooth(r, r * 0.3, d);\n                        *hh += k * 0.5;\n                        *c = mix(*c, col, k);\n                    });\n                    self.path_stamps(h, cut, dash, 0.18, t, false);\n                } else if h.stage == 1 {\n                    self.stamp(a.x, a.y, r, |hh, c, d, _, _| {\n                        let k = smooth(r, r * 0.65, d);\n                        *hh += k * 0.3;\n                        *c = mix(*c, col, k);\n                        if (d - r * 0.92).abs() < 0.1 {\n                            *c = cut;\n                            *hh -= 0.15;\n                        }\n                    });\n                } else {\n                    let gel = srgb3(170, 232, 214);\n                    let cover = h.prog;\n                    self.stamp(a.x, a.y, r, |hh, c, d, _, _| {\n                        let k = smooth(r, r * 0.8, d);\n                        *hh -= k * 0.3;\n                        *c = mix(*c, cut, k * 0.85);\n                        if d > r * (1.0 - cover) {\n                            *c = mix(*c, gel, 0.85);\n                        }\n                    });\n                }\n            }\n            Kind::Bone => {\n                if h.stage == 0 {\n                    let (seat, w) = (h.b, h.r);\n                    let col = srgb3(70, 26, 30);\n                    self.stamp(seat.x, seat.y, w, |hh, c, d, _, _| {\n                        let k = smooth(w, w * 0.6, d);\n                        *hh -= k * 0.2;\n                        *c = mix(*c, col, k);\n                    });\n                }\n            }\n            Kind::Nodule => {\n                // A bump travelling under the tissue, visible even before the Scanner finds it.\n                let r = h.r * 1.6;\n                let tele = if h.telegraph { 0.25 + 0.2 * (t * 16.0).sin() } else { 0.0 };\n                let violet = srgb3(120, 60, 150);\n                let vis = h.visible();\n                self.stamp(a.x, a.y, r + if h.telegraph { 1.1 } else { 0.0 }, |hh, c, d, _, _| {\n                    let k = smooth(r, r * 0.2, d);\n                    *hh += k * (0.34 + tele * 0.5);\n                    if vis {\n                        *c = mix(*c, violet, k * 0.65);\n                    } else {\n                        *c = mix(*c, violet, k * 0.2);\n                    }\n                    if tele > 0.0 && (d - (r + 0.5)).abs() < 0.12 {\n                        *hh += 0.07;\n                        *c = mix(*c, violet, 0.5);\n                    }\n                });\n            }\n            Kind::Ember | Kind::Furnace => {\n                let r = h.r * 2.1;\n                let hot = srgb3(255, 130, 40);\n                let frost = srgb3(190, 230, 255);\n                let frozen = (h.kind == Kind::Ember && h.stage == 1) || (h.kind == Kind::Furnace && h.stage == 1);\n                self.stamp(a.x, a.y, r, |_, c, d, _, _| {\n                    let k = smooth(r, 0.0, d);\n                    *c = mix(*c, if frozen { frost } else { hot }, k * k * 0.85);\n                });\n            }\n            Kind::Eye => {\n                let r = h.r * 1.6;\n                let col = srgb3(36, 18, 66);\n                self.stamp(a.x, a.y, r, |hh, c, d, _, _| {\n                    let k = smooth(r, r * 0.5, d);\n                    *hh += k * 0.25;\n                    *c = mix(*c, col, k * 0.9);\n                });\n            }\n            Kind::Tendril => {\n                let col = srgb3(58, 26, 96);\n                let (p, q) = (h.a, h.a.lerp(h.b, 1.0 - h.prog * 0.9));\n                self.stroke(p, q, 0.34, |hh, c, a_, _| {\n                    *hh += (1.0 - a_) * 0.16;\n                    *c = mix(*c, col, 1.0 - a_ * 0.6);\n                });\n            }\n            Kind::Sac => {\n                let (p, q) = (h.b, h.a);\n                let col = srgb3(70, 30, 96);\n                self.stroke(p, q, 0.13, |hh, c, a_, _| {\n                    *hh += (1.0 - a_) * 0.08;\n                    *c = mix(*c, col, 1.0 - a_ * 0.5);\n                });\n            }\n            Kind::Object | Kind::Polyp => {\n                let r = h.r * 0.8;\n                let col = cut;\n                self.stamp(a.x, a.y, r, |hh, c, d, _, _| {\n                    let k = smooth(r, r * 0.3, d);\n                    *hh += k * 0.02;\n                    *c = mix(*c, col, k * 0.45);\n                });\n            }\n        }\n        let _ = f;\n    }\n\n    fn mesh(&mut self, scene: &mut Scene, paint: &Paint) {\n        // A wet highlight: the lamp's half vector, hardened to a band.\n        let half = Vec3::new(-0.08, 1.0, 0.32).normalize();\n        let (dx, dz) = (WIDE / (NX - 1) as f32, DEEP / (NZ - 1) as f32);\n        let mut verts = Vec::with_capacity(NX * NZ);\n        for j in 0..NZ {\n            for i in 0..NX {\n                let k = j * NX + i;\n                let hl = self.h[if i > 0 { k - 1 } else { k }];\n                let hr = self.h[if i + 1 < NX { k + 1 } else { k }];\n                let hd = self.h[if j > 0 { k - NX } else { k }];\n                let hu = self.h[if j + 1 < NZ { k + NX } else { k }];\n                let n = Vec3::new((hl - hr) / (2.0 * dx), 1.0, (hd - hu) / (2.0 * dz)).normalize();\n                let wet = n.dot(half);\n                let mut col = self.c[k];\n                // A hard band reads as wet tissue, and only on the tissue.\n                let band = smooth(0.988, 0.992, wet) * smooth(0.25, 0.5, self.h[k]);\n                col = mix(col, [1.0, 0.96, 0.92], band * 0.5);\n                debug_assert!(self.h[k].is_finite() && n.is_finite(), \"NaN in the plate\");\n                verts.push(Vertex {\n                    pos: [grid_x(i), self.h[k], grid_z(j)],\n                    normal: n.to_array(),\n                    uv: [i as f32 / NX as f32, j as f32 / NZ as f32],\n                    color: [col[0], col[1], col[2], 1.0],\n                });\n            }\n        }\n        if self.indices.is_empty() {\n            for j in 0..NZ - 1 {\n                for i in 0..NX - 1 {\n                    let a = (j * NX + i) as u32;\n                    let b = a + 1;\n                    let c = a + NX as u32;\n                    let d = c + 1;\n                    self.indices.extend_from_slice(&[a, c, b, b, c, d]);\n                }\n            }\n        }\n        let _ = paint;\n        scene.dynamic.push(DynamicMesh {\n            data: MeshData { vertices: verts, indices: self.indices.clone() },\n            color: Vec3::ONE,\n            emissive: 0.0,\n            style: Style::Cel,\n            flags: 0,\n            group: 1,\n            material: 0,\n        });\n    }\n}\nEOF\ncat > crates/pav_view/src/surgery/instruments.rs <<'EOF'\n//! The instruments: built in code from SDF rounded cones, so parts can animate (forceps tips open,\n//! the needle arcs, the plunger moves, the suction shudders). They cast real shadows on the tissue,\n//! an essential depth cue. The same model sits on the steel tray and in the hand.\n\nuse glam::{Mat3, Mat4, Quat, Vec2, Vec3};\nuse pav_core::games::surgery::field::Tool;\nuse pav_render::scene::{self as rs, MeshInstance, MeshKey, Scene, SdfInstance, Style};\n\n#[derive(Clone, Copy)]\npub struct P {\n    pub a: Vec3,\n    pub b: Vec3,\n    pub ra: f32,\n    pub rb: f32,\n    pub c: Vec3,\n    pub e: f32,\n}\n\nfn steel() -> Vec3 {\n    Vec3::new(0.72, 0.76, 0.8)\n}\nfn dark() -> Vec3 {\n    Vec3::new(0.09, 0.1, 0.12)\n}\nfn p(a: [f32; 3], b: [f32; 3], ra: f32, rb: f32, c: Vec3) -> P {\n    P { a: Vec3::from_array(a), b: Vec3::from_array(b), ra, rb, c, e: 0.0 }\n}\nfn glow(mut x: P, e: f32) -> P {\n    x.e = e;\n    x\n}\n\n/// How an instrument is moving right now.\n#[derive(Clone, Copy, Default)]\npub struct Motion {\n    pub using: bool,\n    pub pressure: f32,\n    pub time: f32,\n    /// The gesture's meter: heat, frost, dose.\n    pub meter: f32,\n    pub recoil: f32,\n}\n\n/// The model in its own frame: the tip at the origin, the handle along +Y, about 3.2 units long.\npub fn parts(tool: Tool, m: Motion) -> Vec<P> {\n    let mut v = Vec::new();\n    let s = steel();\n    let t = m.time;\n    match tool {\n        Tool::Scalpel => {\n            v.push(p([0.0, 0.0, 0.0], [0.02, 0.52, 0.0], 0.012, 0.085, Vec3::new(0.9, 0.93, 0.96)));\n            v.push(p([0.03, 0.46, 0.0], [0.03, 3.1, 0.0], 0.06, 0.075, s));\n            for k in 0..4 {\n                let y = 1.5 + k as f32 * 0.22;\n                v.push(p([0.03, y, 0.0], [0.03, y + 0.09, 0.0], 0.082, 0.082, dark()));\n            }\n        }\n        Tool::Forceps => {\n            let open = if m.using { 0.02 } else { 0.16 };\n            v.push(p([-open, 0.0, 0.0], [-0.1, 1.5, 0.0], 0.022, 0.055, s));\n            v.push(p([open, 0.0, 0.0], [0.1, 1.5, 0.0], 0.022, 0.055, s));\n            v.push(p([-0.1, 1.5, 0.0], [-0.03, 3.0, 0.0], 0.055, 0.05, s));\n            v.push(p([0.1, 1.5, 0.0], [0.03, 3.0, 0.0], 0.055, 0.05, s));\n        }\n        Tool::Suture => {\n            // A needle holder, with the curved needle at its jaws.\n            let arc = if m.using { (t * 14.0).sin() * 0.5 } else { 0.0 };\n            for k in 0..7 {\n                let a0 = -1.4 + k as f32 * 0.42 + arc;\n                let a1 = a0 + 0.42;\n                let q = |a: f32| [a.sin() * 0.28, 0.28 - a.cos() * 0.28, a.cos() * 0.05];\n                v.push(p(q(a0), q(a1), 0.018, 0.018, Vec3::new(0.95, 0.9, 0.7)));\n            }\n            v.push(p([0.0, 0.28, 0.0], [0.03, 1.4, 0.0], 0.04, 0.07, s));\n            v.push(p([0.03, 1.4, 0.0], [-0.14, 2.9, 0.0], 0.06, 0.05, s));\n            v.push(p([0.03, 1.4, 0.0], [0.2, 2.9, 0.0], 0.06, 0.05, s));\n            v.push(p([-0.14, 2.9, 0.0], [-0.14, 3.05, 0.0], 0.1, 0.1, dark()));\n            v.push(p([0.2, 2.9, 0.0], [0.2, 3.05, 0.0], 0.1, 0.1, dark()));\n        }\n        Tool::Suction => {\n            let shudder = if m.using { (t * 60.0).sin() * 0.018 * m.pressure.max(0.3) } else { 0.0 };\n            v.push(p([shudder, 0.0, 0.0], [0.0, 1.3, 0.0], 0.07, 0.085, s));\n            v.push(p([0.0, 1.3, 0.0], [0.04, 2.1, 0.0], 0.085, 0.14, Vec3::new(0.2, 0.42, 0.55)));\n            v.push(p([0.04, 2.1, 0.0], [0.25, 3.2, 0.25], 0.09, 0.08, Vec3::new(0.82, 0.86, 0.88)));\n        }\n        Tool::Laser => {\n            let on = m.using;\n            v.push(p([0.0, 0.32, 0.0], [0.0, 3.0, 0.0], 0.05, 0.13, Vec3::new(0.16, 0.18, 0.24)));\n            v.push(p([0.0, 0.14, 0.0], [0.0, 0.34, 0.0], 0.03, 0.05, s));\n            let c = Vec3::new(1.0, 0.16, 0.08);\n            v.push(glow(p([0.0, 1.5, 0.1], [0.0, 2.1, 0.11], 0.03, 0.03, c), if on { 2.2 } else { 0.6 }));\n            if on {\n                v.push(glow(p([0.0, 0.0, 0.0], [0.0, 0.16, 0.0], 0.045, 0.02, c), 3.5));\n            }\n        }\n        Tool::Gel => {\n            let plunge = if m.using { 0.5 + (t * 3.0).sin() * 0.1 } else { 0.8 };\n            v.push(p([0.0, 0.0, 0.0], [0.0, 0.46, 0.0], 0.025, 0.07, Vec3::new(0.82, 0.86, 0.88)));\n            v.push(p([0.0, 0.46, 0.0], [0.0, 2.1, 0.0], 0.17, 0.17, Vec3::new(0.5, 0.9, 0.78)));\n            v.push(p([0.0, 2.1, 0.0], [0.0, 2.1 + plunge, 0.0], 0.05, 0.05, s));\n            v.push(p([-0.16, 2.1 + plunge, 0.0], [0.16, 2.1 + plunge, 0.0], 0.05, 0.05, s));\n        }\n        Tool::Scanner => {\n            let pulse = if m.using { 1.0 + (t * 7.0).sin() * 0.5 } else { 0.5 };\n            v.push(p([-0.36, 0.1, 0.0], [0.36, 0.1, 0.0], 0.12, 0.12, Vec3::new(0.22, 0.26, 0.32)));\n            v.push(glow(p([-0.3, 0.02, 0.0], [0.3, 0.02, 0.0], 0.06, 0.06, Vec3::new(0.3, 0.9, 1.0)), pulse));\n            v.push(p([0.0, 0.2, 0.0], [0.04, 3.0, 0.0], 0.09, 0.07, s));\n        }\n        Tool::Iv => {\n            let dose = m.meter.clamp(0.0, 1.3);\n            v.push(p([0.0, 0.0, 0.0], [0.0, 0.8, 0.0], 0.012, 0.02, s));\n            v.push(p([0.0, 0.8, 0.0], [0.0, 2.2, 0.0], 0.13, 0.13, Vec3::new(0.76, 0.85, 0.96)));\n            v.push(p([0.0, 2.2 - dose * 1.1, 0.0], [0.0, 3.05 - dose * 1.1, 0.0], 0.04, 0.04, s));\n            v.push(p([-0.14, 3.05 - dose * 1.1, 0.0], [0.14, 3.05 - dose * 1.1, 0.0], 0.05, 0.05, s));\n        }\n        Tool::Cryo => {\n            let c = Vec3::new(0.65, 0.9, 1.0);\n            v.push(glow(p([0.0, 0.0, 0.0], [0.0, 0.3, 0.0], 0.06, 0.04, c), if m.using { 1.5 } else { 0.4 }));\n            v.push(p([0.0, 0.3, 0.0], [0.0, 1.5, 0.0], 0.04, 0.11, s));\n            v.push(p([0.0, 1.5, 0.0], [0.0, 3.0, 0.0], 0.11, 0.1, Vec3::new(0.25, 0.42, 0.62)));\n            v.push(glow(p([0.0, 2.0, 0.1], [0.0, 2.6, 0.1], 0.02, 0.02, c), 1.0));\n        }\n        Tool::Dressing => {\n            v.push(p([-0.5, 0.12, 0.0], [0.5, 0.12, 0.0], 0.13, 0.13, Vec3::new(0.94, 0.94, 0.9)));\n            v.push(p([-0.56, 0.12, 0.0], [-0.1, 1.5, 0.0], 0.03, 0.04, s));\n            v.push(p([0.56, 0.12, 0.0], [0.1, 1.5, 0.0], 0.03, 0.04, s));\n            v.push(p([0.0, 1.5, 0.0], [0.0, 3.0, 0.0], 0.07, 0.07, Vec3::new(0.2, 0.55, 0.58)));\n        }\n        Tool::Defib => {\n            let r = Vec3::new(0.22, 0.24, 0.28);\n            let charge = m.meter;\n            for x in [-0.95f32, 0.95] {\n                v.push(p([x - 0.4, 0.06, 0.0], [x + 0.4, 0.06, 0.0], 0.1, 0.1, s));\n                v.push(p([x, 0.14, 0.0], [x, 1.2, 0.0], 0.14, 0.1, r));\n                v.push(glow(p([x, 0.5, 0.13], [x, 0.9, 0.13], 0.03, 0.03, Vec3::new(1.0, 0.8, 0.2)), charge * 3.0));\n            }\n        }\n    }\n    v\n}\n\n/// The direction the handle leans in the hand: toward the camera and the player.\npub fn hand_axis() -> Vec3 {\n    Vec3::new(0.42, 1.0, 0.48).normalize()\n}\n\n/// Draws a model: `tip` in the world, its handle along `axis`.\npub fn emit(scene: &mut Scene, tool: Tool, tip: Vec3, axis: Vec3, m: Motion, scale: f32, group: u32, lift_glow: f32) {\n    let rot = Quat::from_rotation_arc(Vec3::Y, axis.normalize());\n    let mat = Mat3::from_quat(rot);\n    for q in parts(tool, m) {\n        let a = tip + mat * (q.a * scale);\n        let b = tip + mat * (q.b * scale);\n        scene.sdfs.push(SdfInstance {\n            a,\n            b,\n            ra: q.ra * scale,\n            rb: q.rb * scale,\n            color: q.c,\n            emissive: q.e + lift_glow,\n            style: if q.e > 0.0 { Style::Unlit } else { Style::Lit },\n            flags: rs::flags::OBJECT | rs::flags::NO_CUT,\n            group,\n            material: 0,\n        });\n    }\n}\n\n/// The steel tray at the bottom of the field, an instrument per ring position.\n#[allow(clippy::too_many_arguments)]\npub fn emit_tray(scene: &mut Scene, ring: &[Tool; 8], selected: u8, time: f32, slots: &[Vec2; 8], clinical: bool) {\n    let _ = clinical;\n    let tray_steel = Vec3::new(0.46, 0.5, 0.53);\n    let half = Vec3::new(6.9, 0.07, 0.86);\n    scene.meshes.push(MeshInstance {\n        mesh: MeshKey::rounded_box(half, 0.06),\n        transform: Mat4::from_translation(Vec3::new(0.0, 0.92, 5.3)),\n        color: tray_steel,\n        emissive: 0.0,\n        style: Style::Lit,\n        flags: rs::flags::OBJECT | rs::flags::NO_CUT,\n        group: 0x900,\n        material: 0,\n        ext: half,\n    });\n    let selected = selected as usize;\n    for (k, tool) in ring.iter().enumerate() {\n        let lift = k == selected;\n        let y = if lift { 1.42 + (time * 3.0).sin() * 0.03 } else { 1.06 };\n        let at = slots[k];\n        // Laid flat, tips toward the patient.\n        let axis = Vec3::new(0.12, 0.05, 1.0);\n        let tip = Vec3::new(at.x, y, at.y - 0.56);\n        let scale = if lift { 0.42 } else { 0.36 };\n        let m = Motion { time, ..Default::default() };\n        emit(scene, *tool, tip, axis, m, scale, 0x910 + k as u32, if lift { 0.28 } else { 0.0 });\n    }\n}\nEOF\npython3 - <<'EOF'\np='crates/pav_core/src/games/surgery/field.rs'; s=open(p).read()\ns=s.replace('''/// Where the IV port is on the field.''','''/// Where each ring position's instrument lies on the tray (field coordinates): click targets.\npub fn tray_slot(k: usize) -> Vec2 {\n    Vec2::new(-5.95 + k as f32 * 1.7, 5.3)\n}\n\n/// The tray's row: a click below this line is on the tray, not the field.\npub const TRAY_Z: f32 = 4.45;\n\n/// Where the IV port is on the field.''')\nopen(p,'w').write(s)\np='crates/pav_core/src/games/surgery/mod.rs'; s=open(p).read()\ns=s.replace(\"pub mod net;\\n\",\"pub mod net;\\npub mod paper;\\n\")\nopen(p,'w').write(s)\nEOF\n","description":"Write the field plate and instrument renderers"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":13384,"cache_read_input_tokens":408794,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":13384},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"315eb360-d73f-4188-b7e3-153737966849","timestamp":"2026-11-05T14:58:06.160Z","request_id":"req_011CgjyVmXDegqcFNi9N1aCb","wire_tool_inputs":{"toolu_01HxWTjJsGXpW9mSgQuJ1jck":{"command":"mkdir -p crates/pav_view/src/surgery; cat > crates/pav_view/src/surgery/plate.rs <<'EOF'\n//! The operative field: one `DynamicMesh` per frame, a grid over 22×12.6 units in `Style::Cel`,\n//! with per-vertex colour doing the painting. A plate's heightfield and veins are cached; hazards\n//! stamp into height and colour each frame. A hard band where `n·h` is high makes it read as wet.\n\nuse std::collections::HashMap;\n\nuse glam::{Vec2, Vec3};\nuse pav_core::games::surgery::content::{Content, Plate};\nuse pav_core::games::surgery::field::{Hazard, Kind, sub};\nuse pav_core::games::surgery::frame::SurgeryFrame;\nuse pav_render::mesh::{MeshData, Vertex};\nuse pav_render::scene::{self as rs, DynamicMesh, Scene, Style};\n\npub const NX: usize = 420;\npub const NZ: usize = 240;\nconst WIDE: f32 = 22.0;\nconst DEEP: f32 = 12.6;\n\npub fn grid_x(i: usize) -> f32 {\n    -WIDE * 0.5 + WIDE * i as f32 / (NX - 1) as f32\n}\npub fn grid_z(j: usize) -> f32 {\n    -DEEP * 0.5 + DEEP * j as f32 / (NZ - 1) as f32\n}\n\nfn hash2(x: i32, z: i32) -> f32 {\n    let mut h = (x as u32).wrapping_mul(374_761_393).wrapping_add((z as u32).wrapping_mul(668_265_263));\n    h = (h ^ (h >> 13)).wrapping_mul(1_274_126_177);\n    ((h ^ (h >> 16)) & 0xffff) as f32 / 65535.0\n}\n\n/// Value noise, 0..1.\npub fn noise(x: f32, z: f32) -> f32 {\n    let (xi, zi) = (x.floor(), z.floor());\n    let (fx, fz) = (x - xi, z - zi);\n    let (u, v) = (fx * fx * (3.0 - 2.0 * fx), fz * fz * (3.0 - 2.0 * fz));\n    let (i, j) = (xi as i32, zi as i32);\n    let a = hash2(i, j) + (hash2(i + 1, j) - hash2(i, j)) * u;\n    let b = hash2(i, j + 1) + (hash2(i + 1, j + 1) - hash2(i, j + 1)) * u;\n    a + (b - a) * v\n}\n\nfn fbm(x: f32, z: f32) -> f32 {\n    noise(x, z) * 0.55 + noise(x * 2.1 + 3.3, z * 2.1 + 1.7) * 0.3 + noise(x * 4.3 + 7.1, z * 4.3 + 5.3) * 0.15\n}\n\nfn smooth(a: f32, b: f32, x: f32) -> f32 {\n    let t = ((x - a) / (b - a)).clamp(0.0, 1.0);\n    t * t * (3.0 - 2.0 * t)\n}\n\nfn hex3(s: &str) -> [f32; 3] {\n    rs::hex(s).unwrap_or(Vec3::splat(0.5)).to_array()\n}\n\nfn mix(a: [f32; 3], b: [f32; 3], t: f32) -> [f32; 3] {\n    let t = t.clamp(0.0, 1.0);\n    [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t]\n}\n\npub fn srgb3(r: u8, g: u8, b: u8) -> [f32; 3] {\n    rs::srgb(r, g, b).to_array()\n}\n\nstruct Base {\n    h: Vec<f32>,\n    vein: Vec<f32>,\n    /// 1 inside the opening, 0 on the drape.\n    open: Vec<f32>,\n    bed: [f32; 3],\n    flesh: [f32; 3],\n    top: [f32; 3],\n    vein_c: [f32; 3],\n    pulse: f32,\n    bone: bool,\n    height_top: f32,\n}\n\nfn seg_dist(p: Vec2, a: Vec2, b: Vec2) -> f32 {\n    let ab = b - a;\n    let t = ((p - a).dot(ab) / ab.length_squared().max(1e-5)).clamp(0.0, 1.0);\n    p.distance(a + ab * t)\n}\n\nfn build_base(p: &Plate) -> Base {\n    let n = NX * NZ;\n    let (mut h, mut vein, mut open) = (vec![0.0; n], vec![0.0; n], vec![0.0; n]);\n    let mut top = 0.3f32;\n    for j in 0..NZ {\n        for i in 0..NX {\n            let (x, z) = (grid_x(i), grid_z(j));\n            let mut v = 0.0f32;\n            for l in &p.lobes {\n                let (dx, dz) = (x - l.x, z - l.z);\n                let e = (1.0 - dx * dx / l.a.max(0.01) - dz * dz / l.b.max(0.01)).max(0.0);\n                if e > 0.0 {\n                    v = v.max(l.h * e.powf(0.55));\n                }\n            }\n            v += (fbm(x * 0.7, z * 0.7) - 0.5) * p.noise * 2.0;\n            let q = Vec2::new(x, z);\n            let mut vessel = 0.0f32;\n            for s in &p.vessels {\n                for w in s.points.windows(2) {\n                    let d = seg_dist(q, Vec2::new(w[0][0], w[0][1]), Vec2::new(w[1][0], w[1][1]));\n                    vessel = vessel.max((1.0 - d / s.w.max(0.01)).max(0.0).sqrt() * s.h / 0.1);\n                    v += (1.0 - d / s.w.max(0.01)).max(0.0).sqrt() * s.h * 0.2;\n                }\n            }\n            // Veins: thin ridges of noise.\n            let ridge = 1.0 - (fbm(x * 1.2 + 9.0, z * 1.2 - 4.0) * 2.0 - 1.0).abs() * 14.0;\n            let veiny = ridge.max(0.0) * p.veins;\n            // The opening in the drape.\n            let (ex, ez) = ((x.abs() - 9.3).max(0.0), (z.abs() - 4.75).max(0.0));\n            let d = (ex * ex + ez * ez).sqrt() + (noise(x * 2.0, z * 2.0) - 0.5) * 0.06;\n            let inside = 1.0 - smooth(0.0, 0.14, d);\n            let idx = j * NX + i;\n            h[idx] = v.max(0.0) * inside + (1.0 - inside) * (0.62 + (fbm(x * 0.8, z * 1.4 + 2.0) - 0.5) * 0.25);\n            vein[idx] = veiny.max(vessel.min(1.0));\n            open[idx] = inside;\n            top = top.max(v);\n        }\n    }\n    Base {\n        h,\n        vein,\n        open,\n        bed: hex3(&p.bed),\n        flesh: hex3(&p.flesh),\n        top: hex3(&p.top),\n        vein_c: hex3(&p.vein),\n        pulse: p.pulse,\n        bone: p.bone,\n        height_top: top,\n    }\n}\n\n#[derive(Default)]\npub struct PlateView {\n    bases: HashMap<String, Base>,\n    /// This frame's height and colour.\n    pub h: Vec<f32>,\n    c: Vec<[f32; 3]>,\n    indices: Vec<u32>,\n}\n\npub struct Paint {\n    pub palette_clinical: bool,\n    pub time: f32,\n}\n\nimpl PlateView {\n    /// The tissue's height at a field point this frame.\n    pub fn height(&self, p: Vec2) -> f32 {\n        if self.h.is_empty() {\n            return 0.0;\n        }\n        let i = (((p.x + WIDE * 0.5) / WIDE) * (NX - 1) as f32).clamp(0.0, (NX - 2) as f32);\n        let j = (((p.y + DEEP * 0.5) / DEEP) * (NZ - 1) as f32).clamp(0.0, (NZ - 2) as f32);\n        let (i0, j0) = (i as usize, j as usize);\n        let (u, v) = (i - i0 as f32, j - j0 as f32);\n        let g = |a: usize, b: usize| self.h[b * NX + a];\n        let top = g(i0, j0) + (g(i0 + 1, j0) - g(i0, j0)) * u;\n        let bot = g(i0, j0 + 1) + (g(i0 + 1, j0 + 1) - g(i0, j0 + 1)) * u;\n        top + (bot - top) * v\n    }\n\n    fn base_for(&mut self, c: &Content, id: u8) {\n        let key = c.plate_order.get(id as usize).cloned().unwrap_or_default();\n        if !self.bases.contains_key(&key) {\n            if let Some(p) = c.plates.get(&key) {\n                self.bases.insert(key, build_base(p));\n            }\n        }\n    }\n\n    fn stamp(&mut self, cx: f32, cz: f32, r: f32, mut f: impl FnMut(&mut f32, &mut [f32; 3], f32, f32, f32)) {\n        let to_i = |x: f32| ((x + WIDE * 0.5) / WIDE * (NX - 1) as f32) as i32;\n        let to_j = |z: f32| ((z + DEEP * 0.5) / DEEP * (NZ - 1) as f32) as i32;\n        let (i0, i1) = (to_i(cx - r).max(0), (to_i(cx + r) + 1).min(NX as i32 - 1));\n        let (j0, j1) = (to_j(cz - r).max(0), (to_j(cz + r) + 1).min(NZ as i32 - 1));\n        for j in j0..=j1 {\n            for i in i0..=i1 {\n                let (x, z) = (grid_x(i as usize), grid_z(j as usize));\n                let d = ((x - cx).powi(2) + (z - cz).powi(2)).sqrt();\n                if d <= r {\n                    let k = j as usize * NX + i as usize;\n                    f(&mut self.h[k], &mut self.c[k], d, x, z);\n                }\n            }\n        }\n    }\n\n    /// A painted line: `f(height, colour, across 0..1)`.\n    fn stroke(&mut self, a: Vec2, b: Vec2, w: f32, mut f: impl FnMut(&mut f32, &mut [f32; 3], f32, f32)) {\n        let (lo, hi) = (a.min(b) - Vec2::splat(w), a.max(b) + Vec2::splat(w));\n        let to_i = |x: f32| ((x + WIDE * 0.5) / WIDE * (NX - 1) as f32) as i32;\n        let to_j = |z: f32| ((z + DEEP * 0.5) / DEEP * (NZ - 1) as f32) as i32;\n        let ab = b - a;\n        let len2 = ab.length_squared().max(1e-5);\n        for j in to_j(lo.y).max(0)..=(to_j(hi.y) + 1).min(NZ as i32 - 1) {\n            for i in to_i(lo.x).max(0)..=(to_i(hi.x) + 1).min(NX as i32 - 1) {\n                let q = Vec2::new(grid_x(i as usize), grid_z(j as usize));\n                let t = ((q - a).dot(ab) / len2).clamp(0.0, 1.0);\n                let d = q.distance(a + ab * t);\n                if d <= w {\n                    let k = j as usize * NX + i as usize;\n                    f(&mut self.h[k], &mut self.c[k], d / w, t);\n                }\n            }\n        }\n    }\n\n    /// Builds the frame's field into the scene.\n    pub fn emit(&mut self, scene: &mut Scene, f: &SurgeryFrame, c: &Content, paint: &Paint) {\n        self.base_for(c, f.plate);\n        self.base_for(c, f.plate_prev);\n        let n = NX * NZ;\n        self.h.resize(n, 0.0);\n        self.c.resize(n, [0.0; 3]);\n        let key = c.plate_order.get(f.plate as usize).cloned().unwrap_or_default();\n        let prev_key = c.plate_order.get(f.plate_prev as usize).cloned().unwrap_or_default();\n        // The tissue pulses on the beat: a sharp systole, a slow fall, plus a breathing swell.\n        let b = f.beat;\n        let systole = if f.stopped { 0.0 } else { (-b * 7.0).exp() * (b * 40.0).min(1.0) + 0.35 * (-((b - 0.28) * 9.0).powi(2)).exp() };\n        let breath = (paint.time * 1.1).sin() * 0.012;\n        let drape = srgb3(34, 112, 116);\n        let drape_dark = srgb3(18, 70, 74);\n        let heat = f.fever.map(|v| (v / 100.0).clamp(0.0, 1.2)).unwrap_or(0.0);\n        let fever_c = srgb3(255, 120, 40);\n        {\n            let Some(base) = self.bases.get(&key) else { return };\n            let prev = self.bases.get(&prev_key).unwrap_or(base);\n            let front = f.reveal.clamp(0.0, 1.0) * 16.0;\n            let blending = f.reveal < 1.0;\n            for j in 0..NZ {\n                for i in 0..NX {\n                    let k = j * NX + i;\n                    let mut pick = base;\n                    let mut blend = 1.0;\n                    if blending {\n                        let d = Vec2::new(grid_x(i), grid_z(j)).distance(f.reveal_at);\n                        blend = smooth(front + 0.8, front - 0.8, d);\n                        if blend < 0.5 {\n                            pick = prev;\n                        }\n                    }\n                    let open = base.open[k];\n                    let top = pick.height_top.max(0.3);\n                    let raw = if blending { prev.h[k] + (base.h[k] - prev.h[k]) * blend } else { base.h[k] };\n                    let amp = (pick.pulse * systole + breath) * open;\n                    let h = raw * (1.0 + amp);\n                    self.h[k] = h;\n                    let t = (raw / top).clamp(0.0, 1.0);\n                    let mut col = if t < 0.45 { mix(pick.bed, pick.flesh, t / 0.45) } else { mix(pick.flesh, pick.top, (t - 0.45) / 0.55) };\n                    col = mix(col, pick.vein_c, pick.vein[k] * 0.85);\n                    if pick.bone && t > 0.72 {\n                        col = mix(col, srgb3(236, 226, 196), smooth(0.72, 0.8, t));\n                    }\n                    if heat > 0.0 {\n                        col = mix(col, fever_c, heat * 0.28 * t);\n                    }\n                    if open < 1.0 {\n                        let cloth = mix(drape_dark, drape, smooth(0.45, 0.8, raw));\n                        col = mix(cloth, col, open);\n                    }\n                    self.c[k] = col;\n                }\n            }\n        }\n        self.stamps(f, paint);\n        if paint.palette_clinical {\n            for col in &mut self.c {\n                let l = col[0] * 0.3 + col[1] * 0.55 + col[2] * 0.15;\n                *col = [l * 0.72, l * 0.86, l * 1.02];\n            }\n        }\n        self.mesh(scene, paint);\n    }\n\n    fn stamps(&mut self, f: &SurgeryFrame, paint: &Paint) {\n        let t = paint.time;\n        let cut = srgb3(44, 8, 14);\n        let pool_c = srgb3(120, 6, 16);\n        let dash = srgb3(255, 236, 150);\n        for s in &f.stains {\n            let col = match s.kind {\n                0 => srgb3(120, 30, 34),\n                1 => srgb3(46, 28, 26),\n                _ => srgb3(150, 216, 196),\n            };\n            let (r, at) = (s.r, s.at);\n            self.stamp(at.x, at.y, r * 1.3, |_, c, d, x, z| {\n                let e = d + (noise(x * 3.0, z * 3.0) - 0.5) * r * 0.5;\n                if e < r {\n                    *c = mix(*c, col, 0.32 * (1.0 - e / r));\n                }\n            });\n        }\n        for h in &f.hazards {\n            self.stamp_hazard(h, f, cut, pool_c, dash, t);\n        }\n        if let Some(radius) = f.heat_ring {\n            let col = srgb3(255, 170, 60);\n            self.stamp(0.0, 0.0, radius + 0.6, |h, c, d, _, _| {\n                let e = (d - radius).abs();\n                if e < 0.5 {\n                    let k = 1.0 - e / 0.5;\n                    *h += k * 0.12;\n                    *c = mix(*c, col, k * 0.95);\n                }\n            });\n        }\n    }\n\n    fn path_stamps(&mut self, h: &Hazard, cut: [f32; 3], dash: [f32; 3], groove: f32, t: f32, white: bool) {\n        let len = h.path_len().max(0.4);\n        let steps = (len / 0.09) as i32;\n        let pulse = 0.8 + 0.2 * (t * 5.0).sin();\n        for k in 0..steps {\n            let s = k as f32 / steps as f32;\n            let p = h.path(s);\n            let q = h.path((k + 1) as f32 / steps as f32);\n            if s < h.prog {\n                if white {\n                    self.stroke(p, q, 0.3, |hh, c, a, _| {\n                        *hh += (1.0 - a * a) * 0.09;\n                        *c = mix(*c, srgb3(238, 240, 232), 1.0 - a * a * 0.5);\n                    });\n                } else {\n                    self.stroke(p, q, 0.13, |hh, c, a, _| {\n                        *hh -= (1.0 - a) * groove;\n                        *c = mix(*c, cut, 1.0 - a * 0.6);\n                    });\n                }\n            } else if k % 6 < 4 {\n                let w = 0.075;\n                let col = dash;\n                self.stroke(p, q, w, |_, c, a, _| {\n                    *c = mix(*c, col, (1.0 - a * a) * pulse);\n                });\n            }\n        }\n    }\n\n    fn stamp_hazard(&mut self, h: &Hazard, f: &SurgeryFrame, cut: [f32; 3], pool_c: [f32; 3], dash: [f32; 3], t: f32) {\n        let a = h.a;\n        match h.kind {\n            Kind::Incision => self.path_stamps(h, cut, dash, 0.2, t, false),\n            Kind::Closure => self.path_stamps(h, cut, srgb3(250, 250, 240), 0.0, t, true),\n            Kind::Lacer | Kind::Bleeder => {\n                let seed = h.id as f32 * 3.7;\n                let steps = 14;\n                let width = if h.kind == Kind::Bleeder { 0.2 } else { 0.17 };\n                let dir = (h.b - h.a).normalize_or_zero().perp();\n                let mut last = h.a;\n                for k in 1..=steps {\n                    let s = k as f32 / steps as f32;\n                    let wiggle = (noise(s * 5.0 + seed, seed) - 0.5) * 0.3 * (s * std::f32::consts::PI).sin();\n                    let p = h.a.lerp(h.b, s) + dir * wiggle;\n                    let closed = s < h.prog;\n                    let taper = (s * std::f32::consts::PI).sin().powf(0.5);\n                    let w = (width * taper).max(0.05) * if closed { 0.45 } else { 1.0 };\n                    let c0 = if closed { srgb3(150, 50, 60) } else { cut };\n                    self.stroke(last, p, w + 0.16, |hh, c, a_, _| {\n                        let inner = w / (w + 0.16);\n                        if a_ < inner {\n                            *hh -= 0.14;\n                            *c = mix(*c, c0, 1.0 - a_ * 0.3);\n                        } else {\n                            *hh += (1.0 - a_) * 0.2;\n                            *c = mix(*c, srgb3(226, 110, 100), (1.0 - a_) * 0.75);\n                        }\n                    });\n                    last = p;\n                }\n            }\n            Kind::Pool => {\n                let caustic = h.sub == sub::CAUSTIC;\n                let col = if caustic { srgb3(150, 170, 40) } else { pool_c };\n                let r = h.r;\n                let seed = h.id as f32;\n                let cx = a.x;\n                let cz = a.y;\n                let film = self.height(a) + 0.05;\n                self.stamp(a.x, a.y, r * 1.4, |hh, c, d, x, z| {\n                    let ang = (z - cz).atan2(x - cx);\n                    let e = d + (noise(ang * 1.5 + seed, seed) - 0.5) * r * 0.45 + (noise(x * 3.0 + seed, z * 3.0) - 0.5) * 0.12;\n                    if e < r {\n                        let k = smooth(r, r - 0.14, e);\n                        *hh = *hh + (film.max(*hh) + 0.02 - *hh) * k;\n                        *c = mix(*c, col, k);\n                    }\n                });\n            }\n            Kind::Patch => {\n                let burn = h.sub == sub::BURN;\n                let r = h.r;\n                let col = if burn { srgb3(40, 24, 22) } else { srgb3(232, 70, 60) };\n                let gel = srgb3(170, 232, 214);\n                let cover = h.prog;\n                let seed = h.id as f32;\n                self.stamp(a.x, a.y, r * 1.2, |hh, c, d, x, z| {\n                    let n = noise(x * 2.6 + seed, z * 2.6);\n                    let e = d + (n - 0.5) * r * 0.5;\n                    if e < r {\n                        let k = smooth(r, r * 0.7, e);\n                        *hh += k * 0.05 * (0.5 + n);\n                        *c = mix(*c, col, k * 0.85);\n                        // The gel covers it from the outside in.\n                        if d > r * (1.0 - cover) {\n                            *c = mix(*c, gel, 0.8);\n                            *hh += 0.03;\n                        }\n                    }\n                });\n            }\n            Kind::Tumor => {\n                let r = h.r;\n                let col = srgb3(96, 52, 88);\n                if h.stage == 0 {\n                    self.stamp(a.x, a.y, r, |hh, c, d, _, _| {\n                        let k = smooth(r, r * 0.3, d);\n                        *hh += k * 0.5;\n                        *c = mix(*c, col, k);\n                    });\n                    self.path_stamps(h, cut, dash, 0.18, t, false);\n                } else if h.stage == 1 {\n                    self.stamp(a.x, a.y, r, |hh, c, d, _, _| {\n                        let k = smooth(r, r * 0.65, d);\n                        *hh += k * 0.3;\n                        *c = mix(*c, col, k);\n                        if (d - r * 0.92).abs() < 0.1 {\n                            *c = cut;\n                            *hh -= 0.15;\n                        }\n                    });\n                } else {\n                    let gel = srgb3(170, 232, 214);\n                    let cover = h.prog;\n                    self.stamp(a.x, a.y, r, |hh, c, d, _, _| {\n                        let k = smooth(r, r * 0.8, d);\n                        *hh -= k * 0.3;\n                        *c = mix(*c, cut, k * 0.85);\n                        if d > r * (1.0 - cover) {\n                            *c = mix(*c, gel, 0.85);\n                        }\n                    });\n                }\n            }\n            Kind::Bone => {\n                if h.stage == 0 {\n                    let (seat, w) = (h.b, h.r);\n                    let col = srgb3(70, 26, 30);\n                    self.stamp(seat.x, seat.y, w, |hh, c, d, _, _| {\n                        let k = smooth(w, w * 0.6, d);\n                        *hh -= k * 0.2;\n                        *c = mix(*c, col, k);\n                    });\n                }\n            }\n            Kind::Nodule => {\n                // A bump travelling under the tissue, visible even before the Scanner finds it.\n                let r = h.r * 1.6;\n                let tele = if h.telegraph { 0.25 + 0.2 * (t * 16.0).sin() } else { 0.0 };\n                let violet = srgb3(120, 60, 150);\n                let vis = h.visible();\n                self.stamp(a.x, a.y, r + if h.telegraph { 1.1 } else { 0.0 }, |hh, c, d, _, _| {\n                    let k = smooth(r, r * 0.2, d);\n                    *hh += k * (0.34 + tele * 0.5);\n                    if vis {\n                        *c = mix(*c, violet, k * 0.65);\n                    } else {\n                        *c = mix(*c, violet, k * 0.2);\n                    }\n                    if tele > 0.0 && (d - (r + 0.5)).abs() < 0.12 {\n                        *hh += 0.07;\n                        *c = mix(*c, violet, 0.5);\n                    }\n                });\n            }\n            Kind::Ember | Kind::Furnace => {\n                let r = h.r * 2.1;\n                let hot = srgb3(255, 130, 40);\n                let frost = srgb3(190, 230, 255);\n                let frozen = (h.kind == Kind::Ember && h.stage == 1) || (h.kind == Kind::Furnace && h.stage == 1);\n                self.stamp(a.x, a.y, r, |_, c, d, _, _| {\n                    let k = smooth(r, 0.0, d);\n                    *c = mix(*c, if frozen { frost } else { hot }, k * k * 0.85);\n                });\n            }\n            Kind::Eye => {\n                let r = h.r * 1.6;\n                let col = srgb3(36, 18, 66);\n                self.stamp(a.x, a.y, r, |hh, c, d, _, _| {\n                    let k = smooth(r, r * 0.5, d);\n                    *hh += k * 0.25;\n                    *c = mix(*c, col, k * 0.9);\n                });\n            }\n            Kind::Tendril => {\n                let col = srgb3(58, 26, 96);\n                let (p, q) = (h.a, h.a.lerp(h.b, 1.0 - h.prog * 0.9));\n                self.stroke(p, q, 0.34, |hh, c, a_, _| {\n                    *hh += (1.0 - a_) * 0.16;\n                    *c = mix(*c, col, 1.0 - a_ * 0.6);\n                });\n            }\n            Kind::Sac => {\n                let (p, q) = (h.b, h.a);\n                let col = srgb3(70, 30, 96);\n                self.stroke(p, q, 0.13, |hh, c, a_, _| {\n                    *hh += (1.0 - a_) * 0.08;\n                    *c = mix(*c, col, 1.0 - a_ * 0.5);\n                });\n            }\n            Kind::Object | Kind::Polyp => {\n                let r = h.r * 0.8;\n                let col = cut;\n                self.stamp(a.x, a.y, r, |hh, c, d, _, _| {\n                    let k = smooth(r, r * 0.3, d);\n                    *hh += k * 0.02;\n                    *c = mix(*c, col, k * 0.45);\n                });\n            }\n        }\n        let _ = f;\n    }\n\n    fn mesh(&mut self, scene: &mut Scene, paint: &Paint) {\n        // A wet highlight: the lamp's half vector, hardened to a band.\n        let half = Vec3::new(-0.08, 1.0, 0.32).normalize();\n        let (dx, dz) = (WIDE / (NX - 1) as f32, DEEP / (NZ - 1) as f32);\n        let mut verts = Vec::with_capacity(NX * NZ);\n        for j in 0..NZ {\n            for i in 0..NX {\n                let k = j * NX + i;\n                let hl = self.h[if i > 0 { k - 1 } else { k }];\n                let hr = self.h[if i + 1 < NX { k + 1 } else { k }];\n                let hd = self.h[if j > 0 { k - NX } else { k }];\n                let hu = self.h[if j + 1 < NZ { k + NX } else { k }];\n                let n = Vec3::new((hl - hr) / (2.0 * dx), 1.0, (hd - hu) / (2.0 * dz)).normalize();\n                let wet = n.dot(half);\n                let mut col = self.c[k];\n                // A hard band reads as wet tissue, and only on the tissue.\n                let band = smooth(0.988, 0.992, wet) * smooth(0.25, 0.5, self.h[k]);\n                col = mix(col, [1.0, 0.96, 0.92], band * 0.5);\n                debug_assert!(self.h[k].is_finite() && n.is_finite(), \"NaN in the plate\");\n                verts.push(Vertex {\n                    pos: [grid_x(i), self.h[k], grid_z(j)],\n                    normal: n.to_array(),\n                    uv: [i as f32 / NX as f32, j as f32 / NZ as f32],\n                    color: [col[0], col[1], col[2], 1.0],\n                });\n            }\n        }\n        if self.indices.is_empty() {\n            for j in 0..NZ - 1 {\n                for i in 0..NX - 1 {\n                    let a = (j * NX + i) as u32;\n                    let b = a + 1;\n                    let c = a + NX as u32;\n                    let d = c + 1;\n                    self.indices.extend_from_slice(&[a, c, b, b, c, d]);\n                }\n            }\n        }\n        let _ = paint;\n        scene.dynamic.push(DynamicMesh {\n            data: MeshData { vertices: verts, indices: self.indices.clone() },\n            color: Vec3::ONE,\n            emissive: 0.0,\n            style: Style::Cel,\n            flags: 0,\n            group: 1,\n            material: 0,\n        });\n    }\n}\nEOF\ncat > crates/pav_view/src/surgery/instruments.rs <<'EOF'\n//! The instruments: built in code from SDF rounded cones, so parts can animate (forceps tips open,\n//! the needle arcs, the plunger moves, the suction shudders). They cast real shadows on the tissue,\n//! an essential depth cue. The same model sits on the steel tray and in the hand.\n\nuse glam::{Mat3, Mat4, Quat, Vec2, Vec3};\nuse pav_core::games::surgery::field::Tool;\nuse pav_render::scene::{self as rs, MeshInstance, MeshKey, Scene, SdfInstance, Style};\n\n#[derive(Clone, Copy)]\npub struct P {\n    pub a: Vec3,\n    pub b: Vec3,\n    pub ra: f32,\n    pub rb: f32,\n    pub c: Vec3,\n    pub e: f32,\n}\n\nfn steel() -> Vec3 {\n    Vec3::new(0.72, 0.76, 0.8)\n}\nfn dark() -> Vec3 {\n    Vec3::new(0.09, 0.1, 0.12)\n}\nfn p(a: [f32; 3], b: [f32; 3], ra: f32, rb: f32, c: Vec3) -> P {\n    P { a: Vec3::from_array(a), b: Vec3::from_array(b), ra, rb, c, e: 0.0 }\n}\nfn glow(mut x: P, e: f32) -> P {\n    x.e = e;\n    x\n}\n\n/// How an instrument is moving right now.\n#[derive(Clone, Copy, Default)]\npub struct Motion {\n    pub using: bool,\n    pub pressure: f32,\n    pub time: f32,\n    /// The gesture's meter: heat, frost, dose.\n    pub meter: f32,\n    pub recoil: f32,\n}\n\n/// The model in its own frame: the tip at the origin, the handle along +Y, about 3.2 units long.\npub fn parts(tool: Tool, m: Motion) -> Vec<P> {\n    let mut v = Vec::new();\n    let s = steel();\n    let t = m.time;\n    match tool {\n        Tool::Scalpel => {\n            v.push(p([0.0, 0.0, 0.0], [0.02, 0.52, 0.0], 0.012, 0.085, Vec3::new(0.9, 0.93, 0.96)));\n            v.push(p([0.03, 0.46, 0.0], [0.03, 3.1, 0.0], 0.06, 0.075, s));\n            for k in 0..4 {\n                let y = 1.5 + k as f32 * 0.22;\n                v.push(p([0.03, y, 0.0], [0.03, y + 0.09, 0.0], 0.082, 0.082, dark()));\n            }\n        }\n        Tool::Forceps => {\n            let open = if m.using { 0.02 } else { 0.16 };\n            v.push(p([-open, 0.0, 0.0], [-0.1, 1.5, 0.0], 0.022, 0.055, s));\n            v.push(p([open, 0.0, 0.0], [0.1, 1.5, 0.0], 0.022, 0.055, s));\n            v.push(p([-0.1, 1.5, 0.0], [-0.03, 3.0, 0.0], 0.055, 0.05, s));\n            v.push(p([0.1, 1.5, 0.0], [0.03, 3.0, 0.0], 0.055, 0.05, s));\n        }\n        Tool::Suture => {\n            // A needle holder, with the curved needle at its jaws.\n            let arc = if m.using { (t * 14.0).sin() * 0.5 } else { 0.0 };\n            for k in 0..7 {\n                let a0 = -1.4 + k as f32 * 0.42 + arc;\n                let a1 = a0 + 0.42;\n                let q = |a: f32| [a.sin() * 0.28, 0.28 - a.cos() * 0.28, a.cos() * 0.05];\n                v.push(p(q(a0), q(a1), 0.018, 0.018, Vec3::new(0.95, 0.9, 0.7)));\n            }\n            v.push(p([0.0, 0.28, 0.0], [0.03, 1.4, 0.0], 0.04, 0.07, s));\n            v.push(p([0.03, 1.4, 0.0], [-0.14, 2.9, 0.0], 0.06, 0.05, s));\n            v.push(p([0.03, 1.4, 0.0], [0.2, 2.9, 0.0], 0.06, 0.05, s));\n            v.push(p([-0.14, 2.9, 0.0], [-0.14, 3.05, 0.0], 0.1, 0.1, dark()));\n            v.push(p([0.2, 2.9, 0.0], [0.2, 3.05, 0.0], 0.1, 0.1, dark()));\n        }\n        Tool::Suction => {\n            let shudder = if m.using { (t * 60.0).sin() * 0.018 * m.pressure.max(0.3) } else { 0.0 };\n            v.push(p([shudder, 0.0, 0.0], [0.0, 1.3, 0.0], 0.07, 0.085, s));\n            v.push(p([0.0, 1.3, 0.0], [0.04, 2.1, 0.0], 0.085, 0.14, Vec3::new(0.2, 0.42, 0.55)));\n            v.push(p([0.04, 2.1, 0.0], [0.25, 3.2, 0.25], 0.09, 0.08, Vec3::new(0.82, 0.86, 0.88)));\n        }\n        Tool::Laser => {\n            let on = m.using;\n            v.push(p([0.0, 0.32, 0.0], [0.0, 3.0, 0.0], 0.05, 0.13, Vec3::new(0.16, 0.18, 0.24)));\n            v.push(p([0.0, 0.14, 0.0], [0.0, 0.34, 0.0], 0.03, 0.05, s));\n            let c = Vec3::new(1.0, 0.16, 0.08);\n            v.push(glow(p([0.0, 1.5, 0.1], [0.0, 2.1, 0.11], 0.03, 0.03, c), if on { 2.2 } else { 0.6 }));\n            if on {\n                v.push(glow(p([0.0, 0.0, 0.0], [0.0, 0.16, 0.0], 0.045, 0.02, c), 3.5));\n            }\n        }\n        Tool::Gel => {\n            let plunge = if m.using { 0.5 + (t * 3.0).sin() * 0.1 } else { 0.8 };\n            v.push(p([0.0, 0.0, 0.0], [0.0, 0.46, 0.0], 0.025, 0.07, Vec3::new(0.82, 0.86, 0.88)));\n            v.push(p([0.0, 0.46, 0.0], [0.0, 2.1, 0.0], 0.17, 0.17, Vec3::new(0.5, 0.9, 0.78)));\n            v.push(p([0.0, 2.1, 0.0], [0.0, 2.1 + plunge, 0.0], 0.05, 0.05, s));\n            v.push(p([-0.16, 2.1 + plunge, 0.0], [0.16, 2.1 + plunge, 0.0], 0.05, 0.05, s));\n        }\n        Tool::Scanner => {\n            let pulse = if m.using { 1.0 + (t * 7.0).sin() * 0.5 } else { 0.5 };\n            v.push(p([-0.36, 0.1, 0.0], [0.36, 0.1, 0.0], 0.12, 0.12, Vec3::new(0.22, 0.26, 0.32)));\n            v.push(glow(p([-0.3, 0.02, 0.0], [0.3, 0.02, 0.0], 0.06, 0.06, Vec3::new(0.3, 0.9, 1.0)), pulse));\n            v.push(p([0.0, 0.2, 0.0], [0.04, 3.0, 0.0], 0.09, 0.07, s));\n        }\n        Tool::Iv => {\n            let dose = m.meter.clamp(0.0, 1.3);\n            v.push(p([0.0, 0.0, 0.0], [0.0, 0.8, 0.0], 0.012, 0.02, s));\n            v.push(p([0.0, 0.8, 0.0], [0.0, 2.2, 0.0], 0.13, 0.13, Vec3::new(0.76, 0.85, 0.96)));\n            v.push(p([0.0, 2.2 - dose * 1.1, 0.0], [0.0, 3.05 - dose * 1.1, 0.0], 0.04, 0.04, s));\n            v.push(p([-0.14, 3.05 - dose * 1.1, 0.0], [0.14, 3.05 - dose * 1.1, 0.0], 0.05, 0.05, s));\n        }\n        Tool::Cryo => {\n            let c = Vec3::new(0.65, 0.9, 1.0);\n            v.push(glow(p([0.0, 0.0, 0.0], [0.0, 0.3, 0.0], 0.06, 0.04, c), if m.using { 1.5 } else { 0.4 }));\n            v.push(p([0.0, 0.3, 0.0], [0.0, 1.5, 0.0], 0.04, 0.11, s));\n            v.push(p([0.0, 1.5, 0.0], [0.0, 3.0, 0.0], 0.11, 0.1, Vec3::new(0.25, 0.42, 0.62)));\n            v.push(glow(p([0.0, 2.0, 0.1], [0.0, 2.6, 0.1], 0.02, 0.02, c), 1.0));\n        }\n        Tool::Dressing => {\n            v.push(p([-0.5, 0.12, 0.0], [0.5, 0.12, 0.0], 0.13, 0.13, Vec3::new(0.94, 0.94, 0.9)));\n            v.push(p([-0.56, 0.12, 0.0], [-0.1, 1.5, 0.0], 0.03, 0.04, s));\n            v.push(p([0.56, 0.12, 0.0], [0.1, 1.5, 0.0], 0.03, 0.04, s));\n            v.push(p([0.0, 1.5, 0.0], [0.0, 3.0, 0.0], 0.07, 0.07, Vec3::new(0.2, 0.55, 0.58)));\n        }\n        Tool::Defib => {\n            let r = Vec3::new(0.22, 0.24, 0.28);\n            let charge = m.meter;\n            for x in [-0.95f32, 0.95] {\n                v.push(p([x - 0.4, 0.06, 0.0], [x + 0.4, 0.06, 0.0], 0.1, 0.1, s));\n                v.push(p([x, 0.14, 0.0], [x, 1.2, 0.0], 0.14, 0.1, r));\n                v.push(glow(p([x, 0.5, 0.13], [x, 0.9, 0.13], 0.03, 0.03, Vec3::new(1.0, 0.8, 0.2)), charge * 3.0));\n            }\n        }\n    }\n    v\n}\n\n/// The direction the handle leans in the hand: toward the camera and the player.\npub fn hand_axis() -> Vec3 {\n    Vec3::new(0.42, 1.0, 0.48).normalize()\n}\n\n/// Draws a model: `tip` in the world, its handle along `axis`.\npub fn emit(scene: &mut Scene, tool: Tool, tip: Vec3, axis: Vec3, m: Motion, scale: f32, group: u32, lift_glow: f32) {\n    let rot = Quat::from_rotation_arc(Vec3::Y, axis.normalize());\n    let mat = Mat3::from_quat(rot);\n    for q in parts(tool, m) {\n        let a = tip + mat * (q.a * scale);\n        let b = tip + mat * (q.b * scale);\n        scene.sdfs.push(SdfInstance {\n            a,\n            b,\n            ra: q.ra * scale,\n            rb: q.rb * scale,\n            color: q.c,\n            emissive: q.e + lift_glow,\n            style: if q.e > 0.0 { Style::Unlit } else { Style::Lit },\n            flags: rs::flags::OBJECT | rs::flags::NO_CUT,\n            group,\n            material: 0,\n        });\n    }\n}\n\n/// The steel tray at the bottom of the field, an instrument per ring position.\n#[allow(clippy::too_many_arguments)]\npub fn emit_tray(scene: &mut Scene, ring: &[Tool; 8], selected: u8, time: f32, slots: &[Vec2; 8], clinical: bool) {\n    let _ = clinical;\n    let tray_steel = Vec3::new(0.46, 0.5, 0.53);\n    let half = Vec3::new(6.9, 0.07, 0.86);\n    scene.meshes.push(MeshInstance {\n        mesh: MeshKey::rounded_box(half, 0.06),\n        transform: Mat4::from_translation(Vec3::new(0.0, 0.92, 5.3)),\n        color: tray_steel,\n        emissive: 0.0,\n        style: Style::Lit,\n        flags: rs::flags::OBJECT | rs::flags::NO_CUT,\n        group: 0x900,\n        material: 0,\n        ext: half,\n    });\n    let selected = selected as usize;\n    for (k, tool) in ring.iter().enumerate() {\n        let lift = k == selected;\n        let y = if lift { 1.42 + (time * 3.0).sin() * 0.03 } else { 1.06 };\n        let at = slots[k];\n        // Laid flat, tips toward the patient.\n        let axis = Vec3::new(0.12, 0.05, 1.0);\n        let tip = Vec3::new(at.x, y, at.y - 0.56);\n        let scale = if lift { 0.42 } else { 0.36 };\n        let m = Motion { time, ..Default::default() };\n        emit(scene, *tool, tip, axis, m, scale, 0x910 + k as u32, if lift { 0.28 } else { 0.0 });\n    }\n}\nEOF\npython3 - <<'EOF'\np='crates/pav_core/src/games/surgery/field.rs'; s=open(p).read()\ns=s.replace('''/// Where the IV port is on the field.''','''/// Where each ring position's instrument lies on the tray (field coordinates): click targets.\npub fn tray_slot(k: usize) -> Vec2 {\n    Vec2::new(-5.95 + k as f32 * 1.7, 5.3)\n}\n\n/// The tray's row: a click below this line is on the tray, not the field.\npub const TRAY_Z: f32 = 4.45;\n\n/// Where the IV port is on the field.''')\nopen(p,'w').write(s)\np='crates/pav_core/src/games/surgery/mod.rs'; s=open(p).read()\ns=s.replace(\"pub mod net;\\n\",\"pub mod net;\\npub mod paper;\\n\")\nopen(p,'w').write(s)\nEOF\n","description":"Write the field plate and instrument renderers"}}}
