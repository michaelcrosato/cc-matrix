{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjxUKzQnbH5PmMGZtMML","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XiU5N8g6ZwMQGqVMBjJabt","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-072416__x42677a/work/TraumaTempo-TraumaCenterSecondOpinion-claude-opus-5-5-medium-20261105-072416/engine/crates/pav_core/src/games/surgery\npython3 - <<'EOF'\np='content.rs'; s=open(p).read()\ns=s.replace('''    pub cue: Option<String>,\n    pub banner: Option<String>,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Phase {''','''    pub cue: Option<String>,\n    pub banner: Option<String>,\n    /// The case's locked gift wakes, its meter full.\n    pub gift_full: bool,\n}\n\n#[derive(Clone, Debug, Default, Deserialize)]\n#[serde(deny_unknown_fields, default)]\npub struct Phase {''')\nopen(p,'w').write(s)\np='field.rs'; s=open(p).read()\ns=s.replace('''                if let Some(b) = &t.banner {\n                    self.set_banner(b);\n                }\n''','''                if let Some(b) = &t.banner {\n                    self.set_banner(b);\n                }\n                if t.gift_full {\n                    self.gifts.locked = false;\n                    for s in &mut self.slots {\n                        s.gift = 100.0;\n                    }\n                }\n''')\ns=s.replace('''            Kind::Bone if self.stage == 1 => self.b,\n            _ => self.a,''','''            Kind::Bone if self.stage == 1 => self.a.lerp(self.b, self.prog.clamp(0.0, 1.0)),\n            _ => self.a,''')\ns=s.replace('''            Kind::Bone if h.stage == 1 => p.distance(h.b),\n''','''            Kind::Bone if h.stage == 1 => dist_segment(p, h.a, h.b),\n            Kind::Tumor if h.stage == 2 => (p.distance(h.a) - h.r).max(0.0),\n''')\ns=s.replace('''                    // The wire crosses the seat of the fragment.\n                    let d = Vec2::new(0.9, 0.0);\n                    let at = h.b;\n                    h.c = at;\n                    h.a = at;\n                    let _ = d;\n''','''                    // The wire runs across the seat of the fragment.\n                    let at = h.b;\n                    let d = Vec2::new(0.9, 0.0);\n                    h.c = at;\n                    h.a = at - d;\n                    h.b = at + d;\n''')\ns=s.replace('''                    let h = self.remove(id).unwrap();\n                    self.stains.push(Stain { at: h.b, r: 0.4, kind: 2 });''','''                    let h = self.remove(id).unwrap();\n                    self.threads.push(Thread { a: h.a, b: h.b, n: h.need });''')\nopen(p,'w').write(s)\np='strain.rs'; s=open(p).read()\ns=s.replace('''                    h.stage += 1;\n                    self.mark(&format!(\"furnace:{stage}\"));''','''                    h.stage += 1;\n                    // An instrument this case hasn't got is skipped.\n                    let ring = self.ring;\n                    let h = &mut self.hazards[k];\n                    while h.stage < 5 && h.takes().is_some_and(|t| !ring.contains(&t)) {\n                        h.stage += 1;\n                    }\n                    self.mark(&format!(\"furnace:{stage}\"));''')\nopen(p,'w').write(s)\nEOF\ncd content\ncat > callouts.toml <<'EOF'\n# In-op callouts: short, clinical, urgent. Triggered by name from the rules; `who` must be a rig.\n# Bashir's lines go to Teddy in Case 7, where Bashir is the patient.\n[callout.wrong_tool]\nwho = \"bashir\"\ntext = [\"Wrong instrument, Doctor.\", \"Not that one, Doctor.\", \"Doctor. The other one.\"]\n[callout.healthy]\nwho = \"bashir\"\ntext = [\"Doctor, that's healthy tissue.\", \"That was healthy, Doctor. It was.\", \"Off the line, Doctor.\"]\n[callout.off_axis]\nwho = \"bashir\"\ntext = [\"Along the shaft, Doctor. You tore it.\", \"Straight out. Straight.\"]\n[callout.vitals_low]\nwho = \"teddy\"\ntext = [\"Vitals at forty. Push the IV. Now!\", \"Forty and falling. I'd like an IV please. Quite soon.\", \"Pressure's going. Doctor, the IV!\"]\n[callout.lift_off]\nwho = \"bashir\"\ntext = [\"Lift off! Lift off!\", \"Hands up, Doctor!\", \"Off the tissue! Now!\"]\n[callout.overheat]\nwho = \"bashir\"\ntext = [\"Too long on the beam. That's a burn.\", \"You're cooking it, Doctor.\"]\n[callout.frostbite]\nwho = \"bashir\"\ntext = [\"Too cold. Frostbite.\", \"You've frozen healthy wall, Doctor.\"]\n[callout.overdose]\nwho = \"teddy\"\ntext = [\"That's too much! That's too much, you're, oh, there it goes.\", \"Overdose! Overdose! I'm correcting!\"]\n[callout.sac_burst]\nwho = \"teddy\"\ntext = [\"One burst! It's caustic, it's eating the pleura!\", \"Burst! Suction! Somebody suction!\"]\n[callout.eye_closed]\nwho = \"bashir\"\ntext = [\"It closed. It's weeping again.\", \"Too late. Here comes another wave.\"]\n[callout.shell_popped]\nwho = \"bashir\"\ntext = [\"Shell's off. Forceps. Two beats.\", \"Open. Pull it. Now.\"]\n[callout.stroke_missed]\nwho = \"pet\"\ntext = [\"You dropped a bar, girl. Keep time.\", \"Late! It doesn't wait for you.\"]\n[callout.tendril_systole]\nwho = \"pet\"\ntext = [\"Not on the squeeze! Pull when she lets go!\", \"Between beats, you butcher. Between beats.\"]\nEOF\nring_note='# Fields: docs in ../README.md. Coordinates: x -9..9, z -4..4.2. Angles in degrees.'\ncat > cases/case0.toml <<EOF\n$ring_note\nname = \"Barbs\"\nsurgeon = \"mara\"\nplate = \"forearm\"\ntimer = 240.0\npar = 7300.0\npatient = \"Anton Deverell\"\nlife = \"Net-mender, Pier Nine. Forty years of knots.\"\ndiagnosis = \"Hooks and cable splinters, right forearm. Storm injury.\"\nfate = \"Anton Deverell will mend nets again by spring.\"\nbefore = \"case0_before\"\nafter = \"case0_after\"\ngift = \"none\"\nmusic = \"or\"\n\n[[phase]]\nname = \"gel\"\nnow = \"Pick the GEL. Paint the raw skin until the ring is full.\"\nguide = true\ncheckpoint = true\nspawn = [{ kind = \"patch\", a = [-2.0, 0.4], r = 1.3 }]\nsay = [\n  { who = \"bashir\", text = \"Doctor. Flick to your tray. Gel first, the skin is raw.\", at = 0.5 },\n  { who = \"bashir\", text = \"Hold and paint. Slowly. It's skin, not a fence.\", at = 6.0 },\n]\n\n[[phase]]\nname = \"hooks\"\nnow = \"FORCEPS. Grab each hook and pull along its shaft.\"\nguide = true\nspawn = [\n  { kind = \"object\", a = [-3.5, -1.2], ang = 150.0, sub = 0 },\n  { kind = \"object\", a = [1.0, 1.4], ang = 40.0, sub = 0 },\n  { kind = \"object\", a = [3.8, -0.8], ang = -30.0, sub = 2 },\n]\nsay = [\n  { who = \"bashir\", text = \"Forceps, Doctor. Lift the hook. ...Doctor.\", at = 0.3 },\n  { who = \"bashir\", text = \"Along the shaft. A barb tears anything else.\", at = 5.0 },\n]\n\n[[phase]]\nname = \"pool\"\nnow = \"SUCTION the blood. Something's under it.\"\nguide = true\nspawn = [\n  { kind = \"pool\", a = [0.6, -0.4], r = 1.5 },\n  { kind = \"object\", a = [0.6, -0.3], ang = 100.0, sub = 0 },\n]\nsay = [\n  { who = \"bashir\", text = \"One more. Under the pool. I can't see it either. Suction.\", at = 0.3 },\n  { who = \"mara\", text = \"How did you know?\", at = 5.0 },\n  { who = \"bashir\", text = \"I've met a hook before, Doctor.\", at = 7.5 },\n]\n\n[[phase]]\nname = \"suture\"\nnow = \"SUTURE. Zigzag across the wounds, one stitch at a time.\"\nguide = true\ncheckpoint = true\nspawn = [\n  { kind = \"lacer\", a = [-4.0, 1.6], b = [-1.2, 0.8] },\n  { kind = \"lacer\", a = [2.2, -1.8], b = [5.0, -0.8] },\n]\nsay = [\n  { who = \"bashir\", text = \"They'll bleed until they're closed. Suture. Across, and across.\", at = 0.3 },\n  { who = \"bashir\", text = \"Even spacing. His wife will see this.\", at = 6.0 },\n]\n\n[[phase]]\nname = \"close\"\nnow = \"Draw the DRESSING along the arm.\"\nguide = true\nspawn = [{ kind = \"closure\", a = [-5.5, 0.5], b = [5.5, 0.2], c = [0.0, 1.0] }]\nsay = [{ who = \"bashir\", text = \"The dressing, Doctor. One long pass. Then you may breathe.\", at = 0.3 }]\nEOF\ncat > cases/case1.toml <<EOF\n$ring_note\nname = \"Routine\"\nsurgeon = \"mara\"\nplate = \"abdomen\"\ntimer = 270.0\npar = 9300.0\npatient = \"Rosalind Pike\"\nlife = \"Harbour pilot. Has never once run aground.\"\ndiagnosis = \"Acute appendicitis. Nothing about this is unusual.\"\nfate = \"Rosalind Pike will take the morning tide within the week.\"\nbefore = \"case1_before\"\nafter = \"case1_after\"\ngift = \"none\"\nmusic = \"or\"\n\n[[phase]]\nname = \"incision\"\nnow = \"SCALPEL. Follow the dashed line in one stroke.\"\nguide = true\ncheckpoint = true\nspawn = [{ kind = \"incision\", a = [-3.8, 0.8], b = [3.8, 0.6], c = [0.0, -0.3] }]\nsay = [\n  { who = \"bashir\", text = \"Scalpel. One stroke, Doctor. The gallery is watching.\", at = 0.3 },\n  { who = \"voss\", text = \"Adequate is the floor, Doctor Quill. Do try to clear it.\", at = 4.5 },\n]\n\n[[phase]]\nname = \"polyps\"\nnow = \"LASER each polyp. Let go when the ring is nearly full.\"\nguide = true\nreveal_plate = \"bowel\"\nspawn = [\n  { kind = \"polyp\", a = [-3.4, -1.3] },\n  { kind = \"polyp\", a = [-1.6, -2.2] },\n  { kind = \"polyp\", a = [1.2, -1.5] },\n  { kind = \"polyp\", a = [3.6, -2.3] },\n  { kind = \"polyp\", a = [2.6, 1.2] },\n]\nsay = [\n  { who = \"teddy\", text = \"Polyps. Festive. Nobody ordered those.\", at = 1.0 },\n  { who = \"bashir\", text = \"Laser. Hold it until the ring fills. Release at the top, not after.\", at = 4.0 },\n]\n\n[[phase]]\nname = \"iv\"\nnow = \"VITALS FALLING. IV PUSH: hold, release in the green.\"\nguide = true\ncheckpoint = true\nspawn = [\n  { kind = \"lacer\", a = [-5.0, 1.5], b = [-2.4, 2.2] },\n  { kind = \"pool\", a = [-3.8, 2.4], r = 1.0 },\n]\ntrigger = [{ at_time = 0.5, say = [{ who = \"teddy\", text = \"Pressure's sagging. IV port, top-left of your ring. Hold, watch the band, let go.\", at = 0.0 }] }]\n\n[[phase]]\nname = \"appendix\"\nnow = \"Pull the appendix free with the FORCEPS.\"\nguide = true\nspawn = [\n  { kind = \"incision\", a = [1.2, -0.8], b = [3.8, 0.8], c = [2.8, -0.6] },\n  { kind = \"object\", a = [2.4, 0.4], ang = -60.0, sub = 4, r = 0.7 },\n]\nsay = [{ who = \"bashir\", text = \"Open the mesentery. Then the appendix. Mind the artery.\", at = 0.3 }]\n\n[[phase]]\nname = \"artery\"\nnow = \"An ARTERY let go! SUTURE the bleeder. Three fast crossings.\"\ncheckpoint = true\nbanner = \"COMPLICATION\"\nspawn = [\n  { kind = \"bleeder\", a = [0.2, 1.0], ang = 20.0 },\n  { kind = \"pool\", a = [1.2, 1.6], r = 0.9 },\n]\nsay = [\n  { who = \"teddy\", text = \"Whoa. Whoa, whoa. That's not a drip, that's a fountain!\", at = 0.2 },\n  { who = \"bashir\", text = \"Bleeder, Doctor. Suture. Three crossings. Fast.\", at = 2.0 },\n  { who = \"voss\", text = \"Yes, Doctor Quill. They do that.\", at = 6.0 },\n]\n\n[[phase]]\nname = \"close\"\nnow = \"Close her. One long DRESSING.\"\nspawn = [{ kind = \"closure\", a = [-4.5, 0.6], b = [4.5, 0.2], c = [0.0, -0.5] }]\nEOF\ncat > cases/case2.toml <<EOF\n$ring_note\nname = \"Shrapnel Night\"\nsurgeon = \"mara\"\nplate = \"chest\"\ntimer = 300.0\npar = 13900.0\npatient = \"Gideon Oyelaran\"\nlife = \"Foreman, Terminal Four. Got eleven men out first.\"\ndiagnosis = \"Blast injury. Multiple metal fragments, left chest.\"\nfate = \"Gideon Oyelaran will walk his eleven men's children to school. All of them, in shifts.\"\nbefore = \"case2_before\"\nafter = \"case2_after\"\ngift = \"none\"\nmusic = \"or\"\n\n[[phase]]\nname = \"open\"\nnow = \"SCALPEL. Open the chest along the line.\"\ncheckpoint = true\nguide = true\nspawn = [{ kind = \"incision\", a = [-4.5, 1.2], b = [4.2, -0.6], c = [0.0, 1.0] }]\nsay = [{ who = \"teddy\", text = \"He's got more iron in him than the terminal. Please go faster. I'm not panicking.\", at = 0.5 }]\n\n[[phase]]\nname = \"scan\"\nnow = \"SCANNER. Sweep the lung to find the shards, then FORCEPS.\"\nguide = true\nreveal_plate = \"lung\"\nspawn = [\n  { kind = \"object\", a = [-4.0, -1.5], ang = 120.0, sub = 1, hidden = true },\n  { kind = \"object\", a = [-0.8, 2.0], ang = 70.0, sub = 1, hidden = true },\n  { kind = \"object\", a = [3.2, -2.2], ang = -40.0, sub = 1, hidden = true },\n  { kind = \"object\", a = [4.8, 1.4], ang = 20.0, sub = 1, hidden = true },\n]\nsay = [\n  { who = \"bashir\", text = \"You won't see them. The Scanner will. Hold and sweep.\", at = 1.0 },\n  { who = \"bashir\", text = \"A ping lights them for eight seconds, Doctor. Eight.\", at = 6.0 },\n]\n\n[[phase]]\nname = \"wounds\"\nnow = \"Clean up: SUCTION and SUTURE.\"\ncheckpoint = true\nspawn = [\n  { kind = \"lacer\", a = [-5.0, 0.2], b = [-2.0, 1.1] },\n  { kind = \"lacer\", a = [1.0, -2.6], b = [3.8, -1.4] },\n  { kind = \"pool\", a = [-3.0, 2.0], r = 1.1, optional = true },\n  { kind = \"pool\", a = [4.6, 0.6], r = 1.0, optional = true },\n  { kind = \"bleeder\", a = [0.0, 0.4], ang = 70.0 },\n]\n\n[[phase]]\nname = \"stop\"\nnow = \"DEFIBRILLATE. Hold both, release as the ghost beat crosses.\"\ncode_shocks = 1\nguide = true\nsay = [\n  { who = \"mara\", text = \"Now.\", at = 0.0 },\n]\nlinger = 0.8\n\n[[phase]]\nname = \"after_stop\"\nnow = \"He's back. Finish it, Doctor.\"\nspawn = [\n  { kind = \"object\", a = [1.6, 1.0], ang = 45.0, sub = 1, hidden = true },\n  { kind = \"patch\", a = [-2.2, -1.4], r = 1.0 },\n  { kind = \"lacer\", a = [-1.0, 2.6], b = [1.6, 2.6] },\n]\nsay = [\n  { who = \"teddy\", text = \"I, what? You said now. The monitor hadn't. How did you...\", at = 0.3 },\n  { who = \"bashir\", text = \"Later, Teddy.\", at = 3.0 },\n]\n\n[[phase]]\nname = \"close\"\nnow = \"Close the chest with the DRESSING.\"\nspawn = [{ kind = \"closure\", a = [-4.5, 1.2], b = [4.2, -0.6], c = [0.0, 1.0] }]\nEOF\ncat > cases/case3.toml <<EOF\n$ring_note\nname = \"Something Moved\"\nsurgeon = \"mara\"\nplate = \"liver\"\ntimer = 360.0\npar = 25300.0\npatient = \"Ines Calloway\"\nlife = \"Courier for the Vane Foundation. Carries sealed envelopes and doesn't ask.\"\ndiagnosis = \"Benign hepatic mass, four centimetres. Elective. Unremarkable.\"\nfate = \"Ines Calloway will never be told what was in her liver. She will keep the scar and stop carrying envelopes.\"\nbefore = \"case3_before\"\nafter = \"case3_after\"\ngift = \"hush\"\ngift_locked = true\nmusic = \"or\"\n\n[[phase]]\nname = \"tumor\"\nnow = \"Ring the mass with the SCALPEL, lift it, GEL the bed.\"\ncheckpoint = true\nguide = true\nspawn = [{ kind = \"tumor\", a = [0.0, 0.1], r = 1.5, ang = -80.0 }]\nsay = [\n  { who = \"bashir\", text = \"A benign mass. Ring it, Doctor. Forceps. Lift. Gel. Home by two.\", at = 0.5 },\n  { who = \"teddy\", text = \"Gala's still going upstairs. There's a string quartet. You can hear it through the vents.\", at = 7.0 },\n]\n\n[[phase]]\nname = \"moved\"\nnow = \"It moved.\"\nlinger = 2.0\nmeter = 3\nbanner = \"SOMETHING MOVED\"\nsay = [\n  { who = \"mara\", text = \"It moved.\", at = 0.2 },\n  { who = \"bashir\", text = \"Masses don't move.\", at = 1.4 },\n  { who = \"mara\", text = \"Bashir. It moved.\", at = 2.6 },\n]\ntrigger = [{ at_time = 0.1, cue = \"sting\" }]\n\n[[phase]]\nname = \"introit\"\nnow = \"SCANNER finds it. LASER it at rest. FORCEPS when the shell pops.\"\ncheckpoint = true\nstrain = \"introit\"\nmusic = 0\nsay = [\n  { who = \"teddy\", text = \"Guys? The ECG just went into three-four time. That's a waltz. Hearts aren't in a time signature. Hearts aren't allowed.\", at = 0.5 },\n  { who = \"bashir\", text = \"It steps every third beat. When it's still, Doctor.\", at = 7.0 },\n]\n\n[[phase]]\nname = \"wounds\"\nnow = \"It's over. Close what it left behind.\"\nmeter = 4\nspawn = [{ kind = \"lacer\", a = [-2.0, 2.0], b = [1.0, 2.6] }]\nsay = [{ who = \"teddy\", text = \"It's four-four. It's four-four again. I would like to go home now.\", at = 0.5 }]\n\n[[phase]]\nname = \"close\"\nnow = \"DRESSING. Then wash your hands.\"\nspawn = [{ kind = \"closure\", a = [-4.0, 0.2], b = [4.0, 0.2], c = [0.0, -1.0] }]\nEOF\nsed -i '/^music = 0$/d' cases/case3.toml\ncat > cases/case4.toml <<EOF\n$ring_note\nname = \"The Night Ward\"\nsurgeon = \"mara\"\nplate = \"lung\"\ntimer = 360.0\npar = 25500.0\npatient = \"Rosalind Pike\"\nlife = \"Harbour pilot. She came back in for a cough.\"\ndiagnosis = \"R.E.Q.U.I.E.M., Lacrimosa strain. Seeded during recovery on this hospital's own ward.\"\nfate = \"Rosalind Pike will take the morning tide. She will never again trust a quiet sea.\"\nbefore = \"case4_before\"\nafter = \"case4_after\"\ngift = \"hush\"\nmusic = \"lacrimosa\"\n\n[[phase]]\nname = \"lacrimosa\"\nnow = \"LASER the stems before the sacs burst. Then cut the EYE, twice.\"\ncheckpoint = true\nstrain = \"lacrimosa\"\nmeter = 6\nparams = { waves = 3 }\nsay = [\n  { who = \"voss\", text = \"No guidance tonight, Doctor Quill. Nobody here has done this. Nobody.\", at = 0.5 },\n  { who = \"teddy\", text = \"Six-eight. She's in six-eight. It's almost pretty, is the awful thing.\", at = 5.0 },\n]\n\n[[phase]]\nname = \"flood\"\nnow = \"Clear the flood.\"\ncheckpoint = true\nmeter = 4\nspawn = [\n  { kind = \"pool\", a = [-4.0, -1.8], r = 1.3 },\n  { kind = \"pool\", a = [3.8, 1.6], r = 1.3 },\n  { kind = \"lacer\", a = [-1.5, 2.2], b = [1.5, 2.8] },\n  { kind = \"burn\", a = [0.2, -2.4], r = 1.0 },\n]\n\n[[phase]]\nname = \"close\"\nnow = \"DRESSING.\"\nspawn = [{ kind = \"closure\", a = [-4.5, -0.4], b = [4.5, -0.4], c = [0.0, 0.8] }]\nEOF\ncat > cases/case5.toml <<EOF\n$ring_note\nname = \"Second Opinion\"\nsurgeon = \"pet\"\nplate = \"femur\"\ntimer = 360.0\npar = 22900.0\npatient = \"Lucjan Bazyli\"\nlife = \"Longshoreman. Fell forty feet, got up, and complained about the noise.\"\ndiagnosis = \"Shattered femur. Three free fragments. Marrow findings to follow.\"\nfate = \"Lucjan Bazyli will limp, and will tell everyone it was a much higher fall.\"\nbefore = \"case5_before\"\nafter = \"case5_after\"\ngift = \"echo\"\ngift_locked = true\nmusic = \"tense\"\n\n[[phase]]\nname = \"open\"\nnow = \"SCALPEL. Open along the bone.\"\ncheckpoint = true\nspawn = [{ kind = \"incision\", a = [-5.5, 2.3], b = [5.5, 2.5], c = [0.0, 2.8] }]\nsay = [\n  { who = \"pet\", text = \"I have buried better surgeons than you, and I liked them less. Scalpel.\", at = 0.4 },\n  { who = \"bashir\", text = \"That's the tremor, Doctor Nwosu. Your right hand.\", at = 5.0 },\n  { who = \"pet\", text = \"I know where my right hand is, young man. Hold the Precision and mind your tray.\", at = 8.0 },\n]\n\n[[phase]]\nname = \"bones\"\nnow = \"FORCEPS: carry each fragment home. Turn it to fit. Wire it with the SUTURE.\"\ncheckpoint = true\nguide = true\nspawn = [\n  { kind = \"bone\", a = [-5.5, -2.6], b = [-3.2, 0.0], ang = 55.0 },\n  { kind = \"bone\", a = [0.4, -3.0], b = [0.0, 0.0], ang = -70.0 },\n  { kind = \"bone\", a = [5.5, -2.4], b = [3.2, 0.0], ang = 40.0 },\n]\nsay = [\n  { who = \"bashir\", text = \"It snaps in when it's close and square. Then two turns of wire.\", at = 1.0 },\n  { who = \"pet\", text = \"L1 and R1, wheel on a mouse. It's a femur, not a Rubik's cube.\", at = 6.0 },\n]\n\n[[phase]]\nname = \"cysts\"\nnow = \"Cysts in the marrow. LASER, and let the hands do it.\"\ncheckpoint = true\nspawn = [\n  { kind = \"polyp\", a = [-5.5, 0.1], r = 0.45 },\n  { kind = \"polyp\", a = [-4.2, 0.9], r = 0.45 },\n  { kind = \"polyp\", a = [-1.2, -1.0], r = 0.45 },\n  { kind = \"polyp\", a = [1.4, 1.1], r = 0.45 },\n  { kind = \"polyp\", a = [2.4, -1.3], r = 0.45 },\n  { kind = \"polyp\", a = [4.2, 1.2], r = 0.45 },\n  { kind = \"polyp\", a = [5.6, -0.4], r = 0.45 },\n  { kind = \"polyp\", a = [0.0, 2.0], r = 0.45 },\n]\ntrigger = [{ at_time = 1.0, gift_full = true, banner = \"THE ECHO\", cue = \"echo\", say = [\n  { who = \"bashir\", text = \"Doctor Nwosu... there were two of you.\", at = 0.0 },\n] }]\nsay = [{ who = \"pet\", text = \"There were always two of me, young man. One of them retired.\", at = 4.5 }]\n\n[[phase]]\nname = \"wash\"\nnow = \"Clear the field.\"\nspawn = [\n  { kind = \"pool\", a = [-3.0, 2.0], r = 1.2 },\n  { kind = \"pool\", a = [3.4, -2.2], r = 1.1 },\n  { kind = \"lacer\", a = [-1.0, -2.8], b = [1.8, -2.4] },\n  { kind = \"patch\", a = [3.0, 2.2], r = 1.0 },\n]\n\n[[phase]]\nname = \"close\"\nnow = \"DRESSING. Steady, now.\"\nspawn = [{ kind = \"closure\", a = [-5.5, 2.3], b = [5.5, 2.5], c = [0.0, 2.8] }]\nEOF\ncat > cases/case6.toml <<EOF\n$ring_note\nname = \"Dies Irae\"\nsurgeon = \"pet\"\nplate = \"pericardium\"\nring = [\"scalpel\", \"forceps\", \"suture\", \"suction\", \"cryo\", \"gel\", \"scanner\", \"iv\"]\ntimer = 420.0\npar = 31600.0\npatient = \"Ottoline Voss\"\nlife = \"Chief of Surgery. Has carried this for eleven years and told no one.\"\ndiagnosis = \"R.E.Q.U.I.E.M., Dies Irae strain, pericardial. Fever rising. Self-reported.\"\nfate = \"Ottoline Voss will live, and will complain about the stitches. They are, she concedes, adequate.\"\nbefore = \"case6_before\"\nafter = \"case6_after\"\ngift = \"echo\"\nmusic = \"dies\"\n\n[[phase]]\nname = \"dies\"\nnow = \"CRYO an ember. SCALPEL to crack it. FORCEPS the pieces. Lift off at the rings!\"\ncheckpoint = true\nstrain = \"dies\"\nmeter = 5\nguide = true\nsay = [\n  { who = \"voss\", text = \"If I die on your table, Perpetua, you'll have to fill out the form.\", at = 0.5 },\n  { who = \"pet\", text = \"I have been looking forward to it.\", at = 4.0 },\n  { who = \"bashir\", text = \"Heat ring on every fifth beat, Doctor. Trigger up when it crosses.\", at = 8.0 },\n]\n\n[[phase]]\nname = \"burns\"\nnow = \"GEL the burns and close what's open.\"\ncheckpoint = true\nmeter = 4\nspawn = [\n  { kind = \"burn\", a = [-3.0, -1.6], r = 1.1 },\n  { kind = \"burn\", a = [3.0, 1.6], r = 1.1 },\n  { kind = \"lacer\", a = [-1.2, 2.2], b = [1.8, 2.6] },\n]\nsay = [{ who = \"teddy\", text = \"Fever's breaking. Hers. Mine's fine, thanks for asking.\", at = 0.5 }]\n\n[[phase]]\nname = \"close\"\nnow = \"DRESSING. Make it pretty; she'll inspect it.\"\nspawn = [{ kind = \"closure\", a = [-4.5, 0.0], b = [4.5, 0.0], c = [0.0, 1.2] }]\nEOF\ncat > cases/case7.toml <<EOF\n$ring_note\n# The partner (Pet) is a bot-driven seat until a second player takes it. Left of the ring holds\n# the Cryoprobe here: the nodules stay visible.\nname = \"Libera Me\"\nsurgeon = \"mara\"\nplate = \"heart\"\nring = [\"scalpel\", \"forceps\", \"suture\", \"suction\", \"laser\", \"gel\", \"cryo\", \"iv\"]\ntimer = 540.0\npar = 53400.0\npatient = \"Bashir Haddad\"\nlife = \"Scrub nurse. Has said \\\"Doctor\\\" fourteen different ways, and meant each one.\"\ndiagnosis = \"R.E.Q.U.I.E.M., all movements. Delivered in a floral arrangement.\"\nfate = \"Bashir Haddad will scrub in on Monday. He will say nothing about it, and he will say so.\"\nbefore = \"case7_before\"\nafter = \"case7_after\"\ngift = \"duet\"\nmusic = \"libera\"\n\n[[phase]]\nname = \"a\"\nnow = \"Introit again. LASER, FORCEPS. She's taking the left side.\"\ncheckpoint = true\nstrain = \"introit\"\nmeter = 3\nparams = { mini = 1, count = 3 }\nspawn = [{ kind = \"pool\", a = [-5.0, 2.2], r = 1.0, optional = true }, { kind = \"pool\", a = [5.0, -2.4], r = 1.0, optional = true }]\nsay = [\n  { who = \"teddy\", text = \"Scalpel. Here. I, yes. Handle first. I've seen it done. Mostly.\", at = 0.5 },\n  { who = \"pet\", text = \"Three-four, Quill. You know this one. Everyone knows the first dance.\", at = 5.0 },\n]\n\n[[phase]]\nname = \"b\"\nnow = \"Sacs on the coronaries. LASER the stems.\"\ncheckpoint = true\nstrain = \"lacrimosa\"\nmeter = 6\nparams = { waves = 1, mini = 1, count = 4 }\nsay = [{ who = \"teddy\", text = \"Six-eight! On the coronaries! Who designs this? Who sits down and designs this?\", at = 0.5 }]\n\n[[phase]]\nname = \"c\"\nnow = \"Embers. CRYO, SCALPEL, FORCEPS. Lift off at the rings.\"\ncheckpoint = true\nstrain = \"dies\"\nmeter = 7\nparams = { mini = 1, count = 2 }\nsay = [{ who = \"pet\", text = \"Seven-eight now. It's showing off. Count it, and keep your hands up.\", at = 0.5 }]\n\n[[phase]]\nname = \"d\"\nnow = \"It stopped him on purpose. THREE SHOCKS, each on the ghost beat.\"\ncode_shocks = 3\nmeter = 4\nlinger = 0.8\nsay = [{ who = \"mara\", text = \"It's stopping him. Teddy, it knows. Charge it.\", at = 0.0 }]\n\n[[phase]]\nname = \"e\"\nnow = \"THE SOLOIST. Scalpel strokes, on the beat.\"\ncheckpoint = true\nstrain = \"soloist\"\nmeter = 4\nparams = { need = 8 }\nsay = [\n  { who = \"teddy\", text = \"Something's coming up. It's, oh. It's singing. The monitor is singing.\", at = 0.5 },\n  { who = \"mara\", text = \"I can hear the flat. Pet. It's a quarter-tone flat. Right there.\", at = 5.0 },\n]\n\n[[phase]]\nname = \"f\"\nnow = \"The long tendril. FORCEPS: pull only when the heart lets go.\"\ncheckpoint = true\nstrain = \"tendril\"\nsay = [{ who = \"pet\", text = \"Now pull. Not on the squeeze. On the rest. Every heart rests, girl. Even this one.\", at = 0.5 }]\n\n[[phase]]\nname = \"close\"\nnow = \"DRESSING. Bring him home.\"\nspawn = [{ kind = \"closure\", a = [-4.5, 1.2], b = [4.5, 1.0], c = [0.0, 2.2] }]\nsay = [{ who = \"teddy\", text = \"Seventy-two. Four-four. Nobody move. Seventy-two.\", at = 0.5 }]\nEOF\ncat > cases/codeblue.toml <<EOF\n$ring_note\n# The co-op round: a director spawns hazards with a budget for the team's size.\nname = \"Code Blue\"\nsurgeon = \"bashir\"\nplate = \"torso\"\ntimer = 240.0\npar = 40000.0\npatient = \"Unknown male, 40s\"\nlife = \"Pulled from the harbour at 3 a.m. Nobody has come for him yet.\"\ndiagnosis = \"Everything, and quickly. Keep the patient alive.\"\nfate = \"The patient lived. He has given his name as Tuesday.\"\ngift = \"none\"\nmusic = \"codeblue\"\n\n[[phase]]\nname = \"code_blue\"\nnow = \"Keep the patient alive.\"\nstrain = \"director\"\nparams = { budget = 1.0, interval = 5.2 }\nsay = [{ who = \"bashir\", text = \"All hands. Nobody is in charge. Everybody is in charge. Go.\", at = 0.5 }]\nEOF\nplate() { # name file lobes... \ncat > plates/$1.toml\n}\nplate forearm <<'EOF'\nname = \"Forearm\"\nbed = \"#4a161e\"\nflesh = \"#d6665c\"\ntop = \"#f2a78e\"\nvein = \"#963c50\"\npulse = 0.02\nnoise = 0.06\nveins = 0.25\nlobes = [{ x = 0.0, z = 0.1, a = 72.0, b = 22.0, h = 1.3 }]\nvessels = [{ points = [[-8.0, -1.6], [-3.0, -1.0], [2.0, -2.0], [8.0, -1.4]], w = 0.16, h = 0.07 }]\nEOF\nplate abdomen <<'EOF'\nname = \"Abdomen, skin\"\nbed = \"#4a161e\"\nflesh = \"#e2a487\"\ntop = \"#f6c5a8\"\nvein = \"#c07a70\"\npulse = 0.015\nnoise = 0.04\nveins = 0.05\nlobes = [{ x = 0.0, z = 0.2, a = 95.0, b = 28.0, h = 1.3 }]\nEOF\nplate bowel <<'EOF'\nname = \"Bowel\"\nbed = \"#3c121a\"\nflesh = \"#d9707a\"\ntop = \"#f4a6a0\"\nvein = \"#9a3b58\"\npulse = 0.03\nnoise = 0.12\nveins = 0.4\nlobes = [\n  { x = -4.6, z = -1.6, a = 7.5, b = 3.2, h = 1.1 }, { x = 0.0, z = -2.0, a = 9.0, b = 3.2, h = 1.2 },\n  { x = 4.6, z = -1.4, a = 7.5, b = 3.2, h = 1.1 }, { x = -4.2, z = 1.8, a = 8.0, b = 3.4, h = 1.1 },\n  { x = 0.4, z = 1.6, a = 10.0, b = 3.6, h = 1.25 }, { x = 5.0, z = 1.8, a = 7.0, b = 3.2, h = 1.05 },\n]\nEOF\nplate chest <<'EOF'\nname = \"Chest, skin\"\nbed = \"#4a161e\"\nflesh = \"#c98c6a\"\ntop = \"#e6b38f\"\nvein = \"#a0705c\"\npulse = 0.03\nnoise = 0.05\nveins = 0.05\nlobes = [{ x = -3.2, z = 0.0, a = 40.0, b = 22.0, h = 1.2 }, { x = 3.2, z = 0.0, a = 40.0, b = 22.0, h = 1.2 }]\nEOF\nplate lung <<'EOF'\nname = \"Lung and rib\"\nbed = \"#3a1420\"\nflesh = \"#d78a94\"\ntop = \"#f6c0c0\"\nvein = \"#a84e66\"\npulse = 0.05\nnoise = 0.08\nveins = 0.55\nlobes = [\n  { x = -3.4, z = 0.0, a = 26.0, b = 15.0, h = 1.25 }, { x = 3.2, z = 0.2, a = 28.0, b = 15.0, h = 1.2 },\n  { x = 0.0, z = -3.8, a = 60.0, b = 1.0, h = 0.7 }, { x = 0.0, z = 3.9, a = 60.0, b = 1.0, h = 0.7 },\n]\nEOF\nplate liver <<'EOF'\nname = \"Liver\"\nbed = \"#2c0f12\"\nflesh = \"#8c2f2c\"\ntop = \"#c65a4c\"\nvein = \"#5d1a22\"\npulse = 0.03\nnoise = 0.05\nveins = 0.3\nlobes = [{ x = -1.6, z = 0.0, a = 42.0, b = 15.0, h = 1.35 }, { x = 4.0, z = -0.6, a = 16.0, b = 9.0, h = 1.0 }]\nEOF\nplate femur <<'EOF'\nname = \"Femur\"\nbed = \"#3b1218\"\nflesh = \"#b5525a\"\ntop = \"#d97f7a\"\nvein = \"#7f2c3a\"\npulse = 0.02\nnoise = 0.05\nveins = 0.2\nbone = true\nlobes = [{ x = 0.0, z = 0.0, a = 70.0, b = 2.2, h = 1.0 }, { x = -7.5, z = 0.0, a = 4.0, b = 4.0, h = 0.8 }, { x = 7.5, z = 0.0, a = 4.0, b = 4.0, h = 0.8 }]\nEOF\nplate pericardium <<'EOF'\nname = \"Pericardium\"\nbed = \"#31101a\"\nflesh = \"#c76a72\"\ntop = \"#f0b7a8\"\nvein = \"#8a3347\"\npulse = 0.09\nnoise = 0.04\nveins = 0.45\nlobes = [{ x = 0.0, z = 0.0, a = 42.0, b = 17.0, h = 1.4 }]\nEOF\nplate heart <<'EOF'\nname = \"The beating heart\"\nbed = \"#26080e\"\nflesh = \"#b33a3e\"\ntop = \"#ee8a78\"\nvein = \"#6a1a2c\"\npulse = 0.2\nnoise = 0.05\nveins = 0.6\nlobes = [{ x = -1.6, z = -0.4, a = 26.0, b = 15.0, h = 1.45 }, { x = 2.0, z = 0.4, a = 22.0, b = 13.0, h = 1.3 }]\nvessels = [\n  { points = [[-6.0, -3.0], [-2.5, -1.2], [-0.6, 1.0], [0.8, 3.4]], w = 0.26, h = 0.12 },\n  { points = [[5.5, -2.4], [2.0, -1.6], [0.2, -0.2]], w = 0.2, h = 0.1 },\n]\nEOF\nplate torso <<'EOF'\nname = \"Torso\"\nbed = \"#3c141c\"\nflesh = \"#c9766c\"\ntop = \"#eea78e\"\nvein = \"#8f3c50\"\npulse = 0.04\nnoise = 0.07\nveins = 0.35\nlobes = [{ x = 0.0, z = 0.0, a = 95.0, b = 26.0, h = 1.25 }]\nEOF\nsed -i 's/^vessels = \\[\\]//' plates/*.toml\ncat > rigs/_face.toml <<'EOF'\n# Parts every character shares (colours come from each rig's [colors]). z is the layer number; a\n# new layer draws an ink line. `layer` says what moves it: head, eyes, brow, lid; empty = body.\nname = \"face\"\n[[part]]\nname = \"shoulders\"\nz = 1.0\ncolor = \"scrubs\"\nchaikin = 2\npoints = [[-1.72,-2.4],[-1.66,-1.36],[-1.2,-1.02],[-0.52,-0.82],[-0.3,-0.72],[0.0,-1.34],[0.3,-0.72],[0.52,-0.82],[1.2,-1.02],[1.66,-1.36],[1.72,-2.4]]\n[[part]]\nname = \"neck\"\nz = 1.6\ncolor = \"shade\"\nchaikin = 2\npoints = [[-0.3,-1.2],[-0.33,-0.3],[0.33,-0.3],[0.3,-1.2],[0.0,-1.32]]\n[[part]]\nname = \"face\"\nz = 3.0\ncolor = \"skin\"\nchaikin = 3\nlayer = \"head\"\npoints = [[-0.76,0.76],[-0.74,0.28],[-0.56,-0.16],[-0.26,-0.5],[