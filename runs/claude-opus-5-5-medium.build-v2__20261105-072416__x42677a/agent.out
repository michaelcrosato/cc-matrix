{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjygPB7XD4bZXYuB5cWn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018piRK9HPCuoLJbkGE69De5","name":"Bash","input":{"command":"cat > crates/pav_view/src/surgery/strains.rs <<'EOF'\n//! Hazards that stand up off the field: hooks and shards, polyps, parasites (SDF spheres and\n//! capsules with emissive parts), sacs on stems, embers, the furnace, tendrils, bone fragments.\n\nuse glam::{Vec2, Vec3};\nuse pav_core::games::surgery::field::{Hazard, Kind, sub};\nuse pav_core::games::surgery::frame::SurgeryFrame;\nuse pav_render::scene::{self as rs, Scene, SdfInstance, Style};\n\nuse super::plate::{PlateView, srgb3};\n\nfn col(c: [f32; 3]) -> Vec3 {\n    Vec3::from_array(c)\n}\n\nfn sdf(scene: &mut Scene, a: Vec3, b: Vec3, ra: f32, rb: f32, c: Vec3, e: f32, style: Style, group: u32) {\n    scene.sdfs.push(SdfInstance {\n        a,\n        b,\n        ra,\n        rb,\n        color: c,\n        emissive: e,\n        style,\n        flags: rs::flags::OBJECT | rs::flags::NO_CUT,\n        group,\n        material: 0,\n    });\n}\n\nfn at(p: Vec2, y: f32) -> Vec3 {\n    Vec3::new(p.x, y, p.y)\n}\n\n/// Follow-the-leader chain from `from` to `to`, with a creeping wave.\nfn chain(scene: &mut Scene, from: Vec3, to: Vec3, r0: f32, r1: f32, n: usize, wave: f32, t: f32, c: Vec3, group: u32) {\n    let mut last = from;\n    let d = to - from;\n    let perp = Vec3::new(-d.z, 0.0, d.x).normalize_or_zero();\n    for k in 1..=n {\n        let s = k as f32 / n as f32;\n        let wob = (s * 9.0 + t * 3.0).sin() * wave * (s * std::f32::consts::PI).sin();\n        let q = from + d * s + perp * wob + Vec3::Y * ((s * 6.0 + t * 2.0).cos() * wave * 0.25);\n        let r = r0 + (r1 - r0) * s;\n        sdf(scene, last, q, r + (r1 - r0) / n as f32, r, c, 0.0, Style::Cel, group);\n        last = q;\n    }\n}\n\npub fn emit(scene: &mut Scene, f: &SurgeryFrame, plate: &PlateView, t: f32) {\n    let steel = Vec3::new(0.78, 0.8, 0.82);\n    let parasite = col(srgb3(58, 26, 96));\n    let core = col(srgb3(36, 18, 66));\n    let eye = col(srgb3(255, 210, 70));\n    let sac_c = col(srgb3(120, 255, 170));\n    let hot = col(srgb3(255, 130, 40));\n    let frost = col(srgb3(190, 232, 255));\n    let bone = col(srgb3(236, 226, 196));\n    let beat = (-f.beat * 6.0).exp();\n    for h in &f.hazards {\n        let group = 0x2000 + h.id;\n        let ground = plate.height(h.a);\n        let disp = if h.kind != Kind::Tendril && !h.has_path() { h.c } else { Vec2::ZERO };\n        let p = h.a + disp;\n        let lift = h.prog * 0.5;\n        match h.kind {\n            Kind::Object => {\n                if !h.visible() {\n                    continue;\n                }\n                let dir = Vec2::from_angle(h.ang);\n                let base = at(p, ground + 0.05 + lift);\n                let tip = at(p + dir * 0.75, ground + 0.32 + lift);\n                match h.sub {\n                    sub::HOOK => {\n                        sdf(scene, base, tip, 0.05, 0.05, steel, 0.0, Style::Lit, group);\n                        let bend = at(p - dir * 0.28 + dir.perp() * 0.16, ground + 0.08 + lift);\n                        sdf(scene, base, bend, 0.05, 0.035, steel, 0.0, Style::Lit, group);\n                        let barb = at(p - dir * 0.02 + dir.perp() * 0.3, ground + 0.09 + lift);\n                        sdf(scene, bend, barb, 0.035, 0.015, steel, 0.0, Style::Lit, group);\n                        sdf(scene, tip, tip + Vec3::Y * 0.03, 0.09, 0.09, Vec3::new(0.35, 0.36, 0.4), 0.0, Style::Lit, group);\n                    }\n                    sub::SHARD => {\n                        let dark = Vec3::new(0.32, 0.33, 0.36);\n                        sdf(scene, base, tip, 0.15, 0.03, dark, 0.0, Style::Lit, group);\n                        sdf(scene, base + Vec3::new(0.08, 0.08, 0.0), tip, 0.1, 0.02, steel, 0.0, Style::Lit, group);\n                    }\n                    sub::SPLINTER => {\n                        let wood = Vec3::new(0.5, 0.3, 0.14);\n                        sdf(scene, base, tip, 0.07, 0.015, wood, 0.0, Style::Cel, group);\n                    }\n                    sub::COAL => {\n                        sdf(scene, base, tip, 0.13, 0.08, hot * 0.45, 0.3 + beat * 0.6, Style::Cel, group);\n                    }\n                    _ => {\n                        // The appendix: a stubby, inflamed thing.\n                        let fl = col(srgb3(214, 120, 104));\n                        sdf(scene, base, tip + Vec3::Y * 0.1, 0.24, 0.16, fl, 0.0, Style::Cel, group);\n                    }\n                }\n            }\n            Kind::Polyp => {\n                let y = ground + 0.02;\n                let stem = col(srgb3(210, 110, 110));\n                let dome = col(srgb3(240, 170, 130));\n                let r = h.r * (1.0 + beat * 0.04);\n                sdf(scene, at(p, y), at(p, y + 0.25), r * 0.55, r * 0.7, stem, 0.0, Style::Cel, group);\n                sdf(scene, at(p, y + 0.3), at(p, y + 0.3), r * 0.75, r * 0.75, dome, h.fill * 0.5, Style::Cel, group);\n            }\n            Kind::Tumor if h.stage == 1 => {\n                let dark = col(srgb3(96, 52, 88));\n                let y = ground + 0.1 + lift;\n                sdf(scene, at(p, y), at(p, y + 0.15), h.r * 0.7, h.r * 0.55, dark, 0.0, Style::Cel, group);\n            }\n            Kind::Bone => {\n                if h.stage == 0 {\n                    let dir = Vec2::from_angle(h.ang);\n                    let y = plate.height(p) + 0.32;\n                    let e = dir * h.r;\n                    sdf(scene, at(p - e, y), at(p + e, y), 0.34, 0.3, bone, 0.0, Style::Cel, group);\n                    let chip = at(p + e * 0.2 + dir.perp() * 0.18, y + 0.05);\n                    sdf(scene, chip, chip, 0.26, 0.26, bone * 0.92, 0.0, Style::Cel, group);\n                } else {\n                    let seat = h.c;\n                    let y = plate.height(seat) + 0.18;\n                    let e = Vec2::new(h.r, 0.0);\n                    sdf(scene, at(seat - e, y), at(seat + e, y), 0.32, 0.3, bone, 0.0, Style::Cel, group);\n                    let wire = Vec3::new(0.85, 0.75, 0.45);\n                    for k in 0..h.n {\n                        let x = h.a.x + (h.b.x - h.a.x) * (k as f32 + 0.5) / h.need.max(1) as f32;\n                        sdf(scene, at(Vec2::new(x, seat.y - 0.36), y + 0.14), at(Vec2::new(x, seat.y + 0.36), y + 0.14), 0.035, 0.035, wire, 0.0, Style::Lit, group);\n                    }\n                }\n            }\n            Kind::Bleeder => {\n                let spurt = (f.beat * std::f32::consts::TAU).cos().max(0.0);\n                let c = col(srgb3(180, 12, 24));\n                let y = ground + 0.05;\n                sdf(scene, at(p.lerp(h.b, 0.5), y), at(p.lerp(h.b, 0.5), y + 0.1 + spurt * 0.5), 0.13, 0.04, c, 0.0, Style::Cel, group);\n            }\n            Kind::Nodule => {\n                if !h.visible() {\n                    continue;\n                }\n                let r = h.r * if h.sub == sub::AMEN { 1.0 } else { 1.0 } * (1.0 + beat * 0.08);\n                let y = ground + r * 0.4 + lift;\n                if h.stage == 0 || h.stage == 2 {\n                    sdf(scene, at(p, y), at(p, y), r, r, parasite, 0.04, Style::Cel, group);\n                    for k in 0..5 {\n                        let a = k as f32 * 1.256 + t * 0.4;\n                        let q = p + Vec2::from_angle(a) * r * 0.85;\n                        sdf(scene, at(q, y + 0.15), at(q, y + 0.15), r * 0.22, r * 0.22, core, 0.0, Style::Cel, group);\n                    }\n                }\n                let eye_r = if h.stage == 1 { r * 0.55 } else { r * 0.26 };\n                sdf(scene, at(p, y + r * 0.72), at(p, y + r * 0.72), eye_r, eye_r, eye, 1.6, Style::Unlit, group + 1);\n                if h.stage == 1 {\n                    sdf(scene, at(p, y), at(p, y), r * 0.7, r * 0.7, core, 0.0, Style::Cel, group);\n                    let dir = Vec2::from_angle(h.ang);\n                    sdf(scene, at(p, y + 0.1), at(p + dir * 0.7, y + 0.35), 0.1, 0.05, parasite, 0.0, Style::Cel, group);\n                }\n            }\n            Kind::Sac => {\n                let y = ground + 0.1;\n                let root = at(h.b, plate.height(h.b) + 0.12);\n                let body = at(h.a, y + h.r * 0.7);\n                chain(scene, root, body, 0.1, 0.07, 8, 0.1, t, parasite, group);\n                let quiver = (t * 24.0).sin() * 0.03 * h.prog;\n                let r = h.r * (1.0 + quiver + beat * 0.03);\n                sdf(scene, body, body, r, r, sac_c * (0.3 + h.prog * 0.5), 0.5 + h.prog * 0.5, Style::Cel, group + 1);\n                let stem = h.a.lerp(h.b, 0.55);\n                if h.fill > 0.0 {\n                    sdf(scene, at(stem, y + 0.3), at(stem, y + 0.3), 0.14, 0.14, Vec3::new(1.0, 0.3, 0.1), 1.2 * h.fill, Style::Unlit, group + 2);\n                }\n            }\n            Kind::Eye => {\n                let open = h.prog > 0.5 || h.stage == 1;\n                let y = ground + 0.28;\n                let r = h.r;\n                for k in 0..6 {\n                    let a = k as f32 / 6.0 * std::f32::consts::TAU + t * 0.1;\n                    let q = p + Vec2::from_angle(a) * r * 1.05;\n                    sdf(scene, at(q, y), at(p + Vec2::from_angle(a + 0.5) * r * 1.05, y), 0.15, 0.15, parasite, 0.0, Style::Cel, group);\n                }\n                sdf(scene, at(p, y), at(p, y), r * 0.8, r * 0.8, core, 0.0, Style::Cel, group);\n                if open {\n                    let look = Vec2::new((t * 0.9).sin(), (t * 0.7).cos()) * 0.12;\n                    sdf(scene, at(p, y + 0.42), at(p, y + 0.42), r * 0.52, r * 0.52, eye, 1.6, Style::Unlit, group + 1);\n                    sdf(scene, at(p + look, y + 0.8), at(p + look, y + 0.8), r * 0.2, r * 0.2, core, 0.0, Style::Unlit, group + 2);\n                } else {\n                    sdf(scene, at(p - Vec2::X * 0.4, y + 0.55), at(p + Vec2::X * 0.4, y + 0.55), 0.06, 0.06, eye, 1.2, Style::Unlit, group + 1);\n                }\n            }\n            Kind::Ember => {\n                let y = ground + 0.25 + (t * 3.0 + h.id as f32).sin() * 0.03;\n                let r = h.r * (1.0 + beat * 0.1);\n                if h.stage == 0 {\n                    sdf(scene, at(p, y), at(p, y), r, r, hot * 0.5, 0.7 + beat * 0.6, Style::Cel, group);\n                    for k in 0..3 {\n                        let q = p + Vec2::from_angle(k as f32 * 2.1 + t) * r * 0.75;\n                        sdf(scene, at(q, y + 0.28), at(q, y + 0.28), r * 0.28, r * 0.28, Vec3::new(1.0, 0.82, 0.3), 1.8, Style::Unlit, group + 1);\n                    }\n                } else {\n                    sdf(scene, at(p, y), at(p, y), r, r, frost, 0.3, Style::Cel, group);\n                    for k in 0..4 {\n                        let d = Vec2::from_angle(k as f32 * 1.57 + 0.4);\n                        sdf(scene, at(p, y + r * 0.8), at(p + d * r * 0.9, y + r * 0.45), 0.035, 0.02, Vec3::new(0.2, 0.35, 0.5), 0.0, Style::Lit, group + 1);\n                    }\n                }\n            }\n            Kind::Furnace => {\n                let y = ground + 0.1;\n                let r = h.r;\n                let c = if h.stage == 1 { frost } else { hot * 0.55 };\n                let glow = if h.stage == 1 { 0.2 } else { 1.0 + beat };\n                sdf(scene, at(p, y), at(p, y + 0.3), r, r * 0.85, c, glow, Style::Cel, group);\n                for k in 0..6 {\n                    let a = k as f32 * 1.047 + t * 0.5;\n                    let q = p + Vec2::from_angle(a) * r * 1.2;\n                    sdf(scene, at(p, y + 0.2), at(q, y + 0.05), 0.12, 0.05, parasite, 0.0, Style::Cel, group + 1);\n                }\n                sdf(scene, at(p, y + r + 0.3), at(p, y + r + 0.3), r * 0.28, r * 0.28, eye, 1.6, Style::Unlit, group + 2);\n            }\n            Kind::Tendril => {\n                let pulled = h.prog;\n                let from = at(h.a, plate.height(h.a) + 0.22);\n                let to = at(h.a.lerp(h.b, 1.0 - pulled * 0.8), plate.height(h.b) + 0.3 + pulled * 1.1);\n                chain(scene, from, to, 0.28, 0.06, 16, 0.35, t, parasite, group);\n                sdf(scene, to, to, 0.2, 0.2, eye, 1.4, Style::Unlit, group + 1);\n            }\n            Kind::Incision | Kind::Closure | Kind::Lacer | Kind::Pool | Kind::Patch | Kind::Tumor => {}\n        }\n    }\n    // Sutures stay on as visible thread.\n    let thread = Vec3::new(0.14, 0.14, 0.34);\n    let mut draw_threads = |scene: &mut Scene, a: Vec2, b: Vec2, n: u16, group: u32| {\n        let dir = (b - a).normalize_or_zero().perp() * 0.2;\n        for k in 0..n {\n            let s = a.lerp(b, (k as f32 + 0.5) / n.max(1) as f32);\n            let y = plate.height(s) + 0.06;\n            sdf(scene, at(s - dir, y), at(s + dir, y), 0.022, 0.022, thread, 0.0, Style::Cel, group);\n        }\n    };\n    for (k, th) in f.threads.iter().enumerate() {\n        draw_threads(scene, th.a, th.b, th.n, 0x1800 + k as u32);\n    }\n    for h in &f.hazards {\n        if matches!(h.kind, Kind::Lacer | Kind::Bleeder) && h.n > 0 {\n            let e = h.a.lerp(h.b, h.prog.clamp(0.0, 1.0));\n            draw_threads(scene, h.a, e, h.n, 0x1800 + h.id);\n        }\n    }\n    // Things flying to the tray.\n    for fl in &f.flights {\n        let to = Vec2::new(0.0, 5.3);\n        let s = fl.t * fl.t * (3.0 - 2.0 * fl.t);\n        let q = fl.from.lerp(to, s);\n        let y = 0.8 + (fl.t * std::f32::consts::PI).sin() * 3.0;\n        let (c, e) = match fl.kind {\n            Kind::Sac => (sac_c * 0.5, 0.6),\n            Kind::Eye => (eye, 1.2),\n            Kind::Tendril => (parasite, 0.0),\n            _ => match fl.sub {\n                sub::COAL => (hot * 0.5, 0.8),\n                4 => (col(srgb3(150, 80, 80)), 0.0),\n                _ => (steel, 0.0),\n            },\n        };\n        sdf(scene, at(q, y), at(q, y + 0.15), 0.18, 0.12, c, e, Style::Cel, 0x1fff);\n    }\n}\nEOF\ncat > crates/pav_view/src/surgery/paper.rs <<'EOF'\n//! The paper theatre: layered, extruded spline cards that the engine lights, shadows and outlines.\n//! Each character is a rig of parts from a text file; sets are cards too, with parallax layers.\n\nuse std::collections::HashMap;\n\nuse glam::{Mat4, Vec2, Vec3};\nuse pav_core::games::surgery::content::{Content, Set};\nuse pav_core::games::surgery::frame::StoryView;\nuse pav_core::games::surgery::paper::{Outline, PartGeo, mouth_points, outline, pose_for, posed, rig_parts};\nuse pav_render::mesh::{MeshData, Vertex};\nuse pav_render::scene::{self as rs, DynamicMesh, ParticleBurst, PointLight, Scene, Style};\n\nconst LAYER: f32 = 0.035;\nconst DEPTH: f32 = 0.03;\n\n/// Extrudes an outline's points into a card: front face at `z`, walls back to `z - depth`.\nfn card(out: &mut MeshData, points: &[Vec2], tris: &[u32], z: f32, depth: f32, xf: &Mat4, color: [f32; 4]) {\n    let base = out.vertices.len() as u32;\n    let n = xf.transform_vector3(Vec3::Z).normalize_or_zero();\n    for q in points {\n        let p = xf.transform_point3(Vec3::new(q.x, q.y, z));\n        debug_assert!(p.is_finite());\n        out.vertices.push(Vertex { pos: p.to_array(), normal: n.to_array(), uv: [q.x, q.y], color });\n    }\n    out.indices.extend(tris.iter().map(|t| t + base));\n    if depth > 0.0 {\n        let m = points.len();\n        for i in 0..m {\n            let (a, b) = (points[i], points[(i + 1) % m]);\n            let e = b - a;\n            let wall = xf.transform_vector3(Vec3::new(e.y, -e.x, 0.0)).normalize_or_zero();\n            let v = out.vertices.len() as u32;\n            for (q, zz) in [(a, z), (b, z), (b, z - depth), (a, z - depth)] {\n                let p = xf.transform_point3(Vec3::new(q.x, q.y, zz));\n                out.vertices.push(Vertex { pos: p.to_array(), normal: wall.to_array(), uv: [0.0, 0.0], color });\n            }\n            out.indices.extend_from_slice(&[v, v + 2, v + 1, v, v + 3, v + 2]);\n        }\n    }\n}\n\n#[derive(Default)]\npub struct PaperView {\n    rigs: HashMap<String, Vec<PartGeo>>,\n    sets: HashMap<String, Vec<(f32, [f32; 3], f32, f32, Outline)>>,\n    rain_carry: f32,\n    group: u32,\n}\n\nfn linear(hex: &str) -> [f32; 3] {\n    rs::hex(hex).unwrap_or(Vec3::splat(0.5)).to_array()\n}\n\nimpl PaperView {\n    fn next_group(&mut self) -> u32 {\n        self.group += 1;\n        self.group\n    }\n\n    fn push(&mut self, scene: &mut Scene, data: MeshData, emissive: f32, flags: u32) {\n        let group = self.next_group();\n        scene.dynamic.push(DynamicMesh { data, color: Vec3::ONE, emissive, style: Style::Cel, flags, group, material: 0 });\n    }\n\n    fn set_cards(&mut self, s: &Set) {\n        if self.sets.contains_key(&s.id) {\n            return;\n        }\n        let mut list = Vec::new();\n        for card in &s.card {\n            let pts: Vec<Vec2> = match card.rect {\n                Some([x0, y0, x1, y1]) => vec![Vec2::new(x0, y0), Vec2::new(x1, y0), Vec2::new(x1, y1), Vec2::new(x0, y1)],\n                None => card.points.iter().map(|p| Vec2::new(p[0], p[1])).collect(),\n            };\n            if pts.len() >= 3 {\n                list.push((card.z, linear(&card.color), card.emissive, card.blink, outline(&pts, card.chaikin)));\n            }\n        }\n        self.sets.insert(s.id.clone(), list);\n    }\n\n    /// Draws the stage. `dt` for rain.\n    pub fn emit(&mut self, scene: &mut Scene, st: &StoryView, c: &Content, time: f32, dt: f32, clear: &mut Vec3, particles: bool) {\n        self.group = 0x4000;\n        let Some(set) = c.sets.get(&st.set) else { return };\n        self.set_cards(set);\n        *clear = rs::hex(&set.back).unwrap_or(Vec3::ZERO);\n        // The camera sways a touch: real parallax between the layers.\n        let parallax = Vec2::new((time * 0.31).sin() * 0.05, (time * 0.23).cos() * 0.02);\n        let cards = self.sets.get(&st.set).cloned().unwrap_or_default();\n        for (z, color, emissive, blink, o) in cards {\n            let mut data = MeshData::default();\n            let depthwise = 1.0 + z.abs() * 0.05;\n            let xf = Mat4::from_translation(Vec3::new(parallax.x * z.abs() * 0.3, parallax.y * z.abs() * 0.3, 0.0)) * Mat4::from_scale(Vec3::new(depthwise, depthwise, 1.0));\n            let dim = if blink > 0.0 { 0.65 + 0.35 * (time * 3.0 * blink).sin().abs() } else { 1.0 };\n            let col = [color[0] * dim, color[1] * dim, color[2] * dim, 1.0];\n            card(&mut data, &o.points, &o.tris, z, 0.05, &xf, col);\n            self.push(scene, data, emissive, rs::flags::NO_SHADOW);\n        }\n        // Lamp and rain.\n        let lamp = rs::hex(&set.lamp).unwrap_or(Vec3::ONE);\n        scene.point_lights.push(PointLight { position: Vec3::new(-2.0, 5.0, 5.0), color: lamp * 0.8, radius: 18.0, shadows: true });\n        if set.rain > 0.0 && particles {\n            self.rain_carry += dt * 45.0 * set.rain;\n            let count = self.rain_carry as u32;\n            self.rain_carry -= count as f32;\n            if count > 0 {\n                scene.particles.push(ParticleBurst {\n                    count,\n                    pos: Vec3::new(0.0, 6.5, -4.6),\n                    area: Vec3::new(11.0, 0.5, 0.4),\n                    vel: Vec3::new(-1.0, -12.0, 0.0),\n                    spread: 0.3,\n                    gravity: 3.0,\n                    life: (0.8, 1.1),\n                    size: (0.02, 0.015),\n                    color0: glam::Vec4::new(0.7, 0.85, 1.0, 0.5),\n                    color1: glam::Vec4::new(0.7, 0.85, 1.0, 0.0),\n                    additive: true,\n                    stretch: true,\n                    ..Default::default()\n                });\n            }\n        }\n        // The characters.\n        for (idx, actor) in st.actors.iter().enumerate() {\n            let Some(rig) = c.rigs.get(&actor.rig) else { continue };\n            if !self.rigs.contains_key(&actor.rig) {\n                self.rigs.insert(actor.rig.clone(), rig_parts(c, rig));\n            }\n            let parts = self.rigs.get(&actor.rig).cloned().unwrap_or_default();\n            let seed = idx as f32 * 2.3 + actor.rig.len() as f32;\n            let pose = pose_for(rig.expr.get(&actor.expr), time, seed, actor.talking);\n            // Slide in with an overshoot; a 3/4 stance turned toward the middle.\n            let k = (actor.age * 3.2).min(1.0);\n            let over = 1.0 - (1.0 - k).powi(3) + (k * std::f32::consts::PI).sin() * 0.08;\n            let from = if actor.x < 0.0 { -9.0 } else { 9.0 };\n            let x = from + (actor.x - from) * over;\n            let yaw = if actor.x.abs() < 0.3 { 0.0 } else { -actor.x.signum() * 0.22 } + (time * 0.5 + seed).sin() * 0.035;\n            let shake = Vec2::new((time * 40.0).sin(), (time * 33.0).cos()) * (st.shake * 0.05);\n            let scale = rig.scale.max(0.5) * 1.15;\n            let xf = Mat4::from_translation(Vec3::new(x + shake.x, -0.55 + shake.y, 0.0))\n                * Mat4::from_rotation_y(yaw)\n                * Mat4::from_scale(Vec3::splat(scale));\n            for part in &parts {\n                let moved: Vec<Vec2> = part.outline.points.iter().map(|q| posed(part, &pose, *q)).collect();\n                let mut data = MeshData::default();\n                let col = [\n                    rs::srgb_to_linear(part.color[0] as f32 / 255.0),\n                    rs::srgb_to_linear(part.color[1] as f32 / 255.0),\n                    rs::srgb_to_linear(part.color[2] as f32 / 255.0),\n                    1.0,\n                ];\n                card(&mut data, &moved, &part.outline.tris, part.z * LAYER, DEPTH, &xf, col);\n                self.push(scene, data, 0.0, 0);\n            }\n            // The mouth, by frame.\n            let expr = rig.expr.get(&actor.expr);\n            let shape = expr.map(|e| e.mouth.as_str()).unwrap_or(\"closed\");\n            let m = mouth_points(shape, actor.talking, pose.flap);\n            let o = outline(&m, 1);\n            let head_part = PartGeo { name: \"mouth\".into(), z: 3.6, color: [0; 3], layer: pav_core::games::surgery::paper::Layer::Head, side: 0.0, outline: Outline::default() };\n            let moved: Vec<Vec2> = o.points.iter().map(|q| posed(&head_part, &pose, *q)).collect();\n            let mut data = MeshData::default();\n            card(&mut data, &moved, &o.tris, 3.6 * LAYER, DEPTH, &xf, [0.18, 0.04, 0.06, 1.0]);\n            self.push(scene, data, 0.0, 0);\n        }\n    }\n}\n\n/// The paper stage's light and style (tested values).\npub fn stage_light(scene: &mut Scene) {\n    scene.ambient = rs::Ambient { sky: Vec3::new(0.74, 0.74, 0.78), ground: Vec3::new(0.6, 0.56, 0.56) };\n    scene.sun = rs::Sun {\n        direction: Vec3::new(0.3, -0.45, -0.85).normalize(),\n        color: Vec3::splat(0.34),\n        shadows: true,\n        shadow_center: Vec3::ZERO,\n        shadow_radius: 14.0,\n    };\n    scene.style.cel_bands = 3.0;\n    scene.style.rim = 0.05;\n    scene.post.outlines = true;\n    scene.post.outline_darken = 0.32;\n    scene.post.outline_px = 1.4;\n    scene.post.gi = 0.4;\n    scene.post.bloom = 0.3;\n    scene.post.bloom_threshold = 1.15;\n    scene.filter.vignette = 0.32;\n}\nEOF\ncat > crates/pav_view/src/surgery/mod.rs <<'EOF'\n//! Draws the surgery game: the operative field, instruments, strains, the paper theatre and their\n//! effects, all from one `SurgeryFrame`.\n\npub mod instruments;\npub mod paper;\npub mod plate;\npub mod strains;\n\nuse glam::{Mat4, Vec2, Vec3, Vec4};\nuse pav_core::SimEvent;\nuse pav_core::games::surgery::content::content;\nuse pav_core::games::surgery::cue;\nuse pav_core::games::surgery::field::{Kind, Tool, iv_port, tray_slot};\nuse pav_core::games::surgery::frame::{Stage, SurgeryFrame};\nuse pav_render::scene::{self as rs, DistortKind, Distortion, ParticleBurst, PointLight, Scene, SdfInstance, Style, Transition};\n\nuse self::instruments::Motion;\n\n/// Player settings the picture follows.\n#[derive(Clone, Copy, Debug, Default)]\npub struct Looks {\n    pub clinical: bool,\n    pub reduce_flashes: bool,\n    /// Screen shake on (the setting).\n    pub no_shake: bool,\n    /// Skip drawing altogether: a hub server.\n    pub headless: bool,\n}\n\n#[derive(Default)]\npub struct SurgeryView {\n    pub plate: plate::PlateView,\n    pub paper: paper::PaperView,\n    pub looks: Looks,\n    /// The local player's cursor this render frame: drawn with zero lag.\n    pub local_cursor: Option<(usize, Vec2)>,\n    pending: Vec<ParticleBurst>,\n    rain_carry: f32,\n    fx_carry: f32,\n    last_stage: Option<Stage>,\n    stage_change: f32,\n    defib_shock: f32,\n    last_time: f32,\n}\n\npub const SEAT_COLORS: [[u8; 3]; 4] = [[0xe8, 0x44, 0x3a], [0x3b, 0x82, 0xf6], [0x22, 0xc5, 0x5e], [0xf5, 0xb7, 0x00]];\n\nfn seat(i: usize) -> Vec3 {\n    let c = SEAT_COLORS[i % 4];\n    rs::srgb(c[0], c[1], c[2])\n}\n\nimpl SurgeryView {\n    /// Particles for cues: blood, smoke, sparks, gel, frost.\n    pub fn add_events(&mut self, events: &[SimEvent]) {\n        for e in events {\n            let SimEvent::Cue { id, pos, gain, .. } = e else { continue };\n            let b = ParticleBurst::default();\n            let pos = *pos;\n            let (count, burst) = match *id {\n                cue::SLICE | cue::TEAR | cue::SQUISH => (\n                    10,\n                    ParticleBurst {\n                        vel: Vec3::new(0.0, 2.4, 0.0),\n                        spread: 1.3,\n                        gravity: 9.0,\n                        life: (0.25, 0.55),\n                        size: (0.05, 0.02),\n                        color0: Vec4::new(0.45, 0.02, 0.04, 1.0),\n                        color1: Vec4::new(0.3, 0.01, 0.02, 0.9),\n                        additive: false,\n                        floor: Some(0.3),\n                        ..b\n                    },\n                ),\n                cue::BURST => (\n                    46,\n                    ParticleBurst {\n                        vel: Vec3::new(0.0, 3.4, 0.0),\n                        spread: 3.0,\n                        gravity: 9.0,\n                        life: (0.4, 0.9),\n                        size: (0.09, 0.03),\n                        color0: Vec4::new(0.4, 0.75, 0.2, 1.0),\n                        color1: Vec4::new(0.2, 0.4, 0.1, 0.8),\n                        additive: false,\n                        floor: Some(0.3),\n                        ..b\n                    },\n                ),\n                cue::SIZZLE | cue::LASER => (\n                    6,\n                    ParticleBurst {\n                        vel: Vec3::new(0.0, 1.5, 0.0),\n                        spread: 0.5,\n                        gravity: -0.5,\n                        drag: 1.2,\n                        life: (0.6, 1.2),\n                        size: (0.08, 0.35),\n                        color0: Vec4::new(0.55, 0.55, 0.58, 0.5),\n                        color1: Vec4::new(0.7, 0.7, 0.75, 0.0),\n                        additive: false,\n                        turbulence: 1.2,\n                        ..b\n                    },\n                ),\n                cue::GEL => (\n                    8,\n                    ParticleBurst {\n                        vel: Vec3::new(0.0, 1.4, 0.0),\n                        spread: 0.8,\n                        gravity: 8.0,\n                        life: (0.2, 0.45),\n                        size: (0.06, 0.03),\n                        color0: Vec4::new(0.55, 0.95, 0.8, 1.0),\n                        color1: Vec4::new(0.55, 0.95, 0.8, 0.6),\n                        additive: false,\n                        floor: Some(0.3),\n                        ..b\n                    },\n                ),\n                cue::FROST | cue::CRACK => (\n                    12,\n                    ParticleBurst {\n                        vel: Vec3::new(0.0, 0.9, 0.0),\n                        spread: 1.2,\n                        gravity: 1.0,\n                        drag: 1.0,\n                        life: (0.5, 1.1),\n                        size: (0.06, 0.01),\n                        color0: Vec4::new(1.4, 1.9, 2.4, 0.9),\n                        color1: Vec4::new(0.8, 1.2, 1.8, 0.0),\n                        additive: true,\n                        ..b\n                    },\n                ),\n                cue::RATE_IMMACULATE | cue::ON_BEAT | cue::CHAIN_UP => (\n                    14,\n                    ParticleBurst {\n                        vel: Vec3::new(0.0, 2.2, 0.0),\n                        spread: 2.0,\n                        gravity: 3.0,\n                        drag: 1.0,\n                        life: (0.35, 0.7),\n                        size: (0.05, 0.01),\n                        color0: Vec4::new(3.0, 2.5, 1.2, 1.0),\n                        color1: Vec4::new(1.2, 0.8, 0.3, 0.0),\n                        additive: true,\n                        stretch: true,\n                        ..b\n                    },\n                ),\n                cue::DEFIB_THUMP => {\n                    self.defib_shock = 1.0;\n                    (\n                        70,\n                        ParticleBurst {\n                            vel: Vec3::new(0.0, 4.0, 0.0),\n                            spread: 6.0,\n                            gravity: 8.0,\n                            drag: 0.6,\n                            life: (0.2, 0.6),\n                            size: (0.05, 0.01),\n                            color0: Vec4::new(2.5, 3.0, 4.0, 1.0),\n                            color1: Vec4::new(1.0, 1.4, 2.5, 0.0),\n                            additive: true,\n                            stretch: true,\n                            area: Vec3::new(3.0, 0.1, 2.0),\n                            ..b\n                        },\n                    )\n                }\n                _ => continue,\n            };\n            let mut p = burst;\n            p.count = (count as f32 * gain.clamp(0.3, 1.5)) as u32;\n            p.pos = pos;\n            self.pending.push(p);\n        }\n    }\n\n    /// Adds the game's frame to the scene: called last in `ViewBuilder::build`.\n    pub fn emit(&mut self, scene: &mut Scene, f: &SurgeryFrame, time: f32, dt: f32, particles: bool) {\n        if self.looks.headless {\n            return;\n        }\n        let c = content();\n        if self.last_stage != Some(f.stage) {\n            self.last_stage = Some(f.stage);\n            self.stage_change = 0.0;\n        }\n        self.stage_change += dt;\n        self.last_time = time;\n        // A wall-clock for idle animation even when the sim pauses in a menu.\n        scene.particles.append(&mut self.pending);\n\n        if let (Stage::Story, Some(st)) = (f.stage, &f.story) {\n            if st.camera == 0 {\n                let mut clear = Vec3::ZERO;\n                paper::stage_light(scene);\n                self.paper.emit(scene, st, &c, time, dt, &mut clear, particles);\n                scene.clear_color = clear;\n                scene.filter.transition = (1.0 - self.stage_change / 0.45).clamp(0.0, 1.0);\n                scene.filter.transition_kind = Transition::Fade;\n                if st.flash > 0.0 && !self.looks.reduce_flashes {\n                    scene.filter.brightness = 1.0 + st.flash * 1.5;\n                }\n            } else {\n                // The 3D wide shot: engine puppets in scrubs round a table of blocks.\n                scene.clear_color = rs::srgb(12, 22, 26);\n                scene.sun.direction = Vec3::new(-0.3, -1.0, -0.2).normalize();\n                scene.sun.color = Vec3::new(0.9, 0.95, 1.0) * 0.5;\n                scene.point_lights.push(PointLight { position: Vec3::new(97.5, 3.2, -3.0), color: Vec3::new(1.0, 0.97, 0.9) * 3.0, radius: 12.0, shadows: true });\n                scene.ambient = rs::Ambient { sky: Vec3::new(0.4, 0.5, 0.55), ground: Vec3::new(0.2, 0.2, 0.22) };\n                scene.style.cel_bands = 3.0;\n                scene.filter.vignette = 0.4;\n            }\n            return;\n        }\n        self.emit_field(scene, f, &c, time, dt, particles);\n    }\n\n    fn emit_field(&mut self, scene: &mut Scene, f: &SurgeryFrame, c: &pav_core::games::surgery::content::Content, time: f32, dt: f32, particles: bool) {\n        let paint = plate::Paint { palette_clinical: self.looks.clinical, time };\n        self.plate.emit(scene, f, c, &paint);\n        strains::emit(scene, f, &self.plate, time);\n\n        // The drape's frame of steel retractors.\n        let steel = Vec3::new(0.56, 0.6, 0.63);\n        for (x, z) in [(-9.6, -3.2), (-9.6, 3.0), (9.6, -3.2), (9.6, 3.0)] {\n            let inward = if x < 0.0 { 1.0 } else { -1.0 };\n            let (a, b) = (Vec3::new(x + inward * 2.2, 0.45, z), Vec3::new(x - inward * 1.2, 1.1, z));\n            scene.sdfs.push(SdfInstance { a, b, ra: 0.11, rb: 0.14, color: steel, emissive: 0.0, style: Style::Lit, flags: rs::flags::OBJECT | rs::flags::NO_CUT, group: 0x801, material: 0 });\n        }\n        for (x, z) in [(-3.6f32, -5.1f32), (3.6, -5.1)] {\n            let (a, b) = (Vec3::new(x, 0.45, z + 1.2), Vec3::new(x, 1.1, z - 1.0));\n            scene.sdfs.push(SdfInstance { a, b, ra: 0.11, rb: 0.14, color: steel, emissive: 0.0, style: Style::Lit, flags: rs::flags::OBJECT | rs::flags::NO_CUT, group: 0x802, material: 0 });\n        }\n\n        let in_op = matches!(f.stage, Stage::Op | Stage::Complete | Stage::Dead | Stage::Chart | Stage::Results);\n        if in_op && !f.slots.is_empty() {\n            // The IV port and the tray.\n            let port = iv_port();\n            scene.sdfs.push(SdfInstance { a: Vec3::new(port.x, 0.95, port.y), b: Vec3::new(port.x - 0.1, 0.9, port.y + 0.8), ra: 0.2, rb: 0.08, color: Vec3::new(0.82, 0.88, 0.96), emissive: 0.0, style: Style::Lit, flags: rs::flags::OBJECT, group: 0x803, material: 0 });\n            let ring: [Tool; 8] = std::array::from_fn(|k| f.ring_tool(k));\n            let slots: [Vec2; 8] = std::array::from_fn(tray_slot);\n            let local = self.local_cursor.map(|(i, _)| i).unwrap_or(0);\n            let selected = f.slots.get(local).map(|s| s.ring_pos).unwrap_or(0);\n            instruments::emit_tray(scene, &ring, selected, time, &slots, self.looks.clinical);\n            if f.stage == Stage::Op {\n                self.emit_hands(scene, f, time);\n            }\n        }\n\n        // Light, tested values: lamp, sun, cel, ink, bloom, GI.\n        scene.sun = rs::Sun {\n            direction: Vec3::new(-0.25, -1.0, -0.35).normalize(),\n            color: Vec3::new(1.0, 0.98, 0.92) * 0.42,\n            shadows: true,\n            shadow_center: Vec3::ZERO,\n            shadow_radius: 16.0,\n        };\n        scene.ambient = rs::Ambient { sky: Vec3::new(0.50, 0.50, 0.54), ground: Vec3::new(0.30, 0.22, 0.22) };\n        scene.point_lights.push(PointLight { position: Vec3::new(-1.0, 7.0, -1.0), color: Vec3::new(1.0, 0.97, 0.9) * 0.9, radius: 16.0, shadows: true });\n        scene.clear_color = rs::srgb(16, 40, 44);\n        scene.style.cel_bands = 3.0;\n        scene.style.rim = 0.12;\n        scene.post.outlines = true;\n        scene.post.outline_darken = 0.45;\n        scene.post.bloom = 0.35;\n        scene.post.bloom_threshold = 1.15;\n        scene.post.gi = 0.6;\n        scene.post.distortion = true;\n        scene.filter.vignette = 0.35;\n\n        // Lights the parasites and embers throw.\n        let mut lights = 0;\n        for h in &f.hazards {\n            if lights >= 5 {\n                break;\n            }\n            let glow = match h.kind {\n                Kind::Ember if h.stage == 0 => Some(Vec3::new(1.0, 0.45, 0.15)),\n                Kind::Furnace => Some(Vec3::new(1.0, 0.45, 0.15) * 1.5),\n                Kind::Sac => Some(Vec3::new(0.3, 1.0, 0.5) * (0.2 + h.prog * 0.5)),\n                Kind::Eye if h.prog > 0.5 => Some(Vec3::new(1.0, 0.8, 0.3)),\n                _ => None,\n            };\n            if let Some(col) = glow {\n                lights += 1;\n                scene.point_lights.push(PointLight { position: Vec3::new(h.a.x, 1.3, h.a.y), color: col * 0.8, radius: 4.0, shadows: false });\n            }\n            // Haze over hot tissue.\n            if matches!(h.kind, Kind::Ember | Kind::Furnace) && h.stage != 1 {\n                scene.distortions.push(Distortion { pos: Vec3::new(h.a.x, 0.9, h.a.y), radius: 1.5, strength: 0.05, kind: DistortKind::Haze, progress: time.fract() });\n            }\n        }\n\n        self.rain_carry += dt * 40.0;\n        if particles {\n            self.fx(scene, f, dt);\n        }\n\n        // Filters: the Hush desaturates; crisis adds chroma and vignette on the beat.\n        let beat = (-f.beat * 5.0).exp();\n        if f.hush > 0.0 || f.time_scale < 0.99 {\n            let k = (1.0f32).min(f.hush.max(0.4));\n            scene.filter.saturation = 1.0 - 0.9 * k;\n            scene.filter.grade_part = rs::Part::Objects;\n            scene.filter.vignette = 0.55;\n        }\n        if f.crisis > 0.0 {\n            scene.filter.chroma = f.crisis * 0.0035 * (0.5 + beat);\n            scene.filter.vignette += f.crisis * 0.25 * (0.5 + beat * 0.5);\n        }\n        if f.ripple > 0.0 {\n            scene.distortions.push(Distortion { pos: Vec3::new(0.0, 0.5, 0.0), radius: 14.0, strength: 0.12, kind: DistortKind::Ripple, progress: 1.0 - f.ripple });\n        }\n        self.defib_shock = (self.defib_shock - dt * 1.6).max(0.0);\n        if self.defib_shock > 0.0 {\n            scene.distortions.push(Distortion { pos: Vec3::new(0.0, 0.5, 0.0), radius: 16.0, strength: 0.3, kind: DistortKind::Ring, progress: 1.0 - self.defib_shock });\n        }\n        if f.flash > 0.0 && !self.looks.reduce_flashes {\n            scene.filter.brightness = 1.0 + f.flash * 0.6;\n        }\n        // Shake: a moment's knock of the view.\n        if f.shake > 0.0 && !self.looks.no_shake {\n            let s = f.shake * f.shake * 0.12;\n            let off = Vec3::new((time * 47.0).sin(), (time * 37.0).cos(), 0.0) * s;\n            scene.camera.view = Mat4::from_translation(off) * scene.camera.view;\n        }\n        // Transitions: an iris onto the incision when a plate is revealed; a fade between stages;\n        // black under a death.\n        if f.reveal < 1.0 {\n            let k = 1.0 - f.reveal;\n            scene.filter.transition = (k * 0.8).min(0.55);\n            scene.filter.transition_kind = Transition::Iris;\n            scene.filter.transition_center = crate::build::screen_uv(&scene.camera, Vec3::new(f.reveal_at.x, 0.5, f.reveal_at.y));\n        } else if f.stage == Stage::Dead {\n            scene.filter.transition = (self.stage_change * 2.0).clamp(0.0, 1.0);\n            scene.filter.transition_kind = Transition::Fade;\n        } else if self.stage_change < 0.45 && matches!(f.stage, Stage::Op | Stage::Chart | Stage::Results) {\n            scene.filter.transition = 1.0 - self.stage_change / 0.45;\n            scene.filter.transition_kind = Transition::Fade;\n        }\n    }\n\n    fn emit_hands(&mut self, scene: &mut Scene, f: &SurgeryFrame, time: f32) {\n        for (i, s) in f.slots.iter().enumerate() {\n            if !s.active {\n                continue;\n            }\n            let mut p = s.cursor;\n            if let Some((who, at)) = self.local_cursor {\n                if who == i {\n                    p = at;\n                }\n            }\n            let tool = Tool::from_u8(s.tool);\n            // IV sits at its port while it pushes.\n            let tip2 = if tool == Tool::Iv && s.using { iv_port() } else { p };\n            let ground = self.plate.height(tip2);\n            let press = if s.using { 0.02 } else { 0.28 };\n            let tip = Vec3::new(tip2.x, ground + press + s.recoil * 0.25, tip2.y);\n            let m = Motion { using: s.using, pressure: s.pressure, time, meter: if tool == Tool::Defib { s.charge } else { s.meter }, recoil: s.recoil };\n            let mut axis = instruments::hand_axis();\n            if tool == Tool::Defib {\n                axis = Vec3::new(0.0, 1.0, 0.25);\n            }\n            // The Scalpel leans into the stroke; a clink knocks the hand.\n            axis += Vec3::new((time * 42.0).sin() * s.clink * 0.05, 0.0, 0.0);\n            instruments::emit(scene, tool, tip, axis, m, 1.05, 0x700 + i as u32 * 8, 0.0);\n            // Reticle in the seat's colour.\n            let col = seat(i);\n            let g = ground + 0.05;\n            for k in 0..4 {\n                let a = k as f32 * std::f32::consts::FRAC_PI_2 + 0.78;\n                let d = Vec2::from_angle(a) * if s.hover != 0 { 0.28 } else { 0.4 };\n                let q = Vec3::new(p.x + d.x, g, p.y + d.y);\n                scene.sdfs.push(SdfInstance { a: q, b: q, ra: 0.05, rb: 0.05, color: col, emissive: 1.1, style: Style::Unlit, flags: rs::flags::OBJECT | rs::flags::NO_SHADOW | rs::flags::NO_CUT, group: 0x7f0, material: 0 });\n            }\n        }\n        // The Echo's luminous ghost of her younger hands.\n        if f.echo > 0.0 {\n            let g = f.ghost;\n            let ground = self.plate.height(g);\n            let tool = f.slots.first().map(|s| Tool::from_u8(s.tool)).unwrap_or(Tool::Forceps);\n            let tip = Vec3::new(g.x, ground + 0.12 + f.ghost_t * 0.2, g.y);\n            let m = Motion { using: f.ghost_t > 0.0, time, ..Default::default() };\n            let start = scene.sdfs.len();\n            instruments::emit(scene, tool, tip, Vec3::new(-0.4, 1.0, 0.5), m, 1.05, 0x7e0, 0.0);\n            for sd in &mut scene.sdfs[start..] {\n                sd.color = Vec3::new(0.5, 0.9, 1.0);\n                sd.emissive = 1.4;\n                sd.style = Style::Unlit;\n                sd.flags |= rs::flags::NO_SHADOW;\n            }\n        }\n    }\n\n    fn fx(&mut self, scene: &mut Scene, f: &SurgeryFrame, dt: f32) {\n        self.fx_carry += dt;\n        let tick = self.fx_carry >= 0.08;\n        if !tick {\n            return;\n        }\n        self.fx_carry = 0.0;\n        let b = ParticleBurst::default();\n        for h in &f.hazards {\n            match h.kind {\n                Kind::Bleeder if f.beat < 0.2 && !f.stopped => {\n                    scene.particles.push(ParticleBurst {\n                        count: 5,\n                        pos: Vec3::new((h.a.x + h.b.x) * 0.5, 0.6, (h.a.y + h.b.y) * 0.5),\n                        vel: Vec3::new(0.3, 3.8, 0.2),\n                        spread: 0.8,\n                        gravity: 10.0,\n                        life: (0.3, 0.6),\n                        size: (0.07, 0.03),\n                        color0: Vec4::new(0.5, 0.02, 0.04, 1.0),\n                        color1: Vec4::new(0.3, 0.01, 0.02, 0.9),\n                        additive: false,\n                        floor: Some(0.3),\n                        ..b\n                    });\n                }\n                Kind::Ember | Kind::Furnace if h.stage != 1 => {\n                    scene.particles.push(ParticleBurst {\n                        count: 2,\n                        pos: Vec3::new(h.a.x, 0.7, h.a.y),\n                        area: Vec3::new(0.4, 0.1, 0.4),\n                        vel: Vec3::new(0.0, 1.3, 0.0),\n                        spread: 0.4,\n                        gravity: -0.2,\n                        life: (0.7, 1.3),\n                        size: (0.05, 0.01),\n                        color0: Vec4::new(4.0, 1.8, 0.4, 1.0),\n                        color1: Vec4::new(1.5, 0.3, 0.1, 0.0),\n                        additive: true,\n                        turbulence: 1.0,\n                        ..b\n                    });\n                }\n                _ => {}\n            }\n        }\n        if f.hush > 0.0 {\n            scene.particles.push(ParticleBurst {\n                count: 6,\n                pos: Vec3::new(0.0, 3.0, 0.0),\n                area: Vec3::new(9.0, 2.0, 4.5),\n                vel: Vec3::ZERO,\n                spread: 0.1,\n                life: (1.8, 3.0),\n                size: (0.035, 0.015),\n                color0: Vec4::new(1.5, 1.5, 1.6, 0.0),\n                color1: Vec4::new(1.0, 1.0, 1.2, 0.8),\n                additive: true,\n                turbulence: 0.3,\n                ..b\n            });\n        }\n        if f.echo > 0.0 {\n            scene.particles.push(ParticleBurst {\n                count: 4,\n                pos: Vec3::new(f.ghost.x, 1.4, f.ghost.y),\n                area: Vec3::new(0.3, 0.8, 0.3),\n                spread: 0.3,\n                life: (0.4, 0.8),\n                size: (0.05, 0.01),\n                color0: Vec4::new(0.7, 1.6, 2.2, 0.9),\n                color1: Vec4::new(0.3, 0.8, 1.4, 0.0),\n                additive: true,\n                ..b\n            });\n        }\n        // Rain beyond the window on the title and menu.\n        if f.stage == Stage::Title || f.stage == Stage::Card {\n            scene.particles.push(ParticleBurst {\n                count: 18,\n                pos: Vec3::new(0.0, 12.0, -1.0),\n                area: Vec3::new(14.0, 0.5, 8.0),\n                vel: Vec3::new(-1.0, -18.0, 0.0),\n                spread: 0.3,\n                gravity: 3.0,\n                life: (0.4, 0.7),\n                size: (0.025, 0.02),\n                color0: Vec4::new(0.8, 0.95, 1.2, 0.5),\n                color1: Vec4::new(0.7, 0.85, 1.0, 0.0),\n                additive: true,\n                stretch: true,\n                ..b\n            });\n        }\n    }\n}\nEOF\npython3 - <<'EOF'\np='crates/pav_view/src/lib.rs'; s=open(p).read()\ns=s.replace(\"pub mod materials;\\n\",\"pub mod materials;\\npub mod surgery;\\n\")\nopen(p,'w').write(s)\np='crates/pav_view/src/build.rs'; s=open(p).read()\ns=s.replace('''    /// Procedural materials in this view: stable rows, attached''','''    /// The surgery game's field, instruments and paper theatre.\n    pub surgery: crate::surgery::SurgeryView,\n    /// Procedural materials in this view: stable rows, attached''')\ns=s.replace('''        self.emit_effects(&mut scene);\n        scenery.sort_unstable();\n        mark_objects(&mut scene, env_end, &scenery);''','''        self.emit_effects(&mut scene);\n        scenery.sort_unstable();\n        mark_objects(&mut scene, env_end, &scenery);\n        if let Some(sf) = &curr.surgery {\n            self.surgery.emit(&mut scene, sf, time, dt, settings.particles);\n        }''')\ns=s.replace('''    pub fn add_events(&mut self, events: &[SimEvent]) {\n        for e in events {\n            crate::fx::event_bursts(e, &mut self.pending_particles);''','''    pub fn add_events(&mut self, events: &[SimEvent]) {\n        self.surgery.add_events(events);\n        for e in events {\n            crate::fx::event_bursts(e, &mut self.pending_particles);''')\nopen(p,'w').write(s)\np='crates/pav_tools/src/session.rs'; s=open(p).read()\ns=s.replace('''    pub fn step(&mut self, ticks: u64) {\n        for _ in 0..ticks {''','''    /// The game's camera shot, when it has one (the surgery game).\n    fn apply_game_camera(&mut self, frame: &RenderFrame) {\n        if let Some(sf) = &frame.surgery {\n            let s = sf.camera;\n            self.camera.params.tilt = s.tilt;\n            self.camera.params.yaw = s.yaw;\n            self.camera.params.distance = s.distance;\n            self.camera.params.fov = s.fov;\n            self.camera.params.follow_lag = 0.0;\n            self.camera.params.height_offset = 0.0;\n            self.sim.state.focus = Vec3::from_array(s.target);\n        }\n    }\n\n    pub fn step(&mut self, ticks: u64) {\n        for _ in 0..ticks {''')\ns=s.replace('''    pub fn render(&mut self, width: u32, height: u32) -> Result<Vec<u8>> {\n        let frame = self.sim.frame();\n        let focus = frame.focus;''','''    pub fn render(&mut self, width: u32, height: u32) -> Result<Vec<u8>> {\n        let frame = self.sim.frame();\n        self.apply_game_camera(&frame);\n        let frame = self.sim.frame();\n        let focus = frame.focus;''')\ns=s.replace('''    ) -> Result<(Vec<u8>, Option<pav_ui::headless::Drawn>)> {\n        let frame = self.sim.frame();\n        let focus = frame.focus;''','''    ) -> Result<(Vec<u8>, Option<pav_ui::headless::Drawn>)> {\n        let frame = self.sim.frame();\n        self.apply_game_camera(&frame);\n        let frame = self.sim.frame();\n        let focus = frame.focus;''')\ns=s.replace('''        let scene = gpu.builder.build(&frame, &frame, 1.0, &camera, width as f32 / height as f32, &view, focus);\n        let vp = scene.camera.proj * scene.camera.view;\n        let drawn = has_ui(&frame).then(|| self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input));''','''        let scene = gpu.builder.build(&frame, &frame, 1.0, &camera, width as f32 / height as f32, &view, focus);\n        let vp = scene.camera.proj * scene.camera.view;\n        let drawn = has_ui(&frame).then(|| {\n            let surgery = frame.surgery.clone();\n            self.ui.frame_all(frame.game.as_deref(), surgery.as_deref(), &frame.hud, vp, width, height, input)\n        });''')\ns=s.replace('''        Some(self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input))''','''        let surgery = frame.surgery.clone();\n        Some(self.ui.frame_all(frame.game.as_deref(), surgery.as_deref(), &frame.hud, vp, width, height, input))''')\ns=s.replace('''    frame.game.is_some() || !frame.hud.lines.is_empty()''','''    frame.game.is_some() || frame.surgery.is_some() || !frame.hud.lines.is_empty()''')\ns=s.replace('''        self.camera.snap(frame.focus);\n        let vp = self.camera.view_proj(width as f32 / height.max(1) as f32);''','''        self.apply_game_camera(&frame);\n        self.camera.snap(self.sim.state.focus);\n        let vp = self.camera.view_proj(width as f32 / height.max(1) as f32);''')\nopen(p,'w').write(s)\nEOF\nsed -n 140,170p crates/pav_ui/src/headless.rs; sed -n 170,202p crates/pav_ui/src/headless.rs; ../tools/cb.sh check --locked -p pav_view 2>&1 | head -60","description":"Write strains, paper and field view; wire into builder","timeout":400000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":18470,"cache_read_input_tokens":422178,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18470},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"fe11091a-d9b1-4871-8a68-52c716564829","timestamp":"2026-11-05T15:00:43.464Z","request_id":"req_011CgjygNuFEDN7s83maL9dj","wire_tool_inputs":{"toolu_018piRK9HPCuoLJbkGE69De5":{"command":"cat > crates/pav_view/src/surgery/strains.rs <<'EOF'\n//! Hazards that stand up off the field: hooks and shards, polyps, parasites (SDF spheres and\n//! capsules with emissive parts), sacs on stems, embers, the furnace, tendrils, bone fragments.\n\nuse glam::{Vec2, Vec3};\nuse pav_core::games::surgery::field::{Hazard, Kind, sub};\nuse pav_core::games::surgery::frame::SurgeryFrame;\nuse pav_render::scene::{self as rs, Scene, SdfInstance, Style};\n\nuse super::plate::{PlateView, srgb3};\n\nfn col(c: [f32; 3]) -> Vec3 {\n    Vec3::from_array(c)\n}\n\nfn sdf(scene: &mut Scene, a: Vec3, b: Vec3, ra: f32, rb: f32, c: Vec3, e: f32, style: Style, group: u32) {\n    scene.sdfs.push(SdfInstance {\n        a,\n        b,\n        ra,\n        rb,\n        color: c,\n        emissive: e,\n        style,\n        flags: rs::flags::OBJECT | rs::flags::NO_CUT,\n        group,\n        material: 0,\n    });\n}\n\nfn at(p: Vec2, y: f32) -> Vec3 {\n    Vec3::new(p.x, y, p.y)\n}\n\n/// Follow-the-leader chain from `from` to `to`, with a creeping wave.\nfn chain(scene: &mut Scene, from: Vec3, to: Vec3, r0: f32, r1: f32, n: usize, wave: f32, t: f32, c: Vec3, group: u32) {\n    let mut last = from;\n    let d = to - from;\n    let perp = Vec3::new(-d.z, 0.0, d.x).normalize_or_zero();\n    for k in 1..=n {\n        let s = k as f32 / n as f32;\n        let wob = (s * 9.0 + t * 3.0).sin() * wave * (s * std::f32::consts::PI).sin();\n        let q = from + d * s + perp * wob + Vec3::Y * ((s * 6.0 + t * 2.0).cos() * wave * 0.25);\n        let r = r0 + (r1 - r0) * s;\n        sdf(scene, last, q, r + (r1 - r0) / n as f32, r, c, 0.0, Style::Cel, group);\n        last = q;\n    }\n}\n\npub fn emit(scene: &mut Scene, f: &SurgeryFrame, plate: &PlateView, t: f32) {\n    let steel = Vec3::new(0.78, 0.8, 0.82);\n    let parasite = col(srgb3(58, 26, 96));\n    let core = col(srgb3(36, 18, 66));\n    let eye = col(srgb3(255, 210, 70));\n    let sac_c = col(srgb3(120, 255, 170));\n    let hot = col(srgb3(255, 130, 40));\n    let frost = col(srgb3(190, 232, 255));\n    let bone = col(srgb3(236, 226, 196));\n    let beat = (-f.beat * 6.0).exp();\n    for h in &f.hazards {\n        let group = 0x2000 + h.id;\n        let ground = plate.height(h.a);\n        let disp = if h.kind != Kind::Tendril && !h.has_path() { h.c } else { Vec2::ZERO };\n        let p = h.a + disp;\n        let lift = h.prog * 0.5;\n        match h.kind {\n            Kind::Object => {\n                if !h.visible() {\n                    continue;\n                }\n                let dir = Vec2::from_angle(h.ang);\n                let base = at(p, ground + 0.05 + lift);\n                let tip = at(p + dir * 0.75, ground + 0.32 + lift);\n                match h.sub {\n                    sub::HOOK => {\n                        sdf(scene, base, tip, 0.05, 0.05, steel, 0.0, Style::Lit, group);\n                        let bend = at(p - dir * 0.28 + dir.perp() * 0.16, ground + 0.08 + lift);\n                        sdf(scene, base, bend, 0.05, 0.035, steel, 0.0, Style::Lit, group);\n                        let barb = at(p - dir * 0.02 + dir.perp() * 0.3, ground + 0.09 + lift);\n                        sdf(scene, bend, barb, 0.035, 0.015, steel, 0.0, Style::Lit, group);\n                        sdf(scene, tip, tip + Vec3::Y * 0.03, 0.09, 0.09, Vec3::new(0.35, 0.36, 0.4), 0.0, Style::Lit, group);\n                    }\n                    sub::SHARD => {\n                        let dark = Vec3::new(0.32, 0.33, 0.36);\n                        sdf(scene, base, tip, 0.15, 0.03, dark, 0.0, Style::Lit, group);\n                        sdf(scene, base + Vec3::new(0.08, 0.08, 0.0), tip, 0.1, 0.02, steel, 0.0, Style::Lit, group);\n                    }\n                    sub::SPLINTER => {\n                        let wood = Vec3::new(0.5, 0.3, 0.14);\n                        sdf(scene, base, tip, 0.07, 0.015, wood, 0.0, Style::Cel, group);\n                    }\n                    sub::COAL => {\n                        sdf(scene, base, tip, 0.13, 0.08, hot * 0.45, 0.3 + beat * 0.6, Style::Cel, group);\n                    }\n                    _ => {\n                        // The appendix: a stubby, inflamed thing.\n                        let fl = col(srgb3(214, 120, 104));\n                        sdf(scene, base, tip + Vec3::Y * 0.1, 0.24, 0.16, fl, 0.0, Style::Cel, group);\n                    }\n                }\n            }\n            Kind::Polyp => {\n                let y = ground + 0.02;\n                let stem = col(srgb3(210, 110, 110));\n                let dome = col(srgb3(240, 170, 130));\n                let r = h.r * (1.0 + beat * 0.04);\n                sdf(scene, at(p, y), at(p, y + 0.25), r * 0.55, r * 0.7, stem, 0.0, Style::Cel, group);\n                sdf(scene, at(p, y + 0.3), at(p, y + 0.3), r * 0.75, r * 0.75, dome, h.fill * 0.5, Style::Cel, group);\n            }\n            Kind::Tumor if h.stage == 1 => {\n                let dark = col(srgb3(96, 52, 88));\n                let y = ground + 0.1 + lift;\n                sdf(scene, at(p, y), at(p, y + 0.15), h.r * 0.7, h.r * 0.55, dark, 0.0, Style::Cel, group);\n            }\n            Kind::Bone => {\n                if h.stage == 0 {\n                    let dir = Vec2::from_angle(h.ang);\n                    let y = plate.height(p) + 0.32;\n                    let e = dir * h.r;\n                    sdf(scene, at(p - e, y), at(p + e, y), 0.34, 0.3, bone, 0.0, Style::Cel, group);\n                    let chip = at(p + e * 0.2 + dir.perp() * 0.18, y + 0.05);\n                    sdf(scene, chip, chip, 0.26, 0.26, bone * 0.92, 0.0, Style::Cel, group);\n                } else {\n                    let seat = h.c;\n                    let y = plate.height(seat) + 0.18;\n                    let e = Vec2::new(h.r, 0.0);\n                    sdf(scene, at(seat - e, y), at(seat + e, y), 0.32, 0.3, bone, 0.0, Style::Cel, group);\n                    let wire = Vec3::new(0.85, 0.75, 0.45);\n                    for k in 0..h.n {\n                        let x = h.a.x + (h.b.x - h.a.x) * (k as f32 + 0.5) / h.need.max(1) as f32;\n                        sdf(scene, at(Vec2::new(x, seat.y - 0.36), y + 0.14), at(Vec2::new(x, seat.y + 0.36), y + 0.14), 0.035, 0.035, wire, 0.0, Style::Lit, group);\n                    }\n                }\n            }\n            Kind::Bleeder => {\n                let spurt = (f.beat * std::f32::consts::TAU).cos().max(0.0);\n                let c = col(srgb3(180, 12, 24));\n                let y = ground + 0.05;\n                sdf(scene, at(p.lerp(h.b, 0.5), y), at(p.lerp(h.b, 0.5), y + 0.1 + spurt * 0.5), 0.13, 0.04, c, 0.0, Style::Cel, group);\n            }\n            Kind::Nodule => {\n                if !h.visible() {\n                    continue;\n                }\n                let r = h.r * if h.sub == sub::AMEN { 1.0 } else { 1.0 } * (1.0 + beat * 0.08);\n                let y = ground + r * 0.4 + lift;\n                if h.stage == 0 || h.stage == 2 {\n                    sdf(scene, at(p, y), at(p, y), r, r, parasite, 0.04, Style::Cel, group);\n                    for k in 0..5 {\n                        let a = k as f32 * 1.256 + t * 0.4;\n                        let q = p + Vec2::from_angle(a) * r * 0.85;\n                        sdf(scene, at(q, y + 0.15), at(q, y + 0.15), r * 0.22, r * 0.22, core, 0.0, Style::Cel, group);\n                    }\n                }\n                let eye_r = if h.stage == 1 { r * 0.55 } else { r * 0.26 };\n                sdf(scene, at(p, y + r * 0.72), at(p, y + r * 0.72), eye_r, eye_r, eye, 1.6, Style::Unlit, group + 1);\n                if h.stage == 1 {\n                    sdf(scene, at(p, y), at(p, y), r * 0.7, r * 0.7, core, 0.0, Style::Cel, group);\n                    let dir = Vec2::from_angle(h.ang);\n                    sdf(scene, at(p, y + 0.1), at(p + dir * 0.7, y + 0.35), 0.1, 0.05, parasite, 0.0, Style::Cel, group);\n                }\n            }\n            Kind::Sac => {\n                let y = ground + 0.1;\n                let root = at(h.b, plate.height(h.b) + 0.12);\n                let body = at(h.a, y + h.r * 0.7);\n                chain(scene, root, body, 0.1, 0.07, 8, 0.1, t, parasite, group);\n                let quiver = (t * 24.0).sin() * 0.03 * h.prog;\n                let r = h.r * (1.0 + quiver + beat * 0.03);\n                sdf(scene, body, body, r, r, sac_c * (0.3 + h.prog * 0.5), 0.5 + h.prog * 0.5, Style::Cel, group + 1);\n                let stem = h.a.lerp(h.b, 0.55);\n                if h.fill > 0.0 {\n                    sdf(scene, at(stem, y + 0.3), at(stem, y + 0.3), 0.14, 0.14, Vec3::new(1.0, 0.3, 0.1), 1.2 * h.fill, Style::Unlit, group + 2);\n                }\n            }\n            Kind::Eye => {\n                let open = h.prog > 0.5 || h.stage == 1;\n                let y = ground + 0.28;\n                let r = h.r;\n                for k in 0..6 {\n                    let a = k as f32 / 6.0 * std::f32::consts::TAU + t * 0.1;\n                    let q = p + Vec2::from_angle(a) * r * 1.05;\n                    sdf(scene, at(q, y), at(p + Vec2::from_angle(a + 0.5) * r * 1.05, y), 0.15, 0.15, parasite, 0.0, Style::Cel, group);\n                }\n                sdf(scene, at(p, y), at(p, y), r * 0.8, r * 0.8, core, 0.0, Style::Cel, group);\n                if open {\n                    let look = Vec2::new((t * 0.9).sin(), (t * 0.7).cos()) * 0.12;\n                    sdf(scene, at(p, y + 0.42), at(p, y + 0.42), r * 0.52, r * 0.52, eye, 1.6, Style::Unlit, group + 1);\n                    sdf(scene, at(p + look, y + 0.8), at(p + look, y + 0.8), r * 0.2, r * 0.2, core, 0.0, Style::Unlit, group + 2);\n                } else {\n                    sdf(scene, at(p - Vec2::X * 0.4, y + 0.55), at(p + Vec2::X * 0.4, y + 0.55), 0.06, 0.06, eye, 1.2, Style::Unlit, group + 1);\n                }\n            }\n            Kind::Ember => {\n                let y = ground + 0.25 + (t * 3.0 + h.id as f32).sin() * 0.03;\n                let r = h.r * (1.0 + beat * 0.1);\n                if h.stage == 0 {\n                    sdf(scene, at(p, y), at(p, y), r, r, hot * 0.5, 0.7 + beat * 0.6, Style::Cel, group);\n                    for k in 0..3 {\n                        let q = p + Vec2::from_angle(k as f32 * 2.1 + t) * r * 0.75;\n                        sdf(scene, at(q, y + 0.28), at(q, y + 0.28), r * 0.28, r * 0.28, Vec3::new(1.0, 0.82, 0.3), 1.8, Style::Unlit, group + 1);\n                    }\n                } else {\n                    sdf(scene, at(p, y), at(p, y), r, r, frost, 0.3, Style::Cel, group);\n                    for k in 0..4 {\n                        let d = Vec2::from_angle(k as f32 * 1.57 + 0.4);\n                        sdf(scene, at(p, y + r * 0.8), at(p + d * r * 0.9, y + r * 0.45), 0.035, 0.02, Vec3::new(0.2, 0.35, 0.5), 0.0, Style::Lit, group + 1);\n                    }\n                }\n            }\n            Kind::Furnace => {\n                let y = ground + 0.1;\n                let r = h.r;\n                let c = if h.stage == 1 { frost } else { hot * 0.55 };\n                let glow = if h.stage == 1 { 0.2 } else { 1.0 + beat };\n                sdf(scene, at(p, y), at(p, y + 0.3), r, r * 0.85, c, glow, Style::Cel, group);\n                for k in 0..6 {\n                    let a = k as f32 * 1.047 + t * 0.5;\n                    let q = p + Vec2::from_angle(a) * r * 1.2;\n                    sdf(scene, at(p, y + 0.2), at(q, y + 0.05), 0.12, 0.05, parasite, 0.0, Style::Cel, group + 1);\n                }\n                sdf(scene, at(p, y + r + 0.3), at(p, y + r + 0.3), r * 0.28, r * 0.28, eye, 1.6, Style::Unlit, group + 2);\n            }\n            Kind::Tendril => {\n                let pulled = h.prog;\n                let from = at(h.a, plate.height(h.a) + 0.22);\n                let to = at(h.a.lerp(h.b, 1.0 - pulled * 0.8), plate.height(h.b) + 0.3 + pulled * 1.1);\n                chain(scene, from, to, 0.28, 0.06, 16, 0.35, t, parasite, group);\n                sdf(scene, to, to, 0.2, 0.2, eye, 1.4, Style::Unlit, group + 1);\n            }\n            Kind::Incision | Kind::Closure | Kind::Lacer | Kind::Pool | Kind::Patch | Kind::Tumor => {}\n        }\n    }\n    // Sutures stay on as visible thread.\n    let thread = Vec3::new(0.14, 0.14, 0.34);\n    let mut draw_threads = |scene: &mut Scene, a: Vec2, b: Vec2, n: u16, group: u32| {\n        let dir = (b - a).normalize_or_zero().perp() * 0.2;\n        for k in 0..n {\n            let s = a.lerp(b, (k as f32 + 0.5) / n.max(1) as f32);\n            let y = plate.height(s) + 0.06;\n            sdf(scene, at(s - dir, y), at(s + dir, y), 0.022, 0.022, thread, 0.0, Style::Cel, group);\n        }\n    };\n    for (k, th) in f.threads.iter().enumerate() {\n        draw_threads(scene, th.a, th.b, th.n, 0x1800 + k as u32);\n    }\n    for h in &f.hazards {\n        if matches!(h.kind, Kind::Lacer | Kind::Bleeder) && h.n > 0 {\n            let e = h.a.lerp(h.b, h.prog.clamp(0.0, 1.0));\n            draw_threads(scene, h.a, e, h.n, 0x1800 + h.id);\n        }\n    }\n    // Things flying to the tray.\n    for fl in &f.flights {\n        let to = Vec2::new(0.0, 5.3);\n        let s = fl.t * fl.t * (3.0 - 2.0 * fl.t);\n        let q = fl.from.lerp(to, s);\n        let y = 0.8 + (fl.t * std::f32::consts::PI).sin() * 3.0;\n        let (c, e) = match fl.kind {\n            Kind::Sac => (sac_c * 0.5, 0.6),\n            Kind::Eye => (eye, 1.2),\n            Kind::Tendril => (parasite, 0.0),\n            _ => match fl.sub {\n                sub::COAL => (hot * 0.5, 0.8),\n                4 => (col(srgb3(150, 80, 80)), 0.0),\n                _ => (steel, 0.0),\n            },\n        };\n        sdf(scene, at(q, y), at(q, y + 0.15), 0.18, 0.12, c, e, Style::Cel, 0x1fff);\n    }\n}\nEOF\ncat > crates/pav_view/src/surgery/paper.rs <<'EOF'\n//! The paper theatre: layered, extruded spline cards that the engine lights, shadows and outlines.\n//! Each character is a rig of parts from a text file; sets are cards too, with parallax layers.\n\nuse std::collections::HashMap;\n\nuse glam::{Mat4, Vec2, Vec3};\nuse pav_core::games::surgery::content::{Content, Set};\nuse pav_core::games::surgery::frame::StoryView;\nuse pav_core::games::surgery::paper::{Outline, PartGeo, mouth_points, outline, pose_for, posed, rig_parts};\nuse pav_render::mesh::{MeshData, Vertex};\nuse pav_render::scene::{self as rs, DynamicMesh, ParticleBurst, PointLight, Scene, Style};\n\nconst LAYER: f32 = 0.035;\nconst DEPTH: f32 = 0.03;\n\n/// Extrudes an outline's points into a card: front face at `z`, walls back to `z - depth`.\nfn card(out: &mut MeshData, points: &[Vec2], tris: &[u32], z: f32, depth: f32, xf: &Mat4, color: [f32; 4]) {\n    let base = out.vertices.len() as u32;\n    let n = xf.transform_vector3(Vec3::Z).normalize_or_zero();\n    for q in points {\n        let p = xf.transform_point3(Vec3::new(q.x, q.y, z));\n        debug_assert!(p.is_finite());\n        out.vertices.push(Vertex { pos: p.to_array(), normal: n.to_array(), uv: [q.x, q.y], color });\n    }\n    out.indices.extend(tris.iter().map(|t| t + base));\n    if depth > 0.0 {\n        let m = points.len();\n        for i in 0..m {\n            let (a, b) = (points[i], points[(i + 1) % m]);\n            let e = b - a;\n            let wall = xf.transform_vector3(Vec3::new(e.y, -e.x, 0.0)).normalize_or_zero();\n            let v = out.vertices.len() as u32;\n            for (q, zz) in [(a, z), (b, z), (b, z - depth), (a, z - depth)] {\n                let p = xf.transform_point3(Vec3::new(q.x, q.y, zz));\n                out.vertices.push(Vertex { pos: p.to_array(), normal: wall.to_array(), uv: [0.0, 0.0], color });\n            }\n            out.indices.extend_from_slice(&[v, v + 2, v + 1, v, v + 3, v + 2]);\n        }\n    }\n}\n\n#[derive(Default)]\npub struct PaperView {\n    rigs: HashMap<String, Vec<PartGeo>>,\n    sets: HashMap<String, Vec<(f32, [f32; 3], f32, f32, Outline)>>,\n    rain_carry: f32,\n    group: u32,\n}\n\nfn linear(hex: &str) -> [f32; 3] {\n    rs::hex(hex).unwrap_or(Vec3::splat(0.5)).to_array()\n}\n\nimpl PaperView {\n    fn next_group(&mut self) -> u32 {\n        self.group += 1;\n        self.group\n    }\n\n    fn push(&mut self, scene: &mut Scene, data: MeshData, emissive: f32, flags: u32) {\n        let group = self.next_group();\n        scene.dynamic.push(DynamicMesh { data, color: Vec3::ONE, emissive, style: Style::Cel, flags, group, material: 0 });\n    }\n\n    fn set_cards(&mut self, s: &Set) {\n        if self.sets.contains_key(&s.id) {\n            return;\n        }\n        let mut list = Vec::new();\n        for card in &s.card {\n            let pts: Vec<Vec2> = match card.rect {\n                Some([x0, y0, x1, y1]) => vec![Vec2::new(x0, y0), Vec2::new(x1, y0), Vec2::new(x1, y1), Vec2::new(x0, y1)],\n                None => card.points.iter().map(|p| Vec2::new(p[0], p[1])).collect(),\n            };\n            if pts.len() >= 3 {\n                list.push((card.z, linear(&card.color), card.emissive, card.blink, outline(&pts, card.chaikin)));\n            }\n        }\n        self.sets.insert(s.id.clone(), list);\n    }\n\n    /// Draws the stage. `dt` for rain.\n    pub fn emit(&mut self, scene: &mut Scene, st: &StoryView, c: &Content, time: f32, dt: f32, clear: &mut Vec3, particles: bool) {\n        self.group = 0x4000;\n        let Some(set) = c.sets.get(&st.set) else { return };\n        self.set_cards(set);\n        *clear = rs::hex(&set.back).unwrap_or(Vec3::ZERO);\n        // The camera sways a touch: real parallax between the layers.\n        let parallax = Vec2::new((time * 0.31).sin() * 0.05, (time * 0.23).cos() * 0.02);\n        let cards = self.sets.get(&st.set).cloned().unwrap_or_default();\n        for (z, color, emissive, blink, o) in cards {\n            let mut data = MeshData::default();\n            let depthwise = 1.0 + z.abs() * 0.05;\n            let xf = Mat4::from_translation(Vec3::new(parallax.x * z.abs() * 0.3, parallax.y * z.abs() * 0.3, 0.0)) * Mat4::from_scale(Vec3::new(depthwise, depthwise, 1.0));\n            let dim = if blink > 0.0 { 0.65 + 0.35 * (time * 3.0 * blink).sin().abs() } else { 1.0 };\n            let col = [color[0] * dim, color[1] * dim, color[2] * dim, 1.0];\n            card(&mut data, &o.points, &o.tris, z, 0.05, &xf, col);\n            self.push(scene, data, emissive, rs::flags::NO_SHADOW);\n        }\n        // Lamp and rain.\n        let lamp = rs::hex(&set.lamp).unwrap_or(Vec3::ONE);\n        scene.point_lights.push(PointLight { position: Vec3::new(-2.0, 5.0, 5.0), color: lamp * 0.8, radius: 18.0, shadows: true });\n        if set.rain > 0.0 && particles {\n            self.rain_carry += dt * 45.0 * set.rain;\n            let count = self.rain_carry as u32;\n            self.rain_carry -= count as f32;\n            if count > 0 {\n                scene.particles.push(ParticleBurst {\n                    count,\n                    pos: Vec3::new(0.0, 6.5, -4.6),\n                    area: Vec3::new(11.0, 0.5, 0.4),\n                    vel: Vec3::new(-1.0, -12.0, 0.0),\n                    spread: 0.3,\n                    gravity: 3.0,\n                    life: (0.8, 1.1),\n                    size: (0.02, 0.015),\n                    color0: glam::Vec4::new(0.7, 0.85, 1.0, 0.5),\n                    color1: glam::Vec4::new(0.7, 0.85, 1.0, 0.0),\n                    additive: true,\n                    stretch: true,\n                    ..Default::default()\n                });\n            }\n        }\n        // The characters.\n        for (idx, actor) in st.actors.iter().enumerate() {\n            let Some(rig) = c.rigs.get(&actor.rig) else { continue };\n            if !self.rigs.contains_key(&actor.rig) {\n                self.rigs.insert(actor.rig.clone(), rig_parts(c, rig));\n            }\n            let parts = self.rigs.get(&actor.rig).cloned().unwrap_or_default();\n            let seed = idx as f32 * 2.3 + actor.rig.len() as f32;\n            let pose = pose_for(rig.expr.get(&actor.expr), time, seed, actor.talking);\n            // Slide in with an overshoot; a 3/4 stance turned toward the middle.\n            let k = (actor.age * 3.2).min(1.0);\n            let over = 1.0 - (1.0 - k).powi(3) + (k * std::f32::consts::PI).sin() * 0.08;\n            let from = if actor.x < 0.0 { -9.0 } else { 9.0 };\n            let x = from + (actor.x - from) * over;\n            let yaw = if actor.x.abs() < 0.3 { 0.0 } else { -actor.x.signum() * 0.22 } + (time * 0.5 + seed).sin() * 0.035;\n            let shake = Vec2::new((time * 40.0).sin(), (time * 33.0).cos()) * (st.shake * 0.05);\n            let scale = rig.scale.max(0.5) * 1.15;\n            let xf = Mat4::from_translation(Vec3::new(x + shake.x, -0.55 + shake.y, 0.0))\n                * Mat4::from_rotation_y(yaw)\n                * Mat4::from_scale(Vec3::splat(scale));\n            for part in &parts {\n                let moved: Vec<Vec2> = part.outline.points.iter().map(|q| posed(part, &pose, *q)).collect();\n                let mut data = MeshData::default();\n                let col = [\n                    rs::srgb_to_linear(part.color[0] as f32 / 255.0),\n                    rs::srgb_to_linear(part.color[1] as f32 / 255.0),\n                    rs::srgb_to_linear(part.color[2] as f32 / 255.0),\n                    1.0,\n                ];\n                card(&mut data, &moved, &part.outline.tris, part.z * LAYER, DEPTH, &xf, col);\n                self.push(scene, data, 0.0, 0);\n            }\n            // The mouth, by frame.\n            let expr = rig.expr.get(&actor.expr);\n            let shape = expr.map(|e| e.mouth.as_str()).unwrap_or(\"closed\");\n            let m = mouth_points(shape, actor.talking, pose.flap);\n            let o = outline(&m, 1);\n            let head_part = PartGeo { name: \"mouth\".into(), z: 3.6, color: [0; 3], layer: pav_core::games::surgery::paper::Layer::Head, side: 0.0, outline: Outline::default() };\n            let moved: Vec<Vec2> = o.points.iter().map(|q| posed(&head_part, &pose, *q)).collect();\n            let mut data = MeshData::default();\n            card(&mut data, &moved, &o.tris, 3.6 * LAYER, DEPTH, &xf, [0.18, 0.04, 0.06, 1.0]);\n            self.push(scene, data, 0.0, 0);\n        }\n    }\n}\n\n/// The paper stage's light and style (tested values).\npub fn stage_light(scene: &mut Scene) {\n    scene.ambient = rs::Ambient { sky: Vec3::new(0.74, 0.74, 0.78), ground: Vec3::new(0.6, 0.56, 0.56) };\n    scene.sun = rs::Sun {\n        direction: Vec3::new(0.3, -0.45, -0.85).normalize(),\n        color: Vec3::splat(0.34),\n        shadows: true,\n        shadow_center: Vec3::ZERO,\n        shadow_radius: 14.0,\n    };\n    scene.style.cel_bands = 3.0;\n    scene.style.rim = 0.05;\n    scene.post.outlines = true;\n    scene.post.outline_darken = 0.32;\n    scene.post.outline_px = 1.4;\n    scene.post.gi = 0.4;\n    scene.post.bloom = 0.3;\n    scene.post.bloom_threshold = 1.15;\n    scene.filter.vignette = 0.32;\n}\nEOF\ncat > crates/pav_view/src/surgery/mod.rs <<'EOF'\n//! Draws the surgery game: the operative field, instruments, strains, the paper theatre and their\n//! effects, all from one `SurgeryFrame`.\n\npub mod instruments;\npub mod paper;\npub mod plate;\npub mod strains;\n\nuse glam::{Mat4, Vec2, Vec3, Vec4};\nuse pav_core::SimEvent;\nuse pav_core::games::surgery::content::content;\nuse pav_core::games::surgery::cue;\nuse pav_core::games::surgery::field::{Kind, Tool, iv_port, tray_slot};\nuse pav_core::games::surgery::frame::{Stage, SurgeryFrame};\nuse pav_render::scene::{self as rs, DistortKind, Distortion, ParticleBurst, PointLight, Scene, SdfInstance, Style, Transition};\n\nuse self::instruments::Motion;\n\n/// Player settings the picture follows.\n#[derive(Clone, Copy, Debug, Default)]\npub struct Looks {\n    pub clinical: bool,\n    pub reduce_flashes: bool,\n    /// Screen shake on (the setting).\n    pub no_shake: bool,\n    /// Skip drawing altogether: a hub server.\n    pub headless: bool,\n}\n\n#[derive(Default)]\npub struct SurgeryView {\n    pub plate: plate::PlateView,\n    pub paper: paper::PaperView,\n    pub looks: Looks,\n    /// The local player's cursor this render frame: drawn with zero lag.\n    pub local_cursor: Option<(usize, Vec2)>,\n    pending: Vec<ParticleBurst>,\n    rain_carry: f32,\n    fx_carry: f32,\n    last_stage: Option<Stage>,\n    stage_change: f32,\n    defib_shock: f32,\n    last_time: f32,\n}\n\npub const SEAT_COLORS: [[u8; 3]; 4] = [[0xe8, 0x44, 0x3a], [0x3b, 0x82, 0xf6], [0x22, 0xc5, 0x5e], [0xf5, 0xb7, 0x00]];\n\nfn seat(i: usize) -> Vec3 {\n    let c = SEAT_COLORS[i % 4];\n    rs::srgb(c[0], c[1], c[2])\n}\n\nimpl SurgeryView {\n    /// Particles for cues: blood, smoke, sparks, gel, frost.\n    pub fn add_events(&mut self, events: &[SimEvent]) {\n        for e in events {\n            let SimEvent::Cue { id, pos, gain, .. } = e else { continue };\n            let b = ParticleBurst::default();\n            let pos = *pos;\n            let (count, burst) = match *id {\n                cue::SLICE | cue::TEAR | cue::SQUISH => (\n                    10,\n                    ParticleBurst {\n                        vel: Vec3::new(0.0, 2.4, 0.0),\n                        spread: 1.3,\n                        gravity: 9.0,\n                        life: (0.25, 0.55),\n                        size: (0.05, 0.02),\n                        color0: Vec4::new(0.45, 0.02, 0.04, 1.0),\n                        color1: Vec4::new(0.3, 0.01, 0.02, 0.9),\n                        additive: false,\n                        floor: Some(0.3),\n                        ..b\n                    },\n                ),\n                cue::BURST => (\n                    46,\n                    ParticleBurst {\n                        vel: Vec3::new(0.0, 3.4, 0.0),\n                        spread: 3.0,\n                        gravity: 9.0,\n                        life: (0.4, 0.9),\n                        size: (0.09, 0.03),\n                        color0: Vec4::new(0.4, 0.75, 0.2, 1.0),\n                        color1: Vec4::new(0.2, 0.4, 0.1, 0.8),\n                        additive: false,\n                        floor: Some(0.3),\n                        ..b\n                    },\n                ),\n                cue::SIZZLE | cue::LASER => (\n                    6,\n                    ParticleBurst {\n                        vel: Vec3::new(0.0, 1.5, 0.0),\n                        spread: 0.5,\n                        gravity: -0.5,\n                        drag: 1.2,\n                        life: (0.6, 1.2),\n                        size: (0.08, 0.35),\n                        color0: Vec4::new(0.55, 0.55, 0.58, 0.5),\n                        color1: Vec4::new(0.7, 0.7, 0.75, 0.0),\n                        additive: false,\n                        turbulence: 1.2,\n                        ..b\n                    },\n                ),\n                cue::GEL => (\n                    8,\n                    ParticleBurst {\n                        vel: Vec3::new(0.0, 1.4, 0.0),\n                        spread: 0.8,\n                        gravity: 8.0,\n                        life: (0.2, 0.45),\n                        size: (0.06, 0.03),\n                        color0: Vec4::new(0.55, 0.95, 0.8, 1.0),\n                        color1: Vec4::new(0.55, 0.95, 0.8, 0.6),\n                        additive: false,\n                        floor: Some(0.3),\n                        ..b\n                    },\n                ),\n                cue::FROST | cue::CRACK => (\n                    12,\n                    ParticleBurst {\n                        vel: Vec3::new(0.0, 0.9, 0.0),\n                        spread: 1.2,\n                        gravity: 1.0,\n                        drag: 1.0,\n                        life: (0.5, 1.1),\n                        size: (0.06, 0.01),\n                        color0: Vec4::new(1.4, 1.9, 2.4, 0.9),\n                        color1: Vec4::new(0.8, 1.2, 1.8, 0.0),\n                        additive: true,\n                        ..b\n                    },\n                ),\n                cue::RATE_IMMACULATE | cue::ON_BEAT | cue::CHAIN_UP => (\n                    14,\n                    ParticleBurst {\n                        vel: Vec3::new(0.0, 2.2, 0.0),\n                        spread: 2.0,\n                        gravity: 3.0,\n                        drag: 1.0,\n                        life: (0.35, 0.7),\n                        size: (0.05, 0.01),\n                        color0: Vec4::new(3.0, 2.5, 1.2, 1.0),\n                        color1: Vec4::new(1.2, 0.8, 0.3, 0.0),\n                        additive: true,\n                        stretch: true,\n                        ..b\n                    },\n                ),\n                cue::DEFIB_THUMP => {\n                    self.defib_shock = 1.0;\n                    (\n                        70,\n                        ParticleBurst {\n                            vel: Vec3::new(0.0, 4.0, 0.0),\n                            spread: 6.0,\n                            gravity: 8.0,\n                            drag: 0.6,\n                            life: (0.2, 0.6),\n                            size: (0.05, 0.01),\n                            color0: Vec4::new(2.5, 3.0, 4.0, 1.0),\n                            color1: Vec4::new(1.0, 1.4, 2.5, 0.0),\n                            additive: true,\n                            stretch: true,\n                            area: Vec3::new(3.0, 0.1, 2.0),\n                            ..b\n                        },\n                    )\n                }\n                _ => continue,\n            };\n            let mut p = burst;\n            p.count = (count as f32 * gain.clamp(0.3, 1.5)) as u32;\n            p.pos = pos;\n            self.pending.push(p);\n        }\n    }\n\n    /// Adds the game's frame to the scene: called last in `ViewBuilder::build`.\n    pub fn emit(&mut self, scene: &mut Scene, f: &SurgeryFrame, time: f32, dt: f32, particles: bool) {\n        if self.looks.headless {\n            return;\n        }\n        let c = content();\n        if self.last_stage != Some(f.stage) {\n            self.last_stage = Some(f.stage);\n            self.stage_change = 0.0;\n        }\n        self.stage_change += dt;\n        self.last_time = time;\n        // A wall-clock for idle animation even when the sim pauses in a menu.\n        scene.particles.append(&mut self.pending);\n\n        if let (Stage::Story, Some(st)) = (f.stage, &f.story) {\n            if st.camera == 0 {\n                let mut clear = Vec3::ZERO;\n                paper::stage_light(scene);\n                self.paper.emit(scene, st, &c, time, dt, &mut clear, particles);\n                scene.clear_color = clear;\n                scene.filter.transition = (1.0 - self.stage_change / 0.45).clamp(0.0, 1.0);\n                scene.filter.transition_kind = Transition::Fade;\n                if st.flash > 0.0 && !self.looks.reduce_flashes {\n                    scene.filter.brightness = 1.0 + st.flash * 1.5;\n                }\n            } else {\n                // The 3D wide shot: engine puppets in scrubs round a table of blocks.\n                scene.clear_color = rs::srgb(12, 22, 26);\n                scene.sun.direction = Vec3::new(-0.3, -1.0, -0.2).normalize();\n                scene.sun.color = Vec3::new(0.9, 0.95, 1.0) * 0.5;\n                scene.point_lights.push(PointLight { position: Vec3::new(97.5, 3.2, -3.0), color: Vec3::new(1.0, 0.97, 0.9) * 3.0, radius: 12.0, shadows: true });\n                scene.ambient = rs::Ambient { sky: Vec3::new(0.4, 0.5, 0.55), ground: Vec3::new(0.2, 0.2, 0.22) };\n                scene.style.cel_bands = 3.0;\n                scene.filter.vignette = 0.4;\n            }\n            return;\n        }\n        self.emit_field(scene, f, &c, time, dt, particles);\n    }\n\n    fn emit_field(&mut self, scene: &mut Scene, f: &SurgeryFrame, c: &pav_core::games::surgery::content::Content, time: f32, dt: f32, particles: bool) {\n        let paint = plate::Paint { palette_clinical: self.looks.clinical, time };\n        self.plate.emit(scene, f, c, &paint);\n        strains::emit(scene, f, &self.plate, time);\n\n        // The drape's frame of steel retractors.\n        let steel = Vec3::new(0.56, 0.6, 0.63);\n        for (x, z) in [(-9.6, -3.2), (-9.6, 3.0), (9.6, -3.2), (9.6, 3.0)] {\n            let inward = if x < 0.0 { 1.0 } else { -1.0 };\n            let (a, b) = (Vec3::new(x + inward * 2.2, 0.45, z), Vec3::new(x - inward * 1.2, 1.1, z));\n            scene.sdfs.push(SdfInstance { a, b, ra: 0.11, rb: 0.14, color: steel, emissive: 0.0, style: Style::Lit, flags: rs::flags::OBJECT | rs::flags::NO_CUT, group: 0x801, material: 0 });\n        }\n        for (x, z) in [(-3.6f32, -5.1f32), (3.6, -5.1)] {\n            let (a, b) = (Vec3::new(x, 0.45, z + 1.2), Vec3::new(x, 1.1, z - 1.0));\n            scene.sdfs.push(SdfInstance { a, b, ra: 0.11, rb: 0.14, color: steel, emissive: 0.0, style: Style::Lit, flags: rs::flags::OBJECT | rs::flags::NO_CUT, group: 0x802, material: 0 });\n        }\n\n        let in_op = matches!(f.stage, Stage::Op | Stage::Complete | Stage::Dead | Stage::Chart | Stage::Results);\n        if in_op && !f.slots.is_empty() {\n            // The IV port and the tray.\n            let port = iv_port();\n            scene.sdfs.push(SdfInstance { a: Vec3::new(port.x, 0.95, port.y), b: Vec3::new(port.x - 0.1, 0.9, port.y + 0.8), ra: 0.2, rb: 0.08, color: Vec3::new(0.82, 0.88, 0.96), emissive: 0.0, style: Style::Lit, flags: rs::flags::OBJECT, group: 0x803, material: 0 });\n            let ring: [Tool; 8] = std::array::from_fn(|k| f.ring_tool(k));\n            let slots: [Vec2; 8] = std::array::from_fn(tray_slot);\n            let local = self.local_cursor.map(|(i, _)| i).unwrap_or(0);\n            let selected = f.slots.get(local).map(|s| s.ring_pos).unwrap_or(0);\n            instruments::emit_tray(scene, &ring, selected, time, &slots, self.looks.clinical);\n            if f.stage == Stage::Op {\n                self.emit_hands(scene, f, time);\n            }\n        }\n\n        // Light, tested values: lamp, sun, cel, ink, bloom, GI.\n        scene.sun = rs::Sun {\n            direction: Vec3::new(-0.25, -1.0, -0.35).normalize(),\n            color: Vec3::new(1.0, 0.98, 0.92) * 0.42,\n            shadows: true,\n            shadow_center: Vec3::ZERO,\n            shadow_radius: 16.0,\n        };\n        scene.ambient = rs::Ambient { sky: Vec3::new(0.50, 0.50, 0.54), ground: Vec3::new(0.30, 0.22, 0.22) };\n        scene.point_lights.push(PointLight { position: Vec3::new(-1.0, 7.0, -1.0), color: Vec3::new(1.0, 0.97, 0.9) * 0.9, radius: 16.0, shadows: true });\n        scene.clear_color = rs::srgb(16, 40, 44);\n        scene.style.cel_bands = 3.0;\n        scene.style.rim = 0.12;\n        scene.post.outlines = true;\n        scene.post.outline_darken = 0.45;\n        scene.post.bloom = 0.35;\n        scene.post.bloom_threshold = 1.15;\n        scene.post.gi = 0.6;\n        scene.post.distortion = true;\n        scene.filter.vignette = 0.35;\n\n        // Lights the parasites and embers throw.\n        let mut lights = 0;\n        for h in &f.hazards {\n            if lights >= 5 {\n                break;\n            }\n            let glow = match h.kind {\n                Kind::Ember if h.stage == 0 => Some(Vec3::new(1.0, 0.45, 0.15)),\n                Kind::Furnace => Some(Vec3::new(1.0, 0.45, 0.15) * 1.5),\n                Kind::Sac => Some(Vec3::new(0.3, 1.0, 0.5) * (0.2 + h.prog * 0.5)),\n                Kind::Eye if h.prog > 0.5 => Some(Vec3::new(1.0, 0.8, 0.3)),\n                _ => None,\n            };\n            if let Some(col) = glow {\n                lights += 1;\n                scene.point_lights.push(PointLight { position: Vec3::new(h.a.x, 1.3, h.a.y), color: col * 0.8, radius: 4.0, shadows: false });\n            }\n            // Haze over hot tissue.\n            if matches!(h.kind, Kind::Ember | Kind::Furnace) && h.stage != 1 {\n                scene.distortions.push(Distortion { pos: Vec3::new(h.a.x, 0.9, h.a.y), radius: 1.5, strength: 0.05, kind: DistortKind::Haze, progress: time.fract() });\n            }\n        }\n\n        self.rain_carry += dt * 40.0;\n        if particles {\n            self.fx(scene, f, dt);\n        }\n\n        // Filters: the Hush desaturates; crisis adds chroma and vignette on the beat.\n        let beat = (-f.beat * 5.0).exp();\n        if f.hush > 0.0 || f.time_scale < 0.99 {\n            let k = (1.0f32).min(f.hush.max(0.4));\n            scene.filter.saturation = 1.0 - 0.9 * k;\n            scene.filter.grade_part = rs::Part::Objects;\n            scene.filter.vignette = 0.55;\n        }\n        if f.crisis > 0.0 {\n            scene.filter.chroma = f.crisis * 0.0035 * (0.5 + beat);\n            scene.filter.vignette += f.crisis * 0.25 * (0.5 + beat * 0.5);\n        }\n        if f.ripple > 0.0 {\n            scene.distortions.push(Distortion { pos: Vec3::new(0.0, 0.5, 0.0), radius: 14.0, strength: 0.12, kind: DistortKind::Ripple, progress: 1.0 - f.ripple });\n        }\n        self.defib_shock = (self.defib_shock - dt * 1.6).max(0.0);\n        if self.defib_shock > 0.0 {\n            scene.distortions.push(Distortion { pos: Vec3::new(0.0, 0.5, 0.0), radius: 16.0, strength: 0.3, kind: DistortKind::Ring, progress: 1.0 - self.defib_shock });\n        }\n        if f.flash > 0.0 && !self.looks.reduce_flashes {\n            scene.filter.brightness = 1.0 + f.flash * 0.6;\n        }\n        // Shake: a moment's knock of the view.\n        if f.shake > 0.0 && !self.looks.no_shake {\n            let s = f.shake * f.shake * 0.12;\n            let off = Vec3::new((time * 47.0).sin(), (time * 37.0).cos(), 0.0) * s;\n            scene.camera.view = Mat4::from_translation(off) * scene.camera.view;\n        }\n        // Transitions: an iris onto the incision when a plate is revealed; a fade between stages;\n        // black under a death.\n        if f.reveal < 1.0 {\n            let k = 1.0 - f.reveal;\n            scene.filter.transition = (k * 0.8).min(0.55);\n            scene.filter.transition_kind = Transition::Iris;\n            scene.filter.transition_center = crate::build::screen_uv(&scene.camera, Vec3::new(f.reveal_at.x, 0.5, f.reveal_at.y));\n        } else if f.stage == Stage::Dead {\n            scene.filter.transition = (self.stage_change * 2.0).clamp(0.0, 1.0);\n            scene.filter.transition_kind = Transition::Fade;\n        } else if self.stage_change < 0.45 && matches!(f.stage, Stage::Op | Stage::Chart | Stage::Results) {\n            scene.filter.transition = 1.0 - self.stage_change / 0.45;\n            scene.filter.transition_kind = Transition::Fade;\n        }\n    }\n\n    fn emit_hands(&mut self, scene: &mut Scene, f: &SurgeryFrame, time: f32) {\n        for (i, s) in f.slots.iter().enumerate() {\n            if !s.active {\n                continue;\n            }\n            let mut p = s.cursor;\n            if let Some((who, at)) = self.local_cursor {\n                if who == i {\n                    p = at;\n                }\n            }\n            let tool = Tool::from_u8(s.tool);\n            // IV sits at its port while it pushes.\n            let tip2 = if tool == Tool::Iv && s.using { iv_port() } else { p };\n            let ground = self.plate.height(tip2);\n            let press = if s.using { 0.02 } else { 0.28 };\n            let tip = Vec3::new(tip2.x, ground + press + s.recoil * 0.25, tip2.y);\n            let m = Motion { using: s.using, pressure: s.pressure, time, meter: if tool == Tool::Defib { s.charge } else { s.meter }, recoil: s.recoil };\n            let mut axis = instruments::hand_axis();\n            if tool == Tool::Defib {\n                axis = Vec3::new(0.0, 1.0, 0.25);\n            }\n            // The Scalpel leans into the stroke; a clink knocks the hand.\n            axis += Vec3::new((time * 42.0).sin() * s.clink * 0.05, 0.0, 0.0);\n            instruments::emit(scene, tool, tip, axis, m, 1.05, 0x700 + i as u32 * 8, 0.0);\n            // Reticle in the seat's colour.\n            let col = seat(i);\n            let g = ground + 0.05;\n            for k in 0..4 {\n                let a = k as f32 * std::f32::consts::FRAC_PI_2 + 0.78;\n                let d = Vec2::from_angle(a) * if s.hover != 0 { 0.28 } else { 0.4 };\n                let q = Vec3::new(p.x + d.x, g, p.y + d.y);\n                scene.sdfs.push(SdfInstance { a: q, b: q, ra: 0.05, rb: 0.05, color: col, emissive: 1.1, style: Style::Unlit, flags: rs::flags::OBJECT | rs::flags::NO_SHADOW | rs::flags::NO_CUT, group: 0x7f0, material: 0 });\n            }\n        }\n        // The Echo's luminous ghost of her younger hands.\n        if f.echo > 0.0 {\n            let g = f.ghost;\n            let ground = self.plate.height(g);\n            let tool = f.slots.first().map(|s| Tool::from_u8(s.tool)).unwrap_or(Tool::Forceps);\n            let tip = Vec3::new(g.x, ground + 0.12 + f.ghost_t * 0.2, g.y);\n            let m = Motion { using: f.ghost_t > 0.0, time, ..Default::default() };\n            let start = scene.sdfs.len();\n            instruments::emit(scene, tool, tip, Vec3::new(-0.4, 1.0, 0.5), m, 1.05, 0x7e0, 0.0);\n            for sd in &mut scene.sdfs[start..] {\n                sd.color = Vec3::new(0.5, 0.9, 1.0);\n                sd.emissive = 1.4;\n                sd.style = Style::Unlit;\n                sd.flags |= rs::flags::NO_SHADOW;\n            }\n        }\n    }\n\n    fn fx(&mut self, scene: &mut Scene, f: &SurgeryFrame, dt: f32) {\n        self.fx_carry += dt;\n        let tick = self.fx_carry >= 0.08;\n        if !tick {\n            return;\n        }\n        self.fx_carry = 0.0;\n        let b = ParticleBurst::default();\n        for h in &f.hazards {\n            match h.kind {\n                Kind::Bleeder if f.beat < 0.2 && !f.stopped => {\n                    scene.particles.push(ParticleBurst {\n                        count: 5,\n                        pos: Vec3::new((h.a.x + h.b.x) * 0.5, 0.6, (h.a.y + h.b.y) * 0.5),\n                        vel: Vec3::new(0.3, 3.8, 0.2),\n                        spread: 0.8,\n                        gravity: 10.0,\n                        life: (0.3, 0.6),\n                        size: (0.07, 0.03),\n                        color0: Vec4::new(0.5, 0.02, 0.04, 1.0),\n                        color1: Vec4::new(0.3, 0.01, 0.02, 0.9),\n                        additive: false,\n                        floor: Some(0.3),\n                        ..b\n                    });\n                }\n                Kind::Ember | Kind::Furnace if h.stage != 1 => {\n                    scene.particles.push(ParticleBurst {\n                        count: 2,\n                        pos: Vec3::new(h.a.x, 0.7, h.a.y),\n                        area: Vec3::new(0.4, 0.1, 0.4),\n                        vel: Vec3::new(0.0, 1.3, 0.0),\n                        spread: 0.4,\n                        gravity: -0.2,\n                        life: (0.7, 1.3),\n                        size: (0.05, 0.01),\n                        color0: Vec4::new(4.0, 1.8, 0.4, 1.0),\n                        color1: Vec4::new(1.5, 0.3, 0.1, 0.0),\n                        additive: true,\n                        turbulence: 1.0,\n                        ..b\n                    });\n                }\n                _ => {}\n            }\n        }\n        if f.hush > 0.0 {\n            scene.particles.push(ParticleBurst {\n                count: 6,\n                pos: Vec3::new(0.0, 3.0, 0.0),\n                area: Vec3::new(9.0, 2.0, 4.5),\n                vel: Vec3::ZERO,\n                spread: 0.1,\n                life: (1.8, 3.0),\n                size: (0.035, 0.015),\n                color0: Vec4::new(1.5, 1.5, 1.6, 0.0),\n                color1: Vec4::new(1.0, 1.0, 1.2, 0.8),\n                additive: true,\n                turbulence: 0.3,\n                ..b\n            });\n        }\n        if f.echo > 0.0 {\n            scene.particles.push(ParticleBurst {\n                count: 4,\n                pos: Vec3::new(f.ghost.x, 1.4, f.ghost.y),\n                area: Vec3::new(0.3, 0.8, 0.3),\n                spread: 0.3,\n                life: (0.4, 0.8),\n                size: (0.05, 0.01),\n                color0: Vec4::new(0.7, 1.6, 2.2, 0.9),\n                color1: Vec4::new(0.3, 0.8, 1.4, 0.0),\n                additive: true,\n                ..b\n            });\n        }\n        // Rain beyond the window on the title and menu.\n        if f.stage == Stage::Title || f.stage == Stage::Card {\n            scene.particles.push(ParticleBurst {\n                count: 18,\n                pos: Vec3::new(0.0, 12.0, -1.0),\n                area: Vec3::new(14.0, 0.5, 8.0),\n                vel: Vec3::new(-1.0, -18.0, 0.0),\n                spread: 0.3,\n                gravity: 3.0,\n                life: (0.4, 0.7),\n                size: (0.025, 0.02),\n                color0: Vec4::new(0.8, 0.95, 1.2, 0.5),\n                color1: Vec4::new(0.7, 0.85, 1.0, 0.0),\n                additive: true,\n                stretch: true,\n                ..b\n            });\n        }\n    }\n}\nEOF\npython3 - <<'EOF'\np='crates/pav_view/src/lib.rs'; s=open(p).read()\ns=s.replace(\"pub mod materials;\\n\",\"pub mod materials;\\npub mod surgery;\\n\")\nopen(p,'w').write(s)\np='crates/pav_view/src/build.rs'; s=open(p).read()\ns=s.replace('''    /// Procedural materials in this view: stable rows, attached''','''    /// The surgery game's field, instruments and paper theatre.\n    pub surgery: crate::surgery::SurgeryView,\n    /// Procedural materials in this view: stable rows, attached''')\ns=s.replace('''        self.emit_effects(&mut scene);\n        scenery.sort_unstable();\n        mark_objects(&mut scene, env_end, &scenery);''','''        self.emit_effects(&mut scene);\n        scenery.sort_unstable();\n        mark_objects(&mut scene, env_end, &scenery);\n        if let Some(sf) = &curr.surgery {\n            self.surgery.emit(&mut scene, sf, time, dt, settings.particles);\n        }''')\ns=s.replace('''    pub fn add_events(&mut self, events: &[SimEvent]) {\n        for e in events {\n            crate::fx::event_bursts(e, &mut self.pending_particles);''','''    pub fn add_events(&mut self, events: &[SimEvent]) {\n        self.surgery.add_events(events);\n        for e in events {\n            crate::fx::event_bursts(e, &mut self.pending_particles);''')\nopen(p,'w').write(s)\np='crates/pav_tools/src/session.rs'; s=open(p).read()\ns=s.replace('''    pub fn step(&mut self, ticks: u64) {\n        for _ in 0..ticks {''','''    /// The game's camera shot, when it has one (the surgery game).\n    fn apply_game_camera(&mut self, frame: &RenderFrame) {\n        if let Some(sf) = &frame.surgery {\n            let s = sf.camera;\n            self.camera.params.tilt = s.tilt;\n            self.camera.params.yaw = s.yaw;\n            self.camera.params.distance = s.distance;\n            self.camera.params.fov = s.fov;\n            self.camera.params.follow_lag = 0.0;\n            self.camera.params.height_offset = 0.0;\n            self.sim.state.focus = Vec3::from_array(s.target);\n        }\n    }\n\n    pub fn step(&mut self, ticks: u64) {\n        for _ in 0..ticks {''')\ns=s.replace('''    pub fn render(&mut self, width: u32, height: u32) -> Result<Vec<u8>> {\n        let frame = self.sim.frame();\n        let focus = frame.focus;''','''    pub fn render(&mut self, width: u32, height: u32) -> Result<Vec<u8>> {\n        let frame = self.sim.frame();\n        self.apply_game_camera(&frame);\n        let frame = self.sim.frame();\n        let focus = frame.focus;''')\ns=s.replace('''    ) -> Result<(Vec<u8>, Option<pav_ui::headless::Drawn>)> {\n        let frame = self.sim.frame();\n        let focus = frame.focus;''','''    ) -> Result<(Vec<u8>, Option<pav_ui::headless::Drawn>)> {\n        let frame = self.sim.frame();\n        self.apply_game_camera(&frame);\n        let frame = self.sim.frame();\n        let focus = frame.focus;''')\ns=s.replace('''        let scene = gpu.builder.build(&frame, &frame, 1.0, &camera, width as f32 / height as f32, &view, focus);\n        let vp = scene.camera.proj * scene.camera.view;\n        let drawn = has_ui(&frame).then(|| self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input));''','''        let scene = gpu.builder.build(&frame, &frame, 1.0, &camera, width as f32 / height as f32, &view, focus);\n        let vp = scene.camera.proj * scene.camera.view;\n        let drawn = has_ui(&frame).then(|| {\n            let surgery = frame.surgery.clone();\n            self.ui.frame_all(frame.game.as_deref(), surgery.as_deref(), &frame.hud, vp, width, height, input)\n        });''')\ns=s.replace('''        Some(self.ui.frame(frame.game.as_deref(), &frame.hud, vp, width, height, input))''','''        let surgery = frame.surgery.clone();\n        Some(self.ui.frame_all(frame.game.as_deref(), surgery.as_deref(), &frame.hud, vp, width, height, input))''')\ns=s.replace('''    frame.game.is_some() || !frame.hud.lines.is_empty()''','''    frame.game.is_some() || frame.surgery.is_some() || !frame.hud.lines.is_empty()''')\ns=s.replace('''        self.camera.snap(frame.focus);\n        let vp = self.camera.view_proj(width as f32 / height.max(1) as f32);''','''        self.apply_game_camera(&frame);\n        self.camera.snap(self.sim.state.focus);\n        let vp = self.camera.view_proj(width as f32 / height.max(1) as f32);''')\nopen(p,'w').write(s)\nEOF\nsed -n 140,170p crates/pav_ui/src/headless.rs; sed -n 170,202p crates/pav_ui/src/headless.rs; ../tools/cb.sh check --locked -p pav_view 2>&1 | head -60","description":"Write strains, paper and field view; wire into builder","timeout":400000}}}
