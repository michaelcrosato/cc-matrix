{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgk1RAp2vF9K8Dq7m8bh4","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XWR8kNHnYDgviQo5rJfTbw","name":"Bash","input":{"command":"python3 - <<'EOF'\np='crates/pav_app/src/product.rs'; s=open(p).read()\ns=s.replace('''            let Some(host) = &self.host else { continue };\n            if let Some(s) = v.get(\"load\").and_then(|x| x.as_str()) {\n                let s = s.to_string();\n                self.product_load(pr, &s);\n                pr.shell.screen = if s.contains(\"title\") { Screen::Title } else { Screen::Playing };\n            }\n''','''            if let Some(s) = v.get(\"load\").and_then(|x| x.as_str()) {\n                let s = s.to_string();\n                self.product_load(pr, &s);\n                pr.shell.screen = if s.contains(\"title\") { Screen::Title } else { Screen::Playing };\n            }\n            let Some(host) = &self.host else { continue };\n''')\nopen(p,'w').write(s)\np='crates/pav_view/src/surgery/strains.rs'; s=open(p).read()\ns=s.replace(\"use pav_core::games::surgery::field::{Hazard, Kind, sub};\",\"use pav_core::games::surgery::field::{Kind, sub};\")\ns=s.replace(\"let mut draw_threads =\",\"let draw_threads =\")\nopen(p,'w').write(s)\np='crates/pav_ui/src/surgery/shell.rs'; s=open(p).read()\ns=s.replace(\"fn playing(&mut self, p: &Painter, input\",\"fn playing(&mut self, _p: &Painter, input\")\nopen(p,'w').write(s)\n\n# tools: surgeon input, case_check, balance\np='crates/pav_tools/src/tools.rs'; s=open(p).read()\ns=s.replace('''    Tool {\n        name: \"room_reload\",''','''    Tool {\n        name: \"case_check\",\n        help: \"Validate a surgery content file (case, story, plate, rig, set) and all references. Names the file and line of an error.\",\n        args: &[arg(\"path\", \"string\", \"path to a content .toml; omit to lint everything\")],\n        run: t_case_check,\n    },\n    Tool {\n        name: \"balance\",\n        help: \"Plays every surgery case with the bot at several skills: wins, time, vitals left, and a suggested par per case.\",\n        args: &[arg(\"seeds\", \"integer\", \"seeds per case and skill (default 20)\"), arg(\"skills\", \"string\", \"comma-separated skills (default 1.0,0.7,0.4)\"), arg(\"cases\", \"string\", \"comma-separated cases (default all)\")],\n        run: t_balance,\n    },\n    Tool {\n        name: \"surgeon\",\n        help: \"Drives a surgeon seat for some ticks: surgeon slot=1 aim=[x,z] hold=use tool=3 ticks=30 (hold: use, precision, cancel, gift, defib, rot_l, rot_r, advance).\",\n        args: &[arg(\"slot\", \"integer\", \"seat 1-4 (default 1)\"), arg(\"aim\", \"array\", \"[x, z] on the field\"), arg(\"hold\", \"string\", \"buttons, comma-separated\"), arg(\"tool\", \"integer\", \"ring position 1-8\"), arg(\"ticks\", \"integer\", \"ticks (default 1)\")],\n        run: t_surgeon,\n    },\n    Tool {\n        name: \"room_reload\",''')\ns=s.replace('''fn t_room_reload(s: &mut Session, _: &Args) -> Result<Output> {''','''fn t_case_check(_: &mut Session, a: &Args) -> Result<Output> {\n    use pav_core::games::surgery::content;\n    if let Some(path) = get_str(a, \"path\") {\n        // The file by itself first: its own line numbers.\n        let text = std::fs::read_to_string(path)?;\n        if let Err(e) = toml::from_str::<toml::Table>(&text) {\n            let line = e.span().map(|s| text[..s.start.min(text.len())].lines().count().max(1)).unwrap_or(0);\n            return Ok(Output::Json(json!({ \"ok\": false, \"error\": format!(\"{path} line {line}: {}\", e.message()) })));\n        }\n    }\n    Ok(Output::Json(match content::load() {\n        Err(e) => json!({ \"ok\": false, \"error\": format!(\"{e:#}\") }),\n        Ok(c) => match content::lint(&c) {\n            Ok(()) => json!({ \"ok\": true, \"cases\": c.cases.len(), \"scenes\": c.scenes.len(), \"rigs\": c.rigs.len(), \"sets\": c.sets.len(), \"plates\": c.plates.len() }),\n            Err(list) => json!({ \"ok\": false, \"errors\": list }),\n        },\n    }))\n}\n\nfn t_balance(_: &mut Session, a: &Args) -> Result<Output> {\n    use pav_core::games::Outcome;\n    use pav_core::games::surgery;\n    let seeds = get_u64(a, \"seeds\", 20)?;\n    let skills: Vec<f32> = get_str(a, \"skills\").unwrap_or(\"1.0,0.7,0.4\").split(',').filter_map(|x| x.trim().parse().ok()).collect();\n    let cases: Vec<usize> = get_str(a, \"cases\").map(|c| c.split(',').filter_map(|x| x.trim().parse().ok()).collect()).unwrap_or_else(|| (0..8).collect());\n    let mut out = Vec::new();\n    for case in cases {\n        let mut rows = Vec::new();\n        for &skill in &skills {\n            let (mut wins, mut time, mut vit, mut total) = (0u32, 0.0f32, 0.0f32, 0i64);\n            for seed in 1..=seeds {\n                let mut sim = Sim::new(&format!(\"surgery/case/{case}\"), seed)?;\n                surgery::get_mut(&mut sim).unwrap().bot_skill = skill;\n                let (o, ticks) = sim.run_bot(60 * 60 * 14);\n                if o == Outcome::Won {\n                    wins += 1;\n                    time += ticks as f32 / 60.0;\n                    let g = surgery::get(&sim).unwrap();\n                    if let Some(r) = &g.results {\n                        total += r.total;\n                    }\n                    vit += g.op.as_ref().map(|o| o.vitals).unwrap_or(0.0);\n                }\n            }\n            let w = wins.max(1) as f32;\n            rows.push(json!({ \"skill\": skill, \"wins\": format!(\"{wins}/{seeds}\"), \"secs\": (time / w) as i32, \"vitals\": (vit / w) as i32, \"score\": total / wins.max(1) as i64 }));\n        }\n        let top = rows[0][\"score\"].as_i64().unwrap_or(0);\n        out.push(json!({ \"case\": case, \"suggested_par\": (top as f32 / 1.08 / 100.0).round() * 100.0, \"rows\": rows }));\n    }\n    Ok(Output::Json(json!(out)))\n}\n\nfn t_surgeon(s: &mut Session, a: &Args) -> Result<Output> {\n    use pav_core::input::{SurgeonInput, surgeon_buttons as b};\n    let slot = (get_u64(a, \"slot\", 1)?.clamp(1, 4) - 1) as usize;\n    let aim = vec_arg(a, \"aim\")?;\n    let tool = get_u64(a, \"tool\", 0)? as u8;\n    let n = get_u64(a, \"ticks\", 1)?.max(1);\n    let mut held = 0u8;\n    for name in get_str(a, \"hold\").unwrap_or(\"\").split(',').map(str::trim).filter(|x| !x.is_empty()) {\n        held |= match name {\n            \"use\" => b::USE,\n            \"precision\" => b::PRECISION,\n            \"cancel\" => b::CANCEL,\n            \"gift\" => b::GIFT,\n            \"defib\" => b::DEFIB,\n            \"rot_l\" => b::ROT_L,\n            \"rot_r\" => b::ROT_R,\n            \"advance\" => b::ADVANCE,\n            other => bail!(\"unknown button '{other}'\"),\n        };\n    }\n    for i in 0..n {\n        let mut f = pav_core::InputFrame::default();\n        let target = match (&aim, pav_core::games::surgery::get(&s.sim).and_then(|g| g.op.as_ref())) {\n            (Some(v), _) if v.len() == 2 => glam::Vec2::new(v[0], v[1]),\n            (_, Some(op)) => op.slots[slot].aim,\n            _ => glam::Vec2::ZERO,\n        };\n        f.surgeons[slot] = SurgeonInput {\n            active: true,\n            abs: true,\n            aim: target,\n            held,\n            pressed: if i == 0 { held } else { 0 },\n            tool: if i == 0 { tool } else { 0 },\n            cycle: 0,\n            pressure: 1.0,\n        };\n        s.sim.step(&f);\n        s.sync_camera();\n    }\n    s.keep_events();\n    Ok(Output::Json(s.sim.play().map(|g| g.status(&s.sim)).unwrap_or(json!(null))))\n}\n\nfn t_room_reload(s: &mut Session, _: &Args) -> Result<Output> {''')\nopen(p,'w').write(s)\n\n# web: shim + packer\np='scripts/pack_single_html.py'; s=open(p).read()\ns=s.replace('''    # A manifest is another file to load: the single page goes without one.''','''    # The AI Hub session client (unmodified, first in <head>), its tags, the shim that owns every\n    # AIHub call, and the About block read at boot. See web/session.js and web/hub_shim.js.\n    web = ROOT / \"web\"\n    if (web / \"session.js\").exists():\n        client = (web / \"session.js\").read_text(encoding=\"utf-8\")\n        shim = (web / \"hub_shim.js\").read_text(encoding=\"utf-8\")\n        for name, code in ((\"session.js\", client), (\"hub_shim.js\", shim)):\n            if re.search(r\"(?i)</script|<script|<!--\", code):\n                fail(f\"{name} contains <script, </script or <!--, which can't sit inside an inline script\")\n        tags = (web / \"hub_tags.html\").read_text(encoding=\"utf-8\")\n        page, n = re.subn(r'<meta charset=\"utf-8\">\\\\n',\n            lambda m: m.group(0) + \"<script>\\\\n\" + client + \"\\\\n</script>\\\\n\" + tags + \"<script>\\\\n\" + shim + \"\\\\n</script>\\\\n\",\n            page, count=1)\n        if n != 1:\n            fail(\"no <meta charset> to put the session client after\")\n    about = web / \"about.json\"\n    if about.exists():\n        text = about.read_text(encoding=\"utf-8\").replace(\"<\", \"\\\\\\\\u003c\")\n        page = replace_one(page, r\"</head>\", lambda m: f'<script type=\"application/json\" id=\"about-data\">{text}</script>\\\\n</head>', \"</head>\")\n    # A manifest is another file to load: the single page goes without one.''')\nopen(p,'w').write(s)\np='web/index.html'; s=open(p).read()\ns=s.replace('''  if (!navigator.gpu) {\n    msg.replaceChildren(''','''  if (!navigator.gpu) {\n    if (window.AIHub && AIHub.active) AIHub.fail('This game needs WebGPU.');\n    msg.replaceChildren(''')\nopen(p,'w').write(s)\nEOF\ncp ../tests/hub/session.js web/session.js\ncat > web/hub_tags.html <<'EOF'\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"shared-world\">\n<meta name=\"hub:session-minutes\" content=\"4\">\n<meta name=\"hub:webgpu\" content=\"required\">\n<meta name=\"hub:session-goal\" content=\"Keep the patient alive; the steadiest hands score highest.\">\n<meta name=\"hub:session-howto\" content=\"Aim: right stick or mouse. Operate: R2 or click. Tools: left stick or 1-8.\">\nEOF\ncat > web/hub_shim.js <<'EOF'\n// Owns every AIHub call and queues events; the game polls it each frame. Rust talks to it through\n// window.__hub. Outside a session it does nothing but offer the rumble helper.\nwindow.__rumble = function (i, ms, weak, strong) {\n  try {\n    const p = navigator.getGamepads && navigator.getGamepads()[i];\n    const a = p && p.vibrationActuator;\n    if (a && a.playEffect) a.playEffect('dual-rumble', { duration: ms, weakMagnitude: weak, strongMagnitude: strong });\n  } catch (e) { /* no rumble here */ }\n};\n(function () {\n  const H = window.__hub = { active: !!(window.AIHub && AIHub.active), info: undefined, events: [], last: null, ended: false };\n  if (!H.active) return;\n  AIHub.connect({ mode: 'shared-world', seats: [1, 4], card: true }).then((info) => {\n    H.info = info;\n    if (!info) { H.active = false; return; }      // no hub after all: run as on its own\n    for (const ev of ['card', 'start', 'leave', 'end']) AIHub.on(ev, (d) => { H.events.push([ev, d]); if (ev === 'end') H.ended = true; });\n    AIHub.on('message', (d, from) => H.events.push(['message', d, from]));\n    AIHub.on('time-up', () => {                   // answer now: frames may be slow\n      H.events.push(['time-up', null]);\n      if (AIHub.isHost && !H.done) { H.done = true; AIHub.finish(H.last || { standings: [AIHub.players.map((p) => p.id)], won: false }); }\n    });\n  });\n  addEventListener('keydown', (e) => {\n    if (H.started) return;\n    if (e.key === 'Enter') AIHub.answer('ready');\n    if (e.key === 'm' || e.key === 'M') AIHub.answer('more');\n  }, true);\n  H.infoJson = () => (H.info === undefined ? undefined : JSON.stringify(H.info));\n  H.poll = () => { const a = H.events; H.events = []; for (const e of a) if (e[0] === 'start') H.started = true; return JSON.stringify(a); };\n  H.ready = () => AIHub.ready();\n  H.answer = (what) => { if (!H.started) AIHub.answer(what); };\n  H.time = () => AIHub.time();\n  H.finish = (json) => { if (AIHub.isHost && !H.done && !H.ended) { H.done = true; AIHub.finish(JSON.parse(json)); } };\n  H.send = (json, to) => { if (!H.ended) AIHub.send(JSON.parse(json), { reliable: false, to }); };\n  H.publish = (json) => { H.last = JSON.parse(json); };\n})();\nEOF\ngrep -n \"</head>\" web/index.html; grep -c \"<script\\|</script\\|<!--\" web/session.js; sed -i 's/^use anyhow::{/use anyhow::{/' crates/pav_tools/src/tools.rs; grep -n \"^use anyhow\\|bail\" crates/pav_tools/src/tools.rs | head -3\nJOBS=4 ../tools/cb.sh build -p pav_tools --bin pav 2>&1 | grep -E \"^error|^warning: unused|-->\" -A5 | head -40; ../tools/cb.sh check -p pav_app --target wasm32-unknown-unknown 2>&1 | grep -E \"^error|-->\" -A5 | head -50; git diff --stat Cargo.lock | tail -2","description":"Add tools, page shim and packer; build native and wasm checks","timeout":600000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":28869,"cache_read_input_tokens":562744,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":28869},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"bb2bd087-d4dd-4c1b-afcb-ae4f1cff278e","timestamp":"2026-11-05T15:21:33.059Z","request_id":"req_011Cgk1RAYQKvdpfDD8ETED7","wire_tool_inputs":{"toolu_01XWR8kNHnYDgviQo5rJfTbw":{"command":"python3 - <<'EOF'\np='crates/pav_app/src/product.rs'; s=open(p).read()\ns=s.replace('''            let Some(host) = &self.host else { continue };\n            if let Some(s) = v.get(\"load\").and_then(|x| x.as_str()) {\n                let s = s.to_string();\n                self.product_load(pr, &s);\n                pr.shell.screen = if s.contains(\"title\") { Screen::Title } else { Screen::Playing };\n            }\n''','''            if let Some(s) = v.get(\"load\").and_then(|x| x.as_str()) {\n                let s = s.to_string();\n                self.product_load(pr, &s);\n                pr.shell.screen = if s.contains(\"title\") { Screen::Title } else { Screen::Playing };\n            }\n            let Some(host) = &self.host else { continue };\n''')\nopen(p,'w').write(s)\np='crates/pav_view/src/surgery/strains.rs'; s=open(p).read()\ns=s.replace(\"use pav_core::games::surgery::field::{Hazard, Kind, sub};\",\"use pav_core::games::surgery::field::{Kind, sub};\")\ns=s.replace(\"let mut draw_threads =\",\"let draw_threads =\")\nopen(p,'w').write(s)\np='crates/pav_ui/src/surgery/shell.rs'; s=open(p).read()\ns=s.replace(\"fn playing(&mut self, p: &Painter, input\",\"fn playing(&mut self, _p: &Painter, input\")\nopen(p,'w').write(s)\n\n# tools: surgeon input, case_check, balance\np='crates/pav_tools/src/tools.rs'; s=open(p).read()\ns=s.replace('''    Tool {\n        name: \"room_reload\",''','''    Tool {\n        name: \"case_check\",\n        help: \"Validate a surgery content file (case, story, plate, rig, set) and all references. Names the file and line of an error.\",\n        args: &[arg(\"path\", \"string\", \"path to a content .toml; omit to lint everything\")],\n        run: t_case_check,\n    },\n    Tool {\n        name: \"balance\",\n        help: \"Plays every surgery case with the bot at several skills: wins, time, vitals left, and a suggested par per case.\",\n        args: &[arg(\"seeds\", \"integer\", \"seeds per case and skill (default 20)\"), arg(\"skills\", \"string\", \"comma-separated skills (default 1.0,0.7,0.4)\"), arg(\"cases\", \"string\", \"comma-separated cases (default all)\")],\n        run: t_balance,\n    },\n    Tool {\n        name: \"surgeon\",\n        help: \"Drives a surgeon seat for some ticks: surgeon slot=1 aim=[x,z] hold=use tool=3 ticks=30 (hold: use, precision, cancel, gift, defib, rot_l, rot_r, advance).\",\n        args: &[arg(\"slot\", \"integer\", \"seat 1-4 (default 1)\"), arg(\"aim\", \"array\", \"[x, z] on the field\"), arg(\"hold\", \"string\", \"buttons, comma-separated\"), arg(\"tool\", \"integer\", \"ring position 1-8\"), arg(\"ticks\", \"integer\", \"ticks (default 1)\")],\n        run: t_surgeon,\n    },\n    Tool {\n        name: \"room_reload\",''')\ns=s.replace('''fn t_room_reload(s: &mut Session, _: &Args) -> Result<Output> {''','''fn t_case_check(_: &mut Session, a: &Args) -> Result<Output> {\n    use pav_core::games::surgery::content;\n    if let Some(path) = get_str(a, \"path\") {\n        // The file by itself first: its own line numbers.\n        let text = std::fs::read_to_string(path)?;\n        if let Err(e) = toml::from_str::<toml::Table>(&text) {\n            let line = e.span().map(|s| text[..s.start.min(text.len())].lines().count().max(1)).unwrap_or(0);\n            return Ok(Output::Json(json!({ \"ok\": false, \"error\": format!(\"{path} line {line}: {}\", e.message()) })));\n        }\n    }\n    Ok(Output::Json(match content::load() {\n        Err(e) => json!({ \"ok\": false, \"error\": format!(\"{e:#}\") }),\n        Ok(c) => match content::lint(&c) {\n            Ok(()) => json!({ \"ok\": true, \"cases\": c.cases.len(), \"scenes\": c.scenes.len(), \"rigs\": c.rigs.len(), \"sets\": c.sets.len(), \"plates\": c.plates.len() }),\n            Err(list) => json!({ \"ok\": false, \"errors\": list }),\n        },\n    }))\n}\n\nfn t_balance(_: &mut Session, a: &Args) -> Result<Output> {\n    use pav_core::games::Outcome;\n    use pav_core::games::surgery;\n    let seeds = get_u64(a, \"seeds\", 20)?;\n    let skills: Vec<f32> = get_str(a, \"skills\").unwrap_or(\"1.0,0.7,0.4\").split(',').filter_map(|x| x.trim().parse().ok()).collect();\n    let cases: Vec<usize> = get_str(a, \"cases\").map(|c| c.split(',').filter_map(|x| x.trim().parse().ok()).collect()).unwrap_or_else(|| (0..8).collect());\n    let mut out = Vec::new();\n    for case in cases {\n        let mut rows = Vec::new();\n        for &skill in &skills {\n            let (mut wins, mut time, mut vit, mut total) = (0u32, 0.0f32, 0.0f32, 0i64);\n            for seed in 1..=seeds {\n                let mut sim = Sim::new(&format!(\"surgery/case/{case}\"), seed)?;\n                surgery::get_mut(&mut sim).unwrap().bot_skill = skill;\n                let (o, ticks) = sim.run_bot(60 * 60 * 14);\n                if o == Outcome::Won {\n                    wins += 1;\n                    time += ticks as f32 / 60.0;\n                    let g = surgery::get(&sim).unwrap();\n                    if let Some(r) = &g.results {\n                        total += r.total;\n                    }\n                    vit += g.op.as_ref().map(|o| o.vitals).unwrap_or(0.0);\n                }\n            }\n            let w = wins.max(1) as f32;\n            rows.push(json!({ \"skill\": skill, \"wins\": format!(\"{wins}/{seeds}\"), \"secs\": (time / w) as i32, \"vitals\": (vit / w) as i32, \"score\": total / wins.max(1) as i64 }));\n        }\n        let top = rows[0][\"score\"].as_i64().unwrap_or(0);\n        out.push(json!({ \"case\": case, \"suggested_par\": (top as f32 / 1.08 / 100.0).round() * 100.0, \"rows\": rows }));\n    }\n    Ok(Output::Json(json!(out)))\n}\n\nfn t_surgeon(s: &mut Session, a: &Args) -> Result<Output> {\n    use pav_core::input::{SurgeonInput, surgeon_buttons as b};\n    let slot = (get_u64(a, \"slot\", 1)?.clamp(1, 4) - 1) as usize;\n    let aim = vec_arg(a, \"aim\")?;\n    let tool = get_u64(a, \"tool\", 0)? as u8;\n    let n = get_u64(a, \"ticks\", 1)?.max(1);\n    let mut held = 0u8;\n    for name in get_str(a, \"hold\").unwrap_or(\"\").split(',').map(str::trim).filter(|x| !x.is_empty()) {\n        held |= match name {\n            \"use\" => b::USE,\n            \"precision\" => b::PRECISION,\n            \"cancel\" => b::CANCEL,\n            \"gift\" => b::GIFT,\n            \"defib\" => b::DEFIB,\n            \"rot_l\" => b::ROT_L,\n            \"rot_r\" => b::ROT_R,\n            \"advance\" => b::ADVANCE,\n            other => bail!(\"unknown button '{other}'\"),\n        };\n    }\n    for i in 0..n {\n        let mut f = pav_core::InputFrame::default();\n        let target = match (&aim, pav_core::games::surgery::get(&s.sim).and_then(|g| g.op.as_ref())) {\n            (Some(v), _) if v.len() == 2 => glam::Vec2::new(v[0], v[1]),\n            (_, Some(op)) => op.slots[slot].aim,\n            _ => glam::Vec2::ZERO,\n        };\n        f.surgeons[slot] = SurgeonInput {\n            active: true,\n            abs: true,\n            aim: target,\n            held,\n            pressed: if i == 0 { held } else { 0 },\n            tool: if i == 0 { tool } else { 0 },\n            cycle: 0,\n            pressure: 1.0,\n        };\n        s.sim.step(&f);\n        s.sync_camera();\n    }\n    s.keep_events();\n    Ok(Output::Json(s.sim.play().map(|g| g.status(&s.sim)).unwrap_or(json!(null))))\n}\n\nfn t_room_reload(s: &mut Session, _: &Args) -> Result<Output> {''')\nopen(p,'w').write(s)\n\n# web: shim + packer\np='scripts/pack_single_html.py'; s=open(p).read()\ns=s.replace('''    # A manifest is another file to load: the single page goes without one.''','''    # The AI Hub session client (unmodified, first in <head>), its tags, the shim that owns every\n    # AIHub call, and the About block read at boot. See web/session.js and web/hub_shim.js.\n    web = ROOT / \"web\"\n    if (web / \"session.js\").exists():\n        client = (web / \"session.js\").read_text(encoding=\"utf-8\")\n        shim = (web / \"hub_shim.js\").read_text(encoding=\"utf-8\")\n        for name, code in ((\"session.js\", client), (\"hub_shim.js\", shim)):\n            if re.search(r\"(?i)</script|<script|<!--\", code):\n                fail(f\"{name} contains <script, </script or <!--, which can't sit inside an inline script\")\n        tags = (web / \"hub_tags.html\").read_text(encoding=\"utf-8\")\n        page, n = re.subn(r'<meta charset=\"utf-8\">\\\\n',\n            lambda m: m.group(0) + \"<script>\\\\n\" + client + \"\\\\n</script>\\\\n\" + tags + \"<script>\\\\n\" + shim + \"\\\\n</script>\\\\n\",\n            page, count=1)\n        if n != 1:\n            fail(\"no <meta charset> to put the session client after\")\n    about = web / \"about.json\"\n    if about.exists():\n        text = about.read_text(encoding=\"utf-8\").replace(\"<\", \"\\\\\\\\u003c\")\n        page = replace_one(page, r\"</head>\", lambda m: f'<script type=\"application/json\" id=\"about-data\">{text}</script>\\\\n</head>', \"</head>\")\n    # A manifest is another file to load: the single page goes without one.''')\nopen(p,'w').write(s)\np='web/index.html'; s=open(p).read()\ns=s.replace('''  if (!navigator.gpu) {\n    msg.replaceChildren(''','''  if (!navigator.gpu) {\n    if (window.AIHub && AIHub.active) AIHub.fail('This game needs WebGPU.');\n    msg.replaceChildren(''')\nopen(p,'w').write(s)\nEOF\ncp ../tests/hub/session.js web/session.js\ncat > web/hub_tags.html <<'EOF'\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"shared-world\">\n<meta name=\"hub:session-minutes\" content=\"4\">\n<meta name=\"hub:webgpu\" content=\"required\">\n<meta name=\"hub:session-goal\" content=\"Keep the patient alive; the steadiest hands score highest.\">\n<meta name=\"hub:session-howto\" content=\"Aim: right stick or mouse. Operate: R2 or click. Tools: left stick or 1-8.\">\nEOF\ncat > web/hub_shim.js <<'EOF'\n// Owns every AIHub call and queues events; the game polls it each frame. Rust talks to it through\n// window.__hub. Outside a session it does nothing but offer the rumble helper.\nwindow.__rumble = function (i, ms, weak, strong) {\n  try {\n    const p = navigator.getGamepads && navigator.getGamepads()[i];\n    const a = p && p.vibrationActuator;\n    if (a && a.playEffect) a.playEffect('dual-rumble', { duration: ms, weakMagnitude: weak, strongMagnitude: strong });\n  } catch (e) { /* no rumble here */ }\n};\n(function () {\n  const H = window.__hub = { active: !!(window.AIHub && AIHub.active), info: undefined, events: [], last: null, ended: false };\n  if (!H.active) return;\n  AIHub.connect({ mode: 'shared-world', seats: [1, 4], card: true }).then((info) => {\n    H.info = info;\n    if (!info) { H.active = false; return; }      // no hub after all: run as on its own\n    for (const ev of ['card', 'start', 'leave', 'end']) AIHub.on(ev, (d) => { H.events.push([ev, d]); if (ev === 'end') H.ended = true; });\n    AIHub.on('message', (d, from) => H.events.push(['message', d, from]));\n    AIHub.on('time-up', () => {                   // answer now: frames may be slow\n      H.events.push(['time-up', null]);\n      if (AIHub.isHost && !H.done) { H.done = true; AIHub.finish(H.last || { standings: [AIHub.players.map((p) => p.id)], won: false }); }\n    });\n  });\n  addEventListener('keydown', (e) => {\n    if (H.started) return;\n    if (e.key === 'Enter') AIHub.answer('ready');\n    if (e.key === 'm' || e.key === 'M') AIHub.answer('more');\n  }, true);\n  H.infoJson = () => (H.info === undefined ? undefined : JSON.stringify(H.info));\n  H.poll = () => { const a = H.events; H.events = []; for (const e of a) if (e[0] === 'start') H.started = true; return JSON.stringify(a); };\n  H.ready = () => AIHub.ready();\n  H.answer = (what) => { if (!H.started) AIHub.answer(what); };\n  H.time = () => AIHub.time();\n  H.finish = (json) => { if (AIHub.isHost && !H.done && !H.ended) { H.done = true; AIHub.finish(JSON.parse(json)); } };\n  H.send = (json, to) => { if (!H.ended) AIHub.send(JSON.parse(json), { reliable: false, to }); };\n  H.publish = (json) => { H.last = JSON.parse(json); };\n})();\nEOF\ngrep -n \"</head>\" web/index.html; grep -c \"<script\\|</script\\|<!--\" web/session.js; sed -i 's/^use anyhow::{/use anyhow::{/' crates/pav_tools/src/tools.rs; grep -n \"^use anyhow\\|bail\" crates/pav_tools/src/tools.rs | head -3\nJOBS=4 ../tools/cb.sh build -p pav_tools --bin pav 2>&1 | grep -E \"^error|^warning: unused|-->\" -A5 | head -40; ../tools/cb.sh check -p pav_app --target wasm32-unknown-unknown 2>&1 | grep -E \"^error|-->\" -A5 | head -50; git diff --stat Cargo.lock | tail -2","description":"Add tools, page shim and packer; build native and wasm checks","timeout":600000}}}
