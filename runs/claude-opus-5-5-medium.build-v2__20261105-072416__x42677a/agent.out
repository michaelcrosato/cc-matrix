_pre\\|play_post\\|pub fn despawn\\|pub fn say\\|pub fn dt\\|pub fn new\" crates/pav_core/src/sim.rs; grep -n \"game: \" crates/pav_core/src/*.rs | head; grep -n \"\\\"input\\\"\" crates/pav_tools/src/*.rs | head; grep -n \"fn t_input\" -A50 crates/pav_tools/src/tools.rs | head -90; grep -n \"room_check\" crates/pav_tools/src/*.rs | head; cat crates/pav_tools/Cargo.toml","description":"Read view builder emit points, sim frame and input tool"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019tgbSa68DQF3cJpPsPhhXx","type":"tool_result","content":"    /// where it is, its phase.\n    prop_lights: Vec<(LightDef, Vec3, f32)>,\n}\n\n/// Keeps per-region instance caches and short-lived visual effects between frames.\n#[derive(Default)]\npub struct ViewBuilder {\n    static_cache: HashMap<ChunkKey, RegionCache>,\n    effects: Vec<Effect>,\n    /// Wall-clock seconds, drives effects.\n    pub now: f64,\n    /// Particles from events, born in the next built scene.\n    pending_particles: Vec<rs::ParticleBurst>,\n    /// Fractional particles owed per emitter: (object, emitter), where an object's own emitter\n    /// is `u32::MAX` and a prop part's is its index.\n    emit_carry: HashMap<(u32, u32), f32>,\n    /// Meshes generated for prop parts.\n    generated: GeneratedMeshes,\n    /// Shockwaves: centre, radius, start (simulation seconds).\n    shocks: Vec<(Vec3, f32, f32)>,\n    /// Simulation time of the last built scene.\n    last_time: Option<f32>,\n    /// Shardfall drawing state (swing trails, emission carry).\n    arpg: crate::arpg::ArpgView,\n    /// Rippling water surfaces by zone, and dents waiting to drop into them (splashes and\n    /// blasts: centre, radius, depth).\n    water: HashMap<[i32; 6], crate::water::WaterSurface>,\n    water_dents: Vec<(Vec3, f32, f32)>,\n    /// Procedural materials in this view: stable rows, attached to every built scene. Shared\n    /// while a frame is built, so assets drawn from game code (`assets::emit_asset`) use it too.\n    materials: Arc<Mutex<MaterialTable>>,\n}\n\n/// Shortest-arc interpolation of object poses between two frames (both sorted by id).\npub fn interpolate(prev: &RenderFrame, curr: &RenderFrame, alpha: f32) -> Vec<RenderObject> {\n    if prev.live_edit_ticket != curr.live_edit_ticket || prev.studio_mode() != curr.studio_mode() {\n        return curr.objects.clone();\n    }\n    let mut out = Vec::with_capacity(curr.objects.len());\n    let mut j = 0;\n    for o in &curr.objects {\n        while j < prev.objects.len() && prev.objects[j].id < o.id {\n            j += 1;\n        }\n        let mut obj = o.clone();\n        if let Some(p) = prev.objects.get(j).filter(|p| p.id == o.id) {\n            // Large jumps (teleports, respawns) are not smoothed.\n            if p.pos.distance_squared(o.pos) < 4.0 {\n                obj.pos = p.pos.lerp(o.pos, alpha);\n                obj.rot = p.rot.slerp(o.rot, alpha);\n                if let (Some(a), Some(b)) = (&p.soft, &mut obj.soft) {\n                    if a.points.len() == b.points.len() {\n                        for (q, pa) in b.points.iter_mut().zip(&a.points) {\n                            *q = pa.lerp(*q, alpha);\n                        }\n                    }\n                }\n                if let (Some(a), Some(b)) = (&p.puppet, &o.puppet) {\n                    obj.puppet = Some(PuppetFrame {\n                        state: a.state.lerp(&b.state, alpha),\n                        feet_offset: a.feet_offset + (b.feet_offset - a.feet_offset) * alpha,\n                        def: b.def.clone(),\n                        rig: match (&a.rig, &b.rig) {\n                            (Some(ra), Some(rb)) => Some(ra.lerp(rb, alpha)),\n                            _ => b.rig.clone(),\n                        },\n                        tint: b.tint,\n                    });\n                }\n            }\n        }\n        out.push(obj);\n    }\n    out\n}\n\nimpl ViewBuilder {\n    pub fn new() -> Self {\n        Self::default()\n    }\n\n    /// Forget particles owed and pending, so the next scene's emitters start in full swing\n    /// (pair with `Renderer::clear_particles` when the subject changes).\n    pub fn clear_particles(&mut self) {\n        self.emit_carry.clear();\n        self.pending_particles.clear();\n    }\n\n    /// The material table: intern a material here (`MaterialTable::resolve`) and give its\n    /// `MatSlot::param(seed)` to the instances that wear it; every built scene carries the\n    /// table.\n    pub fn materials(&mut self) -> MutexGuard<'_, MaterialTable> {\n        lock(&self.materials)\n    }\n\n    /// Turns simulation events into visual effects (explosions, dust).\n    pub fn add_events(&mut self, events: &[SimEvent]) {\n        for e in events {\n            crate::fx::event_bursts(e, &mut self.pending_particles);\n            if let SimEvent::Explosion { pos, radius } = e {\n                self.shocks.push((*pos, radius * 3.5, self.last_time.unwrap_or(0.0)));\n    pub fn build(\n        &mut self,\n        prev: &RenderFrame,\n        curr: &RenderFrame,\n        alpha: f32,\n        rig: &CameraRig,\n        aspect: f32,\n        settings: &ViewSettings,\n        focus: Vec3,\n    ) -> Scene {\n        let alpha =\n            if prev.live_edit_ticket != curr.live_edit_ticket || prev.studio_mode() != curr.studio_mode() { 1.0 } else { alpha };\n        // Interpolated simulation time: animations and particles move smoothly between ticks.\n        let time = (prev.time + (curr.time - prev.time) * alpha as f64) as f32;\n        let mut scene = Scene { camera: rig.data(aspect), time, ..Default::default() };\n        let _frame = crate::assets::FrameScope::new(settings.style, self.materials.clone());\n        // Screen shake (the game's big hits).\n        if let Some(g) = &curr.game {\n            let off = crate::arpg::shake_offset(g, time);\n            if off != Vec3::ZERO {\n                let mut shaken = rig.clone();\n                shaken.target += off;\n                scene.camera = shaken.data(aspect);\n            }\n        }\n        let since = self.last_time.map(|t| (time - t).max(0.0)).unwrap_or(0.0);\n        let dt = since.min(0.1);\n        self.last_time = Some(time);\n        self.generated.begin_frame();\n        // A workshop edit or reload replaced the library: re-pack the rows it changed.\n        let library = Library::current();\n        {\n            let mut table = lock(&self.materials);\n            table.sync(&library);\n            table.set_detail(settings.material_detail);\n        }\n        scene.post.bloom = settings.bloom;\n        scene.post.bloom_threshold = settings.bloom_threshold;\n        scene.post.distortion = settings.distortion;\n        scene.post.gi = settings.gi;\n        let f = &settings.filter;\n        scene.filter = rs::FilterSettings {\n            pixelate: f.pixelate,\n            curvature: f.curvature,\n            scanlines: f.scanlines,\n            scanline_px: f.scanline_px,\n            dither: f.dither,\n            levels: f.levels,\n            palette: f.palette as u32,\n            split: f.split,\n            temperature: f.temperature,\n            tint: f.tint,\n            contrast: f.contrast,\n            brightness: f.brightness,\n            vignette: f.vignette,\n            grain: f.grain,\n            chroma: f.chroma,\n            saturation: f.saturation,\n            pixel_art: f.pixel_art,\n            pixel_levels: f.pixel_levels,\n            pixel_outline: f.pixel_outline,\n            color_part: f.color_on.part(),\n            grade_part: f.grade_on.part(),\n            scanline_part: f.scanlines_on.part(),\n            grain_part: f.grain_on.part(),\n            chroma_part: f.chroma_on.part(),\n            stylize: f.stylize.stylize(),\n            stylize_size: f.stylize_size,\n            stylize_mix: f.stylize_mix,\n            stylize_color: f.stylize_color,\n            stylize_part: f.stylize_on.part(),\n            ..Default::default()\n        };\n        scene.post.haze = settings.haze;\n        scene.post.haze_height = settings.haze_height;\n        scene.post.shafts = settings.shafts;\n        scene.post.shafts_forward = settings.shafts_forward;\n        scene.post.halos = settings.halos;\n        if settings.particles {\n            scene.particles = std::mem::take(&mut self.pending_particles);\n        } else {\n            self.pending_particles.clear();\n        }\n        self.shocks.retain(|s| time - s.2 < 0.7 && time >= s.2);\n        for &(pos, radius, start) in &self.shocks {\n            scene.distortions.push(rs::Distortion {\n                pos,\n                radius,\n                strength: 0.35,\n                kind: rs::DistortKind::Ring,\n                progress: ((time - start) / 0.7).clamp(0.0, 1.0),\n            });\n        }\n\n        let l = &settings.light;\n        let (el, az) = (l.sun_elevation.to_radians(), l.sun_azimuth.to_radians());\n            }\n        }\n        if let Some(creature) = crate::creatures::interpolate(prev, curr, alpha) {\n            puppets.push(creature.id.0 + 2);\n            if let Err(error) = crate::creatures::emit(&mut scene, &creature, style_of(Look::Lit, settings.style)) {\n                eprintln!(\"creature preview: {error}\");\n            }\n        }\n        self.emit_carry.retain(|(id, _), _| live.contains(id));\n        if let Some(g) = &curr.game {\n            self.arpg.emit(&mut scene, curr, g, alpha, time, dt, settings.particles, cam_fwd);\n        }\n        // Projectiles: drawn where they are between ticks (they move in straight lines).\n        let back = (1.0 - alpha) * curr.dt;\n        for p in &curr.projectiles {\n            let mut sd = SdfInstance::sphere(p.pos - p.vel * back, p.radius, v3(p.color));\n            sd.style = Style::Unlit;\n            sd.emissive = 0.6;\n            sd.flags = rs::flags::NO_SHADOW | rs::flags::NO_CUT;\n            sd.group = 0x7f1;\n            scene.sdfs.push(sd);\n        builder.emit_prop(&mut scene, o, o.prop.as_ref().unwrap(), &ViewSettings::default(), 0.0, 0.0);\n        scene\n    }\n\n    #[test]\n    fn format1_props_draw_exactly_what_format1_drew() {\n        let mut assets: Vec<PropAsset> = [\"box\", \"crate\", \"bench\", \"lantern\"]\n            .map(|name| (**props::get(&format!(\"BUILTIN/{name}\")).unwrap().v1.as_ref().unwrap()).clone())\n            .into();\n        for text in [\n            include_str!(\"../../pav_core/tests/fixtures/props/dogfood_stall_v1.json\"),\n            include_str!(\"../../pav_core/tests/fixtures/props/dogfood_well_v1.json\"),\n        ] {\n            assets.push(PropAsset::parse(text).unwrap());\n        }\n        let poses = [\n            (1.0, Vec3::ZERO, Quat::IDENTITY),\n            (0.37, Vec3::new(1.5, 0.25, -2.0), Quat::from_rotation_y(0.7)),\n            (2.5, Vec3::new(-3.0, 1.0, 4.0), Quat::from_euler(glam::EulerRot::YXZ, 1.1, 0.2, -0.3)),\n        ];\n        for asset in assets {\n            let def = Arc::new(PropDef::from_v1(Arc::new(asset.clone())).unwrap());\n            for (scale, pos, rot) in poses {\n                let o = object(def.clone(), scale, pos, rot);\n                // What format 1 drew before props compiled.\n                let mut format1 = Scene::default();\n                for part in asset.parts.values() {\n                    let visual = part.visual(scale);\n                    emit_shape(\n                        &mut format1.meshes,\n                        &mut format1.sdfs,\n                        &mut format1.point_lights,\n                        &visual.shape,\n                        o.pos + o.rot * (part.pos * scale),\n                        o.rot * part.rotation(),\n                        v3(visual.color),\n                        visual.emissive,\n                        style_of(visual.look, StyleOverride::PerObject),\n                        o.id.0 + 2,\n                        0,\n                        0,\n                    );\n                }\n                let compiled = draw(&mut ViewBuilder::default(), &o);\n                let name = &asset.name;\n                assert_eq!(format!(\"{:?}\", compiled.meshes), format!(\"{:?}\", format1.meshes), \"{name} at {scale}\");\n                assert_eq!(format!(\"{:?}\", compiled.sdfs), format!(\"{:?}\", format1.sdfs), \"{name} at {scale}\");\n                assert_eq!(format!(\"{:?}\", compiled.point_lights), format!(\"{:?}\", format1.point_lights), \"{name} at {scale}\");\n                assert!(compiled.custom_meshes.is_empty() && compiled.particles.is_empty());\n            }\n        }\n    }\n\n    #[test]\n    fn materials_reach_the_instances() {\n        let barrel = include_str!(\"../../pav_core/tests/fixtures/props/materials/banded_barrel.json\");\n        let mut text = barrel.replace(r#\"\"lid\":\"MAT/oak_planks\"\"#, r##\"\"lid\":{\"base\":\"MAT/oak_planks\",\"color\":\"#7a5030\"}\"##);\n        text = text.replace(r#\"\"pos\":[14,91,6],\"mat\":\"iron\"}\"#, r##\"\"pos\":[14,91,6],\"mat\":\"iron\",\"color\":\"#202020\"}\"##);\n        let def = Arc::new(PropDef::new(Doc::read(&text).unwrap()).unwrap());\n        let mut builder = ViewBuilder::default();\n        let o = object(def.clone(), 1.0, Vec3::ZERO, Quat::IDENTITY);\n        let mut scene = draw(&mut builder, &o);\n        lock(&builder.materials).attach(&mut scene);\n        let rows = scene.materials.clone();\n        let words: Vec<u32> = scene.meshes.iter().map(|m| m.material).collect();\n        assert_eq!(words.len(), 5, \"body, bung, two hoops, lid\");\n        let library = Library::current();\n        for (index, (part, mesh)) in def.compiled.parts.iter().zip(&scene.meshes).enumerate() {\n            let slot = mesh.material & 0xfff;\n            assert_ne!(slot, 0, \"{} wears a patterned material\", part.id);\n            assert_eq!(mesh.material >> 12, materials::seed(o.id.0, index as u32), \"{}: seeded by (entity, part)\", part.id);\ncrates/pav_core/src/animation_preview.rs:287:    pub(crate) fn frame(&self, config: Arc<SimConfig>, dt: f32, ticket: u64) -> RenderFrame {\ncrates/pav_core/src/animation_preview.rs-288-        let info = self.info();\ncrates/pav_core/src/animation_preview.rs-289-        let mut objects = stage_objects();\ncrates/pav_core/src/animation_preview.rs-290-        let subject = EntityId(STAGE_ID_BASE);\ncrates/pav_core/src/animation_preview.rs-291-        objects.push(RenderObject {\ncrates/pav_core/src/animation_preview.rs-292-            id: subject,\ncrates/pav_core/src/animation_preview.rs-293-            pos: Vec3::ZERO,\n--\ncrates/pav_core/src/animation_preview.rs:311:        RenderFrame {\ncrates/pav_core/src/animation_preview.rs-312-            tick: self.ticks,\ncrates/pav_core/src/animation_preview.rs-313-            time: info.time as f64,\ncrates/pav_core/src/animation_preview.rs-314-            dt,\ncrates/pav_core/src/animation_preview.rs-315-            live_edit_ticket: ticket,\ncrates/pav_core/src/animation_preview.rs-316-            objects,\ncrates/pav_core/src/animation_preview.rs-317-            statics: Default::default(),\ncrates/pav_core/src/creature_preview.rs:272:    pub(crate) fn frame(&self, config: Arc<SimConfig>, dt: f32, ticket: u64) -> RenderFrame {\ncrates/pav_core/src/creature_preview.rs-273-        let subject = EntityId(STAGE_ID_BASE);\ncrates/pav_core/src/creature_preview.rs-274-        let mut frame = empty_frame(config, dt, ticket);\ncrates/pav_core/src/creature_preview.rs-275-        frame.tick = self.ticks;\ncrates/pav_core/src/creature_preview.rs-276-        frame.time = self.time as f64;\ncrates/pav_core/src/creature_preview.rs-277-        frame.focus = self.focus;\ncrates/pav_core/src/creature_preview.rs-278-        frame.player = Some(subject);\n--\ncrates/pav_core/src/creature_preview.rs:296:pub(crate) fn empty_frame(config: Arc<SimConfig>, dt: f32, ticket: u64) -> RenderFrame {\ncrates/pav_core/src/creature_preview.rs:297:    RenderFrame {\ncrates/pav_core/src/creature_preview.rs-298-        tick: 0,\ncrates/pav_core/src/creature_preview.rs-299-        time: 0.0,\ncrates/pav_core/src/creature_preview.rs-300-        dt,\ncrates/pav_core/src/creature_preview.rs-301-        live_edit_ticket: ticket,\ncrates/pav_core/src/creature_preview.rs-302-        objects: stage_objects(),\ncrates/pav_core/src/creature_preview.rs-303-        statics: Default::default(),\ncrates/pav_core/src/prop_preview.rs:239:    pub(crate) fn frame(&self, config: Arc<SimConfig>, dt: f32, ticket: u64) -> RenderFrame {\ncrates/pav_core/src/prop_preview.rs-240-        self.frame_of(props::get(&self.name), Default::default(), config, dt, ticket)\ncrates/pav_core/src/prop_preview.rs-241-    }\ncrates/pav_core/src/prop_preview.rs-242-\ncrates/pav_core/src/prop_preview.rs-243-    fn frame_of(\ncrates/pav_core/src/prop_preview.rs-244-        &self,\ncrates/pav_core/src/prop_preview.rs-245-        definition: Option<Arc<props::PropDef>>,\n--\ncrates/pav_core/src/prop_preview.rs:250:    ) -> RenderFrame {\n222:    pub fn new(scene: &str, seed: u64) -> Result<Self> {\n238:    pub fn dt(&self) -> f32 {\n432:    pub fn despawn(&mut self, id: EntityId) -> bool {\n488:    pub fn step(&mut self, input: &InputFrame) {\n711:        self.play_post(dt, &mut events);\n941:    pub fn frame(&mut self) -> RenderFrame {\ncrates/pav_core/src/prop_preview.rs:295:            game: None,\ncrates/pav_core/src/creature_preview.rs:313:        game: None,\ncrates/pav_core/src/animation_preview.rs:327:            game: None,\ncrates/pav_core/src/frame.rs:294:    pub game: Option<std::sync::Arc<crate::arpg::GameFrame>>,\ncrates/pav_core/src/room.rs:335:    pub game: toml::Table,\ncrates/pav_core/src/sim.rs:131:    pub game: Option<Box<crate::arpg::Game>>,\ncrates/pav_core/src/sim.rs:202:                game: None,\ncrates/pav_core/src/sim.rs:1071:            game: self.state.game.as_ref().map(|g| std::sync::Arc::new(g.frame(self))),\ncrates/pav_tools/src/tools.rs:108:        name: \"input\",\n1358:fn t_input(s: &mut Session, a: &Args) -> Result<Output> {\n1359-    let mv = vec_arg(a, \"move\")?.unwrap_or_default();\n1360-    let dir = glam::Vec2::new(mv.first().copied().unwrap_or(0.0), mv.get(1).copied().unwrap_or(0.0));\n1361-    let held = buttons_arg(a, \"hold\")?;\n1362-    let press = buttons_arg(a, \"press\")?;\n1363-    let aim = vec_arg(a, \"aim\")?.filter(|v| v.len() == 3).map(|v| glam::Vec3::new(v[0], v[1], v[2]));\n1364-    let n = get_u64(a, \"ticks\", 1)?.max(1);\n1365-    for i in 0..n {\n1366-        let f = pav_core::InputFrame {\n1367-            move_dir: dir.clamp_length_max(1.0),\n1368-            vertical: 0.0,\n1369-            aim,\n1370-            held: held | if i == 0 { press } else { 0 },\n1371-            pressed: if i == 0 { press } else { 0 },\n1372-            cmd: None,\n1373-        };\n1374-        s.sim.step(&f);\n1375-        s.sync_camera();\n1376-    }\n1377-    s.keep_events();\n1378-    Ok(Output::Json(player_json(s)))\n1379-}\n1380-\n1381-fn t_spawn(s: &mut Session, a: &Args) -> Result<Output> {\n1382-    use pav_core::{BodyKind, Color, Shape, Spawn, Visual};\n1383-    let size = vec_arg(a, \"size\")?.unwrap_or_default();\n1384-    let g = |i: usize, d: f32| size.get(i).copied().unwrap_or(d);\n1385-    let shape = match get_str(a, \"shape\").unwrap_or(\"box\") {\n1386-        \"box\" => Shape::Box { half: glam::Vec3::new(g(0, 0.4), g(1, g(0, 0.4)), g(2, g(0, 0.4))) },\n1387-        \"rounded_box\" => Shape::RoundedBox { half: glam::Vec3::new(g(0, 0.4), g(1, g(0, 0.4)), g(2, g(0, 0.4))), radius: 0.1 },\n1388-        \"sphere\" => Shape::Sphere { radius: g(0, 0.4) },\n1389-        \"capsule\" => Shape::Capsule { half_height: g(0, 0.3), radius: g(1, 0.25) },\n1390-        \"cylinder\" => Shape::Cylinder { half_height: g(0, 0.4), radius: g(1, 0.3) },\n1391-        other => bail!(\"unknown shape '{other}'\"),\n1392-    };\n1393-    let pos = vec_arg(a, \"pos\")?.filter(|v| v.len() == 3).map(|v| glam::Vec3::new(v[0], v[1], v[2]));\n1394-    let pos = pos.unwrap_or_else(|| s.sim.state.focus + glam::Vec3::new(0.0, 3.0, 0.0));\n1395-    let body = match get_str(a, \"body\").unwrap_or(\"dynamic\") {\n1396-        \"dynamic\" => BodyKind::Dynamic,\n1397-        \"fixed\" => BodyKind::Fixed,\n1398-        \"kinematic\" => BodyKind::Kinematic,\n1399-        \"none\" => BodyKind::None,\n1400-        other => bail!(\"unknown body '{other}'\"),\n1401-    };\n1402-    let color = Color::try_hex(get_str(a, \"color\").unwrap_or(\"#e8704a\")).context(\"color must be #rrggbb\")?;\n1403-    let id = s.sim.spawn(Spawn::new(get_str(a, \"name\").unwrap_or(\"prop\"), pos).visual(Visual::new(shape, color)).body(body));\n1404-    Ok(Output::Json(json!({ \"id\": id.0 })))\n1405-}\n1406-\n1407-fn t_despawn(s: &mut Session, a: &Args) -> Result<Output> {\n1408-    let id = pav_core::EntityId(get_u64(a, \"id\", 0)? as u32);\ncrates/pav_tools/src/tools.rs:188:        name: \"room_check\",\ncrates/pav_tools/src/tools.rs:191:        run: t_room_check,\ncrates/pav_tools/src/tools.rs:1585:fn t_room_check(_: &mut Session, a: &Args) -> Result<Output> {\n[package]\nname = \"pav_tools\"\nversion.workspace = true\nedition.workspace = true\npublish.workspace = true\n\n[dependencies]\npav_core.workspace = true\npav_render.workspace = true\npav_view.workspace = true\npav_audio.workspace = true\npav_ui.workspace = true\negui.workspace = true\nglam.workspace = true\nserde.workspace = true\nserde_json.workspace = true\nanyhow.workspace = true\nlibm.workspace = true\nminiz_oxide.workspace = true\nlog.workspace = true\npng.workspace = true\ntobj.workspace = true\ntoml.workspace = true\n\n[lints]\nworkspace = true","is_error":false}]},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"0a0a66b9-ff81-46a0-900e-d0c7bf599c9b","timestamp":"2026-11-05T14:25:50.402Z","tool_use_result":{"stdout":"    /// where it is, its phase.\n    prop_lights: Vec<(LightDef, Vec3, f32)>,\n}\n\n/// Keeps per-region instance caches and short-lived visual effects between frames.\n#[derive(Default)]\npub struct ViewBuilder {\n    static_cache: HashMap<ChunkKey, RegionCache>,\n    effects: Vec<Effect>,\n    /// Wall-clock seconds, drives effects.\n    pub now: f64,\n    /// Particles from events, born in the next built scene.\n    pending_particles: Vec<rs::ParticleBurst>,\n    /// Fractional particles owed per emitter: (object, emitter), where an object's own emitter\n    /// is `u32::MAX` and a prop part's is its index.\n    emit_carry: HashMap<(u32, u32), f32>,\n    /// Meshes generated for prop parts.\n    generated: GeneratedMeshes,\n    /// Shockwaves: centre, radius, start (simulation seconds).\n    shocks: Vec<(Vec3, f32, f32)>,\n    /// Simulation time of the last built scene.\n    last_time: Option<f32>,\n    /// Shardfall drawing state (swing trails, emission carry).\n    arpg: crate::arpg::ArpgView,\n    /// Rippling water surfaces by zone, and dents waiting to drop into them (splashes and\n    /// blasts: centre, radius, depth).\n    water: HashMap<[i32; 6], crate::water::WaterSurface>,\n    water_dents: Vec<(Vec3, f32, f32)>,\n    /// Procedural materials in this view: stable rows, attached to every built scene. Shared\n    /// while a frame is built, so assets drawn from game code (`assets::emit_asset`) use it too.\n    materials: Arc<Mutex<MaterialTable>>,\n}\n\n/// Shortest-arc interpolation of object poses between two frames (both sorted by id).\npub fn interpolate(prev: &RenderFrame, curr: &RenderFrame, alpha: f32) -> Vec<RenderObject> {\n    if prev.live_edit_ticket != curr.live_edit_ticket || prev.studio_mode() != curr.studio_mode() {\n        return curr.objects.clone();\n    }\n    let mut out = Vec::with_capacity(curr.objects.len());\n    let mut j = 0;\n    for o in &curr.objects {\n        while j < prev.objects.len() && prev.objects[j].id < o.id {\n            j += 1;\n        }\n        let mut obj = o.clone();\n        if let Some(p) = prev.objects.get(j).filter(|p| p.id == o.id) {\n            // Large jumps (teleports, respawns) are not smoothed.\n            if p.pos.distance_squared(o.pos) < 4.0 {\n                obj.pos = p.pos.lerp(o.pos, alpha);\n                obj.rot = p.rot.slerp(o.rot, alpha);\n                if let (Some(a), Some(b)) = (&p.soft, &mut obj.soft) {\n                    if a.points.len() == b.points.len() {\n                        for (q, pa) in b.points.iter_mut().zip(&a.points) {\n                            *q = pa.lerp(*q, alpha);\n                        }\n                    }\n                }\n                if let (Some(a), Some(b)) = (&p.puppet, &o.puppet) {\n                    obj.puppet = Some(PuppetFrame {\n                        state: a.state.lerp(&b.state, alpha),\n                        feet_offset: a.feet_offset + (b.feet_offset - a.feet_offset) * alpha,\n                        def: b.def.clone(),\n                        rig: match (&a.rig, &b.rig) {\n                            (Some(ra), Some(rb)) => Some(ra.lerp(rb, alpha)),\n                            _ => b.rig.clone(),\n                        },\n                        tint: b.tint,\n                    });\n                }\n            }\n        }\n        out.push(obj);\n    }\n    out\n}\n\nimpl ViewBuilder {\n    pub fn new() -> Self {\n        Self::default()\n    }\n\n    /// Forget particles owed and pending, so the next scene's emitters start in full swing\n    /// (pair with `Renderer::clear_particles` when the subject changes).\n    pub fn clear_particles(&mut self) {\n        self.emit_carry.clear();\n        self.pending_particles.clear();\n    }\n\n    /// The material table: intern a material here (`MaterialTable::resolve`) and give its\n    /// `MatSlot::param(seed)` to the instances that wear it; every built scene carries the\n    /// table.\n    pub fn materials(&mut self) -> MutexGuard<'_, MaterialTable> {\n        lock(&self.materials)\n    }\n\n    /// Turns simulation events into visual effects (explosions, dust).\n    pub fn add_events(&mut self, events: &[SimEvent]) {\n        for e in events {\n            crate::fx::event_bursts(e, &mut self.pending_particles);\n            if let SimEvent::Explosion { pos, radius } = e {\n                self.shocks.push((*pos, radius * 3.5, self.last_time.unwrap_or(0.0)));\n    pub fn build(\n        &mut self,\n        prev: &RenderFrame,\n        curr: &RenderFrame,\n        alpha: f32,\n        rig: &CameraRig,\n        aspect: f32,\n        settings: &ViewSettings,\n        focus: Vec3,\n    ) -> Scene {\n        let alpha =\n            if prev.live_edit_ticket != curr.live_edit_ticket || prev.studio_mode() != curr.studio_mode() { 1.0 } else { alpha };\n        // Interpolated simulation time: animations and particles move smoothly between ticks.\n        let time = (prev.time + (curr.time - prev.time) * alpha as f64) as f32;\n        let mut scene = Scene { camera: rig.data(aspect), time, ..Default::default() };\n        let _frame = crate::assets::FrameScope::new(settings.style, self.materials.clone());\n        // Screen shake (the game's big hits).\n        if let Some(g) = &curr.game {\n            let off = crate::arpg::shake_offset(g, time);\n            if off != Vec3::ZERO {\n                let mut shaken = rig.clone();\n                shaken.target += off;\n                scene.camera = shaken.data(aspect);\n            }\n        }\n        let since = self.last_time.map(|t| (time - t).max(0.0)).unwrap_or(0.0);\n        let dt = since.min(0.1);\n        self.last_time = Some(time);\n        self.generated.begin_frame();\n        // A workshop edit or reload replaced the library: re-pack the rows it changed.\n        let library = Library::current();\n        {\n            let mut table = lock(&self.materials);\n            table.sync(&library);\n            table.set_detail(settings.material_detail);\n        }\n        scene.post.bloom = settings.bloom;\n        scene.post.bloom_threshold = settings.bloom_threshold;\n        scene.post.distortion = settings.distortion;\n        scene.post.gi = settings.gi;\n        let f = &settings.filter;\n        scene.filter = rs::FilterSettings {\n            pixelate: f.pixelate,\n            curvature: f.curvature,\n            scanlines: f.scanlines,\n            scanline_px: f.scanline_px,\n            dither: f.dither,\n            levels: f.levels,\n            palette: f.palette as u32,\n            split: f.split,\n            temperature: f.temperature,\n            tint: f.tint,\n            contrast: f.contrast,\n            brightness: f.brightness,\n            vignette: f.vignette,\n            grain: f.grain,\n            chroma: f.chroma,\n            saturation: f.saturation,\n            pixel_art: f.pixel_art,\n            pixel_levels: f.pixel_levels,\n            pixel_outline: f.pixel_outline,\n            color_part: f.color_on.part(),\n            grade_part: f.grade_on.part(),\n            scanline_part: f.scanlines_on.part(),\n            grain_part: f.grain_on.part(),\n            chroma_part: f.chroma_on.part(),\n            stylize: f.stylize.stylize(),\n            stylize_size: f.stylize_size,\n            stylize_mix: f.stylize_mix,\n            stylize_color: f.stylize_color,\n            stylize_part: f.stylize_on.part(),\n            ..Default::default()\n        };\n        scene.post.haze = settings.haze;\n        scene.post.haze_height = settings.haze_height;\n        scene.post.shafts = settings.shafts;\n        scene.post.shafts_forward = settings.shafts_forward;\n        scene.post.halos = settings.halos;\n        if settings.particles {\n            scene.particles = std::mem::take(&mut self.pending_particles);\n        } else {\n            self.pending_particles.clear();\n        }\n        self.shocks.retain(|s| time - s.2 < 0.7 && time >= s.2);\n        for &(pos, radius, start) in &self.shocks {\n            scene.distortions.push(rs::Distortion {\n                pos,\n                radius,\n                strength: 0.35,\n                kind: rs::DistortKind::Ring,\n                progress: ((time - start) / 0.7).clamp(0.0, 1.0),\n            });\n        }\n\n        let l = &settings.light;\n        let (el, az) = (l.sun_elevation.to_radians(), l.sun_azimuth.to_radians());\n            }\n        }\n        if let Some(creature) = crate::creatures::interpolate(prev, curr, alpha) {\n            puppets.push(creature.id.0 + 2);\n            if let Err(error) = crate::creatures::emit(&mut scene, &creature, style_of(Look::Lit, settings.style)) {\n                eprintln!(\"creature preview: {error}\");\n            }\n        }\n        self.emit_carry.retain(|(id, _), _| live.contains(id));\n        if let Some(g) = &curr.game {\n            self.arpg.emit(&mut scene, curr, g, alpha, time, dt, settings.particles, cam_fwd);\n        }\n        // Projectiles: drawn where they are between ticks (they move in straight lines).\n        let back = (1.0 - alpha) * curr.dt;\n        for p in &curr.projectiles {\n            let mut sd = SdfInstance::sphere(p.pos - p.vel * back, p.radius, v3(p.color));\n            sd.style = Style::Unlit;\n            sd.emissive = 0.6;\n            sd.flags = rs::flags::NO_SHADOW | rs::flags::NO_CUT;\n            sd.group = 0x7f1;\n            scene.sdfs.push(sd);\n        builder.emit_prop(&mut scene, o, o.prop.as_ref().unwrap(), &ViewSettings::default(), 0.0, 0.0);\n        scene\n    }\n\n    #[test]\n    fn format1_props_draw_exactly_what_format1_drew() {\n        let mut assets: Vec<PropAsset> = [\"box\", \"crate\", \"bench\", \"lantern\"]\n            .map(|name| (**props::get(&format!(\"BUILTIN/{name}\")).unwrap().v1.as_ref().unwrap()).clone())\n            .into();\n        for text in [\n            include_str!(\"../../pav_core/tests/fixtures/props/dogfood_stall_v1.json\"),\n            include_str!(\"../../pav_core/tests/fixtures/props/dogfood_well_v1.json\"),\n        ] {\n            assets.push(PropAsset::parse(text).unwrap());\n        }\n        let poses = [\n            (1.0, Vec3::ZERO, Quat::IDENTITY),\n            (0.37, Vec3::new(1.5, 0.25, -2.0), Quat::from_rotation_y(0.7)),\n            (2.5, Vec3::new(-3.0, 1.0, 4.0), Quat::from_euler(glam::EulerRot::YXZ, 1.1, 0.2, -0.3)),\n        ];\n        for asset in assets {\n            let def = Arc::new(PropDef::from_v1(Arc::new(asset.clone())).unwrap());\n            for (scale, pos, rot) in poses {\n                let o = object(def.clone(), scale, pos, rot);\n                // What format 1 drew before props compiled.\n                let mut format1 = Scene::default();\n                for part in asset.parts.values() {\n                    let visual = part.visual(scale);\n                    emit_shape(\n                        &mut format1.meshes,\n                        &mut format1.sdfs,\n                        &mut format1.point_lights,\n                        &visual.shape,\n                        o.pos + o.rot * (part.pos * scale),\n                        o.rot * part.rotation(),\n                        v3(visual.color),\n                        visual.emissive,\n                        style_of(visual.look, StyleOverride::PerObject),\n                        o.id.0 + 2,\n                        0,\n                        0,\n                    );\n                }\n                let compiled = draw(&mut ViewBuilder::default(), &o);\n                let name = &asset.name;\n                assert_eq!(format!(\"{:?}\", compiled.meshes), format!(\"{:?}\", format1.meshes), \"{name} at {scale}\");\n                assert_eq!(format!(\"{:?}\", compiled.sdfs), format!(\"{:?}\", format1.sdfs), \"{name} at {scale}\");\n                assert_eq!(format!(\"{:?}\", compiled.point_lights), format!(\"{:?}\", format1.point_lights), \"{name} at {scale}\");\n                assert!(compiled.custom_meshes.is_empty() && compiled.particles.is_empty());\n            }\n        }\n    }\n\n    #[test]\n    fn materials_reach_the_instances() {\n        let barrel = include_str!(\"../../pav_core/tests/fixtures/props/materials/banded_barrel.json\");\n        let mut text = barrel.replace(r#\"\"lid\":\"MAT/oak_planks\"\"#, r##\"\"lid\":{\"base\":\"MAT/oak_planks\",\"color\":\"#7a5030\"}\"##);\n        text = text.replace(r#\"\"pos\":[14,91,6],\"mat\":\"iron\"}\"#, r##\"\"pos\":[14,91,6],\"mat\":\"iron\",\"color\":\"#202020\"}\"##);\n        let def = Arc::new(PropDef::new(Doc::read(&text).unwrap()).unwrap());\n        let mut builder = ViewBuilder::default();\n        let o = object(def.clone(), 1.0, Vec3::ZERO, Quat::IDENTITY);\n        let mut scene = draw(&mut builder, &o);\n        lock(&builder.materials).attach(&mut scene);\n        let rows = scene.materials.clone();\n        let words: Vec<u32> = scene.meshes.iter().map(|m| m.material).collect();\n        assert_eq!(words.len(), 5, \"body, bung, two hoops, lid\");\n        let library = Library::current();\n        for (index, (part, mesh)) in def.compiled.parts.iter().zip(&scene.meshes).enumerate() {\n            let slot = mesh.material & 0xfff;\n            assert_ne!(slot, 0, \"{} wears a patterned material\", part.id);\n            assert_eq!(mesh.material >> 12, materials::seed(o.id.0, index as u32), \"{}: seeded by (entity, part)\", part.id);\ncrates/pav_core/src/animation_preview.rs:287:    pub(crate) fn frame(&self, config: Arc<SimConfig>, dt: f32, ticket: u64) -> RenderFrame {\ncrates/pav_core/src/animation_preview.rs-288-        let info = self.info();\ncrates/pav_core/src/animation_preview.rs-289-        let mut objects = stage_objects();\ncrates/pav_core/src/animation_preview.rs-290-        let subject = EntityId(STAGE_ID_BASE);\ncrates/pav_core/src/animation_preview.rs-291-        objects.push(RenderObject {\ncrates/pav_core/src/animation_preview.rs-292-            id: subject,\ncrates/pav_core/src/animation_preview.rs-293-            pos: Vec3::ZERO,\n--\ncrates/pav_core/src/animation_preview.rs:311:        RenderFrame {\ncrates/pav_core/src/animation_preview.rs-312-            tick: self.ticks,\ncrates/pav_core/src/animation_preview.rs-313-            time: info.time as f64,\ncrates/pav_core/src/animation_preview.rs-314-            dt,\ncrates/pav_core/src/animation_preview.rs-315-            live_edit_ticket