rep -n '\"capture\"\\|\"filmstrip\"\\|fn t_capture' crates/pav_tools/src/*.rs | head; tail -1 ../build0.log","description":"Read the starter bot, level format and scene loading"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SGQRtLrtq3ur9LHhJ75ipb","type":"tool_result","content":"        if self.outcome != Outcome::Playing {\n            // Decided: everyone stands still.\n            for &id in sim.state.player.iter().chain(&self.slimes) {\n                out.insert(id, InputFrame::default());\n            }\n            return out;\n        }\n        if self.nav.is_none() {\n            self.nav = NavGrid::for_room(sim).map(Arc::new);\n        }\n        let Some(nav) = self.nav.clone() else { return out };\n        // One flow field toward the player steers every slime round the walls.\n        let player = sim.state.player.and_then(|id| sim.feet(id));\n        let field = player.filter(|_| self.grace <= 0.0).and_then(|p| nav.flow(p, self.rules.slime_sight));\n        for (&id, &speed) in self.slimes.iter().zip(&self.speeds) {\n            let mut input = InputFrame::default();\n            if let (Some(field), Some(at)) = (&field, sim.feet(id))\n                && let Some(d) = field.dir(&nav, at)\n            {\n                input.move_dir = Vec2::new(d.x, d.z) * speed;\n            }\n            out.insert(id, input);\n        }\n        out\n    }\n\n    fn post(&mut self, sim: &mut Sim, dt: f32, events: &mut Vec<SimEvent>) {\n        if self.outcome != Outcome::Playing {\n            return;\n        }\n        self.time += dt;\n        self.grace = (self.grace - dt).max(0.0);\n        let Some(pid) = sim.state.player else { return };\n        let Some(p) = sim.feet(pid) else { return };\n\n        // Shards: walk over one to pick it up.\n        let near: Vec<(EntityId, Vec3)> = self\n            .shards\n            .iter()\n            .filter_map(|&id| sim.state.entities.get(id).map(|e| (id, e.pos)))\n            .filter(|(_, at)| flat(*at - p) < self.rules.pick)\n            .collect();\n        for (id, at) in near {\n            self.shards.retain(|&s| s != id);\n            sim.despawn(id);\n            events.push(SimEvent::Coin { pos: at });\n            let left = self.shards.len();\n            sim.say(if left == 1 { \"1 shard to go\".to_string() } else { format!(\"{left} shards to go\") });\n        }\n        if self.shards.is_empty() {\n            self.outcome = Outcome::Won;\n            sim.say(format!(\"All shards in {:.1} s!\", self.time));\n            return;\n        }\n\n        // Slimes: a touch costs a life and sends everyone back to the start.\n        let catch = self.rules.catch;\n        let caught = self.grace <= 0.0 && self.slimes.iter().any(|&id| sim.feet(id).is_some_and(|s| flat(s - p) < catch));\n        if caught {\n            self.lives -= 1;\n            events.push(SimEvent::Hit { pos: p + Vec3::Y, strength: 1.0, target: Some(pid) });\n            if self.lives == 0 {\n                self.outcome = Outcome::Lost;\n                sim.say(\"Caught! Game over\");\n                return;\n            }\n            sim.say(format!(\"Caught! {} lives left\", self.lives));\n            let spawn = sim.state.spawn;\n            sim.set_position(pid, spawn);\n            for (&id, &home) in self.slimes.iter().zip(&self.homes) {\n                sim.set_position(id, home);\n            }\n            self.grace = self.rules.grace;\n        }\n    }\n\n    fn hud(&self, _sim: &Sim) -> Vec<String> {\n        let mut lines =\n            vec![format!(\"Shards {}/{}\", self.total - self.shards.len(), self.total), format!(\"Lives {}\", self.lives)];\n        match self.outcome {\n            Outcome::Won => lines.push(format!(\"You win! {:.1} s\", self.time)),\n            Outcome::Lost => lines.push(\"Game over\".into()),\n            Outcome::Playing => {}\n        }\n        lines\n    }\n\n    fn status(&self, sim: &Sim) -> serde_json::Value {\n        let xz = |id: EntityId| sim.feet(id).map(|f| [round(f.x), round(f.z)]);\n        json!({\n            \"outcome\": self.outcome,\n            \"time\": round(self.time),\n            \"shards_left\": self.shards.len(),\n            \"total\": self.total,\n            \"lives\": self.lives,\n            \"grace\": round(self.grace),\n            \"player\": sim.state.player.and_then(xz),\n            \"shards\": self.shards.iter().filter_map(|&id| sim.state.entities.get(id).map(|e| [round(e.pos.x), round(e.pos.z)])).collect::<Vec<_>>(),\n            \"slimes\": self.slimes.iter().filter_map(|&id| xz(id)).collect::<Vec<_>>(),\n        })\n    }\n\n    fn outcome(&self) -> Outcome {\n        self.outcome\n    }\n\n    /// Takes the shortest walk to a shard that keeps clear of slimes (cells near them count\n    /// as walls); with every shard cut off, makes for the reachable spot farthest from them.\n    fn bot(&self, sim: &Sim) -> InputFrame {\n        let mut input = InputFrame::default();\n        let Some(p) = sim.state.player.and_then(|id| sim.feet(id)) else { return input };\n        let Some(mut grid) = self.nav.as_deref().cloned().or_else(|| NavGrid::for_room(sim)) else { return input };\n        let slimes: Vec<Vec3> = self.slimes.iter().filter_map(|&id| sim.feet(id)).collect();\n        if self.grace < 0.5 {\n            for i in 0..grid.blocked.len() {\n                if slimes.iter().any(|&s| flat(grid.center(i) - s) < 1.8) {\n                    grid.blocked[i] = true;\n                }\n            }\n        }\n        let paths = self.shards.iter().filter_map(|&id| sim.state.entities.get(id)).filter_map(|e| grid.path(p, e.pos));\n        let path = paths.min_by(|a, b| length(p, a).total_cmp(&length(p, b))).or_else(|| {\n            let clearance = |i: usize| slimes.iter().map(|&s| flat(grid.center(i) - s)).fold(f32::MAX, f32::min);\n            let reach = grid.flow(p, 6.0)?;\n            let safest = (0..grid.blocked.len())\n                .filter(|&i| reach.dist[i].is_finite())\n                .max_by(|&a, &b| clearance(a).total_cmp(&clearance(b)))?;\n            grid.path(p, grid.center(safest))\n        });\n        input.move_dir = path.map(|path| flat_dir(path[0] - p)).unwrap_or_default();\n        input\n    }\n}\n\nfn flat(v: Vec3) -> f32 {\n    Vec2::new(v.x, v.z).length()\n}\n\nfn flat_dir(v: Vec3) -> Vec2 {\n    Vec2::new(v.x, v.z).normalize_or_zero()\n}\n\n/// Walking length of a path from `p`.\nfn length(p: Vec3, path: &[Vec3]) -> f32 {\n    let (mut at, mut sum) = (p, 0.0);\n    for &q in path {\n        sum += flat(q - at);\n        at = q;\n    }\n    sum\n}\n\nfn round(x: f32) -> f64 {\n    (x as f64 * 100.0).round() / 100.0\n}\n# The starter game's level: a room file (every field: rooms/_template.toml). Column = x (east),\n# row = z (south), 1 cell = 1 m. `o` cells are shards and `P` is the start (legend markers,\n# read by starter.rs with `scenes::markers`); the slimes are [[npc]] entries the game drives.\n# Check it with `pav room_check path=crates/pav_core/src/games/starter.toml`.\n\nname = \"Starter\"\nabout = \"Collect every shard while slimes chase you.\"\nentrance = { at = [8, 12], facing = \"south\" }   # required by the format; the `P` marker is the start\n\n# The rules' numbers (starter.rs `Rules`). Running from the repository, `pav` reads this file at\n# each `load`: edit, then `load scene=starter` or `play bot=true seeds=10`, no rebuild.\n[game]\nlives = 3\nslime_speed = 0.5\nslime_sight = 9.0\ncatch = 0.8\npick = 0.9\ngrace = 2.0\n\n[camera]\ntilt = 58.0\ndistance = 17.0\n\n[layout]\norigin = [-9.0, 0.0, -6.5]\n\n[[layout.layer]]\ny = 0\nmap = '''\n##################\n#o......#.......o#\n#.......#........#\n#..##.......##...#\n#..#.........#...#\n#.......o........#\n#....#.....#.....#\n#.......P........#\n#..#.........#...#\n#..##.......##...#\n#.......#........#\n    fn load_scene(&mut self, name: &str) {\n        let Some(host) = &self.host else { return };\n        let (scene, seed) = (name.to_string(), self.settings.seed);\n        let cfg = self.sim_config.clone();\n        host.exec(move |sim| {\n            // Keep the hero: save, build the scene, put them back in.\n            crate::save::save_from(sim);\n            match Sim::new(&scene, seed) {\n                Ok(mut fresh) => {\n                    fresh.config = cfg;\n                    crate::save::restore_into(&mut fresh);\n                    *sim = fresh;\n                }\n                Err(e) => log::error!(\"could not load scene: {e:#}\"),\n            }\n        });\n        self.scene_name = name.to_string();\n        self.rig.params = CameraParams { yaw: self.rig.params.yaw, ..self.rig.params.clone() };\n        self.toast(format!(\"loaded {}\", self.scene_name));\n    }\n\n    /// Resets the whole scene (menu).\n    fn reset(&mut self) {\n            room,\n            config: self.config_arc.clone(),\n            events: self.events.clone(),\n            projectiles: self\n                .state\n                .projectiles\n                .list\n                .iter()\n                .map(|p| crate::frame::ProjectileView { pos: p.pos, vel: p.vel, radius: p.radius, color: p.color })\n                .collect(),\n            hud,\n            game: self.state.game.as_ref().map(|g| std::sync::Arc::new(g.frame(self))),\n            animation_preview: None,\n            studio_mode: crate::prop_preview::StudioMode::World,\n            prop_preview: None,\n            creature_preview: None,\n            creature: None,\n        }\n    }\n\n    /// Counts for the physics overlay.\n    pub fn step(&mut self, input: &InputFrame) {\n        let dt = self.dt();\n        match self.studio_mode() {\n            crate::prop_preview::StudioMode::Animation => {\n                if let Some(preview) = &mut self.state.animation_preview {\n                    preview.advance(dt);\n                }\n                return;\n            }\n            crate::prop_preview::StudioMode::Prop => {\n                if let Some(preview) = &mut self.state.prop_preview {\n                    preview.advance(dt);\n                }\n58:[profile.dev]\n59-opt-level = 1\n60-# Keeps the target folder small (cloud containers have a fixed disk allowance); backtraces\n61-# still show file:line.\n62-debug = \"line-tables-only\"\n63-incremental = false\n64-\n65:[profile.dev.package.\"*\"]\n66-opt-level = 3\n67-debug = false\n68-\n69:[profile.release]\n70-debug = \"line-tables-only\"\n71-\n72-# Distribution build (what gets sent to the user): smaller, still has function names in crash reports.\n73:[profile.dist]\n74-inherits = \"release\"\n75-debug = false\n76-strip = \"debuginfo\"\n//! Pavilion simulation core: headless (no window, GPU or audio dependencies).\n// `x as Real` casts are no-ops with f32 physics but required by the f64 switch.\n#![allow(clippy::unnecessary_cast)]\n\npub mod ai;\npub mod anim;\npub mod animation_edit;\npub mod animation_preview;\npub mod arpg;\npub mod behaviors;\npub mod catalogue;\npub mod character;\npub mod clip_browser;\npub mod clips;\npub mod color;\npub mod course;\npub mod creature_preview;\npub mod creatures;\npub mod destruct;\npub mod entity;\npub mod feel;\npub mod figure;\npub mod frame;\npub mod fxdef;\npub mod games;\npub mod guide;\npub mod health;\npub mod history;\npub mod input;\npub mod issue;\npub mod joints;\npub mod level;\npub mod material;\npub mod moves;\npub mod nav;\npub mod params;\npub mod parts;\npub mod physics;\npub mod projectile;\npub mod prop_instance;\npub mod prop_preview;\npub mod props;\npub mod puppet;\npub mod rig;\npub mod rng;\npub mod room;\npub mod scenes;\npub mod shape;\npub mod sim;\npub mod softbody;\npub mod statics;\npub mod stealth;\npub mod store;\npub mod terrain;\npub mod vehicle;\npub mod world;\npub mod zones;\n\npub use color::Color;\npub use entity::{Behavior, BodyKind, Entity, EntityId, Spawn};\npub use frame::{RenderFrame, RenderObject, SimEvent};\npub use glam;\npub use input::InputFrame;\npub use rapier;\npub use shape::{Look, Shape, Visual};\npub use sim::{Sim, SimConfig, SimState};\n//! Games built on the engine (`pav_core::games`): the starter's bot wins on many seeds, the\n//! starter can be lost, and a game's state survives snapshot files, rewind and replays like\n//! the rest of the simulation. Copy these tests for a new game.\n\nuse pav_core::games::{GAMES, Outcome};\nuse pav_core::{InputFrame, Sim, SimState};\n\n#[test]\nfn the_starter_bot_wins_on_ten_seeds() {\n    for seed in 1..=10 {\n        let mut sim = Sim::new(\"starter\", seed).unwrap();\n        let (outcome, ticks) = sim.run_bot(60 * 60);\n        let status = sim.play().unwrap().status(&sim);\n        assert_eq!(outcome, Outcome::Won, \"seed {seed}, {ticks} ticks: {status}\");\n    }\n}\n\n#[test]\nfn standing_still_gets_caught() {\n    let mut sim = Sim::new(\"starter\", 1).unwrap();\n    assert_eq!(sim.frame().hud.lines, [\"Shards 0/5\", \"Lives 3\"]);\n    for _ in 0..60 * 60 {\n        sim.step(&InputFrame::default());\n    }\n    assert_eq!(sim.outcome(), Outcome::Lost);\n    assert_eq!(sim.frame().hud.lines, [\"Shards 0/5\", \"Lives 0\", \"Game over\"]);\n}\n\n#[test]\nfn snapshots_rewind_and_replays_are_exact() {\n    let mut sim = Sim::new(\"starter\", 3).unwrap();\n    for _ in 0..240 {\n        let f = sim.bot_input();\n        sim.step(&f);\n    }\n    // A snapshot file (CBOR) restores the game, and both copies then play on the same.\n    let mut bytes = Vec::new();\n    ciborium::into_writer(&sim.snapshot(), &mut bytes).unwrap();\n    let state: SimState = ciborium::from_reader(bytes.as_slice()).unwrap();\n    let mut copy = Sim::new(\"starter\", 3).unwrap();\n    copy.restore(state);\n    assert_eq!(copy.state_hash(), sim.state_hash());\n    for _ in 0..240 {\n        let (a, b) = (sim.bot_input(), copy.bot_input());\n        sim.step(&a);\n        copy.step(&b);\n    }\n    assert_eq!(copy.state_hash(), sim.state_hash());\n\n    let (tick, hash) = (sim.state.tick, sim.state_hash());\n    assert!(sim.rewind_to(tick - 90));\n    assert!(sim.rewind_to(tick));\n    assert_eq!(sim.state_hash(), hash);\n\n    let mut again = Sim::new(\"starter\", 3).unwrap();\n    for f in sim.recording.iter() {\n        again.step(f);\n    }\n    assert_eq!(again.state_hash(), hash);\n}\n62:    fn read(&self, out: &egui::FullOutput, screen: Rect, layers: Vec<(Rect, Vec<(Rect, String)>)>) -> Reading {\n101:    fn is_open(&self, name: &str) -> bool {\n115:fn window_layers(ctx: &egui::Context, root: egui::LayerId, screen: Rect) -> Vec<(Rect, Vec<(Rect, String)>)> {\n136:fn dedupe(texts: Vec<(Rect, String)>) -> Vec<Text> {\n147:fn collect(shape: &Shape, clip: Rect, out: &mut Vec<(Rect, String)>) {\n166:fn sort(texts: &mut [Text]) {\n173:fn rect4(r: Rect) -> [f32; 4] {\n184:    pub fn new(device: &wgpu::Device, format: wgpu::TextureFormat) -> Self {\n188:    pub fn format(&self) -> wgpu::TextureFormat {\n194:    pub fn paint(\ncrates/pav_tools/src/bridge.rs:7://!   -> {\"id\": 1, \"tool\": \"capture\", \"args\": {\"width\": 640}}\ncrates/pav_tools/src/tools.rs:83:        name: \"capture\",\ncrates/pav_tools/src/tools.rs:206:        name: \"filmstrip\",\ncrates/pav_tools/src/tools.rs:1235:fn t_capture(s: &mut Session, a: &Args) -> Result<Output> {\n    Finished `dev` profile [optimized + debuginfo] target(s) in 2m 30s","is_error":false}]},"parent_tool_use_id":null,"session_id":"189b0832-eeab-4401-af9a-06d1cd0033c9","uuid":"96858aea-a938-4399-88e7-5a63f8c28d2d","timestamp":"2026-11-05T14:27:56.175Z","tool_use_result":{"stdout":"        if self.outcome != Outcome::Playing {\n            // Decided: everyone stands still.\n            for &id in sim.state.player.iter().chain(&self.slimes) {\n                out.insert(id, InputFrame::default());\n            }\n            return out;\n        }\n        if self.nav.is_none() {\n            self.nav = NavGrid::for_room(sim).map(Arc::new);\n        }\n        let Some(nav) = self.nav.clone() else { return out };\n        // One flow field toward the player steers every slime round the walls.\n        let player = sim.state.player.and_then(|id| sim.feet(id));\n        let field = player.filter(|_| self.grace <= 0.0).and_then(|p| nav.flow(p, self.rules.slime_sight));\n        for (&id, &speed) in self.slimes.iter().zip(&self.speeds) {\n            let mut input = InputFrame::default();\n            if let (Some(field), Some(at)) = (&field, sim.feet(id))\n                && let Some(d) = field.dir(&nav, at)\n            {\n                input.move_dir = Vec2::new(d.x, d.z) * speed;\n            }\n            out.insert(id, input);\n        }\n        out\n    }\n\n    fn post(&mut self, sim: &mut Sim, dt: f32, events: &mut Vec<SimEvent>) {\n        if self.outcome != Outcome::Playing {\n            return;\n        }\n        self.time += dt;\n        self.grace = (self.grace - dt).max(0.0);\n        let Some(pid) = sim.state.player else { return };\n        let Some(p) = sim.feet(pid) else { return };\n\n        // Shards: walk over one to pick it up.\n        let near: Vec<(EntityId, Vec3)> = self\n            .shards\n            .iter()\n            .filter_map(|&id| sim.state.entities.get(id).map(|e| (id, e.pos)))\n            .filter(|(_, at)| flat(*at - p) < self.rules.pick)\n            .collect();\n        for (id, at) in near {\n            self.shards.retain(|&s| s != id);\n            sim.despawn(id);\n            events.push(SimEvent::Coin { pos: at });\n            let left = self.shards.len();\n            sim.say(if left == 1 { \"1 shard to go\".to_string() } else { format!(\"{left} shards to go\") });\n        }\n        if self.shards.is_empty() {\n            self.outcome = Outcome::Won;\n            sim.say(format!(\"All shards in {:.1} s!\", self.time));\n            return;\n        }\n\n        // Slimes: a touch costs a life and sends everyone back to the start.\n        let catch = self.rules.catch;\n        let caught = self.grace <= 0.0 && self.slimes.iter().any(|&id| sim.feet(id).is_some_and(|s| flat(s - p) < catch));\n        if caught {\n            self.lives -= 1;\n            events.push(SimEvent::Hit { pos: p + Vec3::Y, strength: 1.0, target: Some(pid) });\n            if self.lives == 0 {\n                self.outcome = Outcome::Lost;\n                sim.say(\"Caught! Game over\");\n                return;\n            }\n            sim.say(format!(\"Caught! {} lives left\", self.lives));\n            let spawn = sim.state.spawn;\n            sim.set_position(pid, spawn);\n            for (&id, &home) in self.slimes.iter().zip(&self.homes) {\n                sim.set_position(id, home);\n            }\n            self.grace = self.rules.grace;\n        }\n    }\n\n    fn hud(&self, _sim: &Sim) -> Vec<String> {\n        let mut lines =\n            vec![format!(\"Shards {}/{}\", self.total - self.shards.len(), self.total), format!(\"Lives {}\", self.lives)];\n        match self.outcome {\n            Outcome::Won => lines.push(format!(\"You win! {:.1} s\", self.time)),\n            Outcome::Lost => lines.push(\"Game over\".into()),\n            Outcome::Playing => {}\n        }\n        lines\n    }\n\n    fn status(&self, sim: &Sim) -> serde_json::Value {\n        let xz = |id: EntityId| sim.feet(id).map(|f| [round(f.x), round(f.z)]);\n        json!({\n            \"outcome\": self.outcome,\n            \"time\": round(self.time),\n            \"shards_left\": self.shards.len(),\n            \"total\": self.total,\n            \"lives\": self.lives,\n            \"grace\": round(self.grace),\n            \"player\": sim.state.player.and_then(xz),\n            \"shards\": self.shards.iter().filter_map(|&id| sim.state.entities.get(id).map(|e| [round(e.pos.x), round(e.pos.z)])).collect::<Vec<_>>(),\n            \"slimes\": self.slimes.iter().filter_map(|&id| xz(id)).collect::<Vec<_>>(),\n        })\n    }\n\n    fn outcome(&self) -> Outcome {\n        self.outcome\n    }\n\n    /// Takes the shortest walk to a shard that keeps clear of slimes (cells near them count\n    /// as walls); with every shard cut off, makes for the reachable spot farthest from them.\n    fn bot(&self, sim: &Sim) -> InputFrame {\n        let mut input = InputFrame::default();\n        let Some(p) = sim.state.player.and_then(|id| sim.feet(id)) else { return input };\n        let Some(mut grid) = self.nav.as_deref().cloned().or_else(|| NavGrid::for_room(sim)) else { return input };\n        let slimes: Vec<Vec3> = self.slimes.iter().filter_map(|&id| sim.feet(id)).collect();\n        if self.grace < 0.5 {\n            for i in 0..grid.blocked.len() {\n                if slimes.iter().any(|&s| flat(grid.center(i) - s) < 1.8) {\n                    grid.blocked[i] = true;\n                }\n            }\n        }\n        let paths = self.shards.iter().filter_map(|&id| sim.state.entities.get(id)).filter_map(|e| grid.path(p, e.pos));\n        let path = paths.min_by(|a, b| length(p, a).total_cmp(&length(p, b))).or_else(|| {\n            let clearance = |i: usize| slimes.iter().map(|&s| flat(grid.center(i) - s)).fold(f32::MAX, f32::min);\n            let reach = grid.flow(p, 6.0)?;\n            let safest = (0..grid.blocked.len())\n                .filter(|&i| reach.dist[i].is_finite())\n                .max_by(|&a, &b| clearance(a).total_cmp(&clearance(b)))?;\n            grid.path(p, grid.center(safest))\n        });\n        input.move_dir = path.map(|path| flat_dir(path[0] - p)).unwrap_or_default();\n        input\n    }\n}\n\nfn flat(v: Vec3) -> f32 {\n    Vec2::new(v.x, v.z).length()\n}\n\nfn flat_dir(v: Vec3) -> Vec2 {\n    Vec2::new(v.x, v.z).normalize_or_zero()\n}\n\n/// Walking length of a path from `p`.\nfn length(p: Vec3, path: &[Vec3]) -> f32 {\n    let (mut at, mut sum) = (p, 0.0);\n    for &q in path {\n        sum += flat(q - at);\n        at = q;\n    }\n    sum\n}\n\nfn round(x: f32) -> f64 {\n    (x as f64 * 100.0).round() / 100.0\n}\n# The starter game's level: a room file (every field: rooms/_template.toml). Column = x (east),\n# row = z (south), 1 cell = 1 m. `o` cells are shards and `P` is the start (legend markers,\n# read by starter.rs with `scenes::markers`); the slimes are [[npc]] entries the game drives.\n# Check it with `pav room_check path=crates/pav_core/src/games/starter.toml`.\n\nname = \"Starter\"\nabout = \"Collect every shard while slimes chase you.\"\nentrance = { at = [8, 12], facing = \"south\" }   # required by the format; the `P` marker is the start\n\n# The rules' numbers (starter.rs `Rules`). Running from the repository, `pav` reads this file at\n# each `load`: edit, then `load scene=starter` or `play bot=true seeds=10`, no rebuild.\n[game]\nlives = 3\nslime_speed = 0.5\nslime_sight = 9.0\ncatch = 0.8\npick = 0.9\ngrace = 2.0\n\n[camera]\ntilt = 58.0\ndistance = 17.0\n\n[layout]\norigin = [-9.0, 0.0, -6.5]\n\n[[layout.layer]]\ny = 0\nmap = '''\n##################\n#o......#.......o#\n#.......#........#\n#..##.......##...#\n#..#.........#...#\n#.......o........#\n#....#.....#.....#\n#.......P........#\n#..#.........#...#\n#..##.......##...#\n#.......#........#\n    fn load_scene(&mut self, name: &str) {\n        let Some(host) = &self.host else { return };\n        let (scene, seed) = (name.to_string(), self.settings.seed);\n        let cfg = self.sim_config.clone();\n        host.exec(move |sim| {\n            // Keep the hero: save, build the scene, put them back in.\n            crate::save::save_from(sim);\n            match Sim::new(&scene, seed) {\n                Ok(mut fresh) => {\n                    fresh.config = cfg;\n                    crate::save::restore_into(&mut fresh);\n                    *sim = fresh;\n                }\n                Err(e) => log::error!(\"could not load scene: {e:#}\"),\n            }\n        });\n        self.scene_name = name.to_string();\n        self.rig.params = CameraParams { yaw: self.rig.params.yaw, ..self.rig.params.clone() };\n        self.toast(format!(\"loaded {}\", self.scene_name));\n    }\n\n    /// Resets the whole scene (menu).\n    fn reset(&mut self) {\n            room,\n            config: self.config_arc.clone(),\n            events: self.events.clone(),\n            projectiles: self\n                .state\n                .projectiles\n                .list\n                .iter()\n                .map(|p| crate::frame::ProjectileView { pos: p.pos, vel: p.vel, radius: p.radius, color: p.color })\n                .collect(),\n            hud,\n            game: self.state.game.as_ref().map(|g| std::sync::Arc::new(g.frame(self))),\n            animation_preview: None,\n            studio_mode: crate::prop_preview::StudioMode::World,\n            prop_preview: None,\n            creature_preview: None,\n            creature: None,\n        }\n    }\n\n    /// Counts for the physics overlay.\n    pub fn step(&mut self, input: &InputFrame) {\n        let dt = self.dt();\n        match self.studio_mode() {\n            crate::prop_preview::StudioMode::Animation => {\n                if let Some(preview) = &mut self.state.animation_preview {\n                    preview.advance(dt);\n                }\n                return;\n            }\n            crate::prop_preview::StudioMode::Prop => {\n                if let Some(preview) = &mut self.state.prop_preview {\n                    preview.advance(dt);\n                }\n58:[profile.dev]\n59-opt-level = 1\n60-# Keeps the target folder small (cloud containers have a fixed disk allowance); backtraces\n61-# still show file:line.\n62-debug = \"line-tables-only\"\n63-incremental = false\n64-\n65:[profile.dev.package.\"*\"]\n66-opt-level = 3\n67-debug = false\n68-\n69:[profile.release]\n70-debug = \"line-tables-only\"\n71-\n72-# Distribution build (what gets sent to the user): smaller, still has function names in crash reports.\n73:[profile.dist]\n74-inherits = \"release\"\n75-debug = false\n76-strip = \"debuginfo\"\n//! Pavilion simulation core: headless (no window, GPU or audio dependencies).\n// `x as Real` casts are no-ops with f32 physics but required by the f64 switch.\n#![allow(clippy::unnecessary_cast)]\n\npub mod ai;\npub mod anim;\npub mod animation_edit;\npub mod animation_preview;\npub mod arpg;\npub mod behaviors;\npub mod catalogue;\npub mod character;\npub mod clip_browser;\npub mod clips;\npub mod color;\npub mod course;\npub mod creature_preview;\npub mod creatures;\npub mod destruct;\npub mod entity;\npub mod feel;\npub mod figure;\npub mod frame;\npub mod fxdef;\npub mod games;\npub mod guide;\npub mod health;\npub mod history;\npub mod input;\npub mod issue;\npub mod joints;\npub mod level;\npub mod material;\npub mod moves;\npub mod nav;\npub mod params;\npub mod parts;\npub mod physics;\npub mod projectile;\npub mod prop_instance;\npub mod prop_preview;\npub mod props;\npub mod puppet;\npub mod rig;\npub mod rng;\npub mod room;\npub mod scenes;\npub mod shape;\npub mod sim;\npub mod softbody;\npub mod statics;\npub mod stealth;\npub mod store;\npub mod terrain;\npub mod vehicle;\npub mod world;\npub mod zones;\n\npub use color::Color;\npub use entity::{Behavior, BodyKind, Entity, EntityId, Spawn};\npub use frame::{RenderFrame, RenderObject, SimEvent};\npub use glam;\npub use input::InputFrame;\npub use rapier;\npub use shape::{Look, Shape, Visual};\npub use sim::{Sim, SimConfig, SimState};\n//! Games built on the engine (`pav_core::games`): the starter's bot wins on many seeds, the\n//! starter can be lost, and a game's state survives snapshot files, rewind and replays like\n//! the rest of the simulation. Copy these tests for a new game.\n\nuse pav_core::games::{GAMES, Outcome};\nuse pav_core::{InputFrame, Sim, SimState};\n\n#[test]\nfn the_starter_bot_wins_on_ten_seeds() {\n    for seed in 1..=10 {\n        let mut sim = Sim::new(\"starter\", seed).unwrap();\n        let (outcome, ticks) = sim.run_bot(60 * 60);\n        let status = sim.play().unwrap().status(&sim);\n        assert_eq!(outcome, Outcome::Won, \"seed {seed}, {ticks} ticks: {status}\");\n    }\n}\n\n#[test]\nfn standing_still_gets_caught() {\n    let mut sim = Sim::new(\"starter\", 1).unwrap();\n    assert_eq!(sim.frame().hud.lines, [\"Shards 0/5\", \"Lives 3\"]);\n    for _ in 0..60 * 60 {\n        sim.step(&InputFrame::default());\n    }\n    assert_eq!(sim.outcome(), Outcome::Lost);\n    assert_eq!(sim.frame().hud.lines, [\"Shards 0/5\", \"Lives 0\", \"Game over\"]);\n}\n\n#[test]\nfn snapshots_rewind_and_replays_are_exact() {\n    let mut sim = Sim::new(\"starter\", 3).unwrap();\n    for _ in 0..240 {\n        let f = sim.bot_input();\n        sim.step(&f);\n    }\n    // A snapshot file (CBOR) restores the game, and both copies then play on the same.\n    let mut bytes = Vec::new();\n    ciborium::into_writer(&sim.snapshot(), &mut bytes).unwrap();\n    let state: SimState = ciborium::from_reader(bytes.as_slice()).unwrap();\n    let mut copy = Sim::new(\"starter\", 3).unwrap();\n    copy.restore(state);\n    assert_eq!(copy.state_hash(), sim.state_hash());\n    for _ in 0..240 {\n        let (a, b) = (sim.bot_input(), copy.bot_input());\n        sim.step(&a);\n        copy.step(&b);\n    }\n    assert_eq!(copy.state_hash(), sim.state_hash());\n\n    let (tick, hash) = (sim.state.tick, sim.state_hash());\n    assert!(sim.rewind_to(tick - 90));\n    assert!(sim.rewind_to(tick));\n    assert_eq!(sim.state_hash(), hash);\n\n    let mut again = Sim::new(\"starter\", 3).unwrap();\n    for f in sim.recording.iter() {\n        again.step(f);\n    }\n    assert_eq!(again.state_hash(), hash);\n}\n62:    fn read(&self, out: &egui::FullOutput, screen: Rect, layers: Vec<(Rect, Vec<(Rect, String)>)>) -> Reading {\n101:    fn is_open(&self, name: &str) -> bool {\n115:fn window_layers(ctx: &egui::Context, root: egui::LayerId, screen: Rect) -> Vec<(Rect, Vec<(Rect, String)>)> {\n136:fn dedupe(texts: Vec<(Rect, String)>) -> Vec<Text> {\n147:fn collect(shape: &Shape, clip: Rect, out: &mut Vec<(Rect, String)>) {\n166:fn sort(texts: &mut [Text]) {\n173:fn rect4(r: Rect) -> [f32; 4] {\n184:    pub fn new(device: &wgpu::Device, format: wgpu::TextureFormat) -> Self {\n188:    pub fn format(&self) -> wgpu::TextureFormat {\n194:    pub fn paint(\ncrates/pav_tools/src/bridge.rs:7://!   -> {\"id\": 1, \"tool\": \"capture\", \"args\": {\"width\": 640}}\ncrates/pav_tools/src/tools.rs:83:        name: \"capture\",\ncrates/pav_tools/src/tools.rs:206:        name: \"filmstrip\",\ncrates/pav_tools/src/tools.rs:1235:fn t_capture(s: &mut Session, a: &Args) -> Result<Output> {\n    Finished `dev` profile [optimized + debuginfo] target(s) in 2m 30s","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01SGQRtLrtq3ur9LHhJ75ipb","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
