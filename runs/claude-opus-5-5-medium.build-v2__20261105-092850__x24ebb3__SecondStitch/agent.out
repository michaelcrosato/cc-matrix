1 .', kick: 'C3 . . . . . C3 . C3 . . C3 . . C3 .' } } },\n  'boss-miserere': { bpm: 60, tracks: { choir: choir(0.07), choir2: choir(0.05), high: { wave: 'sine', decay: 0.8, volume: 0.05 } }, order: ['a', 'b'], patterns: {\n    a: { choir: 'C4 - - - - - - - G4 - - - - - - -', choir2: 'E4 - - - - - - - B4 - - - - - - -', high: 'G5 . . . E5 . . . D5 . . . B4 . . .' },\n    b: { choir: 'A3 - - - - - - - F4 - - - E4 - - -', choir2: 'C4 - - - - - - - A4 - - - G4 - - -', high: 'A5 . . . E5 . . . C5 . . . E5 . . .' } } },\n  op10: { bpm: 52, tracks: { lead: lead(0.08), soft: pad(0.02) }, order: ['a', 'b'], patterns: {\n    a: { lead: 'A4 - - - . . . . C5 - - - . . . .', soft: 'A3 . . . E4 . . . F3 . . . C4 . . .' },\n    b: { lead: 'B4 - - - G4 - - - A4 - - - - - - -', soft: 'G3 . . . D4 . . . A3 . . . E4 . . .' } } },\n  results: { bpm: 120, loop: false, tracks: { lead: { wave: 'square', duty: 0.25, decay: 0.2, volume: 0.09 }, bass: bass(0.09) }, order: ['a'], patterns: { a: { lead: 'C5 . E5 . G5 . C6 - - - G5 . C6 - - -', bass: 'C3 . . . G2 . . . F2 . . . C3 - - -' } } },\n  sad: { bpm: 60, loop: false, tracks: { lead: lead(0.1), bass: bass(0.08) }, order: ['a'], patterns: { a: { lead: 'E5 - - D5 C5 - - B4 A4 - - - - - - -', bass: 'A2 - - - F2 - - - E2 - - - A2 - - -' } } },\n  credits: { bpm: 72, tracks: { lead: lead(0.1), soft: pad(0.03), bass: bass(0.08) }, order: ['a', 'b'], patterns: {\n    a: { lead: 'C5 - D5 - E5 - G5 - E5 - - - D5 - C5 -', soft: 'C4 E4 G4 E4 C4 E4 G4 E4 A3 C4 E4 C4 A3 C4 E4 C4', bass: 'C3 - - - - - - - A2 - - - - - - -' },\n    b: { lead: 'F5 - E5 - D5 - C5 - D5 - - - G4 - - -', soft: 'F3 A3 C4 A3 F3 A3 C4 A3 G3 B3 D4 B3 G3 B3 D4 B3', bass: 'F2 - - - - - - - G2 - - - - - - -' } } },\n};\nEOF\ncat > src/audio/director.js <<'EOF'\n// Picks tracks from vitals and stage; changes at bar lines so a switch sounds intentional.\nimport { SONGS } from '../content/songs.js';\nexport class MusicDirector {\n  current = null; want = null; barT = 0; bpmApplied = 0;\n  constructor(audio) { this.audio = audio; }\n  play(id) { this.want = id; if (this.current === null) this.apply(); }\n  stopNow() { this.want = null; this.current = null; this.audio.playMusic(null); }\n  apply() {\n    if (this.want === this.current) return;\n    this.current = this.want;\n    if (!this.want || this.want === 'silence') { this.audio.playMusic(null); this.barT = 1; return; }\n    const song = SONGS[this.want];\n    if (song) { this.audio.playMusic(song, this.want); this.barT = this.barLen(song); }\n  }\n  barLen(song) { return (16 / (song.stepsPerBeat ?? 4)) * (60 / song.bpm); }\n  /** Dies Irae's tempo follows the heart: restart with a new bpm at bar lines. */\n  setBpm(bpm) {\n    if (this.current !== 'boss-irae' && this.current !== 'boss-libera') return;\n    const song = { ...SONGS[this.current], bpm };\n    if (Math.abs(bpm - this.bpmApplied) >= 6) { this.bpmApplied = bpm; this.pending = song; }\n  }\n  update(dt, vitals = null, base = null) {\n    let want = this.want;\n    if (base && vitals != null && (base === 'or-calm' || base === 'or-tense' || base === 'or-critical')) want = vitals < 30 ? 'or-critical' : vitals < 50 && base === 'or-calm' ? 'or-tense' : base;\n    this.want = want;\n    this.barT -= dt;\n    if (this.barT <= 0) {\n      if (this.pending) { this.audio.playMusic(this.pending, this.current); this.barT = this.barLen(this.pending); this.pending = null; }\n      else if (this.want !== this.current) this.apply();\n      else if (this.current && SONGS[this.current]) this.barT = this.barLen(SONGS[this.current]);\n      else this.barT = 0.5;\n    }\n  }\n}\nEOF\necho done","description":"Write input devices, cursor, voice, sfx, songs, director"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4472,"cache_read_input_tokens":229667,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4472},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9464247a-cdba-4289-905c-cd8b34e5d270","uuid":"a161b6d7-4f29-44da-8119-7e661827eeed","timestamp":"2026-11-05T16:45:53.573Z","request_id":"req_011Cgk7fwqJ7Rj1eePfVtBHA","wire_tool_inputs":{"toolu_013seiuk8QYVFAMAVzbe4eDS":{"command":"cat > src/input/devices.js <<'EOF'\n// Pads polled per pad each frame; keys and mouse from the engine's Input. Tracks the last device used.\nexport const BTN = { CROSS: 0, CIRCLE: 1, SQUARE: 2, TRIANGLE: 3, L1: 4, R1: 5, L2: 6, R2: 7, CREATE: 8, OPTIONS: 9, L3: 10, R3: 11, UP: 12, DOWN: 13, LEFT: 14, RIGHT: 15 };\nconst dz = (v, d = 0.18) => (Math.abs(v) < d ? 0 : (v - Math.sign(v) * d) / (1 - d));\n\nexport class Devices {\n  pads = [null, null, null, null];\n  last = 'kbm';\n  idle = 0; // seconds with no input\n  anyInput = false; // this frame\n  anyPress = false; // a new press or click this frame\n  pointerMoved = false;\n  pointerX = 0; pointerY = 0; // art pixels\n  rep = { t: 0, dir: null };\n  lastPointer = { x: 9, y: 9 };\n  nav = { up: false, down: false, left: false, right: false, confirm: false, back: false, tabL: false, tabR: false, pause: false, triangle: false };\n  hasTouchOnly = false;\n  lastPad = 0;\n\n  poll(ctx, dt) {\n    const input = ctx.input, hud = ctx.hud;\n    const raw = typeof navigator !== 'undefined' && navigator.getGamepads ? navigator.getGamepads() : [];\n    this.anyInput = false; this.anyPress = false;\n    for (let i = 0; i < 4; i++) {\n      const g = raw[i];\n      if (!g || !g.connected) { this.pads[i] = null; continue; }\n      const prev = this.pads[i];\n      const buttons = Array.from(g.buttons, (b) => (typeof b === 'number' ? b : b.value || (b.pressed ? 1 : 0)));\n      const pad = { index: i, gamepad: g, buttons, prev: prev ? prev.buttons : buttons.map(() => 0), axes: Array.from(g.axes ?? []), id: g.id };\n      this.pads[i] = pad;\n      let touched = false, pressed = false;\n      buttons.forEach((v, b) => { if (v > 0.2) touched = true; if (v > 0.5 && !(pad.prev[b] > 0.5)) pressed = true; });\n      if (pad.axes.some((a) => Math.abs(a) > 0.3)) touched = true;\n      if (touched) { this.anyInput = true; this.last = 'pad'; this.lastPad = i; }\n      if (pressed) this.anyPress = true;\n    }\n    // keys & mouse\n    const p = input.pointer;\n    this.pointerMoved = (p.x !== this.lastPointer.x || p.y !== this.lastPointer.y) && this.lastPointer.x !== 9;\n    this.lastPointer.x = p.x; this.lastPointer.y = p.y;\n    this.pointerX = ((p.x + 1) / 2) * hud.width;\n    this.pointerY = ((1 - p.y) / 2) * hud.height;\n    const held = input.state?.().keys ?? null;\n    const keyActive = KEY_WATCH.some((k) => input.wasPressed(k));\n    const clicked = input.wasPressed('MouseLeft', 'MouseRight', 'MouseMiddle');\n    if (keyActive || clicked || this.pointerMoved || input.wheel) { this.anyInput = true; this.last = 'kbm'; }\n    if (keyActive || clicked) this.anyPress = true;\n    if (input.isDown('Touch') || input.wasPressed('Touch')) { this.anyInput = true; this.anyPress = true; }\n    void held;\n    this.idle = this.anyInput ? 0 : this.idle + dt;\n    this.buildNav(input, dt);\n  }\n\n  buildNav(input, dt) {\n    const n = this.nav;\n    let up = input.wasPressed('ArrowUp', 'KeyW'), down = input.wasPressed('ArrowDown', 'KeyS'), left = input.wasPressed('ArrowLeft', 'KeyA'), right = input.wasPressed('ArrowRight', 'KeyD');\n    let confirm = input.wasPressed('Enter', 'Space', 'NumpadEnter'), back = input.wasPressed('Escape', 'Backspace');\n    let tabL = input.wasPressed('KeyQ'), tabR = input.wasPressed('KeyE'), pause = input.wasPressed('Escape'), triangle = false;\n    let dir = null;\n    if (input.isDown('ArrowUp', 'KeyW')) dir = 'up'; else if (input.isDown('ArrowDown', 'KeyS')) dir = 'down'; else if (input.isDown('ArrowLeft', 'KeyA')) dir = 'left'; else if (input.isDown('ArrowRight', 'KeyD')) dir = 'right';\n    for (const pad of this.pads) {\n      if (!pad) continue;\n      const hit = (b) => pad.buttons[b] > 0.5 && !(pad.prev[b] > 0.5);\n      const on = (b) => pad.buttons[b] > 0.5;\n      if (hit(BTN.UP)) up = true; if (hit(BTN.DOWN)) down = true; if (hit(BTN.LEFT)) left = true; if (hit(BTN.RIGHT)) right = true;\n      if (hit(BTN.CROSS)) confirm = true; if (hit(BTN.CIRCLE)) back = true; if (hit(BTN.L1)) tabL = true; if (hit(BTN.R1)) tabR = true;\n      if (hit(BTN.TRIANGLE)) triangle = true;\n      if (hit(BTN.OPTIONS) && !on(BTN.CREATE)) pause = true;\n      const ax = pad.axes[0] ?? 0, ay = pad.axes[1] ?? 0;\n      if (on(BTN.UP) || ay < -0.5) dir = dir ?? 'up'; else if (on(BTN.DOWN) || ay > 0.5) dir = dir ?? 'down'; else if (on(BTN.LEFT) || ax < -0.5) dir = dir ?? 'left'; else if (on(BTN.RIGHT) || ax > 0.5) dir = dir ?? 'right';\n      const was = pad.stickDir;\n      void was;\n    }\n    // auto-repeat for held direction (stick edge counts as a press)\n    if (dir !== this.rep.dir) {\n      if (dir && !up && !down && !left && !right) { if (dir === 'up') up = true; if (dir === 'down') down = true; if (dir === 'left') left = true; if (dir === 'right') right = true; }\n      this.rep.dir = dir; this.rep.t = 0.4;\n    } else if (dir) {\n      this.rep.t -= dt;\n      if (this.rep.t <= 0) { this.rep.t = 0.12; if (dir === 'up') up = true; if (dir === 'down') down = true; if (dir === 'left') left = true; if (dir === 'right') right = true; }\n    }\n    Object.assign(n, { up, down, left, right, confirm, back, tabL, tabR, pause, triangle });\n  }\n\n  /** Mouse clicks this frame in art pixels. */\n  click(input) {\n    if (input.wasPressed('MouseLeft')) return { x: this.pointerX, y: this.pointerY, button: 0 };\n    return null;\n  }\n  rightClick(input) { return input.wasPressed('MouseRight'); }\n\n  rumble(index, strong, weak, ms, enabled) {\n    if (!enabled) return;\n    const pads = index == null ? this.pads : [this.pads[index]];\n    for (const pad of pads) pad?.gamepad?.vibrationActuator?.playEffect?.('dual-rumble', { duration: ms, strongMagnitude: strong, weakMagnitude: weak })?.catch?.(() => {});\n  }\n}\nconst KEY_WATCH = ['Enter', 'Space', 'Escape', 'Tab', 'Backspace', 'KeyW', 'KeyA', 'KeyS', 'KeyD', 'KeyQ', 'KeyE', 'KeyF', 'KeyJ', 'KeyK', 'KeyR', 'KeyM', 'ShiftLeft', 'ShiftRight', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Digit1', 'Digit2', 'Digit3', 'Digit4', 'Digit5', 'Digit6', 'Digit7', 'Digit8', 'KeyX', 'KeyZ', 'KeyC', 'KeyV', 'KeyB', 'KeyN', 'KeyL', 'KeyP', 'KeyO', 'KeyI', 'KeyU', 'KeyY', 'KeyT', 'KeyG', 'KeyH'];\nexport const deadzone = dz;\nEOF\ncat > src/input/cursor.js <<'EOF'\n// The stick/keys tip integrator, pure so a network client moves its own tip with the same numbers.\nimport { TOOLS } from '../sim/tools.js';\nimport { validTargets, aimPoint } from '../sim/entities.js';\n\nexport const FIELD = { xMin: -7.4, xMax: 7.4, zMin: -4, zMax: 3.6 };\n/** Velocity curve from the plan: speed · |s|^2.2 · direction, steady multiplies. */\nexport function integrateTip(tip, sx, sz, { speed, steady, steadyFactor, assist = 0, stroke = null, near = false, dt = 1 / 60 }) {\n  let m = Math.hypot(sx, sz);\n  if (m > 1) { sx /= m; sz /= m; m = 1; }\n  if (m <= 0) return;\n  let v = speed * Math.pow(m, 2.2);\n  if (steady) v *= steadyFactor;\n  if (near) v *= 1 - 0.4 * Math.min(1, assist / 0.4); // Low = 60% within reach of a valid target\n  let vx = (sx / m) * v, vz = (sz / m) * v;\n  if (stroke && assist > 0) { // damp drift perpendicular to the stroke\n    const dot = vx * stroke[0] + vz * stroke[1];\n    const px = vx - stroke[0] * dot, pz = vz - stroke[1] * dot;\n    const k = 0.5 * Math.min(1, assist / 0.4);\n    vx -= px * k; vz -= pz * k;\n  }\n  tip.x = Math.max(FIELD.xMin, Math.min(FIELD.xMax, tip.x + vx * dt));\n  tip.z = Math.max(FIELD.zMin, Math.min(FIELD.zMax, tip.z + vz * dt));\n}\nexport function nearTarget(sim, seat, x, z) {\n  const list = validTargets(sim, seat.tool, seat.table);\n  for (const e of list) { const [ax, az] = aimPoint(e); if (Math.hypot(ax - x, az - z) < 0.6) return true; }\n  return false;\n}\n/** Direction of an active stroke at the seat's tip, for perpendicular damping. */\nexport function strokeDir(sim, seat) {\n  const id = seat.stroke ?? seat.dressing;\n  if (!id) return null;\n  const e = sim.ents.find((c) => c.id === id);\n  if (!e?.pts) return null;\n  const n = e.pts.length;\n  for (let i = 1; i < n; i++) {\n    const a = e.pts[i - 1], b = e.pts[i];\n    const l = Math.hypot(b[0] - a[0], b[1] - a[1]);\n    if (l > 0) {\n      const t = ((seat.x - a[0]) * (b[0] - a[0]) + (seat.z - a[1]) * (b[1] - a[1])) / (l * l);\n      if (t <= 1 || i === n - 1) return [(b[0] - a[0]) / l, (b[1] - a[1]) / l];\n    }\n  }\n  return null;\n}\n/** Right-stick flick direction to wheel slot, clockwise from top. */\nexport function flickSlot(rx, ry) {\n  if (Math.hypot(rx, ry) < 0.6) return -1;\n  let a = Math.atan2(rx, -ry);\n  if (a < 0) a += Math.PI * 2;\n  return Math.round(a / (Math.PI / 4)) % 8;\n}\nexport const toolAtSlot = (i) => TOOLS[i];\nEOF\ncat > src/audio/voice.js <<'EOF'\n// Animalese/Simlish gibberish: syllables rendered in pure JS (a glottal pulse through formants).\nexport const VOWELS = { a: [800, 1200], e: [500, 1900], i: [320, 2300], o: [500, 900], u: [350, 750] };\nexport const CONSONANTS = ['b', 's', 'm']; // onset shapes: plosive, hiss, hum\nconst TIMBRES = [ { name: 'low', f0: 110, br: 0.12 }, { name: 'mid', f0: 165, br: 0.08 }, { name: 'high', f0: 235, br: 0.06 } ];\n\nfunction resonate(input, freq, bw, sr) {\n  const out = new Float32Array(input.length);\n  const r = Math.exp((-Math.PI * bw) / sr), c = 2 * r * Math.cos((2 * Math.PI * freq) / sr), d = -r * r, g = 1 - c - d;\n  let y1 = 0, y2 = 0;\n  for (let i = 0; i < input.length; i++) { const y = g * input[i] + c * y1 + d * y2; out[i] = y; y2 = y1; y1 = y; }\n  return out;\n}\n/** One syllable as mono samples. */\nexport function renderSyllable(timbre, vowel, cons, sr = 22050, dur = 0.12) {\n  const n = Math.round(sr * dur), t = TIMBRES[timbre], src = new Float32Array(n);\n  let phase = 0, seed = 12345 + timbre * 7 + vowel.charCodeAt(0) * 13 + cons.charCodeAt(0);\n  const noise = () => { seed = (seed * 1664525 + 1013904223) >>> 0; return seed / 2147483648 - 1; };\n  for (let i = 0; i < n; i++) {\n    const f = t.f0 * (1 + 0.08 * Math.sin((i / n) * Math.PI));\n    phase += f / sr;\n    if (phase >= 1) phase -= 1;\n    src[i] = (phase < 0.4 ? Math.sin((phase / 0.4) * Math.PI) : -0.25) + noise() * t.br;\n  }\n  const [f1, f2] = VOWELS[vowel];\n  const scale = 1 + timbre * 0.09;\n  const a = resonate(src, f1 * scale, 90, sr), b = resonate(src, f2 * scale, 130, sr), out = new Float32Array(n);\n  let peak = 0.0001;\n  for (let i = 0; i < n; i++) {\n    const p = i / n;\n    let env = Math.min(1, p / 0.06) * Math.min(1, (1 - p) / 0.25);\n    let v = a[i] * 0.9 + b[i] * 0.45;\n    if (cons === 'b' && p < 0.14) env *= p / 0.14;\n    if (cons === 's' && p < 0.25) v = v * (p / 0.25) + noise() * 0.12 * (1 - p / 0.25);\n    if (cons === 'm' && p < 0.28) v = a[i] * 0.5;\n    out[i] = v * env;\n    if (Math.abs(out[i]) > peak) peak = Math.abs(out[i]);\n  }\n  for (let i = 0; i < n; i++) out[i] = (out[i] / peak) * 0.8;\n  return out;\n}\nexport function wavDataUrl(samples, sr = 22050) {\n  const n = samples.length, buf = new ArrayBuffer(44 + n * 2), v = new DataView(buf);\n  const str = (o, s) => { for (let i = 0; i < s.length; i++) v.setUint8(o + i, s.charCodeAt(i)); };\n  str(0, 'RIFF'); v.setUint32(4, 36 + n * 2, true); str(8, 'WAVEfmt '); v.setUint32(16, 16, true); v.setUint16(20, 1, true); v.setUint16(22, 1, true);\n  v.setUint32(24, sr, true); v.setUint32(28, sr * 2, true); v.setUint16(32, 2, true); v.setUint16(34, 16, true); str(36, 'data'); v.setUint32(40, n * 2, true);\n  for (let i = 0; i < n; i++) v.setInt16(44 + i * 2, Math.max(-1, Math.min(1, samples[i])) * 32767, true);\n  const bytes = new Uint8Array(buf);\n  let bin = '';\n  for (let i = 0; i < bytes.length; i += 8192) bin += String.fromCharCode.apply(null, bytes.subarray(i, i + 8192));\n  return `data:audio/wav;base64,${btoa(bin)}`;\n}\nexport const syllableName = (t, v, c) => `syl-${t}${v}${c}`;\nconst VKEYS = Object.keys(VOWELS);\n/** Letter -> syllable: deterministic, so a line always sounds like itself. */\nexport function syllableFor(ch) {\n  const c = ch.toLowerCase().charCodeAt(0);\n  return { vowel: VKEYS[c % VKEYS.length], cons: CONSONANTS[(c >> 1) % CONSONANTS.length] };\n}\nexport async function loadSyllables(audio) {\n  const jobs = [];\n  for (let t = 0; t < 3; t++) for (const v of VKEYS) for (const c of CONSONANTS) jobs.push(audio.load(syllableName(t, v, c), wavDataUrl(renderSyllable(t, v, c))));\n  await Promise.all(jobs);\n}\n/** Plays a line letter by letter as the typewriter reveals it. */\nexport class Voice {\n  constructor(app) { this.app = app; }\n  letter(audio, ch, who, cast, i, punct) {\n    if (!/[a-z]/i.test(ch) || i % 2) return false;\n    const v = cast?.voice ?? { timbre: 1, base: 0, speed: 1, range: 2 };\n    const { vowel, cons } = syllableFor(ch);\n    const c = ch.toLowerCase().charCodeAt(0);\n    const pitch = v.base + ((c * 7) % 5) * (v.range / 4) - v.range / 2 + (punct === '?' ? 2 + (i % 3) : punct === '!' ? 2 : 0);\n    const vol = (punct === '!' ? 0.75 : 0.5) * (this.app.settings.voices ?? 0.8);\n    if (vol <= 0) return false;\n    audio.play(syllableName(v.timbre, vowel, cons), { pitch, volume: vol });\n    return true;\n  }\n}\nEOF\ncat > src/content/sfx.js <<'EOF'\n// Every sound effect, as engine SoundDef data. No audio files.\nexport const SFX_DEFS = {\n  drainLoop: { wave: 'noise', freq: 1800, attack: 0.03, sustain: 0.5, decay: 0.05, volume: 0.22, crush: 8, vibrato: { depth: 3, rate: 13 } },\n  dropSuck: { wave: 'sine', freq: 420, freqEnd: 1500, attack: 0.005, decay: 0.09, volume: 0.25 },\n  gelLoop: { wave: 'noise', freq: 5000, attack: 0.05, sustain: 0.5, decay: 0.05, volume: 0.1 },\n  laserLoop: { wave: 'square', duty: 0.25, freq: 520, attack: 0.01, sustain: 0.4, decay: 0.02, volume: 0.12, vibrato: { depth: 0.8, rate: 40 }, layers: [{ wave: 'noise', freq: 9000, sustain: 0.4, decay: 0.02, volume: 0.06 }] },\n  forceps: { wave: 'square', duty: 0.125, freq: 1900, freqEnd: 1200, decay: 0.04, volume: 0.2 },\n  hookPop: { wave: 'triangle', freq: 500, freqEnd: 1100, decay: 0.08, volume: 0.35, layers: [{ wave: 'noise', freq: 3000, decay: 0.04, volume: 0.15 }] },\n  tink: { wave: 'triangle', freq: 2400, decay: 0.3, volume: 0.28, layers: [{ wave: 'sine', freq: 3700, decay: 0.15, volume: 0.14 }] },\n  sliceStart: { wave: 'noise', freq: 9000, freqEnd: 4000, decay: 0.07, volume: 0.16 },\n  slice: { wave: 'noise', freq: 7000, decay: 0.03, volume: 0.09 },\n  stitch: { wave: 'triangle', freq: 660, decay: 0.09, volume: 0.32 },\n  knot: { wave: 'square', duty: 0.25, freq: 880, freqEnd: 1320, decay: 0.12, volume: 0.22, arp: [0, 7], arpRate: 0.05 },\n  sizzle: { wave: 'noise', freq: 6000, freqEnd: 2000, decay: 0.28, volume: 0.25 },\n  ping: { wave: 'sine', freq: 1500, decay: 0.28, volume: 0.28, arp: [0, 12], arpRate: 0.06 },\n  scanLoop: { wave: 'sine', freq: 900, attack: 0.02, sustain: 0.4, decay: 0.02, volume: 0.05, vibrato: { depth: 1.5, rate: 6 } },\n  syringeDraw: { wave: 'sine', freq: 300, freqEnd: 900, decay: 0.2, volume: 0.2 },\n  inject: { wave: 'noise', freq: 2500, freqEnd: 800, decay: 0.25, volume: 0.25, layers: [{ wave: 'sine', freq: 500, freqEnd: 1000, decay: 0.2, volume: 0.2 }] },\n  bandage: { wave: 'noise', freq: 3000, decay: 0.2, volume: 0.2 },\n  heal: { wave: 'triangle', freq: 700, freqEnd: 1100, decay: 0.2, volume: 0.2 },\n  bruise: { wave: 'square', duty: 0.5, freq: 110, decay: 0.08, volume: 0.25 },\n  tick: { wave: 'square', duty: 0.125, freq: 240, decay: 0.03, volume: 0.25 },\n  beep: { wave: 'square', duty: 0.25, freq: 980, decay: 0.07, volume: 0.1 },\n  beepLow: { wave: 'square', duty: 0.25, freq: 1240, decay: 0.09, volume: 0.17 },\n  alarm: { wave: 'square', duty: 0.5, freq: 880, sustain: 0.1, decay: 0.05, volume: 0.2, arp: [0, -5], arpRate: 0.1 },\n  flatline: { wave: 'square', duty: 0.25, freq: 1000, sustain: 1.4, decay: 0.3, volume: 0.2 },\n  charge: { wave: 'sawtooth', freq: 200, freqEnd: 1900, sweepTime: 1.0, attack: 0.05, sustain: 0.95, decay: 0.05, volume: 0.15 },\n  clear: { wave: 'noise', freq: 900, freqEnd: 90, decay: 0.45, volume: 0.6, layers: [{ wave: 'sine', freq: 130, freqEnd: 34, decay: 0.45, volume: 0.7 }] },\n  shockBad: { wave: 'square', duty: 0.5, freq: 150, freqEnd: 70, decay: 0.3, volume: 0.35 },\n  uiMove: { wave: 'square', duty: 0.25, freq: 720, decay: 0.03, volume: 0.13 },\n  uiConfirm: { wave: 'square', duty: 0.25, freq: 660, decay: 0.09, volume: 0.17, arp: [0, 7], arpRate: 0.05 },\n  uiBack: { wave: 'square', duty: 0.25, freq: 440, freqEnd: 300, decay: 0.09, volume: 0.15 },\n  stamp: { wave: 'noise', freq: 800, freqEnd: 100, decay: 0.2, volume: 0.6, layers: [{ wave: 'sine', freq: 90, freqEnd: 40, decay: 0.25, volume: 0.7 }] },\n  rateClean: { wave: 'triangle', freq: 1046, decay: 0.15, volume: 0.22, arp: [0, 4, 7], arpRate: 0.045 },\n  rateGood: { wave: 'triangle', freq: 784, decay: 0.12, volume: 0.17 },\n  rateSloppy: { wave: 'square', duty: 0.5, freq: 233, decay: 0.12, volume: 0.13 },\n  rateMistake: { wave: 'sawtooth', freq: 180, freqEnd: 70, decay: 0.3, volume: 0.32 },\n  heartbeat: { wave: 'sine', freq: 62, freqEnd: 40, decay: 0.16, volume: 0.7, layers: [{ wave: 'sine', freq: 52, freqEnd: 36, delay: 0.2, decay: 0.16, volume: 0.45 }] },\n  inhale: { wave: 'noise', freq: 900, freqEnd: 3400, attack: 0.3, decay: 0.15, volume: 0.13 },\n  drone: { wave: 'sawtooth', freq: 55, attack: 0.3, sustain: 0.4, decay: 0.1, volume: 0.08, crush: 12 },\n  rewind: { wave: 'sawtooth', freq: 2600, freqEnd: 120, decay: 0.75, volume: 0.22, vibrato: { depth: 3, rate: 30 }, layers: [{ wave: 'noise', freq: 6000, freqEnd: 500, decay: 0.7, volume: 0.1 }] },\n  knock: { wave: 'sine', freq: 110, freqEnd: 60, decay: 0.09, volume: 0.8, layers: [{ wave: 'sine', freq: 100, freqEnd: 55, delay: 0.17, decay: 0.09, volume: 0.8 }, { wave: 'sine', freq: 100, freqEnd: 55, delay: 0.34, decay: 0.09, volume: 0.8 }] },\n  squelch: { wave: 'noise', freq: 900, freqEnd: 180, decay: 0.2, volume: 0.35 },\n  pop: { wave: 'sine', freq: 180, freqEnd: 900, decay: 0.12, volume: 0.45, layers: [{ wave: 'noise', freq: 2500, decay: 0.09, volume: 0.25 }] },\n  strainHurt: { wave: 'sawtooth', freq: 620, freqEnd: 110, decay: 0.4, volume: 0.3, vibrato: { depth: 3, rate: 22 } },\n  tetherSnap: { wave: 'noise', freq: 5000, freqEnd: 400, decay: 0.15, volume: 0.35, layers: [{ wave: 'square', duty: 0.25, freq: 300, freqEnd: 70, decay: 0.2, volume: 0.2 }] },\n  magnetSnap: { wave: 'square', duty: 0.125, freq: 1400, freqEnd: 200, decay: 0.12, volume: 0.25 },\n  seat: { wave: 'triangle', freq: 330, freqEnd: 500, decay: 0.1, volume: 0.35, layers: [{ wave: 'noise', freq: 2200, decay: 0.03, volume: 0.15 }] },\n  wail: { wave: 'sawtooth', freq: 300, freqEnd: 840, attack: 0.1, sustain: 0.3, decay: 0.3, volume: 0.15, vibrato: { depth: 1.2, rate: 7 } },\n  wave: { wave: 'noise', freq: 500, freqEnd: 70, attack: 0.1, decay: 0.7, volume: 0.45 },\n  drip: { wave: 'sine', freq: 1500, freqEnd: 700, decay: 0.06, volume: 0.16 },\n  dropHit: { wave: 'sine', freq: 300, freqEnd: 120, decay: 0.07, volume: 0.22 },\n  fizz: { wave: 'noise', freq: 8000, decay: 0.08, volume: 0.12 },\n  eyeOpen: { wave: 'sine', freq: 200, freqEnd: 420, decay: 0.25, volume: 0.25 },\n  beatMiss: { wave: 'square', duty: 0.5, freq: 160, freqEnd: 90, decay: 0.16, volume: 0.25 },\n  flare: { wave: 'sawtooth', freq: 260, freqEnd: 500, decay: 0.2, volume: 0.16 },\n  plateCrack: { wave: 'noise', freq: 2500, freqEnd: 500, decay: 0.15, volume: 0.35, layers: [{ wave: 'square', duty: 0.125, freq: 220, decay: 0.1, volume: 0.2 }] },\n  choir: { wave: 'sawtooth', freq: 523, attack: 0.15, sustain: 0.3, decay: 0.5, volume: 0.1, vibrato: { depth: 0.3, rate: 5 }, layers: [{ wave: 'sawtooth', freq: 784, attack: 0.15, sustain: 0.3, decay: 0.5, volume: 0.07 }] },\n  mimicCut: { wave: 'noise', freq: 6000, freqEnd: 1000, decay: 0.12, volume: 0.25, layers: [{ wave: 'sine', freq: 1046, freqEnd: 523, decay: 0.2, volume: 0.15 }] },\n  squeeze: { wave: 'sine', freq: 75, freqEnd: 45, decay: 0.2, volume: 0.8, layers: [{ wave: 'noise', freq: 500, decay: 0.1, volume: 0.15 }] },\n  rain: { wave: 'noise', freq: 11000, attack: 0.5, sustain: 2, decay: 0.5, volume: 0.05 },\n  horn: { wave: 'sawtooth', freq: 73, attack: 0.3, sustain: 1.6, decay: 0.7, volume: 0.13, layers: [{ wave: 'sawtooth', freq: 110, attack: 0.3, sustain: 1.6, decay: 0.7, volume: 0.07 }] },\n  bell: { wave: 'triangle', freq: 932, decay: 1, volume: 0.1, layers: [{ wave: 'sine', freq: 2300, decay: 0.5, volume: 0.04 }, { wave: 'triangle', freq: 932, delay: 0.5, decay: 1, volume: 0.07 }] },\n  reveal: { wave: 'triangle', freq: 523, decay: 0.2, volume: 0.15, arp: [0, 3, 7, 12], arpRate: 0.05 },\n};\nEOF\ncat > src/content/songs.js <<'EOF'\n// All original chiptune compositions, as engine Song data.\nconst lead = (v = 0.11) => ({ wave: 'triangle', decay: 0.42, volume: v, vibrato: { depth: 0.08, rate: 5 } });\nconst pad = (v = 0.04) => ({ wave: 'square', duty: 0.25, attack: 0.03, decay: 0.5, volume: v });\nconst bass = (v = 0.1) => ({ wave: 'triangle', decay: 0.22, volume: v });\nconst choir = (v = 0.05) => ({ wave: 'sawtooth', attack: 0.1, decay: 0.9, volume: v, vibrato: { depth: 0.1, rate: 4.5 } });\nconst hat = (v = 0.03) => ({ wave: 'noise', decay: 0.02, volume: v });\nconst kick = (v = 0.14) => ({ wave: 'sine', decay: 0.09, volume: v });\n\nexport const SONGS = {\n  title: { bpm: 58, tracks: { lead: lead(0.12), soft: pad(0.03), bass: bass(0.08) }, order: ['a', 'b', 'a', 'c'], patterns: {\n    a: { lead: 'E4 - - - . . G4 - F4 - - - E4 - D4 -', soft: 'A3 . E4 . A3 . E4 . F3 . C4 . F3 . C4 .', bass: 'A2 - - - - - - - F2 - - - - - - -' },\n    b: { lead: 'C5 - - - B4 - A4 - G4 - - - . . E4 -', soft: 'C4 . G4 . C4 . G4 . E3 . B3 . E3 . B3 .', bass: 'C3 - - - - - - - E2 - - - - - - -' },\n    c: { lead: 'D4 - F4 - A4 - - G4 E4 - - - - - . .', soft: 'D4 . A4 . D4 . A4 . E3 . G#3 . B3 . E4 .', bass: 'D3 - - - - - - - E2 - - - - - - -' } } },\n  ward: { bpm: 84, stepsPerBeat: 3, tracks: { lead: { wave: 'triangle', decay: 0.28, volume: 0.09 }, comp: pad(0.03), bass: bass(0.09), hat: hat(0.018) }, order: ['a', 'b'], patterns: {\n    a: { lead: 'A4 . C5 E5 . D5 C5 . A4 . . . G4 . B4 D5 . C5 B4 . G4 . . .', comp: '. . D4 . . . . . F4 . . . . . B3 . . . . . E4 . . .', bass: 'D3 . . . . A2 . . . D3 . . G2 . . . . D3 . . G2 . . .', hat: 'C8 . C8 C8 . C8 C8 . C8 C8 . C8 C8 . C8 C8 . C8 C8 . C8 C8 . C8' },\n    b: { lead: 'E5 . D5 C5 . A4 G4 . E4 . . . F4 . A4 C5 . B4 A4 . . . . .', comp: '. . C4 . . . . . E4 . . . . . A3 . . . . . C4 . . .', bass: 'C3 . . . . G2 . . . C3 . . F2 . . . . C3 . . F2 . . .', hat: 'C8 . C8 C8 . C8 C8 . C8 C8 . C8 C8 . C8 C8 . C8 C8 . C8 C8 . C8' } } },\n  'or-calm': { bpm: 96, tracks: { arp: { wave: 'square', duty: 0.125, decay: 0.12, volume: 0.04 }, lead: lead(0.075), bass: bass(0.09), hat: hat(0.018) }, order: ['a', 'a', 'b', 'c'], patterns: {\n    a: { arp: 'A3 C4 E4 A4 E4 C4 A3 C4 F3 A3 C4 F4 C4 A3 F3 A3', lead: 'E5 - - - . . . . C5 - - - . . . .', bass: 'A2 . . . A2 . . . F2 . . . F2 . . .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .' },\n    b: { arp: 'C4 E4 G4 C5 G4 E4 C4 E4 G3 B3 D4 G4 D4 B3 G3 B3', lead: 'G5 - E5 - C5 - . . D5 - B4 - G4 - . .', bass: 'C3 . . . C3 . . . G2 . . . G2 . . .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .' },\n    c: { arp: 'D4 F4 A4 D5 A4 F4 D4 F4 E4 G#4 B4 E5 B4 G#4 E4 B3', lead: 'A4 - - F5 - - D5 - E5 - - - - - . .', bass: 'D3 . . . D3 . . . E3 . . . E2 . . .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .' } } },\n  'or-tense': { bpm: 112, tracks: { arp: { wave: 'square', duty: 0.25, decay: 0.09, volume: 0.05 }, lead: { wave: 'square', duty: 0.25, decay: 0.2