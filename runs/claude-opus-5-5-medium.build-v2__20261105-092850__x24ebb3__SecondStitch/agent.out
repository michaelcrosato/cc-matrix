{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgk72RLT73peEG8U5sAjM","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011zhbAXxv9bqSnNcfp7jVUg","name":"Bash","input":{"command":"cat > src/sim/op.js <<'EOF'\n// The operation: createOp / step / drainEvents. Plain data and pure functions; no engine, DOM or clock.\nimport { config as liveConfig, DIFFICULTY } from '../core/config.js';\nimport { hashString, nextRandom } from '../core/rng.js';\nimport { LINES } from '../content/lines.js';\nimport { dist } from './geom.js';\nimport { KINDS, removeEnt, spawn, entBySid, visible, toolFor, aimPoint, entById } from './entities.js';\nimport { TOOLS, toolStep } from './tools.js';\nimport { STRAINS } from './strains/index.js';\nimport { rate, MISTAKE_COST } from './scoring.js';\n\nconst DT = 1 / 60;\nconst DEFS = new Map();\nexport const registerOp = (def) => { DEFS.set(def.id, def); return def; };\nexport const defOf = (sim) => DEFS.get(sim.opId);\n\nfunction makeSeat(i, def, opts) {\n  const tool = def.startTool ?? def.tools[0] ?? 'drain';\n  const gift = opts.gifts?.[i] ?? (i % 2 === 0 ? (def.surgeon === 'sabine' ? 'look' : 'quiet') : 'look');\n  return {\n    i, x: [1.5, -1.5, 1.5, -1.5][i], z: [1.2, 1.2, -1.2, -1.2][i], table: 0, tool, lastTool: tool, gift,\n    useHeld: false, grab: null, grabT: 0, cool: 0, dryT: 0, strayT: 0, stroke: null, side: 0, drawing: 0, dressing: null,\n    giftHeld: false, tagHeld: false, swHeld: 0, trail: [], score: 0, stitches: 0, drained: 0, devSum: 0, devT: 0, saves: 0,\n    ratings: { CLEAN: 0, GOOD: 0, SLOPPY: 0, MISTAKE: 0 }, padL: false, padR: false, beatHit: -1, out: false,\n  };\n}\n\nexport function createOp(def, { seed = 1, seats = 1, difficulty = 'resident', cfg = liveConfig, stage = 0, cheats = {}, gifts = null, retried = false, session = false } = {}) {\n  registerOp(def);\n  const diff = DIFFICULTY[difficulty] ?? DIFFICULTY.resident;\n  const tablesDef = def.tables ?? [{ vitals: def.vitals.start }];\n  const coop = 1 + (cfg.coopScale ?? 0.25) * (seats - 1);\n  const time = def.time * diff.time * cfg.timeLimit;\n  const sim = {\n    opId: def.id, seed, rng: (hashString(def.id) ^ seed) | 0, difficulty, session,\n    t: 0, realT: 0, clock: time, clockMax: time, phase: 'play', stage: -1, stageT: 0,\n    tables: tablesDef.map((t) => ({ vitals: t.vitals, drain: def.vitals.drain, fake: null, lost: false, name: t.name ?? null, low: false })),\n    ents: [], nextId: 1, drops: [], films: [], scars: [], flags: {}, fired: {}, counters: {},\n    tools: [...def.tools], def_film: !!def.film, composure: def.composure ?? 40, giftOn: !!(def.gifts && def.gifts.length),\n    score: 0, streak: 0, bestStreak: 0, mistakes: 0, doses: def.doses, port: def.port ?? [-5.2, 2.2],\n    ratings: { CLEAN: 0, GOOD: 0, SLOPPY: 0, MISTAKE: 0 },\n    codeBlues: 0, saves: diff.saves, unscriptedBlue: false, retried, looks: 0, codeBlue: null, massage: null,\n    quiet: false, quietSeat: -1, heart: null, ghost: null, mimic: null, cold: null, pain: def.pain ?? null,\n    voiceOff: !!def.noVoice, noHint: !!def.noHint || !diff.hint, hint: null, doctor: def.surgeon ?? 'ilya',\n    music: def.music ?? 'or-calm', lastQuip: -9, lineIx: {}, coop, camera: null,\n    seats: Array.from({ length: seats }, (_, i) => makeSeat(i, def, { gifts })),\n    cfg, cheats: { god: false, infComposure: false, freezeClock: false, unlimitedMistakes: false, ...cheats },\n    events: [], ring: [], ringN: 0, checkpoint: null, meta: {},\n  };\n  if (stage > 0) {\n    for (let i = 0; i < stage && i < def.stages.length; i++) if (def.stages[i].jump) runCmds(sim, def.stages[i].jump, true);\n    sim.stage = stage - 1;\n    sim.ents.length = 0;\n  }\n  nextStage(sim);\n  return sim;\n}\n\nexport const drainEvents = (sim) => { const e = sim.events; sim.events = []; return e; };\n\n/** Copy of the state without the things that aren't part of a moment. */\nexport function cloneState(sim) {\n  const { ring, checkpoint, events, cfg, meta } = sim;\n  sim.ring = null; sim.checkpoint = null; sim.events = null; sim.cfg = null; sim.meta = null;\n  const c = structuredClone(sim);\n  sim.ring = ring; sim.checkpoint = checkpoint; sim.events = events; sim.cfg = cfg; sim.meta = meta;\n  return c;\n}\nexport function hashSim(sim) { return hashString(JSON.stringify(cloneState(sim))).toString(16); }\n\n/* ---- comm ---- */\nexport function say(sim, who, text, force = false) {\n  if (sim.voiceOff && !force) return;\n  sim.events.push({ t: 'say', who, text });\n}\nexport function sayKey(sim, key) {\n  const [who] = key.split('.');\n  const pool = LINES[key];\n  if (!pool) return;\n  const n = (sim.lineIx[key] = (sim.lineIx[key] ?? -1) + 1);\n  const line = pool[n % pool.length];\n  say(sim, who === 'false' ? 'reyes' : who, line);\n}\n\n/* ---- vitals and mistakes ---- */\nexport function addVitals(sim, table, v) {\n  const t = sim.tables[table] ?? sim.tables[0];\n  t.vitals = Math.max(0, Math.min(99, t.vitals + v));\n}\nexport function hurt(sim, table, v) {\n  if (sim.cheats.god) { const t = sim.tables[table]; t.vitals = Math.max(5, t.vitals - v); return; }\n  addVitals(sim, table, -v);\n}\nexport function mistake(sim, seat, reason, x, z) {\n  sim.mistakes++;\n  sim.ratings.MISTAKE++;\n  seat.ratings.MISTAKE++;\n  sim.score = Math.max(0, sim.score - MISTAKE_COST);\n  seat.score = Math.max(0, seat.score - MISTAKE_COST);\n  sim.streak = 0;\n  hurt(sim, seat.table, sim.cfg.mistakePenalty);\n  sim.events.push({ t: 'rate', r: 'MISTAKE', x, z, seat: seat.i, reason, pts: -MISTAKE_COST });\n  sayKey(sim, 'reyes.mistake');\n  if (sim.cfg.maxMistakes > 0 && !sim.cheats.unlimitedMistakes && sim.mistakes >= sim.cfg.maxMistakes) lose(sim, 'mistakes');\n}\nexport function addScar(sim, scar) {\n  sim.scars.push(scar);\n  if (sim.scars.length > 60) sim.scars.shift();\n}\nexport function lose(sim, why) {\n  if (sim.phase === 'lost' || sim.phase === 'won') return;\n  sim.phase = 'lost';\n  sim.loseWhy = why;\n  sim.codeBlue = null;\n  sim.events.push({ t: 'lost', why });\n}\nexport function win(sim) {\n  if (sim.phase === 'lost' || sim.phase === 'won') return;\n  sim.phase = 'won';\n  sim.events.push({ t: 'won' });\n}\n\n/* ---- strains ---- */\nexport function signal(sim, ownerId, sig, ent, seat) {\n  const owner = entById(sim, ownerId);\n  if (!owner || owner.k !== 'strain') return;\n  STRAINS[owner.type]?.on?.(sim, owner, sig, ent, seat);\n}\nexport function inSystole(sim) { return !!sim.heart && sim.heart.phase < 0.35; }\n\n/* ---- commands: what stages and entities can do, as data ---- */\nexport function runCmds(sim, cmds, silent = false) {\n  for (const c of Array.isArray(cmds) ? cmds : [cmds]) {\n    if (c.say) { if (!silent) { if (Array.isArray(c.say)) say(sim, c.say[0], c.say[1], !!c.force); else sayKey(sim, c.say); } }\n    if (c.spawn) for (const d of c.spawn) spawn(sim, d);\n    if (c.remove) for (const sid of c.remove) { const e = entBySid(sim, sid); if (e) removeEnt(sim, e); }\n    if (c.removeKinds) for (const e of [...sim.ents]) if (c.removeKinds.includes(e.k)) removeEnt(sim, e);\n    if (c.unlock) { const list = Array.isArray(c.unlock) ? c.unlock : [c.unlock]; for (const u of list) { if (u === 'gift') sim.giftOn = true; else if (!sim.tools.includes(u)) { sim.tools.push(u); sim.events.push({ t: 'unlock', tool: u }); } else { const e = entBySid(sim, u); if (e) delete e.locked; } const e = entBySid(sim, u); if (e) delete e.locked; } }\n    if (c.setDrain != null) for (const t of sim.tables) t.drain = c.setDrain;\n    if (c.music) { sim.music = c.music; sim.events.push({ t: 'music', id: c.music }); }\n    if (c.camera) { sim.camera = c.camera; sim.events.push({ t: 'camera', id: c.camera }); }\n    if (c.flag) sim.flags[c.flag] = true;\n    if (c.codeBlue) enterCodeBlue(sim, c.table ?? 0, true);\n    if (c.massage) enterMassage(sim, c.massage);\n    if (c.vitals != null) addVitals(sim, c.table ?? 0, c.vitals);\n    if (c.setVitals != null) sim.tables[c.table ?? 0].vitals = c.setVitals;\n    if (c.fake !== undefined) sim.tables[c.table ?? 0].fake = c.fake;\n    if (c.composure != null) sim.composure = Math.min(100, Math.max(sim.composure, c.composure));\n    if (c.hurt != null) hurt(sim, c.table ?? 0, c.hurt);\n    if (c.pain != null) sim.pain = c.pain;\n    if (c.cold != null) sim.cold = c.cold ? { t: c.cold, max: c.cold } : null;\n    if (c.pinkUp) sim.events.push({ t: 'pinkUp' });\n    if (c.sfx) sim.events.push({ t: 'sfx', id: c.sfx, x: 0, z: 0 });\n    if (c.voice != null) sim.voiceOff = !c.voice;\n    if (c.fx) sim.events.push({ t: 'fx', id: c.fx });\n    if (c.prompt) sim.events.push({ t: 'prompt', text: c.prompt });\n    if (c.mimic != null) sim.mimic = c.mimic ? { hits: 0, cool: 0 } : null;\n    if (c.heart) sim.heart = { bpm: c.heart, phase: 0.4, beats: 0 };\n    if (c.noHeart) sim.heart = null;\n    if (c.addTime != null) { sim.clock += c.addTime; sim.clockMax = Math.max(sim.clockMax, sim.clock); }\n    if (c.tag) sim.tagOn = true;\n    if (c.win) win(sim);\n  }\n}\n\nfunction nextStage(sim) {\n  const def = defOf(sim);\n  sim.stage++;\n  sim.stageT = 0;\n  sim.fired = {};\n  if (sim.stage >= def.stages.length) { win(sim); return; }\n  const st = def.stages[sim.stage];\n  sim.events.push({ t: 'stage', i: sim.stage, id: st.id });\n  if (st.begin) runCmds(sim, st.begin);\n  if (st.say) runCmds(sim, { say: st.say });\n  if (st.spawn) for (const d of st.spawn) spawn(sim, d);\n  if (st.music) runCmds(sim, { music: st.music });\n  if (sim.phase === 'play' || sim.phase === 'codeblue') {\n    sim.checkpoint = cloneState(sim);\n    sim.checkpointStage = sim.stage;\n  }\n}\n\n/** Is a stage's `until` satisfied? */\nexport function check(sim, u) {\n  if (!u) return false;\n  if (u.all) return u.all.every((c) => check(sim, c));\n  if (u.any) return u.any.some((c) => check(sim, c));\n  if (u.clear) return !sim.ents.some((e) => u.clear.includes(e.k) && !e.isFalse && (u.table == null || e.table === u.table));\n  if (u.flag) return !!sim.flags[u.flag];\n  if (u.time != null) return sim.stageT >= u.time;\n  if (u.sids) return !u.sids.some((sid) => entBySid(sim, sid));\n  return false;\n}\n\nfunction stageLogic(sim) {\n  const def = defOf(sim);\n  const st = def.stages[sim.stage];\n  if (!st) return;\n  if (st.timed) for (let i = 0; i < st.timed.length; i++) {\n    const tm = st.timed[i];\n    if (sim.fired[`t${i}`]) continue;\n    const go = tm.t != null ? sim.stageT >= tm.t : check(sim, tm.when);\n    if (go) { sim.fired[`t${i}`] = true; runCmds(sim, tm); }\n  }\n  const low = st.on?.vitalsBelow;\n  if (low) for (const k of Object.keys(low)) {\n    const key = `v${k}`;\n    if (!sim.fired[key] && sim.tables.some((t) => t.vitals < +k)) { sim.fired[key] = true; runCmds(sim, low[k]); }\n  }\n  if (check(sim, st.until)) {\n    if (st.then) runCmds(sim, st.then);\n    if (sim.phase === 'play') nextStage(sim);\n    else sim.pendingStage = true;\n  }\n}\n\n/* ---- Code Blue ---- */\nexport function enterCodeBlue(sim, table, scripted) {\n  if (sim.cheats.god && !scripted) return;\n  sim.codeBlue = { t: 12, shocks: 0, need: 2, charge: 0, needle: 0, charging: false, cool: 0.5, scripted, table, zone: sim.cfg.codeBlueZone, centre: 0.72, bad: 0 };\n  sim.phase = 'codeblue';\n  sim.quiet = false;\n  if (!scripted) { sim.codeBlues++; sim.unscriptedBlue = true; }\n  else sim.tables[table].vitals = Math.min(sim.tables[table].vitals, 0);\n  sim.events.push({ t: 'codeblue', on: true, scripted, table });\n}\nfunction codeBlueStep(sim, inputs) {\n  const cb = sim.codeBlue;\n  cb.t -= DT;\n  cb.cool = Math.max(0, cb.cool - DT);\n  const anyL = inputs.some((i) => i?.padL), anyR = inputs.some((i) => i?.padR);\n  const both = (anyL && anyR) || inputs.some((i) => i?.padL && i?.padR);\n  if (both && cb.cool <= 0) {\n    if (!cb.charging) sim.events.push({ t: 'sfx', id: 'charge' });\n    cb.charging = true;\n    cb.charge += DT;\n    cb.needle = 0.5 - 0.5 * Math.cos((cb.charge / 1.2) * Math.PI * 2);\n  } else if (cb.charging) {\n    cb.charging = false;\n    const good = Math.abs(cb.needle - cb.centre) <= cb.zone / 2;\n    cb.charge = 0;\n    cb.cool = 0.35;\n    sim.events.push({ t: 'shock', good, n: cb.shocks + (good ? 1 : 0) });\n    if (good) {\n      cb.shocks++;\n      for (const i of inputs.keys()) if (inputs[i]?.padL || inputs[i]?.padR || inputs.length === 1) sim.seats[i].saves++;\n      if (cb.shocks >= cb.need) {\n        sim.tables[cb.table].vitals = Math.max(25, sim.tables[cb.table].vitals);\n        sim.phase = 'play';\n        sim.codeBlue = null;\n        sim.events.push({ t: 'codeblue', on: false });\n        if (cb.scripted) sim.flags.scriptedBlueDone = true;\n        sim.flags.blueDone = true;\n        return;\n      }\n    } else cb.t -= 3;\n  }\n  if (cb.t <= 0) { sim.tables[cb.table].lost = true; lose(sim, 'codeblue'); }\n}\n\n/* ---- Massage ---- */\nexport function enterMassage(sim, need) {\n  sim.massage = { need, count: 0, last: 0, t: 0, period: 60 / 66, window: 0.26, timer: 40, heldL: false, heldR: false };\n  sim.phase = 'massage';\n  sim.quiet = false;\n  sim.events.push({ t: 'massage', on: true });\n}\nfunction massageStep(sim, inputs) {\n  const m = sim.massage;\n  m.t += DT;\n  m.timer -= DT;\n  const L = inputs.some((i) => i?.padL), R = inputs.some((i) => i?.padR);\n  const press = L && !m.heldL ? 1 : R && !m.heldR ? 2 : 0;\n  m.heldL = L; m.heldR = R;\n  if (press) {\n    const ph = (m.t % m.period), off = Math.min(ph, m.period - ph);\n    if (off <= m.window && press !== m.last) {\n      m.count++;\n      m.last = press;\n      sim.events.push({ t: 'squeeze', side: press, n: m.count });\n      rate(sim, sim.seats[0], off < 0.12 ? 'CLEAN' : 'GOOD', 0, 0);\n    } else {\n      sim.events.push({ t: 'sfx', id: 'tick', x: 0, z: 0 });\n    }\n    if (m.count >= m.need) {\n      sim.massage = null;\n      sim.phase = 'play';\n      sim.flags.massaged = true;\n      sim.events.push({ t: 'massage', on: false });\n      return;\n    }\n  }\n  if (m.timer <= 0) lose(sim, 'massage');\n}\n\n/* ---- gifts ---- */\nfunction giftStep(sim, seat, inp) {\n  const g = !!inp.gift;\n  const rising = g && !seat.giftHeld;\n  seat.giftHeld = g;\n  if (!sim.giftOn) return;\n  if (seat.gift === 'quiet') {\n    if (sim.quiet && sim.quietSeat === seat.i) {\n      if (!g || sim.composure <= 0) { sim.quiet = false; sim.quietSeat = -1; sim.events.push({ t: 'quiet', on: false }); }\n    } else if (rising && !sim.quiet) {\n      if (sim.composure >= 20) { sim.quiet = true; sim.quietSeat = seat.i; sim.counters.quiet = (sim.counters.quiet ?? 0) + 1; sim.events.push({ t: 'quiet', on: true }); sim.flags.usedQuiet = true; }\n      else sim.events.push({ t: 'sfx', id: 'tick', x: seat.x, z: seat.z });\n    }\n  } else if (seat.gift === 'look' && rising) {\n    const cost = sim.cfg.lookCost;\n    if (sim.composure >= cost && sim.ring.length > 0) secondLook(sim, cost);\n    else sim.events.push({ t: 'sfx', id: 'tick', x: seat.x, z: seat.z });\n  }\n}\n\nexport function secondLook(sim, cost) {\n  const framesBack = Math.round(sim.cfg.lookSeconds * 10);\n  const idx = Math.max(0, sim.ring.length - framesBack);\n  const past = sim.ring[idx];\n  const ghosts = sim.seats.map((s) => s.trail.slice());\n  const keepSeats = sim.seats.map((s) => ({ x: s.x, z: s.z, tool: s.tool, lastTool: s.lastTool, table: s.table, score: s.score, ratings: s.ratings, stitches: s.stitches, saves: s.saves, gift: s.gift }));\n  const { ring, checkpoint, events, cfg, meta, checkpointStage } = sim;\n  const composure = Math.max(0, sim.composure - cost);\n  const looks = sim.looks + 1;\n  const copy = structuredClone(past);\n  for (const k of Object.keys(sim)) delete sim[k];\n  Object.assign(sim, copy, { ring: ring.slice(0, idx), checkpoint, events, cfg, meta, checkpointStage, composure, looks });\n  sim.seats.forEach((s, i) => {\n    Object.assign(s, keepSeats[i], { grab: null, stroke: null, useHeld: false, side: 0, drawing: 0, dressing: null, trail: [], giftHeld: true });\n  });\n  sim.ghost = { seats: ghosts, i: 0, t: 0 };\n  sim.flags.usedLook = true;\n  sim.meta.looked = true;\n  sim.events.push({ t: 'look', from: idx });\n}\n\n/* ---- the step ---- */\nconst NO_INPUT = {};\nexport function step(sim, inputs = []) {\n  if (sim.phase === 'won' || sim.phase === 'lost') return;\n  sim.realT += DT;\n  const ins = sim.seats.map((_, i) => inputs[i] ?? NO_INPUT);\n  if (sim.phase === 'codeblue') {\n    readPositions(sim, ins);\n    codeBlueStep(sim, ins);\n    if (sim.phase === 'play' && sim.pendingStage) { sim.pendingStage = false; nextStage(sim); }\n    return;\n  }\n  if (sim.phase === 'massage') {\n    readPositions(sim, ins);\n    massageStep(sim, ins);\n    if (sim.phase === 'play' && sim.pendingStage) { sim.pendingStage = false; nextStage(sim); }\n    return;\n  }\n  readPositions(sim, ins);\n  for (const seat of sim.seats) {\n    if (seat.out) continue;\n    const inp = ins[seat.i];\n    selectTool(sim, seat, inp);\n    if (inp.tag && !seat.tagHeld && sim.tagOn) tagDoctors(sim, seat);\n    seat.tagHeld = !!inp.tag;\n    giftStep(sim, seat, inp);\n    if (sim.opId == null) return;\n  }\n  const slow = sim.quiet ? sim.cfg.quietSlow : 1;\n  const dt = DT * slow;\n  sim.t += dt;\n  sim.stageT += dt;\n  if (sim.quiet && !sim.cheats.infComposure) sim.composure = Math.max(0, sim.composure - sim.cfg.quietDrain * DT);\n  if (sim.cheats.infComposure) sim.composure = 100;\n  for (const seat of sim.seats) {\n    if (seat.out) continue;\n    toolStep(sim, seat, ins[seat.i]);\n    if (sim.phase !== 'play') return;\n    trail(sim, seat, ins[seat.i]);\n  }\n  worldStep(sim, dt);\n  if (sim.phase !== 'play') return;\n  stageLogic(sim);\n  if (sim.phase === 'play') {\n    updateHint(sim);\n    if (++sim.ringN >= 6) { sim.ringN = 0; pushRing(sim); }\n  }\n}\n\nfunction pushRing(sim) {\n  if (sim.seats.every((s) => s.gift !== 'look')) return;\n  sim.ring.push(cloneState(sim));\n  if (sim.ring.length > 42) sim.ring.shift();\n}\n\nfunction readPositions(sim, ins) {\n  for (const seat of sim.seats) {\n    const inp = ins[seat.i];\n    if (inp.x != null) { seat.x = inp.x; seat.z = inp.z; }\n    if (inp.table != null && inp.table !== seat.table && sim.tables[inp.table]) {\n      seat.table = inp.table;\n      sim.events.push({ t: 'table', seat: seat.i, table: inp.table });\n      if (seat.grab) seat.grab = null;\n    }\n  }\n}\n\nfunction selectTool(sim, seat, inp) {\n  if (inp.tool && inp.tool !== seat.tool && TOOLS.includes(inp.tool) && (sim.tools.includes(inp.tool))) {\n    seat.lastTool = seat.tool;\n    seat.tool = inp.tool;\n    seat.drawing = 0;\n    seat.stroke = null;\n    if (seat.grab) seat.grab = null;\n    sim.events.push({ t: 'tool', seat: seat.i, tool: inp.tool });\n  }\n}\n\nfunction tagDoctors(sim, seat) {\n  sim.doctor = sim.doctor === 'ilya' ? 'sabine' : 'ilya';\n  seat.gift = seat.gift === 'quiet' ? 'look' : 'quiet';\n  if (sim.quiet) { sim.quiet = false; sim.quietSeat = -1; sim.events.push({ t: 'quiet', on: false }); }\n  sim.events.push({ t: 'tag', doctor: sim.doctor });\n}\n\nfunction trail(sim, seat, inp) {\n  if (sim.ringN !== 0) return;\n  seat.trail.push(+seat.x.toFixed(2), +seat.z.toFixed(2), inp.use > 0.15 ? 1 : 0);\n  if (seat.trail.length > 150) seat.trail.splice(0, 3);\n}\n\nfunction worldStep(sim, dt) {\n  const def = defOf(sim);\n  // the clock\n  if (!sim.cheats.freezeClock) {\n    sim.clock -= dt;\n    if (sim.clock <= 0) {\n      sim.clock = 0;\n      if (def.clockWins) { win(sim); return; }\n      lose(sim, 'clock');\n      return;\n    }\n  }\n  // grown bleeders\n  for (const e of sim.ents) if (e.k === 'bleeder' && e.r < (e.rMax ?? 1.4)) e.r += (e.grow ?? 0.12) * dt;\n  // vitals\n  if (!sim.quiet) {\n    const diff = DIFFICULTY[sim.difficulty] ?? DIFFICULTY.resident;\n    sim.tables.forEach((t, ti) => {\n      let bleed = 0;\n      for (const e of sim.ents) if (e.table === ti) { const w = KINDS[e.k].bleed; if (w) bleed += w; }\n      const d = Math.min(2, t.drain * diff.drain * sim.cfg.vitalsDrain * sim.coop + bleed * sim.cfg.bleedDrain) * DT;\n      hurt(sim, ti, d);\n      const low = t.vitals < 30;\n      if (low && !t.low) { sim.events.push({ t: 'lowVitals', table: ti }); if (ti === sim.seats[0].table) sayKey(sim, 'reyes.lowVitals'); }\n      t.low = low;\n    });\n    for (let ti = 0; ti < sim.tables.length; ti++) {\n      if (sim.tables[ti].vitals <= 0) {\n        if (sim.codeBlues < sim.saves) enterCodeBlue(sim, ti, false);\n        else { sim.tables[ti].lost = true; lose(sim, 'vitals'); }\n        return;\n      }\n    }\n  }\n  // cold time\n  if (sim.cold) {\n    sim.cold.t -= dt;\n    if (sim.cold.t <= 0) { sim.cold.t = 0; lose(sim, 'cold'); return; }\n  }\n  // heartbeat\n  if (sim.heart) {\n    const before = sim.heart.phase;\n    sim.heart.phase = (sim.heart.phase + (sim.heart.bpm / 60) * dt) % 1;\n    if (sim.heart.phase < before) { sim.heart.beats++; sim.events.push({ t: 'beat', bpm: sim.heart.bpm }); }\n  }\n  // strains\n  for (const e of [...sim.ents]) {\n    if (e.k === 'strain') { STRAINS[e.type]?.step?.(sim, e, dt); if (sim.phase !== 'play') return; }\n    if (e.expires != null) {\n      e.expires -= dt;\n      if (e.expires <= 0) {\n        const owner = e.owner, sig = e.onExpire;\n        removeEnt(sim, e);\n        if (sig) signal(sim, owner, sig, e, sim.seats[0]);\n        if (e.expireCmds) runCmds(sim, e.expireCmds);\n      }\n    }\n  }\n  // droplets and film\n  dropsStep(sim, dt);\n  for (let i = sim.films.length - 1; i >= 0; i--) { sim.films[i].t -= dt; if (sim.films[i].t <= 0) sim.films.splice(i, 1); }\n  // ghost hand\n  if (sim.ghost) { sim.ghost.t += DT; sim.ghost.i = Math.floor(sim.ghost.t * 10); if (sim.ghost.i * 3 >= (sim.ghost.seats[0]?.length ?? 0)) sim.ghost = null; }\n  // the mimic\n  if (sim.mimic) mimicStep(sim);\n}\n\nfunction dropsStep(sim, dt) {\n  for (let i = sim.drops.length - 1; i >= 0; i--) {\n    const d = sim.drops[i];\n    if (d.home) {\n      const s = sim.seats[0], m = Math.hypot(s.x - d.x, s.z - d.z) || 1;\n      d.vx += ((s.x - d.x) / m) * 0.9 * dt; d.vz += ((s.z - d.z) / m) * 0.5 * dt;\n    }\n    d.x += d.vx * dt; d.z += d.vz * dt; d.life -= dt;\n    if (sim.films.some((f) => dist(f.x, f.z, d.x, d.z) < 0.7)) { sim.drops.splice(i, 1); sim.events.push({ t: 'sfx', id: 'fizz', x: d.x, z: d.z }); continue; }\n    if (d.life <= 0 || d.z > 3.3) {\n      sim.drops.splice(i, 1);\n      hurt(sim, d.table, 1);\n      if (sim.ents.filter((e) => e.k === 'nick').length < 8) spawn(sim, { k: 'nick', at: [d.x, Math.min(3, d.z)], table: d.table });\n      sim.events.push({ t: 'sfx', id: 'dropHit', x: d.x, z: d.z });\n    }\n  }\n}\n\nfunction mimicStep(sim) {\n  const m = sim.mimic, s = sim.seats[0];\n  m.cool = Math.max(0, m.cool - DT);\n  const i = s.trail.length - 3 * 30;\n  if (i < 0) { m.x = null; return; }\n  m.x = s.trail[i]; m.z = s.trail[i + 1]; m.use = s.trail[i + 2];\n  if (m.use && m.cool <= 0 && dist(m.x, m.z, s.x, s.z) < 0.7) {\n    m.cool = 1.2;\n    m.hits++;\n    hurt(sim, s.table, 2);\n    spawn(sim, { k: 'nick', at: [m.x, m.z], table: s.table });\n    sim.events.push({ t: 'sfx', id: 'mimicCut', x: m.x, z: m.z });\n    sayKey(sim, 'mimic.hit');\n  }\n}\n\nfunction updateHint(sim) {\n  sim.hint = null;\n  if (sim.noHint) return;\n  const table = sim.seats[0].table;\n  let best = null;\n  const P = { marker: -1, core: 0, eye: 0, dressing: 9 };\n  let bp = 1e9;\n  for (const e of sim.ents) {\n    if (e.table !== table || !visible(e)) continue;\n    const c = KINDS[e.k].cls;\n    if (c === 'strain') continue;\n    const tool = toolFor(e);\n    if (!tool && c !== 'marker' && c !== 'dressing') continue;\n    const p = P[e.k] ?? 3;\n    if (p < bp) { bp = p; best = e; }\n  }\n  if (!best) {\n    const hidden = sim.ents.find((e) => e.table === table && e.scan && !e.seen);\n    if (hidden && sim.tools.includes('scanner')) sim.hint = { x: hidden.x, z: hidden.z, tool: 'scanner', k: 'hidden' };\n    return;\n  }\n  const [x, z] = aimPoint(best);\n  sim.hint = { x, z, tool: toolFor(best), k: best.k, id: best.id };\n}\n\nexport function stageProgress(sim) { return { stage: sim.stage, total: defOf(sim).stages.length }; }\nvoid nextRandom; void rate;\n\n/** Dev Mode actions. */\nexport const dev = {\n  completeStage(sim) { const def = defOf(sim), st = def.stages[sim.stage]; sim.ents.length = 0; sim.drops.length = 0; for (const s of sim.seats) { s.grab = null; s.stroke = null; } if (st?.then) runCmds(sim, st.then); sim.phase = 'play'; sim.codeBlue = null; sim.massage = null; nextStage(sim); },\n  winOp(sim) { sim.phase = 'play'; win(sim); },\n  failOp(sim) { lose(sim, 'dev'); },\n  codeBlue(sim) { enterCodeBlue(sim, sim.seats[0].table, true); },\n  spawn(sim, kind) {\n    const s = sim.seats[0], table = s.table;\n    const at = [s.x, s.z];\n    const map = {\n      pool: { k: 'pool', at, r: 0.9, table },\n      bleeder: { k: 'bleeder', at, r: 0.5, table },\n      laceration: { k: 'laceration', a: [at[0] - 0.8, at[1]], b: [at[0] + 0.8, at[1]], table },\n      hook: { k: 'hook', at, dir: [0.4, -1], pull: 1.1, arc: 0.3, table },\n      strain: { k: 'strain', type: 'introit', hp: 1, at, table },\n    };\n    if (map[kind]) spawn(sim, map[kind]);\n  },\n};\nEOF\ncat > src/sim/strains/index.js <<'EOF'\n// The strains: each a small state machine over plain data.\nimport { spawn, removeEnt, entById } from '../entities.js';\nimport { dist, curve, pointAt, polyLength, smoothPath, clamp } from '../geom.js';\nimport { hurt, say, sayKey, enterMassage, runCmds, enterCodeBlue, addScar, addVitals } from '../op.js';\nimport { nextRandom, rangeOf } from '../../core/rng.js';\n\nconst hpOf = (sim, base) => Math.max(1, Math.round(base * sim.cfg.strainHp));\nconst speedOf = (sim) => sim.cfg.strainSpeed;\nconst clampField = (x, z) => [clamp(x, -5.6, 5.6), clamp(z, -3.2, 2.2)];\nconst ownerOf = (sim, e) => sim.ents.filter((o) => o.owner === e.id);\n\n/* ---------- Introit, the Knock ---------- */\nconst introit = {\n  step(sim, e, dt) {\n    if (!e.init) {\n      e.init = true;\n      e.hp = e.hp ?? hpOf(sim, 3); e.hpMax = e.hp; e.mode = 'roam'; e.timer = e.firstKnock ?? 6; e.speed = 1.6;\n      const R = e.region ?? [-4.5, 4.5, -3, 1.8];\n      const pts = [];\n      for (let i = 0; i < 8; i++) pts.push([rangeOf(sim, R[0], R[1]), rangeOf(sim, R[2], R[3])]);\n      pts.push(pts[0]);\n      e.path = smoothPath(pts, 5); e.len = polyLength(e.path); e.s = 0; e.visibleCore = false;\n    }\n    if (e.mode === 'roam') {\n      e.s = (e.s + e.speed * speedOf(sim) * dt) % e.len;\n      const p = pointAt(e.path, e.s); e.x = p[0]; e.z = p[1];\n      e.timer -= dt;\n      if (e.timer <= 0) {\n        e.mode = 'knock'; e.timer = (e.poreTime ?? 3);\n        const [x, z] = clampField(e.x, e.z); e.x = x; e.z = z;\n        spawn(sim, { k: 'incision', look: 'pore', owner: e.id, sig: 'lanced', table: e.table, line: [[x - 0.4, z - 0.15], [x + 0.4, z + 0.15]], at: [x, z] });\n        sim.events.push({ t: 'sfx', id: 'knock', x, z });\n        sim.events.push({ t: 'knock', x, z });\n        if (!e.knocked) { e.knocked = true; if (!sim.voiceOff && e.talk !== false) say(sim, 'ilya', 'It moved. Nurse Reyes, it *knocked*.'); }\n      }\n    } else if (e.mode === 'knock') {\n      e.timer -= dt;\n      if (e.timer <= 0) { // missed: it tears its way down again\n        for (const o of ownerOf(sim, e)) if (o.k === 'incision') { for (const s of sim.seats) if (s.stroke === o.id) s.stroke = null; removeEnt(sim, o); }\n        spawn(sim, { k: 'laceration', a: [e.x - 0.8, e.z - 0.2], b: [e.x + 0.8, e.z + 0.2], table: e.table });\n        spawn(sim, { k: 'pool', at: [e.x + 0.3, e.z + 0.5], r: 0.8, table: e.table });\n        e.mode = 'roam'; e.timer = 6;\n        sim.events.push({ t: 'sfx', id: 'tetherSnap', x: e.x, z: e.z });\n      }\n    } else if (e.mode === 'exposed') {\n      e.timer -= dt;\n      const core = ownerOf(sim, e).find((o) => o.k === 'core');\n      const held = core && sim.seats.some((s) => s.grab === core.id);\n      if (core) { e.coreX = core.x; e.coreZ = core.z; }\n      if (e.timer <= 0 && !held) {\n        if (core) removeEnt(sim, core);\n        sim.events.push({ t: 'sfx', id: 'tick', x: e.x, z: e.z });\n        e.mode = 'roam'; e.timer = 6;\n      }\n    }\n  },\n  on(sim, e, sig) {\n    if (sig === 'lanced') {\n      e.mode = 'exposed'; e.timer = (e.coreTime ?? 3.5);\n      const dx = e.x > 0 ? -1 : 1, dz = e.z > 0 ? -0.5 : 0.5;\n      const pts = curve([e.x, e.z], [dx, dz], 2.5, 0.25);\n      spawn(sim, { k: 'core', look: 'introit', owner: e.id, sig: 'popped', table: e.table, tether: true, autoFree: true, pts, at: [e.x, e.z], big: 0.2 });\n      sim.events.push({ t: 'sfx', id: 'squelch', x: e.x, z: e.z });\n    } else if (sig === 'popped') {\n      e.hp--;\n      sim.events.push({ t: 'strainHit', id: e.id, type: 'introit', hp: e.hp, x: e.x, z: e.z });\n      sim.events.push({ t: 'sfx', id: 'strainHurt', x: e.x, z: e.z });\n      spawn(sim, { k: 'laceration', a: [e.x - 0.9, e.z - 0.3], b: [e.x + 0.3, e.z + 0.3], table: e.table });\n      spawn(sim, { k: 'laceration', a: clampField(e.x + 0.6, e.z + 0.9), b: clampField(e.x + 1.8, e.z + 0.6), table: e.table });\n      e.speed *= 1.25; e.mode = 'roam'; e.timer = 6;\n      if (e.hp <= 0) {\n        sim.flags[e.doneFlag ?? 'strainDead'] = true;\n        sim.events.push({ t: 'strainDead', type: 'introit', x: e.x, z: e.z });\n        removeEnt(sim, e);\n      } else if (e.talk !== false) sayKey(sim, 'reyes.strainHit');\n    }\n  },\n};\n\n/* ---------- Lacrimosa, the Weeper ---------- */\nconst lacrimosa = {\n  step(sim, e, dt) {\n    if (!e.init) {\n      e.init = true; e.openT = 2; e.dropT = 0; e.sobs = 0; e.sobT = -1; e.halfDone = false; e.hpEach = e.hpEach ?? hpOf(sim, 3);\n      const spots = e.spots ?? [[-3.6, -2], [3.6, -2], [-2.2, 0.8], [2.2, 0.8], [0, -2.8]];\n      for (const [x, z] of spots) spawn(sim, { k: 'eye', look: 'weeper', owner: e.id, sig: 'burned', keep: true, shut: true, eyeHp: e.hpEach, eyeHpMax: e.hpEach, open: 0, at: [x, z], x0: x, z0: z, table: e.table, burnTime: 1.2, size: 0.7 });\n      e.eyesTotal = spots.length; e.hpTotal = spots.length * e.hpEach;\n    }\n    const eyes = ownerOf(sim, e).filter((o) => o.k === 'eye');\n    const hpLeft = eyes.reduce((n, o) => n + o.eyeHp, 0);\n    const half = hpLeft <= e.hpTotal / 2;\n    if (half && !e.halfDone) { e.halfDone = true; sim.events.push({ t: 'sfx', id: 'wail', x: 0, z: -1 }); if (e.talk !== false) sayKey(sim, 'reyes.eyesCrawl'); }\n    // crawling\n    if (half) for (const o of eyes) {\n      o.crawl = (o.crawl ?? nextRandom(sim) * 6) + dt * 0.7;\n      const [x, z] = clampField(o.x0 + Math.sin(o.crawl) * 1.4, o.z0 + Math.cos(o.crawl * 0.7) * 0.8);\n      o.x = x; o.z = z;\n    }\n    const lastEye = eyes.length === 1 && !e.noSob;\n    if (lastEye && e.sobs < 3) { // the Sob\n      for (const o of eyes) o.shut = true;\n      if (e.sobT < 0) {\n        const mask = ownerOf(sim, e).find((o) => o.k === 'mask');\n        if (!mask) {\n          e.sobWait = (e.sobWait ?? 1.6) - dt;\n          if (e.sobWait <= 0) {\n            e.sobWait = 2; e.sobT = 6;\n            const z = -2.4 + e.sobs * 1.5, tilt = e.sobs % 2 ? 0.5 : -0.5;\n            spawn(sim, { k: 'mask', look: 'sob', owner: e.id, sig: 'sobbed', table: e.table, path: [[-4.5, z - tilt], [4.5, z + tilt]], need: 0.8 });\n            sim.events.push({ t: 'sfx', id: 'wail', x: 0, z });\n            sim.events.push({ t: 'prompt', text: 'THE SOB! GEL THE LINE!' });\n          }\n        }\n      } else {\n        e.sobT -= dt;\n        if (e.sobT <= 0) {\n          for (const o of ownerOf(sim, e)) if (o.k === 'mask') removeEnt(sim, o);\n          e.sobT = -1; e.sobs++;\n          hurt(sim, e.table, 25);\n          sim.events.push({ t: 'wave' });\n          sim.events.push({ t: 'sfx', id: 'wave', x: 0, z: 0 });\n        }\n      }\n      return;\n    }\n    // opening in turns\n    e.openT -= dt;\n    const open = eyes.filter((o) => !o.shut);\n    if (e.openT <= 0 && open.length < (half ? 2 : 1) + (eyes.length > 3 ? 0 : 0)) {\n      const shut = eyes.filter((o) => o.shut);\n      if (shut.length) {\n        const o = shut[Math.floor(nextRandom(sim) * shut.length)];\n        o.shut = false; o.open = 0;\n        sim.events.push({ t: 'sfx', id: 'eyeOpen', x: o.x, z: o.z });\n        e.openT = 2.5;\n      }\n    }\n    // weeping\n    e.dropT -= dt;\n    for (const o of open) {\n      o.open += dt;\n      if (o.open >= 8) { // left open: it heals\n        o.shut = true; o.eyeHp = Math.min(o.eyeHpMax, o.eyeHp + 1); e.openT = 1.5;\n        sim.events.push({ t: 'sfx', id: 'heal', x: o.x, z: o.z });\n      }\n    }\n    if (e.dropT <= 0 && open.length) {\n      e.dropT = 0.95 / (sim.coop ?? 1);\n      const o = open[Math.floor(nextRandom(sim) * open.length)];\n      sim.drops.push({ x: o.x, z: o.z + 0.2, vx: rangeOf(sim, -0.35, 0.35), vz: 1.5 * speedOf(sim), life: 3.2, table: e.table, home: half });\n      sim.events.push({ t: 'sfx', id: 'drip', x: o.x, z: o.z });\n    }\n  },\n  on(sim, e, sig, o, seat) {\n    if (sig === 'burned') {\n      o.shut = true; o.eyeHp--; e.openT = 1.2;\n      sim.events.push({ t: 'strainHit', id: e.id, type: 'lacrimosa', hp: o.eyeHp, x: o.x, z: o.z });\n      sim.events.push({ t: 'sfx', id: 'strainHurt', x: o.x, z: o.z });\n      if (o.eyeHp <= 0) {\n        removeEnt(sim, o);\n        addScar(sim, { k: 'burn', x: o.x, z: o.z, table: o.table });\n        const left = ownerOf(sim, e).filter((p) => p.k === 'eye').length;\n        if (left === 0) {\n          if (e.noStalk) { finish(sim, e); return; }\n          const [x, z] = [o.x, o.z];\n          sim.events.push({ t: 'sfx', id: 'wail', x, z });\n          spawn(sim, { k: 'stalk', look: 'stalk', owner: e.id, sig: 'stalkOut', table: e.table, tether: true, autoFree: true, snapCuts: true, pts: curve([x, z], [x > 0 ? -1 : 1, 0.2], 2.4, 0.3), at: [x, z], big: 0.2 });\n          if (e.talk !== false) sayKey(sim, 'reyes.stalk');\n        }\n      }\n    } else if (sig === 'stalkOut') finish(sim, e);\n    else if (sig === 'sobbed') { e.sobT = -1; e.sobs++; sim.events.push({ t: 'sfx', id: 'heal', x: 0, z: 0 }); }\n    void seat;\n  },\n};\nfunction finish(sim, e) {\n  sim.flags[e.doneFlag ?? 'strainDead'] = true;\n  sim.events.push({ t: 'strainDead', type: e.type, x: e.x, z: e.z });\n  removeEnt(sim, e);\n}\n\n/* ---------- Dies Irae, the Wrath ---------- */\nconst irae = {\n  step(sim, e, dt) {\n    if (!e.init) {\n      e.init = true;\n      if (!sim.heart) sim.heart = { bpm: e.bpm ?? sim.cfg.irae, phase: 0.4, beats: 0 };\n      e.rounds = e.rounds ?? [2, 2, 3]; e.round = 0; e.mode = 'plates'; e.flareT = 7; e.fibbed = 0;\n      e.ring = [];\n      const n = e.rounds.reduce((a, b) => a + b, 0);\n      for (let i = 0; i < n; i++) { const a = -Math.PI / 2 + (i / n) * Math.PI * 2; e.ring.push([+(e.x + Math.cos(a) * 2).toFixed(2), +(e.z + Math.sin(a) * 1.7).toFixed(2), 1]); }\n      e.next = 0; startPlates(sim, e);\n    }\n    e.flareT -= dt;\n    if (e.flareT <= 0 && e.mode !== 'final') { // wrath flares\n      e.flareT = 7 / sim.coop;\n      const a = nextRandom(sim) * Math.PI * 2;\n      const [x, z] = clampField(e.x + Math.cos(a) * 3.2, e.z + Math.sin(a) * 2.4);\n      spawn(sim, { k: 'bleeder', at: [x, z], r: 0.6, rMax: 1.1, table: e.table, look: 'flare' });\n      sim.events.push({ t: 'sfx', id: 'flare', x, z });\n    }\n    if (sim.heart.bpm >= 120) { // fibrillation\n      sim.heart.bpm = 96; e.fibbed++;\n      sim.events.push({ t: 'prompt', text: 'FIBRILLATION! PADDLES!' });\n      if (e.talk !== false) sayKey(sim, 'reyes.fib');\n      enterCodeBlue(sim, e.table, true);\n    }\n  },\n  on(sim, e, sig, o) {\n    if (sig === 'plateCut') {\n      spawn(sim, { k: 'plate', look: 'plate', owner: e.id, sig: 'plateOff', onBeat: true, table: e.table, ringIx: o.ringIx, pts: curve([o.x0 ?? o.x, o.z0 ?? o.z], [(o.x0 ?? o.x) - e.x, (o.z0 ?? o.z) - e.z], 1.1, 0), at: [o.x0 ?? o.x, o.z0 ?? o.z], big: 0.2 });\n    } else if (sig === 'plateOff') {\n      e.ring[o.ringIx][2] = 0;\n      sim.heart.bpm += 6;\n      sim.events.push({ t: 'bpm', bpm: sim.heart.bpm });\n      sim.events.push({ t: 'sfx', id: 'plateCrack', x: o.x, z: o.z });\n      if (!ownerOf(sim, e).some((p) => p.k === 'plate' || p.k === 'incision')) {\n        spawn(sim, { k: 'eye', look: 'wrath', owner: e.id, sig: 'eyeBurned', onBeat: true, at: [e.x, e.z], table: e.table, burnTime: 0.9, size: 0.8 });\n        sim.events.push({ t: 'sfx', id: 'eyeOpen', x: e.x, z: e.z });\n        if (e.talk !== false) sayKey(sim, 'reyes.eyeOpen');\n      }\n    } else if (sig === 'eyeBurned') {\n      sim.events.push({ t: 'strainHit', id: e.id, type: 'irae', hp: e.rounds.length - e.round - 1, x: e.x, z: e.z });\n      sim.events.push({ t: 'sfx', id: 'strainHurt', x: e.x, z: e.z });\n      e.round++;\n      if (e.round >= e.rounds.length) {\n        if (e.noArrest) { finish(sim, e); return; }\n        e.mode = 'final';\n        sim.heart.bpm = 60;\n        sim.events.push({ t: 'sfx', id: 'flatline', x: 0, z: 0 });\n        say(sim, 'reyes', 'He arrested! Both hands, Doctor! *On the beat!*');\n        enterMassage(sim, 8);\n        sim.flags.iraeArrest = true;\n      } else startPlates(sim, e);\n    } else if (sig === 'finalCut') finish(sim, e);\n    else if (sig === 'dose') { sim.heart.bpm = Math.max(60, sim.heart.bpm - 12); sim.events.push({ t: 'bpm', bpm: sim.heart.bpm }); }\n  },\n};\nfunction startPlates(sim, e) {\n  const n = e.rounds[e.round];\n  for (let i = 0; i < n; i++) {\n    const ix = e.next++;\n    const [x, z] = e.ring[ix];\n    const dx = x - e.x, dz = z - e.z, m = Math.hypot(dx, dz) || 1, nx = -dz / m, nz = dx / m;\n    spawn(sim, { k: 'incision', look: 'plateCut', owner: e.id, sig: 'plateCut', onBeat: true, ringIx: ix, x0: x, z0: z, table: e.table, line: [[x - nx * 0.5, z - nz * 0.5], [x + nx * 0.5, z + nz * 0.5]], at: [x, z] });\n  }\n}\n\n/* ---------- Miserere ---------- */\nconst miserere = {\n  step(sim, e, dt) {\n    if (!e.init) {\n      e.init = true; e.hp = hpOf(sim, 3); e.hpMax = e.hp; e.mode = 'drift'; e.timer = 3; e.a = 0;\n      sim.mimic = { hits: 0, cool: 0 };\n    }\n    if (e.mode === 'pull' || e.mode === 'gone') return;\n    e.a += dt * 0.5 * speedOf(sim);\n    if (e.mode === 'drift') {\n      e.x = Math.sin(e.a) * 3.6; e.z = -0.6 + Math.sin(e.a * 1.7) * 1.8;\n      e.timer -= dt;\n      if (e.timer <= 0) {\n        e.mode = 'veiled'; e.timer = 7;\n        spawn(sim, { k: 'incision', look: 'veil', owner: e.id, sig: 'unveiled', table: e.table, smooth: [[e.x - 0.8, e.z - 0.3], [e.x, e.z + 0.45], [e.x + 0.8, e.z - 0.3]], expires: 7, onExpire: 'veilShut' });\n        sim.events.push({ t: 'sfx', id: 'choir', x: e.x, z: e.z });\n      }\n    }\n  },\n  on(sim, e, sig) {\n    if (sig === 'unveiled') {\n      e.mode = 'bare';\n      spawn(sim, { k: 'eye', look: 'halo', owner: e.id, sig: 'burned', at: [e.x, e.z], table: e.table, burnTime: 1.1, size: 0.8, expires: 5, onExpire: 'veilShut' });\n    } else if (sig === 'veilShut') {\n      e.mode = 'drift'; e.timer = 3;\n    } else if (sig === 'burned') {\n      e.hp--;\n      sim.events.push({ t: 'strainHit', id: e.id, type: 'miserere', hp: e.hp, x: e.x, z: e.z });\n      sim.events.push({ t: 'sfx', id: 'choir', x: e.x, z: e.z });\n      if (e.hp <= 0) {\n        e.mode = 'pull';\n        sim.mimic = null;\n        sim.events.push({ t: 'prompt', text: 'BOTH HANDS ON THE TETHER!' });\n        spawn(sim, { k: 'core', look: 'miserere', owner: e.id, sig: 'pulledOut', table: e.table, tether: true, autoFree: true, shared: true, need2: sim.seats.length > 1, snapCuts: false, pts: curve([e.x, e.z], [e.x > 0 ? -1 : 1, 0.4], 3, 0.3), at: [e.x, e.z], big: 0.35 });\n      } else { e.mode = 'drift'; e.timer = 3; }\n    } else if (sig === 'pulledOut') {\n      sim.flags.miserereOut = true;\n      sim.events.push({ t: 'strainDead', type: 'miserere', x: e.x, z: e.z });\n      removeEnt(sim, e);\n    }\n  },\n};\n\n/* ---------- Pile-Up: Consult's waves ---------- */\nconst pileup = {\n  step(sim, e, dt) {\n    if (!e.init) { e.init = true; e.wave = 0; e.timer = 2; e.surgeT = 34; e.bossDone = false; }\n    e.timer -= dt * sim.coop;\n    const busy = sim.ents.filter((o) => o.k !== 'strain').length;\n    if (e.timer <= 0 && busy < 14) {\n      e.timer = Math.max(5, 11 - e.wave * 0.5);\n      e.wave++;\n      const r = () => [rangeOf(sim, -5.2, 5.2), rangeOf(sim, -3.2, 2)];\n      const n = 2 + Math.min(4, Math.floor(e.wave / 2));\n      for (let i = 0; i < n; i++) {\n        const kind = Math.floor(nextRandom(sim) * 4), at = r();\n        if (kind === 0) spawn(sim, { k: 'pool', at, r: rangeOf(sim, 0.7, 1.2), table: 0 });\n        else if (kind === 1) spawn(sim, { k: 'hook', at, dir: [rangeOf(sim, -1, 1), -1], pull: 1.1, arc: 0.35, table: 0 });\n        else if (kind === 2) { const b = clampField(at[0] + rangeOf(sim, 1, 1.8), at[1] + rangeOf(sim, -0.5, 0.5)); spawn(sim, { k: 'laceration', a: at, b, table: 0 }); }\n        else spawn(sim, { k: 'polyp', at, table: 0 });\n      }\n      sim.events.push({ t: 'sfx', id: 'alarm', x: 0, z: 0 });\n    }\n    e.surgeT -= dt;\n    if (e.surgeT <= 0) { // a surge\n      e.surgeT = 30;\n      for (let i = 0; i < 3; i++) spawn(sim, { k: 'bleeder', at: [rangeOf(sim, -5, 5), rangeOf(sim, -3, 2)], r: 0.6, rMax: 1.2, table: 0 });\n      sim.events.push({ t: 'prompt', text: 'SURGE! DRAIN IT!' });\n    }\n    if (!e.bossDone && sim.clock <= (e.bossAt ?? 40)) {\n      e.bossDone = true;\n      sim.events.push({ t: 'prompt', text: 'SOMETHING KNOCKS...' });\n      spawn(sim, { k: 'strain', type: 'introit', hp: 2, at: [0, 0], table: 0, firstKnock: 2, talk: false, doneFlag: 'smallDead' });\n    }\n  },\n};\n\n/* ---------- The false monitor and the reprise are stage data; these fights only need flags. ---------- */\nexport const STRAINS = { introit, lacrimosa, irae, miserere, pileup };\nvoid entById; void runCmds; void dist; void addVitals;\nEOF\n","description":"Write op core and strain state machines"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":22071,"cache_read_input_tokens":147148,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":22071},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9464247a-cdba-4289-905c-cd8b34e5d270","uuid":"729bd767-cf8b-4b6c-a8b8-6c0d47a07af3","timestamp":"2026-11-05T16:37:53.473Z","request_id":"req_011Cgk72QqhVipR7zJ6nMcPW","wire_tool_inputs":{"toolu_011zhbAXxv9bqSnNcfp7jVUg":{"command":"cat > src/sim/op.js <<'EOF'\n// The operation: createOp / step / drainEvents. Plain data and pure functions; no engine, DOM or clock.\nimport { config as liveConfig, DIFFICULTY } from '../core/config.js';\nimport { hashString, nextRandom } from '../core/rng.js';\nimport { LINES } from '../content/lines.js';\nimport { dist } from './geom.js';\nimport { KINDS, removeEnt, spawn, entBySid, visible, toolFor, aimPoint, entById } from './entities.js';\nimport { TOOLS, toolStep } from './tools.js';\nimport { STRAINS } from './strains/index.js';\nimport { rate, MISTAKE_COST } from './scoring.js';\n\nconst DT = 1 / 60;\nconst DEFS = new Map();\nexport const registerOp = (def) => { DEFS.set(def.id, def); return def; };\nexport const defOf = (sim) => DEFS.get(sim.opId);\n\nfunction makeSeat(i, def, opts) {\n  const tool = def.startTool ?? def.tools[0] ?? 'drain';\n  const gift = opts.gifts?.[i] ?? (i % 2 === 0 ? (def.surgeon === 'sabine' ? 'look' : 'quiet') : 'look');\n  return {\n    i, x: [1.5, -1.5, 1.5, -1.5][i], z: [1.2, 1.2, -1.2, -1.2][i], table: 0, tool, lastTool: tool, gift,\n    useHeld: false, grab: null, grabT: 0, cool: 0, dryT: 0, strayT: 0, stroke: null, side: 0, drawing: 0, dressing: null,\n    giftHeld: false, tagHeld: false, swHeld: 0, trail: [], score: 0, stitches: 0, drained: 0, devSum: 0, devT: 0, saves: 0,\n    ratings: { CLEAN: 0, GOOD: 0, SLOPPY: 0, MISTAKE: 0 }, padL: false, padR: false, beatHit: -1, out: false,\n  };\n}\n\nexport function createOp(def, { seed = 1, seats = 1, difficulty = 'resident', cfg = liveConfig, stage = 0, cheats = {}, gifts = null, retried = false, session = false } = {}) {\n  registerOp(def);\n  const diff = DIFFICULTY[difficulty] ?? DIFFICULTY.resident;\n  const tablesDef = def.tables ?? [{ vitals: def.vitals.start }];\n  const coop = 1 + (cfg.coopScale ?? 0.25) * (seats - 1);\n  const time = def.time * diff.time * cfg.timeLimit;\n  const sim = {\n    opId: def.id, seed, rng: (hashString(def.id) ^ seed) | 0, difficulty, session,\n    t: 0, realT: 0, clock: time, clockMax: time, phase: 'play', stage: -1, stageT: 0,\n    tables: tablesDef.map((t) => ({ vitals: t.vitals, drain: def.vitals.drain, fake: null, lost: false, name: t.name ?? null, low: false })),\n    ents: [], nextId: 1, drops: [], films: [], scars: [], flags: {}, fired: {}, counters: {},\n    tools: [...def.tools], def_film: !!def.film, composure: def.composure ?? 40, giftOn: !!(def.gifts && def.gifts.length),\n    score: 0, streak: 0, bestStreak: 0, mistakes: 0, doses: def.doses, port: def.port ?? [-5.2, 2.2],\n    ratings: { CLEAN: 0, GOOD: 0, SLOPPY: 0, MISTAKE: 0 },\n    codeBlues: 0, saves: diff.saves, unscriptedBlue: false, retried, looks: 0, codeBlue: null, massage: null,\n    quiet: false, quietSeat: -1, heart: null, ghost: null, mimic: null, cold: null, pain: def.pain ?? null,\n    voiceOff: !!def.noVoice, noHint: !!def.noHint || !diff.hint, hint: null, doctor: def.surgeon ?? 'ilya',\n    music: def.music ?? 'or-calm', lastQuip: -9, lineIx: {}, coop, camera: null,\n    seats: Array.from({ length: seats }, (_, i) => makeSeat(i, def, { gifts })),\n    cfg, cheats: { god: false, infComposure: false, freezeClock: false, unlimitedMistakes: false, ...cheats },\n    events: [], ring: [], ringN: 0, checkpoint: null, meta: {},\n  };\n  if (stage > 0) {\n    for (let i = 0; i < stage && i < def.stages.length; i++) if (def.stages[i].jump) runCmds(sim, def.stages[i].jump, true);\n    sim.stage = stage - 1;\n    sim.ents.length = 0;\n  }\n  nextStage(sim);\n  return sim;\n}\n\nexport const drainEvents = (sim) => { const e = sim.events; sim.events = []; return e; };\n\n/** Copy of the state without the things that aren't part of a moment. */\nexport function cloneState(sim) {\n  const { ring, checkpoint, events, cfg, meta } = sim;\n  sim.ring = null; sim.checkpoint = null; sim.events = null; sim.cfg = null; sim.meta = null;\n  const c = structuredClone(sim);\n  sim.ring = ring; sim.checkpoint = checkpoint; sim.events = events; sim.cfg = cfg; sim.meta = meta;\n  return c;\n}\nexport function hashSim(sim) { return hashString(JSON.stringify(cloneState(sim))).toString(16); }\n\n/* ---- comm ---- */\nexport function say(sim, who, text, force = false) {\n  if (sim.voiceOff && !force) return;\n  sim.events.push({ t: 'say', who, text });\n}\nexport function sayKey(sim, key) {\n  const [who] = key.split('.');\n  const pool = LINES[key];\n  if (!pool) return;\n  const n = (sim.lineIx[key] = (sim.lineIx[key] ?? -1) + 1);\n  const line = pool[n % pool.length];\n  say(sim, who === 'false' ? 'reyes' : who, line);\n}\n\n/* ---- vitals and mistakes ---- */\nexport function addVitals(sim, table, v) {\n  const t = sim.tables[table] ?? sim.tables[0];\n  t.vitals = Math.max(0, Math.min(99, t.vitals + v));\n}\nexport function hurt(sim, table, v) {\n  if (sim.cheats.god) { const t = sim.tables[table]; t.vitals = Math.max(5, t.vitals - v); return; }\n  addVitals(sim, table, -v);\n}\nexport function mistake(sim, seat, reason, x, z) {\n  sim.mistakes++;\n  sim.ratings.MISTAKE++;\n  seat.ratings.MISTAKE++;\n  sim.score = Math.max(0, sim.score - MISTAKE_COST);\n  seat.score = Math.max(0, seat.score - MISTAKE_COST);\n  sim.streak = 0;\n  hurt(sim, seat.table, sim.cfg.mistakePenalty);\n  sim.events.push({ t: 'rate', r: 'MISTAKE', x, z, seat: seat.i, reason, pts: -MISTAKE_COST });\n  sayKey(sim, 'reyes.mistake');\n  if (sim.cfg.maxMistakes > 0 && !sim.cheats.unlimitedMistakes && sim.mistakes >= sim.cfg.maxMistakes) lose(sim, 'mistakes');\n}\nexport function addScar(sim, scar) {\n  sim.scars.push(scar);\n  if (sim.scars.length > 60) sim.scars.shift();\n}\nexport function lose(sim, why) {\n  if (sim.phase === 'lost' || sim.phase === 'won') return;\n  sim.phase = 'lost';\n  sim.loseWhy = why;\n  sim.codeBlue = null;\n  sim.events.push({ t: 'lost', why });\n}\nexport function win(sim) {\n  if (sim.phase === 'lost' || sim.phase === 'won') return;\n  sim.phase = 'won';\n  sim.events.push({ t: 'won' });\n}\n\n/* ---- strains ---- */\nexport function signal(sim, ownerId, sig, ent, seat) {\n  const owner = entById(sim, ownerId);\n  if (!owner || owner.k !== 'strain') return;\n  STRAINS[owner.type]?.on?.(sim, owner, sig, ent, seat);\n}\nexport function inSystole(sim) { return !!sim.heart && sim.heart.phase < 0.35; }\n\n/* ---- commands: what stages and entities can do, as data ---- */\nexport function runCmds(sim, cmds, silent = false) {\n  for (const c of Array.isArray(cmds) ? cmds : [cmds]) {\n    if (c.say) { if (!silent) { if (Array.isArray(c.say)) say(sim, c.say[0], c.say[1], !!c.force); else sayKey(sim, c.say); } }\n    if (c.spawn) for (const d of c.spawn) spawn(sim, d);\n    if (c.remove) for (const sid of c.remove) { const e = entBySid(sim, sid); if (e) removeEnt(sim, e); }\n    if (c.removeKinds) for (const e of [...sim.ents]) if (c.removeKinds.includes(e.k)) removeEnt(sim, e);\n    if (c.unlock) { const list = Array.isArray(c.unlock) ? c.unlock : [c.unlock]; for (const u of list) { if (u === 'gift') sim.giftOn = true; else if (!sim.tools.includes(u)) { sim.tools.push(u); sim.events.push({ t: 'unlock', tool: u }); } else { const e = entBySid(sim, u); if (e) delete e.locked; } const e = entBySid(sim, u); if (e) delete e.locked; } }\n    if (c.setDrain != null) for (const t of sim.tables) t.drain = c.setDrain;\n    if (c.music) { sim.music = c.music; sim.events.push({ t: 'music', id: c.music }); }\n    if (c.camera) { sim.camera = c.camera; sim.events.push({ t: 'camera', id: c.camera }); }\n    if (c.flag) sim.flags[c.flag] = true;\n    if (c.codeBlue) enterCodeBlue(sim, c.table ?? 0, true);\n    if (c.massage) enterMassage(sim, c.massage);\n    if (c.vitals != null) addVitals(sim, c.table ?? 0, c.vitals);\n    if (c.setVitals != null) sim.tables[c.table ?? 0].vitals = c.setVitals;\n    if (c.fake !== undefined) sim.tables[c.table ?? 0].fake = c.fake;\n    if (c.composure != null) sim.composure = Math.min(100, Math.max(sim.composure, c.composure));\n    if (c.hurt != null) hurt(sim, c.table ?? 0, c.hurt);\n    if (c.pain != null) sim.pain = c.pain;\n    if (c.cold != null) sim.cold = c.cold ? { t: c.cold, max: c.cold } : null;\n    if (c.pinkUp) sim.events.push({ t: 'pinkUp' });\n    if (c.sfx) sim.events.push({ t: 'sfx', id: c.sfx, x: 0, z: 0 });\n    if (c.voice != null) sim.voiceOff = !c.voice;\n    if (c.fx) sim.events.push({ t: 'fx', id: c.fx });\n    if (c.prompt) sim.events.push({ t: 'prompt', text: c.prompt });\n    if (c.mimic != null) sim.mimic = c.mimic ? { hits: 0, cool: 0 } : null;\n    if (c.heart) sim.heart = { bpm: c.heart, phase: 0.4, beats: 0 };\n    if (c.noHeart) sim.heart = null;\n    if (c.addTime != null) { sim.clock += c.addTime; sim.clockMax = Math.max(sim.clockMax, sim.clock); }\n    if (c.tag) sim.tagOn = true;\n    if (c.win) win(sim);\n  }\n}\n\nfunction nextStage(sim) {\n  const def = defOf(sim);\n  sim.stage++;\n  sim.stageT = 0;\n  sim.fired = {};\n  if (sim.stage >= def.stages.length) { win(sim); return; }\n  const st = def.stages[sim.stage];\n  sim.events.push({ t: 'stage', i: sim.stage, id: st.id });\n  if (st.begin) runCmds(sim, st.begin);\n  if (st.say) runCmds(sim, { say: st.say });\n  if (st.spawn) for (const d of st.spawn) spawn(sim, d);\n  if (st.music) runCmds(sim, { music: st.music });\n  if (sim.phase === 'play' || sim.phase === 'codeblue') {\n    sim.checkpoint = cloneState(sim);\n    sim.checkpointStage = sim.stage;\n  }\n}\n\n/** Is a stage's `until` satisfied? */\nexport function check(sim, u) {\n  if (!u) return false;\n  if (u.all) return u.all.every((c) => check(sim, c));\n  if (u.any) return u.any.some((c) => check(sim, c));\n  if (u.clear) return !sim.ents.some((e) => u.clear.includes(e.k) && !e.isFalse && (u.table == null || e.table === u.table));\n  if (u.flag) return !!sim.flags[u.flag];\n  if (u.time != null) return sim.stageT >= u.time;\n  if (u.sids) return !u.sids.some((sid) => entBySid(sim, sid));\n  return false;\n}\n\nfunction stageLogic(sim) {\n  const def = defOf(sim);\n  const st = def.stages[sim.stage];\n  if (!st) return;\n  if (st.timed) for (let i = 0; i < st.timed.length; i++) {\n    const tm = st.timed[i];\n    if (sim.fired[`t${i}`]) continue;\n    const go = tm.t != null ? sim.stageT >= tm.t : check(sim, tm.when);\n    if (go) { sim.fired[`t${i}`] = true; runCmds(sim, tm); }\n  }\n  const low = st.on?.vitalsBelow;\n  if (low) for (const k of Object.keys(low)) {\n    const key = `v${k}`;\n    if (!sim.fired[key] && sim.tables.some((t) => t.vitals < +k)) { sim.fired[key] = true; runCmds(sim, low[k]); }\n  }\n  if (check(sim, st.until)) {\n    if (st.then) runCmds(sim, st.then);\n    if (sim.phase === 'play') nextStage(sim);\n    else sim.pendingStage = true;\n  }\n}\n\n/* ---- Code Blue ---- */\nexport function enterCodeBlue(sim, table, scripted) {\n  if (sim.cheats.god && !scripted) return;\n  sim.codeBlue = { t: 12, shocks: 0, need: 2, charge: 0, needle: 0, charging: false, cool: 0.5, scripted, table, zone: sim.cfg.codeBlueZone, centre: 0.72, bad: 0 };\n  sim.phase = 'codeblue';\n  sim.quiet = false;\n  if (!scripted) { sim.codeBlues++; sim.unscriptedBlue = true; }\n  else sim.tables[table].vitals = Math.min(sim.tables[table].vitals, 0);\n  sim.events.push({ t: 'codeblue', on: true, scripted, table });\n}\nfunction codeBlueStep(sim, inputs) {\n  const cb = sim.codeBlue;\n  cb.t -= DT;\n  cb.cool = Math.max(0, cb.cool - DT);\n  const anyL = inputs.some((i) => i?.padL), anyR = inputs.some((i) => i?.padR);\n  const both = (anyL && anyR) || inputs.some((i) => i?.padL && i?.padR);\n  if (both && cb.cool <= 0) {\n    if (!cb.charging) sim.events.push({ t: 'sfx', id: 'charge' });\n    cb.charging = true;\n    cb.charge += DT;\n    cb.needle = 0.5 - 0.5 * Math.cos((cb.charge / 1.2) * Math.PI * 2);\n  } else if (cb.charging) {\n    cb.charging = false;\n    const good = Math.abs(cb.needle - cb.centre) <= cb.zone / 2;\n    cb.charge = 0;\n    cb.cool = 0.35;\n    sim.events.push({ t: 'shock', good, n: cb.shocks + (good ? 1 : 0) });\n    if (good) {\n      cb.shocks++;\n      for (const i of inputs.keys()) if (inputs[i]?.padL || inputs[i]?.padR || inputs.length === 1) sim.seats[i].saves++;\n      if (cb.shocks >= cb.need) {\n        sim.tables[cb.table].vitals = Math.max(25, sim.tables[cb.table].vitals);\n        sim.phase = 'play';\n        sim.codeBlue = null;\n        sim.events.push({ t: 'codeblue', on: false });\n        if (cb.scripted) sim.flags.scriptedBlueDone = true;\n        sim.flags.blueDone = true;\n        return;\n      }\n    } else cb.t -= 3;\n  }\n  if (cb.t <= 0) { sim.tables[cb.table].lost = true; lose(sim, 'codeblue'); }\n}\n\n/* ---- Massage ---- */\nexport function enterMassage(sim, need) {\n  sim.massage = { need, count: 0, last: 0, t: 0, period: 60 / 66, window: 0.26, timer: 40, heldL: false, heldR: false };\n  sim.phase = 'massage';\n  sim.quiet = false;\n  sim.events.push({ t: 'massage', on: true });\n}\nfunction massageStep(sim, inputs) {\n  const m = sim.massage;\n  m.t += DT;\n  m.timer -= DT;\n  const L = inputs.some((i) => i?.padL), R = inputs.some((i) => i?.padR);\n  const press = L && !m.heldL ? 1 : R && !m.heldR ? 2 : 0;\n  m.heldL = L; m.heldR = R;\n  if (press) {\n    const ph = (m.t % m.period), off = Math.min(ph, m.period - ph);\n    if (off <= m.window && press !== m.last) {\n      m.count++;\n      m.last = press;\n      sim.events.push({ t: 'squeeze', side: press, n: m.count });\n      rate(sim, sim.seats[0], off < 0.12 ? 'CLEAN' : 'GOOD', 0, 0);\n    } else {\n      sim.events.push({ t: 'sfx', id: 'tick', x: 0, z: 0 });\n    }\n    if (m.count >= m.need) {\n      sim.massage = null;\n      sim.phase = 'play';\n      sim.flags.massaged = true;\n      sim.events.push({ t: 'massage', on: false });\n      return;\n    }\n  }\n  if (m.timer <= 0) lose(sim, 'massage');\n}\n\n/* ---- gifts ---- */\nfunction giftStep(sim, seat, inp) {\n  const g = !!inp.gift;\n  const rising = g && !seat.giftHeld;\n  seat.giftHeld = g;\n  if (!sim.giftOn) return;\n  if (seat.gift === 'quiet') {\n    if (sim.quiet && sim.quietSeat === seat.i) {\n      if (!g || sim.composure <= 0) { sim.quiet = false; sim.quietSeat = -1; sim.events.push({ t: 'quiet', on: false }); }\n    } else if (rising && !sim.quiet) {\n      if (sim.composure >= 20) { sim.quiet = true; sim.quietSeat = seat.i; sim.counters.quiet = (sim.counters.quiet ?? 0) + 1; sim.events.push({ t: 'quiet', on: true }); sim.flags.usedQuiet = true; }\n      else sim.events.push({ t: 'sfx', id: 'tick', x: seat.x, z: seat.z });\n    }\n  } else if (seat.gift === 'look' && rising) {\n    const cost = sim.cfg.lookCost;\n    if (sim.composure >= cost && sim.ring.length > 0) secondLook(sim, cost);\n    else sim.events.push({ t: 'sfx', id: 'tick', x: seat.x, z: seat.z });\n  }\n}\n\nexport function secondLook(sim, cost) {\n  const framesBack = Math.round(sim.cfg.lookSeconds * 10);\n  const idx = Math.max(0, sim.ring.length - framesBack);\n  const past = sim.ring[idx];\n  const ghosts = sim.seats.map((s) => s.trail.slice());\n  const keepSeats = sim.seats.map((s) => ({ x: s.x, z: s.z, tool: s.tool, lastTool: s.lastTool, table: s.table, score: s.score, ratings: s.ratings, stitches: s.stitches, saves: s.saves, gift: s.gift }));\n  const { ring, checkpoint, events, cfg, meta, checkpointStage } = sim;\n  const composure = Math.max(0, sim.composure - cost);\n  const looks = sim.looks + 1;\n  const copy = structuredClone(past);\n  for (const k of Object.keys(sim)) delete sim[k];\n  Object.assign(sim, copy, { ring: ring.slice(0, idx), checkpoint, events, cfg, meta, checkpointStage, composure, looks });\n  sim.seats.forEach((s, i) => {\n    Object.assign(s, keepSeats[i], { grab: null, stroke: null, useHeld: false, side: 0, drawing: 0, dressing: null, trail: [], giftHeld: true });\n  });\n  sim.ghost = { seats: ghosts, i: 0, t: 0 };\n  sim.flags.usedLook = true;\n  sim.meta.looked = true;\n  sim.events.push({ t: 'look', from: idx });\n}\n\n/* ---- the step ---- */\nconst NO_INPUT = {};\nexport function step(sim, inputs = []) {\n  if (sim.phase === 'won' || sim.phase === 'lost') return;\n  sim.realT += DT;\n  const ins = sim.seats.map((_, i) => inputs[i] ?? NO_INPUT);\n  if (sim.phase === 'codeblue') {\n    readPositions(sim, ins);\n    codeBlueStep(sim, ins);\n    if (sim.phase === 'play' && sim.pendingStage) { sim.pendingStage = false; nextStage(sim); }\n    return;\n  }\n  if (sim.phase === 'massage') {\n    readPositions(sim, ins);\n    massageStep(sim, ins);\n    if (sim.phase === 'play' && sim.pendingStage) { sim.pendingStage = false; nextStage(sim); }\n    return;\n  }\n  readPositions(sim, ins);\n  for (const seat of sim.seats) {\n    if (seat.out) continue;\n    const inp = ins[seat.i];\n    selectTool(sim, seat, inp);\n    if (inp.tag && !seat.tagHeld && sim.tagOn) tagDoctors(sim, seat);\n    seat.tagHeld = !!inp.tag;\n    giftStep(sim, seat, inp);\n    if (sim.opId == null) return;\n  }\n  const slow = sim.quiet ? sim.cfg.quietSlow : 1;\n  const dt = DT * slow;\n  sim.t += dt;\n  sim.stageT += dt;\n  if (sim.quiet && !sim.cheats.infComposure) sim.composure = Math.max(0, sim.composure - sim.cfg.quietDrain * DT);\n  if (sim.cheats.infComposure) sim.composure = 100;\n  for (const seat of sim.seats) {\n    if (seat.out) continue;\n    toolStep(sim, seat, ins[seat.i]);\n    if (sim.phase !== 'play') return;\n    trail(sim, seat, ins[seat.i]);\n  }\n  worldStep(sim, dt);\n  if (sim.phase !== 'play') return;\n  stageLogic(sim);\n  if (sim.phase === 'play') {\n    updateHint(sim);\n    if (++sim.ringN >= 6) { sim.ringN = 0; pushRing(sim); }\n  }\n}\n\nfunction pushRing(sim) {\n  if (sim.seats.every((s) => s.gift !== 'look')) return;\n  sim.ring.push(cloneState(sim));\n  if (sim.ring.length > 42) sim.ring.shift();\n}\n\nfunction readPositions(sim, ins) {\n  for (const seat of sim.seats) {\n    const inp = ins[seat.i];\n    if (inp.x != null) { seat.x = inp.x; seat.z = inp.z; }\n    if (inp.table != null && inp.table !== seat.table && sim.tables[inp.table]) {\n      seat.table = inp.table;\n      sim.events.push({ t: 'table', seat: seat.i, table: inp.table });\n      if (seat.grab) seat.grab = null;\n    }\n  }\n}\n\nfunction selectTool(sim, seat, inp) {\n  if (inp.tool && inp.tool !== seat.tool && TOOLS.includes(inp.tool) && (sim.tools.includes(inp.tool))) {\n    seat.lastTool = seat.tool;\n    seat.tool = inp.tool;\n    seat.drawing = 0;\n    seat.stroke = null;\n    if (seat.grab) seat.grab = null;\n    sim.events.push({ t: 'tool', seat: seat.i, tool: inp.tool });\n  }\n}\n\nfunction tagDoctors(sim, seat) {\n  sim.doctor = sim.doctor === 'ilya' ? 'sabine' : 'ilya';\n  seat.gift = seat.gift === 'quiet' ? 'look' : 'quiet';\n  if (sim.quiet) { sim.quiet = false; sim.quietSeat = -1; sim.events.push({ t: 'quiet', on: false }); }\n  sim.events.push({ t: 'tag', doctor: sim.doctor });\n}\n\nfunction trail(sim, seat, inp) {\n  if (sim.ringN !== 0) return;\n  seat.trail.push(+seat.x.toFixed(2), +seat.z.toFixed(2), inp.use > 0.15 ? 1 : 0);\n  if (seat.trail.length > 150) seat.trail.splice(0, 3);\n}\n\nfunction worldStep(sim, dt) {\n  const def = defOf(sim);\n  // the clock\n  if (!sim.cheats.freezeClock) {\n    sim.clock -= dt;\n    if (sim.clock <= 0) {\n      sim.clock = 0;\n      if (def.clockWins) { win(sim); return; }\n      lose(sim, 'clock');\n      return;\n    }\n  }\n  // grown bleeders\n  for (const e of sim.ents) if (e.k === 'bleeder' && e.r < (e.rMax ?? 1.4)) e.r += (e.grow ?? 0.12) * dt;\n  // vitals\n  if (!sim.quiet) {\n    const diff = DIFFICULTY[sim.difficulty] ?? DIFFICULTY.resident;\n    sim.tables.forEach((t, ti) => {\n      let bleed = 0;\n      for (const e of sim.ents) if (e.table === ti) { const w = KINDS[e.k].bleed; if (w) bleed += w; }\n      const d = Math.min(2, t.drain * diff.drain * sim.cfg.vitalsDrain * sim.coop + bleed * sim.cfg.bleedDrain) * DT;\n      hurt(sim, ti, d);\n      const low = t.vitals < 30;\n      if (low && !t.low) { sim.events.push({ t: 'lowVitals', table: ti }); if (ti === sim.seats[0].table) sayKey(sim, 'reyes.lowVitals'); }\n      t.low = low;\n    });\n    for (let ti = 0; ti < sim.tables.length; ti++) {\n      if (sim.tables[ti].vitals <= 0) {\n        if (sim.codeBlues < sim.saves) enterCodeBlue(sim, ti, false);\n        else { sim.tables[ti].lost = true; lose(sim, 'vitals'); }\n        return;\n      }\n    }\n  }\n  // cold time\n  if (sim.cold) {\n    sim.cold.t -= dt;\n    if (sim.cold.t <= 0) { sim.cold.t = 0; lose(sim, 'cold'); return; }\n  }\n  // heartbeat\n  if (sim.heart) {\n    const before = sim.heart.phase;\n    sim.heart.phase = (sim.heart.phase + (sim.heart.bpm / 60) * dt) % 1;\n    if (sim.heart.phase < before) { sim.heart.beats++; sim.events.push({ t: 'beat', bpm: sim.heart.bpm }); }\n  }\n  // strains\n  for (const e of [...sim.ents]) {\n    if (e.k === 'strain') { STRAINS[e.type]?.step?.(sim, e, dt); if (sim.phase !== 'play') return; }\n    if (e.expires != null) {\n      e.expires -= dt;\n      if (e.expires <= 0) {\n        const owner = e.owner, sig = e.onExpire;\n        removeEnt(sim, e);\n        if (sig) signal(sim, owner, sig, e, sim.seats[0]);\n        if (e.expireCmds) runCmds(sim, e.expireCmds);\n      }\n    }\n  }\n  // droplets and film\n  dropsStep(sim, dt);\n  for (let i = sim.films.length - 1; i >= 0; i--) { sim.films[i].t -= dt; if (sim.films[i].t <= 0) sim.films.splice(i, 1); }\n  // ghost hand\n  if (sim.ghost) { sim.ghost.t += DT; sim.ghost.i = Math.floor(sim.ghost.t * 10); if (sim.ghost.i * 3 >= (sim.ghost.seats[0]?.length ?? 0)) sim.ghost = null; }\n  // the mimic\n  if (sim.mimic) mimicStep(sim);\n}\n\nfunction dropsStep(sim, dt) {\n  for (let i = sim.drops.length - 1; i >= 0; i--) {\n    const d = sim.drops[i];\n    if (d.home) {\n      const s = sim.seats[0], m = Math.hypot(s.x - d.x, s.z - d.z) || 1;\n      d.vx += ((s.x - d.x) / m) * 0.9 * dt; d.vz += ((s.z - d.z) / m) * 0.5 * dt;\n    }\n    d.x += d.vx * dt; d.z += d.vz * dt; d.life -= dt;\n    if (sim.films.some((f) => dist(f.x, f.z, d.x, d.z) < 0.7)) { sim.drops.splice(i, 1); sim.events.push({ t: 'sfx', id: 'fizz', x: d.x, z: d.z }); continue; }\n    if (d.life <= 0 || d.z > 3.3) {\n      sim.drops.splice(i, 1);\n      hurt(sim, d.table, 1);\n      if (sim.ents.filter((e) => e.k === 'nick').length < 8) spawn(sim, { k: 'nick', at: [d.x, Math.min(3, d.z)], table: d.table });\n      sim.events.push({ t: 'sfx', id: 'dropHit', x: d.x, z: d.z });\n    }\n  }\n}\n\nfunction mimicStep(sim) {\n  const m = sim.mimic, s = sim.seats[0];\n  m.cool = Math.max(0, m.cool - DT);\n  const i = s.trail.length - 3 * 30;\n  if (i < 0) { m.x = null; return; }\n  m.x = s.trail[i]; m.z = s.trail[i + 1]; m.use = s.trail[i + 2];\n  if (m.use && m.cool <= 0 && dist(m.x, m.z, s.x, s.z) < 0.7) {\n    m.cool = 1.2;\n    m.hits++;\n    hurt(sim, s.table, 2);\n    spawn(sim, { k: 'nick', at: [m.x, m.z], table: s.table });\n    sim.events.push({ t: 'sfx', id: 'mimicCut', x: m.x, z: m.z });\n    sayKey(sim, 'mimic.hit');\n  }\n}\n\nfunction updateHint(sim) {\n  sim.hint = null;\n  if (sim.noHint) return;\n  const table = sim.seats[0].table;\n  let best = null;\n  const P = { marker: -1, core: 0, eye: 0, dressing: 9 };\n  let bp = 1e9;\n  for (const e of sim.ents) {\n    if (e.table !== table || !visible(e)) continue;\n    const c = KINDS[e.k].cls;\n    if (c === 'strain') continue;\n    const tool = toolFor(e);\n    if (!tool && c !== 'marker' && c !== 'dressing') continue;\n    const p = P[e.k] ?? 3;\n    if (p < bp) { bp = p; best = e; }\n  }\n  if (!best) {\n    const hidden = sim.ents.find((e) => e.table === table && e.scan && !e.seen);\n    if (hidden && sim.tools.includes('scanner')) sim.hint = { x: hidden.x, z: hidden.z, tool: 'scanner', k: 'hidden' };\n    return;\n  }\n  const [x, z] = aimPoint(best);\n  sim.hint = { x, z, tool: toolFor(best), k: best.k, id: best.id };\n}\n\nexport function stageProgress(sim) { return { stage: sim.stage, total: defOf(sim).stages.length }; }\nvoid nextRandom; void rate;\n\n/** Dev Mode actions. */\nexport const dev = {\n  completeStage(sim) { const def = defOf(sim), st = def.stages[sim.stage]; sim.ents.length = 0; sim.drops.length = 0; for (const s of sim.seats) { s.grab = null; s.stroke = null; } if (st?.then) runCmds(sim, st.then); sim.phase = 'play'; sim.codeBlue = null; sim.massage = null; nextStage(sim); },\n  winOp(sim) { sim.phase = 'play'; win(sim); },\n  failOp(sim) { lose(sim, 'dev'); },\n  codeBlue(sim) { enterCodeBlue(sim, sim.seats[0].table, true); },\n  spawn(sim, kind) {\n    const s = sim.seats[0], table = s.table;\n    const at = [s.x, s.z];\n    const map = {\n      pool: { k: 'pool', at, r: 0.9, table },\n      bleeder: { k: 'bleeder', at, r: 0.5, table },\n      laceration: { k: 'laceration', a: [at[0] - 0.8, at[1]], b: [at[0] + 0.8, at[1]], table },\n      hook: { k: 'hook', at, dir: [0.4, -1], pull: 1.1, arc: 0.3, table },\n      strain: { k: 'strain', type: 'introit', hp: 1, at, table },\n    };\n    if (map[kind]) spawn(sim, map[kind]);\n  },\n};\nEOF\ncat > src/sim/strains/index.js <<'EOF'\n// The strains: each a small state machine over plain data.\nimport { spawn, removeEnt, entById } from '../entities.js';\nimport { dist, curve, pointAt, polyLength, smoothPath, clamp } from '../geom.js';\nimport { hurt, say, sayKey, enterMassage, runCmds, enterCodeBlue, addScar, addVitals } from '../op.js';\nimport { nextRandom, rangeOf } from '../../core/rng.js';\n\nconst hpOf = (sim, base) => Math.max(1, Math.round(base * sim.cfg.strainHp));\nconst speedOf = (sim) => sim.cfg.strainSpeed;\nconst clampField = (x, z) => [clamp(x, -5.6, 5.6), clamp(z, -3.2, 2.2)];\nconst ownerOf = (sim, e) => sim.ents.filter((o) => o.owner === e.id);\n\n/* ---------- Introit, the Knock ---------- */\nconst introit = {\n  step(sim, e, dt) {\n    if (!e.init) {\n      e.init = true;\n      e.hp = e.hp ?? hpOf(sim, 3); e.hpMax = e.hp; e.mode = 'roam'; e.timer = e.firstKnock ?? 6; e.speed = 1.6;\n      const R = e.region ?? [-4.5, 4.5, -3, 1.8];\n      const pts = [];\n      for (let i = 0; i < 8; i++) pts.push([rangeOf(sim, R[0], R[1]), rangeOf(sim, R[2], R[3])]);\n      pts.push(pts[0]);\n      e.path = smoothPath(pts, 5); e.len = polyLength(e.path); e.s = 0; e.visibleCore = false;\n    }\n    if (e.mode === 'roam') {\n      e.s = (e.s + e.speed * speedOf(sim) * dt) % e.len;\n      const p = pointAt(e.path, e.s); e.x = p[0]; e.z = p[1];\n      e.timer -= dt;\n      if (e.timer <= 0) {\n        e.mode = 'knock'; e.timer = (e.poreTime ?? 3);\n        const [x, z] = clampField(e.x, e.z); e.x = x; e.z = z;\n        spawn(sim, { k: 'incision', look: 'pore', owner: e.id, sig: 'lanced', table: e.table, line: [[x - 0.4, z - 0.15], [x + 0.4, z + 0.15]], at: [x, z] });\n        sim.events.push({ t: 'sfx', id: 'knock', x, z });\n        sim.events.push({ t: 'knock', x, z });\n        if (!e.knocked) { e.knocked = true; if (!sim.voiceOff && e.talk !== false) say(sim, 'ilya', 'It moved. Nurse Reyes, it *knocked*.'); }\n      }\n    } else if (e.mode === 'knock') {\n      e.timer -= dt;\n      if (e.timer <= 0) { // missed: it tears its way down again\n        for (const o of ownerOf(sim, e)) if (o.k === 'incision') { for (const s of sim.seats) if (s.stroke === o.id) s.stroke = null; removeEnt(sim, o); }\n        spawn(sim, { k: 'laceration', a: [e.x - 0.8, e.z - 0.2], b: [e.x + 0.8, e.z + 0.2], table: e.table });\n        spawn(sim, { k: 'pool', at: [e.x + 0.3, e.z + 0.5], r: 0.8, table: e.table });\n        e.mode = 'roam'; e.timer = 6;\n        sim.events.push({ t: 'sfx', id: 'tetherSnap', x: e.x, z: e.z });\n      }\n    } else if (e.mode === 'exposed') {\n      e.timer -= dt;\n      const core = ownerOf(sim, e).find((o) => o.k === 'core');\n      const held = core && sim.seats.some((s) => s.grab === core.id);\n      if (core) { e.coreX = core.x; e.coreZ = core.z; }\n      if (e.timer <= 0 && !held) {\n        if (core) removeEnt(sim, core);\n        sim.events.push({ t: 'sfx', id: 'tick', x: e.x, z: e.z });\n        e.mode = 'roam'; e.timer = 6;\n      }\n    }\n  },\n  on(sim, e, sig) {\n    if (sig === 'lanced') {\n      e.mode = 'exposed'; e.timer = (e.coreTime ?? 3.5);\n      const dx = e.x > 0 ? -1 : 1, dz = e.z > 0 ? -0.5 : 0.5;\n      const pts = curve([e.x, e.z], [dx, dz], 2.5, 0.25);\n      spawn(sim, { k: 'core', look: 'introit', owner: e.id, sig: 'popped', table: e.table, tether: true, autoFree: true, pts, at: [e.x, e.z], big: 0.2 });\n      sim.events.push({ t: 'sfx', id: 'squelch', x: e.x, z: e.z });\n    } else if (sig === 'popped') {\n      e.hp--;\n      sim.events.push({ t: 'strainHit', id: e.id, type: 'introit', hp: e.hp, x: e.x, z: e.z });\n      sim.events.push({ t: 'sfx', id: 'strainHurt', x: e.x, z: e.z });\n      spawn(sim, { k: 'laceration', a: [e.x - 0.9, e.z - 0.3], b: [e.x + 0.3, e.z + 0.3], table: e.table });\n      spawn(sim, { k: 'laceration', a: clampField(e.x + 0.6, e.z + 0.9), b: clampField(e.x + 1.8, e.z + 0.6), table: e.table });\n      e.speed *= 1.25; e.mode = 'roam'; e.timer = 6;\n      if (e.hp <= 0) {\n        sim.flags[e.doneFlag ?? 'strainDead'] = true;\n        sim.events.push({ t: 'strainDead', type: 'introit', x: e.x, z: e.z });\n        removeEnt(sim, e);\n      } else if (e.talk !== false) sayKey(sim, 'reyes.strainHit');\n    }\n  },\n};\n\n/* ---------- Lacrimosa, the Weeper ---------- */\nconst lacrimosa = {\n  step(sim, e, dt) {\n    if (!e.init) {\n      e.init = true; e.openT = 2; e.dropT = 0; e.sobs = 0; e.sobT = -1; e.halfDone = false; e.hpEach = e.hpEach ?? hpOf(sim, 3);\n      const spots = e.spots ?? [[-3.6, -2], [3.6, -2], [-2.2, 0.8], [2.2, 0.8], [0, -2.8]];\n      for (const [x, z] of spots) spawn(sim, { k: 'eye', look: 'weeper', owner: e.id, sig: 'burned', keep: true, shut: true, eyeHp: e.hpEach, eyeHpMax: e.hpEach, open: 0, at: [x, z], x0: x, z0: z, table: e.table, burnTime: 1.2, size: 0.7 });\n      e.eyesTotal = spots.length; e.hpTotal = spots.length * e.hpEach;\n    }\n    const eyes = ownerOf(sim, e).filter((o) => o.k === 'eye');\n    const hpLeft = eyes.reduce((n, o) => n + o.eyeHp, 0);\n    const half = hpLeft <= e.hpTotal / 2;\n    if (half && !e.halfDone) { e.halfDone = true; sim.events.push({ t: 'sfx', id: 'wail', x: 0, z: -1 }); if (e.talk !== false) sayKey(sim, 'reyes.eyesCrawl'); }\n    // crawling\n    if (half) for (const o of eyes) {\n      o.crawl = (o.crawl ?? nextRandom(sim) * 6) + dt * 0.7;\n      const [x, z] = clampField(o.x0 + Math.sin(o.crawl) * 1.4, o.z0 + Math.cos(o.crawl * 0.7) * 0.8);\n      o.x = x; o.z = z;\n    }\n    const lastEye = eyes.length === 1 && !e.noSob;\n    if (lastEye && e.sobs < 3) { // the Sob\n      for (const o of eyes) o.shut = true;\n      if (e.sobT < 0) {\n        const mask = ownerOf(sim, e).find((o) => o.k === 'mask');\n        if (!mask) {\n          e.sobWait = (e.sobWait ?? 1.6) - dt;\n          if (e.sobWait <= 0) {\n            e.sobWait = 2; e.sobT = 6;\n            const z = -2.4 + e.sobs * 1.5, tilt = e.sobs % 2 ? 0.5 : -0.5;\n            spawn(sim, { k: 'mask', look: 'sob', owner: e.id, sig: 'sobbed', table: e.table, path: [[-4.5, z - tilt], [4.5, z + tilt]], need: 0.8 });\n            sim.events.push({ t: 'sfx', id: 'wail', x: 0, z });\n            sim.events.push({ t: 'prompt', text: 'THE SOB! GEL THE LINE!' });\n          }\n        }\n      } else {\n        e.sobT -= dt;\n        if (e.sobT <= 0) {\n          for (const o of ownerOf(sim, e)) if (o.k === 'mask') removeEnt(sim, o);\n          e.sobT = -1; e.sobs++;\n          hurt(sim, e.table, 25);\n          sim.events.push({ t: 'wave' });\n          sim.events.push({ t: 'sfx', id: 'wave', x: 0, z: 0 });\n        }\n      }\n      return;\n    }\n    // opening in turns\n    e.openT -= dt;\n    const open = eyes.filter((o) => !o.shut);\n    if (e.openT <= 0 && open.length < (half ? 2 : 1) + (eyes.length > 3 ? 0 : 0)) {\n      const shut = eyes.filter((o) => o.shut);\n      if (shut.length) {\n        const o = shut[Math.floor(nextRandom(sim) * shut.length)];\n        o.shut = false; o.open = 0;\n        sim.events.push({ t: 'sfx', id: 'eyeOpen', x: o.x, z: o.z });\n        e.openT = 2.5;\n      }\n    }\n    // weeping\n    e.dropT -= dt;\n    for (const o of open) {\n      o.open += dt;\n      if (o.open >= 8) { // left open: it heals\n        o.shut = true; o.eyeHp = Math.min(o.eyeHpMax, o.eyeHp + 1); e.openT = 1.5;\n        sim.events.push({ t: 'sfx', id: 'heal', x: o.x, z: o.z });\n      }\n    }\n    if (e.dropT <= 0 && open.length) {\n      e.dropT = 0.95 / (sim.coop ?? 1);\n      const o = open[Math.floor(nextRandom(sim) * open.length)];\n      sim.drops.push({ x: o.x, z: o.z + 0.2, vx: rangeOf(sim, -0.35, 0.35), vz: 1.5 * speedOf(sim), life: 3.2, table: e.table, home: half });\n      sim.events.push({ t: 'sfx', id: 'drip', x: o.x, z: o.z });\n    }\n  },\n  on(sim, e, sig, o, seat) {\n    if (sig === 'burned') {\n      o.shut = true; o.eyeHp--; e.openT = 1.2;\n      sim.events.push({ t: 'strainHit', id: e.id, type: 'lacrimosa', hp: o.eyeHp, x: o.x, z: o.z });\n      sim.events.push({ t: 'sfx', id: 'strainHurt', x: o.x, z: o.z });\n      if (o.eyeHp <= 0) {\n        removeEnt(sim, o);\n        addScar(sim, { k: 'burn', x: o.x, z: o.z, table: o.table });\n        const left = ownerOf(sim, e).filter((p) => p.k === 'eye').length;\n        if (left === 0) {\n          if (e.noStalk) { finish(sim, e); return; }\n          const [x, z] = [o.x, o.z];\n          sim.events.push({ t: 'sfx', id: 'wail', x, z });\n          spawn(sim, { k: 'stalk', look: 'stalk', owner: e.id, sig: 'stalkOut', table: e.table, tether: true, autoFree: true, snapCuts: true, pts: curve([x, z], [x > 0 ? -1 : 1, 0.2], 2.4, 0.3), at: [x, z], big: 0.2 });\n          if (e.talk !== false) sayKey(sim, 'reyes.stalk');\n        }\n      }\n    } else if (sig === 'stalkOut') finish(sim, e);\n    else if (sig === 'sobbed') { e.sobT = -1; e.sobs++; sim.events.push({ t: 'sfx', id: 'heal', x: 0, z: 0 }); }\n    void seat;\n  },\n};\nfunction finish(sim, e) {\n  sim.flags[e.doneFlag ?? 'strainDead'] = true;\n  sim.events.push({ t: 'strainDead', type: e.type, x: e.x, z: e.z });\n  removeEnt(sim, e);\n}\n\n/* ---------- Dies Irae, the Wrath ---------- */\nconst irae = {\n  step(sim, e, dt) {\n    if (!e.init) {\n      e.init = true;\n      if (!sim.heart) sim.heart = { bpm: e.bpm ?? sim.cfg.irae, phase: 0.4, beats: 0 };\n      e.rounds = e.rounds ?? [2, 2, 3]; e.round = 0; e.mode = 'plates'; e.flareT = 7; e.fibbed = 0;\n      e.ring = [];\n      const n = e.rounds.reduce((a, b) => a + b, 0);\n      for (let i = 0; i < n; i++) { const a = -Math.PI / 2 + (i / n) * Math.PI * 2; e.ring.push([+(e.x + Math.cos(a) * 2).toFixed(2), +(e.z + Math.sin(a) * 1.7).toFixed(2), 1]); }\n      e.next = 0; startPlates(sim, e);\n    }\n    e.flareT -= dt;\n    if (e.flareT <= 0 && e.mode !== 'final') { // wrath flares\n      e.flareT = 7 / sim.coop;\n      const a = nextRandom(sim) * Math.PI * 2;\n      const [x, z] = clampField(e.x + Math.cos(a) * 3.2, e.z + Math.sin(a) * 2.4);\n      spawn(sim, { k: 'bleeder', at: [x, z], r: 0.6, rMax: 1.1, table: e.table, look: 'flare' });\n      sim.events.push({ t: 'sfx', id: 'flare', x, z });\n    }\n    if (sim.heart.bpm >= 120) { // fibrillation\n      sim.heart.bpm = 96; e.fibbed++;\n      sim.events.push({ t: 'prompt', text: 'FIBRILLATION! PADDLES!' });\n      if (e.talk !== false) sayKey(sim, 'reyes.fib');\n      enterCodeBlue(sim, e.table, true);\n    }\n  },\n  on(sim, e, sig, o) {\n    if (sig === 'plateCut') {\n      spawn(sim, { k: 'plate', look: 'plate', owner: e.id, sig: 'plateOff', onBeat: true, table: e.table, ringIx: o.ringIx, pts: curve([o.x0 ?? o.x, o.z0 ?? o.z], [(o.x0 ?? o.x) - e.x, (o.z0 ?? o.z) - e.z], 1.1, 0), at: [o.x0 ?? o.x, o.z0 ?? o.z], big: 0.2 });\n    } else if (sig === 'plateOff') {\n      e.ring[o.ringIx][2] = 0;\n      sim.heart.bpm += 6;\n      sim.events.push({ t: 'bpm', bpm: sim.heart.bpm });\n      sim.events.push({ t: 'sfx', id: 'plateCrack', x: o.x, z: o.z });\n      if (!ownerOf(sim, e).some((p) => p.k === 'plate' || p.k === 'incision')) {\n        spawn(sim, { k: 'eye', look: 'wrath', owner: e.id, sig: 'eyeBurned', onBeat: true, at: [e.x, e.z], table: e.table, burnTime: 0.9, size: 0.8 });\n        sim.events.push({ t: 'sfx', id: 'eyeOpen', x: e.x, z: e.z });\n        if (e.talk !== false) sayKey(sim, 'reyes.eyeOpen');\n      }\n    } else if (sig === 'eyeBurned') {\n      sim.events.push({ t: 'strainHit', id: e.id, type: 'irae', hp: e.rounds.length - e.round - 1, x: e.x, z: e.z });\n      sim.events.push({ t: 'sfx', id: 'strainHurt', x: e.x, z: e.z });\n      e.round++;\n      if (e.round >= e.rounds.length) {\n        if (e.noArrest) { finish(sim, e); return; }\n        e.mode = 'final';\n        sim.heart.bpm = 60;\n        sim.events.push({ t: 'sfx', id: 'flatline', x: 0, z: 0 });\n        say(sim, 'reyes', 'He arrested! Both hands, Doctor! *On the beat!*');\n        enterMassage(sim, 8);\n        sim.flags.iraeArrest = true;\n      } else startPlates(sim, e);\n    } else if (sig === 'finalCut') finish(sim, e);\n    else if (sig === 'dose') { sim.heart.bpm = Math.max(60, sim.heart.bpm - 12); sim.events.push({ t: 'bpm', bpm: sim.heart.bpm }); }\n  },\n};\nfunction startPlates(sim, e) {\n  const n = e.rounds[e.round];\n  for (let i = 0; i < n; i++) {\n    const ix = e.next++;\n    const [x, z] = e.ring[ix];\n    const dx = x - e.x, dz = z - e.z, m = Math.hypot(dx, dz) || 1, nx = -dz / m, nz = dx / m;\n    spawn(sim, { k: 'incision', look: 'plateCut', owner: e.id, sig: 'plateCut', onBeat: true, ringIx: ix, x0: x, z0: z, table: e.table, line: [[x - nx * 0.5, z - nz * 0.5], [x + nx * 0.5, z + nz * 0.5]], at: [x, z] });\n  }\n}\n\n/* ---------- Miserere ---------- */\nconst miserere = {\n  step(sim, e, dt) {\n    if (!e.init) {\n      e.init = true; e.hp = hpOf(sim, 3); e.hpMax = e.hp; e.mode = 'drift'; e.timer = 3; e.a = 0;\n      sim.mimic = { hits: 0, cool: 0 };\n    }\n    if (e.mode === 'pull' || e.mode === 'gone') return;\n    e.a += dt * 0.5 * speedOf(sim);\n    if (e.mode === 'drift') {\n      e.x = Math.sin(e.a) * 3.6; e.z = -0.6 + Math.sin(e.a * 1.7) * 1.8;\n      e.timer -= dt;\n      if (e.timer <= 0) {\n        e.mode = 'veiled'; e.timer = 7;\n        spawn(sim, { k: 'incision', look: 'veil', owner: e.id, sig: 'unveiled', table: e.table, smooth: [[e.x - 0.8, e.z - 0.3], [e.x, e.z + 0.45], [e.x + 0.8, e.z - 0.3]], expires: 7, onExpire: 'veilShut' });\n        sim.events.push({ t: 'sfx', id: 'choir', x: e.x, z: e.z });\n      }\n    }\n  },\n  on(sim, e, sig) {\n    if (sig === 'unveiled') {\n      e.mode = 'bare';\n      spawn(sim, { k: 'eye', look: 'halo', owner: e.id, sig: 'burned', at: [e.x, e.z], table: e.table, burnTime: 1.1, size: 0.8, expires: 5, onExpire: 'veilShut' });\n    } else if (sig === 'veilShut') {\n      e.mode = 'drift'; e.timer = 3;\n    } else if (sig === 'burned') {\n      e.hp--;\n      sim.events.push({ t: 'strainHit', id: e.id, type: 'miserere', hp: e.hp, x: e.x, z: e.z });\n      sim.events.push({ t: 'sfx', id: 'choir', x: e.x, z: e.z });\n      if (e.hp <= 0) {\n        e.mode = 'pull';\n        sim.mimic = null;\n        sim.events.push({ t: 'prompt', text: 'BOTH HANDS ON THE TETHER!' });\n        spawn(sim, { k: 'core', look: 'miserere', owner: e.id, sig: 'pulledOut', table: e.table, tether: true, autoFree: true, shared: true, need2: sim.seats.length > 1, snapCuts: false, pts: curve([e.x, e.z], [e.x > 0 ? -1 : 1, 0.4], 3, 0.3), at: [e.x, e.z], big: 0.35 });\n      } else { e.mode = 'drift'; e.timer = 3; }\n    } else if (sig === 'pulledOut') {\n      sim.flags.miserereOut = true;\n      sim.events.push({ t: 'strainDead', type: 'miserere', x: e.x, z: e.z });\n      removeEnt(sim, e);\n    }\n  },\n};\n\n/* ---------- Pile-Up: Consult's waves ---------- */\nconst pileup = {\n  step(sim, e, dt) {\n    if (!e.init) { e.init = true; e.wave = 0; e.timer = 2; e.surgeT = 34; e.bossDone = false; }\n    e.timer -= dt * sim.coop;\n    const busy = sim.ents.filter((o) => o.k !== 'strain').length;\n    if (e.timer <= 0 && busy < 14) {\n      e.timer = Math.max(5, 11 - e.wave * 0.5);\n      e.wave++;\n      const r = () => [rangeOf(sim, -5.2, 5.2), rangeOf(sim, -3.2, 2)];\n      const n = 2 + Math.min(4, Math.floor(e.wave / 2));\n      for (let i = 0; i < n; i++) {\n        const kind = Math.floor(nextRandom(sim) * 4), at = r();\n        if (kind === 0) spawn(sim, { k: 'pool', at, r: rangeOf(sim, 0.7, 1.2), table: 0 });\n        else if (kind === 1) spawn(sim, { k: 'hook', at, dir: [rangeOf(sim, -1, 1), -1], pull: 1.1, arc: 0.35, table: 0 });\n        else if (kind === 2) { const b = clampField(at[0] + rangeOf(sim, 1, 1.8), at[1] + rangeOf(sim, -0.5, 0.5)); spawn(sim, { k: 'laceration', a: at, b, table: 0 }); }\n        else spawn(sim, { k: 'polyp', at, table: 0 });\n      }\n      sim.events.push({ t: 'sfx', id: 'alarm', x: 0, z: 0 });\n    }\n    e.surgeT -= dt;\n    if (e.surgeT <= 0) { // a surge\n      e.surgeT = 30;\n      for (let i = 0; i < 3; i++) spawn(sim, { k: 'bleeder', at: [rangeOf(sim, -5, 5), rangeOf(sim, -3, 2)], r: 0.6, rMax: 1.2, table: 0 });\n      sim.events.push({ t: 'prompt', text: 'SURGE! DRAIN IT!' });\n    }\n    if (!e.bossDone && sim.clock <= (e.bossAt ?? 40)) {\n      e.bossDone = true;\n      sim.events.push({ t: 'prompt', text: 'SOMETHING KNOCKS...' });\n      spawn(sim, { k: 'strain', type: 'introit', hp: 2, at: [0, 0], table: 0, firstKnock: 2, talk: false, doneFlag: 'smallDead' });\n    }\n  },\n};\n\n/* ---------- The false monitor and the reprise are stage data; these fights only need flags. ---------- */\nexport const STRAINS = { introit, lacrimosa, irae, miserere, pileup };\nvoid entById; void runCmds; void dist; void addVitals;\nEOF\n","description":"Write op core and strain state machines"}}}
