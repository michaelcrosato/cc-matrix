, sz = 0, steady = false, use = 0, gift = false, rot = 0;\n    const rotating = seat.grab != null && this.sim.ents.find((e) => e.id === seat.grab)?.goal?.[2] != null;\n    const p = tip.pending;\n    if (p) {\n      if (p.tool) out.tool = p.tool;\n      if (p.table != null) out.table = p.table;\n      if (p.tag) out.tag = true;\n      if (p.drop) out.drop = true;\n      if (p.rot) rot += p.rot;\n      tip.pending = null;\n    }\n    if (pad) {\n      const on = (b) => pad.buttons[b] > 0.5;\n      sx += deadzone(pad.axes[0] ?? 0); sz += deadzone(pad.axes[1] ?? 0);\n      use = Math.max(use, pad.buttons[BTN.R2] ?? 0, on(BTN.CROSS) ? 1 : 0);\n      steady = steady || on(BTN.L1);\n      const l2 = (pad.buttons[BTN.L2] ?? 0) > 0.3, r2 = (pad.buttons[BTN.R2] ?? 0) > 0.3;\n      gift = gift || l2;\n      if (l2) out.padL = true; if (r2) out.padR = true;\n      if (rotating) rot += deadzone(pad.axes[2] ?? 0);\n    }\n    if (useKbm) {\n      if (input.isDown('KeyD', 'ArrowRight')) sx += 1; if (input.isDown('KeyA', 'ArrowLeft')) sx -= 1;\n      if (input.isDown('KeyS', 'ArrowDown')) sz += 1; if (input.isDown('KeyW', 'ArrowUp')) sz -= 1;\n      if (input.isDown('ShiftLeft', 'ShiftRight')) steady = true;\n      const mL = input.isDown('MouseLeft'), mR = input.isDown('MouseRight'), kJ = input.isDown('KeyJ'), kK = input.isDown('KeyK');\n      if (mL || kJ) { use = 1; out.padL = true; }\n      if (mR || kK) out.padR = true;\n      if (input.isDown('Space')) gift = true;\n      if (rotating) { if (input.isDown('KeyQ')) rot -= 1; if (input.isDown('KeyE')) rot += 1; }\n      if (tip.wheelClick > 0) use = 0;\n      // mouse: the tip follows exactly, on the surface not a plane\n      if (devs.pointerMoved || (this.mouseOn && (mL || mR))) this.mouseOn = true;\n      if (sx || sz) this.mouseOn = false;\n      if (this.mouseOn && input.pointer.over !== false) this.mouseToTip(ctx, tip, seat);\n    }\n    if (pad && (Math.abs(sx) > 0 || Math.abs(sz) > 0)) this.mouseOn = false;\n    const cfg = app.config;\n    const assist = AIM[app.settings.aim] ?? cfg.aimAssist;\n    if (sx || sz) {\n      const near = assist > 0 && nearTarget(this.sim, seat, tip.x, tip.z);\n      integrateTip(tip, sx, sz, { speed: cfg.cursorSpeed * (app.settings.cursor ?? 1), steady, steadyFactor: cfg.steadyFactor, assist, near, stroke: assist > 0 ? strokeDir(this.sim, seat) : null, dt });\n    }\n    if (app.settings.giftToggle) {\n      if (gift && !tip.giftPrev) tip.giftLatch = !tip.giftLatch;\n      tip.giftPrev = gift;\n      gift = tip.giftLatch;\n    }\n    out.x = tip.x; out.z = tip.z; out.use = use; out.gift = gift; out.steady = steady; out.rot = rot;\n    // Rumble follows the tool.\n    if (use > 0.15 && pad) this.toolRumble(seat, pad, use);\n    return out;\n  }\n\"\"\"\ns=s[:a]+new+s[b:]\ns=s.replace(\"\"\"    if (this.intro > 0) this.intro -= dt;\n    const events = this.opts.net\"\"\",\"\"\"    if (this.intro > 0) this.intro -= dt;\n    else this.collectEdges(ctx, dt);\n    const events = this.opts.net\"\"\")\ns=s.replace(\"\"\"  /* ---- fixed step ---- */\"\"\",\"\"\"  collectEdges(ctx, dt) {\n    if (this.opts.demo || this.botOn) return;\n    if (this.opts.net) {\n      const seat = this.sim.seats[this.opts.net.mySeat];\n      if (seat && !this.opts.net.server && window.AIHub.time() >= 0) this.readEdges(ctx, seat, { device: 'auto' }, dt);\n      return;\n    }\n    for (const seat of this.sim.seats) {\n      const bind = this.seatBind[seat.i];\n      if (!bind || bind.device === 'bot' || (this.def.partnerBot && seat.i === 1 && !this.opts.seats)) continue;\n      this.readEdges(ctx, seat, bind, dt);\n    }\n  }\n\n  /* ---- fixed step ---- */\"\"\")\nopen(p,'w').write(s)\np='tests/browser/run.mjs'; s=open(p).read()\nold=\"await page.evaluate(() => { window.__pads[0].axes[2] = 0.7; window.__pads[0].axes[3] = -0.7; }); await page.waitForTimeout(300); await page.evaluate(() => { window.__pads[0].axes[2] = 0; window.__pads[0].axes[3] = 0; }); await page.waitForTimeout(150);\"\nassert old in s\ns=s.replace(old,\"await page.evaluate(() => { window.__pads[0].axes[2] = 0.7; window.__pads[0].axes[3] = -0.7; }); await waitFrames(page, 3); await page.evaluate(() => { window.__pads[0].axes[2] = 0; window.__pads[0].axes[3] = 0; }); await waitFrames(page, 3);\")\nopen(p,'w').write(s)\np='tests/headless.test.mjs'; s=open(p).read()\ns=s.replace(\"  e.dispose?.();\\n\",\"\"\"  // One press is one action at any frame rate: 15 fps runs four sim steps a frame, 240 fps runs none on most.\n  await e.loadGame(new OperationStage({ op: 'op3' }));\n  e.game.intro = 0;\n  e.step(2);\n  const table = () => e.game.sim.seats[0].table, tool = () => e.game.sim.seats[0].tool;\n  const pressAt = (code, dt) => { e.input.setKey(code, true); e.step(1, dt); e.input.setKey(code, false); e.step(1, dt); e.step(1, 1 / 15); };\n  pressAt('Tab', 1 / 15); ok('one Tab at 15 fps moves one table', table() === 1, String(table()));\n  pressAt('Tab', 1 / 240); ok('one Tab at 240 fps moves one table', table() === 2, String(table()));\n  pressAt('Digit1', 1 / 240); ok('a tool key is not lost at 240 fps', tool() === 'scalpel', tool());\n  pressAt('Digit2', 1 / 15); pressAt('KeyQ', 1 / 15); ok('last tool swaps once at 15 fps', tool() === 'scalpel', tool());\n  e.dispose?.();\n\"\"\")\ns=s.replace(\"import { app } from '../src/core/app.js';\",\"import { app } from '../src/core/app.js';\\nimport { OperationStage } from '../src/stages/operation.js';\")\nopen(p,'w').write(s)\nimport json\nold=\"About 20 in the game: 7 from scripts (balance report, sim tests, the sound lint, which found a misnamed wave making nine sounds and the choirs fail, and the kit replay check, which found level swaps racing a replay), about 13 from screenshots, including a Dies Irae crown that never drew.\"\nnew=\"About 21 in the game: 8 from scripts (balance report, sim tests, the sound lint, which found a misnamed wave making nine sounds and the choirs fail, the kit replay check, which found level swaps racing a replay, and a pad test failing under load, which led to one press acting twice or not at all when the frame rate dipped), about 13 from screenshots, including a Dies Irae crown that never drew.\"\np='src/content/about.js'; s=open(p).read(); assert old in s; s=s.replace(old,new); open(p,'w').write(s)\np='../exit-interview.json'; d=json.load(open(p)); d['testingFeedback'][0]=d['testingFeedback'][0].replace(old,new); assert 'About 21' in d['testingFeedback'][0]; json.dump(d,open(p,'w'),ensure_ascii=False,indent=2)\nE\nnode --check src/content/about.js && node tools/build.mjs && timeout 200 node tests/run.mjs headless 2>&1 | tail -8 | cut -c1-300","description":"Move one-shot presses to update, add frame-rate tests, rebuild","timeout":300000}}}
