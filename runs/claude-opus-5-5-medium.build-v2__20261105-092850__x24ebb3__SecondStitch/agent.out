{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgk8nFhNZBY7xa5U8rt1F","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":22711,"cache_read_input_tokens":323230,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":22711},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9464247a-cdba-4289-905c-cd8b34e5d270","uuid":"aa00e3d0-0987-419e-9b57-79c8b2eb06cc","timestamp":"2026-11-05T16:57:30.739Z","request_id":"req_011Cgk8nFRVgN3vnAHMzeuQD","thinking_duration_ms":2325,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgk8nFhNZBY7xa5U8rt1F","type":"message","role":"assistant","content":[{"type":"text","text":"Now I'm writing the remaining screens: effects, pause, Dev Mode, settings, title and menus, story, briefing, results, the operating log, attract and About. After that comes the first build."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":22711,"cache_read_input_tokens":323230,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":22711},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9464247a-cdba-4289-905c-cd8b34e5d270","uuid":"921e218a-2f35-423b-8fb4-5b0c47321cf6","timestamp":"2026-11-05T16:57:30.747Z","request_id":"req_011Cgk8nFRVgN3vnAHMzeuQD"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgk8nFhNZBY7xa5U8rt1F","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QsM2k213wLwYRvDb9MG9xb","name":"Bash","input":{"command":"cat > src/view/fx.js <<'EOF'\n// Particles and small flourishes.\nimport { buildModel, setLookLayer } from '../../pixel-engine.js';\nimport { CATALOG, PROP_DEFS } from '../content/models/index.js';\nimport { TABLE_GAP } from './field.js';\n\nconst PRE = {\n  blood: { count: [4, 8], life: [0.25, 0.55], speed: [1, 3], spread: 1, gravity: -9, size: [1, 1], colors: ['red', 'plum', 'red'] },\n  foam: { count: [2, 3], life: [0.3, 0.6], speed: [0.3, 0.9], gravity: 1, size: [1, 1], colors: ['mist', 'white', 'red'] },\n  smokeTool: { count: [1, 2], life: [0.4, 0.8], speed: [0.4, 1], gravity: 1.8, size: [1, 2], colors: ['mist', 'slate', 'slate'] },\n  gelfoam: { count: [2, 4], life: [0.3, 0.6], speed: [0.3, 0.7], gravity: 0.7, size: [1, 1], colors: ['cyan', 'white', 'lime'] },\n  spark: { count: [3, 6], life: [0.15, 0.35], speed: [1.5, 3.5], gravity: -4, size: [1, 1], colors: ['white', 'sand', 'white'] },\n  goo: { count: [12, 22], life: [0.4, 0.9], speed: [1.5, 5], gravity: -9, size: [1, 2], colors: ['plum', 'lime', 'red'] },\n  tears: { count: [6, 10], life: [0.3, 0.6], speed: [1, 2.4], gravity: -8, size: [1, 1], colors: ['cyan', 'white', 'sky'] },\n  gold: { count: [20, 30], life: [0.5, 1.2], speed: [1, 4], gravity: 0.8, size: [1, 2], colors: ['sand', 'white', 'orange'] },\n  plus: { count: [8, 12], life: [0.4, 0.8], speed: [0.8, 2], gravity: 2, size: [1, 1], colors: ['lime', 'cyan', 'white'] },\n};\n\nexport class Fx {\n  constructor(ctx, field, app) {\n    this.ctx = ctx; this.field = field; this.app = app; this.flying = [];\n    for (const [k, v] of Object.entries(PRE)) ctx.particles.register(k, v);\n  }\n  blood(x, y, z, n) { this.ctx.particles.burst('blood', [x, y + 0.1, z], n ? { count: n } : {}); }\n  smoke(x, y, z) { if ((this.tick = (this.tick ?? 0) + 1) % 3 === 0) this.ctx.particles.burst('smokeTool', [x, y + 0.2, z]); }\n  sparkAt(x, y, z) { this.ctx.particles.burst('spark', [x, y + 0.15, z]); }\n  inject(x, y, z) { this.ctx.particles.burst('plus', [x, y + 0.3, z]); }\n  knock(x, z) { this.ctx.particles.burst('blood', [x, this.field.surface(x, z) + 0.2, z], { count: 10 }); this.ctx.engine.screen.shockwave([x, 0, z], { radius: 0.18, strength: 0.4 }); }\n  strainHit(e) { this.ctx.particles.burst('goo', [e.x, this.field.surface(e.x, e.z) + 0.4, e.z]); }\n  strainDead(e) { const x = e.x ?? 0, z = e.z ?? 0; this.ctx.particles.burst(e.type === 'miserere' ? 'gold' : 'goo', [x, this.field.surface(x, z) + 0.5, z], { count: 40 }); this.ctx.engine.screen.shockwave([x, 0, z], { radius: 0.4, strength: 0.7 }); }\n  done(e, sim) {\n    const x = e.x + (e.table ?? 0) * TABLE_GAP, y = this.field.surface(e.x, e.z);\n    switch (e.k) {\n      case 'pool': case 'bleeder': this.ctx.particles.burst('foam', [x, y + 0.2, e.z], { count: 8 }); break;\n      case 'polyp': case 'egg': case 'cyst': case 'clot': this.ctx.particles.burst('goo', [x, y + 0.2, e.z], { count: 8 }); break;\n      case 'mask': this.ctx.particles.burst('gelfoam', [x, y + 0.2, e.z], { count: 16 }); break;\n      case 'dressing': case 'nick': this.ctx.particles.burst('plus', [x, y + 0.2, e.z]); break;\n      case 'eye': this.ctx.particles.burst('tears', [x, y + 0.3, e.z]); break;\n      default: break;\n    }\n    void sim;\n  }\n  toDish(e, table) {\n    const def = PROP_DEFS[{ hook: 'hook', key: 'key', coin: 'coin', card: 'card', magnet: 'magnet', debris: 'debris', tumor: 'tumor', clamp: 'clamp', oldKidney: 'oldKidney', plate: 'plate', tendril: 'tendril' }[e.look] ?? 'hook'];\n    const obj = buildModel(def, { catalog: CATALOG }).object.clone(true);\n    setLookLayer(obj, 'actors');\n    obj.scale.setScalar(0.8);\n    const x0 = e.x + table * TABLE_GAP, y0 = this.field.surface(e.x, e.z) + 0.5, z0 = e.z;\n    obj.position.set(x0, y0, z0);\n    this.ctx.scene.add(obj);\n    const dish = this.field.dish;\n    const toX = 6.6 + table * TABLE_GAP;\n    this.flying.push({ obj, t: 0, x0, y0, z0, x1: toX, y1: dish.y + 0.1, z1: dish.z, spin: 12 });\n  }\n  update(dt) {\n    for (let i = this.flying.length - 1; i >= 0; i--) {\n      const f = this.flying[i];\n      f.t = Math.min(1, f.t + dt / 0.35);\n      const t = f.t;\n      f.obj.position.set(f.x0 + (f.x1 - f.x0) * t, f.y0 + (f.y1 - f.y0) * t + Math.sin(t * Math.PI) * 2, f.z0 + (f.z1 - f.z0) * t);\n      f.obj.rotation.y += f.spin * dt;\n      if (t >= 1) { this.flying.splice(i, 1); this.ctx.particles.burst('spark', [f.x1, f.y1 + 0.1, f.z1], { count: 5 }); }\n    }\n  }\n}\nEOF\ncat > src/ui/settings.js <<'EOF'\n// Settings: same screen everywhere, pad-navigable.\nimport { Menu } from './menu.js';\nimport { app } from '../core/app.js';\nimport { DEFAULT_SETTINGS, storeAll } from '../core/save.js';\nimport { DIFFICULTY } from '../core/config.js';\n\nexport const LOOK_OPTIONS = [['field', 'PIXEL (DEFAULT)'], ['spooky', 'SPOOKY'], ['noir', 'NOIR'], ['playstation', 'PS1'], ['vhs_rental', 'VHS'], ['old_photo', 'OLD PHOTO']];\nconst cycle = (list, v, dir) => list[(list.indexOf(v) + dir + list.length) % list.length];\nexport function buildSettingsItems(ctx) {\n  const s = app.settings, audio = ctx.audio;\n  const vol = (key, label) => ({ label, value: () => `${Math.round((key === 'voices' ? s.voices : audio.volume[key]) * 100)}%`, bar: () => (key === 'voices' ? s.voices : audio.volume[key]), adjust: (d) => {\n    const base = key === 'voices' ? s.voices : audio.volume[key], v = Math.max(0, Math.min(1, Math.round((base + d * 0.05) * 100) / 100));\n    if (key === 'voices') s.voices = v; else { audio.setVolume(key, v); s[key] = v; }\n    if (key !== 'music') audio.play(key === 'voices' ? 'syl-1am' : 'uiConfirm');\n    app.persist();\n  } });\n  const opt = (label, get, values, set) => ({ label, value: () => get(), adjust: (d) => { set(cycle(values, currentKey(get, values), d)); app.persist(); } });\n  const currentKey = (get, values) => values.find((v) => label(v) === get()) ?? values[0];\n  const label = (v) => String(v).toUpperCase();\n  const toggle = (lbl, key, on = 'ON', off = 'OFF') => ({ label: lbl, value: () => (s[key] ? on : off), adjust: () => { s[key] = !s[key]; app.persist(); } });\n  return [\n    vol('music', 'MUSIC'), vol('sfx', 'SOUND'), vol('voices', 'VOICES'),\n    { label: 'BUTTON GLYPHS', value: () => (s.glyphs === 'xbox' ? 'XBOX' : 'PLAYSTATION'), adjust: () => { s.glyphs = s.glyphs === 'xbox' ? 'ps' : 'xbox'; app.persist(); } },\n    opt('AIM ASSIST', () => s.aim.toUpperCase(), ['off', 'low', 'high'], (v) => { s.aim = v; }),\n    { label: 'CURSOR SPEED', value: () => `${Math.round(s.cursor * 100)}%`, adjust: (d) => { s.cursor = Math.max(0.4, Math.min(2, Math.round((s.cursor + d * 0.1) * 10) / 10)); app.persist(); } },\n    toggle('RUMBLE', 'rumble'),\n    toggle('GIFT', 'giftToggle', 'TOGGLE', 'HOLD'),\n    { label: 'LOOK', value: () => LOOK_OPTIONS.find(([k]) => k === s.look)?.[1] ?? 'PIXEL', adjust: (d) => { const keys = LOOK_OPTIONS.map(([k]) => k); s.look = cycle(keys, s.look, d); applySettingsLook(ctx); app.persist(); } },\n    { label: 'PIXEL SIZE', value: () => `${s.pixel}X`, adjust: (d) => { s.pixel = Math.max(1, Math.min(4, s.pixel + d)); applySettingsLook(ctx); app.persist(); } },\n    { label: 'SCREEN SHAKE', value: () => `${Math.round(s.shake * 100)}%`, adjust: (d) => { s.shake = Math.max(0, Math.min(1, Math.round((s.shake + d * 0.25) * 100) / 100)); app.persist(); } },\n    toggle('REDUCE FLASHES', 'reduceFlash'),\n    { label: 'TEXT SPEED', value: () => (s.textSpeed <= 0.7 ? 'SLOW' : s.textSpeed >= 1.6 ? 'FAST' : 'NORMAL'), adjust: (d) => { const l = [0.6, 1, 2]; s.textSpeed = cycle(l, l.reduce((a, b) => (Math.abs(b - s.textSpeed) < Math.abs(a - s.textSpeed) ? b : a)), d); app.persist(); } },\n    { label: 'DIFFICULTY', value: () => DIFFICULTY[app.save.difficulty ?? 'resident'].label, adjust: (d) => { const l = Object.keys(DIFFICULTY); app.save.difficulty = cycle(l, app.save.difficulty ?? 'resident', d); app.persist(); } },\n    { label: 'FULLSCREEN', value: () => (typeof document !== 'undefined' && document.fullscreenElement ? 'ON' : 'OFF'), adjust: () => toggleFull() },\n    { label: 'RESET TO DEFAULTS', action: () => { const keep = DEFAULT_SETTINGS(); Object.assign(s, keep); audio.setVolume('music', keep.music); audio.setVolume('sfx', keep.sfx); applySettingsLook(ctx); app.persist(); } },\n  ];\n}\nfunction toggleFull() { if (typeof document === 'undefined') return; if (document.fullscreenElement) document.exitFullscreen?.(); else document.documentElement.requestFullscreen?.()?.catch?.(() => {}); }\nexport function applySettingsLook(ctx) {\n  const s = app.settings;\n  if (s.look === 'field') app.applyLook(1, 0.3, 0);\n  else ctx.engine.setLook(ctx.engine.lookPresets[s.look] ?? ctx.engine.lookPresets.none);\n}\nexport class SettingsScreen {\n  constructor(ctx, onBack) { this.ctx = ctx; this.onBack = onBack; this.menu = new Menu(app, buildSettingsItems(ctx), { y: 42, rowH: 17, width: Math.min(300, ctx.hud.width - 40), maxRows: Math.floor((ctx.hud.height - 80) / 17) }); }\n  update(ctx) {\n    const r = this.menu.update(ctx);\n    if (r === 'back') { storeAll(app.save, app.settings); this.onBack(); return; }\n    if (r?.adjust) r.adjust(1);\n    if (r?.action) r.action();\n    void ctx;\n  }\n  draw(ctx) {\n    const { hud } = ctx, W = hud.width, H = hud.height;\n    hud.rect(0, 0, W, H, 0x0d0b14);\n    const t = 'SETTINGS', tw = hud.measure(t, 2).width;\n    hud.text(Math.round(W / 2 - tw / 2), 12, t, { color: 0xffd24d, scale: 2 });\n    this.menu.draw(hud);\n    app.prompts.strip(hud, 8, H - 13, [['confirm', 'CHANGE'], ['back', 'BACK']]);\n  }\n}\nEOF\ncat > src/ui/dev.js <<'EOF'\n// Dev Mode: from Pause. Tabs on L1/R1, Q/E or click.\nimport { Menu } from './menu.js';\nimport { app } from '../core/app.js';\nimport { config, defaults, SLIDERS } from '../core/config.js';\nimport { dev } from '../sim/op.js';\nimport { CAMPAIGN_OPS, OPS } from '../content/ops/index.js';\nimport { SCENES } from '../content/scenes/index.js';\nimport { go } from '../stages/stage.js';\n\nconst TABS = ['BALANCE', 'CHEATS', 'JUMP', 'ACTIONS', 'VIEW'];\nexport class DevScreen {\n  constructor(stage, ctx, onBack) { this.stage = stage; this.ctx = ctx; this.onBack = onBack; this.tab = 0; this.rebuild(); this.tabHit = []; this.jumpOp = CAMPAIGN_OPS.indexOf(stage.sim?.opId); if (this.jumpOp < 0) this.jumpOp = 0; this.jumpStage = 0; this.jumpScene = 0; }\n  rebuild() {\n    const items = { BALANCE: this.balance(), CHEATS: this.cheats(), JUMP: this.jump(), ACTIONS: this.actions(), VIEW: this.view() }[TABS[this.tab]];\n    const W = this.ctx.hud.width;\n    this.menu = new Menu(app, items, { y: 44, rowH: 15, width: Math.min(360, W - 24), maxRows: Math.floor((this.ctx.hud.height - 80) / 15) });\n  }\n  setCfg(k, v) { config[k] = v; if (this.stage.sim?.cfg) this.stage.sim.cfg[k] = v; }\n  balance() {\n    return [\n      ...SLIDERS.map(([k, label, min, max, st]) => ({ label, sliderKey: k, value: () => (st < 1 ? config[k].toFixed(2) : String(config[k])), bar: () => (config[k] - min) / (max - min), adjust: (d) => this.setCfg(k, Math.max(min, Math.min(max, Math.round((config[k] + d * st) * 100) / 100))) })),\n      { label: 'RESET TO DEFAULTS', action: () => { for (const k of Object.keys(defaults)) this.setCfg(k, defaults[k]); } },\n    ];\n  }\n  cheats() {\n    const sim = this.stage.sim, c = sim?.cheats ?? {};\n    const t = (label, key) => ({ label, value: () => (c[key] ? 'ON' : 'OFF'), adjust: () => { c[key] = !c[key]; (app.flags.cheats ??= {})[key] = c[key]; } });\n    return [t('GOD VITALS', 'god'), t('INFINITE COMPOSURE', 'infComposure'), t('FREEZE CLOCK', 'freezeClock'), t('UNLIMITED MISTAKES', 'unlimitedMistakes'),\n      { label: 'UNLOCK ALL', action: () => { for (const id of CAMPAIGN_OPS) app.save.cleared[id] = true; app.persist(); this.toast('EVERY OP UNLOCKED'); } }];\n  }\n  jump() {\n    const ids = Object.keys(SCENES);\n    return [\n      { label: 'OP', value: () => OPS[CAMPAIGN_OPS[this.jumpOp]].title, adjust: (d) => { this.jumpOp = (this.jumpOp + d + CAMPAIGN_OPS.length) % CAMPAIGN_OPS.length; this.jumpStage = 0; } },\n      { label: 'STAGE', value: () => `${this.jumpStage + 1}/${OPS[CAMPAIGN_OPS[this.jumpOp]].stages.length} ${OPS[CAMPAIGN_OPS[this.jumpOp]].stages[this.jumpStage].id.toUpperCase()}`, adjust: (d) => { const n = OPS[CAMPAIGN_OPS[this.jumpOp]].stages.length; this.jumpStage = (this.jumpStage + d + n) % n; } },\n      { label: 'GO TO OP', action: async () => { const { OperationStage } = await import('../stages/operation.js'); const { resultsThenBack } = await import('../stages/flow.js'); go(new OperationStage({ op: CAMPAIGN_OPS[this.jumpOp], stage: this.jumpStage, onWin: resultsThenBack(CAMPAIGN_OPS[this.jumpOp]) })); } },\n      { label: 'SCENE', value: () => SCENES[ids[this.jumpScene]].title, adjust: (d) => { this.jumpScene = (this.jumpScene + d + ids.length) % ids.length; } },\n      { label: 'GO TO SCENE', action: async () => { const { StoryStage } = await import('../stages/story.js'); const { backToMain } = await import('../stages/flow.js'); go(new StoryStage({ scene: ids[this.jumpScene], onDone: backToMain })); } },\n    ];\n  }\n  actions() {\n    const s = () => this.stage.sim;\n    const spawnTypes = ['pool', 'bleeder', 'laceration', 'hook', 'strain'];\n    return [\n      { label: 'COMPLETE STAGE', action: () => { dev.completeStage(s()); this.onBack(); } },\n      { label: 'WIN OP', action: () => { dev.winOp(s()); this.onBack(); } },\n      { label: 'FAIL OP', action: () => { dev.failOp(s()); this.onBack(); } },\n      { label: 'TRIGGER CODE BLUE', action: () => { dev.codeBlue(s()); this.onBack(); } },\n      { label: 'SPAWN', value: () => spawnTypes[this.spawnIx ?? 0].toUpperCase(), adjust: (d) => { this.spawnIx = ((this.spawnIx ?? 0) + d + spawnTypes.length) % spawnTypes.length; }, action: () => { dev.spawn(s(), spawnTypes[this.spawnIx ?? 0]); this.toast('SPAWNED AT THE TIP'); } },\n      { label: 'COPY OP JSON TO CONSOLE', action: () => { console.log(JSON.stringify(this.stage.def, null, 1)); this.toast('LOGGED TO THE CONSOLE'); } },\n    ];\n  }\n  view() {\n    const st = this.stage;\n    return [\n      { label: 'HITBOX OVERLAY', value: () => (st.hitbox ? 'ON' : 'OFF'), adjust: () => { st.hitbox = !st.hitbox; } },\n      { label: 'BOT PLAYS', value: () => (st.botOn ? 'ON' : 'OFF'), adjust: () => { st.botOn = !st.botOn; } },\n      { label: 'BOT SKILL', value: () => (st.botSkill ?? 0.8).toFixed(2), bar: () => st.botSkill ?? 0.8, adjust: (d) => { st.botSkill = Math.max(0.1, Math.min(1, Math.round(((st.botSkill ?? 0.8) + d * 0.05) * 100) / 100)); } },\n      { label: 'SIM SPEED', value: () => `${st.simSpeed.toFixed(1)}X`, adjust: (d) => { st.simSpeed = Math.max(0.1, Math.min(3, Math.round((st.simSpeed + d * 0.1) * 10) / 10)); } },\n      { label: 'FREEZE FOR FRAME STEP', value: () => (st.frameFreeze ? 'ON' : 'OFF'), adjust: () => { st.frameFreeze = !st.frameFreeze; } },\n      { label: 'STEP ONE FRAME', action: () => { st.frameStep = 1; } },\n      { label: 'FPS', value: () => String(Math.round(this.ctx.engine.fps)) },\n      { label: 'SIM ENTITIES', value: () => String(st.sim?.ents.length ?? 0) },\n      { label: 'SIM STAGE', value: () => `${st.sim?.stage ?? 0}` },\n    ];\n  }\n  toast(text) { this.toastText = text; this.toastT = 2; }\n  update(ctx, dt) {\n    const n = app.devices.nav;\n    if (n.tabL || n.tabR) { this.tab = (this.tab + (n.tabR ? 1 : -1) + TABS.length) % TABS.length; this.rebuild(); ctx.audio.play('uiMove'); }\n    const click = app.devices.click(ctx.input);\n    if (click) for (const h of this.tabHit) if (click.x >= h.x && click.x <= h.x + h.w && click.y >= h.y && click.y <= h.y + h.h) { this.tab = h.i; this.rebuild(); ctx.audio.play('uiMove'); return; }\n    const r = this.menu.update(ctx);\n    if (r === 'back') { this.onBack(); return; }\n    if (r?.action) r.action();\n    else if (r?.adjust) r.adjust(1);\n    this.toastT = Math.max(0, (this.toastT ?? 0) - (dt ?? 1 / 60));\n  }\n  draw(ctx) {\n    const { hud } = ctx, W = hud.width, H = hud.height;\n    hud.rect(0, 0, W, H, 0x0d0b14);\n    hud.text(8, 6, 'DEV MODE', { color: 0x7fffa0, scale: 2 });\n    this.tabHit = [];\n    let x = 8;\n    TABS.forEach((t, i) => {\n      const w = hud.measure(t).width + 8;\n      hud.rect(x, 26, w, 11, i === this.tab ? 0x8a1f38 : 0x1a1f2b);\n      hud.text(x + 4, 28, t, { color: i === this.tab ? 0xffffff : 0x8a93a6 });\n      this.tabHit.push({ i, x, y: 26, w, h: 11 });\n      x += w + 3;\n    });\n    this.menu.draw(hud);\n    if (this.toastT > 0) hud.text(8, H - 26, this.toastText, { color: 0x7fffa0 });\n    app.prompts.strip(hud, 8, H - 13, [['confirm', 'DO'], ['tabl', 'TAB'], ['tabr', 'TAB'], ['back', 'BACK']]);\n  }\n}\nEOF\ncat > src/ui/pause.js <<'EOF'\n// Pause: Resume, Retry Stage, Restart, Settings, Dev Mode, Quit to Menu. Our own flag; the engine keeps running.\nimport { Menu } from './menu.js';\nimport { app } from '../core/app.js';\nimport { SettingsScreen } from './settings.js';\nimport { DevScreen } from './dev.js';\nimport { go } from '../stages/stage.js';\n\nexport class PauseOverlay {\n  constructor(stage, ctx) {\n    this.stage = stage; this.ctx = ctx; this.sub = null;\n    this.menu = new Menu(app, [\n      { label: 'RESUME', id: 'resume' }, { label: 'OBJECTIVE', id: 'obj' }, { label: 'RETRY STAGE', id: 'retry' }, { label: 'RESTART', id: 'restart' }, { label: 'SETTINGS', id: 'settings' }, { label: 'DEV MODE', id: 'dev' }, { label: 'QUIT TO MENU', id: 'quit' },\n    ], { y: 74, rowH: 18, width: 170 });\n    this.show = null;\n  }\n  update(ctx, dt) {\n    if (this.sub) { this.sub.update(ctx, dt); return; }\n    if (app.devices.nav.pause) { this.stage.closePause(); ctx.audio.play('uiBack'); return; }\n    const r = this.menu.update(ctx);\n    if (!r) return;\n    if (r === 'back') { this.stage.closePause(); return; }\n    switch (r.id) {\n      case 'resume': this.stage.closePause(); break;\n      case 'obj': this.stage.closePause(); this.stage.hud.prompt(this.stage.def.patient.objective); break;\n      case 'retry': this.stage.retryStage(); break;\n      case 'restart': this.stage.restart(); break;\n      case 'settings': this.sub = new SettingsScreen(ctx, () => { this.sub = null; }); break;\n      case 'dev': this.sub = new DevScreen(this.stage, ctx, () => { this.sub = null; if (this.stage.sim.phase !== 'play' || this.closeOnBack) this.stage.closePause(); }); break;\n      case 'quit': import('../stages/flow.js').then(({ backToMain }) => backToMain()); break;\n      default: break;\n    }\n  }\n  draw(ctx) {\n    const { hud } = ctx, W = hud.width, H = hud.height;\n    if (this.sub) { hud.clear(); this.sub.draw(ctx); return; }\n    hud.clear();\n    hud.rect(Math.round(W / 2 - 110), 24, 220, H - 50, 0x0d0b14);\n    hud.rect(Math.round(W / 2 - 110), 24, 220, 2, 0xffd24d);\n    const t = 'PAUSED', tw = hud.measure(t, 2).width;\n    hud.text(Math.round(W / 2 - tw / 2), 34, t, { scale: 2, color: 0xffffff });\n    hud.text(Math.round(W / 2 - hud.measure(this.stage.def.title).width / 2), 56, this.stage.def.title, { color: 0x8a93a6 });\n    this.menu.draw(hud);\n    app.prompts.strip(hud, Math.round(W / 2 - 100), H - 38, [['confirm', 'SELECT'], ['back', 'RESUME']]);\n  }\n}\nEOF\ncat > src/ui/fail.js <<'EOF'\n// The failure screen: flatline. Retry from this stage (rank capped at B) or Restart. After 2 failures, offer to lower the difficulty.\nimport { Menu } from './menu.js';\nimport { app } from '../core/app.js';\nimport { DIFFICULTY } from '../core/config.js';\n\nconst WHY = { clock: 'OUT OF TIME.', vitals: 'THE PATIENT IS GONE.', codeblue: 'WE LOST THE RHYTHM.', mistakes: 'YOU ARE RELIEVED, DOCTOR. FIVE MISTAKES.', cold: 'THE KIDNEY WARMED. COLD TIME GONE.', massage: 'THE HEART NEVER CAME BACK.', dev: 'DEV MODE FAILED THIS OP.' };\nexport class MenuFail {\n  constructor(stage, ctx) {\n    this.stage = stage;\n    const id = stage.def.id;\n    app.save.fails[id] = (app.save.fails[id] ?? 0) + 1;\n    app.persist();\n    const items = [{ label: 'RETRY FROM THIS STAGE', id: 'retry' }, { label: 'RESTART THE OP', id: 'restart' }];\n    const diffs = Object.keys(DIFFICULTY), here = diffs.indexOf(app.save.difficulty ?? 'resident');\n    if (app.save.fails[id] >= 2 && here > 0) items.push({ label: `LOWER DIFFICULTY: ${DIFFICULTY[diffs[here - 1]].label}`, id: 'lower', diff: diffs[here - 1] });\n    items.push({ label: 'QUIT TO MENU', id: 'quit' });\n    this.menu = new Menu(app, items, { y: 118, rowH: 18, width: 240 });\n    this.flat = 0;\n    void ctx;\n  }\n  update(ctx) {\n    const r = this.menu.update(ctx);\n    if (!r || r === 'back') return;\n    if (r.id === 'retry') this.stage.retryStage();\n    else if (r.id === 'restart') this.stage.restart();\n    else if (r.id === 'lower') { app.save.difficulty = r.diff; app.persist(); this.stage.nextDifficulty = r.diff; this.stage.opts.difficulty = r.diff; this.stage.restart(); } else if (r.id === 'quit') import('../stages/flow.js').then(({ backToMain }) => backToMain());\n  }\n  draw(ctx) {\n    const { hud } = ctx, W = hud.width, H = hud.height;\n    hud.clear();\n    hud.rect(0, 0, W, H, 0x12060a);\n    const y = 42;\n    hud.rect(10, y, W - 20, 1, 0xff3a3a);\n    const t = 'TIME OF DEATH...', tw = hud.measure(t, 2).width;\n    hud.text(Math.round(W / 2 - tw / 2), 58, t, { scale: 2, color: 0xff6b6b });\n    const why = WHY[this.stage.sim.loseWhy] ?? 'WE LOST HIM.', ww = hud.measure(why).width;\n    hud.text(Math.round(W / 2 - ww / 2), 84, why, { color: 0xffffff });\n    const hint = 'RETRYING CAPS YOUR RANK AT B.', hw = hud.measure(hint).width;\n    hud.text(Math.round(W / 2 - hw / 2), 96, hint, { color: 0x8a93a6 });\n    this.menu.draw(hud);\n    app.prompts.strip(hud, 8, H - 13, [['confirm', 'SELECT']]);\n  }\n}\nEOF\ncat > src/stages/flow.js <<'EOF'\n// The way screens connect.\nimport { app } from '../core/app.js';\nimport { go } from './stage.js';\nimport { CAMPAIGN, recordOp } from '../sim/campaign.js';\nimport { MainMenuStage, TitleStage } from './title.js';\nimport { StoryStage } from './story.js';\nimport { BriefingStage } from './briefing.js';\nimport { ResultsStage } from './results.js';\nimport { OperationStage } from './operation.js';\nimport { CreditsStage } from './about.js';\nimport { AttractStage } from './attract.js';\nimport { REEL } from './attract.js';\nimport { LogStage } from './log.js';\n\nexport const backToMain = () => go(new MainMenuStage());\nexport const backToTitle = () => go(new TitleStage());\n\nexport function runCampaign(i) {\n  const entry = CAMPAIGN[i];\n  app.save.next = i;\n  app.persist();\n  if (!entry) { go(new TitleStage()); return; }\n  if (entry.scene) { go(new StoryStage({ scene: entry.scene, onDone: () => runCampaign(i + 1) })); return; }\n  if (entry.op) { go(new BriefingStage({ op: entry.op, onGo: () => go(new OperationStage({ op: entry.op, onWin: (res) => { recordOp(app.save, entry.op, res); app.save.next = i + 1; app.persist(); go(new ResultsStage({ op: entry.op, res, onDone: () => runCampaign(i + 1) })); } }), 'iris') })); return; }\n  if (entry.credits) { app.save.finished = true; app.persist(); go(new CreditsStage({ onDone: () => go(new TitleStage()) })); }\n}\nexport const resultsThenBack = (op) => (res) => { recordOp(app.save, op, res); app.persist(); go(new ResultsStage({ op, res, onDone: backToMain })); };\nexport const replayOp = (op) => go(new BriefingStage({ op, onGo: () => go(new OperationStage({ op, onWin: (res) => { recordOp(app.save, op, res); app.persist(); go(new ResultsStage({ op, res, onDone: () => go(new LogStage()) })); } }), 'iris') }));\n\n/* ---- attract ---- */\nexport function startAttract() { app.demo = true; app.attractIndex = app.attractIndex ?? 0; playReel(); }\nfunction playReel() {\n  const seg = REEL[app.attractIndex % REEL.length];\n  app.attractIndex++;\n  go(new AttractStage(seg));\n}\napp.nextAttract = playReel;\napp.exitAttract = () => { app.demo = false; app.swallow = 0.25; go(new TitleStage()); };\nEOF\ncat > src/stages/title.js <<'EOF'\n// Title and Main Menu: a dim OR-7, a swinging lamp, an EKG line through the title.\nimport { app } from '../core/app.js';\nimport { Stage, go, setView } from './stage.js';\nimport { buildSet } from '../view/sets.js';\nimport { TITLE, TAGLINE } from '../core/meta.js';\nimport { Menu } from '../ui/menu.js';\nimport { SettingsScreen } from '../ui/settings.js';\nimport { DIFFICULTY } from '../core/config.js';\nimport { CAMPAIGN } from '../sim/campaign.js';\nimport { SCENES } from '../content/scenes/index.js';\nimport { OPS } from '../content/ops/index.js';\n\nconst WIDE = [[3.8, 2.7, 6.4], [0, 1.1, 0]];\nexport class TitleStage extends Stage {\n  name = 'title';\n  t = 0; ekg = 0;\n  async build(ctx) {\n    this.set = await buildSet(ctx, 'or7');\n    this.rain = ctx.audio.loop('rain', { volume: 0.4 });\n    app.director?.play('title');\n    app.applyLook(1, 0.5, 0);\n    setView(ctx, ...WIDE, 34);\n  }\n  status() { return 'title'; }\n  update(ctx, dt) {\n    app.devices.poll(ctx, dt);\n    this.t += dt;\n    this.set.update(dt);\n    app.director?.update(dt);\n    const a = this.t * 0.1;\n    setView(ctx, [WIDE[0][0] + Math.sin(a) * 0.6, WIDE[0][1], WIDE[0][2] + Math.cos(a) * 0.3], WIDE[1], 34);\n    const { hud } = ctx, W = hud.width, H = hud.height;\n    hud.clear();\n    drawTitle(hud, W, Math.round(H * 0.28), this.t);\n    const device = app.devices.last === 'pad';\n    if (Math.floor(this.t * 1.6) % 2 === 0 || this.t < 0.6) {\n      const y = Math.round(H * 0.72);\n      const text = device ? 'PRESS {confirm}' : 'PRESS ENTER OR CLICK';\n      const w = app.prompts.items(text, hud, 0xffffff).reduce((n, i) => n + i.w, 0);\n      app.prompts.draw(hud, Math.round(W / 2 - w / 2), y, text, { width: w + 6 });\n    }\n    if (app.swallow > 0) { app.swallow -= dt; return; }\n    if (app.touchGate) { if (app.devices.idle > 2) import('./flow.js').then(({ startAttract }) => startAttract()); return; }\n    if (app.devices.anyPress) { ctx.audio.play('uiConfirm'); go(new MainMenuStage()); return; }\n    if (app.devices.idle >= 10) import('./flow.js').then(({ startAttract }) => startAttract());\n  }\n}\nexport function drawTitle(hud, W, y, t) {\n  const tw = hud.measure(TITLE, 4).width;\n  const scale = tw > W - 24 ? 3 : 4;\n  const w = hud.measure(TITLE, scale).width, x = Math.round(W / 2 - w / 2);\n  hud.text(x + 2, y + 2, TITLE, { scale, color: 0x3c0d24, shadow: false });\n  hud.text(x, y, TITLE, { scale, color: 0xf6f2e6, shadow: 0x5e1430 });\n  // An EKG line draws itself through the title.\n  const cy = y + Math.round((7 * scale) / 2), span = W - 20, head = (t * 180) % (span + 60);\n  for (let i = 0; i < span; i++) {\n    if (i > head) break;\n    const k = (i % 120) / 120;\n    const v = k < 0.34 ? 0 : k < 0.38 ? -3 : k < 0.42 ? 0 : k < 0.45 ? 15 : k < 0.5 ? -18 : k < 0.53 ? 4 : k < 0.62 ? 0 : k < 0.68 ? -3 : 0;\n    const fade = head - i;\n    if (fade < 120) hud.rect(10 + i, cy + v, 1, 1, fade < 12 ? 0xffffff : 0x46e0a0);\n  }\n  const sub = TAGLINE, sw = hud.measure(sub).width;\n  hud.text(Math.round(W / 2 - sw / 2), y + 7 * scale + 10, sub, { color: 0x8ad0ff });\n}\n\nexport class MainMenuStage extends Stage {\n  name = 'main';\n  t = 0; sub = null;\n  async build(ctx) {\n    this.set = await buildSet(ctx, 'or7');\n    this.rain = ctx.audio.loop('rain', { volume: 0.3 });\n    app.director?.play('title');\n    app.applyLook(1, 0.55, 0);\n    const has = app.save.next > 0;\n    const items = [];\n    items.push({ label: has ? 'ON CALL: CONTINUE' : 'ON CALL: NEW SHIFT', id: has ? 'continue' : 'new', detail: has ? this.nextName() : 'A NIGHT SHIFT AT VERITY GENERAL.' });\n    if (has) items.push({ label: 'NEW SHIFT', id: 'new', detail: 'START FROM THE BEGINNING.' });\n    const hasLog = Object.keys(app.save.cleared).length > 0;\n    items.push({ label: 'OPERATING LOG', id: 'log', disabled: !hasLog, detail: hasLog ? 'REPLAY WHAT YOU HAVE CLEARED.' : 'CLEAR AN OP FIRST.' });\n    items.push({ label: 'CONSULT', id: 'consult', detail: 'UP TO FOUR PAIRS OF HANDS ON ONE PATIENT.' });\n    items.push({ label: 'SETTINGS', id: 'settings', detail: 'SOUND, BUTTON GLYPHS, FEEL.' });\n    items.push({ label: 'ABOUT', id: 'about', detail: 'SOURCE, TESTING, CREDITS.' });\n    this.menu = new Menu(app, items, { x: 26, y: 96, rowH: 20, width: 180 });\n    this.difficulty = null;\n  }\n  nextName() { const e = CAMPAIGN[app.save.next]; if (!e) return ''; if (e.scene) return `NEXT: ${SCENES[e.scene].title}`; if (e.op) return `NEXT: ${OPS[e.op].title}`; return 'NEXT: CREDITS'; }\n  status() { return `main focus=${this.menu.focus}`; }\n  update(ctx, dt) {\n    app.devices.poll(ctx, dt);\n    this.t += dt;\n    this.set.update(dt);\n    app.director?.update(dt);\n    const a = this.t * 0.14;\n    setView(ctx, [WIDE[0][0] + Math.sin(a) * 1.4, WIDE[0][1] + 0.2, WIDE[0][2] + Math.cos(a) * 0.5], [WIDE[1][0] + 0.8, WIDE[1][1], WIDE[1][2]], 34);\n    const { hud } = ctx, W = hud.width, H = hud.height;\n    hud.clear();\n    if (this.sub) { this.sub.update(ctx, dt); this.sub?.draw(ctx); app.devices.idle = 0; return; }\n    if (this.difficulty) { this.updateDifficulty(ctx); return; }\n    if (app.devices.idle >= 10) { import('./flow.js').then(({ startAttract }) => startAttract()); }\n    const titleW = hud.measure(TITLE, 3).width;\n    hud.text(26, 32, TITLE, { scale: Math.min(3, Math.floor((W - 40) / (titleW / 3))), color: 0xf6f2e6, shadow: 0x5e1430 });\n    hud.text(26, 60, TAGLINE, { color: 0x8ad0ff });\n    const r = this.menu.update(ctx);\n    this.menu.draw(hud);\n    const det = this.menu.items[this.menu.focus]?.detail;\n    if (det) hud.text(26, H - 28, det, { color: 0x8a93a6 });\n    app.prompts.strip(hud, 26, H - 13, [['confirm', 'SELECT'], ['back', 'TITLE']]);\n    if (r === 'back') { go(new TitleStage()); return; }\n    if (!r) return;\n    switch (r.id) {\n      case 'new': this.difficulty = new Menu(app, Object.entries(DIFFICULTY).map(([k, v]) => ({ label: v.label, id: k, detail: v.about })), { x: 26, y: 96, rowH: 20, width: 180, focus: 1 }); break;\n      case 'continue': import('./flow.js').then(({ runCampaign }) => runCampaign(app.save.next)); break;\n      case 'log': import('./log.js').then(({ LogStage }) => go(new LogStage())); break;\n      case 'consult': import('./consult.js').then(({ ConsultStage }) => go(new ConsultStage())); break;\n      case 'settings': this.sub = new SettingsScreen(ctx, () => { this.sub = null; }); break;\n      case 'about': import('./about.js').then(({ AboutStage }) => go(new AboutStage())); break;\n      default: break;\n    }\n  }\n  updateDifficulty(ctx) {\n    const { hud } = ctx, H = hud.height;\n    hud.text(26, 62, 'PICK A DIFFICULTY', { color: 0xffd24d, scale: 2 });\n    const r = this.difficulty.update(ctx);\n    this.difficulty.draw(hud);\n    const det = this.difficulty.items[this.difficulty.focus]?.detail;\n    if (det) hud.text(26, H - 28, det, { color: 0x8a93a6 });\n    app.prompts.strip(hud, 26, H - 13, [['confirm', 'SELECT'], ['back', 'BACK']]);\n    if (r === 'back') { this.difficulty = null; return; }\n    if (r) {\n      const scoresKeep = app.save.cleared;\n      app.save.difficulty = r.id; app.save.next = 0; app.save.fails = {}; app.save.cleared = scoresKeep;\n      app.persist();\n      import('./flow.js').then(({ runCampaign }) => runCampaign(0));\n    }\n  }\n}\nEOF\ncat > src/stages/story.js <<'EOF'\n// Story scene: a set plus talking heads. Typewriter text with gibberish voice, the speaker leaning in, the other dimmed.\nimport { THREE } from '../../pixel-engine.js';\nimport { app } from '../core/app.js';\nimport { Stage, go, setView } from './stage.js';\nimport { SCENES } from '../content/scenes/index.js';\nimport { buildSet, buildFigure } from '../view/sets.js';\nimport { BustView } from '../view/bust.js';\nimport { CAST } from '../content/cast.js';\n\nconst CLOSE = [[0.2, 1.75, 5.1], [0, 1.42, 0]];\nexport class StoryStage extends Stage {\n  name = 'story';\n  constructor(opts) { super(); this.opts = opts; this.scene = SCENES[opts.scene]; this.i = -1; this.typed = 0; this.t = 0; this.hold = 0; this.busts = {}; this.figures = []; this.marks = []; this.camA = 0; }\n  async build(ctx) {\n    this.set = await buildSet(ctx, this.scene.set);\n    this.rain = this.set.def.rain ? ctx.audio.loop('rain', { volume: 0.6 }) : null;\n    app.director?.play(this.scene.music);\n    app.applyLook(1, 0.3, 0);\n    // Busts live on a stage of their own in front of the set.\n    this.front = new THREE.Group();\n    this.front.position.set(0, 0, 2);\n    ctx.scene.add(this.front);\n    for (const f of this.scene.figures ?? []) {\n      const fig = buildFigure(ctx, f[0], this.set.group, [f[1][0], 0, f[1][1]], Math.atan2(-f[1][0], 3 - f[1][1]), f[0] === 'ilya' ? { masked: false } : {});\n      fig.play(f[2]);\n      this.figures.push(fig);\n    }\n    const ids = new Set(this.scene.cast);\n    for (const b of this.scene.beats) { if (b.who && CAST[b.who]) ids.add(b.who); if (b.swap) ids.add(b.swap); }\n    for (const id of ids) { const v = new BustView(ctx, id, { parent: this.front }); v.root.visible = false; this.busts[id] = v; }\n    this.left = this.scene.cast[0]; this.right = this.scene.cast[1];\n    this.next(ctx);\n  }\n  status() { return `story ${this.scene.id} beat=${this.i}/${this.scene.beats.length}`; }\n  next(ctx) {\n    this.i++;\n    if (this.i >= this.scene.beats.length) { this.finish(); return; }\n    const b = this.scene.beats[this.i];\n    this.typed = 0; this.hold = 0;\n    if (b.swap && b.swap !== this.right && b.swap !== this.left) this.left = b.swap;\n    if (b.cue) ctx.audio.play(b.cue);\n    this.camMode = b.cam === 'wide' ? 'wide' : 'close';\n    this.camA = 0;\n  }\n  finish() { if (this.done) return; this.done = true; this.opts.onDone?.(); }\n  update(ctx, dt) {\n    if (this.done) return;\n    const devs = app.devices;\n    devs.poll(ctx, dt);\n    this.t += dt;\n    this.set.update(dt);\n    app.director?.update(dt);\n    for (const f of this.figures) f.update(dt);\n    const beat = this.scene.beats[this.i];\n    if (!beat) return;\n    const plain = beat.say.replace(/\\*/g, '');\n    const cast = CAST[beat.who];\n    const speed = 34 * (app.settings.textSpeed ?? 1) * (cast?.voice?.speed ?? 1);\n    const prev = Math.floor(this.typed);\n    this.typed = Math.min(plain.length, this.typed + dt * speed);\n    const now = Math.floor(this.typed);\n    const bust = this.busts[beat.who];\n    for (let k = prev; k < now; k++) {\n      const end = plain.slice(k).search(/[.!?]/);\n      if (app.voice.letter(ctx.audio, plain[k], beat.who, cast, k, end >= 0 ? plain[k + end] : '')) bust?.talk(1);\n    }\n    // Who's on stage.\n    const speakerSide = beat.who === this.right ? 'right' : beat.who === this.left ? 'left' : 'left';\n    if (beat.who !== this.left && beat.who !== this.right) this.left = beat.who;\n    const wide = this.camMode === 'wide';\n    for (const [id, v] of Object.entries(this.busts)) {\n      const side = id === this.left ? -1 : id === this.right ? 1 : 0;\n      v.root.visible = !!side && !wide;\n      if (!side) continue;\n      const on = id === beat.who;\n      v.leanTarget = on ? 1 : 0;\n      const tx = side * (on ? 0.95 : 1.25), ty = on ? -0.1 : -0.36, tz = on ? 0.35 : -0.6;\n      const r = v.root.position, k = Math.min(1, dt * 8);\n      r.x += (tx - r.x) * k; r.y += (ty - r.y) * k; r.z += (tz - r.z) * k;\n      v.root.rotation.y = -side * 0.22;\n      if (on) { v.setEmotion !== undefined; if (v.emotion !== beat.emo) v.setEmotion(beat.emo); } else if (beat.other && v.emotion !== beat.other) v.setEmotion(beat.other);\n      v.update(dt);\n      v.look = side * -0.06;\n    }\n    // Camera\n    this.camA = Math.min(1, this.camA + dt * 1.5);\n    if (wide) { const W = this.set.def.wide, f = 1 - this.camA * 0.08; setView(ctx, [W.pos[0] * f + Math.sin(this.t * 0.2) * 0.12, W.pos[1], W.pos[2] * f], W.target, 34); } else { const off = speakerSide === 'right' ? 0.12 : -0.12; setView(ctx, [CLOSE[0][0] + off + Math.sin(this.t * 0.4) * 0.02, CLOSE[0][1] + 0.02 * Math.sin(this.t * 0.6), CLOSE[0][2] + 2.4], [off, CLOSE[1][1], 2], 30); }\n    // Text box\n    const { hud } = ctx, W = hud.width, H = hud.height;\n    hud.clear();\n    const boxH = 54, y = H - boxH;\n    hud.rect(0, y - 1, W, boxH + 1, 0x0d0b14);\n    hud.rect(0, y - 1, W, 1, cast?.color ?? 0xffffff);\n    hud.text(10, y + 5, cast?.name ?? '', { color: cast?.color ?? 0xffffff });\n    app.prompts.draw(hud, 10, y + 16, beat.say, { width: W - 20, limit: now, lineH: 11 });\n    hud.text(10, 8, this.scene.title, { color: 0x8a93a6 });\n    hud.text(W - hud.measure(this.set.def.label).width - 10, 8, this.set.def.label, { color: 0x5a6172 });\n    const complete = this.typed >= plain.length;\n    if (complete && Math.floor(this.t * 3) % 2) hud.rect(W - 14, H - 12, 6, 6, 0xffd24d);\n    app.prompts.strip(hud, 10, H - 11, [['confirm', 'NEXT'], ['skipScene', 'HOLD: SKIP']]);\n    // comic marks\n    if (!wide && (beat.emo === 'shock' || beat.emo === 'panic') && this.typed < 12) {\n      const sx = beat.who === this.right ? W * 0.72 : W * 0.28, sy = H * 0.22;\n      for (let i = 0; i < 7; i++) { const a = (i / 7) * Math.PI * 2 + 0.3, R = 26 + (i % 2) * 6; hud.rect(Math.round(sx + Math.cos(a) * R), Math.round(sy + Math.sin(a) * R), 2, 2, 0xffffff); hud.rect(Math.round(sx + Math.cos(a) * (R + 5)), Math.round(sy + Math.sin(a) * (R + 5)), 2, 2, 0xffffff); }\n    }\n    // Input: advance or skip\n    const n = devs.nav, click = input => input.wasPressed('MouseLeft');\n    const pad = devs.pads.find(Boolean);\n    const skipHeld = ctx.input.isDown('Escape') || (pad && pad.buttons[3] > 0.5);\n    this.skipT = skipHeld ? (this.skipT ?? 0) + dt : 0;\n    if (this.skipT > 0) { hud.rect(10, H - 3, Math.round((W - 20) * Math.min(1, this.skipT / 0.8)), 2, 0xffd24d); }\n    if (this.skipT >= 0.8) { this.finish(); return; }\n    if (n.confirm || click(ctx.input) || (pad && pad.buttons[0] > 0.5 && !(pad.prev[0] > 0.5) && false)) {\n      if (!complete) this.typed = plain.length;\n      else { ctx.audio.play('uiMove'); this.next(ctx); }\n    }\n    void go;\n  }\n}\nEOF\ncat > src/stages/briefing.js <<'EOF'\n// Briefing: a clipboard chart. Patient, age, job, hook, op title stamped, one-line objective.\nimport { app } from '../core/app.js';\nimport { Stage, setView } from './stage.js';\nimport { OPS } from '../content/ops/index.js';\nimport { buildSet } from '../view/sets.js';\n\nexport class BriefingStage extends Stage {\n  name = 'briefing';\n  constructor(opts) { super(); this.opts = opts; this.def = OPS[opts.op]; this.t = 0; }\n  async build(ctx) { this.set = await buildSet(ctx, 'or7'); app.applyLook(1, 0.4, 0); app.director?.play(this.def.n >= 5 ? 'or-tense' : 'or-calm'); ctx.audio.play('stamp'); }\n  status() { return `briefing ${this.def.id}`; }\n  update(ctx, dt) {\n    app.devices.poll(ctx, dt);\n    this.t += dt;\n    this.set.update(dt);\n    app.director?.update(dt);\n    setView(ctx, [2.6 - this.t * 0.04, 3.1, 4.8], [0, 1, 0], 34);\n    const { hud } = ctx, W = hud.width, H = hud.height, P = this.def.patient;\n    hud.clear();\n    const cw = Math.min(330, W - 30), ch = Math.min(216, H - 30), x = Math.round(W / 2 - cw / 2), drop = Math.max(0, 1 - this.t * 4), y = Math.round((H - ch) / 2 - drop * 240);\n    hud.rect(x, y, cw, ch, 0x7a5430);\n    hud.rect(x + 6, y + 6, cw - 12, ch - 12, 0xf1ead4);\n    hud.rect(x + cw / 2 - 26, y - 4, 52, 12, 0x8a93a6);\n    hud.rect(x + cw / 2 - 18, y - 7, 36, 5, 0xc8d0da);\n    const ink = 0x20202a, tx = x + 16, tw = cw - 32;\n    hud.text(tx, y + 18, 'VERITY GENERAL  /  OR-7', { color: 0x6a6a72, shadow: false });\n    hud.text(tx, y + 32, P.name, { color: ink, scale: 2, shadow: false });\n    hud.text(tx, y + 54, `${P.age ? `AGE ${P.age}   ` : ''}${P.job}`, { color: 0x45454f, shadow: false });\n    hud.rect(tx, y + 66, tw, 1, 0xa8a090);\n    app.prompts.draw(hud, tx, y + 74, P.hook, { width: tw, color: 0x7a1020, lineH: 11 });\n    hud.text(tx, y + 104, 'OBJECTIVE', { color: 0x6a6a72, shadow: false });\n    app.prompts.draw(hud, tx, y + 116, P.objective, { width: tw, color: ink, lineH: 11 });\n    // stamped op title\n    const stampIn = Math.min(1, Math.max(0, (this.t - 0.4) * 6));\n    if (stampIn > 0) {\n      const label = this.def.title, tw2 = hud.measure(label, 2).width;\n      const sx = x + cw - tw2 - 22, sy = y + ch - 44;\n      hud.rect(sx - 5, sy - 5, tw2 + 10, 25, 0x9a1020);\n      hud.rect(sx - 3, sy - 3, tw2 + 6, 21, 0xf1ead4);\n      hud.text(sx, sy, label, { color: 0x9a1020, scale: 2, shadow: false });\n      if (!this.stamped) { this.stamped = true; ctx.audio.play('stamp'); app.shake(0.3); }\n    }\n    hud.text(tx, y + ch - 28, this.def.surgeon === 'sabine' ? 'SURGEON: DR. ACHTERBERG' : 'SURGEON: DR. MARSH', { color: 0x45454f, shadow: false });\n    app.prompts.strip(hud, 10, H - 13, [['confirm', 'SCRUB IN']]);\n    if (this.t > 0.5 && (app.devices.nav.confirm || app.devices.click(ctx.input))) { if (!this.left) { this.left = true; ctx.audio.play('uiConfirm'); this.opts.onGo(); } }\n  }\n}\nEOF\ncat > src/stages/results.js <<'EOF'\n// Results: the chart drops in, lines tally with ticks, the rank stamp slams, Reyes comments, then the patient's follow-up.\nimport { app } from '../core/app.js';\nimport { Stage, setView } from './stage.js';\nimport { OPS } from '../content/ops/index.js';\nimport { buildSet } from '../view/sets.js';\n\nconst COMMENT = {\n  S: ['...Adequate.', \"Don't get used to the feeling.\", 'I have seen worse. From better.'],\n  A: ['That will do. Barely.', 'Your hands are improving. Your face is not.'],\n  B: ['He will keep it. Do better.', \"It'll hold. Probably.\"],\n  C: [\"He'll keep the arm. Do better.\", 'I have seen tidier work from a raccoon.'],\n};\nexport class ResultsStage extends Stage {\n  name = 'results';\n  constructor(opts) { super(); this.opts = opts; this.def = OPS[opts.op]; this.t = 0; this.line = -1; }\n  async build(ctx) { this.set = await buildSet(ctx, 'or7'); app.applyLook(1, 0.4, 0); app.director?.play('results'); this.rows = this.buildRows(); }\n  buildRows() {\n    const r = this.opts.res;\n    return [['TECHNIQUE', r.technique], ['TIME', r.timeBonus], ['VITALS', r.vitalBonus], ['BEST STREAK', r.bestStreak], ['MISTAKES', r.mistakes], ...(r.looks ? [['SECOND LOOKS', `-${r.looks * 5}%`]] : []), ['TOTAL', r.total]];\n  }\n  status() { return `results ${this.def.id} rank=${this.opts.res.rank}`; }\n  update(ctx, dt) {\n    app.devices.poll(ctx, dt);\n    this.t += dt;\n    this.set.update(dt);\n    app.director?.update(dt);\n    setView(ctx, [2.6, 3.1, 4.8], [0, 1, 0], 34);\n    const { hud } = ctx, W = hud.width, H = hud.height, R = this.opts.res;\n    hud.clear();\n    const cw = Math.min(340, W - 20), ch = Math.min(232, H - 20), x = Math.round(W / 2 - cw / 2), drop = Math.max(0, 1 - this.t * 4), y = Math.round((H - ch) / 2 - drop * 260);\n    hud.rect(x, y, cw, ch, 0x7a5430); hud.rect(x + 5, y + 5, cw - 10, ch - 10, 0xf1ead4);\n    const ink = 0x20202a, tx = x + 14;\n    hud.text(tx, y + 12, this.def.title, { color: ink, scale: 2, shadow: false });\n    hud.text(tx, y + 32, this.def.patient.name, { color: 0x6a6a72, shadow: false });\n    const nShown = Math.min(this.rows.length, Math.floor((this.t - 0.4) / 0.28));\n    if (nShown > this.line) { this.line = nShown; if (nShown > 0) { ctx.audio.play('tick'); ctx.audio.play('uiMove'); } }\n    for (let i = 0; i < nShown; i++) {\n      const [label, val] = this.rows[i], ry = y + 46 + i * 12, last = label === 'TOTAL';\n      hud.text(tx, ry, label, { color: last ? ink : 0x45454f, shadow: false });\n      const v = String(val);\n      hud.text(tx + 150 - hud.measure(v).width, ry, v, { color: ink, shadow: false });\n    }\n    const stampT = 0.4 + this.rows.length * 0.28 + 0.3;\n    if (this.t > stampT) {\n      if (!this.slammed) { this.slammed = true; ctx.audio.play('stamp'); app.shake(0.6); app.rumble(0.8, 0.6, 180); }\n      const k = Math.max(1, 3 - (this.t - stampT) * 12), big = Math.round(6 * k) ;\n      const sc = Math.min(8, big), lw = hud.measure(R.rank, sc).width;\n      const col = R.rank === 'S' ? 0xc08a10 : R.rank === 'A' ? 0x2b7a40 : R.rank === 'B' ? 0x2b5a9a : 0x9a1020;\n      const sx = x + cw - 70 - lw / 2, sy = y + 72 - (7 * sc) / 2;\n      hud.rect(sx - 8, sy - 8, lw + 16, 7 * sc + 16, col);\n      hud.rect(sx - 5, sy - 5, lw + 10, 7 * sc + 10, 0xf1ead4);\n      hud.text(Math.round(sx), Math.round(sy), R.rank, { color: col, scale: sc, shadow: false });\n      if (R.pristine) { const t = 'PRISTINE', w = hud.measure(t).width; hud.rect(x + cw - 70 - w / 2 - 3, y + 118, w + 6, 11, 0xc08a10); hud.text(x + cw - 70 - w / 2, y + 120, t, { color: 0xffffff, shadow: false }); }\n    }\n    if (this.t > stampT + 0.6) {\n      const list = COMMENT[R.rank]; const line = list[(this.def.n ?? 0) % list.length];\n      hud.text(tx, y + ch - 62, 'NURSE REYES', { color: 0x9a1020, shadow: false });\n      app.prompts.draw(hud, tx, y + ch - 52, line, { width: cw - 30, color: ink });\n    }\n    if (this.t > stampT + 1.2) {\n      hud.text(tx, y + ch - 36, 'AFTERWARD', { color: 0x6a6a72, shadow: false });\n      app.prompts.draw(hud, tx, y + ch - 26, this.def.patient.followUp[R.rank] ?? this.def.patient.followUp.C, { width: cw - 30, color: 0x45454f });\n    }\n    app.prompts.strip(hud, 10, H - 13, [['confirm', 'NEXT']]);\n    const go2 = app.devices.nav.confirm || app.devices.click(ctx.input);\n    if (go2) { if (this.t < stampT + 1.2) this.t = stampT + 1.3; else if (!this.left) { this.left = true; ctx.audio.play('uiConfirm'); this.opts.onDone(); } }\n  }\n}\nEOF\ncat > src/stages/log.js <<'EOF'\n// Operating Log: one chart at a time, flip with left/right. Best rank and a patient line.\nimport { app } from '../core/app.js';\nimport { Stage, go, setView } from './stage.js';\nimport { OPS, CAMPAIGN_OPS } from '../content/ops/index.js';\nimport { buildSet } from '../view/sets.js';\n\nexport class LogStage extends Stage {\n  name = 'log';\n  i = 0; t = 0;\n  async build(ctx) { this.set = await buildSet(ctx, 'ward'); app.applyLook(1, 0.4, 0); app.director?.play('ward'); this.list = CAMPAIGN_OPS.filter((id) => app.save.cleared[id]); if (!this.list.length) this.list = []; }\n  status() { return `log ${this.i}`; }\n  update(ctx, dt) {\n    app.devices.poll(ctx, dt);\n    this.t += dt;\n    this.set.update(dt); app.director?.update(dt);\n    setView(ctx, [3.8, 2.4, 6.4], [0, 1, 0], 34);\n    const { hud } = ctx, W = hud.width, H = hud.height, n = app.devices.nav;\n    hud.clear();\n    if (n.back || app.devices.rightClick(ctx.input)) { ctx.audio.play('uiBack'); import('./flow.js').then(({ backToMain }) => backToMain()); return; }\n    if (!this.list.length) { hud.text(20, 40, 'NOTHING CLEARED YET.', { color: 0xffffff }); return; }\n    if (n.left) { this.i = (this.i - 1 + this.list.length) % this.list.length; ctx.audio.play('uiMove'); this.t = 0; }\n    if (n.right) { this.i = (this.i + 1) % this.list.length; ctx.audio.play('uiMove'); this.t = 0; }\n    const def = OPS[this.list[this.i]], P = def.patient, rank = app.save.ranks[def.id] ?? 'C';\n    const cw = Math.min(330, W - 40), ch = Math.min(200, H - 40), x = Math.round(W / 2 - cw / 2), y = Math.round((H - ch) / 2 - Math.max(0, 1 - this.t * 6) * 40);\n    hud.rect(x, y, cw, ch, 0x7a5430); hud.rect(x + 5, y + 5, cw - 10, ch - 10, 0xf1ead4);\n    const ink = 0x20202a, tx = x + 16;\n    hud.text(tx, y + 14, `OP ${def.n}`, { color: 0x6a6a72, shadow: false });\n    hud.text(tx, y + 26, def.title, { color: ink, scale: 2, shadow: false });\n    hud.text(tx, y + 48, P.name, { color: 0x45454f, shadow: false });\n    app.prompts.draw(hud, tx, y + 62, P.followUp[rank] ?? '', { width: cw - 90, color: ink });\n    hud.text(tx, y + 110, `BEST ${app.save.scores[def.id] ?? 0}`, { color: 0x45454f, shadow: false });\n    const col = rank === 'S' ? 0xc08a10 : rank === 'A' ? 0x2b7a40 : rank === 'B' ? 0x2b5a9a : 0x9a1020;\n    hud.text(x + cw - 54, y + 18, rank, { color: col, scale: 5, shadow: false });\n    if (app.save.pristine?.[def.id]) hud.text(x + cw - 66, y + 62, 'PRISTINE', { color: 0xc08a10, shadow: false });\n    hud.text(tx, y + ch - 22, `${this.i + 1} / ${this.list.length}`, { color: 0x6a6a72, shadow: false });\n    // arrows clickable\n    hud.text(x - 14, Math.round(y + ch / 2), '<', { color: 0xffd24d, scale: 2 }); hud.text(x + cw + 3, Math.round(y + ch / 2), '>', { color: 0xffd24d, scale: 2 });\n    app.prompts.strip(hud, 10, H - 13, [['confirm', 'OPERATE'], ['back', 'BACK']]);\n    const c = app.devices.click(ctx.input);\n    if (c && c.x < x) { this.i = (this.i - 1 + this.list.length) % this.list.length; this.t = 0; }\n    else if (c && c.x > x + cw) { this.i = (this.i + 1) % this.list.length; this.t = 0; }\n    else if (n.confirm || c) import('./flow.js').then(({ replayOp }) => replayOp(def.id));\n    void go;\n  }\n}\nEOF\necho ok","description":"Write fx, settings, dev, pause, fail, flow and screens"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":22711,"cache_read_input_tokens":323230,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":22711},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9464247a-cdba-4289-905c-cd8b34e5d270","uuid":"454eb319-8044-4876-8ea5-907ed59d71e0","timestamp":"2026-11-05T17:00:27.683Z","request_id":"req_011Cgk8nFRVgN3vnAHMzeuQD","wire_tool_inputs":{"toolu_01QsM2k213wLwYRvDb9MG9xb":{"command":"cat > src/view/fx.js <<'EOF'\n// Particles and small flourishes.\nimport { buildModel, setLookLayer } from '../../pixel-engine.js';\nimport { CATALOG, PROP_DEFS } from '../content/models/index.js';\nimport { TABLE_GAP } from './field.js';\n\nconst PRE = {\n  blood: { count: [4, 8], life: [0.25, 0.55], speed: [1, 3], spread: 1, gravity: -9, size: [1, 1], colors: ['red', 'plum', 'red'] },\n  foam: { count: [2, 3], life: [0.3, 0.6], speed: [0.3, 0.9], gravity: 1, size: [1, 1], colors: ['mist', 'white', 'red'] },\n  smokeTool: { count: [1, 2], life: [0.4, 0.8], speed: [0.4, 1], gravity: 1.8, size: [1, 2], colors: ['mist', 'slate', 'slate'] },\n  gelfoam: { count: [2, 4], life: [0.3, 0.6], speed: [0.3, 0.7], gravity: 0.7, size: [1, 1], colors: ['cyan', 'white', 'lime'] },\n  spark: { count: [3, 6], life: [0.15, 0.35], speed: [1.5, 3.5], gravity: -4, size: [1, 1], colors: ['white', 'sand', 'white'] },\n  goo: { count: [12, 22], life: [0.4, 0.9], speed: [1.5, 5], gravity: -9, size: [1, 2], colors: ['plum', 'lime', 'red'] },\n  tears: { count: [6, 10], life: [0.3, 0.6], speed: [1, 2.4], gravity: -8, size: [1, 1], colors: ['cyan', 'white', 'sky'] },\n  gold: { count: [20, 30], life: [0.5, 1.2], speed: [1, 4], gravity: 0.8, size: [1, 2], colors: ['sand', 'white', 'orange'] },\n  plus: { count: [8, 12], life: [0.4, 0.8], speed: [0.8, 2], gravity: 2, size: [1, 1], colors: ['lime', 'cyan', 'white'] },\n};\n\nexport class Fx {\n  constructor(ctx, field, app) {\n    this.ctx = ctx; this.field = field; this.app = app; this.flying = [];\n    for (const [k, v] of Object.entries(PRE)) ctx.particles.register(k, v);\n  }\n  blood(x, y, z, n) { this.ctx.particles.burst('blood', [x, y + 0.1, z], n ? { count: n } : {}); }\n  smoke(x, y, z) { if ((this.tick = (this.tick ?? 0) + 1) % 3 === 0) this.ctx.particles.burst('smokeTool', [x, y + 0.2, z]); }\n  sparkAt(x, y, z) { this.ctx.particles.burst('spark', [x, y + 0.15, z]); }\n  inject(x, y, z) { this.ctx.particles.burst('plus', [x, y + 0.3, z]); }\n  knock(x, z) { this.ctx.particles.burst('blood', [x, this.field.surface(x, z) + 0.2, z], { count: 10 }); this.ctx.engine.screen.shockwave([x, 0, z], { radius: 0.18, strength: 0.4 }); }\n  strainHit(e) { this.ctx.particles.burst('goo', [e.x, this.field.surface(e.x, e.z) + 0.4, e.z]); }\n  strainDead(e) { const x = e.x ?? 0, z = e.z ?? 0; this.ctx.particles.burst(e.type === 'miserere' ? 'gold' : 'goo', [x, this.field.surface(x, z) + 0.5, z], { count: 40 }); this.ctx.engine.screen.shockwave([x, 0, z], { radius: 0.4, strength: 0.7 }); }\n  done(e, sim) {\n    const x = e.x + (e.table ?? 0) * TABLE_GAP, y = this.field.surface(e.x, e.z);\n    switch (e.k) {\n      case 'pool': case 'bleeder': this.ctx.particles.burst('foam', [x, y + 0.2, e.z], { count: 8 }); break;\n      case 'polyp': case 'egg': case 'cyst': case 'clot': this.ctx.particles.burst('goo', [x, y + 0.2, e.z], { count: 8 }); break;\n      case 'mask': this.ctx.particles.burst('gelfoam', [x, y + 0.2, e.z], { count: 16 }); break;\n      case 'dressing': case 'nick': this.ctx.particles.burst('plus', [x, y + 0.2, e.z]); break;\n      case 'eye': this.ctx.particles.burst('tears', [x, y + 0.3, e.z]); break;\n      default: break;\n    }\n    void sim;\n  }\n  toDish(e, table) {\n    const def = PROP_DEFS[{ hook: 'hook', key: 'key', coin: 'coin', card: 'card', magnet: 'magnet', debris: 'debris', tumor: 'tumor', clamp: 'clamp', oldKidney: 'oldKidney', plate: 'plate', tendril: 'tendril' }[e.look] ?? 'hook'];\n    const obj = buildModel(def, { catalog: CATALOG }).object.clone(true);\n    setLookLayer(obj, 'actors');\n    obj.scale.setScalar(0.8);\n    const x0 = e.x + table * TABLE_GAP, y0 = this.field.surface(e.x, e.z) + 0.5, z0 = e.z;\n    obj.position.set(x0, y0, z0);\n    this.ctx.scene.add(obj);\n    const dish = this.field.dish;\n    const toX = 6.6 + table * TABLE_GAP;\n    this.flying.push({ obj, t: 0, x0, y0, z0, x1: toX, y1: dish.y + 0.1, z1: dish.z, spin: 12 });\n  }\n  update(dt) {\n    for (let i = this.flying.length - 1; i >= 0; i--) {\n      const f = this.flying[i];\n      f.t = Math.min(1, f.t + dt / 0.35);\n      const t = f.t;\n      f.obj.position.set(f.x0 + (f.x1 - f.x0) * t, f.y0 + (f.y1 - f.y0) * t + Math.sin(t * Math.PI) * 2, f.z0 + (f.z1 - f.z0) * t);\n      f.obj.rotation.y += f.spin * dt;\n      if (t >= 1) { this.flying.splice(i, 1); this.ctx.particles.burst('spark', [f.x1, f.y1 + 0.1, f.z1], { count: 5 }); }\n    }\n  }\n}\nEOF\ncat > src/ui/settings.js <<'EOF'\n// Settings: same screen everywhere, pad-navigable.\nimport { Menu } from './menu.js';\nimport { app } from '../core/app.js';\nimport { DEFAULT_SETTINGS, storeAll } from '../core/save.js';\nimport { DIFFICULTY } from '../core/config.js';\n\nexport const LOOK_OPTIONS = [['field', 'PIXEL (DEFAULT)'], ['spooky', 'SPOOKY'], ['noir', 'NOIR'], ['playstation', 'PS1'], ['vhs_rental', 'VHS'], ['old_photo', 'OLD PHOTO']];\nconst cycle = (list, v, dir) => list[(list.indexOf(v) + dir + list.length) % list.length];\nexport function buildSettingsItems(ctx) {\n  const s = app.settings, audio = ctx.audio;\n  const vol = (key, label) => ({ label, value: () => `${Math.round((key === 'voices' ? s.voices : audio.volume[key]) * 100)}%`, bar: () => (key === 'voices' ? s.voices : audio.volume[key]), adjust: (d) => {\n    const base = key === 'voices' ? s.voices : audio.volume[key], v = Math.max(0, Math.min(1, Math.round((base + d * 0.05) * 100) / 100));\n    if (key === 'voices') s.voices = v; else { audio.setVolume(key, v); s[key] = v; }\n    if (key !== 'music') audio.play(key === 'voices' ? 'syl-1am' : 'uiConfirm');\n    app.persist();\n  } });\n  const opt = (label, get, values, set) => ({ label, value: () => get(), adjust: (d) => { set(cycle(values, currentKey(get, values), d)); app.persist(); } });\n  const currentKey = (get, values) => values.find((v) => label(v) === get()) ?? values[0];\n  const label = (v) => String(v).toUpperCase();\n  const toggle = (lbl, key, on = 'ON', off = 'OFF') => ({ label: lbl, value: () => (s[key] ? on : off), adjust: () => { s[key] = !s[key]; app.persist(); } });\n  return [\n    vol('music', 'MUSIC'), vol('sfx', 'SOUND'), vol('voices', 'VOICES'),\n    { label: 'BUTTON GLYPHS', value: () => (s.glyphs === 'xbox' ? 'XBOX' : 'PLAYSTATION'), adjust: () => { s.glyphs = s.glyphs === 'xbox' ? 'ps' : 'xbox'; app.persist(); } },\n    opt('AIM ASSIST', () => s.aim.toUpperCase(), ['off', 'low', 'high'], (v) => { s.aim = v; }),\n    { label: 'CURSOR SPEED', value: () => `${Math.round(s.cursor * 100)}%`, adjust: (d) => { s.cursor = Math.max(0.4, Math.min(2, Math.round((s.cursor + d * 0.1) * 10) / 10)); app.persist(); } },\n    toggle('RUMBLE', 'rumble'),\n    toggle('GIFT', 'giftToggle', 'TOGGLE', 'HOLD'),\n    { label: 'LOOK', value: () => LOOK_OPTIONS.find(([k]) => k === s.look)?.[1] ?? 'PIXEL', adjust: (d) => { const keys = LOOK_OPTIONS.map(([k]) => k); s.look = cycle(keys, s.look, d); applySettingsLook(ctx); app.persist(); } },\n    { label: 'PIXEL SIZE', value: () => `${s.pixel}X`, adjust: (d) => { s.pixel = Math.max(1, Math.min(4, s.pixel + d)); applySettingsLook(ctx); app.persist(); } },\n    { label: 'SCREEN SHAKE', value: () => `${Math.round(s.shake * 100)}%`, adjust: (d) => { s.shake = Math.max(0, Math.min(1, Math.round((s.shake + d * 0.25) * 100) / 100)); app.persist(); } },\n    toggle('REDUCE FLASHES', 'reduceFlash'),\n    { label: 'TEXT SPEED', value: () => (s.textSpeed <= 0.7 ? 'SLOW' : s.textSpeed >= 1.6 ? 'FAST' : 'NORMAL'), adjust: (d) => { const l = [0.6, 1, 2]; s.textSpeed = cycle(l, l.reduce((a, b) => (Math.abs(b - s.textSpeed) < Math.abs(a - s.textSpeed) ? b : a)), d); app.persist(); } },\n    { label: 'DIFFICULTY', value: () => DIFFICULTY[app.save.difficulty ?? 'resident'].label, adjust: (d) => { const l = Object.keys(DIFFICULTY); app.save.difficulty = cycle(l, app.save.difficulty ?? 'resident', d); app.persist(); } },\n    { label: 'FULLSCREEN', value: () => (typeof document !== 'undefined' && document.fullscreenElement ? 'ON' : 'OFF'), adjust: () => toggleFull() },\n    { label: 'RESET TO DEFAULTS', action: () => { const keep = DEFAULT_SETTINGS(); Object.assign(s, keep); audio.setVolume('music', keep.music); audio.setVolume('sfx', keep.sfx); applySettingsLook(ctx); app.persist(); } },\n  ];\n}\nfunction toggleFull() { if (typeof document === 'undefined') return; if (document.fullscreenElement) document.exitFullscreen?.(); else document.documentElement.requestFullscreen?.()?.catch?.(() => {}); }\nexport function applySettingsLook(ctx) {\n  const s = app.settings;\n  if (s.look === 'field') app.applyLook(1, 0.3, 0);\n  else ctx.engine.setLook(ctx.engine.lookPresets[s.look] ?? ctx.engine.lookPresets.none);\n}\nexport class SettingsScreen {\n  constructor(ctx, onBack) { this.ctx = ctx; this.onBack = onBack; this.menu = new Menu(app, buildSettingsItems(ctx), { y: 42, rowH: 17, width: Math.min(300, ctx.hud.width - 40), maxRows: Math.floor((ctx.hud.height - 80) / 17) }); }\n  update(ctx) {\n    const r = this.menu.update(ctx);\n    if (r === 'back') { storeAll(app.save, app.settings); this.onBack(); return; }\n    if (r?.adjust) r.adjust(1);\n    if (r?.action) r.action();\n    void ctx;\n  }\n  draw(ctx) {\n    const { hud } = ctx, W = hud.width, H = hud.height;\n    hud.rect(0, 0, W, H, 0x0d0b14);\n    const t = 'SETTINGS', tw = hud.measure(t, 2).width;\n    hud.text(Math.round(W / 2 - tw / 2), 12, t, { color: 0xffd24d, scale: 2 });\n    this.menu.draw(hud);\n    app.prompts.strip(hud, 8, H - 13, [['confirm', 'CHANGE'], ['back', 'BACK']]);\n  }\n}\nEOF\ncat > src/ui/dev.js <<'EOF'\n// Dev Mode: from Pause. Tabs on L1/R1, Q/E or click.\nimport { Menu } from './menu.js';\nimport { app } from '../core/app.js';\nimport { config, defaults, SLIDERS } from '../core/config.js';\nimport { dev } from '../sim/op.js';\nimport { CAMPAIGN_OPS, OPS } from '../content/ops/index.js';\nimport { SCENES } from '../content/scenes/index.js';\nimport { go } from '../stages/stage.js';\n\nconst TABS = ['BALANCE', 'CHEATS', 'JUMP', 'ACTIONS', 'VIEW'];\nexport class DevScreen {\n  constructor(stage, ctx, onBack) { this.stage = stage; this.ctx = ctx; this.onBack = onBack; this.tab = 0; this.rebuild(); this.tabHit = []; this.jumpOp = CAMPAIGN_OPS.indexOf(stage.sim?.opId); if (this.jumpOp < 0) this.jumpOp = 0; this.jumpStage = 0; this.jumpScene = 0; }\n  rebuild() {\n    const items = { BALANCE: this.balance(), CHEATS: this.cheats(), JUMP: this.jump(), ACTIONS: this.actions(), VIEW: this.view() }[TABS[this.tab]];\n    const W = this.ctx.hud.width;\n    this.menu = new Menu(app, items, { y: 44, rowH: 15, width: Math.min(360, W - 24), maxRows: Math.floor((this.ctx.hud.height - 80) / 15) });\n  }\n  setCfg(k, v) { config[k] = v; if (this.stage.sim?.cfg) this.stage.sim.cfg[k] = v; }\n  balance() {\n    return [\n      ...SLIDERS.map(([k, label, min, max, st]) => ({ label, sliderKey: k, value: () => (st < 1 ? config[k].toFixed(2) : String(config[k])), bar: () => (config[k] - min) / (max - min), adjust: (d) => this.setCfg(k, Math.max(min, Math.min(max, Math.round((config[k] + d * st) * 100) / 100))) })),\n      { label: 'RESET TO DEFAULTS', action: () => { for (const k of Object.keys(defaults)) this.setCfg(k, defaults[k]); } },\n    ];\n  }\n  cheats() {\n    const sim = this.stage.sim, c = sim?.cheats ?? {};\n    const t = (label, key) => ({ label, value: () => (c[key] ? 'ON' : 'OFF'), adjust: () => { c[key] = !c[key]; (app.flags.cheats ??= {})[key] = c[key]; } });\n    return [t('GOD VITALS', 'god'), t('INFINITE COMPOSURE', 'infComposure'), t('FREEZE CLOCK', 'freezeClock'), t('UNLIMITED MISTAKES', 'unlimitedMistakes'),\n      { label: 'UNLOCK ALL', action: () => { for (const id of CAMPAIGN_OPS) app.save.cleared[id] = true; app.persist(); this.toast('EVERY OP UNLOCKED'); } }];\n  }\n  jump() {\n    const ids = Object.keys(SCENES);\n    return [\n      { label: 'OP', value: () => OPS[CAMPAIGN_OPS[this.jumpOp]].title, adjust: (d) => { this.jumpOp = (this.jumpOp + d + CAMPAIGN_OPS.length) % CAMPAIGN_OPS.length; this.jumpStage = 0; } },\n      { label: 'STAGE', value: () => `${this.jumpStage + 1}/${OPS[CAMPAIGN_OPS[this.jumpOp]].stages.length} ${OPS[CAMPAIGN_OPS[this.jumpOp]].stages[this.jumpStage].id.toUpperCase()}`, adjust: (d) => { const n = OPS[CAMPAIGN_OPS[this.jumpOp]].stages.length; this.jumpStage = (this.jumpStage + d + n) % n; } },\n      { label: 'GO TO OP', action: async () => { const { OperationStage } = await import('../stages/operation.js'); const { resultsThenBack } = await import('../stages/flow.js'); go(new OperationStage({ op: CAMPAIGN_OPS[this.jumpOp], stage: this.jumpStage, onWin: resultsThenBack(CAMPAIGN_OPS[this.jumpOp]) })); } },\n      { label: 'SCENE', value: () => SCENES[ids[this.jumpScene]].title, adjust: (d) => { this.jumpScene = (this.jumpScene + d + ids.length) % ids.length; } },\n      { label: 'GO TO SCENE', action: async () => { const { StoryStage } = await import('../stages/story.js'); const { backToMain } = await import('../stages/flow.js'); go(new StoryStage({ scene: ids[this.jumpScene], onDone: backToMain })); } },\n    ];\n  }\n  actions() {\n    const s = () => this.stage.sim;\n    const spawnTypes = ['pool', 'bleeder', 'laceration', 'hook', 'strain'];\n    return [\n      { label: 'COMPLETE STAGE', action: () => { dev.completeStage(s()); this.onBack(); } },\n      { label: 'WIN OP', action: () => { dev.winOp(s()); this.onBack(); } },\n      { label: 'FAIL OP', action: () => { dev.failOp(s()); this.onBack(); } },\n      { label: 'TRIGGER CODE BLUE', action: () => { dev.codeBlue(s()); this.onBack(); } },\n      { label: 'SPAWN', value: () => spawnTypes[this.spawnIx ?? 0].toUpperCase(), adjust: (d) => { this.spawnIx = ((this.spawnIx ?? 0) + d + spawnTypes.length) % spawnTypes.length; }, action: () => { dev.spawn(s(), spawnTypes[this.spawnIx ?? 0]); this.toast('SPAWNED AT THE TIP'); } },\n      { label: 'COPY OP JSON TO CONSOLE', action: () => { console.log(JSON.stringify(this.stage.def, null, 1)); this.toast('LOGGED TO THE CONSOLE'); } },\n    ];\n  }\n  view() {\n    const st = this.stage;\n    return [\n      { label: 'HITBOX OVERLAY', value: () => (st.hitbox ? 'ON' : 'OFF'), adjust: () => { st.hitbox = !st.hitbox; } },\n      { label: 'BOT PLAYS', value: () => (st.botOn ? 'ON' : 'OFF'), adjust: () => { st.botOn = !st.botOn; } },\n      { label: 'BOT SKILL', value: () => (st.botSkill ?? 0.8).toFixed(2), bar: () => st.botSkill ?? 0.8, adjust: (d) => { st.botSkill = Math.max(0.1, Math.min(1, Math.round(((st.botSkill ?? 0.8) + d * 0.05) * 100) / 100)); } },\n      { label: 'SIM SPEED', value: () => `${st.simSpeed.toFixed(1)}X`, adjust: (d) => { st.simSpeed = Math.max(0.1, Math.min(3, Math.round((st.simSpeed + d * 0.1) * 10) / 10)); } },\n      { label: 'FREEZE FOR FRAME STEP', value: () => (st.frameFreeze ? 'ON' : 'OFF'), adjust: () => { st.frameFreeze = !st.frameFreeze; } },\n      { label: 'STEP ONE FRAME', action: () => { st.frameStep = 1; } },\n      { label: 'FPS', value: () => String(Math.round(this.ctx.engine.fps)) },\n      { label: 'SIM ENTITIES', value: () => String(st.sim?.ents.length ?? 0) },\n      { label: 'SIM STAGE', value: () => `${st.sim?.stage ?? 0}` },\n    ];\n  }\n  toast(text) { this.toastText = text; this.toastT = 2; }\n  update(ctx, dt) {\n    const n = app.devices.nav;\n    if (n.tabL || n.tabR) { this.tab = (this.tab + (n.tabR ? 1 : -1) + TABS.length) % TABS.length; this.rebuild(); ctx.audio.play('uiMove'); }\n    const click = app.devices.click(ctx.input);\n    if (click) for (const h of this.tabHit) if (click.x >= h.x && click.x <= h.x + h.w && click.y >= h.y && click.y <= h.y + h.h) { this.tab = h.i; this.rebuild(); ctx.audio.play('uiMove'); return; }\n    const r = this.menu.update(ctx);\n    if (r === 'back') { this.onBack(); return; }\n    if (r?.action) r.action();\n    else if (r?.adjust) r.adjust(1);\n    this.toastT = Math.max(0, (this.toastT ?? 0) - (dt ?? 1 / 60));\n  }\n  draw(ctx) {\n    const { hud } = ctx, W = hud.width, H = hud.height;\n    hud.rect(0, 0, W, H, 0x0d0b14);\n    hud.text(8, 6, 'DEV MODE', { color: 0x7fffa0, scale: 2 });\n    this.tabHit = [];\n    let x = 8;\n    TABS.forEach((t, i) => {\n      const w = hud.measure(t).width + 8;\n      hud.rect(x, 26, w, 11, i === this.tab ? 0x8a1f38 : 0x1a1f2b);\n      hud.text(x + 4, 28, t, { color: i === this.tab ? 0xffffff : 0x8a93a6 });\n      this.tabHit.push({ i, x, y: 26, w, h: 11 });\n      x += w + 3;\n    });\n    this.menu.draw(hud);\n    if (this.toastT > 0) hud.text(8, H - 26, this.toastText, { color: 0x7fffa0 });\n    app.prompts.strip(hud, 8, H - 13, [['confirm', 'DO'], ['tabl', 'TAB'], ['tabr', 'TAB'], ['back', 'BACK']]);\n  }\n}\nEOF\ncat > src/ui/pause.js <<'EOF'\n// Pause: Resume, Retry Stage, Restart, Settings, Dev Mode, Quit to Menu. Our own flag; the engine keeps running.\nimport { Menu } from './menu.js';\nimport { app } from '../core/app.js';\nimport { SettingsScreen } from './settings.js';\nimport { DevScreen } from './dev.js';\nimport { go } from '../stages/stage.js';\n\nexport class PauseOverlay {\n  constructor(stage, ctx) {\n    this.stage = stage; this.ctx = ctx; this.sub = null;\n    this.menu = new Menu(app, [\n      { label: 'RESUME', id: 'resume' }, { label: 'OBJECTIVE', id: 'obj' }, { label: 'RETRY STAGE', id: 'retry' }, { label: 'RESTART', id: 'restart' }, { label: 'SETTINGS', id: 'settings' }, { label: 'DEV MODE', id: 'dev' }, { label: 'QUIT TO MENU', id: 'quit' },\n    ], { y: 74, rowH: 18, width: 170 });\n    this.show = null;\n  }\n  update(ctx, dt) {\n    if (this.sub) { this.sub.update(ctx, dt); return; }\n    if (app.devices.nav.pause) { this.stage.closePause(); ctx.audio.play('uiBack'); return; }\n    const r = this.menu.update(ctx);\n    if (!r) return;\n    if (r === 'back') { this.stage.closePause(); return; }\n    switch (r.id) {\n      case 'resume': this.stage.closePause(); break;\n      case 'obj': this.stage.closePause(); this.stage.hud.prompt(this.stage.def.patient.objective); break;\n      case 'retry': this.stage.retryStage(); break;\n      case 'restart': this.stage.restart(); break;\n      case 'settings': this.sub = new SettingsScreen(ctx, () => { this.sub = null; }); break;\n      case 'dev': this.sub = new DevScreen(this.stage, ctx, () => { this.sub = null; if (this.stage.sim.phase !== 'play' || this.closeOnBack) this.stage.closePause(); }); break;\n      case 'quit': import('../stages/flow.js').then(({ backToMain }) => backToMain()); break;\n      default: break;\n    }\n  }\n  draw(ctx) {\n    const { hud } = ctx, W = hud.width, H = hud.height;\n    if (this.sub) { hud.clear(); this.sub.draw(ctx); return; }\n    hud.clear();\n    hud.rect(Math.round(W / 2 - 110), 24, 220, H - 50, 0x0d0b14);\n    hud.rect(Math.round(W / 2 - 110), 24, 220, 2, 0xffd24d);\n    const t = 'PAUSED', tw = hud.measure(t, 2).width;\n    hud.text(Math.round(W / 2 - tw / 2), 34, t, { scale: 2, color: 0xffffff });\n    hud.text(Math.round(W / 2 - hud.measure(this.stage.def.title).width / 2), 56, this.stage.def.title, { color: 0x8a93a6 });\n    this.menu.draw(hud);\n    app.prompts.strip(hud, Math.round(W / 2 - 100), H - 38, [['confirm', 'SELECT'], ['back', 'RESUME']]);\n  }\n}\nEOF\ncat > src/ui/fail.js <<'EOF'\n// The failure screen: flatline. Retry from this stage (rank capped at B) or Restart. After 2 failures, offer to lower the difficulty.\nimport { Menu } from './menu.js';\nimport { app } from '../core/app.js';\nimport { DIFFICULTY } from '../core/config.js';\n\nconst WHY = { clock: 'OUT OF TIME.', vitals: 'THE PATIENT IS GONE.', codeblue: 'WE LOST THE RHYTHM.', mistakes: 'YOU ARE RELIEVED, DOCTOR. FIVE MISTAKES.', cold: 'THE KIDNEY WARMED. COLD TIME GONE.', massage: 'THE HEART NEVER CAME BACK.', dev: 'DEV MODE FAILED THIS OP.' };\nexport class MenuFail {\n  constructor(stage, ctx) {\n    this.stage = stage;\n    const id = stage.def.id;\n    app.save.fails[id] = (app.save.fails[id] ?? 0) + 1;\n    app.persist();\n    const items = [{ label: 'RETRY FROM THIS STAGE', id: 'retry' }, { label: 'RESTART THE OP', id: 'restart' }];\n    const diffs = Object.keys(DIFFICULTY), here = diffs.indexOf(app.save.difficulty ?? 'resident');\n    if (app.save.fails[id] >= 2 && here > 0) items.push({ label: `LOWER DIFFICULTY: ${DIFFICULTY[diffs[here - 1]].label}`, id: 'lower', diff: diffs[here - 1] });\n    items.push({ label: 'QUIT TO MENU', id: 'quit' });\n    this.menu = new Menu(app, items, { y: 118, rowH: 18, width: 240 });\n    this.flat = 0;\n    void ctx;\n  }\n  update(ctx) {\n    const r = this.menu.update(ctx);\n    if (!r || r === 'back') return;\n    if (r.id === 'retry') this.stage.retryStage();\n    else if (r.id === 'restart') this.stage.restart();\n    else if (r.id === 'lower') { app.save.difficulty = r.diff; app.persist(); this.stage.nextDifficulty = r.diff; this.stage.opts.difficulty = r.diff; this.stage.restart(); } else if (r.id === 'quit') import('../stages/flow.js').then(({ backToMain }) => backToMain());\n  }\n  draw(ctx) {\n    const { hud } = ctx, W = hud.width, H = hud.height;\n    hud.clear();\n    hud.rect(0, 0, W, H, 0x12060a);\n    const y = 42;\n    hud.rect(10, y, W - 20, 1, 0xff3a3a);\n    const t = 'TIME OF DEATH...', tw = hud.measure(t, 2).width;\n    hud.text(Math.round(W / 2 - tw / 2), 58, t, { scale: 2, color: 0xff6b6b });\n    const why = WHY[this.stage.sim.loseWhy] ?? 'WE LOST HIM.', ww = hud.measure(why).width;\n    hud.text(Math.round(W / 2 - ww / 2), 84, why, { color: 0xffffff });\n    const hint = 'RETRYING CAPS YOUR RANK AT B.', hw = hud.measure(hint).width;\n    hud.text(Math.round(W / 2 - hw / 2), 96, hint, { color: 0x8a93a6 });\n    this.menu.draw(hud);\n    app.prompts.strip(hud, 8, H - 13, [['confirm', 'SELECT']]);\n  }\n}\nEOF\ncat > src/stages/flow.js <<'EOF'\n// The way screens connect.\nimport { app } from '../core/app.js';\nimport { go } from './stage.js';\nimport { CAMPAIGN, recordOp } from '../sim/campaign.js';\nimport { MainMenuStage, TitleStage } from './title.js';\nimport { StoryStage } from './story.js';\nimport { BriefingStage } from './briefing.js';\nimport { ResultsStage } from './results.js';\nimport { OperationStage } from './operation.js';\nimport { CreditsStage } from './about.js';\nimport { AttractStage } from './attract.js';\nimport { REEL } from './attract.js';\nimport { LogStage } from './log.js';\n\nexport const backToMain = () => go(new MainMenuStage());\nexport const backToTitle = () => go(new TitleStage());\n\nexport function runCampaign(i) {\n  const entry = CAMPAIGN[i];\n  app.save.next = i;\n  app.persist();\n  if (!entry) { go(new TitleStage()); return; }\n  if (entry.scene) { go(new StoryStage({ scene: entry.scene, onDone: () => runCampaign(i + 1) })); return; }\n  if (entry.op) { go(new BriefingStage({ op: entry.op, onGo: () => go(new OperationStage({ op: entry.op, onWin: (res) => { recordOp(app.save, entry.op, res); app.save.next = i + 1; app.persist(); go(new ResultsStage({ op: entry.op, res, onDone: () => runCampaign(i + 1) })); } }), 'iris') })); return; }\n  if (entry.credits) { app.save.finished = true; app.persist(); go(new CreditsStage({ onDone: () => go(new TitleStage()) })); }\n}\nexport const resultsThenBack = (op) => (res) => { recordOp(app.save, op, res); app.persist(); go(new ResultsStage({ op, res, onDone: backToMain })); };\nexport const replayOp = (op) => go(new BriefingStage({ op, onGo: () => go(new OperationStage({ op, onWin: (res) => { recordOp(app.save, op, res); app.persist(); go(new ResultsStage({ op, res, onDone: () => go(new LogStage()) })); } }), 'iris') }));\n\n/* ---- attract ---- */\nexport function startAttract() { app.demo = true; app.attractIndex = app.attractIndex ?? 0; playReel(); }\nfunction playReel() {\n  const seg = REEL[app.attractIndex % REEL.length];\n  app.attractIndex++;\n  go(new AttractStage(seg));\n}\napp.nextAttract = playReel;\napp.exitAttract = () => { app.demo = false; app.swallow = 0.25; go(new TitleStage()); };\nEOF\ncat > src/stages/title.js <<'EOF'\n// Title and Main Menu: a dim OR-7, a swinging lamp, an EKG line through the title.\nimport { app } from '../core/app.js';\nimport { Stage, go, setView } from './stage.js';\nimport { buildSet } from '../view/sets.js';\nimport { TITLE, TAGLINE } from '../core/meta.js';\nimport { Menu } from '../ui/menu.js';\nimport { SettingsScreen } from '../ui/settings.js';\nimport { DIFFICULTY } from '../core/config.js';\nimport { CAMPAIGN } from '../sim/campaign.js';\nimport { SCENES } from '../content/scenes/index.js';\nimport { OPS } from '../content/ops/index.js';\n\nconst WIDE = [[3.8, 2.7, 6.4], [0, 1.1, 0]];\nexport class TitleStage extends Stage {\n  name = 'title';\n  t = 0; ekg = 0;\n  async build(ctx) {\n    this.set = await buildSet(ctx, 'or7');\n    this.rain = ctx.audio.loop('rain', { volume: 0.4 });\n    app.director?.play('title');\n    app.applyLook(1, 0.5, 0);\n    setView(ctx, ...WIDE, 34);\n  }\n  status() { return 'title'; }\n  update(ctx, dt) {\n    app.devices.poll(ctx, dt);\n    this.t += dt;\n    this.set.update(dt);\n    app.director?.update(dt);\n    const a = this.t * 0.1;\n    setView(ctx, [WIDE[0][0] + Math.sin(a) * 0.6, WIDE[0][1], WIDE[0][2] + Math.cos(a) * 0.3], WIDE[1], 34);\n    const { hud } = ctx, W = hud.width, H = hud.height;\n    hud.clear();\n    drawTitle(hud, W, Math.round(H * 0.28), this.t);\n    const device = app.devices.last === 'pad';\n    if (Math.floor(this.t * 1.6) % 2 === 0 || this.t < 0.6) {\n      const y = Math.round(H * 0.72);\n      const text = device ? 'PRESS {confirm}' : 'PRESS ENTER OR CLICK';\n      const w = app.prompts.items(text, hud, 0xffffff).reduce((n, i) => n + i.w, 0);\n      app.prompts.draw(hud, Math.round(W / 2 - w / 2), y, text, { width: w + 6 });\n    }\n    if (app.swallow > 0) { app.swallow -= dt; return; }\n    if (app.touchGate) { if (app.devices.idle > 2) import('./flow.js').then(({ startAttract }) => startAttract()); return; }\n    if (app.devices.anyPress) { ctx.audio.play('uiConfirm'); go(new MainMenuStage()); return; }\n    if (app.devices.idle >= 10) import('./flow.js').then(({ startAttract }) => startAttract());\n  }\n}\nexport function drawTitle(hud, W, y, t) {\n  const tw = hud.measure(TITLE, 4).width;\n  const scale = tw > W - 24 ? 3 : 4;\n  const w = hud.measure(TITLE, scale).width, x = Math.round(W / 2 - w / 2);\n  hud.text(x + 2, y + 2, TITLE, { scale, color: 0x3c0d24, shadow: false });\n  hud.text(x, y, TITLE, { scale, color: 0xf6f2e6, shadow: 0x5e1430 });\n  // An EKG line draws itself through the title.\n  const cy = y + Math.round((7 * scale) / 2), span = W - 20, head = (t * 180) % (span + 60);\n  for (let i = 0; i < span; i++) {\n    if (i > head) break;\n    const k = (i % 120) / 120;\n    const v = k < 0.34 ? 0 : k < 0.38 ? -3 : k < 0.42 ? 0 : k < 0.45 ? 15 : k < 0.5 ? -18 : k < 0.53 ? 4 : k < 0.62 ? 0 : k < 0.68 ? -3 : 0;\n    const fade = head - i;\n    if (fade < 120) hud.rect(10 + i, cy + v, 1, 1, fade < 12 ? 0xffffff : 0x46e0a0);\n  }\n  const sub = TAGLINE, sw = hud.measure(sub).width;\n  hud.text(Math.round(W / 2 - sw / 2), y + 7 * scale + 10, sub, { color: 0x8ad0ff });\n}\n\nexport class MainMenuStage extends Stage {\n  name = 'main';\n  t = 0; sub = null;\n  async build(ctx) {\n    this.set = await buildSet(ctx, 'or7');\n    this.rain = ctx.audio.loop('rain', { volume: 0.3 });\n    app.director?.play('title');\n    app.applyLook(1, 0.55, 0);\n    const has = app.save.next > 0;\n    const items = [];\n    items.push({ label: has ? 'ON CALL: CONTINUE' : 'ON CALL: NEW SHIFT', id: has ? 'continue' : 'new', detail: has ? this.nextName() : 'A NIGHT SHIFT AT VERITY GENERAL.' });\n    if (has) items.push({ label: 'NEW SHIFT', id: 'new', detail: 'START FROM THE BEGINNING.' });\n    const hasLog = Object.keys(app.save.cleared).length > 0;\n    items.push({ label: 'OPERATING LOG', id: 'log', disabled: !hasLog, detail: hasLog ? 'REPLAY WHAT YOU HAVE CLEARED.' : 'CLEAR AN OP FIRST.' });\n    items.push({ label: 'CONSULT', id: 'consult', detail: 'UP TO FOUR PAIRS OF HANDS ON ONE PATIENT.' });\n    items.push({ label: 'SETTINGS', id: 'settings', detail: 'SOUND, BUTTON GLYPHS, FEEL.' });\n    items.push({ label: 'ABOUT', id: 'about', detail: 'SOURCE, TESTING, CREDITS.' });\n    this.menu = new Menu(app, items, { x: 26, y: 96, rowH: 20, width: 180 });\n    this.difficulty = null;\n  }\n  nextName() { const e = CAMPAIGN[app.save.next]; if (!e) return ''; if (e.scene) return `NEXT: ${SCENES[e.scene].title}`; if (e.op) return `NEXT: ${OPS[e.op].title}`; return 'NEXT: CREDITS'; }\n  status() { return `main focus=${this.menu.focus}`; }\n  update(ctx, dt) {\n    app.devices.poll(ctx, dt);\n    this.t += dt;\n    this.set.update(dt);\n    app.director?.update(dt);\n    const a = this.t * 0.14;\n    setView(ctx, [WIDE[0][0] + Math.sin(a) * 1.4, WIDE[0][1] + 0.2, WIDE[0][2] + Math.cos(a) * 0.5], [WIDE[1][0] + 0.8, WIDE[1][1], WIDE[1][2]], 34);\n    const { hud } = ctx, W = hud.width, H = hud.height;\n    hud.clear();\n    if (this.sub) { this.sub.update(ctx, dt); this.sub?.draw(ctx); app.devices.idle = 0; return; }\n    if (this.difficulty) { this.updateDifficulty(ctx); return; }\n    if (app.devices.idle >= 10) { import('./flow.js').then(({ startAttract }) => startAttract()); }\n    const titleW = hud.measure(TITLE, 3).width;\n    hud.text(26, 32, TITLE, { scale: Math.min(3, Math.floor((W - 40) / (titleW / 3))), color: 0xf6f2e6, shadow: 0x5e1430 });\n    hud.text(26, 60, TAGLINE, { color: 0x8ad0ff });\n    const r = this.menu.update(ctx);\n    this.menu.draw(hud);\n    const det = this.menu.items[this.menu.focus]?.detail;\n    if (det) hud.text(26, H - 28, det, { color: 0x8a93a6 });\n    app.prompts.strip(hud, 26, H - 13, [['confirm', 'SELECT'], ['back', 'TITLE']]);\n    if (r === 'back') { go(new TitleStage()); return; }\n    if (!r) return;\n    switch (r.id) {\n      case 'new': this.difficulty = new Menu(app, Object.entries(DIFFICULTY).map(([k, v]) => ({ label: v.label, id: k, detail: v.about })), { x: 26, y: 96, rowH: 20, width: 180, focus: 1 }); break;\n      case 'continue': import('./flow.js').then(({ runCampaign }) => runCampaign(app.save.next)); break;\n      case 'log': import('./log.js').then(({ LogStage }) => go(new LogStage())); break;\n      case 'consult': import('./consult.js').then(({ ConsultStage }) => go(new ConsultStage())); break;\n      case 'settings': this.sub = new SettingsScreen(ctx, () => { this.sub = null; }); break;\n      case 'about': import('./about.js').then(({ AboutStage }) => go(new AboutStage())); break;\n      default: break;\n    }\n  }\n  updateDifficulty(ctx) {\n    const { hud } = ctx, H = hud.height;\n    hud.text(26, 62, 'PICK A DIFFICULTY', { color: 0xffd24d, scale: 2 });\n    const r = this.difficulty.update(ctx);\n    this.difficulty.draw(hud);\n    const det = this.difficulty.items[this.difficulty.focus]?.detail;\n    if (det) hud.text(26, H - 28, det, { color: 0x8a93a6 });\n    app.prompts.strip(hud, 26, H - 13, [['confirm', 'SELECT'], ['back', 'BACK']]);\n    if (r === 'back') { this.difficulty = null; return; }\n    if (r) {\n      const scoresKeep = app.save.cleared;\n      app.save.difficulty = r.id; app.save.next = 0; app.save.fails = {}; app.save.cleared = scoresKeep;\n      app.persist();\n      import('./flow.js').then(({ runCampaign }) => runCampaign(0));\n    }\n  }\n}\nEOF\ncat > src/stages/story.js <<'EOF'\n// Story scene: a set plus talking heads. Typewriter text with gibberish voice, the speaker leaning in, the other dimmed.\nimport { THREE } from '../../pixel-engine.js';\nimport { app } from '../core/app.js';\nimport { Stage, go, setView } from './stage.js';\nimport { SCENES } from '../content/scenes/index.js';\nimport { buildSet, buildFigure } from '../view/sets.js';\nimport { BustView } from '../view/bust.js';\nimport { CAST } from '../content/cast.js';\n\nconst CLOSE = [[0.2, 1.75, 5.1], [0, 1.42, 0]];\nexport class StoryStage extends Stage {\n  name = 'story';\n  constructor(opts) { super(); this.opts = opts; this.scene = SCENES[opts.scene]; this.i = -1; this.typed = 0; this.t = 0; this.hold = 0; this.busts = {}; this.figures = []; this.marks = []; this.camA = 0; }\n  async build(ctx) {\n    this.set = await buildSet(ctx, this.scene.set);\n    this.rain = this.set.def.rain ? ctx.audio.loop('rain', { volume: 0.6 }) : null;\n    app.director?.play(this.scene.music);\n    app.applyLook(1, 0.3, 0);\n    // Busts live on a stage of their own in front of the set.\n    this.front = new THREE.Group();\n    this.front.position.set(0, 0, 2);\n    ctx.scene.add(this.front);\n    for (const f of this.scene.figures ?? []) {\n      const fig = buildFigure(ctx, f[0], this.set.group, [f[1][0], 0, f[1][1]], Math.atan2(-f[1][0], 3 - f[1][1]), f[0] === 'ilya' ? { masked: false } : {});\n      fig.play(f[2]);\n      this.figures.push(fig);\n    }\n    const ids = new Set(this.scene.cast);\n    for (const b of this.scene.beats) { if (b.who && CAST[b.who]) ids.add(b.who); if (b.swap) ids.add(b.swap); }\n    for (const id of ids) { const v = new BustView(ctx, id, { parent: this.front }); v.root.visible = false; this.busts[id] = v; }\n    this.left = this.scene.cast[0]; this.right = this.scene.cast[1];\n    this.next(ctx);\n  }\n  status() { return `story ${this.scene.id} beat=${this.i}/${this.scene.beats.length}`; }\n  next(ctx) {\n    this.i++;\n    if (this.i >= this.scene.beats.length) { this.finish(); return; }\n    const b = this.scene.beats[this.i];\n    this.typed = 0; this.hold = 0;\n    if (b.swap && b.swap !== this.right && b.swap !== this.left) this.left = b.swap;\n    if (b.cue) ctx.audio.play(b.cue);\n    this.camMode = b.cam === 'wide' ? 'wide' : 'close';\n    this.camA = 0;\n  }\n  finish() { if (this.done) return; this.done = true; this.opts.onDone?.(); }\n  update(ctx, dt) {\n    if (this.done) return;\n    const devs = app.devices;\n    devs.poll(ctx, dt);\n    this.t += dt;\n    this.set.update(dt);\n    app.director?.update(dt);\n    for (const f of this.figures) f.update(dt);\n    const beat = this.scene.beats[this.i];\n    if (!beat) return;\n    const plain = beat.say.replace(/\\*/g, '');\n    const cast = CAST[beat.who];\n    const speed = 34 * (app.settings.textSpeed ?? 1) * (cast?.voice?.speed ?? 1);\n    const prev = Math.floor(this.typed);\n    this.typed = Math.min(plain.length, this.typed + dt * speed);\n    const now = Math.floor(this.typed);\n    const bust = this.busts[beat.who];\n    for (let k = prev; k < now; k++) {\n      const end = plain.slice(k).search(/[.!?]/);\n      if (app.voice.letter(ctx.audio, plain[k], beat.who, cast, k, end >= 0 ? plain[k + end] : '')) bust?.talk(1);\n    }\n    // Who's on stage.\n    const speakerSide = beat.who === this.right ? 'right' : beat.who === this.left ? 'left' : 'left';\n    if (beat.who !== this.left && beat.who !== this.right) this.left = beat.who;\n    const wide = this.camMode === 'wide';\n    for (const [id, v] of Object.entries(this.busts)) {\n      const side = id === this.left ? -1 : id === this.right ? 1 : 0;\n      v.root.visible = !!side && !wide;\n      if (!side) continue;\n      const on = id === beat.who;\n      v.leanTarget = on ? 1 : 0;\n      const tx = side * (on ? 0.95 : 1.25), ty = on ? -0.1 : -0.36, tz = on ? 0.35 : -0.6;\n      const r = v.root.position, k = Math.min(1, dt * 8);\n      r.x += (tx - r.x) * k; r.y += (ty - r.y) * k; r.z += (tz - r.z) * k;\n      v.root.rotation.y = -side * 0.22;\n      if (on) { v.setEmotion !== undefined; if (v.emotion !== beat.emo) v.setEmotion(beat.emo); } else if (beat.other && v.emotion !== beat.other) v.setEmotion(beat.other);\n      v.update(dt);\n      v.look = side * -0.06;\n    }\n    // Camera\n    this.camA = Math.min(1, this.camA + dt * 1.5);\n    if (wide) { const W = this.set.def.wide, f = 1 - this.camA * 0.08; setView(ctx, [W.pos[0] * f + Math.sin(this.t * 0.2) * 0.12, W.pos[1], W.pos[2] * f], W.target, 34); } else { const off = speakerSide === 'right' ? 0.12 : -0.12; setView(ctx, [CLOSE[0][0] + off + Math.sin(this.t * 0.4) * 0.02, CLOSE[0][1] + 0.02 * Math.sin(this.t * 0.6), CLOSE[0][2] + 2.4], [off, CLOSE[1][1], 2], 30); }\n    // Text box\n    const { hud } = ctx, W = hud.width, H = hud.height;\n    hud.clear();\n    const boxH = 54, y = H - boxH;\n    hud.rect(0, y - 1, W, boxH + 1, 0x0d0b14);\n    hud.rect(0, y - 1, W, 1, cast?.color ?? 0xffffff);\n    hud.text(10, y + 5, cast?.name ?? '', { color: cast?.color ?? 0xffffff });\n    app.prompts.draw(hud, 10, y + 16, beat.say, { width: W - 20, limit: now, lineH: 11 });\n    hud.text(10, 8, this.scene.title, { color: 0x8a93a6 });\n    hud.text(W - hud.measure(this.set.def.label).width - 10, 8, this.set.def.label, { color: 0x5a6172 });\n    const complete = this.typed >= plain.length;\n    if (complete && Math.floor(this.t * 3) % 2) hud.rect(W - 14, H - 12, 6, 6, 0xffd24d);\n    app.prompts.strip(hud, 10, H - 11, [['confirm', 'NEXT'], ['skipScene', 'HOLD: SKIP']]);\n    // comic marks\n    if (!wide && (beat.emo === 'shock' || beat.emo === 'panic') && this.typed < 12) {\n      const sx = beat.who === this.right ? W * 0.72 : W * 0.28, sy = H * 0.22;\n      for (let i = 0; i < 7; i++) { const a = (i / 7) * Math.PI * 2 + 0.3, R = 26 + (i % 2) * 6; hud.rect(Math.round(sx + Math.cos(a) * R), Math.round(sy + Math.sin(a) * R), 2, 2, 0xffffff); hud.rect(Math.round(sx + Math.cos(a) * (R + 5)), Math.round(sy + Math.sin(a) * (R + 5)), 2, 2, 0xffffff); }\n    }\n    // Input: advance or skip\n    const n = devs.nav, click = input => input.wasPressed('MouseLeft');\n    const pad = devs.pads.find(Boolean);\n    const skipHeld = ctx.input.isDown('Escape') || (pad && pad.buttons[3] > 0.5);\n    this.skipT = skipHeld ? (this.skipT ?? 0) + dt : 0;\n    if (this.skipT > 0) { hud.rect(10, H - 3, Math.round((W - 20) * Math.min(1, this.skipT / 0.8)), 2, 0xffd24d); }\n    if (this.skipT >= 0.8) { this.finish(); return; }\n    if (n.confirm || click(ctx.input) || (pad && pad.buttons[0] > 0.5 && !(pad.prev[0] > 0.5) && false)) {\n      if (!complete) this.typed = plain.length;\n      else { ctx.audio.play('uiMove'); this.next(ctx); }\n    }\n    void go;\n  }\n}\nEOF\ncat > src/stages/briefing.js <<'EOF'\n// Briefing: a clipboard chart. Patient, age, job, hook, op title stamped, one-line objective.\nimport { app } from '../core/app.js';\nimport { Stage, setView } from './stage.js';\nimport { OPS } from '../content/ops/index.js';\nimport { buildSet } from '../view/sets.js';\n\nexport class BriefingStage extends Stage {\n  name = 'briefing';\n  constructor(opts) { super(); this.opts = opts; this.def = OPS[opts.op]; this.t = 0; }\n  async build(ctx) { this.set = await buildSet(ctx, 'or7'); app.applyLook(1, 0.4, 0); app.director?.play(this.def.n >= 5 ? 'or-tense' : 'or-calm'); ctx.audio.play('stamp'); }\n  status() { return `briefing ${this.def.id}`; }\n  update(ctx, dt) {\n    app.devices.poll(ctx, dt);\n    this.t += dt;\n    this.set.update(dt);\n    app.director?.update(dt);\n    setView(ctx, [2.6 - this.t * 0.04, 3.1, 4.8], [0, 1, 0], 34);\n    const { hud } = ctx, W = hud.width, H = hud.height, P = this.def.patient;\n    hud.clear();\n    const cw = Math.min(330, W - 30), ch = Math.min(216, H - 30), x = Math.round(W / 2 - cw / 2), drop = Math.max(0, 1 - this.t * 4), y = Math.round((H - ch) / 2 - drop * 240);\n    hud.rect(x, y, cw, ch, 0x7a5430);\n    hud.rect(x + 6, y + 6, cw - 12, ch - 12, 0xf1ead4);\n    hud.rect(x + cw / 2 - 26, y - 4, 52, 12, 0x8a93a6);\n    hud.rect(x + cw / 2 - 18, y - 7, 36, 5, 0xc8d0da);\n    const ink = 0x20202a, tx = x + 16, tw = cw - 32;\n    hud.text(tx, y + 18, 'VERITY GENERAL  /  OR-7', { color: 0x6a6a72, shadow: false });\n    hud.text(tx, y + 32, P.name, { color: ink, scale: 2, shadow: false });\n    hud.text(tx, y + 54, `${P.age ? `AGE ${P.age}   ` : ''}${P.job}`, { color: 0x45454f, shadow: false });\n    hud.rect(tx, y + 66, tw, 1, 0xa8a090);\n    app.prompts.draw(hud, tx, y + 74, P.hook, { width: tw, color: 0x7a1020, lineH: 11 });\n    hud.text(tx, y + 104, 'OBJECTIVE', { color: 0x6a6a72, shadow: false });\n    app.prompts.draw(hud, tx, y + 116, P.objective, { width: tw, color: ink, lineH: 11 });\n    // stamped op title\n    const stampIn = Math.min(1, Math.max(0, (this.t - 0.4) * 6));\n    if (stampIn > 0) {\n      const label = this.def.title, tw2 = hud.measure(label, 2).width;\n      const sx = x + cw - tw2 - 22, sy = y + ch - 44;\n      hud.rect(sx - 5, sy - 5, tw2 + 10, 25, 0x9a1020);\n      hud.rect(sx - 3, sy - 3, tw2 + 6, 21, 0xf1ead4);\n      hud.text(sx, sy, label, { color: 0x9a1020, scale: 2, shadow: false });\n      if (!this.stamped) { this.stamped = true; ctx.audio.play('stamp'); app.shake(0.3); }\n    }\n    hud.text(tx, y + ch - 28, this.def.surgeon === 'sabine' ? 'SURGEON: DR. ACHTERBERG' : 'SURGEON: DR. MARSH', { color: 0x45454f, shadow: false });\n    app.prompts.strip(hud, 10, H - 13, [['confirm', 'SCRUB IN']]);\n    if (this.t > 0.5 && (app.devices.nav.confirm || app.devices.click(ctx.input))) { if (!this.left) { this.left = true; ctx.audio.play('uiConfirm'); this.opts.onGo(); } }\n  }\n}\nEOF\ncat > src/stages/results.js <<'EOF'\n// Results: the chart drops in, lines tally with ticks, the rank stamp slams, Reyes comments, then the patient's follow-up.\nimport { app } from '../core/app.js';\nimport { Stage, setView } from './stage.js';\nimport { OPS } from '../content/ops/index.js';\nimport { buildSet } from '../view/sets.js';\n\nconst COMMENT = {\n  S: ['...Adequate.', \"Don't get used to the feeling.\", 'I have seen worse. From better.'],\n  A: ['That will do. Barely.', 'Your hands are improving. Your face is not.'],\n  B: ['He will keep it. Do better.', \"It'll hold. Probably.\"],\n  C: [\"He'll keep the arm. Do better.\", 'I have seen tidier work from a raccoon.'],\n};\nexport class ResultsStage extends Stage {\n  name = 'results';\n  constructor(opts) { super(); this.opts = opts; this.def = OPS[opts.op]; this.t = 0; this.line = -1; }\n  async build(ctx) { this.set = await buildSet(ctx, 'or7'); app.applyLook(1, 0.4, 0); app.director?.play('results'); this.rows = this.buildRows(); }\n  buildRows() {\n    const r = this.opts.res;\n    return [['TECHNIQUE', r.technique], ['TIME', r.timeBonus], ['VITALS', r.vitalBonus], ['BEST STREAK', r.bestStreak], ['MISTAKES', r.mistakes], ...(r.looks ? [['SECOND LOOKS', `-${r.looks * 5}%`]] : []), ['TOTAL', r.total]];\n  }\n  status() { return `results ${this.def.id} rank=${this.opts.res.rank}`; }\n  update(ctx, dt) {\n    app.devices.poll(ctx, dt);\n    this.t += dt;\n    this.set.update(dt);\n    app.director?.update(dt);\n    setView(ctx, [2.6, 3.1, 4.8], [0, 1, 0], 34);\n    const { hud } = ctx, W = hud.width, H = hud.height, R = this.opts.res;\n    hud.clear();\n    const cw = Math.min(340, W - 20), ch = Math.min(232, H - 20), x = Math.round(W / 2 - cw / 2), drop = Math.max(0, 1 - this.t * 4), y = Math.round((H - ch) / 2 - drop * 260);\n    hud.rect(x, y, cw, ch, 0x7a5430); hud.rect(x + 5, y + 5, cw - 10, ch - 10, 0xf1ead4);\n    const ink = 0x20202a, tx = x + 14;\n    hud.text(tx, y + 12, this.def.title, { color: ink, scale: 2, shadow: false });\n    hud.text(tx, y + 32, this.def.patient.name, { color: 0x6a6a72, shadow: false });\n    const nShown = Math.min(this.rows.length, Math.floor((this.t - 0.4) / 0.28));\n    if (nShown > this.line) { this.line = nShown; if (nShown > 0) { ctx.audio.play('tick'); ctx.audio.play('uiMove'); } }\n    for (let i = 0; i < nShown; i++) {\n      const [label, val] = this.rows[i], ry = y + 46 + i * 12, last = label === 'TOTAL';\n      hud.text(tx, ry, label, { color: last ? ink : 0x45454f, shadow: false });\n      const v = String(val);\n      hud.text(tx + 150 - hud.measure(v).width, ry, v, { color: ink, shadow: false });\n    }\n    const stampT = 0.4 + this.rows.length * 0.28 + 0.3;\n    if (this.t > stampT) {\n      if (!this.slammed) { this.slammed = true; ctx.audio.play('stamp'); app.shake(0.6); app.rumble(0.8, 0.6, 180); }\n      const k = Math.max(1, 3 - (this.t - stampT) * 12), big = Math.round(6 * k) ;\n      const sc = Math.min(8, big), lw = hud.measure(R.rank, sc).width;\n      const col = R.rank === 'S' ? 0xc08a10 : R.rank === 'A' ? 0x2b7a40 : R.rank === 'B' ? 0x2b5a9a : 0x9a1020;\n      const sx = x + cw - 70 - lw / 2, sy = y + 72 - (7 * sc) / 2;\n      hud.rect(sx - 8, sy - 8, lw + 16, 7 * sc + 16, col);\n      hud.rect(sx - 5, sy - 5, lw + 10, 7 * sc + 10, 0xf1ead4);\n      hud.text(Math.round(sx), Math.round(sy), R.rank, { color: col, scale: sc, shadow: false });\n      if (R.pristine) { const t = 'PRISTINE', w = hud.measure(t).width; hud.rect(x + cw - 70 - w / 2 - 3, y + 118, w + 6, 11, 0xc08a10); hud.text(x + cw - 70 - w / 2, y + 120, t, { color: 0xffffff, shadow: false }); }\n    }\n    if (this.t > stampT + 0.6) {\n      const list = COMMENT[R.rank]; const line = list[(this.def.n ?? 0) % list.length];\n      hud.text(tx, y + ch - 62, 'NURSE REYES', { color: 0x9a1020, shadow: false });\n      app.prompts.draw(hud, tx, y + ch - 52, line, { width: cw - 30, color: ink });\n    }\n    if (this.t > stampT + 1.2) {\n      hud.text(tx, y + ch - 36, 'AFTERWARD', { color: 0x6a6a72, shadow: false });\n      app.prompts.draw(hud, tx, y + ch - 26, this.def.patient.followUp[R.rank] ?? this.def.patient.followUp.C, { width: cw - 30, color: 0x45454f });\n    }\n    app.prompts.strip(hud, 10, H - 13, [['confirm', 'NEXT']]);\n    const go2 = app.devices.nav.confirm || app.devices.click(ctx.input);\n    if (go2) { if (this.t < stampT + 1.2) this.t = stampT + 1.3; else if (!this.left) { this.left = true; ctx.audio.play('uiConfirm'); this.opts.onDone(); } }\n  }\n}\nEOF\ncat > src/stages/log.js <<'EOF'\n// Operating Log: one chart at a time, flip with left/right. Best rank and a patient line.\nimport { app } from '../core/app.js';\nimport { Stage, go, setView } from './stage.js';\nimport { OPS, CAMPAIGN_OPS } from '../content/ops/index.js';\nimport { buildSet } from '../view/sets.js';\n\nexport class LogStage extends Stage {\n  name = 'log';\n  i = 0; t = 0;\n  async build(ctx) { this.set = await buildSet(ctx, 'ward'); app.applyLook(1, 0.4, 0); app.director?.play('ward'); this.list = CAMPAIGN_OPS.filter((id) => app.save.cleared[id]); if (!this.list.length) this.list = []; }\n  status() { return `log ${this.i}`; }\n  update(ctx, dt) {\n    app.devices.poll(ctx, dt);\n    this.t += dt;\n    this.set.update(dt); app.director?.update(dt);\n    setView(ctx, [3.8, 2.4, 6.4], [0, 1, 0], 34);\n    const { hud } = ctx, W = hud.width, H = hud.height, n = app.devices.nav;\n    hud.clear();\n    if (n.back || app.devices.rightClick(ctx.input)) { ctx.audio.play('uiBack'); import('./flow.js').then(({ backToMain }) => backToMain()); return; }\n    if (!this.list.length) { hud.text(20, 40, 'NOTHING CLEARED YET.', { color: 0xffffff }); return; }\n    if (n.left) { this.i = (this.i - 1 + this.list.length) % this.list.length; ctx.audio.play('uiMove'); this.t = 0; }\n    if (n.right) { this.i = (this.i + 1) % this.list.length; ctx.audio.play('uiMove'); this.t = 0; }\n    const def = OPS[this.list[this.i]], P = def.patient, rank = app.save.ranks[def.id] ?? 'C';\n    const cw = Math.min(330, W - 40), ch = Math.min(200, H - 40), x = Math.round(W / 2 - cw / 2), y = Math.round((H - ch) / 2 - Math.max(0, 1 - this.t * 6) * 40);\n    hud.rect(x, y, cw, ch, 0x7a5430); hud.rect(x + 5, y + 5, cw - 10, ch - 10, 0xf1ead4);\n    const ink = 0x20202a, tx = x + 16;\n    hud.text(tx, y + 14, `OP ${def.n}`, { color: 0x6a6a72, shadow: false });\n    hud.text(tx, y + 26, def.title, { color: ink, scale: 2, shadow: false });\n    hud.text(tx, y + 48, P.name, { color: 0x45454f, shadow: false });\n    app.prompts.draw(hud, tx, y + 62, P.followUp[rank] ?? '', { width: cw - 90, color: ink });\n    hud.text(tx, y + 110, `BEST ${app.save.scores[def.id] ?? 0}`, { color: 0x45454f, shadow: false });\n    const col = rank === 'S' ? 0xc08a10 : rank === 'A' ? 0x2b7a40 : rank === 'B' ? 0x2b5a9a : 0x9a1020;\n    hud.text(x + cw - 54, y + 18, rank, { color: col, scale: 5, shadow: false });\n    if (app.save.pristine?.[def.id]) hud.text(x + cw - 66, y + 62, 'PRISTINE', { color: 0xc08a10, shadow: false });\n    hud.text(tx, y + ch - 22, `${this.i + 1} / ${this.list.length}`, { color: 0x6a6a72, shadow: false });\n    // arrows clickable\n    hud.text(x - 14, Math.round(y + ch / 2), '<', { color: 0xffd24d, scale: 2 }); hud.text(x + cw + 3, Math.round(y + ch / 2), '>', { color: 0xffd24d, scale: 2 });\n    app.prompts.strip(hud, 10, H - 13, [['confirm', 'OPERATE'], ['back', 'BACK']]);\n    const c = app.devices.click(ctx.input);\n    if (c && c.x < x) { this.i = (this.i - 1 + this.list.length) % this.list.length; this.t = 0; }\n    else if (c && c.x > x + cw) { this.i = (this.i + 1) % this.list.length; this.t = 0; }\n    else if (n.confirm || c) import('./flow.js').then(({ replayOp }) => replayOp(def.id));\n    void go;\n  }\n}\nEOF\necho ok","description":"Write fx, settings, dev, pause, fail, flow and screens"}}}
