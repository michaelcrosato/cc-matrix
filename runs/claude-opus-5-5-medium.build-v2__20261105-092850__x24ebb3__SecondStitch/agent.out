{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkNvP2W2HVSEh5gqpjY8","type":"message","role":"assistant","content":[{"type":"text","text":"All of this is checkable, so I'll check it rather than argue about it:\n- **Testable logic:** move the drift correction and the live-slider logic into pure functions, so Node can test them.\n- **Behaviour tests:** add tests for Aim Assist, Co-op Scale, Strain HP, gloves and tip icons.\n- **The hub crash:** kill my own browser's renderer mid-run, by PID, to see whether a dead page produces that exact error signature.\n\nOn the §9 numbers, the plan itself says \"Keep to these numbers unless you can beat them\". I'll add a test that the hand really grips the tool, so that change rests on more than my opinion."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":1846,"cache_read_input_tokens":609258,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1846},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9464247a-cdba-4289-905c-cd8b34e5d270","uuid":"89b0b7fa-5153-480b-9d6b-8878a9ffba52","timestamp":"2026-11-05T20:03:07.791Z","request_id":"req_011CgkNvNhAQSbpYT3R9CEcS"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkNvP2W2HVSEh5gqpjY8","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01TVRjdGHtZkbAFbWcutjEVP","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-092850__x24ebb3/work/SecondStitch-*/ && npm install playwright@1.63.0 --silent 2>&1 | tail -1; python3 - <<'E'\np='src/input/cursor.js'; s=open(p).read()\ns+=\"\"\"\n/** A network client's own tip: it moves at once, and eases toward the host's only once it has drifted over a unit. */\nexport function correctDrift(tip, serverX, serverZ) {\n  if (serverX == null || Math.hypot(serverX - tip.x, serverZ - tip.z) <= 1) return false;\n  tip.x += (serverX - tip.x) * 0.04;\n  tip.z += (serverZ - tip.z) * 0.04;\n  return true;\n}\n\"\"\"\nopen(p,'w').write(s)\np='src/net/session.js'; s=open(p).read()\nold=\"if (seat.serverX != null && Math.hypot(seat.serverX - i.x, seat.serverZ - i.z) > 1) { const tip = stage.tips[this.mySeat]; tip.x += (seat.serverX - tip.x) * 0.04; tip.z += (seat.serverZ - tip.z) * 0.04; }\"\nassert old in s\ns=s.replace(old,\"correctDrift(stage.tips[this.mySeat], seat.serverX, seat.serverZ);\")\ns=s.replace(\"import { app } from '../core/app.js';\",\"import { app } from '../core/app.js';\\nimport { correctDrift } from '../input/cursor.js';\",1)\nopen(p,'w').write(s)\np='src/sim/op.js'; s=open(p).read()\ns=s.replace(\"/** Dev Mode actions. */\",\"\"\"/** A balance value changed while an op runs: including the ones an op otherwise reads only when it starts. */\nexport function applyLiveConfig(sim, k, v, before) {\n  sim.cfg[k] = v;\n  if (k === 'timeLimit' && before > 0) { sim.clock *= v / before; sim.clockMax *= v / before; }\n  if (k === 'coopScale') sim.coop = 1 + v * (sim.seats.length - 1);\n  if (k === 'irae' && sim.heart) sim.heart.bpm = Math.max(40, sim.heart.bpm + (v - before));\n  if (k === 'strainHp' && before > 0) for (const e of sim.ents) {\n    if (e.k === 'strain' && e.hp != null) e.hp = Math.max(1, Math.round(e.hp * (v / before)));\n    if (e.k === 'eye' && e.eyeHp != null) e.eyeHp = Math.max(1, Math.round(e.eyeHp * (v / before)));\n  }\n}\n\n/** Dev Mode actions. */\"\"\")\nopen(p,'w').write(s)\np='src/ui/dev.js'; s=open(p).read()\na=s.index(\"  /** Live, on the running op too\"); b=s.index(\"  balance() {\")\ns=s[:a]+\"\"\"  /** Live, on the running op too. */\n  setCfg(k, v) {\n    const before = config[k], sim = this.stage.sim;\n    config[k] = v;\n    if (sim) applyLiveConfig(sim, k, v, before);\n  }\n\"\"\"+s[b:]\ns=s.replace(\"import { dev } from '../sim/op.js';\",\"import { applyLiveConfig, dev } from '../sim/op.js';\")\nopen(p,'w').write(s)\np='src/view/hands.js'; s=open(p).read()\ns=s.replace(\"    this.current = null;\\n    this.side =\",\"    this.gloveSlot = g[0];\\n    this.current = null;\\n    this.side =\")\nopen(p,'w').write(s)\np='tests/sim.test.mjs'; s=open(p).read()\ns=s.replace(\"  /* Awards stay inside\",\"\"\"  /* Every Dev Mode slider does something to a running op */\n  { const run = (mut, seats = 1, frames = 600, def = OPS.op1) => { const c = { ...defaults }; const s = createOp(def, { seats, cfg: c, seed: 2 }); mut?.(s); for (let i = 0; i < frames && s.phase === 'play'; i++) { step(s, []); drainEvents(s); } return s; };\n    const v0 = run(null, 2).tables[0].vitals, v1 = run((s) => applyLiveConfig(s, 'coopScale', 1, 0.25), 2).tables[0].vitals;\n    ok('slider coop scale: more seats drain faster, live', v1 < v0 - 0.01, `${v0} ${v1}`);\n    const lone = createOp(OPS.op1, { seats: 1, cfg: { ...defaults } }); applyLiveConfig(lone, 'coopScale', 1, 0.25);\n    ok('slider coop scale: alone it changes nothing', lone.coop === 1);\n    const t = createOp(OPS.op1, { cfg: { ...defaults } }), c0 = t.clock; applyLiveConfig(t, 'timeLimit', 2, 1);\n    ok('slider time limit: scales the running clock', Math.abs(t.clock - c0 * 2) < 1e-6);\n    const boss = createOp(OPS.op5, { stage: 1, cfg: { ...defaults }, seed: 2 }); for (let i = 0; i < 5; i++) step(boss, []);\n    const st = boss.ents.find((e) => e.k === 'strain'), hp0 = st.hp; applyLiveConfig(boss, 'strainHp', 2, 1);\n    ok('slider strain HP: a running Introit has more HP', st.hp === hp0 * 2 && boss.cfg.strainHp === 2, `${hp0} ${st.hp}`);\n    const weep = createOp(OPS.op7, { stage: 1, cfg: { ...defaults }, seed: 2 }); for (let i = 0; i < 5; i++) step(weep, []);\n    const eye = weep.ents.find((e) => e.k === 'eye'), e0 = eye.eyeHp; applyLiveConfig(weep, 'strainHp', 2, 1);\n    ok('slider strain HP: running eyes too', eye.eyeHp === e0 * 2, `${e0} ${eye.eyeHp}`);\n    const h = createOp(OPS.op8, { stage: 1, cfg: { ...defaults }, seed: 2 }); for (let i = 0; i < 5; i++) step(h, []); const b0 = h.heart.bpm; applyLiveConfig(h, 'irae', 92, 72);\n    ok('slider base BPM: moves the running heart', h.heart.bpm === b0 + 20);\n    // Aim assist: the same stick push moves less near a target, and more damped along a stroke.\n    const tipA = { x: 0, z: 0 }, tipB = { x: 0, z: 0 }, tipC = { x: 0, z: 0 };\n    integrateTip(tipA, 1, 0, { speed: 10, steadyFactor: 0.4, assist: 0, near: true });\n    integrateTip(tipB, 1, 0, { speed: 10, steadyFactor: 0.4, assist: 0.4, near: true });\n    integrateTip(tipC, 1, 0, { speed: 10, steadyFactor: 0.4, assist: 0.4, near: false });\n    ok('slider aim assist: 60% speed near a target at Low, none at 0', Math.abs(tipB.x / tipA.x - 0.6) < 1e-6 && tipC.x === tipA.x, `${tipA.x} ${tipB.x} ${tipC.x}`);\n    const sA = { x: 0, z: 0 }, sB = { x: 0, z: 0 };\n    integrateTip(sA, 0, 1, { speed: 10, steadyFactor: 0.4, assist: 0, stroke: [1, 0] });\n    integrateTip(sB, 0, 1, { speed: 10, steadyFactor: 0.4, assist: 0.4, stroke: [1, 0] });\n    ok('slider aim assist: perpendicular drift damped 50% on a stroke', Math.abs(sB.z / sA.z - 0.5) < 1e-6, `${sA.z} ${sB.z}`);\n    // Each remaining slider, by what it changes.\n    const mutFx = (k, v, check) => { const a = { ...defaults, [k]: v }; return check(a); };\n    ok('slider drain rate', mutFx('drainRate', 3, (c) => { const s = createOp(OPS.op1, { stage: 1, cfg: c }); step(s, [{ x: -3, z: 0.5, tool: 'drain', use: 1 }]); const e = s.ents.find((q) => q.sid === 'p1'); return e.r < 1.5 - 2.9 / 60; }));\n    ok('slider mistake cost', mutFx('mistakePenalty', 20, (c) => { const s = createOp(OPS.op1, { cfg: c }); const v = s.tables[0].vitals; mistake(s, s.seats[0], 'x', 0, 0); return v - s.tables[0].vitals === 20; }));\n    ok('slider max mistakes: 0 means unlimited', mutFx('maxMistakes', 0, (c) => { const s = createOp(OPS.op1, { cfg: c }); for (let i = 0; i < 9; i++) mistake(s, s.seats[0], 'x', 0, 0); return s.phase === 'play'; }));\n    ok('slider vitals drain', run((s) => applyLiveConfig(s, 'vitalsDrain', 3, 1)).tables[0].vitals < run().tables[0].vitals);\n    ok('slider bleed drain', (() => { const mk = (b) => { const s = createOp(OPS.op1, { stage: 1, cfg: { ...defaults, bleedDrain: b } }); for (let i = 0; i < 120; i++) step(s, []); return s.tables[0].vitals; }; return mk(1) < mk(0); })());\n    ok('slider composure gain', mutFx('composureGain', 20, (c) => { const s = createOp(OPS.op5, { cfg: c }), v = s.composure; rate(s, s.seats[0], 'CLEAN', 0, 0); return s.composure === v + 20; }));\n    ok('slider quiet slow', mutFx('quietSlow', 0.5, (c) => { const s = createOp(OPS.op5, { cfg: c, stage: 1 }); s.composure = 100; const k = s.clock; for (let i = 0; i < 60; i++) step(s, [{ gift: true }]); return Math.abs(k - s.clock - 0.5) < 0.03; }));\n    ok('slider quiet drain', mutFx('quietDrain', 40, (c) => { const s = createOp(OPS.op5, { cfg: c, stage: 1 }); s.composure = 100; for (let i = 0; i < 60; i++) step(s, [{ gift: true }]); return Math.abs(s.composure - 60) < 1; }));\n    ok('slider syringe dose', mutFx('syringeDose', 30, (c) => { const s = createOp(OPS.op1, { cfg: c }); s.tables[0].vitals = 40; const p = s.port; for (let i = 0; i < 30; i++) step(s, [{ x: p[0], z: p[1], tool: 'syringe', use: 1 }]); step(s, [{ x: p[0], z: p[1], tool: 'syringe', use: 0 }]); return s.tables[0].vitals > 69; }));\n    ok('slider laser time', mutFx('laserTime', 2, (c) => { const s = createOp({ ...OPS.op2, id: 'lz', stages: [{ id: 'a', spawn: [{ k: 'polyp', at: [0, 0] }], until: { clear: ['polyp'] } }, { id: 'b', until: { time: 99 } }] }, { cfg: c }); for (let i = 0; i < 60; i++) step(s, [{ x: 0, z: 0, tool: 'laser', use: 1 }]); return s.ents.some((e) => e.k === 'polyp'); }));\n    ok('slider tool tolerance', mutFx('toolTolerance', 3, (c) => { const s = createOp({ ...OPS.op2, id: 'tl', stages: [{ id: 'a', spawn: [{ k: 'hook', at: [0, 0], dir: [0, -1], pull: 1 }], until: { clear: ['hook'] } }] }, { cfg: c }); step(s, [{ x: 1, z: 0, tool: 'forceps', use: 1 }]); return s.seats[0].grab != null; }));\n    ok('slider look cost and seconds', mutFx('lookCost', 10, (c) => { const s = createOp(OPS.op6, { cfg: { ...c, lookSeconds: 1 }, seed: 1 }); s.composure = 15; for (let i = 0; i < 90; i++) step(s, [{}]); const clk = s.clock; step(s, [{ gift: true }]); return s.looks === 1 && Math.abs(s.clock - clk - 1) < 0.15; }));\n    ok('slider strain speed', (() => { const go = (sp) => { const s = createOp(OPS.op5, { stage: 1, seed: 2, cfg: { ...defaults, strainSpeed: sp } }); for (let i = 0; i < 120; i++) step(s, []); return s.ents.find((e) => e.k === 'strain').s; }; return go(2) > go(1) * 1.5; })());\n    ok('slider code blue zone', mutFx('codeBlueZone', 0.5, (c) => { const s = createOp(OPS.op1, { cfg: c }); dev.codeBlue(s); return s.codeBlue.zone === 0.5; }));\n    ok('slider cursor speed and steady factor', (() => { const a = { x: 0, z: 0 }, b = { x: 0, z: 0 }; integrateTip(a, 1, 0, { speed: 20, steadyFactor: 0.4 }); integrateTip(b, 1, 0, { speed: 10, steady: true, steadyFactor: 0.5 }); return a.x === (20 / 60) && Math.abs(b.x - 5 / 60) < 1e-9; })());\n  }\n  /* A client's tip: moves at once, eases only past a unit of drift */\n  { const near = { x: 0, z: 0 }, far = { x: 0, z: 0 };\n    ok('drift: under a unit, left alone', correctDrift(near, 0.9, 0) === false && near.x === 0);\n    ok('drift: over a unit, eases toward the host', correctDrift(far, 1.5, 0) === true && far.x > 0 && far.x < 0.2, String(far.x));\n    ok('drift: no host position yet, left alone', correctDrift({ x: 0, z: 0 }, null, null) === false); }\n  /* Awards stay inside\"\"\")\ns=s.replace(\"import { createOp, step, drainEvents, hashSim, cloneState, dev, defOf } from '../src/sim/op.js';\",\"import { applyLiveConfig, createOp, step, drainEvents, hashSim, cloneState, dev, defOf, mistake } from '../src/sim/op.js';\\nimport { correctDrift, integrateTip } from '../src/input/cursor.js';\")\ns=s.replace(\"import { awardsFor, results, rankOf, capRank } from '../src/sim/scoring.js';\",\"import { awardsFor, rate, results, rankOf, capRank } from '../src/sim/scoring.js';\")\nopen(p,'w').write(s)\np='tests/browser/run.mjs'; s=open(p).read()\ns=s.replace(\"\"\"      ok('couch: the second seat has its own wheel',\"\"\",\"\"\"      const look = await page.evaluate(() => {\n        const st = window.__GAME__.stage, hud = window.__PIXEL_ENGINE__.hud, orig = hud.sprite; let icons = 0;\n        hud.sprite = function (x, y, rows, ...r) { if (rows.length === 11 && rows[0].length === 12) icons++; return orig.call(this, x, y, rows, ...r); };\n        st.drawHud(window.__GAME__.app.ctx, st.sim, 0, st.sim.seats[0]);\n        hud.sprite = orig;\n        return { slots: st.hands.map((h) => h.gloveSlot), icons };\n      });\n      ok('couch: gloves take the seat colour', look.slots[0] === 'red' && look.slots[1] === 'blue', look.slots.join());\n      ok('couch: a tool icon by each tip, plus each seat wheel', look.icons >= 4, String(look.icons));\n      ok('couch: the second seat has its own wheel',\"\"\")\ns=s.replace(\"    /* retry from a failed op */\",\"\"\"    /* The hand holds the tool: the palm is on the handle at every corner of the field, for every seat. */\n    { const { page, errors, ctx } = await open(b, '?op=op1&stage=2');\n      await wait(page, () => window.__GAME__?.stage?.intro <= 0);\n      const r = await page.evaluate(() => { const st = window.__GAME__.stage, h = st.hands[0], out = []; const THREE_V = h.hand.position.clone(); void THREE_V;\n        for (const [x, z] of [[-5, -3], [5, -3], [-5, 2.5], [5, 2.5], [0, 0]]) { const seat = { ...st.sim.seats[0], x, z, table: 0, tool: 'forceps', useHeld: false, grab: null, drawing: 0 }; h.update(seat, 0.5, st.sim); const tool = h.tools.forceps; const grip = tool.localToWorld(tool.position.clone().set(0, 0.1, 1.5)); out.push(+Math.hypot(grip.x - h.hand.position.x, grip.y - h.hand.position.y, grip.z - h.hand.position.z).toFixed(2)); }\n        return out; });\n      ok('hand: the palm stays on the handle', r.every((d) => d < 0.6), r.join());\n      ok('no errors: hand', !errors.length, errors.join());\n      await ctx.close(); }\n    /* retry from a failed op */\"\"\")\nopen(p,'w').write(s)\nE\nnode tools/build.mjs && cmp dist/game.html ../$(basename $PWD).html && echo testing-the-deliverable; timeout 200 node tests/run.mjs sim 2>&1 | tail -12 | cut -c1-260; timeout 100 node tests/run.mjs headless 2>&1 | tail -2 | cut -c1-200; timeout 200 node tests/run.mjs content 2>&1 | tail -2 | cut -c1-200","description":"Make drift and sliders testable, add behaviour tests, run node suites","timeout":560000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":1846,"cache_read_input_tokens":609258,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1846},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9464247a-cdba-4289-905c-cd8b34e5d270","uuid":"7da3ad71-1ce5-4520-905b-5f14483b32bc","timestamp":"2026-11-05T20:03:55.044Z","request_id":"req_011CgkNvNhAQSbpYT3R9CEcS","wire_tool_inputs":{"toolu_01TVRjdGHtZkbAFbWcutjEVP":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-092850__x24ebb3/work/SecondStitch-*/ && npm install playwright@1.63.0 --silent 2>&1 | tail -1; python3 - <<'E'\np='src/input/cursor.js'; s=open(p).read()\ns+=\"\"\"\n/** A network client's own tip: it moves at once, and eases toward the host's only once it has drifted over a unit. */\nexport function correctDrift(tip, serverX, serverZ) {\n  if (serverX == null || Math.hypot(serverX - tip.x, serverZ - tip.z) <= 1) return false;\n  tip.x += (serverX - tip.x) * 0.04;\n  tip.z += (serverZ - tip.z) * 0.04;\n  return true;\n}\n\"\"\"\nopen(p,'w').write(s)\np='src/net/session.js'; s=open(p).read()\nold=\"if (seat.serverX != null && Math.hypot(seat.serverX - i.x, seat.serverZ - i.z) > 1) { const tip = stage.tips[this.mySeat]; tip.x += (seat.serverX - tip.x) * 0.04; tip.z += (seat.serverZ - tip.z) * 0.04; }\"\nassert old in s\ns=s.replace(old,\"correctDrift(stage.tips[this.mySeat], seat.serverX, seat.serverZ);\")\ns=s.replace(\"import { app } from '../core/app.js';\",\"import { app } from '../core/app.js';\\nimport { correctDrift } from '../input/cursor.js';\",1)\nopen(p,'w').write(s)\np='src/sim/op.js'; s=open(p).read()\ns=s.replace(\"/** Dev Mode actions. */\",\"\"\"/** A balance value changed while an op runs: including the ones an op otherwise reads only when it starts. */\nexport function applyLiveConfig(sim, k, v, before) {\n  sim.cfg[k] = v;\n  if (k === 'timeLimit' && before > 0) { sim.clock *= v / before; sim.clockMax *= v / before; }\n  if (k === 'coopScale') sim.coop = 1 + v * (sim.seats.length - 1);\n  if (k === 'irae' && sim.heart) sim.heart.bpm = Math.max(40, sim.heart.bpm + (v - before));\n  if (k === 'strainHp' && before > 0) for (const e of sim.ents) {\n    if (e.k === 'strain' && e.hp != null) e.hp = Math.max(1, Math.round(e.hp * (v / before)));\n    if (e.k === 'eye' && e.eyeHp != null) e.eyeHp = Math.max(1, Math.round(e.eyeHp * (v / before)));\n  }\n}\n\n/** Dev Mode actions. */\"\"\")\nopen(p,'w').write(s)\np='src/ui/dev.js'; s=open(p).read()\na=s.index(\"  /** Live, on the running op too\"); b=s.index(\"  balance() {\")\ns=s[:a]+\"\"\"  /** Live, on the running op too. */\n  setCfg(k, v) {\n    const before = config[k], sim = this.stage.sim;\n    config[k] = v;\n    if (sim) applyLiveConfig(sim, k, v, before);\n  }\n\"\"\"+s[b:]\ns=s.replace(\"import { dev } from '../sim/op.js';\",\"import { applyLiveConfig, dev } from '../sim/op.js';\")\nopen(p,'w').write(s)\np='src/view/hands.js'; s=open(p).read()\ns=s.replace(\"    this.current = null;\\n    this.side =\",\"    this.gloveSlot = g[0];\\n    this.current = null;\\n    this.side =\")\nopen(p,'w').write(s)\np='tests/sim.test.mjs'; s=open(p).read()\ns=s.replace(\"  /* Awards stay inside\",\"\"\"  /* Every Dev Mode slider does something to a running op */\n  { const run = (mut, seats = 1, frames = 600, def = OPS.op1) => { const c = { ...defaults }; const s = createOp(def, { seats, cfg: c, seed: 2 }); mut?.(s); for (let i = 0; i < frames && s.phase === 'play'; i++) { step(s, []); drainEvents(s); } return s; };\n    const v0 = run(null, 2).tables[0].vitals, v1 = run((s) => applyLiveConfig(s, 'coopScale', 1, 0.25), 2).tables[0].vitals;\n    ok('slider coop scale: more seats drain faster, live', v1 < v0 - 0.01, `${v0} ${v1}`);\n    const lone = createOp(OPS.op1, { seats: 1, cfg: { ...defaults } }); applyLiveConfig(lone, 'coopScale', 1, 0.25);\n    ok('slider coop scale: alone it changes nothing', lone.coop === 1);\n    const t = createOp(OPS.op1, { cfg: { ...defaults } }), c0 = t.clock; applyLiveConfig(t, 'timeLimit', 2, 1);\n    ok('slider time limit: scales the running clock', Math.abs(t.clock - c0 * 2) < 1e-6);\n    const boss = createOp(OPS.op5, { stage: 1, cfg: { ...defaults }, seed: 2 }); for (let i = 0; i < 5; i++) step(boss, []);\n    const st = boss.ents.find((e) => e.k === 'strain'), hp0 = st.hp; applyLiveConfig(boss, 'strainHp', 2, 1);\n    ok('slider strain HP: a running Introit has more HP', st.hp === hp0 * 2 && boss.cfg.strainHp === 2, `${hp0} ${st.hp}`);\n    const weep = createOp(OPS.op7, { stage: 1, cfg: { ...defaults }, seed: 2 }); for (let i = 0; i < 5; i++) step(weep, []);\n    const eye = weep.ents.find((e) => e.k === 'eye'), e0 = eye.eyeHp; applyLiveConfig(weep, 'strainHp', 2, 1);\n    ok('slider strain HP: running eyes too', eye.eyeHp === e0 * 2, `${e0} ${eye.eyeHp}`);\n    const h = createOp(OPS.op8, { stage: 1, cfg: { ...defaults }, seed: 2 }); for (let i = 0; i < 5; i++) step(h, []); const b0 = h.heart.bpm; applyLiveConfig(h, 'irae', 92, 72);\n    ok('slider base BPM: moves the running heart', h.heart.bpm === b0 + 20);\n    // Aim assist: the same stick push moves less near a target, and more damped along a stroke.\n    const tipA = { x: 0, z: 0 }, tipB = { x: 0, z: 0 }, tipC = { x: 0, z: 0 };\n    integrateTip(tipA, 1, 0, { speed: 10, steadyFactor: 0.4, assist: 0, near: true });\n    integrateTip(tipB, 1, 0, { speed: 10, steadyFactor: 0.4, assist: 0.4, near: true });\n    integrateTip(tipC, 1, 0, { speed: 10, steadyFactor: 0.4, assist: 0.4, near: false });\n    ok('slider aim assist: 60% speed near a target at Low, none at 0', Math.abs(tipB.x / tipA.x - 0.6) < 1e-6 && tipC.x === tipA.x, `${tipA.x} ${tipB.x} ${tipC.x}`);\n    const sA = { x: 0, z: 0 }, sB = { x: 0, z: 0 };\n    integrateTip(sA, 0, 1, { speed: 10, steadyFactor: 0.4, assist: 0, stroke: [1, 0] });\n    integrateTip(sB, 0, 1, { speed: 10, steadyFactor: 0.4, assist: 0.4, stroke: [1, 0] });\n    ok('slider aim assist: perpendicular drift damped 50% on a stroke', Math.abs(sB.z / sA.z - 0.5) < 1e-6, `${sA.z} ${sB.z}`);\n    // Each remaining slider, by what it changes.\n    const mutFx = (k, v, check) => { const a = { ...defaults, [k]: v }; return check(a); };\n    ok('slider drain rate', mutFx('drainRate', 3, (c) => { const s = createOp(OPS.op1, { stage: 1, cfg: c }); step(s, [{ x: -3, z: 0.5, tool: 'drain', use: 1 }]); const e = s.ents.find((q) => q.sid === 'p1'); return e.r < 1.5 - 2.9 / 60; }));\n    ok('slider mistake cost', mutFx('mistakePenalty', 20, (c) => { const s = createOp(OPS.op1, { cfg: c }); const v = s.tables[0].vitals; mistake(s, s.seats[0], 'x', 0, 0); return v - s.tables[0].vitals === 20; }));\n    ok('slider max mistakes: 0 means unlimited', mutFx('maxMistakes', 0, (c) => { const s = createOp(OPS.op1, { cfg: c }); for (let i = 0; i < 9; i++) mistake(s, s.seats[0], 'x', 0, 0); return s.phase === 'play'; }));\n    ok('slider vitals drain', run((s) => applyLiveConfig(s, 'vitalsDrain', 3, 1)).tables[0].vitals < run().tables[0].vitals);\n    ok('slider bleed drain', (() => { const mk = (b) => { const s = createOp(OPS.op1, { stage: 1, cfg: { ...defaults, bleedDrain: b } }); for (let i = 0; i < 120; i++) step(s, []); return s.tables[0].vitals; }; return mk(1) < mk(0); })());\n    ok('slider composure gain', mutFx('composureGain', 20, (c) => { const s = createOp(OPS.op5, { cfg: c }), v = s.composure; rate(s, s.seats[0], 'CLEAN', 0, 0); return s.composure === v + 20; }));\n    ok('slider quiet slow', mutFx('quietSlow', 0.5, (c) => { const s = createOp(OPS.op5, { cfg: c, stage: 1 }); s.composure = 100; const k = s.clock; for (let i = 0; i < 60; i++) step(s, [{ gift: true }]); return Math.abs(k - s.clock - 0.5) < 0.03; }));\n    ok('slider quiet drain', mutFx('quietDrain', 40, (c) => { const s = createOp(OPS.op5, { cfg: c, stage: 1 }); s.composure = 100; for (let i = 0; i < 60; i++) step(s, [{ gift: true }]); return Math.abs(s.composure - 60) < 1; }));\n    ok('slider syringe dose', mutFx('syringeDose', 30, (c) => { const s = createOp(OPS.op1, { cfg: c }); s.tables[0].vitals = 40; const p = s.port; for (let i = 0; i < 30; i++) step(s, [{ x: p[0], z: p[1], tool: 'syringe', use: 1 }]); step(s, [{ x: p[0], z: p[1], tool: 'syringe', use: 0 }]); return s.tables[0].vitals > 69; }));\n    ok('slider laser time', mutFx('laserTime', 2, (c) => { const s = createOp({ ...OPS.op2, id: 'lz', stages: [{ id: 'a', spawn: [{ k: 'polyp', at: [0, 0] }], until: { clear: ['polyp'] } }, { id: 'b', until: { time: 99 } }] }, { cfg: c }); for (let i = 0; i < 60; i++) step(s, [{ x: 0, z: 0, tool: 'laser', use: 1 }]); return s.ents.some((e) => e.k === 'polyp'); }));\n    ok('slider tool tolerance', mutFx('toolTolerance', 3, (c) => { const s = createOp({ ...OPS.op2, id: 'tl', stages: [{ id: 'a', spawn: [{ k: 'hook', at: [0, 0], dir: [0, -1], pull: 1 }], until: { clear: ['hook'] } }] }, { cfg: c }); step(s, [{ x: 1, z: 0, tool: 'forceps', use: 1 }]); return s.seats[0].grab != null; }));\n    ok('slider look cost and seconds', mutFx('lookCost', 10, (c) => { const s = createOp(OPS.op6, { cfg: { ...c, lookSeconds: 1 }, seed: 1 }); s.composure = 15; for (let i = 0; i < 90; i++) step(s, [{}]); const clk = s.clock; step(s, [{ gift: true }]); return s.looks === 1 && Math.abs(s.clock - clk - 1) < 0.15; }));\n    ok('slider strain speed', (() => { const go = (sp) => { const s = createOp(OPS.op5, { stage: 1, seed: 2, cfg: { ...defaults, strainSpeed: sp } }); for (let i = 0; i < 120; i++) step(s, []); return s.ents.find((e) => e.k === 'strain').s; }; return go(2) > go(1) * 1.5; })());\n    ok('slider code blue zone', mutFx('codeBlueZone', 0.5, (c) => { const s = createOp(OPS.op1, { cfg: c }); dev.codeBlue(s); return s.codeBlue.zone === 0.5; }));\n    ok('slider cursor speed and steady factor', (() => { const a = { x: 0, z: 0 }, b = { x: 0, z: 0 }; integrateTip(a, 1, 0, { speed: 20, steadyFactor: 0.4 }); integrateTip(b, 1, 0, { speed: 10, steady: true, steadyFactor: 0.5 }); return a.x === (20 / 60) && Math.abs(b.x - 5 / 60) < 1e-9; })());\n  }\n  /* A client's tip: moves at once, eases only past a unit of drift */\n  { const near = { x: 0, z: 0 }, far = { x: 0, z: 0 };\n    ok('drift: under a unit, left alone', correctDrift(near, 0.9, 0) === false && near.x === 0);\n    ok('drift: over a unit, eases toward the host', correctDrift(far, 1.5, 0) === true && far.x > 0 && far.x < 0.2, String(far.x));\n    ok('drift: no host position yet, left alone', correctDrift({ x: 0, z: 0 }, null, null) === false); }\n  /* Awards stay inside\"\"\")\ns=s.replace(\"import { createOp, step, drainEvents, hashSim, cloneState, dev, defOf } from '../src/sim/op.js';\",\"import { applyLiveConfig, createOp, step, drainEvents, hashSim, cloneState, dev, defOf, mistake } from '../src/sim/op.js';\\nimport { correctDrift, integrateTip } from '../src/input/cursor.js';\")\ns=s.replace(\"import { awardsFor, results, rankOf, capRank } from '../src/sim/scoring.js';\",\"import { awardsFor, rate, results, rankOf, capRank } from '../src/sim/scoring.js';\")\nopen(p,'w').write(s)\np='tests/browser/run.mjs'; s=open(p).read()\ns=s.replace(\"\"\"      ok('couch: the second seat has its own wheel',\"\"\",\"\"\"      const look = await page.evaluate(() => {\n        const st = window.__GAME__.stage, hud = window.__PIXEL_ENGINE__.hud, orig = hud.sprite; let icons = 0;\n        hud.sprite = function (x, y, rows, ...r) { if (rows.length === 11 && rows[0].length === 12) icons++; return orig.call(this, x, y, rows, ...r); };\n        st.drawHud(window.__GAME__.app.ctx, st.sim, 0, st.sim.seats[0]);\n        hud.sprite = orig;\n        return { slots: st.hands.map((h) => h.gloveSlot), icons };\n      });\n      ok('couch: gloves take the seat colour', look.slots[0] === 'red' && look.slots[1] === 'blue', look.slots.join());\n      ok('couch: a tool icon by each tip, plus each seat wheel', look.icons >= 4, String(look.icons));\n      ok('couch: the second seat has its own wheel',\"\"\")\ns=s.replace(\"    /* retry from a failed op */\",\"\"\"    /* The hand holds the tool: the palm is on the handle at every corner of the field, for every seat. */\n    { const { page, errors, ctx } = await open(b, '?op=op1&stage=2');\n      await wait(page, () => window.__GAME__?.stage?.intro <= 0);\n      const r = await page.evaluate(() => { const st = window.__GAME__.stage, h = st.hands[0], out = []; const THREE_V = h.hand.position.clone(); void THREE_V;\n        for (const [x, z] of [[-5, -3], [5, -3], [-5, 2.5], [5, 2.5], [0, 0]]) { const seat = { ...st.sim.seats[0], x, z, table: 0, tool: 'forceps', useHeld: false, grab: null, drawing: 0 }; h.update(seat, 0.5, st.sim); const tool = h.tools.forceps; const grip = tool.localToWorld(tool.position.clone().set(0, 0.1, 1.5)); out.push(+Math.hypot(grip.x - h.hand.position.x, grip.y - h.hand.position.y, grip.z - h.hand.position.z).toFixed(2)); }\n        return out; });\n      ok('hand: the palm stays on the handle', r.every((d) => d < 0.6), r.join());\n      ok('no errors: hand', !errors.length, errors.join());\n      await ctx.close(); }\n    /* retry from a failed op */\"\"\")\nopen(p,'w').write(s)\nE\nnode tools/build.mjs && cmp dist/game.html ../$(basename $PWD).html && echo testing-the-deliverable; timeout 200 node tests/run.mjs sim 2>&1 | tail -12 | cut -c1-260; timeout 100 node tests/run.mjs headless 2>&1 | tail -2 | cut -c1-200; timeout 200 node tests/run.mjs content 2>&1 | tail -2 | cut -c1-200","description":"Make drift and sliders testable, add behaviour tests, run node suites","timeout":560000}}}
