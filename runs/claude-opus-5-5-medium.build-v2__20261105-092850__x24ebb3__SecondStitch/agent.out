    const wheelSize = 54, textW = W - wheelSize - 12 - 32;\\n\",\"\")\ns=s.replace(\"hud.rect(0, sy, 2, stripH, 0x0d0b14); hud.rect(0, H - 2, 33, 2, 0x0d0b14);\",\"hud.rect(0, sy, 33, stripH - 31, 0x0d0b14); hud.rect(0, H - 33, 2, 33, 0x0d0b14); hud.rect(0, H - 2, 33, 2, 0x0d0b14);\")\ns=s.replace(\"if (!comm) hud.rect(2, sy + 1, 31, 30, 0x1a1f2b);\",\"if (!comm) hud.rect(2, H - 32, 31, 30, 0x1a1f2b);\")\nopen(p,'w').write(s)\np='tests/browser/run.mjs'; s=open(p).read()\ns=s.replace(\"    /* retry from a failed op */\",\"\"\"    /* the crown: built even though the sim makes its ring after the view's first frame */\n    { const { page, errors, ctx } = await open(b, '?op=op8&stage=1');\n      await wait(page, () => window.__GAME__?.stage?.intro <= 0);\n      await page.waitForTimeout(800);\n      const n = await page.evaluate(() => [...window.__GAME__.stage.strains.items.values()].map((o) => o.plateMeshes?.filter((m) => m.visible).length ?? 0)[0]);\n      ok('dies irae: the crown shows seven plates', n === 7, String(n));\n      ok('no errors: crown', !errors.length, errors.join());\n      await ctx.close(); }\n    /* retry from a failed op */\"\"\")\ns=s.replace(\"\"\"      ok('no errors: menus',\"\"\",\"\"\"      // 4:3: three lines of comm text still fit, the strip grows.\n      ok('no errors: menus',\"\"\")\nopen(p,'w').write(s)\np='tests/browser/tour.mjs'; s=open(p).read()\ns=s.replace(\"const b = await launch();\",\"const b = await launch();\\nconst VP = process.env.VP ? process.env.VP.split('x').map(Number) : [1920, 1080];\")\ns=s.replace(\"viewport: { width: 1920, height: 1080 }\",\"viewport: { width: VP[0], height: VP[1] }\")\nopen(p,'w').write(s)\nE\ngrep -n \"const narrow\\|const comm = \\|stripH = \" src/ui/hud.js | cut -c1-90; python3 - <<'E'\np='src/ui/hud.js'; s=open(p).read()\n# comm must be computed before the strip size\nif s.index(\"const comm = this.updateComm\")>s.index(\"const stripH\"):\n    print('order bad')\nE\nsed -n '/comm strip/,+3p' src/ui