{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgk8RSf6QbMQC5ERf3P4E","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014WBFQ6PrjidbZgwFcSzZss","name":"Bash","input":{"command":"cat > src/view/bust.js <<'EOF'\n// Talking heads: built from slab outlines with pivots for head, mouth, brows and lids.\nimport { buildModel, setLookLayer, THREE } from '../../pixel-engine.js';\nimport { bustDef, CATALOG } from '../content/models/index.js';\n\nconst POSES = {\n  neutral: { brow: 0, browY: 0, lid: 0, mouth: 1, tilt: 0, sweat: 0, blush: 0, tear: 0 },\n  stern: { brow: 22, browY: -0.03, lid: 0.2, mouth: 0.8, tilt: -0.04 },\n  shock: { brow: -18, browY: 0.07, lid: -0.3, mouth: 2.2, tilt: 0.06, sweat: 1 },\n  sad: { brow: -26, browY: 0.03, lid: 0.45, mouth: 0.7, tilt: 0.09, tear: 1 },\n  smile: { brow: -6, browY: 0.02, lid: 0.15, mouth: 1.5, tilt: 0.03, blush: 1 },\n  angry: { brow: 34, browY: -0.05, lid: 0.25, mouth: 1.5, tilt: -0.07 },\n  panic: { brow: -32, browY: 0.08, lid: -0.3, mouth: 2.8, tilt: 0.1, sweat: 1 },\n};\n\nexport class BustView {\n  constructor(ctx, id, opts = {}) {\n    this.ctx = ctx; this.id = id;\n    const build = buildModel(bustDef(id), { catalog: CATALOG });\n    this.root = new THREE.Group();\n    this.object = build.object;\n    this.root.add(this.object);\n    setLookLayer(this.root, 'actors');\n    this.object.traverse((m) => { if (m.isMesh) { m.castShadow = false; m.receiveShadow = false; } });\n    const q = (n) => this.object.getObjectByName(n);\n    this.head = q('head'); this.mouth = q('mouth'); this.browL = q('browL'); this.browR = q('browR'); this.lidL = q('lidL'); this.lidR = q('lidR');\n    this.sweat = q('sweat'); this.tear = q('tear'); this.blush = q('blush');\n    this.baseY = { browL: this.browL.position.y, browR: this.browR.position.y, lidL: this.lidL.position.y, lidR: this.lidR.position.y, sweat: this.sweat.position.y, tear: this.tear.position.y };\n    this.pose = { ...POSES.neutral }; this.target = POSES.neutral; this.talkAmt = 0; this.t = opts.seed ?? Math.abs(id.charCodeAt(0)) * 0.7; this.blinkT = 2 + (this.t % 3); this.blink = 0; this.lean = 0; this.leanTarget = 0; this.shakeT = 0;\n    (opts.parent ?? ctx.scene).add(this.root);\n    this.setEmotion('neutral');\n    this.dimmed = null; this.bx = 0;\n  }\n  setEmotion(e) { this.target = { ...POSES.neutral, ...(POSES[e] ?? POSES.neutral) }; this.emotion = e; if (e === 'shock' || e === 'panic') this.shakeT = 0.3; }\n  talk(a = 1) { this.talkAmt = Math.max(this.talkAmt, a); }\n  update(dt) {\n    this.t += dt;\n    const k = Math.min(1, dt * 12);\n    for (const key of Object.keys(POSES.neutral)) this.pose[key] += ((this.target[key] ?? 0) - this.pose[key]) * k;\n    const p = this.pose;\n    this.blinkT -= dt;\n    if (this.blinkT <= 0) { this.blink = 0.12; this.blinkT = 2 + ((this.t * 37) % 3); }\n    this.blink = Math.max(0, this.blink - dt);\n    const lid = this.blink > 0 ? 1.1 : Math.max(-0.2, p.lid);\n    const lidScale = Math.max(0.01, lid);\n    this.lidL.scale.y = this.lidR.scale.y = lid > 0.02 ? lidScale : 0.01;\n    this.lidL.position.y = this.baseY.lidL - lid * 0.08 + (lid < 0 ? 0.05 : 0);\n    this.lidR.position.y = this.baseY.lidR - lid * 0.08 + (lid < 0 ? 0.05 : 0);\n    const rad = (p.brow * Math.PI) / 180;\n    this.browL.rotation.z = -rad; this.browR.rotation.z = rad;\n    this.browL.position.y = this.baseY.browL + p.browY; this.browR.position.y = this.baseY.browR + p.browY;\n    // Mouth follows syllables.\n    this.talkAmt = Math.max(0, this.talkAmt - dt * 7);\n    const mouthOpen = p.mouth + this.talkAmt * 3.4 * (0.6 + 0.4 * Math.sin(this.t * 31));\n    this.mouth.scale.y = Math.max(0.6, mouthOpen * 1.2);\n    this.mouth.scale.x = 0.8 + Math.min(0.5, (p.mouth - 1) * 0.3);\n    // sway\n    this.shakeT = Math.max(0, this.shakeT - dt);\n    this.head.rotation.z = p.tilt + Math.sin(this.t * 0.9) * 0.018 + (this.shakeT > 0 ? Math.sin(this.t * 60) * 0.04 : 0);\n    this.head.rotation.y = Math.sin(this.t * 0.6) * 0.03 + this.look;\n    this.head.rotation.x = Math.sin(this.t * 1.2) * 0.012 + this.lean * 0.06;\n    // extras\n    this.sweat.visible = p.sweat > 0.4;\n    if (this.sweat.visible) this.sweat.position.y = this.baseY.sweat - (this.t * 0.5) % 0.3;\n    this.tear.visible = p.tear > 0.4;\n    if (this.tear.visible) this.tear.position.y = this.baseY.tear - (this.t * 0.25) % 0.26;\n    this.blush.visible = p.blush > 0.4;\n    this.lean += (this.leanTarget - this.lean) * Math.min(1, dt * 7);\n  }\n  look = 0;\n}\nEOF\ncat > src/content/sets.js <<'EOF'\n// The story sets as data: a lighting recipe and what stands where. Generic furniture comes from the Kenney pack.\nexport const SETS = {\n  or7: { label: 'OR-7', wall: 0x2a3a46, floor: 0x2a3742, sun: 0.35, ambient: [0x8fa8c8, 0.5], lamp: [0, 3.2, 0, 14, 7, 0xfff0d0], rain: false, wide: { pos: [4.4, 3, 6.6], target: [0, 1, 0] } },\n  scrub: { label: 'SCRUB ROOM', wall: 0x4a6a70, floor: 0x35464c, sun: 0.5, ambient: [0xbfd8e0, 0.7], lamp: [0, 3, 1, 8, 8, 0xe0fff5], wide: { pos: [3.4, 2.4, 6], target: [0, 1.1, 0] } },\n  office: { label: \"CHIEF'S OFFICE\", wall: 0x4a3226, floor: 0x33241c, sun: 0.3, ambient: [0xb09070, 0.6], lamp: [-1, 2.6, 1.4, 9, 7, 0xffd8a0], rain: true, wide: { pos: [3.6, 2.4, 6.4], target: [0, 1.1, -0.5] } },\n  ward: { label: 'WARD 4', wall: 0x5a7080, floor: 0x3c4a54, sun: 0.5, ambient: [0xc8d8e8, 0.7], lamp: [0, 3, 0, 7, 9, 0xf0f8ff], wide: { pos: [4.2, 2.6, 6.6], target: [0, 1, 0] } },\n  corridor: { label: 'A&E CORRIDOR', wall: 0x54646a, floor: 0x2f3b40, sun: 0.4, ambient: [0xb0c0c8, 0.6], lamp: [0, 3, 0, 10, 8, 0xfff4d8], wide: { pos: [0.5, 2.1, 7.2], target: [0, 1.1, -2] } },\n  atrium: { label: 'FOUNDATION ATRIUM', wall: 0xe8e4d8, floor: 0xc8c4b4, sun: 1, ambient: [0xfff6e0, 0.9], lamp: [0, 4, 0, 10, 12, 0xfff0c0], wide: { pos: [4, 2.8, 7], target: [0, 1.3, -1] } },\n  roof: { label: 'HELIPAD', wall: 0x101828, floor: 0x20262e, sun: 0.25, ambient: [0x486080, 0.6], lamp: [1, 4, 1, 10, 9, 0xbfd8ff], rain: true, outdoor: true, wide: { pos: [5, 3.4, 7.4], target: [0, 1, 0] } },\n  morning: { label: 'THE ROOF, MORNING', wall: 0x9fd0e8, floor: 0x50585e, sun: 1.1, ambient: [0xffe8c8, 0.9], lamp: [0, 4, 0, 2, 6, 0xffffff], outdoor: true, dawn: true, wide: { pos: [4, 2.6, 7], target: [0, 1.2, 0] } },\n};\nEOF\ncat > src/view/sets.js <<'EOF'\n// Builds a story set: room shell, recoloured furniture, lighting, weather. Used by story, title and briefing.\nimport { buildModel, loadPack, PALETTE, Precipitation, setLookLayer, THREE, toonMaterial, clothGrid, SoftMesh, mergeStaticMeshes, compileClips, HERO_CLIPS, HERO_RIG } from '../../pixel-engine.js';\nimport { SETS } from '../content/sets.js';\nimport { CATALOG, figureDef } from '../content/models/index.js';\n\nconst { BoxGeometry, Color, CylinderGeometry, Group, Mesh, AnimationMixer, LoopOnce, LoopRepeat } = THREE;\nlet kit = null;\nexport async function furniture() {\n  if (kit) return kit;\n  try { kit = await loadPack('packs/kenney-furniture.json'); } catch { kit = { failed: true }; }\n  return kit;\n}\nconst STEEL = { };\nfunction place(ctx, group, name, x, y, z, turn = 0, scale = 1, palette = null) {\n  if (!kit || kit.failed) return null;\n  try {\n    const b = buildModel(`kenney-furniture/${name}`, { catalog: kit, palette: palette ?? undefined });\n    const o = b.object.clone(true);\n    o.position.set(x, y, z); o.rotation.y = (turn * Math.PI) / 180; o.scale.setScalar(scale);\n    o.traverse((m) => { if (m.isMesh) { m.castShadow = true; m.receiveShadow = true; } });\n    group.add(o);\n    return o;\n  } catch { return null; }\n}\nconst box = (group, x, y, z, w, h, d, c, opts = {}) => { const m = new Mesh(new BoxGeometry(w, h, d), toonMaterial(c, opts)); m.position.set(x, y, z); m.castShadow = !!opts.cast; m.receiveShadow = true; group.add(m); return m; };\n\nexport async function buildSet(ctx, id, { busy = true } = {}) {\n  await furniture();\n  const S = SETS[id] ?? SETS.or7, g = new Group();\n  ctx.scene.add(g);\n  const eng = ctx.engine;\n  eng.sun.intensity = S.sun; eng.ambient.color.setHex(S.ambient[0]); eng.ambient.intensity = S.ambient[1];\n  ctx.scene.background = new Color(S.outdoor ? (S.dawn ? 0xf2d6b0 : 0x0a0e18) : 0x0a0a10);\n  const light = ctx.lights.request({ position: [S.lamp[0], S.lamp[1], S.lamp[2]], intensity: S.lamp[3], radius: S.lamp[4], color: S.lamp[5] });\n  const out = { group: g, def: S, light, update: () => {} };\n  box(g, 0, -0.1, 0, 22, 0.2, 18, S.floor);\n  if (!S.outdoor) {\n    box(g, 0, 2.5, -5, 22, 5.2, 0.3, S.wall);\n    box(g, -8, 2.5, 0, 0.3, 5.2, 18, S.wall);\n    box(g, 8, 2.5, 0, 0.3, 5.2, 18, S.wall);\n    box(g, 0, 0.3, -4.82, 22, 0.6, 0.1, 0x1f2a30);\n  }\n  const updates = [];\n  if (S.rain) {\n    const rain = new Precipitation({ kind: 'rain', count: S.outdoor ? 2500 : 600 });\n    rain.wind.set(-1.5, 0);\n    ctx.scene.add(rain);\n    const center = new THREE.Vector3(S.outdoor ? 0 : 0, 2, S.outdoor ? 2 : -8);\n    updates.push((dt) => rain.update(dt, center));\n  }\n  switch (id) {\n    case 'or7': {\n      // table, patient under drape, lamp arm, monitor, tray, gallery glass, doors\n      box(g, 0, 0.85, 0, 1.3, 0.14, 3, 0xb8c0cc, { cast: true }); box(g, 0, 0.4, 0, 0.4, 0.8, 0.8, 0x56606e, { cast: true });\n      box(g, 0, 1.02, 0, 1.2, 0.22, 2.7, PALETTE.teal, { cast: true }); box(g, 0, 1.03, -1.32, 0.46, 0.26, 0.36, PALETTE.sand);\n      box(g, 0, 1.18, -0.5, 0.86, 0.2, 1, PALETTE.teal, { cast: true });\n      const arm = new Group(); arm.position.set(0.2, 4.2, 0); g.add(arm);\n      box(arm, 0, -0.6, 0, 0.12, 1.2, 0.12, 0x8a93a6); const lamp = new Mesh(new CylinderGeometry(0.6, 0.86, 0.3, 10), toonMaterial(0xcfd6e0)); lamp.position.set(0, -1.3, 0); lamp.castShadow = true; arm.add(lamp);\n      const bulb = new Mesh(new CylinderGeometry(0.5, 0.5, 0.04, 10), new THREE.MeshBasicMaterial({ color: 0xfff8dc })); bulb.position.set(0, -1.47, 0); arm.add(bulb);\n      out.lampArm = arm;\n      update