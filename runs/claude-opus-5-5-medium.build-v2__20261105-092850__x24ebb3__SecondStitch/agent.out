{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgk9QGCdb4hRQuCF8YpZa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01C4hDp4yzuicbizQpu4kVbd","name":"Bash","input":{"command":"cd .. && cat > src/view/strains.js <<'EOF'\n// The strains as creatures on the actors layer: crown, weeper body, halo. Their working parts are sim entities.\nimport { LegStepper, PALETTE, SpringChain, setLookLayer, THREE, toonMaterial, twoBoneIK } from '../../pixel-engine.js';\nimport { PROP_DEFS, CATALOG } from '../content/models/index.js';\nimport { buildModel } from '../../pixel-engine.js';\n\nconst { BoxGeometry, ConeGeometry, Group, Mesh, SphereGeometry, TorusGeometry, CylinderGeometry, Vector3 } = THREE;\nconst mat = (c, rim) => toonMaterial(c, rim ? { rim } : {});\nconst actor = (o) => { setLookLayer(o, 'actors'); o.traverse((m) => { if (m.isMesh) m.castShadow = true; }); return o; };\n\nclass Tendrils {\n  constructor(root, n, color, len = 0.3, segs = 6, thick = 0.14) {\n    this.items = Array.from({ length: n }, (_, i) => {\n      const a = (i / n) * Math.PI * 2;\n      const chain = new SpringChain({ segments: segs, length: len, stiffness: 5, gravity: 2.5, rest: [Math.cos(a), -0.15, Math.sin(a)], keep: 0.92 });\n      const bits = Array.from({ length: segs }, (_, k) => { const b = new Mesh(new BoxGeometry(thick - k * 0.012, thick - k * 0.012, len + 0.05), mat(color)); actor(b); root.add(b); return b; });\n      return { chain, bits, a };\n    });\n  }\n  update(dt, x, y, z, ground, wig = 0) {\n    for (const it of this.items) {\n      it.chain.update(dt, [x + Math.cos(it.a) * 0.3, y, z + Math.sin(it.a) * 0.3 + Math.sin(wig + it.a * 3) * 0.05], [[1, 0, 0], [0, 1, 0], [0, 0, 1]]);\n      it.bits.forEach((b, i) => {\n        const p = it.chain.points[i + 1], q = it.chain.points[i];\n        const gy = ground(p[0], p[2]) + 0.08;\n        if (p[1] < gy) p[1] = gy;\n        b.position.set((p[0] + q[0]) / 2, Math.max(gy, (p[1] + q[1]) / 2), (p[2] + q[2]) / 2);\n        b.lookAt(p[0], p[1], p[2]);\n      });\n    }\n  }\n  setVisible(v) { for (const it of this.items) for (const b of it.bits) b.visible = v; }\n  remove(root) { for (const it of this.items) for (const b of it.bits) root.remove(b); }\n}\n\nexport class StrainViews {\n  constructor(ctx, field) { this.ctx = ctx; this.field = field; this.root = new Group(); ctx.scene.add(this.root); this.items = new Map(); this.dying = []; this.eyes = new Map(); this.t = 0; }\n  make(e) {\n    const g = new Group(); this.root.add(g);\n    const o = { g, e, parts: [] };\n    if (e.type === 'irae') {\n      o.plateMeshes = (e.ring ?? []).map((_, i) => { const m = buildModel(PROP_DEFS.plate, { catalog: CATALOG }).object.clone(true); actor(m); m.scale.setScalar(1.3); this.root.add(m); m.userData.i = i; return m; });\n      const orb = new Mesh(new SphereGeometry(0.7, 12, 8), mat(PALETTE.plum, 0xff3a3a));\n      actor(orb); orb.position.y = 0.3; g.add(orb); o.orb = orb;\n      const glow = new Mesh(new SphereGeometry(0.28, 8, 6), new THREE.MeshBasicMaterial({ color: PALETTE.red })); glow.position.set(0, 0.86, 0.1); g.add(glow); o.glow = glow;\n      o.tendrils = new Tendrils(this.root, 7, PALETTE.red, 0.34, 6, 0.16);\n    } else if (e.type === 'lacrimosa') {\n      const body = new Mesh(new SphereGeometry(0.9, 10, 7), mat(PALETTE.plum, 0x8ad0ff)); body.scale.y = 0.45; actor(body); body.position.y = 0.15; g.add(body); o.body = body;\n      o.legs = new Map();\n    } else if (e.type === 'miserere') {\n      const m = buildModel(PROP_DEFS.coreMiserere, { catalog: CATALOG }).object.clone(true); actor(m); m.scale.setScalar(1.5); g.add(m); o.halo = m;\n      o.tendrils = new Tendrils(this.root, 5, PALETTE.sand, 0.3, 5, 0.1);\n    } else if (e.type === 'introit') {\n      o.tendrils = new Tendrils(this.root, 4, PALETTE.plum, 0.3, 4, 0.15);\n      o.tendrils.setVisible(false);\n    }\n    return o;\n  }\n  update(state, dt) {\n    this.t += dt;\n    const f = this.field, ground = (x, z) => f.surface(x, z);\n    const seen = new Set();\n    for (const e of state.ents) {\n      if (e.k !== 'strain' || e.x == null || !e.type || e.type === 'pileup') continue;\n      seen.add(e.id);\n      let o = this.items.get(e.id);\n      if (!o) { o = this.make(e); this.items.set(e.id, o); }\n      o.e = e;\n      const y = f.surface(e.x, e.z);\n      o.g.position.set(e.x, y, e.z);\n      if (e.type === 'irae') {\n        const beat = f.beat;\n        o.plateMeshes?.forEach((m, i) => {\n          const r = e.ring?.[i];\n          if (!r) return;\n          const ent = state.ents.find((q) => q.k === 'plate' && q.ringIx === i);\n          m.visible = r[2] === 1 && !ent;\n          m.position.set(r[0], f.surface(r[0], r[1]) + 0.05 + beat * 0.1, r[1]);\n          m.rotation.y = Math.atan2(r[0] - e.x, r[1] - e.z) + Math.PI;\n          m.scale.setScalar(1.3 * (1 + beat * 0.1));\n        });\n        const hasEye = state.ents.some((q) => q.k === 'eye' && q.owner === e.id) || state.ents.some((q) => q.k === 'eye' && q.look === 'wrath');\n        o.orb.visible = !hasEye; o.glow.visible = !hasEye;\n        o.orb.scale.setScalar(1 + beat * 0.12);\n        o.tendrils.update(dt, e.x, y + 0.3, e.z, ground, this.t * 3);\n      } else if (e.type === 'lacrimosa') {\n        o.body.rotation.y += dt * 0.3;\n        const eyes = state.ents.filter((q) => q.k === 'eye' && q.look === 'weeper');\n        for (const q of eyes) this.eyeLegs(o, q, f, dt);\n        for (const [id, L] of o.legs) if (!eyes.some((q) => q.id === id)) { L.bits.forEach((b) => this.root.remove(b)); o.legs.delete(id); }\n      } else if (e.type === 'miserere') {\n        const hover = e.mode === 'pull' ? 0 : 0.5 + Math.sin(this.t * 2) * 0.1;\n        o.g.position.y = y + hover;\n        o.halo.rotation.y += dt * 0.8;\n        o.halo.visible = e.mode !== 'pull';\n        o.tendrils.setVisible(e.mode !== 'pull');\n        o.tendrils.update(dt, e.x, y + hover + 0.3, e.z, ground, this.t * 2);\n      } else if (e.type === 'introit') {\n        const up = e.mode === 'knock' || e.mode === 'exposed';\n        o.tendrils.setVisible(up);\n        if (up) o.tendrils.update(dt, e.x, y + 0.5, e.z, ground, this.t * 8);\n      }\n    }\n    for (const [id, o] of this.items) {\n      if (seen.has(id)) continue;\n      this.dispose(o);\n      this.items.delete(id);\n    }\n    for (let i = this.dying.length - 1; i >= 0; i--) {\n      const d = this.dying[i];\n      d.t += dt / 1.1;\n      d.mats.forEach((m) => { m.dissolve = d.t; });\n      d.obj.position.y += dt * 0.3;\n      if (d.t >= 1) { this.root.remove(d.obj); this.dying.splice(i, 1); }\n    }\n  }\n  eyeLegs(o, eye, f, dt) {\n    if (!eye.crawl) return;\n    let L = o.legs.get(eye.id);\n    if (!L) {\n      const legs = [[-0.7, 0.5], [0.7, 0.5], [-0.7, -0.5], [0.7, -0.5]];\n      const stepper = new LegStepper({ legs: legs.map((rest, i) => ({ rest, partners: [(i + 1) % 4] })), lift: 0.3, threshold: 0.35 });\n      const bits = [];\n      for (let i = 0; i < 8; i++) { const b = new Mesh(new BoxGeometry(0.1, 0.1, 0.5), mat(PALETTE.plum)); actor(b); this.root.add(b); bits.push(b); }\n      L = { stepper, bits, last: [eye.x, eye.z] };\n      o.legs.set(eye.id, L);\n    }\n    const body = [eye.x, f.surface(eye.x, eye.z) + 0.5, eye.z];\n    const v = [(eye.x - L.last[0]) / Math.max(dt, 1e-3), 0, (eye.z - L.last[1]) / Math.max(dt, 1e-3)];\n    L.last = [eye.x, eye.z];\n    L.stepper.update(dt, body, 0, v, (x, z) => f.surface(x, z));\n    L.stepper.feet.forEach((foot, i) => {\n      const hip = [body[0] + (i % 2 ? 0.35 : -0.35), body[1], body[2] + (i < 2 ? 0.25 : -0.25)];\n      const knee = twoBoneIK(hip, foot.at, 0.5, 0.5, [hip[0] * 1.2, hip[1] + 1, hip[2]]);\n      const seg = (b, a, c) => { b.position.set((a[0] + c[0]) / 2, (a[1] + c[1]) / 2, (a[2] + c[2]) / 2); b.lookAt(c[0], c[1], c[2]); };\n      seg(L.bits[i * 2], hip, knee); seg(L.bits[i * 2 + 1], knee, foot.at);\n    });\n  }\n  /** Pixel dissolve when it dies. */\n  deathAt(e) {\n    const o = [...this.items.values()].find((q) => q.e.type === e.type);\n    const shape = e.type === 'miserere' ? new SphereGeometry(0.9, 10, 7) : e.type === 'lacrimosa' ? new SphereGeometry(0.9, 10, 7) : new SphereGeometry(0.8, 10, 7);\n    const m = toonMaterial(e.type === 'miserere' ? PALETTE.sand : PALETTE.plum, { dissolve: true, rim: e.type === 'miserere' ? 0xffffff : 0xff4060 }).clone();\n    m.dissolve = 0;\n    const mesh = new Mesh(shape, m);\n    actor(mesh);\n    const x = e.x ?? o?.e.x ?? 0, z = e.z ?? o?.e.z ?? 0;\n    mesh.position.set(x, this.field.surface(x, z) + 0.5, z);\n    this.root.add(mesh);\n    this.dying.push({ obj: mesh, mats: [m], t: 0 });\n  }\n  dispose(o) {\n    this.root.remove(o.g);\n    o.plateMeshes?.forEach((m) => this.root.remove(m));\n    o.tendrils?.remove(this.root);\n    if (o.legs) for (const L of o.legs.values()) L.bits.forEach((b) => this.root.remove(b));\n  }\n}\nvoid ConeGeometry; void TorusGeometry; void CylinderGeometry; void Vector3;\nEOF\npython3 - <<'E'\np='src/stages/operation.js'; s=open(p).read()\ns=s.replace(\"import { HandView } from '../view/hands.js';\",\"import { HandView } from '../view/hands.js';\\nimport { StrainViews } from '../view/strains.js';\")\ns=s.replace(\"    this.hud = new OpHud(app, ctx);\\n\",\"    this.strains = new StrainViews(ctx, this.field);\\n    this.hud = new OpHud(app, ctx);\\n\")\ns=s.replace(\"    this.field.update(sim, dt);\\n    // Draw hands\",\"    this.field.update(sim, dt);\\n    this.strains.update(sim, dt);\\n    // Draw hands\")\ns=s.replace(\"case 'strainDead': this.fx.strainDead(e);\",\"case 'strainDead': this.fx.strainDead(e); this.strains.deathAt(e);\")\ns=s.replace(\"engine.sun.intensity = 1; engine.ambient\",\"engine.sun.intensity = 0.9; engine.ambient\")\ns=s.replace(\"this.opts.net?.drawOverlay?.(ctx, sim);\",\"this.opts.net?.drawOverlay?.(ctx, sim);\")\nopen(p,'w').write(s)\np='src/view/field.js'; s=open(p).read()\ns=s.replace(\"const light = 0.25 + 0.75 * m + (fbm(x * 0.9, z * 0.9) - 0.5) * 0.9 + tilt;\",\"const light = 0.14 + 0.46 * m + (fbm(x * 0.9, z * 0.9) - 0.5) * 1.5 + (fbm(x * 2.6 + 3, z * 2.6) - 0.5) * 0.45 + tilt + a.height(x, z) * 0.1;\")\nopen(p,'w').write(s)\np='src/ui/hud.js'; s=open(p).read()\ns=s.replace(\"\"\"    hud.rect(0, sy, W, stripH, 0x0d0b14);\n    hud.rect(0, sy, W, 1, 0x2a3142);\"\"\",\"\"\"    hud.rect(33, sy, W - 33, stripH, 0x0d0b14);\n    hud.rect(0, sy, 2, stripH, 0x0d0b14); hud.rect(0, H - 2, 33, 2, 0x0d0b14);\n    hud.rect(0, sy, W, 1, 0x2a3142);\"\"\")\ns=s.replace(\"\"\"    // bust frame\n    hud.rect(2, sy + 2, 30, 29, 0x1a1f2b);\n\"\"\",\"\"\"    // bust frame: the 3D face shows through it\n    if (!comm) hud.rect(2, sy + 1, 31, 30, 0x1a1f2b);\n\"\"\")\ns=s.replace(\"\"\"    if (this.wheelT > 0) {\n      const mid = hud.measure(seat.tool.toUpperCase()).width;\n      hud.text(Math.round(W - size - mid - 8), H - size - 4, seat.tool.toUpperCase(), { color: 0xffd24d });\n    }\"\"\",\"\"\"    if (this.wheelT > 0) { // the big wheel, while picking\n      const bx = Math.round(W / 2), by = Math.round(H / 2 - 12), BR = 50;\n      TOOLS.forEach((id, i) => {\n        const a = -Math.PI / 2 + (i / 8) * Math.PI * 2, x = Math.round(bx + Math.cos(a) * BR), y = Math.round(by + Math.sin(a) * BR * 0.85);\n        const on = id === seat.tool, avail = sim.tools.includes(id);\n        hud.rect(x - 9, y - 8, 18, 16, on ? 0xffd24d : 0x0d0b14);\n        const ic2 = TOOL_ICONS[id];\n        if (ic2 && avail) hud.sprite(x - 6, y - 5, ic2.rows, ic2.colors);\n      });\n      const name = seat.tool.toUpperCase(), mid = hud.measure(name).width;\n      hud.rect(bx - mid / 2 - 3, by - 6, mid + 6, 11, 0x0d0b14);\n      hud.text(Math.round(bx - mid / 2), by - 4, name, { color: 0xffd24d });\n    }\"\"\")\nopen(p,'w').write(s)\np='src/stages/story.js'; s=open(p).read()\ns=s.replace(\"    const wide = this.camMode === 'wide';\\n\",\"    const wide = this.camMode === 'wide';\\n    for (const f of this.figures) f.obj.visible = wide;\\n\")\nopen(p,'w').write(s)\np='src/content/sets.js'; s=open(p).read()\ns=s.replace(\"office: { label: \\\"CHIEF'S OFFICE\\\", wall: 0x4a3226, floor: 0x33241c, sun: 0.3, ambient: [0xb09070, 0.6], lamp: [-1, 2.6, 1.4, 9, 7, 0xffd8a0]\",\"office: { label: \\\"CHIEF'S OFFICE\\\", wall: 0x4a3226, floor: 0x33241c, sun: 0.35, ambient: [0xc8c0b8, 0.7], lamp: [-1, 2.6, 1.4, 7, 7, 0xffe8c8]\")\nopen(p,'w').write(s)\np='src/content/models/index.js'; s=open(p).read()\ns=s.replace(\"{ name: 'dome', ball: [0.94, 0.5, 0.86], half: true, at: [0, 0.52, -0.1], c: 'skin' }\",\"{ name: 'dome', ball: [0.96, 0.46, 0.9], half: true, at: [0, 0.76, -0.12], c: 'skin' }\")\ns=s.replace(\"{ name: `eye${s}`, box: [0.22, 0.16, 0.03], at: [s * 0.2, 0.02, 0.28], c: 'white' }, { name: `pupil${s}`, box: [0.12, 0.14, 0.03], at: [s * 0.2, 0.015, 0.305], c: 'ink' },\",\"{ name: `eye${s}`, box: [0.24, 0.18, 0.03], at: [s * 0.2, 0.02, 0.28], c: 'white' }, { name: `pupil${s}`, box: [0.12, 0.15, 0.03], at: [s * 0.18, 0.012, 0.305], c: 'ink' }, { name: `spark${s}`, box: [0.05, 0.05, 0.02], at: [s * 0.16, 0.05, 0.325], c: 'white' },\")\nopen(p,'w').write(s)\nE\ncat > tests/sim.test.mjs <<'EOF'\n// Sim tests: tools, ops, gifts, scoring, slider reset, codec, the whole campaign.\nimport { createOp, step, drainEvents, hashSim, cloneState, dev, defOf } from '../src/sim/op.js';\nimport { createBot, botInput } from '../src/sim/bot.js';\nimport { OPS, CAMPAIGN_OPS, SESSION_LIST } from '../src/content/ops/index.js';\nimport { results, rankOf, capRank } from '../src/sim/scoring.js';\nimport { config, defaults, resetConfig, SLIDERS } from '../src/core/config.js';\nimport { encodeKey, encodeSnap, decodeKey, applySnap } from '../src/sim/codec.js';\nimport { CAMPAIGN, recordOp } from '../src/sim/campaign.js';\nimport { SCENES } from '../src/content/scenes/index.js';\nimport { DEFAULT_SAVE } from '../src/core/save.js';\nimport { play } from './balance.mjs';\n\nconst mini = (stages, extra = {}) => ({ id: `t${Math.random()}`, title: 'T', arena: 'forearm', surgeon: 'ilya', gifts: [], tools: ['scalpel', 'forceps', 'suture', 'drain', 'syringe', 'gel', 'laser', 'scanner'], startTool: 'drain', patient: { name: 'X', objective: 'X', followUp: {} }, time: 100, vitals: { start: 80, drain: 0 }, doses: 3, par: 1000, stages, ...extra });\nconst hold = (sim, input, n) => { const ev = []; for (let i = 0; i < n; i++) { step(sim, [input]); ev.push(...drainEvents(sim)); } return ev; };\nconst walk = (sim, tool, pts, speed = 3, use = 1) => { // walk a held tool along points\n  const ev = [];\n  let [x, z] = pts[0];\n  for (let i = 1; i < pts.length; i++) {\n    const [tx, tz] = pts[i], d = Math.hypot(tx - x, tz - z), n = Math.max(1, Math.ceil((d / speed) * 60));\n    for (let k = 1; k <= n; k++) { step(sim, [{ x: x + ((tx - x) * k) / n, z: z + ((tz - z) * k) / n, tool, use }]); ev.push(...drainEvents(sim)); }\n    x = tx; z = tz;\n  }\n  return ev;\n};\nconst rates = (ev) => ev.filter((e) => e.t === 'rate').map((e) => e.r);\n\nexport async function run(ok) {\n  resetConfig();\n  /* Drain */\n  { const sim = createOp(mini([{ id: 'a', spawn: [{ k: 'pool', at: [0, 0], r: 1 }], until: { clear: ['pool'] } }, { id: 'b', until: { time: 99 } }])); drainEvents(sim);\n    const ev = hold(sim, { x: 0, z: 0, tool: 'drain', use: 1 }, 60);\n    ok('drain: clears a pool', sim.ents.length === 0, `left ${sim.ents.length}`);\n    ok('drain: rated CLEAN', rates(ev).includes('CLEAN'), rates(ev).join());\n    const sim2 = createOp(mini([{ id: 'a', spawn: [{ k: 'pool', at: [5, 2], r: 1 }], until: { clear: ['pool'] } }])); drainEvents(sim2);\n    const ev2 = hold(sim2, { x: -4, z: -2, tool: 'drain', use: 1 }, 40);\n    ok('drain: dry tissue bruises, SLOPPY', rates(ev2).includes('SLOPPY') && sim2.scars.some((s) => s.k === 'bruise')); }\n  /* Forceps */\n  { const sim = createOp(mini([{ id: 'a', spawn: [{ k: 'hook', at: [0, 0], dir: [0, -1], pull: 1.2, arc: 0 }], until: { clear: ['hook'] } }, { id: 'b', until: { time: 99 } }])); drainEvents(sim);\n    const ev = walk(sim, 'forceps', [[0, 0], [0, -1.3]], 1.5);\n    ok('forceps: pulled free', !sim.ents.length || sim.ents[0].free);\n    hold(sim, { x: 0, z: -1.3, tool: 'forceps', use: 0 }, 3);\n    const ev2 = drainEvents(sim); void ev; void ev2;\n    ok('forceps: flicks into the dish on release', sim.ents.length === 0, JSON.stringify(sim.ents.map((e) => e.k)));\n    const s2 = createOp(mini([{ id: 'a', spawn: [{ k: 'hook', at: [0, 0], dir: [0, -1], pull: 1.2, arc: 0 }], until: { clear: ['hook'] } }])); drainEvents(s2);\n    walk(s2, 'forceps', [[0, 0], [3, 0]], 6);\n    ok('forceps: off path tears (nick, mistake)', s2.mistakes >= 1 && s2.ents.some((e) => e.k === 'nick'));\n    const s3 = createOp(mini([{ id: 'a', spawn: [{ k: 'magnet', at: [0, 0], dir: [1, 0], pull: 2, maxSpeed: 2 }], until: { clear: ['magnet'] } }])); drainEvents(s3);\n    const ev3 = walk(s3, 'forceps', [[0, 0], [2, 0]], 8);\n    ok('magnet: too fast snaps back', rates(ev3).includes('SLOPPY') && s3.ents.some((e) => e.k === 'magnet' && e.s < 1.9));\n    const s4 = createOp(mini([{ id: 'a', spawn: [{ k: 'core', at: [0, 0], tether: true, autoFree: true, dir: [1, 0], pull: 2.5 }], until: { clear: ['core'] } }])); drainEvents(s4);\n    walk(s4, 'forceps', [[0, 0], [1, 0]], 3); hold(s4, { x: 1, z: 0, tool: 'forceps', use: 0 }, 2);\n    ok('tether: letting go early snaps back and lacerates', s4.ents.some((e) => e.k === 'laceration') && s4.mistakes === 1); }\n  /* Scalpel */\n  { const sim = createOp(mini([{ id: 'a', spawn: [{ k: 'incision', line: [[-2, 0], [2, 0]] }], until: { clear: ['incision'] } }])); drainEvents(sim);\n    const ev = walk(sim, 'scalpel', [[-2, 0], [2, 0]], 3);\n    ok('scalpel: clean trace rates CLEAN', rates(ev).includes('CLEAN'), rates(ev).join());\n    const s2 = createOp(mini([{ id: 'a', spawn: [{ k: 'incision', line: [[-2, 0], [2, 0]] }], until: { clear: ['incision'] } }])); drainEvents(s2);\n    walk(s2, 'scalpel', [[-2, 0], [-1, 0], [-1, 2]], 3);\n    ok('scalpel: cutting healthy tissue spawns a pool and a mistake', s2.ents.some((e) => e.k === 'pool') && s2.mistakes === 1);\n    ok('scalpel: letting go resumes from the last point', s2.ents.find((e) => e.k === 'incision').s > 0.5); }\n  /* Suture */\n  { const sim = createOp(mini([{ id: 'a', spawn: [{ k: 'laceration', a: [-1, 0], b: [1, 0] }], until: { clear: ['laceration'] } }, { id: 'b', until: { time: 99 } }])); drainEvents(sim);\n    const lac = sim.ents[0]; const pts = [[-1, 0.4]];\n    for (let i = 0; i < lac.slots; i++) { const x = -1 + (2 * (i + 0.5)) / lac.slots; pts.push([x, i % 2 ? 0.4 : -0.4]); }\n    const ev = walk(sim, 'suture', pts, 2.8);\n    ok('suture: zigzag ties every slot', !sim.ents.some((e) => e.k === 'laceration'), JSON.stringify(sim.ents.map((e) => e.tied)));\n    ok('suture: rhythm scores CLEAN', rates(ev).filter((r) => r === 'CLEAN').length >= 2, rates(ev).join());\n    const s2 = createOp(mini([{ id: 'a', spawn: [{ k: 'laceration', a: [-3, 0], b: [3, 0] }], until: { clear: ['laceration'] } }])); drainEvents(s2);\n    const ev2 = walk(s2, 'suture', [[2, 0.5], [2, -0.5], [2, 0.5]], 3);\n    ok('suture: crossing far from the slot is SLOPPY with no stitch', s2.ents[0].tied === 0 && rates(ev2).includes('SLOPPY'), `${s2.ents[0].tied} ${rates(ev2)}`); }\n  /* Laser */\n  { const sim = createOp(mini([{ id: 'a', spawn: [{ k: 'polyp', at: [0, 0] }], until: { clear: ['polyp'] } }, { id: 'b', until: { time: 99 } }])); drainEvents(sim);\n    hold(sim, { x: 0, z: 0, tool: 'laser', use: 1 }, 60);\n    ok('laser: burns a target', !sim.ents.length && sim.mistakes === 0);\n    const s2 = createOp(mini([{ id: 'a', spawn: [{ k: 'polyp', at: [5, 2] }], until: { clear: ['polyp'] } }])); drainEvents(s2);\n    hold(s2, { x: -3, z: 0, tool: 'laser', use: 1 }, 40);\n    ok('laser: healthy tissue burns (mistake)', s2.mistakes === 1 && s2.scars.some((s) => s.k === 'burn')); }\n  /* Scanner, gel, syringe */\n  { const sim = createOp(mini([{ id: 'a', spawn: [{ k: 'polyp', at: [1, 0], scan: true }, { k: 'polyp', at: [5, 0], scan: true }], until: { clear: ['polyp'] } }])); drainEvents(sim);\n    hold(sim, { x: 0, z: 0, tool: 'scanner', use: 1 }, 3);\n    ok('scanner: reveals within reach only', sim.ents[0].seen && !sim.ents[1].seen); }\n  { const sim = createOp(mini([{ id: 'a', spawn: [{ k: 'mask', rect: [0, 0, 1.2, 1.2] }], until: { clear: ['mask'] } }, { id: 'b', until: { time: 99 } }])); drainEvents(sim);\n    hold(sim, { x: 0, z: 0, tool: 'gel', use: 1 }, 10);\n    ok('gel: paints a mask to done', !sim.ents.some((e) => e.k === 'mask'));\n    const s2 = createOp(mini([{ id: 'a', spawn: [{ k: 'nick', at: [0, 0] }, { k: 'polyp', at: [5, 2] }], until: { clear: ['polyp'] } }])); drainEvents(s2);\n    hold(s2, { x: 0, z: 0, tool: 'gel', use: 1 }, 70);\n    ok('gel: heals a nick after a second', !s2.ents.some((e) => e.k === 'nick')); }\n  { const sim = createOp(mini([{ id: 'a', until: { time: 99 } }], { port: [0, 0], vitals: { start: 40, drain: 0 } })); drainEvents(sim);\n    hold(sim, { x: 0, z: 0, tool: 'syringe', use: 1 }, 30); hold(sim, { x: 0, z: 0, tool: 'syringe', use: 0 }, 2);\n    ok('syringe: dose raises vitals', Math.round(sim.tables[0].vitals) === 58 && sim.doses === 2, String(sim.tables[0].vitals));\n    hold(sim, { x: 5, z: 2, tool: 'syringe', use: 1 }, 30); const ev = hold(sim, { x: 5, z: 2, tool: 'syringe', use: 0 }, 2);\n    ok('syringe: outside the ring wastes a dose, SLOPPY', sim.doses === 1 && rates(ev).includes('SLOPPY')); }\n  /* Bone mend */\n  { const sim = createOp(mini([{ id: 'a', spawn: [{ k: 'fragment', at: [0, 0], rot: 40, goal: [2, 0, 0] }], until: { clear: ['fragment'] } }, { id: 'b', until: { time: 99 } }])); drainEvents(sim);\n    walk(sim, 'forceps', [[0, 0], [2, 0]], 3); hold(sim, { x: 2, z: 0, tool: 'forceps', use: 0 }, 2);\n    ok('bone mend: wrong angle will not seat', sim.ents.some((e) => e.k === 'fragment'));\n    walk(sim, 'forceps', [[2, 0], [2.01, 0]], 3);\n    for (let i = 0; i < 40 && Math.abs(sim.ents[0].rot) > 2; i++) { step(sim, [{ x: 2, z: 0, tool: 'forceps', use: 1, rot: -1 }]); }\n    hold(sim, { x: 2, z: 0, tool: 'forceps', use: 0 }, 2);\n    ok('bone mend: turned, it seats', !sim.ents.some((e) => e.k === 'fragment'), JSON.stringify(sim.ents)); }\n  /* Clock and fail paths */\n  { const sim = createOp(mini([{ id: 'a', until: { time: 999 } }], { time: 1 }));\n    for (let i = 0; i < 120; i++) step(sim, []);\n    ok('clock: reaching 0 fails', sim.phase === 'lost' && sim.loseWhy === 'clock');\n    const s2 = createOp(mini([{ id: 'a', spawn: [{ k: 'polyp', at: [5, 2] }], until: { clear: ['polyp'] } }])); drainEvents(s2);\n    for (let i = 0; i < 400 && s2.phase === 'play'; i++) step(s2, [{ x: -3, z: 0, tool: 'laser', use: 1 }]);\n    ok('mistakes: five fail the op', s2.phase === 'lost' && s2.loseWhy === 'mistakes', `${s2.phase} ${s2.mistakes}`); }\n  /* Code Blue */\n  { const sim = createOp(mini([{ id: 'a', until: { time: 999 } }], { vitals: { start: 1, drain: 2 } }));\n    for (let i = 0; i < 120 && sim.phase === 'play'; i++) step(sim, []);\n    ok('code blue: starts at 0 vitals', sim.phase === 'codeblue');\n    const shock = (good) => { let guard = 0; while (sim.codeBlue && guard++ < 300) { const cb = sim.codeBlue; if (cb.cool > 0 && !cb.charging) { step(sim, [{}]); continue; } const inZone = Math.abs(cb.needle - cb.centre) < cb.zone / 2 - 0.01; if (cb.charging && (good ? inZone : cb.needle < 0.1 && cb.charge > 0.02)) { step(sim, [{}]); return; } step(sim, [{ padL: true, padR: true }]); } };\n    const t0 = sim.codeBlue.t; shock(false);\n    ok('code blue: a bad shock costs 3 s', sim.codeBlue && t0 - sim.codeBlue.t > 3, String(t0 - sim.codeBlue?.t));\n    shock(true); shock(true);\n    ok('code blue: two good shocks bring vitals back to 25', sim.phase === 'play' && sim.tables[0].vitals >= 24, `${sim.phase} ${sim.tables[0].vitals}`);\n    for (let i = 0; i < 1000 && sim.phase === 'play'; i++) step(sim, []);\n    ok('code blue: Resident gets one save, second time is the end', sim.phase === 'lost', sim.phase); }\n  { const sim = createOp(mini([{ id: 'a', until: { time: 999 } }], { vitals: { start: 50, drain: 0 } })); dev.codeBlue(sim);\n    for (let i = 0; i < 800 && sim.phase === 'codeblue'; i++) step(sim, [{}]);\n    ok('code blue: running out of time loses the patient', sim.phase === 'lost' && sim.loseWhy === 'codeblue'); }\n  /* The Quiet */\n  { const sim = createOp(mini([{ id: 'a', until: { time: 999 } }], { gifts: ['quiet'], composure: 100, vitals: { start: 50, drain: 2 } })); drainEvents(sim);\n    const c0 = sim.clock;\n    hold(sim, { gift: true }, 60);\n    ok('quiet: the world runs at 1/4', Math.abs(c0 - sim.clock - 0.25) < 0.02, String(c0 - sim.clock));\n    ok('quiet: vitals stop falling', sim.tables[0].vitals === 50, String(sim.tables[0].vitals));\n    ok('quiet: drains composure 18 per second', Math.abs(sim.composure - 82) < 0.5, String(sim.composure));\n    const s2 = createOp(mini([{ id: 'a', until: { time: 999 } }], { gifts: ['quiet'], composure: 10 })); step(s2, [{ gift: true }]);\n    ok('quiet: needs 20 composure', !s2.quiet); }\n  /* The Second Look: exact restore */\n  { const def = mini([{ id: 'a', spawn: [{ k: 'pool', at: [0, 0], r: 3 }, { k: 'hook', at: [4, 0], dir: [0, -1], pull: 1 }], until: { clear: ['pool', 'hook'] } }], { surgeon: 'sabine', gifts: ['look'], composure: 100, vitals: { start: 80, drain: 0.5 } });\n    const sim = createOp(def, { seed: 7 }); drainEvents(sim);\n    const movie = [];\n    for (let i = 0; i < 400; i++) { step(sim, [{ x: 0, z: 0, tool: 'drain', use: 1 }]); if (sim.ringN === 0) movie.push(cloneState(sim)); drainEvents(sim); }\n    const backTo = sim.ring[sim.ring.length - 40];\n    const want = { r: backTo.ents[0].r, clock: backTo.clock, vit: backTo.tables[0].vitals, stage: backTo.stage };\n    step(sim, [{ x: 0, z: 0, tool: 'drain', use: 0, gift: true }]);\n    ok('second look: entities, vitals, clock restored exactly', Math.abs(sim.ents[0].r - want.r) < 0.05 && Math.abs(sim.clock - want.clock) < 0.05 && Math.abs(sim.tables[0].vitals - want.vit) < 0.1, JSON.stringify({ now: [sim.ents[0].r, sim.clock, sim.tables[0].vitals], want }));\n    ok('second look: costs composure, leaves a ghost, counts', sim.composure < 45 && sim.ghost && sim.looks === 1);\n    const before = createOp(def, { seed: 1, seats: 1 }); before.score = 1000; before.clock = 0; const f = results(before, def).total;\n    before.looks = 1; const g = results(before, def).total;\n    ok('second look: 5% off the final score', Math.abs(g / f - 0.95) < 0.01, `${f} ${g}`); }\n  /* Scoring */\n  ok('rank: bounds', rankOf(85, 100) === 'S' && rankOf(84, 100) === 'A' && rankOf(70, 100) === 'A' && rankOf(69, 100) === 'B' && rankOf(50, 100) === 'B' && rankOf(49, 100) === 'C');\n  ok('rank: caps', capRank('S', 'A') === 'A' && capRank('C', 'B') === 'C');\n  { const def = OPS.op1, s = createOp(def); s.score = 999999; s.unscriptedBlue = true; const r = results(s, def); ok('rank: unscripted Code Blue caps at A', r.rank === 'A' && !r.pristine, r.rank); }\n  /* Sliders */\n  { config.vitalsDrain = 3; config.maxMistakes = 0; const s = createOp(OPS.op1, { cfg: config }); ok('sliders: live config reaches a sim', s.cfg.vitalsDrain === 3); resetConfig(); ok('sliders: reset restores defaults', Object.keys(defaults).every((k) => config[k] === defaults[k])); ok('sliders: every slider has a default inside its range', SLIDERS.every(([k, , a, b]) => defaults[k] >= a && defaults[k] <= b), SLIDERS.filter(([k, , a, b]) => !(defaults[k] >= a && defaults[k] <= b)).map((s) => s[0]).join()); }\n  /* Every op: idle fails, bot clears, determinism, retry */\n  for (const id of [...CAMPAIGN_OPS, ...SESSION_LIST]) {\n    const idle = play(id, 0);\n    ok(`${id}: idle fails`, idle.sim.phase === 'lost', idle.sim.phase);\n    const a = play(id, 0.7, 11);\n    ok(`${id}: bot 0.7 clears`, a.sim.phase === 'won', `${a.sim.phase} ${a.sim.loseWhy} stage ${a.sim.stage}`);\n    const b = play(id, 0.7, 11);\n    ok(`${id}: determinism`, hashSim(a.sim) === hashSim(b.sim));\n    const full = play(id, 1, 3);\n    ok(`${id}: bot 1.0 clears`, full.sim.phase === 'won', `${full.sim.phase} ${full.sim.loseWhy} stage ${full.sim.stage}`);\n    // Peak network sizes\n    const peak = peakSizes(id);\n    ok(`${id}: snapshot under 1100 bytes`, peak.snap <= 1100, String(peak.snap));\n    ok(`${id}: keyframe under 16 KB`, peak.key <= 16000, String(peak.key));\n    // Retry\n    const def = OPS[id];\n    const r = createOp(def, { seats: def.seats ?? 1 });\n    ok(`${id}: a stage checkpoint exists`, !!r.checkpoint);\n  }\n  /* Retry mid-op keeps the stage */\n  { const def = OPS.op1, s = createOp(def); dev.completeStage(s); dev.completeStage(s); const cp = s.checkpoint; ok('retry: checkpoint lands on the current stage', cp && cp.stage === 2, String(cp?.stage)); }\n  /* Codec round trip */\n  { const def = OPS.op5, s = createOp(def); const bot = createBot(0, 0.8); for (let i = 0; i < 1800 && s.phase === 'play'; i++) { step(s, [botInput(s, bot)]); drainEvents(s); }\n    const c = createOp(def); decodeKey(encodeKey(s), c); ok('codec: keyframe restores the state the view reads', c.ents.length === s.ents.length && Math.abs(c.clock - s.clock) < 0.1 && c.score === s.score);\n    applySnap(c, JSON.parse(JSON.stringify(encodeSnap(s, 1))), -1); ok('codec: a snapshot applies', c.seats[0].nx != null && c.score === s.score); }\n  /* Whole-game scripted playthrough */\n  { const save = DEFAULT_SAVE(); let i = 0, scenes = 0, ops = 0, bad = '';\n    while (i < CAMPAIGN.length) {\n      const e = CAMPAIGN[i];\n      if (e.scene) { if (!SCENES[e.scene]?.beats?.length) bad = `missing ${e.scene}`; scenes++; }\n      else if (e.op) { const { sim, res } = play(e.op, 0.8, 21); if (sim.phase !== 'won') bad = `${e.op} lost: ${sim.loseWhy}@${sim.stage}`; recordOp(save, e.op, res); ops++; }\n      save.next = ++i;\n      const reloaded = JSON.parse(JSON.stringify(save)); Object.assign(save, reloaded);\n    }\n    ok('playthrough: every scene and op to credits', !bad && scenes === 11 && ops === 10 && save.next === CAMPAIGN.length, bad || `${scenes} ${ops}`);\n    ok('playthrough: every op recorded and ranked', CAMPAIGN_OPS.every((id) => save.cleared[id] && save.ranks[id])); }\n  void defOf;\n}\nfunction peakSizes(id) {\n  const def = OPS[id], seats = Math.max(def.seats ?? 1, 2), s = createOp(def, { seats, seed: 9, gifts: ['quiet', 'look'] });\n  const bots = s.seats.map((_, i) => createBot(i, 0.4));\n  let snap = 0, key = 0;\n  for (let i = 0; i < 7200 && s.phase !== 'won' && s.phase !== 'lost'; i++) {\n    step(s, bots.map((b) => botInput(s, b))); drainEvents(s);\n    if (i % 60 === 0) { snap = Math.max(snap, JSON.stringify(encodeSnap(s, i)).length); key = Math.max(key, encodeKey(s).length); }\n  }\n  return { snap, key };\n}\nEOF\ncat > tests/content.test.mjs <<'EOF'\n// Content lint: names, text fit, the font's character set, tokens, and no placeholders.\nimport { readFileSync, readdirSync, statSync } from 'node:fs';\nimport { execFileSync } from 'node:child_process';\nimport { OPS } from '../src/content/ops/index.js';\nimport { SCENES } from '../src/content/scenes/index.js';\nimport { CAST } from '../src/content/cast.js';\nimport { SETS } from '../src/content/sets.js';\nimport { LINES } from '../src/content/lines.js';\nimport { SONGS } from '../src/content/songs.js';\nimport { SFX_DEFS } from '../src/content/sfx.js';\nimport { SOURCE_INFO, TESTING_FEEDBACK, ENGINE_FEEDBACK, PROMPT_FEEDBACK } from '../src/content/about.js';\nimport { TOOLS } from '../src/sim/tools.js';\nimport { KINDS } from '../src/sim/entities.js';\nimport { renderSyllable } from '../src/audio/voice.js';\nimport { parseSong, renderSound } from '../pixel-engine.js';\n\nconst FONT = /^[A-Za-z0-9 .,:;!?\\-+%/()[\\]'\"#&*=<>{}]*$/;\nconst TOKENS = new Set(['use', 'back', 'confirm', 'gift', 'steady', 'quick', 'drop', 'rotate', 'table', 'tag', 'paddles', 'squeeze', 'more', 'pause', 'last', 'remind', 'move', 'tabl', 'tabr', 'skipScene']);\nconst FORBIDDEN = /derek stiles|angie thompson|naomi kimishima|nozomi weaver|hope hospital|caduceus|delphi|\\bguilt\\b|kyriaki|deuteros|triti|tetarti|pempti|paraskevi|savato|healing touch/i;\nconst lineFit = (t) => { const plain = t.replace(/\\*/g, '').replace(/\\{[^}]+\\}/g, 'XX'); const W = 330 / 6; let lines = 1, cur = 0; for (const w of plain.split(' ')) { if (cur + w.length > W) { lines++; cur = 0; } cur += w.length + 1; } return lines; };\n\nfunction collectStrings(obj, out = [], key = '') {\n  if (typeof obj === 'string') out.push([key, obj]);\n  else if (Array.isArray(obj)) obj.forEach((o) => collectStrings(o, out, key));\n  else if (obj && typeof obj === 'object') for (const k of Object.keys(obj)) collectStrings(obj[k], out, k);\n  return out;\n}\nfunction walk(dir, out = []) { for (const f of readdirSync(dir)) { const p = `${dir}/${f}`; if (statSync(p).isDirectory()) walk(p, out); else if (p.endsWith('.js')) out.push(p); } return out; }\n\nexport async function run(ok) {\n  const say = [];\n  for (const def of Object.values(OPS)) {\n    const check = (c) => { if (!c) return; for (const k of Array.isArray(c) ? c : [c]) { if (Array.isArray(k.say)) say.push([def.id, k.say[0], k.say[1]]); if (k.prompt) say.push([def.id, null, k.prompt]); } };\n    for (const st of def.stages) {\n      if (Array.isArray(st.say)) say.push([def.id, st.say[0], st.say[1]]);\n      check(st.begin); check(st.then); check(st.timed);\n      for (const c of Object.values(st.on?.vitalsBelow ?? {})) check(c);\n      for (const d of st.spawn ?? []) { ok(`${def.id}: known kind ${d.k}`, !!KINDS[d.k]); check(d.then); }\n    }\n    ok(`${def.id}: tools all real`, def.tools.every((t) => TOOLS.includes(t)));\n    ok(`${def.id}: patient chart is complete`, !!(def.patient?.name && def.patient.objective && def.patient.hook && ['S', 'A', 'B', 'C'].every((r) => def.patient.followUp?.[r])));\n    ok(`${def.id}: has a par`, def.par > 0);\n  }\n  for (const [k, pool] of Object.entries(LINES)) for (const t of pool) say.push([k, k.split('.')[0] === 'false' || k.split('.')[0] === 'mimic' ? 'reyes' : k.split('.')[0], t]);\n  for (const sc of Object.values(SCENES)) {\n    ok(`${sc.id}: set exists`, !!SETS[sc.set]);\n    ok(`${sc.id}: 8 to 16 beats`, sc.beats.length >= 8 && sc.beats.length <= 16, String(sc.beats.length));\n    ok(`${sc.id}: music exists`, !!SONGS[sc.music]);\n    for (const b of sc.beats) say.push([sc.id, b.who, b.say]);\n    for (const c of sc.cast) ok(`${sc.id}: cast ${c}`, !!CAST[c]);\n  }\n  let bad = [];\n  for (const [src, who, text] of say) {\n    if (who && !CAST[who]) bad.push(`${src}: who ${who}`);\n    if (!FONT.test(text)) bad.push(`${src}: char in \"${text}\"`);\n    if (lineFit(text) > 2) bad.push(`${src}: too long \"${text}\"`);\n    for (const m of text.matchAll(/\\{([^}]+)\\}/g)) if (!TOKENS.has(m[1]) && !/^tool:[1-8]$/.test(m[1])) bad.push(`${src}: token ${m[1]}`);\n    if ((text.match(/\\*/g) ?? []).length % 2) bad.push(`${src}: unbalanced * in \"${text}\"`);\n  }\n  ok('text: speakers, characters, fit and tokens', !bad.length, bad.slice(0, 12).join(' | '));\n  const allTools = new Set(Object.values(OPS).flatMap((d) => d.stages.flatMap((s) => (s.spawn ?? []).map((e) => KINDS[e.k].tool))));\n  ok('every instrument is used by some op', ['scalpel', 'forceps', 'suture', 'drain', 'gel', 'laser'].every((t) => allTools.has(t)));\n  // No placeholders; no forbidden names.\n  const files = [...walk('src'), 'game.js'];\n  const hits = [], fb = [];\n  for (const f of files) {\n    const text = readFileSync(f, 'utf8');\n    if (/\\b(TODO|FIXME|XXX|placeholder|lorem)\\b/i.test(text) && !f.includes('content.test')) hits.push(f);\n    if (FORBIDDEN.test(text)) fb.push(`${f}: ${text.match(FORBIDDEN)[0]}`);\n  }\n  ok('no TODOs or placeholders', !hits.length, hits.join());\n  ok('no forbidden source names', !fb.length, fb.join());\n  // About has every field.\n  ok('about: every field', ['DATE', 'SOURCE', 'PLAN', 'GENRE AND PERSPECTIVE', 'TECH', 'ART DIRECTION', 'ANIMATION', 'AUDIO', 'ONLINE', 'TESTING', 'RESEARCH', 'ENVIRONMENT', 'MODEL', 'USAGE'].every((k) => SOURCE_INFO.some(([a, b]) => a === k && b)));\n  ok('about: feedback answers', TESTING_FEEDBACK.length === 4 && ENGINE_FEEDBACK.length === 6 && PROMPT_FEEDBACK.length === 4, `${TESTING_FEEDBACK.length} ${ENGINE_FEEDBACK.length} ${PROMPT_FEEDBACK.length}`);\n  // Sound: non-silent and finite.\n  for (const [k, def] of Object.entries(SFX_DEFS)) {\n    const s = renderSound(def, 8000);\n    const peak = s.reduce((m, v) => Math.max(m, Math.abs(v)), 0);\n    if (!(peak > 0.001) || s.some((v) => !Number.isFinite(v))) ok(`sfx ${k}`, false, `peak ${peak}`); else ok(`sfx ${k}`, true);\n  }\n  for (let t = 0; t < 3; t++) { const s = renderSyllable(t, 'a', 'b'); const peak = s.reduce((m, v) => Math.max(m, Math.abs(v)), 0); ok(`voice timbre ${t} renders`, peak > 0.1 && s.every(Number.isFinite)); }\n  for (const [k, song] of Object.entries(SONGS)) { let e = null; try { parseSong(song); } catch (err) { e = err.message; } ok(`song ${k} parses`, !e, e); }\n  // Each music id referenced exists.\n  const musics = Object.values(OPS).flatMap((d) => [d.music, ...d.stages.map((s) => s.music)].filter(Boolean));\n  ok('music ids exist', musics.every((m) => m === 'silence' || SONGS[m]), musics.filter((m) => m !== 'silence' && !SONGS[m]).join());\n  // Kit's model sheet check.\n  let sheet = 0;\n  try { execFileSync('node', ['check.mjs', '--sheets', 'src/content/models/index.js'], { stdio: 'pipe', timeout: 240000 }); } catch (e) { sheet = e.status ?? 1; }\n  ok('check.mjs --sheets has no problems', sheet === 0, `exit ${sheet}`);\n}\nEOF\ntimeout 400 node tests/run.mjs sim 2>&1 | tail -40","description":"Add strain creatures, visual fixes, sim tests; run sim tests","timeout":420000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3010,"cache_read_input_tokens":400583,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3010},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9464247a-cdba-4289-905c-cd8b34e5d270","uuid":"92413345-910d-46de-9272-b160167e4701","timestamp":"2026-11-05T17:08:17.852Z","request_id":"req_011Cgk9QEwiurk9h6vrQcw7x","wire_tool_inputs":{"toolu_01C4hDp4yzuicbizQpu4kVbd":{"command":"cd .. && cat > src/view/strains.js <<'EOF'\n// The strains as creatures on the actors layer: crown, weeper body, halo. Their working parts are sim entities.\nimport { LegStepper, PALETTE, SpringChain, setLookLayer, THREE, toonMaterial, twoBoneIK } from '../../pixel-engine.js';\nimport { PROP_DEFS, CATALOG } from '../content/models/index.js';\nimport { buildModel } from '../../pixel-engine.js';\n\nconst { BoxGeometry, ConeGeometry, Group, Mesh, SphereGeometry, TorusGeometry, CylinderGeometry, Vector3 } = THREE;\nconst mat = (c, rim) => toonMaterial(c, rim ? { rim } : {});\nconst actor = (o) => { setLookLayer(o, 'actors'); o.traverse((m) => { if (m.isMesh) m.castShadow = true; }); return o; };\n\nclass Tendrils {\n  constructor(root, n, color, len = 0.3, segs = 6, thick = 0.14) {\n    this.items = Array.from({ length: n }, (_, i) => {\n      const a = (i / n) * Math.PI * 2;\n      const chain = new SpringChain({ segments: segs, length: len, stiffness: 5, gravity: 2.5, rest: [Math.cos(a), -0.15, Math.sin(a)], keep: 0.92 });\n      const bits = Array.from({ length: segs }, (_, k) => { const b = new Mesh(new BoxGeometry(thick - k * 0.012, thick - k * 0.012, len + 0.05), mat(color)); actor(b); root.add(b); return b; });\n      return { chain, bits, a };\n    });\n  }\n  update(dt, x, y, z, ground, wig = 0) {\n    for (const it of this.items) {\n      it.chain.update(dt, [x + Math.cos(it.a) * 0.3, y, z + Math.sin(it.a) * 0.3 + Math.sin(wig + it.a * 3) * 0.05], [[1, 0, 0], [0, 1, 0], [0, 0, 1]]);\n      it.bits.forEach((b, i) => {\n        const p = it.chain.points[i + 1], q = it.chain.points[i];\n        const gy = ground(p[0], p[2]) + 0.08;\n        if (p[1] < gy) p[1] = gy;\n        b.position.set((p[0] + q[0]) / 2, Math.max(gy, (p[1] + q[1]) / 2), (p[2] + q[2]) / 2);\n        b.lookAt(p[0], p[1], p[2]);\n      });\n    }\n  }\n  setVisible(v) { for (const it of this.items) for (const b of it.bits) b.visible = v; }\n  remove(root) { for (const it of this.items) for (const b of it.bits) root.remove(b); }\n}\n\nexport class StrainViews {\n  constructor(ctx, field) { this.ctx = ctx; this.field = field; this.root = new Group(); ctx.scene.add(this.root); this.items = new Map(); this.dying = []; this.eyes = new Map(); this.t = 0; }\n  make(e) {\n    const g = new Group(); this.root.add(g);\n    const o = { g, e, parts: [] };\n    if (e.type === 'irae') {\n      o.plateMeshes = (e.ring ?? []).map((_, i) => { const m = buildModel(PROP_DEFS.plate, { catalog: CATALOG }).object.clone(true); actor(m); m.scale.setScalar(1.3); this.root.add(m); m.userData.i = i; return m; });\n      const orb = new Mesh(new SphereGeometry(0.7, 12, 8), mat(PALETTE.plum, 0xff3a3a));\n      actor(orb); orb.position.y = 0.3; g.add(orb); o.orb = orb;\n      const glow = new Mesh(new SphereGeometry(0.28, 8, 6), new THREE.MeshBasicMaterial({ color: PALETTE.red })); glow.position.set(0, 0.86, 0.1); g.add(glow); o.glow = glow;\n      o.tendrils = new Tendrils(this.root, 7, PALETTE.red, 0.34, 6, 0.16);\n    } else if (e.type === 'lacrimosa') {\n      const body = new Mesh(new SphereGeometry(0.9, 10, 7), mat(PALETTE.plum, 0x8ad0ff)); body.scale.y = 0.45; actor(body); body.position.y = 0.15; g.add(body); o.body = body;\n      o.legs = new Map();\n    } else if (e.type === 'miserere') {\n      const m = buildModel(PROP_DEFS.coreMiserere, { catalog: CATALOG }).object.clone(true); actor(m); m.scale.setScalar(1.5); g.add(m); o.halo = m;\n      o.tendrils = new Tendrils(this.root, 5, PALETTE.sand, 0.3, 5, 0.1);\n    } else if (e.type === 'introit') {\n      o.tendrils = new Tendrils(this.root, 4, PALETTE.plum, 0.3, 4, 0.15);\n      o.tendrils.setVisible(false);\n    }\n    return o;\n  }\n  update(state, dt) {\n    this.t += dt;\n    const f = this.field, ground = (x, z) => f.surface(x, z);\n    const seen = new Set();\n    for (const e of state.ents) {\n      if (e.k !== 'strain' || e.x == null || !e.type || e.type === 'pileup') continue;\n      seen.add(e.id);\n      let o = this.items.get(e.id);\n      if (!o) { o = this.make(e); this.items.set(e.id, o); }\n      o.e = e;\n      const y = f.surface(e.x, e.z);\n      o.g.position.set(e.x, y, e.z);\n      if (e.type === 'irae') {\n        const beat = f.beat;\n        o.plateMeshes?.forEach((m, i) => {\n          const r = e.ring?.[i];\n          if (!r) return;\n          const ent = state.ents.find((q) => q.k === 'plate' && q.ringIx === i);\n          m.visible = r[2] === 1 && !ent;\n          m.position.set(r[0], f.surface(r[0], r[1]) + 0.05 + beat * 0.1, r[1]);\n          m.rotation.y = Math.atan2(r[0] - e.x, r[1] - e.z) + Math.PI;\n          m.scale.setScalar(1.3 * (1 + beat * 0.1));\n        });\n        const hasEye = state.ents.some((q) => q.k === 'eye' && q.owner === e.id) || state.ents.some((q) => q.k === 'eye' && q.look === 'wrath');\n        o.orb.visible = !hasEye; o.glow.visible = !hasEye;\n        o.orb.scale.setScalar(1 + beat * 0.12);\n        o.tendrils.update(dt, e.x, y + 0.3, e.z, ground, this.t * 3);\n      } else if (e.type === 'lacrimosa') {\n        o.body.rotation.y += dt * 0.3;\n        const eyes = state.ents.filter((q) => q.k === 'eye' && q.look === 'weeper');\n        for (const q of eyes) this.eyeLegs(o, q, f, dt);\n        for (const [id, L] of o.legs) if (!eyes.some((q) => q.id === id)) { L.bits.forEach((b) => this.root.remove(b)); o.legs.delete(id); }\n      } else if (e.type === 'miserere') {\n        const hover = e.mode === 'pull' ? 0 : 0.5 + Math.sin(this.t * 2) * 0.1;\n        o.g.position.y = y + hover;\n        o.halo.rotation.y += dt * 0.8;\n        o.halo.visible = e.mode !== 'pull';\n        o.tendrils.setVisible(e.mode !== 'pull');\n        o.tendrils.update(dt, e.x, y + hover + 0.3, e.z, ground, this.t * 2);\n      } else if (e.type === 'introit') {\n        const up = e.mode === 'knock' || e.mode === 'exposed';\n        o.tendrils.setVisible(up);\n        if (up) o.tendrils.update(dt, e.x, y + 0.5, e.z, ground, this.t * 8);\n      }\n    }\n    for (const [id, o] of this.items) {\n      if (seen.has(id)) continue;\n      this.dispose(o);\n      this.items.delete(id);\n    }\n    for (let i = this.dying.length - 1; i >= 0; i--) {\n      const d = this.dying[i];\n      d.t += dt / 1.1;\n      d.mats.forEach((m) => { m.dissolve = d.t; });\n      d.obj.position.y += dt * 0.3;\n      if (d.t >= 1) { this.root.remove(d.obj); this.dying.splice(i, 1); }\n    }\n  }\n  eyeLegs(o, eye, f, dt) {\n    if (!eye.crawl) return;\n    let L = o.legs.get(eye.id);\n    if (!L) {\n      const legs = [[-0.7, 0.5], [0.7, 0.5], [-0.7, -0.5], [0.7, -0.5]];\n      const stepper = new LegStepper({ legs: legs.map((rest, i) => ({ rest, partners: [(i + 1) % 4] })), lift: 0.3, threshold: 0.35 });\n      const bits = [];\n      for (let i = 0; i < 8; i++) { const b = new Mesh(new BoxGeometry(0.1, 0.1, 0.5), mat(PALETTE.plum)); actor(b); this.root.add(b); bits.push(b); }\n      L = { stepper, bits, last: [eye.x, eye.z] };\n      o.legs.set(eye.id, L);\n    }\n    const body = [eye.x, f.surface(eye.x, eye.z) + 0.5, eye.z];\n    const v = [(eye.x - L.last[0]) / Math.max(dt, 1e-3), 0, (eye.z - L.last[1]) / Math.max(dt, 1e-3)];\n    L.last = [eye.x, eye.z];\n    L.stepper.update(dt, body, 0, v, (x, z) => f.surface(x, z));\n    L.stepper.feet.forEach((foot, i) => {\n      const hip = [body[0] + (i % 2 ? 0.35 : -0.35), body[1], body[2] + (i < 2 ? 0.25 : -0.25)];\n      const knee = twoBoneIK(hip, foot.at, 0.5, 0.5, [hip[0] * 1.2, hip[1] + 1, hip[2]]);\n      const seg = (b, a, c) => { b.position.set((a[0] + c[0]) / 2, (a[1] + c[1]) / 2, (a[2] + c[2]) / 2); b.lookAt(c[0], c[1], c[2]); };\n      seg(L.bits[i * 2], hip, knee); seg(L.bits[i * 2 + 1], knee, foot.at);\n    });\n  }\n  /** Pixel dissolve when it dies. */\n  deathAt(e) {\n    const o = [...this.items.values()].find((q) => q.e.type === e.type);\n    const shape = e.type === 'miserere' ? new SphereGeometry(0.9, 10, 7) : e.type === 'lacrimosa' ? new SphereGeometry(0.9, 10, 7) : new SphereGeometry(0.8, 10, 7);\n    const m = toonMaterial(e.type === 'miserere' ? PALETTE.sand : PALETTE.plum, { dissolve: true, rim: e.type === 'miserere' ? 0xffffff : 0xff4060 }).clone();\n    m.dissolve = 0;\n    const mesh = new Mesh(shape, m);\n    actor(mesh);\n    const x = e.x ?? o?.e.x ?? 0, z = e.z ?? o?.e.z ?? 0;\n    mesh.position.set(x, this.field.surface(x, z) + 0.5, z);\n    this.root.add(mesh);\n    this.dying.push({ obj: mesh, mats: [m], t: 0 });\n  }\n  dispose(o) {\n    this.root.remove(o.g);\n    o.plateMeshes?.forEach((m) => this.root.remove(m));\n    o.tendrils?.remove(this.root);\n    if (o.legs) for (const L of o.legs.values()) L.bits.forEach((b) => this.root.remove(b));\n  }\n}\nvoid ConeGeometry; void TorusGeometry; void CylinderGeometry; void Vector3;\nEOF\npython3 - <<'E'\np='src/stages/operation.js'; s=open(p).read()\ns=s.replace(\"import { HandView } from '../view/hands.js';\",\"import { HandView } from '../view/hands.js';\\nimport { StrainViews } from '../view/strains.js';\")\ns=s.replace(\"    this.hud = new OpHud(app, ctx);\\n\",\"    this.strains = new StrainViews(ctx, this.field);\\n    this.hud = new OpHud(app, ctx);\\n\")\ns=s.replace(\"    this.field.update(sim, dt);\\n    // Draw hands\",\"    this.field.update(sim, dt);\\n    this.strains.update(sim, dt);\\n    // Draw hands\")\ns=s.replace(\"case 'strainDead': this.fx.strainDead(e);\",\"case 'strainDead': this.fx.strainDead(e); this.strains.deathAt(e);\")\ns=s.replace(\"engine.sun.intensity = 1; engine.ambient\",\"engine.sun.intensity = 0.9; engine.ambient\")\ns=s.replace(\"this.opts.net?.drawOverlay?.(ctx, sim);\",\"this.opts.net?.drawOverlay?.(ctx, sim);\")\nopen(p,'w').write(s)\np='src/view/field.js'; s=open(p).read()\ns=s.replace(\"const light = 0.25 + 0.75 * m + (fbm(x * 0.9, z * 0.9) - 0.5) * 0.9 + tilt;\",\"const light = 0.14 + 0.46 * m + (fbm(x * 0.9, z * 0.9) - 0.5) * 1.5 + (fbm(x * 2.6 + 3, z * 2.6) - 0.5) * 0.45 + tilt + a.height(x, z) * 0.1;\")\nopen(p,'w').write(s)\np='src/ui/hud.js'; s=open(p).read()\ns=s.replace(\"\"\"    hud.rect(0, sy, W, stripH, 0x0d0b14);\n    hud.rect(0, sy, W, 1, 0x2a3142);\"\"\",\"\"\"    hud.rect(33, sy, W - 33, stripH, 0x0d0b14);\n    hud.rect(0, sy, 2, stripH, 0x0d0b14); hud.rect(0, H - 2, 33, 2, 0x0d0b14);\n    hud.rect(0, sy, W, 1, 0x2a3142);\"\"\")\ns=s.replace(\"\"\"    // bust frame\n    hud.rect(2, sy + 2, 30, 29, 0x1a1f2b);\n\"\"\",\"\"\"    // bust frame: the 3D face shows through it\n    if (!comm) hud.rect(2, sy + 1, 31, 30, 0x1a1f2b);\n\"\"\")\ns=s.replace(\"\"\"    if (this.wheelT > 0) {\n      const mid = hud.measure(seat.tool.toUpperCase()).width;\n      hud.text(Math.round(W - size - mid - 8), H - size - 4, seat.tool.toUpperCase(), { color: 0xffd24d });\n    }\"\"\",\"\"\"    if (this.wheelT > 0) { // the big wheel, while picking\n      const bx = Math.round(W / 2), by = Math.round(H / 2 - 12), BR = 50;\n      TOOLS.forEach((id, i) => {\n        const a = -Math.PI / 2 + (i / 8) * Math.PI * 2, x = Math.round(bx + Math.cos(a) * BR), y = Math.round(by + Math.sin(a) * BR * 0.85);\n        const on = id === seat.tool, avail = sim.tools.includes(id);\n        hud.rect(x - 9, y - 8, 18, 16, on ? 0xffd24d : 0x0d0b14);\n        const ic2 = TOOL_ICONS[id];\n        if (ic2 && avail) hud.sprite(x - 6, y - 5, ic2.rows, ic2.colors);\n      });\n      const name = seat.tool.toUpperCase(), mid = hud.measure(name).width;\n      hud.rect(bx - mid / 2 - 3, by - 6, mid + 6, 11, 0x0d0b14);\n      hud.text(Math.round(bx - mid / 2), by - 4, name, { color: 0xffd24d });\n    }\"\"\")\nopen(p,'w').write(s)\np='src/stages/story.js'; s=open(p).read()\ns=s.replace(\"    const wide = this.camMode === 'wide';\\n\",\"    const wide = this.camMode === 'wide';\\n    for (const f of this.figures) f.obj.visible = wide;\\n\")\nopen(p,'w').write(s)\np='src/content/sets.js'; s=open(p).read()\ns=s.replace(\"office: { label: \\\"CHIEF'S OFFICE\\\", wall: 0x4a3226, floor: 0x33241c, sun: 0.3, ambient: [0xb09070, 0.6], lamp: [-1, 2.6, 1.4, 9, 7, 0xffd8a0]\",\"office: { label: \\\"CHIEF'S OFFICE\\\", wall: 0x4a3226, floor: 0x33241c, sun: 0.35, ambient: [0xc8c0b8, 0.7], lamp: [-1, 2.6, 1.4, 7, 7, 0xffe8c8]\")\nopen(p,'w').write(s)\np='src/content/models/index.js'; s=open(p).read()\ns=s.replace(\"{ name: 'dome', ball: [0.94, 0.5, 0.86], half: true, at: [0, 0.52, -0.1], c: 'skin' }\",\"{ name: 'dome', ball: [0.96, 0.46, 0.9], half: true, at: [0, 0.76, -0.12], c: 'skin' }\")\ns=s.replace(\"{ name: `eye${s}`, box: [0.22, 0.16, 0.03], at: [s * 0.2, 0.02, 0.28], c: 'white' }, { name: `pupil${s}`, box: [0.12, 0.14, 0.03], at: [s * 0.2, 0.015, 0.305], c: 'ink' },\",\"{ name: `eye${s}`, box: [0.24, 0.18, 0.03], at: [s * 0.2, 0.02, 0.28], c: 'white' }, { name: `pupil${s}`, box: [0.12, 0.15, 0.03], at: [s * 0.18, 0.012, 0.305], c: 'ink' }, { name: `spark${s}`, box: [0.05, 0.05, 0.02], at: [s * 0.16, 0.05, 0.325], c: 'white' },\")\nopen(p,'w').write(s)\nE\ncat > tests/sim.test.mjs <<'EOF'\n// Sim tests: tools, ops, gifts, scoring, slider reset, codec, the whole campaign.\nimport { createOp, step, drainEvents, hashSim, cloneState, dev, defOf } from '../src/sim/op.js';\nimport { createBot, botInput } from '../src/sim/bot.js';\nimport { OPS, CAMPAIGN_OPS, SESSION_LIST } from '../src/content/ops/index.js';\nimport { results, rankOf, capRank } from '../src/sim/scoring.js';\nimport { config, defaults, resetConfig, SLIDERS } from '../src/core/config.js';\nimport { encodeKey, encodeSnap, decodeKey, applySnap } from '../src/sim/codec.js';\nimport { CAMPAIGN, recordOp } from '../src/sim/campaign.js';\nimport { SCENES } from '../src/content/scenes/index.js';\nimport { DEFAULT_SAVE } from '../src/core/save.js';\nimport { play } from './balance.mjs';\n\nconst mini = (stages, extra = {}) => ({ id: `t${Math.random()}`, title: 'T', arena: 'forearm', surgeon: 'ilya', gifts: [], tools: ['scalpel', 'forceps', 'suture', 'drain', 'syringe', 'gel', 'laser', 'scanner'], startTool: 'drain', patient: { name: 'X', objective: 'X', followUp: {} }, time: 100, vitals: { start: 80, drain: 0 }, doses: 3, par: 1000, stages, ...extra });\nconst hold = (sim, input, n) => { const ev = []; for (let i = 0; i < n; i++) { step(sim, [input]); ev.push(...drainEvents(sim)); } return ev; };\nconst walk = (sim, tool, pts, speed = 3, use = 1) => { // walk a held tool along points\n  const ev = [];\n  let [x, z] = pts[0];\n  for (let i = 1; i < pts.length; i++) {\n    const [tx, tz] = pts[i], d = Math.hypot(tx - x, tz - z), n = Math.max(1, Math.ceil((d / speed) * 60));\n    for (let k = 1; k <= n; k++) { step(sim, [{ x: x + ((tx - x) * k) / n, z: z + ((tz - z) * k) / n, tool, use }]); ev.push(...drainEvents(sim)); }\n    x = tx; z = tz;\n  }\n  return ev;\n};\nconst rates = (ev) => ev.filter((e) => e.t === 'rate').map((e) => e.r);\n\nexport async function run(ok) {\n  resetConfig();\n  /* Drain */\n  { const sim = createOp(mini([{ id: 'a', spawn: [{ k: 'pool', at: [0, 0], r: 1 }], until: { clear: ['pool'] } }, { id: 'b', until: { time: 99 } }])); drainEvents(sim);\n    const ev = hold(sim, { x: 0, z: 0, tool: 'drain', use: 1 }, 60);\n    ok('drain: clears a pool', sim.ents.length === 0, `left ${sim.ents.length}`);\n    ok('drain: rated CLEAN', rates(ev).includes('CLEAN'), rates(ev).join());\n    const sim2 = createOp(mini([{ id: 'a', spawn: [{ k: 'pool', at: [5, 2], r: 1 }], until: { clear: ['pool'] } }])); drainEvents(sim2);\n    const ev2 = hold(sim2, { x: -4, z: -2, tool: 'drain', use: 1 }, 40);\n    ok('drain: dry tissue bruises, SLOPPY', rates(ev2).includes('SLOPPY') && sim2.scars.some((s) => s.k === 'bruise')); }\n  /* Forceps */\n  { const sim = createOp(mini([{ id: 'a', spawn: [{ k: 'hook', at: [0, 0], dir: [0, -1], pull: 1.2, arc: 0 }], until: { clear: ['hook'] } }, { id: 'b', until: { time: 99 } }])); drainEvents(sim);\n    const ev = walk(sim, 'forceps', [[0, 0], [0, -1.3]], 1.5);\n    ok('forceps: pulled free', !sim.ents.length || sim.ents[0].free);\n    hold(sim, { x: 0, z: -1.3, tool: 'forceps', use: 0 }, 3);\n    const ev2 = drainEvents(sim); void ev; void ev2;\n    ok('forceps: flicks into the dish on release', sim.ents.length === 0, JSON.stringify(sim.ents.map((e) => e.k)));\n    const s2 = createOp(mini([{ id: 'a', spawn: [{ k: 'hook', at: [0, 0], dir: [0, -1], pull: 1.2, arc: 0 }], until: { clear: ['hook'] } }])); drainEvents(s2);\n    walk(s2, 'forceps', [[0, 0], [3, 0]], 6);\n    ok('forceps: off path tears (nick, mistake)', s2.mistakes >= 1 && s2.ents.some((e) => e.k === 'nick'));\n    const s3 = createOp(mini([{ id: 'a', spawn: [{ k: 'magnet', at: [0, 0], dir: [1, 0], pull: 2, maxSpeed: 2 }], until: { clear: ['magnet'] } }])); drainEvents(s3);\n    const ev3 = walk(s3, 'forceps', [[0, 0], [2, 0]], 8);\n    ok('magnet: too fast snaps back', rates(ev3).includes('SLOPPY') && s3.ents.some((e) => e.k === 'magnet' && e.s < 1.9));\n    const s4 = createOp(mini([{ id: 'a', spawn: [{ k: 'core', at: [0, 0], tether: true, autoFree: true, dir: [1, 0], pull: 2.5 }], until: { clear: ['core'] } }])); drainEvents(s4);\n    walk(s4, 'forceps', [[0, 0], [1, 0]], 3); hold(s4, { x: 1, z: 0, tool: 'forceps', use: 0 }, 2);\n    ok('tether: letting go early snaps back and lacerates', s4.ents.some((e) => e.k === 'laceration') && s4.mistakes === 1); }\n  /* Scalpel */\n  { const sim = createOp(mini([{ id: 'a', spawn: [{ k: 'incision', line: [[-2, 0], [2, 0]] }], until: { clear: ['incision'] } }])); drainEvents(sim);\n    const ev = walk(sim, 'scalpel', [[-2, 0], [2, 0]], 3);\n    ok('scalpel: clean trace rates CLEAN', rates(ev).includes('CLEAN'), rates(ev).join());\n    const s2 = createOp(mini([{ id: 'a', spawn: [{ k: 'incision', line: [[-2, 0], [2, 0]] }], until: { clear: ['incision'] } }])); drainEvents(s2);\n    walk(s2, 'scalpel', [[-2, 0], [-1, 0], [-1, 2]], 3);\n    ok('scalpel: cutting healthy tissue spawns a pool and a mistake', s2.ents.some((e) => e.k === 'pool') && s2.mistakes === 1);\n    ok('scalpel: letting go resumes from the last point', s2.ents.find((e) => e.k === 'incision').s > 0.5); }\n  /* Suture */\n  { const sim = createOp(mini([{ id: 'a', spawn: [{ k: 'laceration', a: [-1, 0], b: [1, 0] }], until: { clear: ['laceration'] } }, { id: 'b', until: { time: 99 } }])); drainEvents(sim);\n    const lac = sim.ents[0]; const pts = [[-1, 0.4]];\n    for (let i = 0; i < lac.slots; i++) { const x = -1 + (2 * (i + 0.5)) / lac.slots; pts.push([x, i % 2 ? 0.4 : -0.4]); }\n    const ev = walk(sim, 'suture', pts, 2.8);\n    ok('suture: zigzag ties every slot', !sim.ents.some((e) => e.k === 'laceration'), JSON.stringify(sim.ents.map((e) => e.tied)));\n    ok('suture: rhythm scores CLEAN', rates(ev).filter((r) => r === 'CLEAN').length >= 2, rates(ev).join());\n    const s2 = createOp(mini([{ id: 'a', spawn: [{ k: 'laceration', a: [-3, 0], b: [3, 0] }], until: { clear: ['laceration'] } }])); drainEvents(s2);\n    const ev2 = walk(s2, 'suture', [[2, 0.5], [2, -0.5], [2, 0.5]], 3);\n    ok('suture: crossing far from the slot is SLOPPY with no stitch', s2.ents[0].tied === 0 && rates(ev2).includes('SLOPPY'), `${s2.ents[0].tied} ${rates(ev2)}`); }\n  /* Laser */\n  { const sim = createOp(mini([{ id: 'a', spawn: [{ k: 'polyp', at: [0, 0] }], until: { clear: ['polyp'] } }, { id: 'b', until: { time: 99 } }])); drainEvents(sim);\n    hold(sim, { x: 0, z: 0, tool: 'laser', use: 1 }, 60);\n    ok('laser: burns a target', !sim.ents.length && sim.mistakes === 0);\n    const s2 = createOp(mini([{ id: 'a', spawn: [{ k: 'polyp', at: [5, 2] }], until: { clear: ['polyp'] } }])); drainEvents(s2);\n    hold(s2, { x: -3, z: 0, tool: 'laser', use: 1 }, 40);\n    ok('laser: healthy tissue burns (mistake)', s2.mistakes === 1 && s2.scars.some((s) => s.k === 'burn')); }\n  /* Scanner, gel, syringe */\n  { const sim = createOp(mini([{ id: 'a', spawn: [{ k: 'polyp', at: [1, 0], scan: true }, { k: 'polyp', at: [5, 0], scan: true }], until: { clear: ['polyp'] } }])); drainEvents(sim);\n    hold(sim, { x: 0, z: 0, tool: 'scanner', use: 1 }, 3);\n    ok('scanner: reveals within reach only', sim.ents[0].seen && !sim.ents[1].seen); }\n  { const sim = createOp(mini([{ id: 'a', spawn: [{ k: 'mask', rect: [0, 0, 1.2, 1.2] }], until: { clear: ['mask'] } }, { id: 'b', until: { time: 99 } }])); drainEvents(sim);\n    hold(sim, { x: 0, z: 0, tool: 'gel', use: 1 }, 10);\n    ok('gel: paints a mask to done', !sim.ents.some((e) => e.k === 'mask'));\n    const s2 = createOp(mini([{ id: 'a', spawn: [{ k: 'nick', at: [0, 0] }, { k: 'polyp', at: [5, 2] }], until: { clear: ['polyp'] } }])); drainEvents(s2);\n    hold(s2, { x: 0, z: 0, tool: 'gel', use: 1 }, 70);\n    ok('gel: heals a nick after a second', !s2.ents.some((e) => e.k === 'nick')); }\n  { const sim = createOp(mini([{ id: 'a', until: { time: 99 } }], { port: [0, 0], vitals: { start: 40, drain: 0 } })); drainEvents(sim);\n    hold(sim, { x: 0, z: 0, tool: 'syringe', use: 1 }, 30); hold(sim, { x: 0, z: 0, tool: 'syringe', use: 0 }, 2);\n    ok('syringe: dose raises vitals', Math.round(sim.tables[0].vitals) === 58 && sim.doses === 2, String(sim.tables[0].vitals));\n    hold(sim, { x: 5, z: 2, tool: 'syringe', use: 1 }, 30); const ev = hold(sim, { x: 5, z: 2, tool: 'syringe', use: 0 }, 2);\n    ok('syringe: outside the ring wastes a dose, SLOPPY', sim.doses === 1 && rates(ev).includes('SLOPPY')); }\n  /* Bone mend */\n  { const sim = createOp(mini([{ id: 'a', spawn: [{ k: 'fragment', at: [0, 0], rot: 40, goal: [2, 0, 0] }], until: { clear: ['fragment'] } }, { id: 'b', until: { time: 99 } }])); drainEvents(sim);\n    walk(sim, 'forceps', [[0, 0], [2, 0]], 3); hold(sim, { x: 2, z: 0, tool: 'forceps', use: 0 }, 2);\n    ok('bone mend: wrong angle will not seat', sim.ents.some((e) => e.k === 'fragment'));\n    walk(sim, 'forceps', [[2, 0], [2.01, 0]], 3);\n    for (let i = 0; i < 40 && Math.abs(sim.ents[0].rot) > 2; i++) { step(sim, [{ x: 2, z: 0, tool: 'forceps', use: 1, rot: -1 }]); }\n    hold(sim, { x: 2, z: 0, tool: 'forceps', use: 0 }, 2);\n    ok('bone mend: turned, it seats', !sim.ents.some((e) => e.k === 'fragment'), JSON.stringify(sim.ents)); }\n  /* Clock and fail paths */\n  { const sim = createOp(mini([{ id: 'a', until: { time: 999 } }], { time: 1 }));\n    for (let i = 0; i < 120; i++) step(sim, []);\n    ok('clock: reaching 0 fails', sim.phase === 'lost' && sim.loseWhy === 'clock');\n    const s2 = createOp(mini([{ id: 'a', spawn: [{ k: 'polyp', at: [5, 2] }], until: { clear: ['polyp'] } }])); drainEvents(s2);\n    for (let i = 0; i < 400 && s2.phase === 'play'; i++) step(s2, [{ x: -3, z: 0, tool: 'laser', use: 1 }]);\n    ok('mistakes: five fail the op', s2.phase === 'lost' && s2.loseWhy === 'mistakes', `${s2.phase} ${s2.mistakes}`); }\n  /* Code Blue */\n  { const sim = createOp(mini([{ id: 'a', until: { time: 999 } }], { vitals: { start: 1, drain: 2 } }));\n    for (let i = 0; i < 120 && sim.phase === 'play'; i++) step(sim, []);\n    ok('code blue: starts at 0 vitals', sim.phase === 'codeblue');\n    const shock = (good) => { let guard = 0; while (sim.codeBlue && guard++ < 300) { const cb = sim.codeBlue; if (cb.cool > 0 && !cb.charging) { step(sim, [{}]); continue; } const inZone = Math.abs(cb.needle - cb.centre) < cb.zone / 2 - 0.01; if (cb.charging && (good ? inZone : cb.needle < 0.1 && cb.charge > 0.02)) { step(sim, [{}]); return; } step(sim, [{ padL: true, padR: true }]); } };\n    const t0 = sim.codeBlue.t; shock(false);\n    ok('code blue: a bad shock costs 3 s', sim.codeBlue && t0 - sim.codeBlue.t > 3, String(t0 - sim.codeBlue?.t));\n    shock(true); shock(true);\n    ok('code blue: two good shocks bring vitals back to 25', sim.phase === 'play' && sim.tables[0].vitals >= 24, `${sim.phase} ${sim.tables[0].vitals}`);\n    for (let i = 0; i < 1000 && sim.phase === 'play'; i++) step(sim, []);\n    ok('code blue: Resident gets one save, second time is the end', sim.phase === 'lost', sim.phase); }\n  { const sim = createOp(mini([{ id: 'a', until: { time: 999 } }], { vitals: { start: 50, drain: 0 } })); dev.codeBlue(sim);\n    for (let i = 0; i < 800 && sim.phase === 'codeblue'; i++) step(sim, [{}]);\n    ok('code blue: running out of time loses the patient', sim.phase === 'lost' && sim.loseWhy === 'codeblue'); }\n  /* The Quiet */\n  { const sim = createOp(mini([{ id: 'a', until: { time: 999 } }], { gifts: ['quiet'], composure: 100, vitals: { start: 50, drain: 2 } })); drainEvents(sim);\n    const c0 = sim.clock;\n    hold(sim, { gift: true }, 60);\n    ok('quiet: the world runs at 1/4', Math.abs(c0 - sim.clock - 0.25) < 0.02, String(c0 - sim.clock));\n    ok('quiet: vitals stop falling', sim.tables[0].vitals === 50, String(sim.tables[0].vitals));\n    ok('quiet: drains composure 18 per second', Math.abs(sim.composure - 82) < 0.5, String(sim.composure));\n    const s2 = createOp(mini([{ id: 'a', until: { time: 999 } }], { gifts: ['quiet'], composure: 10 })); step(s2, [{ gift: true }]);\n    ok('quiet: needs 20 composure', !s2.quiet); }\n  /* The Second Look: exact restore */\n  { const def = mini([{ id: 'a', spawn: [{ k: 'pool', at: [0, 0], r: 3 }, { k: 'hook', at: [4, 0], dir: [0, -1], pull: 1 }], until: { clear: ['pool', 'hook'] } }], { surgeon: 'sabine', gifts: ['look'], composure: 100, vitals: { start: 80, drain: 0.5 } });\n    const sim = createOp(def, { seed: 7 }); drainEvents(sim);\n    const movie = [];\n    for (let i = 0; i < 400; i++) { step(sim, [{ x: 0, z: 0, tool: 'drain', use: 1 }]); if (sim.ringN === 0) movie.push(cloneState(sim)); drainEvents(sim); }\n    const backTo = sim.ring[sim.ring.length - 40];\n    const want = { r: backTo.ents[0].r, clock: backTo.clock, vit: backTo.tables[0].vitals, stage: backTo.stage };\n    step(sim, [{ x: 0, z: 0, tool: 'drain', use: 0, gift: true }]);\n    ok('second look: entities, vitals, clock restored exactly', Math.abs(sim.ents[0].r - want.r) < 0.05 && Math.abs(sim.clock - want.clock) < 0.05 && Math.abs(sim.tables[0].vitals - want.vit) < 0.1, JSON.stringify({ now: [sim.ents[0].r, sim.clock, sim.tables[0].vitals], want }));\n    ok('second look: costs composure, leaves a ghost, counts', sim.composure < 45 && sim.ghost && sim.looks === 1);\n    const before = createOp(def, { seed: 1, seats: 1 }); before.score = 1000; before.clock = 0; const f = results(before, def).total;\n    before.looks = 1; const g = results(before, def).total;\n    ok('second look: 5% off the final score', Math.abs(g / f - 0.95) < 0.01, `${f} ${g}`); }\n  /* Scoring */\n  ok('rank: bounds', rankOf(85, 100) === 'S' && rankOf(84, 100) === 'A' && rankOf(70, 100) === 'A' && rankOf(69, 100) === 'B' && rankOf(50, 100) === 'B' && rankOf(49, 100) === 'C');\n  ok('rank: caps', capRank('S', 'A') === 'A' && capRank('C', 'B') === 'C');\n  { const def = OPS.op1, s = createOp(def); s.score = 999999; s.unscriptedBlue = true; const r = results(s, def); ok('rank: unscripted Code Blue caps at A', r.rank === 'A' && !r.pristine, r.rank); }\n  /* Sliders */\n  { config.vitalsDrain = 3; config.maxMistakes = 0; const s = createOp(OPS.op1, { cfg: config }); ok('sliders: live config reaches a sim', s.cfg.vitalsDrain === 3); resetConfig(); ok('sliders: reset restores defaults', Object.keys(defaults).every((k) => config[k] === defaults[k])); ok('sliders: every slider has a default inside its range', SLIDERS.every(([k, , a, b]) => defaults[k] >= a && defaults[k] <= b), SLIDERS.filter(([k, , a, b]) => !(defaults[k] >= a && defaults[k] <= b)).map((s) => s[0]).join()); }\n  /* Every op: idle fails, bot clears, determinism, retry */\n  for (const id of [...CAMPAIGN_OPS, ...SESSION_LIST]) {\n    const idle = play(id, 0);\n    ok(`${id}: idle fails`, idle.sim.phase === 'lost', idle.sim.phase);\n    const a = play(id, 0.7, 11);\n    ok(`${id}: bot 0.7 clears`, a.sim.phase === 'won', `${a.sim.phase} ${a.sim.loseWhy} stage ${a.sim.stage}`);\n    const b = play(id, 0.7, 11);\n    ok(`${id}: determinism`, hashSim(a.sim) === hashSim(b.sim));\n    const full = play(id, 1, 3);\n    ok(`${id}: bot 1.0 clears`, full.sim.phase === 'won', `${full.sim.phase} ${full.sim.loseWhy} stage ${full.sim.stage}`);\n    // Peak network sizes\n    const peak = peakSizes(id);\n    ok(`${id}: snapshot under 1100 bytes`, peak.snap <= 1100, String(peak.snap));\n    ok(`${id}: keyframe under 16 KB`, peak.key <= 16000, String(peak.key));\n    // Retry\n    const def = OPS[id];\n    const r = createOp(def, { seats: def.seats ?? 1 });\n    ok(`${id}: a stage checkpoint exists`, !!r.checkpoint);\n  }\n  /* Retry mid-op keeps the stage */\n  { const def = OPS.op1, s = createOp(def); dev.completeStage(s); dev.completeStage(s); const cp = s.checkpoint; ok('retry: checkpoint lands on the current stage', cp && cp.stage === 2, String(cp?.stage)); }\n  /* Codec round trip */\n  { const def = OPS.op5, s = createOp(def); const bot = createBot(0, 0.8); for (let i = 0; i < 1800 && s.phase === 'play'; i++) { step(s, [botInput(s, bot)]); drainEvents(s); }\n    const c = createOp(def); decodeKey(encodeKey(s), c); ok('codec: keyframe restores the state the view reads', c.ents.length === s.ents.length && Math.abs(c.clock - s.clock) < 0.1 && c.score === s.score);\n    applySnap(c, JSON.parse(JSON.stringify(encodeSnap(s, 1))), -1); ok('codec: a snapshot applies', c.seats[0].nx != null && c.score === s.score); }\n  /* Whole-game scripted playthrough */\n  { const save = DEFAULT_SAVE(); let i = 0, scenes = 0, ops = 0, bad = '';\n    while (i < CAMPAIGN.length) {\n      const e = CAMPAIGN[i];\n      if (e.scene) { if (!SCENES[e.scene]?.beats?.length) bad = `missing ${e.scene}`; scenes++; }\n      else if (e.op) { const { sim, res } = play(e.op, 0.8, 21); if (sim.phase !== 'won') bad = `${e.op} lost: ${sim.loseWhy}@${sim.stage}`; recordOp(save, e.op, res); ops++; }\n      save.next = ++i;\n      const reloaded = JSON.parse(JSON.stringify(save)); Object.assign(save, reloaded);\n    }\n    ok('playthrough: every scene and op to credits', !bad && scenes === 11 && ops === 10 && save.next === CAMPAIGN.length, bad || `${scenes} ${ops}`);\n    ok('playthrough: every op recorded and ranked', CAMPAIGN_OPS.every((id) => save.cleared[id] && save.ranks[id])); }\n  void defOf;\n}\nfunction peakSizes(id) {\n  const def = OPS[id], seats = Math.max(def.seats ?? 1, 2), s = createOp(def, { seats, seed: 9, gifts: ['quiet', 'look'] });\n  const bots = s.seats.map((_, i) => createBot(i, 0.4));\n  let snap = 0, key = 0;\n  for (let i = 0; i < 7200 && s.phase !== 'won' && s.phase !== 'lost'; i++) {\n    step(s, bots.map((b) => botInput(s, b))); drainEvents(s);\n    if (i % 60 === 0) { snap = Math.max(snap, JSON.stringify(encodeSnap(s, i)).length); key = Math.max(key, encodeKey(s).length); }\n  }\n  return { snap, key };\n}\nEOF\ncat > tests/content.test.mjs <<'EOF'\n// Content lint: names, text fit, the font's character set, tokens, and no placeholders.\nimport { readFileSync, readdirSync, statSync } from 'node:fs';\nimport { execFileSync } from 'node:child_process';\nimport { OPS } from '../src/content/ops/index.js';\nimport { SCENES } from '../src/content/scenes/index.js';\nimport { CAST } from '../src/content/cast.js';\nimport { SETS } from '../src/content/sets.js';\nimport { LINES } from '../src/content/lines.js';\nimport { SONGS } from '../src/content/songs.js';\nimport { SFX_DEFS } from '../src/content/sfx.js';\nimport { SOURCE_INFO, TESTING_FEEDBACK, ENGINE_FEEDBACK, PROMPT_FEEDBACK } from '../src/content/about.js';\nimport { TOOLS } from '../src/sim/tools.js';\nimport { KINDS } from '../src/sim/entities.js';\nimport { renderSyllable } from '../src/audio/voice.js';\nimport { parseSong, renderSound } from '../pixel-engine.js';\n\nconst FONT = /^[A-Za-z0-9 .,:;!?\\-+%/()[\\]'\"#&*=<>{}]*$/;\nconst TOKENS = new Set(['use', 'back', 'confirm', 'gift', 'steady', 'quick', 'drop', 'rotate', 'table', 'tag', 'paddles', 'squeeze', 'more', 'pause', 'last', 'remind', 'move', 'tabl', 'tabr', 'skipScene']);\nconst FORBIDDEN = /derek stiles|angie thompson|naomi kimishima|nozomi weaver|hope hospital|caduceus|delphi|\\bguilt\\b|kyriaki|deuteros|triti|tetarti|pempti|paraskevi|savato|healing touch/i;\nconst lineFit = (t) => { const plain = t.replace(/\\*/g, '').replace(/\\{[^}]+\\}/g, 'XX'); const W = 330 / 6; let lines = 1, cur = 0; for (const w of plain.split(' ')) { if (cur + w.length > W) { lines++; cur = 0; } cur += w.length + 1; } return lines; };\n\nfunction collectStrings(obj, out = [], key = '') {\n  if (typeof obj === 'string') out.push([key, obj]);\n  else if (Array.isArray(obj)) obj.forEach((o) => collectStrings(o, out, key));\n  else if (obj && typeof obj === 'object') for (const k of Object.keys(obj)) collectStrings(obj[k], out, k);\n  return out;\n}\nfunction walk(dir, out = []) { for (const f of readdirSync(dir)) { const p = `${dir}/${f}`; if (statSync(p).isDirectory()) walk(p, out); else if (p.endsWith('.js')) out.push(p); } return out; }\n\nexport async function run(ok) {\n  const say = [];\n  for (const def of Object.values(OPS)) {\n    const check = (c) => { if (!c) return; for (const k of Array.isArray(c) ? c : [c]) { if (Array.isArray(k.say)) say.push([def.id, k.say[0], k.say[1]]); if (k.prompt) say.push([def.id, null, k.prompt]); } };\n    for (const st of def.stages) {\n      if (Array.isArray(st.say)) say.push([def.id, st.say[0], st.say[1]]);\n      check(st.begin); check(st.then); check(st.timed);\n      for (const c of Object.values(st.on?.vitalsBelow ?? {})) check(c);\n      for (const d of st.spawn ?? []) { ok(`${def.id}: known kind ${d.k}`, !!KINDS[d.k]); check(d.then); }\n    }\n    ok(`${def.id}: tools all real`, def.tools.every((t) => TOOLS.includes(t)));\n    ok(`${def.id}: patient chart is complete`, !!(def.patient?.name && def.patient.objective && def.patient.hook && ['S', 'A', 'B', 'C'].every((r) => def.patient.followUp?.[r])));\n    ok(`${def.id}: has a par`, def.par > 0);\n  }\n  for (const [k, pool] of Object.entries(LINES)) for (const t of pool) say.push([k, k.split('.')[0] === 'false' || k.split('.')[0] === 'mimic' ? 'reyes' : k.split('.')[0], t]);\n  for (const sc of Object.values(SCENES)) {\n    ok(`${sc.id}: set exists`, !!SETS[sc.set]);\n    ok(`${sc.id}: 8 to 16 beats`, sc.beats.length >= 8 && sc.beats.length <= 16, String(sc.beats.length));\n    ok(`${sc.id}: music exists`, !!SONGS[sc.music]);\n    for (const b of sc.beats) say.push([sc.id, b.who, b.say]);\n    for (const c of sc.cast) ok(`${sc.id}: cast ${c}`, !!CAST[c]);\n  }\n  let bad = [];\n  for (const [src, who, text] of say) {\n    if (who && !CAST[who]) bad.push(`${src}: who ${who}`);\n    if (!FONT.test(text)) bad.push(`${src}: char in \"${text}\"`);\n    if (lineFit(text) > 2) bad.push(`${src}: too long \"${text}\"`);\n    for (const m of text.matchAll(/\\{([^}]+)\\}/g)) if (!TOKENS.has(m[1]) && !/^tool:[1-8]$/.test(m[1])) bad.push(`${src}: token ${m[1]}`);\n    if ((text.match(/\\*/g) ?? []).length % 2) bad.push(`${src}: unbalanced * in \"${text}\"`);\n  }\n  ok('text: speakers, characters, fit and tokens', !bad.length, bad.slice(0, 12).join(' | '));\n  const allTools = new Set(Object.values(OPS).flatMap((d) => d.stages.flatMap((s) => (s.spawn ?? []).map((e) => KINDS[e.k].tool))));\n  ok('every instrument is used by some op', ['scalpel', 'forceps', 'suture', 'drain', 'gel', 'laser'].every((t) => allTools.has(t)));\n  // No placeholders; no forbidden names.\n  const files = [...walk('src'), 'game.js'];\n  const hits = [], fb = [];\n  for (const f of files) {\n    const text = readFileSync(f, 'utf8');\n    if (/\\b(TODO|FIXME|XXX|placeholder|lorem)\\b/i.test(text) && !f.includes('content.test')) hits.push(f);\n    if (FORBIDDEN.test(text)) fb.push(`${f}: ${text.match(FORBIDDEN)[0]}`);\n  }\n  ok('no TODOs or placeholders', !hits.length, hits.join());\n  ok('no forbidden source names', !fb.length, fb.join());\n  // About has every field.\n  ok('about: every field', ['DATE', 'SOURCE', 'PLAN', 'GENRE AND PERSPECTIVE', 'TECH', 'ART DIRECTION', 'ANIMATION', 'AUDIO', 'ONLINE', 'TESTING', 'RESEARCH', 'ENVIRONMENT', 'MODEL', 'USAGE'].every((k) => SOURCE_INFO.some(([a, b]) => a === k && b)));\n  ok('about: feedback answers', TESTING_FEEDBACK.length === 4 && ENGINE_FEEDBACK.length === 6 && PROMPT_FEEDBACK.length === 4, `${TESTING_FEEDBACK.length} ${ENGINE_FEEDBACK.length} ${PROMPT_FEEDBACK.length}`);\n  // Sound: non-silent and finite.\n  for (const [k, def] of Object.entries(SFX_DEFS)) {\n    const s = renderSound(def, 8000);\n    const peak = s.reduce((m, v) => Math.max(m, Math.abs(v)), 0);\n    if (!(peak > 0.001) || s.some((v) => !Number.isFinite(v))) ok(`sfx ${k}`, false, `peak ${peak}`); else ok(`sfx ${k}`, true);\n  }\n  for (let t = 0; t < 3; t++) { const s = renderSyllable(t, 'a', 'b'); const peak = s.reduce((m, v) => Math.max(m, Math.abs(v)), 0); ok(`voice timbre ${t} renders`, peak > 0.1 && s.every(Number.isFinite)); }\n  for (const [k, song] of Object.entries(SONGS)) { let e = null; try { parseSong(song); } catch (err) { e = err.message; } ok(`song ${k} parses`, !e, e); }\n  // Each music id referenced exists.\n  const musics = Object.values(OPS).flatMap((d) => [d.music, ...d.stages.map((s) => s.music)].filter(Boolean));\n  ok('music ids exist', musics.every((m) => m === 'silence' || SONGS[m]), musics.filter((m) => m !== 'silence' && !SONGS[m]).join());\n  // Kit's model sheet check.\n  let sheet = 0;\n  try { execFileSync('node', ['check.mjs', '--sheets', 'src/content/models/index.js'], { stdio: 'pipe', timeout: 240000 }); } catch (e) { sheet = e.status ?? 1; }\n  ok('check.mjs --sheets has no problems', sheet === 0, `exit ${sheet}`);\n}\nEOF\ntimeout 400 node tests/run.mjs sim 2>&1 | tail -40","description":"Add strain creatures, visual fixes, sim tests; run sim tests","timeout":420000}}}
