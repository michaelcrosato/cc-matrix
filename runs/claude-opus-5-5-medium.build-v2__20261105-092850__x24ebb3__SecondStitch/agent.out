{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgk8Z8o2XtaGKsYxS7rNp","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0135iA9DTFJCFq4dDd4i2eyG","name":"Bash","input":{"command":"cat > src/content/scenes/index.js <<'EOF'\n// The script. Scenes are data: { id, set, music, cast:[left,right], beats:[{ who, emo, say, cam, cue }] }.\n// `other` sets the listener's face. `cam:'wide'` cuts to the room with full-body figures; `cue` is a sound.\nconst s = (who, emo, say, extra = {}) => ({ who, emo, say, ...extra });\nexport const SCENES = {\n  ep1: { id: 'ep1', title: 'NIGHT SHIFT', set: 'or7', music: 'title', cast: ['reyes', 'ilya'], figures: [['ilya', [-1.6, 1.8], 'Idle'], ['reyes', [1.6, 1.6], 'Shout']], beats: [\n    s('ilya', 'neutral', '3 A.M. Rain. Everyone sensible is asleep.', { cam: 'wide', cue: 'horn' }),\n    s('reyes', 'stern', 'You. Yes, you. The one holding the coffee.', { cue: 'tick', other: 'shock' }),\n    s('ilya', 'shock', 'Me? Is the Chief...? Dr. Bram is on call, I just...'),\n    s('reyes', 'stern', \"The Chief isn't answering. Storm took the bridge out. You're the surgeon.\", { other: 'panic' }),\n    s('ilya', 'panic', \"I'm a second-year! I have held a liver *twice!*\"),\n    s('reyes', 'angry', 'Trawler deckhand. Tomasz Dolan. Eleven fishhooks, one arm. Scrub.'),\n    s('ilya', 'shock', 'How do you get eleven fishhooks in one arm?'),\n    s('reyes', 'neutral', 'It was a long net.'),\n    s('ilya', 'panic', 'I can do this. I can do this. Nurse Reyes, can I do this?', { other: 'stern' }),\n    s('reyes', 'stern', 'Find out. Coffee down, Doctor. *The patient is the other way.*'),\n  ] },\n  ep2: { id: 'ep2', title: 'MORNING ROUNDS', set: 'ward', music: 'ward', cast: ['pem', 'ilya'], figures: [['ilya', [-1.2, 1.4], 'Idle'], ['pem', [1.2, 1.2], 'Idle'], ['reyes', [3, 0.2], 'Idle']], beats: [\n    s('ilya', 'neutral', 'Bed four. Post-op day... two. Three? The chart is upside down.', { cam: 'wide', cue: 'bell' }),\n    s('pem', 'smile', 'Morning, Doctor. Patient in bed four is sleeping like a baby. A very expensive baby.'),\n    s('ilya', 'panic', 'Dr. Okoye, I think I presented that whole case to a coat rack.'),\n    s('pem', 'smile', \"It's a good coat rack. It made consultant last year.\"),\n    s('reyes', 'stern', 'Dr. Marsh. Admission. Stage magician. He swallowed something during his act.', { who2: 'reyes' }),\n    s('ilya', 'shock', 'Swallowed what?'),\n    s('reyes', 'stern', 'He says a magician never reveals his secrets. He says it *while vomiting.*'),\n    s('pem', 'smile', 'The Great Zamboni. I saw him in 1998. I still have no idea where my watch went.'),\n    s('ilya', 'neutral', 'How bad can it be? It is a prop. It is a funny prop.'),\n    s('pem', 'neutral', 'Patient is under. And I would like my watch back, if you see it.'),\n  ] },\n  ep3: { id: 'ep3', title: 'MASS CASUALTY', set: 'corridor', music: 'or-tense', cast: ['bram', 'ilya'], figures: [['bram', [0.8, 1.4], 'Idle'], ['ilya', [-1, 1.8], 'Idle'], ['reyes', [-2.8, 0.4], 'Shout']], beats: [\n    s('reyes', 'angry', 'Ferry collision at the harbour mouth! Forty in the water! Move, *move!*', { cam: 'wide', cue: 'alarm' }),\n    s('ilya', 'panic', 'All of these? All of these are ours?'),\n    s('bram', 'stern', 'Marsh. You will take OR-7. Three tables. These are your charts.', { other: 'shock' }),\n    s('ilya', 'shock', 'Sir, your hand. Your hand is shaking.'),\n    s('bram', 'stern', 'It is cold. Medicine is not miracles, son. It is showing up again tomorrow.'),\n    s('ilya', 'panic', 'Three tables. I have two hands. Sir, I have only got *two hands!*'),\n    s('bram', 'neutral', 'Then you will want to use both.'),\n    s('reyes', 'stern', 'Doctor. Table A is a leg. Table B is burns. Table C is not good. Go.'),\n  ] },\n  ep4: { id: 'ep4', title: 'AFTERMATH', set: 'office', music: 'ward', cast: ['bram', 'ilya'], figures: [['bram', [-0.4, -1.2], 'Sit'], ['ilya', [0.8, 1.2], 'Idle'], ['sabine', [-2.6, 1.2], 'Idle']], beats: [\n    s('bram', 'stern', 'Close the door. How long did the room go quiet?', { cam: 'wide', cue: 'horn' }),\n    s('ilya', 'shock', 'Sir? It was... I don\\'t... Everything went slow. I could see all of it.'),\n    s('bram', 'sad', 'I know. I know you could. Do not tell anyone how long.', { other: 'shock' }),\n    s('bram', 'stern', 'The Mercy Foundation complained to the board. They fund half this building.'),\n    s('ilya', 'panic', 'Complained about what? I saved three people!'),\n    s('bram', 'neutral', 'So they sent a consultant. To audit you. She is standing behind you.'),\n    s('sabine', 'neutral', 'Dr. Achterberg. You have two options, Doctor.', { swap: 'sabine', other: 'shock' }),\n    s('ilya', 'shock', 'What are they?'),\n    s('sabine', 'stern', 'You let me watch you work. The second one is also that.'),\n    s('sabine', 'neutral', 'Ollie Brandt. Sixteen. Ferry survivor. Six bone fragments, one cello. I will be on the intercom.'),\n    s('ilya', 'panic', 'Nurse Reyes? Can I do this?'),\n    s('reyes', 'stern', \"Don't look at me, Doctor. I just work here. For twenty-six years.\", { swap: 'reyes' }),\n  ] },\n  ep5: { id: 'ep5', title: 'THE SMILING WARD', set: 'ward', music: 'ward', cast: ['anselm', 'ilya'], figures: [['ilya', [-1.4, 1.4], 'Idle'], ['anselm', [1.6, 1], 'Wave'], ['sabine', [3.4, 0.2], 'Idle']], beats: [\n    s('ilya', 'neutral', 'Mr. Anselm? Harbour pilot, fifty-eight. Your scan is... Sir, how do you feel?', { cam: 'wide', cue: 'bell' }),\n    s('anselm', 'smile', 'Wonderful! Never better. Isn\\'t it wonderful, Doctor?', { other: 'shock' }),\n    s('ilya', 'shock', 'Your abdomen is like a bag of knives. You should be screaming.'),\n    s('anselm', 'smile', 'I know! I fell off the pilot boat in March. Didn\\'t feel a thing.'),\n    s('ilya', 'stern', 'Does anything hurt? Anywhere? At all?'),\n    s('anselm', 'smile', 'The nice people at the hospice gave me a course. *No one should hurt.* Isn\\'t it wonderful?'),\n    s('ilya', 'shock', \"He's smiling. They're all smiling. Dr. Achterberg, this whole bay is smiling.\"),\n    s('sabine', 'stern', '...', { swap: 'sabine' }),\n    s('sabine', 'stern', 'Take him to OR-7. Take him now. Do not let him sign anything.'),\n  ] },\n  ep6: { id: 'ep6', title: 'THE FILE', set: 'scrub', music: 'ward', cast: ['sabine', 'ilya'], figures: [['sabine', [-1, 0.8], 'Idle'], ['ilya', [1.2, 1.2], 'Idle']], beats: [\n    s('ilya', 'panic', 'It knocked. I am a doctor and I am telling you that the man\\'s liver knocked.', { cam: 'wide', cue: 'knock' }),\n    s('sabine', 'neutral', 'I know. I have heard it. Nine years ago, at a relief camp, in the flood.'),\n    s('sabine', 'stern', 'Forty-one patients, all smiling. All dead by the weekend. They blamed the surgeon.'),\n    s('ilya', 'shock', 'They blamed... That was you.'),\n    s('sabine', 'stern', 'Metabolic Endo-Receptor Cytoform, type Y. M-E-R-C-Y. It kills pain by rewiring the nerves.', { other: 'shock' }),\n    s('sabine', 'neutral', 'Then it eats. They call it Mercy. *Show it none, Doctor.*'),\n    s('ilya', 'panic', 'A foundation made this? On purpose? The hospice with the nice logo?'),\n    s('sabine', 'neutral', 'Dr. Okoye\\'s sister needs a kidney. The donor organ came from their bank.'),\n    s('ilya', 'shock', \"Then let me scrub in. I'll...\"),\n    s('sabine', 'stern', 'No. You have done enough for one week. My hands. My case. *Watch.*'),\n  ] },\n  ep7: { id: 'ep7', title: 'THE VISIT', set: 'atrium', music: 'ward', cast: ['hesper', 'ilya'], figures: [['hesper', [0.6, 1], 'Wave'], ['ilya', [-1.4, 1.6], 'Idle'], ['reyes', [-3, 0.8], 'Idle']], beats: [\n    s('hesper', 'smile', 'Dr. Marsh. I brought flowers. And a new cardiac wing, if your board agrees.', { cam: 'wide', cue: 'bell', other: 'shock' }),\n    s('ilya', 'stern', 'Dr. Lindqvist. There is something in your hospice patients. It lays eggs.'),\n    s('hesper', 'smile', 'Have you ever sat with someone at the very end, Doctor? Truly sat?'),\n    s('hesper', 'neutral', 'Pain is only the body begging. I simply taught it to stop.'),\n    s('ilya', 'angry', 'It eats them! They die smiling and it *eats* them!'),\n    s('hesper', 'neutral', 'Everyone dies. I asked what it should feel like. No one else was asking.'),\n    s('hesper', 'smile', 'No one should hurt, Doctor. Not even you. Think about the wing.'),\n    s('reyes', 'shock', 'Doctor. Admission. Ottilie Marr. Hospice nurse. She... she is my oldest friend.', { swap: 'reyes', other: 'shock', cue: 'alarm' }),\n    s('reyes', 'stern', 'Thirty years she has told me her feet hurt. Today she told me she is fine.'),\n    s('reyes', 'stern', '*Get in there, Doctor.* I am scrubbing. Do not look at me.'),\n  ] },\n  ep8: { id: 'ep8', title: 'THE CONFESSION', set: 'office', music: 'ward', cast: ['bram', 'ilya'], figures: [['bram', [-0.4, -1.2], 'Sit'], ['ilya', [0.8, 1.2], 'Idle'], ['sabine', [2.6, 0.6], 'Idle']], beats: [\n    s('bram', 'sad', 'There are two names on the founding paper. Lindqvist is the first.', { cam: 'wide', cue: 'horn', other: 'shock' }),\n    s('ilya', 'shock', 'Sir. Sir, no.'),\n    s('bram', 'sad', 'Eleven years ago. We wanted to end suffering. We were very clever and very young.'),\n    s('bram', 'stern', 'At dawn she releases it on the harbour ferries. As an aerosol. Forty thousand commuters.'),\n    s('sabine', 'stern', 'You have known this. How long have you known this?', { swap: 'sabine' }),\n    s('bram', 'neutral', 'I used to go quiet too, Marsh. Better than you. I thought it was God.'),\n    s('bram', 'shock', 'It was never a gift, in my case. My hand. It was never *cold.*'),\n    s('ilya', 'panic', 'Sir? Sir! Reyes! *REYES!*', { cue: 'flatline' }),\n    s('bram', 'sad', 'It is in my heart, son. It has been feeding my Quiet for eleven years.'),\n    s('bram', 'stern', 'My old scalpel. Top drawer. Take it. And Marsh.'),\n    s('bram', 'angry', \"*Don't you dare be gentle.*\"),\n  ] },\n  ep9: { id: 'ep9', title: 'THE ROOF', set: 'roof', music: 'or-critical', cast: ['hesper', 'ilya'], figures: [['hesper', [2.4, -1.2], 'Idle'], ['ilya', [-1.4, 1.6], 'Idle'], ['sabine', [-3, 1], 'Idle'], ['reyes', [-0.2, 2.6], 'Idle']], beats: [\n    s('ilya', 'angry', 'Dr. Lindqvist! Step away from the canister!', { cam: 'wide', cue: 'horn' }),\n    s('hesper', 'neutral', 'I have no weapon, Doctor. There is only rain, and one very tired woman.'),\n    s('sabine', 'stern', 'It is finished. The ferries are stopped. I have the valve. Step back.', { swap: 'sabine' }),\n    s('hesper', 'smile', \"You can't cure me of being right.\", { other: 'angry' }),\n    s('ilya', 'panic', 'The seal! Dr. Achterberg, it\\'s cracked, the *seal is cracked!*', { cue: 'alarm' }),\n    s('reyes', 'stern', 'Get the boy down! Marsh, *move* that stretcher!', { swap: 'reyes', cue: 'wave' }),\n    s('ilya', 'panic', 'Nurse Reyes? You\\'re standing in it. You are standing right in it!'),\n    s('reyes', 'stern', \"Yes, I can see that. I've got eyes. Take the patient.\"),\n    s('reyes', 'smile', '...Huh. My feet have stopped hurting.'),\n    s('reyes', 'stern', 'Start without me, Doctor. Your *sutures* had better be straight.', { other: 'panic' }),\n    s('ilya', 'panic', 'Reyes? REYES!', { cue: 'flatline' }),\n  ] },\n  ep10: { id: 'ep10', title: 'THE STRETCHER', set: 'or7', music: 'op10', cast: ['hesper', 'ilya'], figures: [['ilya', [-1.6, 1.4], 'Idle'], ['sabine', [1.8, 1.8], 'Idle'], ['pem', [2.6, 0.4], 'Idle']], beats: [\n    s('pem', 'neutral', 'Dr. Lindqvist. Found on the roof, in the rain. She is dying. Sooner than you would like.', { swap: 'pem', cam: 'wide', cue: 'bell' }),\n    s('sabine', 'stern', 'Her scan is eleven years deep. She took it. She took it *first.*', { swap: 'sabine' }),\n    s('hesper', 'smile', 'I would never ask anything of others that I would not take myself. Would you?', { swap: 'hesper' }),\n    s('ilya', 'neutral', 'Everyone is looking at me.'),\n    s('sabine', 'neutral', 'You have two options, Doctor.', { swap: 'sabine' }),\n    s('ilya', 'neutral', 'I know. Scrub in.'),\n    s('hesper', 'neutral', 'It will not be gentle, taking it out. I will feel everything. All of it, at once.', { swap: 'hesper' }),\n    s('ilya', 'stern', 'Yes, ma\\'am. You will.'),\n  ] },\n  end: { id: 'end', title: 'MORNING', set: 'morning', music: 'credits', cast: ['reyes', 'ilya'], figures: [['ilya', [-0.8, 1.2], 'Idle'], ['sabine', [-2.6, 0.2], 'Idle'], ['reyes', [1, 1.4], 'Sit'], ['pem', [2.6, 0.4], 'Wave']], beats: [\n    s('ilya', 'neutral', 'It stopped raining. Does it do that? I did not know it could do that.', { cam: 'wide', cue: 'bell' }),\n    s('pem', 'smile', \"Boat weather. I'm retiring. Don't look at me like that, I mean it this time.\", { swap: 'pem' }),\n    s('sabine', 'neutral', 'Forty-one names. I can say them now. *Adequate*, Doctor.', { swap: 'sabine', other: 'smile' }),\n    s('ilya', 'sad', 'Nurse Reyes? Does it hurt?', { swap: 'reyes' }),\n    s('reyes', 'stern', 'Everything hurts. My feet, my chest, my opinion of your knots.'),\n    s('reyes', 'smile', \"It's wonderful. Tell anyone I said that and I will end you.\"),\n    s('ilya', 'smile', 'What happens now?'),\n    s('reyes', 'stern', \"You've got a seven a.m.\"),\n  ] },\n};\nEOF\ncat > src/sim/campaign.js <<'EOF'\n// The order of the shift: pure, so a test can walk it. Each entry is a scene or an op.\nexport const CAMPAIGN = [\n  { scene: 'ep1' }, { op: 'op1' }, { scene: 'ep2' }, { op: 'op2' }, { scene: 'ep3' }, { op: 'op3' }, { scene: 'ep4' }, { op: 'op4' }, { scene: 'ep5' }, { op: 'op5' },\n  { scene: 'ep6' }, { op: 'op6' }, { scene: 'ep7' }, { op: 'op7' }, { scene: 'ep8' }, { op: 'op8' }, { scene: 'ep9' }, { op: 'op9' }, { scene: 'ep10' }, { op: 'op10' }, { scene: 'end' }, { credits: true },\n];\nexport const nextOf = (i) => (i + 1 < CAMPAIGN.length ? i + 1 : -1);\nexport function recordOp(save, opId, res) {\n  save.cleared[opId] = true;\n  const order = ['C', 'B', 'A', 'S'];\n  if (!save.ranks[opId] || order.indexOf(res.rank) > order.indexOf(save.ranks[opId])) { save.ranks[opId] = res.rank; }\n  if (res.pristine) save.pristine = { ...save.pristine, [opId]: true };\n  save.scores[opId] = Math.max(save.scores[opId] ?? 0, res.total);\n  return save;\n}\nexport const clearedOps = (save) => Object.keys(save.cleared).filter((k) => save.cleared[k]);\nEOF\ncat > src/stages/stage.js <<'EOF'\n// Base for every screen. Screens are Game classes swapped with engine.loadGame under a transition.\nimport { THREE } from '../../pixel-engine.js';\nimport { app } from '../core/app.js';\nexport const OP_CAMERA = { preset: 'fixed', position: [0, 9.6, 3.1], target: [0, 0, 0.1], fov: 44, minZoom: 1, maxZoom: 1 };\nexport class Stage {\n  name = 'stage';\n  target = new THREE.Vector3();\n  async setup(ctx) { await app.boot(ctx); await this.build(ctx); }\n  build() {}\n  ready(ctx) {\n    if (typeof window !== 'undefined') window.__GAME__ = { app, stage: this, get sim() { return this.stage.sim ?? null; }, goto: (s) => go(s), config: app.config };\n    app.ctx = ctx;\n    this.onReady?.(ctx);\n  }\n  cameraTarget() { return this.target; }\n  status() { return this.name; }\n  dispose() {}\n}\n/** Swap to another stage under a transition. */\nexport async function go(stage, kind = 'fade') {\n  const engine = app.engine;\n  if (app.going) return;\n  app.going = true;\n  try {\n    if (app.engine.manual) { await engine.loadGame(stage); }\n    else {\n      await engine.screen.cover(kind, { duration: 0.22 }).catch(() => {});\n      await engine.loadGame(stage);\n      engine.screen.reveal(kind, { duration: 0.28 });\n    }\n  } finally { app.going = false; }\n}\nexport function setView(ctx, pos, target, fov) {\n  const c = ctx.camera.camera;\n  c.position.set(pos[0], pos[1], pos[2]);\n  c.lookAt(target[0], target[1], target[2]);\n  if (fov && c.fov !== fov) { c.fov = fov; c.updateProjectionMatrix(); }\n}\nEOF\ncat > src/stages/operation.js <<'EOF'\n// The operating stage. Solo/couch: steps the sim in fixedUpdate. Attract: the bot, cheating. Session: a driver feeds state.\nimport { PALETTE, THREE, setLookLayer, buildModel } from '../../pixel-engine.js';\nimport { app } from '../core/app.js';\nimport { Stage, go, setView } from './stage.js';\nimport { createOp, step, drainEvents, cloneState, defOf, dev } from '../sim/op.js';\nimport { createBot, botInput } from '../sim/bot.js';\nimport { results } from '../sim/scoring.js';\nimport { TOOLS } from '../sim/tools.js';\nimport { OPS } from '../content/ops/index.js';\nimport { FieldView, TABLE_GAP } from '../view/field.js';\nimport { HandView } from '../view/hands.js';\nimport { BustView } from '../view/bust.js';\nimport { OpHud } from '../ui/hud.js';\nimport { BTN, deadzone } from '../input/devices.js';\nimport { flickSlot, integrateTip, nearTarget, strokeDir, toolAtSlot } from '../input/cursor.js';\nimport { heightAt } from '../content/arenas.js';\nimport { PauseOverlay } from '../ui/pause.js';\nimport { Fx } from '../view/fx.js';\nimport { MenuFail } from '../ui/fail.js';\n\nconst { Vector3, Mesh, BoxGeometry, MeshBasicMaterial } = THREE;\nconst AIM = { off: 0, low: 0.4, high: 0.8 };\nconst o = new Vector3(), d = new Vector3(), proj = new Vector3();\n\nexport class OperationStage extends Stage {\n  name = 'operation';\n  constructor(opts = {}) {\n    super();\n    this.opts = opts;\n    this.def = OPS[opts.op ?? 'op1'];\n    this.tips = [];\n    this.seatBind = opts.seats ?? [{ device: 'auto' }];\n    this.loops = {}; this.loopOn = {};\n    this.paused = false; this.pause = null; this.ended = null; this.endT = 0; this.fail = null;\n    this.intro = opts.demo ? 0.3 : 1.1;\n    this.quietA = 0; this.smear = 0; this.look = { sat: 1, vig: 0.3, spread: 0 };\n    this.frameStep = 0; this.simSpeed = 1; this.bots = {}; this.hitbox = false; this.speedAcc = 0;\n    this.ekgT = 0; this.heartT = 0; this.tilt = { x: 0, z: 0 }; this.mouseOn = false; this.camX = 0; this.camXTarget = 0;\n  }\n  async build(ctx) {\n    const { engine } = ctx;\n    const seats = this.opts.seats ? this.opts.seats.length : (this.def.seats ?? 1);\n    const cheats = this.opts.demo ? { god: true, infComposure: true, unlimitedMistakes: true, freezeClock: true } : { ...(app.flags.cheats ?? {}) };\n    if (this.opts.state) this.sim = this.opts.state;\n    else {\n      this.sim = this.opts.resume ?? createOp(this.def, { seed: this.opts.seed ?? app.urlFlags.seed ?? 1, seats, difficulty: this.opts.difficulty ?? app.save.difficulty ?? 'resident', stage: this.opts.stage ?? 0, cheats, cfg: app.config, retried: !!this.opts.retried, gifts: this.opts.gifts ?? null });\n      if (this.opts.demo) this.sim.saves = 99;\n    }\n    // Lighting: warm surgical. Much more washes the tissue out.\n    engine.setSunDirection([0.25, 1, 0.35]);\n    engine.sun.intensity = 1; engine.ambient.color.setHex(0xfff0e0); engine.ambient.intensity = 0.55;\n    ctx.scene.background = new THREE.Color(0x0a0a10);\n    this.lamp = ctx.lights.request({ position: [0, 5.2, 0.4], intensity: 5, radius: 15, color: 0xfff6e0 });\n    this.field = new FieldView(ctx, this.def.arena, this.sim.tables.length, this.opts.seed ?? 5);\n    this.hands = this.sim.seats.map((s, i) => new HandView(ctx, this.field, i));\n    this.hud = new OpHud(app, ctx);\n    this.fx = new Fx(ctx, this.field, app);\n    for (const s of this.sim.seats) { this.tips[s.i] = { x: s.x, z: s.z, tool: s.tool, table: s.table, wheelHeld: false, lastMouse: 0, giftLatch: false, flickT: 0 }; }\n    this.ghosts = [];\n    this.loops = {\n      drain: ctx.audio.loop('drainLoop', { volume: 0 }), gel: ctx.audio.loop('gelLoop', { volume: 0 }), laser: ctx.audio.loop('laserLoop', { volume: 0 }), scan: ctx.audio.loop('scanLoop', { volume: 0 }), drone: ctx.audio.loop('drone', { volume: 0 }),\n    };\n    // comm bust, for a real 3D face in the strip\n    this.commBusts = {};\n    this.bustBack = new Mesh(new BoxGeometry(0.34, 0.34, 0.01), new MeshBasicMaterial({ color: 0x1a1f2b }));\n    ctx.scene.add(this.bustBack);\n    if (typeof document !== 'undefined') document.body.style.cursor = 'none';\n    app.director?.play(this.sim.music);\n    if (this.opts.net) this.opts.net.attach(this);\n    app.applyLook(1, 0.3, 0);\n    // Cameras: dive from above.\n    this.updateCamera(ctx, 0);\n  }\n  onReady(ctx) { this.mouseOn = app.devices.last !== 'pad'; void ctx; }\n  status() { const s = this.sim; return `${s.opId} stage=${s.stage} vitals=${Math.round(s.tables[0].vitals)} t=${Math.round(s.clock)} score=${s.score} phase=${s.phase}`; }\n  dispose() { if (typeof document !== 'undefined') document.body.style.cursor = ''; this.opts.net?.detach?.(); }\n\n  /* ---- input ---- */\n  readSeat(ctx, seat, bind, dt) {\n    const tip = this.tips[seat.i], input = ctx.input, devs = app.devices;\n    const out = { x: tip.x, z: tip.z, tool: seat.tool, use: 0, gift: false, steady: false, drop: false, rot: 0, padL: false, padR: false, table: seat.table };\n    const useKbm = bind.device === 'kbm' || bind.device === 'auto';\n    const usePad = typeof bind.device === 'number' || bind.device === 'auto';\n    const pad = usePad ? (typeof bind.device === 'number' ? devs.pads[bind.device] : devs.pads.find(Boolean)) : null;\n    let sx = 0, sz = 0, steady = false, use = 0, gift = false, drop = false, rot = 0;\n    const pickSlot = (i) => { const t = toolAtSlot(i); if (t && this.sim.tools.includes(t)) { out.tool = t; this.hud.wheelT = 1; if (t !== seat.tool) { tip.prevTool = seat.tool; ctx.audio.play('uiMove'); } } else if (t) ctx.audio.play('tick'); };\n    const rotating = seat.grab != null && this.sim.ents.find((e) => e.id === seat.grab)?.goal?.[2] != null;\n    if (pad) {\n      const hit = (b) => pad.buttons[b] > 0.5 && !(pad.prev[b] > 0.5), on = (b) => pad.buttons[b] > 0.5;\n      sx += deadzone(pad.axes[0] ?? 0); sz += deadzone(pad.axes[1] ?? 0);\n      use = Math.max(use, pad.buttons[BTN.R2] ?? 0, on(BTN.CROSS) ? 1 : 0);\n      steady = steady || on(BTN.L1);\n      const l2 = (pad.buttons[BTN.L2] ?? 0) > 0.3, r2 = (pad.buttons[BTN.R2] ?? 0) > 0.3;\n      gift = gift || l2;\n      if (l2) out.padL = true; if (r2) out.padR = true;\n      if (hit(BTN.CIRCLE)) drop = true;\n      if (hit(BTN.R1) && tip.prevTool && this.sim.tools.includes(tip.prevTool)) { const t = tip.prevTool; tip.prevTool = seat.tool; out.tool = t; this.hud.wheelT = 1; }\n      if (hit(BTN.SQUARE) && this.sim.tools.includes('syringe')) { tip.prevTool = seat.tool; out.tool = 'syringe'; this.hud.wheelT = 1; }\n      if (hit(BTN.LEFT)) out.table = (seat.table - 1 + this.sim.tables.length) % this.sim.tables.length;\n      if (hit(BTN.RIGHT)) out.table = (seat.table + 1) % this.sim.tables.length;\n      if (hit(BTN.TRIANGLE)) { if (this.sim.tagOn) out.tag = true; else this.hud.prompt(this.def.patient.objective); }\n      const rx = deadzone(pad.axes[2] ?? 0), ry = deadzone(pad.axes[3] ?? 0);\n      if (rotating) rot += rx;\n      else {\n        const slot = flickSlot(rx, ry);\n        if (slot >= 0) { if (slot !== tip.flick) { pickSlot(slot); tip.flick = slot; this.hud.wheelSlot = slot; } this.hud.wheelT = 1; }\n        else { tip.flick = -1; this.hud.wheelSlot = -1; }\n      }\n    }\n    if (useKbm) {\n      if (input.isDown('KeyD', 'ArrowRight')) sx += 1; if (input.isDown('KeyA', 'ArrowLeft')) sx -= 1;\n      if (input.isDown('KeyS', 'ArrowDown')) sz += 1; if (input.isDown('KeyW', 'ArrowUp')) sz -= 1;\n      if (input.isDown('ShiftLeft', 'ShiftRight')) steady = true;\n      const mL = input.isDown('MouseLeft'), mR = input.isDown('MouseRight'), kJ = input.isDown('KeyJ'), kK = input.isDown('KeyK');\n      if (mL || kJ) { use = 1; out.padL = true; }\n      if (mR || kK) out.padR = true;\n      if (input.wasPressed('MouseRight', 'KeyK')) drop = true;\n      if (input.isDown('Space')) gift = true;\n      for (let i = 1; i <= 8; i++) if (input.wasPressed(`Digit${i}`)) pickSlot(i - 1);\n      if (rotating) { if (input.isDown('KeyQ')) rot -= 1; if (input.isDown('KeyE')) rot += 1; if (input.wheel) rot += Math.sign(input.wheel) * 3; }\n      else {\n        if (input.wasPressed('KeyQ') && tip.prevTool && this.sim.tools.includes(tip.prevTool)) { const t = tip.prevTool; tip.prevTool = seat.tool; out.tool = t; this.hud.wheelT = 1; }\n        if (input.wheel) { const list = TOOLS.filter((t) => this.sim.tools.includes(t)); const at = list.indexOf(seat.tool); const t = list[(at + Math.sign(input.wheel) + list.length) % list.length]; tip.prevTool = seat.tool; out.tool = t; this.hud.wheelT = 1; ctx.audio.play('uiMove'); }\n        if (input.wasPressed('KeyE')) { if (this.sim.tagOn) out.tag = true; else this.hud.prompt(this.def.patient.objective); }\n      }\n      if (input.wasPressed('KeyF') && this.sim.tools.includes('syringe')) { tip.prevTool = seat.tool; out.tool = 'syringe'; this.hud.wheelT = 1; }\n      if (input.wasPressed('Tab')) out.table = (seat.table + 1) % this.sim.tables.length;\n      // clicks on the wheel and table tabs\n      const click = app.devices.click(input);\n      if (click) {\n        for (const h of this.hud.tabHit) if (click.x >= h.x && click.x <= h.x + h.w && click.y >= h.y && click.y <= h.y + h.h) { out.table = h.i; use = 0; }\n        for (const h of this.hud.wheelHit ?? []) if (click.x >= h.x && click.x <= h.x + h.w && click.y >= h.y && click.y <= h.y + h.h) { pickSlot(h.i); use = 0; tip.wheelClick = 0.2; }\n      }\n      if (tip.wheelClick > 0) { tip.wheelClick -= dt; use = 0; }\n      // mouse: the tip follows exactly, on the surface not a plane\n      if (devs.pointerMoved || (this.mouseOn && (mL || mR))) this.mouseOn = true;\n      if (sx || sz) this.mouseOn = false;\n      if (this.mouseOn && input.pointer.over !== false) this.mouseToTip(ctx, tip, seat);\n    }\n    if (pad && (Math.abs(sx) > 0 || Math.abs(sz) > 0)) this.mouseOn = false;\n    const cfg = app.config;\n    const assist = AIM[app.settings.aim] ?? cfg.aimAssist;\n    if (sx || sz) {\n      const near = assist > 0 && nearTarget(this.sim, seat, tip.x, tip.z);\n      integrateTip(tip, sx, sz, { speed: cfg.cursorSpeed * (app.settings.cursor ?? 1), steady, steadyFactor: cfg.steadyFactor, assist, near, stroke: assist > 0 ? strokeDir(this.sim, seat) : null, dt });\n    }\n    if (app.settings.giftToggle) {\n      if (gift && !tip.giftPrev) tip.giftLatch = !tip.giftLatch;\n      tip.giftPrev = gift;\n      gift = tip.giftLatch;\n    }\n    out.x = tip.x; out.z = tip.z; out.use = use; out.gift = gift; out.steady = steady; out.drop = drop; out.rot = rot;\n    if (drop && seat.grab == null) { /* nothing held */ }\n    // Rumble follows the tool.\n    if (use > 0.15 && pad) this.toolRumble(seat, pad, use);\n    return out;\n  }\n  toolRumble(seat, pad, use) {\n    const f = this.ctx0Frame = (this.ctx0Frame ?? 0) + 1;\n    if (f % 6) return;\n    const R = { drain: [0.06, 0.2 * use], gel: [0, 0.1], laser: [0.03, 0.26], scalpel: [0.1, 0.06], suture: [0, 0.05], scanner: [0, 0.04], forceps: [0.12, 0.06], syringe: [0, 0.06] }[seat.tool];\n    if (R) app.devices.rumble(pad.index, R[0], R[1], 90, app.settings.rumble && !app.demo);\n  }\n  mouseToTip(ctx, tip, seat) {\n    const p = ctx.input.pointer;\n    ctx.camera.rayAt(p.x, p.y, o, d);\n    const offset = seat.table * TABLE_GAP;\n    let y = 0, x = 0, z = 0;\n    for (let i = 0; i < 4; i++) { const t = (y - o.y) / d.y; x = o.x + d.x * t; z = o.z + d.z * t; y = heightAt(this.def.arena, x - offset, z, this.field.beat, this.field.breath); }\n    tip.x = Math.max(-7.4, Math.min(7.4, x - offset));\n    tip.z = Math.max(-4, Math.min(3.6, z));\n  }\n\n  gather(ctx, dt) {\n    const sim = this.sim;\n    const inputs = [];\n    for (const seat of sim.seats) {\n      const bind = this.seatBind[seat.i] ?? { device: 'bot', skill: 0.75 };\n      if (bind.device === 'bot' || (this.def.partnerBot && seat.i === 1 && !this.opts.seats) || this.opts.demo || this.botOn) {\n        const key = seat.i;\n        this.bots[key] ??= createBot(key, this.opts.demo ? 0.92 : (seat.i === 0 ? (this.botSkill ?? 0.8) : 0.75), { cheat: !!this.opts.demo, zone: this.def.partnerBot ? (seat.i === 0 ? 'right' : 'left') : null });\n        if (seat.i === 0 && this.botSkill != null) this.bots[key].skill = this.botSkill;\n        const b = botInput(sim, this.bots[key]);\n        inputs[seat.i] = b; this.tips[seat.i].x = b.x; this.tips[seat.i].z = b.z;\n      } else inputs[seat.i] = this.readSeat(ctx, seat, bind, dt);\n    }\n    return inputs;\n  }\n\n  /* ---- fixed step ---- */\n  fixedUpdate(ctx, dt) {\n    if (this.opts.net) { this.opts.net.fixed?.(ctx, dt, this); return; }\n    if (this.paused || this.fail || this.ended) return;\n    if (this.intro > 0) return;\n    if (this.frameStep > 0) this.frameStep--; else if (this.frameFreeze) return;\n    this.speedAcc += this.simSpeed;\n    const inputs = this.gather(ctx, dt);\n    while (this.speedAcc >= 1) {\n      this.speedAcc -= 1;\n      step(this.sim, inputs);\n      for (const i of inputs) if (i) { if (i.tag) i.tag = false; i.drop = false; }\n    }\n    this.frameInputs = inputs;\n  }\n\n  /* ---- per frame ---- */\n  update(ctx, dt) {\n    const devs = app.devices;\n    devs.poll(ctx, dt);\n    const sim = this.net?.state ?? this.sim;\n    if (this.opts.demo) { this.updateDemo(ctx, dt); if (this.exited) return; }\n    else if (!this.opts.net) {\n      if (this.pause) {\n        this.pause.update(ctx, dt);\n        this.pause?.draw(ctx);\n        this.hud.updateComm(0, ctx.audio);\n        this.updateCamera(ctx, 0);\n        this.silenceLoops();\n        return;\n      }\n      if (this.fail) { this.field.update(sim, dt * 0.2); this.fail.update(ctx, dt); this.fail?.draw(ctx, dt); this.silenceLoops(); return; }\n      if (devs.nav.pause && !this.ended && this.intro <= 0) { this.openPause(ctx); return; }\n    }\n    if (this.intro > 0) this.intro -= dt;\n    const events = this.opts.net ? this.opts.net.drain() : drainEvents(sim);\n    this.handleEvents(ctx, events, dt, sim);\n    this.field.update(sim, dt);\n    // Draw hands, one per seat, on their tips.\n    const mine = this.opts.net?.mySeat ?? 0;\n    sim.seats.forEach((seat, i) => {\n      const h = this.hands[i];\n      if (!h) return;\n      h.update(seat, dt, sim);\n      h.setVisible(!seat.out);\n    });\n    this.updateGhosts(ctx, sim, dt);\n    this.updateMood(ctx, sim, dt);\n    this.updateCamera(ctx, dt, sim, mine);\n    this.updateBust(ctx, dt);\n    this.updateSound(ctx, sim, dt);\n    // Bot view: dev action stays cheap\n    const tipOf = sim.seats[mine] ?? sim.seats[0];\n    this.hud.wheelT = Math.max(0, this.hud.wheelT - dt);\n    this.drawHud(ctx, sim, dt, tipOf);\n    this.fx.update(dt);\n    if (sim.phase === 'won' || sim.phase === 'lost') this.onEnd(ctx, sim, dt);\n    if (this.hitbox) this.drawHitbox(ctx, sim);\n  }\n  drawHud(ctx, sim, dt, seat) {\n    const hud = ctx.hud;\n    this.hud.draw(sim, dt, null, { objective: this.def.patient.objective, mySeat: seat.i, def: this.def });\n    const mark = sim.hint;\n    if (mark && !sim.noHint && (sim.phase === 'play')) {\n      const p = this.toScreen(mark.x + seat.table * TABLE_GAP, this.field.surface(mark.x, mark.z) + 0.4, mark.z);\n      const y = p.y - 10 + Math.sin(this.field.t * 6) * 2;\n      hud.sprite(Math.round(p.x) - 4, Math.round(y), ['....x....', '...xxx...', '..xxxxx..', '.xxxxxxx.', 'xxxxxxxxx', '.xxxxxxx.', '..xxxxx..', '...xxx...', '....x....'], { x: 0xffd24d });\n    }\n    // Pulse the valid targets softly.\n    const pulse = Math.floor(this.field.t * 3) % 2;\n    if (pulse) for (const e of sim.ents) {\n      if (e.table !== seat.table) continue;\n      if (e.scan && !e.seen) continue;\n      if (e.hiddenBy) continue;\n      const tool = e.needTool ?? null;\n      void tool;\n    }\n    // Seat icons in co-op\n    if (sim.seats.length > 1) sim.seats.forEach((s) => {\n      const p = this.toScreen(s.x + s.table * TABLE_GAP, this.field.surface(s.x, s.z) + 0.2, s.z);\n      const col = (this.opts.net?.colors?.[s.i]) ?? [0x57c7ff, 0xff6b6b, 0x7fffa0, 0xffd24d][s.i];\n      hud.rect(Math.round(p.x) + 5, Math.round(p.y) - 8, 3, 3, col);\n      const ic = s.tool.slice(0, 3).toUpperCase();\n      hud.text(Math.round(p.x) + 9, Math.round(p.y) - 9, ic, { color: col });\n    });\n    // Prompts strip (bottom-left over the strip, right of the bust)\n    if (!this.opts.demo && !this.opts.net && sim.phase === 'play') {\n      // Keep it short: only when nothing's being said.\n      if (!this.hud.current && !this.hud.comm.length && !sim.voiceOff) app.prompts.strip(hud, 36, hud.height - 11, [['use', 'USE'], ['drop', 'DROP'], ['steady', 'STEADY'], ...(sim.giftOn ? [['gift', sim.seats[0].gift === 'look' ? 'LOOK' : 'QUIET']] : []), ['pause', 'PAUSE']]);\n    }\n    // Draw any overlay from net\n    this.opts.net?.drawOverlay?.(ctx, sim);\n  }\n  toScreen(x, y, z) {\n    const cam = this.ctx?.camera?.camera ?? app.ctx.camera.camera, hud = app.ctx.hud;\n    proj.set(x, y, z).project(cam);\n    return { x: ((proj.x + 1) / 2) * hud.width, y: ((1 - proj.y) / 2) * hud.height };\n  }\n  updateCamera(ctx, dt, sim = this.sim) {\n    const seat = sim.seats[this.opts.net?.mySeat ?? 0] ?? sim.seats[0];\n    this.camXTarget = seat.table * TABLE_GAP;\n    this.camX += (this.camXTarget - this.camX) * Math.min(1, dt * 7);\n    const asp = ctx.hud.width / ctx.hud.height, zoom = Math.max(1, (16 / 9) / asp);\n    this.tilt.x += ((seat.x / 8) * 0.25 - this.tilt.x) * Math.min(1, dt * 3);\n    this.tilt.z += ((seat.z / 5) * 0.25 - this.tilt.z) * Math.min(1, dt * 3);\n    const f = Math.max(0, this.intro) / 1.1, e = f * f;\n    const px = this.camX + this.tilt.x, py = 9.6 * zoom + e * 8, pz = 3.1 * zoom + this.tilt.z + e * 7;\n    setView(ctx, [px, py, pz], [this.camX + this.tilt.x * 0.5, 0, 0.1 + this.tilt.z * 0.3], 44);\n    this.lamp.position.set(this.camX, 5.2, 0.4);\n  }\n  updateMood(ctx, sim, dt) {\n    const target = sim.quiet ? 1 : 0;\n    this.quietA += (target - this.quietA) * Math.min(1, dt * 6);\n    this.smear = Math.max(0, this.smear - dt * 1.5);\n    const sat = 1 - this.quietA * 0.75, vig = 0.3 + this.quietA * 0.65, spread = this.smear * 0.02;\n    const L = this.look;\n    if (Math.abs(L.sat - sat) + Math.abs(L.vig - vig) + Math.abs(L.spread - spread) > 0.004) { L.sat = sat; L.vig = vig; L.spread = spread; app.applyLook(sat, vig, spread); }\n    // lamp flicker below 15\n    const v = sim.tables[sim.seats[0].table]?.vitals ?? 50;\n    this.lamp.intensity = v < 15 && !app.settings.reduceFlash ? 5 - (Math.floor(this.field.t * 13) % 3 === 0 ? 2.8 : 0) : 5;\n  }\n  updateBust(ctx, dt) {\n    const comm = this.hud.current;\n    const who = comm?.who ?? null;\n    if (who && !this.commBusts[who]) { this.commBusts[who] = new BustView(ctx, who); const r = this.commBusts[who].root; r.scale.setScalar(0.13); }\n    const cam = ctx.camera.camera;\n    const hud = ctx.hud, asp = hud.width / hud.height, D = 2, hh = Math.tan((44 * Math.PI) / 360) * D, hw = hh * asp;\n    const nx = -1 + (17 / hud.width) * 2, ny = -1 + (15 / hud.height) * 2;\n    for (const [id, b] of Object.entries(this.commBusts)) {\n      const on = id === who;\n      b.root.visible = on;\n      if (!on) continue;\n      b.update(dt);\n      if (comm.talk > 0) b.talk(0.8);\n      const m = /[!*]/.test(comm.text) ? (id === 'ilya' ? 'panic' : 'angry') : id === 'ilya' ? 'neutral' : 'stern';\n      if (b.emotion !== m) b.setEmotion(m);\n      b.root.position.set(nx * hw, ny * hh - 0.14, -D);\n      cam.localToWorld(b.root.position);\n      b.root.quaternion.copy(cam.quaternion);\n    }\n    this.bustBack.visible = !!who;\n    this.bustBack.position.set(nx * hw, ny * hh, -D - 0.1);\n    cam.localToWorld(this.bustBack.position);\n    this.bustBack.quaternion.copy(cam.quaternion);\n  }\n  updateGhosts(ctx, sim, dt) {\n    if (sim.ghost) {\n      sim.seats.forEach((s, i) => {\n        const tr = sim.ghost.seats[i];\n        if (!tr) return;\n        const k = sim.ghost.i * 3;\n        if (k + 1 >= tr.length) return;\n        this.ghosts[i] ??= (() => { const g = new HandView(ctx, this.field, i); g.setGhost(); return g; })();\n        this.ghosts[i].setVisible(true);\n        this.ghosts[i].update({ x: tr[k], z: tr[k + 1], tool: s.tool, table: s.table, useHeld: !!tr[k + 2], drawing: 0, grab: null }, dt, sim);\n      });\n    } else this.ghosts.forEach((g, i) => { if (i !== 9) g?.setVisible(false); });\n    if (sim.mimic?.x != null) {\n      this.mimicHand ??= (() => { const g = new HandView(ctx, this.field, 0); g.setGhost(); return g; })();\n      this.mimicHand.setVisible(true);\n      this.mimicHand.update({ x: sim.mimic.x, z: sim.mimic.z, tool: sim.seats[0].tool, table: 0, useHeld: !!sim.mimic.use, drawing: 0, grab: null }, dt, sim);\n    } else this.mimicHand?.setVisible(false);\n  }\n  silenceLoops() { for (const v of Object.values(this.loops)) v.set({ volume: 0 }); }\n  updateSound(ctx, sim, dt) {\n    const L = this.loopOn;\n    const vol = (name, on, v = 1) => this.loops[name]?.set({ volume: on ? v : 0 });\n    const seat = sim.seats[this.opts.net?.mySeat ?? 0] ?? sim.seats[0];\n    vol('drain', L.drain, 0.9); this.loops.drain?.set({ pitch: seat.useHeld ? 2 : 0 });\n    vol('gel', L.gel, 0.8); vol('laser', L.laser, 0.8); vol('scan', seat.tool === 'scanner' && seat.useHeld, 0.8); vol('drone', sim.quiet, 1);\n    this.loopOn = {};\n    // EKG beep: rate and pitch follow vitals\n    const v = sim.tables[seat.table]?.vitals ?? 50;\n    if (sim.phase === 'play' && !sim.voiceOff) {\n      this.ekgT -= dt * (sim.quiet ? 0.25 : 1);\n      if (this.ekgT <= 0) { this.ekgT = v < 30 ? 0.42 : v < 60 ? 0.7 : 0.95; ctx.audio.play(v < 30 ? 'beepLow' : 'beep', { pitch: v < 30 ? 2 : 0 }); }\n    }\n    if (sim.quiet) { this.heartT -= dt; if (this.heartT <= 0) { this.heartT = 0.9; ctx.audio.play('heartbeat'); app.rumble(0.4, 0.1, 120); } }\n    app.director?.update(dt, sim.phase === 'play' ? v : null, sim.music);\n  }\n  handleEvents(ctx, events, dt, sim) {\n    const audio = ctx.audio;\n    for (const e of events) {\n      switch (e.t) {\n        case 'say': this.hud.say(e.who, e.text); break;\n        case 'prompt': this.hud.prompt(e.text); audio.play('reveal'); break;\n        case 'sfx': if (e.id === 'tick') audio.play('tick'); else if (e.id) audio.play(e.id, { pan: e.x ? Math.max(-0.7, Math.min(0.7, e.x / 8)) : 0 }); break;\n        case 'loop': if (e.on) this.loopOn[e.id] = true; break;\n        case 'beam': this.loopOn.laser = true; if (e.on) { this.fx.smoke(e.x + e.table * TABLE_GAP, this.field.surface(e.x, e.z), e.z); } break;\n        case 'scan': break;\n        case 'rate': { const p = this.toScreen(e.x + (sim.seats[e.seat]?.table ?? 0) * TABLE_GAP, this.field.surface(e.x, e.z) + 0.5, e.z); this.hud.rating(e.r, p.x, p.y, e.pts, e.streak); audio.play(e.r === 'CLEAN' ? 'rateClean' : e.r === 'GOOD' ? 'rateGood' : e.r === 'SLOPPY' ? 'rateSloppy' : 'rateMistake', { pitch: e.r === 'CLEAN' ? Math.min(12, (e.streak ?? 0)) : 0 }); if (e.r === 'MISTAKE') { app.shake(0.5); app.rumble(0.8, 0.5, 220); app.flash('red', { duration: 0.1 }); } if (e.r === 'CLEAN' && e.streak % 5 === 0 && e.streak > 0 && !sim.voiceOff) this.hud.say('reyes', LINE_CLEAN[(e.streak / 5) % LINE_CLEAN.length]); break; }\n        case 'stitch': audio.play('stitch', { pitch: (e.n ?? 0) * 1.2 }); this.fx.sparkAt(e.x + (e.table ?? 0) * TABLE_GAP, this.field.surface(e.x, e.z), e.z); app.rumble(0, 0.3, 40); break;\n        case 'cutting': if (Math.floor(this.field.t * 18) !== this.lastSlice) { this.lastSlice = Math.floor(this.field.t * 18); audio.play('slice'); this.fx.blood(e.x + (e.table ?? 0) * TABLE_GAP, this.field.surface(e.x, e.z), e.z, 2); } break;\n        case 'done': this.fx.done(e, sim); break;\n        case 'dish': this.fx.toDish(e, sim.seats[e.seat]?.table ?? 0); audio.play('tink', { pitch: Math.random() * 3 - 1 }); app.rumble(0.2, 0.2, 60); break;\n        case 'placed': this.field.addPlaced(e); app.rumble(0.4, 0.2, 70); app.shake(0.1); break;\n        case 'pinkUp': this.field.pinkUp(); audio.play('reveal'); break;\n        case 'grab': app.rumble(0.3, 0.1, 40); break;\n        case 'stage': break;\n        case 'music': app.director?.play(e.id); break;\n        case 'quiet': if (e.on) { audio.play('inhale'); ctx.engine.screen.shockwave([0, 1, 0], { strength: 0.3 }); } break;\n        case 'look': audio.play('rewind'); this.smear = 1; app.flash('plum', { duration: 0.25 }); app.rumble(0.3, 0.6, 450); this.hud.popups.length = 0; break;\n        case 'codeblue': if (e.on) { audio.play('flatline'); app.flash('red', { duration: 0.2 }); app.shake(0.4); } else { audio.play('reveal'); this.hud.say('pem', 'And he is back. Rhythm is ugly but it is a rhythm.'); } break;\n        case 'shock': if (e.good) { audio.play('clear'); app.flash('white', { duration: 0.16 }); ctx.engine.hitstop(0.08); app.shake(0.7); app.rumble(1, 1, 300); this.hud.say('ilya', 'CLEAR!'); } else { audio.play('shockBad'); app.shake(0.3); app.rumble(0.3, 0.1, 120); } break;\n        case 'massage': if (e.on) audio.play('flatline'); break;\n        case 'squeeze': audio.play('squeeze'); app.shake(0.3); app.rumble(0.7, 0.4, 120); break;\n        case 'beat': app.rumble(0.25, 0, 60); break;\n        case 'knock': this.fx.knock(e.x, e.z); app.shake(0.3); app.rumble(0.5, 0.2, 110); break;\n        case 'strainHit': this.fx.strainHit(e); app.flash('white', { duration: 0.06 }); ctx.engine.hitstop(0.05); app.shake(0.45); app.rumble(0.8, 0.6, 180); break;\n        case 'strainDead': this.fx.strainDead(e); audio.play('strainHurt', { pitch: -6 }); app.shake(0.8); app.rumble(1, 1, 500); ctx.engine.hitstop(0.1); break;\n        case 'wave': app.flash('blue', { duration: 0.2 }); app.shake(0.8); app.rumble(1, 0.6, 350); break;\n        case 'fx': this.storyFx(ctx, e.id); break;\n        case 'table': audio.play('uiMove'); break;\n        case 'tool': this.hud.wheelT = 1; break;\n        case 'tag': audio.play('reveal'); this.hud.prompt(e.doctor === 'ilya' ? 'DR. MARSH: THE QUIET' : 'DR. ACHTERBERG: THE SECOND LOOK'); break;\n        case 'inject': this.fx.inject(e.x + (e.table ?? 0) * TABLE_GAP, this.field.surface(e.x, e.z), e.z); break;\n        case 'lowVitals': audio.play('alarm'); break;\n        case 'bpm': app.director?.setBpm(e.bpm); break;\n        case 'won': case 'lost': break;\n        default: break;\n      }\n    }\n    void dt;\n  }\n  storyFx(ctx, id) {\n    if (id === 'awaken') { app.flash('white', { duration: 0.4 }); ctx.audio.stopMusic?.(); ctx.audio.play('heartbeat'); ctx.engine.screen.shockwave([0, 1, 0], { strength: 0.6 }); }\n    if (id === 'truth') { app.flash('red', { duration: 0.5 }); app.shake(1); }\n    if (id === 'silence') { ctx.audio.playMusic(null); }\n    if (id === 'burst') { app.flash('red', { duration: 0.25 }); app.shake(0.7); }\n    if (id === 'reyesBack') { ctx.audio.play('reveal'); }\n  }\n  openPause(ctx) { this.paused = true; this.pause = new PauseOverlay(this, ctx); ctx.audio.play('uiConfirm'); if (typeof document !== 'undefined') document.body.style.cursor = ''; }\n  closePause() { this.paused = false; this.pause = null; if (typeof document !== 'undefined') document.body.style.cursor = 'none'; }\n\n  /* ---- ends ---- */\n  onEnd(ctx, sim, dt) {\n    if (this.opts.net) return;\n    if (this.opts.demo) return;\n    this.endT += dt;\n    if (this.ended == null) {\n      this.ended = sim.phase;\n      if (sim.phase === 'lost') { ctx.audio.play('flatline'); app.director?.play('sad'); this.hud.say('reyes', 'Time of death...'); this.silenceLoops(); } else { app.director?.play('results'); this.silenceLoops(); }\n    }\n    if (sim.phase === 'lost' && this.endT > 1.2 && !this.fail) {\n      this.fail = new MenuFail(this, ctx);\n      if (typeof document !== 'undefined') document.body.style.cursor = '';\n    }\n    if (sim.phase === 'won' && this.endT > 1.4 && !this.leaving) {\n      this.leaving = true;\n      this.opts.onWin?.(results(sim, this.def), sim);\n    }\n  }\n  /** Retry from this stage: rank capped at B. */\n  retryStage() {\n    const cp = this.sim.checkpoint;\n    if (!cp) { this.restart(); return; }\n    const copy = structuredClone(cp);\n    Object.assign(copy, { cfg: app.config, events: [], ring: [], checkpoint: cp, meta: this.sim.meta ?? {}, retried: true, checkpointStage: this.sim.checkpointStage });\n    go(new OperationStage({ ...this.opts, resume: copy, stage: 0, retried: true }));\n  }\n  restart() { go(new OperationStage({ ...this.opts, resume: null, stage: 0, retried: false, difficulty: this.nextDifficulty ?? this.opts.difficulty })); }\n\n  updateDemo(ctx, dt) {\n    this.demoT = (this.demoT ?? 0) + dt;\n    if (app.devices.anyInput && this.demoT > 0.3) { this.exited = true; app.exitAttract?.(); return; }\n    if (this.demoT > (this.opts.demo.secs ?? 25) || this.sim.phase === 'won' || this.sim.phase === 'lost') { this.exited = true; app.nextAttract?.(); }\n  }\n  drawHitbox(ctx, sim) {\n    const hud = ctx.hud;\n    for (const e of sim.ents) {\n      const p = this.toScreen(e.x + (e.table ?? 0) * TABLE_GAP, this.field.surface(e.x, e.z), e.z);\n      hud.rect(Math.round(p.x) - 1, Math.round(p.y) - 1, 3, 3, 0x7fff00);\n      hud.text(Math.round(p.x) + 3, Math.round(p.y) - 3, `${e.id}:${e.k}`, { color: 0x7fff00 });\n    }\n  }\n}\nconst LINE_CLEAN = [\"...Adequate. Don't let it go to your head. It's not attached to anything useful.\", 'Fine. Do it again, so I know it was not an accident.', 'Hm. Someone taught you something.'];\nvoid PALETTE; void setLookLayer; void buildModel; void cloneState; void defOf; void dev;\nEOF\necho ok","description":"Write script, campaign, base stage and operation stage"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12416,"cache_read_input_tokens":310814,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12416},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9464247a-cdba-4289-905c-cd8b34e5d270","uuid":"94089327-f070-4495-9331-d5513cc409b9","timestamp":"2026-11-05T16:57:27.239Z","request_id":"req_011Cgk8Z8KFjLKG5ACimZAQq","wire_tool_inputs":{"toolu_0135iA9DTFJCFq4dDd4i2eyG":{"command":"cat > src/content/scenes/index.js <<'EOF'\n// The script. Scenes are data: { id, set, music, cast:[left,right], beats:[{ who, emo, say, cam, cue }] }.\n// `other` sets the listener's face. `cam:'wide'` cuts to the room with full-body figures; `cue` is a sound.\nconst s = (who, emo, say, extra = {}) => ({ who, emo, say, ...extra });\nexport const SCENES = {\n  ep1: { id: 'ep1', title: 'NIGHT SHIFT', set: 'or7', music: 'title', cast: ['reyes', 'ilya'], figures: [['ilya', [-1.6, 1.8], 'Idle'], ['reyes', [1.6, 1.6], 'Shout']], beats: [\n    s('ilya', 'neutral', '3 A.M. Rain. Everyone sensible is asleep.', { cam: 'wide', cue: 'horn' }),\n    s('reyes', 'stern', 'You. Yes, you. The one holding the coffee.', { cue: 'tick', other: 'shock' }),\n    s('ilya', 'shock', 'Me? Is the Chief...? Dr. Bram is on call, I just...'),\n    s('reyes', 'stern', \"The Chief isn't answering. Storm took the bridge out. You're the surgeon.\", { other: 'panic' }),\n    s('ilya', 'panic', \"I'm a second-year! I have held a liver *twice!*\"),\n    s('reyes', 'angry', 'Trawler deckhand. Tomasz Dolan. Eleven fishhooks, one arm. Scrub.'),\n    s('ilya', 'shock', 'How do you get eleven fishhooks in one arm?'),\n    s('reyes', 'neutral', 'It was a long net.'),\n    s('ilya', 'panic', 'I can do this. I can do this. Nurse Reyes, can I do this?', { other: 'stern' }),\n    s('reyes', 'stern', 'Find out. Coffee down, Doctor. *The patient is the other way.*'),\n  ] },\n  ep2: { id: 'ep2', title: 'MORNING ROUNDS', set: 'ward', music: 'ward', cast: ['pem', 'ilya'], figures: [['ilya', [-1.2, 1.4], 'Idle'], ['pem', [1.2, 1.2], 'Idle'], ['reyes', [3, 0.2], 'Idle']], beats: [\n    s('ilya', 'neutral', 'Bed four. Post-op day... two. Three? The chart is upside down.', { cam: 'wide', cue: 'bell' }),\n    s('pem', 'smile', 'Morning, Doctor. Patient in bed four is sleeping like a baby. A very expensive baby.'),\n    s('ilya', 'panic', 'Dr. Okoye, I think I presented that whole case to a coat rack.'),\n    s('pem', 'smile', \"It's a good coat rack. It made consultant last year.\"),\n    s('reyes', 'stern', 'Dr. Marsh. Admission. Stage magician. He swallowed something during his act.', { who2: 'reyes' }),\n    s('ilya', 'shock', 'Swallowed what?'),\n    s('reyes', 'stern', 'He says a magician never reveals his secrets. He says it *while vomiting.*'),\n    s('pem', 'smile', 'The Great Zamboni. I saw him in 1998. I still have no idea where my watch went.'),\n    s('ilya', 'neutral', 'How bad can it be? It is a prop. It is a funny prop.'),\n    s('pem', 'neutral', 'Patient is under. And I would like my watch back, if you see it.'),\n  ] },\n  ep3: { id: 'ep3', title: 'MASS CASUALTY', set: 'corridor', music: 'or-tense', cast: ['bram', 'ilya'], figures: [['bram', [0.8, 1.4], 'Idle'], ['ilya', [-1, 1.8], 'Idle'], ['reyes', [-2.8, 0.4], 'Shout']], beats: [\n    s('reyes', 'angry', 'Ferry collision at the harbour mouth! Forty in the water! Move, *move!*', { cam: 'wide', cue: 'alarm' }),\n    s('ilya', 'panic', 'All of these? All of these are ours?'),\n    s('bram', 'stern', 'Marsh. You will take OR-7. Three tables. These are your charts.', { other: 'shock' }),\n    s('ilya', 'shock', 'Sir, your hand. Your hand is shaking.'),\n    s('bram', 'stern', 'It is cold. Medicine is not miracles, son. It is showing up again tomorrow.'),\n    s('ilya', 'panic', 'Three tables. I have two hands. Sir, I have only got *two hands!*'),\n    s('bram', 'neutral', 'Then you will want to use both.'),\n    s('reyes', 'stern', 'Doctor. Table A is a leg. Table B is burns. Table C is not good. Go.'),\n  ] },\n  ep4: { id: 'ep4', title: 'AFTERMATH', set: 'office', music: 'ward', cast: ['bram', 'ilya'], figures: [['bram', [-0.4, -1.2], 'Sit'], ['ilya', [0.8, 1.2], 'Idle'], ['sabine', [-2.6, 1.2], 'Idle']], beats: [\n    s('bram', 'stern', 'Close the door. How long did the room go quiet?', { cam: 'wide', cue: 'horn' }),\n    s('ilya', 'shock', 'Sir? It was... I don\\'t... Everything went slow. I could see all of it.'),\n    s('bram', 'sad', 'I know. I know you could. Do not tell anyone how long.', { other: 'shock' }),\n    s('bram', 'stern', 'The Mercy Foundation complained to the board. They fund half this building.'),\n    s('ilya', 'panic', 'Complained about what? I saved three people!'),\n    s('bram', 'neutral', 'So they sent a consultant. To audit you. She is standing behind you.'),\n    s('sabine', 'neutral', 'Dr. Achterberg. You have two options, Doctor.', { swap: 'sabine', other: 'shock' }),\n    s('ilya', 'shock', 'What are they?'),\n    s('sabine', 'stern', 'You let me watch you work. The second one is also that.'),\n    s('sabine', 'neutral', 'Ollie Brandt. Sixteen. Ferry survivor. Six bone fragments, one cello. I will be on the intercom.'),\n    s('ilya', 'panic', 'Nurse Reyes? Can I do this?'),\n    s('reyes', 'stern', \"Don't look at me, Doctor. I just work here. For twenty-six years.\", { swap: 'reyes' }),\n  ] },\n  ep5: { id: 'ep5', title: 'THE SMILING WARD', set: 'ward', music: 'ward', cast: ['anselm', 'ilya'], figures: [['ilya', [-1.4, 1.4], 'Idle'], ['anselm', [1.6, 1], 'Wave'], ['sabine', [3.4, 0.2], 'Idle']], beats: [\n    s('ilya', 'neutral', 'Mr. Anselm? Harbour pilot, fifty-eight. Your scan is... Sir, how do you feel?', { cam: 'wide', cue: 'bell' }),\n    s('anselm', 'smile', 'Wonderful! Never better. Isn\\'t it wonderful, Doctor?', { other: 'shock' }),\n    s('ilya', 'shock', 'Your abdomen is like a bag of knives. You should be screaming.'),\n    s('anselm', 'smile', 'I know! I fell off the pilot boat in March. Didn\\'t feel a thing.'),\n    s('ilya', 'stern', 'Does anything hurt? Anywhere? At all?'),\n    s('anselm', 'smile', 'The nice people at the hospice gave me a course. *No one should hurt.* Isn\\'t it wonderful?'),\n    s('ilya', 'shock', \"He's smiling. They're all smiling. Dr. Achterberg, this whole bay is smiling.\"),\n    s('sabine', 'stern', '...', { swap: 'sabine' }),\n    s('sabine', 'stern', 'Take him to OR-7. Take him now. Do not let him sign anything.'),\n  ] },\n  ep6: { id: 'ep6', title: 'THE FILE', set: 'scrub', music: 'ward', cast: ['sabine', 'ilya'], figures: [['sabine', [-1, 0.8], 'Idle'], ['ilya', [1.2, 1.2], 'Idle']], beats: [\n    s('ilya', 'panic', 'It knocked. I am a doctor and I am telling you that the man\\'s liver knocked.', { cam: 'wide', cue: 'knock' }),\n    s('sabine', 'neutral', 'I know. I have heard it. Nine years ago, at a relief camp, in the flood.'),\n    s('sabine', 'stern', 'Forty-one patients, all smiling. All dead by the weekend. They blamed the surgeon.'),\n    s('ilya', 'shock', 'They blamed... That was you.'),\n    s('sabine', 'stern', 'Metabolic Endo-Receptor Cytoform, type Y. M-E-R-C-Y. It kills pain by rewiring the nerves.', { other: 'shock' }),\n    s('sabine', 'neutral', 'Then it eats. They call it Mercy. *Show it none, Doctor.*'),\n    s('ilya', 'panic', 'A foundation made this? On purpose? The hospice with the nice logo?'),\n    s('sabine', 'neutral', 'Dr. Okoye\\'s sister needs a kidney. The donor organ came from their bank.'),\n    s('ilya', 'shock', \"Then let me scrub in. I'll...\"),\n    s('sabine', 'stern', 'No. You have done enough for one week. My hands. My case. *Watch.*'),\n  ] },\n  ep7: { id: 'ep7', title: 'THE VISIT', set: 'atrium', music: 'ward', cast: ['hesper', 'ilya'], figures: [['hesper', [0.6, 1], 'Wave'], ['ilya', [-1.4, 1.6], 'Idle'], ['reyes', [-3, 0.8], 'Idle']], beats: [\n    s('hesper', 'smile', 'Dr. Marsh. I brought flowers. And a new cardiac wing, if your board agrees.', { cam: 'wide', cue: 'bell', other: 'shock' }),\n    s('ilya', 'stern', 'Dr. Lindqvist. There is something in your hospice patients. It lays eggs.'),\n    s('hesper', 'smile', 'Have you ever sat with someone at the very end, Doctor? Truly sat?'),\n    s('hesper', 'neutral', 'Pain is only the body begging. I simply taught it to stop.'),\n    s('ilya', 'angry', 'It eats them! They die smiling and it *eats* them!'),\n    s('hesper', 'neutral', 'Everyone dies. I asked what it should feel like. No one else was asking.'),\n    s('hesper', 'smile', 'No one should hurt, Doctor. Not even you. Think about the wing.'),\n    s('reyes', 'shock', 'Doctor. Admission. Ottilie Marr. Hospice nurse. She... she is my oldest friend.', { swap: 'reyes', other: 'shock', cue: 'alarm' }),\n    s('reyes', 'stern', 'Thirty years she has told me her feet hurt. Today she told me she is fine.'),\n    s('reyes', 'stern', '*Get in there, Doctor.* I am scrubbing. Do not look at me.'),\n  ] },\n  ep8: { id: 'ep8', title: 'THE CONFESSION', set: 'office', music: 'ward', cast: ['bram', 'ilya'], figures: [['bram', [-0.4, -1.2], 'Sit'], ['ilya', [0.8, 1.2], 'Idle'], ['sabine', [2.6, 0.6], 'Idle']], beats: [\n    s('bram', 'sad', 'There are two names on the founding paper. Lindqvist is the first.', { cam: 'wide', cue: 'horn', other: 'shock' }),\n    s('ilya', 'shock', 'Sir. Sir, no.'),\n    s('bram', 'sad', 'Eleven years ago. We wanted to end suffering. We were very clever and very young.'),\n    s('bram', 'stern', 'At dawn she releases it on the harbour ferries. As an aerosol. Forty thousand commuters.'),\n    s('sabine', 'stern', 'You have known this. How long have you known this?', { swap: 'sabine' }),\n    s('bram', 'neutral', 'I used to go quiet too, Marsh. Better than you. I thought it was God.'),\n    s('bram', 'shock', 'It was never a gift, in my case. My hand. It was never *cold.*'),\n    s('ilya', 'panic', 'Sir? Sir! Reyes! *REYES!*', { cue: 'flatline' }),\n    s('bram', 'sad', 'It is in my heart, son. It has been feeding my Quiet for eleven years.'),\n    s('bram', 'stern', 'My old scalpel. Top drawer. Take it. And Marsh.'),\n    s('bram', 'angry', \"*Don't you dare be gentle.*\"),\n  ] },\n  ep9: { id: 'ep9', title: 'THE ROOF', set: 'roof', music: 'or-critical', cast: ['hesper', 'ilya'], figures: [['hesper', [2.4, -1.2], 'Idle'], ['ilya', [-1.4, 1.6], 'Idle'], ['sabine', [-3, 1], 'Idle'], ['reyes', [-0.2, 2.6], 'Idle']], beats: [\n    s('ilya', 'angry', 'Dr. Lindqvist! Step away from the canister!', { cam: 'wide', cue: 'horn' }),\n    s('hesper', 'neutral', 'I have no weapon, Doctor. There is only rain, and one very tired woman.'),\n    s('sabine', 'stern', 'It is finished. The ferries are stopped. I have the valve. Step back.', { swap: 'sabine' }),\n    s('hesper', 'smile', \"You can't cure me of being right.\", { other: 'angry' }),\n    s('ilya', 'panic', 'The seal! Dr. Achterberg, it\\'s cracked, the *seal is cracked!*', { cue: 'alarm' }),\n    s('reyes', 'stern', 'Get the boy down! Marsh, *move* that stretcher!', { swap: 'reyes', cue: 'wave' }),\n    s('ilya', 'panic', 'Nurse Reyes? You\\'re standing in it. You are standing right in it!'),\n    s('reyes', 'stern', \"Yes, I can see that. I've got eyes. Take the patient.\"),\n    s('reyes', 'smile', '...Huh. My feet have stopped hurting.'),\n    s('reyes', 'stern', 'Start without me, Doctor. Your *sutures* had better be straight.', { other: 'panic' }),\n    s('ilya', 'panic', 'Reyes? REYES!', { cue: 'flatline' }),\n  ] },\n  ep10: { id: 'ep10', title: 'THE STRETCHER', set: 'or7', music: 'op10', cast: ['hesper', 'ilya'], figures: [['ilya', [-1.6, 1.4], 'Idle'], ['sabine', [1.8, 1.8], 'Idle'], ['pem', [2.6, 0.4], 'Idle']], beats: [\n    s('pem', 'neutral', 'Dr. Lindqvist. Found on the roof, in the rain. She is dying. Sooner than you would like.', { swap: 'pem', cam: 'wide', cue: 'bell' }),\n    s('sabine', 'stern', 'Her scan is eleven years deep. She took it. She took it *first.*', { swap: 'sabine' }),\n    s('hesper', 'smile', 'I would never ask anything of others that I would not take myself. Would you?', { swap: 'hesper' }),\n    s('ilya', 'neutral', 'Everyone is looking at me.'),\n    s('sabine', 'neutral', 'You have two options, Doctor.', { swap: 'sabine' }),\n    s('ilya', 'neutral', 'I know. Scrub in.'),\n    s('hesper', 'neutral', 'It will not be gentle, taking it out. I will feel everything. All of it, at once.', { swap: 'hesper' }),\n    s('ilya', 'stern', 'Yes, ma\\'am. You will.'),\n  ] },\n  end: { id: 'end', title: 'MORNING', set: 'morning', music: 'credits', cast: ['reyes', 'ilya'], figures: [['ilya', [-0.8, 1.2], 'Idle'], ['sabine', [-2.6, 0.2], 'Idle'], ['reyes', [1, 1.4], 'Sit'], ['pem', [2.6, 0.4], 'Wave']], beats: [\n    s('ilya', 'neutral', 'It stopped raining. Does it do that? I did not know it could do that.', { cam: 'wide', cue: 'bell' }),\n    s('pem', 'smile', \"Boat weather. I'm retiring. Don't look at me like that, I mean it this time.\", { swap: 'pem' }),\n    s('sabine', 'neutral', 'Forty-one names. I can say them now. *Adequate*, Doctor.', { swap: 'sabine', other: 'smile' }),\n    s('ilya', 'sad', 'Nurse Reyes? Does it hurt?', { swap: 'reyes' }),\n    s('reyes', 'stern', 'Everything hurts. My feet, my chest, my opinion of your knots.'),\n    s('reyes', 'smile', \"It's wonderful. Tell anyone I said that and I will end you.\"),\n    s('ilya', 'smile', 'What happens now?'),\n    s('reyes', 'stern', \"You've got a seven a.m.\"),\n  ] },\n};\nEOF\ncat > src/sim/campaign.js <<'EOF'\n// The order of the shift: pure, so a test can walk it. Each entry is a scene or an op.\nexport const CAMPAIGN = [\n  { scene: 'ep1' }, { op: 'op1' }, { scene: 'ep2' }, { op: 'op2' }, { scene: 'ep3' }, { op: 'op3' }, { scene: 'ep4' }, { op: 'op4' }, { scene: 'ep5' }, { op: 'op5' },\n  { scene: 'ep6' }, { op: 'op6' }, { scene: 'ep7' }, { op: 'op7' }, { scene: 'ep8' }, { op: 'op8' }, { scene: 'ep9' }, { op: 'op9' }, { scene: 'ep10' }, { op: 'op10' }, { scene: 'end' }, { credits: true },\n];\nexport const nextOf = (i) => (i + 1 < CAMPAIGN.length ? i + 1 : -1);\nexport function recordOp(save, opId, res) {\n  save.cleared[opId] = true;\n  const order = ['C', 'B', 'A', 'S'];\n  if (!save.ranks[opId] || order.indexOf(res.rank) > order.indexOf(save.ranks[opId])) { save.ranks[opId] = res.rank; }\n  if (res.pristine) save.pristine = { ...save.pristine, [opId]: true };\n  save.scores[opId] = Math.max(save.scores[opId] ?? 0, res.total);\n  return save;\n}\nexport const clearedOps = (save) => Object.keys(save.cleared).filter((k) => save.cleared[k]);\nEOF\ncat > src/stages/stage.js <<'EOF'\n// Base for every screen. Screens are Game classes swapped with engine.loadGame under a transition.\nimport { THREE } from '../../pixel-engine.js';\nimport { app } from '../core/app.js';\nexport const OP_CAMERA = { preset: 'fixed', position: [0, 9.6, 3.1], target: [0, 0, 0.1], fov: 44, minZoom: 1, maxZoom: 1 };\nexport class Stage {\n  name = 'stage';\n  target = new THREE.Vector3();\n  async setup(ctx) { await app.boot(ctx); await this.build(ctx); }\n  build() {}\n  ready(ctx) {\n    if (typeof window !== 'undefined') window.__GAME__ = { app, stage: this, get sim() { return this.stage.sim ?? null; }, goto: (s) => go(s), config: app.config };\n    app.ctx = ctx;\n    this.onReady?.(ctx);\n  }\n  cameraTarget() { return this.target; }\n  status() { return this.name; }\n  dispose() {}\n}\n/** Swap to another stage under a transition. */\nexport async function go(stage, kind = 'fade') {\n  const engine = app.engine;\n  if (app.going) return;\n  app.going = true;\n  try {\n    if (app.engine.manual) { await engine.loadGame(stage); }\n    else {\n      await engine.screen.cover(kind, { duration: 0.22 }).catch(() => {});\n      await engine.loadGame(stage);\n      engine.screen.reveal(kind, { duration: 0.28 });\n    }\n  } finally { app.going = false; }\n}\nexport function setView(ctx, pos, target, fov) {\n  const c = ctx.camera.camera;\n  c.position.set(pos[0], pos[1], pos[2]);\n  c.lookAt(target[0], target[1], target[2]);\n  if (fov && c.fov !== fov) { c.fov = fov; c.updateProjectionMatrix(); }\n}\nEOF\ncat > src/stages/operation.js <<'EOF'\n// The operating stage. Solo/couch: steps the sim in fixedUpdate. Attract: the bot, cheating. Session: a driver feeds state.\nimport { PALETTE, THREE, setLookLayer, buildModel } from '../../pixel-engine.js';\nimport { app } from '../core/app.js';\nimport { Stage, go, setView } from './stage.js';\nimport { createOp, step, drainEvents, cloneState, defOf, dev } from '../sim/op.js';\nimport { createBot, botInput } from '../sim/bot.js';\nimport { results } from '../sim/scoring.js';\nimport { TOOLS } from '../sim/tools.js';\nimport { OPS } from '../content/ops/index.js';\nimport { FieldView, TABLE_GAP } from '../view/field.js';\nimport { HandView } from '../view/hands.js';\nimport { BustView } from '../view/bust.js';\nimport { OpHud } from '../ui/hud.js';\nimport { BTN, deadzone } from '../input/devices.js';\nimport { flickSlot, integrateTip, nearTarget, strokeDir, toolAtSlot } from '../input/cursor.js';\nimport { heightAt } from '../content/arenas.js';\nimport { PauseOverlay } from '../ui/pause.js';\nimport { Fx } from '../view/fx.js';\nimport { MenuFail } from '../ui/fail.js';\n\nconst { Vector3, Mesh, BoxGeometry, MeshBasicMaterial } = THREE;\nconst AIM = { off: 0, low: 0.4, high: 0.8 };\nconst o = new Vector3(), d = new Vector3(), proj = new Vector3();\n\nexport class OperationStage extends Stage {\n  name = 'operation';\n  constructor(opts = {}) {\n    super();\n    this.opts = opts;\n    this.def = OPS[opts.op ?? 'op1'];\n    this.tips = [];\n    this.seatBind = opts.seats ?? [{ device: 'auto' }];\n    this.loops = {}; this.loopOn = {};\n    this.paused = false; this.pause = null; this.ended = null; this.endT = 0; this.fail = null;\n    this.intro = opts.demo ? 0.3 : 1.1;\n    this.quietA = 0; this.smear = 0; this.look = { sat: 1, vig: 0.3, spread: 0 };\n    this.frameStep = 0; this.simSpeed = 1; this.bots = {}; this.hitbox = false; this.speedAcc = 0;\n    this.ekgT = 0; this.heartT = 0; this.tilt = { x: 0, z: 0 }; this.mouseOn = false; this.camX = 0; this.camXTarget = 0;\n  }\n  async build(ctx) {\n    const { engine } = ctx;\n    const seats = this.opts.seats ? this.opts.seats.length : (this.def.seats ?? 1);\n    const cheats = this.opts.demo ? { god: true, infComposure: true, unlimitedMistakes: true, freezeClock: true } : { ...(app.flags.cheats ?? {}) };\n    if (this.opts.state) this.sim = this.opts.state;\n    else {\n      this.sim = this.opts.resume ?? createOp(this.def, { seed: this.opts.seed ?? app.urlFlags.seed ?? 1, seats, difficulty: this.opts.difficulty ?? app.save.difficulty ?? 'resident', stage: this.opts.stage ?? 0, cheats, cfg: app.config, retried: !!this.opts.retried, gifts: this.opts.gifts ?? null });\n      if (this.opts.demo) this.sim.saves = 99;\n    }\n    // Lighting: warm surgical. Much more washes the tissue out.\n    engine.setSunDirection([0.25, 1, 0.35]);\n    engine.sun.intensity = 1; engine.ambient.color.setHex(0xfff0e0); engine.ambient.intensity = 0.55;\n    ctx.scene.background = new THREE.Color(0x0a0a10);\n    this.lamp = ctx.lights.request({ position: [0, 5.2, 0.4], intensity: 5, radius: 15, color: 0xfff6e0 });\n    this.field = new FieldView(ctx, this.def.arena, this.sim.tables.length, this.opts.seed ?? 5);\n    this.hands = this.sim.seats.map((s, i) => new HandView(ctx, this.field, i));\n    this.hud = new OpHud(app, ctx);\n    this.fx = new Fx(ctx, this.field, app);\n    for (const s of this.sim.seats) { this.tips[s.i] = { x: s.x, z: s.z, tool: s.tool, table: s.table, wheelHeld: false, lastMouse: 0, giftLatch: false, flickT: 0 }; }\n    this.ghosts = [];\n    this.loops = {\n      drain: ctx.audio.loop('drainLoop', { volume: 0 }), gel: ctx.audio.loop('gelLoop', { volume: 0 }), laser: ctx.audio.loop('laserLoop', { volume: 0 }), scan: ctx.audio.loop('scanLoop', { volume: 0 }), drone: ctx.audio.loop('drone', { volume: 0 }),\n    };\n    // comm bust, for a real 3D face in the strip\n    this.commBusts = {};\n    this.bustBack = new Mesh(new BoxGeometry(0.34, 0.34, 0.01), new MeshBasicMaterial({ color: 0x1a1f2b }));\n    ctx.scene.add(this.bustBack);\n    if (typeof document !== 'undefined') document.body.style.cursor = 'none';\n    app.director?.play(this.sim.music);\n    if (this.opts.net) this.opts.net.attach(this);\n    app.applyLook(1, 0.3, 0);\n    // Cameras: dive from above.\n    this.updateCamera(ctx, 0);\n  }\n  onReady(ctx) { this.mouseOn = app.devices.last !== 'pad'; void ctx; }\n  status() { const s = this.sim; return `${s.opId} stage=${s.stage} vitals=${Math.round(s.tables[0].vitals)} t=${Math.round(s.clock)} score=${s.score} phase=${s.phase}`; }\n  dispose() { if (typeof document !== 'undefined') document.body.style.cursor = ''; this.opts.net?.detach?.(); }\n\n  /* ---- input ---- */\n  readSeat(ctx, seat, bind, dt) {\n    const tip = this.tips[seat.i], input = ctx.input, devs = app.devices;\n    const out = { x: tip.x, z: tip.z, tool: seat.tool, use: 0, gift: false, steady: false, drop: false, rot: 0, padL: false, padR: false, table: seat.table };\n    const useKbm = bind.device === 'kbm' || bind.device === 'auto';\n    const usePad = typeof bind.device === 'number' || bind.device === 'auto';\n    const pad = usePad ? (typeof bind.device === 'number' ? devs.pads[bind.device] : devs.pads.find(Boolean)) : null;\n    let sx = 0, sz = 0, steady = false, use = 0, gift = false, drop = false, rot = 0;\n    const pickSlot = (i) => { const t = toolAtSlot(i); if (t && this.sim.tools.includes(t)) { out.tool = t; this.hud.wheelT = 1; if (t !== seat.tool) { tip.prevTool = seat.tool; ctx.audio.play('uiMove'); } } else if (t) ctx.audio.play('tick'); };\n    const rotating = seat.grab != null && this.sim.ents.find((e) => e.id === seat.grab)?.goal?.[2] != null;\n    if (pad) {\n      const hit = (b) => pad.buttons[b] > 0.5 && !(pad.prev[b] > 0.5), on = (b) => pad.buttons[b] > 0.5;\n      sx += deadzone(pad.axes[0] ?? 0); sz += deadzone(pad.axes[1] ?? 0);\n      use = Math.max(use, pad.buttons[BTN.R2] ?? 0, on(BTN.CROSS) ? 1 : 0);\n      steady = steady || on(BTN.L1);\n      const l2 = (pad.buttons[BTN.L2] ?? 0) > 0.3, r2 = (pad.buttons[BTN.R2] ?? 0) > 0.3;\n      gift = gift || l2;\n      if (l2) out.padL = true; if (r2) out.padR = true;\n      if (hit(BTN.CIRCLE)) drop = true;\n      if (hit(BTN.R1) && tip.prevTool && this.sim.tools.includes(tip.prevTool)) { const t = tip.prevTool; tip.prevTool = seat.tool; out.tool = t; this.hud.wheelT = 1; }\n      if (hit(BTN.SQUARE) && this.sim.tools.includes('syringe')) { tip.prevTool = seat.tool; out.tool = 'syringe'; this.hud.wheelT = 1; }\n      if (hit(BTN.LEFT)) out.table = (seat.table - 1 + this.sim.tables.length) % this.sim.tables.length;\n      if (hit(BTN.RIGHT)) out.table = (seat.table + 1) % this.sim.tables.length;\n      if (hit(BTN.TRIANGLE)) { if (this.sim.tagOn) out.tag = true; else this.hud.prompt(this.def.patient.objective); }\n      const rx = deadzone(pad.axes[2] ?? 0), ry = deadzone(pad.axes[3] ?? 0);\n      if (rotating) rot += rx;\n      else {\n        const slot = flickSlot(rx, ry);\n        if (slot >= 0) { if (slot !== tip.flick) { pickSlot(slot); tip.flick = slot; this.hud.wheelSlot = slot; } this.hud.wheelT = 1; }\n        else { tip.flick = -1; this.hud.wheelSlot = -1; }\n      }\n    }\n    if (useKbm) {\n      if (input.isDown('KeyD', 'ArrowRight')) sx += 1; if (input.isDown('KeyA', 'ArrowLeft')) sx -= 1;\n      if (input.isDown('KeyS', 'ArrowDown')) sz += 1; if (input.isDown('KeyW', 'ArrowUp')) sz -= 1;\n      if (input.isDown('ShiftLeft', 'ShiftRight')) steady = true;\n      const mL = input.isDown('MouseLeft'), mR = input.isDown('MouseRight'), kJ = input.isDown('KeyJ'), kK = input.isDown('KeyK');\n      if (mL || kJ) { use = 1; out.padL = true; }\n      if (mR || kK) out.padR = true;\n      if (input.wasPressed('MouseRight', 'KeyK')) drop = true;\n      if (input.isDown('Space')) gift = true;\n      for (let i = 1; i <= 8; i++) if (input.wasPressed(`Digit${i}`)) pickSlot(i - 1);\n      if (rotating) { if (input.isDown('KeyQ')) rot -= 1; if (input.isDown('KeyE')) rot += 1; if (input.wheel) rot += Math.sign(input.wheel) * 3; }\n      else {\n        if (input.wasPressed('KeyQ') && tip.prevTool && this.sim.tools.includes(tip.prevTool)) { const t = tip.prevTool; tip.prevTool = seat.tool; out.tool = t; this.hud.wheelT = 1; }\n        if (input.wheel) { const list = TOOLS.filter((t) => this.sim.tools.includes(t)); const at = list.indexOf(seat.tool); const t = list[(at + Math.sign(input.wheel) + list.length) % list.length]; tip.prevTool = seat.tool; out.tool = t; this.hud.wheelT = 1; ctx.audio.play('uiMove'); }\n        if (input.wasPressed('KeyE')) { if (this.sim.tagOn) out.tag = true; else this.hud.prompt(this.def.patient.objective); }\n      }\n      if (input.wasPressed('KeyF') && this.sim.tools.includes('syringe')) { tip.prevTool = seat.tool; out.tool = 'syringe'; this.hud.wheelT = 1; }\n      if (input.wasPressed('Tab')) out.table = (seat.table + 1) % this.sim.tables.length;\n      // clicks on the wheel and table tabs\n      const click = app.devices.click(input);\n      if (click) {\n        for (const h of this.hud.tabHit) if (click.x >= h.x && click.x <= h.x + h.w && click.y >= h.y && click.y <= h.y + h.h) { out.table = h.i; use = 0; }\n        for (const h of this.hud.wheelHit ?? []) if (click.x >= h.x && click.x <= h.x + h.w && click.y >= h.y && click.y <= h.y + h.h) { pickSlot(h.i); use = 0; tip.wheelClick = 0.2; }\n      }\n      if (tip.wheelClick > 0) { tip.wheelClick -= dt; use = 0; }\n      // mouse: the tip follows exactly, on the surface not a plane\n      if (devs.pointerMoved || (this.mouseOn && (mL || mR))) this.mouseOn = true;\n      if (sx || sz) this.mouseOn = false;\n      if (this.mouseOn && input.pointer.over !== false) this.mouseToTip(ctx, tip, seat);\n    }\n    if (pad && (Math.abs(sx) > 0 || Math.abs(sz) > 0)) this.mouseOn = false;\n    const cfg = app.config;\n    const assist = AIM[app.settings.aim] ?? cfg.aimAssist;\n    if (sx || sz) {\n      const near = assist > 0 && nearTarget(this.sim, seat, tip.x, tip.z);\n      integrateTip(tip, sx, sz, { speed: cfg.cursorSpeed * (app.settings.cursor ?? 1), steady, steadyFactor: cfg.steadyFactor, assist, near, stroke: assist > 0 ? strokeDir(this.sim, seat) : null, dt });\n    }\n    if (app.settings.giftToggle) {\n      if (gift && !tip.giftPrev) tip.giftLatch = !tip.giftLatch;\n      tip.giftPrev = gift;\n      gift = tip.giftLatch;\n    }\n    out.x = tip.x; out.z = tip.z; out.use = use; out.gift = gift; out.steady = steady; out.drop = drop; out.rot = rot;\n    if (drop && seat.grab == null) { /* nothing held */ }\n    // Rumble follows the tool.\n    if (use > 0.15 && pad) this.toolRumble(seat, pad, use);\n    return out;\n  }\n  toolRumble(seat, pad, use) {\n    const f = this.ctx0Frame = (this.ctx0Frame ?? 0) + 1;\n    if (f % 6) return;\n    const R = { drain: [0.06, 0.2 * use], gel: [0, 0.1], laser: [0.03, 0.26], scalpel: [0.1, 0.06], suture: [0, 0.05], scanner: [0, 0.04], forceps: [0.12, 0.06], syringe: [0, 0.06] }[seat.tool];\n    if (R) app.devices.rumble(pad.index, R[0], R[1], 90, app.settings.rumble && !app.demo);\n  }\n  mouseToTip(ctx, tip, seat) {\n    const p = ctx.input.pointer;\n    ctx.camera.rayAt(p.x, p.y, o, d);\n    const offset = seat.table * TABLE_GAP;\n    let y = 0, x = 0, z = 0;\n    for (let i = 0; i < 4; i++) { const t = (y - o.y) / d.y; x = o.x + d.x * t; z = o.z + d.z * t; y = heightAt(this.def.arena, x - offset, z, this.field.beat, this.field.breath); }\n    tip.x = Math.max(-7.4, Math.min(7.4, x - offset));\n    tip.z = Math.max(-4, Math.min(3.6, z));\n  }\n\n  gather(ctx, dt) {\n    const sim = this.sim;\n    const inputs = [];\n    for (const seat of sim.seats) {\n      const bind = this.seatBind[seat.i] ?? { device: 'bot', skill: 0.75 };\n      if (bind.device === 'bot' || (this.def.partnerBot && seat.i === 1 && !this.opts.seats) || this.opts.demo || this.botOn) {\n        const key = seat.i;\n        this.bots[key] ??= createBot(key, this.opts.demo ? 0.92 : (seat.i === 0 ? (this.botSkill ?? 0.8) : 0.75), { cheat: !!this.opts.demo, zone: this.def.partnerBot ? (seat.i === 0 ? 'right' : 'left') : null });\n        if (seat.i === 0 && this.botSkill != null) this.bots[key].skill = this.botSkill;\n        const b = botInput(sim, this.bots[key]);\n        inputs[seat.i] = b; this.tips[seat.i].x = b.x; this.tips[seat.i].z = b.z;\n      } else inputs[seat.i] = this.readSeat(ctx, seat, bind, dt);\n    }\n    return inputs;\n  }\n\n  /* ---- fixed step ---- */\n  fixedUpdate(ctx, dt) {\n    if (this.opts.net) { this.opts.net.fixed?.(ctx, dt, this); return; }\n    if (this.paused || this.fail || this.ended) return;\n    if (this.intro > 0) return;\n    if (this.frameStep > 0) this.frameStep--; else if (this.frameFreeze) return;\n    this.speedAcc += this.simSpeed;\n    const inputs = this.gather(ctx, dt);\n    while (this.speedAcc >= 1) {\n      this.speedAcc -= 1;\n      step(this.sim, inputs);\n      for (const i of inputs) if (i) { if (i.tag) i.tag = false; i.drop = false; }\n    }\n    this.frameInputs = inputs;\n  }\n\n  /* ---- per frame ---- */\n  update(ctx, dt) {\n    const devs = app.devices;\n    devs.poll(ctx, dt);\n    const sim = this.net?.state ?? this.sim;\n    if (this.opts.demo) { this.updateDemo(ctx, dt); if (this.exited) return; }\n    else if (!this.opts.net) {\n      if (this.pause) {\n        this.pause.update(ctx, dt);\n        this.pause?.draw(ctx);\n        this.hud.updateComm(0, ctx.audio);\n        this.updateCamera(ctx, 0);\n        this.silenceLoops();\n        return;\n      }\n      if (this.fail) { this.field.update(sim, dt * 0.2); this.fail.update(ctx, dt); this.fail?.draw(ctx, dt); this.silenceLoops(); return; }\n      if (devs.nav.pause && !this.ended && this.intro <= 0) { this.openPause(ctx); return; }\n    }\n    if (this.intro > 0) this.intro -= dt;\n    const events = this.opts.net ? this.opts.net.drain() : drainEvents(sim);\n    this.handleEvents(ctx, events, dt, sim);\n    this.field.update(sim, dt);\n    // Draw hands, one per seat, on their tips.\n    const mine = this.opts.net?.mySeat ?? 0;\n    sim.seats.forEach((seat, i) => {\n      const h = this.hands[i];\n      if (!h) return;\n      h.update(seat, dt, sim);\n      h.setVisible(!seat.out);\n    });\n    this.updateGhosts(ctx, sim, dt);\n    this.updateMood(ctx, sim, dt);\n    this.updateCamera(ctx, dt, sim, mine);\n    this.updateBust(ctx, dt);\n    this.updateSound(ctx, sim, dt);\n    // Bot view: dev action stays cheap\n    const tipOf = sim.seats[mine] ?? sim.seats[0];\n    this.hud.wheelT = Math.max(0, this.hud.wheelT - dt);\n    this.drawHud(ctx, sim, dt, tipOf);\n    this.fx.update(dt);\n    if (sim.phase === 'won' || sim.phase === 'lost') this.onEnd(ctx, sim, dt);\n    if (this.hitbox) this.drawHitbox(ctx, sim);\n  }\n  drawHud(ctx, sim, dt, seat) {\n    const hud = ctx.hud;\n    this.hud.draw(sim, dt, null, { objective: this.def.patient.objective, mySeat: seat.i, def: this.def });\n    const mark = sim.hint;\n    if (mark && !sim.noHint && (sim.phase === 'play')) {\n      const p = this.toScreen(mark.x + seat.table * TABLE_GAP, this.field.surface(mark.x, mark.z) + 0.4, mark.z);\n      const y = p.y - 10 + Math.sin(this.field.t * 6) * 2;\n      hud.sprite(Math.round(p.x) - 4, Math.round(y), ['....x....', '...xxx...', '..xxxxx..', '.xxxxxxx.', 'xxxxxxxxx', '.xxxxxxx.', '..xxxxx..', '...xxx...', '....x....'], { x: 0xffd24d });\n    }\n    // Pulse the valid targets softly.\n    const pulse = Math.floor(this.field.t * 3) % 2;\n    if (pulse) for (const e of sim.ents) {\n      if (e.table !== seat.table) continue;\n      if (e.scan && !e.seen) continue;\n      if (e.hiddenBy) continue;\n      const tool = e.needTool ?? null;\n      void tool;\n    }\n    // Seat icons in co-op\n    if (sim.seats.length > 1) sim.seats.forEach((s) => {\n      const p = this.toScreen(s.x + s.table * TABLE_GAP, this.field.surface(s.x, s.z) + 0.2, s.z);\n      const col = (this.opts.net?.colors?.[s.i]) ?? [0x57c7ff, 0xff6b6b, 0x7fffa0, 0xffd24d][s.i];\n      hud.rect(Math.round(p.x) + 5, Math.round(p.y) - 8, 3, 3, col);\n      const ic = s.tool.slice(0, 3).toUpperCase();\n      hud.text(Math.round(p.x) + 9, Math.round(p.y) - 9, ic, { color: col });\n    });\n    // Prompts strip (bottom-left over the strip, right of the bust)\n    if (!this.opts.demo && !this.opts.net && sim.phase === 'play') {\n      // Keep it short: only when nothing's being said.\n      if (!this.hud.current && !this.hud.comm.length && !sim.voiceOff) app.prompts.strip(hud, 36, hud.height - 11, [['use', 'USE'], ['drop', 'DROP'], ['steady', 'STEADY'], ...(sim.giftOn ? [['gift', sim.seats[0].gift === 'look' ? 'LOOK' : 'QUIET']] : []), ['pause', 'PAUSE']]);\n    }\n    // Draw any overlay from net\n    this.opts.net?.drawOverlay?.(ctx, sim);\n  }\n  toScreen(x, y, z) {\n    const cam = this.ctx?.camera?.camera ?? app.ctx.camera.camera, hud = app.ctx.hud;\n    proj.set(x, y, z).project(cam);\n    return { x: ((proj.x + 1) / 2) * hud.width, y: ((1 - proj.y) / 2) * hud.height };\n  }\n  updateCamera(ctx, dt, sim = this.sim) {\n    const seat = sim.seats[this.opts.net?.mySeat ?? 0] ?? sim.seats[0];\n    this.camXTarget = seat.table * TABLE_GAP;\n    this.camX += (this.camXTarget - this.camX) * Math.min(1, dt * 7);\n    const asp = ctx.hud.width / ctx.hud.height, zoom = Math.max(1, (16 / 9) / asp);\n    this.tilt.x += ((seat.x / 8) * 0.25 - this.tilt.x) * Math.min(1, dt * 3);\n    this.tilt.z += ((seat.z / 5) * 0.25 - this.tilt.z) * Math.min(1, dt * 3);\n    const f = Math.max(0, this.intro) / 1.1, e = f * f;\n    const px = this.camX + this.tilt.x, py = 9.6 * zoom + e * 8, pz = 3.1 * zoom + this.tilt.z + e * 7;\n    setView(ctx, [px, py, pz], [this.camX + this.tilt.x * 0.5, 0, 0.1 + this.tilt.z * 0.3], 44);\n    this.lamp.position.set(this.camX, 5.2, 0.4);\n  }\n  updateMood(ctx, sim, dt) {\n    const target = sim.quiet ? 1 : 0;\n    this.quietA += (target - this.quietA) * Math.min(1, dt * 6);\n    this.smear = Math.max(0, this.smear - dt * 1.5);\n    const sat = 1 - this.quietA * 0.75, vig = 0.3 + this.quietA * 0.65, spread = this.smear * 0.02;\n    const L = this.look;\n    if (Math.abs(L.sat - sat) + Math.abs(L.vig - vig) + Math.abs(L.spread - spread) > 0.004) { L.sat = sat; L.vig = vig; L.spread = spread; app.applyLook(sat, vig, spread); }\n    // lamp flicker below 15\n    const v = sim.tables[sim.seats[0].table]?.vitals ?? 50;\n    this.lamp.intensity = v < 15 && !app.settings.reduceFlash ? 5 - (Math.floor(this.field.t * 13) % 3 === 0 ? 2.8 : 0) : 5;\n  }\n  updateBust(ctx, dt) {\n    const comm = this.hud.current;\n    const who = comm?.who ?? null;\n    if (who && !this.commBusts[who]) { this.commBusts[who] = new BustView(ctx, who); const r = this.commBusts[who].root; r.scale.setScalar(0.13); }\n    const cam = ctx.camera.camera;\n    const hud = ctx.hud, asp = hud.width / hud.height, D = 2, hh = Math.tan((44 * Math.PI) / 360) * D, hw = hh * asp;\n    const nx = -1 + (17 / hud.width) * 2, ny = -1 + (15 / hud.height) * 2;\n    for (const [id, b] of Object.entries(this.commBusts)) {\n      const on = id === who;\n      b.root.visible = on;\n      if (!on) continue;\n      b.update(dt);\n      if (comm.talk > 0) b.talk(0.8);\n      const m = /[!*]/.test(comm.text) ? (id === 'ilya' ? 'panic' : 'angry') : id === 'ilya' ? 'neutral' : 'stern';\n      if (b.emotion !== m) b.setEmotion(m);\n      b.root.position.set(nx * hw, ny * hh - 0.14, -D);\n      cam.localToWorld(b.root.position);\n      b.root.quaternion.copy(cam.quaternion);\n    }\n    this.bustBack.visible = !!who;\n    this.bustBack.position.set(nx * hw, ny * hh, -D - 0.1);\n    cam.localToWorld(this.bustBack.position);\n    this.bustBack.quaternion.copy(cam.quaternion);\n  }\n  updateGhosts(ctx, sim, dt) {\n    if (sim.ghost) {\n      sim.seats.forEach((s, i) => {\n        const tr = sim.ghost.seats[i];\n        if (!tr) return;\n        const k = sim.ghost.i * 3;\n        if (k + 1 >= tr.length) return;\n        this.ghosts[i] ??= (() => { const g = new HandView(ctx, this.field, i); g.setGhost(); return g; })();\n        this.ghosts[i].setVisible(true);\n        this.ghosts[i].update({ x: tr[k], z: tr[k + 1], tool: s.tool, table: s.table, useHeld: !!tr[k + 2], drawing: 0, grab: null }, dt, sim);\n      });\n    } else this.ghosts.forEach((g, i) => { if (i !== 9) g?.setVisible(false); });\n    if (sim.mimic?.x != null) {\n      this.mimicHand ??= (() => { const g = new HandView(ctx, this.field, 0); g.setGhost(); return g; })();\n      this.mimicHand.setVisible(true);\n      this.mimicHand.update({ x: sim.mimic.x, z: sim.mimic.z, tool: sim.seats[0].tool, table: 0, useHeld: !!sim.mimic.use, drawing: 0, grab: null }, dt, sim);\n    } else this.mimicHand?.setVisible(false);\n  }\n  silenceLoops() { for (const v of Object.values(this.loops)) v.set({ volume: 0 }); }\n  updateSound(ctx, sim, dt) {\n    const L = this.loopOn;\n    const vol = (name, on, v = 1) => this.loops[name]?.set({ volume: on ? v : 0 });\n    const seat = sim.seats[this.opts.net?.mySeat ?? 0] ?? sim.seats[0];\n    vol('drain', L.drain, 0.9); this.loops.drain?.set({ pitch: seat.useHeld ? 2 : 0 });\n    vol('gel', L.gel, 0.8); vol('laser', L.laser, 0.8); vol('scan', seat.tool === 'scanner' && seat.useHeld, 0.8); vol('drone', sim.quiet, 1);\n    this.loopOn = {};\n    // EKG beep: rate and pitch follow vitals\n    const v = sim.tables[seat.table]?.vitals ?? 50;\n    if (sim.phase === 'play' && !sim.voiceOff) {\n      this.ekgT -= dt * (sim.quiet ? 0.25 : 1);\n      if (this.ekgT <= 0) { this.ekgT = v < 30 ? 0.42 : v < 60 ? 0.7 : 0.95; ctx.audio.play(v < 30 ? 'beepLow' : 'beep', { pitch: v < 30 ? 2 : 0 }); }\n    }\n    if (sim.quiet) { this.heartT -= dt; if (this.heartT <= 0) { this.heartT = 0.9; ctx.audio.play('heartbeat'); app.rumble(0.4, 0.1, 120); } }\n    app.director?.update(dt, sim.phase === 'play' ? v : null, sim.music);\n  }\n  handleEvents(ctx, events, dt, sim) {\n    const audio = ctx.audio;\n    for (const e of events) {\n      switch (e.t) {\n        case 'say': this.hud.say(e.who, e.text); break;\n        case 'prompt': this.hud.prompt(e.text); audio.play('reveal'); break;\n        case 'sfx': if (e.id === 'tick') audio.play('tick'); else if (e.id) audio.play(e.id, { pan: e.x ? Math.max(-0.7, Math.min(0.7, e.x / 8)) : 0 }); break;\n        case 'loop': if (e.on) this.loopOn[e.id] = true; break;\n        case 'beam': this.loopOn.laser = true; if (e.on) { this.fx.smoke(e.x + e.table * TABLE_GAP, this.field.surface(e.x, e.z), e.z); } break;\n        case 'scan': break;\n        case 'rate': { const p = this.toScreen(e.x + (sim.seats[e.seat]?.table ?? 0) * TABLE_GAP, this.field.surface(e.x, e.z) + 0.5, e.z); this.hud.rating(e.r, p.x, p.y, e.pts, e.streak); audio.play(e.r === 'CLEAN' ? 'rateClean' : e.r === 'GOOD' ? 'rateGood' : e.r === 'SLOPPY' ? 'rateSloppy' : 'rateMistake', { pitch: e.r === 'CLEAN' ? Math.min(12, (e.streak ?? 0)) : 0 }); if (e.r === 'MISTAKE') { app.shake(0.5); app.rumble(0.8, 0.5, 220); app.flash('red', { duration: 0.1 }); } if (e.r === 'CLEAN' && e.streak % 5 === 0 && e.streak > 0 && !sim.voiceOff) this.hud.say('reyes', LINE_CLEAN[(e.streak / 5) % LINE_CLEAN.length]); break; }\n        case 'stitch': audio.play('stitch', { pitch: (e.n ?? 0) * 1.2 }); this.fx.sparkAt(e.x + (e.table ?? 0) * TABLE_GAP, this.field.surface(e.x, e.z), e.z); app.rumble(0, 0.3, 40); break;\n        case 'cutting': if (Math.floor(this.field.t * 18) !== this.lastSlice) { this.lastSlice = Math.floor(this.field.t * 18); audio.play('slice'); this.fx.blood(e.x + (e.table ?? 0) * TABLE_GAP, this.field.surface(e.x, e.z), e.z, 2); } break;\n        case 'done': this.fx.done(e, sim); break;\n        case 'dish': this.fx.toDish(e, sim.seats[e.seat]?.table ?? 0); audio.play('tink', { pitch: Math.random() * 3 - 1 }); app.rumble(0.2, 0.2, 60); break;\n        case 'placed': this.field.addPlaced(e); app.rumble(0.4, 0.2, 70); app.shake(0.1); break;\n        case 'pinkUp': this.field.pinkUp(); audio.play('reveal'); break;\n        case 'grab': app.rumble(0.3, 0.1, 40); break;\n        case 'stage': break;\n        case 'music': app.director?.play(e.id); break;\n        case 'quiet': if (e.on) { audio.play('inhale'); ctx.engine.screen.shockwave([0, 1, 0], { strength: 0.3 }); } break;\n        case 'look': audio.play('rewind'); this.smear = 1; app.flash('plum', { duration: 0.25 }); app.rumble(0.3, 0.6, 450); this.hud.popups.length = 0; break;\n        case 'codeblue': if (e.on) { audio.play('flatline'); app.flash('red', { duration: 0.2 }); app.shake(0.4); } else { audio.play('reveal'); this.hud.say('pem', 'And he is back. Rhythm is ugly but it is a rhythm.'); } break;\n        case 'shock': if (e.good) { audio.play('clear'); app.flash('white', { duration: 0.16 }); ctx.engine.hitstop(0.08); app.shake(0.7); app.rumble(1, 1, 300); this.hud.say('ilya', 'CLEAR!'); } else { audio.play('shockBad'); app.shake(0.3); app.rumble(0.3, 0.1, 120); } break;\n        case 'massage': if (e.on) audio.play('flatline'); break;\n        case 'squeeze': audio.play('squeeze'); app.shake(0.3); app.rumble(0.7, 0.4, 120); break;\n        case 'beat': app.rumble(0.25, 0, 60); break;\n        case 'knock': this.fx.knock(e.x, e.z); app.shake(0.3); app.rumble(0.5, 0.2, 110); break;\n        case 'strainHit': this.fx.strainHit(e); app.flash('white', { duration: 0.06 }); ctx.engine.hitstop(0.05); app.shake(0.45); app.rumble(0.8, 0.6, 180); break;\n        case 'strainDead': this.fx.strainDead(e); audio.play('strainHurt', { pitch: -6 }); app.shake(0.8); app.rumble(1, 1, 500); ctx.engine.hitstop(0.1); break;\n        case 'wave': app.flash('blue', { duration: 0.2 }); app.shake(0.8); app.rumble(1, 0.6, 350); break;\n        case 'fx': this.storyFx(ctx, e.id); break;\n        case 'table': audio.play('uiMove'); break;\n        case 'tool': this.hud.wheelT = 1; break;\n        case 'tag': audio.play('reveal'); this.hud.prompt(e.doctor === 'ilya' ? 'DR. MARSH: THE QUIET' : 'DR. ACHTERBERG: THE SECOND LOOK'); break;\n        case 'inject': this.fx.inject(e.x + (e.table ?? 0) * TABLE_GAP, this.field.surface(e.x, e.z), e.z); break;\n        case 'lowVitals': audio.play('alarm'); break;\n        case 'bpm': app.director?.setBpm(e.bpm); break;\n        case 'won': case 'lost': break;\n        default: break;\n      }\n    }\n    void dt;\n  }\n  storyFx(ctx, id) {\n    if (id === 'awaken') { app.flash('white', { duration: 0.4 }); ctx.audio.stopMusic?.(); ctx.audio.play('heartbeat'); ctx.engine.screen.shockwave([0, 1, 0], { strength: 0.6 }); }\n    if (id === 'truth') { app.flash('red', { duration: 0.5 }); app.shake(1); }\n    if (id === 'silence') { ctx.audio.playMusic(null); }\n    if (id === 'burst') { app.flash('red', { duration: 0.25 }); app.shake(0.7); }\n    if (id === 'reyesBack') { ctx.audio.play('reveal'); }\n  }\n  openPause(ctx) { this.paused = true; this.pause = new PauseOverlay(this, ctx); ctx.audio.play('uiConfirm'); if (typeof document !== 'undefined') document.body.style.cursor = ''; }\n  closePause() { this.paused = false; this.pause = null; if (typeof document !== 'undefined') document.body.style.cursor = 'none'; }\n\n  /* ---- ends ---- */\n  onEnd(ctx, sim, dt) {\n    if (this.opts.net) return;\n    if (this.opts.demo) return;\n    this.endT += dt;\n    if (this.ended == null) {\n      this.ended = sim.phase;\n      if (sim.phase === 'lost') { ctx.audio.play('flatline'); app.director?.play('sad'); this.hud.say('reyes', 'Time of death...'); this.silenceLoops(); } else { app.director?.play('results'); this.silenceLoops(); }\n    }\n    if (sim.phase === 'lost' && this.endT > 1.2 && !this.fail) {\n      this.fail = new MenuFail(this, ctx);\n      if (typeof document !== 'undefined') document.body.style.cursor = '';\n    }\n    if (sim.phase === 'won' && this.endT > 1.4 && !this.leaving) {\n      this.leaving = true;\n      this.opts.onWin?.(results(sim, this.def), sim);\n    }\n  }\n  /** Retry from this stage: rank capped at B. */\n  retryStage() {\n    const cp = this.sim.checkpoint;\n    if (!cp) { this.restart(); return; }\n    const copy = structuredClone(cp);\n    Object.assign(copy, { cfg: app.config, events: [], ring: [], checkpoint: cp, meta: this.sim.meta ?? {}, retried: true, checkpointStage: this.sim.checkpointStage });\n    go(new OperationStage({ ...this.opts, resume: copy, stage: 0, retried: true }));\n  }\n  restart() { go(new OperationStage({ ...this.opts, resume: null, stage: 0, retried: false, difficulty: this.nextDifficulty ?? this.opts.difficulty })); }\n\n  updateDemo(ctx, dt) {\n    this.demoT = (this.demoT ?? 0) + dt;\n    if (app.devices.anyInput && this.demoT > 0.3) { this.exited = true; app.exitAttract?.(); return; }\n    if (this.demoT > (this.opts.demo.secs ?? 25) || this.sim.phase === 'won' || this.sim.phase === 'lost') { this.exited = true; app.nextAttract?.(); }\n  }\n  drawHitbox(ctx, sim) {\n    const hud = ctx.hud;\n    for (const e of sim.ents) {\n      const p = this.toScreen(e.x + (e.table ?? 0) * TABLE_GAP, this.field.surface(e.x, e.z), e.z);\n      hud.rect(Math.round(p.x) - 1, Math.round(p.y) - 1, 3, 3, 0x7fff00);\n      hud.text(Math.round(p.x) + 3, Math.round(p.y) - 3, `${e.id}:${e.k}`, { color: 0x7fff00 });\n    }\n  }\n}\nconst LINE_CLEAN = [\"...Adequate. Don't let it go to your head. It's not attached to anything useful.\", 'Fine. Do it again, so I know it was not an accident.', 'Hm. Someone taught you something.'];\nvoid PALETTE; void setLookLayer; void buildModel; void cloneState; void defOf; void dev;\nEOF\necho ok","description":"Write script, campaign, base stage and operation stage"}}}
