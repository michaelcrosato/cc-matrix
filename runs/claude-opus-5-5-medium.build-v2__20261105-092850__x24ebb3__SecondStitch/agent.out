 . . F4 A4 C5 F5 . . . .' },\n    b: { choir: 'G4 - - - - - - - E4 - - - A4 - - -', choir2: 'Bb4 - - - - - - - G4 - - - C#5 - - -', bass: 'G2 . . G2 . . G2 . A2 . . A2 . . A2 .', knock: 'C3 . . C3 . . C3 . . . . . C3 . C3 .', arp: 'G4 Bb4 D5 G5 . . . . A4 C#5 E5 A5 . . . .' } } },\n  'boss-lacrimosa': { bpm: 76, stepsPerBeat: 3, tracks: { choir: choir(0.06), tear: { wave: 'triangle', decay: 0.3, volume: 0.09 }, bass: bass(0.1), hat: hat(0.015) }, order: ['a', 'b'], patterns: {\n    a: { choir: 'A4 - - - - - F4 - - - - - E4 - - - - - E4 - - - - -', tear: 'E5 . C5 . A4 . F5 . C5 . A4 . E5 . B4 . G#4 . B4 . E5 . . .', bass: 'A2 . . E3 . . F2 . . C3 . . E2 . . B2 . . E2 . . E3 . .', hat: 'C8 . . C8 . . C8 . . C8 . . C8 . . C8 . . C8 . . C8 . .' },\n    b: { choir: 'D4 - - - - - A4 - - - - - B4 - - - - - E4 - - - - -', tear: 'D5 . F5 . A5 . E5 . C5 . A4 . F5 . D5 . B4 . G#4 . E4 . . .', bass: 'D3 . . A3 . . A2 . . E3 . . B2 . . F3 . . E2 . . B2 . .', hat: 'C8 . . C8 . . C8 . . C8 . . C8 . . C8 . . C8 . . C8 . .' } } },\n  'boss-irae': { bpm: 72, stepsPerBeat: 4, tracks: { choir: choir(0.07), brass: { wave: 'sawtooth', decay: 0.2, volume: 0.05 }, thump: kick(0.2), bass: { wave: 'square', duty: 0.5, decay: 0.14, volume: 0.06 } }, order: ['a', 'b'], patterns: {\n    a: { choir: 'C4 - - - - - - - Ab3 - - - - - - -', brass: 'C5 . . C5 Eb5 . . . Ab4 . . Ab4 C5 . . .', thump: 'C3 . C3 . . . . . C3 . C3 . . . . .', bass: 'C2 . . . C2 . . . Ab1 . . . Ab1 . . .' },\n    b: { choir: 'F3 - - - - - - - G3 - - - B3 - - -', brass: 'F4 . . F4 Ab4 . . . G4 . . B4 D5 . . .', thump: 'C3 . C3 . . . . . C3 . C3 . . . . .', bass: 'F1 . . . F2 . . . G1 . . . G2 . . .' } } },\n  'boss-libera': { bpm: 88, tracks: { choir: choir(0.06), choir2: choir(0.04), bass: { wave: 'sawtooth', decay: 0.2, volume: 0.05 }, kick: kick(0.14) }, order: ['a', 'b'], patterns: {\n    a: { choir: 'E4 - - - - - - - D4 - - - - - - -', choir2: 'B4 - - - - - - - A4 - - - - - - -', bass: 'E2 . . E2 . . E2 . D2 . . D2 . . D2 .', kick: 'C3 . . . . . C3 . C3 . . . . . C3 .' },\n    b: { choir: 'C4 - - - - - - - B3 - - - D#4 - - -', choir2: 'G4 - - - - - - - F#4 - - - B4 - - -', bass: 'C2 . . C2 . . C2 . B1 . . B1 . . B1 .', kick: 'C3 . . . . . C3 . C3 . . C3 . . C3 .' } } },\n  'boss-miserere': { bpm: 60, tracks: { choir: choir(0.07), choir2: choir(0.05), high: { wave: 'sine', decay: 0.8, volume: 0.05 } }, order: ['a', 'b'], patterns: {\n    a: { choir: 'C4 - - - - - - - G4 - - - - - - -', choir2: 'E4 - - - - - - - B4 - - - - - - -', high: 'G5 . . . E5 . . . D5 . . . B4 . . .' },\n    b: { choir: 'A3 - - - - - - - F4 - - - E4 - - -', choir2: 'C4 - - - - - - - A4 - - - G4 - - -', high: 'A5 . . . E5 . . . C5 . . . E5 . . .' } } },\n  op10: { bpm: 52, tracks: { lead: lead(0.08), soft: pad(0.02) }, order: ['a', 'b'], patterns: {\n    a: { lead: 'A4 - - - . . . . C5 - - - . . . .', soft: 'A3 . . . E4 . . . F3 . . . C4 . . .' },\n    b: { lead: 'B4 - - - G4 - - - A4 - - - - - - -', soft: 'G3 . . . D4 . . . A3 . . . E4 . . .' } } },\n  results: { bpm: 120, loop: false, tracks: { lead: { wave: 'square', duty: 0.25, decay: 0.2, volume: 0.09 }, bass: bass(0.09) }, order: ['a'], patterns: { a: { lead: 'C5 . E5 . G5 . C6 - - - G5 . C6 - - -', bass: 'C3 . . . G2 . . . F2 . . . C3 - - -' } } },\n  sad: { bpm: 60, loop: false, tracks: { lead: lead(0.1), bass: bass(0.08) }, order: ['a'], patterns: { a: { lead: 'E5 - - D5 C5 - - B4 A4 - - - - - - -', bass: 'A2 - - - F2 - - - E2 - - - A2 - - -' } } },\n  credits: { bpm: 72, tracks: { lead: lead(0.1), soft: pad(0.03), bass: bass(0.08) }, order: ['a', 'b'], patterns: {\n    a: { lead: 'C5 - D5 - E5 - G5 - E5 - - - D5 - C5 -', soft: 'C4 E4 G4 E4 C4 E4 G4 E4 A3 C4 E4 C4 A3 C4 E4 C4', bass: 'C3 - - - - - - - A2 - - - - - - -' },\n    b: { lead: 'F5 - E5 - D5 - C5 - D5 - - - G4 - - -', soft: 'F3 A3 C4 A3 F3 A3 C4 A3 G3 B3 D4 B3 G3 B3 D4 B3', bass: 'F2 - - - - - - - G2 - - - - - - -' } } },\n};\nEOF\ncat > src/audio/director.js <<'EOF'\n// Picks tracks from vitals and stage; changes at bar lines so a switch sounds intentional.\nimport { SONGS } from '../content/songs.js';\nexport class MusicDirector {\n  current = null; want = null; barT = 0; bpmApplied = 0;\n  constructor(audio) { this.audio = audio; }\n  play(id) { this.want = id; if (this.current === null) this.apply(); }\n  stopNow() { this.want = null; this.current = null; this.audio.playMusic(null); }\n  apply() {\n    if (this.want === this.current) return;\n    this.current = this.want;\n    if (!this.want || this.want === 'silence') { this.audio.playMusic(null); this.barT = 1; return; }\n    const song = SONGS[this.want];\n    if (song) { this.audio.playMusic(song, this.want); this.barT = this.barLen(song); }\n  }\n  barLen(song) { return (16 / (song.stepsPerBeat ?? 4)) * (60 / song.bpm); }\n  /** Dies Irae's tempo follows the heart: restart with a new bpm at bar lines. */\n  setBpm(bpm) {\n    if (this.current !== 'boss-irae' && this.current !== 'boss-libera') return;\n    const song = { ...SONGS[this.current], bpm };\n    if (Math.abs(bpm - this.bpmApplied) >= 6) { this.bpmApplied = bpm; this.pending = song; }\n  }\n  update(dt, vitals = null, base = null) {\n    let want = this.want;\n    if (base && vitals != null && (base === 'or-calm' || base === 'or-tense' || base === 'or-critical')) want = vitals < 30 ? 'or-critical' : vitals < 50 && base === 'or-calm' ? 'or-tense' : base;\n    this.want = want;\n    this.barT -= dt;\n    if (this.barT <= 0) {\n      if (this.pending) { this.audio.playMusic(this.pending, this.current); this.barT = this.barLen(this.pending); this.pending = null; }\n      else if (this.want !== this.current) this.apply();\n      else if (this.current && SONGS[this.current]) this.barT = this.barLen(SONGS[this.current]);\n      else this.barT = 0.5;\n    }\n  }\n}\nEOF\necho done","description":"Write input devices, cursor, voice, sfx, songs, director"}}}
