{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgk8GZUNGPUCaiRbAkUiD","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":19736,"cache_read_input_tokens":275423,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":19736},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9464247a-cdba-4289-905c-cd8b34e5d270","uuid":"966881b7-f011-43fd-bd34-a83dc0c6d700","timestamp":"2026-11-05T16:50:46.687Z","request_id":"req_011Cgk8GZBk9uWEXmJmv53iH","thinking_duration_ms":965,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgk8GZUNGPUCaiRbAkUiD","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01799HBMvjLpi7zkDzHC1yov","name":"Bash","input":{"command":"cat > src/core/save.js <<'EOF'\n// Guarded localStorage under a versioned key. In a session the client hands us an empty store.\nconst KEY = 'second-stitch:v1';\nexport const DEFAULT_SAVE = () => ({ next: 0, sceneDone: {}, ranks: {}, scores: {}, difficulty: 'resident', cleared: {}, finished: false, fails: {} });\nexport const DEFAULT_SETTINGS = () => ({ music: 0.1, sfx: 0.8, voices: 0.8, glyphs: 'ps', aim: 'low', cursor: 1, rumble: true, giftToggle: false, look: 'field', pixel: 1, shake: 1, reduceFlash: false, textSpeed: 1, difficulty: 'resident', fullscreen: false });\nconst store = () => { try { return typeof localStorage !== 'undefined' ? localStorage : null; } catch { return null; } };\nexport function loadAll() {\n  const s = store(); let raw = null;\n  try { raw = s?.getItem(KEY); } catch { raw = null; }\n  try { const d = raw ? JSON.parse(raw) : {}; return { save: { ...DEFAULT_SAVE(), ...d.save }, settings: { ...DEFAULT_SETTINGS(), ...d.settings } }; } catch { return { save: DEFAULT_SAVE(), settings: DEFAULT_SETTINGS() }; }\n}\nexport function storeAll(save, settings) {\n  try { store()?.setItem(KEY, JSON.stringify({ save, settings })); } catch { /* full or blocked: play on */ }\n}\nexport const saveKey = KEY;\nEOF\ncat > src/ui/prompts.js <<'EOF'\n// Prompts follow the last input used. Text in data uses tokens resolved at draw time.\nimport { TOOLS } from '../sim/tools.js';\n\nconst SPR = {\n  cross: { rows: ['.........', '.x.....x.', '..x...x..', '...x.x...', '....x....', '...x.x...', '..x...x..', '.x.....x.', '.........'], colors: { x: 0x7fb4ff } },\n  circle: { rows: ['..xxxxx..', '.x.....x.', 'x.......x', 'x.......x', 'x.......x', 'x.......x', 'x.......x', '.x.....x.', '..xxxxx..'], colors: { x: 0xff6b6b } },\n  square: { rows: ['.........', '.xxxxxxx.', '.x.....x.', '.x.....x.', '.x.....x.', '.x.....x.', '.x.....x.', '.xxxxxxx.', '.........'], colors: { x: 0xf08ad0 } },\n  triangle: { rows: ['....x....', '...x.x...', '...x.x...', '..x...x..', '..x...x..', '.x.....x.', '.x.....x.', 'xxxxxxxxx', '.........'], colors: { x: 0x6be0b0 } },\n  mouseL: { rows: ['.xxxxxx.', 'xoooxxxx', 'xoooxxxx', 'xoooxxxx', 'xxxxxxxx', 'x......x', 'x......x', 'x......x', '.xxxxxx.'], colors: { x: 0xffffff, o: 0xffd24d } },\n  mouseR: { rows: ['.xxxxxx.', 'xxxxooox', 'xxxxooox', 'xxxxooox', 'xxxxxxxx', 'x......x', 'x......x', 'x......x', '.xxxxxx.'], colors: { x: 0xffffff, o: 0xffd24d } },\n  mouseW: { rows: ['.xxxxxx.', 'xxxooxxx', 'xxxooxxx', 'xxxooxxx', 'xxxxxxxx', 'x......x', 'x......x', 'x......x', '.xxxxxx.'], colors: { x: 0xffffff, o: 0xffd24d } },\n  stick: { rows: ['..xxxxx..', '.x.....x.', 'x..xxx..x', 'x.xxxxx.x', 'x.xxxxx.x', 'x.xxxxx.x', 'x..xxx..x', '.x.....x.', '..xxxxx..'], colors: { x: 0xbfc8d8 } },\n};\nconst XB = { cross: ['A', 0x6be07b], circle: ['B', 0xff6b6b], square: ['X', 0x7fb4ff], triangle: ['Y', 0xffd24d] };\n\n// token -> by device: a list of glyph specs. Strings are key names; {s:'name'} sprites; {pad:'L2'} shoulder labels; {face:'cross'} faces.\nconst pad = (name) => ({ pad: name }), face = (name) => ({ face: name }), key = (name) => ({ key: name }), mouse = (name) => ({ s: name });\nconst TOKENS = {\n  use: { pad: [pad('R2')], kbm: [mouse('mouseL')] },\n  back: { pad: [face('circle')], kbm: [key('ESC')] },\n  confirm: { pad: [face('cross')], kbm: [key('ENTER')] },\n  gift: { pad: [pad('L2')], kbm: [key('SPACE')] },\n  steady: { pad: [pad('L1')], kbm: [key('SHIFT')] },\n  quick: { pad: [face('square')], kbm: [key('F')] },\n  drop: { pad: [face('circle')], kbm: [mouse('mouseR')] },\n  rotate: { pad: [{ s: 'stick' }], kbm: [key('Q'), key('E')] },\n  table: { pad: [pad('DPAD')], kbm: [key('TAB')] },\n  tag: { pad: [face('triangle')], kbm: [key('E')] },\n  paddles: { pad: [pad('L2'), pad('R2')], kbm: [mouse('mouseL'), mouse('mouseR')] },\n  squeeze: { pad: [pad('L2'), pad('R2')], kbm: [mouse('mouseL'), mouse('mouseR')] },\n  more: { pad: [face('triangle')], kbm: [key('M')] },\n  pause: { pad: [pad('OPT')], kbm: [key('ESC')] },\n  last: { pad: [pad('R1')], kbm: [key('Q')] },\n  remind: { pad: [face('triangle')], kbm: [key('E')] },\n  move: { pad: [{ s: 'stick' }], kbm: [{ text: 'MOUSE' }] },\n  tabl: { pad: [pad('L1')], kbm: [key('Q')] },\n  tabr: { pad: [pad('R1')], kbm: [key('E')] },\n};\n\nexport class Prompts {\n  constructor(app) { this.app = app; }\n  get device() { return this.app.devices.last === 'pad' ? 'pad' : 'kbm'; }\n  specs(token) {\n    if (token.startsWith('tool:')) {\n      const n = +token.slice(5);\n      return this.device === 'pad' ? [{ s: 'stick' }, { text: wheelDir(n) }] : [key(String(n))];\n    }\n    return TOKENS[token]?.[this.device] ?? [{ text: token.toUpperCase() }];\n  }\n  glyphWidth(spec, hud) {\n    if (spec.s) return (SPR[spec.s].rows[0].length) + 1;\n    if (spec.face) return 10;\n    if (spec.pad) return this.xbName(spec.pad).length * 6 + 5;\n    if (spec.key) return spec.key.length * 6 + 5;\n    if (spec.text) return hud.measure(spec.text).width + 2;\n    return 0;\n  }\n  xbName(name) { if (this.app.settings.glyphs !== 'xbox') return name; return { L1: 'LB', R1: 'RB', L2: 'LT', R2: 'RT', OPT: 'MENU' }[name] ?? name; }\n  drawGlyph(hud, x, y, spec) {\n    if (spec.s) { const s = SPR[spec.s]; hud.sprite(x, y - 1, s.rows, s.colors); return; }\n    if (spec.face) {\n      if (this.app.settings.glyphs === 'xbox') { const [ch, col] = XB[spec.face]; hud.rect(x, y - 1, 9, 9, 0x1a1f2b); hud.text(x + 2, y, ch, { color: col, shadow: false }); return; }\n      const s = SPR[spec.face]; hud.sprite(x, y - 1, s.rows, s.colors); return;\n    }\n    if (spec.pad || spec.key) {\n      const name = spec.pad ? this.xbName(spec.pad) : spec.key, w = name.length * 6 + 3;\n      hud.rect(x, y - 1, w, 9, spec.pad ? 0x2a3142 : 0xe8e8e8);\n      hud.text(x + 2, y, name, { color: spec.pad ? 0xffffff : 0x14161e, shadow: false });\n      return;\n    }\n    if (spec.text) hud.text(x, y, spec.text, { color: 0xffd24d });\n  }\n  /** Break text into word items with glyphs and highlights. */\n  items(text, hud, baseColor) {\n    const out = [];\n    let hl = false;\n    const parts = text.split(/(\\{[a-z:0-9]+\\}|\\*)/gi);\n    for (const part of parts) {\n      if (!part) continue;\n      if (part === '*') { hl = !hl; continue; }\n      const m = part.match(/^\\{([a-z:0-9]+)\\}$/i);\n      if (m) { for (const spec of this.specs(m[1])) out.push({ spec, w: this.glyphWidth(spec, hud) }); continue; }\n      for (const tok of part.split(/(\\s+)/)) {\n        if (!tok) continue;\n        if (/^\\s+$/.test(tok)) out.push({ space: true, w: 6 });\n        else out.push({ word: tok, color: hl ? 0xffd24d : baseColor, w: hud.measure(tok).width + 1 });\n      }\n    }\n    return out;\n  }\n  /** Wrapped rich text; returns the number of lines. `limit` reveals only so many characters. */\n  draw(hud, x, y, text, { width = 300, color = 0xffffff, lineH = 11, limit = Infinity, center = false, scale = 1 } = {}) {\n    const items = this.items(text, hud, color);\n    const lines = [[]]; let w = 0;\n    for (const it of items) {\n      if (it.space && lines[lines.length - 1].length === 0) continue;\n      if (!it.space && w + it.w > width && lines[lines.length - 1].length) { lines.push([]); w = 0; }\n      lines[lines.length - 1].push(it); w += it.w;\n    }\n    let shown = 0;\n    lines.forEach((ln, i) => {\n      let cx = x;\n      const lw = ln.reduce((n, q) => n + q.w, 0);\n      if (center) cx = x + (width - lw) / 2;\n      for (const it of ln) {\n        if (it.word) {\n          const left = limit - shown;\n          if (left > 0) hud.text(Math.round(cx), y + i * lineH, it.word.slice(0, left), { color: it.color, scale });\n          shown += it.word.length;\n        } else if (it.spec && shown < limit) this.drawGlyph(hud, Math.round(cx), y + i * lineH, it.spec);\n        cx += it.w;\n      }\n    });\n    return lines.length;\n  }\n  lineCount(text, hud, width) {\n    const items = this.items(text, hud, 0); let n = 1, w = 0, empty = true;\n    for (const it of items) { if (it.space && empty) continue; if (!it.space && w + it.w > width && !empty) { n++; w = 0; empty = true; } w += it.w; empty = false; }\n    return n;\n  }\n  /** A short prompt strip: [glyph] LABEL pairs, bottom-left. */\n  strip(hud, x, y, pairs) {\n    let cx = x;\n    for (const [tok, label] of pairs) {\n      for (const spec of this.specs(tok)) { this.drawGlyph(hud, cx, y, spec); cx += this.glyphWidth(spec, hud); }\n      cx += 2;\n      hud.text(cx, y, label, { color: 0xd8dde8 });\n      cx += hud.measure(label).width + 9;\n    }\n    return cx - x;\n  }\n}\nconst DIRS = ['UP', 'UR', 'RIGHT', 'DR', 'DOWN', 'DL', 'LEFT', 'UL'];\nconst wheelDir = (n) => DIRS[(n - 1) % 8];\nexport const toolLabel = (id) => id.toUpperCase();\nexport const toolIndex = (id) => TOOLS.indexOf(id);\nEOF\ncat > src/content/icons.js <<'EOF'\n// HUD icons as pixel rows, one per tool.\nconst c = { x: 0xe8edf5, r: 0xff6b6b, b: 0x7fb4ff, d: 0x8a93a6, g: 0x7ff0d8, y: 0xffd24d };\nexport const TOOL_ICONS = {\n  scalpel: { rows: ['..........x.', '.........xx.', '........xx..', '.......xx...', '......dd....', '.....dd.....', '....dd......', '...bb.......', '..bb........', '.dd.........', '............'], colors: c },\n  forceps: { rows: ['.x.......x..', '.x.......x..', '..x.....x...', '..x.....x...', '...x...x....', '...x...x....', '....x.x.....', '....x.x.....', '.....d......', '....ddd.....', '.....d......'], colors: c },\n  suture: { rows: ['.....xxxx...', '...xx....x..', '..x.......x.', '..x.......x.', '..x.........', '...d........', '...d.d......', '....d.d.d...', '......d.d.d.', '........d...', '............'], colors: c },\n  drain: { rows: ['...dddd.....', '...rrrr.....', '....dd......', '....dd......', '....dd......', '....dd......', '....bb......', '....bb......', '...bb.......', '..bb........', '..b.........'], colors: c },\n  syringe: { rows: ['.....x......', '.....x......', '.....x......', '....ddd.....', '....grg.....', '....grg.....', '....grg.....', '....ggg.....', '.....d......', '.....d......', '...ddddd....'], colors: { ...c, g: 0x8fd8ff } },\n  gel: { rows: ['.....x......', '....xxx.....', '....xxx.....', '...ggggg....', '...ggggg....', '...bbbbb....', '...bbbbb....', '...ggggg....', '...ggggg....', '...ggggg....', '............'], colors: c },\n  laser: { rows: ['.r..........', 'r.r.........', '.r.d........', '...dd.......', '....dd......', '.....dd.....', '......yd....', '.......dd...', '........dd..', '.........dd.', '..........d.'], colors: c },\n  scanner: { rows: ['...gggggg...', '..g......g..', '.g..gg....g.', '.g...gg...g.', '.g........g.', '..g......g..', '...gggggg...', '.....dd.....', '.....dd.....', '.....dd.....', '.....dd.....'], colors: c },\n};\nEOF\ncat > src/ui/menu.js <<'EOF'\n// A 10-foot list: big focused item with a bright marker; d-pad, keys, hover and click all move the same focus.\nexport class Menu {\n  constructor(app, items, opts = {}) { this.app = app; this.items = items; this.focus = opts.focus ?? 0; this.rowH = opts.rowH ?? 18; this.x = opts.x ?? null; this.y = opts.y ?? 90; this.width = opts.width ?? 200; this.scroll = 0; this.maxRows = opts.maxRows ?? 8; this.fixFocus(1); this.hit = []; }\n  fixFocus(dir) { let n = this.items.length; while (n-- > 0 && this.items[this.focus]?.disabled) this.focus = (this.focus + dir + this.items.length) % this.items.length; }\n  /** Input step; returns the activated item or 'back' or null. */\n  update(ctx) {\n    const { devices, audio } = this.app, n = devices.nav;\n    const prev = this.focus;\n    if (n.up) { this.focus = (this.focus - 1 + this.items.length) % this.items.length; this.fixFocus(-1); }\n    if (n.down) { this.focus = (this.focus + 1) % this.items.length; this.fixFocus(1); }\n    if (devices.pointerMoved) for (const h of this.hit) { if (devices.pointerX >= h.x && devices.pointerX <= h.x + h.w && devices.pointerY >= h.y && devices.pointerY <= h.y + h.h && !this.items[h.i].disabled) this.focus = h.i; }\n    if (ctx.input.wheel) { this.focus = (this.focus + Math.sign(ctx.input.wheel) + this.items.length) % this.items.length; this.fixFocus(Math.sign(ctx.input.wheel)); }\n    if (this.focus !== prev) audio.play('uiMove');\n    const item = this.items[this.focus];\n    if (item?.adjust && (n.left || n.right)) { item.adjust(n.right ? 1 : -1); audio.play('uiMove'); }\n    if (n.back || devices.rightClick(ctx.input)) { audio.play('uiBack'); return 'back'; }\n    if (n.confirm) { audio.play('uiConfirm'); return item; }\n    const click = devices.click(ctx.input);\n    if (click) for (const h of this.hit) {\n      if (click.x >= h.x && click.x <= h.x + h.w && click.y >= h.y && click.y <= h.y + h.h && !this.items[h.i].disabled) {\n        this.focus = h.i;\n        const it = this.items[h.i];\n        if (it.adjust && it.value) { it.adjust(click.x > h.x + h.w / 2 ? 1 : -1); audio.play('uiMove'); return null; }\n        audio.play('uiConfirm');\n        return it;\n      }\n    }\n    return null;\n  }\n  draw(hud) {\n    const X = this.x ?? Math.round((hud.width - this.width) / 2);\n    this.hit = [];\n    if (this.focus < this.scroll) this.scroll = this.focus;\n    if (this.focus >= this.scroll + this.maxRows) this.scroll = this.focus - this.maxRows + 1;\n    const end = Math.min(this.items.length, this.scroll + this.maxRows);\n    for (let i = this.scroll; i < end; i++) {\n      const it = this.items[i], y = this.y + (i - this.scroll) * this.rowH, on = i === this.focus;\n      if (on) { hud.rect(X - 4, y - 4, this.width + 8, this.rowH - 2, 0x8a1f38); hud.rect(X - 4, y - 4, 3, this.rowH - 2, 0xffd24d); }\n      const color = it.disabled ? 0x5a6172 : on ? 0xffffff : 0xb8c0d0;\n      hud.text(X + 4, y, it.label, { color, scale: this.app.settings.pixel && it.big ? 2 : 1 });\n      if (it.value) {\n        const val = `${on ? '< ' : ''}${it.value()}${on ? ' >' : ''}`;\n        hud.text(X + this.width - hud.measure(val).width - 2, y, val, { color: on ? 0xffd24d : 0x8ad0ff });\n      }\n      if (it.bar) { const b = it.bar(), W = 64, bx = X + this.width - W - 60; hud.rect(bx, y + 1, W, 5, 0x2a3142); hud.rect(bx, y + 1, Math.round(W * b), 5, on ? 0xffd24d : 0x8ad0ff); }\n      this.hit.push({ i, x: X - 4, y: y - 4, w: this.width + 8, h: this.rowH - 2 });\n    }\n    if (this.scroll > 0) hud.text(X + this.width - 6, this.y - 12, '^', { color: 0xffd24d });\n    if (end < this.items.length) hud.text(X + this.width - 6, this.y + this.maxRows * this.rowH - 4, 'v', { color: 0xffd24d });\n  }\n}\nEOF\ncat > src/core/app.js <<'EOF'\n// The persistent singleton: save, settings, devices, config, director. Stages come and go; this stays.\nimport { config, resetConfig } from './config.js';\nimport { loadAll, storeAll } from './save.js';\nimport { Devices } from '../input/devices.js';\nimport { Prompts } from '../ui/prompts.js';\nimport { Voice, loadSyllables } from '../audio/voice.js';\nimport { MusicDirector } from '../audio/director.js';\nimport { SFX_DEFS } from '../content/sfx.js';\nimport { CAST } from '../content/cast.js';\n\nexport class App {\n  devices = new Devices();\n  config = config;\n  prompts = new Prompts(this);\n  voice = new Voice(this);\n  engine = null; ctx = null; director = null;\n  sessionInfo = null; touchGate = false; flags = {}; urlFlags = {};\n  attractIndex = 0;\n  chosenSeats = null;\n  constructor() { const { save, settings } = loadAll(); this.save = save; this.settings = settings; }\n  get audio() { return this.engine.audio; }\n  async boot(ctx) {\n    this.engine = ctx.engine; this.ctx = ctx;\n    if (this.booted) return;\n    this.booted = true;\n    const audio = ctx.audio;\n    for (const [k, def] of Object.entries(SFX_DEFS)) audio.register(k, def);\n    let stored = null;\n    try { stored = typeof localStorage !== 'undefined' ? localStorage.getItem('pixel-engine:audio') : null; } catch { stored = null; }\n    if (!stored) audio.setVolume('music', 0.1); // the brief: music at 10% by default.\n    this.settings.music = audio.volume.music;\n    this.settings.sfx = audio.volume.sfx;\n    if (audio.volume.music !== this.settings.music) audio.setVolume('music', this.settings.music);\n    this.director = new MusicDirector(audio);\n    await loadSyllables(audio).catch(() => {});\n    ctx.input.preventKeys.add('Tab');\n    ctx.engine.input.gamepadButtons = {};\n    const box = ctx.engine.renderer.container;\n    if (box) box.addEventListener('contextmenu', (e) => e.preventDefault());\n    this.applyLook();\n  }\n  persist() { if (this.demo) return; storeAll(this.save, this.settings); }\n  resetConfig() { resetConfig(config); }\n  castOf(id) { return CAST[id]; }\n  applyLook(sat = 1, vig = 0.3, spread = 0) { this.engine.setLook(fieldLook(sat, vig, spread, this.settings)); }\n  rumble(strong, weak, ms, index = null) { this.devices.rumble(index, strong, weak, ms, this.settings.rumble && !this.demo); }\n  flash(color, o) { if (!this.settings.reduceFlash) this.engine.screen.flash(color, o); }\n  shake(v) { if (this.settings.shake > 0) this.engine.shake.add(v * this.settings.shake); }\n}\nexport function fieldLook(sat = 1, vig = 0.3, spread = 0, settings = {}) {\n  const size = settings.pixel ?? 1;\n  return {\n    scene: [{ id: 'vignette', params: { intensity: vig } }, { id: 'adjust', params: { saturation: sat, contrast: 1 } }, { id: 'chromatic', params: { spread } }],\n    actors: { pixel: { size, outline: 0.85, crease: 0.2 }, filters: [] },\n    environment: { pixel: { size, outline: 0, crease: 0 }, filters: [] },\n  };\n}\nexport const app = new App();\nEOF\ncat > src/ui/hud.js <<'EOF'\n// The operating HUD: top strip, comm strip, tool wheel, pop-ups, Code Blue, Massage.\nimport { CAST } from '../content/cast.js';\nimport { TOOL_ICONS } from '../content/icons.js';\nimport { TOOLS } from '../sim/tools.js';\nimport { defOf } from '../sim/op.js';\n\nconst RCOL = { CLEAN: 0x7fffa0, GOOD: 0x8ad0ff, SLOPPY: 0xffb04d, MISTAKE: 0xff5a5a };\n\nexport class OpHud {\n  constructor(app, ctx) {\n    this.app = app; this.ctx = ctx;\n    this.ekg = new Array(70).fill(0); this.ekgT = 0; this.ekgPhase = 0;\n    this.popups = []; this.comm = []; this.current = null; this.typed = 0; this.promptText = null; this.promptT = 0;\n    this.wheelT = 0; this.wheelSlot = -1; this.stageFlash = 0; this.toast = null;\n    this.tabHit = []; this.wheelHit = null;\n  }\n  say(who, text) { if (!text) return; this.comm.push({ who, text }); if (this.comm.length > 4) this.comm.splice(0, this.comm.length - 3); }\n  prompt(text) { this.promptText = text; this.promptT = 7; }\n  rating(r, x, y, pts, streak) { this.popups.push({ r, x, y, t: 1, pts, streak }); }\n\n  updateComm(dt, audio) {\n    if (!this.current && this.comm.length) { this.current = { ...this.comm.shift(), t: 0, i: 0, n: 0 }; this.typedChar = 0; }\n    if (this.current) {\n      const c = this.current, plain = c.text.replace(/\\{[^}]+\\}|\\*/g, '');\n      const speed = 40 * (this.app.settings.textSpeed ?? 1) * (CAST[c.who]?.voice?.speed ?? 1);\n      const prev = Math.floor(c.i);\n      c.i = Math.min(plain.length, c.i + dt * speed);\n      const now = Math.floor(c.i);\n      for (let k = prev; k < now; k++) {\n        const end = plain.slice(k).search(/[.!?]/);\n        const punct = end >= 0 ? plain[k + end] : '';\n        if (this.app.voice.letter(audio, plain[k], c.who, CAST[c.who], k, punct)) c.talk = 0.1;\n      }\n      c.talk = Math.max(0, (c.talk ?? 0) - dt);\n      if (c.i >= plain.length) { c.t += dt; if (c.t > 1.8 + plain.length * 0.018 || (this.comm.length && c.t > 0.9)) this.current = null; }\n    }\n    return this.current;\n  }\n\n  draw(sim, dt, seatsInfo, opts = {}) {\n    const { hud, input } = this.ctx, app = this.app, W = hud.width, H = hud.height, P = app.prompts;\n    hud.clear();\n    const seat = sim.seats[opts.mySeat ?? 0] ?? sim.seats[0];\n    const t = sim.tables[seat?.table ?? 0] ?? sim.tables[0];\n    const def = defOf(sim) ?? opts.def;\n    const shown = t.fake ?? t.vitals;\n    const crit = shown < 30;\n    // top strip\n    hud.rect(0, 0, W, 21, 0x0d0b14);\n    hud.rect(0, 21, W, 1, crit ? 0xff3a3a : 0x2a3142);\n    hud.text(4, 3, 'VITALS', { color: crit ? 0xff6b6b : 0x7fffa0 });\n    hud.text(44, 3, String(Math.ceil(shown)).padStart(2, '0'), { color: crit ? 0xff5a5a : 0x7fffa0, scale: 2, shadow: false });\n    // EKG\n    const rate = crit ? 2.2 : 1.1, sdt = dt * (sim.quiet ? 0.25 : 1);\n    this.ekgT += sdt * 60;\n    while (this.ekgT > 1) {\n      this.ekgT -= 1;\n      this.ekgPhase = (this.ekgPhase + (rate / 60) * 1.0) % 1;\n      const p = this.ekgPhase;\n      let v = p < 0.08 ? 3 : p < 0.1 ? 12 : p < 0.13 ? -6 : p < 0.2 ? 1 : p < 0.3 ? 3 : 0;\n      if (t.fake != null) v += Math.sin(this.ekg.length * p * 40) * 3; // the monitor lies; the trace can't\n      if (sim.phase === 'codeblue') v = 0;\n      this.ekg.push(v); this.ekg.shift();\n    }\n    const ekgX = 70;\n    for (let i = 1; i < this.ekg.length; i++) hud.rect(ekgX + i, 11 - Math.round(this.ekg[i]) / 1.6, 1, 1, crit ? 0xff3a3a : 0x46e0a0);\n    // clock\n    const c = Math.max(0, sim.clock), mm = String(Math.floor(c / 60)).padStart(1, '0'), ss = String(Math.floor(c % 60)).padStart(2, '0');\n    const clockStr = `${mm}:${ss}`, cw = hud.measure(clockStr, 2).width;\n    hud.text(Math.round(W / 2 - cw / 2), 3, clockStr, { color: c < 30 ? 0xff5a5a : 0xffffff, scale: 2 });\n    // table tabs\n    this.tabHit = [];\n    if (sim.tables.length > 1) {\n      sim.tables.forEach((tb, i) => {\n        const x = Math.round(W / 2 - 66 + i * 46), y = 25, on = i === seat.table;\n        hud.rect(x, y, 42, 14, on ? 0x8a1f38 : 0x1a1f2b);\n        hud.text(x + 3, y + 3, 'ABC'[i], { color: 0xffffff });\n        hud.text(x + 14, y + 3, String(Math.ceil(tb.vitals)), { color: tb.vitals < 30 ? (Math.floor(this.ctx.time * 6) % 2 ? 0xff5a5a : 0xffffff) : 0x7fffa0 });\n        this.tabHit.push({ i, x, y, w: 42, h: 14 });\n      });\n    }\n    // composure\n    if (sim.giftOn) {\n      const bw = Math.min(100, Math.round(W * 0.2)), bx = W - bw - 4;\n      hud.text(bx, 2, seat.gift === 'look' ? 'THE SECOND LOOK' : 'THE QUIET', { color: sim.quiet ? 0xffffff : 0xb8c0d0 });\n      hud.rect(bx, 12, bw, 6, 0x2a3142);\n      hud.rect(bx, 12, Math.round((bw * sim.composure) / 100), 6, sim.quiet ? 0xffffff : seat.gift === 'look' ? 0xc08bff : 0x57c7ff);\n      const need = seat.gift === 'look' ? sim.cfg?.lookCost ?? 60 : 20;\n      hud.rect(bx + Math.round((bw * need) / 100), 11, 1, 8, 0xffd24d);\n      if (sim.tagOn) hud.text(bx - 56, 12, sim.doctor === 'ilya' ? 'MARSH' : 'ACHTERBERG', { color: 0xffd24d });\n    }\n    // score & streak\n    const scoreStr = `${sim.score}`;\n    hud.text(W - (sim.giftOn ? Math.min(100, Math.round(W * 0.2)) + 10 : 4) - hud.measure(scoreStr).width - 60, 3, scoreStr, { color: 0xffd24d });\n    if (sim.streak > 1) hud.text(W - (sim.giftOn ? Math.min(100, Math.round(W * 0.2)) + 10 : 4) - 60 - hud.measure(`X${1 + Math.min(sim.streak, 10) * 0.1}`).width, 12, `X${(1 + Math.min(sim.streak, 10) * 0.1).toFixed(1)}`, { color: 0xffffff });\n    if (sim.mistakes > 0) for (let i = 0; i < sim.mistakes; i++) hud.rect(W / 2 + cw / 2 + 8 + i * 6, 6, 4, 8, 0xff5a5a);\n    // cold bar\n    if (sim.cold) {\n      const bw = 90, bx = Math.round(W / 2 - 45), y = 25;\n      hud.text(bx, y, `COLD ${Math.ceil(sim.cold.t)}`, { color: 0x8ad0ff });\n      hud.rect(bx, y + 9, bw, 4, 0x2a3142);\n      hud.rect(bx, y + 9, Math.round((bw * sim.cold.t) / sim.cold.max), 4, 0x8ad0ff);\n    }\n    // heart bpm\n    if (sim.heart) {\n      const sys = sim.heart.phase < 0.35;\n      hud.text(4, 26, `${Math.round(sim.heart.bpm)} BPM`, { color: sim.heart.bpm >= 108 ? 0xff5a5a : 0xffffff });\n      hud.rect(4, 36, 54, 6, 0x2a3142);\n      hud.rect(4 + Math.round(54 * sim.heart.phase), 35, 2, 8, 0xffffff);\n      hud.rect(4, 36, Math.round(54 * 0.35), 6, 0xb5202a);\n      hud.text(4, 45, sys ? 'WAIT' : 'CUT', { color: sys ? 0xff5a5a : 0x7fffa0 });\n    }\n    if (sim.pain != null) { hud.text(4, 26, 'PAIN', { color: 0xffd24d }); for (let i = 0; i < 5; i++) hud.rect(32 + i * 7, 26, 5, 7, i < sim.pain ? 0xffd24d : 0x2a3142); }\n\n    // comm strip\n    const comm = this.updateComm(dt, this.ctx.audio);\n    const stripH = 33, sy = H - stripH;\n    hud.rect(0, sy, W, stripH, 0x0d0b14);\n    hud.rect(0, sy, W, 1, 0x2a3142);\n    const wheelSize = 54, textW = W - wheelSize - 12 - 32;\n    if (sim.voiceOff && !comm) {\n      const flick = Math.floor(this.ctx.time * 3) % 7 !== 0;\n      hud.text(36, sy + 5, 'NO SIGNAL', { color: flick ? 0x5a6172 : 0x2a3142, scale: 2 });\n    } else if (comm) {\n      const col = CAST[comm.who]?.color ?? 0xffffff;\n      hud.text(36, sy + 3, CAST[comm.who]?.name ?? comm.who.toUpperCase(), { color: col });\n      P.draw(hud, 36, sy + 12, comm.text, { width: textW, limit: Math.floor(comm.i) });\n    } else if (opts.objective) {\n      hud.text(36, sy + 3, 'OBJECTIVE', { color: 0x5a6172 });\n      P.draw(hud, 36, sy + 12, opts.objective, { width: textW, color: 0x8a93a6 });\n    }\n    // bust frame\n    hud.rect(2, sy + 2, 30, 29, 0x1a1f2b);\n    // prompt banner\n    if (this.promptT > 0) {\n      this.promptT -= dt;\n      const tw = Math.min(W - 40, P.items(this.promptText, hud, 0).reduce((n, i) => n + i.w, 0) + 4);\n      const lines = P.lineCount(this.promptText, hud, tw);\n      const by = H - stripH - 13 - (lines - 1) * 11;\n      hud.rect(Math.round(W / 2 - tw / 2 - 5), by - 3, tw + 10, lines * 11 + 4, 0x000000);\n      P.draw(hud, Math.round(W / 2 - tw / 2), by, this.promptText, { width: tw, color: 0xffffff, center: true });\n    }\n    // tool wheel\n    this.drawWheel(sim, seat, W, H, wheelSize);\n    // dose count\n    if (sim.tools.includes('syringe')) {\n      hud.text(W - wheelSize - 42, H - 11, `DOSE ${sim.doses}`, { color: sim.doses ? 0xff9ab0 : 0x5a6172 });\n    }\n    // hint arrow text\n    if (sim.hint && seat.tool !== sim.hint.tool && sim.hint.tool && !sim.noHint) {\n      const n = TOOLS.indexOf(sim.hint.tool) + 1;\n      const label = `${sim.hint.tool.toUpperCase()}: {tool:${n}}`;\n      const w = P.items(label, hud, 0).reduce((q, i) => q + i.w, 0);\n      P.draw(hud, W - w - 6, H - wheelSize - 14, label, { width: w + 6, color: 0xffd24d });\n    }\n    // pop-ups\n    for (let i = this.popups.length - 1; i >= 0; i--) {\n      const p = this.popups[i];\n      p.t -= dt * 0.9;\n      if (p.t <= 0) { this.popups.splice(i, 1); continue; }\n      const y = p.y - (1 - p.t) * 14, label = p.r;\n      const w = hud.measure(label, 2).width;\n      hud.text(Math.round(Math.max(2, Math.min(W - w - 2, p.x - w / 2))), Math.round(Math.max(24, y)), label, { color: RCOL[p.r], scale: 2 });\n      if (p.streak > 1 && p.r === 'CLEAN') hud.text(Math.round(p.x + w / 2 + 3), Math.round(y + 4), `+${p.streak}`, { color: 0xffffff });\n    }\n    // red pulse at low vitals\n    if (crit && sim.phase === 'play') { const a = Math.floor(this.ctx.time * 4) % 2; if (a) { hud.rect(0, 22, W, 1, 0xff3a3a); hud.rect(0, sy - 1, W, 1, 0xff3a3a); } }\n    // Code Blue overlay\n    if (sim.codeBlue) this.drawCodeBlue(sim, W, H);\n    if (sim.massage) this.drawMassage(sim, W, H);\n    // ghost hint\n    if (sim.ghost) hud.text(Math.round(W / 2 - 60), 42, 'THE SECOND LOOK', { color: 0xc08bff });\n    void input;\n  }\n\n  drawWheel(sim, seat, W, H, size) {\n    const { hud } = this.ctx, cx = W - size / 2 - 2, cy = H - size / 2 - 2;\n    const R = 20;\n    hud.rect(W - size - 4, H - size - 4, size + 4, size + 4, 0x0d0b14);\n    this.wheelHit = [];\n    TOOLS.forEach((id, i) => {\n      const a = -Math.PI / 2 + (i / 8) * Math.PI * 2, x = Math.round(cx + Math.cos(a) * R), y = Math.round(cy + Math.sin(a) * R);\n      const on = id === seat.tool, avail = sim.tools.includes(id);\n      if (on) hud.rect(x - 4, y - 4, 9, 9, 0xffd24d);\n      else hud.rect(x - 3, y - 3, 7, 7, avail ? (this.wheelSlot === i ? 0xffffff : 0x57606f) : 0x1a1f2b);\n      this.wheelHit.push({ i, x: x - 5, y: y - 5, w: 11, h: 11 });\n    });\n    const ic = TOOL_ICONS[seat.tool];\n    if (ic) hud.sprite(Math.round(cx - 6), Math.round(cy - 5), ic.rows, ic.colors);\n    if (this.wheelT > 0) {\n      const mid = hud.measure(seat.tool.toUpperCase()).width;\n      hud.text(Math.round(W - size - mid - 8), H - size - 4, seat.tool.toUpperCase(), { color: 0xffd24d });\n    }\n  }\n\n  drawCodeBlue(sim, W, H) {\n    const { hud } = this.ctx, cb = sim.codeBlue, P = this.app.prompts;\n    const flicker = Math.floor(this.ctx.time * 4) % 2 ? 0xff3a3a : 0xffffff;\n    const panelW = 240, x = Math.round(W / 2 - panelW / 2), y = Math.round(H / 2 - 54);\n    hud.rect(x - 2, y - 2, panelW + 4, 98, 0x3a0a14);\n    hud.rect(x, y, panelW, 94, 0x0d0b14);\n    hud.text(x + 6, y + 5, 'CODE BLUE', { color: flicker, scale: 2 });\n    hud.text(x + panelW - 58, y + 9, `${Math.ceil(cb.t)}S`, { color: 0xffffff, scale: 1 });\n    hud.text(x + panelW - 30, y + 9, `${cb.shocks}/${cb.need}`, { color: 0x7fffa0 });\n    const bw = panelW - 24, bx = x + 12, by = y + 32;\n    hud.rect(bx, by, bw, 14, 0x2a3142);\n    const zx = bx + Math.round(bw * (cb.centre - cb.zone / 2)), zw = Math.round(bw * cb.zone);\n    hud.rect(zx, by, zw, 14, 0x2bb673);\n    const nx = bx + Math.round(bw * cb.needle);\n    hud.rect(nx - 1, by - 3, 3, 20, cb.charging ? 0xffffff : 0x8a93a6);\n    P.draw(hud, x + 12, y + 56, cb.charging ? 'RELEASE IN THE GREEN!' : 'HOLD {paddles} TO CHARGE', { width: bw, color: 0xffffff, center: true });\n    hud.text(x + 12, y + 74, 'TWO GOOD SHOCKS. CLEAR!', { color: 0x8a93a6 });\n  }\n\n  drawMassage(sim, W, H) {\n    const { hud } = this.ctx, m = sim.massage, P = this.app.prompts;\n    const panelW = 220, x = Math.round(W / 2 - panelW / 2), y = Math.round(H / 2 - 44);\n    hud.rect(x, y, panelW, 76, 0x0d0b14);\n    hud.text(x + 6, y + 5, 'MASSAGE', { color: 0xff6b6b, scale: 2 });\n    hud.text(x + panelW - 34, y + 9, `${m.count}/${m.need}`, { color: 0x7fffa0 });\n    const ph = (m.t % m.period) / m.period, near = Math.min(ph, 1 - ph) * m.period <= m.window;\n    const size = near ? 22 : 12, cx = x + panelW / 2;\n    hud.rect(Math.round(cx - size / 2), y + 28 + (22 - size) / 2 | 0, size, size, near ? 0xff5a5a : 0x5a1f28);\n    const nextL = m.last !== 1;\n    hud.text(x + 22, y + 34, nextL ? '>LEFT<' : 'LEFT', { color: nextL ? 0xffd24d : 0x5a6172 });\n    hud.text(x + panelW - 60, y + 34, !nextL ? '>RIGHT<' : 'RIGHT', { color: !nextL ? 0xffd24d : 0x5a6172 });\n    P.draw(hud, x + 8, y + 58, 'ALTERNATE {squeeze} ON THE BEAT', { width: panelW - 16, color: 0xffffff, center: true });\n  }\n}\nEOF\necho ok","description":"Write save, prompts, icons, menu, app, op HUD"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":19736,"cache_read_input_tokens":275423,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":19736},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9464247a-cdba-4289-905c-cd8b34e5d270","uuid":"68ec0b49-45e7-4761-bf08-b8c777b29ab5","timestamp":"2026-11-05T16:52:44.831Z","request_id":"req_011Cgk8GZBk9uWEXmJmv53iH","wire_tool_inputs":{"toolu_01799HBMvjLpi7zkDzHC1yov":{"command":"cat > src/core/save.js <<'EOF'\n// Guarded localStorage under a versioned key. In a session the client hands us an empty store.\nconst KEY = 'second-stitch:v1';\nexport const DEFAULT_SAVE = () => ({ next: 0, sceneDone: {}, ranks: {}, scores: {}, difficulty: 'resident', cleared: {}, finished: false, fails: {} });\nexport const DEFAULT_SETTINGS = () => ({ music: 0.1, sfx: 0.8, voices: 0.8, glyphs: 'ps', aim: 'low', cursor: 1, rumble: true, giftToggle: false, look: 'field', pixel: 1, shake: 1, reduceFlash: false, textSpeed: 1, difficulty: 'resident', fullscreen: false });\nconst store = () => { try { return typeof localStorage !== 'undefined' ? localStorage : null; } catch { return null; } };\nexport function loadAll() {\n  const s = store(); let raw = null;\n  try { raw = s?.getItem(KEY); } catch { raw = null; }\n  try { const d = raw ? JSON.parse(raw) : {}; return { save: { ...DEFAULT_SAVE(), ...d.save }, settings: { ...DEFAULT_SETTINGS(), ...d.settings } }; } catch { return { save: DEFAULT_SAVE(), settings: DEFAULT_SETTINGS() }; }\n}\nexport function storeAll(save, settings) {\n  try { store()?.setItem(KEY, JSON.stringify({ save, settings })); } catch { /* full or blocked: play on */ }\n}\nexport const saveKey = KEY;\nEOF\ncat > src/ui/prompts.js <<'EOF'\n// Prompts follow the last input used. Text in data uses tokens resolved at draw time.\nimport { TOOLS } from '../sim/tools.js';\n\nconst SPR = {\n  cross: { rows: ['.........', '.x.....x.', '..x...x..', '...x.x...', '....x....', '...x.x...', '..x...x..', '.x.....x.', '.........'], colors: { x: 0x7fb4ff } },\n  circle: { rows: ['..xxxxx..', '.x.....x.', 'x.......x', 'x.......x', 'x.......x', 'x.......x', 'x.......x', '.x.....x.', '..xxxxx..'], colors: { x: 0xff6b6b } },\n  square: { rows: ['.........', '.xxxxxxx.', '.x.....x.', '.x.....x.', '.x.....x.', '.x.....x.', '.x.....x.', '.xxxxxxx.', '.........'], colors: { x: 0xf08ad0 } },\n  triangle: { rows: ['....x....', '...x.x...', '...x.x...', '..x...x..', '..x...x..', '.x.....x.', '.x.....x.', 'xxxxxxxxx', '.........'], colors: { x: 0x6be0b0 } },\n  mouseL: { rows: ['.xxxxxx.', 'xoooxxxx', 'xoooxxxx', 'xoooxxxx', 'xxxxxxxx', 'x......x', 'x......x', 'x......x', '.xxxxxx.'], colors: { x: 0xffffff, o: 0xffd24d } },\n  mouseR: { rows: ['.xxxxxx.', 'xxxxooox', 'xxxxooox', 'xxxxooox', 'xxxxxxxx', 'x......x', 'x......x', 'x......x', '.xxxxxx.'], colors: { x: 0xffffff, o: 0xffd24d } },\n  mouseW: { rows: ['.xxxxxx.', 'xxxooxxx', 'xxxooxxx', 'xxxooxxx', 'xxxxxxxx', 'x......x', 'x......x', 'x......x', '.xxxxxx.'], colors: { x: 0xffffff, o: 0xffd24d } },\n  stick: { rows: ['..xxxxx..', '.x.....x.', 'x..xxx..x', 'x.xxxxx.x', 'x.xxxxx.x', 'x.xxxxx.x', 'x..xxx..x', '.x.....x.', '..xxxxx..'], colors: { x: 0xbfc8d8 } },\n};\nconst XB = { cross: ['A', 0x6be07b], circle: ['B', 0xff6b6b], square: ['X', 0x7fb4ff], triangle: ['Y', 0xffd24d] };\n\n// token -> by device: a list of glyph specs. Strings are key names; {s:'name'} sprites; {pad:'L2'} shoulder labels; {face:'cross'} faces.\nconst pad = (name) => ({ pad: name }), face = (name) => ({ face: name }), key = (name) => ({ key: name }), mouse = (name) => ({ s: name });\nconst TOKENS = {\n  use: { pad: [pad('R2')], kbm: [mouse('mouseL')] },\n  back: { pad: [face('circle')], kbm: [key('ESC')] },\n  confirm: { pad: [face('cross')], kbm: [key('ENTER')] },\n  gift: { pad: [pad('L2')], kbm: [key('SPACE')] },\n  steady: { pad: [pad('L1')], kbm: [key('SHIFT')] },\n  quick: { pad: [face('square')], kbm: [key('F')] },\n  drop: { pad: [face('circle')], kbm: [mouse('mouseR')] },\n  rotate: { pad: [{ s: 'stick' }], kbm: [key('Q'), key('E')] },\n  table: { pad: [pad('DPAD')], kbm: [key('TAB')] },\n  tag: { pad: [face('triangle')], kbm: [key('E')] },\n  paddles: { pad: [pad('L2'), pad('R2')], kbm: [mouse('mouseL'), mouse('mouseR')] },\n  squeeze: { pad: [pad('L2'), pad('R2')], kbm: [mouse('mouseL'), mouse('mouseR')] },\n  more: { pad: [face('triangle')], kbm: [key('M')] },\n  pause: { pad: [pad('OPT')], kbm: [key('ESC')] },\n  last: { pad: [pad('R1')], kbm: [key('Q')] },\n  remind: { pad: [face('triangle')], kbm: [key('E')] },\n  move: { pad: [{ s: 'stick' }], kbm: [{ text: 'MOUSE' }] },\n  tabl: { pad: [pad('L1')], kbm: [key('Q')] },\n  tabr: { pad: [pad('R1')], kbm: [key('E')] },\n};\n\nexport class Prompts {\n  constructor(app) { this.app = app; }\n  get device() { return this.app.devices.last === 'pad' ? 'pad' : 'kbm'; }\n  specs(token) {\n    if (token.startsWith('tool:')) {\n      const n = +token.slice(5);\n      return this.device === 'pad' ? [{ s: 'stick' }, { text: wheelDir(n) }] : [key(String(n))];\n    }\n    return TOKENS[token]?.[this.device] ?? [{ text: token.toUpperCase() }];\n  }\n  glyphWidth(spec, hud) {\n    if (spec.s) return (SPR[spec.s].rows[0].length) + 1;\n    if (spec.face) return 10;\n    if (spec.pad) return this.xbName(spec.pad).length * 6 + 5;\n    if (spec.key) return spec.key.length * 6 + 5;\n    if (spec.text) return hud.measure(spec.text).width + 2;\n    return 0;\n  }\n  xbName(name) { if (this.app.settings.glyphs !== 'xbox') return name; return { L1: 'LB', R1: 'RB', L2: 'LT', R2: 'RT', OPT: 'MENU' }[name] ?? name; }\n  drawGlyph(hud, x, y, spec) {\n    if (spec.s) { const s = SPR[spec.s]; hud.sprite(x, y - 1, s.rows, s.colors); return; }\n    if (spec.face) {\n      if (this.app.settings.glyphs === 'xbox') { const [ch, col] = XB[spec.face]; hud.rect(x, y - 1, 9, 9, 0x1a1f2b); hud.text(x + 2, y, ch, { color: col, shadow: false }); return; }\n      const s = SPR[spec.face]; hud.sprite(x, y - 1, s.rows, s.colors); return;\n    }\n    if (spec.pad || spec.key) {\n      const name = spec.pad ? this.xbName(spec.pad) : spec.key, w = name.length * 6 + 3;\n      hud.rect(x, y - 1, w, 9, spec.pad ? 0x2a3142 : 0xe8e8e8);\n      hud.text(x + 2, y, name, { color: spec.pad ? 0xffffff : 0x14161e, shadow: false });\n      return;\n    }\n    if (spec.text) hud.text(x, y, spec.text, { color: 0xffd24d });\n  }\n  /** Break text into word items with glyphs and highlights. */\n  items(text, hud, baseColor) {\n    const out = [];\n    let hl = false;\n    const parts = text.split(/(\\{[a-z:0-9]+\\}|\\*)/gi);\n    for (const part of parts) {\n      if (!part) continue;\n      if (part === '*') { hl = !hl; continue; }\n      const m = part.match(/^\\{([a-z:0-9]+)\\}$/i);\n      if (m) { for (const spec of this.specs(m[1])) out.push({ spec, w: this.glyphWidth(spec, hud) }); continue; }\n      for (const tok of part.split(/(\\s+)/)) {\n        if (!tok) continue;\n        if (/^\\s+$/.test(tok)) out.push({ space: true, w: 6 });\n        else out.push({ word: tok, color: hl ? 0xffd24d : baseColor, w: hud.measure(tok).width + 1 });\n      }\n    }\n    return out;\n  }\n  /** Wrapped rich text; returns the number of lines. `limit` reveals only so many characters. */\n  draw(hud, x, y, text, { width = 300, color = 0xffffff, lineH = 11, limit = Infinity, center = false, scale = 1 } = {}) {\n    const items = this.items(text, hud, color);\n    const lines = [[]]; let w = 0;\n    for (const it of items) {\n      if (it.space && lines[lines.length - 1].length === 0) continue;\n      if (!it.space && w + it.w > width && lines[lines.length - 1].length) { lines.push([]); w = 0; }\n      lines[lines.length - 1].push(it); w += it.w;\n    }\n    let shown = 0;\n    lines.forEach((ln, i) => {\n      let cx = x;\n      const lw = ln.reduce((n, q) => n + q.w, 0);\n      if (center) cx = x + (width - lw) / 2;\n      for (const it of ln) {\n        if (it.word) {\n          const left = limit - shown;\n          if (left > 0) hud.text(Math.round(cx), y + i * lineH, it.word.slice(0, left), { color: it.color, scale });\n          shown += it.word.length;\n        } else if (it.spec && shown < limit) this.drawGlyph(hud, Math.round(cx), y + i * lineH, it.spec);\n        cx += it.w;\n      }\n    });\n    return lines.length;\n  }\n  lineCount(text, hud, width) {\n    const items = this.items(text, hud, 0); let n = 1, w = 0, empty = true;\n    for (const it of items) { if (it.space && empty) continue; if (!it.space && w + it.w > width && !empty) { n++; w = 0; empty = true; } w += it.w; empty = false; }\n    return n;\n  }\n  /** A short prompt strip: [glyph] LABEL pairs, bottom-left. */\n  strip(hud, x, y, pairs) {\n    let cx = x;\n    for (const [tok, label] of pairs) {\n      for (const spec of this.specs(tok)) { this.drawGlyph(hud, cx, y, spec); cx += this.glyphWidth(spec, hud); }\n      cx += 2;\n      hud.text(cx, y, label, { color: 0xd8dde8 });\n      cx += hud.measure(label).width + 9;\n    }\n    return cx - x;\n  }\n}\nconst DIRS = ['UP', 'UR', 'RIGHT', 'DR', 'DOWN', 'DL', 'LEFT', 'UL'];\nconst wheelDir = (n) => DIRS[(n - 1) % 8];\nexport const toolLabel = (id) => id.toUpperCase();\nexport const toolIndex = (id) => TOOLS.indexOf(id);\nEOF\ncat > src/content/icons.js <<'EOF'\n// HUD icons as pixel rows, one per tool.\nconst c = { x: 0xe8edf5, r: 0xff6b6b, b: 0x7fb4ff, d: 0x8a93a6, g: 0x7ff0d8, y: 0xffd24d };\nexport const TOOL_ICONS = {\n  scalpel: { rows: ['..........x.', '.........xx.', '........xx..', '.......xx...', '......dd....', '.....dd.....', '....dd......', '...bb.......', '..bb........', '.dd.........', '............'], colors: c },\n  forceps: { rows: ['.x.......x..', '.x.......x..', '..x.....x...', '..x.....x...', '...x...x....', '...x...x....', '....x.x.....', '....x.x.....', '.....d......', '....ddd.....', '.....d......'], colors: c },\n  suture: { rows: ['.....xxxx...', '...xx....x..', '..x.......x.', '..x.......x.', '..x.........', '...d........', '...d.d......', '....d.d.d...', '......d.d.d.', '........d...', '............'], colors: c },\n  drain: { rows: ['...dddd.....', '...rrrr.....', '....dd......', '....dd......', '....dd......', '....dd......', '....bb......', '....bb......', '...bb.......', '..bb........', '..b.........'], colors: c },\n  syringe: { rows: ['.....x......', '.....x......', '.....x......', '....ddd.....', '....grg.....', '....grg.....', '....grg.....', '....ggg.....', '.....d......', '.....d......', '...ddddd....'], colors: { ...c, g: 0x8fd8ff } },\n  gel: { rows: ['.....x......', '....xxx.....', '....xxx.....', '...ggggg....', '...ggggg....', '...bbbbb....', '...bbbbb....', '...ggggg....', '...ggggg....', '...ggggg....', '............'], colors: c },\n  laser: { rows: ['.r..........', 'r.r.........', '.r.d........', '...dd.......', '....dd......', '.....dd.....', '......yd....', '.......dd...', '........dd..', '.........dd.', '..........d.'], colors: c },\n  scanner: { rows: ['...gggggg...', '..g......g..', '.g..gg....g.', '.g...gg...g.', '.g........g.', '..g......g..', '...gggggg...', '.....dd.....', '.....dd.....', '.....dd.....', '.....dd.....'], colors: c },\n};\nEOF\ncat > src/ui/menu.js <<'EOF'\n// A 10-foot list: big focused item with a bright marker; d-pad, keys, hover and click all move the same focus.\nexport class Menu {\n  constructor(app, items, opts = {}) { this.app = app; this.items = items; this.focus = opts.focus ?? 0; this.rowH = opts.rowH ?? 18; this.x = opts.x ?? null; this.y = opts.y ?? 90; this.width = opts.width ?? 200; this.scroll = 0; this.maxRows = opts.maxRows ?? 8; this.fixFocus(1); this.hit = []; }\n  fixFocus(dir) { let n = this.items.length; while (n-- > 0 && this.items[this.focus]?.disabled) this.focus = (this.focus + dir + this.items.length) % this.items.length; }\n  /** Input step; returns the activated item or 'back' or null. */\n  update(ctx) {\n    const { devices, audio } = this.app, n = devices.nav;\n    const prev = this.focus;\n    if (n.up) { this.focus = (this.focus - 1 + this.items.length) % this.items.length; this.fixFocus(-1); }\n    if (n.down) { this.focus = (this.focus + 1) % this.items.length; this.fixFocus(1); }\n    if (devices.pointerMoved) for (const h of this.hit) { if (devices.pointerX >= h.x && devices.pointerX <= h.x + h.w && devices.pointerY >= h.y && devices.pointerY <= h.y + h.h && !this.items[h.i].disabled) this.focus = h.i; }\n    if (ctx.input.wheel) { this.focus = (this.focus + Math.sign(ctx.input.wheel) + this.items.length) % this.items.length; this.fixFocus(Math.sign(ctx.input.wheel)); }\n    if (this.focus !== prev) audio.play('uiMove');\n    const item = this.items[this.focus];\n    if (item?.adjust && (n.left || n.right)) { item.adjust(n.right ? 1 : -1); audio.play('uiMove'); }\n    if (n.back || devices.rightClick(ctx.input)) { audio.play('uiBack'); return 'back'; }\n    if (n.confirm) { audio.play('uiConfirm'); return item; }\n    const click = devices.click(ctx.input);\n    if (click) for (const h of this.hit) {\n      if (click.x >= h.x && click.x <= h.x + h.w && click.y >= h.y && click.y <= h.y + h.h && !this.items[h.i].disabled) {\n        this.focus = h.i;\n        const it = this.items[h.i];\n        if (it.adjust && it.value) { it.adjust(click.x > h.x + h.w / 2 ? 1 : -1); audio.play('uiMove'); return null; }\n        audio.play('uiConfirm');\n        return it;\n      }\n    }\n    return null;\n  }\n  draw(hud) {\n    const X = this.x ?? Math.round((hud.width - this.width) / 2);\n    this.hit = [];\n    if (this.focus < this.scroll) this.scroll = this.focus;\n    if (this.focus >= this.scroll + this.maxRows) this.scroll = this.focus - this.maxRows + 1;\n    const end = Math.min(this.items.length, this.scroll + this.maxRows);\n    for (let i = this.scroll; i < end; i++) {\n      const it = this.items[i], y = this.y + (i - this.scroll) * this.rowH, on = i === this.focus;\n      if (on) { hud.rect(X - 4, y - 4, this.width + 8, this.rowH - 2, 0x8a1f38); hud.rect(X - 4, y - 4, 3, this.rowH - 2, 0xffd24d); }\n      const color = it.disabled ? 0x5a6172 : on ? 0xffffff : 0xb8c0d0;\n      hud.text(X + 4, y, it.label, { color, scale: this.app.settings.pixel && it.big ? 2 : 1 });\n      if (it.value) {\n        const val = `${on ? '< ' : ''}${it.value()}${on ? ' >' : ''}`;\n        hud.text(X + this.width - hud.measure(val).width - 2, y, val, { color: on ? 0xffd24d : 0x8ad0ff });\n      }\n      if (it.bar) { const b = it.bar(), W = 64, bx = X + this.width - W - 60; hud.rect(bx, y + 1, W, 5, 0x2a3142); hud.rect(bx, y + 1, Math.round(W * b), 5, on ? 0xffd24d : 0x8ad0ff); }\n      this.hit.push({ i, x: X - 4, y: y - 4, w: this.width + 8, h: this.rowH - 2 });\n    }\n    if (this.scroll > 0) hud.text(X + this.width - 6, this.y - 12, '^', { color: 0xffd24d });\n    if (end < this.items.length) hud.text(X + this.width - 6, this.y + this.maxRows * this.rowH - 4, 'v', { color: 0xffd24d });\n  }\n}\nEOF\ncat > src/core/app.js <<'EOF'\n// The persistent singleton: save, settings, devices, config, director. Stages come and go; this stays.\nimport { config, resetConfig } from './config.js';\nimport { loadAll, storeAll } from './save.js';\nimport { Devices } from '../input/devices.js';\nimport { Prompts } from '../ui/prompts.js';\nimport { Voice, loadSyllables } from '../audio/voice.js';\nimport { MusicDirector } from '../audio/director.js';\nimport { SFX_DEFS } from '../content/sfx.js';\nimport { CAST } from '../content/cast.js';\n\nexport class App {\n  devices = new Devices();\n  config = config;\n  prompts = new Prompts(this);\n  voice = new Voice(this);\n  engine = null; ctx = null; director = null;\n  sessionInfo = null; touchGate = false; flags = {}; urlFlags = {};\n  attractIndex = 0;\n  chosenSeats = null;\n  constructor() { const { save, settings } = loadAll(); this.save = save; this.settings = settings; }\n  get audio() { return this.engine.audio; }\n  async boot(ctx) {\n    this.engine = ctx.engine; this.ctx = ctx;\n    if (this.booted) return;\n    this.booted = true;\n    const audio = ctx.audio;\n    for (const [k, def] of Object.entries(SFX_DEFS)) audio.register(k, def);\n    let stored = null;\n    try { stored = typeof localStorage !== 'undefined' ? localStorage.getItem('pixel-engine:audio') : null; } catch { stored = null; }\n    if (!stored) audio.setVolume('music', 0.1); // the brief: music at 10% by default.\n    this.settings.music = audio.volume.music;\n    this.settings.sfx = audio.volume.sfx;\n    if (audio.volume.music !== this.settings.music) audio.setVolume('music', this.settings.music);\n    this.director = new MusicDirector(audio);\n    await loadSyllables(audio).catch(() => {});\n    ctx.input.preventKeys.add('Tab');\n    ctx.engine.input.gamepadButtons = {};\n    const box = ctx.engine.renderer.container;\n    if (box) box.addEventListener('contextmenu', (e) => e.preventDefault());\n    this.applyLook();\n  }\n  persist() { if (this.demo) return; storeAll(this.save, this.settings); }\n  resetConfig() { resetConfig(config); }\n  castOf(id) { return CAST[id]; }\n  applyLook(sat = 1, vig = 0.3, spread = 0) { this.engine.setLook(fieldLook(sat, vig, spread, this.settings)); }\n  rumble(strong, weak, ms, index = null) { this.devices.rumble(index, strong, weak, ms, this.settings.rumble && !this.demo); }\n  flash(color, o) { if (!this.settings.reduceFlash) this.engine.screen.flash(color, o); }\n  shake(v) { if (this.settings.shake > 0) this.engine.shake.add(v * this.settings.shake); }\n}\nexport function fieldLook(sat = 1, vig = 0.3, spread = 0, settings = {}) {\n  const size = settings.pixel ?? 1;\n  return {\n    scene: [{ id: 'vignette', params: { intensity: vig } }, { id: 'adjust', params: { saturation: sat, contrast: 1 } }, { id: 'chromatic', params: { spread } }],\n    actors: { pixel: { size, outline: 0.85, crease: 0.2 }, filters: [] },\n    environment: { pixel: { size, outline: 0, crease: 0 }, filters: [] },\n  };\n}\nexport const app = new App();\nEOF\ncat > src/ui/hud.js <<'EOF'\n// The operating HUD: top strip, comm strip, tool wheel, pop-ups, Code Blue, Massage.\nimport { CAST } from '../content/cast.js';\nimport { TOOL_ICONS } from '../content/icons.js';\nimport { TOOLS } from '../sim/tools.js';\nimport { defOf } from '../sim/op.js';\n\nconst RCOL = { CLEAN: 0x7fffa0, GOOD: 0x8ad0ff, SLOPPY: 0xffb04d, MISTAKE: 0xff5a5a };\n\nexport class OpHud {\n  constructor(app, ctx) {\n    this.app = app; this.ctx = ctx;\n    this.ekg = new Array(70).fill(0); this.ekgT = 0; this.ekgPhase = 0;\n    this.popups = []; this.comm = []; this.current = null; this.typed = 0; this.promptText = null; this.promptT = 0;\n    this.wheelT = 0; this.wheelSlot = -1; this.stageFlash = 0; this.toast = null;\n    this.tabHit = []; this.wheelHit = null;\n  }\n  say(who, text) { if (!text) return; this.comm.push({ who, text }); if (this.comm.length > 4) this.comm.splice(0, this.comm.length - 3); }\n  prompt(text) { this.promptText = text; this.promptT = 7; }\n  rating(r, x, y, pts, streak) { this.popups.push({ r, x, y, t: 1, pts, streak }); }\n\n  updateComm(dt, audio) {\n    if (!this.current && this.comm.length) { this.current = { ...this.comm.shift(), t: 0, i: 0, n: 0 }; this.typedChar = 0; }\n    if (this.current) {\n      const c = this.current, plain = c.text.replace(/\\{[^}]+\\}|\\*/g, '');\n      const speed = 40 * (this.app.settings.textSpeed ?? 1) * (CAST[c.who]?.voice?.speed ?? 1);\n      const prev = Math.floor(c.i);\n      c.i = Math.min(plain.length, c.i + dt * speed);\n      const now = Math.floor(c.i);\n      for (let k = prev; k < now; k++) {\n        const end = plain.slice(k).search(/[.!?]/);\n        const punct = end >= 0 ? plain[k + end] : '';\n        if (this.app.voice.letter(audio, plain[k], c.who, CAST[c.who], k, punct)) c.talk = 0.1;\n      }\n      c.talk = Math.max(0, (c.talk ?? 0) - dt);\n      if (c.i >= plain.length) { c.t += dt; if (c.t > 1.8 + plain.length * 0.018 || (this.comm.length && c.t > 0.9)) this.current = null; }\n    }\n    return this.current;\n  }\n\n  draw(sim, dt, seatsInfo, opts = {}) {\n    const { hud, input } = this.ctx, app = this.app, W = hud.width, H = hud.height, P = app.prompts;\n    hud.clear();\n    const seat = sim.seats[opts.mySeat ?? 0] ?? sim.seats[0];\n    const t = sim.tables[seat?.table ?? 0] ?? sim.tables[0];\n    const def = defOf(sim) ?? opts.def;\n    const shown = t.fake ?? t.vitals;\n    const crit = shown < 30;\n    // top strip\n    hud.rect(0, 0, W, 21, 0x0d0b14);\n    hud.rect(0, 21, W, 1, crit ? 0xff3a3a : 0x2a3142);\n    hud.text(4, 3, 'VITALS', { color: crit ? 0xff6b6b : 0x7fffa0 });\n    hud.text(44, 3, String(Math.ceil(shown)).padStart(2, '0'), { color: crit ? 0xff5a5a : 0x7fffa0, scale: 2, shadow: false });\n    // EKG\n    const rate = crit ? 2.2 : 1.1, sdt = dt * (sim.quiet ? 0.25 : 1);\n    this.ekgT += sdt * 60;\n    while (this.ekgT > 1) {\n      this.ekgT -= 1;\n      this.ekgPhase = (this.ekgPhase + (rate / 60) * 1.0) % 1;\n      const p = this.ekgPhase;\n      let v = p < 0.08 ? 3 : p < 0.1 ? 12 : p < 0.13 ? -6 : p < 0.2 ? 1 : p < 0.3 ? 3 : 0;\n      if (t.fake != null) v += Math.sin(this.ekg.length * p * 40) * 3; // the monitor lies; the trace can't\n      if (sim.phase === 'codeblue') v = 0;\n      this.ekg.push(v); this.ekg.shift();\n    }\n    const ekgX = 70;\n    for (let i = 1; i < this.ekg.length; i++) hud.rect(ekgX + i, 11 - Math.round(this.ekg[i]) / 1.6, 1, 1, crit ? 0xff3a3a : 0x46e0a0);\n    // clock\n    const c = Math.max(0, sim.clock), mm = String(Math.floor(c / 60)).padStart(1, '0'), ss = String(Math.floor(c % 60)).padStart(2, '0');\n    const clockStr = `${mm}:${ss}`, cw = hud.measure(clockStr, 2).width;\n    hud.text(Math.round(W / 2 - cw / 2), 3, clockStr, { color: c < 30 ? 0xff5a5a : 0xffffff, scale: 2 });\n    // table tabs\n    this.tabHit = [];\n    if (sim.tables.length > 1) {\n      sim.tables.forEach((tb, i) => {\n        const x = Math.round(W / 2 - 66 + i * 46), y = 25, on = i === seat.table;\n        hud.rect(x, y, 42, 14, on ? 0x8a1f38 : 0x1a1f2b);\n        hud.text(x + 3, y + 3, 'ABC'[i], { color: 0xffffff });\n        hud.text(x + 14, y + 3, String(Math.ceil(tb.vitals)), { color: tb.vitals < 30 ? (Math.floor(this.ctx.time * 6) % 2 ? 0xff5a5a : 0xffffff) : 0x7fffa0 });\n        this.tabHit.push({ i, x, y, w: 42, h: 14 });\n      });\n    }\n    // composure\n    if (sim.giftOn) {\n      const bw = Math.min(100, Math.round(W * 0.2)), bx = W - bw - 4;\n      hud.text(bx, 2, seat.gift === 'look' ? 'THE SECOND LOOK' : 'THE QUIET', { color: sim.quiet ? 0xffffff : 0xb8c0d0 });\n      hud.rect(bx, 12, bw, 6, 0x2a3142);\n      hud.rect(bx, 12, Math.round((bw * sim.composure) / 100), 6, sim.quiet ? 0xffffff : seat.gift === 'look' ? 0xc08bff : 0x57c7ff);\n      const need = seat.gift === 'look' ? sim.cfg?.lookCost ?? 60 : 20;\n      hud.rect(bx + Math.round((bw * need) / 100), 11, 1, 8, 0xffd24d);\n      if (sim.tagOn) hud.text(bx - 56, 12, sim.doctor === 'ilya' ? 'MARSH' : 'ACHTERBERG', { color: 0xffd24d });\n    }\n    // score & streak\n    const scoreStr = `${sim.score}`;\n    hud.text(W - (sim.giftOn ? Math.min(100, Math.round(W * 0.2)) + 10 : 4) - hud.measure(scoreStr).width - 60, 3, scoreStr, { color: 0xffd24d });\n    if (sim.streak > 1) hud.text(W - (sim.giftOn ? Math.min(100, Math.round(W * 0.2)) + 10 : 4) - 60 - hud.measure(`X${1 + Math.min(sim.streak, 10) * 0.1}`).width, 12, `X${(1 + Math.min(sim.streak, 10) * 0.1).toFixed(1)}`, { color: 0xffffff });\n    if (sim.mistakes > 0) for (let i = 0; i < sim.mistakes; i++) hud.rect(W / 2 + cw / 2 + 8 + i * 6, 6, 4, 8, 0xff5a5a);\n    // cold bar\n    if (sim.cold) {\n      const bw = 90, bx = Math.round(W / 2 - 45), y = 25;\n      hud.text(bx, y, `COLD ${Math.ceil(sim.cold.t)}`, { color: 0x8ad0ff });\n      hud.rect(bx, y + 9, bw, 4, 0x2a3142);\n      hud.rect(bx, y + 9, Math.round((bw * sim.cold.t) / sim.cold.max), 4, 0x8ad0ff);\n    }\n    // heart bpm\n    if (sim.heart) {\n      const sys = sim.heart.phase < 0.35;\n      hud.text(4, 26, `${Math.round(sim.heart.bpm)} BPM`, { color: sim.heart.bpm >= 108 ? 0xff5a5a : 0xffffff });\n      hud.rect(4, 36, 54, 6, 0x2a3142);\n      hud.rect(4 + Math.round(54 * sim.heart.phase), 35, 2, 8, 0xffffff);\n      hud.rect(4, 36, Math.round(54 * 0.35), 6, 0xb5202a);\n      hud.text(4, 45, sys ? 'WAIT' : 'CUT', { color: sys ? 0xff5a5a : 0x7fffa0 });\n    }\n    if (sim.pain != null) { hud.text(4, 26, 'PAIN', { color: 0xffd24d }); for (let i = 0; i < 5; i++) hud.rect(32 + i * 7, 26, 5, 7, i < sim.pain ? 0xffd24d : 0x2a3142); }\n\n    // comm strip\n    const comm = this.updateComm(dt, this.ctx.audio);\n    const stripH = 33, sy = H - stripH;\n    hud.rect(0, sy, W, stripH, 0x0d0b14);\n    hud.rect(0, sy, W, 1, 0x2a3142);\n    const wheelSize = 54, textW = W - wheelSize - 12 - 32;\n    if (sim.voiceOff && !comm) {\n      const flick = Math.floor(this.ctx.time * 3) % 7 !== 0;\n      hud.text(36, sy + 5, 'NO SIGNAL', { color: flick ? 0x5a6172 : 0x2a3142, scale: 2 });\n    } else if (comm) {\n      const col = CAST[comm.who]?.color ?? 0xffffff;\n      hud.text(36, sy + 3, CAST[comm.who]?.name ?? comm.who.toUpperCase(), { color: col });\n      P.draw(hud, 36, sy + 12, comm.text, { width: textW, limit: Math.floor(comm.i) });\n    } else if (opts.objective) {\n      hud.text(36, sy + 3, 'OBJECTIVE', { color: 0x5a6172 });\n      P.draw(hud, 36, sy + 12, opts.objective, { width: textW, color: 0x8a93a6 });\n    }\n    // bust frame\n    hud.rect(2, sy + 2, 30, 29, 0x1a1f2b);\n    // prompt banner\n    if (this.promptT > 0) {\n      this.promptT -= dt;\n      const tw = Math.min(W - 40, P.items(this.promptText, hud, 0).reduce((n, i) => n + i.w, 0) + 4);\n      const lines = P.lineCount(this.promptText, hud, tw);\n      const by = H - stripH - 13 - (lines - 1) * 11;\n      hud.rect(Math.round(W / 2 - tw / 2 - 5), by - 3, tw + 10, lines * 11 + 4, 0x000000);\n      P.draw(hud, Math.round(W / 2 - tw / 2), by, this.promptText, { width: tw, color: 0xffffff, center: true });\n    }\n    // tool wheel\n    this.drawWheel(sim, seat, W, H, wheelSize);\n    // dose count\n    if (sim.tools.includes('syringe')) {\n      hud.text(W - wheelSize - 42, H - 11, `DOSE ${sim.doses}`, { color: sim.doses ? 0xff9ab0 : 0x5a6172 });\n    }\n    // hint arrow text\n    if (sim.hint && seat.tool !== sim.hint.tool && sim.hint.tool && !sim.noHint) {\n      const n = TOOLS.indexOf(sim.hint.tool) + 1;\n      const label = `${sim.hint.tool.toUpperCase()}: {tool:${n}}`;\n      const w = P.items(label, hud, 0).reduce((q, i) => q + i.w, 0);\n      P.draw(hud, W - w - 6, H - wheelSize - 14, label, { width: w + 6, color: 0xffd24d });\n    }\n    // pop-ups\n    for (let i = this.popups.length - 1; i >= 0; i--) {\n      const p = this.popups[i];\n      p.t -= dt * 0.9;\n      if (p.t <= 0) { this.popups.splice(i, 1); continue; }\n      const y = p.y - (1 - p.t) * 14, label = p.r;\n      const w = hud.measure(label, 2).width;\n      hud.text(Math.round(Math.max(2, Math.min(W - w - 2, p.x - w / 2))), Math.round(Math.max(24, y)), label, { color: RCOL[p.r], scale: 2 });\n      if (p.streak > 1 && p.r === 'CLEAN') hud.text(Math.round(p.x + w / 2 + 3), Math.round(y + 4), `+${p.streak}`, { color: 0xffffff });\n    }\n    // red pulse at low vitals\n    if (crit && sim.phase === 'play') { const a = Math.floor(this.ctx.time * 4) % 2; if (a) { hud.rect(0, 22, W, 1, 0xff3a3a); hud.rect(0, sy - 1, W, 1, 0xff3a3a); } }\n    // Code Blue overlay\n    if (sim.codeBlue) this.drawCodeBlue(sim, W, H);\n    if (sim.massage) this.drawMassage(sim, W, H);\n    // ghost hint\n    if (sim.ghost) hud.text(Math.round(W / 2 - 60), 42, 'THE SECOND LOOK', { color: 0xc08bff });\n    void input;\n  }\n\n  drawWheel(sim, seat, W, H, size) {\n    const { hud } = this.ctx, cx = W - size / 2 - 2, cy = H - size / 2 - 2;\n    const R = 20;\n    hud.rect(W - size - 4, H - size - 4, size + 4, size + 4, 0x0d0b14);\n    this.wheelHit = [];\n    TOOLS.forEach((id, i) => {\n      const a = -Math.PI / 2 + (i / 8) * Math.PI * 2, x = Math.round(cx + Math.cos(a) * R), y = Math.round(cy + Math.sin(a) * R);\n      const on = id === seat.tool, avail = sim.tools.includes(id);\n      if (on) hud.rect(x - 4, y - 4, 9, 9, 0xffd24d);\n      else hud.rect(x - 3, y - 3, 7, 7, avail ? (this.wheelSlot === i ? 0xffffff : 0x57606f) : 0x1a1f2b);\n      this.wheelHit.push({ i, x: x - 5, y: y - 5, w: 11, h: 11 });\n    });\n    const ic = TOOL_ICONS[seat.tool];\n    if (ic) hud.sprite(Math.round(cx - 6), Math.round(cy - 5), ic.rows, ic.colors);\n    if (this.wheelT > 0) {\n      const mid = hud.measure(seat.tool.toUpperCase()).width;\n      hud.text(Math.round(W - size - mid - 8), H - size - 4, seat.tool.toUpperCase(), { color: 0xffd24d });\n    }\n  }\n\n  drawCodeBlue(sim, W, H) {\n    const { hud } = this.ctx, cb = sim.codeBlue, P = this.app.prompts;\n    const flicker = Math.floor(this.ctx.time * 4) % 2 ? 0xff3a3a : 0xffffff;\n    const panelW = 240, x = Math.round(W / 2 - panelW / 2), y = Math.round(H / 2 - 54);\n    hud.rect(x - 2, y - 2, panelW + 4, 98, 0x3a0a14);\n    hud.rect(x, y, panelW, 94, 0x0d0b14);\n    hud.text(x + 6, y + 5, 'CODE BLUE', { color: flicker, scale: 2 });\n    hud.text(x + panelW - 58, y + 9, `${Math.ceil(cb.t)}S`, { color: 0xffffff, scale: 1 });\n    hud.text(x + panelW - 30, y + 9, `${cb.shocks}/${cb.need}`, { color: 0x7fffa0 });\n    const bw = panelW - 24, bx = x + 12, by = y + 32;\n    hud.rect(bx, by, bw, 14, 0x2a3142);\n    const zx = bx + Math.round(bw * (cb.centre - cb.zone / 2)), zw = Math.round(bw * cb.zone);\n    hud.rect(zx, by, zw, 14, 0x2bb673);\n    const nx = bx + Math.round(bw * cb.needle);\n    hud.rect(nx - 1, by - 3, 3, 20, cb.charging ? 0xffffff : 0x8a93a6);\n    P.draw(hud, x + 12, y + 56, cb.charging ? 'RELEASE IN THE GREEN!' : 'HOLD {paddles} TO CHARGE', { width: bw, color: 0xffffff, center: true });\n    hud.text(x + 12, y + 74, 'TWO GOOD SHOCKS. CLEAR!', { color: 0x8a93a6 });\n  }\n\n  drawMassage(sim, W, H) {\n    const { hud } = this.ctx, m = sim.massage, P = this.app.prompts;\n    const panelW = 220, x = Math.round(W / 2 - panelW / 2), y = Math.round(H / 2 - 44);\n    hud.rect(x, y, panelW, 76, 0x0d0b14);\n    hud.text(x + 6, y + 5, 'MASSAGE', { color: 0xff6b6b, scale: 2 });\n    hud.text(x + panelW - 34, y + 9, `${m.count}/${m.need}`, { color: 0x7fffa0 });\n    const ph = (m.t % m.period) / m.period, near = Math.min(ph, 1 - ph) * m.period <= m.window;\n    const size = near ? 22 : 12, cx = x + panelW / 2;\n    hud.rect(Math.round(cx - size / 2), y + 28 + (22 - size) / 2 | 0, size, size, near ? 0xff5a5a : 0x5a1f28);\n    const nextL = m.last !== 1;\n    hud.text(x + 22, y + 34, nextL ? '>LEFT<' : 'LEFT', { color: nextL ? 0xffd24d : 0x5a6172 });\n    hud.text(x + panelW - 60, y + 34, !nextL ? '>RIGHT<' : 'RIGHT', { color: !nextL ? 0xffd24d : 0x5a6172 });\n    P.draw(hud, x + 8, y + 58, 'ALTERNATE {squeeze} ON THE BEAT', { width: panelW - 16, color: 0xffffff, center: true });\n  }\n}\nEOF\necho ok","description":"Write save, prompts, icons, menu, app, op HUD"}}}
