{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgki3Q1CTGB3ZjqvMUJAf","type":"message","role":"assistant","content":[{"type":"text","text":"I've finished the play loop and menus. Next is the title and hero-select shell, attract mode and the game entry point, and then the first real boot in a browser."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12327,"cache_read_input_tokens":555773,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12327},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"69254de6-4061-470e-8e76-10f1ee96c6e5","uuid":"b80d2feb-a5d4-43e9-bb26-7c661573cdc4","timestamp":"2026-11-06T00:13:39.808Z","request_id":"req_011Cgki3PhakkpHuMJQhySJg"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgki3Q1CTGB3ZjqvMUJAf","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017W3sqsLm2Z7wsumDcERXmT","name":"Bash","input":{"command":"cat > src/modes/shell.js <<'EOF'\n// Title, main menu, hero select, new hero, attract, touch-only. A state machine over the Play world.\nimport { buildModel, Rng, THREE } from '../../pixel-engine.js';\nimport { CLASSES, CLASS_IDS, SKILLS } from '../data/classes.js';\nimport { HERO_NAMES } from '../data/dialog.js';\nimport { LEGENDARIES, SET_FOR_CLASS, SETS } from '../data/items.js';\nimport { TAGLINE, TITLE } from '../data/meta.js';\nimport { DIFFICULTIES } from '../data/tuning.js';\nimport { addHero, newWorld } from '../sim/step.js';\nimport { enterZone, setDifficulty } from '../sim/world.js';\nimport { loadCampaign, loadHeroInto, saveCampaign, saveHero } from '../sim/serialize.js';\nimport { levelUp, refresh } from '../sim/hero.js';\nimport { makeItem } from '../sim/loot.js';\nimport { QUESTS } from '../sim/quests.js';\nimport { Actor } from '../view/actors.js';\nimport { MODELS } from '../view/models/props.js';\nimport { footer, prompt } from '../ui/glyphs.js';\nimport { drawIcon } from '../ui/hud.js';\nimport { Attract } from './attract.js';\nimport { blankSave, writeSave } from '../save/save.js';\n\nconst IDLE_ATTRACT = 600; // 10 s of frames.\nexport class Shell {\n  constructor(ctx, game) { this.ctx = ctx; this.game = game; this.state = 'boot'; this.idle = 0; this.t = 0; this.frameN = 0; this.titleWorld = null; this.titleActors = []; this.sel = 0; this.heroSlot = 0; this.nameI = 0; this.diffI = 0; this.startI = 0; this.heroSel = 0; this.confirmDel = 0; this.rng = new Rng('shell'); this.attract = null; this.returnTo = 'title'; this.touchOnly = game.touchOnly; this.hub = false; this.creating = null; }\n  get play() { return this.game.play; }\n  get ui() { return this.game.ui; }\n  boot(save) { this.game.save = save; this.game.settings.load(save.settings); this.toTitle(); }\n  makeTitleWorld() {\n    if (this.titleWorld) return;\n    const w = newWorld({ seed: 7 }); enterZone(w, 'titlescene'); w.events.length = 0; w.mode = 'title'; this.titleWorld = w;\n    this.play.begin(w, { local: [] }); this.play.view.update(w, 0.016, 1, {});\n    const z = w.zone; const v = this.play.view; const add = (id, x, zz, s = 1, y = 0) => { const b = buildModel(id, { catalog: MODELS }); b.object.position.set(x, y, zz); b.object.scale.setScalar(s); b.object.traverse((m) => { if (m.isMesh) { m.castShadow = true; m.receiveShadow = true; } }); v.zone.root.add(b.object); return b.object; };\n    this.belfry = add('belfry_scene', z.w / 2 - 8, z.h / 2 - 8, 1.4);\n    add('dead-tree', z.w / 2 + 4, z.h / 2 - 4); add('tombstone', z.w / 2 + 2, z.h / 2 + 3); add('tombstone', z.w / 2 + 5, z.h / 2 + 1); add('tombstone', z.w / 2 - 2, z.h / 2 + 4); add('tombstone', z.w / 2 - 5, z.h / 2 + 2);\n    // Three heroes on plinths, for hero select.\n    this.plinths = [];\n    CLASS_IDS.forEach((c, i) => { const x = z.w / 2 + (i - 1) * 3.2 * 0.71; const zz = z.h / 2 + 7 - (i - 1) * 3.2 * 0.71; add('plinth', x, zz); const a = new Actor(this.ctx, `hero_${c}`, { x, z: zz }); a.root.position.y = 0.5; this.titleActors.push({ a, x, z: zz, c, y: 0.5 }); this.plinths.push({ x, z: zz }); this.ctx.lights.request({ position: [x, 3, zz + 1], color: 0xffc080, intensity: 8, radius: 7, flicker: 'torch', priority: 2 }); });\n    v.ambient(w);\n  }\n  dropTitle() { for (const t of this.titleActors) t.a.dispose(); this.titleActors = []; this.titleWorld = null; this.belfry = null; }\n  toTitle() { this.state = this.touchOnly ? 'touch' : 'title'; this.idle = 0; this.t = 0; this.makeTitleWorld(); this.game.music.play('vespers'); this.ui.focus = null; }\n  toMenu() { if (!this.titleWorld) { this.play.stop(); this.makeTitleWorld(); } this.state = 'menu'; this.idle = 0; this.ui.focus = null; this.game.music.play('vespers'); }\n  fixed(dt) { if (this.state === 'play') this.play.fixed(dt); else if (this.state === 'attract') this.play.fixed(dt); else if (this.titleWorld) this.titleWorld.time += dt; }\n  update(dt) {\n    this.frameN++; this.t += 1 / 60;\n    const r = this.game.router;\n    const stateIn = this.state;\n    if (stateIn === 'play') { this.play.update(dt); return; }\n    if (stateIn === 'attract') { this.updateAttract(dt); return; }\n    if (stateIn === 'boot') return;\n    // Title world idles behind every shell screen.\n    if (this.titleWorld && this.play.world === this.titleWorld) this.updateTitleWorld(dt);\n    if (r.anyInput) this.idle = 0; else this.idle++;\n    if ((stateIn === 'title' || stateIn === 'menu' || stateIn === 'touch') && this.idle >= IDLE_ATTRACT) { this.startAttract(stateIn); return; }\n    const fn = this[`draw_${stateIn}`]; if (fn) fn.call(this, this.ui, this.ui.m);\n  }\n  updateTitleWorld(dt) {\n    const w = this.titleWorld; const v = this.play.view; const z = w.zone;\n    const hs = this.state === 'heroselect' || this.state === 'newhero' || this.state === 'heroes';\n    const cx = hs ? z.w / 2 : z.w / 2 + Math.sin(this.t * 0.1) * 2 - 3; const cz = hs ? z.h / 2 + 7 : z.h / 2 + Math.cos(this.t * 0.1) * 2 - 3;\n    this.play.target.set(cx, 0.9, cz); v.focus.set(cx, 0, cz); this.ctx.camera.setZoom(hs ? 1.3 : 0.72);\n    for (const t of this.titleActors) { t.a.update(dt, t.x, t.z, 0.8, false, { y: t.y }); if (t.a.root.position.y !== t.y) t.a.root.position.y = t.y; }\n    v.fx.update(dt); v.zone.update(dt, v.focus, this.ctx.time);\n    if (v.rng.chance(0.4)) this.ctx.particles.burst('emberfall', [cx + v.rng.range(-14, 14), 0.1, cz + v.rng.range(-10, 10)], { count: 1 });\n    if (this.frameN % 400 === 1) this.ctx.audio.play('bell_small', { volume: 0.3, pitch: -12 });\n  }\n  draw_title(ui, m) {\n    const big = ui.measure(TITLE, 4) < ui.W - 24 ? 4 : ui.measure(TITLE, 3) < ui.W - 24 ? 3 : 2;\n    ui.textC(ui.W / 2, ui.H * 0.2, TITLE, { color: 'sand', scale: big });\n    ui.textC(ui.W / 2, ui.H * 0.2 + 7 * big + 8, TAGLINE, { color: 'mist' });\n    if (this.frameN % 80 < 56) ui.textC(ui.W / 2, ui.H * 0.72, 'PRESS ANY BUTTON', { color: 'white', scale: 1 });\n    if (!this.ctx.audio.unlocked && this.game.router.lastDevice === 'pad') ui.textC(ui.W / 2, ui.H * 0.72 + 12, 'PRESS A KEY OR CLICK FOR SOUND', { color: 'mist' });\n    if (this.game.router.anyInput && !this.game.router.pointerMoved && this.t > 0.3) { this.state = 'menu'; this.idle = 0; ui.focus = null; this.ctx.audio.play('bell_small'); this.ctx.input.clearQueued(); }\n  }\n  hasSave() { return this.game.save.heroes.some(Boolean); }\n  draw_menu(ui, m) {\n    const big = ui.measure(TITLE, 3) < ui.W - 24 ? 3 : 2; ui.textC(ui.W / 2, 22, TITLE, { color: 'sand', scale: big });\n    const s = this.game.save; const knellOpen = s.unlocks.knell;\n    const items = [];\n    if (this.hasSave()) items.push(['CONTINUE', () => { this.state = 'heroes'; ui.focus = null; }]);\n    items.push(['NEW HERO', () => { this.beginNew(); }]);\n    items.push([knellOpen ? 'KNELL RUNS' : 'KNELL RUNS (LOCKED)', () => { if (knellOpen && this.hasSave()) { this.afterLoad = 'knell'; this.state = 'heroes'; ui.focus = null; } else { this.ctx.audio.play('ui_error'); } }, !knellOpen]);\n    items.push(['SETTINGS', () => { this.state = 'settings'; ui.focus = null; }]);\n    items.push(['ABOUT', () => { this.state = 'about'; ui.focus = null; this.aboutS = { tab: 0 }; }]);\n    const y0 = Math.max(60, ui.H * 0.34); const rowH = 22;\n    items.forEach(([label, fn, dis], i) => { if (ui.button(`m:${label}`, ui.W / 2 - 80, y0 + i * rowH, 160, rowH - 3, label, { disabled: dis })) fn(); });\n    footer(ui, [['confirm', 'CHOOSE']]);\n    if (m.back) { this.state = 'title'; this.t = 0; ui.focus = null; }\n  }\n  draw_settings(ui, m) { this.game.settings.draw(ui, this.setS ??= {}, m); this.game.persist?.(true); if (m.back) { this.state = this.settingsBack ?? 'menu'; ui.focus = null; } }\n  draw_about(ui, m) { const s = this.aboutS; this.play.menus.screen_about(ui, s, this.titleWorld, null, m); if (m.back) { this.state = 'menu'; ui.focus = null; } }\n  draw_touch(ui, m) {\n    ui.rect(0, ui.H * 0.3, ui.W, 40, 'ink');\n    const lines = ui.wrap('CONTROLLER OR KEYBOARD REQUIRED', Math.min(ui.W - 16, 300), 1);\n    lines.forEach((l, i) => ui.textC(ui.W / 2, ui.H * 0.3 + 8 + i * 10, l, { color: 'sand' }));\n    const big = ui.measure(TITLE, 3) < ui.W - 24 ? 3 : ui.measure(TITLE, 2) < ui.W - 24 ? 2 : 1; ui.textC(ui.W / 2, 14, TITLE, { color: 'sand', scale: big });\n    const r = this.game.router; if (r.lastDevice === 'pad' && r.anyInput || this.ctx.input.queuedPresses.some((k) => k.startsWith('Key') || k === 'Enter')) { this.touchOnly = false; this.state = 'menu'; this.idle = 0; ui.focus = null; }\n  }\n  // Heroes: up to three slots; deletion with a hold to confirm.\n  draw_heroes(ui, m) {\n    ui.rect(0, 0, ui.W, 26, 'ink'); ui.textC(ui.W / 2, 8, 'YOUR HEROES', { color: 'sand' });\n    const s = this.game.save; const y0 = ui.H - 96;\n    s.heroes.forEach((h, i) => {\n      const x = 12 + i * ((ui.W - 24) / 3); const w = (ui.W - 24) / 3 - 4; const id = `hs:${i}`; const st = ui.widget(id, x, y0, w, 62, {});\n      ui.frame(x, y0, w, 62, st.focused ? 'sand' : 'slate', st.focused ? 'plum' : 'ink');\n      if (h) {\n        ui.text(x + 5, y0 + 5, h.name.slice(0, Math.floor((w - 10) / 6)), { color: 'white' }); ui.text(x + 5, y0 + 15, `LV ${h.level} ${CLASSES[h.cls].name}`, { color: CLASSES[h.cls].color });\n        const qname = QUESTS[h.campaign?.story?.q ?? 0]?.name ?? 'THE BELL RINGS TRUE'; ui.text(x + 5, y0 + 25, qname.slice(0, Math.floor((w - 10) / 6)), { color: 'mist' }); ui.text(x + 5, y0 + 35, DIFFICULTIES[h.campaign?.difficulty ?? 0].name, { color: 'mist' });\n        if (st.focused) this.heroSel = i;\n      } else ui.textC(x + w / 2, y0 + 26, 'EMPTY', { color: 'mist' });\n      if (st.act) { if (h) this.loadHero(i); else this.beginNew(i); }\n    });\n    // Show the hovered hero's class on the plinth by turning them to camera.\n    const held = m.x === false && (this.ctx.input.isDown('KeyX') || this.game.router.pads.some((p) => (p.b & 4) !== 0));\n    const fh = s.heroes[this.heroSel];\n    if (fh && held && this.ui.focus?.startsWith('hs:')) { this.confirmDel += 1 / 60; ui.bar(ui.W / 2 - 60, ui.H - 30, 120, 6, this.confirmDel / 1.5, 'red'); if (this.confirmDel >= 1.5) { s.heroes[this.heroSel] = null; this.confirmDel = 0; this.game.persist?.(true); this.ctx.audio.play('ui_salvage'); } } else this.confirmDel = 0;\n    footer(ui, [['confirm', 'PLAY'], ['x', 'HOLD TO DELETE'], ['back', 'BACK']]);\n    if (m.back) { this.afterLoad = null; this.state = 'menu'; ui.focus = null; }\n  }\n  beginNew(slot = null) {\n    const s = this.game.save; const free = slot ?? s.heroes.findIndex((h) => !h);\n    if (free < 0) { this.state = 'heroes'; this.ctx.audio.play('ui_error'); return; }\n    this.creating = { slot: free, cls: 0, name: this.rngName(), diff: 0, step: 0 }; this.state = 'newhero'; this.ui.focus = null;\n  }\n  rngName() { return HERO_NAMES[Math.floor(this.rng.next() * HERO_NAMES.length)]; }\n  draw_newhero(ui, m) {\n    const c = this.creating;\n    const col = (ui.W - 24) / 3;\n    if (c.step === 0) {\n      ui.rect(0, 0, ui.W, 26, 'ink'); ui.textC(ui.W / 2, 8, 'PICK A TRADE', { color: 'sand' });\n      CLASS_IDS.forEach((id, i) => {\n        const x = 12 + i * col; const w = col - 4; const y = ui.H - 112; const st = ui.widget(`cl:${id}`, x, y, w, 82, {}); const k = CLASSES[id];\n        ui.frame(x, y, w, 82, st.focused ? 'sand' : 'slate', st.focused ? 'plum' : 'ink'); ui.text(x + 5, y + 4, k.name, { color: k.color }); ui.para(x + 5, y + 14, k.fantasy, w - 10, { color: 'mist', lh: 8 });\n        ui.text(x + 5, y + 44, k.resource.toUpperCase(), { color: 'sand' }); k.signature.forEach((sid, n) => { const sk = SKILLS[sid]; drawIcon(ui, x + 5 + n * 18, y + 54, sk.icon); });\n        if (st.focused) { if (c.cls !== i) { c.cls = i; this.titleActors[i]?.a.play('Triumph', 1.2); } }\n        if (st.act) { c.cls = i; c.step = 1; ui.focus = null; this.titleActors[i]?.a.play('Triumph', 1.2); }\n      });\n      footer(ui, [['confirm', 'CHOOSE'], ['back', 'BACK']]);\n      if (m.back) { this.state = 'menu'; ui.focus = null; }\n    } else if (c.step === 1) {\n      ui.rect(ui.W / 2 - 130, 30, 260, ui.H - 60, 'ink');\n      ui.textC(ui.W / 2, 38, `A ${CLASSES[CLASS_IDS[c.cls]].name}`, { color: CLASSES[CLASS_IDS[c.cls]].color, scale: 2 });\n      ui.textC(ui.W / 2, 62, c.name, { color: 'white' });\n      if (ui.button('n:shuffle', ui.W / 2 - 110, 74, 220, 16, 'SHUFFLE THE NAME')) c.name = this.rngName();\n      ui.text(ui.W / 2 - 110, 96, 'DIFFICULTY', { color: 'mist' });\n      const ds = DIFFICULTIES.filter((d) => !d.locked);\n      ds.forEach((d, i) => { if (ui.button(`n:d${i}`, ui.W / 2 - 110 + i * 74, 106, 72, 16, d.name, { border: c.diff === i ? 'sand' : 'slate' })) c.diff = i; });\n      ui.text(ui.W / 2 - 110, 128, 'WHERE TO BEGIN', { color: 'mist' });\n      if (ui.button('n:begin', ui.W / 2 - 110, 138, 220, 18, 'THE BEGINNING')) this.startNew(false);\n      if (ui.button('n:last', ui.W / 2 - 110, 158, 220, 18, 'THE LAST BELL (LEVEL 30)')) this.startNew(true);\n      const f = ui.focus === 'n:last'; const hint = f ? 'ALL SKILLS, LEGENDARIES, A SET, GEMS, DEVOTION, A GRAND KEY.' : ui.focus === 'n:begin' ? 'FROM THE GROUND UP. ABOUT AN HOUR TO THE CREDITS.' : ''; if (hint) { const lines = ui.wrap(hint, 240); lines.forEach((l, i) => ui.textC(ui.W / 2, 180 + i * 9, l, { color: 'sand' })); }\n      footer(ui, [['confirm', 'CHOOSE'], ['back', 'BACK']]);\n      if (m.back) { c.step = 0; ui.focus = null; m.back = false; }\n    }\n  }\n  // New game seeds are chosen here and passed through ctx.input.send, so they replay.\n  startNew(lastBell) {\n    const c = this.creating; const cls = CLASS_IDS[c.cls]; const seed = (this.rng.next() * 1e9) | 0;\n    const w = newWorld({ seed, difficulty: c.diff }); this.leaveTitle();\n    const h = addHero(w, { seat: 0, cls, name: c.name });\n    this.heroSlot = c.slot; this.game.world = w;\n    this.applyShared(w);\n    if (lastBell) {\n      this.setupLastBell(w, h);\n      enterZone(w, 'town');\n      this.enterPlay(w);\n      this.game.persist?.(true);\n    } else {\n      enterZone(w, 'yard');\n      const p = w.props; void p;\n      this.enterPlay(w);\n      this.play.playScene({ black: true, lines: [[0.6, 6.4, 'narrator', 'For a thousand years Old Clemency tolled at dusk, and the dead of Vespermoor stayed down.'], [6.8, 12.4, 'narrator', 'Forty days ago the Great Bell cracked. It still tolls. It now says something else.'], [12.8, 18, 'narrator', 'You were buried on the thirty-ninth day. It did not take.']], cues: [{ at: 0.2, run: () => this.ctx.audio.play('bell_cracked') }, { at: 12.8, run: () => this.ctx.audio.play('bell_cracked', { volume: 0.5 }) }], duration: 18.5, after: () => { this.onRise(w, h); } });\n      this.game.persist?.(true);\n    }\n  }\n  onRise(w, h) { const a = this.play.view.heroes.get(h.id); a?.play('GetUp', 1.2); this.ctx.engine.shake.add(0.4); this.ctx.audio.play('coffin_crash'); this.ctx.particles.burst('bone_chips', [h.x, 0.5, h.z], { count: 26, colors: ['plum', 'mist'] }); }\n  setupLastBell(w, h) {\n    while (h.level < 30) levelUp(w, h);\n    h.xp = 0; const rng = w.rngs.loot; h.gold = 25000;\n    h.mats = { scrap: 120, dust: 60, shards: 30, keys: 1 };\n    const legs = LEGENDARIES.filter((l) => l.cls === h.cls).slice(0, 2).concat(LEGENDARIES.filter((l) => !l.cls).slice(0, 1));\n    for (const l of legs) { const it = makeItem(rng, { legendary: l.id, ilvl: 30, cls: h.cls }); const old = h.gear[it.slot]; h.gear[it.slot] = it; if (old) h.inv.push(old); }\n    const set = SET_FOR_CLASS[h.cls];\n    for (const slot of ['head', 'feet']) h.gear[slot] = makeItem(rng, { slot, set, ilvl: 30, cls: h.cls });\n    for (const slot of ['shoulders', 'legs', 'amulet', 'ring', 'off', 'hands', 'chest']) if (!h.gear[slot]) h.gear[slot] = makeItem(rng, { slot, rarity: 'reliquary', ilvl: 29, cls: h.cls });\n    for (const slot of ['chest', 'hands']) h.inv.push(makeItem(rng, { slot, set, ilvl: 30, cls: h.cls }));\n    if (!h.gear.main) h.gear.main = makeItem(rng, { slot: 'main', rarity: 'reliquary', ilvl: 29, cls: h.cls });\n    h.gems = { 'ember:1': 3, 'salt:1': 3, 'amber:1': 3 };\n    const all = CLASSES[h.cls].skills;\n    h.slots = [all[0], all[3], all[4], all[5], all[6], all[7]].map((s, i) => ({ skill: s.id, tone: Object.keys(s.tones)[i % 3] }));\n    h.vows = [CLASSES[h.cls].vows[0].id, CLASSES[h.cls].vows[1].id];\n    w.devotion.bonus = 5; w.unlocks.knell = true; w.unlocks.penance = true;\n    w.story.q = QUESTS.length; w.story.step = 0; w.story.flags = { ...w.story.flags, brasseOpen: true, writsOpen: true, talk_ogive2: true, lastBell: true, pyx: false };\n    w.story.lychgates = ['town', 'causeway', 'ossuary1', 'ossuary2', 'ossuary3', 'cloister', 'belfry1', 'belfry2', 'belfry3'];\n    refresh(w, h); h.hp = h.stats.maxHp; h.res = h.stats.maxResource;\n  }\n  applyShared(w) { const s = this.game.save; w.stash = s.stash; w.devotion = s.devotion; w.unlocks = s.unlocks; w.bests = s.bests; }\n  loadHero(i) {\n    const s = this.game.save; const data = s.heroes[i]; if (!data) return;\n    const c = data.campaign ?? {};\n    const w = newWorld({ seed: c.seed ?? 11, difficulty: c.difficulty ?? 0 }); this.leaveTitle();\n    const h = addHero(w, { seat: 0, cls: data.cls, name: data.name });\n    this.applyShared(w);\n    loadCampaign(w, c); w.bossKills = c.bossKills ?? w.bossKills;\n    loadHeroInto(w, h, data);\n    setDifficulty(w, c.difficulty ?? 0);\n    this.heroSlot = i; this.game.world = w;\n    enterZone(w, w.story.q >= 1 || w.story.flags?.lastBell ? 'town' : 'yard');\n    this.enterPlay(w);\n    if (this.afterLoad === 'knell') { this.afterLoad = null; this.play.menus.push('knell'); }\n  }\n  leaveTitle() { this.dropTitle(); this.play.stop(); }\n  enterPlay(w) { this.state = 'play'; const bots = this.game.testBot ? { 0: true } : {}; this.play.begin(w, { local: [0], bots }); this.ctx.input.clearQueued(); }\n  onEnding() {\n    const w = this.play.world;\n    this.game.persist?.(true);\n    this.play.music.play('clemency');\n    this.play.playScene({ black: (t) => t > 9, lines: [[1, 6, 'narrator', 'And the hand of the Late closed upon the rope, and Old Clemency spoke, and the word it spoke was true.'], [6.4, 11, 'malison', 'EVERY VERSE. I KNOW EVERY VERSE. I ONLY WANTED SOMEONE TO HEAR THE LAST ONE.'], [11.4, 17, 'narrator', 'The Unrung Saint came apart like old mortar. The dead of Vespermoor lay down, grumbling, and dawn came up over the moor.'], [17.4, 20.5, 'crier', 'Hear ye, hear ye! The fish is still off.'], [36, 41.5, 'narrator', 'And far below, under the foundation, under the peat, a much deeper bell answered.']],\n      cues: [{ at: 0.3, run: () => { this.ctx.audio.play('bell_true'); this.ctx.engine.screen.flash('sand', { duration: 1 }); } }, { at: 36, run: () => this.ctx.audio.play('bell_big', { pitch: -12 }) }], duration: 43,\n      credits: (ui, t) => { if (t < 21 || t > 35.5) return; const lines = [TITLE, ' ', 'A GAME OF THE BELL, THE PEAT AND THE LATE', ' ', 'WRITTEN, DRAWN AND RUNG', 'BY CLAUDE OPUS 5.5', ' ', 'ON THE PIXEL ENGINE', ' ', 'PENANCE IS UNLOCKED', 'THE KNELL FONT ANSWERS NOW', ' ', 'THANK YOU FOR PLAYING']; const y0 = ui.H - (t - 21) * 18; lines.forEach((l, i) => { const y = y0 + i * 14; if (y > 10 && y < ui.H - 10) ui.textC(ui.W / 2, y, l, { color: i === 0 ? 'sand' : 'white' }); }); },\n      after: () => { this.game.endingSeen = true; if (w.zone.id !== 'town') enterZone(w, 'town'); this.play.music.play('lamps'); this.game.persist?.(true); this.play.hud.toast('THE KNELL FONT ANSWERS NOW. PENANCE IS UNLOCKED.', 'sand', { big: true }); } });\n  }\n  // Attract: any input goes straight back to where it was.\n  startAttract(from) {\n    this.returnTo = from; this.leaveTitle(); this.state = 'attract';\n    this.attract = new Attract(this.ctx, this.game, this.play); this.attract.start();\n    this.attractLoops = 0;\n  }\n  startAttractFromDev() { this.play.menus.closeAll(); this.game.persist?.(true); this.startAttract('menu'); }\n  updateAttract(dt) {\n    const r = this.game.router;\n    this.attract.update(dt);\n    this.play.update(dt);\n    this.attract.draw(this.ui, this.touchOnly);\n    if (r.anyInput && this.frameN > 2 && this.attract.age > 0.3) {\n      if (this.touchOnly && r.lastDevice !== 'pad') { if (this.ctx.input.queuedPresses.some((k) => k.startsWith('Key') || k === 'Enter')) this.touchOnly = false; else { /* A tap only returns to the message. */ this.exitAttract(); return; } }\n      this.exitAttract();\n    } else if (r.touched && this.touchOnly) this.exitAttract();\n  }\n  exitAttract() { this.attract.stop(); this.attract = null; this.play.stop(); this.ctx.engine.screen.clear(); this.makeTitleWorld(); this.state = this.touchOnly ? 'touch' : this.returnTo; this.idle = 0; this.t = 0; this.game.music.play('vespers'); this.ui.focus = null; this.ctx.input.clearQueued(); }\n}\nexport { saveCampaign, saveHero, blankSave, writeSave, prompt, SETS };\nEOF\ncat > src/modes/attract.js <<'EOF'\n// The attract tour: real worlds, real bots, cheating freely. It never touches saves.\nimport { CLASS_IDS, CLASSES } from '../data/classes.js';\nimport { TITLE } from '../data/meta.js';\nimport { addHero, newWorld } from '../sim/step.js';\nimport { enterZone, findOpenNear } from '../sim/world.js';\nimport { levelUp, refresh } from '../sim/hero.js';\nimport { makeItem } from '../sim/loot.js';\nimport { dropItem } from '../sim/rules.js';\nimport { spawnElitePack, spawnMonster, killMonster } from '../sim/monsters.js';\nimport { startKnell } from '../sim/knell.js';\nimport { LEGENDARIES } from '../data/items.js';\nimport { makeTuning } from '../data/tuning.js';\n\nexport const STOPS = ['town', 'causeway', 'ossuary', 'bursar', 'cloister', 'knell', 'malison2', 'malison3'];\nconst STOP_T = { town: 16, causeway: 16, ossuary: 16, bursar: 14, cloister: 16, knell: 16, malison2: 16, malison3: 14 };\nexport class Attract {\n  constructor(ctx, game, play) { this.ctx = ctx; this.game = game; this.play = play; this.i = -1; this.t = 0; this.age = 0; this.visited = {}; this.loops = 0; this.phase = 'run'; this.showHud = true; this.zoom = 1; this.pan = 0; }\n  start() { this.next(); }\n  stop() { this.ctx.engine.screen.clear(); this.play.attract = null; this.play.voice.stop(); }\n  makeHeroes(w, list) {\n    list.forEach((cls, seat) => {\n      const h = addHero(w, { seat, cls, name: CLASSES[cls].name, isBot: true });\n      while (h.level < 25) levelUp(w, h);\n      h.attractGod = true; const legs = LEGENDARIES.filter((l) => l.cls === cls);\n      for (const l of legs.slice(0, 2)) { const it = makeItem(w.rngs.loot, { legendary: l.id, ilvl: 25, cls }); h.gear[it.slot] = it; }\n      for (const slot of ['head', 'shoulders', 'chest', 'feet']) if (!h.gear[slot]) h.gear[slot] = makeItem(w.rngs.loot, { slot, rarity: 'reliquary', ilvl: 25, cls });\n      if (!h.gear.main) h.gear.main = makeItem(w.rngs.loot, { slot: 'main', rarity: 'legendary', ilvl: 25, cls, legendary: legs[0].id });\n      const sk = CLASSES[cls].skills; h.slots = [sk[0], sk[1], sk[2], sk[3], sk[4], sk[6]].map((s, i) => ({ skill: s.id, tone: Object.keys(s.tones)[i % 3] }));\n      refresh(w, h); h.hp = h.stats.maxHp; h.res = h.stats.maxResource;\n    });\n  }\n  world(classes) {\n    const tuning = makeTuning(); tuning.monsterHp = 0.35;\n    const w = newWorld({ seed: 77 + this.i * 13 + this.loops * 101, tuning }); w.mode = 'attract'; w.cheats.infRes = true; w.cheats.noCd = false; w.tuning.cooldown = 0.25; w.story.flags.writsOpen = true; w.story.flags.brasseOpen = true; w.story.q = 2; this.makeHeroes(w, classes); w.unlocks.knell = true;\n    return w;\n  }\n  setup(stop) {\n    this.visited[stop] = (this.visited[stop] ?? 0) + 1; let w; const bots = {};\n    this.camera = null; this.zoom = 1; this.showHud = true;\n    switch (stop) {\n      case 'town': { w = this.world(['lamplighter']); enterZone(w, 'town'); this.camTour = w.props.filter((p) => p.kind === 'npc'); this.showHud = false; this.camera = (wd) => this.tourCamera(wd); this.zoom = 1.15; this.lines = [['crier', 'Hear ye, hear ye! The dead are up, the roads are closed, and the fish is off.'], ['pennywhistle', 'Everything is half price, dear friend. The other half is your soul.'], ['ogive', 'Bring me the holy bones, child. I will know them by the taste.']]; break; }\n      case 'causeway': { w = this.world(['bellwarden']); enterZone(w, 'causeway'); w.story.flags.firstPlate = true; w.story.flags.firstChampion = true; const h = w.heroes[0]; const r = w.zone.roomRects[2]; const p = findOpenNear(w, r.x + r.w / 2, r.y + r.h / 2); h.x = p.x; h.z = p.z; for (let i = 0; i < 26; i++) { const q = findOpenNear(w, p.x + w.rngs.ai.range(-7, 7), p.z + w.rngs.ai.range(-5, 5)); spawnMonster(w, i % 7 === 0 ? 'bloat_deacon' : i % 3 ? 'peatwalker' : 'gibbet_drop', q.x, q.z, { dormant: false, aggro: true }); } this.legT = 6; break; }\n      case 'ossuary': { w = this.world(['sexton']); enterZone(w, 'ossuary2'); const h = w.heroes[0]; const r = w.zone.roomRects[1]; const p = findOpenNear(w, r.x + r.w / 2, r.y + r.h / 2); h.x = p.x; h.z = p.z; spawnElitePack(w, p.x + 4, p.z, 'rare', null, ['rattlebones', 'pallid_bearer'], { dormant: false, aggro: true }); for (let i = 0; i < 16; i++) { const q = findOpenNear(w, p.x + w.rngs.ai.range(-6, 6), p.z + w.rngs.ai.range(-5, 5)); spawnMonster(w, 'rattlebones', q.x, q.z, { dormant: false, aggro: true }); } break; }\n      case 'bursar': { w = this.world(['sexton']); enterZone(w, 'countinghouse'); break; }\n      case 'cloister': { w = this.world(['lamplighter']); enterZone(w, 'cloister'); const h = w.heroes[0]; const r = w.zone.roomRects[3]; const p = findOpenNear(w, r.x + r.w / 2, r.y + r.h / 2); h.x = p.x; h.z = p.z; for (let i = 0; i < 26; i++) { const q = findOpenNear(w, p.x + w.rngs.ai.range(-8, 8), p.z + w.rngs.ai.range(-5, 5)); spawnMonster(w, i % 3 ? 'cinderling' : i % 2 ? 'penitent' : 'tithe_collector', q.x, q.z, { dormant: false, aggro: true }); } h.slots = [CLASSES.lamplighter.skills[0], CLASSES.lamplighter.skills[6], CLASSES.lamplighter.skills[7], CLASSES.lamplighter.skills[2], CLASSES.lamplighter.skills[3], CLASSES.lamplighter.skills[1]].map((s) => ({ skill: s.id, tone: null })); break; }\n      case 'knell': { w = this.world(CLASS_IDS.slice()); enterZone(w, 'town'); startKnell(w); w.knell.total = 70; break; }\n      case 'malison2': case 'malison3': { w = this.world(['bellwarden', 'sexton']); w.story.q = 4; w.story.step = 3; enterZone(w, 'belfry_top'); const m = w.boss?.m; if (m) { m.intro = 0; m.hp = stop === 'malison2' ? m.maxHp * 0.59 : m.maxHp * 0.24; } break; }\n      default: break;\n    }\n    w.events.length = 0;\n    CLASS_IDS.forEach((c, i) => { if (w.heroes.some((h) => h.seat === i)) bots[i] = true; });\n    this.play.begin(w, { local: w.heroes.map((h) => h.seat), bots, attract: this });\n    this.play.world.mode = stop === 'malison2' || stop === 'malison3' ? 'campaign' : w.mode;\n    this.play.music.play(w.zone.spec.song);\n    this.tourI = 0; this.tourT = 0;\n    this.play.hud.banner = { text: TITLE, t: 2.5, big: true };\n    if (this.lines) { this.play.say(this.lines[0][0], this.lines[0][1]); }\n  }\n  tourCamera(w) {\n    const list = this.camTour; if (!list?.length) return null;\n    this.tourT += 1 / 60; if (this.tourT > 16 / list.length) { this.tourT = 0; this.tourI = (this.tourI + 1) % list.length; if (this.lines?.[this.tourI]) this.play.say(this.lines[this.tourI][0], this.lines[this.tourI][1]); }\n    const p = list[this.tourI]; this.cam = this.cam ?? { x: p.x, z: p.z }; this.cam.x += (p.x - this.cam.x) * 0.015; this.cam.z += (p.z - this.cam.z) * 0.015; return this.cam;\n  }\n  next() {\n    this.i++; if (this.i >= STOPS.length) { this.i = 0; this.loops++; }\n    this.lines = null; this.cam = null;\n    this.setup(STOPS[this.i]);\n    this.t = 0; this.phase = 'run';\n    this.ctx.engine.screen.reveal('iris').catch?.(() => {});\n  }\n  fixed(w) {\n    // A legendary beam on the Causeway, and keep monsters coming so there's always a fight to show.\n    if (this.legT !== undefined && STOPS[this.i] === 'causeway') { this.legT -= 1 / 60; if (this.legT <= 0) { this.legT = undefined; const h = w.heroes[0]; dropItem(w, h.x + 2, h.z + 1, makeItem(w.rngs.loot, { legendary: LEGENDARIES[0].id, ilvl: 25, cls: h.cls }), h.seat); } }\n    if (w.tick % 240 === 0 && STOPS[this.i] !== 'town' && w.active.filter((m) => !m.dead).length < 8 && !w.boss) {\n      const h = w.heroes[0]; const list = w.zone.spec.monsters.length ? w.zone.spec.monsters : ['rattlebones'];\n      for (let i = 0; i < 10; i++) { const p = findOpenNear(w, h.x + w.rngs.ai.range(-7, 7), h.z + w.rngs.ai.range(-6, 6)); spawnMonster(w, w.rngs.ai.pick(list), p.x, p.z, { dormant: false, aggro: true }); }\n    }\n    // Malison's third act: the bots ring the ropes. It may cheat.\n    const stop = STOPS[this.i];\n    if (stop === 'malison3' && w.boss?.m?.bossState?.phase === 2 && w.boss.m.hp > w.boss.m.maxHp * 0.24) w.boss.m.hp = w.boss.m.maxHp * 0.24;\n    if (stop === 'bursar' && w.boss?.m && w.boss.m.hp < w.boss.m.maxHp * 0.4) w.boss.m.hp = w.boss.m.maxHp * 0.8;\n    if (stop === 'malison2' && w.boss?.m && w.boss.m.hp < w.boss.m.maxHp * 0.3) w.boss.m.hp = w.boss.m.maxHp * 0.55;\n    void killMonster;\n  }\n  update(dt) {\n    const real = 1 / 60; this.age += real; this.t += real;\n    if (this.phase === 'run' && this.t > STOP_T[STOPS[this.i]]) { this.phase = 'cover'; this.t = 0; this.ctx.engine.screen.cover('iris').catch?.(() => {}); }\n    if (this.phase === 'cover' && this.t > 0.7) { this.next(); }\n  }\n  draw(ui, touchOnly) {\n    ui.rect(12, 12, ui.measure('DEMO') + 6, 11, 'red'); ui.text(15, 14, 'DEMO', { color: 'white', shadow: false });\n    if (Math.floor(this.age * 1.5) % 2 === 0) ui.textC(ui.W / 2, ui.H - 24, touchOnly ? 'CONTROLLER OR KEYBOARD REQUIRED' : 'PRESS ANY BUTTON', { color: 'sand' });\n  }\n}\nEOF\ncat > game.js <<'EOF'\n// Tolled You So: a gothic co-op action RPG for the TV, on the Pixel Engine. Exports createGame(opts); starts the engine only when a page exists.\n// Pad: left stick moves, Cross/Square/Triangle/Circle/R1/R2 are skills, L2 dodges, L1 drinks. Keyboard: WASD, mouse, 1-4, Space, Q, E, I, K, M, T, F, Esc.\nimport { ENGINE_VERSION, Engine, LOOK_PRESETS, THREE, withUrlOptions } from './pixel-engine.js';\nimport { SKILLS } from './src/data/classes.js';\nimport { TITLE } from './src/data/meta.js';\nimport { Music, setupAudio } from './src/audio/music.js';\nimport { VoicePlayer } from './src/audio/voice.js';\nimport { Router } from './src/input/router.js';\nimport { Play } from './src/modes/play.js';\nimport { Shell } from './src/modes/shell.js';\nimport { blankSave, readSave, storage, writeSave } from './src/save/save.js';\nimport { saveCampaign, saveHero } from './src/sim/serialize.js';\nimport { SettingsScreen } from './src/ui/settings.js';\nimport { UI } from './src/ui/ui.js';\nimport { runHubFlow, runServerCopy } from './src/net/hubflow.js';\n\nexport const isTouchOnly = () => typeof matchMedia !== 'undefined' && typeof navigator !== 'undefined' && !matchMedia('(any-pointer: fine)').matches && navigator.maxTouchPoints > 0;\n\nexport class TolledYouSo {\n  name = TITLE;\n  constructor(opts = {}) { this.opts = opts; this.THREE = THREE; this.SKILLS = SKILLS; this.target = new THREE.Vector3(); this.menuOwner = null; this.touchOnly = !!opts.touchOnly; this.save = blankSave(); this.booted = false; this.testBot = !!opts.testBot; this.autoDismiss = !!opts.autoDismiss; }\n  get settingsV() { return this.settings.v; }\n  async setup(ctx) {\n    this.ctx = ctx; this.baseLook = { ...LOOK_PRESETS.none, scene: [{ id: 'vignette', params: { intensity: 0.3 } }] };\n    setupAudio(ctx, storage());\n    this.router = new Router(ctx, this);\n    this.ui = new UI(ctx, this.router);\n    this.voice = new VoicePlayer(ctx.audio);\n    this.music = new Music(ctx);\n    this.settings = new SettingsScreen(ctx, { ui: this.ui, voice: this.voice, settingsChanged: () => {} });\n    this.play = new Play(ctx, this);\n    this.shell = new Shell(ctx, this);\n    ctx.camera.teleport(this.target.set(10, 0.9, 10));\n    if (this.opts.session) { this.session = this.opts.session; await this.session.setup(this); }\n    else if (!this.opts.noSaveBoot) ctx.input.send({ save: readSave() });\n    else this.shell.boot(this.opts.save ?? blankSave());\n  }\n  ready() { if (typeof window !== 'undefined') window.__GAME__ = this; }\n  fixedUpdate(ctx, dt) {\n    if (this.session) { this.session.fixed(dt); return; }\n    this.shell.fixed(dt);\n  }\n  update(ctx, dt) {\n    const cmds = ctx.input.commands;\n    for (const c of cmds) if (c && c.save && !this.booted) { this.booted = true; this.shell.boot(c.save); }\n    if (typeof document !== 'undefined') this.cursor();\n    this.router.frame(cmds);\n    this.ui.begin();\n    if (this.session) { this.session.update(dt); return; }\n    this.shell.update(dt);\n  }\n  cursor() {\n    const dev = this.router.lastDevice; if (dev === this.cursorDev) return; this.cursorDev = dev;\n    const canvas = this.ctx.engine.gpu?.canvas ?? document.querySelector('canvas'); if (!canvas) return;\n    canvas.style.cursor = dev === 'pad' ? 'none' : gauntletCursor();\n  }\n  cameraTarget() { return this.play?.target ?? this.target; }\n  command(cmd, seat) { return this.play.command(cmd, seat); }\n  seatsOpenForMenu() { return false; }\n  padGone(pad) { const seat = this.router.padSeat[pad]; if (seat > 0 && this.play.world) this.play.hud.toast(`SEAT ${seat + 1}: THE PAD IS GONE.`, 'red'); this.router.release(pad); }\n  // Autosave on zone change, quest step, vendor close, and every 60 s. Sessions never save.\n  persist(force = false) {\n    if (this.session || this.opts.noPersist) return;\n    const s = this.save; const w = this.play?.world;\n    if (w && w.mode === 'campaign' && this.shell.state === 'play') {\n      const h = w.heroes[0]; const data = saveHero(h); data.campaign = { ...saveCampaign(w), bossKills: w.bossKills };\n      s.heroes[this.shell.heroSlot] = data; s.stash = w.stash; s.devotion = w.devotion; s.unlocks = w.unlocks; s.bests = w.bests; s.last = this.shell.heroSlot;\n    }\n    s.settings = this.settings.v;\n    if (force || !this.lastWrite || this.ctx.time - this.lastWrite > 1) { writeSave(s); this.lastWrite = this.ctx.time; }\n  }\n  status() { const w = this.play?.world; const st = this.shell?.state; if (!w) return `shell:${st}`; const h = w.heroes[0]; return `${st} zone:${w.zone?.id} level:${h?.level ?? 0} party:${w.heroes.filter((q) => !q.left).length} kills:${w.stats.kills}`; }\n  fingerprint() { return `${this.shell?.state}|${this.play?.fingerprint?.()}`; }\n}\nfunction gauntletCursor() {\n  const rows = ['..xx....', '.xwwx...', '.xwwx...', '.xwwxxx.', '.xwwwwwx', 'xxwwwwwx', 'xwwwwwwx', 'xwwwwwwx', '.xwwwwx.', '..xxxx..'];\n  const scale = 3; const svg = `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"${8 * scale}\" height=\"${10 * scale}\" shape-rendering=\"crispEdges\">${rows.flatMap((r, y) => [...r].map((c, x) => (c === '.' ? '' : `<rect x=\"${x * scale}\" y=\"${y * scale}\" width=\"${scale}\" height=\"${scale}\" fill=\"${c === 'x' ? '#1a1c2c' : '#ffcd75'}\"/>`))).join('')}</svg>`;\n  return `url(\"data:image/svg+xml;base64,${typeof btoa !== 'undefined' ? btoa(svg) : ''}\") 6 0, auto`;\n}\nexport const createGame = (opts = {}) => new TolledYouSo(opts);\n\nasync function startPage() {\n  const app = document.getElementById('app'); const touchOnly = isTouchOnly();\n  const options = withUrlOptions({ container: app, camera: { preset: 'iso', viewHeight: 11.5, pitch: 42, yaw: 45, minZoom: 0.6, maxZoom: 1.4 }, aspect: 'fill', quality: 'high', touch: false, settings: { button: touchOnly ? 'top-right' : false }, debugKeys: false });\n  // Sessions: straight into the round; no title, menus, attract or saves.\n  if (typeof AIHub !== 'undefined' && AIHub.active) {\n    const info = await AIHub.connect({ mode: 'shared-world', seats: [1, 4], card: true });\n    if (info) {\n      if (info.server) { await runServerCopy(info, createGame); return; }\n      await runHubFlow(info, createGame, options, noWebGpu);\n      return;\n    }\n  }\n  try { await Engine.start(createGame({ touchOnly }), options); } catch (e) { noWebGpu(e); }\n}\nfunction noWebGpu(e) {\n  const app = document.getElementById('app'); const d = document.createElement('div');\n  d.style.cssText = 'position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#1a1c2c;color:#ffcd75;font:20px monospace;text-align:center;padding:24px';\n  const t = document.createElement('h1'); t.textContent = TITLE; const p = document.createElement('p'); p.textContent = 'This game needs WebGPU: a recent Chrome or Edge, Safari 26, or Firefox on Windows';\n  d.append(t, p); (app ?? document.body).append(d);\n  if (typeof console !== 'undefined') console.warn('Engine failed to start', e?.message ?? e);\n}\nif (typeof document !== 'undefined') startPage();\nexport { ENGINE_VERSION };\nEOF\ncat > src/net/hubflow.js <<'EOF'\n// Placeholder removed in the net milestone below.\nEOF\necho ok","description":"Write shell, attract and game entry"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12327,"cache_read_input_tokens":555773,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12327},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"69254de6-4061-470e-8e76-10f1ee96c6e5","uuid":"f59435a3-49fb-401f-be2a-6f1d2949f05b","timestamp":"2026-11-06T00:15:55.099Z","request_id":"req_011Cgki3PhakkpHuMJQhySJg","wire_tool_inputs":{"toolu_017W3sqsLm2Z7wsumDcERXmT":{"command":"cat > src/modes/shell.js <<'EOF'\n// Title, main menu, hero select, new hero, attract, touch-only. A state machine over the Play world.\nimport { buildModel, Rng, THREE } from '../../pixel-engine.js';\nimport { CLASSES, CLASS_IDS, SKILLS } from '../data/classes.js';\nimport { HERO_NAMES } from '../data/dialog.js';\nimport { LEGENDARIES, SET_FOR_CLASS, SETS } from '../data/items.js';\nimport { TAGLINE, TITLE } from '../data/meta.js';\nimport { DIFFICULTIES } from '../data/tuning.js';\nimport { addHero, newWorld } from '../sim/step.js';\nimport { enterZone, setDifficulty } from '../sim/world.js';\nimport { loadCampaign, loadHeroInto, saveCampaign, saveHero } from '../sim/serialize.js';\nimport { levelUp, refresh } from '../sim/hero.js';\nimport { makeItem } from '../sim/loot.js';\nimport { QUESTS } from '../sim/quests.js';\nimport { Actor } from '../view/actors.js';\nimport { MODELS } from '../view/models/props.js';\nimport { footer, prompt } from '../ui/glyphs.js';\nimport { drawIcon } from '../ui/hud.js';\nimport { Attract } from './attract.js';\nimport { blankSave, writeSave } from '../save/save.js';\n\nconst IDLE_ATTRACT = 600; // 10 s of frames.\nexport class Shell {\n  constructor(ctx, game) { this.ctx = ctx; this.game = game; this.state = 'boot'; this.idle = 0; this.t = 0; this.frameN = 0; this.titleWorld = null; this.titleActors = []; this.sel = 0; this.heroSlot = 0; this.nameI = 0; this.diffI = 0; this.startI = 0; this.heroSel = 0; this.confirmDel = 0; this.rng = new Rng('shell'); this.attract = null; this.returnTo = 'title'; this.touchOnly = game.touchOnly; this.hub = false; this.creating = null; }\n  get play() { return this.game.play; }\n  get ui() { return this.game.ui; }\n  boot(save) { this.game.save = save; this.game.settings.load(save.settings); this.toTitle(); }\n  makeTitleWorld() {\n    if (this.titleWorld) return;\n    const w = newWorld({ seed: 7 }); enterZone(w, 'titlescene'); w.events.length = 0; w.mode = 'title'; this.titleWorld = w;\n    this.play.begin(w, { local: [] }); this.play.view.update(w, 0.016, 1, {});\n    const z = w.zone; const v = this.play.view; const add = (id, x, zz, s = 1, y = 0) => { const b = buildModel(id, { catalog: MODELS }); b.object.position.set(x, y, zz); b.object.scale.setScalar(s); b.object.traverse((m) => { if (m.isMesh) { m.castShadow = true; m.receiveShadow = true; } }); v.zone.root.add(b.object); return b.object; };\n    this.belfry = add('belfry_scene', z.w / 2 - 8, z.h / 2 - 8, 1.4);\n    add('dead-tree', z.w / 2 + 4, z.h / 2 - 4); add('tombstone', z.w / 2 + 2, z.h / 2 + 3); add('tombstone', z.w / 2 + 5, z.h / 2 + 1); add('tombstone', z.w / 2 - 2, z.h / 2 + 4); add('tombstone', z.w / 2 - 5, z.h / 2 + 2);\n    // Three heroes on plinths, for hero select.\n    this.plinths = [];\n    CLASS_IDS.forEach((c, i) => { const x = z.w / 2 + (i - 1) * 3.2 * 0.71; const zz = z.h / 2 + 7 - (i - 1) * 3.2 * 0.71; add('plinth', x, zz); const a = new Actor(this.ctx, `hero_${c}`, { x, z: zz }); a.root.position.y = 0.5; this.titleActors.push({ a, x, z: zz, c, y: 0.5 }); this.plinths.push({ x, z: zz }); this.ctx.lights.request({ position: [x, 3, zz + 1], color: 0xffc080, intensity: 8, radius: 7, flicker: 'torch', priority: 2 }); });\n    v.ambient(w);\n  }\n  dropTitle() { for (const t of this.titleActors) t.a.dispose(); this.titleActors = []; this.titleWorld = null; this.belfry = null; }\n  toTitle() { this.state = this.touchOnly ? 'touch' : 'title'; this.idle = 0; this.t = 0; this.makeTitleWorld(); this.game.music.play('vespers'); this.ui.focus = null; }\n  toMenu() { if (!this.titleWorld) { this.play.stop(); this.makeTitleWorld(); } this.state = 'menu'; this.idle = 0; this.ui.focus = null; this.game.music.play('vespers'); }\n  fixed(dt) { if (this.state === 'play') this.play.fixed(dt); else if (this.state === 'attract') this.play.fixed(dt); else if (this.titleWorld) this.titleWorld.time += dt; }\n  update(dt) {\n    this.frameN++; this.t += 1 / 60;\n    const r = this.game.router;\n    const stateIn = this.state;\n    if (stateIn === 'play') { this.play.update(dt); return; }\n    if (stateIn === 'attract') { this.updateAttract(dt); return; }\n    if (stateIn === 'boot') return;\n    // Title world idles behind every shell screen.\n    if (this.titleWorld && this.play.world === this.titleWorld) this.updateTitleWorld(dt);\n    if (r.anyInput) this.idle = 0; else this.idle++;\n    if ((stateIn === 'title' || stateIn === 'menu' || stateIn === 'touch') && this.idle >= IDLE_ATTRACT) { this.startAttract(stateIn); return; }\n    const fn = this[`draw_${stateIn}`]; if (fn) fn.call(this, this.ui, this.ui.m);\n  }\n  updateTitleWorld(dt) {\n    const w = this.titleWorld; const v = this.play.view; const z = w.zone;\n    const hs = this.state === 'heroselect' || this.state === 'newhero' || this.state === 'heroes';\n    const cx = hs ? z.w / 2 : z.w / 2 + Math.sin(this.t * 0.1) * 2 - 3; const cz = hs ? z.h / 2 + 7 : z.h / 2 + Math.cos(this.t * 0.1) * 2 - 3;\n    this.play.target.set(cx, 0.9, cz); v.focus.set(cx, 0, cz); this.ctx.camera.setZoom(hs ? 1.3 : 0.72);\n    for (const t of this.titleActors) { t.a.update(dt, t.x, t.z, 0.8, false, { y: t.y }); if (t.a.root.position.y !== t.y) t.a.root.position.y = t.y; }\n    v.fx.update(dt); v.zone.update(dt, v.focus, this.ctx.time);\n    if (v.rng.chance(0.4)) this.ctx.particles.burst('emberfall', [cx + v.rng.range(-14, 14), 0.1, cz + v.rng.range(-10, 10)], { count: 1 });\n    if (this.frameN % 400 === 1) this.ctx.audio.play('bell_small', { volume: 0.3, pitch: -12 });\n  }\n  draw_title(ui, m) {\n    const big = ui.measure(TITLE, 4) < ui.W - 24 ? 4 : ui.measure(TITLE, 3) < ui.W - 24 ? 3 : 2;\n    ui.textC(ui.W / 2, ui.H * 0.2, TITLE, { color: 'sand', scale: big });\n    ui.textC(ui.W / 2, ui.H * 0.2 + 7 * big + 8, TAGLINE, { color: 'mist' });\n    if (this.frameN % 80 < 56) ui.textC(ui.W / 2, ui.H * 0.72, 'PRESS ANY BUTTON', { color: 'white', scale: 1 });\n    if (!this.ctx.audio.unlocked && this.game.router.lastDevice === 'pad') ui.textC(ui.W / 2, ui.H * 0.72 + 12, 'PRESS A KEY OR CLICK FOR SOUND', { color: 'mist' });\n    if (this.game.router.anyInput && !this.game.router.pointerMoved && this.t > 0.3) { this.state = 'menu'; this.idle = 0; ui.focus = null; this.ctx.audio.play('bell_small'); this.ctx.input.clearQueued(); }\n  }\n  hasSave() { return this.game.save.heroes.some(Boolean); }\n  draw_menu(ui, m) {\n    const big = ui.measure(TITLE, 3) < ui.W - 24 ? 3 : 2; ui.textC(ui.W / 2, 22, TITLE, { color: 'sand', scale: big });\n    const s = this.game.save; const knellOpen = s.unlocks.knell;\n    const items = [];\n    if (this.hasSave()) items.push(['CONTINUE', () => { this.state = 'heroes'; ui.focus = null; }]);\n    items.push(['NEW HERO', () => { this.beginNew(); }]);\n    items.push([knellOpen ? 'KNELL RUNS' : 'KNELL RUNS (LOCKED)', () => { if (knellOpen && this.hasSave()) { this.afterLoad = 'knell'; this.state = 'heroes'; ui.focus = null; } else { this.ctx.audio.play('ui_error'); } }, !knellOpen]);\n    items.push(['SETTINGS', () => { this.state = 'settings'; ui.focus = null; }]);\n    items.push(['ABOUT', () => { this.state = 'about'; ui.focus = null; this.aboutS = { tab: 0 }; }]);\n    const y0 = Math.max(60, ui.H * 0.34); const rowH = 22;\n    items.forEach(([label, fn, dis], i) => { if (ui.button(`m:${label}`, ui.W / 2 - 80, y0 + i * rowH, 160, rowH - 3, label, { disabled: dis })) fn(); });\n    footer(ui, [['confirm', 'CHOOSE']]);\n    if (m.back) { this.state = 'title'; this.t = 0; ui.focus = null; }\n  }\n  draw_settings(ui, m) { this.game.settings.draw(ui, this.setS ??= {}, m); this.game.persist?.(true); if (m.back) { this.state = this.settingsBack ?? 'menu'; ui.focus = null; } }\n  draw_about(ui, m) { const s = this.aboutS; this.play.menus.screen_about(ui, s, this.titleWorld, null, m); if (m.back) { this.state = 'menu'; ui.focus = null; } }\n  draw_touch(ui, m) {\n    ui.rect(0, ui.H * 0.3, ui.W, 40, 'ink');\n    const lines = ui.wrap('CONTROLLER OR KEYBOARD REQUIRED', Math.min(ui.W - 16, 300), 1);\n    lines.forEach((l, i) => ui.textC(ui.W / 2, ui.H * 0.3 + 8 + i * 10, l, { color: 'sand' }));\n    const big = ui.measure(TITLE, 3) < ui.W - 24 ? 3 : ui.measure(TITLE, 2) < ui.W - 24 ? 2 : 1; ui.textC(ui.W / 2, 14, TITLE, { color: 'sand', scale: big });\n    const r = this.game.router; if (r.lastDevice === 'pad' && r.anyInput || this.ctx.input.queuedPresses.some((k) => k.startsWith('Key') || k === 'Enter')) { this.touchOnly = false; this.state = 'menu'; this.idle = 0; ui.focus = null; }\n  }\n  // Heroes: up to three slots; deletion with a hold to confirm.\n  draw_heroes(ui, m) {\n    ui.rect(0, 0, ui.W, 26, 'ink'); ui.textC(ui.W / 2, 8, 'YOUR HEROES', { color: 'sand' });\n    const s = this.game.save; const y0 = ui.H - 96;\n    s.heroes.forEach((h, i) => {\n      const x = 12 + i * ((ui.W - 24) / 3); const w = (ui.W - 24) / 3 - 4; const id = `hs:${i}`; const st = ui.widget(id, x, y0, w, 62, {});\n      ui.frame(x, y0, w, 62, st.focused ? 'sand' : 'slate', st.focused ? 'plum' : 'ink');\n      if (h) {\n        ui.text(x + 5, y0 + 5, h.name.slice(0, Math.floor((w - 10) / 6)), { color: 'white' }); ui.text(x + 5, y0 + 15, `LV ${h.level} ${CLASSES[h.cls].name}`, { color: CLASSES[h.cls].color });\n        const qname = QUESTS[h.campaign?.story?.q ?? 0]?.name ?? 'THE BELL RINGS TRUE'; ui.text(x + 5, y0 + 25, qname.slice(0, Math.floor((w - 10) / 6)), { color: 'mist' }); ui.text(x + 5, y0 + 35, DIFFICULTIES[h.campaign?.difficulty ?? 0].name, { color: 'mist' });\n        if (st.focused) this.heroSel = i;\n      } else ui.textC(x + w / 2, y0 + 26, 'EMPTY', { color: 'mist' });\n      if (st.act) { if (h) this.loadHero(i); else this.beginNew(i); }\n    });\n    // Show the hovered hero's class on the plinth by turning them to camera.\n    const held = m.x === false && (this.ctx.input.isDown('KeyX') || this.game.router.pads.some((p) => (p.b & 4) !== 0));\n    const fh = s.heroes[this.heroSel];\n    if (fh && held && this.ui.focus?.startsWith('hs:')) { this.confirmDel += 1 / 60; ui.bar(ui.W / 2 - 60, ui.H - 30, 120, 6, this.confirmDel / 1.5, 'red'); if (this.confirmDel >= 1.5) { s.heroes[this.heroSel] = null; this.confirmDel = 0; this.game.persist?.(true); this.ctx.audio.play('ui_salvage'); } } else this.confirmDel = 0;\n    footer(ui, [['confirm', 'PLAY'], ['x', 'HOLD TO DELETE'], ['back', 'BACK']]);\n    if (m.back) { this.afterLoad = null; this.state = 'menu'; ui.focus = null; }\n  }\n  beginNew(slot = null) {\n    const s = this.game.save; const free = slot ?? s.heroes.findIndex((h) => !h);\n    if (free < 0) { this.state = 'heroes'; this.ctx.audio.play('ui_error'); return; }\n    this.creating = { slot: free, cls: 0, name: this.rngName(), diff: 0, step: 0 }; this.state = 'newhero'; this.ui.focus = null;\n  }\n  rngName() { return HERO_NAMES[Math.floor(this.rng.next() * HERO_NAMES.length)]; }\n  draw_newhero(ui, m) {\n    const c = this.creating;\n    const col = (ui.W - 24) / 3;\n    if (c.step === 0) {\n      ui.rect(0, 0, ui.W, 26, 'ink'); ui.textC(ui.W / 2, 8, 'PICK A TRADE', { color: 'sand' });\n      CLASS_IDS.forEach((id, i) => {\n        const x = 12 + i * col; const w = col - 4; const y = ui.H - 112; const st = ui.widget(`cl:${id}`, x, y, w, 82, {}); const k = CLASSES[id];\n        ui.frame(x, y, w, 82, st.focused ? 'sand' : 'slate', st.focused ? 'plum' : 'ink'); ui.text(x + 5, y + 4, k.name, { color: k.color }); ui.para(x + 5, y + 14, k.fantasy, w - 10, { color: 'mist', lh: 8 });\n        ui.text(x + 5, y + 44, k.resource.toUpperCase(), { color: 'sand' }); k.signature.forEach((sid, n) => { const sk = SKILLS[sid]; drawIcon(ui, x + 5 + n * 18, y + 54, sk.icon); });\n        if (st.focused) { if (c.cls !== i) { c.cls = i; this.titleActors[i]?.a.play('Triumph', 1.2); } }\n        if (st.act) { c.cls = i; c.step = 1; ui.focus = null; this.titleActors[i]?.a.play('Triumph', 1.2); }\n      });\n      footer(ui, [['confirm', 'CHOOSE'], ['back', 'BACK']]);\n      if (m.back) { this.state = 'menu'; ui.focus = null; }\n    } else if (c.step === 1) {\n      ui.rect(ui.W / 2 - 130, 30, 260, ui.H - 60, 'ink');\n      ui.textC(ui.W / 2, 38, `A ${CLASSES[CLASS_IDS[c.cls]].name}`, { color: CLASSES[CLASS_IDS[c.cls]].color, scale: 2 });\n      ui.textC(ui.W / 2, 62, c.name, { color: 'white' });\n      if (ui.button('n:shuffle', ui.W / 2 - 110, 74, 220, 16, 'SHUFFLE THE NAME')) c.name = this.rngName();\n      ui.text(ui.W / 2 - 110, 96, 'DIFFICULTY', { color: 'mist' });\n      const ds = DIFFICULTIES.filter((d) => !d.locked);\n      ds.forEach((d, i) => { if (ui.button(`n:d${i}`, ui.W / 2 - 110 + i * 74, 106, 72, 16, d.name, { border: c.diff === i ? 'sand' : 'slate' })) c.diff = i; });\n      ui.text(ui.W / 2 - 110, 128, 'WHERE TO BEGIN', { color: 'mist' });\n      if (ui.button('n:begin', ui.W / 2 - 110, 138, 220, 18, 'THE BEGINNING')) this.startNew(false);\n      if (ui.button('n:last', ui.W / 2 - 110, 158, 220, 18, 'THE LAST BELL (LEVEL 30)')) this.startNew(true);\n      const f = ui.focus === 'n:last'; const hint = f ? 'ALL SKILLS, LEGENDARIES, A SET, GEMS, DEVOTION, A GRAND KEY.' : ui.focus === 'n:begin' ? 'FROM THE GROUND UP. ABOUT AN HOUR TO THE CREDITS.' : ''; if (hint) { const lines = ui.wrap(hint, 240); lines.forEach((l, i) => ui.textC(ui.W / 2, 180 + i * 9, l, { color: 'sand' })); }\n      footer(ui, [['confirm', 'CHOOSE'], ['back', 'BACK']]);\n      if (m.back) { c.step = 0; ui.focus = null; m.back = false; }\n    }\n  }\n  // New game seeds are chosen here and passed through ctx.input.send, so they replay.\n  startNew(lastBell) {\n    const c = this.creating; const cls = CLASS_IDS[c.cls]; const seed = (this.rng.next() * 1e9) | 0;\n    const w = newWorld({ seed, difficulty: c.diff }); this.leaveTitle();\n    const h = addHero(w, { seat: 0, cls, name: c.name });\n    this.heroSlot = c.slot; this.game.world = w;\n    this.applyShared(w);\n    if (lastBell) {\n      this.setupLastBell(w, h);\n      enterZone(w, 'town');\n      this.enterPlay(w);\n      this.game.persist?.(true);\n    } else {\n      enterZone(w, 'yard');\n      const p = w.props; void p;\n      this.enterPlay(w);\n      this.play.playScene({ black: true, lines: [[0.6, 6.4, 'narrator', 'For a thousand years Old Clemency tolled at dusk, and the dead of Vespermoor stayed down.'], [6.8, 12.4, 'narrator', 'Forty days ago the Great Bell cracked. It still tolls. It now says something else.'], [12.8, 18, 'narrator', 'You were buried on the thirty-ninth day. It did not take.']], cues: [{ at: 0.2, run: () => this.ctx.audio.play('bell_cracked') }, { at: 12.8, run: () => this.ctx.audio.play('bell_cracked', { volume: 0.5 }) }], duration: 18.5, after: () => { this.onRise(w, h); } });\n      this.game.persist?.(true);\n    }\n  }\n  onRise(w, h) { const a = this.play.view.heroes.get(h.id); a?.play('GetUp', 1.2); this.ctx.engine.shake.add(0.4); this.ctx.audio.play('coffin_crash'); this.ctx.particles.burst('bone_chips', [h.x, 0.5, h.z], { count: 26, colors: ['plum', 'mist'] }); }\n  setupLastBell(w, h) {\n    while (h.level < 30) levelUp(w, h);\n    h.xp = 0; const rng = w.rngs.loot; h.gold = 25000;\n    h.mats = { scrap: 120, dust: 60, shards: 30, keys: 1 };\n    const legs = LEGENDARIES.filter((l) => l.cls === h.cls).slice(0, 2).concat(LEGENDARIES.filter((l) => !l.cls).slice(0, 1));\n    for (const l of legs) { const it = makeItem(rng, { legendary: l.id, ilvl: 30, cls: h.cls }); const old = h.gear[it.slot]; h.gear[it.slot] = it; if (old) h.inv.push(old); }\n    const set = SET_FOR_CLASS[h.cls];\n    for (const slot of ['head', 'feet']) h.gear[slot] = makeItem(rng, { slot, set, ilvl: 30, cls: h.cls });\n    for (const slot of ['shoulders', 'legs', 'amulet', 'ring', 'off', 'hands', 'chest']) if (!h.gear[slot]) h.gear[slot] = makeItem(rng, { slot, rarity: 'reliquary', ilvl: 29, cls: h.cls });\n    for (const slot of ['chest', 'hands']) h.inv.push(makeItem(rng, { slot, set, ilvl: 30, cls: h.cls }));\n    if (!h.gear.main) h.gear.main = makeItem(rng, { slot: 'main', rarity: 'reliquary', ilvl: 29, cls: h.cls });\n    h.gems = { 'ember:1': 3, 'salt:1': 3, 'amber:1': 3 };\n    const all = CLASSES[h.cls].skills;\n    h.slots = [all[0], all[3], all[4], all[5], all[6], all[7]].map((s, i) => ({ skill: s.id, tone: Object.keys(s.tones)[i % 3] }));\n    h.vows = [CLASSES[h.cls].vows[0].id, CLASSES[h.cls].vows[1].id];\n    w.devotion.bonus = 5; w.unlocks.knell = true; w.unlocks.penance = true;\n    w.story.q = QUESTS.length; w.story.step = 0; w.story.flags = { ...w.story.flags, brasseOpen: true, writsOpen: true, talk_ogive2: true, lastBell: true, pyx: false };\n    w.story.lychgates = ['town', 'causeway', 'ossuary1', 'ossuary2', 'ossuary3', 'cloister', 'belfry1', 'belfry2', 'belfry3'];\n    refresh(w, h); h.hp = h.stats.maxHp; h.res = h.stats.maxResource;\n  }\n  applyShared(w) { const s = this.game.save; w.stash = s.stash; w.devotion = s.devotion; w.unlocks = s.unlocks; w.bests = s.bests; }\n  loadHero(i) {\n    const s = this.game.save; const data = s.heroes[i]; if (!data) return;\n    const c = data.campaign ?? {};\n    const w = newWorld({ seed: c.seed ?? 11, difficulty: c.difficulty ?? 0 }); this.leaveTitle();\n    const h = addHero(w, { seat: 0, cls: data.cls, name: data.name });\n    this.applyShared(w);\n    loadCampaign(w, c); w.bossKills = c.bossKills ?? w.bossKills;\n    loadHeroInto(w, h, data);\n    setDifficulty(w, c.difficulty ?? 0);\n    this.heroSlot = i; this.game.world = w;\n    enterZone(w, w.story.q >= 1 || w.story.flags?.lastBell ? 'town' : 'yard');\n    this.enterPlay(w);\n    if (this.afterLoad === 'knell') { this.afterLoad = null; this.play.menus.push('knell'); }\n  }\n  leaveTitle() { this.dropTitle(); this.play.stop(); }\n  enterPlay(w) { this.state = 'play'; const bots = this.game.testBot ? { 0: true } : {}; this.play.begin(w, { local: [0], bots }); this.ctx.input.clearQueued(); }\n  onEnding() {\n    const w = this.play.world;\n    this.game.persist?.(true);\n    this.play.music.play('clemency');\n    this.play.playScene({ black: (t) => t > 9, lines: [[1, 6, 'narrator', 'And the hand of the Late closed upon the rope, and Old Clemency spoke, and the word it spoke was true.'], [6.4, 11, 'malison', 'EVERY VERSE. I KNOW EVERY VERSE. I ONLY WANTED SOMEONE TO HEAR THE LAST ONE.'], [11.4, 17, 'narrator', 'The Unrung Saint came apart like old mortar. The dead of Vespermoor lay down, grumbling, and dawn came up over the moor.'], [17.4, 20.5, 'crier', 'Hear ye, hear ye! The fish is still off.'], [36, 41.5, 'narrator', 'And far below, under the foundation, under the peat, a much deeper bell answered.']],\n      cues: [{ at: 0.3, run: () => { this.ctx.audio.play('bell_true'); this.ctx.engine.screen.flash('sand', { duration: 1 }); } }, { at: 36, run: () => this.ctx.audio.play('bell_big', { pitch: -12 }) }], duration: 43,\n      credits: (ui, t) => { if (t < 21 || t > 35.5) return; const lines = [TITLE, ' ', 'A GAME OF THE BELL, THE PEAT AND THE LATE', ' ', 'WRITTEN, DRAWN AND RUNG', 'BY CLAUDE OPUS 5.5', ' ', 'ON THE PIXEL ENGINE', ' ', 'PENANCE IS UNLOCKED', 'THE KNELL FONT ANSWERS NOW', ' ', 'THANK YOU FOR PLAYING']; const y0 = ui.H - (t - 21) * 18; lines.forEach((l, i) => { const y = y0 + i * 14; if (y > 10 && y < ui.H - 10) ui.textC(ui.W / 2, y, l, { color: i === 0 ? 'sand' : 'white' }); }); },\n      after: () => { this.game.endingSeen = true; if (w.zone.id !== 'town') enterZone(w, 'town'); this.play.music.play('lamps'); this.game.persist?.(true); this.play.hud.toast('THE KNELL FONT ANSWERS NOW. PENANCE IS UNLOCKED.', 'sand', { big: true }); } });\n  }\n  // Attract: any input goes straight back to where it was.\n  startAttract(from) {\n    this.returnTo = from; this.leaveTitle(); this.state = 'attract';\n    this.attract = new Attract(this.ctx, this.game, this.play); this.attract.start();\n    this.attractLoops = 0;\n  }\n  startAttractFromDev() { this.play.menus.closeAll(); this.game.persist?.(true); this.startAttract('menu'); }\n  updateAttract(dt) {\n    const r = this.game.router;\n    this.attract.update(dt);\n    this.play.update(dt);\n    this.attract.draw(this.ui, this.touchOnly);\n    if (r.anyInput && this.frameN > 2 && this.attract.age > 0.3) {\n      if (this.touchOnly && r.lastDevice !== 'pad') { if (this.ctx.input.queuedPresses.some((k) => k.startsWith('Key') || k === 'Enter')) this.touchOnly = false; else { /* A tap only returns to the message. */ this.exitAttract(); return; } }\n      this.exitAttract();\n    } else if (r.touched && this.touchOnly) this.exitAttract();\n  }\n  exitAttract() { this.attract.stop(); this.attract = null; this.play.stop(); this.ctx.engine.screen.clear(); this.makeTitleWorld(); this.state = this.touchOnly ? 'touch' : this.returnTo; this.idle = 0; this.t = 0; this.game.music.play('vespers'); this.ui.focus = null; this.ctx.input.clearQueued(); }\n}\nexport { saveCampaign, saveHero, blankSave, writeSave, prompt, SETS };\nEOF\ncat > src/modes/attract.js <<'EOF'\n// The attract tour: real worlds, real bots, cheating freely. It never touches saves.\nimport { CLASS_IDS, CLASSES } from '../data/classes.js';\nimport { TITLE } from '../data/meta.js';\nimport { addHero, newWorld } from '../sim/step.js';\nimport { enterZone, findOpenNear } from '../sim/world.js';\nimport { levelUp, refresh } from '../sim/hero.js';\nimport { makeItem } from '../sim/loot.js';\nimport { dropItem } from '../sim/rules.js';\nimport { spawnElitePack, spawnMonster, killMonster } from '../sim/monsters.js';\nimport { startKnell } from '../sim/knell.js';\nimport { LEGENDARIES } from '../data/items.js';\nimport { makeTuning } from '../data/tuning.js';\n\nexport const STOPS = ['town', 'causeway', 'ossuary', 'bursar', 'cloister', 'knell', 'malison2', 'malison3'];\nconst STOP_T = { town: 16, causeway: 16, ossuary: 16, bursar: 14, cloister: 16, knell: 16, malison2: 16, malison3: 14 };\nexport class Attract {\n  constructor(ctx, game, play) { this.ctx = ctx; this.game = game; this.play = play; this.i = -1; this.t = 0; this.age = 0; this.visited = {}; this.loops = 0; this.phase = 'run'; this.showHud = true; this.zoom = 1; this.pan = 0; }\n  start() { this.next(); }\n  stop() { this.ctx.engine.screen.clear(); this.play.attract = null; this.play.voice.stop(); }\n  makeHeroes(w, list) {\n    list.forEach((cls, seat) => {\n      const h = addHero(w, { seat, cls, name: CLASSES[cls].name, isBot: true });\n      while (h.level < 25) levelUp(w, h);\n      h.attractGod = true; const legs = LEGENDARIES.filter((l) => l.cls === cls);\n      for (const l of legs.slice(0, 2)) { const it = makeItem(w.rngs.loot, { legendary: l.id, ilvl: 25, cls }); h.gear[it.slot] = it; }\n      for (const slot of ['head', 'shoulders', 'chest', 'feet']) if (!h.gear[slot]) h.gear[slot] = makeItem(w.rngs.loot, { slot, rarity: 'reliquary', ilvl: 25, cls });\n      if (!h.gear.main) h.gear.main = makeItem(w.rngs.loot, { slot: 'main', rarity: 'legendary', ilvl: 25, cls, legendary: legs[0].id });\n      const sk = CLASSES[cls].skills; h.slots = [sk[0], sk[1], sk[2], sk[3], sk[4], sk[6]].map((s, i) => ({ skill: s.id, tone: Object.keys(s.tones)[i % 3] }));\n      refresh(w, h); h.hp = h.stats.maxHp; h.res = h.stats.maxResource;\n    });\n  }\n  world(classes) {\n    const tuning = makeTuning(); tuning.monsterHp = 0.35;\n    const w = newWorld({ seed: 77 + this.i * 13 + this.loops * 101, tuning }); w.mode = 'attract'; w.cheats.infRes = true; w.cheats.noCd = false; w.tuning.cooldown = 0.25; w.story.flags.writsOpen = true; w.story.flags.brasseOpen = true; w.story.q = 2; this.makeHeroes(w, classes); w.unlocks.knell = true;\n    return w;\n  }\n  setup(stop) {\n    this.visited[stop] = (this.visited[stop] ?? 0) + 1; let w; const bots = {};\n    this.camera = null; this.zoom = 1; this.showHud = true;\n    switch (stop) {\n      case 'town': { w = this.world(['lamplighter']); enterZone(w, 'town'); this.camTour = w.props.filter((p) => p.kind === 'npc'); this.showHud = false; this.camera = (wd) => this.tourCamera(wd); this.zoom = 1.15; this.lines = [['crier', 'Hear ye, hear ye! The dead are up, the roads are closed, and the fish is off.'], ['pennywhistle', 'Everything is half price, dear friend. The other half is your soul.'], ['ogive', 'Bring me the holy bones, child. I will know them by the taste.']]; break; }\n      case 'causeway': { w = this.world(['bellwarden']); enterZone(w, 'causeway'); w.story.flags.firstPlate = true; w.story.flags.firstChampion = true; const h = w.heroes[0]; const r = w.zone.roomRects[2]; const p = findOpenNear(w, r.x + r.w / 2, r.y + r.h / 2); h.x = p.x; h.z = p.z; for (let i = 0; i < 26; i++) { const q = findOpenNear(w, p.x + w.rngs.ai.range(-7, 7), p.z + w.rngs.ai.range(-5, 5)); spawnMonster(w, i % 7 === 0 ? 'bloat_deacon' : i % 3 ? 'peatwalker' : 'gibbet_drop', q.x, q.z, { dormant: false, aggro: true }); } this.legT = 6; break; }\n      case 'ossuary': { w = this.world(['sexton']); enterZone(w, 'ossuary2'); const h = w.heroes[0]; const r = w.zone.roomRects[1]; const p = findOpenNear(w, r.x + r.w / 2, r.y + r.h / 2); h.x = p.x; h.z = p.z; spawnElitePack(w, p.x + 4, p.z, 'rare', null, ['rattlebones', 'pallid_bearer'], { dormant: false, aggro: true }); for (let i = 0; i < 16; i++) { const q = findOpenNear(w, p.x + w.rngs.ai.range(-6, 6), p.z + w.rngs.ai.range(-5, 5)); spawnMonster(w, 'rattlebones', q.x, q.z, { dormant: false, aggro: true }); } break; }\n      case 'bursar': { w = this.world(['sexton']); enterZone(w, 'countinghouse'); break; }\n      case 'cloister': { w = this.world(['lamplighter']); enterZone(w, 'cloister'); const h = w.heroes[0]; const r = w.zone.roomRects[3]; const p = findOpenNear(w, r.x + r.w / 2, r.y + r.h / 2); h.x = p.x; h.z = p.z; for (let i = 0; i < 26; i++) { const q = findOpenNear(w, p.x + w.rngs.ai.range(-8, 8), p.z + w.rngs.ai.range(-5, 5)); spawnMonster(w, i % 3 ? 'cinderling' : i % 2 ? 'penitent' : 'tithe_collector', q.x, q.z, { dormant: false, aggro: true }); } h.slots = [CLASSES.lamplighter.skills[0], CLASSES.lamplighter.skills[6], CLASSES.lamplighter.skills[7], CLASSES.lamplighter.skills[2], CLASSES.lamplighter.skills[3], CLASSES.lamplighter.skills[1]].map((s) => ({ skill: s.id, tone: null })); break; }\n      case 'knell': { w = this.world(CLASS_IDS.slice()); enterZone(w, 'town'); startKnell(w); w.knell.total = 70; break; }\n      case 'malison2': case 'malison3': { w = this.world(['bellwarden', 'sexton']); w.story.q = 4; w.story.step = 3; enterZone(w, 'belfry_top'); const m = w.boss?.m; if (m) { m.intro = 0; m.hp = stop === 'malison2' ? m.maxHp * 0.59 : m.maxHp * 0.24; } break; }\n      default: break;\n    }\n    w.events.length = 0;\n    CLASS_IDS.forEach((c, i) => { if (w.heroes.some((h) => h.seat === i)) bots[i] = true; });\n    this.play.begin(w, { local: w.heroes.map((h) => h.seat), bots, attract: this });\n    this.play.world.mode = stop === 'malison2' || stop === 'malison3' ? 'campaign' : w.mode;\n    this.play.music.play(w.zone.spec.song);\n    this.tourI = 0; this.tourT = 0;\n    this.play.hud.banner = { text: TITLE, t: 2.5, big: true };\n    if (this.lines) { this.play.say(this.lines[0][0], this.lines[0][1]); }\n  }\n  tourCamera(w) {\n    const list = this.camTour; if (!list?.length) return null;\n    this.tourT += 1 / 60; if (this.tourT > 16 / list.length) { this.tourT = 0; this.tourI = (this.tourI + 1) % list.length; if (this.lines?.[this.tourI]) this.play.say(this.lines[this.tourI][0], this.lines[this.tourI][1]); }\n    const p = list[this.tourI]; this.cam = this.cam ?? { x: p.x, z: p.z }; this.cam.x += (p.x - this.cam.x) * 0.015; this.cam.z += (p.z - this.cam.z) * 0.015; return this.cam;\n  }\n  next() {\n    this.i++; if (this.i >= STOPS.length) { this.i = 0; this.loops++; }\n    this.lines = null; this.cam = null;\n    this.setup(STOPS[this.i]);\n    this.t = 0; this.phase = 'run';\n    this.ctx.engine.screen.reveal('iris').catch?.(() => {});\n  }\n  fixed(w) {\n    // A legendary beam on the Causeway, and keep monsters coming so there's always a fight to show.\n    if (this.legT !== undefined && STOPS[this.i] === 'causeway') { this.legT -= 1 / 60; if (this.legT <= 0) { this.legT = undefined; const h = w.heroes[0]; dropItem(w, h.x + 2, h.z + 1, makeItem(w.rngs.loot, { legendary: LEGENDARIES[0].id, ilvl: 25, cls: h.cls }), h.seat); } }\n    if (w.tick % 240 === 0 && STOPS[this.i] !== 'town' && w.active.filter((m) => !m.dead).length < 8 && !w.boss) {\n      const h = w.heroes[0]; const list = w.zone.spec.monsters.length ? w.zone.spec.monsters : ['rattlebones'];\n      for (let i = 0; i < 10; i++) { const p = findOpenNear(w, h.x + w.rngs.ai.range(-7, 7), h.z + w.rngs.ai.range(-6, 6)); spawnMonster(w, w.rngs.ai.pick(list), p.x, p.z, { dormant: false, aggro: true }); }\n    }\n    // Malison's third act: the bots ring the ropes. It may cheat.\n    const stop = STOPS[this.i];\n    if (stop === 'malison3' && w.boss?.m?.bossState?.phase === 2 && w.boss.m.hp > w.boss.m.maxHp * 0.24) w.boss.m.hp = w.boss.m.maxHp * 0.24;\n    if (stop === 'bursar' && w.boss?.m && w.boss.m.hp < w.boss.m.maxHp * 0.4) w.boss.m.hp = w.boss.m.maxHp * 0.8;\n    if (stop === 'malison2' && w.boss?.m && w.boss.m.hp < w.boss.m.maxHp * 0.3) w.boss.m.hp = w.boss.m.maxHp * 0.55;\n    void killMonster;\n  }\n  update(dt) {\n    const real = 1 / 60; this.age += real; this.t += real;\n    if (this.phase === 'run' && this.t > STOP_T[STOPS[this.i]]) { this.phase = 'cover'; this.t = 0; this.ctx.engine.screen.cover('iris').catch?.(() => {}); }\n    if (this.phase === 'cover' && this.t > 0.7) { this.next(); }\n  }\n  draw(ui, touchOnly) {\n    ui.rect(12, 12, ui.measure('DEMO') + 6, 11, 'red'); ui.text(15, 14, 'DEMO', { color: 'white', shadow: false });\n    if (Math.floor(this.age * 1.5) % 2 === 0) ui.textC(ui.W / 2, ui.H - 24, touchOnly ? 'CONTROLLER OR KEYBOARD REQUIRED' : 'PRESS ANY BUTTON', { color: 'sand' });\n  }\n}\nEOF\ncat > game.js <<'EOF'\n// Tolled You So: a gothic co-op action RPG for the TV, on the Pixel Engine. Exports createGame(opts); starts the engine only when a page exists.\n// Pad: left stick moves, Cross/Square/Triangle/Circle/R1/R2 are skills, L2 dodges, L1 drinks. Keyboard: WASD, mouse, 1-4, Space, Q, E, I, K, M, T, F, Esc.\nimport { ENGINE_VERSION, Engine, LOOK_PRESETS, THREE, withUrlOptions } from './pixel-engine.js';\nimport { SKILLS } from './src/data/classes.js';\nimport { TITLE } from './src/data/meta.js';\nimport { Music, setupAudio } from './src/audio/music.js';\nimport { VoicePlayer } from './src/audio/voice.js';\nimport { Router } from './src/input/router.js';\nimport { Play } from './src/modes/play.js';\nimport { Shell } from './src/modes/shell.js';\nimport { blankSave, readSave, storage, writeSave } from './src/save/save.js';\nimport { saveCampaign, saveHero } from './src/sim/serialize.js';\nimport { SettingsScreen } from './src/ui/settings.js';\nimport { UI } from './src/ui/ui.js';\nimport { runHubFlow, runServerCopy } from './src/net/hubflow.js';\n\nexport const isTouchOnly = () => typeof matchMedia !== 'undefined' && typeof navigator !== 'undefined' && !matchMedia('(any-pointer: fine)').matches && navigator.maxTouchPoints > 0;\n\nexport class TolledYouSo {\n  name = TITLE;\n  constructor(opts = {}) { this.opts = opts; this.THREE = THREE; this.SKILLS = SKILLS; this.target = new THREE.Vector3(); this.menuOwner = null; this.touchOnly = !!opts.touchOnly; this.save = blankSave(); this.booted = false; this.testBot = !!opts.testBot; this.autoDismiss = !!opts.autoDismiss; }\n  get settingsV() { return this.settings.v; }\n  async setup(ctx) {\n    this.ctx = ctx; this.baseLook = { ...LOOK_PRESETS.none, scene: [{ id: 'vignette', params: { intensity: 0.3 } }] };\n    setupAudio(ctx, storage());\n    this.router = new Router(ctx, this);\n    this.ui = new UI(ctx, this.router);\n    this.voice = new VoicePlayer(ctx.audio);\n    this.music = new Music(ctx);\n    this.settings = new SettingsScreen(ctx, { ui: this.ui, voice: this.voice, settingsChanged: () => {} });\n    this.play = new Play(ctx, this);\n    this.shell = new Shell(ctx, this);\n    ctx.camera.teleport(this.target.set(10, 0.9, 10));\n    if (this.opts.session) { this.session = this.opts.session; await this.session.setup(this); }\n    else if (!this.opts.noSaveBoot) ctx.input.send({ save: readSave() });\n    else this.shell.boot(this.opts.save ?? blankSave());\n  }\n  ready() { if (typeof window !== 'undefined') window.__GAME__ = this; }\n  fixedUpdate(ctx, dt) {\n    if (this.session) { this.session.fixed(dt); return; }\n    this.shell.fixed(dt);\n  }\n  update(ctx, dt) {\n    const cmds = ctx.input.commands;\n    for (const c of cmds) if (c && c.save && !this.booted) { this.booted = true; this.shell.boot(c.save); }\n    if (typeof document !== 'undefined') this.cursor();\n    this.router.frame(cmds);\n    this.ui.begin();\n    if (this.session) { this.session.update(dt); return; }\n    this.shell.update(dt);\n  }\n  cursor() {\n    const dev = this.router.lastDevice; if (dev === this.cursorDev) return; this.cursorDev = dev;\n    const canvas = this.ctx.engine.gpu?.canvas ?? document.querySelector('canvas'); if (!canvas) return;\n    canvas.style.cursor = dev === 'pad' ? 'none' : gauntletCursor();\n  }\n  cameraTarget() { return this.play?.target ?? this.target; }\n  command(cmd, seat) { return this.play.command(cmd, seat); }\n  seatsOpenForMenu() { return false; }\n  padGone(pad) { const seat = this.router.padSeat[pad]; if (seat > 0 && this.play.world) this.play.hud.toast(`SEAT ${seat + 1}: THE PAD IS GONE.`, 'red'); this.router.release(pad); }\n  // Autosave on zone change, quest step, vendor close, and every 60 s. Sessions never save.\n  persist(force = false) {\n    if (this.session || this.opts.noPersist) return;\n    const s = this.save; const w = this.play?.world;\n    if (w && w.mode === 'campaign' && this.shell.state === 'play') {\n      const h = w.heroes[0]; const data = saveHero(h); data.campaign = { ...saveCampaign(w), bossKills: w.bossKills };\n      s.heroes[this.shell.heroSlot] = data; s.stash = w.stash; s.devotion = w.devotion; s.unlocks = w.unlocks; s.bests = w.bests; s.last = this.shell.heroSlot;\n    }\n    s.settings = this.settings.v;\n    if (force || !this.lastWrite || this.ctx.time - this.lastWrite > 1) { writeSave(s); this.lastWrite = this.ctx.time; }\n  }\n  status() { const w = this.play?.world; const st = this.shell?.state; if (!w) return `shell:${st}`; const h = w.heroes[0]; return `${st} zone:${w.zone?.id} level:${h?.level ?? 0} party:${w.heroes.filter((q) => !q.left).length} kills:${w.stats.kills}`; }\n  fingerprint() { return `${this.shell?.state}|${this.play?.fingerprint?.()}`; }\n}\nfunction gauntletCursor() {\n  const rows = ['..xx....', '.xwwx...', '.xwwx...', '.xwwxxx.', '.xwwwwwx', 'xxwwwwwx', 'xwwwwwwx', 'xwwwwwwx', '.xwwwwx.', '..xxxx..'];\n  const scale = 3; const svg = `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"${8 * scale}\" height=\"${10 * scale}\" shape-rendering=\"crispEdges\">${rows.flatMap((r, y) => [...r].map((c, x) => (c === '.' ? '' : `<rect x=\"${x * scale}\" y=\"${y * scale}\" width=\"${scale}\" height=\"${scale}\" fill=\"${c === 'x' ? '#1a1c2c' : '#ffcd75'}\"/>`))).join('')}</svg>`;\n  return `url(\"data:image/svg+xml;base64,${typeof btoa !== 'undefined' ? btoa(svg) : ''}\") 6 0, auto`;\n}\nexport const createGame = (opts = {}) => new TolledYouSo(opts);\n\nasync function startPage() {\n  const app = document.getElementById('app'); const touchOnly = isTouchOnly();\n  const options = withUrlOptions({ container: app, camera: { preset: 'iso', viewHeight: 11.5, pitch: 42, yaw: 45, minZoom: 0.6, maxZoom: 1.4 }, aspect: 'fill', quality: 'high', touch: false, settings: { button: touchOnly ? 'top-right' : false }, debugKeys: false });\n  // Sessions: straight into the round; no title, menus, attract or saves.\n  if (typeof AIHub !== 'undefined' && AIHub.active) {\n    const info = await AIHub.connect({ mode: 'shared-world', seats: [1, 4], card: true });\n    if (info) {\n      if (info.server) { await runServerCopy(info, createGame); return; }\n      await runHubFlow(info, createGame, options, noWebGpu);\n      return;\n    }\n  }\n  try { await Engine.start(createGame({ touchOnly }), options); } catch (e) { noWebGpu(e); }\n}\nfunction noWebGpu(e) {\n  const app = document.getElementById('app'); const d = document.createElement('div');\n  d.style.cssText = 'position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#1a1c2c;color:#ffcd75;font:20px monospace;text-align:center;padding:24px';\n  const t = document.createElement('h1'); t.textContent = TITLE; const p = document.createElement('p'); p.textContent = 'This game needs WebGPU: a recent Chrome or Edge, Safari 26, or Firefox on Windows';\n  d.append(t, p); (app ?? document.body).append(d);\n  if (typeof console !== 'undefined') console.warn('Engine failed to start', e?.message ?? e);\n}\nif (typeof document !== 'undefined') startPage();\nexport { ENGINE_VERSION };\nEOF\ncat > src/net/hubflow.js <<'EOF'\n// Placeholder removed in the net milestone below.\nEOF\necho ok","description":"Write shell, attract and game entry"}}}
