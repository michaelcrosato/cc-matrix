age,150); console.log(await step(page,1)); await shot(page,'tools/out/combat.png');\nawait page.evaluate(()=>{G.play.menus.push('hero',{tab:0})}); await step(page,3); await shot(page,'tools/out/gear.png');\nawait page.evaluate(()=>{G.play.menus.closeAll(); G.play.menus.push('hero',{tab:1})}); await step(page,3); await shot(page,'tools/out/skills.png');\nawait page.evaluate(()=>{G.play.menus.closeAll(); G.play.command({c:'dev',k:'boss',zone:'belfry_top'},0);G.play.bots[0]=true;}); await step(page,500); await shot(page,'tools/out/malison.png');\nconsole.log(errors.slice(0,5)); await browser.close();\nEOF\nnode tools/build.mjs --quiet; node tools/scratch/s3.mjs 2>&1 | cut -c1-300 | tail -3","description":"Rework title camera and capture key screens","timeout":300000}}}
