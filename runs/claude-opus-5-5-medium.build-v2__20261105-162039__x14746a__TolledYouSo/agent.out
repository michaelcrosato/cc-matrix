d":"cat >> ../PROGRESS.md <<'EOF'\n- Data (src/data) and sim (src/sim) written. tools/scratch/camp.mjs <cls> runs bot through campaign in pure sim: completes for bellwarden/sexton (~10 sim-min, needs balance). NEXT: view (src/view), ui, input, game.js, build, net, tests, exit interview.\nEOF\ncat > tools/scratch/clip.mjs <<'EOF'\nimport * as m from '../../pixel-engine.js';\nconst get=(n)=>m.HERO_CLIPS.find(c=>c.name===n);\nconsole.log(JSON.stringify(get('Slash1')).slice(0,700));\nconsole.log(JSON.stringify(get('Shout')).slice(0,500));\nconst w=get('Walk'); console.log(Object.keys(w), JSON.stringify(w.notes), w.frames, w.speed, w.stance);\nEOF\nnode tools/scratch/clip.mjs | cut -c1-800; sed -n '/interface GaitSpec/,/^### /p' API.md | sed -n '20,45p' | cut -c1-130; node -e \"\nimport('./pixel-engine.js').then(m=>{const b=m.buildModel('statue');console.log(b.bounds);console.log(Object.keys(m).filter(k=>/ragdoll|Layer|disposeObject|skyAt|applySky|CameraShake/i.test(k)))})\" | cut -c1-300","description":"Inspect engine clip format and gait options"}}}
