{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkfmjWXm66V3iQed4gjn","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":24695,"cache_read_input_tokens":308440,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":24695},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"69254de6-4061-470e-8e76-10f1ee96c6e5","uuid":"f3da59c1-18bc-4f91-b189-ec899facf4eb","timestamp":"2026-11-05T23:43:55.356Z","request_id":"req_011CgkfmjG9RFGye4TSh8CkV","thinking_duration_ms":2169,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkfmjWXm66V3iQed4gjn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BZAS2ZMdw8yMCSrvNjhoUA","name":"Bash","input":{"command":"cat > src/sim/commands.js <<'EOF'\n// Everything a menu or a remote player can ask the sim to do. Same path on every client: applyCommand(world, seat, cmd).\nimport { CLASSES, SKILLS } from '../data/classes.js';\nimport { CASKET_COST, CRAFT_COST, DEVOTION_TRACKS, GEM_IDS, INV_SIZE, LEGENDARY, LEGENDARIES, REFORGE_COST, SALVAGE, SETS, SET_FOR_CLASS, STASH_SIZE, AFFIX_IDS, AFFIXES } from '../data/items.js';\nimport { DIFFICULTIES, LEVEL_CAP, VOW_LEVELS } from '../data/tuning.js';\nimport { ZONES } from '../data/zones.js';\nimport { emit, enterZone, findOpenNear, near, partyLevel, setDifficulty } from './world.js';\nimport { autoAssignSkills, devotionPointsFree, levelUp, refresh, reviveHero, slotOpen, skillUnlocked, toneUnlocked, vowSlots, grantXp } from './hero.js';\nimport { canWear, itemValue, makeItem, rollAffix, rollLegendaryItem, rollSetItem } from './loot.js';\nimport { afterTalk, dialogFor, rollWrits, finishWrit, questFlag, visibleProp } from './quests.js';\nimport { addPyx, addProp, dropItem, removePyx, spawnPlate } from './rules.js';\nimport { killMonster, spawnElitePack, spawnMonster } from './monsters.js';\nimport { knellTolls, leaveKnell, startKnell } from './knell.js';\nimport { hasRope, useProp } from './step.js';\n\nconst heroOf = (w, seat) => w.heroes.find((h) => h.seat === seat && !h.left);\nconst findInv = (h, uid) => h.inv.findIndex((i) => i.uid === uid);\nexport const WEAPON_SLOTS = ['main'];\nexport const reliquaryKind = (slot) => (slot === 'main' || slot === 'off' ? 'weapon' : slot === 'amulet' || slot === 'ring' ? 'jewel' : 'armour');\n\nconst VENDOR_SLOTS = ['main', 'chest', 'head', 'feet', 'ring', 'amulet', 'hands', 'legs', 'off', 'shoulders'];\nexport function vendorStock(w, h) {\n  // Six rotating items for this hero; it rotates by level and by how much was bought.\n  const key = `${h.id}:${h.level}:${w.story.stock ?? 0}`;\n  if (h._stockKey !== key) {\n    h._stockKey = key;\n    const rng = w.root.fork(`stock:${key}`);\n    h._stock = [];\n    for (let i = 0; i < 6; i++) { const slot = VENDOR_SLOTS[(i + (w.story.stock ?? 0)) % VENDOR_SLOTS.length]; const it = makeItem(rng, { slot, rarity: i < 2 ? 'reliquary' : 'blessed', ilvl: h.level, cls: h.cls }); it.price = Math.round(itemValue(it) * 4); h._stock.push(it); }\n  }\n  return h._stock;\n}\n\nexport function applyCommand(w, seat, cmd) {\n  const h = heroOf(w, seat);\n  const ok = (msg) => { if (msg) emit(w, { t: 'toast', seat, text: msg, color: 'lime' }); emit(w, { t: 'sheet', seat }); return true; };\n  const fail = (msg) => { emit(w, { t: 'toast', seat, text: msg, color: 'red' }); emit(w, { t: 'sfx', id: 'ui_error' }); return false; };\n  if (!h && !['setTuning', 'resetTuning', 'dev'].includes(cmd.c)) return false;\n  switch (cmd.c) {\n    case 'equip': return equip(w, h, cmd.uid);\n    case 'equipNewest': { if (!h.newest) return false; const r = equip(w, h, h.newest); h.newest = null; return r; }\n    case 'unequip': { const it = h.gear[cmd.slot]; if (!it || h.inv.length >= INV_SIZE) return false; delete h.gear[cmd.slot]; h.inv.push(it); refresh(w, h); return ok(); }\n    case 'salvage': {\n      const i = findInv(h, cmd.uid); if (i < 0) return false;\n      const it = h.inv[i]; const pay = SALVAGE[it.rarity]; for (const k of Object.keys(pay)) h.mats[k] += pay[k];\n      h.inv.splice(i, 1); emit(w, { t: 'sfx', id: 'ui_salvage' }); h.counters = h.counters ?? {}; h.counters.salvaged = (h.counters.salvaged ?? 0) + 1;\n      return ok();\n    }\n    case 'sell': { const i = findInv(h, cmd.uid); if (i < 0) return false; const it = h.inv[i]; h.gold += itemValue(it); h.inv.splice(i, 1); emit(w, { t: 'sfx', id: 'gold' }); h.counters = h.counters ?? {}; h.counters.sold = (h.counters.sold ?? 0) + 1; return ok(); }\n    case 'drop': { const i = findInv(h, cmd.uid); if (i < 0) return false; const it = h.inv.splice(i, 1)[0]; dropItem(w, h.x, h.z, it, seat); w.drops.at(-1).t = -1.5; return ok(); }\n    case 'buy': {\n      const st = vendorStock(w, h); const it = st.find((s) => s.uid === cmd.uid); if (!it) return false;\n      if (h.gold < it.price) return fail('NOT ENOUGH GOLD. PENNYWHISTLE IS SORRY. HE IS NOT.');\n      if (h.inv.length >= INV_SIZE) return fail('YOUR PACK IS FULL.');\n      h.gold -= it.price; const copy = { ...it }; delete copy.price; h.inv.push(copy); st.splice(st.indexOf(it), 1); emit(w, { t: 'sfx', id: 'gold' });\n      h.counters = h.counters ?? {}; h.counters.bought = (h.counters.bought ?? 0) + 1;\n      return ok();\n    }\n    case 'casket': {\n      if (h.mats.shards < CASKET_COST.shards) return fail('A CASKET COSTS 3 BELL SHARDS.');\n      if (h.inv.length >= INV_SIZE) return fail('YOUR PACK IS FULL.');\n      h.mats.shards -= CASKET_COST.shards;\n      const rng = w.rngs.loot; const r = rng.next();\n      const it = r < 0.08 ? (rng.chance(0.5) && ['head', 'chest', 'hands', 'feet'].includes(cmd.slot) ? rollSetItem(rng, h.cls, h.level, cmd.slot) : legendaryForSlot(rng, h, cmd.slot)) : makeItem(rng, { slot: cmd.slot, rarity: r < 0.45 ? 'reliquary' : 'blessed', ilvl: h.level, cls: h.cls });\n      h.inv.push(it); emit(w, { t: 'upgrade', seat, uid: it.uid, name: it.name, rarity: it.rarity }); emit(w, { t: 'sfx', id: 'quest' });\n      h.counters = h.counters ?? {}; h.counters.caskets = (h.counters.caskets ?? 0) + 1;\n      return ok();\n    }\n    case 'craft': {\n      const cost = CRAFT_COST[cmd.rarity]; if (!cost) return false;\n      if (h.gold < (cost.gold ?? 0) || h.mats.scrap < (cost.scrap ?? 0) || h.mats.dust < (cost.dust ?? 0)) return fail('NOT ENOUGH MATERIALS, SHE SHOUTS.');\n      if (h.inv.length >= INV_SIZE) return fail('YOUR PACK IS FULL.');\n      h.gold -= cost.gold ?? 0; h.mats.scrap -= cost.scrap ?? 0; h.mats.dust -= cost.dust ?? 0;\n      const it = makeItem(w.rngs.loot, { slot: cmd.slot, rarity: cmd.rarity, ilvl: h.level, cls: h.cls }); h.inv.push(it); emit(w, { t: 'sfx', id: 'anvil' });\n      emit(w, { t: 'upgrade', seat, uid: it.uid, name: it.name, rarity: it.rarity });\n      h.counters = h.counters ?? {}; h.counters.crafted = (h.counters.crafted ?? 0) + 1;\n      return ok();\n    }\n    case 'reforge': {\n      const it = findAny(h, cmd.uid); if (!it || !it.affixes[cmd.index]) return false;\n      if (h.gold < REFORGE_COST.gold || h.mats.dust < REFORGE_COST.dust) return fail('2 DUST AND 80 GOLD, SHE SHOUTS.');\n      h.gold -= REFORGE_COST.gold; h.mats.dust -= REFORGE_COST.dust;\n      const exist = it.affixes.map((a) => a.k);\n      const pool = AFFIX_IDS.filter((k) => (!AFFIXES[k].slots || AFFIXES[k].slots.includes(it.slot)) && !exist.includes(k));\n      const k = w.rngs.loot.pick(pool); it.affixes[cmd.index] = rollAffix(w.rngs.loot, k, it.ilvl);\n      refresh(w, h); emit(w, { t: 'sfx', id: 'anvil' }); h.counters = h.counters ?? {}; h.counters.reforged = (h.counters.reforged ?? 0) + 1;\n      return ok();\n    }\n    case 'extract': {\n      const i = findInv(h, cmd.uid); if (i < 0) return false; const it = h.inv[i]; if (!it.power) return false;\n      const key = reliquaryKind(it.slot); h.reliquary[key] = it.power; h.known = h.known ?? []; if (!h.known.includes(it.power)) h.known.push(it.power);\n      h.inv.splice(i, 1); refresh(w, h); emit(w, { t: 'sfx', id: 'bell_small' }); h.counters = h.counters ?? {}; h.counters.extracted = (h.counters.extracted ?? 0) + 1;\n      return ok(`THE RELIQUARY HOLDS IT NOW: ${LEGENDARY[it.power].name}`);\n    }\n    case 'setRelic': { if (cmd.power && !(h.known ?? []).includes(cmd.power)) return false; h.reliquary[cmd.kind] = cmd.power; refresh(w, h); return ok(); }\n    case 'socket': {\n      const it = findAny(h, cmd.uid); if (!it) return false; const hasSocket = it.affixes.some((a) => a.k === 'socket'); if (!hasSocket) return fail('THAT HAS NO SOCKET.');\n      if (it.gem) { const back = `${it.gem.k}:${it.gem.tier}`; h.gems[back] = (h.gems[back] ?? 0) + 1; }\n      if ((h.gems[cmd.gem] ?? 0) <= 0) return fail('YOU HAVE NONE OF THOSE.');\n      h.gems[cmd.gem]--; const [k, tier] = cmd.gem.split(':'); it.gem = { k, tier: Number(tier) }; refresh(w, h); emit(w, { t: 'sfx', id: 'ui_equip' }); h.counters = h.counters ?? {}; h.counters.socketed = (h.counters.socketed ?? 0) + 1;\n      return ok();\n    }\n    case 'unsocket': { const it = findAny(h, cmd.uid); if (!it?.gem) return false; const back = `${it.gem.k}:${it.gem.tier}`; h.gems[back] = (h.gems[back] ?? 0) + 1; it.gem = null; refresh(w, h); return ok(); }\n    case 'merge': {\n      const [k, t] = cmd.gem.split(':'); const tier = Number(t); if (tier >= 2 || (h.gems[cmd.gem] ?? 0) < 3) return fail('THREE ALIKE, CHILD.');\n      h.gems[cmd.gem] -= 3; const next = `${k}:${tier + 1}`; h.gems[next] = (h.gems[next] ?? 0) + 1; emit(w, { t: 'sfx', id: 'bell_small' }); h.counters = h.counters ?? {}; h.counters.merged = (h.counters.merged ?? 0) + 1;\n      return ok();\n    }\n    case 'stashPut': { const tab = w.stash[cmd.tab]; if (!tab || tab.length >= STASH_SIZE) return fail('THAT TAB IS FULL.'); const i = findInv(h, cmd.uid); if (i < 0) return false; tab.push(h.inv.splice(i, 1)[0]); h.counters = h.counters ?? {}; h.counters.stashed = (h.counters.stashed ?? 0) + 1; return ok(); }\n    case 'stashTake': { const tab = w.stash[cmd.tab]; const i = tab?.findIndex((x) => x.uid === cmd.uid) ?? -1; if (i < 0) return false; if (h.inv.length >= INV_SIZE) return fail('YOUR PACK IS FULL.'); h.inv.push(tab.splice(i, 1)[0]); return ok(); }\n    case 'setSkill': {\n      if (!slotOpen(h, cmd.slot)) return false;\n      if (cmd.skill && (!SKILLS[cmd.skill] || SKILLS[cmd.skill].cls !== h.cls || !skillUnlocked(h, cmd.skill))) return false;\n      const other = h.slots.findIndex((s) => s.skill === cmd.skill);\n      if (other >= 0 && other !== cmd.slot) { const t = h.slots[other]; h.slots[other] = h.slots[cmd.slot]; h.slots[cmd.slot] = t; h.swap[other] = w.time + 1; }\n      else h.slots[cmd.slot] = { skill: cmd.skill, tone: h.slots[cmd.slot].skill === cmd.skill ? h.slots[cmd.slot].tone : null };\n      h.swap[cmd.slot] = w.time + 1;\n      return ok();\n    }\n    case 'setTone': {\n      const s = h.slots[cmd.slot]; if (!s?.skill) return false;\n      const sk = SKILLS[s.skill]; const keys = Object.keys(sk.tones);\n      if (cmd.tone && !toneUnlocked(h, sk, keys.indexOf(cmd.tone))) return false;\n      s.tone = cmd.tone; h.swap[cmd.slot] = w.time + 1; h.toneUse = h.toneUse ?? {}; h.toneUse[cmd.tone] = 1;\n      return ok();\n    }\n    case 'setVow': {\n      if (cmd.index >= vowSlots(h)) return false;\n      const other = h.vows.indexOf(cmd.vow); if (other >= 0 && other !== cmd.index) h.vows[other] = h.vows[cmd.index] ?? null;\n      h.vows[cmd.index] = cmd.vow; h.vows = h.vows.filter(Boolean); refresh(w, h); return ok();\n    }\n    case 'devotion': {\n      if (devotionPointsFree(w) <= 0 || !DEVOTION_TRACKS[cmd.track]) return false;\n      w.devotion.spent[cmd.track]++; for (const o of w.heroes) refresh(w, o); emit(w, { t: 'sfx', id: 'bell_small' }); return ok();\n    }\n    case 'difficulty': { const d = DIFFICULTIES[cmd.i]; if (!d) return false; if (d.locked && !w.unlocks.penance) return fail('PENANCE IS EARNED AFTER THE CREDITS.'); setDifficulty(w, cmd.i); emit(w, { t: 'toast', seat: -1, text: `DIFFICULTY: ${d.name}`, color: 'sand' }); return ok(); }\n    case 'travel': {\n      const z = cmd.zone; if (!ZONES[z] || (!w.story.lychgates.includes(z) && !cmd.dev)) return false;\n      if (w.knell && !cmd.dev) return false;\n      enterZone(w, z);\n      for (const o of w.heroes) if (o.dead) reviveHero(w, o, null, 1);\n      return true;\n    }\n    case 'talk': { const d = dialogFor(w, cmd.npc); if (d) afterTalk(w, d); return true; }\n    case 'bell': return w.hooksExtra?.passingBell?.(w, h) ?? false;\n    case 'respawn': {\n      if (!h.dead) return false;\n      if (cmd.how === 'here') { if (h.deadT < h.respawnWait) return false; reviveHero(w, h); }\n      else if (cmd.how === 'gate') { const g = w.props.find((p) => p.kind === 'lychgate') ?? w.zone.entrance; reviveHero(w, h, g); }\n      else { reviveHero(w, h, null, 1); if (w.zone.id !== 'town' && !w.knell) enterZone(w, 'town'); else if (w.knell) reviveHero(w, h, w.zone.entrance, 1); }\n      return true;\n    }\n    case 'knell': {\n      if (w.zone.id !== 'town') return false;\n      if (cmd.grand !== undefined && cmd.grand !== null) { if (h.mats.keys < 1) return fail('A GRAND KEY IS NEEDED.'); h.mats.keys--; startKnell(w, { grandTier: cmd.grand }); }\n      else startKnell(w);\n      return true;\n    }\n    case 'pick': return w.hooksExtra?.levelPick?.(w, h, cmd.i) ?? false;\n    case 'writs': { if (!w.story.writs) rollWrits(w); return true; }\n    case 'addPyx': { addPyx(w); return true; }\n    case 'removePyx': { removePyx(w); return true; }\n    case 'readLore': { w.lore[cmd.id] = 1; return true; }\n    case 'quitKnell': { leaveKnell(w); enterZone(w, 'town'); return true; }\n    case 'dev': return devCommand(w, h, cmd);\n    default: return false;\n  }\n}\nfunction legendaryForSlot(rng, h, slot) {\n  const pool = LEGENDARIES.filter((l) => l.slot === slot && (!l.cls || l.cls === h.cls));\n  if (!pool.length) return makeItem(rng, { slot, rarity: 'reliquary', ilvl: h.level, cls: h.cls });\n  return makeItem(rng, { legendary: rng.pick(pool).id, ilvl: h.level, cls: h.cls });\n}\nconst findAny = (h, uid) => h.inv.find((i) => i.uid === uid) ?? Object.values(h.gear).find((i) => i?.uid === uid);\nexport function equip(w, h, uid) {\n  const i = findInv(h, uid); if (i < 0) return false;\n  const it = h.inv[i]; if (!canWear(it, h)) { emit(w, { t: 'toast', seat: h.seat, text: 'NOT FOR YOUR TRADE.', color: 'red' }); return false; }\n  const old = h.gear[it.slot]; h.gear[it.slot] = it; h.inv.splice(i, 1); if (old) h.inv.push(old);\n  refresh(w, h); h.hp = Math.min(h.hp, h.stats.maxHp);\n  emit(w, { t: 'equip', id: h.id, seat: h.seat, slot: it.slot, uid: it.uid, model: it.model, base: it.base, rarity: it.rarity, set: it.set });\n  emit(w, { t: 'sheet', seat: h.seat }); emit(w, { t: 'sfx', id: 'ui_equip' }); emit(w, { t: 'tutorial', seat: h.seat, id: 'equip' });\n  if (it.power || it.set) { h.equippedSpecial = (h.equippedSpecial ?? 0) + 1; }\n  return true;\n}\n\n// Dev tools. Each one is used by the dev-mode screen and tested.\nfunction devCommand(w, h, cmd) {\n  const c = cmd.k; const rng = w.rngs.loot;\n  switch (c) {\n    case 'cheat': w.cheats[cmd.id] = !w.cheats[cmd.id]; return true;\n    case 'levelup': if (h.level < LEVEL_CAP) { levelUp(w, h); } return true;\n    case 'level30': while (h.level < LEVEL_CAP) levelUp(w, h); autoAssignSkills(h); return true;\n    case 'gold': h.gold += 10000; return true;\n    case 'mats': h.mats.scrap += 200; h.mats.dust += 100; h.mats.shards += 50; h.mats.keys += 3; return true;\n    case 'item': { const it = makeItem(rng, { slot: cmd.slot, rarity: cmd.rarity, ilvl: h.level, cls: h.cls }); h.inv.push(it); return true; }\n    case 'legendary': { const it = makeItem(rng, { legendary: cmd.id, ilvl: h.level, cls: h.cls }); h.inv.push(it); return true; }\n    case 'set': { const s = SETS[cmd.id ?? SET_FOR_CLASS[h.cls]]; for (const slot of Object.keys(s.pieces)) h.inv.push(makeItem(rng, { slot, set: s.id, ilvl: h.level, cls: s.cls })); return true; }\n    case 'gems': for (const g of GEM_IDS) for (let t = 0; t < 3; t++) h.gems[`${g}:${t}`] = (h.gems[`${g}:${t}`] ?? 0) + 3; return true;\n    case 'spawn': { const p = findOpenNear(w, h.x + 5 * Math.sin(h.facing), h.z + 5 * Math.cos(h.facing)); spawnMonster(w, cmd.type, p.x, p.z, { dormant: false, aggro: true }); return true; }\n    case 'elite': { const p = findOpenNear(w, h.x + 6 * Math.sin(h.facing), h.z + 6 * Math.cos(h.facing)); const types = (w.zone.spec.monsters.length ? w.zone.spec.monsters : ['peatwalker']).filter((t) => t !== 'pallid_bearer'); spawnElitePack(w, p.x, p.z, cmd.kind ?? 'champion', cmd.affl ?? null, types, { dormant: false, aggro: true }); return true; }\n    case 'plate': spawnPlate(w, h.x + 4, h.z, { dormant: false, aggro: true }); return true;\n    case 'coffin': { const p = findOpenNear(w, h.x + 3, h.z); const pr = addProp(w, { kind: 'coffin', x: p.x, z: p.z, model: 'coffin', interact: true, label: 'UNQUIET COFFIN' }); emit(w, { t: 'propadd', id: pr.id, kind: 'coffin', x: pr.x, z: pr.z, model: 'coffin', label: pr.label }); return true; }\n    case 'killall': for (const m of [...w.monsters]) if (!m.dead && !m.dormant) { m.hp = 0; if (m.defn.boss && m.defn.boss !== 'bursar' && m.bossState) m.bossState.round = 3, m.bossState.phase = 3; killMonster(w, m, h, {}); } return true;\n    case 'boss': { const z = cmd.zone; applyCommand(w, h.seat, { c: 'travel', zone: z, dev: true }); return true; }\n    case 'quest': { w.story.q = cmd.q; w.story.step = cmd.step ?? 0; emit(w, { t: 'quest', name: 'DEV', text: 'QUEST JUMP' }); return true; }\n    case 'knellStart': if (!w.knell) { startKnell(w); } return true;\n    case 'knellFill': if (w.knell && w.knell.stage === 'fill') { knellTolls(w); } return true;\n    case 'difficulty': setDifficulty(w, (w.difficulty + 1) % DIFFICULTIES.length); return true;\n    case 'reseed': { w.root = w.root.fork(`dev:${w.tick}`); w.zoneCache.clear(); const id = w.zone.id; w.zone = null; enterZone(w, id); return true; }\n    case 'reveal': if (w.zone.explored) w.zone.explored.fill(1); return true;\n    case 'nextphase': { const m = w.boss?.m; if (!m) return false; const b = m.bossState; if (m.defn.boss === 'malison') { m.invulnerable = false; if (b.phase === 1) m.hp = m.maxHp * 0.59; else if (b.phase === 2) m.hp = m.maxHp * 0.24; else { w.hooks.devRing?.(w, h); } } else if (m.defn.boss === 'ambrose') { m.hp = b.round === 1 ? m.maxHp * 0.65 : m.maxHp * 0.32; } else m.hp = m.maxHp * 0.29; return true; }\n    default: return false;\n  }\n}\nexport { CLASSES, VOW_LEVELS, partyLevel, near, grantXp, visibleProp, finishWrit, questFlag, hasRope, useProp, rollLegendaryItem };\nEOF\ncat > src/sim/step.js <<'EOF'\n// stepWorld: one 60 Hz step of the whole world. Deterministic: same seed and intents, same hash.\nimport { CLASSES } from '../data/classes.js';\nimport { LORE } from '../data/lore.js';\nimport { SHRINES } from '../data/monsters.js';\nimport { DT, emit, enterZone, findOpenNear, near, nearestHero, createWorld, walkable, livingHeroes } from './world.js';\nimport { addBuff, autoAssignSkills, grantXp, levelUp, makeHero, refresh, reviveHero, starterGear, stepHero } from './hero.js';\nimport { stepFields, stepProjectiles } from './effects.js';\nimport { separation, stepBeams, stepGraves, stepMonster, stepRequiem, stepTelegraphs, wake } from './monsters.js';\nimport { HOOKS, addProp, dropItem, grantGem, stepAllies, stepDrops, dropGold, goldAmount } from './rules.js';\nimport { dialogFor, openCoffin, stepQuests, visibleProp, afterTalk, finishWrit } from './quests.js';\nimport { stepKnell } from './knell.js';\nimport { ringRope } from './bosses.js';\nimport { makeItem } from './loot.js';\nimport { stepRound } from './round.js';\nimport { applyCommand } from './commands.js';\n\nexport function newWorld(opts = {}) {\n  const w = createWorld(opts);\n  w.hooks = { ...HOOKS, bonusXp: (w2, h, n) => grantXp(w2, h, n), grantLevel: (w2, h) => levelUp(w2, h), devRing: (w2, h) => { const r = w2.props.find((p) => p.kind === 'rope' && !p.used); if (r) ringRope(w2, r, h); } };\n  w.hooksExtra = { passingBell, levelPick: (w2, h, i) => w2.hooks.levelPick?.(w2, h, i) };\n  w.hooks.levelUp = (w2, h) => { w2.hooks.levelPickQueue?.(w2, h); };\n  return w;\n}\n\nexport function addHero(w, o) {\n  const h = makeHero(w, o);\n  if (!o.gear) starterGear(w, h, Math.max(1, (o.level ?? 1) - 1));\n  autoAssignSkills(h);\n  refresh(w, h); h.hp = h.stats.maxHp;\n  w.heroes.push(h);\n  if (w.zone) { const p = findOpenNear(w, w.heroes[0].x + 1, w.heroes[0].z + 1); h.x = p.x; h.z = p.z; h.px = h.x; h.pz = h.z; }\n  return h;\n}\n\nexport function hasRope(w) { return w.props.some((p) => p.kind === 'rope' && !p.used); }\n\nconst EMPTY = { moveX: 0, moveZ: 0, pressed: {}, held: {} };\nexport function stepWorld(w, intents) {\n  w.tick++; w.time += DT;\n  // Timers fire before everything else moves.\n  if (w.timers.length) { const due = w.timers.filter((t) => t.at <= w.time); if (due.length) { w.timers = w.timers.filter((t) => t.at > w.time); for (const t of due) t.fn(); } }\n  // Flow fields follow each seat; dormant packs wake within 30 m.\n  for (const h of w.heroes) if (!h.left && !h.dead) w.navs[h.seat % 4].flowTo(h.x, h.z);\n  if (w.tick % 20 === 0) for (const m of w.monsters) if (m.dormant) { for (const h of w.heroes) if (!h.left && near(h, m.x, m.z, 30)) { wake(w, m); break; } }\n  w.active = w.monsters.filter((m) => !m.dead && !m.dormant);\n  for (const h of w.heroes) {\n    const it = intents[h.seat] ?? EMPTY;\n    stepHero(w, h, it);\n    stepInteract(w, h, it);\n    if (!walkable(w, h.x, h.z) && !w.cheats.noClip && !h.moveDash) { const p = findOpenNear(w, h.x, h.z); h.x = p.x; h.z = p.z; }\n    if (w.tick % 15 === 0 && w.zone.explored) reveal(w, h);\n  }\n  for (const m of w.active) if (!m.dead) stepMonster(w, m);\n  if (w.tick % 2 === 0) separation(w);\n  stepAllies(w);\n  stepProjectiles(w);\n  stepFields(w);\n  stepTelegraphs(w);\n  stepBeams(w);\n  stepTraps(w);\n  stepDrops(w);\n  stepGraves(w);\n  stepRequiem(w);\n  stepQuests(w);\n  stepKnell(w);\n  stepRound(w);\n  if (w.tick % 300 === 0) w.monsters = w.monsters.filter((m) => !m.dead || m.defn.boss);\n}\nfunction reveal(w, h) {\n  const z = w.zone; const R = 11; const cx = Math.floor(h.x); const cz = Math.floor(h.z);\n  for (let y = Math.max(0, cz - R); y <= Math.min(z.h - 1, cz + R); y++) for (let x = Math.max(0, cx - R); x <= Math.min(z.w - 1, cx + R); x++) if ((x - cx) ** 2 + (y - cz) ** 2 <= R * R) z.explored[y * z.w + x] = 1;\n}\nfunction stepTraps(w) {\n  for (const p of w.props) {\n    if (p.kind !== 'trap') continue;\n    p.cycle -= DT;\n    if (p.cycle <= 0) {\n      p.cycle = 4;\n      if (!w.heroes.some((h) => !h.left && near(h, p.x, p.z, 16))) continue;\n      w.hooks.trapFire?.(w, p);\n      emit(w, { t: 'trap', id: p.id });\n      w.hooks.telegraph?.(w, { kind: 'circle', x: p.x, z: p.z, r: 1.3, dur: 0.7, dmg: 8 + w.zone.spec.levelFloor * 6, level: w.zone.spec.levelFloor, name: 'A FLOOR TRAP', sfx: 'spikes' });\n    }\n  }\n}\n\n// Interaction: tap when something's close and no hostile within 4 m, or hold always. The router decides; the intent says.\nexport const INTERACT_R = 2.2;\nexport function interactTarget(w, h, cycle = 0) {\n  const list = w.props.filter((p) => p.interact && !p.used && visibleProp(w, p) && near(p, h.x, h.z, INTERACT_R + (p.r ?? 1) * 0.6));\n  list.sort((a, b) => Math.hypot(a.x - h.x, a.z - h.z) - Math.hypot(b.x - h.x, b.z - h.z));\n  for (const o of w.heroes) if (o !== h && o.dead && !o.left && near(o, h.x, h.z, 2.5)) list.unshift({ kind: 'revive', hero: o, x: o.x, z: o.z, label: `REVIVE ${o.name}`, hold: 2, id: -o.id });\n  if (!list.length) return null;\n  return list[cycle % list.length];\n}\nfunction stepInteract(w, h, it) {\n  if (h.dead || h.left) return;\n  if (h.state === 'dodge') return;\n  const target = it.interactId !== undefined ? (w.props.find((p) => p.id === it.interactId && p.interact && !p.used && near(p, h.x, h.z, INTERACT_R + (p.r ?? 1))) ?? null) : interactTarget(w, h, it.cycle ?? 0);\n  h.interactTarget = target;\n  if (!target) { if (h.channel?.kind === 'hold') h.channel = null; return; }\n  if (target.hold) {\n    if (it.held?.interact) {\n      if (!h.channel) h.channel = { kind: 'hold', t: 0, dur: target.hold, hold: 'interact', target, done: (w2, he) => useProp(w2, he, target) };\n    } else if (h.channel?.kind === 'hold') h.channel = null;\n    return;\n  }\n  if (it.pressed?.interact) useProp(w, h, target);\n}\n\nexport function useProp(w, h, p) {\n  emit(w, { t: 'tutorial', seat: h.seat, id: 'interact' });\n  switch (p.kind) {\n    case 'revive': reviveHero(w, p.hero, null, 0.5); h.revives++; emit(w, { t: 'toast', seat: -1, text: `${p.hero.name} IS UP AGAIN.`, color: 'lime' }); break;\n    case 'chest': {\n      p.used = true; emit(w, { t: 'chest', id: p.id, x: p.x, z: p.z }); emit(w, { t: 'sfx', id: 'chest', x: p.x, z: p.z });\n      for (const he of w.heroes) { if (he.left) continue; for (let i = 0; i < (p.rich ? 10 : 5); i++) dropGold(w, p.x, p.z, goldAmount(w, 1.2), 2, he.seat); dropItem(w, p.x, p.z, makeItem(w.rngs.loot, { rarity: p.rich || w.rngs.loot.chance(0.3) ? 'reliquary' : 'blessed', ilvl: Math.max(he.level, w.zone.spec.levelFloor), cls: he.cls }), he.seat); if (p.rich) grantGem(w, he, p.x, p.z); }\n      break;\n    }\n    case 'shrine': {\n      p.used = true; const s = SHRINES[p.shrine];\n      for (const he of w.heroes) { if (he.left) continue; he.shrines = (he.shrines ?? 0) + 1;\n        if (p.shrine === 'ardour') addBuff(w, he, { id: 'ardour', dur: 30, dmg: 0.5 });\n        if (p.shrine === 'haste') addBuff(w, he, { id: 'haste', dur: 30, speed: 0.3 });\n        if (p.shrine === 'ward') { he.shield = he.stats.maxHp * 0.3; addBuff(w, he, { id: 'ward', dur: 30, shield: true }); }\n        if (p.shrine === 'plenty') addBuff(w, he, { id: 'plenty', dur: 30 });\n      }\n      emit(w, { t: 'shrine', id: p.id, x: p.x, z: p.z }); emit(w, { t: 'toast', seat: -1, text: `${s.name}: ${s.desc}`, color: s.color, big: true }); emit(w, { t: 'sfx', id: 'shrine' });\n      break;\n    }\n    case 'coffin': openCoffin(w, p); for (const j of w.story.writs ?? []) if (!j.done && j.kind === 'coffin' && j.zone === w.zone.id) finishWrit(w, j); break;\n    case 'exit': {\n      if (p.to === 'town' && w.knell && w.knell.stage === 'done') { w.knell = null; emit(w, { t: 'knell', on: false }); }\n      enterZone(w, p.to, p.at ?? exitAt(w, p));\n      for (const o of w.heroes) if (o.dead) reviveHero(w, o, null, 1);\n      emit(w, { t: 'save' });\n      break;\n    }\n    case 'lychgate': {\n      emit(w, { t: 'open', seat: h.seat, screen: 'map', travel: true }); h.lychUsed = (h.lychUsed ?? 0) + 1;\n      break;\n    }\n    case 'lever': {\n      p.used = true; const port = w.props.find((o) => o.id === p.port);\n      if (port) { w.zone.nav.setOpen(port.col, port.row, true); for (const n of w.navs) n.setOpen(port.col, port.row, true); port.gone = true; port.interact = false; emit(w, { t: 'portcullis', id: port.id, x: port.x, z: port.z }); }\n      emit(w, { t: 'sfx', id: 'lever', x: p.x, z: p.z }); emit(w, { t: 'lever', id: p.id }); h.levers = (h.levers ?? 0) + 1;\n      break;\n    }\n    case 'relic': { p.used = true; w.story.flags[`relic_${p.relic}`] = true; emit(w, { t: 'toast', seat: -1, text: \"A PIECE OF SAINT GLOAM. IT IS WARM.\", color: 'orange', big: true }); emit(w, { t: 'sfx', id: 'bell_small' }); emit(w, { t: 'relic', id: p.id }); emit(w, { t: 'save' }); break; }\n    case 'npc': { const d = dialogFor(w, p.npc); emit(w, { t: 'npc', seat: h.seat, npc: p.npc, d, id: p.id }); h.talked = h.talked ?? {}; h.talked[p.npc] = 1; break; }\n    case 'stash': emit(w, { t: 'open', seat: h.seat, screen: 'stash' }); break;\n    case 'knellfont': emit(w, { t: 'open', seat: h.seat, screen: 'knell' }); break;\n    case 'writs': emit(w, { t: 'open', seat: h.seat, screen: 'writs' }); break;\n    case 'lore': { w.lore[p.lore] = 1; emit(w, { t: 'open', seat: h.seat, screen: 'lore', lore: p.lore }); emit(w, { t: 'loreread', id: p.lore, title: LORE[p.lore].title }); break; }\n    case 'book': { p.used = true; w.story.flags.overdueBook = true; emit(w, { t: 'toast', seat: -1, text: 'THE OVERDUE BOOK. THE CRIER WILL WANT THIS.', color: 'sand', big: true }); emit(w, { t: 'relic', id: p.id }); break; }\n    case 'novices': { p.used = true; w.novices = { x: p.x, z: p.z, t: 45, waveT: 1, active: true }; emit(w, { t: 'defend', on: true, dur: 45 }); emit(w, { t: 'say', who: 'pyx', text: 'Bless you. Duck.' }); emit(w, { t: 'toast', seat: -1, text: 'HOLD HERE FOR 45 SECONDS.', color: 'sand', big: true }); break; }\n    case 'rope': { p.used = true; ringRope(w, p, h); break; }\n    case 'classfont': { w.hooks.classFontUse?.(w, h, p); break; }\n    case 'portal': { p.used = true; const r = w.returnTo; w.returnTo = null; const pid = p.id; w.props = w.props.filter((o) => o.id !== pid); emit(w, { t: 'propgone', id: pid }); enterZone(w, r.zone, { x: r.x, z: r.z }); break; }\n    default: break;\n  }\n}\nfunction exitAt(w, p) {\n  // Coming back up leaves you by the stairs you went down.\n  const c = w.zoneCache.get(p.to);\n  if (c) { const back = c.props.find((o) => o.kind === 'exit' && o.to === w.zone.id); if (back) return { x: back.x + 1.5, z: back.z + 1 }; }\n  return null;\n}\n\n// The Passing Bell: a portal to town and back. Not in Knell Runs or sessions.\nexport function passingBell(w, h) {\n  if (w.knell || w.round || w.mode !== 'campaign') return false;\n  if (w.zone.id === 'town' || w.zone.spec.boss && w.boss) return false;\n  w.returnTo = { zone: w.zone.id, x: h.x, z: h.z };\n  enterZone(w, 'town');\n  const t = w.zone.marks.find((m) => m.kind === 'r');\n  const pr = addProp(w, { kind: 'portal', x: t.x, z: t.z, model: 'portal', interact: true, label: 'THE PASSING BELL: BACK', r: 1.3 });\n  emit(w, { t: 'propadd', id: pr.id, kind: 'portal', x: pr.x, z: pr.z, model: 'portal', label: pr.label });\n  h.bellUsed = (h.bellUsed ?? 0) + 1;\n  emit(w, { t: 'sfx', id: 'bell_small' });\n  return true;\n}\n\nexport function simHash(w) {\n  let n = (w.tick * 31 + w.nextId) | 0;\n  const mix = (v) => { n = (Math.imul(n, 16777619) ^ Math.round(v * 16)) | 0; };\n  for (const h of w.heroes) { mix(h.x); mix(h.z); mix(h.hp); mix(h.level); mix(h.gold); }\n  for (const m of w.monsters) { if (m.dead) continue; mix(m.id); mix(m.x); mix(m.z); mix(m.hp); }\n  mix(w.drops.length); mix(w.rngs.loot.state); mix(w.rngs.combat.state);\n  return n >>> 0;\n}\nexport { applyCommand, CLASSES, nearestHero, livingHeroes, createWorld };\nEOF\ncat > src/sim/round.js <<'EOF'\n// The AI Hub round: one 8-minute Knell Run with a Warden for everybody seated.\nimport { CLASSES, CLASS_IDS, SKILLS, toneUnlockLevel } from '../data/classes.js';\nimport { DT, emit, enterZone } from './world.js';\nimport { levelUp, refresh, slotOpen } from './hero.js';\nimport { addProp } from './rules.js';\nimport { startKnell } from './knell.js';\nimport { makeItem } from './loot.js';\n\nexport const SEAT_CLASS = ['bellwarden', 'lamplighter', 'sexton', 'bellwarden'];\nexport function presetHero(w, h) {\n  // Level 12, every slot filled from the class preset, a plain gear set.\n  while (h.level < 12) levelUp(w, h);\n  const skills = CLASSES[h.cls].skills.filter((s) => s.level <= 12);\n  h.slots = skills.slice(0, 6).map((s) => ({ skill: s.id, tone: null }));\n  while (h.slots.length < 6) h.slots.push({ skill: null, tone: null });\n  h.gear = {};\n  for (const slot of ['main', 'chest', 'head', 'hands', 'legs', 'feet']) h.gear[slot] = makeItem(w.rngs.loot, { slot, rarity: 'common', ilvl: 11, cls: h.cls });\n  h.vows = [CLASSES[h.cls].vows[0].id];\n  h.xp = 0; h.gold = 0; h.inv = [];\n  refresh(w, h); h.hp = h.stats.maxHp; h.res = h.stats.maxResource * 0.5;\n}\nexport function swapClass(w, h, cls) {\n  h.cls = cls; h._skillCache = null; presetHero(w, h); emit(w, { t: 'classswap', id: h.id, seat: h.seat, cls });\n}\nexport function setupRound(w, players) {\n  w.round = { players, t: 0, started: false, wardenDead: false, timeUp: false, swapUntil: 30 };\n  w.hooks.classFonts = (w2, z) => {\n    const e = z.entrance;\n    CLASS_IDS.forEach((c, i) => { addProp(w2, { kind: 'classfontspot', x: e.x - 3 + i * 3, z: e.z + 3, cls: c, model: 'knell_font', r: 1, label: CLASSES[c].name }); });\n  };\n  w.hooks.levelPickQueue = (w2, h) => {\n    if (h.level <= 12) return;\n    const opts = rollPicks(w2, h);\n    h.levelPicks.push({ opts, t: 10 });\n    emit(w2, { t: 'picks', seat: h.seat });\n  };\n  w.hooks.levelPick = (w2, h, i) => { const p = h.levelPicks[0]; if (!p) return false; applyPick(w2, h, p.opts[i] ?? p.opts[0]); h.levelPicks.shift(); return true; };\n  startKnell(w, { session: true });\n}\nfunction rollPicks(w, h) {\n  const rng = w.rngs.quest; const out = [];\n  const usable = h.slots.filter((s) => s.skill && !s.tone);\n  const toneSlot = usable.length ? rng.pick(usable) : null;\n  if (toneSlot) { const sk = SKILLS[toneSlot.skill]; const keys = Object.keys(sk.tones); const t = rng.pick(keys); out.push({ kind: 'tone', skill: sk.id, tone: t, label: `${sk.name}: ${sk.tones[t].name}` }); }\n  if (h.vows.length < 2) { const left = CLASSES[h.cls].vows.filter((v) => !h.vows.includes(v.id)); const v = rng.pick(left); out.push({ kind: 'vow', id: v.id, label: `VOW: ${v.name}` }); }\n  const stats = [{ k: 'power', label: '+15 POWER', v: 15 }, { k: 'vitality', label: '+15 VITALITY', v: 15 }, { k: 'crit', label: '+5% CRIT', v: 5 }, { k: 'atkSpd', label: '+8% ATTACK SPEED', v: 8 }];\n  rng.shuffle(stats);\n  for (const s of stats) { if (out.length >= 3) break; out.push({ kind: 'stat', ...s }); }\n  return out.slice(0, 3);\n}\nfunction applyPick(w, h, o) {\n  if (o.kind === 'tone') { const s = h.slots.find((x) => x.skill === o.skill); if (s) s.tone = o.tone; }\n  if (o.kind === 'vow') h.vows.push(o.id);\n  if (o.kind === 'stat') { const g = h.gear.main; g.affixes.push({ k: o.k, v: o.v }); }\n  refresh(w, h);\n  emit(w, { t: 'toast', seat: h.seat, text: o.label, color: 'sand' });\n}\nexport function stepRound(w) {\n  const r = w.round; if (!r) return;\n  r.t += DT;\n  // The class fonts in the first room: stand on one for 2 s to swap, until play has run 30 s.\n  if (r.t < r.swapUntil) {\n    for (const h of w.heroes) {\n      if (h.left || h.dead) continue;\n      const f = w.props.find((p) => p.kind === 'classfontspot' && p.cls !== h.cls && Math.hypot(p.x - h.x, p.z - h.z) < 1.2);\n      if (f) { h.fontT = (h.fontT ?? 0) + DT; if (h.fontT >= 2) { h.fontT = 0; swapClass(w, h, f.cls); } } else h.fontT = 0;\n    }\n  }\n  for (const h of w.heroes) {\n    if (h.levelPicks.length) { const p = h.levelPicks[0]; p.t -= DT; if (p.t <= 0) w.hooks.levelPick(w, h, 0); }\n    if (h.dead && h.deadT >= 8) { h.dead = false; h.hp = h.stats.maxHp * 0.6; h.state = 'idle'; h.invulnerable = 2; const a = w.heroes.find((o) => !o.dead && !o.left && o !== h); if (a) { h.x = a.x; h.z = a.z; h.px = a.x; h.pz = a.z; } emit(w, { t: 'revive', id: h.id, x: h.x, z: h.z }); }\n  }\n}\nexport const scoreOf = (h) => h.damage / 100 + 50 * h.revives + 20 * h.eliteKills - 30 * h.deaths;\nexport { slotOpen, toneUnlockLevel, enterZone };\nEOF\ncat > tools/scratch/sim1.mjs <<'EOF'\nimport { newWorld, addHero, stepWorld, simHash } from '../../src/sim/step.js';\nimport { enterZone } from '../../src/sim/world.js';\nconst w=newWorld({seed:5}); const h=addHero(w,{seat:0,cls:'bellwarden'});\nenterZone(w,'yard'); w.events.length=0;\nlet t=Date.now();\nfor(let i=0;i<3600;i++){ const m=w.active.filter(x=>!x.dead).sort((a,b)=>Math.hypot(a.x-h.x,a.z-h.z)-Math.hypot(b.x-h.x,b.z-h.z))[0]; let it={moveX:0,moveZ:0,pressed:{},held:{}}; if(m){const dx=m.x-h.x,dz=m.z-h.z,d=Math.hypot(dx,dz); it.aimX=dx/d;it.aimZ=dz/d; if(d>2){it.moveX=dx/d;it.moveZ=dz/d}else it.held={s0:true}; } else {it.moveX=1;} stepWorld(w,{0:it}); w.events.length=0; }\nconsole.log('kills',w.stats.kills,'lvl',h.level,'gold',h.gold,'x',h.x.toFixed(1),'hp',h.hp|0,'quest',w.story.q,w.story.step,Date.now()-t,'ms',simHash(w));\nEOF\nnode tools/scratch/sim1.mjs 2>&1 | cut -c1-400 | tail -12","description":"Write commands, step and round modules, smoke test sim"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":24695,"cache_read_input_tokens":308440,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":24695},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"69254de6-4061-470e-8e76-10f1ee96c6e5","uuid":"d4ef8074-b784-445a-bef8-235b67060f33","timestamp":"2026-11-05T23:46:02.950Z","request_id":"req_011CgkfmjG9RFGye4TSh8CkV","wire_tool_inputs":{"toolu_01BZAS2ZMdw8yMCSrvNjhoUA":{"command":"cat > src/sim/commands.js <<'EOF'\n// Everything a menu or a remote player can ask the sim to do. Same path on every client: applyCommand(world, seat, cmd).\nimport { CLASSES, SKILLS } from '../data/classes.js';\nimport { CASKET_COST, CRAFT_COST, DEVOTION_TRACKS, GEM_IDS, INV_SIZE, LEGENDARY, LEGENDARIES, REFORGE_COST, SALVAGE, SETS, SET_FOR_CLASS, STASH_SIZE, AFFIX_IDS, AFFIXES } from '../data/items.js';\nimport { DIFFICULTIES, LEVEL_CAP, VOW_LEVELS } from '../data/tuning.js';\nimport { ZONES } from '../data/zones.js';\nimport { emit, enterZone, findOpenNear, near, partyLevel, setDifficulty } from './world.js';\nimport { autoAssignSkills, devotionPointsFree, levelUp, refresh, reviveHero, slotOpen, skillUnlocked, toneUnlocked, vowSlots, grantXp } from './hero.js';\nimport { canWear, itemValue, makeItem, rollAffix, rollLegendaryItem, rollSetItem } from './loot.js';\nimport { afterTalk, dialogFor, rollWrits, finishWrit, questFlag, visibleProp } from './quests.js';\nimport { addPyx, addProp, dropItem, removePyx, spawnPlate } from './rules.js';\nimport { killMonster, spawnElitePack, spawnMonster } from './monsters.js';\nimport { knellTolls, leaveKnell, startKnell } from './knell.js';\nimport { hasRope, useProp } from './step.js';\n\nconst heroOf = (w, seat) => w.heroes.find((h) => h.seat === seat && !h.left);\nconst findInv = (h, uid) => h.inv.findIndex((i) => i.uid === uid);\nexport const WEAPON_SLOTS = ['main'];\nexport const reliquaryKind = (slot) => (slot === 'main' || slot === 'off' ? 'weapon' : slot === 'amulet' || slot === 'ring' ? 'jewel' : 'armour');\n\nconst VENDOR_SLOTS = ['main', 'chest', 'head', 'feet', 'ring', 'amulet', 'hands', 'legs', 'off', 'shoulders'];\nexport function vendorStock(w, h) {\n  // Six rotating items for this hero; it rotates by level and by how much was bought.\n  const key = `${h.id}:${h.level}:${w.story.stock ?? 0}`;\n  if (h._stockKey !== key) {\n    h._stockKey = key;\n    const rng = w.root.fork(`stock:${key}`);\n    h._stock = [];\n    for (let i = 0; i < 6; i++) { const slot = VENDOR_SLOTS[(i + (w.story.stock ?? 0)) % VENDOR_SLOTS.length]; const it = makeItem(rng, { slot, rarity: i < 2 ? 'reliquary' : 'blessed', ilvl: h.level, cls: h.cls }); it.price = Math.round(itemValue(it) * 4); h._stock.push(it); }\n  }\n  return h._stock;\n}\n\nexport function applyCommand(w, seat, cmd) {\n  const h = heroOf(w, seat);\n  const ok = (msg) => { if (msg) emit(w, { t: 'toast', seat, text: msg, color: 'lime' }); emit(w, { t: 'sheet', seat }); return true; };\n  const fail = (msg) => { emit(w, { t: 'toast', seat, text: msg, color: 'red' }); emit(w, { t: 'sfx', id: 'ui_error' }); return false; };\n  if (!h && !['setTuning', 'resetTuning', 'dev'].includes(cmd.c)) return false;\n  switch (cmd.c) {\n    case 'equip': return equip(w, h, cmd.uid);\n    case 'equipNewest': { if (!h.newest) return false; const r = equip(w, h, h.newest); h.newest = null; return r; }\n    case 'unequip': { const it = h.gear[cmd.slot]; if (!it || h.inv.length >= INV_SIZE) return false; delete h.gear[cmd.slot]; h.inv.push(it); refresh(w, h); return ok(); }\n    case 'salvage': {\n      const i = findInv(h, cmd.uid); if (i < 0) return false;\n      const it = h.inv[i]; const pay = SALVAGE[it.rarity]; for (const k of Object.keys(pay)) h.mats[k] += pay[k];\n      h.inv.splice(i, 1); emit(w, { t: 'sfx', id: 'ui_salvage' }); h.counters = h.counters ?? {}; h.counters.salvaged = (h.counters.salvaged ?? 0) + 1;\n      return ok();\n    }\n    case 'sell': { const i = findInv(h, cmd.uid); if (i < 0) return false; const it = h.inv[i]; h.gold += itemValue(it); h.inv.splice(i, 1); emit(w, { t: 'sfx', id: 'gold' }); h.counters = h.counters ?? {}; h.counters.sold = (h.counters.sold ?? 0) + 1; return ok(); }\n    case 'drop': { const i = findInv(h, cmd.uid); if (i < 0) return false; const it = h.inv.splice(i, 1)[0]; dropItem(w, h.x, h.z, it, seat); w.drops.at(-1).t = -1.5; return ok(); }\n    case 'buy': {\n      const st = vendorStock(w, h); const it = st.find((s) => s.uid === cmd.uid); if (!it) return false;\n      if (h.gold < it.price) return fail('NOT ENOUGH GOLD. PENNYWHISTLE IS SORRY. HE IS NOT.');\n      if (h.inv.length >= INV_SIZE) return fail('YOUR PACK IS FULL.');\n      h.gold -= it.price; const copy = { ...it }; delete copy.price; h.inv.push(copy); st.splice(st.indexOf(it), 1); emit(w, { t: 'sfx', id: 'gold' });\n      h.counters = h.counters ?? {}; h.counters.bought = (h.counters.bought ?? 0) + 1;\n      return ok();\n    }\n    case 'casket': {\n      if (h.mats.shards < CASKET_COST.shards) return fail('A CASKET COSTS 3 BELL SHARDS.');\n      if (h.inv.length >= INV_SIZE) return fail('YOUR PACK IS FULL.');\n      h.mats.shards -= CASKET_COST.shards;\n      const rng = w.rngs.loot; const r = rng.next();\n      const it = r < 0.08 ? (rng.chance(0.5) && ['head', 'chest', 'hands', 'feet'].includes(cmd.slot) ? rollSetItem(rng, h.cls, h.level, cmd.slot) : legendaryForSlot(rng, h, cmd.slot)) : makeItem(rng, { slot: cmd.slot, rarity: r < 0.45 ? 'reliquary' : 'blessed', ilvl: h.level, cls: h.cls });\n      h.inv.push(it); emit(w, { t: 'upgrade', seat, uid: it.uid, name: it.name, rarity: it.rarity }); emit(w, { t: 'sfx', id: 'quest' });\n      h.counters = h.counters ?? {}; h.counters.caskets = (h.counters.caskets ?? 0) + 1;\n      return ok();\n    }\n    case 'craft': {\n      const cost = CRAFT_COST[cmd.rarity]; if (!cost) return false;\n      if (h.gold < (cost.gold ?? 0) || h.mats.scrap < (cost.scrap ?? 0) || h.mats.dust < (cost.dust ?? 0)) return fail('NOT ENOUGH MATERIALS, SHE SHOUTS.');\n      if (h.inv.length >= INV_SIZE) return fail('YOUR PACK IS FULL.');\n      h.gold -= cost.gold ?? 0; h.mats.scrap -= cost.scrap ?? 0; h.mats.dust -= cost.dust ?? 0;\n      const it = makeItem(w.rngs.loot, { slot: cmd.slot, rarity: cmd.rarity, ilvl: h.level, cls: h.cls }); h.inv.push(it); emit(w, { t: 'sfx', id: 'anvil' });\n      emit(w, { t: 'upgrade', seat, uid: it.uid, name: it.name, rarity: it.rarity });\n      h.counters = h.counters ?? {}; h.counters.crafted = (h.counters.crafted ?? 0) + 1;\n      return ok();\n    }\n    case 'reforge': {\n      const it = findAny(h, cmd.uid); if (!it || !it.affixes[cmd.index]) return false;\n      if (h.gold < REFORGE_COST.gold || h.mats.dust < REFORGE_COST.dust) return fail('2 DUST AND 80 GOLD, SHE SHOUTS.');\n      h.gold -= REFORGE_COST.gold; h.mats.dust -= REFORGE_COST.dust;\n      const exist = it.affixes.map((a) => a.k);\n      const pool = AFFIX_IDS.filter((k) => (!AFFIXES[k].slots || AFFIXES[k].slots.includes(it.slot)) && !exist.includes(k));\n      const k = w.rngs.loot.pick(pool); it.affixes[cmd.index] = rollAffix(w.rngs.loot, k, it.ilvl);\n      refresh(w, h); emit(w, { t: 'sfx', id: 'anvil' }); h.counters = h.counters ?? {}; h.counters.reforged = (h.counters.reforged ?? 0) + 1;\n      return ok();\n    }\n    case 'extract': {\n      const i = findInv(h, cmd.uid); if (i < 0) return false; const it = h.inv[i]; if (!it.power) return false;\n      const key = reliquaryKind(it.slot); h.reliquary[key] = it.power; h.known = h.known ?? []; if (!h.known.includes(it.power)) h.known.push(it.power);\n      h.inv.splice(i, 1); refresh(w, h); emit(w, { t: 'sfx', id: 'bell_small' }); h.counters = h.counters ?? {}; h.counters.extracted = (h.counters.extracted ?? 0) + 1;\n      return ok(`THE RELIQUARY HOLDS IT NOW: ${LEGENDARY[it.power].name}`);\n    }\n    case 'setRelic': { if (cmd.power && !(h.known ?? []).includes(cmd.power)) return false; h.reliquary[cmd.kind] = cmd.power; refresh(w, h); return ok(); }\n    case 'socket': {\n      const it = findAny(h, cmd.uid); if (!it) return false; const hasSocket = it.affixes.some((a) => a.k === 'socket'); if (!hasSocket) return fail('THAT HAS NO SOCKET.');\n      if (it.gem) { const back = `${it.gem.k}:${it.gem.tier}`; h.gems[back] = (h.gems[back] ?? 0) + 1; }\n      if ((h.gems[cmd.gem] ?? 0) <= 0) return fail('YOU HAVE NONE OF THOSE.');\n      h.gems[cmd.gem]--; const [k, tier] = cmd.gem.split(':'); it.gem = { k, tier: Number(tier) }; refresh(w, h); emit(w, { t: 'sfx', id: 'ui_equip' }); h.counters = h.counters ?? {}; h.counters.socketed = (h.counters.socketed ?? 0) + 1;\n      return ok();\n    }\n    case 'unsocket': { const it = findAny(h, cmd.uid); if (!it?.gem) return false; const back = `${it.gem.k}:${it.gem.tier}`; h.gems[back] = (h.gems[back] ?? 0) + 1; it.gem = null; refresh(w, h); return ok(); }\n    case 'merge': {\n      const [k, t] = cmd.gem.split(':'); const tier = Number(t); if (tier >= 2 || (h.gems[cmd.gem] ?? 0) < 3) return fail('THREE ALIKE, CHILD.');\n      h.gems[cmd.gem] -= 3; const next = `${k}:${tier + 1}`; h.gems[next] = (h.gems[next] ?? 0) + 1; emit(w, { t: 'sfx', id: 'bell_small' }); h.counters = h.counters ?? {}; h.counters.merged = (h.counters.merged ?? 0) + 1;\n      return ok();\n    }\n    case 'stashPut': { const tab = w.stash[cmd.tab]; if (!tab || tab.length >= STASH_SIZE) return fail('THAT TAB IS FULL.'); const i = findInv(h, cmd.uid); if (i < 0) return false; tab.push(h.inv.splice(i, 1)[0]); h.counters = h.counters ?? {}; h.counters.stashed = (h.counters.stashed ?? 0) + 1; return ok(); }\n    case 'stashTake': { const tab = w.stash[cmd.tab]; const i = tab?.findIndex((x) => x.uid === cmd.uid) ?? -1; if (i < 0) return false; if (h.inv.length >= INV_SIZE) return fail('YOUR PACK IS FULL.'); h.inv.push(tab.splice(i, 1)[0]); return ok(); }\n    case 'setSkill': {\n      if (!slotOpen(h, cmd.slot)) return false;\n      if (cmd.skill && (!SKILLS[cmd.skill] || SKILLS[cmd.skill].cls !== h.cls || !skillUnlocked(h, cmd.skill))) return false;\n      const other = h.slots.findIndex((s) => s.skill === cmd.skill);\n      if (other >= 0 && other !== cmd.slot) { const t = h.slots[other]; h.slots[other] = h.slots[cmd.slot]; h.slots[cmd.slot] = t; h.swap[other] = w.time + 1; }\n      else h.slots[cmd.slot] = { skill: cmd.skill, tone: h.slots[cmd.slot].skill === cmd.skill ? h.slots[cmd.slot].tone : null };\n      h.swap[cmd.slot] = w.time + 1;\n      return ok();\n    }\n    case 'setTone': {\n      const s = h.slots[cmd.slot]; if (!s?.skill) return false;\n      const sk = SKILLS[s.skill]; const keys = Object.keys(sk.tones);\n      if (cmd.tone && !toneUnlocked(h, sk, keys.indexOf(cmd.tone))) return false;\n      s.tone = cmd.tone; h.swap[cmd.slot] = w.time + 1; h.toneUse = h.toneUse ?? {}; h.toneUse[cmd.tone] = 1;\n      return ok();\n    }\n    case 'setVow': {\n      if (cmd.index >= vowSlots(h)) return false;\n      const other = h.vows.indexOf(cmd.vow); if (other >= 0 && other !== cmd.index) h.vows[other] = h.vows[cmd.index] ?? null;\n      h.vows[cmd.index] = cmd.vow; h.vows = h.vows.filter(Boolean); refresh(w, h); return ok();\n    }\n    case 'devotion': {\n      if (devotionPointsFree(w) <= 0 || !DEVOTION_TRACKS[cmd.track]) return false;\n      w.devotion.spent[cmd.track]++; for (const o of w.heroes) refresh(w, o); emit(w, { t: 'sfx', id: 'bell_small' }); return ok();\n    }\n    case 'difficulty': { const d = DIFFICULTIES[cmd.i]; if (!d) return false; if (d.locked && !w.unlocks.penance) return fail('PENANCE IS EARNED AFTER THE CREDITS.'); setDifficulty(w, cmd.i); emit(w, { t: 'toast', seat: -1, text: `DIFFICULTY: ${d.name}`, color: 'sand' }); return ok(); }\n    case 'travel': {\n      const z = cmd.zone; if (!ZONES[z] || (!w.story.lychgates.includes(z) && !cmd.dev)) return false;\n      if (w.knell && !cmd.dev) return false;\n      enterZone(w, z);\n      for (const o of w.heroes) if (o.dead) reviveHero(w, o, null, 1);\n      return true;\n    }\n    case 'talk': { const d = dialogFor(w, cmd.npc); if (d) afterTalk(w, d); return true; }\n    case 'bell': return w.hooksExtra?.passingBell?.(w, h) ?? false;\n    case 'respawn': {\n      if (!h.dead) return false;\n      if (cmd.how === 'here') { if (h.deadT < h.respawnWait) return false; reviveHero(w, h); }\n      else if (cmd.how === 'gate') { const g = w.props.find((p) => p.kind === 'lychgate') ?? w.zone.entrance; reviveHero(w, h, g); }\n      else { reviveHero(w, h, null, 1); if (w.zone.id !== 'town' && !w.knell) enterZone(w, 'town'); else if (w.knell) reviveHero(w, h, w.zone.entrance, 1); }\n      return true;\n    }\n    case 'knell': {\n      if (w.zone.id !== 'town') return false;\n      if (cmd.grand !== undefined && cmd.grand !== null) { if (h.mats.keys < 1) return fail('A GRAND KEY IS NEEDED.'); h.mats.keys--; startKnell(w, { grandTier: cmd.grand }); }\n      else startKnell(w);\n      return true;\n    }\n    case 'pick': return w.hooksExtra?.levelPick?.(w, h, cmd.i) ?? false;\n    case 'writs': { if (!w.story.writs) rollWrits(w); return true; }\n    case 'addPyx': { addPyx(w); return true; }\n    case 'removePyx': { removePyx(w); return true; }\n    case 'readLore': { w.lore[cmd.id] = 1; return true; }\n    case 'quitKnell': { leaveKnell(w); enterZone(w, 'town'); return true; }\n    case 'dev': return devCommand(w, h, cmd);\n    default: return false;\n  }\n}\nfunction legendaryForSlot(rng, h, slot) {\n  const pool = LEGENDARIES.filter((l) => l.slot === slot && (!l.cls || l.cls === h.cls));\n  if (!pool.length) return makeItem(rng, { slot, rarity: 'reliquary', ilvl: h.level, cls: h.cls });\n  return makeItem(rng, { legendary: rng.pick(pool).id, ilvl: h.level, cls: h.cls });\n}\nconst findAny = (h, uid) => h.inv.find((i) => i.uid === uid) ?? Object.values(h.gear).find((i) => i?.uid === uid);\nexport function equip(w, h, uid) {\n  const i = findInv(h, uid); if (i < 0) return false;\n  const it = h.inv[i]; if (!canWear(it, h)) { emit(w, { t: 'toast', seat: h.seat, text: 'NOT FOR YOUR TRADE.', color: 'red' }); return false; }\n  const old = h.gear[it.slot]; h.gear[it.slot] = it; h.inv.splice(i, 1); if (old) h.inv.push(old);\n  refresh(w, h); h.hp = Math.min(h.hp, h.stats.maxHp);\n  emit(w, { t: 'equip', id: h.id, seat: h.seat, slot: it.slot, uid: it.uid, model: it.model, base: it.base, rarity: it.rarity, set: it.set });\n  emit(w, { t: 'sheet', seat: h.seat }); emit(w, { t: 'sfx', id: 'ui_equip' }); emit(w, { t: 'tutorial', seat: h.seat, id: 'equip' });\n  if (it.power || it.set) { h.equippedSpecial = (h.equippedSpecial ?? 0) + 1; }\n  return true;\n}\n\n// Dev tools. Each one is used by the dev-mode screen and tested.\nfunction devCommand(w, h, cmd) {\n  const c = cmd.k; const rng = w.rngs.loot;\n  switch (c) {\n    case 'cheat': w.cheats[cmd.id] = !w.cheats[cmd.id]; return true;\n    case 'levelup': if (h.level < LEVEL_CAP) { levelUp(w, h); } return true;\n    case 'level30': while (h.level < LEVEL_CAP) levelUp(w, h); autoAssignSkills(h); return true;\n    case 'gold': h.gold += 10000; return true;\n    case 'mats': h.mats.scrap += 200; h.mats.dust += 100; h.mats.shards += 50; h.mats.keys += 3; return true;\n    case 'item': { const it = makeItem(rng, { slot: cmd.slot, rarity: cmd.rarity, ilvl: h.level, cls: h.cls }); h.inv.push(it); return true; }\n    case 'legendary': { const it = makeItem(rng, { legendary: cmd.id, ilvl: h.level, cls: h.cls }); h.inv.push(it); return true; }\n    case 'set': { const s = SETS[cmd.id ?? SET_FOR_CLASS[h.cls]]; for (const slot of Object.keys(s.pieces)) h.inv.push(makeItem(rng, { slot, set: s.id, ilvl: h.level, cls: s.cls })); return true; }\n    case 'gems': for (const g of GEM_IDS) for (let t = 0; t < 3; t++) h.gems[`${g}:${t}`] = (h.gems[`${g}:${t}`] ?? 0) + 3; return true;\n    case 'spawn': { const p = findOpenNear(w, h.x + 5 * Math.sin(h.facing), h.z + 5 * Math.cos(h.facing)); spawnMonster(w, cmd.type, p.x, p.z, { dormant: false, aggro: true }); return true; }\n    case 'elite': { const p = findOpenNear(w, h.x + 6 * Math.sin(h.facing), h.z + 6 * Math.cos(h.facing)); const types = (w.zone.spec.monsters.length ? w.zone.spec.monsters : ['peatwalker']).filter((t) => t !== 'pallid_bearer'); spawnElitePack(w, p.x, p.z, cmd.kind ?? 'champion', cmd.affl ?? null, types, { dormant: false, aggro: true }); return true; }\n    case 'plate': spawnPlate(w, h.x + 4, h.z, { dormant: false, aggro: true }); return true;\n    case 'coffin': { const p = findOpenNear(w, h.x + 3, h.z); const pr = addProp(w, { kind: 'coffin', x: p.x, z: p.z, model: 'coffin', interact: true, label: 'UNQUIET COFFIN' }); emit(w, { t: 'propadd', id: pr.id, kind: 'coffin', x: pr.x, z: pr.z, model: 'coffin', label: pr.label }); return true; }\n    case 'killall': for (const m of [...w.monsters]) if (!m.dead && !m.dormant) { m.hp = 0; if (m.defn.boss && m.defn.boss !== 'bursar' && m.bossState) m.bossState.round = 3, m.bossState.phase = 3; killMonster(w, m, h, {}); } return true;\n    case 'boss': { const z = cmd.zone; applyCommand(w, h.seat, { c: 'travel', zone: z, dev: true }); return true; }\n    case 'quest': { w.story.q = cmd.q; w.story.step = cmd.step ?? 0; emit(w, { t: 'quest', name: 'DEV', text: 'QUEST JUMP' }); return true; }\n    case 'knellStart': if (!w.knell) { startKnell(w); } return true;\n    case 'knellFill': if (w.knell && w.knell.stage === 'fill') { knellTolls(w); } return true;\n    case 'difficulty': setDifficulty(w, (w.difficulty + 1) % DIFFICULTIES.length); return true;\n    case 'reseed': { w.root = w.root.fork(`dev:${w.tick}`); w.zoneCache.clear(); const id = w.zone.id; w.zone = null; enterZone(w, id); return true; }\n    case 'reveal': if (w.zone.explored) w.zone.explored.fill(1); return true;\n    case 'nextphase': { const m = w.boss?.m; if (!m) return false; const b = m.bossState; if (m.defn.boss === 'malison') { m.invulnerable = false; if (b.phase === 1) m.hp = m.maxHp * 0.59; else if (b.phase === 2) m.hp = m.maxHp * 0.24; else { w.hooks.devRing?.(w, h); } } else if (m.defn.boss === 'ambrose') { m.hp = b.round === 1 ? m.maxHp * 0.65 : m.maxHp * 0.32; } else m.hp = m.maxHp * 0.29; return true; }\n    default: return false;\n  }\n}\nexport { CLASSES, VOW_LEVELS, partyLevel, near, grantXp, visibleProp, finishWrit, questFlag, hasRope, useProp, rollLegendaryItem };\nEOF\ncat > src/sim/step.js <<'EOF'\n// stepWorld: one 60 Hz step of the whole world. Deterministic: same seed and intents, same hash.\nimport { CLASSES } from '../data/classes.js';\nimport { LORE } from '../data/lore.js';\nimport { SHRINES } from '../data/monsters.js';\nimport { DT, emit, enterZone, findOpenNear, near, nearestHero, createWorld, walkable, livingHeroes } from './world.js';\nimport { addBuff, autoAssignSkills, grantXp, levelUp, makeHero, refresh, reviveHero, starterGear, stepHero } from './hero.js';\nimport { stepFields, stepProjectiles } from './effects.js';\nimport { separation, stepBeams, stepGraves, stepMonster, stepRequiem, stepTelegraphs, wake } from './monsters.js';\nimport { HOOKS, addProp, dropItem, grantGem, stepAllies, stepDrops, dropGold, goldAmount } from './rules.js';\nimport { dialogFor, openCoffin, stepQuests, visibleProp, afterTalk, finishWrit } from './quests.js';\nimport { stepKnell } from './knell.js';\nimport { ringRope } from './bosses.js';\nimport { makeItem } from './loot.js';\nimport { stepRound } from './round.js';\nimport { applyCommand } from './commands.js';\n\nexport function newWorld(opts = {}) {\n  const w = createWorld(opts);\n  w.hooks = { ...HOOKS, bonusXp: (w2, h, n) => grantXp(w2, h, n), grantLevel: (w2, h) => levelUp(w2, h), devRing: (w2, h) => { const r = w2.props.find((p) => p.kind === 'rope' && !p.used); if (r) ringRope(w2, r, h); } };\n  w.hooksExtra = { passingBell, levelPick: (w2, h, i) => w2.hooks.levelPick?.(w2, h, i) };\n  w.hooks.levelUp = (w2, h) => { w2.hooks.levelPickQueue?.(w2, h); };\n  return w;\n}\n\nexport function addHero(w, o) {\n  const h = makeHero(w, o);\n  if (!o.gear) starterGear(w, h, Math.max(1, (o.level ?? 1) - 1));\n  autoAssignSkills(h);\n  refresh(w, h); h.hp = h.stats.maxHp;\n  w.heroes.push(h);\n  if (w.zone) { const p = findOpenNear(w, w.heroes[0].x + 1, w.heroes[0].z + 1); h.x = p.x; h.z = p.z; h.px = h.x; h.pz = h.z; }\n  return h;\n}\n\nexport function hasRope(w) { return w.props.some((p) => p.kind === 'rope' && !p.used); }\n\nconst EMPTY = { moveX: 0, moveZ: 0, pressed: {}, held: {} };\nexport function stepWorld(w, intents) {\n  w.tick++; w.time += DT;\n  // Timers fire before everything else moves.\n  if (w.timers.length) { const due = w.timers.filter((t) => t.at <= w.time); if (due.length) { w.timers = w.timers.filter((t) => t.at > w.time); for (const t of due) t.fn(); } }\n  // Flow fields follow each seat; dormant packs wake within 30 m.\n  for (const h of w.heroes) if (!h.left && !h.dead) w.navs[h.seat % 4].flowTo(h.x, h.z);\n  if (w.tick % 20 === 0) for (const m of w.monsters) if (m.dormant) { for (const h of w.heroes) if (!h.left && near(h, m.x, m.z, 30)) { wake(w, m); break; } }\n  w.active = w.monsters.filter((m) => !m.dead && !m.dormant);\n  for (const h of w.heroes) {\n    const it = intents[h.seat] ?? EMPTY;\n    stepHero(w, h, it);\n    stepInteract(w, h, it);\n    if (!walkable(w, h.x, h.z) && !w.cheats.noClip && !h.moveDash) { const p = findOpenNear(w, h.x, h.z); h.x = p.x; h.z = p.z; }\n    if (w.tick % 15 === 0 && w.zone.explored) reveal(w, h);\n  }\n  for (const m of w.active) if (!m.dead) stepMonster(w, m);\n  if (w.tick % 2 === 0) separation(w);\n  stepAllies(w);\n  stepProjectiles(w);\n  stepFields(w);\n  stepTelegraphs(w);\n  stepBeams(w);\n  stepTraps(w);\n  stepDrops(w);\n  stepGraves(w);\n  stepRequiem(w);\n  stepQuests(w);\n  stepKnell(w);\n  stepRound(w);\n  if (w.tick % 300 === 0) w.monsters = w.monsters.filter((m) => !m.dead || m.defn.boss);\n}\nfunction reveal(w, h) {\n  const z = w.zone; const R = 11; const cx = Math.floor(h.x); const cz = Math.floor(h.z);\n  for (let y = Math.max(0, cz - R); y <= Math.min(z.h - 1, cz + R); y++) for (let x = Math.max(0, cx - R); x <= Math.min(z.w - 1, cx + R); x++) if ((x - cx) ** 2 + (y - cz) ** 2 <= R * R) z.explored[y * z.w + x] = 1;\n}\nfunction stepTraps(w) {\n  for (const p of w.props) {\n    if (p.kind !== 'trap') continue;\n    p.cycle -= DT;\n    if (p.cycle <= 0) {\n      p.cycle = 4;\n      if (!w.heroes.some((h) => !h.left && near(h, p.x, p.z, 16))) continue;\n      w.hooks.trapFire?.(w, p);\n      emit(w, { t: 'trap', id: p.id });\n      w.hooks.telegraph?.(w, { kind: 'circle', x: p.x, z: p.z, r: 1.3, dur: 0.7, dmg: 8 + w.zone.spec.levelFloor * 6, level: w.zone.spec.levelFloor, name: 'A FLOOR TRAP', sfx: 'spikes' });\n    }\n  }\n}\n\n// Interaction: tap when something's close and no hostile within 4 m, or hold always. The router decides; the intent says.\nexport const INTERACT_R = 2.2;\nexport function interactTarget(w, h, cycle = 0) {\n  const list = w.props.filter((p) => p.interact && !p.used && visibleProp(w, p) && near(p, h.x, h.z, INTERACT_R + (p.r ?? 1) * 0.6));\n  list.sort((a, b) => Math.hypot(a.x - h.x, a.z - h.z) - Math.hypot(b.x - h.x, b.z - h.z));\n  for (const o of w.heroes) if (o !== h && o.dead && !o.left && near(o, h.x, h.z, 2.5)) list.unshift({ kind: 'revive', hero: o, x: o.x, z: o.z, label: `REVIVE ${o.name}`, hold: 2, id: -o.id });\n  if (!list.length) return null;\n  return list[cycle % list.length];\n}\nfunction stepInteract(w, h, it) {\n  if (h.dead || h.left) return;\n  if (h.state === 'dodge') return;\n  const target = it.interactId !== undefined ? (w.props.find((p) => p.id === it.interactId && p.interact && !p.used && near(p, h.x, h.z, INTERACT_R + (p.r ?? 1))) ?? null) : interactTarget(w, h, it.cycle ?? 0);\n  h.interactTarget = target;\n  if (!target) { if (h.channel?.kind === 'hold') h.channel = null; return; }\n  if (target.hold) {\n    if (it.held?.interact) {\n      if (!h.channel) h.channel = { kind: 'hold', t: 0, dur: target.hold, hold: 'interact', target, done: (w2, he) => useProp(w2, he, target) };\n    } else if (h.channel?.kind === 'hold') h.channel = null;\n    return;\n  }\n  if (it.pressed?.interact) useProp(w, h, target);\n}\n\nexport function useProp(w, h, p) {\n  emit(w, { t: 'tutorial', seat: h.seat, id: 'interact' });\n  switch (p.kind) {\n    case 'revive': reviveHero(w, p.hero, null, 0.5); h.revives++; emit(w, { t: 'toast', seat: -1, text: `${p.hero.name} IS UP AGAIN.`, color: 'lime' }); break;\n    case 'chest': {\n      p.used = true; emit(w, { t: 'chest', id: p.id, x: p.x, z: p.z }); emit(w, { t: 'sfx', id: 'chest', x: p.x, z: p.z });\n      for (const he of w.heroes) { if (he.left) continue; for (let i = 0; i < (p.rich ? 10 : 5); i++) dropGold(w, p.x, p.z, goldAmount(w, 1.2), 2, he.seat); dropItem(w, p.x, p.z, makeItem(w.rngs.loot, { rarity: p.rich || w.rngs.loot.chance(0.3) ? 'reliquary' : 'blessed', ilvl: Math.max(he.level, w.zone.spec.levelFloor), cls: he.cls }), he.seat); if (p.rich) grantGem(w, he, p.x, p.z); }\n      break;\n    }\n    case 'shrine': {\n      p.used = true; const s = SHRINES[p.shrine];\n      for (const he of w.heroes) { if (he.left) continue; he.shrines = (he.shrines ?? 0) + 1;\n        if (p.shrine === 'ardour') addBuff(w, he, { id: 'ardour', dur: 30, dmg: 0.5 });\n        if (p.shrine === 'haste') addBuff(w, he, { id: 'haste', dur: 30, speed: 0.3 });\n        if (p.shrine === 'ward') { he.shield = he.stats.maxHp * 0.3; addBuff(w, he, { id: 'ward', dur: 30, shield: true }); }\n        if (p.shrine === 'plenty') addBuff(w, he, { id: 'plenty', dur: 30 });\n      }\n      emit(w, { t: 'shrine', id: p.id, x: p.x, z: p.z }); emit(w, { t: 'toast', seat: -1, text: `${s.name}: ${s.desc}`, color: s.color, big: true }); emit(w, { t: 'sfx', id: 'shrine' });\n      break;\n    }\n    case 'coffin': openCoffin(w, p); for (const j of w.story.writs ?? []) if (!j.done && j.kind === 'coffin' && j.zone === w.zone.id) finishWrit(w, j); break;\n    case 'exit': {\n      if (p.to === 'town' && w.knell && w.knell.stage === 'done') { w.knell = null; emit(w, { t: 'knell', on: false }); }\n      enterZone(w, p.to, p.at ?? exitAt(w, p));\n      for (const o of w.heroes) if (o.dead) reviveHero(w, o, null, 1);\n      emit(w, { t: 'save' });\n      break;\n    }\n    case 'lychgate': {\n      emit(w, { t: 'open', seat: h.seat, screen: 'map', travel: true }); h.lychUsed = (h.lychUsed ?? 0) + 1;\n      break;\n    }\n    case 'lever': {\n      p.used = true; const port = w.props.find((o) => o.id === p.port);\n      if (port) { w.zone.nav.setOpen(port.col, port.row, true); for (const n of w.navs) n.setOpen(port.col, port.row, true); port.gone = true; port.interact = false; emit(w, { t: 'portcullis', id: port.id, x: port.x, z: port.z }); }\n      emit(w, { t: 'sfx', id: 'lever', x: p.x, z: p.z }); emit(w, { t: 'lever', id: p.id }); h.levers = (h.levers ?? 0) + 1;\n      break;\n    }\n    case 'relic': { p.used = true; w.story.flags[`relic_${p.relic}`] = true; emit(w, { t: 'toast', seat: -1, text: \"A PIECE OF SAINT GLOAM. IT IS WARM.\", color: 'orange', big: true }); emit(w, { t: 'sfx', id: 'bell_small' }); emit(w, { t: 'relic', id: p.id }); emit(w, { t: 'save' }); break; }\n    case 'npc': { const d = dialogFor(w, p.npc); emit(w, { t: 'npc', seat: h.seat, npc: p.npc, d, id: p.id }); h.talked = h.talked ?? {}; h.talked[p.npc] = 1; break; }\n    case 'stash': emit(w, { t: 'open', seat: h.seat, screen: 'stash' }); break;\n    case 'knellfont': emit(w, { t: 'open', seat: h.seat, screen: 'knell' }); break;\n    case 'writs': emit(w, { t: 'open', seat: h.seat, screen: 'writs' }); break;\n    case 'lore': { w.lore[p.lore] = 1; emit(w, { t: 'open', seat: h.seat, screen: 'lore', lore: p.lore }); emit(w, { t: 'loreread', id: p.lore, title: LORE[p.lore].title }); break; }\n    case 'book': { p.used = true; w.story.flags.overdueBook = true; emit(w, { t: 'toast', seat: -1, text: 'THE OVERDUE BOOK. THE CRIER WILL WANT THIS.', color: 'sand', big: true }); emit(w, { t: 'relic', id: p.id }); break; }\n    case 'novices': { p.used = true; w.novices = { x: p.x, z: p.z, t: 45, waveT: 1, active: true }; emit(w, { t: 'defend', on: true, dur: 45 }); emit(w, { t: 'say', who: 'pyx', text: 'Bless you. Duck.' }); emit(w, { t: 'toast', seat: -1, text: 'HOLD HERE FOR 45 SECONDS.', color: 'sand', big: true }); break; }\n    case 'rope': { p.used = true; ringRope(w, p, h); break; }\n    case 'classfont': { w.hooks.classFontUse?.(w, h, p); break; }\n    case 'portal': { p.used = true; const r = w.returnTo; w.returnTo = null; const pid = p.id; w.props = w.props.filter((o) => o.id !== pid); emit(w, { t: 'propgone', id: pid }); enterZone(w, r.zone, { x: r.x, z: r.z }); break; }\n    default: break;\n  }\n}\nfunction exitAt(w, p) {\n  // Coming back up leaves you by the stairs you went down.\n  const c = w.zoneCache.get(p.to);\n  if (c) { const back = c.props.find((o) => o.kind === 'exit' && o.to === w.zone.id); if (back) return { x: back.x + 1.5, z: back.z + 1 }; }\n  return null;\n}\n\n// The Passing Bell: a portal to town and back. Not in Knell Runs or sessions.\nexport function passingBell(w, h) {\n  if (w.knell || w.round || w.mode !== 'campaign') return false;\n  if (w.zone.id === 'town' || w.zone.spec.boss && w.boss) return false;\n  w.returnTo = { zone: w.zone.id, x: h.x, z: h.z };\n  enterZone(w, 'town');\n  const t = w.zone.marks.find((m) => m.kind === 'r');\n  const pr = addProp(w, { kind: 'portal', x: t.x, z: t.z, model: 'portal', interact: true, label: 'THE PASSING BELL: BACK', r: 1.3 });\n  emit(w, { t: 'propadd', id: pr.id, kind: 'portal', x: pr.x, z: pr.z, model: 'portal', label: pr.label });\n  h.bellUsed = (h.bellUsed ?? 0) + 1;\n  emit(w, { t: 'sfx', id: 'bell_small' });\n  return true;\n}\n\nexport function simHash(w) {\n  let n = (w.tick * 31 + w.nextId) | 0;\n  const mix = (v) => { n = (Math.imul(n, 16777619) ^ Math.round(v * 16)) | 0; };\n  for (const h of w.heroes) { mix(h.x); mix(h.z); mix(h.hp); mix(h.level); mix(h.gold); }\n  for (const m of w.monsters) { if (m.dead) continue; mix(m.id); mix(m.x); mix(m.z); mix(m.hp); }\n  mix(w.drops.length); mix(w.rngs.loot.state); mix(w.rngs.combat.state);\n  return n >>> 0;\n}\nexport { applyCommand, CLASSES, nearestHero, livingHeroes, createWorld };\nEOF\ncat > src/sim/round.js <<'EOF'\n// The AI Hub round: one 8-minute Knell Run with a Warden for everybody seated.\nimport { CLASSES, CLASS_IDS, SKILLS, toneUnlockLevel } from '../data/classes.js';\nimport { DT, emit, enterZone } from './world.js';\nimport { levelUp, refresh, slotOpen } from './hero.js';\nimport { addProp } from './rules.js';\nimport { startKnell } from './knell.js';\nimport { makeItem } from './loot.js';\n\nexport const SEAT_CLASS = ['bellwarden', 'lamplighter', 'sexton', 'bellwarden'];\nexport function presetHero(w, h) {\n  // Level 12, every slot filled from the class preset, a plain gear set.\n  while (h.level < 12) levelUp(w, h);\n  const skills = CLASSES[h.cls].skills.filter((s) => s.level <= 12);\n  h.slots = skills.slice(0, 6).map((s) => ({ skill: s.id, tone: null }));\n  while (h.slots.length < 6) h.slots.push({ skill: null, tone: null });\n  h.gear = {};\n  for (const slot of ['main', 'chest', 'head', 'hands', 'legs', 'feet']) h.gear[slot] = makeItem(w.rngs.loot, { slot, rarity: 'common', ilvl: 11, cls: h.cls });\n  h.vows = [CLASSES[h.cls].vows[0].id];\n  h.xp = 0; h.gold = 0; h.inv = [];\n  refresh(w, h); h.hp = h.stats.maxHp; h.res = h.stats.maxResource * 0.5;\n}\nexport function swapClass(w, h, cls) {\n  h.cls = cls; h._skillCache = null; presetHero(w, h); emit(w, { t: 'classswap', id: h.id, seat: h.seat, cls });\n}\nexport function setupRound(w, players) {\n  w.round = { players, t: 0, started: false, wardenDead: false, timeUp: false, swapUntil: 30 };\n  w.hooks.classFonts = (w2, z) => {\n    const e = z.entrance;\n    CLASS_IDS.forEach((c, i) => { addProp(w2, { kind: 'classfontspot', x: e.x - 3 + i * 3, z: e.z + 3, cls: c, model: 'knell_font', r: 1, label: CLASSES[c].name }); });\n  };\n  w.hooks.levelPickQueue = (w2, h) => {\n    if (h.level <= 12) return;\n    const opts = rollPicks(w2, h);\n    h.levelPicks.push({ opts, t: 10 });\n    emit(w2, { t: 'picks', seat: h.seat });\n  };\n  w.hooks.levelPick = (w2, h, i) => { const p = h.levelPicks[0]; if (!p) return false; applyPick(w2, h, p.opts[i] ?? p.opts[0]); h.levelPicks.shift(); return true; };\n  startKnell(w, { session: true });\n}\nfunction rollPicks(w, h) {\n  const rng = w.rngs.quest; const out = [];\n  const usable = h.slots.filter((s) => s.skill && !s.tone);\n  const toneSlot = usable.length ? rng.pick(usable) : null;\n  if (toneSlot) { const sk = SKILLS[toneSlot.skill]; const keys = Object.keys(sk.tones); const t = rng.pick(keys); out.push({ kind: 'tone', skill: sk.id, tone: t, label: `${sk.name}: ${sk.tones[t].name}` }); }\n  if (h.vows.length < 2) { const left = CLASSES[h.cls].vows.filter((v) => !h.vows.includes(v.id)); const v = rng.pick(left); out.push({ kind: 'vow', id: v.id, label: `VOW: ${v.name}` }); }\n  const stats = [{ k: 'power', label: '+15 POWER', v: 15 }, { k: 'vitality', label: '+15 VITALITY', v: 15 }, { k: 'crit', label: '+5% CRIT', v: 5 }, { k: 'atkSpd', label: '+8% ATTACK SPEED', v: 8 }];\n  rng.shuffle(stats);\n  for (const s of stats) { if (out.length >= 3) break; out.push({ kind: 'stat', ...s }); }\n  return out.slice(0, 3);\n}\nfunction applyPick(w, h, o) {\n  if (o.kind === 'tone') { const s = h.slots.find((x) => x.skill === o.skill); if (s) s.tone = o.tone; }\n  if (o.kind === 'vow') h.vows.push(o.id);\n  if (o.kind === 'stat') { const g = h.gear.main; g.affixes.push({ k: o.k, v: o.v }); }\n  refresh(w, h);\n  emit(w, { t: 'toast', seat: h.seat, text: o.label, color: 'sand' });\n}\nexport function stepRound(w) {\n  const r = w.round; if (!r) return;\n  r.t += DT;\n  // The class fonts in the first room: stand on one for 2 s to swap, until play has run 30 s.\n  if (r.t < r.swapUntil) {\n    for (const h of w.heroes) {\n      if (h.left || h.dead) continue;\n      const f = w.props.find((p) => p.kind === 'classfontspot' && p.cls !== h.cls && Math.hypot(p.x - h.x, p.z - h.z) < 1.2);\n      if (f) { h.fontT = (h.fontT ?? 0) + DT; if (h.fontT >= 2) { h.fontT = 0; swapClass(w, h, f.cls); } } else h.fontT = 0;\n    }\n  }\n  for (const h of w.heroes) {\n    if (h.levelPicks.length) { const p = h.levelPicks[0]; p.t -= DT; if (p.t <= 0) w.hooks.levelPick(w, h, 0); }\n    if (h.dead && h.deadT >= 8) { h.dead = false; h.hp = h.stats.maxHp * 0.6; h.state = 'idle'; h.invulnerable = 2; const a = w.heroes.find((o) => !o.dead && !o.left && o !== h); if (a) { h.x = a.x; h.z = a.z; h.px = a.x; h.pz = a.z; } emit(w, { t: 'revive', id: h.id, x: h.x, z: h.z }); }\n  }\n}\nexport const scoreOf = (h) => h.damage / 100 + 50 * h.revives + 20 * h.eliteKills - 30 * h.deaths;\nexport { slotOpen, toneUnlockLevel, enterZone };\nEOF\ncat > tools/scratch/sim1.mjs <<'EOF'\nimport { newWorld, addHero, stepWorld, simHash } from '../../src/sim/step.js';\nimport { enterZone } from '../../src/sim/world.js';\nconst w=newWorld({seed:5}); const h=addHero(w,{seat:0,cls:'bellwarden'});\nenterZone(w,'yard'); w.events.length=0;\nlet t=Date.now();\nfor(let i=0;i<3600;i++){ const m=w.active.filter(x=>!x.dead).sort((a,b)=>Math.hypot(a.x-h.x,a.z-h.z)-Math.hypot(b.x-h.x,b.z-h.z))[0]; let it={moveX:0,moveZ:0,pressed:{},held:{}}; if(m){const dx=m.x-h.x,dz=m.z-h.z,d=Math.hypot(dx,dz); it.aimX=dx/d;it.aimZ=dz/d; if(d>2){it.moveX=dx/d;it.moveZ=dz/d}else it.held={s0:true}; } else {it.moveX=1;} stepWorld(w,{0:it}); w.events.length=0; }\nconsole.log('kills',w.stats.kills,'lvl',h.level,'gold',h.gold,'x',h.x.toFixed(1),'hp',h.hp|0,'quest',w.story.q,w.story.step,Date.now()-t,'ms',simHash(w));\nEOF\nnode tools/scratch/sim1.mjs 2>&1 | cut -c1-400 | tail -12","description":"Write commands, step and round modules, smoke test sim"}}}
