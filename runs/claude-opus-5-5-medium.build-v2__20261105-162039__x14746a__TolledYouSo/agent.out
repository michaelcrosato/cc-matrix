{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkeYCWUudY9jRusr2tWs","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018PcREZgxyVZowrfNDjCdGx","name":"Bash","input":{"command":"python3 - <<'EOF'\nimport re\np='src/data/rooms.js'; s=open(p).read()\ns=s.replace(\"#L...................................... L#\",\"#L.......................................L#\")\ns=re.sub(r\"const cryptLever = R\\('leverroom', `.*?`, \\{ lever: true \\}\\);\\n\",\"\",s,flags=re.S)\ns=s.replace(\", special: { lever: cryptLever }\",\"\")\nopen(p,'w').write(s)\nEOF\ncat > src/data/zones.js <<'EOF'\n// Zone table. Generated zones stitch BIOMES templates; authored ones read rows from rooms.js.\nconst Z = (o) => ({ wallH: 3, levelFloor: 1, density: 1, ...o });\nexport const ZONES = {\n  yard: Z({ id: 'yard', name: \"ST. CLEMENT'S YARD\", kind: 'authored', biome: 'yard', look: 'yard', song: 'weeping', monsters: ['peatwalker'], levelFloor: 1, density: 0.55, rain: true }),\n  town: Z({ id: 'town', name: 'TOLLHAVEN', kind: 'authored', biome: 'town', look: 'town', song: 'lamps', monsters: [], levelFloor: 1, safe: true }),\n  causeway: Z({ id: 'causeway', name: 'THE WEEPING CAUSEWAY', kind: 'gen', biome: 'moor', look: 'moor', song: 'weeping', rooms: 9, linear: true, include: ['pantry'], monsters: ['peatwalker', 'peatwalker', 'gibbet_drop', 'bloat_deacon'], levelFloor: 1, rain: true, wallH: 1.1, density: 0.8 }),\n  pantry: Z({ id: 'pantry', name: 'THE DROWNED PANTRY', kind: 'gen', biome: 'pantry', look: 'pantry', song: 'under', rooms: 2, monsters: ['peatwalker', 'bloat_deacon'], levelFloor: 3, density: 0.7 }),\n  ossuary1: Z({ id: 'ossuary1', name: 'OSSUARY OF SAINT GLOAM: FIRST FLOOR', kind: 'gen', biome: 'crypt', look: 'crypt', song: 'under', rooms: 8, monsters: ['peatwalker', 'rattlebones', 'rattlebones', 'choir_skull', 'tomb_crawler'], levelFloor: 6, relic: true, density: 0.85 }),\n  ossuary2: Z({ id: 'ossuary2', name: 'OSSUARY OF SAINT GLOAM: SECOND FLOOR', kind: 'gen', biome: 'crypt', look: 'crypt', song: 'under', rooms: 8, monsters: ['rattlebones', 'choir_skull', 'pallid_bearer', 'tomb_crawler', 'bloat_deacon'], levelFloor: 7, relic: true, lever: true, density: 0.85 }),\n  ossuary3: Z({ id: 'ossuary3', name: 'OSSUARY OF SAINT GLOAM: THIRD FLOOR', kind: 'gen', biome: 'crypt', look: 'crypt', song: 'under', rooms: 9, monsters: ['rattlebones', 'choir_skull', 'pallid_bearer', 'tomb_crawler', 'bloat_deacon'], levelFloor: 8, relic: true, lever: true, density: 0.9 }),\n  countinghouse: Z({ id: 'countinghouse', name: 'THE COUNTING HOUSE', kind: 'arena', arena: 'countinghouse', biome: 'crypt', look: 'counting', song: 'ledger', monsters: [], levelFloor: 9, boss: 'bursar' }),\n  cloister: Z({ id: 'cloister', name: 'THE CINDER CLOISTER', kind: 'gen', biome: 'cloister', look: 'cloister', song: 'cinders', rooms: 11, include: ['novices'], monsters: ['cinderling', 'cinderling', 'tithe_collector', 'penitent', 'clapperjaw', 'ash_gargoyle', 'shade_acolyte'], levelFloor: 11, density: 0.9 }),\n  belfry1: Z({ id: 'belfry1', name: 'THE CRACKED BELFRY: LOWER RINGING', kind: 'gen', biome: 'belfry', look: 'belfry', song: 'climb', rooms: 4, monsters: ['rattlebones', 'cinderling', 'penitent', 'ash_gargoyle'], levelFloor: 15, density: 0.9 }),\n  belfry2: Z({ id: 'belfry2', name: 'THE CRACKED BELFRY: THE LONG STAIR', kind: 'gen', biome: 'belfry', look: 'belfry', song: 'climb', rooms: 4, monsters: ['cinderling', 'penitent', 'clapperjaw', 'ash_gargoyle'], levelFloor: 16, density: 0.9 }),\n  belfry3: Z({ id: 'belfry3', name: 'THE CRACKED BELFRY: THE WIND LOFT', kind: 'gen', biome: 'belfry', look: 'belfry', song: 'climb', rooms: 4, monsters: ['rattlebones', 'penitent', 'clapperjaw', 'ash_gargoyle'], levelFloor: 17, density: 0.9 }),\n  belfry_top: Z({ id: 'belfry_top', name: 'BENEATH OLD CLEMENCY', kind: 'arena', arena: 'malison', biome: 'belfry', look: 'belfry', song: 'eventide', monsters: [], levelFloor: 18, boss: 'malison' }),\n  knell1: Z({ id: 'knell1', name: 'KNELL RUN: FIRST PASSAGE', kind: 'gen', biome: 'mix', look: 'crypt', song: 'knell', rooms: 13, monsters: ['peatwalker', 'rattlebones', 'choir_skull', 'pallid_bearer', 'tomb_crawler', 'bloat_deacon', 'cinderling', 'penitent', 'clapperjaw', 'ash_gargoyle', 'shade_acolyte', 'tithe_collector'], levelFloor: 12, knell: true }),\n  knell2: Z({ id: 'knell2', name: 'KNELL RUN: SECOND PASSAGE', kind: 'gen', biome: 'mix', look: 'cloister', song: 'knell', rooms: 14, monsters: ['peatwalker', 'rattlebones', 'choir_skull', 'pallid_bearer', 'tomb_crawler', 'bloat_deacon', 'cinderling', 'penitent', 'clapperjaw', 'ash_gargoyle', 'shade_acolyte', 'tithe_collector'], levelFloor: 12, knell: true }),\n  session: Z({ id: 'session', name: 'THE KNELL', kind: 'gen', biome: 'mix', look: 'crypt', song: 'knell', rooms: 17, monsters: ['peatwalker', 'rattlebones', 'choir_skull', 'pallid_bearer', 'tomb_crawler', 'bloat_deacon', 'cinderling', 'penitent', 'clapperjaw', 'ash_gargoyle', 'shade_acolyte', 'tithe_collector'], levelFloor: 12, knell: true, classFonts: true }),\n  titlescene: Z({ id: 'titlescene', name: 'TITLE', kind: 'arena', arena: 'title', biome: 'belfry', look: 'title', song: 'vespers', monsters: [], levelFloor: 1, safe: true }),\n};\nexport const LYCHGATE_ORDER = ['town', 'causeway', 'ossuary1', 'ossuary2', 'ossuary3', 'cloister', 'belfry1', 'belfry2', 'belfry3'];\nEOF\ncat > src/sim/zonegen.js <<'EOF'\n// Stitches ASCII rooms into a map from a seed. Same code on every client: a pure function of (seed, zone id).\nimport { NavGrid } from '../../pixel-engine.js';\nimport { BIOMES, BOSS_ROOMS, TOWN, YARD } from '../data/rooms.js';\nimport { ZONES } from '../data/zones.js';\n\nconst OPP = { N: 'S', S: 'N', W: 'E', E: 'W' };\nconst sockets = (t) => {\n  const out = [];\n  const H = t.rows.length; const W = t.rows[0].length;\n  t.rows.forEach((r, y) => { if (r.length !== W) throw new Error(`room ${t.name} row ${y} is ${r.length}, wanted ${W}`); });\n  for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {\n    if (t.rows[y][x] !== 'D') continue;\n    out.push({ x, y, side: y === 0 ? 'N' : y === H - 1 ? 'S' : x === 0 ? 'W' : 'E' });\n  }\n  return out;\n};\n\nfunction layoutRooms(rng, spec, biome) {\n  const pool = biome.rooms;\n  const placed = [];\n  const overlaps = (x, y, w, h) => placed.some((p) => x < p.x + p.w + 1 && p.x < x + w + 1 && y < p.y + p.h + 1 && p.y < y + h + 1);\n  const place = (t, x, y, depth, parent) => { const r = { t, x, y, w: t.rows[0].length, h: t.rows.length, depth, parent, used: new Set(), name: t.name }; placed.push(r); return r; };\n  place(biome.entrance, 0, 0, 0, null);\n  const attach = (t, preferDeep) => {\n    const opens = [];\n    for (const p of placed) for (const s of sockets(p.t)) if (!p.used.has(`${s.x},${s.y}`)) opens.push({ p, s });\n    rng.shuffle(opens);\n    if (preferDeep) opens.sort((a, b) => b.p.depth - a.p.depth);\n    if (spec.linear) opens.sort((a, b) => (b.s.side === 'E' ? 1 : 0) - (a.s.side === 'E' ? 1 : 0) || (b.p.x + b.s.x) - (a.p.x + a.s.x));\n    for (const { p, s } of opens) {\n      const tsocks = sockets(t).filter((q) => q.side === OPP[s.side]);\n      rng.shuffle(tsocks);\n      for (const q of tsocks) {\n        const dx = s.side === 'E' ? 1 : s.side === 'W' ? -1 : 0;\n        const dy = s.side === 'S' ? 1 : s.side === 'N' ? -1 : 0;\n        const x = p.x + s.x + dx - q.x;\n        const y = p.y + s.y + dy - q.y;\n        if (overlaps(x, y, t.rows[0].length, t.rows.length)) continue;\n        p.used.add(`${s.x},${s.y}`);\n        const r = place(t, x, y, p.depth + 1, p);\n        r.used.add(`${q.x},${q.y}`);\n        return r;\n      }\n    }\n    return null;\n  };\n  const special = (spec.include ?? []).map((k) => biome.special?.[k]).filter(Boolean);\n  const count = spec.rooms - 2;\n  const midAt = Math.floor(count / 2);\n  for (let i = 0; i < count; i++) {\n    if (special.length && i === midAt) { for (const t of special) if (!attach(t, spec.linear)) return null; }\n    const shuffled = rng.shuffle([...pool]);\n    let ok = null;\n    for (const t of shuffled) { ok = attach(t, spec.linear || i % 3 !== 2); if (ok) break; }\n    if (!ok) return null;\n  }\n  return attach(biome.exit, true) ? placed : null;\n}\n\nconst mixBiome = () => ({\n  rooms: [...BIOMES.crypt.rooms, ...BIOMES.cloister.rooms, ...BIOMES.belfry.rooms],\n  entrance: BIOMES.crypt.entrance,\n  exit: BIOMES.belfry.exit,\n});\n\nconst blank = () => ({ lights: [], spawns: [], breakables: [], chests: [], traps: [], shrines: [], named: [], gates: [], marks: [] });\nfunction readMarker(z, ch, x, y, namedList, room) {\n  const at = { x: x + 0.5, z: y + 0.5, room };\n  switch (ch) {\n    case 'L': z.lights.push(at); break;\n    case 'S': z.spawns.push({ ...at, kind: 'S' }); break;\n    case 'E': z.spawns.push({ ...at, kind: 'E' }); break;\n    case 'B': z.breakables.push(at); break;\n    case 'C': z.chests.push(at); break;\n    case 'T': z.traps.push(at); break;\n    case 'A': z.shrines.push(at); break;\n    case 'G': z.gates.push(at); break;\n    case 'X': z.marks.push({ ...at, kind: 'X' }); break;\n    case 'Y': z.marks.push({ ...at, kind: 'Y' }); break;\n    case 'N': { const id = namedList?.[namedList.cursor++ % namedList.length]; if (id) z.named.push({ ...at, id }); break; }\n    default: if (/[a-zA-Z]/.test(ch)) z.marks.push({ ...at, kind: ch });\n  }\n}\n\nfunction fromAuthored(spec, def) {\n  const z = blank();\n  const list = def.named ? [...def.named] : null; if (list) list.cursor = 0;\n  const rows = def.rows.map((r, y) => [...r].map((c, x) => { if (c !== '#' && c !== '.' && c !== '~') { readMarker(z, c, x, y, list, 0); return '.'; } return c; }).join(''));\n  z.rows = rows; z.w = rows[0].length; z.h = rows.length; z.roomRects = [{ x: 0, y: 0, w: z.w, h: z.h, name: spec.id, depth: 0 }];\n  return z;\n}\n\nfunction arenaRows(kind) {\n  const def = BOSS_ROOMS[kind] ?? { w: 31, h: 31 };\n  const { w, h } = def; const rows = [];\n  const z = blank();\n  const cx = w / 2; const cy = h / 2;\n  for (let y = 0; y < h; y++) {\n    let r = '';\n    for (let x = 0; x < w; x++) {\n      const edge = x === 0 || y === 0 || x === w - 1 || y === h - 1;\n      if (kind === 'malison' || kind === 'title') {\n        const d = Math.hypot(x + 0.5 - cx, y + 0.5 - cy);\n        const R = Math.min(w, h) / 2 - 1;\n        r += d >= R + 1 ? ' ' : d >= R ? '#' : '.';\n      } else r += edge ? '#' : '.';\n    }\n    rows.push(r);\n  }\n  z.rows = rows; z.w = w; z.h = h; z.roomRects = [{ x: 0, y: 0, w, h, name: kind, depth: 0 }];\n  z.marks.push({ x: cx, z: h - 4.5, kind: 'X', room: 0 });\n  if (kind === 'countinghouse') {\n    for (const [x, y] of [[5, 5], [w - 6, 5], [5, h - 6], [w - 6, h - 6], [cx, 4], [cx, h - 3]]) z.lights.push({ x: x + 0.5, z: y + 0.5, room: 0 });\n    for (const [x, y, id] of [[8, 8, 'gold-pile'], [w - 9, 8, 'gold-pile'], [8, h - 9, 'gold-pile'], [w - 9, h - 9, 'gold-pile'], [5, cy, 'desk'], [w - 6, cy, 'desk'], [cx - 7, 3, 'strongbox'], [cx + 7, 3, 'strongbox']]) z.named.push({ x: x + 0.5, z: y + 0.5, id, room: 0 });\n  }\n  if (kind === 'malison') {\n    for (let i = 0; i < 8; i++) { const a = (i / 8) * Math.PI * 2; z.lights.push({ x: cx + Math.cos(a) * 16, z: cy + Math.sin(a) * 16, room: 0 }); }\n  }\n  return z;\n}\n\nfunction fromRooms(rng, spec) {\n  const biome = spec.biome === 'mix' ? mixBiome() : BIOMES[spec.biome];\n  let placed = null;\n  for (let attempt = 0; attempt < 40 && !placed; attempt++) placed = layoutRooms(rng.fork(`try:${attempt}`), spec, biome);\n  if (!placed) throw new Error(`zonegen failed for ${spec.id}`);\n  let minX = Infinity; let minY = Infinity; let maxX = -Infinity; let maxY = -Infinity;\n  for (const p of placed) { minX = Math.min(minX, p.x); minY = Math.min(minY, p.y); maxX = Math.max(maxX, p.x + p.w); maxY = Math.max(maxY, p.y + p.h); }\n  const pad = 3;\n  const w = maxX - minX + pad * 2; const h = maxY - minY + pad * 2;\n  const g = Array.from({ length: h }, () => new Array(w).fill(' '));\n  const z = blank();\n  z.roomRects = [];\n  placed.forEach((p, i) => {\n    const ox = p.x - minX + pad; const oy = p.y - minY + pad;\n    p.ox = ox; p.oy = oy;\n    z.roomRects.push({ x: ox, y: oy, w: p.w, h: p.h, name: p.name, depth: p.depth, parent: p.parent ? placed.indexOf(p.parent) : -1 });\n    const list = p.t.named ? [...p.t.named] : null; if (list) list.cursor = 0;\n    p.t.rows.forEach((row, y) => [...row].forEach((c, x) => {\n      const gx = ox + x; const gy = oy + y;\n      let out = c;\n      if (c === 'D') out = p.used.has(`${x},${y}`) ? '.' : '#';\n      else if (c !== '#' && c !== '.' && c !== '~') {\n        // X is only meaningful in the first and last rooms; Y is the special event spot.\n        readMarker(z, c, gx, gy, list, i);\n        out = '.';\n      }\n      g[gy][gx] = out;\n    }));\n  });\n  z.rows = g.map((r) => r.join('')); z.w = w; z.h = h;\n  return z;\n}\n\nexport function generateZone(rootRng, zoneId) {\n  const spec = ZONES[zoneId];\n  const rng = rootRng.fork(`zone:${zoneId}`);\n  let z;\n  if (spec.kind === 'authored') z = fromAuthored(spec, spec.id === 'yard' ? YARD : TOWN);\n  else if (spec.kind === 'arena') z = arenaRows(spec.arena);\n  else z = fromRooms(rng, spec);\n  z.id = zoneId; z.spec = spec;\n  z.nav = NavGrid.fromRows(z.rows, { blocked: '#~ ', ox: 0, oz: 0 });\n  const xs = z.marks.filter((m) => m.kind === 'X');\n  z.entrance = xs[0] ?? { x: z.w / 2, z: z.h / 2 };\n  z.exit = xs.length > 1 ? xs[xs.length - 1] : xs[0];\n  return z;\n}\nexport const zoneHash = (z) => { let h = 7; for (const r of z.rows) for (let i = 0; i < r.length; i++) h = (h * 31 + r.charCodeAt(i)) | 0; return h; };\nEOF\ncat > tools/scratch/zt.mjs <<'EOF'\nimport { Rng, NavGrid } from '../../pixel-engine.js';\nimport { generateZone } from '../../src/sim/zonegen.js';\nimport { ZONES } from '../../src/data/zones.js';\nconst n=new NavGrid(4,4,{ox:0,oz:0}); console.log(n.ox,n.oz,n.cell,n.centerX(0));\nfor (const id of Object.keys(ZONES)) { let bad=0,t=Date.now(); for(let s=0;s<30;s++){const z=generateZone(new Rng(s+1),id); if(!z.nav.path([z.entrance.x,0,z.entrance.z],[z.exit.x,0,z.exit.z])) bad++;}\nconst z=generateZone(new Rng(1),id); console.log(id,z.w,z.h,'bad',bad,'S',z.spawns.length,'ms',Date.now()-t); }\nconst z=generateZone(new Rng(3),'causeway'); console.log(z.rows.join('\\n').slice(0,1500));\nEOF\nnode tools/scratch/zt.mjs 2>&1 | cut -c1-230 | tail -60","description":"Write zone generator and test it across seeds"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11569,"cache_read_input_tokens":195249,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11569},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"69254de6-4061-470e-8e76-10f1ee96c6e5","uuid":"3783ff41-7f03-428e-b55f-007ed1cb7777","timestamp":"2026-11-05T23:29:40.254Z","request_id":"req_011CgkeYCGLxocpuft9UoVKu","wire_tool_inputs":{"toolu_018PcREZgxyVZowrfNDjCdGx":{"command":"python3 - <<'EOF'\nimport re\np='src/data/rooms.js'; s=open(p).read()\ns=s.replace(\"#L...................................... L#\",\"#L.......................................L#\")\ns=re.sub(r\"const cryptLever = R\\('leverroom', `.*?`, \\{ lever: true \\}\\);\\n\",\"\",s,flags=re.S)\ns=s.replace(\", special: { lever: cryptLever }\",\"\")\nopen(p,'w').write(s)\nEOF\ncat > src/data/zones.js <<'EOF'\n// Zone table. Generated zones stitch BIOMES templates; authored ones read rows from rooms.js.\nconst Z = (o) => ({ wallH: 3, levelFloor: 1, density: 1, ...o });\nexport const ZONES = {\n  yard: Z({ id: 'yard', name: \"ST. CLEMENT'S YARD\", kind: 'authored', biome: 'yard', look: 'yard', song: 'weeping', monsters: ['peatwalker'], levelFloor: 1, density: 0.55, rain: true }),\n  town: Z({ id: 'town', name: 'TOLLHAVEN', kind: 'authored', biome: 'town', look: 'town', song: 'lamps', monsters: [], levelFloor: 1, safe: true }),\n  causeway: Z({ id: 'causeway', name: 'THE WEEPING CAUSEWAY', kind: 'gen', biome: 'moor', look: 'moor', song: 'weeping', rooms: 9, linear: true, include: ['pantry'], monsters: ['peatwalker', 'peatwalker', 'gibbet_drop', 'bloat_deacon'], levelFloor: 1, rain: true, wallH: 1.1, density: 0.8 }),\n  pantry: Z({ id: 'pantry', name: 'THE DROWNED PANTRY', kind: 'gen', biome: 'pantry', look: 'pantry', song: 'under', rooms: 2, monsters: ['peatwalker', 'bloat_deacon'], levelFloor: 3, density: 0.7 }),\n  ossuary1: Z({ id: 'ossuary1', name: 'OSSUARY OF SAINT GLOAM: FIRST FLOOR', kind: 'gen', biome: 'crypt', look: 'crypt', song: 'under', rooms: 8, monsters: ['peatwalker', 'rattlebones', 'rattlebones', 'choir_skull', 'tomb_crawler'], levelFloor: 6, relic: true, density: 0.85 }),\n  ossuary2: Z({ id: 'ossuary2', name: 'OSSUARY OF SAINT GLOAM: SECOND FLOOR', kind: 'gen', biome: 'crypt', look: 'crypt', song: 'under', rooms: 8, monsters: ['rattlebones', 'choir_skull', 'pallid_bearer', 'tomb_crawler', 'bloat_deacon'], levelFloor: 7, relic: true, lever: true, density: 0.85 }),\n  ossuary3: Z({ id: 'ossuary3', name: 'OSSUARY OF SAINT GLOAM: THIRD FLOOR', kind: 'gen', biome: 'crypt', look: 'crypt', song: 'under', rooms: 9, monsters: ['rattlebones', 'choir_skull', 'pallid_bearer', 'tomb_crawler', 'bloat_deacon'], levelFloor: 8, relic: true, lever: true, density: 0.9 }),\n  countinghouse: Z({ id: 'countinghouse', name: 'THE COUNTING HOUSE', kind: 'arena', arena: 'countinghouse', biome: 'crypt', look: 'counting', song: 'ledger', monsters: [], levelFloor: 9, boss: 'bursar' }),\n  cloister: Z({ id: 'cloister', name: 'THE CINDER CLOISTER', kind: 'gen', biome: 'cloister', look: 'cloister', song: 'cinders', rooms: 11, include: ['novices'], monsters: ['cinderling', 'cinderling', 'tithe_collector', 'penitent', 'clapperjaw', 'ash_gargoyle', 'shade_acolyte'], levelFloor: 11, density: 0.9 }),\n  belfry1: Z({ id: 'belfry1', name: 'THE CRACKED BELFRY: LOWER RINGING', kind: 'gen', biome: 'belfry', look: 'belfry', song: 'climb', rooms: 4, monsters: ['rattlebones', 'cinderling', 'penitent', 'ash_gargoyle'], levelFloor: 15, density: 0.9 }),\n  belfry2: Z({ id: 'belfry2', name: 'THE CRACKED BELFRY: THE LONG STAIR', kind: 'gen', biome: 'belfry', look: 'belfry', song: 'climb', rooms: 4, monsters: ['cinderling', 'penitent', 'clapperjaw', 'ash_gargoyle'], levelFloor: 16, density: 0.9 }),\n  belfry3: Z({ id: 'belfry3', name: 'THE CRACKED BELFRY: THE WIND LOFT', kind: 'gen', biome: 'belfry', look: 'belfry', song: 'climb', rooms: 4, monsters: ['rattlebones', 'penitent', 'clapperjaw', 'ash_gargoyle'], levelFloor: 17, density: 0.9 }),\n  belfry_top: Z({ id: 'belfry_top', name: 'BENEATH OLD CLEMENCY', kind: 'arena', arena: 'malison', biome: 'belfry', look: 'belfry', song: 'eventide', monsters: [], levelFloor: 18, boss: 'malison' }),\n  knell1: Z({ id: 'knell1', name: 'KNELL RUN: FIRST PASSAGE', kind: 'gen', biome: 'mix', look: 'crypt', song: 'knell', rooms: 13, monsters: ['peatwalker', 'rattlebones', 'choir_skull', 'pallid_bearer', 'tomb_crawler', 'bloat_deacon', 'cinderling', 'penitent', 'clapperjaw', 'ash_gargoyle', 'shade_acolyte', 'tithe_collector'], levelFloor: 12, knell: true }),\n  knell2: Z({ id: 'knell2', name: 'KNELL RUN: SECOND PASSAGE', kind: 'gen', biome: 'mix', look: 'cloister', song: 'knell', rooms: 14, monsters: ['peatwalker', 'rattlebones', 'choir_skull', 'pallid_bearer', 'tomb_crawler', 'bloat_deacon', 'cinderling', 'penitent', 'clapperjaw', 'ash_gargoyle', 'shade_acolyte', 'tithe_collector'], levelFloor: 12, knell: true }),\n  session: Z({ id: 'session', name: 'THE KNELL', kind: 'gen', biome: 'mix', look: 'crypt', song: 'knell', rooms: 17, monsters: ['peatwalker', 'rattlebones', 'choir_skull', 'pallid_bearer', 'tomb_crawler', 'bloat_deacon', 'cinderling', 'penitent', 'clapperjaw', 'ash_gargoyle', 'shade_acolyte', 'tithe_collector'], levelFloor: 12, knell: true, classFonts: true }),\n  titlescene: Z({ id: 'titlescene', name: 'TITLE', kind: 'arena', arena: 'title', biome: 'belfry', look: 'title', song: 'vespers', monsters: [], levelFloor: 1, safe: true }),\n};\nexport const LYCHGATE_ORDER = ['town', 'causeway', 'ossuary1', 'ossuary2', 'ossuary3', 'cloister', 'belfry1', 'belfry2', 'belfry3'];\nEOF\ncat > src/sim/zonegen.js <<'EOF'\n// Stitches ASCII rooms into a map from a seed. Same code on every client: a pure function of (seed, zone id).\nimport { NavGrid } from '../../pixel-engine.js';\nimport { BIOMES, BOSS_ROOMS, TOWN, YARD } from '../data/rooms.js';\nimport { ZONES } from '../data/zones.js';\n\nconst OPP = { N: 'S', S: 'N', W: 'E', E: 'W' };\nconst sockets = (t) => {\n  const out = [];\n  const H = t.rows.length; const W = t.rows[0].length;\n  t.rows.forEach((r, y) => { if (r.length !== W) throw new Error(`room ${t.name} row ${y} is ${r.length}, wanted ${W}`); });\n  for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {\n    if (t.rows[y][x] !== 'D') continue;\n    out.push({ x, y, side: y === 0 ? 'N' : y === H - 1 ? 'S' : x === 0 ? 'W' : 'E' });\n  }\n  return out;\n};\n\nfunction layoutRooms(rng, spec, biome) {\n  const pool = biome.rooms;\n  const placed = [];\n  const overlaps = (x, y, w, h) => placed.some((p) => x < p.x + p.w + 1 && p.x < x + w + 1 && y < p.y + p.h + 1 && p.y < y + h + 1);\n  const place = (t, x, y, depth, parent) => { const r = { t, x, y, w: t.rows[0].length, h: t.rows.length, depth, parent, used: new Set(), name: t.name }; placed.push(r); return r; };\n  place(biome.entrance, 0, 0, 0, null);\n  const attach = (t, preferDeep) => {\n    const opens = [];\n    for (const p of placed) for (const s of sockets(p.t)) if (!p.used.has(`${s.x},${s.y}`)) opens.push({ p, s });\n    rng.shuffle(opens);\n    if (preferDeep) opens.sort((a, b) => b.p.depth - a.p.depth);\n    if (spec.linear) opens.sort((a, b) => (b.s.side === 'E' ? 1 : 0) - (a.s.side === 'E' ? 1 : 0) || (b.p.x + b.s.x) - (a.p.x + a.s.x));\n    for (const { p, s } of opens) {\n      const tsocks = sockets(t).filter((q) => q.side === OPP[s.side]);\n      rng.shuffle(tsocks);\n      for (const q of tsocks) {\n        const dx = s.side === 'E' ? 1 : s.side === 'W' ? -1 : 0;\n        const dy = s.side === 'S' ? 1 : s.side === 'N' ? -1 : 0;\n        const x = p.x + s.x + dx - q.x;\n        const y = p.y + s.y + dy - q.y;\n        if (overlaps(x, y, t.rows[0].length, t.rows.length)) continue;\n        p.used.add(`${s.x},${s.y}`);\n        const r = place(t, x, y, p.depth + 1, p);\n        r.used.add(`${q.x},${q.y}`);\n        return r;\n      }\n    }\n    return null;\n  };\n  const special = (spec.include ?? []).map((k) => biome.special?.[k]).filter(Boolean);\n  const count = spec.rooms - 2;\n  const midAt = Math.floor(count / 2);\n  for (let i = 0; i < count; i++) {\n    if (special.length && i === midAt) { for (const t of special) if (!attach(t, spec.linear)) return null; }\n    const shuffled = rng.shuffle([...pool]);\n    let ok = null;\n    for (const t of shuffled) { ok = attach(t, spec.linear || i % 3 !== 2); if (ok) break; }\n    if (!ok) return null;\n  }\n  return attach(biome.exit, true) ? placed : null;\n}\n\nconst mixBiome = () => ({\n  rooms: [...BIOMES.crypt.rooms, ...BIOMES.cloister.rooms, ...BIOMES.belfry.rooms],\n  entrance: BIOMES.crypt.entrance,\n  exit: BIOMES.belfry.exit,\n});\n\nconst blank = () => ({ lights: [], spawns: [], breakables: [], chests: [], traps: [], shrines: [], named: [], gates: [], marks: [] });\nfunction readMarker(z, ch, x, y, namedList, room) {\n  const at = { x: x + 0.5, z: y + 0.5, room };\n  switch (ch) {\n    case 'L': z.lights.push(at); break;\n    case 'S': z.spawns.push({ ...at, kind: 'S' }); break;\n    case 'E': z.spawns.push({ ...at, kind: 'E' }); break;\n    case 'B': z.breakables.push(at); break;\n    case 'C': z.chests.push(at); break;\n    case 'T': z.traps.push(at); break;\n    case 'A': z.shrines.push(at); break;\n    case 'G': z.gates.push(at); break;\n    case 'X': z.marks.push({ ...at, kind: 'X' }); break;\n    case 'Y': z.marks.push({ ...at, kind: 'Y' }); break;\n    case 'N': { const id = namedList?.[namedList.cursor++ % namedList.length]; if (id) z.named.push({ ...at, id }); break; }\n    default: if (/[a-zA-Z]/.test(ch)) z.marks.push({ ...at, kind: ch });\n  }\n}\n\nfunction fromAuthored(spec, def) {\n  const z = blank();\n  const list = def.named ? [...def.named] : null; if (list) list.cursor = 0;\n  const rows = def.rows.map((r, y) => [...r].map((c, x) => { if (c !== '#' && c !== '.' && c !== '~') { readMarker(z, c, x, y, list, 0); return '.'; } return c; }).join(''));\n  z.rows = rows; z.w = rows[0].length; z.h = rows.length; z.roomRects = [{ x: 0, y: 0, w: z.w, h: z.h, name: spec.id, depth: 0 }];\n  return z;\n}\n\nfunction arenaRows(kind) {\n  const def = BOSS_ROOMS[kind] ?? { w: 31, h: 31 };\n  const { w, h } = def; const rows = [];\n  const z = blank();\n  const cx = w / 2; const cy = h / 2;\n  for (let y = 0; y < h; y++) {\n    let r = '';\n    for (let x = 0; x < w; x++) {\n      const edge = x === 0 || y === 0 || x === w - 1 || y === h - 1;\n      if (kind === 'malison' || kind === 'title') {\n        const d = Math.hypot(x + 0.5 - cx, y + 0.5 - cy);\n        const R = Math.min(w, h) / 2 - 1;\n        r += d >= R + 1 ? ' ' : d >= R ? '#' : '.';\n      } else r += edge ? '#' : '.';\n    }\n    rows.push(r);\n  }\n  z.rows = rows; z.w = w; z.h = h; z.roomRects = [{ x: 0, y: 0, w, h, name: kind, depth: 0 }];\n  z.marks.push({ x: cx, z: h - 4.5, kind: 'X', room: 0 });\n  if (kind === 'countinghouse') {\n    for (const [x, y] of [[5, 5], [w - 6, 5], [5, h - 6], [w - 6, h - 6], [cx, 4], [cx, h - 3]]) z.lights.push({ x: x + 0.5, z: y + 0.5, room: 0 });\n    for (const [x, y, id] of [[8, 8, 'gold-pile'], [w - 9, 8, 'gold-pile'], [8, h - 9, 'gold-pile'], [w - 9, h - 9, 'gold-pile'], [5, cy, 'desk'], [w - 6, cy, 'desk'], [cx - 7, 3, 'strongbox'], [cx + 7, 3, 'strongbox']]) z.named.push({ x: x + 0.5, z: y + 0.5, id, room: 0 });\n  }\n  if (kind === 'malison') {\n    for (let i = 0; i < 8; i++) { const a = (i / 8) * Math.PI * 2; z.lights.push({ x: cx + Math.cos(a) * 16, z: cy + Math.sin(a) * 16, room: 0 }); }\n  }\n  return z;\n}\n\nfunction fromRooms(rng, spec) {\n  const biome = spec.biome === 'mix' ? mixBiome() : BIOMES[spec.biome];\n  let placed = null;\n  for (let attempt = 0; attempt < 40 && !placed; attempt++) placed = layoutRooms(rng.fork(`try:${attempt}`), spec, biome);\n  if (!placed) throw new Error(`zonegen failed for ${spec.id}`);\n  let minX = Infinity; let minY = Infinity; let maxX = -Infinity; let maxY = -Infinity;\n  for (const p of placed) { minX = Math.min(minX, p.x); minY = Math.min(minY, p.y); maxX = Math.max(maxX, p.x + p.w); maxY = Math.max(maxY, p.y + p.h); }\n  const pad = 3;\n  const w = maxX - minX + pad * 2; const h = maxY - minY + pad * 2;\n  const g = Array.from({ length: h }, () => new Array(w).fill(' '));\n  const z = blank();\n  z.roomRects = [];\n  placed.forEach((p, i) => {\n    const ox = p.x - minX + pad; const oy = p.y - minY + pad;\n    p.ox = ox; p.oy = oy;\n    z.roomRects.push({ x: ox, y: oy, w: p.w, h: p.h, name: p.name, depth: p.depth, parent: p.parent ? placed.indexOf(p.parent) : -1 });\n    const list = p.t.named ? [...p.t.named] : null; if (list) list.cursor = 0;\n    p.t.rows.forEach((row, y) => [...row].forEach((c, x) => {\n      const gx = ox + x; const gy = oy + y;\n      let out = c;\n      if (c === 'D') out = p.used.has(`${x},${y}`) ? '.' : '#';\n      else if (c !== '#' && c !== '.' && c !== '~') {\n        // X is only meaningful in the first and last rooms; Y is the special event spot.\n        readMarker(z, c, gx, gy, list, i);\n        out = '.';\n      }\n      g[gy][gx] = out;\n    }));\n  });\n  z.rows = g.map((r) => r.join('')); z.w = w; z.h = h;\n  return z;\n}\n\nexport function generateZone(rootRng, zoneId) {\n  const spec = ZONES[zoneId];\n  const rng = rootRng.fork(`zone:${zoneId}`);\n  let z;\n  if (spec.kind === 'authored') z = fromAuthored(spec, spec.id === 'yard' ? YARD : TOWN);\n  else if (spec.kind === 'arena') z = arenaRows(spec.arena);\n  else z = fromRooms(rng, spec);\n  z.id = zoneId; z.spec = spec;\n  z.nav = NavGrid.fromRows(z.rows, { blocked: '#~ ', ox: 0, oz: 0 });\n  const xs = z.marks.filter((m) => m.kind === 'X');\n  z.entrance = xs[0] ?? { x: z.w / 2, z: z.h / 2 };\n  z.exit = xs.length > 1 ? xs[xs.length - 1] : xs[0];\n  return z;\n}\nexport const zoneHash = (z) => { let h = 7; for (const r of z.rows) for (let i = 0; i < r.length; i++) h = (h * 31 + r.charCodeAt(i)) | 0; return h; };\nEOF\ncat > tools/scratch/zt.mjs <<'EOF'\nimport { Rng, NavGrid } from '../../pixel-engine.js';\nimport { generateZone } from '../../src/sim/zonegen.js';\nimport { ZONES } from '../../src/data/zones.js';\nconst n=new NavGrid(4,4,{ox:0,oz:0}); console.log(n.ox,n.oz,n.cell,n.centerX(0));\nfor (const id of Object.keys(ZONES)) { let bad=0,t=Date.now(); for(let s=0;s<30;s++){const z=generateZone(new Rng(s+1),id); if(!z.nav.path([z.entrance.x,0,z.entrance.z],[z.exit.x,0,z.exit.z])) bad++;}\nconst z=generateZone(new Rng(1),id); console.log(id,z.w,z.h,'bad',bad,'S',z.spawns.length,'ms',Date.now()-t); }\nconst z=generateZone(new Rng(3),'causeway'); console.log(z.rows.join('\\n').slice(0,1500));\nEOF\nnode tools/scratch/zt.mjs 2>&1 | cut -c1-230 | tail -60","description":"Write zone generator and test it across seeds"}}}
