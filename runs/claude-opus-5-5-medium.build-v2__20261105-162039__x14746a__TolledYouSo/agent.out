to samples once, then played as a buffer. Deterministic (seeded noise), so\n49:    if (f.includes('src/sim')) { ok(!/Math\\.random|performance\\.now/.test(t), `nondeter\n11:5. Physics: `BoxOptions`, `Breakable`, `BreakableOptions`, `Breakables`, `BridgeOptions`, `Built`, `chain`, `ChainOptions`, `CharacterAnim`, `CharacterController`, `CharacterOptions`, `Chunk`, `clothGrid`, `ClothOptions`, `Crumble`, `CrumbleOptions`, `DoorOptions`, `DriveInput`, `explode`, `ExplosionOptions`, `Field`, `fieldAcceleration`, `FieldOptions`, `FIXED_DT`, `FloaterOptions`, `Floaters`, `ForceFields`, `fractureBox`, `FractureOptions`, `hingeDoor`, `InstancedBodies`, `InstancedBodiesOptions`, `InstancedShape`, `KinematicBody`, `Mover`, `MoverOptions`, `moverRotation`, `Movers`, `orbit`, `pathPoint`, `pendulum`, `Physics`, `PhysicsState`, `Ragdoll`, `RagdollOptions`, `RagdollPart`, `Rewind`, `RewindOptions`, `RippleField`, `RippleOptions`, `ropeBridge`, `ropeLine`, `seeded`, `seesaw`, `SeesawOptions`, `softBlob`, `springPad`, `SpringPadOptions`, `Trigger`, `TriggerOptions`, `TriggerShape`, `Vehicle`, `VehicleOptions`, `VerletBody`, `VerletOptions`, `waterHeight`, `WaterWave`, `WAVES_CALM`, `WAVES_CHOPPY`","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01MRGrSjkYL5cpnycgttzsnn","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
