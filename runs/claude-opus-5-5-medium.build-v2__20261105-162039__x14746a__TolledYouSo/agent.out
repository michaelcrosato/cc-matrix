 name: 'A FALLING BEAM', vfx: 'ring_fire', sfx: 'beam_fall', shake: 0.25, color: 'orange' }); w.beamsFell = (w.beamsFell ?? 0) + 1; } }\n  }\"\"\")\nopen(p,'w').write(s)\np='src/ui/devmode.js'; s=open(p).read()\ns=s.replace(\"...Object.values(MONSTERS).filter((m) => !m.boss).map((m) => ({ label: m.name, run: dev('spawn', { type: m.id }) })),\",\"...Object.values(MONSTERS).map((m) => ({ label: m.boss ? `BOSS: ${m.name}` : m.name, run: dev('spawn', { type: m.id }) })),\")\nopen(p,'w').write(s)\n# Adaptive boss life\np='src/sim/bosses.js'; s=open(p).read()\ns=s.replace(\"export function startBoss(w, m) {\\n  const k = m.defn.boss;\",\"\"\"// Story bosses are sized to the party that reached them, so a fight lasts its intended time whatever the loot rolled.\nconst FIGHT_SECONDS = { bursar: 105, malison: 150 };\nconst CLASS_PACE = { bellwarden: 2.6, lamplighter: 3.6, sexton: 3.2 };\nfunction sizeBoss(w, m) {\n  const secs = FIGHT_SECONDS[m.defn.boss]; if (!secs) return;\n  let dps = 0; for (const h of w.heroes) if (!h.left && h.stats) dps += damageRating(h) * (CLASS_PACE[h.cls] ?? 3);\n  if (dps <= 0) return;\n  m.maxHp = Math.round(Math.max(m.maxHp * 0.25, Math.min(m.maxHp * 4, dps * secs)) * w.tuning.monsterHp * Math.sqrt(w.diff.hp)); m.hp = m.maxHp;\n}\nexport function startBoss(w, m) {\n  sizeBoss(w, m);\n  const k = m.defn.boss;\"\"\")\ns=s.replace(\"import { damageHero } from './hero.js';\",\"import { damageHero } from './hero.js';\\nimport { damageRating } from './stats.js';\")\nopen(p,'w').write(s)\n# per-run assert\np='tools/report.mjs'; s=open(p).read()\ns=s.replace(\"if (bu?.end) (times.b[cls] ??= []).push((bu.end - bu.start) / 60); if (ma?.end) (times.m[cls] ??= []).push((ma.end - ma.start) / 60);\",\"if (bu?.end) { const t = (bu.end - bu.start) / 60; check(t >= 60 && t <= 180, `Bursar 60-180 s, ${cls} seed ${seed}: ${t.toFixed(0)}`); } else check(false, 'Bursar killed'); if (ma?.end) { const t = (ma.end - ma.start) / 60; check(t >= 120 && t <= 300, `Malison 120-300 s, ${cls} seed ${seed}: ${t.toFixed(0)}`); } else check(false, 'Malison killed');\")\ns=s.replace(\"// Boss length is judged class by class, averaged over the seeds: a single run swings with the loot it found.\\nconst mean = (a) => a.reduce((x, y) => x + y, 0) / a.length;\\n\",\"\")\ns=re.sub(r\"if \\(assert\\) \\{ for \\(const \\[k, v\\] of Object\\.entries\\(times\\.b\\)\\).*\\n\",\"\",s)\nopen(p,'w').write(s)\nEOF\nSEEDS=11,23,47 node tools/report.mjs --assert 2>&1 | grep -E \"SOFTLOCK|REPORT|TARGET|bosses\" | sed -E 's/ drops.*//' | cut -c1-110","description":"Implement the audit gaps, make boss timing per run","timeout":400000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5387,"cache_read_input_tokens":842338,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5387},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"69254de6-4061-470e-8e76-10f1ee96c6e5","uuid":"aad53c95-61f0-4a69-b6c8-a3b901c6711b","timestamp":"2026-11-06T01:58:17.231Z","request_id":"req_011CgkqvHuomMa8Ngo3E8GPZ","wire_tool_inputs":{"toolu_01R6LRJxdQESqM4xBFAiqy2Z":{"command":"sed -n 1385p API.md | cut -c1-700; sed -n 2628,2640p API.md | cut -c1-130; grep -n \"interface Listener\" -A5 API.md | cut -c1-120\npython3 - <<'EOF'\nimport re\n# A. spring bell + ragdoll dissolve + props dissolve + stinger + per-type monster sounds\np='src/view/actors.js'; s=open(p).read()\ns=s.replace(\"const up = new Vector3(0, 1, 0); const tmp = new Vector3();\\nfunction setSeg(\",\"const up = new Vector3(0, 1, 0); const tmp = new Vector3();\\nexport function setSeg(\")\ns=s.replace(\"\"\"// Bodies that bend: Malison's four great rope-wrapped arms.\"\"\",\"\"\"// The Bellwarden's great bell really hangs: a SpringChain from the hand, with the bell on its end.\nexport class BellChain {\n  constructor(ctx, actor) {\n    this.ctx = ctx; this.actor = actor; this.spring = new SpringChain({ segments: 3, length: 0.2, rest: [0, -1, 0], stiffness: 9, keep: 0.93, gravity: 9 });\n    const mat = toonMaterial(PALETTE.mist); this.links = [0, 1, 2].map(() => { const m = new Mesh(limbGeo, mat); m.castShadow = true; setLookLayer(m, 'actors'); ctx.scene.add(m); return m; });\n    const b = buildModel('hand_bell', { catalog: MODELS }); this.bell = b.object; this.bell.scale.setScalar(0.62); this.bell.traverse((m) => { if (m.isMesh) { m.castShadow = true; actor.meshes.push(m); actor.mats.push(m.material); } }); setLookLayer(this.bell, 'actors'); ctx.scene.add(this.bell);\n    this.hand = actor.body.getObjectByName('HandR'); this.root = [0, 0, 0]; this.v = new Vector3();\n    this.basis = [[1, 0, 0], [0, 1, 0], [0, 0, 1]];\n  }\n  update(dt) {\n    if (dt <= 0) return;\n    this.actor.root.updateMatrixWorld(true); this.hand.getWorldPosition(this.v); this.root[0] = this.v.x; this.root[1] = this.v.y; this.root[2] = this.v.z;\n    this.spring.update(dt, this.root, this.basis); const pts = this.spring.points;\n    for (let i = 0; i < 3; i++) setSeg(this.links[i], pts[i], pts[i + 1], 0.05);\n    const tip = pts[3]; const prev = pts[2]; const dx = tip[0] - prev[0]; const dz = tip[2] - prev[2];\n    this.bell.position.set(tip[0], Math.max(0.05, tip[1] - 0.92 * 0.62), tip[2]); this.bell.rotation.set(dz * 2, 0, -dx * 2);\n  }\n  dispose() { const { scene } = this.ctx; for (const m of this.links) scene.remove(m); scene.remove(this.bell); }\n}\n\n// Bodies that bend: Malison's four great rope-wrapped arms.\"\"\")\ns=s.replace(\"    if (this.doll) { this.doll.disable(); this.doll = null; }\\n\",\"    if (this.doll) { this.doll.disable(); this.doll = null; }\\n    if (this.bellChain) { this.bellChain.dispose(); this.bellChain = null; }\\n\")\ns=s.replace(\"  flash(n = 3) { this.flashN = n; }\",\"\"\"  flash(n = 3) { this.flashN = n; }\n  // Per-body dissolve clones, made only at death: a ragdoll goes out in pixels.\n  startDissolve() { if (this.dissolving) return; this.dissolving = this.meshes.map((m, i) => { const c = dissolveClone(this.mats[i]); m.material = c; return c; }); }\n  setDissolve(v) { for (const c of this.dissolving ?? []) if (c) c.dissolve = v; }\"\"\")\ns=s.replace(\"export const SEAT_COLORS =\",\"\"\"export function dissolveClone(mat) { const c = toonMaterial(mat.color ? mat.color.getHex() : PALETTE.white, { dissolve: true, ...(mat.map ? { map: mat.map } : {}) }).clone(); c.dissolve = 0; return c; }\nexport const SEAT_COLORS =\"\"\")\nopen(p,'w').write(s)\np='src/view/view.js'; s=open(p).read()\ns=s.replace(\"import { Actor, HELMS, MalisonArms, PAULS,\",\"import { Actor, BellChain, HELMS, MalisonArms, PAULS,\")\ns=s.replace(\"\"\"    if (h.cls === 'bellwarden') { a.bellObj = add('HandR', 'hand_bell', { at: [0, -0.92, 0.28], rot: [20, 0, 0], scale: 0.85 }); }\n    else if\"\"\",\"\"\"    if (h.cls === 'bellwarden') { if (!a.bellChain) a.bellChain = new BellChain(this.ctx, a); }\n    else if\"\"\")\ns=s.replace(\"      if (a.bellObj) { a.bellS = (a.bellS ?? 0) + ((h.moving ? -0.3 : 0) - (a.bellS ?? 0)) * Math.min(1, dt * 6); a.bellObj.rotation.x = 0.35 + a.bellS + Math.sin(time * 9) * (h.moving ? 0.1 : 0.02); }\\n\",\"      a.bellChain?.update(dt);\\n\")\ns=s.replace(\"\"\"if (d.t > 2.2) { const k = 1 - (d.t - 2.2) / 0.5; if (k <= 0) { d.doll?.disable(); d.actor.dispose(); this.dolls.splice(i, 1); continue; } d.actor.root.scale.setScalar(Math.max(0.01, k)); }\"\"\",\"\"\"if (d.t > 2.2) { d.actor.startDissolve(); const k = (d.t - 2.2) / 0.6; if (k >= 1) { d.doll?.disable(); d.actor.dispose(); this.dolls.splice(i, 1); continue; } d.actor.setDissolve(k); }\"\"\")\ns=s.replace(\"\"\"        if (a.humanoid) a.play(ev.clip, ev.dur); else { a.pulseT = ev.dur; a.squash.kick(ev.hop ? 3 : 1); }\n\"\"\",\"\"\"        if (a.humanoid) a.play(ev.clip, ev.dur); else { a.pulseT = ev.dur; a.squash.kick(ev.hop ? 3 : 1); }\n        if (!ev.ally && a.type) playAt(ctx, 'monster_swing', a.root.position.x, a.root.position.z, focus, { pitch: typePitch(a.type), volume: 0.5 });\n\"\"\")\ns=s.replace(\"\"\"    playAt(this.ctx, HITSFX[d?.material] ?? 'hit_flesh', px, pz, this.focus, { pitch: this.rng.int(-4, -1) });\n\"\"\",\"\"\"    playAt(this.ctx, HITSFX[d?.material] ?? 'hit_flesh', px, pz, this.focus, { pitch: this.rng.int(-4, -1) });\n    playAt(this.ctx, 'monster_die', px, pz, this.focus, { pitch: typePitch(ev.type), volume: 0.6 });\n\"\"\")\ns=s.replace(\"const NPC_PALETTE = {};\",\"const NPC_PALETTE = {};\\n// Each monster type has its own voice: the same sounds at its own pitch.\\nconst typePitch = (t) => { let h = 7; for (let i = 0; i < t.length; i++) h = (h * 31 + t.charCodeAt(i)) >>> 0; return (h % 15) - 7; };\")\ns=s.replace(\"\"\"      case 'hit': {\n        const a = this.monsters.get(ev.id); a?.flash(2); a?.squash.kick(-1.5);\"\"\",\"\"\"      case 'boss': if (ev.on) { ctx.audio.play('boss_sting'); this.host.addShake(0.3); } break;\n      case 'hit': {\n        const a = this.monsters.get(ev.id); a?.flash(2); a?.squash.kick(-1.5); if (a && a.type && this.rng.chance(0.2)) playAt(ctx, 'monster_hurt', ev.x, ev.z, focus, { pitch: typePitch(a.type), volume: 0.4 });\"\"\")\ns=s.replace(\"\"\"      case 'maggro': if (this.rng.chance(0.25)) playAt(ctx, 'wake', ev.x, ev.z, focus, { pitch: this.rng.int(-4, 4), volume: 0.5 }); break;\"\"\",\"\"\"      case 'maggro': if (this.rng.chance(0.25)) playAt(ctx, 'wake', ev.x, ev.z, focus, { pitch: typePitch(ev.type ?? 'x'), volume: 0.5 }); break;\"\"\")\n# spatial fire\ns=s.replace(\"    // Weather and motes.\\n\",\"\"\"    // A fire voice sits at the nearest flame, spatial, muffled past a wall.\n    this.fireVoice(w);\n    // Weather and motes.\n\"\"\")\ns=s.replace(\"  heroById(w, id) {\",\"\"\"  fireVoice(w) {\n    const lights = w.zone.lights; if (!lights?.length) return; const f = this.focus; let best = null; let bd = 1e9;\n    if (this.ctx.engine.frame % 15) return;\n    for (const l of lights) { const d = (l.x - f.x) ** 2 + (l.z - f.z) ** 2; if (d < bd) { bd = d; best = l; } }\n    this.flameVoice ??= this.ctx.audio.loop(LOOPS.fire, { volume: 0 });\n    const s = spatialize({ position: [f.x, 1, f.z], right: [0.7071, 0, -0.7071] }, [best.x, 1, best.z], { max: 12 });\n    this.flameVoice.set?.({ volume: s.gain * 0.8, pan: s.pan, muffle: w.zone.nav.lineOfSight(f.x, f.z, best.x, best.z) ? 0 : 0.8 });\n  }\n  heroById(w, id) {\"\"\")\ns=s.replace(\"import { buildModel, Decals, disposeObject,\",\"import { buildModel, Decals, disposeObject, spatialize,\")\ns=s.replace(\"import { playAt } from '../audio/music.js';\",\"import { playAt } from '../audio/music.js';\\nimport { LOOPS } from '../audio/sfxdata.js';\")\nopen(p,'w').write(s)\np='src/audio/sfxdata.js'; s=open(p).read()\ns=s.replace(\"  ui_move: {\",\"\"\"  monster_swing: noise(1000, 0.1, 0.12, { freqEnd: 400 }),\n  monster_die: { wave: 'saw', freq: 170, freqEnd: 60, decay: 0.28, volume: 0.15, vibrato: { depth: 1, rate: 10 } },\n  monster_hurt: { wave: 'square', duty: 0.25, freq: 260, freqEnd: 170, decay: 0.09, volume: 0.1 },\n  boss_sting: { wave: 'saw', freq: 110, freqEnd: 55, decay: 1.1, volume: 0.25, layers: [bell(147, 1.3, 0.3), { wave: 'saw', freq: 165, freqEnd: 82, decay: 1, volume: 0.15 }] },\n  beam_fall: { wave: 'noise', freq: 1600, freqEnd: 120, decay: 0.5, volume: 0.42, layers: [{ wave: 'sine', freq: 90, freqEnd: 40, decay: 0.3, volume: 0.42 }] },\n  ui_move: {\"\"\",1)\nopen(p,'w').write(s)\n# dissolve tall props\np='src/view/zonebuild.js'; s=open(p).read()\ns=s.replace(\"\"\"      if (o.fadeHidden !== hide) { o.fadeHidden = hide; o.traverse((m) => { if (m.isMesh) m.visible = !hide; }); }\n\"\"\",\"\"\"      // Per-prop dissolve clones, made the first time a prop has to step aside.\n      if (hide && !o.userData.fade) { o.userData.fade = []; o.traverse((m) => { if (m.isMesh && m.material?.color && !m.material.isMeshBasicNodeMaterial) { const c = dissolveClone(m.material); m.material = c; o.userData.fade.push(c); } }); o.userData.fadeK = 0; }\n      if (o.userData.fade) { const want = hide ? 0.85 : 0; const k = o.userData.fadeK + Math.sign(want - o.userData.fadeK) * Math.min(Math.abs(want - o.userData.fadeK), 0.06); if (k !== o.userData.fadeK) { o.userData.fadeK = k; for (const c of o.userData.fade) c.dissolve = k; } }\n\"\"\")\ns=s.replace(\"import { MODELS } from './models/props.js';\",\"import { MODELS } from './models/props.js';\\nimport { dissolveClone } from './actors.js';\")\nopen(p,'w').write(s)\n# Seat frame\np='src/ui/menus.js'; s=open(p).read()\ns=s.replace(\"    fn.call(this, ui, s, w, h, m);\\n\",\"\"\"    fn.call(this, ui, s, w, h, m);\n    // On the couch, the panel is framed in the colour of the seat that owns it.\n    if (this.play.localSeats().length > 1 && h && this.top) { const c = ['red', 'blue', 'lime', 'sand'][h.seat] ?? 'white'; ui.rect(0, 0, ui.W, 2, c); ui.rect(0, ui.H - 2, ui.W, 2, c); ui.rect(0, 0, 2, ui.H, c); ui.rect(ui.W - 2, 0, 2, ui.H, c); ui.seatFrame = h.seat; }\n\"\"\")\n# Gear compare on Triangle\ns=s.replace(\"\"\"    const cy = Y + CELL * 5 + 4; itemCard(ui, 12, cy, ui.W - 24, Math.max(40, ui.H - cy - 18), focused, h, w);\n    footer(ui, [['confirm', 'EQUIP'], ['x', 'SALVAGE'], ['back', 'BACK']]);\"\"\",\"\"\"    if (m.y) s.compare = !s.compare;\n    const worn = focused ? h.gear[focused.slot] : null; const showing = s.compare && worn && worn !== focused ? worn : focused;\n    const cy = Y + CELL * 5 + 4; itemCard(ui, 12, cy, ui.W - 24, Math.max(40, ui.H - cy - 18), showing, h, w);\n    if (s.compare && worn && worn !== focused) ui.textR(ui.W - 18, cy + 4, 'WORN NOW', { color: 'lime' });\n    footer(ui, [['confirm', 'EQUIP'], ['x', 'SALVAGE'], ['y', s.compare ? 'THIS ONE' : 'COMPARE'], ['back', 'BACK']]);\"\"\")\nopen(p,'w').write(s)\n# Dialogue choices\np='src/data/dialog.js'; s=open(p).read()\ns=s.replace(\"  crier_idle: [L('crier', 'Hear ye. Nothing has improved. Details at dusk.')],\",\"\"\"  crier_idle: [{ who: 'crier', text: 'Hear ye. Nothing has improved. Details at dusk.', choices: [{ label: 'WHAT OF THE BELL?', next: 'crier_bell' }, { label: 'WHAT OF YOUR BODY?', next: 'crier_body' }, { label: 'GOOD DAY.', next: null }] }],\n  crier_bell: [L('crier', 'Cast from ten thousand burial rings, they say. It told the dead to stay down, in two words, every dusk. Now it uses other words.')],\n  crier_body: [L('crier', 'Somewhere on the Causeway, I expect, still walking. It always had the better legs. I send it a note at Michaelmas.')],\"\"\")\ns=s.replace(\"  ambrose_early: [L('ambrose', 'They have buried me three times, my child. One learns to keep a spade in the coffin.'), L('ambrose', 'Do not trouble yourself about the bell. These things are all in hand. Whose hand, is a matter of paperwork.')],\",\"\"\"  ambrose_early: [L('ambrose', 'They have buried me three times, my child. One learns to keep a spade in the coffin.'), { who: 'ambrose', text: 'Do not trouble yourself about the bell. These things are all in hand. Whose hand, is a matter of paperwork.', choices: [{ label: 'WHOSE HAND?', next: 'ambrose_hand' }, { label: 'BLESS YOU, BISHOP.', next: null }] }],\n  ambrose_hand: [L('ambrose', 'A kindly one, my child. Do wipe your feet on the way out.')],\"\"\")\nopen(p,'w').write(s)\np='src/modes/play.js'; s=open(p).read()\ns=s.replace(\"\"\"    prompt(ui, X + W - 22, Y + H - 15, 'confirm');\n\"\"\",\"\"\"    if (line.choices && d.t > 0.15) {\n      const CH = line.choices.length * 15 + 4; const cy = Y - CH - 2; ui.frame(X, cy, W, CH, 'slate', 'ink');\n      line.choices.forEach((c, i) => { if (ui.button(`choice:${i}`, X + 3, cy + 3 + i * 15, W - 6, 14, c.label, { align: 'left' })) { this.voice.stop(); this.lastChoice = c.label; if (c.next) { const after = d.after; this.dialog = { lines: DIALOG[c.next], i: 0, pause: d.pause, after, focus: d.focus, key: c.next, holdT: 0, t: 0, spoke: false }; } else this.finishDialog(); } });\n      return;\n    }\n    prompt(ui, X + W - 22, Y + H - 15, 'confirm');\n\"\"\")\nopen(p,'w').write(s)\n# Trail on projectiles and swings\np='src/view/vfx.js'; s=open(p).read()\ns=s.replace(\"import { buildModel, glowMaterial, PALETTE, setLookLayer, THREE, toonMaterial } from\",\"import { buildModel, glowMaterial, PALETTE, setLookLayer, THREE, toonMaterial, Trail } from\")\ns=s.replace(\"\"\"    f.update = (dt) => { f.x += f.vx * dt; f.z += f.vz * dt; f.travelled += Math.hypot(f.vx, f.vz) * dt; m.position.set(f.x, 0.9, f.z); f.t += dt;\"\"\",\"\"\"    const trail = s.flat ? null : new Trail({ width: Math.max(0.12, s.s), life: 0.25, color: PALETTE[col], tail: PALETTE.ink, points: 12 }); if (trail) this.root.add(trail);\n    f.update = (dt) => { f.x += f.vx * dt; f.z += f.vz * dt; f.travelled += Math.hypot(f.vx, f.vz) * dt; m.position.set(f.x, 0.9, f.z); f.t += dt; if (trail) { trail.push(m.position, f.t); trail.update(f.t, this.ctx.camera.camera); }\"\"\")\ns=s.replace(\"f.end = () => { this.root.remove(m); f.light?.release(); };\",\"f.end = () => { this.root.remove(m); f.light?.release(); if (trail) { this.root.remove(trail); trail.dispose(); } };\")\ns=s.replace(\"\"\"    for (let i = 0; i < 6; i++) { const m = this.mesh(BOX, COL(col), x, 0.9, z); m.scale.set(0.5, 0.12, 0.12); segs.push(m); }\n    let t = 0;\n    this.add({ update: (dt) => { t += dt; const k = Math.min(1, t / 0.14); segs.forEach((m, i) => { const a = base - 1 + (i / 5) * 2 * k; m.position.set(x + Math.sin(a) * R, 0.9, z + Math.cos(a) * R); m.rotation.y = a + Math.PI / 2; m.visible = t < 0.16; }); return t < 0.18; }, end: () => { this.root.remove(...segs); } });\"\"\",\"\"\"    for (let i = 0; i < 2; i++) { const m = this.mesh(BOX, COL(col), x, 0.9, z); m.scale.set(0.3, 0.12, 0.12); segs.push(m); }\n    const trail = new Trail({ width: 0.4, life: 0.16, color: PALETTE[col], tail: PALETTE.ink, points: 16 }); this.root.add(trail); const p = new Vector3();\n    let t = 0;\n    this.add({ update: (dt) => { t += dt; const k = Math.min(1, t / 0.14); const a = base - 1 + 2 * k; p.set(x + Math.sin(a) * R, 0.9, z + Math.cos(a) * R); segs[0].position.copy(p); segs[0].visible = t < 0.15; segs[1].visible = false; trail.push(p, t); trail.update(t, this.ctx.camera.camera); return t < 0.3; }, end: () => { this.root.remove(...segs); this.root.remove(trail); trail.dispose(); } });\"\"\")\nopen(p,'w').write(s)\n# Falling beams in the Cloister, any boss in dev spawn\np='src/sim/quests.js'; s=open(p).read()\ns=s.replace(\"  if (id === 'cloister') { stepNovices(w); }\",\"\"\"  if (id === 'cloister') {\n    stepNovices(w);\n    // Falling beams: the roof is still coming down.\n    w.zone.beamT = (w.zone.beamT ?? 7) - DT;\n    if (w.zone.beamT <= 0) { w.zone.beamT = 7 + w.rngs.quest.range(0, 4); const h = w.heroes.find((q) => !q.left && !q.dead); if (h && w.active.some((m) => near(m, h.x, h.z, 14))) { const p = findOpenNear(w, h.x + w.rngs.quest.range(-3, 3), h.z + w.rngs.quest.range(-3, 3)); telegraph(w, { kind: 'circle', x: p.x, z: p.z, r: 1.8, dur: 1, dmg: 10 + h.level * 3, level: h.level, name: 'A FALLING BEAM', vfx: 'ring_fire', sfx: 'beam_fall', shake: 0.25, color: 'orange' }); w.beamsFell = (w.beamsFell ?? 0) + 1; } }\n  }\"\"\")\nopen(p,'w').write(s)\np='src/ui/devmode.js'; s=open(p).read()\ns=s.replace(\"...Object.values(MONSTERS).filter((m) => !m.boss).map((m) => ({ label: m.name, run: dev('spawn', { type: m.id }) })),\",\"...Object.values(MONSTERS).map((m) => ({ label: m.boss ? `BOSS: ${m.name}` : m.name, run: dev('spawn', { type: m.id }) })),\")\nopen(p,'w').write(s)\n# Adaptive boss life\np='src/sim/bosses.js'; s=open(p).read()\ns=s.replace(\"export function startBoss(w, m) {\\n  const k = m.defn.boss;\",\"\"\"// Story bosses are sized to the party that reached them, so a fight lasts its intended time whatever the loot rolled.\nconst FIGHT_SECONDS = { bursar: 105, malison: 150 };\nconst CLASS_PACE = { bellwarden: 2.6, lamplighter: 3.6, sexton: 3.2 };\nfunction sizeBoss(w, m) {\n  const secs = FIGHT_SECONDS[m.defn.boss]; if (!secs) return;\n  let dps = 0; for (const h of w.heroes) if (!h.left && h.stats) dps += damageRating(h) * (CLASS_PACE[h.cls] ?? 3);\n  if (dps <= 0) return;\n  m.maxHp = Math.round(Math.max(m.maxHp * 0.25, Math.min(m.maxHp * 4, dps * secs)) * w.tuning.monsterHp * Math.sqrt(w.diff.hp)); m.hp = m.maxHp;\n}\nexport function startBoss(w, m) {\n  sizeBoss(w, m);\n  const k = m.defn.boss;\"\"\")\ns=s.replace(\"import { damageHero } from './hero.js';\",\"import { damageHero } from './hero.js';\\nimport { damageRating } from './stats.js';\")\nopen(p,'w').write(s)\n# per-run assert\np='tools/report.mjs'; s=open(p).read()\ns=s.replace(\"if (bu?.end) (times.b[cls] ??= []).push((bu.end - bu.start) / 60); if (ma?.end) (times.m[cls] ??= []).push((ma.end - ma.start) / 60);\",\"if (bu?.end) { const t = (bu.end - bu.start) / 60; check(t >= 60 && t <= 180, `Bursar 60-180 s, ${cls} seed ${seed}: ${t.toFixed(0)}`); } else check(false, 'Bursar killed'); if (ma?.end) { const t = (ma.end - ma.start) / 60; check(t >= 120 && t <= 300, `Malison 120-300 s, ${cls} seed ${seed}: ${t.toFixed(0)}`); } else check(false, 'Malison killed');\")\ns=s.replace(\"// Boss length is judged class by class, averaged over the seeds: a single run swings with the loot it found.\\nconst mean = (a) => a.reduce((x, y) => x + y, 0) / a.length;\\n\",\"\")\ns=re.sub(r\"if \\(assert\\) \\{ for \\(const \\[k, v\\] of Object\\.entries\\(times\\.b\\)\\).*\\n\",\"\",s)\nopen(p,'w').write(s)\nEOF\nSEEDS=11,23,47 node tools/report.mjs --assert 2>&1 | grep -E \"SOFTLOCK|REPORT|TARGET|bosses\" | sed -E 's/ drops.*//' | cut -c1-110","description":"Implement the audit gaps, make boss timing per run","timeout":400000}}}
