a.length > 0, 'answer filled');\n  eq(Object.keys(o.aiHub).join(), 'name,tagline,description,type,genre,source,series,players,controls,tags', 'aiHub keys');\n  eq(o.aiHub.name, TITLE, 'aiHub.name equals TITLE');\n  ok(o.aiHub.tags.length >= 3 && o.aiHub.tags.length <= 6 && o.aiHub.tags.every((t) => t === t.toLowerCase()), '3 to 6 lowercase tags');\n  for (const [k, v] of Object.entries(o.aiHub)) if (k !== 'series') ok(v && v.length, `aiHub.${k} filled`);\n});\nEOF\nfor t in screens attract; do (time node tests/headless/$t.test.mjs) 2>&1 | cut -c1-200 | grep -vE \"^(user|sys|$)\" | tail -6; done\ncat >> ../PROGRESS.md <<'EOF'\n- Headless tests written: playthrough, screens, attract, audio, replay, exit. NEXT: tests/browser, tests/hub, exit-interview.json, visuals pass (title scene, zones), docs/DESIGNERS.md, cleanup (rm tools/scratch, check/, tools/out, tools/.bundle.js kept out; keep node_modules? remove at end if large).\nEOF","description":"Adjust tests, add exit test, rerun","timeout":400000}}}
