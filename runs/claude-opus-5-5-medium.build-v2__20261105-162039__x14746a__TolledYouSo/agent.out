{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgkr8Ps6199p1jch49f38","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01YNW8pvCDnxTu1W66chp8JP","name":"Bash","input":{"command":"sed -i \"s/const FIGHT_SECONDS = { bursar: 290, malison: 440 };/const FIGHT_SECONDS = { bursar: 290, malison: 560, ambrose: 130 };/\" src/sim/bosses.js\ncat > tests/sim/features.test.mjs <<'EOF'\n// Features the campaign bot doesn't always meet: the side dungeon, Writs, the Plate, shrines, levers, traps, Knell modifiers, the session round, Sister Pyx.\nimport { ok, eq, guarded } from '../lib.mjs';\nimport { newWorld, addHero, applyCommand, stepWorld, useProp } from '../../src/sim/step.js';\nimport { enterZone } from '../../src/sim/world.js';\nimport { killMonster, spawnMonster } from '../../src/sim/monsters.js';\nimport { afterTalk, dialogFor, rollWrits } from '../../src/sim/quests.js';\nimport { addPyx, spawnPlate } from '../../src/sim/rules.js';\nimport { startKnell } from '../../src/sim/knell.js';\nimport { MODIFIER_IDS } from '../../src/data/monsters.js';\nimport { levelUp, refresh } from '../../src/sim/hero.js';\nimport { buildRoundWorld } from '../../src/net/hubflow.js';\nimport { LORE_IDS, LORE } from '../../src/data/lore.js';\nconst IDLE = { moveX: 0, moveZ: 0, pressed: {}, held: {} };\nconst mk = (cls = 'bellwarden', zone = 'town', seed = 8) => { const w = newWorld({ seed }); const h = addHero(w, { seat: 0, cls }); enterZone(w, zone); w.events.length = 0; return { w, h }; };\nconst run = (w, n, it = IDLE) => { for (let i = 0; i < n; i++) { stepWorld(w, { 0: it }); w.events.length = 0; } };\nawait guarded(async () => {\n  // The Drowned Pantry: Cellarer, overdue book, the Crier's reward.\n  { const { w, h } = mk('sexton', 'causeway'); const door = w.props.find((p) => p.kind === 'exit' && p.to === 'pantry'); ok(door, 'Pantry door on the Causeway'); useProp(w, h, door); eq(w.zone.id, 'pantry', 'into the Pantry');\n    const c = w.monsters.find((m) => m.type === 'cellarer'); ok(c, 'the Cellarer waits'); c.hp = 0; killMonster(w, c, h, {}); ok(w.bossKills?.cellarer, 'Cellarer slain');\n    const book = w.props.find((p) => p.kind === 'book'); useProp(w, h, book); ok(w.story.flags.overdueBook, 'book taken'); enterZone(w, 'town'); w.story.q = 2; w.story.step = 1; const g = h.gold; const d = dialogFor(w, 'crier'); eq(d.key, 'crier_book', 'the Crier wants it'); afterTalk(w, d); ok(h.gold > g, 'reward paid'); }\n  // Writs.\n  { const { w, h } = mk('bellwarden', 'causeway'); w.story.lychgates.push('causeway'); rollWrits(w); eq(w.story.writs.length, 3, 'three Writs'); const n0 = h.mats.shards; for (const j of [...w.story.writs]) { j.done = false; } for (const j of [...w.story.writs]) { const m = await import('../../src/sim/quests.js'); m.finishWrit(w, j); } ok(h.mats.shards > n0 && w.story.writCaches === 1, 'all three pay a cache'); }\n  // The Collection Plate: spills, escapes, or pays a jackpot.\n  { const { w, h } = mk('bellwarden', 'causeway'); h.x = 20; const p = spawnPlate(w, h.x + 3, h.z, { dormant: false, aggro: true }); run(w, 120); ok(w.drops.some((d) => d.kind === 'gold'), 'the Plate spills gold'); run(w, 60 * 12); ok(p.dead && p.gone, 'the Plate escapes after 12 s');\n    const q = spawnPlate(w, h.x + 3, h.z, { dormant: false, aggro: true }); w.drops.length = 0; q.hp = 0; killMonster(w, q, h, {}); ok(w.drops.filter((d) => d.kind === 'gold').length >= 10 && w.drops.some((d) => d.kind === 'item'), 'jackpot when killed'); }\n  // Shrines: each buff.\n  for (const k of ['ardour', 'haste', 'ward', 'plenty']) { const { w, h } = mk(); const p = { id: 999, kind: 'shrine', shrine: k, x: h.x, z: h.z, interact: true, r: 1 }; w.props.push(p); useProp(w, h, p); ok(h.buffs.some((b) => b.id === k), `shrine ${k} buffs`); if (k === 'ward') ok(h.shield > 0, 'ward shields'); ok(p.used, 'shrine used once'); }\n  // Levers open portcullises; traps fire.\n  { let lever = null; let s = 1; let w; let h; while (!lever && s < 30) { ({ w, h } = mk('bellwarden', 'ossuary2', s++)); lever = w.props.find((p) => p.kind === 'lever'); } ok(lever, 'lever floor'); const port = w.props.find((p) => p.kind === 'portcullis'); ok(!w.zone.nav.isOpen(port.col, port.row), 'portcullis shut'); useProp(w, h, lever); ok(w.zone.nav.isOpen(port.col, port.row), 'lever opens it');\n    const trap = w.props.find((p) => p.kind === 'trap'); ok(trap, 'traps exist'); h.x = trap.x; h.z = trap.z; const hp = h.hp; trap.cycle = 0; run(w, 60); ok(h.hp < hp, 'a trap hurts'); }\n  // Every Knell modifier.\n  for (const mod of MODIFIER_IDS) { const { w, h } = mk('lamplighter'); while (h.level < 20) levelUp(w, h); startKnell(w, { mods: [mod] }); ok(w.knell.mods.includes(mod), `modifier ${mod}`); const base = mk('lamplighter'); while (base.h.level < 20) levelUp(base.w, base.h); startKnell(base.w, { mods: ['golden'] });\n    if (mod === 'crowded') ok(w.monsters.length > base.w.monsters.length * 0.9, 'crowded is denser'); if (mod === 'swift') eq(w.knell.speedMul, 1.2, 'swift'); if (mod === 'volatile') { const m = w.monsters.find((q) => !q.defn.boss); m.dormant = false; m._woke = true; killMonster(w, m, h, {}); ok(w.telegraphs.length > 0, 'volatile explodes'); } }\n  // Grand tiers scale.\n  { const { w } = mk('sexton'); startKnell(w, { grandTier: 5 }); ok(Math.abs(w.knell.hpMul - 1.17 ** 5) < 1e-6 && Math.abs(w.knell.dmgMul - 1.08 ** 5) < 1e-6, 'grand tier formula'); eq(w.knell.grand.t, 600, 'ten minutes'); }\n  // Requiem.\n  { const { w, h } = mk('bellwarden', 'causeway'); for (let i = 0; i < 12; i++) { const m = spawnMonster(w, 'peatwalker', h.x + 1, h.z, { dormant: false, aggro: true }); m.hp = 0; killMonster(w, m, h, {}); } const xp = h.xp; let ev = null; for (let i = 0; i < 70; i++) { stepWorld(w, { 0: IDLE }); for (const e of w.events) if (e.t === 'requiem') ev = e; w.events.length = 0; } ok(ev?.n === 12, `12 kill Requiem: ${ev?.n}`); ok(h.xp > xp || h.level > 1, 'Requiem pays XP'); }\n  // Sister Pyx: fights, goes down, comes back, and leaves when a seat joins.\n  { const { w, h } = mk('bellwarden', 'causeway'); addPyx(w); const a = w.allies.find((q) => q.kind === 'pyx'); ok(a, 'Pyx joins'); h.x = 20; const m = spawnMonster(w, 'peatwalker', a.x + 3, a.z, { dormant: false, aggro: true }); m.hp = m.maxHp = 1e6; run(w, 200); ok(m.hp < 1e6, 'Pyx shoots'); a.hp = 0; run(w, 5); eq(a.state, 'down', 'Pyx goes down'); run(w, 60 * 21); ok(a.hp > 0, 'Pyx revives after 20 s'); }\n  // Co-op revive by holding interact.\n  { const { w, h } = mk(); const o = addHero(w, { seat: 1, cls: 'sexton' }); o.x = h.x + 1; o.z = h.z; const { killHero } = await import('../../src/sim/hero.js'); killHero(w, o, {}); for (let i = 0; i < 130; i++) { stepWorld(w, { 0: { ...IDLE, held: { interact: true } }, 1: IDLE }); w.events.length = 0; } ok(!o.dead, 'an ally revives you'); eq(h.revives, 1, 'revive counted'); }\n  // Lore: twelve books, each placed in its zone.\n  eq(LORE_IDS.length, 12, 'twelve lore books'); for (const id of LORE_IDS) { const { w } = mk('bellwarden', LORE[id].zone, 5); ok(w.props.some((p) => p.kind === 'lore' && p.lore === id), `book ${id} placed`); }\n  // The session round: level 12, six slots, level-up picks, class font swap, rise after 8 s.\n  { const info = { seed: 3, players: [{ id: 0, name: 'A' }, { id: 1, name: 'B' }, { id: 2, name: 'C' }, { id: 3, name: 'D' }] }; const w = buildRoundWorld(info); eq(w.heroes.map((h) => h.cls).join(), 'bellwarden,lamplighter,sexton,bellwarden', 'class by seat'); for (const h of w.heroes) { eq(h.level, 12, 'level 12'); eq(h.slots.filter((s) => s.skill).length, 6, 'six skills'); }\n    const h = w.heroes[0]; levelUp(w, h); eq(h.levelPicks.length, 1, 'a pick pops'); eq(h.levelPicks[0].opts.length, 3, 'pick 1 of 3'); ok(applyCommand(w, 0, { c: 'pick', i: 1 }), 'picked'); eq(h.levelPicks.length, 0, 'pick done'); levelUp(w, h); const all = {}; for (const q of w.heroes) all[q.seat] = IDLE; for (let i = 0; i < 620; i++) { stepWorld(w, all); w.events.length = 0; if (!h.levelPicks.length) break; } eq(h.levelPicks.length, 0, 'auto-picks after 10 s');\n    const f = w.props.find((p) => p.kind === 'classfontspot' && p.cls === 'sexton'); const b = w.heroes[1]; b.invulnerable = 99; b.x = f.x; b.z = f.z; for (let i = 0; i < 130; i++) { b.x = f.x; b.z = f.z; b.invulnerable = 9; stepWorld(w, all); w.events.length = 0; } eq(b.cls, 'sexton', 'class font swaps in the first 30 s'); refresh(w, b); }\n});\nEOF\npython3 - <<'EOF'\np='tests/sim/lint.test.mjs'; s=open(p).read()\ns=s.replace(\"  void buildModel;\\n\",\"\"\"  void buildModel;\n  // analyzeClip runs on the engine's own hero, same rig: new gaits must be clean.\n  { const game = { name: 'clipcheck', async setup(ctx) { this.hero = await ctx.loadModel(HERO_MODEL); }, cameraTarget() { return new THREE.Vector3(); } }; const e = await Engine.headless(game, {}); const shamble = NEW_CLIPS.find((c) => c.name === 'Shamble'); const clip = compileClips([shamble], HERO_RIG, game.hero.scene)[0]; const rep = analyzeClip(game.hero.scene, HERO_RIG, shamble, clip); eq(rep.problems.length, 0, `Shamble analyzeClip: ${rep.problems[0]}`); e.dispose(); }\n\"\"\")\ns=s.replace(\"import { buildModel, checkModel, compileClips, HERO_RIG,\",\"import { analyzeClip, buildModel, checkModel, compileClips, Engine, HERO_MODEL, HERO_RIG, THREE,\")\nopen(p,'w').write(s)\np='tests/headless/playthrough.test.mjs'; s=open(p).read()\ns=s.replace(\"ok(w.requiems > 0 || true, 'requiem');\",\"ok(w.requiems > 0, `${cls} reached a Requiem`); ok(w.bestiary.collection_plate >= 0 && w.story.flags.firstPlate, `${cls} met the first Plate`); ok(w.story.flags.firstChampion, `${cls} met the first Champion pack`); ok(w.story.flags.pyx, `${cls} met Sister Pyx`); ok(w.story.flags.novicesSaved, `${cls} defended the novices`); ok(w.stats.smashed > 0, `${cls} smashed props`); ok(w.stats.legendaries >= 2, `${cls} found 2+ legendaries`); for (const k of ['peatwalker', 'rattlebones', 'cinderling']) ok(w.bestiary[k] > 0, `${cls} met ${k}`);\")\nopen(p,'w').write(s)\np='tests/headless/attract.test.mjs'; s=open(p).read()\ns=s.replace(\"const a = g.shell.attract; const totalT = 16 * 8;\",\"const a = g.shell.attract; const totalT = 16 * 8 + 10;\")\ns=s.replace(\"for (let i = 0; i < totalT * 60 * 2 + 300; i++)\",\"for (let i = 0; i < totalT * 60 * 2 + 900; i++)\")\ns=s.replace(\"ok(a.loops >= 1, `attract looped: ${a.loops}`);\",\"ok(a.loops >= 2, `attract looped twice: ${a.loops}`);\")\nopen(p,'w').write(s)\np='tests/headless/screens.test.mjs'; s=open(p).read()\ns=s.replace(\"  // Death overlay.\\n\",\"\"\"  // Dialogue with choices, Triangle compares on the Gear tab.\n  P2.autoDialog = false; P2.startDialog('crier_idle', { pause: true }); E.step(15); ok(texts(G).includes('WHAT OF THE BELL?'), 'dialogue offers choices'); G.ui.focus = 'choice:0'; E.step(2); press(E, 'Enter'); E.step(3); eq(P2.dialog?.key, 'crier_bell', 'a choice leads on'); press(E, 'Enter'); E.step(15); press(E, 'Enter'); E.step(3); eq(P2.dialog, null, 'dialogue ends'); P2.autoDialog = true;\n  P2.menus.push('hero', { tab: 0 }); E.step(2); G.ui.focus = 'inv:0'; E.step(2); press(E, 'KeyV'); E.step(2); ok(texts(G).includes('WORN NOW'), 'V compares with what is worn'); press(E, 'Escape'); E.step(2);\n  // Death overlay.\n\"\"\")\nopen(p,'w').write(s)\np='tests/browser/couch.test.mjs'; s=open(p).read()\ns=s.replace(\"  await pressKey(page, 'Escape'); await step(page, 3);\\n  eq(errors.length\",\"  eq(await page.evaluate(() => G.ui.seatFrame), 2, 'panel framed in the seat colour');\\n  await page.evaluate(() => { G.play.menus.closeAll(); }); await step(page, 3); await tap(8, 1); await step(page, 3); eq(await page.evaluate(() => G.play.menus.top?.type), 'hero', 'seat 2 opens its own Hero screen'); eq(await page.evaluate(() => G.menuOwner), 1, 'seat 2 owns it'); const before = await page.evaluate(() => G.play.menus.top.tab); await tap(5, 3); eq(await page.evaluate(() => G.play.menus.top.tab), before, 'another seat cannot drive it'); await tap(5, 1); ok((await page.evaluate(() => G.play.menus.top.tab)) !== before, 'the owner can'); eq(await page.evaluate(() => E.timeScale), 0, 'the world pauses');\\n  await page.evaluate(() => { G.play.menus.closeAll(); }); await step(page, 3);\\n  eq(errors.length\")\nopen(p,'w').write(s)\np='tests/browser/touch.test.mjs'; s=open(p).read()\ns=s.replace(\"import { devices } from 'playwright';\",\"import { devices, webkit } from 'playwright';\\nimport { pathToFileURL } from 'node:url';\")\ns=s.replace(\"import { openGame, step } from '../../tools/browser.mjs';\",\"import { HTML, openGame, step } from '../../tools/browser.mjs';\")\ns=s.replace(\"\"\"    eq(errors.length, 0, `${name}: no page errors: ${errors[0]}`); await browser.close();\n  }\n\"\"\",\"\"\"    eq(errors.length, 0, `${name}: no page errors: ${errors[0]}`); await browser.close();\n  }\n  // WebKit with an iPhone profile: no WebGPU here, so it can only show the no-WebGPU page. It must, cleanly.\n  { const b = await webkit.launch(); const c = await b.newContext({ ...devices['iPhone 14'] }); const p = await c.newPage(); const errs = []; p.on('pageerror', (e) => errs.push(e.message)); await p.goto(pathToFileURL(HTML).href); await p.waitForFunction(() => document.body.innerText.includes('WebGPU') || window.__GAME__, null, { timeout: 60000 }); const t = await p.evaluate(() => document.body.innerText); ok(t.includes('This game needs WebGPU') && t.includes('Tolled You So'), `no-WebGPU page: ${t.slice(0, 120)}`); eq(errs.length, 0, `WebKit page errors: ${errs[0]}`); await b.close(); }\n\"\"\")\nopen(p,'w').write(s)\nEOF\ncat >> ../PROGRESS.md <<'EOF'\n- Stop-hook audit round: added SpringChain bell, dissolve on tall props and ragdolls, seat-coloured panels, dialogue choices, Triangle compare, Trail on projectiles and swings, spatial fire voice, per-type monster voices, boss stinger, falling beams, any boss in dev spawn, adaptive boss sizing (per-run timing assert), tests: features, analyzeClip, WebKit iPhone no-WebGPU. NEXT: run all tiers; full shots review.\nEOF\nnode tools/build.mjs --quiet; for t in sim/features sim/lint sim/skills; do TEST_LIMIT=300000 node tests/$t.test.mjs 2>&1 | cut -c1-260 | grep -v \"^    at\" | tail -9; done","description":"Add feature, clip analysis and WebKit tests, run them","timeout":500000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1163,"cache_read_input_tokens":859643,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1163},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"69254de6-4061-470e-8e76-10f1ee96c6e5","uuid":"932e629e-8a7d-44d6-adaa-8a86cf3519be","timestamp":"2026-11-06T02:00:37.102Z","request_id":"req_011Cgkr8PXjXH597JDemFspJ","wire_tool_inputs":{"toolu_01YNW8pvCDnxTu1W66chp8JP":{"command":"sed -i \"s/const FIGHT_SECONDS = { bursar: 290, malison: 440 };/const FIGHT_SECONDS = { bursar: 290, malison: 560, ambrose: 130 };/\" src/sim/bosses.js\ncat > tests/sim/features.test.mjs <<'EOF'\n// Features the campaign bot doesn't always meet: the side dungeon, Writs, the Plate, shrines, levers, traps, Knell modifiers, the session round, Sister Pyx.\nimport { ok, eq, guarded } from '../lib.mjs';\nimport { newWorld, addHero, applyCommand, stepWorld, useProp } from '../../src/sim/step.js';\nimport { enterZone } from '../../src/sim/world.js';\nimport { killMonster, spawnMonster } from '../../src/sim/monsters.js';\nimport { afterTalk, dialogFor, rollWrits } from '../../src/sim/quests.js';\nimport { addPyx, spawnPlate } from '../../src/sim/rules.js';\nimport { startKnell } from '../../src/sim/knell.js';\nimport { MODIFIER_IDS } from '../../src/data/monsters.js';\nimport { levelUp, refresh } from '../../src/sim/hero.js';\nimport { buildRoundWorld } from '../../src/net/hubflow.js';\nimport { LORE_IDS, LORE } from '../../src/data/lore.js';\nconst IDLE = { moveX: 0, moveZ: 0, pressed: {}, held: {} };\nconst mk = (cls = 'bellwarden', zone = 'town', seed = 8) => { const w = newWorld({ seed }); const h = addHero(w, { seat: 0, cls }); enterZone(w, zone); w.events.length = 0; return { w, h }; };\nconst run = (w, n, it = IDLE) => { for (let i = 0; i < n; i++) { stepWorld(w, { 0: it }); w.events.length = 0; } };\nawait guarded(async () => {\n  // The Drowned Pantry: Cellarer, overdue book, the Crier's reward.\n  { const { w, h } = mk('sexton', 'causeway'); const door = w.props.find((p) => p.kind === 'exit' && p.to === 'pantry'); ok(door, 'Pantry door on the Causeway'); useProp(w, h, door); eq(w.zone.id, 'pantry', 'into the Pantry');\n    const c = w.monsters.find((m) => m.type === 'cellarer'); ok(c, 'the Cellarer waits'); c.hp = 0; killMonster(w, c, h, {}); ok(w.bossKills?.cellarer, 'Cellarer slain');\n    const book = w.props.find((p) => p.kind === 'book'); useProp(w, h, book); ok(w.story.flags.overdueBook, 'book taken'); enterZone(w, 'town'); w.story.q = 2; w.story.step = 1; const g = h.gold; const d = dialogFor(w, 'crier'); eq(d.key, 'crier_book', 'the Crier wants it'); afterTalk(w, d); ok(h.gold > g, 'reward paid'); }\n  // Writs.\n  { const { w, h } = mk('bellwarden', 'causeway'); w.story.lychgates.push('causeway'); rollWrits(w); eq(w.story.writs.length, 3, 'three Writs'); const n0 = h.mats.shards; for (const j of [...w.story.writs]) { j.done = false; } for (const j of [...w.story.writs]) { const m = await import('../../src/sim/quests.js'); m.finishWrit(w, j); } ok(h.mats.shards > n0 && w.story.writCaches === 1, 'all three pay a cache'); }\n  // The Collection Plate: spills, escapes, or pays a jackpot.\n  { const { w, h } = mk('bellwarden', 'causeway'); h.x = 20; const p = spawnPlate(w, h.x + 3, h.z, { dormant: false, aggro: true }); run(w, 120); ok(w.drops.some((d) => d.kind === 'gold'), 'the Plate spills gold'); run(w, 60 * 12); ok(p.dead && p.gone, 'the Plate escapes after 12 s');\n    const q = spawnPlate(w, h.x + 3, h.z, { dormant: false, aggro: true }); w.drops.length = 0; q.hp = 0; killMonster(w, q, h, {}); ok(w.drops.filter((d) => d.kind === 'gold').length >= 10 && w.drops.some((d) => d.kind === 'item'), 'jackpot when killed'); }\n  // Shrines: each buff.\n  for (const k of ['ardour', 'haste', 'ward', 'plenty']) { const { w, h } = mk(); const p = { id: 999, kind: 'shrine', shrine: k, x: h.x, z: h.z, interact: true, r: 1 }; w.props.push(p); useProp(w, h, p); ok(h.buffs.some((b) => b.id === k), `shrine ${k} buffs`); if (k === 'ward') ok(h.shield > 0, 'ward shields'); ok(p.used, 'shrine used once'); }\n  // Levers open portcullises; traps fire.\n  { let lever = null; let s = 1; let w; let h; while (!lever && s < 30) { ({ w, h } = mk('bellwarden', 'ossuary2', s++)); lever = w.props.find((p) => p.kind === 'lever'); } ok(lever, 'lever floor'); const port = w.props.find((p) => p.kind === 'portcullis'); ok(!w.zone.nav.isOpen(port.col, port.row), 'portcullis shut'); useProp(w, h, lever); ok(w.zone.nav.isOpen(port.col, port.row), 'lever opens it');\n    const trap = w.props.find((p) => p.kind === 'trap'); ok(trap, 'traps exist'); h.x = trap.x; h.z = trap.z; const hp = h.hp; trap.cycle = 0; run(w, 60); ok(h.hp < hp, 'a trap hurts'); }\n  // Every Knell modifier.\n  for (const mod of MODIFIER_IDS) { const { w, h } = mk('lamplighter'); while (h.level < 20) levelUp(w, h); startKnell(w, { mods: [mod] }); ok(w.knell.mods.includes(mod), `modifier ${mod}`); const base = mk('lamplighter'); while (base.h.level < 20) levelUp(base.w, base.h); startKnell(base.w, { mods: ['golden'] });\n    if (mod === 'crowded') ok(w.monsters.length > base.w.monsters.length * 0.9, 'crowded is denser'); if (mod === 'swift') eq(w.knell.speedMul, 1.2, 'swift'); if (mod === 'volatile') { const m = w.monsters.find((q) => !q.defn.boss); m.dormant = false; m._woke = true; killMonster(w, m, h, {}); ok(w.telegraphs.length > 0, 'volatile explodes'); } }\n  // Grand tiers scale.\n  { const { w } = mk('sexton'); startKnell(w, { grandTier: 5 }); ok(Math.abs(w.knell.hpMul - 1.17 ** 5) < 1e-6 && Math.abs(w.knell.dmgMul - 1.08 ** 5) < 1e-6, 'grand tier formula'); eq(w.knell.grand.t, 600, 'ten minutes'); }\n  // Requiem.\n  { const { w, h } = mk('bellwarden', 'causeway'); for (let i = 0; i < 12; i++) { const m = spawnMonster(w, 'peatwalker', h.x + 1, h.z, { dormant: false, aggro: true }); m.hp = 0; killMonster(w, m, h, {}); } const xp = h.xp; let ev = null; for (let i = 0; i < 70; i++) { stepWorld(w, { 0: IDLE }); for (const e of w.events) if (e.t === 'requiem') ev = e; w.events.length = 0; } ok(ev?.n === 12, `12 kill Requiem: ${ev?.n}`); ok(h.xp > xp || h.level > 1, 'Requiem pays XP'); }\n  // Sister Pyx: fights, goes down, comes back, and leaves when a seat joins.\n  { const { w, h } = mk('bellwarden', 'causeway'); addPyx(w); const a = w.allies.find((q) => q.kind === 'pyx'); ok(a, 'Pyx joins'); h.x = 20; const m = spawnMonster(w, 'peatwalker', a.x + 3, a.z, { dormant: false, aggro: true }); m.hp = m.maxHp = 1e6; run(w, 200); ok(m.hp < 1e6, 'Pyx shoots'); a.hp = 0; run(w, 5); eq(a.state, 'down', 'Pyx goes down'); run(w, 60 * 21); ok(a.hp > 0, 'Pyx revives after 20 s'); }\n  // Co-op revive by holding interact.\n  { const { w, h } = mk(); const o = addHero(w, { seat: 1, cls: 'sexton' }); o.x = h.x + 1; o.z = h.z; const { killHero } = await import('../../src/sim/hero.js'); killHero(w, o, {}); for (let i = 0; i < 130; i++) { stepWorld(w, { 0: { ...IDLE, held: { interact: true } }, 1: IDLE }); w.events.length = 0; } ok(!o.dead, 'an ally revives you'); eq(h.revives, 1, 'revive counted'); }\n  // Lore: twelve books, each placed in its zone.\n  eq(LORE_IDS.length, 12, 'twelve lore books'); for (const id of LORE_IDS) { const { w } = mk('bellwarden', LORE[id].zone, 5); ok(w.props.some((p) => p.kind === 'lore' && p.lore === id), `book ${id} placed`); }\n  // The session round: level 12, six slots, level-up picks, class font swap, rise after 8 s.\n  { const info = { seed: 3, players: [{ id: 0, name: 'A' }, { id: 1, name: 'B' }, { id: 2, name: 'C' }, { id: 3, name: 'D' }] }; const w = buildRoundWorld(info); eq(w.heroes.map((h) => h.cls).join(), 'bellwarden,lamplighter,sexton,bellwarden', 'class by seat'); for (const h of w.heroes) { eq(h.level, 12, 'level 12'); eq(h.slots.filter((s) => s.skill).length, 6, 'six skills'); }\n    const h = w.heroes[0]; levelUp(w, h); eq(h.levelPicks.length, 1, 'a pick pops'); eq(h.levelPicks[0].opts.length, 3, 'pick 1 of 3'); ok(applyCommand(w, 0, { c: 'pick', i: 1 }), 'picked'); eq(h.levelPicks.length, 0, 'pick done'); levelUp(w, h); const all = {}; for (const q of w.heroes) all[q.seat] = IDLE; for (let i = 0; i < 620; i++) { stepWorld(w, all); w.events.length = 0; if (!h.levelPicks.length) break; } eq(h.levelPicks.length, 0, 'auto-picks after 10 s');\n    const f = w.props.find((p) => p.kind === 'classfontspot' && p.cls === 'sexton'); const b = w.heroes[1]; b.invulnerable = 99; b.x = f.x; b.z = f.z; for (let i = 0; i < 130; i++) { b.x = f.x; b.z = f.z; b.invulnerable = 9; stepWorld(w, all); w.events.length = 0; } eq(b.cls, 'sexton', 'class font swaps in the first 30 s'); refresh(w, b); }\n});\nEOF\npython3 - <<'EOF'\np='tests/sim/lint.test.mjs'; s=open(p).read()\ns=s.replace(\"  void buildModel;\\n\",\"\"\"  void buildModel;\n  // analyzeClip runs on the engine's own hero, same rig: new gaits must be clean.\n  { const game = { name: 'clipcheck', async setup(ctx) { this.hero = await ctx.loadModel(HERO_MODEL); }, cameraTarget() { return new THREE.Vector3(); } }; const e = await Engine.headless(game, {}); const shamble = NEW_CLIPS.find((c) => c.name === 'Shamble'); const clip = compileClips([shamble], HERO_RIG, game.hero.scene)[0]; const rep = analyzeClip(game.hero.scene, HERO_RIG, shamble, clip); eq(rep.problems.length, 0, `Shamble analyzeClip: ${rep.problems[0]}`); e.dispose(); }\n\"\"\")\ns=s.replace(\"import { buildModel, checkModel, compileClips, HERO_RIG,\",\"import { analyzeClip, buildModel, checkModel, compileClips, Engine, HERO_MODEL, HERO_RIG, THREE,\")\nopen(p,'w').write(s)\np='tests/headless/playthrough.test.mjs'; s=open(p).read()\ns=s.replace(\"ok(w.requiems > 0 || true, 'requiem');\",\"ok(w.requiems > 0, `${cls} reached a Requiem`); ok(w.bestiary.collection_plate >= 0 && w.story.flags.firstPlate, `${cls} met the first Plate`); ok(w.story.flags.firstChampion, `${cls} met the first Champion pack`); ok(w.story.flags.pyx, `${cls} met Sister Pyx`); ok(w.story.flags.novicesSaved, `${cls} defended the novices`); ok(w.stats.smashed > 0, `${cls} smashed props`); ok(w.stats.legendaries >= 2, `${cls} found 2+ legendaries`); for (const k of ['peatwalker', 'rattlebones', 'cinderling']) ok(w.bestiary[k] > 0, `${cls} met ${k}`);\")\nopen(p,'w').write(s)\np='tests/headless/attract.test.mjs'; s=open(p).read()\ns=s.replace(\"const a = g.shell.attract; const totalT = 16 * 8;\",\"const a = g.shell.attract; const totalT = 16 * 8 + 10;\")\ns=s.replace(\"for (let i = 0; i < totalT * 60 * 2 + 300; i++)\",\"for (let i = 0; i < totalT * 60 * 2 + 900; i++)\")\ns=s.replace(\"ok(a.loops >= 1, `attract looped: ${a.loops}`);\",\"ok(a.loops >= 2, `attract looped twice: ${a.loops}`);\")\nopen(p,'w').write(s)\np='tests/headless/screens.test.mjs'; s=open(p).read()\ns=s.replace(\"  // Death overlay.\\n\",\"\"\"  // Dialogue with choices, Triangle compares on the Gear tab.\n  P2.autoDialog = false; P2.startDialog('crier_idle', { pause: true }); E.step(15); ok(texts(G).includes('WHAT OF THE BELL?'), 'dialogue offers choices'); G.ui.focus = 'choice:0'; E.step(2); press(E, 'Enter'); E.step(3); eq(P2.dialog?.key, 'crier_bell', 'a choice leads on'); press(E, 'Enter'); E.step(15); press(E, 'Enter'); E.step(3); eq(P2.dialog, null, 'dialogue ends'); P2.autoDialog = true;\n  P2.menus.push('hero', { tab: 0 }); E.step(2); G.ui.focus = 'inv:0'; E.step(2); press(E, 'KeyV'); E.step(2); ok(texts(G).includes('WORN NOW'), 'V compares with what is worn'); press(E, 'Escape'); E.step(2);\n  // Death overlay.\n\"\"\")\nopen(p,'w').write(s)\np='tests/browser/couch.test.mjs'; s=open(p).read()\ns=s.replace(\"  await pressKey(page, 'Escape'); await step(page, 3);\\n  eq(errors.length\",\"  eq(await page.evaluate(() => G.ui.seatFrame), 2, 'panel framed in the seat colour');\\n  await page.evaluate(() => { G.play.menus.closeAll(); }); await step(page, 3); await tap(8, 1); await step(page, 3); eq(await page.evaluate(() => G.play.menus.top?.type), 'hero', 'seat 2 opens its own Hero screen'); eq(await page.evaluate(() => G.menuOwner), 1, 'seat 2 owns it'); const before = await page.evaluate(() => G.play.menus.top.tab); await tap(5, 3); eq(await page.evaluate(() => G.play.menus.top.tab), before, 'another seat cannot drive it'); await tap(5, 1); ok((await page.evaluate(() => G.play.menus.top.tab)) !== before, 'the owner can'); eq(await page.evaluate(() => E.timeScale), 0, 'the world pauses');\\n  await page.evaluate(() => { G.play.menus.closeAll(); }); await step(page, 3);\\n  eq(errors.length\")\nopen(p,'w').write(s)\np='tests/browser/touch.test.mjs'; s=open(p).read()\ns=s.replace(\"import { devices } from 'playwright';\",\"import { devices, webkit } from 'playwright';\\nimport { pathToFileURL } from 'node:url';\")\ns=s.replace(\"import { openGame, step } from '../../tools/browser.mjs';\",\"import { HTML, openGame, step } from '../../tools/browser.mjs';\")\ns=s.replace(\"\"\"    eq(errors.length, 0, `${name}: no page errors: ${errors[0]}`); await browser.close();\n  }\n\"\"\",\"\"\"    eq(errors.length, 0, `${name}: no page errors: ${errors[0]}`); await browser.close();\n  }\n  // WebKit with an iPhone profile: no WebGPU here, so it can only show the no-WebGPU page. It must, cleanly.\n  { const b = await webkit.launch(); const c = await b.newContext({ ...devices['iPhone 14'] }); const p = await c.newPage(); const errs = []; p.on('pageerror', (e) => errs.push(e.message)); await p.goto(pathToFileURL(HTML).href); await p.waitForFunction(() => document.body.innerText.includes('WebGPU') || window.__GAME__, null, { timeout: 60000 }); const t = await p.evaluate(() => document.body.innerText); ok(t.includes('This game needs WebGPU') && t.includes('Tolled You So'), `no-WebGPU page: ${t.slice(0, 120)}`); eq(errs.length, 0, `WebKit page errors: ${errs[0]}`); await b.close(); }\n\"\"\")\nopen(p,'w').write(s)\nEOF\ncat >> ../PROGRESS.md <<'EOF'\n- Stop-hook audit round: added SpringChain bell, dissolve on tall props and ragdolls, seat-coloured panels, dialogue choices, Triangle compare, Trail on projectiles and swings, spatial fire voice, per-type monster voices, boss stinger, falling beams, any boss in dev spawn, adaptive boss sizing (per-run timing assert), tests: features, analyzeClip, WebKit iPhone no-WebGPU. NEXT: run all tiers; full shots review.\nEOF\nnode tools/build.mjs --quiet; for t in sim/features sim/lint sim/skills; do TEST_LIMIT=300000 node tests/$t.test.mjs 2>&1 | cut -c1-260 | grep -v \"^    at\" | tail -9; done","description":"Add feature, clip analysis and WebKit tests, run them","timeout":500000}}}
