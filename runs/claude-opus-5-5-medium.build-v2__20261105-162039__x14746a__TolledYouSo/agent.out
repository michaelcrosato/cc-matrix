seway', 'ossuary', 'cloister', 'belfry'].includes(n)) { await page.evaluate(() => { const w = G.play.world; const h = w.heroes[0]; let r = w.zone.roomRects[Math.floor(w.zone.roomRects.length / 2)]; h.x = r.x + r.w / 2; h.z = r.y + r.h / 2; const n2 = w.zone.nav; if (!n2.walkable(h.x, h.z)) { h.x += 2; } }); await step(page, 240); }\n  console.log(n, await step(page, 1), await page.evaluate(() => `active ${G.play.world.active.length} parts ${E.particles.alive} kills ${G.play.world.stats.kills}`));\n  await shot(page, `tools/out/${n}.png`);\n}\nconsole.log(errors.slice(0, 10)); await browser.close();\nEOF\nnode tools/build.mjs --quiet && node tools/shots.mjs town causeway ossuary 2>&1 | cut -c1-400 | tail -6","description":"Tweak visuals, write shot tool, capture zones","timeout":500000}}}
