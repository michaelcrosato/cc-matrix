> { if (down) { this.dirT[name] = (this.dirT[name] ?? -0.0) - dt; if (this.dirT[name] <= 0) { m[name] = true; this.dirT[name] = this.dirHeld?.[name] ? 0.12 : 0.32; (this.dirHeld ??= {})[name] = true; } } else { this.dirT[name] = 0; if (this.dirHeld) this.dirHeld[name] = false; } };\n    repeatKey('up', inp.isDown('ArrowUp', 'KeyW')); repeatKey('down', inp.isDown('ArrowDown', 'KeyS')); repeatKey('left', inp.isDown('ArrowLeft', 'KeyA')); repeatKey('right', inp.isDown('ArrowRight', 'KeyD'));\n    for (const e of inp.buttonEvents) {\n      if (e.down !== false && (e.type === 'down' || e.down === true || e.pressed)) {\n        const code = e.button ?? e.code;\n        if (code === 0 || code === 'MouseLeft' || code === 'left') this.click = { x: e.x ?? ptr.x, y: e.y ?? ptr.y };\n        if (code === 2 || code === 'MouseRight' || code === 'right') this.rclick = true;\n        this.lastDevice = 'kbm'; this.anyInput = true;\n      }\n    }\n    if (inp.wasPressed('MouseLeft') && !this.click) { this.click = { x: ptr.x, y: ptr.y }; this.lastDevice = 'kbm'; this.anyInput = true; }\n    if (inp.wasPressed('MouseRight')) { this.rclick = true; this.lastDevice = 'kbm'; this.anyInput = true; }\n    if (this.wheel) { this.anyInput = true; }\n    if (inp.wasPressed('Touch')) { this.touched = true; } else this.touched = false;\n    this.menu = m;\n    this.showLabels = inp.isDown('AltLeft', 'AltRight') || this.pads.some((p) => has(p, B.r3));\n  }\n  padDirs(p, m, i) {\n    const repeat = (name, on) => { const k = `${name}${i}`; if (on) { this.dirT[k] = (this.dirT[k] ?? 0) - 1 / 60; if (this.dirT[k] <= 0) { m[name] = true; this.dirT[k] = this.dirHeld?.[k] ? 0.12 : 0.32; (this.dirHeld ??= {})[k] = true; } } else { this.dirT[k] = 0; if (this.dirHeld) this.dirHeld[k] = false; } };\n    repeat('up', has(p, B.up) || p.a[1] < -0.5); repeat('down', has(p, B.down) || p.a[1] > 0.5); repeat('left', has(p, B.left) || p.a[0] < -0.5); repeat('right', has(p, B.right) || p.a[0] > 0.5);\n  }\n  assign(pad, seat) { if (seat < 0) return; this.padSeat[pad] = seat; this.seatPad[seat] = pad; this.seatDevice[seat] = 'pad'; }\n  release(pad) { const s = this.padSeat[pad]; if (s >= 0) this.seatPad[s] = -1; this.padSeat[pad] = -1; }\n  padsSeen() { let n = 0; for (let i = 0; i < 4; i++) if (this.seenPads & (1 << i)) n++; return n; }\n  // Mouse on the ground plane.\n  groundAt(x, y) {\n    const cam = this.ctx.camera; cam.rayAt(x, y, this.origin, this.dir);\n    if (Math.abs(this.dir.y) < 1e-4) return { x: 0, z: 0 };\n    const t = -this.origin.y / this.dir.y; return { x: this.origin.x + this.dir.x * t, z: this.origin.z + this.dir.z * t };\n  }\n  // In-world mouse: what's under the pointer, and what clicking it means.\n  pickWorld(w, view, seat) {\n    const inp = this.ctx.input; const ptr = inp.pointer; const hud = this.ctx.hud;\n    const px = ((ptr.x + 1) / 2) * hud.width; const py = ((1 - ptr.y) / 2) * hud.height;\n    let best = null; let bd = 14;\n    for (const m of w.active ?? w.monsters) { if (m.dead || m.dormant || m.untargetable) continue; const p = view.project(m.x, 0.8 * (m.scale ?? 1), m.z, hud); const d = Math.hypot(p.x - px, p.y - py); const mr = 14 * Math.max(1, (m.r ?? 0.4) / 0.42); if (d < mr && d < bd + mr - 14) { bd = d; best = m; } }\n    this.hoverMonster = best;\n    let prop = null; let pd = 16;\n    for (const p of w.props) { if (!p.interact || p.used || p.hidden || !view.propsV.get(p.id)) continue; if (!view.propsV.get(p.id).obj?.visible && !view.propsV.get(p.id).actor?.root.visible) continue; const s = view.project(p.x, 0.9, p.z, hud); const d = Math.hypot(s.x - px, s.y - py); if (d < pd) { pd = d; prop = p; } }\n    this.hoverProp = prop;\n    let brk = null; for (const p of w.props) { if (p.kind !== 'breakable' || p.broken) continue; const s = view.project(p.x, 0.5, p.z, hud); if (Math.hypot(s.x - px, s.y - py) < 8) { brk = p; break; } } this.hoverBreak = brk;\n  }\n  // Called once per fixed step, per local seat.\n  intentFor(seat, w, view) {\n    const it = { moveX: 0, moveZ: 0, pressed: this.latch[seat], held: {} }; this.latch[seat] = {};\n    const pad = this.seatPad[seat]; const inp = this.ctx.input; const h = w.heroes.find((q) => q.seat === seat);\n    if (!h) return it;\n    if (seat === 0) this.keyboardIntent(it, h, w, view);\n    if (pad >= 0) this.padIntent(it, this.pads[pad], pad, seat, h, w);\n    return it;\n  }\n  keyboardIntent(it, h, w, view) {\n    const inp = this.ctx.input; const mv = inp.moveAxis();\n    const padUsed = this.lastDevice === 'pad';\n    let x = 0; let y = 0;\n    if (inp.isDown('KeyA', 'ArrowLeft')) x -= 1; if (inp.isDown('KeyD', 'ArrowRight')) x += 1; if (inp.isDown('KeyW', 'ArrowUp')) y += 1; if (inp.isDown('KeyS', 'ArrowDown')) y -= 1;\n    mv; if (x || y) { this.goal = null; const L = Math.hypot(x, y); it.moveX = (RIGHT[0] * x + UP[0] * y) / L; it.moveZ = (RIGHT[1] * x + UP[1] * y) / L; }\n    const P = (c) => inp.consumePress(c);\n    if (P('Space')) it.pressed.dodge = true; if (P('KeyQ')) it.pressed.potion = true;\n    if (P('Digit1')) it.pressed.s2 = true; if (P('Digit2')) it.pressed.s3 = true; if (P('Digit3')) it.pressed.s4 = true; if (P('Digit4')) it.pressed.s5 = true;\n    if (inp.isDown('Digit1')) it.held.s2 = true; if (inp.isDown('Digit2')) it.held.s3 = true; if (inp.isDown('Digit3')) it.held.s4 = true; if (inp.isDown('Digit4')) it.held.s5 = true;\n    if (P('KeyE')) { it.pressed.interact = true; } if (inp.isDown('KeyE')) it.held.interact = true;\n    if (P('KeyF')) this.game.command?.({ c: 'equipNewest' }, 0);\n    if (inp.isDown('KeyT')) { this.bellHeld[0] += 1 / 60; if (this.bellHeld[0] >= 1.5) { this.bellHeld[0] = -99; this.game.command?.({ c: 'bell' }, 0); } } else this.bellHeld[0] = 0;\n    if (padUsed) return;\n    const ptr = inp.pointer; const g = this.groundAt(ptr.x, ptr.y); this.aimPoint = g;\n    const dx = g.x - h.x; const dz = g.z - h.z; const d = Math.hypot(dx, dz) || 1; it.aimX = dx / d; it.aimZ = dz / d; it.tx = g.x; it.tz = g.z; it.hardAim = true;\n    this.pickWorld(w, view, 0);\n    const shift = inp.isDown('ShiftLeft', 'ShiftRight');\n    const left = inp.isDown('MouseLeft'); const leftPressed = inp.consumePress('MouseLeft');\n    if (inp.isDown('MouseRight')) it.held.s1 = true; if (inp.consumePress('MouseRight')) it.pressed.s1 = true;\n    if (shift && left) { it.held.s0 = true; if (leftPressed) it.pressed.s0 = true; this.goal = null; }\n    else if (leftPressed) {\n      if (this.hoverMonster) this.goal = { kind: 'monster', id: this.hoverMonster.id };\n      else if (this.hoverProp) this.goal = { kind: 'prop', id: this.hoverProp.id };\n      else if (this.hoverBreak) this.goal = { kind: 'break', id: this.hoverBreak.id };\n      else this.goal = { kind: 'ground', x: g.x, z: g.z, hold: true };\n      this.path = null;\n    } else if (left && this.goal?.kind === 'ground') { this.goal.x = g.x; this.goal.z = g.z; }\n    if (!left && this.goal?.hold) this.goal.hold = false;\n    this.followGoal(it, h, w);\n  }\n  followGoal(it, h, w) {\n    const go = this.goal; if (!go) return;\n    let tx = go.x; let tz = go.z; let stop = 0.35;\n    if (go.kind === 'monster') {\n      const m = w.monsters.find((q) => q.id === go.id); if (!m || m.dead) { this.goal = null; return; }\n      tx = m.x; tz = m.z; it.tx = tx; it.tz = tz; const d = Math.hypot(tx - h.x, tz - h.z) || 1; it.aimX = (tx - h.x) / d; it.aimZ = (tz - h.z) / d;\n      const reach = this.skillReach(h, 0);\n      if (d <= reach + (m.r ?? 0.4)) { it.held.s0 = true; it.pressed.s0 = true; if (!this.ctx.input.isDown('MouseLeft')) this.goal = null; return; }\n    } else if (go.kind === 'prop') {\n      const p = w.props.find((q) => q.id === go.id); if (!p || p.used) { this.goal = null; return; } tx = p.x; tz = p.z;\n      if (Math.hypot(tx - h.x, tz - h.z) < 2) { it.interactId = p.id; it.pressed.interact = true; it.held.interact = true; if (!p.hold) this.goal = null; return; }\n    } else if (go.kind === 'break') {\n      const p = w.props.find((q) => q.id === go.id); if (!p || p.broken) { this.goal = null; return; } tx = p.x; tz = p.z; const d = Math.hypot(tx - h.x, tz - h.z) || 1; it.aimX = (tx - h.x) / d; it.aimZ = (tz - h.z) / d;\n      if (d <= this.skillReach(h, 0)) { it.pressed.s0 = true; this.goal = null; return; }\n    }\n    const d0 = Math.hypot(tx - h.x, tz - h.z);\n    if (d0 < stop) { if (!go.hold) this.goal = null; return; }\n    // Straight when possible, else the nav path.\n    let dx = (tx - h.x) / d0; let dz = (tz - h.z) / d0;\n    if (!w.zone.nav.lineOfSight(h.x, h.z, tx, tz, 0.3)) {\n      this.pathT -= 1 / 60;\n      if (!this.path || this.pathT <= 0) { this.path = w.zone.nav.path([h.x, 0, h.z], [tx, 0, tz]); this.pathT = 0.4; this.pathI = 1; }\n      if (this.path) { while (this.pathI < this.path.length - 1 && Math.hypot(this.path[this.pathI][0] - h.x, this.path[this.pathI][2] - h.z) < 0.5) this.pathI++; const p = this.path[Math.min(this.pathI, this.path.length - 1)]; const dd = Math.hypot(p[0] - h.x, p[2] - h.z) || 1; dx = (p[0] - h.x) / dd; dz = (p[2] - h.z) / dd; } else { if (!go.hold) this.goal = null; return; }\n    }\n    it.moveX = dx; it.moveZ = dz;\n  }\n  skillReach(h, slot) { const s = h.slots[slot]?.skill; if (!s) return 2.5; const sk = this.game.SKILLS[s]; const op = sk.fx[0]; return op.range ?? op.radius ?? sk.range ?? 3; }\n  padIntent(it, p, pad, seat, h, w) {\n    const lx = p.a[0]; const ly = p.a[1]; const rx = p.a[2]; const ry = p.a[3];\n    if (Math.hypot(lx, ly) > 0.15) { it.moveX += RIGHT[0] * lx + UP[0] * -ly; it.moveZ += RIGHT[1] * lx + UP[1] * -ly; }\n    if (Math.hypot(rx, ry) > 0.25) { const ax = RIGHT[0] * rx + UP[0] * -ry; const az = RIGHT[1] * rx + UP[1] * -ry; const L = Math.hypot(ax, az) || 1; it.aimX = ax / L; it.aimZ = az / L; it.hardAim = true; const r = 7; it.tx = h.x + it.aimX * r; it.tz = h.z + it.aimZ * r; }\n    else if (Math.hypot(it.moveX, it.moveZ) > 0.2) { const L = Math.hypot(it.moveX, it.moveZ); it.aimX = it.moveX / L; it.aimZ = it.moveZ / L; }\n    else { it.aimX = Math.sin(h.facing); it.aimZ = Math.cos(h.facing); }\n    if (it.hardAim !== true) { delete it.tx; delete it.tz; }\n    const M = [[B.square, 's1'], [B.triangle, 's2'], [B.circle, 's3'], [B.r1, 's4'], [B.r2, 's5']];\n    for (const [k, name] of M) if (has(p, k)) it.held[name] = true;\n    for (const [k, name] of M) if (this.edge(p, pad, k)) it.pressed[name] = true;\n    if (this.edge(p, pad, B.l2)) it.pressed.dodge = true; if (this.edge(p, pad, B.l1)) it.pressed.potion = true;\n    // Cross: interact on a tap with something near and nothing hostile; hold always interacts; otherwise attack.\n    const target = interactTarget(w, h, this.cycle[seat]); const hostile = (w.active ?? []).some((m) => !m.dead && Math.hypot(m.x - h.x, m.z - h.z) < 4);\n    if (has(p, B.cross)) {\n      this.crossDown[seat] += 1 / 60;\n      if (target && !hostile && !this.crossSent[seat]) { it.pressed.interact = true; this.crossSent[seat] = true; }\n      if (this.crossDown[seat] >= 0.4 && target) { it.held.interact = true; if (!this.crossSent[seat]) { it.pressed.interact = true; this.crossSent[seat] = true; } }\n      if (!target || hostile) { if (this.crossDown[seat] < 0.4 || !target) { it.held.s0 = true; if (this.edge(p, pad, B.cross)) it.pressed.s0 = true; } }\n      if (target?.hold) it.held.interact = true;\n    } else { this.crossDown[seat] = 0; this.crossSent[seat] = false; }\n    it.cycle = this.cycle[seat];\n    if (this.edge(p, pad, B.right)) this.cycle[seat]++;\n    if (this.edge(p, pad, B.left)) this.game.command?.({ c: 'equipNewest' }, seat);\n    if (has(p, B.down)) { this.bellHeld[seat] += 1 / 60; if (this.bellHeld[seat] >= 1.5) { this.bellHeld[seat] = -99; this.game.command?.({ c: 'bell' }, seat); } } else if (seat > 0 || !this.ctx.input.isDown('KeyT')) this.bellHeld[seat] = 0;\n  }\n  // A press seen between fixed steps. Edges are read off the state that arrived this frame.\n  edge(p, pad, k) { this.edges ??= [{}, {}, {}, {}]; const prev = this.edges[pad][k] ?? false; const now = has(p, k); this.edges[pad][k] = now; return now && !prev; }\n  padPress(pad, k) { const p = this.pads[pad]; return has(p, k) && !was(p, k); }\n  padRelease(pad, k) { const p = this.pads[pad]; return !has(p, k) && was(p, k); }\n  padHeld(pad, k) { return has(this.pads[pad], k); }\n}\nEOF\ncat > src/ui/ui.js <<'EOF'\n// Immediate-mode UI over ctx.hud. Widgets register a rectangle a frame; direction input moves focus to the nearest one that way.\nimport { hudSprite, PALETTE } from '../../pixel-engine.js';\nconst CW = 6; const LH = 9;\nexport class UI {\n  constructor(ctx, router) { this.ctx = ctx; this.router = router; this.widgets = []; this.prev = []; this.focus = null; this.drawnText = []; this.rects = []; this.scroll = 0; this.glyphs = 'playstation'; this.frameN = 0; this.iconCache = {}; this.moved = false; this.modalStack = 0; this.activatedThisFrame = null; }\n  get W() { return this.ctx.hud.width; }\n  get H() { return this.ctx.hud.height; }\n  begin() {\n    const r = this.router; const hud = this.ctx.hud;\n    this.prev = this.widgets; this.widgets = []; this.drawnText = []; this.frameN++;\n    hud.clear();\n    this.m = r.menu; this.confirmUsed = false;\n    this.px = ((this.ctx.input.pointer.x + 1) / 2) * this.W; this.py = ((1 - this.ctx.input.pointer.y) / 2) * this.H;\n    // Hover moves focus when the pointer moved.\n    if (r.pointerMoved) { const hit = this.prev.find((w) => this.inside(w) && !w.noFocus); if (hit) { if (this.focus !== hit.id) { this.focus = hit.id; this.ctx.audio.play('ui_move', { volume: 0.5 }); } } }\n    // Directions move focus to the nearest rectangle that way.\n    const dirs = [['up', 0, -1], ['down', 0, 1], ['left', -1, 0], ['right', 1, 0]];\n    for (const [name, dx, dy] of dirs) if (this.m[name]) this.moveFocus(dx, dy);\n    if (this.focus && !this.prev.some((w) => w.id === this.focus)) this.focus = null;\n    this.defaultFocus = !this.focus;\n  }\n  moveFocus(dx, dy) {\n    const list = this.prev.filter((w) => !w.noFocus); if (!list.length) return;\n    const cur = list.find((w) => w.id === this.focus);\n    if (!cur) { this.focus = list[0].id; return; }\n    const cx = cur.x + cur.w / 2; const cy = cur.y + cur.h / 2; let best = null; let bs = Infinity;\n    for (const w of list) {\n      if (w === cur) continue;\n      const x = w.x + w.w / 2; const y = w.y + w.h / 2; const ax = (x - cx) * dx + (y - cy) * dy; if (ax <= 2) continue;\n      const off = Math.abs((x - cx) * dy) + Math.abs((y - cy) * dx);\n      const s = ax + off * 2.5; if (s < bs) { bs = s; best = w; }\n    }\n    if (best) { this.focus = best.id; this.ctx.audio.play('ui_move', { volume: 0.6 }); }\n  }\n  inside(w) { return this.px >= w.x && this.px < w.x + w.w && this.py >= w.y && this.py < w.y + w.h; }\n  text(x, y, str, o = {}) {\n    const s = String(str); const scale = o.scale ?? 1;\n    this.ctx.hud.text(Math.round(x), Math.round(y), s, { color: o.color ?? 'white', scale, shadow: o.shadow ?? 'ink' });\n    const w = this.ctx.hud.measure(s.toUpperCase(), scale).width;\n    this.drawnText.push({ text: s, x: Math.round(x), y: Math.round(y), w, h: 7 * scale, world: !!o.world });\n    return w;\n  }\n  textC(cx, y, str, o = {}) { const w = this.measure(str, o.scale ?? 1); return this.text(cx - w / 2, y, str, o); }\n  textR(rx, y, str, o = {}) { const w = this.measure(str, o.scale ?? 1); return this.text(rx - w, y, str, o); }\n  measure(str, scale = 1) { return this.ctx.hud.measure(String(str).toUpperCase(), scale).width; }\n  rect(x, y, w, h, color) { this.ctx.hud.rect(Math.round(x), Math.round(y), Math.round(w), Math.round(h), color); }\n  frame(x, y, w, h, color = 'slate', fill = 'ink') { this.rect(x, y, w, h, color); this.rect(x + 1, y + 1, w - 2, h - 2, fill); }\n  sprite(x, y, rows, colors, o = {}) { this.ctx.hud.sprite(Math.round(x), Math.round(y), rows, colors, o); }\n  icon(x, y, id, o = {}) {\n    let s = this.iconCache[id]; if (!s) { try { s = hudSprite(id); } catch { s = { rows: ['#'], colors: { '#': 'white' } }; } this.iconCache[id] = s; }\n    this.ctx.hud.sprite(Math.round(x), Math.round(y), s.rows, o.colors ?? s.colors, { scale: o.scale ?? 1 });\n  }\n  // A rectangle that can take focus and be activated. Returns true on activation this frame.\n  widget(id, x, y, w, h, o = {}) {\n    const rect = { id, x, y, w, h, noFocus: !!o.noFocus }; this.widgets.push(rect);\n    if (this.defaultFocus && !o.noFocus && o.first !== false && !this.focus) { this.focus = id; this.defaultFocus = false; }\n    const focused = this.focus === id;\n    const click = this.router.click && this.inside(rect) && !o.noFocus;\n    if (click) this.focus = id;\n    let act = false;\n    if (click || (focused && this.m.confirm && !this.confirmUsed)) { act = true; this.confirmUsed = true; }\n    if (this.router.rclick && this.inside(rect) && !o.noFocus) { this.rclicked = id; }\n    return { act, focused: this.focus === id, hover: this.inside(rect) };\n  }\n  button(id, x, y, w, h, label, o = {}) {\n    const st = this.widget(id, x, y, w, h, o);\n    const c = o.disabled ? 'slate' : st.focused ? (o.focusColor ?? 'sand') : (o.border ?? 'slate');\n    this.frame(x, y, w, h, c, st.focused ? (o.focusFill ?? 'plum') : (o.fill ?? 'night'));\n    const scale = o.scale ?? 1;\n    const ty = y + Math.floor((h - 7 * scale) / 2);\n    if (o.align === 'left') this.text(x + 5 + (o.indent ?? 0), ty, label, { color: o.disabled ? 'mist' : (st.focused ? 'white' : (o.color ?? 'white')), scale });\n    else this.textC(x + w / 2, ty, label, { color: o.disabled ? 'mist' : (st.focused ? 'white' : (o.color ?? 'white')), scale });\n    if (st.act) this.ctx.audio.play(o.disabled ? 'ui_error' : 'ui_ok');\n    return !o.disabled && st.act;\n  }\n  wrap(str, width, scale = 1) {\n    const max = Math.max(4, Math.floor(width / (CW * scale))); const out = [];\n    for (const para of String(str).toUpperCase().split('\\n')) {\n      let line = '';\n      for (const w of para.split(' ')) { if ((line + ' ' + w).trim().length > max && line) { out.push(line); line = w; } else line = (line + ' ' + w).trim(); }\n      out.push(line);\n    }\n    return out;\n  }\n  para(x, y, str, width, o = {}) { const lines = this.wrap(str, width, o.scale ?? 1); const lh = (o.lh ?? LH) * (o.scale ?? 1); lines.forEach((l, i) => this.text(x, y + i * lh, l, o)); return lines.length * lh; }\n  bar(x, y, w, h, frac, color, back = 'ink') { this.rect(x, y, w, h, back); this.rect(x + 1, y + 1, Math.max(0, (w - 2) * Math.min(1, Math.max(0, frac))), h - 2, color); }\n  dim() { this.rect(0, 0, this.W, 2, 'ink'); }\n}\nexport { PALETTE, LH, CW };\nEOF\ncat > src/ui/glyphs.js <<'EOF'\n// On-screen prompts follow the last input: PlayStation glyphs, Xbox on request, keys and mouse for keyboard.\nconst c = (rows, colors) => ({ rows, colors });\nconst CIRCLE = (sym) => [\n  '...bbbbb...',\n  '..bbbbbbb..',\n  '.bbbbbbbbb.',\n  ...sym,\n  '.bbbbbbbbb.',\n  '..bbbbbbb..',\n  '...bbbbb...',\n];\nconst padRow = (s) => s;\nconst PS_CROSS = ['bbb.bbb.bbb', 'bbbb...bbbb', 'bbbbb.bbbbb', 'bbbb...bbbb', 'bbb.bbb.bbb'].map((r) => r.replace(/\\./g, 'x').replace(/x/g, 'w'));\nconst PS_CIRCLE = ['bbbwwwwwbbb', 'bbwbbbbbwbb', 'bbwbbbbbwbb', 'bbwbbbbbwbb', 'bbbwwwwwbbb'];\nconst PS_SQUARE = ['bbwwwwwwwbb', 'bbwbbbbbwbb', 'bbwbbbbbwbb', 'bbwbbbbbwbb', 'bbwwwwwwwbb'];\nconst PS_TRI = ['bbbbbwbbbbb', 'bbbbwbwbbbb', 'bbbwbbbwbbb', 'bbwbbbbbwbb', 'bwwwwwwwwwb'];\nconst ps = (sym, color) => c(CIRCLE(sym), { b: color, w: 'white' });\nexport const PS = { cross: ps(PS_CROSS, 'sky'), circle: ps(PS_CIRCLE, 'red'), square: ps(PS_SQUARE, 'plum'), triangle: ps(PS_TRI, 'lime') };\nconst LET = {\n  A: ['bbbbwwwbbbb', 'bbbwbbbwbbb', 'bbbwwwwwbbb', 'bbbwbbbwbbb', 'bbbwbbbwbbb'], B: ['bbbwwwwbbbb', 'bbbwbbbwbbb', 'bbbwwwwbbbb', 'bbbwbbbwbbb', 'bbbwwwwbbbb'],\n  X: ['bbbwbbbwbbb', 'bbbbwbwbbbb', 'bbbbbwbbbbb', 'bbbbwbwbbbb', 'bbbwbbbwbbb'], Y: ['bbbwbbbwbbb', 'bbbbwbwbbbb', 'bbbbbwbbbbb', 'bbbbbwbbbbb', 'bbbbbwbbbbb'],\n};\nexport const XB = { cross: ps(LET.A, 'green'), circle: ps(LET.B, 'red'), square: ps(LET.X, 'blue'), triangle: ps(LET.Y, 'orange') };\nconst MOUSE_L = c(['..wwwww..', '.rrrwwww.', '.rrrwwww.', '.rrrwwww.', '.wwwwwww.', '.wwwwwww.', '.wwwwwww.', '.wwwwwww.', '..wwwww..'], { w: 'mist', r: 'sand' });\nconst MOUSE_R = c(['..wwwww..', '.wwwwrrr.', '.wwwwrrr.', '.wwwwrrr.', '.wwwwwww.', '.wwwwwww.', '.wwwwwww.', '.wwwwwww.', '..wwwww..'], { w: 'mist', r: 'sand' });\nconst DPAD = (dir) => { const on = { up: [0, 1, 2], down: [6, 7, 8], left: [], right: [] }; const rows = ['...www...', '...www...', '...www...', 'wwwwwwwww', 'wwwwwwwww', 'wwwwwwwww', '...www...', '...www...', '...www...'].map((r, y) => [...r].map((ch, x) => { if (ch === '.') return '.'; const hit = (dir === 'up' && y < 3) || (dir === 'down' && y > 5) || (dir === 'left' && x < 3) || (dir === 'right' && x > 5); return hit ? 'r' : 'w'; }).join('')); return c(rows, { w: 'mist', r: 'sand' }); };\n\n// action -> pad key, keyboard label.\nexport const ACTIONS = {\n  confirm: { pad: 'cross', kbm: 'ENTER' }, back: { pad: 'circle', kbm: 'ESC' }, x: { pad: 'square', kbm: 'X' }, y: { pad: 'triangle', kbm: 'V' },\n  tabL: { pad: 'L1', kbm: 'Q' }, tabR: { pad: 'R1', kbm: 'E' }, pause: { pad: 'OPT', xb: 'MENU', kbm: 'ESC' }, hero: { pad: 'CRT', xb: 'VIEW', kbm: 'I' }, map: { pad: 'dup', kbm: 'M' }, bell: { pad: 'ddown', kbm: 'T' }, equip: { pad: 'dleft', kbm: 'F' }, cycle: { pad: 'dright', kbm: 'CLICK' },\n  skill0: { pad: 'cross', kbm: 'mouseL' }, skill1: { pad: 'square', kbm: 'mouseR' }, skill2: { pad: 'triangle', kbm: '1' }, skill3: { pad: 'circle', kbm: '2' }, skill4: { pad: 'R1', kbm: '3' }, skill5: { pad: 'R2', kbm: '4' },\n  dodge: { pad: 'L2', kbm: 'SPACE' }, potion: { pad: 'L1', kbm: 'Q' }, interact: { pad: 'cross', kbm: 'E' }, labels: { pad: 'R3', kbm: 'ALT' }, move: { pad: 'LS', kbm: 'WASD' }, aim: { pad: 'RS', kbm: 'mouse' }, skills: { pad: 'CRT', xb: 'VIEW', kbm: 'K' }, more: { pad: 'triangle', kbm: 'M' },\n};\nconst XB_TEXT = { L1: 'LB', R1: 'RB', L2: 'LT', R2: 'RT', R3: 'RS', LS: 'LS', RS: 'RS', OPT: 'MENU', CRT: 'VIEW' };\n// Draws a prompt; returns its width.\nexport function prompt(ui, x, y, action, device) {\n  const a = ACTIONS[action]; if (!a) return 0;\n  const dev = device ?? (ui.router.lastDevice === 'pad' ? 'pad' : 'kbm');\n  if (dev === 'kbm') {\n    const k = a.kbm;\n    if (k === 'mouseL' || k === 'mouseR') { const s = k === 'mouseL' ? MOUSE_L : MOUSE_R; ui.sprite(x, y, s.rows, s.colors); ui.lastPromptKind = 'mouse'; return 9; }\n    if (k === 'mouse') { ui.sprite(x, y, MOUSE_L.rows, { w: 'mist', r: 'mist' }); return 9; }\n    const w = ui.measure(k) + 5; ui.frame(x, y, w, 11, 'mist', 'night'); ui.text(x + 3, y + 2, k, { color: 'white', shadow: false }); ui.lastPromptKind = 'key'; return w;\n  }\n  const xb = ui.glyphs === 'xbox';\n  const k = a.pad;\n  if (PS[k]) { const s = (xb ? XB : PS)[k]; ui.sprite(x, y, s.rows, s.colors); ui.lastPromptKind = xb ? 'xbox' : 'playstation'; return 11; }\n  if (k.startsWith('d') && k !== 'dup' || k === 'dup') { const dir = k.slice(1); const s = DPAD(dir); ui.sprite(x, y + 1, s.rows, s.colors); return 9; }\n  const label = xb ? (XB_TEXT[k] ?? k) : k;\n  const w = ui.measure(label) + 5; ui.frame(x, y, w, 11, 'sky', 'navy'); ui.text(x + 3, y + 2, label, { color: 'white', shadow: false }); ui.lastPromptKind = xb ? 'xbox' : 'playstation'; return w;\n}\nexport function promptLine(ui, x, y, parts, o = {}) {\n  // parts: [[action, label], ...]; draws left to right from x, or fitted to the right edge with o.right.\n  let cx = x;\n  for (const [action, label] of parts) { const w = prompt(ui, cx, y, action); cx += w + 3; cx += ui.text(cx, y + 2, label, { color: o.color ?? 'mist' }) + 9; }\n  return cx - x;\n}\nexport const footer = (ui, parts) => {\n  const y = ui.H - 16; let total = 0; for (const [, label] of parts) total += ui.measure(label) + 26;\n  promptLine(ui, Math.max(12, ui.W / 2 - total / 2), y, parts);\n};\nEOF\necho ok","description":"Write input router, UI core and glyph prompts"}}}
