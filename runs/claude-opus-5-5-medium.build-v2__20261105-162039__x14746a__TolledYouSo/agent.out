0, 16], ForearmR: [-30, 0, 0], ForearmL: [-20, 0, 0] }, notes: 'A dragging corpse walk with one arm reaching.' }),\n];\nexport const ALL_CLIPS = [...HERO_CLIPS, ...NEW_CLIPS];\nconst UPPER = new Set(['Torso', 'Head', 'ArmR', 'ForearmR', 'HandR', 'ArmL', 'ForearmL', 'HandL']);\nexport const upperOnly = (THREE, clip) => new THREE.AnimationClip(`${clip.name}_upper`, clip.duration, clip.tracks.filter((t) => UPPER.has(t.name.split('.')[0])));\nEOF\ncat > tools/scratch/cl.mjs <<'EOF'\nimport { validateClip, compileClips, HERO_RIG, buildModel } from '../../pixel-engine.js';\nimport { NEW_CLIPS, ALL_CLIPS } from '../../src/view/clips.js';\nimport { MODELS } from '../../src/view/models/props.js';\nfor (const c of NEW_CLIPS){ const r=validateClip(c,HERO_RIG); if((r.errors??r.problems??r).length) console.log(c.name,JSON.stringify(r).slice(0,200)); }\nconst b=buildModel('hero_sexton',{catalog:MODELS}); const clips=compileClips(ALL_CLIPS,HERO_RIG,b.object); console.log(clips.length, clips.at(-1).name, clips.find(c=>c.name==='Dig').duration);\nEOF\nnode tools/scratch/mc.mjs | tail -1; node tools/scratch/cl.mjs 2>&1 | cut -c1-240 | tail -8; grep -n \"validateClip\" -A8 API.md | sed -n 2,14p | cut -c1-140","description":"Write animation clips and validate them"}}}
