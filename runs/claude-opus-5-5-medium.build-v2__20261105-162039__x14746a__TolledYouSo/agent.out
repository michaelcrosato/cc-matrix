{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkiDWLxjups4wfA9JoZ9","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01FUP2cSCWXQc3vz3pXUxmVH","name":"Bash","input":{"command":"cat > src/net/codec.js <<'EOF'\n// What crosses the wire. Flat integer arrays, positions times ten.\nexport const POS = 10;\nconst MAX_S = 1100;\nexport function encodeSnapshot(w, cursor = 0) {\n  const flags = (h) => (h.dead ? 1 : 0) | (h.moving ? 2 : 0) | (h.state === 'dodge' ? 4 : 0) | (h.left ? 8 : 0);\n  const heroes = w.heroes.map((h) => [h.id, Math.round(h.x * POS), Math.round(h.z * POS), Math.round(h.facing * 10), h.castSeq, Math.round(h.hp), Math.round(h.res), flags(h)]);\n  const live = w.heroes.filter((h) => !h.left);\n  const score = (m) => { let d = 1e9; for (const h of live) d = Math.min(d, (m.x - h.x) ** 2 + (m.z - h.z) ** 2); return d; };\n  const awake = w.active.filter((m) => !m.dead);\n  const sorted = awake.map((m) => [score(m), m]).sort((a, b) => a[0] - b[0]);\n  const enc = (m) => [m.id, Math.round(m.x * POS), Math.round(m.z * POS), Math.round(m.facing * 10), Math.round(m.hp)];\n  const monsters = []; const seen = new Set();\n  for (const [, m] of sorted.slice(0, 24)) { monsters.push(enc(m)); seen.add(m.id); }\n  const allies = w.allies.filter((a) => !a.dead).slice(0, 8).map((a) => [a.id, Math.round(a.x * POS), Math.round(a.z * POS), Math.round((a.facing ?? 0) * 10)]);\n  const out = { k: 's', t: w.tick, h: heroes, m: monsters, a: allies };\n  let size = JSON.stringify(out).length;\n  // A rotating slice of the rest, while it fits.\n  const rest = sorted.slice(24).filter(([d]) => d < 40 * 40).map(([, m]) => m);\n  let cur = cursor; let n = 0;\n  while (n < rest.length) {\n    const m = rest[cur % rest.length]; cur++; n++;\n    const e = enc(m); const add = JSON.stringify(e).length + 1;\n    if (size + add > MAX_S) break;\n    monsters.push(e); size += add;\n  }\n  return { msg: out, cursor: cur };\n}\nexport const HERO_FLAGS = { dead: 1, moving: 2, dodge: 4, left: 8 };\n// Host-only bookkeeping events never leave the host.\nexport const LOCAL_EVENTS = new Set(['sheet', 'save', 'music', 'tutorial']);\n// Every copy forwards what it has; what doesn't fit waits for the next batch.\nexport function batchEvents(queue, maxBytes = 12000) {\n  const out = []; let size = 20;\n  while (queue.length) { const s = JSON.stringify(queue[0]).length + 1; if (size + s > maxBytes) break; out.push(queue.shift()); size += s; }\n  return out;\n}\nexport function heroSheet(h) { return { id: h.id, level: h.level, xp: Math.round(h.xp), gold: h.gold, gear: h.gear, inv: h.inv, mats: h.mats, gems: h.gems, slots: h.slots, vows: h.vows, reliquary: h.reliquary, levelPicks: h.levelPicks.map((p) => ({ opts: p.opts, t: p.t })), cls: h.cls, newest: h.newest, name: h.name }; }\nexport const compactIntent = (it) => ({ k: 'i', x: Math.round(it.moveX * 100), z: Math.round(it.moveZ * 100), ax: Math.round((it.aimX ?? 0) * 100), az: Math.round((it.aimZ ?? 0) * 100), tx: it.tx !== undefined ? Math.round(it.tx * POS) : undefined, tz: it.tz !== undefined ? Math.round(it.tz * POS) : undefined, hd: it.hardAim ? 1 : 0, b: Object.keys(it.held ?? {}).join(',') });\nexport const expandIntent = (m) => ({ moveX: m.x / 100, moveZ: m.z / 100, aimX: m.ax / 100, aimZ: m.az / 100, tx: m.tx !== undefined ? m.tx / POS : undefined, tz: m.tz !== undefined ? m.tz / POS : undefined, hardAim: !!m.hd, held: Object.fromEntries((m.b ? m.b.split(',') : []).map((k) => [k, true])), pressed: {} });\nEOF\ncat > src/net/host.js <<'EOF'\n// The host's sim is the only truth: it takes intents and commands, and sends the world back.\nimport { applyCommand } from '../sim/commands.js';\nimport { batchEvents, encodeSnapshot, expandIntent, heroSheet, LOCAL_EVENTS } from './codec.js';\n\nexport class NetHost {\n  constructor(transport, world) {\n    this.t = transport; this.w = world; this.isHost = true; this.remote = {}; this.pressed = {}; this.cursor = 0; this.eventQ = []; this.tick = 0; this.sheetDirty = new Set(); this.sheetT = 0; this.sent = { s: 0, e: 0, maxS: 0, maxE: 0, count: 0 }; this.pendingCmd = [];\n    transport.on((data, from) => this.onMessage(data, from));\n  }\n  onMessage(m, from) {\n    if (m.k === 'i') this.remote[from] = expandIntent(m);\n    else if (m.k === 'c') { for (const p of m.p ?? []) { (this.pressed[from] ??= {})[p] = true; } for (const c of m.cmd ?? []) if (this.safeCommand(c)) applyCommand(this.w, from, c); if (m.iid !== undefined) (this.pressed[from] ??= {}).__iid = m.iid; }\n  }\n  safeCommand(c) { return c && c.c !== 'dev' && c.c !== 'travel' && c.c !== 'bell' && c.c !== 'knell'; }\n  remoteIntent(seat) {\n    const base = this.remote[seat] ?? { moveX: 0, moveZ: 0, pressed: {}, held: {} }; const p = this.pressed[seat];\n    if (p) { const iid = p.__iid; delete p.__iid; base.pressed = { ...p }; if (iid !== undefined) base.interactId = iid; this.pressed[seat] = null; } else { base.pressed = {}; base.interactId = undefined; }\n    return base;\n  }\n  // Called once per fixed step on the host, after the sim moved.\n  afterStep() {\n    this.tick++;\n    if (this.tick % 6 === 0) { const { msg, cursor } = encodeSnapshot(this.w, this.cursor); this.cursor = cursor; const size = JSON.stringify(msg).length; this.sent.maxS = Math.max(this.sent.maxS, size); this.t.send(msg, { reliable: false }); this.sent.s++; this.sent.count++; }\n    if (this.tick % 12 === 0) this.flushEvents();\n    if (this.tick % 30 === 0) for (const seat of this.sheetDirty) { const h = this.w.heroes.find((q) => q.seat === seat); if (h && seat !== this.t.me) { this.t.send({ k: 'sheet', d: heroSheet(h) }, { to: seat, reliable: true }); this.sent.count++; } this.sheetDirty.delete(seat); }\n  }\n  flushEvents() {\n    if (!this.eventQ.length) return;\n    const batch = batchEvents(this.eventQ); const msg = { k: 'e', v: batch }; const size = JSON.stringify(msg).length; this.sent.maxE = Math.max(this.sent.maxE, size);\n    this.t.send(msg, { reliable: true }); this.sent.e++; this.sent.count++;\n  }\n  outgoing(events) {\n    for (const ev of events) {\n      if (ev.t === 'sheet') { this.sheetDirty.add(ev.seat); continue; }\n      if (ev.t === 'level' || ev.t === 'equip') this.sheetDirty.add(ev.seat);\n      if (LOCAL_EVENTS.has(ev.t)) continue;\n      this.eventQ.push(strip(ev));\n    }\n  }\n}\nfunction strip(ev) { const o = {}; for (const k of Object.keys(ev)) { const v = ev[k]; if (v === undefined || typeof v === 'function') continue; o[k] = typeof v === 'number' ? Math.round(v * 100) / 100 : v; } return o; }\nEOF\ncat > src/net/client.js <<'EOF'\n// A client: the same map from the same seed, a mirror of the world, and only intent sent back.\nimport { DT, moveCircle } from '../sim/world.js';\nimport { spawnMonster } from '../sim/monsters.js';\nimport { SKILLS } from '../data/classes.js';\nimport { compactIntent, HERO_FLAGS, POS } from './codec.js';\nimport { MONSTERS } from '../data/monsters.js';\nimport { refresh } from '../sim/hero.js';\nimport { removePropBy } from './mirror.js';\n\nexport class NetClient {\n  constructor(transport, world, seat) {\n    this.t = transport; this.w = world; this.seat = seat; this.isHost = false; this.pressQ = {}; this.cmdQ = []; this.iidQ = undefined; this.tickN = 0; this.correct = 0; this.applied = 0; this.lastSnap = 0; this.onEvent = null; this.msgs = 0; this.errorMax = 0;\n    transport.on((data) => this.onMessage(data));\n  }\n  sendCommand(c) { this.cmdQ.push(c); }\n  // Collects this step's intent; sends at 10 Hz, presses on change at up to 8 Hz.\n  step(intent) {\n    this.tickN++;\n    for (const k of Object.keys(intent.pressed ?? {})) this.pressQ[k] = true;\n    if (intent.interactId !== undefined) this.iidQ = intent.interactId;\n    this.lastIntent = intent;\n    if (this.tickN % 6 === 0) { this.t.send(compactIntent(intent), { reliable: false }); this.msgs++; }\n    if (this.tickN % 8 === 0 && (Object.keys(this.pressQ).length || this.cmdQ.length || this.iidQ !== undefined)) {\n      const ok = this.t.send({ k: 'c', p: Object.keys(this.pressQ), cmd: this.cmdQ, iid: this.iidQ }, { reliable: true });\n      this.msgs++;\n      if (ok !== false) { this.pressQ = {}; this.cmdQ = []; this.iidQ = undefined; }\n    }\n    this.predict(intent);\n    this.w.tick++; this.w.time += DT;\n    this.interp();\n  }\n  predict(it) {\n    const h = this.w.heroes.find((q) => q.seat === this.seat); if (!h || h.dead || h.left) return;\n    h.px = h.x; h.pz = h.z;\n    const mag = Math.hypot(it.moveX, it.moveZ);\n    if (mag > 0.15 && h.castT <= 0) { const sp = h.stats.speed * Math.min(1, mag); moveCircle(this.w, h, (it.moveX / mag) * sp * DT, (it.moveZ / mag) * sp * DT); h.moving = true; h.speedNow = sp; if (!it.hardAim) h.facing = Math.atan2(it.moveX, it.moveZ); }\n    else h.moving = false;\n    if (it.hardAim) h.facing = Math.atan2(it.aimX, it.aimZ);\n    if (h.castT > 0) h.castT -= DT;\n    // Correct smoothly past 1 m of error.\n    if (h.netX !== undefined) { const ex = h.netX - h.x; const ez = h.netZ - h.z; const e = Math.hypot(ex, ez); this.errorMax = Math.max(this.errorMax, e); if (e > 1) { h.x += ex * 0.1; h.z += ez * 0.1; this.correct++; } if (e > 6) { h.x = h.netX; h.z = h.netZ; } }\n  }\n  interp() {\n    // Everyone else eases toward the last snapshot, about 120 ms behind.\n    const k = 0.14;\n    for (const h of this.w.heroes) { if (h.seat === this.seat || h.netX === undefined) continue; h.px = h.x; h.pz = h.z; h.x += (h.netX - h.x) * k; h.z += (h.netZ - h.z) * k; }\n    for (const m of this.w.monsters) { if (m.dead || m.netX === undefined) continue; m.px = m.x; m.pz = m.z; m.x += (m.netX - m.x) * k; m.z += (m.netZ - m.z) * k; }\n    for (const a of this.w.allies) { if (a.netX === undefined) continue; a.px = a.x; a.pz = a.z; a.x += (a.netX - a.x) * k; a.z += (a.netZ - a.z) * k; }\n  }\n  onMessage(m) {\n    if (m.k === 's') this.applySnapshot(m);\n    else if (m.k === 'e') for (const ev of m.v) this.applyEvent(ev);\n    else if (m.k === 'sheet') this.applySheet(m.d);\n  }\n  applySnapshot(s) {\n    if (s.t < this.lastSnap) return; this.lastSnap = s.t; this.applied++;\n    const w = this.w;\n    for (const [id, x, z, f, seq, hp, res, fl] of s.h) {\n      const h = w.heroes.find((q) => q.id === id); if (!h) continue;\n      h.netX = x / POS; h.netZ = z / POS; if (h.seat !== this.seat) { h.facing = f / 10; h.moving = (fl & HERO_FLAGS.moving) !== 0; h.speedNow = h.stats.speed; }\n      h.hp = hp; h.res = res; const dead = (fl & HERO_FLAGS.dead) !== 0; h.dead = dead; h.state = (fl & HERO_FLAGS.dodge) ? 'dodge' : dead ? 'dead' : 'idle'; h.left = (fl & HERO_FLAGS.left) !== 0;\n      h.castSeq = seq;\n    }\n    const map = this.mmap ?? (this.mmap = new Map());\n    if (map.size !== w.monsters.length) { map.clear(); for (const m of w.monsters) map.set(m.id, m); }\n    for (const [id, x, z, f, hp] of s.m) { const m = map.get(id); if (!m || m.dead) continue; if (m.dormant) { m.dormant = false; m.x = x / POS; m.z = z / POS; m.px = m.x; m.pz = m.z; } m.netX = x / POS; m.netZ = z / POS; m.facing = f / 10; m.hp = hp; }\n    for (const [id, x, z, f] of s.a) { const a = w.allies.find((q) => q.id === id); if (a) { a.netX = x / POS; a.netZ = z / POS; a.facing = f / 10; } }\n    w.active = w.monsters.filter((q) => !q.dead && !q.dormant);\n  }\n  applySheet(d) {\n    const h = this.w.heroes.find((q) => q.id === d.id); if (!h) return;\n    Object.assign(h, { level: d.level, xp: d.xp, gold: d.gold, gear: d.gear, inv: d.inv, mats: d.mats, gems: d.gems, slots: d.slots, vows: d.vows, reliquary: d.reliquary, levelPicks: d.levelPicks, cls: d.cls, newest: d.newest });\n    h._skillCache = null; const hp = h.hp; refresh(this.w, h); h.hp = hp;\n  }\n  applyEvent(ev) {\n    const w = this.w;\n    switch (ev.t) {\n      case 'mspawn': {\n        let m = w.monsters.find((q) => q.id === ev.id);\n        if (!m) { const nid = w.nextId; w.nextId = ev.id; m = spawnMonster(w, ev.type, ev.x, ev.z, { dormant: false, elite: ev.elite, affl: ev.affl, name: ev.name, tint: ev.tint, level: ev.level }); w.nextId = Math.max(nid, ev.id + 1); m.maxHp = ev.maxHp; m.hp = ev.hp; m.scale = ev.sm ?? m.scale; w.events.pop?.call; this.mmap = null; }\n        else { m.dormant = false; m._woke = true; m.x = ev.x; m.z = ev.z; m.px = m.x; m.pz = m.z; m.maxHp = ev.maxHp; m.hp = ev.hp; m.name = ev.name; m.level = ev.level; }\n        m.defn = MONSTERS[ev.type]; break;\n      }\n      case 'death': { const m = w.monsters.find((q) => q.id === ev.id); if (m) { m.dead = true; } w.stats.kills++; break; }\n      case 'hit': { const m = w.monsters.find((q) => q.id === ev.id); if (m) { m.hp = Math.max(0, m.hp - ev.amt); m.flash = 2; } break; }\n      case 'drop': w.drops.push({ id: ev.id, kind: ev.kind, x: ev.x, z: ev.z, rarity: ev.rarity, name: ev.name, seat: ev.seat, slot: ev.slot, fx: ev.fx, fz: ev.fz, amount: ev.amount }); break;\n      case 'pickup': { const i = w.drops.findIndex((d) => d.id === ev.id); if (i >= 0) w.drops.splice(i, 1); break; }\n      case 'break': case 'chest': case 'shrine': case 'relic': case 'lever': case 'propgone': removePropBy(w, ev); break;\n      case 'propadd': if (!w.props.some((p) => p.id === ev.id)) w.props.push({ id: ev.id, kind: ev.kind, x: ev.x, z: ev.z, model: ev.model, label: ev.label, interact: true, r: 1.2 }); break;\n      case 'boss': if (ev.on) { const m = w.monsters.find((q) => q.id === ev.id); w.boss = { id: ev.id, name: ev.name, ticks: ev.ticks ?? [], m }; } else w.boss = null; break;\n      case 'meter': if (w.knell) w.knell.meter = ev.v * w.knell.total; break;\n      case 'knell': if (w.knell && ev.total) { w.knell.total = ev.total; w.knell.mods = ev.mods; } break;\n      case 'banner': if (ev.text === 'THE KNELL TOLLS' && w.knell) { w.knell.stage = 'warden'; w.knell.meter = w.knell.total; } break;\n      case 'cast': { const h = w.heroes.find((q) => q.id === ev.id); if (h && !ev.dodge && ev.skill) { const sk = SKILLS[ev.skill]; if (sk?.cd) h.cds[ev.skill] = w.time + sk.cd * (1 - Math.min(50, h.stats.cdr) / 100); if (h.seat === this.seat && !sk.moving) h.castT = ev.dur * 0.75; } break; }\n      case 'classswap': { const h = w.heroes.find((q) => q.id === ev.id); if (h) { h.cls = ev.cls; } break; }\n      case 'ally': if (!w.allies.some((a) => a.id === ev.id)) w.allies.push({ id: ev.id, kind: ev.kind, x: ev.x, z: ev.z, px: ev.x, pz: ev.z, facing: 0, owner: ev.owner, seat: ev.seat, big: ev.big, minion: true }); break;\n      case 'allygone': { const i = w.allies.findIndex((a) => a.id === ev.id); if (i >= 0) w.allies[i].dead = true; w.allies = w.allies.filter((a) => !a.dead || a.id === ev.id); break; }\n      default: break;\n    }\n    this.onEvent?.(ev);\n  }\n}\nEOF\ncat > src/net/mirror.js <<'EOF'\n// Small helpers for the client's mirror of the host's props.\nexport function removePropBy(w, ev) {\n  const p = w.props.find((q) => q.id === ev.id); if (!p) return;\n  if (ev.t === 'break') { p.broken = true; p.hp = 0; }\n  else if (ev.t === 'propgone') { w.props = w.props.filter((q) => q !== p); }\n  else p.used = true;\n}\nexport const hubColors = ['red', 'blue', 'lime', 'sand'];\nEOF\ncat > src/net/hubflow.js <<'EOF'\n// AI Hub sessions: connect, build the round from the seed, own card, play, finish, end.\nimport { Engine, THREE } from '../../pixel-engine.js';\nimport { CLASSES } from '../data/classes.js';\nimport { TITLE } from '../data/meta.js';\nimport { addHero, newWorld, stepWorld } from '../sim/step.js';\nimport { presetHero, scoreOf, SEAT_CLASS, setupRound } from '../sim/round.js';\nimport { NetClient } from './client.js';\nimport { hubColors } from './mirror.js';\nimport { NetHost } from './host.js';\nimport { prompt } from '../ui/glyphs.js';\n\nexport function hubTransport(info) {\n  const handlers = [];\n  AIHub.on('message', (d, from) => { for (const h of handlers) h(d, from); });\n  return { me: info.me, send: (d, o) => AIHub.send(d, o), on: (fn) => handlers.push(fn) };\n}\nexport function buildRoundWorld(info) {\n  const w = newWorld({ seed: info.seed, difficulty: 0 }); w.mode = 'session';\n  for (const p of info.players) { const h = addHero(w, { seat: p.id, cls: SEAT_CLASS[p.id % 4], name: p.name }); presetHero(w, h); }\n  setupRound(w, info.players.length);\n  w.events.length = 0;\n  return w;\n}\n// One session object drives the game inside the engine's hooks.\nexport class Session {\n  constructor(info) { this.info = info; this.phase = 'card'; this.card = { left: null, ready: [], asking: 0, asked: false, paused: false, starting: false }; this.ended = false; this.finished = false; this.answered = false; this.server = !!info.server; this.timeUp = false; }\n  async setup(game) {\n    this.game = game; const info = this.info; const ctx = game.ctx;\n    this.world = buildRoundWorld(info);\n    const t = hubTransport(info);\n    this.isHost = info.isHost;\n    this.net = info.isHost ? new NetHost(t, this.world) : new NetClient(t, this.world, info.me);\n    this.net.onEvent = (ev) => this.world.events.push(ev);\n    if (info.isHost) { this.net.intentFor = (seat, w, view) => (seat === info.me ? game.router.intentFor(0, w, view, w.heroes.find((h) => h.seat === seat)) : this.net.remoteIntent(seat)); this.net.canStep = () => this.playing(); }\n    else { this.net.intentFor = () => ({}); this.net.fixed = (dt) => { if (this.playing() && !this.ended) { const h = this.world.heroes.find((q) => q.seat === info.me); const it = h ? game.router.intentFor(0, this.world, game.play.view, h) : { moveX: 0, moveZ: 0, pressed: {}, held: {} }; this.net.step(it); } }; this.net.canStep = () => false; }\n    this.net.update = () => {};\n    AIHub.on('card', (c) => { this.card = c; });\n    AIHub.on('start', () => { this.phase = 'countdown'; });\n    AIHub.on('leave', ({ id }) => { const h = this.world.heroes.find((q) => q.seat === id); if (h) { h.left = true; if (!this.server) game.play?.hud.toast(`${h.name} HAS LEFT.`, 'mist'); } });\n    AIHub.on('time-up', () => { this.timeUp = true; if (this.isHost) this.finish(false); });\n    AIHub.on('end', () => this.end());\n    if (!this.server) {\n      game.play.begin(this.world, { local: info.players.some((p) => p.id === info.me) ? [info.me] : [], net: this.net });\n      game.shell.state = 'session';\n      game.music.play('knell');\n      game.settings.load({});\n      this.onKey = (e) => { if (this.phase !== 'card' || this.ended) return; if (e.key === 'Enter') { AIHub.answer('ready'); this.answered = true; } if (e.key === 'm' || e.key === 'M') AIHub.answer('more'); };\n      if (typeof window !== 'undefined') window.addEventListener('keydown', this.onKey);\n    } else { this.net.update = () => {}; }\n    AIHub.ready();\n  }\n  playing() { return AIHub.time() >= 0 && !this.ended && this.phase !== 'card'; }\n  fixed(dt) {\n    if (this.ended) return;\n    if (this.server) { if (this.playing()) { stepWorld(this.world, this.gather()); this.net.afterStep(); const ev = this.world.events; this.world.events = []; this.net.outgoing(ev); this.check(); } return; }\n    if (this.phase === 'card') return;\n    this.game.play.fixed(dt);\n    if (this.isHost) this.check();\n  }\n  gather() { const out = {}; for (const h of this.world.heroes) if (!h.left) out[h.seat] = this.net.remoteIntent(h.seat); return out; }\n  check() { const r = this.world.round; if (r?.wardenDead && !this.finished) this.finish(true); if (!this.finished && this.world.heroes.every((h) => h.left) ) this.finish(false); }\n  finish(won) {\n    if (this.finished) return; this.finished = true;\n    const players = this.world.heroes.filter((h) => !h.left);\n    const scored = players.map((h) => ({ h, s: Math.round(scoreOf(h)) })).sort((a, b) => b.s - a.s);\n    const standings = []; let last = null; for (const { h, s } of scored) { if (last === s) standings[standings.length - 1].push(h.seat); else standings.push([h.seat]); last = s; }\n    const scores = {}; const stats = {}; for (const { h, s } of scored) { scores[h.seat] = s; stats[h.seat] = { Damage: Math.round(h.damage), Kills: h.kills, Revives: h.revives, Deaths: h.deaths, Gold: h.goldEarned }; }\n    const top = (key, title, detail) => { if (!players.length) return null; const best = players.reduce((a, b) => (b[key] > a[key] ? b : a)); return best[key] > 0 ? { id: best.seat, title, detail: `${detail}: ${Math.round(best[key])}` } : null; };\n    const awards = [top('damage', 'Bell-Ringer', 'Most damage'), top('kills', 'Undertaker', 'Most kills'), top('revives', 'Good Samaritan', 'Most revives'), top('goldEarned', 'Collector', 'Most gold'), top('deaths', 'Regular Customer', 'Most deaths')].filter(Boolean);\n    AIHub.finish({ standings, scores, won, stats, awards });\n  }\n  end() {\n    if (this.ended) return; this.ended = true;\n    if (typeof window !== 'undefined' && this.onKey) window.removeEventListener('keydown', this.onKey);\n    if (this.game && !this.server) { this.game.music.stopAll(); this.game.voice.stop(); this.game.play.running = false; this.game.ctx.engine.timeScale = 0; }\n  }\n  update(dt) {\n    const game = this.game; const ui = game.ui; if (this.server || !game) return;\n    if (this.ended) { return; }\n    const play = game.play; const m = ui.m;\n    if (this.phase === 'card') { play.net && (play.ctx.camera.setZoom(1.2)); this.keepCardView(dt); this.drawCard(ui, m); return; }\n    if (AIHub.time() >= 0) this.phase = 'play';\n    play.update(dt);\n    if (this.phase === 'countdown') { const left = Math.ceil(-AIHub.time() / 1000); ui.textC(ui.W / 2, ui.H * 0.34, String(Math.max(1, left)), { color: 'sand', scale: 4 }); }\n    const round = this.world.round; if (this.isHost && round) round.tShown = round.t;\n  }\n  keepCardView(dt) {\n    const play = this.game.play; const w = this.world; const e = w.zone.entrance;\n    play.view.update(w, dt, 1, {}); play.target.set(e.x, 0.9, e.z); play.view.focus.set(e.x, 0, e.z);\n    w.events.length = 0;\n  }\n  drawCard(ui, m) {\n    const info = this.info; const c = this.card;\n    const W = Math.min(ui.W - 24, 380); const X = ui.W / 2 - W / 2; const Y = 14; const H = ui.H - 28;\n    ui.frame(X, Y, W, H, 'sand', 'ink');\n    ui.textC(ui.W / 2, Y + 6, TITLE, { color: 'sand', scale: 2 });\n    ui.textC(ui.W / 2, Y + 26, 'FILL THE KNELL, THEN SLAY ITS WARDEN TOGETHER', { color: 'white' });\n    info.players.forEach((p, i) => { const y = Y + 40 + i * 12; const rd = c.ready?.includes(p.id); ui.rect(X + 10, y, 8, 8, hubColors[p.id % 4]); ui.text(X + 22, y + 1, String(p.name).slice(0, 20), { color: hubColors[p.id % 4] }); ui.textR(X + W - 10, y + 1, rd ? 'READY' : `${CLASSES[SEAT_CLASS[p.id % 4]].name}`, { color: rd ? 'lime' : 'mist' }); });\n    const cy = Y + 92; let x = X + 10;\n    for (const [a, l] of [['move', 'MOVE'], ['skill0', 'ATTACK'], ['skill1', 'SKILL'], ['dodge', 'DODGE'], ['potion', 'DRINK']]) { const w = prompt(ui, x, cy, a); x += w + 3; x += ui.text(x, cy + 2, l, { color: 'mist' }) + 6; }\n    ui.text(X + 10, cy + 16, 'STAND ON A CLASS FONT FOR 2 S IN THE FIRST ROOM TO SWAP.', { color: 'mist' });\n    const secs = c.left === null || c.left === undefined ? '' : `${Math.ceil(c.left / 1000)} S`;\n    ui.textC(ui.W / 2, cy + 30, c.paused ? 'HOLDING: MORE TIME ASKED' : c.starting ? 'STARTING' : secs, { color: 'sand', scale: 1 });\n    const by = Y + H - 26;\n    if (ui.button('card:ready', ui.W / 2 - 110, by, 104, 20, c.ready?.includes(info.me) ? 'READY!' : 'READY', { border: 'lime' }) || (this.game.router.pads.some((p) => (p.b & 1) && !(p.prev & 1)))) { AIHub.answer('ready'); }\n    if (ui.button('card:more', ui.W / 2 + 6, by, 104, 20, c.asked ? 'NEVER MIND' : 'MORE TIME', { first: false }) || (this.game.router.pads.some((p) => (p.b & 8) && !(p.prev & 8)))) { AIHub.answer('more'); }\n  }\n}\nexport async function runHubFlow(info, createGame, options, onFail) {\n  const session = new Session(info);\n  try { return await Engine.start(createGame({ session, noSaveBoot: true }), options); } catch (e) { AIHub.fail(String(e?.message ?? e)); onFail(e); return null; }\n}\n// A copy with no player: the engine on no GPU, driven by a timer.\nexport async function runServerCopy(info, createGame) {\n  const session = new Session(info);\n  const engine = await Engine.headless(createGame({ session, noSaveBoot: true }), {});\n  let last = performance.now(); let acc = 0;\n  const timer = setInterval(() => { const now = performance.now(); acc += Math.min(0.5, (now - last) / 1000); last = now; const n = Math.floor(acc * 60); if (n > 0) { acc -= n / 60; engine.step(n); } if (session.ended) clearInterval(timer); }, 33);\n  return engine;\n}\nexport { THREE };\nEOF\npython3 - <<'EOF'\np='src/input/router.js'; s=open(p).read()\ns=s.replace(\"\"\"  intentFor(seat, w, view) {\n    const it = { moveX: 0, moveZ: 0, pressed: this.latch[seat], held: {} }; this.latch[seat] = {};\n    const pad = this.seatPad[seat]; const inp = this.ctx.input; const h = w.heroes.find((q) => q.seat === seat);\"\"\",\"\"\"  intentFor(seat, w, view, hero = null) {\n    const it = { moveX: 0, moveZ: 0, pressed: this.latch[seat], held: {} }; this.latch[seat] = {};\n    const pad = this.seatPad[seat]; const h = hero ?? w.heroes.find((q) => q.seat === seat);\"\"\")\nopen(p,'w').write(s)\np='src/modes/play.js'; s=open(p).read()\ns=s.replace(\"if (this.net && !this.net.isHost) { this.net.fixed(dt); return; }\\n    if (this.net && !this.net.canStep()) return;\",\"if (this.net && !this.net.isHost) { this.net.fixed(dt); return; }\\n    if (this.net && !this.net.canStep()) return;\")\ns=s.replace(\"    this.net?.outgoing?.(events);\\n\",\"    if (this.net?.isHost) this.net.outgoing(events);\\n\")\nopen(p,'w').write(s)\nEOF\ncat > index.html <<'EOF'\n<!doctype html><html><head><meta charset=\"utf-8\"><title>Tolled You So</title></head><body><div id=\"app\"></div><script type=\"module\" src=\"game.js\"></script></body></html>\nEOF\nnode tools/build.mjs 2>&1 | tail -3 | cut -c1-300; node check.mjs --headless game.js --keys Enter*2,Enter*2 2>&1 | tail -12 | cut -c1-300","description":"Write netcode and session flow, build, run headless check"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":18615,"cache_read_input_tokens":568100,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18615},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"69254de6-4061-470e-8e76-10f1ee96c6e5","uuid":"da554649-2f82-46cd-aaff-a453b4efd385","timestamp":"2026-11-06T00:18:05.283Z","request_id":"req_011CgkiDW65tPGJdN69REpZr","wire_tool_inputs":{"toolu_01FUP2cSCWXQc3vz3pXUxmVH":{"command":"cat > src/net/codec.js <<'EOF'\n// What crosses the wire. Flat integer arrays, positions times ten.\nexport const POS = 10;\nconst MAX_S = 1100;\nexport function encodeSnapshot(w, cursor = 0) {\n  const flags = (h) => (h.dead ? 1 : 0) | (h.moving ? 2 : 0) | (h.state === 'dodge' ? 4 : 0) | (h.left ? 8 : 0);\n  const heroes = w.heroes.map((h) => [h.id, Math.round(h.x * POS), Math.round(h.z * POS), Math.round(h.facing * 10), h.castSeq, Math.round(h.hp), Math.round(h.res), flags(h)]);\n  const live = w.heroes.filter((h) => !h.left);\n  const score = (m) => { let d = 1e9; for (const h of live) d = Math.min(d, (m.x - h.x) ** 2 + (m.z - h.z) ** 2); return d; };\n  const awake = w.active.filter((m) => !m.dead);\n  const sorted = awake.map((m) => [score(m), m]).sort((a, b) => a[0] - b[0]);\n  const enc = (m) => [m.id, Math.round(m.x * POS), Math.round(m.z * POS), Math.round(m.facing * 10), Math.round(m.hp)];\n  const monsters = []; const seen = new Set();\n  for (const [, m] of sorted.slice(0, 24)) { monsters.push(enc(m)); seen.add(m.id); }\n  const allies = w.allies.filter((a) => !a.dead).slice(0, 8).map((a) => [a.id, Math.round(a.x * POS), Math.round(a.z * POS), Math.round((a.facing ?? 0) * 10)]);\n  const out = { k: 's', t: w.tick, h: heroes, m: monsters, a: allies };\n  let size = JSON.stringify(out).length;\n  // A rotating slice of the rest, while it fits.\n  const rest = sorted.slice(24).filter(([d]) => d < 40 * 40).map(([, m]) => m);\n  let cur = cursor; let n = 0;\n  while (n < rest.length) {\n    const m = rest[cur % rest.length]; cur++; n++;\n    const e = enc(m); const add = JSON.stringify(e).length + 1;\n    if (size + add > MAX_S) break;\n    monsters.push(e); size += add;\n  }\n  return { msg: out, cursor: cur };\n}\nexport const HERO_FLAGS = { dead: 1, moving: 2, dodge: 4, left: 8 };\n// Host-only bookkeeping events never leave the host.\nexport const LOCAL_EVENTS = new Set(['sheet', 'save', 'music', 'tutorial']);\n// Every copy forwards what it has; what doesn't fit waits for the next batch.\nexport function batchEvents(queue, maxBytes = 12000) {\n  const out = []; let size = 20;\n  while (queue.length) { const s = JSON.stringify(queue[0]).length + 1; if (size + s > maxBytes) break; out.push(queue.shift()); size += s; }\n  return out;\n}\nexport function heroSheet(h) { return { id: h.id, level: h.level, xp: Math.round(h.xp), gold: h.gold, gear: h.gear, inv: h.inv, mats: h.mats, gems: h.gems, slots: h.slots, vows: h.vows, reliquary: h.reliquary, levelPicks: h.levelPicks.map((p) => ({ opts: p.opts, t: p.t })), cls: h.cls, newest: h.newest, name: h.name }; }\nexport const compactIntent = (it) => ({ k: 'i', x: Math.round(it.moveX * 100), z: Math.round(it.moveZ * 100), ax: Math.round((it.aimX ?? 0) * 100), az: Math.round((it.aimZ ?? 0) * 100), tx: it.tx !== undefined ? Math.round(it.tx * POS) : undefined, tz: it.tz !== undefined ? Math.round(it.tz * POS) : undefined, hd: it.hardAim ? 1 : 0, b: Object.keys(it.held ?? {}).join(',') });\nexport const expandIntent = (m) => ({ moveX: m.x / 100, moveZ: m.z / 100, aimX: m.ax / 100, aimZ: m.az / 100, tx: m.tx !== undefined ? m.tx / POS : undefined, tz: m.tz !== undefined ? m.tz / POS : undefined, hardAim: !!m.hd, held: Object.fromEntries((m.b ? m.b.split(',') : []).map((k) => [k, true])), pressed: {} });\nEOF\ncat > src/net/host.js <<'EOF'\n// The host's sim is the only truth: it takes intents and commands, and sends the world back.\nimport { applyCommand } from '../sim/commands.js';\nimport { batchEvents, encodeSnapshot, expandIntent, heroSheet, LOCAL_EVENTS } from './codec.js';\n\nexport class NetHost {\n  constructor(transport, world) {\n    this.t = transport; this.w = world; this.isHost = true; this.remote = {}; this.pressed = {}; this.cursor = 0; this.eventQ = []; this.tick = 0; this.sheetDirty = new Set(); this.sheetT = 0; this.sent = { s: 0, e: 0, maxS: 0, maxE: 0, count: 0 }; this.pendingCmd = [];\n    transport.on((data, from) => this.onMessage(data, from));\n  }\n  onMessage(m, from) {\n    if (m.k === 'i') this.remote[from] = expandIntent(m);\n    else if (m.k === 'c') { for (const p of m.p ?? []) { (this.pressed[from] ??= {})[p] = true; } for (const c of m.cmd ?? []) if (this.safeCommand(c)) applyCommand(this.w, from, c); if (m.iid !== undefined) (this.pressed[from] ??= {}).__iid = m.iid; }\n  }\n  safeCommand(c) { return c && c.c !== 'dev' && c.c !== 'travel' && c.c !== 'bell' && c.c !== 'knell'; }\n  remoteIntent(seat) {\n    const base = this.remote[seat] ?? { moveX: 0, moveZ: 0, pressed: {}, held: {} }; const p = this.pressed[seat];\n    if (p) { const iid = p.__iid; delete p.__iid; base.pressed = { ...p }; if (iid !== undefined) base.interactId = iid; this.pressed[seat] = null; } else { base.pressed = {}; base.interactId = undefined; }\n    return base;\n  }\n  // Called once per fixed step on the host, after the sim moved.\n  afterStep() {\n    this.tick++;\n    if (this.tick % 6 === 0) { const { msg, cursor } = encodeSnapshot(this.w, this.cursor); this.cursor = cursor; const size = JSON.stringify(msg).length; this.sent.maxS = Math.max(this.sent.maxS, size); this.t.send(msg, { reliable: false }); this.sent.s++; this.sent.count++; }\n    if (this.tick % 12 === 0) this.flushEvents();\n    if (this.tick % 30 === 0) for (const seat of this.sheetDirty) { const h = this.w.heroes.find((q) => q.seat === seat); if (h && seat !== this.t.me) { this.t.send({ k: 'sheet', d: heroSheet(h) }, { to: seat, reliable: true }); this.sent.count++; } this.sheetDirty.delete(seat); }\n  }\n  flushEvents() {\n    if (!this.eventQ.length) return;\n    const batch = batchEvents(this.eventQ); const msg = { k: 'e', v: batch }; const size = JSON.stringify(msg).length; this.sent.maxE = Math.max(this.sent.maxE, size);\n    this.t.send(msg, { reliable: true }); this.sent.e++; this.sent.count++;\n  }\n  outgoing(events) {\n    for (const ev of events) {\n      if (ev.t === 'sheet') { this.sheetDirty.add(ev.seat); continue; }\n      if (ev.t === 'level' || ev.t === 'equip') this.sheetDirty.add(ev.seat);\n      if (LOCAL_EVENTS.has(ev.t)) continue;\n      this.eventQ.push(strip(ev));\n    }\n  }\n}\nfunction strip(ev) { const o = {}; for (const k of Object.keys(ev)) { const v = ev[k]; if (v === undefined || typeof v === 'function') continue; o[k] = typeof v === 'number' ? Math.round(v * 100) / 100 : v; } return o; }\nEOF\ncat > src/net/client.js <<'EOF'\n// A client: the same map from the same seed, a mirror of the world, and only intent sent back.\nimport { DT, moveCircle } from '../sim/world.js';\nimport { spawnMonster } from '../sim/monsters.js';\nimport { SKILLS } from '../data/classes.js';\nimport { compactIntent, HERO_FLAGS, POS } from './codec.js';\nimport { MONSTERS } from '../data/monsters.js';\nimport { refresh } from '../sim/hero.js';\nimport { removePropBy } from './mirror.js';\n\nexport class NetClient {\n  constructor(transport, world, seat) {\n    this.t = transport; this.w = world; this.seat = seat; this.isHost = false; this.pressQ = {}; this.cmdQ = []; this.iidQ = undefined; this.tickN = 0; this.correct = 0; this.applied = 0; this.lastSnap = 0; this.onEvent = null; this.msgs = 0; this.errorMax = 0;\n    transport.on((data) => this.onMessage(data));\n  }\n  sendCommand(c) { this.cmdQ.push(c); }\n  // Collects this step's intent; sends at 10 Hz, presses on change at up to 8 Hz.\n  step(intent) {\n    this.tickN++;\n    for (const k of Object.keys(intent.pressed ?? {})) this.pressQ[k] = true;\n    if (intent.interactId !== undefined) this.iidQ = intent.interactId;\n    this.lastIntent = intent;\n    if (this.tickN % 6 === 0) { this.t.send(compactIntent(intent), { reliable: false }); this.msgs++; }\n    if (this.tickN % 8 === 0 && (Object.keys(this.pressQ).length || this.cmdQ.length || this.iidQ !== undefined)) {\n      const ok = this.t.send({ k: 'c', p: Object.keys(this.pressQ), cmd: this.cmdQ, iid: this.iidQ }, { reliable: true });\n      this.msgs++;\n      if (ok !== false) { this.pressQ = {}; this.cmdQ = []; this.iidQ = undefined; }\n    }\n    this.predict(intent);\n    this.w.tick++; this.w.time += DT;\n    this.interp();\n  }\n  predict(it) {\n    const h = this.w.heroes.find((q) => q.seat === this.seat); if (!h || h.dead || h.left) return;\n    h.px = h.x; h.pz = h.z;\n    const mag = Math.hypot(it.moveX, it.moveZ);\n    if (mag > 0.15 && h.castT <= 0) { const sp = h.stats.speed * Math.min(1, mag); moveCircle(this.w, h, (it.moveX / mag) * sp * DT, (it.moveZ / mag) * sp * DT); h.moving = true; h.speedNow = sp; if (!it.hardAim) h.facing = Math.atan2(it.moveX, it.moveZ); }\n    else h.moving = false;\n    if (it.hardAim) h.facing = Math.atan2(it.aimX, it.aimZ);\n    if (h.castT > 0) h.castT -= DT;\n    // Correct smoothly past 1 m of error.\n    if (h.netX !== undefined) { const ex = h.netX - h.x; const ez = h.netZ - h.z; const e = Math.hypot(ex, ez); this.errorMax = Math.max(this.errorMax, e); if (e > 1) { h.x += ex * 0.1; h.z += ez * 0.1; this.correct++; } if (e > 6) { h.x = h.netX; h.z = h.netZ; } }\n  }\n  interp() {\n    // Everyone else eases toward the last snapshot, about 120 ms behind.\n    const k = 0.14;\n    for (const h of this.w.heroes) { if (h.seat === this.seat || h.netX === undefined) continue; h.px = h.x; h.pz = h.z; h.x += (h.netX - h.x) * k; h.z += (h.netZ - h.z) * k; }\n    for (const m of this.w.monsters) { if (m.dead || m.netX === undefined) continue; m.px = m.x; m.pz = m.z; m.x += (m.netX - m.x) * k; m.z += (m.netZ - m.z) * k; }\n    for (const a of this.w.allies) { if (a.netX === undefined) continue; a.px = a.x; a.pz = a.z; a.x += (a.netX - a.x) * k; a.z += (a.netZ - a.z) * k; }\n  }\n  onMessage(m) {\n    if (m.k === 's') this.applySnapshot(m);\n    else if (m.k === 'e') for (const ev of m.v) this.applyEvent(ev);\n    else if (m.k === 'sheet') this.applySheet(m.d);\n  }\n  applySnapshot(s) {\n    if (s.t < this.lastSnap) return; this.lastSnap = s.t; this.applied++;\n    const w = this.w;\n    for (const [id, x, z, f, seq, hp, res, fl] of s.h) {\n      const h = w.heroes.find((q) => q.id === id); if (!h) continue;\n      h.netX = x / POS; h.netZ = z / POS; if (h.seat !== this.seat) { h.facing = f / 10; h.moving = (fl & HERO_FLAGS.moving) !== 0; h.speedNow = h.stats.speed; }\n      h.hp = hp; h.res = res; const dead = (fl & HERO_FLAGS.dead) !== 0; h.dead = dead; h.state = (fl & HERO_FLAGS.dodge) ? 'dodge' : dead ? 'dead' : 'idle'; h.left = (fl & HERO_FLAGS.left) !== 0;\n      h.castSeq = seq;\n    }\n    const map = this.mmap ?? (this.mmap = new Map());\n    if (map.size !== w.monsters.length) { map.clear(); for (const m of w.monsters) map.set(m.id, m); }\n    for (const [id, x, z, f, hp] of s.m) { const m = map.get(id); if (!m || m.dead) continue; if (m.dormant) { m.dormant = false; m.x = x / POS; m.z = z / POS; m.px = m.x; m.pz = m.z; } m.netX = x / POS; m.netZ = z / POS; m.facing = f / 10; m.hp = hp; }\n    for (const [id, x, z, f] of s.a) { const a = w.allies.find((q) => q.id === id); if (a) { a.netX = x / POS; a.netZ = z / POS; a.facing = f / 10; } }\n    w.active = w.monsters.filter((q) => !q.dead && !q.dormant);\n  }\n  applySheet(d) {\n    const h = this.w.heroes.find((q) => q.id === d.id); if (!h) return;\n    Object.assign(h, { level: d.level, xp: d.xp, gold: d.gold, gear: d.gear, inv: d.inv, mats: d.mats, gems: d.gems, slots: d.slots, vows: d.vows, reliquary: d.reliquary, levelPicks: d.levelPicks, cls: d.cls, newest: d.newest });\n    h._skillCache = null; const hp = h.hp; refresh(this.w, h); h.hp = hp;\n  }\n  applyEvent(ev) {\n    const w = this.w;\n    switch (ev.t) {\n      case 'mspawn': {\n        let m = w.monsters.find((q) => q.id === ev.id);\n        if (!m) { const nid = w.nextId; w.nextId = ev.id; m = spawnMonster(w, ev.type, ev.x, ev.z, { dormant: false, elite: ev.elite, affl: ev.affl, name: ev.name, tint: ev.tint, level: ev.level }); w.nextId = Math.max(nid, ev.id + 1); m.maxHp = ev.maxHp; m.hp = ev.hp; m.scale = ev.sm ?? m.scale; w.events.pop?.call; this.mmap = null; }\n        else { m.dormant = false; m._woke = true; m.x = ev.x; m.z = ev.z; m.px = m.x; m.pz = m.z; m.maxHp = ev.maxHp; m.hp = ev.hp; m.name = ev.name; m.level = ev.level; }\n        m.defn = MONSTERS[ev.type]; break;\n      }\n      case 'death': { const m = w.monsters.find((q) => q.id === ev.id); if (m) { m.dead = true; } w.stats.kills++; break; }\n      case 'hit': { const m = w.monsters.find((q) => q.id === ev.id); if (m) { m.hp = Math.max(0, m.hp - ev.amt); m.flash = 2; } break; }\n      case 'drop': w.drops.push({ id: ev.id, kind: ev.kind, x: ev.x, z: ev.z, rarity: ev.rarity, name: ev.name, seat: ev.seat, slot: ev.slot, fx: ev.fx, fz: ev.fz, amount: ev.amount }); break;\n      case 'pickup': { const i = w.drops.findIndex((d) => d.id === ev.id); if (i >= 0) w.drops.splice(i, 1); break; }\n      case 'break': case 'chest': case 'shrine': case 'relic': case 'lever': case 'propgone': removePropBy(w, ev); break;\n      case 'propadd': if (!w.props.some((p) => p.id === ev.id)) w.props.push({ id: ev.id, kind: ev.kind, x: ev.x, z: ev.z, model: ev.model, label: ev.label, interact: true, r: 1.2 }); break;\n      case 'boss': if (ev.on) { const m = w.monsters.find((q) => q.id === ev.id); w.boss = { id: ev.id, name: ev.name, ticks: ev.ticks ?? [], m }; } else w.boss = null; break;\n      case 'meter': if (w.knell) w.knell.meter = ev.v * w.knell.total; break;\n      case 'knell': if (w.knell && ev.total) { w.knell.total = ev.total; w.knell.mods = ev.mods; } break;\n      case 'banner': if (ev.text === 'THE KNELL TOLLS' && w.knell) { w.knell.stage = 'warden'; w.knell.meter = w.knell.total; } break;\n      case 'cast': { const h = w.heroes.find((q) => q.id === ev.id); if (h && !ev.dodge && ev.skill) { const sk = SKILLS[ev.skill]; if (sk?.cd) h.cds[ev.skill] = w.time + sk.cd * (1 - Math.min(50, h.stats.cdr) / 100); if (h.seat === this.seat && !sk.moving) h.castT = ev.dur * 0.75; } break; }\n      case 'classswap': { const h = w.heroes.find((q) => q.id === ev.id); if (h) { h.cls = ev.cls; } break; }\n      case 'ally': if (!w.allies.some((a) => a.id === ev.id)) w.allies.push({ id: ev.id, kind: ev.kind, x: ev.x, z: ev.z, px: ev.x, pz: ev.z, facing: 0, owner: ev.owner, seat: ev.seat, big: ev.big, minion: true }); break;\n      case 'allygone': { const i = w.allies.findIndex((a) => a.id === ev.id); if (i >= 0) w.allies[i].dead = true; w.allies = w.allies.filter((a) => !a.dead || a.id === ev.id); break; }\n      default: break;\n    }\n    this.onEvent?.(ev);\n  }\n}\nEOF\ncat > src/net/mirror.js <<'EOF'\n// Small helpers for the client's mirror of the host's props.\nexport function removePropBy(w, ev) {\n  const p = w.props.find((q) => q.id === ev.id); if (!p) return;\n  if (ev.t === 'break') { p.broken = true; p.hp = 0; }\n  else if (ev.t === 'propgone') { w.props = w.props.filter((q) => q !== p); }\n  else p.used = true;\n}\nexport const hubColors = ['red', 'blue', 'lime', 'sand'];\nEOF\ncat > src/net/hubflow.js <<'EOF'\n// AI Hub sessions: connect, build the round from the seed, own card, play, finish, end.\nimport { Engine, THREE } from '../../pixel-engine.js';\nimport { CLASSES } from '../data/classes.js';\nimport { TITLE } from '../data/meta.js';\nimport { addHero, newWorld, stepWorld } from '../sim/step.js';\nimport { presetHero, scoreOf, SEAT_CLASS, setupRound } from '../sim/round.js';\nimport { NetClient } from './client.js';\nimport { hubColors } from './mirror.js';\nimport { NetHost } from './host.js';\nimport { prompt } from '../ui/glyphs.js';\n\nexport function hubTransport(info) {\n  const handlers = [];\n  AIHub.on('message', (d, from) => { for (const h of handlers) h(d, from); });\n  return { me: info.me, send: (d, o) => AIHub.send(d, o), on: (fn) => handlers.push(fn) };\n}\nexport function buildRoundWorld(info) {\n  const w = newWorld({ seed: info.seed, difficulty: 0 }); w.mode = 'session';\n  for (const p of info.players) { const h = addHero(w, { seat: p.id, cls: SEAT_CLASS[p.id % 4], name: p.name }); presetHero(w, h); }\n  setupRound(w, info.players.length);\n  w.events.length = 0;\n  return w;\n}\n// One session object drives the game inside the engine's hooks.\nexport class Session {\n  constructor(info) { this.info = info; this.phase = 'card'; this.card = { left: null, ready: [], asking: 0, asked: false, paused: false, starting: false }; this.ended = false; this.finished = false; this.answered = false; this.server = !!info.server; this.timeUp = false; }\n  async setup(game) {\n    this.game = game; const info = this.info; const ctx = game.ctx;\n    this.world = buildRoundWorld(info);\n    const t = hubTransport(info);\n    this.isHost = info.isHost;\n    this.net = info.isHost ? new NetHost(t, this.world) : new NetClient(t, this.world, info.me);\n    this.net.onEvent = (ev) => this.world.events.push(ev);\n    if (info.isHost) { this.net.intentFor = (seat, w, view) => (seat === info.me ? game.router.intentFor(0, w, view, w.heroes.find((h) => h.seat === seat)) : this.net.remoteIntent(seat)); this.net.canStep = () => this.playing(); }\n    else { this.net.intentFor = () => ({}); this.net.fixed = (dt) => { if (this.playing() && !this.ended) { const h = this.world.heroes.find((q) => q.seat === info.me); const it = h ? game.router.intentFor(0, this.world, game.play.view, h) : { moveX: 0, moveZ: 0, pressed: {}, held: {} }; this.net.step(it); } }; this.net.canStep = () => false; }\n    this.net.update = () => {};\n    AIHub.on('card', (c) => { this.card = c; });\n    AIHub.on('start', () => { this.phase = 'countdown'; });\n    AIHub.on('leave', ({ id }) => { const h = this.world.heroes.find((q) => q.seat === id); if (h) { h.left = true; if (!this.server) game.play?.hud.toast(`${h.name} HAS LEFT.`, 'mist'); } });\n    AIHub.on('time-up', () => { this.timeUp = true; if (this.isHost) this.finish(false); });\n    AIHub.on('end', () => this.end());\n    if (!this.server) {\n      game.play.begin(this.world, { local: info.players.some((p) => p.id === info.me) ? [info.me] : [], net: this.net });\n      game.shell.state = 'session';\n      game.music.play('knell');\n      game.settings.load({});\n      this.onKey = (e) => { if (this.phase !== 'card' || this.ended) return; if (e.key === 'Enter') { AIHub.answer('ready'); this.answered = true; } if (e.key === 'm' || e.key === 'M') AIHub.answer('more'); };\n      if (typeof window !== 'undefined') window.addEventListener('keydown', this.onKey);\n    } else { this.net.update = () => {}; }\n    AIHub.ready();\n  }\n  playing() { return AIHub.time() >= 0 && !this.ended && this.phase !== 'card'; }\n  fixed(dt) {\n    if (this.ended) return;\n    if (this.server) { if (this.playing()) { stepWorld(this.world, this.gather()); this.net.afterStep(); const ev = this.world.events; this.world.events = []; this.net.outgoing(ev); this.check(); } return; }\n    if (this.phase === 'card') return;\n    this.game.play.fixed(dt);\n    if (this.isHost) this.check();\n  }\n  gather() { const out = {}; for (const h of this.world.heroes) if (!h.left) out[h.seat] = this.net.remoteIntent(h.seat); return out; }\n  check() { const r = this.world.round; if (r?.wardenDead && !this.finished) this.finish(true); if (!this.finished && this.world.heroes.every((h) => h.left) ) this.finish(false); }\n  finish(won) {\n    if (this.finished) return; this.finished = true;\n    const players = this.world.heroes.filter((h) => !h.left);\n    const scored = players.map((h) => ({ h, s: Math.round(scoreOf(h)) })).sort((a, b) => b.s - a.s);\n    const standings = []; let last = null; for (const { h, s } of scored) { if (last === s) standings[standings.length - 1].push(h.seat); else standings.push([h.seat]); last = s; }\n    const scores = {}; const stats = {}; for (const { h, s } of scored) { scores[h.seat] = s; stats[h.seat] = { Damage: Math.round(h.damage), Kills: h.kills, Revives: h.revives, Deaths: h.deaths, Gold: h.goldEarned }; }\n    const top = (key, title, detail) => { if (!players.length) return null; const best = players.reduce((a, b) => (b[key] > a[key] ? b : a)); return best[key] > 0 ? { id: best.seat, title, detail: `${detail}: ${Math.round(best[key])}` } : null; };\n    const awards = [top('damage', 'Bell-Ringer', 'Most damage'), top('kills', 'Undertaker', 'Most kills'), top('revives', 'Good Samaritan', 'Most revives'), top('goldEarned', 'Collector', 'Most gold'), top('deaths', 'Regular Customer', 'Most deaths')].filter(Boolean);\n    AIHub.finish({ standings, scores, won, stats, awards });\n  }\n  end() {\n    if (this.ended) return; this.ended = true;\n    if (typeof window !== 'undefined' && this.onKey) window.removeEventListener('keydown', this.onKey);\n    if (this.game && !this.server) { this.game.music.stopAll(); this.game.voice.stop(); this.game.play.running = false; this.game.ctx.engine.timeScale = 0; }\n  }\n  update(dt) {\n    const game = this.game; const ui = game.ui; if (this.server || !game) return;\n    if (this.ended) { return; }\n    const play = game.play; const m = ui.m;\n    if (this.phase === 'card') { play.net && (play.ctx.camera.setZoom(1.2)); this.keepCardView(dt); this.drawCard(ui, m); return; }\n    if (AIHub.time() >= 0) this.phase = 'play';\n    play.update(dt);\n    if (this.phase === 'countdown') { const left = Math.ceil(-AIHub.time() / 1000); ui.textC(ui.W / 2, ui.H * 0.34, String(Math.max(1, left)), { color: 'sand', scale: 4 }); }\n    const round = this.world.round; if (this.isHost && round) round.tShown = round.t;\n  }\n  keepCardView(dt) {\n    const play = this.game.play; const w = this.world; const e = w.zone.entrance;\n    play.view.update(w, dt, 1, {}); play.target.set(e.x, 0.9, e.z); play.view.focus.set(e.x, 0, e.z);\n    w.events.length = 0;\n  }\n  drawCard(ui, m) {\n    const info = this.info; const c = this.card;\n    const W = Math.min(ui.W - 24, 380); const X = ui.W / 2 - W / 2; const Y = 14; const H = ui.H - 28;\n    ui.frame(X, Y, W, H, 'sand', 'ink');\n    ui.textC(ui.W / 2, Y + 6, TITLE, { color: 'sand', scale: 2 });\n    ui.textC(ui.W / 2, Y + 26, 'FILL THE KNELL, THEN SLAY ITS WARDEN TOGETHER', { color: 'white' });\n    info.players.forEach((p, i) => { const y = Y + 40 + i * 12; const rd = c.ready?.includes(p.id); ui.rect(X + 10, y, 8, 8, hubColors[p.id % 4]); ui.text(X + 22, y + 1, String(p.name).slice(0, 20), { color: hubColors[p.id % 4] }); ui.textR(X + W - 10, y + 1, rd ? 'READY' : `${CLASSES[SEAT_CLASS[p.id % 4]].name}`, { color: rd ? 'lime' : 'mist' }); });\n    const cy = Y + 92; let x = X + 10;\n    for (const [a, l] of [['move', 'MOVE'], ['skill0', 'ATTACK'], ['skill1', 'SKILL'], ['dodge', 'DODGE'], ['potion', 'DRINK']]) { const w = prompt(ui, x, cy, a); x += w + 3; x += ui.text(x, cy + 2, l, { color: 'mist' }) + 6; }\n    ui.text(X + 10, cy + 16, 'STAND ON A CLASS FONT FOR 2 S IN THE FIRST ROOM TO SWAP.', { color: 'mist' });\n    const secs = c.left === null || c.left === undefined ? '' : `${Math.ceil(c.left / 1000)} S`;\n    ui.textC(ui.W / 2, cy + 30, c.paused ? 'HOLDING: MORE TIME ASKED' : c.starting ? 'STARTING' : secs, { color: 'sand', scale: 1 });\n    const by = Y + H - 26;\n    if (ui.button('card:ready', ui.W / 2 - 110, by, 104, 20, c.ready?.includes(info.me) ? 'READY!' : 'READY', { border: 'lime' }) || (this.game.router.pads.some((p) => (p.b & 1) && !(p.prev & 1)))) { AIHub.answer('ready'); }\n    if (ui.button('card:more', ui.W / 2 + 6, by, 104, 20, c.asked ? 'NEVER MIND' : 'MORE TIME', { first: false }) || (this.game.router.pads.some((p) => (p.b & 8) && !(p.prev & 8)))) { AIHub.answer('more'); }\n  }\n}\nexport async function runHubFlow(info, createGame, options, onFail) {\n  const session = new Session(info);\n  try { return await Engine.start(createGame({ session, noSaveBoot: true }), options); } catch (e) { AIHub.fail(String(e?.message ?? e)); onFail(e); return null; }\n}\n// A copy with no player: the engine on no GPU, driven by a timer.\nexport async function runServerCopy(info, createGame) {\n  const session = new Session(info);\n  const engine = await Engine.headless(createGame({ session, noSaveBoot: true }), {});\n  let last = performance.now(); let acc = 0;\n  const timer = setInterval(() => { const now = performance.now(); acc += Math.min(0.5, (now - last) / 1000); last = now; const n = Math.floor(acc * 60); if (n > 0) { acc -= n / 60; engine.step(n); } if (session.ended) clearInterval(timer); }, 33);\n  return engine;\n}\nexport { THREE };\nEOF\npython3 - <<'EOF'\np='src/input/router.js'; s=open(p).read()\ns=s.replace(\"\"\"  intentFor(seat, w, view) {\n    const it = { moveX: 0, moveZ: 0, pressed: this.latch[seat], held: {} }; this.latch[seat] = {};\n    const pad = this.seatPad[seat]; const inp = this.ctx.input; const h = w.heroes.find((q) => q.seat === seat);\"\"\",\"\"\"  intentFor(seat, w, view, hero = null) {\n    const it = { moveX: 0, moveZ: 0, pressed: this.latch[seat], held: {} }; this.latch[seat] = {};\n    const pad = this.seatPad[seat]; const h = hero ?? w.heroes.find((q) => q.seat === seat);\"\"\")\nopen(p,'w').write(s)\np='src/modes/play.js'; s=open(p).read()\ns=s.replace(\"if (this.net && !this.net.isHost) { this.net.fixed(dt); return; }\\n    if (this.net && !this.net.canStep()) return;\",\"if (this.net && !this.net.isHost) { this.net.fixed(dt); return; }\\n    if (this.net && !this.net.canStep()) return;\")\ns=s.replace(\"    this.net?.outgoing?.(events);\\n\",\"    if (this.net?.isHost) this.net.outgoing(events);\\n\")\nopen(p,'w').write(s)\nEOF\ncat > index.html <<'EOF'\n<!doctype html><html><head><meta charset=\"utf-8\"><title>Tolled You So</title></head><body><div id=\"app\"></div><script type=\"module\" src=\"game.js\"></script></body></html>\nEOF\nnode tools/build.mjs 2>&1 | tail -3 | cut -c1-300; node check.mjs --headless game.js --keys Enter*2,Enter*2 2>&1 | tail -12 | cut -c1-300","description":"Write netcode and session flow, build, run headless check"}}}
