{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkggCfN8UK2r3AWhnnin","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01G1pALJUt7eJrZq9JNWTxYy","name":"Bash","input":{"command":"cat > src/view/zonebuild.js <<'EOF'\n// Turns a zone's rows into a lit gothic diorama: floors, walls that never hide the player, dressing, lights, weather.\nimport { buildModel, DEFAULT_TEXEL, disposeObject, groundFog, PALETTE, Precipitation, textureMap, THREE, toonMaterial, WaterSurface, WAVES_CALM, Rng } from '../../pixel-engine.js';\nimport { MODELS } from './models/props.js';\n\nconst { BufferGeometry, Color, Float32BufferAttribute, Group, Mesh, Uint32BufferAttribute, Vector3 } = THREE;\n\nexport const LOOKS = {\n  yard: { floor: ['mud', 'dirt'], wall: 'dry-stone', tint: 'mist', cap: 'ink', sun: 'sky', sunI: 0.55, amb: 'navy', ambI: 0.9, bg: 'ink', fog: 'night', fogA: 0.5, light: 0xffb060, pit: 'water', dress: ['bones', 'rubble', 'rock', 'stump'], wallDress: ['wall-chains'], torch: 'standing-torch', vign: 0.35 },\n  town: { floor: ['cobbles', 'floor-tiles'], wall: 'bricks', tint: 'white', cap: 'plum', sun: 'sand', sunI: 0.5, amb: 'plum', ambI: 1.1, bg: 'night', fog: 'plum', fogA: 0.25, light: 0xffc070, pit: 'dark', dress: ['barrel', 'crate', 'sack', 'bucket', 'planter'], wallDress: ['banner', 'wall-lantern'], torch: 'lamp-post', vign: 0.25 },\n  moor: { floor: ['swamp', 'mud'], wall: 'dry-stone', tint: 'mist', cap: 'night', sun: 'sky', sunI: 0.65, amb: 'navy', ambI: 1, bg: 'ink', fog: 'teal', fogA: 0.4, light: 0xffb060, pit: 'water', dress: ['reeds', 'dead-tree', 'stump', 'lily-pads', 'rock', 'bones'], wallDress: [], torch: 'standing-torch', vign: 0.35 },\n  crypt: { floor: ['flagstones', 'slate-tiles'], wall: 'ashlar', tint: 'mist', cap: 'ink', sun: 'mist', sunI: 0.22, amb: 'night', ambI: 1.1, bg: 'ink', fog: 'night', fogA: 0.35, light: 0xa8f070, light2: 0xffb060, pit: 'dark', dress: ['bones', 'rubble', 'skull-pile', 'cobweb', 'candles'], wallDress: ['wall-chains', 'banner', 'wall-torch'], torch: 'candles', vign: 0.4 },\n  counting: { floor: ['parquet', 'flagstones'], wall: 'ashlar', tint: 'sand', cap: 'ink', sun: 'mist', sunI: 0.25, amb: 'plum', ambI: 1.1, bg: 'ink', fog: 'plum', fogA: 0.2, light: 0xffc060, pit: 'dark', dress: ['gold-pile', 'candles', 'skull-pile', 'bookshelf'], wallDress: ['banner', 'wall-chains'], torch: 'chandelier', vign: 0.35 },\n  cloister: { floor: ['slate-tiles', 'cinders'], wall: 'sandstone', tint: 'mist', cap: 'ink', sun: 'orange', sunI: 0.35, amb: 'plum', ambI: 0.9, bg: 'ink', fog: 'red', fogA: 0.28, light: 0xff8030, pit: 'lava', dress: ['rubble', 'flame', 'bones', 'ruined-wall'], wallDress: ['banner', 'wall-torch'], torch: 'brazier', vign: 0.4 },\n  belfry: { floor: ['basalt', 'rune-floor'], wall: 'basalt', tint: 'mist', cap: 'ink', sun: 'cyan', sunI: 0.42, amb: 'navy', ambI: 1.15, bg: 'ink', fog: 'navy', fogA: 0.28, light: 0x70d0ff, light2: 0xffc070, pit: 'rift', dress: ['rubble', 'bones', 'rune-stone'], wallDress: ['wall-chains', 'wall-torch'], torch: 'standing-torch', vign: 0.35 },\n  pantry: { floor: ['shallow-water', 'wet-sand'], wall: 'ashlar', tint: 'mist', cap: 'night', sun: 'sky', sunI: 0.25, amb: 'teal', ambI: 1, bg: 'ink', fog: 'teal', fogA: 0.3, light: 0xffc070, pit: 'water', dress: ['barrel', 'keg', 'bones', 'crate'], wallDress: ['wall-torch'], torch: 'candles', vign: 0.4 },\n  title: { floor: ['basalt', 'basalt'], wall: 'basalt', tint: 'mist', cap: 'ink', sun: 'sky', sunI: 0.7, amb: 'navy', ambI: 1.1, bg: 'ink', fog: 'navy', fogA: 0.3, light: 0xffb060, pit: 'rift', dress: ['bones', 'rock'], wallDress: [], torch: 'standing-torch', vign: 0.3 },\n};\n\nclass BoxBuilder {\n  // Boxes with world-scaled UVs, so textures keep their 8 texels a metre on any wall length.\n  constructor() { this.p = []; this.n = []; this.u = []; this.i = []; }\n  quad(a, b, c, d, nrm, uvs) {\n    const s = this.p.length / 3;\n    for (const v of [a, b, c, d]) this.p.push(...v);\n    for (let k = 0; k < 4; k++) this.n.push(...nrm);\n    this.u.push(...uvs);\n    this.i.push(s, s + 1, s + 2, s, s + 2, s + 3);\n  }\n  box(x0, x1, y0, y1, z0, z1, tile, top = true) {\n    const U = (a) => a / tile;\n    this.quad([x0, y0, z1], [x1, y0, z1], [x1, y1, z1], [x0, y1, z1], [0, 0, 1], [U(x0), U(y0), U(x1), U(y0), U(x1), U(y1), U(x0), U(y1)]);\n    this.quad([x1, y0, z0], [x0, y0, z0], [x0, y1, z0], [x1, y1, z0], [0, 0, -1], [U(x1), U(y0), U(x0), U(y0), U(x0), U(y1), U(x1), U(y1)]);\n    this.quad([x1, y0, z1], [x1, y0, z0], [x1, y1, z0], [x1, y1, z1], [1, 0, 0], [U(z1), U(y0), U(z0), U(y0), U(z0), U(y1), U(z1), U(y1)]);\n    this.quad([x0, y0, z0], [x0, y0, z1], [x0, y1, z1], [x0, y1, z0], [-1, 0, 0], [U(z0), U(y0), U(z1), U(y0), U(z1), U(y1), U(z0), U(y1)]);\n    if (top) this.quad([x0, y1, z1], [x1, y1, z1], [x1, y1, z0], [x0, y1, z0], [0, 1, 0], [U(x0), U(z1), U(x1), U(z1), U(x1), U(z0), U(x0), U(z0)]);\n  }\n  floor(x0, x1, z0, z1, y, tile) { const U = (a) => a / tile; this.quad([x0, y, z1], [x1, y, z1], [x1, y, z0], [x0, y, z0], [0, 1, 0], [U(x0), U(z1), U(x1), U(z1), U(x1), U(z0), U(x0), U(z0)]); }\n  mesh(material, { cast = true, receive = true } = {}) {\n    const g = new BufferGeometry();\n    g.setAttribute('position', new Float32BufferAttribute(this.p, 3));\n    g.setAttribute('normal', new Float32BufferAttribute(this.n, 3));\n    g.setAttribute('uv', new Float32BufferAttribute(this.u, 2));\n    g.setIndex(new Uint32BufferAttribute(this.i, 1));\n    const m = new Mesh(g, material); m.castShadow = cast; m.receiveShadow = receive;\n    return m;\n  }\n}\nconst tileOf = (id) => 32 / DEFAULT_TEXEL;\nconst texMat = (tint, id) => toonMaterial(PALETTE[tint], { map: textureMap(id) });\n\nexport class ZoneView {\n  constructor(ctx) { this.ctx = ctx; this.root = new Group(); ctx.scene.add(this.root); this.colliders = []; this.lights = []; this.rain = null; this.water = null; this.tall = []; }\n\n  clear() {\n    const { ctx } = this;\n    for (const c of this.colliders) ctx.physics.remove(c);\n    this.colliders = [];\n    for (const l of this.lights) l.release();\n    this.lights = []; this.tall = [];\n    if (this.water) { this.water.dispose?.(); this.water = null; }\n    if (this.rain) { this.rain.dispose?.(); this.rain = null; }\n    disposeObject(this.root);\n    ctx.scene.remove(this.root);\n    this.root = new Group(); ctx.scene.add(this.root);\n    ctx.particles.clear();\n  }\n\n  build(zone, seed) {\n    const { ctx } = this; this.clear();\n    const look = LOOKS[zone.spec.look] ?? LOOKS.crypt; this.look = look;\n    const eng = ctx.engine;\n    eng.sun.color.setHex(PALETTE[look.sun]); eng.sun.intensity = look.sunI; eng.ambient.color.setHex(PALETTE[look.amb]); eng.ambient.intensity = look.ambI;\n    ctx.scene.background = new Color(PALETTE[look.bg]);\n    const mist = groundFog({ color: PALETTE[look.fog], top: 1.1, amount: look.fogA, near: 18, far: 44 }); ctx.scene.fogNode = mist.node; this.fog = mist;\n    const rows = zone.rows; const W = zone.w; const H = zone.h;\n    const at = (x, y) => (y < 0 || y >= H || x < 0 || x >= W ? ' ' : rows[y][x]);\n    const isFloor = (c) => c === '.' || c === '~';\n    const rng = new Rng(`${seed}:${zone.id}:view`);\n\n    // Floors, one texture per room flavour.\n    const floors = {}; const tile0 = tileOf();\n    const rectOf = (x, y) => zone.roomRects.findIndex((r) => x >= r.x && x < r.x + r.w && y >= r.y && y < r.y + r.h);\n    const pit = new BoxBuilder();\n    for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {\n      const c = rows[y][x];\n      if (c === '.' || (c === '#' )) { const ri = Math.max(0, rectOf(x, y)); const tex = look.floor[ri % 3 === 2 ? 1 : 0]; (floors[tex] ??= new BoxBuilder()).floor(x, x + 1, y, y + 1, 0, tile0); }\n      if (c === '~') { if (look.pit === 'water') (floors[look.floor[0]] ??= new BoxBuilder()); pit.floor(x, x + 1, y, y + 1, -0.22, tile0); }\n    }\n    for (const [tex, b] of Object.entries(floors)) if (b.p.length) this.root.add(b.mesh(texMat('mist', tex), { cast: false }));\n    if (pit.p.length) {\n      const m = look.pit === 'lava' ? pit.mesh(texMat('white', 'lava-crust'), { cast: false }) : look.pit === 'rift' ? pit.mesh(texMat('white', 'rift-energy'), { cast: false }) : look.pit === 'water' ? pit.mesh(texMat('white', 'shallow-water'), { cast: false }) : pit.mesh(toonMaterial(PALETTE.ink), { cast: false });\n      this.root.add(m);\n      if (look.pit === 'water') {\n        const w = new WaterSurface({ size: [W + 40, H + 40], at: [W / 2, -0.3, H / 2], waves: WAVES_CALM });\n        this.root.add(w); this.water = w;\n      }\n    }\n    // Walls: a cell with floor on its +X or +Z side is a back wall, tall; floor only on -X or -Z makes a low stub.\n    const wallB = new BoxBuilder(); const capB = new BoxBuilder(); const stubB = new BoxBuilder();\n    const wallH = zone.spec.wallH; const tileW = tileOf();\n    const classify = (x, y) => {\n      if (rows[y][x] !== '#') return null;\n      const px = isFloor(at(x + 1, y)); const pz = isFloor(at(x, y + 1)); const nx = isFloor(at(x - 1, y)); const nz = isFloor(at(x, y - 1));\n      const dpp = isFloor(at(x + 1, y + 1)); const dnn = isFloor(at(x - 1, y - 1)); const dpn = isFloor(at(x + 1, y - 1)); const dnp = isFloor(at(x - 1, y + 1));\n      if (px || pz || dpp) return 'tall';\n      if (nx || nz || dnn || dpn || dnp) return 'stub';\n      return null;\n    };\n    const physBoxes = [];\n    for (let y = 0; y < H; y++) {\n      let x = 0;\n      while (x < W) {\n        const k = classify(x, y);\n        if (!k) { x++; continue; }\n        let e = x + 1; while (e < W && classify(e, y) === k) e++;\n        const h = k === 'tall' ? wallH : Math.min(0.6, wallH);\n        (k === 'tall' ? wallB : stubB).box(x, e, 0, h, y, y + 1, tileW, false);\n        capB.box(x, e, h, h + 0.08, y, y + 1, tileW);\n        physBoxes.push({ position: [(x + e) / 2, h / 2, y + 0.5], halfExtents: [(e - x) / 2, h / 2, 0.5] });\n        x = e;\n      }\n    }\n    if (wallB.p.length) this.root.add(wallB.mesh(texMat(look.tint, look.wall)));\n    if (stubB.p.length) this.root.add(stubB.mesh(texMat(look.tint, look.wall)));\n    if (capB.p.length) this.root.add(capB.mesh(toonMaterial(PALETTE[look.cap])));\n    const ph = ctx.physics;\n    this.colliders.push(ph.addStaticBox({ position: [W / 2, -0.5, H / 2], halfExtents: [W / 2 + 4, 0.5, H / 2 + 4] }));\n    for (const b of physBoxes) this.colliders.push(ph.addStaticBox(b));\n\n    // Lights and torches.\n    let li = 0;\n    for (const l of zone.lights) {\n      const id = look.torch; const color = look.light2 && (li++ % 2) ? look.light2 : look.light;\n      this.place(id, l.x, l.z, rng.range(0, 6.28), {}, id === 'lamp-post' || id === 'standing-torch' || id === 'chandelier');\n      const y = id === 'candles' ? 1 : 2.2;\n      this.lights.push(ctx.lights.request({ position: [l.x, y, l.z], color, intensity: id === 'candles' ? 7 : 9, radius: 10, flicker: 'torch', priority: 1 }));\n    }\n    // Dressing: low clutter on floors and hung things on back walls.\n    const dressN = Math.floor((W * H) / 42);\n    for (let i = 0; i < dressN; i++) {\n      const x = rng.int(1, W - 2); const y = rng.int(1, H - 2);\n      if (rows[y][x] !== '.' || zone.nav && !zone.nav.isOpen(x, y)) continue;\n      const nearWall = at(x, y - 1) === '#' || at(x - 1, y) === '#';\n      const id = rng.pick(look.dress);\n      if ((id === 'dead-tree' || id === 'ruined-wall' || id === 'bookshelf') && !nearWall) continue;\n      this.place(id, x + rng.range(0.2, 0.8), y + rng.range(0.2, 0.8), rng.range(0, 6.28), { seed: rng.int(1, 99) }, id === 'dead-tree');\n      if (id === 'flame') this.lights.push(ctx.lights.request({ position: [x + 0.5, 1, y + 0.5], color: 0xff7020, intensity: 4, radius: 5, flicker: 'torch', priority: 0.6 }));\n    }\n    if (look.wallDress.length) {\n      for (let y = 1; y < H - 1; y++) for (let x = 1; x < W - 1; x++) {\n        if (rows[y][x] !== '#' || !rng.chance(0.045)) continue;\n        if (at(x, y + 1) === '.' ) { const id = rng.pick(look.wallDress); this.place(id, x + 0.5, y + 1.02, 0, {}, false, 1.1); if (id === 'wall-torch' || id === 'wall-lantern') this.lights.push(ctx.lights.request({ position: [x + 0.5, 2, y + 1.4], color: look.light2 ?? look.light, intensity: 5, radius: 7, flicker: 'torch', priority: 0.7 })); }\n        else if (at(x + 1, y) === '.') { const id = rng.pick(look.wallDress); this.place(id, x + 1.02, y + 0.5, Math.PI / 2, {}, false, 1.1); }\n      }\n    }\n    // Gothic columns along long back walls, for depth.\n    if (zone.spec.biome === 'crypt' || zone.spec.biome === 'cloister') {\n      for (const r of zone.roomRects) { if (r.w < 13) continue; for (let x = r.x + 3; x < r.x + r.w - 3; x += 5) if (at(x, r.y + 1) === '.' && at(x, r.y) === '#') this.place('column', x + 0.5, r.y + 1.1, 0, { params: {} }, false); }\n    }\n    if (zone.spec.rain) { const rain = new Precipitation({ kind: 'rain', count: 3000, area: [40, 16, 40], color: PALETTE.sky }); rain.intensity = 0.8; this.root.add(rain); this.rain = rain; }\n    ctx.engine.setSunDirection(zone.spec.look === 'town' ? [0.8, 0.5, 0.25] : [0.5, 0.8, 0.35]);\n    this.rng = rng;\n    this.zoneId = zone.id;\n  }\n\n  place(id, x, z, rot = 0, opts = {}, tall = false, y = 0) {\n    const b = buildModel(id, { ...opts, catalog: MODELS });\n    b.object.position.set(x, y && y !== 0 ? 0 : 0, z); b.object.rotation.y = rot;\n    if (y > 1) b.object.position.y = 0;\n    b.object.traverse((o) => { if (o.isMesh) { o.castShadow = true; o.receiveShadow = true; } });\n    this.root.add(b.object);\n    if (tall) this.tall.push(b.object);\n    return b.object;\n  }\n\n  // Anything tall between the camera and a hero steps aside.\n  fadeTall(heroes) {\n    for (const o of this.tall) {\n      let hide = false;\n      for (const h of heroes) { const dx = o.position.x - h.x; const dz = o.position.z - h.z; const toward = (dx + dz) * 0.707; const side = Math.abs(dx - dz) * 0.707; if (toward > 0 && toward < 5 && side < 1.6) { hide = true; break; } }\n      o.visible = !hide;\n    }\n  }\n  update(dt, focus, t) { if (this.rain) { this.rain.update(dt, focus); } if (this.water) this.water.update(t); }\n}\nexport { Vector3 };\nEOF\ncat > src/audio/sfxdata.js <<'EOF'\n// All sound effects: SoundDefs, data only.\nconst bell = (f, decay, volume = 0.5, detune = 1.002, extra = {}) => ({\n  wave: 'sine', freq: f, decay, volume,\n  layers: [\n    { wave: 'sine', freq: f * 0.5, decay: decay * 1.4, volume: volume * 0.6 },\n    { wave: 'sine', freq: f * 1.2 * detune, decay: decay * 0.8, volume: volume * 0.45 },\n    { wave: 'sine', freq: f * 1.5, decay: decay * 0.7, volume: volume * 0.32 },\n    { wave: 'sine', freq: f * 2, decay: decay * 0.6, volume: volume * 0.3 },\n    { wave: 'sine', freq: f * 2.67, decay: decay * 0.4, volume: volume * 0.2 },\n    { wave: 'sine', freq: f * 3 * detune, decay: decay * 0.3, volume: volume * 0.14 },\n    ...(extra.layers ?? []),\n  ],\n});\nconst noise = (freq, decay, volume, o = {}) => ({ wave: 'noise', freq, decay, volume, ...o });\nconst thud = (f, decay, volume, o = {}) => ({ wave: 'sine', freq: f, freqEnd: f * 0.4, decay, volume, ...o });\nexport const SFX = {\n  bell_small: bell(660, 0.7, 0.34),\n  bell_big: bell(180, 2.2, 0.52),\n  bell_fall: { ...bell(150, 1.3, 0.42), layers: [...bell(150, 1.3, 0.42).layers, noise(1200, 0.2, 0.3)] },\n  bell_loot: bell(880, 1.5, 0.42),\n  bell_true: bell(98, 4.5, 0.6),\n  bell_cracked: { ...bell(87, 3, 0.5), layers: [...bell(87, 3, 0.5).layers, { wave: 'sine', freq: 88.8, decay: 3, volume: 0.25 }, { wave: 'sine', freq: 131.5, decay: 2.6, volume: 0.2 }] },\n  hit_bell: { wave: 'triangle', freq: 400, freqEnd: 160, decay: 0.12, volume: 0.25, layers: [noise(3000, 0.05, 0.2), { wave: 'sine', freq: 760, decay: 0.2, volume: 0.1 }] },\n  hit_flesh: { wave: 'square', duty: 0.25, freq: 180, freqEnd: 60, decay: 0.09, volume: 0.22, layers: [noise(1800, 0.06, 0.25)] },\n  hit_bone: { wave: 'square', duty: 0.125, freq: 800, freqEnd: 300, decay: 0.05, volume: 0.2, layers: [noise(5000, 0.04, 0.25)] },\n  hit_stone: { wave: 'triangle', freq: 120, freqEnd: 50, decay: 0.16, volume: 0.42, layers: [noise(1400, 0.1, 0.3)] },\n  hit_wood: { wave: 'triangle', freq: 280, freqEnd: 120, decay: 0.08, volume: 0.3, layers: [noise(2400, 0.04, 0.2)] },\n  hit_metal: { wave: 'square', duty: 0.25, freq: 1100, freqEnd: 700, decay: 0.08, volume: 0.15, layers: [{ wave: 'sine', freq: 2200, decay: 0.15, volume: 0.12 }] },\n  hit_fire: noise(2200, 0.14, 0.26, { freqEnd: 800 }),\n  crit: { wave: 'square', duty: 0.5, freq: 980, freqEnd: 500, decay: 0.08, volume: 0.15, layers: [{ wave: 'sine', freq: 1480, decay: 0.12, volume: 0.12 }] },\n  swing_heavy: noise(900, 0.18, 0.24, { freqEnd: 300 }),\n  swing_shovel: noise(1400, 0.12, 0.2, { freqEnd: 500 }),\n  chain_whirl: { wave: 'noise', freq: 3500, freqEnd: 1500, decay: 0.3, volume: 0.18, vibrato: { depth: 3, rate: 30 } },\n  spark: { wave: 'square', duty: 0.125, freq: 1600, freqEnd: 500, decay: 0.09, volume: 0.13 },\n  flare: { wave: 'noise', freq: 4000, freqEnd: 600, decay: 0.3, volume: 0.32 },\n  whoosh: noise(1200, 0.2, 0.2, { freqEnd: 400 }),\n  whoosh_big: noise(700, 0.35, 0.3, { freqEnd: 200 }),\n  explode_fire: { wave: 'noise', freq: 1800, freqEnd: 150, decay: 0.45, volume: 0.42, layers: [thud(110, 0.3, 0.4)] },\n  explode_big: { wave: 'noise', freq: 900, freqEnd: 70, decay: 1.1, volume: 0.55, layers: [thud(70, 0.8, 0.5)] },\n  plant: { wave: 'triangle', freq: 200, freqEnd: 90, decay: 0.16, volume: 0.32, layers: [noise(2000, 0.05, 0.12)] },\n  blink: { wave: 'sine', freq: 300, freqEnd: 1400, decay: 0.16, volume: 0.2, layers: [noise(5000, 0.1, 0.1)] },\n  snuff: { wave: 'noise', freq: 600, freqEnd: 6000, decay: 0.4, volume: 0.3 },\n  beacon: { wave: 'sine', freq: 330, freqEnd: 660, decay: 0.9, volume: 0.25, layers: [{ wave: 'sine', freq: 495, freqEnd: 990, decay: 0.8, volume: 0.15 }] },\n  comet_call: { wave: 'sine', freq: 700, freqEnd: 120, decay: 1, volume: 0.3, layers: [noise(800, 0.8, 0.14)] },\n  toss: noise(2500, 0.1, 0.16, { freqEnd: 900 }),\n  raise: { wave: 'triangle', freq: 90, freqEnd: 260, decay: 0.5, volume: 0.34, layers: [noise(2400, 0.3, 0.1)] },\n  exhume: { wave: 'noise', freq: 500, freqEnd: 90, decay: 0.5, volume: 0.42, layers: [thud(90, 0.3, 0.3)] },\n  coffin_crash: { wave: 'triangle', freq: 110, freqEnd: 40, decay: 0.35, volume: 0.5, layers: [noise(1200, 0.2, 0.34), noise(4000, 0.06, 0.15)] },\n  curse: { wave: 'sine', freq: 220, freqEnd: 110, decay: 0.7, volume: 0.28, vibrato: { depth: 1, rate: 8 } },\n  sink: { wave: 'sine', freq: 300, freqEnd: 60, decay: 0.3, volume: 0.28, layers: [noise(600, 0.2, 0.16)] },\n  grave_burst: { wave: 'noise', freq: 1100, freqEnd: 200, decay: 0.3, volume: 0.36, layers: [thud(120, 0.2, 0.3)] },\n  danse: { wave: 'square', duty: 0.25, freq: 294, decay: 0.8, volume: 0.13, arp: [0, 3, 7, 12, 7, 3], arpRate: 0.1 },\n  shout_wave: { wave: 'sawtooth', freq: 180, freqEnd: 90, decay: 0.32, volume: 0.28, layers: [noise(800, 0.22, 0.2)] },\n  charge: noise(600, 0.4, 0.28, { freqEnd: 1500 }),\n  hymn: { wave: 'triangle', freq: 262, decay: 1, volume: 0.2, arp: [0, 7, 12], arpRate: 0.2 },\n  crossbow: { wave: 'square', duty: 0.25, freq: 600, freqEnd: 140, decay: 0.07, volume: 0.16, layers: [noise(3500, 0.04, 0.12)] },\n  telegraph: { wave: 'square', duty: 0.5, freq: 330, freqEnd: 300, decay: 0.2, volume: 0.1, vibrato: { depth: 1, rate: 14 } },\n  monster_hit: { wave: 'triangle', freq: 150, freqEnd: 90, decay: 0.08, volume: 0.22 },\n  sour_note: { wave: 'sawtooth', freq: 415, freqEnd: 400, decay: 0.45, volume: 0.13, vibrato: { depth: 0.8, rate: 7 }, layers: [{ wave: 'sawtooth', freq: 440, decay: 0.45, volume: 0.09 }] },\n  bloat_burst: { wave: 'noise', freq: 500, freqEnd: 120, decay: 0.42, volume: 0.45, layers: [thud(70, 0.3, 0.4)] },\n  nest: { wave: 'sawtooth', freq: 110, freqEnd: 170, decay: 0.2, volume: 0.14, layers: [noise(2500, 0.1, 0.1)] },\n  roar: { wave: 'sawtooth', freq: 120, freqEnd: 70, decay: 0.9, volume: 0.36, crush: 8, vibrato: { depth: 2, rate: 16 } },\n  rope_lash: noise(3000, 0.16, 0.3, { freqEnd: 700 }),\n  crumble: { wave: 'noise', freq: 700, freqEnd: 90, decay: 0.8, volume: 0.42, layers: [thud(60, 0.5, 0.35)] },\n  spikes: { wave: 'square', duty: 0.125, freq: 900, freqEnd: 240, decay: 0.09, volume: 0.2 },\n  lever: { wave: 'square', duty: 0.25, freq: 180, freqEnd: 90, decay: 0.2, volume: 0.28, layers: [noise(2000, 0.06, 0.2)] },\n  chest: { wave: 'triangle', freq: 240, freqEnd: 480, decay: 0.26, volume: 0.28, arp: [0, 4, 7], arpRate: 0.07 },\n  shrine: { wave: 'sine', freq: 523, decay: 0.8, volume: 0.25, arp: [0, 7, 12, 19], arpRate: 0.09 },\n  gold: { wave: 'square', duty: 0.25, freq: 1300, decay: 0.05, volume: 0.1, arp: [0, 5], arpRate: 0.03 },\n  coin_spray: { wave: 'square', duty: 0.125, freq: 1600, decay: 0.28, volume: 0.13, arp: [0, 3, 5, 7, 3, 5, 8], arpRate: 0.03 },\n  tallow: { wave: 'sine', freq: 300, freqEnd: 180, decay: 0.12, volume: 0.25 },\n  potion: { wave: 'sine', freq: 400, freqEnd: 1000, decay: 0.4, volume: 0.26, vibrato: { depth: 2, rate: 12 } },\n  dodge: noise(1500, 0.16, 0.2, { freqEnd: 500 }),\n  level_up: { wave: 'triangle', freq: 392, decay: 0.8, volume: 0.32, arp: [0, 4, 7, 12, 16], arpRate: 0.08, layers: [bell(784, 0.9, 0.2)] },\n  hurt_hero: { wave: 'square', duty: 0.5, freq: 200, freqEnd: 90, decay: 0.12, volume: 0.25, layers: [noise(1200, 0.08, 0.15)] },\n  hero_death: { wave: 'sawtooth', freq: 220, freqEnd: 40, decay: 1, volume: 0.34 },\n  step_mud: noise(500, 0.05, 0.06),\n  step_stone: noise(1800, 0.03, 0.06),\n  step_wood: { wave: 'triangle', freq: 170, decay: 0.04, volume: 0.09 },\n  shatter: { wave: 'noise', freq: 4200, freqEnd: 1500, decay: 0.2, volume: 0.28, layers: [{ wave: 'square', duty: 0.125, freq: 900, freqEnd: 300, decay: 0.08, volume: 0.13 }] },\n  shatter_wood: { wave: 'noise', freq: 2200, freqEnd: 600, decay: 0.16, volume: 0.28, layers: [thud(180, 0.12, 0.25)] },\n  chunk: noise(2500, 0.03, 0.09),\n  wake: { wave: 'sawtooth', freq: 90, freqEnd: 120, decay: 0.4, volume: 0.14, vibrato: { depth: 1, rate: 6 } },\n  ui_move: { wave: 'square', duty: 0.25, freq: 660, decay: 0.03, volume: 0.09 },\n  ui_ok: { wave: 'square', duty: 0.25, freq: 660, decay: 0.09, volume: 0.13, arp: [0, 7], arpRate: 0.05 },\n  ui_back: { wave: 'square', duty: 0.25, freq: 494, freqEnd: 330, decay: 0.09, volume: 0.1 },\n  ui_error: { wave: 'square', duty: 0.5, freq: 150, decay: 0.15, volume: 0.13 },\n  ui_tab: { wave: 'triangle', freq: 520, decay: 0.05, volume: 0.13 },\n  ui_equip: { wave: 'triangle', freq: 300, freqEnd: 620, decay: 0.12, volume: 0.22, layers: [{ wave: 'square', duty: 0.125, freq: 1200, decay: 0.05, volume: 0.06 }] },\n  ui_salvage: { wave: 'noise', freq: 2400, freqEnd: 700, decay: 0.15, volume: 0.2 },\n  anvil: { wave: 'square', duty: 0.25, freq: 1400, freqEnd: 1100, decay: 0.2, volume: 0.13, layers: [{ wave: 'sine', freq: 2800, decay: 0.3, volume: 0.1 }] },\n  quest: { wave: 'triangle', freq: 440, decay: 0.45, volume: 0.25, arp: [0, 5, 9, 12], arpRate: 0.1 },\n  fanfare_bell: bell(392, 1.4, 0.34),\n  req: { wave: 'triangle', freq: 330, decay: 0.3, volume: 0.22, arp: [0, 3, 7], arpRate: 0.05 },\n};\n// Ambience loops.\nexport const LOOPS = {\n  rain: { wave: 'noise', freq: 9000, sustain: 1.6, decay: 0.1, volume: 0.05 },\n  wind: { wave: 'noise', freq: 500, sustain: 2.8, decay: 0.1, volume: 0.06, vibrato: { depth: 3, rate: 0.3 } },\n  fire: { wave: 'noise', freq: 1400, sustain: 1.2, decay: 0.1, volume: 0.05, vibrato: { depth: 2, rate: 9 } },\n};\nexport const SFX_IDS = Object.keys(SFX);\nEOF\ncat > src/audio/songs.js <<'EOF'\n// All music: Song data. Every piece states or bends the Clemency motif: D4 A4 F4 E4 | D4 C4 D4 A3.\nconst organ = { wave: 'square', duty: 0.25, decay: 0.5, volume: 0.09 };\nconst lowBell = { wave: 'sine', decay: 1.4, volume: 0.13 };\nconst bass = { wave: 'triangle', decay: 0.35, volume: 0.16 };\nconst wind = { wave: 'noise', decay: 0.8, volume: 0.015 };\nconst drum = { wave: 'noise', decay: 0.12, volume: 0.07 };\nconst kick = { wave: 'sine', freqEnd: 40, decay: 0.12, volume: 0.2 };\nconst lute = { wave: 'triangle', decay: 0.28, volume: 0.1 };\nconst R = (s) => s.trim().replace(/\\s+/g, ' ');\nconst rests = (n) => Array(n).fill('.').join(' ');\n\nexport const SONGS = {\n  vespers: { bpm: 60, stepsPerBeat: 2, tracks: { bell: lowBell, organ, bass },\n    patterns: {\n      a: { bell: 'D4 . A4 . F4 . E4 . D4 . C4 . D4 . A3 .', organ: rests(16), bass: rests(16) },\n      b: { bell: 'D4 . A4 . F4 . E4 . D4 . C4 . D4 . A3 .', organ: 'D3 - - - A3 - - - F3 - - - E3 - - -', bass: 'D2 - - - . . . . D2 - - - . . . .' },\n      c: { bell: 'F4 . A4 . C5 . A4 . G4 . F4 . E4 . D4 .', organ: 'F3 - - - C4 - - - G3 - - - D3 - - -', bass: 'F2 - - - . . . . G2 - - - . . . .' },\n    }, order: ['a', 'a', 'b', 'c', 'b'] },\n  lamps: { bpm: 72, tracks: { lute, bell: lowBell, bass },\n    patterns: {\n      a: { lute: 'D4 F4 A4 F4 D4 F4 A4 F4 C4 E4 G4 E4 C4 E4 G4 E4', bell: R(`D5 ${rests(7)} C5 ${rests(7)}`), bass: R(`D3 ${rests(7)} C3 ${rests(7)}`) },\n      b: { lute: 'Bb3 D4 F4 D4 Bb3 D4 F4 D4 A3 C#4 E4 C#4 A3 C#4 E4 C#4', bell: R(`Bb4 ${rests(7)} A4 ${rests(7)}`), bass: R(`Bb2 ${rests(7)} A2 ${rests(7)}`) },\n      c: { lute: 'D4 A4 F4 E4 D4 C4 D4 A3 D4 A4 F4 E4 D4 C4 D4 D4', bell: R(`${rests(8)} F4 ${rests(7)}`), bass: R(`D3 ${rests(7)} D3 ${rests(7)}`) },\n    }, order: ['a', 'b', 'a', 'c'] },\n  weeping: { bpm: 66, tracks: { pulse: { wave: 'triangle', decay: 0.8, volume: 0.15 }, wind, bell: { wave: 'sine', decay: 1.2, volume: 0.05 } },\n    patterns: {\n      a: { pulse: R(`D2 ${rests(7)} . . . . A1 ${rests(3)}`), wind: R(`C5 ${rests(15)}`), bell: rests(16) },\n      b: { pulse: R(`D2 ${rests(7)} C2 ${rests(7)}`), wind: R(`${rests(8)} C4 ${rests(7)}`), bell: R(`${rests(8)} A4 . F4 . E4 . D4 .`) },\n      c: { pulse: R(`F2 ${rests(7)} A1 ${rests(7)}`), wind: R(`C5 ${rests(15)}`), bell: R(`D4 . A4 . F4 . E4 . ${rests(8)}`) },\n    }, order: ['a', 'a', 'b', 'a', 'c'] },\n  under: { bpm: 58, stepsPerBeat: 2, tracks: { pad: { wave: 'triangle', decay: 1.6, volume: 0.13 }, far: { wave: 'sine', decay: 1.6, volume: 0.05 }, low: { wave: 'sine', decay: 1.5, volume: 0.15 } },\n    patterns: {\n      a: { pad: 'D3 - - - - - - - C3 - - - - - - -', far: R(`${rests(6)} A5 . ${rests(4)} F5 . . .`), low: 'D2 - - - - - - - D2 - - - - - - -' },\n      b: { pad: 'Bb2 - - - - - - - A2 - - - - - - -', far: R(`D5 . ${rests(6)} ${rests(4)} E5 . . .`), low: 'Bb1 - - - - - - - A1 - - - - - - -' },\n      c: { pad: 'D3 - - - A3 - - - F3 - - - E3 - - -', far: rests(16), low: 'D2 - - - - - - - A1 - - - - - - -' },\n    }, order: ['a', 'b', 'a', 'c'] },\n  cinders: { bpm: 96, tracks: { ost: { wave: 'square', duty: 0.125, decay: 0.15, volume: 0.09 }, bass, drum, kick },\n    patterns: {\n      a: { ost: 'D4 D4 F4 D4 A4 D4 F4 D4 D4 D4 F4 D4 E4 D4 C4 D4', bass: 'D2 . . D2 . . D2 . D2 . . D2 . . C2 .', drum: R('. . C6 . . . C6 . . . C6 . . . C6 C6'), kick: 'C2 . . . C2 . . . C2 . . . C2 . C2 .' },\n      b: { ost: 'Bb3 Bb3 D4 Bb3 F4 Bb3 D4 Bb3 A3 A3 C#4 A3 E4 A3 C#4 A3', bass: 'Bb1 . . Bb1 . . Bb1 . A1 . . A1 . . A1 .', drum: R('. . C6 . . . C6 . . . C6 . C6 C6 C6 C6'), kick: 'C2 . . . C2 . . . C2 . . . C2 . C2 .' },\n      c: { ost: 'D5 . A4 . F4 . E4 . D4 . C4 . D4 . A3 .', bass: 'D2 . D2 . D2 . D2 . C2 . C2 . A1 . A1 .', drum: R('C6 . C6 . C6 . C6 . C6 . C6 . C6 C6 C6 C6'), kick: 'C2 . . C2 . . C2 . . C2 . . C2 . . C2' },\n    }, order: ['a', 'a', 'b', 'a', 'c'] },\n  ledger: { bpm: 126, tracks: { brass: { wave: 'square', duty: 0.5, decay: 0.2, volume: 0.09 }, oom: { wave: 'triangle', decay: 0.18, volume: 0.17 }, snare: drum },\n    patterns: {\n      a: { brass: 'D4 . D4 F4 A4 . F4 . E4 . E4 G4 Bb4 . G4 .', oom: 'D2 . A2 . D2 . A2 . C2 . G2 . C2 . G2 .', snare: '. . C6 . . . C6 C6 . . C6 . . . C6 C6' },\n      b: { brass: 'F4 . F4 A4 C5 . A4 . G4 . E4 C4 D4 . . .', oom: 'F2 . C3 . F2 . C3 . C2 . G2 . D2 . A2 .', snare: '. . C6 . . . C6 C6 . . C6 . C6 C6 C6 C6' },\n      c: { brass: 'D5 . D5 C5 Bb4 . A4 . G4 . F4 E4 D4 . C#4 .', oom: 'Bb1 . F2 . Bb1 . F2 . A1 . E2 . A1 . E2 .', snare: 'C6 . C6 . C6 . C6 . C6 . C6 . C6 C6 C6 C6' },\n    }, order: ['a', 'b', 'a', 'c'] },\n  climb: { bpm: 104, tracks: { rise: { wave: 'square', duty: 0.25, decay: 0.14, volume: 0.09 }, bass, drum },\n    patterns: {\n      a: { rise: 'D4 F4 A4 D5 D4 F4 A4 D5 E4 G4 Bb4 E5 E4 G4 Bb4 E5', bass: 'D2 . D2 . D2 . D2 . E2 . E2 . E2 . E2 .', drum: 'C6 . C8 . C6 . C8 . C6 . C8 . C6 C8 C6 C8' },\n      b: { rise: 'F4 A4 C5 F5 F4 A4 C5 F5 G4 Bb4 D5 G5 A4 C#5 E5 A5', bass: 'F2 . F2 . F2 . F2 . G2 . G2 . A2 . A2 .', drum: 'C6 . C8 . C6 . C8 . C6 C6 C8 . C6 C6 C6 C6' },\n      c: { rise: 'D5 . A4 . F4 . E4 . D4 . C4 . D4 . A3 .', bass: 'D2 D2 D2 D2 C2 C2 C2 C2 Bb1 Bb1 Bb1 Bb1 A1 A1 A1 A1', drum: 'C6 C8 C6 C8 C6 C8 C6 C8 C6 C8 C6 C8 C6 C6 C6 C6' },\n    }, order: ['a', 'b', 'a', 'b', 'c'] },\n  // Malison's Eventide: the motif one semitone off, because the bell is cracked.\n  eventide: { bpm: 138, tracks: { stab: { wave: 'square', duty: 0.5, decay: 0.2, volume: 0.09 }, cracked: { wave: 'sawtooth', decay: 0.3, volume: 0.07 }, bass, drum, kick },\n    patterns: {\n      a: { stab: 'D4 . . D4 . . D4 . F4 . . F4 . . E4 .', cracked: 'Eb4 . Bb4 . F#4 . F4 . Eb4 . C#4 . Eb4 . Bb3 .', bass: 'D2 D2 . D2 D2 . D2 . D2 D2 . D2 C2 . C2 .', drum: '. . C6 . . . C6 . . . C6 . . C6 C6 C6', kick: 'C2 . . . C2 . . . C2 . . . C2 . . .' },\n      b: { stab: 'Bb3 . . Bb3 . . Bb3 . A3 . . A3 . . A3 .', cracked: 'B4 . F#5 . C#5 . C5 . B4 . A4 . B4 . F#4 .', bass: 'Bb1 Bb1 . Bb1 Bb1 . Bb1 . A1 A1 . A1 A1 . A1 .', drum: '. . C6 . . . C6 . . . C6 . C6 C6 C6 C6', kick: 'C2 . . C2 C2 . . . C2 . . C2 C2 . . .' },\n      c: { stab: 'D5 . . . C#5 . . . C5 . . . B4 . . .', cracked: 'Eb4 Bb4 F#4 F4 Eb4 C#4 Eb4 Bb3 Eb4 Bb4 F#4 F4 Eb4 C#4 Eb4 Bb3', bass: 'D2 . D2 . C#2 . C#2 . C2 . C2 . B1 . B1 .', drum: 'C6 . C6 . C6 . C6 . C6 . C6 . C6 C6 C6 C6', kick: 'C2 . C2 . C2 . C2 . C2 . C2 . C2 . C2 .' },\n    }, order: ['a', 'a', 'b', 'a', 'c'] },\n  eventide3: { bpm: 138, tracks: { stab: { wave: 'square', duty: 0.5, decay: 0.3, volume: 0.09 }, cracked: { wave: 'sawtooth', decay: 0.5, volume: 0.09 }, bell: lowBell },\n    patterns: {\n      a: { stab: 'D4 . . . . . . . . . . . . . . .', cracked: 'Eb4 . . . Bb4 . . . F#4 . . . F4 . . .', bell: 'D3 . . . . . . . A2 . . . . . . .' },\n      b: { stab: 'C4 . . . . . . . . . . . . . . .', cracked: 'Eb4 . . . C#4 . . . Eb4 . . . Bb3 . . .', bell: 'C3 . . . . . . . A2 . . . . . . .' },\n      c: { stab: 'Bb3 . . . . . . . A3 . . . . . . .', cracked: 'F#4 . . . F4 . . . Eb4 . . . C#4 . . .', bell: 'Bb2 . . . . . . . A2 . . . . . . .' },\n    }, order: ['a', 'b', 'c', 'b'] },\n  knell: { bpm: 118, tracks: { drive: { wave: 'square', duty: 0.25, decay: 0.12, volume: 0.09 }, bass, drum, kick, bell: { wave: 'sine', decay: 0.9, volume: 0.09 } },\n    patterns: {\n      a: { drive: 'D4 A3 D4 F4 D4 A3 D4 E4 D4 A3 D4 F4 D4 C4 D4 A3', bass: 'D2 . D2 . D2 . D2 . D2 . D2 . C2 . A1 .', drum: '. . C6 . . . C6 . . . C6 . . . C6 .', kick: 'C2 . . . C2 . . . C2 . . . C2 . . .', bell: 'D5 . . . . . . . A4 . . . . . . .' },\n      b: { drive: 'F4 C4 F4 A4 F4 C4 F4 G4 E4 C4 E4 G4 E4 C4 E4 A4', bass: 'F2 . F2 . F2 . F2 . C2 . C2 . C2 . E2 .', drum: '. . C6 . . . C6 . . . C6 . . C6 C6 .', kick: 'C2 . . . C2 . . . C2 . . . C2 . . .', bell: 'F5 . . . . . . . E5 . . . . . . .' },\n      c: { drive: 'D5 A4 F4 E4 D4 C4 D4 A3 D5 A4 F4 E4 D4 C4 D4 D4', bass: 'Bb1 . Bb1 . Bb1 . Bb1 . A1 . A1 . A1 . A1 .', drum: 'C6 . C6 . C6 . C6 . C6 . C6 . C6 C6 C6 C6', kick: 'C2 . . C2 C2 . . C2 C2 . . C2 C2 . C2 .', bell: 'D5 . A4 . F4 . E4 . D4 . C4 . D4 . A3 .' },\n    }, order: ['a', 'b', 'a', 'c'] },\n  // Clemency, for the ending: the motif resolved to major at last.\n  clemency: { bpm: 66, stepsPerBeat: 2, tracks: { bell: lowBell, organ: { wave: 'triangle', decay: 0.9, volume: 0.1 }, bass },\n    patterns: {\n      a: { bell: 'D4 . A4 . F#4 . E4 . D4 . C#4 . D4 . A3 .', organ: 'D3 - - - A3 - - - G3 - - - D3 - - -', bass: 'D2 - - - A1 - - - G1 - - - D2 - - -' },\n      b: { bell: 'F#4 . A4 . D5 . A4 . G4 . F#4 . E4 . D4 .', organ: 'B3 - - - F#3 - - - G3 - - - A3 - - -', bass: 'B1 - - - F#2 - - - G2 - - - A2 - - -' },\n      c: { bell: 'A4 . D5 . C#5 . A4 . B4 . A4 . D4 . . .', organ: 'D4 - - - A3 - - - G3 - - - D3 - - -', bass: 'D2 - - - E2 - - - A1 - - - D2 - - -' },\n    }, order: ['a', 'b', 'a', 'c'] },\n};\nEOF\ncat > tools/scratch/au.mjs <<'EOF'\nimport { renderSound, parseSong } from '../../pixel-engine.js';\nimport { SFX } from '../../src/audio/sfxdata.js'; import { SONGS } from '../../src/audio/songs.js';\nlet n=0; for (const [k,d] of Object.entries(SFX)){ const s=renderSound(d); let p=0; for(const v of s) p=Math.max(p,Math.abs(v)); if(p>1||p<0.01) console.log(k,p.toFixed(3)); n++; }\nfor (const [k,d] of Object.entries(SONGS)){ try{parseSong(d);}catch(e){console.log('SONG',k,e.message)} }\nconsole.log(n,'sfx',Object.keys(SONGS).length,'songs');\nEOF\nnode tools/scratch/au.mjs 2>&1 | cut -c1-200 | tail -20; for id in dry-stone bricks sandstone parquet wet-sand; do grep -c \"^| \\`$id\\`\" LIBRARY.md; done | tr '\\n' ' '","description":"Write zone view, sound effects and songs, validate audio"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6193,"cache_read_input_tokens":419593,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6193},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"69254de6-4061-470e-8e76-10f1ee96c6e5","uuid":"72869391-73b9-4384-a414-9a3db5a65e44","timestamp":"2026-11-05T23:58:45.422Z","request_id":"req_011CgkggCNWHHcDMdKny5r3q","wire_tool_inputs":{"toolu_01G1pALJUt7eJrZq9JNWTxYy":{"command":"cat > src/view/zonebuild.js <<'EOF'\n// Turns a zone's rows into a lit gothic diorama: floors, walls that never hide the player, dressing, lights, weather.\nimport { buildModel, DEFAULT_TEXEL, disposeObject, groundFog, PALETTE, Precipitation, textureMap, THREE, toonMaterial, WaterSurface, WAVES_CALM, Rng } from '../../pixel-engine.js';\nimport { MODELS } from './models/props.js';\n\nconst { BufferGeometry, Color, Float32BufferAttribute, Group, Mesh, Uint32BufferAttribute, Vector3 } = THREE;\n\nexport const LOOKS = {\n  yard: { floor: ['mud', 'dirt'], wall: 'dry-stone', tint: 'mist', cap: 'ink', sun: 'sky', sunI: 0.55, amb: 'navy', ambI: 0.9, bg: 'ink', fog: 'night', fogA: 0.5, light: 0xffb060, pit: 'water', dress: ['bones', 'rubble', 'rock', 'stump'], wallDress: ['wall-chains'], torch: 'standing-torch', vign: 0.35 },\n  town: { floor: ['cobbles', 'floor-tiles'], wall: 'bricks', tint: 'white', cap: 'plum', sun: 'sand', sunI: 0.5, amb: 'plum', ambI: 1.1, bg: 'night', fog: 'plum', fogA: 0.25, light: 0xffc070, pit: 'dark', dress: ['barrel', 'crate', 'sack', 'bucket', 'planter'], wallDress: ['banner', 'wall-lantern'], torch: 'lamp-post', vign: 0.25 },\n  moor: { floor: ['swamp', 'mud'], wall: 'dry-stone', tint: 'mist', cap: 'night', sun: 'sky', sunI: 0.65, amb: 'navy', ambI: 1, bg: 'ink', fog: 'teal', fogA: 0.4, light: 0xffb060, pit: 'water', dress: ['reeds', 'dead-tree', 'stump', 'lily-pads', 'rock', 'bones'], wallDress: [], torch: 'standing-torch', vign: 0.35 },\n  crypt: { floor: ['flagstones', 'slate-tiles'], wall: 'ashlar', tint: 'mist', cap: 'ink', sun: 'mist', sunI: 0.22, amb: 'night', ambI: 1.1, bg: 'ink', fog: 'night', fogA: 0.35, light: 0xa8f070, light2: 0xffb060, pit: 'dark', dress: ['bones', 'rubble', 'skull-pile', 'cobweb', 'candles'], wallDress: ['wall-chains', 'banner', 'wall-torch'], torch: 'candles', vign: 0.4 },\n  counting: { floor: ['parquet', 'flagstones'], wall: 'ashlar', tint: 'sand', cap: 'ink', sun: 'mist', sunI: 0.25, amb: 'plum', ambI: 1.1, bg: 'ink', fog: 'plum', fogA: 0.2, light: 0xffc060, pit: 'dark', dress: ['gold-pile', 'candles', 'skull-pile', 'bookshelf'], wallDress: ['banner', 'wall-chains'], torch: 'chandelier', vign: 0.35 },\n  cloister: { floor: ['slate-tiles', 'cinders'], wall: 'sandstone', tint: 'mist', cap: 'ink', sun: 'orange', sunI: 0.35, amb: 'plum', ambI: 0.9, bg: 'ink', fog: 'red', fogA: 0.28, light: 0xff8030, pit: 'lava', dress: ['rubble', 'flame', 'bones', 'ruined-wall'], wallDress: ['banner', 'wall-torch'], torch: 'brazier', vign: 0.4 },\n  belfry: { floor: ['basalt', 'rune-floor'], wall: 'basalt', tint: 'mist', cap: 'ink', sun: 'cyan', sunI: 0.42, amb: 'navy', ambI: 1.15, bg: 'ink', fog: 'navy', fogA: 0.28, light: 0x70d0ff, light2: 0xffc070, pit: 'rift', dress: ['rubble', 'bones', 'rune-stone'], wallDress: ['wall-chains', 'wall-torch'], torch: 'standing-torch', vign: 0.35 },\n  pantry: { floor: ['shallow-water', 'wet-sand'], wall: 'ashlar', tint: 'mist', cap: 'night', sun: 'sky', sunI: 0.25, amb: 'teal', ambI: 1, bg: 'ink', fog: 'teal', fogA: 0.3, light: 0xffc070, pit: 'water', dress: ['barrel', 'keg', 'bones', 'crate'], wallDress: ['wall-torch'], torch: 'candles', vign: 0.4 },\n  title: { floor: ['basalt', 'basalt'], wall: 'basalt', tint: 'mist', cap: 'ink', sun: 'sky', sunI: 0.7, amb: 'navy', ambI: 1.1, bg: 'ink', fog: 'navy', fogA: 0.3, light: 0xffb060, pit: 'rift', dress: ['bones', 'rock'], wallDress: [], torch: 'standing-torch', vign: 0.3 },\n};\n\nclass BoxBuilder {\n  // Boxes with world-scaled UVs, so textures keep their 8 texels a metre on any wall length.\n  constructor() { this.p = []; this.n = []; this.u = []; this.i = []; }\n  quad(a, b, c, d, nrm, uvs) {\n    const s = this.p.length / 3;\n    for (const v of [a, b, c, d]) this.p.push(...v);\n    for (let k = 0; k < 4; k++) this.n.push(...nrm);\n    this.u.push(...uvs);\n    this.i.push(s, s + 1, s + 2, s, s + 2, s + 3);\n  }\n  box(x0, x1, y0, y1, z0, z1, tile, top = true) {\n    const U = (a) => a / tile;\n    this.quad([x0, y0, z1], [x1, y0, z1], [x1, y1, z1], [x0, y1, z1], [0, 0, 1], [U(x0), U(y0), U(x1), U(y0), U(x1), U(y1), U(x0), U(y1)]);\n    this.quad([x1, y0, z0], [x0, y0, z0], [x0, y1, z0], [x1, y1, z0], [0, 0, -1], [U(x1), U(y0), U(x0), U(y0), U(x0), U(y1), U(x1), U(y1)]);\n    this.quad([x1, y0, z1], [x1, y0, z0], [x1, y1, z0], [x1, y1, z1], [1, 0, 0], [U(z1), U(y0), U(z0), U(y0), U(z0), U(y1), U(z1), U(y1)]);\n    this.quad([x0, y0, z0], [x0, y0, z1], [x0, y1, z1], [x0, y1, z0], [-1, 0, 0], [U(z0), U(y0), U(z1), U(y0), U(z1), U(y1), U(z0), U(y1)]);\n    if (top) this.quad([x0, y1, z1], [x1, y1, z1], [x1, y1, z0], [x0, y1, z0], [0, 1, 0], [U(x0), U(z1), U(x1), U(z1), U(x1), U(z0), U(x0), U(z0)]);\n  }\n  floor(x0, x1, z0, z1, y, tile) { const U = (a) => a / tile; this.quad([x0, y, z1], [x1, y, z1], [x1, y, z0], [x0, y, z0], [0, 1, 0], [U(x0), U(z1), U(x1), U(z1), U(x1), U(z0), U(x0), U(z0)]); }\n  mesh(material, { cast = true, receive = true } = {}) {\n    const g = new BufferGeometry();\n    g.setAttribute('position', new Float32BufferAttribute(this.p, 3));\n    g.setAttribute('normal', new Float32BufferAttribute(this.n, 3));\n    g.setAttribute('uv', new Float32BufferAttribute(this.u, 2));\n    g.setIndex(new Uint32BufferAttribute(this.i, 1));\n    const m = new Mesh(g, material); m.castShadow = cast; m.receiveShadow = receive;\n    return m;\n  }\n}\nconst tileOf = (id) => 32 / DEFAULT_TEXEL;\nconst texMat = (tint, id) => toonMaterial(PALETTE[tint], { map: textureMap(id) });\n\nexport class ZoneView {\n  constructor(ctx) { this.ctx = ctx; this.root = new Group(); ctx.scene.add(this.root); this.colliders = []; this.lights = []; this.rain = null; this.water = null; this.tall = []; }\n\n  clear() {\n    const { ctx } = this;\n    for (const c of this.colliders) ctx.physics.remove(c);\n    this.colliders = [];\n    for (const l of this.lights) l.release();\n    this.lights = []; this.tall = [];\n    if (this.water) { this.water.dispose?.(); this.water = null; }\n    if (this.rain) { this.rain.dispose?.(); this.rain = null; }\n    disposeObject(this.root);\n    ctx.scene.remove(this.root);\n    this.root = new Group(); ctx.scene.add(this.root);\n    ctx.particles.clear();\n  }\n\n  build(zone, seed) {\n    const { ctx } = this; this.clear();\n    const look = LOOKS[zone.spec.look] ?? LOOKS.crypt; this.look = look;\n    const eng = ctx.engine;\n    eng.sun.color.setHex(PALETTE[look.sun]); eng.sun.intensity = look.sunI; eng.ambient.color.setHex(PALETTE[look.amb]); eng.ambient.intensity = look.ambI;\n    ctx.scene.background = new Color(PALETTE[look.bg]);\n    const mist = groundFog({ color: PALETTE[look.fog], top: 1.1, amount: look.fogA, near: 18, far: 44 }); ctx.scene.fogNode = mist.node; this.fog = mist;\n    const rows = zone.rows; const W = zone.w; const H = zone.h;\n    const at = (x, y) => (y < 0 || y >= H || x < 0 || x >= W ? ' ' : rows[y][x]);\n    const isFloor = (c) => c === '.' || c === '~';\n    const rng = new Rng(`${seed}:${zone.id}:view`);\n\n    // Floors, one texture per room flavour.\n    const floors = {}; const tile0 = tileOf();\n    const rectOf = (x, y) => zone.roomRects.findIndex((r) => x >= r.x && x < r.x + r.w && y >= r.y && y < r.y + r.h);\n    const pit = new BoxBuilder();\n    for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {\n      const c = rows[y][x];\n      if (c === '.' || (c === '#' )) { const ri = Math.max(0, rectOf(x, y)); const tex = look.floor[ri % 3 === 2 ? 1 : 0]; (floors[tex] ??= new BoxBuilder()).floor(x, x + 1, y, y + 1, 0, tile0); }\n      if (c === '~') { if (look.pit === 'water') (floors[look.floor[0]] ??= new BoxBuilder()); pit.floor(x, x + 1, y, y + 1, -0.22, tile0); }\n    }\n    for (const [tex, b] of Object.entries(floors)) if (b.p.length) this.root.add(b.mesh(texMat('mist', tex), { cast: false }));\n    if (pit.p.length) {\n      const m = look.pit === 'lava' ? pit.mesh(texMat('white', 'lava-crust'), { cast: false }) : look.pit === 'rift' ? pit.mesh(texMat('white', 'rift-energy'), { cast: false }) : look.pit === 'water' ? pit.mesh(texMat('white', 'shallow-water'), { cast: false }) : pit.mesh(toonMaterial(PALETTE.ink), { cast: false });\n      this.root.add(m);\n      if (look.pit === 'water') {\n        const w = new WaterSurface({ size: [W + 40, H + 40], at: [W / 2, -0.3, H / 2], waves: WAVES_CALM });\n        this.root.add(w); this.water = w;\n      }\n    }\n    // Walls: a cell with floor on its +X or +Z side is a back wall, tall; floor only on -X or -Z makes a low stub.\n    const wallB = new BoxBuilder(); const capB = new BoxBuilder(); const stubB = new BoxBuilder();\n    const wallH = zone.spec.wallH; const tileW = tileOf();\n    const classify = (x, y) => {\n      if (rows[y][x] !== '#') return null;\n      const px = isFloor(at(x + 1, y)); const pz = isFloor(at(x, y + 1)); const nx = isFloor(at(x - 1, y)); const nz = isFloor(at(x, y - 1));\n      const dpp = isFloor(at(x + 1, y + 1)); const dnn = isFloor(at(x - 1, y - 1)); const dpn = isFloor(at(x + 1, y - 1)); const dnp = isFloor(at(x - 1, y + 1));\n      if (px || pz || dpp) return 'tall';\n      if (nx || nz || dnn || dpn || dnp) return 'stub';\n      return null;\n    };\n    const physBoxes = [];\n    for (let y = 0; y < H; y++) {\n      let x = 0;\n      while (x < W) {\n        const k = classify(x, y);\n        if (!k) { x++; continue; }\n        let e = x + 1; while (e < W && classify(e, y) === k) e++;\n        const h = k === 'tall' ? wallH : Math.min(0.6, wallH);\n        (k === 'tall' ? wallB : stubB).box(x, e, 0, h, y, y + 1, tileW, false);\n        capB.box(x, e, h, h + 0.08, y, y + 1, tileW);\n        physBoxes.push({ position: [(x + e) / 2, h / 2, y + 0.5], halfExtents: [(e - x) / 2, h / 2, 0.5] });\n        x = e;\n      }\n    }\n    if (wallB.p.length) this.root.add(wallB.mesh(texMat(look.tint, look.wall)));\n    if (stubB.p.length) this.root.add(stubB.mesh(texMat(look.tint, look.wall)));\n    if (capB.p.length) this.root.add(capB.mesh(toonMaterial(PALETTE[look.cap])));\n    const ph = ctx.physics;\n    this.colliders.push(ph.addStaticBox({ position: [W / 2, -0.5, H / 2], halfExtents: [W / 2 + 4, 0.5, H / 2 + 4] }));\n    for (const b of physBoxes) this.colliders.push(ph.addStaticBox(b));\n\n    // Lights and torches.\n    let li = 0;\n    for (const l of zone.lights) {\n      const id = look.torch; const color = look.light2 && (li++ % 2) ? look.light2 : look.light;\n      this.place(id, l.x, l.z, rng.range(0, 6.28), {}, id === 'lamp-post' || id === 'standing-torch' || id === 'chandelier');\n      const y = id === 'candles' ? 1 : 2.2;\n      this.lights.push(ctx.lights.request({ position: [l.x, y, l.z], color, intensity: id === 'candles' ? 7 : 9, radius: 10, flicker: 'torch', priority: 1 }));\n    }\n    // Dressing: low clutter on floors and hung things on back walls.\n    const dressN = Math.floor((W * H) / 42);\n    for (let i = 0; i < dressN; i++) {\n      const x = rng.int(1, W - 2); const y = rng.int(1, H - 2);\n      if (rows[y][x] !== '.' || zone.nav && !zone.nav.isOpen(x, y)) continue;\n      const nearWall = at(x, y - 1) === '#' || at(x - 1, y) === '#';\n      const id = rng.pick(look.dress);\n      if ((id === 'dead-tree' || id === 'ruined-wall' || id === 'bookshelf') && !nearWall) continue;\n      this.place(id, x + rng.range(0.2, 0.8), y + rng.range(0.2, 0.8), rng.range(0, 6.28), { seed: rng.int(1, 99) }, id === 'dead-tree');\n      if (id === 'flame') this.lights.push(ctx.lights.request({ position: [x + 0.5, 1, y + 0.5], color: 0xff7020, intensity: 4, radius: 5, flicker: 'torch', priority: 0.6 }));\n    }\n    if (look.wallDress.length) {\n      for (let y = 1; y < H - 1; y++) for (let x = 1; x < W - 1; x++) {\n        if (rows[y][x] !== '#' || !rng.chance(0.045)) continue;\n        if (at(x, y + 1) === '.' ) { const id = rng.pick(look.wallDress); this.place(id, x + 0.5, y + 1.02, 0, {}, false, 1.1); if (id === 'wall-torch' || id === 'wall-lantern') this.lights.push(ctx.lights.request({ position: [x + 0.5, 2, y + 1.4], color: look.light2 ?? look.light, intensity: 5, radius: 7, flicker: 'torch', priority: 0.7 })); }\n        else if (at(x + 1, y) === '.') { const id = rng.pick(look.wallDress); this.place(id, x + 1.02, y + 0.5, Math.PI / 2, {}, false, 1.1); }\n      }\n    }\n    // Gothic columns along long back walls, for depth.\n    if (zone.spec.biome === 'crypt' || zone.spec.biome === 'cloister') {\n      for (const r of zone.roomRects) { if (r.w < 13) continue; for (let x = r.x + 3; x < r.x + r.w - 3; x += 5) if (at(x, r.y + 1) === '.' && at(x, r.y) === '#') this.place('column', x + 0.5, r.y + 1.1, 0, { params: {} }, false); }\n    }\n    if (zone.spec.rain) { const rain = new Precipitation({ kind: 'rain', count: 3000, area: [40, 16, 40], color: PALETTE.sky }); rain.intensity = 0.8; this.root.add(rain); this.rain = rain; }\n    ctx.engine.setSunDirection(zone.spec.look === 'town' ? [0.8, 0.5, 0.25] : [0.5, 0.8, 0.35]);\n    this.rng = rng;\n    this.zoneId = zone.id;\n  }\n\n  place(id, x, z, rot = 0, opts = {}, tall = false, y = 0) {\n    const b = buildModel(id, { ...opts, catalog: MODELS });\n    b.object.position.set(x, y && y !== 0 ? 0 : 0, z); b.object.rotation.y = rot;\n    if (y > 1) b.object.position.y = 0;\n    b.object.traverse((o) => { if (o.isMesh) { o.castShadow = true; o.receiveShadow = true; } });\n    this.root.add(b.object);\n    if (tall) this.tall.push(b.object);\n    return b.object;\n  }\n\n  // Anything tall between the camera and a hero steps aside.\n  fadeTall(heroes) {\n    for (const o of this.tall) {\n      let hide = false;\n      for (const h of heroes) { const dx = o.position.x - h.x; const dz = o.position.z - h.z; const toward = (dx + dz) * 0.707; const side = Math.abs(dx - dz) * 0.707; if (toward > 0 && toward < 5 && side < 1.6) { hide = true; break; } }\n      o.visible = !hide;\n    }\n  }\n  update(dt, focus, t) { if (this.rain) { this.rain.update(dt, focus); } if (this.water) this.water.update(t); }\n}\nexport { Vector3 };\nEOF\ncat > src/audio/sfxdata.js <<'EOF'\n// All sound effects: SoundDefs, data only.\nconst bell = (f, decay, volume = 0.5, detune = 1.002, extra = {}) => ({\n  wave: 'sine', freq: f, decay, volume,\n  layers: [\n    { wave: 'sine', freq: f * 0.5, decay: decay * 1.4, volume: volume * 0.6 },\n    { wave: 'sine', freq: f * 1.2 * detune, decay: decay * 0.8, volume: volume * 0.45 },\n    { wave: 'sine', freq: f * 1.5, decay: decay * 0.7, volume: volume * 0.32 },\n    { wave: 'sine', freq: f * 2, decay: decay * 0.6, volume: volume * 0.3 },\n    { wave: 'sine', freq: f * 2.67, decay: decay * 0.4, volume: volume * 0.2 },\n    { wave: 'sine', freq: f * 3 * detune, decay: decay * 0.3, volume: volume * 0.14 },\n    ...(extra.layers ?? []),\n  ],\n});\nconst noise = (freq, decay, volume, o = {}) => ({ wave: 'noise', freq, decay, volume, ...o });\nconst thud = (f, decay, volume, o = {}) => ({ wave: 'sine', freq: f, freqEnd: f * 0.4, decay, volume, ...o });\nexport const SFX = {\n  bell_small: bell(660, 0.7, 0.34),\n  bell_big: bell(180, 2.2, 0.52),\n  bell_fall: { ...bell(150, 1.3, 0.42), layers: [...bell(150, 1.3, 0.42).layers, noise(1200, 0.2, 0.3)] },\n  bell_loot: bell(880, 1.5, 0.42),\n  bell_true: bell(98, 4.5, 0.6),\n  bell_cracked: { ...bell(87, 3, 0.5), layers: [...bell(87, 3, 0.5).layers, { wave: 'sine', freq: 88.8, decay: 3, volume: 0.25 }, { wave: 'sine', freq: 131.5, decay: 2.6, volume: 0.2 }] },\n  hit_bell: { wave: 'triangle', freq: 400, freqEnd: 160, decay: 0.12, volume: 0.25, layers: [noise(3000, 0.05, 0.2), { wave: 'sine', freq: 760, decay: 0.2, volume: 0.1 }] },\n  hit_flesh: { wave: 'square', duty: 0.25, freq: 180, freqEnd: 60, decay: 0.09, volume: 0.22, layers: [noise(1800, 0.06, 0.25)] },\n  hit_bone: { wave: 'square', duty: 0.125, freq: 800, freqEnd: 300, decay: 0.05, volume: 0.2, layers: [noise(5000, 0.04, 0.25)] },\n  hit_stone: { wave: 'triangle', freq: 120, freqEnd: 50, decay: 0.16, volume: 0.42, layers: [noise(1400, 0.1, 0.3)] },\n  hit_wood: { wave: 'triangle', freq: 280, freqEnd: 120, decay: 0.08, volume: 0.3, layers: [noise(2400, 0.04, 0.2)] },\n  hit_metal: { wave: 'square', duty: 0.25, freq: 1100, freqEnd: 700, decay: 0.08, volume: 0.15, layers: [{ wave: 'sine', freq: 2200, decay: 0.15, volume: 0.12 }] },\n  hit_fire: noise(2200, 0.14, 0.26, { freqEnd: 800 }),\n  crit: { wave: 'square', duty: 0.5, freq: 980, freqEnd: 500, decay: 0.08, volume: 0.15, layers: [{ wave: 'sine', freq: 1480, decay: 0.12, volume: 0.12 }] },\n  swing_heavy: noise(900, 0.18, 0.24, { freqEnd: 300 }),\n  swing_shovel: noise(1400, 0.12, 0.2, { freqEnd: 500 }),\n  chain_whirl: { wave: 'noise', freq: 3500, freqEnd: 1500, decay: 0.3, volume: 0.18, vibrato: { depth: 3, rate: 30 } },\n  spark: { wave: 'square', duty: 0.125, freq: 1600, freqEnd: 500, decay: 0.09, volume: 0.13 },\n  flare: { wave: 'noise', freq: 4000, freqEnd: 600, decay: 0.3, volume: 0.32 },\n  whoosh: noise(1200, 0.2, 0.2, { freqEnd: 400 }),\n  whoosh_big: noise(700, 0.35, 0.3, { freqEnd: 200 }),\n  explode_fire: { wave: 'noise', freq: 1800, freqEnd: 150, decay: 0.45, volume: 0.42, layers: [thud(110, 0.3, 0.4)] },\n  explode_big: { wave: 'noise', freq: 900, freqEnd: 70, decay: 1.1, volume: 0.55, layers: [thud(70, 0.8, 0.5)] },\n  plant: { wave: 'triangle', freq: 200, freqEnd: 90, decay: 0.16, volume: 0.32, layers: [noise(2000, 0.05, 0.12)] },\n  blink: { wave: 'sine', freq: 300, freqEnd: 1400, decay: 0.16, volume: 0.2, layers: [noise(5000, 0.1, 0.1)] },\n  snuff: { wave: 'noise', freq: 600, freqEnd: 6000, decay: 0.4, volume: 0.3 },\n  beacon: { wave: 'sine', freq: 330, freqEnd: 660, decay: 0.9, volume: 0.25, layers: [{ wave: 'sine', freq: 495, freqEnd: 990, decay: 0.8, volume: 0.15 }] },\n  comet_call: { wave: 'sine', freq: 700, freqEnd: 120, decay: 1, volume: 0.3, layers: [noise(800, 0.8, 0.14)] },\n  toss: noise(2500, 0.1, 0.16, { freqEnd: 900 }),\n  raise: { wave: 'triangle', freq: 90, freqEnd: 260, decay: 0.5, volume: 0.34, layers: [noise(2400, 0.3, 0.1)] },\n  exhume: { wave: 'noise', freq: 500, freqEnd: 90, decay: 0.5, volume: 0.42, layers: [thud(90, 0.3, 0.3)] },\n  coffin_crash: { wave: 'triangle', freq: 110, freqEnd: 40, decay: 0.35, volume: 0.5, layers: [noise(1200, 0.2, 0.34), noise(4000, 0.06, 0.15)] },\n  curse: { wave: 'sine', freq: 220, freqEnd: 110, decay: 0.7, volume: 0.28, vibrato: { depth: 1, rate: 8 } },\n  sink: { wave: 'sine', freq: 300, freqEnd: 60, decay: 0.3, volume: 0.28, layers: [noise(600, 0.2, 0.16)] },\n  grave_burst: { wave: 'noise', freq: 1100, freqEnd: 200, decay: 0.3, volume: 0.36, layers: [thud(120, 0.2, 0.3)] },\n  danse: { wave: 'square', duty: 0.25, freq: 294, decay: 0.8, volume: 0.13, arp: [0, 3, 7, 12, 7, 3], arpRate: 0.1 },\n  shout_wave: { wave: 'sawtooth', freq: 180, freqEnd: 90, decay: 0.32, volume: 0.28, layers: [noise(800, 0.22, 0.2)] },\n  charge: noise(600, 0.4, 0.28, { freqEnd: 1500 }),\n  hymn: { wave: 'triangle', freq: 262, decay: 1, volume: 0.2, arp: [0, 7, 12], arpRate: 0.2 },\n  crossbow: { wave: 'square', duty: 0.25, freq: 600, freqEnd: 140, decay: 0.07, volume: 0.16, layers: [noise(3500, 0.04, 0.12)] },\n  telegraph: { wave: 'square', duty: 0.5, freq: 330, freqEnd: 300, decay: 0.2, volume: 0.1, vibrato: { depth: 1, rate: 14 } },\n  monster_hit: { wave: 'triangle', freq: 150, freqEnd: 90, decay: 0.08, volume: 0.22 },\n  sour_note: { wave: 'sawtooth', freq: 415, freqEnd: 400, decay: 0.45, volume: 0.13, vibrato: { depth: 0.8, rate: 7 }, layers: [{ wave: 'sawtooth', freq: 440, decay: 0.45, volume: 0.09 }] },\n  bloat_burst: { wave: 'noise', freq: 500, freqEnd: 120, decay: 0.42, volume: 0.45, layers: [thud(70, 0.3, 0.4)] },\n  nest: { wave: 'sawtooth', freq: 110, freqEnd: 170, decay: 0.2, volume: 0.14, layers: [noise(2500, 0.1, 0.1)] },\n  roar: { wave: 'sawtooth', freq: 120, freqEnd: 70, decay: 0.9, volume: 0.36, crush: 8, vibrato: { depth: 2, rate: 16 } },\n  rope_lash: noise(3000, 0.16, 0.3, { freqEnd: 700 }),\n  crumble: { wave: 'noise', freq: 700, freqEnd: 90, decay: 0.8, volume: 0.42, layers: [thud(60, 0.5, 0.35)] },\n  spikes: { wave: 'square', duty: 0.125, freq: 900, freqEnd: 240, decay: 0.09, volume: 0.2 },\n  lever: { wave: 'square', duty: 0.25, freq: 180, freqEnd: 90, decay: 0.2, volume: 0.28, layers: [noise(2000, 0.06, 0.2)] },\n  chest: { wave: 'triangle', freq: 240, freqEnd: 480, decay: 0.26, volume: 0.28, arp: [0, 4, 7], arpRate: 0.07 },\n  shrine: { wave: 'sine', freq: 523, decay: 0.8, volume: 0.25, arp: [0, 7, 12, 19], arpRate: 0.09 },\n  gold: { wave: 'square', duty: 0.25, freq: 1300, decay: 0.05, volume: 0.1, arp: [0, 5], arpRate: 0.03 },\n  coin_spray: { wave: 'square', duty: 0.125, freq: 1600, decay: 0.28, volume: 0.13, arp: [0, 3, 5, 7, 3, 5, 8], arpRate: 0.03 },\n  tallow: { wave: 'sine', freq: 300, freqEnd: 180, decay: 0.12, volume: 0.25 },\n  potion: { wave: 'sine', freq: 400, freqEnd: 1000, decay: 0.4, volume: 0.26, vibrato: { depth: 2, rate: 12 } },\n  dodge: noise(1500, 0.16, 0.2, { freqEnd: 500 }),\n  level_up: { wave: 'triangle', freq: 392, decay: 0.8, volume: 0.32, arp: [0, 4, 7, 12, 16], arpRate: 0.08, layers: [bell(784, 0.9, 0.2)] },\n  hurt_hero: { wave: 'square', duty: 0.5, freq: 200, freqEnd: 90, decay: 0.12, volume: 0.25, layers: [noise(1200, 0.08, 0.15)] },\n  hero_death: { wave: 'sawtooth', freq: 220, freqEnd: 40, decay: 1, volume: 0.34 },\n  step_mud: noise(500, 0.05, 0.06),\n  step_stone: noise(1800, 0.03, 0.06),\n  step_wood: { wave: 'triangle', freq: 170, decay: 0.04, volume: 0.09 },\n  shatter: { wave: 'noise', freq: 4200, freqEnd: 1500, decay: 0.2, volume: 0.28, layers: [{ wave: 'square', duty: 0.125, freq: 900, freqEnd: 300, decay: 0.08, volume: 0.13 }] },\n  shatter_wood: { wave: 'noise', freq: 2200, freqEnd: 600, decay: 0.16, volume: 0.28, layers: [thud(180, 0.12, 0.25)] },\n  chunk: noise(2500, 0.03, 0.09),\n  wake: { wave: 'sawtooth', freq: 90, freqEnd: 120, decay: 0.4, volume: 0.14, vibrato: { depth: 1, rate: 6 } },\n  ui_move: { wave: 'square', duty: 0.25, freq: 660, decay: 0.03, volume: 0.09 },\n  ui_ok: { wave: 'square', duty: 0.25, freq: 660, decay: 0.09, volume: 0.13, arp: [0, 7], arpRate: 0.05 },\n  ui_back: { wave: 'square', duty: 0.25, freq: 494, freqEnd: 330, decay: 0.09, volume: 0.1 },\n  ui_error: { wave: 'square', duty: 0.5, freq: 150, decay: 0.15, volume: 0.13 },\n  ui_tab: { wave: 'triangle', freq: 520, decay: 0.05, volume: 0.13 },\n  ui_equip: { wave: 'triangle', freq: 300, freqEnd: 620, decay: 0.12, volume: 0.22, layers: [{ wave: 'square', duty: 0.125, freq: 1200, decay: 0.05, volume: 0.06 }] },\n  ui_salvage: { wave: 'noise', freq: 2400, freqEnd: 700, decay: 0.15, volume: 0.2 },\n  anvil: { wave: 'square', duty: 0.25, freq: 1400, freqEnd: 1100, decay: 0.2, volume: 0.13, layers: [{ wave: 'sine', freq: 2800, decay: 0.3, volume: 0.1 }] },\n  quest: { wave: 'triangle', freq: 440, decay: 0.45, volume: 0.25, arp: [0, 5, 9, 12], arpRate: 0.1 },\n  fanfare_bell: bell(392, 1.4, 0.34),\n  req: { wave: 'triangle', freq: 330, decay: 0.3, volume: 0.22, arp: [0, 3, 7], arpRate: 0.05 },\n};\n// Ambience loops.\nexport const LOOPS = {\n  rain: { wave: 'noise', freq: 9000, sustain: 1.6, decay: 0.1, volume: 0.05 },\n  wind: { wave: 'noise', freq: 500, sustain: 2.8, decay: 0.1, volume: 0.06, vibrato: { depth: 3, rate: 0.3 } },\n  fire: { wave: 'noise', freq: 1400, sustain: 1.2, decay: 0.1, volume: 0.05, vibrato: { depth: 2, rate: 9 } },\n};\nexport const SFX_IDS = Object.keys(SFX);\nEOF\ncat > src/audio/songs.js <<'EOF'\n// All music: Song data. Every piece states or bends the Clemency motif: D4 A4 F4 E4 | D4 C4 D4 A3.\nconst organ = { wave: 'square', duty: 0.25, decay: 0.5, volume: 0.09 };\nconst lowBell = { wave: 'sine', decay: 1.4, volume: 0.13 };\nconst bass = { wave: 'triangle', decay: 0.35, volume: 0.16 };\nconst wind = { wave: 'noise', decay: 0.8, volume: 0.015 };\nconst drum = { wave: 'noise', decay: 0.12, volume: 0.07 };\nconst kick = { wave: 'sine', freqEnd: 40, decay: 0.12, volume: 0.2 };\nconst lute = { wave: 'triangle', decay: 0.28, volume: 0.1 };\nconst R = (s) => s.trim().replace(/\\s+/g, ' ');\nconst rests = (n) => Array(n).fill('.').join(' ');\n\nexport const SONGS = {\n  vespers: { bpm: 60, stepsPerBeat: 2, tracks: { bell: lowBell, organ, bass },\n    patterns: {\n      a: { bell: 'D4 . A4 . F4 . E4 . D4 . C4 . D4 . A3 .', organ: rests(16), bass: rests(16) },\n      b: { bell: 'D4 . A4 . F4 . E4 . D4 . C4 . D4 . A3 .', organ: 'D3 - - - A3 - - - F3 - - - E3 - - -', bass: 'D2 - - - . . . . D2 - - - . . . .' },\n      c: { bell: 'F4 . A4 . C5 . A4 . G4 . F4 . E4 . D4 .', organ: 'F3 - - - C4 - - - G3 - - - D3 - - -', bass: 'F2 - - - . . . . G2 - - - . . . .' },\n    }, order: ['a', 'a', 'b', 'c', 'b'] },\n  lamps: { bpm: 72, tracks: { lute, bell: lowBell, bass },\n    patterns: {\n      a: { lute: 'D4 F4 A4 F4 D4 F4 A4 F4 C4 E4 G4 E4 C4 E4 G4 E4', bell: R(`D5 ${rests(7)} C5 ${rests(7)}`), bass: R(`D3 ${rests(7)} C3 ${rests(7)}`) },\n      b: { lute: 'Bb3 D4 F4 D4 Bb3 D4 F4 D4 A3 C#4 E4 C#4 A3 C#4 E4 C#4', bell: R(`Bb4 ${rests(7)} A4 ${rests(7)}`), bass: R(`Bb2 ${rests(7)} A2 ${rests(7)}`) },\n      c: { lute: 'D4 A4 F4 E4 D4 C4 D4 A3 D4 A4 F4 E4 D4 C4 D4 D4', bell: R(`${rests(8)} F4 ${rests(7)}`), bass: R(`D3 ${rests(7)} D3 ${rests(7)}`) },\n    }, order: ['a', 'b', 'a', 'c'] },\n  weeping: { bpm: 66, tracks: { pulse: { wave: 'triangle', decay: 0.8, volume: 0.15 }, wind, bell: { wave: 'sine', decay: 1.2, volume: 0.05 } },\n    patterns: {\n      a: { pulse: R(`D2 ${rests(7)} . . . . A1 ${rests(3)}`), wind: R(`C5 ${rests(15)}`), bell: rests(16) },\n      b: { pulse: R(`D2 ${rests(7)} C2 ${rests(7)}`), wind: R(`${rests(8)} C4 ${rests(7)}`), bell: R(`${rests(8)} A4 . F4 . E4 . D4 .`) },\n      c: { pulse: R(`F2 ${rests(7)} A1 ${rests(7)}`), wind: R(`C5 ${rests(15)}`), bell: R(`D4 . A4 . F4 . E4 . ${rests(8)}`) },\n    }, order: ['a', 'a', 'b', 'a', 'c'] },\n  under: { bpm: 58, stepsPerBeat: 2, tracks: { pad: { wave: 'triangle', decay: 1.6, volume: 0.13 }, far: { wave: 'sine', decay: 1.6, volume: 0.05 }, low: { wave: 'sine', decay: 1.5, volume: 0.15 } },\n    patterns: {\n      a: { pad: 'D3 - - - - - - - C3 - - - - - - -', far: R(`${rests(6)} A5 . ${rests(4)} F5 . . .`), low: 'D2 - - - - - - - D2 - - - - - - -' },\n      b: { pad: 'Bb2 - - - - - - - A2 - - - - - - -', far: R(`D5 . ${rests(6)} ${rests(4)} E5 . . .`), low: 'Bb1 - - - - - - - A1 - - - - - - -' },\n      c: { pad: 'D3 - - - A3 - - - F3 - - - E3 - - -', far: rests(16), low: 'D2 - - - - - - - A1 - - - - - - -' },\n    }, order: ['a', 'b', 'a', 'c'] },\n  cinders: { bpm: 96, tracks: { ost: { wave: 'square', duty: 0.125, decay: 0.15, volume: 0.09 }, bass, drum, kick },\n    patterns: {\n      a: { ost: 'D4 D4 F4 D4 A4 D4 F4 D4 D4 D4 F4 D4 E4 D4 C4 D4', bass: 'D2 . . D2 . . D2 . D2 . . D2 . . C2 .', drum: R('. . C6 . . . C6 . . . C6 . . . C6 C6'), kick: 'C2 . . . C2 . . . C2 . . . C2 . C2 .' },\n      b: { ost: 'Bb3 Bb3 D4 Bb3 F4 Bb3 D4 Bb3 A3 A3 C#4 A3 E4 A3 C#4 A3', bass: 'Bb1 . . Bb1 . . Bb1 . A1 . . A1 . . A1 .', drum: R('. . C6 . . . C6 . . . C6 . C6 C6 C6 C6'), kick: 'C2 . . . C2 . . . C2 . . . C2 . C2 .' },\n      c: { ost: 'D5 . A4 . F4 . E4 . D4 . C4 . D4 . A3 .', bass: 'D2 . D2 . D2 . D2 . C2 . C2 . A1 . A1 .', drum: R('C6 . C6 . C6 . C6 . C6 . C6 . C6 C6 C6 C6'), kick: 'C2 . . C2 . . C2 . . C2 . . C2 . . C2' },\n    }, order: ['a', 'a', 'b', 'a', 'c'] },\n  ledger: { bpm: 126, tracks: { brass: { wave: 'square', duty: 0.5, decay: 0.2, volume: 0.09 }, oom: { wave: 'triangle', decay: 0.18, volume: 0.17 }, snare: drum },\n    patterns: {\n      a: { brass: 'D4 . D4 F4 A4 . F4 . E4 . E4 G4 Bb4 . G4 .', oom: 'D2 . A2 . D2 . A2 . C2 . G2 . C2 . G2 .', snare: '. . C6 . . . C6 C6 . . C6 . . . C6 C6' },\n      b: { brass: 'F4 . F4 A4 C5 . A4 . G4 . E4 C4 D4 . . .', oom: 'F2 . C3 . F2 . C3 . C2 . G2 . D2 . A2 .', snare: '. . C6 . . . C6 C6 . . C6 . C6 C6 C6 C6' },\n      c: { brass: 'D5 . D5 C5 Bb4 . A4 . G4 . F4 E4 D4 . C#4 .', oom: 'Bb1 . F2 . Bb1 . F2 . A1 . E2 . A1 . E2 .', snare: 'C6 . C6 . C6 . C6 . C6 . C6 . C6 C6 C6 C6' },\n    }, order: ['a', 'b', 'a', 'c'] },\n  climb: { bpm: 104, tracks: { rise: { wave: 'square', duty: 0.25, decay: 0.14, volume: 0.09 }, bass, drum },\n    patterns: {\n      a: { rise: 'D4 F4 A4 D5 D4 F4 A4 D5 E4 G4 Bb4 E5 E4 G4 Bb4 E5', bass: 'D2 . D2 . D2 . D2 . E2 . E2 . E2 . E2 .', drum: 'C6 . C8 . C6 . C8 . C6 . C8 . C6 C8 C6 C8' },\n      b: { rise: 'F4 A4 C5 F5 F4 A4 C5 F5 G4 Bb4 D5 G5 A4 C#5 E5 A5', bass: 'F2 . F2 . F2 . F2 . G2 . G2 . A2 . A2 .', drum: 'C6 . C8 . C6 . C8 . C6 C6 C8 . C6 C6 C6 C6' },\n      c: { rise: 'D5 . A4 . F4 . E4 . D4 . C4 . D4 . A3 .', bass: 'D2 D2 D2 D2 C2 C2 C2 C2 Bb1 Bb1 Bb1 Bb1 A1 A1 A1 A1', drum: 'C6 C8 C6 C8 C6 C8 C6 C8 C6 C8 C6 C8 C6 C6 C6 C6' },\n    }, order: ['a', 'b', 'a', 'b', 'c'] },\n  // Malison's Eventide: the motif one semitone off, because the bell is cracked.\n  eventide: { bpm: 138, tracks: { stab: { wave: 'square', duty: 0.5, decay: 0.2, volume: 0.09 }, cracked: { wave: 'sawtooth', decay: 0.3, volume: 0.07 }, bass, drum, kick },\n    patterns: {\n      a: { stab: 'D4 . . D4 . . D4 . F4 . . F4 . . E4 .', cracked: 'Eb4 . Bb4 . F#4 . F4 . Eb4 . C#4 . Eb4 . Bb3 .', bass: 'D2 D2 . D2 D2 . D2 . D2 D2 . D2 C2 . C2 .', drum: '. . C6 . . . C6 . . . C6 . . C6 C6 C6', kick: 'C2 . . . C2 . . . C2 . . . C2 . . .' },\n      b: { stab: 'Bb3 . . Bb3 . . Bb3 . A3 . . A3 . . A3 .', cracked: 'B4 . F#5 . C#5 . C5 . B4 . A4 . B4 . F#4 .', bass: 'Bb1 Bb1 . Bb1 Bb1 . Bb1 . A1 A1 . A1 A1 . A1 .', drum: '. . C6 . . . C6 . . . C6 . C6 C6 C6 C6', kick: 'C2 . . C2 C2 . . . C2 . . C2 C2 . . .' },\n      c: { stab: 'D5 . . . C#5 . . . C5 . . . B4 . . .', cracked: 'Eb4 Bb4 F#4 F4 Eb4 C#4 Eb4 Bb3 Eb4 Bb4 F#4 F4 Eb4 C#4 Eb4 Bb3', bass: 'D2 . D2 . C#2 . C#2 . C2 . C2 . B1 . B1 .', drum: 'C6 . C6 . C6 . C6 . C6 . C6 . C6 C6 C6 C6', kick: 'C2 . C2 . C2 . C2 . C2 . C2 . C2 . C2 .' },\n    }, order: ['a', 'a', 'b', 'a', 'c'] },\n  eventide3: { bpm: 138, tracks: { stab: { wave: 'square', duty: 0.5, decay: 0.3, volume: 0.09 }, cracked: { wave: 'sawtooth', decay: 0.5, volume: 0.09 }, bell: lowBell },\n    patterns: {\n      a: { stab: 'D4 . . . . . . . . . . . . . . .', cracked: 'Eb4 . . . Bb4 . . . F#4 . . . F4 . . .', bell: 'D3 . . . . . . . A2 . . . . . . .' },\n      b: { stab: 'C4 . . . . . . . . . . . . . . .', cracked: 'Eb4 . . . C#4 . . . Eb4 . . . Bb3 . . .', bell: 'C3 . . . . . . . A2 . . . . . . .' },\n      c: { stab: 'Bb3 . . . . . . . A3 . . . . . . .', cracked: 'F#4 . . . F4 . . . Eb4 . . . C#4 . . .', bell: 'Bb2 . . . . . . . A2 . . . . . . .' },\n    }, order: ['a', 'b', 'c', 'b'] },\n  knell: { bpm: 118, tracks: { drive: { wave: 'square', duty: 0.25, decay: 0.12, volume: 0.09 }, bass, drum, kick, bell: { wave: 'sine', decay: 0.9, volume: 0.09 } },\n    patterns: {\n      a: { drive: 'D4 A3 D4 F4 D4 A3 D4 E4 D4 A3 D4 F4 D4 C4 D4 A3', bass: 'D2 . D2 . D2 . D2 . D2 . D2 . C2 . A1 .', drum: '. . C6 . . . C6 . . . C6 . . . C6 .', kick: 'C2 . . . C2 . . . C2 . . . C2 . . .', bell: 'D5 . . . . . . . A4 . . . . . . .' },\n      b: { drive: 'F4 C4 F4 A4 F4 C4 F4 G4 E4 C4 E4 G4 E4 C4 E4 A4', bass: 'F2 . F2 . F2 . F2 . C2 . C2 . C2 . E2 .', drum: '. . C6 . . . C6 . . . C6 . . C6 C6 .', kick: 'C2 . . . C2 . . . C2 . . . C2 . . .', bell: 'F5 . . . . . . . E5 . . . . . . .' },\n      c: { drive: 'D5 A4 F4 E4 D4 C4 D4 A3 D5 A4 F4 E4 D4 C4 D4 D4', bass: 'Bb1 . Bb1 . Bb1 . Bb1 . A1 . A1 . A1 . A1 .', drum: 'C6 . C6 . C6 . C6 . C6 . C6 . C6 C6 C6 C6', kick: 'C2 . . C2 C2 . . C2 C2 . . C2 C2 . C2 .', bell: 'D5 . A4 . F4 . E4 . D4 . C4 . D4 . A3 .' },\n    }, order: ['a', 'b', 'a', 'c'] },\n  // Clemency, for the ending: the motif resolved to major at last.\n  clemency: { bpm: 66, stepsPerBeat: 2, tracks: { bell: lowBell, organ: { wave: 'triangle', decay: 0.9, volume: 0.1 }, bass },\n    patterns: {\n      a: { bell: 'D4 . A4 . F#4 . E4 . D4 . C#4 . D4 . A3 .', organ: 'D3 - - - A3 - - - G3 - - - D3 - - -', bass: 'D2 - - - A1 - - - G1 - - - D2 - - -' },\n      b: { bell: 'F#4 . A4 . D5 . A4 . G4 . F#4 . E4 . D4 .', organ: 'B3 - - - F#3 - - - G3 - - - A3 - - -', bass: 'B1 - - - F#2 - - - G2 - - - A2 - - -' },\n      c: { bell: 'A4 . D5 . C#5 . A4 . B4 . A4 . D4 . . .', organ: 'D4 - - - A3 - - - G3 - - - D3 - - -', bass: 'D2 - - - E2 - - - A1 - - - D2 - - -' },\n    }, order: ['a', 'b', 'a', 'c'] },\n};\nEOF\ncat > tools/scratch/au.mjs <<'EOF'\nimport { renderSound, parseSong } from '../../pixel-engine.js';\nimport { SFX } from '../../src/audio/sfxdata.js'; import { SONGS } from '../../src/audio/songs.js';\nlet n=0; for (const [k,d] of Object.entries(SFX)){ const s=renderSound(d); let p=0; for(const v of s) p=Math.max(p,Math.abs(v)); if(p>1||p<0.01) console.log(k,p.toFixed(3)); n++; }\nfor (const [k,d] of Object.entries(SONGS)){ try{parseSong(d);}catch(e){console.log('SONG',k,e.message)} }\nconsole.log(n,'sfx',Object.keys(SONGS).length,'songs');\nEOF\nnode tools/scratch/au.mjs 2>&1 | cut -c1-200 | tail -20; for id in dry-stone bricks sandstone parquet wet-sand; do grep -c \"^| \\`$id\\`\" LIBRARY.md; done | tr '\\n' ' '","description":"Write zone view, sound effects and songs, validate audio"}}}
