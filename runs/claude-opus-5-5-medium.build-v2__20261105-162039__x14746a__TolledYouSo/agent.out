llis', col, row, r: 1, facing: 0 });\"\"\",\"\"\"  const { col, row, cells } = gate.door;\n  for (const c of cells) { z.nav.setOpen(c.col, c.row, false); for (const n of w.navs ?? []) n.setOpen(c.col, c.row, false); }\n  const port = addProp(w, { kind: 'portcullis', x: col + 0.5, z: row + 0.5, model: 'portcullis', col, row, cells, r: 1, facing: 0, horizontal: cells.length > 1 ? cells[1].row === row : true });\"\"\")\nopen(p,'w').write(s)\np='src/sim/step.js'; s=open(p).read()\ns=s.replace(\"if (port) { w.zone.nav.setOpen(port.col, port.row, true); for (const n of w.navs) n.setOpen(port.col, port.row, true); port.gone = true;\",\"if (port) { for (const c of port.cells) { w.zone.nav.setOpen(c.col, c.row, true); for (const n of w.navs) n.setOpen(c.col, c.row, true); } port.gone = true;\")\nopen(p,'w').write(s)\np='src/sim/bot.js'; s=open(p).read()\ns=s.replace(\"\"\"  for (const dr of w.drops) { if (dr.seat >= 0 && dr.seat !== h.seat) continue;\"\"\",\"\"\"  if (Math.abs(h.x - b.lastX) + Math.abs(h.z - b.lastZ) < 0.01) b.stuck += 1 / 60; else b.stuck = 0;\n  b.lastX = h.x; b.lastZ = h.z;\n  if (b.stuck > 2 && b.loot) { (b.ignore ??= new Set()).add(b.loot); b.loot = null; b.stuck = 0; }\n  for (const dr of w.drops) { if (dr.seat >= 0 && dr.seat !== h.seat) continue; if (b.ignore?.has(dr.id)) continue;\"\"\")\ns=s.replace(\"if (loot) { const r = pathTo(w, h, b, loot.x, loot.z); if (r) { it.moveX = r.x; it.moveZ = r.z; return it; } }\",\"if (loot) { b.loot = loot.id; const r = pathTo(w, h, b, loot.x, loot.z); if (r) { it.moveX = r.x; it.moveZ = r.z; return it; } (b.ignore ??= new Set()).add(loot.id); }\")\nopen(p,'w').write(s)\nEOF\nsed -i '/^if(!w.ended){ const z=w.zone/,$d' tools/scratch/camp.mjs\nfor c in bellwarden lamplighter sexton; do node tools/scratch/camp.mjs $c 2>&1 | cut -c1-120 | tail -24 | sed -n '10,$p'; done","description":"Widen doors, add corner sliding, run all three classes"}}}
