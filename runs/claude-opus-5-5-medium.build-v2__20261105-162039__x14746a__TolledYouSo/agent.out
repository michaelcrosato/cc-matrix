 ui.text(x + 3, y + 2, label, { color: 'white', shadow: false }); ui.lastPromptKind = xb ? 'xbox' : 'playstation'; return w;\n}\nexport function promptLine(ui, x, y, parts, o = {}) {\n  // parts: [[action, label], ...]; draws left to right from x, or fitted to the right edge with o.right.\n  let cx = x;\n  for (const [action, label] of parts) { const w = prompt(ui, cx, y, action); cx += w + 3; cx += ui.text(cx, y + 2, label, { color: o.color ?? 'mist' }) + 9; }\n  return cx - x;\n}\nexport const footer = (ui, parts) => {\n  const y = ui.H - 16; let total = 0; for (const [, label] of parts) total += ui.measure(label) + 26;\n  promptLine(ui, Math.max(12, ui.W / 2 - total / 2), y, parts);\n};\nEOF\necho ok","description":"Write input router, UI core and glyph prompts"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":25501,"cache_read_input_tokens":458716,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":25501},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"69254de6-4061-470e-8e76-10f1ee96c6e5","uuid":"aa3359b9-5183-47ea-80b6-4df46f7296aa","timestamp":"2026-11-06T00:05:37.756Z","request_id":"req_011CgkhFDryEhqJ18GrQN26P","wire_tool_inputs":{"toolu_014mvBmt9KEzHvt7p4EKxkuw":{"command":"cat >> ../PROGRESS.md <<'EOF'\n- View written: src/view/{zonebuild,actors,vfx,view,clips}.js, models/*; audio: src/audio/*. NEXT: src/input/router.js, src/ui/{ui,glyphs,hud,menus,devmode}.js, src/modes/{shell,play}.js, game.js, tools/build.mjs; then net, tests, polish, exit interview.\nEOF\ncat > src/input/router.js <<'EOF'\n// All input becomes intents and menu actions. Pad state travels through ctx.input.send so replays stay valid.\nimport { interactTarget } from '../sim/step.js';\n\nexport const S