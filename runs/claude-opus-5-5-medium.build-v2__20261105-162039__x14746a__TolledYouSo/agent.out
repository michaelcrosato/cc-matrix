{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkemPYrnqDVTe4LpUaER","type":"message","role":"assistant","content":[{"type":"text","text":"Map generation works now, with all zones connecting from entrance to exit across the seeds tested. Next is the core simulation: the world loop, heroes and the effect ops."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1513,"cache_read_input_tokens":228082,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1513},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"69254de6-4061-470e-8e76-10f1ee96c6e5","uuid":"0a60eb51-f723-4cd1-85a0-525fc5f5e91a","timestamp":"2026-11-05T23:30:43.877Z","request_id":"req_011CgkemPJEFbYpSBtFqqos9"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkemPYrnqDVTe4LpUaER","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01D3FhrW8DpZNXkUqqG2ue4a","name":"Bash","input":{"command":"python3 - <<'EOF'\np='src/data/rooms.js'; s=open(p).read()\ns=s.replace(\"####################D#################\\n#...N......S.......~~~~~\",\"############D#########################\\n#...N......S.......~~~~~\")\nopen(p,'w').write(s)\nEOF\nnode tools/scratch/rt.mjs\ncat > src/sim/world.js <<'EOF'\n// The simulation root. Plain JavaScript: no THREE, no DOM, no ctx. stepWorld(world, intents) at 60 Hz.\nimport { Rng, NavGrid } from '../../pixel-engine.js';\nimport { DIFFICULTIES, makeTuning, F } from '../data/tuning.js';\nimport { ZONES } from '../data/zones.js';\nimport { generateZone } from './zonegen.js';\nimport { recalc } from './stats.js';\n\nexport const DT = 1 / 60;\n\nexport function emit(w, ev) { w.events.push(ev); }\nexport function after(w, t, fn) { w.timers.push({ at: w.time + t, fn }); }\nexport const dist = (a, b) => Math.hypot(a.x - b.x, a.z - b.z);\nexport const near = (a, x, z, r) => { const dx = a.x - x; const dz = a.z - z; return dx * dx + dz * dz <= r * r; };\n\nexport function createWorld({ seed = 1, mode = 'campaign', tuning = null, difficulty = 0 } = {}) {\n  const root = new Rng(seed);\n  const w = {\n    seed, mode, root, tuning: tuning ?? makeTuning(),\n    rngs: { loot: root.fork('loot'), ai: root.fork('ai'), combat: root.fork('combat'), spawn: root.fork('spawn'), quest: root.fork('quest') },\n    time: 0, tick: 0, nextId: 1, events: [], timers: [],\n    heroes: [], monsters: [], allies: [], props: [], drops: [], fields: [], projectiles: [], obstacles: [], graves: [], telegraphs: [],\n    zone: null, zoneCache: new Map(), difficulty, diff: DIFFICULTIES[difficulty], active: [],\n    navs: [], requiem: { n: 0, t: 0, xp: 0 }, story: { q: 0, step: 0, flags: {}, lychgates: ['town'], writs: null, writsDone: 0 }, knell: null, boss: null, arena: null,\n    objective: null, cheats: { god: false, oneHit: false, noCd: false, infRes: false, noClip: false, invisible: false },\n    bestiary: {}, lore: {}, devotion: { xp: 0, level: 0, spent: { core: 0, offence: 0, defence: 0, utility: 0 } }, stash: [[], [], []], unlocks: { penance: false, knell: false },\n    bests: {}, paused: false, ended: false, frozen: false, stats: { kills: 0 },\n    round: null, wagon: null, tutorial: {}, seen: {},\n  };\n  return w;\n}\n\nexport const setDifficulty = (w, i) => { w.difficulty = i; w.diff = DIFFICULTIES[i]; };\n\nexport function partyLevel(w) { let L = 1; for (const h of w.heroes) if (!h.left && !h.isPyx) L = Math.max(L, h.level); return L; }\nexport function monsterLevel(w) { return Math.max(partyLevel(w), w.zone?.spec.levelFloor ?? 1); }\nexport function playerCount(w) { return Math.max(1, w.heroes.filter((h) => !h.left && !h.isPyx).length); }\n\n// Zones: one active zone for the party. Leaving keeps its state, so returning finds it as it was.\nexport function enterZone(w, zoneId, at = null, hooks = w.hooks) {\n  if (w.zone) w.zoneCache.set(w.zone.id, { zone: w.zone, monsters: w.monsters, props: w.props, drops: w.drops, graves: w.graves, obstacles: w.obstacles });\n  const cached = w.zoneCache.get(zoneId);\n  w.fields = []; w.projectiles = []; w.telegraphs = []; w.timers = w.timers.filter((t) => t.keep);\n  w.allies = w.allies.filter((a) => a.minion);\n  w.boss = null; w.arena = null;\n  if (cached) { w.zone = cached.zone; w.monsters = cached.monsters; w.props = cached.props; w.drops = cached.drops; w.graves = cached.graves; w.obstacles = cached.obstacles; }\n  else {\n    w.zone = generateZone(w.root, zoneId);\n    w.monsters = []; w.props = []; w.drops = []; w.graves = []; w.obstacles = [];\n    w.zone.explored = new Uint8Array(w.zone.w * w.zone.h);\n    w.zone.seedRng = w.root.fork(`pop:${zoneId}`);\n    hooks?.populate?.(w, w.zone);\n  }\n  const rebuildNav = w.zone.nav;\n  w.navs = [0, 1, 2, 3].map(() => { const n = new NavGrid(rebuildNav.width, rebuildNav.height, { origin: [0, 0, 0] }); n.open.set(rebuildNav.open); return n; });\n  const spot = at ?? w.zone.entrance;\n  placeParty(w, spot.x, spot.z);\n  emit(w, { t: 'zone', id: zoneId, x: spot.x, z: spot.z });\n  hooks?.entered?.(w, w.zone, !cached);\n}\n\nexport function placeParty(w, x, z) {\n  w.heroes.forEach((h, i) => {\n    const a = (i / Math.max(1, w.heroes.length)) * Math.PI * 2;\n    const r = w.heroes.length > 1 ? 1.2 : 0;\n    const p = findOpenNear(w, x + Math.cos(a) * r, z + Math.sin(a) * r);\n    h.x = p.x; h.z = p.z; h.px = h.x; h.pz = h.z; h.moveDash = null; h.leapT = 0;\n  });\n  for (const a of w.allies) { a.x = x; a.z = z; a.px = x; a.pz = z; }\n}\n\nexport function walkable(w, x, z) { return w.zone.nav.walkable(x, z); }\nexport function findOpenNear(w, x, z, maxR = 8) {\n  if (walkable(w, x, z)) return { x, z };\n  for (let r = 1; r <= maxR; r++) for (let i = 0; i < 12; i++) {\n    const a = (i / 12) * Math.PI * 2; const nx = x + Math.cos(a) * r; const nz = z + Math.sin(a) * r;\n    if (walkable(w, nx, nz)) return { x: nx, z: nz };\n  }\n  return { x: w.zone.entrance.x, z: w.zone.entrance.z };\n}\n// Moves a circle through the grid with sliding. Returns true if it hit a wall.\nexport function moveCircle(w, e, dx, dz, r = 0.35) {\n  const nav = w.zone.nav; let hit = false;\n  const clear = (x, z) => nav.walkable(x - r, z - r) && nav.walkable(x + r, z - r) && nav.walkable(x - r, z + r) && nav.walkable(x + r, z + r);\n  if (dx !== 0) { if (clear(e.x + dx, e.z)) e.x += dx; else hit = true; }\n  if (dz !== 0) { if (clear(e.x, e.z + dz)) e.z += dz; else hit = true; }\n  if (w.arena?.box) { const b = w.arena.box; e.x = Math.max(b.x0 + r, Math.min(b.x1 - r, e.x)); e.z = Math.max(b.z0 + r, Math.min(b.z1 - r, e.z)); }\n  for (const o of w.obstacles) { const ox = e.x - o.x; const oz = e.z - o.z; const d = Math.hypot(ox, oz); const m = o.r + r; if (d < m && d > 0.001) { e.x = o.x + (ox / d) * m; e.z = o.z + (oz / d) * m; } }\n  return hit;\n}\n\nexport function livingHeroes(w) { return w.heroes.filter((h) => !h.dead && !h.left); }\nexport function nearestHero(w, x, z, maxR = Infinity, visibleOnly = true) {\n  let best = null; let bd = maxR * maxR;\n  for (const h of w.heroes) {\n    if (h.dead || h.left || (visibleOnly && (h.unseen > 0 || (w.cheats.invisible && !h.isPyx)))) continue;\n    const dx = h.x - x; const dz = h.z - z; const d = dx * dx + dz * dz;\n    if (d < bd) { bd = d; best = h; }\n  }\n  return best;\n}\nexport const addXpHook = null;\n\nexport { F, ZONES, recalc };\nEOF\ncat > src/sim/hero.js <<'EOF'\n// Heroes: creation, level and XP, intents to movement, casting, dodge, potion, death, revive.\nimport { CLASSES, SKILLS, toneUnlockLevel } from '../data/classes.js';\nimport { DEVOTION_TRACKS, devotionCost, LEGENDARY } from '../data/items.js';\nimport { F, LEVEL_CAP, SLOT_LEVELS, VOW_LEVELS } from '../data/tuning.js';\nimport { makeItem } from './loot.js';\nimport { recalc } from './stats.js';\nimport { DT, after, emit, findOpenNear, moveCircle, near } from './world.js';\nimport { effectiveSkill, runOps, spawnFloating, softTarget } from './effects.js';\n\nexport function makeHero(w, { seat = 0, cls = 'bellwarden', name = 'THE LATE', level = 1, isBot = false } = {}) {\n  const h = {\n    id: w.nextId++, seat, cls, name, level, xp: 0, x: 0, z: 0, px: 0, pz: 0, facing: 0, hp: 1, res: 0, isBot,\n    gear: {}, inv: [], gold: 0, mats: { scrap: 0, dust: 0, shards: 0, keys: 0 }, gems: {}, reliquary: { weapon: null, armour: null, jewel: null },\n    slots: [{ skill: null, tone: null }, { skill: null, tone: null }, { skill: null, tone: null }, { skill: null, tone: null }, { skill: null, tone: null }, { skill: null, tone: null }],\n    vows: [], cds: {}, charges: {}, potionCd: 0, dodgeCd: 0, state: 'idle', stateT: 0, cast: null, castSeq: 0, buffs: [], shield: 0, combo: 0, comboT: 0,\n    moving: false, dead: false, deadT: 0, deaths: 0, recentDeaths: 0, kills: 0, damage: 0, revives: 0, goldEarned: 0, eliteKills: 0, stunT: 0, rootT: 0, inv_T: 0, invulnerable: 0, unseen: 0,\n    lastHit: -99, outCombat: 0, clamorHold: 0, plateN: 0, plateT: 0, batonN: 0, swatN: 0, clemencyT: 12, lastLight: 0, thrice: 0, bellT: 0, reviveT: 0, reviving: null, interactT: 0, heldPrev: {}, swap: {}, stuckT: 0, levelPicks: [], newest: null, savedNewest: null, slowT: 0, slowV: 0,\n  };\n  recalc(h, w.tuning, null);\n  h.hp = h.stats.maxHp;\n  return h;\n}\n\nexport const slotOpen = (h, i) => h.level >= SLOT_LEVELS[i];\nexport const skillUnlocked = (h, id) => h.level >= SKILLS[id].level;\nexport const toneUnlocked = (h, skill, i) => h.level >= toneUnlockLevel(skill, i);\nexport const vowSlots = (h) => VOW_LEVELS.filter((L) => h.level >= L).length;\n\nexport function refresh(w, h) { recalc(h, w.tuning, w.devotion?.spent); }\nexport const hasBuff = (h, id) => h.buffs.find((b) => b.id === id);\nexport function addBuff(w, h, b) { const old = h.buffs.find((x) => x.id === b.id); if (old) Object.assign(old, b); else h.buffs.push({ ...b }); emit(w, { t: 'buff', id: h.id, buff: b.id, dur: b.dur }); }\n\nexport function starterGear(w, h, ilvl = 1) {\n  h.gear.main = makeItem(w.rngs.loot, { slot: 'main', rarity: 'common', ilvl, cls: h.cls, weaponId: CLASSES[h.cls].starterWeapon });\n  if (h.cls === 'bellwarden') h.gear.main.dps = Math.round(h.gear.main.dps * 1.05 * 10) / 10;\n  refresh(w, h); h.hp = h.stats.maxHp;\n}\nexport function autoAssignSkills(h) {\n  // Fills open slots with the earliest skills the hero has, keeping what's there.\n  const have = new Set(h.slots.map((s) => s.skill).filter(Boolean));\n  const list = CLASSES[h.cls].skills.filter((s) => skillUnlocked(h, s.id));\n  for (let i = 0; i < 6; i++) if (slotOpen(h, i) && !h.slots[i].skill) { const s = list.find((x) => !have.has(x.id)); if (s) { h.slots[i].skill = s.id; have.add(s.id); } }\n}\n\nexport function grantXp(w, h, amount) {\n  if (h.isPyx) return;\n  amount = amount * w.tuning.xp * w.diff.xp;\n  if (h.level >= LEVEL_CAP) {\n    const d = w.devotion; d.xp += amount;\n    while (d.xp >= devotionCost(d.level)) { d.xp -= devotionCost(d.level); d.level++; emit(w, { t: 'toast', seat: h.seat, text: 'DEVOTION RISES. A POINT TO SPEND.', color: 'sky' }); emit(w, { t: 'sfx', id: 'bell_small' }); }\n    return;\n  }\n  h.xp += amount;\n  while (h.level < LEVEL_CAP && h.xp >= F.xpToNext(h.level)) { h.xp -= F.xpToNext(h.level); levelUp(w, h); }\n}\nexport function levelUp(w, h) {\n  h.level++;\n  refresh(w, h);\n  h.hp = h.stats.maxHp;\n  if (!w.round) autoSlotNew(w, h);\n  w.hooks?.levelUp?.(w, h);\n  emit(w, { t: 'level', id: h.id, seat: h.seat, level: h.level, x: h.x, z: h.z });\n}\nfunction autoSlotNew(w, h) {\n  const newly = CLASSES[h.cls].skills.find((s) => s.level === h.level);\n  if (newly) {\n    emit(w, { t: 'toast', seat: h.seat, text: `NEW SKILL: ${newly.name}`, color: 'sand', prompt: 'skills' });\n    const empty = h.slots.findIndex((s, i) => !s.skill && slotOpen(h, i));\n    if (empty >= 0) h.slots[empty].skill = newly.id;\n  }\n  const sOpen = SLOT_LEVELS.indexOf(h.level);\n  if (sOpen >= 2) { autoAssignSkills(h); emit(w, { t: 'toast', seat: h.seat, text: 'A NEW SKILL SLOT OPENS.', color: 'sand', prompt: 'skills' }); }\n  for (const s of CLASSES[h.cls].skills) for (let i = 0; i < 3; i++) if (toneUnlockLevel(s, i) === h.level && s.level <= h.level) { emit(w, { t: 'toast', seat: h.seat, text: `NEW TONE: ${Object.values(s.tones)[i].name}`, color: 'sky', prompt: 'skills' }); break; }\n  if (VOW_LEVELS.includes(h.level)) emit(w, { t: 'toast', seat: h.seat, text: 'A VOW MAY BE SWORN.', color: 'plum', prompt: 'skills' });\n}\n\nexport function spendResource(w, h, amt) { if (w.cheats.infRes) return; h.res = Math.max(0, h.res - amt); }\nexport function gainResource(h, amt) { h.res = Math.min(h.stats.maxResource, h.res + amt); }\nexport function healHero(w, h, frac, flat = 0) {\n  if (h.dead) return;\n  const amt = h.stats.maxHp * frac + flat;\n  const before = h.hp;\n  h.hp = Math.min(h.stats.maxHp, h.hp + amt);\n  if (h.hp - before >= 1 && frac >= 0.05) emit(w, { t: 'heal', id: h.id, amt: Math.round(h.hp - before), x: h.x, z: h.z });\n}\n\n// Damage to a hero, with shields, immunity and last-chance powers.\nexport function damageHero(w, h, amt, src = {}) {\n  if (h.dead || h.left || h.invulnerable > 0 || w.cheats.god && !h.isPyx || h.attractGod) return 0;\n  if (src.blindable && src.m?.blindT > 0) { emit(w, { t: 'miss', x: h.x, z: h.z }); return 0; }\n  let dr = h.stats.dr / 100;\n  for (const f of w.fields) if (f.ally?.dr && near(h, f.x, f.z, f.r)) dr = 1 - (1 - dr) * (1 - f.ally.dr);\n  const reduction = src.pure ? 0 : F.reduction(h.stats.armour, src.level ?? h.level);\n  let dealt = amt * (1 - reduction) * (1 - dr);\n  if (h.shield > 0) { const take = Math.min(h.shield, dealt); h.shield -= take; dealt -= take; }\n  if (dealt <= 0) return 0;\n  h.hp -= dealt;\n  h.lastHit = w.time; h.outCombat = 0;\n  emit(w, { t: 'hurt', id: h.id, amt: Math.round(dealt), x: h.x, z: h.z, big: dealt > h.stats.maxHp * 0.2 });\n  if (h.channel) { h.channel = null; }\n  if (h.reviving) h.reviving = null;\n  if (h.hp <= 0) {\n    if (h.powers.has('thrice_buried') && w.time > h.thrice) { h.thrice = w.time + 90; h.hp = h.stats.maxHp * 0.3; emit(w, { t: 'vfx', kind: 'ring_grave', x: h.x, z: h.z, r: 3 }); emit(w, { t: 'toast', seat: h.seat, text: 'ONE LEARNS TO KEEP A SPADE IN THE COFFIN.', color: 'orange' }); return dealt; }\n    if (h.vows.includes('last_light') && w.time > h.lastLight) { h.lastLight = w.time + 90; h.hp = h.stats.maxHp * 0.25; h.invulnerable = 1; emit(w, { t: 'vfx', kind: 'ring_fire', x: h.x, z: h.z, r: 3 }); emit(w, { t: 'toast', seat: h.seat, text: 'THE LAST LIGHT HOLDS.', color: 'sand' }); return dealt; }\n    killHero(w, h, src);\n  }\n  return dealt;\n}\nexport function killHero(w, h, src = {}) {\n  h.hp = 0; h.dead = true; h.deadT = 0; h.deaths++; h.recentDeaths++; h.state = 'dead'; h.cast = null; h.moveDash = null; h.channel = null;\n  h.respawnWait = w.round ? 8 : Math.min(30, 5 + 5 * (h.recentDeaths - 1));\n  emit(w, { t: 'herodeath', id: h.id, seat: h.seat, x: h.x, z: h.z, by: src.name ?? '' });\n  w.hooks?.heroDied?.(w, h);\n}\nexport function reviveHero(w, h, at = null, frac = 0.6) {\n  h.dead = false; h.hp = h.stats.maxHp * frac; h.state = 'idle'; h.invulnerable = 2; h.deadT = 0;\n  if (at) { const p = findOpenNear(w, at.x, at.z); h.x = p.x; h.z = p.z; h.px = h.x; h.pz = h.z; }\n  h.res = Math.max(h.res, 0);\n  emit(w, { t: 'revive', id: h.id, x: h.x, z: h.z });\n}\n\nconst SKILL_KEYS = ['s0', 's1', 's2', 's3', 's4', 's5'];\n\n// Bursts of a skill: charges for \"Double\" and \"Deep\" Tones.\nfunction cdLeft(w, h, skillId) { return Math.max(0, (h.cds[skillId] ?? 0) - w.time); }\nexport function skillReadyFrac(w, h, sk) {\n  const left = cdLeft(w, h, sk.id);\n  return sk.cd ? left / sk.cd : 0;\n}\n\nexport function tryCast(w, h, slot, intent) {\n  const def = h.slots[slot]; if (!def?.skill || !slotOpen(h, slot)) return false;\n  const swapT = h.swap?.[slot] ?? 0; if (swapT > w.time) return false;\n  const sk = effectiveSkill(h, def.skill, def.tone);\n  const free = h.powers.has('choirmaster') && h.batonN >= 5;\n  const cost = free ? 0 : (sk.cost ?? 0) * (1 - Math.min(60, h.stats.costRed) / 100);\n  const noCd = w.cheats.noCd || w.tuning.cooldown === 0;\n  const cds = sk.charges ? (h.charges[sk.id] ?? sk.charges) <= 0 : cdLeft(w, h, sk.id) > 0;\n  if (cds && !noCd) return false;\n  if (h.res < cost && !w.cheats.infRes) { if (intent.pressed?.[SKILL_KEYS[slot]]) emit(w, { t: 'nores', id: h.id, seat: h.seat, slot, res: CLASSES[h.cls].resource }); return false; }\n  spendResource(w, h, cost);\n  const spd = 1 + Math.min(100, h.stats.atkSpd) / 100;\n  const wind = (sk.wind ?? 0.15) / spd; const rec = (sk.rec ?? 0.2) / spd;\n  let ax = intent.aimX ?? Math.sin(h.facing); let az = intent.aimZ ?? Math.cos(h.facing);\n  const lock = softTarget(w, h, sk, intent);\n  let tx = intent.tx; let tz = intent.tz;\n  if (lock && !intent.hardAim) { const dx = lock.x - h.x; const dz = lock.z - h.z; const d = Math.hypot(dx, dz) || 1; ax = dx / d; az = dz / d; if (tx === undefined) { tx = lock.x; tz = lock.z; } if ((sk.fx[0].op === 'arc') && d > 1 && d < 3.4) { moveCircle(w, h, ax * Math.min(0.6, d - 1), az * Math.min(0.6, d - 1)); } }\n  if (tx === undefined) { const r = sk.range ?? 6; tx = h.x + ax * r; tz = h.z + az * r; }\n  h.facing = Math.atan2(ax, az);\n  let clip = sk.clip;\n  if (Array.isArray(clip)) { clip = clip[h.combo % clip.length]; h.combo++; h.comboT = 1.2; }\n  h.state = 'cast'; h.stateT = 0; h.castSeq++;\n  h.cast = { sk, wind, rec, fired: false, ax, az, tx, tz, slot, free, moving: !!sk.moving };\n  if (sk.cd) {\n    if (sk.charges) { h.charges[sk.id] = (h.charges[sk.id] ?? sk.charges) - 1; after(w, sk.cd * w.tuning.cooldown * (1 - Math.min(50, h.stats.cdr) / 100), () => { h.charges[sk.id] = Math.min(sk.charges, (h.charges[sk.id] ?? 0) + 1); }); }\n    h.cds[sk.id] = w.time + sk.cd * w.tuning.cooldown * (1 - Math.min(50, h.stats.cdr) / 100);\n  }\n  emit(w, { t: 'cast', id: h.id, seat: h.seat, skill: sk.id, clip, upper: !!sk.upper, dur: wind + rec, ax, az, tx, tz, vfx: sk.vfx, sfx: sk.sfx, element: sk.element });\n  return true;\n}\n\nfunction fireCast(w, h) {\n  const c = h.cast; const sk = c.sk;\n  c.fired = true;\n  const mult = c.free ? 2 : 1;\n  if (h.powers.has('choirmaster')) h.batonN = c.free ? 0 : h.batonN + 1;\n  if (sk.gen) gainResource(h, sk.gen);\n  const ctx = { src: h, hero: h, x: h.x, z: h.z, ox: h.x, oz: h.z, ax: c.ax, az: c.az, tx: c.tx, tz: c.tz, sk, mult, kills: 0, targets: 0 };\n  runOps(w, ctx, sk.fx);\n  h.used = h.used ?? {}; h.used[sk.id] = (h.used[sk.id] ?? 0) + 1;\n  if (h.powers.has('first_digger') && sk.id === 'shovel_swat') { h.swatN++; if (h.swatN % 5 === 0) w.graves.push({ id: w.nextId++, x: h.x + c.ax * 1.5, z: h.z + c.az * 1.5, t: 12 }); }\n  if (h.setBonus.ringing_order4 && sk.tags?.includes('toll')) h.cds.bellfall = Math.max(w.time, (h.cds.bellfall ?? 0) - 2);\n}\n\nexport function startDodge(w, h, intent) {\n  if (h.dodgeCd > 0 && !w.cheats.noCd) return false;\n  if (h.state === 'dead' || h.stunT > 0) return false;\n  let ax = intent.moveX; let az = intent.moveZ;\n  if (Math.hypot(ax, az) < 0.2) { ax = Math.sin(h.facing); az = Math.cos(h.facing); }\n  const d = Math.hypot(ax, az) || 1; ax /= d; az /= d;\n  h.state = 'dodge'; h.stateT = 0; h.cast = null; h.moveDash = { vx: (ax * 4.5) / 0.35, vz: (az * 4.5) / 0.35, t: 0.35, inv: true };\n  h.facing = Math.atan2(ax, az); h.dodgeCd = w.tuning.dodgeCd; h.castSeq++; h.dodges = (h.dodges ?? 0) + 1;\n  emit(w, { t: 'cast', id: h.id, seat: h.seat, clip: 'Roll', dur: 0.35, sfx: 'dodge', dodge: true });\n  emit(w, { t: 'tutorial', seat: h.seat, id: 'dodge' });\n  return true;\n}\nexport function usePotion(w, h) {\n  if (h.potionCd > 0 || h.dead) return false;\n  h.potionCd = w.tuning.potionCd; h.potions = (h.potions ?? 0) + 1;\n  healHero(w, h, 0.6);\n  emit(w, { t: 'potion', id: h.id, x: h.x, z: h.z });\n  emit(w, { t: 'tutorial', seat: h.seat, id: 'potion' });\n  return true;\n}\n\n// One hero, one step.\nexport function stepHero(w, h, intent) {\n  h.px = h.x; h.pz = h.z;\n  if (h.left) return;\n  const s = h.stats; const dt = DT;\n  h.potionCd = Math.max(0, h.potionCd - dt); h.dodgeCd = Math.max(0, h.dodgeCd - dt); h.invulnerable = Math.max(0, h.invulnerable - dt); h.unseen = Math.max(0, h.unseen - dt);\n  h.comboT -= dt; if (h.comboT <= 0) h.combo = 0;\n  h.outCombat += dt;\n  stepBuffs(w, h);\n  if (h.dead) { h.deadT += dt; intent.pressed = {}; w.hooks?.deadStep?.(w, h, intent); return; }\n  // Resource.\n  const regenMul = w.tuning.resource;\n  if (h.cls === 'lamplighter') { let bonus = 1; for (const f of w.fields) if (f.ally?.wick && near(h, f.x, f.z, f.r)) bonus += f.ally.wick; gainResource(h, 14 * dt * regenMul * bonus); }\n  if (h.cls === 'bellwarden') { if (h.outCombat > 4 && h.clamorHold <= 0) h.res = Math.max(0, h.res - 8 * dt); h.clamorHold -= dt; }\n  if (w.cheats.infRes) h.res = s.maxResource;\n  if (s.regen > 0) h.hp = Math.min(s.maxHp, h.hp + s.regen * dt);\n  if (h.powers.has('clemency_shard')) { h.clemencyT -= dt; if (h.clemencyT <= 0) { h.clemencyT = 12; runOps(w, { src: h, hero: h, x: h.x, z: h.z, ox: h.x, oz: h.z, ax: 0, az: 1, tx: h.x, tz: h.z, sk: { id: 'clemency', element: 'sound' }, mult: 1 }, [{ op: 'ring', radius: 6, dmg: 3, vfx: 'ring_bronze', sfx: 'bell_small', shake: 0.15 }]); } }\n  h.stunT = Math.max(0, h.stunT - dt); h.rootT = Math.max(0, h.rootT - dt); h.slowT = Math.max(0, h.slowT - dt);\n  if (h.stunT > 0) return;\n\n  const pressed = intent.pressed ?? {}; const held = intent.held ?? {};\n  // Dodge cancels anything.\n  if (pressed.dodge && h.state !== 'dodge') startDodge(w, h, intent);\n  if (pressed.potion) usePotion(w, h);\n  // Dash or dodge in motion.\n  if (h.moveDash) {\n    const m = h.moveDash; m.t -= dt;\n    if (m.inv) h.invulnerable = Math.max(h.invulnerable, 0.02);\n    const noClip = m.noClip;\n    if (noClip) { h.x += m.vx * dt; h.z += m.vz * dt; } else moveCircle(w, h, m.vx * dt, m.vz * dt);\n    m.step?.(w, h);\n    if (m.t <= 0) { h.moveDash = null; if (noClip) { const p = findOpenNear(w, h.x, h.z); h.x = p.x; h.z = p.z; } m.end?.(w, h); if (h.state === 'dodge') { h.state = 'idle'; } }\n    if (h.state === 'dodge') return;\n  }\n  // Skills.\n  if (h.cast) {\n    const c = h.cast; h.stateT += dt;\n    if (!c.fired && h.stateT >= c.wind) fireCast(w, h);\n    const total = c.wind + c.rec;\n    if (c.fired && h.stateT >= total) { h.cast = null; h.state = 'idle'; }\n    else if (c.fired && h.stateT >= c.wind + c.rec / 2 && Math.hypot(intent.moveX, intent.moveZ) > 0.2) { h.cast = null; h.state = 'idle'; }\n  }\n  if (!h.cast && h.state !== 'dodge') {\n    for (let i = 0; i < 6; i++) if ((pressed[SKILL_KEYS[i]] || held[SKILL_KEYS[i]]) && tryCast(w, h, i, intent)) break;\n  }\n  // Channels: Passing Bell, rope, revive. A hit interrupts (see damageHero).\n  if (h.channel) {\n    h.channel.t += dt;\n    if (h.channel.t >= h.channel.dur) { const c = h.channel; h.channel = null; c.done(w, h); }\n    else if (Math.hypot(intent.moveX, intent.moveZ) > 0.5 || (c_isReleased(h.channel, held))) { h.channel = null; }\n  }\n  // Movement.\n  const mag = Math.hypot(intent.moveX, intent.moveZ);\n  const canMove = !h.channel && h.rootT <= 0 && (!h.cast || h.cast.moving || h.cast.fired && h.cast.moving);\n  h.moving = false;\n  if (canMove && mag > 0.15 && !h.buffRoot) {\n    const k = Math.min(1, mag);\n    let sp = s.speed * k;\n    for (const b of h.buffs) { if (b.speed) sp *= 1 + b.speed; if (b.slow) sp *= 1 - b.slow; }\n    if (h.slowT > 0) sp *= 1 - h.slowV;\n    const nx = intent.moveX / mag; const nz = intent.moveZ / mag;\n    const bx = h.x; const bz = h.z;\n    if (w.cheats.noClip) { h.x = Math.max(1, Math.min(w.zone.w - 1, h.x + nx * sp * dt)); h.z = Math.max(1, Math.min(w.zone.h - 1, h.z + nz * sp * dt)); }\n    else moveCircle(w, h, nx * sp * dt, nz * sp * dt);\n    h.moving = true; h.speedNow = sp;\n    if (!h.cast && !intent.hardAim) h.facing = Math.atan2(nx, nz);\n    if (Math.hypot(h.x - bx, h.z - bz) < sp * dt * 0.25) h.stuckT += dt; else h.stuckT = 0;\n    h.walked = (h.walked ?? 0) + Math.hypot(h.x - bx, h.z - bz);\n  } else h.stuckT = 0;\n  if (intent.hardAim && !h.cast && h.state !== 'dodge') { const a = Math.atan2(intent.aimX ?? 0, intent.aimZ ?? 1); h.facing = a; }\n  // Soft body push from monsters; stuck heroes pass through small ones.\n  if (h.stuckT < 0.3 && !w.cheats.noClip) {\n    for (const m of w.active) {\n      if (m.dead || m.static || m.defn.hover) continue;\n      const dx = h.x - m.x; const dz = h.z - m.z; const rr = m.r + 0.4;\n      const d2 = dx * dx + dz * dz;\n      if (d2 < rr * rr && d2 > 1e-4) {\n        const d = Math.sqrt(d2); const push = (rr - d) * 0.25;\n        moveCircle(w, h, (dx / d) * push, (dz / d) * push);\n      }\n    }\n  }\n}\nfunction c_isReleased(ch, held) { return ch.hold && !held[ch.hold]; }\n\nfunction stepBuffs(w, h) {\n  h.buffRoot = false;\n  for (let i = h.buffs.length - 1; i >= 0; i--) {\n    const b = h.buffs[i]; b.dur -= DT;\n    if (b.spin) {\n      b.spinT = (b.spinT ?? 0) - DT;\n      if (b.spinT <= 0) {\n        b.spinT = b.spin.every;\n        const ctx = { src: h, hero: h, x: h.x, z: h.z, ox: h.x, oz: h.z, ax: Math.sin(h.facing), az: Math.cos(h.facing), tx: h.x, tz: h.z, sk: { id: 'last_peal', element: 'sound' }, mult: 1, buff: b };\n        runOps(w, ctx, [{ op: 'circle', radius: b.spin.radius, dmg: b.spin.dmg, pull: b.spin.pull, killExtend: b.spin.killExtend, vfx: 'ring_chain', sfx: 'hit_bell' }]);\n        h.castSeq++;\n      }\n    }\n    if (b.unseen) h.unseen = Math.max(h.unseen, 0.1);\n    if (b.shield !== undefined && b.dur <= 0) h.shield = 0;\n    if (b.dur <= 0) { h.buffs.splice(i, 1); emit(w, { t: 'buffend', id: h.id, buff: b.id }); }\n  }\n}\n\nexport function damageBonus(w, h, target) {\n  // Multiplicative pile of everything a hero's hit can gain.\n  let k = 1 + h.stats.dmgPct / 100;\n  for (const b of h.buffs) { if (b.dmg) k *= 1 + b.dmg; }\n  for (const f of w.fields) if (f.ally?.dmg && near(h, f.x, f.z, f.r)) k *= 1 + f.ally.dmg;\n  if (h.vows.includes('contrition') && h.hp < h.stats.maxHp / 2) k *= 1.15;\n  if (h.powers.has('plate_lining') && h.plateT > w.time) k *= 1 + Math.min(30, h.plateN) / 100;\n  if (h.powers.has('mourning_band')) { const n = w.allies.filter((a) => a.owner === h.id && a.minion && !a.dead).length + w.heroes.filter((o) => o.dead && o !== h).length; k *= 1 + Math.min(0.3, n * 0.05); }\n  if (h.powers.has('malisons_knuckle') && target?.elite) k *= 1.25;\n  return k;\n}\nexport const hasLegendary = (h, id) => h.powers.has(id) && !!LEGENDARY[id];\nexport const devotionPointsFree = (w) => w.devotion.level + (w.devotion.bonus ?? 0) - Object.values(w.devotion.spent).reduce((a, b) => a + b, 0);\nexport const DEVOTION_IDS = Object.keys(DEVOTION_TRACKS);\nexport { spawnFloating };\nEOF\ncat > src/sim/effects.js <<'EOF'\n// The effect ops. Skills and Tones only compose these; nothing here knows a skill by name except powers.\nimport { SKILLS, CLASSES } from '../data/classes.js';\nimport { F } from '../data/tuning.js';\nimport { DT, after, emit, findOpenNear, moveCircle, near, walkable } from './world.js';\nimport { damageBonus, gainResource, healHero, addBuff } from './hero.js';\nimport { killMonster, stunMonster } from './monsters.js';\n\nconst clone = (o) => JSON.parse(JSON.stringify(o));\nconst setPath = (obj, path, v) => { const parts = path.split('.'); let o = obj; for (let i = 0; i < parts.length - 1; i++) { o = o[parts[i]] ?? (o[parts[i]] = {}); } o[parts.at(-1)] = v; };\n\n// Skill + Tone + legendary powers = the concrete skill this cast uses. Cached by the hero's loadout key.\nexport function effectiveSkill(h, skillId, toneId) {\n  const key = `${skillId}|${toneId ?? ''}|${[...h.powers].join(',')}|${Object.keys(h.setBonus).join(',')}`;\n  h._skillCache ??= new Map();\n  const hit = h._skillCache.get(key); if (hit) return hit;\n  const base = SKILLS[skillId];\n  const sk = { ...base, fx: clone(base.fx), tones: undefined };\n  const t = toneId ? base.tones[toneId] : null;\n  if (t) {\n    if (t.fxAll) sk.fx = clone(t.fxAll);\n    if (t.set) Object.assign(sk.fx[0], clone(t.set));\n    if (t.patch) for (const p of t.patch) setPath(sk.fx[0], p.path, p.v);\n    if (t.add) sk.fx.push(...clone(t.add));\n    if (t.addThen) sk.fx[0].then.push(...clone(t.addThen));\n    if (t.cd !== undefined) sk.cd = t.cd;\n    if (t.wind !== undefined) sk.wind = t.wind;\n    if (t.charges) sk.charges = t.charges;\n  }\n  // Legendary powers change how skills work, not only the numbers.\n  const P = h.powers;\n  if (P.has('widows_clapper') && skillId === 'great_toll') for (const dl of [0.4, 0.8]) sk.fx.push({ op: 'delay', t: dl, then: [{ op: 'ring', radius: 6, dmg: sk.fx[0].dmg * 0.5, vfx: 'ring_bronze', sfx: 'bell_small', shake: 0.15 }] });\n  if (P.has('anvil') && skillId === 'clapper_charge') sk.fx[0].drag = true;\n  if (P.has('hymnal_greaves') && skillId === 'chain_reap') sk.fx[0].homingNote = true;\n  if (P.has('last_wick') && skillId === 'spark_bolt') sk.fx[0].wickSplit = true;\n  if (P.has('patient_moth') && skillId === 'lantern_hurl') for (const op of sk.fx) for (const th of op.then ?? []) if (th.op === 'zone') th.pull = 2;\n  if (P.has('snuffer_mitts') && skillId === 'snuff') sk.fx[0].mitts = true;\n  if (P.has('cinderwalk') && skillId === 'dusk_step') sk.fx.push({ op: 'trail', dur: 3, dmg: 0.6, element: 'flame', radius: 1.2, steps: 6, fromOrigin: true });\n  if (P.has('second_crook') && skillId === 'raise_pallbearers') { sk.fx[0].slam = true; sk.fx[0].hpMul = 1.5; sk.fx[0].dmg = (sk.fx[0].dmg ?? 0.6) * 1.3; sk.fx[0].crook = true; }\n  if (P.has('ledger_graves') && skillId === 'exhume') { sk.fx[0].max = 99; sk.fx[0].tithe = 1; }\n  if (P.has('family_deed') && skillId === 'coffin_drop') { const main = sk.fx[0]; main.count = (main.count ?? 1) + 3; main.spread = main.spread ?? 3; }\n  const sb = h.setBonus;\n  if (sb.ringing_order4 && base.tags?.includes('toll')) for (const op of sk.fx) { if (op.dmg) op.dmg += 3; for (const th of op.then ?? []) if (th.dmg) th.dmg += 3; }\n  if (sb.perpetual_mourner4 && skillId === 'exhume') { sk.fx[0].dmg += 4; sk.fx[0].healMinions = true; }\n  if (sb.last_lamplighter4 && skillId === 'lamp_post') { sk.fx[0].setBolt = true; sk.fx[0].dmg += 4; }\n  if (sb.perpetual_mourner2 && skillId === 'raise_pallbearers') sk.fx[0].max = (sk.fx[0].max ?? 4) + 2;\n  if (h.vows.includes('union_rates') && skillId === 'raise_pallbearers') sk.fx[0].max = (sk.fx[0].max ?? 4) + 1;\n  if (h.vows.includes('keeper_of_lamps') && skillId === 'lamp_post') sk.fx[0].max = (sk.fx[0].max ?? 3) + 1;\n  h._skillCache.set(key, sk);\n  return sk;\n}\n\n// The best monster inside a 120 degree cone of facing and the skill's range.\nexport function softTarget(w, h, sk, intent) {\n  if (intent.hardAim) return null;\n  const range = sk?.range ?? rangeOf(sk) ?? 8;\n  let best = null; let bs = Infinity;\n  const fx = intent.aimX ?? Math.sin(h.facing); const fz = intent.aimZ ?? Math.cos(h.facing);\n  for (const m of w.active) {\n    if (m.dead || m.untargetable) continue;\n    const dx = m.x - h.x; const dz = m.z - h.z; const d = Math.hypot(dx, dz);\n    if (d > range + m.r) continue;\n    const dot = d > 0.01 ? (dx * fx + dz * fz) / d : 1;\n    if (dot < 0.5) continue;\n    const s = d - dot * 3 - (m.elite ? 1 : 0) - (m.defn.boss ? 2 : 0);\n    if (s < bs) { bs = s; best = m; }\n  }\n  return best;\n}\nconst rangeOf = (sk) => { const o = sk?.fx?.[0]; if (!o) return 8; return o.range ?? o.radius ?? o.dist ?? 8; };\n\nconst ELEMENT_STAT = { sound: 'soundPct', flame: 'flamePct', grave: 'gravePct' };\n\n// hero hit on monster: the one formula, with hooks.\nexport function heroHit(w, c, m, pct, op = {}) {\n  const h = c.hero; if (!h || m.dead || m.invulnerable) return 0;\n  const s = h.stats; const element = op.element ?? c.sk?.element ?? 'phys';\n  const rng = w.rngs.combat;\n  let crit = s.crit;\n  if (h.vows.includes('bright_eyes') && m.status.burn) crit += 10;\n  const isCrit = rng.chance(Math.min(100, crit) / 100);\n  let dmg = s.weaponDps * pct * (c.mult ?? 1) * (1 + s.power / 100) * (1 + (s[ELEMENT_STAT[element]] ?? 0) / 100) * damageBonus(w, h, m) * w.tuning.playerDamage;\n  if (isCrit) dmg *= 1.5 + s.critDmg / 100;\n  // Class passives.\n  if (m.status.burn && h.cls === 'lamplighter') dmg *= 1.15;\n  if (m.status.curse) dmg *= 1 + m.status.curse.v;\n  if (m.status.mark) dmg *= 1.2;\n  const veil = h.buffs.find((b) => b.nextHit); if (veil) { dmg *= 1 + veil.nextHit; veil.nextHit = 0; veil.dur = 0; h.unseen = 0; }\n  if (op.consume === 'resonance' && m.resonance > 0) { dmg *= 1 + 0.25 * m.resonance; if (c.hero.cls === 'bellwarden') { m.resonance = 0; m.resT = 0; emit(w, { t: 'mstack', id: m.id, n: 0 }); } }\n  if (w.cheats.oneHit) dmg = m.hp + 1;\n  dmg = Math.round(dmg);\n  m.hp -= dmg;\n  m.flash = 2; m.lastHitBy = h.id;\n  h.damage += dmg; h.outCombat = 0;\n  m.woke ||= true;\n  emit(w, { t: 'hit', id: m.id, amt: dmg, crit: isCrit, x: m.x, z: m.z, element, by: h.seat, mat: m.defn.material });\n  if (op.sfx) emit(w, { t: 'sfx', id: op.sfx, x: m.x, z: m.z, rate: 0.15 });\n  // Secondary effects.\n  if (h.cls === 'bellwarden' && !op.noRes) { m.resonance = Math.min(h.resonanceCap, m.resonance + 1); m.resT = 6; emit(w, { t: 'mstack', id: m.id, n: m.resonance }); }\n  if (s.lifePerHit > 0) h.hp = Math.min(s.maxHp, h.hp + s.lifePerHit * 0.2);\n  if (op.heal) healHero(w, h, op.heal);\n  if (op.resPerTarget) gainResource(h, op.resPerTarget);\n  if (c.sk?.genPerTarget) gainResource(h, c.sk.genPerTarget);\n  if (element === 'flame' && h.cls === 'lamplighter' && !op.noBurn) applyStatus(w, m, 'burn', { dps: s.weaponDps * 0.3 * h.burnMul * w.tuning.playerDamage * (1 + s.power / 100), t: 4, by: h.id });\n  if (op.burn) applyStatus(w, m, 'burn', { dps: s.weaponDps * op.burn * h.burnMul * (1 + s.power / 100), t: 4, by: h.id });\n  if (op.bleed) applyStatus(w, m, 'bleed', { dps: s.weaponDps * op.bleed * (1 + s.power / 100), t: 3, by: h.id });\n  if (op.poison) applyStatus(w, m, 'poison', { dps: s.weaponDps * op.poison * (1 + s.power / 100), t: 3, by: h.id });\n  if (op.slow) applyStatus(w, m, 'slow', { v: op.slow, t: 3 });\n  if (op.blind) m.blindT = op.blind;\n  if (op.mark) applyStatus(w, m, 'mark', { t: op.mark });\n  if (op.stun) stunMonster(w, m, op.stun);\n  if (op.root) { m.rootT = op.root; }\n  if (op.knock) knockMonster(w, m, c.ox ?? c.x, c.oz ?? c.z, op.knock);\n  if (op.pull) { const dx = c.x - m.x; const dz = c.z - m.z; const d = Math.hypot(dx, dz) || 1; if (!m.static) moveCircle(w, m, (dx / d) * Math.min(op.pull, d - 0.8), (dz / d) * Math.min(op.pull, d - 0.8), m.r * 0.6); }\n  if (op.homingNote) runOps(w, { ...c, x: m.x, z: m.z, ox: m.x, oz: m.z }, [{ op: 'projectile', speed: 12, range: 10, width: 0.5, dmg: 0.4, homing: 8, look: 'note', noRes: true }]);\n  if (h.powers.has('malisons_knuckle') && m.elite && !op.noChain) { for (const o of w.active) if (o !== m && !o.dead && o.pack === m.pack && o.pack && near(o, m.x, m.z, 10)) { heroHit(w, c, o, pct * 0.3, { noChain: true, noRes: true }); break; } }\n  if (m.hp <= 0) {\n    const overkill = -m.hp / Math.max(1, m.maxHp);\n    if (op.refundKill && c.sk?.cd) h.cds[c.sk.id] -= c.sk.cd * op.refundKill;\n    if (op.killExtend && c.buff) c.buff.dur += op.killExtend;\n    if (op.forkOnKill) for (let i = 0; i < op.forkOnKill; i++) {\n      const a = Math.atan2(c.ax, c.az) + (i ? 0.7 : -0.7);\n      fireProjectile(w, { ...c, x: m.x, z: m.z, ax: Math.sin(a), az: Math.cos(a) }, { speed: 18, range: 8, width: 0.5, dmg: pct * 0.6, look: 'spark', ignore: m.id });\n    }\n    killMonster(w, m, h, { overkill, ax: m.x - (c.ox ?? c.x), az: m.z - (c.oz ?? c.z) });\n  }\n  // Chain jumps.\n  if (op.chain) {\n    let from = m; const seen = new Set([m.id]);\n    for (let i = 0; i < op.chain.count; i++) {\n      let best = null; let bd = op.chain.range;\n      for (const o of w.active) { if (o.dead || seen.has(o.id)) continue; const d = Math.hypot(o.x - from.x, o.z - from.z); if (d < bd) { bd = d; best = o; } }\n      if (!best) break;\n      seen.add(best.id);\n      emit(w, { t: 'arc', x: from.x, z: from.z, x2: best.x, z2: best.z, element });\n      heroHit(w, c, best, pct * op.chain.mult, { noRes: true, element, noChain: true });\n      from = best;\n    }\n  }\n  return dmg;\n}\nexport function knockMonster(w, m, ox, oz, dist0) {\n  if (m.static || m.defn.boss) return;\n  const dx = m.x - ox; const dz = m.z - oz; const d = Math.hypot(dx, dz) || 1;\n  m.knockX = (dx / d) * dist0 * 6; m.knockZ = (dz / d) * dist0 * 6; m.knockT = 1 / 6;\n}\nexport function applyStatus(w, m, id, data) {\n  if (m.dead) return;\n  const old = m.status[id];\n  if (old && id !== 'curse') { old.t = Math.max(old.t, data.t); if (data.dps) old.dps = Math.max(old.dps, data.dps); if (data.v) old.v = Math.max(old.v, data.v); if (data.by) old.by = data.by; return; }\n  m.status[id] = { ...data };\n  emit(w, { t: 'mstatus', id: m.id, status: id, on: true });\n}\n\nconst inCone = (c, m, range, angle) => {\n  const dx = m.x - c.x; const dz = m.z - c.z; const d = Math.hypot(dx, dz);\n  if (d > range + m.r) return false;\n  if (d < m.r + 0.3) return true;\n  return (dx * c.ax + dz * c.az) / d >= Math.cos(((angle / 2) * Math.PI) / 180);\n};\nfunction hitProps(w, c, x, z, r, op) { for (const p of w.props) if (p.hp > 0 && !p.broken && near(p, x, z, r + 0.5)) w.hooks.breakProp(w, p, c.hero, x, z); }\n\nfunction areaBonus(c) { return c.hero ? 1 + (c.hero.stats.area ?? 0) * 0 : 1; }\n\nconst VFX = (w, kind, x, z, r, extra = {}) => emit(w, { t: 'vfx', kind, x, z, r, ...extra });\nfunction commonOpFx(w, c, op, x, z, r) {\n  if (op.vfx) VFX(w, op.vfx, x, z, r, op.op === 'cone' ? { ax: c.ax, az: c.az, angle: op.angle } : {});\n  if (op.sfx && op.op !== 'arc') emit(w, { t: 'sfx', id: op.sfx, x, z });\n  if (op.shake) emit(w, { t: 'shake', v: op.shake });\n  if (op.decal) emit(w, { t: 'decal', kind: op.decal, x, z, r });\n}\n\nconst OPS = {\n  arc(w, c, op) { for (const m of [...w.active]) if (inCone(c, m, op.range, op.angle)) { heroHit(w, c, m, op.dmg, op); c.targets++; } hitProps(w, c, c.x + c.ax * op.range * 0.6, c.z + c.az * op.range * 0.6, op.range * 0.6, op); commonOpFx(w, c, op, c.x, c.z, op.range); },\n  cone(w, c, op) { for (const m of [...w.active]) if (inCone(c, m, op.range, op.angle)) { heroHit(w, c, m, op.dmg, op); c.targets++; } hitProps(w, c, c.x + c.ax * op.range * 0.5, c.z + c.az * op.range * 0.5, op.range * 0.5, op); commonOpFx(w, c, op, c.x, c.z, op.range); },\n  circle(w, c, op) {\n    const at = op.at === 'origin' ? { x: c.ox, z: c.oz } : op.at === 'zoneTarget' ? { x: c.tx, z: c.tz } : { x: c.x, z: c.z };\n    for (const m of [...w.active]) if (near(m, at.x, at.z, op.radius + m.r)) { heroHit(w, { ...c, x: at.x, z: at.z, ox: at.x, oz: at.z }, m, op.dmg, op); c.targets++; }\n    hitProps(w, c, at.x, at.z, op.radius, op); commonOpFx(w, c, op, at.x, at.z, op.radius);\n  },\n  ring(w, c, op) { for (const m of [...w.active]) if (near(m, c.x, c.z, op.radius + m.r)) { heroHit(w, c, m, op.dmg, op); c.targets++; } hitProps(w, c, c.x, c.z, op.radius, op); commonOpFx(w, c, op, c.x, c.z, op.radius); },\n  projectile(w, c, op) {\n    const count = op.wickSplit && c.hero?.res > 70 ? 3 : op.count ?? 1; const spread = ((op.spread ?? (op.wickSplit ? 16 : 0)) * Math.PI) / 180;\n    for (let i = 0; i < count; i++) {\n      const a = Math.atan2(c.ax, c.az) + (count > 1 ? (i - (count - 1) / 2) * spread : 0);\n      fireProjectile(w, { ...c, ax: Math.sin(a), az: Math.cos(a) }, op);\n    }\n  },\n  lob(w, c, op) {\n    const count = op.count ?? 1;\n    for (let i = 0; i < count; i++) {\n      let tx = c.tx; let tz = c.tz;\n      const d = Math.hypot(tx - c.x, tz - c.z); const maxR = op.range ?? 14;\n      if (d > maxR) { tx = c.x + ((tx - c.x) / d) * maxR; tz = c.z + ((tz - c.z) / d) * maxR; }\n      if (i > 0 || count > 1) { const a = (i / count) * Math.PI * 2; tx += Math.cos(a) * (i === 0 ? 0 : op.spread ?? 2.5); tz += Math.sin(a) * (i === 0 ? 0 : op.spread ?? 2.5); }\n      const p = findOpenNear(w, tx, tz); tx = p.x; tz = p.z;\n      const delay = (op.time ?? 0.5) + i * 0.1;\n      emit(w, { t: 'lob', x: c.x, z: c.z, x2: tx, z2: tz, dur: delay, look: op.look ?? 'lantern' });\n      after(w, delay, () => { runOps(w, { ...c, x: tx, z: tz, ox: tx, oz: tz, tx, tz }, op.then ?? []); });\n    }\n  },\n  chain(w, c, op) {\n    let from = { x: c.x, z: c.z }; const seen = new Set();\n    for (let i = 0; i < op.count; i++) {\n      let best = null; let bd = op.range;\n      for (const o of w.active) { if (o.dead || seen.has(o.id)) continue; const d = Math.hypot(o.x - from.x, o.z - from.z); if (d < bd) { bd = d; best = o; } }\n      if (!best) break;\n      seen.add(best.id); emit(w, { t: 'arc', x: from.x, z: from.z, x2: best.x, z2: best.z });\n      heroHit(w, c, best, op.dmg, op); from = best;\n    }\n  },\n  dash(w, c, op) {\n    const h = c.hero; const v = op.dist / op.time; const hitIds = new Set(); const dragged = [];\n    c.ox = h.x; c.oz = h.z;\n    h.moveDash = { vx: c.ax * v, vz: c.az * v, t: op.time, inv: true,\n      step: (w2, he) => {\n        for (const m of [...w2.active]) {\n          if (m.dead || hitIds.has(m.id)) continue;\n          if (near(m, he.x, he.z, op.width + m.r)) { hitIds.add(m.id); heroHit(w2, { ...c, x: he.x, z: he.z, ox: he.x, oz: he.z }, m, op.dmg, { ...op, knock: op.drag ? 0 : op.shove ?? 2 }); if (op.drag && !m.dead && !m.static) dragged.push(m); }\n        }\n        for (const m of dragged) if (!m.dead) moveCircle(w2, m, c.ax * v * DT, c.az * v * DT, m.r * 0.6);\n        hitProps(w2, c, he.x, he.z, op.width, op);\n      } };\n    emit(w, { t: 'shake', v: 0.1 });\n  },\n  leap(w, c, op) {\n    const h = c.hero; let dx = c.tx - h.x; let dz = c.tz - h.z; let d = Math.hypot(dx, dz);\n    const r = op.range ?? 12; if (d > r) { dx *= r / d; dz *= r / d; d = r; }\n    const target = findOpenNear(w, h.x + dx, h.z + dz);\n    const time = op.time ?? 0.45; const vx = (target.x - h.x) / time; const vz = (target.z - h.z) / time;\n    h.moveDash = { vx, vz, t: time, inv: true, noClip: true, end: (w2, he) => { he.x = target.x; he.z = target.z; runOps(w2, { ...c, x: he.x, z: he.z, ox: he.x, oz: he.z }, op.then ?? []); } };\n    h.leapT = time; emit(w, { t: 'leap', id: h.id, dur: time });\n    c.tx = target.x; c.tz = target.z;\n  },\n  blink(w, c, op) {\n    const h = c.hero; const nav = w.zone.nav;\n    const maxD = nav.castWall(h.x, h.z, c.ax, c.az, op.dist);\n    let d = Math.max(0, maxD - 0.5);\n    let nx = h.x + c.ax * d; let nz = h.z + c.az * d;\n    const p = findOpenNear(w, nx, nz); nx = p.x; nz = p.z;\n    VFX(w, 'blink', h.x, h.z, 1); h.x = nx; h.z = nz; h.px = nx; h.pz = nz; VFX(w, 'blink', nx, nz, 1);\n    if (op.inv) h.invulnerable = Math.max(h.invulnerable, op.inv);\n    if (op.bringMinions) for (const a of w.allies) if (a.owner === h.id && a.minion) { a.x = nx + w.rngs.ai.range(-2, 2); a.z = nz + w.rngs.ai.range(-2, 2); const q = findOpenNear(w, a.x, a.z); a.x = q.x; a.z = q.z; }\n    runOps(w, { ...c, x: nx, z: nz }, op.then ?? []);\n  },\n  zone(w, c, op) {\n    const f = { id: w.nextId++, x: op.at === 'origin' ? c.ox : c.tx ?? c.x, z: op.at === 'origin' ? c.oz : c.tz ?? c.z, r: op.radius, t: op.dur, dur: op.dur, tick: op.tick ?? 0.5, tickT: 0, op, c: { ...c }, owner: c.hero?.id, follow: op.follow ? c.hero : null, ally: op.ally, ward: op.ward, look: op.look ?? 'shock', pull: op.pull, slow: op.slow };\n    if (!op.follow && c.sk?.fx?.[0]?.op !== 'zone' && c.tx === undefined) { f.x = c.x; f.z = c.z; }\n    w.fields.push(f);\n    emit(w, { t: 'field', id: f.id, x: f.x, z: f.z, r: f.r, dur: f.dur, look: f.look, follow: f.follow?.id ?? 0 });\n    if (op.onSfx) emit(w, { t: 'sfx', id: op.onSfx, x: f.x, z: f.z });\n  },\n  debuff(w, c, op) { OPS.zone(w, c, { ...op, tick: op.tick ?? 0.5, dmg: op.dmg ?? 0, isDebuff: true }); },\n  obstacle(w, c, op) {\n    const o = { id: w.nextId++, x: c.x, z: c.z, r: op.radius, t: op.dur, look: op.look ?? 'coffin' };\n    w.obstacles.push(o); emit(w, { t: 'obstacle', id: o.id, x: o.x, z: o.z, r: o.r, look: o.look, dur: o.t });\n  },\n  summon(w, c, op) { for (let i = 0; i < (op.count ?? 1); i++) w.hooks.summon(w, c, op); },\n  turret(w, c, op) {\n    const h = c.hero; const kind = op.kind;\n    const live = w.allies.filter((a) => a.kind === kind && a.owner === h.id && !a.dead);\n    if (op.max && live.length >= op.max) { live[0].dead = true; emit(w, { t: 'allygone', id: live[0].id }); }\n    const p = findOpenNear(w, c.tx ?? c.x, c.tz ?? c.z);\n    const a = { id: w.nextId++, kind, owner: h.id, seat: h.seat, x: p.x, z: p.z, px: p.x, pz: p.z, facing: 0, hp: 1e6, maxHp: 1e6, ttl: op.dur, rate: op.rate, rateT: 0.2, dmg: op.dmg, range: op.range ?? 10, radius: op.radius, taunt: op.taunt, arc: op.arc, healAura: op.healAura, endBlast: op.endBlast, setBolt: op.setBolt, c: { ...c }, turret: true, state: 'idle' };\n    w.allies.push(a); emit(w, { t: 'ally', id: a.id, kind, x: a.x, z: a.z, owner: h.id, seat: h.seat });\n  },\n  buff(w, c, op) {\n    const h = c.hero;\n    const b = { id: op.id, dur: op.dur, ...op }; delete b.op;\n    addBuff(w, h, b);\n    if (op.unseen) h.unseen = op.dur;\n  },\n  pull(w, c, op) { for (const m of w.active) if (near(m, c.x, c.z, op.radius)) { const d = Math.hypot(c.x - m.x, c.z - m.z) || 1; if (!m.static) moveCircle(w, m, ((c.x - m.x) / d) * op.dist, ((c.z - m.z) / d) * op.dist, m.r * 0.6); } },\n  knock(w, c, op) { for (const m of w.active) if (near(m, c.x, c.z, op.radius)) knockMonster(w, m, c.x, c.z, op.dist); },\n  stun(w, c, op) { for (const m of w.active) if (near(m, c.x, c.z, op.radius)) stunMonster(w, m, op.t); },\n  apply_status(w, c, op) { for (const m of w.active) if (near(m, c.x, c.z, op.radius)) applyStatus(w, m, op.status, { dps: (op.dps ?? 0) * (c.hero?.stats.weaponDps ?? 10), t: op.t, v: op.v, by: c.hero?.id }); },\n  consume_status(w, c, op) {\n    let n = 0;\n    for (const m of [...w.active]) {\n      const st = m.status[op.status]; if (m.dead || !st || !near(m, c.x, c.z, op.radius)) continue;\n      const pay = st.dps * st.t * op.mult; n++;\n      const payout = pay / Math.max(1, c.hero.stats.weaponDps);\n      delete m.status[op.status]; emit(w, { t: 'mstatus', id: m.id, status: op.status, on: false });\n      heroHit(w, c, m, payout, { element: 'flame', noBurn: true, stun: op.stun, resPerTarget: op.resPerTarget, sfx: 'hit_fire' });\n      if (op.relight && !m.dead) after(w, op.relight, () => { if (!m.dead) applyStatus(w, m, 'burn', { dps: st.dps, t: 4, by: c.hero.id }); });\n      VFX(w, 'burst_fire', m.x, m.z, 1);\n    }\n    if (op.mitts && n > 0) { gainResource(c.hero, (c.sk.cost ?? 40) * 0.5 * Math.floor(n / 10)); if (n >= 10) c.hero.cds.dusk_step = 0; }\n    commonOpFx(w, c, op, c.x, c.z, op.radius);\n    return n;\n  },\n  consume_graves(w, c, op) {\n    let n = 0;\n    const list = w.graves.filter((g) => near(g, c.x, c.z, op.radius)).slice(0, op.max);\n    const blast = (g, depth) => {\n      w.graves.splice(w.graves.indexOf(g), 1); n++;\n      emit(w, { t: 'graveburst', id: g.id, x: g.x, z: g.z });\n      for (const m of [...w.active]) if (near(m, g.x, g.z, op.blast + m.r)) heroHit(w, { ...c, ox: g.x, oz: g.z }, m, op.dmg, { element: 'grave', knock: 1 });\n      if (op.heal) healHero(w, c.hero, op.heal);\n      if (op.tithe) gainResource(c.hero, op.tithe);\n      if (op.rise) w.hooks.summon(w, { ...c, x: g.x, z: g.z }, { kind: 'pallbearer', dmg: 0.6, ttl: op.rise, max: 12 });\n      if (op.chainGraves && depth < 2) for (const o of [...w.graves]) if (near(o, g.x, g.z, op.blast)) blast(o, depth + 1);\n    };\n    for (const g of list) if (w.graves.includes(g)) blast(g, 0);\n    if (op.healMinions) for (const a of w.allies) if (a.owner === c.hero.id && a.minion) a.hp = a.maxHp;\n    if (n) emit(w, { t: 'shake', v: op.shake ?? 0.2 });\n    c.targets += n;\n  },\n  raise_graves(w, c, op) {\n    let n = 0;\n    for (const g of [...w.graves]) { if (n >= op.max || !near(g, c.x, c.z, op.radius)) continue; w.graves.splice(w.graves.indexOf(g), 1); w.hooks.summon(w, { ...c, x: g.x, z: g.z }, { kind: 'pallbearer', dmg: op.dmg, ttl: op.ttl, max: 30 }); n++; }\n    for (let i = n; i < 4; i++) w.hooks.summon(w, c, { kind: 'pallbearer', dmg: op.dmg, ttl: op.ttl, max: 30 });\n  },\n  detonate_minions(w, c, op) { for (const a of [...w.allies]) if (a.owner === c.hero.id && a.minion && !a.dead) { runOps(w, { ...c, x: a.x, z: a.z, ox: a.x, oz: a.z }, [{ op: 'circle', radius: op.radius, dmg: op.dmg, vfx: 'ring_grave', sfx: 'grave_burst' }]); a.dead = true; emit(w, { t: 'allygone', id: a.id, burst: true }); } },\n  comet_rain(w, c, op) {\n    const n = Math.round(op.dur * op.rate); const h = c.hero;\n    for (let i = 0; i < n; i++) after(w, i / op.rate, () => {\n      const rng = w.rngs.combat;\n      // Comets look for trouble: mostly on foes near the caster.\n      const near2 = w.active.filter((m) => !m.dead && near(m, h.x, h.z, op.area));\n      const m = near2.length ? rng.pick(near2) : null;\n      const tx = m ? m.x : h.x + rng.range(-op.area, op.area); const tz = m ? m.z : h.z + rng.range(-op.area, op.area);\n      emit(w, { t: 'lob', x: tx + 3, z: tz - 3, x2: tx, z2: tz, dur: 0.35, look: 'comet', high: true });\n      after(w, 0.35, () => runOps(w, { ...c, x: tx, z: tz, ox: tx, oz: tz, tx, tz, mult: c.mult }, [{ op: 'circle', radius: op.radius, dmg: op.dmg, vfx: 'ring_fire', sfx: 'explode_fire', decal: 'scorch', shake: 0.12 }]));\n      if (op.partyHeal) for (const he of w.heroes) healHero(w, he, op.partyHeal / op.rate);\n    });\n  },\n  delay(w, c, op) { after(w, op.t, () => { const cc = { ...c }; if (c.hero && !op.fixed) { cc.x = c.hero.x; cc.z = c.hero.z; cc.ox = cc.x; cc.oz = cc.z; } runOps(w, cc, op.then ?? []); }); },\n  repeat(w, c, op) { for (let i = 0; i < op.n; i++) after(w, i * op.every, () => runOps(w, c, op.then ?? [])); },\n  spawn_decoy(w, c, op) {\n    const a = { id: w.nextId++, kind: 'decoy', owner: c.hero.id, seat: c.hero.seat, x: c.x, z: c.z, px: c.x, pz: c.z, facing: 0, hp: 1e6, maxHp: 1e6, ttl: op.dur, taunt: true, turret: true, state: 'idle', rate: 99, rateT: 99 };\n    w.allies.push(a); emit(w, { t: 'ally', id: a.id, kind: 'decoy', x: a.x, z: a.z, owner: c.hero.id, seat: c.hero.seat });\n  },\n  trail(w, c, op) {\n    const steps = op.steps ?? 6;\n    for (let i = 0; i < steps; i++) after(w, i * 0.08, () => { const h = c.hero; OPS.zone(w, { ...c, tx: h.x, tz: h.z }, { op: 'zone', radius: op.radius, dur: op.dur, tick: 0.5, dmg: op.dmg, element: op.element, look: op.look ?? 'fire' }); });\n  },\n};\nexport const OP_IDS = Object.keys(OPS);\n\nexport function runOps(w, c, ops) { for (const op of ops) { const fn = OPS[op.op]; if (!fn) throw new Error(`unknown op ${op.op}`); if (op.count && op.op !== 'lob' && op.op !== 'projectile' && op.op !== 'summon' && op.op !== 'chain') { for (let i = 0; i < op.count; i++) fn(w, c, op); } else fn(w, c, op); } }\n\nexport function fireProjectile(w, c, op) {\n  const p = { id: w.nextId++, x: c.x, z: c.z, vx: c.ax * op.speed, vz: c.az * op.speed, speed: op.speed, travelled: 0, range: op.range, width: op.width ?? 0.5, op, c: { ...c }, pierce: op.pierce ? 99 : op.pierceN ?? 0, bounce: op.bounce ?? 0, homing: op.homing ?? 0, hit: new Set(op.ignore ? [op.ignore] : []), look: op.look, hostile: false };\n  w.projectiles.push(p);\n  emit(w, { t: 'proj', id: p.id, x: p.x, z: p.z, vx: p.vx, vz: p.vz, range: p.range, look: p.look, sfx: null, w: p.width });\n  return p;\n}\nexport function hostileProjectile(w, m, tx, tz, { speed = 7, range = 16, dmg = 1, look = 'note', width = 0.5, status = null } = {}) {\n  const dx = tx - m.x; const dz = tz - m.z; const d = Math.hypot(dx, dz) || 1;\n  const p = { id: w.nextId++, x: m.x, z: m.z, vx: (dx / d) * speed, vz: (dz / d) * speed, speed, travelled: 0, range, width, dmg, look, hostile: true, m, status };\n  w.projectiles.push(p);\n  emit(w, { t: 'proj', id: p.id, x: p.x, z: p.z, vx: p.vx, vz: p.vz, range, look, w: width, hostile: true });\n  return p;\n}\n\nexport function stepProjectiles(w) {\n  for (let i = w.projectiles.length - 1; i >= 0; i--) {\n    const p = w.projectiles[i]; let done = false;\n    if (p.homing) {\n      let best = null; let bd = 10;\n      for (const m of w.active) { if (m.dead || p.hit.has(m.id)) continue; const d = Math.hypot(m.x - p.x, m.z - p.z); if (d < bd) { bd = d; best = m; } }\n      if (best) { const dx = best.x - p.x; const dz = best.z - p.z; const d = Math.hypot(dx, dz) || 1; const k = p.homing * DT; p.vx += (dx / d) * p.speed * k; p.vz += (dz / d) * p.speed * k; const v = Math.hypot(p.vx, p.vz) || 1; p.vx = (p.vx / v) * p.speed; p.vz = (p.vz / v) * p.speed; }\n    }\n    const sx = p.vx * DT; const sz = p.vz * DT;\n    const nx = p.x + sx; const nz = p.z + sz;\n    const blocked = !walkableOrPit(w, nx, nz);\n    if (blocked) {\n      if (p.bounce > 0) { p.bounce--; if (!walkableOrPit(w, nx, p.z)) p.vx *= -1; if (!walkableOrPit(w, p.x, nz)) p.vz *= -1; emit(w, { t: 'projturn', id: p.id, x: p.x, z: p.z, vx: p.vx, vz: p.vz }); continue; }\n      done = true;\n    } else { p.x = nx; p.z = nz; p.travelled += p.speed * DT; if (p.travelled >= p.range) done = true; }\n    if (p.hostile) {\n      for (const f of w.fields) if (f.ward && near(p, f.x, f.z, f.r)) done = true;\n      for (const h of w.heroes) {\n        if (h.dead || h.left) continue;\n        if (near(h, p.x, p.z, p.width + 0.4)) {\n          w.hooks.hitHero(w, h, p.dmg, { m: p.m, name: p.m?.name, level: p.m?.level, blindable: true });\n          if (p.status === 'poison') { h.poisonT = 3; }\n          done = true; break;\n        }\n      }\n      for (const a of w.allies) if (!a.turret && !a.dead && near(a, p.x, p.z, p.width + 0.3)) { a.hp -= p.dmg; done = true; }\n    } else {\n      for (const m of w.active) {\n        if (m.dead || p.hit.has(m.id)) continue;\n        if (near(m, p.x, p.z, p.width + m.r)) {\n          p.hit.add(m.id);\n          const c = { ...p.c, x: p.x, z: p.z, ox: p.x - p.vx * 0.05, oz: p.z - p.vz * 0.05, ax: p.vx / p.speed, az: p.vz / p.speed };\n          heroHit(w, c, m, p.op.dmg, p.op);\n          if (p.op.burst) { for (const o of [...w.active]) if (o !== m && !o.dead && near(o, p.x, p.z, p.op.burst + o.r)) heroHit(w, c, o, p.op.dmg * 0.6, { ...p.op, burst: 0, chain: null }); VFX(w, 'burst_grave', p.x, p.z, p.op.burst); }\n          if (p.pierce <= 0) { done = true; break; }\n          p.pierce--;\n        }\n      }\n      for (const pr of w.props) if (pr.hp > 0 && !pr.broken && near(pr, p.x, p.z, 0.8)) { w.hooks.breakProp(w, pr, p.c.hero, p.x, p.z); if (!p.pierce) done = true; }\n    }\n    if (done) { w.projectiles.splice(i, 1); emit(w, { t: 'projend', id: p.id, x: p.x, z: p.z, look: p.look }); }\n  }\n}\nconst walkableOrPit = (w, x, z) => { const nav = w.zone.nav; const col = nav.col(x); const row = nav.row(z); if (row < 0 || col < 0 || row >= w.zone.h || col >= w.zone.w) return false; const ch = w.zone.rows[row][col]; if (ch === '#' || ch === ' ') return false; return true; };\n\nexport function stepFields(w) {\n  for (let i = w.fields.length - 1; i >= 0; i--) {\n    const f = w.fields[i]; f.t -= DT;\n    if (f.follow) { f.x = f.follow.x; f.z = f.follow.z; }\n    f.tickT -= DT;\n    if (f.tickT <= 0) {\n      f.tickT = f.tick; const op = f.op;\n      if (f.hostile) {\n        for (const h of w.heroes) if (!h.dead && !h.left && near(h, f.x, f.z, f.r)) { w.hooks.hitHero(w, h, f.dmg, { pure: false, level: f.level, name: f.name }); if (f.slow) { h.slowT = 1; h.slowV = f.slow; } }\n      } else {\n        if (op.dmg) for (const m of [...w.active]) if (!m.dead && near(m, f.x, f.z, f.r + m.r)) heroHit(w, { ...f.c, x: f.x, z: f.z, ox: f.x, oz: f.z }, m, op.dmg * (f.tick / 0.5), { element: op.element, noRes: true, noBurn: op.look !== 'fire' });\n        if (op.curse || f.slow || f.pull) for (const m of w.active) if (!m.dead && near(m, f.x, f.z, f.r + m.r)) {\n          if (op.curse) { m.status.curse = { v: op.curse, t: 0.7, by: f.owner, tithe: op.tithe }; }\n          if (f.slow) applyStatus(w, m, 'slow', { v: f.slow, t: 0.7 });\n          if (f.pull && !m.static) { const dx = f.x - m.x; const dz = f.z - m.z; const d = Math.hypot(dx, dz) || 1; moveCircle(w, m, (dx / d) * f.pull * f.tick * 0.5, (dz / d) * f.pull * f.tick * 0.5, m.r * 0.6); }\n        }\n        if (f.ally?.heal) for (const h of w.heroes) if (near(h, f.x, f.z, f.r)) healHero(w, h, f.ally.heal * f.tick);\n      }\n    }\n    if (f.t <= 0) { w.fields.splice(i, 1); emit(w, { t: 'fieldend', id: f.id }); }\n  }\n  for (let i = w.obstacles.length - 1; i >= 0; i--) { const o = w.obstacles[i]; o.t -= DT; if (o.t <= 0) { w.obstacles.splice(i, 1); emit(w, { t: 'obstacleend', id: o.id }); } }\n}\nexport const CLASS_INFO = CLASSES;\nexport { F };\nexport function spawnFloating() {}\nEOF\necho ok","description":"Write world, hero and effects sim modules"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1513,"cache_read_input_tokens":228082,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1513},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"69254de6-4061-470e-8e76-10f1ee96c6e5","uuid":"81c90bf4-43d7-4d03-ae4f-c91694d5e39d","timestamp":"2026-11-05T23:34:16.682Z","request_id":"req_011CgkemPJEFbYpSBtFqqos9","wire_tool_inputs":{"toolu_01D3FhrW8DpZNXkUqqG2ue4a":{"command":"python3 - <<'EOF'\np='src/data/rooms.js'; s=open(p).read()\ns=s.replace(\"####################D#################\\n#...N......S.......~~~~~\",\"############D#########################\\n#...N......S.......~~~~~\")\nopen(p,'w').write(s)\nEOF\nnode tools/scratch/rt.mjs\ncat > src/sim/world.js <<'EOF'\n// The simulation root. Plain JavaScript: no THREE, no DOM, no ctx. stepWorld(world, intents) at 60 Hz.\nimport { Rng, NavGrid } from '../../pixel-engine.js';\nimport { DIFFICULTIES, makeTuning, F } from '../data/tuning.js';\nimport { ZONES } from '../data/zones.js';\nimport { generateZone } from './zonegen.js';\nimport { recalc } from './stats.js';\n\nexport const DT = 1 / 60;\n\nexport function emit(w, ev) { w.events.push(ev); }\nexport function after(w, t, fn) { w.timers.push({ at: w.time + t, fn }); }\nexport const dist = (a, b) => Math.hypot(a.x - b.x, a.z - b.z);\nexport const near = (a, x, z, r) => { const dx = a.x - x; const dz = a.z - z; return dx * dx + dz * dz <= r * r; };\n\nexport function createWorld({ seed = 1, mode = 'campaign', tuning = null, difficulty = 0 } = {}) {\n  const root = new Rng(seed);\n  const w = {\n    seed, mode, root, tuning: tuning ?? makeTuning(),\n    rngs: { loot: root.fork('loot'), ai: root.fork('ai'), combat: root.fork('combat'), spawn: root.fork('spawn'), quest: root.fork('quest') },\n    time: 0, tick: 0, nextId: 1, events: [], timers: [],\n    heroes: [], monsters: [], allies: [], props: [], drops: [], fields: [], projectiles: [], obstacles: [], graves: [], telegraphs: [],\n    zone: null, zoneCache: new Map(), difficulty, diff: DIFFICULTIES[difficulty], active: [],\n    navs: [], requiem: { n: 0, t: 0, xp: 0 }, story: { q: 0, step: 0, flags: {}, lychgates: ['town'], writs: null, writsDone: 0 }, knell: null, boss: null, arena: null,\n    objective: null, cheats: { god: false, oneHit: false, noCd: false, infRes: false, noClip: false, invisible: false },\n    bestiary: {}, lore: {}, devotion: { xp: 0, level: 0, spent: { core: 0, offence: 0, defence: 0, utility: 0 } }, stash: [[], [], []], unlocks: { penance: false, knell: false },\n    bests: {}, paused: false, ended: false, frozen: false, stats: { kills: 0 },\n    round: null, wagon: null, tutorial: {}, seen: {},\n  };\n  return w;\n}\n\nexport const setDifficulty = (w, i) => { w.difficulty = i; w.diff = DIFFICULTIES[i]; };\n\nexport function partyLevel(w) { let L = 1; for (const h of w.heroes) if (!h.left && !h.isPyx) L = Math.max(L, h.level); return L; }\nexport function monsterLevel(w) { return Math.max(partyLevel(w), w.zone?.spec.levelFloor ?? 1); }\nexport function playerCount(w) { return Math.max(1, w.heroes.filter((h) => !h.left && !h.isPyx).length); }\n\n// Zones: one active zone for the party. Leaving keeps its state, so returning finds it as it was.\nexport function enterZone(w, zoneId, at = null, hooks = w.hooks) {\n  if (w.zone) w.zoneCache.set(w.zone.id, { zone: w.zone, monsters: w.monsters, props: w.props, drops: w.drops, graves: w.graves, obstacles: w.obstacles });\n  const cached = w.zoneCache.get(zoneId);\n  w.fields = []; w.projectiles = []; w.telegraphs = []; w.timers = w.timers.filter((t) => t.keep);\n  w.allies = w.allies.filter((a) => a.minion);\n  w.boss = null; w.arena = null;\n  if (cached) { w.zone = cached.zone; w.monsters = cached.monsters; w.props = cached.props; w.drops = cached.drops; w.graves = cached.graves; w.obstacles = cached.obstacles; }\n  else {\n    w.zone = generateZone(w.root, zoneId);\n    w.monsters = []; w.props = []; w.drops = []; w.graves = []; w.obstacles = [];\n    w.zone.explored = new Uint8Array(w.zone.w * w.zone.h);\n    w.zone.seedRng = w.root.fork(`pop:${zoneId}`);\n    hooks?.populate?.(w, w.zone);\n  }\n  const rebuildNav = w.zone.nav;\n  w.navs = [0, 1, 2, 3].map(() => { const n = new NavGrid(rebuildNav.width, rebuildNav.height, { origin: [0, 0, 0] }); n.open.set(rebuildNav.open); return n; });\n  const spot = at ?? w.zone.entrance;\n  placeParty(w, spot.x, spot.z);\n  emit(w, { t: 'zone', id: zoneId, x: spot.x, z: spot.z });\n  hooks?.entered?.(w, w.zone, !cached);\n}\n\nexport function placeParty(w, x, z) {\n  w.heroes.forEach((h, i) => {\n    const a = (i / Math.max(1, w.heroes.length)) * Math.PI * 2;\n    const r = w.heroes.length > 1 ? 1.2 : 0;\n    const p = findOpenNear(w, x + Math.cos(a) * r, z + Math.sin(a) * r);\n    h.x = p.x; h.z = p.z; h.px = h.x; h.pz = h.z; h.moveDash = null; h.leapT = 0;\n  });\n  for (const a of w.allies) { a.x = x; a.z = z; a.px = x; a.pz = z; }\n}\n\nexport function walkable(w, x, z) { return w.zone.nav.walkable(x, z); }\nexport function findOpenNear(w, x, z, maxR = 8) {\n  if (walkable(w, x, z)) return { x, z };\n  for (let r = 1; r <= maxR; r++) for (let i = 0; i < 12; i++) {\n    const a = (i / 12) * Math.PI * 2; const nx = x + Math.cos(a) * r; const nz = z + Math.sin(a) * r;\n    if (walkable(w, nx, nz)) return { x: nx, z: nz };\n  }\n  return { x: w.zone.entrance.x, z: w.zone.entrance.z };\n}\n// Moves a circle through the grid with sliding. Returns true if it hit a wall.\nexport function moveCircle(w, e, dx, dz, r = 0.35) {\n  const nav = w.zone.nav; let hit = false;\n  const clear = (x, z) => nav.walkable(x - r, z - r) && nav.walkable(x + r, z - r) && nav.walkable(x - r, z + r) && nav.walkable(x + r, z + r);\n  if (dx !== 0) { if (clear(e.x + dx, e.z)) e.x += dx; else hit = true; }\n  if (dz !== 0) { if (clear(e.x, e.z + dz)) e.z += dz; else hit = true; }\n  if (w.arena?.box) { const b = w.arena.box; e.x = Math.max(b.x0 + r, Math.min(b.x1 - r, e.x)); e.z = Math.max(b.z0 + r, Math.min(b.z1 - r, e.z)); }\n  for (const o of w.obstacles) { const ox = e.x - o.x; const oz = e.z - o.z; const d = Math.hypot(ox, oz); const m = o.r + r; if (d < m && d > 0.001) { e.x = o.x + (ox / d) * m; e.z = o.z + (oz / d) * m; } }\n  return hit;\n}\n\nexport function livingHeroes(w) { return w.heroes.filter((h) => !h.dead && !h.left); }\nexport function nearestHero(w, x, z, maxR = Infinity, visibleOnly = true) {\n  let best = null; let bd = maxR * maxR;\n  for (const h of w.heroes) {\n    if (h.dead || h.left || (visibleOnly && (h.unseen > 0 || (w.cheats.invisible && !h.isPyx)))) continue;\n    const dx = h.x - x; const dz = h.z - z; const d = dx * dx + dz * dz;\n    if (d < bd) { bd = d; best = h; }\n  }\n  return best;\n}\nexport const addXpHook = null;\n\nexport { F, ZONES, recalc };\nEOF\ncat > src/sim/hero.js <<'EOF'\n// Heroes: creation, level and XP, intents to movement, casting, dodge, potion, death, revive.\nimport { CLASSES, SKILLS, toneUnlockLevel } from '../data/classes.js';\nimport { DEVOTION_TRACKS, devotionCost, LEGENDARY } from '../data/items.js';\nimport { F, LEVEL_CAP, SLOT_LEVELS, VOW_LEVELS } from '../data/tuning.js';\nimport { makeItem } from './loot.js';\nimport { recalc } from './stats.js';\nimport { DT, after, emit, findOpenNear, moveCircle, near } from './world.js';\nimport { effectiveSkill, runOps, spawnFloating, softTarget } from './effects.js';\n\nexport function makeHero(w, { seat = 0, cls = 'bellwarden', name = 'THE LATE', level = 1, isBot = false } = {}) {\n  const h = {\n    id: w.nextId++, seat, cls, name, level, xp: 0, x: 0, z: 0, px: 0, pz: 0, facing: 0, hp: 1, res: 0, isBot,\n    gear: {}, inv: [], gold: 0, mats: { scrap: 0, dust: 0, shards: 0, keys: 0 }, gems: {}, reliquary: { weapon: null, armour: null, jewel: null },\n    slots: [{ skill: null, tone: null }, { skill: null, tone: null }, { skill: null, tone: null }, { skill: null, tone: null }, { skill: null, tone: null }, { skill: null, tone: null }],\n    vows: [], cds: {}, charges: {}, potionCd: 0, dodgeCd: 0, state: 'idle', stateT: 0, cast: null, castSeq: 0, buffs: [], shield: 0, combo: 0, comboT: 0,\n    moving: false, dead: false, deadT: 0, deaths: 0, recentDeaths: 0, kills: 0, damage: 0, revives: 0, goldEarned: 0, eliteKills: 0, stunT: 0, rootT: 0, inv_T: 0, invulnerable: 0, unseen: 0,\n    lastHit: -99, outCombat: 0, clamorHold: 0, plateN: 0, plateT: 0, batonN: 0, swatN: 0, clemencyT: 12, lastLight: 0, thrice: 0, bellT: 0, reviveT: 0, reviving: null, interactT: 0, heldPrev: {}, swap: {}, stuckT: 0, levelPicks: [], newest: null, savedNewest: null, slowT: 0, slowV: 0,\n  };\n  recalc(h, w.tuning, null);\n  h.hp = h.stats.maxHp;\n  return h;\n}\n\nexport const slotOpen = (h, i) => h.level >= SLOT_LEVELS[i];\nexport const skillUnlocked = (h, id) => h.level >= SKILLS[id].level;\nexport const toneUnlocked = (h, skill, i) => h.level >= toneUnlockLevel(skill, i);\nexport const vowSlots = (h) => VOW_LEVELS.filter((L) => h.level >= L).length;\n\nexport function refresh(w, h) { recalc(h, w.tuning, w.devotion?.spent); }\nexport const hasBuff = (h, id) => h.buffs.find((b) => b.id === id);\nexport function addBuff(w, h, b) { const old = h.buffs.find((x) => x.id === b.id); if (old) Object.assign(old, b); else h.buffs.push({ ...b }); emit(w, { t: 'buff', id: h.id, buff: b.id, dur: b.dur }); }\n\nexport function starterGear(w, h, ilvl = 1) {\n  h.gear.main = makeItem(w.rngs.loot, { slot: 'main', rarity: 'common', ilvl, cls: h.cls, weaponId: CLASSES[h.cls].starterWeapon });\n  if (h.cls === 'bellwarden') h.gear.main.dps = Math.round(h.gear.main.dps * 1.05 * 10) / 10;\n  refresh(w, h); h.hp = h.stats.maxHp;\n}\nexport function autoAssignSkills(h) {\n  // Fills open slots with the earliest skills the hero has, keeping what's there.\n  const have = new Set(h.slots.map((s) => s.skill).filter(Boolean));\n  const list = CLASSES[h.cls].skills.filter((s) => skillUnlocked(h, s.id));\n  for (let i = 0; i < 6; i++) if (slotOpen(h, i) && !h.slots[i].skill) { const s = list.find((x) => !have.has(x.id)); if (s) { h.slots[i].skill = s.id; have.add(s.id); } }\n}\n\nexport function grantXp(w, h, amount) {\n  if (h.isPyx) return;\n  amount = amount * w.tuning.xp * w.diff.xp;\n  if (h.level >= LEVEL_CAP) {\n    const d = w.devotion; d.xp += amount;\n    while (d.xp >= devotionCost(d.level)) { d.xp -= devotionCost(d.level); d.level++; emit(w, { t: 'toast', seat: h.seat, text: 'DEVOTION RISES. A POINT TO SPEND.', color: 'sky' }); emit(w, { t: 'sfx', id: 'bell_small' }); }\n    return;\n  }\n  h.xp += amount;\n  while (h.level < LEVEL_CAP && h.xp >= F.xpToNext(h.level)) { h.xp -= F.xpToNext(h.level); levelUp(w, h); }\n}\nexport function levelUp(w, h) {\n  h.level++;\n  refresh(w, h);\n  h.hp = h.stats.maxHp;\n  if (!w.round) autoSlotNew(w, h);\n  w.hooks?.levelUp?.(w, h);\n  emit(w, { t: 'level', id: h.id, seat: h.seat, level: h.level, x: h.x, z: h.z });\n}\nfunction autoSlotNew(w, h) {\n  const newly = CLASSES[h.cls].skills.find((s) => s.level === h.level);\n  if (newly) {\n    emit(w, { t: 'toast', seat: h.seat, text: `NEW SKILL: ${newly.name}`, color: 'sand', prompt: 'skills' });\n    const empty = h.slots.findIndex((s, i) => !s.skill && slotOpen(h, i));\n    if (empty >= 0) h.slots[empty].skill = newly.id;\n  }\n  const sOpen = SLOT_LEVELS.indexOf(h.level);\n  if (sOpen >= 2) { autoAssignSkills(h); emit(w, { t: 'toast', seat: h.seat, text: 'A NEW SKILL SLOT OPENS.', color: 'sand', prompt: 'skills' }); }\n  for (const s of CLASSES[h.cls].skills) for (let i = 0; i < 3; i++) if (toneUnlockLevel(s, i) === h.level && s.level <= h.level) { emit(w, { t: 'toast', seat: h.seat, text: `NEW TONE: ${Object.values(s.tones)[i].name}`, color: 'sky', prompt: 'skills' }); break; }\n  if (VOW_LEVELS.includes(h.level)) emit(w, { t: 'toast', seat: h.seat, text: 'A VOW MAY BE SWORN.', color: 'plum', prompt: 'skills' });\n}\n\nexport function spendResource(w, h, amt) { if (w.cheats.infRes) return; h.res = Math.max(0, h.res - amt); }\nexport function gainResource(h, amt) { h.res = Math.min(h.stats.maxResource, h.res + amt); }\nexport function healHero(w, h, frac, flat = 0) {\n  if (h.dead) return;\n  const amt = h.stats.maxHp * frac + flat;\n  const before = h.hp;\n  h.hp = Math.min(h.stats.maxHp, h.hp + amt);\n  if (h.hp - before >= 1 && frac >= 0.05) emit(w, { t: 'heal', id: h.id, amt: Math.round(h.hp - before), x: h.x, z: h.z });\n}\n\n// Damage to a hero, with shields, immunity and last-chance powers.\nexport function damageHero(w, h, amt, src = {}) {\n  if (h.dead || h.left || h.invulnerable > 0 || w.cheats.god && !h.isPyx || h.attractGod) return 0;\n  if (src.blindable && src.m?.blindT > 0) { emit(w, { t: 'miss', x: h.x, z: h.z }); return 0; }\n  let dr = h.stats.dr / 100;\n  for (const f of w.fields) if (f.ally?.dr && near(h, f.x, f.z, f.r)) dr = 1 - (1 - dr) * (1 - f.ally.dr);\n  const reduction = src.pure ? 0 : F.reduction(h.stats.armour, src.level ?? h.level);\n  let dealt = amt * (1 - reduction) * (1 - dr);\n  if (h.shield > 0) { const take = Math.min(h.shield, dealt); h.shield -= take; dealt -= take; }\n  if (dealt <= 0) return 0;\n  h.hp -= dealt;\n  h.lastHit = w.time; h.outCombat = 0;\n  emit(w, { t: 'hurt', id: h.id, amt: Math.round(dealt), x: h.x, z: h.z, big: dealt > h.stats.maxHp * 0.2 });\n  if (h.channel) { h.channel = null; }\n  if (h.reviving) h.reviving = null;\n  if (h.hp <= 0) {\n    if (h.powers.has('thrice_buried') && w.time > h.thrice) { h.thrice = w.time + 90; h.hp = h.stats.maxHp * 0.3; emit(w, { t: 'vfx', kind: 'ring_grave', x: h.x, z: h.z, r: 3 }); emit(w, { t: 'toast', seat: h.seat, text: 'ONE LEARNS TO KEEP A SPADE IN THE COFFIN.', color: 'orange' }); return dealt; }\n    if (h.vows.includes('last_light') && w.time > h.lastLight) { h.lastLight = w.time + 90; h.hp = h.stats.maxHp * 0.25; h.invulnerable = 1; emit(w, { t: 'vfx', kind: 'ring_fire', x: h.x, z: h.z, r: 3 }); emit(w, { t: 'toast', seat: h.seat, text: 'THE LAST LIGHT HOLDS.', color: 'sand' }); return dealt; }\n    killHero(w, h, src);\n  }\n  return dealt;\n}\nexport function killHero(w, h, src = {}) {\n  h.hp = 0; h.dead = true; h.deadT = 0; h.deaths++; h.recentDeaths++; h.state = 'dead'; h.cast = null; h.moveDash = null; h.channel = null;\n  h.respawnWait = w.round ? 8 : Math.min(30, 5 + 5 * (h.recentDeaths - 1));\n  emit(w, { t: 'herodeath', id: h.id, seat: h.seat, x: h.x, z: h.z, by: src.name ?? '' });\n  w.hooks?.heroDied?.(w, h);\n}\nexport function reviveHero(w, h, at = null, frac = 0.6) {\n  h.dead = false; h.hp = h.stats.maxHp * frac; h.state = 'idle'; h.invulnerable = 2; h.deadT = 0;\n  if (at) { const p = findOpenNear(w, at.x, at.z); h.x = p.x; h.z = p.z; h.px = h.x; h.pz = h.z; }\n  h.res = Math.max(h.res, 0);\n  emit(w, { t: 'revive', id: h.id, x: h.x, z: h.z });\n}\n\nconst SKILL_KEYS = ['s0', 's1', 's2', 's3', 's4', 's5'];\n\n// Bursts of a skill: charges for \"Double\" and \"Deep\" Tones.\nfunction cdLeft(w, h, skillId) { return Math.max(0, (h.cds[skillId] ?? 0) - w.time); }\nexport function skillReadyFrac(w, h, sk) {\n  const left = cdLeft(w, h, sk.id);\n  return sk.cd ? left / sk.cd : 0;\n}\n\nexport function tryCast(w, h, slot, intent) {\n  const def = h.slots[slot]; if (!def?.skill || !slotOpen(h, slot)) return false;\n  const swapT = h.swap?.[slot] ?? 0; if (swapT > w.time) return false;\n  const sk = effectiveSkill(h, def.skill, def.tone);\n  const free = h.powers.has('choirmaster') && h.batonN >= 5;\n  const cost = free ? 0 : (sk.cost ?? 0) * (1 - Math.min(60, h.stats.costRed) / 100);\n  const noCd = w.cheats.noCd || w.tuning.cooldown === 0;\n  const cds = sk.charges ? (h.charges[sk.id] ?? sk.charges) <= 0 : cdLeft(w, h, sk.id) > 0;\n  if (cds && !noCd) return false;\n  if (h.res < cost && !w.cheats.infRes) { if (intent.pressed?.[SKILL_KEYS[slot]]) emit(w, { t: 'nores', id: h.id, seat: h.seat, slot, res: CLASSES[h.cls].resource }); return false; }\n  spendResource(w, h, cost);\n  const spd = 1 + Math.min(100, h.stats.atkSpd) / 100;\n  const wind = (sk.wind ?? 0.15) / spd; const rec = (sk.rec ?? 0.2) / spd;\n  let ax = intent.aimX ?? Math.sin(h.facing); let az = intent.aimZ ?? Math.cos(h.facing);\n  const lock = softTarget(w, h, sk, intent);\n  let tx = intent.tx; let tz = intent.tz;\n  if (lock && !intent.hardAim) { const dx = lock.x - h.x; const dz = lock.z - h.z; const d = Math.hypot(dx, dz) || 1; ax = dx / d; az = dz / d; if (tx === undefined) { tx = lock.x; tz = lock.z; } if ((sk.fx[0].op === 'arc') && d > 1 && d < 3.4) { moveCircle(w, h, ax * Math.min(0.6, d - 1), az * Math.min(0.6, d - 1)); } }\n  if (tx === undefined) { const r = sk.range ?? 6; tx = h.x + ax * r; tz = h.z + az * r; }\n  h.facing = Math.atan2(ax, az);\n  let clip = sk.clip;\n  if (Array.isArray(clip)) { clip = clip[h.combo % clip.length]; h.combo++; h.comboT = 1.2; }\n  h.state = 'cast'; h.stateT = 0; h.castSeq++;\n  h.cast = { sk, wind, rec, fired: false, ax, az, tx, tz, slot, free, moving: !!sk.moving };\n  if (sk.cd) {\n    if (sk.charges) { h.charges[sk.id] = (h.charges[sk.id] ?? sk.charges) - 1; after(w, sk.cd * w.tuning.cooldown * (1 - Math.min(50, h.stats.cdr) / 100), () => { h.charges[sk.id] = Math.min(sk.charges, (h.charges[sk.id] ?? 0) + 1); }); }\n    h.cds[sk.id] = w.time + sk.cd * w.tuning.cooldown * (1 - Math.min(50, h.stats.cdr) / 100);\n  }\n  emit(w, { t: 'cast', id: h.id, seat: h.seat, skill: sk.id, clip, upper: !!sk.upper, dur: wind + rec, ax, az, tx, tz, vfx: sk.vfx, sfx: sk.sfx, element: sk.element });\n  return true;\n}\n\nfunction fireCast(w, h) {\n  const c = h.cast; const sk = c.sk;\n  c.fired = true;\n  const mult = c.free ? 2 : 1;\n  if (h.powers.has('choirmaster')) h.batonN = c.free ? 0 : h.batonN + 1;\n  if (sk.gen) gainResource(h, sk.gen);\n  const ctx = { src: h, hero: h, x: h.x, z: h.z, ox: h.x, oz: h.z, ax: c.ax, az: c.az, tx: c.tx, tz: c.tz, sk, mult, kills: 0, targets: 0 };\n  runOps(w, ctx, sk.fx);\n  h.used = h.used ?? {}; h.used[sk.id] = (h.used[sk.id] ?? 0) + 1;\n  if (h.powers.has('first_digger') && sk.id === 'shovel_swat') { h.swatN++; if (h.swatN % 5 === 0) w.graves.push({ id: w.nextId++, x: h.x + c.ax * 1.5, z: h.z + c.az * 1.5, t: 12 }); }\n  if (h.setBonus.ringing_order4 && sk.tags?.includes('toll')) h.cds.bellfall = Math.max(w.time, (h.cds.bellfall ?? 0) - 2);\n}\n\nexport function startDodge(w, h, intent) {\n  if (h.dodgeCd > 0 && !w.cheats.noCd) return false;\n  if (h.state === 'dead' || h.stunT > 0) return false;\n  let ax = intent.moveX; let az = intent.moveZ;\n  if (Math.hypot(ax, az) < 0.2) { ax = Math.sin(h.facing); az = Math.cos(h.facing); }\n  const d = Math.hypot(ax, az) || 1; ax /= d; az /= d;\n  h.state = 'dodge'; h.stateT = 0; h.cast = null; h.moveDash = { vx: (ax * 4.5) / 0.35, vz: (az * 4.5) / 0.35, t: 0.35, inv: true };\n  h.facing = Math.atan2(ax, az); h.dodgeCd = w.tuning.dodgeCd; h.castSeq++; h.dodges = (h.dodges ?? 0) + 1;\n  emit(w, { t: 'cast', id: h.id, seat: h.seat, clip: 'Roll', dur: 0.35, sfx: 'dodge', dodge: true });\n  emit(w, { t: 'tutorial', seat: h.seat, id: 'dodge' });\n  return true;\n}\nexport function usePotion(w, h) {\n  if (h.potionCd > 0 || h.dead) return false;\n  h.potionCd = w.tuning.potionCd; h.potions = (h.potions ?? 0) + 1;\n  healHero(w, h, 0.6);\n  emit(w, { t: 'potion', id: h.id, x: h.x, z: h.z });\n  emit(w, { t: 'tutorial', seat: h.seat, id: 'potion' });\n  return true;\n}\n\n// One hero, one step.\nexport function stepHero(w, h, intent) {\n  h.px = h.x; h.pz = h.z;\n  if (h.left) return;\n  const s = h.stats; const dt = DT;\n  h.potionCd = Math.max(0, h.potionCd - dt); h.dodgeCd = Math.max(0, h.dodgeCd - dt); h.invulnerable = Math.max(0, h.invulnerable - dt); h.unseen = Math.max(0, h.unseen - dt);\n  h.comboT -= dt; if (h.comboT <= 0) h.combo = 0;\n  h.outCombat += dt;\n  stepBuffs(w, h);\n  if (h.dead) { h.deadT += dt; intent.pressed = {}; w.hooks?.deadStep?.(w, h, intent); return; }\n  // Resource.\n  const regenMul = w.tuning.resource;\n  if (h.cls === 'lamplighter') { let bonus = 1; for (const f of w.fields) if (f.ally?.wick && near(h, f.x, f.z, f.r)) bonus += f.ally.wick; gainResource(h, 14 * dt * regenMul * bonus); }\n  if (h.cls === 'bellwarden') { if (h.outCombat > 4 && h.clamorHold <= 0) h.res = Math.max(0, h.res - 8 * dt); h.clamorHold -= dt; }\n  if (w.cheats.infRes) h.res = s.maxResource;\n  if (s.regen > 0) h.hp = Math.min(s.maxHp, h.hp + s.regen * dt);\n  if (h.powers.has('clemency_shard')) { h.clemencyT -= dt; if (h.clemencyT <= 0) { h.clemencyT = 12; runOps(w, { src: h, hero: h, x: h.x, z: h.z, ox: h.x, oz: h.z, ax: 0, az: 1, tx: h.x, tz: h.z, sk: { id: 'clemency', element: 'sound' }, mult: 1 }, [{ op: 'ring', radius: 6, dmg: 3, vfx: 'ring_bronze', sfx: 'bell_small', shake: 0.15 }]); } }\n  h.stunT = Math.max(0, h.stunT - dt); h.rootT = Math.max(0, h.rootT - dt); h.slowT = Math.max(0, h.slowT - dt);\n  if (h.stunT > 0) return;\n\n  const pressed = intent.pressed ?? {}; const held = intent.held ?? {};\n  // Dodge cancels anything.\n  if (pressed.dodge && h.state !== 'dodge') startDodge(w, h, intent);\n  if (pressed.potion) usePotion(w, h);\n  // Dash or dodge in motion.\n  if (h.moveDash) {\n    const m = h.moveDash; m.t -= dt;\n    if (m.inv) h.invulnerable = Math.max(h.invulnerable, 0.02);\n    const noClip = m.noClip;\n    if (noClip) { h.x += m.vx * dt; h.z += m.vz * dt; } else moveCircle(w, h, m.vx * dt, m.vz * dt);\n    m.step?.(w, h);\n    if (m.t <= 0) { h.moveDash = null; if (noClip) { const p = findOpenNear(w, h.x, h.z); h.x = p.x; h.z = p.z; } m.end?.(w, h); if (h.state === 'dodge') { h.state = 'idle'; } }\n    if (h.state === 'dodge') return;\n  }\n  // Skills.\n  if (h.cast) {\n    const c = h.cast; h.stateT += dt;\n    if (!c.fired && h.stateT >= c.wind) fireCast(w, h);\n    const total = c.wind + c.rec;\n    if (c.fired && h.stateT >= total) { h.cast = null; h.state = 'idle'; }\n    else if (c.fired && h.stateT >= c.wind + c.rec / 2 && Math.hypot(intent.moveX, intent.moveZ) > 0.2) { h.cast = null; h.state = 'idle'; }\n  }\n  if (!h.cast && h.state !== 'dodge') {\n    for (let i = 0; i < 6; i++) if ((pressed[SKILL_KEYS[i]] || held[SKILL_KEYS[i]]) && tryCast(w, h, i, intent)) break;\n  }\n  // Channels: Passing Bell, rope, revive. A hit interrupts (see damageHero).\n  if (h.channel) {\n    h.channel.t += dt;\n    if (h.channel.t >= h.channel.dur) { const c = h.channel; h.channel = null; c.done(w, h); }\n    else if (Math.hypot(intent.moveX, intent.moveZ) > 0.5 || (c_isReleased(h.channel, held))) { h.channel = null; }\n  }\n  // Movement.\n  const mag = Math.hypot(intent.moveX, intent.moveZ);\n  const canMove = !h.channel && h.rootT <= 0 && (!h.cast || h.cast.moving || h.cast.fired && h.cast.moving);\n  h.moving = false;\n  if (canMove && mag > 0.15 && !h.buffRoot) {\n    const k = Math.min(1, mag);\n    let sp = s.speed * k;\n    for (const b of h.buffs) { if (b.speed) sp *= 1 + b.speed; if (b.slow) sp *= 1 - b.slow; }\n    if (h.slowT > 0) sp *= 1 - h.slowV;\n    const nx = intent.moveX / mag; const nz = intent.moveZ / mag;\n    const bx = h.x; const bz = h.z;\n    if (w.cheats.noClip) { h.x = Math.max(1, Math.min(w.zone.w - 1, h.x + nx * sp * dt)); h.z = Math.max(1, Math.min(w.zone.h - 1, h.z + nz * sp * dt)); }\n    else moveCircle(w, h, nx * sp * dt, nz * sp * dt);\n    h.moving = true; h.speedNow = sp;\n    if (!h.cast && !intent.hardAim) h.facing = Math.atan2(nx, nz);\n    if (Math.hypot(h.x - bx, h.z - bz) < sp * dt * 0.25) h.stuckT += dt; else h.stuckT = 0;\n    h.walked = (h.walked ?? 0) + Math.hypot(h.x - bx, h.z - bz);\n  } else h.stuckT = 0;\n  if (intent.hardAim && !h.cast && h.state !== 'dodge') { const a = Math.atan2(intent.aimX ?? 0, intent.aimZ ?? 1); h.facing = a; }\n  // Soft body push from monsters; stuck heroes pass through small ones.\n  if (h.stuckT < 0.3 && !w.cheats.noClip) {\n    for (const m of w.active) {\n      if (m.dead || m.static || m.defn.hover) continue;\n      const dx = h.x - m.x; const dz = h.z - m.z; const rr = m.r + 0.4;\n      const d2 = dx * dx + dz * dz;\n      if (d2 < rr * rr && d2 > 1e-4) {\n        const d = Math.sqrt(d2); const push = (rr - d) * 0.25;\n        moveCircle(w, h, (dx / d) * push, (dz / d) * push);\n      }\n    }\n  }\n}\nfunction c_isReleased(ch, held) { return ch.hold && !held[ch.hold]; }\n\nfunction stepBuffs(w, h) {\n  h.buffRoot = false;\n  for (let i = h.buffs.length - 1; i >= 0; i--) {\n    const b = h.buffs[i]; b.dur -= DT;\n    if (b.spin) {\n      b.spinT = (b.spinT ?? 0) - DT;\n      if (b.spinT <= 0) {\n        b.spinT = b.spin.every;\n        const ctx = { src: h, hero: h, x: h.x, z: h.z, ox: h.x, oz: h.z, ax: Math.sin(h.facing), az: Math.cos(h.facing), tx: h.x, tz: h.z, sk: { id: 'last_peal', element: 'sound' }, mult: 1, buff: b };\n        runOps(w, ctx, [{ op: 'circle', radius: b.spin.radius, dmg: b.spin.dmg, pull: b.spin.pull, killExtend: b.spin.killExtend, vfx: 'ring_chain', sfx: 'hit_bell' }]);\n        h.castSeq++;\n      }\n    }\n    if (b.unseen) h.unseen = Math.max(h.unseen, 0.1);\n    if (b.shield !== undefined && b.dur <= 0) h.shield = 0;\n    if (b.dur <= 0) { h.buffs.splice(i, 1); emit(w, { t: 'buffend', id: h.id, buff: b.id }); }\n  }\n}\n\nexport function damageBonus(w, h, target) {\n  // Multiplicative pile of everything a hero's hit can gain.\n  let k = 1 + h.stats.dmgPct / 100;\n  for (const b of h.buffs) { if (b.dmg) k *= 1 + b.dmg; }\n  for (const f of w.fields) if (f.ally?.dmg && near(h, f.x, f.z, f.r)) k *= 1 + f.ally.dmg;\n  if (h.vows.includes('contrition') && h.hp < h.stats.maxHp / 2) k *= 1.15;\n  if (h.powers.has('plate_lining') && h.plateT > w.time) k *= 1 + Math.min(30, h.plateN) / 100;\n  if (h.powers.has('mourning_band')) { const n = w.allies.filter((a) => a.owner === h.id && a.minion && !a.dead).length + w.heroes.filter((o) => o.dead && o !== h).length; k *= 1 + Math.min(0.3, n * 0.05); }\n  if (h.powers.has('malisons_knuckle') && target?.elite) k *= 1.25;\n  return k;\n}\nexport const hasLegendary = (h, id) => h.powers.has(id) && !!LEGENDARY[id];\nexport const devotionPointsFree = (w) => w.devotion.level + (w.devotion.bonus ?? 0) - Object.values(w.devotion.spent).reduce((a, b) => a + b, 0);\nexport const DEVOTION_IDS = Object.keys(DEVOTION_TRACKS);\nexport { spawnFloating };\nEOF\ncat > src/sim/effects.js <<'EOF'\n// The effect ops. Skills and Tones only compose these; nothing here knows a skill by name except powers.\nimport { SKILLS, CLASSES } from '../data/classes.js';\nimport { F } from '../data/tuning.js';\nimport { DT, after, emit, findOpenNear, moveCircle, near, walkable } from './world.js';\nimport { damageBonus, gainResource, healHero, addBuff } from './hero.js';\nimport { killMonster, stunMonster } from './monsters.js';\n\nconst clone = (o) => JSON.parse(JSON.stringify(o));\nconst setPath = (obj, path, v) => { const parts = path.split('.'); let o = obj; for (let i = 0; i < parts.length - 1; i++) { o = o[parts[i]] ?? (o[parts[i]] = {}); } o[parts.at(-1)] = v; };\n\n// Skill + Tone + legendary powers = the concrete skill this cast uses. Cached by the hero's loadout key.\nexport function effectiveSkill(h, skillId, toneId) {\n  const key = `${skillId}|${toneId ?? ''}|${[...h.powers].join(',')}|${Object.keys(h.setBonus).join(',')}`;\n  h._skillCache ??= new Map();\n  const hit = h._skillCache.get(key); if (hit) return hit;\n  const base = SKILLS[skillId];\n  const sk = { ...base, fx: clone(base.fx), tones: undefined };\n  const t = toneId ? base.tones[toneId] : null;\n  if (t) {\n    if (t.fxAll) sk.fx = clone(t.fxAll);\n    if (t.set) Object.assign(sk.fx[0], clone(t.set));\n    if (t.patch) for (const p of t.patch) setPath(sk.fx[0], p.path, p.v);\n    if (t.add) sk.fx.push(...clone(t.add));\n    if (t.addThen) sk.fx[0].then.push(...clone(t.addThen));\n    if (t.cd !== undefined) sk.cd = t.cd;\n    if (t.wind !== undefined) sk.wind = t.wind;\n    if (t.charges) sk.charges = t.charges;\n  }\n  // Legendary powers change how skills work, not only the numbers.\n  const P = h.powers;\n  if (P.has('widows_clapper') && skillId === 'great_toll') for (const dl of [0.4, 0.8]) sk.fx.push({ op: 'delay', t: dl, then: [{ op: 'ring', radius: 6, dmg: sk.fx[0].dmg * 0.5, vfx: 'ring_bronze', sfx: 'bell_small', shake: 0.15 }] });\n  if (P.has('anvil') && skillId === 'clapper_charge') sk.fx[0].drag = true;\n  if (P.has('hymnal_greaves') && skillId === 'chain_reap') sk.fx[0].homingNote = true;\n  if (P.has('last_wick') && skillId === 'spark_bolt') sk.fx[0].wickSplit = true;\n  if (P.has('patient_moth') && skillId === 'lantern_hurl') for (const op of sk.fx) for (const th of op.then ?? []) if (th.op === 'zone') th.pull = 2;\n  if (P.has('snuffer_mitts') && skillId === 'snuff') sk.fx[0].mitts = true;\n  if (P.has('cinderwalk') && skillId === 'dusk_step') sk.fx.push({ op: 'trail', dur: 3, dmg: 0.6, element: 'flame', radius: 1.2, steps: 6, fromOrigin: true });\n  if (P.has('second_crook') && skillId === 'raise_pallbearers') { sk.fx[0].slam = true; sk.fx[0].hpMul = 1.5; sk.fx[0].dmg = (sk.fx[0].dmg ?? 0.6) * 1.3; sk.fx[0].crook = true; }\n  if (P.has('ledger_graves') && skillId === 'exhume') { sk.fx[0].max = 99; sk.fx[0].tithe = 1; }\n  if (P.has('family_deed') && skillId === 'coffin_drop') { const main = sk.fx[0]; main.count = (main.count ?? 1) + 3; main.spread = main.spread ?? 3; }\n  const sb = h.setBonus;\n  if (sb.ringing_order4 && base.tags?.includes('toll')) for (const op of sk.fx) { if (op.dmg) op.dmg += 3; for (const th of op.then ?? []) if (th.dmg) th.dmg += 3; }\n  if (sb.perpetual_mourner4 && skillId === 'exhume') { sk.fx[0].dmg += 4; sk.fx[0].healMinions = true; }\n  if (sb.last_lamplighter4 && skillId === 'lamp_post') { sk.fx[0].setBolt = true; sk.fx[0].dmg += 4; }\n  if (sb.perpetual_mourner2 && skillId === 'raise_pallbearers') sk.fx[0].max = (sk.fx[0].max ?? 4) + 2;\n  if (h.vows.includes('union_rates') && skillId === 'raise_pallbearers') sk.fx[0].max = (sk.fx[0].max ?? 4) + 1;\n  if (h.vows.includes('keeper_of_lamps') && skillId === 'lamp_post') sk.fx[0].max = (sk.fx[0].max ?? 3) + 1;\n  h._skillCache.set(key, sk);\n  return sk;\n}\n\n// The best monster inside a 120 degree cone of facing and the skill's range.\nexport function softTarget(w, h, sk, intent) {\n  if (intent.hardAim) return null;\n  const range = sk?.range ?? rangeOf(sk) ?? 8;\n  let best = null; let bs = Infinity;\n  const fx = intent.aimX ?? Math.sin(h.facing); const fz = intent.aimZ ?? Math.cos(h.facing);\n  for (const m of w.active) {\n    if (m.dead || m.untargetable) continue;\n    const dx = m.x - h.x; const dz = m.z - h.z; const d = Math.hypot(dx, dz);\n    if (d > range + m.r) continue;\n    const dot = d > 0.01 ? (dx * fx + dz * fz) / d : 1;\n    if (dot < 0.5) continue;\n    const s = d - dot * 3 - (m.elite ? 1 : 0) - (m.defn.boss ? 2 : 0);\n    if (s < bs) { bs = s; best = m; }\n  }\n  return best;\n}\nconst rangeOf = (sk) => { const o = sk?.fx?.[0]; if (!o) return 8; return o.range ?? o.radius ?? o.dist ?? 8; };\n\nconst ELEMENT_STAT = { sound: 'soundPct', flame: 'flamePct', grave: 'gravePct' };\n\n// hero hit on monster: the one formula, with hooks.\nexport function heroHit(w, c, m, pct, op = {}) {\n  const h = c.hero; if (!h || m.dead || m.invulnerable) return 0;\n  const s = h.stats; const element = op.element ?? c.sk?.element ?? 'phys';\n  const rng = w.rngs.combat;\n  let crit = s.crit;\n  if (h.vows.includes('bright_eyes') && m.status.burn) crit += 10;\n  const isCrit = rng.chance(Math.min(100, crit) / 100);\n  let dmg = s.weaponDps * pct * (c.mult ?? 1) * (1 + s.power / 100) * (1 + (s[ELEMENT_STAT[element]] ?? 0) / 100) * damageBonus(w, h, m) * w.tuning.playerDamage;\n  if (isCrit) dmg *= 1.5 + s.critDmg / 100;\n  // Class passives.\n  if (m.status.burn && h.cls === 'lamplighter') dmg *= 1.15;\n  if (m.status.curse) dmg *= 1 + m.status.curse.v;\n  if (m.status.mark) dmg *= 1.2;\n  const veil = h.buffs.find((b) => b.nextHit); if (veil) { dmg *= 1 + veil.nextHit; veil.nextHit = 0; veil.dur = 0; h.unseen = 0; }\n  if (op.consume === 'resonance' && m.resonance > 0) { dmg *= 1 + 0.25 * m.resonance; if (c.hero.cls === 'bellwarden') { m.resonance = 0; m.resT = 0; emit(w, { t: 'mstack', id: m.id, n: 0 }); } }\n  if (w.cheats.oneHit) dmg = m.hp + 1;\n  dmg = Math.round(dmg);\n  m.hp -= dmg;\n  m.flash = 2; m.lastHitBy = h.id;\n  h.damage += dmg; h.outCombat = 0;\n  m.woke ||= true;\n  emit(w, { t: 'hit', id: m.id, amt: dmg, crit: isCrit, x: m.x, z: m.z, element, by: h.seat, mat: m.defn.material });\n  if (op.sfx) emit(w, { t: 'sfx', id: op.sfx, x: m.x, z: m.z, rate: 0.15 });\n  // Secondary effects.\n  if (h.cls === 'bellwarden' && !op.noRes) { m.resonance = Math.min(h.resonanceCap, m.resonance + 1); m.resT = 6; emit(w, { t: 'mstack', id: m.id, n: m.resonance }); }\n  if (s.lifePerHit > 0) h.hp = Math.min(s.maxHp, h.hp + s.lifePerHit * 0.2);\n  if (op.heal) healHero(w, h, op.heal);\n  if (op.resPerTarget) gainResource(h, op.resPerTarget);\n  if (c.sk?.genPerTarget) gainResource(h, c.sk.genPerTarget);\n  if (element === 'flame' && h.cls === 'lamplighter' && !op.noBurn) applyStatus(w, m, 'burn', { dps: s.weaponDps * 0.3 * h.burnMul * w.tuning.playerDamage * (1 + s.power / 100), t: 4, by: h.id });\n  if (op.burn) applyStatus(w, m, 'burn', { dps: s.weaponDps * op.burn * h.burnMul * (1 + s.power / 100), t: 4, by: h.id });\n  if (op.bleed) applyStatus(w, m, 'bleed', { dps: s.weaponDps * op.bleed * (1 + s.power / 100), t: 3, by: h.id });\n  if (op.poison) applyStatus(w, m, 'poison', { dps: s.weaponDps * op.poison * (1 + s.power / 100), t: 3, by: h.id });\n  if (op.slow) applyStatus(w, m, 'slow', { v: op.slow, t: 3 });\n  if (op.blind) m.blindT = op.blind;\n  if (op.mark) applyStatus(w, m, 'mark', { t: op.mark });\n  if (op.stun) stunMonster(w, m, op.stun);\n  if (op.root) { m.rootT = op.root; }\n  if (op.knock) knockMonster(w, m, c.ox ?? c.x, c.oz ?? c.z, op.knock);\n  if (op.pull) { const dx = c.x - m.x; const dz = c.z - m.z; const d = Math.hypot(dx, dz) || 1; if (!m.static) moveCircle(w, m, (dx / d) * Math.min(op.pull, d - 0.8), (dz / d) * Math.min(op.pull, d - 0.8), m.r * 0.6); }\n  if (op.homingNote) runOps(w, { ...c, x: m.x, z: m.z, ox: m.x, oz: m.z }, [{ op: 'projectile', speed: 12, range: 10, width: 0.5, dmg: 0.4, homing: 8, look: 'note', noRes: true }]);\n  if (h.powers.has('malisons_knuckle') && m.elite && !op.noChain) { for (const o of w.active) if (o !== m && !o.dead && o.pack === m.pack && o.pack && near(o, m.x, m.z, 10)) { heroHit(w, c, o, pct * 0.3, { noChain: true, noRes: true }); break; } }\n  if (m.hp <= 0) {\n    const overkill = -m.hp / Math.max(1, m.maxHp);\n    if (op.refundKill && c.sk?.cd) h.cds[c.sk.id] -= c.sk.cd * op.refundKill;\n    if (op.killExtend && c.buff) c.buff.dur += op.killExtend;\n    if (op.forkOnKill) for (let i = 0; i < op.forkOnKill; i++) {\n      const a = Math.atan2(c.ax, c.az) + (i ? 0.7 : -0.7);\n      fireProjectile(w, { ...c, x: m.x, z: m.z, ax: Math.sin(a), az: Math.cos(a) }, { speed: 18, range: 8, width: 0.5, dmg: pct * 0.6, look: 'spark', ignore: m.id });\n    }\n    killMonster(w, m, h, { overkill, ax: m.x - (c.ox ?? c.x), az: m.z - (c.oz ?? c.z) });\n  }\n  // Chain jumps.\n  if (op.chain) {\n    let from = m; const seen = new Set([m.id]);\n    for (let i = 0; i < op.chain.count; i++) {\n      let best = null; let bd = op.chain.range;\n      for (const o of w.active) { if (o.dead || seen.has(o.id)) continue; const d = Math.hypot(o.x - from.x, o.z - from.z); if (d < bd) { bd = d; best = o; } }\n      if (!best) break;\n      seen.add(best.id);\n      emit(w, { t: 'arc', x: from.x, z: from.z, x2: best.x, z2: best.z, element });\n      heroHit(w, c, best, pct * op.chain.mult, { noRes: true, element, noChain: true });\n      from = best;\n    }\n  }\n  return dmg;\n}\nexport function knockMonster(w, m, ox, oz, dist0) {\n  if (m.static || m.defn.boss) return;\n  const dx = m.x - ox; const dz = m.z - oz; const d = Math.hypot(dx, dz) || 1;\n  m.knockX = (dx / d) * dist0 * 6; m.knockZ = (dz / d) * dist0 * 6; m.knockT = 1 / 6;\n}\nexport function applyStatus(w, m, id, data) {\n  if (m.dead) return;\n  const old = m.status[id];\n  if (old && id !== 'curse') { old.t = Math.max(old.t, data.t); if (data.dps) old.dps = Math.max(old.dps, data.dps); if (data.v) old.v = Math.max(old.v, data.v); if (data.by) old.by = data.by; return; }\n  m.status[id] = { ...data };\n  emit(w, { t: 'mstatus', id: m.id, status: id, on: true });\n}\n\nconst inCone = (c, m, range, angle) => {\n  const dx = m.x - c.x; const dz = m.z - c.z; const d = Math.hypot(dx, dz);\n  if (d > range + m.r) return false;\n  if (d < m.r + 0.3) return true;\n  return (dx * c.ax + dz * c.az) / d >= Math.cos(((angle / 2) * Math.PI) / 180);\n};\nfunction hitProps(w, c, x, z, r, op) { for (const p of w.props) if (p.hp > 0 && !p.broken && near(p, x, z, r + 0.5)) w.hooks.breakProp(w, p, c.hero, x, z); }\n\nfunction areaBonus(c) { return c.hero ? 1 + (c.hero.stats.area ?? 0) * 0 : 1; }\n\nconst VFX = (w, kind, x, z, r, extra = {}) => emit(w, { t: 'vfx', kind, x, z, r, ...extra });\nfunction commonOpFx(w, c, op, x, z, r) {\n  if (op.vfx) VFX(w, op.vfx, x, z, r, op.op === 'cone' ? { ax: c.ax, az: c.az, angle: op.angle } : {});\n  if (op.sfx && op.op !== 'arc') emit(w, { t: 'sfx', id: op.sfx, x, z });\n  if (op.shake) emit(w, { t: 'shake', v: op.shake });\n  if (op.decal) emit(w, { t: 'decal', kind: op.decal, x, z, r });\n}\n\nconst OPS = {\n  arc(w, c, op) { for (const m of [...w.active]) if (inCone(c, m, op.range, op.angle)) { heroHit(w, c, m, op.dmg, op); c.targets++; } hitProps(w, c, c.x + c.ax * op.range * 0.6, c.z + c.az * op.range * 0.6, op.range * 0.6, op); commonOpFx(w, c, op, c.x, c.z, op.range); },\n  cone(w, c, op) { for (const m of [...w.active]) if (inCone(c, m, op.range, op.angle)) { heroHit(w, c, m, op.dmg, op); c.targets++; } hitProps(w, c, c.x + c.ax * op.range * 0.5, c.z + c.az * op.range * 0.5, op.range * 0.5, op); commonOpFx(w, c, op, c.x, c.z, op.range); },\n  circle(w, c, op) {\n    const at = op.at === 'origin' ? { x: c.ox, z: c.oz } : op.at === 'zoneTarget' ? { x: c.tx, z: c.tz } : { x: c.x, z: c.z };\n    for (const m of [...w.active]) if (near(m, at.x, at.z, op.radius + m.r)) { heroHit(w, { ...c, x: at.x, z: at.z, ox: at.x, oz: at.z }, m, op.dmg, op); c.targets++; }\n    hitProps(w, c, at.x, at.z, op.radius, op); commonOpFx(w, c, op, at.x, at.z, op.radius);\n  },\n  ring(w, c, op) { for (const m of [...w.active]) if (near(m, c.x, c.z, op.radius + m.r)) { heroHit(w, c, m, op.dmg, op); c.targets++; } hitProps(w, c, c.x, c.z, op.radius, op); commonOpFx(w, c, op, c.x, c.z, op.radius); },\n  projectile(w, c, op) {\n    const count = op.wickSplit && c.hero?.res > 70 ? 3 : op.count ?? 1; const spread = ((op.spread ?? (op.wickSplit ? 16 : 0)) * Math.PI) / 180;\n    for (let i = 0; i < count; i++) {\n      const a = Math.atan2(c.ax, c.az) + (count > 1 ? (i - (count - 1) / 2) * spread : 0);\n      fireProjectile(w, { ...c, ax: Math.sin(a), az: Math.cos(a) }, op);\n    }\n  },\n  lob(w, c, op) {\n    const count = op.count ?? 1;\n    for (let i = 0; i < count; i++) {\n      let tx = c.tx; let tz = c.tz;\n      const d = Math.hypot(tx - c.x, tz - c.z); const maxR = op.range ?? 14;\n      if (d > maxR) { tx = c.x + ((tx - c.x) / d) * maxR; tz = c.z + ((tz - c.z) / d) * maxR; }\n      if (i > 0 || count > 1) { const a = (i / count) * Math.PI * 2; tx += Math.cos(a) * (i === 0 ? 0 : op.spread ?? 2.5); tz += Math.sin(a) * (i === 0 ? 0 : op.spread ?? 2.5); }\n      const p = findOpenNear(w, tx, tz); tx = p.x; tz = p.z;\n      const delay = (op.time ?? 0.5) + i * 0.1;\n      emit(w, { t: 'lob', x: c.x, z: c.z, x2: tx, z2: tz, dur: delay, look: op.look ?? 'lantern' });\n      after(w, delay, () => { runOps(w, { ...c, x: tx, z: tz, ox: tx, oz: tz, tx, tz }, op.then ?? []); });\n    }\n  },\n  chain(w, c, op) {\n    let from = { x: c.x, z: c.z }; const seen = new Set();\n    for (let i = 0; i < op.count; i++) {\n      let best = null; let bd = op.range;\n      for (const o of w.active) { if (o.dead || seen.has(o.id)) continue; const d = Math.hypot(o.x - from.x, o.z - from.z); if (d < bd) { bd = d; best = o; } }\n      if (!best) break;\n      seen.add(best.id); emit(w, { t: 'arc', x: from.x, z: from.z, x2: best.x, z2: best.z });\n      heroHit(w, c, best, op.dmg, op); from = best;\n    }\n  },\n  dash(w, c, op) {\n    const h = c.hero; const v = op.dist / op.time; const hitIds = new Set(); const dragged = [];\n    c.ox = h.x; c.oz = h.z;\n    h.moveDash = { vx: c.ax * v, vz: c.az * v, t: op.time, inv: true,\n      step: (w2, he) => {\n        for (const m of [...w2.active]) {\n          if (m.dead || hitIds.has(m.id)) continue;\n          if (near(m, he.x, he.z, op.width + m.r)) { hitIds.add(m.id); heroHit(w2, { ...c, x: he.x, z: he.z, ox: he.x, oz: he.z }, m, op.dmg, { ...op, knock: op.drag ? 0 : op.shove ?? 2 }); if (op.drag && !m.dead && !m.static) dragged.push(m); }\n        }\n        for (const m of dragged) if (!m.dead) moveCircle(w2, m, c.ax * v * DT, c.az * v * DT, m.r * 0.6);\n        hitProps(w2, c, he.x, he.z, op.width, op);\n      } };\n    emit(w, { t: 'shake', v: 0.1 });\n  },\n  leap(w, c, op) {\n    const h = c.hero; let dx = c.tx - h.x; let dz = c.tz - h.z; let d = Math.hypot(dx, dz);\n    const r = op.range ?? 12; if (d > r) { dx *= r / d; dz *= r / d; d = r; }\n    const target = findOpenNear(w, h.x + dx, h.z + dz);\n    const time = op.time ?? 0.45; const vx = (target.x - h.x) / time; const vz = (target.z - h.z) / time;\n    h.moveDash = { vx, vz, t: time, inv: true, noClip: true, end: (w2, he) => { he.x = target.x; he.z = target.z; runOps(w2, { ...c, x: he.x, z: he.z, ox: he.x, oz: he.z }, op.then ?? []); } };\n    h.leapT = time; emit(w, { t: 'leap', id: h.id, dur: time });\n    c.tx = target.x; c.tz = target.z;\n  },\n  blink(w, c, op) {\n    const h = c.hero; const nav = w.zone.nav;\n    const maxD = nav.castWall(h.x, h.z, c.ax, c.az, op.dist);\n    let d = Math.max(0, maxD - 0.5);\n    let nx = h.x + c.ax * d; let nz = h.z + c.az * d;\n    const p = findOpenNear(w, nx, nz); nx = p.x; nz = p.z;\n    VFX(w, 'blink', h.x, h.z, 1); h.x = nx; h.z = nz; h.px = nx; h.pz = nz; VFX(w, 'blink', nx, nz, 1);\n    if (op.inv) h.invulnerable = Math.max(h.invulnerable, op.inv);\n    if (op.bringMinions) for (const a of w.allies) if (a.owner === h.id && a.minion) { a.x = nx + w.rngs.ai.range(-2, 2); a.z = nz + w.rngs.ai.range(-2, 2); const q = findOpenNear(w, a.x, a.z); a.x = q.x; a.z = q.z; }\n    runOps(w, { ...c, x: nx, z: nz }, op.then ?? []);\n  },\n  zone(w, c, op) {\n    const f = { id: w.nextId++, x: op.at === 'origin' ? c.ox : c.tx ?? c.x, z: op.at === 'origin' ? c.oz : c.tz ?? c.z, r: op.radius, t: op.dur, dur: op.dur, tick: op.tick ?? 0.5, tickT: 0, op, c: { ...c }, owner: c.hero?.id, follow: op.follow ? c.hero : null, ally: op.ally, ward: op.ward, look: op.look ?? 'shock', pull: op.pull, slow: op.slow };\n    if (!op.follow && c.sk?.fx?.[0]?.op !== 'zone' && c.tx === undefined) { f.x = c.x; f.z = c.z; }\n    w.fields.push(f);\n    emit(w, { t: 'field', id: f.id, x: f.x, z: f.z, r: f.r, dur: f.dur, look: f.look, follow: f.follow?.id ?? 0 });\n    if (op.onSfx) emit(w, { t: 'sfx', id: op.onSfx, x: f.x, z: f.z });\n  },\n  debuff(w, c, op) { OPS.zone(w, c, { ...op, tick: op.tick ?? 0.5, dmg: op.dmg ?? 0, isDebuff: true }); },\n  obstacle(w, c, op) {\n    const o = { id: w.nextId++, x: c.x, z: c.z, r: op.radius, t: op.dur, look: op.look ?? 'coffin' };\n    w.obstacles.push(o); emit(w, { t: 'obstacle', id: o.id, x: o.x, z: o.z, r: o.r, look: o.look, dur: o.t });\n  },\n  summon(w, c, op) { for (let i = 0; i < (op.count ?? 1); i++) w.hooks.summon(w, c, op); },\n  turret(w, c, op) {\n    const h = c.hero; const kind = op.kind;\n    const live = w.allies.filter((a) => a.kind === kind && a.owner === h.id && !a.dead);\n    if (op.max && live.length >= op.max) { live[0].dead = true; emit(w, { t: 'allygone', id: live[0].id }); }\n    const p = findOpenNear(w, c.tx ?? c.x, c.tz ?? c.z);\n    const a = { id: w.nextId++, kind, owner: h.id, seat: h.seat, x: p.x, z: p.z, px: p.x, pz: p.z, facing: 0, hp: 1e6, maxHp: 1e6, ttl: op.dur, rate: op.rate, rateT: 0.2, dmg: op.dmg, range: op.range ?? 10, radius: op.radius, taunt: op.taunt, arc: op.arc, healAura: op.healAura, endBlast: op.endBlast, setBolt: op.setBolt, c: { ...c }, turret: true, state: 'idle' };\n    w.allies.push(a); emit(w, { t: 'ally', id: a.id, kind, x: a.x, z: a.z, owner: h.id, seat: h.seat });\n  },\n  buff(w, c, op) {\n    const h = c.hero;\n    const b = { id: op.id, dur: op.dur, ...op }; delete b.op;\n    addBuff(w, h, b);\n    if (op.unseen) h.unseen = op.dur;\n  },\n  pull(w, c, op) { for (const m of w.active) if (near(m, c.x, c.z, op.radius)) { const d = Math.hypot(c.x - m.x, c.z - m.z) || 1; if (!m.static) moveCircle(w, m, ((c.x - m.x) / d) * op.dist, ((c.z - m.z) / d) * op.dist, m.r * 0.6); } },\n  knock(w, c, op) { for (const m of w.active) if (near(m, c.x, c.z, op.radius)) knockMonster(w, m, c.x, c.z, op.dist); },\n  stun(w, c, op) { for (const m of w.active) if (near(m, c.x, c.z, op.radius)) stunMonster(w, m, op.t); },\n  apply_status(w, c, op) { for (const m of w.active) if (near(m, c.x, c.z, op.radius)) applyStatus(w, m, op.status, { dps: (op.dps ?? 0) * (c.hero?.stats.weaponDps ?? 10), t: op.t, v: op.v, by: c.hero?.id }); },\n  consume_status(w, c, op) {\n    let n = 0;\n    for (const m of [...w.active]) {\n      const st = m.status[op.status]; if (m.dead || !st || !near(m, c.x, c.z, op.radius)) continue;\n      const pay = st.dps * st.t * op.mult; n++;\n      const payout = pay / Math.max(1, c.hero.stats.weaponDps);\n      delete m.status[op.status]; emit(w, { t: 'mstatus', id: m.id, status: op.status, on: false });\n      heroHit(w, c, m, payout, { element: 'flame', noBurn: true, stun: op.stun, resPerTarget: op.resPerTarget, sfx: 'hit_fire' });\n      if (op.relight && !m.dead) after(w, op.relight, () => { if (!m.dead) applyStatus(w, m, 'burn', { dps: st.dps, t: 4, by: c.hero.id }); });\n      VFX(w, 'burst_fire', m.x, m.z, 1);\n    }\n    if (op.mitts && n > 0) { gainResource(c.hero, (c.sk.cost ?? 40) * 0.5 * Math.floor(n / 10)); if (n >= 10) c.hero.cds.dusk_step = 0; }\n    commonOpFx(w, c, op, c.x, c.z, op.radius);\n    return n;\n  },\n  consume_graves(w, c, op) {\n    let n = 0;\n    const list = w.graves.filter((g) => near(g, c.x, c.z, op.radius)).slice(0, op.max);\n    const blast = (g, depth) => {\n      w.graves.splice(w.graves.indexOf(g), 1); n++;\n      emit(w, { t: 'graveburst', id: g.id, x: g.x, z: g.z });\n      for (const m of [...w.active]) if (near(m, g.x, g.z, op.blast + m.r)) heroHit(w, { ...c, ox: g.x, oz: g.z }, m, op.dmg, { element: 'grave', knock: 1 });\n      if (op.heal) healHero(w, c.hero, op.heal);\n      if (op.tithe) gainResource(c.hero, op.tithe);\n      if (op.rise) w.hooks.summon(w, { ...c, x: g.x, z: g.z }, { kind: 'pallbearer', dmg: 0.6, ttl: op.rise, max: 12 });\n      if (op.chainGraves && depth < 2) for (const o of [...w.graves]) if (near(o, g.x, g.z, op.blast)) blast(o, depth + 1);\n    };\n    for (const g of list) if (w.graves.includes(g)) blast(g, 0);\n    if (op.healMinions) for (const a of w.allies) if (a.owner === c.hero.id && a.minion) a.hp = a.maxHp;\n    if (n) emit(w, { t: 'shake', v: op.shake ?? 0.2 });\n    c.targets += n;\n  },\n  raise_graves(w, c, op) {\n    let n = 0;\n    for (const g of [...w.graves]) { if (n >= op.max || !near(g, c.x, c.z, op.radius)) continue; w.graves.splice(w.graves.indexOf(g), 1); w.hooks.summon(w, { ...c, x: g.x, z: g.z }, { kind: 'pallbearer', dmg: op.dmg, ttl: op.ttl, max: 30 }); n++; }\n    for (let i = n; i < 4; i++) w.hooks.summon(w, c, { kind: 'pallbearer', dmg: op.dmg, ttl: op.ttl, max: 30 });\n  },\n  detonate_minions(w, c, op) { for (const a of [...w.allies]) if (a.owner === c.hero.id && a.minion && !a.dead) { runOps(w, { ...c, x: a.x, z: a.z, ox: a.x, oz: a.z }, [{ op: 'circle', radius: op.radius, dmg: op.dmg, vfx: 'ring_grave', sfx: 'grave_burst' }]); a.dead = true; emit(w, { t: 'allygone', id: a.id, burst: true }); } },\n  comet_rain(w, c, op) {\n    const n = Math.round(op.dur * op.rate); const h = c.hero;\n    for (let i = 0; i < n; i++) after(w, i / op.rate, () => {\n      const rng = w.rngs.combat;\n      // Comets look for trouble: mostly on foes near the caster.\n      const near2 = w.active.filter((m) => !m.dead && near(m, h.x, h.z, op.area));\n      const m = near2.length ? rng.pick(near2) : null;\n      const tx = m ? m.x : h.x + rng.range(-op.area, op.area); const tz = m ? m.z : h.z + rng.range(-op.area, op.area);\n      emit(w, { t: 'lob', x: tx + 3, z: tz - 3, x2: tx, z2: tz, dur: 0.35, look: 'comet', high: true });\n      after(w, 0.35, () => runOps(w, { ...c, x: tx, z: tz, ox: tx, oz: tz, tx, tz, mult: c.mult }, [{ op: 'circle', radius: op.radius, dmg: op.dmg, vfx: 'ring_fire', sfx: 'explode_fire', decal: 'scorch', shake: 0.12 }]));\n      if (op.partyHeal) for (const he of w.heroes) healHero(w, he, op.partyHeal / op.rate);\n    });\n  },\n  delay(w, c, op) { after(w, op.t, () => { const cc = { ...c }; if (c.hero && !op.fixed) { cc.x = c.hero.x; cc.z = c.hero.z; cc.ox = cc.x; cc.oz = cc.z; } runOps(w, cc, op.then ?? []); }); },\n  repeat(w, c, op) { for (let i = 0; i < op.n; i++) after(w, i * op.every, () => runOps(w, c, op.then ?? [])); },\n  spawn_decoy(w, c, op) {\n    const a = { id: w.nextId++, kind: 'decoy', owner: c.hero.id, seat: c.hero.seat, x: c.x, z: c.z, px: c.x, pz: c.z, facing: 0, hp: 1e6, maxHp: 1e6, ttl: op.dur, taunt: true, turret: true, state: 'idle', rate: 99, rateT: 99 };\n    w.allies.push(a); emit(w, { t: 'ally', id: a.id, kind: 'decoy', x: a.x, z: a.z, owner: c.hero.id, seat: c.hero.seat });\n  },\n  trail(w, c, op) {\n    const steps = op.steps ?? 6;\n    for (let i = 0; i < steps; i++) after(w, i * 0.08, () => { const h = c.hero; OPS.zone(w, { ...c, tx: h.x, tz: h.z }, { op: 'zone', radius: op.radius, dur: op.dur, tick: 0.5, dmg: op.dmg, element: op.element, look: op.look ?? 'fire' }); });\n  },\n};\nexport const OP_IDS = Object.keys(OPS);\n\nexport function runOps(w, c, ops) { for (const op of ops) { const fn = OPS[op.op]; if (!fn) throw new Error(`unknown op ${op.op}`); if (op.count && op.op !== 'lob' && op.op !== 'projectile' && op.op !== 'summon' && op.op !== 'chain') { for (let i = 0; i < op.count; i++) fn(w, c, op); } else fn(w, c, op); } }\n\nexport function fireProjectile(w, c, op) {\n  const p = { id: w.nextId++, x: c.x, z: c.z, vx: c.ax * op.speed, vz: c.az * op.speed, speed: op.speed, travelled: 0, range: op.range, width: op.width ?? 0.5, op, c: { ...c }, pierce: op.pierce ? 99 : op.pierceN ?? 0, bounce: op.bounce ?? 0, homing: op.homing ?? 0, hit: new Set(op.ignore ? [op.ignore] : []), look: op.look, hostile: false };\n  w.projectiles.push(p);\n  emit(w, { t: 'proj', id: p.id, x: p.x, z: p.z, vx: p.vx, vz: p.vz, range: p.range, look: p.look, sfx: null, w: p.width });\n  return p;\n}\nexport function hostileProjectile(w, m, tx, tz, { speed = 7, range = 16, dmg = 1, look = 'note', width = 0.5, status = null } = {}) {\n  const dx = tx - m.x; const dz = tz - m.z; const d = Math.hypot(dx, dz) || 1;\n  const p = { id: w.nextId++, x: m.x, z: m.z, vx: (dx / d) * speed, vz: (dz / d) * speed, speed, travelled: 0, range, width, dmg, look, hostile: true, m, status };\n  w.projectiles.push(p);\n  emit(w, { t: 'proj', id: p.id, x: p.x, z: p.z, vx: p.vx, vz: p.vz, range, look, w: width, hostile: true });\n  return p;\n}\n\nexport function stepProjectiles(w) {\n  for (let i = w.projectiles.length - 1; i >= 0; i--) {\n    const p = w.projectiles[i]; let done = false;\n    if (p.homing) {\n      let best = null; let bd = 10;\n      for (const m of w.active) { if (m.dead || p.hit.has(m.id)) continue; const d = Math.hypot(m.x - p.x, m.z - p.z); if (d < bd) { bd = d; best = m; } }\n      if (best) { const dx = best.x - p.x; const dz = best.z - p.z; const d = Math.hypot(dx, dz) || 1; const k = p.homing * DT; p.vx += (dx / d) * p.speed * k; p.vz += (dz / d) * p.speed * k; const v = Math.hypot(p.vx, p.vz) || 1; p.vx = (p.vx / v) * p.speed; p.vz = (p.vz / v) * p.speed; }\n    }\n    const sx = p.vx * DT; const sz = p.vz * DT;\n    const nx = p.x + sx; const nz = p.z + sz;\n    const blocked = !walkableOrPit(w, nx, nz);\n    if (blocked) {\n      if (p.bounce > 0) { p.bounce--; if (!walkableOrPit(w, nx, p.z)) p.vx *= -1; if (!walkableOrPit(w, p.x, nz)) p.vz *= -1; emit(w, { t: 'projturn', id: p.id, x: p.x, z: p.z, vx: p.vx, vz: p.vz }); continue; }\n      done = true;\n    } else { p.x = nx; p.z = nz; p.travelled += p.speed * DT; if (p.travelled >= p.range) done = true; }\n    if (p.hostile) {\n      for (const f of w.fields) if (f.ward && near(p, f.x, f.z, f.r)) done = true;\n      for (const h of w.heroes) {\n        if (h.dead || h.left) continue;\n        if (near(h, p.x, p.z, p.width + 0.4)) {\n          w.hooks.hitHero(w, h, p.dmg, { m: p.m, name: p.m?.name, level: p.m?.level, blindable: true });\n          if (p.status === 'poison') { h.poisonT = 3; }\n          done = true; break;\n        }\n      }\n      for (const a of w.allies) if (!a.turret && !a.dead && near(a, p.x, p.z, p.width + 0.3)) { a.hp -= p.dmg; done = true; }\n    } else {\n      for (const m of w.active) {\n        if (m.dead || p.hit.has(m.id)) continue;\n        if (near(m, p.x, p.z, p.width + m.r)) {\n          p.hit.add(m.id);\n          const c = { ...p.c, x: p.x, z: p.z, ox: p.x - p.vx * 0.05, oz: p.z - p.vz * 0.05, ax: p.vx / p.speed, az: p.vz / p.speed };\n          heroHit(w, c, m, p.op.dmg, p.op);\n          if (p.op.burst) { for (const o of [...w.active]) if (o !== m && !o.dead && near(o, p.x, p.z, p.op.burst + o.r)) heroHit(w, c, o, p.op.dmg * 0.6, { ...p.op, burst: 0, chain: null }); VFX(w, 'burst_grave', p.x, p.z, p.op.burst); }\n          if (p.pierce <= 0) { done = true; break; }\n          p.pierce--;\n        }\n      }\n      for (const pr of w.props) if (pr.hp > 0 && !pr.broken && near(pr, p.x, p.z, 0.8)) { w.hooks.breakProp(w, pr, p.c.hero, p.x, p.z); if (!p.pierce) done = true; }\n    }\n    if (done) { w.projectiles.splice(i, 1); emit(w, { t: 'projend', id: p.id, x: p.x, z: p.z, look: p.look }); }\n  }\n}\nconst walkableOrPit = (w, x, z) => { const nav = w.zone.nav; const col = nav.col(x); const row = nav.row(z); if (row < 0 || col < 0 || row >= w.zone.h || col >= w.zone.w) return false; const ch = w.zone.rows[row][col]; if (ch === '#' || ch === ' ') return false; return true; };\n\nexport function stepFields(w) {\n  for (let i = w.fields.length - 1; i >= 0; i--) {\n    const f = w.fields[i]; f.t -= DT;\n    if (f.follow) { f.x = f.follow.x; f.z = f.follow.z; }\n    f.tickT -= DT;\n    if (f.tickT <= 0) {\n      f.tickT = f.tick; const op = f.op;\n      if (f.hostile) {\n        for (const h of w.heroes) if (!h.dead && !h.left && near(h, f.x, f.z, f.r)) { w.hooks.hitHero(w, h, f.dmg, { pure: false, level: f.level, name: f.name }); if (f.slow) { h.slowT = 1; h.slowV = f.slow; } }\n      } else {\n        if (op.dmg) for (const m of [...w.active]) if (!m.dead && near(m, f.x, f.z, f.r + m.r)) heroHit(w, { ...f.c, x: f.x, z: f.z, ox: f.x, oz: f.z }, m, op.dmg * (f.tick / 0.5), { element: op.element, noRes: true, noBurn: op.look !== 'fire' });\n        if (op.curse || f.slow || f.pull) for (const m of w.active) if (!m.dead && near(m, f.x, f.z, f.r + m.r)) {\n          if (op.curse) { m.status.curse = { v: op.curse, t: 0.7, by: f.owner, tithe: op.tithe }; }\n          if (f.slow) applyStatus(w, m, 'slow', { v: f.slow, t: 0.7 });\n          if (f.pull && !m.static) { const dx = f.x - m.x; const dz = f.z - m.z; const d = Math.hypot(dx, dz) || 1; moveCircle(w, m, (dx / d) * f.pull * f.tick * 0.5, (dz / d) * f.pull * f.tick * 0.5, m.r * 0.6); }\n        }\n        if (f.ally?.heal) for (const h of w.heroes) if (near(h, f.x, f.z, f.r)) healHero(w, h, f.ally.heal * f.tick);\n      }\n    }\n    if (f.t <= 0) { w.fields.splice(i, 1); emit(w, { t: 'fieldend', id: f.id }); }\n  }\n  for (let i = w.obstacles.length - 1; i >= 0; i--) { const o = w.obstacles[i]; o.t -= DT; if (o.t <= 0) { w.obstacles.splice(i, 1); emit(w, { t: 'obstacleend', id: o.id }); } }\n}\nexport const CLASS_INFO = CLASSES;\nexport { F };\nexport function spawnFloating() {}\nEOF\necho ok","description":"Write world, hero and effects sim modules"}}}
