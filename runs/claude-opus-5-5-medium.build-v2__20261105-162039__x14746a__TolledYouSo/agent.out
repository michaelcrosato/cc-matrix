{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkkNRJawBMsxeSjyJCh5","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GSPnNFe2ekUiYgurF1ndPA","name":"Bash","input":{"command":"cat > tests/browser/boot.test.mjs <<'EOF'\n// Boot: no page, console, game or GPU errors. The picture isn't blank. The bundle is one file: session.js byte-identical and first; metas present.\nimport { readFileSync } from 'node:fs';\nimport { ok, eq, guarded } from '../lib.mjs';\nimport { HTML, openGame, pressKey, step } from '../../tools/browser.mjs';\nawait guarded(async () => {\n  const html = readFileSync(HTML, 'utf8'); const session = readFileSync('session.js', 'utf8');\n  const first = html.indexOf('<script>'); ok(first > 0 && html.indexOf('<meta charset') < first, 'charset then the first script');\n  ok(html.slice(first + 8).startsWith(session), 'session.js byte-identical and first');\n  for (const m of ['hub:session', 'hub:session-players', 'hub:session-mode', 'hub:session-minutes', 'hub:session-goal', 'hub:session-howto', 'hub:webgpu']) ok(html.includes(`name=\"${m}\"`), `meta ${m}`);\n  ok(html.indexOf('hub:session') < html.indexOf('<title>'), 'metas before title');\n  ok(!/src=\"|href=\"http/.test(html.replace(/<script type=\"module\">[\\s\\S]*$/, '')), 'nothing external');\n  const { browser, page, errors } = await openGame({ width: 1280, height: 720 });\n  await step(page, 30);\n  const blank = await page.evaluate(async () => { const f = await E.renderer.capture(); const p = f.pixels; let lo = 255; let hi = 0; for (let i = 0; i < p.length; i += 97) { lo = Math.min(lo, p[i]); hi = Math.max(hi, p[i]); } return hi - lo; });\n  ok(blank > 8, `picture is not blank: ${blank}`);\n  const st = await page.evaluate(() => E.state()); eq(st.backend, 'webgpu', 'WebGPU in use'); eq(await page.evaluate(() => E.errors.length), 0, 'no game errors'); ok((st.gpuErrors?.length ?? 0) === 0, 'no GPU errors');\n  eq(st.game, 'Tolled You So', 'the page is the game');\n  await pressKey(page, 'Enter'); await step(page, 3); eq(await page.evaluate(() => G.shell.state), 'menu', 'menu');\n  eq(errors.length, 0, `no page errors: ${errors[0]}`);\n  await browser.close();\n});\nEOF\ncat > tests/browser/pad.test.mjs <<'EOF'\n// Pad only: press through title, hero select, play, skills, Hero screen, pause, dev mode, settings, quit. Glyphs follow the last device.\nimport { ok, eq, guarded } from '../lib.mjs';\nimport { openGame, step } from '../../tools/browser.mjs';\nconst padInit = () => {\n  const mk = (i) => ({ index: i, id: `stub ${i}`, connected: true, mapping: 'standard', buttons: Array.from({ length: 17 }, () => ({ pressed: false, value: 0, touched: false })), axes: [0, 0, 0, 0], timestamp: 0 });\n  window.__pads = [mk(0), null, null, null]; navigator.getGamepads = () => window.__pads;\n  window.__press = (i, b, on) => { const p = window.__pads[i]; p.buttons[b].pressed = on; p.buttons[b].value = on ? 1 : 0; };\n};\nexport const tap = async (page, b, pad = 0, n = 3) => { await page.evaluate(([x, y, k]) => { __press(y, x, true); E.step(k); __press(y, x, false); E.step(k); }, [b, pad, n]); };\nawait guarded(async () => {\n  const { browser, page, errors } = await openGame({ width: 1280, height: 720, init: padInit });\n  await step(page, 10);\n  const CROSS = 0; const CIRCLE = 1; const SQUARE = 2; const TRI = 3; const L1 = 4; const R1 = 5; const OPT = 9; const CREATE = 8; const DOWN = 13; const RIGHT = 15;\n  const st = () => page.evaluate(() => G.shell.state); const txt = () => page.evaluate(() => G.ui.drawnText.map((t) => t.text).join('|'));\n  await tap(page, CROSS); eq(await st(), 'menu', 'pad leaves the title');\n  eq(await page.evaluate(() => G.router.lastDevice), 'pad', 'last device is the pad');\n  await tap(page, CROSS); eq(await st(), 'newhero', 'NEW HERO by pad');\n  await tap(page, RIGHT); await tap(page, CROSS); ok((await txt()).includes('THE BEGINNING'), 'start choice');\n  await tap(page, DOWN); await page.evaluate(() => { G.ui.focus = 'n:last'; }); await step(page, 2); await tap(page, CROSS); await step(page, 3);\n  eq(await st(), 'play', 'in play by pad');\n  const cls = await page.evaluate(() => G.play.world.heroes[0].cls); eq(cls, 'lamplighter', 'second class by pad');\n  await step(page, 5);\n  eq(await page.evaluate(() => { G.ui.frameN; return G.ui.lastPromptKind; }), 'playstation', 'PlayStation glyphs');\n  // Moves with the stick, attacks with Cross.\n  const x0 = await page.evaluate(() => G.play.world.heroes[0].x + G.play.world.heroes[0].z);\n  await page.evaluate(() => { __pads[0].axes[1] = -1; E.step(30); __pads[0].axes[1] = 0; E.step(2); });\n  ok(Math.abs((await page.evaluate(() => G.play.world.heroes[0].x + G.play.world.heroes[0].z)) - x0) > 1, 'stick moves the hero');\n  await page.evaluate(() => { G.play.command({ c: 'dev', k: 'spawn', type: 'peatwalker' }, 0); E.step(2); }); const s0 = await page.evaluate(() => G.play.world.heroes[0].castSeq);\n  await tap(page, SQUARE); await step(page, 3); ok((await page.evaluate(() => G.play.world.heroes[0].castSeq)) > s0, 'Square casts a skill');\n  await page.evaluate(() => { G.play.world.heroes[0].dodgeCd = 0; }); await tap(page, 6); ok((await page.evaluate(() => G.play.world.heroes[0].dodges)) >= 1, 'L2 dodges');\n  await page.evaluate(() => { G.play.world.heroes[0].hp = 10; }); await tap(page, L1); ok((await page.evaluate(() => G.play.world.heroes[0].potions)) >= 1, 'L1 drinks');\n  // Hero screen on Create's release, tabs on L1 and R1.\n  await tap(page, CREATE); await step(page, 3); eq(await page.evaluate(() => G.play.menus.top?.type), 'hero', 'Create opens the Hero screen');\n  await tap(page, R1); ok((await txt()).includes('VOWS'), 'R1 goes to skills');\n  await tap(page, CROSS); ok((await txt()).includes('PICK A SKILL'), 'Cross opens the skill picker'); await tap(page, CIRCLE); ok((await txt()).includes('VOWS'), 'Circle backs out');\n  await tap(page, L1); ok((await txt()).includes('EQUIP'), 'L1 back to gear'); await tap(page, CIRCLE); eq(await page.evaluate(() => G.play.menus.open), false, 'Circle closes');\n  // Pause, dev mode, settings, quit.\n  await tap(page, OPT); ok((await txt()).includes('DEV MODE'), 'Options pauses');\n  await page.evaluate(() => { G.ui.focus = 'pause:DEV MODE'; }); await step(page, 2); await tap(page, CROSS); eq(await page.evaluate(() => G.play.menus.top?.type), 'dev', 'dev mode by pad');\n  await tap(page, R1); await tap(page, CIRCLE);\n  await page.evaluate(() => { G.ui.focus = 'pause:SETTINGS'; }); await step(page, 2); await tap(page, CROSS); ok((await txt()).includes('BUTTON GLYPHS'), 'settings by pad');\n  await page.evaluate(() => { G.ui.focus = 'set:BUTTON GLYPHS'; }); await step(page, 2); await tap(page, CROSS); await step(page, 2); eq(await page.evaluate(() => G.ui.glyphs), 'xbox', 'Xbox option');\n  eq(await page.evaluate(() => G.ui.lastPromptKind), 'xbox', 'Xbox glyphs drawn');\n  // A key press switches prompts to keycaps; a pad press switches back.\n  await page.evaluate(() => { E.input.setKey('KeyX', true); E.step(2); E.input.setKey('KeyX', false); E.step(2); }); eq(await page.evaluate(() => G.router.lastDevice), 'kbm', 'a key switches to keyboard'); eq(await page.evaluate(() => G.ui.lastPromptKind), 'key', 'keycaps drawn');\n  await tap(page, DOWN, 0, 2); eq(await page.evaluate(() => G.router.lastDevice), 'pad', 'a pad press switches back');\n  await tap(page, CIRCLE); await page.evaluate(() => { G.ui.focus = 'pause:SAVE AND QUIT'; }); await step(page, 2); await tap(page, CROSS); await step(page, 2); eq(await st(), 'menu', 'quit by pad');\n  void TRI;\n  eq(errors.length, 0, `no page errors: ${errors[0]}`); await browser.close();\n});\nEOF\ncat > tests/browser/mouse.test.mjs <<'EOF'\n// Mouse and keyboard only: hover moves focus, click activates, click-to-move moves, click on a monster attacks, every key works.\nimport { ok, eq, guarded } from '../lib.mjs';\nimport { openGame, pressKey, step } from '../../tools/browser.mjs';\nawait guarded(async () => {\n  const { browser, page, errors } = await openGame({ width: 1280, height: 720 });\n  const W = 427; const H = 240; const sx = 1280 / W; const sy = 720 / H;\n  await step(page, 10); await pressKey(page, 'Enter'); await step(page, 5);\n  const rect = (id) => page.evaluate((i) => { const w = G.ui.widgets.find((q) => q.id === i); return w && { x: w.x, y: w.y, w: w.w, h: w.h, W: G.ui.W, H: G.ui.H }; }, id);\n  const scale = await page.evaluate(() => [G.ui.W, G.ui.H]); const kx = 1280 / scale[0]; const ky = 720 / scale[1];\n  const moveTo = async (id) => { const r = await rect(id); await page.mouse.move((r.x + r.w / 2) * kx, (r.y + r.h / 2) * ky); await page.waitForTimeout(40); await step(page, 3); };\n  await moveTo('m:SETTINGS'); eq(await page.evaluate(() => G.ui.focus), 'm:SETTINGS', 'hover moves focus');\n  await moveTo('m:ABOUT'); eq(await page.evaluate(() => G.ui.focus), 'm:ABOUT', 'hover moves focus again');\n  await moveTo('m:NEW HERO'); await page.mouse.down(); await page.waitForTimeout(30); await step(page, 2); await page.mouse.up(); await page.waitForTimeout(30); await step(page, 3); eq(await page.evaluate(() => G.shell.state), 'newhero', 'click activates');\n  await moveTo('cl:bellwarden'); await page.mouse.down(); await page.waitForTimeout(30); await step(page, 2); await page.mouse.up(); await page.waitForTimeout(30); await step(page, 3);\n  await moveTo('n:last'); await page.mouse.down(); await page.waitForTimeout(30); await step(page, 2); await page.mouse.up(); await page.waitForTimeout(30); await step(page, 5);\n  eq(await page.evaluate(() => G.shell.state), 'play', 'in play by mouse');\n  await step(page, 30);\n  // Click to move.\n  const h0 = await page.evaluate(() => { const h = G.play.world.heroes[0]; return [h.x, h.z]; });\n  await page.mouse.move(900, 500); await page.waitForTimeout(30); await step(page, 2);\n  await page.mouse.down(); await page.waitForTimeout(30); await step(page, 3); await page.mouse.up(); await page.waitForTimeout(30); await step(page, 90);\n  const h1 = await page.evaluate(() => { const h = G.play.world.heroes[0]; return [h.x, h.z]; }); ok(Math.hypot(h1[0] - h0[0], h1[1] - h0[1]) > 1, `click-to-move moved: ${h0} to ${h1}`);\n  // Click on a monster attacks.\n  await page.evaluate(() => { const w = G.play.world; G.play.command({ c: 'dev', k: 'spawn', type: 'peatwalker' }, 0); E.step(3); const h = w.heroes[0]; const m = w.monsters.at(-1); m.x = h.x + 1.2; m.z = h.z - 1.2; m.px = m.x; m.pz = m.z; m.hp = m.maxHp = 1e6; E.step(3); });\n  const mp = await page.evaluate(() => { const w = G.play.world; const m = w.monsters.at(-1); const p = G.play.view.project(m.x, 0.8, m.z, G.ui); return [p.x, p.y]; });\n  const seq0 = await page.evaluate(() => G.play.world.heroes[0].castSeq);\n  await page.mouse.move(mp[0] * kx, mp[1] * ky); await page.waitForTimeout(30); await step(page, 2); await page.mouse.down(); await page.waitForTimeout(30); await step(page, 10); await page.mouse.up(); await page.waitForTimeout(30); await step(page, 10);\n  ok((await page.evaluate(() => G.play.world.heroes[0].castSeq)) > seq0, 'click on a monster attacks');\n  // Every key in the table.\n  const hero = (f) => page.evaluate(`(() => { const h = G.play.world.heroes[0]; return ${f}; })()`);\n  const pos0 = await hero('[h.x,h.z]'); await page.evaluate(() => { E.input.setKey('KeyW', true); E.step(20); E.input.setKey('KeyW', false); E.step(2); }); const pos1 = await hero('[h.x,h.z]'); ok(Math.hypot(pos1[0] - pos0[0], pos1[1] - pos0[1]) > 0.5, 'W moves');\n  await page.evaluate(() => { E.input.setKey('ArrowLeft', true); E.step(20); E.input.setKey('ArrowLeft', false); E.step(2); }); ok(Math.hypot((await hero('h.x')) - pos1[0], (await hero('h.z')) - pos1[1]) > 0.5, 'arrows move');\n  await page.evaluate(() => { G.play.world.heroes[0].dodgeCd = 0; }); await pressKey(page, 'Space'); ok((await hero('h.dodges')) >= 1, 'Space dodges');\n  await page.evaluate(() => { G.play.world.heroes[0].hp = 5; G.play.world.heroes[0].potionCd = 0; }); await pressKey(page, 'KeyQ'); ok((await hero('h.potions')) >= 1, 'Q drinks');\n  for (const k of ['Digit1', 'Digit2', 'Digit3', 'Digit4']) { await page.evaluate(() => { const w = G.play.world; w.cheats.noCd = true; w.cheats.infRes = true; E.step(50); }); const s = await hero('h.castSeq'); await pressKey(page, k, 4); await step(page, 5); ok((await hero('h.castSeq')) > s, `${k} casts`); }\n  await page.evaluate(() => { const w = G.play.world; const h = w.heroes[0]; h.inv.length = 0; }); const open = async (k, t) => { await step(page, 80); await pressKey(page, k); await step(page, 3); eq(await page.evaluate(() => G.play.menus.top?.type), t, `${k} opens ${t}`); await pressKey(page, 'Escape'); await step(page, 3); };\n  await open('KeyI', 'hero'); await open('KeyC', 'hero'); await open('KeyK', 'hero'); await open('KeyL', 'hero'); await open('KeyM', 'map'); await open('Tab', 'map');\n  await pressKey(page, 'Escape'); await step(page, 3); eq(await page.evaluate(() => G.play.menus.top?.type), 'pause', 'Esc pauses'); await pressKey(page, 'Escape'); await step(page, 3);\n  await page.evaluate(() => { const w = G.play.world; const h = w.heroes[0]; const it = { uid: 'zz', slot: 'ring', rarity: 'reliquary', ilvl: 30, affixes: [{ k: 'power', v: 500 }], name: 'TEST RING', flavour: '' }; h.inv.push(it); h.newest = 'zz'; }); await pressKey(page, 'KeyF'); eq(await hero('h.gear.ring.uid'), 'zz', 'F equips the newest upgrade');\n  await page.evaluate(() => { G.play.command({ c: 'dev', k: 'boss', zone: 'causeway' }, 0); E.input.setKey('KeyT', true); E.step(100); E.input.setKey('KeyT', false); E.step(3); }); eq(await page.evaluate(() => G.play.world.zone.id), 'town', 'hold T: the Passing Bell');\n  await page.evaluate(() => { E.input.setKey('AltLeft', true); E.step(2); }); ok(await page.evaluate(() => G.router.showLabels), 'Alt shows labels'); await page.evaluate(() => { E.input.setKey('AltLeft', false); E.step(2); });\n  eq(errors.length, 0, `no page errors: ${errors[0]}`); await browser.close();\n});\nEOF\ncat > tests/browser/couch.test.mjs <<'EOF'\n// Couch: 4 stub pads join, each moves its own hero, camera holds them.\nimport { ok, eq, guarded } from '../lib.mjs';\nimport { openGame, pressKey, step } from '../../tools/browser.mjs';\nconst padInit = () => {\n  const mk = (i) => ({ index: i, id: `stub ${i}`, connected: true, mapping: 'standard', buttons: Array.from({ length: 17 }, () => ({ pressed: false, value: 0, touched: false })), axes: [0, 0, 0, 0], timestamp: 0 });\n  window.__pads = [mk(0), mk(1), mk(2), mk(3)]; navigator.getGamepads = () => window.__pads;\n  window.__press = (i, b, on) => { const p = window.__pads[i]; p.buttons[b].pressed = on; p.buttons[b].value = on ? 1 : 0; };\n};\nawait guarded(async () => {\n  const { browser, page, errors } = await openGame({ width: 1280, height: 720, init: padInit });\n  const tap = async (b, pad = 0, n = 3) => { await page.evaluate(([x, y, k]) => { __press(y, x, true); E.step(k); __press(y, x, false); E.step(k); }, [b, pad, n]); };\n  await step(page, 10); await tap(0); await tap(0); await tap(0); await page.evaluate(() => { G.ui.focus = 'n:last'; }); await step(page, 2); await tap(0); await step(page, 5);\n  eq(await page.evaluate(() => G.shell.state), 'play', 'seat one plays');\n  for (const pad of [1, 2, 3]) {\n    await tap(9, pad); await step(page, 3); eq(await page.evaluate(() => G.play.menus.top?.type), 'joinclass', `pad ${pad} is asked to pick a trade`);\n    await page.evaluate((c) => { G.ui.focus = `jc:${c}`; }, ['lamplighter', 'sexton', 'bellwarden'][pad - 1]); await step(page, 2); await tap(0, pad); await step(page, 3);\n  }\n  eq(await page.evaluate(() => G.play.world.heroes.filter((h) => !h.left).length), 4, 'four heroes in the party'); eq(await page.evaluate(() => G.play.local.length), 4, 'four local seats');\n  // Each pad moves its own hero.\n  for (const pad of [0, 1, 2, 3]) {\n    const before = await page.evaluate(() => G.play.world.heroes.map((h) => [h.x, h.z]));\n    await page.evaluate((i) => { __pads[i].axes[0] = i % 2 ? 1 : -1; E.step(20); __pads[i].axes[0] = 0; E.step(2); }, pad);\n    const after = await page.evaluate(() => G.play.world.heroes.map((h) => [h.x, h.z]));\n    const seat = await page.evaluate((i) => G.router.padSeat[i], pad);\n    ok(seat === pad, `pad ${pad} holds seat ${seat}`);\n    for (let s = 0; s < 4; s++) { const d = Math.hypot(after[s][0] - before[s][0], after[s][1] - before[s][1]); if (s === seat) ok(d > 0.5, `pad ${pad} moved its hero: ${d}`); else ok(d < 0.3, `pad ${pad} left seat ${s} alone: ${d}`); }\n  }\n  // Camera holds them: zoomed out, all on screen.\n  await page.evaluate(() => { __pads[0].axes[0] = -1; __pads[3].axes[0] = 1; E.step(90); __pads[0].axes[0] = 0; __pads[3].axes[0] = 0; E.step(30); });\n  ok((await page.evaluate(() => E.camera.zoom)) < 1, 'camera zooms out');\n  const onScreen = await page.evaluate(() => G.play.world.heroes.every((h) => { const p = G.play.view.project(h.x, 1, h.z, G.ui); return p.x > 0 && p.x < G.ui.W && p.y > 0 && p.y < G.ui.H; })); ok(onScreen, 'all heroes on screen');\n  const txt = await page.evaluate(() => G.ui.drawnText.map((t) => t.text).join('|')); ok(txt.includes('LV 30 LAMPLIGHTER') || /Lamplighter/i.test(txt), 'couch panels drawn');\n  ok(await page.evaluate(() => G.play.view.heroes.size === 4), 'four actors');\n  // Pause is one seat's: its panel only takes that pad.\n  await tap(9, 2); await step(page, 2); eq(await page.evaluate(() => G.play.menus.top?.type), 'pause', 'seat 3 pauses'); eq(await page.evaluate(() => G.game?.menuOwner ?? G.menuOwner), 2, 'seat owns the menu');\n  await pressKey(page, 'Escape'); await step(page, 3);\n  eq(errors.length, 0, `no page errors: ${errors[0]}`); await browser.close();\n});\nEOF\ncat > tests/browser/touch.test.mjs <<'EOF'\n// Touch-only: phone and tablet profiles. Message present and wrapped, settings button present, no touch controls, attract running, a tap doesn't start a game.\nimport { devices } from 'playwright';\nimport { ok, eq, guarded } from '../lib.mjs';\nimport { openGame, step } from '../../tools/browser.mjs';\nawait guarded(async () => {\n  for (const name of ['Pixel 7', 'Galaxy Tab S4']) {\n    const d = devices[name]; const { browser, page, errors } = await openGame({ width: d.viewport.width, height: d.viewport.height, context: { ...d, viewport: d.viewport } });\n    eq(await page.evaluate(() => G.touchOnly), true, `${name}: detected as touch-only`);\n    await step(page, 10);\n    eq(await page.evaluate(() => G.shell.state), 'touch', `${name}: touch screen`);\n    const msg = await page.evaluate(() => G.ui.drawnText.map((t) => t.text).join(' ')); ok(msg.replace(/\\s+/g, ' ').includes('CONTROLLER OR KEYBOARD REQUIRED'), `${name}: message`);\n    const inside = await page.evaluate(() => G.ui.drawnText.every((t) => t.x >= 0 && t.x + t.w <= G.ui.W)); ok(inside, `${name}: message wrapped to the screen`);\n    eq(await page.evaluate(() => E.touch), null, `${name}: no touch controls`);\n    ok(await page.evaluate(() => !!document.querySelector('.settings-button')), `${name}: settings button present`);\n    await step(page, 620); eq(await page.evaluate(() => G.shell.state), 'attract', `${name}: attract runs`);\n    const b = await page.evaluate(() => ({ s: G.ui.drawnText.map((t) => t.text).join(' ') })); ok(b.s.includes('DEMO'), `${name}: demo tag`);\n    await page.touchscreen.tap(d.viewport.width / 2, d.viewport.height / 2); await page.waitForTimeout(60); await step(page, 3);\n    eq(await page.evaluate(() => G.shell.state), 'touch', `${name}: a tap returns to the message`);\n    await page.touchscreen.tap(d.viewport.width / 2, d.viewport.height / 2); await page.waitForTimeout(60); await step(page, 5);\n    eq(await page.evaluate(() => G.shell.state), 'touch', `${name}: a tap does not start a game`);\n    eq(errors.length, 0, `${name}: no page errors: ${errors[0]}`); await browser.close();\n  }\n});\nEOF\ncat > tests/browser/sound.test.mjs <<'EOF'\n// Sound, by what Web Audio produces: an AnalyserNode on everything reaching the destination.\nimport { ok, eq, guarded } from '../lib.mjs';\nimport { openGame, pressKey, step } from '../../tools/browser.mjs';\nconst init = () => {\n  const c = AudioNode.prototype.connect; window.__an = null;\n  AudioNode.prototype.connect = function (dest, ...rest) { const ctx = this.context; if (dest === ctx.destination) { if (!window.__an) { window.__an = ctx.createAnalyser(); window.__an.fftSize = 2048; window.__an.smoothingTimeConstant = 0; } c.call(this, window.__an); } return c.call(this, dest, ...rest); };\n  window.__level = () => { const a = window.__an; if (!a) return 0; const b = new Float32Array(a.fftSize); a.getFloatTimeDomainData(b); let p = 0; for (const v of b) p = Math.max(p, Math.abs(v)); return p; };\n  window.__peak = async (ms) => { let p = 0; const t0 = performance.now(); while (performance.now() - t0 < ms) { p = Math.max(p, window.__level()); await new Promise((r) => setTimeout(r, 15)); } return p; };\n};\nawait guarded(async () => {\n  const { browser, page, errors } = await openGame({ width: 640, height: 360, init });\n  await page.keyboard.press('Enter'); await page.waitForTimeout(100); await page.evaluate(() => { E.manual = false; });\n  await page.waitForTimeout(800); ok(await page.evaluate(() => E.audio.unlocked), 'key unlocks audio'); eq(await page.evaluate(() => E.audio.volume.music), 0.1, 'music 10%');\n  const m = await page.evaluate(() => __peak(2500)); ok(m > 0.0002, `music alone gives a level: ${m}`);\n  await page.evaluate(() => E.audio.play('bell_big', { volume: 1 })); const sfx = await page.evaluate(() => __peak(700)); ok(sfx > m * 2, `an effect stands well above the music: ${sfx} vs ${m}`);\n  await page.evaluate(() => { E.audio.playMusic(null); }); await page.waitForTimeout(1200); await page.evaluate(() => G.voice.say('crier', 'Hear ye, hear ye! The dead are up.')); const v = await page.evaluate(async () => { const t0 = performance.now(); let p = 0; while (performance.now() - t0 < 1000) { p = Math.max(p, __level()); await new Promise((r) => setTimeout(r, 10)); } return p; }); ok(v > 0.001, `a spoken line produces sound: ${v}`);\n  void pressKey; void step;\n  eq(errors.length, 0, `no page errors: ${errors[0]}`); await browser.close();\n});\nEOF\ncat > tests/browser/layout.test.mjs <<'EOF'\n// Layout: drawn text stays inside the screen at three sizes, with no overlaps on each screen.\nimport { ok, guarded } from '../lib.mjs';\nimport { openGame, pressKey, step } from '../../tools/browser.mjs';\nawait guarded(async () => {\n  for (const [W, H] of [[1280, 720], [1920, 1080], [2560, 1440]]) {\n    const { browser, page, errors } = await openGame({ width: W, height: H });\n    const check = async (name) => {\n      const r = await page.evaluate(() => { const tt = G.ui.drawnText.filter((t) => !t.world && t.text.trim()); const out = []; for (const t of tt) if (t.x < 0 || t.y < 0 || t.x + t.w > G.ui.W + 1 || t.y + t.h > G.ui.H + 1) out.push(`off: ${t.text}`); for (let i = 0; i < tt.length; i++) for (let j = i + 1; j < tt.length; j++) { const a = tt[i]; const b = tt[j]; if (a.x < b.x + b.w && b.x < a.x + a.w && a.y < b.y + b.h && b.y < a.y + a.h) out.push(`overlap: ${a.text} / ${b.text}`); } return { out, size: [G.ui.W, G.ui.H] }; });\n      ok(r.out.length === 0, `${W}x${H} [${r.size}] ${name}: ${r.out.slice(0, 3).join('; ').slice(0, 220)}`);\n    };\n    await step(page, 10); await check('title');\n    await pressKey(page, 'Enter'); await step(page, 3); await check('menu');\n    await page.evaluate(() => { G.ui.focus = 'm:SETTINGS'; }); await step(page, 2); await pressKey(page, 'Enter'); await step(page, 3); await check('settings'); await pressKey(page, 'Escape'); await step(page, 3);\n    await page.evaluate(() => { G.ui.focus = 'm:ABOUT'; }); await step(page, 2); await pressKey(page, 'Enter'); await step(page, 3); await check('about'); await pressKey(page, 'Escape'); await step(page, 3);\n    await page.evaluate(() => { G.ui.focus = 'm:NEW HERO'; }); await step(page, 2); await pressKey(page, 'Enter'); await step(page, 3); await check('new hero');\n    await pressKey(page, 'Enter'); await step(page, 3); await check('start choice');\n    await page.evaluate(() => { G.ui.focus = 'n:last'; }); await step(page, 2); await pressKey(page, 'Enter'); await step(page, 40); await check('hud');\n    await page.evaluate(() => { const w = G.play.world; G.play.hud.toasts = []; G.play.hud.banner = null; }); await step(page, 2); await check('hud quiet');\n    const screen = async (t, data, name, tabs = 1) => { await page.evaluate(([a, b]) => { G.play.menus.push(a, b); }, [t, data]); await step(page, 3); await check(name ?? t); for (let i = 1; i < tabs; i++) { await pressKey(page, 'KeyE'); await step(page, 3); await check(`${name ?? t} tab ${i + 1}`); } await page.evaluate(() => { G.play.menus.closeAll(); }); await step(page, 3); };\n    await screen('pause', {}); await screen('hero', {}, 'hero', 5); await screen('vendor', {}, 'vendor', 3); await screen('brasse', {}, 'brasse', 3); await screen('ogive', {}, 'ogive', 4); await screen('stash', {}, 'stash'); await screen('map', {}, 'map'); await screen('party', {}, 'party'); await screen('howto', {}, 'how to play'); await screen('knell', {}, 'knell', 3); await screen('writs', {}, 'writs'); await screen('dev', {}, 'dev', 8);\n    ok(errors.length === 0, `no page errors: ${errors[0]}`); await browser.close();\n  }\n});\nEOF\nfor t in boot pad mouse couch touch sound layout; do echo \"== $t\"; (time node tests/browser/$t.test.mjs) 2>&1 | cut -c1-330 | grep -vE \"^(user|sys|$)\" | tail -14; done","description":"Write and run the browser test tier","timeout":590000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1316,"cache_read_input_tokens":731040,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1316},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"69254de6-4061-470e-8e76-10f1ee96c6e5","uuid":"de25e22c-463e-4adb-84df-56c446689567","timestamp":"2026-11-06T00:45:40.364Z","request_id":"req_011CgkkNQzyZD4okt2uSn1Po","wire_tool_inputs":{"toolu_01GSPnNFe2ekUiYgurF1ndPA":{"command":"cat > tests/browser/boot.test.mjs <<'EOF'\n// Boot: no page, console, game or GPU errors. The picture isn't blank. The bundle is one file: session.js byte-identical and first; metas present.\nimport { readFileSync } from 'node:fs';\nimport { ok, eq, guarded } from '../lib.mjs';\nimport { HTML, openGame, pressKey, step } from '../../tools/browser.mjs';\nawait guarded(async () => {\n  const html = readFileSync(HTML, 'utf8'); const session = readFileSync('session.js', 'utf8');\n  const first = html.indexOf('<script>'); ok(first > 0 && html.indexOf('<meta charset') < first, 'charset then the first script');\n  ok(html.slice(first + 8).startsWith(session), 'session.js byte-identical and first');\n  for (const m of ['hub:session', 'hub:session-players', 'hub:session-mode', 'hub:session-minutes', 'hub:session-goal', 'hub:session-howto', 'hub:webgpu']) ok(html.includes(`name=\"${m}\"`), `meta ${m}`);\n  ok(html.indexOf('hub:session') < html.indexOf('<title>'), 'metas before title');\n  ok(!/src=\"|href=\"http/.test(html.replace(/<script type=\"module\">[\\s\\S]*$/, '')), 'nothing external');\n  const { browser, page, errors } = await openGame({ width: 1280, height: 720 });\n  await step(page, 30);\n  const blank = await page.evaluate(async () => { const f = await E.renderer.capture(); const p = f.pixels; let lo = 255; let hi = 0; for (let i = 0; i < p.length; i += 97) { lo = Math.min(lo, p[i]); hi = Math.max(hi, p[i]); } return hi - lo; });\n  ok(blank > 8, `picture is not blank: ${blank}`);\n  const st = await page.evaluate(() => E.state()); eq(st.backend, 'webgpu', 'WebGPU in use'); eq(await page.evaluate(() => E.errors.length), 0, 'no game errors'); ok((st.gpuErrors?.length ?? 0) === 0, 'no GPU errors');\n  eq(st.game, 'Tolled You So', 'the page is the game');\n  await pressKey(page, 'Enter'); await step(page, 3); eq(await page.evaluate(() => G.shell.state), 'menu', 'menu');\n  eq(errors.length, 0, `no page errors: ${errors[0]}`);\n  await browser.close();\n});\nEOF\ncat > tests/browser/pad.test.mjs <<'EOF'\n// Pad only: press through title, hero select, play, skills, Hero screen, pause, dev mode, settings, quit. Glyphs follow the last device.\nimport { ok, eq, guarded } from '../lib.mjs';\nimport { openGame, step } from '../../tools/browser.mjs';\nconst padInit = () => {\n  const mk = (i) => ({ index: i, id: `stub ${i}`, connected: true, mapping: 'standard', buttons: Array.from({ length: 17 }, () => ({ pressed: false, value: 0, touched: false })), axes: [0, 0, 0, 0], timestamp: 0 });\n  window.__pads = [mk(0), null, null, null]; navigator.getGamepads = () => window.__pads;\n  window.__press = (i, b, on) => { const p = window.__pads[i]; p.buttons[b].pressed = on; p.buttons[b].value = on ? 1 : 0; };\n};\nexport const tap = async (page, b, pad = 0, n = 3) => { await page.evaluate(([x, y, k]) => { __press(y, x, true); E.step(k); __press(y, x, false); E.step(k); }, [b, pad, n]); };\nawait guarded(async () => {\n  const { browser, page, errors } = await openGame({ width: 1280, height: 720, init: padInit });\n  await step(page, 10);\n  const CROSS = 0; const CIRCLE = 1; const SQUARE = 2; const TRI = 3; const L1 = 4; const R1 = 5; const OPT = 9; const CREATE = 8; const DOWN = 13; const RIGHT = 15;\n  const st = () => page.evaluate(() => G.shell.state); const txt = () => page.evaluate(() => G.ui.drawnText.map((t) => t.text).join('|'));\n  await tap(page, CROSS); eq(await st(), 'menu', 'pad leaves the title');\n  eq(await page.evaluate(() => G.router.lastDevice), 'pad', 'last device is the pad');\n  await tap(page, CROSS); eq(await st(), 'newhero', 'NEW HERO by pad');\n  await tap(page, RIGHT); await tap(page, CROSS); ok((await txt()).includes('THE BEGINNING'), 'start choice');\n  await tap(page, DOWN); await page.evaluate(() => { G.ui.focus = 'n:last'; }); await step(page, 2); await tap(page, CROSS); await step(page, 3);\n  eq(await st(), 'play', 'in play by pad');\n  const cls = await page.evaluate(() => G.play.world.heroes[0].cls); eq(cls, 'lamplighter', 'second class by pad');\n  await step(page, 5);\n  eq(await page.evaluate(() => { G.ui.frameN; return G.ui.lastPromptKind; }), 'playstation', 'PlayStation glyphs');\n  // Moves with the stick, attacks with Cross.\n  const x0 = await page.evaluate(() => G.play.world.heroes[0].x + G.play.world.heroes[0].z);\n  await page.evaluate(() => { __pads[0].axes[1] = -1; E.step(30); __pads[0].axes[1] = 0; E.step(2); });\n  ok(Math.abs((await page.evaluate(() => G.play.world.heroes[0].x + G.play.world.heroes[0].z)) - x0) > 1, 'stick moves the hero');\n  await page.evaluate(() => { G.play.command({ c: 'dev', k: 'spawn', type: 'peatwalker' }, 0); E.step(2); }); const s0 = await page.evaluate(() => G.play.world.heroes[0].castSeq);\n  await tap(page, SQUARE); await step(page, 3); ok((await page.evaluate(() => G.play.world.heroes[0].castSeq)) > s0, 'Square casts a skill');\n  await page.evaluate(() => { G.play.world.heroes[0].dodgeCd = 0; }); await tap(page, 6); ok((await page.evaluate(() => G.play.world.heroes[0].dodges)) >= 1, 'L2 dodges');\n  await page.evaluate(() => { G.play.world.heroes[0].hp = 10; }); await tap(page, L1); ok((await page.evaluate(() => G.play.world.heroes[0].potions)) >= 1, 'L1 drinks');\n  // Hero screen on Create's release, tabs on L1 and R1.\n  await tap(page, CREATE); await step(page, 3); eq(await page.evaluate(() => G.play.menus.top?.type), 'hero', 'Create opens the Hero screen');\n  await tap(page, R1); ok((await txt()).includes('VOWS'), 'R1 goes to skills');\n  await tap(page, CROSS); ok((await txt()).includes('PICK A SKILL'), 'Cross opens the skill picker'); await tap(page, CIRCLE); ok((await txt()).includes('VOWS'), 'Circle backs out');\n  await tap(page, L1); ok((await txt()).includes('EQUIP'), 'L1 back to gear'); await tap(page, CIRCLE); eq(await page.evaluate(() => G.play.menus.open), false, 'Circle closes');\n  // Pause, dev mode, settings, quit.\n  await tap(page, OPT); ok((await txt()).includes('DEV MODE'), 'Options pauses');\n  await page.evaluate(() => { G.ui.focus = 'pause:DEV MODE'; }); await step(page, 2); await tap(page, CROSS); eq(await page.evaluate(() => G.play.menus.top?.type), 'dev', 'dev mode by pad');\n  await tap(page, R1); await tap(page, CIRCLE);\n  await page.evaluate(() => { G.ui.focus = 'pause:SETTINGS'; }); await step(page, 2); await tap(page, CROSS); ok((await txt()).includes('BUTTON GLYPHS'), 'settings by pad');\n  await page.evaluate(() => { G.ui.focus = 'set:BUTTON GLYPHS'; }); await step(page, 2); await tap(page, CROSS); await step(page, 2); eq(await page.evaluate(() => G.ui.glyphs), 'xbox', 'Xbox option');\n  eq(await page.evaluate(() => G.ui.lastPromptKind), 'xbox', 'Xbox glyphs drawn');\n  // A key press switches prompts to keycaps; a pad press switches back.\n  await page.evaluate(() => { E.input.setKey('KeyX', true); E.step(2); E.input.setKey('KeyX', false); E.step(2); }); eq(await page.evaluate(() => G.router.lastDevice), 'kbm', 'a key switches to keyboard'); eq(await page.evaluate(() => G.ui.lastPromptKind), 'key', 'keycaps drawn');\n  await tap(page, DOWN, 0, 2); eq(await page.evaluate(() => G.router.lastDevice), 'pad', 'a pad press switches back');\n  await tap(page, CIRCLE); await page.evaluate(() => { G.ui.focus = 'pause:SAVE AND QUIT'; }); await step(page, 2); await tap(page, CROSS); await step(page, 2); eq(await st(), 'menu', 'quit by pad');\n  void TRI;\n  eq(errors.length, 0, `no page errors: ${errors[0]}`); await browser.close();\n});\nEOF\ncat > tests/browser/mouse.test.mjs <<'EOF'\n// Mouse and keyboard only: hover moves focus, click activates, click-to-move moves, click on a monster attacks, every key works.\nimport { ok, eq, guarded } from '../lib.mjs';\nimport { openGame, pressKey, step } from '../../tools/browser.mjs';\nawait guarded(async () => {\n  const { browser, page, errors } = await openGame({ width: 1280, height: 720 });\n  const W = 427; const H = 240; const sx = 1280 / W; const sy = 720 / H;\n  await step(page, 10); await pressKey(page, 'Enter'); await step(page, 5);\n  const rect = (id) => page.evaluate((i) => { const w = G.ui.widgets.find((q) => q.id === i); return w && { x: w.x, y: w.y, w: w.w, h: w.h, W: G.ui.W, H: G.ui.H }; }, id);\n  const scale = await page.evaluate(() => [G.ui.W, G.ui.H]); const kx = 1280 / scale[0]; const ky = 720 / scale[1];\n  const moveTo = async (id) => { const r = await rect(id); await page.mouse.move((r.x + r.w / 2) * kx, (r.y + r.h / 2) * ky); await page.waitForTimeout(40); await step(page, 3); };\n  await moveTo('m:SETTINGS'); eq(await page.evaluate(() => G.ui.focus), 'm:SETTINGS', 'hover moves focus');\n  await moveTo('m:ABOUT'); eq(await page.evaluate(() => G.ui.focus), 'm:ABOUT', 'hover moves focus again');\n  await moveTo('m:NEW HERO'); await page.mouse.down(); await page.waitForTimeout(30); await step(page, 2); await page.mouse.up(); await page.waitForTimeout(30); await step(page, 3); eq(await page.evaluate(() => G.shell.state), 'newhero', 'click activates');\n  await moveTo('cl:bellwarden'); await page.mouse.down(); await page.waitForTimeout(30); await step(page, 2); await page.mouse.up(); await page.waitForTimeout(30); await step(page, 3);\n  await moveTo('n:last'); await page.mouse.down(); await page.waitForTimeout(30); await step(page, 2); await page.mouse.up(); await page.waitForTimeout(30); await step(page, 5);\n  eq(await page.evaluate(() => G.shell.state), 'play', 'in play by mouse');\n  await step(page, 30);\n  // Click to move.\n  const h0 = await page.evaluate(() => { const h = G.play.world.heroes[0]; return [h.x, h.z]; });\n  await page.mouse.move(900, 500); await page.waitForTimeout(30); await step(page, 2);\n  await page.mouse.down(); await page.waitForTimeout(30); await step(page, 3); await page.mouse.up(); await page.waitForTimeout(30); await step(page, 90);\n  const h1 = await page.evaluate(() => { const h = G.play.world.heroes[0]; return [h.x, h.z]; }); ok(Math.hypot(h1[0] - h0[0], h1[1] - h0[1]) > 1, `click-to-move moved: ${h0} to ${h1}`);\n  // Click on a monster attacks.\n  await page.evaluate(() => { const w = G.play.world; G.play.command({ c: 'dev', k: 'spawn', type: 'peatwalker' }, 0); E.step(3); const h = w.heroes[0]; const m = w.monsters.at(-1); m.x = h.x + 1.2; m.z = h.z - 1.2; m.px = m.x; m.pz = m.z; m.hp = m.maxHp = 1e6; E.step(3); });\n  const mp = await page.evaluate(() => { const w = G.play.world; const m = w.monsters.at(-1); const p = G.play.view.project(m.x, 0.8, m.z, G.ui); return [p.x, p.y]; });\n  const seq0 = await page.evaluate(() => G.play.world.heroes[0].castSeq);\n  await page.mouse.move(mp[0] * kx, mp[1] * ky); await page.waitForTimeout(30); await step(page, 2); await page.mouse.down(); await page.waitForTimeout(30); await step(page, 10); await page.mouse.up(); await page.waitForTimeout(30); await step(page, 10);\n  ok((await page.evaluate(() => G.play.world.heroes[0].castSeq)) > seq0, 'click on a monster attacks');\n  // Every key in the table.\n  const hero = (f) => page.evaluate(`(() => { const h = G.play.world.heroes[0]; return ${f}; })()`);\n  const pos0 = await hero('[h.x,h.z]'); await page.evaluate(() => { E.input.setKey('KeyW', true); E.step(20); E.input.setKey('KeyW', false); E.step(2); }); const pos1 = await hero('[h.x,h.z]'); ok(Math.hypot(pos1[0] - pos0[0], pos1[1] - pos0[1]) > 0.5, 'W moves');\n  await page.evaluate(() => { E.input.setKey('ArrowLeft', true); E.step(20); E.input.setKey('ArrowLeft', false); E.step(2); }); ok(Math.hypot((await hero('h.x')) - pos1[0], (await hero('h.z')) - pos1[1]) > 0.5, 'arrows move');\n  await page.evaluate(() => { G.play.world.heroes[0].dodgeCd = 0; }); await pressKey(page, 'Space'); ok((await hero('h.dodges')) >= 1, 'Space dodges');\n  await page.evaluate(() => { G.play.world.heroes[0].hp = 5; G.play.world.heroes[0].potionCd = 0; }); await pressKey(page, 'KeyQ'); ok((await hero('h.potions')) >= 1, 'Q drinks');\n  for (const k of ['Digit1', 'Digit2', 'Digit3', 'Digit4']) { await page.evaluate(() => { const w = G.play.world; w.cheats.noCd = true; w.cheats.infRes = true; E.step(50); }); const s = await hero('h.castSeq'); await pressKey(page, k, 4); await step(page, 5); ok((await hero('h.castSeq')) > s, `${k} casts`); }\n  await page.evaluate(() => { const w = G.play.world; const h = w.heroes[0]; h.inv.length = 0; }); const open = async (k, t) => { await step(page, 80); await pressKey(page, k); await step(page, 3); eq(await page.evaluate(() => G.play.menus.top?.type), t, `${k} opens ${t}`); await pressKey(page, 'Escape'); await step(page, 3); };\n  await open('KeyI', 'hero'); await open('KeyC', 'hero'); await open('KeyK', 'hero'); await open('KeyL', 'hero'); await open('KeyM', 'map'); await open('Tab', 'map');\n  await pressKey(page, 'Escape'); await step(page, 3); eq(await page.evaluate(() => G.play.menus.top?.type), 'pause', 'Esc pauses'); await pressKey(page, 'Escape'); await step(page, 3);\n  await page.evaluate(() => { const w = G.play.world; const h = w.heroes[0]; const it = { uid: 'zz', slot: 'ring', rarity: 'reliquary', ilvl: 30, affixes: [{ k: 'power', v: 500 }], name: 'TEST RING', flavour: '' }; h.inv.push(it); h.newest = 'zz'; }); await pressKey(page, 'KeyF'); eq(await hero('h.gear.ring.uid'), 'zz', 'F equips the newest upgrade');\n  await page.evaluate(() => { G.play.command({ c: 'dev', k: 'boss', zone: 'causeway' }, 0); E.input.setKey('KeyT', true); E.step(100); E.input.setKey('KeyT', false); E.step(3); }); eq(await page.evaluate(() => G.play.world.zone.id), 'town', 'hold T: the Passing Bell');\n  await page.evaluate(() => { E.input.setKey('AltLeft', true); E.step(2); }); ok(await page.evaluate(() => G.router.showLabels), 'Alt shows labels'); await page.evaluate(() => { E.input.setKey('AltLeft', false); E.step(2); });\n  eq(errors.length, 0, `no page errors: ${errors[0]}`); await browser.close();\n});\nEOF\ncat > tests/browser/couch.test.mjs <<'EOF'\n// Couch: 4 stub pads join, each moves its own hero, camera holds them.\nimport { ok, eq, guarded } from '../lib.mjs';\nimport { openGame, pressKey, step } from '../../tools/browser.mjs';\nconst padInit = () => {\n  const mk = (i) => ({ index: i, id: `stub ${i}`, connected: true, mapping: 'standard', buttons: Array.from({ length: 17 }, () => ({ pressed: false, value: 0, touched: false })), axes: [0, 0, 0, 0], timestamp: 0 });\n  window.__pads = [mk(0), mk(1), mk(2), mk(3)]; navigator.getGamepads = () => window.__pads;\n  window.__press = (i, b, on) => { const p = window.__pads[i]; p.buttons[b].pressed = on; p.buttons[b].value = on ? 1 : 0; };\n};\nawait guarded(async () => {\n  const { browser, page, errors } = await openGame({ width: 1280, height: 720, init: padInit });\n  const tap = async (b, pad = 0, n = 3) => { await page.evaluate(([x, y, k]) => { __press(y, x, true); E.step(k); __press(y, x, false); E.step(k); }, [b, pad, n]); };\n  await step(page, 10); await tap(0); await tap(0); await tap(0); await page.evaluate(() => { G.ui.focus = 'n:last'; }); await step(page, 2); await tap(0); await step(page, 5);\n  eq(await page.evaluate(() => G.shell.state), 'play', 'seat one plays');\n  for (const pad of [1, 2, 3]) {\n    await tap(9, pad); await step(page, 3); eq(await page.evaluate(() => G.play.menus.top?.type), 'joinclass', `pad ${pad} is asked to pick a trade`);\n    await page.evaluate((c) => { G.ui.focus = `jc:${c}`; }, ['lamplighter', 'sexton', 'bellwarden'][pad - 1]); await step(page, 2); await tap(0, pad); await step(page, 3);\n  }\n  eq(await page.evaluate(() => G.play.world.heroes.filter((h) => !h.left).length), 4, 'four heroes in the party'); eq(await page.evaluate(() => G.play.local.length), 4, 'four local seats');\n  // Each pad moves its own hero.\n  for (const pad of [0, 1, 2, 3]) {\n    const before = await page.evaluate(() => G.play.world.heroes.map((h) => [h.x, h.z]));\n    await page.evaluate((i) => { __pads[i].axes[0] = i % 2 ? 1 : -1; E.step(20); __pads[i].axes[0] = 0; E.step(2); }, pad);\n    const after = await page.evaluate(() => G.play.world.heroes.map((h) => [h.x, h.z]));\n    const seat = await page.evaluate((i) => G.router.padSeat[i], pad);\n    ok(seat === pad, `pad ${pad} holds seat ${seat}`);\n    for (let s = 0; s < 4; s++) { const d = Math.hypot(after[s][0] - before[s][0], after[s][1] - before[s][1]); if (s === seat) ok(d > 0.5, `pad ${pad} moved its hero: ${d}`); else ok(d < 0.3, `pad ${pad} left seat ${s} alone: ${d}`); }\n  }\n  // Camera holds them: zoomed out, all on screen.\n  await page.evaluate(() => { __pads[0].axes[0] = -1; __pads[3].axes[0] = 1; E.step(90); __pads[0].axes[0] = 0; __pads[3].axes[0] = 0; E.step(30); });\n  ok((await page.evaluate(() => E.camera.zoom)) < 1, 'camera zooms out');\n  const onScreen = await page.evaluate(() => G.play.world.heroes.every((h) => { const p = G.play.view.project(h.x, 1, h.z, G.ui); return p.x > 0 && p.x < G.ui.W && p.y > 0 && p.y < G.ui.H; })); ok(onScreen, 'all heroes on screen');\n  const txt = await page.evaluate(() => G.ui.drawnText.map((t) => t.text).join('|')); ok(txt.includes('LV 30 LAMPLIGHTER') || /Lamplighter/i.test(txt), 'couch panels drawn');\n  ok(await page.evaluate(() => G.play.view.heroes.size === 4), 'four actors');\n  // Pause is one seat's: its panel only takes that pad.\n  await tap(9, 2); await step(page, 2); eq(await page.evaluate(() => G.play.menus.top?.type), 'pause', 'seat 3 pauses'); eq(await page.evaluate(() => G.game?.menuOwner ?? G.menuOwner), 2, 'seat owns the menu');\n  await pressKey(page, 'Escape'); await step(page, 3);\n  eq(errors.length, 0, `no page errors: ${errors[0]}`); await browser.close();\n});\nEOF\ncat > tests/browser/touch.test.mjs <<'EOF'\n// Touch-only: phone and tablet profiles. Message present and wrapped, settings button present, no touch controls, attract running, a tap doesn't start a game.\nimport { devices } from 'playwright';\nimport { ok, eq, guarded } from '../lib.mjs';\nimport { openGame, step } from '../../tools/browser.mjs';\nawait guarded(async () => {\n  for (const name of ['Pixel 7', 'Galaxy Tab S4']) {\n    const d = devices[name]; const { browser, page, errors } = await openGame({ width: d.viewport.width, height: d.viewport.height, context: { ...d, viewport: d.viewport } });\n    eq(await page.evaluate(() => G.touchOnly), true, `${name}: detected as touch-only`);\n    await step(page, 10);\n    eq(await page.evaluate(() => G.shell.state), 'touch', `${name}: touch screen`);\n    const msg = await page.evaluate(() => G.ui.drawnText.map((t) => t.text).join(' ')); ok(msg.replace(/\\s+/g, ' ').includes('CONTROLLER OR KEYBOARD REQUIRED'), `${name}: message`);\n    const inside = await page.evaluate(() => G.ui.drawnText.every((t) => t.x >= 0 && t.x + t.w <= G.ui.W)); ok(inside, `${name}: message wrapped to the screen`);\n    eq(await page.evaluate(() => E.touch), null, `${name}: no touch controls`);\n    ok(await page.evaluate(() => !!document.querySelector('.settings-button')), `${name}: settings button present`);\n    await step(page, 620); eq(await page.evaluate(() => G.shell.state), 'attract', `${name}: attract runs`);\n    const b = await page.evaluate(() => ({ s: G.ui.drawnText.map((t) => t.text).join(' ') })); ok(b.s.includes('DEMO'), `${name}: demo tag`);\n    await page.touchscreen.tap(d.viewport.width / 2, d.viewport.height / 2); await page.waitForTimeout(60); await step(page, 3);\n    eq(await page.evaluate(() => G.shell.state), 'touch', `${name}: a tap returns to the message`);\n    await page.touchscreen.tap(d.viewport.width / 2, d.viewport.height / 2); await page.waitForTimeout(60); await step(page, 5);\n    eq(await page.evaluate(() => G.shell.state), 'touch', `${name}: a tap does not start a game`);\n    eq(errors.length, 0, `${name}: no page errors: ${errors[0]}`); await browser.close();\n  }\n});\nEOF\ncat > tests/browser/sound.test.mjs <<'EOF'\n// Sound, by what Web Audio produces: an AnalyserNode on everything reaching the destination.\nimport { ok, eq, guarded } from '../lib.mjs';\nimport { openGame, pressKey, step } from '../../tools/browser.mjs';\nconst init = () => {\n  const c = AudioNode.prototype.connect; window.__an = null;\n  AudioNode.prototype.connect = function (dest, ...rest) { const ctx = this.context; if (dest === ctx.destination) { if (!window.__an) { window.__an = ctx.createAnalyser(); window.__an.fftSize = 2048; window.__an.smoothingTimeConstant = 0; } c.call(this, window.__an); } return c.call(this, dest, ...rest); };\n  window.__level = () => { const a = window.__an; if (!a) return 0; const b = new Float32Array(a.fftSize); a.getFloatTimeDomainData(b); let p = 0; for (const v of b) p = Math.max(p, Math.abs(v)); return p; };\n  window.__peak = async (ms) => { let p = 0; const t0 = performance.now(); while (performance.now() - t0 < ms) { p = Math.max(p, window.__level()); await new Promise((r) => setTimeout(r, 15)); } return p; };\n};\nawait guarded(async () => {\n  const { browser, page, errors } = await openGame({ width: 640, height: 360, init });\n  await page.keyboard.press('Enter'); await page.waitForTimeout(100); await page.evaluate(() => { E.manual = false; });\n  await page.waitForTimeout(800); ok(await page.evaluate(() => E.audio.unlocked), 'key unlocks audio'); eq(await page.evaluate(() => E.audio.volume.music), 0.1, 'music 10%');\n  const m = await page.evaluate(() => __peak(2500)); ok(m > 0.0002, `music alone gives a level: ${m}`);\n  await page.evaluate(() => E.audio.play('bell_big', { volume: 1 })); const sfx = await page.evaluate(() => __peak(700)); ok(sfx > m * 2, `an effect stands well above the music: ${sfx} vs ${m}`);\n  await page.evaluate(() => { E.audio.playMusic(null); }); await page.waitForTimeout(1200); await page.evaluate(() => G.voice.say('crier', 'Hear ye, hear ye! The dead are up.')); const v = await page.evaluate(async () => { const t0 = performance.now(); let p = 0; while (performance.now() - t0 < 1000) { p = Math.max(p, __level()); await new Promise((r) => setTimeout(r, 10)); } return p; }); ok(v > 0.001, `a spoken line produces sound: ${v}`);\n  void pressKey; void step;\n  eq(errors.length, 0, `no page errors: ${errors[0]}`); await browser.close();\n});\nEOF\ncat > tests/browser/layout.test.mjs <<'EOF'\n// Layout: drawn text stays inside the screen at three sizes, with no overlaps on each screen.\nimport { ok, guarded } from '../lib.mjs';\nimport { openGame, pressKey, step } from '../../tools/browser.mjs';\nawait guarded(async () => {\n  for (const [W, H] of [[1280, 720], [1920, 1080], [2560, 1440]]) {\n    const { browser, page, errors } = await openGame({ width: W, height: H });\n    const check = async (name) => {\n      const r = await page.evaluate(() => { const tt = G.ui.drawnText.filter((t) => !t.world && t.text.trim()); const out = []; for (const t of tt) if (t.x < 0 || t.y < 0 || t.x + t.w > G.ui.W + 1 || t.y + t.h > G.ui.H + 1) out.push(`off: ${t.text}`); for (let i = 0; i < tt.length; i++) for (let j = i + 1; j < tt.length; j++) { const a = tt[i]; const b = tt[j]; if (a.x < b.x + b.w && b.x < a.x + a.w && a.y < b.y + b.h && b.y < a.y + a.h) out.push(`overlap: ${a.text} / ${b.text}`); } return { out, size: [G.ui.W, G.ui.H] }; });\n      ok(r.out.length === 0, `${W}x${H} [${r.size}] ${name}: ${r.out.slice(0, 3).join('; ').slice(0, 220)}`);\n    };\n    await step(page, 10); await check('title');\n    await pressKey(page, 'Enter'); await step(page, 3); await check('menu');\n    await page.evaluate(() => { G.ui.focus = 'm:SETTINGS'; }); await step(page, 2); await pressKey(page, 'Enter'); await step(page, 3); await check('settings'); await pressKey(page, 'Escape'); await step(page, 3);\n    await page.evaluate(() => { G.ui.focus = 'm:ABOUT'; }); await step(page, 2); await pressKey(page, 'Enter'); await step(page, 3); await check('about'); await pressKey(page, 'Escape'); await step(page, 3);\n    await page.evaluate(() => { G.ui.focus = 'm:NEW HERO'; }); await step(page, 2); await pressKey(page, 'Enter'); await step(page, 3); await check('new hero');\n    await pressKey(page, 'Enter'); await step(page, 3); await check('start choice');\n    await page.evaluate(() => { G.ui.focus = 'n:last'; }); await step(page, 2); await pressKey(page, 'Enter'); await step(page, 40); await check('hud');\n    await page.evaluate(() => { const w = G.play.world; G.play.hud.toasts = []; G.play.hud.banner = null; }); await step(page, 2); await check('hud quiet');\n    const screen = async (t, data, name, tabs = 1) => { await page.evaluate(([a, b]) => { G.play.menus.push(a, b); }, [t, data]); await step(page, 3); await check(name ?? t); for (let i = 1; i < tabs; i++) { await pressKey(page, 'KeyE'); await step(page, 3); await check(`${name ?? t} tab ${i + 1}`); } await page.evaluate(() => { G.play.menus.closeAll(); }); await step(page, 3); };\n    await screen('pause', {}); await screen('hero', {}, 'hero', 5); await screen('vendor', {}, 'vendor', 3); await screen('brasse', {}, 'brasse', 3); await screen('ogive', {}, 'ogive', 4); await screen('stash', {}, 'stash'); await screen('map', {}, 'map'); await screen('party', {}, 'party'); await screen('howto', {}, 'how to play'); await screen('knell', {}, 'knell', 3); await screen('writs', {}, 'writs'); await screen('dev', {}, 'dev', 8);\n    ok(errors.length === 0, `no page errors: ${errors[0]}`); await browser.close();\n  }\n});\nEOF\nfor t in boot pad mouse couch touch sound layout; do echo \"== $t\"; (time node tests/browser/$t.test.mjs) 2>&1 | cut -c1-330 | grep -vE \"^(user|sys|$)\" | tail -14; done","description":"Write and run the browser test tier","timeout":590000}}}
