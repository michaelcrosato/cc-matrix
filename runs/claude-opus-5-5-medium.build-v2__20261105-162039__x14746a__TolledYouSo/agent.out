t(page,'tools/out/cloister.png');\nawait page.evaluate(()=>{G.play.command({c:'dev',k:'boss',zone:'belfry_top'},0);G.play.bots[0]=true;}); await step(page,500); await shot(page,'tools/out/malison.png');\nconsole.log(errors.slice(0,5)); await browser.close();\nEOF\ncat > tools/scratch/s5.mjs <<'EOF'\nimport { createServer } from 'node:http'; import { readFileSync, existsSync } from 'node:fs'; import { extname, join, resolve } from 'node:path'; import { chromium } from 'playwright'; import { FLAGS, HTML } from '../browser.mjs';\nconst server = createServer((req, res) => { const u = new URL(req.url, 'http://x'); const f = u.pathname === '/game.html' ? HTML : join(resolve('tools/hub'), u.pathname.slice(1)); if (!existsSync(f)) { res.writeHead(404); res.end(); return; } res.writeHead(200, { 'content-type': extname(f)==='.html'?'text/html':'text/javascript' }); res.end(readFileSync(f)); });\nawait new Promise(r=>server.listen(0,'127.0.0.1',r));\nconst b=await chromium.launch({args:FLAGS}); const p=await (await b.newContext({viewport:{width:1600,height:800}})).newPage();\nawait p.goto(`http://127.0.0.1:${server.address().port}/harness.html?game=game.html&players=2&limit=200`); await p.waitForTimeout(9000); await p.screenshot({path:'tools/out/card.png'});\nfor(const f of p.frames()) if(f!==p.mainFrame()) await f.evaluate(()=>window.AIHub?.answer('ready')).catch(()=>{});\nawait p.waitForTimeout(14000); await p.screenshot({path:'tools/out/session.png'}); await b.close(); server.close();\nEOF\nnode tools/build.mjs --quiet; node tools/scratch/s4.mjs 2>&1 | cut -c1-300 | tail -2; node tools/scratch/s5.mjs 2>&1 | tail -1 | cut -c1-200","description":"Darken water, capture select, dialogue, cloister, card, session","timeout":300000}}}
