{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CghszE7SYax5Hp6c4MRqu","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"Projectile fixes are in: lobbed crocks and plates now have their own team so they only hurt where they land, and shots no longer stun the thrower. Next I'm working on King Famish's three phases in 26-sim-boss.js.\n\n","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5619,"cache_read_input_tokens":396697,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5619},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9fe4bfc6-ee9b-4f5a-880a-60c3aeac1094","uuid":"f3a9876f-f92d-422f-a13b-5aecf14411f9","timestamp":"2026-11-04T12:22:43.683Z","request_id":"req_011CghszDor72dp6PM2oGYJF","narration_block_indexes":[0],"thinking_duration_ms":1,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CghszE7SYax5Hp6c4MRqu","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01HsCeGeswPk28eq81dYQZgM","name":"Bash","input":{"command":"python3 - <<'EOF'\np='25-sim-features.js'; s=open(p).read()\ns=s.replace(\"\"\"      if (q.id === b.owner) { b.hitSet.delete(q); return; }\n\"\"\",\"\"\"      if (q.id === b.owner) return;\n\"\"\")\ns=s.replace(\"\"\"  W.eshots.hit(W.heroes.filter(h => h.alive), (b, h) => { if (b.grav) { b.dead = true; landSplash(b); return; } damage(h, b.dmg, { kind: 'fire', from: b }); emit('burn', { h, b }); }, 'foe');\"\"\",\"\"\"  W.eshots.hit(W.heroes.filter(h => h.alive), (b, h) => { damage(h, b.dmg, { kind: 'fire', from: b }); emit('burn', { h, b }); }, 'foe');\"\"\")\ns=s.replace(\"\"\"(b, q) => { if (b.kind !== 'fireball') { b.hitSet && b.hitSet.add(q); return; } b.dead = true; q.it.gone = true;\"\"\",\"\"\"(b, q) => { b.dead = true; q.it.gone = true;\"\"\")\nopen(p,'w').write(s)\np='23-sim-monsters.js'; s=open(p).read()\ns=s.replace(\"life: arc.t + .02, team: 'foe', kind: 'crock'\",\"life: arc.t + .02, team: 'lob', kind: 'crock'\")\nopen(p,'w').write(s)\np='21-sim.js'; s=open(p).read()\ns=s.replace(\"\"\"    const live = liveHeroes();\n    if (live.length) W.flow.updateMany(live);\n    stepGens(dt);\"\"\",\"\"\"    stepGens(dt);\"\"\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"team: 'lob'\\|q.id === b.owner\" *.js","description":"Fix projectile team and ally-stun logic"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5619,"cache_read_input_tokens":396697,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5619},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9fe4bfc6-ee9b-4f5a-880a-60c3aeac1094","uuid":"c87ba4de-410e-4a0c-8aa5-e6390dacb78e","timestamp":"2026-11-04T12:22:46.152Z","request_id":"req_011CghszDor72dp6PM2oGYJF","wire_tool_inputs":{"toolu_01HsCeGeswPk28eq81dYQZgM":{"command":"python3 - <<'EOF'\np='25-sim-features.js'; s=open(p).read()\ns=s.replace(\"\"\"      if (q.id === b.owner) { b.hitSet.delete(q); return; }\n\"\"\",\"\"\"      if (q.id === b.owner) return;\n\"\"\")\ns=s.replace(\"\"\"  W.eshots.hit(W.heroes.filter(h => h.alive), (b, h) => { if (b.grav) { b.dead = true; landSplash(b); return; } damage(h, b.dmg, { kind: 'fire', from: b }); emit('burn', { h, b }); }, 'foe');\"\"\",\"\"\"  W.eshots.hit(W.heroes.filter(h => h.alive), (b, h) => { damage(h, b.dmg, { kind: 'fire', from: b }); emit('burn', { h, b }); }, 'foe');\"\"\")\ns=s.replace(\"\"\"(b, q) => { if (b.kind !== 'fireball') { b.hitSet && b.hitSet.add(q); return; } b.dead = true; q.it.gone = true;\"\"\",\"\"\"(b, q) => { b.dead = true; q.it.gone = true;\"\"\")\nopen(p,'w').write(s)\np='23-sim-monsters.js'; s=open(p).read()\ns=s.replace(\"life: arc.t + .02, team: 'foe', kind: 'crock'\",\"life: arc.t + .02, team: 'lob', kind: 'crock'\")\nopen(p,'w').write(s)\np='21-sim.js'; s=open(p).read()\ns=s.replace(\"\"\"    const live = liveHeroes();\n    if (live.length) W.flow.updateMany(live);\n    stepGens(dt);\"\"\",\"\"\"    stepGens(dt);\"\"\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"team: 'lob'\\|q.id === b.owner\" *.js","description":"Fix projectile team and ally-stun logic"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HsCeGeswPk28eq81dYQZgM","type":"tool_result","content":"25-sim-features.js:24:      if (q.id === b.owner) return;\n23-sim-monsters.js:143:  W.eshots.fire({ x: m.x, y: m.y, z: 14, vx: arc.vx, vy: arc.vy, vz: arc.vz, grav: g, r: 2.5, dmg: mDmg(m), life: arc.t + .02, team: 'lob', kind: 'crock', lx: tx, ly: ty, color: '#c87a3a', id: W.nextId++, splash: 12 });","is_error":false}]},"parent_tool_use_id":null,"session_id":"9fe4bfc6-ee9b-4f5a-880a-60c3aeac1094","uuid":"a41d233f-c04e-4e6a-9072-3fac988f2ce5","timestamp":"2026-11-04T12:22:46.190Z","tool_use_result":{"stdout":"25-sim-features.js:24:      if (q.id === b.owner) return;\n23-sim-monsters.js:143:  W.eshots.fire({ x: m.x, y: m.y, z: 14, vx: arc.vx, vy: arc.vy, vz: arc.vz, grav: g, r: 2.5, dmg: mDmg(m), life: arc.t + .02, team: 'lob', kind: 'crock', lx: tx, ly: ty, color: '#c87a3a', id: W.nextId++, splash: 12 });","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01HsCeGeswPk28eq81dYQZgM","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cght2S7KvNnVspYTG1zh6","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Hg267VBF9nnPCETFia5Fh1","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261104-050244__x8ffc89/work/Gauntletdown-Gauntlet-claude-opus-5-5-xhigh-20261104-050244/game/src/26-sim-boss.js","content":"/* ---- KING FAMISH: the banquet's three phases. 1 \"Dinner is served\": plates and the stomp; tureens breed ghosts.\n   2 \"Second helpings\": he eats the platters (heals) unless you shoot or eat them first; gnasher waves. 3 \"The Gaunt\n   hungers\": his ribcage opens (shots from the front deal double), he charges, breathes famine fog, the Tithe comes ---- */\nfunction startBoss(x, y) {\n  const n = Math.max(1, PARTY.length), hp = Math.round(400 * (1 + .5 * (n - 1)) * (W.descent > 1 ? 1.3 : 1));\n  W.boss = Object.assign(new E.Body({ x, y: y + 24, r: 12, friction: 0 }), { isBoss: true, hp, max: hp, phase: 0, state: 'throne', stateT: 0, cd: 2, waveT: 6, facing: Math.PI / 2, open: false,\n    fog: null, charge: null, eatT: 0, eating: null, rage: false, home: { x, y: y + 24 }, dead: false, deadT: 0, titheCalled: false, hitT: 0, stomp: 0, throwT: 0, chew: 0, grace: {}, denied: 0, dropped: false });\n}\nconst BOSS_LINES = { 1: 'king_intro', 2: 'king_p2', 3: 'king_p3' };\nfunction bossSay(storyKey, prio = 3) { bus.emit('kingSays', { text: STORY[storyKey] }); if (W.role === 'host') W.events.push(['king', storyKey]); }\nfunction stepBoss(dt) {\n  const K = W.boss; K.hitT = Math.max(0, K.hitT - dt); K.stomp = Math.max(0, K.stomp - dt); K.throwT = Math.max(0, K.throwT - dt); K.chew = Math.max(0, K.chew - dt);\n  for (const k in K.grace) if ((K.grace[k] -= dt) <= 0) delete K.grace[k];\n  if (K.dead) {\n    K.deadT += dt; K.vx = K.vy = 0;\n    if (K.deadT > 2.4 && !K.dropped) { K.dropped = true; addItem('gauntlet', K.x, K.y + 6); emit('gauntletDrop', { K }); }\n    return;\n  }\n  const live = liveHeroes(); if (!live.length) { K.vx = K.vy = 0; return; }\n  let tg = live[0], td = 1e9; for (const h of live) { const d = Math.hypot(h.x - K.x, h.y - K.y); if (d < td) { td = d; tg = h; } }\n  if (K.phase === 0) { K.vx = K.vy = 0; if (td < 10 * T) { K.phase = 1; say('king_intro', null, 3); bossSay('king_intro'); emit('boss', { phase: 1 }, ['boss', 1]); } return; }\n  const frac = K.hp / K.max, want = frac > .7 ? 1 : frac > .35 ? 2 : 3;\n  if (want > K.phase) {\n    K.phase = want; K.state = 'move'; K.stateT = 0; K.charge = null; K.eating = null;\n    bossSay(want === 2 ? 'king_p2' : 'king_p3'); emit('boss', { phase: want }, ['boss', want]);\n    if (want === 2) say('king_eating', null, 2);\n    if (want === 3) { K.open = true; if (!K.titheCalled) { K.titheCalled = true; summonTithe(); } }\n  }\n  K.cd -= dt; K.stateT += dt;\n  // contact: brushing against the King hurts\n  for (const h of live) if (near(h, K, h.r + K.r + 1) && !K.grace[h.id]) { K.grace[h.id] = .6; damage(h, 10, { kind: 'contact', from: K }); }\n  // gnasher waves through the doorways (phase 2 on)\n  if (K.phase >= 2 && (K.waveT -= dt) <= 0) { K.waveT = 12; wave(); }\n  if (K.phase === 3 && K.state !== 'charge' && K.state !== 'aim' && (K.fogT = (K.fogT || 4) - dt) <= 0) { K.fogT = 8; K.fog = { x: K.x, y: K.y, a: angTo(K, tg), t: 4 }; emit('fog', { K }); }\n  if (K.fog && (K.fog.t -= dt) <= 0) K.fog = null;\n  switch (K.state) {\n    case 'stomp':   // a stomp: 0.6 s wind-up, then a ring that hurts within 46\n      K.vx = K.vy = 0;\n      if (K.stateT >= .6) { K.state = 'move'; K.cd = 1.4; K.stomp = .5; W.quake = .4; for (const h of live) if (near(h, K, 46 + h.r)) damage(h, 15, { kind: 'contact', from: K }); emit('stomp', { K }); }\n      return;\n    case 'eat':\n      K.vx = K.vy = 0; K.chew = .2;\n      if (!K.eating || K.eating.gone) { K.state = 'move'; K.eating = null; say('king_eating', null, 1); return; }\n      K.hp = Math.min(K.max, K.hp + K.max * .05 * dt);\n      if (K.stateT >= 2.5) { K.eating.gone = true; emit('kingAte', { it: K.eating }, ['gone', K.eating.id, -4]); K.eating = null; K.state = 'move'; K.cd = .8; }\n      return;\n    case 'aim':   // a charge: a 0.6 s line on the floor, then a dash\n      K.vx = K.vy = 0;\n      if (K.stateT >= .6) { K.state = 'charge'; K.stateT = 0; emit('charge', { K }); }\n      return;\n    case 'charge': {\n      const a = K.charge.a, s = 170; K.vx = Math.cos(a) * s; K.vy = Math.sin(a) * s; K.facing = a;\n      const ox = K.x, oy = K.y; K.update(dt, W.map);\n      for (const h of live) if (near(h, K, h.r + K.r + 3) && !K.grace['c' + h.id]) { K.grace['c' + h.id] = 1; damage(h, 15, { kind: 'contact', from: K }); }\n      if (K.stateT > 1.1 || Math.hypot(K.x - ox, K.y - oy) < s * dt * .3) { K.state = 'move'; K.cd = 1.6; K.charge = null; W.quake = .25; emit('stomp', { K }); }\n      return;\n    }\n  }\n  // moving: phase 1 stays by the throne; phase 2 goes for the platters; phase 3 hunts\n  const platters = W.items.filter(i => !i.gone && i.type === 'platter');\n  let goal = K.home, speed = 30;\n  if (K.phase === 2 && platters.length) { const p = platters.reduce((a, b) => Math.hypot(a.x - K.x, a.y - K.y) < Math.hypot(b.x - K.x, b.y - K.y) ? a : b); goal = { x: p.x + (K.x < p.x ? -18 : 18), y: p.y }; if (Math.hypot(goal.x - K.x, goal.y - K.y) < 6) { K.state = 'eat'; K.stateT = 0; K.eating = p; emit('kingEats', { it: p }); return; } }\n  else if (K.phase === 2 && !K.rage) { K.rage = true; emit('roar', { K }); }\n  else if (K.phase === 3) { goal = tg; speed = 36; }\n  if (K.rage) speed = 40;\n  const gd = Math.hypot(goal.x - K.x, goal.y - K.y);\n  if (gd > 8) { const d = W.bellFlow.dir ? (() => { W.bellFlow.update(goal.x, goal.y); return W.bellFlow.dir(K.x, K.y, goal.x, goal.y); })() : [(goal.x - K.x) / gd, (goal.y - K.y) / gd]; K.vx = d[0] * speed; K.vy = d[1] * speed; K.facing = Math.atan2(d[1], d[0]); }\n  else { K.vx = K.vy = 0; K.facing = angTo(K, tg); }\n  K.update(dt, W.map);\n  if (K.cd > 0) return;\n  if (td < 44 && K.phase < 3) { K.state = 'stomp'; K.stateT = 0; emit('windup', { m: K }); return; }\n  if (K.phase === 3 && rng.r() < .5 && td < 180) { K.state = 'aim'; K.stateT = 0; K.charge = { a: angTo(K, tg), x: K.x, y: K.y }; emit('windup', { m: K }); return; }\n  // three plates in a fan, lobbed at the target (shadows mark where they land)\n  K.cd = K.rage ? 1.6 : K.phase === 3 ? 2 : 2.5; K.throwT = .4; K.facing = angTo(K, tg);\n  for (const s of [-1, 0, 1]) {\n    const a = angTo(K, tg) + s * .3, d = Math.min(150, td), tx = K.x + Math.cos(a) * d, ty = K.y + Math.sin(a) * d, arc = E.arc({ x: K.x, y: K.y, z: 30 }, { x: tx, y: ty, z: 0 }, 260, { apex: 50 });\n    W.eshots.fire({ x: K.x, y: K.y, z: 30, vx: arc.vx, vy: arc.vy, vz: arc.vz, grav: 260, r: 3, dmg: 10, life: arc.t + .02, team: 'lob', kind: 'plate', lx: tx, ly: ty, color: '#e8e8f0', id: W.nextId++, splash: 12 });\n  }\n  emit('plates', { K });\n}\nfunction wave() {\n  const pts = (W.F.points && W.F.points.wave) || [];\n  for (const [cx, cy] of pts) for (let i = 0; i < 2; i++) spawnMonster('gnasher', mid(cx) + (i - .5) * 8, mid(cy), 2, { rise: .3 });\n  if (pts.length) emit('wave', {});\n}\nfunction inFog(h) { const f = W.boss && W.boss.fog; if (!f) return false; const d = Math.hypot(h.x - f.x, h.y - f.y); return d < 130 && Math.abs(E.angDiff(Math.atan2(h.y - f.y, h.x - f.x), f.a)) < .55; }\nfunction hurtBoss(K, amount, by, o) {\n  if (K.dead) return 0;\n  if (K.phase === 0) { K.phase = 1; emit('boss', { phase: 1 }, ['boss', 1]); }\n  if (CHEATS.onehit && by) amount = K.hp;\n  K.hp -= amount; K.hitT = .1;\n  emit('bossHit', { K, amount, by }, null);\n  if (K.hp <= 0) {\n    K.hp = 0; K.dead = true; K.deadT = 0; K.state = 'dead';\n    if (by && by.isHero) award(by, 10000, K, 'king');\n    for (const m of W.monsters) if (!m.dead) killMonster(m, null, 'magic');\n    for (const g of W.gens) if (!g.dead) { g.dead = true; emit('genDead', { g }, ['gen', g.id]); }\n    say('king_dead', by, 3); bossSay('king_defeat');\n    emit('bossDead', { K, by }, ['boss', 4]);\n  }\n  return amount;\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3632,"cache_read_input_tokens":402316,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3632},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9fe4bfc6-ee9b-4f5a-880a-60c3aeac1094","uuid":"d34b99a3-8e97-486e-8196-d860cc74307b","timestamp":"2026-11-04T12:23:19.813Z","request_id":"req_011Cght2RoxiBVGmW5q2Z1ot","wire_tool_inputs":{"toolu_01Hg267VBF9nnPCETFia5Fh1":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261104-050244__x8ffc89/work/Gauntletdown-Gauntlet-claude-opus-5-5-xhigh-20261104-050244/game/src/26-sim-boss.js","content":"/* ---- KING FAMISH: the banquet's three phases. 1 \"Dinner is served\": plates and the stomp; tureens breed ghosts.\n   2 \"Second helpings\": he eats the platters (heals) unless you shoot or eat them first; gnasher waves. 3 \"The Gaunt\n   hungers\": his ribcage opens (shots from the front deal double), he charges, breathes famine fog, the Tithe comes ---- */\nfunction startBoss(x, y) {\n  const n = Math.max(1, PARTY.length), hp = Math.round(400 * (1 + .5 * (n - 1)) * (W.descent > 1 ? 1.3 : 1));\n  W.boss = Object.assign(new E.Body({ x, y: y + 24, r: 12, friction: 0 }), { isBoss: true, hp, max: hp, phase: 0, state: 'throne', stateT: 0, cd: 2, waveT: 6, facing: Math.PI / 2, open: false,\n    fog: null, charge: null, eatT: 0, eating: null, rage: false, home: { x, y: y + 24 }, dead: false, deadT: 0, titheCalled: false, hitT: 0, stomp: 0, throwT: 0, chew: 0, grace: {}, denied: 0, dropped: false });\n}\nconst BOSS_LINES = { 1: 'king_intro', 2: 'king_p2', 3: 'king_p3' };\nfunction bossSay(storyKey, prio = 3) { bus.emit('kingSays', { text: STORY[storyKey] }); if (W.role === 'host') W.events.push(['king', storyKey]); }\nfunction stepBoss(dt) {\n  const K = W.boss; K.hitT = Math.max(0, K.hitT - dt); K.stomp = Math.max(0, K.stomp - dt); K.throwT = Math.max(0, K.throwT - dt); K.chew = Math.max(0, K.chew - dt);\n  for (const k in K.grace) if ((K.grace[k] -= dt) <= 0) delete K.grace[k];\n  if (K.dead) {\n    K.deadT += dt; K.vx = K.vy = 0;\n    if (K.deadT > 2.4 && !K.dropped) { K.dropped = true; addItem('gauntlet', K.x, K.y + 6); emit('gauntletDrop', { K }); }\n    return;\n  }\n  const live = liveHeroes(); if (!live.length) { K.vx = K.vy = 0; return; }\n  let tg = live[0], td = 1e9; for (const h of live) { const d = Math.hypot(h.x - K.x, h.y - K.y); if (d < td) { td = d; tg = h; } }\n  if (K.phase === 0) { K.vx = K.vy = 0; if (td < 10 * T) { K.phase = 1; say('king_intro', null, 3); bossSay('king_intro'); emit('boss', { phase: 1 }, ['boss', 1]); } return; }\n  const frac = K.hp / K.max, want = frac > .7 ? 1 : frac > .35 ? 2 : 3;\n  if (want > K.phase) {\n    K.phase = want; K.state = 'move'; K.stateT = 0; K.charge = null; K.eating = null;\n    bossSay(want === 2 ? 'king_p2' : 'king_p3'); emit('boss', { phase: want }, ['boss', want]);\n    if (want === 2) say('king_eating', null, 2);\n    if (want === 3) { K.open = true; if (!K.titheCalled) { K.titheCalled = true; summonTithe(); } }\n  }\n  K.cd -= dt; K.stateT += dt;\n  // contact: brushing against the King hurts\n  for (const h of live) if (near(h, K, h.r + K.r + 1) && !K.grace[h.id]) { K.grace[h.id] = .6; damage(h, 10, { kind: 'contact', from: K }); }\n  // gnasher waves through the doorways (phase 2 on)\n  if (K.phase >= 2 && (K.waveT -= dt) <= 0) { K.waveT = 12; wave(); }\n  if (K.phase === 3 && K.state !== 'charge' && K.state !== 'aim' && (K.fogT = (K.fogT || 4) - dt) <= 0) { K.fogT = 8; K.fog = { x: K.x, y: K.y, a: angTo(K, tg), t: 4 }; emit('fog', { K }); }\n  if (K.fog && (K.fog.t -= dt) <= 0) K.fog = null;\n  switch (K.state) {\n    case 'stomp':   // a stomp: 0.6 s wind-up, then a ring that hurts within 46\n      K.vx = K.vy = 0;\n      if (K.stateT >= .6) { K.state = 'move'; K.cd = 1.4; K.stomp = .5; W.quake = .4; for (const h of live) if (near(h, K, 46 + h.r)) damage(h, 15, { kind: 'contact', from: K }); emit('stomp', { K }); }\n      return;\n    case 'eat':\n      K.vx = K.vy = 0; K.chew = .2;\n      if (!K.eating || K.eating.gone) { K.state = 'move'; K.eating = null; say('king_eating', null, 1); return; }\n      K.hp = Math.min(K.max, K.hp + K.max * .05 * dt);\n      if (K.stateT >= 2.5) { K.eating.gone = true; emit('kingAte', { it: K.eating }, ['gone', K.eating.id, -4]); K.eating = null; K.state = 'move'; K.cd = .8; }\n      return;\n    case 'aim':   // a charge: a 0.6 s line on the floor, then a dash\n      K.vx = K.vy = 0;\n      if (K.stateT >= .6) { K.state = 'charge'; K.stateT = 0; emit('charge', { K }); }\n      return;\n    case 'charge': {\n      const a = K.charge.a, s = 170; K.vx = Math.cos(a) * s; K.vy = Math.sin(a) * s; K.facing = a;\n      const ox = K.x, oy = K.y; K.update(dt, W.map);\n      for (const h of live) if (near(h, K, h.r + K.r + 3) && !K.grace['c' + h.id]) { K.grace['c' + h.id] = 1; damage(h, 15, { kind: 'contact', from: K }); }\n      if (K.stateT > 1.1 || Math.hypot(K.x - ox, K.y - oy) < s * dt * .3) { K.state = 'move'; K.cd = 1.6; K.charge = null; W.quake = .25; emit('stomp', { K }); }\n      return;\n    }\n  }\n  // moving: phase 1 stays by the throne; phase 2 goes for the platters; phase 3 hunts\n  const platters = W.items.filter(i => !i.gone && i.type === 'platter');\n  let goal = K.home, speed = 30;\n  if (K.phase === 2 && platters.length) { const p = platters.reduce((a, b) => Math.hypot(a.x - K.x, a.y - K.y) < Math.hypot(b.x - K.x, b.y - K.y) ? a : b); goal = { x: p.x + (K.x < p.x ? -18 : 18), y: p.y }; if (Math.hypot(goal.x - K.x, goal.y - K.y) < 6) { K.state = 'eat'; K.stateT = 0; K.eating = p; emit('kingEats', { it: p }); return; } }\n  else if (K.phase === 2 && !K.rage) { K.rage = true; emit('roar', { K }); }\n  else if (K.phase === 3) { goal = tg; speed = 36; }\n  if (K.rage) speed = 40;\n  const gd = Math.hypot(goal.x - K.x, goal.y - K.y);\n  if (gd > 8) { const d = W.bellFlow.dir ? (() => { W.bellFlow.update(goal.x, goal.y); return W.bellFlow.dir(K.x, K.y, goal.x, goal.y); })() : [(goal.x - K.x) / gd, (goal.y - K.y) / gd]; K.vx = d[0] * speed; K.vy = d[1] * speed; K.facing = Math.atan2(d[1], d[0]); }\n  else { K.vx = K.vy = 0; K.facing = angTo(K, tg); }\n  K.update(dt, W.map);\n  if (K.cd > 0) return;\n  if (td < 44 && K.phase < 3) { K.state = 'stomp'; K.stateT = 0; emit('windup', { m: K }); return; }\n  if (K.phase === 3 && rng.r() < .5 && td < 180) { K.state = 'aim'; K.stateT = 0; K.charge = { a: angTo(K, tg), x: K.x, y: K.y }; emit('windup', { m: K }); return; }\n  // three plates in a fan, lobbed at the target (shadows mark where they land)\n  K.cd = K.rage ? 1.6 : K.phase === 3 ? 2 : 2.5; K.throwT = .4; K.facing = angTo(K, tg);\n  for (const s of [-1, 0, 1]) {\n    const a = angTo(K, tg) + s * .3, d = Math.min(150, td), tx = K.x + Math.cos(a) * d, ty = K.y + Math.sin(a) * d, arc = E.arc({ x: K.x, y: K.y, z: 30 }, { x: tx, y: ty, z: 0 }, 260, { apex: 50 });\n    W.eshots.fire({ x: K.x, y: K.y, z: 30, vx: arc.vx, vy: arc.vy, vz: arc.vz, grav: 260, r: 3, dmg: 10, life: arc.t + .02, team: 'lob', kind: 'plate', lx: tx, ly: ty, color: '#e8e8f0', id: W.nextId++, splash: 12 });\n  }\n  emit('plates', { K });\n}\nfunction wave() {\n  const pts = (W.F.points && W.F.points.wave) || [];\n  for (const [cx, cy] of pts) for (let i = 0; i < 2; i++) spawnMonster('gnasher', mid(cx) + (i - .5) * 8, mid(cy), 2, { rise: .3 });\n  if (pts.length) emit('wave', {});\n}\nfunction inFog(h) { const f = W.boss && W.boss.fog; if (!f) return false; const d = Math.hypot(h.x - f.x, h.y - f.y); return d < 130 && Math.abs(E.angDiff(Math.atan2(h.y - f.y, h.x - f.x), f.a)) < .55; }\nfunction hurtBoss(K, amount, by, o) {\n  if (K.dead) return 0;\n  if (K.phase === 0) { K.phase = 1; emit('boss', { phase: 1 }, ['boss', 1]); }\n  if (CHEATS.onehit && by) amount = K.hp;\n  K.hp -= amount; K.hitT = .1;\n  emit('bossHit', { K, amount, by }, null);\n  if (K.hp <= 0) {\n    K.hp = 0; K.dead = true; K.deadT = 0; K.state = 'dead';\n    if (by && by.isHero) award(by, 10000, K, 'king');\n    for (const m of W.monsters) if (!m.dead) killMonster(m, null, 'magic');\n    for (const g of W.gens) if (!g.dead) { g.dead = true; emit('genDead', { g }, ['gen', g.id]); }\n    say('king_dead', by, 3); bossSay('king_defeat');\n    emit('bossDead', { K, by }, ['boss', 4]);\n  }\n  return amount;\n}\n"}}}
