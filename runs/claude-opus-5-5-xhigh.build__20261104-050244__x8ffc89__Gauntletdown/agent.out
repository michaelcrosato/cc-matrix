mp.state, Math.round(imp.x), Math.round(imp.y), imp.cool.toFixed(2), 'los', W2.map.los(imp.x, imp.y, h2.x, h2.y), W2.eshots.list.length, imp.dead); }\nEOF\nnode tests/dbg.tmp.mjs 2>&1 | head -40; rm tests/dbg.tmp.mjs","description":"Trace cracked-wall shots and imp spitting"}},"wire_ingest_context":{"toolu_01FTvvDSe7U9DvsLP9MwGVja":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261104-050244__x8ffc89/work/Gauntletdown-Gauntlet-claude-opus-5-5-xhigh-20261104-050244"}}}
