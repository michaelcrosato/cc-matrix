move = [1, 0]; game.advance(1 / 120); }\", \"  p2.hold('right'); game.advance(2); p2.hold('right', false);\"),\n(\"  go('f1', ['berserker', 'hexer'], { clear: true }); const [d1, d2] = W().heroes;\", \"  go('f1', ['berserker', 'hexer'], { clear: true, input: true }); const [d1, d2] = W().heroes;\"),\n(\"  game.settings.set('cheat_god', true); go('f1', ['berserker'], { clear: true }); hero().score = 99999; game.settings.set('cheat_god', false);\",\n \"  go('f1', ['berserker'], { clear: true }); game.settings.set('cheat_god', true); hero().score = 99999; game.settings.set('cheat_god', false);\"),\n(\"  for (let i = 0; i < 3; i++) { p2b.tap('confirm'); cab.update(.02); G2.advance(.02); cab.update(.02); }\", \"  for (let i = 0; i < 3; i++) { p2b.tap('confirm'); G2.advance(1 / 120); cab.update(1 / 120); G2.advance(1 / 120); }\"),\n])\npatch('game/src/01-tune.js', [(\"for (const [key, label] of CHEAT_SPEC) game.settings.define({ key: 'cheat_' + key, group: 'Dev cheats', label, type: 'toggle', value: false, apply: (g, v) => { CHEATS[key] = !!v; } });\",\n \"for (const [key, label] of CHEAT_SPEC) game.settings.define({ key: 'cheat_' + key, group: 'Dev cheats', label, type: 'toggle', value: false, apply: (g, v) => { CHEATS[key] = !!v; if (v && RUN && cheating()) RUN.dev = true; } });\")])\npatch('game/src/21-sim.js', [(\"/** the run: { descent (1 or 2), floorIndex, continues, startedAt, dev } */\\nlet RUN = null;\", \"/** the run: { descent (1 or 2), floorIndex, continues, startedAt, dev (a cheat was used: no high scores) } */\\nlet RUN = null;\")])\nprint('ok')\nEOF\ngrep -n \"^let RUN\\|^let PARTY\" game/src/*.js","description":"Fix sim tests' input use and mark cheated runs"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":965,"cache_read_input_tokens":681312,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":965},"output_tokens":8,"se