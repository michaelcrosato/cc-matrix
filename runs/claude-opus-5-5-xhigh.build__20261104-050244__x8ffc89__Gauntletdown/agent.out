onBindings(b): called with the player's new bindings (the game saves and applies them) */\n    this.names = null; this._onBindings = null;\n    const el = screen.canvas;\n    if (!el) return;\n    // the keyboard's own letters for labels (an AZERTY Z where the code says KeyW), where the browser tells them\n    try { if (navigator.keyboard && navigator.keyboard.getLayoutMap) navigator.keyboard.getLayoutMap().then(m => { this._layout = m; }).catch(() => {}); } catch (e) { /* no layout map */ }\n    if (screen.listeners) screen.listeners.push(() => { if (this.stickOn) this._stickEnd({ pointerId: this.stickId }); });   // a resize or a turn of the phone moves the stick's origin: lift it (a screen of a page's own may have no listeners)\n761:     *  left stick after the dead zone; padAim: its right stick, or null when centered; padPrev: which gamepad buttons\n762:     *  were down at the last step; aimSource: what aims right now: 'move' | 'mouse' | 'pad' */\n763:    this.stick = [0, 0]; this.stickOn = false; this.padMove = [0, 0]; this.padAim = null; this.padPrev = []; this.aimSource = 'move';\n767:    this.deadzone = .18; this.padIndex = null; this.padId = ''; this.lastDevice = 'keyboard';\n825:    on(el, 'pointermove', e => { if (e.pointerType === 'mouse') { this.mouse.cx = e.clientX; this.mouse.cy = e.clientY; this.mouse.active = true; this.mouse.t = this.clock; this.aimSource = 'mouse'; this._fedAt = null; } else { this._pinchMove(e); this._stickMove(e); } if (this._g && this._g.id === e.pointerId) this._gesture('move', ...this.screenPoint(e.clientX, e.clientY)); });\n827:      if (e.pointerType !== 'mouse') this.lastDevice = 'touch';   // any touch, on the stick's half or not: prompts follow it\n829:      if (e.pointerType === 'mouse') { this.mouse.cx = e.clientX; this.mouse.cy = e.clientY; this.mouse.active = true; this.aimSource = 'mouse'; this.press('Mouse' + e.button); }\n901:    if (/^Pad\\d+$/.test(code)) return (PAD_GLYPHS[this.padStyle()] || PAD_GLYPHS.xbox)[+code.slice(3)] || code;\n998:    if (code.startsWith('Pad')) { this.lastDevice = 'gamepad'; this.aimSource = 'pad'; }\n999:    else if (code.startsWith('Act:')) this.lastDevice = 'touch';\n1000:    else this.lastDevice = code.startsWith('Mouse') ? 'mouse' : 'keyboard';\n1044:    this.padMove = [0, 0]; this.padAim = null; this._fingers.clear(); this._zoneOf.clear(); this._pinching = false; this._zoomAcc = 1;\n1144:      if (!p && this.padIndex !== null) { this.padLost = this.lastDevice === 'gamepad'; this.stopRumble(); }   // unplugged while in use\n1147:      this.padPrev = []; this.padMove = [0, 0]; this.padAim = null; this.padAxes = [];\n1149:      if (this.aimSource === 'pad') this.aimSource = 'move';\n1156:      this.padAim = Math.hypot(...aim) > 0 ? [aim[0], aim[1] * (this.invertAimY ? -1 : 1)] : null;\n1157:      if (this.padAim || Math.hypot(...this.padMove) > 0) { this.aimSource = 'pad'; this.lastDevice = 'gamepad'; }\n1214:    this.screen.canvas.setPointerCapture(e.pointerId); this.aimSource = 'move'; this.lastDevice = 'touch';\n1263:const PAD_GLYPHS = {\n2614:    if (this.input.lastDevice === 'gamepad' && o.rumble !== false) this.input.rumble(.2 + .2 * Math.min(2, p), .06 + .03 * p);\n3656: *    half a keyboard each for two (Input.halfKeys: WASD with F G H R T Y on the left, the arrows with . / , L ; ' and the\n3670: *  in order, and the preset's gamepad codes (Input.halfKeys(Input.SHMUP, 'right') -> fire on . and Numpad 1, bomb on /) */\n3671:Input.halfKeys = (preset, side) => {\n3678:const _pPreset = (game, q) => q.half ? Input.halfKeys(game.input._full || game.input.preset, q.half) : (game.input._full || game.input.preset);\n3699:  q.lastDevice = q.device; if (q.pad !== null) { q.tick(0); q.consumeAll(); }   // (the buttons held as it joins, its Start among them, are no presses)\n3700:  const I = P[0]; if (q.half && !I.half) { I._full = I.preset; I.half = 'left'; I.use(Input.halfKeys(I._full, 'left')); }   // player 1 moves to the left half\n3759:  const I = P[0], was = game._p1 || [I.lastDevice, I.padIndex, I.aimSource]; game._p1 = [I.lastDevice, I.padIndex, I.aimSource];\n3768:    if (I.padIndex === p.index) { I.consumeAll(); [I.lastDevice, , I.aimSource] = was; game._p1 = was; }   // (that Start was the joiner's: player 1 neither pauses nor turns to the pad)\n3774:  const I = P[0]; if (I.half && game.scene && game.scene.input) { I._full = I.preset; I.use(Input.halfKeys(I._full, 'left')); }\n8971:      const p = inp.lastDevice === 'mouse' && inp.pointer(), hv = p && (!this._hp || p[0] !== this._hp[0] || p[1] !== this._hp[1]) ? row(p) : -1; this._hp = p ? p.slice() : null;\n9396:    const touchRows = () => { add(this._el('div', 'esh-k esh-sec', 'Touch')); for (const k of S.keys('Touch')) add(this._row(k)); }, first = touch && I.lastDevice === 'touch';\n10811:  _panelH() { return this.game.input.lastDevice === 'touch' ? this._thumb() + 14 : this.ui === 'verbs' ? 56 : 30; }\n10821:    const L = this._layout(), touch = I.lastDevice === 'touch', p = I.pointer(), c = I.clicked(), right = !!(I.map.look && I.pressed('look')), drop = I.pressed('cancel'), lp = I.longPress(), d2 = I.doubleTap();\n10849:    const R = this.rooms[this.room], L = this._layout(), G = this.game, touch = G.input.lastDevice === 'touch', z = L.z, pad = [].concat(R.pad || 0), px0 = pad[0], py0 = pad[1] || 0;\n11623:    const font = E.font, bw = Math.floor(W / 2) - 34, ca = this.game.input.lastDevice === 'touch' && this.game.cornerArea ? this.game.cornerArea() : null, y = ca && ca.y0 < 40 ? Math.ceil(ca.y1) + 6 : 10;\n14419:      else if (this.selected.length && I.lastDevice === 'touch') { const p = at(...c); if (p) { this.smart(this.selected, p[0], p[1], u, { queue: sh }); if (this.on.ordered) this.on.ordered(p, u); } }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_013ZqiYP8RCdax421Z9Pkd8e","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
