 (this._armW || 0) > .3 && this._theta !== undefined, fists = !o.weapon || sp.hand === 'L' || sp.blade === 0;\n4127:    // weapon trail: remember where the blade (or fist, or foot) really went, so the smear works in every view\n4133:    if (swinging && (atk.spec.blade !== 0 || atk.spec.kick || !o.weapon || atk.spec.hand === 'L')) {\n4134:      const J = this.J, kick = atk.spec.kick, left = atk.spec.hand === 'L', sword = o.weapon === 'sword' && !kick && !left;\n4197:    const armLen = o.armUpper + o.armLower, aw = this._armW || 0, sA = this._atkHand === 'L' ? -1 : 1, two = this._atkHand === 'both', fists = !o.weapon || this._stW > .5;\n4198:    // where the striking hand goes, and the weapon's direction, for the current attack angle\n4213:      if (this._rdW > 0 && o.weapon) hand = V3.lerp(hand, s > 0 ? add(shC, [2.8, .9, -3]) : add(shC, [2.2, .2, -3.6]), this._rdW * (1 - dash));   // ready: weapon held forward in both hands\n4214:      if (PW.wave > 0 && s === (o.weapon ? -1 : (this._camSide || 1))) { const w = Math.sin(this.t * 11); hand = V3.lerp(hand, add(sh, [.8 + w * 1.7, s * (2 + Math.max(0, w) * 1.4), armLen * .8]), PW.wave); }   // the free hand waves (the camera-side one when both are free)\n4216:      if (PW.block > 0) hand = V3.lerp(hand, add(shC, s > 0 ? [2.6, .6, -2.4] : [2.4, -.2, -3.4]), PW.block);   // block: weapon upright across the body, both hands on it\n4231:    const wp = o.weapon, rest = V3.norm(wp === 'staff' ? [.3, .15, 1] : wp === 'gun' ? [.8, 0, -.6] : [.55, .35, -.75]), atk = aDir;\n4233:    if (this._from && this._windK < 1 && !this._kicking && sA > 0) bd = V3.lerp(this._from.bd, bd, this._windK);   // the weapon turns from where it was\n4240:    if (dw > 0) J.bladeDir = V3.norm(V3.lerp(J.bladeDir, [0, .9, -.4], dw));   // a dropped weapon lies flat once the body is down\n4264:    const PW = this.poseW || {}, keep = { trail: this.trail, cheat: this._cheat, pitch: this._pitch, cape: this.o.cape, weapon: this.o.weapon, down: this.downW, kneel: PW.kneel, cheer: PW.cheer, cast: PW.cast, hurt: this.hurtW };\n4268:    if (o.weapon === false) this.o.weapon = null;\n4275:      this.trail = keep.trail; this._cheat = keep.cheat; this._pitch = keep.pitch; this.o.cape = keep.cape; this.o.weapon = keep.weapon;\n4326:   * the body, and the face with the head; the weapon hand's offsets (the blade) are already in the rig's frame.\n4535:    // ---- weapons ----\n4536:    if (o.weapon === 'gun') {\n4539:    } else if (o.weapon === 'staff') {\n4543:    if (o.weapon === 'sword') {\n4616:    if (o.weapon === 'gun') {\n4619:    } else if (o.weapon === 'staff') {\n4623:    if (o.weapon === 'sword') {\n4704:    if (this.o.weapon) L(J.handR, V3.add(J.handR, V3.mul(J.bladeDir, this.o.bladeLen)), '#ffffff');\n11239:    this.rig = o.rig instanceof E.Humanoid ? o.rig : new E.Humanoid(Object.assign({ size: 2.6, build: 'heroic', weapon: null }, o.rig));\n11657:    this.rigs = this.roster.map(e => { const r = new E.Humanoid(Object.assign({ size: 1, weapon: null }, e.rig, { size: 1 })); r.update(0, { x: 0, y: 0, z: 0, stance: 'guard' }); return r; });\n13417:- const rpg = new E.RPG({ items, monsters, status, curve }). items: { id: { name, kind: 'use' | 'weapon' | 'armor' |\n13424:  equip: { weapon: 'sword' }, data }): hero.stat(k) (base, growth, gear, status), hero.max('hp'), hero.hp, mp, level,\n13446:const E = My3D2dge, rpg = new E.RPG({ items: { potion: { name: 'Potion', kind: 'use', heal: 30, price: 10 }, sword: { name: 'Sword', kind: 'weapon', stats: { atk: 5 }, price: 60 } },\n13466:const { px } = E, STATS = ['hp', 'mp', 'atk', 'def', 'mag', 'spd'], SLOTS = ['weapon', 'armor', 'helm', 'accessory'];\n13659:  use: ['..kk....', '..kk....', '.kffk...', 'kffwfk..', 'kfffwk..', 'kffffk..', '.kkkk...', '........'], weapon: ['......kw', '.....kwk', '....kwk.', '...kwk..', 'k.kwk...', '.kgk....', 'kgk.k...', 'kk......'],","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_016Ca5