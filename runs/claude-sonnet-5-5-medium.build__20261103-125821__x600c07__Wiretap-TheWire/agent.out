; if (h > .25) return ['Noticed', '#e8a040']; if (this.watching) return ['Watching', '#80c0ff']; if (D.blending) return ['Blending', '#80d890']; return ['Unnoticed', '#80d890']; },\n  hudStep() {\n    const D = this.dana, m = this.m; const I = game.input;\n    const st = this.status(), prompts = [];\n    let promptHTML = '';\n    if (this.nearIx && !this.watching) promptHTML = `<div class=\"pr\">${glyph('interact')} ${esc(this.nearIx.label)}${this.nearIx.hold ? ' (hold)' : ''}</div>`;\n    else if (m.mode === 'tee') { const b = this.sim.people.find(p => p.role === 'buyer' && p.state === 'wait' && dist2(p, D) < 24); if (b) promptHTML = `<div class=\"pr\">${glyph('interact')} Serve</div>`; }\n    else if (m.mode === 'surv' || m.mode === 'raid') promptHTML = `<div class=\"pr dim\">${glyph('watch')} Watch &nbsp; ${this.watching ? glyph('photo') + ' Photo' : glyph('blend') + ' Blend'}</div>`;\n    const bars = [];\n    if (m.mode !== 'tee') bars.push(['Eyes on you', D.heat || 0, '#ff6040']); bars.push(['Stamina', this.stamina / 100, this.winded > 0 ? '#ff6040' : '#7ad06a']);\n    if (m.mode === 'tail' && this.tailPhase === 'tail') bars.push(['Contact', this.tail, '#60b0ff']);\n    const counts = m.mode === 'tee' ? [['Cash', money(this.tee.cash) + ' / ' + money(m.target)], ['Time', Math.max(0, Math.ceil(this.tee.left)) + 's'], ['Saved', this.tee.saved]] : [['Film', STATE.film], ['Brass', Math.round(STATE.brass)], m.mode === 'surv' ? ['Shots', Object.keys(this.slots).length + '/' + m.slots.length] : ['Made', this.made + '/3']];\n    const obj = this.objectiveText();\n    Hud.set(`<div class=\"hud\"><div class=\"obj\"><span class=\"k\">${esc(m.kicker || '')}</span><b>${esc(obj[0])}</b><span>${esc(say(obj[1]))}</span></div><div class=\"st\" style=\"color:${st[1]}\">${st[0]}</div><div class=\"bars\">${bars.map(b => `<div class=\"bar\"><i>${b[0]}</i><u><s style=\"width:${Math.round(clamp(b[1], 0, 1) * 100)}%;background:${b[2]}\"></s></u></div>`).join('')}</div><div class=\"cnt