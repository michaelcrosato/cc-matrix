 this.dana, I = D.ctl, R = this.reticle; let best\")\ns=s.replace(\"    const D = this.dana, sim = this.sim, m = this.m;\\n    if (m.mode !== 'raid')\",\"    const D = this.dana, sim = this.sim, m = this.m;\\n    if (this.data.attract) { D.heat = 0; STATE.film = Math.max(STATE.film, 20); }\\n    else if (m.mode !== 'raid')\")\nopen('07-field.js','w').write(s)\nEOF\ngrep -n \"else if (m.mode !== 'raid')\" 07-field.js | head"}}}
