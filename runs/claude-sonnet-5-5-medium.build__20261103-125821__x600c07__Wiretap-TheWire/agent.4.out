n *    viewport.focus), the scene drawn once in each (r.viewport says which: { i, x, y, w, h }) and scene.hud(r) once over\n *    the whole screen; GPU lighting off while split. A scene's start ends a split.\n * ============================================================================= */\nconst KEY_HALVES = {   // each half's moves, its buttons in order (the preset's other actions take them in turn) and its menu keys\n  left: { up: ['KeyW'], down: ['KeyS'], left: ['KeyA'], right: ['KeyD'], buttons: [['KeyF'], ['KeyG'], ['KeyH'], ['KeyR'], ['KeyT'], ['KeyY'], ['KeyV'], ['KeyB']], start: ['Digit1'], pause: ['Escape', 'Digit1'], confirm: ['KeyF'], cancel: ['KeyG'] },\n  right: { up: ['ArrowUp'], down: ['ArrowDown'], left: ['ArrowLeft'], right: ['ArrowRight'], buttons: [['Period', 'Numpad1'], ['Slash', 'Numpad2'], ['Comma', 'Numpad3'], ['KeyL', 'Numpad4'], ['Semicolon', 'Numpad5'], ['Quote', 'Numpad6'], ['KeyK', 'Numpad7'], \n    start: ['Digit2', 'Enter', 'NumpadEnter'], pause: ['Digit2', 'Backspace'], confirm: ['Period', 'Enter', 'NumpadEnter'], cancel: ['Slash', 'Backspace'] }\n};\n/** a preset for half a keyboard ('left' or 'right'): its moves and menu keys, the preset's other actions on its buttons\n *  in order, and the preset's gamepad codes (Input.halfKeys(Input.SHMUP, 'right') -> fire on . and Numpad 1, bomb on /) */\nInput.halfKeys = (preset, side) => {\n  const P = typeof preset === 'string' ? Input[preset.toUpperCase()] || Input.DEFAULT : preset || Input.DEFAULT, H = KEY_HALVES[side] || KEY_HALVES.left, out = {};\n  let k = 0;\n  for (const a in P) out[a] = (H[a] || H.buttons[k++] || []).concat(P[a].filter(c => padCode(c)));\n  return out;\n};\nconst _pStub = game => Object.create(game.screen, { canvas: { value: null } });   // (another player's input: the screen's sizes, no listeners of its own)\nconst _pPreset = (game, q) => q.half ? Input.halfKeys(game.input._full || game.input.preset, q.half) : (game.input._full || game.input.preset);\nfunction _pCla