cloth: '#2aa0c0', pants: '#1a2a3a', skin: '#e0ae84', hair: '#2a1d18' } },"," });"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-183312__xf5fb84/work/SublimeCrisis3-TimeCrisis3-claude-haiku-5-5-medium-20261103-183312/src/04-sim.js","hunks":[{"oldStart":395,"oldLines":6,"newStart":395,"newLines":11,"lines":["       }","       case 'enemy': {","         const e = best.enemy;","+        if (best.part === 'hostage') {","+          p.stats.hits++;","+          this.hitCivilian(e, p, at, true);","+          return true;","+        }","         const head = best.part === 'head';","         this.damageEnemy(e, p, dmg * (head ? 2 : 1), head, at, kind, o, d);","         return true;"]},{"oldStart":425,"oldLines":7,"newStart":430,"newLines":10,"lines":["     const s = e.size || 1;","     const x = e.x, y = e.y, z = e.z || 0;","     const head = { part: 'head', b: [x - 3.2 * s, y - 3.2 * s, z + 22 * s, x + 3.2 * s, y + 3.2 * s, z + 29 * s] };","-    if (e.def && e.def.headOnly) return [head];","+    if (e.def && e.def.headOnly) {","+      // The captor's hostage stands beside it: a shot at the hostage costs a life (plan 5.3).","+      return [head, { part: 'hostage', b: [x + 8 * s - 3 * s, y - 3 * s, z, x + 8 * s + 3 * s, y + 3 * s, z + 20 * s] }];","+    }","     return [head, { part: 'body', b: [x - 5 * s, y - 5 * s, z, x + 5 * s, y + 5 * s, z + 22 * s] }];","   }"," "]},{"oldStart":475,"oldLines":15,"newStart":483,"newLines":18,"lines":["       this.emit('timeExtend', { player: p.id, s: add });","     }","     if (def.drop) this.dropAmmo(e, p, at);","+    // A jet-ski's fuel tank goes up with the rider: a bonus for the shooter and an area blast (plan 5.3).","+    if (def.ski) { this.addScore(p, 1000, at); this.explode(e.x, e.y, 6, 40, 8, p); }","     this.emit('kill', { player: p.id, enemy: e.id, etype: e.type, head, at, quick });","   }"," ","-  hitCivilian(e, p, at) {","-    e.hp = 0; e.alive = false; e.dead = true; e.deathT = 0; e.