0, 200));\n  const e2 = await p.evaluate(() => window.__game ? window.__game.game.errors.map(e => e.message) : []);\n  console.log(name, st, errs.concat(e2).slice(0, 3).join(' | '));\n  await p.close();\n}\nawait b.close();\nEOF\nexport TMPDIR=$PWD/.tmp; timeout 200 node tests/shots.mjs \"title|title|2500\" \"match|match/muskrats/drillers/icebox|7000\"","description":"Screenshot title and match","timeout":220000}},"wire_ingest_context":{"toolu_01J6GvKFbeS7bkf8joCQULJh":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-182910__x9a2bbb/work/IceHoc-Kaboom-IceHockey-claude-opus-5-5-medium-20261103-182910"}}}
