     Spec::Way,\\n        Spec::Reach { x: 0.0, z: 460.0, gps: true },\\n        Spec::Fever,\\n    ];\\n    if route == Route::Read {\\n        v.push(Spec::Blackout);\\n    } else {\\n        v.push(Spec::Pill);\\n    }\\n300→    v.push(Spec::Flag(\\\"contract_a0\\\"));\\n    v.push(Spec::Reach { x: -40.0, z: 640.0, gps: false });\\n    v.push(Spec::Fight);\\n    v.push(Spec::EnemyJam);\\n    v.push(Spec::Jam);\\n    v.push(Spec::Break);\\n    v.push(Spec::Rescue);\\n    for w in 1..=6 {\\n        v.push(Spec::Wound(w));\\n    }\\n310→    v.push(Spec::Loot);\\n    v.push(Spec::Reach { x: 170.0, z: 470.0, gps: false });\\n    v.push(Spec::Claim);\\n    v.push(Spec::Shop);\\n    v.push(Spec::Locker);\\n    v.push(Spec::Syrette);\\n    v.push(Spec::Tracker);\\n    v.push(Spec::Sleep { hours: 8.0 });\\n    v.push(Spec::Flag(\\\"contract_a1\\\"));\\n    v.push(Spec::Drive { x: -520.0, z: -520.0 });\\n320→    v.push(Spec::Mono);\\n    for ig in 0..12 {\\n        v.push(Spec::Ignite(ig));\\n    }\\n    v.push(Spec::Tanks);\\n    v.push(Spec::Mounted);\\n    v.push(Spec::Panic);\\n    v.push(Spec::Animals);\\n    v.push(Spec::Flag(\\\"contract_b1\\\"));\\n    v.push(Spec::Bus { x: 0.0, z: 380.0 });\\n330→    v.push(Spec::Drive { x: -260.0, z: -700.0 });\\n    v.push(Spec::Sleep { hours: 26.0 });\\n    v.push(Spec::Night);\\n    v.push(Spec::Boat);\\n    v.push(Spec::Stealth);\\n    v.push(Spec::Dart);\\n    v.push(Spec::Flag(\\\"contract_b2\\\"));\\n    v.push(Spec::Repair);\\n    v.push(Spec::Rain);\\n    v.push(Spec::Flag(\\\"contract_b3\\\"));\\n340→    v.push(Spec::Better);\\n    match route {\\n        Route::Read => v.push(Spec::Overdose),\\n        Route::Chair => v.push(Spec::Die),\\n        _ => v.push(Spec::Patch),\\n    }\\n    v.push(Spec::Flag(\\\"contract_b4\\\"));\\n    v.push(Spec::Tape);\\n    v.push(Spec::Ceasefire);\\n    v.push(Spec::Flag(\\\"contract_c1\\\"));\\n350→    v.push(Spec::Convoy);\\n    v.push(Spec::Flag(\\\"contract_c2\\\"));\\n    v.push(Spec::Town);\\n    v.push(Spec::Flag(\\\"contract_c3\\\"));\\n    v.push(Spec::Drive { x: -760.0, z: 620.0 });\\n    v.push(Spec::Flag(\\\"contract_d1\\\"));\\n    let end = match route {\\n        Route::Read => 1,\\n        Route::Chair => 2,\\n        _ => 0,\\n360→    };\\n    v.push(Spec::Ending(end));\\n    v.push(Spec::Flag(\\\"contract_d2\\\"));\\n    v\\n}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct World {\\n    pub seed: u64,\\n    pub rng: Rng,\\n370→    pub route: Route,\\n    pub screen: Screen,\\n    pub focus: usize,\\n    pub tab: usize,\\n    pub page: usize,\\n    pub difficulty: u8,\\n    pub merc: u8,\\n    pub x: f32,\\n    pub z: f32,\\n    pub yaw: f32,\\n380→    pub pitch: f32,\\n    pub roll: f32,\\n    pub eye: f32,\\n    pub stance: u8,\\n    pub stamina: f32,\\n    pub hp: f32,\\n    pub syrettes: u32,\\n    pub pills: u32,\\n    pub diamonds: u32,\\n    pub infamy: i32,\\n390→    pub guns: Vec<Gun>,\\n    pub slot: usize,\\n    pub syrette_t: f32,\\n    pub heal_t: f32,\\n    pub wound: u8,\\n    pub pill_t: f32,\\n    pub fever_t: f32,\\n    pub fever_state: u8,\\n    pub fever_warn: f32,\\n    pub fever_attack: f32,\\n400→    pub bodies: Vec<Body>,\\n    pub walls: Vec<Wall>,\\n    pub fire: FireMap,\\n    pub wind: Vec2,\\n    pub weather: u8,\\n    pub minutes: f32,\\n    pub ceasefire: bool,\\n    pub companions: Vec<Companion>,\\n    pub rescue_t: f32,\\n    pub ride: Ride,\\n410→    pub flags: BTreeSet<String>,\\n    pub step: u16,\\n    pub step_ready: bool,\\n    pub step_t: f32,\\n    pub step_x: f32,\\n    pub step_z: f32,\\n    pub step_yaw: f32,\\n    #[serde(default)]\\n    pub finale: Option<u8>,\\n    pub waypoint: Option<(f32, f32)>,\\n420→    pub map_t: f32,\\n    pub mono_t: f32,\\n    pub post_clear: bool,\\n    pub post_reman_at: f32,\\n    pub looking_at_post: bool,\\n    pub saves_written: u32,\\n    pub save_blob: String,\\n    pub has_save: bool,\\n    pub idle: f32,\\n    pub attract_t: f3