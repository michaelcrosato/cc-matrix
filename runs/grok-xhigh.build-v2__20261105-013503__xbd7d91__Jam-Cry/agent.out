::Flare) => \\\"ignite_flare\\\",\\n            (1, WeaponId::Rpg) => \\\"ignite_rocket\\\",\\n            (2, WeaponId::Flamer) => \\\"ignite_flamer\\\",\\n            (3, WeaponId::Mortar) => \\\"ignite_mortar\\\",\\n            (4, WeaponId::Molotov) => \\\"ignite_molotov\\\",\\n            (5, WeaponId::Frag) => \\\"ignite_frag\\\",\\n            _ => return,\\n        };\\n        self.mark(flag);\\n    }\\n2330→\\n    fn cell_burning(&self, x: f32, z: f32) -> bool {\\n        self.fire.cells.get(&geom::cell_of(x, z)).is_some_and(|c| c.burning)\\n    }\\n\\n    fn town_burning(&self) -> bool {\\n        self.fire.cells.iter().any(|(c, cell)| {\\n            if !cell.burning {\\n                return false;\\n            }\\n2340→            let (x, z) = geom::cell_center(*c);\\n            geom::in_town(x, z)\\n        })\\n    }\\n\\n    pub fn choose_finale(&mut self, n: u8) {\\n        self.finale = Some(n);\\n        self.screen = Screen::Playing;\\n        self.focus = 0;\\n        self.idle = 0.0;\\n2350→        self.hold_t = 0.0;\\n        match n {\\n            0 => self.arm(WeaponId::Flare),\\n            1 => {\\n                self.clear_bodies();\\n                for i in 0..3 {\\n                    self.spawn_soldier(self.x + 40.0 + i as f32 * 4.0, self.z - 50.0, 30.0, false);\\n                }\\n                self.syrettes = self.syrettes.max(4);\\n            }\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs\",\"offset\":2280,\"limit\":80,\"raw_output\":\"        g.cooldown = 0.0;\\n        g.condition = 100.0;\\n        let mag = gun::stats(id).mag.max(1);\\n        if g.ammo < mag {\\n            g.ammo = mag;\\n        }\\n    }\\n\\n    fn prep_ignite(&mut self, n: u8) {\\n        match n {\\n            0 => self.arm(WeaponId::Flare),\\n            1 => self.arm(WeaponId::Rpg),\\n   