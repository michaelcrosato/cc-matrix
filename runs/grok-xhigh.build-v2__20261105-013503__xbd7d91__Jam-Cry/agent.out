13503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/mod.rs\",\"matches\":[{\"line_number\":1,\"content\":\"//! Jam Cry. The country is [`world::World`]; the pavilion room is a dusk overlook the body stands in.\"},{\"line_number\":34,\"content\":\"/// Where the window looks. Menus keep the dusk overlook. Play copies the body.\"},{\"line_number\":50,\"content\":\"pub fn overlook() -> Overlook {\"},{\"line_number\":54,\"content\":\"fn aim_overlook(eye: [f32; 3], yaw: f32, pitch: f32, roll: f32) {\"},{\"line_number\":62,\"content\":\"/// Same basis as `pav_view::camera::fp_basis`. Yaw 0, pitch 0, roll 0 → forward (0, 0, −1), right (1, 0, 0).\"},{\"line_number\":97,\"content\":\"/// Builds the overlook and starts a human-route contract. History stays off: the save is the world.\"},{\"line_number\":260,\"content\":\"            aim_overlook([x, y, z], self.world.yaw, pitch, self.world.roll);\"},{\"line_number\":262,\"content\":\"            aim_overlook([0.15, 1.55, 4.2], 0.0, -0.42, 0.0);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs\",\"matches\":[{\"line_number\":2747,\"content\":\"        \\\"Art Direction: sun-bleached dusk, laterite gold, dry grass, and a low sun. The overlook is flat boxes dressed in code.\\\".into(),\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/tests/merc.rs\",\"matches\":[{\"line_number\":699,\"content\":\"    let cam = merc::overlook();\"},{\"line_number\":708,\"content\":\"    let cam = merc::overlook();\"},{\"line_number\":718,\"content\":\"    let cam = merc::overlook();\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"379221bd-73c5-424b-85b7-3ce9a6234c0e