ber\":70,\"content\":\"        v.bool(\\\"show_guide\\\", &mut self.show_guide, \\\"Control guide overlay\\\");\"},{\"line_number\":141,\"content\":\"    show_boot: bool,\"},{\"line_number\":230,\"content\":\"                show_guide: true,\"},{\"line_number\":238,\"content\":\"            show_boot: true,\"},{\"line_number\":297,\"content\":\"            app.show_boot = false;\"},{\"line_number\":460,\"content\":\"            self.show_boot = false;\"},{\"line_number\":462,\"content\":\"            self.app_settings.show_guide = false;\"},{\"line_number\":473,\"content\":\"            self.show_boot = false;\"},{\"line_number\":475,\"content\":\"            self.app_settings.show_guide = false;\"},{\"line_number\":494,\"content\":\"            self.show_boot = false;\"},{\"line_number\":496,\"content\":\"            self.app_settings.show_guide = false;\"},{\"line_number\":865,\"content\":\"                KeyCode::Escape if ui.any_open() => {\"},{\"line_number\":873,\"content\":\"            KeyCode::Escape => {\"},{\"line_number\":893,\"content\":\"            KeyCode::F3 => self.show_boot = !self.show_boot,\"},{\"line_number\":1331,\"content\":\"            if t.elapsed().as_secs_f32() > 10.0 && self.show_boot {\"},{\"line_number\":1332,\"content\":\"                self.show_boot = false;\"},{\"line_number\":1339,\"content\":\"            !studio_active && self.app_settings.show_guide && self.started.elapsed().as_secs_f32() < 25.0 && !card_visible;\"},{\"line_number\":1358,\"content\":\"        let mut show_boot = self.show_boot;\"},{\"line_number\":1416,\"content\":\"            ui::boot_panel(&ctx, &mut show_boot);\"},{\"line_number\":1525,\"content\":\"                    ui::pause_menu(&ctx, device, &scene_name, difficulty)\"},{\"line_number\":1566,\"content\":\"        self.show_boot = show_boot;\"},{\"line_number\":2167,\"content\":\"                        KeyCode::Escape\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0