,{\"line_number\":84,\"content\":\"            // Non-sRGB target: the post pass encodes sRGB itself, and egui expects a linear-blend target.\"},{\"line_number\":95,\"content\":\"        let egui = stage(\\\"ui renderer\\\", || {\"},{\"line_number\":96,\"content\":\"            Ok((egui_wgpu::Renderer::new(&device, config.format, egui_wgpu::RendererOptions::default()), String::new()))\"},{\"line_number\":99,\"content\":\"        Ok(Self { window, surface, adapter, device, queue, config, renderer, egui, vsync, adapter_name, gpu_errors })\"},{\"line_number\":139,\"content\":\"    /// Renders the scene plus the egui overlay and presents. Texture updates are always\"},{\"line_number\":141,\"content\":\"    pub fn draw(&mut self, scene: &Scene, ui: Option<(&[egui::ClippedPrimitive], &mut egui::TexturesDelta, f32)>) -> bool {\"},{\"line_number\":146,\"content\":\"                    self.egui.update_texture(&self.device, &self.queue, *id, delta);\"},{\"line_number\":159,\"content\":\"                let sd = egui_wgpu::ScreenDescriptor { size_in_pixels: [size.0, size.1], pixels_per_point: *ppp };\"},{\"line_number\":160,\"content\":\"                cmds = self.egui.update_buffers(&self.device, &self.queue, &mut encoder, prims, &sd);\"},{\"line_number\":162,\"content\":\"                    label: Some(\\\"egui\\\"),\"},{\"line_number\":174,\"content\":\"                self.egui.render(&mut pass.forget_lifetime(), prims, &sd);\"},{\"line_number\":182,\"content\":\"                self.egui.free_texture(id);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_app/src/rooms.rs\",\"matches\":[{\"line_number\":10,\"content\":\"use egui::RichText;\"},{\"line_number\":93,\"content\":\"    pub fn card(&mut self, ctx: &egui::Context, last_device: Device) -> bool {\"},{\"line_number\":98,\"content\":\"        egui::Window::new(if def.name.is_empty() { room.key.clone() } else { def.name.clone() })\"},{\"line_number\":99,\"content\":\"            .id(egui::Id::new(\\\"room_card\\\"))\"},{\"line_number\":101,\"content\":\"            .anchor(egui::Align2::LEFT_TOP, [12.0, 12.0])\"},{\"line_number\":143,\"content\":\"                egui::Grid::new(\\\"room_guide\\\").show(ui, |ui| {\"},{\"line_number\":170,\"content\":\"    pub fn teleport_menu(&mut self, ctx: &egui::Context) -> Option<TeleportTarget> {\"},{\"line_number\":176,\"content\":\"        egui::Window::new(\\\"Go to\\\")\"},{\"line_number\":178,\"content\":\"            .anchor(egui::Align2::CENTER_CENTER, [0.0, 0.0])\"},{\"line_number\":205,\"content\":\"                        ui.label(RichText::new(e).color(egui::Color32::LIGHT_RED).small());\"},{\"line_number\":216,\"content\":\"    pub fn error_panel(&self, ctx: &egui::Context) {\"},{\"line_number\":220,\"content\":\"        egui::Area::new(egui::Id::new(\\\"room_errors\\\")).anchor(egui::Align2::CENTER_BOTTOM, [0.0, -40.0]).show(ctx, |ui| {\"},{\"line_number\":221,\"content\":\"            egui::Frame::popup(ui.style()).fill(egui::Color32::from_rgb(70, 20, 20)).show(ui, |ui| {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_app/src/hud.rs\",\"matches\":[{\"line_number\":10,\"content\":\"use egui::{Color32, RichText};\"},{\"line_number\":134,\"content\":\"pub fn course_hud(ctx: &egui::Context, h: &HudCtx) {\"},{\"line_number\":141,\"content\":\"    egui::Area::new(egui::Id::new(\\\"course_hud\\\")).anchor(egui::Align2::CENTER_TOP, [0.0, 10.0]).show(ctx, |ui| {\"},{\"line_number\":142,\"content\":\"        egui::Frame::popup(ui.style()).show(ui, |ui| {\"},{\"line_number\":202,\"content\":\"                    let (rect, _) = ui.allocate_exact_size(egui::vec2(320.0, 12.0), egui::Sense::hover());\"},{\"line_number\":214,\"content\":\"pub fn hit_flash(ctx: &egui::Context, invuln: f32) {\"},{\"line_number\