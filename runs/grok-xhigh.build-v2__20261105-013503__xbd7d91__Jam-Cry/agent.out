91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs\",\"matches\":[{\"line_number\":1467,\"content\":\"    pub fn resolve_shot(&mut self, ads: bool) {\"},{\"line_number\":2101,\"content\":\"    fn blow_tanks(&mut self) {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/fire.rs\",\"matches\":[{\"line_number\":41,\"content\":\"    pub fn ignite_at(&mut self, x: f32, z: f32, life: f32, minutes: f32) -> bool {\"},{\"line_number\":66,\"content\":\"    pub fn ignite_disk(&mut self, x: f32, z: f32, radius: f32, life: f32, minutes: f32) -> u32 {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/geom.rs\",\"matches\":[{\"line_number\":220,\"content\":\"pub fn fuel(x: f32, z: f32) -> f32 {\"},{\"line_number\":232,\"content\":\"pub fn height(x: f32, z: f32) -> f32 {\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-a64ab4b5-044f-4c2f-a459-98320b491cf4-6","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"698→    fn advance_script(&mut self, dt: f32) {\\n        if self.finished {\\n700→            return;\\n        }\\n        self.step_t += dt;\\n        for _ in 0..12 {\\n            let Some(spec) = self.current() else {\\n                self.finished = true;\\n                break;\\n            };\\n            if !self.step_ready {\\n                self.begin(spec);\\n710→                self.step_ready = true;\\n                self.step_t = 0.0;\\n            }\\n            if self.done(spec) {\\n                self.step += 1;\\n                self.step_ready = false;\\n                self.step_t = 0.0;\\n            } else {\\n                break;\\n            }\\n720→        }\\n    }\\n\\n    fn begin(&mut self, spec: Spec) {\\n        self.step_x = self.x;\\n        self.step_z = self.z;\\n        self.hold_t = 0.0;\\n        match spec {\\n            Spec::Fever => {\\n                self.fever_t = self.tune.fever_interval;\\n730→            }\\n            Spec::Blackout => {\\n                self.pills = 0;\\n                self.fever_state = 2;\\n                self.fever_attack = 0.0;\\n            }\\n            Spec::Fight => {\\n                self.clear_bodies();\\n                for i in 0..4 {\\n                    let ang = i as f32 * 0.4;\\n740→                    self.spawn_soldier(self.x + ang.sin() * 12.0, self.z - 12.0, 36.0, false);\\n                }\\n            }\\n            Spec::EnemyJam => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 8.0, 80.0, true);\\n            }\\n            Spec::Jam => {\\n                let g = self.gun_mut();\\n                g.force_jam = true;\\n750→                g.jammed = false;\\n                g.broken = false;\\n                g.ammo = 12;\\n                g.condition = 40.0;\\n                self.jam_seen = false;\\n            }\\n            Spec::Break => {\\n                self.guns.push(Gun::new(WeaponId::Smg));\\n                self.slot = self.guns.len() - 1;\\n                let g = self.gun_mut();\\n760→                g.condition = 5.0;\\n                g.wear = 0.0;\\n                g.ammo = 999;\\n                g.reserve = 999;\\n                g.jammed = false;\\n                g.broken = false;\\n                g.cooldown = 0.0;\\n            }\\n            Spec::Rescue => {\\n                self.hp = 0.0;\\n770→                self.rescue_t = 0.0;\\n                for c in &mut self.companions {\\n                    c.alive = true;\\n                    c.rescue_spent = false;\\n                    c.down = false;\\n                }\\n            }\\n            Spec::Wound(n) => {\\n                self.hp = 15.0;\\n                self.wound = n;\\n780→                self.heal_t = 0.0;\\n                self.treating = false;\\n            }\\n            Spec::Syrette => {\\n                if self.hp > 70.0 {\\n                    self.hp = 45.0;\\n                }\\n                self.syrettes = self.syrettes.max(1);\\n            }\\n            Spec::Shop => {\\n790→                if !self.guns.iter().any(|g| g.id == WeaponId::Battle) {\\n                    // The shelf is stocked. Buying happens on the interact.\\n                }\\n            }\\n            Spec::Drive { .. } => {\\n                self.wind = Vec2::new(9.0, 0.0);\\n                if self.ride.kind == 0 {\\n                    self.ride.kind = 1;\\n                    self.ride.seat = 1;\\n                    self.ride.x = self.x;\\n800→                    self.ride.z = self.z;\\n                    self.ride.health = 100.0;\\n                    self.ride.stage = 0;\\n                    self.ride.speed = 0.0;\\n                }\\n            }\\n            Spec::Mono => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 24.0, 40.0, false);\\n                self.mono_t = 0.0;\\n810→            }\\n            Spec::Tanks => {\\n                self.spawn_tank_farm();\\n            }\\n            Spec::Panic => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x + 4.0, self.z - 4.0, 40.0, false);\\n                let _ = self.fire.ignite_at(self.x + 4.0, self.z - 4.0, self.tune.burn_time, self.minutes);\\n            }\\n            Spec::Animals => {\\n820→                self.clear_bodies();\\n                self.spawn_animal(self.x + 6.0, self.z - 6.0);\\n            }\\n            Spec::Night => {\\n                self.minutes = 22.0 * 60.0;\\n                self.mark(\\\"night_contract\\\");\\n            }\\n            Spec::Boat => {\\n                let (wx, wz) = geom::nearest_water(self.x, self.z);\\n                self.ride.kind = 2;\\n830→                self.ride.seat = 1;\\n                self.ride.x = wx;\\n                self.ride.z = wz;\\n                self.ride.speed = 0.0;\\n                self.ride.health = 100.0;\\n                self.x = wx;\\n                self.z = wz;\\n                self.boat_dist = 0.0;\\n            }\\n            Spec::Stealth => {\\n840→                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 2.0, 40.0, false);\\n                if let Some(b) = self.bodies.last_mut() {\\n                    b.yaw = 0.0;\\n                    b.alert = 0;\\n                }\\n                self.stance = 1;\\n            }\\n            Spec::Dart => {\\n                self.clear_bodies();\\n850→                self.spawn_soldier(self.x, self.z - 18.0, 40.0, false);\\n                self.guns.push(Gun::new(WeaponId::Dart));\\n                self.slot = self.guns.len() - 1;\\n            }\\n            Spec::Repair => {\\n                if self.ride.kind == 0 {\\n                    self.ride.kind = 1;\\n                    self.ride.x = self.x;\\n                    self.ride.z = self.z;\\n                }\\n860→                self.ride.seat = 0;\\n                self.ride.health = 35.0;\\n                self.ride.stage = 2;\\n                self.ride.repair = 0.0;\\n            }\\n            Spec::Rain => {\\n                let _ = self.fire.ignite_at(self.x + 3.0, self.z, self.tune.burn_time, self.minutes);\\n                self.weather = 1;\\n            }\\n            Spec::Patch | Spec::Overdose | Spec::Die => {\\n870→                self.mark(\\\"better_way\\\");\\n                if let Some(c) = self.companions.iter_mut().find(|c| c.alive) {\\n                    c.down = true;\\n                    c.down_t = 0.0;\\n                    c.x = if matches!(spec, Spec::Die) { self.x + 40.0 } else { self.x + 1.5 };\\n                    c.z = self.z;\\n                }\\n                if matches!(spec, Spec::Overdose) {\\n                    if let Some(c) = self.companions.iter_mut().find(|c| c.down) {\\n                        c.down_t = 0.0;\\n880→                    }\\n                }\\n            }\\n            Spec::Ceasefire => {\\n                self.guns.push(Gun::new(WeaponId::Sniper));\\n                self.slot = self.guns.len() - 1;\\n                self.spawn_soldier(self.x, self.z - 30.0, 30.0, false);\\n            }\\n            Spec::Convoy => {\\n                self.clear_bodies();\\n890→                self.spawn_truck(self.x, self.z - 16.0);\\n                self.guns.push(Gun::new(WeaponId::Rpg));\\n                self.slot = self.guns.len() - 1;\\n            }\\n            Spec::Town => {\\n                let (tx, tz) = geom::place(\\\"Kilometre 40\\\");\\n                self.x = tx;\\n                self.z = tz;\\n                let _ = self.fire.ignite_disk(tx, tz + 20.0, 10.0, self.tune.burn_time, self.minutes);\\n                self.mark(\\\"town_burned\\\");\\n900→            }\\n            Spec::Ending(1) => {\\n                self.clear_bodies();\\n                for i in 0..3 {\\n                    self.spawn_soldier(self.x + 40.0 + i as f32 * 4.0, self.z - 50.0, 30.0, false);\\n                }\\n                self.syrettes = self.syrettes.max(4);\\n                self.hold_t = 0.0;\\n            }\\n            Spec::Flag(s) => self.mark(s),\\n910→            _ => {}\\n        }\\n    }\\n\\n    fn done(&mut self, spec: Spec) -> bool {\\n        match spec {\\n            Spec::Boot => self.screen == Screen::Playing,\\n            Spec::Map => self.flags.contains(\\\"map_raised\\\"),\\n            Spec::Way => self.flags.contains(\\\"waypoint_set\\\"),\\n            Spec::Reach { x, z, gps } => {\\n920→                if gps && self.waypoint.is_some() && geom::dist(self.x, self.z, self.step_x, self.step_z) > 25.0 {\\n                    self.mark(\\\"gps_followed\\\");\\n                }\\n                geom::dist(self.x, self.z, x, z) < 10.0 && (!gps || self.flags.contains(\\\"gps_followed\\\"))\\n            }\\n            Spec::Fever => self.flags.contains(\\\"fever_warned\\\"),\\n            Spec::Pill => self.flags.contains(\\\"pill_taken\\\"),\\n            Spec::Blackout => self.flags.contains(\\\"blackout\\\"),\\n            Spec::Fight => {\\n                let clear = self.bodies.iter().filter(|b| b.kind == 1).all(|b| !b.alive);\\n930→                if clear && !self.bodies.is_empty() {\\n                    self.post_clear = true;\\n                    self.post_reman_at = self.minutes + self.tune.post_reman_hours * 60.0;\\n                    self.mark(\\\"post_cleared\\\");\\n                }\\n                clear && self.flags.contains(\\\"post_cleared\\\")\\n            }\\n            Spec::EnemyJam => self.flags.contains(\\\"enemy_jam\\\"),\\n            Spec::Jam => self.flags.contains(\\\"jam_cleared\\\"),\\n            Spec::Break => {\\n940→                if self.gun().broken {\\n                    self.mark(\\\"weapon_broke\\\");\\n                    self.slot = 0;\\n                }\\n                self.flags.contains(\\\"weapon_broke\\\")\\n            }\\n            Spec::Rescue => self.flags.contains(\\\"player_rescued\\\"),\\n            Spec::Wound(n) => self.flags.contains(wound_flag(n)),\\n            Spec::Loot => self.guns.iter().any(|g| g.id == WeaponId::Ar),\\n            Spec::Claim => self.flags.contains(\\\"safe_house_claimed\\\"),\\n950→            Spec::Shop => self.flags.contains(\\\"weapon_bought\\\"),\\n            Spec::Locker => self.flags.contains(\\\"locker_used\\\"),\\n            Spec::Syrette => self.flags.contains(\\\"syrette\\\"),\\n            Spec::Tracker => self.flags.contains(\\\"cache_tracker\\\"),\\n            Spec::Sleep { .. } => self.flags.contains(\\\"sleep_used\\\") && self.step_t > 0.2,\\n            Spec::Drive { x, z } => geom::dist(self.x, self.z, x, z) < 12.0 && self.flags.contains(\\\"technical_driven\\\"),\\n            Spec::Mono => self.flags.contains(\\\"monocular_tag\\\"),\\n            Spec::Ignite(n) => self.flags.contains(ignite_flag(n)),\\n            Spec::Tanks => self.flags.contains(\\\"cells_500\\\") && self.flags.contains(\\\"explosion_chain\\\"),\\n            Spec::Mounted => self.flags.contains(\\\"mounted_gun\\\"),\\n960→            Spec::Panic => self.flags.contains(\\\"enemy_panicked\\\"),\\n            Spec::Animals => self.flags.contains(\\\"animals_fled\\\"),\\n            Spec::Bus { x, z } => self.flags.contains(\\\"bus_taken\\\") && geom::dist(self.x, self.z, x, z) < 12.0,\\n            Spec::Night => self.flags.contains(\\\"night_contract\\\"),\\n            Spec::Boat => self.flags.contains(\\\"boat_driven\\\"),\\n            Spec::Stealth => self.flags.contains(\\\"stealth_kill\\\"),\\n            Spec::Dart => self.flags.contains(\\\"dart_kill\\\"),\\n            Spec::Repair => self.flags.contains(\\\"repair_done\\\"),\\n            Spec::Rain => self.flags.contains(\\\"rain_extinguished\\\"),\\n            Spec::Better => self.flags.contains(\\\"better_way\\\") || self.companions.iter().any(|c| c.down),\\n970→            Spec::Patch => self.flags.contains(\\\"companion_patched\\\"),\\n            Spec::Overdose => self.flags.contains(\\\"companion_overdosed\\\"),\\n            Spec::Die => self.flags.contains(\\\"companion_died\\\"),\\n            Spec::Tape => self.flags.contains(\\\"tape_played\\\"),\\n            Spec::Ceasefire => self.flags.contains(\\\"ceasefire_ended\\\"),\\n            Spec::Convoy => self.bodies.iter().filter(|b| b.kind == 6).all(|b| !b.alive) && !self.bodies.is_empty(),\\n            Spec::Town => self.flags.contains(\\\"town_burned\\\"),\\n            Spec::Ending(n) => self.flags.contains(ending_flag(n)),\\n            Spec::Flag(s) => self.flags.contains(s),\\n        }\\n980→    }\\n\\n    fn bot_spec(&self, spec: Spec) -> InputFrame {\\n        let mut f = InputFrame::default();\\n        match spec {\\n            Spec::Map => {\\n                f.held = buttons::MAP;\\n                f.pressed = buttons::MAP;\\n            }\\n            Spec::Way | Spec::Claim | Spec::Shop | Spec::Locker | Spec::Loot | Spec::Tape | Spec::Ending(2) => {\\n990→                f.act = 1;\\n                f.pressed = buttons::INTERACT;\\n                f.held = buttons::INTERACT;\\n            }\\n            Spec::Reach { x, z, .. } => return self.bot_go(x, z, true),\\n            Spec::Tracker => {\\n                let (tx, tz) = self.tracker_cache;\\n                return self.bot_go(tx, tz, true);\\n            }\\n            Spec::Pill => {\\n1000→                f.held = buttons::PILLS;\\n                f.pressed = buttons::PILLS;\\n            }\\n            Spec::Fight | Spec::Ceasefire | Spec::Convoy | Spec::Ignite(10) => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive && b.kind != 3) {\\n                    return self.bot_aim(b.x, b.z, 1.7, true);\\n                }\\n                f.held = buttons::PRIMARY;\\n            }\\n            Spec::EnemyJam | Spec::Blackout | Spec::Fever | Spec::Die | Spec::Ending(1) => {\\n1010→                if matches!(spec, Spec::Ending(1)) {\\n                    f.held = buttons::CROUCH;\\n                }\\n            }\\n            Spec::Jam | Spec::Break => {\\n                if self.gun().jammed {\\n                    f.pressed = buttons::RELOAD;\\n                    f.held = buttons::RELOAD;\\n                } else {\\n                    f.held = buttons::PRIMARY | buttons::SECONDARY;\\n1020→                    f.pressed = buttons::PRIMARY;\\n                }\\n            }\\n            Spec::Rescue => {}\\n            Spec::Wound(_) => {\\n                f.held = buttons::HEAL;\\n                f.pressed = buttons::HEAL;\\n            }\\n            Spec::Syrette => {\\n                f.pressed = buttons::HEAL;\\n1030→                f.held = buttons::HEAL;\\n            }\\n            Spec::Sleep { .. } => {\\n                let (hx, hz) = geom::nearest_safe(self.x, self.z);\\n                if geom::dist(self.x, self.z, hx, hz) > 8.0 && self.ride.seat == 0 {\\n                    return self.bot_go(hx, hz, true);\\n                }\\n                if self.ride.seat != 0 {\\n                    f.pressed = buttons::USE;\\n                } else {\\n1040→                    f.held = buttons::INTERACT;\\n                    f.pressed = buttons::INTERACT;\\n                }\\n            }\\n            Spec::Drive { x, z } => {\\n                let (tx, tz) = (x, z);\\n                if self.ride.seat == 0 {\\n                    f.pressed = buttons::USE;\\n                    return f;\\n                }\\n1050→                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Bus { .. } => {\\n                let (tx, tz) = geom::place(\\\"Junction\\\");\\n                if self.ride.seat == 0 {\\n                    f.pressed = buttons::USE;\\n                    return f;\\n                }\\n                return self.bot_drive(tx, tz);\\n            }\\n1060→            Spec::Mono => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive) {\\n                    let mut aim = self.bot_aim(b.x, b.z, 1.6, false);\\n                    aim.held |= buttons::MONOCULAR;\\n                    aim.pressed |= buttons::MONOCULAR;\\n                    return aim;\\n                }\\n            }\\n            Spec::Ignite(k) => {\\n                if k == 10 {\\n1070→                    f.held = buttons::PRIMARY;\\n                } else if k == 11 {\\n                    f.held = buttons::INTERACT;\\n                    f.pressed = buttons::INTERACT;\\n                } else {\\n                    f.pressed = buttons::PRIMARY;\\n                    f.held = buttons::PRIMARY;\\n                }\\n            }\\n            Spec::Tanks | Spec::Mounted => {\\n1080→                f.held = buttons::PRIMARY;\\n                f.pressed = buttons::PRIMARY;\\n                if matches!(spec, Spec::Mounted) {\\n                    f.pressed |= buttons::USE;\\n                }\\n            }\\n            Spec::Panic | Spec::Animals => {\\n                f.pressed = buttons::PRIMARY;\\n                f.held = buttons::PRIMARY;\\n            }\\n1090→            Spec::Boat => {\\n                let (tx, tz) = geom::water_ahead(self.ride.x, self.ride.z, 50.0);\\n                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Stealth => {\\n                f.held = buttons::CROUCH | buttons::MELEE;\\n                f.pressed = buttons::MELEE;\\n            }\",\"content_concise\":\"698→    fn advance_script(&mut self, dt: f32) {\\n        if self.finished {\\n700→            return;\\n        }\\n        self.step_t += dt;\\n        for _ in 0..12 {\\n            let Some(spec) = self.current() else {\\n                self.finished = true;\\n                break;\\n            };\\n            if !self.step_ready {\\n                self.begin(spec);\\n710→                self.step_ready = true;\\n                self.step_t = 0.0;\\n            }\\n            if self.done(spec) {\\n                self.step += 1;\\n                self.step_ready = false;\\n                self.step_t = 0.0;\\n            } else {\\n                break;\\n            }\\n720→        }\\n    }\\n\\n    fn begin(&mut self, spec: Spec) {\\n        self.step_x = self.x;\\n        self.step_z = self.z;\\n        self.hold_t = 0.0;\\n        match spec {\\n            Spec::Fever => {\\n                self.fever_t = self.tune.fever_interval;\\n730→            }\\n            Spec::Blackout => {\\n                self.pills = 0;\\n                self.fever_state = 2;\\n                self.fever_attack = 0.0;\\n            }\\n            Spec::Fight => {\\n                self.clear_bodies();\\n                for i in 0..4 {\\n                    let ang = i as f32 * 0.4;\\n740→                    self.spawn_soldier(self.x + ang.sin() * 12.0, self.z - 12.0, 36.0, false);\\n                }\\n            }\\n            Spec::EnemyJam => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 8.0, 80.0, true);\\n            }\\n            Spec::Jam => {\\n                let g = self.gun_mut();\\n                g.force_jam = true;\\n750→                g.jammed = false;\\n                g.broken = false;\\n                g.ammo = 12;\\n                g.condition = 40.0;\\n                self.jam_seen = false;\\n            }\\n            Spec::Break => {\\n                self.guns.push(Gun::new(WeaponId::Smg));\\n                self.slot = self.guns.len() - 1;\\n                let g = self.gun_mut();\\n760→                g.condition = 5.0;\\n                g.wear = 0.0;\\n                g.ammo = 999;\\n                g.reserve = 999;\\n                g.jammed = false;\\n                g.broken = false;\\n                g.cooldown = 0.0;\\n            }\\n            Spec::Rescue => {\\n                self.hp = 0.0;\\n770→                self.rescue_t = 0.0;\\n                for c in &mut self.companions {\\n                    c.alive = true;\\n                    c.rescue_spent = false;\\n                    c.down = false;\\n                }\\n            }\\n            Spec::Wound(n) => {\\n                self.hp = 15.0;\\n                self.wound = n;\\n780→                self.heal_t = 0.0;\\n                self.treating = false;\\n            }\\n            Spec::Syrette => {\\n                if self.hp > 70.0 {\\n                    self.hp = 45.0;\\n                }\\n                self.syrettes = self.syrettes.max(1);\\n            }\\n            Spec::Shop => {\\n790→                if !self.guns.iter().any(|g| g.id == WeaponId::Battle) {\\n                    // The shelf is stocked. Buying happens on the interact.\\n                }\\n            }\\n            Spec::Drive { .. } => {\\n                self.wind = Vec2::new(9.0, 0.0);\\n                if self.ride.kind == 0 {\\n                    self.ride.kind = 1;\\n                    self.ride.seat = 1;\\n                    self.ride.x = self.x;\\n800→                    self.ride.z = self.z;\\n                    self.ride.health = 100.0;\\n                    self.ride.stage = 0;\\n                    self.ride.speed = 0.0;\\n                }\\n            }\\n            Spec::Mono => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 24.0, 40.0, false);\\n                self.mono_t = 0.0;\\n810→            }\\n            Spec::Tanks => {\\n                self.spawn_tank_farm();\\n            }\\n            Spec::Panic => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x + 4.0, self.z - 4.0, 40.0, false);\\n                let _ = self.fire.ignite_at(self.x + 4.0, self.z - 4.0, self.tune.burn_time, self.minutes);\\n            }\\n            Spec::Animals => {\\n820→                self.clear_bodies();\\n                self.spawn_animal(self.x + 6.0, self.z - 6.0);\\n            }\\n            Spec::Night => {\\n                self.minutes = 22.0 * 60.0;\\n                self.mark(\\\"night_contract\\\");\\n            }\\n            Spec::Boat => {\\n                let (wx, wz) = geom::nearest_water(self.x, self.z);\\n                self.ride.kind = 2;\\n830→                self.ride.seat = 1;\\n                self.ride.x = wx;\\n                self.ride.z = wz;\\n                self.ride.speed = 0.0;\\n                self.ride.health = 100.0;\\n                self.x = wx;\\n                self.z = wz;\\n                self.boat_dist = 0.0;\\n            }\\n            Spec::Stealth => {\\n840→                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 2.0, 40.0, false);\\n                if let Some(b) = self.bodies.last_mut() {\\n                    b.yaw = 0.0;\\n                    b.alert = 0;\\n                }\\n                self.stance = 1;\\n            }\\n            Spec::Dart => {\\n                self.clear_bodies();\\n850→                self.spawn_soldier(self.x, self.z - 18.0, 40.0, false);\\n                self.guns.push(Gun::new(WeaponId::Dart));\\n                self.slot = self.guns.len() - 1;\\n            }\\n            Spec::Repair => {\\n                if self.ride.kind == 0 {\\n                    self.ride.kind = 1;\\n                    self.ride.x = self.x;\\n                    self.ride.z = self.z;\\n                }\\n860→                self.ride.seat = 0;\\n                self.ride.health = 35.0;\\n                self.ride.stage = 2;\\n                self.ride.repair = 0.0;\\n            }\\n            Spec::Rain => {\\n                let _ = self.fire.ignite_at(self.x + 3.0, self.z, self.tune.burn_time, self.minutes);\\n                self.weather = 1;\\n            }\\n            Spec::Patch | Spec::Overdose | Spec::Die => {\\n870→                self.mark(\\\"better_way\\\");\\n                if let Some(c) = self.companions.iter_mut().find(|c| c.alive) {\\n                    c.down = true;\\n                    c.down_t = 0.0;\\n                    c.x = if matches!(spec, Spec::Die) { self.x + 40.0 } else { self.x + 1.5 };\\n                    c.z = self.z;\\n                }\\n                if matches!(spec, Spec::Overdose) {\\n                    if let Some(c) = self.companions.iter_mut().find(|c| c.down) {\\n                        c.down_t = 0.0;\\n880→                    }\\n                }\\n            }\\n            Spec::Ceasefire => {\\n                self.guns.push(Gun::new(WeaponId::Sniper));\\n                self.slot = self.guns.len() - 1;\\n                self.spawn_soldier(self.x, self.z - 30.0, 30.0, false);\\n            }\\n            Spec::Convoy => {\\n                self.clear_bodies();\\n890→                self.spawn_truck(self.x, self.z - 16.0);\\n                self.guns.push(Gun::new(WeaponId::Rpg));\\n                self.slot = self.guns.len() - 1;\\n            }\\n            Spec::Town => {\\n                let (tx, tz) = geom::place(\\\"Kilometre 40\\\");\\n                self.x = tx;\\n                self.z = tz;\\n                let _ = self.fire.ignite_disk(tx, tz + 20.0, 10.0, self.tune.burn_time, self.minutes);\\n                self.mark(\\\"town_burned\\\");\\n900→            }\\n            Spec::Ending(1) => {\\n                self.clear_bodies();\\n                for i in 0..3 {\\n                    self.spawn_soldier(self.x + 40.0 + i as f32 * 4.0, self.z - 50.0, 30.0, false);\\n                }\\n                self.syrettes = self.syrettes.max(4);\\n                self.hold_t = 0.0;\\n            }\\n            Spec::Flag(s) => self.mark(s),\\n910→            _ => {}\\n        }\\n    }\\n\\n    fn done(&mut self, spec: Spec) -> bool {\\n        match spec {\\n            Spec::Boot => self.screen == Screen::Playing,\\n            Spec::Map => self.flags.contains(\\\"map_raised\\\"),\\n            Spec::Way => self.flags.contains(\\\"waypoint_set\\\"),\\n            Spec::Reach { x, z, gps } => {\\n920→                if gps && self.waypoint.is_some() && geom::dist(self.x, self.z, self.step_x, self.step_z) > 25.0 {\\n                    self.mark(\\\"gps_followed\\\");\\n                }\\n                geom::dist(self.x, self.z, x, z) < 10.0 && (!gps || self.flags.contains(\\\"gps_followed\\\"))\\n            }\\n            Spec::Fever => self.flags.contains(\\\"fever_warned\\\"),\\n            Spec::Pill => self.flags.contains(\\\"pill_taken\\\"),\\n            Spec::Blackout => self.flags.contains(\\\"blackout\\\"),\\n            Spec::Fight => {\\n                let clear = self.bodies.iter().filter(|b| b.kind == 1).all(|b| !b.alive);\\n930→                if clear && !self.bodies.is_empty() {\\n                    self.post_clear = true;\\n                    self.post_reman_at = self.minutes + self.tune.post_reman_hours * 60.0;\\n                    self.mark(\\\"post_cleared\\\");\\n                }\\n                clear && self.flags.contains(\\\"post_cleared\\\")\\n            }\\n            Spec::EnemyJam => self.flags.contains(\\\"enemy_jam\\\"),\\n            Spec::Jam => self.flags.contains(\\\"jam_cleared\\\"),\\n            Spec::Break => {\\n940→                if self.gun().broken {\\n                    self.mark(\\\"weapon_broke\\\");\\n                    self.slot = 0;\\n                }\\n                self.flags.contains(\\\"weapon_broke\\\")\\n            }\\n            Spec::Rescue => self.flags.contains(\\\"player_rescued\\\"),\\n            Spec::Wound(n) => self.flags.contains(wound_flag(n)),\\n            Spec::Loot => self.guns.iter().any(|g| g.id == WeaponId::Ar),\\n            Spec::Claim => self.flags.contains(\\\"safe_house_claimed\\\"),\\n950→            Spec::Shop => self.flags.contains(\\\"weapon_bought\\\"),\\n            Spec::Locker => self.flags.contains(\\\"locker_used\\\"),\\n            Spec::Syrette => self.flags.contains(\\\"syrette\\\"),\\n            Spec::Tracker => self.flags.contains(\\\"cache_tracker\\\"),\\n            Spec::Sleep { .. } => self.flags.contains(\\\"sleep_used\\\") && self.step_t > 0.2,\\n            Spec::Drive { x, z } => geom::dist(self.x, self.z, x, z) < 12.0 && self.flags.contains(\\\"technical_driven\\\"),\\n            Spec::Mono => self.flags.contains(\\\"monocular_tag\\\"),\\n            Spec::Ignite(n) => self.flags.contains(ignite_flag(n)),\\n            Spec::Tanks => self.flags.contains(\\\"cells_500\\\") && self.flags.contains(\\\"explosion_chain\\\"),\\n            Spec::Mounted => self.flags.contains(\\\"mounted_gun\\\"),\\n960→            Spec::Panic => self.flags.contains(\\\"enemy_panicked\\\"),\\n            Spec::Animals => self.flags.contains(\\\"animals_fled\\\"),\\n            Spec::Bus { x, z } => self.flags.contains(\\\"bus_taken\\\") && geom::dist(self.x, self.z, x, z) < 12.0,\\n            Spec::Night => self.flags.contains(\\\"night_contract\\\"),\\n            Spec::Boat => self.flags.contains(\\\"boat_driven\\\"),\\n            Spec::Stealth => self.flags.contains(\\\"stealth_kill\\\"),\\n            Spec::Dart => self.flags.contains(\\\"dart_kill\\\"),\\n            Spec::Repair => self.flags.contains(\\\"repair_done\\\"),\\n            Spec::Rain => self.flags.contains(\\\"rain_extinguished\\\"),\\n            Spec::Better => self.flags.contains(\\\"better_way\\\") || self.companions.iter().any(|c| c.down),\\n970→            Spec::Patch => self.flags.contains(\\\"companion_patched\\\"),\\n            Spec::Overdose => self.flags.contains(\\\"companion_overdosed\\\"),\\n            Spec::Die => self.flags.contains(\\\"companion_died\\\"),\\n            Spec::Tape => self.flags.contains(\\\"tape_played\\\"),\\n            Spec::Ceasefire => self.flags.contains(\\\"ceasefire_ended\\\"),\\n            Spec::Convoy => self.bodies.iter().filter(|b| b.kind == 6).all(|b| !b.alive) && !self.bodies.is_empty(),\\n            Spec::Town => self.flags.contains(\\\"town_burned\\\"),\\n            Spec::Ending(n) => self.flags.contains(ending_flag(n)),\\n            Spec::Flag(s) => self.flags.contains(s),\\n        }\\n980→    }\\n\\n    fn bot_spec(&self, spec: Spec) -> InputFrame {\\n        let mut f = InputFrame::default();\\n        match spec {\\n            Spec::Map => {\\n                f.held = buttons::MAP;\\n                f.pressed = buttons::MAP;\\n            }\\n            Spec::Way | Spec::Claim | Spec::Shop | Spec::Locker | Spec::Loot | Spec::Tape | Spec::Ending(2) => {\\n990→                f.act = 1;\\n                f.pressed = buttons::INTERACT;\\n                f.held = buttons::INTERACT;\\n            }\\n            Spec::Reach { x, z, .. } => return self.bot_go(x, z, true),\\n            Spec::Tracker => {\\n                let (tx, tz) = self.tracker_cache;\\n                return self.bot_go(tx, tz, true);\\n            }\\n            Spec::Pill => {\\n1000→                f.held = buttons::PILLS;\\n                f.pressed = buttons::PILLS;\\n            }\\n            Spec::Fight | Spec::Ceasefire | Spec::Convoy | Spec::Ignite(10) => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive && b.kind != 3) {\\n                    return self.bot_aim(b.x, b.z, 1.7, true);\\n                }\\n                f.held = buttons::PRIMARY;\\n            }\\n            Spec::EnemyJam | Spec::Blackout | Spec::Fever | Spec::Die | Spec::Ending(1) => {\\n1010→                if matches!(spec, Spec::Ending(1)) {\\n                    f.held = buttons::CROUCH;\\n                }\\n            }\\n            Spec::Jam | Spec::Break => {\\n                if self.gun().jammed {\\n                    f.pressed = buttons::RELOAD;\\n                    f.held = buttons::RELOAD;\\n                } else {\\n                    f.held = buttons::PRIMARY | buttons::SECONDARY;\\n1020→                    f.pressed = buttons::PRIMARY;\\n                }\\n            }\\n            Spec::Rescue => {}\\n            Spec::Wound(_) => {\\n                f.held = buttons::HEAL;\\n                f.pressed = buttons::HEAL;\\n            }\\n            Spec::Syrette => {\\n                f.pressed = buttons::HEAL;\\n1030→                f.held = buttons::HEAL;\\n            }\\n            Spec::Sleep { .. } => {\\n                let (hx, hz) = geom::nearest_safe(self.x, self.z);\\n                if geom::dist(self.x, self.z, hx, hz) > 8.0 && self.ride.seat == 0 {\\n                    return self.bot_go(hx, hz, true);\\n                }\\n                if self.ride.seat != 0 {\\n                    f.pressed = buttons::USE;\\n                } else {\\n1040→                    f.held = buttons::INTERACT;\\n                    f.pressed = buttons::INTERACT;\\n                }\\n            }\\n            Spec::Drive { x, z } => {\\n                let (tx, tz) = (x, z);\\n                if self.ride.seat == 0 {\\n                    f.pressed = buttons::USE;\\n                    return f;\\n                }\\n1050→                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Bus { .. } => {\\n                let (tx, tz) = geom::place(\\\"Junction\\\");\\n                if self.ride.seat == 0 {\\n                    f.pressed = buttons::USE;\\n                    return f;\\n                }\\n                return self.bot_drive(tx, tz);\\n            }\\n1060→            Spec::Mono => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive) {\\n                    let mut aim = self.bot_aim(b.x, b.z, 1.6, false);\\n                    aim.held |= buttons::MONOCULAR;\\n                    aim.pressed |= buttons::MONOCULAR;\\n                    return aim;\\n                }\\n            }\\n            Spec::Ignite(k) => {\\n                if k == 10 {\\n1070→                    f.held = buttons::PRIMARY;\\n                } else if k == 11 {\\n                    f.held = buttons::INTERACT;\\n                    f.pressed = buttons::INTERACT;\\n                } else {\\n                    f.pressed = buttons::PRIMARY;\\n                    f.held = buttons::PRIMARY;\\n                }\\n            }\\n            Spec::Tanks | Spec::Mounted => {\\n1080→                f.held = buttons::PRIMARY;\\n                f.pressed = buttons::PRIMARY;\\n                if matches!(spec, Spec::Mounted) {\\n                    f.pressed |= buttons::USE;\\n                }\\n            }\\n            Spec::Panic | Spec::Animals => {\\n                f.pressed = buttons::PRIMARY;\\n                f.held = buttons::PRIMARY;\\n            }\\n1090→            Spec::Boat => {\\n                let (tx, tz) = geom::water_ahead(self.ride.x, self.ride.z, 50.0);\\n                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Stealth => {\\n                f.held = buttons::CROUCH | buttons::MELEE;\\n                f.pressed = buttons::MELEE;\\n            }\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs\",\"offset\":698,\"limit\":400,\"raw_output\":\"    fn advance_script(&mut self, dt: f32) {\\n        if self.finished {\\n            return;\\n        }\\n        self.step_t += dt;\\n        for _ in 0..12 {\\n            let Some(spec) = self.current() else {\\n                self.finished = true;\\n                break;\\n            };\\n            if !self.step_ready {\\n                self.begin(spec);\\n                self.step_ready = true;\\n                self.step_t = 0.0;\\n            }\\n            if self.done(spec) {\\n                self.step += 1;\\n                self.step_ready = false;\\n                self.step_t = 0.0;\\n            } else {\\n                break;\\n            }\\n        }\\n    }\\n\\n    fn begin(&mut self, spec: Spec) {\\n        self.step_x = self.x;\\n        self.step_z = self.z;\\n        self.hold_t = 0.0;\\n        match spec {\\n            Spec::Fever => {\\n                self.fever_t = self.tune.fever_interval;\\n            }\\n            Spec::Blackout => {\\n                self.pills = 0;\\n                self.fever_state = 2;\\n                self.fever_attack = 0.0;\\n            }\\n            Spec::Fight => {\\n                self.clear_bodies();\\n                for i in 0..4 {\\n                    let ang = i as f32 * 0.4;\\n                    self.spawn_soldier(self.x + ang.sin() * 12.0, self.z - 12.0, 36.0, false);\\n                }\\n            }\\n            Spec::EnemyJam => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 8.0, 80.0, true);\\n            }\\n            Spec::Jam => {\\n                let g = self.gun_mut();\\n                g.force_jam = true;\\n                g.jammed = false;\\n                g.broken = false;\\n                g.ammo = 12;\\n                g.condition = 40.0;\\n                self.jam_seen = false;\\n            }\\n            Spec::Break => {\\n                self.guns.push(Gun::new(WeaponId::Smg));\\n                self.slot = self.guns.len() - 1;\\n                let g = self.gun_mut();\\n                g.condition = 5.0;\\n                g.wear = 0.0;\\n                g.ammo = 999;\\n                g.reserve = 999;\\n                g.jammed = false;\\n                g.broken = false;\\n                g.cooldown = 0.0;\\n            }\\n            Spec::Rescue => {\\n                self.hp = 0.0;\\n                self.rescue_t = 0.0;\\n                for c in &mut self.companions {\\n                    c.alive = true;\\n                    c.rescue_spent = false;\\n                    c.down = false;\\n                }\\n            }\\n            Spec::Wound(n) => {\\n                self.hp = 15.0;\\n                self.wound = n;\\n                self.heal_t = 0.0;\\n                self.treating = false;\\n            }\\n            Spec::Syrette => {\\n                if self.hp > 70.0 {\\n                    self.hp = 45.0;\\n                }\\n                self.syrettes = self.syrettes.max(1);\\n            }\\n            Spec::Shop => {\\n                if !self.guns.iter().any(|g| g.id == WeaponId::Battle) {\\n                    // The shelf is stocked. Buying happens on the interact.\\n                }\\n            }\\n            Spec::Drive { .. } => {\\n                self.wind = Vec2::new(9.0, 0.0);\\n                if self.ride.kind == 0 {\\n                    self.ride.kind = 1;\\n                    self.ride.seat = 1;\\n                    self.ride.x = self.x;\\n                    self.ride.z = self.z;\\n                    self.ride.health = 100.0;\\n                    self.ride.stage = 0;\\n                    self.ride.speed = 0.0;\\n                }\\n            }\\n            Spec::Mono => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 24.0, 40.0, false);\\n                self.mono_t = 0.0;\\n            }\\n            Spec::Tanks => {\\n                self.spawn_tank_farm();\\n            }\\n            Spec::Panic => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x + 4.0, self.z - 4.0, 40.0, false);\\n                let _ = self.fire.ignite_at(self.x + 4.0, self.z - 4.0, self.tune.burn_time, self.minutes);\\n            }\\n            Spec::Animals => {\\n                self.clear_bodies();\\n                self.spawn_animal(self.x + 6.0, self.z - 6.0);\\n            }\\n            Spec::Night => {\\n                self.minutes = 22.0 * 60.0;\\n                self.mark(\\\"night_contract\\\");\\n            }\\n            Spec::Boat => {\\n                let (wx, wz) = geom::nearest_water(self.x, self.z);\\n                self.ride.kind = 2;\\n                self.ride.seat = 1;\\n                self.ride.x = wx;\\n                self.ride.z = wz;\\n                self.ride.speed = 0.0;\\n                self.ride.health = 100.0;\\n                self.x = wx;\\n                self.z = wz;\\n                self.boat_dist = 0.0;\\n            }\\n            Spec::Stealth => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 2.0, 40.0, false);\\n                if let Some(b) = self.bodies.last_mut() {\\n                    b.yaw = 0.0;\\n                    b.alert = 0;\\n                }\\n                self.stance = 1;\\n            }\\n            Spec::Dart => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 18.0, 40.0, false);\\n                self.guns.push(Gun::new(WeaponId::Dart));\\n                self.slot = self.guns.len() - 1;\\n            }\\n            Spec::Repair => {\\n                if self.ride.kind == 0 {\\n                    self.ride.kind = 1;\\n                    self.ride.x = self.x;\\n                    self.ride.z = self.z;\\n                }\\n                self.ride.seat = 0;\\n                self.ride.health = 35.0;\\n                self.ride.stage = 2;\\n                self.ride.repair = 0.0;\\n            }\\n            Spec::Rain => {\\n                let _ = self.fire.ignite_at(self.x + 3.0, self.z, self.tune.burn_time, self.minutes);\\n                self.weather = 1;\\n            }\\n            Spec::Patch | Spec::Overdose | Spec::Die => {\\n                self.mark(\\\"better_way\\\");\\n                if let Some(c) = self.companions.iter_mut().find(|c| c.alive) {\\n                    c.down = true;\\n                    c.down_t = 0.0;\\n                    c.x = if matches!(spec, Spec::Die) { self.x + 40.0 } else { self.x + 1.5 };\\n                    c.z = self.z;\\n                }\\n                if matches!(spec, Spec::Overdose) {\\n                    if let Some(c) = self.companions.iter_mut().find(|c| c.down) {\\n                        c.down_t = 0.0;\\n                    }\\n                }\\n            }\\n            Spec::Ceasefire => {\\n                self.guns.push(Gun::new(WeaponId::Sniper));\\n                self.slot = self.guns.len() - 1;\\n                self.spawn_soldier(self.x, self.z - 30.0, 30.0, false);\\n            }\\n            Spec::Convoy => {\\n                self.clear_bodies();\\n                self.spawn_truck(self.x, self.z - 16.0);\\n                self.guns.push(Gun::new(WeaponId::Rpg));\\n                self.slot = self.guns.len() - 1;\\n            }\\n            Spec::Town => {\\n                let (tx, tz) = geom::place(\\\"Kilometre 40\\\");\\n                self.x = tx;\\n                self.z = tz;\\n                let _ = self.fire.ignite_disk(tx, tz + 20.0, 10.0, self.tune.burn_time, self.minutes);\\n                self.mark(\\\"town_burned\\\");\\n            }\\n            Spec::Ending(1) => {\\n                self.clear_bodies();\\n                for i in 0..3 {\\n                    self.spawn_soldier(self.x + 40.0 + i as f32 * 4.0, self.z - 50.0, 30.0, false);\\n                }\\n                self.syrettes = self.syrettes.max(4);\\n                self.hold_t = 0.0;\\n            }\\n            Spec::Flag(s) => self.mark(s),\\n            _ => {}\\n        }\\n    }\\n\\n    fn done(&mut self, spec: Spec) -> bool {\\n        match spec {\\n            Spec::Boot => self.screen == Screen::Playing,\\n            Spec::Map => self.flags.contains(\\\"map_raised\\\"),\\n            Spec::Way => self.flags.contains(\\\"waypoint_set\\\"),\\n            Spec::Reach { x, z, gps } => {\\n                if gps && self.waypoint.is_some() && geom::dist(self.x, self.z, self.step_x, self.step_z) > 25.0 {\\n                    self.mark(\\\"gps_followed\\\");\\n                }\\n                geom::dist(self.x, self.z, x, z) < 10.0 && (!gps || self.flags.contains(\\\"gps_followed\\\"))\\n            }\\n            Spec::Fever => self.flags.contains(\\\"fever_warned\\\"),\\n            Spec::Pill => self.flags.contains(\\\"pill_taken\\\"),\\n            Spec::Blackout => self.flags.contains(\\\"blackout\\\"),\\n            Spec::Fight => {\\n                let clear = self.bodies.iter().filter(|b| b.kind == 1).all(|b| !b.alive);\\n                if clear && !self.bodies.is_empty() {\\n                    self.post_clear = true;\\n                    self.post_reman_at = self.minutes + self.tune.post_reman_hours * 60.0;\\n                    self.mark(\\\"post_cleared\\\");\\n                }\\n                clear && self.flags.contains(\\\"post_cleared\\\")\\n            }\\n            Spec::EnemyJam => self.flags.contains(\\\"enemy_jam\\\"),\\n            Spec::Jam => self.flags.contains(\\\"jam_cleared\\\"),\\n            Spec::Break => {\\n                if self.gun().broken {\\n                    self.mark(\\\"weapon_broke\\\");\\n                    self.slot = 0;\\n                }\\n                self.flags.contains(\\\"weapon_broke\\\")\\n            }\\n            Spec::Rescue => self.flags.contains(\\\"player_rescued\\\"),\\n            Spec::Wound(n) => self.flags.contains(wound_flag(n)),\\n            Spec::Loot => self.guns.iter().any(|g| g.id == WeaponId::Ar),\\n            Spec::Claim => self.flags.contains(\\\"safe_house_claimed\\\"),\\n            Spec::Shop => self.flags.contains(\\\"weapon_bought\\\"),\\n            Spec::Locker => self.flags.contains(\\\"locker_used\\\"),\\n            Spec::Syrette => self.flags.contains(\\\"syrette\\\"),\\n            Spec::Tracker => self.flags.contains(\\\"cache_tracker\\\"),\\n            Spec::Sleep { .. } => self.flags.contains(\\\"sleep_used\\\") && self.step_t > 0.2,\\n            Spec::Drive { x, z } => geom::dist(self.x, self.z, x, z) < 12.0 && self.flags.contains(\\\"technical_driven\\\"),\\n            Spec::Mono => self.flags.contains(\\\"monocular_tag\\\"),\\n            Spec::Ignite(n) => self.flags.contains(ignite_flag(n)),\\n            Spec::Tanks => self.flags.contains(\\\"cells_500\\\") && self.flags.contains(\\\"explosion_chain\\\"),\\n            Spec::Mounted => self.flags.contains(\\\"mounted_gun\\\"),\\n            Spec::Panic => self.flags.contains(\\\"enemy_panicked\\\"),\\n            Spec::Animals => self.flags.contains(\\\"animals_fled\\\"),\\n            Spec::Bus { x, z } => self.flags.contains(\\\"bus_taken\\\") && geom::dist(self.x, self.z, x, z) < 12.0,\\n            Spec::Night => self.flags.contains(\\\"night_contract\\\"),\\n            Spec::Boat => self.flags.contains(\\\"boat_driven\\\"),\\n            Spec::Stealth => self.flags.contains(\\\"stealth_kill\\\"),\\n            Spec::Dart => self.flags.contains(\\\"dart_kill\\\"),\\n            Spec::Repair => self.flags.contains(\\\"repair_done\\\"),\\n            Spec::Rain => self.flags.contains(\\\"rain_extinguished\\\"),\\n            Spec::Better => self.flags.contains(\\\"better_way\\\") || self.companions.iter().any(|c| c.down),\\n            Spec::Patch => self.flags.contains(\\\"companion_patched\\\"),\\n            Spec::Overdose => self.flags.contains(\\\"companion_overdosed\\\"),\\n            Spec::Die => self.flags.contains(\\\"companion_died\\\"),\\n            Spec::Tape => self.flags.contains(\\\"tape_played\\\"),\\n            Spec::Ceasefire => self.flags.contains(\\\"ceasefire_ended\\\"),\\n            Spec::Convoy => self.bodies.iter().filter(|b| b.kind == 6).all(|b| !b.alive) && !self.bodies.is_empty(),\\n            Spec::Town => self.flags.contains(\\\"town_burned\\\"),\\n            Spec::Ending(n) => self.flags.contains(ending_flag(n)),\\n            Spec::Flag(s) => self.flags.contains(s),\\n        }\\n    }\\n\\n    fn bot_spec(&self, spec: Spec) -> InputFrame {\\n        let mut f = InputFrame::default();\\n        match spec {\\n            Spec::Map => {\\n                f.held = buttons::MAP;\\n                f.pressed = buttons::MAP;\\n            }\\n            Spec::Way | Spec::Claim | Spec::Shop | Spec::Locker | Spec::Loot | Spec::Tape | Spec::Ending(2) => {\\n                f.act = 1;\\n                f.pressed = buttons::INTERACT;\\n                f.held = buttons::INTERACT;\\n            }\\n            Spec::Reach { x, z, .. } => return self.bot_go(x, z, true),\\n            Spec::Tracker => {\\n                let (tx, tz) = self.tracker_cache;\\n                return self.bot_go(tx, tz, true);\\n            }\\n            Spec::Pill => {\\n                f.held = buttons::PILLS;\\n                f.pressed = buttons::PILLS;\\n            }\\n            Spec::Fight | Spec::Ceasefire | Spec::Convoy | Spec::Ignite(10) => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive && b.kind != 3) {\\n                    return self.bot_aim(b.x, b.z, 1.7, true);\\n                }\\n                f.held = buttons::PRIMARY;\\n            }\\n            Spec::EnemyJam | Spec::Blackout | Spec::Fever | Spec::Die | Spec::Ending(1) => {\\n                if matches!(spec, Spec::Ending(1)) {\\n                    f.held = buttons::CROUCH;\\n                }\\n            }\\n            Spec::Jam | Spec::Break => {\\n                if self.gun().jammed {\\n                    f.pressed = buttons::RELOAD;\\n                    f.held = buttons::RELOAD;\\n                } else {\\n                    f.held = buttons::PRIMARY | buttons::SECONDARY;\\n                    f.pressed = buttons::PRIMARY;\\n                }\\n            }\\n            Spec::Rescue => {}\\n            Spec::Wound(_) => {\\n                f.held = buttons::HEAL;\\n                f.pressed = buttons::HEAL;\\n            }\\n            Spec::Syrette => {\\n                f.pressed = buttons::HEAL;\\n                f.held = buttons::HEAL;\\n            }\\n            Spec::Sleep { .. } => {\\n                let (hx, hz) = geom::nearest_safe(self.x, self.z);\\n                if geom::dist(self.x, self.z, hx, hz) > 8.0 && self.ride.seat == 0 {\\n                    return self.bot_go(hx, hz, true);\\n                }\\n                if self.ride.seat != 0 {\\n                    f.pressed = buttons::USE;\\n                } else {\\n                    f.held = buttons::INTERACT;\\n                    f.pressed = buttons::INTERACT;\\n                }\\n            }\\n            Spec::Drive { x, z } => {\\n                let (tx, tz) = (x, z);\\n                if self.ride.seat == 0 {\\n                    f.pressed = buttons::USE;\\n                    return f;\\n                }\\n                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Bus { .. } => {\\n                let (tx, tz) = geom::place(\\\"Junction\\\");\\n                if self.ride.seat == 0 {\\n                    f.pressed = buttons::USE;\\n                    return f;\\n                }\\n                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Mono => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive) {\\n                    let mut aim = self.bot_aim(b.x, b.z, 1.6, false);\\n                    aim.held |= buttons::MONOCULAR;\\n                    aim.pressed |= buttons::MONOCULAR;\\n                    return aim;\\n                }\\n            }\\n            Spec::Ignite(k) => {\\n                if k == 10 {\\n                    f.held = buttons::PRIMARY;\\n                } else if k == 11 {\\n                    f.held = buttons::INTERACT;\\n                    f.pressed = buttons::INTERACT;\\n                } else {\\n                    f.pressed = buttons::PRIMARY;\\n                    f.held = buttons::PRIMARY;\\n                }\\n            }\\n            Spec::Tanks | Spec::Mounted => {\\n                f.held = buttons::PRIMARY;\\n                f.pressed = buttons::PRIMARY;\\n                if matches!(spec, Spec::Mounted) {\\n                    f.pressed |= buttons::USE;\\n                }\\n            }\\n            Spec::Panic | Spec::Animals => {\\n                f.pressed = buttons::PRIMARY;\\n                f.held = buttons::PRIMARY;\\n            }\\n            Spec::Boat => {\\n                let (tx, tz) = geom::water_ahead(self.ride.x, self.ride.z, 50.0);\\n                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Stealth => {\\n                f.held = buttons::CROUCH | buttons::MELEE;\\n                f.pressed = buttons::MELEE;\\n            }\\n\",\"total_lines\":2332}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"f3ec5100-bf85-49a9-8720-9c6d6ec06b5c"}
{"type":"assistant","message":{"id":"msg_151","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"I need to understand fuel(), resolve_shot(), and blow_tanks() before the test. I will run the test first.\n\nLaunching the playthrough now. Ignite(7) marks cells unconditionally even if already burning. Mortar disks at 18m spacing may overlap neighbors.\n\nOverlap checks confirm no two adjacent weapons' effects intersect. Now examining fire spread between steps.\n\nFire spread is unlikely to reach 18m in a single tick. The tick order between advance_script and script_ignite needs verification, since advance_script can skip multiple steps per tick.","signature":""},{"type":"tool_use","id":"call-efbafbda-c56e-48c2-8a84-14e4c5a43cf3-7","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/geom.rs","offset":180,"limit":120}},{"type":"tool_use","id":"call-efbafbda-c56e-48c2-8a84-14e4c5a43cf3-8","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs","offset":1460,"limit":200}},{"type":"tool_use","id":"call-efbafbda-c56e-48c2-8a84-14e4c5a43cf3-9","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs","offset":2050,"limit":180}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":5383,"output_tokens":1035,"cache_read_input_tokens":49024,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"a71104c9-304f-4d20-9d6a-fee17cda580d"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-efbafbda-c56e-48c2-8a84-14e4c5a43cf3-7","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"180→    }\\n    false\\n}\\n\\npub fn on_rock(x: f32, z: f32) -> bool {\\n    dist(x, z, 700.0, -600.0) < 36.0\\n}\\n\\npub fn in_town(x: f32, z: f32) -> bool {\\n    dist(x, z, 0.0, 380.0) < 80.0\\n190→}\\n\\npub fn tree_at(x: f32, z: f32) -> bool {\\n    if on_road(x, z) || on_water(x, z) || on_rock(x, z) || in_town(x, z) {\\n        return false;\\n    }\\n    let ix = (x / 14.0).floor() as i32;\\n    let iz = (z / 14.0).floor() as i32;\\n    hash_f32(7, ix, 3, iz) > 0.82\\n}\\n200→\\npub fn bush_at(x: f32, z: f32) -> bool {\\n    if on_road(x, z) || on_water(x, z) || on_rock(x, z) {\\n        return false;\\n    }\\n    let ix = (x / 8.0).floor() as i32;\\n    let iz = (z / 8.0).floor() as i32;\\n    hash_f32(11, ix, 1, iz) > 0.78\\n}\\n\\n210→pub fn tall_grass(x: f32, z: f32) -> bool {\\n    if on_road(x, z) || on_water(x, z) || in_town(x, z) {\\n        return false;\\n    }\\n    let ix = (x / 6.0).floor() as i32;\\n    let iz = (z / 6.0).floor() as i32;\\n    hash_f32(99, ix, 0, iz) > 0.35\\n}\\n\\n/// Fuel per 2 m cell. Roads, water and rock are breaks.\\n220→pub fn fuel(x: f32, z: f32) -> f32 {\\n    if on_road(x, z) || on_water(x, z) || on_rock(x, z) {\\n        0.0\\n    } else if tree_at(x, z) {\\n        3.0\\n    } else if bush_at(x, z) {\\n        1.5\\n    } else {\\n        1.0\\n    }\\n230→}\\n\\npub fn height(x: f32, z: f32) -> f32 {\\n    if x > 180.0 && x < 760.0 && z < -380.0 && z > -820.0 {\\n        ((x - 180.0) / 520.0).clamp(0.0, 1.0) * 42.0\\n    } else if on_water(x, z) {\\n        -1.2\\n    } else {\\n        0.0\\n    }\\n240→}\\n\\npub fn cell_of(x: f32, z: f32) -> (i32, i32) {\\n    (x.div_euclid(2.0) as i32, z.div_euclid(2.0) as i32)\\n}\\n\\npub fn cell_center(c: (i32, i32)) -> (f32, f32) {\\n    (c.0 as f32 * 2.0 + 1.0, c.1 as f32 * 2.0 + 1.0)\\n}\\n\\n250→pub fn safe_houses() -> [(f32, f32); 3] {\\n    [place(\\\"Pump House\\\"), place(\\\"Ranger's Lodge\\\"), place(\\\"Boat Shed\\\")]\\n}\\n\\npub fn nearest_safe(x: f32, z: f32) -> (f32, f32) {\\n    safe_houses().into_iter().min_by(|a, b| dist(x, z, a.0, a.1).total_cmp(&dist(x, z, b.0, b.1))).unwrap_or((170.0, 470.0))\\n}\\n\\n/// Detection multiplier from posture, grass, light and motion. Distance falloff is separate.\\n/// Crouched in tall grass at night, still: 0.6 * 0.35 * 0.45 * 0.5.\\n260→/// Standing on a road at noon, still: 1 * 1 * 1 * 0.5.\\npub fn exposure(posture: f32, grass: f32, light: f32, motion: f32) -> f32 {\\n    posture * grass * light * motion\\n}\\n\\npub fn grass_factor(x: f32, z: f32, crouched: bool) -> f32 {\\n    if !tall_grass(x, z) {\\n        1.0\\n    } else if crouched {\\n        0.35\\n270→    } else {\\n        0.6\\n    }\\n}\\n\\npub fn wrap_angle(a: f32) -> f32 {\\n    let pi = std::f32::consts::PI;\\n    (a + pi).rem_euclid(pi * 2.0) - pi\\n}\\n\\n280→pub fn yaw_toward(x: f32, z: f32, tx: f32, tz: f32) -> f32 {\\n    let dx = tx - x;\\n    let dz = tz - z;\\n    dx.atan2(-dz)\\n}\\n\",\"content_concise\":\"180→    }\\n    false\\n}\\n\\npub fn on_rock(x: f32, z: f32) -> bool {\\n    dist(x, z, 700.0, -600.0) < 36.0\\n}\\n\\npub fn in_town(x: f32, z: f32) -> bool {\\n    dist(x, z, 0.0, 380.0) < 80.0\\n190→}\\n\\npub fn tree_at(x: f32, z: f32) -> bool {\\n    if on_road(x, z) || on_water(x, z) || on_rock(x, z) || in_town(x, z) {\\n        return false;\\n    }\\n    let ix = (x / 14.0).floor() as i32;\\n    let iz = (z / 14.0).floor() as i32;\\n    hash_f32(7, ix, 3, iz) > 0.82\\n}\\n200→\\npub fn bush_at(x: f32, z: f32) -> bool {\\n    if on_road(x, z) || on_water(x, z) || on_rock(x, z) {\\n        return false;\\n    }\\n    let ix = (x / 8.0).floor() as i32;\\n    let iz = (z / 8.0).floor() as i32;\\n    hash_f32(11, ix, 1, iz) > 0.78\\n}\\n\\n210→pub fn tall_grass(x: f32, z: f32) -> bool {\\n    if on_