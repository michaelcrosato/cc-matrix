        yaw: 0.0,\\n                        distance: 15.5,\\n                        fov: 40.0,\\n                        ortho: false,\\n                        follow_lag: 0.06,\\n                        height_offset: 0.8,\\n                    };\\n                    let v = &mut self.view;\\n                    v.bloom = 0.55;\\n                    v.bloom_threshold = 1.0;\\n                    v.sky = \\\"#14161c\\\".into();\\n                    v.light.sun_elevation = 52.0;\\n                    v.light.sun_azimuth = 35.0;\\n                    v.light.sun_intensity = 0.95;\\n                    v.light.ambient = 0.5;\\n                    v.saturation = 1.08;\\n                    v.fog = false;\\n                } else if let Some((cam, view)) = self.game_saved.take() {\\n                    self.rig.params = cam;\\n                    self.view = view;\\n                }\\n            }\\n            self.game_frame = curr.game.clone();\\n            if !game_mode {\\n                self.game_ui.close_all();\\n                self.game_place = None;\\n            }\\n            if let Some(g) = &curr.game {\\n                if self.game_place != Some(g.place) {\\n                    self.game_place = Some(g.place);\\n                    self.arrival = Some(Instant::now());\\n                    self.game_ui.panel = None;\\n                    pav_view::arpg::place_look(g, &mut self.view);\\n                }\\n            }\\n        } else {\\n            self.game_frame = None;\\n        }\\n        let alpha = if self.app_settings.smoothing && !snap_camera {\\n            ((now - curr_at).as_secs_f32() / tick_wall.max(1e-4)).clamp(0.0, 1.0)\\n        } else {\\n            1.0\\n        };\\n        if snap_camera {\\n            // A submitted edit must contain its new framing as well as its new geometry.\\n            self.rig = CameraRig::new(self.rig.params.clone());\\n            self.rig.snap(curr.focus);\\n        }\\n        let focus = prev.focus.lerp(curr.focus, alpha);\\n        let player = curr.player.and_then(|id| curr.objects.iter().find(|o| o.id == id));\\n        let feet = player.and_then(|p| p.puppet.as_ref().map(|pp| p.pos - Vec3::Y * pp.feet_offset)).unwrap_or(focus);\\n        let facing = player.and_then(|p| p.puppet.as_ref().map(|pp| pp.state.facing)).unwrap_or(0.0);\\n\\n        // Game input -> the simulation thread.\\n        let (w, h) = self.gfx.as_ref().unwrap().size();\\n        let size = Vec2::new(w as f32, h as f32);\\n        let over_ui = self.egui_ctx.egui_wants_pointer_input();\\n        let left_tap = self.input.take_mouse_tap(MouseButton::Left) && !over_ui;\\n        if over_ui {\\n            self.input.mouse_taps.clear();\\n        }\\n        let (mut held, mut pressed) = self.input.buttons();\\n        // Touch: the stick, the buttons and auto-attack.\\n        let touch_game = curr.game.as_deref().filter(|_| game_input).map(|g| (g, feet, facing));\\n        let rig = &self.rig;\\n        let intent = self.touch.intent(touch_game, |v| rig.relative_move(v), self.prefs.auto_attack);\\n        if game_input {\\n            held |= intent.held;\\n            pressed |= intent.pressed;\\n        }\\n        if pressed & pav_core::input::buttons::INTERACT != 0 {\\n            if let Some(g) = &curr.game {\\n                if let Some(c) = self.game_ui.interact(g) {\\n                    host.shared.command(c);\\n                }\\n            }\\n        }\\n        if pressed != 0 && self.input.last_device == Device::Gamepad {\\n            // Gamepad presses are timed from when they were polled (gilrs queues them).\\n            self.latency.press();\\n        }\\n        let room_id = self.hud.current.as_ref().map(|r| r.id);\\n        let left = self.input.mouse.contains(&MouseButton::Left) && !over_ui;\\n        if left_tap && !self.editor.on && game_input {\\n            pressed |= pav_core::input::buttons::PRIMARY;\\n        }\\n        if !studio_active && self.editor.update(host, &self.rig, self.input.cursor, size, left, left_tap, room_id) {\\n            held &= !pav_core::input::buttons::PRIMARY;\\n            pressed &= !pav_core::input::buttons::PRIMARY;\\n        }\\n        let aim = match self.input.last_device {\\n            Device::KeyboardMouse => self.rig.ground_point(self.input.cursor, size, feet.y),\\n            Device::Gamepad => {\\n                let r = self.input.pad.right;\\n                if r.length() > 0.2 {\\n                    let d = self.rig.relative_move(r);\\n                    Some(feet + Vec3::new(d.x, 0.0, d.y) * self.sim_config.bombs.throw_range * r.length().min(1.0))\\n                } else {\\n                    Some(feet + Vec3::new(facing.sin(), 0.0, facing.cos()) * 4.0)\\n                }\\n            }\\n            Device::Touch => intent.aim.or(Some(feet + Vec3::new(facing.sin(), 0.0, facing.cos()) * 4.0)),\\n        };\\n        {\\n            let mut i = host.shared.input.lock().unwrap();\\n            if game_input {\\n                let axis = (self.input.move_axis() + intent.move_axis).clamp_length_max(1.0);\\n                i.move_dir = match intent.move_world {\\n                    // Auto-attack stepping in to a foe (only while the stick is still).\\n                    Some(m) if axis == Vec2::ZERO => m,\\n                    _ => self.rig.relative_move(axis),\\n                };\\n                i.held = held;\\n                i.pressed |= pressed;\\n                i.aim = aim;\\n                if let Some(t) = self.latency.pending.take() {\\n                    host.shared.input_stamp.lock().unwrap().get_or_insert(t);\\n                }\\n            } else {\\n                *i = InputFrame::default();\\n            }\\n        }\\n\\n        self.rig.update(focus, dt);\\n        self.builder.now = self.started.elapsed().as_secs_f64();\\n        let events: Vec<_> = std::mem::take(&mut *host.shared.events.lock().unwrap());\\n        let events = if studio_active { Vec::new() } else { events };\\n        self.builder.add_events(&events);\\n        // Save the hero on every arrival somewhere, and once a minute while playing.\\n        let travelled = events.iter().any(|e| matches!(e, pav_core::SimEvent::Travel { .. }));\\n        if curr.game.is_some() && (travelled || self.last_save.elapsed().as_secs() >= 60) {\\n            self.last_save = Instant::now();\\n            host.exec(|sim| crate::save::save_from(sim));\\n        }\\n        if let Some(a) = &self.audio {\\n            let (_, right) = self.rig.ground_axes();\\n            let l = pav_audio::Listener { pos: self.rig.target, right };\\n            for e in &events {\\n                if matches!(e, pav_core::SimEvent::Step { .. }) && !self.audio_settings.footsteps {\\n                    continue;\\n                }\\n                a.play_event(e, &l, self.audio_settings.sfx);\\n            }\\n        }\\n        // The look layer (Look & Filters) over the scene's own settings.\\n        let mut view = self.view.clone();\\n        self.look_ui.apply(&mut view);\\n        self.prefs.quality.trim(self.touch_screen, &mut view);\\n        let mut scene = self.builder.build(&prev, &curr, alpha, &self.rig, w as f32 / h.max(1) as f32, &view, focus);\\n        // Arriving somewhere new: the screen opens with the chosen transition, on the player.\\n        if let Some(t0) = self.arrival {\\n            let t = t0.elapsed().as_secs_f32() / view.filter.transition_time.max(0.05);\\n            match view.filter.transition.kind() {\\n                Some(kind) if t < 1.0 => {\\n                    scene.filter.transition = 1.0 - t * t * (3.0 - 2.0 * t);\\n                    scene.filter.transition_kind = kind;\\n                    scene.filter.transition_center = pav_view::build::screen_uv(&scene.camera, feet + Vec3::Y * 0.9);\\n                }\\n                _ => self.arrival = None,\\n            }\\n        }\\n        if !studio_active {\\n            self.editor.draw_preview(&mut scene);\\n        }\\n        if let Some(a) = intent.aiming.filter(|_| game_input) {\\n            // A skill aimed by hand: a ring where it lands and dots on the way there.\\n            let mark = |at: Vec3, s: f32, color: Vec3| MeshInstance {\\n\",\"total_lines\":2266}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"604e71c1-2385-4ad9-a0dc-93544634ce14"}
{"type":"assistant","message":{"id":"msg_226","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"I need to understand GameBox's get_mut method and how the simulation works.\n\nMerc access from merc_web works. SimHost knows the scene key. I will check GameBox, Sim.play, and how scene names are stored. I also need to review app.rs draw logic, escape handling, and the webgpu message in index.html. The plan is a pragmatic merc_web.rs architecture: call it from simhost tick_once before sim.step when play.key is \"merc\", pull gameBridge JSON into InputFrame and World, publish window.__game every 15 ticks, and read ?nodraw=1 or ?test=1 once.\n\nTick cap should rise to 120 when nodraw or test is active, or when the world screen is not Playing. The tick_once function cannot read nodraw flags until they are parsed, so merc_web can use static atomics to track them. Native tests bypass simhost entirely. For merc, JavaScript should supply look and act inputs because Playwright synthetic events may not reach winit reliably; page-level keydown capture is the more dependable path.\n\nPage keydown events will feed into gameTest.queue or gameInput. gameBridge.pull() returns an edge-triggered JSON frame accumulated since the last pull. merc_web overwrites the InputFrame before sim.step. Rust merges this data by adding look, replacing move_dir with axes if present, OR-ing buttons, replacing act when non-zero, and applying pointer, click, device, touch, and xbox to World.\n\nThe merc scene needs CameraRig.fp set in app.rs. The visual camera stays at the room eye and copies yaw and pitch from the world. On wasm, SimHost::pump advances the clock on the main thread, so the app reads the published snapshot rather than the live simulation.","signature":""},{"type":"tool_use","id":"call-934a3678-232d-4cac-8892-2ae1a7d505fd-19","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_app/src/simhost.rs","offset":1,"limit":240}},{"type":"tool_use","id":"call-934a3678-232d-4cac-8892-2ae1a7d505fd-20","name":"grep","input":{"pattern":"fn key\\(|struct GameBox|fn get_mut|play:","path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games","glob":"*.rs"}},{"type":"tool_use","id":"call-934a3678-232d-4cac-8892-2ae1a7d505fd-21","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_view/src/camera.rs","offset":100,"limit":180}},{"type":"tool_use","id":"call-934a3678-232d-4cac-8892-2ae1a7d505fd-22","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/web/index.html","limit":80}},{"type":"tool_use","id":"call-934a3678-232d-4cac-8892-2ae1a7d505fd-23","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/scripts/build-web.sh","limit":80}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":9471,"output_tokens":1219,"cache_read_input_tokens":61696,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"8cc0754c-17c6-41d5-83af-0dfee335e202"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-934a3678-232d-4cac-8892-2ae1a7d505fd-19","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→//! Runs the simulation at a fixed tick rate: on its own thread natively, and stepped from the\\n//! frame loop in the browser (no threads there). The renderer never waits for it: it reads the\\n//! two most recent frames and interpolates between them.\\n\\nuse std::sync::{Arc, Mutex};\\nuse std::time::Duration;\\n\\nuse pav_core::{InputFrame, RenderFrame, Sim, SimEvent};\\nuse web_time::Instant;\\n10→\\n#[cfg(not(target_arch = \\\"wasm32\\\"))]\\ntype Job = Box<dyn FnOnce(&mut Sim) + Send>;\\n\\n#[cfg(not(target_arch = \\\"wasm32\\\"))]\\nenum Cmd {\\n    Run(Job),\\n    Quit,\\n}\\n\\n20→#[derive(Clone, Copy, Debug)]\\npub struct TimeControl {\\n    pub paused: bool,\\n    /// Simulation speed multiplier (0.05 .. 8).\\n    pub speed: f32,\\n    /// Ticks to advance while paused.\\n    pub step_requests: u32,\\n    /// Holding the rewind button.\\n    pub rewinding: bool,\\n    /// Ticks travelled back per tick while rewinding.\\n30→    pub rewind_speed: u32,\\n    /// Jump to this tick (timeline scrubbing), keeping the future until play resumes.\\n    pub scrub: Option<u64>,\\n}\\n\\nimpl Default for TimeControl {\\n    fn default() -> Self {\\n        Self { paused: false, speed: 1.0, step_requests: 0, rewinding: false, rewind_speed: 1, scrub: None }\\n    }\\n}\\n40→\\n#[derive(Clone, Copy, Debug, Default)]\\npub struct SimStats {\\n    /// Measured ticks per second of wall time.\\n    pub tps: f32,\\n    /// Average CPU time per tick (ms).\\n    pub tick_ms: f32,\\n    pub tick: u64,\\n    pub entities: usize,\\n    /// Rewind range available (ticks).\\n50→    pub oldest: u64,\\n    pub newest: u64,\\n    pub history_mb: f32,\\n    pub rewound: bool,\\n}\\n\\npub struct FramePair {\\n    pub prev: Arc<RenderFrame>,\\n    pub curr: Arc<RenderFrame>,\\n    /// When `curr` became current (wall clock).\\n60→    pub curr_at: Instant,\\n    /// Wall-clock length of one tick at the current speed.\\n    pub tick_wall: f32,\\n}\\n\\npub struct Shared {\\n    pub frames: Mutex<FramePair>,\\n    pub input: Mutex<InputFrame>,\\n    pub control: Mutex<TimeControl>,\\n    pub stats: Mutex<SimStats>,\\n70→    pub crashed: Mutex<Option<String>>,\\n    /// Events for sound and effects, drained by the render thread.\\n    pub events: Mutex<Vec<SimEvent>>,\\n    /// When the input that is waiting for the next tick was pressed (latency measurement).\\n    pub input_stamp: Mutex<Option<Instant>>,\\n    /// (pressed, consumed by a tick, that tick's number) for the latest measured press.\\n    pub latency_probe: Mutex<Option<(Instant, Instant, u64)>>,\\n    /// Menu commands waiting for a tick (one rides along with each tick's input).\\n    pub cmds: Mutex<std::collections::VecDeque<pav_core::arpg::GameCmd>>,\\n}\\n80→\\nimpl Shared {\\n    /// Queues a game command for the next free tick.\\n    pub fn command(&self, c: pav_core::arpg::GameCmd) {\\n        let mut q = self.cmds.lock().unwrap();\\n        if q.len() < 64 {\\n            q.push_back(c);\\n        }\\n    }\\n}\\n90→\\n#[cfg(not(target_arch = \\\"wasm32\\\"))]\\npub struct SimHost {\\n    tx: std::sync::mpsc::Sender<Cmd>,\\n    pub shared: Arc<Shared>,\\n    thread: Option<std::thread::JoinHandle<()>>,\\n}\\n\\n/// In the browser the simulation lives on the main thread and `pump` advances it every frame.\\n#[cfg(target_arch = \\\"wasm32\\\")]\\n100→pub struct SimHost {\\n    sim: std::cell::RefCell<Sim>,\\n    clock: std::cell::RefCell<Clock>,\\n    pub shared: Arc<Shared>,\\n}\\n\\nfn shared_for(sim: &mut Sim) -> Arc<Shared> {\\n    let f = Arc::new(sim.frame());\\n    Arc::new(Shared {\\n        frames: Mutex::new(FramePair { prev: f.clone(), curr: f, curr_at: Instant::now(), tick_wall: sim.dt() }),\\n110→        input: Mutex::new(InputFrame::default()),\\n        control: Mutex::new(TimeControl::default()),\\n        stats: Mutex::new(SimStats::default()),\\n        crashed: Mutex::new(None),\\n        events: Mutex::new(Vec::new()),\\n        input_stamp: Mutex::new(None),\\n        latency_probe: Mutex::new(None),\\n        cmds: Mutex::new(Default::default()),\\n    })\\n}\\n120→\\n#[cfg(not(target_arch = \\\"wasm32\\\"))]\\nimpl SimHost {\\n    pub fn start(mut sim: Sim) -> Self {\\n        let shared = shared_for(&mut sim);\\n        let (tx, rx) = std::sync::mpsc::channel();\\n        let sh = shared.clone();\\n        let thread = std::thread::Builder::new()\\n            .name(\\\"simulation\\\".into())\\n            .spawn(move || {\\n130→                let sh2 = sh.clone();\\n                let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(move || run(sim, rx, sh2)));\\n                if let Err(e) = r {\\n                    let msg = e\\n                        .downcast_ref::<&str>()\\n                        .map(|s| s.to_string())\\n                        .or_else(|| e.downcast_ref::<String>().cloned())\\n                        .unwrap_or_else(|| \\\"unknown panic\\\".into());\\n                    *sh.crashed.lock().unwrap() = Some(msg);\\n                }\\n140→            })\\n            .expect(\\\"spawn simulation thread\\\");\\n        Self { tx, shared, thread: Some(thread) }\\n    }\\n\\n    /// Runs `f` on the simulation thread (fire and forget).\\n    pub fn exec(&self, f: impl FnOnce(&mut Sim) + Send + 'static) {\\n        let _ = self.tx.send(Cmd::Run(Box::new(f)));\\n    }\\n\\n150→    /// Runs `f` on the simulation thread and waits for its result.\\n    pub fn query<R: Send + 'static>(&self, f: impl FnOnce(&mut Sim) -> R + Send + 'static) -> Option<R> {\\n        let (rtx, rrx) = std::sync::mpsc::channel();\\n        self.exec(move |sim| {\\n            let _ = rtx.send(f(sim));\\n        });\\n        rrx.recv_timeout(Duration::from_secs(5)).ok()\\n    }\\n\\n    /// Advances the simulation (the thread does this by itself natively).\\n160→    pub fn pump(&self) {}\\n}\\n\\n#[cfg(target_arch = \\\"wasm32\\\")]\\nimpl SimHost {\\n    pub fn start(mut sim: Sim) -> Self {\\n        let shared = shared_for(&mut sim);\\n        Self { sim: std::cell::RefCell::new(sim), clock: std::cell::RefCell::new(Clock::new()), shared }\\n    }\\n\\n170→    pub fn exec(&self, f: impl FnOnce(&mut Sim) + 'static) {\\n        let mut sim = self.sim.borrow_mut();\\n        f(&mut sim);\\n        let dt = sim.dt();\\n        publish(&mut sim, &self.shared, dt, Instant::now());\\n    }\\n\\n    pub fn query<R: 'static>(&self, f: impl FnOnce(&mut Sim) -> R + 'static) -> Option<R> {\\n        let mut sim = self.sim.borrow_mut();\\n        let r = f(&mut sim);\\n180→        let dt = sim.dt();\\n        publish(&mut sim, &self.shared, dt, Instant::now());\\n        Some(r)\\n    }\\n\\n    /// Runs the ticks that are due (called once per frame).\\n    pub fn pump(&self) {\\n        self.clock.borrow_mut().advance(&mut self.sim.borrow_mut(), &self.shared);\\n    }\\n}\\n190→\\nimpl SimHost {\\n    pub fn frames(&self) -> (Arc<RenderFrame>, Arc<RenderFrame>, Instant, f32) {\\n        let f = self.shared.frames.lock().unwrap();\\n        (f.prev.clone(), f.curr.clone(), f.curr_at, f.tick_wall)\\n    }\\n\\n    pub fn control(&self) -> TimeControl {\\n        *self.shared.control.lock().unwrap()\\n    }\\n200→\\n    pub fn set_control(&self, f: impl FnOnce(&mut TimeControl)) {\\n        f(&mut self.shared.control.lock().unwrap());\\n    }\\n}\\n\\n#[cfg(not(target_arch = \\\"wasm32\\\"))]\\nimpl Drop for SimHost {\\n    fn drop(&mut self) {\\n        let _ = self.tx.send(Cmd::Quit);\\n210→        if let Some(t) = self.thread.take() {\\n            let _ = t.join();\\n        }\\n    }\\n}\\n\\nfn publish(sim: &mut Sim, sh: &Shared, tick_wall: f32, at: Instant) {\\n    let events = sim.drain_events();\\n    if !events.is_empty() {\\n        let mut q = sh.events.lock().unwrap();\\n220→        q.extend(events);\\n        let n = q.len();\\n        if n > 512 {\\n            q.drain(..n - 512);\\n        }\\n    }\\n    let frame = Arc::new(sim.frame());\\n    let mut f = sh.frames.lock().unwrap();\\n    f.prev = std::mem::replace(&mut f.curr, frame);\\n    f.curr_at = at;\\n230→    f.tick_wall = tick_wall;\\n}\\n\\n/// Fixed-rate ticking with time controls (pause, single steps, speed, rewind, scrubbing).\\nstruct Clock {\\n    next: Instant,\\n    window_start: Instant,\\n    window_ticks: u32,\\n    busy: Duration,\\n    rewound: bool,\\n240→    studio_mode: pav_core::prop_preview::StudioMode,\",\"content_concise\":\"1→//! Runs the simulation at a fixed tick rate: on its own thread natively, and stepped from the\\n//! frame loop in the browser (no threads there). The renderer never waits for it: it reads the\\n//! two most recent frames and interpolates between them.\\n\\nuse std::sync::{Arc, Mutex};\\nuse std::time::Duration;\\n\\nuse pav_core::{InputFrame, RenderFrame, Sim, SimEvent};\\nuse web_time::Instant;\\n10→\\n#[cfg(not(target_arch = \\\"wasm32\\\"))]\\ntype Job = Box<dyn FnOnce(&mut Sim) + Send>;\\n\\n#[cfg(not(target_arch = \\\"wasm32\\\"))]\\nenum Cmd {\\n    Run(Job),\\n    Quit,\\n}\\n\\n20→#[derive(Clone, Copy, Debug)]\\npub struct TimeControl {\\n    pub paused: bool,\\n    /// Simulation speed multiplier (0.05 .. 8).\\n    pub speed: f32,\\n    /// Ticks to advance while paused.\\n    pub step_requests: u32,\\n    /// Holding the rewind button.\\n    pub rewinding: bool,\\n    /// Ticks travelled back per tick while rewinding.\\n30→    pub rewind_speed: u32,\\n    /// Jump to this tick (timeline scrubbing), keeping the future until play resumes.\\n    pub scrub: Option<u64>,\\n}\\n\\nimpl Default for TimeControl {\\n    fn default() -> Self {\\n        Self { paused: false, speed: 1.0, step_requests: 0, rewinding: false, rewind_speed: 1, scrub: None }\\n    }\\n}\\n40→\\n#[derive(Clone, Copy, Debug, Default)]\\npub struct SimStats {\\n    /// Measured ticks per second of wall time.\\n    pub tps: f32,\\n    /// Average CPU time per tick (ms).\\n    pub tick_ms: f32,\\n    pub tick: u64,\\n    pub entities: usize,\\n    /// Rewind range available (ticks).\\n50→    pub oldest: u64,\\n    pub newest: u64,\\n    pub history_mb: f32,\\n    pub rewound: bool,\\n}\\n\\npub struct FramePair {\\n    pub prev: Arc<RenderFrame>,\\n    pub curr: Arc<RenderFrame>,\\n    /// When `curr` became current (wall clock).\\n60→    pub curr_at: Instant,\\n    /// Wall-clock length of one tick at the current speed.\\n    pub tick_wall: f32,\\n}\\n\\npub struct Shared {\\n    pub frames: Mutex<FramePair>,\\n    pub input: Mutex<InputFrame>,\\n    pub control: Mutex<TimeControl>,\\n    pub stats: Mutex<SimStats>,\\n70→    pub crashed: Mutex<Option<String>>,\\n    /// Events for sound and effects, drained by the render thread.\\n    pub events: Mutex<Vec<SimEvent>>,\\n    /// When the input that is waiting for the next tick was pressed (latency measurement).\\n    pub input_stamp: Mutex<Option<Instant>>,\\n    /// (pressed, consumed by a tick, that tick's number) for the latest measured press.\\n    pub latency_probe: Mutex<Option<(Instant, Instant, u64)>>,\\n    /// Menu commands waiting for a tick (one rides along with each tick's input).\\n    pub cmds: Mutex<std::collections::VecDeque<pav_core::arpg::GameCmd>>,\\n}\\n80→\\nimpl Shared {\\n    /// Queues a game command for the next free tick.\\n    pub fn command(&self, c: pav_core::arpg::GameCmd) {\\n        let mut q = self.cmds.lock().unwrap();\\n        if q.len() < 64 {\\n            q.push_back(c);\\n        }\\n    }\\n}\\n90→\\n#[cfg(not(target_arch = \\\"wasm32\\\"))]\\npub struct SimHost {\\n    tx: std::sync::mpsc::Sender<Cmd>,\\n    pub shared: Arc<Shared>,\\n    thread: Option<std::thread::JoinHandle<()>>,\\n}\\n\\n/// In the browser the simulation lives on the main thread and `pump` advances it every frame.\\n#[cfg(target_arch = \\\"wasm32\\\")]\\n100→pub struct SimHost {\\n    sim: std::cell::RefCell<Sim>,\\n    clock: std::cell::RefCell<Clock>,\\n    pub shared: Arc<Shared>,\\n}\\n\\nfn shared_for(sim: &mut Sim) -> Arc<Shared> {\\n    let f = Arc::new(sim.frame());\\n    Arc::new(Shared {\\n        frames: Mutex::new(FramePair { prev: f.clone(), curr: f, curr_at: Instant::now(), tick_wall: sim.dt() }),\\n110→        input: Mutex::new(InputFrame::default()),\\n        control: Mutex::new(TimeControl::default()),\\n        stats: Mutex::new(SimStats::default()),\\n        crashed: Mutex::new(None),\\n        events: Mutex::new(Vec::new()),\\n        input_stamp: Mutex::new(None),\\n        latency_probe: Mutex::new(None),\\n        cmds: Mutex::new(Default::default()),\\n    })\\n}\\n120→\\n#[cfg(not(target_arch = \\\"wasm32\\\"))]\\nimpl SimHost {\\n    pub fn start(mut sim: Sim) -> Self {\\n        let shared = shared_for(&mut sim);\\n        let (tx, rx) = std::sync::mpsc::channel();\\n        let sh = shared.clone();\\n        let thread = std::thread::Builder::new()\\n            .name(\\\"simulation\\\".into())\\n            .spawn(move || {\\n130→                let sh2 = sh.clone();\\n                let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(move || run(sim, rx, sh2)));\\n                if let Err(e) = r {\\n                    let msg = e\\n                        .downcast_ref::<&str>()\\n                        .map(|s| s.to_string())\\n                        .or_else(|| e.downcast_ref::<String>().cloned())\\n                        .unwrap_or_else(|| \\\"unknown panic\\\".into());\\n                    *sh.crashed.lock().unwrap() = Some(msg);\\n                }\\n140→            })\\n            .expect(\\\"spawn simulation thread\\\");\\n        Self { tx, shared, thread: Some(thread) }\\n    }\\n\\n    /// Runs `f` on the simulation thread (fire and forget).\\n    pub fn exec(&self, f: impl FnOnce(&mut Sim) + Send + 'static) {\\n        let _ = self.tx.send(Cmd::Run(Box::new(f)));\\n    }\\n\\n150→    /// Runs `f` on the simulation thread and waits for its result.\\n    pub fn query<R: Send + 'static>(&self, f: impl FnOnce(&mut Sim) -> R + Send + 'static) -> Option<R> {\\n        let (rtx, rrx) = std::sync::mpsc::channel();\\n        self.exec(move |sim| {\\n            let _ = rtx.send(f(sim));\\n        });\\n        rrx.recv_timeout(Duration::from_secs(5)).ok()\\n    }\\n\\n    /// Advances the simulation (the thread does this by itself natively).\\n160→    pub fn pump(&self) {}\\n}\\n\\n#[cfg(target_arch = \\\"wasm32\\\")]\\nimpl SimHost {\\n    pub fn start(mut sim: Sim) -> Self {\\n        let shared = shared_for(&mut sim);\\n        Self { sim: std::cell::RefCell::new(sim), clock: std::cell::RefCell::new(Clock::new()), shared }\\n    }\\n\\n170→    pub fn exec(&self, f: impl FnOnce(&mut Sim) + 'static) {\\n        let mut sim = self.sim.borrow_mut();\\n        f(&mut sim);\\n        let dt = sim.dt();\\n        publish(&mut sim, &self.shared, dt, Instant::now());\\n    }\\n\\n    pub fn query<R: 'static>(&self, f: impl FnOnce(&mut Sim) -> R + 'static) -> Option<R> {\\n        let mut sim = self.sim.borrow_mut();\\n        let r = f(&mut sim);\\n180→        let dt = sim.dt();\\n        publish(&mut sim, &self.shared, dt, Instant::now());\\n        Some(r)\\n    }\\n\\n    /// Runs the ticks that are due (called once per frame).\\n    pub fn pump(&self) {\\n        self.clock.borrow_mut().advance(&mut self.sim.borrow_mut(), &self.shared);\\n    }\\n}\\n190→\\nimpl SimHost {\\n    pub fn frames(&self) -> (Arc<RenderFrame>, Arc<RenderFrame>, Instant, f32) {\\n        let f = self.shared.frames.lock().unwrap();\\n        (f.prev.clone(), f.curr.clone(), f.curr_at, f.tick_wall)\\n    }\\n\\n    pub fn control(&self) -> TimeControl {\\n        *self.shared.control.lock().unwrap()\\n    }\\n200→\\n    pub fn set_control(&self, f: impl FnOnce(&mut TimeControl)) {\\n        f(&mut self.shared.control.lock().unwrap());\\n    }\\n}\\n\\n#[cfg