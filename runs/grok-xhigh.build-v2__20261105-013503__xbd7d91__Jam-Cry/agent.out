number\":962,\"content\":\"            Spec::Bus { x, z } => self.flags.contains(\\\"bus_taken\\\") && geom::dist(self.x, self.z, x, z) < 12.0,\"},{\"line_number\":963,\"content\":\"            Spec::Night => self.flags.contains(\\\"night_contract\\\"),\"},{\"line_number\":964,\"content\":\"            Spec::Boat => self.flags.contains(\\\"boat_driven\\\"),\"},{\"line_number\":965,\"content\":\"            Spec::Stealth => self.flags.contains(\\\"stealth_kill\\\"),\"},{\"line_number\":966,\"content\":\"            Spec::Dart => self.flags.contains(\\\"dart_kill\\\"),\"},{\"line_number\":967,\"content\":\"            Spec::Repair => self.flags.contains(\\\"repair_done\\\"),\"},{\"line_number\":968,\"content\":\"            Spec::Rain => self.flags.contains(\\\"rain_extinguished\\\"),\"},{\"line_number\":969,\"content\":\"            Spec::Better => self.flags.contains(\\\"better_way\\\") || self.companions.iter().any(|c| c.down),\"},{\"line_number\":970,\"content\":\"            Spec::Patch => self.flags.contains(\\\"companion_patched\\\"),\"},{\"line_number\":971,\"content\":\"            Spec::Overdose => self.flags.contains(\\\"companion_overdosed\\\"),\"},{\"line_number\":972,\"content\":\"            Spec::Die => self.flags.contains(\\\"companion_died\\\"),\"},{\"line_number\":973,\"content\":\"            Spec::Tape => self.flags.contains(\\\"tape_played\\\"),\"},{\"line_number\":974,\"content\":\"            Spec::Ceasefire => self.flags.contains(\\\"ceasefire_ended\\\"),\"},{\"line_number\":975,\"content\":\"            Spec::Convoy => self.bodies.iter().filter(|b| b.kind == 6).all(|b| !b.alive) && !self.bodies.is_empty(),\"},{\"line_number\":976,\"content\":\"            Spec::Town => self.flags.contains(\\\"town_burned\\\"),\"},{\"line_number\":977,\"content\":\"            Spec::Ending(n) => self.flags.contains(ending_flag(n)),\"},{\"line_number\":978,\"content\":\"            Spec::Flag(s) => self.flags.contains(s),\"},{\"line_number\":982,\"content\":\" 