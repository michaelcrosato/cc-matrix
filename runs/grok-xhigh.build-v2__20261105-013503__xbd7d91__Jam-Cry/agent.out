=> 0,\\n                    };\\n                    self.page = 0;\\n                    self.focus = 0;\\n                    return;\\n                }\\n300→                if label == \\\"Reset to defaults\\\" {\\n                    self.tune = self.tune0.clone();\\n                    return;\\n                }\\n                if label == \\\"Next page\\\" {\\n                    self.page += 1;\\n                    self.focus = 0;\\n                    return;\\n                }\\n                if self.tab == 1 {\\n310→                    self.toggle_cheat(label);\\n                } else if self.tab == 2 {\\n                    self.dev_teleport(label);\\n                } else if self.tab == 3 {\\n                    self.dev_spawn(label);\\n                } else if self.tab == 4 {\\n                    self.dev_world(label);\\n                }\\n            }\\n            Screen::Ledger => {\\n320→                let n = match label {\\n                    \\\"Read the names\\\" => 1,\\n                    \\\"Take the chair\\\" => 2,\\n                    _ => 0,\\n                };\\n                self.choose_finale(n);\\n            }\\n            Screen::About => {\\n                if label == \\\"Next\\\" {\\n                    self.page += 1;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/shell.rs\",\"offset\":280,\"limit\":50,\"raw_output\":\"                    self.xbox = false;\\n                } else if label.starts_with(\\\"Page\\\") {\\n                    self.tab = (self.tab + 1) % 4;\\n                    self.focus = 0;\\n                }\\n            }\\n            Screen::Dev => {\\n                if self.tab == 0 {\\n                    self.tab = match label {\\n                        \\\"Cheats\\\" => 1,\\n                        \\\"Teleport\\\" => 2,\\n               