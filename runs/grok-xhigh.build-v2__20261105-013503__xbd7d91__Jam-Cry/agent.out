us - 1 };\"},{\"line_number\":156,\"content\":\"            self.focus = (self.focus + 1) % n;\"},{\"line_number\":158,\"content\":\"        self.focus = self.focus.min(n - 1);\"},{\"line_number\":168,\"content\":\"            let label = rows.get(self.focus).cloned().unwrap_or_default();\"},{\"line_number\":174,\"content\":\"        self.focus = 0;\"},{\"line_number\":188,\"content\":\"            if self.screen == Screen::Settings && self.tab == 0 && self.focus == 1 {\"},{\"line_number\":195,\"content\":\"        let index = self.page * page_size + self.focus;\"},{\"line_number\":196,\"content\":\"        if self.focus == 6 || index >= count {\"},{\"line_number\":199,\"content\":\"                self.focus = 0;\"},{\"line_number\":226,\"content\":\"                    self.focus = 1;\"},{\"line_number\":230,\"content\":\"                    self.focus = 0;\"},{\"line_number\":235,\"content\":\"                    self.focus = 0;\"},{\"line_number\":240,\"content\":\"                    self.focus = 0;\"},{\"line_number\":251,\"content\":\"                self.focus = 0;\"},{\"line_number\":261,\"content\":\"                self.focus = 0;\"},{\"line_number\":272,\"content\":\"                    self.focus = 0;\"},{\"line_number\":277,\"content\":\"                    self.focus = 0;\"},{\"line_number\":283,\"content\":\"                    self.focus = 0;\"},{\"line_number\":287,\"content\":\"                    self.focus = 0;\"},{\"line_number\":298,\"content\":\"                    self.focus = 0;\"},{\"line_number\":312,\"content\":\"                    self.focus = 0;\"},{\"line_number\":321,\"content\":\"                    self.focus = 0;\"},{\"line_number\":335,\"content\":\"                    self.focus = 0;\"},{\"line_number\":364,\"content\":\"    pub fn rows(&self) -> Vec<String> {\"},{\"line_number\":382,\"content\":\"            Screen::Attract => vec![\\\"Press any button\\\".into()],\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session