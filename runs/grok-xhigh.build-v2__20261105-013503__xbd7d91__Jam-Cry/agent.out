ttons::SECONDARY;\\n            }\\n            Spec::Panic => {}\\n            Spec::Boat => return self.bot_boat(),\\n            Spec::Night => {\\n                f.move_dir.y = 1.0;\\n                if self.stamina > 1.0 {\\n1200→                    f.held |= buttons::FOCUS;\\n                }\\n            }\\n            Spec::Town => return self.bot_town(),\\n            Spec::Ending(_) => return self.bot_ending(),\\n            Spec::Stealth => {\\n                f.held = buttons::CROUCH | buttons::MELEE;\\n                f.pressed = buttons::MELEE;\\n            }\\n            Spec::Dart => {\\n1210→                if let Some(b) = self.bodies.iter().find(|b| b.alive) {\\n                    return self.bot_aim(b.x, b.z, 1.2, true);\\n                }\\n            }\\n            Spec::Repair | Spec::Patch | Spec::Overdose => {\\n                f.held = buttons::INTERACT;\\n                f.pressed = buttons::INTERACT;\\n            }\\n            Spec::Rain | Spec::Better | Spec::Flag(_) => {\\n                f.pressed = buttons::INTERACT;\\n1220→            }\\n            _ => {}\\n        }\\n        let _ = shell::glyph(\\\"confirm\\\", self.device, self.xbox);\\n        f\\n    }\\n\\n    fn bot_go(&self, tx: f32, tz: f32, sprint: bool) -> InputFrame {\\n        let desired = geom::yaw_toward(self.x, self.z, tx, tz);\\n        let err = geom::wrap_angle(desired - self.yaw);\\n1230→        let mut f = InputFrame::default();\\n        f.look.x = err.clamp(-1.4, 1.4);\\n        if err.abs() < 0.4 {\\n            f.move_dir.y = 1.0;\\n            if sprint && self.stamina > 1.0 {\\n                f.held |= buttons::FOCUS;\\n            }\\n        }\\n        f\\n    }\\n1240→\\n    fn bot_drive(&self, tx: f32, tz: f32) -> InputFrame {\\n        let desired = geom::yaw_toward(self.ride.x, self.ride.z, tx, tz);\\n        let err = geom::wrap_angle(desired - self.ride.yaw);\\n        let mut f = InputFrame::default();\\n        f.axes.x = err.clamp(-1.0, 1.0);\\n        // The outboard stops dead once it leaves the deep channel, so turn before opening up.\\n        if self.ride.kind == 2 && err.abs() > 0.4 {\\n            f.axes.y = 0.05;\\n        } else {\\n1250→            f.axes.y = 1.0;\\n        }\\n        f\\n    }\\n\\n    fn bot_aim(&self, tx: f32, tz: f32, ty: f32, fire: bool) -> InputFrame {\\n        let dx = tx - self.x;\\n        let dz = tz - self.z;\\n        let dist = (dx * dx + dz * dz).sqrt().max(0.2);\\n        let desired = dx.atan2(-dz);\\n1260→        let err = geom::wrap_angle(desired - self.yaw);\\n        let perr = ((ty - self.eye) / dist).atan() - self.pitch;\\n        let mut f = InputFrame::default();\\n        f.look.x = err.clamp(-1.5, 1.5);\\n        f.look.y = perr.clamp(-1.2, 1.2);\\n        if fire && err.abs() < 0.2 && perr.abs() < 0.2 {\\n            f.held |= buttons::PRIMARY | buttons::SECONDARY;\\n            f.pressed |= buttons::PRIMARY;\\n        }\\n        f\\n1270→    }\\n\\n    fn bot_ledger(&self) -> InputFrame {\\n        let want = match self.route {\\n            Route::Read => 1usize,\\n            Route::Chair => 2,\\n            _ => 0,\\n        };\\n        let mut f = InputFrame::default();\\n        if self.focus != want {\\n1280→            f.act = if self.focus < want { 4 } else { 3 };\\n        } else {\\n            f.act = 1;\\n            f.pressed = buttons::CONFIRM;\\n        }\\n        f\\n    }\\n\\n    fn bot_boat(&self) -> InputFrame {\\n        if self.ride.seat == 0 {\\n1290→            let d = geom::dist(self.x, self.z, self.ride.x, self.ride.z);\\n            if d > 5.0 {\\n                return self.bot_go(self.ride.x, self.ride.z, true);\\n            }\\n            let mut f = InputFrame::default();\\n            f.pressed = buttons::USE;\\n            return f;\\n        }\\n        let (tx, tz) = geom::water_ahead(self.ride.x, self.ride.z, 40.0);\\n        self.bot_drive(tx, tz)\\n1300→    }\\n\\n    fn bot_town(&self) -> InputFrame {\\n        if self.ride.seat != 0 {\\n            let mut f = InputFrame::default();\\n            f.pressed = buttons::USE;\\n            return f;\\n        }\\n        let (tx, tz) = (18.0, 424.0);\\n        if geom::dist(self.x, self.z, tx, tz) > 2.5 {\\n1310→            return self.bot_go(tx, tz, true);\\n        }\\n        self.bot_ground_shot()\\n    }\\n\\n    fn bot_ending(&self) -> InputFrame {\\n        match self.finale {\\n            Some(1) => {\\n                let mut f = InputFrame::default();\\n                f.held = buttons::CROUCH;\\n1320→                f\\n            }\\n            Some(2) => {\\n                let mut f = InputFrame::default();\\n                f.held = buttons::INTERACT;\\n                f.pressed = buttons::INTERACT;\\n                f\\n            }\\n            _ => self.bot_ground_shot(),\\n        }\\n1330→    }\\n\\n    fn bot_ignite(&self, k: u8) -> InputFrame {\\n        if k == 11 {\\n            if self.ride.seat != 0 {\\n                let mut f = InputFrame::default();\\n                f.pressed = buttons::USE;\\n                return f;\\n            }\\n            if self.cell_open(self.x, self.z) {\\n1340→                let mut f = InputFrame::default();\\n                f.held = buttons::INTERACT;\\n                f.pressed = buttons::INTERACT;\\n                return f;\\n            }\\n            if let Some((px, pz)) = self.nearest_open_cell(self.x, self.z) {\\n                return self.bot_go(px, pz, true);\\n            }\\n            return self.bot_go(self.step_x + 16.0, self.step_z + 12.0, true);\\n        }\\n1350→        if k == 6 {\\n            if let Some(b) = self.bodies.iter().find(|b| b.alive && b.kind == 5) {\\n                return self.bot_aim(b.x, b.z, 1.15, true);\\n            }\\n        }\\n        if k == 8 {\\n            let nearest = self.bodies.iter().filter(|b| b.alive && b.kind == 1).min_by(|a, b| {\\n                geom::dist(self.x, self.z, a.x, a.z).total_cmp(&geom::dist(self.x, self.z, b.x, b.z))\\n            });\\n            if let Some(b) = nearest {\\n1360→                return self.bot_aim(b.x, b.z, 1.2, true);\\n            }\\n        }\\n        self.bot_ground_shot()\\n    }\\n\\n    fn bot_ground_shot(&self) -> InputFrame {\\n        let mut f = InputFrame::default();\\n        let (want_yaw, want_pitch) = match self.current() {\\n            Some(Spec::Ignite(k)) => (k as f32 * 0.55, -0.16),\\n1370→            Some(Spec::Town) => (0.0, -0.55),\\n            _ => (self.yaw, -0.22),\\n        };\\n        let yerr = geom::wrap_angle(want_yaw - self.yaw);\\n        let perr = want_pitch - self.pitch;\\n        f.look.x = yerr.clamp(-1.2, 1.2);\\n        f.look.y = perr.clamp(-0.4, 0.4);\\n        if yerr.abs() < 0.12 && perr.abs() < 0.08 {\\n            if self.guns.is_empty() || self.gun().ammo == 0 {\\n                f.pressed |= buttons::RELOAD;\\n1380→            } else {\\n                f.held |= buttons::PRIMARY;\\n                f.pressed |= buttons::PRIMARY;\\n            }\\n        }\\n        f\\n    }\\n\\n    pub fn start_playing(&mut self) {\\n        self.screen = Screen::Playing;\\n1390→        let (x, z) = geom::place(\\\"Airstrip\\\");\\n        self.x = x;\\n        self.z = z;\\n        self.yaw = 0.0;\\n        self.eye = 1.58;\\n        self.idle = 0.0;\\n        self.pitch = 0.08;\\n    }\\n\\n    fn simulate(&mut self, input: &InputFrame, dt: f32) {\\n1400→        self.yaw = geom::wrap_angle(self.yaw + input.look.x);\\n        self.pitch = (self.pitch + input.look.y).clamp(-1.15, 1.15);\\n        if self.fever_state == 2 {\\n            self.roll = (self.minutes * 2.0).sin() * 0.05 * self.tune.fever_severity;\\n        } else {\\n            self.roll *= 0.9;\\n        }\\n        if input.down(buttons::CRAWL) {\\n            self.stance = 2;\\n        } else if input.down(buttons::CROUCH) {\\n1410→            self.stance = 1;\\n        } else if !self.treating {\\n            self.stance = 0;\\n        }\\n        let target_eye = match self.stance {\\n            2 => 0.42,\\n            1 => 1.02,\\n            _ => 1.58,\\n        };\\n        let k = 1.0 - (-dt / 0.12).exp();\\n1420→        if !self.dev.noclip {\\n            self.eye += (target_eye - self.eye) * k;\\n        }\\n\\n        if input.down(buttons::MAP) {\\n            self.map_t += dt;\\n            if self.map_t > 0.35 {\\n                self.mark(\\\"map_raised\\\");\\n            }\\n        } else {\\n1430→            self.map_t = (self.map_t - dt * 2.0).max(0.0);\\n        }\\n        if self.flags.contains(\\\"map_raised\\\") && (input.just(buttons::INTERACT) || input.act == 1) && self.waypoint.is_none() {\\n            self.waypoint = Some((0.0, 460.0));\\n            self.mark(\\\"waypoint_set\\\");\\n        }\\n        if input.down(buttons::MONOCULAR) {\\n            self.mono_t += dt;\\n            if self.mono_t > 0.5 && self.bodies.iter().any(|b| b.alive && geom::dist(self.x, self.z, b.x, b.z) < 80.0) {\\n                self.mark(\\\"monocular_tag\\\");\\n1440→            }\\n        } else {\\n            self.mono_t = 0.0;\\n        }\\n\\n        self.move_body(input, dt);\\n        self.use_vehicle(input, dt);\\n        self.handle_items(input, dt);\\n        self.handle_gun(input, dt);\\n        self.update_bodies(dt);\\n1450→        self.update_fever(dt);\\n        self.update_rescue(dt);\\n        let rain = self.weather == 1;\\n        let wind = self.wind * self.tune.wind_strength;\\n        let out = self.fire.tick(dt, wind, self.tune.fire_spread, self.tune.burn_time, self.minutes, rain, &mut self.rng);\\n        if out > 0 {\\n            self.mark(\\\"rain_extinguished\\\");\\n            self.weather = 0;\\n        }\\n        if self.fire.burned >= 500 {\\n1460→            self.mark(\\\"cells_500\\\");\\n        }\\n        self.special_actions(input, dt);\\n        if self.hp > 20.0 && self.hp < 100.0 && self.rescue_t <= 0.0 && !self.dev.god {\\n            self.hp = (self.hp + 8.0 * dt).min(100.0);\\n        }\\n        if self.dev.god {\\n            self.hp = 100.0;\\n        }\\n    }\\n1470→\\n    fn move_body(&mut self, input: &InputFrame, dt: f32) {\\n        if self.dev.noclip {\\n            let (sy, cy) = self.yaw.sin_cos();\\n            let fwd = Vec2::new(sy, -cy);\\n            let right = Vec2::new(cy, sy);\\n            let wish = right * input.move_dir.x + fwd * input.move_dir.y;\\n            if wish.length_squared() > 1e-6 {\\n                let n = wish.normalize();\\n                self.x += n.x * 24.0 * dt;\\n1480→                self.z += n.y * 24.0 * dt;\\n            }\\n            self.eye = (self.eye + input.look.y * 24.0 * dt).clamp(0.2, 80.0);\\n            return;\\n        }\\n        if self.ride.seat != 0 || self.rescue_t > 0.0 || self.treating {\\n            return;\\n        }\\n        let (sy, cy) = self.yaw.sin_cos();\\n        let fwd = Vec2::new(sy, -cy);\\n1490→        let right = Vec2::new(cy, sy);\\n        let wish = right * input.move_dir.x + fwd * input.move_dir.y;\\n        let sprint = input.down(buttons::FOCUS) && self.stamina > 0.0 && self.stance == 0;\\n        let mut speed = if input.down(buttons::SECONDARY) { 3.0 } else { 4.6 };\\n        if sprint {\\n            speed = 7.0;\\n            self.stamina = (self.stamina - dt).max(0.0);\\n        } else if !input.down(buttons::FOCUS) {\\n            self.stamina = (self.stamina + dt * 2.0).min(12.0);\\n        }\\n1500→        speed *= match self.stance {\\n            1 => 0.55,\\n            2 => 0.28,\\n            _ => 1.0,\\n        };\\n        if self.fever_state == 2 {\\n            speed *= 0.75;\\n        }\\n        speed *= self.tune.player_speed;\\n        let diff = match self.difficulty {\\n1510→            0 => 1.05,\\n            2 => 0.95,\\n            _ => 1.0,\\n        };\\n        speed *= diff;\\n        if wish.length_squared() > 1e-6 {\\n            let n = wish.normalize();\\n            self.x += n.x * speed * dt;\\n            self.z += n.y * speed * dt;\\n        }\\n1520→        let (x, z) = geom::clamp_map(self.x, self.z);\\n        self.x = x;\\n        self.z = z;\\n    }\\n\\n    fn use_vehicle(&mut self, input: &InputFrame, dt: f32) {\\n        if self.dev.noclip {\\n            return;\\n        }\\n        if input.just(buttons::USE) && self.ride.kind != 0 {\\n1530→            let near = geom::dist(self.x, self.z, self.ride.x, self.ride.z) < 6.0;\\n            if self.ride.seat != 0 || near {\\n                self.ride.seat = (self.ride.seat + 1) % 3;\\n            }\\n            if self.ride.seat == 2 {\\n                // gunner\\n            }\\n        }\\n        if self.ride.seat == 0 {\\n            if self.ride.kind != 0 && geom::dist(self.x, self.z, self.ride.x, self.ride.z) < 5.0 && input.down(buttons::INTERACT) {\\n1540→                self.ride.repair += dt;\\n                if self.ride.repair >= 6.0 && self.ride.health < 70.0 {\\n                    self.ride.health = 70.0;\\n                    self.ride.stage = 1;\\n                    self.ride.fuse = 0.0;\\n                    self.ride.repair = 0.0;\\n                    self.mark(\\\"repair_done\\\");\\n                }\\n            }\\n            return;\",\"content_concise\":\"1100→            }\\n            Spec::Pill => {\\n                f.held = buttons::PILLS;\\n                f.pressed = buttons::PILLS;\\n            }\\n            Spec::Fight | Spec::Ceasefire | Spec::Convoy => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive && b.kind != 3) {\\n                    return self.bot_aim(b.x, b.z, 1.7, true);\\n                }\\n                f.held = buttons::PRIMARY;\\n1110→            }\\n            Spec::EnemyJam | Spec::Blackout | Spec::Fever | Spec::Die => {}\\n            Spec::Jam | Spec::Break => {\\n                if self.gun().jammed {\\n                    f.pressed = buttons::RELOAD;\\n                    f.held = buttons::RELOAD;\\n                } else {\\n                    f.held = buttons::PRIMARY | buttons::SECONDARY;\\n                    f.pressed = buttons::PRIMARY;\\n                }\\n1120→            }\\n            Spec::Rescue => {}\\n            Spec::Wound(_) => {\\n                f.held = buttons::HEAL;\\n                f.pressed = buttons::HEAL;\\n            }\\n            Spec::Syrette => {\\n                f.pressed = buttons::HEAL;\\n                f.held = buttons::HEAL;\\n            }\\n1130→            Spec::Sleep { .. } => {\\n                let (hx, hz) = geom::nearest_safe(self.x, self.z);\\n                if geom::dist(self.x, self.z, hx, hz) > 8.0 && self.ride.seat == 0 {\\n                    return self.bot_go(hx, hz, true);\\n                }\\n                if self.ride.seat != 0 {\\n                    f.pressed = buttons::USE;\\n                } else {\\n                    f.held = buttons::INTERACT;\\n                    f.pressed = buttons::INTERACT;\\n1140→                }\\n            }\\n            Spec::Drive { x, z } => {\\n                if self.ride.seat == 0 {\\n                    let d = geom::dist(self.x, self.z, self.ride.x, self.ride.z);\\n                    if self.ride.kind != 0 && d > 5.0 {\\n                        return self.bot_go(self.ride.x, self.ride.z, true);\\n                    }\\n                    f.pressed = buttons::USE;\\n                    return f;\\n1150→                }\\n                return self.bot_drive(x, z);\\n            }\\n            Spec::Bus { .. } => {\\n                let (tx, tz) = geom::place(\\\"Junction\\\");\\n                if self.ride.seat == 0 {\\n                    let d = geom::dist(self.x, self.z, self.ride.x, self.ride.z);\\n                    if self.ride.kind != 0 && d > 5.0 {\\n                        return self.bot_go(self.ride.x, self.ride.z, true);\\n                    }\\n1160→                    f.pressed = buttons::USE;\\n                    return f;\\n                }\\n                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Mono => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive) {\\n                    let mut aim = self.bot_aim(b.x, b.z, 1.6, false);\\n                    aim.held |= buttons::MONOCULAR;\\n                    aim.pressed |= buttons::MONOCULAR;\\n1170→                    return aim;\\n                }\\n            }\\n            Spec::Ignite(k) => return self.bot_ignite(k),\\n            Spec::Tanks => {\\n                f.held = buttons::PRIMARY;\\n                f.pressed = buttons::PRIMARY;\\n            }\\n            Spec::Mounted => {\\n                if self.ride.seat != 2 {\\n1180→                    if self.ride.seat == 0 {\\n                        let d = geom::dist(self.x, self.z, self.ride.x, self.ride.z);\\n                        if self.ride.kind != 0 && d > 5.0 {\\n                            return self.bot_go(self.ride.x, self.ride.z, true);\\n                        }\\n                    }\\n                    f.pressed = buttons::USE;\\n                }\\n                f.held = buttons::PRIMARY;\\n                f.pressed |= buttons::PRIMARY;\\n1190→            }\\n            Spec::Animals => {\\n                // A shot already happened. Firing again drops the herd before it clears the grass.\\n                f.held = buttons::SECONDARY;\\n            }\\n            Spec::Panic => {}\\n            Spec::Boat => return self.bot_boat(),\\n            Spec::Night => {\\n                f.move_dir.y = 1.0;\\n                if self.stamina > 1.0 {\\n1200→                    f.held |= buttons::FOCUS;\\n                }\\n            }\\n            Spec::Town => return self.bot_town(),\\n            Spec::Ending(_) => return self.bot_ending(),\\n            Spec::Stealth => {\\n                f.held = buttons::CROUCH | buttons::MELEE;\\n                f.pressed = buttons::MELEE;\\n            }\\n            Spec::Dart => {\\n1210→                if let Some(b) = self.bodies.iter().find(|b| b.alive) {\\n                    return self.bot_aim(b.x, b.z, 1.2, true);\\n                }\\n            }\\n            Spec::Repair | Spec::Patch | Spec::Overdose => {\\n                f.held = buttons::INTERACT;\\n                f.pressed = buttons::INTERACT;\\n            }\\n            Spec::Rain | Spec::Better | Spec::Flag(_) => {\\n                f.pressed = buttons::INTERACT;\\n1220→            }\\n            _ => {}\\n        }\\n        let _ = shell::glyph(\\\"confirm\\\", self.device, self.xbox);\\n        f\\n    }\\n\\n    fn bot_go(&self, tx: f32, tz: f32, sprint: bool) -> InputFrame {\\n        let desired = geom::yaw_toward(self.x, self.z, tx, tz);\\n        let err = geom::wrap_angle(desired - self.yaw);\\n1230→        let mut f = InputFrame::default();\\n        f.look.x = err.clamp(-1.4, 1.4);\\n        if err.abs() < 0.4 {\\n            f.move_dir.y = 1.0;\\n            if sprint && self.stamina > 1.0 {\\n                f.held |= buttons::FOCUS;\\n            }\\n        }\\n        f\\n    }\\n1240→\\n    fn bot_drive(&self, tx: f32, tz: f32) -> InputFrame {\\n        let desired = geom::yaw_toward(self.ride.x, self.ride.z, tx, tz);\\n        let err = geom::wrap_angle(desired - self.ride.yaw);\\n        let mut f = InputFrame::default();\\n        f.axes.x = err.clamp(-1.0, 1.0);\\n        // The outboard stops dead once it leaves the deep channel, so turn before opening up.\\n        if self.ride.kind == 2 && err.abs() > 0.4 {\\n            f.axes.y = 0.05;\\n        } else {\\n1250→            f.axes.y = 1.0;\\n        }\\n        f\\n    }\\n\\n    fn bot_aim(&self, tx: f32, tz: f32, ty: f32, fire: bool) -> InputFrame {\\n        let dx = tx - self.x;\\n        let dz = tz - self.z;\\n        let dist = (dx * dx + dz * dz).sqrt().max(0.2);\\n        let desired = dx.atan2(-dz);\\n1260→        let err = geom::wrap_angle(desired - self.yaw);\\n        let perr = ((ty - self.eye) / dist).atan() - self.pitch;\\n        let mut f = InputFrame::default();\\n        f.look.x = err.clamp(-1.5, 1.5);\\n        f.look.y = perr.clamp(-1.2, 1.2);\\n        if fire && err.abs() < 0.2 && perr.abs() < 0.2 {\\n            f.held |= buttons::PRIMARY | buttons::SECONDARY;\\n            f.pressed |= buttons::PRIMARY;\\n        }\\n        f\\n1270→    }\\n\\n    fn bot_ledger(&self) -> InputFrame {\\n        let want = match self.route {\\n            Route::Read => 1usize,\\n            Route::Chair => 2,\\n            _ => 0,\\n        };\\n        let mut f = InputFrame::default();\\n        if self.focus != want {\\n1280→            f.act = if self.focus < want { 4 } else { 3 };\\n        } else {\\n            f.act = 1;\\n            f.pressed = buttons::CONFIRM;\\n        }\\n        f\\n    }\\n\\n    fn bot_boat(&self) -> InputFrame {\\n        if self.ride.seat == 0 {\\n1290→            let d = geom::dist(self.x, self.z, self.ride.x, self.ride.z);\\n            if d > 5.0 {\\n                return self.bot_go(self.ride.x, self.ride.z, true);\\n            }\\n            let mut f = InputFrame::default();\\n            f.pressed = buttons::USE;\\n            return f;\\n        }\\n        let (tx, tz) = geom::water_ahead(self.ride.x, self.ride.z, 40.0);\\n        self.bot_drive(tx, tz)\\n1300→    }\\n\\n    fn bot_town(&self) -> InputFrame {\\n        if self.ride.seat != 0 {\\n            let mut f = InputFrame::default();\\n            f.pressed = buttons::USE;\\n            return f;\\n        }\\n        let (tx, tz) = (18.0, 424.0);\\n        if geom::dist(self.x, self.z, tx, tz) > 2.5 {\\n1310→            return self.bot_go(tx, tz, true);\\n        }\\n        self.bot_ground_shot()\\n    }\\n\\n    fn bot_ending(&self) -> InputFrame {\\n        match self.finale {\\n            Some(1) => {\\n                let mut f = InputFrame::default();\\n                f.held = buttons::CROUCH;\\n1320→                f\\n            }\\n            Some(2) => {\\n                let mut f = InputFrame::default();\\n                f.held = buttons::INTERACT;\\n                f.pressed = buttons::INTERACT;\\n                f\\n            }\\n            _ => self.bot_ground_shot(),\\n        }\\n1330→    }\\n\\n    fn bot_ignite(&self, k: u8) -> InputFrame {\\n        if k == 11 {\\n            if self.ride.seat != 0 {\\n                let mut f = InputFrame::default();\\n                f.pressed = buttons::USE;\\n                return f;\\n            }\\n            if self.cell_open(self.x, self.z) {\\n1340→                let mut f = InputFrame::default();\\n                f.held = buttons::INTERACT;\\n                f.pressed = buttons::INTERACT;\\n                return f;\\n            }\\n            if let Some((px, pz)) = self.nearest_open_cell(self.x, self.z) {\\n                return self.bot_go(px, pz, true);\\n            }\\n            return self.bot_go(self.step_x + 16.0, self.step_z + 12.0, true);\\n        }\\n1350→        if k == 6 {\\n            if let Some(b) = self.bodies.iter().find(|b| b.alive && b.kind == 5) {\\n                return self.bot_aim(b.x, b.z, 1.15, true);\\n            }\\n        }\\n        if k == 8 {\\n            let nearest = self.bodies.iter().filter(|b| b.alive && b.kind == 1).min_by(|a, b| {\\n                geom::dist(self.x, self.z, a.x, a.z).total_cmp(&geom::dist(self.x, self.z, b.x, b.z))\\n            });\\n            if let Some(b) = nearest {\\n1360→                return self.bot_aim(b.x, b.z, 1.2, true);\\n            }\\n        }\\n        self.bot_ground_shot()\\n    }\\n\\n    fn bot_ground_shot(&self) -> InputFrame {\\n        let mut f = InputFrame::default();\\n        let (want_yaw, want_pitch) = match self.current() {\\n            Some(Spec::Ignite(k)) => (k as f32 * 0.55, -0.16),\\n1370→            Some(Spec::Town) => (0.0, -0.55),\\n            _ => (self.yaw, -0.22),\\n        };\\n        let yerr = geom::wrap_angle(want_yaw - self.yaw);\\n        let perr = want_pitch - self.pitch;\\n        f.look.x = yerr.clamp(-1.2, 1.2);\\n        f.look.y = perr.clamp(-0.4, 0.4);\\n        if yerr.abs() < 0.12 && perr.abs() < 0.08 {\\n            if self.guns.is_empty() || self.gun().ammo == 0 {\\n                f.pressed |= buttons::RELOAD;\\n1380→            } else {\\n                f.held |= buttons::PRIMARY;\\n                f.pressed |= buttons::PRIMARY;\\n            }\\n        }\\n        f\\n    }\\n\\n    pub fn start_playing(&mut self) {\\n        self.screen = Screen::Playing;\\n1390→        let (x, z) = geom::place(\\\"Airstrip\\\");\\n        self.x = x;\\n        self.z = z;\\n        self.yaw = 0.0;\\n        self.eye = 1.58;\\n        self.idle = 0.0;\\n        self.pitch = 0.08;\\n    }\\n\\n    fn simulate(&mut self, input: &InputFrame, dt: f32) {\\n1400→        self.yaw = geom::wrap_angle(self.yaw + input.look.x);\\n        self.pitch = (self.pitch + input.look.y).clamp(-1.15, 1.15);\\n        if self.fever_state == 2 {\\n            self.roll = (self.minutes * 2.0).sin() * 0.05 * self.tune.fever_severity;\\n        } else {\\n            self.roll *= 0.9;\\n        }\\n        if input.down(buttons::CRAWL) {\\n            self.stance = 2;\\n        } else if input.down(buttons::CROUCH) {\\n1410→            self.stance = 1;\\n        } else if !self.treating {\\n            self.stance = 0;\\n        }\\n        let target_eye = match self.stance {\\n            2 => 0.42,\\n            1 => 1.02,\\n            _ => 1.58,\\n        };\\n        let k = 1.0 - (-dt / 0.12).exp();\\n1420→        if !self.dev.noclip {\\n            self.eye += (target_eye - self.eye) * k;\\n        }\\n\\n        if input.down(buttons::MAP) {\\n            self.map_t += dt;\\n            if self.map_t > 0.35 {\\n                self.mark(\\\"map_raised\\\");\\n            }\\n        } else {\\n1430→            self.map_t = (self.map_t - dt * 2.0).max(0.0);\\n        }\\n        if self.flags.contains(\\\"map_raised\\\") && (input.just(buttons::INTERACT) || input.act == 1) && self.waypoint.is_none() {\\n            self.waypoint = Some((0.0, 460.0));\\n            self.mark(\\\"waypoint_set\\\");\\n        }\\n        if input.down(buttons::MONOCULAR) {\\n            self.mono_t += dt;\\n            if self.mono_t > 0.5 && self.bodies.iter().any(|b| b.alive && geom::dist(self.x, self.z, b.x, b.z) < 80.0) {\\n                self.mark(\\\"monocular_tag\\\");\\n1440→            }\\n        } else {\\n            self.mono_t = 0.0;\\n        }\\n\\n        self.move_body(input, dt);\\n        self.use_vehicle(input, dt);\\n        self.handle_items(input, dt);\\n        self.handle_gun(input, dt);\\n        self.update_bodies(dt);\\n1450→        self.update_fever(dt);\\n        self.update_rescue(dt);\\n        let rain = self.weather == 1;\\n        let wind = self.wind * self.tune.wind_strength;\\n        let out = self.fire.tick(dt, wind, self.tune.fire_spread, self.tune.burn_time, self.minutes, rain, &mut self.rng);\\n        if out > 0 {\\n            self.mark(\\\"rain_extinguished\\\");\\n            self.weather = 0;\\n        }\\n        if self.fire.burned >= 500 {\\n1460→            self.mark(\\\"cells_500\\\");\\n        }\\n        self.special_actions(input, dt);\\n        if self.hp > 20.0 && self.hp < 100.0 && self.rescue_t <= 0.0 && !self.dev.god {\\n            self.hp = (self.hp + 8.0 * dt).min(100.0);\\n        }\\n        if self.dev.god {\\n            self.hp = 100.0;\\n        }\\n    }\\n1470→\\n    fn move_body(&mut self, input: &InputFrame, dt: f32) {\\n        if self.dev.noclip {\\n            let (sy, cy) = self.yaw.sin_cos();\\n            let fwd = Vec2::new(sy, -cy);\\n            let right = Vec2::new(cy, sy);\\n            let wish = right * input.move_dir.x + fwd * input.move_dir.y;\\n            if wish.length_squared() > 1e-6 {\\n                let n = wish.normalize();\\n                self.x += n.x * 24.0 * dt;\\n1480→                self.z += n.y * 24.0 * dt;\\n            }\\n            self.eye = (self.eye + input.look.y * 24.0 * dt).clamp(0.2, 80.0);\\n            return;\\n        }\\n        if self.ride.seat != 0 || self.rescue_t > 0.0 || self.treating {\\n            return;\\n        }\\n        let (sy, cy) = self.yaw.sin_cos();\\n        let fwd = Vec2::new(sy, -cy);\\n1490→        let right = Vec2::new(cy, sy);\\n        let wish = right * input.move_dir.x + fwd * input.move_dir.y;\\n        let sprint = input.down(buttons::FOCUS) && self.stamina > 0.0 && self.stance == 0;\\n        let mut speed = if input.down(buttons::SECONDARY) { 3.0 } else { 4.6 };\\n        if sprint {\\n            speed = 7.0;\\n            self.stamina = (self.stamina - dt).max(0.0);\\n        } else if !input.down(buttons::FOCUS) {\\n            self.stamina = (self.stamina + dt * 2.0).min(12.0);\\n        }\\n1500→        speed *= match self.stance {\\n            1 => 0.55,\\n            2 => 0.28,\\n            _ => 1.0,\\n        };\\n        if self.fever_state == 2 {\\n            speed *= 0.75;\\n        }\\n        speed *= self.tune.player_speed;\\n        let diff = match self.difficulty {\\n1510→            0 => 1.05,\\n            2 => 0.95,\\n            _ => 1.0,\\n        };\\n        speed *= diff;\\n        if wish.length_squared() > 1e-6 {\\n            let n = wish.normalize();\\n            self.x += n.x * speed * dt;\\n            self.z += n.y * speed * dt;\\n        }\\n1520→        let (x, z) = geom::clamp_map(self.x, self.z);\\n        self.x = x;\\n        self.z = z;\\n    }\\n\\n    fn use_vehicle(&mut self, input: &InputFrame, dt: f32) {\\n        if self.dev.noclip {\\n            return;\\n        }\\n        if input.just(buttons::USE) && self.ride.kind != 0 {\\n1530→            let near = geom::dist(self.x, self.z, self.ride.x, self.ride.z) < 6.0;\\n            if self.ride.seat != 0 || near {\\n                self.ride.seat = (self.ride.seat + 1) % 3;\\n            }\\n            if self.ride.seat == 2 {\\n                // gunner\\n            }\\n        }\\n        if self.ride.seat == 0 {\\n            if self.ride.kind != 0 && geom::dist(self.x, self.z, self.ride.x, self.ride.z) < 5.0 && input.down(buttons::INTERACT) {\\n1540→                self.ride.repair += dt;\\n                if self.ride.repair >= 6.0 && self.ride.health < 70.0 {\\n                    self.ride.health = 70.0;\\n                    self.ride.stage = 1;\\n                    self.ride.fuse = 0.0;\\n                    self.ride.repair = 0.0;\\n                    self.mark(\\\"repair_done\\\");\\n                }\\n            }\\n            return;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs\",\"offset\":1100,\"limit\":450,\"raw_output\":\"            }\\n            Spec::Pill => {\\n                f.held = buttons::PILLS;\\n                f.pressed = buttons::PILLS;\\n            }\\n            Spec::Fight | Spec::Ceasefire | Spec::Convoy => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive && b.kind != 3) {\\n                    return self.bot_aim(b.x, b.z, 1.7, true);\\n                }\\n                f.held = buttons::PRIMARY;\\n            }\\n            Spec::EnemyJam | Spec::Blackout | Spec::Fever | Spec::Die => {}\\n            Spec::Jam | Spec::Break => {\\n                if self.gun().jammed {\\n                    f.pressed = buttons::RELOAD;\\n                    f.held = buttons::RELOAD;\\n                } else {\\n                    f.held = buttons::PRIMARY | buttons::SECONDARY;\\n                    f.pressed = buttons::PRIMARY;\\n                }\\n            }\\n            Spec::Rescue => {}\\n            Spec::Wound(_) => {\\n                f.held = buttons::HEAL;\\n                f.pressed = buttons::HEAL;\\n            }\\n            Spec::Syrette => {\\n                f.pressed = buttons::HEAL;\\n                f.held = buttons::HEAL;\\n            }\\n            Spec::Sleep { .. } => {\\n                let (hx, hz) = geom::nearest_safe(self.x, self.z);\\n                if geom::dist(self.x, self.z, hx, hz) > 8.0 && self.ride.seat == 0 {\\n                    return self.bot_go(hx, hz, true);\\n                }\\n                if self.ride.seat != 0 {\\n                    f.pressed = buttons::USE;\\n                } else {\\n                    f.held = buttons::INTERACT;\\n                    f.pressed = buttons::INTERACT;\\n                }\\n            }\\n            Spec::Drive { x, z } => {\\n                if self.ride.seat == 0 {\\n                    let d = geom::dist(self.x, self.z, self.ride.x, self.ride.z);\\n                    if self.ride.kind != 0 && d > 5.0 {\\n                        return self.bot_go(self.ride.x, self.ride.z, true);\\n                    }\\n                    f.pressed = buttons::USE;\\n                    return f;\\n                }\\n                return self.bot_drive(x, z);\\n            }\\n            Spec::Bus { .. } => {\\n                let (tx, tz) = geom::place(\\\"Junction\\\");\\n                if self.ride.seat == 0 {\\n                    let d = geom::dist(self.x, self.z, self.ride.x, self.ride.z);\\n                    if self.ride.kind != 0 && d > 5.0 {\\n                        return self.bot_go(self.ride.x, self.ride.z, true);\\n                    }\\n                    f.pressed = buttons::USE;\\n                    return f;\\n                }\\n                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Mono => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive) {\\n                    let mut aim = self.bot_aim(b.x, b.z, 1.6, false);\\n                    aim.held |= buttons::MONOCULAR;\\n                    aim.pressed |= buttons::MONOCULAR;\\n                    return aim;\\n                }\\n            }\\n            Spec::Ignite(k) => return self.bot_ignite(k),\\n            Spec::Tanks => {\\n                f.held = buttons::PRIMARY;\\n                f.pressed = buttons::PRIMARY;\\n            }\\n            Spec::Mounted => {\\n                if self.ride.seat != 2 {\\n                    if self.ride.seat == 0 {\\n                        let d = geom::dist(self.x, self.z, self.ride.x, self.ride.z);\\n                        if self.ride.kind != 0 && d > 5.0 {\\n                            return self.bot_go(self.ride.x, self.ride.z, true);\\n                        }\\n                    }\\n                    f.pressed = buttons::USE;\\n                }\\n                f.held = buttons::PRIMARY;\\n                f.pressed |= buttons::PRIMARY;\\n            }\\n            Spec::Animals => {\\n                // A shot already happened. Firing again drops the herd before it clears the grass.\\n                f.held = buttons::SECONDARY;\\n            }\\n            Spec::Panic => {}\\n            Spec::Boat => return self.bot_boat(),\\n            Spec::Night => {\\n                f.move_dir.y = 1.0;\\n                if self.stamina > 1.0 {\\n                    f.held |= buttons::FOCUS;\\n                }\\n            }\\n            Spec::Town => return self.bot_town(),\\n            Spec::Ending(_) => return self.bot_ending(),\\n            Spec::Stealth => {\\n                f.held = buttons::CROUCH | buttons::MELEE;\\n                f.pressed = buttons::MELEE;\\n            }\\n            Spec::Dart => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive) {\\n                    return self.bot_aim(b.x, b.z, 1.2, true);\\n                }\\n            }\\n            Spec::Repair | Spec::Patch | Spec::Overdose => {\\n                f.held = buttons::INTERACT;\\n                f.pressed = buttons::INTERACT;\\n            }\\n            Spec::Rain | Spec::Better | Spec::Flag(_) => {\\n                f.pressed = buttons::INTERACT;\\n            }\\n            _ => {}\\n        }\\n        let _ = shell::glyph(\\\"confirm\\\", self.device, self.xbox);\\n        f\\n    }\\n\\n    fn bot_go(&self, tx: f32, tz: f32, sprint: bool) -> InputFrame {\\n        let desired = geom::yaw_toward(self.x, self.z, tx, tz);\\n        let err = geom::wrap_angle(desired - self.yaw);\\n        let mut f = InputFrame::default();\\n        f.look.x = err.clamp(-1.4, 1.4);\\n        if err.abs() < 0.4 {\\n            f.move_dir.y = 1.0;\\n            if sprint && self.stamina > 1.0 {\\n                f.held |= buttons::FOCUS;\\n            }\\n        }\\n        f\\n    }\\n\\n    fn bot_drive(&self, tx: f32, tz: f32) -> InputFrame {\\n        let desired = geom::yaw_toward(self.ride.x, self.ride.z, tx, tz);\\n        let err = geom::wrap_angle(desired - self.ride.yaw);\\n        let mut f = InputFrame::default();\\n        f.axes.x = err.clamp(-1.0, 1.0);\\n        // The outboard stops dead once it leaves the deep channel, so turn before opening up.\\n        if self.ride.kind == 2 && err.abs() > 0.4 {\\n            f.axes.y = 0.05;\\n        } else {\\n            f.axes.y = 1.0;\\n        }\\n        f\\n    }\\n\\n    fn bot_aim(&self, tx: f32, tz: f32, ty: f32, fire: bool) -> InputFrame {\\n        let dx = tx - self.x;\\n        let dz = tz - self.z;\\n        let dist = (dx * dx + dz * dz).sqrt().max(0.2);\\n        let desired = dx.atan2(-dz);\\n        let err = geom::wrap_angle(desired - self.yaw);\\n        let perr = ((ty - self.eye) / dist).atan() - self.pitch;\\n        let mut f = InputFrame::default();\\n        f.look.x = err.clamp(-1.5, 1.5);\\n        f.look.y = perr.clamp(-1.2, 1.2);\\n        if fire && err.abs() < 0.2 && perr.abs() < 0.2 {\\n            f.held |= buttons::PRIMARY | buttons::SECONDARY;\\n            f.pressed |= buttons::PRIMARY;\\n        }\\n        f\\n    }\\n\\n    fn bot_ledger(&self) -> InputFrame {\\n        let want = match self.route {\\n            Route::Read => 1usize,\\n            Route::Chair => 2,\\n            _ => 0,\\n        };\\n        let mut f = InputFrame::default();\\n        if self.focus != want {\\n            f.act = if self.focus < want { 4 } else { 3 };\\n        } else {\\n            f.act = 1;\\n            f.pressed = buttons::CONFIRM;\\n        }\\n        f\\n    }\\n\\n    fn bot_boat(&self) -> InputFrame {\\n        if self.ride.seat == 0 {\\n            let d = geom::dist(self.x, self.z, self.ride.x, self.ride.z);\\n            if d > 5.0 {\\n                return self.bot_go(self.ride.x, self.ride.z, true);\\n            }\\n            let mut f = InputFrame::default();\\n            f.pressed = buttons::USE;\\n            return f;\\n        }\\n        let (tx, tz) = geom::water_ahead(self.ride.x, self.ride.z, 40.0);\\n        self.bot_drive(tx, tz)\\n    }\\n\\n    fn bot_town(&self) -> InputFrame {\\n        if self.ride.seat != 0 {\\n            let mut f = InputFrame::default();\\n            f.pressed = buttons::USE;\\n            return f;\\n        }\\n        let (tx, tz) = (18.0, 424.0);\\n        if geom::dist(self.x, self.z, tx, tz) > 2.5 {\\n            return self.bot_go(tx, tz, true);\\n        }\\n        self.bot_ground_shot()\\n    }\\n\\n    fn bot_ending(&self) -> InputFrame {\\n        match self.finale {\\n            Some(1) => {\\n                let mut f = InputFrame::default();\\n                f.held = buttons::CROUCH;\\n                f\\n            }\\n            Some(2) => {\\n                let mut f = InputFrame::default();\\n                f.held = buttons::INTERACT;\\n                f.pressed = buttons::INTERACT;\\n                f\\n            }\\n            _ => self.bot_ground_shot(),\\n        }\\n    }\\n\\n    fn bot_ignite(&self, k: u8) -> InputFrame {\\n        if k == 11 {\\n            if self.ride.seat != 0 {\\n                let mut f = InputFrame::default();\\n                f.pressed = buttons::USE;\\n                return f;\\n            }\\n            if self.cell_open(self.x, self.z) {\\n                let mut f = InputFrame::default();\\n                f.held = buttons::INTERACT;\\n                f.pressed = buttons::INTERACT;\\n                return f;\\n            }\\n            if let Some((px, pz)) = self.nearest_open_cell(self.x, self.z) {\\n                return self.bot_go(px, pz, true);\\n            }\\n            return self.bot_go(self.step_x + 16.0, self.step_z + 12.0, true);\\n        }\\n        if k == 6 {\\n            if let Some(b) = self.bodies.iter().find(|b| b.alive && b.kind == 5) {\\n                return self.bot_aim(b.x, b.z, 1.15, true);\\n            }\\n        }\\n        if k == 8 {\\n            let nearest = self.bodies.iter().filter(|b| b.alive && b.kind == 1).min_by(|a, b| {\\n                geom::dist(self.x, self.z, a.x, a.z).total_cmp(&geom::dist(self.x, self.z, b.x, b.z))\\n            });\\n            if let Some(b) = nearest {\\n                return self.bot_aim(b.x, b.z, 1.2, true);\\n            }\\n        }\\n        self.bot_ground_shot()\\n    }\\n\\n    fn bot_ground_shot(&self) -> InputFrame {\\n        let mut f = InputFrame::default();\\n        let (want_yaw, want_pitch) = match self.current() {\\n            Some(Spec::Ignite(k)) => (k as f32 * 0.55, -0.16),\\n            Some(Spec::Town) => (0.0, -0.55),\\n            _ => (self.yaw, -0.22),\\n        };\\n        let yerr = geom::wrap_angle(want_yaw - self.yaw);\\n        let perr = want_pitch - self.pitch;\\n        f.look.x = yerr.clamp(-1.2, 1.2);\\n        f.look.y = perr.clamp(-0.4, 0.4);\\n        if yerr.abs() < 0.12 && perr.abs() < 0.08 {\\n            if self.guns.is_empty() || self.gun().ammo == 0 {\\n                f.pressed |= buttons::RELOAD;\\n            } else {\\n                f.held |= buttons::PRIMARY;\\n                f.pressed |= buttons::PRIMARY;\\n            }\\n        }\\n        f\\n    }\\n\\n    pub fn start_playing(&mut self) {\\n        self.screen = Screen::Playing;\\n        let (x, z) = geom::place(\\\"Airstrip\\\");\\n        self.x = x;\\n        self.z = z;\\n        self.yaw = 0.0;\\n        self.eye = 1.58;\\n        self.idle = 0.0;\\n        self.pitch = 0.08;\\n    }\\n\\n    fn simulate(&mut self, input: &InputFrame, dt: f32) {\\n        self.yaw = geom::wrap_angle(self.yaw + input.look.x);\\n        self.pitch = (self.pitch + input.look.y).clamp(-1.15, 1.15);\\n        if self.fever_state == 2 {\\n            self.roll = (self.minutes * 2.0).sin() * 0.05 * self.tune.fever_severity;\\n        } else {\\n            self.roll *= 0.9;\\n        }\\n        if input.down(buttons::CRAWL) {\\n            self.stance = 2;\\n        } else if input.down(buttons::CROUCH) {\\n            self.stance = 1;\\n        } else if !self.treating {\\n            self.stance = 0;\\n        }\\n        let target_eye = match self.stance {\\n            2 => 0.42,\\n            1 => 1.02,\\n            _ => 1.58,\\n        };\\n        let k = 1.0 - (-dt / 0.12).exp();\\n        if !self.dev.noclip {\\n            self.eye += (target_eye - self.eye) * k;\\n        }\\n\\n        if input.down(buttons::MAP) {\\n            self.map_t += dt;\\n            if self.map_t > 0.35 {\\n                self.mark(\\\"map_raised\\\");\\n            }\\n        } else {\\n            self.map_t = (self.map_t - dt * 2.0).max(0.0);\\n        }\\n        if self.flags.contains(\\\"map_raised\\\") && (input.just(buttons::INTERACT) || input.act == 1) && self.waypoint.is_none() {\\n            self.waypoint = Some((0.0, 460.0));\\n            self.mark(\\\"waypoint_set\\\");\\n        }\\n        if input.down(buttons::MONOCULAR) {\\n            self.mono_t += dt;\\n            if self.mono_t > 0.5 && self.bodies.iter().any(|b| b.alive && geom::dist(self.x, self.z, b.x, b.z) < 80.0) {\\n                self.mark(\\\"monocular_tag\\\");\\n            }\\n        } else {\\n            self.mono_t = 0.0;\\n        }\\n\\n        self.move_body(input, dt);\\n        self.use_vehicle(input, dt);\\n        self.handle_items(input, dt);\\n        self.handle_gun(input, dt);\\n        self.update_bodies(dt);\\n        self.update_fever(dt);\\n        self.update_rescue(dt);\\n        let rain = self.weather == 1;\\n        let wind = self.wind * self.tune.wind_strength;\\n        let out = self.fire.tick(dt, wind, self.tune.fire_spread, self.tune.burn_time, self.minutes, rain, &mut self.rng);\\n        if out > 0 {\\n            self.mark(\\\"rain_extinguished\\\");\\n            self.weather = 0;\\n        }\\n        if self.fire.burned >= 500 {\\n            self.mark(\\\"cells_500\\\");\\n        }\\n        self.special_actions(input, dt);\\n        if self.hp > 20.0 && self.hp < 100.0 && self.rescue_t <= 0.0 && !self.dev.god {\\n            self.hp = (self.hp + 8.0 * dt).min(100.0);\\n        }\\n        if self.dev.god {\\n            self.hp = 100.0;\\n        }\\n    }\\n\\n    fn move_body(&mut self, input: &InputFrame, dt: f32) {\\n        if self.dev.noclip {\\n            let (sy, cy) = self.yaw.sin_cos();\\n            let fwd = Vec2::new(sy, -cy);\\n            let right = Vec2::new(cy, sy);\\n            let wish = right * input.move_dir.x + fwd * input.move_dir.y;\\n            if wish.length_squared() > 1e-6 {\\n                let n = wish.normalize();\\n                self.x += n.x * 24.0 * dt;\\n                self.z += n.y * 24.0 * dt;\\n            }\\n            self.eye = (self.eye + input.look.y * 24.0 * dt).clamp(0.2, 80.0);\\n            return;\\n        }\\n        if self.ride.seat != 0 || self.rescue_t > 0.0 || self.treating {\\n            return;\\n        }\\n        let (sy, cy) = self.yaw.sin_cos();\\n        let fwd = Vec2::new(sy, -cy);\\n        let right = Vec2::new(cy, sy);\\n        let wish = right * input.move_dir.x + fwd * input.move_dir.y;\\n        let sprint = input.down(buttons::FOCUS) && self.stamina > 0.0 && self.stance == 0;\\n        let mut speed = if input.down(buttons::SECONDARY) { 3.0 } else { 4.6 };\\n        if sprint {\\n            speed = 7.0;\\n            self.stamina = (self.stamina - dt).max(0.0);\\n        } else if !input.down(buttons::FOCUS) {\\n            self.stamina = (self.stamina + dt * 2.0).min(12.0);\\n        }\\n        speed *= match self.stance {\\n            1 => 0.55,\\n            2 => 0.28,\\n            _ => 1.0,\\n        };\\n        if self.fever_state == 2 {\\n            speed *= 0.75;\\n        }\\n        speed *= self.tune.player_speed;\\n        let diff = match self.difficulty {\\n            0 => 1.05,\\n            2 => 0.95,\\n            _ => 1.0,\\n        };\\n        speed *= diff;\\n        if wish.length_squared() > 1e-6 {\\n            let n = wish.normalize();\\n            self.x += n.x * speed * dt;\\n            self.z += n.y * speed * dt;\\n        }\\n        let (x, z) = geom::clamp_map(self.x, self.z);\\n        self.x = x;\\n        self.z = z;\\n    }\\n\\n    fn use_vehicle(&mut self, input: &InputFrame, dt: f32) {\\n        if self.dev.noclip {\\n            return;\\n        }\\n        if input.just(buttons::USE) && self.ride.kind != 0 {\\n            let near = geom::dist(self.x, self.z, self.ride.x, self.ride.z) < 6.0;\\n            if self.ride.seat != 0 || near {\\n                self.ride.seat = (self.ride.seat + 1) % 3;\\n            }\\n            if self.ride.seat == 2 {\\n                // gunner\\n            }\\n        }\\n        if self.ride.seat == 0 {\\n            if self.ride.kind != 0 && geom::dist(self.x, self.z, self.ride.x, self.ride.z) < 5.0 && input.down(buttons::INTERACT) {\\n                self.ride.repair += dt;\\n                if self.ride.repair >= 6.0 && self.ride.health < 70.0 {\\n                    self.ride.health = 70.0;\\n                    self.ride.stage = 1;\\n                    self.ride.fuse = 0.0;\\n                    self.ride.repair = 0.0;\\n                    self.mark(\\\"repair_done\\\");\\n                }\\n            }\\n            return;\\n\",\"total_lines\":2806}}","is_error":false},{"type":"tool_result","tool_use_id":"call-e18fa8ce-cff4-4dce-bfbb-b5c406b0a8f0-12","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1700→        }\\n        if self.guns[i].jammed {\\n            self.jam_seen = true;\\n        } else if self.jam_seen {\\n            self.mark(\\\"jam_cleared\\\");\\n        }\\n        let holster = self.ceasefire && geom::in_town(self.x, self.z);\\n        let want = input.down(buttons::PRIMARY) && !self.treating && !holster && self.rescue_t <= 0.0;\\n        if !want {\\n            return;\\n1710→        }\\n        let ads = input.down(buttons::SECONDARY);\\n        let jam = self.tune.jam_chance;\\n        let wear = self.tune.weapon_wear;\\n        let br = self.tune.break_threshold;\\n        let pull = self.guns[i].pull(&mut self.rng, jam, wear, br);\\n        if pull != Pull::Fired && pull != Pull::Broke {\\n            return;\\n        }\\n        self.resolve_shot(ads);\\n1720→        if pull == Pull::Broke {\\n            self.mark(\\\"weapon_broke\\\");\\n        }\\n    }\\n\\n    pub fn resolve_shot(&mut self, ads: bool) {\\n        let st = gun::stats(self.gun().id);\\n        let spread = 0.02 * gun::spread_mul(self.gun().condition) * if ads { 0.25 } else { 1.0 };\\n        let jitter = (self.rng.f32() - 0.5) * spread;\\n        let yaw = self.yaw + jitter;\\n1730→        let pitch = self.pitch + jitter * 0.5;\\n        let (sy, cy) = yaw.sin_cos();\\n        let (sp, cp) = pitch.sin_cos();\\n        let dir = (sy * cp, sp, -cy * cp);\\n        let origin = (self.x, self.eye, self.z);\\n        self.shots_tick(origin, dir, st.damage * self.tune.player_damage, st.range, st.noise, st.ignites, st.silent, self.gun().id, self.gun().shots);\\n    }\\n\\n    fn shots_tick(&mut self, origin: (f32, f32, f32), dir: (f32, f32, f32), damage: f32, range: f32, noise: f32, ignites: bool, silent: bool, id: WeaponId, shot_n: u32) {\\n        let mut best_t = range;\\n1740→        let mut best_zone = 0u8;\\n        let mut best_i: Option<usize> = None;\\n        let mut blocked = false;\\n        for w in &self.walls {\\n            if let Some(t) = ray_aabb(origin, dir, w.min, w.max) {\\n                if t < best_t {\\n                    best_t = t;\\n                    blocked = true;\\n                    best_i = None;\\n                }\\n1750→            }\\n        }\\n        if !blocked {\\n            for (i, b) in self.bodies.iter().enumerate() {\\n                if !b.alive {\\n                    continue;\\n                }\\n                let zones = [(1.70, 0.18, 3u8), (1.15, 0.28, 1u8), (0.45, 0.20, 2u8)];\\n                for (y, r, zone) in zones {\\n                    if let Some(t) = ray_sphere(origin, dir, (b.x, y, b.z), r) {\\n1760→                        if t < best_t {\\n                            best_t = t;\\n                            best_zone = zone;\\n                            best_i = Some(i);\\n                        }\\n                    }\\n                }\\n            }\\n        }\\n        let hit_x = origin.0 + dir.0 * best_t;\\n1770→        let hit_z = origin.2 + dir.2 * best_t;\\n        if let Some(i) = best_i {\\n            let mul = match best_zone {\\n                3 => 3.0,\\n                2 => 0.6,\\n                _ => 1.0,\\n            };\\n            let dmg = damage * mul;\\n            let kind = self.bodies[i].kind;\\n            let in_town = geom::in_town(self.bodies[i].x, self.bodies[i].z);\\n1780→            if self.ceasefire && in_town && kind == 2 {\\n                // Civilians are safe while the ceasefire holds.\\n            } else if id == WeaponId::Dart {\\n                self.bodies[i].poison = 3.0;\\n            } else {\\n                self.bodies[i].hp -= dmg;\\n                if ignites && matches!(self.current(), Some(Spec::Ignite(8))) && kind == 1 {\\n                    self.mark(\\\"ignite_person\\\");\\n                }\\n                if self.bodies[i].hp <= 0.0 {\\n1790→                    self.bodies[i].alive = false;\\n                    if kind == 1 && self.stance == 1 && silent {\\n                        self.mark(\\\"stealth_kill\\\");\\n                    }\\n                    if kind == 5 && matches!(self.current(), Some(Spec::Ignite(6))) {\\n                        let bx = self.bodies[i].x;\\n                        let bz = self.bodies[i].z;\\n                        let _ = self.fire.ignite_disk(bx, bz, 5.0, self.tune.burn_time, self.minutes);\\n                        self.mark(\\\"ignite_barrel\\\");\\n                    }\\n1800→                    if matches!(self.current(), Some(Spec::Ceasefire)) {\\n                        self.ceasefire = false;\\n                        self.mark(\\\"ceasefire_ended\\\");\\n                    }\\n                }\\n            }\\n        }\\n        let weapon_lights = ignites\\n            || matches!(id, WeaponId::Flare | WeaponId::Rpg | WeaponId::Flamer | WeaponId::Mortar | WeaponId::Molotov | WeaponId::Frag);\\n        if weapon_lights && self.fire.ignite_at(hit_x, hit_z, self.tune.burn_time, self.minutes) {\\n1810→            self.note_weapon_ignite(id);\\n            if self.finale == Some(0) && matches!(self.current(), Some(Spec::Ending(_))) {\\n                self.mark(\\\"ending_burn\\\");\\n            }\\n        }\\n        if matches!(self.current(), Some(Spec::Ignite(9))) && self.fire.ignite_at(hit_x, hit_z, self.tune.burn_time, self.minutes) {\\n            self.mark(\\\"ignite_lightning\\\");\\n        }\\n        if matches!(self.current(), Some(Spec::Ignite(7))) && self.ride.kind != 0 {\\n            // The round starts at the eye. Score the closest point on that ray, not the far hit.\\n1820→            let rel_x = self.ride.x - origin.0;\\n            let rel_z = self.ride.z - origin.2;\\n            let along = rel_x * dir.0 + rel_z * dir.2;\\n            let t = along.clamp(0.0, best_t);\\n            let cx = origin.0 + dir.0 * t;\\n            let cz = origin.2 + dir.2 * t;\\n            if geom::dist(cx, cz, self.ride.x, self.ride.z) < 4.0 {\\n                self.hurt_vehicle(damage.max(40.0));\\n                if self.ride.stage >= 3 {\\n                    let _ = self.fire.ignite_disk(self.ride.x, self.ride.z, 5.0, self.tune.burn_time, self.minutes);\\n1830→                    self.mark(\\\"ignite_vehicle\\\");\\n                    self.ride.health = 100.0;\\n                    self.ride.stage = 0;\\n                    self.ride.fuse = 0.0;\\n                }\\n            }\\n        }\\n        // Tracers: every third round. The coverage flag is earned on the tracer step.\\n        // Other play still lights grass one time in four, without stamping that flag early.\\n        let tracer_step = matches!(self.current(), Some(Spec::Ignite(10)));\\n1840→        if tracer_step && shot_n > 0 && shot_n % 3 == 0 {\\n            for k in 0..8 {\\n                let ox = hit_x + shot_n as f32 + k as f32 * 3.0;\\n                let oz = hit_z + 6.0 + k as f32 * 2.0;\\n                if self.fire.ignite_at(ox, oz, self.tune.burn_time, self.minutes) {\\n                    self.mark(\\\"ignite_tracer\\\");\\n                    break;\\n                }\\n            }\\n        } else if shot_n > 0 && shot_n % 3 == 0 && self.rng.f32() < 0.25 {\\n1850→            let _ = self.fire.ignite_at(hit_x, hit_z, self.tune.burn_time, self.minutes);\\n        }\\n        if !silent {\\n            for b in &mut self.bodies {\\n                if b.alive && b.alert == 0 && geom::dist(self.x, self.z, b.x, b.z) < noise {\\n                    b.alert = 1;\\n                }\\n            }\\n        }\\n        let _ = noise;\\n1860→    }\\n\\n    fn update_bodies(&mut self, dt: f32) {\\n        let px = self.x;\\n        let pz = self.z;\\n        let stance = self.stance;\\n        let night = self.hour() < 5.0 || self.hour() > 20.0;\\n        let light = if night { 0.45 } else { 1.0 };\\n        let n = self.bodies.len();\\n        let dead_soldiers = self.bodies.iter().filter(|b| b.kind == 1 && !b.alive).count();\\n1870→        let live_soldiers = self.bodies.iter().filter(|b| b.kind == 1 && b.alive).count();\\n        let morale_broken = dead_soldiers >= 2 && live_soldiers > 0 && live_soldiers <= dead_soldiers;\\n        let mut shooters = 0u32;\\n        for i in 0..n {\\n            if !self.bodies[i].alive {\\n                continue;\\n            }\\n            if self.bodies[i].poison > 0.0 {\\n                self.bodies[i].poison -= dt;\\n                if self.bodies[i].poison <= 0.0 && self.bodies[i].hp > 0.0 {\\n1880→                    self.bodies[i].hp = 0.0;\\n                    self.bodies[i].alive = false;\\n                    self.mark(\\\"dart_kill\\\");\\n                    continue;\\n                }\\n            }\\n            if self.bodies[i].kind == 3 {\\n                let d0 = geom::dist(px, pz, self.bodies[i].x, self.bodies[i].z);\\n                if d0 < 40.0 && self.guns.first().map(|g| g.shots > 0).unwrap_or(false) {\\n                    let dx = self.bodies[i].x - px;\\n1890→                    let dz = self.bodies[i].z - pz;\\n                    let len = (dx * dx + dz * dz).sqrt().max(0.1);\\n                    self.bodies[i].x += dx / len * 6.0 * dt;\\n                    self.bodies[i].z += dz / len * 6.0 * dt;\\n                    self.bodies[i].flee += 6.0 * dt;\\n                    if self.bodies[i].flee > 8.0 {\\n                        self.mark(\\\"animals_fled\\\");\\n                    }\\n                }\\n                continue;\",\"content_concise\":\"1700→        }\\n        if self.guns[i].jammed {\\n            self.jam_seen = true;\\n        } else if self.jam_seen {\\n            self.mark(\\\"jam_cleared\\\");\\n        }\\n        let holster = self.ceasefire && geom::in_town(self.x, self.z);\\n        let want = input.down(buttons::PRIMARY) && !self.treating && !holster && self.rescue_t <= 0.0;\\n        if !want {\\n            return;\\n1710→        }\\n        let ads = input.down(buttons::SECONDARY);\\n        let jam = self.tune.jam_chance;\\n        let wear = self.tune.weapon_wear;\\n        let br = self.tune.break_threshold;\\n        let pull = self.guns[i].pull(&mut self.rng, jam, wear, br);\\n        if pull != Pull::Fired && pull != Pull::Broke {\\n            return;\\n        }\\n        self.resolve_shot(ads);\\n1720→        if pull == Pull::Broke {\\n            self.mark(\\\"weapon_broke\\\");\\n        }\\n    }\\n\\n    pub fn resolve_shot(&mut self, ads: bool) {\\n        let st = gun::stats(self.gun().id);\\n        let spread = 0.02 * gun::spread_mul(self.gun().condition) * if ads { 0.25 } else { 1.0 };\\n        let jitter = (self.rng.f32() - 0.5) * spread;\\n        let yaw = self.yaw + jitter;\\n1730→        let pitch = self.pitch + jitter * 0.5;\\n        let (sy, cy) = yaw.sin_cos();\\n        let (sp, cp) = pitch.sin_cos();\\n        let dir = (sy * cp, sp, -cy * cp);\\n        let origin = (self.x, self.eye, self.z);\\n        self.shots_tick(origin, dir, st.damage * self.tune.player_damage, st.range, st.noise, st.ignites, st.silent, self.gun().id, self.gun().shots);\\n    }\\n\\n    fn shots_tick(&mut self, origin: (f32, f32, f32), dir: (f32, f32, f32), damage: f32, range: f32, noise: f32, ignites: bool, silent: bool, id: WeaponId, shot_n: u32) {\\n        let mut best_t = range;\\n1740→        let mut best_zone = 0u8;\\n        let mut best_i: Option<usize> = None;\\n        let mut blocked = false;\\n        for w in &self.walls {\\n            if let Some(t) = ray_aabb(origin, dir, w.min, w.max) {\\n                if t < best_t {\\n                    best_t = t;\\n                    blocked = true;\\n                    best_i = None;\\n                }\\n1750→            }\\n        }\\n        if !blocked {\\n            for (i, b) in self.bodies.iter().enumerate() {\\n                if !b.alive {\\n                    continue;\\n                }\\n                let zones = [(1.70, 0.18, 3u8), (1.15, 0.28, 1u8), (0.45, 0.20, 2u8)];\\n                for (y, r, zone) in zones {\\n                    if let Some(t) = ray_sphere(origin, dir, (b.x, y, b.z), r) {\\n1760→                        if t < best_t {\\n                            best_t = t;\\n                            best_zone = zone;\\n                            best_i = Some(i);\\n                        }\\n                    }\\n                }\\n            }\\n        }\\n        let hit_x = origin.0 + dir.0 * best_t;\\n1770→        let hit_z = origin.2 + dir.2 * best_t;\\n        if let Some(i) = best_i {\\n            let mul = match best_zone {\\n                3 => 3.0,\\n                2 => 0.6,\\n                _ => 1.0,\\n            };\\n            let dmg = damage * mul;\\n            let kind = self.bodies[i].kind;\\n            let in_town = geom::in_town(self.bodies[i].x, self.bodies[i].z);\\n1780→            if self.ceasefire && in_town && kind == 2 {\\n                // Civilians are safe while the ceasefire holds.\\n            } else if id == WeaponId::Dart {\\n                self.bodies[i].poison = 3.0;\\n            } else {\\n                self.bodies[i].hp -= dmg;\\n                if ignites && matches!(self.current(), Some(Spec::Ignite(8))) && kind == 1 {\\n                    self.mark(\\\"ignite_person\\\");\\n                }\\n                if self.bodies[i].hp <= 0.0 {\\n1790→                    self.bodies[i].alive = false;\\n                    if kind == 1 && self.stance == 1 && silent {\\n                        self.mark(\\\"stealth_kill\\\");\\n                    }\\n                    if kind == 5 && matches!(self.current(), Some(Spec::Ignite(6))) {\\n                        let bx = self.bodies[i].x;\\n                        let bz = self.bodies[i].z;\\n                        let _ = self.fire.ignite_disk(bx, bz, 5.0, self.tune.burn_time, self.minutes);\\n                        self.mark(\\\"ignite_barrel\\\");\\n                    }\\n1800→                    if matches!(self.current(), Some(Spec::Ceasefire)) {\\n                        self.ceasefire = false;\\n                        self.mark(\\\"ceasefire_ended\\\");\\n                    }\\n                }\\n            }\\n        }\\n        let weapon_lights = ignites\\n            || matches!(id, WeaponId::Flare | WeaponId::Rpg | WeaponId::Flamer | WeaponId::Mortar | WeaponId::Molotov | WeaponId::Frag);\\n        if weapon_lights && self.fire.ignite_at(hit_x, hit_z, self.tune.burn_time, self.minutes) {\\n1810→            self.note_weapon_ignite(id);\\n            if self.finale == Some(0) && matches!(self.current(), Some(Spec::Ending(_))) {\\n                self.mark(\\\"ending_burn\\\");\\n            }\\n        }\\n        if matches!(self.current(), Some(Spec::Ignite(9))) && self.fire.ignite_at(hit_x, hit_z, self.tune.burn_time, self.minutes) {\\n            self.mark(\\\"ignite_lightning\\\");\\n        }\\n        if matches!(self.current(), Some(Spec::Ignite(7))) && self.ride.kind != 0 {\\n            // The round starts at the eye. Score the closest point on that ray, not the far hit.\\n1820→            let rel_x = self.ride.x - origin.0;\\n            let rel_z = self.ride.z - origin.2;\\n            let along = rel_x * dir.0 + rel_z * dir.2;\\n            let t = along.clamp(0.0, best_t);\\n            let cx = origin.0 + dir.0 * t;\\n            let cz = origin.2 + dir.2 * t;\\n            if geom::dist(cx, cz, self.ride.x, self.ride.z) < 4.0 {\\n                self.hurt_vehicle(damage.max(40.0));\\n                if self.ride.stage >= 3 {\\n                    let _ = self.fire.ignite_disk(self.ride.x, self.ride.z, 5.0, self.tune.burn_time, self.minutes);\\n1830→                    self.mark(\\\"ignite_vehicle\\\");\\n                    self.ride.health = 100.0;\\n                    self.ride.stage = 0;\\n                    self.ride.fuse = 0.0;\\n                }\\n            }\\n        }\\n        // Tracers: every third round. The coverage flag is earned on the tracer step.\\n        // Other play still lights grass one time in four, without stamping that flag early.\\n        let tracer_step = matches!(self.current(), Some(Spec::Ignite(10)));\\n1840→        if tracer_step && shot_n > 0 && shot_n % 3 == 0 {\\n            for k in 0..8 {\\n                let ox = hit_x + shot_n as f32 + k as f32 * 3.0;\\n                let oz = hit_z + 6.0 + k as f32 * 2.0;\\n                if self.fire.ignite_at(ox, oz, self.tune.burn_time, self.minutes) {\\n                    self.mark(\\\"ignite_tracer\\\");\\n                    break;\\n                }\\n            }\\n        } else if shot_n > 0 && shot_n % 3 == 0 && self.rng.f32() < 0.25 {\\n1850→            let _ = self.fire.ignite_at(hit_x, hit_z, self.tune.burn_time, self.minutes);\\n        }\\n        if !silent {\\n            for b in &mut self.bodies {\\n                if b.alive && b.alert == 0 && geom::dist(self.x, self.z, b.x, b.z) < noise {\\n                    b.alert = 1;\\n                }\\n            }\\n        }\\n        let _ = noise;\\n1860→    }\\n\\n    fn update_bodies(&mut self, dt: f32) {\\n        let px = self.x;\\n        let pz = self.z;\\n        let stance = self.stance;\\n        let night = self.hour() < 5.0 || self.hour() > 20.0;\\n        let light = if night { 0.45 } else { 1.0 };\\n        let n = self.bodies.len();\\n        let dead_soldiers = self.bodies.iter().filter(|b| b.kind == 1 && !b.alive).count();\\n1870→        let live_soldiers = self.bodies.iter().filter(|b| b.kind == 1 && b.alive).count();\\n        let morale_broken = dead_soldiers >= 2 && live_soldiers > 0 && live_soldiers <= dead_soldiers;\\n        let mut shooters = 0u32;\\n        for i in 0..n {\\n            if !self.bodies[i].alive {\\n                continue;\\n            }\\n            if self.bodies[i].poison > 0.0 {\\n                self.bodies[i].poison -= dt;\\n                if self.bodies[i].poison <= 0.0 && self.bodies[i].hp > 0.0 {\\n1880→                    self.bodies[i].hp = 0.0;\\n                    self.bodies[i].alive = false;\\n                    self.mark(\\\"dart_kill\\\");\\n                    continue;\\n                }\\n            }\\n            if self.bodies[i].kind == 3 {\\n                let d0 = geom::dist(px, pz, self.bodies[i].x, self.bodies[i].z);\\n                if d0 < 40.0 && self.guns.first().map(|g| g.shots > 0).unwrap_or(false) {\\n                    let dx = self.bodies[i].x - px;\\n1890→                    let dz = self.bodies[i].z - pz;\\n                    let len = (dx * dx + dz * dz).sqrt().max(0.1);\\n                    self.bodies[i].x += dx / len * 6.0 * dt;\\n                    self.bodies[i].z += dz / len * 6.0 * dt;\\n                    self.bodies[i].flee += 6.0 * dt;\\n                    if self.bodies[i].flee > 8.0 {\\n                        self.mark(\\\"animals_fled\\\");\\n                    }\\n                }\\n                continue;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs\",\"offset\":1700,\"limit\":200,\"raw_output\":\"        }\\n        if self.guns[i].jammed {\\n            self.jam_seen = true;\\n        } else if self.jam_seen {\\n            self.mark(\\\"jam_cleared\\\");\\n        }\\n        let holster = self.ceasefire && geom::in_town(self.x, self.z);\\n        let want = input.down(buttons::PRIMARY) && !self.treating && !holster && self.rescue_t <= 0.0;\\n        if !want {\\n            return;\\n        }\\n        let ads = input.down(buttons::SECONDARY);\\n        let jam = self.tune.jam_chance;\\n        let wear = self.tune.weapon_wear;\\n        let br = self.tune.break_threshold;\\n        let pull = self.guns[i].pull(&mut self.rng, jam, wear, br);\\n        if pull != Pull::Fired && pull != Pull::Broke {\\n            return;\\n        }\\n        self.resolve_shot(ads);\\n        if pull == Pull::Broke {\\n            self.mark(\\\"weapon_broke\\\");\\n        }\\n    }\\n\\n    pub fn resolve_shot(&mut self, ads: bool) {\\n        let st = gun::stats(self.gun().id);\\n        let spread = 0.02 * gun::spread_mul(self.gun().condition) * if ads { 0.25 } else { 1.0 };\\n        let jitter = (self.rng.f32() - 0.5) * spread;\\n        let yaw = self.yaw + jitter;\\n        let pitch = self.pitch + jitter * 0.5;\\n        let (sy, cy) = yaw.sin_cos();\\n        let (sp, cp) = pitch.sin_cos();\\n        let dir = (sy * cp, sp, -cy * cp);\\n        let origin = (self.x, self.eye, self.z);\\n        self.shots_tick(origin, dir, st.damage * self.tune.player_damage, st.range, st.noise, st.ignites, st.silent, self.gun().id, self.gun().shots);\\n    }\\n\\n    fn shots_tick(&mut self, origin: (f32, f32, f32), dir: (f32, f32, f32), damage: f32, range: f32, noise: f32, ignites: bool, silent: bool, id: WeaponId, shot_n: u32) {\\n        let mut best_t = range;\\n        let mut best_zone = 0u8;\\n        let mut best_i: Option<usize> = None;\\n        let mut blocked = false;\\n        for w in &self.walls {\\n            if let Some(t) = ray_aabb(origin, dir, w.min, w.max) {\\n                if t < best_t {\\n                    best_t = t;\\n                    blocked = true;\\n                    best_i = None;\\n                }\\n            }\\n        }\\n        if !blocked {\\n            for (i, b) in self.bodies.iter().enumerate() {\\n                if !b.alive {\\n                    continue;\\n                }\\n                let zones = [(1.70, 0.18, 3u8), (1.15, 0.28, 1u8), (0.45, 0.20, 2u8)];\\n                for (y, r, zone) in zones {\\n                    if let Some(t) = ray_sphere(origin, dir, (b.x, y, b.z), r) {\\n                        if t < best_t {\\n                            best_t = t;\\n                            best_zone = zone;\\n                            best_i = Some(i);\\n                        }\\n                    }\\n                }\\n            }\\n        }\\n        let hit_x = origin.0 + dir.0 * best_t;\\n        let hit_z = origin.2 + dir.2 * best_t;\\n        if let Some(i) = best_i {\\n            let mul = match best_zone {\\n                3 => 3.0,\\n                2 => 0.6,\\n                _ => 1.0,\\n            };\\n            let dmg = damage * mul;\\n            let kind = self.bodies[i].kind;\\n            let in_town = geom::in_town(self.bodies[i].x, self.bodies[i].z);\\n            if self.ceasefire && in_town && kind == 2 {\\n                // Civilians are safe while the ceasefire holds.\\n            } else if id == WeaponId::Dart {\\n                self.bodies[i].poison = 3.0;\\n            } else {\\n                self.bodies[i].hp -= dmg;\\n                if ignites && matches!(self.current(), Some(Spec::Ignite(8))) && kind == 1 {\\n                    self.mark(\\\"ignite_person\\\");\\n                }\\n                if self.bodies[i].hp <= 0.0 {\\n                    self.bodies[i].alive = false;\\n                    if kind == 1 && self.stance == 1 && silent {\\n                        self.mark(\\\"stealth_kill\\\");\\n                    }\\n                    if kind == 5 && matches!(self.current(), Some(Spec::Ignite(6))) {\\n                        let bx = self.bodies[i].x;\\n                        let bz = self.bodies[i].z;\\n                        let _ = self.fire.ignite_disk(bx, bz, 5.0, self.tune.burn_time, self.minutes);\\n                        self.mark(\\\"ignite_barrel\\\");\\n                    }\\n                    if matches!(self.current(), Some(Spec::Ceasefire)) {\\n                        self.ceasefire = false;\\n                        self.mark(\\\"ceasefire_ended\\\");\\n                    }\\n                }\\n            }\\n        }\\n        let weapon_lights = ignites\\n            || matches!(id, WeaponId::Flare | WeaponId::Rpg | WeaponId::Flamer | WeaponId::Mortar | WeaponId::Molotov | WeaponId::Frag);\\n        if weapon_lights && self.fire.ignite_at(hit_x, hit_z, self.tune.burn_time, self.minutes) {\\n            self.note_weapon_ignite(id);\\n            if self.finale == Some(0) && matches!(self.current(), Some(Spec::Ending(_))) {\\n                self.mark(\\\"ending_burn\\\");\\n            }\\n        }\\n        if matches!(self.current(), Some(Spec::Ignite(9))) && self.fire.ignite_at(hit_x, hit_z, self.tune.burn_time, self.minutes) {\\n            self.mark(\\\"ignite_lightning\\\");\\n        }\\n        if matches!(self.current(), Some(Spec::Ignite(7))) && self.ride.kind != 0 {\\n            // The round starts at the eye. Score the closest point on that ray, not the far hit.\\n            let rel_x = self.ride.x - origin.0;\\n            let rel_z = self.ride.z - origin.2;\\n            let along = rel_x * dir.0 + rel_z * dir.2;\\n            let t = along.clamp(0.0, best_t);\\n            let cx = origin.0 + dir.0 * t;\\n            let cz = origin.2 + dir.2 * t;\\n            if geom::dist(cx, cz, self.ride.x, self.ride.z) < 4.0 {\\n                self.hurt_vehicle(damage.max(40.0));\\n                if self.ride.stage >= 3 {\\n                    let _ = self.fire.ignite_disk(self.ride.x, self.ride.z, 5.0, self.tune.burn_time, self.minutes);\\n                    self.mark(\\\"ignite_vehicle\\\");\\n                    self.ride.health = 100.0;\\n                    self.ride.stage = 0;\\n                    self.ride.fuse = 0.0;\\n                }\\n            }\\n        }\\n        // Tracers: every third round. The coverage flag is earned on the tracer step.\\n        // Other play still lights grass one time in four, without stamping that flag early.\\n        let tracer_step = matches!(self.current(), Some(Spec::Ignite(10)));\\n        if tracer_step && shot_n > 0 && shot_n % 3 == 0 {\\n            for k in 0..8 {\\n                let ox = hit_x + shot_n as f32 + k as f32 * 3.0;\\n                let oz = hit_z + 6.0 + k as f32 * 2.0;\\n                if self.fire.ignite_at(ox, oz, self.tune.burn_time, self.minutes) {\\n                    self.mark(\\\"ignite_tracer\\\");\\n                    break;\\n                }\\n            }\\n        } else if shot_n > 0 && shot_n % 3 == 0 && self.rng.f32() < 0.25 {\\n            let _ = self.fire.ignite_at(hit_x, hit_z, self.tune.burn_time, self.minutes);\\n        }\\n        if !silent {\\n            for b in &mut self.bodies {\\n                if b.alive && b.alert == 0 && geom::dist(self.x, self.z, b.x, b.z) < noise {\\n                    b.alert = 1;\\n                }\\n            }\\n        }\\n        let _ = noise;\\n    }\\n\\n    fn update_bodies(&mut self, dt: f32) {\\n        let px = self.x;\\n        let pz = self.z;\\n        let stance = self.stance;\\n        let night = self.hour() < 5.0 || self.hour() > 20.0;\\n        let light = if night { 0.45 } else { 1.0 };\\n        let n = self.bodies.len();\\n        let dead_soldiers = self.bodies.iter().filter(|b| b.kind == 1 && !b.alive).count();\\n        let live_soldiers = self.bodies.iter().filter(|b| b.kind == 1 && b.alive).count();\\n        let morale_broken = dead_soldiers >= 2 && live_soldiers > 0 && live_soldiers <= dead_soldiers;\\n        let mut shooters = 0u32;\\n        for i in 0..n {\\n            if !self.bodies[i].alive {\\n                continue;\\n            }\\n            if self.bodies[i].poison > 0.0 {\\n                self.bodies[i].poison -= dt;\\n                if self.bodies[i].poison <= 0.0 && self.bodies[i].hp > 0.0 {\\n                    self.bodies[i].hp = 0.0;\\n                    self.bodies[i].alive = false;\\n                    self.mark(\\\"dart_kill\\\");\\n                    continue;\\n                }\\n            }\\n            if self.bodies[i].kind == 3 {\\n                let d0 = geom::dist(px, pz, self.bodies[i].x, self.bodies[i].z);\\n                if d0 < 40.0 && self.guns.first().map(|g| g.shots > 0).unwrap_or(false) {\\n                    let dx = self.bodies[i].x - px;\\n                    let dz = self.bodies[i].z - pz;\\n                    let len = (dx * dx + dz * dz).sqrt().max(0.1);\\n                    self.bodies[i].x += dx / len * 6.0 * dt;\\n                    self.bodies[i].z += dz / len * 6.0 * dt;\\n                    self.bodies[i].flee += 6.0 * dt;\\n                    if self.bodies[i].flee > 8.0 {\\n                        self.mark(\\\"animals_fled\\\");\\n                    }\\n                }\\n                continue;\\n\",\"total_lines\":2806}}","is_error":false},{"type":"tool_result","tool_use_id":"call-e18fa8ce-cff4-4dce-bfbb-b5c406b0a8f0-13","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"2000→    fn blackout(&mut self) {\\n        let (sx, sz) = geom::nearest_safe(self.x, self.z);\\n        self.x = sx;\\n        self.z = sz;\\n        self.hp = 50.0;\\n        self.diamonds = (self.diamonds as f32 * 0.8).floor() as u32;\\n        self.fever_state = 0;\\n        self.fever_t = 0.0;\\n        self.fever_attack = 0.0;\\n        self.minutes += 6.0 * 60.0;\\n2010→        self.mark(\\\"blackout\\\");\\n    }\\n\\n    fn update_rescue(&mut self, dt: f32) {\\n        if self.hp <= 0.0 && self.rescue_t <= 0.0 && !self.companions.iter().any(|c| c.rescue_spent) {\\n            if let Some(c) = self.companions.iter_mut().find(|c| c.alive && !c.down) {\\n                c.rescue_spent = true;\\n                self.rescue_t = 3.0;\\n                self.hp = 1.0;\\n            }\\n2020→        }\\n        if self.rescue_t > 0.0 {\\n            self.rescue_t -= dt;\\n            let (sy, cy) = self.yaw.sin_cos();\\n            self.x -= sy * dt * 4.0;\\n            self.z -= -cy * dt * 4.0;\\n            if self.rescue_t <= 0.0 {\\n                self.rescue_t = 0.0;\\n                self.hp = 50.0;\\n                self.slot = 0;\\n2030→                self.mark(\\\"player_rescued\\\");\\n            }\\n        }\\n    }\\n\\n    fn special_actions(&mut self, input: &InputFrame, dt: f32) {\\n        let near_cache = geom::dist(self.x, self.z, self.tracker_cache.0, self.tracker_cache.1);\\n        if near_cache < 4.0 {\\n            self.mark(\\\"cache_tracker\\\");\\n        }\\n2040→        if input.down(buttons::INTERACT) {\\n            self.hold_t += dt;\\n        } else {\\n            self.hold_t = 0.0;\\n        }\\n        if input.just(buttons::INTERACT) || (input.down(buttons::INTERACT) && self.hold_t > 0.4) {\\n            self.try_interact();\\n        }\\n        if input.just(buttons::MELEE) {\\n            let crouched = self.stance == 1;\\n2050→            let px = self.x;\\n            let pz = self.z;\\n            let mut stealth = false;\\n            for b in &mut self.bodies {\\n                if b.alive && b.kind == 1 && geom::dist(px, pz, b.x, b.z) < 2.2 {\\n                    b.hp = 0.0;\\n                    b.alive = false;\\n                    if crouched {\\n                        stealth = true;\\n                    }\\n2060→                }\\n            }\\n            if stealth {\\n                self.mark(\\\"stealth_kill\\\");\\n            }\\n        }\\n        // Companion down timer.\\n        for c in &mut self.companions {\\n            if c.down && c.alive {\\n                c.down_t += dt;\\n2070→            }\\n        }\\n        if let Some(i) = self.companions.iter().position(|c| c.down && c.alive && c.down_t > 45.0) {\\n            self.companions[i].alive = false;\\n            self.companions[i].down = false;\\n            self.mark(\\\"companion_died\\\");\\n        }\\n        if input.down(buttons::INTERACT) {\\n            if let Some(c) = self.companions.iter_mut().find(|c| c.down && c.alive && geom::dist(self.x, self.z, c.x, c.z) < 3.0) {\\n                if self.hold_t > 3.0 && self.syrettes > 0 && !c.doomed_enough() {\\n2080→                    // patched below after the borrow... \\n                }\\n            }\\n        }\\n        self.patch_or_dose();\\n        // Scripted igniters that are not shots.\\n        if self.step_ready {\\n            if let Some(spec) = self.current() {\\n                self.script_ignite(spec, input);\\n            }\\n2090→        }\\n    }\\n\\n    fn patch_or_dose(&mut self) {\\n        if self.hold_t < 3.0 || self.syrettes == 0 {\\n            return;\\n        }\\n        let doomed = matches!(self.current(), Some(Spec::Overdose));\\n        let px = self.x;\\n        let pz = self.z;\\n2100→        if let Some(i) = self.companions.iter().position(|c| c.down && c.alive && geom::dist(px, pz, c.x, c.z) < 4.0) {\\n            self.syrettes -= 1;\\n            if doomed {\\n                self.companions[i].alive = false;\\n                self.companions[i].down = false;\\n                self.mark(\\\"companion_overdosed\\\");\\n            } else {\\n                self.companions[i].down = false;\\n                self.companions[i].down_t = 0.0;\\n                self.mark(\\\"companion_patched\\\");\\n2110→            }\\n        }\\n    }\\n\\n    fn script_ignite(&mut self, spec: Spec, _input: &InputFrame) {\\n        match spec {\\n            Spec::Tanks => self.blow_tanks(),\\n            Spec::Ending(_) => {\\n                if self.finale == Some(1) && self.step_t >= 180.0 {\\n                    self.mark(\\\"ending_read\\\");\\n2120→                }\\n            }\\n            Spec::Bus { x, z } => {\\n                let stop = geom::place(\\\"Junction\\\");\\n                if geom::dist(self.x, self.z, stop.0, stop.1) < 14.0 && self.diamonds >= 1 {\\n                    self.diamonds -= 1;\\n                    self.x = x;\\n                    self.z = z;\\n                    self.ride.seat = 0;\\n                    self.ride.x = x;\\n2130→                    self.ride.z = z;\\n                    self.ride.speed = 0.0;\\n                    self.minutes += 20.0;\\n                    self.mark(\\\"bus_taken\\\");\\n                    self.mark(\\\"diamonds_spent\\\");\\n                }\\n            }\\n            _ => {}\\n        }\\n    }\\n2140→\\n    fn try_interact(&mut self) {\\n        if matches!(self.current(), Some(Spec::Ignite(11))) && self.fire.ignite_at(self.x, self.z, self.tune.burn_time, self.minutes) {\\n            self.mark(\\\"ignite_cigarette\\\");\\n        }\\n        if self.finale == Some(2) && matches!(self.current(), Some(Spec::Ending(_))) {\\n            self.mark(\\\"ending_chair\\\");\\n        }\\n        if geom::dist(self.x, self.z, 170.0, 470.0) < 16.0 || geom::dist(self.x, self.z, -260.0, -700.0) < 16.0 || geom::dist(self.x, self.z, 830.0, 255.0) < 16.0\\n        {\\n2150→            if self.hold_t > 0.3 && matches!(self.current(), Some(Spec::Claim)) {\\n                self.mark(\\\"safe_house_claimed\\\");\\n                self.hp = 100.0;\\n            }\\n            if self.hold_t > 0.8 && matches!(self.current(), Some(Spec::Sleep { .. })) {\\n                let hours = match self.current() {\\n                    Some(Spec::Sleep { hours }) => hours,\\n                    _ => 8.0,\\n                };\\n                self.minutes += hours * 60.0;\\n2160→                self.hp = 100.0;\\n                for c in &mut self.companions {\\n                    c.rescue_spent = false;\\n                }\\n                self.yaw = std::f32::consts::PI;\\n                self.looking_at_post = false;\\n                self.mark(\\\"sleep_used\\\");\\n                if hours >= 24.0 && self.post_clear {\\n                    self.post_clear = false;\\n                    self.mark(\\\"post_remanned\\\");\\n2170→                }\\n            }\\n        }\\n        if matches!(self.current(), Some(Spec::Shop)) {\\n            let price = 8u32;\\n            if self.diamonds >= price {\\n                self.diamonds -= price;\\n                self.guns.push(Gun::new(WeaponId::Battle));\\n                self.mark(\\\"weapon_bought\\\");\\n                self.mark(\\\"diamonds_spent\\\");\\n2180→                self.infamy += 1;\\n            }\\n        }\\n        if matches!(self.current(), Some(Spec::Locker)) && self.guns.len() > 1 {\\n            self.slot = self.guns.len() - 1;\\n            self.mark(\\\"locker_used\\\");\\n        }\\n        if matches!(self.current(), Some(Spec::Loot)) && !self.guns.iter().any(|g| g.id == WeaponId::Ar) {\\n            let mut g = Gun::new(WeaponId::Ar);\\n            g.condition = 40.0;\\n2190→            self.guns.push(g);\\n        }\\n        if matches!(self.current(), Some(Spec::Tape)) && self.hold_t > 1.5 {\\n            self.mark(\\\"tape_played\\\");\\n        }\\n        if matches!(self.current(), Some(Spec::Ceasefire)) {\\n            self.ceasefire = false;\\n            self.mark(\\\"ceasefire_ended\\\");\\n        }\\n    }\\n2200→\\n    pub fn try_buy(&mut self) -> bool {\\n        if self.diamonds < 8 {\\n            return false;\\n        }\\n        self.diamonds -= 8;\\n        self.guns.push(Gun::new(WeaponId::Battle));\\n        self.mark(\\\"weapon_bought\\\");\\n        self.mark(\\\"diamonds_spent\\\");\\n        true\\n2210→    }\\n\\n    fn maybe_reman(&mut self) {\\n        if !self.post_clear {\\n            return;\\n        }\\n        let (px, pz) = geom::place(\\\"Kilo 38\\\");\\n        let to_x = px - self.x;\\n        let to_z = pz - self.z;\\n        let (sy, cy) = self.yaw.sin_cos();\\n2220→        let fwd = (sy, -cy);\\n        let len = (to_x * to_x + to_z * to_z).sqrt().max(0.1);\\n        let dot = (fwd.0 * to_x + fwd.1 * to_z) / len;\\n        let dist = geom::dist(self.x, self.z, px, pz);\\n        self.looking_at_post = dot > 0.4 && dist < 180.0;\\n        if self.minutes >= self.post_reman_at && !self.looking_at_post {\\n            self.post_clear = false;\\n            self.mark(\\\"post_remanned\\\");\\n        }\\n    }\\n2230→\\n    fn clear_bodies(&mut self) {\\n        self.bodies.clear();\\n    }\\n\\n    fn spawn_soldier(&mut self, x: f32, z: f32, hp: f32, jammy: bool) {\\n        let mut g = Gun::new(WeaponId::Ar);\\n        if jammy {\\n            g.condition = 5.0;\\n            g.wear = 0.0;\\n2240→            g.ammo = 400;\\n            g.reserve = 400;\\n            // A break roll can win before the jam roll. This set piece is a known bad gun.\\n            g.force_jam = true;\\n        }\\n        self.bodies.push(Body {\\n            kind: 1,\\n            x,\\n            z,\\n            yaw: 0.0,\\n2250→            hp,\\n            alive: true,\\n            alert: if jammy { 2 } else { 0 },\\n            gun: g,\\n            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n2260→    }\\n\\n    fn spawn_animal(&mut self, x: f32, z: f32) {\\n        self.bodies.push(Body {\\n            kind: 3,\\n            x,\\n            z,\\n            yaw: 0.0,\\n            hp: 20.0,\\n            alive: true,\\n2270→            alert: 0,\\n            gun: Gun::new(WeaponId::Pistol),\\n            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n    }\\n\\n2280→    fn spawn_barrel(&mut self, x: f32, z: f32) {\\n        self.bodies.push(Body {\\n            kind: 5,\\n            x,\\n            z,\\n            yaw: 0.0,\\n            hp: 20.0,\\n            alive: true,\\n            alert: 0,\\n            gun: Gun::new(WeaponId::Pistol),\\n2290→            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n    }\\n\\n    fn arm(&mut self, id: WeaponId) {\\n        if let Some(i) = self.guns.iter().position(|g| g.id == id) {\\n2300→            self.slot = i;\\n        } else {\\n            self.guns.push(Gun::new(id));\\n            self.slot = self.guns.len() - 1;\\n        }\\n        let g = self.gun_mut();\\n        g.jammed = false;\\n        g.broken = false;\\n        g.force_jam = false;\\n        g.cooldown = 0.0;\\n2310→        g.condition = 100.0;\\n        let mag = gun::stats(id).mag.max(1);\\n        if g.ammo < mag {\\n            g.ammo = mag;\\n        }\\n    }\\n\\n    fn prep_ignite(&mut self, n: u8) {\\n        match n {\\n            0 => self.arm(WeaponId::Flare),\\n2320→            1 => self.arm(WeaponId::Rpg),\\n            2 => self.arm(WeaponId::Flamer),\\n            3 => self.arm(WeaponId::Mortar),\\n            4 => self.arm(WeaponId::Molotov),\\n            5 => self.arm(WeaponId::Frag),\\n            6 => {\\n                self.arm(WeaponId::Pistol);\\n                let (sy, cy) = self.yaw.sin_cos();\\n                self.spawn_barrel(self.x + sy * 4.0 + 2.0, self.z - cy * 4.0);\\n            }\\n2330→            7 => self.arm(WeaponId::Pistol),\\n            8 => {\\n                self.arm(WeaponId::Flamer);\\n                self.clear_bodies();\\n                let (sy, cy) = self.yaw.sin_cos();\\n                self.spawn_soldier(self.x + sy * 6.0 + 1.0, self.z - cy * 6.0, 40.0, false);\\n            }\\n            9 => {\\n                self.weather = 2;\\n                self.arm(WeaponId::Pistol);\\n2340→            }\\n            10 => self.arm(WeaponId::Pistol),\\n            _ => {}\\n        }\\n    }\\n\\n    fn note_weapon_ignite(&mut self, id: WeaponId) {\\n        let Some(Spec::Ignite(k)) = self.current() else { return };\\n        let flag = match (k, id) {\\n            (0, WeaponId::Flare) => \\\"ignite_flare\\\",\\n2350→            (1, WeaponId::Rpg) => \\\"ignite_rocket\\\",\\n            (2, WeaponId::Flamer) => \\\"ignite_flamer\\\",\\n            (3, WeaponId::Mortar) => \\\"ignite_mortar\\\",\\n            (4, WeaponId::Molotov) => \\\"ignite_molotov\\\",\\n            (5, WeaponId::Frag) => \\\"ignite_frag\\\",\\n            _ => return,\\n        };\\n        self.mark(flag);\\n    }\\n\\n2360→    fn cell_open(&self, x: f32, z: f32) -> bool {\\n        if geom::fuel(x, z) <= 0.0 {\\n            return false;\\n        }\\n        match self.fire.cells.get(&geom::cell_of(x, z)) {\\n            Some(cell) if cell.burning || self.minutes < cell.burnt_until => false,\\n            _ => true,\\n        }\\n    }\\n\\n2370→    /// Nearest 2 m cell that will still take a light. Skips the cell under `x,z` when that one is closed.\\n    fn nearest_open_cell(&self, x: f32, z: f32) -> Option<(f32, f32)> {\\n        let (cx, cz) = geom::cell_of(x, z);\\n        for r in 1i32..36 {\\n            for dz in -r..=r {\\n                for dx in -r..=r {\\n                    if dx.abs() != r && dz.abs() != r {\\n                        continue;\\n                    }\\n                    let (px, pz) = geom::cell_center((cx + dx, cz + dz));\\n2380→                    if self.cell_open(px, pz) {\\n                        return Some((px, pz));\\n                    }\\n                }\\n            }\\n        }\\n        None\\n    }\\n\\n    fn town_burning(&self) -> bool {\\n2390→        self.fire.cells.iter().any(|(c, cell)| {\\n            if !cell.burning {\\n                return false;\\n            }\\n            let (x, z) = geom::cell_center(*c);\\n            geom::in_town(x, z)\\n        })\\n    }\\n\\n    pub fn choose_finale(&mut self, n: u8) {\\n2400→        self.finale = Some(n);\\n        self.screen = Screen::Playing;\\n        self.focus = 0;\\n        self.idle = 0.0;\\n        self.hold_t = 0.0;\\n        match n {\\n            0 => self.arm(WeaponId::Flare),\\n            1 => {\\n                self.clear_bodies();\\n                for i in 0..3 {\\n2410→                    self.spawn_soldier(self.x + 40.0 + i as f32 * 4.0, self.z - 50.0, 30.0, false);\\n                }\\n                self.syrettes = self.syrettes.max(4);\\n            }\\n            _ => {}\\n        }\\n    }\\n\\n    /// Puts the contract on the ledger step and lets the next tick open it.\\n    pub fn present_ending(&mut self) {\\n2420→        if self.route == Route::Sandbox {\\n            self.route = Route::Human;\\n        }\\n        let idx = script(self.route).iter().position(|s| matches!(s, Spec::Ending(_))).unwrap_or(0);\\n        self.step = idx as u16;\\n        self.step_ready = false;\\n        self.finished = false;\\n        self.screen = Screen::Playing;\\n        self.finale = None;\\n        self.x = -760.0;\\n2430→        self.z = 620.0;\\n    }\\n\\n    pub fn dev_teleport(&mut self, label: &str) {\\n        if let Some(p) = geom::PLACES.iter().find(|p| p.name == label) {\\n            self.x = p.x;\\n            self.z = p.z;\\n            self.ride.seat = 0;\\n            self.ride.speed = 0.0;\\n            if self.ride.kind != 0 {\\n2440→                self.ride.x = p.x;\\n                self.ride.z = p.z;\\n            }\\n        }\\n    }\\n\\n    pub fn dev_spawn(&mut self, label: &str) {\\n        let x = self.x + 6.0;\\n        let z = self.z - 4.0;\\n        match label {\\n2450→            \\\"Soldier\\\" => self.spawn_soldier(x, z, 40.0, false),\\n            \\\"Animal\\\" => self.spawn_animal(x, z),\\n            \\\"Truck\\\" => self.spawn_truck(x, z),\\n            \\\"Technical\\\" => {\\n                self.ride.kind = 1;\\n                self.ride.seat = 0;\\n                self.ride.x = x;\\n                self.ride.z = z;\\n                self.ride.health = 100.0;\\n                self.ride.stage = 0;\\n2460→                self.ride.speed = 0.0;\\n            }\\n            \\\"Boat\\\" => {\\n                self.ride.kind = 2;\\n                self.ride.seat = 0;\\n                self.ride.x = x;\\n                self.ride.z = z;\\n                self.ride.health = 100.0;\\n                self.ride.stage = 0;\\n                self.ride.speed = 0.0;\\n2470→            }\\n            \\\"Barrel\\\" => self.spawn_barrel(x, z),\\n            _ => {}\\n        }\\n    }\\n\\n    pub fn dev_world(&mut self, label: &str) {\\n        match label {\\n            \\\"Night\\\" => self.minutes = 22.0 * 60.0,\\n            \\\"Noon\\\" => self.minutes = 12.0 * 60.0,\\n2480→            \\\"Rain\\\" => self.weather = 1,\\n            \\\"Clear sky\\\" => self.weather = 0,\\n            \\\"Strong wind\\\" => self.wind = Vec2::new(9.0, 0.0),\\n            \\\"Calm\\\" => self.wind = Vec2::new(0.2, 0.0),\\n            \\\"Ignite grass\\\" => {\\n                let _ = self.fire.ignite_at(self.x + 8.0, self.z + 8.0, self.tune.burn_time, self.minutes);\\n            }\\n            _ => {}\\n        }\\n    }\\n2490→\\n    fn spawn_truck(&mut self, x: f32, z: f32) {\\n        self.bodies.push(Body {\\n            kind: 6,\\n            x,\\n            z,\\n            yaw: 0.0,\\n            hp: 80.0,\\n            alive: true,\\n            alert: 0,\\n2500→            gun: Gun::new(WeaponId::Pistol),\\n            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n    }\\n\\n    fn spawn_tank_farm(&mut self) {\\n2510→        self.clear_bodies();\\n        for i in 0..7 {\\n            for j in 0..7 {\\n                self.bodies.push(Body {\\n                    kind: 5,\\n                    x: self.x + i as f32 * 10.0,\\n                    z: self.z + j as f32 * 10.0 - 20.0,\\n                    yaw: 0.0,\\n                    hp: 20.0,\\n                    alive: true,\\n2520→                    alert: 0,\\n                    gun: Gun::new(WeaponId::Pistol),\\n                    see: 0.0,\\n                    poison: 0.0,\\n                    burn: 0.0,\\n                    doomed: false,\\n                    flee: 0.0,\\n                });\\n            }\\n        }\\n2530→    }\\n\\n    fn blow_tanks(&mut self) {\\n        if self.bodies.iter().any(|b| b.kind == 5 && b.alive) {\\n            let positions: Vec<(f32, f32)> = self.bodies.iter().filter(|b| b.kind == 5).map(|b| (b.x, b.z)).collect();\\n            for b in &mut self.bodies {\\n                if b.kind == 5 {\\n                    b.hp = 0.0;\\n                    b.alive = false;\\n                }\\n2540→            }\\n            for (x, z) in positions {\\n                let _ = self.fire.ignite_disk(x, z, 6.0, self.tune.burn_time, self.minutes);\\n            }\\n            self.mark(\\\"explosion_chain\\\");\\n            if self.fire.burned >= 500 {\\n                self.mark(\\\"cells_500\\\");\\n            }\\n        }\\n    }\",\"content_concise\":\"2000→    fn blackout(&mut self) {\\n        let (sx, sz) = geom::nearest_safe(self.x, self.z);\\n        self.x = sx;\\n        self.z = sz;\\n        self.hp = 50.0;\\n        self.diamonds = (self.diamonds as f32 * 0.8).floor() as u32;\\n        self.fever_state = 0;\\n        self.fever_t = 0.0;\\n        self.fever_attack = 0.0;\\n        self.minutes += 6.0 * 60.0;\\n2010→        self.mark(\\\"blackout\\\");\\n    }\\n\\n    fn update_rescue(&mut self, dt: f32) {\\n        if self.hp <= 0.0 && self.rescue_t <= 0.0 && !self.companions.iter().any(|c| c.rescue_spent) {\\n            if let Some(c) = self.companions.iter_mut().find(|c| c.alive && !c.down) {\\n                c.rescue_spent = true;\\n                self.rescue_t = 3.0;\\n                self.hp = 1.0;\\n            }\\n2020→        }\\n        if self.rescue_t > 0.0 {\\n            self.rescue_t -= dt;\\n            let (sy, cy) = self.yaw.sin_cos();\\n            self.x -= sy * dt * 4.0;\\n            self.z -= -cy * dt * 4.0;\\n            if self.rescue_t <= 0.0 {\\n                self.rescue_t = 0.0;\\n                self.hp = 50.0;\\n                self.slot = 0;\\n2030→                self.mark(\\\"player_rescued\\\");\\n            }\\n        }\\n    }\\n\\n    fn special_actions(&mut self, input: &InputFrame, dt: f32) {\\n        let near_cache = geom::dist(self.x, self.z, self.tracker_cache.0, self.tracker_cache.1);\\n        if near_cache < 4.0 {\\n            self.mark(\\\"cache_tracker\\\");\\n        }\\n2040→        if input.down(buttons::INTERACT) {\\n            self.hold_t += dt;\\n        } else {\\n            self.hold_t = 0.0;\\n        }\\n        if input.just(buttons::INTERACT) || (input.down(buttons::INTERACT) && self.hold_t > 0.4) {\\n            self.try_interact();\\n        }\\n        if input.just(buttons::MELEE) {\\n            let crouched = self.stance == 1;\\n2050→            let px = self.x;\\n            let pz = self.z;\\n            let mut stealth = false;\\n            for b in &mut self.bodies {\\n                if b.alive && b.kind == 1 && geom::dist(px, pz, b.x, b.z) < 2.2 {\\n                    b.hp = 0.0;\\n                    b.alive = false;\\n                    if crouched {\\n                        stealth = true;\\n                    }\\n2060→                }\\n            }\\n            if stealth {\\n                self.mark(\\\"stealth_kill\\\");\\n            }\\n        }\\n        // Companion down timer.\\n        for c in &mut self.companions {\\n            if c.down && c.alive {\\n                c.down_t += dt;\\n2070→            }\\n        }\\n        if let Some(i) = self.companions.iter().position(|c| c.down && c.alive && c.down_t > 45.0) {\\n            self.companions[i].alive = false;\\n            self.companions[i].down = false;\\n            self.mark(\\\"companion_died\\\");\\n        }\\n        if input.down(buttons::INTERACT) {\\n            if let Some(c) = self.companions.iter_mut().find(|c| c.down && c.alive && geom::dist(self.x, self.z, c.x, c.z) < 3.0) {\\n                if self.hold_t > 3.0 && self.syrettes > 0 && !c.doomed_enough() {\\n2080→                    // patched below after the borrow... \\n                }\\n            }\\n        }\\n        self.patch_or_dose();\\n        // Scripted igniters that are not shots.\\n        if self.step_ready {\\n            if let Some(spec) = self.current() {\\n                self.script_ignite(spec, input);\\n            }\\n2090→        }\\n    }\\n\\n    fn patch_or_dose(&mut self) {\\n        if self.hold_t < 3.0 || self.syrettes == 0 {\\n            return;\\n        }\\n        let doomed = matches!(self.current(), Some(Spec::Overdose));\\n        let px = self.x;\\n        let pz = self.z;\\n2100→        if let Some(i) = self.companions.iter().position(|c| c.down && c.alive && geom::dist(px, pz, c.x, c.z) < 4.0) {\\n            self.syrettes -= 1;\\n            if doomed {\\n                self.companions[i].alive = false;\\n                self.companions[i].down = false;\\n                self.mark(\\\"companion_overdosed\\\");\\n            } else {\\n                self.companions[i].down = false;\\n                self.companions[i].down_t = 0.0;\\n                self.mark(\\\"companion_patched\\\");\\n2110→            }\\n        }\\n    }\\n\\n    fn script_ignite(&mut self, spec: Spec, _input: &InputFrame) {\\n        match spec {\\n            Spec::Tanks => self.blow_tanks(),\\n            Spec::Ending(_) => {\\n                if self.finale == Some(1) && self.step_t >= 180.0 {\\n                    self.mark(\\\"ending_read\\\");\\n2120→                }\\n            }\\n            Spec::Bus { x, z } => {\\n                let stop = geom::place(\\\"Junction\\\");\\n                if geom::dist(self.x, self.z, stop.0, stop.1) < 14.0 && self.diamonds >= 1 {\\n                    self.diamonds -= 1;\\n                    self.x = x;\\n                    self.z = z;\\n                    self.ride.seat = 0;\\n                    self.ride.x = x;\\n2130→                    self.ride.z = z;\\n                    self.ride.speed = 0.0;\\n                    self.minutes += 20.0;\\n                    self.mark(\\\"bus_taken\\\");\\n                    self.mark(\\\"diamonds_spent\\\");\\n                }\\n            }\\n            _ => {}\\n        }\\n    }\\n2140→\\n    fn try_interact(&mut self) {\\n        if matches!(self.current(), Some(Spec::Ignite(11))) && self.fire.ignite_at(self.x, self.z, self.tune.burn_time, self.minutes) {\\n            self.mark(\\\"ignite_cigarette\\\");\\n        }\\n        if self.finale == Some(2) && matches!(self.current(), Some(Spec::Ending(_))) {\\n            self.mark(\\\"ending_chair\\\");\\n        }\\n        if geom::dist(self.x, self.z, 170.0, 470.0) < 16.0 || geom::dist(self.x, self.z, -260.0, -700.0) < 16.0 || geom::dist(self.x, self.z, 830.0, 255.0) < 16.0\\n        {\\n2150→            if self.hold_t > 0.3 && matches!(self.current(), Some(Spec::Claim)) {\\n                self.mark(\\\"safe_house_claimed\\\");\\n                self.hp = 100.0;\\n            }\\n            if self.hold_t > 0.8 && matches!(self.current(), Some(Spec::Sleep { .. })) {\\n                let hours = match self.current() {\\n                    Some(Spec::Sleep { hours }) => hours,\\n                    _ => 8.0,\\n                };\\n                self.minutes += hours * 60.0;\\n2160→                self.hp = 100.0;\\n                for c in &mut self.companions {\\n                    c.rescue_spent = false;\\n                }\\n                self.yaw = std::f32::consts::PI;\\n                self.looking_at_post = false;\\n                self.mark(\\\"sleep_used\\\");\\n                if hours >= 24.0 && self.post_clear {\\n                    self.post_clear = false;\\n                    self.mark(\\\"post_remanned\\\");\\n2170→                }\\n            }\\n        }\\n        if matches!(self.current(), Some(Spec::Shop)) {\\n            let price = 8u32;\\n            if self.diamonds >= price {\\n                self.diamonds -= price;\\n                self.guns.push(Gun::new(WeaponId::Battle));\\n                self.mark(\\\"weapon_bought\\\");\\n                self.mark(\\\"diamonds_spent\\\");\\n2180→                self.infamy += 1;\\n            }\\n        }\\n        if matches!(self.current(), Some(Spec::Locker)) && self.guns.len() > 1 {\\n            self.slot = self.guns.len() - 1;\\n            self.mark(\\\"locker_used\\\");\\n        }\\n        if matches!(self.current(), Some(Spec::Loot)) && !self.guns.iter().any(|g| g.id == WeaponId::Ar) {\\n            let mut g = Gun::new(WeaponId::Ar);\\n            g.condition = 40.0;\\n2190→            self.guns.push(g);\\n        }\\n        if matches!(self.current(), Some(Spec::Tape)) && self.hold_t > 1.5 {\\n            self.mark(\\\"tape_played\\\");\\n        }\\n        if matches!(self.current(), Some(Spec::Ceasefire)) {\\n            self.ceasefire = false;\\n            self.mark(\\\"ceasefire_ended\\\");\\n        }\\n    }\\n2200→\\n    pub fn try_buy(&mut self) -> bool {\\n        if self.diamonds < 8 {\\n            return false;\\n        }\\n        self.diamonds -= 8;\\n        self.guns.push(Gun::new(WeaponId::Battle));\\n        self.mark(\\\"weapon_bought\\\");\\n        self.mark(\\\"diamonds_spent\\\");\\n        true\\n2210→    }\\n\\n    fn maybe_reman(&mut self) {\\n        if !self.post_clear {\\n            return;\\n        }\\n        let (px, pz) = geom::place(\\\"Kilo 38\\\");\\n        let to_x = px - self.x;\\n        let to_z = pz - self.z;\\n        let (sy, cy) = self.yaw.sin_cos();\\n2220→        let fwd = (sy, -cy);\\n        let len = (to_x * to_x + to_z * to_z).sqrt().max(0.1);\\n        let dot = (fwd.0 * to_x + fwd.1 * to_z) / len;\\n        let dist = geom::dist(self.x, self.z, px, pz);\\n        self.looking_at_post = dot > 0.4 && dist < 180.0;\\n        if self.minutes >= self.post_reman_at && !self.looking_at_post {\\n            self.post_clear = false;\\n            self.mark(\\\"post_remanned\\\");\\n        }\\n    }\\n2230→\\n    fn clear_bodies(&mut self) {\\n        self.bodies.clear();\\n    }\\n\\n    fn spawn_soldier(&mut self, x: f32, z: f32, hp: f32, jammy: bool) {\\n        let mut g = Gun::new(WeaponId::Ar);\\n        if jammy {\\n            g.condition = 5.0;\\n            g.wear = 0.0;\\n2240→            g.ammo = 400;\\n            g.reserve = 400;\\n            // A break roll can win before the jam roll. This set piece is a known bad gun.\\n            g.force_jam = true;\\n        }\\n        self.bodies.push(Body {\\n            kind: 1,\\n            x,\\n            z,\\n            yaw: 0.0,\\n2250→            hp,\\n            alive: true,\\n            alert: if jammy { 2 } else { 0 },\\n            gun: g,\\n            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n2260→    }\\n\\n    fn spawn_animal(&mut self, x: f32, z: f32) {\\n        self.bodies.push(Body {\\n            kind: 3,\\n            x,\\n            z,\\n            yaw: 0.0,\\n            hp: 20.0,\\n            alive: true,\\n2270→            alert: 0,\\n            gun: Gun::new(WeaponId::Pistol),\\n            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n    }\\n\\n2280→    fn spawn_barrel(&mut self, x: f32, z: f32) {\\n        self.bodies.push(Body {\\n            kind: 5,\\n            x,\\n            z,\\n            yaw: 0.0,\\n            hp: 20.0,\\n            alive: true,\\n            alert: 0,\\n            gun: Gun::new(WeaponId::Pistol),\\n2290→            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n    }\\n\\n    fn arm(&mut self, id: WeaponId) {\\n        if let Some(i) = self.guns.iter().position(|g| g.id == id) {\\n2300→            self.slot = i;\\n        } else {\\n            self.guns.push(Gun::new(id));\\n            self.slot = self.guns.len() - 1;\\n        }\\n        let g = self.gun_mut();\\n        g.jammed = false;\\n        g.broken = false;\\n        g.force_jam = false;\\n        g.cooldown = 0.0;\\n2310→        g.condition = 100.0;\\n        let mag = gun::stats(id).mag.max(1);\\n        if g.ammo < mag {\\n            g.ammo = mag;\\n        }\\n    }\\n\\n    fn prep_ignite(&mut self, n: u8) {\\n        match n {\\n            0 => self.arm(WeaponId::Flare),\\n2320→            1 => self.arm(WeaponId::Rpg),\\n            2 => self.arm(WeaponId::Flamer),\\n            3 => self.arm(WeaponId::Mortar),\\n            4 => self.arm(WeaponId::Molotov),\\n            5 => self.arm(WeaponId::Frag),\\n            6 => {\\n                self.arm(WeaponId::Pistol);\\n                let (sy, cy) = self.yaw.sin_cos();\\n                self.spawn_barrel(self.x + sy * 4.0 + 2.0, self.z - cy * 4.0);\\n            }\\n2330→            7 => self.arm(WeaponId::Pistol),\\n            8 => {\\n                self.arm(WeaponId::Flamer);\\n                self.clear_bodies();\\n                let (sy, cy) = self.yaw.sin_cos();\\n                self.spawn_soldier(self.x + sy * 6.0 + 1.0, self.z - cy * 6.0, 40.0, false);\\n            }\\n            9 => {\\n                self.weather = 2;\\n                self.arm(WeaponId::Pistol);\\n2340→            }\\n            10 => self.arm(WeaponId::Pistol),\\n            _ => {}\\n        }\\n    }\\n\\n    fn note_weapon_ignite(&mut self, id: WeaponId) {\\n        let Some(Spec::Ignite(k)) = self.current() else { return };\\n        let flag = match (k, id) {\\n            (0, WeaponId::Flare) => \\\"ignite_flare\\\",\\n2350→            (1, WeaponId::Rpg) => \\\"ignite_rocket\\\",\\n            (2, WeaponId::Flamer) => \\\"ignite_flamer\\\",\\n            (3, WeaponId::Mortar) => \\\"ignite_mortar\\\",\\n            (4, WeaponId::Molotov) => \\\"ignite_molotov\\\",\\n            (5, WeaponId::Frag) => \\\"ignite_frag\\\",\\n            _ => return,\\n        };\\n        self.mark(flag);\\n    }\\n\\n2360→    fn cell_open(&self, x: f32, z: f32) -> bool {\\n        if geom::fuel(x, z) <= 0.0 {\\n            return false;\\n        }\\n        match self.fire.cells.get(&geom::cell_of(x, z)) {\\n            Some(cell) if cell.burning || self.minutes < cell.burnt_until => false,\\n            _ => true,\\n        }\\n    }\\n\\n2370→    /// Nearest 2 m cell that will still take a light. Skips the cell under `x,z` when that one is closed.\\n    fn nearest_open_cell(&self, x: f32, z: f32) -> Option<(f32, f32)> {\\n        let (cx, cz) = geom::cell_of(x, z);\\n        for r in 1i32..36 {\\n            for dz in -r..=r {\\n                for dx in -r..=r {\\n                    if dx.abs() != r && dz.abs() != r {\\n                        continue;\\n                    }\\n                    let (px, pz) = geom::cell_center((cx + dx, cz + dz));\\n2380→                    if self.cell_open(px, pz) {\\n                        return Some((px, pz));\\n                    }\\n                }\\n            }\\n        }\\n        None\\n    }\\n\\n    fn town_burning(&self) -> bool {\\n2390→        self.fire.cells.iter().any(|(c, cell)| {\\n            if !cell.burning {\\n                return false;\\n            }\\n            let (x, z) = geom::cell_center(*c);\\n            geom::in_town(x, z)\\n        })\\n    }\\n\\n    pub fn choose_finale(&mut self, n: u8) {\\n2400→        self.finale = Some(n);\\n        self.screen = Screen::Playing;\\n        self.focus = 0;\\n        self.idle = 0.0;\\n        self.hold_t = 0.0;\\n        match n {\\n            0 => self.arm(WeaponId::Flare),\\n            1 => {\\n                self.clear_bodies();\\n                for i in 0..3 {\\n2410→                    self.spawn_soldier(self.x + 40.0 + i as f32 * 4.0, self.z - 50.0, 30.0, false);\\n                }\\n                self.syrettes = self.syrettes.max(4);\\n            }\\n            _ => {}\\n        }\\n    }\\n\\n    /// Puts the contract on the ledger step and lets the next tick open it.\\n    pub fn present_ending(&mut self) {\\n2420→        if self.route == Route::Sandbox {\\n            self.route = Route::Human;\\n        }\\n        let idx = script(self.route).iter().position(|s| matches!(s, Spec::Ending(_))).unwrap_or(0);\\n        self.step = idx as u16;\\n        self.step_ready = false;\\n        self.finished = false;\\n        self.screen = Screen::Playing;\\n        self.finale = None;\\n        self.x = -760.0;\\n2430→        self.z = 620.0;\\n    }\\n\\n    pub fn dev_teleport(&mut self, label: &str) {\\n        if let Some(p) = geom::PLACES.iter().find(|p| p.name == label) {\\n            self.x = p.x;\\n            self.z = p.z;\\n            self.ride.seat = 0;\\n            self.ride.speed = 0.0;\\n            if self.ride.kind != 0 {\\n2440→                self.ride.x = p.x;\\n                self.ride.z = p.z;\\n            }\\n        }\\n    }\\n\\n    pub fn dev_spawn(&mut self, label: &str) {\\n        let x = self.x + 6.0;\\n        let z = self.z - 4.0;\\n        match label {\\n2450→            \\\"Soldier\\\" => self.spawn_soldier(x, z, 40.0, false),\\n            \\\"Animal\\\" => self.spawn_animal(x, z),\\n            \\\"Truck\\\" => self.spawn_truck(x, z),\\n            \\\"Technical\\\" => {\\n                self.ride.kind = 1;\\n                self.ride.seat = 0;\\n                self.ride.x = x;\\n                self.ride.z = z;\\n                self.ride.health = 100.0;\\n                self.ride.stage = 0;\\n2460→                self.ride.speed = 0.0;\\n            }\\n            \\\"Boat\\\" => {\\n                self.ride.kind = 2;\\n                self.ride.seat = 0;\\n                self.ride.x = x;\\n                self.ride.z = z;\\n                self.ride.health = 100.0;\\n                self.ride.stage = 0;\\n                self.ride.speed = 0.0;\\n2470→            }\\n            \\\"Barrel\\\" => self.spawn_barrel(x, z),\\n            _ => {}\\n        }\\n    }\\n\\n    pub fn dev_world(&mut self, label: &str) {\\n        match label {\\n            \\\"Night\\\" => self.minutes = 22.0 * 60.0,\\n            \\\"Noon\\\" => self.minutes = 12.0 * 60.0,\\n2480→            \\\"Rain\\\" => self.weather = 1,\\n            \\\"Clear sky\\\" => self.weather = 0,\\n            \\\"Strong wind\\\" => self.wind = Vec2::new(9.0, 0.0),\\n            \\\"Calm\\\" => self.wind = Vec2::new(0.2, 0.0),\\n            \\\"Ignite grass\\\" => {\\n                let _ = self.fire.ignite_at(self.x + 8.0, self.z + 8.0, self.tune.burn_time, self.minutes);\\n            }\\n            _ => {}\\n        }\\n    }\\n2490→\\n    fn spawn_truck(&mut self, x: f32, z: f32) {\\n        self.bodies.push(Body {\\n            kind: 6,\\n            x,\\n            z,\\n            yaw: 0.0,\\n            hp: 80.0,\\n            alive: true,\\n            alert: 0,\\n2500→            gun: Gun::new(WeaponId::Pistol),\\n            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n    }\\n\\n    fn spawn_tank_farm(&mut self) {\\n2510→        self.clear_bodies();\\n        for i in 0..7 {\\n            for j in 0..7 {\\n                self.bodies.push(Body {\\n                    kind: 5,\\n                    x: self.x + i as f32 * 10.0,\\n                    z: self.z + j as f32 * 10.0 - 20.0,\\n                    yaw: 0.0,\\n                    hp: 20.0,\\n                    alive: true,\\n2520→                    alert: 0,\\n                    gun: Gun::new(WeaponId::Pistol),\\n                    see: 0.0,\\n                    poison: 0.0,\\n                    burn: 0.0,\\n                    doomed: false,\\n                    flee: 0.0,\\n                });\\n            }\\n        }\\n2530→    }\\n\\n    fn blow_tanks(&mut self) {\\n        if self.bodies.iter().any(|b| b.kind == 5 && b.alive) {\\n            let positions: Vec<(f32, f32)> = self.bodies.iter().filter(|b| b.kind == 5).map(|b| (b.x, b.z)).collect();\\n            for b in &mut self.bodies {\\n                if b.kind == 5 {\\n                    b.hp = 0.0;\\n                    b.alive = false;\\n                }\\n2540→            }\\n            for (x, z) in positions {\\n                let _ = self.fire.ignite_disk(x, z, 6.0, self.tune.burn_time, self.minutes);\\n            }\\n            self.mark(\\\"explosion_chain\\\");\\n            if self.fire.burned >= 500 {\\n                self.mark(\\\"cells_500\\\");\\n            }\\n        }\\n    }\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs\",\"offset\":2000,\"limit\":550,\"raw_output\":\"    fn blackout(&mut self) {\\n        let (sx, sz) = geom::nearest_safe(self.x, self.z);\\n        self.x = sx;\\n        self.z = sz;\\n        self.hp = 50.0;\\n        self.diamonds = (self.diamonds as f32 * 0.8).floor() as u32;\\n        self.fever_state = 0;\\n        self.fever_t = 0.0;\\n        self.fever_attack = 0.0;\\n        self.minutes += 6.0 * 60.0;\\n        self.mark(\\\"blackout\\\");\\n    }\\n\\n    fn update_rescue(&mut self, dt: f32) {\\n        if self.hp <= 0.0 && self.rescue_t <= 0.0 && !self.companions.iter().any(|c| c.rescue_spent) {\\n            if let Some(c) = self.companions.iter_mut().find(|c| c.alive && !c.down) {\\n                c.rescue_spent = true;\\n                self.rescue_t = 3.0;\\n                self.hp = 1.0;\\n            }\\n        }\\n        if self.rescue_t > 0.0 {\\n            self.rescue_t -= dt;\\n            let (sy, cy) = self.yaw.sin_cos();\\n            self.x -= sy * dt * 4.0;\\n            self.z -= -cy * dt * 4.0;\\n            if self.rescue_t <= 0.0 {\\n                self.rescue_t = 0.0;\\n                self.hp = 50.0;\\n                self.slot = 0;\\n                self.mark(\\\"player_rescued\\\");\\n            }\\n        }\\n    }\\n\\n    fn special_actions(&mut self, input: &InputFrame, dt: f32) {\\n        let near_cache = geom::dist(self.x, self.z, self.tracker_cache.0, self.tracker_cache.1);\\n        if near_cache < 4.0 {\\n            self.mark(\\\"cache_tracker\\\");\\n        }\\n        if input.down(buttons::INTERACT) {\\n            self.hold_t += dt;\\n        } else {\\n            self.hold_t = 0.0;\\n        }\\n        if input.just(buttons::INTERACT) || (input.down(buttons::INTERACT) && self.hold_t > 0.4) {\\n            self.try_interact();\\n        }\\n        if input.just(buttons::MELEE) {\\n            let crouched = self.stance == 1;\\n            let px = self.x;\\n            let pz = self.z;\\n            let mut stealth = false;\\n            for b in &mut self.bodies {\\n                if b.alive && b.kind == 1 && geom::dist(px, pz, b.x, b.z) < 2.2 {\\n                    b.hp = 0.0;\\n                    b.alive = false;\\n                    if crouched {\\n                        stealth = true;\\n                    }\\n                }\\n            }\\n            if stealth {\\n                self.mark(\\\"stealth_kill\\\");\\n            }\\n        }\\n        // Companion down timer.\\n        for c in &mut self.companions {\\n            if c.down && c.alive {\\n                c.down_t += dt;\\n            }\\n        }\\n        if let Some(i) = self.companions.iter().position(|c| c.down && c.alive && c.down_t > 45.0) {\\n            self.companions[i].alive = false;\\n            self.companions[i].down = false;\\n            self.mark(\\\"companion_died\\\");\\n        }\\n        if input.down(buttons::INTERACT) {\\n            if let Some(c) = self.companions.iter_mut().find(|c| c.down && c.alive && geom::dist(self.x, self.z, c.x, c.z) < 3.0) {\\n                if self.hold_t > 3.0 && self.syrettes > 0 && !c.doomed_enough() {\\n                    // patched below after the borrow... \\n                }\\n            }\\n        }\\n        self.patch_or_dose();\\n        // Scripted igniters that are not shots.\\n        if self.step_ready {\\n            if let Some(spec) = self.current() {\\n                self.script_ignite(spec, input);\\n            }\\n        }\\n    }\\n\\n    fn patch_or_dose(&mut self) {\\n        if self.hold_t < 3.0 || self.syrettes == 0 {\\n            return;\\n        }\\n        let doomed = matches!(self.current(), Some(Spec::Overdose));\\n        let px = self.x;\\n        let pz = self.z;\\n        if let Some(i) = self.companions.iter().position(|c| c.down && c.alive && geom::dist(px, pz, c.x, c.z) < 4.0) {\\n            self.syrettes -= 1;\\n            if doomed {\\n                self.companions[i].alive = false;\\n                self.companions[i].down = false;\\n                self.mark(\\\"companion_overdosed\\\");\\n            } else {\\n                self.companions[i].down = false;\\n                self.companions[i].down_t = 0.0;\\n                self.mark(\\\"companion_patched\\\");\\n            }\\n        }\\n    }\\n\\n    fn script_ignite(&mut self, spec: Spec, _input: &InputFrame) {\\n        match spec {\\n            Spec::Tanks => self.blow_tanks(),\\n            Spec::Ending(_) => {\\n                if self.finale == Some(1) && self.step_t >= 180.0 {\\n                    self.mark(\\\"ending_read\\\");\\n                }\\n            }\\n            Spec::Bus { x, z } => {\\n                let stop = geom::place(\\\"Junction\\\");\\n                if geom::dist(self.x, self.z, stop.0, stop.1) < 14.0 && self.diamonds >= 1 {\\n                    self.diamonds -= 1;\\n                    self.x = x;\\n                    self.z = z;\\n                    self.ride.seat = 0;\\n                    self.ride.x = x;\\n                    self.ride.z = z;\\n                    self.ride.speed = 0.0;\\n                    self.minutes += 20.0;\\n                    self.mark(\\\"bus_taken\\\");\\n                    self.mark(\\\"diamonds_spent\\\");\\n                }\\n            }\\n            _ => {}\\n        }\\n    }\\n\\n    fn try_interact(&mut self) {\\n        if matches!(self.current(), Some(Spec::Ignite(11))) && self.fire.ignite_at(self.x, self.z, self.tune.burn_time, self.minutes) {\\n            self.mark(\\\"ignite_cigarette\\\");\\n        }\\n        if self.finale == Some(2) && matches!(self.current(), Some(Spec::Ending(_))) {\\n            self.mark(\\\"ending_chair\\\");\\n        }\\n        if geom::dist(self.x, self.z, 170.0, 470.0) < 16.0 || geom::dist(self.x, self.z, -260.0, -700.0) < 16.0 || geom::dist(self.x, self.z, 830.0, 255.0) < 16.0\\n        {\\n            if self.hold_t > 0.3 && matches!(self.current(), Some(Spec::Claim)) {\\n                self.mark(\\\"safe_house_claimed\\\");\\n                self.hp = 100.0;\\n            }\\n            if self.hold_t > 0.8 && matches!(self.current(), Some(Spec::Sleep { .. })) {\\n                let hours = match self.current() {\\n                    Some(Spec::Sleep { hours }) => hours,\\n                    _ => 8.0,\\n                };\\n                self.minutes += hours * 60.0;\\n                self.hp = 100.0;\\n                for c in &mut self.companions {\\n                    c.rescue_spent = false;\\n                }\\n                self.yaw = std::f32::consts::PI;\\n                self.looking_at_post = false;\\n                self.mark(\\\"sleep_used\\\");\\n                if hours >= 24.0 && self.post_clear {\\n                    self.post_clear = false;\\n                    self.mark(\\\"post_remanned\\\");\\n                }\\n            }\\n        }\\n        if matches!(self.current(), Some(Spec::Shop)) {\\n            let price = 8u32;\\n            if self.diamonds >= price {\\n                self.diamonds -= price;\\n                self.guns.push(Gun::new(WeaponId::Battle));\\n                self.mark(\\\"weapon_bought\\\");\\n                self.mark(\\\"diamonds_spent\\\");\\n                self.infamy += 1;\\n            }\\n        }\\n        if matches!(self.current(), Some(Spec::Locker)) && self.guns.len() > 1 {\\n            self.slot = self.guns.len() - 1;\\n            self.mark(\\\"locker_used\\\");\\n        }\\n        if matches!(self.current(), Some(Spec::Loot)) && !self.guns.iter().any(|g| g.id == WeaponId::Ar) {\\n            let mut g = Gun::new(WeaponId::Ar);\\n            g.condition = 40.0;\\n            self.guns.push(g);\\n        }\\n        if matches!(self.current(), Some(Spec::Tape)) && self.hold_t > 1.5 {\\n            self.mark(\\\"tape_played\\\");\\n        }\\n        if matches!(self.current(), Some(Spec::Ceasefire)) {\\n            self.ceasefire = false;\\n            self.mark(\\\"ceasefire_ended\\\");\\n        }\\n    }\\n\\n    pub fn try_buy(&mut self) -> bool {\\n        if self.diamonds < 8 {\\n            return false;\\n        }\\n        self.diamonds -= 8;\\n        self.guns.push(Gun::new(WeaponId::Battle));\\n        self.mark(\\\"weapon_bought\\\");\\n        self.mark(\\\"diamonds_spent\\\");\\n        true\\n    }\\n\\n    fn maybe_reman(&mut self) {\\n        if !self.post_clear {\\n            return;\\n        }\\n        let (px, pz) = geom::place(\\\"Kilo 38\\\");\\n        let to_x = px - self.x;\\n        let to_z = pz - self.z;\\n        let (sy, cy) = self.yaw.sin_cos();\\n        let fwd = (sy, -cy);\\n        let len = (to_x * to_x + to_z * to_z).sqrt().max(0.1);\\n        let dot = (fwd.0 * to_x + fwd.1 * to_z) / len;\\n        let dist = geom::dist(self.x, self.z, px, pz);\\n        self.looking_at_post = dot > 0.4 && dist < 180.0;\\n        if self.minutes >= self.post_reman_at && !self.looking_at_post {\\n            self.post_clear = false;\\n            self.mark(\\\"post_remanned\\\");\\n        }\\n    }\\n\\n    fn clear_bodies(&mut self) {\\n        self.bodies.clear();\\n    }\\n\\n    fn spawn_soldier(&mut self, x: f32, z: f32, hp: f32, jammy: bool) {\\n        let mut g = Gun::new(WeaponId::Ar);\\n        if jammy {\\n            g.condition = 5.0;\\n            g.wear = 0.0;\\n            g.ammo = 400;\\n            g.reserve = 400;\\n            // A break roll can win before the jam roll. This set piece is a known bad gun.\\n            g.force_jam = true;\\n        }\\n        self.bodies.push(Body {\\n            kind: 1,\\n            x,\\n            z,\\n            yaw: 0.0,\\n            hp,\\n            alive: true,\\n            alert: if jammy { 2 } else { 0 },\\n            gun: g,\\n            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n    }\\n\\n    fn spawn_animal(&mut self, x: f32, z: f32) {\\n        self.bodies.push(Body {\\n            kind: 3,\\n            x,\\n            z,\\n            yaw: 0.0,\\n            hp: 20.0,\\n            alive: true,\\n            alert: 0,\\n            gun: Gun::new(WeaponId::Pistol),\\n            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n    }\\n\\n    fn spawn_barrel(&mut self, x: f32, z: f32) {\\n        self.bodies.push(Body {\\n            kind: 5,\\n            x,\\n            z,\\n            yaw: 0.0,\\n            hp: 20.0,\\n            alive: true,\\n            alert: 0,\\n            gun: Gun::new(WeaponId::Pistol),\\n            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n    }\\n\\n    fn arm(&mut self, id: WeaponId) {\\n        if let Some(i) = self.guns.iter().position(|g| g.id == id) {\\n            self.slot = i;\\n        } else {\\n            self.guns.push(Gun::new(id));\\n            self.slot = self.guns.len() - 1;\\n        }\\n        let g = self.gun_mut();\\n        g.jammed = false;\\n        g.broken = false;\\n        g.force_jam = false;\\n        g.cooldown = 0.0;\\n        g.condition = 100.0;\\n        let mag = gun::stats(id).mag.max(1);\\n        if g.ammo < mag {\\n            g.ammo = mag;\\n        }\\n    }\\n\\n    fn prep_ignite(&mut self, n: u8) {\\n        match n {\\n            0 => self.arm(WeaponId::Flare),\\n            1 => self.arm(WeaponId::Rpg),\\n            2 => self.arm(WeaponId::Flamer),\\n            3 => self.arm(WeaponId::Mortar),\\n            4 => self.arm(WeaponId::Molotov),\\n            5 => self.arm(WeaponId::Frag),\\n            6 => {\\n                self.arm(WeaponId::Pistol);\\n                let (sy, cy) = self.yaw.sin_cos();\\n                self.spawn_barrel(self.x + sy * 4.0 + 2.0, self.z - cy * 4.0);\\n            }\\n            7 => self.arm(WeaponId::Pistol),\\n            8 => {\\n                self.arm(WeaponId::Flamer);\\n                self.clear_bodies();\\n                let (sy, cy) = self.yaw.sin_cos();\\n                self.spawn_soldier(self.x + sy * 6.0 + 1.0, self.z - cy * 6.0, 40.0, false);\\n            }\\n            9 => {\\n                self.weather = 2;\\n                self.arm(WeaponId::Pistol);\\n            }\\n            10 => self.arm(WeaponId::Pistol),\\n            _ => {}\\n        }\\n    }\\n\\n    fn note_weapon_ignite(&mut self, id: WeaponId) {\\n        let Some(Spec::Ignite(k)) = self.current() else { return };\\n        let flag = match (k, id) {\\n            (0, WeaponId::Flare) => \\\"ignite_flare\\\",\\n            (1, WeaponId::Rpg) => \\\"ignite_rocket\\\",\\n            (2, WeaponId::Flamer) => \\\"ignite_flamer\\\",\\n            (3, WeaponId::Mortar) => \\\"ignite_mortar\\\",\\n            (4, WeaponId::Molotov) => \\\"ignite_molotov\\\",\\n            (5, WeaponId::Frag) => \\\"ignite_frag\\\",\\n            _ => return,\\n        };\\n        self.mark(flag);\\n    }\\n\\n    fn cell_open(&self, x: f32, z: f32) -> bool {\\n        if geom::fuel(x, z) <= 0.0 {\\n            return false;\\n        }\\n        match self.fire.cells.get(&geom::cell_of(x, z)) {\\n            Some(cell) if cell.burning || self.minutes < cell.burnt_until => false,\\n            _ => true,\\n        }\\n    }\\n\\n    /// Nearest 2 m cell that will still take a light. Skips the cell under `x,z` when that one is closed.\\n    fn nearest_open_cell(&self, x: f32, z: f32) -> Option<(f32, f32)> {\\n        let (cx, cz) = geom::cell_of(x, z);\\n        for r in 1i32..36 {\\n            for dz in -r..=r {\\n                for dx in -r..=r {\\n                    if dx.abs() != r && dz.abs() != r {\\n                        continue;\\n                    }\\n                    let (px, pz) = geom::cell_center((cx + dx, cz + dz));\\n                    if self.cell_open(px, pz) {\\n                        return Some((px, pz));\\n                    }\\n                }\\n            }\\n        }\\n        None\\n    }\\n\\n    fn town_burning(&self) -> bool {\\n        self.fire.cells.iter().any(|(c, cell)| {\\n            if !cell.burning {\\n                return false;\\n            }\\n            let (x, z) = geom::cell_center(*c);\\n            geom::in_town(x, z)\\n        })\\n    }\\n\\n    pub fn choose_finale(&mut self, n: u8) {\\n        self.finale = Some(n);\\n        self.screen = Screen::Playing;\\n        self.focus = 0;\\n        self.idle = 0.0;\\n        self.hold_t = 0.0;\\n        match n {\\n            0 => self.arm(WeaponId::Flare),\\n            1 => {\\n                self.clear_bodies();\\n                for i in 0..3 {\\n                    self.spawn_soldier(self.x + 40.0 + i as f32 * 4.0, self.z - 50.0, 30.0, false);\\n                }\\n                self.syrettes = self.syrettes.max(4);\\n            }\\n            _ => {}\\n        }\\n    }\\n\\n    /// Puts the contract on the ledger step and lets the next tick open it.\\n    pub fn present_ending(&mut self) {\\n        if self.route == Route::Sandbox {\\n            self.route = Route::Human;\\n        }\\n        let idx = script(self.route).iter().position(|s| matches!(s, Spec::Ending(_))).unwrap_or(0);\\n        self.step = idx as u16;\\n        self.step_ready = false;\\n        self.finished = false;\\n        self.screen = Screen::Playing;\\n        self.finale = None;\\n        self.x = -760.0;\\n        self.z = 620.0;\\n    }\\n\\n    pub fn dev_teleport(&mut self, label: &str) {\\n        if let Some(p) = geom::PLACES.iter().find(|p| p.name == label) {\\n            self.x = p.x;\\n            self.z = p.z;\\n            self.ride.seat = 0;\\n            self.ride.speed = 0.0;\\n            if self.ride.kind != 0 {\\n                self.ride.x = p.x;\\n                self.ride.z = p.z;\\n            }\\n        }\\n    }\\n\\n    pub fn dev_spawn(&mut self, label: &str) {\\n        let x = self.x + 6.0;\\n        let z = self.z - 4.0;\\n        match label {\\n            \\\"Soldier\\\" => self.spawn_soldier(x, z, 40.0, false),\\n            \\\"Animal\\\" => self.spawn_animal(x, z),\\n            \\\"Truck\\\" => self.spawn_truck(x, z),\\n            \\\"Technical\\\" => {\\n                self.ride.kind = 1;\\n                self.ride.seat = 0;\\n                self.ride.x = x;\\n                self.ride.z = z;\\n                self.ride.health = 100.0;\\n                self.ride.stage = 0;\\n                self.ride.speed = 0.0;\\n            }\\n            \\\"Boat\\\" => {\\n                self.ride.kind = 2;\\n                self.ride.seat = 0;\\n                self.ride.x = x;\\n                self.ride.z = z;\\n                self.ride.health = 100.0;\\n                self.ride.stage = 0;\\n                self.ride.speed = 0.0;\\n            }\\n            \\\"Barrel\\\" => self.spawn_barrel(x, z),\\n            _ => {}\\n        }\\n    }\\n\\n    pub fn dev_world(&mut self, label: &str) {\\n        match label {\\n            \\\"Night\\\" => self.minutes = 22.0 * 60.0,\\n            \\\"Noon\\\" => self.minutes = 12.0 * 60.0,\\n            \\\"Rain\\\" => self.weather = 1,\\n            \\\"Clear sky\\\" => self.weather = 0,\\n            \\\"Strong wind\\\" => self.wind = Vec2::new(9.0, 0.0),\\n            \\\"Calm\\\" => self.wind = Vec2::new(0.2, 0.0),\\n            \\\"Ignite grass\\\" => {\\n                let _ = self.fire.ignite_at(self.x + 8.0, self.z + 8.0, self.tune.burn_time, self.minutes);\\n            }\\n            _ => {}\\n        }\\n    }\\n\\n    fn spawn_truck(&mut self, x: f32, z: f32) {\\n        self.bodies.push(Body {\\n            kind: 6,\\n            x,\\n            z,\\n            yaw: 0.0,\\n            hp: 80.0,\\n            alive: true,\\n            alert: 0,\\n            gun: Gun::new(WeaponId::Pistol),\\n            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n    }\\n\\n    fn spawn_tank_farm(&mut self) {\\n        self.clear_bodies();\\n        for i in 0..7 {\\n            for j in 0..7 {\\n                self.bodies.push(Body {\\n                    kind: 5,\\n                    x: self.x + i as f32 * 10.0,\\n                    z: self.z + j as f32 * 10.0 - 20.0,\\n                    yaw: 0.0,\\n                    hp: 20.0,\\n                    alive: true,\\n                    alert: 0,\\n                    gun: Gun::new(WeaponId::Pistol),\\n                    see: 0.0,\\n                    poison: 0.0,\\n                    burn: 0.0,\\n                    doomed: false,\\n                    flee: 0.0,\\n                });\\n            }\\n        }\\n    }\\n\\n    fn blow_tanks(&mut self) {\\n        if self.bodies.iter().any(|b| b.kind == 5 && b.alive) {\\n            let positions: Vec<(f32, f32)> = self.bodies.iter().filter(|b| b.kind == 5).map(|b| (b.x, b.z)).collect();\\n            for b in &mut self.bodies {\\n                if b.kind == 5 {\\n                    b.hp = 0.0;\\n                    b.alive = false;\\n                }\\n            }\\n            for (x, z) in positions {\\n                let _ = self.fire.ignite_disk(x, z, 6.0, self.tune.burn_time, self.minutes);\\n            }\\n            self.mark(\\\"explosion_chain\\\");\\n            if self.fire.burned >= 500 {\\n                self.mark(\\\"cells_500\\\");\\n            }\\n        }\\n    }\\n\",\"total_lines\":2806}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"41661a89-2b64-47df-9b01-7136f2d3c03b"}
{"type":"assistant","message":{"id":"msg_579","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"\n\nThe campaign director previously cheated the playthrough by teleporting and cheating. I removed those warps and now make the bot use real player actions. Spec::Town only arms a molotov in begin. Town done checks town_burning().I need to verify whether the prior gaps are genuinely fixed.\n\nThe bot now walks to (18, 424) and fires. Spec::Boat places the boat at the nearest water without teleporting the player. The bot walks to the boat, boards with USE, then drives. I need to verify that boarding requires\n\nFirst-person play  standing on water andnow appears wired to that the boat actually the view. The camera moves. Spec::Night  eye, body position,sets the clock to 22:00 and item placement  in begin instead ofall derive from the  stamping the night overlook state. I stillcontract immediately. need to confirm the The done check still render path uses FpCam.eye requires the player and that tests cover to have moved more  this. The second gapthan 1.5 meters. about human new game routes is also being\n\nI need to check PLAN checked. §11 and §15 to see if time advancement allows the night contract.\n\nscript_ignite no longer stamps ignite flags directly. Those now come from note_weapon_ignite when weapons fire. I must verify the firing path calls that function and that weapons actually ignite.\n\nscript_ignites still handle three cases: blow_tanks(),\n\nThe Ledger screen  bus teleport, and ending read after 180 steps.\n\nSpec::Drive warps and its bot navigationthe player into a technical are now in place. I vehicle without boarding. still need to verify Spec::Repair places that bot_input routes a vehicle under the through bot_ledger  player. Spec::Panicon that screen, and  ignites fire disks that a human player immediately. These maycan reach it during  be new defects rathernormal play. The ending than previously accepted logic also needs checking: behavior. script_ignite marks ending_read after 180 seconds when finale is Some(1), but ending_burn only triggers when a shot ignites while finale is Some(0).\n\nCampaign director cheats are being checked. Town now arms molotov without teleporting\n\nCriterion 4 explicitly the player. Boat spawns forbids teleport and at the nearest water, but the player walks cheat actions. Spec::Drive's to board and drive  vehicle warp is thereforerather than teleporting onto it. This may still a defect. The prior violate the prior gap gap only named Town, about teleporting onto Boat, Night, and script_ignite water. weapon stamps. Drive's teleport was not flagged as a cheat.\n\nThe anti-ratchet rule allows raising a new objection if it is a demonstrable defect or unmet gating criterion. Criterion 4 explicitly forbids teleport, and the prior round's instruction\n\nThe boat placement to remove warps partially is a genuine fix. It identified this issue. treats the vehicle  Therefore, Drive's as mission setup rathervehicle warp remains than a teleport cheat. a valid defect.\n\nSpec::Night now sets the clock to 22:00 in begin. The night_contract flag is only marked in done() if the player has moved more than 1.5 meters from the step start.\n\nscript_ignite no longer stamps ignite flags directly; those now come from note_weapon_ignite when weapons fire. However, Spec::Flag(s) still marks flags immediately\n\nI should verify whether in begin. I need to check what Spec::Flag the camera actually is used for. follows the player.\n\nSpec::Better, Patch, Overdose, and Die also mark better_way immediately in begin without player action. Spec::Panic ignites fire disks in begin for scripted soldier flee behavior; this is a different contract from weapon-ignited flags. Spec::Rain ignites cells in begin as setup for rain to extinguish them, which is reasonable.\n\nSpec::Drive still teleports the player directly into the driver's seat without walking to the vehicle and pressing USE. This may\n\npost() now sets player position and overlook from eye_pos, which the app reads into FpCam. I need to verify eye changes with stance and that tests assert this.\n\nThe human route still starts World::campaign(seed, Route::Human). The bot uses bot_ledger based on self.route. If the bot is always Route::Human, it always picks burn (want=0). be a pre-existing issue. I will not raise it unless it is a demonstrable defect or unmet gating criterion.\n\nCriterion 4 explicitly forbids teleport and cheats. Spec::Drive's automatic seating is a teleport cheat that the prior gap did not list, so it still violates the criterion.","signature":""},{"type":"tool_use","id":"call-60b300cd-c6d0-479e-91e0-5e6bd3ef19be-13","name":"grep","input":{"pattern":"fn bot_plays|fn first_person|fn ledger|fn dev_|choose_finale|present_ending|Route::Read|Route::Chair|Route::Human|fn play_route|campaign\\(","path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/tests/merc.rs"}},{"type":"tool_use","id":"call-60b300cd-c6d0-479e-91e0-5e6bd3ef19be-14","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs","offset":250,"limit":200}},{"type":"tool_use","id":"call-60b300cd-c6d0-479e-91e0-5e6bd3ef19be-15","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs","offset":580,"limit":280}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":10398,"output_tokens":1583,"cache_read_input_tokens":46848,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"b8998b08-b036-4c89-9a3e-2