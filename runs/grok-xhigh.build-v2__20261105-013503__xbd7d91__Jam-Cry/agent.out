reen::Settings;\\n                    self.focus = 0;\\n                }\\n                \\\"Controls\\\" => {\\n260→                    self.screen = Screen::Settings;\\n                    self.tab = 1;\\n                    self.focus = 0;\\n                }\\n                \\\"Dev mode\\\" if !self.hub => {\\n                    self.screen = Screen::Dev;\\n                    self.tab = 0;\\n                    self.page = 0;\\n                    self.focus = 0;\\n                }\\n270→                \\\"Quit to title\\\" => {\\n                    self.screen = Screen::Title;\\n                    self.focus = 0;\\n                }\\n                _ => {}\\n            },\\n            Screen::Settings => {\\n                if label == \\\"Xbox glyphs\\\" {\\n                    self.xbox = true;\\n                } else if label == \\\"PlayStation glyphs\\\" {\\n280→                    self.xbox = false;\\n                } else if label.starts_with(\\\"Page\\\") {\\n                    self.tab = (self.tab + 1) % 4;\\n                    self.focus = 0;\\n                }\\n            }\\n            Screen::Dev => {\\n                if self.tab == 0 {\\n                    self.tab = match label {\\n                        \\\"Cheats\\\" => 1,\\n290→                        \\\"Teleport\\\" => 2,\\n                        \\\"Spawn\\\" => 3,\\n                        \\\"World\\\" => 4,\\n                        \\\"Balance\\\" => 5,\\n                        _ => 0,\\n                    };\\n                    self.page = 0;\\n                    self.focus = 0;\\n                    return;\\n                }\\n300→                if label == \\\"Reset to defaults\\\" {\\n                    self.tune = self.tune0.clone();\\n                    return;\\n                }\\n                if label == \\\"Next page\\\" {\\n                    self.page += 1;\\n                    self.focus = 0;\\n                    return;\\n         