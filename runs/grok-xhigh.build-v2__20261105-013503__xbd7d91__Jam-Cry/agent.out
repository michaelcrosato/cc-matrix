     --bridge opens the live agent bridge (default 127.0.0.1:7878; drive it with `pav live`).\\\\n\\\\\\n             --animation-studio [SET/Clip] opens the animation workspace and the live agent bridge.\\\\n\\\\\\n             --creature-studio [CREATURE/name] opens the creature workspace and the live agent bridge.\\\\n\\\\\\n             --asset-studio [SET/name] opens the object workspace and the live agent bridge.\\\\n\\\\\\n             Startup settings live in shardfall.toml next to the executable.\\\"\\n        );\\n        return;\\n    }\\n    log::info!(\\n        \\\"Shardfall {} ({} {}, {} build) — log file: {}\\\",\\n        env!(\\\"CARGO_PKG_VERSION\\\"),\\n        if cfg!(target_arch = \\\"wasm32\\\") { \\\"browser\\\" } else { std::env::consts::OS },\\n        std::env::consts::ARCH,\\n        if cfg!(debug_assertions) { \\\"debug\\\" } else { \\\"release\\\" },\\n        d.log_path.display()\\n    );\\n    let settings = match boot::stage(\\\"settings\\\", || {\\n        let (s, note) = settings::Settings::load(&args);\\n        Ok((s, note))\\n    }) {\\n        Ok(s) => s,\\n        Err(e) => fatal(&format!(\\\"{e:#}\\\")),\\n    };\\n    // The browser's event loop runs on after `run` returns; errors show on the page.\\n    #[cfg(target_arch = \\\"wasm32\\\")]\\n    if let Err(e) = app::run(settings) {\\n        fatal(&format!(\\\"{e:#}\\\"));\\n    }\\n    #[cfg(not(target_arch = \\\"wasm32\\\"))]\\n    match std::panic::catch_unwind(|| app::run(settings)) {\\n        Ok(Ok(())) => log::info!(\\\"clean exit\\\"),\\n        Ok(Err(e)) => fatal(&format!(\\\"{e:#}\\\")),\\n        Err(_) => {\\n            let msg = boot::LAST_CRASH.lock().ok().and_then(|c| c.clone()).unwrap_or_else(|| \\\"unknown crash\\\".into());\\n\",\"total_lines\":84}}","is_error":false},{"type":"tool_result","tool_use_id":"call-661f3889-178a-43d4-a1a2-b289491e45cd-6","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"50→        (Device::Gamepad, true, \\\"fire\\\") => \\\"RT\\\",\\n        (Device::Gamepad, false, \\\"aim\\\") => \\\"L2\\\",\\n        (Device::Gamepad, true, \\\"aim\\\") => \\\"LT\\\",\\n        (Device::Gamepad, _, \\\"map\\\") => \\\"D-pad\\\",\\n        (Device::Gamepad, false, \\\"jump\\\") => \\\"Cross\\\",\\n        (Device::Gamepad, true, \\\"jump\\\") => \\\"A\\\",\\n        _ => \\\"Button\\\",\\n    }\\n}\\n\\n60→fn menu_of(input: &InputFrame) -> MenuInput {\\n    MenuInput {\\n        up: input.act == 3,\\n        down: input.act == 4,\\n        left: input.act == 5,\\n        right: input.act == 6,\\n        confirm: input.act == 1 || input.just(buttons::CONFIRM) || input.just(buttons::JUMP),\\n        back: input.act == 2,\\n        pointer: None,\\n        click: false,\\n70→        device: None,\\n    }\\n}\\n\\nimpl World {\\n    pub fn shell_tick(&mut self, input: &InputFrame, dt: f32) {\\n        if input.act == 14 {\\n            self.xbox = !self.xbox;\\n        }\\n        let typed = input.pressed != 0\\n80→            || input.act != 0\\n            || input.look.length_squared() > 1e-8\\n            || input.move_dir.length_squared() > 1e-8;\\n        if typed && self.device_lock == 0 {\\n            // A pointer-only hover does not arrive through InputFrame. Keyboard buttons do.\\n            if input.pressed & (buttons::CONFIRM | buttons::JUMP | buttons::MAP | buttons::RELOAD) != 0 || input.act != 0 {\\n                self.device = Device::Keyboard;\\n            }\\n        }\\n        if self.screen == Screen::Attract {\\n90→            if typed {\\n                self.screen = Screen::Title;\\n                self.focus = 0;\\n                self.idle = 0.0;\\n                self.attract_t = 0.0;\\n                return;\\n            }\\n            self.attract_t += dt;\\n            let seg = ((self.attract_t / 16.0) as u32) % 10;\\n            self.attract_seen |= 1u16 << seg;\\n100→            self.attract_loops = (self.attract_t / 160.0) as u32;\\n            return;\\n        }\\n        let shell = self.screen != Screen::Playing;\\n        if shell {\\n            if typed {\\n                self.idle = 0.0;\\n            } else if !self.hub {\\n                self.idle += dt;\\n            }\\n110→            if self.idle >= 10.0 && !self.hub {\\n                self.screen = Screen::Attract;\\n                return;\\n            }\\n            let mut m = menu_of(input);\\n            if self.touch_only && input.act == 0 && input.pressed == 0 {\\n                // Touch does not drive the menu. Settings is still a row a pointer can hit.\\n            }\\n            self.apply_menu(m);\\n            let _ = &mut m;\\n120→        }\\n    }\\n\\n    pub fn apply_menu(&mut self, m: MenuInput) {\\n        if let Some(d) = m.device {\\n            self.device = d;\\n        }\\n        if self.screen == Screen::Playing || self.screen == Screen::Attract {\\n            if m.confirm || m.back || m.up || m.down || m.click || m.pointer.is_some() {\\n                if self.screen == Screen::Attract {\\n130→                    self.screen = Screen::Title;\\n                    self.focus = 0;\\n                    self.idle = 0.0;\\n                    self.attract_t = 0.0;\\n                }\\n            }\\n            if self.screen != Screen::Title {\\n                return;\\n            }\\n        }\\n140→        let n = self.rows().len();\\n        if n == 0 {\\n            return;\\n        }\\n        if let Some((px, py)) = m.pointer {\\n            for i in 0..n {\\n                let y0 = 220.0 + i as f32 * 80.0;\\n                if px >= 160.0 && px <= 900.0 && py >= y0 && py <= y0 + 64.0 {\\n                    self.focus = i;\\n                }\\n150→            }\\n        }\\n        if m.up {\\n            self.focus = if self.focus == 0 { n - 1 } else { self.focus - 1 };\\n        }\\n        if m.down {\\n            self.focus = (self.focus + 1) % n;\\n        }\\n        self.focus = self.focus.min(n - 1);\\n        let activate = m.confirm || m.click;\\n160→        if m.left || m.right {\\n            self.nudge_slider(if m.right { 1.0 } else { -1.0 });\\n        }\\n        if m.back {\\n            self.go_back();\\n        }\\n        if activate {\\n            let rows = self.rows();\\n            let label = rows.get(self.focus).cloned().unwrap_or_default();\\n            self.activate(&label);\",\"content_concise\":\"50→        (Device::Gamepad, true, \\\"fire\\\") => \\\"RT\\\",\\n        (Device::Gamepad, false, \\\"aim\\\") => \\\"L2\\\",\\n        (Device::Gamepad, true, \\\"aim\\\") => \\\"LT\\\",\\n        (Device::Gamepad, _, \\\"map\\\") => \\\"D-pad\\\",\\n        (Device::Gamepad, false, \\\"jump\\\") => \\\"Cross\\\",\\n        (Device::Gamepad, true, \\\"jump\\\") => \\\"A\\\",\\n        _ => \\\"Button\\\",\\n    }\\n}\\n\\n60→fn menu_of(input: &InputFrame) -> MenuInput {\\n    MenuInput {\\n        up: input.act == 3,\\n        down: input.act == 4,\\n        left: input.act == 5,\\n        right: input.act == 6,\\n        confirm: input.act == 1 || input.just(buttons::CONFIRM) || input.just(buttons::JUMP),\\n        back: input.act == 2,\\n        pointer: None,\\n        click: false,\\n70→        device: None,\\n    }\\n}\\n\\nimpl World {\\n    pub fn shell_tick(&mut self, input: &InputFrame, dt: f32) {\\n        if input.act == 14 {\\n            self.xbox = !self.xbox;\\n        }\\n        let typed = input.pressed != 0\\n80→            || input.act != 0\\n            || input.look.length_squared() > 1e-8\\n            || input.move_dir.length_squared() > 1e-8;\\n        if typed && self.device_lock == 0 {\\n            // A pointer-only hover does not arrive through InputFrame. Keyboard buttons do.\\n            if input.pressed & (buttons::CONFIRM | buttons::JUMP | buttons::MAP | buttons::RELOAD) != 0 || input.act != 0 {\\n                self.device = Device::Keyboard;\\n            }\\n        }\\n        if self.screen == Screen::Attract {\\n90→            if typed {\\n                self.screen = Screen::Title;\\n                self.focus = 0;\\n                self.idle = 0.0;\\n                self.attract_t = 0.0;\\n                return;\\n            }\\n            self.attract_t += dt;\\n            let seg = ((self.attract_t / 16.0) as u32) % 10;\\n            self.attract_seen |= 1u16 << seg;\\n100→            self.attract_loops = (self.attract_t / 160.0) as u32;\\n            return;\\n        }\\n        let shell = self.screen != Screen::Playing;\\n        if shell {\\n            if typed {\\n                self.idle = 0.0;\\n            } else if !self.hub {\\n                self.idle += dt;\\n            }\\n110→            if self.idle >= 10.0 && !self.hub {\\n                self.screen = Screen::Attract;\\n                return;\\n            }\\n            let mut m = menu_of(input);\\n            if self.touch_only && input.act == 0 && input.pressed == 0 {\\n                // Touch does not drive the menu. Settings is still a row a pointer can hit.\\n            }\\n            self.apply_menu(m);\\n            let _ = &mut m;\\n120→        }\\n    }\\n\\n    pub fn apply_menu(&mut self, m: MenuInput) {\\n        if let Some(d) = m.device {\\n            self.device = d;\\n        }\\n        if self.screen == Screen::Playing || self.screen == Screen::Attract {\\n            if m.confirm || m.back || m.up || m.down || m.click || m.pointer.is_some() {\\n                if self.screen == Screen::Attract {\\n130→                    self.screen = Screen::Title;\\n                    self.focus = 0;\\n                    self.idle = 0.0;\\n                    self.attract_t = 0.0;\\n                }\\n            }\\n            if self.screen != Screen::Title {\\n                return;\\n            }\\n        }\\n140→        let n = self.rows().len();\\n        if n == 0 {\\n            return;\\n        }\\n        if let Some((px, py)) = m.pointer {\\n  