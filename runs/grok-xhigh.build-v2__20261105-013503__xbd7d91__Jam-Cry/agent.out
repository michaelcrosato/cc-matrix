: [0, 0], move: null, axes: null, pressed: 0, act: 0, hover: null, click: false, device: null, touch: null, xbox: null, lock: false, hub: false };\\n  window.__jamScene = 'merc';\\n  try {\\n    var q = new URLSearchParams(location.search);\\n    if (!q.get('scene') && !q.get('room')) {\\n      q.set('scene', 'merc');\\n      history.replaceState(history.state, '', '?' + q.toString() + location.hash);\\n    }\\n  } catch (e) {}\\n  var held = {};\\n  var screenName = 'Title';\\n  var started = false;\\n  var ended = false;\\n  var finished = false;\\n  var present = {};\\n  var info = null;\\n  window.gameTest = window.gameTest || { queue: [] };\\n  window.__jamSkipGpu = !!(window.AIHub && AIHub.active) || /[?&]nogpu=1/.test(location.search);\\n\\n  function touchOnly() {\\n    try { return matchMedia('(pointer: coarse)').matches && matchMedia('(hover: none)').matches; }\\n    catch (e) { return false; }\\n  }\\n  function sensePad() {\\n    var pads = [];\\n    try { pads = navigator.getGamepads ? navigator.getGamepads() : []; } catch (e) { pads = []; }\\n    var pad = pads && pads[0];\\n    if (pad && pad.connected && String(pad.id).indexOf('054c') >= 0 && String(pad.id).indexOf('0ce6') >= 0) {\\n      pending.device = 'gamepad';\\n      pending.lock = true;\\n    }\\n  }\\n  function applyCmd(c) {\\n    if (!c || typeof c !== 'object') return;\\n    if (c.act) pending.act = c.act | 0;\\n    if (c.look && c.look.length === 2) { pending.look[0] += +c.look[0] || 0; pending.look[1] += +c.look[1] || 0; }\\n    if (c.move) pending.move = c.move;\\n    if (c.hover) pending.hover = c.hover;\\n    if (c.click) pending.click = true;\\n    if (c.device) pending.device = c.device;\\n    if (c.lock) pending.lock = true;\\n    if (c.touch) pending.touch = true;\\n    if (c.xbox) pending.xbox = true;\\n    if (c.key === 'Enter' || c.key === ' ') pending.act = 1;\\n    if (c.key === 'Escape') pending.act = 10;\\n  }\\n  function drain() {\\n    var q = window.gameTest && window.gameTest.queue;\\n    if (!q || !q.length) return;\\n    var batch = q.splice(0, q.length);\\n    for (var i = 0; i < batch.length; i++) applyCmd(batch[i]);\\n  }\\n  function stick() {\\n    var x = (held.d || held.ArrowRight ? 1 : 0) - (held.a || held.ArrowLeft ? 1 : 0);\\n    var y = (held.w || held.ArrowUp ? 1 : 0) - (held.s || held.ArrowDown ? 1 : 0);\\n    if (!x && !y) return null;\\n    var len = Math.hypot(x, y) || 1;\\n    return [x / len, y / len];\\n  }\\n  window.gameBridge = {\\n    pull: function () {\\n      drain();\\n      sensePad();\\n      if (touchOnly()) pending.touch = true;\\n      if (window.AIHub && AIHub.active) pending.hub = true;\\n      var out = {\\n        look: [pending.look[0], pending.look[1]],\\n        move: pending.move || stick(),\\n        axes: pending.axes,\\n        pressed: pending.pressed,\\n        act: pending.act,\\n        hover: pending.hover,\\n        click: pending.click,\\n        device: pending.device,\\n        touch: pending.touch,\\n        xbox: pending.xbox,\\n        lock: pending.lock,\\n        hub: !!pending.hub\\n      };\\n      pending.look = [0, 0];\\n      pending.pressed = 0;\\n      pending.act = 0;\\n      pending.click = false;\\n      pending.hover = null;\\n      pending.move = null;\\n      pending.xbox = null;\\n      return JSON.stringify(out);\\n    },\\n    publish: function (status, ui) { window.__game = { status: status, ui: ui }; paint(status, ui); }\\n  };\\n\\n  function paint(status, ui) {\\n    var u;\\n    try { u = JSON.parse(ui); } catch (e) { return; }\\n    screenName = u.screen || screenName;\\n    var shell = document.getElementById('shell');\\n    if (shell) shell.dataset.screen = screenName;\\n    var rows = document.getElementById('rows');\\n    var notice = document.getElementById('notice');\\n    var about = document.getElementById('about');\\n    var settings = document.getElementById('settings-btn');\\n    if (notice) {\\n      if (u.notice) { notice.hidden = false; notice.textContent = u.notice; }\\n      else notice.hidden = true;\\n    }\\n    if (settings) settings.hidden = !u.notice;\\n    if (rows && u.rows) {\\n      while (rows.firstChild) rows.removeChild(rows.firstChild);\\n      var list = u.rows.slice(0, 7);\\n      for (var i = 0; i < list.length; i++) {\\n        var b = document.createElement('button');\\n        b.type = 'button';\\n\",\"total_lines\":430}}","is_error":false},{"type":"tool_result","tool_use_id":"call-6ae6f18b-51b6-4380-b619-2dd16ba4fcf1-45","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1860→        // Scripted igniters that are not shots.\\n        if self.step_ready {\\n            if let Some(spec) = self.current() {\\n                self.script_ignite(spec, input);\\n            }\\n        }\\n    }\\n\\n    fn patch_or_dose(&mut self) {\\n        if self.hold_t < 3.0 || self.syrettes == 0 {\\n1870→            return;\\n        }\\n        let doomed = matches!(self.current(), Some(Spec::Overdose));\\n        let px = self.x;\\n        let pz = self.z;\\n        if let Some(i) = self.companions.iter().position(|c| c.down && c.alive && geom::dist(px, pz, c.x, c.z) < 4.0) {\\n            self.syrettes -= 1;\\n            if doomed {\\n                self.companions[i].alive = false;\\n                self.companions[i].down = false;\\n1880→                self.mark(\\\"companion_overdosed\\\");\\n            } else {\\n                self.companions[i].down = false;\\n                self.companions[i].down_t = 0.0;\\n                self.mark(\\\"companion_patched\\\");\\n            }\\n        }\\n    }\\n\\n    fn script_ignite(&mut self, spec: Spec, _input: &InputFrame) {\\n1890→        // Each source lights a fresh patch west of the player. East stays clear for tracers.\\n        let n = match spec {\\n            Spec::Ignite(k) => k as f32,\\n            _ => 0.0,\\n        };\\n        let x = self.x - 24.0 - n * 18.0;\\n        let z = self.z - 16.0;\\n        match spec {\\n            Spec::Ignite(0) => {\\n                if self.fire.ignite_at(x, z, self.tune.burn_time, self.minutes) {\\n1900→                    self.mark(\\\"ignite_flare\\\");\\n                }\\n            }\\n            Spec::Ignite(1) => {\\n                if self.fire.ignite_disk(x, z, 6.0, self.tune.burn_time, self.minutes) > 0 {\\n                    self.mark(\\\"ignite_rocket\\\");\\n                }\\n            }\\n            Spec::Ignite(2) => {\\n                if self.fire.ignite_at(x + 1.0, z, self.tune.burn_time, self.minutes) {\\n1910→                    self.mark(\\\"ignite_flamer\\\");\\n                }\\n            }\\n            Spec::Ignite(3) => {\\n                if self.fire.ignite_disk(x, z + 4.0, 8.0, self.tune.burn_time, self.minutes) > 0 {\\n                    self.mark(\\\"ignite_mortar\\\");\\n                }\\n            }\\n            Spec::Ignite(4) => {\\n                if self.fire.ignite_disk(x, z, 4.0, self.tune.burn_time, self.minutes) > 0 {\\n1920→                    self.mark(\\\"ignite_molotov\\\");\\n                }\\n            }\\n            Spec::Ignite(5) => {\\n                if self.fire.ignite_disk(x + 3.0, z, 6.0, self.tune.burn_time, self.minutes) > 0 {\\n                    self.mark(\\\"ignite_frag\\\");\\n                }\\n            }\\n            Spec::Ignite(6) => {\\n                if self.fire.ignite_disk(x, z, 5.0, self.tune.burn_time, self.minutes) > 0 {\\n1930→                    self.mark(\\\"ignite_barrel\\\");\\n                }\\n            }\\n            Spec::Ignite(7) => {\\n                self.mark(\\\"ignite_vehicle\\\");\\n                let _ = self.fire.ignite_disk(self.x, self.z, 5.0, self.tune.burn_time, self.minutes);\\n            }\\n            Spec::Ignite(8) => {\\n                self.mark(\\\"ignite_person\\\");\\n                let _ = self.fire.ignite_at(x, z, self.tune.burn_time, self.minutes);\\n1940→            }\\n            Spec::Ignite(9) => {\\n                self.weather = 2;\\n                if self.fire.ignite_at(x + 6.0, z - 6.0, self.tune.burn_time, self.minutes) {\\n                    self.mark(\\\"ignite_lightning\\\");\\n                }\\n                self.weather = 0;\\n            }\\n            Spec::Ignite(11) => {\\n                if self.fire.ignite_at(x, z, self.tune.burn_time, self.minutes) {\\n1950→                    self.mark(\\\"ignite_cigarette\\\");\\n                }\\n            }\\n            Spec::Tanks => {\\n                self.blow_tanks();\\n            }\\n            Spec::Ending(0) => {\\n                let _ = self.fire.ignite_disk(self.x, self.z, 8.0, self.tune.burn_time, self.minutes);\\n                self.mark(\\\"ending_burn\\\");\\n            }\\n1960→            Spec::Ending(1) => {\\n                // The ledger is read under fire. step_t is real time on this step.\\n                if self.step_t >= 180.0 {\\n                    self.mark(\\\"ending_read\\\");\\n                }\\n            }\\n            Spec::Ending(2) => {\\n                self.mark(\\\"ending_chair\\\");\\n            }\\n            Spec::Bus { x, z } => {\\n1970→                let stop = geom::place(\\\"Junction\\\");\\n                if geom::dist(self.x, self.z, stop.0, stop.1) < 14.0 && self.diamonds >= 1 {\\n                    self.diamonds -= 1;\\n                    self.x = x;\\n                    self.z = z;\\n                    self.ride.seat = 0;\\n                    self.minutes += 20.0;\\n                    self.mark(\\\"bus_taken\\\");\\n                    self.mark(\\\"diamonds_spent\\\");\\n                }\\n1980→            }\\n            _ => {}\\n        }\\n        // Tracer step: spray the ground in front.\\n        if matches!(spec, Spec::Ignite(10)) {\\n            self.pitch = -0.25;\\n            for _ in 0..4 {\\n                if self.guns.is_empty() {\\n                    break;\\n                }\\n1990→                let i = self.slot.min(self.guns.len() - 1);\\n                if self.guns[i].ammo == 0 {\\n                    self.guns[i].ammo = 30;\\n                }\\n                self.guns[i].condition = 90.0;\\n                let pull = self.guns[i].pull(&mut self.rng, 0.0, 0.0, 0.0);\\n                if pull == Pull::Fired || pull == Pull::Broke {\\n                    self.resolve_shot(true);\\n                }\\n            }\\n2000→        }\\n    }\\n\\n    fn try_interact(&mut self) {\\n        if geom::dist(self.x, self.z, 170.0, 470.0) < 16.0 || geom::dist(self.x, self.z, -260.0, -700.0) < 16.0 || geom::dist(self.x, self.z, 830.0, 255.0) < 16.0\\n        {\\n            if self.hold_t > 0.3 && matches!(self.current(), Some(Spec::Claim)) {\\n                self.mark(\\\"safe_house_claimed\\\");\\n                self.hp = 100.0;\\n            }\\n2010→            if self.hold_t > 0.8 && matches!(self.current(), Some(Spec::Sleep { .. })) {\\n                let hours = match self.current() {\\n                    Some(Spec::Sleep { hours }) => hours,\\n                    _ => 8.0,\\n                };\\n                self.minutes += hours * 60.0;\\n                self.hp = 100.0;\\n                for c in &mut self.companions {\\n                    c.rescue_spent = false;\\n                }\\n2020→                self.yaw = std::f32::consts::PI;\\n                self.looking_at_post = false;\\n                self.mark(\\\"sleep_used\\\");\\n                if hours >= 24.0 && self.post_clear {\\n                    self.post_clear = false;\\n                    self.mark(\\\"post_remanned\\\");\\n                }\\n            }\\n        }\\n        if matches!(self.current(), Some(Spec::Shop)) {\\n2030→            let price = 8u32;\\n            if self.diamonds >= price {\\n                self.diamonds -= price;\\n                self.guns.push(Gun::new(WeaponId::Battle));\\n                self.mark(\\\"weapon_bought\\\");\\n                self.mark(\\\"diamonds_spent\\\");\\n                self.infamy += 1;\\n            }\\n        }\\n        if matches!(self.current(), Some(Spec::Locker)) && self.guns.len() > 1 {\\n2040→            self.slot = self.guns.len() - 1;\\n            self.mark(\\\"locker_used\\\");\\n        }\\n        if matches!(self.current(), Some(Spec::Loot)) && !self.guns.iter().any(|g| g.id == WeaponId::Ar) {\\n            let mut g = Gun::new(WeaponId::Ar);\\n            g.condition = 40.0;\\n            self.guns.push(g);\\n        }\\n        if matches!(self.current(), Some(Spec::Tape)) && self.hold_t > 1.5 {\\n            self.mark(\\\"tape_played\\\");\\n2050→        }\\n        if matches!(self.current(), Some(Spec::Ceasefire)) {\\n            self.ceasefire = false;\\n            self.mark(\\\"ceasefire_ended\\\");\\n        }\\n    }\\n\\n    pub fn try_buy(&mut self) -> bool {\\n        if self.diamonds < 8 {\\n            return false;\\n2060→        }\\n        self.diamonds -= 8;\\n        self.guns.push(Gun::new(WeaponId::Battle));\\n        self.mark(\\\"weapon_bought\\\");\\n        self.mark(\\\"diamonds_spent\\\");\\n        true\\n    }\\n\\n    fn maybe_reman(&mut self) {\\n        if !self.post_clear {\\n2070→            return;\\n        }\\n        let (px, pz) = geom::place(\\\"Kilo 38\\\");\\n        let to_x = px - self.x;\\n        let to_z = pz - self.z;\\n        let (sy, cy) = self.yaw.sin_cos();\\n        let fwd = (sy, -cy);\\n        let len = (to_x * to_x + to_z * to_z).sqrt().max(0.1);\\n        let dot = (fwd.0 * to_x + fwd.1 * to_z) / len;\\n        let dist = geom::dist(self.x, self.z, px, pz);\\n2080→        self.looking_at_post = dot > 0.4 && dist < 180.0;\\n        if self.minutes >= self.post_reman_at && !self.looking_at_post {\\n            self.post_clear = false;\\n            self.mark(\\\"post_remanned\\\");\\n        }\\n    }\\n\\n    fn clear_bodies(&mut self) {\\n        self.bodies.clear();\\n    }\\n2090→\\n    fn