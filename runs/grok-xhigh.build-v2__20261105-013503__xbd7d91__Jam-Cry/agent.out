_lightning\\\",\\n        10 => \\\"ignite_tracer\\\",\\n        _ => \\\"ignite_cigarette\\\",\\n    }\\n2740→}\\n\\nfn ending_flag(n: u8) -> &'static str {\\n    match n {\\n        1 => \\\"ending_read\\\",\\n        2 => \\\"ending_chair\\\",\\n        _ => \\\"ending_burn\\\",\\n    }\\n}\\n\\n2750→trait Doomed {\\n    fn doomed_enough(&self) -> bool;\\n}\\nimpl Doomed for Companion {\\n    fn doomed_enough(&self) -> bool {\\n        false\\n    }\\n}\\n\\nfn ray_sphere(o: (f32, f32, f32), d: (f32, f32, f32), c: (f32, f32, f32), r: f32) -> Option<f32> {\\n2760→    let lx = c.0 - o.0;\\n    let ly = c.1 - o.1;\\n    let lz = c.2 - o.2;\\n    let b = lx * d.0 + ly * d.1 + lz * d.2;\\n    let cc = lx * lx + ly * ly + lz * lz - r * r;\\n    let disc = b * b - cc;\\n    if disc < 0.0 {\\n        return None;\\n    }\\n    let t = b - disc.sqrt();\\n2770→    (t > 0.05).then_some(t)\\n}\\n\\nfn ray_aabb(o: (f32, f32, f32), d: (f32, f32, f32), min: [f32; 3], max: [f32; 3]) -> Option<f32> {\\n    let mut t0 = 0.0f32;\\n    let mut t1 = 1.0e6f32;\\n    let origins = [o.0, o.1, o.2];\\n    let dirs = [d.0, d.1, d.2];\\n    for i in 0..3 {\\n        if dirs[i].abs() < 1e-8 {\\n2780→            if origins[i] < min[i] || origins[i] > max[i] {\\n                return None;\\n            }\\n            continue;\\n        }\\n        let inv = 1.0 / dirs[i];\\n        let mut ta = (min[i] - origins[i]) * inv;\\n        let mut tb = (max[i] - origins[i]) * inv;\\n        if ta > tb {\\n            std::mem::swap(&mut ta, &mut tb);\\n2790→        }\\n        t0 = t0.max(ta);\\n        t1 = t1.min(tb);\\n        if t0 > t1 {\\n            return None;\\n        }\\n    }\\n    (t0 > 0.05).then_some(t0)\\n}\\n\",\"content_concise\":\"2720→        5 => \\\"wound_tourniquet\\\",\\n        _ => \\\"wound_graze\\\",\\n    }\\n}\\n\\nfn ignite_flag(n: u8) -> &'static str {\\n    match n {\\n        0 => \\\"ignite_flare\\\",\\n        1 => \\\"ignite_rocket\\\",\\n        2 => \\\"ignite_flamer\\\",\\n2730→        3 => \\\"ignite_mortar\\\",\\n        4 => \\\"ignite_molotov\\\",\\n        5 => \\\"ignite_frag\\\",\\n        6 => \\\"ignite_barrel\\\",\\n        7 => \\\"ignite_vehicle\\\",\\n        8 => \\\"ignite_person\\\",\\n        9 => \\\"ignite_lightning\\\",\\n        10 => \\\"ignite_tracer\\\",\\n        _ => \\\"ignite_cigarette\\\",\\n    }\\n2740→}\\n\\nfn ending_flag(n: u8) -> &'static str {\\n    match n {\\n        1 => \\\"ending_read\\\",\\n        2 => \\\"ending_chair\\\",\\n        _ => \\\"ending_burn\\\",\\n    }\\n}\\n\\n2750→trait Doomed {\\n    fn doomed_enough(&self) -> bool;\\n}\\nimpl Doomed for Companion {\\n    fn doomed_enough(&self) -> bool {\\n        false\\n    }\\n}\\n\\nfn ray_sphere(o: (f32, f32, f32), d: (f32, f32, f32), c: (f32, f32, f32), r: f32) -> Option<f32> {\\n2760→    let lx = c.0 - o.0;\\n    let ly = c.1 - o.1;\\n    let lz = c.2 - o.2;\\n    let b = lx * d.0 + ly * d.1 + lz * d.2;\\n    let cc = lx * lx + ly * ly + lz * lz - r * r;\\n    let disc = b * b - cc;\\n    if disc < 0.0 {\\n        return None;\\n    }\\n    let t = b - disc.sqrt();\\n2770→    (t > 0.05).then_some(t)\\n}\\n\\nfn ray_aabb(o: (f32, f32, f32), d: (f32, f32, f32), min: [f32; 3], max: [f32; 3]) -> Option<f32> {\\n    let mut t0 = 0.0f32;\\n    let mut t1 = 1.0e6f32;\\n    let origins = [o.0, o.1, o.2];\\n    let dirs = [d.0, d.1, d.2];\\n    for i in 0..3 {\\n        if dirs[i].abs() < 1e-8 {\\n2780→            if origins[i] < min[i] || origins[i] > max[i] {\\n                return None;\\n            }\\n            continue;\\n        }\\n        let inv = 1.0 / dirs[i];\\n        let mut ta = (min[i] - origins[i]) * inv;\\n        let mut tb = (max[i] - origins[i]) * inv;\\n        if ta > tb {\\n            std::mem::swap(&mut ta, &mut tb);\\n2790→        }\\n        t0 = t0.max(ta);\\n        t1 = t1.min(tb);\\n        if t0 > t1 {\\n            return None;\\n        }\\n    }\\n    (t0 > 0.05).then_some(t0)\\n}\\