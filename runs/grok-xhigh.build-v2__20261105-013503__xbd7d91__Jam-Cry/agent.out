-> String {\\n        serde_json::to_string(self).unwrap_or_else(|_| \\\"{}\\\".into())\\n    }\\n\\n2210→    pub fn load_json(text: &str) -> Result<Self, String> {\\n        serde_json::from_str(text).map_err(|e| e.to_string())\\n    }\\n\\n    pub fn write_save(&mut self) {\\n        if self.hub {\\n            return;\\n        }\\n        self.save_blob = String::new();\\n        let blob = self.save_json();\\n2220→        self.save_blob = blob;\\n        self.has_save = true;\\n        self.saves_written += 1;\\n    }\\n\\n    pub fn fingerprint(&self) -> u64 {\\n        let s = serde_json::to_string(self).unwrap_or_default();\\n        let mut h = 0xcbf29ce484222325u64;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs\",\"offset\":2188,\"limit\":40,\"raw_output\":\"            }\\n            self.mark(\\\"explosion_chain\\\");\\n            self.mark(\\\"ignite_barrel\\\");\\n            if self.fire.burned >= 500 {\\n                self.mark(\\\"cells_500\\\");\\n            }\\n        }\\n    }\\n\\n    pub fn hour(&self) -> f32 {\\n        (self.minutes / 60.0) % 24.0\\n    }\\n\\n    pub fn tracker_rate(&self) -> f32 {\\n        let d = geom::dist(self.x, self.z, self.tracker_cache.0, self.tracker_cache.1).max(1.0);\\n        if d > 60.0 { 0.0 } else { 8.0 / d }\\n    }\\n\\n    pub fn save_json(&self) -> String {\\n        serde_json::to_string(self).unwrap_or_else(|_| \\\"{}\\\".into())\\n    }\\n\\n    pub fn load_json(text: &str) -> Result<Self, String> {\\n        serde_json::from_str(text).map_err(|e| e.to_string())\\n    }\\n\\n    pub fn write_save(&mut self) {\\n        if self.hub {\\n            return;\\n        }\\n        self.save_blob = String::new();\\n        let blob = self.save_json();\\n        self.save_blob = blob;\\n        self.has_save = true;\\n        self.saves_written += 1;\\