) => \\\"break\\\",\"},{\"line_number\":689,\"content\":\"            Some(Spec::Rescue) => \\\"rescue\\\",\"},{\"line_number\":690,\"content\":\"            Some(Spec::Wound(n)) => return format!(\\\"wound{n}\\\"),\"},{\"line_number\":691,\"content\":\"            Some(Spec::Loot) => \\\"loot\\\",\"},{\"line_number\":692,\"content\":\"            Some(Spec::Claim) => \\\"claim\\\",\"},{\"line_number\":693,\"content\":\"            Some(Spec::Shop) => \\\"shop\\\",\"},{\"line_number\":694,\"content\":\"            Some(Spec::Locker) => \\\"locker\\\",\"},{\"line_number\":695,\"content\":\"            Some(Spec::Syrette) => \\\"syrette\\\",\"},{\"line_number\":696,\"content\":\"            Some(Spec::Tracker) => \\\"tracker\\\",\"},{\"line_number\":697,\"content\":\"            Some(Spec::Sleep { .. }) => \\\"sleep\\\",\"},{\"line_number\":698,\"content\":\"            Some(Spec::Drive { .. }) => \\\"drive\\\",\"},{\"line_number\":699,\"content\":\"            Some(Spec::Mono) => \\\"mono\\\",\"},{\"line_number\":700,\"content\":\"            Some(Spec::Ignite(n)) => return format!(\\\"ignite{n}\\\"),\"},{\"line_number\":701,\"content\":\"            Some(Spec::Tanks) => \\\"tanks\\\",\"},{\"line_number\":702,\"content\":\"            Some(Spec::Mounted) => \\\"mounted\\\",\"},{\"line_number\":703,\"content\":\"            Some(Spec::Panic) => \\\"panic\\\",\"},{\"line_number\":704,\"content\":\"            Some(Spec::Animals) => \\\"animals\\\",\"},{\"line_number\":705,\"content\":\"            Some(Spec::Bus { .. }) => \\\"bus\\\",\"},{\"line_number\":706,\"content\":\"            Some(Spec::Night) => \\\"night\\\",\"},{\"line_number\":707,\"content\":\"            Some(Spec::Boat) => \\\"boat\\\",\"},{\"line_number\":708,\"content\":\"            Some(Spec::Stealth) => \\\"stealth\\\",\"},{\"line_number\":709,\"content\":\"            Some(Spec::Dart) => \\\"dart\\\",\"},{\"line_number\":710,\"content\":\"            Some(Spec::Repair) => \\\"repair\\\",\"},{\"lin