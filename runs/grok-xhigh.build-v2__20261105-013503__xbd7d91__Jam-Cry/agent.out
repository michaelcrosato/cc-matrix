oute::Sandbox);\\n        w.screen = Screen::Playing;\\n        w.x = 200.0;\\n        w.z = -200.0;\\n        w.guns = vec![Gun::new(WeaponId::Pistol), Gun::new(WeaponId::Ar)];\\n        w.diamonds = 40;\\n        w.syrettes = 3;\\n        w.pills = 3;\\n        w.slot = 0;\\n        w\\n    }\\n\\n    pub fn campaign(seed: u64, route: Route) -> Self {\\n        let mut w = Self::blank(seed, route);\\n        w.screen = Screen::Title;\\n        w.guns = vec![Gun::new(WeaponId::Pistol)];\\n        w.diamonds = 40;\\n        w.syrettes = 3;\\n        w.pills = 3;\\n        w\\n    }\\n\\n    fn blank(seed: u64, route: Route) -> Self {\\n        let tune = Tune::default();\\n        Self {\\n            seed,\\n            rng: Rng::new(seed),\\n            route,\\n            screen: Screen::Title,\\n            focus: 0,\\n            tab: 0,\\n            page: 0,\\n            difficulty: 1,\\n            merc: 0,\\n            x: 0.0,\\n            z: 0.0,\\n            yaw: 0.0,\\n            pitch: 0.05,\\n            roll: 0.0,\\n            eye: 1.58,\\n            stance: 0,\\n            stamina: 12.0,\\n            hp: 100.0,\\n            syrettes: 3,\\n            pills: 3,\\n            diamonds: 40,\\n            infamy: 0,\\n            guns: vec![Gun::new(WeaponId::Pistol)],\\n            slot: 0,\\n            syrette_t: 0.0,\\n            heal_t: 0.0,\\n            wound: 0,\\n            pill_t: 0.0,\\n            fever_t: 0.0,\\n            fever_state: 0,\\n            fever_warn: 0.0,\\n            fever_attack: 0.0,\\n            bodies: Vec::new(),\\n            walls: Vec::new(),\\n            fire: FireMap::default(),\\n            wind: Vec2::new(2.0, 0.5),\\n            weather: 0,\\n            minutes: 12.0 * 60.0,\\n            ceasefire: true,\\n            companions: vec![\\n                Companion { name: \\\"Tomek Wrona\\\".into(), alive: true, down: false, down_t: 0.0, rescue_spent: false, x: 0.0, z: 0.0 },\\n                Companion { name: \\\"Rafael Quintero\\\".into(), alive: true, down: false, down_t: 0.0, rescue_spent: false, x: 0.0, z: 0.0 },\\n                Companion { name: \\\"Mirela Dragan\\\".into(), alive: true, down: false, down_t: 0.0, rescue_spent: false, x: 0.0, z: 0.0 },\\n            ],\\n            rescue_t: 0.0,\\n            ride: Ride::default(),\\n            flags: BTreeSet::new(),\\n            step: 0,\\n            step_ready: false,\\n            step_t: 0.0,\\n            step_x: 0.0,\\n            step_z: 0.0,\\n            waypoint: None,\\n            map_t: 0.0,\\n            mono_t: 0.0,\\n            post_clear: false,\\n            post_reman_at: 1.0e9,\\n            looking_at_post: false,\\n            saves_written: 0,\\n            save_blob: String::new(),\\n            has_save: false,\\n            idle: 0.0,\\n            attract_t: 0.0,\\n            attract_seen: 0,\\n            attract_loops: 0,\\n            device: Device::Gamepad,\\n            device_lock: 0,\\n            xbox: false,\\n            tune0: tune.clone(),\\n            tune,\\n            dev: Dev::default(),\\n            hub: false,\\n            touch_only: false,\\n            music: 0.10,\\n            finished: false,\\n            hold_t: 0.0,\\n            tracker_cache: (90.0, 500.0),\\n            treating: false,\\n            jam_seen: false,\\n            boat_dist: 0.0,\\n            pointer: None,\\n            pointer_click: false,\\n        }\\n    }\\n\\n    pub fn mark(&mut self, flag: &str) {\\n        self.flags.insert(flag.to_string());\\n    }\\n\\n    pub fn gun(&self) -> &Gun {\\n        &self.guns[self.slot.min(self.guns.len().saturating_sub(1))]\\n    }\\n    pub fn gun_mut(&mut self) -> &mut Gun {\\n        let i = self.slot.min(self.guns.len().saturating_sub(1));\\n        &mut self.guns[i]\\n    }\\n\\n    pub fn spawn_dummy(&mut self, x: f32, z: f32, hp: f32) -> usize {\\n        self.bodies.push(Body {\\n            kind: 4,\\n            x,\\n            z,\\n            yaw: 0.0,\\n            hp,\\n            alive: true,\\n            alert: 0,\\n            gun: Gun::new(WeaponId::Pistol),\\n            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n        self.bodies.len() - 1\\n    }\\n\\n    pub fn add_wall(&mut self, min: [f32; 3], max: [f32; 3]) {\\n        self.walls.push(Wall { min, max });\\n    }\\n\\n    pub fn tick(&mut self, input: &InputFrame, dt: f32) {\\n        let dt = dt.clamp(0.0, 0.5);\\n        self.apply_console(input);\\n        if self.screen != Screen::Playing {\\n            self.shell_tick(input, dt);\\n        } else if input.act == 10 && !self.hub {\\n            self.screen = Screen::Pause;\\n            self.focus = 0;\\n            self.idle = 0.0;\\n        } else {\\n            self.simulate(input, dt);\\n        }\\n        if self.route != Route::Sandbox {\\n            self.advance_script(dt);\\n        }\\n        if self.wind.length() > 6.0 && self.screen == Screen::Playing {\\n            self.mark(\\\"wind_rag\\\");\\n        }\\n        self.minutes += dt;\\n        self.maybe_reman();\\n    }\\n\\n    /// Numbered actions from the page. These run on every screen, including play,\\n    /// because the shell does not tick while a contract is running.\\n    fn apply_console(&mut self, input: &InputFrame) {\\n        match input.act {\\n            11 => self.dev.god = !self.dev.god,\\n            12 => {\\n                let (lo, hi, step) = self.tune.range(8);\\n                self.tune.set(8, (self.tune.get(8) + step).clamp(lo, hi));\\n            }\\n            13 => self.tune = self.tune0.clone(),\\n            14 => self.xbox = !self.xbox,\\n            15 => self.write_save(),\\n            16 => self.continue_save(),\\n            18 => {\\n                self.screen = Screen::Settings;\\n                self.tab = 0;\\n                self.focus = 0;\\n                self.idle = 0.0;\\n            }\\n            _ => {}\\n        }\\n    }\\n\\n    pub fn continue_save(&mut self) {\\n        if !self.has_save {\\n            return;\\n        }\\n        let Ok(w) = Self::load_json(&self.save_blob) else { return };\\n        let saves = self.saves_written;\\n        let blob = self.save_blob.clone();\\n        *self = w;\\n        self.saves_written = saves;\\n        self.save_blob = blob;\\n        self.has_save = true;\\n        self.screen = Screen::Playing;\\n    }\\n\\n    pub fn bot_input(&self) -> InputFrame {\\n        if self.screen != Screen::Playing {\\n            let mut f = InputFrame::default();\\n            f.act = 1;\\n            f.pressed = buttons::CONFIRM;\\n            return f;\\n        }\\n        let Some(spec) = self.current() else {\\n            return InputFrame::default();\\n        };\\n        self.bot_spec(spec)\\n    }\\n\\n    fn current(&self) -> Option<Spec> {\\n        script(self.route).get(self.step as usize).copied()\\n    }\\n\\n    pub fn goal_name(&self) -> String {\\n        if self.finished {\\n            return \\\"done\\\".into();\\n        }\\n        match self.current() {\\n            Some(Spec::Boot) => \\\"boot\\\",\\n            Some(Spec::Map) => \\\"map\\\",\\n            Some(Spec::Way) => \\\"waypoint\\\",\\n            Some(Spec::Reach { .. }) => \\\"reach\\\",\\n            Some(Spec::Fever) => \\\"fever\\\",\\n            Some(Spec::Pill) => \\\"pill\\\",\\n            Some(Spec::Blackout) => \\\"blackout\\\",\\n            Some(Spec::Fight) => \\\"fight\\\",\\n            Some(Spec::EnemyJam) => \\\"enemy_jam\\\",\\n            Some(Spec::Jam) => \\\"jam\\\",\\n            Some(Spec::Break) => \\\"break\\\",\\n            Some(Spec::Rescue) => \\\"rescue\\\",\\n            Some(Spec::Wound(n)) => return format!(\\\"wound{n}\\\"),\\n            Some(Spec::Loot) => \\\"loot\\\",\\n            Some(Spec::Claim) => \\\"claim\\\",\\n            Some(Spec::Shop) => \\\"shop\\\",\\n            Some(Spec::Locker) => \\\"locker\\\",\\n            Some(Spec::Syrette) => \\\"syrette\\\",\\n            Some(Spec::Tracker) => \\\"tracker\\\",\\n            Some(Spec::Sleep { .. }) => \\\"sleep\\\",\\n            Some(Spec::Drive { .. }) => \\\"drive\\\",\\n            Some(Spec::Mono) => \\\"mono\\\",\\n            Some(Spec::Ignite(n)) => return format!(\\\"ignite{n}\\\"),\\n            Some(Spec::Tanks) => \\\"tanks\\\",\\n            Some(Spec::Mounted) => \\\"mounted\\\",\\n            Some(Spec::Panic) => \\\"panic\\\",\\n            Some(Spec::Animals) => \\\"animals\\\",\\n            Some(Spec::Bus { .. }) => \\\"bus\\\",\\n            Some(Spec::Night) => \\\"night\\\",\\n            Some(Spec::Boat) => \\\"boat\\\",\\n            Some(Spec::Stealth) => \\\"stealth\\\",\\n            Some(Spec::Dart) => \\\"dart\\\",\\n            Some(Spec::Repair) => \\\"repair\\\",\\n            Some(Spec::Rain) => \\\"rain\\\",\\n            Some(Spec::Better) => \\\"better\\\",\\n            Some(Spec::Patch) => \\\"patch\\\",\\n            Some(Spec::Overdose) => \\\"overdose\\\",\\n            Some(Spec::Die) => \\\"die\\\",\\n            Some(Spec::Tape) => \\\"tape\\\",\\n            Some(Spec::Ceasefire) => \\\"ceasefire\\\",\\n            Some(Spec::Convoy) => \\\"convoy\\\",\\n            Some(Spec::Town) => \\\"town\\\",\\n            Some(Spec::Ending(n)) => return format!(\\\"ending{n}\\\"),\\n            Some(Spec::Flag(s)) => s,\\n            None => \\\"done\\\",\\n        }\\n        .into()\\n    }\\n\\n    pub fn goal_budget(&self) -> f32 {\\n        match self.current() {\\n            Some(Spec::Reach { .. }) => 160.0,\\n            Some(Spec::Drive { .. }) => 140.0,\\n            Some(Spec::Boat) => 160.0,\\n            Some(Spec::Bus { .. }) => 90.0,\\n            Some(Spec::Blackout) => 80.0,\\n            Some(Spec::Break) => 90.0,\\n            Some(Spec::Die) => 55.0,\\n            Some(Spec::Ending(1)) => 200.0,\\n            Some(Spec::Sleep { .. }) | Some(Spec::Tracker) => 50.0,\\n            Some(Spec::Fight) | Some(Spec::EnemyJam) => 25.0,\\n            _ => 30.0,\\n        }\\n    }\\n\\n    fn advance_script(&mut self, dt: f32) {\\n        if self.finished {\\n            return;\\n        }\\n        self.step_t += dt;\\n        for _ in 0..12 {\\n            let Some(spec) = self.current() else {\\n                self.finished = true;\\n                break;\\n            };\\n            if !self.step_ready {\\n                self.begin(spec);\\n                self.step_ready = true;\\n                self.step_t = 0.0;\\n            }\\n            if self.done(spec) {\\n                self.step += 1;\\n                self.step_ready = false;\\n                self.step_t = 0.0;\\n            } else {\\n                break;\\n            }\\n        }\\n    }\\n\\n    fn begin(&mut self, spec: Spec) {\\n        self.step_x = self.x;\\n        self.step_z = self.z;\\n        self.hold_t = 0.0;\\n        match spec {\\n            Spec::Fever => {\\n                self.fever_t = self.tune.fever_interval;\\n            }\\n            Spec::Blackout => {\\n                self.pills = 0;\\n                self.fever_state = 2;\\n                self.fever_attack = 0.0;\\n\",\"total_lines\":2449}}","is_error":false},{"type":"tool_result","tool_use_id":"call-32f3f6cf-e541-4312-9bce-95629603ddfb-97","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"160→            self.go_back();\\n        }\\n        if activate {\\n            let rows = self.rows();\\n            let label = rows.get(self.focus).cloned().unwrap_or_default();\\n            self.activate(&label);\\n        }\\n    }\\n\\n    fn go_back(&mut self) {\\n170→        self.focus = 0;\\n        match self.screen {\\n            Screen::Difficulty | Screen::Settings | Screen::About | Screen::Mp => self.screen = Screen::Title,\\n            Screen::Merc => self.screen = Screen::Difficulty,\\n            Screen::Prologue => self.screen = Screen::Merc,\\n            Screen::Dev if self.tab != 0 => self.tab = 0,\\n            Screen::Dev => self.screen = Screen::Pause,\\n            Screen::Pause => self.screen = Screen::Playing,\\n            _ => {}\\n        }\\n180→    }\\n\\n    fn nudge_slider(&mut self, dir: f32) {\\n        if self.screen != Screen::Dev || self.tab != 5 {\\n            if self.screen == Screen::Settings && self.tab == 0 && self.focus == 1 {\\n                self.music = (self.music + dir * 0.05).clamp(0.0, 1.0);\\n            }\\n            return;\\n        }\\n        let count = self.tune.count();\\n190→        let page_size = 6;\\n        let index = self.page * page_size + self.focus;\\n        if self.focus == 6 || index >= count {\\n            if dir < 0.0 && self.page > 0 {\\n                self.page -= 1;\\n                self.focus = 0;\\n            }\\n            return;\\n        }\\n        let (lo, hi, step) = self.tune.range(index);\\n200→        let v = (self.tune.get(index) + dir * step).clamp(lo, hi);\\n        self.tune.set(index, v);\\n    }\\n\\n    fn activate(&mut self, label: &str) {\\n        match self.screen {\\n            Screen::Title => match label {\\n                \\\"Continue\\\" => self.continue_save(),\\n                \\\"New contract\\\" => {\\n                    self.screen = Screen::Difficulty;\\n210→                    self.focus = 1;\\n                }\\n                \\\"Multiplayer\\\" => {\\n                    self.screen = Screen::Mp;\\n                    self.focus = 0;\\n                }\\n                \\\"Settings\\\" => {\\n                    self.screen = Screen::Settings;\\n                    self.tab = 0;\\n                    self.focus = 0;\\n220→                }\\n                \\\"About\\\" => {\\n                    self.screen = Screen::About;\\n                    self.page = 0;\\n                    self.focus = 0;\\n                }\\n                _ => {}\\n            },\\n            Screen::Difficulty => {\\n                self.difficulty = match label {\\n230→                    \\\"Easy\\\" => 0,\\n                    \\\"Hard\\\" => 2,\\n                    _ => 1,\\n                };\\n                self.screen = Screen::Merc;\\n                self.focus = 0;\\n            }\\n            Screen::Merc => {\\n                self.merc = match label {\\n                    \\\"Tomek Wrona\\\" => 1,\\n240→                    \\\"Rafael Quintero\\\" => 2,\\n                    \\\"Mirela Dragan\\\" => 3,\\n                    _ => 0,\\n                };\\n                self.screen = Screen::Prologue;\\n                self.focus = 0;\\n            }\\n            Screen::Prologue => {\\n                if label == \\\"Begin\\\" {\\n                    self.start_playing();\\n250→                }\\n            }\\n            Screen::Pause => match label {\\n                \\\"Resume\\\" => self.screen = Screen::Playing,\\n                \\\"Settings\\\" => {\\n                    self.screen = Screen::Settings;\\n                    self.focus = 0;\\n                }\\n                \\\"Controls\\\" => {\\n                    self.screen = Screen::Settings;\\n260→                    self.tab = 1;\\n                    self.focus = 0;\\n                }\\n                \\\"Dev mode\\\" if !self.hub => {\\n                    self.screen = Screen::Dev;\\n                    self.tab = 0;\\n                    self.page = 0;\\n                    self.focus = 0;\\n                }\\n                \\\"Quit to title\\\" => {\\n270→                    self.screen = Screen::Title;\\n                    self.focus = 0;\\n                }\\n                _ => {}\\n            },\\n            Screen::Settings => {\\n                if label == \\\"Xbox glyphs\\\" {\\n                    self.xbox = true;\\n                } else if label == \\\"PlayStation glyphs\\\" {\\n                    self.xbox = false;\\n280→                } else if label.starts_with(\\\"Page\\\") {\\n                    self.tab = (self.tab + 1) % 4;\\n                    self.focus = 0;\\n                }\\n            }\\n            Screen::Dev => {\\n                if self.tab == 0 {\\n                    self.tab = match label {\\n                        \\\"Cheats\\\" => 1,\\n                        \\\"Teleport\\\" => 2,\\n290→                        \\\"Spawn\\\" => 3,\\n                        \\\"World\\\" => 4,\\n                        \\\"Balance\\\" => 5,\\n                        _ => 0,\\n                    };\\n                    self.page = 0;\\n                    self.focus = 0;\\n                    return;\\n                }\\n                if label == \\\"Reset to defaults\\\" {\\n300→                    self.tune = self.tune0.clone();\\n                    return;\\n                }\\n                if label == \\\"Next page\\\" {\\n                    self.page += 1;\\n                    self.focus = 0;\\n                    return;\\n                }\\n                if self.tab == 1 {\\n                    self.toggle_cheat(label);\\n310→                }\\n            }\\n            Screen::About => {\\n                if label == \\\"Next\\\" {\\n                    self.page += 1;\\n                } else if label == \\\"Back\\\" && self.page > 0 {\\n                    self.page -= 1;\\n                } else if label == \\\"Back\\\" {\\n                    self.screen = Screen::Title;\\n                    self.focus = 0;\\n320→                }\\n            }\\n            Screen::Mp => {\\n                if label == \\\"Back\\\" {\\n                    self.screen = Screen::Title;\\n                }\\n            }\\n            _ => {}\\n        }\\n    }\\n330→\\n    fn toggle_cheat(&mut self, label: &str) {\\n        let d = &mut self.dev;\\n        match label {\\n            \\\"God mode\\\" => d.god = !d.god,\\n            \\\"Infinite ammo\\\" => d.infinite = !d.infinite,\\n            \\\"No jams\\\" => d.no_jams = !d.no_jams,\\n            \\\"No fever\\\" => d.no_fever = !d.no_fever,\\n            \\\"Noclip\\\" => d.noclip = !d.noclip,\\n            \\\"Invisible\\\" => d.invisible = !d.invisible,\\n340→            \\\"Show AI\\\" => d.show_ai = !d.show_ai,\\n            \\\"Show fire\\\" => d.show_fire = !d.show_fire,\\n            \\\"Show nav\\\" => d.show_nav = !d.show_nav,\\n            \\\"Show stats\\\" => d.show_stats = !d.show_stats,\\n            _ => {}\\n        }\\n    }\\n\\n    pub fn rows(&self) -> Vec<String> {\\n        let all: Vec<String> = match self.screen {\\n350→            Screen::Title => {\\n                let mut r = Vec::new();\\n                if self.has_save {\\n                    r.push(\\\"Continue\\\".into());\\n                }\\n                r.extend([\\\"New contract\\\".into(), \\\"Multiplayer\\\".into(), \\\"Settings\\\".into(), \\\"About\\\".into()]);\\n                r\\n            }\\n            Screen::Difficulty => vec![\\\"Easy\\\".into(), \\\"Normal\\\".into(), \\\"Hard\\\".into()],\\n            Screen::Merc => vec![\\\"Ada Okoro\\\".into(), \\\"Tomek Wrona\\\".into(), \\\"Rafael Quintero\\\".into(), \\\"Mirela Dragan\\\".into()],\\n360→            Screen::Prologue => vec![\\\"Begin\\\".into()],\\n            Screen::Pause => {\\n                let mut rows = vec![\\\"Resume\\\".into(), \\\"Settings\\\".into(), \\\"Controls\\\".into()];\\n                if !self.hub {\\n                    rows.push(\\\"Dev mode\\\".into());\\n                }\\n                rows.push(\\\"Quit to title\\\".into());\\n                rows\\n            }\\n            Screen::Settings => self.settings_rows(),\\n370→            Screen::About => vec![\\\"Next\\\".into(), \\\"Back\\\".into()],\\n            Screen::Dev => self.dev_rows(),\\n            Screen::Mp => vec![\\\"This computer\\\".into(), \\\"Invite code\\\".into(), \\\"Back\\\".into()],\\n            Screen::Attract => vec![\\\"Press any button\\\".into()],\\n            Screen::Playing => vec![],\\n        };\\n        all.into_iter().take(7).collect()\\n    }\\n\\n    fn settings_rows(&self) -> Vec<String> {\\n380→        match self.tab % 4 {\\n            0 => vec![\\\"Master\\\".into(), \\\"Music\\\".into(), \\\"Effects\\\".into(), \\\"Voices\\\".into(), \\\"Page\\\".into()],\\n            1 => vec![\\\"PlayStation glyphs\\\".into(), \\\"Xbox glyphs\\\".into(), \\\"Invert look\\\".into(), \\\"Sensitivity\\\".into(), \\\"Aim assist\\\".into(), \\\"Page\\\".into()],\\n            2 => vec![\\\"Fullscreen\\\".into(), \\\"Field of view\\\".into(), \\\"Brightness\\\".into(), \\\"Head bob\\\".into(), \\\"Page\\\".into()],\\n            _ => vec![\\\"Subtitle size\\\".into(), \\\"Reduce motion\\\".into(), \\\"Assist markers\\\".into(), \\\"Immersive hud\\\".into(), \\\"Page\\\".into()],\\n        }\\n    }\\n\\n    fn dev_rows(&self) -> Vec<String> {\\n        match self.tab {\\n390→            0 => vec![\\\"Cheats\\\".into(), \\\"Teleport\\\".into(), \\\"Spawn\\\".into(), \\\"World\\\".into(), \\\"Balance\\\".into()],\\n            1 => {\\n                let names = [\\\"God mode\\\", \\\"Infinite ammo\\\", \\\"No jams\\\", \\\"No fever\\\", \\\"Noclip\\\", \\\"Invisible\\\", \\\"Show AI\\\", \\\"Show fire\\\", \\\"Show nav\\\", \\\"Show stats\\\"];\\n                self.page_of(&names)\\n            }\\n            2 => {\\n                let names: Vec<&str> = super::geom::PLACES.iter().map(|p| p.name).collect();\\n                self.page_of_owned(names)\\n            }\\n            5 => {\\n400→                let mut rows = Vec::new();\\n                let start = self.page * 6;\\n                for i in start..(start + 6).min(self.tune.count()) {\\n                    rows.push(format!(\\\"{} {:.2}\\\", self.tune.name(i), self.tune.get(i)));\\n                }\\n                rows.push(\\\"Reset