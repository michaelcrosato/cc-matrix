  \\\"focus\\\": self.focus,\\n            \\\"label\\\": self.rows().get(self.focus).cloned().unwrap_or_default(),\\n            \\\"notice\\\": self.notice(),\\n            \\\"touch_controls\\\": false,\\n            \\\"glyph\\\": shell::glyph(\\\"confirm\\\", self.device, self.xbox),\\n            \\\"xbox\\\": self.xbox,\\n            \\\"device\\\": format!(\\\"{:?}\\\", self.device),\\n            \\\"about\\\": about_pages(),\\n        })\\n    }\\n}\\n\\nfn wound_flag(n: u8) -> &'static str {\\n    match n {\\n        1 => \\\"wound_gunshot\\\",\\n        2 => \\\"wound_shrapnel\\\",\\n        3 => \\\"wound_burn\\\",\\n        4 => \\\"wound_fall\\\",\\n        5 => \\\"wound_tourniquet\\\",\\n        _ => \\\"wound_graze\\\",\\n    }\\n}\\n\\nfn ignite_flag(n: u8) -> &'static str {\\n    match n {\\n        0 => \\\"ignite_flare\\\",\\n        1 => \\\"ignite_rocket\\\",\\n        2 => \\\"ignite_flamer\\\",\\n        3 => \\\"ignite_mortar\\\",\\n        4 => \\\"ignite_molotov\\\",\\n        5 => \\\"ignite_frag\\\",\\n        6 => \\\"ignite_barrel\\\",\\n        7 => \\\"ignite_vehicle\\\",\\n        8 => \\\"ignite_person\\\",\\n        9 => \\\"ignite_lightning\\\",\\n        10 => \\\"ignite_tracer\\\",\\n        _ => \\\"ignite_cigarette\\\",\\n    }\\n}\\n\\nfn ending_flag(n: u8) -> &'static str {\\n\",\"total_lines\":2363}}","is_error":false},{"type":"tool_result","tool_use_id":"call-161c4eba-48f7-423c-81e1-bd6ac7db47b1-17","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"200→    prefs: crate::save::Prefs,\\n    scaler: crate::quality::Scaler,\\n    #[cfg(not(target_arch = \\\"wasm32\\\"))]\\n    bridge: Option<crate::bridge::Bridge>,\\n    #[cfg(target_arch = \\\"wasm32\\\")]\\n    pending_gfx: Option<std::rc::Rc<std::cell::RefCell<Option<Result<Gfx>>>>>,\\n    #[cfg(target_arch = \\\"wasm32\\\")]\\n    audio_resumed: bool,\\n    init_started: bool,\\n    pub fatal: Option<String>,\\n210→}\\n\\nimpl App {\\n    fn new(settings: