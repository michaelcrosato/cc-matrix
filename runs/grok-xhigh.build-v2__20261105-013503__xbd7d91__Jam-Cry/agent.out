ent\":\"        Self { cells: BTreeMap::new(), acc: 0.0, burned: 0, wind_for_test: Vec2::ZERO }\"},{\"line_number\":62,\"content\":\"        self.burned += 1;\"},{\"line_number\":66,\"content\":\"    pub fn ignite_disk(&mut self, x: f32, z: f32, radius: f32, life: f32, minutes: f32) -> u32 {\"},{\"line_number\":174,\"content\":\"    /// Reach along the wind axis, in metres, of every cell that has burned.\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"2e1d4ad3-58e9-417c-9a08-e35dd50568cd"}
