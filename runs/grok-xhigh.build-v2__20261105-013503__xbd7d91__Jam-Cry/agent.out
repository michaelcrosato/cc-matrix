e());\\n160→                    ui.end_row();\\n                }\\n            });\\n        });\\n    });\\n}\\n\\npub fn pause_menu(\\n    ctx: &egui::Context,\\n    device: Device,\\n170→    scene: &str,\\n    difficulty: Option<&mut pav_core::arpg::Difficulty>,\\n) -> Option<MenuAction> {\\n    let mut action = None;\\n    let game = difficulty.is_some();\\n    egui::Window::new(\\\"Paused\\\")\\n        .anchor(egui::Align2::CENTER_CENTER, [0.0, 0.0])\\n        .collapsible(false)\\n        .resizable(false)\\n        .show(ctx, |ui| {\\n180→            ui.label(format!(\\\"Room: {scene}\\\"));\\n            ui.horizontal(|ui| {\\n                if ui.button(\\\"Resume (Esc)\\\").clicked() {\\n                    action = Some(MenuAction::Resume);\\n                }\\n                if ui.button(\\\"Rooms (F2)\\\").clicked() {\\n                    action = Some(MenuAction::Rooms);\\n                }\\n                if ui.button(\\\"Room info\\\").clicked() {\\n                    action = Some(MenuAction::RoomCard);\",\"content_concise\":\"140→            RichText::new(text).small().color(Color32::from_white_alpha(200)).background_color(Color32::from_black_alpha(110)),\\n        );\\n    });\\n}\\n\\npub fn guide_panel(ctx: &egui::Context, device: Device, game: bool) {\\n    egui::Area::new(egui::Id::new(\\\"guide\\\")).anchor(egui::Align2::LEFT_BOTTOM, [10.0, -30.0]).show(ctx, |ui| {\\n        egui::Frame::popup(ui.style()).show(ui, |ui| {\\n            ui.label(\\n                RichText::new(match device {\\n150→                    Device::KeyboardMouse => \\\"Controls (keyboard + mouse)\\\",\\n                    Device::Gamepad => \\\"Controls (gamepad)\\\",\\n                    Device::Touch => \\\"Controls (touch)\\\",\\n                })\\n                .strong(),\\n            );\\n            egui::Grid::new(\\\"guide_grid\\\").show(ui, |ui| {\\n                for (a, k) in if game { crate::input::game_guide(device) } else { guide(device) } {\\n                    ui.label(*a);\\n                    ui.label(RichText::new(*k).monospace());\\n160→                    ui.end_row();\\n                }\\n            });\\n        });\\n    });\\n}\\n\\npub fn pause_menu(\\n    ctx: &egui::Context,\\n    device: Device,\\n170→    scene: &str,\\n    difficulty: Option<&mut pav_core::arpg::Difficulty>,\\n) -> Option<MenuAction> {\\n    let mut action = None;\\n    let game = difficulty.is_some();\\n    egui::Window::new(\\\"Paused\\\")\\n        .anchor(egui::Align2::CENTER_CENTER, [0.0, 0.0])\\n        .collapsible(false)\\n        .resizable(false)\\n        .show(ctx, |ui| {\\n180→            ui.label(format!(\\\"Room: {scene}\\\"));\\n            ui.horizontal(|ui| {\\n                if ui.button(\\\"Resume (Esc)\\\").clicked() {\\n                    action = Some(MenuAction::Resume);\\n                }\\n                if ui.button(\\\"Rooms (F2)\\\").clicked() {\\n                    action = Some(MenuAction::Rooms);\\n                }\\n                if ui.button(\\\"Room info\\\").clicked() {\\n                    action = Some(MenuAction::RoomCard);\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_app/src/ui.rs\",\"offset\":140,\"limit\":50,\"raw_output\":\"            RichText::new(text).small().color(Color32::from_white_alpha(200)).background_color(Color32::from_black_alpha(110)),\\n        );\\n    });\\n}\\n\\npub fn guide_panel(ctx: &egui::Context, device: Device, game: bool) {\\n    egui::Area::new(egui::Id::new(\\\"guide\\\")).anchor(egui::Align2::LEFT_BOTTOM, [10.0, -30.0]).show(ctx, |ui| {\\n        egui::Frame::popup(ui.style()).show(ui, |ui| {\\n            ui.label(\\n                RichText::new(match device {\\n                    Device::KeyboardMouse => \\\"Controls (keyboard + mouse)\\\",\\n                    Device::Gamepad => \\\"Controls (gamepad)\