,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":1,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/hub/session.js\",\"matches\":[{\"line_number\":352,\"content\":\"  hub.send = function (data, opts) {\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-b606438b-49c2-4b55-aed3-9417091bba58-47","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"130→  return out;\\n}\\n\\n/**\\n * Check a host's standings: groups of ids, best first, every present player\\n * exactly once. Players already gone may be placed or left out; whoever is\\n * left out lands in a last group of their own.\\n */\\nexport function checkStandings(standings, presentIds, allIds) {\\n  if (!Array.isArray(standings)) return { ok: false, problem: 'standings is not an array' };\\n140→  const all = new Set(allIds);\\n  const seen = new Set();\\n  const groups = [];\\n  for (const group of standings) {\\n    const ids = Array.isArray(group) ? group : [group];\\n    const kept = [];\\n    for (const id of ids) {\\n      if (!Number.isInteger(id) || !all.has(id)) return { ok: false, problem: `unknown player id ${JSON.stringify(id)}` };\\n      if (seen.has(id)) return { ok: false, problem: `player ${id} is placed twice` };\\n      seen.add(id);\\n150→      kept.push(id);\\n    }\\n    if (kept.length) groups.push(kept);\\n  }\\n  const missing = presentIds.filter((id) => !seen.has(id));\\n  if (missing.length) return { ok: false, problem: `standings leave out player${missing.length > 1 ? 's' : ''} ${missing.join(', ')}` };\\n  const absent = allIds.filter((id) => !seen.has(id));\\n  if (absent.length) groups.push(absent);\\n  return { ok: true, standings: groups };\\n}\\n160→\\n/**\\n * @param {object} o\\n * @param {number} o.round            round number, carried on every message\\n * @param {{key:string, slot:number, name:string}[]} o.players\\n * @param {string} o.hostKey          whose game runs a shared world\\n * @param {string} [o.serverKey]      a copy with no player of its own that runs the shared world\\n *                                    instead (a server): one more copy after the players, welcomed\\n *                                    with server: true, never ranked; the round is void if it goes\\n * @param {string|null} o.mode        parallel | ghost | shared-world, or an older tag (modeOf); null takes the first hello's\",\"content_concise\":\"130→  return out;\\n}\\n\\n/**\\n * Check a host's standings: groups of ids, best first, every present player\\n * exactly once. Players already gone may be placed or left out; whoever is\\n * left out lands in a last group of their own.\\n */\\nexport function checkStandings(standings, presentIds, allIds) {\\n  if (!Array.isArray(standings)) return { ok: false, problem: 'standings is not an array' };\\n140→  const all = new Set(allIds);\\n  const seen = new Set();\\n  const groups = [];\\n  for (const group of standings) {\\n    const ids = Array.isArray(group) ? group : [group];\\n    const kept = [];\\n    for (const id of ids) {\\n      if (!Number.isInteger(id) || !all.has(id)) return { ok: false, problem: `unknown player id ${JSON.stringify(id)}` };\\n      if (seen.has(id)) return { ok: false, problem: `player ${id} is placed twice` };\\n      seen.add(id);\\n150→      kept.push(id);\\n    }\\n    if (kept.length) groups.push(kept);\\n  }\\n  const missing = presentIds.filter((id) => !seen.has(id));\\n  if (missing.length) return { ok: false, problem: `standings leave out player${missing.length > 1 ? 's' : ''} ${missing.join(', ')}` };\\n  const absent = allIds.filter((id) => !seen.has(id));\\n  if (absent.length) groups.push(absent);\\n  return { ok: true, standings: groups };\\n}\\n160→\\n/**\\n * @param {object} o\\n * @param {number} o.round            round number, carried on every message\\n * @param {{key:string, slot:number, name:string}[]} o.players\\n * @param {string} o.hostKey          whose game runs a shared world\\n * @param {string} [o.serverKey]      a copy with no player of its own that runs the shared world\\n *                                    instead (a server): one more copy after the players, welcomed\\n *                                    with server: true, never ranked; the round is void if it goes\\n * @param {string|null} o.mode        parallel | ghost | shared-world, or an older tag (modeOf); null takes the first hello's\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/hub/round.js\",\"offset\":130,\"limit\":40,\"raw_output\":\"  return out;\\n}\\n\\n/**\\n * Check a host's standings: groups of ids, best first, every present player\\n * exactly once. Players already gone may be placed or left out; whoever is\\n * left out lands in a last group of their own.\\n */\\nexport function checkStandings(standings, presentIds, allIds) {\\n  if (!Array.isArray(standings)) return { ok: false, problem: 'standings is not an array' };\\n  const all = new Set(allIds);\\n  const seen = new Set();\\n  const groups = [];\\n  for (const group of standings) {\\n    const ids = Array.isArray(group) ? group : [group];\\n    const kept = [];\\n    for (const id of ids) {\\n      if (!Number.isInteger(id) || !all.has(id)) return { ok: false, problem: `unknown player id ${JSON.stringify(id)}` };\\n      if (seen.has(id)) return { ok: false, problem: `player ${id} is placed twice` };\\n      seen.add(id);\\n      kept.push(id);\\n    }\\n    if (kept.length) groups.push(kept);\\n  }\\n  const missing = presentIds.filter((id) => !seen.has(id));\\n  if (missing.length) return { ok: false, problem: `standings leave out player${missing.length > 1 ? 's' : ''} ${missing.join(', ')}` };\\n  const absent = allIds.filter((id) => !seen.has(id));\\n  if (absent.length) groups.push(absent);\\n  return { ok: true, standings: groups };\\n}\\n\\n/**\\n * @param {object} o\\n * @param {number} o.round            round number, carried on every message\\n * @param {{key:string, slot:number, name:string}[]} o.players\\n * @param {string} o.hostKey          whose game runs a shared world\\n * @param {string} [o.serverKey]      a copy with no player of its own that runs the shared world\\n *                                    instead (a server): one more copy after the players, welcomed\\n *                                    with server: true, never ranked; the round is void if it goes\\n * @param {string|null} o.mode        parallel | ghost | shared-world, or an older tag (modeOf); null takes the first hello's\\n\",\"total_lines\":533}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"221444e3-0df1-4761-8662-c85f78f6ad95"}
{"type":"assistant","message":{"id":"msg_281","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"Noted that `warn()` likely calls `console.warn`, which is a warning rather than an error.\n\nA message-ack loop was found. Every ack triggers another ack, creating an infinite loop until rate limits drop messages. Rate limit warnings do not throw errors.\n\nThe harness only checks for error events, not console warnings, so the ack loop won't cause a harness failure. The loop may deplete rate limiter tokens and drop actual fire messages, but sent and received counts would still appear balanced. Acknowledging acknowledgments is wasteful yet safe for the harness.\n\nAdding a guard to skip acknowledgments for incoming ack messages. This prevents the storm from exhausting rate limiter tokens and dropping real fire or pose messages.\n\nThe message handler will be updated to accept the payload argument and skip acknowledgments for incoming ack messages. A burst fix is planned for simhost. Optional derive copying will remain if compilation succeeds. Gamepad test order and pointer lock are next.\n\nThe default device is Gamepad, so the glyph starts as Cross. The test requires Keyboard/Enter first, then a switch to Gamepad/Cross. Pressing Enter on the Title screen activates \"New contract\" and advances to Difficulty, but the glyph can still be verified there. Alternatively, act 3 sets the keyboard device without confirming, leaving the screen on Title while the glyph becomes Enter.\n\nThe test sequence queues act 3 to set the keyboard device and glyph Enter, then installs the gamepad stub and waits for glyph Cross. Act 14 toggles Xbox while keeping the device locked to Gamepad, producing glyph A. The pointer lock test will reach the playing screen through four confirms, starting from Title focus 0 New contract to Difficulty focus 1 Normal.\n\nThe pointer lock test must start from a clean localStorage state with no save present. Four confirm acts are required to reach the playing screen: Merc focus Ada, Prologue Begin, and Playing. These cannot be queued all at once because the last act overwrites any pending act; each act must be sent individually with a short wait for the screen change to register. The simulation publishes every 15 ticks, so one frame plus that interval is sufficient between acts.\n\nScreen changes register on the act tick, but UI updates wait for the next publish, which can be up to 250 ms later. The test will wait for `dataset.screen` with a 3-second timeout.\n\nThe burst fix removes `test=1`, yet publishing every 15 ticks remains sufficient at realtime speed.\n\nPublishing every tick in test mode would make tests snappier, but 15 ticks is acceptable.\n\nIf the GPU is slow, the 120-tick cap may allow one frame to process many ticks and publish several times.\n\nCanvas validation will sample pixels to confirm the scene is not a uniform clear color. WebGPU first-frame delays may require a 60–90 second timeout before the canvas appears.\n\nLaunches will run sequentially, one browser at a time, with the browser closed between each run. The WebKit test must be isolated and cannot run simultaneously with Chromium. The phone test will use a Playwright iPhone device with coarse pointer and no hover.\n\nThe Chromium device-emulation test will verify that touch-only mode is active. The notice string appears after the first publish once `touch_only` is set from the pull. The test must confirm that no touch stick or engine touch UI elements are present, and that `ui.touch_controls` is false.\n\nThe phone test will wait 11 seconds for the Attract screen to appear while the notice remains visible. The Settings button must stay visible when the notice is set. The pack script may need to inject a session before bundling, so a new pack.sh is being drafted that copies index.html to a temporary file.\n\nA Python script will replace the build marker, run wasm-bindgen and pack, then restore index.html in a trap. The existing build-web.sh always performs a full cargo build, but incremental builds are fast if sources are unchanged. If simhost is edited while the background compile is running, the first pass may compile stale code and require a second rebuild. The plan is to edit simhost and index.html now before the pav_app compilation starts, and check build progress during editing.\n\nThe `Flags` struct will use `#[derive(Copy, Clone)]` instead of manual implementations to avoid potential rustc ordering issues. The thread_local reference will compile cleanly with the derived trait. Confirmed that `web_sys::UrlSearchParams::new_with_str` accepts a `&str`, and that `document_element.get_attribute` returns an `Option<String>`.\n\nThe `is_some()` check correctly detects the attribute even when its value is empty, since it was set to `\"1\"`.\n\nNative compilation now calls `tick_cap(sim)`, which returns 8. This preserves the original loop behavior exactly.\n\nWasm non-test playing still caps at 8 ticks. Non-playing and test-mode Wasm now cap at 120 ticks for better catch-up.\n\nReady to implement.","signature":""},{"type":"tool_use","id":"call-fb423b52-a9b0-458d-915e-da0788395e55-48","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/PLAN.md","offset":70,"limit":40}},{"type":"tool_use","id":"call-fb423b52-a9b0-458d-915e-da0788395e55-49","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_app/src/simhost.rs","old_string":"            let cap = crate::merc_web::tick_cap(sim);\n            let burst = crate::merc_web::burst();\n            let mut n = 0;\n            while (burst || now >= self.next) && n < cap {\n                self.next += Duration::from_secs_f32(tick_wall);\n                tick_once(sim, self.next);\n                n += 1;\n            }","new_string":"            let cap = crate::merc_web::tick_cap(sim);\n            let mut n = 0;\n            while now >= self.next && n < cap {\n                self.next += Duration::from_secs_f32(tick_wall);\n                tick_once(sim, self.next);\n                n += 1;\n            }"}},{"type":"tool_use","id":"call-fb423b52-a9b0-458d-915e-da0788395e55-50","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_app/src/merc_web.rs","old_string":"    struct Flags {\n        ready: bool,\n        test: bool,\n        nodraw: bool,\n        server: bool,\n        restored: bool,\n        saved: u32,\n        pubs: u32,\n    }","new_string":"    #[derive(Clone, Copy)]\n    struct Flags {\n        ready: bool,\n        test: bool,\n        nodraw: bool,\n        server: bool,\n        restored: bool,\n        saved: u32,\n        pubs: u32,\n    }"}},{"type":"tool_use","id":"call-fb423b52-a9b0-458d-915e-da0788395e55-51","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_app/src/merc_web.rs","old_string":"    fn flags() -> Flags {\n        FLAGS.with(|c| c.get())\n    }\n\n    impl Copy for Flags {}\n    impl Clone for Flags {\n        fn clone(&self) -> Self {\n            *self\n        }\n    }\n\n    fn ensure() -> Flags {","new_string":"    fn flags() -> Flags {\n        FLAGS.with(|c| c.get())\n    }\n\n    fn ensure() -> Flags {"}},{"type":"tool_use","id":"call-fb423b52-a9b0-458d-915e-da0788395e55-52","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/web/index.html","old_string":"    AIHub.on('message', function () {\n      if (ended || !window.AIHub || AIHub.server) return;\n      AIHub.send({ t: 'ack' }, { reliable: true });\n    });","new_string":"    AIHub.on('message', function (data) {\n      if (ended || !window.AIHub || AIHub.server) return;\n      if (data && data.t === 'ack') return;\n      try { AIHub.send({ t: 'ack' }, { reliable: true }); } catch (e) {}\n    });"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":1269,"output_tokens":3004,"cache_read_input_tokens":105088,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"e23345e9-4760-4321-888b-b554288e9c2d"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-fb423b52-a9b0-458d-915e-da0788395e55-48","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"70→\\n### 2.3 Hub harness: confirmed passing on an engine page\\nI pasted `lib/hub/session.js` unmodified as the first script in the built page, right after `<meta charset>`, added the `hub:*` metas and a small connect/ready/send/finish shim, and served it with `harness.html`, `bridge.js` and `round.js`. **`window.__hubCheck.pass` was true** for all of these:\\n- `players=2`\\n- `players=4&latency=150&jitter=50&loss=5`\\n- `players=4&latency=150&jitter=50&loss=5&scenario=host-leave`\\n- `players=2&scenario=server`\\n\\nEach software-rendered copy reached `ready()` in under 2.5 s. The harness gives all copies 20 s, so build the session scene small and call `ready()` before the first drawn frame.\\n\\n80→**The game's own card passes too.** With `card:true` and a capture-phase `keydown` listener in the page's JS that calls `AIHub.answer('ready')` on Enter, the harness's extra check passed at 2 and 4 players and in the server case. The harness dispatches a synthetic Enter at the focused element, so answer it in the JS shim rather than waiting for the Rust side.\\n\\n### 2.4 Input in headless Chromium\\n- **Controller stub:** a plain-object stub works with gilrs on wasm (the engine logs \\\"gamepad connected\\\", the UI flips to gamepad prompts, and button 9 opens the menu):\\n  ```js\\n  window.__pad = { axes:[0,0,0,0], buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0})) };\\n  navigator.getGamepads = () => [{ id:'Stub (STANDARD GAMEPAD Vendor: 054c Product: 0ce6)', index:0, connected:true, mapping:'standard',\\n    timestamp:performance.now(), axes:window.__pad.axes.slice(), buttons:window.__pad.buttons, vibrationActuator:null }, null, null, null];\\n  ```\\n- **Pointer lock:**\\n90→  - `requestPointerLock({unadjustedMovement:true})` rejects with `NotSupportedError` here, so fall back to the plain call, which works.\\n  - While locked, `page.mouse.move` gives `movementX = 0`, so tests must dispatch `new MouseEvent('mousemove',{movementX,movementY,bubbles:true})`.\\n  - `keyboard.press('Escape')` does not release the lock headless, so tests call `document.exitPointerLock()`.\\n  - Known real-browser behaviour, which I couldn't test headless: Esc releases the lock and the page may get no keydown for it, so treat `pointerlockchange` to unlocked as \\\"open the pause menu\\\". Chrome also refuses to re-lock for about a second after an Esc exit, and needs a user gesture, so show \\\"Click to resume\\\" and retry.\\n- **Two pages:**\\n  - `BroadcastChannel` and `storage` events work between `file://` pages in one browser context.\\n  - WebRTC with manual offer and answer (no ICE servers) opens over loopback in under 1 s. The codes are about 850 base64 characters.\\n- **Playwright** is in the user's site-packages, so `python3 -I script.py` can't import it. Keep your test scripts in `tests/` and run them without `-I`.\\n\\n### 2.5 What the engine does not give you (you build it)\\n100→| Gap | Evidence | What to do |\\n|---|---|---|\\n| No first-person camera | `CameraRig::forward` clamps tilt to 0–90°, so it can't look up; `far = max(distance*4+200, 300)` | §12.2 |\\n| No sky | `Scene.clear_color` is flat, and `apply_fog` (scene.wgsl) also fogs unlit meshes, so a dome would vanish | Add a `flags::NO_FOG` bit and build a sky dome (§6.2) |\\n| Terrain is 1 m terraces with a hard-coded palette, flattened to y = 0 around footprints | `terrain.rs` | New smooth generator behind the streaming code (§6.1) |\\n| The car can't pitch or roll, and only the player can drive | `set_enabled_rotations(false, true, false…)`; `drive_vehicles` uses only the player's input, steering toward a world direction | §5.11 |\\n| Nav only works on floor blocks near y = 0 | `NavGrid::build` | Outdoor nav (§5.13) |\\n| Shots are for bullet-hell | `Team::Player` shots only hit things with `health`; the `Hit` event stuns for 0.6 s | Your own hitscan (§5.2) |\\n| Sound is a closed `match` on events, with no buses, loops, music or voices | `pav_audio::sounds_for` | §10 |\\n| HUD is text lines; the only menu is a pavilion debug menu; no title screen | `pav_ui::game_lines`, `pav_app/ui.rs` | Your own 10-foot UI kit and shell (§8) |\",\"content_concise\":\"70→\\n### 2.3 Hub harness: confirmed passing on an engine page\\nI pasted `lib/hub/session.js` unmodified as the first script in the built page, right after `<meta charset>`, added the `hub:*` metas and a small connect/ready/send/finish shim, and served it with `harness.html`, `bridge.js` and `round.js`. **`window.__hubCheck.pass` was true** for all of these:\\n- `players=2`\\n- `players=4&latency=150&jitter=50&loss=5`\\n- `players=4&latency=150&jitter=50&loss=5&scenario=host-leave`\\n- `players=2&scenario=server`\\n\\nEach software-rendered copy reached `ready()` in under 2.5 s. The harness gives all copies 20 s, so build the session scene small and call `ready()` before the first drawn frame.\\n\\n80→**The game's own card passes too.** With `card:true` and a capture-phase `keydown` listener in the page's JS that calls `AIHub.answer('ready')` on Enter, the harness's extra check passed at 2 and 4 players and in the server case. The harness dispatches a synthetic Enter at the focused element, so answer it in the JS shim rather than waiting for the Rust side.\\n\\n### 2.4 Input in headless Chromium\\n- **Controller stub:** a plain-object stub works with gilrs on wasm (the engine logs \\\"gamepad connected\\\", the UI flips to gamepad prompts, and button 9 opens the menu):\\n  ```js\\n  window.__pad = { axes:[0,0,0,0], buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0})) };\\n  navigator.getGamepads = () => [{ id:'Stub (STANDARD GAMEPAD Vendor: 054c Product: 0ce6)', index:0, connected:true, mapping:'standard',\\n    timestamp:performance.now(), axes:window.__pad.axes.slice(), buttons:window.__pad.buttons, vibrationActuator:null }, null, null, null];\\n  ```\\n- **Pointer lock:**\\n90→  - `requestPointerLock({unadjustedMovement:true})` rejects with `NotSupportedError` here, so fall back to the plain call, which works.\\n  - While locked, `page.mouse.move` gives `movementX = 0`, so tests must dispatch `new MouseEvent('mousemove',{movementX,movementY,bubbles:true})`.\\n  - `keyboard.press('Escape')` does not release the lock headless, so tests call `document.exitPointerLock()`.\\n  - Known real-browser behaviour, which I couldn't test headless: Esc releases the lock and the page may get no keydown for it, so treat `pointerlockchange` to unlocked as \\\"open the pause menu\\\". Chrome also refuses to re-lock for about a second after an Esc exit, and needs a user gesture, so show \\\"Click to resume\\\" and retry.\\n- **Two pages:**\\n  - `BroadcastChannel` and `storage` events work between `file://` pages in one browser context.\\n  - WebRTC with manual offer and answer (no ICE servers) opens over loopback in under 1 s. The codes are about 850 base64 characters.\\n- **Playwright** is in the user's site-packages, so `python3 -I script.py` can't import it. Keep your test scripts in `tests/` and run them without `-I`.\\n\\n### 2.5 What the engine does not give you (you build it)\\n100→| Gap | Evidence | What to do |\\n|---|---|---|\\n| No first-person camera | `CameraRig::forward` clamps tilt to 0–90°, so it can't look up; `far = max(distance*4+200, 300)` | §12.2 |\\n| No sky | `Scene.clear_color` is flat, and `apply_fog` (scene.wgsl) also fogs unlit meshes, so a dome would vanish | Add a `flags::NO_FOG` bit and build a sky dome (§6.2) |\\n| Terrain is 1 m terraces with a hard-coded palette, flattened to y = 0 around footprints | `terrain.rs` | New smooth generator behind the streaming code (§6.1) |\\n| The car can't pitch or roll, and only the player can drive | `set_enabled_rotations(false, true, false…)`; `drive_vehicles` uses only the player's input, steering toward a world direction | §5.11 |\\n| Nav only works on floor blocks near y = 0 | `NavGrid::build` | Outdoor nav (§5.13) |\\n| Shots are for bullet-hell | `Team::Player` shots only hit things with `health`; the `Hit` event stuns for 0.6 s | Your own hitscan (§5.2) |\\n| Sound is a closed `match` on events, with no buses, loops, music or voices | `pav_audio::sounds_for` | §10 |\\n| HUD is text lines; the only menu is a pavilion debug menu; no title screen | `pav_ui::game_lines`, `pav_app/ui.rs` | Your own 10-foot UI kit and shell (§8) |\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/PLAN.md\",\"offset\":70,\"limit\":40,\"raw_output\":\"\\n### 2.3 Hub harness: confirmed passing on an engine page\\nI pasted `lib/hub/session.js` unmodified as the first script in the built page, right after `<meta charset>`, added the `hub:*` metas and a small connect/ready/send/finish shim, and served it with `harness.html`, `bridge.js` and `round.js`. **`window.__hubCheck.pass` was true** for all of these:\\n- `players=2`\\n- `players=4&latency=150&jitter=50&loss=5`\\n- `players=4&latency=150&jitter=50&loss=5&scenario=host-leave`\\n- `players=2&scenario=server`\\n\\nEach software-rendered copy reached `ready()` in under 2.5 s. The harness gives all copies 20 s, so build the session scene small and call `ready()` before the first drawn frame.\\n\\n**The game's own card passes too.** With `card:true` and a capture-phase `keydown` listener in the page's JS that calls `AIHub.answer('ready')` on Enter, the harness's extra check passed at 2 and 4 players and in the server case. The harness dispatches a synthetic Enter at the focused element, so answer it in the JS shim rather than waiting for the Rust side.\\n\\n### 2.4 Input in headless Chromium\\n- **Controller stub:** a plain-object stub works with gilrs on wasm (the engine logs \\\"gamepad connected\\\", the UI flips to gamepad p