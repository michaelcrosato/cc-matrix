static, ()> {\\n    static LOCK: std::sync::Mutex<()> = std::sync::Mutex::new(());\\n    LOCK.lock().unwrap()\\n}\\n\\n#[test]\\nfn scene_boots_and_history_is_off() {\\n70→    let _cam = camera_lock();\\n    for seed in [1u64, 2, 9] {\\n        let mut sim = Sim::new(Merc::KEY, seed).unwrap();\\n        assert_eq!(sim.play().unwrap().key(), \\\"merc\\\");\\n        assert_eq!(sim.config.history_seconds, 0.0);\\n        for _ in 0..8 {\\n            sim.step(&InputFrame::default());\\n        }\\n        let status = sim.play().unwrap().status(&sim);\\n        assert_eq!(status[\\\"title\\\"], \\\"Jam Cry\\\");\\n80→    }\\n}\\n\\n#[test]\\nfn same_seed_matches_across_a_save() {\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/tests/merc.rs\",\"offset\":55,\"limit\":30,\"raw_output\":\"fn run(w: &mut World, input: &InputFrame, seconds: f32) {\\n    let n = (seconds / DT) as i32;\\n    for _ in 0..n {\\n        w.tick(input, DT);\\n    }\\n}\\n\\n/// The rendered eye is one process slot. Two merc sims must not write it at once.\\nfn camera_lock() -> std::sync::MutexGuard<'static, ()> {\\n    static LOCK: std::sync::Mutex<()> = std::sync::Mutex::new(());\\n    LOCK.lock().unwrap()\\n}\\n\\n#[test]\\nfn scene_boots_and_history_is_off() {\\n    let _cam = camera_lock();\\n    for seed in [1u64, 2, 9] {\\n        let mut sim = Sim::new(Merc::KEY, seed).unwrap();\\n        assert_eq!(sim.play().unwrap().key(), \\\"merc\\\");\\n        assert_eq!(sim.config.history_seconds, 0.0);\\n        for _ in 0..8 {\\n            sim.step(&InputFrame::default());\\n        }\\n        let status = sim.play().unwrap().status(&sim);\\n        assert_eq!(status[\\\"title\\\"], \\\"Jam Cry\\\");\\n    }\\n}\\n\\n#[test]\\nfn same_seed_matches_across_a_save() {\\n\",\"total_lines\":930}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c0