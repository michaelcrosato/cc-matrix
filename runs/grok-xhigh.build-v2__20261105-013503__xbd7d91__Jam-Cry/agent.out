x(0.2);\\n        if self.ride.health > 70.0 {\\n            self.ride.stage = 0;\\n        } else if self.ride.health > 40.0 {\\n            self.ride.stage = 1;\\n        } else if self.ride.health > 15.0 {\\n            self.ride.stage = 2;\\n        } else if self.ride.health > 0.0 {\\n            if self.ride.stage < 3 {\\n                self.ride.fuse = 8.0;\\n1450→            }\\n            self.ride.stage = 3;\\n        } else {\\n            self.ride.stage = 4;\\n        }\\n    }\\n\\n    fn handle_items(&mut self, input: &InputFrame, dt: f32) {\\n        if input.just(buttons::HEAL) && self.hp >= 20.0 && self.hp < 100.0 && self.syrettes > 0 && self.syrette_t <= 0.0 {\\n            self.syrettes -= 1;\\n1460→            self.syrette_t = 1.5;\\n        }\\n        if self.syrette_t > 0.0 {\\n            let step = dt.min(self.syrette_t);\\n            self.hp = (self.hp + self.tune.syrette_heal / 1.5 * step).min(100.0);\\n            self.syrette_t -= step;\\n            if self.syrette_t <= 0.0 {\\n                self.syrette_t = 0.0;\\n                self.mark(\\\"syrette\\\");\\n            }\\n1470→        }\\n        if self.hp < 20.0 && self.hp > 0.0 && input.down(buttons::HEAL) {\\n            self.treating = true;\\n            self.heal_t += dt;\\n            if self.heal_t >= 4.0 {\\n                self.hp = 40.0;\\n                self.heal_t = 0.0;\\n                self.treating = false;\\n                self.mark(wound_flag(self.wound.max(1)));\\n                self.wound = 0;\\n1480→            }\\n        } else if self.hp >= 20.0 {\\n            self.treating = false;\\n            self.heal_t = 0.0;\\n        }\\n        if self.fever_state > 0 && input.down(buttons::PILLS) && self.pills > 0 {\\n            self.pill_t += dt;\\n            if self.pill_t >= 2.5 {\\n                self.pills -= 1;\\n                self.pill_t = 0.0;\\n1490→                self.fever_state = 0;\\n                self.fever_t = 0.0;\\n                self.fever_attack = 0.0;\\n                self.mark(\\\"pill_taken\\\");\\n            }\\n        } else {\\n            self.pill_t = 0.0;\\n        }\\n    }\\n\\n1500→    fn handle_gun(&mut self, input: &InputFrame, dt: f32) {\\n        if self.guns.is_empty() {\\n            return;\\n        }\\n        let infinite = self.dev.infinite;\\n        let no_jams = self.dev.no_jams;\\n        let i = self.slot.min(self.guns.len() - 1);\\n        {\\n            let g = &mut self.guns[i];\\n            if input.just(buttons::RELOAD) {\\n1510→                g.tap_reload();\\n            }\\n            g.tick_clear(dt);\\n            if infinite {\\n                g.ammo = g.ammo.max(30);\\n            }\\n            if no_jams {\\n                g.jammed = false;\\n                g.force_jam = false;\\n            }\\n1520→        }\\n        if self.guns[i].jammed {\\n            self.jam_seen = true;\\n        } else if self.jam_seen {\\n            self.mark(\\\"jam_cleared\\\");\\n        }\\n        let holster = self.ceasefire && geom::in_town(self.x, self.z);\\n        let want = input.down(buttons::PRIMARY) && !self.treating && !holster && self.rescue_t <= 0.0;\\n        if !want {\\n            return;\\n1530→        }\\n        let ads = input.down(buttons::SECONDARY);\\n        let jam = self.tune.jam_chance;\\n        let wear = self.tune.weapon_wear;\\n        let br = self.tune.break_threshold;\\n        let pull = self.guns[i].pull(&mut self.rng, jam, wear, br);\\n        if pull != Pull::Fired && pull != Pull::Broke {\\n            return;\\n        }\\n        self.resolve_shot(ads);\\n1540→        if pull == Pull::Broke {\\n            self.mark(\\\"weapon_broke\\\");\\n        }\\n    }\\n\\n    pub fn resolve_shot(&mut self, ads: bool) {\\n        let st = gun::stats(self.gun().id);\\n        let spread = 0.02 * gun::spread_mul(self.gun().condition) * if ads { 0.25 } else { 1.0 };\\n        let jitter = (self.rng.f32() - 0.5) * spread;\\n        let yaw = self.yaw + jitter;\\n1550→        let pitch = self.pitch + jitter * 0.5;\\n        let (sy, cy) = yaw.sin_cos();\\n        let (sp, cp) = pitch.sin_cos();\\n        let dir = (sy * cp, sp, -cy * cp);\\n        let origin = (self.x, self.eye, self.z);\\n        self.shots_tick(origin, dir, st.damage * self.tune.player_damage, st.range, st.noise, st.ignites, st.silent, self.gun().id, self.gun().shots);\\n    }\\n\\n    fn shots_tick(&mut self, origin: (f32, f32, f32), dir: (f32, f32, f32), damage: f32, range: f32, noise: f32, ignites: bool, silent: bool, id: WeaponId, shot_n: u32) {\\n        let mut best_t = range;\\n1560→        let mut best_zone = 0u8;\\n        let mut best_i: Option<usize> = None;\\n        let mut blocked = false;\\n        for w in &self.walls {\\n            if let Some(t) = ray_aabb(origin, dir, w.min, w.max) {\\n                if t < best_t {\\n                    best_t = t;\\n                    blocked = true;\\n                    best_i = None;\\n                }\\n1570→            }\\n        }\\n        if !blocked {\\n            for (i, b) in self.bodies.iter().enumerate() {\\n                if !b.alive {\\n                    continue;\\n                }\\n                let zones = [(1.70, 0.18, 3u8), (1.15, 0.28, 1u8), (0.45, 0.20, 2u8)];\\n                for (y, r, zone) in zones {\\n                    if let Some(t) = ray_sphere(origin, dir, (b.x, y, b.z), r) {\\n1580→                        if t < best_t {\\n                            best_t = t;\\n                            best_zone = zone;\\n                            best_i = Some(i);\\n                        }\\n                    }\\n                }\\n            }\\n        }\\n        let hit_x = origin.0 + dir.0 * best_t;\\n1590→        let hit_z = origin.2 + dir.2 * best_t;\\n        if let Some(i) = best_i {\\n            let mul = match best_zone {\\n                3 => 3.0,\\n                2 => 0.6,\\n                _ => 1.0,\\n            };\\n            let dmg = damage * mul;\\n            let kind = self.bodies[i].kind;\\n            let in_town = geom::in_town(self.bodies[i].x, self.bodies[i].z);\\n1600→            if self.ceasefire && in_town && kind == 2 {\\n                // Civilians are safe while the ceasefire holds.\\n            } else if id == WeaponId::Dart {\\n                self.bodies[i].poison = 3.0;\\n            } else {\\n                self.bodies[i].hp -= dmg;\\n                if self.bodies[i].hp <= 0.0 {\\n                    self.bodies[i].alive = false;\\n                    if kind == 1 && self.stance == 1 && silent {\\n                        self.mark(\\\"stealth_kill\\\");\\n1610→                    }\\n                    if matches!(self.current(), Some(Spec::Ceasefire)) {\\n                        self.ceasefire = false;\\n                        self.mark(\\\"ceasefire_ended\\\");\\n                    }\\n                }\\n            }\\n        }\\n        if ignites || id == WeaponId::Flare || id == WeaponId::Rpg || id == WeaponId::Flamer || id == WeaponId::Mortar || id == WeaponId::Molotov || id == WeaponId::Frag {\\n            let _ = self.fire.ignite_at(hit_x, hit_z, self.tune.burn_time, self.minutes);\\n1620→        }\\n        // Tracers: every third round, a quarter of them light dry grass.\\n        if shot_n > 0 && shot_n % 3 == 0 && self.rng.f32() < 0.25 {\\n            if self.fire.ignite_at(hit_x, hit_z, self.tune.burn_time, self.minutes) {\\n                self.mark(\\\"ignite_tracer\\\");\\n            }\\n        }\\n        if !silent {\\n            for b in &mut self.bodies {\\n                if b.alive && b.alert == 0 && geom::dist(self.x, self.z, b.x, b.z) < noise {\\n1630→                    b.alert = 1;\\n                }\\n            }\\n        }\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs\",\"offset\":1354,\"limit\":280,\"raw_output\":\"    fn use_vehicle(&mut self, input: &InputFrame, dt: f32) {\\n        if input.just(buttons::USE) && self.ride.kind != 0 {\\n            self.ride.seat = (self.ride.seat + 1) % 3;\\n            if self.ride.seat == 2 {\\n                // gunner\\n            }\\n        }\\n        if self.ride.seat == 0 {\\n            if self.ride.kind != 0 && geom::dist(self.x, self.z, self.ride.x, self.ride.z) < 5.0 && input.down(buttons::INTERACT) {\\n                self.ride.repair += dt;\\n                if self.ride.repair >= 6.0 && self.ride.health < 70.0 {\\n                    self.ride.health = 70.0;\\n                    self.ride.stage = 1;\\n                    self.ride.fuse = 0.0;\\n                    self.ride.repair = 0.0;\\n                    self.mark(\\\"repair_done\\\");\\n                }\\n            }\\n            return;\\n        }\\n        let steer = input.axes.x;\\n        self.ride.yaw = geom::wrap_angle(self.ride.yaw + steer * dt * 1.6);\\n        let mut max_s = 16.0 * self.tune.vehicle_speed;\\n        if self.ride.stage == 2 {\\n            max_s *= 0.6;\\n        }\\n        if self.ride.stage >= 3 {\\n            max_s *= 0.2;\\n        }\\n        if self.ride.kind == 2 && !geom::deep_water(self.ride.x, self.ride.z) {\\n            max_s = 0.0;\\n        }\\n        let throttle = input.axes.y;\\n        self.ride.speed += (throttle.clamp(-0.4, 1.0) * max_s - self.ride.speed) * (dt * 2.5).min(1.0);\\n        let (sy, cy) = self.ride.yaw.sin_cos();\\n        let before = (self.ride.x, self.ride.z);\\n        self.ride.x += sy * self.ride.speed * dt;\\n        self.ride.z += -cy * self.ride.speed * dt;\\n        let (x, z) = geom::clamp_map(self.ride.x, self.ride.z);\\n        self.ride.x = x;\\n        self.ride.z = z;\\n        self.ride.dist += geom::dist(before.0, before.1, self.ride.x, self.ride.z);\\n        let h = geom::height(self.ride.x, self.ride.z);\\n        let h2 = geom::height(self.ride.x + sy * 2.0, self.ride.z - cy * 2.0);\\n        self.ride.pitch = (h2 - h).atan();\\n        if self.ride.roll.abs() > 0.02 {\\n            self.ride.roll *= (1.0 - dt * 3.0).clamp(0.0, 1.0);\\n        }\\n        self.x = self.ride.x;\\n        self.z = self.ride.z;\\n        if self.ride.kind == 1 && self.ride.dist > 20.0 {\\n            self.mark(\\\"technical_driven\\\");\\n        }\\n        if self.ride.kind == 2 && self.ride.dist > 15.0 && geom::deep_water(self.ride.x, self.ride.z) {\\n            self.mark(\\\"boat_driven\\\");\\n            self.boat_dist = self.ride.dist;\\n        }\\n        if self.ride.seat == 2 && input.down(buttons::PRIMARY) {\\n            self.mark(\\\"mounted_gun\\\");\\n        }\\n        if self.ride.stage == 3 {\\n            self.ride.fuse -= dt;\\n            if self.ride.fuse <= 0.0 {\\n                self.ride.stage = 4;\\n                self.ride.health = 0.0;\\n                let _ = self.fire.ignite_disk(self.ride.x, self.ride.z, 6.0, self.tune.burn_time, self.minutes);\\n                self.mark(\\\"ignite_vehicle\\\");\\n            }\\n        }\\n        if self.ride.npc {\\n            let points = [(0.0, 800.0), (0.0, 400.0), (0.0, 0.0), (0.0, -400.0)];\\n            let target = points[self.ride.npc_i % points.len()];\\n            if geom::dist(self.ride.x, self.ride.z, target.0, target.1) < 8.0 {\\n                self.ride.npc_i += 1;\\n            }\\n            let desired = geom::yaw_toward(self.ride.x, self.ride.z, target.0, target.1);\\n            let err = geom::wrap_angle(desired - self.ride.yaw);\\n            self.ride.yaw = geom::wrap_angle(self.ride.yaw + err.clamp(-1.0, 1.0) * dt * 2.0);\\n            self.ride.speed = 10.0;\\n        }\\n    }\\n\\n    pub fn hurt_vehicle(&mut self, dmg: f32) {\\n        if self.ride.kind == 0 || self.ride.stage == 4 {\\n            return;\\n        }\\n        self.ride.health -= dmg / self.tune.vehicle_tough.max(0.2);\\n        if self.ride.health > 70.0 {\\n            self.ride.stage = 0;\\n        } else if self.ride.health > 40.0 {\\n            self.ride.stage = 1;\\n        } else if self.ride.health > 15.0 {\\n            self.ride.stage = 2;\\n        } else if self.ride.health > 0.0 {\\n            if self.ride.stage < 3 {\\n                self.ride.fuse = 8.0;\\n            }\\n            self.ride.stage = 3;\\n        } else {\\n            self.ride.stage = 4;\\n        }\\n    }\\n\\n    fn handle_items(&mut self, input: &InputFrame, dt: f32) {\\n        if input.just(buttons::HEAL) && self.hp >= 20.0 && self.hp < 100.0 && self.syrettes > 0 && self.syrette_t <= 0.0 {\\n            self.syrettes -= 1;\\n            self.syrette_t = 1.5;\\n        }\\n        if self.syrette_t > 0.0 {\\n            let step = dt.min(self.syrette_t);\\n            self.hp = (self.hp + self.tune.syrette_heal / 1.5 * step).min(100.0);\\n            self.syrette_t -= step;\\n            if self.syrette_t <= 0.0 {\\n                self.syrette_t = 0.0;\\n                self.mark(\\\"syrette\\\");\\n            }\\n        }\\n        if self.hp < 20.0 && self.hp > 0.0 && input.down(buttons::HEAL) {\\n            self.treating = true;\\n            self.heal_t += dt;\\n            if self.heal_t >= 4.0 {\\n                self.hp = 40.0;\\n                self.heal_t = 0.0;\\n                self.treating = false;\\n                self.mark(wound_flag(self.wound.max(1)));\\n                self.wound = 0;\\n            }\\n        } else if self.hp >= 20.0 {\\n            self.treating = false;\\n            self.heal_t = 0.0;\\n        }\\n        if self.fever_state > 0 && input.down(buttons::PILLS) && self.pills > 0 {\\n            self.pill_t += dt;\\n            if self.pill_t >= 2.5 {\\n                self.pills -= 1;\\n                self.pill_t = 0.0;\\n                self.fever_state = 0;\\n                self.fever_t = 0.0;\\n                self.fever_attack = 0.0;\\n                self.mark(\\\"pill_taken\\\");\\n            }\\n        } else {\\n            self.pill_t = 0.0;\\n        }\\n    }\\n\\n    fn handle_gun(&mut self, input: &InputFrame, dt: f32) {\\n        if self.guns.is_empty() {\\n            return;\\n        }\\n        let infinite = self.dev.infinite;\\n        let no_jams = self.dev.no_jams;\\n        let i = self.slot.min(self.guns.len() - 1);\\n        {\\n            let g = &mut self.guns[i];\\n            if input.just(buttons::RELOAD) {\\n                g.tap_reload();\\n            }\\n            g.tick_clear(dt);\\n            if infinite {\\n                g.ammo = g.ammo.max(30);\\n            }\\n            if no_jams {\\n                g.jammed = false;\\n                g.force_jam = false;\\n            }\\n        }\\n        if self.guns[i].jammed {\\n            self.jam_seen = true;\\n        } else if self.jam_seen {\\n            self.mark(\\\"jam_cleared\\\");\\n        }\\n        let holster = self.ceasefire && geom::in_town(self.x, self.z);\\n        let want = input.down(buttons::PRIMARY) && !self.treating && !holster && self.rescue_t <= 0.0;\\n        if !want {\\n            return;\\n        }\\n        let ads = input.down(buttons::SECONDARY);\\n        let jam = self.tune.jam_chance;\\n        let wear = self.tune.weapon_wear;\\n        let br = self.tune.break_threshold;\\n        let pull = self.guns[i].pull(&mut self.rng, jam, wear, br);\\n        if pull != Pull::Fired && pull != Pull::Broke {\\n            return;\\n        }\\n        self.resolve_shot(ads);\\n        if pull == Pull::Broke {\\n            self.mark(\\\"weapon_broke\\\");\\n        }\\n    }\\n\\n    pub fn resolve_shot(&mut self, ads: bool) {\\n        let st = gun::stats(self.gun().id);\\n        let spread = 0.02 * gun::spread_mul(self.gun().condition) * if ads { 0.25 } else { 1.0 };\\n        let jitter = (self.rng.f32() - 0.5) * spread;\\n        let yaw = self.yaw + jitter;\\n        let pitch = self.pitch + jitter * 0.5;\\n        let (sy, cy) = yaw.sin_cos();\\n        let (sp, cp) = pitch.sin_cos();\\n        let dir = (sy * cp, sp, -cy * cp);\\n        let origin = (self.x, self.eye, self.z);\\n        self.shots_tick(origin, dir, st.damage * self.tune.player_damage, st.range, st.noise, st.ignites, st.silent, self.gun().id, self.gun().shots);\\n    }\\n\\n    fn shots_tick(&mut self, origin: (f32, f32, f32), dir: (f32, f32, f32), damage: f32, range: f32, noise: f32, ignites: bool, silent: bool, id: WeaponId, shot_n: u32) {\\n        let mut best_t = range;\\n        let mut best_zone = 0u8;\\n        let mut best_i: Option<usize> = None;\\n        let mut blocked = false;\\n        for w in &self.walls {\\n            if let Some(t) = ray_aabb(origin, dir, w.min, w.max) {\\n                if t < best_t {\\n                    best_t = t;\\n                    blocked = true;\\n                    best_i = None;\\n                }\\n            }\\n        }\\n        if !blocked {\\n            for (i, b) in self.bodies.iter().enumerate() {\\n                if !b.alive {\\n                    continue;\\n                }\\n                let zones = [(1.70, 0.18, 3u8), (1.15, 0.28, 1u8), (0.45, 0.20, 2u8)];\\n                for (y, r, zone) in zones {\\n                    if let Some(t) = ray_sphere(origin, dir, (b.x, y, b.z), r) {\\n                        if t < best_t {\\n                            best_t = t;\\n                            best_zone = zone;\\n                            best_i = Some(i);\\n                        }\\n                    }\\n                }\\n            }\\n        }\\n        let hit_x = origin.0 + dir.0 * best_t;\\n        let hit_z = origin.2 + dir.2 * best_t;\\n        if let Some(i) = best_i {\\n            let mul = match best_zone {\\n                3 => 3.0,\\n                2 => 0.6,\\n                _ => 1.0,\\n            };\\n            let dmg = damage * mul;\\n            let kind = self.bodies[i].kind;\\n            let in_town = geom::in_town(self.bodies[i].x, self.bodies[i].z);\\n            if self.ceasefire && in_town && kind == 2 {\\n                // Civilians are safe while the ceasefire holds.\\n            } else if id == WeaponId::Dart {\\n                self.bodies[i].poison = 3.0;\\n            } else {\\n                self.bodies[i].hp -= dmg;\\n                if self.bodies[i].hp <= 0.0 {\\n                    self.bodies[i].alive = false;\\n                    if kind == 1 && self.stance == 1 && silent {\\n                        self.mark(\\\"stealth_kill\\\");\\n                    }\\n                    if matches!(self.current(), Some(Spec::Ceasefire)) {\\n                        self.ceasefire = false;\\n                        self.mark(\\\"ceasefire_ended\\\");\\n                    }\\n                }\\n            }\\n        }\\n        if ignites || id == WeaponId::Flare || id == WeaponId::Rpg || id == WeaponId::Flamer || id == WeaponId::Mortar || id == WeaponId::Molotov || id == WeaponId::Frag {\\n            let _ = self.fire.ignite_at(hit_x, hit_z, self.tune.burn_time, self.minutes);\\n        }\\n        // Tracers: every third round, a quarter of them light dry grass.\\n        if shot_n > 0 && shot_n % 3 == 0 && self.rng.f32() < 0.25 {\\n            if self.fire.ignite_at(hit_x, hit_z, self.tune.burn_time, self.minutes) {\\n                self.mark(\\\"ignite_tracer\\\");\\n            }\\n        }\\n        if !silent {\\n            for b in &mut self.bodies {\\n                if b.alive && b.alert == 0 && geom::dist(self.x, self.z, b.x, b.z) < noise {\\n                    b.alert = 1;\\n                }\\n            }\\n        }\\n\",\"total_lines\":2449}}","is_error":false},{"type":"tool_result","tool_use_id":"call-a0480d63-5355-43e3-94f4-5a6120d662e5-112","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→//! Jam Cry simulation. One seeded `World::tick` drives movement, guns, fire, fever and the job.\\n\\nuse std::collections::BTreeSet;\\nuse std::sync::OnceLock;\\n\\nuse glam::Vec2;\\nuse serde::{Deserialize, Serialize};\\nuse serde_json::json;\\n\\n10→use super::fire::FireMap;\\nuse super::geom::{self, exposure, grass_factor};\\nuse super::gun::{self, Gun, Pull, WeaponId};\\nuse super::shell::{self, Device};\\nuse crate::input::buttons;\\nuse crate::input::InputFrame;\\nuse crate::rng::Rng;\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\npub enum Route {\\n20→    Human,\\n    Burn,\\n    Read,\\n    Chair,\\n    Sandbox,\\n}\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\npub enum Screen {\\n    Title,\\n30→    Difficulty,\\n    Merc,\\n    Prologue,\\n    Playing,\\n    Pause,\\n    Settings,\\n    About,\\n    Dev,\\n    Mp,\\n    Attract,\\n40→}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct Tune {\\n    pub enemy_accuracy: f32,\\n    pub enemy_damage: f32,\\n    pub player_damage: f32,\\n    pub detection: f32,\\n    pub enemy_count: f32,\\n    pub weapon_wear: f32,\\n50→    pub jam_chance: f32,\\n    pub break_threshold: f32,\\n    pub fire_spread: f32,\\n    pub burn_time: f32,\\n    pub wind_strength: f32,\\n    pub burn_damage: f32,\\n    pub fever_interval: f32,\\n    pub fever_severity: f32,\\n    pub syrette_heal: f32,\\n    pub rescue_window: f32,\\n60→    pub vehicle_speed: f32,\\n    pub vehicle_tough: f32,\\n    pub contract_pay: f32,\\n    pub post_reman_hours: f32,\\n    pub player_speed: f32,\\n}\\n\\nimpl Default for Tune {\\n    fn default() -> Self {\\n        Self {\\n70→            enemy_accuracy: 0.35,\\n            enemy_damage: 8.0,\\n            player_damage: 1.0,\\n            detection: 1.0,\\n            enemy_count: 1.0,\\n            weapon_wear: 1.0,\\n            jam_chance: 1.0,\\n            break_threshold: 8.0,\\n            fire_spread: 0.9,\\n            burn_time: 10.0,\\n80→            wind_strength: 1.0,\",\"content_concise\":\"1→//! Jam Cry simulation. One seeded `World::tick` drives movement, guns, fire, fever and the job.\\n\\nuse std::collections::BTreeSet;\\nuse std::sync::OnceLock;\\n\\nuse glam::Vec2;\\nuse serde::{Deserialize, Serialize};\\nuse serde_json::json;\\n\\n10→use super::fire::FireMap;\\nuse super::geom::{self, exposure, grass_factor};\\nuse super::gun::{self, Gun, Pull, WeaponId};\\nuse super::shell::{self, Device};\\nuse crate::input::buttons;\\nuse crate::input::InputFrame;\\nuse crate::rng::Rng;\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\npub enum Route {\\n20→    Human,\\n    Burn,\\n    Read,\\n    Chair,\\n    Sandbox,\\n}\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\npub enum Screen {\\n    Title,\\n30→    Difficulty,\\n    Merc,\\n    Prologue,\\n    Playing,\\n    Pause,\\n    Settings,\\n    About,\\n    Dev,\\n    Mp,\\n    Attract,\\n40→}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct Tune {\\n    pub enemy_accuracy: f32,\\n    pub enemy_damage: f32,\\n    pub player_damage: f32,\\n    pub detection: f32,\\n    pub enemy_count: f32,\\n    pub weapon_wear: f32,\\n50→    pub jam_chance: f32,\\n    pub break_threshold: f32,\\n    pub fire_spread: f32,\\n    pub burn_time: f32,\\n    pub wind_strength: f32,\\n    pub burn_damage: f32,\\n    pub fever_interval: f32,\\n    pub fever_severity: f32,\\n    pub syrette_heal: f32,\\n    pub rescue_window: f32,\\n60→    pub vehicle_speed: f32,\\n    pub vehicle_tough: f32,\\n    pub contract_pay: f32,\\n    pub post_reman_hours: f32,\\n    pub player_speed: f32,\\n}\\n\\nimpl Default for Tune {\\n    fn default() -> Self {\\n        Self {\\n70→            enemy_accuracy: 0.35,\\n            enemy_damage: 8.0,\\n            player_damage: 1.0,\\n            detection: 1.0,\\n            enemy_count: 1.0,\\n            weapon_wear: 1.0,\\n            jam_chance: 1.0,\\n            break_threshold: 8.0,\\n            fire_spread: 0.9,\\n            burn_time: 10.0,\\n80→            wind_strength: 1.0,\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs\",\"offset\":1,\"limit\":80,\"raw_output\":\"//! Jam Cry simulation. One seeded `World::tick` drives movement, guns, fire, fever and the job.\\n\\nuse std::collections::BTreeSet;\\nuse std::sync::OnceLock;\\n\\nuse glam::Vec2;\\nuse serde::{Deserialize, Serialize};\\nuse serde_json::json;\\n\\nuse super::fire::FireMap;\\nuse super::geom::{self, exposure, grass_factor};\\nuse super::gun::{self, Gun, Pull, WeaponId};\\nuse super::shell::{self, Device};\\nuse crate::input::buttons;\\nuse crate::input::InputFrame;\\nuse crate::rng::Rng;\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\npub enum Route {\\n    Human,\\n    Burn,\\n    Read,\\n    Chair,\\n    Sandbox,\\n}\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\npub enum Screen {\\n    Title,\\n    Difficulty,\\n    Merc,\\n    Prologue,\\n    Playing,\\n    Pause,\\n    Settings,\\n    About,\\n    Dev,\\n    Mp,\\n    Attract,\\n}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct Tune {\\n    pub enemy_accuracy: f32,\\n    pub enemy_damage: f32,\\n    pub player_damage: f32,\\n    pub detection: f32,\\n    pub enemy_count: f32,\\n    pub weapon_wear: f32,\\n    pub jam_chance: f32,\\n    pub break_threshold: f32,\\n    pub fire_spread: f32,\\n    pub burn_time: f32,\\n    pub wind_strength: f32,\\n    pub burn_damage: f32,\\n    pub fever_interval: f32,\\n    pub fever_severity: f32,\\n    pub syrette_heal: f32,\\n    pub rescue_window: f32,\\n    pub vehicle_speed: f32,\\n    pub vehicle_tough: f32,\\n    pub contract_pay: f32,\\n    pub post_reman_hours: f32,\\n    pub player_speed: f32,\\n}\\n\\nimpl Default for Tune {\\n    fn default() -> Self {\\n        Self {\\n            enemy_accuracy: 0.35,\\n            enemy_damage: 8.0,\\n            player_damage: 1.0,\\n            detection: 1.0,\\n            enemy_count: 1.0,\\n            weapon_wear: 1.0,\\n            jam_chance: 1.0,\\n            break_threshold: 8.0,\\n            fire_spread: 0.9,\\n            burn_time: 10.0,\\n            wind_strength: 1.0,\\n\",\"total_lines\":2449}}","is_error":false},{"type":"tool_result","tool_use_id":"call-a0480d63-5355-43e3-94f4-5a6120d662e5-113","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→//! Weapons, condition, jams and breaks. `Gun::pull` is the only shot roll.\\n\\nuse serde::{Deserialize, Serialize};\\n\\nuse crate::rng::Rng;\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\npub enum WeaponId {\\n    Pistol,\\n10→    Revolver,\\n    Flare,\\n    Sawnoff,\\n    Ar,\\n    Battle,\\n    Smg,\\n    Shotgun,\\n    Sniper,\\n    Dart,\\n    Lmg,\\n20→    Rpg,\\n    Flamer,\\n    Mortar,\\n    Frag,\\n    Molotov,\\n    Machete,\\n}\\n\\n#[derive(Clone, Copy, Debug)]\\npub struct Stats {\\n30→    pub name: &'static str,\\n    pub family: &'static str,\\n    pub mag: u32,\\n    pub reserve: u32,\\n    pub rpm: f32,\\n    pub damage: f32,\\n    pub range: f32,\\n    pub wear: f32,\\n    pub noise: f32,\\n    pub pellets: u32,\\n40→    pub ignites: bool,\\n    pub silent: bool,\\n}\\n\\npub fn stats(id: WeaponId) -> Stats {\\n    use WeaponId::*;\\n    match id {\\n        Pistol => Stats { name: \\\"Service Nine\\\", family: \\\"pistol\\\", mag: 12, reserve: 60, rpm: 300.0, damage: 22.0, range: 40.0, wear: 0.10, noise: 120.0, pellets: 1, ignites: false, silent: false },\\n        Revolver => Stats { name: \\\"Old Six\\\", family: \\\"pistol\\\", mag: 6, reserve: 30, rpm: 120.0, damage: 48.0, range: 50.0, wear: 0.05, noise: 140.0, pellets: 1, ignites: false, silent: false },\\n        Flare => Stats { name: \\\"Flare pistol\\\", family: \\\"launcher\\\", mag: 1, reserve: 8, rpm: 40.0, damage: 10.0, range: 60.0, wear: 0.5, noise: 60.0, pellets: 1, ignites: true, silent: false },\\n50→        Sawnoff => Stats { name: \\\"Sawn-off\\\", family: \\\"shotgun\\\", mag: 2, reserve: 24, rpm: 120.0, damage: 12.0, range: 12.0, wear: 0.3, noise: 150.0, pellets: 8, ignites: false, silent: false },\\n        Ar => Stats { name: \\\"Forty-Seven\\\", family: \\\"rifle\\\", mag: 30, reserve: 180, rpm: 600.0, damage: 26.0, range: 120.0, wear: 0.14, noise: 160.0, pellets: 1, ignites: false, silent: false },\\n        Battle => Stats { name: \\\"Battle rifle\\\", family: \\\"rifle\\\", mag: 20, reserve: 100, rpm: 450.0, damage: 38.0, range: 180.0, wear: 0.12, noise: 180.0, pellets: 1, ignites: false, silent: false },\\n        Smg => Stats { name: \\\"Folding SMG\\\", family: \\\"pistol\\\", mag: 30, reserve: 180, rpm: 800.0, damage: 16.0, range: 50.0, wear: 0.16, noise: 110.0, pellets: 1, ignites: false, silent: false },\\n        Shotgun => Stats { name: \\\"Pump gun\\\", family: \\\"shotgun\\\", mag: 6, reserve: 36, rpm: 70.0, damage: 10.0, range: 18.0, wear: 0.25, noise: 150.0, pellets: 9, ignites: false, silent: false },\\n        Sniper => Stats { name: \\\"Bolt rifle\\\", family: \\\"sniper\\\", mag: 5, reserve: 40, rpm: 40.0, damage: 110.0, range: 400.0, wear: 0.35, noise: 300.0, pellets: 1, ignites: false, silent: false },\\n        Dart => Stats { name: \\\"Dart rifle\\\", family: \\\"sniper\\\", mag: 1, reserve: 12, rpm: 40.0, damage: 0.0, range: 80.0, wear: 0.2, noise: 8.0, pellets: 1, ignites: false, silent: true },\\n        Lmg => Stats { name: \\\"Belt-fed gun\\\", family: \\\"rifle\\\", mag: 100, reserve: 300, rpm: 700.0, damage: 28.0, range: 140.0, wear: 0.08, noise: 200.0, pellets: 1, ignites: false, silent: false },\\n        Rpg => Stats { name: \\\"Rocket tube\\\", family: \\\"launcher\\\", mag: 1, reserve: 6, rpm: 15.0, damage: 300.0, range: 150.0, wear: 1.2, noise: 260.0, pellets: 1, ignites: true, silent: false },\\n        Flamer => Stats { name: \\\"Flamethrower\\\", family: \\\"flame\\\", mag: 100, reserve: 300, rpm: 600.0, damage: 30.0, range: 14.0, wear: 0.05, noise: 40.0, pellets: 1, ignites: true, silent: false },\\n60→        Mortar => Stats { name: \\\"Hand mortar\\\", family: \\\"launcher\\\", mag: 1, reserve: 8, rpm: 20.0, damage: 200.0, range: 200.0, wear: 1.0, noise: 200.0, pellets: 1, ignites: true, silent: false },\\n        Frag => Stats { name: \\\"Grenade\\\", family: \\\"launcher\\\", mag: 1, reserve: 4, rpm: 60.0, damage: 150.0, range: 30.0, wear: 0.0, noise: 200.0, pellets: 1, ignites: true, silent: false },\\n        Molotov => Stats { name: \\\"Petrol bottle\\\", family: \\\"flame\\\", mag: 1, reserve: 4, rpm: 60.0, damage: 15.0, range: 24.0, wear: 0.0, noise: 30.0, pellets: 1, ignites: true, silent: false },\\n        Machete => Stats { name: \\\"Machete\\\", family: \\\"melee\\\", mag: 1, reserve: 0, rpm: 70.0, damage: 70.0, range: 1.6, wear: 0.0, noise: 10.0, pellets: 1, ignites: false, silent: true },\\n    }\\n}\\n\\n/// Jam chance per shot. Zero above 70. At 35 this is 0.055, about one shot in eighteen.\\npub fn jam_probability(condition: f32) -> f32 {\\n    if condition > 70.0 { 0.0 } else { 0.22 * ((70.0 - condition) / 70.0).powi(2) }\\n70→}\\n\\npub fn spread_mul(condition: f32) -> f32 {\\n    1.0 + (1.0 - condition.clamp(0.0, 100.0) / 100.0) * 0.8\\n}\\n\\npub fn clear_seconds(condition: f32) -> f32 {\\n    1.2 + (1.0 - condition.clamp(0.0, 100.0) / 100.0) * 1.3\\n}\\n\\n80→#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\",\"content_concise\":\"1→//! Weapons, condition, jams and breaks. `Gun::pull` is the only shot roll.\\n\\nuse serde::{Deserialize, Serialize};\\n\\nuse crate::rng::Rng;\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\npub enum WeaponId {\\n    Pistol,\\n10→    Revolver,\\n    Flare,\\n    Sawnoff,\\n    Ar,\\n    Battle,\\n    Smg,\\n    Shotgun,\\n    Sniper,\\n    Dart,\\n    Lmg,\\n20→    Rpg,\\n    Flamer,\\n    Mortar,\\n    Frag,\\n    Molotov,\\n    Machete,\\n}\\n\\n#[derive(Clone, Copy, Debug)]\\npub struct Stats {\\n30→    pub name: &'static str,\\n    pub family: &'static str,\\n    pub mag: u32,\\n    pub reserve: u32,\\n    pub rpm: f32,\\n    pub damage: f32,\\n    pub range: f32,\\n    pub wear: f32,\\n    pub noise: f32,\\n    pub pellets: u32,\\n40→    pub ignites: bool,\\n    pub silent: bool,\\n}\\n\\npub fn stats(id: WeaponId) -> Stats {\\n    use WeaponId::*;\\n    match id {\\n        Pistol => Stats { name: \\\"Service Nine\\\", family: \\\"pistol\\\", mag: 12, reserve: 60, rpm: 300.0, damage: 22.0, range: 40.0, wear: 0.10, noise: 120.0, pellets: 1, ignites: false, silent: false },\\n        Revolver => Stats { name: \\\"Old Six\\\", family: \\\"pistol\\\", mag: 6, reserve: 30, rpm: 120.0, damage: 48.0, range: 50.0, wear: 0.05, noise: 140.0, pellets: 1, ignites: false, silent: false },\\n        Flare => Stats { name: \\\"Flare pistol\\\", family: \\\"launcher\\\", mag: 1, reserve: 8, rpm: 40.0, damage: 10.0, range: 60.0, wear: 0.5, noise: 60.0, pellets: 1, ignites: true, silent: false },\\n50→        Sawnoff => Stats { name: \\\"Sawn-off\\\", family: \\\"shotgun\\\", mag: 2, reserve: 24, rpm: 120.0, damage: 12.0, range: 12.0, wear: 0.3, noise: 150.0, pellets: 8, ignites: false, silent: false },\\n        Ar => Stats { name: \\\"Forty-Seven\\\", family: \\\"rifle\\\", mag: 30, reserve: 180, rpm: 600.0, damage: 26.0, range: 120.0, wear: 0.14, noise: 160.0, pellets: 1, ignites: false, silent: false },\\n        Battle => Stats { name: \\\"Battle rifle\\\", family: \\\"rifle\\\", mag: 20, reserve: 100, rpm: 450.0, damage: 38.0, range: 180.0, wear: 0.12, noise: 180.0, pellets: 1, ignites: false, silent: false },\\n        Smg => Stats { name: \\\"Folding SMG\\\", family: \\\"pistol\\\", mag: 30, reserve: 180, rpm: 800.0, damage: 16.0, range: 50.0, wear: 0.16, noise: 110.0, pellets: 1, ignites: false, silent: false },\\n        Shotgun => Stats { name: \\\"Pump gun\\\", family: \\\"shotgun\\\", mag: 6, reserve: 36, rpm: 70.0, damage: 10.0, range: 18.0, wear: 0.25, noise: 150.0, pellets: 9, ignites: false, silent: false },\\n        Sniper => Stats { name: \\\"Bolt rifle\\\", family: \\\"sniper\\\", mag: 5, reserve: 40, rpm: 40.0, damage: 110.0, range: 400.0, wear: 0.35, noise: 300.0, pellets: 1, ignites: false, silent: false },\\n        Dart => Stats { name: \\\"Dart rifle\\\", family: \\\"sniper\\\", mag: 1, reserve: 12, rpm: 40.0, damage: 0.0, range: 80.0, wear: 0.2, noise: 8.0, pellets: 1, ignites: false, silent: true },\\n        Lmg => Stats { name: \\\"Belt-fed gun\\\", family: \\\"rifle\\\", mag: 100, reserve: 300, rpm: 700.0, damage: 28.0, range: 140.0, wear: 0.08, noise: 200.0, pellets: 1, ignites: false, silent: false },\\n        Rpg => Stats { name: \\\"Rocket tube\\\", family: \\\"launcher\\\", mag: 1, reserve: 6, rpm: 15.0, damage: 300.0, range: 150.0, wear: 1.2, noise: 260.0, pellets: 1, ignites: true, silent: false },\\n        Flamer => Stats { name: \\\"Flamethrower\\\", family: \\\"flame\\\", mag: 100, reserve: 300, rpm: 600.0, damage: 30.0, range: 14.0, wear: 0.05, noise: 40.0, pellets: 1, ignites: true, silent: false },\\n60→        Mortar => Stats { name: \\\"Hand mortar\\\", family: \\\"launcher\\\", mag: 1, reserve: 8, rpm: 20.0, damage: 200.0, range: 200.0, wear: 1.0, noise: 200.0, pellets: 1, ignites: true, silent: false },\\n        Frag => Stats { name: \\\"Grenade\\\", family: \\\"launcher\\\", mag: 1, reserve: 4, rpm: 60.0, damage: 150.0, range: 30.0, wear: 0.0, noise: 200.0, pellets: 1, ignites: true, silent: false },\\n        Molotov => Stats { name: \\\"Petrol bottle\\\", family: \\\"flame\\\", mag: 1, reserve: 4, rpm: 60.0, damage: 15.0, range: 24.0, wear: 0.0, noise: 30.0, pellets: 1, ignites: true, silent: false },\\n        Machete => Stats { name: \\\"Machete\\\", family: \\\"melee\\\", mag: 1, reserve: 0, rpm: 70.0, damage: 70.0, range: 1.6, wear: 0.0, noise: 10.0, pellets: 1, ignites: false, silent: true },\\n    }\\n}\\n\\n/// Jam chance per shot. Zero above 70. At 35 this is 0.055, about one shot in eighteen.\\npub fn jam_probability(condition: f32) -> f32 {\\n    if condition > 70.0 { 0.0 } else { 0.22 * ((70.0 - condition) / 70.0).powi(2) }\\n70→}\\n\\npub fn spread_mul(condition: f32) -> f32 {\\n    1.0 + (1.0 - condition.clamp(0.0, 100.0) / 100.0) * 0.8\\n}\\n\\npub fn clear_seconds(condition: f32) -> f32 {\\n    1.2 + (1.0 - condition.clamp(0.0, 100.0) / 100.0) * 1.3\\n}\\n\\n80→#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/gun.rs\",\"offset\":1,\"limit\":80,\"raw_output\":\"//! Weapons, condition, jams and breaks. `Gun::pull` is the only shot roll.\\n\\nuse serde::{Deserialize, Serialize};\\n\\nuse crate::rng::Rng;\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\npub enum WeaponId {\\n    Pistol,\\n    Revolver,\\n    Flare,\\n    Sawnoff,\\n    Ar,\\n    Battle,\\n    Smg,\\n    Shotgun,\\n    Sniper,\\n    Dart,\\n    Lmg,\\n    Rpg,\\n    Flamer,\\n    Mortar,\\n    Frag,\\n    Molotov,\\n    Machete,\\n}\\n\\n#[derive(Clone, Copy, Debug)]\\npub struct Stats {\\n    pub name: &'static str,\\n    pub family: &'static str,\\n    pub mag: u32,\\n    pub reserve: u32,\\n    pub rpm: f32,\\n    pub damage: f32,\\n    pub range: f32,\\n    pub wear: f32,\\n    pub noise: f32,\\n    pub pellets: u32,\\n    pub ignites: bool,\\n    pub silent: bool,\\n}\\n\\npub fn stats(id: WeaponId) -> Stats {\\n    use WeaponId::*;\\n    match id {\\n        Pistol => Stats { name: \\\"Service Nine\\\", family: \\\"pistol\\\", mag: 12, reserve: 60, rpm: 300.0, damage: 22.0, range: 40.0, wear: 0.10, noise: 120.0, pellets: 1, ignites: false, silent: false },\\n        Revolver => Stats { name: \\\"Old Six\\\", family: \\\"pistol\\\", mag: 6, reserve: 30, rpm: 120.0, damage: 48.0, range: 50.0, wear: 0.05, noise: 140.0, pellets: 1, ignites: false, silent: false },\\n        Flare => Stats { name: \\\"Flare pistol\\\", family: \\\"launcher\\\", mag: 1, reserve: 8, rpm: 40.0, damage: 10.0, range: 60.0, wear: 0.5, noise: 60.0, pellets: 1, ignites: true, silent: false },\\n        Sawnoff => Stats { name: \\\"Sawn-off\\\", family: \\\"shotgun\\\", mag: 2, reserve: 24, rpm: 120.0, damage: 12.0, range: 12.0, wear: 0.3, noise: 150.0, pellets: 8, ignites: false, silent: false },\\n        Ar => Stats { name: \\\"Forty-Seven\\\", family: \\\"rifle\\\", mag: 30, reserve: 180, rpm: 600.0, damage: 26.0, range: 120.0, wear: 0.14, noise: 160.0, pellets: 1, ignites: false, silent: false },\\n        Battle => Stats { name: \\\"Battle rifle\\\", family: \\\"rifle\\\", mag: 20, reserve: 100, rpm: 450.0, damage: 38.0, range: 180.0, wear: 0.12, noise: 180.0, pellets: 1, ignites: false, silent: false },\\n        Smg => Stats { name: \\\"Folding SMG\\\", family: \\\"pistol\\\", mag: 30, reserve: 180, rpm: 800.0, damage: 16.0, range: 50.0, wear: 0.16, noise: 110.0, pellets: 1, ignites: false, silent: false },\\n        Shotgun => Stats { name: \\\"Pump gun\\\", family: \\\"shotgun\\\", mag: 6, reserve: 36, rpm: 70.0, damage: 10.0, range: 18.0, wear: 0.25, noise: 150.0, pellets: 9, ignites: false, silent: false },\\n        Sniper => Stats { name: \\\"Bolt rifle\\\", family: \\\"sniper\\\", mag: 5, reserve: 40, rpm: 40.0, damage: 110.0, range: 400.0, wear: 0.35, noise: 300.0, pellets: 1, ignites: false, silent: false },\\n        Dart => Stats { name: \\\"Dart rifle\\\", family: \\\"sniper\\\", mag: 1, reserve: 12, rpm: 40.0, damage: 0.0, range: 80.0, wear: 0.2, noise: 8.0, pellets: 1, ignites: false, silent: true },\\n        Lmg => Stats { name: \\\"Belt-fed gun\\\", family: \\\"rifle\\\", mag: 100, reserve: 300, rpm: 700.0, damage: 28.0, range: 140.0, wear: 0.08, noise: 200.0, pellets: 1, ignites: false, silent: false },\\n        Rpg => Stats { name: \\\"Rocket tube\\\", family: \\\"launcher\\\", mag: 1, reserve: 6, rpm: 15.0, damage: 300.0, range: 150.0, wear: 1.2, noise: 260.0, pellets: 1, ignites: true, silent: false },\\n        Flamer => Stats { name: \\\"Flamethrower\\\", family: \\\"flame\\\", mag: 100, reserve: 300, rpm: 600.0, damage: 30.0, range: 14.0, wear: 0.05, noise: 40.0, pellets: 1, ignites: true, silent: false },\\n        Mortar => Stats { name: \\\"Hand mortar\\\", family: \\\"launcher\\\", mag: 1, reserve: 8, rpm: 20.0, damage: 200.0, range: 200.0, wear: 1.0, noise: 200.0, pellets: 1, ignites: true, silent: false },\\n        Frag => Stats { name: \\\"Grenade\\\", family: \\\"launcher\\\", mag: 1, reserve: 4, rpm: 60.0, damage: 150.0, range: 30.0, wear: 0.0, noise: 200.0, pellets: 1, ignites: true, silent: false },\\n        Molotov => Stats { name: \\\"Petrol bottle\\\", family: \\\"flame\\\", mag: 1, reserve: 4, rpm: 60.0, damage: 15.0, range: 24.0, wear: 0.0, noise: 30.0, pellets: 1, ignites: true, silent: false },\\n        Machete => Stats { name: \\\"Machete\\\", family: \\\"melee\\\", mag: 1, reserve: 0, rpm: 70.0, damage: 70.0, range: 1.6, wear: 0.0, noise: 10.0, pellets: 1, ignites: false, silent: true },\\n    }\\n}\\n\\n/// Jam chance per shot. Zero above 70. At 35 this is 0.055, about one shot in eighteen.\\npub fn jam_probability(condition: f32) -> f32 {\\n    if condition > 70.0 { 0.0 } else { 0.22 * ((70.0 - condition) / 70.0).powi(2) }\\n}\\n\\npub fn spread_mul(condition: f32) -> f32 {\\n    1.0 + (1.0 - condition.clamp(0.0, 100.0) / 100.0) * 0.8\\n}\\n\\npub fn clear_seconds(condition: f32) -> f32 {\\n    1.2 + (1.0 - condition.clamp(0.0, 100.0) / 100.0) * 1.3\\n}\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\\n\",\"total_lines\":191}}","is_error":false},{"type":"tool_result","tool_use_id":"call-a0480d63-5355-43e3-94f4-5a6120d662e5-114","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1540→        if pull == Pull::Broke {\\n            self.mark(\\\"weapon_broke\\\");\\n        }\\n    }\\n\\n    pub fn resolve_shot(&mut self, ads: bool) {\\n        let st = gun::stats(self.gun().id);\\n        let spread = 0.02 * gun::spread_mul(self.gun().condition) * if ads { 0.25 } else { 1.0 };\\n        let jitter = (self.rng.f32() - 0.5) * spread;\\n        let yaw = self.yaw + jitter;\\n1550→        let pitch = self.pitch + jitter * 0.5;\\n        let (sy, cy) = yaw.sin_cos();\\n        let (sp, cp) = pitch.sin_cos();\\n        let dir = (sy * cp, sp, -cy * cp);\\n        let origin = (self.x, self.eye, self.z);\\n        self.shots_tick(origin, dir, st.damage * self.tune.player_damage, st.range, st.noise, st.ignites, st.silent, self.gun().id, self.gun().shots);\\n    }\\n\\n    fn shots_tick(&mut self, origin: (f32, f32, f32), dir: (f32, f32, f32), damage: f32, range: f32, noise: f32, ignites: bool, silent: bool, id: WeaponId, shot_n: u32) {\\n        let mut best_t = range;\\n1560→        let mut best_zone = 0u8;\\n        let mut best_i: Option<usize> = None;\\n        let mut blocked = false;\\n        for w in &self.walls {\\n            if let Some(t) = ray_aabb(origin, dir, w.min, w.max) {\\n                if t < best_t {\\n                    best_t = t;\\n                    blocked = true;\\n                    best_i = None;\\n                }\\n1570→            }\\n        }\\n        if !blocked {\\n            for (i, b) in self.bodies.iter().enumerate() {\\n                if !b.alive {\\n                    continue;\\n                }\\n                let zones = [(1.70, 0.18, 3u8), (1.15, 0.28, 1u8), (0.45, 0.20, 2u8)];\\n                for (y, r, zone) in zones {\\n                    if let Some(t) = ray_sphere(origin, dir, (b.x, y, b.z), r) {\\n1580→                        if t < best_t {\\n                            best_t = t;\\n                            best_zone = zone;\\n                            best_i = Some(i);\\n                        }\\n                    }\\n                }\\n            }\\n        }\\n        let hit_x = origin.0 + dir.0 * best_t;\\n1590→        let hit_z = origin.2 + dir.2 * best_t;\\n        if let Some(i) = best_i {\\n            let mul = match best_zone {\\n                3 => 3.0,\\n                2 => 0.6,\\n                _ => 1.0,\\n            };\\n            let dmg = damage * mul;\\n            let kind = self.bodies[i].kind;\\n            let in_town = geom::in_town(self.bodies[i].x, self.bodies[i].z);\\n1600→            if self.ceasefire && in_town && kind == 2 {\\n                // Civilians are safe while the ceasefire holds.\\n            } else if id == WeaponId::Dart {\\n                self.bodies[i].poison = 3.0;\\n            } else {\\n                self.bodies[i].hp -= dmg;\\n                if self.bodies[i].hp <= 0.0 {\\n                    self.bodies[i].alive = false;\\n                    if kind == 1 && self.stance == 1 && silent {\\n                        self.mark(\\\"stealth_kill\\\");\\n1610→                    }\\n                    if matches!(self.current(), Some(Spec::Ceasefire)) {\\n                        self.ceasefire = false;\\n                        self.mark(\\\"ceasefire_ended\\\");\\n                    }\\n                }\\n            }\\n        }\\n        if ignites || id == WeaponId::Flare || id == WeaponId::Rpg || id == WeaponId::Flamer || id == WeaponId::Mortar || id == WeaponId::Molotov || id == WeaponId::Frag {\\n            let _ = self.fire.ignite_at(hit_x, hit_z, self.tune.burn_time, self.minutes);\\n1620→        }\\n        // Tracers: every third round, a quarter of them light dry grass.\\n        if shot_n > 0 && shot_n % 3 == 0 && self.rng.f32() < 0.25 {\\n            if self.fire.ignite_at(hit_x, hit_z, self.tune.burn_time, self.minutes) {\\n                self.mark(\\\"ignite_tracer\\\");\\n            }\\n        }\\n        if !silent {\\n            for b in &mut self.bodies {\\n                if b.alive && b.alert == 0 && geom::dist(self.x, self.z, b.x, b.z) < noise {\\n1630→                    b.alert = 1;\\n                }\\n            }\\n        }\\n        let _ = noise;\\n    }\\n\\n    fn update_bodies(&mut self, dt: f32) {\\n        let px = self.x;\\n        let pz = self.z;\\n1640→        let stance = self.stance;\\n        let night = self.hour() < 5.0 || self.hour() > 20.0;\\n        let light = if night { 0.45 } else { 1.0 };\\n        let n = self.bodies.len();\\n        let dead_soldiers = self.bodies.iter().filter(|b| b.kind == 1 && !b.alive).count();\\n        let live_soldiers = self.bodies.iter().filter(|b| b.kind == 1 && b.alive).count();\\n        let morale_broken = dead_soldiers >= 2 && live_soldiers > 0 && live_soldiers <= dead_soldiers;\\n        let mut shooters = 0u32;\\n        for i in 0..n {\\n            if !self.bodies[i].alive {\\n1650→                continue;\\n            }\\n            if self.bodies[i].poison > 0.0 {\\n                self.bodies[i].poison -= dt;\\n                if self.bodies[i].poison <= 0.0 && self.bodies[i].hp > 0.0 {\\n                    self.bodies[i].hp = 0.0;\\n                    self.bodies[i].alive = false;\\n                    self.mark(\\\"dart_kill\\\");\\n                    continue;\\n                }\",\"content_concise\":\"1540→        if pull == Pull::Broke {\\n            self.mark(\\\"weapon_broke\\\");\\n        }\\n    }\\n\\n    pub fn resolve_shot(&mut self, ads: bool) {\\n        let st = gun::stats(self.gun().id);\\n        let spread = 0.02 * gun::spread_mul(self.gun().condition) * if ads { 0.25 } else { 1.0 };\\n        let jitter = (self.rng.f32() - 0.5) * spread;\\n        let yaw = self.yaw + jitter;\\n1550→        let pitch = self.pitch + jitter * 0.5;\\n        let (sy, cy) = yaw.sin_cos();\\n        let (sp, cp) = pitch.sin_cos();\\n        let dir = (sy * cp, sp, -cy * cp);\\n        let origin = (self.x, self.eye, 