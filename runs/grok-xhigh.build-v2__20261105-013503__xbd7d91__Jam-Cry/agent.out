 height = 2 * (half_height + radius).\\n    Capsule {\\n        half_height: f32,\\n        radius: f32,\\n    },\\n    Cylinder {\\n        half_height: f32,\\n30→        radius: f32,\\n    },\\n}\\n\\nimpl Shape {\\n    pub fn collider(&self) -> ColliderBuilder {\\n        match *self {\\n            Shape::Box { half } => ColliderBuilder::cuboid(half.x as Real, half.y as Real, half.z as Real),\\n            Shape::RoundedBox { half, radius } => {\\n                let r = radius.min(half.min_element() * 0.99);\\n40→                ColliderBuilder::round_cuboid((half.x - r) as Real, (half.y - r) as Real, (half.z - r) as Real, r as Real)\",\"content_concise\":\"1→//! Shapes shared by physics colliders and visuals, and the visual description of objects.\\n\\nuse glam::Vec3;\\nuse rapier::prelude::*;\\nuse serde::{Deserialize, Serialize};\\n\\nuse crate::choice_enum;\\nuse crate::color::Color;\\n\\n10→#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]\\n#[serde(tag = \\\"type\\\", rename_all = \\\"snake_case\\\")]\\npub enum Shape {\\n    Box {\\n        half: Vec3,\\n    },\\n    RoundedBox {\\n        half: Vec3,\\n        radius: f32,\\n    },\\n20→    Sphere {\\n        radius: f32,\\n    },\\n    /// Along local Y; total height = 2 * (half_height + radius).\\n    Capsule {\\n        half_height: f32,\\n        radius: f32,\\n    },\\n    Cylinder {\\n        half_height: f32,\\n30→        radius: f32,\\n    },\\n}\\n\\nimpl Shape {\\n    pub fn collider(&self) -> ColliderBuilder {\\n        match *self {\\n            Shape::Box { half } => ColliderBuilder::cuboid(half.x as Real, half.y as Real, half.z as Real),\\n            Shape::RoundedBox { half, radius } => {\\n                let r = radius.min(half.min_element() * 0.99);\\n40→                ColliderBuilder::round_cuboid((half.x - r) as Real, (half.y - r) as Real, (half.z - r) as Real, r as Real)\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/shape.rs\",\"offset\":null,\"limit\":40,\"raw_output\":\"//! Shapes shared by physics colliders and visuals, and the visual description of objects.\\n\\nuse glam::Vec3;\\nuse rapier::prelude::*;\\nuse serde::{Deserialize, Serialize};\\n\\nuse crate::choice_enum;\\nuse crate::color::Color;\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]\\n#[serde(tag = \\\"type\\\", rename_all = \\\"snake_case\\\")]\\npub enum Shape {\\n    Box {\\n        half: Vec3,\\n    },\\n    RoundedBox {\\n        half: Vec3,\\n        radius: f32,\\n    },\\n    Sphere {\\n        radius: f32,\\n    },\\n    /// Along local Y; total height = 2 * (half_height + radius).\\n    Capsule {\\n        half_height: f32,\\n        radius: f32,\\n    },\\n    Cylinder {\\n        half_height: f32,\\n        radius: f32,\\n    },\\n}\\n\\nimpl Shape {\\n    pub fn collider(&self) -> ColliderBuilder {\\n        match *self {\\n            Shape::Box { half } => ColliderBuilder::cuboid(half.x as Real, half.y as Real, half.z as Real),\\n            Shape::RoundedBox { half, radius } => {\\n                let r = radius.min(half.min_element() * 0.99);\\n                ColliderBuilder::round_cuboid((half.x - r) as Real, (half.y - r) as Real, (half.z - r) as Real, r as Real)\\n\",\"total_lines\":110}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"47a0299f-106b-496f-a2fb-97f26c6b4b34"}
