t mut f = InputFrame::default();\\n    f.move_dir.y = 1.0;\\n    for _ in 0..90 {\\n        sim.step(&f);\\n    }\\n    let eye1 = sim.play().unwrap().get::<Merc>().unwrap().world.eye_pos();\\n    let cam = merc::overlook();\\n    assert!((cam.eye[0] - eye1.0).abs() < 0.3 && (cam.eye[2] - eye1.2).abs() < 0.3, \\\"cam {:?} eye {:?}\\\", cam.eye, eye1);\\n    assert!((eye1.0 - eye0.0).abs() + (eye1.2 - eye0.2).abs() > 1.0, \\\"eye did not move {eye0:?} -> {eye1:?}\\\");\\n\\n    let mut c = InputFrame::default();\\n    c.held = buttons::CROUCH;\\n    for _ in 0..40 {\\n        sim.step(&c);\\n    }\\n    let eye_c = sim.play().unwrap().get::<Merc>().unwrap().world.eye_pos();\\n    let cam = merc::overlook();\\n    assert!(eye_c.1 < eye1.1 - 0.3, \\\"crouch {} stand {}\\\", eye_c.1, eye1.1);\\n    assert!((cam.eye[1] - eye_c.1).abs() < 0.25, \\\"cam y {} eye {}\\\", cam.eye[1], eye_c.1);\\n\\n    let rifle = sim.state.entities.map.values().find(|e| e.name == \\\"fp-rifle\\\").expect(\\\"rifle prop\\\");\\n    let dx = rifle.pos.x - cam.eye[0];\\n    let dy = rifle.pos.y - cam.eye[1];\\n    let dz = rifle.pos.z - cam.eye[2];\\n    let dist = (dx * dx + dy * dy + dz * dz).sqrt();\\n    assert!(dist > 0.15 && dist < 1.2, \\\"rifle dist {dist}\\\");\\n    let rag = sim.state.entities.map.values().find(|e| e.name == \\\"fp-rag\\\").expect(\\\"rag prop\\\");\\n    let rdx = rag.pos.x - cam.eye[0];\\n    let rdy = rag.pos.y - cam.eye[1];\\n    let rdz = rag.pos.z - cam.eye[2];\\n    let rdist = (rdx * rdx + rdy * rdy + rdz * rdz).sqrt();\\n    assert!(rdist > 0.15 && rdist < 1.6, \\\"rag dist {rdist}\\\");\\n    let near_country = sim.state.entities.map.values().any(|e| {\\n        if e.name != \\\"country\\\" {\\n            return false;\\n        }\\n        let dx = e.pos.x - eye_c.0;\\n        let dz = e.pos.z - eye_c.2;\\n        dx * dx + dz * dz < 12.0 * 12.0\\n    });\\n    assert!(near_country, \\\"country patch is not under the eye\\\");\\n}\\n\\n#[test]\\nfn ledger_confirm_earns_the_chosen_ending() {\\n    let mut burn = World::campaign(1, Route::Human);\\n    burn.present_ending();\\n    burn.tick(&InputFrame::default(), DT);\\n    assert_eq!(burn.screen, Screen::Ledger);\\n    assert!(!burn.flags.contains(\\\"ending_burn\\\"));\\n    burn.tick(&act(1), DT);\\n    assert_eq!(burn.screen, Screen::Playing);\\n    assert_eq!(burn.finale, Some(0));\\n    assert!(!burn.flags.contains(\\\"ending_burn\\\"));\\n    let mut t = 0.0f32;\\n    while !burn.flags.contains(\\\"ending_burn\\\") && t < 8.0 {\\n        let input = burn.bot_input();\\n        burn.tick(&input, DT);\\n        t += DT;\\n    }\\n    assert!(burn.flags.contains(\\\"ending_burn\\\"), \\\"burn flag missing after {t:.1}s\\\");\\n\\n    let mut chair = World::campaign(1, Route::Chair);\\n    chair.present_ending();\\n    chair.tick(&InputFrame::default(), DT);\\n    assert_eq!(chair.screen, Screen::Ledger);\\n    chair.tick(&act(4), DT);\\n    chair.tick(&act(4), DT);\\n    assert_eq!(chair.focus, 2);\\n    chair.tick(&act(1), DT);\\n    assert_eq!(chair.finale, Some(2));\\n    assert!(!chair.flags.contains(\\\"ending_chair\\\"));\\n    chair.tick(&press(buttons::INTERACT), DT);\\n    assert!(chair.flags.contains(\\\"ending_chair\\\"));\\n\\n    let mut read = World::campaign(1, Route::Read);\\n    read.present_ending();\\n    read.tick(&InputFrame::default(), DT);\\n    read.tick(&act(4), DT);\\n    assert_eq!(read.focus, 1);\\n    read.tick(&act(1), DT);\\n    assert_eq!(read.finale, Some(1));\\n    assert!(read.bodies.iter().any(|b| b.alive && b.kind == 1));\\n    assert!(!read.flags.contains(\\\"ending_read\\\"));\\n    run(&mut read, &hold(buttons::CROUCH), 2.0);\\n    assert!(!read.flags.contains(\\\"ending_read\\\"));\\n}\\n\\n#[test]\\nfn dev_menu_teleports_spawns_and_noclip_flies() {\\n    let mut w = World::fresh(1);\\n    w.tick(&act(10), DT);\\n    assert_eq!(w.screen, Screen::Pause);\\n    for _ in 0..3 {\\n        w.tick(&act(4), DT);\\n    }\\n    w.tick(&act(1), DT);\\n    assert_eq!(w.screen, Screen::Dev);\\n    assert_eq!(w.tab, 0);\\n    w.tick(&act(4), DT);\\n    w.tick(&act(1), DT);\\n    assert_eq!(w.tab, 2, \\\"rows {:?}\\\", w.rows());\\n    w.tick(&act(1), DT);\\n    assert!((w.x + 120.0).abs() < 0.1 && (w.z - 900.0).abs() < 0.1, \\\"teleport ({}, {})\\\", w.x, w.z);\\n\\n    w.tick(&act(2), DT);\\n    assert_eq!(w.tab, 0);\\n    w.tick(&act(4), DT);\\n    w.tick(&act(4), DT);\\n    w.tick(&act(1), DT);\\n    assert_eq!(w.tab, 3);\\n    let before = w.bodies.len();\\n    w.tick(&act(1), DT);\\n    assert!(w.bodies.len() > before, \\\"spawn did not add a body\\\");\\n    assert!(w.bodies.iter().any(|b| b.kind == 1));\\n\\n    w.tick(&act(2), DT);\\n    assert_eq!(w.tab, 0);\\n    for _ in 0..3 {\\n        w.tick(&act(4), DT);\\n    }\\n    w.tick(&act(1), DT);\\n    assert_eq!(w.tab, 4);\\n    w.tick(&act(1), DT);\\n    assert!(w.hour() > 20.0, \\\"hour {}\\\", w.hour());\\n\\n    w.tick(&act(2), DT);\\n    w.tick(&act(1), DT);\\n    assert_eq!(w.tab, 1);\\n    for _ in 0..4 {\\n        w.tick(&act(4), DT);\\n    }\\n    assert_eq!(w.rows().get(w.focus).map(String::as_str), Some(\\\"Noclip\\\"));\\n    w.tick(&act(1), DT);\\n    assert!(w.dev.noclip);\\n\\n    w.tick(&act(2), DT);\\n    w.tick(&act(2), DT);\\n    assert_eq!(w.screen, Screen::Pause, \\\"focus {} rows {:?}\\\", w.focus, w.rows());\\n    assert_eq!(w.rows().get(w.focus).map(String::as_str), Some(\\\"Resume\\\"));\\n    w.tick(&act(1), DT);\\n    assert_eq!(w.screen, Screen::Playing);\\n\\n    w.ride.kind = 1;\\n    w.ride.seat = 1;\\n    w.ride.x = w.x;\\n    w.ride.z = w.z;\\n    let x0 = w.x;\\n    let z0 = w.z;\\n    let eye0 = w.eye;\\n    let mut fly = InputFrame::default();\\n    fly.move_dir.y = 1.0;\\n    fly.look.y = 1.0;\\n    run(&mut w, &fly, 0.5);\\n    let moved = ((w.x - x0).powi(2) + (w.z - z0).powi(2)).sqrt();\\n    assert!(moved > 2.0, \\\"noclip moved {moved:.2} from ({x0:.1},{z0:.1}) to ({:.1},{:.1})\\\", w.x, w.z);\\n    assert!(w.eye > eye0 + 2.0, \\\"eye {} from {eye0}\\\", w.eye);\\n}\\n\\nconst COVERAGE: &[&str] = &[\\n    \\\"map_raised\\\", \\\"waypoint_set\\\", \\\"gps_followed\\\", \\\"monocular_tag\\\", \\\"wind_rag\\\", \\\"jam_cleared\\\", \\\"enemy_jam\\\", \\\"weapon_broke\\\",\\n    \\\"weapon_bought\\\", \\\"locker_used\\\", \\\"syrette\\\", \\\"wound_gunshot\\\", \\\"wound_shrapnel\\\", \\\"wound_burn\\\", \\\"wound_fall\\\", \\\"wound_tourniquet\\\",\\n    \\\"wound_graze\\\", \\\"fever_warned\\\", \\\"pill_taken\\\", \\\"blackout\\\", \\\"player_rescued\\\", \\\"companion_patched\\\", \\\"companion_overdosed\\\",\\n    \\\"companion_died\\\", \\\"better_way\\\", \\\"ignite_flare\\\", \\\"ignite_rocket\\\", \\\"ignite_flamer\\\", \\\"ignite_mortar\\\", \\\"ignite_molotov\\\",\\n    \\\"ignite_frag\\\", \\\"ignite_barrel\\\", \\\"ignite_vehicle\\\", \\\"ignite_person\\\", \\\"ignite_lightning\\\", \\\"ignite_tracer\\\", \\\"ignite_cigarette\\\",\\n    \\\"cells_500\\\", \\\"enemy_panicked\\\", \\\"animals_fled\\\", \\\"explosion_chain\\\", \\\"rain_extinguished\\\", \\\"stealth_kill\\\", \\\"dart_kill\\\",\\n    \\\"night_contract\\\", \\\"sleep_used\\\", \\\"safe_house_claimed\\\", \\\"post_cleared\\\", \\\"post_remanned\\\", \\\"technical_driven\\\", \\\"mounted_gun\\\",\\n    \\\"repair_done\\\", \\\"boat_driven\\\", \\\"bus_taken\\\", \\\"tape_played\\\", \\\"cache_tracker\\\", \\\"diamonds_spent\\\", \\\"contract_a0\\\", \\\"contract_a1\\\",\\n    \\\"contract_b1\\\", \\\"contract_b2\\\", \\\"contract_b3\\\", \\\"contract_b4\\\", \\\"contract_c1\\\", \\\"contract_c2\\\", \\\"contract_c3\\\", \\\"contract_d1\\\",\\n    \\\"contract_d2\\\", \\\"ceasefire_ended\\\", \\\"town_burned\\\", \\\"ending_burn\\\", \\\"ending_read\\\", \\\"ending_chair\\\",\\n];\\n\\nfn play_route(route: Route, seed: u64) -> BTreeSet<String> {\\n    let mut w = World::campaign(seed, route);\\n    let mut goal = String::new();\\n    let mut stuck = 0.0f32;\\n    let cap = 60.0 * 900.0;\\n    let mut t = 0.0f32;\\n    while t < cap && !w.finished {\\n        let input = w.bot_input();\\n        let before = w.goal_name();\\n        w.tick(&input, DT);\\n        t += DT;\\n        let now = w.goal_name();\\n        if now != before {\\n            eprintln!(\\\"{route:?} seed {seed}: {before} -> {now} at ({:.0},{:.0}) t={t:.0}\\\", w.x, w.z);\\n            goal = now;\\n            stuck = 0.0;\\n        } else {\\n            stuck += DT;\\n            let budget = w.goal_budget();\\n            if stuck > budget && !w.finished {\\n                panic!(\\n                    \\\"{route:?} seed {seed} stuck on {now} for {stuck:.0}s (budget {budget:.0}) at ({:.1},{:.1}) step {} flags {}\\\",\\n                    w.x, w.z, w.step, w.flags.len()\\n                );\\n            }\\n        }\\n    }\\n    assert!(w.finished, \\\"{route:?} seed {seed} did not finish by {t:.0}s goal {} at ({:.0},{:.0})\\\", w.goal_name(), w.x, w.z);\\n    let end = match route {\\n        Route::Read => \\\"ending_read\\\",\\n        Route::Chair => \\\"ending_chair\\\",\\n        _ => \\\"ending_burn\\\",\\n    };\\n    assert!(w.flags.contains(end), \\\"{route:?} missing {end}\\\");\\n    w.flags\\n}\\n\\n#[test]\\nfn bot_plays_all_three_endings() {\\n    let mut union = BTreeSet::new();\\n    for seed in [1u64, 2] {\\n        let mut prefix_a = World::campaign(seed, Route::Human);\\n        let mut prefix_b = World::campaign(seed, Route::Human);\\n        for _ in 0..40 {\\n            let a = prefix_a.bot_input();\\n            let b = prefix_b.bot_input();\\n            prefix_a.tick(&a, DT);\\n            prefix_b.tick(&b, DT);\\n        }\\n        assert_eq!(prefix_a.fingerprint(), prefix_b.fingerprint());\\n        for route in [Route::Human, Route::Read, Route::Chair] {\\n            union.extend(play_route(route, seed));\\n        }\\n    }\\n    let missing: Vec<_> = COVERAGE.iter().copied().filter(|f| !union.contains(*f)).collect();\\n    assert!(missing.is_empty(), \\\"coverage missing {missing:?}\\\");\\n}\\n\",\"total_lines\":930}}","is_error":false},{"type":"tool_result","tool_use_id":"call-a9b78fcd-458e-4b24-88e7-5ac47e553a15-19","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"580→    pub fn spawn_dummy(&mut self, x: f32, z: f32, hp: f32) -> usize {\\n        self.bodies.push(Body {\\n            kind: 4,\\n            x,\\n            z,\\n            yaw: 0.0,\\n            hp,\\n            alive: true,\\n            alert: 0,\\n            gun: Gun::new(WeaponId::Pistol),\\n590→            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n        self.bodies.len() - 1\\n    }\\n\\n    pub fn add_wall(&mut self, min: [f32; 3], max: [f32; 3]) {\\n600→        self.walls.push(Wall { min, max });\\n    }\\n\\n    pub fn tick(&mut self, input: &InputFrame, dt: f32) {\\n        let dt = dt.clamp(0.0, 0.5);\\n        self.apply_console(input);\\n        if self.screen != Screen::Playing {\\n            self.shell_tick(input, dt);\\n        } else if input.act == 10 && !self.hub {\\n            self.screen = Screen::Pause;\\n610→            self.focus = 0;\\n            self.idle = 0.0;\\n        } else {\\n            self.simulate(input, dt);\\n        }\\n        if self.route != Route::Sandbox {\\n            self.advance_script(dt);\\n        }\\n        if self.wind.length() > 6.0 && self.screen == Screen::Playing {\\n            self.mark(\\\"wind_rag\\\");\\n620→        }\\n        self.minutes += dt;\\n        self.maybe_reman();\\n    }\\n\\n    /// Numbered actions from the page. These run on every screen, including play,\\n    /// because the shell does not tick while a contract is running.\\n    fn apply_console(&mut self, input: &InputFrame) {\\n        match input.act {\\n            11 => self.dev.god = !self.dev.god,\\n630→            12 => {\\n                let (lo, hi, step) = self.tune.range(8);\\n                self.tune.set(8, (self.tune.get(8) + step).clamp(lo, hi));\\n            }\\n            13 => self.tune = self.tune0.clone(),\\n            14 => self.xbox = !self.xbox,\\n            15 => self.write_save(),\\n            16 => self.continue_save(),\\n            18 => {\\n                self.screen = Screen::Settings;\\n640→                self.tab = 0;\\n                self.focus = 0;\\n                self.idle = 0.0;\\n            }\\n            _ => {}\\n        }\\n    }\\n\\n    pub fn continue_save(&mut self) {\\n        if !self.has_save {\\n650→            return;\\n        }\\n        let Ok(w) = Self::load_json(&self.save_blob) else { return };\\n        let saves = self.saves_written;\\n        let blob = self.save_blob.clone();\\n        *self = w;\\n        self.saves_written = saves;\\n        self.save_blob = blob;\\n        self.has_save = true;\\n        self.screen = Screen::Playing;\\n660→    }\\n\\n    pub fn bot_input(&self) -> InputFrame {\\n        if self.screen == Screen::Ledger {\\n            return self.bot_ledger();\\n        }\\n        if self.screen != Screen::Playing {\\n            let mut f = InputFrame::default();\\n            f.act = 1;\\n            f.pressed = buttons::CONFIRM;\\n670→            return f;\\n        }\\n        let Some(spec) = self.current() else {\\n            return InputFrame::default();\\n        };\\n        self.bot_spec(spec)\\n    }\\n\\n    fn current(&self) -> Option<Spec> {\\n        script(self.route).get(self.step as usize).copied()\\n680→    }\\n\\n    pub fn goal_name(&self) -> String {\\n        if self.finished {\\n            return \\\"done\\\".into();\\n        }\\n        match self.current() {\\n            Some(Spec::Boot) => \\\"boot\\\",\\n            Some(Spec::Map) => \\\"map\\\",\\n            Some(Spec::Way) => \\\"waypoint\\\",\\n690→            Some(Spec::Reach { .. }) => \\\"reach\\\",\\n            Some(Spec::Fever) => \\\"fever\\\",\\n            Some(Spec::Pill) => \\\"pill\\\",\\n            Some(Spec::Blackout) => \\\"blackout\\\",\\n            Some(Spec::Fight) => \\\"fight\\\",\\n            Some(Spec::EnemyJam) => \\\"enemy_jam\\\",\\n            Some(Spec::Jam) => \\\"jam\\\",\\n            Some(Spec::Break) => \\\"break\\\",\\n            Some(Spec::Rescue) => \\\"rescue\\\",\\n            Some(Spec::Wound(n)) => return format!(\\\"wound{n}\\\"),\\n700→            Some(Spec::Loot) => \\\"loot\\\",\\n            Some(Spec::Claim) => \\\"claim\\\",\\n            Some(Spec::Shop) => \\\"shop\\\",\\n            Some(Spec::Locker) => \\\"locker\\\",\\n            Some(Spec::Syrette) => \\\"syrette\\\",\\n            Some(Spec::Tracker) => \\\"tracker\\\",\\n            Some(Spec::Sleep { .. }) => \\\"sleep\\\",\\n            Some(Spec::Drive { .. }) => \\\"drive\\\",\\n            Some(Spec::Mono) => \\\"mono\\\",\\n            Some(Spec::Ignite(n)) => return format!(\\\"ignite{n}\\\"),\\n710→            Some(Spec::Tanks) => \\\"tanks\\\",\\n            Some(Spec::Mounted) => \\\"mounted\\\",\\n            Some(Spec::Panic) => \\\"panic\\\",\\n            Some(Spec::Animals) => \\\"animals\\\",\\n            Some(Spec::Bus { .. }) => \\\"bus\\\",\\n            Some(Spec::Night) => \\\"night\\\",\\n            Some(Spec::Boat) => \\\"boat\\\",\\n            Some(Spec::Stealth) => \\\"stealth\\\",\\n            Some(Spec::Dart) => \\\"dart\\\",\\n            Some(Spec::Repair) => \\\"repair\\\",\\n720→            Some(Spec::Rain) => \\\"rain\\\",\\n            Some(Spec::Better) => \\\"better\\\",\\n            Some(Spec::Patch) => \\\"patch\\\",\\n            Some(Spec::Overdose) => \\\"overdose\\\",\\n            Some(Spec::Die) => \\\"die\\\",\\n            Some(Spec::Tape) => \\\"tape\\\",\\n            Some(Spec::Ceasefire) => \\\"ceasefire\\\",\\n            Some(Spec::Convoy) => \\\"convoy\\\",\\n            Some(Spec::Town) => \\\"town\\\",\\n            Some(Spec::Ending(n)) => return format!(\\\"ending{n}\\\"),\\n730→            Some(Spec::Flag(s)) => s,\\n            None => \\\"done\\\",\\n        }\\n        .into()\\n    }\\n\\n    pub fn goal_budget(&self) -> f32 {\\n        match self.current() {\\n            Some(Spec::Reach { .. }) => 160.0,\\n            Some(Spec::Drive { .. }) => 140.0,\\n740→            Some(Spec::Boat) => 240.0,\\n            Some(Spec::Town) => 220.0,\\n            Some(Spec::Bus { .. }) => 90.0,\\n            Some(Spec::Blackout) => 80.0,\\n            Some(Spec::Break) => 90.0,\\n            Some(Spec::Die) => 55.0,\\n            Some(Spec::Ending(_)) => {\\n                if self.finale == Some(1) || (self.finale.is_none() && matches!(self.current(), Some(Spec::Ending(1)))) {\\n                    200.0\\n                } else {\\n750→                    40.0\\n                }\\n            }\\n            Some(Spec::Sleep { .. }) | Some(Spec::Tracker) => 50.0,\\n            Some(Spec::Fight) | Some(Spec::EnemyJam) => 25.0,\\n            _ => 30.0,\\n        }\\n    }\\n\\n    fn advance_script(&mut self, dt: f32) {\",\"content_concise\":\"580→    pub fn spawn_dummy(&mut self, x: f32, z: f32, hp: f32) -> usize {\\n        self.bodies.push(Body {\\n            kind: 4,\\n            x,\\n            z,\\n            yaw: 0.0,\\n            hp,\\n            alive: true,\\n            alert: 0,\\n            gun: Gun::new(WeaponId::Pistol),\\n590→            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n        self.bodies.len() - 1\\n    }\\n\\n    pub fn add_wall(&mut self, min: [f32; 3], max: [f32; 3]) {\\n600→        self.walls.push(Wall { min, max });\\n    }\\n\\n    pub fn tick(&mut self, input: &InputFrame, dt: f32) {\\n        let dt = dt.clamp(0.0, 0.5);\\n        self.apply_console(input);\\n        if self.screen != Screen::Playing {\\n            self.shell_tick(input, dt);\\n        } else if input.act == 10 && !self.hub {\\n            self.screen = Screen::Pause;\\n610→            self.focus = 0;\\n            self.idle = 0.0;\\n        } else {\\n            self.simulate(input, dt);\\n        }\\n        if self.route != Route::Sandbox {\\n            self.advance_script(dt);\\n        }\\n        if self.wind.length() > 6.0 && self.screen == Screen::Playing {\\n            self.mark(\\\"wind_rag\\\");\\n620→        }\\n        self.minutes += dt;\\n        self.maybe_reman();\\n    }\\n\\n    /// Numbered actions from the page. These run on every screen, including play,\\n    /// because the shell does not tick while a contract is running.\\n    fn apply_console(&mut self, input: &InputFrame) {\\n        match input.act {\\n            11 => self.dev.god = !self.dev.god,\\n630→            12 => {\\n                let (lo, hi, step) = self.tune.range(8);\\n                self.tune.set(8, (self.tune.get(8) + step).clamp(lo, hi));\\n            }\\n            13 => self.tune = self.tune0.clone(),\\n            14 => self.xbox = !self.xbox,\\n            15 => self.write_save(),\\n            16 => self.continue_save(),\\n            18 => {\\n                self.screen = Screen::Settings;\\n640→                self.tab = 0;\\n                self.focus = 0;\\n                self.idle = 0.0;\\n            }\\n            _ => {}\\n        }\\n    }\\n\\n    pub fn continue_save(&mut self) {\\n        if !self.has_save {\\n650→            return;\\n        }\\n        let Ok(w) = Self::load_json(&self.save_blob) else { return };\\n        let saves = self.saves_written;\\n        let blob = self.save_blob.clone();\\n        *self = w;\\n        self.saves_written = saves;\\n        self.save_blob = blob;\\n        self.has_save = true;\\n        self.screen = Screen::Playing;\\n660→    }\\n\\n    pub fn bot_input(&self) -> InputFrame {\\n        if self.screen == Screen::Ledger {\\n            return self.bot_ledger();\\n        }\\n        if self.screen != Screen::Playing {\\n            let mut f = InputFrame::default();\\n            f.act = 1;\\n            f.pressed = buttons::CONFIRM;\\n670→            return f;\\n        }\\n        let Some(spec) = self.current() else {\\n            return InputFrame::default();\\n        };\\n        self.bot_spec(spec)\\n    }\\n\\n    fn current(&self) -> Option<Spec> {\\n        script(self.route).get(self.step as usize).copied()\\n680→    }\\n\\n    pub fn goal_name(&self) -> String {\\n        if self.finished {\\n            return \\\"done\\\".into();\\n        }\\n        match self.current() {\\n            Some(Spec::Boot) => \\\"boot\\\",\\n            Some(Spec::Map) => \\\"map\\\",\\n            Some(Spec::Way) => \\\"waypoint\\\",\\n690→            Some(Spec::Reach { .. }) => \\\"reach\\\",\\n            Some(Spec::Fever) => \\\"fever\\\",\\n            Some(Spec::Pill) => \\\"pill\\\",\\n            Some(Spec::Blackout) => \\\"blackout\\\",\\n            Some(Spec::Fight) => \\\"fight\\\",\\n            Some(Spec::EnemyJam) => \\\"enemy_jam\\\",\\n            Some(Spec::Jam) => \\\"jam\\\",\\n            Some(Spec::Break) => \\\"break\\\",\\n            Some(Spec::Rescue) => \\\"rescue\\\",\\n            Some(Spec::Wound(n)) => return format!(\\\"wound{n}\\\"),\\n700→            Some(Spec::Loot) => \\\"loot\\\",\\n            Some(Spec::Claim) => \\\"claim\\\",\\n            Some(Spec::Shop) => \\\"shop\\\",\\n            Some(Spec::Locker) => \\\"locker\\\",\\n            Some(Spec::Syrette) => \\\"syrette\\\",\\n            Some(Spec::Tracker) => \\\"tracker\\\",\\n            Some(Spec::Sleep { .. }) => \\\"sleep\\\",\\n            Some(Spec::Drive { .. }) => \\\"drive\\\",\\n            Some(Spec::Mono) => \\\"mono\\\",\\n            Some(Spec::Ignite(n)) => return format!(\\\"ignite{n}\\\"),\\n710→            Some(Spec::Tanks) => \\\"tanks\\\",\\n            Some(Spec::Mounted) => \\\"mounted\\\",\\n            Some(Spec::Panic) => \\\"panic\\\",\\n            Some(Spec::Animals