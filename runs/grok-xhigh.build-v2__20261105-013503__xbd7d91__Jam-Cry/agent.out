":1280,\"content\":\"            if self.mono_t > 0.5 && self.bodies.iter().any(|b| b.alive && geom::dist(self.x, self.z, b.x, b.z) < 80.0) {\"},{\"line_number\":1284,\"content\":\"            self.mono_t = 0.0;\"},{\"line_number\":1295,\"content\":\"        let wind = self.wind * self.tune.wind_strength;\"},{\"line_number\":1296,\"content\":\"        let out = self.fire.tick(dt, wind, self.tune.fire_spread, self.tune.burn_time, self.minutes, rain, &mut self.rng);\"},{\"line_number\":1321,\"content\":\"        let sprint = input.down(buttons::FOCUS) && self.stamina > 0.0 && self.stance == 0;\"},{\"line_number\":1329,\"content\":\"        speed *= match self.stance {\"},{\"line_number\":1608,\"content\":\"                    if kind == 1 && self.stance == 1 && silent {\"},{\"line_number\":1640,\"content\":\"        let stance = self.stance;\"},{\"line_number\":1679,\"content\":\"            let crouched = stance == 1;\"},{\"line_number\":1681,\"content\":\"            let posture = match stance {\"},{\"line_number\":1824,\"content\":\"            let crouched = self.stance == 1;\"},{\"line_number\":2252,\"content\":\"            \\\"fov\\\": if self.mono_t > 0.0 { 15.0 } else if false { 55.0 } else { 75.0 },\"},{\"line_number\":2254,\"content\":\"            \\\"stance\\\": self.stance,\"},{\"line_number\":2261,\"content\":\"            \\\"wind\\\": self.wind.length(),\"},{\"line_number\":2394,\"content\":\"        \\\"Animation: simulation-driven poses. The rifle and the wind rag are boxes. No skeletal clip.\\\".into(),\"},{\"line_number\":2418,\"content\":\"        \\\"Name the WebGPU flags beside the screenshot check, and say the visual room is only a window onto the country.\\\".into(),\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"b0c992cc-4845-4346-816a-ad2b9602f931"}
