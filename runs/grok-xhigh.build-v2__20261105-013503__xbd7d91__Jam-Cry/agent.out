ell_center((ix, iz));\\n                if geom::dist(px, pz, x, z) <= radius && self.ignite_cell((ix, iz), life, minutes) {\\n                    n += 1;\\n                }\\n            }\\n        }\\n        n\\n    }\\n\\n    /// Step the grid. Returns cells extinguished by rain.\\n    pub fn tick(&mut self, dt: f32, wind: Vec2, spread: f32, burn_time: f32, minutes: f32, rain: bool, rng: &mut Rng) -> u32 {\\n        self.wind_for_test = wind;\\n        self.acc += dt;\\n        let mut extinguished = 0;\\n        if rain {\\n            let keys: Vec<_> = self.cells.iter().filter(|(_, c)| c.burning).map(|(k, _)| *k).collect();\\n            for k in keys {\\n                self.cells.remove(&k);\\n                extinguished += 1;\\n            }\\n            self.acc = 0.0;\\n            return extinguished;\\n        }\\n        while self.acc >= FIRE_DT {\\n            self.acc -= FIRE_DT;\\n            self.spread_once(wind, spread, burn_time, minutes, rng);\\n        }\\n        let done: Vec<_> = self.cells.iter().filter(|(_, c)| c.burning && c.life <= 0.0).map(|(k, _)| *k).collect();\\n        for k in done {\\n            if let Some(c) = self.cells.get_mut(&k) {\\n                c.burning = false;\\n                // Two in-game days. One real second is one in-game minute, so 48 hours = 2880 minutes.\\n                c.burnt_until = minutes + 48.0 * 60.0;\\n                c.life = 0.0;\\n            }\\n        }\\n        self.cells.retain(|_, c| c.burning || minutes < c.burnt_until);\\n        extinguished\\n    }\\n\\n    fn spread_once(&mut self, wind: Vec2, spread: f32, burn_time: f32, minutes: f32, rng: &mut Rng) {\\n        let speed = wind.length();\\n        let dir = if speed > 1e-3 { wind / speed } else { Vec2::new(0.0, -1.0) };\\n        let burning: Vec<(i32, i32)> = self.cells.iter().filter(|(_, c)| c.burning).map(|(k, _)| *k).collect();\\n        if burning.is_empty() {\\n            return;\\n        }\\n        // Age the flames.\\n        for k in &burning {\\n            if let Some(c) = self.cells.get_mut(k) {\\n                c.life -= FIRE_DT;\\n            }\\n        }\\n        if speed < 0.5 {\\n            // Calm: grow the four extremes together so the scar stays roughly round.\\n            let positives = [\\n                *burning.iter().max_by(|a, b| a.0.cmp(&b.0)).unwrap(),\\n                *burning.iter().min_by(|a, b| a.0.cmp(&b.0)).unwrap(),\\n                *burning.iter().max_by(|a, b| a.1.cmp(&b.1)).unwrap(),\\n                *burning.iter().min_by(|a, b| a.1.cmp(&b.1)).unwrap(),\\n            ];\\n            let offs = [(1, 0), (-1, 0), (0, 1), (0, -1)];\\n            let p = (spread * 0.35 * FIRE_DT).clamp(0.0, 0.5);\\n            for (tip, off) in positives.iter().zip(offs) {\\n                if rng.f32() < p {\\n                    let _ = self.ignite_cell((tip.0 + off.0, tip.1 + off.1), burn_time, minutes);\\n                }\\n            }\\n            return;\\n        }\\n        let proj = |c: (i32, i32)| {\\n            let (x, z) = cell_center(c);\\n            x * dir.x + z * dir.y\\n        };\\n        let down = *burning.iter().max_by(|a, b| proj(**a).total_cmp(&proj(**b))).unwrap();\\n        let up = *burning.iter().min_by(|a, b| proj(**a).total_cmp(&proj(**b))).unwrap();\\n        self.try_tip(down, dir, true, speed, spread, burn_time, minutes, rng);\\n        self.try_tip(up, dir, false, speed, spread, burn_time, minutes, rng);\\n        // Embers jump only above 8 m/s, far enough to cross a road.\\n        if speed > 8.0 && rng.f32() < 0.12 {\\n            let (x, z) = cell_center(down);\\n            let hop = 6.0 + rng.f32() * 9.0;\\n            let _ = self.ignite_at(x + dir.x * hop, z + dir.y * hop, burn_time, minutes);\\n        }\\n    }\\n\\n    fn try_tip(&mut self, tip: (i32, i32), dir: Vec2, downwind: bool, speed: f32, spread: f32, burn_time: f32, minutes: f32, rng: &mut Rng) {\\n        let step = if downwind { (dir.x.signum() as i32, dir.y.signum() as i32) } else { (-dir.x.signum() as i32, -dir.y.signum() as i32) };\\n\",\"total_lines\":192}}","is_error":false},{"type":"tool_result","tool_use_id":"call-e93deaeb-056c-4fd5-a49e-34e3a3793135-11","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1490→        if wish.length_squared() > 1e-6 {\\n            let n = wish.normalize();\\n            self.x += n.x * speed * dt;\\n            self.z += n.y * speed * dt;\\n        }\\n        let (x, z) = geom::clamp_map(self.x, self.z);\\n        self.x = x;\\n        self.z = z;\\n    }\\n\\n1500→    fn use_vehicle(&mut self, input: &InputFrame, dt: f32) {\\n        if self.dev.noclip {\\n            return;\\n        }\\n        if input.just(buttons::USE) && self.ride.kind != 0 {\\n            let near = geom::dist(self.x, self.z, self.ride.x, self.ride.z) < 6.0;\\n            if self.ride.seat != 0 || near {\\n                self.ride.seat = (self.ride.seat + 1) % 3;\\n            }\\n            if self.ride.seat == 2 {\\n1510→                // gunner\\n            }\\n        }\\n        if self.ride.seat == 0 {\\n            if self.ride.kind != 0 && geom::dist(self.x, self.z, self.ride.x, self.ride.z) < 5.0 && input.down(buttons::INTERACT) {\\n                self.ride.repair += dt;\\n                if self.ride.repair >= 6.0 && self.ride.health < 70.0 {\\n                    self.ride.health = 70.0;\\n                    self.ride.stage = 1;\\n                    self.ride.fuse = 0.0;\\n1520→                    self.ride.repair = 0.0;\\n                    self.mark(\\\"repair_done\\\");\\n                }\\n            }\\n            return;\\n        }\\n        let steer = input.axes.x;\\n        self.ride.yaw = geom::wrap_angle(self.ride.yaw + steer * dt * 1.6);\\n        let mut max_s = 16.0 * self.tune.vehicle_speed;\\n        if self.ride.stage == 2 {\\n1530→            max_s *= 0.6;\\n        }\\n        if self.ride.stage >= 3 {\\n            max_s *= 0.2;\\n        }\\n        if self.ride.kind == 2 && !geom::deep_water(self.ride.x, self.ride.z) {\\n            max_s = 0.0;\\n        }\\n        let throttle = input.axes.y;\\n        self.ride.speed += (throttle.clamp(-0.4, 1.0) * max_s - self.ride.speed) * (dt * 2.5).min(1.0);\\n1540→        let (sy, cy) = self.ride.yaw.sin_cos();\\n        let before = (self.ride.x, self.ride.z);\\n        self.ride.x += sy * self.ride.speed * dt;\\n        self.ride.z += -cy * self.ride.speed * dt;\\n        let (x, z) = geom::clamp_map(self.ride.x, self.ride.z);\\n        self.ride.x = x;\\n        self.ride.z = z;\\n        self.ride.dist += geom::dist(before.0, before.1, self.ride.x, self.ride.z);\\n        let h = geom::height(self.ride.x, self.ride.z);\\n        let h2 = geom::height(self.ride.x + sy * 2.0, self.ride.z - cy * 2.0);\\n1550→        self.ride.pitch = (h2 - h).atan();\\n        if self.ride.roll.abs() > 0.02 {\\n            self.ride.roll *= (1.0 - dt * 3.0).clamp(0.0, 1.0);\\n        }\\n        self.x = self.ride.x;\\n        self.z = self.ride.z;\\n        if self.ride.kind == 1 && self.ride.dist > 20.0 {\\n            self.mark(\\\"technical_driven\\\");\\n        }\\n        if self.ride.kind == 2 && self.ride.dist > 15.0 && geom::deep_water(self.ride.x, self.ride.z) {\\n1560→            self.mark(\\\"boat_driven\\\");\\n            self.boat_dist = self.ride.dist;\\n        }\\n        if self.ride.seat == 2 && input.down(buttons::PRIMARY) {\\n            self.mark(\\\"mounted_gun\\\");\\n        }\\n        if self.ride.stage == 3 {\\n            self.ride.fuse -= dt;\\n            if self.ride.fuse <= 0.0 {\\n                self.ride.stage = 4;\",\"content_concise\":\"1490→        if wish.length_squared() > 1e-6 {\\n            let n = wish.normalize();\\n            self.x += n.x * speed * dt;\\n            self.z += n.y * speed * dt;\\n        }\\n        let (x, z) = geom::clamp_map(self.x, self.z);\\n        self.x = x;\\n        self.z = z;\\n    }\\n