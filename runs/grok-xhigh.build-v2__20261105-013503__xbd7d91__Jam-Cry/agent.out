  v.push(Spec::Shop);\\n    v.push(Spec::Locker);\\n    v.push(Spec::Syrette);\\n    v.push(Spec::Tracker);\\n    v.push(Spec::Sleep { hours: 8.0 });\\n    v.push(Spec::Flag(\\\"contract_a1\\\"));\\n    v.push(Spec::Drive { x: -520.0, z: -520.0 });\\n    v.push(Spec::Mono);\\n    for ig in 0..12 {\\n        v.push(Spec::Ignite(ig));\\n    }\\n    v.push(Spec::Tanks);\\n    v.push(Spec::Mounted);\\n    v.push(Spec::Panic);\\n    v.push(Spec::Animals);\\n    v.push(Spec::Flag(\\\"contract_b1\\\"));\\n    v.push(Spec::Bus { x: 0.0, z: 380.0 });\\n    v.push(Spec::Drive { x: -260.0, z: -700.0 });\\n    v.push(Spec::Sleep { hours: 26.0 });\\n    v.push(Spec::Night);\\n    v.push(Spec::Boat);\\n    v.push(Spec::Stealth);\\n    v.push(Spec::Dart);\\n    v.push(Spec::Flag(\\\"contract_b2\\\"));\\n    v.push(Spec::Repair);\\n    v.push(Spec::Rain);\\n    v.push(Spec::Flag(\\\"contract_b3\\\"));\\n    v.push(Spec::Better);\\n    match route {\\n        Route::Read => v.push(Spec::Overdose),\\n        Route::Chair => v.push(Spec::Die),\\n        _ => v.push(Spec::Patch),\\n    }\\n    v.push(Spec::Flag(\\\"contract_b4\\\"));\\n    v.push(Spec::Tape);\\n    v.push(Spec::Ceasefire);\\n    v.push(Spec::Flag(\\\"contract_c1\\\"));\\n    v.push(Spec::Convoy);\\n    v.push(Spec::Flag(\\\"contract_c2\\\"));\\n    v.push(Spec::Town);\\n    v.push(Spec::Flag(\\\"contract_c3\\\"));\\n    v.push(Spec::Drive { x: -760.0, z: 620.0 });\\n    v.push(Spec::Flag(\\\"contract_d1\\\"));\\n    let end = match route {\\n        Route::Read => 1,\\n        Route::Chair => 2,\\n        _ => 0,\\n    };\\n    v.push(Spec::Ending(end));\\n    v.push(Spec::Flag(\\\"contract_d2\\\"));\\n    v\\n}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct World {\\n    pub seed: u64,\\n    pub rng: Rng,\\n    pub route: Route,\\n    pub screen: Screen,\\n    pub focus: usize,\\n    pub tab: usize,\\n    pub page: usize,\\n    pub difficulty: u8,\\n    pub merc: u8,\\n    pub x: f32,\\n    pub z: f32,\\n    pub yaw: f32,\\n    pub pitch: f32,\\n    pub roll: f32,\\n    pub eye: f32,\\n    pub stance: u8,\\n    pub stamina: f32,\\n    pub hp: f32,\\n    pub syrettes: u32,\\n    pub pills: u32,\\n    pub diamonds: u32,\\n    pub infamy: i32,\\n    pub guns: Vec<Gun>,\\n    pub slot: usize,\\n    pub syrette_t: f32,\\n    pub heal_t: f32,\\n    pub wound: u8,\\n    pub pill_t: f32,\\n    pub fever_t: f32,\\n    pub fever_state: u8,\\n    pub fever_warn: f32,\\n    pub fever_attack: f32,\\n    pub bodies: Vec<Body>,\\n    pub walls: Vec<Wall>,\\n    pub fire: FireMap,\\n    pub wind: Vec2,\\n    pub weather: u8,\\n    pub minutes: f32,\\n    pub ceasefire: bool,\\n    pub companions: Vec<Companion>,\\n    pub rescue_t: f32,\\n    pub ride: Ride,\\n    pub flags: BTreeSet<String>,\\n    pub step: u16,\\n    pub step_ready: bool,\\n    pub step_t: f32,\\n    pub step_x: f32,\\n    pub step_z: f32,\\n    pub step_yaw: f32,\\n    #[serde(default)]\\n    pub finale: Option<u8>,\\n    pub waypoint: Option<(f32, f32)>,\\n    pub map_t: f32,\\n    pub mono_t: f32,\\n    pub post_clear: bool,\\n    pub post_reman_at: f32,\\n    pub looking_at_post: bool,\\n    pub saves_written: u32,\\n    pub save_blob: String,\\n    pub has_save: bool,\\n    pub idle: f32,\\n    pub attract_t: f32,\\n    pub attract_seen: u16,\\n    pub attract_loops: u32,\\n    pub device: Device,\\n    pub device_lock: u8,\\n    pub xbox: bool,\\n    pub tune: Tune,\\n    pub tune0: Tune,\\n    pub dev: Dev,\\n    pub hub: bool,\\n    pub touch_only: bool,\\n    pub music: f32,\\n    pub finished: bool,\\n    pub hold_t: f32,\\n    pub tracker_cache: (f32, f32),\\n    pub treating: bool,\\n    pub jam_seen: bool,\\n    pub boat_dist: f32,\\n    /// Menu pointer in canvas pixels. The page sets it; the shell consumes it.\\n    #[serde(default)]\\n    pub pointer: Option<(f32, f32)>,\\n\",\"total_lines\":2806}}","is_error":false},{"type":"tool_result","tool_use_id":"call-60b300cd-c6d0-479e-91e0-5e6bd3ef19be-15","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"580→    pub fn spawn_dummy(&mut self, x: f32, z: f32, hp: f32) -> usize {\\n        self.bodies.push(Body {\\n            kind: 4,\\n            x,\\n            z,\\n            yaw: 0.0,\\n            hp,\\n            alive: true,\\n            alert: 0,\\n            gun: Gun::new(WeaponId::Pistol),\\n590→            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n        self.bodies.len() - 1\\n    }\\n\\n    pub fn add_wall(&mut self, min: [f32; 3], max: [f32; 3]) {\\n600→        self.walls.push(Wall { min, max });\\n    }\\n\\n    pub fn tick(&mut self, input: &InputFrame, dt: f32) {\\n        let dt = dt.clamp(0.0, 0.5);\\n        self.apply_console(input);\\n        if self.screen != Screen::Playing {\\n            self.shell_tick(input, dt);\\n        } else if input.act == 10 && !self.hub {\\n            self.screen = Screen::Pause;\\n610→            self.focus = 0;\\n            self.idle = 0.0;\\n        } else {\\n            self.simulate(input, dt);\\n        }\\n        if self.route != Route::Sandbox {\\n            self.advance_script(dt);\\n        }\\n        if self.wind.length() > 6.0 && self.screen == Screen::Playing {\\n            self.mark(\\\"wind_rag\\\");\\n620→        }\\n        self.minutes += dt;\\n        self.maybe_reman();\\n    }\\n\\n    /// Numbered actions from the page. These run on every screen, including play,\\n    /// because the shell does not tick while a contract is running.\\n    fn apply_console(&mut self, input: &InputFrame) {\\n        match input.act {\\n            11 => self.dev.god = !self.dev.god,\\n630→            12 => {\\n                let (lo, hi, step) = self.tune.range(8);\\n                self.tune.set(8, (self.tune.get(8) + step).clamp(lo, hi));\\n            }\\n            13 => self.tune = self.tune0.clone(),\\n            14 => self.xbox = !self.xbox,\\n            15 => self.write_save(),\\n            16 => self.continue_save(),\\n            18 => {\\n                self.screen = Screen::Settings;\\n640→                self.tab = 0;\\n                self.focus = 0;\\n                self.idle = 0.0;\\n            }\\n            _ => {}\\n        }\\n    }\\n\\n    pub fn continue_save(&mut self) {\\n        if !self.has_save {\\n650→            return;\\n        }\\n        let Ok(w) = Self::load_json(&self.save_blob) else { return };\\n        let saves = self.saves_written;\\n        let blob = self.save_blob.clone();\\n        *self = w;\\n        self.saves_written = saves;\\n        self.save_blob = blob;\\n        self.has_save = true;\\n        self.screen = Screen::Playing;\\n660→    }\\n\\n    pub fn bot_input(&self) -> InputFrame {\\n        if self.screen == Screen::Ledger {\\n            return self.bot_ledger();\\n        }\\n        if self.screen != Screen::Playing {\\n            let mut f = InputFrame::default();\\n            f.act = 1;\\n            f.pressed = buttons::CONFIRM;\\n670→            return f;\\n        }\\n        let Some(spec) = self.current() else {\\n            return InputFrame::default();\\n        };\\n        self.bot_spec(spec)\\n    }\\n\\n    fn current(&self) -> Option<Spec> {\\n        script(self.route).get(self.step as usize).copied()\\n680→    }\\n\\n    pub fn goal_name(&self) -> String {\\n        if self.finished {\\n            return \\\"done\\\".into();\\n        }\\n        match self.current() {\\n            Some(Spec::Boot) => \\\"boot\\\",\\n            Some(Spec::Map) => \\\"map\\\",\\n            Some(Spec::Way) => \\\"waypoint\\\",\\n690→            Some(Spec::Reach { .. }) => \\\"reach\\\",\\n            Some(Spec::Fever) => \\\"fever\\\",\\n            Some(Spec::Pill) => \\\"pill\\\",\\n            Some(Spec::Blackout) => \\\"blackout\\\",\\n            Some(Spec::Fight) => \\\"fight\\\",\\n            Some(Spec::EnemyJam) => \\\"enemy_jam\\\",\\n            Some(Spec::Jam) => \\\"jam\\\",\\n            Some(Spec::Break) => \\\"break\\\",\\n            Some(Spec::Rescue) => \\\"rescue\\\",\\n            Some(Spec::Wound(n)) => return format!(\\\"wound{n}\\\"),\\n700→            Some(Spec::Loot) => \\\"loot\\\",\\n            Some(Spec::Claim) => \\\"claim\\\",\\n            Some(Spec::Shop) => \\\"shop\\\",\\n            Some(Spec::Locker) => \\\"locker\\\",\\n            Some(Spec::Syrette) => \\\"syrette\\\",\\n            Some(Spec::Tracker) => \\\"tracker\\\",\\n            Some(Spec::Sleep { .. }) => \\\"sleep\\\",\\n            Some(Spec::Drive { .. }) => \\\"drive\\\",\\n            Some(Spec::Mono) => \\\"mono\\\",\\n            Some(Spec::Ignite(n)) => return format!(\\\"ignite{n}\\\"),\\n710→            Some(Spec::Tanks) => \\\"tanks\\\",\\n            Some(Spec::Mounted) => \\\"mounted\\\",\\n            Some(Spec::Panic) => \\\"panic\\\",\\n            Some(Spec::Animals) => \\\"animals\\\",\\n            Some(Spec::Bus { .. }) => \\\"bus\\\",\\n            Some(Spec::Night) => \\\"night\\\",\\n            Some(Spec::Boat) => \\\"boat\\\",\\n            Some(Spec::Stealth) => \\\"stealth\\\",\\n            Some(Spec::Dart) => \\\"dart\\\",\\n            Some(Spec::Repair) => \\\"repair\\\",\\n720→            Some(Spec::Rain) => \\\"rain\\\",\\n            Some(Spec::Better) => \\\"better\\\",\\n            Some(Spec::Patch) => \\\"patch\\\",\\n            Some(Spec::Overdose) => \\\"overdose\\\",\\n            Some(Spec::Die) => \\\"die\\\",\\n            Some(Spec::Tape) => \\\"tape\\\",\\n            Some(Spec::Ceasefire) => \\\"ceasefire\\\",\\n            Some(Spec::Convoy) => \\\"convoy\\\",\\n            Some(Spec::Town) => \\\"town\\\",\\n            Some(Spec::Ending(n)) => return format!(\\\"ending{n}\\\"),\\n730→            Some(Spec::Flag(s)) => s,\\n            None => \\\"done\\\",\\n        }\\n        .into()\\n    }\\n\\n    pub fn goal_budget(&self) -> f32 {\\n        match self.current() {\\n            Some(Spec::Reach { .. }) => 160.0,\\n            Some(Spec::Drive { .. }) => 140.0,\\n740→            Some(Spec::Boat) => 240.0,\\n            Some(Spec::Town) => 220.0,\\n            Some(Spec::Bus { .. }) => 90.0,\\n            Some(Spec::Blackout) => 80.0,\\n            Some(Spec::Break) => 90.0,\\n            Some(Spec::Die) => 55.0,\\n            Some(Spec::Ending(_)) => {\\n                if self.finale == Some(1) || (self.finale.is_none() && matches!(self.current(), Some(Spec::Ending(1)))) {\\n                    200.0\\n                } else {\\n750→                    40.0\\n                }\\n            }\\n            Some(Spec::Sleep { .. }) | Some(Spec::Tracker) => 50.0,\\n            Some(Spec::Fight) | Some(Spec::EnemyJam) => 25.0,\\n            _ => 30.0,\\n        }\\n    }\\n\\n    fn advance_script(&mut self, dt: f32) {\\n760→        if self.finished {\\n            return;\\n        }\\n        self.step_t += dt;\\n        for _ in 0..12 {\\n            let Some(spec) = self.current() else {\\n                self.finished = true;\\n                break;\\n            };\\n            if !self.step_ready {\\n770→                self.begin(spec);\\n                self.step_ready = true;\\n                self.step_t = 0.0;\\n            }\\n            if self.done(spec) {\\n                self.step += 1;\\n                self.step_ready = false;\\n                self.step_t = 0.0;\\n            } else {\\n                break;\\n780→            }\\n        }\\n    }\\n\\n    fn begin(&mut self, spec: Spec) {\\n        self.step_x = self.x;\\n        self.step_z = self.z;\\n        self.step_yaw = self.yaw;\\n        self.hold_t = 0.0;\\n        match spec {\\n790→            Spec::Fever => {\\n                self.fever_t = self.tune.fever_interval;\\n            }\\n            Spec::Blackout => {\\n                self.pills = 0;\\n                self.fever_state = 2;\\n                self.fever_attack = 0.0;\\n            }\\n            Spec::Fight => {\\n                self.clear_bodies();\\n800→                for i in 0..4 {\\n                    let ang = i as f32 * 0.4;\\n                    self.spawn_soldier(self.x + ang.sin() * 12.0, self.z - 12.0, 36.0, false);\\n                }\\n            }\\n            Spec::EnemyJam => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 8.0, 80.0, true);\\n            }\\n            Spec::Jam => {\\n810→                let g = self.gun_mut();\\n                g.force_jam = true;\\n                g.jammed = false;\\n                g.broken = false;\\n                g.ammo = 12;\\n                g.condition = 40.0;\\n                self.jam_seen = false;\\n            }\\n            Spec::Break => {\\n                self.guns.push(Gun::new(WeaponId::Smg));\\n820→                self.slot = self.guns.len() - 1;\\n                let g = self.gun_mut();\\n                g.condition = 5.0;\\n                g.wear = 0.0;\\n                g.ammo = 999;\\n                g.reserve = 999;\\n                g.jammed = false;\\n                g.broken = false;\\n                g.cooldown = 0.0;\\n            }\\n830→            Spec::Rescue => {\\n                self.hp = 0.0;\\n                self.rescue_t = 0.0;\\n                for c in &mut self.companions {\\n                    c.alive = true;\\n                    c.rescue_spent = false;\\n                    c.down = false;\\n                }\\n            }\\n            Spec::Wound(n) => {\\n840→                self.hp = 15.0;\\n                self.wound = n;\\n                self.heal_t = 0.0;\\n                self.treating = false;\\n            }\\n            Spec::Syrette => {\\n                if self.hp > 70.0 {\\n                    self.hp = 45.0;\\n                }\\n                self.syrettes = self.syrettes.max(1);\\n850→            }\\n            Spec::Shop => {\\n                if !self.guns.iter().any(|g| g.id == WeaponId::Battle) {\\n                    // The shelf is stocked. Buying happens on the interact.\\n                }\\n            }\\n            Spec::Drive { .. } => {\\n                self.wind = Vec2::new(9.0, 0.0);\\n                // Inland legs need the technical. A boat left on the channel cannot climb the bank.\\n                if self.ride.kind != 1 {\",\"content_concise\":\"580→    pub fn spawn_dummy(&mut self, x: f32, z: f32, hp: f32) -> usize {\\n        self.bodies.push(Body {\\n            kind: 4,\\n            x,\\n            z,\\n            yaw: 0.0,\\n            hp,\\n            alive: true,\\n            alert: 0,\\n            gun: Gun::new(WeaponId::Pistol),\\n590→            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n        self.bodies.len() - 1\\n    }\\n\\n    pub fn add_wall(&mut self, min: [f32; 3], max: [f32; 3]) {\\n600→        self.walls.push(Wall { min, max });\\n    }\\n\\n    pub fn tick(&mut self, input: &InputFrame, dt: f32) {\\n        let dt = dt.clamp(0.0, 0.5);\\n        self.apply_console(input);\\n        if self.screen != Screen::Playing {\\n            self.shell_tick(input, dt);\\n        } else if input.act == 10 && !self.hub {\\n            self.screen = Screen::Pause;\\n610→            self.focus = 0;\\n            self.idle = 0.0;\\n        } else {\\n            self.simulate(input, dt);\\n        }\\n        if self.route != Route::Sandbox {\\n            self.advance_script(dt);\\n        }\\n        if self.wind.length() > 6.0 && self.screen == Screen::Playing {\\n            self.mark(\\\"wind_rag\\\");\\n620→        }\\n        self.minutes += dt;\\n        self.maybe_reman();\\n    }\\n\\n    /// Numbered actions from the page. These run on every screen, including play,\\n    /// because the shell does not tick while a contract is running.\\n    fn apply_console(&mut self, input: &InputFrame) {\\n        match input.act {\\n            11 => self.dev.god = !self.dev.god,\\n630→            12 => {\\n                let (lo, hi, step) = self.tune.range(8);\\n                self.tune.set(8, (self.tune.get(8) + step).clamp(lo, hi));\\n            }\\n            13 => self.tune = self.tune0.clone(),\\n            14 => self.xbox = !self.xbox,\\n            15 => self.write_save(),\\n            16 => self.continue_save(),\\n            18 => {\\n                self.screen = Screen::Settings;\\n640→                self.tab = 0;\\n                self.focus = 0;\\n                self.idle = 0.0;\\n            }\\n            _ => {}\\n        }\\n    }\\n\\n    pub fn continue_save(&mut self) {\\n        if !self.has_save {\\n650→            return;\\n        }\\n        let Ok(w) = Self::load_json(&self.save_blob) else { return };\\n        let saves = self.saves_written;\\n        let blob = self.save_blob.clone();\\n        *self = w;\\n        self.saves_written = saves;\\n        self.save_blob = blob;\\n        self.has_save = true;\\n        self.screen = Screen::Playing;\\n660→    }\\n\\n    pub fn bot_input(&self) -> InputFrame {\\n        if self.screen == Screen::Ledger {\\n            return self.bot_ledger();\\n        }\\n        if self.screen != Screen::Playing {\\n            let mut f = InputFrame::default();\\n            f.act = 1;\\n            f.pressed = buttons::CONFIRM;\\n670→            return f;\\n        }\\n        let Some(spec) = self.current() else {\\n            return InputFrame::default();\\n        };\\n        self.bot_spec(spec)\\n    }\\n\\n    fn current(&self) -> Option<Spec> {\\n        script(self.route).get(self.step as usize).copied()\\n680→    }\\n\\n    pub fn goal_name(&self) -> String {\\n        if self.finished {\\n            return \\\"done\\\".into();\\n        }\\n        match self.current() {\\n            Some(Spec::Boot) => \\\"boot\\\",\\n            Some(Spec::Map) =