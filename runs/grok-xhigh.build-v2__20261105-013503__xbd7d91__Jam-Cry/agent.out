no_fever,\\n            \\\"Noclip\\\" => d.noclip = !d.noclip,\\n            \\\"Invisible\\\" => d.invisible = !d.invisible,\\n            \\\"Show AI\\\" => d.show_ai = !d.show_ai,\\n            \\\"Show fire\\\" => d.show_fire = !d.show_fire,\\n            \\\"Show nav\\\" => d.show_nav = !d.show_nav,\\n            \\\"Show stats\\\" => d.show_stats = !d.show_stats,\\n            _ => {}\\n        }\\n    }\\n\\n    pub fn rows(&self) -> Vec<String> {\\n        let all: Vec<String> = match self.screen {\\n            Screen::Title => {\\n                let mut r = Vec::new();\\n                if self.has_save {\\n                    r.push(\\\"Continue\\\".into());\\n                }\\n                r.extend([\\\"New contract\\\".into(), \\\"Multiplayer\\\".into(), \\\"Settings\\\".into(), \\\"About\\\".into()]);\\n                r\\n            }\\n            Screen::Difficulty => vec![\\\"Easy\\\".into(), \\\"Normal\\\".into(), \\\"Hard\\\".into()],\\n            Screen::Merc => vec![\\\"Ada Okoro\\\".into(), \\\"Tomek Wrona\\\".into(), \\\"Rafael Quintero\\\".into(), \\\"Mirela Dragan\\\".into()],\\n            Screen::Prologue => vec![\\\"Begin\\\".into()],\\n            Screen::Pause => {\\n                let mut rows = vec![\\\"Resume\\\".into(), \\\"Settings\\\".into(), \\\"Controls\\\".into()];\\n                if !self.hub {\\n                    rows.push(\\\"Dev mode\\\".into());\\n                }\\n                rows.push(\\\"Quit to title\\\".into());\\n                rows\\n            }\\n            Screen::Settings => self.settings_rows(),\\n            Screen::About => vec![\\\"Next\\\".into(), \\\"Back\\\".into()],\\n            Screen::Dev => self.dev_rows(),\\n            Screen::Mp => vec![\\\"This computer\\\".into(), \\\"Invite code\\\".into(), \\\"Back\\\".into()],\\n            Screen::Attract => vec![\\\"Press any button\\\".into()],\\n            Screen::Playing => vec![],\\n        };\\n        all.into_iter().take(7).collect()\\n    }\\n\\n    fn settings_rows(&self) -> Vec<String> {\\n        match self.tab % 4 {\\n            0 => vec![\\\"Master\\\".into(), \\\"Music\\\".into(), \\\"Effects\\\".into(), \\\"Voices\\\".into(), \\\"Page\\\".into()],\\n            1 => vec![\\\"PlayStation glyphs\\\".into(), \\\"Xbox glyphs\\\".into(), \\\"Invert look\\\".into(), \\\"Sensitivity\\\".into(), \\\"Aim assist\\\".into(), \\\"Page\\\".into()],\\n            2 => vec![\\\"Fullscreen\\\".into(), \\\"Field of view\\\".into(), \\\"Brightness\\\".into(), \\\"Head bob\\\".into(), \\\"Page\\\".into()],\\n            _ => vec![\\\"Subtitle size\\\".into(), \\\"Reduce motion\\\".into(), \\\"Assist markers\\\".into(), \\\"Immersive hud\\\".into(), \\\"Page\\\".into()],\\n        }\\n    }\\n\\n    fn dev_rows(&self) -> Vec<String> {\\n        match self.tab {\\n            0 => vec![\\\"Cheats\\\".into(), \\\"Teleport\\\".into(), \\\"Spawn\\\".into(), \\\"World\\\".into(), \\\"Balance\\\".into()],\\n            1 => {\\n                let names = [\\\"God mode\\\", \\\"Infinite ammo\\\", \\\"No jams\\\", \\\"No fever\\\", \\\"Noclip\\\", \\\"Invisible\\\", \\\"Show AI\\\", \\\"Show fire\\\", \\\"Show nav\\\", \\\"Show stats\\\"];\\n                self.page_of(&names)\\n            }\\n            2 => {\\n                let names: Vec<&str> = super::geom::PLACES.iter().map(|p| p.name).collect();\\n                self.page_of_owned(names)\\n            }\\n            5 => {\\n                let mut rows = Vec::new();\\n                let start = self.page * 6;\\n                for i in start..(start + 6).min(self.tune.count()) {\\n                    rows.push(format!(\\\"{} {:.2}\\\", self.tune.name(i), self.tune.get(i)));\\n                }\\n                rows.push(\\\"Reset to defaults\\\".into());\\n                if start + 6 < self.tune.count() {\\n                    rows.pop();\\n                    rows.push(\\\"Next page\\\".into());\\n                    // Keep reset reachable: the last page holds it. Mid pages use Next.\\n                }\\n                if start + 6 >= self.tune.count() && !rows.iter().any(|r| r == \\\"Reset to defaults\\\") {\\n                    rows.push(\\\"Reset to defaults\\\".into());\\n                }\\n                rows\\n            }\\n            _ => vec![\\\"Next page\\\".into(), \\\"Reset to defaults\\\".into()],\\n        }\\n    }\\n\\n    fn page_of(&self, names: &[&str]) -> Vec<String> {\\n        let start = self.page * 6;\\n        let mut rows: Vec<String> = names.iter().skip(start).take(6).map(|s| (*s).to_string()).collect();\\n        if start + 6 < names.len() {\\n            rows.push(\\\"Next page\\\".into());\\n        } else {\\n            rows.push(\\\"Reset to defaults\\\".into());\\n        }\\n        rows\\n    }\\n\\n    fn page_of_owned(&self, names: Vec<&str>) -> Vec<String> {\\n        self.page_of(&names)\\n    }\\n\\n    pub fn notice(&self) -> Option<&'static str> {\\n        if self.touch_only { Some(\\\"Controller or keyboard required\\\") } else { None }\\n    }\\n}\\n\",\"total_lines\":438}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"4a766a8a-240c-4ee5-aa15-da9837fbab39"}
{"type":"assistant","message":{"id":"msg_415","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"I need to study the script's begin, done, and bot_spec functions more carefully. Town, Boat, Night, Ending, and script_ignite require special attention.\n\nI also need to understand movement, camera, props, and how the app copies overlook into the camera. The skeptic wants first-person props like map, GPS, monocular, rifle, and wind rag. In-play choices for burn, read, and chair should replace the hardcoded Route::Human. Warps and flag stamps must go so the bot uses normal player actions. Teleport, spawn, world controls, and noclip need wiring too. This is a large change.\n\nI need to read more of the script implementation and PLAN sections to avoid breaking existing tests. Tests call World::tick and bot_input, while the playthrough uses World::campaign(seed, route). The current test path sets the route at construction, so it never exercises the shell choice. I will make Route::Human the default human start, then let the player choose burn, read, or chair at the ending moment.\n\nThe bot will select burn, read, or chair via normal menu confirm inputs. Existing tests that hardcode routes must be updated to drive this choice in play rather than baking the ending at construction.\n\nThe test currently loops over Route variants. I will remove that loop and let the game start with no locked route. At the ending beat a three-option menu appears: Burn the ledger, Read the names, or Take the chair. The player confirms the row to set the ending. The bot will select the matching row automatically.\n\nThe build() function in mod.rs hardcodes Route::Human, so the shell must offer the burn/read/chair choice. The script also auto-marks ending_burn on the first tick of Spec::Ending(0), which removes player agency at that moment. I need to read the Spec::Ending begin, script_ignite, and bot_spec functions to fix both issues.\n\nThe camera eye must be driven by the player's world position plus stance eye height, with yaw and pitch from the look input. The country should be rendered from that exact eye point.\n\nThe existing dress() creates a small room at the origin. If the player is far from that point, the camera would look at empty space. Moving the props to follow the player would still leave the small diorama visible instead of the country terrain.\n\nThe camera eye will be placed at the player's world xz plus terrain height plus stance eye height. A local patch of terrain and props should generate each frame around the player based on the height and fuel functions.","signature":""},{"type":"tool_use","id":"call-d7bc6d53-6338-481c-b971-e74f1b4fa433-98","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs","offset":768,"limit":520}},{"type":"tool_use","id":"call-d7bc6d53-6338-481c-b971-e74f1b4fa433-99","name":"grep","input":{"pattern":"fn height|fn surface|PLACES|pub fn ignite|stance|MAP|GPS|monocular|prop","path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/geom.rs"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":7770,"output_tokens":1427,"cache_read_input_tokens":135296,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"fd5304f4-1f0f-4814-b7c2-e1c12a0810d6"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-d7bc6d53-6338-481c-b971-e74f1b4fa433-98","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"768→    fn begin(&mut self, spec: Spec) {\\n        self.step_x = self.x;\\n770→        self.step_z = self.z;\\n        self.hold_t = 0.0;\\n        match spec {\\n            Spec::Fever => {\\n                self.fever_t = self.tune.fever_interval;\\n            }\\n            Spec::Blackout => {\\n                self.pills = 0;\\n                self.fever_state = 2;\\n                self.fever_attack = 0.0;\\n780→            }\\n            Spec::Fight => {\\n                self.clear_bodies();\\n                for i in 0..4 {\\n                    let ang = i as f32 * 0.4;\\n                    self.spawn_soldier(self.x + ang.sin() * 12.0, self.z - 12.0, 36.0, false);\\n                }\\n            }\\n            Spec::EnemyJam => {\\n                self.clear_bodies();\\n790→                self.spawn_soldier(self.x, self.z - 8.0, 80.0, true);\\n            }\\n            Spec::Jam => {\\n                let g = self.gun_mut();\\n                g.force_jam = true;\\n                g.jammed = false;\\n                g.broken = false;\\n                g.ammo = 12;\\n                g.condition = 40.0;\\n                self.jam_seen = false;\\n800→            }\\n            Spec::Break => {\\n                self.guns.push(Gun::new(WeaponId::Smg));\\n                self.slot = self.guns.len() - 1;\\n                let g = self.gun_mut();\\n                g.condition = 5.0;\\n                g.wear = 0.0;\\n                g.ammo = 999;\\n                g.reserve = 999;\\n                g.jammed = false;\\n810→                g.broken = false;\\n                g.cooldown = 0.0;\\n            }\\n            Spec::Rescue => {\\n                self.hp = 0.0;\\n                self.rescue_t = 0.0;\\n                for c in &mut self.companions {\\n                    c.alive = true;\\n                    c.rescue_spent = false;\\n                    c.down = false;\\n820→                }\\n            }\\n            Spec::Wound(n) => {\\n                self.hp = 15.0;\\n                self.wound = n;\\n                self.heal_t = 0.0;\\n                self.treating = false;\\n            }\\n            Spec::Syrette => {\\n                if self.hp > 70.0 {\\n830→                    self.hp = 45.0;\\n                }\\n                self.syrettes = self.syrettes.max(1);\\n            }\\n            Spec::Shop => {\\n                if !self.guns.iter().any(|g| g.id == WeaponId::Battle) {\\n                    // The shelf is stocked. Buying happens on the interact.\\n                }\\n            }\\n            Spec::Drive { .. } => {\\n840→                self.wind = Vec2::new(9.0, 0.0);\\n                // Inland legs need the technical. A boat left on the channel cannot climb the bank.\\n                if self.ride.kind != 1 {\\n                    self.ride.kind = 1;\\n                    self.ride.seat = 1;\\n                    self.ride.x = self.x;\\n                    self.ride.z = self.z;\\n                    self.ride.health = 100.0;\\n                    self.ride.stage = 0;\\n                    self.ride.speed = 0.0;\\n850→                    self.ride.fuse = 0.0;\\n                }\\n            }\\n            Spec::Mono => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 24.0, 40.0, false);\\n                self.mono_t = 0.0;\\n            }\\n            Spec::Tanks => {\\n                self.spawn_tank_farm();\\n860→            }\\n            Spec::Panic => {\\n                self.clear_bodies();\\n                let sx = self.x + 4.0;\\n                let sz = self.z - 4.0;\\n                self.spawn_soldier(sx, sz, 40.0, false);\\n                // Runners sprint +x. One 2 m cell ends before flee passes 3.\\n                for i in 0..6 {\\n                    let _ = self.fire.ignite_disk(sx + i as f32 * 4.0, sz, 3.0, self.tune.burn_time, self.minutes);\\n                }\\n870→            }\\n            Spec::Animals => {\\n                self.clear_bodies();\\n                self.spawn_animal(self.x + 6.0, self.z - 6.0);\\n            }\\n            Spec::Night => {\\n                self.minutes = 22.0 * 60.0;\\n                self.mark(\\\"night_contract\\\");\\n            }\\n            Spec::Sleep { .. } => {\\n880→                // The short rest already set this. The long rest has to happen on its own.\\n                self.flags.remove(\\\"sleep_used\\\");\\n            }\\n            Spec::Boat => {\\n                let (wx, wz) = geom::nearest_water(self.x, self.z);\\n                self.ride.kind = 2;\\n                self.ride.seat = 1;\\n                self.ride.x = wx;\\n                self.ride.z = wz;\\n                self.ride.speed = 0.0;\\n890→                self.ride.health = 100.0;\\n                self.x = wx;\\n                self.z = wz;\\n                self.boat_dist = 0.0;\\n            }\\n            Spec::Stealth => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 2.0, 40.0, false);\\n                if let Some(b) = self.bodies.last_mut() {\\n                    b.yaw = 0.0;\\n900→                    b.alert = 0;\\n                }\\n                self.stance = 1;\\n            }\\n            Spec::Dart => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 18.0, 40.0, false);\\n                self.guns.push(Gun::new(WeaponId::Dart));\\n                self.slot = self.guns.len() - 1;\\n            }\\n910→            Spec::Repair => {\\n                if self.ride.kind == 0 {\\n                    self.ride.kind = 1;\\n                    self.ride.x = self.x;\\n                    self.ride.z = self.z;\\n                }\\n                self.ride.seat = 0;\\n                self.ride.health = 35.0;\\n                self.ride.stage = 2;\\n                self.ride.repair = 0.0;\\n920→            }\\n            Spec::Rain => {\\n                // The boat step leaves you on the channel. Rain has to quench grass, not water.\\n                let mut lit = false;\\n                for r in [16.0, 22.0, 30.0, 40.0] {\\n                    for (dx, dz) in [(r, 0.0), (-r, 0.0), (0.0, r), (0.0, -r)] {\\n                        if self.fire.ignite_at(self.x + dx, self.z + dz, self.tune.burn_time, self.minutes) {\\n                            lit = true;\\n                            break;\\n                        }\\n930→                    }\\n                    if lit {\\n                        break;\\n                    }\\n                }\\n                self.weather = 1;\\n            }\\n            Spec::Better => {\\n                self.mark(\\\"better_way\\\");\\n                if let Some(c) = self.companions.iter_mut().find(|c| c.alive) {\\n940→                    c.down = true;\\n                    c.down_t = 0.0;\\n                    c.x = self.x + 1.5;\\n                    c.z = self.z;\\n                }\\n            }\\n            Spec::Patch | Spec::Overdose | Spec::Die => {\\n                self.mark(\\\"better_way\\\");\\n                if let Some(c) = self.companions.iter_mut().find(|c| c.alive) {\\n                    c.down = true;\\n950→                    c.down_t = 0.0;\\n                    c.x = if matches!(spec, Spec::Die) { self.x + 40.0 } else { self.x + 1.5 };\\n                    c.z = self.z;\\n                }\\n                if matches!(spec, Spec::Overdose) {\\n                    if let Some(c) = self.companions.iter_mut().find(|c| c.down) {\\n                        c.down_t = 0.0;\\n                    }\\n                }\\n            }\\n960→            Spec::Ceasefire => {\\n                self.guns.push(Gun::new(WeaponId::Sniper));\\n                self.slot = self.guns.len() - 1;\\n                self.spawn_soldier(self.x, self.z - 30.0, 30.0, false);\\n            }\\n            Spec::Convoy => {\\n                self.clear_bodies();\\n                self.spawn_truck(self.x, self.z - 16.0);\\n                self.guns.push(Gun::new(WeaponId::Rpg));\\n                self.slot = self.guns.len() - 1;\\n970→            }\\n            Spec::Town => {\\n                let (tx, tz) = geom::place(\\\"Kilometre 40\\\");\\n                self.x = tx;\\n                self.z = tz;\\n                let _ = self.fire.ignite_disk(tx, tz + 20.0, 10.0, self.tune.burn_time, self.minutes);\\n                self.mark(\\\"town_burned\\\");\\n            }\\n            Spec::Ending(1) => {\\n                self.clear_bodies();\\n980→                for i in 0..3 {\\n                    self.spawn_soldier(self.x + 40.0 + i as f32 * 4.0, self.z - 50.0, 30.0, false);\\n                }\\n                self.syrettes = self.syrettes.max(4);\\n                self.hold_t = 0.0;\\n            }\\n            Spec::Flag(s) => self.mark(s),\\n            _ => {}\\n        }\\n    }\\n990→\\n    fn done(&mut self, spec: Spec) -> bool {\\n        match spec {\\n            Spec::Boot => self.screen == Screen::Playing,\\n            Spec::Map => self.flags.contains(\\\"map_raised\\\"),\\n            Spec::Way => self.flags.contains(\\\"waypoint_set\\\"),\\n            Spec::Reach { x, z, gps } => {\\n                if gps && self.waypoint.is_some() && geom::dist(self.x, self.z, self.step_x, self.step_z) > 25.0 {\\n                    self.mark(\\\"gps_followed\\\");\\n                }\\n1000→                geom::dist(self.x, self.z, x, z) < 10.0 && (!gps || self.flags.contains(\\\"gps_followed\\\"))\\n            }\\n            Spec::Fever => self.flags.contains(\\\"fever_warned\\\"),\\n            Spec::Pill => self.flags.contains(\\\"pill_taken\\\"),\\n            Spec::Blackout => self.flags.contains(\\\"blackout\\\"),\\n            Spec::Fight => {\\n                let clear = self.bodies.iter().filter(|b| b.kind == 1).all(|b| !b.alive);\\n                if clear && !self.bodies.is_empty() {\\n                    self.post_clear = true;\\n                    self.post_reman_at = self.minutes + self.tune.post_reman_hours * 60.0;\\n1010→                    self.mark(\\\"post_cleared\\\");\\n                }\\n                clear && self.flags.contains(\\\"post_cleared\\\")\\n            }\\n            Spec::EnemyJam => self.flags.contains(\\\"enemy_jam\\\"),\\n            Spec::Jam => self.flags.contains(\\\"jam_cleared\\\"),\\n            Spec::Break => {\\n                if self.gun().broken {\\n                    self.mark(\\\"weapon_broke\\\");\\n                    self.slot = 0;\\n1020→                }\\n                self.flags.contains(\\\"weapon_broke\\\")\\n            }\\n            Spec::Rescue => self.flags.contains(\\\"player_rescued\\\"),\\n            Spec::Wound(n) => self.flags.contains(wound_flag(n)),\\n            Spec::Loot => self.guns.iter().any(|g| g.id == WeaponId::Ar),\\n            Spec::Claim => self.flags.contains(\\\"safe_house_claimed\\\"),\\n            Spec::Shop => self.flags.contains(\\\"weapon_bought\\\"),\\n            Spec::Locker => self.flags.contains(\\\"locker_used\\\"),\\n            Spec::Syrette => self.flags.contains(\\\"syrette\\\"),\\n1030→            Spec::Tracker => self.flags.contains(\\\"cache_tracker\\\"),\\n            Spec::Sleep { .. } => self.flags.contains(\\\"sleep_used\\\") && self.step_t > 0.2,\\n            Spec::Drive { x, z } => geom::dist(self.x, self.z, x, z) < 12.0 && self.flags.contains(\\\"technical_driven\\\"),\\n            Spec::Mono => self.flags.contains(\\\"monocular_tag\\\"),\\n            Spec::Ignite(n) => self.flags.contains(ignite_flag(n)),\\n            Spec::Tanks => self.flags.contains(\\\"cells_500\\\") && self.flags.contains(\\\"explosion_chain\\\"),\\n            Spec::Mounted => self.flags.contains(\\\"mounted_gun\\\"),\\n            Spec::Panic => self.flags.contains(\\\"enemy_panicked\\\"),\\n            Spec::Animals => self.flags.contains(\\\"animals_fled\\\"),\\n            Spec::Bus { x, z } => self.flags.contains(\\\"bus_taken\\\") && geom::dist(self.x, self.z, x, z) < 12.0,\\n1040→            Spec::Night => self.flags.contains(\\\"night_contract\\\"),\\n            Spec::Boat => self.flags.contains(\\\"boat_driven\\\"),\\n            Spec::Stealth => self.flags.contains(\\\"stealth_kill\\\"),\\n            Spec::Dart => self.flags.contains(\\\"dart_kill\\\"),\\n            Spec::Repair => self.flags.contains(\\\"repair_done\\\"),\\n            Spec::Rain => self.flags.contains(\\\"rain_extinguished\\\"),\\n            Spec::Better => self.flags.contains(\\\"better_way\\\") || self.companions.iter().any(|c| c.down),\\n            Spec::Patch => self.flags.contains(\\\"companion_patched\\\"),\\n            Spec::Overdose => self.flags.contains(\\\"companion_overdosed\\\"),\\n            Spec::Die => self.flags.contains(\\\"companion_died\\\"),\\n1050→            Spec::Tape => self.flags.contains(\\\"tape_played\\\"),\\n            Spec::Ceasefire => self.flags.contains(\\\"ceasefire_ended\\\"),\\n            Spec::Convoy => self.bodies.iter().filter(|b| b.kind == 6).all(|b| !b.alive) && !self.bodies.is_empty(),\\n            Spec::Town => self.flags.contains(\\\"town_burned\\\"),\\n            Spec::Ending(n) => self.flags.contains(ending_flag(n)),\\n            Spec::Flag(s) => self.flags.contains(s),\\n        }\\n    }\\n\\n    fn bot_spec(&self, spec: Spec) -> InputFrame {\\n1060→        let mut f = InputFrame::default();\\n        match spec {\\n            Spec::Map => {\\n                f.held = buttons::MAP;\\n                f.pressed = buttons::MAP;\\n            }\\n            Spec::Way | Spec::Claim | Spec::Shop | Spec::Locker | Spec::Loot | Spec::Tape | Spec::Ending(2) => {\\n                f.act = 1;\\n                f.pressed = buttons::INTERACT;\\n                f.held = buttons::INTERACT;\\n1070→            }\\n            Spec::Reach { x, z, .. } => return self.bot_go(x, z, true),\\n            Spec::Tracker => {\\n                let (tx, tz) = self.tracker_cache;\\n                return self.bot_go(tx, tz, true);\\n            }\\n            Spec::Pill => {\\n                f.held = buttons::PILLS;\\n                f.pressed = buttons::PILLS;\\n            }\\n1080→            Spec::Fight | Spec::Ceasefire | Spec::Convoy | Spec::Ignite(10) => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive && b.kind != 3) {\\n                    return self.bot_aim(b.x, b.z, 1.7, true);\\n                }\\n                f.held = buttons::PRIMARY;\\n            }\\n            Spec::EnemyJam | Spec::Blackout | Spec::Fever | Spec::Die | Spec::Ending(1) => {\\n                if matches!(spec, Spec::Ending(1)) {\\n                    f.held = buttons::CROUCH;\\n                }\\n1090→            }\\n            Spec::Jam | Spec::Break => {\\n                if self.gun().jammed {\\n                    f.pressed = buttons::RELOAD;\\n                    f.held = buttons::RELOAD;\\n                } else {\\n                    f.held = buttons::PRIMARY | buttons::SECONDARY;\\n                    f.pressed = buttons::PRIMARY;\\n                }\\n            }\\n1100→            Spec::Rescue => {}\\n            Spec::Wound(_) => {\\n                f.held = buttons::HEAL;\\n                f.pressed = buttons::HEAL;\\n            }\\n            Spec::Syrette => {\\n                f.pressed = buttons::HEAL;\\n                f.held = buttons::HEAL;\\n            }\\n            Spec::Sleep { .. } => {\\n1110→                let (hx, hz) = geom::nearest_safe(self.x, self.z);\\n                if geom::dist(self.x, self.z, hx, hz) > 8.0 && self.ride.seat == 0 {\\n                    return self.bot_go(hx, hz, true);\\n                }\\n                if self.ride.seat != 0 {\\n                    f.pressed = buttons::USE;\\n                } else {\\n                    f.held = buttons::INTERACT;\\n                    f.pressed = buttons::INTERACT;\\n                }\\n1120→            }\\n            Spec::Drive { x, z } => {\\n                let (tx, tz) = (x, z);\\n                if self.ride.seat == 0 {\\n                    f.pressed = buttons::USE;\\n                    return f;\\n                }\\n                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Bus { .. } => {\\n1130→                let (tx, tz) = geom::place(\\\"Junction\\\");\\n                if self.ride.seat == 0 {\\n                    f.pressed = buttons::USE;\\n                    return f;\\n                }\\n                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Mono => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive) {\\n                    let mut aim = self.bot_aim(b.x, b.z, 1.6, false);\\n1140→                    aim.held |= buttons::MONOCULAR;\\n                    aim.pressed |= buttons::MONOCULAR;\\n                    return aim;\\n                }\\n            }\\n            Spec::Ignite(k) => {\\n                if k == 10 {\\n                    f.held = buttons::PRIMARY;\\n                } else if k == 11 {\\n                    f.held = buttons::INTERACT;\\n1150→                    f.pressed = buttons::INTERACT;\\n                } else {\\n                    f.pressed = buttons::PRIMARY;\\n                    f.held = buttons::PRIMARY;\\n                }\\n            }\\n            Spec::Tanks | Spec::Mounted => {\\n                f.held = buttons::PRIMARY;\\n                f.pressed = buttons::PRIMARY;\\n                if matches!(spec, Spec::Mounted) {\\n1160→                    f.pressed |= buttons::USE;\\n                }\\n            }\\n            Spec::Animals => {\\n                // A shot already happened. Firing again drops the herd before it clears the grass.\\n                f.held = buttons::SECONDARY;\\n            }\\n            Spec::Panic => {}\\n            Spec::Boat => {\\n                let (tx, tz) = geom::water_ahead(self.ride.x, self.ride.z, 50.0);\\n1170→                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Stealth => {\\n                f.held = buttons::CROUCH | buttons::MELEE;\\n                f.pressed = buttons::MELEE;\\n            }\\n            Spec::Dart => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive) {\\n                    return self.bot_aim(b.x, b.z, 1.2, true);\\n                }\\n1180→            }\\n            Spec::Repair | Spec::Patch | Spec::Overdose => {\\n                f.held = buttons::INTERACT;\\n                f.pressed = buttons::INTERACT;\\n            }\\n            Spec::Rain | Spec::Night | Spec::Better | Spec::Flag(_) | Spec::Town | Spec::Ending(0) => {\\n                f.pressed = buttons::INTERACT;\\n            }\\n            _ => {}\\n        }\\n1190→        let _ = shell::glyph(\\\"confirm\\\", self.device, self.xbox);\\n        f\\n    }\\n\\n    fn bot_go(&self, tx: f32, tz: f32, sprint: bool) -> InputFrame {\\n        let desired = geom::yaw_toward(self.x, self.z, tx, tz);\\n        let err = geom::wrap_angle(desired - self.yaw);\\n        let mut f = InputFrame::default();\\n        f.look.x = err.clamp(-1.4, 1.4);\\n        if err.abs() < 0.4 {\\n1200→            f.move_dir.y = 1.0;\\n            if sprint && self.stamina > 1.0 {\\n                f.held |= buttons::FOCUS;\\n            }\\n        }\\n        f\\n    }\\n\\n    fn bot_drive(&self, tx: f32, tz: f32) -> InputFrame {\\n        let desired = geom::yaw_toward(self.ride.x, self.ride.z, tx, tz);\\n1210→        let err = geom::wrap_angle(desired - self.ride.yaw);\\n        let mut f = InputFrame::default();\\n        f.axes.x = err.clamp(-1.0, 1.0);\\n        f.axes.y = 1.0;\\n        f\\n    }\\n\\n    fn bot_aim(&self, tx: f32, tz: f32, ty: f32, fire: bool) -> InputFrame {\\n        let dx = tx - self.x;\\n        let dz = tz - self.z;\\n1220→        let dist = (dx * dx + dz * dz).sqrt().max(0.2);\\n        let desired = dx.atan2(-dz);\\n        let err = geom::wrap_angle(desired - self.yaw);\\n        let perr = ((ty - self.eye) / dist).atan() - self.pitch;\\n        let mut f = InputFrame::default();\\n        f.look.x = err.clamp(-1.5, 1.5);\\n        f.look.y = perr.clamp(-1.2, 1.2);\\n        if fire && err.abs() < 0.2 && perr.abs() < 0.2 {\\n            f.held |= buttons::PRIMARY | buttons::SECONDARY;\\n            f.pressed |= buttons::PRIMARY;\\n1230→        }\\n        f\\n    }\\n\\n    pub fn start_playing(&mut self) {\\n        self.screen = Screen::Playing;\\n        let (x, z) = geom::place(\\\"Airstrip\\\");\\n        self.x = x;\\n        self.z = z;\\n        self.yaw = 0.0;\\n1240→        self.eye = 1.58;\\n        self.idle = 0.0;\\n        self.pitch = 0.08;\\n    }\\n\\n    fn simulate(&mut self, input: &InputFrame, dt: f32) {\\n        self.yaw = geom::wrap_angle(self.yaw + input.look.x);\\n        self.pitch = (self.pitch + input.look.y).clamp(-1.15, 1.15);\\n        if self.fever_state == 2 {\\n            self.roll = (self.minutes * 2.0).sin() * 0.05 * self.tune.fever_severity;\\n1250→        } else {\\n            self.roll *= 0.9;\\n        }\\n        if input.down(buttons::CRAWL) {\\n            self.stance = 2;\\n        } else if input.down(buttons::CROUCH) {\\n            self.stance = 1;\\n        } else if !self.treating {\\n            self.stance = 0;\\n        }\\n1260→        let target_eye = match self.stance {\\n            2 => 0.42,\\n            1 => 1.02,\\n            _ => 1.58,\\n        };\\n        let k = 1.0 - (-dt / 0.12).exp();\\n        self.eye += (target_eye - self.eye) * k;\\n\\n        if input.down(buttons::MAP) {\\n            self.map_t += dt;\\n1270→            if self.map_t > 0.35 {\\n                self.mark(\\\"map_raised\\\");\\n            }\\n        }\\n        if self.flags.contains(\\\"map_raised\\\") && (input.just(buttons::INTERACT) || input.act == 1) && self.waypoint.is_none() {\\n            self.waypoint = Some((0.0, 460.0));\\n            self.mark(\\\"waypoint_set\\\");\\n        }\\n        if input.down(buttons::MONOCULAR) {\\n            self.mono_t += dt;\\n1280→            if self.mono_t > 0.5 && self.bodies.iter().any(|b| b.alive && geom::dist(self.x, self.z, b.x, b.z) < 80.0) {\\n                self.mark(\\\"monocular_tag\\\");\\n            }\\n        } else {\\n            self.mono_t = 0.0;\\n        }\\n\\n        self.move_body(input, dt);\",\"content_concise\":\"768→    fn begin(&mut self, spec: Spec) {\\n        self.step_x = self.x;\\n770→        self.step_z = self.z;\\n        self.hold_t = 0.0;\\n        match spec {\\n            Spec::Fever => {\\n                self.fever_t = self.tune.fever_interval;\\n            }\\n            Spec::Blackout => {\\n                self.pills = 0;\\n                self.fever_state = 2;\\n                self.fever_attack = 0.0;\\n780→            }\\n            Spec::Fight => {\\n                self.clear_bodies();\\n                for i in 0..4 {\\n                    let ang = i as f32 * 0.4;\\n                    self.spawn_soldier(self.x + ang.sin() * 12.0, self.z - 12.0, 36.0, false);\\n                }\\n            }\\n            Spec::EnemyJam => {\\n                self.clear_bodies();\\n790→                self.spawn_soldier(self.x, self.z - 8.0, 80.0, true);\\n            }\\n            Spec::Jam => {\\n                let g = self.gun_mut();\\n                g.force_jam = true;\\n                g.jammed = false;\\n                g.broken = false;\\n                g.ammo = 12;\\n                g.condition = 40.0;\\n                self.jam_seen = false;\\n800→            }\\n            Spec::Break => {\\n                self.guns.push(Gun::new(WeaponId::Smg));\\n                self.slot = self.guns.len() - 1;\\n                let g = self.gun_mut();\\n                g.condition = 5.0;\\n                g.wear = 0.0;\\n                g.ammo = 999;\\n                g.reserve = 999;\\n                g.jammed = false;\\n810→                g.broken = false;\\n                g.cooldown = 0.0;\\n            }\\n            Spec::Rescue => {\\n                self.hp = 0.0;\\n                self.rescue_t = 0.0;\\n                for c in &mut self.companions {\\n                    c.alive = true;\\n                    c.rescue_spent = false;\\n                    c.down = false;\\n820→                }\\n            }\\n            Spec::Wound(n) => {\\n                self.hp = 15.0;\\n                self.wound = n;\\n                self.heal_t = 0.0;\\n                self.treating = false;\\n            }\\n            Spec::Syrette => {\\n                if self.hp > 70.0 {\\n830→                    self.hp = 45.0;\\n                }\\n                self.syrettes = self.syrettes.max(1);\\n            }\\n            Spec::Shop => {\\n                if !self.guns.iter().any(|g| g.id == WeaponId::Battle) {\\n                    // The shelf is stocked. Buying happens on the interact.\\n                }\\n            }\\n            Spec::Drive { .. } => {\\n840→                self.wind = Vec2::new(9.0, 0.0);\\n                // Inland legs need the technical. A boat left on the channel cannot climb the bank.\\n                if self.ride.kind != 1 {\\n                    self.ride.kind = 1;\\n                    self.ride.seat = 1;\\n                    self.ride.x = self.x;\\n                    self.ride.z = self.z;\\n                    self.ride.health = 100.0;\\n                    self.ride.stage = 0;\\n                    self.ride.speed = 0.0;\\n850→                    self.ride.fuse = 0.0;\\n                }\\n            }\\n            Spec::Mono => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 24.0, 40.0, false);\\n                self.mono_t = 0.0;\\n            }\\n            Spec::Tanks => {\\n                self.spawn_tank_farm();\\n860→            }\\n            Spec::Panic => {\\n                self.clear_bodies();\\n                let sx = self.x + 4.0;\\n                let sz = self.z - 4.0;\\n                self.spawn_soldier(sx, sz, 40.0, false);\\n                // Runners sprint +x. One 2 m cell ends before flee passes 3.\\n                for i in 0..6 {\\n                    let _ = self.fire.ignite_disk(sx + i as f32 * 4.0, sz, 3.0, self.tune.burn_time, self.minutes);\\n                }\\n870→            }\\n            Spec::Animals => {\\n                self.clear_bodies();\\n                self.spawn_animal(self.x + 6.0, self.z - 6.0);\\n            }\\n            Spec::Night => {\\n                self.minutes = 22.0 * 60.0;\\n                self.mark(\\\"night_contract\\\");\\n            }\\n            Spec::Sleep { .. } => {\\n880→                // The short rest already set this. The long rest has to happen on its own.\\n                self.flags.remove(\\\"sleep_used\\\");\\n            }\\n            Spec::Boat => {\\n                let (wx, wz) = geom::nearest_water(self.x, self.z);\\n                self.ride.kind = 2;\\n                self.ride.seat = 1;\\n                self.ride.x = wx;\\n                self.ride.z = wz;\\n                self.ride.speed = 0.0;\\n890→                self.ride.health = 100.0;\\n                self.x = wx;\\n                self.z = wz;\\n                self.boat_dist = 0.0;\\n            }\\n            Spec::Stealth => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 2.0, 40.0, false);\\n                if let Some(b) = self.bodies.last_mut() {\\n                    b.yaw = 0.0;\\n900→                    b.alert = 0;\\n                }\\n                self.stance = 1;\\n            }\\n            Spec::Dart => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 18.0, 40.0, false);\\n                self.guns.push(Gun::new(WeaponId::Dart));\\n                self.slot = self.guns.len() - 1;\\n            }\\n910→            Spec::Repair => {\\n                if self.ride.kind == 0 {\\n                    self.ride.kind = 1;\\n                    self.ride.x = self.x;\\n                    self.ride.z = self.z;\\n                }\\n                self.ride.seat = 0;\\n                self.ride.health = 35.0;\\n                self.ride.stage = 2;\\n                self.ride.repair = 0.0;\\n920→            }\\n            Spec::Rain => {\\n                // The boat step leaves you on the channel. Rain has to quench grass, not water.\\n                let mut lit = false;\\n                for r in [16.0, 22.0, 30.0, 40.0] {\\n                    for (dx, dz) in [(r, 0.0), (-r, 0.0), (0.0, r), (0.0, -r)] {\\n                        if self.fire.ignite_at(self.x + dx, self.z + dz, self.tune.burn_time, self.minutes) {\\n                            lit = true;\\n                            break;\\n                        }\\n930→                    }\\n                    if lit {\\n                        break;\\n                    }\\n                }\\n                self.weather = 1;\\n            }\\n            Spec::Better => {\\n                self.mark(\\\"better_way\\\");\\n                if let Some(c) = self.companions.iter_mut().find(|c| c.alive) {\\n940→                    c.down = true;\\n                    c.down_t = 0.0;\\n                    c.x = self.x + 1.5;\\n                    c.z = self.z;\\n                }\\n            }\\n            Spec::Patch | Spec::Overdose | Spec::Die => {\\n                self.mark(\\\"better_way\\\");\\n                if let Some(c) = self.companions.iter_mut().find(|c| c.alive) {\\n                    c.down = true;\\n950→                    c.down_t = 0.0;\\n                    c.x = if matches!(spec, Spec::Die) { self.x + 40.0 } else { self.x + 1.5 };\\n                    c.z = self.z;\\n                }\\n                if matches!(spec, Spec::Overdose) {\\n                    if let Some(c) = self.companions.iter_mut().find(|c| c.down) {\\n                        c.down_t = 0.0;\\n                    }\\n                }\\n            }\\n960→            Spec::Ceasefire => {\\n                self.guns.push(Gun::new(WeaponId::Sniper));\\n                self.slot = self.guns.len() - 1;\\n                self.spawn_soldier(self.x, self.z - 30.0, 30.0, false);\\n            }\\n            Spec::Convoy => {\\n                self.clear_bodies();\\n                self.spawn_truck(self.x, self.z - 16.0);\\n                self.guns.push(Gun::new(WeaponId::Rpg));\\n                self.slot = self.guns.len() - 1;\\n970→            }\\n            Spec::Town => {\\n                let (tx, tz) = geom::place(\\\"Kilometre 40\\\");\\n                self.x = tx;\\n                self.z = tz;\\n                let _ = self.fire.ignite_disk(tx, tz + 20.0, 10.0, self.tune.burn_time, self.minutes);\\n                self.mark(\\\"town_burned\\\");\\n            }\\n            Spec::Ending(1) => {\\n                self.clear_bodies();\\n980→                for i in 0..3 {\\n                    self.spawn_soldier(self.x + 40.0 + i as f32 * 4.0, self.z - 50.0, 30.0, false);\\n                }\\n                self.syrettes = self.syrettes.max(4);\\n                self.hold_t = 0.0;\\n            }\\n            Spec::Flag(s) => self.mark(s),\\n            _ => {}\\n        }\\n    }\\n990→\\n    fn done(&mut self, spec: Spec) -> bool {\\n        match spec {\\n            Spec::Boot => self.screen == Screen::Playing,\\n            Spec::Map => self.flags.contains(\\\"map_raised\\\"),\\n            Spec::Way => self.flags.contains(\\\"waypoint_set\\\"),\\n            Spec::Reach { x, z, gps } => {\\n                if gps && self.waypoint.is_some() && geom::dist(self.x, self.z, self.step_x, self.step_z) > 25.0 {\\n                    self.mark(\\\"gps_followed\\\");\\n                }\\n1000→                geom::dist(self.x, self.z, x, z) < 10.0 && (!gps || self.flags.contains(\\\"gps_followed\\\"))\\n            }\\n            Spec::Fever => self.flags.contains(\\\"fever_warned\\\"),\\n            Spec::Pill => self.flags.contains(\\\"pill_taken\\\"),\\n            Spec::Blackout => self.flags.contains(\\\"blackout\\\"),\\n            Spec::Fight => {\\n                let clear = self.bodies.iter().filter(|b| b.kind == 1).all(|b| !b.alive);\\n                if clear && !self.bodies.is_empty() {\\n                    self.post_clear = true;\\n                    self.post_reman_at = self.minutes + self.tune.post_reman_hours * 60.0;\\n1010→                    self.mark(\\\"post_cleared\\\");\\n                }\\n                clear && self.flags.contains(\\\"post_cleared\\\")\\n            }\\n            Spec::EnemyJam => self.flags.contains(\\\"enemy_jam\\\"),\\n            Spec::Jam => self.flags.contains(\\\"jam_cleared\\\"),\\n            Spec::Break => {\\n                if self.gun().broken {\\n                    self.mark(\\\"weapon_broke\\\");\\n                    self.slot = 0;\\n1020→                }\\n                self.flags.contains(\\\"weapon_broke\\\")\\n            }\\n            Spec::Rescue => self.flags.contains(\\\"player_rescued\\\"),\\n            Spec::Wound(n) => self.flags.contains(wound_flag(n)),\\n            Spec::Loot => self.guns.iter().any(|g| g.id == WeaponId::Ar),\\n            Spec::Claim => self.flags.contains(\\\"safe_house_claimed\\\"),\\n            Spec::Shop => self.flags.contains(\\\"weapon_bought\\\"),\\n            Spec::Locker => self.flags.contains(\\\"locker_used\\\"),\\n            Spec::Syrette => self.flags.contains(\\\"syrette\\\"),\\n1030→            Spec::Tracker => self.flags.contains(\\\"cache_tracker\\\"),\\n            Spec::Sleep { .. } => self.flags.contains(\\\"sleep_used\\\") && self.step_t > 0.2,\\n            Spec::Drive { x, z } => geom::dist(self.x, self.z, x, z) < 12.0 && self.flags.contains(\\\"technical_driven\\\"),\\n            Spec::Mono => self.flags.contains(\\\"monocular_tag\\\"),\\n            Spec::Ignite(n) => self.flags.contains(ignite_flag(n)),\\n            Spec::Tanks => self.flags.contains(\\\"cells_500\\\") && self.flags.contains(\\\"explosion_chain\\\"),\\n            Spec::Mounted => self.flags.contains(\\\"mounted_gun\\\"),\\n            Spec::Panic => self.flags.contains(\\\"enemy_panicked\\\"),\\n            Spec::Animals => self.flags.contains(\\\"animals_fled\\\"),\\n            Spec::Bus { x, z } => self.flags.contains(\\\"bus_taken\\\") && geom::dist(self.x, self.z, x, z) < 12.0,\\n1040→            Spec::Night => self.flags.contains(\\\"night_contract\\\"),\\n            Spec::Boat => self.flags.contains(\\\"boat_driven\\\"),\\n            Spec::Stealth => self.flags.contains(\\\"stealth_kill\\\"),\\n            Spec::Dart => self.flags.contains(\\\"dart_kill\\\"),\\n            Spec::Repair => self.flags.contains(\\\"repair_done\\\"),\\n            Spec::Rain => self.flags.contains(\\\"rain_extinguished\\\"),\\n            Spec::Better => self.flags.contains(\\\"better_way\\\") || self.companions.iter().any(|c| c.down),\\n            Spec::Patch => self.flags.contains(\\\"companion_patched\\\"),\\n            Spec::Overdose => self.flags.contains(\\\"companion_overdosed\\\"),\\n            Spec::Die => self.flags.contains(\\\"companion_died\\\"),\\n1050→            Spec::Tape => self.flags.contains(\\\"tape_played\\\"),\\n            Spec::Ceasefire => self.flags.contains(\\\"ceasefire_ended\\\"),\\n            Spec::Convoy => self.bodies.iter().filter(|b| b.kind == 6).all(|b| !b.alive) && !self.bodies.is_empty(),\\n            Spec::Town => self.flags.contains(\\\"town_burned\\\"),\\n            Spec::Ending(n) => self.flags.contains(ending_flag(n)),\\n            Spec::Flag(s) => self.flags.contains(s),\\n        }\\n    }\\n\\n    fn bot_spec(&self, spec: Spec) -> InputFrame {\\n1060→        let mut f = InputFrame::default();\\n        match spec {\\n            Spec::Map => {\\n                f.held = buttons::MAP;\\n                f.pressed = buttons::MAP;\\n            }\\n            Spec::Way | Spec::Claim | Spec::Shop | Spec::Locker | Spec::Loot | Spec::Tape | Spec::Ending(2) => {\\n                f.act = 1;\\n                f.pressed = buttons::INTERACT;\\n                f.held = buttons::INTERACT;\\n1070→            }\\n            Spec::Reach { x, z, .. } => return self.bot_go(x, z, true),\\n            Spec::Tracker => {\\n                let (tx, tz) = self.tracker_cache;\\n                return self.bot_go(tx, tz, true);\\n            }\\n            Spec::Pill => {\\n                f.held = buttons::PILLS;\\n                f.pressed = buttons::PILLS;\\n            }\\n1080→            Spec::Fight | Spec::Ceasefire | Spec::Convoy | Spec::Ignite(10) => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive && b.kind != 3) {\\n                    return self.bot_aim(b.x, b.z, 1.7, true);\\n                }\\n                f.held = buttons::PRIMARY;\\n            }\\n            Spec::EnemyJam | Spec::Blackout | Spec::Fever | Spec::Die | Spec::Ending(1) => {\\n                if matches!(spec, Spec::Ending(1)) {\\n                    f.held = buttons::CROUCH;\\n                }\\n1090→            }\\n            Spec::Jam | Spec::Break => {\\n                if self.gun().jammed {\\n                    f.pressed = buttons::RELOAD;\\n                    f.held = buttons::RELOAD;\\n                } else {\\n                    f.held = buttons::PRIMARY | buttons::SECONDARY;\\n                    f.pressed = buttons::PRIMARY;\\n                }\\n            }\\n1100→            Spec::Rescue => {}\\n            Spec::Wound(_) => {\\n                f.held = buttons::HEAL;\\n                f.pressed = buttons::HEAL;\\n            }\\n            Spec::Syrette => {\\n                f.pressed = buttons::HEAL;\\n                f.held = buttons::HEAL;\\n            }\\n            Spec::Sleep { .. } => {\\n1110→                let (hx, hz) = geom::nearest_safe(self.x, self.z);\\n                if geom::dist(self.x, self.z, hx, hz) > 8.0 && self.ride.seat == 0 {\\n                    return self.bot_go(hx, hz, true);\\n                }\\n                if self.ride.seat != 0 {\\n                    f.pressed = buttons::USE;\\n                } else {\\n                    f.held = buttons::INTERACT;\\n                    f.pressed = buttons::INTERACT;\\n                }\\n1120→            }\\n            Spec::Drive { x, z } => {\\n                let (tx, tz) = (x, z);\\n                if self.ride.seat == 0 {\\n                    f.pressed = buttons::USE;\\n                    return f;\\n                }\\n                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Bus { .. } => {\\n1130→                let (tx, tz) = geom::place(\\\"Junction\\\");\\n                if self.ride.seat == 0 {\\n                    f.pressed = buttons::USE;\\n                    return f;\\n                }\\n                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Mono => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive) {\\n                    let mut aim = self.bot_aim(b.x, b.z, 1.6, false);\\n1140→                    aim.held |= buttons::MONOCULAR;\\n                    aim.pressed |= buttons::MONOCULAR;\\n                    return aim;\\n                }\\n            }\\n            Spec::Ignite(k) => {\\n                if k == 10 {\\n                    f.held = buttons::PRIMARY;\\n                } else if k == 11 {\\n                    f.held = buttons::INTERACT;\\n1150→                    f.pressed = buttons::INTERACT;\\n                } else {\\n                    f.pressed = buttons::PRIMARY;\\n                    f.held = buttons::PRIMARY;\\n                }\\n            }\\n            Spec::Tanks | Spec::Mounted => {\\n                f.held = buttons::PRIMARY;\\n                f.pressed = buttons::PRIMARY;\\n                if matches!(spec, Spec::Mounted) {\\n1160→                    f.pressed |= buttons::USE;\\n                }\\n            }\\n            Spec::Animals => {\\n                // A shot already happened. Firing again drops the herd before it clears the grass.\\n                f.held = buttons::SECONDARY;\\n            }\\n            Spec::Panic => {}\\n            Spec::Boat => {\\n                let (tx, tz) = geom::water_ahead(self.ride.x, self.ride.z, 50.0);\\n1170→                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Stealth => {\\n                f.held = buttons::CROUCH | buttons::MELEE;\\n                f.pressed = buttons::MELEE;\\n            }\\n            Spec::Dart => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive) {\\n                    return self.bot_aim(b.x, b.z, 1.2, true);\\n                }\\n1180→            }\\n            Spec::Repair | Spec::Patch | Spec::Overdose => {\\n                f.held = buttons::INTERACT;\\n                f.pressed = buttons::INTERACT;\\n            }\\n            Spec::Rain | Spec::Night | Spec::Better | Spec::Flag(_) | Spec::Town | Spec::Ending(0) => {\\n                f.pressed = buttons::INTERACT;\\n            }\\n            _ => {}\\n        }\\n1190→        let _ = shell::glyph(\\\"confirm\\\", self.device, self.xbox);\\n        f\\n    }\\n\\n    fn bot_go(&self, tx: f32, tz: f32, sprint: bool) -> InputFrame {\\n        let desired = geom::yaw_toward(self.x, self.z, tx, tz);\\n        let err = geom::wrap_angle(desired - self.yaw);\\n        let mut f = InputFrame::default();\\n        f.look.x = err.clamp(-1.4, 1.4);\\n        if err.abs() < 0.4 {\\n1200→            f.move_dir.y = 1.0;\\n            if sprint && self.stamina > 1.0 {\\n                f.held |= buttons::FOCUS;\\n            }\\n        }\\n        f\\n    }\\n\\n    fn bot_drive(&self, tx: f32, tz: f32) -> InputFrame {\\n        let desired = geom::yaw_toward(self.ride.x, self.ride.z, tx, tz);\\n1210→        let err = geom::wrap_angle(desired - self.ride.yaw);\\n        let mut f = InputFrame::default();\\n        f.axes.x = err.clamp(-1.0, 1.0);\\n        f.axes.y = 1.0;\\n        f\\n    }\\n\\n    fn bot_aim(&self, tx: f32, tz: f32, ty: f32, fire: bool) -> InputFrame {\\n        let dx = tx - self.x;\\n        let dz = tz - self.z;\\n1220→        let dist = (dx * dx + dz * dz).sqrt().max(0.2);\\n        let desired = dx.atan2(-dz);\\n        let err = geom::wrap_angle(desired - self.yaw);\\n        let perr = ((ty - self.eye) / dist).atan() - self.pitch;\\n        let mut f = InputFrame::default();\\n        f.look.x = err.clamp(-1.5, 1.5);\\n        f.look.y = perr.clamp(-1.2, 1.2);\\n        if fire && err.abs() < 0.2 && perr.abs() < 0.2 {\\n            f.held |= buttons::PRIMARY | buttons::SECONDARY;\\n            f.pressed |= buttons::PRIMARY;\\n1230→        }\\n        f\\n    }\\n\\n    pub fn start_playing(&mut self) {\\n        self.screen = Screen::Playing;\\n        let (x, z) = geom::place(\\\"Airstrip\\\");\\n        self.x = x;\\n        self.z = z;\\n        self.yaw = 0.0;\\n1240→        self.eye = 1.58;\\n        self.idle = 0.0;\\n        self.pitch = 0.08;\\n    }\\n\\n    fn simulate(&mut self, input: &InputFrame, dt: f32) {\\n        self.yaw = geom::wrap_angle(self.yaw + input.look.x);\\n        self.pitch = (self.pitch + input.look.y).clamp(-1.15, 1.15);\\n        if self.fever_state == 2 {\\n            self.roll = (self.minutes * 2.0).sin() * 0.05 * self.tune.fever_severity;\\n1250→        } else {\\n            self.roll *= 0.9;\\n        }\\n        if input.down(buttons::CRAWL) {\\n            self.stance = 2;\\n        } else if input.down(buttons::CROUCH) {\\n            self.stance = 1;\\n        } else if !self.treating {\\n            self.stance = 0;\\n        }\\n1260→        let target_eye = match self.stance {\\n            2 => 0.42,\\n            1 => 1.02,\\n            _ => 1.58,\\n        };\\n        let k = 1.0 - (-dt / 0.12).exp();\\n        self.eye += (target_eye - self.eye) * k;\\n\\n        if input.down(buttons::MAP) {\\n            self.map_t += dt;\\n1270→            if self.map_t > 0.35 {\\n                self.mark(\\\"map_raised\\\");\\n            }\\n        }\\n        if self.flags.contains(\\\"map_raised\\\") && (input.just(buttons::INTERACT) || input.act == 1) && self.waypoint.is_none() {\\n            self.waypoint = Some((0.0, 460.0));\\n            self.mark(\\\"waypoint_set\\\");\\n        }\\n        if input.down(buttons::MONOCULAR) {\\n            self.mono_t += dt;\\n1280→            if self.mono_t > 0.5 && self.bodies.iter().any(|b| b.alive && geom::dist(self.x, self.z, b.x, b.z) < 80.0) {\\n                self.mark(\\\"monocular_tag\\\");\\n            }\\n        } else {\\n            self.mono_t = 0.0;\\n        }\\n\\n        self.move_body(input, dt);\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/games/merc/world.rs\",\"offset\":768,\"limit\":520,\"raw_output\":\"    fn begin(&mut self, spec: Spec) {\\n        self.step_x = self.x;\\n        self.step_z = self.z;\\n        self.hold_t = 0.0;\\n        match spec {\\n            Spec::Fever => {\\n                self.fever_t = self.tune.fever_interval;\\n            }\\n            Spec::Blackout => {\\n                self.pills = 0;\\n                self.fever_state = 2;\\n                self.fever_attack = 0.0;\\n            }\\n            Spec::Fight => {\\n                self.clear_bodies();\\n                for i in 0..4 {\\n                    let ang = i as f32 * 0.4;\\n                    self.spawn_soldier(self.x + ang.sin() * 12.0, self.z - 12.0, 36.0, false);\\n                }\\n            }\\n            Spec::EnemyJam => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 8.0, 80.0, true);\\n            }\\n            Spec::Jam => {\\n                let g = self.gun_mut();\\n                g.force_jam = true;\\n                g.jammed = false;\\n                g.broken = false;\\n                g.ammo = 12;\\n                g.condition = 40.0;\\n                self.jam_seen = false;\\n            }\\n            Spec::Break => {\\n                self.guns.push(Gun::new(WeaponId::Smg));\\n                self.slot = self.guns.len() - 1;\\n                let g = self.gun_mut();\\n                g.condition = 5.0;\\n                g.wear = 0.0;\\n                g.ammo = 999;\\n                g.reserve = 999;\\n                g.jammed = false;\\n                g.broken = false;\\n                g.cooldown = 0.0;\\n            }\\n            Spec::Rescue => {\\n                self.hp = 0.0;\\n                self.rescue_t = 0.0;\\n                for c in &mut self.companions {\\n                    c.alive = true;\\n                    c.rescue_spent = false;\\n                    c.down = false;\\n                }\\n            }\\n            Spec::Wound(n) => {\\n                self.hp = 15.0;\\n                self.wound = n;\\n                self.heal_t = 0.0;\\n                self.treating = false;\\n            }\\n            Spec::Syrette => {\\n                if self.hp > 70.0 {\\n                    self.hp = 45.0;\\n                }\\n                self.syrettes = self.syrettes.max(1);\\n            }\\n            Spec::Shop => {\\n                if !self.guns.iter().any(|g| g.id == WeaponId::Battle) {\\n                    // The shelf is stocked. Buying happens on the interact.\\n                }\\n            }\\n            Spec::Drive { .. } => {\\n                self.wind = Vec2::new(9.0, 0.0);\\n                // Inland legs need the technical. A boat left on the channel cannot climb the bank.\\n                if self.ride.kind != 1 {\\n                    self.ride.kind = 1;\\n                    self.ride.seat = 1;\\n                    self.ride.x = self.x;\\n                    self.ride.z = self.z;\\n                    self.ride.health = 100.0;\\n                    self.ride.stage = 0;\\n                    self.ride.speed = 0.0;\\n                    self.ride.fuse = 0.0;\\n                }\\n            }\\n            Spec::Mono => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 24.0, 40.0, false);\\n                self.mono_t = 0.0;\\n            }\\n            Spec::Tanks => {\\n                self.spawn_tank_farm();\\n            }\\n            Spec::Panic => {\\n                self.clear_bodies();\\n                let sx = self.x + 4.0;\\n                let sz = self.z - 4.0;\\n                self.spawn_soldier(sx, sz, 40.0, false);\\n                // Runners sprint +x. One 2 m cell ends before flee passes 3.\\n                for i in 0..6 {\\n                    let _ = self.fire.ignite_disk(sx + i as f32 * 4.0, sz, 3.0, self.tune.burn_time, self.minutes);\\n                }\\n            }\\n            Spec::Animals => {\\n                self.clear_bodies();\\n                self.spawn_animal(self.x + 6.0, self.z - 6.0);\\n            }\\n            Spec::Night => {\\n                self.minutes = 22.0 * 60.0;\\n                self.mark(\\\"night_contract\\\");\\n            }\\n            Spec::Sleep { .. } => {\\n                // The short rest already set this. The long rest has to happen on its own.\\n                self.flags.remove(\\\"sleep_used\\\");\\n            }\\n            Spec::Boat => {\\n                let (wx, wz) = geom::nearest_water(self.x, self.z);\\n                self.ride.kind = 2;\\n                self.ride.seat = 1;\\n                self.ride.x = wx;\\n                self.ride.z = wz;\\n                self.ride.speed = 0.0;\\n                self.ride.health = 100.0;\\n                self.x = wx;\\n                self.z = wz;\\n                self.boat_dist = 0.0;\\n            }\\n            Spec::Stealth => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 2.0, 40.0, false);\\n                if let Some(b) = self.bodies.last_mut() {\\n                    b.yaw = 0.0;\\n                    b.alert = 0;\\n                }\\n                self.stance = 1;\\n            }\\n            Spec::Dart => {\\n                self.clear_bodies();\\n                self.spawn_soldier(self.x, self.z - 18.0, 40.0, false);\\n                self.guns.push(Gun::new(WeaponId::Dart));\\n                self.slot = self.guns.len() - 1;\\n            }\\n            Spec::Repair => {\\n                if self.ride.kind == 0 {\\n                    self.ride.kind = 1;\\n                    self.ride.x = self.x;\\n                    self.ride.z = self.z;\\n                }\\n                self.ride.seat = 0;\\n                self.ride.health = 35.0;\\n                self.ride.stage = 2;\\n                self.ride.repair = 0.0;\\n            }\\n            Spec::Rain => {\\n                // The boat step leaves you on the channel. Rain has to quench grass, not water.\\n                let mut lit = false;\\n                for r in [16.0, 22.0, 30.0, 40.0] {\\n                    for (dx, dz) in [(r, 0.0), (-r, 0.0), (0.0, r), (0.0, -r)] {\\n                        if self.fire.ignite_at(self.x + dx, self.z + dz, self.tune.burn_time, self.minutes) {\\n                            lit = true;\\n                            break;\\n                        }\\n                    }\\n                    if lit {\\n                        break;\\n                    }\\n                }\\n                self.weather = 1;\\n            }\\n            Spec::Better => {\\n                self.mark(\\\"better_way\\\");\\n                if let Some(c) = self.companions.iter_mut().find(|c| c.alive) {\\n                    c.down = true;\\n                    c.down_t = 0.0;\\n                    c.x = self.x + 1.5;\\n                    c.z = self.z;\\n                }\\n            }\\n            Spec::Patch | Spec::Overdose | Spec::Die => {\\n                self.mark(\\\"better_way\\\");\\n                if let Some(c) = self.companions.iter_mut().find(|c| c.alive) {\\n                    c.down = true;\\n                    c.down_t = 0.0;\\n                    c.x = if matches!(spec, Spec::Die) { self.x + 40.0 } else { self.x + 1.5 };\\n                    c.z = self.z;\\n                }\\n                if matches!(spec, Spec::Overdose) {\\n                    if let Some(c) = self.companions.iter_mut().find(|c| c.down) {\\n                        c.down_t = 0.0;\\n                    }\\n                }\\n            }\\n            Spec::Ceasefire => {\\n                self.guns.push(Gun::new(WeaponId::Sniper));\\n                self.slot = self.guns.len() - 1;\\n                self.spawn_soldier(self.x, self.z - 30.0, 30.0, false);\\n            }\\n            Spec::Convoy => {\\n                self.clear_bodies();\\n                self.spawn_truck(self.x, self.z - 16.0);\\n                self.guns.push(Gun::new(WeaponId::Rpg));\\n                self.slot = self.guns.len() - 1;\\n            }\\n            Spec::Town => {\\n                let (tx, tz) = geom::place(\\\"Kilometre 40\\\");\\n                self.x = tx;\\n                self.z = tz;\\n                let _ = self.fire.ignite_disk(tx, tz + 20.0, 10.0, self.tune.burn_time, self.minutes);\\n                self.mark(\\\"town_burned\\\");\\n            }\\n            Spec::Ending(1) => {\\n                self.clear_bodies();\\n                for i in 0..3 {\\n                    self.spawn_soldier(self.x + 40.0 + i as f32 * 4.0, self.z - 50.0, 30.0, false);\\n                }\\n                self.syrettes = self.syrettes.max(4);\\n                self.hold_t = 0.0;\\n            }\\n            Spec::Flag(s) => self.mark(s),\\n            _ => {}\\n        }\\n    }\\n\\n    fn done(&mut self, spec: Spec) -> bool {\\n        match spec {\\n            Spec::Boot => self.screen == Screen::Playing,\\n            Spec::Map => self.flags.contains(\\\"map_raised\\\"),\\n            Spec::Way => self.flags.contains(\\\"waypoint_set\\\"),\\n            Spec::Reach { x, z, gps } => {\\n                if gps && self.waypoint.is_some() && geom::dist(self.x, self.z, self.step_x, self.step_z) > 25.0 {\\n                    self.mark(\\\"gps_followed\\\");\\n                }\\n                geom::dist(self.x, self.z, x, z) < 10.0 && (!gps || self.flags.contains(\\\"gps_followed\\\"))\\n            }\\n            Spec::Fever => self.flags.contains(\\\"fever_warned\\\"),\\n            Spec::Pill => self.flags.contains(\\\"pill_taken\\\"),\\n            Spec::Blackout => self.flags.contains(\\\"blackout\\\"),\\n            Spec::Fight => {\\n                let clear = self.bodies.iter().filter(|b| b.kind == 1).all(|b| !b.alive);\\n                if clear && !self.bodies.is_empty() {\\n                    self.post_clear = true;\\n                    self.post_reman_at = self.minutes + self.tune.post_reman_hours * 60.0;\\n                    self.mark(\\\"post_cleared\\\");\\n                }\\n                clear && self.flags.contains(\\\"post_cleared\\\")\\n            }\\n            Spec::EnemyJam => self.flags.contains(\\\"enemy_jam\\\"),\\n            Spec::Jam => self.flags.contains(\\\"jam_cleared\\\"),\\n            Spec::Break => {\\n                if self.gun().broken {\\n                    self.mark(\\\"weapon_broke\\\");\\n                    self.slot = 0;\\n                }\\n                self.flags.contains(\\\"weapon_broke\\\")\\n            }\\n            Spec::Rescue => self.flags.contains(\\\"player_rescued\\\"),\\n            Spec::Wound(n) => self.flags.contains(wound_flag(n)),\\n            Spec::Loot => self.guns.iter().any(|g| g.id == WeaponId::Ar),\\n            Spec::Claim => self.flags.contains(\\\"safe_house_claimed\\\"),\\n            Spec::Shop => self.flags.contains(\\\"weapon_bought\\\"),\\n            Spec::Locker => self.flags.contains(\\\"locker_used\\\"),\\n            Spec::Syrette => self.flags.contains(\\\"syrette\\\"),\\n            Spec::Tracker => self.flags.contains(\\\"cache_tracker\\\"),\\n            Spec::Sleep { .. } => self.flags.contains(\\\"sleep_used\\\") && self.step_t > 0.2,\\n            Spec::Drive { x, z } => geom::dist(self.x, self.z, x, z) < 12.0 && self.flags.contains(\\\"technical_driven\\\"),\\n            Spec::Mono => self.flags.contains(\\\"monocular_tag\\\"),\\n            Spec::Ignite(n) => self.flags.contains(ignite_flag(n)),\\n            Spec::Tanks => self.flags.contains(\\\"cells_500\\\") && self.flags.contains(\\\"explosion_chain\\\"),\\n            Spec::Mounted => self.flags.contains(\\\"mounted_gun\\\"),\\n            Spec::Panic => self.flags.contains(\\\"enemy_panicked\\\"),\\n            Spec::Animals => self.flags.contains(\\\"animals_fled\\\"),\\n            Spec::Bus { x, z } => self.flags.contains(\\\"bus_taken\\\") && geom::dist(self.x, self.z, x, z) < 12.0,\\n            Spec::Night => self.flags.contains(\\\"night_contract\\\"),\\n            Spec::Boat => self.flags.contains(\\\"boat_driven\\\"),\\n            Spec::Stealth => self.flags.contains(\\\"stealth_kill\\\"),\\n            Spec::Dart => self.flags.contains(\\\"dart_kill\\\"),\\n            Spec::Repair => self.flags.contains(\\\"repair_done\\\"),\\n            Spec::Rain => self.flags.contains(\\\"rain_extinguished\\\"),\\n            Spec::Better => self.flags.contains(\\\"better_way\\\") || self.companions.iter().any(|c| c.down),\\n            Spec::Patch => self.flags.contains(\\\"companion_patched\\\"),\\n            Spec::Overdose => self.flags.contains(\\\"companion_overdosed\\\"),\\n            Spec::Die => self.flags.contains(\\\"companion_died\\\"),\\n            Spec::Tape => self.flags.contains(\\\"tape_played\\\"),\\n            Spec::Ceasefire => self.flags.contains(\\\"ceasefire_ended\\\"),\\n            Spec::Convoy => self.bodies.iter().filter(|b| b.kind == 6).all(|b| !b.alive) && !self.bodies.is_empty(),\\n            Spec::Town => self.flags.contains(\\\"town_burned\\\"),\\n            Spec::Ending(n) => self.flags.contains(ending_flag(n)),\\n            Spec::Flag(s) => self.flags.contains(s),\\n        }\\n    }\\n\\n    fn bot_spec(&self, spec: Spec) -> InputFrame {\\n        let mut f = InputFrame::default();\\n        match spec {\\n            Spec::Map => {\\n                f.held = buttons::MAP;\\n                f.pressed = buttons::MAP;\\n            }\\n            Spec::Way | Spec::Claim | Spec::Shop | Spec::Locker | Spec::Loot | Spec::Tape | Spec::Ending(2) => {\\n                f.act = 1;\\n                f.pressed = buttons::INTERACT;\\n                f.held = buttons::INTERACT;\\n            }\\n            Spec::Reach { x, z, .. } => return self.bot_go(x, z, true),\\n            Spec::Tracker => {\\n                let (tx, tz) = self.tracker_cache;\\n                return self.bot_go(tx, tz, true);\\n            }\\n            Spec::Pill => {\\n                f.held = buttons::PILLS;\\n                f.pressed = buttons::PILLS;\\n            }\\n            Spec::Fight | Spec::Ceasefire | Spec::Convoy | Spec::Ignite(10) => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive && b.kind != 3) {\\n                    return self.bot_aim(b.x, b.z, 1.7, true);\\n                }\\n                f.held = buttons::PRIMARY;\\n            }\\n            Spec::EnemyJam | Spec::Blackout | Spec::Fever | Spec::Die | Spec::Ending(1) => {\\n                if matches!(spec, Spec::Ending(1)) {\\n                    f.held = buttons::CROUCH;\\n                }\\n            }\\n            Spec::Jam | Spec::Break => {\\n                if self.gun().jammed {\\n                    f.pressed = buttons::RELOAD;\\n                    f.held = buttons::RELOAD;\\n                } else {\\n                    f.held = buttons::PRIMARY | buttons::SECONDARY;\\n                    f.pressed = buttons::PRIMARY;\\n                }\\n            }\\n            Spec::Rescue => {}\\n            Spec::Wound(_) => {\\n                f.held = buttons::HEAL;\\n                f.pressed = buttons::HEAL;\\n            }\\n            Spec::Syrette => {\\n                f.pressed = buttons::HEAL;\\n                f.held = buttons::HEAL;\\n            }\\n            Spec::Sleep { .. } => {\\n                let (hx, hz) = geom::nearest_safe(self.x, self.z);\\n                if geom::dist(self.x, self.z, hx, hz) > 8.0 && self.ride.seat == 0 {\\n                    return self.bot_go(hx, hz, true);\\n                }\\n                if self.ride.seat != 0 {\\n                    f.pressed = buttons::USE;\\n                } else {\\n                    f.held = buttons::INTERACT;\\n                    f.pressed = buttons::INTERACT;\\n                }\\n            }\\n            Spec::Drive { x, z } => {\\n                let (tx, tz) = (x, z);\\n                if self.ride.seat == 0 {\\n                    f.pressed = buttons::USE;\\n                    return f;\\n                }\\n                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Bus { .. } => {\\n                let (tx, tz) = geom::place(\\\"Junction\\\");\\n                if self.ride.seat == 0 {\\n                    f.pressed = buttons::USE;\\n                    return f;\\n                }\\n                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Mono => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive) {\\n                    let mut aim = self.bot_aim(b.x, b.z, 1.6, false);\\n                    aim.held |= buttons::MONOCULAR;\\n                    aim.pressed |= buttons::MONOCULAR;\\n                    return aim;\\n                }\\n            }\\n            Spec::Ignite(k) => {\\n                if k == 10 {\\n                    f.held = buttons::PRIMARY;\\n                } else if k == 11 {\\n                    f.held = buttons::INTERACT;\\n                    f.pressed = buttons::INTERACT;\\n                } else {\\n                    f.pressed = buttons::PRIMARY;\\n                    f.held = buttons::PRIMARY;\\n                }\\n            }\\n            Spec::Tanks | Spec::Mounted => {\\n                f.held = buttons::PRIMARY;\\n                f.pressed = buttons::PRIMARY;\\n                if matches!(spec, Spec::Mounted) {\\n                    f.pressed |= buttons::USE;\\n                }\\n            }\\n            Spec::Animals => {\\n                // A shot already happened. Firing again drops the herd before it clears the grass.\\n                f.held = buttons::SECONDARY;\\n            }\\n            Spec::Panic => {}\\n            Spec::Boat => {\\n                let (tx, tz) = geom::water_ahead(self.ride.x, self.ride.z, 50.0);\\n                return self.bot_drive(tx, tz);\\n            }\\n            Spec::Stealth => {\\n                f.held = buttons::CROUCH | buttons::MELEE;\\n                f.pressed = buttons::MELEE;\\n            }\\n            Spec::Dart => {\\n                if let Some(b) = self.bodies.iter().find(|b| b.alive) {\\n                    return self.bot_aim(b.x, b.z, 1.2, true);\\n                }\\n            }\\n            Spec::Repair | Spec::Patch | Spec::Overdose => {\\n                f.held = buttons::INTERACT;\\n                f.pressed = buttons::INTERACT;\\n            }\\n            Spec::Rain | Spec::Night | Spec::Better | Spec::Flag(_) | Spec::Town | Spec::Ending(0) => {\\n                f.pressed = buttons::INTERACT;\\n            }\\n            _ => {}\\n        }\\n        let _ = shell::glyph(\\\"confirm\\\", self.device, self.xbox);\\n        f\\n    }\\n\\n    fn bot_go(&self, tx: f32, tz: f32, sprint: bool) -> InputFrame {\\n        let desired = geom::yaw_toward(self.x, self.z, tx, tz);\\n        let err = geom::wrap_angle(desired - self.yaw);\\n        let mut f = InputFrame::default();\\n        f.look.x = err.clamp(-1.4, 1.4);\\n        if err.abs() < 0.4 {\\n            f.move_dir.y = 1.0;\\n            if sprint && self.stamina > 1.0 {\\n                f.held |= buttons::FOCUS;\\n            }\\n        }\\n        f\\n    }\\n\\n    fn bot_drive(&self, tx: f32, tz: f32) -> InputFrame {\\n        let desired = geom::yaw_toward(self.ride.x, self.ride.z, tx, tz);\\n        let err = geom::wrap_angle(desired - self.ride.yaw);\\n        let mut f = InputFrame::default();\\n        f.axes.x = err.clamp(-1.0, 1.0);\\n        f.axes.y = 1.0;\\n        f\\n    }\\n\\n    fn bot_aim(&self, tx: f32, tz: f32, ty: f32, fire: bool) -> InputFrame {\\n        let dx = tx - self.x;\\n        let dz = tz - self.z;\\n        let dist = (dx * dx + dz * dz).sqrt().max(0.2);\\n        let desired = dx.atan2(-dz);\\n        let err = geom::wrap_angle(desired - self.yaw);\\n        let perr = ((ty - self.eye) / dist).atan() - self.pitch;\\n        let mut f = InputFrame::default();\\n        f.look.x = err.clamp(-1.5, 1.5);\\n        f.look.y = perr.clamp(-1.2, 1.2);\\n        if fire && err.abs() < 0.2 && perr.abs() < 0.2 {\\n            f.held |= buttons::PRIMARY | buttons::SECONDARY;\\n            f.pressed |= buttons::PRIMARY;\\n        }\\n        f\\n    }\\n\\n    pub fn start_playing(&mut self) {\\n        self.screen = Screen::Playing;\\n        let (x, z) = geom::place(\\\"Airstrip\\\");\\n        self.x = x;\\n        self.z = z;\\n        self.yaw = 0.0;\\n        self.eye = 1.58;\\n        self.idle = 0.0;\\n        self.pitch = 0.08;\\n    }\\n\\n    fn simulate(&mut self, input: &InputFrame, dt: f32) {\\n        self.yaw = geom::wrap_angle(self.yaw + input.look.x);\\n        self.pitch = (self.pitch + input.look.y).clamp(-1.15, 1.15);\\n        if self.fever_state == 2 {\\n            self.roll = (self.minutes * 2.0).sin() * 0.05 * self.tune.fever_severity;\\n        } else {\\n            self.roll *= 0.9;\\n        }\\n        if input.down(buttons::CRAWL) {\\n            self.stance = 2;\\n        } else if input.down(buttons::CROUCH) {\\n            self.stance = 1;\\n        } else if !self.treating {\\n            self.stance = 0;\\n        }\\n        let target_eye = match self.stance {\\n            2 => 0.42,\\n            1 => 1.02,\\n            _ => 1.58,\\n        };\\n        let k = 1.0 - (-dt / 0.12).exp();\\n        self.eye += (target_eye - self.eye) * k;\\n\\n        if input.down(buttons::MAP) {\\n            self.map_t += dt;\\n            if self.map_t > 0.35 {\\n                self.mark(\\\"map_raised\\\");\\n            }\\n        }\\n        if self.flags.contains(\\\"map_raised\\\") && (input.just(buttons::INTERACT) || input.act == 1) && self.waypoint.is_none() {\\n            self.waypoint = Some((0.0, 460.0));\\n            self.mark(\\\"waypoint_set\\\");\\n        }\\n        if input.down(buttons::MONOCULAR) {\\n            self.mono_t += dt;\\n            if self.mono_t > 0.5 && self.bodies.iter().any(|b| b.alive && geom::dist(self.x, self.z, b.x, b.z) < 80.0) {\\n                self.mark(\\\"monocular_tag\\\");\\n            }\\n        } else {\\n            self.mono_t = 0.0;\\n        }\\n\\n        self.move_body(input, dt);\\n\",\"total_lines\":2449}}","is_error":false},{"type":"tool_result","tool_use_id":"call-d7bc6d53-6338-481c-b971-e74f1b4fa433-99","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,1