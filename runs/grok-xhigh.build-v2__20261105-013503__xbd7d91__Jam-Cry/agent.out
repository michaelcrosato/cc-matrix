   sim.step(&f);\\n    }\\n    let eye1 = sim.play().unwrap().get::<Merc>().unwrap().world.eye_pos();\\n    let cam = merc::overlook();\\n    assert!((cam.eye[0] - eye1.0).abs() < 0.3 && (cam.eye[2] - eye1.2).abs() < 0.3, \\\"cam {:?} eye {:?}\\\", cam.eye, eye1);\\n    assert!((eye1.0 - eye0.0).abs() + (eye1.2 - eye0.2).abs() > 1.0, \\\"eye did not move {eye0:?} -> {eye1:?}\\\");\\n\\n    let mut c = InputFrame::default();\\n    c.held = buttons::CROUCH;\\n    for _ in 0..40 {\\n        sim.step(&c);\\n    }\\n    let eye_c = sim.play().unwrap().get::<Merc>().unwrap().world.eye_pos();\\n    let cam = merc::overlook();\\n    assert!(eye_c.1 < eye1.1 - 0.3, \\\"crouch {} stand {}\\\", eye_c.1, eye1.1);\\n    assert!((cam.eye[1] - eye_c.1).abs() < 0.25, \\\"cam y {} eye {}\\\", cam.eye[1], eye_c.1);\\n\\n    let rifle = sim.state.entities.map.values().find(|e| e.name == \\\"fp-rifle\\\").expect(\\\"rifle prop\\\");\\n    let dx = rifle.pos.x - cam.eye[0];\\n    let dy = rifle.pos.y - cam.eye[1];\\n    let dz = rifle.pos.z - cam.eye[2];\\n    let dist = (dx * dx + dy * dy + dz * dz).sqrt();\\n    assert!(dist > 0.15 && dist < 1.2, \\\"rifle dist {dist}\\\");\\n    let rag = sim.state.entities.map.values().find(|e| e.name == \\\"fp-rag\\\").expect(\\\"rag prop\\\");\\n    let rdx = rag.pos.x - cam.eye[0];\\n    let rdy = rag.pos.y - cam.eye[1];\\n    let rdz = rag.pos.z - cam.eye[2];\\n    let rdist = (rdx * rdx + rdy * rdy + rdz * rdz).sqrt();\\n    assert!(rdist > 0.15 && rdist < 1.6, \\\"rag dist {rdist}\\\");\\n    let near_country = sim.state.entities.map.values().any(|e| {\\n        if e.name != \\\"country\\\" {\\n            return false;\\n        }\\n        let dx = e.pos.x - eye_c.0;\\n        let dz = e.pos.z - eye_c.2;\\n        dx * dx + dz * dz < 12.0 * 12.0\\n    });\\n    assert!(near_country, \\\"country patch is not under the eye\\\");\\n}\\n\\n#[test]\\nfn ledger_confirm_earns_the_chosen_ending() {\\n    let mut burn = World::campaign(1, Route::Human);\\n    burn.present_ending();\\n    burn.tick(&InputFrame::default(), DT);\\n    assert_eq!(burn.screen, Screen::Ledger);\\n    assert!(!burn.flags.contains(\\\"ending_burn\\\"));\\n    burn.tick(&act(1), DT);\\n    assert_eq!(burn.screen, Screen::Playing);\\n    assert_eq!(burn.finale, Some(0));\\n    assert!(!burn.flags.contains(\\\"ending_burn\\\"));\\n    let mut t = 0.0f32;\\n    while !burn.flags.contains(\\\"ending_burn\\\") && t < 8.0 {\\n        let input = burn.bot_input();\\n        burn.tick(&input, DT);\\n        t += DT;\\n    }\\n    assert!(burn.flags.contains(\\\"ending_burn\\\"), \\\"burn flag missing after {t:.1}s\\\");\\n\\n    let mut chair = World::campaign(1, Route::Chair);\\n    chair.present_ending();\\n    chair.tick(&InputFrame::default(), DT);\\n    assert_eq!(chair.screen, Screen::Ledger);\\n    chair.tick(&act(4), DT);\\n    chair.tick(&act(4), DT);\\n    assert_eq!(chair.focus, 2);\\n    chair.tick(&act(1), DT);\\n    assert_eq!(chair.finale, Some(2));\\n    assert!(!chair.flags.contains(\\\"ending_chair\\\"));\\n    chair.tick(&press(buttons::INTERACT), DT);\\n    assert!(chair.flags.contains(\\\"ending_chair\\\"));\\n\\n    let mut read = World::campaign(1, Route::Read);\\n    read.present_ending();\\n    read.tick(&InputFrame::default(), DT);\\n    read.tick(&act(4), DT);\\n    assert_eq!(read.focus, 1);\\n    read.tick(&act(1), DT);\\n    assert_eq!(read.finale, Some(1));\\n    assert!(read.bodies.iter().any(|b| b.alive && b.kind == 1));\\n    assert!(!read.flags.contains(\\\"ending_read\\\"));\\n    run(&mut read, &hold(buttons::CROUCH), 2.0);\\n    assert!(!read.flags.contains(\\\"ending_read\\\"));\\n}\\n\\n#[test]\\nfn dev_menu_teleports_spawns_and_noclip_flies() {\\n    let mut w = World::fresh(1);\\n    w.tick(&act(10), DT);\\n    assert_eq!(w.screen, Screen::Pause);\\n    for _ in 0..3 {\\n        w.tick(&act(4), DT);\\n    }\\n    w.tick(&act(1), DT);\\n    assert_eq!(w.screen, Screen::Dev);\\n    assert_eq!(w.tab, 0);\\n    w.tick(&act(4), DT);\\n    w.tick(&act(1), DT);\\n    assert_eq!(w.tab, 2, \\\"rows {:?}\\\", w.rows());\\n    w.tick(&act(1), DT);\\n    assert!((w.x + 120.0).abs() < 0.1 && (w.z - 900.0).abs() < 0.1, \\\"teleport ({}, {})\\\", w.x, w.z);\\n\\n    w.tick(&act(2), DT);\\n    assert_eq!(w.tab, 0);\\n    w.tick(&act(4), DT);\\n    w.tick(&act(4), DT);\\n    w.tick(&act(1), DT);\\n    assert_eq!(w.tab, 3);\\n    let before = w.bodies.len();\\n    w.tick(&act(1), DT);\\n    assert!(w.bodies.len() > before, \\\"spawn did not add a body\\\");\\n    assert!(w.bodies.iter().any(|b| b.kind == 1));\\n\\n    w.tick(&act(2), DT);\\n    assert_eq!(w.tab, 0);\\n    for _ in 0..3 {\\n        w.tick(&act(4), DT);\\n    }\\n    w.tick(&act(1), DT);\\n    assert_eq!(w.tab, 4);\\n    w.tick(&act(1), DT);\\n    assert!(w.hour() > 20.0, \\\"hour {}\\\", w.hour());\\n\\n    w.tick(&act(2), DT);\\n    w.tick(&act(1), DT);\\n    assert_eq!(w.tab, 1);\\n    for _ in 0..4 {\\n        w.tick(&act(4), DT);\\n    }\\n    assert_eq!(w.rows().get(w.focus).map(String::as_str), Some(\\\"Noclip\\\"));\\n    w.tick(&act(1), DT);\\n    assert!(w.dev.noclip);\\n\\n    w.tick(&act(2), DT);\\n    w.tick(&act(2), DT);\\n    assert_eq!(w.screen, Screen::Pause, \\\"focus {} rows {:?}\\\", w.focus, w.rows());\\n    assert_eq!(w.rows().get(w.focus).map(String::as_str), Some(\\\"Resume\\\"));\\n    w.tick(&act(1), DT);\\n    assert_eq!(w.screen, Screen::Playing);\\n\\n    w.ride.kind = 1;\\n    w.ride.seat = 1;\\n    w.ride.x = w.x;\\n    w.ride.z = w.z;\\n    let x0 = w.x;\\n    let z0 = w.z;\\n    let eye0 = w.eye;\\n    let mut fly = InputFrame::default();\\n    fly.move_dir.y = 1.0;\\n    fly.look.y = 1.0;\\n    run(&mut w, &fly, 0.5);\\n    let moved = ((w.x - x0).powi(2) + (w.z - z0).powi(2)).sqrt();\\n    assert!(moved > 2.0, \\\"noclip moved {moved:.2} from ({x0:.1},{z0:.1}) to ({:.1},{:.1})\\\", w.x, w.z);\\n    assert!(w.eye > eye0 + 2.0, \\\"eye {} from {eye0}\\\", w.eye);\\n}\\n\\nconst COVERAGE: &[&str] = &[\\n    \\\"map_raised\\\", \\\"waypoint_set\\\", \\\"gps_followed\\\", \\\"monocular_tag\\\", \\\"wind_rag\\\", \\\"jam_cleared\\\", \\\"enemy_jam\\\", \\\"weapon_broke\\\",\\n    \\\"weapon_bought\\\", \\\"locker_used\\\", \\\"syrette\\\", \\\"wound_gunshot\\\", \\\"wound_shrapnel\\\", \\\"wound_burn\\\", \\\"wound_fall\\\", \\\"wound_tourniquet\\\",\\n    \\\"wound_graze\\\", \\\"fever_warned\\\", \\\"pill_taken\\\", \\\"blackout\\\", \\\"player_rescued\\\", \\\"companion_patched\\\", \\\"companion_overdosed\\\",\\n    \\\"companion_died\\\", \\\"better_way\\\", \\\"ignite_flare\\\", \\\"ignite_rocket\\\", \\\"ignite_flamer\\\", \\\"ignite_mortar\\\", \\\"ignite_molotov\\\",\\n    \\\"ignite_frag\\\", \\\"ignite_barrel\\\", \\\"ignite_vehicle\\\", \\\"ignite_person\\\", \\\"ignite_lightning\\\", \\\"ignite_tracer\\\", \\\"ignite_cigarette\\\",\\n    \\\"cells_500\\\", \\\"enemy_panicked\\\", \\\"animals_fled\\\", \\\"explosion_chain\\\", \\\"rain_extinguished\\\", \\\"stealth_kill\\\", \\\"dart_kill\\\",\\n    \\\"night_contract\\\", \\\"sleep_used\\\", \\\"safe_house_claimed\\\", \\\"post_cleared\\\", \\\"post_remanned\\\", \\\"technical_driven\\\", \\\"mounted_gun\\\",\\n    \\\"repair_done\\\", \\\"boat_driven\\\", \\\"bus_taken\\\", \\\"tape_played\\\", \\\"cache_tracker\\\", \\\"diamonds_spent\\\", \\\"contract_a0\\\", \\\"contract_a1\\\",\\n    \\\"contract_b1\\\", \\\"contract_b2\\\", \\\"contract_b3\\\", \\\"contract_b4\\\", \\\"contract_c1\\\", \\\"contract_c2\\\", \\\"contract_c3\\\", \\\"contract_d1\\\",\\n    \\\"contract_d2\\\", \\\"ceasefire_ended\\\", \\\"town_burned\\\", \\\"ending_burn\\\", \\\"ending_read\\\", \\\"ending_chair\\\",\\n];\\n\\nfn play_route(route: Route, seed: u64) -> BTreeSet<String> {\\n    let mut w = World::campaign(seed, route);\\n    let mut goal = String::new();\\n    let mut stuck = 0.0f32;\\n    let cap = 60.0 * 900.0;\\n    let mut t = 0.0f32;\\n    while t < cap && !w.finished {\\n        let input = w.bot_input();\\n        let before = w.goal_name();\\n        w.tick(&input, DT);\\n        t += DT;\\n        let now = w.goal_name();\\n        if now != before {\\n            eprintln!(\\\"{route:?} seed {seed}: {before} -> {now} at ({:.0},{:.0}) t={t:.0}\\\", w.x, w.z);\\n            goal = now;\\n            stuck = 0.0;\\n        } else {\\n            stuck += DT;\\n            let budget = w.goal_budget();\\n            if stuck > budget && !w.finished {\\n                panic!(\\n                    \\\"{route:?} seed {seed} stuck on {now} for {stuck:.0}s (budget {budget:.0}) at ({:.1},{:.1}) step {} flags {}\\\",\\n                    w.x, w.z, w.step, w.flags.len()\\n                );\\n            }\\n        }\\n    }\\n    assert!(w.finished, \\\"{route:?} seed {seed} did not finish by {t:.0}s goal {} at ({:.0},{:.0})\\\", w.goal_name(), w.x, w.z);\\n    let end = match route {\\n        Route::Read => \\\"ending_read\\\",\\n        Route::Chair => \\\"ending_chair\\\",\\n        _ => \\\"ending_burn\\\",\\n    };\\n    assert!(w.flags.contains(end), \\\"{route:?} missing {end}\\\");\\n    w.flags\\n}\\n\\n#[test]\\nfn bot_plays_all_three_endings() {\\n    let mut union = BTreeSet::new();\\n    for seed in [1u64, 2] {\\n        let mut prefix_a = World::campaign(seed, Route::Human);\\n        let mut prefix_b = World::campaign(seed, Route::Human);\\n        for _ in 0..40 {\\n            let a = prefix_a.bot_input();\\n            let b = prefix_b.bot_input();\\n            prefix_a.tick(&a, DT);\\n            prefix_b.tick(&b, DT);\\n        }\\n        assert_eq!(prefix_a.fingerprint(), prefix_b.fingerprint());\\n        for route in [Route::Human, Route::Read, Route::Chair] {\\n            union.extend(play_route(route, seed));\\n        }\\n    }\\n    let missing: Vec<_> = COVERAGE.iter().copied().filter(|f| !union.contains(*f)).collect();\\n    assert!(missing.is_empty(), \\\"coverage missing {missing:?}\\\");\\n}\\n\",\"total_lines\":930}}","is_error":false},{"type":"tool_result","tool_use_id":"call-b31b5941-36d6-45aa-bc62-7bc7d2973d6c-17","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1700→        }\\n        if self.guns[i].jammed {\\n            self.jam_seen = true;\\n        } else if self.jam_seen {\\n            self.mark(\\\"jam_cleared\\\");\\n        }\\n        let holster = self.ceasefire && geom::in_town(self.x, self.z);\\n        let want = input.down(buttons::PRIMARY) && !self.treating && !holster && self.rescue_t <= 0.0;\\n        if !want {\\n            return;\\n1710→        }\\n        let ads = input.down(buttons::SECONDARY);\\n        let jam = self.tune.jam_chance;\\n        let wear = self.tune.weapon_wear;\\n        let br = self.tune.break_threshold;\\n        let pull = self.guns[i].pull(&mut self.rng, jam, wear, br);\\n        if pull != Pull::Fired && pull != Pull::Broke {\\n            return;\\n        }\\n        self.resolve_shot(ads);\\n1720→        if pull == Pull::Broke {\\n            self.mark(\\\"weapon_broke\\\");\\n        }\\n    }\\n\\n    pub fn resolve_shot(&mut self, ads: bool) {\\n        let st = gun::stats(self.gun().id);\\n        let spread = 0.02 * gun::spread_mul(self.gun().condition) * if ads { 0.25 } else { 1.0 };\\n        let jitter = (self.rng.f32() - 0.5) * spread;\\n        let yaw = self.yaw + jitter;\\n1730→        let pitch = self.pitch + jitter * 0.5;\\n        let (sy, cy) = yaw.sin_cos();\\n        let (sp, cp) = pitch.sin_cos();\\n        let dir = (sy * cp, sp, -cy * cp);\\n        let origin = (self.x, self.eye, self.z);\\n        self.shots_tick(origin, dir, st.damage * self.tune.player_damage, st.range, st.noise, st.ignites, st.silent, self.gun().id, self.gun().shots);\\n    }\\n\\n    fn shots_tick(&mut self, origin: (f32, f32, f32), dir: (f32, f32, f32), damage: f32, range: f32, noise: f32, ignites: bool, silent: bool, id: WeaponId, shot_n: u32) {\\n        let mut best_t = range;\\n1740→        let mut best_zone = 0u8;\\n        let mut best_i: Option<usize> = None;\\n        let mut blocked = false;\\n        for w in &self.walls {\\n            if let Some(t) = ray_aabb(origin, dir, w.min, w.max) {\\n                if t < best_t {\\n                    best_t = t;\\n                    blocked = true;\\n                    best_i = None;\\n                }\\n1750→            }\\n        }\\n        if !blocked {\\n            for (i, b) in self.bodies.iter().enumerate() {\\n                if !b.alive {\\n                    continue;\\n                }\\n                let zones = [(1.70, 0.18, 3u8), (1.15, 0.28, 1u8), (0.45, 0.20, 2u8)];\\n                for (y, r, zone) in zones {\\n                    if let Some(t) = ray_sphere(origin, dir, (b.x, y, b.z), r) {\\n1760→                        if t < best_t {\\n                            best_t = t;\\n                            best_zone = zone;\\n                            best_i = Some(i);\\n                        }\\n                    }\\n                }\\n            }\\n        }\\n        let hit_x = origin.0 + dir.0 * best_t;\\n1770→        let hit_z = origin.2 + dir.2 * best_t;\\n        if let Some(i) = best_i {\\n            let mul = match best_zone {\\n                3 => 3.0,\\n                2 => 0.6,\\n                _ => 1.0,\\n            };\\n            let dmg = damage * mul;\\n            let kind = self.bodies[i].kind;\\n            let in_town = geom::in_town(self.bodies[i].x, self.bodies[i].z);\\n1780→            if self.ceasefire && in_town && kind == 2 {\\n                // Civilians are safe while the ceasefire holds.\\n            } else if id == WeaponId::Dart {\\n                self.bodies[i].poison = 3.0;\\n            } else {\\n                self.bodies[i].hp -= dmg;\\n                if ignites && matches!(self.current(), Some(Spec::Ignite(8))) && kind == 1 {\\n                    self.mark(\\\"ignite_person\\\");\\n                }\\n                if self.bodies[i].hp <= 0.0 {\\n1790→                    self.bodies[i].alive = false;\\n                    if kind == 1 && self.stance == 1 && silent {\\n                        self.mark(\\\"stealth_kill\\\");\\n                    }\\n                    if kind == 5 && matches!(self.current(), Some(Spec::Ignite(6))) {\\n                        let bx = self.bodies[i].x;\\n                        let bz = self.bodies[i].z;\\n                        let _ = self.fire.ignite_disk(bx, bz, 5.0, self.tune.burn_time, self.minutes);\\n                        self.mark(\\\"ignite_barrel\\\");\\n                    }\\n1800→                    if matches!(self.current(), Some(Spec::Ceasefire)) {\\n                        self.ceasefire = false;\\n                        self.mark(\\\"ceasefire_ended\\\");\\n                    }\\n                }\\n            }\\n        }\\n        let weapon_lights = ignites\\n            || matches!(id, WeaponId::Flare | WeaponId::Rpg | WeaponId::Flamer | WeaponId::Mortar | WeaponId::Molotov | WeaponId::Frag);\\n        if weapon_lights && self.fire.ignite_at(hit_x, hit_z, self.tune.burn_time, self.minutes) {\\n1810→            self.note_weapon_ignite(id);\\n            if self.finale == Some(0) && matches!(self.current(), Some(Spec::Ending(_))) {\\n                self.mark(\\\"ending_burn\\\");\\n            }\\n        }\\n        if matches!(self.current(), Some(Spec::Ignite(9))) && self.fire.ignite_at(hit_x, hit_z, self.tune.burn_time, self.minutes) {\\n            self.mark(\\\"ignite_lightning\\\");\\n        }\\n        if matches!(self.current(), Some(Spec::Ignite(7))) && self.ride.kind != 0 {\\n            // The round starts at the eye. Score the closest point on that ray, not the far hit.\\n1820→            let rel_x = self.ride.x - origin.0;\\n            let rel_z = self.ride.z - origin.2;\\n            let along = rel_x * dir.0 + rel_z * dir.2;\\n            let t = along.clamp(0.0, best_t);\\n            let cx = origin.0 + dir.0 * t;\\n            let cz = origin.2 + dir.2 * t;\\n            if geom::dist(cx, cz, self.ride.x, self.ride.z) < 4.0 {\\n                self.hurt_vehicle(damage.max(40.0));\\n                if self.ride.stage >= 3 {\\n                    let _ = self.fire.ignite_disk(self.ride.x, self.ride.z, 5.0, self.tune.burn_time, self.minutes);\\n1830→                    self.mark(\\\"ignite_vehicle\\\");\\n                    self.ride.health = 100.0;\\n                    self.ride.stage = 0;\\n                    self.ride.fuse = 0.0;\\n                }\\n            }\\n        }\\n        // Tracers: every third round. The coverage flag is earned on the tracer step.\\n        // Other play still lights grass one time in four, without stamping that flag early.\\n        let tracer_step = matches!(self.current(), Some(Spec::Ignite(10)));\\n1840→        if tracer_step && shot_n > 0 && shot_n % 3 == 0 {\\n            for k in 0..8 {\\n                let ox = hit_x + shot_n as f32 + k as f32 * 3.0;\\n                let oz = hit_z + 6.0 + k as f32 * 2.0;\\n                if self.fire.ignite_at(ox, oz, self.tune.burn_time, self.minutes) {\\n                    self.mark(\\\"ignite_tracer\\\");\\n                    break;\\n                }\\n            }\\n        } else if shot_n > 0 && shot_n % 3 == 0 && self.rng.f32() < 0.25 {\\n1850→            let _ = self.fire.ignite_at(hit_x, hit_z, self.tune.burn_time, self.minutes);\\n        }\\n        if !silent {\\n            for b in &mut self.bodies {\\n                if b.alive && b.alert == 0 && geom::dist(self.x, self.z, b.x, b.z) < noise {\\n                    b.alert = 1;\\n                }\\n            }\\n        }\\n        let _ = noise;\\n1860→    }\\n\\n    fn update_bodies(&mut self, dt: f32) {\\n        let px = self.x;\\n        let pz = self.z;\\n        let stance = self.stance;\\n        let night = self.hour() < 5.0 || self.hour() > 20.0;\\n        let light = if night { 0.45 } else { 1.0 };\\n        