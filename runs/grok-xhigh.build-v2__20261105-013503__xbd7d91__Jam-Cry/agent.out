ght.sun_intensity\\\" = 0.1, bloom = 0.8, sky = \\\"#101830\\\".\\n    #[serde(default)]\\n    pub view: BTreeMap<String, ParamValue>,\\n    /// Room-specific control guide lines: [action, keys].\\n    #[serde(default)]\\n    pub controls: Vec<[String; 2]>,\\n    /// Keyboard remapping while inside: action -> physical key names, e.g.\\n    /// `jump = [\\\"KeyW\\\"]`. Actions: move_up, move_down, move_left, move_right, jump, crouch,\\n    /// crawl, use, focus, interact. Key names follow the physical layout (KeyA, Digit1,\\n    /// Space, ShiftLeft, ArrowUp, ...).\",\"content_concise\":\"280→#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\\n#[serde(default)]\\npub struct CodeSnippet {\\n    pub title: String,\\n    /// Where it lives (repository path), e.g. \\\"crates/pav_render/src/shaders/post.wgsl\\\".\\n    pub file: String,\\n    /// \\\"wgsl\\\" or \\\"rust\\\".\\n    pub lang: String,\\n    pub src: String,\\n}\\n290→\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct RoomDef {\\n    #[serde(default)]\\n    pub name: String,\\n    /// Info card: what the room demonstrates.\\n    #[serde(default)]\\n    pub about: String,\\n    /// Info card: things to try.\\n    #[serde(default, rename = \\\"try\\\")]\\n300→    pub try_list: Vec<String>,\\n    /// Pavilion wing (movement, physics, animation, vfx, aesthetic, genre, misc).\\n    #[serde(default = \\\"misc\\\")]\\n    pub wing: String,\\n    /// Order inside the wing.\\n    #[serde(default)]\\n    pub order: i32,\\n    /// The device the room is designed for.\\n    #[serde(default)]\\n    pub primary_device: Device,\\n310→    /// The movement model the room is designed for (applied while inside).\\n    #[serde(default)]\\n    pub movement_model: Option<MovementModel>,\\n    /// Camera defaults while inside (camera.* parameter names without the prefix).\\n    #[serde(default)]\\n    pub camera: BTreeMap<String, ParamValue>,\\n    /// Simulation parameter overrides while inside (full paths, e.g. \\\"movement.jump_height\\\").\\n    #[serde(default)]\\n    pub params: BTreeMap<String, ParamValue>,\\n    /// View setting overrides while inside (`pav params prefix=view`, without the `view.`):\\n320→    /// e.g. \\\"light.sun_intensity\\\" = 0.1, bloom = 0.8, sky = \\\"#101830\\\".\\n    #[serde(default)]\\n    pub view: BTreeMap<String, ParamValue>,\\n    /// Room-specific control guide lines: [action, keys].\\n    #[serde(default)]\\n    pub controls: Vec<[String; 2]>,\\n    /// Keyboard remapping while inside: action -> physical key names, e.g.\\n    /// `jump = [\\\"KeyW\\\"]`. Actions: move_up, move_down, move_left, move_right, jump, crouch,\\n    /// crawl, use, focus, interact. Key names follow the physical layout (KeyA, Digit1,\\n    /// Space, ShiftLeft, ArrowUp, ...).\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_core/src/room.rs\",\"offset\":280,\"limit\":50,\"raw_output\":\"#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]\\n#[serde(default)]\\npub struct CodeSnippet {\\n    pub title: String,\\n    /// Where it lives (repository path), e.g. \\\"crates/pav_render/src/shaders/post.wgsl\\\".\\n    pub file: String,\\n    /// \\\"wgsl\\\" or \\\"rust\\\".\\n    pub lang: String,\\n    pub src: String,\\n}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\npub struct RoomDef {\\n    #[serde(default)]\\n    pub name: String,\\n    /// Info card: what the room demonstrates.\\n    #[serde(default)]\\n    pub about: String,\\n    /// Info card: things to try.\\n    #[serde(default, rename = \\\"try\\\")]\\n    pub try_list: Vec<String>,\\n    /// Pavilion wing (movement, physics, animation, vfx, aesthetic, genre, misc).\\n    #[serde(default = \\\"misc\\\")]\\n    pub wing: String,\\n    /// Order inside the wing.\\n    #[serde(default)]\\n    pub order: i32,\\n    /// The device the room is designe