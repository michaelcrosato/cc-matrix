  pub fn new(id: WeaponId) -> Self {\\n        let s = stats(id);\\n        Self {\\n110→            id,\\n            condition: 100.0,\\n            wear: s.wear,\\n            jammed: false,\\n            broken: false,\\n            ammo: s.mag,\\n            reserve: s.reserve,\\n            cooldown: 0.0,\\n            clear_left: 0.0,\\n            slapped: false,\\n120→            shots: 0,\\n            jams: 0,\\n            force_jam: false,\\n        }\\n    }\\n\\n    pub fn family(&self) -> &'static str {\\n        stats(self.id).family\\n    }\\n\\n130→    /// One trigger pull. Jam is rolled before the bullet. A break is rolled on a real shot when\\n    /// condition is under the threshold (default 8) at 3 percent.\\n    pub fn pull(&mut self, rng: &mut Rng, jam_mul: f32, wear_mul: f32, break_at: f32) -> Pull {\\n        if self.cooldown > 0.0 {\\n            return Pull::Waiting;\\n        }\\n        if self.jammed {\\n            return Pull::Jammed;\\n        }\\n        if self.broken || self.ammo == 0 {\\n140→            return Pull::Dry;\\n        }\\n        let p = jam_probability(self.condition) * jam_mul.max(0.0);\\n        if self.force_jam || (p > 0.0 && rng.f32() < p) {\\n            self.jammed = true;\\n            self.force_jam = false;\\n            self.jams += 1;\\n            self.cooldown = 0.15;\\n            return Pull::Jammed;\\n        }\\n150→        self.ammo -= 1;\\n        self.shots += 1;\\n        let rpm = stats(self.id).rpm.max(1.0);\\n        self.cooldown = 60.0 / rpm;\\n        self.condition = (self.condition - self.wear * wear_mul.max(0.0)).max(0.0);\\n        if self.condition < break_at && rng.f32() < 0.03 {\\n            self.broken = true;\\n            return Pull::Broke;\\n        }\\n        Pull::Fired\\n160→    }\\n\\n    /// Start clearing a jam, or slap the bolt. A second tap shortens the remaining time by 40%.\\n    pub fn tap_reload(&mut self) {\\n        if self.jammed && self.clear_left <= 0.0 {\\n            self.clear_left = clear_seconds(self.condition);\\n            self.slapped = false;\\n        } else if self.jammed && self.clear_left > 0.0 && !self.slapped {\\n            self.clear_left *= 0.6;\\n            self.slapped = true;\\n170→        } else if !self.jammed && !self.broken {\\n            let s = stats(self.id);\\n            let need = s.mag.saturating_sub(self.ammo);\\n            let take = need.min(self.reserve);\\n            self.ammo += take;\\n            self.reserve -= take;\\n        }\\n    }\\n\\n    pub fn tick_clear(&mut self, dt: f32) {\\n180→        if self.clear_left > 0.0 {\\n            self.clear_left = (self.clear_left - dt).max(0.0);\\n            if self.clear_left == 0.0 {\\n                self.jammed = false;\\n                self.slapped = false;\\n            }\\n        }\\n        if self.cooldown > 0.0 {\\n            self.cooldown = (self.cooldown - dt).max(0.0);\\n        }\\n190→    }\\n}\\n\",\"content_concise\":\"90→pub struct Gun {\\n    pub id: WeaponId,\\n    pub condition: f32,\\n    pub wear: f32,\\n    pub jammed: bool,\\n    pub broken: bool,\\n    pub ammo: u32,\\n    pub reserve: u32,\\n    pub cooldown: f32,\\n    pub clear_left: f32,\\n100→    pub slapped: bool,\\n    pub shots: u32,\\n    pub jams: u32,\\n    pub force_jam: bool,\\n}\\n\\nimpl Gun {\\n    pub fn new(id: WeaponId) -> Self {\\n        let s = stats(id);\\n        Self {\\n110→            id,\\n            condition: 100.0,\\n            wear: s.wear,\\n            jammed: false,\\n            broken: false,\\n            ammo: s.mag,\\n            reserve: s.reserve,\\n            cooldown: 0.0,\\n            clear_left: 0.0,\\n            slapped: false,\\n120→            shots: 0,\\n            jams: 0,\\n            force_jam: false,\\n        }\\n    }\\n\\n    pub fn family(&self) -> &'static str {\\n        stats(self.id).family\\n    }\\n\\n130→    /// One trigger pull. Jam is rolled before the bullet. A break is rolled on a real shot when\\n    /// condition is under the threshold (default 8) at 3 percent.\\n    pub fn pull(&mut self, rng: &mut Rng, jam_mul: f32, wear_mul: f32, break_at: f32) -> Pull {\\n        if self.cooldown > 0.0 {\\n            return Pull::Waiting;\\n        }\\n        if self.jammed {\\n            return Pull::Jammed;\\n        }\\n        if self.broken || self.ammo == 0 {\\n140→            return Pull::Dry;\\n        }\\n        let p = jam_probability(self.condition) * jam_mul.max(0.0);\\n        if self.force_jam || (p > 0.0 && rng.f32() < p) {\\n            self.jammed = true;\\n            self.force_jam = false;\\n            self.jams += 1;\\n            self.cooldown = 0.15;\\n            return Pull::Jammed;\\n        }\\n150→        self.ammo -= 1;\\n        self.shots += 1;\\n        let rpm = stats(self.id).rpm.max(1.0);\\n        self.cooldown = 60.0 / rpm;\\n        self.condition = (self.condition - self.wear * wear_mul.max(0.0)).max(0.0);\\n        if self.condition < break_at && rng.f32() < 0.03 {\\n            self.broken = true;\\n            return Pull::Broke;\\n        }\\n        Pull::Fired\\n160→    }\\n\\n    /// Start clearing a jam, or slap the bolt. A second tap shortens the remaining time by 40%.\\n    pub fn tap_reload(&mut self) {\\n        if self.jammed && self.clear_left <= 0.0 {\\n            self.clear_left = clear_seconds(self.condition);\\n            self.slapped = false;\\n        } else if self.jammed && self.clear_left > 0.0 && !self.slapped {\\n            self.clear_left *= 0.6;\\n            self.slapped = true;\\n170→        } else if !self.jammed && !self.broken {\\n            let s = stats(self.id);\\n            let need = s.mag.saturating_sub(self.ammo);\\n            let take = need.min(self.reserve);\\n            self.ammo += take;\\n            self.reserve -= take;\\n        }\\n    }\\n\\n    pub fn tick_clear(&mut self, dt: f32) {\\n180→        if self.clear_left > 0.0 {\\n            self.cle