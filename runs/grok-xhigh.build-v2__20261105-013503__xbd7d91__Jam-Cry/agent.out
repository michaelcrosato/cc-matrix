\n        let dot = (fwd.0 * to_x + fwd.1 * to_z) / len;\\n        let dist = geom::dist(self.x, self.z, px, pz);\\n        self.looking_at_post = dot > 0.4 && dist < 180.0;\\n        if self.minutes >= self.post_reman_at && !self.looking_at_post {\\n            self.post_clear = false;\\n            self.mark(\\\"post_remanned\\\");\\n        }\\n    }\\n\\n    fn clear_bodies(&mut self) {\\n        self.bodies.clear();\\n    }\\n\\n    fn spawn_soldier(&mut self, x: f32, z: f32, hp: f32, jammy: bool) {\\n        let mut g = Gun::new(WeaponId::Ar);\\n        if jammy {\\n            g.condition = 5.0;\\n            g.wear = 0.0;\\n            g.ammo = 400;\\n            g.reserve = 400;\\n        }\\n        self.bodies.push(Body {\\n            kind: 1,\\n            x,\\n            z,\\n            yaw: 0.0,\\n            hp,\\n            alive: true,\\n            alert: if jammy { 2 } else { 0 },\\n            gun: g,\\n            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n    }\\n\\n    fn spawn_animal(&mut self, x: f32, z: f32) {\\n        self.bodies.push(Body {\\n            kind: 3,\\n            x,\\n            z,\\n            yaw: 0.0,\\n            hp: 20.0,\\n            alive: true,\\n            alert: 0,\\n            gun: Gun::new(WeaponId::Pistol),\\n            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n    }\\n\\n    fn spawn_truck(&mut self, x: f32, z: f32) {\\n        self.bodies.push(Body {\\n            kind: 6,\\n            x,\\n            z,\\n            yaw: 0.0,\\n            hp: 80.0,\\n            alive: true,\\n            alert: 0,\\n            gun: Gun::new(WeaponId::Pistol),\\n            see: 0.0,\\n            poison: 0.0,\\n            burn: 0.0,\\n            doomed: false,\\n            flee: 0.0,\\n        });\\n    }\\n\\n    fn spawn_tank_farm(&mut self) {\\n        self.clear_bodies();\\n        for i in 0..7 {\\n            for j in 0..7 {\\n                self.bodies.push(Body {\\n                    kind: 5,\\n                    x: self.x + i as f32 * 10.0,\\n                    z: self.z + j as f32 * 10.0 - 20.0,\\n                    yaw: 0.0,\\n                    hp: 20.0,\\n                    alive: true,\\n                    alert: 0,\\n                    gun: Gun::new(WeaponId::Pistol),\\n                    see: 0.0,\\n                    poison: 0.0,\\n                    burn: 0.0,\\n                    doomed: false,\\n\",\"total_lines\":2295}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aad8-e6b0-7c02-9fba-a7e5c5a4c558","uuid":"3911b1c3-c268-4f16-ad94-5a789f87fc02"}
