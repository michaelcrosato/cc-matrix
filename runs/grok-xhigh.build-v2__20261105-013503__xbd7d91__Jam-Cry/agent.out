move {\"},{\"line_number\":409,\"content\":\"        // Rooms can name saved objects. Load the library before constructing the scene, and\"},{\"line_number\":424,\"content\":\"            let mut sim = Sim::new(&s.scene, s.seed)?;\"},{\"line_number\":426,\"content\":\"                \\\"scene '{}', seed {}, {} entities, {} blocks\\\",\"},{\"line_number\":427,\"content\":\"                s.scene,\"},{\"line_number\":642,\"content\":\"    fn load_scene(&mut self, name: &str) {\"},{\"line_number\":644,\"content\":\"        let (scene, seed) = (name.to_string(), self.settings.seed);\"},{\"line_number\":647,\"content\":\"            // Keep the hero: save, build the scene, put them back in.\"},{\"line_number\":649,\"content\":\"            match Sim::new(&scene, seed) {\"},{\"line_number\":655,\"content\":\"                Err(e) => log::error!(\\\"could not load scene: {e:#}\\\"),\"},{\"line_number\":658,\"content\":\"        self.scene_name = name.to_string();\"},{\"line_number\":660,\"content\":\"        self.toast(format!(\\\"loaded {}\\\", self.scene_name));\"},{\"line_number\":663,\"content\":\"    /// Resets the whole scene (menu).\"},{\"line_number\":676,\"content\":\"        self.toast(\\\"scene reset\\\");\"},{\"line_number\":689,\"content\":\"            None => self.toast(\\\"Not in a room (Esc, Reset scene resets everything)\\\"),\"},{\"line_number\":1237,\"content\":\"        // The look layer (Look & Filters) over the scene's own settings.\"},{\"line_number\":1241,\"content\":\"        let mut scene = self.builder.build(&prev, &curr, alpha, &self.rig, w as f32 / h.max(1) as f32, &view, focus);\"},{\"line_number\":1247,\"content\":\"                    scene.filter.transition = 1.0 - t * t * (3.0 - 2.0 * t);\"},{\"line_number\":1248,\"content\":\"                    scene.filter.transition_kind = kind;\"},{\"line_number\":1249,\"content\":\"                    scene.filter.transition_center = pav_view::build::screen_uv(&scene.camera, feet + Vec3::Y * 0.9);\"},{\"line_number\":1255,\"content\":\"            self.editor.draw_preview(&mut scene);\"},{\"line_number\":1271,\"content\":\"            scene.meshes.push(mark(a, 0.9, Vec3::new(1.0, 0.78, 0.4)));\"},{\"line_number\":1274,\"content\":\"                scene.meshes.push(mark(feet.lerp(a, k as f32 / n as f32), 0.14, Vec3::new(1.0, 0.9, 0.7)));\"},{\"line_number\":1286,\"content\":\"                scene.meshes.push(MeshInstance {\"},{\"line_number\":1360,\"content\":\"        let scene_name = self.scene_name.clone();\"},{\"line_number\":1523,\"content\":\"                    ui::touch_menu(&ctx, &scene_name, m)\"},{\"line_number\":1525,\"content\":\"                    ui::pause_menu(&ctx, device, &scene_name, difficulty)\"},{\"line_number\":1626,\"content\":\"            let r = pav_render::capture::render_to_rgba(&mut gfx.renderer, &scene, w, h)\"},{\"line_number\":1641,\"content\":\"                let submitted = gfx.draw(&scene, Some((&prims, &mut textures, ppp)));\"},{\"line_number\":1648,\"content\":\"            gfx.draw(&scene, Some((&prims, &mut textures, ppp)))\"},{\"line_number\":2018,\"content\":\"                self.load_scene(&name);\"},{\"line_number\":2032,\"content\":\"                self.scene_name = \\\"town\\\".into();\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_app/src/gfx.rs\",\"matches\":[{\"line_number\":1,\"content\":\"//! Window-bound graphics: surface, device, scene renderer and egui renderer.\"},{\"line_number\":139,\"content\":\"    /// Renders the scene plus the egui overlay and presents. Texture updates are always\"},{\"line_number\":141,\"content\":\"    pub fn draw(&mut self, scene: &Scene, ui: Option<(&[egui::ClippedPrimitive], &mut egui::TexturesDelta, f32)>) -> bool {\"},{\"line_number\":156,\"content\":\"            self.renderer.render(&mut encoder, scene, &view, self.config.format, size);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_app/src/panel.rs\",\"matches\":[{\"line_number\":96,\"content\":\"                    .on_hover_text(\\\"Filters on the whole scene, the characters & objects or the environment, with presets\\\")\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_app/src/quality.rs\",\"matches\":[{\"line_number\":1,\"content\":\"//! Graphics quality: how much of the screen's resolution the scene is drawn at and which costly\"},{\"line_number\":39,\"content\":\"    /// Turns off what this quality cannot afford (on top of the scene's and the look's own\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_app/src/settings.rs\",\"matches\":[{\"line_number\":15,\"content\":\"    /// --scene NAME or --room NAME.\"},{\"line_number\":16,\"content\":\"    pub scene: String,\"},{\"line_number\":43,\"content\":\"            scene: String::new(),\"},{\"line_number\":68,\"content\":\"                s.scene = format!(\\\"world/{r}\\\");\"},{\"line_number\":70,\"content\":\"            if let Some(r) = p.get(\\\"scene\\\").filter(|r| !r.is_empty()) {\"},{\"line_number\":71,\"content\":\"                s.scene = r;\"},{\"line_number\":83,\"content\":\"        if (s.animation_studio || s.asset_studio || s.creature_studio) && s.scene.is_empty() {\"},{\"line_number\":84,\"content\":\"            s.scene = \\\"empty\\\".into();\"},{\"line_number\":86,\"content\":\"        if s.scene.is_empty() {\"},{\"line_number\":87,\"content\":\"            // Shardfall's town; the engine's pavilion is the `world` scene (pause menu).\"},{\"line_number\":88,\"content\":\"            s.scene = \\\"town\\\".into();\"},{\"line_number\":150,\"content\":\"                \\\"--scene\\\" => s.scene = it.next().cloned().unwrap_or(s.scene),\"},{\"line_number\":151,\"content\":\"                \\\"--room\\\" => s.scene = it.next().map(|r| format!(\\\"world/{r}\\\")).unwrap_or(s.scene),\"},{\"line_number\":165,\"content\":\"            if s.scene.is_empty() {\"},{\"line_number\":166,\"content\":\"                s.scene = \\\"empty\\\".into();\"},{\"line_number\":172,\"content\":\"        if s.scene.is_empty() {\"},{\"line_number\":173,\"content\":\"            // Shardfall's town; the engine's pavilion is the `world` scene (pause menu).\"},{\"line_number\":174,\"content\":\"            s.scene = \\\"town\\\".into();\"},{\"line_number\":194,\"content\":\"            \\\"start_room\\\" if !v.is_empty() => s.scene = format!(\\\"world/{v}\\\"),\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_app/src/ui.rs\",\"matches\":[{\"line_number\":21,\"content\":\"    /// The scene's resolution as a fraction of the screen's.\"},{\"line_number\":122,\"content\":\"                ui.label(RichText::new(format!(\\\"scene at {:.0}% resolution\\\", i.render_scale * 100.0)).small());\"},{\"line_number\":170,\"content\":\"    scene: &str,\"},{\"line_number\":180,\"content\":\"            ui.label(format!(\\\"Room: {scene}\\\"));\"},{\"line_number\":191,\"content\":\"                if ui.button(\\\"Reset scene\\\").clicked() {\"},{\"line_number\":199,\"content\":\"                    .on_hover_text(\\\"Pixel art, cel shading, outlines, palettes, grading and more, on the whole scene, the characters & objects or the environment\\\")\"},{\"line_number\":249,\"content\":\"            ui.label(RichText::new(\\\"Load scene\\\").strong());\"},{\"line_number\":250,\"content\":\"            for (name, about) in pav_core::scenes::menu() {\"},{\"line_number\":344,\"content\":\"    /// The scene's resolution now (percent of the screen's).\"},{\"line_number\":350,\"content\":\"pub fn touch_menu(ctx: &egui::Context, scene: &str, m: TouchMenu) -> Option<MenuAction> {\"},{\"line_number\":366,\"content\":\"                .show(ui, |ui| touch_menu_body(ui, w, scene, game, m, &mut action));\"},{\"line_number\":371,\"content\":\"fn touch_menu_body(ui: &mut egui::Ui, w: f32, scene: &str, game: bool, m: TouchMenu, action: &mut Option<MenuAction>) {\"},{\"line_number\":420,\"content\":\"                (\\\"Reset scene\\\", MenuAction::Reset),\"},{\"line_number\":432,\"content\":\"        ui.label(RichText::new(format!(\\\"Load scene (now: {scene})\\\")).strong());\"},{\"line_number\":434,\"content\":\"            for (name, about) in pav_core::scenes::menu() {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_app/src/look_ui.rs\",\"matches\":[{\"line_number\":1,\"content\":\"//! The Look & Filters window (pause menu): every filter on the whole scene, only the\"},{\"line_number\":3,\"content\":\"//! whole looks, and looks of your own. The look is a layer over the scene's own settings\"},{\"line_number\":44,\"content\":\"            log::warn!(\\\"looks file unreadable ({e}); starting from the scene's own look\\\");\"},{\"line_number\":94,\"content\":\"    /// The settings to draw with: the scene's own, with the look's sections that are on.\"},{\"line_number\":113,\"content\":\"    /// Draws the window. `base` is the scene's own view (what a section shows while off).\"},{\"line_number\":134,\"content\":\"                        \\\"Mix and match filters: each one works on the whole scene, only the characters & objects, \\\\\"},{\"line_number\":135,\"content\":\"                         or only the environment. A filter that is switched on replaces the scene's own setting.\\\",\"},{\"line_number\":150,\"content\":\"                         props, loot, spells). Environment: floors, walls, fixed scenery and the sky.\\\",\"},{\"line_number\":173,\"content\":\"                \\\"the scene's own\\\".to_string()\"},{\"line_number\":191,\"content\":\"            if ui.button(\\\"Scene default\\\").on_hover_text(\\\"Switch every filter off: the scene's own look\\\").clicked() {\"},{\"line_number\":261,\"content\":\"        \\\"scene default\\\".to_string()\"},{\"line_number\":272,\"content\":\"                ui.checkbox(&mut o, \\\"\\\").on_hover_text(\\\"On: these settings replace the scene's own. Off: the scene's own show.\\\");\"},{\"line_number\":361,\"content\":\"        PartChoice::All => \\\"whole scene\\\",\"},{\"line_number\":374,\"content\":\"        PixelTarget::All => \\\"whole scene\\\",\"},{\"line_number\":389,\"content\":\"/// Whole scene / characters & objects / environment.\"},{\"line_number\":480,\"content\":\"                    ui.label(RichText::new(format!(\\\"The scene forces {} everywhere.\\\", style_name(v.style))).small());\"},{\"line_number\":545,\"content\":\"                \\\"How much of the scene's colour the style keeps (0 = ink only: newsprint, terminal green, graphite)\\\",\"},{\"line_number\":629,\"content\":\"            ui.label(RichText::new(\\\"Whole scene.\\\").small().weak());\"},{\"line_number\":636,\"content\":\"            ui.label(RichText::new(\\\"Whole scene: the air between the camera and the ground.\\\").small().weak());\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261105-013503__xbd7d91/work/Jam Cry-Far Cry 2-grok-4.7-xhigh-20261105-013503/engine/crates/pav_app/src/edit.rs\",\"matches\":[{\"line_number\":8,\"content\":\"use pav_render::scene::{MeshInstance, MeshKey, Scene, SdfInstance, Style, flags};\"},{\"line_number\":153,\"content\":\"    pub fn draw_preview(&self, scene: &mut Scene) {\"},{\"line_number\":167,\"content\":\"                scene.sdfs.push(s);\"},{\"line_number\":173,\"content\":\"                scene.sdfs.push(s);\"},{\"line_number\":182,\"content\":\"     